<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Fakai Translation</book>
  <para style="h">Matiyu</para>
  <para style="toc1">Ran-u Matiyu</para>
  <para style="toc2">Matiyu</para>
  <para style="toc3">Mati</para>
  <para style="mt2">Ran-u</para>
  <para style="mt1">Matiyu</para>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">Ogor-tu̱ mat-u̱r Ye̱so̱</para>
  <para style="r">(<ref loc="LUK 3:23-38">Ruka 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">1:1. </char>
    </note>Tun-to̱ to̱ dim-tu̱ u̱so-tu̱ u̱so-u̱t Ye̱so̱ Kiristi, wu̱ rwu̱ne̱ du̱gu̱ ko̱-u̱r Dawuda u̱ Ibrahi ne̱.<verse eid="MAT 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2"/>Ibrahi wa o̱ye̱ u̱so-u Ishaku.</para>
  <para style="li" vid="MAT 1:2">Ishaku u̱so-u Yakubu.</para>
  <para style="li" vid="MAT 1:2">Yakubu u̱so-u Yahuda, u̱ hu̱u̱b-tu̱ u̱r-matu̱ wa ne̱.<verse eid="MAT 1:2"/></para>
  <para style="li">
    <verse number="3" style="v" sid="MAT 1:3"/>Yahuda u̱so-u Pe̱res u̱ Zera (ino-u e̱ wa o̱ye̱ Tamar).</para>
  <para style="li1" vid="MAT 1:3">Pe̱res u̱so-u Hezu̱ron.</para>
  <para style="li1" vid="MAT 1:3">Hezu̱ron u̱so-u Ram.<verse eid="MAT 1:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 1:4"/>Ram u̱so-u Aminadab.</para>
  <para style="li1" vid="MAT 1:4">Aminadab u̱so-u Nasho̱n.</para>
  <para style="li1" vid="MAT 1:4">Nashon u̱so-u Saru̱mo̱n.<verse eid="MAT 1:4"/></para>
  <para style="li1">
    <verse number="5" style="v" sid="MAT 1:5"/>Saru̱mo̱n u̱so-u Boaz (wu̱ ino-u e̱ wa o̱ye̱ Rahab).</para>
  <para style="li1" vid="MAT 1:5">Boaz u̱so-u Obida (ino-u e̱ wa o̱ye̱ Rutu).</para>
  <para style="li1" vid="MAT 1:5">Obida u̱so-u Jesse.<verse eid="MAT 1:5"/></para>
  <para style="li1">
    <verse number="6" style="v" sid="MAT 1:6"/>Jesse u̱so-u Dawuda Faru̱k.</para>
  <para style="li1" vid="MAT 1:6">Dawuda u̱so-u Suremanu (wu̱ ino-u wa o̱o̱ge̱ ne̱ta Yuriya).<verse eid="MAT 1:6"/></para>
  <para style="li1">
    <verse number="7" style="v" sid="MAT 1:7"/>Suremanu u̱so-u Rehobowam.</para>
  <para style="li1" vid="MAT 1:7">Rehobowam u̱so-u Abija.</para>
  <para style="li1" vid="MAT 1:7">Abija u̱so-u Asa.<verse eid="MAT 1:7"/></para>
  <para style="li1">
    <verse number="8" style="v" sid="MAT 1:8"/>Asa u̱so-u Jehoshapat.</para>
  <para style="li1" vid="MAT 1:8">Jehoshapat u̱so-u Yoram.</para>
  <para style="li1" vid="MAT 1:8">Yoram u̱so-u Uziya.<verse eid="MAT 1:8"/></para>
  <para style="li1">
    <verse number="9" style="v" sid="MAT 1:9"/>Uziya u̱so-u Jotam.</para>
  <para style="li1" vid="MAT 1:9">Jotam u̱so-u Ahaz.</para>
  <para style="li1" vid="MAT 1:9">Ahaz u̱so-u Hezekiya.<verse eid="MAT 1:9"/></para>
  <para style="li1">
    <verse number="10" style="v" sid="MAT 1:10"/>Hezekiya u̱so-u Manase.</para>
  <para style="li1" vid="MAT 1:10">Manase uso-u E̱mo̱s.</para>
  <para style="li1" vid="MAT 1:10">E̱mo̱s u̱so-u Josiya.<verse eid="MAT 1:10"/></para>
  <para style="li1">
    <verse number="11" style="v" sid="MAT 1:11"/>Tu̱msu̱ Josiya u̱so-u Jekoniya u̱ hu̱u̱b-tu̱ u̱r-matu̱ wa ne̱, u̱ da-u̱ karma-ne̱ i Babira kabe̱ ne̱t-tu̱ Isra m-ha u̱du̱ m-to̱k u̱ dak-u̱ Babira.<verse eid="MAT 1:11"/></para>
  <para style="li1">
    <verse number="12" style="v" sid="MAT 1:12"/>Da-u̱ na kabu̱ e̱ m-ha u̱du̱ m-to̱k Babira,</para>
  <para style="li1" vid="MAT 1:12">Jekoniya wa o̱ u̱so-u She̱yartiye̱r.</para>
  <para style="li1" vid="MAT 1:12">She̱yartiye̱r u̱so-u Zerubaber.<verse eid="MAT 1:12"/></para>
  <para style="li1">
    <verse number="13" style="v" sid="MAT 1:13"/>Zerubaber u̱so-u Abihuda.</para>
  <para style="li1" vid="MAT 1:13">Abihuda u̱so-u Eriyakim.</para>
  <para style="li1" vid="MAT 1:13">Eriyakim u̱so-u Azo̱r.<verse eid="MAT 1:13"/></para>
  <para style="li1">
    <verse number="14" style="v" sid="MAT 1:14"/>Azo̱r u̱so-u Zado̱k.</para>
  <para style="li1" vid="MAT 1:14">Zado̱k u̱so-u Akim.</para>
  <para style="li1" vid="MAT 1:14">Akim u̱so-u Eriyuda.<verse eid="MAT 1:14"/></para>
  <para style="li1">
    <verse number="15" style="v" sid="MAT 1:15"/>Eriyuda u̱so-u Eriyaza.</para>
  <para style="li1" vid="MAT 1:15">Eriyaza u̱so-u Matana.</para>
  <para style="li1" vid="MAT 1:15">Matana u̱so-u Yakubu.<verse eid="MAT 1:15"/></para>
  <para style="li1">
    <verse number="16" style="v" sid="MAT 1:16"/>Tu̱msu̱ Yakubu wa o̱ye̱ u̱so-u Yusuhu, campa Me̱ri.</para>
  <para style="li1" vid="MAT 1:16">Me̱ri mate̱ Ye̱so̱ wu̱ na foge̱ Kiristi.<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>Du̱gu̱ da-u Ibrahi u̱ do̱'e̱ da-u Dawuda sara-to̱ o̱p u̱t-nas, du̱gu̱-du̱ Dawuda u̱ do̱'e̱ da-u̱ na kabe̱ Isra-ne̱ m-to̱k u̱ Babira, sara-to̱ o̱p u̱t-nas, du̱gu̱ ku̱n u̱ do̱'e̱ da-u Ye̱so̱ Kiristi sara-to̱ o̱p u̱t-nas.<verse eid="MAT 1:17"/></para>
  <para style="s1">Mat-u̱r Ye̱so̱</para>
  <para style="r">(<ref loc="LUK 2:1-7">Ruka 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>Inya o̱ na mu̱tte̱ Ye̱so̱ Kiristi. Da-u̱ a u̱r-matu̱ Me̱ri eese̱ yadu̱ gu̱-u̱r Me̱ri u̱du̱ Yusuhu, se̱di kanda na ga-gu̱ u̱n u̱r-gu̱ na bit Me̱ri u̱t-me̱n ne̱ du̱gu̱-du̱ Yar-u u-Ru̱. <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>Ko̱ ba o̱ye̱ u̱zu̱ Yusuhu ne̱t u̱r-ka wa, wa za u̱ssa wa ya' Me̱ri m-'e̱ u̱ te̱k u̱t-ne̱t da, se̱ wa dorog u̱ jab-u̱ wa, wa yagu̱ wu̱n m-yasa.<verse eid="MAT 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 1:20"/>Wa o̱ u̱ te̱k-u̱ dorog-u̱s se̱, se̱ wa-to̱m Wa-ko-uyan haan u̱du̱ ro u̱ bo', wa zu̱, &lt;&lt;Yusuhu wa'-u̱ Dawuda, a-bo̱ ho̱g u-gye̱r u̱ kab-du̱ Me̱ri wa shu̱'u̱t ne̱ta ró da, remu̱ zu̱ no̱mu̱ o̱ u̱ me̱n-u̱t wa du̱gu̱ Yar-u u-Ru̱ o̱. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>Wa de̱ mat-du̱ ya-du̱ u̱r-campa, na do̱'e̱ te̱'u̱ wa u̱r-dim Ye̱so̱,<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="fq" closed="false">Ye̱so̱ </char><char style="ft" closed="false">Na zu̱ &lt;&lt;Yawe Wa-u-u̱ku̱r.&gt;&gt; </char></note> remu̱ zu̱ wa de̱ u̱ku̱r ne̱t-u̱t wa du̱gu̱ ba'as-u̱t e̱.&gt;&gt;<verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>Tun-to̱ no̱m-to̱ u̱t-be̱e̱t na no̱mu̱g to̱ remu̱ no̱m-tu̱ Ru̱-u̱ ware̱ Wa-warru̱ rem-su̱ u-Ru̱ Ishaya u̱zu̱,<verse eid="MAT 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 1:23"/>&lt;&lt;Gwu̱p-u̱ nape̱ campa da de̱ no̱m-du̱ u̱t-me̱n, wa de̱ mat-du̱ yadu̱ u̱r-campa na do̱'e̱ te̱ wa u̱r-dim Imanuwe̱r<note caller="+" style="f"><char style="fr" closed="false">1:23 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 7:14">Isha 7:14</ref></char>.</note>&gt;&gt; no̱mu̱ dim-u̱r re̱ o̱ye̱, &lt;&lt;U-Ru̱ u̱r-kot u̱ na ne̱.&gt;&gt;<verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>Da-u̱ Yusuhu yu̱ne̱ du̱gu̱ m-roog, se̱ wa no̱m no̱mu̱ wa-to̱m u-Ru̱ zu̱ye̱ wa no̱m, wa ku̱b Me̱ri m-mu̱ u-bu, wa shu̱'u̱t ne̱ta wa. <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>Se̱di wa tamu̱g m-roog u̱ wa ne̱ da se̱ da-u̱ wa mate̱ yadu̱ u̱r-campa. Yusuhu te̱'e̱ wa u̱r-dim Ye̱so̱.<verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">Vu̱k-su̱ a-nap-mu̱ re̱ge̱r ne̱ <optbreak/> du̱gu̱ u-do̱m</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>Ba Mari mate̱ Ye̱so̱ u̱ bo̱-u̱ Be̱tarami u̱ dak-u̱ Yahudiya, da-u̱ Here̱ o̱o̱ge̱ u̱r-faru̱k, a-nap-mu̱ re̱ge̱r-ne̱ du̱gu̱ u-do̱m e̱ rwu̱n du̱gu̱ u-do̱m e̱ do̱'e̱ u̱ Urusharima. <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>E̱ shit u̱t-ne̱t u̱zu̱, &lt;&lt;¿He̱ne̱ wu̱na mate̱, Faru̱k-u̱ Yahuda-ne̱? It hyanu̱g re̱ge̱r-u wa du̱gu̱ u-do̱m, it haagu̱n it no̱mu̱ wa u̱t-huuk.&gt;&gt;<verse eid="MAT 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3"/>Da-u̱ Here̱ Faru̱k ho̱ge̱ iya se̱ jab-u̱ wa yu̱ne̱, u̱ jab-u̱ ne̱t-tu̱ Urusharima ne̱ ko̱'e̱. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>Se̱ wa fo̱g i-Yate̱ a-To̱o̱g-ne̱ be̱e̱t u̱ a-kwu̱p-du̱ u-bo̱r ne̱, wa shit u̱n, &lt;&lt;¿He̱ne̱ na do̱te̱ mat-du̱ Kiristi?&gt;&gt;<verse eid="MAT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5"/>E̱ zu̱ wu̱n, &lt;&lt;U̱ Be̱tarami u̱ dak-u̱ Yahudiya, u̱ka wa-warru̱ rem-su̱ u-Ru̱ pu̱nte̱:<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>&lt;&lt;No̱ ne̱t-tu̱ Bo̱-u̱ Be̱tarami,</para>
  <para style="q2" vid="MAT 2:6">u̱ dak-u̱ Yahuda,</para>
  <para style="q1" vid="MAT 2:6">bo̱-u no̱ o̱ m-sek ne̱ sok,</para>
  <para style="q2" vid="MAT 2:6">Remu̱ zu̱ du̱gu̱ bo̱-u no̱</para>
  <para style="q1" vid="MAT 2:6">na do̱te̱ kwu̱m-du̱ faru̱k</para>
  <para style="q2" vid="MAT 2:6">wu̱ de̱ dor-tu̱ ne̱t-u̱t ri Isra-ne̱.<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="MIC 5:2">Mika 5:2</ref></char>.</note>&gt;&gt;<verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>Here̱ fog a-nap-mu̱ re̱ge̱r-ne̱ m-yasa, wa nu̱pu̱t ko̱-uyan da-o̱ re̱ge̱r-yu̱ he̱ne̱. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>Se̱ wa tom u̱n u̱ Be̱tarami u̱zu̱, &lt;&lt;De̱'e̱n no̱ goot so̱k u̱r-zwar ne̱ be-du̱ na mu̱tte̱ wa'-u̱ wa. A no̱ hyanu̱ wa se̱ no̱ no̱m m-ho̱r no̱ haan no̱ waru̱ me̱, ko̱me̱ u̱m do̱'e̱ u̱m no̱mu̱ wu̱n u̱t-huuk.&gt;&gt;<verse eid="MAT 2:8"/></para>
  <para style="p">
    <verse number="9-10" style="v" sid="MAT 2:9-10"/>Da-u̱ u̱n ho̱ge̱ no̱mu̱ faru̱k ware̱ u̱n hu̱ m-ha u̱su̱ u̱n. E̱ o̱ te̱k m-ha, e̱ hyen re̱ge̱r-yu̱ u̱n hyane̱ du̱gu̱ u-do̱m. Da-u̱ e̱ hyane̱ ya, e̱ hu̱ mu̱rimmo̱, e̱ hu̱ u̱r-so̱ sok, ya hu̱ m-da u̱ shu̱ u̱n, se̱ be-du̱ ya eeste̱ u̱ be-du̱ yadu̱ o̱tte̱. <verse eid="MAT 2:9-10"/><verse number="11" style="v" sid="MAT 2:11"/>Da-u̱ e̱ cwaye̱ u̱-me̱ u-bu, e̱ hyen u̱r-ya e̱ ino-u wa Me̱ri. Se̱ e̱ kug e̱ no̱mu̱ wa u̱t-huuk. Se̱ e̱ upus ba-u̱t e̱, e̱ no̱mu̱ wu̱n u-nya' u̱t-no̱m u-tát u̱ ta'ar-tu̱ m-baku̱t ne̱ u̱ no̱m mu̱ wu̱s u-haku̱n ne̱, mu̱ na foge̱ &lt;&lt;farakanse̱,&gt;&gt; m-dap ne̱ mu̱ wu̱s u-haku̱n mu̱ na foge̱ &lt;&lt;mur.&gt;&gt; <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>Remu̱ zu̱ Ru̱-u̱ baag u̱ no̱ngu̱ u̱n u̱t-him u̱ bo' u̱zu̱ a u̱n mu u̱du̱ Here̱ da, se̱ u̱n dor yaku̱n fu̱n-ya m-mu̱ bo̱-u u̱n.<verse eid="MAT 2:12"/></para>
  <para style="s1">Yusuhu e̱ Me̱ri u̱ Wa'-u̱ e̱ ne̱ so̱mo̱g m-ha u̱ dak-u̱ Masar</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>Da-u̱ a-nap-mu̱ re̱ge̱r-ne̱ arke̱, wa-to̱m Wa-ko-uyan haan u̱du̱ Yusuhu u̱ bo'. Wa zu̱, &lt;&lt;Yu̱ne̱, bo̱ kab wa' e̱ ino-u̱ wa bo̱ so̱m m-ha dak-u̱ Masar. Bo̱ shu̱'u̱t u̱ku̱n se̱ da-u̱ u̱m waru̱ bo̱, remu̱ zu̱ Here̱ o̱ gotu̱ ya-u̱r re̱ wa hoot wa.&gt;&gt;<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>Se̱ wa yu̱ne̱, wa ku̱b u̱r-ya e̱ ino-u wa ne̱ m-gyu̱p e̱ do̱'e̱ u̱ Masar. <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>Ku̱na u̱n shu̱'u̱te̱ se̱ da-u̱ Here̱ mare̱. Ru̱-u̱ zu̱u̱g na no̱mu̱g no̱m-u̱t to̱ da-u̱ wa ware̱ wa-warru̱ rem-su̱ u-Ru̱ Hosiya u̱zu̱: &lt;&lt;Du̱gu̱ dak-u̱ Masar me̱ fagu̱ Wa'-u̱ ri.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="HOS 11:1">Hose̱ 11:1</ref></char>.</note><verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>Da-u̱ Here̱ nape̱ u̱zu̱ ve̱r-se̱ a-nap-mu̱ re̱ge̱r-ne̱ no̱mu̱ wa, se̱ wa hog m-ku̱wu̱t. Se̱ wa wu̱ na ho̱o̱rse̱ ya'ag-u̱ campa-ne̱ be̱e̱t i o̱ u̱-me̱ bo̱-u̱ Be̱tarami u̱ kit-su̱ bo̱-u o̱ ne̱, du̱gu̱ u̱s-hak u̱s-yu̱r u̱ saan u-dak, wa regnu̱sse̱ ho̱n-ho̱n u̱ da-u̱ a-nap-mu̱ re̱ge̱r ne̱ waru̱ wu̱n. <verse eid="MAT 2:16"/><verse number="17" style="v" sid="MAT 2:17"/>Irmiya wa-warru̱ rem-su̱ u-Ru̱ waru̱g u̱zu̱ na u̱t-no̱m iya da-u̱ wa zu̱ye̱:<verse eid="MAT 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18"/>&lt;&lt;Na ho̱k u̱s-kan du̱gu̱ bo̱-u̱ Rama,</para>
  <para style="q2" vid="MAT 2:18">Cwar-yu̱ u̱s-kan u̱ namu̱ jab ne̱</para>
  <para style="q1" vid="MAT 2:18">Rahira o̱gu̱ u̱s-kan</para>
  <para style="q1" vid="MAT 2:18">remu̱ ya'ag-u̱ wa,</para>
  <para style="q2" vid="MAT 2:18">na hoku̱ste̱ parru̱ wa da,</para>
  <para style="q1" vid="MAT 2:18">Remu̱ zu̱ e̱ zamu̱n da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">2:18 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="JER 31:15">Irmi 31:15</ref></char>.</note><verse eid="MAT 2:18"/></para>
  <para style="s1">Mu̱u̱n-du̱ Nazara</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>Da-u̱ Here̱ mare̱, wa-to̱m Wa-ko-uyan rwu̱n u̱du̱ Yusuhu u̱ bo'-u̱ dak-u̱ Masar. Wa zu̱, <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>&lt;&lt;Yu̱ne̱, bo̱ kab wa' e̱ ino-u wa no̱ do̱'e̱ u̱ dak-u̱ Isra, remu̱ zu̱, i o̱o̱ge̱ u̱ssa fat-du̱ wa' e̱ mu̱ru̱ste̱.&gt;&gt; <verse eid="MAT 2:20"/><verse number="21" style="v" sid="MAT 2:21"/>Se̱ wa yu̱ne̱ wa ku̱b wa' u̱ ino-u wa ne̱, wa do̱'e̱ u̱ dak-u̱ Isra. <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>Da-u̱ wa ho̱ge̱ u̱zu̱ Arkirayus wa'-u̱ Here̱ o̱ u̱r-faru̱k u̱ gas-u̱ Yahudiya, se̱ wa hog u-gye̱r u̱ ha-mu̱ ku̱n. E̱ aru̱k m-ha u̱ dak-u̱ Gariri remu̱ zu̱ Ru̱-u̱ no̱ngu̱ wu̱n u̱t-him u̱ bo'. <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>Se̱ e̱ do̱'e̱ e̱ shu̱'u̱t u̱ o̱ko̱n bo̱-u̱ u̱ na foge̱ Nazara, remu̱ u̱ ko̱ste̱ u̱zu̱ no̱mu̱ a-warru̱ rem-su̱ u-Ru̱ ne̱ ware̱ nip-to̱, &lt;&lt;Na de̱ fag-du̱ wu̱n wa-Nazara.&gt;&gt;<verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">Bu̱t-u̱t Yohanna <optbreak/> Wa-u̱t-yu̱bu̱sse̱ m-bu̱</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mark 1:1-8</ref>; <ref loc="LUK 3:1-18">Ruka 3:1-18</ref>; <ref loc="JHN 1:19-28">Yoha 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1"/>U̱ te̱k-u̱ ho̱-u̱t to̱, Yohanna Wa-u̱t-yu̱bu̱sse̱ m-bu̱ rwu̱u̱n wa o̱ u̱t-bu̱t u̱-me̱ do̱g-du̱ Yahudiya. <verse eid="MAT 3:1"/><verse number="2" style="v" sid="MAT 3:2"/>Wa o̱ u̱t-zu̱, &lt;&lt;Yagu̱n u̱t-ba'as, no̱ byu̱rnu̱n u̱du̱ u-Ru̱ remu̱ faru̱k-du̱ u-Ru̱ o̱ u̱t-mo̱r.&gt;&gt; <verse eid="MAT 3:2"/><verse number="3" style="v" sid="MAT 3:3"/>Unwa wa wa-warru̱ rem-su̱ u-Ru̱ Ishaya nomte̱ u̱s-rem u̱zu̱,</para>
  <para style="q1" vid="MAT 3:3">&lt;&lt;U-cwar yu̱ o̱ u̱s-fag</para>
  <para style="q2" vid="MAT 3:3">u̱-me̱ u̱r-do̱g u̱zu̱,</para>
  <para style="q1" vid="MAT 3:3">&lt;Mangu̱n fu̱n-u Yawe,</para>
  <para style="q2" vid="MAT 3:3">Yu̱nsu̱n u-fu̱n m-kim.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 40:3">Isha 40:3</ref></char>. (Ran-u̱ u̱t-Girik.)</note><verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>To̱ggo̱-yu̱ Yohanna wa'e̱ yu̱ na no̱me̱ u̱ ka-u̱ u-rakum to̱, tu̱msu̱ wa o̱ m-gag u̱ hap-yu̱ u-ka ne̱ u-byu̱n. I o̱ no̱m u̱t-re̱ rò u̱ bu̱-mu̱ so̱ ne̱. <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>Ne̱t-tu̱ do̱'e̱ u̱du̱ wu̱n du̱gu̱ bo̱-u̱ Urusharima u̱ dak-tu̱ gas-u̱ Yahudiya-ne̱ u̱t-be̱e̱t, u̱ ne̱t-tu̱ o̱ gas-u̱ Gi-yu̱ Yodan ne̱. <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>U̱n hu̱ warru̱ ba'as-u̱t u̱n, se̱ wa no̱mu̱ u̱n u̱t-yu̱bu̱sse̱ m-bu̱, u̱ Gi-yu̱ Yodan.<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>Da-u̱ Yohanna hyane̱ Farisa-ne̱ u-tát u̱ Saduki-ne̱ u̱ haan u̱du̱ rò, u̱ be-du̱ wa o̱tte̱ no̱mu̱ ne̱t-ne̱ u̱t-yu̱bu̱sse̱ m-bu̱, wa zu̱ u̱n, &lt;&lt;No̱ ban-du̱ ya'ag-u̱ ko̱ko̱s! ¿Wana hi-mu̱ no̱, no̱ som ryab-su̱ u-Ru̱ su̱ o̱ haane? <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>U̱ka te-su̱ mu̱tte̱ u̱t-ya, to̱ ko̱se̱ ko̱-uyan go̱-du̱ u-te ya, remu̱ iya ko̱ no̱ no̱mo̱n no̱m-tu̱ de̱ ko̱se̱ u̱t-ne̱t u̱zu̱ no̱ yakke̱ no̱m-du̱ u̱t-ba'as no̱ byu̱rgu̱n u̱du̱ u-Ru̱. <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>A no̱ dorog u̱ jab-u̱s no̱ u̱zu̱ Ibrahi wa o̱ u̱so-u no̱ da, u̱m o̱ waru̱ no̱ u̱zu̱ Ru̱-u̱ o̱ u̱t-kere̱ wa no̱m yaag du̱gu̱ me̱ ta'ar-u̱t tun-to̱ to̱ shu̱'u̱t ya'agu̱ Ibrahi. <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>U̱m o̱ waru̱ no̱ Ru̱-u̱ de̱ yadu̱ no̱ u̱r-ko̱b a no̱ byu̱r-ne̱ no̱ yage̱ yu̱du̱ u̱t-ba'as da, u̱ka ne̱t wu̱ ka'e̱ u̱r-goog u̱ kug-du̱ u̱s-te. Te-yu̱ mate̱ ya-u̱t so̱-to̱ da, wa de̱ kupsu̱ ya, wa gun u-ra.<verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>&lt;&lt;U̱m no̱ngu̱ no̱ u̱t-yu̱bu̱sse̱ m-bu̱, remu̱ u̱ ko̱ste̱ u̱zu̱ no̱ byu̱rgu̱n u̱du̱ u-Ru̱ no̱ yakke̱ u̱t-ba'as, se̱di u̱ dim-u̱ ri waku̱n de̱ haan wu̱ ze̱gu̱ me̱ m-shin. Ko̱ go̱r-su̱ ka'at-u̱t wa u̱m ko̱rge̱ u̱m ust se̱ da. Wa de̱ no̱mu̱ no̱ u̱t-yu̱bu̱sse̱ u̱ Yar-u u-Ru̱ tu̱msu̱ u-ra ne̱. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>Wa o̱ m-shu̱p u-sota ne̱, wa de̱ mangu̱ do̱r-u̱ m-der, wa so̱tu̱sse̱ so i o̱ so-ye̱ wa wa' u̱r-bya, wa doos kon u̱ ra-u̱ u̱ na da hoks u̱t-ryu̱m da.&gt;&gt;<verse eid="MAT 3:12"/></para>
  <para style="s1">Yohanna no̱ngu̱ Ye̱so̱ u̱t-yu̱bu̱sse̱ m-bu̱</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mark 1:9-11</ref>; <ref loc="LUK 3:21-22">Ruka 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>Da-u̱ Ye̱so̱ haane̱ du̱gu̱ Gariri u̱ Gi-yu̱ Yodan u̱ Yohanna no̱m-tu̱ wa u̱t-yu̱bu̱sse̱ m-bu̱, <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>Yohanna sa'ag u̱t-gu̱gu̱m. Wa zu̱, &lt;&lt;¿Me̱ hi-du̱ warri u̱m u̱t-sa bo̱ no̱mu̱ me̱ u̱t-yu̱bu̱sse̱ m-bu̱, bo̱ mu bo̱ haan u̱du̱ ri?&gt;&gt;<verse eid="MAT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15"/>Se̱ Ye̱so̱ zu̱, &lt;&lt;Yage̱ na no̱m iya u̱ da-o̱, remu̱ na nom-u̱t no̱m-u̱ Ru̱-u̱ u̱t-sa na no̱m.&gt;&gt; Se̱ Yohanna ees.<verse eid="MAT 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16"/>Da-u̱ Yohanna no̱mu̱ Ye̱so̱ u̱t-yu̱bu̱sse̱ m-bu̱, Ye̱so̱ rwu̱u̱n du̱gu̱ m-bu̱, za rem do̱m u-ru̱ u-pus se̱ Ye̱so̱ hyen Yar u-Ru̱ u̱ hye̱e̱n u̱ka u̱r-gorop u̱ do̱m-u̱ wu̱n. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>Se̱ Ru̱-u̱ nom u̱s-rem du̱gu̱ do̱m u-ru̱ wa zu̱, &lt;&lt;Unwa o̱ Wa'-u̱ ri, wu̱ u̱m o̱ u̱t-cwan, tu̱msu̱ u̱m o̱ ho̱g-du̱ zwar-u̱r wa sok.&gt;&gt;<verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">Reg-m Ye̱so̱</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mark 1:12-13</ref>; <ref loc="LUK 4:1-13">Ruka 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>Se̱ Yar u-Ru̱ dor-u̱t Ye̱so̱ m-cwa u̱t-kanda u̱ remu̱ faru̱k-u̱ no̱m u̱s-te no̱m-tu̱ wa m-reg. <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>Da-u̱ Ye̱so̱ no̱me̱ u-swaat m-roog u̱t-shik u̱t-yu̱r u̱t-ho̱ ne̱ u̱t-shik u̱t-yu̱r, se̱ wa hog u̱s-me̱r. <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>Faru̱k-u̱ no̱m u̱s-te haan u̱du̱ ro wa zu̱, &lt;&lt;Abite̱ Wa'-u̱ u-Ru̱ wa bo̱ o̱ye̱, zu̱ ta'ar-u̱r rinde̱ de̱ mu no̱m u̱t-re̱.&gt;&gt; <verse eid="MAT 4:3"/><verse number="4" style="v" sid="MAT 4:4"/>Ye̱so̱ shu̱s wa zu̱, &lt;&lt;Rem-su̱ u-Ru̱ zu̱u̱g, a-no̱m u̱t-re̱ u̱ war-o̱ ne̱t do̱te̱ u̱r-fat da, se̱ rem-su̱ rwu̱ne̱ du̱gu̱ nu-u̱ u-Ru̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:4 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 8:3">Muut 8:3</ref></char>.</note><verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>Faru̱k-u̱ no̱m u̱s-te ku̱b wu̱n m-ha u̱ bo̱-u̱ Urusharima bo̱-u̱ u-he̱n, se̱ wa du̱u̱t wu̱n u̱ be-du̱ m-ja be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan. <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>Tu̱msu̱ wa zu̱ wu̱n, &lt;&lt;Abite̱ Wa'-u̱ u-Ru̱ wa bo̱ o̱ye̱, tane̱ tari mak bo̱ he̱e̱n u-dak. Remu̱ zu̱ na panu̱g u̱zu̱,</para>
  <para style="q1" vid="MAT 4:6">&lt;&lt; &lt;Ru̱-u̱ de̱ wadu̱ a-to̱mu̱ wa, e̱ 'e̱ bo̱,</para>
  <para style="q2" vid="MAT 4:6">E̱ e̱r bo̱ u̱ kom-u̱t e̱,</para>
  <para style="q1" vid="MAT 4:6">Taas u̱ na-u ro u̱ gap u̱r-ta'ar da.&gt;<note caller="+" style="f"><char style="fr" closed="false">4:6 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 91:11-12">Se̱pV 91:11-12</ref></char>.</note>&gt;&gt;<verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>Ye̱so̱ shu̱s wa zu̱, &lt;&lt;Na panu̱g u̱zu̱, &lt;A-bo̱ no̱mu̱ Wa-ko-uyan Ru̱-u ro m-reg da.&gt;<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 6:16">Muut 6:16</ref></char>.</note> &gt;&gt;<verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>Se̱ faru̱k-u̱ no̱m u̱s-te ku̱b wu̱n m-ha ro̱r-du̱ zege̱ m-ja, wa ko̱se̱ wu̱n faru̱k-tu̱ dak-u uno̱, u̱ zwar-u̱r wa ne̱. <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>Se̱ wa zu̱, &lt;&lt;Me̱ ya u̱ bo̱ no̱m-u̱t to̱ u̱t-be̱e̱t, a-bo̱ no̱mu̱ me̱ u̱t-huuk.&gt;&gt;<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>Se̱ Ye̱so̱ zu̱ wu̱n, &lt;&lt;Faru̱k-u̱ no̱m u̱s-te, hate̱ du̱gu̱ kit-u̱ ri, remu̱ na panu̱g u̱zu̱, &lt;Bo̱ no̱mu̱ Wa-ko-uyan Ru̱-u ró u̱t-huuk, tu̱msu̱ wa bo̱ do̱'e̱ u̱t-do̱r, wa u-gan.&gt;<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 6:13">Muut 6:13</ref></char>.</note> &gt;&gt;<verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>Faru̱k-u̱ no̱m u̱s-te yage̱ wu̱n, se̱ a-to̱m u-Ru̱ haan, e̱ no̱mu̱ wu̱n u̱r-se̱ge̱.<verse eid="MAT 4:11"/></para>
  <para style="s1">Ye̱so̱ he̱e̱ste̱ bu̱t-tu̱ <optbreak/> Rem-su̱ u-Ru̱ u̱ Gariri</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mark 1:14-15</ref>; <ref loc="LUK 4:14-15">Ruka 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>Da-u̱ Ye̱so̱ ho̱ge̱ u̱zu̱ Here̱ Faru̱k Antipas wa'ag Yohanna wa-u̱t-yu̱bu̱sse̱ m-bu̱ u̱ bu-u̱ m-to̱k, se̱ wa mu u̱ dak-u̱ Gariri. <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>Ye̱so̱ yage̱ bo̱-u̱ Nazara wa do̱'e̱ wa shu̱'u̱t u̱ Kapanahum, u̱ dap-su̱ m-sa mu̱ Gariri u̱-me̱ dak-u̱ Ze̱be̱run u̱ Naptari-ne̱. <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>No̱m-u̱ wu̱te̱ wu̱n m-ha u̱ku̱n, remu̱ wa hyen-u̱t no̱mu̱ Ishaya Wa-warru̱ rem-su̱ u-Ru̱ zu̱ na u̱t-no̱m, na no̱m o.<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>&lt;&lt;Dak-u̱ Ze̱be̱run u̱ dak-u̱ Naptari-ne̱,</para>
  <para style="q2" vid="MAT 4:15">o̱ do̱m-u̱ fu̱n-yu̱ o̱ dapu̱s sa-mu̱ u̱ gas-u̱ u-do̱m u̱ gi-yu̱ Yodan,</para>
  <para style="q2" vid="MAT 4:15">Dak-to̱ u̱-me̱ dak-u̱ Gariri be-tu̱ i za-Yahuda-ne̱ zegte̱ u-tát da.<verse eid="MAT 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16"/>Ne̱t-tu̱ o̱ u̱r-yu̱ u̱-me̱ u-cwu̱m,</para>
  <para style="q2" vid="MAT 4:16">e̱ hyanu̱g zu̱n-m yat-mo̱.</para>
  <para style="q1" vid="MAT 4:16">U̱du̱ i o̱o̱ge̱ u̱r-yu̱ u̱-me̱ dak-u̱ yara-mu̱ m-mar.</para>
  <para style="q2" vid="MAT 4:16">Zu̱n-mu̱ rwu̱gu̱n e̱.&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 9:1">Isha 9:1</ref>,<ref loc="ISA 9:2">2</ref></char>.</note><verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>Du̱gu̱ da-u o̱ Ye̱so̱ he̱e̱se̱ u̱t-bu̱t, u̱zu̱, &lt;&lt;Yagu̱n u̱t-ba'as no̱ byu̱ru̱n u̱du̱ u-Ru̱, remu̱ zu̱ da-u̱ Ru̱-u̱ de̱ u̱r-faru̱k o̱ u̱t-mo̱r.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 9:1-2">Isha 9:1-2</ref> </char> (Ran-u̱ Girik).</note><verse eid="MAT 4:17"/></para>
  <para style="s1">Ye̱so̱ fak a-doru̱ wa ne̱ <optbreak/> nas u̱r-taku̱n</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mark 1:16-20</ref>; <ref loc="LUK 5:1-11">Ruka 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>Da-u̱ Ye̱so̱ o̱o̱ge̱ m-ha u̱ dapu̱s m-sa mu̱ Gariri, se̱ wa hyen ne̱t-ne̱ yu̱r, u̱ Simo̱n wu̱na foge̱ Biturus u̱ o̱r-u̱ wu̱n ne̱ Andarawus, e̱ o̱ gwu̱n-du̱ no̱m-tu̱ masu̱ jan, u̱-me̱ m-sa, remu̱ zu̱ u̱n a masu̱ jan ne̱ e̱. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;Dornu̱n me̱, me̱ mutu̱ no̱ a naknu̱ u̱t-ne̱t u̱ haan u̱du̱ ri.&gt;&gt; <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>Za rem, u̱n yage̱ no̱m-tu̱ masu̱ jan-u̱ u̱n, u̱n dor wa.<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>Da-u̱ wa re̱ shu̱ m-ha ne̱, se̱ wa hyen e̱ke̱n ne̱t-ne̱ yu̱r, u̱ Yakubu e̱ Yohanna ya'ag-u̱ Zabadi. E̱ o̱ u̱-me̱ u-hat u̱ u̱so-u u̱n ne̱ Zabadi, e̱ o̱ mangu̱ no̱m-tu̱ masu̱ jan-u̱ e̱. Ye̱so̱ fog u̱n. <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>Za rem u̱n yage̱ u-hat u̱ u̱so-u u̱n ne̱, u̱n dor wa.<verse eid="MAT 4:22"/></para>
  <para style="s1">Ye̱so̱ haste̱ u̱t-ne̱t u̱s-go̱m</para>
  <para style="r">(<ref loc="LUK 6:17-19">Ruka 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>Ye̱so̱ rigu̱sse̱ dak-u̱ Gariri wa o̱ no̱mu̱ u̱n u̱t-ko̱se̱ u̱-me̱ bu-u̱ u̱t-ko̱se̱ u̱ Yahuda-ne̱, wa o̱ no̱mu̱ u̱n u̱t-bu̱t tu̱ Rem-su̱ m-Re̱me̱r su̱ Faru̱k-du̱ u-Ru̱, tu̱msu̱ u̱ has-tu̱ ne̱t-ne̱ u̱s-go̱m m-re̱ ne̱. <verse eid="MAT 4:23"/><verse number="24" style="v" sid="MAT 4:24"/>Rem-su̱ no̱m-tu̱ Ye̱so̱ no̱me̱ nu̱ru̱s dak-u̱ Suriya u-be̱e̱t, Ne̱t-tu̱ hu̱ haatu̱n wu̱n a u̱s-go̱m u̱ a-ko̱b-du̱ m-yar ne̱, u̱ a swadu̱ u̱r-ko̱b ne̱ m-re̱, u̱ a-no̱m u̱s-te ne̱, u̱ i o̱tte̱ go̱m-su̱ u̱r-he̱'e̱, u̱ a remu̱ swadu̱ ne̱t-ne̱ u̱t-be ne̱, se̱ wa yu̱' e̱ m-yar. <verse eid="MAT 4:24"/><verse number="25" style="v" sid="MAT 4:25"/>Mo̱ro̱g-du̱ u̱t-ne̱t du̱gu̱ Gariri, u̱ Dikaporis, u̱ Urusharima, u̱ Gas-u̱ Yahudiya, tu̱msu̱ u̱ gas-u̱ gwu̱g-du̱ gi-yu̱ Yodan dor wu̱n.<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">U̱t-Bu̱t u̱ do̱m u̱r-ro̱r</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>Da-u̱ Ye̱so̱ hyane̱ ban-du̱ u̱t-ne̱t, se̱ wa du̱u̱s u̱ do̱m u̱r-ro̱r wa shu̱'u̱t m-shu̱'u̱t. Se̱ a-doru̱ wa o̱p u̱ yu̱r e̱ haan u̱du̱ wa, <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>Se̱ Ye̱so̱ he̱e̱se̱ no̱mu̱ u̱n u̱t-ko̱se̱, wa zu̱,<verse eid="MAT 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>&lt;&lt;Kom u-Ru̱ u̱du̱ i nape̱</para>
  <para style="q2" vid="MAT 5:3">ku̱shin-m e̱ u̱-me̱ u-Yar,</para>
  <para style="q1" vid="MAT 5:3">remu̱ faru̱k-du̱ u-Ru du̱ e̱ de̱.<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>Kom u-Ru̱ u̱du̱ a namu̱ jab-ne,</para>
  <para style="q2" vid="MAT 5:4">na de̱ yadu̱ e̱ jab m-shiriktin.<verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>Kom u-Ru̱ u̱du̱ i zatte̱</para>
  <para style="q2" vid="MAT 5:5">hu̱k-mu̱ u̱t-hi da,</para>
  <para style="q1" vid="MAT 5:5">e̱ de̱ kwu̱m-du̱ dak-u uno̱.<verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>Kom u-Ru̱ u̱du̱ a ho̱g-du̱ u̱s-me̱r</para>
  <para style="q2" vid="MAT 5:6">u̱ swa'at m-bu̱ ne̱,</para>
  <para style="q1" vid="MAT 5:6">tu̱ no̱m-u̱t so̱-to̱,</para>
  <para style="q2" vid="MAT 5:6">na de̱ shu̱ksu̱ e̱.<verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>Kom u-Ru̱ u̱du̱ a ho̱g-du̱ u̱r-o̱n ne̱,</para>
  <para style="q2" vid="MAT 5:7">remu̱ Ru̱-u̱ de̱ ho̱gu̱ o̱n-u̱r e̱.<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>Kom u-Ru̱ u̱du̱ i o̱ jab-u̱ so̱-o̱ ne̱,</para>
  <para style="q2" vid="MAT 5:8">remu̱ e̱ de̱ hyan-du̱ u-Ru̱.<verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>Kom u-Ru̱ u̱du̱ i wu̱'e̱ u̱t-ne̱t</para>
  <para style="q2" vid="MAT 5:9">u̱ shu̱'u̱t-du̱ jab-u̱ pus-o̱,</para>
  <para style="q2" vid="MAT 5:9">na de̱ fag-du̱ e̱ ya'ag u-Ru̱.<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>Kom u-Ru̱ u̱du̱ i ne̱t-tu̱ o̱ yadu̱</para>
  <para style="q2" vid="MAT 5:10">u̱r-ko̱b u̱ remu̱ no̱m-u̱t so̱-to̱,</para>
  <para style="q1" vid="MAT 5:10">remu̱ faru̱k-du̱ u-Ru̱ du̱ e̱ de̱.<verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>&lt;&lt;Kom u-Ru̱ u̱du̱ no̱ da ne̱t-tu̱ o̱ pe̱pru̱ no̱, e̱ o̱ u̱ yadu̱ no̱ u̱r-ko̱b, e̱ o̱ ke̱tu̱ no̱ u̱s-rem su̱ no̱m-u̱t yo̱-to̱ u̱ remu̱ ri. <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>No̱mo̱n u̱r-so̱ u̱ no̱ no̱m jab-u̱ pus-o̱ u̱ remu̱ u̱zu̱ to̱p-u no̱ o̱ yat-o̱ u̱ do̱m u-ru̱, iya o̱ u̱n nomte̱ a-warru̱ rem-su̱ u-Ru̱ ne̱ i ba no̱ m-haan.<verse eid="MAT 5:12"/></para>
  <para style="s1">U̱t-Ma m-Zu̱n ne̱</para>
  <para style="r">(<ref loc="MRK 9:50">Mark 9:50</ref>; <ref loc="LUK 14:34-35">Ruka 14:34-35</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>&lt;&lt;No̱ o̱ ma-tu̱ dak-u uno̱. Se̱di a matu̱ taye̱ u̱r-gag, ¿re̱ne̱ o̱ na do̱te̱ mangu̱ to̱? Na za no̱m-du̱ o̱ko̱n u̱ to̱ da, se̱di na agu̱sse̱ u̱ ne̱t-tu̱ jangu̱sse u̱s-na.<verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>&lt;&lt;No̱ o̱ye̱ zu̱n-mu̱ dak-u uno̱. Bo̱-u̱ o̱ m-sak u̱ do̱m u̱r-ro̱r na za yasu̱ o̱ da. <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>Ne̱t za dapu̱s u̱s-hitirra u̱ wa wu̱gu̱b ya u-ko̱k da. Se̱di na sak ya u̱ do̱m naas wa u̱ ya ya' m-zu̱n u̱du̱ ne̱tu̱ o̱ye̱ u-bu u̱t-be̱e̱t. <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>Iya o̱ hen, yagu̱n u̱ zu̱n-m no̱ mo̱k, u̱ka ne̱t-tu̱ do̱te̱ hyan-du̱ ank-m so̱mo̱ no̱, remu̱ e̱ no̱m-tu̱ U̱so-u no̱ wu̱ o̱ do̱m u-ru̱ u̱t-vam.<verse eid="MAT 5:16"/></para>
  <para style="s1">Ko̱se̱-u̱t Ye̱so̱ u̱ mo̱t-tu̱ <optbreak/> Bo̱r-u̱t Mosa</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>&lt;&lt;A no̱ no̱m u̱s-dorog u̱zu̱ u̱m haagu̱n u̱m haste̱ rem-su̱ u-Ru̱ su̱ Mosa pane̱ u̱ su̱ a-warru̱ rem-su̱ u-Ru̱ ne̱ da. U̱m haagu̱n u̱m haste̱ se̱ da se̱di u̱m shu̱u̱ste̱ se̱. <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>U̱m o̱ waru̱ no̱ u̱t-nip kanda do̱m u-ru̱ u-dak ne̱ o̱ e̱nkte̱, ko̱ u-pan u-re̱k ya ko̱ u-de̱ u-gan ya za u̱t-e̱nk u̱ te̱k-u̱ rem-su̱ u-bo̱r da se̱ na no̱ng ko-uyan. <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>Ko̱wana pase̱ bo̱r-u re̱k-ya u̱ te̱k-u̱ bo̱r-u̱s sin-se̱ tu̱msu̱ wa ko̱se̱ u̱t-ne̱t e̱ pas, na do̱'e̱ fagu̱ wa yu̱ re̱k-ya u̱ te̱k-u̱ faru̱k-du̱ u-Ru̱. Wa hene kabe̱ rem-su̱ u-bo̱r sin-se̱ wa ko̱se̱ e̱ke̱n ne̱ na do̱'e̱ fagu̱ wa yu̱ yat-ya u̱ te̱k-u̱ faru̱k-du̱ u-Ru̱. <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>U̱m o̱ waru̱ no̱ a no̱ zege̱ Farisa-ne̱ u̱ a-ko̱se̱-tu̱ rem-su̱ u-bo̱r ne̱ u̱ no̱m-du̱ no̱m-u̱t so̱-to̱ da, no̱ za cwa-du̱ faru̱k-du̱ u-Ru̱ da.<verse eid="MAT 5:20"/></para>
  <para style="s1">Ye̱so̱ no̱ng u̱t-ko̱se̱ u̱ mo̱t-tu̱ u̱s-ryab</para>
  <para style="r">(<ref loc="LUK 12:57-59">Ruka 12:57-59</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>&lt;&lt;No̱ ho̱k na zu̱u̱g ne̱t-tu̱ da-u̱ dim, &lt;A e̱ ho̱ ne̱t da, ko̱ wa ho̱ ne̱t na hu̱u̱tu̱ wa u̱ be-du̱ kwu̱p-du̱ u̱s-rem.&gt;<note caller="+" style="f"><char style="fr" closed="false">5:21 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="EXO 20:13">Rwu̱u̱ 20:13</ref>; <ref loc="DEU 5:17">Muut 5:17</ref></char>.</note> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>Se̱di u̱m o̱ waru̱ no̱ ko̱wana o̱ u̱s-ryab su̱ o̱r-u̱ wa na de̱ kwu̱pu̱ wa u̱s-rem. Tu̱msu̱ ko̱wana zu̱ye̱ o̱r-u̱ wa, &lt;M-zan,&gt; mo̱ro̱g-du̱ u̱t-ne̱nge̱n de̱ kwu̱pu̱ wa u̱s-rem. Wu̱ fage̱ o̱r-u̱ wa &lt;Rag!&gt; wa o̱ fu̱n-yu̱ ha-mu̱ bu-u u-ra.<verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>&lt;&lt;Remu̱ iya, a bo̱ o̱ no̱m-du̱ u-nya u̱r-sak u-me̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan se̱ bo̱ baku̱s u̱zu̱ bo̱ no̱ngu̱ waku̱n no̱m-u̱ kame̱ da. <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>Yage̱ no̱m-tu̱ u-nya' u̱ ró u̱-shu̱ u̱r-sak bo̱ do̱'e̱ u̱du̱ wa. Ko̱n wa wa no̱mu̱ bo̱ u̱r-ho̱ remu̱ no̱mu̱ bo̱ no̱mu̱ wa. Se̱ bo̱ haan bo̱ yase̱ no̱m-tu̱ nya-u ró u̱du̱ u-Ru̱.<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>&lt;&lt;A waku̱n o̱ hu̱u̱tu̱ bo̱ u̱ be-du̱ kwu̱p-du̱ u̱s-rem, sa u-mang no̱ wa ne̱ za naas u-da. No̱mo̱n iya du̱gu̱ u-fu̱n, a-za iya da wa de̱ hu̱u̱tu̱ bo̱ u̱du̱ wa kwu̱p-du̱ u̱s-rem, wa kwu̱p-du̱ u̱s-rem de̱ hen u̱ yasu̱ bo̱ u̱du̱ no̱m u̱s-ko̱m, no̱m u̱s-ko̱m tu̱msu̱ e̱ hu̱u̱t bo̱ u̱ bu-u̱ m-to̱k. <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>U̱m o̱ waru̱ no̱ u̱t-nip bo̱ da rwu̱u̱n u̱ku̱n da se̱ bo̱ to̱po̱k no̱mu̱ na shu̱t-ne̱ wa u-be̱e̱t.<verse eid="MAT 5:26"/></para>
  <para style="s1">U̱t-ko̱se̱ u̱ mo̱ttu̱ m-o̱</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>&lt;&lt;No̱ ho̱k bo̱r-tu̱ u-Ru̱ u̱zu̱, &lt;A no̱ no̱m m-o̱ da.&gt;<note caller="+" style="f"><char style="fr" closed="false">5:27 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="EXO 20:14">Rwu̱u̱ 20:14</ref>; <ref loc="DEU 5:18">Muut 5:18</ref></char>.</note> <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>Se̱di u̱m o̱ waru̱ no̱, ko̱wana gwate̱ ne̱ta gwat u̱zu̱ wa roog u̱ wa ne̱, wa taaste̱ m-o̱ u̱ wa ne̱ u̱-me̱ jab-u̱ wa. <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>A is-du̱ kom u̱t-cwa u̱ ró u̱ o̱ wadu̱ bo̱ u̱ no̱m-du̱ u̱t-ba'as, hoste̱ de̱ bo̱ rest taas bo̱ no̱m u̱t-ba'as. Ze̱k u̱r-zwar bo̱ taag u̱ o̱g-du̱ u̱r-gan du̱ war-u ró, u̱zu̱ na gun bo̱ u-ra u̱ o̱g-tu̱ war-u ró ne̱ u̱t-be̱e̱t. <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>A kom u̱t-cwa ró o̱ wadu̱ bo̱ u̱ no̱m-du̱ u̱t-ba'as, kupse̱ o̱ bo̱ rest. Ze̱k u̱r-zwar u̱ bo̱ taag u̱ o̱g-du̱ u̱r-gan du̱ war-u ró u̱zu̱ na gun bo̱ u-ra u̱ o̱g-tu̱ war-u ró ne̱ u̱t-be̱e̱t.<verse eid="MAT 5:30"/></para>
  <para style="s1">U̱t-ko̱se̱ u̱ mo̱ttu̱ yan-du̱ ne̱ta</para>
  <para style="r">(<ref loc="MAT 19:9">Mati 19:9</ref>; <ref loc="MRK 10:11-12">Mark 10:11-12</ref>; <ref loc="LUK 16:18">Ruka 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>&lt;&lt;Tu̱msu̱ na wargu̱ no̱ u̱zu̱, &lt;Ko̱wana yane̱ ne̱ta wa, wa zatte̱ ka u̱t-no̱m da, se̱ wa yaag wa ran-u̱ u̱t-yan.&gt;<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt" closed="false"><ref loc="DEU 24:1">Muut 24:1</ref>.</char></note> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>Tu̱msu̱ u̱m o̱ waru̱ no̱ u̱zu̱, ko̱wana yane̱ ne̱ta wa, a-za remu̱ ba'as-tu̱ m-o̱ da, wa wa'ag wa-u-as. Tu̱msu̱ wu̱ gaye̱ ne̱ta-yu̱ na yanne̱ wa no̱ng m-o̱ u̱ wa ne̱.<verse eid="MAT 5:32"/></para>
  <para style="s1">Ko̱se̱-u̱t Ye̱so̱ u̱ mo̱ttu̱ u̱s-to̱nd</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>&lt;&lt;No̱ ho̱k na wargu̱ ne̱t-tu̱ da-u̱ dim a e̱ no̱m to̱nd-su̱ u̱s-bi da, &lt;A no̱ pas no̱mu̱ no̱ nomte̱ este̱du̱ u̱s-rem da, se̱di ne̱tu̱ no̱m no̱m-u̱ wa nomte̱ este̱du̱ u̱s-rem u̱du̱ Yawe.&gt;<note caller="+" style="f"><char style="fr" closed="false">5:33 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="NUM 30:2">Ogor 30:2</ref></char>.</note> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>Tu̱msu̱ no̱m u̱m waru̱ no̱ u̱zu̱, a no̱ no̱m u̱s-to̱nd da, ko̱ u̱ do̱m u-ru̱, remu̱ u̱zu̱ be-du̱ u̱r-shu̱'u̱t du̱ u-Ru̱ de̱ du̱ u̱r-faru̱k u̱ wa. <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>Tu̱msu̱ a no̱ to̱n-de̱ u-dak ne̱ da, remu̱ u̱zu̱ ku̱na Ru̱-u̱ cinte̱ na-u̱s wa. Tu̱msu̱ a no̱ to̱nd u̱ Urusharima ne̱ da, remu̱ u̱zu̱ bo̱-u yat-o̱ u̱ Farkina-ne̱ o̱. <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>A-bo̱ to̱n-de̱ tu̱msu̱ u̱ hi-du̱ war ró ne̱ da, remu̱ u̱zu̱ ko̱ hi-u ró u-gan bo̱ za keru̱ mutu̱ ya u̱ pus-ya ko̱ u̱ rim-ya da. <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>A no̱ u̱t-sa no̱m-du̱ o̱ko̱n no̱mu̱ kame̱ no̱ zu̱, &lt;U̱, me̱ u̱t-no̱m,&gt; ko̱ &lt;O'o, u̱m za u̱t-no̱m da.&gt; No̱m-u̱ ze̱ge̱ iya du̱ faru̱k-u̱ no̱m u̱s-te de̱ o̱ rwu̱tu̱n.<verse eid="MAT 5:37"/></para>
  <para style="s1">To̱p-du̱ u̱r-mag</para>
  <para style="r">(<ref loc="LUK 6:29-30">Ruka 6:29-30</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>&lt;&lt;No̱ ho̱k no̱m-tu̱ a-ko̱se̱-tu̱ u-bo̱r ne̱ zu̱ye̱, u̱zu̱ bo̱r-u̱t zu̱u̱g, &lt;Wu̱ nase̱ is-du̱ o̱r-u̱ wa, waku̱n de̱ na-su̱ du̱ wa is-de̱. Wu̱ tu̱msu̱ fare̱ nin-yu̱ o̱r-u̱ wa, waku̱n de̱ far-du̱ yu̱ wa nin-ya.&gt;<note caller="+" style="f"><char style="fr" closed="false">5:38 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt" closed="false"><ref loc="EXO 21:24">Rwu̱u̱ 21:24</ref>; <ref loc="LEV 24:20">To̱o̱g 24:20</ref>; </char><char style="xt"><ref loc="DEU 19:21">Muut 19:21</ref></char>.</note> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>Tu̱msu̱ u̱m o̱ waru̱ no̱ a no̱ to̱p waku̱n u̱ no̱m-u yo̱-o̱ remu̱ zu̱ wa no̱ngu̱ no̱m-u̱t yo̱-to̱ da. A waku̱n u̱ gapu̱ bo̱ u̱ gar-yu̱ kom u̱s-cwa bir u̱ gar-yu̱ kuse̱. <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>A waku̱n u̱t-sa wa hu̱u̱t bo̱ u̱ be-du̱ kwu̱p-du̱ u̱s-rem remu̱ u̱zu̱ wa o̱ngte̱ to̱ggo̱-u ró, yasu̱ wa to̱ggo̱-yu̱ do̱m. <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>A karma-yu̱ wa bo̱ u̱ kabu̱ wa u̱r-ba u̱ ha-mu̱ u-mer u-gan u̱r-be̱b, no̱m ha-mu̱ u̱s-me̱r u̱s-yu̱r u̱ wa ne̱. <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>A waku̱n u̱ ko̱nu̱ bo̱ u-no̱m, ya' wa. Wu̱ haane̱ m-se̱g u̱du̱ ró, a-bo̱ hoos wa da.<verse eid="MAT 5:42"/></para>
  <para style="s1">Cwanu̱n hu̱u̱b-u̱t yo̱-to̱ no̱.</para>
  <para style="r">(<ref loc="LUK 6:27-28">Ruka 6:27-28</ref>,<ref loc="LUK 6:32-36">32-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>&lt;&lt;No̱ ho̱k Mosa panu̱g u̱zu̱, &lt;Cwanu̱n o̱r-u̱t no̱ ne̱,&gt;<note caller="+" style="f"><char style="fr" closed="false">5:43 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="LEV 19:18">To̱o̱g 19:18</ref></char>.</note> no̱ gu̱gu̱m i gu̱gmu̱ no̱ ne̱. <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>Se̱di u̱m o̱ waru̱ no̱, cwanu̱n i gu̱gmu̱ no̱ ne̱, i o̱ ne̱ u̱ yadu̱ no̱ u̱r-ko̱b no̱mu̱n e̱ u̱s-to̱o̱g. <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>No̱mo̱n iya remu̱ no̱ shu̱'u̱te̱ ya'agu̱ U̱so-u no̱ wu̱ o̱ u̱ do̱m u-ru̱. Wa wu̱' ho̱-du̱ ya' m-zu̱n u̱du̱ ne̱t-u̱t so̱-to̱ u̱du̱ tu̱ za so̱-to̱ ne̱. Wa rob u-yu̱ u̱du̱ ne̱t-u̱t so̱-to̱ ne̱ u̱ tu̱ yo̱-to̱ ne̱. <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>A no̱ o̱ cwan-tu̱ i o̱ cwan-u̱t no̱ ne̱, ¿yan to̱p-o̱ no̱ de̱ u̱t-kwu̱m? Ko̱ a-o̱nku̱ shik tar ne̱ iya o̱ e̱ nomte̱! <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>A no̱ o̱ vu̱k-su̱ o̱r-u̱t no̱ u̱ war'e̱, ¿yan-o̱ u̱ no̱ nome̱ u̱ no̱ zekte̱ e̱ke̱n ne̱? Ko̱ i nape̱ u-Ru̱ da, e̱ nom iya! <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>U̱ remu̱ iya, se̱ no̱ shu̱'u̱t shu̱yi-shu̱yi u̱ka U̱so-u no̱ u̱ do̱m u-ru̱ o̱tte̱ u-shu̱yi shu̱yi.<verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">Ye̱so̱ no̱ng u̱t-ko̱se̱ u̱ka <optbreak/> no̱m-du̱ u-nya</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>&lt;&lt;Ye̱so̱ re shu̱ u̱ no̱mu̱ a-doru̱ wa-u̱t-ko̱se̱ u̱zu̱, &lt;A no̱ o̱ no̱m-du̱ no̱m-u̱t so̱-to̱,&gt; a no̱ no̱m o̱ da-u̱ ne̱t-tu̱ o̱ madu̱ no̱ remu̱ e̱ vom-u̱t no̱ da. A no̱ no̱me̱ o̱ko̱n remu̱ ne̱t-tu̱ vom-u̱t no̱, no̱ za kwu̱m-du̱ u-to̱p u̱du̱ U̱so-u no̱ wu̱ o̱ do̱m u-ru̱ da.<verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>&lt;&lt;U̱ remu̱ iya a no̱ o̱ nya-du̱ waku̱n wa u̱r-ko̱b u-no̱m, a no̱ no̱m u̱r-do̱nse̱ da, u̱ka a-ha-mu̱ u̱r-no̱ ne̱ nomte̱ u̱-me bu-u̱ u̱t-ko̱se̱ u̱ Yahuda-ne̱ u̱s-fu̱n ne̱ u̱ remu̱ zu̱ u̱ ne̱t-tu̱ vom-u̱t e̱. U̱m o̱ waru̱ no̱ u̱t-nip e̱ taaste̱ o̱nk-u̱ to̱p-u e̱ u-be̱e̱t iya. <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>Tu̱msu̱ a no̱ o̱ yadu̱ waku̱n o̱ko̱n no̱m-o̱, a-bo̱ yage̱ u̱ to̱ko̱n ne̱t-to̱ u̱ nap no̱m-u̱ bo̱ u̱t-no̱m da. <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>Iya o̱ no̱ do̱te̱ no̱m-du̱ u-Nya m-yasa. Tu̱msu̱ U̱so-u no̱, wa hyene̱ no̱m-tu̱ m-yasa u̱t-be̱e̱t, wa no̱mu̱ bo̱ u-to̱p.<verse eid="MAT 6:4"/></para>
  <para style="s1">U̱t-ko̱se̱ u̱ mo̱ttu̱ u̱s-to̱o̱g</para>
  <para style="r">(<ref loc="LUK 11:2-4">Ruka 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>&lt;&lt;Tu̱msu̱ a no̱ o̱ u̱ no̱m-du̱ u̱s-to̱o̱g, a no̱ no̱m u̱ka a-ha-mu̱ u̱r-no̱ ne̱ nomte̱ da, e̱ ton e̱ ees u̱-me̱ bu-u̱ u̱t-ko̱se̱ u̱ Yahuda-ne̱ u̱s-fu̱n ne̱ remu̱ ne̱t-tu̱ hyen-u̱t e̱. U̱m o̱ waru̱ no̱ u̱t-nip, e̱ taaste̱ o̱nk-u̱ to̱p-u e̱ u-be̱e̱t iya. <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>Se̱di a-bo̱ o̱ no̱m-du̱ u̱s-to̱o̱g, cwa u̱-me u-kur bo̱ tage̱ u-is, se̱ bo̱ no̱m u̱s-to̱o̱g u̱du̱ U̱so-u ró wu̱ na hyente̱ da. U̱so-u ró wu̱ hyene̱ no̱m-tu̱ m-yasa wa de̱ no̱mu̱ bo̱ u-to̱p. <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>A no̱ o̱ no̱m-du̱ u̱s-to̱o̱g, a no̱ ha u̱ sop-su u-no̱m u̱r-ba da u̱ka i nape̱ ne̱ u-Ru̱ da, i o̱ m-hyan u̱ka zu̱, a e̱ no̱me̱ iya da, ru̱-u u̱n za ho̱g-du̱ to̱o̱g-u̱s u̱n da. <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>A no̱ no̱m u̱ka e̱ da, remu̱ U̱so-u no̱ nak no̱m-tu̱ no̱ u̱t-sa kanda no̱ ko̱n wa.<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>&lt;&lt;No̱mo̱n u̱s-to̱o̱g inya,</para>
  <para style="q1" vid="MAT 6:9">&lt;&lt; &lt;U̱so-u it, wu̱ o̱ do̱m u-ru̱,</para>
  <para style="q1" vid="MAT 6:9">U̱m u̱t-sa u̱ ne̱t-tu̱ vam bo̱ u̱ no̱m-u̱ e̱ o̱ u̱t-no̱m u-be̱e̱t.<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>U̱ faru̱k-u̱r ró u̱ haan,</para>
  <para style="q1" vid="MAT 6:10">No̱m-tu̱ bo̱ u̱t-sa na no̱m-to̱,</para>
  <para style="q2" vid="MAT 6:10">u-dak u̱ka na nomte̱ u̱ do̱m u-ru̱.<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>Bo̱ ya' it no̱m u̱t-re̱ u̱ ko-uyan ho̱-de̱.<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>Bo̱ no̱mu̱ it ho̱-du̱ ba'as-u̱t it,</para>
  <para style="q2" vid="MAT 6:12">u̱ka it nomte̱ i no̱mu̱ it u̱t-ba'as u̱r-ho̱.<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>A-bo̱ hu̱u̱t it u̱ be-du̱ m-reg da,</para>
  <para style="q2" vid="MAT 6:13">se̱di bo̱ e̱' it u̱du̱ faru̱k-u̱ no̱m u̱s-te.&gt;<verse eid="MAT 6:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 6:14"/>A no̱ no̱mu̱ ne̱t-tu̱ no̱mu̱ no̱ u̱t-ba'as u̱r-ho̱, U̱so-u no̱ wu̱ o̱ do̱m u-ru̱ wa de̱ no̱mu̱ no̱ ho̱-du̱ ba'as-u̱t no̱. <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>Se̱di a no̱ no̱me̱ u̱t-ne̱t ho̱-du̱ ba'as-u̱t e̱ da, U̱so-u no̱ wa za no̱mu̱ no̱ ho̱-du̱ ba'as-u̱t no̱ da.<verse eid="MAT 6:15"/></para>
  <para style="s1">U̱t-ko̱se̱ u̱ mo̱t-tu̱ u-swaat</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>&lt;&lt;A no̱ kabe̱ u-swaat, a no̱ naas shu̱u̱t no̱ u̱ka a-ha-mu̱ u̱r-no̱ ne̱ nomte̱ da. E̱ naas u̱t-shu̱ u̱ remu̱ e̱ ko̱ste̱ u̱t-ne̱t u̱zu̱ e̱ o̱ u-swaat. U̱m o̱ waru̱ no̱ u̱t-nip, u̱n taaste̱ o̱nk-u̱ to̱p-u u̱n u-be̱e̱t. <verse eid="MAT 6:16"/><verse number="17" style="v" sid="MAT 6:17"/>Tu̱msu̱ a-bo̱ o̱ no̱m-du̱ u-swaat, saape̱ shu̱-u ró, bo̱ taam m-no̱o̱g u̱ hi-u̱r ró, <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>ta'as na nap u̱zu̱ bo̱ o̱ u-swaat da. U̱so-u ró de̱ no̱mu̱ bo̱ u-to̱p, wu̱na hyene̱ no̱m-tu̱ na nome̱ m-yasa.<verse eid="MAT 6:18"/></para>
  <para style="s1">Cu̱n-du̱ do̱m u-ru̱</para>
  <para style="r">(<ref loc="LUK 12:33-34">Ruka 12:33-34</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>&lt;&lt;Ano̱ cin kwu̱m-u̱t no̱ u-dak uno̱ da, be-du̱ rog m-kaari ne̱ do̱te̱ u̱t-naas, u̱ be-du̱ hyu̱w-ne̱ do̱te̱ u̱r-cwa e̱ no̱m u-hiw. <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>Se̱di no̱ no̱m u̱r-cu̱n u̱ do̱m u-ru̱ u̱ be-du̱ orog u̱ m-kaari ne̱ zatte̱ u̱t-na'as da, u̱ be-du̱ hyu̱w-ne̱ tu̱msu̱ e̱ zatte̱ u̱t-hyu̱w da. <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>Be-du̱ kwu̱m-u̱t no̱ o̱tte̱ ku̱na jab-u̱ ró o̱tte̱.<verse eid="MAT 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>&lt;&lt;Is-de̱ o̱ye̱ zu̱n-mu̱ u-war. A is-u̱r ró o̱ye̱ m-yar ne̱, war-u ró u-be̱e̱t u̱t-shu̱'u̱t m-zu̱n ne̱. <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>Se̱di a is-u̱ ró za so̱ye̱ da, war-u ró u-be̱e̱t o̱ de̱ shu̱'u̱t u-cwu̱m ne̱. Abite̱ zu̱n-mu̱ o̱ me̱ no̱ cwu̱m o̱, re̱-o̱ tat-u̱ cwu̱m-u o̱!<verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>&lt;&lt;Waku̱n za no̱mu̱ tu̱-shu̱ u̱t-yu̱r m-to̱k da. Se̱di wa gu̱gu̱m wa-gan u̱ wa cwan wa-gan, ko̱ wa no̱m no̱m-u̱ wa-gan u̱t-sa wa ju̱ru̱m wa-gan. No̱ za wadu̱ do̱rru̱ u-Ru̱ u̱ jab tu̱msu̱ no̱ wa-cwan-tu̱ shik-u̱ jab u-da u-gan da.<verse eid="MAT 6:24"/></para>
  <para style="s1">Yadu̱ jab u̱du̱ u-Ru̱</para>
  <para style="r">(<ref loc="LUK 12:22-31">Ruka 12:22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>&lt;&lt;U̱ remu̱ iya, u̱m o̱ waru̱ no̱, a no̱ naas jab-u̱ remu̱ no̱mu̱ no̱ de̱ u̱t-re̱ ko̱ u̱ no̱ de̱ u̱t-swa, ko̱ kus-tu̱ no̱ de̱ u̱t-wa u̱ war-u no̱ da. Fat-du̱ ze̱k no̱m u̱t-re̱, tu̱msu̱ war-u̱ ze̱k u̱t-kus tu̱ no̱ de̱ u̱t-wa. <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>Gwatu̱n no i do̱m u-ru̱. E̱ no̱m-u̱t ku̱w da. E̱ no̱m-u̱t ket da. E̱ cin-u̱t u̱r-bya da. Napu̱n u̱zu̱ U̱so-u no̱ wu̱ do̱m u-ru̱, wa re̱gu̱sse̱ e̱, wa de̱ ya'u̱ no̱ no̱m-u̱ no̱ u̱t-sa no̱ nom-u̱t u̱r-yu̱. No̱ ze̱k no u-so u-tát! <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>¿Wana u̱ te̱k-u̱ me̱ no̱ u̱ remu̱ namu̱ jab wa de̱ keru̱ swu̱ru̱ hi-u̱r wa, u-kwam u-gan u̱ te̱k-u̱ ru̱t-u̱t wa?<verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>&lt;&lt;¿U̱ remu̱ yan o̱ no̱ o̱tte̱ u̱ na-su̱ jab-u̱ remu̱ u̱t-kus tu̱ no̱ de̱ u̱t-wa? Gwatu̱n pyak-u̱t tu̱ u̱r-do̱g u̱ka to̱ hopte̱ u̱ ne̱n. To̱ no̱m-u̱t m-to̱k ko̱ u-te̱ u̱t-kus da. <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>U̱m o̱ u̱ waru̱ no̱, ko̱ Suremanu Faru̱k-u̱ m-sek, wa tamu̱g no̱m-du̱ u̱t-u̱k ba pyak-u̱t du̱ u̱r-gan da! <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>A shu̱'u̱te̱ u̱zu̱ Ru̱-u̱ de̱ no̱mu̱ gwa-su̱ u̱r-do̱g u̱t-u̱k su̱ o̱ye̱ u̱zu̱ u̱ ya-o̱ se̱ o̱ye̱, u-sot u̱ na gu̱n se̱ u-ra, za u-sakna Ru̱-u̱ de̱ ya'u̱ no̱ cwu̱-tu̱ m-wa. No̱ a-yadu̱ jab ne̱ cashi! <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>U̱ remu̱ iya, a no̱ naas jab u̱zu̱, &lt;¿yan-o̱ it de̱ u̱t-re̱?&gt; Ko̱ &lt;¿yan-o̱ it de̱ u̱t-swa?&gt; Ko̱ &lt;¿yan-o̱ in do̱'e̱ u̱t-wa'e̱?&gt; <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>I nape̱ ne̱ u-Ru̱ da, e̱ u̱t-sa no̱m-u̱t to̱. U̱so-u no̱ wu̱ o̱ye̱ u̱ do̱m u-ru̱ wa nak u̱zu̱ no̱ u̱t-sa no̱m-u̱t to̱ u̱t-be̱e̱t. <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>Se̱di no̱m-u̱ ze̱ge̱ u̱r-zwar, no̱ sa' faru̱k-du̱ u-Ru̱ u̱ no̱m-u̱t so̱-to̱ wa ne̱, no̱m-u̱t to̱ u̱t-be̱e̱t wa ya'u̱ no̱ to̱. <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>U̱ remu̱ iya, a no̱ naas jab-u̱ remu̱ u-sot da, sot-u̱ de̱ haan u̱ to̱k-m wa ne̱. Ko̱-uyan ho̱-de̱ to̱k-m wa ko̱rge̱ wa.<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">Kwu̱pu̱ waku̱n u̱s-rem</para>
  <para style="r">(<ref loc="LUK 6:37-38">Ruka 6:37-38</ref>,<ref loc="LUK 6:41-42">41-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>&lt;&lt;A no̱ kwu̱pu̱ waku̱n u̱s-rem da, tas na kwu̱pu̱ no̱ u̱s-rem da. <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>Remu̱ zu̱, ka no̱ kwu̱pte̱ u̱t-ne̱t u̱s-rem, iya o̱ Ru̱-u̱ do̱te̱ u̱ kwu̱pu̱ no̱. Ko̱k-du̱ no̱ mu̱'u̱ste̱ u̱t-ne̱t, de̱ Ru̱-u̱ do̱te̱ mu̱su̱ no̱.<verse eid="MAT 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 7:3"/>&lt;&lt;¿Remu̱ u-yan o̱ bo̱ o̱tte̱ u̱ gwat-du̱ pyar i-te o̱ is-du̱ o̱r-u̱ ró, bo̱ hak bo̱, bo̱ gwat king-u̱ o̱ u̱ is-u̱r ró da? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>¿Tu̱msu̱ re̱ne̱ o̱ bo̱ do̱te̱ zu̱ o̱r-u̱ ró, &lt;Yage̱ u̱m has-tu̱ bo̱ pyar i-te u̱ is-u̱r ró,&gt; bo̱ ya hen u-king ne̱ u̱-me̱ u̱ is-u̱r ró? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>Bo̱ wa ha-mu̱ u̱r-no̱, ba m-has king-u̱ o̱ u̱-me̱ is-u̱r ró, da-u o̱ bo̱ de̱ u̱t-hyan u̱r-zwar ne̱, bo̱ haste̱ pyar i-te i o̱ is-du̱ o̱r-u̱ ró.<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>&lt;&lt;A no̱ nya' o̱' no̱m-tu̱ u-he̱n tu̱ u-Ru̱ da. A no̱ no̱me̱ iya, e̱ u̱t-byu̱ru̱n e̱ yap no̱ ko̱ ho̱nsu̱ no̱. Tu̱msu̱ a no̱ gwu̱nu̱ u̱t-are̱de̱ no̱m-tu̱ shik da, remu̱ u̱zu̱ e̱ de̱ jangu̱ to̱ u̱s-na.<verse eid="MAT 7:6"/></para>
  <para style="s1">U̱s-ko̱n, u̱t-sa, u̱t-ko̱o̱t ne̱</para>
  <para style="r">(<ref loc="LUK 11:9-13">Ruka 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>&lt;&lt;No̱mo̱n u̱s-ko̱n, na de̱ ya'u̱ no̱; sa'an no̱, de̱ u̱t-kwu̱m; ko̱to̱n u-is, na de̱ u̱ up-su̱ no̱. <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>Remu̱ zu̱ ko̱wana ko̱ne̱ na ya'u̱ wa; ko̱wana de̱ u̱t-sa wa u̱t-kwu̱m; tu̱msu̱ ko̱wana ko̱o̱te̱ u-is na up-su̱ wa.<verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>&lt;&lt;¿Wana u̱ te̱k-u̱ me̱ no̱, wu̱ wa'-u̱ wa de̱ ko̱n-du̱ wa u̱r-be̱re̱di, se̱ wa ya' wa u̱r-ta'ar re? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>¿Ko̱ a wa'-u̱ wa u̱ ko̱n wa u-jan wa ya' wa u-fa? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>No̱ o̱ye̱ ne̱t-u̱t yo̱-to̱, no̱ nak yadu̱ no̱m-u̱t so̱-to̱ u̱du̱ ya'ag-u̱ no̱. Re̱ne̱ o̱ do̱te̱ u̱t-shu̱'u̱t, U̱so-u no̱ wu̱ o̱ do̱m u-ru̱, wa de̱ yadu̱ no̱m-u̱t so̱-to̱ u̱du̱ i o̱ ko̱n-du̱ wa! <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>No̱m-tu̱ no̱ o̱ u̱t-sa u̱ ne̱t-tu̱ no̱mu̱ no̱, no̱mu̱n e̱ iya, iya o̱ Mosa u̱ a-warru̱ rem-su̱ u-Ru̱ pu̱nte̱ m-tumb ne̱.<verse eid="MAT 7:12"/></para>
  <para style="s1">Is-u re̱k-ya u̱ yu̱ yat-ya ne̱</para>
  <para style="r">(<ref loc="LUK 13:24">Ruka 13:24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>&lt;&lt;Cwaan u̱ is-u re̱k-ya. U̱m zu̱u̱g iya remu̱ u̱zu̱ is-yu̱ hu̱ye̱ u̱ be-u̱r yo̱-de̱ ya o̱ m-hu̱k ne̱. Tu̱msu̱ fu̱n-u ya o̱tte̱ m-ku̱k mu̱ u̱t-do̱r, i o̱ye̱ u̱r-cwa u̱ fu̱n-u ya e̱ o̱ u-tát. Is-u ya hu̱u̱t u̱t-ne̱t u-me̱ bu-u u-ra. <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>Tu̱msu̱ is-yu̱ ha-mu̱ be-du̱ u̱r-fat, ya o̱ re̱k-ya. Fu̱n-u ya tu̱msu̱ na so u̱r-ko̱b u̱ do̱rru̱ ya. I o̱ u̱ do̱rru̱ ya e̱ za u̱ u-tát da.<verse eid="MAT 7:14"/></para>
  <para style="s1">Bo̱ napu̱ go̱-du̱ u-te <optbreak/> remu̱ ya-u̱t wa</para>
  <para style="r">(<ref loc="LUK 6:43-44">Ruka 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>&lt;&lt;No̱mo̱n ga' u̱ a-warru̱ rem-su̱ u-Ru̱ ne̱ i u̱s-bi ne̱, i de̱ haan u̱du̱ no̱ u̱ka ca u̱ hyan-mu̱ u-shu̱, se̱di u̱ me̱n-tu̱ me̱, e̱ o̱ u̱ka go'. <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>No̱ napu̱ u̱n remu̱ no̱m-tu̱ u̱n o̱ u̱t-no̱m. ¿Ne̱t-tu̱ ka ya-tu̱ inabi u̱ war-u̱ u-hir, ko̱ ya-tu̱ u-bab u̱ war-u̱ te-yu̱ tu̱ntu̱r? <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>Iya hen te̱-u so̱-ya, ya mu̱t ya'at so̱-to̱, te-yu̱ za so̱-ya da ya mu̱t ya-tu̱ za so̱-to̱. <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>Te̱-u so̱-ya ya za mat-du̱ ya'at so̱-to̱ da, iya o̱ tu̱msu̱ te̱-u yo̱-ya, ya za ke̱rru̱ mat-du̱ ya'at so̱-to̱ da. <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>Ko̱-uyan te-ya yu̱ mate̱ ya'at so̱-to̱ da, na de̱ kup-su̱ ya, na guns ya u-ra. <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>Iya o hen, no̱ napu̱ a-warru̱ rem-su̱ u̱s-bi remu̱ no̱m-tu̱ u̱n o̱ u̱t-no̱m.<verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>&lt;&lt;Za ko̱wana de̱ fag-du̱ me̱, &lt;Wa-ko-uyan, Wa-ko-uyan,&gt; wa de̱ cwa-du̱ faru̱k-du̱ u-Ru̱ da. Se̱ wu̱ no̱me̱ no̱m-tu̱ U̱so-u ri wu̱ o̱ye̱ u̱ do̱m u-ru̱ o̱ u̱t-cwan. <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>U̱ ho̱-du̱ kwu̱p-du̱ u̱s-rem, e̱ke̱n do̱'e̱ u̱t-zu̱, &lt;Wa-ko-uyan! Wa-ko-uyan! It no̱mu̱g u̱t-bu̱t u̱ te̱k-u̱ dim-u̱r ró, it yu̱n no̱m u̱s-te u̱ te̱k-u̱ dim-u̱r ró tu̱msu̱ it no̱m no̱m-tu̱ m-shin tu̱-yat-to̱ u̱ te̱k-u̱ dim-u̱r ró&gt; <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>U̱ da-u o̱ u̱m de̱ zu̱ u̱n, &lt;U̱m nak no̱ da. Hatu̱n du̱gu̱ kit-u̱ ri no̱ a no̱m-du̱ no̱m-u̱t yo̱-to̱ ne̱!&gt;<verse eid="MAT 7:23"/></para>
  <para style="s1">Wa-u-ma wu̱ u̱s-ve̱r u̱ <optbreak/> wa-za-u̱s-ve̱r ne̱</para>
  <para style="r">(<ref loc="LUK 6:47-49">Ruka 6:47-49</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>&lt;&lt;U̱ remu̱ iya, ko̱wana ho̱ge̱ re̱m-u̱s ri, wa dor se̱, wa o̱ ba wa u̱s-ve̱ru̱ wa, wu̱ maye̱ bu-u wa u̱ do̱m-u̱ po̱k u-ta'ar. <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>Da-u̱ yu̱-u̱ kasne̱, gi-su̱ shi m-bu̱, mya-mu̱ yu̱nne̱ mo̱ gu̱p u-bu tu̱msu̱ o̱ he̱e̱g da. Remu̱ u̱zu̱ na maag o̱ u̱ do̱m-u̱ po̱k u-ta'ar. <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Ko̱wana ho̱ge̱ re̱m-u̱s ri wa kagu̱b se̱ da, wa o̱ ba ragu̱ ne̱t-tu̱ wa, wu̱ maye̱ bu-u wa u̱ do̱m m-hereg. <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>Da-u̱ yu̱-u̱ kasne̱, se̱ gi-su̱ shi m-bu̱, mya-mu̱ yu̱nne̱ mo̱ gu̱p u-bu, se̱ bu-u o̱ he, he̱-u̱r yo̱-de̱.&gt;&gt;<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28"/>Da-u̱ Ye̱so̱ tase̱ warru̱ no̱m-u̱t to̱, se̱ ban-du̱ u̱t-ne̱t hu̱ mu̱rimmo̱ u̱ remu̱ ko̱se̱-u̱t wa, <verse eid="MAT 7:28"/><verse number="29" style="v" sid="MAT 7:29"/>remu̱ zu̱ wa ko̱kse̱ u̱ te̱k-u̱ m-shin, za ba a-ko̱se̱-tu̱ re̱m-su̱ u-bo̱r ne̱ da.<verse eid="MAT 7:29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">Ye̱so̱ haste̱ waku̱n m-kim</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mark 1:40-45</ref>; <ref loc="LUK 5:12-16">Ruka 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>17 Da-u̱ Ye̱so̱ cu̱zne̱ du̱gu̱ u̱r-ro̱r, ban-du̱ u̱t-ne̱t u-tát dor wa. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>Se̱ yaku̱n campa-ya kim, wa haan wa he u̱t-jwu̱n u̱ shu̱ Ye̱so̱ wa zu̱, &lt;&lt;U̱so-u̱ u-bu ri, a-bo̱ cwane̱, bo̱ u̱t-kere̱ bo̱ haste̱ me̱ m-kim.&gt;&gt;<verse eid="MAT 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3"/>Ye̱so̱ jaku̱s kom-u wa wa tu̱m wu̱n, wa zu̱, &lt;&lt;U̱m cwanu̱g, bo̱ kum m-yar!&gt;&gt; Za rem, se̱ kim-mu̱ yagu̱ wu̱n. <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>Se̱ Ye̱so̱ zu̱ wu̱n, &lt;&lt;Gwat, a-bo̱ waru̱ waku̱n da, se̱di bo̱ do̱'e̱ bo̱ ko̱se̱ hi-du̱ war ró u̱du̱ yu̱-Yat-ya a-to̱o̱g-ne̱, tu̱msu̱ bo̱ no̱m u-nya u̱ka bo̱r-u̱t Mosa ko̱ste̱ u̱-me̱ re̱m-su̱ u-bo̱r,<note caller="+" style="f"><char style="fr" closed="false">8:4 </char><char style="ft" closed="false">Gwa tu̱msu̱t: </char><char style="xt"><ref loc="LEV 14:2-32">To̱o̱g 14:2-32</ref></char>.</note> u̱zu̱ bo̱ no̱m iya u̱ ko̱ste̱ u̱zu̱ bo̱ kwu̱mu̱g m-yar.&gt;&gt;<verse eid="MAT 8:4"/></para>
  <para style="s1">Ya-du̱ jab-u̱ yu̱-shu̱ karma-ne̱</para>
  <para style="r">(<ref loc="LUK 7:1-10">Ruka 7:1-10</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>Da-u̱ Ye̱so̱ cwaane̱ u̱ Kapanahum se̱ yu̱-shu̱ karma-ne̱ yu̱ Roma, wa haan wa ko̱n wu̱n u̱zu̱, <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>&lt;&lt;Wa-m-nap, to̱k-u ri wa o̱ m-ru̱t u-bu wa kerte̱ u̱s-zo̱o̱g da, wa o̱ swadu̱ u̱r-ko̱b.&gt;&gt;<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>Ye̱so̱ zu̱, &lt;&lt;Me̱ u̱t-haan U̱m ya wu̱n m-yar.&gt;&gt;<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>Se̱ karma-yu̱ zu̱ wu̱n, &lt;&lt;Wa-m-nap, u̱m ko̱rge̱ bo̱ haan u̱ bu-u ri da. Se̱di bo̱ no̱m u̱s-rem du̱gu̱ ana, to̱k-u ri wa u̱t-kwu̱m m-yar. <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>U̱m zu̱u̱g iya, remu̱ zu̱ u̱m o̱ te̱k u̱r-faru̱k du̱ hi-du̱ war ri, tu̱msu̱ u̱m o̱tte̱ karma-ne̱ u̱ ta'u̱ ri a u̱m zu̱ye̱ warmo, &lt;No̱k,&gt; se̱ wa no̱k, u̱m zu̱ warmo &lt;Haane̱,&gt; wa u̱t-haan, u̱m zu̱ to̱k-u̱ ri wa &lt;No̱m inya,&gt; wa u̱t-no̱m.&gt;&gt;<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>Da-u̱ Ye̱so̱ ho̱ge̱ iya se̱ wa nom mu̱rimmo̱, wa zu̱ ne̱t-tu̱ o̱ do̱rru̱ wa, &lt;&lt;U̱m o̱ waru̱ no̱ u̱t-nip, ko̱ te̱k-u̱ Isra-ne̱ u̱m tamu̱g hyan-du̱ wa yadu̱ jab ba campa-u inya da. <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>U̱m o̱ waru̱ no̱, u̱ te̱k-u̱ a-yadu̱ jab ne̱ u̱ me̱ e̱ de̱ u̱t-haan du̱gu̱ u-ta u-do̱m ne̱, e̱ u̱t-shu̱'u̱t e̱ re no̱m u̱t-re̱ u̱r-kot e̱ Ibrahi u̱ Ishaku u̱ Yakubu ne̱ u̱ teku̱ Faru̱k-du̱ do̱m u-ru̱. <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>No̱ ne̱t-tu̱ Isra-ne̱, Ru̱-u̱ de̱ gwu̱n-du̱ no̱ u̱-me̱ u-cwu̱m, u̱ be-du̱ u̱s-kan sok u̱ ep-mu̱ nin ne̱.&gt;&gt;<verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>Se̱ Ye̱so̱ zu̱ yu̱-shu̱ karma-yu̱ Roma, &lt;&lt;No̱k, na no̱ngu̱ bo̱ ka bo̱ o̱tte̱ u̱ssa remu̱ yadu̱ jab-u̱ ró.&gt;&gt; Za rem to̱k-u̱ wa kum m-yar.<verse eid="MAT 8:13"/></para>
  <para style="s1">Ye̱so̱ yaag ne̱t-ne̱ u-tát m-yar</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mark 1:29-34</ref>; <ref loc="LUK 4:38-41">Ruka 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>Da-u̱ Ye̱so̱ cwaye̱ u̱ bu-u Biturus se̱ wa he̱n ino-u ne̱ta Biturus m-ru̱t u-yu̱n hyam-u̱ o̱tte̱ wa. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>Se̱ Ye̱so̱ tu̱m kom-u wu̱n, se̱ hyam-u̱ yage̱ wu̱n. Se̱ wa yu̱ne̱ wa no̱mu̱ u̱n nom-u̱t re̱. <verse eid="MAT 8:15"/><verse number="16" style="v" sid="MAT 8:16"/>Da-u̱ rim-mu̱ tore̱, se̱ ne̱t-tu̱ hatu̱n Ye̱so̱ i no̱m u̱s-te shipse̱ wa buz no̱m u̱s-te u̱ re̱m-su̱ nu-u wa. Tu̱msu̱ wa hast u̱t-ne̱t u̱t-be̱e̱t u̱s-go̱m. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>Wa no̱mu̱g iya u̱ remu̱ na shu̱u̱ste̱ no̱mu̱ wa-warru̱ rem-su̱ u-Ru̱ Ishaya zu̱ye̱,</para>
  <para style="q1" vid="MAT 8:17">&lt;&lt;Wa ku̱bu̱ste̱ go̱m-u̱s in,</para>
  <para style="q2" vid="MAT 8:17">wa hast ko̱b-du̱ m-yaru̱ in.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">8:17 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 53:4">Isha 53:4</ref></char>.</note><verse eid="MAT 8:17"/></para>
  <para style="s1">Swadu̱ u̱r-ko̱b du̱ o̱ u̱-me̱ <optbreak/> doru̱ Ye̱so̱</para>
  <para style="r">(<ref loc="LUK 9:57-62">Ruka 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>Da-u̱ Ye̱so̱ hyane̱ ban-du̱ u̱t-ne̱t gu̱nu̱ste̱ wa, se̱ wa zu̱, &lt;&lt;Yagu̱n in pasu̱n u̱ din-de̱ jit gwu̱g-du̱ m-sa de̱.&gt;&gt; <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>Se̱ wa ko̱se̱-tu̱ re̱m-su̱ u-bo̱r haan wa zu̱ wu̱n, &lt;&lt;Wa-u̱t-ko̱se̱, me̱ do̱ru̱ bo̱ ko̱he̱ne̱ bo̱ o̱tte̱ m-ha.&gt;&gt;<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>Se̱ Ye̱so̱ zu̱ wu̱n, &lt;&lt;O̱' u̱r-do̱g o̱tte̱ u̱s-hu̱ su̱ m-roog, no do̱m u-ru̱ o̱tte̱ u̱t-tu̱ku̱s tu̱ m-roog, se̱di Wa'-u̱ Ne̱t zatte̱ be-du̱ res-du̱ hi-u̱r wa da.&gt;&gt;<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>Waku̱n u̱ te̱k-u̱ a-doru̱ Ye̱so̱ ne̱ wa zu̱ wu̱n, &lt;&lt;Wa-m-nap, yage̱ u̱m do̱'e̱ u̱m jwaku̱n u̱so-u ri u-ro.&gt;&gt;<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>Se̱ Ye̱so̱ zu̱ wu̱n, &lt;&lt;Do̱rnu̱ me̱, yage̱ i mare̱, e̱ jwak o̱ru̱t e̱ marimari ne̱.&gt;&gt;<verse eid="MAT 8:22"/></para>
  <para style="s1">Ye̱so̱ wa'ag jwaak m-bu̱ <optbreak/> res te̱k</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mark 4:35-41</ref>; <ref loc="LUK 8:22-25">Ruka 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>Da-u̱ Ye̱so̱ cwaye̱ u-hat, a-doru̱ wa dor wu̱n. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>Se̱ mya-mu̱ yu̱nne̱ u̱r-be̱b ne̱ u̱-me̱ m-sa se̱ bu̱-mu̱ hu̱ m-cwa u-hat. Tu̱msu̱ Ye̱so̱ o̱ m-roog. <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>Se̱ u̱n do̱'e̱, u̱n yu̱ns wa, u̱n zu̱, &lt;&lt;Wa-m-nap, u̱kru̱ in! In do̱'e̱ u̱t-is m-bu̱!&gt;&gt;<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>Se̱ wa zu̱ u̱n, &lt;&lt;¿Remu̱ yan-o̱ no̱ o̱tte̱ u̱ ho̱g-du̱ u-gye̱r, no̱ a-yadu̱ jab ne̱ cashi?&gt;&gt; Se̱ wa yu̱nne̱ wa hagu̱sse̱ m-mya u̱ jwak m-bu̱ ne̱ se̱ mo̱ ho u̱s-ram te̱k.<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>Se̱ ne̱t-tu̱ hu̱ u̱ mu̱rimmo̱ e̱ zu̱, &lt;&lt;¿Yan ne̱t wa unwa wu̱ mya-mu̱ ho̱ge̱ re̱m-u̱s wa u̱ jwak m-bu̱ ne̱?&gt;&gt;<verse eid="MAT 8:27"/></para>
  <para style="s1">Ye̱so̱ haste̱ no̱m u̱s-te u̱ <optbreak/> war-u̱ ne̱t-ne̱ yu̱r</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mark 5:1-20</ref>; <ref loc="LUK 8:26-39">Ruka 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>Da-u̱ wa teene̱ u̱ dak-u̱ Gadari, se̱ e̱ke̱n campa-ne̱ yu̱r i no̱m-u̱s u̱s-te̱ shipe rwu̱u̱n u̱ be-du̱ u̱t-sag e̱ bit wu̱n. E̱ no̱ng u̱ yo̱-ye̱ sok, e̱ yu̱u̱t u̱ ne̱t-tu̱ do̱r fu̱n-u ya da.<verse eid="MAT 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 8:29"/>Za rem e̱ he̱e̱se̱ u̱t-jar e̱ zu̱, &lt;&lt;¿Bu̱-m ró yu̱ u̱ it ne̱ Wa'-u̱ u-Ru̱? ¿Bo̱ haagu̱n bo̱ ya it u̱r-ko̱b kanda da-u̱ no̱me̱?&gt;&gt;<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>Nu̱ku̱stu̱n sok u̱ku̱n ne̱ da, ban-du̱ u̱t-are̱de̱ o̱ u̱t-re̱e̱g. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>Se̱ no̱m u̱s-te kon Ye̱so̱ e̱ zu̱, &lt;&lt;A-bo̱ ruut it da, yage̱ it cwa u̱-me̱ ban-du̱ u̱t-are̱de̱.&gt;&gt;<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>Se̱ wa zu̱, &lt;&lt;No̱ko̱n no̱ cwa u̱-me̱ u̱t-are̱de̱.&gt;&gt; Se̱ ban-du̱ u̱t-are̱de̱ u̱t-be̱e̱t to̱ ru m-so̱m to̱ irig du̱gu̱ u-pingse̱ m-he̱ u̱-me̱ m-sa bu̱-mu̱ rees to̱. <verse eid="MAT 8:32"/><verse number="33" style="v" sid="MAT 8:33"/>Se̱ a-gwat-du̱ u̱t-are̱de̱ ne̱, e̱ som m-mu̱ u-bo̱ e̱ wu̱r no̱m-tu̱ kume̱ i o̱tte̱ no̱m u̱s-te. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>Se̱ ne̱t-tu̱ u-bo̱ u-be̱e̱t e̱ rwu̱u̱n u̱ remu̱ e̱ hyen-u̱t Ye̱so̱. Da-u̱ u̱n hyane̱ wa, u̱n kon wa yage̱ dak-u u̱n.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">Ye̱so̱ haste̱ waku̱n <optbreak/> go̱m-su̱ m-ryam</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>Ye̱so̱ cwaag u̱-me̱ u-hat, wa pu̱s m-ha u̱ Kapanahum u̱ bo̱-u wa. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>Ne̱t-tu̱ hatu̱n wu̱n wa go̱m-su̱ m-ryam m-ru̱t u̱r-wu̱ndi. Da-u̱ Ye̱so̱ hyane̱ yadu̱ jab-u̱ u̱n, se̱ Ye̱so̱ zu̱ wu̱ o̱tte̱ u̱s-go̱m, &lt;&lt;Wa zwar, a-bo̱ naas jab da, na haste̱ bo̱ ba'as-u̱t ró.&gt;&gt;<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>Da-u̱ a-ko̱se̱-tu̱ u-bo̱r ne̱ ho̱ge̱ iya, se̱ e̱ zu̱, &lt;&lt;Ne̱t unwa o̱ warru̱ rem-su̱ u̱t-ba'as! ¿Wa o̱ m-hyan u̱ka zu̱ wa o̱ u-Ru̱?&gt;&gt;<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>Ye̱so̱ nak no̱m-u̱ o̱ jab-u̱s u̱n, se̱ wa zu̱ u̱n, &lt;&lt;¿Remu̱ u-yan o̱ no̱ o̱tte̱ dorog-u̱s yo̱-se̱ u̱ jab-u̱s no̱? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>¿Yan-o̱ ze̱ge̱ m-ku̱ke na zu̱ ne̱t, &lt;Na haste̱ wa u̱t-ba'as,&gt; ko̱ na zu̱, &lt;Yu̱ne̱ bo̱ ha m-ha&gt;? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>U̱m u̱t-sa no̱ nap u̱zu̱, Wa'-u̱ Ne̱t o̱tte̱ m-shin mu̱ hastu̱ ba'as-tu̱ ne̱t-u̱ dak-u uno̱.&gt;&gt; Se̱ wa zu̱ wa go̱m-su̱ m-ryam, &lt;&lt;Yu̱ne̱ bo̱ kab wu̱ndi-u̱r ró bo̱ mu u-bu.&gt;&gt; <verse eid="MAT 9:6"/><verse number="7" style="v" sid="MAT 9:7"/>Campa-u ya yu̱ne̱ wa aru̱k m-mu̱ u-bu. <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>Da-u̱ ban-du̱ u̱t-ne̱t hyane̱ iya, e̱ hog u-gye̱r, e̱ no̱mu̱ u-Ru̱ u̱t-vam wu̱ ya' u̱t-ne̱t go̱-du̱ mo̱mo̱ shin-mo̱.<verse eid="MAT 9:8"/></para>
  <para style="s1">Ye̱so̱ fak Matiyu wa do̱r wa</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mark 2:13-17</ref>; <ref loc="LUK 5:27-32">Ruka 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>Da-u̱ Ye̱so̱ re̱ u-shu̱ m-ha ne̱, se̱ wa hyen yaku̱n campa-ya, wu̱na foge̱ Matiyu, wa o̱ shu̱'u̱t u̱ o̱nk-u̱ shik-u̱ tar. Se̱ Ye̱so̱ zu̱ wu̱n, &lt;&lt;Do̱rnu̱ me̱.&gt;&gt; Se̱ wa yu̱ne̱ wa do̱r Ye̱so̱.<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>A sure̱ m-wa'as, Ye̱so̱ o̱ u-re̱ u̱ bu-u Matiyu, se̱ a-o̱nku̱ shik-u̱ tar u̱ a-u̱t-ba'as-ne̱ haan e̱ shu̱'u̱t e̱ nom u-re̱ u̱ be-du̱ wa o̱tte̱ u̱ a-doru̱ wa ne̱. <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>Da Farisa-ne̱ hyane̱ iya, se̱ e̱ zu̱ a-doru̱ wa, &lt;&lt;¿Remu̱ u-yan o̱ wa-u̱t-ko̱se̱ no̱ o̱tte̱ u-re̱ u̱ a-o̱nku̱ shik-u̱ tar ne̱ u̱ a-u̱t-ba'as-ne̱?&gt;&gt;<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>Da-u̱ Ye̱so̱ ho̱ge̱ iya, se̱ wa zu̱, &lt;&lt;A-m-yar ne̱ za u̱ssa wa u̱s-baat da, se̱di a-ko̱b-du̱ m-yar ne̱. <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>No̱ko̱n no̱ iis nap-mu̱ re̱m-su̱ u-Ru̱ su̱ zu̱ye̱, &lt;Ho̱g-du̱ u̱r-o̱n de̱ u̱m u̱t-sa, za to̱o̱g da.&gt;<note caller="+" style="f"><char style="fr" closed="false">9:13 </char><char style="ft" closed="false">Hose̱ 6:6 (Ran-u̱ Girik). </char></note> Remu̱ zu̱ u̱m haagu̱n u̱m fag a-jab-u̱s so̱-se̱ ne̱ da, se̱di a-u̱t-ba'as.&gt;&gt;<verse eid="MAT 9:13"/></para>
  <para style="s1">Ne̱t-tu̱ shu̱k-u̱t Ye̱so̱ u̱ <optbreak/> mo̱ttu̱ u-swaat</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mark 2:18-22</ref>; <ref loc="LUK 5:33-39">Ruka 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>A-doru̱ Yohanna haan u̱du̱ Ye̱so̱ e̱ zu̱, &lt;&lt;¿Yan-o̱ wu̱te̱ it u̱ Farisa-ne̱ be̱e̱t it no̱m u-swaat, se̱di a-doru̱ ró no̱m-u̱t da?&gt;&gt;<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;Hu̱u̱b-tu̱ zwar u̱r-gu̱ no̱m-u̱t namu̱ jab da-u̱ wa u̱r-kot u̱ u̱n ne̱ da. Se̱di da-u̱ o̱o̱n u̱ na do̱te̱ kab-du̱ wu̱n u̱ teku̱ u̱-me̱ u̱n, Da-u o̱ u̱n de̱ no̱m-du̱ u-swaat.&gt;&gt;<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>&lt;&lt;Waku̱n zaar wu̱ de̱ kara-du̱ to̱ggo̱-yu̱ u-ut u̱ kus-u po-o̱ da, remu̱ zu̱ ana jaase̱ to̱ggo̱-u ya kara-u̱r re̱ de̱ u̱t-kees, ke̱-u̱t to̱ he̱n u̱t-ze̱g u̱r-taku̱n m-yo̱. <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>Waku̱n zaar wu̱ de̱ dasu̱ ke̱' po-ye̱ u̱ me̱n-tu̱ ut-u̱r shar-du̱ u-ka da. A wa no̱mu̱ iya ke̱' po-ye̱ de̱ yo̱gu̱sse̱ shar-du̱ u̱r-ut du̱ u-ka, u̱ bu̱-mu̱ ke̱' azu̱g, shar-du̱ u-ka de̱ nu̱u̱s. Bu̱-m po-mo̱ mu̱ ke̱' na da'as mo̱ u̱ shar-u̱r po-de̱ du̱ u-ka. Bu̱-mu̱ ke̱ po'ye̱ na daas mo̱ u̱ sharru̱ u-ka du̱ po-de̱ u̱ka mo̱ zatte̱ u̱t-agu̱z da.&gt;&gt;<verse eid="MAT 9:17"/></para>
  <para style="s1">Wa'-u̱ Yayirus wa-gwu̱p e̱ <optbreak/> ne̱ta-yu̱ wu̱du̱ m-hyu̱ ne̱</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mark 5:21-43</ref>; <ref loc="LUK 8:40-56">Ruka 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>Ye̱so̱ o̱ te̱k-u̱ waru̱ u̱n iya, se̱ te̱k-u̱ tu̱-shu̱ bu-u̱ u̱t-ko̱se̱ u̱ Yahuda-ne̱ haan wa he u̱t-jwu̱n u̱ shu̱ Ye̱so̱ wa zu̱, &lt;&lt;Wa'-u̱ ri wa'-u̱-gwu̱p maru̱g za m-tumb, se̱di haane̱ bo̱ tam wu̱n, wa u̱t-yu̱ne̱.&gt;&gt; <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>Ye̱so̱ yu̱ne̱ u̱ a-doru̱ wa ne̱, e̱ do̱r campa-u ya.<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>Na o̱ u̱ te̱k-u̱ se̱, yaku̱n ne̱ta-ya wu̱ no̱me̱ u̱s-hak o̱p-u̱s yu̱r [12], wa o̱ pama wu̱du̱ m-hyu̱, wa haan wa tu̱m kwak-yu̱ to̱ggo̱-u Ye̱so̱. <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>Ne̱ta-yu̱ no̱ng iya remu̱ zu̱ wa cu̱nu̱g u̱ jab-u̱ wa u̱zu̱, &lt;&lt;A u̱m tame̱ to̱ggo̱-u Ye̱so̱ me̱ u̱t-kwu̱m m-yar.&gt;&gt;<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>Da-u̱ Ye̱so̱ bire̱ wa got wu̱n, se̱ wa zu̱, &lt;&lt;Ne̱ta, a-bo̱ naas jab da, yadu̱ jab-u̱ ró yaag bo̱ m-yar.&gt;&gt; Za rem ne̱ta-yu̱ kum m-yar.<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>Da-u̱ Ye̱so̱ cwaye̱ bu-u̱ yu̱-Yat-ya yu̱ Kur-u̱ u̱t-Ko̱se̱, wa bit ne̱t-ne̱ u̱t-jar u̱ fu̱u̱-du̱ se̱p-tu̱ m-mar ne̱. <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>Wa zu̱, &lt;&lt;Yu̱nu̱n u̱ ane̱, wa'-u̱-gwu̱p maru̱g da, roog-mo̱ wa o̱tte̱.&gt;&gt; E̱ hu̱ no̱mu̱ wu̱n nu̱mu̱s-tu̱ u̱s-ju̱ru̱m. <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>Da-u̱ ne̱t-tu̱ ru̱ye̱ u̱-do̱, se̱ wa to̱, wa ship kom-u̱ wa'-u̱-gwu̱p, za rem wa yu̱ne̱! <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>Rem-su̱ no̱m-u o̱ te̱ ko̱he̱ne̱ u̱-me̱ dak-u o̱.<verse eid="MAT 9:26"/></para>
  <para style="s1">Ye̱so̱ upuste̱ po̱-ne̱ is</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>Ye̱so̱ o̱ yagu̱ be-u̱r re̱, se̱ e̱ke̱n po̱-ne̱ yu̱r hu̱ fag-u̱s rò u̱zu̱, &lt;&lt;Wa'-u̱ Dawuda ho̱g o̱n-u̱r it!&gt;&gt;<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>Da-u̱ Ye̱so̱ cwaye̱ u̱-me̱, se̱ po̱-ne̱ e̱ haan u̱du̱ rò. Se̱ wa zu̱ u̱n, &lt;&lt;¿No̱ yaag jab u̱zu̱ me̱ ke̱ru̱ yan-o̱ m-yar?&gt;&gt;</para>
  <para style="p" vid="MAT 9:28">E̱ zu̱ wu̱n, &lt;&lt;Wa-m-nap, it o̱ yadu̱ jab.&gt;&gt;<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>Se̱ wa tu̱m is-u̱ u̱n, wa zu̱, &lt;&lt;U̱ remu̱ yadu̱ jab-u̱ no̱, na ya'ag no̱ m-yar.&gt;&gt; <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>Da-u̱ is-u̱ u̱n upse̱, Ye̱so̱ no̱mu̱ u̱n u̱t-him u̱zu̱, &lt;&lt;A no̱ waru̱ waku̱n da.&gt;&gt; <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>Da-u̱ e̱ ruye̱, e̱ hu̱ warru̱ rem-u̱s se̱ ko̱he̱ne̱, u̱-me̱ dak-u o̱.<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>Da-u̱ e̱ o̱ mo̱ttu̱ u̱r-aru̱k, se̱ ne̱t-tu̱ hattu̱n waku̱n wu̱ o̱tte̱ no̱m u̱s-te u̱du̱ Ye̱so̱ tu̱msu̱ wa kerte̱ u̱s-rem da. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>Da-u̱ na rute̱ no̱m u̱s-te, se̱ campa-u ya he̱e̱se̱ u̱s-rem. Mo̱ro̱g-du̱ u̱t-ne̱t hu̱ mu̱rimmo̱, e̱ zu̱, &lt;&lt;Na tamu̱g hyan-du̱ o̱ko̱n no̱m-u̱ inya u̱-me̱ Isra da, se̱ u̱ ya-o̱.&gt;&gt;<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>Se̱ Farisa-ne̱ zu̱, &lt;&lt;U̱ be̱b-du̱ faru̱k-u̱ no̱m u̱s-te de̱ wa o̱tte̱ rutu̱ no̱m u̱s-te.&gt;&gt;<verse eid="MAT 9:34"/></para>
  <para style="s1">Ye̱so̱ ho̱k o̱n-du̱ u̱t-ne̱t</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>Ye̱so̱ do̱r u̱t-bo̱ u̱t-taas ne̱ u̱t-be̱e̱t, wa o̱ no̱mu̱ ne̱t-ne̱ u̱t-ko̱se̱, u̱-me̱ bu-u̱ u̱t-ko̱se̱ u̱ Yahuda-ne̱, wa o̱ bu̱t-tu̱ Rem-su̱ m-Re̱me̱r su̱ Faru̱k-du̱ u-Ru̱, wa o̱ tu̱msu̱ hastu̱ ne̱t-ne̱ u̱s-go̱m su̱ ko̱-uyan re̱-mo̱. <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>Da-u̱ wa hyane̱ ne̱t-tu̱ mo̱ro̱gte̱ u-tát, se̱ wa ho̱g o̱n-u̱r u̱n, remu̱ zu̱, e̱ o̱ swadu̱ u̱r-ko̱b, za wa u̱r-se̱ge̱, u̱ka ca i za wa-u̱t-got. <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>Se̱ wa zu̱ a-doru̱ wa ne̱, &lt;&lt;Ket o̱ u-tát, se̱di a-ke̱t-ne̱ o̱ cashi. <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>Remu̱ iya ko̱no̱n Wa-ko-uyan, wa to̱mto̱n a-ke̱t-ne̱ u̱ tak-u wa.&gt;&gt;<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">Ye̱so̱ fak a-doru̱ wa o̱p-u̱ yu̱r</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mark 3:13-19</ref>; <ref loc="LUK 6:12-16">Ruka 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>Ye̱so̱ fak a-doru̱ wa o̱p u̱ yu̱r [12]. Wa yu̱' e̱ u̱r-faru̱k, e̱ ruut no̱m u̱s-te, tu̱msu̱ e̱ hast ko̱-uyan go̱mse̱ u̱ ko̱b-du̱ m-yar ne̱.<verse eid="MAT 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2"/>Tunto̱ to̱ o̱ dim-tu̱ a-to̱mu̱ Ye̱so̱ o̱p-u̱ yu̱r [12]:</para>
  <para style="li1" vid="MAT 10:2">Wa u̱r-taku̱n Simo̱n o̱r-u̱ wu̱na foge̱ Biturus, u̱</para>
  <para style="li1" vid="MAT 10:2">O̱r-u̱ wa ne̱ Andarawus, u̱</para>
  <para style="li1" vid="MAT 10:2">Yakubu wa'-u̱ Zabadi u̱</para>
  <para style="li1" vid="MAT 10:2">O̱r-u̱ wa Yohanna, u̱<verse eid="MAT 10:2"/></para>
  <para style="li1">
    <verse number="3" style="v" sid="MAT 10:3"/>Firibi, u̱</para>
  <para style="li1" vid="MAT 10:3">Bataromi, u̱</para>
  <para style="li1" vid="MAT 10:3">Tomas, u̱</para>
  <para style="li1" vid="MAT 10:3">Matiyu ne̱ wa-o̱nku̱ shik-u̱ tar, u̱</para>
  <para style="li1" vid="MAT 10:3">Yakubu wa'-u̱ Aru̱payes, u̱</para>
  <para style="li1" vid="MAT 10:3">Tadiyus ne̱, u̱<verse eid="MAT 10:3"/></para>
  <para style="li1">
    <verse number="4" style="v" sid="MAT 10:4"/>Simo̱n wa shu̱b-du̱ u-dak,</para>
  <para style="li1" vid="MAT 10:4">Yahudas Iskariyoti ne̱ wu̱ yasu̱ Ye̱so̱.<verse eid="MAT 10:4"/></para>
  <para style="s1">Ye̱so̱ to̱mo̱g a-doru̱ wa o̱p-u̱ yu̱r [12]</para>
  <para style="r">(<ref loc="MRK 6:7-13">Mark 6:7-13</ref>; <ref loc="LUK 9:1-6">Ruka 9:1-6</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>Ye̱so̱ to̱mo̱g a-doru̱ wa o̱p-u̱ yu̱r, wa zu̱ e̱, &lt;&lt;A no̱ cwa u̱ bu-u̱ a-za Yahuda-ne̱ da, tu̱msu̱ a no̱ cwa u̱ o̱ko̱n bo̱-o̱ u̱ Samariya-ne̱ da. <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>Se̱di no̱ do̱'e̱ u̱du̱ ne̱t-tu̱ Isra i o̱ u̱ka ca i e̱nke̱. <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>De̱'e̱n no̱ no̱m u̱t-bu̱t u̱zu̱, &lt;Faru̱k-du̱ u-Ru̱ o̱ u̱t-mo̱r!&gt; <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>No̱ hast u̱t-ne̱t u̱s-go̱m, no̱ yu̱ns i mare̱ ne̱, no̱ hastu̱ ne̱t-ne̱ m-kim, tu̱msu̱ no̱ ruut no̱m u̱s-te. A no̱ o̱ se̱gu̱ u̱t-ne̱t a no̱ o̱nk shik da, remu̱ Ru̱-u̱ o̱nkte̱ shik da-u̱ wa se̱gu̱ no̱ da. <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>A no̱ kab shik ko̱ o̱ko̱n no̱m-o̱ u̱ka shik-u̱ no̱ do̱te̱ no̱m-du̱ o̱ko̱n u̱-me̱ ba-u̱t no̱ da. <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>Tu̱msu̱ a no̱ kab ba-du̱ m-ha, ko̱ yaku̱n to̱ggo̱-ya da, a no̱ kab se̱ke̱n na-su̱ u̱t-ka'at u̱s-yu̱r da, ko̱ yaku̱n ko̱m-yu̱ m-ha da, remu̱ zu̱ wa u-pama u-be̱e̱t wa kamu̱g kwu̱m-du̱ to̱p-u̱ pama-u̱ wa no̱me̱ u̱-me̱ u̱t-ne̱t, remu̱ iya no̱ kwu̱mu̱ no̱m u̱t-re̱, u̱ to̱ko̱n no̱m-to̱ ne̱ u-me̱ ne̱t-tu̱ no̱ do̱'e̱ u̱du̱ e̱.<verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>&lt;&lt;Bo̱-u̱ no̱ tote̱ ko̱ u-taas, sa'an ne̱t u̱r-ka, no̱ shu̱'u̱t u̱ wa ne̱ kanda no̱ yu̱ne̱ u̱r-aru̱k. <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>Bu-u̱ no̱ tote̱ u-be̱e̱t, no̱ vu̱ku̱s e̱. <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>Bu-u̱ no̱ tote̱ u-be̱e̱t, a e̱ gu̱ no̱, no̱mu̱n u̱n u̱s-to̱o̱g u̱ Ru̱-u̱ ya u̱n ru̱s-du̱ jab, tu̱msu̱ bu-u̱ no̱ tote̱ a e̱ kabe̱ hamtu̱-u̱r no̱ da, Ru̱-u̱ za yadu̱ u̱n res-du̱ jab da. <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>Wu̱ gu no̱ da u-be̱e̱t, ko̱ wa gu̱gu̱m re̱m-u̱s no̱, pamtu̱n huug-mu̱ u̱s-na no̱, no̱ ru u̱-me̱ bu-u o̱ ko̱ u-bo̱, u̱t-shu̱'u̱t u̱t-him u̱du̱ u̱n u̱zu̱ Ru̱-u̱ de̱ ya-du̱ u̱n u̱r-ko̱b ba u̱n gu̱gme̱ e̱rru̱ rem-u̱s no̱. <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>U̱m o̱ waru̱ no̱ u̱t-nip, Ru̱-o̱ u̱t-ze̱g m-ho̱g o̱n-du̱ ne̱t-tu̱ dak-u̱ Saduma u̱ Gomora ne̱, m-ze̱g ne̱t-tu̱ bo̱-u o̱ u̱ ho̱-du̱ kwu̱p-du̱ u̱s-rem.<verse eid="MAT 10:15"/></para>
  <para style="s1">Swa-u̱ u̱r-ko̱b du̱ o̱ haan</para>
  <para style="r">(<ref loc="MRK 13:9-13">Mark 13:9-13</ref>; <ref loc="LUK 21:12-17">Ruka 21:12-17</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>&lt;&lt;U̱m o̱ to̱m-du̱ no̱, u̱ka ca u̱-me̱ go', remu̱ iya shu̱'u̱tu̱n a-u̱s-ve̱r-ne̱ u̱ka fa, tu̱msu̱ m-yar ne̱ u̱ka u̱r-gorop. <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>No̱mo̱n ga', u̱t-ne̱t ne̱, remu̱ zu̱ e̱ de̱ hu̱tu̱ no̱ u̱ bu-tu̱ kwu̱p-du̱ u̱s-rem, tu̱msu̱ e̱ no̱mu̱ no̱ u̱s-ryap u̱ bu-u̱ u̱t-ko̱se̱ u̱ Yahuda-ne̱. <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>Remu̱ zu̱ no̱ yaag jab u̱du̱ ri, u̱n de̱ hu̱u̱tu̱ no̱ u̱du̱ a-u-dak-ne̱ u̱ farkina-ne̱ u̱ remu̱ e̱ kwu̱p-tu̱ no̱ u̱s-rem tu̱msu̱ e̱ ya' no̱ u̱r-ko̱b. Yagu̱n u̱ shu̱'u̱t u̱r-ke̱r u̱du̱ no̱, remu̱ no̱ war-tu̱ farkina-ne̱ u̱ a-za Yahuda-ne̱ Re̱m-su̱ m-Re̱me̱r. <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>Da-u̱ e̱ yasu̱ no̱, a no̱ ha u̱s-dorog u̱ remu̱ no̱m-u̱ no̱ de̱ u̱t-war da, remu̱ Yar u-Ru̱ o̱ do̱r-tu̱ no̱ u̱ no̱mu̱ no̱ de̱ u̱t-war. <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>U̱m zu̱u̱g iya remu̱ zu̱, a no̱ o̱ u̱s-rem da, Yar-u U̱so-u no̱ o̱ u̱s-rem u̱-me̱ no̱.<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>&lt;&lt;Ne̱t-tu̱ de̱ yasu̱ o̱r-u̱t e̱ na hoot, u̱so u̱ de̱ yasu̱ wa'-u̱ wa na hoot, ya'ag de̱ zwarnu̱ i matu̱ e̱ ne̱, e̱ wa na hoot e̱. <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>Ne̱t-ne̱ be̱e̱t, e̱ de̱ gu̱gmu̱ no̱ remu̱ do̱ro̱g me̱. Se̱di wu̱ gagu̱ jab m-ha m-vaste̱, wa u̱t-kwu̱m u-u̱ku̱r. <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>A e̱ o̱ yadu̱ no̱ u̱r-ko̱b u̱-me̱ o̱ko̱n bo̱-o̱, so̱mo̱n m-ha o̱ko̱n bo̱-o̱. U̱m o̱ waru̱ no̱ u̱t-nip, no̱ za u̱tte taas padu̱ bo̱-tu̱ Isra u̱t-be̱e̱t da, Wa'-u̱ Ne̱t de̱ mu̱u̱n.<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>&lt;&lt;Wa-u-iis zaru̱ ze̱gu̱ wa-u̱t-ko̱se̱ wa da, tu̱msu̱ to̱k ze̱k u̱so-u̱ bu-u wa da. <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>Wa-u-iis u̱t-kere̱ u̱t-shu̱'u̱t ba wa-u̱t-ko̱se̱ wa tu̱msu̱ to̱k u̱t-kere̱ u̱t-shu̱'u̱t ba u̱so-u bu-u wa. Ana fage̱ u̱so u̱ u-bu faru̱ku̱ no̱m u̱s-te, u̱n de̱ fag-du̱ a-u-bu wa ne̱ ko̱'e̱ m-ze̱g iya!<verse eid="MAT 10:25"/></para>
  <para style="s1">Ho̱go̱n gye̱r-u u-Ru̱ za ne̱t da</para>
  <para style="r">(<ref loc="LUK 12:2-7">Ruka 12:2-7</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>&lt;&lt;A no̱ ho̱g gye̱r-u u̱t-ne̱t da, remu̱ zu̱ o̱ko̱n za u̱ o̱ u̱r-tage̱ u̱ na za u̱t-upus da, tu̱msu̱ o̱ko̱n za m-yasa u̱ na za u̱t-rwu̱tu̱n m-zu̱n da. <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>No̱m-u̱ u̱m o̱ waru̱ no̱ u-cwu̱m waru̱n o̱ m-zu̱n; tu̱msu̱ no̱m-u̱ u̱m waru̱ no̱ m-yasa, no̱mo̱n do̱nse̱-du̱ o̱. <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>A no̱ ho̱g gye̱r-u̱ i de̱ ho̱-du̱ u-war da, se̱di e̱ za ke̱rru̱ ho̱-du̱ yar-u ne̱t da. Ho̱go̱n gye̱r-u̱ wu̱ de̱ ho̱-du̱ yar-u̱ ne̱t u̱ war-u wa ne̱ tu̱msu̱ wa gun to̱ u̱-me̱ bu-u u-ra. <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>Na bu̱b no yu̱r u̱ ko̱nko̱ shik u-gan. Ko̱ u-gan u̱ te̱k-u̱ me̱ u̱n ya za u̱t-he̱ u-dak za nap-du̱ U̱so-u no̱ wu̱ o̱ do̱m-u̱ u-ru̱ da. <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>Wa o̱ u̱r-kot u̱ no̱ ne̱, ko̱ hi-su̱ hi-u̱r no̱ wa nak nu̱se̱ no̱ o̱tte̱ <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>Remu̱ iya, a no̱ ho̱g u-gye̱r da. No̱ ze̱k no u̱so u-tát.<verse eid="MAT 10:31"/></para>
  <para style="s1">U̱t-war u̱zu̱ in nak u-Ru̱</para>
  <para style="r">(<ref loc="LUK 12:8">Ruka 12:8</ref>,<ref loc="LUK 12:9">9</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>&lt;&lt;Wu̱ ko̱se̱ u̱zu̱ wa, wu̱ ri wa, u̱ te̱k-u̱ me̱ u̱t-ne̱t, ko̱ me̱, me̱ u̱t-ko̱se̱ wa wu̱ ri wa u̱ u̱du̱ U̱so-u ri wu̱ o̱ do̱m-u̱ u-ru̱. <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>Tu̱msu̱ wu̱ no̱me̱ se-m ri, u̱du̱ u̱t-ne̱t, ko̱ me̱, me̱ no̱mu̱ se-m wa u̱du̱ U̱so-u ri wu̱ o̱ me̱ do̱m-u̱ u-ru̱.<verse eid="MAT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>&lt;&lt;A no̱ kab u̱zu̱ ru̱s-du̱ jab de̱ u̱m hatu̱n u̱-me̱ u-dak da. U̱m hatu̱n res-du̱ jab da, se̱di van-u̱ m-wu̱r.<verse eid="MAT 10:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 10:35"/>&lt;&lt;U̱m hagu̱n remu̱ u̱m samte̱.</para>
  <para style="q1" vid="MAT 10:35">&lt;&lt; &lt;U-u̱so e̱ wa'-u̱ wa,</para>
  <para style="q2" vid="MAT 10:35">wa'-u̱ gwu̱p tu̱msu̱ e̱ ino-u wa,</para>
  <para style="q1" vid="MAT 10:35">U-ku̱mro, e̱ ku̱mu̱ wa.<verse eid="MAT 10:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="MAT 10:36"/>Hu̱u̱b-u̱t yo̱-to̱ ró de̱ u̱t-shu̱'u̱t</para>
  <para style="q2" vid="MAT 10:36">u̱-me̱ ne̱t-tu̱ bu-u ró.&gt;<note caller="+" style="f"><char style="fr" closed="false">10:36 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="MIC 7:6">Mika 7:6</ref></char>.</note> &gt;&gt;<verse eid="MAT 10:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MAT 10:37"/>Se̱ Ye̱so̱ zu̱, &lt;&lt;Ne̱t be̱e̱t wu̱ ze̱ge̱ m-cwan uso-u wa ko̱ ino-u wa, m-ze̱g me̱, wa ko̱rge̱ wa shu̱'u̱t wa doru̱ ri da. Tu̱msu̱ wu̱ cwane̱ wa'-u̱ wa m-ze̱g me̱, wa ko̱rge̱ wa shu̱'u̱t wu̱ ri da. <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>Wu̱ kabe̱ kan-u wa, wa do̱r me̱ da, wa ko̱rge̱ wa shu̱'u̱t ne̱tu̱ ri da. <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>Wu̱ cwane̱ fat-u̱r wa, wa de̱ u̱t-taag u̱ de̱. Tu̱msu̱ wu̱ taage̱ u̱ fat-u̱r wa, u̱ remu̱ ri, wa de̱ kwu̱m-du̱ de̱.<verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>&lt;&lt;Wu̱ kabe̱ no̱, wa kagu̱b me̱, tu̱msu̱ wu̱ kabu̱ me̱, wa kagu̱b wu̱ to̱mnu̱ me̱. <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>Wu̱ kabe̱ wa-warru̱ rem-su̱ u-Ru̱ remu̱ zu̱ wa o̱ wa-warru̱ rem-su̱ u-Ru̱, wa de̱ kwu̱m-du̱ to̱p-u̱ wa-warru̱ rem-su̱ u-Ru̱ du̱gu̱-du̱ u-Ru̱. Tu̱msu̱ wu̱ kabe̱ wa jab-u̱ so̱-o̱ remu̱ wa o̱ wa jab-u̱ so̱-o̱, wa de̱ kwu̱m-du̱ to̱p-u̱ wa jab-u̱ so̱-o̱. <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>Wu̱ ya'e̱ ko̱k-du̱ bu̱-mu̱ m-tor, wa yu̱' u̱ te̱k-u̱ i-re̱k-e̱ ine̱, remu̱ zu̱ e̱ o̱ a-doru̱ ri, u̱m o̱ waru̱ no̱ u̱t-nip, wa za he̱n u̱t-taag u̱ to̱p-u wa da.&gt;&gt;<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">Ye̱so̱ e̱ Yohanna <optbreak/> wa-u̱t-yu̱bu̱sse̱ m-bu̱</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>Da-u̱ Ye̱so̱ tase̱ no̱mu̱ a-doru̱ wa ne̱ o̱p u̱ yu̱r u̱t-him, se̱ wa yu̱ne̱ wa do̱'e̱ wa o̱ u̱t-ko̱se̱ u̱t-bu̱t ne̱ u̱-me̱ bo̱-tu̱ Gariri.<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>Da-u̱ Yohanna wa-u̱t-yu̱bu̱sse̱ m-bu̱, o̱o̱ge̱ u̱ tage̱ u̱ bu-u̱ m-to̱k. Da-u̱ wa ho̱ge̱ no̱m-tu̱ Ye̱so̱ Kiristi o̱ u̱t-no̱m, se̱ wa tom a-doru̱ wa u̱du̱ Ye̱so̱, <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>e̱ shit wu̱n, &lt;&lt;¿Bo̱ wa wu̱ de̱ haana, ko̱ it wa u̱r-is u̱ waku̱n?&gt;&gt;<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>Ye̱so̱ shu̱s wa zu̱, &lt;&lt;Mu̱u̱n no̱ waru̱ Yohanna no̱mu̱ no̱ o̱ u̱t-hyan tu̱msu̱ no̱mu̱ no̱ o̱ u̱t-ho̱g. <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>Po̱-ne̱ o̱ kwu̱m-du̱ m-hyan, a-za-u̱s-na ne̱ e̱ o̱ m-ha, kim-ne̱ kwu̱ng m-yar, a-za m-ho̱g, e̱ hog u̱s-rem, na o̱ yu̱nsu̱ i mare̱ ne̱, tu̱msu̱ a-u̱r-ko̱b-ne̱ o̱ ho̱g-du̱ Rem-su̱ m-Re̱me̱r. <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>Ru̱-u̱ de̱ wa u̱ ko̱wan u-kom wu̱ no̱me̱ u-sakna u̱ yadu̱ jab u̱du̱ ri da.&gt;&gt;<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>Da-u̱ a-doru̱ Yohanna arke̱, Ye̱so̱ he̱e̱se̱ no̱mu̱ mo̱ro̱g-du̱ u̱t-ne̱t u̱s-rem u̱ Yohanna wa zu̱, &lt;&lt;¿Yan-o̱ no̱ de̱ u̱t-hyan u̱t-kanda? ¿Ko̱ no̱ do̱'e̱ hyan-du̱ tampur u̱ mya-mu̱ ru̱ste̱? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>¿Yan go̱ ne̱t-wa no̱ de̱ u̱ku̱n u̱t-hyane? ¿No̱ de̱ m-do̱'e̱ u̱ku̱n no̱ hyan ne̱t wu̱ wa'e̱ kus-tu̱ shik? O'o! Ne̱t-tu̱ wu̱'e̱ kus-tu̱ shik o̱ bu-tu̱ u̱t-faru̱k. <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>¿To̱ yan-o̱ no̱ de̱ u̱t-hyane? ¿Ko̱ wa-warru̱ rem-su̱ u-Ru̱ wa? U̱, u̱m o̱ waru̱ no̱ he̱n wa ze̱k wa-warru̱ rem-su̱ u-Ru̱.&gt;&gt; <verse eid="MAT 11:9"/><verse number="10" style="v" sid="MAT 11:10"/>Yohanna wa re̱m-su̱ u-Ru̱ nomte̱ u̱s-rem u̱zu̱,</para>
  <para style="q1" vid="MAT 11:10">&lt;&lt; &lt;U̱m de̱ to̱mnu̱ wa-to̱mu̱-u̱ ri,</para>
  <para style="q2" vid="MAT 11:10">kanda Kiristi hatu̱n,</para>
  <para style="q1" vid="MAT 11:10">wu̱ de̱ mangu̱ jab-su̱ u̱t-ne̱t kanda wa haatu̱n.&gt;<note caller="+" style="f"><char style="fr" closed="false">11:10 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="MAL 3:1">Mara 3:1</ref></char>.</note><verse eid="MAT 11:10"/></para>
  <para style="m">
    <verse number="11" style="v" sid="MAT 11:11"/>U̱m o̱ waru̱ no̱ u̱t-nip, na tamu̱g mat-du̱ waku̱n mat-du̱ ne̱ta wu̱ teye̱ Yohanna wa-u̱t-yu̱bu̱sse̱ m-sek da. Se̱di wu̱ o̱ wu̱ re̱k-ya u̱-me̱ faru̱k-du̱ u-Ru̱ ze̱k wu̱n. <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>Du̱gu̱ da-u Yohanna wa-u̱t-yu̱bu̱sse̱ m-bu̱, u̱ haan u̱ uno̱ da-o̱ faru̱k-du̱ u-Ru̱ o̱ swadu̱ u̱r-ko̱b, tu̱msu̱ i o̱ yadu̱ o̱ u̱r-ko̱b e̱ u̱t-sa e̱ rum o̱ u̱r-be̱b. <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>Ko̱se̱-tu̱ Mosa no̱me̱, u̱ ran-tu̱ a-warru̱ rem-su̱ u-Ru̱ ne̱, to̱ no̱mu̱g rem-su̱ faru̱k-u̱r re̱ kanda haan-u̱r Yohanna. <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>A no̱ eese̱ rem-su̱ u̱m o̱ u̱t-war, Yohanna wa na nomte̱ u̱s-rem u̱zu̱ wu̱na o̱ Iriya. Wu̱na a-warru̱ rem-su̱ u-Ru̱ ne̱ zu̱ wa de̱ mu̱u̱n.<note caller="+" style="f"><char style="fr" closed="false">11:14 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="MAL 4:5">Mara 4:5</ref></char>.</note> <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>Yage̱ wa to̱-tu̱ m-ho̱g, wa ho̱g.&gt;&gt;<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>Se̱ Ye̱so̱ zu̱, &lt;&lt;Me̱ waru̱ no̱ ko̱ yan ne̱t-to̱ no̱ o̱ye̱, ne̱t-tu̱ uno̱ cara-o̱. No̱ u̱ka yaag i o̱ shu̱'u̱t u̱-me̱ u-tu̱rru̱, e̱ o̱ fag-du̱ hu̱u̱b-tu̱ ho̱r u̱n u̱zu̱,<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>&lt;&lt; &lt;It fu̱ru̱g u-kar,</para>
  <para style="q2" vid="MAT 11:17">no̱ gu̱gu̱m u̱s-he̱w;</para>
  <para style="q1" vid="MAT 11:17">It fu se̱p-tu̱ m-mar,</para>
  <para style="q2" vid="MAT 11:17">no̱ gu̱gu̱m u̱s-kan.&gt;<verse eid="MAT 11:17"/></para>
  <para style="m">
    <verse number="18" style="v" sid="MAT 11:18"/>Da-u̱ Yohanna haane̱ wa o̱ u-swaat, wa soot m-mu̱di da, e̱ zu̱, &lt;Wa o̱tte̱ no̱m u̱s-te.&gt; <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>Da-u̱ Wa'-u̱ Ne̱t haane̱, wa o̱ u-re̱, wa o̱ u̱t-swa e̱ zu̱, &lt;Hyanu̱n! Wa tat u-re̱ u̱ u-swa ne̱, tu̱msu̱ hu̱u̱b-u̱ a-o̱nku̱ shik-u̱ tar u̱ a-u̱t-ba'as-ne̱!&gt; Se̱di nap-mu̱ u-Ru̱ na nu̱p mo̱ du̱gu̱ ank-m wa.&gt;&gt;<verse eid="MAT 11:19"/></para>
  <para style="s1">No̱m-tu̱ u̱r-o̱n u̱du̱ bo̱-tu̱ <optbreak/> gu̱gme̱ u̱t-byu̱ru̱n</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>Ye̱so̱ he̱e̱se̱ no̱mu̱ ne̱t-tu̱ bo̱-tu̱ wa nomte̱ no̱m-tu̱ m-shin u̱s-rem u̱zu̱ e̱ no̱mu̱g no̱m-tu̱ kame̱ da, remu̱ zu̱ e̱ gu̱gu̱mte̱ yage̱-du̱ ba'as-u̱t e̱. <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>&lt;&lt;No̱m-tu̱ u̱r-o̱n, u̱du̱ ne̱t-tu̱ bo̱-u̱ Corazin! No̱m-tu̱ u̱r-on, u̱du̱ ne̱t-tu̱ bo̱-u Basayada ko̱ e̱! Abite̱ no̱m-tu̱ m-shin tu̱ na no̱me̱ u̱ te̱k-u̱ me̱ no̱ na no̱mu̱g u̱ bo̱-u̱ Taya u̱ bo̱-u̱ Sido̱n ne̱, e̱ za yakke̱ u̱t-ba'as m-tumb ne̱ e̱ wo kus-tu̱ u̱t-kemi, e̱ shu̱'u̱t, e̱ asu̱ hi-u̱t e̱ m-cwa remu̱ e̱ ko̱ste̱ u̱zu̱ e̱ yakke̱ u̱t-ba'as. <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>U̱m o̱ di waru̱ no̱, u̱ ho̱-du̱ kwu̱p-du̱ u̱s-rem, Ru̱-o̱ u̱t-ze̱g m-ho̱g o̱n-du̱ ne̱t-tu̱ Taya u̱ Sido̱n ne̱ m-ze̱g no̱. <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>Tu̱msu̱ no̱ ne̱t-tu̱ bo̱-u̱ Kapanahum, a no̱ kab u̱ka zu̱ Ru̱-u̱ de̱ se̱kmu̱ssu̱ no̱ cwa u̱ do̱m-u̱ u-ru̱ da, no̱ da. Ru̱-u̱ de̱ di gwu̱n-du̱ no̱ u̱ kub-u̱ za u̱r-ma. U̱zu̱ ne̱t-tu̱ dak-u̱ Saduma hyanu̱g no̱m-tu̱ m-shin tu̱ na no̱me̱ u̱ ane̱, e̱ za yakke̱ u̱t-ba'as u̱ bo̱-u̱ e̱ tu̱msu̱ na za dooste̱ bo̱-u o̱ da. <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>Se̱di u̱m o̱ waru̱ no̱, u̱ ho̱-du̱ kwu̱p-du̱ u̱s-rem, Ru̱-o̱ u̱t-ze̱g m-ho̱g o̱n-du̱ ne̱t-tu̱ dak-u̱ Saduma u̱ no̱ ne̱.&gt;&gt;<verse eid="MAT 11:24"/></para>
  <para style="s1">Haanu̱n no̱ kum u̱r-hure̱</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>U̱ da-u o̱ Ye̱so̱ zu̱, &lt;&lt;U-u̱so Wa-ko-uyan wu̱ no̱me̱ u-ru̱ u-dak ne̱, u̱m no̱ngu̱ bo̱ u̱t-vam, remu̱ zu̱ bo̱ yaske̱ no̱m-u̱t tun-to̱ u̱du̱ a-u̱s-ve̱r, u̱ a-m-nap ne̱, bo̱ ko̱se̱-to̱ u̱du̱ ya'ag-u̱ re̱ke̱. <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>Iya o̱, U̱so-u ri, iya o̱ nomte̱ bo̱ u̱r-zwar bo̱ no̱m iya.<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>&lt;&lt;U̱so-u ri ya'aste̱ me̱ ko̱-uyan. Tu̱msu̱ waku̱n zaar wu̱ nape̱ Wa' da se̱ u-U̱so, tu̱msu̱ waku̱n nak u-U̱so da se̱ Wa' tu̱msu̱ wu̱ Wa' cwane̱ se̱ wa ko̱se̱ wa.<verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>&lt;&lt;Haanu̱n u̱du̱ ri, no̱ be̱e̱t i po'e̱, i o̱ swadu̱ u̱r-ko̱b u̱ cwu̱-tu̱ m-no, me̱ ya' no̱ u̱r-hure̱. <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>Kabu̱n kan-u ri no iis du̱gu̱-du̱ ri, remu̱ zu̱ u̱m zatte̱ hu̱k-mu̱ u̱r-hi da, ne̱t m-yar wa u̱m o̱ye̱, no̱ u̱t-kwu̱m u̱r-hure̱ u̱ jab-u̱s no̱. <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>Kan-u ri zatte̱ u̱t-po̱ da, tu̱msu̱ cwu̱-u̱t ri zatte̱ m-no da.&gt;&gt;<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">U̱r-shu̱t u̱ mo̱t-tu̱ <optbreak/> Ho̱-du̱ u̱r-Hure̱</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>Da-u̱ Ho̱-du̱ u̱r-Hure̱ Yahuda-ne̱ no̱me̱, Ye̱so̱ dor u̱-me̱ tak-tu̱ arkama. A-doru̱ wa o̱ ho̱g-du̱ u̱s-me̱r, e̱ he̱e̱se̱ getmu̱ ro̱p-tu̱ arkama e̱ hu̱ u̱t-he̱ke̱m m-tu̱ m-tu̱. <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>Da-u̱ Farisa-ne̱ hyane̱ iya, se̱ e̱ zu̱ wu̱n, &lt;&lt;Hyan, a-doru̱ ró e̱ o̱ no̱m-du̱ no̱m-u̱ bo̱r-tu̱ hose̱ u̱t-no̱m u̱ Ho̱-du̱ u̱r-Hure̱.&gt;&gt;<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>Ye̱so̱ shu̱s wa zu̱ u̱n, &lt;&lt;¿No̱ karu̱nte̱ no̱m-u̱ Dawuda no̱me̱, da-u̱ wa u̱ hu̱u̱b-u̱t wa ne̱ ho̱ge̱ u̱s-me̱r da? <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>U̱ka wa tote̱ u̱-me̱ bu-u̱ u-Ru̱, wa u̱ hu̱u̱b-u̱t wa ne̱, e̱ re no̱m u̱t-re̱ u̱r-sak, u̱ o̱tte̱ ge̱r u̱ kame̱ wa ko̱ hu̱u̱b-tu̱ m-ha wa ne̱ e̱ re̱ da, se̱di a-to̱o̱g-ne̱. <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>No̱ karu̱nte̱ u̱-me̱ bo̱r-tu̱ Ru̱-u̱ yase̱ Mosa, u̱ka a-to̱o̱g-ne̱ hopte̱ pas-du̱ bo̱r-tu̱ Ho̱-du̱ u̱r-Hure̱ u̱-me̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan, u̱ wa nomte̱ m-ank u̱ ho̱-u̱r re̱, tu̱msu̱ shu̱'u̱te̱ u̱t-ba'as da. <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>U̱m o̱ waru̱ no̱, wu̱ ze̱ge̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan u̱ ya u̱ ane̱. <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>U̱zu̱ no̱ nak zu̱n-mu̱ rem-u̱s sin-se̱, &lt;O̱n-de̱ u̱m u̱t-sa, za to̱o̱g da,&gt;<note caller="+" style="f"><char style="fr" closed="false">12:7 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="HOS 6:6">Hose̱ 6:6</ref></char>. (Ran-u̱ Girik.)</note> no̱ za kabu̱g a-za u̱t-ba'as u̱ka a-u̱t-ba'as-ne̱ da. <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>U̱m zu̱u̱g iya remu̱ zu̱ Wa'-u̱ ne̱t o̱tte̱ u̱r-faru̱k u̱ o̱ Ho̱-du̱ u̱r-Hure̱.&gt;&gt;<verse eid="MAT 12:8"/></para>
  <para style="s1">Campa-yu̱ kom-u̱ so̱-se̱</para>
  <para style="r">(<ref loc="MRK 3:1-6">Mark 3:1-6</ref>; <ref loc="LUK 6:6-11">Ruka 6:6-11</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>Ye̱so̱ yage̱ be-du̱ wa o̱tte̱, wa to u̱-me̱ bu-u̱ u̱t-ko̱se̱ u̱ Yahuda-ne̱. <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>Yaku̱n campa-ya o̱ u̱ku̱n wu̱ kom-u̱ so̱se̱. E̱ u̱t-sa e̱ kum no̱mu̱ e̱ ke̱tu̱ wu̱n, se̱ e̱ shit wu̱n u̱zu̱, &lt;&lt;¿Bo̱r-tu̱ zu̱u̱g u̱ ne̱t u̱ hast u̱s-go̱m u̱ Ho̱-du̱ u̱r-Hure̱?&gt;&gt;<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>Wa zu̱ u̱n, &lt;&lt;¿A waku̱n u̱ te̱k-u̱ no̱ o̱tte̱ u-ca, se̱ ya he u̱-me̱ u̱r-du u̱ Ho̱-du̱ u̱r-Hure̱, wa za rwu̱tu̱n ya da? <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>Ne̱t ze̱k u-ca m-sek sok. Remu̱ iya, bo̱r-u̱t it hooste̱ it se̱gu̱ waku̱n u̱ Ho̱-du̱ u̱r-Hure̱ da.&gt;&gt;<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>Tu̱msu̱ wa zu̱ campa-u ya wu̱ kom-u̱ so̱-se̱, &lt;&lt;Nabne̱ kom-u ró!&gt;&gt; Wa nu̱b u-kom hen, za rem kom-u̱ kum m-yar u̱ka kom u-gan. <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>Farisa-ne̱ ru e̱ zo̱ng u̱ka e̱ do̱te̱ ho̱du̱ Ye̱so̱.<verse eid="MAT 12:14"/></para>
  <para style="s1">Ye̱so̱ Wu̱ Ru̱-u̱ dage̱</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>Da-u̱ Ye̱so̱ nape̱ no̱m-u̱ e̱ zo̱nge̱, se̱ wa yage̱ be-u̱r re̱. U̱t-ne̱t u-tát e̱ do̱r wu̱n, tu̱msu̱ e̱ kwu̱ng m-yar be̱e̱t. <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>Wa no̱mu̱ u̱n u̱t-him, u̱zu̱ a u̱n waru̱ waku̱n mo̱t-u̱t rò da. <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>Tunto̱ u̱t-be̱e̱t na no̱ng to̱ remu̱ na shu̱u̱ste̱ no̱mu̱ wa-warru̱ rem-su̱ u-Ru̱ Ishaya ware̱.<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>&lt;&lt;Gwat To̱k-u̱ ri ya, wu̱ u̱m dage̱,</para>
  <para style="q2" vid="MAT 12:18">tu̱msu̱ wu̱ u̱m o̱ u̱t-cwan,</para>
  <para style="q1" vid="MAT 12:18">wu̱ u̱m o̱ ho̱g-du̱ zwar-u̱r wa sok.</para>
  <para style="q2" vid="MAT 12:18">U̱m do̱'e̱ wa'-u̱ wu̱n Yar-u ri,</para>
  <para style="q2" vid="MAT 12:18">tu̱msu̱ wa do̱'e̱ u̱ u̱t-bu̱t</para>
  <para style="q1" vid="MAT 12:18">u̱zu̱ Ru̱-u̱ de̱ no̱mu̱ a-za Yahuda-ne̱</para>
  <para style="q2" vid="MAT 12:18">kwu̱p-du̱ u̱s-rem u̱ka ku̱mte̱.<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>Wa za no̱m-du̱ inan,</para>
  <para style="q2" vid="MAT 12:19">ko̱ rem-su̱ u-har da,</para>
  <para style="q1" vid="MAT 12:19">waku̱n za ho̱g-du̱ cwar-u wa u̱s-fu̱n da.<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>Wa za ge̱t-du̱ tampur</para>
  <para style="q2" vid="MAT 12:20">u̱ u̱t-sa u̱t-ge̱t da,</para>
  <para style="q1" vid="MAT 12:20">Hitirra yu̱ u̱t-sa u̱t-mu̱ru̱s</para>
  <para style="q2" vid="MAT 12:20">wu̱n za ryu̱m-du̱ ya da.</para>
  <para style="q1" vid="MAT 12:20">Se̱ wa wa'ag nip-tu̱ re u̱r-ko̱rro̱.<verse eid="MAT 12:20"/></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21"/>I za-Yahuda-ne̱ da,</para>
  <para style="q1" vid="MAT 12:21">e̱ de̱ wadu̱ jab-u̱s e̱</para>
  <para style="q2" vid="MAT 12:21">u̱-me̱ dim-u̱r Ye̱so̱.&gt;&gt; <note caller="+" style="f"><char style="fr" closed="false">12:21 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 42:1-4">Isha 42:1-4</ref></char>. (Ran-u̱ u̱t-Girik.)</note><verse eid="MAT 12:21"/></para>
  <para style="s1">Ye̱so̱ u̱ Beyerzebu</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mark 3:20-30</ref>; <ref loc="LUK 11:14-23">Ruka 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>U̱n hatu̱n wu̱n waku̱n wu̱ o̱tte̱ no̱m u̱s-te, wa zatte̱ is da tu̱msu̱ wa kerte̱ u̱s-rem da. Ye̱so̱ ye' wa m-yar, campa-u ya no̱m u̱s-rem tu̱msu̱ wa hyen. <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>Ne̱t-tu̱ no̱m mu̱rimmo̱ sok e̱ zu̱, &lt;&lt;¿A ne̱t unwa o̱ye̱ Mesaya da, wu̱ rwu̱ne̱ du̱gu̱ ko̱-u̱r Dawuda, wu̱ in wote̱ jab?&gt;&gt;<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>Da-u̱ Farisa-ne̱ ho̱ge̱ iya, e̱ zu̱, &lt;&lt;Be̱b-u̱r Beyerzebu, faru̱k-u̱ no̱m u̱s-te de̱, wa o̱tte̱ rutu̱ no̱m u̱s-te.&gt;&gt;<verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>Ba Ye̱so̱ nape̱ no̱mu̱ o̱ dorog-u̱s u̱n, se̱ wa zu̱ u̱n, &lt;&lt;Faru̱k-du̱ mo̱te̱ u-yu̱r, kowan o̱ shu̱'u̱t-u̱r yo̱-de̱ e̱ o̱r-u̱ wa ne̱, de̱-de̱ faru̱k de̱ za u̱t-ees da. Tu̱msu̱ u-bo̱, ko̱ bu-u̱ ne̱t-tu̱ u-bu za shu̱'u̱t-u̱r so̱-de̱ da, bu-u o̱ za u̱t-es da. <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>A-no̱m u̱s-te du̱gu̱-du̱ faru̱k-du̱ faru̱k-u̱ no̱m u̱s-te mo̱te̱, shu̱'u̱te̱ faru̱k-u̱ no̱m u̱s-te o̱ m-dum u̱ hi-u̱r wa ne̱, ¿re̱ faru̱k-u̱r wa do̱te̱ u̱t eese? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>Abite̱ Beyerzebu be̱b-du̱ faru̱k-u̱ no̱m u̱s-te de̱ u̱m o̱tte̱ rutu̱ no̱m u̱s-te, ¿A-doru̱ no̱ be̱b-u̱r wan do̱'e̱ rutte̱? A-doru̱ no̱, de̱ kwu̱pu̱ no̱ sin-se̱ rem-se̱. <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>Abite̱ me̱ he̱n be̱b-du̱ Yar-u u-Ru̱ o̱ u̱m o̱tte̱ rutu̱ no̱m u̱s-te, shu̱'u̱te̱ u̱zu̱ faru̱k-du̱ u-Ru̱ hagu̱n u̱ me̱ no̱.<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>&lt;&lt;Waku̱n zaar wu̱ de̱ cwa-du̱ bu-u̱ wa-u̱r-be̱b wa koos cwu̱-u̱t wa da, se̱ da wa gu̱gru̱sse̱ wa u-ro, kanda wa kerte̱ koosu̱ cwu̱-tu̱ bu-u wa.<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>&lt;&lt;Wu̱ za u̱r-kot u̱ me̱ ne̱ da, wa o̱ shu̱'u̱t-u̱r yo̱-de̱ u̱ me̱ ne̱; tu̱msu̱ wu̱ se̱gu̱ me̱ u̱t-kargu̱sse̱ da, bu̱rgu̱sse̱ to̱ wa o̱tte̱. <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>Iya o̱ he̱n, u̱m o̱ waru̱ no̱, na de̱ no̱mu̱ ne̱t-ne̱ u̱r-ho̱ du̱ ko̱-uyan ba'as-to̱, u̱s-ju̱ru̱m ne̱ su̱ e̱ no̱me̱ u-Ru̱, se̱di wu̱ no̱me̱ rem-su̱ u̱s-ju̱ru̱m u̱du̱ Yar u-Ru̱ na za no̱mu̱ wa hastu̱ ba'as-tu̱ da. <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>Wu̱ pyape̱ Wa'-u̱ Ne̱t na no̱mu̱ wa u̱r-ho̱, se̱di wu̱ pyape̱ Yar-u u-Ru̱, na za no̱mu̱ wa u̱r-ho̱ da, u̱ uno̱ da-o̱ ko̱ da-u̱ o̱o̱ne̱.<verse eid="MAT 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>&lt;&lt;Te-yu̱ o̱ so̱-ya, ya mu̱t ya-tu̱ o̱ so̱-to̱. Te-yu̱ za so̱-ya ya mu̱t ya-u̱t yo̱-to̱, na nu̱p u-te du̱gu̱ ya-u̱t wa. <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>No̱ fa' u̱ yo̱-ye̱, ¿re̱ no̱ do̱te̱ keru̱ warru̱ no̱m-tu̱ o̱ so̱-to̱ ba shu̱'u̱te̱ u̱zu̱ no̱ ne̱t-u̱t yo̱-to̱ to̱? No̱mu̱ o̱ me̱ jab o̱ rwu̱ne̱ u-nu. <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>Ne̱t-u̱ so̱-wa wu̱r no̱mu̱ o̱ so̱-o̱, du̱gu̱ me̱ jab-u̱ wa u̱ so̱-o̱, tu̱msu̱ ne̱t-u̱ yo̱-o̱ rwu̱tu̱n no̱m-u̱t yo̱-to̱ tu̱ o̱ jab-u̱ yo̱-o̱ wa. <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>Se̱di u̱m o̱ waru̱ no̱, u̱ ho̱-du̱ kwu̱p-du̱ u̱s-rem, ko̱wan de̱ shu̱'u̱t na kwu̱pu̱ wa u̱s-rem u̱ka ku̱mte̱, ko̱ remu̱ rem-su̱ m-zan su̱ ware̱. <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>Remu̱ rem-su̱ bo̱ ware̱, se̱ na do̱te̱ kwu̱pu̱ bo̱ u̱s-rem, ko̱ se̱ ruut bo̱, ko̱ tu̱msu̱ se̱ ru̱ bo̱.&gt;&gt;<verse eid="MAT 12:37"/></para>
  <para style="s1">A-ko̱se̱-tu̱ u-bo̱r ne̱ u̱ <optbreak/> Farisa-ne̱ e̱ o̱ sa u̱s-nap</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mark 8:11-12</ref>; <ref loc="LUK 11:29-32">Ruka 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>E̱ke̱n u̱ te̱k-u̱ a-ko̱se̱-tu̱ u-bo̱r ne̱, u̱ Farisa-ne̱ e̱ zu̱, &lt;&lt;Wa-m-nap, it u̱t-sa bo̱ no̱m no̱m-tu̱ m-shin u̱ka do̱te̱ ko̱se̱ it u̱zu̱ Ru̱-o̱ to̱mnu̱ bo̱.&gt;&gt;<verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>Se̱ wa shu̱s wa zu̱, &lt;&lt;Ne̱t-tu̱ u̱no̱ da-o̱ no̱ no̱ng u̱ yo̱ye̱, tu̱msu̱ no̱ zatte̱ gye̱r-u u-Ru̱ da. E̱ u̱t-sa e̱ hyan u̱s-nap, se̱di na za ko̱su̱ e̱ se̱ke̱n napse̱ da, se̱di go̱-du̱ su̱ wa-warru̱ rem-su̱ u-Ru̱ Yunana. <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>U̱ka Yunana nomte̱ m-roog u̱t-tu̱t m-gyu̱p u-ho̱ ne̱ u̱-me̱ me̱n-tu̱ jan-u yat-ya, iya o̱ he̱n Wa'-u̱ Ne̱t do̱te̱ no̱m-du̱ m-roog u̱t-tu̱t, m-gyu̱p u-ho̱ ne̱ u̱ me̱n-tu̱ u-dak. <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>U̱ ho̱-du̱ kwu̱p-du̱ u̱s-rem, ne̱t-tu̱ Neneba de̱ rwu̱u̱n u̱ kur-u̱ kwu̱p-du̱ u̱s-rem. E̱ waru̱ u-Ru̱ u̱zu̱ ne̱t-tu̱ uno̱ da-o̱ no̱mu̱g u̱t-ba'as tu̱msu̱ kamu̱g na ya u̱n u̱r-ko̱b. U̱n de̱ u̱t-zu̱ iya, remu̱ zu̱ e̱ ho̱k Yunana u̱t-bu̱t, u̱n yage̱ no̱m-du̱ u̱t-ba'as. Waku̱n wu̱ ze̱ge̱ Yunana ya u̱ ane̱, no̱ gu̱gu̱m yage̱-du̱ u̱t-ba'as. <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>U̱ ho̱-du̱ kwu̱p-du̱ u̱s-rem, u-Re̱n wu̱ Sheba, wa de̱ rwu̱u̱n u̱-me̱ kur u̱ kwu̱p-du̱ u̱s-remu̱ wa waru̱ u-Ru̱ u̱zu̱ ne̱t-tu̱ uno̱ da-o̱ no̱mu̱g u̱t-ba'as tu̱msu̱ kamu̱g na ya u̱n u̱r-ko̱b. U̱m zu̱u̱g iya remu̱ wa hagu̱n du̱gu̱ dak-u̱ m-ra remu̱ u̱m hog-u̱t ve̱r-u̱s Suremanu. U̱ da-o̱ wu̱ ze̱ge̱ Suremanu ya u̱ ane̱, se̱di no̱ gu̱gmu̱ u̱t-e̱r.<verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>&lt;&lt;A no̱m-yu̱ u̱s-te ru war-u̱ ne̱t, wa ru wa no̱m u̱t-riig u̱t-be tu̱ za m-bu̱, remu̱ wa kum-u̱t be-du̱ u̱r-hure̱. Se̱di a wa kume̱ da, <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>se̱ wa zu̱, &lt;Me̱ u̱t-mu̱ u̱ be-du̱ u̱m rwu̱tu̱n&gt; A wa mu̱ne̱ wa bit waku̱n zarra, tu̱msu̱ na oposte̱ bu-u o̱, na mangte̱ o̱. <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>Wa u̱t-mu̱ wa kabu̱n no̱m u̱s-te ta'er i ze̱gu̱ wu̱n m-yo̱, tu̱msu̱ u̱ e̱ cwa u̱ me̱ ne̱tu̱ wa e̱ shu̱'u̱t. M-vaste̱ yu̱du̱ ne̱tu̱ wa u̱t-ze̱g u̱r-taku̱n m-yo̱. Iya o̱ he̱n do̱te̱ u̱t-shu̱'u̱t u̱ ne̱t-tu̱ u̱no̱ da-o̱.&gt;&gt;<verse eid="MAT 12:45"/></para>
  <para style="s1">Ino-u Ye̱so̱ u̱ hu̱no-u̱t wa ne̱ <optbreak/> haagu̱n e̱ hyen-u̱t wa</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mark 3:31-35</ref>; <ref loc="LUK 8:19-21">Ruka 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>Ye̱so̱ o̱ te̱k-u̱ no̱mu̱ mo̱ro̱g-du̱ u̱t-ne̱t u̱s-rem. Ino-u wa u̱ hu̱u̱b-tu̱ u̱r-matu̱ wa ne̱ e̱ o̱ ees u̱-do̱, e̱ u̱t-sa e̱ no̱m u̱s-rem u̱ wa ne̱. <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>Se̱ na zu̱ wu̱n, &lt;&lt;Ino-u ro u̱ hu̱u̱b-tu̱ u̱r-matu̱ ró ne̱ e̱ o̱ ees u̱-do̱, e̱ u̱t-sa e̱ no̱m u̱s-rem u̱ bo̱ ne̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">12:47 </char><char style="ft" closed="false">To̱ko̱n Ran-to̱ zatte̱ fe̱-yu̱ </char><char style="fv">47</char> Ho̱ngu̱sse̱ Ran-u: <char style="xt"><ref loc="MRK 3:32">Mark 3:32</ref></char>. U̱ Ran-u <char style="xt"><ref loc="LUK 8:20">Ruka 8:20</ref></char>.</note> <verse eid="MAT 12:47"/><verse number="48" style="v" sid="MAT 12:48"/>Ye̱so̱ shu̱s wa zu̱, &lt;&lt;¿Wana o̱ ino-u ri tu̱msu̱ wana o̱ hu̱u̱b-tu̱ u̱r-matu̱ ri?&gt;&gt; <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>Se̱ wa og a-doru̱ wa u-jou wa zu̱, &lt;&lt;Ino-u ri ya, hu̱no-u̱t ri ya u̱ ane̱. <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>Ne̱t be̱e̱t wu̱ no̱me̱ no̱mu̱ Uso-u ri wu̱ o̱ do̱m-u̱ u-ru̱ u̱t-sa, wa o̱ hu̱u̱b-u̱ u̱r-matu̱ ri u̱ ino-u ri ne̱.&gt;&gt;<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">Sha-mu̱ u̱s-rem su̱ wa-ku̱w</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>U̱ te̱k-u̱ ho̱-u̱r re̱, Ye̱so̱ ru du̱gu̱ u-bu, wa shu̱'u̱t u̱-kit m-sa. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>Ban-du̱ u̱t-ne̱t u-tát e̱ haan e̱ gu̱ns wu̱n, m-te da-u̱ wa cwa u̱-me̱ u-hat wa shu̱'u̱t, ne̱t-tu̱ mo̱ro̱g u̱-kit m-sa e̱ hog-u̱t wu̱n. <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>Ye̱so̱ waru̱ u̱n u̱t-no̱m u-tát u̱ te̱k-u̱ sha-mu̱ u̱s-rem, wa zu̱, &lt;&lt;Waku̱n wa-u̱r-to̱m wa haag u-tak remu̱ wa no̱m-u̱t ku̱w. <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>Wa o̱ te̱k-u̱ as-du̱ go', se̱ e̱ke̱n go̱'e̱ he u̱ do̱m u-fu̱n, no haan u̱ du̱gru̱sse̱ e̱. <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>E̱ke̱n tu̱msu̱ he u̱ be-du̱ u̱t-ta'ar, be-du̱ zatte̱ m-huug sok da. E̱ apu̱n za rem, remu̱ zu̱ huug-mo̱ u̱-do̱m u̱t-ta'ar u̱-ta. <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>Se̱di da-u̱ ho̱-yu̱ no̱me̱ m-du̱ng, se̱ e̱ baru̱sse̱ e̱ gu̱u̱s, remu̱ zu̱ e̱ zatte̱ u̱s-gu̱r sok da. <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>Tu̱msu̱ e̱ke̱n go̱'e̱ he u̱ be-du̱ u̱s-hir, hir-su̱ rogom se̱ hoos e̱ u̱t-rogom. <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>E̱ke̱n he u̱ be-u̱r so̱-de̱, e̱ nom so, e̱ke̱n u-ko̱k u-gan [100], e̱ke̱n u̱t-shik u̱t-tu̱t [60], tu̱msu̱ e̱ke̱n u̱r-shik u̱ o̱p [30]. <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>Yage̱ wa to̱-tu̱ u̱t-ho̱g, wa ho̱g.&gt;&gt;<verse eid="MAT 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>A-doru̱ Ye̱so̱ haan e̱ shit wu̱n u̱zu̱, &lt;&lt;¿Remu̱ u-yan o̱ bo̱ o̱tte̱ no̱mu̱ ne̱t-tu̱ tun-to̱ sha-mu̱ u̱s-rem?&gt;&gt;<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>Wa shu̱s wa zu̱, &lt;&lt;Ru̱-u̱ yaag no̱ nap-mu̱ no̱m-tu̱ m-yasa tu̱ Faru̱k-du̱ u-Ru̱, se̱di u̱n na yaag u̱n da. <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>Ne̱t wu̱ o̱tte̱ u-no̱m wa na de̱ u̱t-swu̱re̱ u-tát. Tu̱msu̱ wu̱ zatte̱ da, ko̱ no̱m-u̱ wa o̱tte̱ na de̱ u̱t-o̱nk du̱gu̱-du̱ wa. <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>De̱ wu̱te̱ u̱m o̱tte̱ no̱mu̱ u̱n sha-mu̱ u̱s-rem:</para>
  <para style="q1" vid="MAT 13:13">&lt;&lt;Remu̱ zu̱ ko̱ u̱n gwak-u̱t</para>
  <para style="q2" vid="MAT 13:13">u̱n za u̱t-hyan da,</para>
  <para style="q1" vid="MAT 13:13">ko̱ u̱n e̱re̱g u̱n za u̱t-nap da.<verse eid="MAT 13:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="MAT 13:14"/>No̱mu̱ wa-warru̱ rem-su̱ u-Ru̱ Ishaya ware̱ m-tumb ne̱ o̱ shu̱u̱g u̱ hi-u̱r u̱n, u̱zu̱:</para>
  <para style="q1" vid="MAT 13:14">&lt;No̱ de̱ ho̱g-du̱ no̱m-u̱ u̱m o̱ u̱t-war,</para>
  <para style="q2" vid="MAT 13:14">se̱di no̱ za u̱t-nap da;</para>
  <para style="q1" vid="MAT 13:14">No̱ de̱ u̱t-gwat,</para>
  <para style="q2" vid="MAT 13:14">se̱di no̱ za u̱t-hyan da.<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>Remu̱ zu̱ jab-su̱</para>
  <para style="q2" vid="MAT 13:15">ne̱t-u̱t tun-to̱ rindu̱sse̱,</para>
  <para style="q2" vid="MAT 13:15">to̱-u̱t u̱n za u̱t-ho̱g da,</para>
  <para style="q2" vid="MAT 13:15">tu̱msu̱ u̱n ryu̱bu̱kte̱ is-u̱ u̱n,</para>
  <para style="q2" vid="MAT 13:15">u̱n za u̱t-hyan da.</para>
  <para style="q1" vid="MAT 13:15">U̱zu̱ iya da, u̱n za hyanu̱g</para>
  <para style="q2" vid="MAT 13:15">u̱ is-u̱ u̱n no̱m-u̱ u̱m o̱ u̱t-no̱m,</para>
  <para style="q1" vid="MAT 13:15">u̱n za ho̱k no̱m-u̱ u̱m o̱ waru̱ u̱n,</para>
  <para style="q2" vid="MAT 13:15">tu̱msu̱ u̱n za nak</para>
  <para style="q1" vid="MAT 13:15">no̱m-u̱ u̱m o̱ waru̱ u̱n,</para>
  <para style="q2" vid="MAT 13:15">U̱n za yakke̱ yu̱du̱ u̱t-ba'as</para>
  <para style="q1" vid="MAT 13:15">u̱n byu̱ru̱n u̱du̱ ri,</para>
  <para style="q2" vid="MAT 13:15">tu̱msu̱ u̱m za no̱ngu̱ u̱n u-u̱ku̱r.&gt;<note caller="+" style="f"><char style="fr" closed="false">13:15 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 6:9-10">Isha 6:9-10</ref></char>. (Ran-u̱ u̱t-Girik.)</note><verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>&lt;&lt;No̱ kwu̱ng kom u-Ru̱ remu̱ zu̱ no̱ hyanu̱g no̱m-tu̱ m-shin tu̱ u̱m o̱ u̱t-no̱m, tu̱msu̱ no̱ nak no̱m-tu̱ u̱m o̱ waru̱ no̱. <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>U̱m o̱ waru̱ no̱ u̱t-nip, a-warru̱ rem-su̱ u-Ru̱ ne̱ u-tát, u̱ ne̱t-tu̱ jab-u̱s so̱-se̱ ne̱, e̱ cwanu̱g e̱ hyan no̱m-u̱ no̱ hyane̱ tu̱msu̱ no̱ hog, e̱ kerge̱ da.<verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>&lt;&lt;Ho̱go̱n nap-mu̱ sha-mu̱ u̱s-rem su̱ wa-ku̱w: <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>Go̱ i he̱ u̱-do̱m u-fu̱n e̱ o̱ u̱ka ne̱t wu̱ ho̱ge̱ rem-su̱ Faru̱k-du̱ u-Ru̱, wa gwa'ag u̱r-nu da, faru̱k-u̱ no̱m u̱s-te haan u̱ kos no̱m-u̱ na kawe̱ u̱-me̱ jab-u̱ wa. <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>Ne̱t-u̱ ho̱ge̱ u̱s-rem za rem wa ku̱b se̱ u̱r-so̱ ne̱, wa o̱ u̱ka go̱ i he̱'e̱ u̱-me̱ be-du̱ u̱t-ta'ar. <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>Ba shu̱'u̱te̱ u̱zu̱ wa zatte̱ u̱s-gu̱r da wa tumbte̱ sok da. Da da-u̱ swadu̱ u̱r-ko̱b haane̱ wa yage̱ do̱rru̱ u-Ru̱. <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>Tu̱msu̱ go̱ i he̱ be-du̱ u̱s-hir, e̱ o̱ u̱ka ne̱t wu̱ ho̱ge̱ rem-su̱ u-Ru̱ wa ku̱b, se̱di da-u̱ no̱m-tu̱ namu̱ jab haane̱ u̱ e̱nk-tu̱ kwu̱m-tu̱ dak-u uno̱, se̱ soos wu̱n, se̱ hoos ya mat-du̱ u̱t-ya. <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>Se̱di go̱ i he̱'e̱ u̱ be-u̱r so̱-de̱ e̱ o̱ u̱ka ne̱t wu̱ ho̱ge̱ rem-su̱ u-Ru̱, wa nu̱p se̱. Wa mu̱t u̱t-ya u̱t-ko̱k u-gan ko̱ u̱t-shik u̱t-tu̱t ko̱ u̱r-shik u̱ o̱p u̱ no̱m-u̱ wa kawe̱.&gt;&gt;<verse eid="MAT 13:23"/></para>
  <para style="s1">Sha-mu̱ u̱s-rem <optbreak/> su̱ go̱ za so̱-ye̱</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>Ye̱so̱ no̱mu̱ u̱n sha-mu̱ u̱s-rem tu̱msu̱ wa zu̱, &lt;&lt;Faru̱k-du̱ u-Ru̱ o̱ u̱ka wa-u̱r-to̱m wu̱ kawe̱ go̱ so̱-ye̱ u̱-me̱ tak-u wa, se̱ wa aru̱k. <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>U̱ te̱k m-gyu̱p da kowan o̱ m-roog, hu̱u̱b-u̱ yo̱-o̱ rò haan wa-ku̱w go̱ za so̱-ye̱ u̱-me̱ tak-u rò, se̱ wa aru̱k. <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>Da da-u̱ go̱ so̱-ye̱ o̱ u̱t-rogom e̱ no̱m yaag, iya o̱ hen go̱ za so̱-ye̱ rogom ko̱ e̱.<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>&lt;&lt;To̱k-ne̱ bu-u wa-u-tak haan wa waru̱ wu̱n u̱zu̱, &lt;Wa-u-bu, be-du̱ bo̱ nomte̱ ku̱w arkama, u̱m byu̱k-u̱t bambara u̱-me̱. ¿He̱ne̱ bambara rwu̱tu̱n?&gt;<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>&lt;&lt;Wa zu̱, &lt;Hu̱u̱b-u̱ yo̱-o̱ no̱me̱ se̱.&gt;</para>
  <para style="p" vid="MAT 13:28">&lt;&lt;To̱k-ne̱ shit wu̱n u̱zu̱, &lt;¿Bo̱ u̱t-sa it do̱'e̱ it hast bambara?&gt;<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>&lt;&lt;Se̱ wa zu̱ u̱n, &lt;A no̱ hast bambara da, taas u̱du̱ u̱t-has no̱ same̱ u̱ arkama ne̱. <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>Yagu̱n e̱ rogom u̱r-kot m-te da-u̱ ket. U̱ da-u o̱ u̱m de̱ waru̱ a-ket ne̱, e̱ hast uro bambara u̱n gag u̱t-gu̱g u̱t-gu̱g e̱ gun u-ra. Se̱di na gun arkama u̱-me̱ u̱r-bya.&gt; &gt;&gt;<verse eid="MAT 13:30"/></para>
  <para style="s1">Sha-mu̱ u̱s-rem su̱ <optbreak/> ya-yu̱ mastad</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>Tu̱msu̱ Ye̱so̱ no̱mu̱ u̱n sha-mu̱ u̱s-rem u̱zu̱, &lt;&lt;Faru̱k-du̱ u-ru̱ o̱ u̱ka ya-yu̱ mastad yu̱ na kawe̱ u-tak. <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>Ya zege̱ u̱s-re̱k u̱ te̱k-u̱ go̱ no̱m, se̱di ya ne̱ne̱ ya nom te-u yat-ya u-me̱ u-tak, no cu̱st u̱-do̱m e̱ no̱m u̱t-tu̱ku̱s u̱ do̱m u̱s-fe̱.&gt;&gt;<verse eid="MAT 13:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>Ye̱so̱ sur m-ya u̱n sha-mu̱ u̱s-rem u̱zu̱, &lt;&lt;Faru̱k-du̱ u-Ru̱ de̱ o̱ u̱ka m-yis mu̱ ne̱ta wake̱ u̱-me̱ hyu̱-m yat-mo̱ kanda hyu̱m-mo̱ hok-u̱t m-yis.&gt;&gt;<verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>Ye̱so̱ waru̱g sha-mu̱ rem-u̱s se̱ u̱s-be̱e̱t u̱-me̱ mo̱ro̱g-du̱ u̱t-ne̱t. Wa waru̱g o̱ko̱n u̱-me̱ u̱n za wa no̱mu̱ u̱n sha-mu̱ u̱s-rem da. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>Sin-se̱ u̱s-be̱e̱t u̱ remu̱ na shu̱u̱ste̱ no̱mu̱ wa-warru̱ rem-su̱ u-Ru̱ Ishaya ware̱ u̱zu̱,</para>
  <para style="q1" vid="MAT 13:35">Sha-mu̱ u̱s-rem mo̱</para>
  <para style="q2" vid="MAT 13:35">u̱m do̱te̱ u̱s-rem.</para>
  <para style="q1" vid="MAT 13:35">Me̱ u̱t-wa u̱ ne̱t-tu̱ nap</para>
  <para style="q2" vid="MAT 13:35">no̱m-tu̱ o̱ m-yasa,</para>
  <para style="q1" vid="MAT 13:35">tu̱ du̱gu̱ da-u̱ u̱r-taku̱n du̱ dak-u uno̱.<verse eid="MAT 13:35"/></para>
  <para style="s1">Hi-du̱ sha-mu̱ u̱s-rem su̱ <optbreak/> go̱ za so̱-ye̱</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>Ye̱so̱ yage̱ mo̱ro̱g-du̱ u̱t-ne̱t wa to u̱-me̱ u-bu. A-doru̱ wa haan e̱ zu̱ wu̱n, &lt;&lt;Waru̱ it hi-du̱ sha-mu̱ u̱s-rem su̱ go̱ za so̱-ye̱ u-tak.&gt;&gt;<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>Se̱ wa shu̱s wa zu̱, &lt;&lt;Wu̱ kawe̱ go̱ so̱-ye̱ wa o̱ Wa'-u̱ Ne̱t. <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>U-tak hen dak-u uno̱ o̱, go̱ so̱-ye̱ hen e̱ o̱ u̱t-ne̱t i o̱ no̱mu̱ u-Ru̱ u̱t-huuk. Go̱ za so̱-ye̱ e̱ o̱ ya'ag-u̱ faru̱k-u̱ no̱m u̱s-te. <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>Tu̱msu̱ hu̱u̱b-u̱ yo̱-o̱ kawe̱ go̱ za so̱-ye̱ wa o̱ faru̱k-u̱ no̱m u̱s-te. Ket hen, o̱ madu̱ uno̱ da-o̱, a-ke̱t-ne̱ a-to̱m u-Ru̱.<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>&lt;&lt;U̱ka ne̱t-tu̱ kargu̱sse̱ go̱ za so̱-ye̱ na doos e̱ u-ra, iya o̱ Ru̱-u̱ do̱te̱ u̱t-shu̱'u̱t ma-du̱ dak-u uno̱. <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>Wa'-u̱ Ne̱t de̱ to̱mnu̱ a-to̱m u-Ru̱, e̱ de̱ kargu̱ssu̱ a wadu̱ ne̱t-ne̱ no̱m-du̱ u̱t-ba'as, tu̱msu̱ u̱ a no̱m-du̱ no̱m-u̱t yo̱-to̱ ne̱, e̱ ruut e̱ u̱-me̱ faru̱k-u̱r wa. <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>A-to̱m u-Ru̱ de̱ gwu̱n-du̱ e̱ u̱-me̱ u-ra u̱ m-du̱ng sok. U̱ be-u̱r re̱ ku̱na e̱ do̱te̱ u̱s-kan u̱ ep-mu̱ nin ne̱. <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>U̱ da-u o̱ he̱n a-jab-u̱s so̱-se̱ de̱ no̱m-du̱ m-zu̱n u̱ka u̱r-ho̱ u̱-me̱ faru̱k-du̱ U̱so-u u̱n. Wu̱ o̱tte̱ to̱-tu̱ m-ho̱g yage̱ wa ho̱g.<verse eid="MAT 13:43"/></para>
  <para style="s1">Sha-mu̱ u̱s-rem su̱ cu̱n-du̱ m-yasa <optbreak/> u̱ ta'ar-du̱ m-bak-u̱t ne̱</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>&lt;&lt;Faru̱k-du̱ u-Ru̱ de̱ o̱ u̱ka u̱t-kwu̱m tu̱ o̱ m-yasa. Da-u̱ ne̱t-u̱ kume̱ o̱, wa mang u̱t-yase̱. U̱ remu̱ u̱r-so̱ wa de̱ bab no̱m-tu̱ wa o̱tte̱ wa o̱ tak-u o̱.<verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>&lt;&lt;Tu̱msu̱ Faru̱k-du̱ u-Ru̱ de̱ o̱ u̱ka wa-u-tu̱rru̱ wu̱ o̱ sa-u̱ taar-tu̱ shik sok. <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>Da-u̱ wa kume̱ ta'ar-u̱r re̱ du̱ shik, wa de̱ m-ha wa bab no̱m-tu̱ wa o̱tte̱ u̱t-be̱e̱t remu̱ wa oot ta'ar-u̱r re̱.<verse eid="MAT 13:46"/></para>
  <para style="s1">Sha-mu̱ u̱s-rem su̱ <optbreak/> no̱m-tu̱ masu̱ jan</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>&lt;&lt;Tu̱msu̱ Faru̱k-du̱ u-Ru̱ o̱ u̱ka re̱n-tu̱ masu̱ jan, tu̱ na gune̱ u̱-me̱ m-sa to̱ maas jan ko̱-uyan go̱de̱. <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>Da-u̱ re̱n-tu̱ shiye̱, a masu̱ jan ne̱ naku̱n u̱ rwu̱u̱n, e̱ shu̱'u̱t e̱ du̱gu̱r jan-u̱ so̱-ye̱ e̱ wo u̱ me̱ u̱r-ko̱o̱r, na azu̱g jan i za so̱-ye̱. <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>Iya o̱ do̱te̱ u̱t-shu̱'u̱t u̱ ho̱-du̱ u̱r-vaste̱. Wa-to̱m u-Ru̱ de̱ u̱t-haan wa mo̱t a-jab-u̱s yo̱-se̱ ne̱ u̱ a-jab-u̱s so̱-se̱ ne̱, <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>wa gun e̱ u̱-me̱ u-ra u̱ m-du̱ng sok, be-du̱ e̱ do̱te̱ u̱s-kan u̱ ep-mu̱ nin ne̱.&gt;&gt;<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>Ye̱so̱ shit u̱n u̱zu̱, &lt;&lt;¿No̱ gwa'ag u̱r-nu a?&gt;&gt;</para>
  <para style="p" vid="MAT 13:51">U̱n shu̱s u̱n zu̱, &lt;&lt;U̱.&gt;&gt;<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>Se̱ Ye̱so̱ zu̱ u̱n, &lt;&lt;Ko̱-uyan wa-u̱t-ko̱se̱ tu̱ u-bo̱r wu̱ na iise̱ mo̱ttu̱ Faru̱k-du̱ u-Ru̱, wa o̱ u̱ka wa-u-bu wu̱ gasne̱ kwu̱m-u̱t po-to̱ u̱t-ut ne̱ du̱gu̱ be-du̱ u̱r-cu̱nu̱ wa.&gt;&gt;<verse eid="MAT 13:52"/></para>
  <para style="s1">Wa-warru̱ rem-su̱ u-Ru̱ <optbreak/> za m-ze̱g</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mark 6:1-6</ref>; <ref loc="LUK 4:16-30">Ruka 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>Da-u̱ Ye̱so̱ tase̱ no̱mu̱ u̱n sha-mu̱ u̱s-rem, wa yage̱ be-u̱r re̱. <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>Ye̱so̱ haagu̱n u̱-me̱ bo̱-u wa, wa hu̱ no̱mu̱ ne̱t-ne̱ u̱t-ko̱se̱ u̱-me̱ bu-u̱ u̱t-ko̱se̱ u̱ Yahuda-ne̱. U̱n hu̱ mu̱rimmo̱ u̱zu̱, &lt;&lt;¿He̱ne̱ ne̱t uno̱ kumte̱ mummo̱ nap-mo̱ inya, u̱ shin-mu̱ no̱m-du̱ no̱m-tu̱ m-shin tun-to̱ ne̱ u̱t-be̱e̱t? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>¿Unwa a wa'-u̱ kahinta-u yaya da? ¿A ino-u rò na zu̱ Me̱ri da? ¿A o̱r-u̱t rò ne̱ o̱ye̱ Yakubu, u̱ Yusuhu u̱ Simo̱n u̱ Yahudas ne̱ da? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>¿Za o̱r-u̱t rò ne̱ ya-u̱t-gwu̱p i o̱ u̱r-kot u̱ in ne̱ da? ¿He̱ne̱ wa kwu̱mtu̱n shin-mu̱ no̱m-du̱ no̱m-tu̱ m-shin tun-to̱?&gt;&gt; <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>Remu̱ iya e̱ gu̱gu̱m wu̱n.</para>
  <para style="p" vid="MAT 13:57">Ye̱so̱ zu̱ u̱n, &lt;&lt;Ne̱t-tu̱ ye' wa-warru̱ rem-su̱ u-Ru̱ m-sek, se̱di ne̱t-tu̱ bo̱-u rò u̱ ne̱t-tu̱ bu-u rò ne̱, e̱ nomte̱ da.&gt;&gt;<verse eid="MAT 13:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="MAT 13:58"/>Tu̱msu̱ wa no̱ng no̱m-tu̱ m-shin u-tát u̱ku̱n sok da remu̱ ko̱b-du̱ yadu̱ jab-u̱ u̱n.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">Maru̱-m Yohanna <optbreak/> wa-u̱t-yu̱bu̱sse̱ m-bu̱</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>U̱ da-u o̱, Here̱ Antipas Faru̱k ho̱ge̱ u̱zu̱ Ye̱so̱ o̱ no̱m-du̱ no̱m-tu̱ m-shin. <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>Se̱ wa zu̱ to̱k-ne̱ bu-u wa, &lt;&lt;Unwa o̱ Yohanna wa-u̱t-yu̱bu̱sse̱ m-bu̱ wa yu̱ne̱ du̱gu̱ marimari-ne̱ de̱ wu̱te̱ wa kerte̱ no̱m-du̱ no̱m-tu̱ m-shin tun-to̱.&gt;&gt;<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3-4" style="v" sid="MAT 14:3-4"/>No̱m-u̱ wu̱te̱ Here̱ no̱m-u̱t dorog-u̱s se̱: Here̱ gaag Herodiya ne̱ta hu̱u̱b u̱r-matu̱ wa Firibi, u̱ Firibus ne̱ u̱r-fat. De̱ wu̱te̱ Yohanna o̱gu̱ waru̱ wu̱n u̱zu̱, &lt;&lt;No̱m-u̱ bo̱ no̱me̱ bo̱ gu̱ ne̱ta hu̱no-u ró u̱ wane̱ u̱r-fat, bo̱ paku̱s bo̱r-tu̱ u-Ru̱.&gt;&gt; Remu̱ Here̱ mangte̱ jab-u̱ Herodiya, wa waru̱ karma-ne̱ e̱ maas Yohanna, e̱ gag wa u̱ ho-su̱ kwam, e̱ gun wa u̱-me̱ bu-u m-to̱k. <verse eid="MAT 14:3-4"/><verse number="5" style="v" sid="MAT 14:5"/>Here̱ cwang wa ho̱ Yohanna, se̱di wa o̱ u-gye̱r u̱t-ne̱t remu̱ zu̱ e̱ kabu̱g wu̱n wa-warru̱ rem-su̱ u-Ru̱.<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>U̱ ho̱-du̱ bak-su̱ ho̱-du̱ u̱r-matu̱ Here̱, wa'-u̱ Herodiya no̱ngu̱ u̱n u̱s-he̱w sok har Here̱ ho̱k u̱r-zwar. <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>Here̱ no̱m este̱du̱ u̱s-rem u̱s-to̱nd ne̱ u̱zu̱ wa ya' wu̱n ko-uyan u̱ wa u̱t-sa. <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>Ino-u rò yu̱ wu̱n u̱s-rem u̱ no̱m-u̱ u do̱'e̱ u̱t-ko̱n u̱zu̱, &lt;&lt;U̱m u̱t-sa hi-u̱r Yohanna wa yu̱bu̱sse̱ m-bu̱ u̱-me̱ u-ko̱k.&gt;&gt; <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>Faru̱k ho̱k u̱r-zwar da, se̱di ba shu̱'u̱te̱ u̱zu̱ wa no̱ng este̱du̱ u̱s-rem u̱s-to̱nd ne̱, tu̱msu̱ remu̱ ham-u̱t tu̱ o̱ u̱ku̱n ne̱, se̱ wa zu̱ karma-ne̱ e̱ yasu̱ no̱mu̱ wa ko̱ne̱. <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>Wa tom m-ha bu-u̱ m-to̱k u̱zu̱ na kwu̱pu̱n hi-u̱r Yohanna. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>Na hatu̱n hi-u̱r Yohanna u̱-me̱ u-ko̱k na yasu̱ wa'-u̱-gwu̱p, wa ku̱b m-ha u̱du̱ ino-u wa. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>A-doru̱ Yohanna haan e̱ ku̱b birig-du̱ u-war e̱ dok. E̱ do̱'e̱ e̱ waru̱ Ye̱so̱.<verse eid="MAT 14:12"/></para>
  <para style="s1">Ye̱so̱ re̱gu̱sse̱ ne̱t-ne̱ <optbreak/> u̱t-zo̱ngu u̱t-tan [5,000]</para>
  <para style="r">(<ref loc="MRK 6:30-40">Mark 6:30-40</ref>; <ref loc="LUK 9:10-17">Ruka 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoha 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>Da-u̱ Ye̱so̱ ho̱ge̱ u̱zu̱ Here̱ wa'ag karma e̱ ho̱o̱g Yohanna, se̱ wa to u-hat m-ha u̱ de̱ku̱n be-de̱ du̱ za u̱t-ne̱t remu̱ wa shu̱'u̱t wa u-gan u̱ku̱n. Da-u̱ ne̱t-tu̱ ho̱ge̱ iya, e̱ rwu̱n du̱gu̱ u̱t-bo̱, e̱ dor wu̱n u̱s-na. <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>Da-u̱ Ye̱so̱ ruye̱ u̱-me̱ u-hat, se̱ wa hyen u̱t-ne̱t to̱ mo̱ro̱gte̱ u-tát. Wa hog u̱r-o̱n wa hast a-ko̱b-du̱ m-yar ne̱ u̱s-go̱m i o̱ u̱ku̱n.<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>Da-u̱ rim-mu̱ tore̱, a-doru̱ Ye̱so̱ e̱ zu̱ wu̱n, &lt;&lt;In o̱ u̱-me̱ be-du̱ zatte̱ u̱t-ne̱t da, yage̱ u̱t-ne̱t e̱ cwa u̱-me̱ u̱t-taas e̱ kum-u̱t no̱m u̱t-re̱ e̱ o̱.&gt;&gt;<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;Kamu̱g u̱zu̱ se̱ u̱n haag u̱ aku̱n da. No̱ ya' u̱n no̱m u̱t-re̱ u̱n re̱.&gt;&gt;<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>Se̱ e̱ zu̱ wu̱n, &lt;&lt;It zatte̱ o̱ko̱n u̱ ane̱ da, be̱re̱di-to̱ u̱t-tan u̱ jan ne̱ u̱t-yu̱r.&gt;&gt;<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;Hatu̱n to̱ u̱ ane̱.&gt;&gt; <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>Se̱ wa zu̱ u̱n zu̱u̱n ne̱t-tu̱ shu̱'u̱t u̱ do̱m u̱s-gwa. Wa ku̱b be̱re̱di-u̱t to̱ u̱t-tan u̱ jan yu̱r, wa jaku̱s u̱r-hi u̱ do̱m u-ru̱, wa no̱mu̱ u-Ru̱ u̱t-vam. Wa mo̱t be̱re̱di-u̱t to̱ wa yasu̱ a-doru̱, tu̱msu̱ a-dor wa mo̱tu̱ ban-du̱ u̱t-ne̱t. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>Kowan re, wa shig, a-doru̱ wa kargu̱sse̱ no̱m u̱t-re̱ kuse̱ ko̱o̱r-u̱t yatto̱ o̱p-u̱t yu̱r. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>Tat-u̱ ne̱t-tu̱ re̱ no̱m u̱t-re̱ o̱, ne̱t-to̱ campa-ne̱ u̱t-zo̱ngu u̱t-tan [5,000], a-dor ogorte̱ ne̱ta-ne̱ u̱ ya'ag ne̱ i re̱ no̱m u̱t-re̱ o̱ da.<verse eid="MAT 14:21"/></para>
  <para style="s1">Ye̱so̱ no̱ng m-ha u̱ do̱m m-bu̱</para>
  <para style="r">(<ref loc="MRK 6:45-56">Mark 6:45-56</ref>; <ref loc="JHN 6:15-21">Yoha 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>Da-u̱ u̱n tase̱ Ye̱so̱ zu̱ a-dor e̱ cwa u̱-me̱ u-hat, e̱ do̱'e̱ u̱ din-de̱ jit gwu̱g-de̱. Wa hen wa ees kanda ne̱t-tu̱ aru̱k. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>Da-u̱ wa yu̱nse̱ u̱t-ne̱t, wa du̱ do̱m u̱r-ro̱r remu̱ wa no̱m-u̱t u̱s-to̱o̱g. Rim-mu̱ tor wu̱n u̱ku̱n wu̱n u-gan.<verse eid="MAT 14:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 14:24"/>U̱ da-u o̱ hen hat-yu̱ o̱ te̱k m-sa, ya ragu̱n u-dak ne̱, tu̱msu̱ jwak m-bu̱ o̱ gab-du̱ m-mya tu̱msu̱ mya-mu̱ no̱ng u-tát.<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>U̱ka u̱s-kwam u̱s-tu̱t su̱ u̱r-wu̱n, Ye̱so̱ yu̱ne̱ wa o̱ jang m-bu̱ u̱-me̱ m-sa m-ha u̱du̱ a-doru̱ wa. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>Da-u̱ a-dor hyanu̱ wu̱n m-ha u̱-me̱ m-sa, e̱ hog u-gye̱r, e̱ zu̱, &lt;&lt;No̱m-tu̱ m-bu̱ to̱!&gt;&gt; E̱ no̱m u̱t-jar u̱ remu̱ u-gye̱r.<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>Za rem Ye̱so̱ zu̱ u̱n, &lt;&lt;No̱mo̱n be̱b-du̱ jab, tu̱msu̱ a no̱ ho̱g u-gye̱r da, me̱ wa Ye̱so̱.&gt;&gt;<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>Biturus zu̱, &lt;&lt;Wa-m-nap, abite̱ bo̱ wa, zu̱ me̱ u̱m jangu̱n u̱ haan u̱du̱ ró u̱ do̱m m-bu̱.&gt;&gt;<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>Ye̱so̱ zu̱, &lt;&lt;Jangu̱n.&gt;&gt;</para>
  <para style="p" vid="MAT 14:29">Biturus ru̱ du̱gu̱ me̱ u-hat, wa hu̱ m-ha u̱ do̱m m-bu̱ m-ha u̱du̱ Ye̱so̱. <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>Da-u̱ wa hyane̱ m-mya, wa hog u-gye̱r wa he̱e̱se̱ u̱t-iis, se̱ wa no̱m u̱t-jar, &lt;&lt;Wa-m-nap! Gu me̱!&gt;&gt;<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>Za rem Ye̱so̱ nu̱b u-kom wa ship wu̱n. Wa zu̱, &lt;&lt;Bo̱ wa yadu̱ jab cashi, ¿remu̱ yan-o̱ bo̱ no̱m-te̱ u-sakna?&gt;&gt;<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>Da-u̱ Ye̱so̱ e̱ Biturus cwa u̱-me̱ u-hat, mya-mu̱ ho u̱s-ram te̱k. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>Ne̱t-tu̱ o̱ u̱-me̱ u-hat e̱ no̱mu̱ Ye̱so̱ u̱t-huuk, e̱ zu̱, &lt;&lt;Nip-to̱ bo̱ Wa'-u̱ u-Ru̱ wa!&gt;&gt;<verse eid="MAT 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>Da-u̱ e̱ pase̱ m-sa, e̱ ciz u̱ dak-u̱ Janisarata. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>Da-u̱ ne̱t-tu̱ bo̱-u o̱ nape̱ u̱zu̱ Ye̱so̱ wa, e̱ tom na waru̱ kowan wu̱ o̱tte̱ wa-ko̱b-du̱ m-yar u̱-me̱ dak-u o̱ e̱ haan u̱ Ye̱so̱ ya u̱n m-yar. <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>E̱ kon Ye̱so̱ u̱zu̱, wa yage̱ a-ko̱b-du̱ m-yar ne̱ e̱ tam ko̱ nu-du̱ to̱ggo̱-u rò. Tu̱msu̱ ne̱t-ne̱ be̱e̱t i tame̱ wu̱n e̱ kwu̱ng m-yar.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">U-he̱n u̱ ko̱b-du̱ u-he̱n ne̱</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mark 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>Farisa-ne̱ u̱ a-ko̱se̱-tu̱ u-bo̱r ne̱ haan u̱du̱ Ye̱so̱ du̱gu̱ Urusharima. E̱ zu̱, <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>&lt;&lt;¿Remu̱ u-yan o̱ a-doru̱ ró o̱tte̱ pas-du̱ u̱r-ma'in du̱ ne̱nge̱n-u̱t in? Remu̱ zu̱ e̱ saapte̱ u̱t-kom kanda e̱ re̱ no̱m-u̱ u̱t-re̱ da!&gt;&gt;<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>Ye̱so̱ shu̱s wa zu̱, &lt;&lt;¿No̱ remu̱ yan-o̱ no̱ o̱tte̱ pas-du̱ bo̱r-tu̱ u-Ru̱ remu̱ no̱m-tu̱ ne̱nge̱n-u̱t no̱ is-u̱ no̱? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>Ru̱-u̱ zu̱u̱g, &lt;Ya' u̱so-u ró u̱ ino-u ró ne̱ m-ze̱g,&gt;<note caller="+" style="f"><char style="fr" closed="false">15:4a </char><char style="ft" closed="false">Rwu̱u̱ 20:12; Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 5:16">Muut 5:16</ref></char>.</note> tu̱msu̱ &lt;Ne̱t wu̱ pyape̱ u̱so-u wa ko̱ ino-u wa na do̱'e̱ ho̱-du̱ wa.&gt;<note caller="+" style="f"><char style="fr" closed="false">15:4b </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="EXO 21:17">Rwu̱u̱ 21:17</ref>; <ref loc="LEV 20:9">To̱o̱g 20:9</ref></char>. (Ran-u̱ Girik.)</note> <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>No̱ no̱mu̱ ne̱t-ne̱ u̱t-ko̱se̱ u̱zu̱, bo̱ keru̱ zu̱ u̱so-u ró ko̱ ino-u ró: &lt;No̱m-u̱ u̱m o̱tte̱ u-be̱e̱t u̱ kame̱ u̱m nya' no̱, u̱m no̱mu̱g este̱du̱ u̱s-rem u̱zu̱ u̱m de̱ yasu̱ o̱ u̱du̱ u-Ru̱.&gt; <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>Tu̱msu̱ a no̱ no̱me̱ iya, no̱ dorog u̱zu̱ o̱ko̱n zaar u̱ no̱ de̱ yadu̱ i mate̱ no̱ da. Iya o̱ hen, no̱ o̱ no̱mu̱ ne̱t-ne̱ ko̱se̱-tu̱ u̱r-ma no̱, no̱ yage̱ bo̱r-tu̱ u-Ru̱. <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>No̱ a-ha-mu̱ u̱r-no̱ ne̱, no̱mu̱ Ishaya ware̱ u̱ no̱ nip-to̱, u̱ wa nomte̱ u̱r-do̱nse̱ remu̱ no̱ u̱zu̱,<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>&lt;&lt; &lt;Ne̱t-u̱t tun-to̱</para>
  <para style="q2" vid="MAT 15:8">no̱mu̱ me̱ m-sek u̱ go̱p-tu̱ u-nu.</para>
  <para style="q2" vid="MAT 15:8">Se̱di jab-u̱s u̱n za u̱r-kot u̱-me̱ da.<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>E̱ no̱mu̱ me̱ huuk-tu̱ m-zan;</para>
  <para style="q2" vid="MAT 15:9">Ko̱se̱-u̱t u̱n ko̱se̱-tu̱ u̱t-ne̱t to̱.&gt;<note caller="+" style="f"><char style="fr" closed="false">15:9 </char><char style="ft" closed="false">Gwat tu̱msu̱: Isha </char><char style="xt"><ref loc="ISA 29:13">Isha 29:13</ref></char>. (Ran-u̱ u̱t-Girik.)</note> &gt;&gt;<verse eid="MAT 15:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>Ye̱so̱ fog u̱t-ne̱t wa zu̱ u̱n, &lt;&lt;Ho̱go̱n no̱ nap. <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>Za no̱m-u̱ o̱ m-cwa u̱ nu-u̱ ne̱t o̱ mutu̱ wa, wa-za-u-he̱n u̱du̱ u-Ru̱ da, se̱di no̱m-u̱ o̱ rwu̱u̱n u̱ nu-u wa.&gt;&gt;<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>A-dor haan u̱du̱ rò, e̱ zu̱ wu̱n, &lt;&lt;Farisa-ne̱ ho̱k zwarru̱ rem-u̱s se̱ da, da-u̱ e̱ ho̱gu̱ se̱.&gt;&gt;<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>Ye̱so̱ zu̱, &lt;&lt;Ku̱w be̱e̱t u̱ U̱so-u ri wu̱ o̱ do̱m u-ru̱ kawe̱ da, na de̱ musu̱ o̱ u̱s-gu̱r ne̱. <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>Yagu̱n ne̱t-tu̱ Farisa, e̱ u̱ka po̱-ne̱ e̱, a-nak-du̱ o̱r-u̱t e̱ po̱-ne̱. A po̱ o̱ nak-du̱ o̱r-u̱ wa po̱, e̱ be̱e̱t e̱ de̱ he̱du̱ u-kub.&gt;&gt;<verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>Biturus zu̱ wu̱n, &lt;&lt;Gwa-su̱ it nu-du̱ sha-mu̱ u̱s-rem sin-se̱.&gt;&gt;<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>Ye̱so̱ zu̱, &lt;&lt;¿No̱ gwa'ag u̱r-nu uro da? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>No̱ hyang, no̱m-u̱ ne̱tu̱ re̱ u-be̱e̱t u̱r-taku̱n o̱ de̱ u̱t-cwa u̱ nu-u wa, o̱ fang u̱t-me̱n, m-vaste̱ o̱ de̱ rwu̱u̱n m-ha u̱ zan. <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>No̱m-u̱ o̱ rwu̱n du̱gu̱ u-nu, du̱gu̱ jab o̱, o̱ rwu̱ne̱. O̱ hen u̱ de̱ mutu̱ ne̱t wa-za-u-he̱n u̱du̱ u-Ru̱ u̱ ne̱t-ne̱. <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>U̱m zu̱u̱g iya remu̱ zu̱ du̱gu̱ jab o̱ dorog-su̱ no̱m-u̱t yo̱-to̱ rwu̱tu̱n, wato, ho̱-du̱ ne̱t, m-o̱, m-o̱ ne̱, u-hiw, ke̱t-du̱ u̱s-bi, u̱ na-su̱ dim-u̱r e̱ke̱n ne̱. <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>Tunto̱ to̱ no̱m-to̱ wu̱te̱ ne̱t u̱ shu̱'u̱t wa-ko̱b-du̱ u-he̱n u̱du̱ u-Ru̱, se̱di re̱-du̱ no̱m u̱t-re̱ za saap u̱t-kom wa'ag ne̱t u̱ shu̱'u̱t wa-za-u-he̱n u̱du̱ u-Ru̱ da.&gt;&gt;<verse eid="MAT 15:20"/></para>
  <para style="s1">Ya-du̱ jab-u̱ u-ne̱ta yu̱ Kanan</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>Da-u̱ Ye̱so̱ yage̱ ku̱n, se̱ wa do̱'e̱ u-dak, u̱ be-du̱ bo̱-tu̱ Taya u̱ Sido̱n ne̱ o̱tte̱. <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>Yaku̱n ne̱ta ya wa-za Yahuda, wu̱ o̱ u̱ dak-u̱ o̱, wa jaku̱s u-cwar wa zu̱, &lt;&lt;Wa-m-nap! Wa'-u̱ Dawuda, ho̱g o̱n-u̱r ri! Yaku̱n no̱m-yu̱ u̱s-te ya o̱ yadu̱ wa'-u̱ ri wa-gwu̱p u̱r-ko̱b.&gt;&gt;<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>Ye̱so̱ shaku̱s o̱ko̱n no̱m-o̱ da. Se̱ a-doru̱ wa haan e̱ kon wu̱n e̱ u̱zu̱, &lt;&lt;Buz ne̱ta-u inya remu̱ zu̱ wa o̱ do̱rru̱ in wa o̱ e̱kse̱ in!&gt;&gt;<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>Se̱ Ye̱so̱ shu̱s wa zu̱, &lt;&lt;Ru̱-u̱ to̱mgu̱n me̱ u̱du̱ ca Isra-ne̱ i e̱nke̱ u̱ war-e̱.&gt;&gt;<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>Ne̱ta-u ya haan wa he u̱t-jwu̱n wa no̱mu̱ Ye̱so̱ u̱t-huuk, wa zu̱. &lt;&lt;Wa-m-nap, se̱gu̱ me̱!&gt;&gt;<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>Ye̱so̱ zu̱, &lt;&lt;No̱ng u̱r-zwar na kab no̱m u̱t-re̱ yaag na yasu̱ o̱' da.&gt;&gt;<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>Ne̱ta-u ya zu̱, &lt;&lt;Wa-m-nap, o̱' re ko̱ te̱k-u̱ no̱m u̱t-re̱ u̱ wa u-bu u̱ he̱ u-dak.&gt;&gt;<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>Se̱ Ye̱so̱ zu̱, &lt;&lt;Ne̱ta yadu̱ jab-u̱ ró o̱ u-tát, na kabu̱g ko̱n-u̱s ró,&gt;&gt; Za rem wa'-u̱ rò kum m-yar.<verse eid="MAT 15:28"/></para>
  <para style="s1">Ye̱so̱ re̱gu̱sse̱ ne̱t-ne̱ <optbreak/> u̱t-zo̱ngu u̱t-nas [4,000]</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>Du̱gu̱ ku̱n Ye̱so̱ dor kit m-sa yu̱ Gariri, wa du̱u̱s u-do̱m u̱r-ro̱r wa shu̱'u̱t. <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>U̱t-ne̱t u-tát e̱ haan u̱du̱ rò, e̱ hatu̱n ryam-ne̱, u̱ po̱-ne̱ u̱ a-za-u̱s-na ne̱, u̱ a-za ho̱g-du̱ u̱s-rem ne̱ u̱t-ne̱t ne̱ u-tát, na haatu̱n u̱n na ru̱st u̱ shu̱ Ye̱so̱, tu̱msu̱ wa yu̱ u̱n m-yar. <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>Ne̱t-tu̱ hu̱ mu̱rimmo̱ da-u̱ e̱ hyane̱ a-za u̱s-rem ne̱, u̱ a-za-u̱s-na kwu̱ng m-yar, ryam-ne̱ o̱ m-ha, po̱-ne̱ kwu̱ng m-hyan, e̱ be̱e̱t e̱ no̱mu̱ u-Ru̱ u̱ Isra-ne̱ u̱t-vam.<verse eid="MAT 15:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>Se̱ Ye̱so̱ fog a-doru̱ wa, wa zu̱, &lt;&lt;U̱m o̱ ho̱g-du̱ o̱n-du̱ ne̱t-u̱t tun-to̱, remu̱ zu̱ u̱ ya-o̱ e̱ o̱tte̱ m-roog u̱t-tu̱t e̱ o̱ ane̱ u̱ me̱ ne̱, tu̱msu̱ e̱ zatte̱ no̱m u̱t-re̱ da. U̱m za u̱ssa u̱m to̱k u̱n u̱s-me̱r da, remu̱ zu̱ e̱ke̱n u̱t-byu̱z u̱ do̱m u-fu̱n.&gt;&gt;<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>Se̱ a-doru̱ rò zu̱ wu̱n, &lt;&lt;¿He̱ne̱ o̱ na do̱te̱ kwu̱m-du̱ no̱m u̱t-re̱ u̱ de̱ re̱gu̱ssu̱ ban-du̱ u̱t-ne̱t u̱-me̱ do̱g-u̱r din-de̱?&gt;&gt;<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>Ye̱so̱ shit u̱n, &lt;&lt;¿Be̱re̱di-to̱ u̱t-nu̱ tu̱ no̱ o̱tte̱?&gt;&gt;</para>
  <para style="p" vid="MAT 15:34">E̱ zu̱, &lt;&lt;It o̱tte̱ u̱t-be̱re̱di u̱t-ta'er, u̱ jan ne̱ cashi.&gt;&gt;<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>Wa zu̱ ban-du̱ u̱t-ne̱t e̱ shu̱'u̱t u-dak. <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>Wa ku̱b u̱t-be̱re̱di u̱t-ta'er u̱ jan ne̱ cashi. Da-u̱ wa no̱me̱ u̱t-vam, wa bosor wa yasu̱ a-doru̱ wa, e̱ hen e̱ mo̱tu̱ u̱t-ne̱t. <verse eid="MAT 15:36"/><verse number="37" style="v" sid="MAT 15:37"/>E̱ re, e̱ shig. Da-u̱ e̱ tase̱ a-dor kargu̱sse̱ tu̱ kuse̱ m-te̱ u̱t-ko̱o̱r u̱t-shu̱yi u̱t-ta'er. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>Tat-u̱ campa-ne̱ re̱ no̱m u̱t-re̱ o̱, campa-ne̱ u̱t-zo̱ngu u̱t-nas, na ogorte̱ ne̱ta-ne̱ u̱ ya'ag ne̱ da. <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>Da-u̱ ne̱t-tu̱ bu̱rge̱, se̱ Ye̱so̱ to u̱-me̱ u-hat m-ha u̱ dak-u̱ Magadan.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">Sa-u̱ u̱s-nap</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>Farisa-ne̱ u̱ Saduki-ne̱ haan u̱du̱ Ye̱so̱ remu̱ e̱ reg-u̱t wu̱n. E̱ kon wu̱n wa ko̱su̱ u̱n nap-su̱ no̱m-tu̱ m-shin du̱gu̱ do̱m u-ru̱, remu̱ u̱ ko̱ste̱ u̱zu̱ Ru̱-o̱ to̱mnu̱ wu̱n.<verse eid="MAT 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 16:2"/>Ye̱so̱ shu̱s wa zu̱ u̱n, &lt;&lt;A do̱m u-ru̱ zane̱, no̱ zu̱, &lt;Na de̱ no̱m-du̱ m-ya.&gt; <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>Tu̱msu̱ a do̱m u-ru̱ rime̱ u̱t-ku̱u̱t, no̱ zu̱, &lt;U̱ ya-o̱ na u̱t-no̱m u-yu̱.&gt; No̱ kere̱ senu̱sse̱ u̱ka da-u̱ o̱tte̱ u̱ do̱m u-ru̱, se̱di no̱ muute̱ jab-u̱s no̱ no̱ nap no̱m-tu̱ Ru̱-u̱ o̱ u̱t-no̱m da. <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>Ne̱t-u̱t yo̱-to̱ a-za gye̱r-u u-Ru̱ ne̱, no̱ u̱t-sa u̱s-nap su̱ no̱m-tu̱ m-shin, to̱ko̱n no̱m-tu̱ m-shin zaar he̱n da se̱ tu̱ Yunana.&gt;&gt; Ye̱so̱ yage̱ u̱n wa aru̱k.<verse eid="MAT 16:4"/></para>
  <para style="s1">Yis-mu̱ Farisa-ne̱ u̱ Saduki-ne̱</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>Da-u̱ a-dor pase̱ u̱ de̱ku̱n gwu̱gde̱ du̱ m-sa, e̱ baku̱ste̱ kab-du̱ u̱t-be̱re̱di da. <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;No̱mo̱n ga' u̱ go̱-du̱ yis-mu̱ Farisa-ne̱ u̱ Saduki-ne̱.&gt;&gt; <verse eid="MAT 16:6"/><verse number="7" style="v" sid="MAT 16:7"/>E̱ he̱e̱se̱ u̱s-rem m-e̱ m-e̱ u̱zu̱, &lt;&lt;Jiya ko̱b-du̱ u̱r-haan u̱t-be̱re̱di ne̱ o̱ wu̱te̱ wu̱n u̱ rem-u̱s sin-se̱.&gt;&gt;<verse eid="MAT 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 16:8"/>Da-u̱ Ye̱so̱ nape̱ no̱m-u̱ e̱ o̱tte̱ u̱s-rem se̱ wa zu̱, &lt;&lt;No̱ a-yadu̱ jab-u̱ ne̱ cashi, ¿remu̱ u-yan o̱ no̱ o̱tte̱ u̱s-rem u̱ te̱k-u̱ no̱ u̱t-zu̱ no̱ zatte̱ u̱t-be̱re̱di da? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>¿No̱ gwa'ag u̱r-nu uro da? ¿Kaag no̱ u̱t-to̱ u̱ka u̱m re̱gu̱sse̱ ne̱t-ne̱ u̱t-zo̱ngu u̱t-tan u̱t-be̱re̱di u̱t-tan da? ¿Tu̱msu̱ ko̱o̱r-u̱t yatto̱ u̱t-nu̱ to̱ kuse̱? <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>¿No̱ baku̱ste̱ ne̱t-ne̱ u̱t-zo̱ngu u̱t-nas i u̱m re̱gu̱sse̱ u̱t-be̱re̱di u̱t-ta'er da? ¿Tu̱msu̱ ko̱o̱r-u̱t yat-to̱ u̱t-nu̱ to̱ kuse̱? <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>Kamu̱g no̱ nap u̱zu̱, za ma-tu̱ be̱re̱di-du̱ o̱tte̱ m-yis de̱ u̱m o̱tte̱ u̱s-rem da. Se̱di no̱mo̱n ga' u̱ yis-mu̱ Farisa-ne̱ u̱ Saduki-ne̱.&gt;&gt; <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>A-doru̱ Ye̱so̱ nu̱p u̱zu̱ Ye̱so̱ za u̱ rem-su̱ u̱ mo̱ttu̱ yis-mu̱ na wu̱ye̱ u̱t-be̱re̱di da, se̱di wa o̱ u̱s-rem o̱ u̱zu̱ e̱ no̱m ga' u̱ go̱-du̱ ko̱se̱-u̱t Farisa-ne̱ u̱ Saduki-ne̱.<verse eid="MAT 16:12"/></para>
  <para style="s1">Biturus zu̱ Ye̱so̱, <optbreak/> &lt;&lt;Bo̱ wa o̱ Kiristi&gt;&gt;</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>Da-u̱ Ye̱so̱ haane̱ u̱ dak-u̱ Kasariya Firibi, wa shit a-doru̱ wa u̱zu̱, &lt;&lt;¿Wana ne̱t-tu̱ zu̱ Wa'-u̱ Ne̱t o̱ye̱?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">16:13 </char><char style="ft" closed="false">&lt;&lt;Wa'u̱ ne̱t&gt;&gt; Dim-de̱ du̱ Ye̱so̱ fogte̱ hi-u̱r wa.</char></note><verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>Se̱ e̱ zu̱, &lt;&lt;E̱ke̱n zu̱ Yohanna wa-u̱t-yu̱bu̱sse̱ m-bu̱, e̱ke̱n zu̱ Iriya wa, tu̱msu̱ e̱ke̱n zu̱ Irmiya, ko̱ waku̱n u̱ te̱k-u̱ a-warru̱ rem-su̱ u-Ru̱ ne̱.&gt;&gt;<verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;¿No̱ wa no̱ o̱ u̱t-zu̱ wa u̱m o̱ye̱?&gt;&gt;<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>Simo̱n Biturus shu̱s wa zu̱, &lt;&lt;Bo̱ wa Kiristi<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">Ko̱ </char><char style="fqa" closed="false">Armashihu. Mesaya </char><char style="ft" closed="false">(U̱ rem-du̱ Yahuda-ne̱) tu̱msu̱ </char><char style="fqa" closed="false">Christ </char><char style="ft" closed="false">(U̱t-Girik) to̱ u̱t-be̱e̱t to̱ zu̱ &lt;&lt;Wu̱ o̱tte̱ kom u-Ru̱.&gt;&gt;</char></note> Wa'-u̱ u-Ru̱ u̱r-fat.&gt;&gt;<verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>Ye̱so̱ shu̱s wa zu̱, &lt;&lt;Bo̱ o̱ kom u-Ru̱ ne̱ Simo̱n wa'-u̱ Yunana! U̱m zu̱u̱g iya remu̱ zu̱ a ne̱t wa waru̱ bo̱ sin-se̱ rem-se̱ da, se̱di U̱so-u ri wu̱ o̱ do̱m u-ru̱. <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>U̱m o̱ hen u̱ waru̱ bo̱, bo̱ wa o̱ Biturus (wu̱ foge̱ u̱r-taar), u̱ do̱m-u̱ taar-u̱r rinde̱ de̱ u̱m de̱te̱ ma-du̱ a-doru̱ Ye̱so̱ ne̱, tu̱msu̱ be̱b-du̱ m-mar de̱ za kwu̱m-du̱ u̱r-be̱b u̱ do̱m-u̱ o̱ da. <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>U̱m de̱ yadu̱ bo̱ go̱r-yu̱ Faru̱k-du̱ u-ru̱, no̱m-u̱ no̱ hoose̱ u̱-me̱ u-dak, Ru̱-u̱ de̱ hoosu̱ o̱ do̱m u-ru̱, tu̱msu̱ no̱m-u̱ bo̱ ya be̱b-du̱ u̱t-no̱m u̱-me̱ u-dak, Ru̱-u̱ de̱ yadu̱ be-du̱ u̱t-no̱m u̱ do̱m u-ru̱.&gt;&gt; <verse eid="MAT 16:19"/><verse number="20" style="v" sid="MAT 16:20"/>Se̱ wa nu̱k a-doru̱ wa u̱t-to̱ u̱zu̱ a e̱ waru̱ waku̱n u̱zu̱ wa o̱ Kiristi da.<verse eid="MAT 16:20"/></para>
  <para style="s1">Ye̱so̱ waru̱g go̱-du̱ <optbreak/> mar-mu̱ wa do̱te̱</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>Du̱gu̱ da-u o̱ Ye̱so̱ he̱e̱se̱ waru̱ a-doru̱ wa u̱zu̱, zatte̱ ka u̱t-no̱m da, se̱ wa de̱ge̱ u̱ Urusharima wa swa u̱r-ko̱b u̱t-go̱ u̱t-go̱ u̱ kom-tu̱ u̱t-ne̱nge̱n, u̱ i-Yate̱ a-To̱o̱g-ne̱, u̱ a-ko̱se̱-tu̱ u-bo̱r ne̱, tu̱msu̱ e̱ ho̱ wa, u̱ ho̱-du̱ u-tu̱tu̱rse̱ wa yu̱ne̱ du̱gu̱ marimari-ne̱.<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>Biturus nu̱k wu̱n u̱ kit wa no̱mu̱ wu̱n u̱t-him u̱zu̱, &lt;&lt;U̱ Ru̱-u̱ hast, Wa-m-nap, se̱se̱ zaru̱ kwu̱m-du̱ bo̱ da!&gt;&gt;<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>Ye̱so̱ bir wa zu̱ Biturus, &lt;&lt;Hate̱ u̱ be-du̱ u̱m o̱tte̱, bo̱ faru̱k-u̱ no̱m u̱s-te! Bo̱ yu̱ u̱t-sa wadu̱ me̱ u̱r-he̱'e̱, remu̱ zu̱ dorog-u̱s ró su̱ ne̱t se̱, za u̱ka u-Ru̱ da.&gt;&gt;<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>Ye̱so̱ zu̱ a-doru̱ wa, &lt;&lt;Wu̱ u̱t-sa do̱rru̱ me̱ se̱ wa gu̱gu̱mte̱ hi-u̱r wa, wa kab kan-u wa, wa do̱r me̱. <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>Wu̱ o̱ u̱kru̱ fat-u̱r wa, wa de̱ u̱t-taag u̱ de̱. Tu̱msu̱ wu̱ taage̱ fat-u̱r wa remu̱ ri, wa de̱ kwu̱m-du̱ de̱. <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>¿Yan-o̱ ne̱t de̱ u̱t-kwu̱me, da-u̱ wa kume̱ kwu̱m-tu̱ dak-u uno̱ wa taag u̱ fat-u̱r wa? ¿Ko̱ yan-o̱ ne̱t de̱ u̱t-ya u̱ka m-swasa remu̱ fat-u̱r wa? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>Wa'-u̱ ne̱t de̱ haan u̱ a-to̱m u-Ru̱ ne̱ u̱-me̱ fu̱'u̱bse̱-u̱t U̱so-u wa, wa to̱p kowan to̱p-u̱ no̱mu̱ wa no̱me̱. <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>U̱m o̱ waru̱ no̱ u̱t-nip, e̱ke̱n o̱ro u̱ ees u̱ ane̱ i za m-mar da, se̱ e̱ hyanu̱g haan-du̱ Wa'-u̱ Ne̱t u̱-me̱ faru̱k-u̱r wa.&gt;&gt;<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">Sha-m Ye̱so̱ baru̱mte̱</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>Da-u̱ roog-mu̱ shishin arke̱ Ye̱so̱ ku̱b Biturus, u̱ Yakubu, u̱ Yohanna ne̱ hu̱u̱b u̱r-matu̱ wane̱ Yakubu, wa hu̱u̱t u̱n u̱ de̱ku̱n ro̱r-de̱ du̱ m-wu̱r, u̱ war u̱n. <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>U̱n o̱ u̱ku̱n se̱ sha-m Ye̱so̱ baru̱m. Shu̱-u wa no̱m m-zu̱n u̱ka zu̱n-mu̱ u̱r-ho̱, tu̱msu̱ kus-tu̱ wa wa'e̱ to̱ no̱m u̱ pus-to̱ u̱ka m-zu̱n. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>Za rem, se̱ Iriya wa-warru̱ rem-su̱ u-Ru̱ u̱ Mosa ne̱ rwu̱n u̱du̱ u̱n, e̱ o̱ u̱s-rem u̱ Ye̱so̱ ne̱.<verse eid="MAT 17:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4"/>Biturus zu̱ Ye̱so̱, &lt;&lt;Wa-m-nap, no̱ng u̱r-zwar u̱ na o̱tte̱ u̱ ane̱. A-bo̱ ese̱ u̱m de̱ kadu̱ u̱t-rimpa u̱t-tu̱t, du̱ ró u̱r-gan, u̱r-gan du̱ Mosa u̱r-gan tu̱msu̱ du̱ Iriya wa-warru̱ rem-su̱ u-Ru̱.&gt;&gt;<verse eid="MAT 17:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 17:5"/>Wa o̱ te̱k-u̱ u̱s-rem, se̱ de̱ku̱n ku̱'u̱t-de̱ du̱ m-zu̱n gu̱ru̱s u̱n be̱e̱t, tu̱msu̱ e̱ ho̱g u-cwar u̱-me̱ u̱r-ku̱'u̱t ya o̱ u̱t-zu̱, &lt;&lt;Unwa o̱ Wa'-u̱ ri, wu̱ u̱m o̱ u̱t-cwan, tu̱msu̱ u̱m hog zwar-u̱r rò sok, e̱re̱n wu̱n.&gt;&gt;<verse eid="MAT 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 17:6"/>Da-u̱ a-dor ho̱ge̱ iya gye̱r-u̱ ship u̱n sok har e̱ he m-ho̱bo̱g. <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>Ye̱so̱ haan wa tu̱m u̱n wa zu̱, &lt;&lt;Yu̱nu̱n, a no̱ ho̱g u-gye̱r da!&gt;&gt; <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>Da-u̱ e̱ jakse̱ u̱t-hi, e̱ hyang waku̱n da, se̱ Ye̱so̱ u̱ war-wa.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>Da-u̱ e̱ o̱ cu̱zu̱n du̱gu̱ do̱m u̱r-ro̱r, Ye̱so̱ no̱mu̱ u̱n u̱t-him, wa zu̱, &lt;&lt;A no̱ waru̱ waku̱n no̱mu̱ no̱ hyane̱ da, se̱ Wa'-u̱ Ne̱t yu̱nge̱ du̱gu̱ marimari-ne̱.&gt;&gt;<verse eid="MAT 17:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 17:10"/>A-dor shit wu̱n e̱ zu̱, &lt;&lt;¿Yan-o̱ wu̱te̱ a-ko̱se̱-tu̱ u-bo̱r ne̱ u̱t-zu̱, se̱ wa-warru̱ rem-su̱ u-Ru̱ Iriya baag m-haane̱?&gt;&gt;<verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>Ye̱so̱ shu̱s wa zu̱, &lt;&lt;Iya o̱ Iriya de̱ haan wa mang ko-uyan. <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>Se̱di u̱m o̱ waru̱ no̱, Iriya baag u̱ hagu̱n, e̱ nak wu̱n da, har e̱ no̱mu̱ wu̱n no̱mu̱ cwane̱ u̱ jab-u̱s e̱. Iya hen Wa'-u̱ Ne̱t de̱ swadu̱ u̱r-ko̱b u̱ ko̱m-u̱t u̱n.&gt;&gt; <verse eid="MAT 17:12"/><verse number="13" style="v" sid="MAT 17:13"/>A-dor nu̱p u̱zu̱, rem-u̱s Yohanna wa-u̱t-yu̱bu̱sse̱ m-bu̱ se̱ wa o̱ no̱mu̱ u̱n.<verse eid="MAT 17:13"/></para>
  <para style="s1">Ye̱so̱ haste̱ wa zwar <optbreak/> no̱m u̱s-te</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>Da-u̱ e̱ cwaye̱ be-du̱ mo̱ro̱g-du̱ u̱t-ne̱t o̱tte̱, yaku̱n campa-ya haan u̱du̱ Ye̱so̱ wa he u̱t-jwu̱n u̱ shu̱ Ye̱so̱. <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>&lt;&lt;Wa-m-nap, ho̱g o̱n-du̱ wa zwar-u̱ ri. Wa o̱tte̱ go̱m-su̱ u̱r-he̱'e̱, tu̱msu̱ wa o̱ swadu̱ u̱r-ko̱b sok. O̱ko̱n da-o̱ wa he̱ u̱-me̱ u-ra, o̱ko̱n da-o̱ u̱-me̱ m-bu̱. <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>U̱m hu̱u̱te̱ wu̱n u̱du̱ a-doru̱ ró, e̱ hen e̱ kerge̱ has-tu̱ go̱m-u̱s se̱ da.&gt;&gt;<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>Ye̱so̱ zu̱, &lt;&lt;No̱ ne̱t-tu̱ uno̱ da-o̱, a-ko̱b-du̱ yadu̱ jab, a-jab-u̱s yo̱-se̱! ¿Yan da-o̱ u̱m de̱ u̱t-kere̱ u̱r-shu̱'u̱t u̱ no̱ ne̱? Hatu̱n wa'-u̱ ró u̱ ane̱.&gt;&gt; <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>Ye̱so̱ hagu̱sse̱ no̱m-yu̱ u̱s-te, no̱m-yu̱ u̱s-te ru, wa zwar kum m-yar.<verse eid="MAT 17:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19"/>A-doru̱ Ye̱so̱ haan u̱du̱ Ye̱so̱ da-u̱ waku̱n zare̱ u̱ku̱n da, e̱ shit Ye̱so̱ u̱zu̱, &lt;&lt;¿Remu̱ yan o̱ wu̱te̱ it kerge̱ rutu̱ no̱m-yu̱ u̱s-te ya da?&gt;&gt;<verse eid="MAT 17:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;No̱ kerge̱ bu̱z-du̱ no̱m-yu̱ u̱s-te ya da, remu̱ zu̱ yadu̱ jab-u̱ no̱ o̱ cashi. U̱m o̱ waru̱ no̱ u̱t-nip, a no̱ o̱tte̱ yadu̱ jab u̱ka ya-yu̱ mastad, ya-yu̱ zege̱ u̱s-re̱k u̱ te̱k-u̱ go̱ u̱t-no̱m, no̱ keru̱ zu̱ ro̱r-u̱r din-de̱, &lt;Mu'us m-ha u̱ ana&gt; jit, tu̱msu̱ de̱ mu'us. O̱ko̱n zaar u̱ ze̱ge̱ be̱b-u̱r no̱ da.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">17:20 </char><char style="ft" closed="false">To̱ko̱n Ran-to̱ swu̱ru̱g fe̱-yu̱ </char><char style="fv">21</char> <char style="fqa" closed="false">Go̱-du̱ se̱ hen za u̱t-no̱me̱ da se̱ u̱s-to̱o̱g ne̱ u-swaat ne̱. </char><char style="ft" closed="false">Ho̱ngu̱sse̱ Mark 9:29.</char></note><verse eid="MAT 17:20"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>Da-u̱ a-dor mo̱rge̱ u̱ dak-u̱ Gariri, se̱ Ye̱so̱ zu̱ u̱n, &lt;&lt;E̱ke̱n de̱ yasu̱ Wa'-u̱ Ne̱t u̱ kom-tu̱ u̱t-ne̱t. <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>Tu̱msu̱ e̱ do̱'e̱ ho̱-du̱ wu̱n. U̱ ho̱-du̱ u-tu̱tu̱rse̱ na de̱ yu̱nsu̱ wa du̱gu̱ marimari-ne̱.&gt;&gt; No̱mu o̱ zusu̱ a-dor-ne̱ sok.<verse eid="MAT 17:23"/></para>
  <para style="s1">Tar-u̱ be-du̱ u̱r-shu̱'u̱t <optbreak/> du̱ Wa-ko̱-uyan</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>Da-u̱ Ye̱so̱ u̱ a-doru̱ wa ne̱ te bo̱-u̱ Kapanahum, a-o̱nku̱ shik-u̱ tar haan u̱du̱ Biturus u̱ mo̱ttu̱ ta'ar-ru̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan e̱ zu̱, &lt;&lt;Waru̱n it ko̱ wa-u̱t-ko̱se̱ no̱ top-u̱t shik-u̱ tar.&gt;&gt;<verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>Biturus zu̱, &lt;&lt;U̱, wa top.&gt;&gt;</para>
  <para style="p" vid="MAT 17:25">Da-u̱ Biturus mu̱ne̱ u-bu, se̱ Ye̱so̱ he̱e̱se̱ no̱mu̱ wu̱n u̱s-rem u̱zu̱, &lt;&lt;¿Yan o̱ bo̱ hyane̱ u̱ mo̱ttu̱ shu̱t-u̱r re̱? ¿No̱ o̱ m-hyan faru̱k-tu̱ o̱nk shik-u̱ tar u̱du̱ ne̱t-tu̱ bo̱-u̱ e̱? ¿Ko̱ no̱ o̱ m-hyan faru̱k-tu̱ o̱nk shik-u̱ tar u̱du̱ ne̱t-tu̱ na re̱ m-gag?&gt;&gt;<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>Biturus zu̱, &lt;&lt;U̱du̱ e̱ke̱n.&gt;&gt;</para>
  <para style="p" vid="MAT 17:26">Ye̱so̱ zu̱, &lt;&lt;Shu̱'u̱te̱ u̱zu̱ u̱n top-u̱t da. <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>Ko ba shu̱'u̱te̱ iya, taas u̱ ne̱t-u̱t tun-to̱ ho̱g ryab-u̱s in da, do̱'e̱ bo̱ gun kwe̱nhi-yu̱ masu̱ jan, bo̱ upus nu-u̱ jan-yu̱ bo̱ he̱e̱se̱ u̱t-mas bo̱ u̱t-hyan shik u̱-me̱. Kab e̱ bo̱ to̱p shik-u̱ tar i ró u̱ i ri ne̱.&gt;&gt;<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">Wu̱ o̱ yu̱-shu̱ u̱-me̱ <optbreak/> Faru̱k-du̱ u-ru̱</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mark 9:33-37</ref>; <ref loc="LUK 9:46-48">Ruka 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>U̱ te̱k-u̱ da-u o̱, a-dor haan u̱du̱ Ye̱so̱ e̱ shit wu̱n u̱zu̱, &lt;&lt;¿Wana o̱ yu̱-shu̱ u̱-me̱ faru̱k-du̱ u-Ru̱?&gt;&gt;<verse eid="MAT 18:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2"/>Ye̱so̱ kabu̱n ya-u̱r re̱k-de̱, wa egu̱sse̱ wa u̱-me̱ u̱n. <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>Ye̱so̱ zu̱, &lt;&lt;U̱m o̱ waru̱ no̱ u̱t-nip, a ne̱t u̱ muute̱ hi-u̱r wa u̱ka ya-u̱r re̱k-de̱ wa za tamu̱ cwadu̱ Faru̱k-du̱ u-ru̱ da. <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>Remu̱ iya wu̱ mute̱ hi-u̱r wa u̱ka ya-u̱r re̱k-de̱ wa de̱ shu̱'u̱tu̱ yu̱-Yat-ya u̱-me̱ faru̱k-du̱ u-ru̱.<verse eid="MAT 18:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 18:5"/>&lt;&lt;Tu̱msu̱ i kabe̱ ya-u̱r re̱k-de̱ din-de̱ remu̱ zu̱ e̱ o̱ cwan-u̱t ri, me̱ wa e̱ kabe̱. <verse eid="MAT 18:5"/><verse number="6" style="v" sid="MAT 18:6"/>Ko̱wana wa'e̱ wa-gan u̱ te̱k-u̱ i-re̱k-e̱ ine̱ i ya' jab u̱du̱ ri u̱ no̱m-du̱ u̱t-ba'as, u̱t-ze̱g u̱r-zwar na gagu̱ wa ta'ar-du̱ u̱r-na u̱ ge̱ksu̱ wa, na gun wa u̱-me̱ m-sa.<verse eid="MAT 18:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 18:7"/>&lt;&lt;No̱m-tu̱ u̱r-o̱n u̱du̱ dak-u uno̱ u̱ remu̱ no̱m-tu̱ wadu̱ ne̱t u̱ no̱m-du̱ u̱t-ba'as de̱ haan. No̱m-tu̱ wadu̱ ne̱t u̱t-ba'as to̱ haan, Se̱di u̱ shu̱'u̱tu̱ no̱m-tu̱ u̱r-o̱n u̱ wu̱ de̱ wadu̱ waku̱n u̱ no̱m-du̱ u̱t-ba'as. <verse eid="MAT 18:7"/><verse number="8" style="v" sid="MAT 18:8"/>A kom-u ró ko̱ na-u ró o̱ wadu̱ bo̱ u̱ no̱m-du̱ u̱t-ba'as, kupse̱ bo̱ ju̱re̱. U̱t-ze̱g bo̱ cwa u̱ fat-du̱ za u̱r-ma u-kom ne̱ u-gan ko̱ u-na u-gan ko̱ ryam, u̱ na gunt bo̱ u̱ me̱n-tu̱ u-ra u̱ za u̱t-mar da, u̱ kom-u̱t ró ne̱ u̱t-yu̱r ko̱ u̱s-na u̱s-yu̱r. <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>A mu̱ne̱ is-u̱r ró u̱ wa bo̱ u̱ no̱m-du̱ u̱t-ba'as, se̱ bo̱ hast bo̱ rest. U̱t-ze̱g bo̱ cwa u̱ fat-du̱ za u̱r-ma u̱r-is ne̱ u̱r-gan u̱na gun bo̱ u̱ bu-u ra-u̱ za u̱t-mar da u̱ is-ne̱ yu̱r.<verse eid="MAT 18:9"/></para>
  <para style="s1">Sha-mu̱ u̱s-rem su̱ ca-yu̱ e̱nke̱</para>
  <para style="r">(<ref loc="LUK 15:3-7">Ruka 15:3-7</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>&lt;&lt;Gwatu̱n a no̱ ju̱ru̱m waku̱n u̱ te̱k-u̱ ine̱ yaage̱ da. Remu̱ u̱m o̱ waru̱ no̱ a-to̱m u-Ru̱ u̱n ne̱, o̱ u̱r-yu̱ u̱du̱ U̱so-u ri wu̱ o̱ do̱m u-ru̱, e̱ de̱ waru̱ u-Ru̱ a no̱ no̱mu̱ yaag no̱m-u̱t so̱-to̱ da.<note caller="+" style="f"><char style="fr" closed="false">18:10 </char><char style="ft" closed="false">To̱ko̱n Ran-to̱ swu̱ru̱g fe̱-yu̱ </char><char style="fv">11</char> <char style="fqa" closed="false">Tu̱msu̱ Wa'-u̱ Ne̱t haagu̱n remu̱ wa u̱ku̱rte̱ ne̱t-tu̱ e̱nke̱. </char><char style="ft" closed="false">Ho̱ngu̱sse̱ </char><char style="xt"><ref loc="LUK 19:10">Ruka 19:10</ref></char>.</note> <verse eid="MAT 18:10"/><verse number="12" style="v" sid="MAT 18:12"/>¿Yan o̱ no̱ o̱ m-hyane̱? A wa-gwat-du̱ ca u̱t-shik u̱t-tan, u-gan u̱ te̱k-u̱ e̱ ya e̱nk, ¿wa da yagu̱ ca u̱t-shik u̱t-tan za u-gan wa do̱'e̱ go-tu̱ yu̱ e̱nke̱ da? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>A mu̱ne̱ zu̱ wa hyanu̱g ya, u̱m o̱ waru̱ no̱ u̱t-nip, so̱-du̱ wa de̱ u̱t-no̱m remu̱ yu̱ e̱nke̱ ya, u̱t-ze̱g u̱t-ko̱k u̱t-tan za u-gan i o̱ za e̱nk. <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>Iya o̱ he̱n, cwan-tu̱ U̱so-u no̱ to da wu̱ o̱ do̱m u-ru̱ u̱ wa-gan u̱ e̱nk u̱ te̱k-u̱ me̱ yaag ine̱.<verse eid="MAT 18:14"/></para>
  <para style="s1">O̱r-u̱ ró wu̱ no̱mu̱ bo̱ u̱t-ba'as</para>
  <para style="r">(<ref loc="LUK 17:3">Ruka 17:3</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>&lt;&lt;A o̱r-u̱ ró no̱mu̱ bo̱ u̱t-ba'as do̱'e̱ bo̱ ko̱su̱ wa u̱zu̱ wa no̱ngu̱ bo̱ u̱t-ba'as, no̱ wa ne̱ yu̱r. A ne̱tu̱ wa e̱ru̱ bo̱, bo̱ mu̱ttu̱n wa u̱-do̱m u-fu̱n. <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>Se̱di a wa e̱ru̱ bo̱ da, se̱ bo̱ mang m-ha u̱ ne̱t gan ne̱ ko̱ ne̱t-ne̱ yu̱r, remu̱ ko̱-uyan rem-se̱ na ku̱b remu̱ war-mu̱ ne̱t-ne̱ yu̱r ko̱ ne̱t-ne̱ tu̱t.<note caller="+" style="f"><char style="fr" closed="false">18:16 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 19:15">Muut 19:15</ref></char>.</note> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>A o̱r-u̱ ró gu̱gme̱ e̱rru̱ u̱n, se̱ bo̱ waru̱ a-doru̱ Ye̱so̱ ne̱, a wa gu̱gme̱ e̱rru̱ a-dor-ne̱, muute̱ wa u̱ka wu̱ nape̱ u-Ru̱ da, ko̱ wa-o̱nku̱ shik-u̱ tar.<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>&lt;&lt;U̱m o̱ waru̱ no̱ u̱t-nip, no̱m-u̱ no̱ hoose̱ u̱-me̱ u-dak, Ru̱-u̱ de̱ hoosu̱ o̱ do̱m u-ru̱, tu̱msu̱ no̱m-u̱ bo̱ ya be̱b-du̱ u̱t-no̱m u̱-me̱ u-dak, Ru̱-u̱ de̱ yadu̱ be̱b-du̱ no̱m-du̱ o̱ u̱ do̱m u-ru̱.<verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>&lt;&lt;U̱m o̱ hen u̱ waru̱ no, a ne̱t-ne̱ yu̱r u̱ ane̱ u-dak, e̱ eese̱ e̱ kon o̱ko̱n no̱m-o̱, U̱so-u ri wu̱ o̱ do̱m u-ru̱ wa no̱mu̱ u̱n. <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>U̱m zu̱u̱g iya remu̱ zu̱ be-du̱ ne̱t-ne̱ yu̱r ko̱ tu̱t mo̱ro̱gte̱ remu̱ zu̱ e̱ yaag jab u̱du̱ ri, u̱m o̱ u̱r-kot u̱ e̱ ne̱.&gt;&gt;<verse eid="MAT 18:20"/></para>
  <para style="s1">Sha-mu̱ u̱s-rem su̱ to̱k wu̱ za u̱r-o̱n</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>Na o̱ u̱ku̱n Biturus haan wa zu̱ Ye̱so̱, &lt;&lt;Wa-m-nap, ¿so-o̱ u-nu o̱r-u̱ ri de̱ no̱mu̱ me̱ u̱t-ba'as, u̱m no̱mu̱ wa u̱r-ho̱? ¿U-so u-ta'er?&gt;&gt;<verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>Ye̱so̱ zu̱ wu̱n, &lt;&lt;Za u-so u-ta'er da, se̱di u-so u̱t-shik u̱t-tu̱t u̱ o̱p u-so u-ta'er [490] za u̱r-ma.<verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>&lt;&lt;Remu̱ iya, faru̱k-du̱ u-Ru̱ o̱ u̱ka waku̱n faru̱k wa wu̱ u̱t-sa wa ogor kwu̱m-u̱t wa tu̱ o̱ kom-tu̱ to̱k-ne̱ wa. <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>Da-u̱ faru̱k tak-ne̱ u̱t-ogor, se̱ na haatu̱n wa waku̱n ne̱t wa, wu̱ faru̱k dore̱ u̱r-mag, shik u-tát i ne̱t za u̱t-kere̱ u̱t-to̱p u̱ yu̱-u̱r wa u̱r-be̱e̱t da. <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>Ba wa ku̱su̱n u̱t-to̱p se̱ faru̱k wu̱ na bu̱b wa u̱ ne̱ta wa ne̱ u̱ ya'ag-u̱ wa ne̱, u̱ no̱m-u̱ wa o̱tte̱ ne̱ u-be̱e̱t wa to̱p u̱r-mag.<verse eid="MAT 18:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 18:26"/>&lt;&lt;Se̱ to̱k-u̱ wa he u̱t-jwu̱n u̱ shu̱ faru̱k wa o̱ u̱s-ko̱n wa zu̱, &lt;Ho̱g o̱n-u̱r ri, me̱ to̱p-u̱ ko-uyan!&gt; <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>Se̱ faru̱k hog o̱n-du̱ to̱ku̱ wa, wa yagu̱ wu̱n wa aru̱k, wa zu̱ a wa to̱p mag-u̱r re̱ da.<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>&lt;&lt;Se̱di to̱k-u̱ wa da-u̱ wa ruye̱ se̱ wa bit hu̱u̱b m-ank wa, wu̱ wa dore̱ u̱r-mag shik cashi, wa soos wu̱n u-cwar, wa zu̱, &lt;To̱p me̱ no̱m-u̱ u̱m dore̱ bo̱!&gt;<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>&lt;&lt;Se̱ hu̱u̱b m-ank-u̱ rò he u̱t-jwu̱n u̱ shu̱ rò, wa kon wu̱n wa zu̱, &lt;No̱mu̱ me̱ u̱r-ho̱, me̱ to̱p-u̱ bo̱!&gt;<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>&lt;&lt;Se̱di to̱ku̱ wa gu̱gu̱m, wa hu̱u̱t wu̱n u̱ bu-u̱ m-to̱k, wa zu̱ se̱ wa to̱po̱k mag-u̱r re̱. <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>Da-u̱ hu̱u̱b-tu̱ m-ank-u̱ rò ho̱ge̱ no̱mu̱ no̱me̱, e̱ ho̱k u̱r-zwar da. Se̱ e̱ do̱'e̱ e̱ waru̱ faru̱k no̱mu̱ no̱me̱ u-be̱e̱t.<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>&lt;&lt;Faru̱k fog to̱ku̱ wa wa zu̱, &lt;Bo̱ to̱k yo̱-o̱ wa. U̱m no̱ngu̱ ho̱-du̱ mag-du̱ u̱m doru̱ bo̱ remu̱ zu̱ bo̱ ko̱no̱g me̱. <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>¿Kamu̱g u̱zu̱ bo̱ ho̱g o̱n-du̱ hu̱u̱b m-ank-u̱ ró, u̱ka u̱m hogte̱ o̱n-u̱r ró da?&gt; <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>Faru̱k hog m-ku̱wu̱t sok, se̱ wa wu̱ na ya' wu̱n u̱r-ko̱b wa to̱p no̱m-u̱ wa doru̱ wa u-be̱e̱t.<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>&lt;&lt;Iya o̱ hen Uso-u ri wu̱ do̱m u-ru̱ do̱te̱ no̱mu̱ wu̱ gu̱gme̱ no̱mu̱ o̱r-u̱ wa u̱r-ho̱ jab gan.&gt;&gt;<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">Ko̱se̱-tu̱ mo̱t-du̱ u̱r-gu̱</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>Da-u̱ Ye̱so̱ tase̱ warru̱ rem-u̱s se̱, wa yage̱ Gariri, wa do̱'e̱ u̱ dak-u̱ Yahudiya u̱ gwu̱g-du̱ u-do̱m du̱ Gi-yu̱ Yodan. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>Ban-du̱ u̱t-ne̱t dor wu̱n u̱ku̱n, tu̱msu̱ wa hastu̱ ne̱t-ne̱ go̱m-u̱s e̱.<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>E̱ke̱n Farisa-ne̱ haan e̱ reg-u̱t wu̱n u̱ din-de̱ shu̱t-de̱ u̱zu̱, &lt;&lt;¿Bo̱r-u̱t in tu̱ Yahuda-ne̱ yaag ne̱t be̱b-du̱ yan-du̱ ne̱ta wa u̱ remu̱ ko̱-uyan rem o̱?&gt;&gt;<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;No̱ karu̱nte̱ rem-su̱ u-Ru̱, kamu̱g no̱ nap u̱zu̱ da-u̱ Ru̱-u̱ no̱me̱ ne̱t du̱gu̱ u̱r-taku̱n, &lt;Ru̱-u̱ no̱mu̱g campa gan wa nom ne̱ta gan remu̱ e̱ shu̱'u̱te̱ ne̱ta e̱ campa.&gt;<note caller="+" style="f"><char style="fr" closed="false">19:4 </char><char style="ft" closed="false">Taku̱ 1:27; 5:2.</char></note> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>Ko̱ske̱ no̱m-u̱ Ru̱-u̱ ware̱ u̱zu̱, &lt;Ne̱t de̱ yagu̱ Uso-u wa u̱ ino-u wa ne̱ wa dap ne̱ta wa, e̱ yu̱r hen e̱ shu̱'u̱t ne̱t gan.&gt;<note caller="+" style="f"><char style="fr" closed="false">19:5 </char><char style="ft" closed="false">Taku̱ 2:24.</char></note> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>Remu̱ iya e̱ zamu̱n ne̱t-ne̱ yu̱r da se̱di ne̱t gan. Remu̱ iya hen, no̱mu̱ Ru̱-u̱ same̱ a waku̱n u̱ mo̱t da.&gt;&gt;<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>E̱ shit u̱zu̱, &lt;&lt;¿Remu̱ yan-o̱ Mosa wu̱rte̱ bo̱r-tu̱ yan-du̱ ne̱ta, u̱zu̱ wu̱ o̱ yan-du̱ ne̱ta wa, wa pan ran-u̱ u̱t-yane̱?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">19:7 </char><char style="ft" closed="false">Gwat tu̱msu̱ Muut </char><char style="xt"><ref loc="MAT 24:1">24:1</ref></char>.</note><verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;Remu̱ hok-tu̱ u̱t-to̱ no̱ o̱ wu̱te̱ Mosa yagte̱ u̱ ne̱t u̱ yan ne̱ta wa. Se̱di da Ru̱-o̱ no̱me̱ campa e̱ ne̱ta, wa cu̱ng u̱zu̱ e̱ mo̱t da. <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>U̱m o̱ hen u̱ waru̱ no̱, wu̱ yane̱ ne̱ta wa, wa gu̱ waku̱n, a-za remu̱ m-o̱ da, as-o̱ wa o̱tte̱.&gt;&gt;<verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>A-doru̱ Ye̱so̱ zu̱ wu̱n, &lt;&lt;Abite̱ iya o̱, ze̱k u̱r-zwar u̱ ne̱t u̱ shu̱'u̱t za u̱r-gu̱.&gt;&gt;<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;Ru̱-u̱ se̱gu̱ to̱ko̱n ne̱t-to̱ e̱ kab ko̱se̱-u̱t tun-to̱. E̱ war-e̱ de̱ kere̱ u̱r-yu̱ za no̱m-du̱ u̱r-gu̱. <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>E̱ke̱n o̱ro i na mate̱ maku̱t-ne̱, e̱ke̱n hen ne̱t-tu̱ muute̱ e̱ iya, tu̱msu̱ e̱ke̱n o̱ro i zu̱ e̱ za u̱r-gu̱ da remu̱ Faru̱k-du̱ u-Ru̱. Yage̱ wa u̱t-kab wa kab rem-u̱s sin-se̱.&gt;&gt;<verse eid="MAT 19:12"/></para>
  <para style="s1">Yaagu̱ re̱k-e̱ u̱ Ye̱so̱ ne̱</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mark 10:13-16</ref>; <ref loc="LUK 18:15-17">Ruka 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>De̱ku̱n ho̱-de̱ na hatu̱n Ye̱so̱ yaag remu̱ wa do̱r-tu̱ e̱ u̱t-kom tu̱msu̱ wa no̱m-tu̱ e̱ u̱s-to̱o̱g. A-doru̱ Ye̱so̱ hagu̱sse̱ a ya'ag ne̱ u̱zu̱ e̱ o̱ e̱kse̱ Ye̱so̱.<verse eid="MAT 19:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 19:14"/>Ye̱so̱ zu̱, &lt;&lt;Yagu̱n u̱ yaag u̱ haan u̱du̱ ri! A no̱ buz u̱n da, remu̱ zu̱ Faru̱k-du̱ u-Ru̱ o̱ do̱m-u̱ i o̱ u̱ka yaag ine̱.&gt;&gt; <verse eid="MAT 19:14"/><verse number="15" style="v" sid="MAT 19:15"/>Wa doru̱ u̱n u-kom wa wa'-u̱ u̱n nu-u so̱-o̱ kanda wa yagte̱ ku̱n.<verse eid="MAT 19:15"/></para>
  <para style="s1">Be̱b wa u̱t-kwu̱m</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mark 10:17-31</ref>; <ref loc="LUK 18:18-30">Ruka 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>Waku̱n haan u̱du̱ Ye̱so̱ wa zu̱, &lt;&lt;Wa-m-nap, ¿yan no̱m-u so̱-o̱ u̱m de̱ u̱t-no̱m u̱m kum-u̱t fat-du̱ za u̱r-ma?&gt;&gt;<verse eid="MAT 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17"/>Ye̱so̱ zu̱ wu̱n, &lt;&lt;¿Remu̱ u-yan o̱ bo̱ shit-tu̱ mo̱t-tu̱ no̱m-u so̱-o̱? Ru̱-o̱ o̱ so̱-o̱ war-wa. A-bo̱ u̱t-sa bo̱ kum fat-du̱ za u̱r-ma, se̱ bo̱ do̱ro̱g bo̱r-u̱t wa ho̱n-ho̱n.&gt;&gt;<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>Campa-u ya zu̱, &lt;&lt;¿Yan bo̱r-to̱?&gt;&gt;</para>
  <para style="p" vid="MAT 19:18">Ye̱so̱ shu̱s wa zu̱, &lt;&lt; &lt;A-bo̱ ho̱ ne̱t da, a-bo̱ no̱m m-o̱ da, a-bo̱ no̱m u-hiw da, a-bo̱ ke̱tu̱ waku̱n u̱s-rem da. <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>Ya u̱so-u ró m-ze̱g u̱ ino-u ró ne̱, tu̱msu̱ bo̱ cwan wa-bo̱ru̱ ró u̱ka bo̱ o̱tte̱ cwan-tu̱ hi-du̱ war ró.&gt;<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="ft" closed="false">Gwat tu̱msu̱ Muut: </char><char style="xt"><ref loc="EXO 20:12-16">Rwu̱u̱ 20:12-16</ref>; <ref loc="JDG 5:16-20">Kwu̱p 5:16-20</ref>; <ref loc="LEV 19:18">To̱o̱g 19:18</ref>.</char></note> &gt;&gt;<verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>Wa-u̱ be̱b zu̱, &lt;&lt;U̱m do̱ro̱g bo̱r-u̱t to̱ u̱t-be̱e̱t. ¿Yan-o̱ kuse̱ u̱m de̱ u̱t-no̱me̱?&gt;&gt;<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>Ye̱so̱ zu̱ wu̱n, &lt;&lt;A-bo̱ u̱t-sa bo̱ shu̱'u̱t u-shu̱yi shu̱yi, do̱'e̱ bo̱ bab no̱m-tu̱ bo̱ o̱tte̱ u̱t-be̱e̱t, bo̱ mo̱tu̱ a-u̱r-ko̱b-ne̱ shik-u̱ e̱. Bo̱ de̱ no̱m-du̱ u̱t-kwu̱m u̱ do̱m u-ru̱, se̱ bo̱ haan bo̱ do̱r me̱.&gt;&gt;<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>Da-u̱ wa-u̱ be̱b ho̱ge̱ iya, se̱ wa aru̱k jab nayi-nayi, remu̱ zu̱ wa o̱tte̱ u̱t-kwu̱m sok.<verse eid="MAT 19:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23"/>Ye̱so̱ zu̱ a-doru̱ wa, &lt;&lt;U̱m o̱ waru̱ no̱ u̱t-nip, u̱t-shu̱'u̱t u̱t-po̱ ne̱ u̱ wa-u̱t-kwu̱m u̱ to-u̱t u̱ Faru̱k-du̱ u-ru̱. <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>U̱m o̱ tu̱msu̱ waru̱ no̱, u̱t-ze̱g m-ku̱k u̱ rakum-yu̱ cwa u̱-me̱ hu̱-yu̱ u-be̱r, u̱ wa-u̱t-kwu̱m u̱ to-u̱t u̱ Faru̱k-du̱ u-Ru̱.&gt;&gt;<verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>Da-u̱ a-dor ho̱ge̱ iya e̱ hu̱ mu̱rimmo̱, e̱ zu̱, &lt;&lt;¿Abite̱ iya o̱ wana de̱ kwu̱m-du̱ u-u̱ku̱r?&gt;&gt;<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>Ye̱so̱ got u̱n wa zu̱, &lt;&lt;U̱du̱ ne̱t za u̱t-no̱me̱ da se̱di u̱du̱ u-Ru̱ ko-uyan su̱ u̱t-no̱me̱ se̱.&gt;&gt;<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>Biturus zu̱, &lt;&lt;Gwat, it yakke̱ ko-uyan remu̱ it dor-u̱t bo̱, ¿se̱di yan-o̱ it de̱ u̱t-kwu̱m?&gt;&gt;<verse eid="MAT 19:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;U̱m o̱ waru̱ no̱ u̱t-nip, da-u̱ o̱ haan, da-u̱ Wa'-u̱ Ne̱t do̱'e̱ u̱t-shu̱'u̱t u̱ pora-du̱ u̱r-faru̱k du̱ u̱t-fu̱'u̱bse̱ wa. No̱ do̱ru̱ me̱, no̱ do̱'e̱ u̱t-shu̱'u̱t u̱ pora-tu̱ u̱r-faru̱k tu̱ u̱t-rem o̱p-u̱t yu̱r, no̱ kwu̱pu̱ rem-tu̱ o̱p u̱ u̱t-yu̱r tu̱ Isra-ne̱ u̱s-rem. <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>Tu̱msu̱ wu̱ yage̱ u̱t-bu, ko̱ hu̱no-u̱t wa ne̱ ne̱ta-ne̱ ko̱ campa-ne̱, ko̱ u̱so-u wa u̱ ino-u wa ne̱ ko̱ yaag, ko̱ u̱t-tak, remu̱ wa o̱ do̱rru̱ me̱, wa de̱ u̱t-kwu̱m u-so u-tát, tu̱msu̱ wa de̱ kwu̱m-du̱ fat-du̱ za u̱r-ma. <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>Tu̱msu̱ ne̱t-ne̱ u-tát i o̱ u̱r-taku̱n, e̱ de̱ u̱t-mu̱ a u̱r-vaste̱, a u̱r-vaste̱ e̱ de̱ u̱t-shu̱'u̱t a u̱r-taku̱n.&gt;&gt;<verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">Sha-mu̱ u̱s-rem <optbreak/> mo̱t-tu̱ a-m-ank</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>Ye̱so̱ re shu̱ u̱t-zu̱, &lt;&lt;Faru̱k-du̱ u-ru̱ o̱ u̱ka wa-u-bu, wu̱ ruye̱ u̱r-wu̱n u̱r-wu̱n u̱ sa-u̱ i de̱ no̱mu̱ wa-m-ank-u̱ tak-u̱ inabi. <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>Da-u̱ e̱ ho̱ngu̱sse̱ u̱ no̱mu̱ wa do̱'e̱ u̱t-to̱p shik u̱r-hoot, se̱ wa tok u̱n u̱ tak-u̱ inabi.<verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>&lt;&lt;U̱s-kwam ko̱b-du̱ u-gan su̱ u̱r-wu̱n se̱ wa ru u̱ kat-du̱ u-tu̱rru̱, wa hyen e̱ke̱n u̱ shu̱'u̱t-du̱ m-zan. <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>Se̱ wa zu̱ u̱n, &lt;Haanu̱n no̱ do̱'e̱ u̱ tak-u inabi ri, me̱ to̱p-u̱ no̱ no̱m-u̱ kame̱.&gt; <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>E̱ yu̱ne̱ e̱ do̱'e̱.</para>
  <para style="p" vid="MAT 20:5">&lt;&lt;Se̱ wa do̱'e̱. Wa ru u̱ te̱k u-ho̱, tu̱msu̱ u̱s-kwam u̱s-tu̱t su̱ m-rim wa sur m-kab a-m-ank ne̱. <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>U̱ka u̱s-kwam u̱s-tan su̱ m-rim, wa ru, wa bit e̱ke̱n u̱ ees, e̱ za no̱m-du̱ o̱ko̱n da. Se̱ wa zu̱ u̱n, &lt;¿Remu̱ yan-o̱ wu̱te̱ no̱ no̱mu̱g m-ank u̱ ho̱-du̱ ya-o̱ da?&gt;<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>&lt;&lt;E̱ zu̱ wu̱n, &lt;Waku̱n yaag it no̱mu̱ u̱t-no̱m da.&gt;</para>
  <para style="p" vid="MAT 20:7">&lt;&lt;Se̱ wa zu̱ u̱n, &lt;No̱ko̱n ko̱no̱ m-ha u̱ tak-u inabi ri.&gt;<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>&lt;&lt;Da-u̱ rim-mu̱ tore̱, se̱ wa tak-u inabi wa zu̱ wu̱ o̱ se̱gu̱ wa ank-mu̱ u-tak, wa fag i o̱ no̱mu̱ wa-m-ank ne̱, wa to̱p e̱, tu̱msu̱ wa he̱e̱se̱ du̱gu̱ a m-vaste̱ m-ha a u̱r-taku̱n ne̱.<verse eid="MAT 20:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 20:9"/>&lt;&lt;Ne̱t-tu̱ haye̱ u̱ka u̱s-kwam u̱s-tan su̱ m-rim, kowan na top wa shik u̱ka ku̱mte̱ u̱ to̱p-u̱ u̱r-hoot. <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>Ne̱t-tu̱ haane̱ u̱r-taku̱n cu̱ng u̱zu̱ na de̱ to̱p-du̱ e̱ shik m-ze̱g o̱r-u̱t e̱ ne̱ i haane̱ m-rim, ko̱ ba shu̱'u̱te̱ iya kowan kwu̱ng no̱mu̱ kame̱ na to̱p wa u̱r-hoot. <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>Da-u̱ e̱ o̱nke̱, se̱ e̱ hu̱ no̱mu̱ wa-u-tak m-kwe̱ remu̱ zu̱ wa to̱po̱k e̱ ho̱n-ho̱n. <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>E̱ zu̱ wu̱n, &lt;Ne̱t-tu̱ haane̱ u̱-dim, ank-mu̱ u-da cashi mo̱ e̱ no̱me̱&gt; to̱p-u it u̱ e̱ne̱ u̱s-gan, it u̱ no̱me̱ m-ank, u̱ du̱ng-mu̱ u-ho̱ ne̱.<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>&lt;&lt;Se̱ wa zu̱ waku̱n u̱ te̱k-u̱ me̱ u̱n, &lt;Hu̱u̱b-u̱ ri, u̱m re̱e̱g ra-u ró da. U̱m zu̱u̱g iya remu̱ zu̱ yo cu̱ng u̱zu̱ me̱ to̱p-u̱ bo̱ shik no̱mu̱ na tope̱ u̱r-hoot. <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>Kab no̱m-u̱ o̱ u̱ ró bo̱ no̱k. Me̱ ke̱e̱re̱ u̱ jab-u̱ ri u̱m to̱p o̱r-u̱t ró ne̱ i haane̱ u̱ dim-u ró no̱m-u̱ u̱m to̱p-u̱ bo̱. <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>Me̱ keru̱ no̱m-du̱ no̱m-u̱ u̱m ke̱e̱re̱ u̱ jab-u̱ ri, u̱ no̱m-u̱ o̱ u̱ ri, ¿shu̱b-de̱ bo̱ o̱tte̱ u̱ remu̱ no̱m-u so̱-o̱ u̱m no̱me̱?&gt;<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>&lt;&lt;Iya o̱ hen, a m-vaste̱ de̱ u̱t-shu̱'u̱t a u̱r-taku̱n, a u̱r-taku̱n hen e̱ shu̱'u̱t a m-vaste̱.&gt;&gt;<verse eid="MAT 20:16"/></para>
  <para style="s1">Ye̱so̱ waru̱g mar-m wa</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mark 10:32-34</ref>; <ref loc="LUK 18:31-34">Ruka 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>Da-u̱ Ye̱so̱ u̱ a-doru̱ wa ne̱ o̱ m-ha u̱ Urusharima, se̱ wa nu̱k a-dor-ne̱ u̱-kit. Wa zu̱ u̱n, <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>&lt;&lt;Ho̱go̱n in do̱'e̱ u̱r-cwa u̱ Urusharima. Na de̱ yasu̱ Wa'-u̱ Ne̱t u̱ kom-tu̱ i-Yate̱ a-To̱o̱g-ne̱ u̱ a-ko̱se̱-tu̱ u-bo̱r ne̱. Tu̱msu̱ e̱ u̱t-kwu̱p u̱zu̱ na ho̱ wu̱n. <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>Tu̱msu̱ e̱ yasu̱ wu̱n u̱du̱ i za-Yahuda-ne̱ da, e̱ no̱mu̱ wu̱n rem-su̱ u̱s-ju̱ru̱m, e̱ no̱mu̱ wu̱n u̱s-ryap, e̱ tar wu̱n u-kan, tu̱msu̱ e̱ ho̱ wu̱n u̱ ho̱-du̱ u-tu̱tu̱rse̱ wa de̱ u̱r-yu̱ne̱.&gt;&gt;<verse eid="MAT 20:19"/></para>
  <para style="s1">Ko̱n-su̱ ino-u Yakubu <optbreak/> e̱ Yohanna</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mark 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>Se̱ ino-u Yakubu e̱ Yohanna ya'ag-u̱ Zabadi e̱ haan u̱du̱ Ye̱so̱. Wa he u̱t-jwu̱n u̱ shu̱ Ye̱so̱ wa kon wu̱n o̱ko̱n no̱m-o̱.<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>Ye̱so̱ zu̱ wu̱n, &lt;&lt;¿Yan-o̱ bo̱ u̱t-sa?&gt;&gt;</para>
  <para style="p" vid="MAT 20:21">Wa zu̱, &lt;&lt;U̱m o̱ ko̱n-u̱s ró, yage̱ yaag-u̱ ri ine̱ yu̱r u̱ shu̱'u̱t u̱ ane̱ u̱ be-du̱ m-sek-u̱ ró u̱r-kot u̱ bo̱ ne̱, wa-gan u̱ kom u̱t-cwa tu̱msu̱ wa-gan u̱ kom u̱r-beer.&gt;&gt;<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>Ye̱so̱ zu̱ Yakubu e̱ Yohanna, &lt;&lt;No̱ nak no̱m-u̱ no̱ o̱ u̱t-ko̱n da, ¿no̱ keru̱ swadu̱ ko̱b-du̱ u̱m de̱ u̱t-swa?&gt;&gt;</para>
  <para style="p" vid="MAT 20:22">E̱ zu̱, &lt;&lt;It u̱t-kere̱.&gt;&gt;<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;No̱ de̱ swadu̱ u̱r-ko̱b u̱ka u̱m do̱te̱ swadu̱ u̱r-ko̱b, se̱di mo̱t-tu̱ u̱r-shu̱'u̱t u̱ kom u̱s-cwa ri ko̱ kom u̱r-beer, U̱so-u ri wu̱ o̱ do̱m u-ru̱ wa o̱o̱ge̱ wa u̱t-ya. Wu̱na de̱ ya-du̱ be-u̱t to̱ u̱du̱ wu̱ wa cwane̱ u̱t-ya.&gt;&gt;<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>Da-u̱ a-dor o̱p i kuse̱ ho̱ge̱ u̱zu̱ Yakubu e̱ Yohanna no̱ng u̱r-shu̱t iya, e̱ hog ryab-u̱s u̱n sok. <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>Ye̱so̱ fak in be̱e̱t wa zu̱, &lt;&lt;No̱ nak ne̱t-tu̱ o̱ u̱r-faru̱k i za-Yahuda-ne̱ da, e̱ hog zwarru̱ ko̱su̱ e̱ u̱zu̱ e̱ o̱ u̱r-be̱b ne̱. Tu̱-shu̱ hog zwarru̱ ko̱se̱ u̱r-be̱b u̱du̱ i e̱ o̱tte̱ u̱r-faru̱k. <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>A no̱ no̱m u̱ka u̱n da. Remu̱ iya hen wu̱ u̱t-sa wa shu̱'u̱t yu̱-Yat-ya u̱-me̱ no̱, se̱ wa shu̱'u̱te̱ to̱k u̱du̱ o̱r-u̱t wa ne̱. <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>Tu̱msu̱ wu̱ u̱t-sa wa shu̱'u̱t yu̱-shu̱ u̱-me̱ no̱, wa shu̱'u̱te̱ to̱k. <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>Wa'-u̱ Ne̱t hagu̱n remu̱ na no̱m-tu̱ wa-m-ank da, se̱di remu̱ zu̱ wa no̱m-u̱t m-ank, wa yase̱ fat-u̱r wa remu̱ u̱kru̱ u̱t-ne̱t u-tát.&gt;&gt;<verse eid="MAT 20:28"/></para>
  <para style="s1">Po̱-ne̱ yu̱r kwu̱ng m-hyan</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mark 10:46-52</ref>; <ref loc="LUK 18:35-43">Ruka 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>Da-u̱ Ye̱so̱ u̱ a-doru̱ wa ne̱ de̱ yagu̱ bo̱-u̱ Yeriko, ban-du̱ u̱t-ne̱t dor u̱n. <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>Da-u̱ e̱ o̱o̱ge̱ u̱r-no̱k, e̱ke̱n po̱-ne̱ yu̱r o̱ shu̱'u̱t u̱ kit u-fu̱n. Da-u̱ e̱ ho̱ge̱ Ye̱so̱ o̱ aru̱k, se̱ e̱ yu̱ns u̱s-cwar e̱ zu̱, &lt;&lt;Wa-m-nap, Wa'-u̱ Dawuda! Ho̱g o̱n-u̱r it!&gt;&gt;<verse eid="MAT 20:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31"/>Ne̱t-tu̱ hagu̱sse̱ u̱n, u̱zu̱ u̱n ho̱o̱n u̱s-ram, E̱ sur m-jaku̱s u̱s-cwar e̱ zu̱, &lt;&lt;Wa-m-nap, Wa'-u̱ Dawuda! Ho̱g o̱n-u̱r it!&gt;&gt;<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>Ye̱so̱ ees, wa zu̱ u̱n, &lt;&lt;¿Yan-o̱ no̱ u̱t-sa u̱m no̱mu̱ no̱?&gt;&gt;<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>E̱ zu̱ wu̱n, &lt;&lt;Wa-m-nap, it u̱t-sa it kum m-hyan.&gt;&gt;<verse eid="MAT 20:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34"/>Remu̱ u̱r-o̱n, Ye̱so̱ tu̱m is-u̱ u̱n. Za rem, e̱ kum m-hyan, e̱ dor wu̱n.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">Cwa-du̱ Faru̱k-u̱ Urusharima</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>Da-u̱ Ye̱so̱ u̱ a-doru̱ wa ne̱ ha m-te Urusharima, u̱ bo̱-u̱ Bafaji u̱ dapu̱s Ro̱r-du̱ Te-su̱ Ze̱tun, Ye̱so̱ tom a-doru̱ wa yu̱r. <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>Wa zu̱ u̱n, &lt;&lt;Cwaan u̱ taas-u̱ o̱ u̱ shu̱ no̱, no̱ u̱t-hyan u-janka m-gag u̱ku̱n u̱ ya-u̱r wa ne̱, ustu̱n e̱ no̱ hatu̱n me̱. <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>A waku̱n u̱ shitu̱ no̱m-u̱ no̱ u̱t-no̱m, waru̱n wa u̱zu̱, &lt;Wa-m-nap wa u̱t-sa e̱,&gt; tu̱msu̱ wa de̱ yasu̱ no̱ e̱ za na-su̱ u-da.&gt;&gt;<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>Na no̱ng sin-se̱ u̱s-be̱e̱t remu̱ na shu̱u̱ste̱ no̱mu̱ wa-warru̱ rem-su̱ u-Ru̱ ware̱ u̱zu̱,<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>&lt;&lt;Waru̱ ne̱t-tu̱ bo̱-u̱ Urusharima,<note caller="+" style="f"><char style="fr" closed="false">21:5 </char><char style="ft" closed="false">U̱t-Girik: Zayon.</char></note></para>
  <para style="q1" vid="MAT 21:5">&lt;Gwatu̱n faru̱k-u̱ no̱ o̱ haan u̱du̱ no̱,</para>
  <para style="q2" vid="MAT 21:5">wa zatte̱ hu̱k-mu̱ u̱r-hi da.</para>
  <para style="q1" vid="MAT 21:5">Wa o̱ u̱r-no̱k u̱ do̱m u-janka,</para>
  <para style="q2" vid="MAT 21:5">Wa muute̱ hi-u̱r wa za o̱ko̱n, ya-du̱ u-janka wa nokte̱.&gt; &gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">21:5b </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ZEC 9:9">Ze̱ka 9:9</ref></char>.</note><verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>A-doru̱ Ye̱so̱ yu̱r no̱m u̱ka Ye̱so̱ war-tu̱ e̱. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>E̱ hatu̱n ya-du̱ u̱r-janka u-janka ne̱ u̱du̱ rò, e̱ su̱k kus-u̱t e̱ u̱ do̱m-u̱ u-janka u̱ ya-u̱r wa ne̱, wa du̱u̱s u̱ do̱m wa shu̱'u̱t u̱ do̱m-u̱ ya-du̱ u-janka. <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>U̱t-ne̱t u-tát e̱ hu̱ nu̱rgu̱sse̱ kus-u̱t e̱ u̱ do̱m-u̱ u-fu̱n, tu̱msu̱ e̱ke̱n getmu̱n fe̱-su̱ u̱s-te e̱ nu̱rgu̱sse̱ u̱ do̱m-u̱ u-fu̱n. <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>Ban-du̱ u̱t-ne̱t o̱ró u̱-shu̱ Ye̱so̱ tu̱msu̱ ban-du̱ u̱t-ne̱t i o̱ dim-u̱ rò be̱e̱t. E̱ jaku̱s u̱s-cwar, e̱ zu̱,</para>
  <para style="q1" vid="MAT 21:9">&lt;&lt;U̱t-vam u̱du̱ Wa'-u̱ Dawuda!</para>
  <para style="q2" vid="MAT 21:9">Nu-u so̱-o̱ u̱du̱ wu̱ haane̱</para>
  <para style="q1" vid="MAT 21:9">u̱ shin-m Yawe,</para>
  <para style="q2" vid="MAT 21:9">u̱t-vam u̱du̱ u-Ru̱</para>
  <para style="q1" vid="MAT 21:9">wu̱ o̱o̱ge̱ do̱m u-ru̱ u̱ zu̱ge̱ ko̱he̱ne̱!&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">21:9b </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 118:25-26">Se̱pV 118:25-26</ref>; <ref loc="PSA 148:1">148:1</ref></char>.</note><verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>Da-u̱ Ye̱so̱ cwaye̱ u̱ Urusharima, gwu̱z yu̱ne̱ u̱zu̱, &lt;&lt;¿Wana unwa?&gt;&gt;<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>Ne̱t-tu̱ o̱ do̱rru̱ Ye̱so̱ e̱ zu̱, &lt;&lt;Unwa o̱ wa-warru̱ rem-su̱ u-Ru̱ Ye̱so̱ du̱gu̱ Nazara u̱ Gariri.&gt;&gt;<verse eid="MAT 21:11"/></para>
  <para style="s1">Ye̱so̱ u̱ be-du̱ u̱r-shu̱'u̱t <optbreak/> du̱ Wa-ko̱-uyan</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mark 11:15-19</ref>; <ref loc="LUK 19:45-48">Ruka 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoha 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>Ye̱so̱ to u̱-me̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan wa buz a u̱t-o̱ u̱ a bab-du̱ u̱t-bisa ne̱ u̱-me̱, wa ju̱rgu̱sse̱ cu̱mu̱s-tu̱ a swasa-mu̱ shikne̱, u̱ no̱m-tu̱ u̱r-shu̱'u̱t-u̱ a bab-du̱ u̱t-gorop. <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;Rem-su̱ u-Ru̱ zu̱u̱g, &lt;Bu-u ri de̱ shu̱'u̱tu̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan,&gt;<note caller="+" style="f"><char style="fr" closed="false">21:13 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ISA 56:7">Isha 56:7</ref>; <ref loc="JER 7:11">Irmi 7:11</ref></char>.</note> se̱di no̱ mutte̱ o̱ be-du̱ pak-du̱ hyu̱w-ne̱!&gt;&gt;<verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>Ku̱na po̱-ne̱ u̱ ryam-ne̱ hatu̱n u̱du̱ rò u̱-me̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan, tu̱msu̱ wa yu̱ u̱n m-yar. <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>I-Yate̱ a-To̱o̱g-ne̱, u̱ a-ko̱se̱-tu̱ bo̱r-u̱t Mosa ne̱, hog u̱s-ryab da-u̱ e̱ hyane̱ no̱m-tu̱ m-shin tu̱ Ye̱so̱ no̱me̱, u̱ yaag ne̱ be̱e̱t e̱ o̱ u̱t-jar u̱-me̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan e̱ o̱ u̱t-zu̱, &lt;&lt;U̱t-vam u̱du̱ Wa'-u̱ Dawuda&gt;&gt; se̱ e̱ hog u̱s-ryab.<verse eid="MAT 21:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16"/>E̱ zu̱ wu̱n, &lt;&lt;¿Bo̱ ho̱k no̱m-u̱ ya'ag-u̱ ine̱ o̱ u̱t-zu̱?&gt;&gt;</para>
  <para style="p" vid="MAT 21:16">Ye̱so̱ shu̱s wa zu̱,</para>
  <para style="q1" vid="MAT 21:16">&lt;&lt;U̱, no̱ karu̱nte̱ no̱m-u̱ rem-su̱</para>
  <para style="q2" vid="MAT 21:16">u-Ru̱ ware̱ u̱zu̱,</para>
  <para style="q1" vid="MAT 21:16">&lt;Bo̱ iiste̱ u̱t-ya' u̱</para>
  <para style="q2" vid="MAT 21:16">ya'ag-u̱ re̱ke̱ ne̱ u̱ka</para>
  <para style="q1" vid="MAT 21:16">e̱ do̱te̱ vam-u̱t ró</para>
  <para style="q2" vid="MAT 21:16">u̱ka ku̱mte̱.&gt;<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 8:2">Se̱pV 8:2</ref></char>. (Ran-u̱ u̱t-Girik).</note> &gt;&gt;<verse eid="MAT 21:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17"/>Du̱gu̱ ku̱n se̱ wa yagu̱ u̱n, wa ru u̱ bo̱-u o̱. Wa do̱'e̱ u̱ Bataniya, wa roog u̱ku̱n.<verse eid="MAT 21:17"/></para>
  <para style="s1">Te-yu̱ gu̱u̱ste̱</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mark 11:12-14</ref>,<ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>Da-u̱ is gase̱ u̱r-wu̱n, wa o̱ u̱ mu̱u̱n u̱-me̱ u-bo̱, se̱ wa hog u̱s-me̱r. <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>Da wa hyane̱ yaku̱n te-ya u̱ kit u-fu̱n, se̱ wa do̱'e̱ u̱ kug-du̱ te-u ya, wa kwu̱ng o̱ko̱n da se̱ u̱t-ran. Wa zu̱ te-u ya, &lt;&lt;Bo̱ za u̱r-mat da m-mo̱mmo̱.&gt;&gt; Za rem te-yu̱ gu̱u̱s.<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>Da-u̱ a-doru̱ Ye̱so̱ hyane̱ iya, e̱ hu̱ mu̱rimmo̱ u-tát. E̱ zu̱, &lt;&lt;¿Re̱ o̱ te-yu̱ gu̱u̱ste̱ za rem inya?&gt;&gt;<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>Ye̱so̱ shu̱s wa zu̱, &lt;&lt;U̱m o̱ waru̱ no̱ u̱t-nip, a no̱ o̱ u̱ yadu̱ jab ne̱ tu̱msu̱ no̱ no̱ng u-sakna da ko̱ cashi, no̱ u̱t-no̱m no̱m-tu̱ ze̱ge̱ no̱mu̱ u̱m no̱mu̱ te-u inya. Tu̱msu̱ no̱ zu̱ ro̱r-u̱r yat-de̱ din-de̱, &lt;Yu̱ne̱ bo̱ he̱ u̱-me̱ m-sa,&gt; u̱t-shu̱'u̱t iya. <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>A no̱ no̱me̱ yadu̱ jab, no̱m-u̱ no̱ ko̱ne̱ u-Ru̱ u-be̱e̱t u̱ te̱k-u̱ u̱s-to̱o̱g, no̱ u̱t-kwu̱m.&gt;&gt;<verse eid="MAT 21:22"/></para>
  <para style="s1">Shu̱t-du̱ Be̱b-u̱r Ye̱so̱</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mark 11:27-33</ref>; <ref loc="LUK 20:1-8">Ruka 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>Da-u̱ Ye̱so̱ cwaye̱ u̱-me̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan, wa o̱ te̱k-u̱ u̱t-ko̱se̱, se̱ i-Yate̱ a-To̱o̱g-ne̱ u̱ u̱t-ne̱nge̱n ne̱, e̱ haan u̱du̱ rò. E̱ zu̱, &lt;&lt;¿Shin-m wan mo̱ bo̱ o̱tte̱ no̱m-du̱ no̱m-u̱t tun-to̱? ¿Tu̱msu̱ wana ya shin-m mo̱?&gt;&gt;<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>Se̱ Ye̱so̱ shu̱s wa zu̱, &lt;&lt;Ko̱ me̱, me̱ no̱mu̱ no̱ u̱r-shu̱t. A no̱ shase̱ shu̱t-u̱r ri, me̱ ware̱ no̱ ko̱ shin-m wan mo̱ u̱m o̱tte̱ no̱m-du̱ no̱m-u̱t tun-to̱. <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>¿Wana ya'e̱ Yohanna be̱b-du̱ u̱t-yu̱bu̱sse̱ m-bu̱? ¿Ru̱-o̱ ya'u̱ wu̱n ko̱ ne̱t-u̱ ya'u̱ wu̱n?&gt;&gt;</para>
  <para style="p" vid="MAT 21:25">U̱n hu̱ pama inan u̱ te̱k-u̱ u̱n u̱zu̱, &lt;&lt;A in zu̱ye̱ &lt;Du̱gu̱-du̱ u-Ru̱ de̱,&gt; wa zu̱, &lt;¿Remu̱ u-yan o̱ no̱ ya'ag jab-u̱ wu̱n da?&gt; <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>Tu̱msu̱ a in zu̱ye̱, &lt;Du̱gu̱-du̱ u̱t-ne̱t de̱,&gt; in o̱ ho̱g-du̱ gye̱r-u̱ no̱m-u̱ ne̱t-tu̱ de̱ no̱mu̱ na, remu̱ zu̱ ne̱t-tu̱ kabu̱g Yohanna wa-warru̱ rem-su̱ u-Ru̱ wa.&gt;&gt;<verse eid="MAT 21:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27"/>Se̱ e̱ zu̱ Ye̱so̱, &lt;&lt;It nak da.&gt;&gt;</para>
  <para style="p" vid="MAT 21:27">Ye̱so̱ zu̱ u̱n, &lt;&lt;U̱m za waru̱ no̱ ko̱ shin-m wan mo̱ u̱m o̱tte̱ no̱m-du̱ no̱m-u̱t tun-to̱ da.&gt;&gt;<verse eid="MAT 21:27"/></para>
  <para style="s1">Sha-mu̱ u̱s-rem su̱ yaag yu̱r</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>Ye̱so̱ zu̱ tu̱-shu̱ a-to̱o̱g u̱ tu̱-shu̱ u̱t-ne̱t ne̱, &lt;&lt;¿Yan-o̱ no̱ hyane̱? Na no̱ng yaku̱n campa-ya wu̱ o̱tte̱ yaag-u̱ campa-ne̱ yu̱r. Wa do̱'e̱ u̱du̱ wu̱ u̱r-taku̱n wa zu̱, &lt;Wa'-u̱ ri, yu̱ne̱ bo̱ do̱'e̱ u̱ tak-u̱ inabi u̱ ya-o̱.&gt;<verse eid="MAT 21:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 21:29"/>&lt;&lt;Wa'-u̱ rò zu̱, &lt;U̱m za m-ha da,&gt; a sure̱ m-wa'as wa sur m-dorog, wa hu̱.<verse eid="MAT 21:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 21:30"/>&lt;&lt;Se̱ u̱so u̱ do̱'e̱ u̱du̱ wu̱ u-yu̱ru̱mse̱, wa waru̱ wu̱n no̱m-u̱ wa ware̱ yu̱ wu̱ya. Se̱ wa'-u̱ wa zu̱, &lt;To̱, u-u̱so, me̱ u̱t-ha,&gt; se̱ wa gu̱gu̱m m-ha.<verse eid="MAT 21:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 21:31"/>&lt;&lt;U̱ te̱k-u̱ ya'ag-u̱ e̱ yu̱r ¿wana no̱me̱ no̱mu̱ u̱so u̱ u̱t-sa?&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">E̱ zu̱, &lt;&lt;Wa u̱r-taku̱n wa.&gt;&gt;</para>
  <para style="p" vid="MAT 21:31">Ye̱so̱ zu̱ u̱n, &lt;&lt;U̱m o̱ waru̱ no̱ u̱t-nip, a-o̱nku̱ shik-u̱ tar ne̱ u̱ a-u-as ne̱, e̱ ba-u̱ no̱ m-cwa u̱ faru̱k-du̱ u-Ru̱. <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>U̱m zu̱u̱g iya remu̱ zu̱ Yohanna wa-u̱t-yu̱bu̱sse̱ m-bu̱ haagu̱n wa o̱ ko̱su̱ no̱ fu̱n-u so̱-ya, no̱ yaag jab da. Se̱di a-o̱nku̱ shik-u̱ tar u̱ a-u-as ne̱ e̱ yaag u̱t-nip. Ko̱ ba no̱ hyane̱ iya, no̱ byu̱rgu̱n no̱ yage̱ u̱t-ba'as no̱ yu̱' jab u̱du̱ rò da.<verse eid="MAT 21:32"/></para>
  <para style="s1">Sha-mu̱ u̱s-rem su̱ <optbreak/> i se̱ge̱ ne̱ u-tak</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mark 12:1-12</ref>; <ref loc="LUK 20:9-19">Ruka 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>&lt;&lt;Se̱ke̱n sha-mu̱ rem-su̱ ya. Yaku̱n campa-ya wa no̱ng tak-u̱ inabi, wa gu̱nu̱s o̱ u-du̱nni, tu̱msu̱ wa no̱m be-du̱ no̱m-du̱ m-mu̱di mu̱ yaa-tu̱ inabi, tu̱msu̱ wa no̱m kur-u̱ wa-u̱r-e' u̱ do̱m. Se̱ wa yu̱' a-u̱r-to̱m-ne̱ se̱g-mu̱ tak-u inabi o̱, wa aru̱k m-ha u̱ o̱ko̱n dak-o̱. <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>Da da-u̱ re̱-du̱ tesse̱ teye̱, se̱ wa-to̱m waku̱n u̱ te̱k-u̱ to̱k-ne̱ rò, wa do̱'e̱ u̱du̱ i wa ya'e̱ se̱g-mu̱ u-tak, e̱ o̱ko̱n o̱gu̱r wa du̱ no̱m-tu̱ u-tak.<verse eid="MAT 21:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 21:35"/>&lt;&lt;I na ya ne̱ se̱g-mu̱ u-tak, e̱ maas to̱k-ne̱ wa, e̱ gapu̱r wa-gan, e̱ ho wa-gan, e̱ ju̱ru̱g wa-gan u̱t-ta'ar. <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>Se̱ wa sur m-to̱m e̱ke̱n to̱k-ne̱ m-ze̱g u̱r-taku̱n, na no̱mu̱ e̱ u̱ka na no̱m-tu̱ a u̱r-taku̱n. <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>Da tase̱ wa u-tak to̱m wa'-u̱ wa u̱du̱ u̱n. Wa zu̱, &lt;U̱m nak u̱zu̱ u̱ da-o̱ u̱n u̱t-ya wa m-ze̱g.&gt;<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>&lt;&lt;Da-u̱ i na ya se̱g-mu̱ u-tak hyane̱ wa'-u̱ wa-u-tak, se̱ e̱ zu̱ o̱ru̱t e̱, &lt;No̱nge̱! Wu̱ de̱ re̱-du̱ kwu̱m-tu̱ u-tak u̱ ya. Yagu̱n in ho̱ wu̱n, u̱ tak-u̱ shu̱'u̱t u̱ in.&gt; <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>Se̱ e̱ maas wu̱n, e̱ gu̱n wu̱n u̱-do̱ u̱ tak-u̱ inabi, e̱ ho wu̱n.<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>&lt;&lt;U̱ da-o̱, ¿a wa-u-tak mu̱ne̱ yan-o̱ wa de̱ no̱mu̱ i wa se̱ge̱ tak-u̱ inabi?&gt;&gt;<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>E̱ zu̱ wu̱n, &lt;&lt;Wa de̱ ho̱-du̱ ne̱t-u̱t yo̱-to̱ to̱. Wa ya' e̱ke̱n tak-u o̱, i de̱ ha yadu̱ wu̱n du̱ rò o̱gde̱ du̱ no̱m-tu̱ tak-u̱ inabi.&gt;&gt;<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;¿No̱ karu̱nte̱ no̱m-u̱ rem-su̱ u-Ru̱ ware̱ da:</para>
  <para style="q1" vid="MAT 21:42">&lt;&lt; &lt;Ta'ar-du̱ a u-ma ne̱ gu̱gme̱,</para>
  <para style="q2" vid="MAT 21:42">de̱ shu̱'u̱te̱ ta'ar-du̱</para>
  <para style="q1" vid="MAT 21:42">ze̱ge̱ u̱r-zwar du̱ u-ma.</para>
  <para style="q1" vid="MAT 21:42">Ru̱-o̱ no̱me̱ sin-se̱,</para>
  <para style="q2" vid="MAT 21:42">tu̱msu̱ no̱m-tu̱ m-shin to̱ u̱ na hyan&gt;<note caller="+" style="f"><char style="fr" closed="false">21:42 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 118:22-23">Se̱pV 118:22-23</ref></char>.</note>?<verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>&lt;&lt;Remu̱ iya, u̱m o̱ waru̱ no̱, na de̱ kab-du̱ faru̱k-du̱ u-Ru̱ du̱gu̱-du̱ no̱, na yasu̱ to̱ko̱n ne̱t-to̱ tu̱ de̱ no̱m-du̱ no̱m-tu̱ kame̱ tu̱ faru̱k-du̱ u-Ru̱. <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>Ko̱wana he̱ u̱ do̱m-u̱ ta'ar-u̱r re̱, de̱ cakmu̱ wa, tu̱msu̱ wa ta'ar-u̱r re̱ he̱ u̱ do̱m-u̱ wa de̱ namu̱ wa u̱ka m-hyu̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">21:44 </char><char style="ft" closed="false">Na samge̱ sin-se̱ u̱-me̱ to̱ko̱n Ran-tu̱ u̱r-taku̱n da, ho̱ngu̱sse̱ </char><char style="xt"><ref loc="LUK 20:18">Ruka 20:18</ref></char>.</note><verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>Da-u̱ i-Yate̱ a-To̱o̱g-ne̱ u̱ Farisa-ne̱ ho̱ge̱ sha-mu̱ u̱s-rem su̱ Ye̱so̱ ware̱, e̱ nu̱p u̱zu̱ u̱nu̱ wa o̱tte̱ u̱s-rem. <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>U̱n haan u̱n maas wu̱n, se̱di u̱n o̱ ho̱g-du̱ u-gye̱r, remu̱ zu̱ ne̱t-tu̱ kabu̱g wu̱n wa-warru̱ rem-su̱ u-Ru̱ wa.<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">Sha-mu̱ u̱s-rem su̱ <optbreak/> mo̱ro̱g-du̱ u̱r-gu̱</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>Ye̱so̱ sur m-no̱m sha-mu̱ u̱s-rem u̱zu̱, <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>&lt;&lt;Na hyanu̱ sha-mu̱ faru̱k-du̱ u-Ru̱ u̱ka waku̱n faru̱k wu̱ zo̱nge̱ no̱mu̱ wa'-u̱ wa mo̱ro̱g-du̱ u̱r-gu̱. <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>Wa tom to̱k-ne̱ rò e̱ fagu̱n ne̱t-tu̱ na bane̱ u̱ mo̱ro̱g-du̱ u̱r-gu̱, se̱di ne̱t-tu̱ na bane̱ haagu̱n da.<verse eid="MAT 22:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 22:4"/>&lt;&lt;Wa sur m-to̱m e̱ke̱n to̱k-ne̱ wa zu̱, &lt;Waru̱n ne̱t-tu̱ na bane̱ u̱zu̱, u̱m zo̱ngte̱ no̱m u̱t-re̱, na pu̱nu̱mte̱ na i m-se̱m. Na taaste̱ zo̱ngu̱ ko̱-uyan, haan u̱ u̱du̱ u̱r-mo̱ro̱g.&gt;<verse eid="MAT 22:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 22:5"/>&lt;&lt;Se̱di e̱ e̱re̱g da. E̱ aru̱k u̱ su̱ e̱, waku̱n aru̱k u̱ tak-u wa, waku̱n aru̱k u-tu̱rru̱. <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>Tu̱msu̱ e̱ke̱n maas to̱k-ne̱ e̱, e̱ pepu̱r e̱, na ho e̱. <verse eid="MAT 22:6"/><verse number="7" style="v" sid="MAT 22:7"/>Faru̱k hog u̱s-ryab sok. Wa tom karma-ne̱ wa ho̱rru̱sse̱ i ho̱ to̱k-ne̱ e̱, e̱ doos bo̱-u u̱n u-ra.<verse eid="MAT 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 22:8"/>&lt;&lt;U̱ da-u o̱ wa zu̱ to̱k-ne̱ wa, &lt;Na taaste̱ zo̱ngu̱ u̱r-mo̱ro̱g, se̱di i na bane̱ e̱ kamu̱g da. <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>Remu̱ iya, do̱ro̱n u̱s-fu̱n, no̱ waru̱ i no̱ hyane̱ be̱e̱t e̱ haan u̱ mo̱ro̱g-du̱ u̱r-gu̱.&gt; <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>To̱k-ne̱ e̱ dor u̱s-fu̱n e̱ kargu̱ssu̱n ne̱t-tu̱ e̱ kume̱, ne̱t-tu̱ u̱r-ka u̱ i za u̱r-ka ne̱, be-du̱ u̱r-mo̱ro̱g haan de̱ shi u̱t-ne̱t sok.<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>&lt;&lt;Da faru̱k cwane̱ wa hyan ne̱t-tu̱ haane̱, se̱ wa hyen waku̱n, wa wagu̱n to̱o̱go̱-yu̱ mo̱ro̱g-du̱ u̱r-gu̱ da. <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>Se̱ wa zu̱ ne̱tu̱ wa, &lt;Hu̱bu̱ ri, ¿re̱ o̱ bo̱ nomte̱ bo̱ cwatu̱n u̱ ane̱ za bo̱ wa to̱o̱go̱-yu̱ mo̱ro̱g-du̱ u̱r-gu̱?&gt; Ne̱tu̱ wa taag u̱ no̱m-u̱ wa de̱ u̱t-war.<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>&lt;&lt;Faru̱k zu̱ i o̱ no̱mu̱ wa-m-ank, &lt;Gu̱ksu̱n naas-u̱s rò, u̱t-kom ne̱, no̱ gun wu̱n u̱-do̱ u̱-me̱ u-cwu̱m, ku̱na wa do̱te̱ u̱s-kan u̱ ep-mu̱ jo-u ne̱.&gt; &gt;&gt;<verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>Ye̱so̱ zu̱, &lt;&lt;Ru̱-u̱ fak u̱t-ne̱t u-tát, se̱di ne̱t-to̱ cashi i wa dage̱.&gt;&gt;<verse eid="MAT 22:14"/></para>
  <para style="s1">To̱p-du̱ shik-u̱ tar u̱du̱ Sisar</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mark 12:13-17</ref>; <ref loc="LUK 20:20-26">Ruka 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>Da-u̱ Ye̱so̱ zu̱ye̱ iya, Farisa-ne̱ do̱'e̱ e̱ do̱ro̱g u̱ka e̱ do̱te̱ no̱mu̱ wu̱n u̱r-re̱n u̱ remu̱ no̱mu̱ wa ware̱. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>Se̱ e̱ to̱mo̱n a-doru̱ u̱n u̱r-kot u̱ ne̱t-u̱t Here̱ ne̱. E̱ zu̱, &lt;&lt;Wa-u̱t-ko̱se̱, it nak bo̱ o̱ m-shu̱p u̱t-nip ne̱, tu̱msu̱ bo̱ o̱ no̱mu̱ na ko̱se̱-tu̱ fu̱n-yu̱ u-Ru̱ te̱k-u̱ u̱t-nip. It zu̱u̱g iya remu̱ zu̱ ne̱t-to̱ u̱s-gan u̱du̱ ró, tu̱msu̱ bo̱ ko̱ste̱ m-ku̱u̱k da. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>Waru̱ it u̱zu̱, ¿Yan-o̱ bo̱ zu̱ye̱, no̱ng u̱r-zwar na to̱p shik-u̱ tar u̱du̱ Kaisar Faru̱k, ko̱ ana to̱p da?&gt;&gt;<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>Ba shu̱'u̱te̱ u̱zu̱ Ye̱so̱ nak no̱m-u̱ u̱n u̱t-sa, se̱ wa zu̱ u̱n, &lt;&lt;No̱ a-ha-mu̱ u̱r-no̱ ne̱! ¿Remu̱ u-yan o̱ no̱ o̱tte̱ no̱mu̱ me̱ m-re̱ge? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>Ko̱su̱n me̱ shik i na topte̱ tar.&gt;&gt; Se̱ e̱ haatu̱n wu̱n ko̱nko̱ shik. <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>Se̱ wa zu̱ u̱n, &lt;&lt;¿Ryu̱n-u wan o̱? Tu̱msu̱ ¿dim-u̱r wande̱ u̱ ane̱?&gt;&gt;<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>E̱ shu̱s e̱ zu̱, &lt;&lt;Kaisar wa.&gt;&gt;</para>
  <para style="p" vid="MAT 22:21">Se̱ Ye̱so̱ zu̱, &lt;&lt;Na ya' Sisar no̱m-u̱ o̱ u̱ wa, tu̱msu̱ no̱ ya' u-Ru̱ no̱m-u̱ o̱ u-Ru̱.&gt;&gt;<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>Da-u̱ e̱ ho̱ge̱ iya, e̱ ship u̱t-nu e̱ hu̱ mu̱rimmo̱. E̱ yagu̱ wu̱n, e̱ aru̱k.<verse eid="MAT 22:22"/></para>
  <para style="s1">U̱r-gu̱ u̱ ho̱-du̱ <optbreak/> yu̱ne̱-du̱ marimari ne̱</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mark 12:18-27</ref>; <ref loc="LUK 20:27-40">Ruka 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>U̱ ho̱-u̱r re̱ hen, e̱ke̱n Saduki-ne̱ haan u̱du̱ Ye̱so̱. U̱na zu̱ye̱ yu̱ne̱-du̱ marimari ne̱ zarra. E̱ shit wu̱n. <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>E̱ zu̱, &lt;&lt;Wa-u̱t-ko̱se̱, Mosa zu̱u̱g, &lt;A ne̱tu̱ mare̱ wa kwu̱mu̱g wa' da, ka u̱t-no̱m zarra, se̱ hu̱no-u wa gaag ne̱ta-u ya u̱ remu̱ wa kwu̱m-tu̱ wa yaag.&gt;<note caller="+" style="f"><char style="fr" closed="false">22:24 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 25:5-6">Muut 25:5-6</ref></char>.</note> <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>E̱ke̱n o̱ro u̱ te̱k-u̱ it, campa-ne̱ ta'er ya'ag-u̱ wa-gan. Wa u̱r-taku̱n no̱ng u̱r-gu̱ wa haan wa mu̱r za wa', wa yaksu̱ hu̱no-u wa ne̱ta. <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>Ganse̱ tu̱msu̱ u̱ wu̱ u-yu̱ru̱mse̱, u̱ u-tu̱tu̱rse̱ ne̱ m-te̱ wa u-ta'er. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>Da-u̱ e̱ mu̱rme̱ be̱e̱t, ne̱ta-u ya mu̱r ko̱wa. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>U̱ da-o̱, u̱ ho̱-du̱ yu̱ne̱-du̱ marimari ne̱, ¿ne̱ta wana wa de̱ u̱t-shu̱'u̱t remu̱ zu̱ ne̱t-ne̱ ta'er gaag wa?&gt;&gt;<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>Ye̱so̱ shu̱s wa zu̱, &lt;&lt;Dorog-u̱s no̱ za ho̱n-ho̱n da, remu̱ zu̱ no̱ nak rem-su̱ u-Ru̱ su̱ o̱ m-pan da, tu̱msu̱ no̱ nak shin-mu̱ o̱ u̱ se̱ da. <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>Da-u̱ yu̱ne̱-du̱ marimari ne̱, ne̱t-tu̱ za re̱-du̱ shu̱ no̱m-du̱ u̱r-gu̱ u̱-me̱ dak-u uno̱ da, tu̱msu̱ ne̱ta-ne̱ za ha-mu̱ u̱r-gu̱ da, ne̱t-tu̱ de̱ u̱t-shu̱'u̱t u̱ka a-u̱s-to̱m u-Ru̱ ne̱. <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>Tu̱msu̱ u̱ mo̱t-tu̱ yu̱ne̱-du̱ marimari ne̱, ¿no̱ karu̱nte̱ no̱m-u̱ Ru̱-u̱ waru̱ no̱ da? Na panu̱g u̱zu̱, <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>&lt;Me̱ wa o̱ Ru̱-u̱ Ibrahi, Ru̱-u̱ Ishaku tu̱msu̱ Ru̱-u Yakubu.&gt;<note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="ft" closed="false">Rwu̱u̱ 3:6.</char></note> Wu̱n Ru̱-u̱ a u̱r-fat ne̱ o̱ za marimari ne̱ da.&gt;&gt;<verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>Da-u̱ ne̱t-tu̱ ho̱ge̱ iya, e̱ hu̱ mu̱rimmo̱ u̱ remu̱ ko̱se̱-u̱t Ye̱so̱.<verse eid="MAT 22:33"/></para>
  <para style="s1">Bo̱r-yu̱ zege̱</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mark 12:28-34</ref>; <ref loc="LUK 10:25-28">Ruka 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>Da Farisa-ne̱ ho̱ge̱ u̱zu̱ Saduki-ne̱ taagte̱ u̱ no̱m-u̱ e̱ de̱ shasu̱ Ye̱so̱, se̱ Farisa-ne̱ mo̱ro̱g u̱r-be u̱r-gan. <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>Waku̱n wa ko̱se̱-tu̱ bo̱r-u̱t Mosa u̱ te̱k-u̱ me̱ u̱n, wa no̱m u̱r-shu̱t remu̱ wa reg-u̱t Ye̱so̱.<verse eid="MAT 22:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 22:36"/>Wa zu̱, &lt;&lt;Wa-u̱t-ko̱se̱, ¿yan bo̱r-ya zege̱ u̱ te̱k-u̱ me̱ bo̱r-u̱t Mosa?&gt;&gt;<verse eid="MAT 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37"/>Ye̱so̱ shu̱s wa zu̱, &lt;&lt; &lt;Cwan u-Ru̱ Yawe u̱ jab-u̱ ró ne̱ be̱e̱t, u̱ fat-u̱r ró ne̱ be̱e̱t, u̱ dorog-u̱s ró ne̱ be̱e̱t.&gt;<note caller="+" style="f"><char style="fr" closed="false">22:37 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DEU 6:5">Muut 6:5</ref></char>.</note> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>Inya ya o̱o̱ge̱ bo̱r-u yat-ya tu̱msu̱ yu̱ ze̱ge̱ u̱r-zwar. <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>Bo̱r-yu̱ u-yu̱ru̱mse̱ yu̱ zege̱ u̱r-zwar ya o̱ u̱s-gan u̱ yu̱ u̱r-taku̱n ne̱, &lt;Bo̱ cwan wa-bo̱ru̱ ró u̱ka bo̱ o̱tte̱ cwan-tu̱ hi-u̱r ró.&gt;<note caller="+" style="f"><char style="fr" closed="false">22:39 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="LEV 19:18">To̱o̱g 19:18</ref></char>.</note> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>Ko̱se̱-u̱t Mosa u̱t-be̱e̱t u̱ a-warru̱ rem-su̱ u-Ru̱ ne̱, to̱ rwu̱gu̱n u̱-me̱ bo̱r-u̱t tun-to̱ u̱t-yu̱r.&gt;&gt;<verse eid="MAT 22:40"/></para>
  <para style="s1">¿Wa'-u̱ wana Kiristi?</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mark 12:35-37</ref>; <ref loc="LUK 20:41-44">Ruka 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>Da Farisa-ne̱ mo̱rge̱ u̱r-be u̱r-gan, se̱ Ye̱so̱ shit u̱n, <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>wa zu̱, &lt;&lt;¿Yan-o̱ dorog-u̱s no̱ u̱ mo̱t-u̱t Kiristi? ¿Wa'-u̱ wana?&gt;&gt;</para>
  <para style="p" vid="MAT 22:42">E̱ zu̱ wu̱n, &lt;&lt;Wa'-u̱ Dawuda.&gt;&gt;<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;¿Re̱-o̱ Dawuda u̱ te̱k-u̱ Yar u-Ru̱ fogte̱ wu̱n Wa-ko-uyan ri? U̱m zu̱u̱g iya remu̱ zu̱ Dawuda zu̱u̱g,<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>&lt;&lt; &lt;Yawe zu̱u̱g Wa-ko-uyan ri,</para>
  <para style="q2" vid="MAT 22:44">Shu̱'u̱te̱ u̱ ane̱ u̱ be-du̱ m-sek du̱ kom u̱t-cwa ri,</para>
  <para style="q1" vid="MAT 22:44">Se̱ u̱m re̱e̱g u̱r-ko̱rro̱ du̱ hu̱u̱b-u̱t yo̱-to̱ ró</para>
  <para style="q2" vid="MAT 22:44">u̱ ta u̱s-na ró.&gt;<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 110:1">Se̱pV 110:1</ref></char>.</note> &gt;&gt;<verse eid="MAT 22:44"/></para>
  <para style="m">
    <verse number="45" style="v" sid="MAT 22:45"/>&lt;&lt;A Dawuda zu̱ Kiristi &lt;Wa-ko-uyan&gt; ¿Re̱ o̱ Kiristi shu̱'u̱te̱ wa'-u̱ rò?&gt;&gt; <verse eid="MAT 22:45"/><verse number="46" style="v" sid="MAT 22:46"/>Waku̱n kerge̱ shas-du̱ Ye̱so̱ da. Du̱gu̱ ho̱-u̱r re̱ waku̱n swu̱ru̱g m-kwu̱m be̱b-du̱ no̱mu̱ wu̱n de̱ku̱n shu̱t-de̱ da.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">Him-u̱t Ye̱so̱ u̱du̱ a-ko̱se̱-tu̱ <optbreak/> u-bo̱r ne̱ u̱ Farisa-ne̱</para>
  <para style="r">(<ref loc="MRK 12:38-40">Mark 12:38-40</ref>; <ref loc="LUK 11:37-52">Ruka 11:37-52</ref>; <ref loc="LUK 20:45-47">20:45-47</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>Da-u̱ ne̱t-tu̱ mo̱rge̱ u-tát u̱ a-doru̱ wa ne̱, se̱ Ye̱so̱ zu̱ u̱n, <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>&lt;&lt;A-ko̱se̱-tu̱ bo̱r-u̱t Mosa u̱ Farisa-ne̱ e̱ na ya'e̱ be̱b-du̱ no̱m-du̱ ko̱se̱-u̱t Mosa. <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>Remu̱ iya, no̱mu̱n be̱e̱t no̱m-u̱ u̱n o̱ is-u̱ no̱. A no̱ no̱m u̱ka u̱n o̱tte̱ u̱t-no̱m da, remu̱ zu̱ u̱n nom-u̱t no̱m-tu̱ u̱n o̱ u̱t-war da. <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>E̱ su̱k cwu̱-tu̱ m-no, tu̱ zatte̱ ku̱k-mu̱ u̱t-kab da, e̱ saku̱ ne̱t-ne̱ to̱ u̱t-kap, se̱di u̱n u̱ hi-du̱ war u̱n, u̱n za keru̱ wadu̱ ko̱ u-jow u̱n no̱m u̱r-se̱ge̱ da.<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>&lt;&lt;U̱n nom pama-u̱s u̱n u̱s-be̱e̱t remu̱ ne̱t-ne̱ vom-u̱t u̱n. Hi-du̱ rem-u̱s se̱ ya: u̱n o̱ gag-du̱ fe̱-u̱s yat-se̱ su̱ rem-su̱ u-Ru̱ u̱ po̱ng-u̱t u̱n u̱ka u̱r-du̱pu̱r. U̱n o̱ wadu̱ bar-su̱ m-randi u̱ to̱ggo̱-u̱s u̱n. <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>E̱ ton na ya' u̱n be-u̱t so̱-to̱ tu̱ be-tu̱ u̱r-mo̱ro̱g u̱ be-tu̱ m-sek ne̱ u̱-me̱ bu-u̱ u̱t-ko̱se̱ u̱ Yahuda-ne̱. <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>Tu̱msu̱ e̱ ton na ha vu̱k-su̱ u̱n u̱-me̱ u-tu̱rru̱, na ha fag-du̱ u̱n, &lt;Wa-m-nap.&gt;<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>&lt;&lt;No̱ hen, ana zu̱ no̱ &lt;Wa-m-nap da&gt; remu̱ wa-m-nap-u̱ no̱ wa-gan wa, no̱ hen ganse̱ no̱ o̱ye̱ u̱ka u̱t-hu̱no, campa-ne̱ u̱ ne̱ta-ne̱. <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>A no̱ zu̱ waku̱n &lt;u-u̱so&gt; u̱ dak-u uno̱ da, remu̱ zu̱ U̱so-u no̱ o̱ u-gan, wu̱ o̱ do̱m u-ru̱. <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>Tu̱msu̱ ana fag no̱ &lt;Yu̱-shu̱ da&gt; remu̱ zu̱ yu̱-shu̱ ya u-gan no̱ o̱tte̱, wato Kiristi. <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>Ne̱t be̱e̱t wu̱ u̱t-sa u̱ Ru̱-u̱ nya wa u̱r-o̱g, yage̱ wa shu̱'u̱t wa no̱mu̱ no̱ m-to̱k. <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>Wu̱ kabu̱ hi-u̱r wa o̱ko̱n, na de̱ mutu̱ wa m-zan. Tu̱msu̱ wu̱ mutu̱ hi-u̱r wa m-zan, wa de̱ kwu̱m-du̱ m-sek.<verse eid="MAT 23:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>&lt;&lt;Se̱di no̱m-tu̱ u̱r-o̱n to̱, u̱du̱ a-ko̱se̱-tu̱ bo̱r-u̱t Mosa, u̱ Farisa-ne̱! No̱ a-ha-mu̱ u̱r-no̱ ne̱! No̱ beeste̱ u-is yu̱ cwa-du̱ faru̱k-du̱ do̱m u-ru̱, tu̱msu̱ no̱ cwaag da, tu̱msu̱ no̱ o̱ ho-su̱ a cwan-tu̱ u̱r-cwa ne̱ u̱r-cwa.<note caller="+" style="f"><char style="fr" closed="false">23:13 </char><char style="ft" closed="false">To̱ko̱n ran-to̱ swu̱ru̱g fe̱-yu̱ 14, </char><char style="fqa" closed="false">No̱m-tu̱ u̱r-o̱n u̱du̱ no̱ a-ko̱se̱-tu̱ u-bo̱r ne̱ u̱ Farisa-ne̱. A-ha-mu̱ u̱r-no̱, a-za m-'e̱ i re ra-u̱ bomos-ne̱ tu̱msu̱ e̱ ton e̱ no̱m to̱o̱g-su̱ m-wu̱r u̱ shu̱ u̱t-ne̱t. Remu̱ iya, na de̱ yadu̱ no̱ u̱r-ko̱b sok. </char><char style="ft" closed="false">Ho̱ngu̱sse̱ Mark 12:40 tu̱msu̱ Ruka 20:47.</char></note> <verse eid="MAT 23:13"/><verse number="14" style="v" sid="MAT 23:14"/>No̱m-tu̱ u̱r-o̱n u̱du̱ a-ko̱se̱-tu̱ bo̱r-u̱t Mosa, u̱ Farisa-ne̱ u̱ a-ha-mu̱ u̱r-no̱ ne̱! No̱ o̱ re̱-du̱ cwu̱-tu̱ bomos-ne̱, tu̱msu̱ no̱ o̱ to̱o̱g-su̱ m-wu̱r u̱ remu̱ na hyan no̱. Remu̱ iya hen no̱ de̱ swadu̱ u̱r-ko̱b u-tát.<verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>&lt;&lt;No̱m-tu̱ u̱r-o̱n u̱du̱ a-ko̱se̱-tu̱ bo̱r-u̱t Mosa, u̱ Farisa-ne̱. No̱ a-ha-mu̱ u̱r-no̱ ne̱! No̱ pu̱s m-sa, no̱ te bo̱-tu̱ m-ra remu̱ sa-u wa-gan wu̱ de̱ do̱rru̱ ko̱se̱-u̱t no̱. A no̱ kume̱ wa, se̱ no̱ muut wa, wa bu-u u-ra m-ze̱g no̱ u-so u-yu̱r.<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>&lt;&lt;No̱m-tu̱ u̱r-o̱n u̱du̱ no̱, no̱ o̱ u̱ka po̱-ne̱ i u̱t-sa dor-tu̱ ne̱t-ne̱ u-fu̱n! No̱ zu̱, &lt;O̱ko̱n zarra a ne̱t-u̱ to̱n-de̱ u̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan u-Ru̱, se̱di wu̱ to̱n-de̱ u̱ ta'ar-tu̱ m-baku̱t ne̱ tu̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan, se̱ wa no̱ng no̱m-u̱ wa to̱n-de̱ u̱zu̱ wa u̱t-no̱m.&gt; <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>No̱ rag-ne̱, no̱ o̱ u̱ka po̱-ne̱! Ta'ar-tu̱ m-baku̱t tu̱ o̱ u̱-me̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan to̱ o̱ so̱-to̱, se̱di be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan ze̱k u̱r-zwar, remu̱ zu̱ u̱-me̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan o̱ cinte̱ ta'ar-tu̱ m-bak-u̱t tu̱ to̱ u̱-kit remu̱ ank-mu̱ u-Ru̱. <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>No̱ zu̱, &lt;Wu̱ to̱n-de̱ u̱ be-du̱ to̱o̱g-ne̱, o̱ko̱n zarra, se̱di wu̱ to̱n-de̱ u̱ be-du̱ ya-du̱ to̱o̱g ne̱, se̱ wa no̱mu̱g no̱m-u̱ wa zu̱ wa u̱t-no̱m.&gt; <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>No̱ o̱ u̱ka po̱-ne̱! To̱o̱g-du̱ na nomte̱ to̱o̱g de̱ so̱-de̱, se̱di sak-du̱ na nomte̱ to̱o̱g de̱ ze̱k u̱r-zwar, remu̱ zu̱ u̱ do̱m-u̱ u̱r-sak de̱ na nomte̱ to̱o̱g, remu̱ ank-mu̱ u-Ru̱. <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>Remu̱ iya, wu̱ to̱n-de̱ u̱r-sak ne̱, wa to̱ndu̱te̱ u̱ de̱ ne̱, tu̱msu̱ wa to̱ndu̱te̱ u̱ ko-uyan ne̱ u̱ o̱ do̱m u̱r-sak. <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>Tu̱msu̱ wu̱ to̱n-de̱ u̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan ne̱, wa to̱ndu̱te̱ u̱ o̱ ne̱, tu̱msu̱ u-Ru̱ ne̱ wu̱ o̱ u̱ shu̱'u̱t u̱-me̱ o̱. <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>Wu̱ to̱n-de̱ u̱ do̱m u-ru̱ ne̱, wa to̱ndu̱te̱ u̱ pora-du̱ faru̱k-du̱ u-Ru̱ ne̱, tu̱msu̱ u̱ wu̱ o̱ shu̱'u̱t u̱ do̱m-u̱ pora re̱.<verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>&lt;&lt;No̱m-tu̱ u̱r-o̱n u̱du̱ a-ko̱se̱-tu̱ bo̱r-u̱t Mosa, u̱ Farisa-ne̱! No̱ a-ha-mu̱ u̱r-no̱ ne̱! No̱ haatu̱n o̱g-du̱ u-Ru̱ u̱ te̱k-u̱ o̱p u̱ no̱m-tu̱ u̱s-cwa, u̱ka, zangarri, ran-tu̱ u-zwu̱u̱n ne̱, u̱t-ryu̱mb ne̱, se̱di no̱ yakke̱ no̱m-tu̱ ze̱ge̱ u̱r-zwar u̱ te̱k-u̱ me̱ u̱t-bo̱r, to̱ o̱: no̱m-du̱ no̱m-u̱t so̱-to̱ u̱du̱ u̱t-ne̱t, u̱r-o̱n, u̱ yadu̱ jab ne̱. Tun-to̱ kame̱ u̱zu̱ no̱ no̱m, a no̱ yage̱ to̱ko̱n no̱m-to̱ da. <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>No̱ o̱ u̱ka po̱-ne̱ i u̱t-sa dor-tu̱ ne̱t-ne̱ u-fu̱n, no̱ pu̱st no̱m-i u̱r-fat u̱-me̱ m-bu̱ taas no̱ cwar-ya da, se̱di no̱ tor u-rakum.<note caller="+" style="f"><char style="fr" closed="false">23:24 </char><char style="ft" closed="false">Gwat To̱o̱g 11:4,23.</char></note><verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>&lt;&lt;No̱m-tu̱ u̱r-o̱n u̱du̱ a-ko̱se̱-tu̱ bo̱r-u̱t Mosa, u̱ Farisa-ne̱! No̱ a-ha-mu̱ u̱r-no̱ ne̱! No̱ jaas dim u-ko̱k, se̱di u̱ me̱n-tu̱ me̱, o̱ shu̱u̱g u̱ cwan-tu̱ m-jigin ne̱, u̱ ko̱b-du̱ e'-du̱ u̱r-hi ne̱. <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>No̱ po̱ Farisa-ne̱, jaasu̱n me̱n-tu̱ me̱ u-ko̱k u-ro, u̱ka do̱ do̱te̱ u̱t-shu̱'u̱t u̱ so̱-o̱ ko̱ o̱.<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>&lt;&lt;No̱m-tu̱ u̱r-o̱n u̱du̱ a-ko̱se̱-tu̱ bo̱r-u̱t Mosa, u̱ Farisa-ne̱! No̱ a-ha-mu̱ u̱r-no̱ ne̱! No̱ shu̱'u̱te̱ u̱ka sag-tu̱ na wa'e̱ rwab-u pus-o̱, u̱ zwarru̱ m-hyan u̱-do̱, se̱di me̱, se̱ shar-tu̱ ne̱t-tu̱ mare̱ m-jigin ne̱ u̱t-go̱ u̱t-go̱. <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>Iya o̱ hen no̱ o̱tte̱, u̱-do̱ ne̱t-tu̱ hen no̱ u̱ka ne̱t-tu̱ jab-u̱s so̱-se̱, se̱di u̱ me̱n-tu̱ me̱, se̱ ha-mu̱ u̱r-no̱, u̱ no̱m-u̱t yo̱-to̱ ne̱.<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>&lt;&lt;No̱m-tu̱ u̱r-o̱n u̱du̱ a-ko̱se̱-tu̱ bo̱r-u̱t Mosa, u̱ Farisa-ne̱! No̱ a-ha-mu̱ u̱r-no̱ ne̱! No̱ mu̱ sag-u̱t so̱-to̱ u̱ remu̱ a-warru̱ rem-su̱ u-Ru̱ ne̱, tu̱msu̱ no̱ no̱mu̱ sag-tu̱ ne̱t-tu̱ jab-u̱s so̱-se̱ u̱t-u̱k. <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>No̱ zu̱, &lt;U̱zu̱ it o̱o̱g u̱ da-u̱ i mate̱ u̱so-u̱t it, it za se̱gu̱ u̱n ho̱-du̱ a-warru̱ rem-su̱ u-Ru̱ ne̱ da.&gt; <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>Iya o̱ no̱ ko̱ste̱ u̱zu̱ no̱ o̱ ya'ag-u̱ i ho̱ a-warru̱ rem-su̱ u-Ru̱ ne̱. <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>No̱ shu̱'u̱te̱ u̱ka i zo̱nge̱ ho̱-du̱ u̱t-ne̱t, u̱ka i mate̱ u̱so-u̱t no̱ o̱tte̱.<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>&lt;&lt;No̱ fa, No̱ yagu̱ ko̱ko̱s! ¿Re̱ no̱ do̱te̱ ku̱s-mu kwu̱p-du̱ u̱s-rem su̱ cwa-du̱ bu-u u-ra? <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>Remu̱ iya, u̱m de̱ to̱mtu̱n no̱ a-warru̱ rem-su̱ u-Ru̱ ne̱, u̱ a-m-nap ne̱, u̱ a-ko̱se̱-tu̱ ne̱. No̱ de̱ ho̱-du̱ e̱ke̱n, no̱ tar e̱ke̱n u-kan, tu̱msu̱ no̱ no̱mu̱ e̱ke̱n u̱s-ryap u̱-me̱ bu-u̱ u̱t-ko̱se̱ u̱ Yahuda-ne̱, no̱ o̱ do̱rru̱ u̱n u̱t-bo̱ u̱t-bo̱. <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>Ru̱-u̱ de̱ yadu̱ no̱ u̱r-ko̱b, remu̱ zu̱ no̱ ho̱o̱g ne̱t-tu̱ jab-u̱s so̱-se̱ ne̱ be̱e̱t u̱-me̱ dak-u uno̱. No̱m-u̱ no̱ no̱me̱ o̱ u̱t-mu̱u̱n u̱ hi-u̱r no̱, i mare̱ ne̱ du̱gu̱ da-u Habira wa jab-u̱ so̱-o̱ m-ha u̱ Zakariya wa'-u̱ Berekiya, wu̱ no̱ ho̱ye̱ u̱ te̱k-u̱ be-du̱ u-he̱n u̱r-sak ne̱. <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>U̱m o̱ waru̱ no̱ u̱t-nip, sin-se̱ u̱s-be̱e̱t na no̱mu̱ se̱ u̱-me̱ ne̱t-tu̱ uno̱ da-o̱.<verse eid="MAT 23:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>&lt;&lt;Ku̱s! Urusharima, no̱ a ho̱-du̱ a-warru̱ rem-su̱ u-Ru̱ ne̱, a ju̱rgu̱ i na to̱mne̱ ne̱ u̱du̱ no̱. U̱m saag u̱m kargu̱sse̱ no̱ u̱ka ku̱u̱t-yu̱ kargu̱sse̱ ya'at wa u̱ kap-u̱t wa, se̱di no̱ gu̱gu̱mte̱. <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>U̱ da-o̱ hen na yaku̱ste̱ no̱ bo̱-u no̱ za waku̱n. <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>U̱m o̱ waru̱ no̱, no̱ za tu̱msu̱ hyan-du̱ me̱ da, se̱ ho̱-du̱ no̱ zu̱ye̱, &lt;Kom-u̱ u-Ru̱ u̱du̱ wu̱ haane̱ u̱-te̱k dim-u̱r Yawe.&gt;<note caller="+" style="f"><char style="fr" closed="false">23:39 </char><char style="ft" closed="false">Se̱pV 118:26.</char></note> &gt;&gt;<verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">Nap-su̱ da-u̱ m-vaste̱</para>
  <para style="r">(<ref loc="MRK 13:1-13">Mark 13:1-13</ref>; <ref loc="LUK 21:5-19">Ruka 21:5-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>Ye̱so̱ ru du̱gu̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan. Wa o̱ te̱k-u̱ u̱r-no̱k, se̱ a-dor waru̱ wa, zwarru̱ ma-u̱t to̱ u-tát tu̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>Se̱ wa shit u̱n wa zu̱, &lt;&lt;No̱ hyang tun-to̱ ma-to̱, u̱m o̱ waru̱ no̱ u̱t-nip, na za yage̱ u̱r-ta'ar u̱ do̱m-u̱ u̱r-ta'ar da. To̱ u̱t-he̱ u̱t-be̱e̱t.&gt;&gt;<verse eid="MAT 24:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>Ye̱so̱ o̱ shu̱'u̱t u̱ do̱m-u̱ Ro̱r-du̱ Te-su̱ Ze̱tun, se̱ a-doru̱ wa haan e̱ war'e̱. E̱ zu̱, &lt;&lt;Waru̱ it, ¿mu̱ne̱ o̱ na de̱ no̱m-du̱ no̱m-u̱t tun-to̱? ¿Tu̱msu̱ re̱-o̱ nap-su̱ haan-u̱r ró, u̱ ma-du̱ u-da ne̱?&gt;&gt;<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>Ye̱so̱ shu̱s wa zu̱: &lt;&lt;No̱mo̱n ga', a waku̱n u̱ e̱ngu̱sse̱ no̱ u̱ remu̱ no̱mu̱ de̱ u̱t-no̱m da. <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>Remu̱ ne̱t-tu̱ de̱ rwu̱u̱n u-tát e̱ zu̱ u̱m yaag e̱ shin-m ri, e̱ de̱ u̱t-zu̱, &lt;Me̱ o̱ Kiristi.&gt; E̱ de̱ e̱ngu̱sse̱ ne̱t-ne̱ u-tát. <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>No̱ de̱ ho̱g-du̱ rem-su̱ m-gag, u̱ u-na zu̱ ne̱ u̱ m-gag. A no̱ ho̱g u-gye̱r da, remu̱ zu̱ o̱ko̱n za u̱t-hoos da, se̱di vaste̱-mu̱ no̱ng da u-ro. <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>Dak-u̱ de̱ yu̱nsu̱ m-gag m-ha o̱ko̱n dak-o̱, tu̱msu̱ faru̱k-du̱ yu̱ns m-gag m-ha de̱ku̱n faru̱k de̱. Na de̱ no̱m-du̱ u̱s-me̱r u̱ ru̱mu̱s-du̱ u-dak ne̱ to̱ko̱n dak-to̱ u̱t-go̱ u̱t-go̱. <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>Se̱di se̱ u̱s-be̱e̱t taku̱n-du̱ swa-u̱ u̱r-ko̱b de̱.<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>&lt;&lt;Na de̱ yasu̱ no̱ u̱du̱ swadu̱ u̱r-ko̱b, tu̱msu̱ na ho̱ no̱. Ne̱t-tu̱ u̱t-dak u-be̱e̱t e̱ de̱ gu̱g-mu̱ no̱ remu̱ zu̱ no̱ o̱ a-doru̱ ri. <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>Tu̱msu̱ u̱t-ne̱t u-tát e̱ de̱ yage̱ yadu̱ jab-u̱ e̱ u̱du̱ ri. E̱ yasu̱ o̱r-u̱t e̱, tu̱msu̱ e̱ gu̱gu̱m o̱r-u̱t e̱. <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>A-warru̱ rem-su̱ u-Ru̱ ne̱ i u̱s-bi ne̱ e̱ de̱ rwu̱n u-tát, e̱ e̱ngu̱sse̱ u̱t-ne̱t u-tát. <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>Remu̱ tat-u̱ no̱m-u̱t yo̱-to̱, cwan-u̱t e̱ke̱n o̱ no̱mu̱ o̱r-u̱t e̱ de̱ u̱t-hab. <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>Se̱di wu̱ eese̱ u̱r-be̱b ne̱ m-te̱ u̱r-ma, wa de̱ kwu̱m-du̱ u-u̱ku̱r. <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>Tu̱msu̱ na de̱ do̱nse̱-du̱ Rem-u̱s sin-se̱ su̱ m-Re̱me̱r su̱ faru̱k-du̱ u-ru̱ remu̱ u̱s-nap u-me̱ u-dak u-be̱e̱t, kanda vaste̱-mu̱ no̱m.<verse eid="MAT 24:14"/></para>
  <para style="r">(<ref loc="MRK 13:14-23">Mark 13:14-23</ref>; <ref loc="LUK 21:20-24">Ruka 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>&lt;&lt;Se̱di kanda vaste̱-mu̱ no̱m, da-u̱ no̱m-tu̱ m-'e̱ tu̱ de̱ naasu̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan to̱ u̱t-wa u̱t-ne̱t e̱ yage̱ o̱, to̱ u̱ ees u̱-me̱ Bu-u̱ u̱s-to̱o̱g. Wa-warru̱ rem-su̱ u-Ru̱ Daniyer waru̱g tu̱msu̱ wa pu̱n se̱ m-tumb ne̱. Yage̱ wa-m-karu̱nte̱ wa nap. <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>Ne̱t-tu̱ o̱ gwu̱g-du̱ Yahudiya, e̱ de̱ so̱m-mu̱ rutu̱ u̱r-hi m-ha u̱t-ro̱r. <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>Wu̱ o̱ do̱m-u̱ go̱nt-du̱ u-kur, a wa zu̱, &lt;Yage̱ u̱m cu̱zu̱n u̱m kab o̱ko̱n u-bu kanda m-so̱m da.&gt; <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>Wu̱ o̱ u-tak, a wa mu u̱zu̱ wa kabu̱n kus-u̱ u̱t-ho̱po̱s wa da. <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>No̱m-tu̱ u̱r-o̱n u̱du̱ ne̱ta-ne̱ o̱tte̱ u̱t-me̱n, u̱ i o̱ u̱r-wu̱ru̱g ne̱ u̱ da-u̱ o̱. <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>No̱mo̱n u̱s-to̱o̱g taas so̱mu̱-m mo̱ shu̱'u̱t u̱ da-u̱ u-go̱s ko̱ u̱ ho̱-du̱ u̱r-hure̱ da. <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>U̱ da-u o̱, na de̱ no̱m-du̱ de̱ku̱n swa-u̱ u̱r-ko̱b de̱, du̱ na tame̱ u̱t-no̱m da, du̱gu̱ taku̱n-du̱ dak-u uno̱ u̱ haan u̱ da-o̱, tu̱msu̱ na za u̱t-swu̱r m-no̱m go̱-du̱ o̱ da. <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>U̱zu̱ na habu̱g u̱t-ru̱t da, waku̱n zaar wu̱ de̱ kwu̱n-du̱ u-u̱ku̱r da. Se̱di remu̱ ne̱t-tu̱ na dage̱ Ru̱-u̱ de̱ hab-du̱ u̱t-ho̱. <verse eid="MAT 24:22"/><verse number="23" style="v" sid="MAT 24:23"/>U̱ da-u o̱, ko̱ wana zu̱ no̱, &lt;Gwat Kiristi ya&gt; ko̱ &lt;Wa ya' jit&gt; a no̱ ya' jab da. <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>Remu̱ zu̱, e̱ke̱n de̱ yu̱ne̱ e̱ zu̱ e̱ haagu̱n u̱ shin-m Kiristi, u̱ a-warru̱ rem-su̱ u-Ru̱ ne̱ i u̱s-bi, e̱ no̱m no̱m-tu̱ m-shin u-tát u̱ remu̱ e̱ e̱ngu̱sse̱ u̱t-ne̱t, a mu̱ne̱ u̱t-no̱me̱, ko̱ i Ru̱-u̱ dage̱ na e̱ngu̱sse̱ e̱. <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>Me̱ he̱n u̱m o̱ waru̱ no̱ kanda da-u̱ no̱m.<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>&lt;&lt;Remu̱ iya, ana zu̱ no̱, &lt;Gwat, Kiristi ya jit u̱r-do̱g,&gt; A no̱ rwu̱n da. Ana zu̱ no̱, &lt;Wa ya' jit u̱ yase̱ u̱-me̱ kur-u̱ me̱,&gt; A no̱ ya' jab da. <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>U̱ka no̱ hyente̱ yak-u̱t yu̱ nomte̱ m-zu̱n du̱gu̱ u-do̱m m-cu̱z u-ta, iya o̱ haan-du̱ Wa'-u̱ ne̱t do̱te̱ u̱t-shu̱'u̱t. <verse eid="MAT 24:27"/><verse number="28" style="v" sid="MAT 24:28"/>Be-du̱ u-du̱ o̱tte̱, ku̱na sag-ra mo̱ro̱gte̱.<verse eid="MAT 24:28"/></para>
  <para style="s1">Haan-du̱ Wa'-u̱ Ne̱t</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mark 13:24-27</ref>; <ref loc="LUK 21:25-28">Ruka 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>&lt;&lt;Za naas u-da, da-u̱ ho̱-tu̱ swa-u̱ u̱r-ko̱bu̱ to̱ arke̱,</para>
  <para style="q1" vid="MAT 24:29">&lt;&lt; &lt;Ho̱-du̱ de̱ no̱m-du̱ u-cwu̱m,</para>
  <para style="q2" vid="MAT 24:29">pyat-yu̱ za no̱m-du̱ m-zu̱n da,</para>
  <para style="q1" vid="MAT 24:29">Re̱ge̱r de̱ hemu̱n du̱gu̱ u-ru̱,</para>
  <para style="q2" vid="MAT 24:29">tu̱msu̱ na de̱ ru̱m-su̱</para>
  <para style="q1" vid="MAT 24:29">faru̱k-tu̱ do̱m u-ru̱.&gt;<note caller="+" style="f"><char style="fr" closed="false">24:29 </char><char style="ft" closed="false">Gwat Isha 13:10; 34:4; Jowe̱r 2:10.</char></note><verse eid="MAT 24:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 24:30"/>&lt;&lt;U̱ da-u o̱ nap-su̱ Wa'-u̱ Ne̱t de̱ u̱t-ko̱se̱ u̱ do̱m u-ru̱. Ne̱t-tu̱ u-dak u-be̱e̱t e̱ de̱ u̱s-kan u̱ remu̱ u-gye̱r. E̱ de̱ hyan-du̱ Wa'-u̱ Ne̱t u̱ haan u̱-me̱ u̱r-ku̱u̱t, m-shin ne̱ u̱ m-sek ne̱ u-tát.<note caller="+" style="f"><char style="fr" closed="false">24:30 </char><char style="ft" closed="false">Gwat Dan 7:13.</char></note> <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>Wa de̱ to̱mnu̱ a-to̱mu̱ wa du̱gu̱ do̱m u-ru̱, e̱ fur u-kar yu̱ u̱t-wan sok. E̱ de̱ kargu̱sse̱ ne̱t-tu̱ na dage̱ du̱gu̱ u-do̱m u̱ u-ta ne̱ u̱ m-ereg ne̱ u̱ kom u̱t-cwa u̱ kom u̱r-beer ne̱, du̱gu̱ din-de̱ ma-du̱ u-dak ne̱ m-ha de̱ku̱n ma-du̱ u-dak de̱.<verse eid="MAT 24:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>&lt;&lt;Isu̱n o̱ko̱n du̱gu̱ sin-se̱ sha-mu̱ u̱s-rem su̱ te-yu̱ u-baab: Da-u̱ fe̱-u̱s wa he̱e̱se̱ u̱t-baru̱m, se̱ o̱ rwu̱tu̱n ran-u̱t po-to̱, napu̱n u̱zu̱ go̱s-u̱ teegu̱n. <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>Iya o̱ hen, a no̱ hyane̱ no̱m-u̱t tun-to̱ u̱t-be̱e̱t tu̱ u̱m waru̱ no̱, napu̱n u̱zu̱ da-u̱ no̱ng, u̱ bo̱ndu̱ u-is. <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>U̱m o̱ waru̱ no̱ u̱t-nip, ne̱t-tu̱ uno̱ da-o̱ za m-mar da, se̱ no̱m-u̱t tun-to̱ u̱t-be̱e̱t to̱ no̱ng. <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>Do̱m u-ru̱ u-dak ne̱ to̱ u̱t-ta, se̱di rem-u̱s ri za u̱t-ta ko̱ cashi.<verse eid="MAT 24:35"/></para>
  <para style="s1">U̱r-ho̱ u-da ne̱ u̱ na nape̱ da</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mark 13:32-37</ref>; <ref loc="LUK 17:26-30">Ruka 17:26-30</ref>,<ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>&lt;&lt;Se̱di waku̱n nak u̱r-ho̱ ko̱ u-da, da-u̱ no̱m-u̱t to̱ de̱ u̱t-no̱m da, ko̱ a-to̱m u-Ru̱ i o̱ do̱m u-ru̱, ko̱ Wa se̱di u-U̱so wa u-gan. <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>U̱ka na nomte̱ u̱ ho̱-u̱t Nuhu, iya o̱ do̱te̱ u̱t-shu̱'u̱t u̱ ho̱-tu̱ haan-du̱ Wa'-u̱ Ne̱t. <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>U̱ka na nomte̱ u̱ da-u o̱, kanda yu̱-u u-hat, na o̱ u-re̱, na o̱ u̱t-swa, campa-ne̱ o̱ u̱t-gu̱, tu̱msu̱ na o̱ hu̱tu̱ ne̱ta-ne̱ u̱t-gu̱, m-te̱ da-u̱ Nuhu cwa u̱-me̱ u-hat. <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>Kanda e̱ nu̱pu̱t no̱m-u̱ o̱ u̱ te̱k, yu̱-u yat-o̱ hagu̱n u̱ koos-tu̱ u̱n be̱e̱t. Iya o̱ mu̱u̱n-du̱ Wa'-u̱ Ne̱t do̱te̱ u̱t-shu̱'u̱t. <verse eid="MAT 24:39"/><verse number="40" style="v" sid="MAT 24:40"/>U̱ da-u o̱, ne̱t-ne̱ yu̱r, e̱ o̱ u-tak na de̱ kab-du̱ wa-gan na yage̱ wa-gan. <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>Ne̱ta-ne̱ yu̱r e̱ o̱ u̱r-na u̱r-kot, Ru̱-u̱ de̱ kab-du̱ wa-gan wa yage̱ wa-gan.<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>&lt;&lt;Remu̱ iya, shu̱'u̱tu̱n u̱s-zo̱ng ne̱, remu̱ no̱ nak ho̱-du̱ Wa-ko-uyan de̱ mu̱u̱n da. <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>Se̱di napu̱n, u̱zu̱ wa u-bu do̱'e̱ nap-du̱ ho̱-du̱ hyu̱w de̱ haan m-gyu̱p, wa za roogte̱ da, tu̱msu̱ wa za u̱t-yage̱ na cwa wa u-bu da. <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>Remu̱ iya, shu̱'u̱tu̱n u̱s-zo̱ng ne̱, remu̱ da-u̱ no̱ wa wa' jab da, da-u o̱ Wa'-u̱ Ne̱t de̱ haan.<verse eid="MAT 24:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>&lt;&lt;To̱k-u̱ u̱r-ka tu̱msu̱ wa u̱s-ve̱r, wa o̱ wu̱ wa-u-bu wa ya'u̱ wa gwa-tu̱ wa u-bu, wa o̱ hen u̱ yadu̱ to̱k-ne̱ kuse̱ no̱m u̱t-re̱ u̱ da-u̱ kame̱. <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>No̱m-tu̱ u̱r-so̱ to̱ u̱du̱ to̱k wu̱ wa-u-bu haane̱ wa bit wa u̱ no̱m-du̱ no̱mu̱ na wu̱te̱ wa. <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>U̱m o̱ waru̱ no̱ u̱t-nip, wa de̱ wadu̱ to̱ku̱ wa gwa-tu̱ cwu̱-u̱t wa u̱t-be̱e̱t. <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>Jiya to̱k-ne̱ yo̱-o̱ wa, wa de̱ u̱t-zu̱, &lt;Wa-u-bu ri tumbtu̱n.&gt; <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>Se̱ wa he̱e̱se̱ gapru̱ hu̱u̱b-tu̱ m-ank-u̱ wa, wa o̱ u-re̱ u-swa ne̱ u̱r-kot u̱ a u-swa ne̱. <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>A to̱k-u̱ wa no̱me̱ iya, wa-u-bu rò de̱ mu̱u̱n za napu̱r rò tu̱msu̱ u̱ ho̱-du̱ wa nape̱ da. <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>Wa-u-bu de̱ vu̱du̱ wu̱n sok, tu̱msu̱ wa de̱ gwu̱n-du̱ wu̱n be-du̱ na gunte̱ a-ha-mu̱ u̱r-no̱ ne̱. Ku̱na wa do̱te̱ u̱s-kan u̱ ep-mu̱ jo-u ne̱.<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">Sha-mu̱ u̱s-rem su̱ ya-u̱t-gwu̱p <optbreak/> o̱p i nape̱ campa-ne̱ da</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>&lt;&lt;Faru̱k-du̱ u-ru̱ de̱ o̱ u̱ka ya-u̱t-gwu̱p o̱p i nape̱ campa-ne̱ da i kabe̱ hitirra-u̱s e̱. E̱ nok u̱ bu-u̱ gwu̱p u̱r-gu̱ u̱ e'-du̱ campa u̱r-gu̱. <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>Ya-u̱t-gwu̱p tan u̱ te̱k-u̱ u̱n, e̱ zatte̱ u̱s-ve̱r da, tan hene e̱ o̱ u̱s-ve̱r ne̱. <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>Da-u̱ ya-u̱t-gwu̱p tan i za u̱s-ve̱r kabe̱ hitirra-u̱s e̱, e̱ kabu̱g m-no̱o̱g mu̱ u̱t-swu̱r da. <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>I o̱tte̱ u̱s-ve̱r hen, e̱ kabu̱g mo̱ko̱n no̱o̱g-mo̱ u̱-me̱ u̱r-kub u̱ hitirra-u̱s e̱ ne̱. <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>Campa u̱r-gu̱ teegu̱n m-byanne̱ da, e̱ be̱e̱t e̱ hu̱ degem-tu̱ m-roog, a tase̱ e̱ deku̱s m-roog.<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>&lt;&lt;U̱ te̱k-u̱ m-gyu̱p sok, na fog u̱zu̱ na rwu̱u̱n, &lt;Campa u̱r-gu̱ ya, rwu̱nu̱n na gu wa!&gt;<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>&lt;&lt;Ku̱na ya-u̱t-gwu̱p-u̱ e̱ o̱p i nape̱ campa-ne̱ da yu̱nte̱ e̱ mang hitirra-u̱s e̱. <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>Ya-u̱t-gwu̱p i za u̱s-ve̱r zu̱ i o̱ u̱s-ve̱r ne̱, &lt;Ke̱re̱n it no̱o̱g-m no̱ cashi. Hitirra-u̱s it u̱t-sa m-mar.&gt;<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>&lt;&lt;I o̱tte̱ u̱s-ve̱r zu̱ u̱n, &lt;No̱o̱g-m mo̱ zaru̱ ko̱ru̱ in u̱r-kot da, se̱di no̱ko̱n u̱ be-du̱ na bu̱bte̱ no̱ o̱o̱n.&gt;<verse eid="MAT 25:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 25:10"/>&lt;&lt;Da-u̱ e̱ ruye̱ u̱ remu̱ e̱ o̱o̱tu̱n m-no̱o̱g, kanda e̱ mu̱u̱n campa u̱r-gu̱ te̱e̱n. Ne̱t-tu̱ zo̱nge̱ hen e̱ to̱ u̱ campa u̱r-gu̱ ne̱ u̱du̱ u̱r-gu̱, se̱ to̱k u-bu tage̱ u-is.<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>&lt;&lt;Da wase̱, se̱ ya-u̱t-gwu̱p-u̱ e̱ mu̱u̱n, e̱ zu̱, &lt;Wa-u-bu, Wa-u-bu, up-su̱ it u-is.&gt;<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>&lt;&lt;Se̱ campa u̱r-gu̱ zu̱, &lt;U̱m o̱ waru̱ no̱ u̱t-nip, u̱m nak no̱ da!&gt;<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>&lt;&lt;Remu̱ iya, shu̱'u̱tu̱n u̱s-zo̱ng ne̱ remu̱ mu̱u̱n-u̱r ri, remu̱ no̱ nak u̱r-ho̱ ko̱ u-da da.<verse eid="MAT 25:13"/></para>
  <para style="s1">Sha-mu̱ u̱s-rem su̱ to̱k-ne̱ tu̱t</para>
  <para style="r">(<ref loc="LUK 19:11-27">Ruka 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>&lt;&lt;Faru̱k-du̱ u-Ru̱ o̱ u̱ka ne̱t wu̱ de̱ no̱m-du̱ m-ha, se̱ wa fog to̱k-ne̱ wa, wa mo̱-tu̱ u̱n shik. <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>Wa yasu̱ wa-gan ba-tu̱ shik u̱t-tan,<note caller="+" style="f"><char style="fr" closed="false">25:15 </char><char style="ft" closed="false">Ba-du̱ u̱r-gan o̱tte̱ tat-u̱ shik-u̱ to̱p-u̱ ank-mu̱ ne̱t mu̱ u̱s-hak u̱s-yu̱r.</char></note> wa-gan na yasu̱ wa ba-tu̱ shik u̱t-yu̱r, tu̱msu̱ wa-gan ba-du̱ u̱r-gan, kowan u̱ka wa do̱te̱ u̱t-kere̱. Se̱ wa aru̱k. <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>Wu̱ na yase̱ ba-tu̱ shik u̱t-tan, za rem wa do̱'e̱ wa hu̱ u-cerpa u̱ e̱, wa kum bu̱-mu̱ u̱t-ba u̱t-tan. <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>Iya o̱ hen wu̱ na yase̱ ba-tu̱ u̱t-yu̱r ko̱wa wa kum bu̱-mu̱ ba-tu̱ shik u̱t-yu̱r. <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>Se̱di wu̱ na yase̱ u-gan, wa do̱'e̱ wa-ku̱w u̱r-kub u-dak wa yase̱ ba-du̱ shik-u̱ wa-u-bu wa.<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>&lt;&lt;Da-u̱ tumbe̱, se̱ wa-u-bu u̱ to̱k-ne̱ wa e̱ mu̱u̱n, remu̱ wa got no̱m-u̱ e̱ kume̱ u̱ shik-u̱ e̱. <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>Se̱ wu̱ kabe̱ ba-tu̱ shik u̱t-tan, wa haan wa hatu̱n to̱ko̱n tan-to̱ wa zu̱, &lt;Wa-u-bu, bo̱ yaste̱ me̱ ba-tu̱ shik u̱t-tan. E̱ ya u̱m kwu̱ng bu̱-mu̱ to̱ko̱n ba-to̱ u̱t-tan.&gt;<verse eid="MAT 25:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 25:21"/>&lt;&lt;Se̱ wa-u-bu rò zu̱ wu̱n, &lt;No̱nge̱, to̱k-u̱ so̱-wa, bo̱ no̱ng u̱r-ka u̱ no̱m-u re̱k-o̱. U̱m de̱ yasu̱ bo̱ u̱ zege̱ uno̱, haane̱ bo̱ no̱m u̱r-so̱ u̱r-kot u̱ me̱ ne̱.&gt;<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>&lt;&lt;Wu̱ kabe̱ ba-tu̱ shik u̱t-yu̱r, wa haan wa zu̱, &lt;Wa-u-bu, bo̱ yaste̱ me̱ ba-tu̱ shik u̱t-yu̱r. E̱ ya u̱m kwu̱mu̱g bu̱-mu̱ to̱ko̱n yu̱r-to̱.&gt;<verse eid="MAT 25:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 25:23"/>&lt;&lt;Se̱ wa-u-bu zu̱ wu̱n, &lt;No̱nge̱ to̱k-u̱ so̱-wa, bo̱ no̱ng u̱r-ka u̱ no̱m-u̱ re̱k-o̱. U̱m de̱ yasu̱ bo̱ u̱ zege̱. Haane̱ bo̱ no̱m u̱r-so̱ u̱r-kot u̱ me̱ ne̱.&gt;<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>&lt;&lt;Wu̱ kabe̱ ba-du̱ shik u̱r-gan, wa haan wa zu̱, &lt;Wa-u-bu, u̱m nak waku̱n goot nu-u̱r ró da, bo̱ nom ket u̱ be-du̱ bo̱ kawe̱ da. Bo̱ kargu̱sse̱ u̱ be-du̱ bo̱ u̱s-te̱ go̱ da. <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>De̱ wu̱te̱ u̱m hog-u̱t u-gye̱r, u̱m ku̱w u̱r-kub u-dak u̱m yase̱ ba-du̱ shik-u̱ de̱. O̱nko̱ shik-u̱ ró.&gt;<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>&lt;&lt;Se̱ wa-u-bu rò shu̱s wa zu̱ to̱k-u̱ wa, &lt;Bo̱ ne̱t-u̱ yo̱-o̱ wa bo̱ o̱ye̱ za u̱r-ka, bo̱ nak u̱zu̱ u̱m nom ket be-du̱ u̱m kawe̱ da, tu̱msu̱ u̱m kargu̱sse̱ be-du̱ u̱m a se̱ go̱ da. <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>U̱zu̱ bo̱ wagu̱ me̱ shik-u̱ u̱-me̱ be-du̱ u̱r-cu̱n, a u̱m mu̱ne̱ u̱m o̱nk shik-u̱ ri m-swu̱r ne̱.<verse eid="MAT 25:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 25:28"/>&lt;&lt; &lt;Remu̱ iya o̱nko̱n ba-du̱ shik-u̱ de̱ u̱du̱ rò, yasu̱n wa ba-tu̱ shik u̱t-o̱p. <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>Remu̱ zu̱ wu̱ o̱tte̱ u-no̱m wa na de̱ u̱t-swu̱re̱, u̱ wa kum u-tát. Wu̱ zatte̱ o̱ko̱n da, ko̱ cashi u̱ wa o̱tte̱ na de̱ u̱t-o̱nk. <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Kabu̱n to̱k-u̱ yo̱-wa unwa, no̱ gun u̱-do̱ u̱-me̱ u-cwu̱m. Ku̱na wa do̱te̱ u̱s-kan u̱ ep-mu̱ jo-u ne̱.&gt;<verse eid="MAT 25:30"/></para>
  <para style="s1">Ca u̱ gwaar ne̱</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>&lt;&lt;Da-u Wa'-u̱ Ne̱t de̱ haan, u̱-me̱ sek-m wa u̱r-kot u̱ a-to̱mu̱ wa ne̱ be̱e̱t, da-u o̱ wa de̱ u̱t-shu̱'u̱t u̱ pora-du̱ u̱r-faru̱k wa. <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>Na de̱ kargu̱sse̱ ne̱t-tu̱ u̱t-dak u̱t-be̱e̱t u̱du̱ wa. Wa de̱ mo̱t-du̱ e̱ u̱t-go̱ u̱t-go̱ u̱ka wa-u̱t-got motte̱ ca u̱ me̱n-tu̱ gwaar. <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>Wa de̱ cu̱n-du̱ ca u̱ kom u̱s-cwa wa, gwaar hen u̱ kom u̱r-beer.<verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>&lt;&lt;Se̱ Faru̱k de̱ u̱zu̱ i o̱ kom u̱s-cwa wa, &lt;Haanu̱n no̱ i U̱so-u ri wa'e̱ nu-u so̱-o̱, no̱ cwa faru̱k-du̱ u-Ru̱ du̱ wa zo̱nge̱ no̱ du̱gu̱ taku̱n-du̱ u-dak. <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>U̱m zu̱u̱g iya remu̱ zu̱, da-u̱ u̱m o̱ ho̱g-du̱ u̱s-me̱r, no̱ yaag me̱ no̱m u̱t-re̱. Tu̱msu̱ u-swaat no̱ yu̱' me̱ bu̱-mu̱ u̱t-swa. U̱m o̱ u̱r-hamu̱t no̱ cwatu̱n me̱. <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>U̱m zatte̱ cwu̱-tu̱ u̱t-wa da, no̱ yu̱' me̱ to̱. U̱m zatte̱ m-yar da, no̱ got me̱. U̱m o̱ bu-u̱ m-to̱k, no̱ haan u̱ hyan-du̱ me̱.&gt;<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>&lt;&lt;Du̱gu̱ ku̱n a-jab-u̱s so̱-se̱ ne̱ de̱ u̱t-zu̱, &lt;Wa-ko-uyan, ¿mu̱ne̱ it hyane̱ bo̱ u̱s-me̱r it ye' bo̱ no̱m u̱t-re̱? ¿Ko̱ bo̱ o̱ ho̱g-du̱ u-swaat it ye' bo̱ bu̱-mu̱ u̱t-swa? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>¿Mu̱ne̱ o̱ it hyane̱ bo̱ u̱r-hamu̱t it cwatu̱n bo̱, ko̱ bo̱ o̱ za cwu̱-tu̱ u̱t-wa it yu̱' bo̱? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>¿Tu̱msu̱ mu̱ne̱ o̱ it hyane̱ bo̱ za m-yar ko̱ u̱-me̱ bu-u̱ m-to̱k it haan u̱ hyan-du̱ bo̱?&gt;<verse eid="MAT 25:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 25:40"/>&lt;&lt;Faru̱k de̱ u̱t-zu̱, &lt;U̱m o̱ waru̱ no̱ u̱t-nip, ba shu̱'u̱te̱ no̱ no̱ngu̱ wa-gan u̱ te̱k-u̱ o̱r-u̱t ri, wu̱ re̱k-wa, me̱ wa no̱ no̱me̱.&gt;<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>&lt;&lt;Da-u̱ o̱ wa de̱ zu̱ i o̱ kom u̱r-beer, &lt;Hatu̱n u̱ ane̱, no̱ ne̱t-tu̱ Ru̱-u̱ wa'e̱ u-nu. Cwan u̱-me̱ u-ra u̱ na za u̱t-kere̱ u̱t-ryu̱m da m-mo̱mmo̱, u̱ na zo̱nge̱ faru̱k-u̱ no̱m u̱s-te u̱ a-to̱mu̱ wa ne̱. <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>U̱m zu̱u̱g iya remu̱ zu̱, da-u̱ u̱m o̱o̱ge̱ u̱s-me̱r, no̱ yaag me̱ no̱m u̱t-re̱ da. U̱m o̱ ho̱g-du̱ u-swaat no̱ yaag me̱ bu̱-mu̱ u̱t-swa da. <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>U̱m o̱ u̱r-hamu̱t, no̱ cwatu̱n me̱ da. U̱m zatte̱ cwu̱-tu̱ u̱t-wa da, no̱ yaag me̱ da. U̱m no̱ng ko̱b-du̱ m-yar, tu̱msu̱ u̱m o̱ bu-u̱ m-to̱k, no̱ hagu̱n u̱ hyan-du̱ me̱ da.&gt;<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>&lt;&lt;Iya o̱ hen e̱ do̱te̱ u̱t-zu̱, &lt;Wa-ko-uyan, ¿mu̱ne̱ o̱ it hyane̱ bo̱ u̱ ho̱g-du̱ u̱s-me̱r, ko̱ u-swaat m-bu̱, ko̱ u̱r-hamu̱t ko̱ za u̱t-cwu̱, ko̱ u̱ ko̱b-du̱ m-yar ko̱ u̱ me̱ bu-u̱ m-to̱k, it gwak-u̱t bo̱ da?&gt;<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>&lt;&lt;Wa de̱ zu̱ u̱n, &lt;U̱m o̱ waru̱ no̱ u̱t-nip, ba shu̱'u̱te̱ no̱ no̱nge̱ wu̱ re̱k-wa wa-gan u̱ te̱k-u̱ no̱ da, me̱ no̱ no̱me̱ da.&gt;<verse eid="MAT 25:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 25:46"/>&lt;&lt;E̱ de̱ cwa-du̱ swadu̱ u̱r-ko̱b du̱ za u̱r-ma, ne̱t-tu̱ jab-u̱s so̱-se̱ cwaan u̱ be-du̱ fat-du̱ za u̱r-ma.&gt;&gt;<verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">Zo̱ng-su̱ masu̱ Ye̱so̱</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mark 14:1-2</ref>; <ref loc="LUK 22:1-2">Ruka 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoha 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>Da-u̱ Ye̱so̱ tase̱ warru̱ rem-u̱s se̱ u̱s-be̱e̱t se̱ wa zu̱ a-doru̱ wa ne̱, <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>&lt;&lt;No̱ nak kwu̱ku̱s m-roog u̱t-yu̱r kanda na he̱e̱ste̱ Mo̱ro̱g-du̱ u̱r-Pas, na de̱ u̱ yasu̱ Wa'-u̱ Ne̱t na tar wa u-kan.&gt;&gt;<verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>Se̱ i-Yate̱ a-To̱o̱g-ne̱, u̱t-ne̱nge̱n ne̱, e̱ mo̱ro̱g u̱ bu-u yu̱-Yat-ya a-To̱o̱g, wu̱ na foge̱ Kayafa. <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>E̱ ye u̱s-rem, e̱ maas Ye̱so̱ m-yasa tu̱msu̱ e̱ ho̱ wu̱n. <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>Se̱di e̱ zu̱, &lt;&lt;Za u̱ da-u̱ Mo̱ro̱g-du̱ u̱r-Pas da, tasu̱ ne̱t-tu̱ yu̱nsu̱n u-gwu̱z da.&gt;&gt;<verse eid="MAT 26:5"/></para>
  <para style="s1">Yaku̱n ne̱ta-ya wa'agu̱ Ye̱so̱ <optbreak/> m-no̱o̱g u̱ Bataniya</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>Da-u̱ Ye̱so̱ o̱o̱ge̱ u̱ Bataniya, wa do̱'e̱ u̱ bu-u Simo̱n kim. Wu̱na Ye̱so̱ haste̱ go̱m-su̱ kim u̱ war-u wa. <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>Yaku̱n ne̱ta ya haan u̱du̱ Ye̱so̱ u̱ de̱ku̱n bakta-du̱ m-no̱o̱g ne̱ mu̱ shik sok, no̱o̱g-mu̱ wu̱s u-haku̱n. Da-u̱ Ye̱so̱ o̱ te̱k-u̱ u-re̱, wa dasu̱ wu̱ no̱o̱g-m mo̱ u̱r-hi.<verse eid="MAT 26:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 26:8"/>Se̱di da-u̱ a-doru̱ Ye̱so̱ hyane̱ iya, e̱ hog u̱s-ryab. E̱ zu̱ o̱r-u̱t e̱ ne̱, &lt;&lt;¿Uno̱ naas o̱? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>U̱zu̱ wa babu̱g no̱o̱g-m mummo̱, na za kwu̱mu̱g shik u-tát, na mo̱tu̱ a-u̱r-ko̱b-ne̱.&gt;&gt;<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>Ye̱so̱ nak no̱m-u̱ e̱ o̱ u̱t-war, se̱ wa zu̱ u̱n, &lt;&lt;¿Remu̱ u-yan o̱ no̱ o̱tte̱ e̱kse̱ ne̱ta-u inya remu̱ no̱m-u̱ so̱-o̱ wa no̱mu̱ me̱? <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>A-u̱r-ko̱b-ne̱ o̱ u̱r-kot u̱ no̱ ne̱ ko̱ mu̱ne̱, se̱di me̱, u̱m za u̱r-kot u̱ no̱ne̱ ko̱ mu̱ne̱ da. <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>No̱o̱g-m mummo̱ mu̱ wa dase̱ u̱ war-u ri, wa o̱ m-o̱ zo̱ngu̱ me̱ kanda na jwak me̱. <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>U̱m o̱ waru̱ no̱ u̱t-nip, be-du̱ no̱ do̱te̱ do̱nse̱-du̱ Rem-su̱ m-Re̱me̱r sin-se̱ u-me̱ u-dak u-be̱e̱t, na de̱ ha bak-su̱ no̱m-u̱ ne̱ta inya nome̱.&gt;&gt;<verse eid="MAT 26:13"/></para>
  <para style="s1">Yahudas eeste̱ wa yasu̱ Ye̱so̱</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>Wa-gan u̱ te̱k-u̱ a-doru̱ rò o̱p u̱ yu̱r wu̱ na zu̱ye̱ Yahudas Iskariyoti, wa do̱'e̱ u̱du̱ i-Yate̱ a-To̱o̱g-ne̱. <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>Wa zu̱, &lt;&lt;¿Yan o̱ no̱ de̱ yadu̱ me̱, a u̱m yasu̱ no̱ wu̱ne̱?&gt;&gt; E̱ ye' wu̱n ko̱nko̱ shik u̱r-shik u̱ o̱p. <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>Du̱gu̱ da-u̱ o̱, Yahuda hu̱ sa-u̱ fu̱n-su̱ yasu̱ Ye̱so̱ u̱du̱ u̱n.<verse eid="MAT 26:16"/></para>
  <para style="s1">Ye̱so̱ re̱e̱g no̱m u̱t-re̱ m-vaste̱ u̱ <optbreak/> Mo̱ro̱g-du̱ u̱r-Pas u̱ a-doru̱ wa ne̱</para>
  <para style="r">(<ref loc="MRK 14:12-26">Mark 14:12-26</ref>; <ref loc="LUK 22:7-23">Ruka 22:7-23</ref>; <ref loc="JHN 13:21-30">Yoha 13:21-30</ref>; <ref loc="1CO 11:23-25">1Kor 11:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>U̱ te̱k-u̱ ho̱-du̱ u̱r-taku̱n du̱ Mo̱ro̱g-du̱ u̱r-Be̱re̱di du̱ za m-Yis, se̱ a-dor haan u̱du̱ Ye̱so̱ e̱ zu̱, &lt;&lt;¿He̱ne̱ o̱ bo̱ o̱tte̱ u̱ssa it zo̱ngu̱ bo̱, bo̱ re̱ no̱m u̱t-re̱ u̱ Mo̱ro̱g-du̱ u̱r-Pas?&gt;&gt;<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>Wa zu̱, &lt;&lt;Cwaan u-bo̱ u̱du̱ yaku̱n campa-ya, no̱ zu̱ wa, &lt;Wa-u̱t-ko̱se̱ zu̱u̱g, da-u wa teegu̱n, wa de̱ re̱-du̱ Mo̱ro̱g-du̱ u̱r-Pas u̱-me̱ bu-u ró u̱ a-doru̱ wa ne̱.&gt; &gt;&gt; <verse eid="MAT 26:18"/><verse number="19" style="v" sid="MAT 26:19"/>A-dor nom u̱ka Ye̱so̱ zu̱tte̱ e̱ no̱m, tu̱msu̱ e̱ zo̱ng no̱m u̱t-re̱ u̱ Mo̱ro̱g-du̱ u̱r-Pas.<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>Da-u̱ rim-mu̱ tore̱, se̱ Ye̱so̱ shu̱'u̱t m-shu̱'u̱t remu̱ wa re-u̱ no̱m u̱t-re̱ u̱ a-doru̱ wa ne̱ o̱p u̱ yu̱r. <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>U̱n o̱ te̱k u-re̱, Ye̱so̱ zu̱ u̱n, &lt;&lt;U̱m o̱ waru̱ no̱ u̱t-nip, u̱ te̱k-u̱ me̱ no̱ waku̱n de̱ yasu̱ me̱.&gt;&gt;<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>No̱m-u o̱ e̱kse̱ u̱n sok. E̱ he̱e̱se̱ shu̱t-du̱ wu̱n u-gan u-gan u̱zu̱, &lt;&lt;¿Wa-m-nap, me̱ wa?&gt;&gt;<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>Se̱ wa shu̱s wa zu̱, &lt;&lt;Wu̱ o̱ re̱-du̱ no̱m u̱t-re̱ u̱r-kot u̱ me̱ ne̱, wa de̱ yasu̱ me̱. <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>Wa'-u̱ Ne̱t de̱ m-mar u̱ka na pu̱nte̱ u̱-me̱ rem-su̱ u-Ru̱ u̱ mo̱t-u̱t wa. Se̱di no̱m-tu̱ u̱r-o̱n u̱du̱ wu̱ de̱ yasu̱ Wa'-u̱ Ne̱t! U̱t-ze̱g m-ku̱k u̱zu̱ na mak-u̱t ne̱tu̱ wa da, u̱ na mu̱tte̱ wa tu̱msu̱ wa ya'aste̱ Wa'-u̱ Ne̱t.&gt;&gt;<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>Se̱ Yahudas wu̱ yasu̱ wu̱n wa zu̱, &lt;&lt;Wa-m-nap, ¿ko̱ me̱ wa?&gt;&gt;</para>
  <para style="p" vid="MAT 26:25">Ye̱so̱ shu̱s wa zu̱, &lt;&lt;Bo̱ waru̱g.&gt;&gt;<verse eid="MAT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>U̱n o̱ te̱k-u̱ u-re̱, se̱ Ye̱so̱ ku̱b u̱r-be̱re̱di, wa no̱m u̱t-vam u̱du̱ u-Ru̱ Wa bos de̱ wa yasu̱ a-doru̱ wa ne̱. Wa zu̱, &lt;&lt;Kabu̱n no̱ re̱, uno̱ war-u ri o̱.&gt;&gt;<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>Wa ku̱b ko̱k-du̱ bu̱-mu̱ inabi. Da-u̱ wa no̱me̱ u̱t-vam u̱du̱ u-Ru̱, se̱ wa yasu̱ u̱n. Wa zu̱, &lt;&lt;Swaan no̱ be̱e̱t. <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>Hyu̱-m ri mo̱ mu̱ na nomte̱ este̱du̱ u̱s-rem, mu̱ na de̱ u̱t-azu̱g remu̱ jaas-du̱ ba'as-tu̱ u̱t-ne̱t u-tát. <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>U̱m o̱ waru̱ no̱, u̱m za u̱t-swu̱r m-swa bu̱-mu̱ inabi mo̱ da, se̱ ho̱-du̱ u̱m de̱ swa-u̱ bu̱-mu̱ inabi mu̱ po-mo̱ u̱r-kot u̱ no̱ ne̱ u̱ faru̱k-du̱ U̱so-u ri.&gt;&gt;<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>Da-u̱ Ye̱so̱ u̱ a-doru̱ wa ne̱ fu Se̱p-u̱ u̱t-Vam, se̱ e̱ aru̱k m-rwu̱ m-ha Ro̱r-du̱ Te-su̱ Ze̱tun.<verse eid="MAT 26:30"/></para>
  <para style="s1">Ye̱so̱ waru̱g se-m Biturus</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mark 14:27-31</ref>; <ref loc="LUK 22:31-34">Ruka 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoha 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;No̱ be̱e̱t no̱ de̱ u̱t-som no̱ yagu̱ me̱ u̱ ane̱ u̱ gyu̱pu̱-m mummo̱, remu̱ no̱m-u̱ de̱ kwu̱m-du̱ me̱, remu̱ zu̱ o̱ m-pan u̱zu̱:</para>
  <para style="q1" vid="MAT 26:31">&lt;&lt; &lt;U̱m de̱ gap-du̱ wa-u̱t-got,</para>
  <para style="q2" vid="MAT 26:31">tu̱msu̱ ban-du̱ ca de̱ u̱t-bu̱ru̱g,&gt;<note caller="+" style="f"><char style="fr" closed="false">26:31 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="ZEC 13:7">Ze̱ka 13:7</ref></char>.</note><verse eid="MAT 26:31"/></para>
  <para style="m">
    <verse number="32" style="v" sid="MAT 26:32"/>Se̱di a u̱m yu̱ne̱ du̱gu̱ m-mar me̱ ba-u̱ no̱ ha-mu̱ Gariri.&gt;&gt;<verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>Se̱ Biturus zu̱ wu̱n, &lt;&lt;Ko̱ ne̱t-tu̱ so̱mo̱g remu̱ no̱m-u̱ de̱ kwu̱m-du̱ bo̱, me̱ u̱m za m-so̱m da ko̱ ca.&gt;&gt;<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>Ye̱so̱ shu̱s wa zu̱, &lt;&lt;U̱m o̱ waru̱ bo̱ u̱t-nip, u̱ gyu̱p-mu̱ ya-o̱, kanda kan-su̱ ku̱u̱t, bo̱ de̱ no̱mu̱ se-m ri u-so u-tu̱t.&gt;&gt;<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>Biturus zu̱ wu̱n, &lt;&lt;Ko̱ na ho̱ me̱, u̱m za no̱mu̱ se̱-mu̱ napu̱-m ró da.&gt;&gt; Iya o̱ hen a-dor zu̱tte̱ be̱e̱t.<verse eid="MAT 26:35"/></para>
  <para style="s1">U̱s-to̱o̱g u̱-me̱ tak-u̱ Ge̱se̱mani</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mark 14:32-42</ref>; <ref loc="LUK 22:39-46">Ruka 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>Se̱ Ye̱so̱ u̱ a-doru̱ wa ne̱ aru̱k m-ha u̱ de̱ku̱n be-de̱ du̱ na foge̱ Gesemani. Wa zu̱ a-doru̱ wa ne̱, &lt;&lt;shu̱'u̱tu̱n u̱ ane̱, u̱m de̱ m-ha u̱ ane̱ jit u̱m no̱m u̱s-to̱o̱g.&gt;&gt; <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>Se̱ wa ku̱b Biturus u̱ yaag-u̱ Zabadi ne̱ yu̱r, Yakubu u̱ Yohanna. Se̱ wa he̱e̱se̱ namu̱ jab-u̱ dorog-su̱ jab ne̱ sok. <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>Se̱ wa zu̱ u̱n, &lt;&lt;Namu̱ jab mu̱ o̱ jab-u̱ ri o̱ keru̱ ho̱-du̱ me̱. Shu̱'u̱tu̱n u̱ ane̱ no̱ no̱m u̱r-e' u̱ me̱ ne̱.&gt;&gt;<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>Da-u̱ wa hike̱ cashi, se̱ wa ru̱t m-ho̱bo̱g u-dak wa no̱m u̱s-to̱o̱g wa zu̱, &lt;&lt;U̱so-u ri, abite̱ u̱t-no̱me̱ has-tu̱ me̱ din-de̱ ko̱k-du̱ swa-u̱ u̱r-ko̱b de̱. Se̱di, za no̱m-u̱ u̱m zu̱ye̱ o̱ na de̱ u̱t-no̱m da, se̱ no̱m-u̱ bo̱ u̱t-sa.&gt;&gt;<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>Wa mu̱u̱n u̱du̱ a-doru̱ wa ne̱, wa bite̱ m-roog. Wa zu̱ Biturus, &lt;&lt;¿No̱ za keru̱ no̱m-du̱ u̱r-e' u̱ me̱ ne̱ ko̱ u-da u-gan da? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>No̱mu̱n u̱r-e̱', tu̱msu̱ no̱mu̱n u̱s-to̱o̱g taas no̱ he̱ u̱-me̱ m-reg da. Jab u̱t-sa se̱di war-u̱ zatte̱ u̱r-be̱b da.&gt;&gt;<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>Se̱ wa sur m-mu̱ wa no̱m u̱s-to̱o̱g wa zu̱, &lt;&lt;Uso-u ri, abite̱ din-de̱ swadu̱ u̱r-ko̱b za u̱t-yage̱ da, yage̱ na no̱m no̱m-u̱ bo̱ u̱t-sa.&gt;&gt; <verse eid="MAT 26:42"/><verse number="43" style="v" sid="MAT 26:43"/>Wa sur m-mu̱u̱n wa bit u̱n m-roog, remu̱ zu̱ is-u̱ u̱n shu̱u̱g m-roog. <verse eid="MAT 26:43"/><verse number="44" style="v" sid="MAT 26:44"/>Wa yagu̱ u̱n, wa mu u-tu̱tu̱rse̱, wa nom u̱s-to̱o̱g, wa sur m-no̱m to̱o̱g-su̱ wa no̱me̱ u̱r-taku̱n.<verse eid="MAT 26:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 26:45"/>Wa mu̱u̱n u̱du̱ a-doru̱ wa ne̱, wa zu̱ u̱n, &lt;&lt;¿No̱ o̱ pama m-roog u̱r-hure̱ ne̱ ko̱? Da-u̱ no̱ng u̱ na do̱te̱ yasu̱ Wa'-u̱ Ne̱t u̱ kom-tu̱ a-u̱t-ba'as-ne̱. <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>Yu̱nu̱n, na no̱k, wu̱ de̱ yasu̱ me̱ ya wa teegu̱n.&gt;&gt;<verse eid="MAT 26:46"/></para>
  <para style="s1">Na maaste̱ Ye̱so̱</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mark 14:43-50</ref>; <ref loc="LUK 22:47-53">Ruka 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoha 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>Kanda Ye̱so̱ tagte̱ u-nu, Yahudas wa-gan u̱ te̱k-u̱ a-doru̱ rò u̱ mo̱ro̱g-du̱ u̱t-ne̱t teen, e̱ o̱ m-shu̱p u̱s-van ne̱ u̱s-te ne̱. I-Yate̱ a-To̱o̱g-ne̱ u̱ u̱t-ne̱nge̱n ne̱ e̱ to̱mnu̱ u̱n. <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>Wu̱ de̱ yasu̱ Ye̱so̱ baag u̱ wargu̱ u̱n u̱zu̱, &lt;&lt;Wu̱ no̱ hyane̱ u̱m hamu̱tte̱ wa, masu̱n wa.&gt;&gt; <verse eid="MAT 26:48"/><verse number="49" style="v" sid="MAT 26:49"/>Da-u̱ wa tene̱ wa do̱'e̱ u̱du̱ Ye̱so̱, wa zu̱ wu̱n, &lt;&lt;Wa-m-nap, u̱m o̱ ho̱su̱ bo̱.&gt;&gt; Se̱ Yahuda ham-u̱t wu̱n.<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>Ye̱so̱ zu̱ wu̱n, &lt;&lt;Hu̱u̱b-u̱ ri, no̱m no̱m-u̱ hatu̱n bo̱.&gt;&gt;</para>
  <para style="p" vid="MAT 26:50">Ku̱na ne̱t-tu̱ hatu̱n, e̱ maas Ye̱so̱, e̱ ship. <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>Da-u̱ e̱ hyane̱ iya, te̱k-u̱ ne̱t-tu̱ o̱ u̱r-kot u̱ Ye̱so̱ ne̱, wa faru̱n van-u wa, wa ket waku̱n u̱ te̱k-u̱ to̱k-u̱ yu̱-Yat-ya a-to̱o̱g-ne̱ u-to̱.<verse eid="MAT 26:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 26:52"/>Ye̱so̱ zu̱ wu̱n, &lt;&lt;Mute̱ van-u ró u̱-me̱ u̱r-paku̱m, remu̱ zu̱ wu̱ kabe̱ u-van, van-ya de̱ ho̱-du̱ wa. <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>¿No̱ o̱ m-hyan u̱zu̱ u̱m zatte̱ u̱r-be̱b u̱m ko̱n u̱r-se̱ge̱ u̱du̱ U̱so-u ri da, tu̱msu̱ za rem wa to̱mnu̱ me̱ a-to̱mu̱ wa u̱t-zo̱ngu u-tát<note caller="+" style="f"><char style="fr" closed="false">26:53 </char><char style="ft" closed="false">Teeg u̱ka u̱t-zo̱ngu u̱t-ko̱k u̱t-nas m-te u̱t-shishin.</char></note> i ze̱ge̱ karma no̱? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>¿Re̱ na do̱te̱ shu̱su̱ no̱m-u̱ rem-su̱ u-Ru̱ su̱ na pane̱ u̱zu̱ tun-to̱ u̱t-be̱e̱t na no̱mu̱ to̱?&gt;&gt;<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>Da Ye̱so̱ zu̱ ne̱t-u̱t to̱, &lt;&lt;¿No̱ rwu̱gu̱n u̱s-van ne̱ u̱s-te ne̱ no̱ maaste̱ me̱ u̱ka hyu̱w a? Ko̱ mu̱ne̱ u̱m o̱ u̱r-ko̱t u̱ no̱ne̱ u̱ me̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan u̱m o̱ no̱mu̱ no̱ u̱t-ko̱se̱ no̱ maaste̱ me̱ da. <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>Ko̱ ba shu̱'u̱te̱ na no̱ng inya remu̱ na shu̱u̱ste̱ no̱mu̱ a-warru̱ rem-su̱ u-Ru̱ ne̱ pane̱ u̱-me̱ rem-su̱ u-Ru̱.&gt;&gt; Da-u̱ a-dor-ne̱ ho̱ge̱ iya, e̱ som.<verse eid="MAT 26:56"/></para>
  <para style="s1">Ye̱so̱ u̱ shu̱ Mo̱ro̱g-du̱ u̱t-Ne̱nge̱n</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mark 14:53-65</ref>; <ref loc="LUK 22:54-55">Ruka 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yoha 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>Se̱ i mase̱ Ye̱so̱, e̱ hu̱u̱t wu̱n u̱du̱ Kayafa, yu̱-Yat-ya a-to̱o̱g-ne̱, ku̱na a-ko̱se̱-tu̱ bo̱r-u̱t Mosa u̱ u̱t-ne̱nge̱n ne̱ mo̱ro̱gte̱. <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>Se̱ Biturus dor u̱n m-ra m-ra, m-te bu-u̱ yu̱-Yat-ya a-to̱o̱g-ne̱. Wa do̱'e̱ wa shu̱'u̱t u̱du̱ a-u̱r-e'-ne̱ u̱ remu̱ wa hyen-u̱t u̱ka na do̱te̱ u̱t-no̱m.<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>I-Yate̱ a-To̱o̱g-ne̱, u̱ ne̱t-tu̱ Mo̱ro̱g-du̱ u̱t-Ne̱nge̱n ne̱ be̱e̱t karu̱g, e̱ o̱ go-tu̱ bi-su̱ na de̱ ke̱-tu̱ Ye̱so̱ u̱ka na do̱te̱ kwu̱m-du̱ be̱b-du̱ ho̱-du̱ wu̱n. <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>Se̱di u̱n kwu̱mu̱g da, ko̱ ba shu̱'u̱te̱ e̱ke̱n u-tát e̱ ke̱k-tu̱ wu̱n rem-su̱ u̱s-bi u-tát.</para>
  <para style="p" vid="MAT 26:60">A tase̱ ne̱t-ne̱ yu̱r rwu̱u̱n. <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>E̱ zu̱, &lt;&lt;Ne̱t unwa zu̱u̱g, &lt;Me̱ keru̱ ru̱-du̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan u-Ru̱, tu̱msu̱ wa ma o̱ u̱ te̱k-u̱ m-roog u̱t-tu̱t.&gt; &gt;&gt;<verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>Yu̱-Yat-ya a-to̱o̱g-ne̱ yu̱ne̱ wa zu̱, &lt;&lt;¿Bo̱ zatte̱ no̱m-u̱ bo̱ de̱ u̱t-zu̱ da? ¿Re̱ o̱ mo̱ttu̱ no̱m-u̱ e̱ zu̱ bo̱ no̱nge̱?&gt;&gt;<verse eid="MAT 26:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MAT 26:63"/>Ye̱so̱ ho̱ u̱s-ram. Yu̱-Yat-ya a-To̱o̱g zu̱ wu̱n, &lt;&lt;U̱m samgu̱ bo̱ u-Ru̱ ne̱ wu̱ u̱r-fat, waru̱ it ko̱ bo̱ wa o̱ Kiristi Wa' u-Ru̱!&gt;&gt;<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>Ye̱so̱ zu̱, &lt;&lt;U̱ka bo̱ wu̱rte̱. Se̱di u̱m o̱ waru̱ no̱, du̱gu̱ da-o̱, no̱ de̱ hyan-du̱ Wa'-u̱ Ne̱t u̱ be-du̱ u̱r-faru̱k du̱ kom u̱s-cwa u-Ru̱,<note caller="+" style="f"><char style="fr" closed="false">26:64 </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="PSA 110:1">Se̱pV 110:1</ref></char>.</note> wa o̱ haan u̱-me̱ u̱r-ku̱u̱t du̱gu̱ u-ru̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">26:64b </char><char style="ft" closed="false">Gwat tu̱msu̱: </char><char style="xt"><ref loc="DAN 7:13">Dani 7:13</ref></char>.</note><verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>Se̱ yu̱-Yat-ya a-to̱o̱g-ne̱ kemu̱sse̱ to̱ggo̱-u wa remu̱ u̱s-ryab. Wa zu̱, &lt;&lt;¿Yan o̱ tu̱msu̱ na u̱t-sa na ho̱ge̱? No̱ ho̱k wa no̱ngu̱ u-Ru̱ u̱t-ba'as. <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>¿Yan-o̱ no̱ hyane̱?&gt;&gt;</para>
  <para style="p" vid="MAT 26:66">E̱ shu̱s e̱ zu̱, &lt;&lt;Ko̱rge̱ na ho̱ wu̱n.&gt;&gt;<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>E̱ top-su̱ wu̱n m-ta u-shu̱, e̱ gapu̱r wu̱n. E̱ke̱n zo̱o̱r wu̱n u̱t-gap, <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>E̱ o̱ u̱t-zu̱, &lt;&lt;No̱m m-hyan, abite̱ bo̱ wa Kiristi, ¿war wu̱ gapu̱ bo̱?&gt;&gt;<verse eid="MAT 26:68"/></para>
  <para style="s1">Biturus no̱ng se-m Ye̱so̱</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mark 14:66-72</ref>; <ref loc="LUK 22:56-62">Ruka 22:56-62</ref>; <ref loc="JHN 18:15-18">Yoha 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>U̱ da-u o̱ hen Biturus o̱ shu̱'u̱t u̱ kat-du̱ bu-u o̱, se̱ e̱ke̱n gwu̱p-e̱ i o̱ m-ank u̱ bu-u o̱, wa haan u̱du̱ ró wa zu̱, &lt;&lt;Ko̱ bo̱, bo̱ o̱ u̱r-kot u̱ Ye̱so̱ ne̱ ne̱t-u̱ Gariri.&gt;&gt;<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>Biturus no̱m m-se̱ u̱du̱ u̱n, wa zu̱, &lt;&lt;Me̱ m-nak no̱m-u̱ bo̱ o̱tte̱ u̱s-rem da!&gt;&gt;<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>Da-u̱ wa rwu̱ne̱ u̱ pyu̱, e̱ke̱n gwu̱p-e̱ tu̱msu̱ wu̱ o̱ m-nak u̱ bu-u o̱ hyen wu̱n wa zu̱ ne̱t-tu̱ o̱ u̱ ees u̱ku̱n, &lt;&lt;Ne̱t unwa o̱ u̱r-ko̱t u̱ Ye̱so̱ wa-Nazara ne̱.&gt;&gt;<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>Biturus sur m-no̱m m-se' u̱s-to̱nd ne̱ u̱zu̱, &lt;&lt;U̱m nak campa-u ya da!&gt;&gt;<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>A sure̱ m-waas cashi, ne̱t-tu̱ o̱ ees u̱ku̱n e̱ haan, e̱ zu̱ Biturus, &lt;&lt;Nip-to̱ bo̱ o̱ te̱k-u̱ u̱n. Ka bo̱ o̱tte̱ u̱s-rem ko̱ske̱.&gt;&gt;<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>Se̱ Biturus hu̱ u̱s-to̱nd u̱zu̱, &lt;&lt;U̱ Ru̱-u̱ ya me̱ u̱r-ko̱b abite̱ bise̱ u̱m o̱tte̱, u̱m nak ne̱t-u̱ wa da.&gt;&gt; Za rem ku̱u̱t he̱e̱se̱ u̱s-kan.<verse eid="MAT 26:74"/></para>
  <para style="p">
    <verse number="75" style="v" sid="MAT 26:75"/>Biturus baku̱s rem-u̱s Ye̱so̱ no̱mu̱ wa u̱zu̱, &lt;&lt;Kanda kan-su̱ ku̱u̱t, bo̱ de̱ no̱mu̱ se-m ri u-so u-tu̱t.&gt;&gt; Biturus ru u̱du̱ wa no̱m u̱s-kan sok.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">Yahudas ho̱o̱g hi-u̱r wa</para>
  <para style="r">(<ref loc="MRK 15:1">Mark 15:1</ref>; <ref loc="LUK 23:1-2">Ruka 23:1-2</ref>; <ref loc="JHN 18:28-32">Yoha 18:28-32</ref>; <ref loc="ACT 1:18-19">Pama 1:18-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>Da-u̱ is gase̱ u̱r-wu̱n, se̱ yu̱-Yat-ya a-to̱o̱g-ne̱, u̱t-ne̱nge̱n ne̱ e̱ e̱ ye u̱s-rem u̱zu̱ e̱ ho̱ Ye̱so̱. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>Se̱ e̱ gu̱g wu̱n, e̱ aru̱k u̱ wu̱n ne̱ m-ha u̱du̱ Biratus, wa-u-dak yu̱ Roma.<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>Da-u̱ Yahudas wu̱ yase̱ wu̱n na hoot, hyane̱ na kwu̱pku̱ u̱s-rem u̱zu̱ na ho̱ Ye̱so̱, se̱ wa sur m-dorog. Wa mu̱u̱n u̱du̱ i-Yate̱ a-To̱o̱g-ne̱, u̱t-ne̱nge̱n ne̱, wa muutu̱ u̱n ko̱nko̱ shik-u̱ u̱n u̱r-shik u̱ o̱p. <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>Wa zu̱, &lt;&lt;U̱m no̱ng u̱t-ba'as, u̱m ya'aste̱ wa za u̱t-ba'as na ho̱.&gt;&gt;</para>
  <para style="p" vid="MAT 27:4">Se̱ e̱ zu̱ wu̱n, &lt;&lt;¿Bu̱-m it mu̱ yu̱? Se̱se̱ su̱ ró se̱.&gt;&gt;<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>Se̱ wa gun shik-u̱ u̱-me̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan. Wa aru̱k m-rwu̱, wa su̱rgu̱sse̱ hi-u̱r wa u-ho, wa mu̱r.<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>Ku̱na i-Yate̱ a-To̱o̱g-ne̱ kooste̱ shik-u̱ e̱, e̱ zu̱, &lt;&lt;No̱ng u̱r-zwar na muut shik-u̱ e̱ u̱ cu̱n-du̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan da, remu̱ zu̱ shik m-hyu̱ e̱.&gt;&gt; <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>E̱ ye u̱s-rem, e̱ o de̱ku̱n be-de̱, remu̱ zu̱ e̱ muute̱ be-u̱r re̱ be-du̱ jwak-du̱ u̱t-hamu̱t ne̱ a e̱ mare̱. Na zu̱ be-u̱r re̱, be-du̱ wa ma-u̱ u̱t-tur. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>Remu̱ iya, na o̱mnu̱ fag-du̱ be-u̱r re̱, Be-du̱ m-Hyu̱. <verse eid="MAT 27:8"/><verse number="9" style="v" sid="MAT 27:9"/>Iya o̱ na shu̱u̱ste̱ no̱m-u̱ wa-warru̱ rem-su̱ u-Ru̱ Irmiya ware̱ u̱zu̱, &lt;&lt;Na kabu̱g ko̱nko̱ shik u̱r-shik u̱ o̱p [30], shik-u̱ Isra-ne̱ zu̱ na to̱p-u̱ remu̱ rò. <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>Se̱ e̱ o be-du̱ wa ma-u̱ u̱t-tur u̱ shik-u̱ e̱, u̱ka rem-su̱ Yawe zu̱tte̱.&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">27:10 </char><char style="ft" closed="false">Gwat tu̱msu̱ Muut: </char><char style="xt"><ref loc="ZEC 11:12-13">Ze̱ka 11:12-13</ref>; <ref loc="JER 32:6-9">Irmi 32:6-9</ref></char>.</note><verse eid="MAT 27:10"/></para>
  <para style="s1">Ye̱so̱ u̱ shu̱ Biratus</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mark 15:2-5</ref>; <ref loc="LUK 23:3-5">Ruka 23:3-5</ref>; <ref loc="JHN 18:33-38">Yoha 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>Ye̱so̱ o̱ ees u̱ shu̱ faru̱k wa-u-dak, wa shit Ye̱so̱ u̱zu̱, &lt;&lt;¿Bo̱ wa o̱ faru̱k-u̱ Yahuda-ne̱?&gt;&gt;</para>
  <para style="p" vid="MAT 27:11">Ye̱so̱ zu̱, &lt;&lt;Bo̱ waru̱g.&gt;&gt;<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>Se̱di da i-Yate̱ a-To̱o̱g-ne̱ u̱ u̱t-ne̱nge̱n ne̱ ke̱tu̱ Ye̱so̱ u̱s-rem, u zu̱u̱g o̱ko̱n da. <verse eid="MAT 27:12"/><verse number="13" style="v" sid="MAT 27:13"/>Se̱ Biratus zu̱ wu̱n, &lt;&lt;¿Bo̱ ho̱k no̱m-u̱t tun-to̱ tu̱ na zu̱ bo̱ no̱mu̱g da?&gt;&gt; <verse eid="MAT 27:13"/><verse number="14" style="v" sid="MAT 27:14"/>Ye̱so̱ shaku̱s ko̱ u̱r-shu̱t u̱r-gan da. Remu̱ iya wa-u-dak hu̱ mu̱rimmo̱ sok.<verse eid="MAT 27:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>Wa-u-dak ve̱k-u̱t u̱ da-u̱ Mo̱ro̱g-du̱ u̱r-Pas u-be̱e̱t, wa restu̱n wa-gan u̱ te̱k-u̱ ne̱t-tu̱ o̱ tage̱ wu̱ ne̱t-tu̱ u̱t-sa. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>U̱ da-u hen, waku̱n o̱ro u̱ tage̱ wu̱ kowan nape̱ wa u̱t-ba'as wa, na zu̱ wa Barabas. <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>Da-u̱ ne̱t-tu̱ mo̱rge̱, se̱ Biratus zu̱ u̱n, &lt;&lt;¿Wana no̱ u̱t-sa na restu̱n no̱? ¿Barabas wa ko̱ Ye̱so̱ wu̱ na zu̱ Kiristi?&gt;&gt; <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>Biratus zu̱u̱g iya, remu̱ zu̱ Biratus nak u̱zu̱ rem u̱r-shu̱b de̱ na ya'aste̱ Ye̱so̱.<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>Da-u̱ Biratus shu̱'u̱te̱ u̱ be-du̱ kwu̱p-du̱ u̱s-remu̱ wa, se̱ ne̱ta wa to̱mo̱n na waru̱ wa u̱zu̱, &lt;&lt;Ruute̱ kom-u̱t ró u̱ rem-su̱ wa za u̱t-ba'asu̱ wa, remu̱ iya o̱ u̱m soote̱ u̱r-ko̱b sok m-gyu̱p u̱ bo'-u̱ mo̱ttu̱ ne̱tu̱ wa.&gt;&gt;<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>Ku̱na i-Yate̱ a-To̱o̱g-ne̱ u̱t-ne̱nge̱n ne̱ tokte̱ u̱t-ne̱t u̱zu̱ na restu̱n Barabas, na ho̱ Ye̱so̱.<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>Wa-u-dak sur m-zu̱, &lt;&lt;¿Wana u̱m de̱ restu̱n no̱, u̱ te̱k-u̱ ne̱t-u̱t tun-to̱?&gt;&gt;</para>
  <para style="p" vid="MAT 27:21">E̱ zu̱, &lt;&lt;Barabas wa!&gt;&gt;<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>Se̱ Biratus zu̱ u̱n, &lt;&lt;¿Yan o̱ u̱m de̱ no̱mu̱ Ye̱so̱ wu̱ na zu̱ Kiristi?&gt;&gt;</para>
  <para style="p" vid="MAT 27:22">E̱ be̱e̱t kowan zu̱, &lt;&lt;Tar wu̱n u-kan!&gt;&gt;<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>Biratus zu̱, &lt;&lt;¿Remu̱ u-yane̱? ¿Yan o̱ wa no̱me̱ u̱ yo̱-o̱?&gt;&gt;</para>
  <para style="p" vid="MAT 27:23">Ne̱t-tu̱ sur m-yu̱ns u̱s-cwar u̱zu̱, &lt;&lt;Tar wu̱n u-kan!&gt;&gt;<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>Da-u̱ Biratus hyane̱ wa kerge̱ swan-du̱ hi-tu̱ u̱t-ne̱t da, tu̱msu̱ ne̱t-tu̱ o̱ mo̱t-tu̱ yu̱nsu̱ gwu̱z u̱ku̱n, se̱ wa yib m-bu̱ wa jaas ko̱m-u̱t wa u̱ hyan-mu̱ u̱t-ne̱t. Wa zu̱, &lt;&lt;Me̱ bu̱-m ri zarra, u̱m kabu̱g ra-u̱ wa za u̱t-ba'asu̱ unwa ne̱ da. No̱ wa.&gt;&gt;<verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>Se̱ ne̱t-u̱t to̱ u̱t-be̱e̱t e̱ yu̱ns u̱s-cwar u̱zu̱, &lt;&lt;Yage̱ ra-u o̱ u̱ do̱r it u̱ ya'ag-u̱ it ne̱!&gt;&gt;<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>Se̱ wa restu̱n u̱n Barabas. Da-u̱ wa wa'e̱ na no̱mu̱ Ye̱so̱ u̱s-ryap, se̱ wa yasu̱ wu̱n na tar wa u-kan.<verse eid="MAT 27:26"/></para>
  <para style="s1">Karma-ne̱ nu̱mu̱ste̱ Ye̱so̱</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mark 15:16-20</ref>; <ref loc="JHN 19:2-3">Yoha 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>Du̱gu̱ ku̱n karma-ne̱ i wa-u-dak ku̱b Ye̱so̱ e̱ toot u̱ pada-u wa-u-dak, e̱ kargu̱ssu̱n karma-ne̱ u-tát u̱du̱ Ye̱so̱. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>E̱ horom wu̱n u̱t-cwu̱, e̱ wa'-u̱ wu̱n yaku̱n to̱ggo̱-u jaz-ya go̱-du̱ yu̱ farkina-ne̱. <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>E̱ no̱mu̱ de̱ku̱n no̱m-du̱ u̱r-hi du̱ u̱s-hir de̱ go̱-du̱ farkina-ne̱, e̱ wa'-u̱ wu̱n u̱r-hi, e̱ yasu̱ wu̱n u-ko̱m wa ship u̱ kom u̱s-cwa rò, e̱ so̱k-u̱t u̱ ke̱nu̱ rò e̱ no̱m wu̱n huuk-tu̱ u̱s-bi, e̱ o̱ zu̱ wu̱n, &lt;&lt;Ho̱'o̱ faru̱k-u̱ Yahuda-ne̱!&gt;&gt; <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>E̱ to̱p-su̱ wu̱n m-ta, e̱ o̱nk ko̱m-yu̱ e̱ yasu̱ wu̱n, e̱ hu̱ gapru̱ wu̱n u̱ ya u̱r-hi. <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>Da-u̱ e̱ tase̱ no̱mu̱ wu̱n u̱s-ju̱ru̱m, e̱ for to̱ggo̱-u jaz-ya ya, e̱ wa-u̱ wu̱n cwu̱-u̱t rò. E̱ aru̱k u̱ wu̱n ne̱ remu̱ na tu̱r-u̱t wu̱n u-kan.<verse eid="MAT 27:31"/></para>
  <para style="s1">U̱t-tar u-kan</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mark 15:21-32</ref>; <ref loc="LUK 23:26-43">Ruka 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoha 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>U̱n o̱ te̱k-u̱ m-ha, u̱n goone̱ u̱ yaku̱n campa-ya ne̱ ne̱t-u̱ bo̱-u̱ Sayirin, dim-u̱r Simo̱n. E̱ wu̱ wa u̱ kab-du̱ kan-u Ye̱so̱ u̱r-be̱b. <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>E̱ te de̱ku̱n be-de̱ du̱ na zu̱ye̱ Gorgota, (na zu̱ de̱ &lt;&lt;Ko̱g-du̱ u̱r-Hi&gt;&gt;). <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>E̱ ye' wu̱n bu̱-mu̱ ke̱' u̱r-waak u̱t-gag ne̱ u̱ remu̱ wa soot. Da-u̱ wa rake̱, wa gu̱gu̱m u̱t-swa. <verse eid="MAT 27:34"/><verse number="35" style="v" sid="MAT 27:35"/>Da-u̱ e̱ taru̱ wu̱n u-kan, se̱ e̱ gun u-kwe̱mbi e̱ mo̱t to̱ggo̱-u rò.<note caller="+" style="f"><char style="fr" closed="false">27:35 </char><char style="ft" closed="false">Gwat tu̱msu̱ Muut: </char><char style="xt"><ref loc="PSA 22:18">Se̱pV 22:18</ref></char>.</note> <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>A tase̱ u̱n shu̱'u̱t u̱ku̱n u̱n o̱ er-u̱r wu̱n. <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>U̱ do̱m-u̱ hi-u̱r rò, u̱n pu̱n ba'as-tu̱ wa no̱me̱ u̱zu̱, &lt;&lt;UNWA O̱ YE̱SO̱ FARU̱K-U̱ YAHUDA-NE̱.&gt;&gt; <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>Tu̱msu̱ na tu̱r Ye̱so̱ u̱ e̱ke̱n ne̱ hyu̱w-ne̱ yu̱r, wa-gan u̱ kom u̱s-cwa wa-gan u̱ kom u̱r-beer. <verse eid="MAT 27:38"/><verse number="39" style="v" sid="MAT 27:39"/>Ne̱t-tu̱ o̱ aru̱k e̱ hu̱ ru̱m-su̱ u̱t-hi u̱ no̱mu̱ wu̱n u̱s-ju̱ru̱m, <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>e̱ o̱ u̱t-zu̱, &lt;&lt;Bo̱ yu̱ do̱'e̱ ru̱-du̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan, tu̱msu̱ bo̱ ma o̱ u̱ te̱k-u̱ m-roog u̱t-tu̱t, gu hi-du̱ war ró! Abite̱ bo̱ Wa'-u̱ u-Ru̱ wa, cu̱zne̱ u̱ do̱m u-kan.&gt;&gt;<verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>Iya o̱ hen, i-Yate̱ a-To̱o̱g-ne̱ a-ko̱se̱-tu̱ bo̱r-u̱t Mosa ne̱ u̱t-ne̱nge̱n ne̱ hu̱u̱te̱ no̱mu̱ wu̱n u̱s-ju̱ru̱m. <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>E̱ o̱ u̱t-zu̱, &lt;&lt;Wa gwu̱g e̱ke̱n, tu̱msu̱ wa kerge̱ gwu̱du̱ hi-u̱r wa da. Abite̱ wu̱n faru̱k-u̱ Isra-ne̱ wa, yage̱ wa cu̱zu̱n u̱-do̱m u-kan na hyan, da-u o̱ it de̱ yadu̱ jab-u̱ wu̱n ne̱! <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>Wa ya'aste̱ jab u̱du̱ u-Ru̱. Yage̱ Ru̱-u̱ gu wu̱n u̱ da-o̱, a u u̱t-sa, wa zu̱u̱g Wa'-u̱ u-Ru̱ wa o̱ye̱.&gt;&gt; <verse eid="MAT 27:43"/><verse number="44" style="v" sid="MAT 27:44"/>Iya o̱, hyu̱w-ne̱ e̱, i na taru̱ e̱ u-kan u̱r-kot, e̱ no̱ngu̱ wu̱n gom-u̱ rim-o̱.<verse eid="MAT 27:44"/></para>
  <para style="s1">Mar-m Ye̱so̱</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mark 15:33-41</ref>; <ref loc="LUK 23:44-49">Ruka 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoha 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>U̱ te̱k-u̱ u-ho̱, cwu̱m-yu̱ tage̱ u-dak u-be̱e̱t, m-te̱ kwam-su̱ u̱s-tu̱t su̱ m-rim. <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>U̱ te̱k-u̱ u̱s-kwam u̱s-tu̱t, Ye̱so̱ jaku̱s u-cwar wa zu̱, &lt;&lt;E̱ri, E̱ri, ¿Rama sabaktani?&gt;&gt; Wata, &lt;&lt;Ru̱-u ri, Ru̱-u ri, ¿remu̱ yan o̱ bo̱ yaktu̱ me̱?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">27:46b </char><char style="ft" closed="false">Gwat tu̱msu̱ Muut: </char><char style="xt"><ref loc="PSA 22:1">Se̱pV 22:1</ref></char>.</note><verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>Ne̱t-tu̱ o̱o̱ge̱ ees u̱ku̱n da-u̱ e̱ ho̱ge̱ iya, e̱ zu̱, &lt;&lt;Ne̱t uno̱ o̱ fag-du̱ Iriya.&gt;&gt;<verse eid="MAT 27:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 27:48"/>Du̱gu̱ ku̱n waku̱n yu̱ne̱ za naas u-da wa kabu̱n soso. Wa mu̱s de̱ u̱-me̱ bu̱-mu̱ u-zu̱r, wa su̱k-de̱ u̱ do̱m u-te wa nabu̱ wu̱n wa soot. <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>E̱ke̱n zu̱, &lt;&lt;Yagu̱n wu̱n u̱su̱ rò, na hyan ko̱ Iriya u̱t-haan wa gu wu̱n!&gt;&gt;<verse eid="MAT 27:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50"/>Se̱ Ye̱so̱ sur m-yu̱ns u-cwar u̱r-be̱b ne̱, du̱gu̱ ku̱n wa ku̱b u̱r-fat.<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>U̱ da-u o̱ kus-u̱ u-is u̱ na erge̱ u-me̱ be-du̱ u-he̱n du̱ be-du̱ u̱r-shu̱'u̱t du̱ Wa-ko̱-uyan o̱ kees u̱t-kik u̱t-yu̱r, du̱gu̱ do̱m u-ru̱ m-cu̱z u-dak. Na no̱m ru̱mu̱s-du̱ u-dak, tu̱msu̱ tar-tu̱ yo̱'o̱k. <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>Sag-tu̱ u-pus, ne̱t-tu̱ u-Ru̱ u-tát i mare̱ e̱ yu̱ne̱ u̱r-fat. <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>(Da-u̱ e̱ bite̱ Ye̱so̱ yu̱nge̱ du̱gu̱ m-mar, e̱ yage̱ u̱t-sag. Se̱ e̱ to u̱ bo̱-u̱ u-he̱n, u̱t-ne̱t u-tát e̱ hyen u̱n.)<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>U̱ da-u̱ yaku̱n yu̱-shu̱ karma Roma u̱ e̱ke̱n karma-ne̱, i o̱ e-u̱r Ye̱so̱ e̱ hyen no̱mu̱ nome̱ u-be̱e̱t, e̱ hog u-gye̱r sok. E̱ zu̱, &lt;&lt;U̱t-nip, unwa Wa'-u̱ u-Ru̱ wa!&gt;&gt; <verse eid="MAT 27:54"/><verse number="55" style="v" sid="MAT 27:55"/>To̱ko̱n ne̱ta to̱ o̱ro u̱ku̱n u-tát tu̱ do̱ru̱ Ye̱so̱ du̱gu̱ Gariri e̱ o̱ no̱mu̱ wu̱n u̱s-pama. E̱ ees m-ra e̱ o̱ madi-du̱ no̱mu̱ na o̱ u̱t-no̱m. <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>U̱ te̱k-u̱ u̱n, Me̱ri o̱ro du̱gu̱ Magadarin, u̱ Me̱ri ino-u Yakubu u̱ Yusuhu, tu̱msu̱ ino-u yagu̱ Zabadi.<verse eid="MAT 27:56"/></para>
  <para style="s1">Jwak-du̱ Ye̱so̱</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mark 15:42-47</ref>; <ref loc="LUK 23:50-56">Ruka 23:50-56</ref>; <ref loc="JHN 1:38-42">Yoha 1:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>Da rim-mu̱ tore̱, se̱ waku̱n wa-u̱t-kwu̱m wa ne̱t-u̱ Arimatiya, dim-u̱r wa Yusuhu, wa haan, ko̱wa wa o̱ te̱k-u̱ a-doru̱ Ye̱so̱. <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>Wa do̱'e̱ u̱du̱ Biratus, wa kon u̱zu̱ na ya wa u-u̱r Ye̱so̱. Biratus hen wa zu̱ na yasu̱ wu̱n u̱r-u. <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>Se̱ Yusuhu ku̱b u-u̱r re̱ wa ho̱po̱s de̱ u̱ kus-u pus-o̱ u̱ so̱-o̱. <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>Wa gu̱n u-u̱r re̱ u̱-me̱ sag-u po-o̱ wa, u̱ na kawe̱ u̱-me̱ u̱t-tar. Wa kabu̱n ta'ar-u̱r yat-de̱ wa wu̱gu̱b is-yu̱ u-sag, wa aru̱k. <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>Me̱ri Magadarin u̱ inya jit Me̱ri ya, e̱ o̱ shu̱'u̱t u̱ dapu̱s u-sag.<verse eid="MAT 27:61"/></para>
  <para style="s1">A e'-du̱ u-sag</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>Da-u̱ is gase̱, ba ho̱-du̱ u̱t-zo̱ng arke̱, i-Yate̱ a-To̱o̱g-ne̱ u̱ Farisa-ne̱ e̱ mo̱ro̱g u̱ shu̱ Biratus. <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>U̱n haan u̱du̱ wa-u-dak u̱n zu̱, &lt;&lt;It baku̱ste̱ u̱zu̱ da-u̱ ne̱t unwa wa u̱s-bi o̱o̱ge̱ u̱r-fat wa zu̱u̱g, &lt;U̱m de̱ u̱r-yu̱ne̱ du̱gu̱ m-mar u̱ ho̱-du̱ u-tu̱tu̱rse̱.&gt; <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>Remu̱ iya na e̱' sag-u o̱ u̱r-zwar ne̱, m-ha u̱ ho̱-du̱ u-tu̱tu̱rse̱, u̱ remu̱ zu̱ a taase̱ u̱ a-doru̱ rò haan e̱ hast war-u rò, e̱ zu̱ u̱t-ne̱t wa yu̱nge̱ du̱gu̱ marimari ne̱. A shu̱'u̱te̱ iya e̱nk-su̱ m-vaste̱ mo̱ u̱t-ze̱g u̱r-taku̱n m-yo̱.&gt;&gt;<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>Biratus zu̱ u̱n, &lt;&lt;Sa'an karma-ne̱, e̱ do̱'e̱ e̱ no̱m u̱r-e' u̱ka no̱ hyente̱ kamu̱g.&gt;&gt;<verse eid="MAT 27:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66"/>Se̱ e̱ aru̱k, e̱ wo ge̱r u̱-do̱mu̱ ta'ar-du̱ o̱ do̱m-u̱ u-sag taas u̱ waku̱n u̱ tam da, tu̱msu̱ e̱ wo karma-ne̱ e'-du̱ sag-u o̱.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">Yu̱ne̱-u̱r Ye̱so̱ du̱gu̱ m-mar</para>
  <para style="r">(<ref loc="MRK 16:1-8">Mark 16:1-8</ref>; <ref loc="LUK 24:1-12">Ruka 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoha 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>Ba Ho̱-du̱ u̱r-Hure̱ du̱ roog-mu̱ u̱t-ta'er arke̱, u̱ te̱k-u̱ ho̱-du̱ u̱r-taku̱n du̱ roog-mu̱ u̱t-ta'er, u̱r-is gas, Me̱ri Magadarin u̱ yaku̱n ne̱ta-ya wu̱ na foge̱ Me̱ri e̱ yu̱ne̱ e̱ do̱'e̱ u̱du̱ u-sag.<verse eid="MAT 28:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 28:2"/>Za rem, na no̱m de̱ku̱n ru̱mu̱s-du̱ u-dak de̱ u-tát, se̱ waku̱n wa-to̱m Wa-ko-uyan wa haan du̱gu̱ do̱m u-ru̱, wa irgu̱sse̱ ta'ar-u̱ na taku̱ste̱ u-sag, wa shu̱'u̱t u̱ do̱m-u̱ ta'ar-u o̱. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>Wa o̱ m-baku̱t, tu̱msu̱ cwu̱'u̱t wa u̱ pus-to̱ pu̱t u̱ka u̱t-randi. <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>Da-u̱ a-u̱r-e'-ne̱ hyane̱ wu̱n, e̱ hog u-gye̱r sok, e̱ o̱ m-zap, e̱ he u-dak u̱ka marimari ne̱.<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>Ku̱na wa-to̱m u-Ru̱ zu̱tte̱ ne̱ta-u̱t to̱, &lt;&lt;A no̱ ho̱g u-gye̱r da! U̱m nak no̱ o̱ sa-u Ye̱so̱ wa, wu̱ na tare̱ u-kan. <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>Wa za ane̱ da. Wa yu̱nge̱ u̱ka wa zu̱tte̱. Haanu̱n no̱ hyan be-du̱ wa o̱tte̱ m-ru̱t. <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>No̱mu̱n m-ho̱r no̱ do̱'e̱, no̱ waru̱ a-doru̱ wa u̱zu̱, &lt;Ye̱so̱ yu̱nge̱ du̱gu̱ marimari ne̱. Wa de̱ hen u̱ ba-du̱ no̱ m-te̱ Gariri, ku̱na no̱ do̱te̱ hyan-du̱ wu̱n.&gt; Baksu̱n no̱m-u̱ u̱m waru̱ no̱.&gt;&gt;<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>Se̱ e̱ yage̱ be-du̱ u-sag, u-gye̱r ne̱ sok, tu̱msu̱ u̱r-so̱ ne̱ sok. E̱ ku̱su̱m m-so̱m remu̱ e̱ war-tu̱ a-doru̱ Ye̱so̱, <verse eid="MAT 28:8"/><verse number="9" style="v" sid="MAT 28:9"/>Ye̱so̱ u̱ hi-u̱r wa, wa goone̱ u̱ u̱n ne̱, wa zu̱ u̱n, &lt;&lt;Jab-u̱s pusse̱ u̱du̱ no̱!&gt;&gt; E̱ hikne̱ e̱ ham-u̱t na-u̱s rò, e̱ no̱mu̱ wu̱n u̱t-huuk. <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>Ye̱so̱ zu̱ u̱n, &lt;&lt;A no̱ ho̱g u-gye̱r da! No̱ko̱n no̱ waru̱ o̱r-u̱t ri ne̱ na goone̱ u̱ Gariri, ku̱na e̱ do̱te̱ hyan-du̱ me̱.&gt;&gt;<verse eid="MAT 28:10"/></para>
  <para style="s1">No̱m-u̱ a-u̱r-e'-ne̱ ware̱</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>Da-u̱ ne̱ta-u̱t to̱ o̱ te̱k-u̱ m-ha, te̱k-u̱ ne̱t-tu̱ e'-du̱ sag-u o̱, e̱ to u-bo̱, e̱ waru̱ i-Yate̱ a-To̱o̱g-ne̱ no̱m-u̱ na no̱me̱ u-be̱e̱t. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>Ku̱na yu̱-Yat-ya a-To̱o̱g-ne̱ u̱t-ne̱nge̱n ne̱ gu̱gte̱ u̱t-hi, e̱ ye' karma-ne̱ shik u-tát, <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>E̱ zu̱, &lt;&lt;Waru̱n u̱t-ne̱t u̱zu̱, &lt;A-doru̱ rò haane m-gyu̱p e̱ hiwis wu̱n da-u̱ no̱ o̱o̱ge̱ m-roog.&gt; <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>A rem-su̱ teye̱ u̱du̱ wa-u-dak, it no̱mu̱ wa u̱s-rem taas no̱ swa u̱r-ko̱b da.&gt;&gt; <verse eid="MAT 28:14"/><verse number="15" style="v" sid="MAT 28:15"/>Ku̱na karma-ne̱ o̱nkte̱ shik, e̱ nom u̱ka na zu̱tte̱ e̱ no̱m. No̱m-u o̱ gu̱ru̱s u̱-me̱ Yahuda-ne̱ u̱ haan u̱ da-o̱.<verse eid="MAT 28:15"/></para>
  <para style="s1">Ank-mu̱ Ye̱so̱ yase̱ <optbreak/> a-doru̱ wa</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>A-dor o̱p u-gan do̱'e̱ u̱ Gariri, e̱ do̱'e̱ u̱ ro̱r-du̱ Ye̱so̱ zu̱tte̱ e̱ goone̱. <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>Da-u̱ e̱ hyane̱ wu̱n, e̱ no̱mu̱ wu̱n u̱t-huuk, se̱di e̱ke̱n no̱ng u-sakna. <verse eid="MAT 28:17"/><verse number="18" style="v" sid="MAT 28:18"/>Se̱ Ye̱so̱ hikne̱ u̱t-mo̱r wa zu̱ u̱n, &lt;&lt;U̱so-u ri ya'aste̱ me̱ faru̱k-du̱ do̱m u-ru̱ u-dak ne̱ u-be̱e̱t. <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>Remu̱ iya, do̱'e̱n no̱ no̱mu̱ ne̱t-tu̱ u-dak u̱t-be̱e̱t ko̱se̱-tu̱ rem-u̱s ri, u̱ka e̱ do̱te̱ shu̱'u̱tu̱ a-doru̱ ri. No̱ no̱mu̱ e̱ u̱t-yu̱bu̱sse̱ m-bu̱ e̱ shu̱'u̱t u̱-me̱ faru̱k-du̱ U̱so-u ri, u̱du̱ ri ne̱, Wa'-u̱ wa, tu̱msu̱ u̱du̱ Yar-u u-Ru̱ ne̱. <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>No̱ is-u̱ u̱n e̱ do̱r no̱m-u̱ u̱m zu̱ no̱ no̱m u-be̱e̱t. U̱m o̱ u̱r-kot u̱ no̱ ne̱ ko-uyan da m-te ma-du̱ u-da.&gt;&gt;<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
