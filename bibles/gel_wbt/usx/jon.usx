<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Fakai Translation</book>
  <para style="h">Yunana</para>
  <para style="toc1">Ran-u Yunana</para>
  <para style="toc2">Yunana</para>
  <para style="toc3">Yuna</para>
  <para style="mt2">Ran-u</para>
  <para style="mt1">Yunana</para>
  <chapter number="1" style="c" sid="JON 1"/>
  <para style="s1">Yunana so̱mo̱g du̱gu̱-du̱ Yawe</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1"/>Rem-u̱s Yawe haagu̱n u̱du̱ Yunana wa'-u̱ Amitai. <verse eid="JON 1:1"/><verse number="2" style="v" sid="JON 1:2"/>&lt;&lt;Yu̱ne̱ bo̱ do̱'e̱ u̱ Neneba bo̱-u yat-o̱, bo̱ waru̱ u̱n rem-u̱s ri, remu̱ no̱m-u̱t yo̱-to̱ u̱n teegu̱n u̱du̱ ri.&gt;&gt;<verse eid="JON 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 1:3"/>Se̱di Yunana gu̱gu̱m. Wa som u̱ irig m-ha bo̱-u yat-o̱ u̱ na foge̱ Jopa tu̱msu̱ wa top shik, se̱ wa irig u̱-me̱ hat-u yat-ya m-ha bo̱-u̱ Tarshis. Wa aru̱k remu̱ u̱zu̱ wa o̱o̱g u̱ssa wa so̱m du̱gu̱-du̱ Yawe.<verse eid="JON 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4"/>U̱n o̱ te̱k u̱r-no̱k, Yawe to̱ko̱n mya-mu̱ u̱r-be̱b u̱-me̱ m-sa, hat-yu̱ u̱t-sa u̱t-u̱ku̱s. <verse eid="JON 1:4"/><verse number="5" style="v" sid="JON 1:5"/>A-nak-du̱ hat-u yat-ya hog u-gye̱r sok. Ko̱wan hu̱ ko̱n-du̱ ru̱-u wa. U̱n guns cwu̱-u̱t u̱n u̱-me̱ m-sa remu̱ hab-du̱ m-no hat-u yat-ya.</para>
  <para style="p" vid="JON 1:5">Se̱di Yunana o̱ u̱-me̱ dak-u̱ hat-u yat-ya wa roog-mu̱ ho̱o̱g wa. <verse eid="JON 1:5"/><verse number="6" style="v" sid="JON 1:6"/>Da-u o̱ yu̱-Yat-ya yu̱ hat-u yat-ya haan u̱du̱ Yunana wa zu̱, &lt;&lt;¿Remu̱ yan-o̱ bo̱ o̱tte̱ m-roog? Yu̱ne̱! Bo̱ ko̱n ru̱-u ró, ko wa ho̱gu̱ o̱n-u̱r in, wa u̱ku̱r in du̱gu̱ m-mar.&gt;&gt;<verse eid="JON 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7"/>Ku̱na a-nak-du̱ hat-u yat-ya ne̱ zu̱tte̱, &lt;&lt;Haanu̱n, in gunu̱n u-gwe̱mbi remu̱ na nu̱pu̱t wa-u̱t-ba'as.&gt;&gt; U̱ da-u o̱ u̱n nom u-gwe̱mbi, u̱n nu̱p u̱zu̱ Yunana wa, wa-u̱t-ba'as. <verse eid="JON 1:7"/><verse number="8" style="v" sid="JON 1:8"/>U̱n zu̱ wu̱n, &lt;&lt;U̱ da-o̱ waru̱ it. ¿Yan-o̱ bo̱ no̱me̱ na o̱tte̱ swadu̱ u̱r-ko̱b? ¿Yan-o̱ o̱ ank-m ró? ¿He̱ne̱ bo̱ rwu̱tu̱n ne̱? ¿Yan-o̱ dim-du̱ bo̱-u̱ bo̱ rwu̱tu̱n? ¿Yan ko̱-de̱ bo̱ rwu̱tu̱n?&gt;&gt;<verse eid="JON 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9"/>Yunana zu̱ u̱n, &lt;&lt;Me̱ ne̱t-u̱ Isra wa, tu̱msu̱ me̱ wa doru̱ Yawe wa, Ru̱-u̱ do̱m u-ru̱, wu̱ no̱me̱ m-sa u-dak ne̱.&gt;&gt;<verse eid="JON 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 1:10"/>Tu̱msu̱ wa waru̱ u̱n, u̱zu̱ wa o̱ u̱ so̱m-du̱ Yawe. Da-u o̱ gye̱r-u̱ ship ne̱t-u̱t to̱, u̱n zu̱ wu̱n, &lt;&lt;¿Remu̱ yan-o̱ bo̱ nomte̱ iya?&gt;&gt;<note caller="+" style="f"><char style="fr" closed="false">1:10</char><char style="ft" closed="false">Ye̱so̱ shu̱ku̱t iyane̱ </char><char style="xt"><ref loc="MAT 12:40">Mati 12:40</ref></char>.</note> <verse eid="JON 1:10"/><verse number="11" style="v" sid="JON 1:11"/>Yu̱-u̱ m-mya u̱-me̱ m-sa sur u̱r-be̱b sok, u̱n zu̱ wu̱n, &lt;&lt;¿Yan-o̱ it do̱'e̱ no̱mu̱ bo̱ u̱ yu̱-u̱ m-mya yakte̱ no̱mu̱ in u-gwu̱z?&gt;&gt;<verse eid="JON 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12"/>Yunana zu̱ u̱n, &lt;&lt;U̱m nak yu̱-u̱ m-mya haagu̱n u̱-do̱mu̱ no̱ u̱ remu̱ ba'as-u̱t ri. Kabu̱n me̱ no̱ guns me̱ u̱-me̱ m-sa ko̱-uyan o̱ u̱t-re̱s.&gt;&gt;<verse eid="JON 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13"/>Se̱di u̱n waste̱ u̱ rem-u̱s Yunana ne̱ da. A-nak-du̱ hat-u yat-ya ne̱ hu̱ mat-du̱ u̱s-hund e̱ teet kit m-sa, remu̱ be̱b-du̱ m-mya re u-shu̱ m-swu̱r u̱n kerge̱ da. <verse eid="JON 1:13"/><verse number="14" style="v" sid="JON 1:14"/>U̱n nom u̱s-kan u̱du̱ Yawe, u̱n zu̱, &lt;&lt;Yawe u-Ru̱, it ko̱no̱g bo̱, a-bo̱ yage̱ it mar remu̱ kab-du̱ fat-du̱ ne̱t unwa da. Yawe u-Ru̱, a-bo̱ ship it a-u̱t-ba'as remu̱ kab-du̱ fat-du̱ wa-za-u̱t-ba'as unwa da. Se̱di no̱m no̱m-u̱ citu̱ bo̱.&gt;&gt; <verse eid="JON 1:14"/><verse number="15" style="v" sid="JON 1:15"/>U̱n ku̱b Yunana, u̱n guns wa u̱-me̱ m-sa. Da-u̱ u̱n gu̱nse̱ Yunana, yu̱-u̱ m-mya res te̱k. <verse eid="JON 1:15"/><verse number="16" style="v" sid="JON 1:16"/>Da-u o̱, ne̱t-tu̱ hog gye̱r-u̱ Yawe sok. U̱n no̱m este̱du̱ u̱s-rem u̱du̱ Yawe, tu̱msu̱ u̱n nom u̱r-to̱o̱g u̱du̱ wa.<verse eid="JON 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17"/>Da-u̱ u̱n gunse̱ Yunana m-sa, Yawe to̱mo̱n jan-u yat-ya, ya toros Yunana. Yunana shu̱'u̱t u̱-me̱ me̱n-tu̱ u-jan u̱t-ho̱ u̱t-tu̱t.<verse eid="JON 1:17"/></para>
  <chapter eid="JON 1"/>
  <chapter number="2" style="c" sid="JON 2"/>
  <para style="s1">To̱o̱g-u̱s Yunana u̱du̱ u-Ru̱</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1"/>Da-u̱ wa o̱o̱ge̱ u̱-me̱ me̱n-tu̱ u-jan, Yunana no̱ng u̱s-to̱o̱g u̱du̱ Yawe u-Ru̱. <verse eid="JON 2:1"/><verse number="2" style="v" sid="JON 2:2"/>Wa zu̱,</para>
  <para style="q1" vid="JON 2:2">&lt;&lt;U̱m fak Yawe u̱ te̱k-u̱</para>
  <para style="q2" vid="JON 2:2">swadu̱ u̱r-ko̱b u̱ ri,</para>
  <para style="q1" vid="JON 2:2">tu̱msu̱ wa shu̱s to̱o̱g-u̱s ri.</para>
  <para style="q2" vid="JON 2:2">U̱-me̱ be-du̱ u̱r-shu̱'u̱t</para>
  <para style="q2" vid="JON 2:2">du̱ marimari ne̱,</para>
  <para style="q1" vid="JON 2:2">tu̱msu̱ bo̱ hog ko̱n-u̱s ri.<verse eid="JON 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3"/>Bo̱ gwu̱nu̱g me̱ u̱-me̱ m-bu̱ mu̱ u̱r-ra,</para>
  <para style="q2" vid="JON 2:3">u̱ te̱k-u̱ dak-u̱ m-sa.</para>
  <para style="q1" vid="JON 2:3">U̱m o̱ u̱-me̱ m-bu̱,</para>
  <para style="q2" vid="JON 2:3">tu̱msu̱ jwak m-bu̱, re̱e̱g be̱b-u̱r ri.<verse eid="JON 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4"/>U̱m zu̱u̱g, &lt;Ko̱ bo̱ hastu̱ me̱ du̱gu̱-du̱ ró,</para>
  <para style="q2" vid="JON 2:4">ko ba shu̱'u̱te̱ iya,</para>
  <para style="q1" vid="JON 2:4">me̱ u̱t-sur m-hyan</para>
  <para style="q2" vid="JON 2:4">pyu̱-u̱ u-he̱n u̱ ró.&gt;<verse eid="JON 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5"/>Bu̱-mu̱ re̱e̱g me̱ u̱r-hi,</para>
  <para style="q2" vid="JON 2:5">bu̱-mu̱ m-sa taku̱ste̱ me̱ u-be̱e̱t.</para>
  <para style="q1" vid="JON 2:5">Gwa-su̱ me̱ m-sa</para>
  <para style="q2" vid="JON 2:5">taku̱ste̱ hi-u̱r ri.<note caller="+" style="f"><char style="fr" closed="false">2:5 </char><char style="ft">Gwa-tu̱ apne̱ u̱-me̱ m-sa.</char></note><verse eid="JON 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6"/>U̱m yi'iste̱ u̱-ta</para>
  <para style="q2" vid="JON 2:6">m-sa m-te u̱ be-du̱ u̱t-ta'ar.</para>
  <para style="q1" vid="JON 2:6">U̱m o̱ u̱-me̱ be-du̱ marimari ne̱.</para>
  <para style="q2" vid="JON 2:6">Yawe, u-Ru̱ u̱ ri,</para>
  <para style="q1" vid="JON 2:6">bo̱ wa ruutu̱ me̱ u̱-me̱ u-kub.<verse eid="JON 2:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7"/>&lt;&lt;Yawe, da-u̱ u̱m ho̱ge̱ fat-u̱r ri</para>
  <para style="q2" vid="JON 2:7">o̱ m-rwu̱;</para>
  <para style="q1" vid="JON 2:7">tu̱msu̱ u̱m nom u̱s-to̱o̱g u̱du̱ ró,</para>
  <para style="q2" vid="JON 2:7">Tu̱msu̱ bo̱ hog ko̱n-u̱s ri</para>
  <para style="q1" vid="JON 2:7">u̱-me̱ be-du̱ u-he̱n u̱ ró.<verse eid="JON 2:7"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8"/>&lt;&lt;Ne̱t-tu̱ o̱o̱ge̱ no̱m-du̱ u̱t-huuk m-gir,</para>
  <para style="q2" vid="JON 2:8">e̱ gu̱gu̱mte̱ o̱n-du̱ u̱</para>
  <para style="q2" vid="JON 2:8">cwan-tu̱ u-Ru̱ ne̱.<verse eid="JON 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9"/>Se̱di me̱, u̱ nu-u̱ u̱t-vam.</para>
  <para style="q2" vid="JON 2:9">U̱m de̱ no̱m-du̱ to̱o̱g u̱du̱ ró.</para>
  <para style="q1" vid="JON 2:9">Me̱ shu̱su̱ este̱du̱ u̱s-rem u̱ ri,</para>
  <para style="q2" vid="JON 2:9">remu̱ u̱ku̱r u̱ o̱o̱n du̱gu̱ Yawe.&gt;&gt;<verse eid="JON 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10"/>Se̱ Yawe wu̱' jan-yu̱ gwa'u̱n Yunana u̱-kit m-sa.<verse eid="JON 2:10"/></para>
  <chapter eid="JON 2"/>
  <chapter number="3" style="c" sid="JON 3"/>
  <para style="s1">Yunana o̱ m-ha u̱ Neneba</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1"/>Rem-u̱s Yawe sur m-haan u̱du̱ Yunana u-yu̱ru̱mse̱. Wa zu̱, <verse eid="JON 3:1"/><verse number="2" style="v" sid="JON 3:2"/>&lt;&lt;Yu̱ne̱ bo̱ ha u̱ Neneba bo̱-u yat-o̱, bo̱ waru̱ ne̱t-tu̱ o̱ u̱ku̱n rem-su̱ u̱m waru̱ bo̱.&gt;&gt;<verse eid="JON 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="JON 3:3"/>Yunana er rem-u̱s Yawe, se̱ wa yu̱ne̱ wa hu̱ u̱ Neneba. Bo̱-u̱ Neneba o̱o̱g u̱ yat-o̱ o̱ sok, se̱ ne̱t no̱ng m-roog u̱t-tu̱t kanda wa hyan bo̱-u o̱ u-be̱e̱t. <verse eid="JON 3:3"/><verse number="4" style="v" sid="JON 3:4"/>Ho̱-du̱ Yunana cwaye̱ u̱-me̱ bo̱-u̱ Neneba, wa nom u̱r-hoot u̱r-gan. Se̱ wa he̱e̱se̱ no̱m-du̱ u̱r-do̱nse̱ u̱zu̱, &lt;&lt;Kwu̱ku̱s m-roog u̱t-shik u̱t-yu̱r u̱ na haatu̱n u̱ ho̱-du̱ bo̱-u̱ Neneba.&gt;&gt; <verse eid="JON 3:4"/><verse number="5" style="v" sid="JON 3:5"/>Ne̱t-tu̱ Neneba hog rem-u̱s u-Ru̱, e̱ dor se̱. E̱ nom u̱r-do̱nse̱ kowan u̱ no̱m u-swaat, iya o̱ hen u̱ ne̱t-u̱t wu̱to̱ u̱ ya'ag-u̱ re̱k-e̱, kowan nom u-swaat, tu̱msu̱ e̱ wu̱ cwu̱-tu̱ ko̱se̱-du̱ namu̱ jab remu̱ ba'as-u̱t u̱n.<verse eid="JON 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 3:6"/>Da-u̱ faru̱k-u̱ Neneba ho̱ge̱ rem-su̱ Yunana ware̱, wa yu̱ne̱ du̱gu̱ pora-du̱ u̱r-faru̱k-u̱ wa. Wa wu̱' cwu̱-tu̱ ko̱se̱ namu̱ jab. Wa shu̱'u̱t u-dak u̱ do̱m m-cwa remu̱ ko̱ste̱ u̱zu̱ wa yakke̱ u̱t-ba'as. <verse eid="JON 3:6"/><verse number="7" style="v" sid="JON 3:7"/>U̱ da-u o̱, faru̱k wu̱' na no̱m u̱r-do̱nse̱ u̱-me̱ bo̱-u wa u-be̱e̱t u̱zu̱:</para>
  <para style="pmo" vid="JON 3:7">Du̱gu̱ nu-u faru̱k-u̱ i-yate̱ wa ne̱.</para>
  <para style="pm" vid="JON 3:7">&lt;&lt;Ana yage̱ ne̱t ko̱ u-bisa o̱ rak no̱m u̱t-re̱ da, a waku̱n u̱ re no̱m u̱t-re̱ ko̱ wa swa m-bu̱ da. <verse eid="JON 3:7"/><verse number="8" style="v" sid="JON 3:8"/>Yage̱ ne̱t, u̱t-bisa ne̱ u̱ wa' kus-tu̱ ko̱se̱ namu̱ jab. Tu̱msu̱ yage̱ ko̱wan u̱ fag u-Ru̱ m-ho̱r-m-ho̱r. Ko̱wan byu̱ru̱n du̱gu̱ fu̱n-u̱s yo̱-se̱ wa, u̱ yu̱nu̱s-du̱ jab-su̱ u̱t-ne̱t ne̱. <verse eid="JON 3:8"/><verse number="9" style="v" sid="JON 3:9"/>Jiya Ru̱-o̱ u̱t-ho̱g u̱r-o̱n, wa toros jab-u̱ wa remu̱ ba'as-u̱t in, wa yage̱ mo̱ttu̱ ho̱-du̱ in.&gt;&gt;<verse eid="JON 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10"/>Da-u̱ Ru̱-u̱ hyane̱ u̱zu̱ u̱n yakke̱ u̱t-ba'as u̱ remu̱ yage̱-du̱ no̱m-du̱ no̱m-u̱t yo̱-to̱ u̱n, se̱ wa hog o̱n-u̱r u̱n. Wa yage̱ mo̱ttu̱ ho̱-du̱ u̱n tu̱ wa o̱o̱ge̱ wa zo̱ngte̱.<verse eid="JON 3:10"/></para>
  <chapter eid="JON 3"/>
  <chapter number="4" style="c" sid="JON 4"/>
  <para style="s1">Ryab-u̱s Yunana remu̱ o̱n-u̱r Yawe</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1"/>Yunana hog u̱s-ryab sok, remu̱ o̱n-du̱ Ru̱-u̱ ho̱ge̱ u̱ do̱m-u̱ ne̱t-tu̱ Neneba. <verse eid="JON 4:1"/><verse number="2" style="v" sid="JON 4:2"/>Yunana nom u̱s-to̱o̱g u̱du̱ Yawe wa zu̱, &lt;&lt;¿Yawe, inya o̱ u̱m zu̱tte̱ da-u̱ u̱m o̱o̱ge̱ u̱ bo̱-u ri? De̱ wu̱te̱ u̱m somot m-ho̱r m-ho̱r m-ha u̱ Tarshis. Ko̱ ba u̱m nape̱ u̱zu̱ bo̱ wa-u-nya wa tu̱msu̱ Ru̱-u̱ u̱r-o̱n, tu̱msu̱ wa za ho̱r-mu̱ u̱s-ryab, bo̱ o̱ u̱t-cwan ne̱ tu̱ baru̱mte̱ da, tu̱msu̱ ko mu̱ne̱ bo̱ o̱ zo̱ngi zo̱ngi bo̱ hast jab-u̱ ró du̱gu̱ hatu̱n swadu̱ u̱r-ko̱b. <verse eid="JON 4:2"/><verse number="3" style="v" sid="JON 4:3"/>Yawe, kab fat-u̱r ri da-o̱, rem u̱zu̱ ze̱k u̱r-zwar u̱m mar.&gt;&gt; <verse eid="JON 4:3"/><verse number="4" style="v" sid="JON 4:4"/>Yawe zu̱, &lt;&lt;¿No̱ng u̱r-zwar bo̱ no̱m u̱s-ryab u̱ mo̱t-u̱t tun-to̱?&gt;&gt; <verse eid="JON 4:4"/><verse number="5" style="v" sid="JON 4:5"/>Yunana aru̱k m-rwu̱ du̱gu̱ me̱ u-bo̱ wa do̱'e̱ wa shu̱'u̱t u̱ de̱ku̱n be-de̱ u-do̱m u-bo̱ ne̱. Wa no̱m de̱ku̱n rimpa-de̱ remu̱ wa kum-u̱t m-yara. Wa shu̱'u̱t u̱ me̱, wa hyen-u̱t no̱m-tu̱ Ru̱-u̱ de̱ no̱mu̱ bo̱-u̱ Neneba. <verse eid="JON 4:5"/><verse number="6" style="v" sid="JON 4:6"/>Da-u̱ wa o̱o̱ge̱ u̱-me̱ u̱r-rimpa, Yawe u-Ru̱ wu̱' yaku̱n ku̱wu̱t-du̱ u̱t-ran apu̱n remu̱ ya habte̱ wu̱n du̱ng-mu̱ u̱r-hi, ya rogom ya no̱mu̱ wu̱n m-yara. Yunana nom u̱r-so̱ sok remu̱ ku̱wu̱t-du̱ u̱t-ran ya. <verse eid="JON 4:6"/><verse number="7" style="v" sid="JON 4:7"/>Da-u̱ is gase̱ u̱r-wu̱n te̱p te̱p, Ru̱-u to̱mo̱n u̱t-zwa, tu̱ tu̱'se̱ ku̱wu̱t-du̱ u̱t-ran ya, ya gu̱u̱s. <verse eid="JON 4:7"/><verse number="8" style="v" sid="JON 4:8"/>Da-u̱ ho̱-du̱ rwu̱ne̱, Ru̱-u̱ to̱mo̱n mya-m yat-mo̱ du̱gu̱ u-do̱m. Ho̱-yu̱ gu̱p Yunana u̱r-hi har wa o̱o̱g u̱ssa u̱t-byu̱z, wa o̱ u̱t-sa m-mar. Se̱ wa zu̱, &lt;&lt;Ze̱k u̱r-zwar u̱m m-mar u̱zu̱ u̱m fot ne̱.&gt;&gt;<verse eid="JON 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9"/>Ru̱-u̱ zu̱ Yunana, &lt;&lt;¿No̱mu̱g bo̱ u̱r-zwar bo̱ no̱m u̱s-ryab u̱ remu̱ mar-mu̱ ku̱wu̱t-du̱ u̱t-ran de̱?&gt;&gt;</para>
  <para style="p" vid="JON 4:9">Yunana zu̱, &lt;&lt;Kamu̱g u̱m no̱m u̱s-ryab, ryab-su̱ te m-mar.&gt;&gt;<verse eid="JON 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 4:10"/>Yawe zu̱, &lt;&lt;¿Kamu̱g bo̱ ho̱g o̱n-du̱ ku̱wu̱t-du̱ u̱t-ran yu̱ o̱ zu̱ bo̱ kawe̱ ya da? Bo̱ wa'e̱ tu̱msu̱ ya ne̱n-u̱t da. Ya apku̱n u̱ gyu̱p-mu̱ m-gan ya mu̱r u̱ mo̱ko̱n gyu̱p-mo̱. <verse eid="JON 4:10"/><verse number="11" style="v" sid="JON 4:11"/>¿Kamu̱g u̱m ho̱g o̱n-du̱ Neneba bo̱-u yat-o̱ da? Bo̱-u̱ o̱tte̱ ya'ag i ze̱ge̱ u̱t-zo̱ngu u-ko̱k u̱ kwaz-du̱ u̱r-gan (120,000) i nape̱ no̱m-u so̱-o̱ u̱ yo̱-o̱ ne̱ da. Tu̱msu̱ bisa-tu̱ o̱ro u-tát u̱-me bo̱-u o̱. ¿Ku̱mge̱ u̱m ho̱g o̱n-du̱ bo̱-u o̱ da?&gt;&gt;<verse eid="JON 4:11"/></para>
  <chapter eid="JON 4"/>
</usx>
