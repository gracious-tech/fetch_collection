  <para style="h">હિબ્રૂ</para>
  <para style="toc1">હિબ્રૂઓને પત્ર</para>
  <para style="toc2">હિબ્રૂ</para>
  <para style="toc3">હિબ્રૂ</para>
  <para style="mt1">હિબ્રૂઓને પત્ર</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s1">ઈશ્વરનાં અંતિમ શબ્દો: તેમનાં પુત્ર</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />પ્રાચીન સમયમાં ઈશ્વર આપણા પિતૃઓ સાથે પ્રબોધકો દ્વારા જુદી જુદી રીતે અનેકવાર બોલ્યાં હતા, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />પરંતુ આ છેલ્લા યુગમાં પુત્ર કે જેને તેમણે સઘળાના વારસ ઠરાવ્યા, અને વળી જેમના વડે તેમણે સૃષ્ટિ ઉત્પન્ન કરી, તેમની દ્રારા આપણી સાથે બોલ્યા. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />પુત્ર ઈશ્વરના મહિમાનું તેજ તથા તેના સત્વની આબેહૂબ પ્રતિમા છે, અને પોતાના પરાક્રમના શબ્દથી નિભાવી રાખે છે; તેઓ પાપોનું પ્રાયશ્ચિત કરીને તેઓ સ્વર્ગમાં મહિમાની જમણી બાજુએ બિરાજમાન છે. <verse eid="HEB 1:3" /><verse number="4" style="v" sid="HEB 1:4" />તેથી, તેમને જે નામ વારસામાં મળ્યું છે તેટલે દરજ્જે તેઓને દૂતો કરતાં અત્યંત ઉચ્ચ સ્થાન પ્રાપ્ત થયું છે.<verse eid="HEB 1:4" /></para>
  <para style="s1">દૂતોથી મોટા પુત્ર</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 1:5" />કારણ કે ઈશ્વરે કયા દૂતને કયારેય કહ્યું છે કે,</para>
  <para style="q1" vid="HEB 1:5">“તું મારો પુત્ર છે;</para>
  <para style="q2" vid="HEB 1:5">આજે હું તારો પિતા થયો છું?”</para>
  <para style="m" vid="HEB 1:5">વળી તેમણે,</para>
  <para style="q1" vid="HEB 1:5">“હું તેનો પિતા થઈશ,</para>
  <para style="q2" vid="HEB 1:5">અને તે મારો પુત્ર થશે?”<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />જયારે તે પ્રથમજનિતને જગતમાં લાવે છે, ત્યારે તે કહે છે કે,</para>
  <para style="q1" vid="HEB 1:6">“ઈશ્વરનાં સર્વ દૂતો તેની આરાધના કરો.”<verse eid="HEB 1:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 1:7" />પોતાના દૂતો વિશે તે એમ કહે છે કે,</para>
  <para style="q1" vid="HEB 1:7">“તે પોતાના દૂતોને વાયુરૂપ અને</para>
  <para style="q2" vid="HEB 1:7">અગ્નિની જવાળા જેવા પોતાના સેવકોને કરે છે.”<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />પરંતુ પુત્ર વિશે તે કહે છે,</para>
  <para style="q1" vid="HEB 1:8">“હે ઈશ્વર, તારું રાજ્યાસન સદાકાળ ટકશે;</para>
  <para style="q2" vid="HEB 1:8">અને તારો રાજદંડ ન્યાયીપણાનો દંડ છે.<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />તું ન્યાયીપણાને ચાહે છે અને અન્યાયીપણાનો ધિક્કાર કરે છે; તેથી ઈશ્વર, એટલે તારા ઈશ્વરે,</para>
  <para style="q2" vid="HEB 1:9">તારા સાથીઓ કરતાં અધિક ગણીને આનંદરૂપી તેલથી અભિષેક કયોઁ છે.<verse eid="HEB 1:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />વળી તે કહે છે,</para>
  <para style="q1" vid="HEB 1:10">“હે પ્રભુ, આરંભમાં તેં પૃથ્વીનો પાયો નાંખ્યો,</para>
  <para style="q2" vid="HEB 1:10">અને આકાશો તારા હાથની કૃતિ છે.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />તેઓ સવઁ નાશ પામશે, પરંતુ તું સદાકાળ રહેશે.</para>
  <para style="q2" vid="HEB 1:11">તેઓ જર્જરિત વસ્ત્ર સમાન જીણઁ થઈ જશે.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />તું તેમને ઝભ્ભાની માફક વાળી લેશે</para>
  <para style="q2" vid="HEB 1:12">અને વસ્ત્રની પેઠે તેઓને બોલવામાં આવશે;</para>
  <para style="q1" vid="HEB 1:12">પરંતુ તું પોતે સદાકાળ એવો ને એવો જ રહેશે.</para>
  <para style="q2" vid="HEB 1:12">તારાં વર્ષોનો કદી અંત આવશે નહિ.”<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />પણ ઈશ્વરે કયા દૂતને કદી એમ કહ્યું છે કે,</para>
  <para style="q1" vid="HEB 1:13">“જયાં સુધી હું તારા સર્વ શત્રુઓને તારું પાયાસન ન કરું,</para>
  <para style="q2" vid="HEB 1:13">ત્યાં સુધી તું મારે જમણે હાથે, બેસ?”<verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />શું તેઓ સવઁ સેવા કરનાર આત્મા નથી તેઓને તારણનો વારસો પામનારાઓની સેવા કરવા સારું બહાર મોકલી દેવામાં આવ્યા નથી?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s1">ધ્યાનમાં લેવાની ચેતવણી</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />આથી આપણે જે સાંભળ્યું છે તે પર વિશેષ ધ્યાન આપીએ, એ માટે કે આપણે તેમાંથી ભટકી ન જઈએ. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />કેમકે દૂતો દ્રારા કહેલું વચન જો સત્ય ઠયુઁ, અને દરેક પાપનું આજ્ઞાભંગનું યોગ્ય ફળ મળ્યું, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />તો આવાં મહાન તારણ વિશે બેદરકાર રહીને આપણે શી રીતે બચીશું? પ્રથમ પ્રભુએ આ તારણનો માર્ગ પ્રગટ કર્યો, અને જેઓએ તેમનું સાંભળ્યું તેઓએ આપણી સમક્ષ એ વિશે ખાતરી કરી આપી. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />ઈશ્વરે પોતે પણ ચિહ્નો, અદભુત કૃત્યો તથા ચમત્કારો વડે સાક્ષી પૂરી છે, અને પવિત્ર આત્મા તરફથી ખાસ કૃપાદાન બક્ષીને એ વાતની ખાતરી કરાવી છે.<verse eid="HEB 2:4" /></para>
  <para style="s1">ઈસુ સંપૂણઁ માણસ બન્યાં</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />વળી જે આવનાર જગત વિશે અમે વાત કરીએ છીએ, તેણે તેને દૂતોના નિયંત્રણ સોંપ્યું નથી. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />પણ એક જગ્યાએ એવી સાક્ષી પૂરી છે કે:</para>
  <para style="q1" vid="HEB 2:6">“મનુષ્ય કોણ કે તમે તેનું સ્મરણ કરો,</para>
  <para style="q2" vid="HEB 2:6">મનુષ્યપુત્ર કોણ કે, તમે તેની કાળજી રાખો?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />કારણ કે તમે તેને દૂતો કરતાં થોડો ઊતરતો બનાવ્યો;</para>
  <para style="q2" vid="HEB 2:7">તમે તેના શિરે ગૌરવ તથા માનનો મુગટ પહેરાવ્યો છે.<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />તમે તેના પગ તળે સઘળું મુકયું છે.”</para>
  <para style="m" vid="HEB 2:8">તેને સર્વસ્વનો અધિકારી બનાવ્યો છે. તેના અધિકારમાંથી કાંઈ જ બાકાત નથી. તો સઘળું તેને સ્વાઘીન કરવાથી તેને ન કયુઁ હોય એવું તેણે કંઇ રહેવા દીધું નહિ. પણ સઘળું તેને સ્વાધીન કયું, એમ હજુ સુધી આપણી નજરે પડતું નથી. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />પરંતુ આપણે ઈસુને જોઈએ છીએ, જેને થોડા સમય માટે તેમને દૂતો કરતાં ઊતરતું સ્થાન આપવામાં આવ્યું. હવે ઈશ્વરે તેમને ગૌરવ તથા માનનો મુગટ પહેરાવ્યો. કારણ કે તેમણે મરણ સહન કર્યું, ઈશ્વરની મહાન દયા થકી પ્રત્યેક વ્યકિતને માટે મરણ સહન કરે.<verse eid="HEB 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 2:10" />જેને અથેઁ સઘળાં છે તથા જેનાથી સઘળા ઉત્પન્ન થયા છે, તેને એ ઘટિત હતું કે, તે ઘણાં દીકરા દીકરીઓને ગૌરવમાં લાવતાં તેના તારણના અધિકારીને દુઃખ દ્રારા પરિપૂણઁ કરે. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />આપણને પવિત્ર કરનાર તથા જેઓને પવિત્ર કરવામાં આવે છે, તેઓ સવઁ એકથી જ છે; એ માટે તે તેઓને પોતાના ભાઈઓ બહેનો કહેતાં શરમાતા નથી. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />તેઓ કહે છે,</para>
  <para style="q1" vid="HEB 2:12">“હું મારા ભાઈઓ અને બહેનોમાં તમારું નામ પ્રગટ કરીશ,</para>
  <para style="q2" vid="HEB 2:12">મંડળીમાં સ્તોત્ર ગાઇને હું તારી સ્તુતિ કરીશ.”<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />અને વળી,</para>
  <para style="q1" vid="HEB 2:13">“હું તેમનાં પર મારો વિશ્વાસ મુકીશ.”</para>
  <para style="m" vid="HEB 2:13">ફરી તેમણે કહ્યું,</para>
  <para style="q1" vid="HEB 2:13">“મને આપવામાં આવેલા તેનાં બાળકો અને હું અહીં છીએ.”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />એ બાળકો માંસ અને લોહીનાં બનેલાં છે, માટે તેઓ પણ તે જ રીતે તેઓના ભાગીદાર થયાં; કે જેથી તેઓ પોતે મરણ પામીને મરણ પર સત્તા ધરાવનારનો, એટલે શેતાનનો નાશ કરે; <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />અને જીવન પર્યંત મૃત્યુના ભયને લીધે ગુલામ જેવી દશામાં જીવતાંઓનો છુટકારો કરે. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />કેમકે તેઓ દૂતોને સહાય કરતા નથી, પણ અબ્રાહમના સંતાનોને સહાય કરે છે. <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />તેથી તેમને સઘળી બાબતોમાં પોતાનાં ભાઈઓના જેવા થવું જોઇતું હતું, જેથી તેઓ લોકોનાં પાપનું પ્રાયશ્ચિત કરવાને ઇશ્વરને લગતી બાબતોમાં દયાળુ તથા વિશ્વાસુ પ્રમુખયાજક થાય. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />કેમકે તેમનું પરીક્ષણ થવાથી તેમણે દુઃખ સહન કયાઁ, તેથી જેઓનું પરીક્ષણ થાય છે તેઓને સહાય કરવાને તેઓ શકિતમાન થાય.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s1">મસીહ મોશે કરતાં મોટા</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />તેથી, પવિત્ર ભાઈઓ અને બહેનો, સ્વગીઁય તેડાના ભાગીદાર, આપણે જે સ્વીકાયુઁ છે તેના પ્રેષિત તથા પ્રમુખયાજક ઈસુ પર લક્ષ રાખો. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />ઈશ્વરના ઘરની સેવામાં જેમ મોશે વિશ્વાસુ હતો તેમ તેઓ પણ પોતાને પ્રમુખયાજક તરીકે નીમનારને વિશ્વાસુ રહ્યા. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />જેમ મકાન કરતાં તેને બાંધનારને વિશેષ પ્રશંશા ઘટે છે, તેમ મોશે કરતાં ઈસુ અધિક મહિમાને યોગ્ય ગણાયા છે. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />દરેક મકાનને બાંધનાર કોઈક તો હોય છે જ, પરંતુ સર્વનો સર્જનહાર ઈશ્વર છે. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />જે વાત પ્રગટ થવાની હતી તેની સાક્ષી પૂરવાં સારું ઈશ્વરના ઘરમાં મોશે વિશ્વાસુ સેવક તરીકે હતો. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />પણ મસીહ પુત્ર તરીકે ઇશ્વરનાં ઘર પર વિશ્વાસુ હતા; જો આપણે અંત સુધી હિંમત તથા આશાનું ગૌરવ દ્રઢ રાખીએ, તો આપણે તેનું ઘર છીએ.<verse eid="HEB 3:6" /></para>
  <para style="s1">અવિશ્વાસ સામે ચેતવણી</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />તેથી, જેમ પવિત્ર આત્મા કહે છે તેમ:</para>
  <para style="q2" vid="HEB 3:7">“જો તમે આજ તેમની વાણી સાંભળો,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />જેમ તમે અરણ્યમાં કસોટીનાં સમયમાં</para>
  <para style="q1" vid="HEB 3:8">તમે કચકચ કરી,</para>
  <para style="q2" vid="HEB 3:8">તેમ તમારાંં હૃદયો કઠણ કરશો નહિ,<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />જેમ તમારા પૂવઁજોએ મારી કસોટી કરી અને મને પારખ્યો,</para>
  <para style="q2" vid="HEB 3:9">તેમ છતાં તેમણે ચાળીસ વર્ષ સુધી મારા કામ જોયા.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />તેથી જ હું તે પેઢી પર ગુસ્સે થયો;</para>
  <para style="q2" vid="HEB 3:10">‘અને મેં કહ્યું તેઓના હૃદય હંમેશા ભટકી જાય છે,</para>
  <para style="q2" vid="HEB 3:10">અને તેઓએ મારા માગઁ જાણ્યાં નહિ’<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />તેથી મેં મારા ક્રોધમાં પ્રતિજ્ઞા કરી કે,</para>
  <para style="q2" vid="HEB 3:11">‘તેઓ મારા વિશ્રામમાં કદી પ્રવેશ કરશે નહિ.’ ”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />માટે ભાઈઓ અને બહેનો સાવચેત રહો, રખેને તમારાંમાંનાં કોઇનું હ્રદય અવિશ્વાસના કારણથી પાપી થાય, અને તે જીવંત ઈશ્વરથી દૂર જાય. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />પણ જયાં સુધી “આજ” કહેવાય છે, ત્યાં સુધી દરરોજ એકબીજાને ઉતેજન આપો, જેથી તમારાંમાંનો કોઈ પાપનાં કપટથી કઠણ ન થાય. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />જો આપણે આરંભમાં રાખેલા વિશ્વાસને અંત સુધી દ્રઢતાથી પકડી રાખીએ, તો આપણે મસીહના ભાગીદાર થયા છીએ. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />જેમ કહેવામાં આવ્યું છે:</para>
  <para style="q1" vid="HEB 3:15">“જો આજ તમે તેમની વાણી સાંભળો,</para>
  <para style="q2" vid="HEB 3:15">તો તમે તમારાંં હૃદય કઠણ કરશો નહિ,</para>
  <para style="q2" vid="HEB 3:15">જેમ તમે કચકચ કરી તેમ.”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />ઈશ્વરની વાણી સાંભળ્યા છતાં જેમણે તેમની વિરુધ્ધ બંડ પોકાયુઁ, એ કોણ હતા? શું તેઓ મોશેની આગેવાની નીચે ઈજિપ્તમાંથી નીકળી આવનાર ન હતા? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />અને ચાળીસ ચાળીસ વર્ષ સુધી તેઓ કોના પર ગુસ્સે થયાં? શું તે એ લોકો ન હતાં કે જેઓએ પાપ કયુઁ અને તેમના શરીરો અરણ્યમાં નાશ પામ્યા? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />અને જેઓએ માન્યું નહિ તે સિવાય બીજા કોને વિશે ઈશ્વરે સમ ખાધા કે, તેઓ મારા વિશ્રામમાં પ્રવેશ કરશે નહિ. <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />તો આપણે જોઈએ છીએ કે તેઓ તેમના અવિશ્વાસને કારણે પ્રવેશ કરી શક્યા નહિ.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="s1">ઇશ્વરના લોકો માટે વિશ્રામ</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />તેથી, તેમના વિશ્રામમાં પ્રવેશવાનું વચન હજું પણ મોજૂદ છે, તેમ છતાં આપણે સાવચેત રહેવું જોઈએ રખેને તમારાંમાંથી કોઈ પણ નિષ્ફળ ન જાય. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />કેમકે જેમ આપણને તેમ તેઓને પણ સુસમાચાર પ્રગટ કરવામાં આવેલ છે, પણ જે સંદેશો તેઓએ સાંભળ્યો તે તેઓને લાભકારક થયો નહિ, કેમકે જેઓએ આજ્ઞા પાળી તેઓની સાથે તેઓ વિશ્વાસમાં એક થયાં નહિ. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />હવે આપણે વિશ્વાસ કરનારા વિશ્રામમાં પ્રવેશ કરીએ છીએ, જેમ ઈશ્વરે કહ્યું છે,</para>
  <para style="q1" vid="HEB 4:3">“મેં મારા ક્રોધમાં પ્રતિજ્ઞા લીધી કે,</para>
  <para style="q2" vid="HEB 4:3">‘તેઓ મારા વિશ્રામમાં કદી પ્રવેશ કરશે નહિ.’ ”</para>
  <para style="m" vid="HEB 4:3">જો કે જગતની ઉત્પતિ થઈ ત્યારથી તેમના કામો પૂરાં થયેલા છે. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />કેમકે કોઇક જગ્યાએ સાતમાં દિવસ વિશે તેમણે આ શબ્દોમાં કહ્યું છે કે: “સાતમાં દિવસે ઈશ્વરે પોતાના કામોથી વિશ્રામ કર્યો.” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />અને વળી એ જ જગ્યાએ તે કહે છે કે, “તેઓ મારા વિશ્રામમાં પ્રવેશ કરશે નહિ.”<verse eid="HEB 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 4:6" />તો કેટલાકને હજુ પ્રવેશ કરવાનું બાકી છે, અને જેઓને પહેલાં તે સુસમાચાર પ્રગટ કરવામાં આવ્યા હતા, તેઓની આજ્ઞાભંગને કારણે તેઓ વિશ્રામવારમાં પ્રવેશ પામી શક્યાં નહિ. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />માટે ઈશ્વરે એક ચોક્કસ દિવસ ઠરાવ્યો, અને તેને “આજ” કહ્યો ઘણાં સમય પછી, તેમણે દાવિદ મારફતે આ વાત કહી, જેમ કે પહેલેથીજ તેનો ઉલ્લેખ કરવામાં આવ્યો છે:</para>
  <para style="q1" vid="HEB 4:7">“આજ જો તમે તેની વાણી સાંભળો,</para>
  <para style="q2" vid="HEB 4:7">તો તમે તમારાંં હૃદય કઠણ કરશો નહિ.”<verse eid="HEB 4:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 4:8" />કેમકે જો યહોશુઆએ તેઓને સાબ્બાથ-વિશ્રામ<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">વિશ્વામદિવસ તરીકે પણ ભાંષાતર કરવામાં આવ્યું છે, આ એક યહૂદી વિશ્વામવાર છે.</char></note> આપ્યો હોત, તો ત્યાર પછી ઈશ્વર બીજા દિવસ વિશે ન કહેત. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />તો પછી, ઈશ્વરના લોકો માટે વિશ્રામનો દિવસ હજુ બાકી છે; <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />કેમકે જેમ ઈશ્વરે પોતાના કામોથી વિશ્રામ લીધો, તેમ વિશ્રામમાં જેણે પ્રવેશ કયોઁ છે, તે પણ પોતાના કામથી વિશ્રામ લે છે. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />એ માટે આપણે તે વિશ્રામમાં પ્રવેશવા માટે ખંત રાખીને યત્ન કરીએ, જેથી કોઈ પણ આજ્ઞાભંગના ઉદાહરણને અનુસરીને નાશ ન પામે.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />કેમકે ઈશ્વરનાં વચન જીવંત અને સક્રિય છે, તે કોઇ પણ બેધારી તલવાર કરતા પણ તીક્ષ્ણ હથિયાર કરતાં પણ તીક્ષ્ણ છે. તે જીવ અને આત્માને, સાંધા અને મજ્જાને જુદાં પાડે એટલે સુધી વીંધનારો છે, અને હ્રદયના વિચારો અને વલણનો ન્યાય કરે છે. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />આખી સૃષ્ટિમાં તેમની સમક્ષ કંઈ પણ ગુપ્ત નથી, જેમને આપણે હિસાબ આપવાનો છે તેમની નજર સમક્ષ સઘળું ખુલ્લું છે.<verse eid="HEB 4:13" /></para>
  <para style="s1">ઈસુ મહાન પ્રમુખયાજક</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />તેથી, આપણી પાસે એક મહાન યાજક છે. જે સ્વર્ગમાં ગયેલાં છે, એટલે ઈશ્વરના પુત્ર ઈસુ મસીહ, માટે આપણે જે વિશ્વાસનો દાવો કરીએ છીએ તે દ્રઢતાથી પકડી રાખીએ. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />કેમકે આપણી પાસે એવો પ્રમુખયાજક નથી જે આપણી નિર્બળતાઓ પ્રત્યે સહાનુભૂતિ બતાવી ન શકે, પણ આપણી જેમ દરેક પ્રકારે પરીક્ષણો પામેલા છતાં તેઓ નિષ્પાપ રહ્યા. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />તેથી દયા પામવાને, અને અગત્યને સમયે સહાય મેળવવાને માટે આપણે હિંમતથી કૃપાસનની પાસે જઈએ.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />દરેક પ્રમુખયાજક માણસોમાંથી પસંદ કરવામાં આવેલો હોવાથી ઈશ્વર સંબંઘીની બાબતોમાં માણસોને માટે નિમેલો છે, જેથી તે પાપને માટે તે ઈશ્વરને બલિદાન કરે છે. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />તે પોતે પણ નબળાઈઓથી ઘેરાયેલો હોવાથી તે અજ્ઞાનીઓ તથા ભૂલ ખાનારાઓ પ્રત્યે સહાનુભૂતિથી વતિઁ શકે છે. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />આથી તે પોતાના પાપ માટે તથા બીજાઓનાં પાપ માટે પણ અર્પણો કરે છે. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />અને કોઈ પણ આ માન પોતે લેતો નથી, પણ જયારે તેને ઈશ્વર દ્રારા તેડવામાં આવે છે ત્યારે તે લે છે, જેમ આરોનની પસંદગી કરી, તેમ.<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />એ જ પ્રમાણે, પ્રમુખયાજક બનવાનું માન મસીહે પોતે પસંદ કર્યું નહોતું; પરંતુ ઈશ્વરે તેમને કહ્યું,</para>
  <para style="q1" vid="HEB 5:5">“તું મારો પુત્ર છે;</para>
  <para style="q2" vid="HEB 5:5">આજ હું તારો પિતા થયો છું.”<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />વળી તે જ પ્રમાણે બિજે ઠેકાણે તેઓ કહે છે,</para>
  <para style="q1" vid="HEB 5:6">“તું મેલ્ખીસેદેકની પરંપરામાં</para>
  <para style="q2" vid="HEB 5:6">સદાને માટે યાજક છે.”<verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />ઈસુ જયારે આ પૃથ્વી પરના જીવનમાં હતા, તેમણે ઊંડી વેદના અને આંસુઓ સહિત મરણમાંથી છોડાવનાર સર્વશકિતમાન ઈશ્વરને પ્રાર્થના તથા કાલાવાલા કયાઁ, અને તેમને સાંભળવામાં આવ્યા કેમકે તેઓ ઈશ્વરને આધીન રહેતાં હતા. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />તેઓ ઈશ્વરપુત્ર હોવા છતાં દુઃખસહનના અનુભવથી આધીન થવાનું શીખ્યા. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />એક વાર પરિપૂર્ણ થયા પછી, પોતાની આજ્ઞા પાળનારા સવઁને સારું અનંતકાલિક તારણ આપનાર બન્યા; <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />મેલ્ખીસેદેકની માફક ઈશ્વરે તેમને પણ પ્રમુખયાજક તરીકે જાહેર કર્યા.<verse eid="HEB 5:10" /></para>
  <para style="s1">પતિત થવા સામે ચેતવણી</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />મારે આના સંબંધી ઘણું કહેવાનું છે, પણ તમે તે સમજી શકો તેમ નથી, કેમકે તમે સાંભળવા માંગતા નથી. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />ખરેખર તો, અત્યાર સુધીમાં તમારે ઉપદેશક થવું જોઇતું હતું; પણ અત્યારે તો ઈશ્વરનાં વચનોનાં મૂળભૂત સિધ્ધાંતો શું છે તે કોઈ તમને શીખવે તેવી જરૂરિયાતો ઊભી થઈ છે. ભારે ખોરાક નહિ, પણ જાણે દૂધની અગત્યતા હોય એમ લાગે છે! <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />જે કોઇ દૂધ પર જીવે છે તે હજુ બાળક જ છે, તે ન્યાયીપણાં સંબંઘી બિનઅનુભવી છે. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />પણ જેઓ પુખ્ત છે, એટલે જેઓની ઈંદ્રિઓ ખરુંખોટું પારખવામાં કેળવાયેલી છે, તેઓને સારું ભારે ખોરાક છે.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />હવે આપણે મસીહના સિધ્ધાંતના પ્રાથમિક શિક્ષણથી સંપૂણઁતા સુધી આગળ વધીએ; મરણ તરફ લઇ જતાં પસ્તાવાનો તથા ઈશ્વર પરના વિશ્વાસનો; <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />તથા બાપ્તિસ્મા, આત્મિક કૃપાદાનો, મૂએલાંનું પુનરુત્થાન તથા અનંતકાલિક ન્યાયચુકાદા વિશે પણ હવે તમારે વધુ શિક્ષણની જરૂર નથી. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />અને જો ઈશ્વર પરવાનગી આપશે તો આપણે એમ કરીશું.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />જેઓ એક વાર પ્રકાશિત થયા, જેઓએ સ્વગીઁય દાનોનો અનુભવ કયોઁ. જેઓ પવિત્ર આત્માના ભાગીદાર થયા, તેઓને માટે અશક્ય છે, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />જેઓએ ઈશ્વરનાં વચનની ઉત્તમતા જાણી હોય, આવનાર યુગનાં પરાક્રમનો અનુભવ કયોઁ હોય <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />અને જેઓ પડી ગયા છે, તેઓને ફરીથી પસ્તાવો કરાવવા પાછા લાવવાં એ અશક્ય છે. કેમકે તેઓ પોતાના નુકશાનને માટે ફરીથી ઇશ્વરના પુત્રને ક્રૂસે જડે છે, અને જાહેરમાં તેમનું અપમાન કરે છે. <verse eid="HEB 6:6" /><verse number="7" style="v" sid="HEB 6:7" />જમીન કે જે વારંવારના વરસાદનું શોષણ કરે છે અને જેઓ તેને ખેડે છે તેમને માટે ઉપયોગી પાક ઉત્પન્ન કરે છે, અને તે ઇશ્વરનો આશીઁવાદ મેળવે છે. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />પણ જે જમીનમાં કાંટા ઝાંખરા ઊગે છે તે બિનઉપયોગી અને શાપિત થયેલી છે અને તેને બાળી નાંખવામાં આવે છે.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />પ્રિય મિત્રો, જો કે અમે આ પ્રમાણે કહીએ છીએ, તોપણ અમને ખાતરી છે કે તમારામાં વધુ સારી બાબતો છે, અને તે બાબતો તારણની છે. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />કેમકે ઈશ્વર અન્યાયી નથી; કે તેઓ તમારા કામને અને તેમના લોકો પર જે પ્રેમ બતાવ્યો છે, અને હજુ કરો છો એ બધું વીસરી જાય. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />વળી અમારી અંતઃકરણની ઇચ્છા છે કે તમારાંમાંનો દરેક તમારી આશા પૂર્ણ થાય માટે, એવો જ ઉત્સાહ અંત સુધી રાખે. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />અમે નથી ઇચ્છતા કે તમે આળસુ બનો, પરંતુ જેઓ વિશ્વાસ અને ધીરજથી વચનોનાં વારસ છે તેઓનું અનુકરણ કરો.<verse eid="HEB 6:12" /></para>
  <para style="s1">ઈશ્વરનું ખાતરીભયુઁ વચન</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />જયારે ઈશ્વરે અબ્રાહમને વચન આપ્યું, ત્યારે પોતાનાં કરતાં કોઈ મોટો ન હતો કે જેના સમ તે ખાય, માટે તેમણે પોતાના જ સમ ખાઈને, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />કહ્યું “હું તને ચોક્કસ આશીર્વાદ આપીશ, અને તને ઘણાં વંશજો આપીશ.” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />અને અબ્રાહમે ધીરજથી રાહ જોયા પછી તેને આપેલા વચનનું ફળ મળ્યું.<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />માણસ પોતાના કરતાં મોટી વ્યકિતના નામે સમ ખાય છે, અને સમથી સર્વ વાદવિવાદનો અંત આવે છે. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />કારણ કે ઈશ્વર ઈચ્છતા હતા કે તેમનો અપરીવતઁનશીલ સ્વભાવ વચનનાં વારસદારોને સ્પષ્ટ થાય, તેમણે સમ દ્રારા તેની ખાતરી આપી. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />ઈશ્વરે આમ એટલા માટે કયુઁ કે બે નિશ્ચિત બાબતો, જેમાં ઈશ્વર જૂઠું બોલી શકતા નથી, આપણી આગળ મૂકેલી આશા પકડવા સારું આશ્રય માટે દોડનારને ઘણું ઉત્તેજન મળે. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />આ આશા આપણા આત્માને માટે લંગર સમાન છે. જે મજબૂત અને સુરક્ષિત છે. તે પડદા પાછળના આંતરિક સ્થાનમાં પ્રવેશ કરે છે. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />ત્યાં ઈસુએ, અગ્રેસર થઈને આપણે માટે પ્રવેશ કર્યો છે, અને મેલ્ખીસેદેકની પરંપરા પ્રમાણે તે હંમેશને માટે પ્રમુખયાજક થયા છે.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s1">મેલ્ખીસેદેક યાજક</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />આ મેલ્ખીસેદેક શાલેમનો રાજા તથા પરાત્પરના ઈશ્વરનો યાજક હતો. ઘણા રાજાઓને હરાવીને અબ્રાહમ પાછો આવી રહ્યો હતો ત્યારે તેને મળ્યો અને તેને આશીર્વાદ આપ્યો. <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />અને અબ્રાહમે તેને બધી વસ્તુઓનો દસમો ભાગ આપ્યો. તેના નામનો પહેલો અથઁ “ન્યાયીપણાનો રાજા છે” અને “તે શાલેમનો રાજા છે.” એટલે “શાંતિનો રાજા” છે. <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />તે માતાપિતા વિનાનો, વંશાવળી વગરનો, દિવસની શરૂઆત કે જીવનના અંત વગરનો, પણ તે ઈશ્વરપુત્ર જેવો છે અને સદા યાજક રહે છે.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />તે કેવો મહાન હશે તેનો વિચાર કરોઃ પૂર્વજ અબ્રાહમે પણ તેને લુંટનો દસમો ભાગ આપ્યો. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />હવે નિયમશાસ્ત્ર પ્રમાણે લેવીના વંશજો યાજક બને છે, તેઓને લોકોની પાસેથી, એટલે પોતાના ભાઈ ઇઝરાયેલીઓ પાસેથી દશાંશ લેવાનો હુકમ છે, ભલે તેઓ અબ્રાહમના વંશજ હોય. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />જો કે આ માણસ લેવીના વંશજોમાંનો ન હતો, છતાં તેણે અબ્રાહમ પાસેથી દશાંશ લીધો, અને જેને વચનો આપવામાં આવ્યા હતાં તેને આશીર્વાદ આપ્યો. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />નાનાંથી મોટાને આશીઁવાદ મળે છે, એમાં કંઈ પણ શંકા નથી. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />એક કિસ્સામાં, મર્ત્ય હોવા છતાં દશાંશ સ્વીકારે છે, પણ બિજા કિસ્સામાં, એના દ્રારા જે સદા જીવંત છે. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />વળી એમ પણ કહી શકાય કે જે લેવી દશમો ભાગ લે છે, તેણે પણ અબ્રાહમ મારફતે દશાંશ આપ્યો. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />કેમકે જયારે મેલ્ખીસેદેક જયારે અબ્રાહમને મળ્યો, ત્યારે તે હજી તેના શરીરમાં હતો.<verse eid="HEB 7:10" /></para>
  <para style="s1">ઈસુ મેલ્ખીસેદેક જેવા</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />હવે જો લેવીયના યાજકપદથી પરિપૂણઁતા થઇ હોત, અને ખરેખર તે દ્રારા લોકોને નિયમશાસ્ત્ર મળ્યું હતું, તો આરોનના ધારા પ્રમાણે ગણાયેલો નહિ, એવો બીજો યાજક મેલ્ખીસેદેકના નિયમ પ્રમાણે ઉત્પન્ન થવાની શી અગત્ય હતી? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />જયારે યાજકપદ બદલાય છે, ત્યારે નિયમો પણ બદલાવવા જોઈએ. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />જેના સંબંધમાં એ વાતો કહેવામાં આવી છે તે બીજા કુળનો છે, અને તે કુળમાંથી કોઈએ કયારેય વેદીની સેવા કરી નથી. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />કેમકે એ સ્પષ્ટ છે કે આપણા પ્રભુ યહૂદા કુળમાંથી આવ્યા, તે કુળમાંના યાજકપદ વિશે મોશેએ કંઈ કહ્યું નથી. <verse eid="HEB 7:14" /><verse number="15" style="v" sid="HEB 7:15" />અને અમે જે કહ્યું છે તે વધારે સ્પષ્ટ છે, જો મેલ્ખીસેદેક જેવો બીજો એક યાજક ઊભો થયો છે. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />જે પોતાના પૂવઁજોના પણ આધારે યાજક નથી બન્યાં, પણ અવિનાશી જીવનનાં સામર્થ્યના આધારે યાજક બન્યા. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />કેમકે તે જાહેર કરવામાં આવ્યું છે કે:</para>
  <para style="q1" vid="HEB 7:17">“મેલ્ખીસેદેકના નિયમ પ્રમાણે</para>
  <para style="q2" vid="HEB 7:17">તું સનાતન યાજક છે.”<verse eid="HEB 7:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 7:18" />પહેલાના નિયમોને રદ કરવામાં આવે છે કારણ કે તે નિર્બળ અને બિનઉપયોગી હતો. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />(કેમકે નિયમશાસ્ત્રથી કશું પરિપૂણઁ થયું નથી), અને એક સારી આશા રજૂ થઇ છે, જે વડે આપણે ઈશ્વર પાસે નજીક જઈએ છીએ.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />અને તે સમ વિનાનું ન હતું! કેમકે બીજા તો સમ વિના યાજક થયા છે, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />પણ જયારે ઈશ્વરે તેને કહ્યું, ત્યારે તે સમ ખાઈને યાજક બન્યા:</para>
  <para style="q1" vid="HEB 7:21">“ઈશ્વરે પ્રતિજ્ઞાપૂર્વક કહ્યું છે કે,</para>
  <para style="q2" vid="HEB 7:21">અને તે કદી પોતાનો વિચાર બદલશે નહિ:</para>
  <para style="q2" vid="HEB 7:21">‘તું સદાને માટે યાજક છે.’ ”<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />આ સમને કારણે, ઈસુ વધુ સારાં કરારના જામીન થયા.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />હવે એ યાજકોમાંના ઘણાં હતાં ખરા, પણ મરણને લીધે તેઓ કાયમ રહી શક્યા નહિ; <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />પણ ઈસુ સદાકાળ જીવંત છે, અને તેમનું યાજકપદ સનાતન છે. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />આથી જે કોઈ તેમના મારફતે ઈશ્વર પાસે આવે છે, તેઓનો તે સંપૂર્ણ ઉધ્ધાર કરવા તે સમર્થ છે, તેમને માટે મધ્યસ્થી કરવા તેઓ સદા જીવંત છે.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />આથી આપણને એવા પ્રમુખયાજકની જરૂર હતી, કે જે પવિત્ર, દોષરહિત, નિષ્કલંક, પાપીઓથી અલગ છે, અને સ્વર્ગમાં સૌથી ઊંચે ચઢાવેલા છે. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />બીજા પ્રમુખ યાજકોની માફક, તેમણે પોતાનાં અને લોકોનાં પાપો માટે દરરોજ બલિદાન કરવાની જરૂર નથી. કારણ કે તેમણે પોતે એક જ વાર બધાનાં પાપો માટે બલિદાન આપ્યું. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />કેમકે નિયમશાસ્ત્ર માણસોની તેમની બધી નબળાઇઓ સાથે યાજકો તરીકે ઠરાવે છે; પણ નિયમશાસ્ત્ર પછીના સમનું વચન તો સદાકાળ સંપૂણઁ કરેલાં પુત્રને પ્રમુખયાજક ઠરાવે છે.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s1">નવા કરારના પ્રમુખયાજક</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />હવે અમે જે કહીએ છીએ તેનો સારાંશ આ પ્રમાણે છે: આપણી પાસે એવા પ્રમુખયાજક છે, જે સ્વર્ગમાં મહીમાવાન રાજયાસનની જમણી બાજુએ બિરાજેલાં છે. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />અને જે પવિત્રસ્થાનનો ખરો મંડપ માણસોએ નહિ પણ પ્રભુએ સ્થાપયો છે જેની તે સેવા કરી રહ્યા છે.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />હવે દરેક પ્રમુખયાજક અપઁણો અને બલિદાનો લાવવાં માટે નીમાયેલો હોય છે. માટે આ પ્રમુખયાજક પણ કંઈ અર્પણ લાવે તે જરૂરી છે. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />હાલ જો તે પૃથ્વી પર હોત તો તે યાજક ન બન્યા હોત, કારણ કે નિયમશાસ્ત્ર પ્રમાણે અર્પણો કરનાર યાજકો તો છે જ. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />તેઓ સ્વગઁમાની વસ્તુઓની પ્રતિછાયાની સેવા કરે છે, આ જ કારણ છે કે જયારે મોશે મંડપ બાંધવાની શરૂઆત કરી ત્યારે તેને ચેતવણી આપવામાં આવી હતી કે: “જે નમુનો તને પહાડ પર બતાવવામાં આવ્યો હતો તે પ્રમાણે બધું બનાવજે.” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />પણ હકિકતમાં ઈસુને મળેલી સેવા તેમના કરતા એટલી જ વિશેષ છે, જેટલી તે જે કરારનો મઘ્યસ્થ છે. તે જુના કરાર કરતા વિશેષ છે, કારણ કે નવો કરાર વઘુ સારા વચનો પર સ્થાપીત થયેલો છે.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />કેમકે જો પહેલાં કરારમાં કંઈ દોષ ન હોત, તો નવા કરારની આવશ્યકતા ઊભી થઈ ન હોત. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />પણ ઈશ્વરે લોકોને દોષિત ઠરાવીને કહ્યું:</para>
  <para style="q1" vid="HEB 8:8">“પ્રભુ જાહેર કરે છે, કે એવા દિવસ આવશે કે,</para>
  <para style="q2" vid="HEB 8:8">જયારે હું નવો કરાર સ્થાપન કરીશ.</para>
  <para style="q1" vid="HEB 8:8">ઇઝરાયેલનાં લોકોની સાથે,</para>
  <para style="q2" vid="HEB 8:8">અને યહૂદીયાનાં લોકોની સાથે.<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />હું તેમના પિતૃઓને ઈજિપ્ત દેશમાંથી લઈ આવ્યો</para>
  <para style="q2" vid="HEB 8:9">ત્યારે જે કરાર મેં તેઓની સાથે કર્યા હતો</para>
  <para style="q1" vid="HEB 8:9">તેના જેવો તે કરાર નથી.</para>
  <para style="q2" vid="HEB 8:9">કેમકે તેઓ મારા કરારને વિશ્વાસુ રહ્યા નહિ,</para>
  <para style="q2" vid="HEB 8:9">તેથી જ મેં તેઓને મૂકી દીધા, પ્રભુ કહે છે<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />ઇઝરાયેલ લોકો સાથે,</para>
  <para style="q2" vid="HEB 8:10">હું જે કરાર સ્થાપન કરીશ તે આ છે,</para>
  <para style="q1" vid="HEB 8:10">હું મારા નિયમો તેઓના મનમાં મુકીશ,</para>
  <para style="q2" vid="HEB 8:10">અને તેઓના હૃદયપટ પર લખીશ,</para>
  <para style="q1" vid="HEB 8:10">હું તેઓનો ઈશ્વર થઈશ અને</para>
  <para style="q2" vid="HEB 8:10">તેઓ મારા લોક થશે.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />હવે પછી કોઈ પોતાના પાડોશી કે એકબીજાને કહેશે નહિ કે:</para>
  <para style="q2" vid="HEB 8:11">‘પ્રભુને ઓળખ’</para>
  <para style="q1" vid="HEB 8:11">કારણ કે નાનાંથી માંડીને મોટાં સુધી</para>
  <para style="q2" vid="HEB 8:11">તેઓ સર્વ મને ઓળખશે.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />કેમકે હું તેઓના અપરાધો માફ કરીશ,</para>
  <para style="q2" vid="HEB 8:12">અને તેઓના પાપનું ફરી કદી સ્મરણ કરીશ નહિ.”<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />તો, નવો કરાર, એવું કહીને તેણે પહેલાં કરારને જૂનો ઠરાવ્યો છે. પણ જે જૂનું તથા જજઁર થતું જાય છે, તે નાશ પામવાની તૈયારીમાં છે.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s1">પૃથ્વી પરના મુલાકાત મંડપમાંની આરાધના</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />હવે પ્રથમ કરારમાં આરાધનાને લગતાં નિયમો હતા અને પૃથ્વીનાં પરના પવિત્રસ્થાન પણ હતા. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />મુલાકાતમંડપ ઊભો કરવામાં આવ્યો હતો. તેના પહેલાં ભાગને પવિત્રસ્થાન કહેતા હતા, ત્યાં સોનાનું સ્ટેન્ડ, ટેબલ અને અર્પિત રોટલી હતાં. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />અને બીજા પડદાની પાછળ બીજો ભાગ હતો, તેને પરમપવિત્રસ્થાન તરીકે ઓળખાતો હતો. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />તે ભાગમાં સોનાની ધૂપવેદી તથા સોનાથી મઢેલો કરારકોશ હતાં. આ કરારકોશમાં માન્ના ભરેલું સુવર્ણ પાત્ર, કળીઓ ફૂટેલી આરોનની લાકડી, અને દસ આજ્ઞાઓ લખેલ બે શિલાપાટીઓ મૂકેલાં હતાં. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />કરારકોશ પર મહિમાદર્શક કરુબીમ હતા, તેઓની છાયા દયાસન પર પડતી હતી. પરંતુ હમણાં તેઓ સંબંધી અમારાથી સવિસ્તાર કહેવાય એમ નથી.<verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />આ રીતે સર્વ વસ્તુઓ ગોઠવાઈ ગયા પછી, યાજકો નિયમીત રીતે આગલા ભાગમાં સેવા કરવા માટે જતા. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />પરંતુ અંદરના ભાગમાં માત્ર પ્રમુખયાજક જ જઈ શકતા અને તે પણ વર્ષમાં એક જ વાર, અને કયારેય પણ રકત વિના નહિ, જે તે પોતાનાં તથા લોકોનાં અજ્ઞાનતામાં કરેલાં પાપોને માટે અર્પણ કરતા. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />આ બધી બાબતો દ્વારા પવિત્ર આત્મા દર્શાવે છે કે જયાં સુધી પહેલો મંડપ કાયઁરત હતો ત્યાં સુધી પરમપવિત્રસ્થાનમાં પ્રવેશવાનો માર્ગ ખુલ્લો થયો ન હતો. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />આ વતઁમાન સમય માટે એક ઉદાહરણ છે, જે બલિદાનો તથા અર્પણો કરવામાં આવતા હતા, તે ભજન કરનારાઓનું અંતઃકરણને શુધ્ધ કરવા માટે સમર્થ ન હતાં. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />એ તો ખોરાક પાણી, સ્નાન ક્રિયા અને અનેક પ્રકારના બાહ્ય શુધ્ધિને લગતાં નવા નિયમો આવતા સુધીજ ચલાવવાને ઠરાવેલાં હતાં.<verse eid="HEB 9:10" /></para>
  <para style="s1">મસીહનું રક્ત</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />પણ મસીહ જયારે સારી બાબતો સંબંધી પ્રમુખયાજક તરીકે આવ્યા, ત્યારે જે માનવી હાથોથી બનાવેલો નહિ, જે આ સૃષ્ટિનો ભાગ નથી એવા વધુ મહાન અને સંપૂર્ણ એવા મંડપમાં પ્રવેશ્યા. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />તેઓ બકરાં કે વાછરડાંના રકતથી પ્રવેશ્યા નહિ; પણ પોતાના રકત દ્રારા એક જ વાર પરમપવિત્રસ્થાનમાં પ્રવેશ્યા, આમ સનાતન ઉધ્ધાર મેળવ્યો. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />બળદ અને બકરાનું રક્ત તથા વાછરડીની રાખ કે જે લોકો વિધિપૂવઁક અશુધ્ધ છે તેમના પર છાંટીને તેમને પવિત્ર કરવામાં આવે છે, જેથી તેઓ બહારથી શુધ્ધ થાય. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />તો પછી, મસીહનું રકત જેમણે સનાતન આત્માથી પોતાનું દોષરહિત અપઁણ ઇશ્વરને આપ્યું, તે આપણા અંતઃકરણને મૃત્યું તરફ દોરી જતા કાયોઁથી શુધ્ધ કરશે, જેથી આપણે જીવંત ઈશ્વરની સેવા કરી શકીએ. તે કેટલું બધું વિશેષ છે.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />એ જ કારણથી પહેલાં કરારના સમયમાં થયેલા પાપોની મુક્તિ મેળવવા માટે ખંડણી તરીકે મૃત્યું પામ્યા અને જેને બોલાવાયેલા છે તેઓને વચન પ્રમાણે અનંતકાલિક વારસો પામે, તે માટે મસીહ નવા કરારના મધ્યસ્થ બન્યા.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />વસિયત નામાંના કિસ્સામાં, તે કરનારનું મરણ પુરવાર કરવું જરૂરી છે. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />કેમકે વસિયતનામું કરનાર વ્યકિત મરણ પામે પછી જ તેનો અમલ થઈ શકે છે. જયાં સુધી તે વ્યકિત જીવે છે ત્યાં સુધી તેનો અમલ થતો નથી. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />એ જ કારણથી પહેલો કરાર પણ રક્ત વિના અમલમાં આવ્યો ન હતો. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />જયારે મોશેએ નિયમશાસ્ત્ર પ્રમાણે દરેક આજ્ઞા સવઁ લોકોને કહી સંભળાવ્યા પછી તેણે વાછરડાંનું લોહી, પાણી અને કિરમજી ઊન તેણે ઝૂફાની ડાળી સાથે લીધું અને તેણે ઓળિયા પર તથા લોકો પર છાંટયું. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />તેમણે કહ્યું, “આ કરારનું રક્ત છે, જેની આજ્ઞા પાળવાનું ઈશ્વરે કહ્યું છે.” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />એ જ પ્રમાણે તેણે તે રકત મુલાકાતમંડપ પર તથા સેવામાં વપરાતાં સર્વ પાત્રો પર છાંટયું હતું. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />હકિકતમાં, નિયમશાસ્ત્ર પ્રમાણે લગભગ દરેક વસ્તુ રકતથી શુધ્ધ કરવી જરૂરી છે, અને રકત વહેવડાવ્યાં વગર માફી મળતી નથી.<verse eid="HEB 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />પણ સ્વર્ગીય વસ્તુઓના નમૂનાને આ બલિદાનોથી શુધ્ધ કરવાની જરૂર હતી, તો પછી સ્વગીઁય વસ્તુઓને તો વિશેષ બલિદાન વડે શુધ્ધ કરવાની જરૂર હતી. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />કેમકે મસીહ માનવી હાથોએ બનાવેલ પવિત્રસ્થાનમાં ગયા નહિ, જે ખરાનો નમૂનો હતો; પણ તે સ્વગઁમાં ગયા, જેથી હવે તે આપણે માટે ઈશ્વરની હજૂરમાં હાજર થાય. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />વળી જેમ પ્રમુખયાજક દર વર્ષે બીજાનું રકત લઈને પરમપવિત્રસ્થાનમાં વષોઁવષઁ જતો હતો તેમ ઈસુ વારંવાર પોતાનું બલિદાન આપવાં સ્વગઁમાં ગયા નથી. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />નહિ તો, જગતના આરંભથી મસીહે ઘણીવાર દુઃખ સહન કરવું પડત, પણ હવે છેલ્લા કાળમાં પોતાના બલિદાનથી પાપને દૂર કરવા માટે એક જ વખત પ્રગટ થયા છે. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />જેમ માણસને એક જ વાર મરવાનું અને પછી તેનો ન્યાય થાય એવું નિર્માણ થયેલું છે, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />તેમ મસીહે પણ ઘણા લોકોનાં પાપ દૂર કરવા માટે એક જ વાર બલિદાન આપ્યું; અને તે બીજી વાર પણ પ્રગટ થશે, પાપ વેઠવા માટે નહિ, પરંતુ જેઓ તેમની રાહ જુએ છે તેમના માટે તારણ લાવવાં માટે.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="s1">મસીહનું કાયમ માટે એક જ વાર બલિદાન</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />નિયમશાસ્ત્ર તો આવનાર સારી બાબતોનો ફક્ત પડછાયો છે, વાસ્તવિકતાનો નહિ, માટે વષોઁવષઁ થતા એક જ બલિદાનોથી, આરાધના માટે ત્યાં આવનારા લોકોને તે સંપૂણઁ કરવાને કદી સમથઁ ન હતું. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />જો, એમ હોત, તો તેઓનું અપઁણ કરવાનું શું બંધ ન થયું હોત? કેમકે આરાધના કરનારાઓ એક જ વાર શુધ્ધ થયા હોત, અને પાપને કારણે તેમને દોષ ન લાગત. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />પરંતુ એ બલિદાનો દર વરસે પાપોની યાદ તાજી કરાવે છે. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />કારણ કે બળદો અને બકરાનું લોહી પાપ દૂર કરવાને સમર્થ નથી.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />તેથી મસીહ જયારે જગતમાં આવ્યા, ત્યારે તેમણે કહ્યું:</para>
  <para style="q1" vid="HEB 10:5">“તમે બલિદાન અને અપઁણની ઇચ્છા રાખી ન હતી,</para>
  <para style="q2" vid="HEB 10:5">પણ મારા માટે શરીર તૈયાર કયુઁ છે;<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />દહનાપઁણ અને પાપાથાઁપણઁથી</para>
  <para style="q2" vid="HEB 10:6">તમે પ્રસન્ન ન હતા.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />ત્યારે મેં કહ્યું, ‘હું અહીં છું, ઓળિયામાં મારા વિશે લખેલું છે,</para>
  <para style="q2" vid="HEB 10:7">મારા ઈશ્વરની ઈચ્છા પૂર્ણ કરવાને માટે હું આવ્યો છું.’ ”<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />પહેલાં તેમણે કહ્યું, “બલિદાનો અને અર્પણો, તથા દહનાર્પણો, પાપાથાઁપણો તમે ઇચ્છતા ન હતા, અને તમે તેનાથી પ્રસન્ન પણ ન હતા,” જો કે તે નિયમશાસ્ત્રના પ્રમાણે કરવામાં આવતા હતાં. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />પછી તેમણે કહ્યું, “હું આ રહ્યો તમારી ઇચ્છા પૂર્ણ કરવા હું આવ્યો છું.” આમ બીજાને સ્થાપવા સારું પહેલાને તેઓ રદ કરે છે. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />અને એ ઇચ્છાથી, ઈસુ મસીહના શરીરનું એક જ વાર અપઁણ થયાથી આપણને પવિત્ર કરવામાં આવ્યા છે.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />દરેક યાજક દરરોજ ઊભા રહીને સેવા કરતા, અને એ જ અપઁણ વારંવાર આપતાં ઊભા રહે છે, પરંતુ તે કદી પાપોને દૂર કરી શકતા નથી. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />પણ જયારે આ યાજકે પાપોને માટે એક જ વાર બલિદાન આપ્યું છે અને તેઓ ઈશ્વરની જમણી બાજુએ બિરાજ્યા છે, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />ત્યારથી તે તેમના શત્રુઓને તેમનું પાયાસન કરવામાં આવે તેની રાહ જોઈ રહ્યા છે. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />જેઓને પવિત્ર કરવામાં આવે છે તેઓને એક જ બલિદાનથી સદાને માટે સંપૂર્ણ કર્યા છે.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />આ વિશે પવિત્ર આત્મા પણ આપણને સાક્ષી આપે છે. પ્રથમ તેમણે કહ્યું:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“પ્રભુ કહે છે કે, તે સમય પછી, આ મારો કરાર હું તેમની સાથે સ્થાપન કરીશ.</para>
  <para style="q1" vid="HEB 10:16">મારા નિયમો હું તેઓના હ્રદયમાં મૂકીશ,</para>
  <para style="q2" vid="HEB 10:16">હું તેઓનાં હદયપટ પર લખીશ.”<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />વધુમાં તે કહે છે,</para>
  <para style="q1" vid="HEB 10:17">“તેઓનાં પાપ તથા દુષ્કર્મો હું</para>
  <para style="q2" vid="HEB 10:17">ફરી કદી સ્મરણ કરીશ નહિ.”<verse eid="HEB 10:17" /></para>
  <para style="m">
    <verse number="18" style="v" sid="HEB 10:18" />અને જયારે બધી બાબતો માફ થઈ છે, ત્યાં પાપને સારું અન્ય કોઈ બલિદાનની જરૂર રહેતી નથી.<verse eid="HEB 10:18" /></para>
  <para style="s1">વિશ્વાસમાં ટકવા માટેનું તેડું</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />તેથી ભાઈઓ અને બહેનો, ઈસુના રક્તથી આપણને પરમપવિત્રસ્થાનમાં પ્રવેશી શકીએ છીએ. <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />કેમકે પોતાના શરીરરૂપી પડદામાં થઈને તેમણે આપણે માટે નવો અને જીવનદાયી માર્ગ ખોલી નાંખ્યો છે, <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />અને આપણી પાસે ઈશ્વરના ઘર ઉપર એક મોટા યાજક છે. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />તેથી દુષ્ટ અંતઃકરણથી છૂટવા સારું આપણા હ્રદયો પર છંટકાવ પામીને, તથા નિમઁળ પાણીથી શરીરને ધોઈને આપણે ખરાં હૃદયથી અને પૂરેપૂરા નિશ્ચયથી વિશ્વાસ રાખીને ઈશ્વર પાસે જઈએ. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />આપણે આપણી આશાની કબૂલાત દ્રઢ પકડી રાખીએ, કેમકે જેણે વચન આપ્યું તે વિશ્વાસયોગ્ય છે; <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />અને પ્રેમ રાખવાને તથા સારા કામ કરવા પરસ્પર ઉતેજન મળે માટે આપણે એકબીજાનો વિચાર કરીએ. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />જેમ કેટલાક લોકો કરે છે તેમ આપણે સંગતમાં આવવાનું પડતું ના મૂકીએ, પરંતુ એકબીજાને ઉત્તેજન આપીએ, અને જેમ જેમ તે દિવસ પાસે આવતો જુઓ તેમ તેમ વિશેષ પ્રયત્ન કરો.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />સત્યનું જ્ઞાન થયા પછી પણ જો આપણે પાપમાં જીવવાનું ચાલુ રાખીએ તો તે પાપનાં નિવારણ માટે બીજું બલિદાન છે જ નહિ, <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />પણ ન્યાયની ભયંકર અપેક્ષા તથા શત્રુઓને ભસ્મ કરી નાંખે એવા અગ્નિના તેઓ ભોગ બનશે. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />જો કોઈ મોશેનાં નિયમશાસ્ત્રનો ભંગ કરે અને તે બે કે ત્રણ સાક્ષીઓથી પૂરવાર થાય તો તેને મરણની સજા થતી. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />તો પછી ઈશ્વરપુત્રને પગ નીચે કચડનાર, કરારના રકતથી પવિત્ર થયો હતો તેને અશુધ્ધ ગણ્યું છે, અને કૃપાના આત્માનું અપમાન કયુઁ છે તે કેટલી ભયંકર સજાને પાત્ર થશે તેનો વિચાર કરો. <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />“બદલો લેવાનું કામ મારું છે; હું બદલો વાળી આપીશ” અને ફરી “પ્રભુ પોતાના લોકોનો ન્યાય કરશે.” એમ જેણે કહ્યું તેને આપણે ઓળખીએ છીએ. <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />જીવતાં ઈશ્વરના હાથમાં પડવું તે ભયંકર છે.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />પણ પૂવઁના દિવસોનું સ્મરણ કરો, તે સમયે તમે પ્રકાશિત થયા પછી, જાણે તમે દુઃખોથી ભરપૂર ભારે સંઘષઁ સહન કયોઁ. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />કયારેક તમને જાહેરમાં અપમાન અને સતાવણીનો સામનો કરવો પડ્યો; તો કયારેક તમે એવા લોકોની પડખે ઊભા રહ્યા જેમની સાથે આવું વતઁન કરવામાં આવ્યું. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />જેઓ જેલમાં હતા તેઓનાં દુઃખોમાં તમે સહાનુભૂતિ દર્શાવી, તમારી માલમિલકત પડાવી લેવામાં આવી ત્યારે પણ તમે આનંદથી તે સહન કયુઁ, કારણ કે સ્વર્ગનાં ઉત્તમ તથા સાર્વકાલિક વાનાંનો વારસો તમે પામવાનાં છો એવી તમને ખાતરી હતી. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />પછી તમારા વિશ્વાસનો મોટો બદલો જે તમને મળવાનો છે, તેને નાંખી ન દો.<verse eid="HEB 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="HEB 10:36" />ઈશ્વરની ઇચ્છા પ્રમાણે વત્યાઁ પછી તમને વચનનું ફળ મળે, માટે તમારે ધીરજ રાખવાની જરૂર છે. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />કેમકે, “થોડા સમય પછી,</para>
  <para style="q2" vid="HEB 10:37">જે આવે છે તે જલ્દી આવશે,</para>
  <para style="q2" vid="HEB 10:37">અને વિલંબ નહિ કરે.”<verse eid="HEB 10:37" /></para>
  <para style="m">
    <verse number="38" style="v" sid="HEB 10:38" />અને,</para>
  <para style="q1" vid="HEB 10:38">“પણ મારો ન્યાયી વિશ્વાસથી જીવશે.</para>
  <para style="q2" vid="HEB 10:38">જો તે પાછો હઠી જાય</para>
  <para style="q2" vid="HEB 10:38">તો તેથી મને આનંદ થશે નહિ.”<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />પરંતુ આપણે પાછા હઠી જનારામાંનાં નાશ પામનાર લોકો જેવા નથી, પણ જેમને વિશ્વાસ અને તારણ છે તેમના જેવા છે.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s1">વિશ્વાસમાં કરણી</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />હવે વિશ્વાસ તો જે વસ્તુઓની આશા આપણે રાખીએ છીએ તેની ખાતરી છે, અને અદ્રશ્ય વસ્તુઓની સાબિતી છે. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />આ તે છે કે જેમનાં માટે પુરાતનકાળનાં લોકોની સાક્ષી પૂરવામાં આવી હતી.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />ઈશ્વર પરના વિશ્વાસથી આપણે જાણીએ છીએ કે સમગ્ર વિશ્વ ઈશ્વરની આજ્ઞાથી ઉત્પન્ન થયું. એટલે જે જે દ્રશ્ય છે, તે તે દ્રશ્યમાન વસ્તુઓથી ઉત્પન્ન થયાં નથી.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />વિશ્વાસથી હાબેલે કાઈનના કરતાં વધારે સારું અર્પણ ઇશ્વરને આપ્યું, તેથી તે ન્યાયી છે, તેવી તેના સબંધમાં સાક્ષી પૂરવામાં આવી, કેમકે ઈશ્વરે તેનાં દાનો સંબંધી સાક્ષી આપી; અને તેથી તે મૂએલો છતાં તે બોલે છે.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />વિશ્વાસથી હનોખને પણ ઉપર લઇ લેવામાં આવ્યો કે, તે મરણ ન જુએ; તે એકાએક અદ્રશ્ય થઈ ગયો કેમકે ઈશ્વરે તેને લઈ લીધો હતો. આ બન્યા પહેલાં તેના માટે એવી સાક્ષી આપવામાં આવી હતી કે ઈશ્વર તેના પર પ્રસન્ન હતા. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />વિશ્વાસ વગર ઈશ્વરને પ્રસન્ન કરી શકાય નહિ, ઈશ્વર પાસે આવનાર વ્યકિતએ વિશ્વાસ રાખવો જોઈએ કે ઈશ્વર છે, અને ખરાં હૃદયથી શોધનારને તે બદલો આપે છે.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />નૂહે જે વાત હજુ સુધી જોવામાં આવી નહોતી, તે વિષે ચેતવણી પામીને, અને ઇશ્વરનો ડર રાખીને વિશ્વાસથી પોતાના કુંટુંબનુ તારણ થાય માટે વહાણ તૈયાર કયુઁ; તેથી તેણે જગતને દોષિત ઠરાવ્યું, અને વિશ્વાસથી જે ન્યાયીપણું મળે છે તેનો તે વારસ થયો.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />વિશ્વાસથી અબ્રાહમ જે દેશ તેને વારસામાં આપવાનું ઈશ્વરે વચન આપ્યું હતું ત્યાં જવાની આજ્ઞાને તે આધીન થયો અને પોતાને કયાં જવાનું છે તે ન જાણ્યાં સિવાય ચાલી નીકળ્યો. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />વિશ્વાસથી તેણે વચનનાં દેશમાં પરદેશીની માફક પોતાનું ઘર બનાવ્યું તે ઇસહાક અને યાકોબની જેમ તંબુઓમાં રહ્યો, જેઓ તેની સાથે તે જ વચનનાં વારસ હતા. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />કેમકે જે શહેરનો પાયો છે જેનો યોજનાર તથા બાંધનાર ઈશ્વર છે તેની આશા તે રાખતો હતો. <verse eid="HEB 11:10" /><verse number="11" style="v" sid="HEB 11:11" />અને સારા, જે ગભઁ ધારણની ઉમંર વિતી ગઇ હતી પણ વિશ્વાસથી ગભઁ ધારણ કરવાને શકિતમાન થઇ, કેમકે જેણે વચન આપ્યું હતું તેને તેણે વિશ્વાસયોગ્ય ગણ્યો. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />એ એકથી અને વળી તે પણ મૂએલા જેવો તેનાથી, આકાશમાંના તારાઓ જેટલા તથા સમુદ્ર કિનારાની રેતીના જેટલાં અસંખ્ય સંતાનો ઉત્પન્ન થયાં.<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />આ બધા લોકો મરણ પામ્યા ત્યારે પણ વિશ્વાસથી જીવતાં હતા, તેમને વચનો મળ્યાં ન હતા; તેઓએ ફકત દૂરથી તેમને જોયા સ્વાગત કયુઁ કે, તેઓ પૃથ્વી પર તેઓએ કબૂલ કયુઁ કે અમે પૃથ્વી પર પરદેશી અને પ્રવાસી છીએ. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />જે લોકો આવી વાતો કરે છે તેઓ દશાઁવે છે કે તેઓ પોતાના દેશની શોધ કરે છે. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />જો તેઓ જે દેશ છોડી ને ગયા હતાં તેના વિશે વિચારતા હોત, તો તેને પાછા જવાની તક મળી હોત. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />તેના બદલે, તેઓ એક સારા દેશની, એટલે કે સ્વગીઁય દેશની ઇચ્છા રાખતા હતા, તેથી ઈશ્વર તેઓનાં ઈશ્વર કહેવાતાં શરમાતા નથી, કેમકે તેઓને માટે તેમણે એક શહેર તૈયાર કરેલું છે.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />વિશ્વાસથી જયારે ઈશ્વરે અબ્રાહમની કસોટી કરી, ત્યારે તેણે ઇસહાકનું બલિદાન આપ્યું. જેણે વચનો સ્વીકાયાઁ હતા, તેણે પોતાના એકનાએક દીકરાનું બલિદાન આપ્યું <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />તેથી ઈશ્વરે તેને કહ્યું હતું કે, “ઇસહાકથી તારા વંશજો ગણાશે” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />અબ્રાહમ માનતો હતો કે ઈશ્વર મૃત્યુ પામેલાંઓને પણ સજીવન કરી શકે છે, અને તેથી એક રીતે કહીએ તો તેણે ઇસહાકને મૃત્યુમાંથી પાછો મેળવ્યો.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />વિશ્વાસથી ઇસહાકે યાકોબ અને એસાવને તેમના ભવિષ્ય માટે આશીઁવાદ આપ્યો.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />વિશ્વાસથી યાકોબે મરતી વખતે યોસેફના બંને દીકરાઓને આશીર્વાદ આપ્યો, અને લાકડીનાં ટેકે ઊભા રહીને આરાધના કરી.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />વિશ્વાસથી યોસેફે પોતાના મૃત્યું કાળનો સમય નજીક આવ્યો ત્યારે, ઇઝરાયેલીઓના ઈજિપ્તમાંથી નીકળવાની વાત કરી અને પોતાના હાડકાં દફનાવવા વિશે સૂચનો આપ્યા.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />વિશ્વાસથી મોશેનાં માતાપિતાએ તેના જન્મ પછી ત્રણ મહીના સુધી તેને છુપાવી રાખ્યો, કારણ કે તેઓએ જોયું કે તે કોઈ સામાન્ય બાળક નથી, ને તેઓ રાજાના હુકમથી ડયાઁ નહિ.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />મોટાં થયા પછી મોશેએ વિશ્વાસથી ફારુનની દીકરીનો પુત્ર ગણાવાની ના પાડી. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />પાપનું ક્ષણિક સુખ ભોગવવાને બદલે તેણે ઈશ્વરના લોકની સાથે દુઃખ વેઠવાનું પસંદ કર્યું. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />તેણે ઈજિપ્તના દ્રવ્યભંડાર કરતાં મસીહને લીધે અપમાન સહન કરવાનું વધારે પસંદ કર્યું, કેમકે તે પોતાના બદલાની રાહ જોતો હતો. <verse eid="HEB 11:26" /><verse number="27" style="v" sid="HEB 11:27" />મોશેએ રાજાનાં ક્રોધની બીક રાખ્યા વગર વિશ્વાસથી ઈજિપ્ત દેશનો ત્યાગ કર્યો. અદ્રશ્ય જોતો હોય તેમ તે અડગ રહ્યો. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />વિશ્વાસથી તેણે પાસ્ખાપર્વ અને રક્ત છાંટવાની ક્રિયા ઠરાવી, જેથી પ્રથમજનિતનો નાશ કરનાર ઇઝરાયેલના પ્રથમજનિતોને સ્પર્શ ન કરે.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />વિશ્વાસથી લોકો કોરી જમીન પર ચાલતાં હોય તેમ લાલ સમુદ્ર પસાર કરી ગયા; પણ જયારે ઈજિપ્તના લોકોએ તેમ કરવાનો પ્રયાસ કયોઁ, ત્યારે તેઓ ડૂબી મર્યા.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />વિશ્વાસથી યરીખોના કોટની આસપાસ સાત દિવસ સુધી ફર્યા પછી તે કોટ તૂટી પડયો.<verse eid="HEB 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="HEB 11:31" />વિશ્વાસથી રાહાબ વેશ્યા, જાસૂસોનો ખુશીથી સત્કાર કયોઁ, તેથી અનઆજ્ઞાંકિત લોકો સાથે નાશ પામી નહિ.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />અને હવે આથી વિશેષ હું શું કહું? ગિદિયોન, બારાક, સામસૂન, યફતા, દાવિદ, શમુએલ તથા બીજા પ્રબોધકો વિશે કહેવાનો મારી પાસે સમય નથી. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />વિશ્વાસથી તેઓએ રાજ્યો જીત્યાં, ન્યાયપણે વત્યાઁ, વચનો પ્રાપ્ત કયાઁ, સિંહોના મોં બંધ કયાઁ. <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />અને અગ્નિનું બળ નિરથઁક કયુઁ, તરવારની ધારથી બચી ગયા, નિર્બળતામાંથી બળવાન થયા, લડાઈઓમાં શૂરવીરતા બતાવી અને વિદેશીઓનાં સૈન્યોને ભગાડી મૂક્યાં. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />સ્ત્રીઓ પોતાના પ્રિયજનોને મરણમાંથી પાછા મેળવી શકી, અને તેઓને ફરીથી સજીવન કરવામાં આવ્યા, કેટલાક રિબાઈ રિબાઈને માર્યા ગયા, તેઓએ છૂટકાનો અંગીકાર કયોઁ નહિ, જેથી તેઓ વધારે સારું પુનરુત્થાન પામે. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />કેટલાકે મશ્કરી, કોરડા, સાંકળો, અને જેલમાં નંખાઈને પરખાયા. <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />તેઓને પથ્થરોથી મારી નાંખવામાં આવ્યા, કરવતથી બે ભાગમાં વહેરી નાંખવામાં આવ્યા, તલવારથી મારી નાખવામાં આવ્યા. તેઓને ઘેટાનાં ચામડાં અને બકરાંના ચામડાં પહેરીને ફરતાં હતા, તેઓ કંગાલ, સતાયેલા, અને દૂર વ્યવહાર પામેલા હતાં, <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />તેઓ રણમાં, પર્વતો પર, ખીણોમાં તથા ગુફાઓમાં ફર્યા, જગત તેઓને માટે યોગ્ય ન હતું.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />તેઓ સવઁ વિષે વિશ્વાસની સારી સાક્ષી આપવામાં આવી, છતાં તેઓમાંના કોઈને આપેલા વચનનું ફળ મળ્યું નહિ; <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />કેમકે ઈશ્વરે આપણે માટે એથી વિષેશ સારું કંઇક નિમાઁણ કયુઁ હતું, જેથી તેઓ આપણા વગર પરિપૂણઁ ન થાય.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />તો આપણી આસપાસ શાહેદોની એટલી મોટી વાદળારૂપી ભીડ છે, માટે આપણે પણ દરેક જાતનો બોજો તથા વળગી રહેનાર પાપ નાખી દઈએ, અને આપણે સારુ ઠરાવેલી શરતમાં ધીરજથી દોડીએ. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />વળી આપણા આગેવાન તથા માર્ગદર્શક ઈસુ તરફ દ્રષ્ટિ રાખીએ, પોતાની આગળ મળનાર આનંદને લીધે, શરમને તુચ્છ ગણીને, ક્રૂસ પર શરમજનક મરણ સહન કયુઁ, અને ઈશ્વરપિતાના રાજ્યાસનની જમણી બાજુમાં બિરાજમાન છે. <verse eid="HEB 12:2" /><verse number="3" style="v" sid="HEB 12:3" />તો જેણે પાપીઓનો એટલો બધો વિરોધ સહન કયોઁ, તેનો વિચાર કરો, રખેને તમે નિરાશ થઇને થાકી જાઓ.<verse eid="HEB 12:3" /></para>
  <para style="s1">ઈશ્વર પોતાના બાળકોને શિસ્ત શિખવે છે</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 12:4" />તમે પાપની સામા બાથ ભીડો છો, પણ રકતપાત સુધી બાથ ભીડી નથી. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />વળી ઈશ્વરે તમને તેમનાં બાળકો ગણીને જેમ પિતાએ તમને ઉત્તેજનદાયક વચનો કહ્યાં એ શું તમે તદન ભૂલી ગયાં? તે કહે છે,</para>
  <para style="q1" vid="HEB 12:5">“મારા દીકરા, ઈશ્વરની શિક્ષાને તુચ્છ ન ગણ,</para>
  <para style="q2" vid="HEB 12:5">અને તને ઠપકો આપે ત્યારે નિરાશ ન થા.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />કેમકે ઈશ્વર જેને પ્રેમ કરે છે તેને તે શિક્ષા કરે છે,</para>
  <para style="q2" vid="HEB 12:6">અને જે પુત્રનો તે સ્વીકાર કરે છે, તેને તે શિક્ષા કરે છે.”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />શિક્ષણની ખાતર તમારે સહન કરવું પડે છે; જેમ પુત્રની સાથે તેમ તે તમારી સાથે વતેઁ છે; કેમકે એવો કયો પુત્ર છે કે જેને બાપ શિક્ષા નથી કરતો? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />જો તમે શિક્ષા ના ભાગીદાર થયા, એવી શિક્ષા અમને ન થાય, તો તમે દાસી પુત્રો છો, ને ખરા દીકરા કે દીકરીઓ નથી. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />વળી, આપણા શરીરોના પિતા આપણને શિક્ષા કરે છે અને આપણે તેમનું માન જાળવીએ છીએ, તો આપણા આત્માઓના પિતાને એથી વિશેષ માન આપીને તેને આધીન ન રહીએ અને જીવીએ? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />કેમકે તેઓએ તો થોડા સમય સુધી પોતાને જેમ યોગ્ય લાગ્યું તેમ આપણને કેળવવા માટે શિક્ષા કરી, પરંતુ ઈશ્વરની શિક્ષા હંમેશા હિતકારક હોય છે. જેથી આપણે તેમની પવિત્રતાના ભાગીદાર બનીએ. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />શિક્ષા થાય ત્યારે તરત આનંદકારક લાગતી નહિ પણ દુઃખદાયક લાગે છે, પણ પાછળથી તો તે કસાયેલાઓને ન્યાયીપણાનાં શાંતિદાયક ફળ આપે છે.<verse eid="HEB 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />તેથી તમારાં થાકેલાં હાથોને તથા લથડતાં ઘૂટણોને ફરીથી મજબૂત બનાવો. <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />અને પોતાના પગોને સારું પાધરા રસ્તા કરો, જેથી જે અપંગ તે પડી જાય નહિ, પણ ઊલટું તે સાજુ થાય.<verse eid="HEB 12:13" /></para>
  <para style="s1">ચેતવણી અને ઉતેજન</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />સઘળાંની સાથે શાંતિથી અને પવિત્ર રહેવાને પ્રયત્ન કરો; પવિત્રતા વગર કોઈ માણસ પ્રભુને જોઈ શકશે નહિ. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />ધ્યાન રાખો કે, કોઈ પણ માણસ ઈશ્વરની કૃપા વિના રહી ન જાય. રખેને કોઈ કડવાશરૂપી મૂળ ઊગીને ઘણાં લોકોને મુશ્કેલીઓ ઊભી ન થાય અને ભ્રષ્ટ ન થાય. <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />રખેને કોઈ વ્યભિચારમાં પડે, અથવા એસાવ જેણે એક ટંક ભોજનને બદલે પોતાનું જ્યેષ્ઠ પુત્ર તરીકે નો વારસો વેચી દીધો તેના જેવા ભ્રષ્ટ ન થાય. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />પછી, જેમ તમે જાણો છો, કે જ્યારે તે આ આશીવાઁદનો વારસો પામવાં ઈચ્છતો હતો, ત્યારે તેને નકારવામાં આવ્યો. ભલે તેણે આંસુઓ સાથે આશીઁવાદ મેળવવાની કોશિશ કરી, પણ તે પોતાના કાયઁને બદલી શક્યો નહિ.<verse eid="HEB 12:17" /></para>
  <para style="s1">ભયનો પવઁત અને આનંદનો પવઁત</para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />વળી તમે એવાં પવઁત પાસે આવ્યા નથી, એટલે કે જેને અડકાય એવા પવઁતની તથા બળતી આગની તથા ઘનઘોર આકાશની અને અંધકારની અને તોફનની; <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />રણશિંગડાનાં અવાજ અને એવા શબ્દ ધ્વનિની કે, જે સાંભળનારાઓએ વિનંતી કરી કે એવું ફરીથી તેઓને બીજું કંઈ કહેવામાં ન આવે, <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />કારણ કે તેઓ જે આજ્ઞા થઇ તે સહન કરી શક્યા નહિ: “જો કોઈ પ્રાણી પણ પર્વતને અડકે, તો તેને પથ્થરેથી મારી નાંખવું.” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />વળી એ દ્રશ્ય એવું ભયાનક હતું કે તેથી મોશેએ કહ્યું, “હું ભયભીત થઈને ધ્રુજી રહ્યો છું.”<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />પરંતુ તમે તો સિયોન પર્વત પર એટલે કે જીવંત ઈશ્વરના શહેર સ્વગીઁય યરુશાલેમમાં આવ્યા છો, અને હજારો અને હજારો દૂતોની સભામાં આનંદથી ભરેલાં છે, <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />પ્રથમ જન્મેલાંઓની મંડળી, જેઓનાં નામ સ્વર્ગના પુસ્તકમાં નોંધાયેલા છે. તેઓની પાસે અને સૌનો ન્યાય કરનાર ઈશ્વર સમક્ષ, અને સંપૂણઁ થયેલા ન્યાયીઓનાં આત્માઓ પાસે, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />અને નવા કરારના મધ્યસ્થ ઈસુની પાસે, અને જે છંટકાવનું રકત હાબેલનાં કરતાં સારું બોલે છે, તેની પાસે આવ્યા.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />જે બોલે છે તેનો તમે અનાદર ન કરો, માટે સાવધ રહો, જો તેઓએ પૃથ્વી પર ચેતવણી આપનારનો અનાદર કરીને છટકી ન શક્યા, તો પછી જો સ્વર્ગમાંથી આપણને ચેતવણી આપનારથી દૂર રહીશું તો આપણે કેવી રીતે બચી શકીશું? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />તે સમયે તેમના અવાજે પૃથ્વીને હલાવી નાંખી, પણ હવે તે કહે છે, કે “ફરી એક વાર હું પૃથ્વીને જ નહિ, પણ આકાશોને પણ હલાવીશ.” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />“ફરીથી એક વાર” શબ્દ સૂચવે છે કે જે હલાવી શકાય છે, એટલે કે સૃષ્ટ વસ્તુઓની—દૂર કરવામાં આવશે જેથી જે હલાવી શકાતી નથી તે કાયમ રહે.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />માટે, આપણને તો એવું રાજ્ય મળ્યું છે કે જે હલાવી શકાતું નથી, તેથી આપણે આભાર માનીએ, જેથી ઈશ્વર પ્રસન્ન થાય તેવી રીતે ભય તથા આદર સાથે તેમની આરાધના કરીએ. <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />કેમકે “આપણા ઈશ્વર ભસ્મ કરી નાંખનાર અગ્નિ છે.”<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s1">સમાપન ઉપદેશો</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />ભાઈઓ અને બહેનો તરીકે એકબીજા પર પ્રેમ રાખો. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />અજાણ્યાઓને પરોણાગત કરવાનું ભૂલશો નહિ, કેમકે એવું કરવાથી કેટલાકે અજાણતા દૂતોને પરોણા રાખ્યા છે. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />જેઓ જેલમાં છે તેઓની સાથે તમે પણ જેલમાં હો એમ સમજીને તેઓને યાદ કરો, અને જેઓનાં પર જુલમ ગુજારવામાં આવે છે તેઓને યાદ કરો જાણે તમે પોતે પણ દુઃખ સહન કરી રહ્યાં છો.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />સવઁમાં લગ્નને માન યોગ્ય ગણો, અને બિછાનું શુધ્ધ રાખો, કેમકે ઈશ્વર વ્યભિચારી અને અનૈતિક લોકોનો ન્યાય કરશે. <verse eid="HEB 13:4" /><verse number="5" style="v" sid="HEB 13:5" />દ્રવ્યલોભથી દૂર રહો; અને તમારી પાસે છે તેમાં સંતોષ માનો. કેમકે ઈશ્વરે કહ્યું છે કે,</para>
  <para style="q1" vid="HEB 13:5">“હું તને કદી છોડીશ નહિ. હું તને કદી તજીશ નહિ”<verse eid="HEB 13:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 13:6" />તો આપણે ખાતરીપૂવઁક કહી શકીએ છીએ કે,</para>
  <para style="q1" vid="HEB 13:6">“પ્રભુ મારો સહાયક છે; હું ડરીશ નહિ.</para>
  <para style="q2" vid="HEB 13:6">માણસ મને શું કરનાર છે?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />તમને ઈશ્વરનાં વચનો કહેનાર તમારાં આગેવાનોને યાદ કરો. અને તેમના જીવનનાં પરિણામનો વિચાર કરો અને તેમના વિશ્વાસનું અનુકરણ કરો. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />ઈસુ મસીહ ગઈ કાલે, આજે અને સર્વકાળ એવા અને એવા જ છે.<verse eid="HEB 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 13:9" />તેથી તમે દરેક પ્રકારના વિચિત્ર ઉપદેશથી આકર્ષાઈ જશો નહિ. કેમકે કૃપાથી હ્રદય દ્રઢ થાય તે સારું છે, ધામિઁક ખોરાક ખાવાથી નહિ, જે એમ કરનારાઓને કશો જ ફાયદો થતો નથી. <verse eid="HEB 13:9" /><verse number="10" style="v" sid="HEB 13:10" />આપણી પાસે એવી એક વેદી છે કે જેમાંથી મંડપમાં સેવા કરનારાઓને ખાવાનો અધિકાર નથી.<verse eid="HEB 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 13:11" />પ્રમુખયાજક પશુઓનું રકત પવિત્રસ્થાનમાં પાપાથાઁપણ તરીકે પરમપવિત્રસ્થાનમાં લઇ જાય છે, પણ શરીરને છાવણીની બહાર બાળી નાંખવામાં આવે છે. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />અને તેથી ઈસુએ પણ પોતાના રકતથી લોકોને પવિત્ર કરવા સારું શહેરનાં દરવાજાની બહાર દુઃખ સહ્યું. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />તેથી ચાલો, આપણે પણ તેમનું અપમાન સહન કરીને છાવણી બહાર તેમની પાસે જઈએ. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />કેમકે આપણી પાસે કાયમી રહે એવું શહેર નથી, પણ જે આવવાનું છે તે શહેરની રાહ જોઈ રહ્યા છીએ.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />માટે, ઈસુ દ્રારા, આપણે ઈશ્વરને સ્તુતિનું બલિદાન નિત્ય ચઢાવીએ, જે તેમના નામનું જાહેરમાં કબૂલ કરનારા હોઠોનું ફળ છે. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />અને સારું કરવાનું અને બીજાઓને દાન આપવાનું ભૂલશો નહિ, કેમકે એવાં અર્પણોથી ઈશ્વર પ્રસન્ન થાય છે.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />તમારાંં આત્મિક આગેવાનોનો ભરોસો રાખો અને તેમને આધીન રહો, કારણ કે હિસાબ આપનારાઓની જેમ તેઓ તમારા પર નજર રાખે છે. આમ કરવાથી તેમનું કાયઁ આનંદદાયક બને, બોજારૂપ નહિ, કારણ કે તેથી તમને પણ ગેરલાભ થાય.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />અમારે માટે પ્રાર્થના કરો. કેમકે અમારું અંતઃકરણ શુધ્ધ છે એવી અમને ખાતરી છે અને અમે દરેક રીતે માનપૂવઁક જીવવા માંગીએ છીએ. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />હું તમને ખાસ વિનંતી કરું છું કે તમે મારે માટે ખાસ પ્રાર્થના કરો કે હું તમારી પાસે જલદી પાછો આવી શકું.<verse eid="HEB 13:19" /></para>
  <para style="s1">આશીઁવાદ અને અંતિમ શુભેચ્છાઓ</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />હવે શાંતિનો ઈશ્વર, જેણે ઘેંટાના મહાન પાળક આપણ પ્રભુ ઈસુને સાર્વકાલિક કરારને પોતાના રકતથી મરણમાંથી પાછા લાવ્યા, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />તમને તેમની ઇચ્છા પૂર્ણ કરવા માટે સર્વ સારા કામથી તૈયાર કરો, અને ઈશ્વરને પસંદ પડે તેવું જીવન મસીહ ઈસુ વડે જીવો; તેમને સર્વકાળ મહિમા હો. આમીન.<verse eid="HEB 13:21" /></para>
  <para style="b" />
  <para style="b" />
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />ભાઈઓ અને બહેનો, હું તમને વિનંતી કરું છું કે, તમે મારા બોધના વચનને સહન કરો, કેમકે મે તમને ટૂંકમાં જ લખ્યું છે.<verse eid="HEB 13:22" /></para>
  <para style="b" />
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23" />હું તમને જણાવવાં માંગુ છું કે આપણો ભાઈ તિમોથી છૂટયો છે. જો તે વહેલો આવશે તો હું તેની સાથે આવીને તમને મળીશ.<verse eid="HEB 13:23" /></para>
  <para style="b" />
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />તમારાં આગેવાનોને તથા સર્વ પ્રભુના લોકોને મારી સલામ પાઠવશો.</para>
  <para style="p" vid="HEB 13:24">ઈટાલીમાં જેઓ છે તેઓ તમને સલામ પાઠવે છે.<verse eid="HEB 13:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />તમો સર્વ પર કૃપા હો.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>