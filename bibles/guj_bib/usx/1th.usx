  <para style="h">1 થેસ્સાલોનિકી</para>
  <para style="toc1">થેસ્સાલોનિકીઓને પહેલો પત્ર</para>
  <para style="toc2">1 થેસ્સાલોનિકી</para>
  <para style="toc3">1 થેસ્સાલોનિકી</para>
  <para style="mt1">થેસ્સાલોનિકીઓને પહેલો પત્ર</para>
  <para style="ie" />
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="po">
    <verse number="1" style="v" sid="1TH 1:1" />થેસ્સાલોનિકાની મંડળીના સર્વને લખનાર પાઉલ,</para>
  <para style="po" vid="1TH 1:1">સિલાસ તથા તિમોથી,</para>
  <para style="po" vid="1TH 1:1">ઈશ્વર પિતા તથા પ્રભુ ઈસુ મસીહ તરફથી તમારાં પર કૃપા તથા શાંતિ થાઓ:<verse eid="1TH 1:1" /></para>
  <para style="s1">થેસ્સલોનિકીઓના વિશ્વાસને લીધે આભારસ્તુતિ</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />તમારાં માટે અમે હંમેશાં ઈશ્વરનો આભાર માનીએ છીએ અને અમારી પ્રાર્થનાઓમાં તમને સતત યાદ કરીએ છીએ. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />આપણા ઈશ્વર તથા બાપની આગળ તમારાં વિશ્વાસપૂવઁક કામ, પ્રેમપૂવઁક મહેનત તથા આપણા પ્રભુ ઈસુ મસીહ પર ધીરજથી રાખેલી દ્રઢ આશા, અમે નિરંતર સંભારીએ છીએ.<verse eid="1TH 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4" />ભાઈઓ અને બહેનો આપણે જાણીએ છીએ કે ઈશ્વરને તમે પ્રિય છો અને તેમણે તમને પસંદ કર્યા છે. <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />કેમકે અમારા સુસમાચાર માત્ર શબ્દો જ ન હતા, પરંતુ પવિત્ર આત્માના સામર્થ્ય સાથે હતા અને તમને ખાતરી કરી આપી. વળી તમારામાં અમે કેવું જીવન જીવ્યા એ તમે જાણો છો. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" />માટે તમે અમને અને પ્રભુને અનુસરનારા થયા. જો કે તમારે ઘણાં સંકટો અને દુઃખો સહન કરવાં પડયાં, તોપણ તમે તે સંદેશો પવિત્ર આત્મા દ્વારા મળતા આનંદથી સ્વીકારી લીધો. <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />એ રીતે તમે મકદોનિયા અને અખાયામાંના સર્વ વિશ્વાસીઓને નમૂનારૂપ બન્યા. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />તમારી મારફતે ઈશ્વરનું વચન ફકત મકદોનિયા અને અખાયામાં પહોંચ્યું છે એટલું જ નહિ, પણ સવઁ સ્થળે ઈશ્વર પરનો તમારો વિશ્વાસ પ્રગટ થયો; એ વિષે અમારે કંઈ કહેવાની જરૂર નથી. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />કેમકે તેઓએ પોતે અમારો કેવો આવકાર કયોઁ તેના વિષે અમને જણાવ્યું છે. તમે મૂર્તિઓ તરફથી કેવી રીતે સત્ય અને જીવંત ઈશ્વર તરફ ફર્યા તે વિશે લોકો અમને કહે છે, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />વળી સ્વર્ગમાંથી તેમના પુત્ર જેમને ઈશ્વરે મૃત્યુમાંથી સજીવન કર્યા તેની તમે રાહ જુઓ છો, ઈસુ કે જે આપણને આવનાર ભયંકર કોપથી બચાવે છે.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s1">થેસ્સાલોનિકામાં પાઉલનું સેવાકાર્ય</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />ભાઈઓ અને બહેનો, તમે જાણો છો કે તમારી સાથેની અમારી મુલાકાત નિષ્ફળ ગઈ નથી. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" />ફિલિપ્પીમાં અમારે જે દુઃખ અને અપમાન સહન કરવા પડયાં તે તમે જાણો છો. તોપણ ઘણા કષ્ટથી તમને સુસમાચાર નીડરતાથી જણાવવાને ઈશ્વરે અમને હિંમત આપી. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />કેમકે અમારા બોધમાં છળ કે અશુધ્ધતા કે કપટ નહોતું; કે અમે તમને છેતરવા માંગતા ન હતા. <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />પણ જેમ ઈશ્વરે સુસમાચારનો ઉપદેશ કરવાને અમને પસંદ કયાઁ, તેમ અમે માણસોને પ્રસન્ન કરનારની પેઠે નહિ, પણ અમારા હ્રદયોના પારખનાર ઇશ્વરને પ્રસન્ન કરવાને બોલીએ છીએ. અમે ઈશ્વરના સંદેશાવાહક તરીકે બોલીએ છીએ. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />તમે જાણો છો કે તમારી ખુશામત કરી ન હતી અને ઢોંગ કરી લોભ પણ કર્યા ન હતો, એ વિશે ઈશ્વર અમારા સાક્ષી છે; <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />મસીહના પ્રેષિત હોવાને લીધે અમને તમારાં તરફથી માન પામવાનો અધિકાર હતો, છતાં લોકો કે, તમે પોતે કે બીજા કોઈ અમારી પ્રશંશા કરે એવી ઇચ્છા પણ અમે રાખી ન હતી. <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />તેના બદલે, અમે તમારી મધ્યે જુવાન બાળકો જેવા હતા,</para>
  <para style="p" vid="1TH 2:7">જેમ એક ધાવણી માતા પોતાના બાળકોની સંભાળ રાખે છે, <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />અમે તમારી સંભાળ રાખીએ છીએ. કેમકે અમે તમને ખૂબ પ્રેમ કરતા હતા, તમને કેવળ ઇશ્વરના સુસમાચાર પ્રગટ કરવાને જ નહિ, પણ અમારા જીવો પણ આપવાને રાજી હતા. <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />ભાઈઓ અને બહેનો અમારો પરિશ્રમ અને કષ્ટ શું તમને યાદ છે; અમે તમને કોઈ પણ રીતે બોજારૂપ ન બનીએ માટે તમારી મધ્યે સુસમાચાર પ્રગટ કરવા અમે રાતદિવસ સખત મહેનત કરી હતી. <verse eid="1TH 2:9" /><verse number="10" style="v" sid="1TH 2:10" />તમો સર્વ વિશ્વાસીઓ પ્રત્યે અમે જે પવિત્ર, ન્યાયી અને નિર્દોષ વ્યવહાર કર્યો હતો તે વિશે તમે અને ઈશ્વર અમારા સાક્ષી છો. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />પિતા પોતાના બાળકો સાથે વર્તે તે જ રીતે અમે પણ તમારી સાથે વર્તતા હતા. તમને શિક્ષણ, પ્રોત્સાહન અને ચેતવણી આપતાં હતા <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />ઉતેજન, બોધ અને ચેતવણી આપતાં હતા કે ઈશ્વરને પસંદ પડે એવું જીવન તમે જીવો, કે જે પોતાના રાજય અને મહિમામાં બોલાવે છે.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />વળી અમે ઈશ્વરનો આભાર માનીએ છીએ કે જયારે અમે તમને સુસમાચાર સંભળાવ્યો ત્યારે તમે તેને માનવી સંદેશા તરીકે નહિ પણ ઈશ્વરના વચન તરીકે સ્વીકાયોઁ, અને તે જ તમ વિશ્વાસીઓમાં પ્રેરણા પણ કરે છે. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" />ભાઈઓ અને બહેનો કે જેઓ મસીહ ઈસુમા છે, યહૂદીયાની મંડળીનું અનુકરણ કરનારાં તમે થયા; કેમકે જેમ તેઓએ યહૂદીઓ તરફથી સતાવણી સહન કરી હતી તેમ તમે પણ તમારાં જ લોકો તરફથી સતાવણી વેઠી. <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" />જેઓએ ઈસુને માયાઁ અને પ્રબોધકોને અને અમને કાઢી મૂક્યાં; તેઓ ઇશ્વરને પ્રસન્ન કરતાં નથી, સઘળાં માણસોના વિરોધી છે. <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />વિદેશીઓ તારણ ન પામે માટે વાત કહેવાને તેઓ અમને મના કરે છે; તેથી તેઓ નિત્ય પોતાનાં પાપનો ઘડો ભરે છે; પણ તેઓ પર અત્યંત કોપ આવી ચૂકયો છે.<verse eid="1TH 2:16" /></para>
  <para style="s1">થેસ્સાલોનિકીઓને પાઉલની મળવાની ઝંખના</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />ભાઈઓ અને બહેનો, અમે મનથી નહિ પણ થોડા સમય દેહથી તમારાંથી છૂટાં પડયાં, જો કે અમારા હૃદયથી તમને ફરી મળવાને અમે ઘણાં ઉત્સુક છીએ. <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />તમારી પાસે આવવાને અમે આતુર છીએ, મેં પાઉલે વારંવાર પ્રયત્ન પણ કર્યા, પરંતુ શેતાને અમને અટકાવ્યા. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />કેમકે અમારી આશા, આનંદ અને ગર્વનો મુગટ તમે જ છો. આપણા પ્રભુ ઈસુ મસીહના પુનરાગમન સમયે તેમની સમક્ષ તમે જ એ મુગટ નથી? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />ખરેખર, તમે જ અમારો આનંદ અને મહિમા છો.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />છેવટે અમે તે સહન ન કરી શક્યાં ત્યારે આથેન્સમાં એકલા રહેવાનું નક્કી કર્યું <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />અમે તિમોથીને તમારી પાસે મોકલ્યો, જે અમારો ભાઈ મસીહના સુસમાચાર ફેલાવવામાં ઈશ્વરની સેવામાં સહકાયઁકતાઁ છે, એ માટે કે તે તમને વિશ્વાસમાં દ્રઢ કરીને ઉત્તેજન આપે; <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />જેથી કોઇ પણ આ કસોટીઓથી ડગી ન જાય, કેમકે તમે જાણો છો કે આપણે તેમના માટે જ નિમાઁણ થયેલા છીએ. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />કારણ કે જયારે અમે તમારી સાથે હતા ત્યારે તમને અગાઉથી ચેતવણી આપી હતી કે તમારાં ઉપર સતાવણી આવશે, અને બન્યું પણ એમ જ તે તમે જાણો છો. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />એ જ કારણથી હું વધુ સહન ન કરી શકયો ત્યારે તમારાં વિશ્વાસ વિષે જાણવા સારું તેને મોકલ્યો, મને ડર હતો કે કદાચ પરીક્ષણ કરનાર કોઇ રીતે તમારું પરીક્ષણ કરે અને અમારું કાર્ય નિષ્ફળ ગયું હોય.<verse eid="1TH 3:5" /></para>
  <para style="s1">તિમોથીનો ઉત્તેજનદાયક અહેવાલ</para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />પણ હમણાં જ તિમોથી તમારે ત્યાંથી અમારી પાસે આવ્યો, અને તમારાં વિશ્વાસ તથા પ્રેમ વિશે ખુશકારક સમાચાર કહ્યાં. અને જેમ અમે તમને જોવા માટે આતુર છીએ, તેમ તમે પણ અમને જોવાને આતુર છો. ને સદા અમારું પ્રેમપૂવઁક સ્મરણ કરો છો. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />એ માટે, ભાઈઓ અને બહેનો, અમારા સવઁ સંકટ તથા સતાવણીમાં તમારા વિશ્વાસથી અમને તમારાં વિષે દિલાસો મળ્યો છે. <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />કેમકે તમે પ્રભુમાં દ્રઢ રહો તો તેથી અમે ખરેખર જીવીએ છીએ. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />તમારે લીધે અમે અમારા ઈશ્વરની આગળ આનંદ કરીએ છીએ, તેના બદલામાં અમે તમારાં માટે ઈશ્વરનો કેટલો આભાર માની શકીએ? <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />અમે રાતદિવસ ખુબજ આગ્રહથી પ્રાર્થના કરીએ છીએ કે અમે તમને ફરીથી રૂબરૂ મળી શકીએ અને તમારાં વિશ્વાસમાં કાંઈ ઊણપ હોય તો તે પૂર્ણ કરી શકીએ.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />હવે આપણા ઈશ્વર અને પિતા પોતે આપણામાં પ્રભુ ઈસુ તમારી પાસે આવવાં અમારો માર્ગ ખુલ્લો કરે. <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />જેમ અમારો પ્રેમ તમારાં માટે વધુ છે તેમ પ્રભુ એકબીજા પરનાં તથા સવઁ માણસો પરનાં તમારાં પ્રેમમાં પુષ્કળ વધારો કરે. <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />એ માટે કે જયારે આપણો પ્રભુ ઈસુ પોતાના બધા સંતો સાથે આવે, ત્યારે તમે આપણા ઈશ્વર અને પિતાની સમક્ષ તે તમારાં હ્રદયોને નિર્દોષ અને પવિત્ર ઠરાવીને દ્રઢ કરે.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s1">ઇશ્વરને પસંદ પડે તેવું જીવો</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />ભાઈઓ અને બહેનો, બીજી બાબતો વિષે અમે તમને શિખવ્યું છે કે તમારે કેવી રીતે જીવવું ને ઇશ્વરને પ્રસન્ન કરવાં, હવે પ્રભુ ઈસુના નામમાં અમે તમને વિનંતી કરીએ છીએ કે તેમાં તમે વિશેષ વૃધ્ધિ પામતાં જાઓ. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />કારણ કે તમે જાણો છો કે પ્રભુ ઈસુ તરફથી તમને કંઈ આજ્ઞાઓ આપી છે.<verse eid="1TH 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3" />તમે પવિત્ર થાઓ: અને વ્યભિચારથી દૂર રહો એવી ઈશ્વરની ઇચ્છા છે; <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />અને તમારાંમાંના દરેકે પવિત્ર અને માનપૂર્વક પોતાના શરીરને કાબુમાં રાખવાનું શિખવું જોઈએ. <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />જે મૂતિઁપૂજકો ઇશ્વરને નહિ જાણનારાં તેમની જેમ વિષયવાસનામાં ન જીવો; <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />અને આ બાબતમાં કોઇએ પોતાના ભાઈ કે બહેનનું ખોટું ન કરવું, અને તેમનો ફાયદો ન ઉઠાવવો જોઈએ, જેમ અમે તમને પહેલેથી કહ્યું અને ચેતવણી આપી હતી, તેમ એવાં પાપ કરનારને પ્રભુ ભારે શિક્ષા કરશે. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />કેમકે ઈશ્વરે આપણને અશુધ્ધતાને સારું નહિ પણ પવિત્ર જીવન જીવવા માટે તેડું આપ્યું છે. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />માટે જે કોઈ આ સૂચનાનો અનાદર કરે છે, તે માણસનો નહિ પણ તમને પોતાનો પવિત્ર આત્મા આપનાર ઈશ્વરનો અનાદર કરે છે.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />હવે એકબીજા પ્રત્યેના પ્રેમ વિષે અમારે લખવાની જરૂર નથી, કારણ કે એકબીજા પર પ્રેમ કરવાનું ઈશ્વરે જ તમને શીખવ્યું છે. <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />અને ખરેખર, મકદોનિયાના સમગ્ર ઇશ્વરના પરિવારને તમે પ્રેમ કરો છો, છતાં પણ ભાઈઓ અને બહેનો અમે તમને વિનંતી કરીએ છીએ કે તમે એથી પણ વિશેષ પ્રેમ રાખો. <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />અને એમ શાંતિમય જીવન જીવવાનું લક્ષ માટે રાખો: જેમ અમે તમને કહ્યું હતું તેમ, તમારે પોતાના કામમાં ઘ્યાન આપવું જોઈએ, અને પોતાના હાથે મહેનત કરવી જોઈએ. <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />તેથી તમારા રોજીંદા જીવનમાં બહારનાં લોકોનું માન જીતો અને કોઇની ઉપર નિભઁર ન રહો.<verse eid="1TH 4:12" /></para>
  <para style="s1">વિશ્વાસીઓ કે જેઓ મૃત્યું પામ્યાં છે</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />ભાઈઓ અને બહેનો, અમે નથી ચાહતા કે તમે મરણમાં ઊંઘી ગયેલાં વિષે તમે અજાણ રહો, જેથી તમે બીજા લોકો જેઓની પાસે કોઇ આશા નથી તેઓની માફક તમે દુઃખી થાઓ. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />કેમકે આપણે માનીએ છીએ કે પ્રભુ ઈસુ મૃત્યુ પામ્યા અને સજીવન થયા, અને તેથી આપણે વિશ્વાસ કરીએ છીએ કે તે જ પ્રમાણે ઈસુમાં જેઓ ઊંઘી ગયેલાં છે તેઓને પણ ઈશ્વર તેમની સાથે લાવશે. <verse eid="1TH 4:14" /><verse number="15" style="v" sid="1TH 4:15" />પ્રભુના વચન પ્રમાણે અમે તમને કહીએ છીએ કે પ્રભુના આગમન સમયે જેઓ જીવંત હશે તેઓ ચોકકસપણે ઊંઘી ગયેલાઓની અગાઉ જનાર નથી. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />કેમકે પ્રભુ પોતે ગર્જનાસહિત, પ્રમુખદૂતના પોકાર સહિત અને ઈશ્વરના રણશિંગડાંનાં અવાજ સાથે સ્વર્ગમાંથી ઊતરશે અને જેઓ મસીહમાં મૃત્યુ પામ્યા છે તેઓ પ્રથમ સજીવન થશે. <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />ત્યાર પછી, આપણામાંનાં જેઓ જીવતાં અને બાકી રહેલાં છે તેઓ પ્રભુને મળવાં માટે તેમની સાથે વાદળોમાં ઊચકાઇ જઈશું; અને એમ આપણે સદા પ્રભુની સાથે રહીશું. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />તો આ વચનો વડે તમે એકબીજાને ઉત્તેજન આપો.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s1">પ્રભુનો દિવસ</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />હવે ભાઈઓ અને બહેનો, સમયો તથા પ્રસંગો વિશે મારે તમને લખવાની જરૂર નથી. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" />કારણ કે તમે સારી રીતે જાણો છો કે જેમ રાત્રે ચોર આવે છે તેમ પ્રભુનો દિવસ આવશે. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />જયારે લોકો કહેતાં હશે કે, “શાંતિ અને સલામતી!” ત્યારે અચાનક શરૂ થતી પ્રસૂતિની વેદનાની માફક તેઓના પર વિનાશ આવી પડશે. અને તેઓ બચી નહિ જશે.<verse eid="1TH 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4" />પણ ભાઈઓ અને બહેનો, તમે અંધારામાં નથી, કે તે દિવસ ચોરની માફક તમારાં પર આવી પડે. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />કારણ કે તમે સર્વ પ્રકાશનાં અને દિવસનાં સંતાનો છો. તમે અંધકારના કે રાત્રિનાં નથી. <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />માટે આપણે બીજાઓની જેમ ઊંઘીએ નહિ પણ જાગૃત અને સાવધ રહીએ. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />કેમકે ઊંઘનારા રાત્રે ઊંઘે છે ને દારૂડિયા રાત્રે દારૂ પીએ છે. <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" />પરંતુ આપણે તો દિવસનાં છીએ, માટે સાવધ રહો, વિશ્વાસ અને પ્રેમનું બખ્તર તથા તારણની આશાનો ટોપ પહેરીને સાવધ રહીએ. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />કેમકે ઈશ્વરે આપણને કોપને માટે નહિ, પણ આપણા પ્રભુ ઈસુ મસીહ મારફતે આપણું તારણ થાય એ માટે પસંદ કર્યા છે. <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />આપણે જાગતાં હોઈએ કે ઊંઘતા હોઈએ પણ આપણે તેમની સાથે જીવીએ તે માટે તેઓ મરણ પામ્યા. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />તેથી તમે હમણાં કરો છો તેમજ એકબીજાને ઉત્તેજન આપવાનું અને વૃધ્ધિ પામવાનું ચાલુ રાખો.<verse eid="1TH 5:11" /></para>
  <para style="s1">અંતિમ સુચનો</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />હવે અમે તમને કહીએ છીએ કે, પ્રિય ભાઈઓ અને બહેનો, જેઓ તમારાંમાં પરિશ્રમ કરે છે, પ્રભુમાં તમારી સંભાળ લે છે, અને તમને ઉપદેશ આપે છે તેઓની કદર કરો. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />તેઓના કામને લીધે પ્રેમપૂર્વક તેઓને અતીઘણું માન આપો, તમે માંહોમાંહે શાંતિમાં રહો. <verse eid="1TH 5:13" /><verse number="14" style="v" sid="1TH 5:14" />અને ભાઈઓ અને બહેનો, જેઓ આળસુ, અને તોફાનીઓને ચેતવણી આપો, બીકણોને હિંમત આપો, નિર્બળોને મદદ કરો અને દરેક ની સાથે ધીરજથી વર્તો. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />સાવધ રહો કે તમે ભૂંડાઈનો બદલો ભૂંડાઈથી ન વાળો. પરંતુ હંમેશાં એકબીજાનું અને સર્વનું ભલું કરવા કોશિશ કરો.<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />સદા આનંદ કરો, <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />નિત્ય પ્રાર્થના કરો, <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />દરેક સંજોગોમાં ઈશ્વરનો આભાર માનો, કેમકે તમારા વિષે મસીહ ઈસુમાં ઈશ્વરની ઇચ્છા એવી છે.<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />આત્માને ન હોલવો; <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />પ્રબોધને તુચ્છ ન ગણો. <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />દરેક ની પારખ કરો; જે સારું છે તે ગ્રહણ કરો. <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />તમામ દુષ્ટતાઓથી દૂર રહો.<verse eid="1TH 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />હવે શાંતિદાતા ઈશ્વર પોતે તમને સંપૂર્ણ શુધ્ધ અને પવિત્ર બનાવો. વળી તમારાં આત્મા, પ્રાણ અને શરીરને આપણા પ્રભુ ઈસુ મસીહના આગમન સુધી નિર્દોષ રાખો. <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />જે તમને તેડું આપે છે તે વિશ્વાસયોગ્ય છે, તે એમ કરશે.<verse eid="1TH 5:24" /></para>
  <para style="b" />
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />ભાઈઓ અને બહેનો, અમારે માટે પ્રાર્થના કરજો.<verse eid="1TH 5:25" /></para>
  <para style="b" />
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />પ્રભુના સર્વ લોકોને પવિત્ર ચુંબનથી સલામ કહેજો.<verse eid="1TH 5:26" /></para>
  <para style="b" />
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />પ્રભુને નામે હું તમને આગ્રહથી કહું છું કે આ પત્ર સર્વ ભાઈઓ અને બહેનોને વાંચી સંભળાવજો.<verse eid="1TH 5:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />આપણા પ્રભુ ઈસુ મસીહની કૃપા તમ સર્વની સાથે હો.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>