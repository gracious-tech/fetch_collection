<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Mazmure Maxaafa</para>
  <para style="toc1">Mazmure Maxaafa</para>
  <para style="toc3">Maz</para>
  <para style="toc2">Mazmure</para>
  <para style="mt1">Mazmure Maxaafa</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Mazmure maxaafay, Isra7eele asa woosanne galata mazmureta shiishidi oykis. Dumma dumma asati adussa wode giddon ha mazmureta xaafidosona. Isra7eele asay ha mazmureta banta goyinno wodetan go7etoosona. Guyepe Isra7eele asay banta Geeshsha maxaafa giddon gelsidosona.</para>
  <para style="ip">Ha mazmureti daro qommo. Galatanne woosa mazmureta, goyinno mazmureta, Xoossay maaddana mela, naagana malanne saro wothana mela buzo de7osinne biitta ubbaas woossiya woosata, nagara maarotas woossiya woosatanne harata gathidi oykida mazmure. Ha mazmuretape issoti issoti issi ura wozanan si7etida mishata qoncisosona; harati qassi Xoossa asa ubbay koyaabanne asa ubbaas si7etiya hanotata bessiya mazmure.</para>
  <para style="ip">Yesuusi tamaarsishe mazmure maxaafape ekis; Ooratha Caaqo maxaafa xaafetika mazmure maxaafape go7etidosona. Woosa keethi eqida wodepe doomin, mazmure maxaafay goyinno wode ammaniya asay go7etiya eretida maxaafa.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Koyro maxaafa <char style="ior">(<ref loc="PSA 1-41">1—41</ref>)</char></para>
  <para style="io1">Nam7antho maxaafa <char style="ior">(<ref loc="PSA 42-72">42—72</ref>)</char></para>
  <para style="io1">Heedzantho maxaafa <char style="ior">(<ref loc="PSA 73-89">73—89</ref>)</char></para>
  <para style="io1">Oyddantho maxaafa <char style="ior">(<ref loc="PSA 90-106">90—106</ref>)</char></para>
  <para style="io1">Ichashantho maxaafa <char style="ior">(<ref loc="PSA 107-150">107—150</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="PSA 1"/>
  <para style="ms">Koyro Maxaafa</para>
  <para style="mr">(<ref loc="PSA 1-41">Maz 1—41</ref>)</para>
  <para style="s1">Nam7u Ogeta</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 1:1"/>Iitata zoriyan boonnay,</para>
  <para style="q2" vid="PSA 1:1">nagaranchota ogen eqonnay,</para>
  <para style="q2" vid="PSA 1:1">qelqiseyisata shiiqon uttonnay,</para>
  <para style="q1" vid="PSA 1:1">I anjetidaysa.<verse eid="PSA 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 1:2"/>Shin I Godaa higgiyan ufaytees;</para>
  <para style="q2" vid="PSA 1:2">iya higgiya gallasinne qamma qopees.<verse eid="PSA 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 1:3"/>I goggiya haatha xaphon toketidi,</para>
  <para style="q2" vid="PSA 1:3">woden woden ayfe immiya,</para>
  <para style="q2" vid="PSA 1:3">iya haythay qolettonna mitha mela.</para>
  <para style="q1" vid="PSA 1:3">I oothiya ubbay iyaw poletees.<verse eid="PSA 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 1:4"/>Shin iitati hessa mela gidokona;</para>
  <para style="q2" vid="PSA 1:4">carkoy pitidi efiya suulla mela.<verse eid="PSA 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 1:5"/>Iitati xillo pirda bessan eqokona;</para>
  <para style="q2" vid="PSA 1:5">nagaranchoti xillota duulatan bentokona.<verse eid="PSA 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 1:6"/>Goday xillota ogiya erees;</para>
  <para style="q2" vid="PSA 1:6">shin iitata ogey dhayana.<verse eid="PSA 1:6"/></para>
  <chapter eid="PSA 1"/>
  <chapter number="2" style="c" sid="PSA 2"/>
  <para style="s1">Godan Tiyetidaysa Aysuwa</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 2:1"/>Kawotethati ayis dendoona?</para>
  <para style="q2" vid="PSA 2:1">asay ayis coo maqetoona?<verse eid="PSA 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 2:2"/>Kawoti Godaa bollanne I tiyidaysa bolla dendidosona;</para>
  <para style="q2" vid="PSA 2:2">deriya haareysati enta bolla shiiqidosona.<verse eid="PSA 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 2:3"/>“Enta santhalaata duuthoos;</para>
  <para style="q2" vid="PSA 2:3">enta qasho wodoruwa holoos” yaagidosona.<verse eid="PSA 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 2:4"/>Salon uttidaysi enta bolla miicees;</para>
  <para style="q2" vid="PSA 2:4">Goday enta qelqisees.<verse eid="PSA 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 2:5"/>I ba hanquwan enta daganthees;</para>
  <para style="q2" vid="PSA 2:5">ba yiluwan enta yashisees.<verse eid="PSA 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 2:6"/>“Ta geeshsha zuma Xiyoone bolla</para>
  <para style="q2" vid="PSA 2:6">ta kawa kawothas” yaagees goday.<verse eid="PSA 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 2:7"/>Taani Godaa higgiya awaajana;</para>
  <para style="q2" vid="PSA 2:7">Goday tana, “Neeni ta na7aa;</para>
  <para style="q2" vid="PSA 2:7">taani hachi new aawa gidas.<verse eid="PSA 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 2:8"/>Ne tana oycha;</para>
  <para style="q2" vid="PSA 2:8">ta new kawotethata immana;</para>
  <para style="q2" vid="PSA 2:8">sa7a ubbay nebaa gidana.<verse eid="PSA 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 2:9"/>Neeni birata xam7an enta menthana;</para>
  <para style="q2" vid="PSA 2:9">meqa miisheda enta tincherethana” yaagis.<verse eid="PSA 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 2:10"/>Hiza, kawoto eeyopite;</para>
  <para style="q2" vid="PSA 2:10">ha sa7aa haareysato akeekite.<verse eid="PSA 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 2:11"/>Godaa yashshan goyinnite;</para>
  <para style="q2" vid="PSA 2:11">kokoridi kiitetite.<verse eid="PSA 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 2:12"/>Goday hanqetin ogen hinte dhayonnaada</para>
  <para style="q2" vid="PSA 2:12">iya tumatethan goyinnite.</para>
  <para style="q1" vid="PSA 2:12">Iya hanqoy eeson eexi keyana;</para>
  <para style="q2" vid="PSA 2:12">iyan qosetidi attida ubbay anjetidaysata.<verse eid="PSA 2:12"/></para>
  <chapter eid="PSA 2"/>
  <chapter number="3" style="c" sid="PSA 3"/>
  <para style="s1">Meto Be7iya Ura Woosa</para>
  <para style="d">Dawiti ba na7a Abeseloomepe baqatida wode xaafida mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 3:1"/>Abeeti Godaw, ta morketi ay mela daridona!</para>
  <para style="q2" vid="PSA 3:1">Ta bolla dendeysati aapune!<verse eid="PSA 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 3:2"/>Daroti, “Xoossay iya ashshena” yaagidi,</para>
  <para style="q2" vid="PSA 3:2">tabaa haasayoosona. <char style="qs">Salah </char><note caller="+" style="f"><char style="fr" closed="false">3:2: </char><char style="ft" closed="false">Mazmurey yexetiya wode azmaachesinne paydos giddon Godaa bonchoos kaa7etiya muuzuqa kaasse. Shin qaala birshethay eretenna.</char></note><verse eid="PSA 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 3:3"/>Shin abeeti Godaw, ne taw gondalle;</para>
  <para style="q2" vid="PSA 3:3">ta bonchoynne tana dhoqu oothey nena.<verse eid="PSA 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 3:4"/>Ta qaala dhoqu oothada Godaako waassayis.</para>
  <para style="q2" vid="PSA 3:4">I ba geeshsha zumaape taw zaarees. <char style="qs">Salah </char><verse eid="PSA 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 3:5"/>Goday tana naagiya gisho,</para>
  <para style="q2" vid="PSA 3:5">ta zin7asinne dhiskas</para>
  <para style="q2" vid="PSA 3:5">hirgi bayna barkas.<verse eid="PSA 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 3:6"/>Ubba bessara ta bolla dendida,</para>
  <para style="q2" vid="PSA 3:6">daro mukulu asaas yayyike.<verse eid="PSA 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 3:7"/>Abeeti Godaw, denda!</para>
  <para style="q2" vid="PSA 3:7">Abeeti ta Xoossaw tana ashsha!</para>
  <para style="q1" vid="PSA 3:7">Ta morketa gacuwa shoca;</para>
  <para style="q2" vid="PSA 3:7">iitata acha mentha.<verse eid="PSA 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 3:8"/>Xoonoy Godaasa;</para>
  <para style="q2" vid="PSA 3:8">Godaw, neeni ne asaa anja. <char style="qs">Salah </char><verse eid="PSA 3:8"/></para>
  <chapter eid="PSA 3"/>
  <chapter number="4" style="c" sid="PSA 4"/>
  <para style="s1">Ubba Wode Woosa</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure</para>
  <para style="d">Diithan yexetiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 4:1"/>Abeeti tana xillisiya Xoossaw,</para>
  <para style="q2" vid="PSA 4:1">taani nena xeegiya wode taw koya.</para>
  <para style="q1" vid="PSA 4:1">Taani un7etida wode ne tana la77a kessadasa;</para>
  <para style="q2" vid="PSA 4:1">taw qadheta; ta woosa si7a.<verse eid="PSA 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 4:2"/>Hinteno asaw, hinte awude gakanaw</para>
  <para style="q2" vid="PSA 4:2">ta bonchuwa kawushsheetii?</para>
  <para style="q1" vid="PSA 4:2">Awude gakanaw pathonnaba doseetii?</para>
  <para style="q2" vid="PSA 4:2">Awude gakanaw wordo kaalleetii? <char style="qs">Salah </char><verse eid="PSA 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 4:3"/>Goday ammanetiya asata baw dummayidi wothidaysa erite;</para>
  <para style="q2" vid="PSA 4:3">taani Godaa xeegiya wode I tana si7ees.<verse eid="PSA 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 4:4"/>Hanqetite, shin nagara oothopite;</para>
  <para style="q2" vid="PSA 4:4">hinte zin7iya wode</para>
  <para style="q2" vid="PSA 4:4">hinte wozanaa qorite; si77i giite. <char style="qs">Salah </char><verse eid="PSA 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 4:5"/>Godaas like yarsho yarshite;</para>
  <para style="q2" vid="PSA 4:5">iyan ammanetite.<verse eid="PSA 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 4:6"/>“Nuna lo77oba bessanay oonee?”</para>
  <para style="q2" vid="PSA 4:6">yaagidi daroti oychoosona;</para>
  <para style="q2" vid="PSA 4:6">Abeeti Godaw, ne nuna keeha ayfen xeella.<verse eid="PSA 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 4:7"/>Daro gistefenne woyne ushshafe</para>
  <para style="q2" vid="PSA 4:7">ne ta wozanan wothida gita ufaysay aadhees.<verse eid="PSA 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 4:8"/>Abeeti Godaw, ne xalaali tana saro wothiya gisho,</para>
  <para style="q2" vid="PSA 4:8">taani zin7ada wopu gada dhiskayis.<verse eid="PSA 4:8"/></para>
  <chapter eid="PSA 4"/>
  <chapter number="5" style="c" sid="PSA 5"/>
  <para style="s1">Wonta Woosa</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure</para>
  <para style="d">Suusul7en yexetiya mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 5:1"/>Abeeti Godaw, ta qaala si7a;</para>
  <para style="q2" vid="PSA 5:1">ta ooliya qopa.<verse eid="PSA 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 5:2"/>Ta kawaw, ta Xoossaw ta waasuwa si7a;</para>
  <para style="q2" vid="PSA 5:2">ta maade koyada woossiya woosaa hayza.<verse eid="PSA 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 5:3"/>Abeeti Godaw, wonta wonta</para>
  <para style="q2" vid="PSA 5:3">ta qaala si7aasa.</para>
  <para style="q1" vid="PSA 5:3">Wonta wonta ta woosa ne sinthe shiishayis;</para>
  <para style="q2" vid="PSA 5:3">ta ne zaaruwa naagayis.<verse eid="PSA 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 5:4"/>Neeni iitatethan ufaytonna Xoosse;</para>
  <para style="q2" vid="PSA 5:4">iitabay neera deenna.<verse eid="PSA 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 5:5"/>Otoranchoti ne sinthan eqokona;</para>
  <para style="q2" vid="PSA 5:5">iitabaa oothiya ubbaa ne ixaasa.<verse eid="PSA 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 5:6"/>Wordo odeteyisata ne dhaysaasa;</para>
  <para style="q2" vid="PSA 5:6">Goday suuthu gusseysatanne</para>
  <para style="q2" vid="PSA 5:6">cimmeyisata ixees.<verse eid="PSA 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 5:7"/>Shin ta ne gita maarotethan ne keethaa gelana;</para>
  <para style="q2" vid="PSA 5:7">ne geeshsha bessaako simmada nena bonchon goyinnana.<verse eid="PSA 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 5:8"/>Abeeti Godaw, ta morketa gisho gada,</para>
  <para style="q2" vid="PSA 5:8">tana ne xillotethan kaaletha;</para>
  <para style="q2" vid="PSA 5:8">ne ogiya ta sinthan suurisa.<verse eid="PSA 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 5:9"/>Enta mettershan tumi baawa;</para>
  <para style="q2" vid="PSA 5:9">enta wozanan dhaysoy kumis.</para>
  <para style="q1" vid="PSA 5:9">Enta doonay dooyetida duufo mela;</para>
  <para style="q2" vid="PSA 5:9">enti banta inxarsan cimmoosona.<verse eid="PSA 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 5:10"/>Enti ne bolla makallida gisho,</para>
  <para style="q2" vid="PSA 5:10">abeeti Xoossaw, enta pirda;</para>
  <para style="q1" vid="PSA 5:10">Enta tobbay enta ekidi boo;</para>
  <para style="q2" vid="PSA 5:10">enta daro nagaraa gisho enta yedetha.<verse eid="PSA 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 5:11"/>Shin neeko baqatidi attida ubbay ufayto;</para>
  <para style="q2" vid="PSA 5:11">enti merinaw ufaysan yexo.</para>
  <para style="q1" vid="PSA 5:11">Ne sunthaa dosiya ubbay nenan ufaytana mela;</para>
  <para style="q2" vid="PSA 5:11">neeni enta merinaw naaga.<verse eid="PSA 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 5:12"/>Abeeti Godaw, neeni xillota anjaasa;</para>
  <para style="q2" vid="PSA 5:12">gondallen ashsheysada ne keehatethan iya ashsha.<verse eid="PSA 5:12"/></para>
  <chapter eid="PSA 5"/>
  <chapter number="6" style="c" sid="PSA 6"/>
  <para style="s1">Un7a Wode Woosa</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure</para>
  <para style="d">Hospun shayan yexetiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 6:1"/>Abeeti Godaw, ne yiluwan tana seeropa;</para>
  <para style="q2" vid="PSA 6:1">ne sheniyan tana hanqofa.<verse eid="PSA 6:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 6:2"/>Abeeti Godaw, taani daaburancho gidida gisho tana maara;</para>
  <para style="q2" vid="PSA 6:2">abeeti Godaw, ta wozanay argaacida gisho tana mintha.<verse eid="PSA 6:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 6:3"/>Ta shempiya daro un7etasu;</para>
  <para style="q2" vid="PSA 6:3">tana maaddanaw awude gakanaw gam7ay?<verse eid="PSA 6:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 6:4"/>Abeeti Godaw, neeni simmada tana ashsha;</para>
  <para style="q2" vid="PSA 6:4">ne keehatetha daruwan tana kessa eka.<verse eid="PSA 6:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 6:5"/>Hayqida asaa giddofe nena hassayey baawa;</para>
  <para style="q2" vid="PSA 6:5">duufon gididi nena galatey oonee?<verse eid="PSA 6:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 6:6"/>Taani oolen daaburas;</para>
  <para style="q2" vid="PSA 6:6">qamma kumethi yeekashe ta hiixa irxisas;</para>
  <para style="q2" vid="PSA 6:6">ta arsa afuthan wooqisas.<verse eid="PSA 6:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 6:7"/>Ta morketa gaason ta ayfey mulcatis;</para>
  <para style="q2" vid="PSA 6:7">taani afuxida gisho demmonna ixis.<verse eid="PSA 6:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 6:8"/>Goday ta yeehuwa si7ida gisho,</para>
  <para style="q2" vid="PSA 6:8">hinteno, iita ootheysato taape haakite.<verse eid="PSA 6:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 6:9"/>Goday ta waasuwa si7is;</para>
  <para style="q2" vid="PSA 6:9">ta woosa ekis.<verse eid="PSA 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 6:10"/>Ta morketi ubbay yeellatidosona; dagammidosona;</para>
  <para style="q2" vid="PSA 6:10">qoponna guye simmidi kawuyidosona.<verse eid="PSA 6:10"/></para>
  <chapter eid="PSA 6"/>
  <chapter number="7" style="c" sid="PSA 7"/>
  <para style="s1">Meto Wode Xillo Asa Woosa</para>
  <para style="d">Biniyaame kocha Kuuzaba Dawiti Godaas yexida mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 7:1"/>Abeeti Godaw ta Xoossaw, ta nenan qosetayis;</para>
  <para style="q2" vid="PSA 7:1">tana yedethiya ubbaafe tana ashsha.<verse eid="PSA 7:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 7:2"/>Neeni tana ashshonaba gidiyako,</para>
  <para style="q2" vid="PSA 7:2">enti tana gaammoda zaazana;</para>
  <para style="q2" vid="PSA 7:2">ashshiya asi bayna mentherethanashin.<verse eid="PSA 7:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 7:3"/>Abeeti Godaw ta Xoossaw,</para>
  <para style="q2" vid="PSA 7:3">ta haysa melaba oothidaba gidiko,</para>
  <para style="q2" vid="PSA 7:3">taani ase naaqidaba gidiko,<verse eid="PSA 7:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 7:4"/>ta laggetas lo77o gisho iitaa zaaridaba gidiko,</para>
  <para style="q2" vid="PSA 7:4">gaasoy bayna ta morkiya bonqidaba gidiko,<verse eid="PSA 7:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 7:5"/>ta morkey tana yedethidi oyko;</para>
  <para style="q2" vid="PSA 7:5">tana sa7an yeggidi yedho;</para>
  <para style="q2" vid="PSA 7:5">tana baanan gondorsidi kawusho. <char style="qs">Salah </char><verse eid="PSA 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 7:6"/>Abeeti Godaw, ne hanquwan dendada,</para>
  <para style="q2" vid="PSA 7:6">eexiya ta morketa hanquwa bolla eqa;</para>
  <para style="q2" vid="PSA 7:6">ta Xoossaw, ta gisho barka;</para>
  <para style="q2" vid="PSA 7:6">neeni xillo pirda koyaasa.<verse eid="PSA 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 7:7"/>Asay ne yuushon shiiqo;</para>
  <para style="q2" vid="PSA 7:7">neeni entafe bollara haara.<verse eid="PSA 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 7:8"/>Goday kawotethata bolla pirdees;</para>
  <para style="q2" vid="PSA 7:8">abeeti Godaw, ta xillotethaadanne</para>
  <para style="q2" vid="PSA 7:8">ta suuretethaada pirda.<verse eid="PSA 7:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 7:9"/>Qofanne wozanaa shaakada eriya xillo Xoossaw,</para>
  <para style="q2" vid="PSA 7:9">iitata geella hanota neeni teqa;</para>
  <para style="q2" vid="PSA 7:9">shin xilluwa saron naaga.<verse eid="PSA 7:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 7:10"/>Wozana suureta ashshiya,</para>
  <para style="q2" vid="PSA 7:10">Xoossay taw gondalle.<verse eid="PSA 7:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 7:11"/>Xoossay xillo pirdeysa;</para>
  <para style="q2" vid="PSA 7:11">I ubba wode iitata bolla hanqetiya Xoossaa.<verse eid="PSA 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 7:12"/>Iitati banta iitatethaafe simmonna ixiko,</para>
  <para style="q2" vid="PSA 7:12">Xoossay ba mashsha leefes;</para>
  <para style="q2" vid="PSA 7:12">ba dongiya giigisees.<verse eid="PSA 7:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 7:13"/>I ba wodhiya ola miisheta giigisees;</para>
  <para style="q2" vid="PSA 7:13">laxiya ba donge toora pitees.<verse eid="PSA 7:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 7:14"/>Iitati qoho qanthatidi,</para>
  <para style="q2" vid="PSA 7:14">gene wodexidi,</para>
  <para style="q2" vid="PSA 7:14">wordo yeloosona.<verse eid="PSA 7:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 7:15"/>Hara asas olla bookida asi</para>
  <para style="q2" vid="PSA 7:15">ba bookida ollan baw kundees.<verse eid="PSA 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 7:16"/>Iya geney iya huuphen simmees.</para>
  <para style="q2" vid="PSA 7:16">Iya geellatethay iya mees.<verse eid="PSA 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 7:17"/>Iya xillotethaa gisho taani Godaa sabbana;</para>
  <para style="q2" vid="PSA 7:17">Ubbaafe Dhoqa Godaa sunthaas</para>
  <para style="q2" vid="PSA 7:17">taani galata mazmure yexana.<verse eid="PSA 7:17"/></para>
  <chapter eid="PSA 7"/>
  <chapter number="8" style="c" sid="PSA 8"/>
  <para style="s1">Yashshiya Xoossa Bonchuwa</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure</para>
  <para style="d">Suusul7en yexetiya mazmure.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 8:1"/>Abeeti Godaw nu Xoossaw,</para>
  <para style="q2" vid="PSA 8:1">ne sunthay biitta ubban waanidi bonchetide!</para>
  <para style="q1" vid="PSA 8:1">Neeni ne bonchuwa salope bollara</para>
  <para style="q2" vid="PSA 8:1">dhoqu dhoqu oothadasa.<verse eid="PSA 8:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 8:2"/>Neeni ne morketa gisho</para>
  <para style="q2" vid="PSA 8:2">ne morkiyanne nena mandeysa si77i oothanaw,</para>
  <para style="q2" vid="PSA 8:2">guutha nayta doonan</para>
  <para style="q2" vid="PSA 8:2">dhammiya nayta doonan galata<note caller="+" style="f"><char style="fr" closed="false">8:2 </char><char style="fqa" closed="false">Galata: </char><char style="ft" closed="false">Ibraawetho doonan guutha nayta galatan minotethi shiishasa guussu.</char></note> kunthadasa.<verse eid="PSA 8:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 8:3"/>Neeni ne biradhen medhida ne salota,</para>
  <para style="q2" vid="PSA 8:3">iya bessan bessan neeni wothida ageenanne</para>
  <para style="q2" vid="PSA 8:3">xoolintota taani be7iya wode,<verse eid="PSA 8:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 8:4"/>neeni asaba qopanaw asi aybee?</para>
  <para style="q2" vid="PSA 8:4">Woyko neeni iya xomoosanaw I aybee?<verse eid="PSA 8:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 8:5"/>Iya ne neepe guuthara guuthadasa;</para>
  <para style="q2" vid="PSA 8:5">bonchonne gitatetha kallacha</para>
  <para style="q2" vid="PSA 8:5">iya huuphen wothadasa.<verse eid="PSA 8:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 8:6"/>Ne medhida medhetetha ubbaa,</para>
  <para style="q2" vid="PSA 8:6">haarana mela ne iya shuumadasa;</para>
  <para style="q2" vid="PSA 8:6">ubbaa iya tohuwape garsara wothadasa.<verse eid="PSA 8:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 8:7"/>Dorsatanne meheta,</para>
  <para style="q2" vid="PSA 8:7">wora do7ata ubbaa,<verse eid="PSA 8:7"/></para>
  <para style="q2">
    <verse number="8" style="v" sid="PSA 8:8"/>salo kafota, abba molotanne</para>
  <para style="q2" vid="PSA 8:8">haatha garsan qaaxiya ubbaa</para>
  <para style="q2" vid="PSA 8:8">iyaw haarisadasa.<verse eid="PSA 8:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 8:9"/>Abeeti Godaw nu Xoossaw,</para>
  <para style="q2" vid="PSA 8:9">ne sunthay biitta ubban waanidi bonchetide!<verse eid="PSA 8:9"/></para>
  <chapter eid="PSA 8"/>
  <chapter number="9" style="c" sid="PSA 9"/>
  <para style="s1">Iitata Bolla Yaana Pirda</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure</para>
  <para style="d">“Na7a hayqon” geetetiya cuudhethan yexetiya mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 9:1"/>Abeeti Godaw, ta nena ta kumetha wozanaape galatana;</para>
  <para style="q2" vid="PSA 9:1">neeni oothida malaalsiya ooso ubbaa odana.<verse eid="PSA 9:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 9:2"/>Taani nenan ufaytana hashshu gaana.</para>
  <para style="q2" vid="PSA 9:2">Ubbaafe Dhoqa Xoossaw,</para>
  <para style="q2" vid="PSA 9:2">taani ne sunthaas galata mazmure yexana.<verse eid="PSA 9:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 9:3"/>Ta morketi guye simmiya wode,</para>
  <para style="q2" vid="PSA 9:3">ne sinthafe dhubetidi dhayana.<verse eid="PSA 9:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 9:4"/>Ne araatan uttada taw xillo pirdaasa;</para>
  <para style="q2" vid="PSA 9:4">ta mootuwa ne xillotethan oykadasa.<verse eid="PSA 9:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 9:5"/>Neeni kawotethata seeradasa;</para>
  <para style="q2" vid="PSA 9:5">iitata dhaysadasa.</para>
  <para style="q1" vid="PSA 9:5">Neeni enta sunthaa merinaw quchadasa.<verse eid="PSA 9:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 9:6"/>Morketi merinaw dhayidosona;</para>
  <para style="q2" vid="PSA 9:6">enta katamata kumethi laalladasa;</para>
  <para style="q2" vid="PSA 9:6">enti kumethi dogetidosona.<verse eid="PSA 9:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 9:7"/>Shin Goday merinaw kawotidi de7ees;</para>
  <para style="q2" vid="PSA 9:7">I ba araata pirdas giigisis.<verse eid="PSA 9:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 9:8"/>Ha sa7aa xillotethan pirdana;</para>
  <para style="q2" vid="PSA 9:8">dereta suuretethan aysana.<verse eid="PSA 9:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 9:9"/>Goday un7etidaysatas attiya bessi;</para>
  <para style="q2" vid="PSA 9:9">meto wode gelidi attiya qota.<verse eid="PSA 9:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 9:10"/>Nena ereysati nenan ammanetosona;</para>
  <para style="q2" vid="PSA 9:10">Godaw, nena koyeyisata yegga aggaka.<verse eid="PSA 9:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 9:11"/>Xiyoonen kawotida Godaa galatite;</para>
  <para style="q2" vid="PSA 9:11">I oothida oosuwa asa ubbaas odite.<verse eid="PSA 9:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 9:12"/>Halo keyiya Xoossay gukida xillo suuthaa dogenna;</para>
  <para style="q2" vid="PSA 9:12">boretidaysata waasuwa qelli geenna.<verse eid="PSA 9:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 9:13"/>Abeeti Godaw, taw qadheta;</para>
  <para style="q2" vid="PSA 9:13">ta morketi ta bolla ehiya metuwa be7a;</para>
  <para style="q2" vid="PSA 9:13">hayqope tana ashsha.<verse eid="PSA 9:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 9:14"/>Xiyoone asaa giddon taani eqada,</para>
  <para style="q2" vid="PSA 9:14">ne galataa odana;</para>
  <para style="q2" vid="PSA 9:14">ne atotethan ufaytana.<verse eid="PSA 9:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 9:15"/>Kawotethati banta bookida ollan</para>
  <para style="q2" vid="PSA 9:15">bantaw kundidosona;</para>
  <para style="q2" vid="PSA 9:15">enti wothida xihey enta tohuwa oykis.<verse eid="PSA 9:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 9:16"/>Goday ba xillo pirdan eretis;</para>
  <para style="q2" vid="PSA 9:16">iita asay banta iita oosuwan oyketidosona. <char style="qs">Salah </char><verse eid="PSA 9:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 9:17"/>Iitati duufo baana;</para>
  <para style="q2" vid="PSA 9:17">Xoossaa dogiya kawotethati ubbay entada hanana.<verse eid="PSA 9:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 9:18"/>Manqoy ubba wode dogetidi attenna;</para>
  <para style="q2" vid="PSA 9:18">metootanchuwa ufaysay merinaw dhayenna.<verse eid="PSA 9:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 9:19"/>Abeeti Godaw denda; asi xoonopo!</para>
  <para style="q2" vid="PSA 9:19">Kawotethati ne sinthan pirdeto.<verse eid="PSA 9:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 9:20"/>Abeeti Godaw enta neeni yashisa;</para>
  <para style="q2" vid="PSA 9:20">kawotethati ase gideysa ero. <char style="qs">Salaha.</char><verse eid="PSA 9:20"/></para>
  <chapter eid="PSA 9"/>
  <chapter number="10" style="c" sid="PSA 10"/>
  <para style="s1">Suure Pirda Kosha Woosa</para>
  <para style="d">Dawita Mazmure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 10:1"/>Abeeti Godaw, ayis haakada eqay?</para>
  <para style="q2" vid="PSA 10:1">Meto wode ayis neeni geemmay?<verse eid="PSA 10:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 10:2"/>Ba otoruwan iita asi manquwa yedethees;</para>
  <para style="q2" vid="PSA 10:2">enti banta maquwan bantaw oyketidosona.<verse eid="PSA 10:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 10:3"/>Iita asi ba iita amuwan ceeqetees;</para>
  <para style="q2" vid="PSA 10:3">ba uuziyan Godaa cayeesinne kadhees.<verse eid="PSA 10:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 10:4"/>Iitati banta otoruwan Xoossaa koyokona;</para>
  <para style="q2" vid="PSA 10:4">banta qofan Xoossas besse immokona.<verse eid="PSA 10:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 10:5"/>Iyaw ubba wode injetees;</para>
  <para style="q2" vid="PSA 10:5">ne higgey iyaw gelenna;</para>
  <para style="q2" vid="PSA 10:5">ba morketa I qelqisees.<verse eid="PSA 10:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 10:6"/>Ba wozanan, “Tana aybika qaathenna</para>
  <para style="q2" vid="PSA 10:6">tana metoy gakenna” yaagidi qopees.<verse eid="PSA 10:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 10:7"/>Iya doonan baadethi,</para>
  <para style="q2" vid="PSA 10:7">wordoynne mandethi kumis.</para>
  <para style="q2" vid="PSA 10:7">Geneynne iitatethi iyan inxarsan de7ees.<verse eid="PSA 10:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 10:8"/>Gutatan zugidi uttees;</para>
  <para style="q2" vid="PSA 10:8">suure asata wodhanaw qosetidi naagees;</para>
  <para style="q2" vid="PSA 10:8">wolqi bayna daaburanchota wochees.<verse eid="PSA 10:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 10:9"/>Ba qosetida bessan geemmidi,</para>
  <para style="q2" vid="PSA 10:9">manquwa oykanaw gaammoda zugees;</para>
  <para style="q2" vid="PSA 10:9">iya oykidi ba xihiyan goochidi efees.<verse eid="PSA 10:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 10:10"/>Wolqi bayna manquwa shocidi yeggees;</para>
  <para style="q2" vid="PSA 10:10">iya tohuwa garsan I kundees.<verse eid="PSA 10:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 10:11"/>I ba wozanan, “Xoossay dogis.</para>
  <para style="q2" vid="PSA 10:11">Ba som7uwa genthidi be7enna” yaagees.<verse eid="PSA 10:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 10:12"/>Abeeti Godaw, denda!</para>
  <para style="q2" vid="PSA 10:12">Xoossaw, ne wolqaama kushiya dentha;</para>
  <para style="q2" vid="PSA 10:12">manqota dogopa.<verse eid="PSA 10:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 10:13"/>Iita asati Xoosse ayis kadhoona?</para>
  <para style="q2" vid="PSA 10:13">Banta wozanan, “Xoossay nuna seerenna” ayis yaagona?<verse eid="PSA 10:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 10:14"/>Shin Xoossaw, ne metuwanne un7aa be7aasa;</para>
  <para style="q2" vid="PSA 10:14">neeni maaddanaw giiga uttadasa.</para>
  <para style="q1" vid="PSA 10:14">Neeni yi7otas maade,</para>
  <para style="q2" vid="PSA 10:14">qohetiday ne maaddana mela</para>
  <para style="q2" vid="PSA 10:14">bana new aathidi immees.<verse eid="PSA 10:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 10:15"/>Gene asata wolqaa mentha;</para>
  <para style="q2" vid="PSA 10:15">iita asata seera;</para>
  <para style="q2" vid="PSA 10:15">zaaridi enta giddon iitatethi bentofo.<verse eid="PSA 10:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 10:16"/>Goday merinaw kawotidi de7ees;</para>
  <para style="q2" vid="PSA 10:16">hara kawotethati iya biittafe dhayana.<verse eid="PSA 10:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 10:17"/>Abeeti Godaw, neeni ashketa amuwa kunthaasa;</para>
  <para style="q2" vid="PSA 10:17">enta minthetha; enta woosa si7a.<verse eid="PSA 10:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 10:18"/>Yi7otanne un7etidaysata qohonna mela,</para>
  <para style="q2" vid="PSA 10:18">sa7an de7iya oonika enta yashisonna mela,</para>
  <para style="q2" vid="PSA 10:18">neeni entaw pirda.<verse eid="PSA 10:18"/></para>
  <chapter eid="PSA 10"/>
  <chapter number="11" style="c" sid="PSA 11"/>
  <para style="s1">Xillo Asa Ceeqo</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 11:1"/>Goday taani qosetada attiya bessi;</para>
  <para style="q2" vid="PSA 11:1">yaatin ayis “Kafoda zumako baqata” yaagetii?<verse eid="PSA 11:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 11:2"/>Nagaranchoti xillota dhuman caddanaw,</para>
  <para style="q2" vid="PSA 11:2">banta dongiya waaxidi uttidosona.<verse eid="PSA 11:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 11:3"/>Baasoy woddida wode,</para>
  <para style="q2" vid="PSA 11:3">xillo asi ay oothanaw danda7ii?<verse eid="PSA 11:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 11:4"/>Goday ba geeshsha bessan de7ees;</para>
  <para style="q2" vid="PSA 11:4">salon ba araatan uttidi asaa xeellees;</para>
  <para style="q2" vid="PSA 11:4">Godaa ayfey asaa pilgees; wochees.<verse eid="PSA 11:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 11:5"/>Goday xilluwanne worduwa pilgees;</para>
  <para style="q2" vid="PSA 11:5">iitatethi doseyisata ixees.<verse eid="PSA 11:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 11:6"/>Goday iitata bolla eexiya tama bonqonne</para>
  <para style="q2" vid="PSA 11:6">diinne bukisana;</para>
  <para style="q2" vid="PSA 11:6">dhaysiya goten enta seerana.<verse eid="PSA 11:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 11:7"/>Goday xillo gidida gisho, xillotethi dosees;</para>
  <para style="q2" vid="PSA 11:7">suure asati iya som7uwa be7ana.<verse eid="PSA 11:7"/></para>
  <chapter eid="PSA 11"/>
  <chapter number="12" style="c" sid="PSA 12"/>
  <para style="s1">Alame Iitatethaafe Atetha Woosa</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 12:1"/>Xoossa asi biittafe wurida gisho,</para>
  <para style="q2" vid="PSA 12:1">asa giddon ammanetethi bayna gisho,</para>
  <para style="q2" vid="PSA 12:1">Godaw nuna maaddarkii?<verse eid="PSA 12:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 12:2"/>Ubbay wordo haasayoosona;</para>
  <para style="q2" vid="PSA 12:2">issoy issuwa cimmiya inxarsan</para>
  <para style="q2" vid="PSA 12:2">nam7u wozanan odetoosona.<verse eid="PSA 12:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 12:3"/>Abeeti Godaw, cimmiya doona gorda;</para>
  <para style="q2" vid="PSA 12:3">otoron ceeqetiya inxarsaa teqa.<verse eid="PSA 12:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 12:4"/>Enti, “Nu inxarsan nu xoonana;</para>
  <para style="q2" vid="PSA 12:4">nu doonay nuusa;</para>
  <para style="q2" vid="PSA 12:4">nuus godi oonee?” yaagosona.<verse eid="PSA 12:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 12:5"/>“Manqota un7aa gishonne,</para>
  <para style="q2" vid="PSA 12:5">metootanchota ooliya gisho,</para>
  <para style="q2" vid="PSA 12:5">ha77i taani dendana;</para>
  <para style="q2" vid="PSA 12:5">enti amotiya sarotethaa entaw immana” yaagees Goday.<verse eid="PSA 12:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 12:6"/>Godaa qaalay geeshshi;</para>
  <para style="q2" vid="PSA 12:6">taman laapun toho seerida birada geeshshi.<verse eid="PSA 12:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 12:7"/>Abeeti Godaw neeni enta naaga;</para>
  <para style="q2" vid="PSA 12:7">haysa mela asape merinaw enta ashsha.<verse eid="PSA 12:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 12:8"/>Iiti asaa giddon bonchetiya wode,</para>
  <para style="q2" vid="PSA 12:8">geella asati ceeqetishe simeretoosona.<verse eid="PSA 12:8"/></para>
  <chapter eid="PSA 12"/>
  <chapter number="13" style="c" sid="PSA 13"/>
  <para style="s1">Xoossan Zempiya Ura Woosa</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 13:1"/>Abeeti Godaw awude gakanaw tana dogay?</para>
  <para style="q2" vid="PSA 13:1">Awude gakanaw neeni taape geemmay?<verse eid="PSA 13:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 13:2"/>Ta shempiya awude gakanaw un7etanee?</para>
  <para style="q2" vid="PSA 13:2">Ta wozanay azzanon awude gakanaw daanee?</para>
  <para style="q2" vid="PSA 13:2">Ta morkey ta bolla awude gakanaw goobanee?<verse eid="PSA 13:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 13:3"/>Godaw ta Xoossaw,</para>
  <para style="q2" vid="PSA 13:3">ha77i tana xeellada taw zaara.</para>
  <para style="q1" vid="PSA 13:3">Ta ayfiya poo7isada,</para>
  <para style="q2" vid="PSA 13:3">tana hayqope ashsha.<verse eid="PSA 13:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 13:4"/>Ta morketi, “Nuuni iya xoonida”,</para>
  <para style="q2" vid="PSA 13:4">yaagidi ceeqetonnaada teqa;</para>
  <para style="q2" vid="PSA 13:4">ta kundethan enti ufaytonnaada digga.<verse eid="PSA 13:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 13:5"/>Shin taani ne maarotethan ammanetayis;</para>
  <para style="q2" vid="PSA 13:5">neeni tana ashshiya gisho ufaytayis.<verse eid="PSA 13:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 13:6"/>Ne taw keehida gisho,</para>
  <para style="q2" vid="PSA 13:6">Godaw, ta new yexana.<verse eid="PSA 13:6"/></para>
  <chapter eid="PSA 13"/>
  <chapter number="14" style="c" sid="PSA 14"/>
  <para style="s1">Xoosse Erona Asata</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 14:1"/>Eeyati banta wozanan, “Xoossi baawa” yaagosona;</para>
  <para style="q2" vid="PSA 14:1">enta de7oy iitis.</para>
  <para style="q1" vid="PSA 14:1">Enti ixetidaba oothosona;</para>
  <para style="q2" vid="PSA 14:1">lo77oba oothiya asi baawa.<verse eid="PSA 14:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 14:2"/>Akeekeynne Xoosse koyey de7iyako be7anaw,</para>
  <para style="q2" vid="PSA 14:2">Goday salope duge ase xeellees.<verse eid="PSA 14:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 14:3"/>Shin ubbay zoko zaaridosona;</para>
  <para style="q2" vid="PSA 14:3">ubbay go77onnaba gididosona.</para>
  <para style="q1" vid="PSA 14:3">Lo77oba oothiya oonika baawa;</para>
  <para style="q2" vid="PSA 14:3">hari attoshin issi asika baawa.<verse eid="PSA 14:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 14:4"/>Asi kathi meysada,</para>
  <para style="q2" vid="PSA 14:4">enti ta asaa bonqidi moosona;</para>
  <para style="q2" vid="PSA 14:4">ha iita asati aybaka erokona;</para>
  <para style="q2" vid="PSA 14:4">enti Xoossaa woossokona.<verse eid="PSA 14:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 14:5"/>Shin Xoossay xillo asaara de7iya gisho,</para>
  <para style="q2" vid="PSA 14:5">iita asati yashshan kokoroosona.<verse eid="PSA 14:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 14:6"/>Hinte manqota qofaa laalleeta;</para>
  <para style="q2" vid="PSA 14:6">shin Goday manqoti qosetidi attiya besse.<verse eid="PSA 14:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 14:7"/>Isra7eeles atotethi Xiyoonepe yeerenne!</para>
  <para style="q2" vid="PSA 14:7">Goday enta duussa zaariya wode,</para>
  <para style="q1" vid="PSA 14:7">Yayqooba kochay ufaytana;</para>
  <para style="q2" vid="PSA 14:7">Isra7eele asay hashshu gaana.<verse eid="PSA 14:7"/></para>
  <chapter eid="PSA 14"/>
  <chapter number="15" style="c" sid="PSA 15"/>
  <para style="s1">Xoossi Dosiya Asa Kando</para>
  <para style="d">Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 15:1"/>Abeeti Godaw, ne dunkaaniyan gam7anay oonee?</para>
  <para style="q2" vid="PSA 15:1">Ne geeshsha zuma bolla daanay oonee?<verse eid="PSA 15:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 15:2"/>Suure de7o de7ey,</para>
  <para style="q2" vid="PSA 15:2">xillobaa oothey,</para>
  <para style="q2" vid="PSA 15:2">ba wozanaape tuma odetey,<verse eid="PSA 15:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 15:3"/>hara asa sunthi iissonnay,</para>
  <para style="q2" vid="PSA 15:3">ba laggiya bolla iitabaa oothonnay,</para>
  <para style="q2" vid="PSA 15:3">ba laagiya zigironnay,<verse eid="PSA 15:3"/></para>
  <para style="q2">
    <verse number="4" style="v" sid="PSA 15:4"/>iita asata kadhey,</para>
  <para style="q2" vid="PSA 15:4">Godaa yayiya asata bonchey,</para>
  <para style="q2" vid="PSA 15:4">qohetidika ba caaquwa poley,<verse eid="PSA 15:4"/></para>
  <para style="q2">
    <verse number="5" style="v" sid="PSA 15:5"/>ba miishiya yelon tal7onnay,</para>
  <para style="q2" vid="PSA 15:5">xillo asi qohanaw wodhaafe ekonnay,</para>
  <para style="q2" vid="PSA 15:5">haysata oothiya uray merinaw qaaxenna.<verse eid="PSA 15:5"/></para>
  <chapter eid="PSA 15"/>
  <chapter number="16" style="c" sid="PSA 16"/>
  <para style="s1">Xoossay Ta Laata</para>
  <para style="d">Dawita Woosa.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 16:1"/>Abeeti Xoossaw,</para>
  <para style="q2" vid="PSA 16:1">ta neeko baqatiya gisho tana naaga.<verse eid="PSA 16:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 16:2"/>Taani Xoossaa, “Neeni ta Godaa;</para>
  <para style="q2" vid="PSA 16:2">neepe attishin, hari lo77obay taw baawa” yaagas.<verse eid="PSA 16:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 16:3"/>Sa7an de7iya geeshshati</para>
  <para style="q2" vid="PSA 16:3">ay mela bonchetidonaa!</para>
  <para style="q2" vid="PSA 16:3">Ta entara issife ufaytayis.<verse eid="PSA 16:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 16:4"/>Hara xoossata kaalleysati</para>
  <para style="q2" vid="PSA 16:4">banta bolla meto darsoosona.</para>
  <para style="q1" vid="PSA 16:4">Shin taani hara xoossatas suuthi yarshike;</para>
  <para style="q2" vid="PSA 16:4">taani enta sunthaa xeegike.<verse eid="PSA 16:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 16:5"/>Ta Godaw ta laatay nena;</para>
  <para style="q2" vid="PSA 16:5">taw koshshiya ubbaa taw immaasa;</para>
  <para style="q2" vid="PSA 16:5">ta de7uwa saamay nena.<verse eid="PSA 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 16:6"/>Tana gakida saamay ay mela lo77o!</para>
  <para style="q2" vid="PSA 16:6">Ee ta laatay tuma lo77o!<verse eid="PSA 16:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 16:7"/>Tana zorida Godaa galatayis;</para>
  <para style="q2" vid="PSA 16:7">qamma ta wozanay tana tamaarsees.<verse eid="PSA 16:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 16:8"/>Taani ubba wode Godaa ta sinthan be7ayis;</para>
  <para style="q2" vid="PSA 16:8">I ta ushachan de7iya gisho dagammike.<verse eid="PSA 16:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 16:9"/>Hessa gisho, ta wozanay ufaytees;</para>
  <para style="q2" vid="PSA 16:9">ta inxarsay galatees;</para>
  <para style="q2" vid="PSA 16:9">ta asatethay hirgi bayna de7ees.<verse eid="PSA 16:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 16:10"/>Ta shempiw si7oolen aggaka;</para>
  <para style="q2" vid="PSA 16:10">ne Geeshshaa wooqana mela oothaka.<verse eid="PSA 16:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 16:11"/>Tana de7o ogiya bessaasa;</para>
  <para style="q2" vid="PSA 16:11">ne sinthan kumetha ufaysi de7ees;</para>
  <para style="q2" vid="PSA 16:11">ne ushachan merinaa injey de7ees.<verse eid="PSA 16:11"/></para>
  <chapter eid="PSA 16"/>
  <chapter number="17" style="c" sid="PSA 17"/>
  <para style="s1">Xillo Asa Woosa</para>
  <para style="d">Dawita Woosa.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 17:1"/>Abeeti Godaw, ta xillo maggannuwa si7a;</para>
  <para style="q2" vid="PSA 17:1">taani neeko waassiya waasuwa hayza.</para>
  <para style="q1" vid="PSA 17:1">Cimon gidonashin tuman,</para>
  <para style="q2" vid="PSA 17:1">woossiya woosa zaara.<verse eid="PSA 17:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 17:2"/>Ne xillo pirday taw qonco;</para>
  <para style="q2" vid="PSA 17:2">ne ayfey tumaa xeello.<verse eid="PSA 17:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 17:3"/>Neeni qamma tana xomoosadasa;</para>
  <para style="q2" vid="PSA 17:3">ta wozanaa paacadasa.</para>
  <para style="q1" vid="PSA 17:3">Shin paacadaka ta bolla aykoka demmabaaka;</para>
  <para style="q2" vid="PSA 17:3">ta inxarsayka baletibeenna.<verse eid="PSA 17:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 17:4"/>Taani hara asatada iitabaa haasayike;</para>
  <para style="q2" vid="PSA 17:4">taani ne qaala naagiya gisho, gene ogiya kaallabike.<verse eid="PSA 17:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 17:5"/>Ta tohoy dhubetonna mela,</para>
  <para style="q2" vid="PSA 17:5">ta tangoy ne ogiyape gaxa keybeenna.<verse eid="PSA 17:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 17:6"/>Abeeti Xoossaw ta woosa ne si7iya gisho,</para>
  <para style="q2" vid="PSA 17:6">taani nena woossayis.</para>
  <para style="q1" vid="PSA 17:6">Ne haythaa taako zaarada,</para>
  <para style="q2" vid="PSA 17:6">ta qaala si7a.<verse eid="PSA 17:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 17:7"/>Banta morketape baqateyisata,</para>
  <para style="q2" vid="PSA 17:7">ne ushacha kushen qottada ashsheyso,</para>
  <para style="q2" vid="PSA 17:7">ne keehatetha malaalsiya ogen bessa.<verse eid="PSA 17:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 17:8"/>Ne ayfe na77e mela tana naaga;</para>
  <para style="q2" vid="PSA 17:8">ne qefiya garsan tana qosa.<verse eid="PSA 17:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 17:9"/>Tana un7ethiya iitatape;</para>
  <para style="q2" vid="PSA 17:9">teqidi oykida morketape ashsha.<verse eid="PSA 17:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 17:10"/>Entaw qadhey baawa;</para>
  <para style="q2" vid="PSA 17:10">otoron haasayoosona.<verse eid="PSA 17:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 17:11"/>Tana gooddidi oykidosona; teqidosona;</para>
  <para style="q2" vid="PSA 17:11">tana biittan holidi yegganaw xeelloosona.<verse eid="PSA 17:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 17:12"/>Enti miyaba koyiya gaammo mela;</para>
  <para style="q2" vid="PSA 17:12">qosetidi naagiya wodala gaammo mela.<verse eid="PSA 17:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 17:13"/>Godaw, denda;</para>
  <para style="q2" vid="PSA 17:13">ta morketara eqetada enta sa7an yegga;</para>
  <para style="q2" vid="PSA 17:13">ne mashshan iitata kushepe tana ashsha.<verse eid="PSA 17:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 17:14"/>Godaw, haysa mela asape tana qosa;</para>
  <para style="q2" vid="PSA 17:14">enta qaaday sa7aba gidida asape</para>
  <para style="q2" vid="PSA 17:14">ne kushen tana ashsha.</para>
  <para style="q1" vid="PSA 17:14">Ne minjida seeran enta kalsa;</para>
  <para style="q2" vid="PSA 17:14">he seeray enta naytas gididi,</para>
  <para style="q2" vid="PSA 17:14">enta nayta naytas palaho.<verse eid="PSA 17:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 17:15"/>Shin taani xillotethan ne som7uwa be7ana;</para>
  <para style="q2" vid="PSA 17:15">ta barkiya wode ne malaa be7ada ufaytana.<verse eid="PSA 17:15"/></para>
  <chapter eid="PSA 17"/>
  <chapter number="18" style="c" sid="PSA 18"/>
  <para style="s1">Xoono Mazmure</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure</para>
  <para style="d">Goday iya morketapenne Saa7ola kushepe ashshida wode Dawiti Godaas yexida mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 18:1"/>Abeeti Godaw, ta wolqaw,</para>
  <para style="q2" vid="PSA 18:1">taani nena dosayis.<verse eid="PSA 18:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 18:2"/>Goday ta zaalla; ta miixa; tana ashsheysa;</para>
  <para style="q2" vid="PSA 18:2">ta Xoossay ta iyako baqatiya ta zaalla.</para>
  <para style="q1" vid="PSA 18:2">I taw gondalle; tana ashshiya wolqa;</para>
  <para style="q2" vid="PSA 18:2">taani qosetada attiya besse.<verse eid="PSA 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 18:3"/>Galata bessiya Godaa ta xeegayis;</para>
  <para style="q2" vid="PSA 18:3">ta morketape taani attana.<verse eid="PSA 18:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 18:4"/>Hayqo wodoroy tana cuullis;</para>
  <para style="q2" vid="PSA 18:4">dhayo di7oy tana daganthis.<verse eid="PSA 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 18:5"/>Duufo wodoroy ta bolla xaaxetis;</para>
  <para style="q2" vid="PSA 18:5">hayqo xihey tana oykis.<verse eid="PSA 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 18:6"/>Ta un7an Godaa xeegas;</para>
  <para style="q2" vid="PSA 18:6">tana maaddana mela ta Xoossaako waassas.</para>
  <para style="q1" vid="PSA 18:6">Ba keethan gididi ta girsaa si7is;</para>
  <para style="q2" vid="PSA 18:6">ta waasoy iya haythan wodhis.<verse eid="PSA 18:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 18:7"/>Xoossay hanqetida gisho,</para>
  <para style="q2" vid="PSA 18:7">biittay qaaxis;</para>
  <para style="q2" vid="PSA 18:7">dereta xaphoy kokoris.<verse eid="PSA 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 18:8"/>Iya siidhiyape hanqo cuyay keyis;</para>
  <para style="q2" vid="PSA 18:8">iya doonape miya tama lacoy keyis;</para>
  <para style="q2" vid="PSA 18:8">I xuuggiya bonqo cuttis.<verse eid="PSA 18:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 18:9"/>Saluwa phalqidi wodhis;</para>
  <para style="q2" vid="PSA 18:9">iya tohuwape garsan dhuma shaari de7ees.<verse eid="PSA 18:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 18:10"/>Kiruubeta bolla uttidi paallis;</para>
  <para style="q2" vid="PSA 18:10">carko qefen pude dendis.<verse eid="PSA 18:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 18:11"/>Bana dhuman kammis;</para>
  <para style="q2" vid="PSA 18:11">iya dunkaaney iran kumida shaara.<verse eid="PSA 18:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 18:12"/>Iya sinthan de7iya gita poo7uwape</para>
  <para style="q2" vid="PSA 18:12">shachinne tama lacoy keyidi</para>
  <para style="q2" vid="PSA 18:12">dhuma shaara kanthidi bis.<verse eid="PSA 18:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 18:13"/>Goday dadada salope guummis;</para>
  <para style="q2" vid="PSA 18:13">Ubbaafe Dhoqa Xoossay ba girsaa sissis;</para>
  <para style="q2" vid="PSA 18:13">wol7anthaninne tama lacon qoncis.<verse eid="PSA 18:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 18:14"/>Ba dongiya dukidi ba morketa laallis;</para>
  <para style="q2" vid="PSA 18:14">wol7antha poo7o kiittidi enta yedethis.<verse eid="PSA 18:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 18:15"/>Abeeti Godaw, neeni seerida wode,</para>
  <para style="q2" vid="PSA 18:15">shenetada peenuqida wode,</para>
  <para style="q1" vid="PSA 18:15">Abbay zin7ida biittay bentis;</para>
  <para style="q2" vid="PSA 18:15">sa7a baasoy qoncis.<verse eid="PSA 18:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 18:16"/>Goday bollafe kushiya yeddidi tana oykis;</para>
  <para style="q2" vid="PSA 18:16">ciimmo haathaafe tana dafidi kessis.<verse eid="PSA 18:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 18:17"/>Ta bolla daro wolqaamida</para>
  <para style="q2" vid="PSA 18:17">ta morketapenne</para>
  <para style="q2" vid="PSA 18:17">tana ixeysatape ashshis.<verse eid="PSA 18:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 18:18"/>Ta metootida wode enti ta bolla dendidosona;</para>
  <para style="q2" vid="PSA 18:18">shin Goday tana katisis.<verse eid="PSA 18:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 18:19"/>I tana dalga bessi kessis;</para>
  <para style="q2" vid="PSA 18:19">tanan ufaytida gisho tana ashshis.<verse eid="PSA 18:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 18:20"/>Ta xillotethaada Goday taw qanxis;</para>
  <para style="q2" vid="PSA 18:20">ta kushe geeshshatethaada I taw zaaris.<verse eid="PSA 18:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 18:21"/>Taani Godaa ogiya kaallas;</para>
  <para style="q2" vid="PSA 18:21">ta Xoossaa aggada kare keyabike.<verse eid="PSA 18:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 18:22"/>Taani iya higgiya ubbaa naagas;</para>
  <para style="q2" vid="PSA 18:22">iya kiitaa polo aggabike.<verse eid="PSA 18:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 18:23"/>Taani iya sinthan suure de7as;</para>
  <para style="q2" vid="PSA 18:23">tana nagarape naagas.<verse eid="PSA 18:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 18:24"/>Goday ta xillotethaadanne</para>
  <para style="q2" vid="PSA 18:24">ta kushe geeshshatethaada taw zaaris.<verse eid="PSA 18:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 18:25"/>Ammaneteysatas ne ammanetaasa;</para>
  <para style="q2" vid="PSA 18:25">suuretas ne suure.<verse eid="PSA 18:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 18:26"/>Geeshshatas ne geeshshi;</para>
  <para style="q2" vid="PSA 18:26">shin geellatas ne geella.<verse eid="PSA 18:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 18:27"/>Ashketa ashshaasa;</para>
  <para style="q2" vid="PSA 18:27">shin otoranchota kawushaasa.<verse eid="PSA 18:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 18:28"/>Abeeti Godaw, ne taw xompaasa;</para>
  <para style="q2" vid="PSA 18:28">ta Xoossay ta dhumaa poo7isaasa.<verse eid="PSA 18:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 18:29"/>Ne maaduwan ta morke toora bolla dendayis;</para>
  <para style="q2" vid="PSA 18:29">ta Xoossan miixaa xeerara gupada aadhayis.<verse eid="PSA 18:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 18:30"/>Xoossaa ogey polo;</para>
  <para style="q2" vid="PSA 18:30">Godaa qaalay geeshshi;</para>
  <para style="q2" vid="PSA 18:30">iyako baqatiya ubbaas I gondalle.<verse eid="PSA 18:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 18:31"/>Godaape attishin, hara xoossi oonee?</para>
  <para style="q2" vid="PSA 18:31">nu Xoossaafe attishin, hara zaalli oonee?<verse eid="PSA 18:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 18:32"/>Taw wolqa immeynne</para>
  <para style="q2" vid="PSA 18:32">ta ogiya saro oothey Xoossaa.<verse eid="PSA 18:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 18:33"/>I ta tohuwa gen7e tohoda minthees;</para>
  <para style="q2" vid="PSA 18:33">dhoqa bessan hirgi bayna essees.<verse eid="PSA 18:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 18:34"/>Ta kushiya ola tamaarsees;</para>
  <para style="q2" vid="PSA 18:34">naase birata dongiya dukana mela</para>
  <para style="q2" vid="PSA 18:34">ta qessiya minthees.<verse eid="PSA 18:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 18:35"/>Tana ashshiya ne gondalliya taw immadasa;</para>
  <para style="q2" vid="PSA 18:35">ne ushacha kushey tana zempisees;</para>
  <para style="q2" vid="PSA 18:35">ne lo77o oykethay tana gitayees.<verse eid="PSA 18:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 18:36"/>Ta hemetiya bessaa dalgisadasa;</para>
  <para style="q2" vid="PSA 18:36">ta tohuwa harchuchi ekibeenna.<verse eid="PSA 18:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 18:37"/>Ta morketa yedethada oykas;</para>
  <para style="q2" vid="PSA 18:37">enta dhaysona guye simmike.<verse eid="PSA 18:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 18:38"/>Enti zaari dendonnaada shocas;</para>
  <para style="q2" vid="PSA 18:38">enti ta tohuwa garsan kundidosona.<verse eid="PSA 18:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 18:39"/>Olas tana dancisadasa;</para>
  <para style="q2" vid="PSA 18:39">taara gaaddeteyisata taw gulbatisadasa.<verse eid="PSA 18:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 18:40"/>Ta morketa ta sinthafe guye zaaradasa;</para>
  <para style="q2" vid="PSA 18:40">tana ixeyisata dhaysas.<verse eid="PSA 18:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 18:41"/>Maade koyidi waassidosona,</para>
  <para style="q2" vid="PSA 18:41">shin oonika enta ashshibeenna.</para>
  <para style="q1" vid="PSA 18:41">Godaa enti xeegidosona,</para>
  <para style="q2" vid="PSA 18:41">shin I entaw koybeenna.<verse eid="PSA 18:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 18:42"/>Carkoy pitidi efiya baanada enta liiqisas;</para>
  <para style="q2" vid="PSA 18:42">oge urqada enta yedhas.<verse eid="PSA 18:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 18:43"/>Gene asape tana ashshadasa;</para>
  <para style="q2" vid="PSA 18:43">tana kawotethata bolla shuumadasa;</para>
  <para style="q2" vid="PSA 18:43">ta eronna asay taw haaretidosona.<verse eid="PSA 18:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 18:44"/>Enti tabaa si7idi taw kiitetoosona;</para>
  <para style="q2" vid="PSA 18:44">allaga derey ta sinthan ziggees.<verse eid="PSA 18:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 18:45"/>Enti kaha dhayidosona;</para>
  <para style="q2" vid="PSA 18:45">banta miixape kokorishe yoosona.<verse eid="PSA 18:45"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 18:46"/>Goday de7ees!</para>
  <para style="q2" vid="PSA 18:46">Xoossay, ta zaallay galatetto!</para>
  <para style="q2" vid="PSA 18:46">Tana ashshiya Xoossay dhoqu dhoqu go!<verse eid="PSA 18:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 18:47"/>I taw halo kessiya Xoossaa;</para>
  <para style="q2" vid="PSA 18:47">kawotethata ta garsan haariseysa.<verse eid="PSA 18:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 18:48"/>Ta morketape tana ashsheysa;</para>
  <para style="q2" vid="PSA 18:48">tana ixeyisata bolla dhoqu dhoqu oothaasa;</para>
  <para style="q2" vid="PSA 18:48">iitatape tana ashshaasa.<verse eid="PSA 18:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 18:49"/>Hessa gisho, Godaw</para>
  <para style="q2" vid="PSA 18:49">kawotethata giddon taani nena galatana;</para>
  <para style="q2" vid="PSA 18:49">ne sunthaa sabbana.<verse eid="PSA 18:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 18:50"/>I ba kawas xoono immees;</para>
  <para style="q2" vid="PSA 18:50">ba tiyidaysas, Dawitasinne iya kochaas,</para>
  <para style="q2" vid="PSA 18:50">ba keehatetha bessees.<verse eid="PSA 18:50"/></para>
  <chapter eid="PSA 18"/>
  <chapter number="19" style="c" sid="PSA 19"/>
  <para style="s1">Xoossa Higgen Borey Baawa</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 19:1"/>Saloti Xoossaa bonchuwa haasayoosona;</para>
  <para style="q2" vid="PSA 19:1">salo gufanthoy iya kushe oosuwa awaajees.<verse eid="PSA 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 19:2"/>Issi gallasi hara gallassas hessa odees;</para>
  <para style="q2" vid="PSA 19:2">issi qammi hara qammas eratethi qoncisees.<verse eid="PSA 19:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 19:3"/>Odi woyko qaali baawa;</para>
  <para style="q2" vid="PSA 19:3">enta girsay si7etenna.<verse eid="PSA 19:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 19:4"/>Gidoshin enta oday sa7a ubban laaletis;</para>
  <para style="q2" vid="PSA 19:4">enta qaalay biitta gaxaa gakis.</para>
  <para style="q1" vid="PSA 19:4">Awi de7iya bessi Xoossay salon giigisis.<verse eid="PSA 19:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 19:5"/>Ba soope keyiya mishirada,</para>
  <para style="q2" vid="PSA 19:5">gaadde woxanaw ufaytidi giigida asada,</para>
  <para style="q2" vid="PSA 19:5">away wonta wonta keyees.<verse eid="PSA 19:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 19:6"/>Issi bagga salo gaxape keyidi,</para>
  <para style="q2" vid="PSA 19:6">hara bagga salo gaxa gakanaw bees;</para>
  <para style="q2" vid="PSA 19:6">iya suulape geemmiyabay baawa.<verse eid="PSA 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 19:7"/>Godaa higgey suure;</para>
  <para style="q2" vid="PSA 19:7">shempo zaarees.</para>
  <para style="q1" vid="PSA 19:7">Godaa kiitay ammanetidaysa;</para>
  <para style="q2" vid="PSA 19:7">akeeki pacidaysata cinca oothees.<verse eid="PSA 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 19:8"/>Godaa wogay like;</para>
  <para style="q2" vid="PSA 19:8">wozana ufaysees.</para>
  <para style="q2" vid="PSA 19:8">Godaa kiitay geeshshi;</para>
  <para style="q2" vid="PSA 19:8">ayfe poo7isees.<verse eid="PSA 19:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 19:9"/>Godaas yashshi geeshshi;</para>
  <para style="q2" vid="PSA 19:9">merinaw eqidi de7ees.</para>
  <para style="q2" vid="PSA 19:9">Godaa pirday kumethi tumanne xillo.<verse eid="PSA 19:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 19:10"/>Worqafe aadhidi koyetees;</para>
  <para style="q2" vid="PSA 19:10">walahi bayna worqafe aadhidi lo77o.</para>
  <para style="q1" vid="PSA 19:10">Eessafe aadhidi lo77o</para>
  <para style="q2" vid="PSA 19:10">ililo eessafe aadhidi mal7o.<verse eid="PSA 19:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 19:11"/>Ne aylley naagetana mela zorees;</para>
  <para style="q2" vid="PSA 19:11">ne higgiya naagoy daro go77ees.<verse eid="PSA 19:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 19:12"/>Ba qohuwa demmey oonee?</para>
  <para style="q2" vid="PSA 19:12">Abeeti Godaw, geemmida nagarape tana geeshsha.<verse eid="PSA 19:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 19:13"/>Tana ne aylliya,</para>
  <para style="q2" vid="PSA 19:13">erishe oothiya nagarape naaga.</para>
  <para style="q1" vid="PSA 19:13">Nagari tana haaronna mela maadda;</para>
  <para style="q2" vid="PSA 19:13">he wode taani suure gidana,</para>
  <para style="q2" vid="PSA 19:13">gita balape geeyana.<verse eid="PSA 19:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 19:14"/>Abeeti Godaw, ta zaallaw, tana wozeyso;</para>
  <para style="q2" vid="PSA 19:14">ta doonape keyiya qaalaynne</para>
  <para style="q2" vid="PSA 19:14">ta wozanaa qofay nena ufaysiyabaa gido.<verse eid="PSA 19:14"/></para>
  <chapter eid="PSA 19"/>
  <chapter number="20" style="c" sid="PSA 20"/>
  <para style="s1">Xoossan Ammaneta</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 20:1"/>Meto wode Goday nena si7o;</para>
  <para style="q2" vid="PSA 20:1">Yayqooba Xoossaa sunthay nena naago.<verse eid="PSA 20:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 20:2"/>Ba keethaafe new maado kiitto;</para>
  <para style="q2" vid="PSA 20:2">Xiyoonepe nena katiso.<verse eid="PSA 20:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 20:3"/>I ne yarsho ubbaa hassayo;</para>
  <para style="q2" vid="PSA 20:3">ne xuussa yarshuwan ufayto. <char style="qs">Salaha </char><verse eid="PSA 20:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 20:4"/>Ne wozanaa amuwa new immo;</para>
  <para style="q2" vid="PSA 20:4">ne qofaa ubbaa polo.<verse eid="PSA 20:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 20:5"/>Ne xoonuwan nuna ufayso;</para>
  <para style="q2" vid="PSA 20:5">nu Xoossa sunthan nu bandira dhoqu oothana;</para>
  <para style="q2" vid="PSA 20:5">ne woosa ubbaa Goday new zaaro.<verse eid="PSA 20:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 20:6"/>Goday ba doorida kawas,</para>
  <para style="q2" vid="PSA 20:6">xoono immidaysa taani buroo erayis.</para>
  <para style="q1" vid="PSA 20:6">I ba geeshsha saluwan si7ana;</para>
  <para style="q2" vid="PSA 20:6">ba ushacha kushen gita xoono iyaw immana.<verse eid="PSA 20:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 20:7"/>Issoti issoti banta ola para gaariyan,</para>
  <para style="q2" vid="PSA 20:7">harati banta paran ceeqetoosona;</para>
  <para style="q2" vid="PSA 20:7">shin nuuni Godaa nu Xoossaa wolqan ceeqetoos.<verse eid="PSA 20:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 20:8"/>Enti dhubetidi kundana;</para>
  <para style="q2" vid="PSA 20:8">shin nuuni dendidi minni eqana.<verse eid="PSA 20:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 20:9"/>Abeeti Godaw, kawas xoono imma;</para>
  <para style="q2" vid="PSA 20:9">nuuni nena xeegiya wode si7a.<verse eid="PSA 20:9"/></para>
  <chapter eid="PSA 20"/>
  <chapter number="21" style="c" sid="PSA 21"/>
  <para style="s1">Kawoy Xoossan Ufaytees</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 21:1"/>Godaw, kawoy ne wolqan ufaytees;</para>
  <para style="q2" vid="PSA 21:1">ne immida xoonuwan hashshu gees.<verse eid="PSA 21:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 21:2"/>Iya Wozanaa amuwa iyaw immadasa;</para>
  <para style="q2" vid="PSA 21:2">iya mettersha woosa iya diggabaaka. <char style="qs">Salaha </char><verse eid="PSA 21:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 21:3"/>Lo77o anjora iya mokaasa;</para>
  <para style="q2" vid="PSA 21:3">walahi bayna worqa kallacha iya huuphen wothaasa.<verse eid="PSA 21:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 21:4"/>I nena de7o oychis;</para>
  <para style="q2" vid="PSA 21:4">daro laythinne adussa de7o immadasa.<verse eid="PSA 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 21:5"/>Neeni iyaw xoono immida gisho,</para>
  <para style="q2" vid="PSA 21:5">iya bonchoy daris;</para>
  <para style="q2" vid="PSA 21:5">gitatethinne teema iyaw immadasa.<verse eid="PSA 21:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 21:6"/>Merinaa anjuwa iyaw immadasa;</para>
  <para style="q2" vid="PSA 21:6">ne bentuwan iya ufaysaasa.<verse eid="PSA 21:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 21:7"/>Kawoy Godan ammanetees;</para>
  <para style="q2" vid="PSA 21:7">Ubbaafe dhoqa Xoossaa maarotay,</para>
  <para style="q2" vid="PSA 21:7">iyara de7iya gisho I dagammenna.<verse eid="PSA 21:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 21:8"/>Ne kushey ne morketa,</para>
  <para style="q2" vid="PSA 21:8">ne ushacha kushey nena ixeyisata demmana.<verse eid="PSA 21:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 21:9"/>Ne qonciya wode cooce tamada enta xuuggana;</para>
  <para style="q2" vid="PSA 21:9">Goday ba hanqo suulon enta mittana;</para>
  <para style="q2" vid="PSA 21:9">iya tamay enta maana.<verse eid="PSA 21:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 21:10"/>Neeni enta nayta biittafe,</para>
  <para style="q2" vid="PSA 21:10">enta kochaa asaa giddofe dhaysana.<verse eid="PSA 21:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 21:11"/>Ne morketi ne bolla tobboosona;</para>
  <para style="q2" vid="PSA 21:11">iitabaa maqetoosona, shin polokona.<verse eid="PSA 21:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 21:12"/>Neeni enta ne dongiyan dukana;</para>
  <para style="q2" vid="PSA 21:12">enta guye zaarada gooddana.<verse eid="PSA 21:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 21:13"/>Godaw, ne minotethan dhoqu dhoqu ga;</para>
  <para style="q2" vid="PSA 21:13">ne wolqaa gisho galata mazmure yexoos.<verse eid="PSA 21:13"/></para>
  <chapter eid="PSA 21"/>
  <chapter number="22" style="c" sid="PSA 22"/>
  <para style="s1">Xillo Asa Metonne Ufaysi</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure</para>
  <para style="d">“Guura gen7e” geetetiya diitha cuudhethan yexetida mazmure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 22:1"/>Ta Xoossaw, ta Xoossaw, tana ayis aggadii?</para>
  <para style="q2" vid="PSA 22:1">Tana maadda gada ta nena woossiya wode,</para>
  <para style="q2" vid="PSA 22:1">ayis taape haakay?<verse eid="PSA 22:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 22:2"/>Ta Xoossaw, gallas kumethi ta neeko waassas;</para>
  <para style="q2" vid="PSA 22:2">shin ne tana allaka.</para>
  <para style="q2" vid="PSA 22:2">Qamma ubban neeko waassayis,</para>
  <para style="q2" vid="PSA 22:2">shin wopatethi demmike.<verse eid="PSA 22:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 22:3"/>Gidoshin neeni geeshshi;</para>
  <para style="q2" vid="PSA 22:3">Isra7eele galatay ne araata yuushon de7ees.<verse eid="PSA 22:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 22:4"/>Nu aawati nenan ammanetidosona;</para>
  <para style="q2" vid="PSA 22:4">nenan ammanetin, ne enta ashshadasa.<verse eid="PSA 22:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 22:5"/>Neeko waassidi attidosona;</para>
  <para style="q2" vid="PSA 22:5">nenan ammanetidi yeellatibookona.<verse eid="PSA 22:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 22:6"/>Shin ta ase gidike; guxune;</para>
  <para style="q2" vid="PSA 22:6">ta asan kadhetidaysanne boretidaysa.<verse eid="PSA 22:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 22:7"/>Tana be7iya ubbay qelqisoosona;</para>
  <para style="q2" vid="PSA 22:7">banta huuphiya qaathishe dereeqosona.<verse eid="PSA 22:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 22:8"/>“I Godan ammanetis; ane iya asho;</para>
  <para style="q2" vid="PSA 22:8">Goday iya dosiko, ane iya asho” yaagosona.<verse eid="PSA 22:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 22:9"/>Gidoshin taani ta aaye ulope</para>
  <para style="q2" vid="PSA 22:9">suure yeletanaada oothiday nena.</para>
  <para style="q1" vid="PSA 22:9">Ta aaye dhantha dhammiya wodeka</para>
  <para style="q2" vid="PSA 22:9">tana naagiday nena.<verse eid="PSA 22:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 22:10"/>Ta yeletoosope doomada nenan diccas;</para>
  <para style="q2" vid="PSA 22:10">ta aaye ulope doomin ne ta Xoossaa.<verse eid="PSA 22:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 22:11"/>Metoy taako matiya gishonne</para>
  <para style="q2" vid="PSA 22:11">tana maaddiya asi bayna gisho,</para>
  <para style="q2" vid="PSA 22:11">ha77i neeni taape haakofa.<verse eid="PSA 22:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 22:12"/>Daro morketi qayciya boorada tana teqidosona;</para>
  <para style="q2" vid="PSA 22:12">qayciya Baasane kormatada tana oykidosona.<verse eid="PSA 22:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 22:13"/>Mentherethidi gudiya gaammoda</para>
  <para style="q2" vid="PSA 22:13">banta doona ta bolla dooyosona.<verse eid="PSA 22:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 22:14"/>Taani haathada goggas;</para>
  <para style="q2" vid="PSA 22:14">ta meqethay ba kesuwape keyis;</para>
  <para style="q2" vid="PSA 22:14">ta wozanay oysada ta gaathan til7is.<verse eid="PSA 22:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 22:15"/>Ta qoodhey kun7ada melis;</para>
  <para style="q2" vid="PSA 22:15">ta inxarsay kottonuwara oyketis;</para>
  <para style="q2" vid="PSA 22:15">ne tana hayqida asada baanan yeggadasa.<verse eid="PSA 22:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 22:16"/>Kanati tana teqidosona;</para>
  <para style="q2" vid="PSA 22:16">iita asati ta yuushuwa oykidosona;</para>
  <para style="q2" vid="PSA 22:16">ta kushetanne ta tohota caddoosona.<verse eid="PSA 22:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 22:17"/>Ta meqethati taybetoosona;</para>
  <para style="q2" vid="PSA 22:17">ta morketi tana dereeqosona.<verse eid="PSA 22:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 22:18"/>Ta ma7uwa shaakidi ekoosona;</para>
  <para style="q2" vid="PSA 22:18">ta adussa ma7uwa bolla saama yeggoosona.<verse eid="PSA 22:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 22:19"/>Ta Godaw, ne ta matay taape haakofa;</para>
  <para style="q2" vid="PSA 22:19">Ta wolqaw, tana maaddanaw ellesada haaya.<verse eid="PSA 22:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 22:20"/>Tana mashshafe kessa eka;</para>
  <para style="q2" vid="PSA 22:20">ta al7o de7uwa kanatape ashsha.<verse eid="PSA 22:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 22:21"/>Gaammota doonape tana ashsha;</para>
  <para style="q2" vid="PSA 22:21">qayciya bazzo boorata kacepe tana naaga.<verse eid="PSA 22:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 22:22"/>Taani ne sunthaa ta ishatas odana;</para>
  <para style="q2" vid="PSA 22:22">enta shiiquwan nena galatana.<verse eid="PSA 22:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 22:23"/>Hinteno, Godaa yayyesato, iya galatite;</para>
  <para style="q2" vid="PSA 22:23">hinteno, Yayqooba zareto, iya bonchite.</para>
  <para style="q1" vid="PSA 22:23">Hinteno, Isra7eele kochato,</para>
  <para style="q2" vid="PSA 22:23">yashshan iya dhoqu dhoqu oothite.<verse eid="PSA 22:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 22:24"/>I un7etidaysa kadhenna;</para>
  <para style="q2" vid="PSA 22:24">enta qohuwa be7ishe qelli geenna.</para>
  <para style="q1" vid="PSA 22:24">Ba som7uwa entafe genthenna;</para>
  <para style="q2" vid="PSA 22:24">enti iyako waassiya wode,</para>
  <para style="q2" vid="PSA 22:24">entaw zoko zaaribeenna.<verse eid="PSA 22:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 22:25"/>Ta ne lo77o oosuwa gisho gita shiiqon galatana;</para>
  <para style="q2" vid="PSA 22:25">ta qangetha new yayiya asaa sinthan gathana.<verse eid="PSA 22:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 22:26"/>Manqoti midi kallana;</para>
  <para style="q2" vid="PSA 22:26">Godaa koyeysati iya galatana;</para>
  <para style="q2" vid="PSA 22:26">enti merinaw ufaysan daana.<verse eid="PSA 22:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 22:27"/>Sa7a gaxa gakanaw de7iya asa ubbay,</para>
  <para style="q2" vid="PSA 22:27">akeekan Godaako simmana;</para>
  <para style="q2" vid="PSA 22:27">asa zare ubbay iya goyinnana.<verse eid="PSA 22:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 22:28"/>Maati ubbay Godaasa;</para>
  <para style="q2" vid="PSA 22:28">I kawotethata haarees.<verse eid="PSA 22:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 22:29"/>Sa7an de7iya dure ubbay iya goyinnana;</para>
  <para style="q2" vid="PSA 22:29">bantanan hayqope ashshanaw danda7onaysatinne</para>
  <para style="q2" vid="PSA 22:29">biitta simmiya ubbay iyaw gulbatana.<verse eid="PSA 22:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 22:30"/>Yaana yeletay iyaw kiitetana;</para>
  <para style="q2" vid="PSA 22:30">sintha yeletas Godaaba odana.<verse eid="PSA 22:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 22:31"/>Buroo yeletiboona asaska,</para>
  <para style="q2" vid="PSA 22:31">iya geeshshatetha odana.<verse eid="PSA 22:31"/></para>
  <chapter eid="PSA 22"/>
  <chapter number="23" style="c" sid="PSA 23"/>
  <para style="s1">Xoossay Tana Heemmees</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 23:1"/>Goday ta henthanchuwa;</para>
  <para style="q2" vid="PSA 23:1">taw aybika pacenna.<verse eid="PSA 23:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 23:2"/>Tana aaca qooron shempisees;</para>
  <para style="q2" vid="PSA 23:2">wopu gida haathaako laaggees.<verse eid="PSA 23:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 23:3"/>Ta de7uwa ooraxisees;</para>
  <para style="q2" vid="PSA 23:3">ba sunthaa gisho gidi,</para>
  <para style="q2" vid="PSA 23:3">tana xillotetha ogiya kaalethees.<verse eid="PSA 23:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 23:4"/>Ne ta Goday taara de7iya gisho,</para>
  <para style="q2" vid="PSA 23:4">ta sakana dhumaa giddora biikoka,</para>
  <para style="q2" vid="PSA 23:4">iitaba yayyike.</para>
  <para style="q2" vid="PSA 23:4">ne xam7aynne ne guufey tana minthethoosona.<verse eid="PSA 23:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 23:5"/>Ta morketa sinthan taw gibira giigisaasa;</para>
  <para style="q2" vid="PSA 23:5">tana mokashe, ta huuphen zayte tiyaasa;</para>
  <para style="q2" vid="PSA 23:5">ta wancay kumidi goggana gakanaw kunthaasa.<verse eid="PSA 23:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 23:6"/>Ne keehatethaynne ne maarotethay</para>
  <para style="q2" vid="PSA 23:6">ta de7o laytha ubban tana kaallana;</para>
  <para style="q2" vid="PSA 23:6">taani Godaa keethan merinaw daana.<verse eid="PSA 23:6"/></para>
  <chapter eid="PSA 23"/>
  <chapter number="24" style="c" sid="PSA 24"/>
  <para style="s1">Boncho Kawa</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 24:1"/>Sa7aynne sa7an de7iya ubbay Godaaba;</para>
  <para style="q2" vid="PSA 24:1">alameynne iyan de7iya asa ubbay iyassa.<verse eid="PSA 24:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 24:2"/>I sa7aa gita abba bolla hiixis;</para>
  <para style="q2" vid="PSA 24:2">ciimmo haatha bolla minthidi essis.<verse eid="PSA 24:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 24:3"/>Godaa zuma bolla keyanaw danda7ey oonee?</para>
  <para style="q2" vid="PSA 24:3">Iya geeshsha bessan eqanay oonee?<verse eid="PSA 24:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 24:4"/>Iya kusheynne iya wozanay geeshshi gididaysa;</para>
  <para style="q2" vid="PSA 24:4">eeqa goyinnonnaysa,</para>
  <para style="q2" vid="PSA 24:4">wordo caaqonnaysa.<verse eid="PSA 24:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 24:5"/>I Godaape anjo ekana;</para>
  <para style="q2" vid="PSA 24:5">ashshiya Xoossaafe xillo pirdaa demmana.<verse eid="PSA 24:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 24:6"/>Xoossaako xeelliya asinne</para>
  <para style="q2" vid="PSA 24:6">Yayqooba Xoossaa som7uwa</para>
  <para style="q2" vid="PSA 24:6">koyiya asi hessa mela ase. <char style="qs">Salaha </char><verse eid="PSA 24:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 24:7"/>Boncho kawoy gelana mela,</para>
  <para style="q2" vid="PSA 24:7">hinteno pengeto dooyetite;</para>
  <para style="q2" vid="PSA 24:7">beni pengeti iya ufaysan mokite.<verse eid="PSA 24:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 24:8"/>He boncho kawoy oonee?</para>
  <para style="q2" vid="PSA 24:8">Minonne wolqaama gidida Godaa;</para>
  <para style="q2" vid="PSA 24:8">olan wolqaama gidida Godaa.<verse eid="PSA 24:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 24:9"/>Boncho kawoy gelana mela,</para>
  <para style="q2" vid="PSA 24:9">hinteno pengeto dooyetite;</para>
  <para style="q2" vid="PSA 24:9">beni pengeti iya ufaysan mokite.<verse eid="PSA 24:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 24:10"/>Ha boncho kawoy oonee?</para>
  <para style="q2" vid="PSA 24:10">Ha boncho kawoy salo medhetethata Godaa! <char style="qs">Salaha. </char><verse eid="PSA 24:10"/></para>
  <chapter eid="PSA 24"/>
  <chapter number="25" style="c" sid="PSA 25"/>
  <para style="s1">Un7a Wode Woosa</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 25:1"/>Abeeti Godaw,</para>
  <para style="q2" vid="PSA 25:1">shempofe ta nena woossayis.<verse eid="PSA 25:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 25:2"/>Abeeti ta Xoossaw, ta nenan ammanetayis;</para>
  <para style="q2" vid="PSA 25:2">tana yeellayopa;</para>
  <para style="q2" vid="PSA 25:2">ta morketas tana aathada immofa.<verse eid="PSA 25:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 25:3"/>Nenan ufaysi ootheysati yeellatokona;</para>
  <para style="q2" vid="PSA 25:3">shin gaasoy bayna geneysati yeellatana.<verse eid="PSA 25:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 25:4"/>Abeeti Godaw, tana ne ogiya bessa;</para>
  <para style="q2" vid="PSA 25:4">ne geedo tana kaaletha.<verse eid="PSA 25:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 25:5"/>Tana ashshiya Xoossay nena gidiya gisho,</para>
  <para style="q2" vid="PSA 25:5">ne tumatethaa tana kaalethanne tamaarsa;</para>
  <para style="q2" vid="PSA 25:5">gallas kumetha ta nenan ufaysi oothayis.<verse eid="PSA 25:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 25:6"/>Abeeti Godaw, benipe de7iya</para>
  <para style="q2" vid="PSA 25:6">ne qadhiyanne ne keehatetha hassaya.<verse eid="PSA 25:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 25:7"/>Ta na7atetha nagaraanne iitaba hassayopa;</para>
  <para style="q2" vid="PSA 25:7">abeeti Godaw, ne keehatethaanne lo77otetha hassaya.<verse eid="PSA 25:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 25:8"/>Goday keehanne suure gidiya gisho;</para>
  <para style="q2" vid="PSA 25:8">nagaranchota ba ogiya tamaarsees.<verse eid="PSA 25:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 25:9"/>Ashketa suuretethan kaalethees;</para>
  <para style="q2" vid="PSA 25:9">entana ba ogiya tamaarsees.<verse eid="PSA 25:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 25:10"/>Godaa caaquwanne</para>
  <para style="q2" vid="PSA 25:10">iya kiitaa naageysatas</para>
  <para style="q2" vid="PSA 25:10">iya oge ubbay tumanne keeha.<verse eid="PSA 25:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 25:11"/>Abeeti Godaw, ta nagaray daro;</para>
  <para style="q2" vid="PSA 25:11">gidoshin ne sunthaa gisho taw atto ga.<verse eid="PSA 25:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 25:12"/>Godaa yayiya asi oonee?</para>
  <para style="q2" vid="PSA 25:12">I kaallanaw bessiya ogiya</para>
  <para style="q2" vid="PSA 25:12">Goday iya tamaarsana.<verse eid="PSA 25:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 25:13"/>I ubba wode duretethan daana;</para>
  <para style="q2" vid="PSA 25:13">iya nayti biitta laattana.<verse eid="PSA 25:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 25:14"/>Goday yayyeysatas ba xuuraa genthenna;</para>
  <para style="q2" vid="PSA 25:14">I entaw ba caaquwa erisees.<verse eid="PSA 25:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 25:15"/>Goday ta tohuwa xihepe naagiya gisho,</para>
  <para style="q2" vid="PSA 25:15">ta ayfey maado ekanaw ubba wode iyako xeellees.<verse eid="PSA 25:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 25:16"/>Godaw, taani bizzanne</para>
  <para style="q2" vid="PSA 25:16">metootida asi gidiya gisho,</para>
  <para style="q2" vid="PSA 25:16">taako simma; ne maarotethaa tana bessa.<verse eid="PSA 25:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 25:17"/>Taw hirgi daris;</para>
  <para style="q2" vid="PSA 25:17">ta metuwape tana ne ashsha.<verse eid="PSA 25:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 25:18"/>Ta metuwanne ta waayiya be7a;</para>
  <para style="q2" vid="PSA 25:18">ta nagara ubbaa atto ga.<verse eid="PSA 25:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 25:19"/>Ta morketi ay mela daridaako be7a;</para>
  <para style="q2" vid="PSA 25:19">enti tana ay mela ixiyako xeella.<verse eid="PSA 25:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 25:20"/>Ne tana naaga; ne tana ashsha;</para>
  <para style="q2" vid="PSA 25:20">ta neeko baqatiya gisho tana yeellayopa.<verse eid="PSA 25:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 25:21"/>Ta nenan ufaysi oothida gisho,</para>
  <para style="q2" vid="PSA 25:21">suuretethinne tumatethi tana naago.<verse eid="PSA 25:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 25:22"/>Abeeti Xoossaw, Isra7eele asaa</para>
  <para style="q2" vid="PSA 25:22">enta meto ubbaafe ne woza.<verse eid="PSA 25:22"/></para>
  <chapter eid="PSA 25"/>
  <chapter number="26" style="c" sid="PSA 26"/>
  <para style="s1">Xillo Asa Woosa</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 26:1"/>Abeeti Godaw, ta suuretethan hemetida gishonne</para>
  <para style="q2" vid="PSA 26:1">sidhey bayna nenan ammanetida gisho,</para>
  <para style="q2" vid="PSA 26:1">taw pirda.<verse eid="PSA 26:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 26:2"/>Abeeti Godaw, tana paaca;</para>
  <para style="q2" vid="PSA 26:2">tana pilgada be7a;</para>
  <para style="q2" vid="PSA 26:2">ta wozanaa xomoosa.<verse eid="PSA 26:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 26:3"/>Ne siiqoy ta sinthan de7iya gisho,</para>
  <para style="q2" vid="PSA 26:3">ta ubba wode ne tuma ogiyan hemetayis.<verse eid="PSA 26:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 26:4"/>Cimmiya asaara ta uttike;</para>
  <para style="q2" vid="PSA 26:4">cubbota maabaran gelike.<verse eid="PSA 26:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 26:5"/>Iitata duulata ta ixayis;</para>
  <para style="q2" vid="PSA 26:5">makallachotara issife uttike.<verse eid="PSA 26:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 26:6"/>Abeeti Godaw, ta xillotethaa bessanaw</para>
  <para style="q2" vid="PSA 26:6">ta kushiya meeccayis;</para>
  <para style="q2" vid="PSA 26:6">ne yarsho bessa yuuyayis.<verse eid="PSA 26:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 26:7"/>Galata mazmure yexashe</para>
  <para style="q2" vid="PSA 26:7">ne malaalsiya ooso ubba odana.<verse eid="PSA 26:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 26:8"/>Abeeti Godaw, ne keethaanne,</para>
  <para style="q2" vid="PSA 26:8">ne bonchoy aqiya bessaa ta dosayis.<verse eid="PSA 26:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 26:9"/>Tana nagaranchotara issife pittofa;</para>
  <para style="q2" vid="PSA 26:9">asa suuthu gusseysatara ta shempuwa dhaysofa.<verse eid="PSA 26:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 26:10"/>Enta kushen iita halchoy de7ees;</para>
  <para style="q2" vid="PSA 26:10">enta ushacha kushen wodhaafey kumis.<verse eid="PSA 26:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 26:11"/>Shin ta suuretethan hemetana;</para>
  <para style="q2" vid="PSA 26:11">tana woza; taw qadheta.<verse eid="PSA 26:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 26:12"/>Ta tohoy demba bessan eqis;</para>
  <para style="q2" vid="PSA 26:12">gita shiiquwan Godaa galatana.<verse eid="PSA 26:12"/></para>
  <chapter eid="PSA 26"/>
  <chapter number="27" style="c" sid="PSA 27"/>
  <para style="s1">Xoossara De7iya Asa Xaalatethi</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 27:1"/>Goday taw poo7onne tana ashsheysa;</para>
  <para style="q2" vid="PSA 27:1">yaatin, ta oona yayiyanee?</para>
  <para style="q1" vid="PSA 27:1">Goday, ta de7oy naagetiya miixaa;</para>
  <para style="q2" vid="PSA 27:1">yaatin, ta ayis dagammanee?<verse eid="PSA 27:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 27:2"/>Iita asati, tana ixeysatinne ta morketi</para>
  <para style="q2" vid="PSA 27:2">tana wodhanaw hordofiya wode,</para>
  <para style="q2" vid="PSA 27:2">bantaw dhubetidi kundana.<verse eid="PSA 27:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 27:3"/>Morke toori tana teqiko</para>
  <para style="q2" vid="PSA 27:3">ta wozanay yayyenna.</para>
  <para style="q1" vid="PSA 27:3">Oli ta bolla dendiyakoka,</para>
  <para style="q2" vid="PSA 27:3">taani Godan ammanetayis.<verse eid="PSA 27:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 27:4"/>Ta Godaa issiba oychas;</para>
  <para style="q2" vid="PSA 27:4">hessika, ta de7o laytha ubban</para>
  <para style="q1" vid="PSA 27:4">Godaa keethan de7anaasa;</para>
  <para style="q2" vid="PSA 27:4">Godaa lo77otetha be7anaasanne</para>
  <para style="q2" vid="PSA 27:4">iya keethan iya koyanaasa.<verse eid="PSA 27:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 27:5"/>Meto gallas tana ba de7iya bessan genthana;</para>
  <para style="q2" vid="PSA 27:5">ba dunkaaniyan tana qosana;</para>
  <para style="q2" vid="PSA 27:5">tana dhoqa zaalla bolla essana.<verse eid="PSA 27:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 27:6"/>He wode taani tana teqida</para>
  <para style="q2" vid="PSA 27:6">ta morketape aadhada,</para>
  <para style="q2" vid="PSA 27:6">dhoqu dhoqu gaana.</para>
  <para style="q1" vid="PSA 27:6">Taani iya dunkaaniyan</para>
  <para style="q2" vid="PSA 27:6">ufaytashe yarsho yarshana;</para>
  <para style="q2" vid="PSA 27:6">Godaa mazmuren galatana.<verse eid="PSA 27:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 27:7"/>Abeeti Godaw,</para>
  <para style="q2" vid="PSA 27:7">ta nena xeegiya wode ne taw koya;</para>
  <para style="q2" vid="PSA 27:7">taw qadheta; tana si7a.<verse eid="PSA 27:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 27:8"/>Neeni, “Ta som7uwa koyite” gadasa,</para>
  <para style="q2" vid="PSA 27:8">ta wozanay Abeeti Godaw,</para>
  <para style="q2" vid="PSA 27:8">“Ta ne som7uwa koyana” yaagis.<verse eid="PSA 27:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 27:9"/>Ne som7uwa taape genthofa;</para>
  <para style="q2" vid="PSA 27:9">tana maaddeyso; ne shenetada</para>
  <para style="q2" vid="PSA 27:9">tana ne aylliya guye zaaropa.</para>
  <para style="q1" vid="PSA 27:9">Abeeti tana ashshiya Xoossaw,</para>
  <para style="q2" vid="PSA 27:9">tana yeggofa; aggofa.<verse eid="PSA 27:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 27:10"/>Ta aawaynne ta aayiya tana aggikoka</para>
  <para style="q2" vid="PSA 27:10">Goday tana shiishidi ekana.<verse eid="PSA 27:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 27:11"/>Abeeti Godaw, tana ne ogiya tamaarsa;</para>
  <para style="q2" vid="PSA 27:11">ta morketa gisho tana suure oge kaaletha.<verse eid="PSA 27:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 27:12"/>Tana mandiya wordo markati</para>
  <para style="q2" vid="PSA 27:12">ta bolla wolqan dendida gisho,</para>
  <para style="q2" vid="PSA 27:12">tana ta morketa amuwas aathada immofa.<verse eid="PSA 27:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 27:13"/>Taani de7on de7ashe,</para>
  <para style="q2" vid="PSA 27:13">Godaa keehatetha be7anaysa ammanayis.<verse eid="PSA 27:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 27:14"/>Godan ufaysi ootha;</para>
  <para style="q2" vid="PSA 27:14">minna, yayyofa;</para>
  <para style="q2" vid="PSA 27:14">Godan ufaysi ootha.<verse eid="PSA 27:14"/></para>
  <chapter eid="PSA 27"/>
  <chapter number="28" style="c" sid="PSA 28"/>
  <para style="s1">Xoossay Taw Gondallenne Wolqa</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 28:1"/>Abeeti Godaw, ta zaallaw,</para>
  <para style="q2" vid="PSA 28:1">ta nena xeegayis;</para>
  <para style="q2" vid="PSA 28:1">ne taw si77i goopa.</para>
  <para style="q1" vid="PSA 28:1">Ne si77i giiko,</para>
  <para style="q2" vid="PSA 28:1">ta duufo gelida asi gidayis.<verse eid="PSA 28:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 28:2"/>Maade koyada ta waassiya wode;</para>
  <para style="q2" vid="PSA 28:2">ubbaafe geeshsha dunkaaniyako,</para>
  <para style="q2" vid="PSA 28:2">ta kushiya micciya wode ta woosa si7a.<verse eid="PSA 28:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 28:3"/>Iita oothiya iita asatara tana gathada oykofa;</para>
  <para style="q2" vid="PSA 28:3">enti banta wozanan gene qopishe,</para>
  <para style="q2" vid="PSA 28:3">banta doonan sarotethi haasayoosona.<verse eid="PSA 28:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 28:4"/>Enta oosuwada enta seera;</para>
  <para style="q2" vid="PSA 28:4">enta iitatethaada entaw qanxa.</para>
  <para style="q1" vid="PSA 28:4">Enta kushe oosuwada enta pirda;</para>
  <para style="q2" vid="PSA 28:4">entaw bessiya iitaa entaw zaara.<verse eid="PSA 28:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 28:5"/>Enti Godaa oosuwanne iya kushe medhuwas,</para>
  <para style="q2" vid="PSA 28:5">besse immonna gisho Goday enta laallana;</para>
  <para style="q2" vid="PSA 28:5">zaaridi enta keexenna.<verse eid="PSA 28:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 28:6"/>Ta woosa si7ida gisho</para>
  <para style="q2" vid="PSA 28:6">Goday galatetto.<verse eid="PSA 28:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 28:7"/>Goday taw wolqanne gondalle;</para>
  <para style="q2" vid="PSA 28:7">ta wozanay iyan ammanetees;</para>
  <para style="q2" vid="PSA 28:7">ta iyan maadetas.</para>
  <para style="q1" vid="PSA 28:7">Ta wozanay iyan ufaytees;</para>
  <para style="q2" vid="PSA 28:7">ta iya mazmuren sabbana.<verse eid="PSA 28:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 28:8"/>Goday ba asaas wolqa;</para>
  <para style="q2" vid="PSA 28:8">ba dooridi kawa ashshiya miixa.<verse eid="PSA 28:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 28:9"/>Godaw, ne asaa ashsha;</para>
  <para style="q2" vid="PSA 28:9">nebaa gididaysata anja.</para>
  <para style="q1" vid="PSA 28:9">Enta heemmey nena gida;</para>
  <para style="q2" vid="PSA 28:9">enta merinaw tooka.<verse eid="PSA 28:9"/></para>
  <chapter eid="PSA 28"/>
  <chapter number="29" style="c" sid="PSA 29"/>
  <para style="s1">Xoossa Gitatetha Sabo</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 29:1"/>Hinteno salo medhetethato,</para>
  <para style="q2" vid="PSA 29:1">bonchoynne wolqay Godaasa giite.<verse eid="PSA 29:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 29:2"/>Godaa boncho sunthaa galatite;</para>
  <para style="q2" vid="PSA 29:2">iya geeshshatetha teema gisho Godaa goyinnite.<verse eid="PSA 29:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 29:3"/>Godaa guunthay haathata bolla si7etees;</para>
  <para style="q2" vid="PSA 29:3">boncho Xoossay dadada dechees;</para>
  <para style="q2" vid="PSA 29:3">Goday gita haathata bolla guummees.<verse eid="PSA 29:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 29:4"/>Godaa kooshinchay wolqaama;</para>
  <para style="q2" vid="PSA 29:4">Godaa girsay teemara de7ees.<verse eid="PSA 29:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 29:5"/>Godaa girsay zigaa menthees;</para>
  <para style="q2" vid="PSA 29:5">Libaanosen de7iya zigaa menthees.<verse eid="PSA 29:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 29:6"/>Libaanose dereta galo marada buraaqisees;</para>
  <para style="q2" vid="PSA 29:6">Siriyoona deriya<note caller="+" style="f"><char style="fr" closed="false">29:6 </char><char style="fqa" closed="false">Siriyoona deriya: </char><char style="ft" closed="false">Hermoona deriyas hara sunthi </char></note> menthada gufisees.<verse eid="PSA 29:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 29:7"/>Godaa girsay wol7amees.<verse eid="PSA 29:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 29:8"/>Godaa girsay mela biittaa qaathees;</para>
  <para style="q2" vid="PSA 29:8">Goday Qaadesa mela biittaa kokorsees.<verse eid="PSA 29:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 29:9"/>Godaa girsay wolaa qaathees;</para>
  <para style="q2" vid="PSA 29:9">mitha haythaa qoqofees.</para>
  <para style="q1" vid="PSA 29:9">Iya keethan de7iya ubbay,</para>
  <para style="q2" vid="PSA 29:9">“Bonchoy Godaas gido” yaagees.<verse eid="PSA 29:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 29:10"/>Goday di7o haatha bolla</para>
  <para style="q2" vid="PSA 29:10">ba araata wothidi uttis;</para>
  <para style="q2" vid="PSA 29:10">Goday ba araatan uttidi merinaw kawotis.<verse eid="PSA 29:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 29:11"/>Goday ba asaas wolqa immees.</para>
  <para style="q2" vid="PSA 29:11">Goday ba asaa sarotethan anjees.<verse eid="PSA 29:11"/></para>
  <chapter eid="PSA 29"/>
  <chapter number="30" style="c" sid="PSA 30"/>
  <para style="s1">Qohope Attida Asa Galata</para>
  <para style="d">Keethe Anjisos Dawiti Yexida Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 30:1"/>Abeeti Godaw, ne tana ollafe kessida gishonne</para>
  <para style="q2" vid="PSA 30:1">ta morketi ufaytonna mela oothida gisho,</para>
  <para style="q2" vid="PSA 30:1">ta nena dhoqu dhoqu oothana.<verse eid="PSA 30:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 30:2"/>Abeeti Godaw, ta Xoossaw tana maaddana mela,</para>
  <para style="q2" vid="PSA 30:2">ta nena xeegin ne tana pathadasa.<verse eid="PSA 30:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 30:3"/>Abeeti Godaw, duufo gelonnaada tana naagadasa;</para>
  <para style="q2" vid="PSA 30:3">ollan wodhonnaada tana paxa ashshadasa.<verse eid="PSA 30:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 30:4"/>Hinteno Xoossaa asaw,</para>
  <para style="q2" vid="PSA 30:4">Godaas yexite;</para>
  <para style="q2" vid="PSA 30:4">iya geeshsha sunthaa sabbite.<verse eid="PSA 30:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 30:5"/>Iya hanqoy guutha wodesa,</para>
  <para style="q2" vid="PSA 30:5">shin iya keehatethay de7o laytha ubbaasa.</para>
  <para style="q1" vid="PSA 30:5">Qamma yeekishe aqiko,</para>
  <para style="q2" vid="PSA 30:5">wonta zawi bayna ufaysi gidees.<verse eid="PSA 30:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 30:6"/>Ta naagetada de7eysa erida wode</para>
  <para style="q2" vid="PSA 30:6">“Hiza ta qaaxike” yaagas.<verse eid="PSA 30:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 30:7"/>Abeeti Godaw, ne taw keehida wode,</para>
  <para style="q2" vid="PSA 30:7">zumada tana minthada essadasa.</para>
  <para style="q1" vid="PSA 30:7">Shin ne som7uwa hara soo zaarida wode,</para>
  <para style="q2" vid="PSA 30:7">ta dagammas.<verse eid="PSA 30:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 30:8"/>Abeeti Godaw, ta nena xeegas;</para>
  <para style="q2" vid="PSA 30:8">nena maarota woossas;<verse eid="PSA 30:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 30:9"/>“Ta duufo geliko nena ay go77ii?</para>
  <para style="q2" vid="PSA 30:9">Biitta giddo gelida asi</para>
  <para style="q2" vid="PSA 30:9">waatidi nena galatanaw danda7ii?</para>
  <para style="q2" vid="PSA 30:9">Ne ammanetetha waatidi markatanee?<verse eid="PSA 30:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 30:10"/>Abeeti Godaw, ne tana si7a;</para>
  <para style="q2" vid="PSA 30:10">taw qadheta.</para>
  <para style="q2" vid="PSA 30:10">Abeeti Godaw, ne taw maado gida” yaagas.<verse eid="PSA 30:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 30:11"/>Ta yeehuwa yethan laammadasa;</para>
  <para style="q2" vid="PSA 30:11">kayo ma7uwa taape qaarada,</para>
  <para style="q2" vid="PSA 30:11">tana ufaysi mayzadasa.<verse eid="PSA 30:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 30:12"/>Hessa gisho, ta nena sabbana; si77i giike.</para>
  <para style="q2" vid="PSA 30:12">Abeeti Godaw, ta Xoossaw, ta nena merinaw galatana.<verse eid="PSA 30:12"/></para>
  <chapter eid="PSA 30"/>
  <chapter number="31" style="c" sid="PSA 31"/>
  <para style="s1">Ta Shempiw Ne Kushen Wothas</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 31:1"/>Abeeti Godaw, ta neeko baqatayis;</para>
  <para style="q2" vid="PSA 31:1">awudeka tana yeellayopa;</para>
  <para style="q2" vid="PSA 31:1">ne xillotethan tana ashsha.<verse eid="PSA 31:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 31:2"/>Ne haythaa taako zaara;</para>
  <para style="q2" vid="PSA 31:2">ellesada tana ashsha.</para>
  <para style="q1" vid="PSA 31:2">Neeni, taw geemmiya zaalla;</para>
  <para style="q2" vid="PSA 31:2">tana ashshiya mino miixa gida.<verse eid="PSA 31:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 31:3"/>Ee, ne taw zaallanne miixa;</para>
  <para style="q2" vid="PSA 31:3">ne sunthaa gisho tana kaaletha;</para>
  <para style="q2" vid="PSA 31:3">ogiya bessa.<verse eid="PSA 31:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 31:4"/>Ne taw geemmiya besse gidiya gisho,</para>
  <para style="q2" vid="PSA 31:4">enti qotidi wothida xihepe tana naaga.<verse eid="PSA 31:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 31:5"/>Abeeti Godaw, tuma Xoossaw,</para>
  <para style="q2" vid="PSA 31:5">ta shempuwa ne kushen wothayis;</para>
  <para style="q2" vid="PSA 31:5">ne tana woza.<verse eid="PSA 31:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 31:6"/>Pathonna eeqata goyinneyisata ta ixayis;</para>
  <para style="q2" vid="PSA 31:6">gidoshin taani Godan ammanetayis.<verse eid="PSA 31:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 31:7"/>Ta metuwanne ta un7a ne be7ida gisho</para>
  <para style="q2" vid="PSA 31:7">taani merinaw ne siiquwan ufaytana.<verse eid="PSA 31:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 31:8"/>Ne tana morke kushen aathada immabaaka;</para>
  <para style="q2" vid="PSA 31:8">ta tohota dalga bessan essadasa.<verse eid="PSA 31:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 31:9"/>Abeeti Godaw, taani meton gelida gisho taw qadheta;</para>
  <para style="q2" vid="PSA 31:9">Ta daro azzanida gisho ta ayfey mulcatis;</para>
  <para style="q2" vid="PSA 31:9">ta ashoynne ta shempoy daaburis.<verse eid="PSA 31:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 31:10"/>Ta de7oy azzanon, ta laythay oolen wuris;</para>
  <para style="q2" vid="PSA 31:10">waaye darotethan ta wolqay wuris;</para>
  <para style="q2" vid="PSA 31:10">ta meqethati argaacidosona.<verse eid="PSA 31:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 31:11"/>Ta morketa ubbaas qidhes attas;</para>
  <para style="q2" vid="PSA 31:11">ta shoorotas yeella gidas.</para>
  <para style="q1" vid="PSA 31:11">Ta laggetas daganthiyaba gidas;</para>
  <para style="q2" vid="PSA 31:11">tana be7eysati taape haakidosona.<verse eid="PSA 31:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 31:12"/>Ta hayqida asada dogetas;</para>
  <para style="q2" vid="PSA 31:12">meqa miisheda wora yegetas.<verse eid="PSA 31:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 31:13"/>Taani darota kalkashaa si7as;</para>
  <para style="q2" vid="PSA 31:13">ubba bessara dagami de7ees.</para>
  <para style="q1" vid="PSA 31:13">Enti ta bolla tobboosona;</para>
  <para style="q2" vid="PSA 31:13">tana wodhanaw maqetoosona.<verse eid="PSA 31:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 31:14"/>Shin Godaw, ta nenan ammanetana;</para>
  <para style="q2" vid="PSA 31:14">neeni ta Xoossaa.<verse eid="PSA 31:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 31:15"/>Ta de7o laythay ne kushiyana;</para>
  <para style="q2" vid="PSA 31:15">tana yedethiya ta morketa kushepe tana ashsha.<verse eid="PSA 31:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 31:16"/>Ne aylliya bolla ne som7uwa poo7isa;</para>
  <para style="q2" vid="PSA 31:16">ne maarotethan tana ashsha.<verse eid="PSA 31:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 31:17"/>Abeeti Godaw, ta nena xeegiya gisho,</para>
  <para style="q2" vid="PSA 31:17">tana yeellayopa.</para>
  <para style="q1" vid="PSA 31:17">Shin iitati yeellato;</para>
  <para style="q2" vid="PSA 31:17">duufon gelidi si77i go.<verse eid="PSA 31:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 31:18"/>Otoroninne boren xillota bolla</para>
  <para style="q2" vid="PSA 31:18">minnidi haasaya gisho,</para>
  <para style="q2" vid="PSA 31:18">enta wordo inxarsaa si77i ootha.<verse eid="PSA 31:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 31:19"/>Nena yayyeysatas ne minjida,</para>
  <para style="q2" vid="PSA 31:19">neeko baqateysatas ne giigisida,</para>
  <para style="q2" vid="PSA 31:19">keehatethay ay mela daro!<verse eid="PSA 31:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 31:20"/>Neeni enta ne sinthan, geema bessan gentha wothadasa;</para>
  <para style="q2" vid="PSA 31:20">asaa iita maquwafe ashshaasa;</para>
  <para style="q2" vid="PSA 31:20">iita inxarsafe ne dunkaaniyan qosadasa.<verse eid="PSA 31:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 31:21"/>Morkey teqida katamaa giddon,</para>
  <para style="q2" vid="PSA 31:21">malaalsiya ba maarotethaa tana bessida,</para>
  <para style="q2" vid="PSA 31:21">Goday galatetto.<verse eid="PSA 31:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 31:22"/>Ta dagammada, “Ne sinthafe haakas” gas;</para>
  <para style="q2" vid="PSA 31:22">shin ta maado koyada neeko waassida wode,</para>
  <para style="q2" vid="PSA 31:22">ta waasuwa ne si7adasa.<verse eid="PSA 31:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 31:23"/>Hinteno, Xoossa asaw, Godaa dosite;</para>
  <para style="q2" vid="PSA 31:23">Goday ammaneteyisata naagees;</para>
  <para style="q2" vid="PSA 31:23">shin otoranchotas enta gatiya qanxees.<verse eid="PSA 31:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 31:24"/>Hinteno, Godan ufaysi ootheysato,</para>
  <para style="q2" vid="PSA 31:24">minnite; gencite.<verse eid="PSA 31:24"/></para>
  <chapter eid="PSA 31"/>
  <chapter number="32" style="c" sid="PSA 32"/>
  <para style="s1">Nagari Atto Geetetida Asi Anjetidaysa</para>
  <para style="d">Dawita Timirte</para>
  <para style="d">Akeekan xaafetida ginxo</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 32:1"/>Iya nagaray atto geetetidaynne</para>
  <para style="q2" vid="PSA 32:1">iya nagaray kametida uray anjetidaysa.<verse eid="PSA 32:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 32:2"/>Goday iya iitatethaa taybonna asi,</para>
  <para style="q2" vid="PSA 32:2">iya qofan cimoy bayna asi anjetidaysa.<verse eid="PSA 32:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 32:3"/>Taani ta nagaraa paaxonna aggada,</para>
  <para style="q2" vid="PSA 32:3">kumetha gallas oolidaysi,</para>
  <para style="q2" vid="PSA 32:3">ta asatethaa daabursis.<verse eid="PSA 32:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 32:4"/>Gallasinne qamma ne kushey tana deexis;</para>
  <para style="q2" vid="PSA 32:4">haathi dhayin bone awan melidibada,</para>
  <para style="q2" vid="PSA 32:4">ta wolqay wuris. <char style="qs">Salaha </char><verse eid="PSA 32:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 32:5"/>Taani ta nagaraa new paaxas;</para>
  <para style="q2" vid="PSA 32:5">ta naaquwa neepe genthabike.</para>
  <para style="q1" vid="PSA 32:5">“Ta nagaraa Godaas paaxana” yaagas;</para>
  <para style="q2" vid="PSA 32:5">tana deexida nagaraa atto gadasa. <char style="qs">Salaha </char><verse eid="PSA 32:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 32:6"/>Hessa gisho, xillo asi oonika,</para>
  <para style="q2" vid="PSA 32:6">ne bentiya wode nena woosso;</para>
  <para style="q2" vid="PSA 32:6">iita di7oy yaa wode he uraa gakenna.<verse eid="PSA 32:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 32:7"/>Ne taw qosetiya bessi;</para>
  <para style="q2" vid="PSA 32:7">ne tana metope naagasa.</para>
  <para style="q2" vid="PSA 32:7">Atotetha yethi yexiya asaa</para>
  <para style="q2" vid="PSA 32:7">ta yuushuwan wothadasa. <char style="qs">Salaha </char><verse eid="PSA 32:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 32:8"/>Xoossay, “Ta nena tamaarsana;</para>
  <para style="q2" vid="PSA 32:8">ne baana ogiya bessaana;</para>
  <para style="q2" vid="PSA 32:8">ta nena zorananne naagana” yaagees.<verse eid="PSA 32:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 32:9"/>Bixaalaninne puulon oyketonna;</para>
  <para style="q2" vid="PSA 32:9">kiitetonna wozani bayna baquloda</para>
  <para style="q2" vid="PSA 32:9">woyko parada hanopite.<verse eid="PSA 32:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 32:10"/>Iitatas waayey darana;</para>
  <para style="q2" vid="PSA 32:10">shin Godan ammaneteyisata siiqoy kammana.<verse eid="PSA 32:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 32:11"/>Hinteno, xilloto,</para>
  <para style="q2" vid="PSA 32:11">Godan ufaytitenne hashshu giite;</para>
  <para style="q2" vid="PSA 32:11">hinteno, wozana suureto, ililite.<verse eid="PSA 32:11"/></para>
  <chapter eid="PSA 32"/>
  <chapter number="33" style="c" sid="PSA 33"/>
  <para style="s1">Keeha Xoossay Sabeto</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 33:1"/>Hinteno, xilloto Godaas ufaysan ililite;</para>
  <para style="q2" vid="PSA 33:1">suure asati iya galatanaw bessees.<verse eid="PSA 33:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 33:2"/>Maasinqon Godaa galatite;</para>
  <para style="q2" vid="PSA 33:2">tammu shayan waaxetida diithan yexite.<verse eid="PSA 33:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 33:3"/>Ooratha yethi iyaw yexite;</para>
  <para style="q2" vid="PSA 33:3">diithi loythidi diixishe ililite.<verse eid="PSA 33:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 33:4"/>Godaa qaalay tuma;</para>
  <para style="q2" vid="PSA 33:4">iya ooso ubbay ammaneteysa.<verse eid="PSA 33:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 33:5"/>Goday xillotethinne tuma pirda dosees;</para>
  <para style="q2" vid="PSA 33:5">iya maarotay sa7aa kumis.<verse eid="PSA 33:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 33:6"/>Godaa qaalan saloti medhetidosona;</para>
  <para style="q2" vid="PSA 33:6">iya doonape keyiya shempuwan</para>
  <para style="q2" vid="PSA 33:6">salon de7iya medhetethati yeletidosona.<verse eid="PSA 33:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 33:7"/>Abba haatha issi bessan eelisis;</para>
  <para style="q2" vid="PSA 33:7">ciimmo haatha minja keethan wothis.<verse eid="PSA 33:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 33:8"/>Sa7a ubbay Godaa yayyo;</para>
  <para style="q2" vid="PSA 33:8">asa ubbay Godaa boncho.<verse eid="PSA 33:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 33:9"/>Iya odan ubbay hanis;</para>
  <para style="q2" vid="PSA 33:9">I kiittin minnidi eqis.<verse eid="PSA 33:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 33:10"/>Goday kawotethata halchuwa hada oothees;</para>
  <para style="q2" vid="PSA 33:10">enta qofaa laallees.<verse eid="PSA 33:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 33:11"/>Godaa halchoy merinaw eqidi de7ees;</para>
  <para style="q2" vid="PSA 33:11">iya wozanaa qofay yeletetha ubbaasa.<verse eid="PSA 33:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 33:12"/>Xoossay entaw Godaa gidida kawotethay,</para>
  <para style="q2" vid="PSA 33:12">I babaa oothidi doorida asay anjetidaysata.<verse eid="PSA 33:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 33:13"/>Goday salon uttidi xeellees;</para>
  <para style="q2" vid="PSA 33:13">asa koche ubbaa be7ees.<verse eid="PSA 33:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 33:14"/>Goday ba araatan uttidi,</para>
  <para style="q2" vid="PSA 33:14">sa7an de7iya ubbaa be7ees.<verse eid="PSA 33:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 33:15"/>Enta wozanaa medhiday iya;</para>
  <para style="q2" vid="PSA 33:15">enti oothiyaba ubbaa I erees.<verse eid="PSA 33:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 33:16"/>Kawoy ba wotaadare darotethan attenna;</para>
  <para style="q2" vid="PSA 33:16">olanchoy ba wolqaa minotethan kessi ekenna.<verse eid="PSA 33:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 33:17"/>Paran xoonana gidi naagoy hada;</para>
  <para style="q2" vid="PSA 33:17">I ba minotethan ashshanaw danda7enna.<verse eid="PSA 33:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 33:18"/>Godaa ayfeti iyaw yayyanne</para>
  <para style="q2" vid="PSA 33:18">iya maarotan ufaysi oothiya asaa be7oosona.<verse eid="PSA 33:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 33:19"/>Hessika enta hayqope ashshanaasanne</para>
  <para style="q2" vid="PSA 33:19">kosha wode enta naaganaassa.<verse eid="PSA 33:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 33:20"/>Nuuni Godaa ufaysan naagoos;</para>
  <para style="q2" vid="PSA 33:20">nuna maaddeynne nu gondalley iya.<verse eid="PSA 33:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 33:21"/>Iya geeshsha sunthan nuuni ammanetiya gisho,</para>
  <para style="q2" vid="PSA 33:21">nu wozanay iyan ufaytees.<verse eid="PSA 33:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 33:22"/>Godaw, nuuni nenan ufaysi oothidaysada,</para>
  <para style="q2" vid="PSA 33:22">ne maarotay nu bolla gido.<verse eid="PSA 33:22"/></para>
  <chapter eid="PSA 33"/>
  <chapter number="34" style="c" sid="PSA 34"/>
  <para style="s1">Xoossay Keeha Gideysa Be7ite</para>
  <para style="d">Dawiti gooshshu daanidi shiiqida gisho, Abimeleke sinthafe goodetidi keyda wode yexida mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 34:1"/>Taani ubba wode Godaa galatana;</para>
  <para style="q2" vid="PSA 34:1">iya galatay ta doonape pacenna.<verse eid="PSA 34:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 34:2"/>Taani Godan ceeqetayis;</para>
  <para style="q2" vid="PSA 34:2">aadati hessa si7idi ufayto.<verse eid="PSA 34:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 34:3"/>Taara Godaa bonchite;</para>
  <para style="q2" vid="PSA 34:3">iya sunthaa issife dhoqu dhoqu oothoos.<verse eid="PSA 34:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 34:4"/>Taani Godaa koyin, I taw zaaris;</para>
  <para style="q2" vid="PSA 34:4">ta yayyiyaba ubbaafe tana ashshis.<verse eid="PSA 34:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 34:5"/>Iyako xeelliya ubbay poo7osona;</para>
  <para style="q2" vid="PSA 34:5">enta som7oy yeellatenna.<verse eid="PSA 34:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 34:6"/>Ha manqoy waassis;</para>
  <para style="q2" vid="PSA 34:6">Goday iya waasuwa si7is;</para>
  <para style="q2" vid="PSA 34:6">iya meto ubbaafe iya ashshis.<verse eid="PSA 34:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 34:7"/>Godaa kiitanchoy iyaw yayyeyisata naagees;</para>
  <para style="q2" vid="PSA 34:7">enta yuushon gididi enta ashshees.<verse eid="PSA 34:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 34:8"/>Goday keeha gideysa laacidi be7ite;</para>
  <para style="q2" vid="PSA 34:8">iyako baqatiya asi anjetidaysa.<verse eid="PSA 34:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 34:9"/>Hinteno, geeshsha asaw, Godaas yayyite;</para>
  <para style="q2" vid="PSA 34:9">iyaw yayyeysatas aykoyka pacenna.<verse eid="PSA 34:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 34:10"/>Gaammoti miyaba dhayidi koshatoosona;</para>
  <para style="q2" vid="PSA 34:10">shin Godaa koyeysatas lo77obay pacenna.<verse eid="PSA 34:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 34:11"/>Nayto, haa yiite; si7ite;</para>
  <para style="q2" vid="PSA 34:11">ta hintena Godaa yashshi tamaarsana.<verse eid="PSA 34:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 34:12"/>Lo77o de7o daanawunne</para>
  <para style="q2" vid="PSA 34:12">keehaba be7anaw adussa laythi daanaw,</para>
  <para style="q2" vid="PSA 34:12">amottey oonee?<verse eid="PSA 34:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 34:13"/>Ne inxarsay iitabaa odetonaada,</para>
  <para style="q2" vid="PSA 34:13">ne doonay cimmonnaada teqa.<verse eid="PSA 34:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 34:14"/>Iitape haaka; lo77oba ootha;</para>
  <para style="q2" vid="PSA 34:14">sarotethi koya; kaalla.<verse eid="PSA 34:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 34:15"/>Godaa ayfey xillota xeellees;</para>
  <para style="q2" vid="PSA 34:15">iya haythay enta waasuwa si7ees.<verse eid="PSA 34:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 34:16"/>Enta qofisiyaba biittafe dhaysanaw,</para>
  <para style="q2" vid="PSA 34:16">Goday iita ootheyisata ba hanqo ayfen xeellees.<verse eid="PSA 34:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 34:17"/>Xilloti waassoosona;</para>
  <para style="q2" vid="PSA 34:17">Goday enta waasuwa si7ees;</para>
  <para style="q2" vid="PSA 34:17">I enta meto ubbaafe ashshees.<verse eid="PSA 34:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 34:18"/>Wozani meqidaysatas Goday matana;</para>
  <para style="q2" vid="PSA 34:18">I ufaysi qanxidaysata ashshees.<verse eid="PSA 34:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 34:19"/>Xillo asas metoy daro;</para>
  <para style="q2" vid="PSA 34:19">shin Goday iya he ubbaafe ashshees.<verse eid="PSA 34:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 34:20"/>Goday iya meqethata naagiya gisho,</para>
  <para style="q2" vid="PSA 34:20">entafe issoyka meqenna.<verse eid="PSA 34:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 34:21"/>Iitata enta iitatethay wodhana;</para>
  <para style="q2" vid="PSA 34:21">xillota ixeysati pirdetana.<verse eid="PSA 34:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 34:22"/>Goday ba aylleta wozees;</para>
  <para style="q2" vid="PSA 34:22">iyako baqatiya oonika pirdetenna.<verse eid="PSA 34:22"/></para>
  <chapter eid="PSA 34"/>
  <chapter number="35" style="c" sid="PSA 35"/>
  <para style="s1">Bixatida Asa Woosa</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 35:1"/>Godaw, taara baaxeteysatar ne baaxeta;</para>
  <para style="q2" vid="PSA 35:1">tana oleyisata ne ola.<verse eid="PSA 35:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 35:2"/>Gondallenne toora oykada,</para>
  <para style="q2" vid="PSA 35:2">tana maaddanaw denda.<verse eid="PSA 35:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 35:3"/>Tana gooddeyisata bolla</para>
  <para style="q2" vid="PSA 35:3">ne tooranne mashsha dentha;</para>
  <para style="q2" vid="PSA 35:3">taako “Ta nena ashsheysa” yaaga.<verse eid="PSA 35:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 35:4"/>Ta shempuwa wodhanaw koyeysati,</para>
  <para style="q2" vid="PSA 35:4">yeellato; kawuyo.</para>
  <para style="q1" vid="PSA 35:4">Ta bolla iitabaa maqeteysati,</para>
  <para style="q2" vid="PSA 35:4">kawuyidi guye simmo.<verse eid="PSA 35:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 35:5"/>Godaa kiitanchoy enta yedethiya wode,</para>
  <para style="q2" vid="PSA 35:5">enti carkon laaletiya suullada hano.<verse eid="PSA 35:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 35:6"/>Godaa kiitanchoy enta gooddiya wode,</para>
  <para style="q2" vid="PSA 35:6">enta ogey dhumanne hallithi gido.<verse eid="PSA 35:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 35:7"/>Gaasoy bayna tana oykanaw xihe wothoosona;</para>
  <para style="q2" vid="PSA 35:7">tana kundisanaw olla bookosona.<verse eid="PSA 35:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 35:8"/>Eronna de7ishin enta bolla dhayoy yo;</para>
  <para style="q2" vid="PSA 35:8">enti wothida xihey enta oyko;</para>
  <para style="q2" vid="PSA 35:8">enti bookida ollan kundidi dhayo.<verse eid="PSA 35:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 35:9"/>He wode taani Godan ufaytana;</para>
  <para style="q2" vid="PSA 35:9">I ashshida gisho hashshu gaana.<verse eid="PSA 35:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 35:10"/>Ta kumetha asatethay nena,</para>
  <para style="q2" vid="PSA 35:10">“Godaw, ne meli oonee?</para>
  <para style="q1" vid="PSA 35:10">Manquwa wolqaamaa kushiyape kessa ekaasa;</para>
  <para style="q2" vid="PSA 35:10">metootanchuwanne un7etidaysa,</para>
  <para style="q2" vid="PSA 35:10">bonqeyisata kushepe ashshaasa” yaagana.<verse eid="PSA 35:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 35:11"/>Wordo markateysati ta bolla dendoosona;</para>
  <para style="q2" vid="PSA 35:11">ta eronnaban tana mootosona.<verse eid="PSA 35:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 35:12"/>Ta lo77o oothida gisho iita zaaridosona;</para>
  <para style="q2" vid="PSA 35:12">tana bizza oothidosona.<verse eid="PSA 35:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 35:13"/>Shin enti hargida wode taani kayo ma7o ma7as;</para>
  <para style="q2" vid="PSA 35:13">ta asatethaa xooman daabursas;</para>
  <para style="q2" vid="PSA 35:13">ta woosay zaaro demmonna attis.<verse eid="PSA 35:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 35:14"/>Tana kawushada</para>
  <para style="q2" vid="PSA 35:14">dabbos woyko ishas yeekeysada yeekas.</para>
  <para style="q1" vid="PSA 35:14">Issi asi ba aayes kayoteysada</para>
  <para style="q2" vid="PSA 35:14">ta huuphiya oykada yeekas.<verse eid="PSA 35:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 35:15"/>Shin taani dhubetida wode ufaytidi shiiqidosona;</para>
  <para style="q2" vid="PSA 35:15">gaasoy bayna tana wadhidi,</para>
  <para style="q2" vid="PSA 35:15">aggonna ixidosona.<verse eid="PSA 35:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 35:16"/>Iita asati ootheysada enti tana qelqisidosona;</para>
  <para style="q2" vid="PSA 35:16">yilotidi banta acha garcidosona.<verse eid="PSA 35:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 35:17"/>Godaw, neeni awude gakanaw,</para>
  <para style="q2" vid="PSA 35:17">si77i gada xeellay?</para>
  <para style="q1" vid="PSA 35:17">Enta iita oosuwape tana ashsha;</para>
  <para style="q2" vid="PSA 35:17">ta al7o shempuwa ha gaammotape wosisa eka.<verse eid="PSA 35:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 35:18"/>He wode gita shiiqon ta nena galatana;</para>
  <para style="q2" vid="PSA 35:18">daro asay de7iya bessan nena bonchana.<verse eid="PSA 35:18"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 35:19"/>Gaasoy bayna tana morkeysati ufaytofo;</para>
  <para style="q2" vid="PSA 35:19">tana coo ixeysati ta bolla qam7otopo.<verse eid="PSA 35:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 35:20"/>Enti saroba haasayokona;</para>
  <para style="q2" vid="PSA 35:20">si77i gidi de7iya asaa bolla oda xaaxosona.<verse eid="PSA 35:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 35:21"/>Enti banta doona ta bolla dooyidi,</para>
  <para style="q2" vid="PSA 35:21">“Haysa be7a, ne oothidaysa</para>
  <para style="q2" vid="PSA 35:21">nuuni nu ayfen be7ida” yaagosona.<verse eid="PSA 35:21"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 35:22"/>Godaw, neeni hessa be7adasa;</para>
  <para style="q2" vid="PSA 35:22">si77i goopa.</para>
  <para style="q2" vid="PSA 35:22">Godaw, taape haakofa.<verse eid="PSA 35:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 35:23"/>Ta Xoossaw, ta Godaw ta gisho,</para>
  <para style="q2" vid="PSA 35:23">denda; barka;</para>
  <para style="q2" vid="PSA 35:23">ta doona gidada mooteta.<verse eid="PSA 35:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 35:24"/>Ta Godaw, ta Xoossaw, xillotethan taw pirda;</para>
  <para style="q2" vid="PSA 35:24">ta morketa ufaysofa.<verse eid="PSA 35:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 35:25"/>Enti banta wozanan, “Hashshu, nu amoy poletis;</para>
  <para style="q2" vid="PSA 35:25">nuuni iya mittida” gaana mela oothofa.<verse eid="PSA 35:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 35:26"/>Ta waayan ufayteysati, yeellato, kawuyo;</para>
  <para style="q2" vid="PSA 35:26">ta bolla ceeqeteysati yeellanne kawushe ma7o.<verse eid="PSA 35:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 35:27"/>Ta xoonuwa doseysati ufayto;</para>
  <para style="q2" vid="PSA 35:27">ililo; hashshu yaago.</para>
  <para style="q1" vid="PSA 35:27">“Ubba wode ba aylliya sarotethan,</para>
  <para style="q2" vid="PSA 35:27">ufaytiya Goday dhoqu dhoqu go” yaago.<verse eid="PSA 35:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 35:28"/>Ta inxarsay ne xillotethaanne ne galataa,</para>
  <para style="q2" vid="PSA 35:28">gallasa kumethan odees.<verse eid="PSA 35:28"/></para>
  <chapter eid="PSA 35"/>
  <chapter number="36" style="c" sid="PSA 36"/>
  <para style="s1">Al7o Gidida Xoossa Siiqo</para>
  <para style="d">Godaa aylley, Dawiti zammaareta halaqaas xaafida mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 36:1"/>Iita asi ba wozanan iitabaa qopees;</para>
  <para style="q2" vid="PSA 36:1">I ba wozanan Xoossas yayyenna.<verse eid="PSA 36:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 36:2"/>I bana daro nashshiya gisho;</para>
  <para style="q2" vid="PSA 36:2">ba nagaraa be7anaw woyko ixanaw danda7enna.<verse eid="PSA 36:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 36:3"/>Iya doonan geneynne wordoy kumis;</para>
  <para style="q2" vid="PSA 36:3">Cincatethinne lo77oba ooso aggis.<verse eid="PSA 36:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 36:4"/>Ba hiixan zin7idi gene qopees;</para>
  <para style="q2" vid="PSA 36:4">bana lo77o gidonna ogen kaalethees;</para>
  <para style="q2" vid="PSA 36:4">iitabaa ixenna.<verse eid="PSA 36:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 36:5"/>Godaw, ne siiqoy salota gakees;</para>
  <para style="q2" vid="PSA 36:5">ne tumatethay shaarape aadhees.<verse eid="PSA 36:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 36:6"/>Ne xillotethay dhoqa deretape aadhees;</para>
  <para style="q2" vid="PSA 36:6">ne pirday abba ciimmuwafe ziqa;</para>
  <para style="q2" vid="PSA 36:6">Godaw, neeni asenne do7a naagasa.<verse eid="PSA 36:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 36:7"/>Xoossaw, ne siiqoy ay mela al7o!</para>
  <para style="q2" vid="PSA 36:7">Asay ne qefiya garsan qosetidi attees.<verse eid="PSA 36:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 36:8"/>Enti ne gibiraape midi kalloosona;</para>
  <para style="q2" vid="PSA 36:8">ne keehatetha shaafape uyidi aloosona.<verse eid="PSA 36:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 36:9"/>De7o pultoy neepe keyees;</para>
  <para style="q2" vid="PSA 36:9">ne poo7uwan nuuni poo7o be7oos.<verse eid="PSA 36:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 36:10"/>Nena ereysatas ne siiqoy,</para>
  <para style="q2" vid="PSA 36:10">wozana suuretas ne xillotethay qanxetenna.<verse eid="PSA 36:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 36:11"/>Otoranchota tohoy tana yedhofo;</para>
  <para style="q2" vid="PSA 36:11">nagaranchota kushey tana yedethofo.<verse eid="PSA 36:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 36:12"/>Iita asata kundethaa be7ite;</para>
  <para style="q2" vid="PSA 36:12">enti kundidosona; dendanaw danda7okona.<verse eid="PSA 36:12"/></para>
  <chapter eid="PSA 36"/>
  <chapter number="37" style="c" sid="PSA 37"/>
  <para style="s1">Xoossay Ba Asaa Aggenna</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 37:1"/>Iitaa ootheyisata gaason yilotopa;</para>
  <para style="q2" vid="PSA 37:1">nagara ootheyisata qanaatopa.<verse eid="PSA 37:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 37:2"/>Enti maatada eeson melana;</para>
  <para style="q2" vid="PSA 37:2">boncoda shullidi qoqofetana.<verse eid="PSA 37:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 37:3"/>Godan ammaneta; lo77oba ootha;</para>
  <para style="q2" vid="PSA 37:3">biitta bolla utta; palahin de7a.<verse eid="PSA 37:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 37:4"/>Godan ufayta;</para>
  <para style="q2" vid="PSA 37:4">I ne wozanaa amuwa immana.<verse eid="PSA 37:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 37:5"/>Ne ogiya hadara Godaas imma;</para>
  <para style="q2" vid="PSA 37:5">iyan ammaneta; I new oothana.<verse eid="PSA 37:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 37:6"/>I ne xillotethaa wonta xalqeda,</para>
  <para style="q2" vid="PSA 37:6">ne pirdaa seeta gallasa awada poo7isana.<verse eid="PSA 37:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 37:7"/>Godaa sinthan si77i gada de7a;</para>
  <para style="q2" vid="PSA 37:7">danda7an naaga;</para>
  <para style="q2" vid="PSA 37:7">Iita asata halchoy poletin be7ada yilotopa.<verse eid="PSA 37:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 37:8"/>Hanqo agga; yilo teqa;</para>
  <para style="q2" vid="PSA 37:8">hessi meton yeggees.<verse eid="PSA 37:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 37:9"/>Iita ootheysati dhoqolletidi dhayana;</para>
  <para style="q2" vid="PSA 37:9">shin Godan ufaysi wotheysati biitta laattana.<verse eid="PSA 37:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 37:10"/>Iita ootheysati guutha wodepe guye de7okona;</para>
  <para style="q2" vid="PSA 37:10">ne enta koyada demmaka.<verse eid="PSA 37:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 37:11"/>Shin aadati biitta laattana;</para>
  <para style="q2" vid="PSA 37:11">sarotethan ufaytidi daana.<verse eid="PSA 37:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 37:12"/>Iita asi lo77o asi dhaysanaw maqetees;</para>
  <para style="q2" vid="PSA 37:12">ba acha enta bolla garcees.<verse eid="PSA 37:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 37:13"/>Shin Goday iitata bolla miicees;</para>
  <para style="q2" vid="PSA 37:13">entaw dhayo gallasi yeysa erees.<verse eid="PSA 37:13"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 37:14"/>Iita asati manqotanne metootanchota wodhanaw,</para>
  <para style="q2" vid="PSA 37:14">suure hemeteyisata shukanaw,</para>
  <para style="q2" vid="PSA 37:14">banta mashsha shoddoosona;</para>
  <para style="q2" vid="PSA 37:14">banta dongiya waaxoosona.<verse eid="PSA 37:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 37:15"/>Shin enta mashshay enta wozanan gelana;</para>
  <para style="q2" vid="PSA 37:15">enta dongey meqana.<verse eid="PSA 37:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 37:16"/>Xillo asas de7iya guuthabay,</para>
  <para style="q2" vid="PSA 37:16">iita asas de7iya darobaape lo77o.<verse eid="PSA 37:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 37:17"/>Ayis giiko, iitata wolqay meqana;</para>
  <para style="q2" vid="PSA 37:17">shin Goday xillota zempisees.<verse eid="PSA 37:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 37:18"/>Suure asata ogiya Goday erees;</para>
  <para style="q2" vid="PSA 37:18">enta laatay merinaw entaba gidana.<verse eid="PSA 37:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 37:19"/>Iita wode suure asati yeellatokona;</para>
  <para style="q2" vid="PSA 37:19">kosha wode enti kallidi maana.<verse eid="PSA 37:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 37:20"/>Shin iita asati hayqana;</para>
  <para style="q2" vid="PSA 37:20">Godaa morketi ciishshada qoqofetana;</para>
  <para style="q2" vid="PSA 37:20">cuyada ayfepe geemmana.<verse eid="PSA 37:20"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 37:21"/>Iita asi tal7idi zaarenna;</para>
  <para style="q2" vid="PSA 37:21">shin xillo asi keehatethan immees.<verse eid="PSA 37:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 37:22"/>Godan anjetidaysati biitta laattana;</para>
  <para style="q2" vid="PSA 37:22">shin I baaddidaysati dhayana.<verse eid="PSA 37:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 37:23"/>Asa ogey Godaa ufaysiko,</para>
  <para style="q2" vid="PSA 37:23">Goday iya tanguwa kaalethees; minthees.<verse eid="PSA 37:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 37:24"/>I dhubetikoka kundenna;</para>
  <para style="q2" vid="PSA 37:24">Goday iya kushiya oykidi katisees.<verse eid="PSA 37:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 37:25"/>Taani paamas; ha77i cimas;</para>
  <para style="q2" vid="PSA 37:25">shin xillo asi yegetin,</para>
  <para style="q2" vid="PSA 37:25">iya nayti kathi woossishin be7abike.<verse eid="PSA 37:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 37:26"/>I ubba wode keehatethan immees;</para>
  <para style="q2" vid="PSA 37:26">coo tal7ees;</para>
  <para style="q2" vid="PSA 37:26">iya nayti haratas anjo gidana.<verse eid="PSA 37:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 37:27"/>Iitape haaka; lo77o ootha;</para>
  <para style="q2" vid="PSA 37:27">ne adussa laythi daana.<verse eid="PSA 37:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 37:28"/>Goday xillo pirda dosees;</para>
  <para style="q2" vid="PSA 37:28">ammaneteyisata I yeggenna.</para>
  <para style="q1" vid="PSA 37:28">Enti merinaw naagetoosona;</para>
  <para style="q2" vid="PSA 37:28">shin iitata kochay dhayana.<verse eid="PSA 37:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 37:29"/>Xilloti biitta laattana;</para>
  <para style="q2" vid="PSA 37:29">yan merinaw daana.<verse eid="PSA 37:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 37:30"/>Xillo asa doonape cincatethi keyees;</para>
  <para style="q2" vid="PSA 37:30">iya inxarsay xillo odetees.<verse eid="PSA 37:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 37:31"/>Xoossa higgey iya wozanan de7ees;</para>
  <para style="q2" vid="PSA 37:31">iya tohoy dhubetenna.<verse eid="PSA 37:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 37:32"/>Iita asi xillo asi geeddees;</para>
  <para style="q2" vid="PSA 37:32">iya wodhanaw koyees.<verse eid="PSA 37:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 37:33"/>Shin Goday iya kushen aathidi immenna;</para>
  <para style="q2" vid="PSA 37:33">pirdetanaw eqiya wode iya bolla pirdisenna.<verse eid="PSA 37:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 37:34"/>Godan ufaysi ootha, iya kiitaa naaga;</para>
  <para style="q2" vid="PSA 37:34">nena biitta laatisidi gitayana;</para>
  <para style="q2" vid="PSA 37:34">iita asati dhayishin ne be7ana.<verse eid="PSA 37:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 37:35"/>Nagaranchoy Libaanose zigada,</para>
  <para style="q2" vid="PSA 37:35">diccidi dhoqu dhoqu gin ta be7as.<verse eid="PSA 37:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 37:36"/>Shin ta simmada yan demmabike;</para>
  <para style="q2" vid="PSA 37:36">koyinka bentibeenna.<verse eid="PSA 37:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 37:37"/>Borey bayna asi be7a;</para>
  <para style="q2" vid="PSA 37:37">suure asi akeeka;</para>
  <para style="q2" vid="PSA 37:37">saro asas wursethay lo77o gidana.<verse eid="PSA 37:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 37:38"/>Shin nagaranchoti dhayana;</para>
  <para style="q2" vid="PSA 37:38">enta wursethay dhoommana.<verse eid="PSA 37:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 37:39"/>Xillota atotethay Godaape yees;</para>
  <para style="q2" vid="PSA 37:39">I meto wode enti naagetidi attiya besse.<verse eid="PSA 37:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 37:40"/>Goday xillota maaddees; ashshees;</para>
  <para style="q2" vid="PSA 37:40">enti iyako baqatida gisho,</para>
  <para style="q2" vid="PSA 37:40">I enta iitatape ashshees; naagees.<verse eid="PSA 37:40"/></para>
  <chapter eid="PSA 37"/>
  <chapter number="38" style="c" sid="PSA 38"/>
  <para style="s1">Xoossaw Tana Aggofa</para>
  <para style="d">Dawiti xaafida qofiso mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 38:1"/>Abeeti Godaw, ne sheniyan tana seeropa;</para>
  <para style="q2" vid="PSA 38:1">ne yiluwan tana hanqofa.<verse eid="PSA 38:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 38:2"/>Ne donge tooray tana caddis;</para>
  <para style="q2" vid="PSA 38:2">ne kushey tana deexis.<verse eid="PSA 38:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 38:3"/>Ne hanqida gisho ta asatethay qohetis;</para>
  <para style="q2" vid="PSA 38:3">ta nagaraa gaason ta meqethay liiqis.<verse eid="PSA 38:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 38:4"/>Ta balay tana muukis;</para>
  <para style="q2" vid="PSA 38:4">dendonna gita toohoda tana deexees.<verse eid="PSA 38:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 38:5"/>Ta eeyatethan oothida nagara gisho,</para>
  <para style="q2" vid="PSA 38:5">ta madunthay xinqis.<verse eid="PSA 38:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 38:6"/>Ta sa7a xeellas; hokas;</para>
  <para style="q2" vid="PSA 38:6">gallas kumethi azzanashe pee7as.<verse eid="PSA 38:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 38:7"/>Ta ashoy xuuggees;</para>
  <para style="q2" vid="PSA 38:7">ta asatethay paxa gidenna.<verse eid="PSA 38:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 38:8"/>Ta daaburas; liiqas;</para>
  <para style="q2" vid="PSA 38:8">ta wozanay dirgiya gisho oolas.<verse eid="PSA 38:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 38:9"/>Abeeti Godaw, ta wozanaa amo ubbaa eraasa;</para>
  <para style="q2" vid="PSA 38:9">ta ooley neepe geemmibeenna.<verse eid="PSA 38:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 38:10"/>Ta wozanay dirgees;</para>
  <para style="q2" vid="PSA 38:10">ta wolqay hitti gis;</para>
  <para style="q2" vid="PSA 38:10">ta ayfiya poo7oy dhayis.<verse eid="PSA 38:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 38:11"/>Ta madunthaa gaason</para>
  <para style="q2" vid="PSA 38:11">ta shoorotinne ta laggeti haakidi eqidosona;</para>
  <para style="q2" vid="PSA 38:11">ta dabboti taape haakidosona.<verse eid="PSA 38:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 38:12"/>Tana wodhanaw koyeysati</para>
  <para style="q2" vid="PSA 38:12">banta xihiya taw yeggoosona.</para>
  <para style="q1" vid="PSA 38:12">Tana qohanaw koyeysati,</para>
  <para style="q2" vid="PSA 38:12">“Nu nena demmana” yaagidi, mandoosona;</para>
  <para style="q2" vid="PSA 38:12">gallas kumethi ta bolla tobboosona.<verse eid="PSA 38:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 38:13"/>Ta tulle asa mela si7ike;</para>
  <para style="q2" vid="PSA 38:13">muume asa mela doona pogike.<verse eid="PSA 38:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 38:14"/>Tuma haythi si7onna asi,</para>
  <para style="q2" vid="PSA 38:14">inxarsi odidi zaaronna asi gidas.<verse eid="PSA 38:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 38:15"/>Godaw, ta nena ufaysan naagayis;</para>
  <para style="q2" vid="PSA 38:15">ta Godaw, Xoossaw ne taw zaaro imma.<verse eid="PSA 38:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 38:16"/>Taani, “Ta tohoy dhubetin,</para>
  <para style="q2" vid="PSA 38:16">enti hashshu gaanadanne</para>
  <para style="q2" vid="PSA 38:16">ta bolla ceeqetanaada oothofa” yaagas.<verse eid="PSA 38:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 38:17"/>Ta kundana hanayis,</para>
  <para style="q2" vid="PSA 38:17">ta sakoy tana aggonna ixis.<verse eid="PSA 38:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 38:18"/>Ta nagara paaxayis;</para>
  <para style="q2" vid="PSA 38:18">ta naaquwa gaason azzanayis.<verse eid="PSA 38:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 38:19"/>Ta morketi gitane wolqaama;</para>
  <para style="q2" vid="PSA 38:19">tana coo ixeysati daro.<verse eid="PSA 38:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 38:20"/>Taani lo77oba oothin iita zaareysati,</para>
  <para style="q2" vid="PSA 38:20">ta lo77oba kaalliya gisho taara eqetoosona.<verse eid="PSA 38:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 38:21"/>Godaw, tana yeggofa;</para>
  <para style="q2" vid="PSA 38:21">ta Xoossaw, taape haakofa.<verse eid="PSA 38:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 38:22"/>Tana ashshiya ta Godaw,</para>
  <para style="q2" vid="PSA 38:22">tana maaddanaw ellesa.<verse eid="PSA 38:22"/></para>
  <chapter eid="PSA 38"/>
  <chapter number="39" style="c" sid="PSA 39"/>
  <para style="s1">Gita Xoossi-Laafa Asi</para>
  <para style="d">Dawiti zammaareta halaqa, Edotaames xaafida mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 39:1"/>Taani, “Ta inxarsan nagara oothonna mela,</para>
  <para style="q2" vid="PSA 39:1">ta ogiya naagana.</para>
  <para style="q1" vid="PSA 39:1">Iita asati ta de7iya wode,</para>
  <para style="q2" vid="PSA 39:1">ta doona barana” yaagas.<verse eid="PSA 39:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 39:2"/>Shin doona muumeda si77i gas;</para>
  <para style="q2" vid="PSA 39:2">hari attoshin lo77oba odeteysa aggas;</para>
  <para style="q2" vid="PSA 39:2">shin ta waayey haa daris.<verse eid="PSA 39:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 39:3"/>Ta wozanay ta gaathan teellis;</para>
  <para style="q2" vid="PSA 39:3">ta qofay tamada eexis;</para>
  <para style="q2" vid="PSA 39:3">yaatin ta inxarsan haasaya doomas.<verse eid="PSA 39:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 39:4"/>Godaw, ta de7uwa wursethaanne</para>
  <para style="q2" vid="PSA 39:4">ta daanaw attida gallasaa tana bessa;</para>
  <para style="q2" vid="PSA 39:4">ta de7oy ay mela qantheko tana erisa.<verse eid="PSA 39:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 39:5"/>Neeni ta laytha takadhada wothadasa;</para>
  <para style="q2" vid="PSA 39:5">Ta laythay ne sinthan baynaba mela;</para>
  <para style="q2" vid="PSA 39:5">tuma asi ubbay issi shempo mela. <char style="qs">Salaha </char><verse eid="PSA 39:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 39:6"/>Tuma asi aadhiya eesho mela;</para>
  <para style="q2" vid="PSA 39:6">I coo daaburees; shalo shiishees;</para>
  <para style="q2" vid="PSA 39:6">shin ooni go7etaneko erenna.<verse eid="PSA 39:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 39:7"/>Godaw, ha77i ta naagey oonee?</para>
  <para style="q2" vid="PSA 39:7">Taani nenan ufaysi oothayis.<verse eid="PSA 39:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 39:8"/>Ta bala ubbaafe tana ashsha;</para>
  <para style="q2" vid="PSA 39:8">eeyatan tana tooshisopa.<verse eid="PSA 39:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 39:9"/>Hessa ubbaa oothiday nena gidiya gisho</para>
  <para style="q2" vid="PSA 39:9">taani muumas; doonaka pogabike.<verse eid="PSA 39:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 39:10"/>Ne xam7a ta bollafe dentha;</para>
  <para style="q2" vid="PSA 39:10">mino ne kushiya gaason ta daaburas.<verse eid="PSA 39:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 39:11"/>Ase iya nagaraa gisho seerasa;</para>
  <para style="q2" vid="PSA 39:11">iya al7o de7uwa bilada wursaasa;</para>
  <para style="q2" vid="PSA 39:11">tuma asi ubbay issi shempo mela. <char style="qs">Salaha </char><verse eid="PSA 39:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 39:12"/>Godaw, ta woosa si7a;</para>
  <para style="q2" vid="PSA 39:12">tana maaddanaw ta waasuwa hayza.</para>
  <para style="q1" vid="PSA 39:12">Ta afuthaa be7ada si77i goopa;</para>
  <para style="q2" vid="PSA 39:12">taani ta aawatada bete asinne imathe</para>
  <para style="q2" vid="PSA 39:12">gidada neera de7ayis.<verse eid="PSA 39:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 39:13"/>Ta shaaketanapenne baanape sinthe</para>
  <para style="q2" vid="PSA 39:13">taani ufaytana mela tana agga.<verse eid="PSA 39:13"/></para>
  <chapter eid="PSA 39"/>
  <chapter number="40" style="c" sid="PSA 40"/>
  <para style="s1">Maade Demmanaw Woossiya Woosa</para>
  <para style="d">Zamaareta halaqaas Dawiti xaafida mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 40:1"/>Taani Godaa danda7an naagas;</para>
  <para style="q2" vid="PSA 40:1">I taako simmidi ta waasuwa si7is.<verse eid="PSA 40:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 40:2"/>Dhayo ollafe, silimo urqafe tana kessis;</para>
  <para style="q2" vid="PSA 40:2">ta tohuwa zaalla bolla essis;</para>
  <para style="q2" vid="PSA 40:2">ta hemethaa minthis.<verse eid="PSA 40:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 40:3"/>Ta doonan ooratha yethi wothis;</para>
  <para style="q2" vid="PSA 40:3">hessika nu Xoossay galatetto yaageysa;</para>
  <para style="q2" vid="PSA 40:3">daroti be7idi yayyana; Godan ammanetana.<verse eid="PSA 40:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 40:4"/>Godan ammanetiya,</para>
  <para style="q2" vid="PSA 40:4">otoranchota xeellonnay,</para>
  <para style="q2" vid="PSA 40:4">wordotara hemetonnay,</para>
  <para style="q2" vid="PSA 40:4">anjetida asi.<verse eid="PSA 40:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 40:5"/>Godaw, ta Xoossaw,</para>
  <para style="q2" vid="PSA 40:5">neeni daro malaalsiyaba oothadasa;</para>
  <para style="q2" vid="PSA 40:5">neera liketey oonika baawa!</para>
  <para style="q1" vid="PSA 40:5">Neeni nuus qopida lo77o qofaa,</para>
  <para style="q2" vid="PSA 40:5">oonika taybanaw danda7onna;</para>
  <para style="q2" vid="PSA 40:5">Hessi taani odin wuriyaba gidenna.<verse eid="PSA 40:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 40:6"/>Neeni yarshonne imo koyabaaka;</para>
  <para style="q2" vid="PSA 40:6">shin nena si7ana mela ta haythaa dooyadasa;</para>
  <para style="q2" vid="PSA 40:6">xuussa yarshonne nagara yarsho koyabaaka.<verse eid="PSA 40:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 40:7"/>Hessa gisho taani, “Xaatha maxaafan</para>
  <para style="q2" vid="PSA 40:7">tabay xaafetidaysada taani yas.<verse eid="PSA 40:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 40:8"/>Ta Xoossaw, taani ne sheniya oothanaw dosayis;</para>
  <para style="q2" vid="PSA 40:8">ne higgey ta wozanan de7ees” yaagas.<verse eid="PSA 40:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 40:9"/>Gita shiiqon, ne xillotetha odana;</para>
  <para style="q2" vid="PSA 40:9">Godaw neeni ereysada,</para>
  <para style="q2" vid="PSA 40:9">taani markateysa aggike.<verse eid="PSA 40:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 40:10"/>Ta ne xillotethaa ta wozanan qosabike;</para>
  <para style="q2" vid="PSA 40:10">ne ammanetethanne ne ashuwa odas.</para>
  <para style="q1" vid="PSA 40:10">Ne siiquwanne ne tumatethaa,</para>
  <para style="q2" vid="PSA 40:10">gita shiiquwan genthabike.<verse eid="PSA 40:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 40:11"/>Godaw, ne maarotethaa taape haassofa;</para>
  <para style="q2" vid="PSA 40:11">ne siiqoynne ne tumatethay,</para>
  <para style="q2" vid="PSA 40:11">tana ubba wode naago.<verse eid="PSA 40:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 40:12"/>Tayboy bayna iitabay tana teqis;</para>
  <para style="q2" vid="PSA 40:12">ta balay tana goozis;</para>
  <para style="q2" vid="PSA 40:12">ta xeellanaw danda7ike</para>
  <para style="q1" vid="PSA 40:12">Ta nagaray ta huuphe binaanape daris;</para>
  <para style="q2" vid="PSA 40:12">ta wozanay ta giddon til7is.<verse eid="PSA 40:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 40:13"/>Godaw, tana ashshanaw ero ga;</para>
  <para style="q2" vid="PSA 40:13">ta Godaw, tana maaddanaw ellesa.<verse eid="PSA 40:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 40:14"/>Tana wodhanaw koyeysati yeellato, kawuyo;</para>
  <para style="q2" vid="PSA 40:14">Ta qohetetha amotteysati kawuyidi guye simmo.<verse eid="PSA 40:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 40:15"/>Taako, “Iyaw hashshu, hashshu”</para>
  <para style="q2" vid="PSA 40:15">geysati xoonetidi yeellato.<verse eid="PSA 40:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 40:16"/>Shin nena koyiya ubbay,</para>
  <para style="q2" vid="PSA 40:16">nenan ufayto; hashshu go.</para>
  <para style="q1" vid="PSA 40:16">Ne atotetha dosiya ubbay,</para>
  <para style="q2" vid="PSA 40:16">“Goday gita” yaago.<verse eid="PSA 40:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 40:17"/>Taani manqonne metootancho;</para>
  <para style="q2" vid="PSA 40:17">shin Goday tabaa qopo!</para>
  <para style="q1" vid="PSA 40:17">Tana maaddey ashshey nena;</para>
  <para style="q2" vid="PSA 40:17">ta Xoossaw, gam7ofa.<verse eid="PSA 40:17"/></para>
  <chapter eid="PSA 40"/>
  <chapter number="41" style="c" sid="PSA 41"/>
  <para style="s1">Hargetiyanne Bizza Asa Woosa</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 41:1"/>Manquwas qopiya asi anjetidaysa;</para>
  <para style="q2" vid="PSA 41:1">meto gallas Goday iya ashshees.<verse eid="PSA 41:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 41:2"/>Goday iya naagees, de7on wothees;</para>
  <para style="q2" vid="PSA 41:2">biitta bolla Goday iya anjees;</para>
  <para style="q2" vid="PSA 41:2">Goday iya, iya morketa amuwas aathidi immenna.<verse eid="PSA 41:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 41:3"/>I saketidi hiithan de7ishin Goday maaddees;</para>
  <para style="q2" vid="PSA 41:3">hargiyafe iya pathees.<verse eid="PSA 41:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 41:4"/>Taani, “Godaw, ta nena naaqida gisho,</para>
  <para style="q2" vid="PSA 41:4">tana maara;</para>
  <para style="q2" vid="PSA 41:4">ta hargiyafe tana patha” yaagas.<verse eid="PSA 41:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 41:5"/>Ta morketi iitabaa ta bolla haasayidi,</para>
  <para style="q2" vid="PSA 41:5">“I awude hayqandee?</para>
  <para style="q2" vid="PSA 41:5">iya sunthay awude dogetandee?” yaagosona.<verse eid="PSA 41:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 41:6"/>Tana be7anaw yaa oonika wordo odees;</para>
  <para style="q2" vid="PSA 41:6">ba wozanan tana zigiriyabaa shiishees;</para>
  <para style="q2" vid="PSA 41:6">kare keyidi ta sunthaa iissees.<verse eid="PSA 41:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 41:7"/>Tana ixiya ubbay issife tana zigiroosona;</para>
  <para style="q2" vid="PSA 41:7">iitabay iya gakees gidi qopoosona.<verse eid="PSA 41:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 41:8"/>“Iya iita hargey oykis;</para>
  <para style="q2" vid="PSA 41:8">I hiza hiixape dendenna” yaagosona.<verse eid="PSA 41:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 41:9"/>Hari attoshin ta ammanetiya laggey,</para>
  <para style="q2" vid="PSA 41:9">taara midaysi taw zoko zaaris.<verse eid="PSA 41:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 41:10"/>Shin Godaw tana maara;</para>
  <para style="q2" vid="PSA 41:10">ta entaw kushe zaarana mela,</para>
  <para style="q2" vid="PSA 41:10">harge hiixape tana dentha.<verse eid="PSA 41:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 41:11"/>Ta morkey tana xoononna gisho,</para>
  <para style="q2" vid="PSA 41:11">ne tanan ufaytanaysa ta erayis.<verse eid="PSA 41:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 41:12"/>Ne tana ta suuretetha gisho katisaasa;</para>
  <para style="q2" vid="PSA 41:12">ne sinthan tana merinaw wothaasa.<verse eid="PSA 41:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 41:13"/>Goday, Isra7eele Xoossay,</para>
  <para style="q2" vid="PSA 41:13">merinaape merinaa gakanaw galatetto.</para>
  <para style="b" vid="PSA 41:13"/>
  <para style="qc" vid="PSA 41:13">Amin7i! Amin7i!<verse eid="PSA 41:13"/></para>
  <chapter eid="PSA 41"/>
  <chapter number="42" style="c" sid="PSA 42"/>
  <para style="ms">Nam7antho Maxaafaa</para>
  <para style="mr">(<ref loc="PSA 42-72">Maz 42—72</ref>)</para>
  <para style="s1">Goodetiya Asa Woosa</para>
  <para style="d">Qore Nayta Timirte</para>
  <para style="d">Akeekan xaafida mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 42:1"/>Gaari pulto haathi laamoteysada,</para>
  <para style="q2" vid="PSA 42:1">Xoossaw, ta shempiya nena laamotawusu.<verse eid="PSA 42:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 42:2"/>“Ta shempiya Xoossaa,</para>
  <para style="q2" vid="PSA 42:2">de7o Xoossaa be7anaw saamotawusu;</para>
  <para style="q2" vid="PSA 42:2">awude gakada iya som7uwa be7o” yaagawusu.<verse eid="PSA 42:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 42:3"/>Asay, “Ne Xoossay awun de7ii?”</para>
  <para style="q2" vid="PSA 42:3">giya wode,</para>
  <para style="q2" vid="PSA 42:3">gallasinne qammi taw afuthi kathi gidis.<verse eid="PSA 42:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 42:4"/>Taani enta ba7aale bonchanaw shiiqida, daro asaa kaalethada,</para>
  <para style="q2" vid="PSA 42:4">galata yethaninne ililisan xoossa keethi beysa qopiya wode,</para>
  <para style="q2" vid="PSA 42:4">ta wozanay azzanon meqees.<verse eid="PSA 42:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 42:5"/>Ta shempe, ayis azzanay?</para>
  <para style="q2" vid="PSA 42:5">ayis un7etay?</para>
  <para style="q1" vid="PSA 42:5">Ne Xoossan ufaysi wotha;</para>
  <para style="q2" vid="PSA 42:5">tana ashshiya, ta Xoossaa taani buroo galatana.<verse eid="PSA 42:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 42:6"/>Ta wozanay azzanis;</para>
  <para style="q2" vid="PSA 42:6">hessa gisho taani Yordaanose biittan,</para>
  <para style="q1" vid="PSA 42:6">Armoona dhoqan, Mizaare zuman,</para>
  <para style="q2" vid="PSA 42:6">eqada nena qopana.<verse eid="PSA 42:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 42:7"/>Ne soossuwa guunthan ciimmoy ciimmuwa xeegees;</para>
  <para style="q2" vid="PSA 42:7">ne beetaynne ne zuley ta bollara aadhis.<verse eid="PSA 42:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 42:8"/>Goday ba siiquwa gallas taw kiittees;</para>
  <para style="q2" vid="PSA 42:8">qamma galata yethay taara de7ees;</para>
  <para style="q2" vid="PSA 42:8">ta de7o Xoossaa woossana.<verse eid="PSA 42:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 42:9"/>Xoossaa, ta zaallako,</para>
  <para style="q2" vid="PSA 42:9">“Tana ayis dogadii?</para>
  <para style="q1" vid="PSA 42:9">Ta morketi tana un7ethin,</para>
  <para style="q2" vid="PSA 42:9">yeekashe ayis hemeto” yaagana.<verse eid="PSA 42:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 42:10"/>Ta morketi, “Ne Xoossay awun de7ii?”</para>
  <para style="q2" vid="PSA 42:10">yaagidi cayiya wode ta meqethay meqees.<verse eid="PSA 42:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 42:11"/>Ta shempe ayis azzanay?</para>
  <para style="q2" vid="PSA 42:11">ayis un7etay?</para>
  <para style="q1" vid="PSA 42:11">Xoossan ufaysi wotha;</para>
  <para style="q2" vid="PSA 42:11">tana ashshiya, ta Xoossaa ta buroo galatana.<verse eid="PSA 42:11"/></para>
  <chapter eid="PSA 42"/>
  <chapter number="43" style="c" sid="PSA 43"/>
  <para style="s1">Ne Poo7uwanne Tumatetha Qoncisa</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 43:1"/>Xoossaw taw pirda;</para>
  <para style="q2" vid="PSA 43:1">nena eronna deretara ta gisho mooteta;</para>
  <para style="q2" vid="PSA 43:1">Cimmiya iita asatape tana ashsha.<verse eid="PSA 43:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 43:2"/>Xoossaw, neeni, taani qosetada attiya miixa;</para>
  <para style="q2" vid="PSA 43:2">ne tana ayis aggadii?</para>
  <para style="q1" vid="PSA 43:2">Ta morkey tana un7ethin,</para>
  <para style="q2" vid="PSA 43:2">ayis yeekashe boo?<verse eid="PSA 43:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 43:3"/>Ne poo7uwanne ne tumaa taw kiitta;</para>
  <para style="q2" vid="PSA 43:3">enti tana kaalethidi ne geeshsha deriya,</para>
  <para style="q2" vid="PSA 43:3">ne de7iya bessaa tana gatho.<verse eid="PSA 43:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 43:4"/>He wode taani Xoossaa yarsho bessaako;</para>
  <para style="q2" vid="PSA 43:4">tana ufaysiya Xoossaako baana.</para>
  <para style="q1" vid="PSA 43:4">Xoossaw ta Godaw,</para>
  <para style="q2" vid="PSA 43:4">taani diithan nena sabbana.<verse eid="PSA 43:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 43:5"/>Ta shempe ayis azzanay?</para>
  <para style="q2" vid="PSA 43:5">ayis un7etay?</para>
  <para style="q1" vid="PSA 43:5">Xoossan ufaysi wotha;</para>
  <para style="q2" vid="PSA 43:5">tana ashshiya, ta Xoossaa ta buroo galatana.<verse eid="PSA 43:5"/></para>
  <chapter eid="PSA 43"/>
  <chapter number="44" style="c" sid="PSA 44"/>
  <para style="s1">Nuna Maaddanaw Ellesa</para>
  <para style="d">Qore Nayti Zammare Halaqaas Xaafida Mazmure</para>
  <para style="d">Akeekan xaafida ginxo</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 44:1"/>Xoossaw, beni wode ne oothidaba nu si7ida;</para>
  <para style="q2" vid="PSA 44:1">nu aawata wode ne oothidaba nuus odidosona.<verse eid="PSA 44:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 44:2"/>Kawotethata ne kushen goodda kessadasa;</para>
  <para style="q2" vid="PSA 44:2">nu aawata enta biittan tokadasa.</para>
  <para style="q1" vid="PSA 44:2">Hara kawotethata seeradasa;</para>
  <para style="q2" vid="PSA 44:2">shin nu aawata aakisadasa.<verse eid="PSA 44:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 44:3"/>Enti banta mashshan olidi he biitta laatibookona;</para>
  <para style="q2" vid="PSA 44:3">enti banta minotethan xoonibookona.</para>
  <para style="q1" vid="PSA 44:3">Shin neeni enta dosida gisho,</para>
  <para style="q2" vid="PSA 44:3">enta ne ushacha kushey, ne qeseynne</para>
  <para style="q2" vid="PSA 44:3">ne som7uwa poo77oy xoonisis.<verse eid="PSA 44:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 44:4"/>Yayqooba kochaas xoono kiittiya,</para>
  <para style="q2" vid="PSA 44:4">ta kawoynne ta Xoossay nena.<verse eid="PSA 44:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 44:5"/>Nenan gididi nu morketa xoonana;</para>
  <para style="q2" vid="PSA 44:5">ne sunthan nuna ixeyisata yedhana.<verse eid="PSA 44:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 44:6"/>Taani ta tooran ammanetike;</para>
  <para style="q2" vid="PSA 44:6">ta mashshay tana ashshena.<verse eid="PSA 44:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 44:7"/>Shin ne nuna nu morketape ashshaasa;</para>
  <para style="q2" vid="PSA 44:7">nuna ixeyisata neeni kawushaasa.<verse eid="PSA 44:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 44:8"/>Nuuni ubba wode Xoossan ceeqetana;</para>
  <para style="q2" vid="PSA 44:8">ne sunthaa merinaw galatana. <char style="qs">Salaha. </char><verse eid="PSA 44:8"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 44:9"/>Shin ha77i nuna aggadasa; kawushadasa;</para>
  <para style="q2" vid="PSA 44:9">nu olanchotara issife olas keyaka.<verse eid="PSA 44:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 44:10"/>Nu morketa sinthafe nuna baqatisadasa;</para>
  <para style="q2" vid="PSA 44:10">nu ixeysati nuna bonqidosona.<verse eid="PSA 44:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 44:11"/>Nuna dorsada shuhas aatha immadasa;</para>
  <para style="q2" vid="PSA 44:11">kawotethata giddon nuna laalladasa.<verse eid="PSA 44:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 44:12"/>Neeni ne asaa laafa gaten bayzadasa;</para>
  <para style="q2" vid="PSA 44:12">ay wodheka demmabaaka.<verse eid="PSA 44:12"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 44:13"/>Nu shooroti nuna boranaada oothadasa;</para>
  <para style="q2" vid="PSA 44:13">nu heeran de7eysati nuna qilqisanaadanne</para>
  <para style="q2" vid="PSA 44:13">nu bolla miicanaada oothadasa.<verse eid="PSA 44:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 44:14"/>Nuna kawotethata giddon hayses aggadasa;</para>
  <para style="q2" vid="PSA 44:14">enti banta huuphiya nu bolla</para>
  <para style="q2" vid="PSA 44:14">qaathana mela oothadasa.<verse eid="PSA 44:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 44:15"/>Gallas kumethi taani tooshetas;</para>
  <para style="q2" vid="PSA 44:15">ta som7uwa yeelli kammis.<verse eid="PSA 44:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 44:16"/>Hessi haniday tana cayeysatanne boreyisata gaasoninne,</para>
  <para style="q2" vid="PSA 44:16">ta morketanne tana mandeyisata gaasona.<verse eid="PSA 44:16"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 44:17"/>Nuuni nena dogonna de7ishin,</para>
  <para style="q2" vid="PSA 44:17">ne caaquwa menthonna de7ishin,</para>
  <para style="q2" vid="PSA 44:17">ha ubbay nuna gakis.<verse eid="PSA 44:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 44:18"/>Nu wozanay nena aggibeenna;</para>
  <para style="q2" vid="PSA 44:18">nu tohoy ne ogiyape kare keybeenna.<verse eid="PSA 44:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 44:19"/>Shin neeni nuna mentherethada</para>
  <para style="q2" vid="PSA 44:19">do7a ollan yeggadasa;</para>
  <para style="q2" vid="PSA 44:19">sakana dhuman kammadasa.<verse eid="PSA 44:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 44:20"/>Nu, Xoossaa sunthaa dogidaba gidiyako,</para>
  <para style="q2" vid="PSA 44:20">hara xoossatako nu kushiya miccidaba gidiyako,<verse eid="PSA 44:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 44:21"/>Wozana xuuraa Xoossay eriya gisho,</para>
  <para style="q2" vid="PSA 44:21">I haysa xeellidi demmennee?<verse eid="PSA 44:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 44:22"/>Gidoshin, ne gisho ubba gallas hayqoos;</para>
  <para style="q2" vid="PSA 44:22">shukanaw efiya dorsada taybetida.<verse eid="PSA 44:22"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 44:23"/>Godaw, denda, Ayis dhiskay?</para>
  <para style="q2" vid="PSA 44:23">Denda, merinaw nuna aggofa.<verse eid="PSA 44:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 44:24"/>Ne som7uwa nuupe ayis genthay?</para>
  <para style="q2" vid="PSA 44:24">Nu qohuwanne nu un7aa ayis dogay?<verse eid="PSA 44:24"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 44:25"/>Nuuni baanan yegetida;</para>
  <para style="q2" vid="PSA 44:25">nu asatethay biittara oyketis.<verse eid="PSA 44:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 44:26"/>Godaw, denda, nuna maadda;</para>
  <para style="q2" vid="PSA 44:26">ne siiquwa gisho gada nuna woza.<verse eid="PSA 44:26"/></para>
  <chapter eid="PSA 44"/>
  <chapter number="45" style="c" sid="PSA 45"/>
  <para style="s1">Xoossaa Araatay Merinaasa</para>
  <para style="d">Qore Nayti “Ciishshe” Geetetiya cuudhethan Zammaareta Halaqaas Xaafida Mazmure</para>
  <para style="d">Akeekan xaafida siiqo mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 45:1"/>Taani ta yethaa kawas sissana;</para>
  <para style="q2" vid="PSA 45:1">ta wozanay lo77o qofa pultees;</para>
  <para style="q2" vid="PSA 45:1">ta inxarsay lo77o xaafiya asa bi7ire mela.<verse eid="PSA 45:1"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 45:2"/>Asa ubbaafe neeni mala lo7o;</para>
  <para style="q2" vid="PSA 45:2">ne mettershay aadho keehatetha qaalan kumis;</para>
  <para style="q2" vid="PSA 45:2">Xoossay nena merinaw anjis.<verse eid="PSA 45:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 45:3"/>Wolqaama kawaw, ne mashshaa danca;</para>
  <para style="q2" vid="PSA 45:3">bonchonne teema ma7a.<verse eid="PSA 45:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 45:4"/>Ne tumatethaa, ne aadatethanne ne xillotetha gisho,</para>
  <para style="q2" vid="PSA 45:4">ne teema ma7ada xoonanaw denda;</para>
  <para style="q2" vid="PSA 45:4">ne ushacha kushey malaalsiyaba besso.<verse eid="PSA 45:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 45:5"/>Ne toorati qara;</para>
  <para style="q2" vid="PSA 45:5">enti kawa morketa wozanaa caddo;</para>
  <para style="q2" vid="PSA 45:5">kawotethati ne tohuwa garsan kundo.<verse eid="PSA 45:5"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 45:6"/>Xoossaw, ne araatay merinaw de7ees;</para>
  <para style="q2" vid="PSA 45:6">ne kawotethaa xam7ay xillotetha xam7aa.<verse eid="PSA 45:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 45:7"/>Neeni xillotethi dosada geellatethi ixaasa;</para>
  <para style="q2" vid="PSA 45:7">Hessa gisho, Xoossay, ne Xoossay,</para>
  <para style="q2" vid="PSA 45:7">ne laggetape aathidi,</para>
  <para style="q2" vid="PSA 45:7">nena ufaysa zayten tiyis.<verse eid="PSA 45:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 45:8"/>Godare uuthan, karbeninne</para>
  <para style="q2" vid="PSA 45:8">burguden walaketida shitton, ne ma7oy puuketis.</para>
  <para style="q1" vid="PSA 45:8">Dangarsa zaalen alleeqetida,</para>
  <para style="q2" vid="PSA 45:8">ne kawo gadhon diixetiya diithay nena ufaysees.<verse eid="PSA 45:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 45:9"/>Kawo keethan de7iya maccasata giddon;</para>
  <para style="q2" vid="PSA 45:9">kawota macca nayti de7oosona.</para>
  <para style="q1" vid="PSA 45:9">Kawiya Ofira worqan alleeqetada,</para>
  <para style="q2" vid="PSA 45:9">neepe ushacha baggan eqasu.<verse eid="PSA 45:9"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 45:10"/>Ta naatte, si7a; wozanan wotha;</para>
  <para style="q2" vid="PSA 45:10">ne haytha haa zaara;</para>
  <para style="q2" vid="PSA 45:10">ne deriyanne ne aawa keethaa doga.<verse eid="PSA 45:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 45:11"/>Kawoy ne malan ufaytis;</para>
  <para style="q2" vid="PSA 45:11">ne godaa gidiya gisho iya boncha.<verse eid="PSA 45:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 45:12"/>Xiroosa asay new woyto ekidi yaana;</para>
  <para style="q2" vid="PSA 45:12">dureti nena aaddashana.<verse eid="PSA 45:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 45:13"/>Kawa na7iya,</para>
  <para style="q2" vid="PSA 45:13">kawo keethan waanna lo77ay!</para>
  <para style="q2" vid="PSA 45:13">I yaagano ma7oy worqan alleeqetis.<verse eid="PSA 45:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 45:14"/>Ba alleeqo ma7uwa ma7ada,</para>
  <para style="q2" vid="PSA 45:14">kawako moyzetasu.</para>
  <para style="q1" vid="PSA 45:14">I geela7o laggeti iyo kaallidi,</para>
  <para style="q2" vid="PSA 45:14">iya sinthe ekidi yidosona.<verse eid="PSA 45:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 45:15"/>Enti ufaytishe yidi,</para>
  <para style="q2" vid="PSA 45:15">kawo gadho geloosona.<verse eid="PSA 45:15"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 45:16"/>Kawaw, ne aawata bessaa ne nayti laattana;</para>
  <para style="q2" vid="PSA 45:16">biitta ubban ne enta shuumana.<verse eid="PSA 45:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 45:17"/>Ta ne sunthaa yeleta ubban,</para>
  <para style="q2" vid="PSA 45:17">hassayetanaada oothana.</para>
  <para style="q2" vid="PSA 45:17">Hessa gisho, asay merinaw nena galatana.<verse eid="PSA 45:17"/></para>
  <chapter eid="PSA 45"/>
  <chapter number="46" style="c" sid="PSA 46"/>
  <para style="s1">Xoossay Nuura De7ees</para>
  <para style="d">Qore Nayti Zammaareta Halaqaas Xaafida Mazmure</para>
  <para style="d">“Geela7o nayta yethi” geetetiya cuudhethan yexetida mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 46:1"/>Xoossay nu qosetidi attiya,</para>
  <para style="q2" vid="PSA 46:1">bessenne nu wolqaa.</para>
  <para style="q1" vid="PSA 46:1">Nuna metoy gakiya wode,</para>
  <para style="q2" vid="PSA 46:1">I nuna maaddanaw ubba wode nu matan de7ees.<verse eid="PSA 46:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 46:2"/>Hessa gisho, biittay qaaxiyakoka,</para>
  <para style="q2" vid="PSA 46:2">dereti abban kundiyakoka,</para>
  <para style="q2" vid="PSA 46:2">nuuni yayyoko.<verse eid="PSA 46:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 46:3"/>Abbay guummidi gopontikoka,</para>
  <para style="q2" vid="PSA 46:3">iya wolqaama zuliyan dereti kokoriyakoka,</para>
  <para style="q2" vid="PSA 46:3">nuuni dagammoko. <char style="qs">Salaha. </char><verse eid="PSA 46:3"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 46:4"/>Ubbaafe Dhoqa Xoossay de7iya, Xoossaa katamaa,</para>
  <para style="q2" vid="PSA 46:4">geeshsha bessaa, ufaysiya issi shaafi de7ees.<verse eid="PSA 46:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 46:5"/>Xoossay iya giddon de7iya gisho,</para>
  <para style="q2" vid="PSA 46:5">he katamay qaaxenna;</para>
  <para style="q2" vid="PSA 46:5">wonta guura Xoossay iya maaddana.<verse eid="PSA 46:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 46:6"/>Derey dagammis; kawotethati qaaxoosona;</para>
  <para style="q2" vid="PSA 46:6">Xoossay ba qaala sissis; biittay til7is.<verse eid="PSA 46:6"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 46:7"/>Ubbaafe wolqaama Goday nuura de7ees;</para>
  <para style="q2" vid="PSA 46:7">Yayqooba Xoossay nu qosetidi attiya besse. <char style="qs">Salaha </char><verse eid="PSA 46:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 46:8"/>Haa yiite; Godaa oosuwa xeellite;</para>
  <para style="q2" vid="PSA 46:8">biitta waatidi dhaysidaako be7ite.<verse eid="PSA 46:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 46:9"/>I biitta bolla de7iya olaa ubbaa teqees;</para>
  <para style="q2" vid="PSA 46:9">dongenne toora menthees;</para>
  <para style="q2" vid="PSA 46:9">gondalliya<note caller="+" style="f"><char style="fr" closed="false">46:9 </char><char style="fqa" closed="false">Gondalliya: </char><char style="ft" closed="false">Ibraawetho doonan hare gaare geetetees.</char></note> taman xuuggees.<verse eid="PSA 46:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 46:10"/>Wopu giite; taani Xoosse gideysa erite;</para>
  <para style="q2" vid="PSA 46:10">taani kawotethata giddon dhoqu dhoqu gaana;</para>
  <para style="q2" vid="PSA 46:10">biitta bollaka dhoqu dhoqu gaana.<verse eid="PSA 46:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 46:11"/>Ubbaafe Wolqaama Goday nuura de7ees;</para>
  <para style="q2" vid="PSA 46:11">Yayqooba Xoossay nu qosetidi attiya besse. <char style="qs">Salaha. </char><verse eid="PSA 46:11"/></para>
  <chapter eid="PSA 46"/>
  <chapter number="47" style="c" sid="PSA 47"/>
  <para style="s1">Xoossay Sa7a Ubba Godaa</para>
  <para style="d">Qore Nayta Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 47:1"/>Dere ubbay hinte kushiya baqite;</para>
  <para style="q2" vid="PSA 47:1">qaala dhoqu oothidi Xoossaa galatite.<verse eid="PSA 47:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 47:2"/>Ubbaafe dhoqa Goday waani yashshii?</para>
  <para style="q2" vid="PSA 47:2">biitta ubban I gita kawo.<verse eid="PSA 47:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 47:3"/>Dereta nuupe garsara,</para>
  <para style="q2" vid="PSA 47:3">kawotethata nu tohuwape garsan haarisees.<verse eid="PSA 47:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 47:4"/>I nuus laata biitta dooris;</para>
  <para style="q2" vid="PSA 47:4">I dosiya Yayqoobi</para>
  <para style="q2" vid="PSA 47:4">he biittan ceeqetees. <char style="qs">Salaha. </char><verse eid="PSA 47:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 47:5"/>Xoossay ufaysaninne ililsan pude dendis,</para>
  <para style="q2" vid="PSA 47:5">Goday moyze punon ba araatan keyis.<verse eid="PSA 47:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 47:6"/>Xoossaas zammarit; ee, iyaw zammarit;</para>
  <para style="q2" vid="PSA 47:6">iyaw kawas zammarit; ee, iyaw zammarit.<verse eid="PSA 47:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 47:7"/>Xoossay biitta ubbaa kawo gidiya gisho,</para>
  <para style="q2" vid="PSA 47:7">galatan sabbite.<verse eid="PSA 47:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 47:8"/>Xoossay ba geeshsha araatan uttis,</para>
  <para style="q2" vid="PSA 47:8">Xoossay kawotethata haarees.<verse eid="PSA 47:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 47:9"/>Kawotethata halaqati,</para>
  <para style="q2" vid="PSA 47:9">Abrahaame Xoossaa asaara shiiqoosona.</para>
  <para style="q1" vid="PSA 47:9">Biittan de7iya wolqaama ubbay Xoossaba</para>
  <para style="q2" vid="PSA 47:9">gidiya gisho I ubbaafe dhoqu dhoqu gis.<verse eid="PSA 47:9"/></para>
  <chapter eid="PSA 47"/>
  <chapter number="48" style="c" sid="PSA 48"/>
  <para style="s1">Xiyooney Nu Xoossa Zuma</para>
  <para style="d">Qore Nayta Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 48:1"/>Goday gita; nu Xoossaa kataman</para>
  <para style="q2" vid="PSA 48:1">iya geeshsha zumaa bolla gita galati iyaw bessees.<verse eid="PSA 48:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 48:2"/>Biitta ubbaa ufaysi gidida,</para>
  <para style="q2" vid="PSA 48:2">pudeha baggara de7iya Xiyoone derey,</para>
  <para style="q2" vid="PSA 48:2">dhoqanne lo77o;</para>
  <para style="q2" vid="PSA 48:2">I gita kawa katama.<verse eid="PSA 48:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 48:3"/>Xoossay he gimbiya giddona;</para>
  <para style="q2" vid="PSA 48:3">ika iyaw geshe gideysa erisis.<verse eid="PSA 48:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 48:4"/>Kawoti banta tooranchotara shiiqidosona;</para>
  <para style="q2" vid="PSA 48:4">Xiyoone olanaw yidosona.<verse eid="PSA 48:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 48:5"/>Iya be7idi dagammidosona;</para>
  <para style="q2" vid="PSA 48:5">guye simmidi baqatidosona.<verse eid="PSA 48:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 48:6"/>Enti yan de7ishe yashshan kokoridosona;</para>
  <para style="q2" vid="PSA 48:6">iqethi oykida maccasada inxaxidosona.<verse eid="PSA 48:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 48:7"/>Doloha bagga wolqaama carkon</para>
  <para style="q2" vid="PSA 48:7">meqiya Tarsesa markabeta mela gididosona.<verse eid="PSA 48:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 48:8"/>Nu si7idaysada,</para>
  <para style="q2" vid="PSA 48:8">Ubbaafe Wolqaama Godaa kataman,</para>
  <para style="q2" vid="PSA 48:8">nu Xoossaa kataman I oothidaba be7ida;</para>
  <para style="q2" vid="PSA 48:8">Xoossay he katamaa merinaw minthidi naagees. <char style="qs">Salaha </char><verse eid="PSA 48:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 48:9"/>Abeeti Xoossaw, ne keethan</para>
  <para style="q2" vid="PSA 48:9">merinaa ne siiquwa qopoos.<verse eid="PSA 48:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 48:10"/>Abeeti Xoossaw, ne sunthada</para>
  <para style="q2" vid="PSA 48:10">ne galatay sa7aa gaxaa gakis;</para>
  <para style="q2" vid="PSA 48:10">ne ushacha kushey xillotethan kumidaysa.<verse eid="PSA 48:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 48:11"/>Ne pirdaa gaason Xiyoone asay ufayto;</para>
  <para style="q2" vid="PSA 48:11">Yihuda kumethay ufaysan ililo.<verse eid="PSA 48:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 48:12"/>Xiyoone yuushuwan hemetite;</para>
  <para style="q2" vid="PSA 48:12">I dirsa yuuyite; I shakota taybite.<verse eid="PSA 48:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 48:13"/>Yaa yeletas odana mela</para>
  <para style="q2" vid="PSA 48:13">iya gimbiya akeekite; miixata wochite.<verse eid="PSA 48:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 48:14"/>Hinte, “Merinaw Xoossay nu Xoossaa;</para>
  <para style="q2" vid="PSA 48:14">I nuna hayqana gakanaw kaalethana” yaagidi odite.<verse eid="PSA 48:14"/></para>
  <chapter eid="PSA 48"/>
  <chapter number="49" style="c" sid="PSA 49"/>
  <para style="s1">Meto Wodey Yashshenna</para>
  <para style="d">Qore Nayti Zammaareta Halaqaas Xaafida Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 49:1"/>Asa ubbay haysa si7ite;</para>
  <para style="q2" vid="PSA 49:1">biitta bolla de7eysato,</para>
  <para style="q2" vid="PSA 49:1">ubbay haysa hayzite.<verse eid="PSA 49:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 49:2"/>Dhoqay ziqay,</para>
  <para style="q2" vid="PSA 49:2">durey manqoy si7ite.<verse eid="PSA 49:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 49:3"/>Ta wozanaa qofay akeeka immees;</para>
  <para style="q2" vid="PSA 49:3">ta doonay cincatetha qaala odetees.<verse eid="PSA 49:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 49:4"/>Ta haythaa leemisoko zaarana;</para>
  <para style="q2" vid="PSA 49:4">diithi diixashe, ta qan7ishiya birshana.<verse eid="PSA 49:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 49:5"/>Meto gallasay yaa wodenne cimmiya morketi;</para>
  <para style="q2" vid="PSA 49:5">tana teqiya wode ta ayis babbayna?<verse eid="PSA 49:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 49:6"/>Banta shaluwan ammaneteysatanne</para>
  <para style="q2" vid="PSA 49:6">banta duretethan ceeqetiya</para>
  <para style="q2" vid="PSA 49:6">ta morketa ayis babbayna?<verse eid="PSA 49:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 49:7"/>Ay asika bana wozanaw,</para>
  <para style="q2" vid="PSA 49:7">woyko ba shempuwa gatiya</para>
  <para style="q2" vid="PSA 49:7">Xoossas qanxanaw danda7enna.<verse eid="PSA 49:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 49:8"/>Asa shempo gatey daro al7o;</para>
  <para style="q2" vid="PSA 49:8">Ay gate qanxinka gidenna.<verse eid="PSA 49:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 49:9"/>I hayqonnaadanne duufo gelonnaada,</para>
  <para style="q2" vid="PSA 49:9">woyko I hayqonnaada oothanaw gakenna.<verse eid="PSA 49:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 49:10"/>Eeyatinne pathonna asati hayqeysada,</para>
  <para style="q2" vid="PSA 49:10">cincati banta shaluwa</para>
  <para style="q2" vid="PSA 49:10">haratas yeggidi beysa asa ubbay be7ees.<verse eid="PSA 49:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 49:11"/>Enti banta biitta bantaba giikoka,</para>
  <para style="q2" vid="PSA 49:11">duufoy merinaw entaw keethe gidana.<verse eid="PSA 49:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 49:12"/>Asi ay gitatikoka ba gitatethaara kanthenna;</para>
  <para style="q2" vid="PSA 49:12">I do7ada hayqees.<verse eid="PSA 49:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 49:13"/>Bantarka banta huuphen ammaneteyisata qaadaynne</para>
  <para style="q2" vid="PSA 49:13">enti gidaba tuma giya eeyata wursethay haysa. <char style="qs">Salaha </char><verse eid="PSA 49:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 49:14"/>Shukas giigetida dorsatada,</para>
  <para style="q2" vid="PSA 49:14">hayqoy enta duufo kaalethees.</para>
  <para style="q1" vid="PSA 49:14">Suureti enta duufuwa bollara hemetana;</para>
  <para style="q2" vid="PSA 49:14">enta asatethay duufon wooqana;</para>
  <para style="q2" vid="PSA 49:14">keethafe keyidi haakidi si7oolen attana.<verse eid="PSA 49:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 49:15"/>Shin Xoossay ta shempuwa wozana;</para>
  <para style="q2" vid="PSA 49:15">I tana hayqo wolqafe ashshana. <char style="qs">Salaha </char><verse eid="PSA 49:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 49:16"/>Asi duretiya wodenne</para>
  <para style="q2" vid="PSA 49:16">iya bonchoy dariya wode yayyofa.<verse eid="PSA 49:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 49:17"/>I hayqiya wode aykoka ekidi beenna;</para>
  <para style="q2" vid="PSA 49:17">iya shaloy iyara issife duufo gelenna.<verse eid="PSA 49:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 49:18"/>Asi paxa de7iya wode taw kumis giiko,</para>
  <para style="q2" vid="PSA 49:18">ubbabay iyaw injetida gisho galatetikoka,<verse eid="PSA 49:18"/></para>
  <para style="q2">
    <verse number="19" style="v" sid="PSA 49:19"/>simmidi poo7o be7onna,</para>
  <para style="q2" vid="PSA 49:19">ba mayzatan gahetees.<verse eid="PSA 49:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 49:20"/>Eratethi bayna duretida asi</para>
  <para style="q2" vid="PSA 49:20">do7ada coo dhayana.<verse eid="PSA 49:20"/></para>
  <chapter eid="PSA 49"/>
  <chapter number="50" style="c" sid="PSA 50"/>
  <para style="s1">Xoossay Tuma Daynna</para>
  <para style="d">Asaafa Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 50:1"/>Wolqaama Goday, Xoossay odees;</para>
  <para style="q2" vid="PSA 50:1">dolohape wuloha gakanaw biitta ubbaa xeegees.<verse eid="PSA 50:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 50:2"/>Medhon polo yegelsi gidida</para>
  <para style="q2" vid="PSA 50:2">Xiyoonepe Xoossay poo7ees.<verse eid="PSA 50:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 50:3"/>Nu Xoossay yaana; si77i geenna;</para>
  <para style="q2" vid="PSA 50:3">eexiya tamay iya sinthana;</para>
  <para style="q2" vid="PSA 50:3">wolqaama gotey iya yuushuwana.<verse eid="PSA 50:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 50:4"/>Xoossay ba asaa pirdiya wode,</para>
  <para style="q2" vid="PSA 50:4">salotanne sa7aa xeegees.<verse eid="PSA 50:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 50:5"/>“Yarshon taara caaqida,</para>
  <para style="q2" vid="PSA 50:5">ta geeshshata taako shiishite” yaagis.<verse eid="PSA 50:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 50:6"/>Xoossay pirdiya gisho,</para>
  <para style="q2" vid="PSA 50:6">saloti iya xillotethaa awaajosona. <char style="qs">Salaha </char><verse eid="PSA 50:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 50:7"/>“Ta asaw, si7ite; ta hintew odayis;</para>
  <para style="q2" vid="PSA 50:7">Isra7eele asaw, ta ne bolla markatana;</para>
  <para style="q2" vid="PSA 50:7">taani Xoossay, ne Xoossaa.<verse eid="PSA 50:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 50:8"/>Ne yarshuwa gishonne</para>
  <para style="q2" vid="PSA 50:8">ne xuussa yarshuwa gisho,</para>
  <para style="q2" vid="PSA 50:8">nena borike.<verse eid="PSA 50:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 50:9"/>Ne daraape kormata,</para>
  <para style="q2" vid="PSA 50:9">ne girbiyafe kole ekanaw koyke.<verse eid="PSA 50:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 50:10"/>Woran de7iya do7ati ubbay tabaa;</para>
  <para style="q2" vid="PSA 50:10">mukulu zumaa bolla de7iya mehetika taassa.<verse eid="PSA 50:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 50:11"/>Taani dhoqa deriyan de7iya kafota ubbaa erayis;</para>
  <para style="q2" vid="PSA 50:11">denban de7iya medhetethati tayisata.<verse eid="PSA 50:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 50:12"/>Tana koshaykoka nena oychike;</para>
  <para style="q2" vid="PSA 50:12">sa7inne sa7an kumidaba ubbay tabaa.<verse eid="PSA 50:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 50:13"/>Taani kormata ashuwa maynayee?</para>
  <para style="q2" vid="PSA 50:13">woyko deeshata suuthaa uyanayee?<verse eid="PSA 50:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 50:14"/>Xoossas galata yarsho imma;</para>
  <para style="q2" vid="PSA 50:14">Ubbaafe dhoqa Xoossaas ne qangetha gatha.<verse eid="PSA 50:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 50:15"/>Meto gallas tana xeega;</para>
  <para style="q2" vid="PSA 50:15">ta nena ashshana; neka tana bonchana” yaagees.<verse eid="PSA 50:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 50:16"/>Shin Xoossay iita asaa haysada yaagees;</para>
  <para style="q2" vid="PSA 50:16">“Ta higgiya ne nabbabanaw new ay maati de7ii?</para>
  <para style="q2" vid="PSA 50:16">Woyko ta caaquwa ne doonan qoncisanaw new ay maati de7ii?<verse eid="PSA 50:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 50:17"/>Neeni ta timirtiya ixadasa;</para>
  <para style="q2" vid="PSA 50:17">ta qaala guye yeggadasa.<verse eid="PSA 50:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 50:18"/>Kaysuwa be7ida wode neeni iyara dabbotadasa;</para>
  <para style="q2" vid="PSA 50:18">laymateyisata maabaran geladasa.<verse eid="PSA 50:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 50:19"/>Ne doona iitabaa odetanaw billa yeddadasa;</para>
  <para style="q2" vid="PSA 50:19">Ne inxarsay wordo haasaya meezetis.<verse eid="PSA 50:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 50:20"/>Uttada ne ishaa zigiradasa;</para>
  <para style="q2" vid="PSA 50:20">ne aaye na7aa bolla iitaba odetadasa.<verse eid="PSA 50:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 50:21"/>Ne haysa ubbaa oothiya wode,</para>
  <para style="q2" vid="PSA 50:21">taani si77i gida gisho</para>
  <para style="q2" vid="PSA 50:21">tana ne mela gada qopadasa.</para>
  <para style="q2" vid="PSA 50:21">Shin ha77i ta nena hanqana;</para>
  <para style="q2" vid="PSA 50:21">ne nagaraa ne sinthan taybana.<verse eid="PSA 50:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 50:22"/>Hinteno, Xoossaa dogeysato, haysa akeekite;</para>
  <para style="q2" vid="PSA 50:22">hessi hanonna ixiko ta hintena mentherethana;</para>
  <para style="q2" vid="PSA 50:22">he wode hintena ashshanay baawa.<verse eid="PSA 50:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 50:23"/>Taw galata yarshey tana bonchees;</para>
  <para style="q2" vid="PSA 50:23">ba ogiya suurisida asas</para>
  <para style="q2" vid="PSA 50:23">taani Xoossaa atotetha bessaana” yaagees.<verse eid="PSA 50:23"/></para>
  <chapter eid="PSA 50"/>
  <chapter number="51" style="c" sid="PSA 51"/>
  <para style="s1">Taw Geeshsha Wozana Imma</para>
  <para style="d">Dawiti zammaareta halaqaas xaafida mazmure</para>
  <para style="d">Dawiti Barsaabera laymatida wode nabiya Naatani iyaw odi simmin Dawiti yexida mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 51:1"/>Abeeti Xoossaw, ne merinaa siiquwada tana maara;</para>
  <para style="q2" vid="PSA 51:1">ne qadheta daruwa mela ta nagaraa qucha.<verse eid="PSA 51:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 51:2"/>Ta iitatethaafe tana meecca;</para>
  <para style="q2" vid="PSA 51:2">ta nagaraape tana geeshsha.<verse eid="PSA 51:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 51:3"/>Taani ta qohuwa erayis;</para>
  <para style="q2" vid="PSA 51:3">ta nagaray ubba wode ta sinthana.<verse eid="PSA 51:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 51:4"/>Taani nena, ne xalaala qohas;</para>
  <para style="q2" vid="PSA 51:4">ne sinthan iitabaa oothas.</para>
  <para style="q1" vid="PSA 51:4">Hessa gisho, ne hanquwan ne like;</para>
  <para style="q2" vid="PSA 51:4">ne pirdanka ne xillo.<verse eid="PSA 51:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 51:5"/>Heko ta yeletiya wode nagarancho;</para>
  <para style="q2" vid="PSA 51:5">ta aaye ulon buroo attiya,</para>
  <para style="q2" vid="PSA 51:5">wodepe doomada taani nagarancho.<verse eid="PSA 51:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 51:6"/>Neeni asa wozanape tumatethi koyaasa;</para>
  <para style="q2" vid="PSA 51:6">ta gaatha asatethaa cincatethi tamaarsa.<verse eid="PSA 51:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 51:7"/>Hisoophe boncon tana wurxa; ta geeyana;</para>
  <para style="q2" vid="PSA 51:7">tana meecca; ta shachafe aadhada booxana.<verse eid="PSA 51:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 51:8"/>Ne tana ufaysinne lo77oba sissa;</para>
  <para style="q2" vid="PSA 51:8">ne mentherethida ta meqethaa zaarada ufaysa.<verse eid="PSA 51:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 51:9"/>Ne som7uwa ta nagaraape hara soo zaara;</para>
  <para style="q2" vid="PSA 51:9">ta bala ubbaa qucha.<verse eid="PSA 51:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 51:10"/>Abeeti Xoossaw, geeshsha wozana tanan medha;</para>
  <para style="q2" vid="PSA 51:10">qaaxonna ayyaana ta giddon ooratha.<verse eid="PSA 51:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 51:11"/>Tana ne sinthafe yeggofa;</para>
  <para style="q2" vid="PSA 51:11">ne Geeshsha Ayyaana taape ekofa.<verse eid="PSA 51:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 51:12"/>Ne atotetha ufaysaa taw zaara;</para>
  <para style="q2" vid="PSA 51:12">ta new kiitetana mela tana zempisa.<verse eid="PSA 51:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 51:13"/>Ta he wode higge mentheyisata ne ogiya tamaarsana;</para>
  <para style="q2" vid="PSA 51:13">nagaranchotika neeko simmana.<verse eid="PSA 51:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 51:14"/>Abeeti Xoossaw, tana ashshiya Xoossaw,</para>
  <para style="q2" vid="PSA 51:14">suuthu gussiya nagarape tana ashsha;</para>
  <para style="q2" vid="PSA 51:14">he wode ta inxarsay ne xillotetha yexana.<verse eid="PSA 51:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 51:15"/>Abeeti Godaw, ta doona dooya;</para>
  <para style="q2" vid="PSA 51:15">ta inxarsay ne galataa awaajana.<verse eid="PSA 51:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 51:16"/>Ne yarshon ufaytiyako, ta new yarshanashin,</para>
  <para style="q2" vid="PSA 51:16">ne xuussa yarshon ufaytaka.<verse eid="PSA 51:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 51:17"/>Xoossaa yarshoy aada ayyaana;</para>
  <para style="q2" vid="PSA 51:17">Xoossaw, ne meqidanne</para>
  <para style="q2" vid="PSA 51:17">kawuyida wozanaa kadhaka.<verse eid="PSA 51:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 51:18"/>Abeeti Xoossaw, dosan Xiyoones keeha;</para>
  <para style="q2" vid="PSA 51:18">Yerusalaame gimbeta gimba.<verse eid="PSA 51:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 51:19"/>He wode ne xillotetha yarshoninne</para>
  <para style="q2" vid="PSA 51:19">xuussa yarshon ufaytana.</para>
  <para style="q1" vid="PSA 51:19">pollo shiqiaya mehe yarshon ne ufaytana;</para>
  <para style="q2" vid="PSA 51:19">kormati ne yarsho bessan yarishetana.<verse eid="PSA 51:19"/></para>
  <chapter eid="PSA 51"/>
  <chapter number="52" style="c" sid="PSA 52"/>
  <para style="s1">Xoossa Siiqoy Merinaasa</para>
  <para style="d">Dawiti Zammaareta Halaqaas Akeekan xaafida Ginxo</para>
  <para style="d">Edoome biitta asi gidida Doyqi Saa7olako bidi, “Dawiti Abimeleke soo bis” yaagidi odi simmin, Dawiti xaafida mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 52:1"/>Neno, wolqaama uraw, iitatethan ayis otortay?</para>
  <para style="q2" vid="PSA 52:1">neno Xoossan kadhetidayso ubba wode ayis ceeqetay?<verse eid="PSA 52:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 52:2"/>Neno, wordo odeteyso,</para>
  <para style="q2" vid="PSA 52:2">ne harata dhaysanaw maqetaasa;</para>
  <para style="q2" vid="PSA 52:2">ne inxarsay qara maqla mela.<verse eid="PSA 52:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 52:3"/>Ne lo77o aggada iita dosaasa;</para>
  <para style="q2" vid="PSA 52:3">tuma aggada wordo odetaasa. <char style="qs">Salaha </char><verse eid="PSA 52:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 52:4"/>Neno, wordanchuwaw,</para>
  <para style="q2" vid="PSA 52:4">ne bosha qaala ubbaa dosaasa.<verse eid="PSA 52:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 52:5"/>Xoossay nena merinaw menthana;</para>
  <para style="q2" vid="PSA 52:5">Xoossay nena mentherethananne ne keethaafe dafidi kessana;</para>
  <para style="q2" vid="PSA 52:5">nena de7on de7eyisata giddofe shoddidi yeggana. <char style="qs">Salaha </char><verse eid="PSA 52:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 52:6"/>Xilloti hessa be7idi yayyana;</para>
  <para style="q2" vid="PSA 52:6">enti haysada yaagidi, ne bolla miicana;<verse eid="PSA 52:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 52:7"/>“Xoossaa baw geshe oothiboonna,</para>
  <para style="q2" vid="PSA 52:7">ba duretethan ammanetida,</para>
  <para style="q2" vid="PSA 52:7">iita ooson minnida,</para>
  <para style="q2" vid="PSA 52:7">addiya haysa be7ite” yaagana.<verse eid="PSA 52:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 52:8"/>Shin taani Xoossaa keethan aaciya shamaho mela;</para>
  <para style="q2" vid="PSA 52:8">iya siiquwan taani merinaw ammanetayis.<verse eid="PSA 52:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 52:9"/>Ne oothida gisho merinaw ta nena galatana;</para>
  <para style="q2" vid="PSA 52:9">neeni lo77o gidiya gisho ne sunthan ufaysi oothana;</para>
  <para style="q2" vid="PSA 52:9">geeshshata sinthan ta nena sabbana.<verse eid="PSA 52:9"/></para>
  <chapter eid="PSA 52"/>
  <chapter number="53" style="c" sid="PSA 53"/>
  <para style="s1">Lo77o Oothiya Asi Baawa</para>
  <para style="d">Dawiti Zammaareta Halaqaas Xaafida Timirte</para>
  <para style="d">Akeekan xaafetida ginxo</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 53:1"/>Eeyati banta wozanan, “Xoossi baawa” yaagosona;</para>
  <para style="q2" vid="PSA 53:1">enta de7oy iitis; enti tunabaa oothosona;</para>
  <para style="q2" vid="PSA 53:1">lo77oba oothiya asi issoyka baawa.<verse eid="PSA 53:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 53:2"/>Xoossaa koyiya cinca asi de7iyako be7anaw,</para>
  <para style="q2" vid="PSA 53:2">Goday salope asaa xeellees.<verse eid="PSA 53:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 53:3"/>Enti ubbay Xoossaafe haakidosona;</para>
  <para style="q2" vid="PSA 53:3">ubbay issife tunidosona.</para>
  <para style="q1" vid="PSA 53:3">Lo77o oothiya asi deenna;</para>
  <para style="q2" vid="PSA 53:3">hari attoshin issi asika baawa.<verse eid="PSA 53:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 53:4"/>Asi kathi meysada ta asaa meysati,</para>
  <para style="q2" vid="PSA 53:4">ha iita oothiya asati erokona?</para>
  <para style="q2" vid="PSA 53:4">enti Xoossaa xeegokona?<verse eid="PSA 53:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 53:5"/>Enti dagammi eronna dagama dagammana;</para>
  <para style="q2" vid="PSA 53:5">Xoossay ba asaa morketa meqethaa laallana;</para>
  <para style="q2" vid="PSA 53:5">Xoossay enta kadhida gisho enti yeellatana.<verse eid="PSA 53:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 53:6"/>Isra7eele atotethay Xiyoonepe yeerenne!</para>
  <para style="q2" vid="PSA 53:6">Xoossay ba asaa di7uwa zaariya wode,</para>
  <para style="q1" vid="PSA 53:6">Yayqooba zareti ufayto;</para>
  <para style="q2" vid="PSA 53:6">Isra7eele asay ufaysan hashshu go.<verse eid="PSA 53:6"/></para>
  <chapter eid="PSA 53"/>
  <chapter number="54" style="c" sid="PSA 54"/>
  <para style="s1">Xoossay Ta Shempuwa Naagees</para>
  <para style="d">Dawiti Zammaareta Halaqaas Diithan Yexida Akeeka Ginxo</para>
  <para style="d">Ziifa asati Saa7olako bidi, “Dawiti nu biittan qosetis” yaagidi odin, Dawiti xaafida mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 54:1"/>Abeeti Xoossaw, ne sunthan tana ashsha;</para>
  <para style="q2" vid="PSA 54:1">ne wolqan taw pirda.<verse eid="PSA 54:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 54:2"/>Abeeti Xoossaw, ta woosa si7a;</para>
  <para style="q2" vid="PSA 54:2">ta doona qaala hayza.<verse eid="PSA 54:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 54:3"/>Allaga asati ta bolla dendidosona;</para>
  <para style="q2" vid="PSA 54:3">daganthiya asati tana wodhanaw koyoosona;</para>
  <para style="q2" vid="PSA 54:3">enti Xoossaa qopokona. <char style="qs">Salaha </char><verse eid="PSA 54:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 54:4"/>Xoossay taw maade;</para>
  <para style="q2" vid="PSA 54:4">Goday taw zempo.<verse eid="PSA 54:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 54:5"/>Abeeti Xoossaw, ta morketa iitatethaa enta bolla zaara;</para>
  <para style="q2" vid="PSA 54:5">ne tumatethaa gisho enta dhaysa.<verse eid="PSA 54:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 54:6"/>Abeeti Godaw, taani ta dosan new yarshana;</para>
  <para style="q2" vid="PSA 54:6">ne keeha gidiya gisho ne sunthaa galatana.<verse eid="PSA 54:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 54:7"/>Ne tana, ta meto ubbaafe ashshadasa;</para>
  <para style="q2" vid="PSA 54:7">ta morketa xoonetethaa ta ayfen be7as.<verse eid="PSA 54:7"/></para>
  <chapter eid="PSA 54"/>
  <chapter number="55" style="c" sid="PSA 55"/>
  <para style="s1">Ne Toohuwa Xoossa Bolla Yegga</para>
  <para style="d">Dawiti Zammaareta Halaqaas Diithan Yexida Akeeka Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 55:1"/>Abeeti Xoossaw, ta woosa si7a;</para>
  <para style="q2" vid="PSA 55:1">ta magannuwa qelli goopa.<verse eid="PSA 55:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 55:2"/>Tana si7a; ta woosaas zaaro imma;</para>
  <para style="q2" vid="PSA 55:2">ta qofay tana waaysin, ta un7etas.<verse eid="PSA 55:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 55:3"/>Ta morketa girsa si7ada dagammas;</para>
  <para style="q2" vid="PSA 55:3">iitata mandiya gaason kokoras.</para>
  <para style="q1" vid="PSA 55:3">Enti ta bolla meto ehoosona;</para>
  <para style="q2" vid="PSA 55:3">yilon dendidi tana morkoosona.<verse eid="PSA 55:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 55:4"/>Ta wozanay dirgees;</para>
  <para style="q2" vid="PSA 55:4">hayqo hirgay tana wodhees.<verse eid="PSA 55:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 55:5"/>Tana yashshinne kokorsi oykis;</para>
  <para style="q2" vid="PSA 55:5">iita dagami ta bolla wodhis.<verse eid="PSA 55:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 55:6"/>Holleda taw qefey de7iyako,</para>
  <para style="q2" vid="PSA 55:6">paallada shempoy de7iya bessi gakanashin.<verse eid="PSA 55:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 55:7"/>Taani haakada baanashin;</para>
  <para style="q2" vid="PSA 55:7">bazzon aqanashin. <char style="qs">Salaha </char><verse eid="PSA 55:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 55:8"/>Taani gotepenne carkofe baqatada,</para>
  <para style="q2" vid="PSA 55:8">ta qosetiya bessi demmanashin.<verse eid="PSA 55:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 55:9"/>Abeeti Godaw, katamaa giddon</para>
  <para style="q2" vid="PSA 55:9">ooshshinne gene be7ida gisho</para>
  <para style="q2" vid="PSA 55:9">iitata odaa laalla.<verse eid="PSA 55:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 55:10"/>Iitati gallasinne qamma</para>
  <para style="q2" vid="PSA 55:10">katamaa gimbe dirsaa yuuyosona;</para>
  <para style="q2" vid="PSA 55:10">waayeynne metoy katamaa giddon de7ees.<verse eid="PSA 55:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 55:11"/>Dhayoy iya giddon de7ees;</para>
  <para style="q2" vid="PSA 55:11">naaqoynne cimoy iya dabaabape shaaketenna.<verse eid="PSA 55:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 55:12"/>Tana cayey ta morkiya gidenna;</para>
  <para style="q2" vid="PSA 55:12">iya gidiyako ta danda7anashin.</para>
  <para style="q1" vid="PSA 55:12">Ta bolla ceeqetey tana ixeysa gidenna;</para>
  <para style="q2" vid="PSA 55:12">iya gidiyako ta iyape qosetanashin.<verse eid="PSA 55:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 55:13"/>Shin hessa oothey nena,</para>
  <para style="q2" vid="PSA 55:13">ta laggiya; ta dabbuwanne ta siiquwa.<verse eid="PSA 55:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 55:14"/>Nu issoy issuwara ulo oda odetida;</para>
  <para style="q2" vid="PSA 55:14">Xoossa keethan dabaaban asaara issife simeretida.<verse eid="PSA 55:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 55:15"/>Enta wozanan iitatethi de7iya gisho,</para>
  <para style="q2" vid="PSA 55:15">ta morketi qoponna hayqo;</para>
  <para style="q2" vid="PSA 55:15">enti paxa de7ishe duufo gelo.<verse eid="PSA 55:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 55:16"/>Shin taani Xoossaa xeegana;</para>
  <para style="q2" vid="PSA 55:16">Goday tana ashshana.<verse eid="PSA 55:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 55:17"/>Wonta, gallasinne omarsi waassana;</para>
  <para style="q2" vid="PSA 55:17">ta metuwa iyaw odana; I tana si7ana.<verse eid="PSA 55:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 55:18"/>Daroti tana morkikoka,</para>
  <para style="q2" vid="PSA 55:18">I tana toorape ashshees.<verse eid="PSA 55:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 55:19"/>Benipe ba araatan uttida Xoossay,</para>
  <para style="q2" vid="PSA 55:19">banta ogiya laammonna gishonne</para>
  <para style="q2" vid="PSA 55:19">iyaw yayyonna gisho tana si7idi enta kawushana. <char style="qs">Salaha </char><verse eid="PSA 55:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 55:20"/>Ta laggey ba dabbota qohis;</para>
  <para style="q2" vid="PSA 55:20">entara caaqida caaquwa menthis.<verse eid="PSA 55:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 55:21"/>Iya doonay oysape liiqo;</para>
  <para style="q2" vid="PSA 55:21">shin ba wozanan ola denthees.</para>
  <para style="q1" vid="PSA 55:21">Iya inxarsay zaytepe aadhida shugo;</para>
  <para style="q2" vid="PSA 55:21">shin qanxanaw giigida qara mashsha mela.<verse eid="PSA 55:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 55:22"/>Ne toohuwa Xoossa bolla yegga;</para>
  <para style="q2" vid="PSA 55:22">I nena katisana.</para>
  <para style="q1" vid="PSA 55:22">Xoossay xilloti,</para>
  <para style="q2" vid="PSA 55:22">dagammana mela oothenna.<verse eid="PSA 55:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 55:23"/>Shin Abeeti Xoossaw,</para>
  <para style="q2" vid="PSA 55:23">iita asata wolqaama ollan holana.</para>
  <para style="q1" vid="PSA 55:23">Suuthu gusseysatinne cimmeysati,</para>
  <para style="q2" vid="PSA 55:23">banta laythaafe baggaaka de7okona;</para>
  <para style="q2" vid="PSA 55:23">shin taani nenan ammanetana.<verse eid="PSA 55:23"/></para>
  <chapter eid="PSA 55"/>
  <chapter number="56" style="c" sid="PSA 56"/>
  <para style="s1">Xoossa Bolla Zempa</para>
  <para style="d">Filisxeeme Asay Geete Kataman Dawita Oykida Wode Dawiti Zammaareta Halaqaas Xaafida Woosa.</para>
  <para style="d">“Haaho bessan wola bolla uttida hollees” geetetiya diitha cuudhethan yexetida woosa.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 56:1"/>Abeeti Xoossaw, asay tana un7ethiya gishonne</para>
  <para style="q2" vid="PSA 56:1">ubba wode ta morketi tana yedethiya gisho taw qadheta.<verse eid="PSA 56:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 56:2"/>Ta morketi kumetha gallas tana yedhoosona;</para>
  <para style="q2" vid="PSA 56:2">otoron tana oliya asay daro.<verse eid="PSA 56:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 56:3"/>Tana yashshiya wode</para>
  <para style="q2" vid="PSA 56:3">ta nenan ammanetayis.<verse eid="PSA 56:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 56:4"/>Taani Xoossan ammanetayis; yayyike;</para>
  <para style="q2" vid="PSA 56:4">iya qaala galatiya Xoossan ammanetayis;</para>
  <para style="q2" vid="PSA 56:4">asi tana ay oothanee?<verse eid="PSA 56:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 56:5"/>Kumetha gallasan ta morketi bala koyoosona;</para>
  <para style="q2" vid="PSA 56:5">tana qohanaw ubba wode tobboosona.<verse eid="PSA 56:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 56:6"/>Enti ta bolla maqetoosona;</para>
  <para style="q2" vid="PSA 56:6">tana qohanaw geeddosona.</para>
  <para style="q1" vid="PSA 56:6">Ta tango ubba kaalloosona;</para>
  <para style="q2" vid="PSA 56:6">tana wodhanaw koyoosona.<verse eid="PSA 56:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 56:7"/>Enti ay ogeraka kessi ekana mela oothofa;</para>
  <para style="q2" vid="PSA 56:7">ne hanquwan he kawotethata kawusha.<verse eid="PSA 56:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 56:8"/>Ta waayiya tayba;</para>
  <para style="q2" vid="PSA 56:8">ne ta afuthaa makadasa;</para>
  <para style="q2" vid="PSA 56:8">enti ne mazgabiyan de7okona?<verse eid="PSA 56:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 56:9"/>Ta nena xeegiya wode,</para>
  <para style="q2" vid="PSA 56:9">ta morketi guye simmana;</para>
  <para style="q2" vid="PSA 56:9">Xoossay ta bagga gideysa ta hessan erayis.<verse eid="PSA 56:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 56:10"/>Ta iya qaala galatiya Xoossan,</para>
  <para style="q2" vid="PSA 56:10">ta iya qaala galatiya Godan,<verse eid="PSA 56:10"/></para>
  <para style="q2">
    <verse number="11" style="v" sid="PSA 56:11"/>ta he Xoossan ammanetayis; yayyike.</para>
  <para style="q2" vid="PSA 56:11">asi tana ay oothannee?<verse eid="PSA 56:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 56:12"/>Abeeti Xoossaw ta new qangidabay de7ees;</para>
  <para style="q2" vid="PSA 56:12">hessa galataa yarsho oothada ta new immana.<verse eid="PSA 56:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 56:13"/>De7on de7eyisata bolla poo7iya poo7uwan</para>
  <para style="q2" vid="PSA 56:13">Xoossaa sinthan simeretana mela,</para>
  <para style="q2" vid="PSA 56:13">ta shempuwa hayqope,</para>
  <para style="q2" vid="PSA 56:13">ta tohuwa dhubepe ashshadasa.<verse eid="PSA 56:13"/></para>
  <chapter eid="PSA 56"/>
  <chapter number="57" style="c" sid="PSA 57"/>
  <para style="s1">Ne Bonchoy Sa7a Ubban Gido</para>
  <para style="d">Dawiti Saa7olape baqatidi Gongolon Qosetida Wode Zammaareta Halaqaas Xaafida Woosa</para>
  <para style="d">“Dhaysofa” geetetiya diitha cuudhethan yexetida woosa.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 57:1"/>Tana maara; abeeti Xoossaw,</para>
  <para style="q2" vid="PSA 57:1">tana maara; ta neeko baqatayis.</para>
  <para style="q1" vid="PSA 57:1">Dhayoy aadhana gakanaw,</para>
  <para style="q2" vid="PSA 57:1">ne qefiya garsan qosetayis.<verse eid="PSA 57:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 57:2"/>Taani Ubbaafe dhoqa Xoossako,</para>
  <para style="q2" vid="PSA 57:2">ba qofaatho oothiya Xoossako waassayis.<verse eid="PSA 57:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 57:3"/>Xoossay salope maado kiittidi tana ashshana;</para>
  <para style="q2" vid="PSA 57:3">tana yedheyisata kawushana;</para>
  <para style="q1" vid="PSA 57:3">Xoossay ba siiquwanne</para>
  <para style="q2" vid="PSA 57:3">ba ammanetetha taw kiittana. <char style="qs">Salaha </char><verse eid="PSA 57:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 57:4"/>Taani ta morketape giddon,</para>
  <para style="q2" vid="PSA 57:4">ase miya gaammotape giddon de7ayis.</para>
  <para style="q1" vid="PSA 57:4">Enta achay tooranne donge toora mela;</para>
  <para style="q2" vid="PSA 57:4">enta inxarsay qara mashsha mela.<verse eid="PSA 57:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 57:5"/>Abeeti Xoossaw, ne salope aadhada dhoqu dhoqu ga;</para>
  <para style="q2" vid="PSA 57:5">ne bonchoy sa7a ubbaa kammo.<verse eid="PSA 57:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 57:6"/>Enti ta tohuwas xihe wothidosona;</para>
  <para style="q2" vid="PSA 57:6">taani un7etada hokas.</para>
  <para style="q1" vid="PSA 57:6">Enti ta ogiyan olla bookidosona;</para>
  <para style="q2" vid="PSA 57:6">shin he ollan bantaw kundidosona. <char style="qs">Salaha </char><verse eid="PSA 57:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 57:7"/>Ta wozanay mino;</para>
  <para style="q2" vid="PSA 57:7">abeeti Xoossaw, ta wozanay mino;</para>
  <para style="q2" vid="PSA 57:7">taani nena mazmuren sabbana.<verse eid="PSA 57:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 57:8"/>Ta shempe, barka;</para>
  <para style="q2" vid="PSA 57:8">diithinne maasinqoy dendite;</para>
  <para style="q2" vid="PSA 57:8">taani guura barkana.<verse eid="PSA 57:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 57:9"/>Abeeti Godaw, ta nena asaa giddon galatana;</para>
  <para style="q2" vid="PSA 57:9">kawotethata giddon nena sabbana.<verse eid="PSA 57:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 57:10"/>Ne siiqoy salotape dhoqa;</para>
  <para style="q2" vid="PSA 57:10">ne ammanetethay shaarape bolla.<verse eid="PSA 57:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 57:11"/>Abeeti Xoossaw, ne salope aadhada dhoqu dhoqu ga;</para>
  <para style="q2" vid="PSA 57:11">ne bonchoy sa7a ubbaa kammo.<verse eid="PSA 57:11"/></para>
  <chapter eid="PSA 57"/>
  <chapter number="58" style="c" sid="PSA 58"/>
  <para style="s1">Xoossay Sa7a Ubba Pirdana</para>
  <para style="d">Dawiti Zammaareta Halaqaas Xaafida Woosa</para>
  <para style="d">“Dhaysofa” geetetiya diitha cuudhethan yexetida woosa.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 58:1"/>Deriya haareysato, tuma hinte like odeteetii?</para>
  <para style="q2" vid="PSA 58:1">Asa ubbaas xillo pirdeetii?<verse eid="PSA 58:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 58:2"/>Gidenna, hinte wozanan iitabaa halcheeta;</para>
  <para style="q2" vid="PSA 58:2">hinte kushey biitta bolla geellaba oothees.<verse eid="PSA 58:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 58:3"/>Iita asi aaye ulope doomidi halees;</para>
  <para style="q2" vid="PSA 58:3">yeletida gallasape doomidi,</para>
  <para style="q2" vid="PSA 58:3">baleesinne wordo odetees.<verse eid="PSA 58:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 58:4"/>Enti shooshada yiishshara de7oosona;</para>
  <para style="q2" vid="PSA 58:4">enti tulle gopeda si7okona.<verse eid="PSA 58:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 58:5"/>Biteysi ay cinca gidikoka,</para>
  <para style="q2" vid="PSA 58:5">Gopey iya xeessi si7enna.<verse eid="PSA 58:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 58:6"/>Abeeti Xoossaw, gaammo achi daaniya enta achaa mentha;</para>
  <para style="q2" vid="PSA 58:6">Godaw enta sakiliya dhuka.<verse eid="PSA 58:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 58:7"/>Enti gukida haathi gido;</para>
  <para style="q2" vid="PSA 58:7">banta dongiya dukiya wode,</para>
  <para style="q2" vid="PSA 58:7">donge toora ayfey dhayo.<verse eid="PSA 58:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 58:8"/>Enti maaydi dhayiya dhaadhe saassoda hano;</para>
  <para style="q2" vid="PSA 58:8">aaye ulope hayqidi wodhiya,</para>
  <para style="q2" vid="PSA 58:8">awa poo7o be7onna boshada hano.<verse eid="PSA 58:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 58:9"/>Enti agunthi gididi daayanape kase,</para>
  <para style="q2" vid="PSA 58:9">enti buroo puuto gididi de7ishin,</para>
  <para style="q2" vid="PSA 58:9">enta ba hanquwan dhaysana.<verse eid="PSA 58:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 58:10"/>Nagaranchota bolla halo keyiya wode xilloti ufaytana;</para>
  <para style="q2" vid="PSA 58:10">iitata suuthan banta tohuwa meecetana.<verse eid="PSA 58:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 58:11"/>He wode asay,</para>
  <para style="q2" vid="PSA 58:11">“Tuma xillotas woytoy de7ees;</para>
  <para style="q2" vid="PSA 58:11">sa7a bolla pirdiya Xoossi de7ees” yaagana.<verse eid="PSA 58:11"/></para>
  <chapter eid="PSA 58"/>
  <chapter number="59" style="c" sid="PSA 59"/>
  <para style="s1">Xoossaw Tana Ta Morketape Ashsha</para>
  <para style="d">Dawita wodhanaw iya keetha naagana mela Saa7oli ase kiittin, Dawiti zammaareta halaqaas xaafida woosa</para>
  <para style="d">“Dhaysofa” geetetiya diitha cuudhethan yexetida woosa.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 59:1"/>Abeeti ta Xoossaw, ta morketape tana ashsha;</para>
  <para style="q2" vid="PSA 59:1">ta bolla dendeysatape tana naaga.<verse eid="PSA 59:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 59:2"/>Iita ootheysatape tana ashsha;</para>
  <para style="q2" vid="PSA 59:2">suuthu gussiya asatape tana ashsha.<verse eid="PSA 59:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 59:3"/>Abeeti Godaw, enti tana wodhanaw</para>
  <para style="q2" vid="PSA 59:3">zugidi naageysa be7a.</para>
  <para style="q1" vid="PSA 59:3">Abeeti Godaw, ta naaquwa gisho</para>
  <para style="q2" vid="PSA 59:3">woyko ta nagaraa gisho</para>
  <para style="q2" vid="PSA 59:3">gidonashin coo ta bolla tobboosona.<verse eid="PSA 59:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 59:4"/>Ta ay balaka oothonna tana qohanaw giigidosona;</para>
  <para style="q2" vid="PSA 59:4">hessa be7a; tana maaddanaw denda.<verse eid="PSA 59:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 59:5"/>Abeeti Ubbaafe Wolqaama Xoossaw, Godaw,</para>
  <para style="q2" vid="PSA 59:5">Isra7eele Xoossaw, kawotethata ubbaa pirdanaw barka;</para>
  <para style="q2" vid="PSA 59:5">iita ootheyisata maaropa. <char style="qs">Salaha </char><verse eid="PSA 59:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 59:6"/>Enti katamaa giddon yuuyishe pee7idi,</para>
  <para style="q2" vid="PSA 59:6">kanatho laawishe simmoosona.<verse eid="PSA 59:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 59:7"/>Enta doonape keyeysa be7a;</para>
  <para style="q2" vid="PSA 59:7">enta inxarsay mashsha mela;</para>
  <para style="q2" vid="PSA 59:7">asi entana si7eysa qopokona.<verse eid="PSA 59:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 59:8"/>Shin abeeti Godaw, ne enta bolla miicaasa;</para>
  <para style="q2" vid="PSA 59:8">kawotethata ubbaa leqisaasa.<verse eid="PSA 59:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 59:9"/>Xoossaw, ne ta miixaa gidiya gisho,</para>
  <para style="q2" vid="PSA 59:9">ta ne wolqan ammanetayis.<verse eid="PSA 59:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 59:10"/>Ta Xoossay ba siiquwan taako yaana;</para>
  <para style="q2" vid="PSA 59:10">ta Xoossay ta morketa xoonetethaa tana bessaana.<verse eid="PSA 59:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 59:11"/>Ta asati dogonna mela ne enta wodhopa.</para>
  <para style="q2" vid="PSA 59:11">Abeeti Godaw, nu gondalliyaw,</para>
  <para style="q2" vid="PSA 59:11">ne wolqan enta laallanne kawusha.<verse eid="PSA 59:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 59:12"/>Enta doonape keyiya nagaraa gisho</para>
  <para style="q2" vid="PSA 59:12">enta inxarsaafe pultiya qaala gisho,</para>
  <para style="q2" vid="PSA 59:12">banta otoruwan oyketo;</para>
  <para style="q2" vid="PSA 59:12">enta baadethanne worduwa gisho,<verse eid="PSA 59:12"/></para>
  <para style="q2">
    <verse number="13" style="v" sid="PSA 59:13"/>ne hanquwan enta dhaysa;</para>
  <para style="q2" vid="PSA 59:13">enta kumethi digga.</para>
  <para style="q1" vid="PSA 59:13">Hessan Xoossay Yayqooba zeretha haareysanne</para>
  <para style="q2" vid="PSA 59:13">sa7aa gaxaa gakanaw haareysi eretana. <char style="qs">Salaha </char><verse eid="PSA 59:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 59:14"/>Enti katamaa giddon yuuyishe pee7idi,</para>
  <para style="q2" vid="PSA 59:14">kanatho laawishe simmoosona.<verse eid="PSA 59:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 59:15"/>Enti miyaba demmanaw toylatoosona;</para>
  <para style="q2" vid="PSA 59:15">kallona attida laawiya kana gidoosona.<verse eid="PSA 59:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 59:16"/>Shin taani ne wolqaa sabbana;</para>
  <para style="q2" vid="PSA 59:16">wonta ne siiquwa yexana.</para>
  <para style="q1" vid="PSA 59:16">Neeni taw ta waayiya gallas,</para>
  <para style="q2" vid="PSA 59:16">ta baqata attiya bessenne miixa.<verse eid="PSA 59:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 59:17"/>Abeeti taw wolqa gidida Xoossaw,</para>
  <para style="q2" vid="PSA 59:17">ta nena sabbana.</para>
  <para style="q1" vid="PSA 59:17">Ta qosetada attiya bessaynne</para>
  <para style="q2" vid="PSA 59:17">siiquwa tana bessiya Xoossay nena.<verse eid="PSA 59:17"/></para>
  <chapter eid="PSA 59"/>
  <chapter number="60" style="c" sid="PSA 60"/>
  <para style="s1">Nu Morketape Nuna Ashsha</para>
  <para style="d">Masephexoomeninne Soobalan de7ida Araame asaara oletida wodenne Iyo7aabi guye simmidi Maxine zangaaran tammanne nam7u mukulu Edoome asaa wodhida wode Dawiti zammaareta halaqaas xaafida woosa</para>
  <para style="d">“Ciishsha cuudhethe” geetetiya markatetha woosa.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 60:1"/>Abeeti Xoossaw, ne nuna aggadasa;</para>
  <para style="q2" vid="PSA 60:1">nuna mentherthadasa.</para>
  <para style="q1" vid="PSA 60:1">Ne nuna hanqetadasa;</para>
  <para style="q2" vid="PSA 60:1">shin ha77i nuna zaara; mintha essa.<verse eid="PSA 60:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 60:2"/>Ne biitta qaathadasanne za7isadasa;</para>
  <para style="q2" vid="PSA 60:2">biittay kokoriya gisho, ne iya za7uwa kuntha.<verse eid="PSA 60:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 60:3"/>Neeni ne asaa meto bessadasa;</para>
  <para style="q2" vid="PSA 60:3">nuna gandigarsiya woyne ushshadasa.<verse eid="PSA 60:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 60:4"/>New yayyeysati banta morke dongefe</para>
  <para style="q2" vid="PSA 60:4">attana mela malla immadasa. <char style="qs">Salaha </char><verse eid="PSA 60:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 60:5"/>Ne siiqeysati attana mela,</para>
  <para style="q2" vid="PSA 60:5">ne ushacha kushen</para>
  <para style="q2" vid="PSA 60:5">nuna ashsha; nuna alla.<verse eid="PSA 60:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 60:6"/>Xoossay ba geeshsha bessan haysada yaagis;</para>
  <para style="q2" vid="PSA 60:6">“Taani xoonada Seekema biitta shaakana;</para>
  <para style="q2" vid="PSA 60:6">Sukota zangaara wadhana.<verse eid="PSA 60:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 60:7"/>Galadi tabaa; Minaaseyka taassa;</para>
  <para style="q2" vid="PSA 60:7">Efreemey ta huuphe ashshiya birata qoobe;</para>
  <para style="q2" vid="PSA 60:7">Yihudi ta kawota xam7aa.<verse eid="PSA 60:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 60:8"/>Moo7abey ta meecetiya kere;</para>
  <para style="q2" vid="PSA 60:8">Edoomey tabaa gideysa erisanaw,</para>
  <para style="q2" vid="PSA 60:8">ta caammaa iya bolla wothayis;</para>
  <para style="q2" vid="PSA 60:8">taani Filisxeeme xoonada gereerayis” yaagis.<verse eid="PSA 60:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 60:9"/>Gimbetida katamaako tana oone efanay?</para>
  <para style="q2" vid="PSA 60:9">Edoome gakanaw tana oone kaalethanay?<verse eid="PSA 60:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 60:10"/>Abeeti Xoossaw, nuna aggiday nena gidikii?</para>
  <para style="q2" vid="PSA 60:10">Abeeti Xoossaw neeni nu olanchotara olas keyaka.<verse eid="PSA 60:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 60:11"/>Asa maadoy pathonna gisho,</para>
  <para style="q2" vid="PSA 60:11">morketara oletanaw ne nuna maadda.<verse eid="PSA 60:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 60:12"/>Xoossaa wolqan nu morketa xoonana;</para>
  <para style="q2" vid="PSA 60:12">I nu morketa yedhana.<verse eid="PSA 60:12"/></para>
  <chapter eid="PSA 60"/>
  <chapter number="61" style="c" sid="PSA 61"/>
  <para style="s1">Xoossaw Tana Zaallako Kaaletha</para>
  <para style="d">Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 61:1"/>Abeeti Xoossaw, ne ta woosa si7a;</para>
  <para style="q2" vid="PSA 61:1">ta woosa hayza.<verse eid="PSA 61:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 61:2"/>Taani biitta gaxan de7ishin,</para>
  <para style="q2" vid="PSA 61:2">ta wozanay ufaysi qanxida wode,</para>
  <para style="q2" vid="PSA 61:2">ta nena xeegayis.</para>
  <para style="q1" vid="PSA 61:2">Taape dhoqa zaallako,</para>
  <para style="q2" vid="PSA 61:2">tana kaaletha.<verse eid="PSA 61:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 61:3"/>Ne taw qotanne</para>
  <para style="q2" vid="PSA 61:3">ta morketape naagetiya mino miixa.<verse eid="PSA 61:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 61:4"/>Taani ne dunkaaniyan merinaw darkinaashin!</para>
  <para style="q2" vid="PSA 61:4">Taani ne qefiya hapha garsan saro attarkinaashin! <char style="qs">Salaha </char><verse eid="PSA 61:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 61:5"/>Abeeti Xoossaw, ne ta qangetha si7adasa;</para>
  <para style="q2" vid="PSA 61:5">ne suntha yayyeysatara issife taw laata immadasa.<verse eid="PSA 61:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 61:6"/>Kawa laytha adussa;</para>
  <para style="q2" vid="PSA 61:6">I yeletethaafe yeletethaa gakanaw de7o.<verse eid="PSA 61:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 61:7"/>I Xoossaa sinthan merinaw kawoto;</para>
  <para style="q2" vid="PSA 61:7">ne siiquwaninne ne tuman iya naaga.<verse eid="PSA 61:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 61:8"/>Hessa gisho ta qangetha gallas gallas gathana;</para>
  <para style="q2" vid="PSA 61:8">ne sunthaa ubba wode sabbana.<verse eid="PSA 61:8"/></para>
  <chapter eid="PSA 61"/>
  <chapter number="62" style="c" sid="PSA 62"/>
  <para style="s1">Xoossa Xalaalan Ufaysi Wotha</para>
  <para style="d">Dawiti Zammaareta Halaqa Edotaames Xaafida Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 62:1"/>Xoossaa xalaalan ta shempo demmas;</para>
  <para style="q2" vid="PSA 62:1">ta atotethay iyape yees.<verse eid="PSA 62:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 62:2"/>Iya xalaali ta zaallanne ta atotetha;</para>
  <para style="q2" vid="PSA 62:2">I ta qosetiya attiya bessi gidiya gisho dagammike.<verse eid="PSA 62:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 62:3"/>Woddana haniya godaanne qaaxiya dirsi daaniya uraa wodhanaw,</para>
  <para style="q2" vid="PSA 62:3">hinte awude gakanaw dendetii?<verse eid="PSA 62:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 62:4"/>Enti iya boncho bessaafe denthanaw koyoosona;</para>
  <para style="q2" vid="PSA 62:4">enti wordon ufaytoosona.</para>
  <para style="q1" vid="PSA 62:4">Banta doonan anjoosona;</para>
  <para style="q2" vid="PSA 62:4">shin banta wozanan baaddoosona. <char style="qs">Salaha </char><verse eid="PSA 62:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 62:5"/>Ta shempete!</para>
  <para style="q2" vid="PSA 62:5">Xoossaa xalaala si77i gada naaga;</para>
  <para style="q2" vid="PSA 62:5">ta ufaysay iyape yees.<verse eid="PSA 62:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 62:6"/>Iya xalaali ta zaallanne ta atotetha;</para>
  <para style="q2" vid="PSA 62:6">taani qosetiya bessi gidiya gisho dagammike.<verse eid="PSA 62:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 62:7"/>Ta atotethaynne ta bonchoy Xoossana;</para>
  <para style="q2" vid="PSA 62:7">I ta mino zaallanne ta miixaa.<verse eid="PSA 62:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 62:8"/>Asaw, ubba wode Xoossan ammanetite;</para>
  <para style="q2" vid="PSA 62:8">I hintew geshe gidiya gisho,</para>
  <para style="q2" vid="PSA 62:8">hinte qofaa iyaw odite. <char style="qs">Salaha </char><verse eid="PSA 62:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 62:9"/>Asi, issi toho shempiya carko mela;</para>
  <para style="q2" vid="PSA 62:9">gooba asi ubbay maaddonna hada.</para>
  <para style="q1" vid="PSA 62:9">Mizaanen wothin enti carko mela;</para>
  <para style="q2" vid="PSA 62:9">enti issi toho shempiya carkofe kawuyoosona.<verse eid="PSA 62:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 62:10"/>Bonqen ammanetofite;</para>
  <para style="q2" vid="PSA 62:10">kaysoti shiishidi duretethan otortofite.</para>
  <para style="q2" vid="PSA 62:10">Hinte duretethay darikoka,</para>
  <para style="q2" vid="PSA 62:10">hinte wozana iya bolla wothofite.<verse eid="PSA 62:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 62:11"/>Xoossay issi toho odis;</para>
  <para style="q2" vid="PSA 62:11">taani nam7u oda si7as;</para>
  <para style="q2" vid="PSA 62:11">wolqi xoossasa.<verse eid="PSA 62:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 62:12"/>Merinaa siiqoy Xoossaba;</para>
  <para style="q2" vid="PSA 62:12">Abeeti Godaw, ne asa ubbaas</para>
  <para style="q2" vid="PSA 62:12">iya oosuwada oosuwada immana.<verse eid="PSA 62:12"/></para>
  <chapter eid="PSA 62"/>
  <chapter number="63" style="c" sid="PSA 63"/>
  <para style="s1">Ta Shempiya Nena Saamotasu</para>
  <para style="d">Yihuda Mela Biittan De7iya Wode Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 63:1"/>Abeeti Xoossaw, ne ta Xoossaa;</para>
  <para style="q2" vid="PSA 63:1">ta wozanay nena laamotees;</para>
  <para style="q2" vid="PSA 63:1">ta ashoyka nena amottees.</para>
  <para style="q1" vid="PSA 63:1">Haathi dhayidi phalqetida biittada,</para>
  <para style="q2" vid="PSA 63:1">ta asatethay nena saamotees.<verse eid="PSA 63:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 63:2"/>Ta nena geeshsha bessan xeellas;</para>
  <para style="q2" vid="PSA 63:2">ne wolqaanne ne bonchuwa taani be7as.<verse eid="PSA 63:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 63:3"/>Ne siiqoy de7ope lo77iya gisho,</para>
  <para style="q2" vid="PSA 63:3">ta inxarsay nena bonchana.<verse eid="PSA 63:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 63:4"/>Ta de7o laythan nena galatana;</para>
  <para style="q2" vid="PSA 63:4">ne sunthan ta kushiya pude miccana.<verse eid="PSA 63:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 63:5"/>Asi lo77o kathi midi kalleysada ta nenan kallana.</para>
  <para style="q2" vid="PSA 63:5">Taani ta inxarsan ufaysa yethan nena galatana.<verse eid="PSA 63:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 63:6"/>Taani ta hiixan nena hassayayis;</para>
  <para style="q2" vid="PSA 63:6">qamma kumethan nebaa qopayis;<verse eid="PSA 63:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 63:7"/>Ne tana maaddiya gisho,</para>
  <para style="q2" vid="PSA 63:7">Ta ne qefiya kuyan uttada ufaysan yexana.<verse eid="PSA 63:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 63:8"/>Ta shempiya neera oyketasu;</para>
  <para style="q2" vid="PSA 63:8">ne ushacha kushey tana oykidi naagees.<verse eid="PSA 63:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 63:9"/>Shin tana wodhanaw koyeysati,</para>
  <para style="q2" vid="PSA 63:9">biitta garsan moogetana.<verse eid="PSA 63:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 63:10"/>Enti mashshas aadhidi imetana;</para>
  <para style="q2" vid="PSA 63:10">enti suudhumes kaho gidana.<verse eid="PSA 63:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 63:11"/>Shin kawoy Xoossan ufaytana.</para>
  <para style="q2" vid="PSA 63:11">Xoossaa sunthan caaqiya ubbay iya galatana;</para>
  <para style="q2" vid="PSA 63:11">shin wordanchota doonay gordetana.<verse eid="PSA 63:11"/></para>
  <chapter eid="PSA 63"/>
  <chapter number="64" style="c" sid="PSA 64"/>
  <para style="s1">Iitatape Tana Ashsha</para>
  <para style="d">Zammaareta Halaqaas yexetida Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 64:1"/>Abeeti Xoossaw, ta un7a woosa si7a;</para>
  <para style="q2" vid="PSA 64:1">ta morketa mandethafe; tana ashsha.<verse eid="PSA 64:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 64:2"/>Nagaranchota maqofenne</para>
  <para style="q2" vid="PSA 64:2">iitata duulataape tana gentha.<verse eid="PSA 64:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 64:3"/>Enti banta inxarsaa mashsha mela leefidosona;</para>
  <para style="q2" vid="PSA 64:3">iita qaalata donge toorada mallidi yeddoosona.<verse eid="PSA 64:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 64:4"/>Enti qosetidi xillo asi banta dongiyan qohoosona;</para>
  <para style="q2" vid="PSA 64:4">akeeki bayna dukoosona; yayyokona.<verse eid="PSA 64:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 64:5"/>Enti banta iita maquwas</para>
  <para style="q2" vid="PSA 64:5">issoy issuwa minthethoosona.</para>
  <para style="q1" vid="PSA 64:5">Banta xihiya wothana bessa koyoosona;</para>
  <para style="q2" vid="PSA 64:5">enti, “Nuna ooni be7anee?” yaagosona.<verse eid="PSA 64:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 64:6"/>Enti iitabaa maqetishe,</para>
  <para style="q2" vid="PSA 64:6">“Nuuni lo77o maqo maqetida” yaagosona;</para>
  <para style="q2" vid="PSA 64:6">Hessi asa wozana qofi ciimmo gideysa bessees.<verse eid="PSA 64:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 64:7"/>Shin Xoossay enta ba dongiyan dukana;</para>
  <para style="q2" vid="PSA 64:7">enti akeekona madunxana.<verse eid="PSA 64:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 64:8"/>Enta maquwa I enta bolla zaarana;</para>
  <para style="q2" vid="PSA 64:8">enta be7iya ubbay huuphe qaathana.<verse eid="PSA 64:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 64:9"/>He wode asa ubbay Xoossas yayyana;</para>
  <para style="q2" vid="PSA 64:9">iya oosuwa odananne zaari zaari qopana.<verse eid="PSA 64:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 64:10"/>Xilloti Godan ufayto;</para>
  <para style="q2" vid="PSA 64:10">iyako baqatidi atto;</para>
  <para style="q2" vid="PSA 64:10">wozana suureti ubbay iya galato.<verse eid="PSA 64:10"/></para>
  <chapter eid="PSA 64"/>
  <chapter number="65" style="c" sid="PSA 65"/>
  <para style="s1">Xoossay Ta Atotetha</para>
  <para style="d">Zammaareta Halaqaas Yexetida Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 65:1"/>Abeeti Xoossaw, Xiyoonen new galati bessees;</para>
  <para style="q2" vid="PSA 65:1">nuuni nu qangetha new gathana.<verse eid="PSA 65:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 65:2"/>Neeni woosa si7iya gisho,</para>
  <para style="q2" vid="PSA 65:2">asa ubbay neeko yoosona.<verse eid="PSA 65:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 65:3"/>Nu nagaray nuna muukida wode,</para>
  <para style="q2" vid="PSA 65:3">ne nuus atotethi immadasa.<verse eid="PSA 65:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 65:4"/>Ne dooridaysatinne ne dabaaban daana mela</para>
  <para style="q2" vid="PSA 65:4">neeko shiishida asi anjetidaysa.</para>
  <para style="q1" vid="PSA 65:4">Nuuni ne son, ne geeshsha dunkaaniyan</para>
  <para style="q2" vid="PSA 65:4">de7iya lo77oban kalloos.<verse eid="PSA 65:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 65:5"/>Abeeti nu atotethaw,</para>
  <para style="q2" vid="PSA 65:5">malaalsiya ne xillo oosuwan nuus zaara.</para>
  <para style="q1" vid="PSA 65:5">Sa7aa gaxape gaxaa gakanaw,</para>
  <para style="q2" vid="PSA 65:5">haahon de7iya ubbaas ne ufaysi.<verse eid="PSA 65:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 65:6"/>Neeni ne wolqan dereta minthadasa;</para>
  <para style="q2" vid="PSA 65:6">ne wolqaa dancadasa.<verse eid="PSA 65:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 65:7"/>Neeni abba girsaanne beeta guntha si77i oothaasa;</para>
  <para style="q2" vid="PSA 65:7">yarkiya asaa waasuwa irxisaasa.<verse eid="PSA 65:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 65:8"/>Ne oothida malaata gisho,</para>
  <para style="q2" vid="PSA 65:8">sa7aa gaxaa gakanaw de7iya asa ubbay new yayyana;</para>
  <para style="q2" vid="PSA 65:8">dolohape wuloha gakanaw de7iya asa ubbaa ufaysadasa.<verse eid="PSA 65:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 65:9"/>Ne ira immada biitta naagasa; daro dureyasa;</para>
  <para style="q2" vid="PSA 65:9">asaas kathay dolana mela</para>
  <para style="q1" vid="PSA 65:9">Xoossa shaafay haathan kumidaysa;</para>
  <para style="q2" vid="PSA 65:9">hessada oothada ne giigisadasa.<verse eid="PSA 65:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 65:10"/>Goshshas haathe immaasa;</para>
  <para style="q2" vid="PSA 65:10">biitta shugisada ollaa kunthaasa.</para>
  <para style="q1" vid="PSA 65:10">Ne iran zaarada irxisaasa;</para>
  <para style="q2" vid="PSA 65:10">kathay dolana diccana mela anjaasa.<verse eid="PSA 65:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 65:11"/>Laytha kalo laythi oothaasa;</para>
  <para style="q2" vid="PSA 65:11">ne aadhiya bessa ubbay kumidi palahana.<verse eid="PSA 65:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 65:12"/>Hentha bessata maatan kunthaasa;</para>
  <para style="q2" vid="PSA 65:12">zumata ufaysi mayzaasa.<verse eid="PSA 65:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 65:13"/>Ne hentha bessata dorsata kunthaasa;</para>
  <para style="q2" vid="PSA 65:13">zangaara biittan kathi kunthaasa;</para>
  <para style="q2" vid="PSA 65:13">enti ufaysan ililishe yexoosona.<verse eid="PSA 65:13"/></para>
  <chapter eid="PSA 65"/>
  <chapter number="66" style="c" sid="PSA 66"/>
  <para style="s1">Ne Oosoti Malaalisees</para>
  <para style="d">Zammaareta Halaqaas Yexetiya Saba Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 66:1"/>Biitta ubbay hinte qaala dhoqu oothidi,</para>
  <para style="q2" vid="PSA 66:1">ufaysan Xoossaa galatite.<verse eid="PSA 66:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 66:2"/>Xoossaa sunthaas bonchon yexite;</para>
  <para style="q2" vid="PSA 66:2">boncho galataa iyaw immite.<verse eid="PSA 66:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 66:3"/>Xoossaas haysada yaagite;</para>
  <para style="q2" vid="PSA 66:3">“Ne oosoti waanidi malaalsii?</para>
  <para style="q1" vid="PSA 66:3">Ne wolqay darida gisho,</para>
  <para style="q2" vid="PSA 66:3">ne morketi yashshan ne sinthan kokoroosona.<verse eid="PSA 66:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 66:4"/>Biitta ubbay nena goyinnees;</para>
  <para style="q2" vid="PSA 66:4">nena sabbees;</para>
  <para style="q2" vid="PSA 66:4">ne sunthaas galatan yexoosona” yaagite. <char style="qs">Salaha </char><verse eid="PSA 66:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 66:5"/>Haayite; Xoossay oothidaba be7ite;</para>
  <para style="q2" vid="PSA 66:5">asaa giddon malaalsiya ooso oothis.<verse eid="PSA 66:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 66:6"/>I abba haatha shaakidi,</para>
  <para style="q2" vid="PSA 66:6">kase nu aawati Yordaanose shaafa banta tohon yedhidi mela biittara pinnidosona.</para>
  <para style="q2" vid="PSA 66:6">Hessan I oothidaban nuuni ufaytida.<verse eid="PSA 66:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 66:7"/>I ba wolqan merinaw haarees.</para>
  <para style="q2" vid="PSA 66:7">Kawotethata ba ayfen xeellees;</para>
  <para style="q2" vid="PSA 66:7">hessa gisho, makalleysati iya bolla dendofo. <char style="qs">Salaha </char><verse eid="PSA 66:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 66:8"/>Asaw, nu Xoossaa galatite;</para>
  <para style="q2" vid="PSA 66:8">hinte iya galatiya galatay si7etto.<verse eid="PSA 66:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 66:9"/>I nuna paxa wothis;</para>
  <para style="q2" vid="PSA 66:9">nu kundonna mela naagis.<verse eid="PSA 66:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 66:10"/>Abeeti Xoossaw ne nuna paacadasa;</para>
  <para style="q2" vid="PSA 66:10">biri taman paacetidi geeyeysada</para>
  <para style="q2" vid="PSA 66:10">ne nuna geeshshadasa.<verse eid="PSA 66:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 66:11"/>Ne nuna xihen gelsadasa;</para>
  <para style="q2" vid="PSA 66:11">nu zokon deexo toho wothadasa.<verse eid="PSA 66:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 66:12"/>Morketi nu huuphera toggidi aadhanada oothadasa;</para>
  <para style="q2" vid="PSA 66:12">Nu haatha giddoranne tama giddora aadhida;</para>
  <para style="q2" vid="PSA 66:12">shin ha77i nuna inje bessi ehadasa.<verse eid="PSA 66:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 66:13"/>Ta xuussa yarsho ekada ne keethaa gelana,</para>
  <para style="q2" vid="PSA 66:13">ta qangetha gathana.<verse eid="PSA 66:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 66:14"/>Ta metootida wode ta doonay gida qaala,</para>
  <para style="q2" vid="PSA 66:14">ta inxarsaafe keyida qangetha gathana.<verse eid="PSA 66:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 66:15"/>Ta new modhuwa, xuussa yarsho oothada shiishana.</para>
  <para style="q1" vid="PSA 66:15">Marazeta sawo tonku giya yarsho oothada shiishana;</para>
  <para style="q2" vid="PSA 66:15">Kormanne koleta new yarshana. <char style="qs">Salaha </char><verse eid="PSA 66:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 66:16"/>Hinteno, Xoossas yayyeysato,</para>
  <para style="q2" vid="PSA 66:16">ubbay haa yidi, si7ite;</para>
  <para style="q2" vid="PSA 66:16">Xoossay taw oothidaba ta hintew odana.<verse eid="PSA 66:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 66:17"/>Ta qaala dhoqu oothada woossas;</para>
  <para style="q2" vid="PSA 66:17">ta inxarsan iya galatas.<verse eid="PSA 66:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 66:18"/>Taani wozani erishin nagara genthidaba gidiyako,</para>
  <para style="q2" vid="PSA 66:18">Goday tana si7enna.<verse eid="PSA 66:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 66:19"/>Shin Xoossay tuma tana si7is;</para>
  <para style="q2" vid="PSA 66:19">ta oysha zaaris.<verse eid="PSA 66:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 66:20"/>Xoossay ta woosa ixiboonna gisho,</para>
  <para style="q2" vid="PSA 66:20">ba merinaa siiquwa</para>
  <para style="q2" vid="PSA 66:20">tana diggiboonna gisho galatetto.<verse eid="PSA 66:20"/></para>
  <chapter eid="PSA 66"/>
  <chapter number="67" style="c" sid="PSA 67"/>
  <para style="s1">Ne Som7uwa Nuus Poo7isa</para>
  <para style="d">Zammaareta Halaqaas Diithan Yexetida Saba Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 67:1"/>Xoossay nuus qadheto; nuna anjo;</para>
  <para style="q2" vid="PSA 67:1">iya som7oy nu bolla poo7o. <char style="qs">Salaha </char><verse eid="PSA 67:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 67:2"/>Ne ogey biitta bolla,</para>
  <para style="q2" vid="PSA 67:2">ne atotetha wolqay,</para>
  <para style="q2" vid="PSA 67:2">kawotethata ubban ereto.<verse eid="PSA 67:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 67:3"/>Abeeti Xoossaw, asay nena galato;</para>
  <para style="q2" vid="PSA 67:3">asa ubbay nena galato.<verse eid="PSA 67:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 67:4"/>Kawotethay malaaletidi ufaysan yexo;</para>
  <para style="q2" vid="PSA 67:4">ayis giiko, neeni asaas xillotethan pirdaasa;</para>
  <para style="q2" vid="PSA 67:4">sa7an de7iya kawotethata kaalethaasa. <char style="qs">Salaha </char><verse eid="PSA 67:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 67:5"/>Abeeti Xoossaw, asay nena galato;</para>
  <para style="q2" vid="PSA 67:5">kawotethati ubbay nena galato.<verse eid="PSA 67:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 67:6"/>Biittay kathi immana;</para>
  <para style="q2" vid="PSA 67:6">Xoossay, nu Xoossay nuna anjis.<verse eid="PSA 67:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 67:7"/>Xoossay nuna anjida gisho,</para>
  <para style="q2" vid="PSA 67:7">biitta gaxaa gakanaw de7iya asay iya yayyo.<verse eid="PSA 67:7"/></para>
  <chapter eid="PSA 67"/>
  <chapter number="68" style="c" sid="PSA 68"/>
  <para style="s1">Xoossay Ba Morketa Laallana</para>
  <para style="d">Zammaareta Halaqaas Yexetida Dawita Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 68:1"/>Xoossay dendo; iya morketi laaleto;</para>
  <para style="q2" vid="PSA 68:1">Iya ixeysati iya sinthafe baqato.<verse eid="PSA 68:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 68:2"/>Cuyay carkora dendidi dhaysiya mela,</para>
  <para style="q2" vid="PSA 68:2">muqaadi taman til7eysada,</para>
  <para style="q2" vid="PSA 68:2">iitati Xoossaa sinthafe dhayo.<verse eid="PSA 68:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 68:3"/>Shin xilloti hashshu go;</para>
  <para style="q2" vid="PSA 68:3">Xoossaa sinthan ufayto;</para>
  <para style="q2" vid="PSA 68:3">ufaysan ililo.<verse eid="PSA 68:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 68:4"/>Xoossaas yexite; iya sunthaa sabbite;</para>
  <para style="q2" vid="PSA 68:4">shaaran beysas oge kessite;</para>
  <para style="q2" vid="PSA 68:4">iya sunthay Godaa; iya sinthan ufaytite.<verse eid="PSA 68:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 68:5"/>Xoossay ba de7iya geeshsha bessan,</para>
  <para style="q2" vid="PSA 68:5">yi7otas aawa; am7etas daynna.<verse eid="PSA 68:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 68:6"/>Xoossay bizzatas soo asi immees;</para>
  <para style="q2" vid="PSA 68:6">qasho keethan de7eyisata birshidi, duretethan wothees;</para>
  <para style="q2" vid="PSA 68:6">shin makallanchoti qaaqa biittan de7oosona.<verse eid="PSA 68:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 68:7"/>Abeeti Xoossaw, neeni ne asaa kaalethida wode,</para>
  <para style="q2" vid="PSA 68:7">ne entara mela biitta kanthida wode, <char style="qs">Salaha </char><verse eid="PSA 68:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 68:8"/>Siina Xoossaa yuussaninne,</para>
  <para style="q2" vid="PSA 68:8">Isra7eele Xoossaa qoncethan</para>
  <para style="q2" vid="PSA 68:8">biittay qaaxis; saloy ira immis.<verse eid="PSA 68:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 68:9"/>Abeeti Xoossaw neeni ira darsada bukisadasa;</para>
  <para style="q2" vid="PSA 68:9">laddida biitta zaarada oorathaasa.<verse eid="PSA 68:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 68:10"/>Ne asay yan duussu oykis;</para>
  <para style="q2" vid="PSA 68:10">abeeti Xoossaw, ne keehatethan manqotas</para>
  <para style="q2" vid="PSA 68:10">koshshiyaba giigisada immadasa.<verse eid="PSA 68:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 68:11"/>Goday kiittis;</para>
  <para style="q2" vid="PSA 68:11">daro Maccasati he kiitaa markatidosona.<verse eid="PSA 68:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 68:12"/>Kawotinne enta olanchoti</para>
  <para style="q2" vid="PSA 68:12">baqatidi guye simmidosona;</para>
  <para style="q2" vid="PSA 68:12">son attida maccasati di7o shaaketidosona.<verse eid="PSA 68:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 68:13"/>Phooliya worqa qefera de7iya,</para>
  <para style="q2" vid="PSA 68:13">birape medhetida holle misile di77idi demmiya wode</para>
  <para style="q2" vid="PSA 68:13">hinte dorsa kelen ayis zin7ideti?<verse eid="PSA 68:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 68:14"/>Ubbaa danda7iya Xoossay kawota laallida wode,</para>
  <para style="q2" vid="PSA 68:14">Xalmoona zumaa bolla shacha bukisis.<verse eid="PSA 68:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 68:15"/>Baasane zumaw,</para>
  <para style="q2" vid="PSA 68:15">daro xeeri de7iya Baasane zumaw,<verse eid="PSA 68:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 68:16"/>Daro xeerati de7iya zumato,</para>
  <para style="q2" vid="PSA 68:16">Xoossay doorida zumaa</para>
  <para style="q2" vid="PSA 68:16">hinte ayis qanaatidi xeelleetii?</para>
  <para style="q2" vid="PSA 68:16">Goday iyan merinaw daana.<verse eid="PSA 68:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 68:17"/>Xoossaa ola para gaareti</para>
  <para style="q2" vid="PSA 68:17">tammu mukulu toho tammu mukulan taybetees;</para>
  <para style="q2" vid="PSA 68:17">Goday Siina zumaape ba geeshsha bessaa yis.<verse eid="PSA 68:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 68:18"/>Di7etida darota ekidi, dhoqa keyis;</para>
  <para style="q2" vid="PSA 68:18">asaape, hari attoshin makallanchotape imo ekis;</para>
  <para style="q2" vid="PSA 68:18">Goday Xoossay yan daana.<verse eid="PSA 68:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 68:19"/>Gallas gallas nu toohuwa tookiya Goday galatetto;</para>
  <para style="q2" vid="PSA 68:19">Xoossay nuna ashsheysa. <char style="qs">Salaha </char><verse eid="PSA 68:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 68:20"/>Nu Xoossay nuna ashshiya Xoossaa gidennee?</para>
  <para style="q2" vid="PSA 68:20">Hayqope ashshiya Xoossay iya.<verse eid="PSA 68:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 68:21"/>Xoossay tuma ba morketa huuphiya tinchana;</para>
  <para style="q2" vid="PSA 68:21">nagara ogen hemetiya asa,</para>
  <para style="q2" vid="PSA 68:21">binaanan kametida enta liiphiya menthana.<verse eid="PSA 68:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 68:22"/>“Taani hinte morketa</para>
  <para style="q2" vid="PSA 68:22">Baasanepe zaarada ehana;</para>
  <para style="q2" vid="PSA 68:22">ta enta ciimmo abbafe kessada guye ehana.<verse eid="PSA 68:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 68:23"/>Hessika, ne morketa suutha ne tohoy yedhana melanne</para>
  <para style="q2" vid="PSA 68:23">ne kanatika morke suuthaafe banta gishuwa laaccana melasa” yaagees Goday.<verse eid="PSA 68:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 68:24"/>Abeeti Xoossaw, ne salpey,</para>
  <para style="q2" vid="PSA 68:24">ta Xoossay ta kawoy salpey,</para>
  <para style="q2" vid="PSA 68:24">Xoossa keethi geliya wode ubbaas bentees.<verse eid="PSA 68:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 68:25"/>Yexeysati sinthana; diixeysati guyena;</para>
  <para style="q2" vid="PSA 68:25">qassi karaabo baqiya geela7oti giddona.<verse eid="PSA 68:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 68:26"/>Hinte “Xoossa gita shiiqon galatite;</para>
  <para style="q2" vid="PSA 68:26">hinteno, Isra7eele asaw, Godaa galatite” yaagosona.<verse eid="PSA 68:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 68:27"/>He salpiyan ubbaafe kaalo gidida</para>
  <para style="q2" vid="PSA 68:27">Biniyaame kochay koyro taybetoosona.</para>
  <para style="q1" vid="PSA 68:27">Kaallidi Yihuda halaqati banta cugan de7oosona;</para>
  <para style="q2" vid="PSA 68:27">wursethan Zabloona halaqatinne</para>
  <para style="q2" vid="PSA 68:27">Niftaaleme halaqati taybetoosona.<verse eid="PSA 68:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 68:28"/>Abeeti Xoossaw, ne wolqaa qoncisa;</para>
  <para style="q2" vid="PSA 68:28">kase ne nuus oothidaysada,</para>
  <para style="q2" vid="PSA 68:28">ne minotetha bessa.<verse eid="PSA 68:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 68:29"/>Hessa gisho, Yerusalaamen de7iya</para>
  <para style="q2" vid="PSA 68:29">ne keetha kawoti yidi,</para>
  <para style="q2" vid="PSA 68:29">new imota immana.<verse eid="PSA 68:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 68:30"/>Do7ada maqa giddon de7iya Gibxe asata neeni seera;</para>
  <para style="q2" vid="PSA 68:30">boorunne mara wude daaniya kawotethata ne hanqeta.</para>
  <para style="q1" vid="PSA 68:30">Enti gulbatidi, banta bira new immana gakanaw,</para>
  <para style="q2" vid="PSA 68:30">neeni enta seera; oletanaw yeemotiya asata laalla.<verse eid="PSA 68:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 68:31"/>Kiitetida halaqati Gibxefe yaana;</para>
  <para style="q2" vid="PSA 68:31">Tophey ba kushiya Xoossako miccana.<verse eid="PSA 68:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 68:32"/>Hinteno, sa7aa kawotethato,</para>
  <para style="q2" vid="PSA 68:32">Xoossas yexite. <char style="qs">Salaha </char><verse eid="PSA 68:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 68:33"/>Benipe de7iya salotape bollara beyisas;</para>
  <para style="q2" vid="PSA 68:33">ba wolqaama girsan ba guntha sisseysas yexite.<verse eid="PSA 68:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 68:34"/>Xoossaa wolqaaba awaajite;</para>
  <para style="q2" vid="PSA 68:34">iya gitatethay Isra7eele bollana;</para>
  <para style="q2" vid="PSA 68:34">iya wolqayka salona.<verse eid="PSA 68:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 68:35"/>Xoossay ba geeshsha asaa bolla malaalsees;</para>
  <para style="q2" vid="PSA 68:35">Isra7eele Xoossay ba asas</para>
  <para style="q2" vid="PSA 68:35">minotethinne wolqa immees.</para>
  <para style="p" vid="PSA 68:35">Xoossay galatetto.<verse eid="PSA 68:35"/></para>
  <chapter eid="PSA 68"/>
  <chapter number="69" style="c" sid="PSA 69"/>
  <para style="s1">Xoossaw Tana Ashsha</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 69:1"/>Haathi taw qoodhe gakida gisho,</para>
  <para style="q2" vid="PSA 69:1">abeeti Xoossaw, tana ashsha.<verse eid="PSA 69:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 69:2"/>Eqiya bessi bayna ciimmon mitettas;</para>
  <para style="q2" vid="PSA 69:2">ciimmo haatha giddo gelas;</para>
  <para style="q2" vid="PSA 69:2">haatha zuley ta bollara aadhis.<verse eid="PSA 69:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 69:3"/>Maado demmanaw waassashe daaburas;</para>
  <para style="q2" vid="PSA 69:3">ta kottonoy melis.</para>
  <para style="q1" vid="PSA 69:3">Ta Xoossaa xeellishin,</para>
  <para style="q2" vid="PSA 69:3">ta ayfey teljumis.<verse eid="PSA 69:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 69:4"/>Tana coo ixeysati</para>
  <para style="q2" vid="PSA 69:4">ta huuphe binaanape daro;</para>
  <para style="q1" vid="PSA 69:4">Wordon tana morkeysatinne</para>
  <para style="q2" vid="PSA 69:4">dhaysanaw koyeysati daro;</para>
  <para style="q2" vid="PSA 69:4">ta kaysotonnaba zaara gidoosona.<verse eid="PSA 69:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 69:5"/>Abeeti Xoossaw, ta eeyatetha ne eraasa;</para>
  <para style="q2" vid="PSA 69:5">ta balay neepe geemmibeenna.<verse eid="PSA 69:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 69:6"/>Abeeti Ubbaafe Wolqaama Godaw,</para>
  <para style="q2" vid="PSA 69:6">nena ufaysan naageysati</para>
  <para style="q2" vid="PSA 69:6">ta gaason yeellatopo.</para>
  <para style="q1" vid="PSA 69:6">Abeeti Isra7eele Xoossaw,</para>
  <para style="q2" vid="PSA 69:6">nena minthidi koyeysati</para>
  <para style="q2" vid="PSA 69:6">ta gaason kawuyofo.<verse eid="PSA 69:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 69:7"/>Ta ne gisho cashshe danda7as;</para>
  <para style="q2" vid="PSA 69:7">ta som7oy yeella ma7iday ne gishosa.<verse eid="PSA 69:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 69:8"/>Taani ta ishatas imathe,</para>
  <para style="q2" vid="PSA 69:8">ta aaye naytas allaga gidas.<verse eid="PSA 69:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 69:9"/>Taani ne keethas mishetiya mishay</para>
  <para style="q2" vid="PSA 69:9">tana tamada xuuggees;</para>
  <para style="q2" vid="PSA 69:9">nena cayiya cashshay ta bolla wodhis.<verse eid="PSA 69:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 69:10"/>Taani xooman tana kawushida wode,</para>
  <para style="q2" vid="PSA 69:10">tana cayidosona.<verse eid="PSA 69:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 69:11"/>Taani kayo ma7o ma7ida wode,</para>
  <para style="q2" vid="PSA 69:11">entaw kaassas attas.<verse eid="PSA 69:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 69:12"/>Katama pengen utteysatas zigrisas attas;</para>
  <para style="q2" vid="PSA 69:12">mathoteysati tabaa yethi kessidosona.<verse eid="PSA 69:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 69:13"/>Shin Godaw, ta nena woossayis;</para>
  <para style="q2" vid="PSA 69:13">abeeti Xoossaw, ne dosiya wode,</para>
  <para style="q2" vid="PSA 69:13">ne merinaa siiquwan,</para>
  <para style="q2" vid="PSA 69:13">ne atotethan taw zaaro imma.<verse eid="PSA 69:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 69:14"/>Silimon mitettonnaada tana ashsha;</para>
  <para style="q2" vid="PSA 69:14">ta morketape tana ashsha,</para>
  <para style="q2" vid="PSA 69:14">ciimmo haathan mitetethafe tana ashsha.<verse eid="PSA 69:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 69:15"/>Di7o haathay tana muukofo;</para>
  <para style="q2" vid="PSA 69:15">ciimmo haathay tana mittofo;</para>
  <para style="q2" vid="PSA 69:15">ziqa ollay ba doona ta bolla gordofo.<verse eid="PSA 69:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 69:16"/>Abeeti Godaw, ne merina siiquwa lo77otethan,</para>
  <para style="q2" vid="PSA 69:16">taw zaaro imma;</para>
  <para style="q2" vid="PSA 69:16">ne gita maarotan taako simma.<verse eid="PSA 69:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 69:17"/>Ne aylliyafe ne som7uwa genthofa;</para>
  <para style="q2" vid="PSA 69:17">taani un7an de7iya gisho</para>
  <para style="q2" vid="PSA 69:17">taw elle zaaro imma.<verse eid="PSA 69:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 69:18"/>Taako shiiqa; tana woza;</para>
  <para style="q2" vid="PSA 69:18">ta morketape tana la77a kessa.<verse eid="PSA 69:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 69:19"/>Ta cashshaa, yeellaanne</para>
  <para style="q2" vid="PSA 69:19">kawushatethaa ne eraasa;</para>
  <para style="q2" vid="PSA 69:19">ta morketa ubbaa ne be7aasa.<verse eid="PSA 69:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 69:20"/>Cashshay tana hargancho oothis;</para>
  <para style="q2" vid="PSA 69:20">taw qadhetiya asi koyas.</para>
  <para style="q1" vid="PSA 69:20">Shin issi asika demmabike;</para>
  <para style="q2" vid="PSA 69:20">tana minthethiya asi xeellas; shin bentibeenna.<verse eid="PSA 69:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 69:21"/>Ta kathan ciiye walakidosona;</para>
  <para style="q2" vid="PSA 69:21">ta saamuwas caala ushshi immidosona.<verse eid="PSA 69:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 69:22"/>Enta gaytay entaw xihe gido;</para>
  <para style="q2" vid="PSA 69:22">enta yarshoy entaw xihe gido.<verse eid="PSA 69:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 69:23"/>Xeellonnaada enta ayfey goozeto;</para>
  <para style="q2" vid="PSA 69:23">enta zokoy kuuno.<verse eid="PSA 69:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 69:24"/>Ne hanquwa enta bolla tiga;</para>
  <para style="q2" vid="PSA 69:24">suulliya ne sheney enta yedetho.<verse eid="PSA 69:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 69:25"/>Enta kambey kaysi gido;</para>
  <para style="q2" vid="PSA 69:25">enta dunkaaniyan de7iya asi dhayo.<verse eid="PSA 69:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 69:26"/>Ne seeridaysata enti yedethidosona;</para>
  <para style="q2" vid="PSA 69:26">ne madunxisidaysata enti yeessosona.<verse eid="PSA 69:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 69:27"/>Enti nagaraa bolla nagara gujana mela aggaaga;</para>
  <para style="q2" vid="PSA 69:27">ne maarotethaafe enta aybika gakofo.<verse eid="PSA 69:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 69:28"/>Enti de7o maxaafape qusheto;</para>
  <para style="q2" vid="PSA 69:28">xillo asaara mazgabetofo.<verse eid="PSA 69:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 69:29"/>Ta waayeninne un7an de7ayis;</para>
  <para style="q2" vid="PSA 69:29">abeeti Xoossaw, tana ashshada,</para>
  <para style="q2" vid="PSA 69:29">saro bessan wotha.<verse eid="PSA 69:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 69:30"/>Taani Xoossaa sunthaa mazmuren galatana;</para>
  <para style="q2" vid="PSA 69:30">galata imon iya gitayana.<verse eid="PSA 69:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 69:31"/>Hessi boora yarshofe,</para>
  <para style="q2" vid="PSA 69:31">woyko kacaama korma yarshofe,</para>
  <para style="q2" vid="PSA 69:31">aadhidi, Godaa ufaysees.<verse eid="PSA 69:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 69:32"/>Naaqetidaysati hessa be7ana; ufaytana;</para>
  <para style="q2" vid="PSA 69:32">hinteno, Xoossaa koyeysato,</para>
  <para style="q2" vid="PSA 69:32">hinte wozanay minetto.<verse eid="PSA 69:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 69:33"/>Goday manqota si7ees;</para>
  <para style="q2" vid="PSA 69:33">qasho keethan de7iya ba asaa kadhenna.<verse eid="PSA 69:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 69:34"/>Saloy, sa7inne abbay,</para>
  <para style="q2" vid="PSA 69:34">iya giddon de7iya woxi qaaxiya ubbay Godaa galato.<verse eid="PSA 69:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 69:35"/>Xoossay Xiyoone ashshana;</para>
  <para style="q2" vid="PSA 69:35">Yihuda katamaa zaaridi keexana;</para>
  <para style="q2" vid="PSA 69:35">asay yan daananne biittayka entaba gidana.<verse eid="PSA 69:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 69:36"/>Iya aylleta nayti he biitta laattana;</para>
  <para style="q2" vid="PSA 69:36">iya sunthaa doseysati yan daana.<verse eid="PSA 69:36"/></para>
  <chapter eid="PSA 69"/>
  <chapter number="70" style="c" sid="PSA 70"/>
  <para style="s1">Xoossaw Tana Maaddanaw Gam7ofa</para>
  <para style="d">Dawita Qofiso Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 70:1"/>Abeeti Xoossaw tana ashshanaw haa simma;</para>
  <para style="q2" vid="PSA 70:1">abeeti Godaw, tana maaddanaw ellesa.<verse eid="PSA 70:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 70:2"/>Tana wodhanaw koyeysati,</para>
  <para style="q2" vid="PSA 70:2">yeellatonanne haniyaba dhayo.</para>
  <para style="q1" vid="PSA 70:2">Ta qohetetha amotteysati,</para>
  <para style="q2" vid="PSA 70:2">kawuyidi guye simmo.<verse eid="PSA 70:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 70:3"/>Taako iyaw “hashshu! hashshu!”</para>
  <para style="q2" vid="PSA 70:3">gidaysati xoonetida gisho yeellato.<verse eid="PSA 70:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 70:4"/>Nena koyiya ubbay</para>
  <para style="q2" vid="PSA 70:4">nenan ufaytonne malaaleto.</para>
  <para style="q1" vid="PSA 70:4">Qassi ne atotetha dosiya ubbay,</para>
  <para style="q2" vid="PSA 70:4">“Xoossay gitato” yaago.<verse eid="PSA 70:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 70:5"/>Taani manqonne metootancho;</para>
  <para style="q2" vid="PSA 70:5">abeeti Xoossaw, ellesada taako haaya.</para>
  <para style="q1" vid="PSA 70:5">Ta maadeynne tana ashshey nena gidiya gisho;</para>
  <para style="q2" vid="PSA 70:5">abeeti Godaw, gam7ofa.<verse eid="PSA 70:5"/></para>
  <chapter eid="PSA 70"/>
  <chapter number="71" style="c" sid="PSA 71"/>
  <para style="s1">Taani Daaburiya Wode Tana Aggofa</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 71:1"/>Godaw, taani neeko baqatada attiya gisho,</para>
  <para style="q2" vid="PSA 71:1">awudeka tana yeellayopa.<verse eid="PSA 71:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 71:2"/>Ne xillotethan tana naaga;</para>
  <para style="q2" vid="PSA 71:2">ne haytha taako zaara; tana ashsha.<verse eid="PSA 71:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 71:3"/>Neeni ta ubba wode geemmada attiya zaalla</para>
  <para style="q2" vid="PSA 71:3">taani geemmada attana mela mino miixaa gida;</para>
  <para style="q2" vid="PSA 71:3">ee, neeni ta zaallanne ta miixa.<verse eid="PSA 71:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 71:4"/>Ta Xoossaw, iitata kushepenne,</para>
  <para style="q2" vid="PSA 71:4">qadhey bayna asatape tana ashsha.<verse eid="PSA 71:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 71:5"/>Abeeti Godaw, ta na7atethafe doomada,</para>
  <para style="q2" vid="PSA 71:5">neeni ta ufaysaanne ta ammanetetha.<verse eid="PSA 71:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 71:6"/>Ta yeletida wodepe doomada nenan zempas;</para>
  <para style="q2" vid="PSA 71:6">ta aaye ulope tana kessiday nena;</para>
  <para style="q2" vid="PSA 71:6">taani ubba wode nena galatana.<verse eid="PSA 71:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 71:7"/>Neeni ta qosetada attiya bessi gidida gisho,</para>
  <para style="q2" vid="PSA 71:7">ta de7oy daro asaas leemiso gidis.<verse eid="PSA 71:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 71:8"/>Gallasa ubban ta doonay</para>
  <para style="q2" vid="PSA 71:8">ne galataninne ne bonchuwan kumis.<verse eid="PSA 71:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 71:9"/>Taani cimida wode tana yeggofa;</para>
  <para style="q2" vid="PSA 71:9">ta wolqay ixida wode tana aggofa.<verse eid="PSA 71:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 71:10"/>Ta morketi ta bolla tobboosona;</para>
  <para style="q2" vid="PSA 71:10">Tana wodhanaw koyeysati ta bolla maqetoosona.<verse eid="PSA 71:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 71:11"/>Enti, “Xoossay iya aggis; yedethidi oykoos;</para>
  <para style="q2" vid="PSA 71:11">iya ashshanay oonika baawa” yaagosona.<verse eid="PSA 71:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 71:12"/>Xoossaw, taape haakofa</para>
  <para style="q2" vid="PSA 71:12">ta Xoossaw, tana maaddanaw ellesa.<verse eid="PSA 71:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 71:13"/>Tana mooteysati yeellatidi dhayo;</para>
  <para style="q2" vid="PSA 71:13">Tana qohanaw koyeysati,</para>
  <para style="q2" vid="PSA 71:13">yeellanne kawushe ma7o.<verse eid="PSA 71:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 71:14"/>Shin taani ubba wode ufaysan nena naagana;</para>
  <para style="q2" vid="PSA 71:14">zaara zaaradaka nena galatana.<verse eid="PSA 71:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 71:15"/>Ne oothidaba ta taybanaw xoonetikoka,</para>
  <para style="q2" vid="PSA 71:15">ta doonay gallas ubban ne xillotethaanne</para>
  <para style="q2" vid="PSA 71:15">ne atotethaaba odana.<verse eid="PSA 71:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 71:16"/>Taani Ubbaa Haariya Godaa wolqan yada;</para>
  <para style="q2" vid="PSA 71:16">ne xalaala xillo gideysa awaajana.<verse eid="PSA 71:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 71:17"/>Xoossaw, neeni ta na7atethafe doomada tana tamaarsadasa;</para>
  <para style="q2" vid="PSA 71:17">ha77ika ne malaalsiya oosuwa ta odana.<verse eid="PSA 71:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 71:18"/>Xoossaw ne wolqaanne ne minotethan</para>
  <para style="q2" vid="PSA 71:18">yaa yeleta ubbaas odana gakanaw,</para>
  <para style="q2" vid="PSA 71:18">taani cimada puulumikoka tana aggofa.<verse eid="PSA 71:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 71:19"/>Xoossaw, ne xillotethay salo gakis;</para>
  <para style="q2" vid="PSA 71:19">gitaba oothida Xoossi, ne meli oonee?<verse eid="PSA 71:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 71:20"/>Neeni ta bolla daro meto ehadasa;</para>
  <para style="q2" vid="PSA 71:20">gidoshin ta de7uwa zaarada ooraxisadasa;</para>
  <para style="q2" vid="PSA 71:20">neeni tana biitta garsafe kessadasa.<verse eid="PSA 71:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 71:21"/>Neeni ta bonchuwa darsadasa;</para>
  <para style="q2" vid="PSA 71:21">tana zaarada minthethadasa.<verse eid="PSA 71:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 71:22"/>Ta Xoossaw, ne tumatethaa gisho,</para>
  <para style="q2" vid="PSA 71:22">ta nena diithan galatana.</para>
  <para style="q1" vid="PSA 71:22">Abeeti Isra7eele geeshshaw,</para>
  <para style="q2" vid="PSA 71:22">ta nena maasinqon sabbana.<verse eid="PSA 71:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 71:23"/>Ta mettershay ufaysan dhoqu oothidi yexees;</para>
  <para style="q2" vid="PSA 71:23">neeni tana ashshida gisho taani nena sabbana.<verse eid="PSA 71:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 71:24"/>Tana qohanaw koyeysati yeellatida gishonne</para>
  <para style="q2" vid="PSA 71:24">kawuyida gisho ta inxarsay ne xillo maaduwaba</para>
  <para style="q2" vid="PSA 71:24">gallas ubban odana.<verse eid="PSA 71:24"/></para>
  <chapter eid="PSA 71"/>
  <chapter number="72" style="c" sid="PSA 72"/>
  <para style="s1">Ufaysan Naagetiya Kawa</para>
  <para style="d">Solomone Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 72:1"/>Xoossaw, ne suure pirdaa kawas,</para>
  <para style="q2" vid="PSA 72:1">nu xillotethaa kawa na7aas imma.<verse eid="PSA 72:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 72:2"/>I ne asaas xillotethan pirdana;</para>
  <para style="q2" vid="PSA 72:2">qohetidaysatas suuren daynnatana.<verse eid="PSA 72:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 72:3"/>Dereti duretethi,</para>
  <para style="q2" vid="PSA 72:3">zumati xillotetha ayfe ne asaas ayfo.<verse eid="PSA 72:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 72:4"/>Kawoy qohetidaysata gisho mooteto;</para>
  <para style="q2" vid="PSA 72:4">manqota ashsho; un7etheyisata mentho.<verse eid="PSA 72:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 72:5"/>Xoossaw, I awadanne ageenada de7o;</para>
  <para style="q2" vid="PSA 72:5">yeletethaafe yeletethaa gakanaw de7o.<verse eid="PSA 72:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 72:6"/>Kawoy goshshan bukiya ira melanne</para>
  <para style="q2" vid="PSA 72:6">biitta kalsiya puuse ira mela gido.<verse eid="PSA 72:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 72:7"/>Iya laytha ubban xillo asati daayo;</para>
  <para style="q2" vid="PSA 72:7">ageeni dhayana gakanaw sarotethi daro.<verse eid="PSA 72:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 72:8"/>Abbaafe abba gakanaw,</para>
  <para style="q2" vid="PSA 72:8">Efraxiisa shaafape sa7aa gaxa gakanaw I haaro.<verse eid="PSA 72:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 72:9"/>Bazzon de7iya asati iya goyinno;</para>
  <para style="q2" vid="PSA 72:9">iya morketi baana laaco.<verse eid="PSA 72:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 72:10"/>Tarsesanne yuushoy abban teqetida biittata,</para>
  <para style="q2" vid="PSA 72:10">kawoti iyaw giira giiro;</para>
  <para style="q2" vid="PSA 72:10">Arabenne Tophe kawoti iyaw imota eho.<verse eid="PSA 72:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 72:11"/>Kawoti ubbay iyaw gulbato;</para>
  <para style="q2" vid="PSA 72:11">kawotethati ubbay iyaw kiiteto.<verse eid="PSA 72:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 72:12"/>Iyako waassiya manqota, qohetidaysatanne</para>
  <para style="q2" vid="PSA 72:12">maadoy baynayisata I ashshana.<verse eid="PSA 72:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 72:13"/>Manqotasinne daaburanchotas I qadhetees;</para>
  <para style="q2" vid="PSA 72:13">manqota shempuwa hayqope ashshees.<verse eid="PSA 72:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 72:14"/>Enta suuthay iya sinthan al7o gidiya gisho,</para>
  <para style="q2" vid="PSA 72:14">I, enta qohopenne iitape wozana.<verse eid="PSA 72:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 72:15"/>Kawoy daro laythi gam7o;</para>
  <para style="q2" vid="PSA 72:15">Arabe biitta worqay iyaw yo.</para>
  <para style="q1" vid="PSA 72:15">Asay iya gisho ubba wode woosso;</para>
  <para style="q2" vid="PSA 72:15">gallas ubban I anjeto.<verse eid="PSA 72:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 72:16"/>Biittan kathi palaho;</para>
  <para style="q2" vid="PSA 72:16">dereti kathan kametto.</para>
  <para style="q1" vid="PSA 72:16">Libaanose deriya bolla kathi ayfiyada ayfo;</para>
  <para style="q2" vid="PSA 72:16">denbi maatan kumiyada asay katamaa kumo.<verse eid="PSA 72:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 72:17"/>Kawa sunthay merinaw de7o;</para>
  <para style="q2" vid="PSA 72:17">awada ubba wode xeegetishe gam7o.</para>
  <para style="q1" vid="PSA 72:17">Asa ubbay iya baggara anjetana;</para>
  <para style="q2" vid="PSA 72:17">kawotethati iya “anjetidaysa” yaagana.<verse eid="PSA 72:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 72:18"/>Malaalisiyaba barka oothiya Goday, Xoossay</para>
  <para style="q2" vid="PSA 72:18">Isra7eele Xoossay galatetto.<verse eid="PSA 72:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 72:19"/>Iya boncho sunthay merinaw galatetto;</para>
  <para style="q2" vid="PSA 72:19">iya bonchoy sa7a ubbaa kumo.</para>
  <para style="b" vid="PSA 72:19"/>
  <para style="qc" vid="PSA 72:19">Amin7i! Amin7i!<verse eid="PSA 72:19"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 72:20"/>Isseye na7aa Dawita woosay haysan poletis.<verse eid="PSA 72:20"/></para>
  <chapter eid="PSA 72"/>
  <chapter number="73" style="c" sid="PSA 73"/>
  <para style="ms">Heedzantho Maxaafa</para>
  <para style="mr">(<ref loc="PSA 73-89">Maz 73—89</ref>)</para>
  <para style="s1">Xoossay Taw Minotethinne Gisho</para>
  <para style="d">Asaafa Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 73:1"/>Tuma Xoossay Isra7eeles lo77o;</para>
  <para style="q2" vid="PSA 73:1">wozana geeshshatas I keeha.<verse eid="PSA 73:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 73:2"/>Shin ta tohoy dhubetanaw guuthu attis;</para>
  <para style="q2" vid="PSA 73:2">ta tangoy hallixanaw matis.<verse eid="PSA 73:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 73:3"/>Hessi haniday iita asatinne otoranchoti,</para>
  <para style="q2" vid="PSA 73:3">duretishin taani be7ada qanaatida gishosa.<verse eid="PSA 73:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 73:4"/>Enta waayey gakonna gisho,</para>
  <para style="q2" vid="PSA 73:4">enta asatethay payyanne mino.<verse eid="PSA 73:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 73:5"/>Enti hara asada waayetokona;</para>
  <para style="q2" vid="PSA 73:5">hara asada meton shocetokona.<verse eid="PSA 73:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 73:6"/>Hessa gisho, otoroy entaw qoodhe alleeqo mela;</para>
  <para style="q2" vid="PSA 73:6">buqethi afilada ma7idosona.<verse eid="PSA 73:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 73:7"/>Enta wozanay iitabaa pultees;</para>
  <para style="q2" vid="PSA 73:7">enta qofay iita halchon kumis.<verse eid="PSA 73:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 73:8"/>Enti qelqisoosona; iitabaa haasayoosona;</para>
  <para style="q2" vid="PSA 73:8">banta otoruwan harata un7ethoosona.<verse eid="PSA 73:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 73:9"/>Banta doona Xoossaa bolla dooyosona;</para>
  <para style="q2" vid="PSA 73:9">banta inxarsaa asa bolla adussosona.<verse eid="PSA 73:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 73:10"/>Hari attoshin, Xoossaa asay entako simmana;</para>
  <para style="q2" vid="PSA 73:10">enti odiyaba eeson ammanana.<verse eid="PSA 73:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 73:11"/>Enti, “Xoossi ayko erii?</para>
  <para style="q2" vid="PSA 73:11">Ubbaafe Dhoqa Xoossaas eratethi de7ii?” yaagosona.<verse eid="PSA 73:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 73:12"/>Hiza iitati haysa mela;</para>
  <para style="q2" vid="PSA 73:12">ubba wode injetin de7oosona;</para>
  <para style="q2" vid="PSA 73:12">enti guji guji duretoosona.<verse eid="PSA 73:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 73:13"/>Hiza taani ta wozanaa geeshshatethan naagiday,</para>
  <para style="q2" vid="PSA 73:13">xillotethi bessanaw ta kushiya meecetiday mela.<verse eid="PSA 73:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 73:14"/>Gallasa kumethi taani meton shocetas;</para>
  <para style="q2" vid="PSA 73:14">wonta wonta seeretas.<verse eid="PSA 73:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 73:15"/>Taani iita asatada odetidaako,</para>
  <para style="q2" vid="PSA 73:15">ne asaas ammanetona attanashin.<verse eid="PSA 73:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 73:16"/>Taani ha ubbaa eranaw qopiya wode,</para>
  <para style="q2" vid="PSA 73:16">taw deexo gidis.<verse eid="PSA 73:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 73:17"/>Hessika taani Xoossa keethaa gelana gakanawunne</para>
  <para style="q2" vid="PSA 73:17">iita asata wursetha qaada akeekana gakanaasa.<verse eid="PSA 73:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 73:18"/>Tuma neeni enta hallixiya bessan utisadasa;</para>
  <para style="q2" vid="PSA 73:18">enti kundidi dhayana mela oothaasa.<verse eid="PSA 73:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 73:19"/>Enti ellesidi dhayidosona;</para>
  <para style="q2" vid="PSA 73:19">dagaman issoy attonna wuridosona.<verse eid="PSA 73:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 73:20"/>Amuhoy barkiya wode baleteysada,</para>
  <para style="q2" vid="PSA 73:20">abeeti Godaw, neeni dendiya wode,</para>
  <para style="q2" vid="PSA 73:20">enti dogetana.<verse eid="PSA 73:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 73:21"/>Taani yilotida wodenne</para>
  <para style="q2" vid="PSA 73:21">ta wozanan cametida wode,<verse eid="PSA 73:21"/></para>
  <para style="q2">
    <verse number="22" style="v" sid="PSA 73:22"/>akeekona eeya asi gidas;</para>
  <para style="q2" vid="PSA 73:22">ne sinthan mehe gidas.<verse eid="PSA 73:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 73:23"/>Shin taani ubba wode neera de7ayis;</para>
  <para style="q2" vid="PSA 73:23">ta ushacha kushiya neeni oykadasa.<verse eid="PSA 73:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 73:24"/>Ne zoriyan tana kaalethaasa;</para>
  <para style="q2" vid="PSA 73:24">wursethan tana bonchon ekaasa.<verse eid="PSA 73:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 73:25"/>Taw salon neepe attishin, hari ooni de7ii?</para>
  <para style="q2" vid="PSA 73:25">Taani neepe attishin, sa7an haraa amotike.<verse eid="PSA 73:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 73:26"/>Ta wolqaynne ta wozanay daaburanaw danda7ees;</para>
  <para style="q2" vid="PSA 73:26">shin Xoossay ta wozanaa minotethaanne</para>
  <para style="q2" vid="PSA 73:26">merinaw tana gakida saamaa.<verse eid="PSA 73:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 73:27"/>Neepe haakeysati dhayana;</para>
  <para style="q2" vid="PSA 73:27">nena kaddeyisata ubbaa ne wursana.<verse eid="PSA 73:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 73:28"/>Shin taw Xoossaako shiiqoy lo77o;</para>
  <para style="q2" vid="PSA 73:28">iya ooso ubbaa taani odana mela,</para>
  <para style="q2" vid="PSA 73:28">Ubbaa Haariya Godaa qosetidi attiya besse oothas.<verse eid="PSA 73:28"/></para>
  <chapter eid="PSA 73"/>
  <chapter number="74" style="c" sid="PSA 74"/>
  <para style="s1">Xoossaw Ne Gisho Mooteta</para>
  <para style="d">Asaafa Timirte</para>
  <para style="d">Akeekan xaafida ginxo.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 74:1"/>Xoossaw neeni nuna ayis merinaw aggadii?</para>
  <para style="q2" vid="PSA 74:1">Ne qooruwan de7iya ne dorsata bolla</para>
  <para style="q2" vid="PSA 74:1">ne hanqoy ayis eexidee?<verse eid="PSA 74:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 74:2"/>Neeni beni doorida asaa,</para>
  <para style="q2" vid="PSA 74:2">new buzo oothada wozida kochata hassaya;</para>
  <para style="q2" vid="PSA 74:2">neeni de7ida Xiyoone zuma qopa.<verse eid="PSA 74:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 74:3"/>Laaletida ne keethaa yada xeella;</para>
  <para style="q2" vid="PSA 74:3">morketi yan de7iyaba ubbaa dhaysidosona.<verse eid="PSA 74:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 74:4"/>Ne morketi ne keethan,</para>
  <para style="q2" vid="PSA 74:4">“Nu xoonida” yaagidi gereeridosona.</para>
  <para style="q2" vid="PSA 74:4">Xoono malaata gidida banta bandira essidosona.<verse eid="PSA 74:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 74:5"/>Enti mithi qanxanaw wora giddon eqidi,</para>
  <para style="q2" vid="PSA 74:5">banta kalta denthida asata daanosona.<verse eid="PSA 74:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 74:6"/>Enti kushe hiillan alleeqida oosota ubbaa,</para>
  <para style="q2" vid="PSA 74:6">banta kaltaaninne naariqan mentherethidosona.<verse eid="PSA 74:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 74:7"/>Ne keetha taman xuuggidi dhaysidosona;</para>
  <para style="q2" vid="PSA 74:7">ne sunthay xeegetiya bessaa tunisidosona.<verse eid="PSA 74:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 74:8"/>Banta wozanan, “Nu kumethi dhaysana” yaagidosona;</para>
  <para style="q2" vid="PSA 74:8">biittan de7iya asi Xoosse goyinniya bessata</para>
  <para style="q2" vid="PSA 74:8">taman xuuggidosona.<verse eid="PSA 74:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 74:9"/>He wode malaati nuus imetenna;</para>
  <para style="q2" vid="PSA 74:9">nabeyka deenna.</para>
  <para style="q1" vid="PSA 74:9">Hessi awude gakanaw gam7aneko,</para>
  <para style="q2" vid="PSA 74:9">eriya asi nu giddon baawa.<verse eid="PSA 74:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 74:10"/>Xoossaw, ne morketi awude gakanaw,</para>
  <para style="q2" vid="PSA 74:10">ne bolla qelqisanee?</para>
  <para style="q2" vid="PSA 74:10">Enti ne sunthaa merinaw cayanee?<verse eid="PSA 74:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 74:11"/>Ne ushacha kushiya ayis shiisha ekay?</para>
  <para style="q2" vid="PSA 74:11">Ne ushacha kushiya ne afilaa giddofe</para>
  <para style="q2" vid="PSA 74:11">kessada enta dhaysa.<verse eid="PSA 74:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 74:12"/>Gidoshin, abeeti Xoossaw,</para>
  <para style="q2" vid="PSA 74:12">neeni benipe ta kawa;</para>
  <para style="q2" vid="PSA 74:12">ne daro wode ashshadasa.<verse eid="PSA 74:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 74:13"/>Ne gita wolqan abba shaakadasa;</para>
  <para style="q2" vid="PSA 74:13">iya giddon de7iya do7aa huupheta doncadasa.<verse eid="PSA 74:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 74:14"/>Leewataane geetetiya dawiya huupheta doncada,</para>
  <para style="q2" vid="PSA 74:14">iya ashuwa bazzon de7iya medhetethatas</para>
  <para style="q2" vid="PSA 74:14">kathi oothada immiday nena.<verse eid="PSA 74:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 74:15"/>Neeni pultota dooya yeddadasa;</para>
  <para style="q2" vid="PSA 74:15">ubba wode goggiya shaafata melisadasa.<verse eid="PSA 74:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 74:16"/>Gallasay nebaa; qammayka nebaa;</para>
  <para style="q2" vid="PSA 74:16">awanne ageena enta bessan wothiday nena.<verse eid="PSA 74:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 74:17"/>Biittas zawa wothiday,</para>
  <para style="q2" vid="PSA 74:17">balgonne bone medhiday nena.<verse eid="PSA 74:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 74:18"/>Abeeti Godaw, ne morketi nena waati qelqisidaako,</para>
  <para style="q2" vid="PSA 74:18">eeya asati ne sunthaa waati cayidaako hassaya.<verse eid="PSA 74:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 74:19"/>Ne holliya shempuwa do7aas aathada immofa;</para>
  <para style="q2" vid="PSA 74:19">metootanchota merinaw dogopa.<verse eid="PSA 74:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 74:20"/>Nu biittan de7iya dhuma bessi ubbay</para>
  <para style="q2" vid="PSA 74:20">makallanchotan kumida gisho,</para>
  <para style="q2" vid="PSA 74:20">ne nuus caaqida caaquwa qopa.<verse eid="PSA 74:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 74:21"/>Qohetidaysata yeellayopa;</para>
  <para style="q2" vid="PSA 74:21">manqotinne metootanchoti ne sunthaa galato.<verse eid="PSA 74:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 74:22"/>Abeeti Xoossaw, denda; mooteta;</para>
  <para style="q2" vid="PSA 74:22">gallas kumethi eeyati nena qelqiseysa hassaya.<verse eid="PSA 74:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 74:23"/>Ne morketi ne bolla waassiya waasuwanne</para>
  <para style="q2" vid="PSA 74:23">nena ixeysati ceeqetiya ceequwa akeeka.<verse eid="PSA 74:23"/></para>
  <chapter eid="PSA 74"/>
  <chapter number="75" style="c" sid="PSA 75"/>
  <para style="s1">Xoossay Suure Pirdana</para>
  <para style="d">Asaafi zammaareta Halaqaas, “Dhaysofa” Geetetiya Diitha Cuudhethan Yexida Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 75:1"/>Abeeti Xoossaw, new galata immoos;</para>
  <para style="q2" vid="PSA 75:1">ne sunthay mata gidiya gisho nena galatoos;</para>
  <para style="q2" vid="PSA 75:1">asay ne malaalsiya oosuwa odoosona.<verse eid="PSA 75:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 75:2"/>Xoossay haysada yaagees;</para>
  <para style="q2" vid="PSA 75:2">“Taani pirda immiya wode dooras;</para>
  <para style="q2" vid="PSA 75:2">suure pirdey tana.<verse eid="PSA 75:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 75:3"/>Biittaynne iyan de7iya ubbay qaaxikoka,</para>
  <para style="q2" vid="PSA 75:3">iya tuussaa mintha essey tana. <char style="qs">Salaha </char><verse eid="PSA 75:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 75:4"/>Taani otoranchota, ‘Otortofite’;</para>
  <para style="q2" vid="PSA 75:4">iitata, ‘Hinte kaciya bessofite.’<verse eid="PSA 75:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 75:5"/>‘Hinte kaciya salo denthofite;</para>
  <para style="q2" vid="PSA 75:5">qoodhe qaathidi haasayopite’ ” yaagana.<verse eid="PSA 75:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 75:6"/>Bonchoy dolohape woyko wulohape</para>
  <para style="q2" vid="PSA 75:6">woyko mela biittafe yeenna.<verse eid="PSA 75:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 75:7"/>Shin suure pirdey Xoossaa;</para>
  <para style="q2" vid="PSA 75:7">I issuwa bolla pirdees; hankuwa shatinthees.<verse eid="PSA 75:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 75:8"/>Xoossaa kushen issi wanci de7ees;</para>
  <para style="q2" vid="PSA 75:8">he wancay Xoossaa hanqo</para>
  <para style="q2" vid="PSA 75:8">woyne ushshan kumidi uttis.</para>
  <para style="q1" vid="PSA 75:8">I he ushshafe tigin,</para>
  <para style="q2" vid="PSA 75:8">sa7an de7iya iita asati hessa uyana;</para>
  <para style="q2" vid="PSA 75:8">enti orcuwa ashshona xiiphidi uyana.<verse eid="PSA 75:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 75:9"/>Shin taani Yayqooba Xoossaaba odana;</para>
  <para style="q2" vid="PSA 75:9">iya merinaw sabbana.<verse eid="PSA 75:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 75:10"/>I, iita asata kaciya menthana;</para>
  <para style="q2" vid="PSA 75:10">shin xillota kacey dhoqu dhoqu gaana.<verse eid="PSA 75:10"/></para>
  <chapter eid="PSA 75"/>
  <chapter number="76" style="c" sid="PSA 76"/>
  <para style="s1">Xoossa Sinthan Eqanay Oonee?</para>
  <para style="d">Asaafi Zammaareta Halaqaas Diithan Yexida Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 76:1"/>Xoossay Yihudan eretis;</para>
  <para style="q2" vid="PSA 76:1">iya sunthay Isra7eelen gita.<verse eid="PSA 76:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 76:2"/>Iya dunkaaney Saalemana;</para>
  <para style="q2" vid="PSA 76:2">I de7iya bessay Xiyoonena.<verse eid="PSA 76:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 76:3"/>Yan xongetiya morke dongiya,</para>
  <para style="q2" vid="PSA 76:3">gondalle, mashshenne ola miisheta mentherethis. <char style="qs">Salaha </char><verse eid="PSA 76:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 76:4"/>Abeeti Xoossaw, ne bonchoy ay mela gite!</para>
  <para style="q2" vid="PSA 76:4">Neeni ne morketa xoonada zumaape simmiya wode,</para>
  <para style="q2" vid="PSA 76:4">ne teemay ay mela yashshi!<verse eid="PSA 76:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 76:5"/>Gooba tooranchoti bonqetidosona;</para>
  <para style="q2" vid="PSA 76:5">enti wolqaama dhisko dhiskidosona;</para>
  <para style="q2" vid="PSA 76:5">entafe issoyka ba kushiya denthibeenna.<verse eid="PSA 76:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 76:6"/>Abeeti Yayqooba Xoossaw, ne seerida wode,</para>
  <para style="q2" vid="PSA 76:6">para asatinne parati kundidi attidosona.<verse eid="PSA 76:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 76:7"/>Shin abeeti Xoossaw, neeni yashshaasa;</para>
  <para style="q2" vid="PSA 76:7">ne hanqoy suulliya wode,</para>
  <para style="q2" vid="PSA 76:7">ne sinthan oone eqanay?<verse eid="PSA 76:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 76:8"/>Neeni pirdaa salope sissida wode,</para>
  <para style="q2" vid="PSA 76:8">biittay dagaman si77i gis.<verse eid="PSA 76:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 76:9"/>Neeni biittan qohetida asaa ashshanawunne</para>
  <para style="q2" vid="PSA 76:9">entaw pirdanaw dendiya wode hessi hannis. <char style="qs">Salaha </char><verse eid="PSA 76:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 76:10"/>Ne ase hanqikoka new boncho gidees;</para>
  <para style="q2" vid="PSA 76:10">Olape attida asati ne ba7aale bonchana.<verse eid="PSA 76:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 76:11"/>Godaas hinte Xoossaas qangethi gathite;</para>
  <para style="q2" vid="PSA 76:11">hinteno iya matan de7iya kawotethato,</para>
  <para style="q2" vid="PSA 76:11">yashshiya iyaw imota ehite.<verse eid="PSA 76:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 76:12"/>I halaqata ayyaana kawushshees;</para>
  <para style="q2" vid="PSA 76:12">wolqaama kawotaka daganthees.<verse eid="PSA 76:12"/></para>
  <chapter eid="PSA 76"/>
  <chapter number="77" style="c" sid="PSA 77"/>
  <para style="s1">Taani Meto Wode Xoosse Koyas</para>
  <para style="d">Asaafi Zammaareta Halaqa Edotaames Xaafida Mazmure.</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 77:1"/>Taani Xoossaa maggannayis;</para>
  <para style="q2" vid="PSA 77:1">tana si7a gada iyako waassayis.<verse eid="PSA 77:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 77:2"/>Ta metuwa gallasan Godaa koyas;</para>
  <para style="q2" vid="PSA 77:2">qamma kumethi shempoy bayna ta kushiya miccas;</para>
  <para style="q2" vid="PSA 77:2">gidoshin, ta shempiya minnanaw danda7abuku.<verse eid="PSA 77:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 77:3"/>Taani Xoossaba qopiya wode oolayis;</para>
  <para style="q2" vid="PSA 77:3">taani wotha denthida wode ta shempoy daaburees. <char style="qs">Salaha </char><verse eid="PSA 77:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 77:4"/>Qamma kumethi tana dhisko diggada aysadasa;</para>
  <para style="q2" vid="PSA 77:4">ta un7etida gisho odetanaw danda7abike.<verse eid="PSA 77:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 77:5"/>Taani aadhida gallasata qopas;</para>
  <para style="q2" vid="PSA 77:5">kase laythata hassayas.<verse eid="PSA 77:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 77:6"/>Taani qamma gita qofan aqas;</para>
  <para style="q2" vid="PSA 77:6">ta wozanan wotha denthashe,</para>
  <para style="q2" vid="PSA 77:6">haysada yaagada tana oychas;<verse eid="PSA 77:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 77:7"/>“Xoossay nuna merinaw aggideyee?</para>
  <para style="q2" vid="PSA 77:7">hizape guye I nuus keeheneyee?<verse eid="PSA 77:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 77:8"/>Iya siiqoy attideyee?</para>
  <para style="q2" vid="PSA 77:8">I odida qaala merinaw poleneyee?<verse eid="PSA 77:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 77:9"/>Xoossay ba maarota dogideyee?</para>
  <para style="q2" vid="PSA 77:9">Ba qadhiya hanqon laammideyee?” yaagada oychas. <char style="qs">Salaha </char><verse eid="PSA 77:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 77:10"/>Ubbaafe Dhoqa Xoossaw, tana un7ethiday,</para>
  <para style="q2" vid="PSA 77:10">ne ushacha kushiyan nuna maado aggidaysa.<verse eid="PSA 77:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 77:11"/>Godaa oosota taani qopana;</para>
  <para style="q2" vid="PSA 77:11">I beni oothida malaalsiya oosota hassayana.<verse eid="PSA 77:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 77:12"/>Ne oosota taani zaara zaarada qopana;</para>
  <para style="q2" vid="PSA 77:12">ne wolqaama oosota taani wotha denthana.<verse eid="PSA 77:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 77:13"/>Abeeti Xoossaw, ne ogey geeshshi;</para>
  <para style="q2" vid="PSA 77:13">ne mela gita Xoossi oonee?<verse eid="PSA 77:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 77:14"/>Neeni malaalsiyaba oothiya Xoossaa;</para>
  <para style="q2" vid="PSA 77:14">asaa giddon ne wolqaa qoncisaasa.<verse eid="PSA 77:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 77:15"/>Ne asaa, Yayqoobanne Yoosefa kochaa</para>
  <para style="q2" vid="PSA 77:15">ne qesiyan wozadasa. <char style="qs">Salaha </char><verse eid="PSA 77:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 77:16"/>Abeeti Xoossaw, haathati nena be7idi yayyidosona;</para>
  <para style="q2" vid="PSA 77:16">abba ciimmotika kokoridosona.<verse eid="PSA 77:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 77:17"/>Shaarati haathe duge tigidosona;</para>
  <para style="q2" vid="PSA 77:17">daday salon guummis;</para>
  <para style="q2" vid="PSA 77:17">ne wol7anthay yan han wol7amis.<verse eid="PSA 77:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 77:18"/>Ne dadaa guunthay uushuwa giddon guummis;</para>
  <para style="q2" vid="PSA 77:18">ne wol7anthay sa7aa poo7isis;</para>
  <para style="q2" vid="PSA 77:18">biittay qaaxis; kokoris.<verse eid="PSA 77:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 77:19"/>Neeni abba giddora hemetaasa;</para>
  <para style="q2" vid="PSA 77:19">ciimmo abba giddora kanthaasa;</para>
  <para style="q2" vid="PSA 77:19">shin ne tohoy yedhida bessay bentenna.<verse eid="PSA 77:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 77:20"/>Muse kushennine Aarona kushen</para>
  <para style="q2" vid="PSA 77:20">ne asaa dorsa wudeda kaalethadasa.<verse eid="PSA 77:20"/></para>
  <chapter eid="PSA 77"/>
  <chapter number="78" style="c" sid="PSA 78"/>
  <para style="s1">Kaalliya Yeletethaas Oda</para>
  <para style="d">Asaafi Akeekan Xaafida Ginxo</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 78:1"/>Ta asaw, ta timirtiya si7ite;</para>
  <para style="q2" vid="PSA 78:1">ta doonape keyiya qaala hayzidi si7ite.<verse eid="PSA 78:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 78:2"/>Taani ta doona leemison dooyana;</para>
  <para style="q2" vid="PSA 78:2">benipe geemmida xuura qoncisana.<verse eid="PSA 78:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 78:3"/>Nuuni si7idaysanne eridaysa,</para>
  <para style="q2" vid="PSA 78:3">nu aawati nuus odidaysata odana.<verse eid="PSA 78:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 78:4"/>Hessata nuuni enta naytape qosoko;</para>
  <para style="q2" vid="PSA 78:4">Godaas bessiya galataa,</para>
  <para style="q2" vid="PSA 78:4">iya wolqaanne malaalsiya iya oosuwa,</para>
  <para style="q2" vid="PSA 78:4">yaana yeletas odana.<verse eid="PSA 78:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 78:5"/>I Yayqooba zerethaas kiitaa,</para>
  <para style="q2" vid="PSA 78:5">Isra7eele asaas higgiya immis.</para>
  <para style="q1" vid="PSA 78:5">Kase nu aawati banta nayta</para>
  <para style="q2" vid="PSA 78:5">he higgiya tamaarsana mela kiittis.<verse eid="PSA 78:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 78:6"/>Kaalliya yeletay hessa erana mela,</para>
  <para style="q2" vid="PSA 78:6">enta naytika banta naytas</para>
  <para style="q2" vid="PSA 78:6">buroo yeletana naytas erisanaasa.<verse eid="PSA 78:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 78:7"/>He wode enti Xoossan ammanetena;</para>
  <para style="q2" vid="PSA 78:7">I oothidaba balokona; iya kiitaa naagana.<verse eid="PSA 78:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 78:8"/>Enti kase banta aawatada wozana muume yeleta,</para>
  <para style="q2" vid="PSA 78:8">geellanne ammanetona yeleta,</para>
  <para style="q2" vid="PSA 78:8">Xoossan minnidi eqenna yeleta gidokona.<verse eid="PSA 78:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 78:9"/>Efreema asay donge dancikoka,</para>
  <para style="q2" vid="PSA 78:9">ola gallas guye simmidosona.<verse eid="PSA 78:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 78:10"/>Enti Xoossaa caaquwa naagibookona;</para>
  <para style="q2" vid="PSA 78:10">iya higgiyan hemetonna ixidosona.<verse eid="PSA 78:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 78:11"/>Enti I oothida oosuwanne</para>
  <para style="q2" vid="PSA 78:11">I bessida malaata dogidosona.<verse eid="PSA 78:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 78:12"/>I enta aawata sinthan Gibxe biittan,</para>
  <para style="q2" vid="PSA 78:12">Xo7aane Denban malaata oothis.<verse eid="PSA 78:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 78:13"/>Abbaa shaakidi giddora enta pinthis;</para>
  <para style="q2" vid="PSA 78:13">haatha shaakidi yan han godada essis.<verse eid="PSA 78:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 78:14"/>I enta gallas shaaran,</para>
  <para style="q2" vid="PSA 78:14">qamma tama poo7on kaalethis.<verse eid="PSA 78:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 78:15"/>I mela biittan zaalla phalqidi,</para>
  <para style="q2" vid="PSA 78:15">abbada daro haathi enta ushshis.<verse eid="PSA 78:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 78:16"/>Zaallafe haathe pultisidi,</para>
  <para style="q2" vid="PSA 78:16">shaafa haathada gogisis.<verse eid="PSA 78:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 78:17"/>Shin enti iya bolla nagara gujidi oothidosona;</para>
  <para style="q2" vid="PSA 78:17">Ubbaafe Dhoqa Xoossaa bolla mela biittan makallidosona.<verse eid="PSA 78:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 78:18"/>Banta amotida kathaa oychidi,</para>
  <para style="q2" vid="PSA 78:18">Xoossaa erishe paacidosona.<verse eid="PSA 78:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 78:19"/>Enti Xoossaa bolla haysada yaagidi haasayidosona;</para>
  <para style="q2" vid="PSA 78:19">“Mela biittan Xoossay nuus kathi giigisanaw danda7ii?<verse eid="PSA 78:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 78:20"/>Zaalla shocin pultoy keyidi</para>
  <para style="q2" vid="PSA 78:20">shaafa haathi goggis;</para>
  <para style="q2" vid="PSA 78:20">shin I nuus kathi immanaw danda7ii?</para>
  <para style="q2" vid="PSA 78:20">Woyko ba asaas asho immanaw danda7ii?” yaagidosona.<verse eid="PSA 78:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 78:21"/>Goday hessa si7ida wode daro hanqetis;</para>
  <para style="q2" vid="PSA 78:21">Yayqooba kochata bolla tami eexis;</para>
  <para style="q2" vid="PSA 78:21">Isra7eele bolla iya hanqoy daris.<verse eid="PSA 78:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 78:22"/>Hessika enti Xoossan ammanibookona;</para>
  <para style="q2" vid="PSA 78:22">woyko iya ashuwan ammanetibokona.<verse eid="PSA 78:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 78:23"/>Gidoshin, dhoqa saluwa kiittis;</para>
  <para style="q2" vid="PSA 78:23">salo pengiya dooyis.<verse eid="PSA 78:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 78:24"/>Enta muzanaw manna bukisis;</para>
  <para style="q2" vid="PSA 78:24">salo kathaa entaw immis.<verse eid="PSA 78:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 78:25"/>Kiitanchota kathi asay mis;</para>
  <para style="q2" vid="PSA 78:25">Xoossay entaw miyaba darsidi immis.<verse eid="PSA 78:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 78:26"/>Doloha carkoy carkana mela oothis;</para>
  <para style="q2" vid="PSA 78:26">ba wolqan dugeha carkuwa denthis.<verse eid="PSA 78:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 78:27"/>I asaas asho biitta kessis;</para>
  <para style="q2" vid="PSA 78:27">paalliya kafota abba gaxa shafeda bukisis.<verse eid="PSA 78:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 78:28"/>Enti de7iya bessan,</para>
  <para style="q2" vid="PSA 78:28">dunkaaniya yuushon wodhisis.<verse eid="PSA 78:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 78:29"/>Enti amotidaysa entaw immis;</para>
  <para style="q2" vid="PSA 78:29">midi banta ganjiya gathidosona.<verse eid="PSA 78:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 78:30"/>Shin enti banta amuwa aathona de7ishin,</para>
  <para style="q2" vid="PSA 78:30">ashoy enta doonan buroo de7ishin,<verse eid="PSA 78:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 78:31"/>Xoossaa hanqoy enta bolla wodhis;</para>
  <para style="q2" vid="PSA 78:31">enta giddofe wolqaama asata wodhis;</para>
  <para style="q2" vid="PSA 78:31">Isra7eelepe na7atethata dhukis.<verse eid="PSA 78:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 78:32"/>He ubbay haninka nagara ooso aggibokona;</para>
  <para style="q2" vid="PSA 78:32">daro malaata oothinka ammanibookona.<verse eid="PSA 78:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 78:33"/>Hessa gisho, I enta gallasata hada oothis;</para>
  <para style="q2" vid="PSA 78:33">enta laythata dagaman ongis.<verse eid="PSA 78:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 78:34"/>Xoossay entafe baggaa wodhiya wode</para>
  <para style="q2" vid="PSA 78:34">iya koydosona,</para>
  <para style="q2" vid="PSA 78:34">banta nagaraa paaxidi iyako simmidosona.<verse eid="PSA 78:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 78:35"/>Xoossay enta zaalla gideysa,</para>
  <para style="q2" vid="PSA 78:35">Ubbaafe Dhoqa Xoossay enta wozeysa,</para>
  <para style="q2" vid="PSA 78:35">gideysa hassayidosona.<verse eid="PSA 78:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 78:36"/>Shin enti banta inxarsan wordotidosona;</para>
  <para style="q2" vid="PSA 78:36">banta doonan cimmidosona.<verse eid="PSA 78:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 78:37"/>Enta wozanay Xoossan minnidi eqenna;</para>
  <para style="q2" vid="PSA 78:37">iya caaquwas ammanetokona.<verse eid="PSA 78:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 78:38"/>Shin I enta maaris enta nagaraa atto gis;</para>
  <para style="q2" vid="PSA 78:38">enta dhaysibeenna.</para>
  <para style="q1" vid="PSA 78:38">Daro wode ba hanquwa teqis;</para>
  <para style="q2" vid="PSA 78:38">ba gaduwa kumethi enta bolla yeddibeenna.<verse eid="PSA 78:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 78:39"/>Enti hayqiya asho gideysanne</para>
  <para style="q2" vid="PSA 78:39">keyidi simmonna shempo gideysa akeekis.<verse eid="PSA 78:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 78:40"/>Enti mela biittan iya bolla aapun toho makallidona!</para>
  <para style="q2" vid="PSA 78:40">Mela biittan iya aapun toho lancisidonaa!<verse eid="PSA 78:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 78:41"/>Enti zaari zaaridi Xoossaa paacidosona;</para>
  <para style="q2" vid="PSA 78:41">Isra7eele Geeshshaa yiloyidosona.<verse eid="PSA 78:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 78:42"/>Entana morketa kushepe ashshida gallasaa,</para>
  <para style="q2" vid="PSA 78:42">un7ethiya asaape wozida wolqaa dogidosona.<verse eid="PSA 78:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 78:43"/>I Gibxen oothida malaata,</para>
  <para style="q2" vid="PSA 78:43">Xo7aane Denban oothida</para>
  <para style="q2" vid="PSA 78:43">malaalsiya oosuwa hassaybookona.<verse eid="PSA 78:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 78:44"/>Enta shaafa haathata suuthu laammis;</para>
  <para style="q2" vid="PSA 78:44">hessa gisho, Gibxe asay shaafatape</para>
  <para style="q2" vid="PSA 78:44">uyanaw danda7ibookona.<verse eid="PSA 78:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 78:45"/>Enta waaysiya udunxetanne</para>
  <para style="q2" vid="PSA 78:45">enta biitta dhaysiya shodheta kiittis.<verse eid="PSA 78:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 78:46"/>Dolida kathaa duggos,</para>
  <para style="q2" vid="PSA 78:46">enti daaburida ayfiya booles immis.<verse eid="PSA 78:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 78:47"/>Enta woyniya shachan,</para>
  <para style="q2" vid="PSA 78:47">enta balasiya carkon dhaysis.<verse eid="PSA 78:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 78:48"/>Enta meheta shachan wodhis;</para>
  <para style="q2" vid="PSA 78:48">enta dorsata dadan wursis.<verse eid="PSA 78:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 78:49"/>Dhaysiya kiitancho cugara,</para>
  <para style="q2" vid="PSA 78:49">ba suulliya hanquwa, yiluwa, ixuwanne</para>
  <para style="q2" vid="PSA 78:49">gaduwa enta bolla yeddis.<verse eid="PSA 78:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 78:50"/>Ba hanquwas oge giigisis;</para>
  <para style="q2" vid="PSA 78:50">enta dhayos aathidi immis;</para>
  <para style="q2" vid="PSA 78:50">enta hayqope ashshibeenna.<verse eid="PSA 78:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 78:51"/>Gibxe bayra nayta ubbaa shocis;</para>
  <para style="q2" vid="PSA 78:51">Kaama dunkaanen koyro nayta wodhis;<verse eid="PSA 78:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 78:52"/>Shin ba asaa dorsada kessis;</para>
  <para style="q2" vid="PSA 78:52">wudeda mela biittan heemmis.<verse eid="PSA 78:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 78:53"/>I enta saro kaalethida gisho babibookona;</para>
  <para style="q2" vid="PSA 78:53">shin enta morketa abbay mittis.<verse eid="PSA 78:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 78:54"/>I enta ba geeshsha biitta,</para>
  <para style="q2" vid="PSA 78:54">ba ushacha kushen xoonidi oykida zuma bolla ehis.<verse eid="PSA 78:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 78:55"/>I enta sinthafe kawotethata gooddis;</para>
  <para style="q2" vid="PSA 78:55">enta biitta Isra7eele kochatas laata oothidi shaakis;</para>
  <para style="q2" vid="PSA 78:55">ba asaas enta keethaa immis.<verse eid="PSA 78:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 78:56"/>Gidoshin, Ubbaafe Dhoqa Xoossaa bolla makallidosona;</para>
  <para style="q2" vid="PSA 78:56">iya paacidosona; iya higgiya kiitetibookona.<verse eid="PSA 78:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 78:57"/>Enti banta aawatada geellatanne</para>
  <para style="q2" vid="PSA 78:57">minnidi eqonna asi gididosona;</para>
  <para style="q2" vid="PSA 78:57">wobe toorada wora wodhidosona.<verse eid="PSA 78:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 78:58"/>Dhoqa goyinno bessatan iya yiloyidosona;</para>
  <para style="q2" vid="PSA 78:58">banta eeqatara iya qanaatisidosona.<verse eid="PSA 78:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 78:59"/>Xoossay hessa si7ida wode shenetis;</para>
  <para style="q2" vid="PSA 78:59">Isra7eele ubbaa kadhis.<verse eid="PSA 78:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 78:60"/>Seelon I de7iya ba bessaa,</para>
  <para style="q2" vid="PSA 78:60">asaa giddon I de7iya ba dunkaaniya aggis.<verse eid="PSA 78:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 78:61"/>Xoossa wolqaasinne bonchuwas</para>
  <para style="q2" vid="PSA 78:61">malaata gidida Taabotiya</para>
  <para style="q2" vid="PSA 78:61">morketa kushen aathidi immis.<verse eid="PSA 78:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 78:62"/>I ba asaa bolla shenetis;</para>
  <para style="q2" vid="PSA 78:62">enta mashshas aathidi immis.<verse eid="PSA 78:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 78:63"/>Na7atethati ubbay taman meetetidosona;</para>
  <para style="q2" vid="PSA 78:63">geela7oti azina gelonna attidosona.<verse eid="PSA 78:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 78:64"/>Enta kahineti mashshan wuridosona;</para>
  <para style="q2" vid="PSA 78:64">enta macheti yeekonna mela digetidosona.<verse eid="PSA 78:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 78:65"/>Goday dhiskofe barkiya asada dendis;</para>
  <para style="q2" vid="PSA 78:65">woyne ushsha mathoy aadhida asada hanis.<verse eid="PSA 78:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 78:66"/>I ba morketa guye zaaridi shocis;</para>
  <para style="q2" vid="PSA 78:66">enta merinaw yeellayis.<verse eid="PSA 78:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 78:67"/>Yoosefa dunkaaniya kadhis;</para>
  <para style="q2" vid="PSA 78:67">Efreema kochaa dooribeenna.<verse eid="PSA 78:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 78:68"/>Shin Yihuda kochaanne</para>
  <para style="q2" vid="PSA 78:68">I dosiya Xiyoone deriya dooris.<verse eid="PSA 78:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 78:69"/>Ba keethaa saloda dhoqu oothidi keexis;</para>
  <para style="q2" vid="PSA 78:69">sa7ada merinaw essis.<verse eid="PSA 78:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 78:70"/>Ba aylliya Dawita dooridi,</para>
  <para style="q2" vid="PSA 78:70">dorse heemmiya bessaafe ekis.<verse eid="PSA 78:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 78:71"/>Dorse heemmiya bessafe denthidi,</para>
  <para style="q2" vid="PSA 78:71">ba asaa Yayqooba,</para>
  <para style="q2" vid="PSA 78:71">ba laata Isra7eele henthanaw ehis.<verse eid="PSA 78:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 78:72"/>Dawiti enta suure wozanan heemmis;</para>
  <para style="q2" vid="PSA 78:72">ba cincatethan kaalethis.<verse eid="PSA 78:72"/></para>
  <chapter eid="PSA 78"/>
  <chapter number="79" style="c" sid="PSA 79"/>
  <para style="s1">Godaw, Awude Gakanaasee?</para>
  <para style="d">Asaafa Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 79:1"/>Xoossaw, ayhude gidonna asay,</para>
  <para style="q2" vid="PSA 79:1">ne biitta bolla dendidosona;</para>
  <para style="q1" vid="PSA 79:1">Ne geeshsha keethaa tunisidosona;</para>
  <para style="q2" vid="PSA 79:1">Yerusalaame laallidosona.<verse eid="PSA 79:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 79:2"/>Ne aylleta aha salo kafotas,</para>
  <para style="q2" vid="PSA 79:2">ne geeshshata ashuwa sa7a do7atas immidosona.<verse eid="PSA 79:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 79:3"/>Enta suuthaa Yerusalaame yuushon</para>
  <para style="q2" vid="PSA 79:3">haathada gussidosona;</para>
  <para style="q2" vid="PSA 79:3">enta aha moogiya asi dhayis.<verse eid="PSA 79:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 79:4"/>Nu shoorotas nuuni miichas,</para>
  <para style="q2" vid="PSA 79:4">nu heeran de7iya asaas qelqisethas attida.<verse eid="PSA 79:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 79:5"/>Godaw, hessi awude gakanaw hananee?</para>
  <para style="q2" vid="PSA 79:5">Neeni nu bolla merinaw hanqetadii?</para>
  <para style="q2" vid="PSA 79:5">Ne hanqoy tamada eexishe daaneyee?<verse eid="PSA 79:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 79:6"/>Nena eronna dereta bolla,</para>
  <para style="q2" vid="PSA 79:6">ne sunthaa xeegonna kawotethata bolla</para>
  <para style="q2" vid="PSA 79:6">ne hanquwa zaara.<verse eid="PSA 79:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 79:7"/>Hessika enti Yayqooba mida gishonne</para>
  <para style="q2" vid="PSA 79:7">enti de7iya bessaa dhaysida gishosa.<verse eid="PSA 79:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 79:8"/>Nuuni daro metootida gisho,</para>
  <para style="q2" vid="PSA 79:8">nu mayzata iitatethaa nu bolla taybopa;</para>
  <para style="q2" vid="PSA 79:8">eeson ne maarota nuus kiitta.<verse eid="PSA 79:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 79:9"/>Abeeti nuna ashshiya Xoossaw,</para>
  <para style="q2" vid="PSA 79:9">ne boncho sunthaa gisho nuna maadda.</para>
  <para style="q1" vid="PSA 79:9">Ne suntha gisho nuna ashsha;</para>
  <para style="q2" vid="PSA 79:9">nu nagaraa atto ga.<verse eid="PSA 79:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 79:10"/>Dereti, “Enta Xoossay awun de7ii?” ayis gaanee?</para>
  <para style="q2" vid="PSA 79:10">Ne aylleta suuthaa enti gussida gisho;</para>
  <para style="q2" vid="PSA 79:10">neeni halo keyeysa nu xeellishin,</para>
  <para style="q2" vid="PSA 79:10">enta giddon qoncisa.<verse eid="PSA 79:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 79:11"/>Qasho asaa ooley ne sinthe gako;</para>
  <para style="q2" vid="PSA 79:11">hayqo pirdetidaysata</para>
  <para style="q2" vid="PSA 79:11">ne wolqaa gitatethan ashsha.<verse eid="PSA 79:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 79:12"/>Godaw, nu shooroti nena toochida gisho,</para>
  <para style="q2" vid="PSA 79:12">laapun kushe halo keyada enta ki7on idintha.<verse eid="PSA 79:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 79:13"/>He wode nuuni ne asay, ne dorsati,</para>
  <para style="q2" vid="PSA 79:13">merinaw nena galatana.</para>
  <para style="q1" vid="PSA 79:13">Yeletethaafe yeletethaa gakanaw,</para>
  <para style="q2" vid="PSA 79:13">ne peeshsha odana.<verse eid="PSA 79:13"/></para>
  <chapter eid="PSA 79"/>
  <chapter number="80" style="c" sid="PSA 80"/>
  <para style="s1">Xoossaw, Nuna Ooratha</para>
  <para style="d">Asaafi Zammaareta Halaqaas Xaafida Mazmure</para>
  <para style="d">“Ciishsha cuudhethi” geetetiya markatetha mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 80:1"/>Yoosefa dorsa wudeda kaaletheyso,</para>
  <para style="q2" vid="PSA 80:1">Isra7eele henthanchuwaw nuna si7a.</para>
  <para style="q1" vid="PSA 80:1">Kiruubeta bolla de7iya araatan uttidayso,</para>
  <para style="q2" vid="PSA 80:1">ne poo7uwan qonca.<verse eid="PSA 80:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 80:2"/>Efreema, Biniyaamenne Minaase sinthan benta;</para>
  <para style="q2" vid="PSA 80:2">ne wolqaa qaathada nuna ashshanaw haaya.<verse eid="PSA 80:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 80:3"/>Xoossaw nuna zaara;</para>
  <para style="q2" vid="PSA 80:3">nu attanaada ne som7uwa nuus poo7isa.<verse eid="PSA 80:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 80:4"/>Ubbaafe Wolqaama Godaw Xoossaw,</para>
  <para style="q2" vid="PSA 80:4">ne asaa woosa bolla awude gakanaw shenetay?<verse eid="PSA 80:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 80:5"/>Neeni enta yeeho kathada muzadasa;</para>
  <para style="q2" vid="PSA 80:5">afuthu haathada ushshadasa.<verse eid="PSA 80:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 80:6"/>Nu shooroti nu biitta ekanaw</para>
  <para style="q2" vid="PSA 80:6">banta giddon oyaana mela oothadasa;</para>
  <para style="q2" vid="PSA 80:6">nu morketi nu bolla miicidosona.<verse eid="PSA 80:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 80:7"/>Ubbaafe Wolqaama Xoossaw nuna zaara;</para>
  <para style="q2" vid="PSA 80:7">nu attanaada ne som7uwa nuus poo7isa.<verse eid="PSA 80:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 80:8"/>Gibxefe woyne ehadasa;</para>
  <para style="q2" vid="PSA 80:8">kawotethata yedethada,</para>
  <para style="q2" vid="PSA 80:8">enta biittan iya tokadasa.<verse eid="PSA 80:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 80:9"/>Neeni biitta qeexadasa;</para>
  <para style="q2" vid="PSA 80:9">I xapho yeddidi, daayidi biitta gakis.<verse eid="PSA 80:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 80:10"/>Dereti iya kuyan,</para>
  <para style="q2" vid="PSA 80:10">Libaanose zigati iya tashiyan kametidosona.<verse eid="PSA 80:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 80:11"/>Ba tasheta Medetiraane Abbaa gakanaw,</para>
  <para style="q2" vid="PSA 80:11">ba xeerata Efraxiisa shaafa gakanaw yeddis.<verse eid="PSA 80:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 80:12"/>Yaatin, ogera aadhiya ubbay</para>
  <para style="q2" vid="PSA 80:12">iya ayfiya duuthanaada,</para>
  <para style="q2" vid="PSA 80:12">iya yuushon de7iya gimbiya ayis laalladii?<verse eid="PSA 80:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 80:13"/>Bazzo gudunthoy iya bolla gupis;</para>
  <para style="q2" vid="PSA 80:13">wora do7ati iya midosona.<verse eid="PSA 80:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 80:14"/>Ubbaafe Wolqaama Xoossaw nuuko simma;</para>
  <para style="q2" vid="PSA 80:14">salora duge xeellada; ha woyniya naaga.<verse eid="PSA 80:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 80:15"/>I ne ushacha kushey tokida xapho;</para>
  <para style="q2" vid="PSA 80:15">neeni new dichida puute.<verse eid="PSA 80:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 80:16"/>Ne morketi ne woyniya qanxidosona;</para>
  <para style="q2" vid="PSA 80:16">taman xuuggidosona;</para>
  <para style="q2" vid="PSA 80:16">enta ne hanquwan dhaysa.<verse eid="PSA 80:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 80:17"/>Ne kushey ne ushachan de7iya asaa,</para>
  <para style="q2" vid="PSA 80:17">neeni new dichida asaa naago.<verse eid="PSA 80:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 80:18"/>Hiza nuuni guye simmoko;</para>
  <para style="q2" vid="PSA 80:18">Nuna paxa wotha; ne sunthaa galatana.<verse eid="PSA 80:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 80:19"/>Ubbaafe Wolqaama Godaw Xoossaw, nuna zaara;</para>
  <para style="q2" vid="PSA 80:19">nu attanaada ne som7uwa nuus poo7isa.<verse eid="PSA 80:19"/></para>
  <chapter eid="PSA 80"/>
  <chapter number="81" style="c" sid="PSA 81"/>
  <para style="s1">Shaqara Ba7aale Wode Yexiya Saba</para>
  <para style="d">Zammaareta halaqaas xaafetida Suusul7en yexetiya Asaafa Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 81:1"/>Nuus wolqa gidida Xoossaas ufaysan yexite;</para>
  <para style="q2" vid="PSA 81:1">Yayqooba Xoossaas ililite.<verse eid="PSA 81:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 81:2"/>Yethi doomite; karaabo baqite;</para>
  <para style="q2" vid="PSA 81:2">diithaninne maasinqon yexite.<verse eid="PSA 81:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 81:3"/>Ageeni xeeriya wode,</para>
  <para style="q2" vid="PSA 81:3">qassi dhuma uttiya wode,</para>
  <para style="q2" vid="PSA 81:3">ba7aale gallasan moyze punnite.<verse eid="PSA 81:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 81:4"/>Hessi Isra7eele biittan higge;</para>
  <para style="q2" vid="PSA 81:4">Yayqooba Xoossay immida woga.<verse eid="PSA 81:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 81:5"/>I Gibxe biitta shocida wode,</para>
  <para style="q2" vid="PSA 81:5">Yoosefa kochaas ha wogaa awaajis.</para>
  <para style="b" vid="PSA 81:5"/>
  <para style="q1" vid="PSA 81:5">Eronna doonan haysada yaagishin si7as;<verse eid="PSA 81:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 81:6"/>“Hinte hashiya toohope,</para>
  <para style="q2" vid="PSA 81:6">hinte kushiya keeshepe shempisas.<verse eid="PSA 81:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 81:7"/>Hinte metuwan tana xeegideta; ta hintena ashshas;</para>
  <para style="q2" vid="PSA 81:7">taani dechiya shaara giddofe hintena allas;</para>
  <para style="q2" vid="PSA 81:7">Mariba pultuwa matan ta hintena paacas.” <char style="qs">Salaha </char><verse eid="PSA 81:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 81:8"/>“Ta asaw, ta hintena seereysa si7ite;</para>
  <para style="q2" vid="PSA 81:8">Isra7eele asaw hinte tana si7iko aybee?<verse eid="PSA 81:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 81:9"/>Hinte giddon allaga xoossi de7opo;</para>
  <para style="q2" vid="PSA 81:9">hara xoosse goyinnofite.<verse eid="PSA 81:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 81:10"/>Gibxe biittafe hintena kessida,</para>
  <para style="q2" vid="PSA 81:10">taani Godaa hinte Xoossaa;</para>
  <para style="q1" vid="PSA 81:10">Ne doona loythada hakanka;</para>
  <para style="q2" vid="PSA 81:10">taani iyan kunthana.<verse eid="PSA 81:10"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 81:11"/>“Shin ta asay tana si7ibookona;</para>
  <para style="q2" vid="PSA 81:11">Isra7eeley taw kiitetibeenna.<verse eid="PSA 81:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 81:12"/>Hessa gisho, enti banta qofaa kaallana mela,</para>
  <para style="q2" vid="PSA 81:12">simmonna enta wozanaas aathada immas.<verse eid="PSA 81:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 81:13"/>Ta asay tana si7idaako aybe;</para>
  <para style="q2" vid="PSA 81:13">Isra7eeley ta ogiya kaallidaako aybi de7i;<verse eid="PSA 81:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 81:14"/>Taani enta morketa eeson xoonanashin;</para>
  <para style="q2" vid="PSA 81:14">enta ixeyisata bolla ta kushiya denthanashin.<verse eid="PSA 81:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 81:15"/>Godaa ixeysati iya sinthan hokana;</para>
  <para style="q2" vid="PSA 81:15">enta seeray merinaw gidana.<verse eid="PSA 81:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 81:16"/>Taani hintena lo77o giste muzana;</para>
  <para style="q2" vid="PSA 81:16">zaallafe keyiya eessan hintena kalsana.”<verse eid="PSA 81:16"/></para>
  <chapter eid="PSA 81"/>
  <chapter number="82" style="c" sid="PSA 82"/>
  <para style="s1">Daaburanchuwa Ashsha</para>
  <para style="d">Asaafa Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 82:1"/>Xoossay salo shiiquwa giddon,</para>
  <para style="q2" vid="PSA 82:1">xoossati shiiqida bessan</para>
  <para style="q2" vid="PSA 82:1">haysada yaagidi pirdees.<verse eid="PSA 82:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 82:2"/>“Hinte awude gakanaw wobbe pirdanee?</para>
  <para style="q2" vid="PSA 82:2">awude gakanaw iitata bagga gidanee?” <char style="qs">Salaha </char><verse eid="PSA 82:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 82:3"/>Metootanchotasinne aawi baynaysatas mootetite;</para>
  <para style="q2" vid="PSA 82:3">manqotanne qohetida asaa maata naagisite.<verse eid="PSA 82:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 82:4"/>Daaburanchotanne metootanchota ashshite;</para>
  <para style="q2" vid="PSA 82:4">iitata kushepe enta yegisite.<verse eid="PSA 82:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 82:5"/>Hintew eratethinne akeeki baawa;</para>
  <para style="q2" vid="PSA 82:5">enti dhuman simeretoosona;</para>
  <para style="q2" vid="PSA 82:5">biitta baasoti qaaxidosona.<verse eid="PSA 82:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 82:6"/>Taani, “Hinte xoossata;</para>
  <para style="q2" vid="PSA 82:6">ubbay Ubbaafe Dhoqa Xoossaa nayta.<verse eid="PSA 82:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 82:7"/>Gidoshin hinte asi hayqeysada hayqana;</para>
  <para style="q2" vid="PSA 82:7">hara halaqati kundeysada kundana” yaagas.<verse eid="PSA 82:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 82:8"/>Xoossaw, denda; biitta bolla pirda;</para>
  <para style="q2" vid="PSA 82:8">kawotethati ubbay nebaa.<verse eid="PSA 82:8"/></para>
  <chapter eid="PSA 82"/>
  <chapter number="83" style="c" sid="PSA 83"/>
  <para style="s1">Xoossaw Si77i Goopa</para>
  <para style="d">Asaafa Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 83:1"/>Abeeti Xoossaw, si77i goopa;</para>
  <para style="q2" vid="PSA 83:1">Xoossaw sirphi goopa; muumopa.<verse eid="PSA 83:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 83:2"/>Ne morketi ne bolla dendeysa,</para>
  <para style="q2" vid="PSA 83:2">nena ixeysati ne bolla makalleysa be7a.<verse eid="PSA 83:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 83:3"/>Enti ne asaa bolla geeman duulatoosona;</para>
  <para style="q2" vid="PSA 83:3">neeni dosiya asaa bolla maqetoosona.<verse eid="PSA 83:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 83:4"/>“Haayite, enta kawotethaa dhaysoos;</para>
  <para style="q2" vid="PSA 83:4">Isra7eele geetetiya sunthay merinaw hassayetonna mela oothoos” yaagosona.<verse eid="PSA 83:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 83:5"/>Enti issi wozanan gididi maqetoosona;</para>
  <para style="q2" vid="PSA 83:5">ne bolla dendanaw caaqidosona.<verse eid="PSA 83:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 83:6"/>Enti, Edoomenne Isma7eela asaa,</para>
  <para style="q2" vid="PSA 83:6">Moo7abenne Aggaari kochata;<verse eid="PSA 83:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 83:7"/>Gebaalanne Amoone asaa,</para>
  <para style="q2" vid="PSA 83:7">Amaaleqa, Filisxeemenne Xiroosa asaa.<verse eid="PSA 83:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 83:8"/>Asooreti entara gahetidosona;</para>
  <para style="q2" vid="PSA 83:8">Asooreti Looxe asaas wolqaama maado gididosona. <char style="qs">Salaha </char><verse eid="PSA 83:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 83:9"/>Neeni, Midiyaame, Sisaaranne Yabina bolla</para>
  <para style="q2" vid="PSA 83:9">Qisoona shaafan oothidaysada enta bolla ootha.<verse eid="PSA 83:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 83:10"/>Enti Endooran dhayidosona;</para>
  <para style="q2" vid="PSA 83:10">enta ahay denban wooqidi attis.<verse eid="PSA 83:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 83:11"/>Enta halaqata Oreebanne Zebada ootha;</para>
  <para style="q2" vid="PSA 83:11">enta haareyisata Zabheelanne Silmanada dhaysa.<verse eid="PSA 83:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 83:12"/>Enti, “Nuuni Xoossaa asaa laata</para>
  <para style="q2" vid="PSA 83:12">nuus buzo oothana” yaagidosona.<verse eid="PSA 83:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 83:13"/>Ta Xoossaw, enta baanada laalla;</para>
  <para style="q2" vid="PSA 83:13">carkoy efiya suullada ootha.<verse eid="PSA 83:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 83:14"/>Tami wora meysada,</para>
  <para style="q2" vid="PSA 83:14">tama lacoy deriya xuuggeysada,<verse eid="PSA 83:14"/></para>
  <para style="q2">
    <verse number="15" style="v" sid="PSA 83:15"/>ne uushuwan enta yedetha;</para>
  <para style="q2" vid="PSA 83:15">ne gotiyan enta dagantha.<verse eid="PSA 83:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 83:16"/>Godaw, asay ne sunthaa koyana mela,</para>
  <para style="q2" vid="PSA 83:16">enta som7uwa yeella mayza.<verse eid="PSA 83:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 83:17"/>Enti merinaw yeellato; hirgo;</para>
  <para style="q2" vid="PSA 83:17">kawuyidi dhayo.<verse eid="PSA 83:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 83:18"/>Ne sunthay Godaa gidida ne xalaali,</para>
  <para style="q2" vid="PSA 83:18">Ubbaafe Dhoqa Xoossay,</para>
  <para style="q2" vid="PSA 83:18">sa7a ubbaa haareysa enti ero.<verse eid="PSA 83:18"/></para>
  <chapter eid="PSA 83"/>
  <chapter number="84" style="c" sid="PSA 84"/>
  <para style="s1">Xoossa Keethi Bishe Yexia Mazmure</para>
  <para style="d">Zammaareta halaqaas Qore nayti xaafida Suusul7en yexetiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 84:1"/>Ubbaafe Wolqaama Godaw,</para>
  <para style="q2" vid="PSA 84:1">ne de7iya bessay waani lo77i!<verse eid="PSA 84:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 84:2"/>Taani Godaa keetha dabaaba laamotayis;</para>
  <para style="q2" vid="PSA 84:2">ta kumetha asatethay</para>
  <para style="q2" vid="PSA 84:2">de7o Xoossaas ufaysan yexees.<verse eid="PSA 84:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 84:3"/>Ubbaafe Wolqaama Godaw,</para>
  <para style="q2" vid="PSA 84:3">ta kawaw, ta Xoossaw,</para>
  <para style="q2" vid="PSA 84:3">ne yarsho bessa matan</para>
  <para style="q2" vid="PSA 84:3">buube kafoy baw de7iya bessi demmasu;</para>
  <para style="q2" vid="PSA 84:3">holleyka ba nayta wothiya keethe keexasu.<verse eid="PSA 84:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 84:4"/>Ne keethan de7eysatinne</para>
  <para style="q2" vid="PSA 84:4">merinaw nena sabbeysati anjetidaysata. <char style="qs">Salaha </char><verse eid="PSA 84:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 84:5"/>Nena banta minotethi ootheysati,</para>
  <para style="q2" vid="PSA 84:5">banta wozanaa Xiyoone ogiya bolla,</para>
  <para style="q2" vid="PSA 84:5">wotheysati anjetidaysata.<verse eid="PSA 84:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 84:6"/>Enti yeeho zangaarara aadhiya wode,</para>
  <para style="q2" vid="PSA 84:6">he bessay pultoy keyiya bessi gidis;</para>
  <para style="q2" vid="PSA 84:6">torche iray bukidi ollaa kunthees.<verse eid="PSA 84:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 84:7"/>Enti wolqa bolla wolqa guji guji baana;</para>
  <para style="q2" vid="PSA 84:7">issoy issoy Xoossa sinthan Xiyoonen bentana.<verse eid="PSA 84:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 84:8"/>Ubbaafe Wolqaama Godaw Xoossaw,</para>
  <para style="q2" vid="PSA 84:8">ta woosa neeni si7a;</para>
  <para style="q2" vid="PSA 84:8">Yayqooba Xoossaw hayza. <char style="qs">Salaha </char><verse eid="PSA 84:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 84:9"/>Xoossaw, nu gondalliya be7a;</para>
  <para style="q2" vid="PSA 84:9">ne doorida kawa keeha ayfen xeella.<verse eid="PSA 84:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 84:10"/>Taani hara bessan mukulu gallas daanape,</para>
  <para style="q2" vid="PSA 84:10">ne dabaaban issi gallas de7eysi taw lo77o.</para>
  <para style="q1" vid="PSA 84:10">Iitata dunkaaniyan daanape,</para>
  <para style="q2" vid="PSA 84:10">Xoossa keetha penge naagoy taw lo77o.<verse eid="PSA 84:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 84:11"/>Godaa Xoossay nuus gondallenne poo7o;</para>
  <para style="q2" vid="PSA 84:11">nuus bonchonne keehatethi immees;</para>
  <para style="q2" vid="PSA 84:11">suuretethan hemeteyisata lo77oba diggenna.<verse eid="PSA 84:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 84:12"/>Ubbaafe Wolqaama Godaw,</para>
  <para style="q2" vid="PSA 84:12">nenan ammaneteysati anjetidaysata.<verse eid="PSA 84:12"/></para>
  <chapter eid="PSA 84"/>
  <chapter number="85" style="c" sid="PSA 85"/>
  <para style="s1">Nuna Zaarada Denthetha</para>
  <para style="d">Zammaareta halaqaas xaafetida Qore nayta mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 85:1"/>Godaw, neeni ne biittas keehadasa;</para>
  <para style="q2" vid="PSA 85:1">Yayqooba kochaa di7ope guye zaaradasa.<verse eid="PSA 85:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 85:2"/>Ne asaa naaquwa atto gadasa;</para>
  <para style="q2" vid="PSA 85:2">enta nagaraa ubbaa kammadasa. <char style="qs">Salaha </char><verse eid="PSA 85:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 85:3"/>Ne yiluwa aggadasa;</para>
  <para style="q2" vid="PSA 85:3">suulliya ne hanquwafe simmadasa.<verse eid="PSA 85:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 85:4"/>Abeeti nuna ashshiya Xoossaw,</para>
  <para style="q2" vid="PSA 85:4">nuna guye zaara;</para>
  <para style="q2" vid="PSA 85:4">nu bolla lancidaysa agga.<verse eid="PSA 85:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 85:5"/>Neeni nu bolla merinaw shenetayee?</para>
  <para style="q2" vid="PSA 85:5">Ne hanquwafe simmikiyee?<verse eid="PSA 85:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 85:6"/>Nuuni nenan ufaytana mela,</para>
  <para style="q2" vid="PSA 85:6">nuna zaarada oorathikiyee?<verse eid="PSA 85:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 85:7"/>Abeeti Godaw, ne merina siiquwa nuna bessa;</para>
  <para style="q2" vid="PSA 85:7">nuna ashsha.<verse eid="PSA 85:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 85:8"/>Godaa Xoossay odiyaba taani si7ana;</para>
  <para style="q2" vid="PSA 85:8">enti banta eeya ogiyako simmonna ixiko,</para>
  <para style="q2" vid="PSA 85:8">I ba geeshsha deriyas sarotethi odees.<verse eid="PSA 85:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 85:9"/>Iya bonchoy nu biittan daana mela,</para>
  <para style="q2" vid="PSA 85:9">Xoossaa yayyeyisata ashshanaw I matan de7ees.<verse eid="PSA 85:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 85:10"/>Siiqoynne tumatethi gahetidosona;</para>
  <para style="q2" vid="PSA 85:10">Xillotethinne sarotethi idimetidosona.<verse eid="PSA 85:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 85:11"/>Tumatethi sa7aape pude keyees;</para>
  <para style="q2" vid="PSA 85:11">xillotethi salope duge xeellees.<verse eid="PSA 85:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 85:12"/>Xoossay lo77oba nuus immana;</para>
  <para style="q2" vid="PSA 85:12">nu biittay daro kathi ayfana.<verse eid="PSA 85:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 85:13"/>Xillotethi Godaa sinthan hemetana;</para>
  <para style="q2" vid="PSA 85:13">iya ogiya giigisana.<verse eid="PSA 85:13"/></para>
  <chapter eid="PSA 85"/>
  <chapter number="86" style="c" sid="PSA 86"/>
  <para style="s1">Xoossa Siiqoy Gita</para>
  <para style="d">Dawita Woosa</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 86:1"/>Godaw, taani manqonne metootancho gidiya gisho,</para>
  <para style="q2" vid="PSA 86:1">ta woosa si7ada tana alla.<verse eid="PSA 86:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 86:2"/>Ta new dummatida asi gidiya gisho, tana de7on wotha;</para>
  <para style="q2" vid="PSA 86:2">nenan ammanetiya tana, ne aylliya ashsha;</para>
  <para style="q2" vid="PSA 86:2">neeni ta Xoossa.<verse eid="PSA 86:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 86:3"/>Godaw, gallas kumethi ta neeko waassiya gisho,</para>
  <para style="q2" vid="PSA 86:3">taw qadheta.<verse eid="PSA 86:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 86:4"/>Godaw, ta shempoy neeko waassiya gisho,</para>
  <para style="q2" vid="PSA 86:4">tana, ne aylliya ufaysa.<verse eid="PSA 86:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 86:5"/>Godaw, neeni keehanne atto geysa;</para>
  <para style="q2" vid="PSA 86:5">nena xeegiya ubbaas ne siiqoy daro.<verse eid="PSA 86:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 86:6"/>Abeeti Godaw, ta woosa si7a;</para>
  <para style="q2" vid="PSA 86:6">ta waasuwa hayza.<verse eid="PSA 86:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 86:7"/>Ne ta woosaas zaaro immiya gisho,</para>
  <para style="q2" vid="PSA 86:7">ta metuwa gallasan ta neeko waassana.<verse eid="PSA 86:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 86:8"/>Godaw, xoossata giddon ne meli baawa;</para>
  <para style="q2" vid="PSA 86:8">ne oosuwara giney baawa.<verse eid="PSA 86:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 86:9"/>Godaw, neeni medhida kawotethati yidi,</para>
  <para style="q2" vid="PSA 86:9">ne sinthan gulbatana; ne sunthaa bonchana.<verse eid="PSA 86:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 86:10"/>Neeni gita; ne malaalsiya ooso oothiya gisho</para>
  <para style="q2" vid="PSA 86:10">Xoossi ne xalaala.<verse eid="PSA 86:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 86:11"/>Godaw, ta ne tuman hemetana mela,</para>
  <para style="q2" vid="PSA 86:11">tana ne ogiya tamaarsa.</para>
  <para style="q1" vid="PSA 86:11">Taani ne sunthaas yayyana mela,</para>
  <para style="q2" vid="PSA 86:11">taw issi wozanaa imma.<verse eid="PSA 86:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 86:12"/>Godaw ta Xoossaw,</para>
  <para style="q2" vid="PSA 86:12">taani nena ta kumetha wozanan galatana;</para>
  <para style="q2" vid="PSA 86:12">ne sunthaa merinaw bonchana.<verse eid="PSA 86:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 86:13"/>Ne siiqoy taw daro;</para>
  <para style="q2" vid="PSA 86:13">tana duufope ashshadasa.<verse eid="PSA 86:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 86:14"/>Xoossaw, otoranchoti ta bolla dendidosona;</para>
  <para style="q2" vid="PSA 86:14">iita asata cugay tana wodhanaw koyees;</para>
  <para style="q2" vid="PSA 86:14">enti nena wuda gookona.<verse eid="PSA 86:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 86:15"/>Shin abeeti Godaw,</para>
  <para style="q2" vid="PSA 86:15">neeni qadhetiyanne maariya Xoosse.</para>
  <para style="q1" vid="PSA 86:15">Neeni hanqetanaw gam7aasa;</para>
  <para style="q2" vid="PSA 86:15">siiqoynne ammanetethi daridaysa.<verse eid="PSA 86:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 86:16"/>Taako simmada taw qadheta;</para>
  <para style="q2" vid="PSA 86:16">ne aylliyas wolqa imma;</para>
  <para style="q2" vid="PSA 86:16">ne gadhinde na7aa tana ashsha.<verse eid="PSA 86:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 86:17"/>Godaw, ne keehatetha malaata tana bessa;</para>
  <para style="q2" vid="PSA 86:17">ne tana maaddeysanne minthetheysa be7iya wode,</para>
  <para style="q2" vid="PSA 86:17">ta morketi yeellatana.<verse eid="PSA 86:17"/></para>
  <chapter eid="PSA 86"/>
  <chapter number="87" style="c" sid="PSA 87"/>
  <para style="s1">Xiyoone Katama</para>
  <para style="d">Qore Nayta Mazmure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 87:1"/>Godaa katamay,</para>
  <para style="q2" vid="PSA 87:1">geeshsha deriya bolla keexetis.<verse eid="PSA 87:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 87:2"/>Goday Xiyoone pengeta,</para>
  <para style="q2" vid="PSA 87:2">Yayqoobi de7iya hara bessatape aathidi dosees.<verse eid="PSA 87:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 87:3"/>Neno Xoossaa katamaw,</para>
  <para style="q2" vid="PSA 87:3">ne gisho malaalsiyabata haysada yaagidi odis. <char style="qs">Salaha </char><verse eid="PSA 87:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 87:4"/>“Tana eriya kawotethata giddofe,</para>
  <para style="q2" vid="PSA 87:4">taani Raabanne Babiloone mazgabana.</para>
  <para style="q1" vid="PSA 87:4">Filisxeemey, Xiroosinne Tophey,</para>
  <para style="q2" vid="PSA 87:4">yan yeletidosona.”<verse eid="PSA 87:4"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 87:5"/>Xoossay Xiyoones,</para>
  <para style="q2" vid="PSA 87:5">“Ya derey ha derey Xiyoonen yeletis;</para>
  <para style="q2" vid="PSA 87:5">Ubbaafe Dhoqa Xoossay iyo minthana” yaagees.<verse eid="PSA 87:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 87:6"/>Goday asaa mazgaben xaafiya wode,</para>
  <para style="q2" vid="PSA 87:6">“Haysi Xiyoonen yeletis” yaagana. <char style="qs">Salaha </char><verse eid="PSA 87:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 87:7"/>Enti yexishenne durishe,</para>
  <para style="q2" vid="PSA 87:7">“Nu anjo ubbay Xiyoonepe pultees” yaagana.<verse eid="PSA 87:7"/></para>
  <chapter eid="PSA 87"/>
  <chapter number="88" style="c" sid="PSA 88"/>
  <para style="s1">Qammanne Gallas Neeko Waassayis</para>
  <para style="d">Zammaareta Halaqaas Xaafetida Qore Nayta Mazmure</para>
  <para style="d">Akeekan xaafida ginxo; aaretho mazmure</para>
  <para style="d">Izra7eela addiya Emaana mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 88:1"/>Godaw, tana ashshiya Xoossaw,</para>
  <para style="q2" vid="PSA 88:1">taani gallas neeko waassayis;</para>
  <para style="q2" vid="PSA 88:1">qamma ne sinthan yeekayis.<verse eid="PSA 88:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 88:2"/>Ta woosay ne sinthe gako;</para>
  <para style="q2" vid="PSA 88:2">ne haythay ta waasuwa si7o.<verse eid="PSA 88:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 88:3"/>Ta shempoy meto kallida gisho,</para>
  <para style="q2" vid="PSA 88:3">ta de7oy duufoko matis.<verse eid="PSA 88:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 88:4"/>Duufo geliya asaara taybetas;</para>
  <para style="q2" vid="PSA 88:4">wolqi bayna asi gidas.<verse eid="PSA 88:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 88:5"/>Taani ahata giddon yegetida asa mela;</para>
  <para style="q2" vid="PSA 88:5">hayqidi duufon zin7ida asa mela.</para>
  <para style="q1" vid="PSA 88:5">Hizape neeni hassayonna asinne</para>
  <para style="q2" vid="PSA 88:5">neepe duuxida asa mela gidas.<verse eid="PSA 88:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 88:6"/>Neeni tana ciimmon,</para>
  <para style="q2" vid="PSA 88:6">dhuma ollan yeggadasa.<verse eid="PSA 88:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 88:7"/>Ne hanqoy tana deexees;</para>
  <para style="q2" vid="PSA 88:7">ne hanquwa beetay tana muukis. <char style="qs">Salaha </char><verse eid="PSA 88:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 88:8"/>Neeni ta dabbota taape haassadasa;</para>
  <para style="q2" vid="PSA 88:8">enti tana shaatettana mela oothadasa.</para>
  <para style="q1" vid="PSA 88:8">Tana teqidosona;</para>
  <para style="q2" vid="PSA 88:8">kessa ekanaw danda7ike.<verse eid="PSA 88:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 88:9"/>Godaw, azzanon ta ayfey teljumis;</para>
  <para style="q2" vid="PSA 88:9">Ubba gallas taani neeko waassayis;</para>
  <para style="q2" vid="PSA 88:9">ta kushiya neeko miccas.<verse eid="PSA 88:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 88:10"/>Hayqidaysatas ne malaalsiyaba oothayee?</para>
  <para style="q2" vid="PSA 88:10">Enti dendidi nena galatonayee? <char style="qs">Salaha </char><verse eid="PSA 88:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 88:11"/>Merinaa ne siiqoy duufon,</para>
  <para style="q2" vid="PSA 88:11">ne ammanetethay dhayo bessan odetiyee?<verse eid="PSA 88:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 88:12"/>Ne malaalsiya oosoy dhuman,</para>
  <para style="q2" vid="PSA 88:12">ne xillotethay dogetida biittan eretiyee?<verse eid="PSA 88:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 88:13"/>Godaw, ta neeko waassayis;</para>
  <para style="q2" vid="PSA 88:13">wonta wonta ta woosay ne sinthe gakees.<verse eid="PSA 88:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 88:14"/>Godaw, ne tana ayis ixay?</para>
  <para style="q2" vid="PSA 88:14">Ne som7uwa taape ayis genthay?<verse eid="PSA 88:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 88:15"/>Na7atethafe doomada taani un7etas;</para>
  <para style="q2" vid="PSA 88:15">hayqos matas;</para>
  <para style="q2" vid="PSA 88:15">ne tana daganthin ufaysi qanxas.<verse eid="PSA 88:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 88:16"/>Ne suulliya hanqoy ta bolla uushis;</para>
  <para style="q2" vid="PSA 88:16">ne daganthoy tana dhaysis.<verse eid="PSA 88:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 88:17"/>Enti gallas kumethi di7oda tana teqidosona;</para>
  <para style="q2" vid="PSA 88:17">issife shiiqidi tana oykidosona.<verse eid="PSA 88:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 88:18"/>Ta laggetanne</para>
  <para style="q2" vid="PSA 88:18">taw mata asata taape haassadasa;</para>
  <para style="q2" vid="PSA 88:18">taw dabboy dhuma xalaala.<verse eid="PSA 88:18"/></para>
  <chapter eid="PSA 88"/>
  <chapter number="89" style="c" sid="PSA 89"/>
  <para style="s1">Ammanthiya Xoossas Yexite</para>
  <para style="d">Izra7eela Addiya Etaana Mazmure</para>
  <para style="d">Akeekan xaafida ginxo</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 89:1"/>Godaw, ne siiquwaba taani merinaw yexana;</para>
  <para style="q2" vid="PSA 89:1">ne ammanetetha yeleta ubbaas awaajana.<verse eid="PSA 89:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 89:2"/>Ne siiqoy merinaw eqidaysanne</para>
  <para style="q2" vid="PSA 89:2">tumatethaa neeni salon minthada essidaysa odana.<verse eid="PSA 89:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 89:3"/>Neeni, “Ta dooridaysara qaala gelas;</para>
  <para style="q2" vid="PSA 89:3">Ta aylliya Dawitas haysada yaagada caaqas;<verse eid="PSA 89:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 89:4"/>‘Taani ne kochaa merinaw kawothana;</para>
  <para style="q2" vid="PSA 89:4">ne araata yeleta ubban minthana’ ” yaagadasa. <char style="qs">Salaha </char><verse eid="PSA 89:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 89:5"/>Godaw, saloti ne malaalsiya oosuwa awaajo;</para>
  <para style="q2" vid="PSA 89:5">geeshshata shiiqoy ne ammanetetha odo.<verse eid="PSA 89:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 89:6"/>Salon Godaara liketanaw danda7ey oonee?</para>
  <para style="q2" vid="PSA 89:6">Salo medhetethata giddon Godaa meli oonee?<verse eid="PSA 89:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 89:7"/>Geeshshata shiiquwan Xoossay yashisees;</para>
  <para style="q2" vid="PSA 89:7">iya yuushuwan de7iya ubbaafe aadhidi daganthees.<verse eid="PSA 89:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 89:8"/>Ubbaafe Wolqaama Godaw Xoossaw,</para>
  <para style="q2" vid="PSA 89:8">ne mela wolqaami oonee?</para>
  <para style="q2" vid="PSA 89:8">Godaw, neeni ubbaban ammanetaasa.<verse eid="PSA 89:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 89:9"/>Neeni guummiya abba wolqaa kiittasa;</para>
  <para style="q2" vid="PSA 89:9">dendiya zuliya si77i oothaasa.<verse eid="PSA 89:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 89:10"/>Ra7aaba geetetiya do7a mentherethadasa;</para>
  <para style="q2" vid="PSA 89:10">ne morketa ne wolqaama qesiyan laalladasa.<verse eid="PSA 89:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 89:11"/>Saloynne sa7i nebaa;</para>
  <para style="q2" vid="PSA 89:11">alamiyanne iyan de7iya ubbaa medhiday nena.<verse eid="PSA 89:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 89:12"/>Pudehanne dugeha ne medhadasa;</para>
  <para style="q2" vid="PSA 89:12">Taaborenne Armoona zumati,</para>
  <para style="q2" vid="PSA 89:12">ufaysan ne sunthaa sabboosona.<verse eid="PSA 89:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 89:13"/>New wolqaama qesey de7ees;</para>
  <para style="q2" vid="PSA 89:13">ne kushey mino;</para>
  <para style="q2" vid="PSA 89:13">ne ushacha kushey dhoqu gis.<verse eid="PSA 89:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 89:14"/>Xillotethinne suure pirdi ne araatas baaso;</para>
  <para style="q2" vid="PSA 89:14">siiqoynne tumatethi ne sinthan boosona.<verse eid="PSA 89:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 89:15"/>Godaw, ufaysan ilileysatnne</para>
  <para style="q2" vid="PSA 89:15">ne som7uwa poo7uwan hemeteysati anjetidaysata.<verse eid="PSA 89:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 89:16"/>Ne sunthan gallas kumethi ufaytoosona;</para>
  <para style="q2" vid="PSA 89:16">enti ne xillotethaa dhoqu dhoqu oothosona.<verse eid="PSA 89:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 89:17"/>Enti ceeqetiya wolqay nena;</para>
  <para style="q2" vid="PSA 89:17">ne teeman nu kacey dhoqu dhoqu gis.<verse eid="PSA 89:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 89:18"/>Nu gondalley nu Godaa kushena;</para>
  <para style="q2" vid="PSA 89:18">nu kawoyka Isra7eele geeshshaa kushena.<verse eid="PSA 89:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 89:19"/>Beni neeni, ne ammanetida asaas</para>
  <para style="q2" vid="PSA 89:19">qoncethan haysada yaagadasa.</para>
  <para style="q1" vid="PSA 89:19">“Taani issi olanchuwa maaddas;</para>
  <para style="q2" vid="PSA 89:19">asaa giddofe dooretidaysa dhoqu dhoqu oothas.<verse eid="PSA 89:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 89:20"/>Ta aylliya Dawita demmas;</para>
  <para style="q2" vid="PSA 89:20">ta geeshsha zaytiya tiyada iya kawothas.<verse eid="PSA 89:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 89:21"/>Ta kushe iyara daana;</para>
  <para style="q2" vid="PSA 89:21">ta qesey iya minthana.<verse eid="PSA 89:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 89:22"/>Iya ay morkeyka giirisenna;</para>
  <para style="q2" vid="PSA 89:22">ay iita asika iya haarenna.<verse eid="PSA 89:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 89:23"/>Iya morketa ta iya sinthan tincherethana;</para>
  <para style="q2" vid="PSA 89:23">iya ixeyisata shoca yeggana.<verse eid="PSA 89:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 89:24"/>Ta tumatethaynne ta siiqoy iyara gidana;</para>
  <para style="q2" vid="PSA 89:24">ta sunthan iya kacey dhoqu dhoqu gaana.<verse eid="PSA 89:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 89:25"/>Taani iya kawotethaa Medetiraane Abbaa,</para>
  <para style="q2" vid="PSA 89:25">iya zawa shaafata gakanaw aassana.<verse eid="PSA 89:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 89:26"/>I tana, ‘Neeni ta aawa, ta Xoossaa;</para>
  <para style="q2" vid="PSA 89:26">tana ashshiya zaalla’ yaagidi xeegana.<verse eid="PSA 89:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 89:27"/>Taani iya bayra na7a oothana;</para>
  <para style="q2" vid="PSA 89:27">sa7an de7iya kawota ubbaafe iya gitayana.<verse eid="PSA 89:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 89:28"/>Taani ta siiquwa merinaw iyaw naagana;</para>
  <para style="q2" vid="PSA 89:28">taani iyara caaqida caaquwa minthana.<verse eid="PSA 89:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 89:29"/>Taani iya kochaa merinaw minthada essana;</para>
  <para style="q2" vid="PSA 89:29">iya araata saloda gam7isana.”<verse eid="PSA 89:29"/></para>
  <para style="b"/>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 89:30"/>“Shin iya kochati ta higgiya aggiko,</para>
  <para style="q2" vid="PSA 89:30">enti ta wogaada hemetonna ixiko,<verse eid="PSA 89:30"/></para>
  <para style="q2">
    <verse number="31" style="v" sid="PSA 89:31"/>ta awaajuwa shaariko,</para>
  <para style="q2" vid="PSA 89:31">ta kiita naagonna ixiko,<verse eid="PSA 89:31"/></para>
  <para style="q2">
    <verse number="32" style="v" sid="PSA 89:32"/>taani enta nagaraa gisho xam7an,</para>
  <para style="q2" vid="PSA 89:32">enta iitatethaa gisho lisson seerana.<verse eid="PSA 89:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 89:33"/>Shin taani ta siiquwa iyape ekike;</para>
  <para style="q2" vid="PSA 89:33">taani iyaw merinaw ammanetana.<verse eid="PSA 89:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 89:34"/>Taani entara caaqida caaquwa menthike;</para>
  <para style="q2" vid="PSA 89:34">ta doonape keyida qaala laammike.<verse eid="PSA 89:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 89:35"/>Taani issi toho ta geeshshatethan caaqida gisho,</para>
  <para style="q2" vid="PSA 89:35">Dawitas wordotike.<verse eid="PSA 89:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 89:36"/>Iya kochay merinaw daana;</para>
  <para style="q2" vid="PSA 89:36">iya araatay ta sinthan awada gam7ana.<verse eid="PSA 89:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 89:37"/>Salon ammanetiya marka gidida ageenada,</para>
  <para style="q2" vid="PSA 89:37">iya kawotethay merinaw minnidi daana” yaagadasa. <char style="qs">Salaha </char><verse eid="PSA 89:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 89:38"/>Shin ha77i ne tiyida kawa bolla hanqetadasa;</para>
  <para style="q2" vid="PSA 89:38">iya ixadasa; aggadasa.<verse eid="PSA 89:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 89:39"/>Ne aylliyara caaqida caaquwa menthadasa;</para>
  <para style="q2" vid="PSA 89:39">iya kallachaa baanan holada tunisadasa.<verse eid="PSA 89:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 89:40"/>Iya katamaa gimbe dirsa laalladasa;</para>
  <para style="q2" vid="PSA 89:40">iya miixaa dhaysadasa.<verse eid="PSA 89:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 89:41"/>Ogera aadhiya ubbay iya bonqidosona;</para>
  <para style="q2" vid="PSA 89:41">I ba shoorotas miichas attis.<verse eid="PSA 89:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 89:42"/>Iya morketas xoono immadasa,</para>
  <para style="q2" vid="PSA 89:42">enta ubbaa ufaysadasa.<verse eid="PSA 89:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 89:43"/>Iya mashshaa xeeraa qalam7adasa;</para>
  <para style="q2" vid="PSA 89:43">iya olan maaddabaaka.<verse eid="PSA 89:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 89:44"/>Iya kawota xam7aa iya kushepe ekadasa;</para>
  <para style="q2" vid="PSA 89:44">iya araata biittan holadasa.<verse eid="PSA 89:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 89:45"/>Iya yalagatetha wodiya qaamisadasa;</para>
  <para style="q2" vid="PSA 89:45">iya yeella mayzadasa. <char style="qs">Salaha </char><verse eid="PSA 89:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 89:46"/>Godaw, neeni awude gakanaw gam7ay?</para>
  <para style="q2" vid="PSA 89:46">Neeni merinaw geemmanee?</para>
  <para style="q2" vid="PSA 89:46">Ne hanqoy tamada awude gakanaw eexanee?<verse eid="PSA 89:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 89:47"/>Ta laythay ay mela qantheko qopa;</para>
  <para style="q2" vid="PSA 89:47">asa ubbaa coo mela medhadi!<verse eid="PSA 89:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 89:48"/>Hayqope attanaw danda7iya asi de7ii?</para>
  <para style="q2" vid="PSA 89:48">Duufo gelonna daanaw danda7ey oonee? <char style="qs">Salaha </char><verse eid="PSA 89:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 89:49"/>Godaw, neeni ne tumatethan Dawitas caaqida,</para>
  <para style="q2" vid="PSA 89:49">ne siiqoy awun de7ii?<verse eid="PSA 89:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 89:50"/>Godaw, ne aylley ay mela boretidaako be7a;</para>
  <para style="q2" vid="PSA 89:50">asa ubbaa boriya waata danda7idaako hassaya.<verse eid="PSA 89:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 89:51"/>Godaw, ne morketi qelqisidaysa,</para>
  <para style="q2" vid="PSA 89:51">ne tiyida kawa tangon tangon boreysa be7a.<verse eid="PSA 89:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 89:52"/>Goday merinaw galatetto!</para>
  <para style="b" vid="PSA 89:52"/>
  <para style="qc" vid="PSA 89:52">Amin7i! Amin7i!<verse eid="PSA 89:52"/></para>
  <chapter eid="PSA 89"/>
  <chapter number="90" style="c" sid="PSA 90"/>
  <para style="ms">Oyddantho Maxaafa</para>
  <para style="mr">(<ref loc="PSA 90-106">Maz 90—106</ref>)</para>
  <para style="s1">Merinaw De7iya Xoossa</para>
  <para style="d">Xoossa asi gidida Muse woosa</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 90:1"/>Godaw, neeni yeletape yeletaa gakanaw,</para>
  <para style="q2" vid="PSA 90:1">nuuni de7iya bessi gidadasa.<verse eid="PSA 90:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 90:2"/>Dereti medhetanaape kase,</para>
  <para style="q2" vid="PSA 90:2">sa7i oosetanaape kase,</para>
  <para style="q2" vid="PSA 90:2">merinaape merinaa gakanaw ne Xoosse.<verse eid="PSA 90:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 90:3"/>Neeni, “Asa nayto, guye biittako simmite” yaagada,</para>
  <para style="q2" vid="PSA 90:3">enta medhetida biittako guye zaarasa.<verse eid="PSA 90:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 90:4"/>Mukulu laythi zine aadhida gallasa mela;</para>
  <para style="q2" vid="PSA 90:4">woyko issi qamma giddon issi saate mela.<verse eid="PSA 90:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 90:5"/>Neeni asaa qoponna di7oda efaasa;</para>
  <para style="q2" vid="PSA 90:5">enti amuho mela;</para>
  <para style="q2" vid="PSA 90:5">wonta wonta doliya maata mela.<verse eid="PSA 90:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 90:6"/>Maati wonta diccidi ciyees;</para>
  <para style="q2" vid="PSA 90:6">omarsiya wode shullidi melees.<verse eid="PSA 90:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 90:7"/>Nuuni ne yiluwan wurida;</para>
  <para style="q2" vid="PSA 90:7">ne hanquwa suulon dagammida.<verse eid="PSA 90:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 90:8"/>Nu iita oosuwa ne sinthan wothadasa;</para>
  <para style="q2" vid="PSA 90:8">nu geemmida nagaraa ne som7uwa poo7uwan wothadasa.<verse eid="PSA 90:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 90:9"/>Nu gallasa ubbay ne hanquwan aadhis;</para>
  <para style="q2" vid="PSA 90:9">nu laytha oolen wursoos.<verse eid="PSA 90:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 90:10"/>Nu de7o laythay laapun tamma;</para>
  <para style="q2" vid="PSA 90:10">woyko dariko hospun tamma.</para>
  <para style="q1" vid="PSA 90:10">Hessika metoynne waayey kumidaysa;</para>
  <para style="q2" vid="PSA 90:10">nu laythay eeson wurees; nuka eeson aadhoos.<verse eid="PSA 90:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 90:11"/>Ne hanquwa wolqaa erey oonee?</para>
  <para style="q2" vid="PSA 90:11">ne hanquwa suuloy wolqaama.<verse eid="PSA 90:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 90:12"/>Nu laytha maara ogen nu go7etana mela,</para>
  <para style="q2" vid="PSA 90:12">nuna cincatethi tamaarsa.<verse eid="PSA 90:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 90:13"/>Godaw, ne hanqoy awude gakanaasee?</para>
  <para style="q2" vid="PSA 90:13">hayyana ne aylletas qadheta.<verse eid="PSA 90:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 90:14"/>Nu laytha ubban</para>
  <para style="q2" vid="PSA 90:14">nu ufaytanaadanne yexanaada,</para>
  <para style="q2" vid="PSA 90:14">wonta wonta ne siiquwa nuna kalsa.<verse eid="PSA 90:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 90:15"/>Ne nuna metoothida gallasata keena,</para>
  <para style="q2" vid="PSA 90:15">nuuni un7etida laythata keena nuna ufaysa.<verse eid="PSA 90:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 90:16"/>Nuus ne aylletas ne oosoy qonco;</para>
  <para style="q2" vid="PSA 90:16">ne bonchoy enta naytas bento.<verse eid="PSA 90:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 90:17"/>Godaa nu Xoossaa keehatethay nu bolla gido;</para>
  <para style="q2" vid="PSA 90:17">nu kushe ooso ubba nuus ayfisa;</para>
  <para style="q2" vid="PSA 90:17">Ee, nu kushe ooso ubbaa ayfisa.<verse eid="PSA 90:17"/></para>
  <chapter eid="PSA 90"/>
  <chapter number="91" style="c" sid="PSA 91"/>
  <para style="s1">Xoossa Naago</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 91:1"/>Ubbaafe Dhoqa Xoossan naagetidi de7ey,</para>
  <para style="q2" vid="PSA 91:1">Ubbaafe Wolqaama Xoossaa kuyan aqees.<verse eid="PSA 91:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 91:2"/>I Godaa, “Neeni taw miixanne qosetta attiya bessi,</para>
  <para style="q2" vid="PSA 91:2">neeni tana ammanthiya ta Xoossaa” yaagana.<verse eid="PSA 91:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 91:3"/>I nena shankanchota xihepe,</para>
  <para style="q2" vid="PSA 91:3">wodhidi ongiya gadope ashshana.<verse eid="PSA 91:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 91:4"/>I ba baalletan nena kammana;</para>
  <para style="q2" vid="PSA 91:4">iya qefiya garsan neeni qosetada attana;</para>
  <para style="q2" vid="PSA 91:4">iya ammanetethay new gondallenne kate.<verse eid="PSA 91:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 91:5"/>Neeni qamma daganthiyabas,</para>
  <para style="q2" vid="PSA 91:5">woyko gallas xongetiya tooras yayyaka.<verse eid="PSA 91:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 91:6"/>Neeni dhuman oykiya harge,</para>
  <para style="q2" vid="PSA 91:6">woyko gallasa seetan ongiya gado hirgaka.<verse eid="PSA 91:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 91:7"/>Mukulay ne miyen,</para>
  <para style="q2" vid="PSA 91:7">tammu mukulay ne ushachan kundana;</para>
  <para style="q2" vid="PSA 91:7">shin nena aybika bochenna.<verse eid="PSA 91:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 91:8"/>Iitati seeretishin,</para>
  <para style="q2" vid="PSA 91:8">neeni ne ayfe xalaalan be7ana.<verse eid="PSA 91:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 91:9"/>Neeni Godaa new qosetada attiya bessi oothida gishonne,</para>
  <para style="q1" vid="PSA 91:9">Ubbaafe Dhoqa Xoossaa ne de7iya bessi oothida gisho,<verse eid="PSA 91:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 91:10"/>iitabay nena bochenna;</para>
  <para style="q2" vid="PSA 91:10">gadoy ne keethaako shiiqenna.<verse eid="PSA 91:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 91:11"/>Ne oge ubban nena naagana mela,</para>
  <para style="q2" vid="PSA 91:11">Xoossay ba kiitanchota kiittana.<verse eid="PSA 91:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 91:12"/>Ne tohoy shuchan dhubetonna mela,</para>
  <para style="q2" vid="PSA 91:12">kiitanchoti banta kushen nena denthana.<verse eid="PSA 91:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 91:13"/>Neeni gaammonne shoosha bolla hemetana;</para>
  <para style="q2" vid="PSA 91:13">wodala gaammonne iita shooshaa yedhana.<verse eid="PSA 91:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 91:14"/>Xoossay,</para>
  <para style="q2" vid="PSA 91:14">“I tana siiqida gisho taani iya ashshana;</para>
  <para style="q2" vid="PSA 91:14">ta sunthaa eriya gisho taani iya naagana.<verse eid="PSA 91:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 91:15"/>I tana xeegiya wode taani iyaw koyana;</para>
  <para style="q2" vid="PSA 91:15">meto wode taani iyara gidana;</para>
  <para style="q2" vid="PSA 91:15">taani iya ashshananne bonchana.<verse eid="PSA 91:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 91:16"/>Taani iya laytha adussana;</para>
  <para style="q2" vid="PSA 91:16">ta atotetha iya bessaana” yaagees.<verse eid="PSA 91:16"/></para>
  <chapter eid="PSA 91"/>
  <chapter number="92" style="c" sid="PSA 92"/>
  <para style="s1">Xoossa Oosoy Gita</para>
  <para style="d">Sambaata gallasa mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 92:1"/>Godaa galatoy lo77o;</para>
  <para style="q2" vid="PSA 92:1">Ubbaafe Dhoqa Xoossaw,</para>
  <para style="q2" vid="PSA 92:1">ne suntha saboy lo77o.<verse eid="PSA 92:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 92:2"/>Wonta wonta ne siiquwa odoy,</para>
  <para style="q2" vid="PSA 92:2">qamma ne ammanetetha awaajoy lo77o.<verse eid="PSA 92:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 92:3"/>Tammu shayan waaxetida diithan</para>
  <para style="q2" vid="PSA 92:3">maasinqo kaa7ishe nena galatoy lo77o.<verse eid="PSA 92:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 92:4"/>Taani ne oosuwan ufaytida gisho,</para>
  <para style="q2" vid="PSA 92:4">ne kushe oosuwa gisho nena galatayis.<verse eid="PSA 92:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 92:5"/>Godaw, ne oosoy ay mela gite!</para>
  <para style="q2" vid="PSA 92:5">Ne qofay ay mela ciimmo!<verse eid="PSA 92:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 92:6"/>Eeya asi eranaw danda7enna;</para>
  <para style="q2" vid="PSA 92:6">wozani bayna asi akeekanaw danda7enna.<verse eid="PSA 92:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 92:7"/>Iitati maatada diccikoka,</para>
  <para style="q2" vid="PSA 92:7">iita ootheysati daaykoka,</para>
  <para style="q2" vid="PSA 92:7">enti merinaw dhayana.<verse eid="PSA 92:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 92:8"/>Shin abeeti Godaw,</para>
  <para style="q2" vid="PSA 92:8">neeni merinaw ubbaafe dhoqa.<verse eid="PSA 92:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 92:9"/>Abeeti Godaw, tuma ne morketi dhayana;</para>
  <para style="q2" vid="PSA 92:9">iita oothiya ubbay piski gaana.<verse eid="PSA 92:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 92:10"/>Ta kaciya mentha kaceda dhoqu oothadasa;</para>
  <para style="q2" vid="PSA 92:10">lo77o zayte ta huuphen tiyadasa.<verse eid="PSA 92:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 92:11"/>Ta morketi xoonetishin ta ayfen be7as;</para>
  <para style="q2" vid="PSA 92:11">tana un7etheysati waassishin ta haythan si7as.<verse eid="PSA 92:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 92:12"/>Xilloti zambada diccana;</para>
  <para style="q2" vid="PSA 92:12">Libaanose zigada daayana.<verse eid="PSA 92:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 92:13"/>Enti Godaa keethan toketida mitha mela;</para>
  <para style="q2" vid="PSA 92:13">enti nu Xoossaa dabaaban daana.<verse eid="PSA 92:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 92:14"/>Enti ceeggidika ayfana;</para>
  <para style="q2" vid="PSA 92:14">enti irxanne cil7o gididi daana.<verse eid="PSA 92:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 92:15"/>Enti, “Goday suure;</para>
  <para style="q2" vid="PSA 92:15">I ta zaalla; iyan iitatethi baawa” yaagana.<verse eid="PSA 92:15"/></para>
  <chapter eid="PSA 92"/>
  <chapter number="93" style="c" sid="PSA 93"/>
  <para style="s1">Xoossay Haarees</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 93:1"/>Goday kawotis!</para>
  <para style="q2" vid="PSA 93:1">Xoossay boncho ma7is; wolqa dancis;</para>
  <para style="q2" vid="PSA 93:1">sa7i minnidi eqis; qaaxenna.<verse eid="PSA 93:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 93:2"/>Ne araatay benipe eqidi de7ees;</para>
  <para style="q2" vid="PSA 93:2">neeni merinaw de7aasa.<verse eid="PSA 93:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 93:3"/>Godaw, shaafay guummis;</para>
  <para style="q2" vid="PSA 93:3">haathay ba guuntha dhoqu oothis</para>
  <para style="q2" vid="PSA 93:3">haatha zuliya girsay si7etis.<verse eid="PSA 93:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 93:4"/>Salon de7iya Goday,</para>
  <para style="q2" vid="PSA 93:4">daro haatha guunthaafe,</para>
  <para style="q2" vid="PSA 93:4">abba zuliyape aadhidi wolqaama.<verse eid="PSA 93:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 93:5"/>Abeeti Godaw, ne higgey ammanetidaysa;</para>
  <para style="q2" vid="PSA 93:5">ne keethay merinaw geeshshatethan alleeqana.<verse eid="PSA 93:5"/></para>
  <chapter eid="PSA 93"/>
  <chapter number="94" style="c" sid="PSA 94"/>
  <para style="s1">Xoossay Ba Asaa Aggenna</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 94:1"/>Godaw, neeni halo keyiya Xoossi;</para>
  <para style="q2" vid="PSA 94:1">kushe zaariya Xoossaw, ne bonchuwa bessa.<verse eid="PSA 94:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 94:2"/>Abeeti sa7aa pirdiya Xoossaw denda;</para>
  <para style="q2" vid="PSA 94:2">otoranchotas bessiya seera imma.<verse eid="PSA 94:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 94:3"/>Godaw, awude gakanaw gam7ay?</para>
  <para style="q2" vid="PSA 94:3">Iitati awude gakanaw ufaytanee?<verse eid="PSA 94:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 94:4"/>Iita ootheysati otoro qaala haasayoosona;</para>
  <para style="q2" vid="PSA 94:4">enti coo ceeqetoosona.<verse eid="PSA 94:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 94:5"/>Godaw, enti ne asaa liiqisoosona;</para>
  <para style="q2" vid="PSA 94:5">enti ne laata naaqoosona.<verse eid="PSA 94:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 94:6"/>Am7etanne betanchota wodhoosona;</para>
  <para style="q2" vid="PSA 94:6">aawi bayna nayta muucosona.<verse eid="PSA 94:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 94:7"/>Enti, “Goday nuna be7enna;</para>
  <para style="q2" vid="PSA 94:7">Yayqooba Xoossay akeekenna” yaagosona.<verse eid="PSA 94:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 94:8"/>Hinteno, asaa giddofe eeyato, akeekite!</para>
  <para style="q2" vid="PSA 94:8">hinteno, eeyato hinte cinca gidanay awudee?<verse eid="PSA 94:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 94:9"/>Haythe oothida Xoossay si7ennee?</para>
  <para style="q2" vid="PSA 94:9">Ayfe medhida Goday be7ennee?<verse eid="PSA 94:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 94:10"/>Kawotethata seeriya Xoossay seerennee?</para>
  <para style="q2" vid="PSA 94:10">Ase eratethi tamaarsiya i, erennee?<verse eid="PSA 94:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 94:11"/>Goday asa qofi pathonnabaanne</para>
  <para style="q2" vid="PSA 94:11">hada gideysa erees.<verse eid="PSA 94:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 94:12"/>Abeeti Godaw, neeni seeriya asinne</para>
  <para style="q2" vid="PSA 94:12">ne higgiya tamaarsiya asi anjetidaysa.<verse eid="PSA 94:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 94:13"/>Iitati kundiya ollay booketana gakanaw,</para>
  <para style="q2" vid="PSA 94:13">meto gallas neeni iya shempisaasa.<verse eid="PSA 94:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 94:14"/>Xoossay ba asaa yeggenna;</para>
  <para style="q2" vid="PSA 94:14">I ba laata aggenna.<verse eid="PSA 94:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 94:15"/>Pirdi simmidi xillotetha bolla eqana;</para>
  <para style="q2" vid="PSA 94:15">wozanaa suureti ubbay xillo pirdaa kaallana.<verse eid="PSA 94:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 94:16"/>Makallanchota bolla ta gisho dendey oonee?</para>
  <para style="q2" vid="PSA 94:16">Iita ootheysatara ta gisho eqetey oonee?<verse eid="PSA 94:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 94:17"/>Goday tana maaddonnaako,</para>
  <para style="q2" vid="PSA 94:17">taani eeson duufo gelada attanashin.<verse eid="PSA 94:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 94:18"/>Taani, “Ta tohoy hallixis” gida wode,</para>
  <para style="q2" vid="PSA 94:18">ne siiqoy tana katisis.<verse eid="PSA 94:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 94:19"/>Ta wozanan un7etethi kumida wode,</para>
  <para style="q2" vid="PSA 94:19">neeni tana wopu oothada ufaysaasa.<verse eid="PSA 94:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 94:20"/>Higge shaariya geella daynnatara</para>
  <para style="q2" vid="PSA 94:20">geella asara neeni hashetay?<verse eid="PSA 94:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 94:21"/>Xillota wodhanaw enti tobboosona;</para>
  <para style="q2" vid="PSA 94:21">suureta bolla hayqo pirdoosona.<verse eid="PSA 94:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 94:22"/>Gidoshin Goday ta miixaa;</para>
  <para style="q2" vid="PSA 94:22">ta Xoossay taani qosetada attiya zaalla.<verse eid="PSA 94:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 94:23"/>Enta iitatethaa gisho I enta seerana;</para>
  <para style="q2" vid="PSA 94:23">enta nagaraa gisho I enta dhaysana;</para>
  <para style="q2" vid="PSA 94:23">Goday nu Xoossay enta dhaysana.<verse eid="PSA 94:23"/></para>
  <chapter eid="PSA 94"/>
  <chapter number="95" style="c" sid="PSA 95"/>
  <para style="s1">Xoossas Galata Mazmure Yexite</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 95:1"/>Haayite; ane Godaa sabboos;</para>
  <para style="q2" vid="PSA 95:1">nuna ashshiya zaallas ufaysan ililoos.<verse eid="PSA 95:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 95:2"/>Iya sinthe galatara shiiqoos.</para>
  <para style="q2" vid="PSA 95:2">Galata mazmure ufaysan yexoos.<verse eid="PSA 95:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 95:3"/>Goday wolqaama Xoosse;</para>
  <para style="q2" vid="PSA 95:3">xoossata ubbaa bolla gita kawo.<verse eid="PSA 95:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 95:4"/>Biitta ciimmoti iya qaaqan de7oosona;</para>
  <para style="q2" vid="PSA 95:4">deriya xeerati iyabaa.<verse eid="PSA 95:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 95:5"/>I medhida gisho abbay iyabaa;</para>
  <para style="q2" vid="PSA 95:5">mela biittaa iya kushey oothis.<verse eid="PSA 95:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 95:6"/>Haayite; ane gufannidi iya goyinnoos;</para>
  <para style="q2" vid="PSA 95:6">nuna medhida Godaa sinthan gulbatoos.<verse eid="PSA 95:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 95:7"/>I nu Xoossaa;</para>
  <para style="q2" vid="PSA 95:7">nuuni iya qooron de7iya dereta;</para>
  <para style="q2" vid="PSA 95:7">nuuni I heemmiya iya dorsata.</para>
  <para style="q2" vid="PSA 95:7">Goday geysa hachi hinte si7iko,<verse eid="PSA 95:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 95:8"/>Kase hinte mayzati Mariban hanidaysada,</para>
  <para style="q2" vid="PSA 95:8">he gallas Maasan banta wozanaa minthidaysada,</para>
  <para style="q2" vid="PSA 95:8">hinte, hinte wozanaa minthofite.<verse eid="PSA 95:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 95:9"/>Enti ta malaalsiya oosuwa be7idika,</para>
  <para style="q2" vid="PSA 95:9">tana paacidosona; taara eqetidosona.<verse eid="PSA 95:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 95:10"/>Taani he yeletaa bolla oytamu laythi shaatettas;</para>
  <para style="q2" vid="PSA 95:10">“Enti ubba wode banta wozanan baliya asata;</para>
  <para style="q2" vid="PSA 95:10">enti ta ogiya erokona” yaagas.<verse eid="PSA 95:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 95:11"/>Hessa gisho, “Enti ta shempo bessaa gelokona”</para>
  <para style="q2" vid="PSA 95:11">yaagada ta hanquwan caaqas.<verse eid="PSA 95:11"/></para>
  <chapter eid="PSA 95"/>
  <chapter number="96" style="c" sid="PSA 96"/>
  <para style="s1">Xoossa Geeshshatethan Goyinnite</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 96:1"/>Godaas ooratha mazmure yexite;</para>
  <para style="q2" vid="PSA 96:1">sa7an de7iya asa ubbay Godaas yexite.<verse eid="PSA 96:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 96:2"/>Godaas yexite; iya suntha sabbite;</para>
  <para style="q2" vid="PSA 96:2">Iya ashuwa gallas gallas odite.<verse eid="PSA 96:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 96:3"/>Kawotethata giddon iya bonchuwa,</para>
  <para style="q2" vid="PSA 96:3">asa ubbaa giddon iya malaalsiya oosuwa awaajite.<verse eid="PSA 96:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 96:4"/>Goday gita gidiya gisho iyaw gita galatii bessees;</para>
  <para style="q2" vid="PSA 96:4">xoossata ubbaafe aadhidi yayetanaw bessees.<verse eid="PSA 96:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 96:5"/>Hara kawotethata xoossati ubbay eeqata;</para>
  <para style="q2" vid="PSA 96:5">shin Goday salota medhida Xoossaa.<verse eid="PSA 96:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 96:6"/>Bonchoynne sabi iya yuushon de7ees;</para>
  <para style="q2" vid="PSA 96:6">minotethinne puulatethi iya keethan de7ees.<verse eid="PSA 96:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 96:7"/>Biittan de7iya asa zare ubbay Godaaba odite;</para>
  <para style="q2" vid="PSA 96:7">bonchoynne wolqi Godaaba giite.<verse eid="PSA 96:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 96:8"/>Iya sunthaas bessiya bonchuwa Godaas ehite;</para>
  <para style="q2" vid="PSA 96:8">Yarsho ekidi iya dabaaba gelite.<verse eid="PSA 96:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 96:9"/>Iya geeshshatetha teemuwan Godaa goyinnite;</para>
  <para style="q2" vid="PSA 96:9">biittan de7iya asaw ubbay iya sinthan kokorite.<verse eid="PSA 96:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 96:10"/>Kawotethata giddon, “Goday kawotis!</para>
  <para style="q2" vid="PSA 96:10">Sa7ay minnidi eqis; qaaxenna;</para>
  <para style="q2" vid="PSA 96:10">I asaa bolla suure pirdana” yaagite.<verse eid="PSA 96:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 96:11"/>Saloti ufayto; sa7ika hashshu go;</para>
  <para style="q2" vid="PSA 96:11">abbaynne iya giddon de7iya ubbay guummo.<verse eid="PSA 96:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 96:12"/>Goshshaynne iyan de7iya ubbay ufayto!</para>
  <para style="q2" vid="PSA 96:12">Woran de7iya mitha ubbay ufaysan yexo.<verse eid="PSA 96:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 96:13"/>Goday yaa gisho iya sinthan yexo;</para>
  <para style="q2" vid="PSA 96:13">I sa7a bolla pirdanaw yees.</para>
  <para style="q1" vid="PSA 96:13">I ha sa7aa bolla xillotethan,</para>
  <para style="q2" vid="PSA 96:13">asaa bolla tumatethan pirdana.<verse eid="PSA 96:13"/></para>
  <chapter eid="PSA 96"/>
  <chapter number="97" style="c" sid="PSA 97"/>
  <para style="s1">Xoossay Ubbaa Bolla Godaa</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 97:1"/>Goday kawotida gisho sa7an de7iya asay ufayto;</para>
  <para style="q2" vid="PSA 97:1">yuushoy abban teqetida biittati ufayto.<verse eid="PSA 97:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 97:2"/>Shaarinne sakana dhumi iya yuushuwan de7ees;</para>
  <para style="q2" vid="PSA 97:2">Xillotethinne tumatethi iya araata baaso.<verse eid="PSA 97:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 97:3"/>Tami iya sinthara bees;</para>
  <para style="q2" vid="PSA 97:3">iya yuushuwan de7iya morketa xuuggees.<verse eid="PSA 97:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 97:4"/>Iya wol7anthay bitta ubbaa poo7isees;</para>
  <para style="q2" vid="PSA 97:4">biittay hessa be7idi kokorees.<verse eid="PSA 97:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 97:5"/>Dereti Godaa sinthan,</para>
  <para style="q2" vid="PSA 97:5">sa7aa ubbaa Godaa sinthan muqaadada til7idosona.<verse eid="PSA 97:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 97:6"/>Saloti iya xillotethaa awaajosona;</para>
  <para style="q2" vid="PSA 97:6">asa ubbay iya bonchuwa be7oosona.<verse eid="PSA 97:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 97:7"/>Eeqata goyinneysatinne</para>
  <para style="q2" vid="PSA 97:7">entan ceeqeteysati ubbay yeellato;</para>
  <para style="q2" vid="PSA 97:7">eeqati ubbay Godaas gulbato.<verse eid="PSA 97:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 97:8"/>Abeeti Godaw, Xiyooney</para>
  <para style="q2" vid="PSA 97:8">ne xillo pirdaa si7idi ufaytees;</para>
  <para style="q2" vid="PSA 97:8">Yihuda macca naytika hashshu goosona.<verse eid="PSA 97:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 97:9"/>Abeeti Godaw, neeni sa7a ubba bolla dhoqa;</para>
  <para style="q2" vid="PSA 97:9">xoossata ubbaafe neeni dhoqu gadasa.<verse eid="PSA 97:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 97:10"/>Godaa doseysato, iitaa ixite;</para>
  <para style="q2" vid="PSA 97:10">iyan ammaneteyisata shempuwa I naagees;</para>
  <para style="q2" vid="PSA 97:10">iitata kushepe enta ashshees.<verse eid="PSA 97:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 97:11"/>Xillota bolla poo7oy poo7ees;</para>
  <para style="q2" vid="PSA 97:11">wozana suuretas ufaysi de7ees.<verse eid="PSA 97:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 97:12"/>Hinteno xilloto, Godan ufaytite;</para>
  <para style="q2" vid="PSA 97:12">iya geeshsha sunthaa galatite.<verse eid="PSA 97:12"/></para>
  <chapter eid="PSA 97"/>
  <chapter number="98" style="c" sid="PSA 98"/>
  <para style="s1">Xoossas Ufaysan Ililite</para>
  <para style="d">Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 98:1"/>Goday malaalsiyaba oothida gisho,</para>
  <para style="q2" vid="PSA 98:1">iyaw ooratha mazmure yexite.</para>
  <para style="q2" vid="PSA 98:1">Iya ushacha kushey, iya geeshsha qesey</para>
  <para style="q2" vid="PSA 98:1">iyaw xoono immis.<verse eid="PSA 98:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 98:2"/>Goday ba xoonuwa erisis;</para>
  <para style="q2" vid="PSA 98:2">ba xillotethaa kawotethatas qoncisis.<verse eid="PSA 98:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 98:3"/>I Isra7eele asaa siiqeysanne</para>
  <para style="q2" vid="PSA 98:3">entaw ammaneteysa hassayis.</para>
  <para style="q1" vid="PSA 98:3">Sa7aa gaxaa gakanaw de7iya asa ubbay</para>
  <para style="q2" vid="PSA 98:3">nu Xoossaa atotetha be7idosona.<verse eid="PSA 98:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 98:4"/>Sa7a bolla de7iya asaw,</para>
  <para style="q2" vid="PSA 98:4">Godaas ufaysan yexite;</para>
  <para style="q2" vid="PSA 98:4">ufaysan ililishe sabbite.<verse eid="PSA 98:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 98:5"/>Godaas diithi diixite;</para>
  <para style="q2" vid="PSA 98:5">diithaninne mazmuren Godaa sabbite.<verse eid="PSA 98:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 98:6"/>Suusul7enne moyze punnishe,</para>
  <para style="q2" vid="PSA 98:6">ufaysan Godaa nu kawa sinthan yexite.<verse eid="PSA 98:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 98:7"/>Abbaynne abba giddon kumida ubbay guummo;</para>
  <para style="q2" vid="PSA 98:7">Sa7aynne sa7aa bolla de7iya ubbay yexo.<verse eid="PSA 98:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 98:8"/>Shaafati banta kushiya baqo;</para>
  <para style="q2" vid="PSA 98:8">zumati issife Godaa sinthan ufaysan yexo.<verse eid="PSA 98:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 98:9"/>Goday sa7aa bolla pirdanaw yees;</para>
  <para style="q2" vid="PSA 98:9">I ha sa7aa bolla xillotethan</para>
  <para style="q2" vid="PSA 98:9">asaa bolla suuretethan pirdana.<verse eid="PSA 98:9"/></para>
  <chapter eid="PSA 98"/>
  <chapter number="99" style="c" sid="PSA 99"/>
  <para style="s1">Nu Xoossay Geeshshi</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 99:1"/>Goday kawotida gisho kawotethati kokoro;</para>
  <para style="q2" vid="PSA 99:1">araata bolla Kiruubeta giddon uttida gisho;</para>
  <para style="q2" vid="PSA 99:1">biittay qaaxo.<verse eid="PSA 99:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 99:2"/>Goday Xiyoonen gita;</para>
  <para style="q2" vid="PSA 99:2">kawotethaa ubbaafe</para>
  <para style="q2" vid="PSA 99:2">I dhoqu dhoqu gis.<verse eid="PSA 99:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 99:3"/>Yashshiya iya gita sunthaa ubbay galato;</para>
  <para style="q2" vid="PSA 99:3">I geeshshi.<verse eid="PSA 99:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 99:4"/>Neeni, wolqaama kawoy suure pirda dosaasa.</para>
  <para style="q2" vid="PSA 99:4">Neeni Yayqooba suuretethan minthadasa.</para>
  <para style="q2" vid="PSA 99:4">Xillotethi essadasa.<verse eid="PSA 99:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 99:5"/>Godaa, nu Xoossaa dhoqu dhoqu oothite;</para>
  <para style="q2" vid="PSA 99:5">iya tohoy yedhiya bessan iya goyinnite;</para>
  <para style="q2" vid="PSA 99:5">I geeshshi.<verse eid="PSA 99:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 99:6"/>Museynne Aaroni iya kahineta giddofe koyrota;</para>
  <para style="q2" vid="PSA 99:6">Sameeli iya woossidaysatape issuwa.</para>
  <para style="q2" vid="PSA 99:6">Enti Godaako waassidosona;</para>
  <para style="q2" vid="PSA 99:6">I enta si7is.<verse eid="PSA 99:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 99:7"/>I shaara tuussaa giddora entaw haasayis;</para>
  <para style="q2" vid="PSA 99:7">I immida higgiyanne wogaa naagidosona.<verse eid="PSA 99:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 99:8"/>Abeeti Godaw, nu Xoossaw,</para>
  <para style="q2" vid="PSA 99:8">ne enta woosa si7adasa.</para>
  <para style="q1" vid="PSA 99:8">Ne entana maaradasa;</para>
  <para style="q2" vid="PSA 99:8">gidoshin, enta nagara gisho enta seeradasa.<verse eid="PSA 99:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 99:9"/>Goday nu Xoossay, geeshshi gidiya gisho,</para>
  <para style="q2" vid="PSA 99:9">iya dhoqu dhoqu oothite;</para>
  <para style="q2" vid="PSA 99:9">iya geeshsha zumaa bolla iya goyinnite.<verse eid="PSA 99:9"/></para>
  <chapter eid="PSA 99"/>
  <chapter number="100" style="c" sid="PSA 100"/>
  <para style="s1">Xoossa Siiqoy Merinaasa</para>
  <para style="d">Galata Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 100:1"/>Biittan de7iya asa ubbay,</para>
  <para style="q2" vid="PSA 100:1">Godaas ufaysan ililite.<verse eid="PSA 100:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 100:2"/>Godaas ufaysan haggaazite;</para>
  <para style="q2" vid="PSA 100:2">ufaysa yethara iya sinthe shiiqite.<verse eid="PSA 100:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 100:3"/>Goday Xoosse gideysa erite;</para>
  <para style="q2" vid="PSA 100:3">nuna medhiday iya; nu iyabaa;</para>
  <para style="q2" vid="PSA 100:3">nuuni iya asenne iya qooron heemetiya dorsata.<verse eid="PSA 100:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 100:4"/>Iya pengiya galatara gelite,</para>
  <para style="q2" vid="PSA 100:4">iya dabaaba sabara biite;</para>
  <para style="q2" vid="PSA 100:4">iya galatitenne iya sunthaa anjite.<verse eid="PSA 100:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 100:5"/>Goday keeha;</para>
  <para style="q2" vid="PSA 100:5">iya siiqoy merinaasa;</para>
  <para style="q2" vid="PSA 100:5">iya ammanetethay yeletape yeletaa gakanaasa.<verse eid="PSA 100:5"/></para>
  <chapter eid="PSA 100"/>
  <chapter number="101" style="c" sid="PSA 101"/>
  <para style="s1">Taani Suure Oge Hemetana</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 101:1"/>Ta ne siiquwabaanne ne xillo pirdaba yexana;</para>
  <para style="q2" vid="PSA 101:1">Godaw, ta nena mazmuren galatana.<verse eid="PSA 101:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 101:2"/>Taani suure ogiyan daana;</para>
  <para style="q2" vid="PSA 101:2">neeni taako awude yaanee?</para>
  <para style="q2" vid="PSA 101:2">Taani ta keethan suuretethan hemetana.<verse eid="PSA 101:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 101:3"/>Taani ta ayfey iitabaa xeellenna;</para>
  <para style="q2" vid="PSA 101:3">Xoossafe haakida asaa oosuwa ixayis;</para>
  <para style="q2" vid="PSA 101:3">enti taara gahetokona.<verse eid="PSA 101:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 101:4"/>Wozanaa geellatethi taape haako;</para>
  <para style="q2" vid="PSA 101:4">iitatethaas besse immike.<verse eid="PSA 101:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 101:5"/>Geeman ba laggiya zigiriya uraa si77i oothana;</para>
  <para style="q2" vid="PSA 101:5">otortiyanne ceeqetiya asi taani danda7ike.<verse eid="PSA 101:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 101:6"/>Enti taara daana mela,</para>
  <para style="q2" vid="PSA 101:6">biitta bolla de7iya ammanetiya asata</para>
  <para style="q1" vid="PSA 101:6">Taani keeha ayfen xeellayis;</para>
  <para style="q2" vid="PSA 101:6">suuretethan hemetiya asi taw kiitetees.<verse eid="PSA 101:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 101:7"/>Cimmiya asi ta keethan deenna;</para>
  <para style="q2" vid="PSA 101:7">wordo haasaya asi ta sinthan eqenna.<verse eid="PSA 101:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 101:8"/>Biittan de7iya iita asaa,</para>
  <para style="q2" vid="PSA 101:8">taani gallas gallas si77i oothana.</para>
  <para style="q2" vid="PSA 101:8">Iitaa ootheyisata ubbaa</para>
  <para style="q2" vid="PSA 101:8">taani Godaa katamaape shoddana.<verse eid="PSA 101:8"/></para>
  <chapter eid="PSA 101"/>
  <chapter number="102" style="c" sid="PSA 102"/>
  <para style="s1">Ne Som7uwa Taape Genthofa</para>
  <para style="d">Un7etida wode Xoossa sinthan woossida asa woosa</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 102:1"/>Godaw, ta woosa si7a;</para>
  <para style="q2" vid="PSA 102:1">ta waasoy neeko gako.<verse eid="PSA 102:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 102:2"/>Ta waayiya gallas ne som7uwa taape genthofa;</para>
  <para style="q2" vid="PSA 102:2">ne haytha taako zaara;</para>
  <para style="q2" vid="PSA 102:2">taani neeko waassiya wode, tana eeson alla.<verse eid="PSA 102:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 102:3"/>Ta laythay cuyada dhayees;</para>
  <para style="q2" vid="PSA 102:3">ta meqethay tamada eexees.<verse eid="PSA 102:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 102:4"/>Ta wozanay buucidi yeggida maatada melis;</para>
  <para style="q2" vid="PSA 102:4">kathika taw meetetenna.<verse eid="PSA 102:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 102:5"/>Taani ta qaala dhoqu oothada oolida gisho;</para>
  <para style="q2" vid="PSA 102:5">ta gogay meqethaara oyketis.<verse eid="PSA 102:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 102:6"/>Taani woran de7iya solo mela,</para>
  <para style="q2" vid="PSA 102:6">kaysa keethan de7iya gutto mela.<verse eid="PSA 102:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 102:7"/>Taani zin7in dhiskoy yeenna;</para>
  <para style="q2" vid="PSA 102:7">taani keetha huuphen barka uttida kafo gidas.<verse eid="PSA 102:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 102:8"/>Ta morketi gallas kumethi tana cayoosona;</para>
  <para style="q2" vid="PSA 102:8">tana qelqiseysati ta sunthan baaddoosona.<verse eid="PSA 102:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 102:9"/>Bidoy taw kathi gidis;</para>
  <para style="q2" vid="PSA 102:9">ta afuthay ta ushshara Walaketis.<verse eid="PSA 102:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 102:10"/>Hessi haniday ne hanqoynne ne yiloy,</para>
  <para style="q2" vid="PSA 102:10">tana denthadi wora holida gishosa.<verse eid="PSA 102:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 102:11"/>Ta laythay omarsa kuya mela ellesidi aadhees;</para>
  <para style="q2" vid="PSA 102:11">taani maatada shullayis.<verse eid="PSA 102:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 102:12"/>Shin Godaw, neeni ne araatan merinaw uttadasa;</para>
  <para style="q2" vid="PSA 102:12">ne sunthay yeletaape yeletaa gakanaw hassayetana.<verse eid="PSA 102:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 102:13"/>Neeni iyo maariya wodey gakida gisho;</para>
  <para style="q2" vid="PSA 102:13">dendada Xiyoones qadheta;</para>
  <para style="q2" vid="PSA 102:13">neeni doorida wodey gakis.<verse eid="PSA 102:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 102:14"/>I shuchati ne oosanchotas al7o;</para>
  <para style="q2" vid="PSA 102:14">I biittayka enta qadhethees.<verse eid="PSA 102:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 102:15"/>Kawotethati Godaa sunthaas yayyana;</para>
  <para style="q2" vid="PSA 102:15">sa7aa kawoti iya bonchuwas dagammana.<verse eid="PSA 102:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 102:16"/>Goday Xiyoone zaaridi keexana;</para>
  <para style="q2" vid="PSA 102:16">ba gitatetha bessana.<verse eid="PSA 102:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 102:17"/>I manqota woosa si7ana;</para>
  <para style="q2" vid="PSA 102:17">enta oysha kadhenna.<verse eid="PSA 102:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 102:18"/>Buroo yeletana asay Godaa galatana mela,</para>
  <para style="q2" vid="PSA 102:18">haysi yaa yeletas xaafeto.<verse eid="PSA 102:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 102:19"/>Goday dhoqan de7iya</para>
  <para style="q2" vid="PSA 102:19">ba geeshsha bessaafe xeellis;</para>
  <para style="q2" vid="PSA 102:19">salon gididi sa7aa xomoosees.<verse eid="PSA 102:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 102:20"/>Hessika qashetida asaa waasuwa si7anawunne</para>
  <para style="q2" vid="PSA 102:20">hayqo pirdetida asaa birshanaasa.<verse eid="PSA 102:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 102:21"/>Hessa gisho, Godaa sunthay Xiyoonen odetana;</para>
  <para style="q2" vid="PSA 102:21">iya galatay Yerusalaamen awaajettana.<verse eid="PSA 102:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 102:22"/>Dereynne kawotethay shiiqidi,</para>
  <para style="q2" vid="PSA 102:22">Godaas he wode goyinnana.<verse eid="PSA 102:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 102:23"/>Taani na7atethan de7ishin,</para>
  <para style="q2" vid="PSA 102:23">ta wolqaa ixisis; ta laytha qaamisis.<verse eid="PSA 102:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 102:24"/>Taani, “Ta Xoossaw,</para>
  <para style="q2" vid="PSA 102:24">ta laytha giddo zawan tana dhukofa” yaagayis.</para>
  <para style="q2" vid="PSA 102:24">Godaw, neeni yeletape yeletaa gakanaw de7aasa.<verse eid="PSA 102:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 102:25"/>Neeni beni sa7aa medhadasa;</para>
  <para style="q2" vid="PSA 102:25">saloyka ne kushe ooso.<verse eid="PSA 102:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 102:26"/>Haysati ubbay dhayana; shin neeni daana;</para>
  <para style="q2" vid="PSA 102:26">enti ubbay afilada wurana.</para>
  <para style="q1" vid="PSA 102:26">Neeni enta curqa afilada laammana;</para>
  <para style="q2" vid="PSA 102:26">entika aadhana.<verse eid="PSA 102:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 102:27"/>Shin neeni nena;</para>
  <para style="q2" vid="PSA 102:27">ne laythay wurenna.<verse eid="PSA 102:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 102:28"/>Ne aylleta nayta neeni saro wothaasa;</para>
  <para style="q2" vid="PSA 102:28">enta kochay ne sinthan minnidi daana.<verse eid="PSA 102:28"/></para>
  <chapter eid="PSA 102"/>
  <chapter number="103" style="c" sid="PSA 103"/>
  <para style="s1">Ta Shempe Xoossa Galata</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 103:1"/>Ta shempe Godaa galata!</para>
  <para style="q2" vid="PSA 103:1">Ta kumetha asatethaw, iya geeshsha suntha galata.<verse eid="PSA 103:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 103:2"/>Ta shempe Godaa galata!</para>
  <para style="q2" vid="PSA 103:2">I new oothida keehatetha ubbaa dogopa.<verse eid="PSA 103:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 103:3"/>I ne nagaraa ubbaa atto gees;</para>
  <para style="q2" vid="PSA 103:3">ne harge ubbaafe nena pathees.<verse eid="PSA 103:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 103:4"/>I nena hayqope ashshees;</para>
  <para style="q2" vid="PSA 103:4">siiqoninne maarotan nena anjees.<verse eid="PSA 103:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 103:5"/>Ne yalagatethay arganthada ooraxana mela,</para>
  <para style="q2" vid="PSA 103:5">ne de7uwa lo77oban kalsees.<verse eid="PSA 103:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 103:6"/>Goday qohetidaysatas</para>
  <para style="q2" vid="PSA 103:6">xillotethaninne suuren pirdees.<verse eid="PSA 103:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 103:7"/>I ba ogiya Muse,</para>
  <para style="q2" vid="PSA 103:7">ba oosuwa Isra7eele asaa erisis.<verse eid="PSA 103:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 103:8"/>Goday qadheteysanne maareysa;</para>
  <para style="q2" vid="PSA 103:8">hanqetanaw eesotenna; iya siiqoy daro.<verse eid="PSA 103:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 103:9"/>I ubba wode seerenna;</para>
  <para style="q2" vid="PSA 103:9">merinaw hanqetenna.<verse eid="PSA 103:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 103:10"/>I nuus nu nagaraada oothenna;</para>
  <para style="q2" vid="PSA 103:10">nu iitatethaa mela zaarenna.<verse eid="PSA 103:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 103:11"/>Saloy sa7ape dhoqeysada,</para>
  <para style="q2" vid="PSA 103:11">Godaa yayyeysatas iya siiqoy gita.<verse eid="PSA 103:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 103:12"/>Dolohape wulohi haakeysada,</para>
  <para style="q2" vid="PSA 103:12">Goday nu nagara nuupe haassees.<verse eid="PSA 103:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 103:13"/>Aawi ba naytas qadheteysada,</para>
  <para style="q2" vid="PSA 103:13">Goday baw yayyeysatas qadhetees.<verse eid="PSA 103:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 103:14"/>Nuuni aybipe medhetidaako I erees;</para>
  <para style="q2" vid="PSA 103:14">nuuni biitta gideysa I akeekes.<verse eid="PSA 103:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 103:15"/>Asi baw maata mela;</para>
  <para style="q2" vid="PSA 103:15">I bazzo ciishshada ciyees.<verse eid="PSA 103:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 103:16"/>Carkoy iya bolla carkiya wode dhayees;</para>
  <para style="q2" vid="PSA 103:16">I dolida bessay zaaridi eretenna.<verse eid="PSA 103:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 103:17"/>Shin Godaas yayyeysatas</para>
  <para style="q2" vid="PSA 103:17">iya siiqoy merinaape merinaa gakanaasa;</para>
  <para style="q2" vid="PSA 103:17">iya xillotethay na7a na7a gakanaasa.<verse eid="PSA 103:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 103:18"/>Hessi haney iya caaquwa naageysatanne</para>
  <para style="q2" vid="PSA 103:18">iya kiitaa polanaw minneysatasa.<verse eid="PSA 103:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 103:19"/>Goday salotan ba araata essis;</para>
  <para style="q2" vid="PSA 103:19">iya kawotethay ubbaa haarees.<verse eid="PSA 103:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 103:20"/>Hinteno, iya kiitanchato,</para>
  <para style="q2" vid="PSA 103:20">iya kiita naagiya wolqaamato,</para>
  <para style="q2" vid="PSA 103:20">I odiyaba si7eysato, Godaa galatite!<verse eid="PSA 103:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 103:21"/>Hinteno salon de7iya minoto,</para>
  <para style="q2" vid="PSA 103:21">iya sheniya poleysato, Godaa galatite!<verse eid="PSA 103:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 103:22"/>Hinteno, I haariya bessa ubban,</para>
  <para style="q2" vid="PSA 103:22">de7iya medhetethato, Godaa galatite!</para>
  <para style="q2" vid="PSA 103:22">Ta shempe Godaa galata!<verse eid="PSA 103:22"/></para>
  <chapter eid="PSA 103"/>
  <chapter number="104" style="c" sid="PSA 104"/>
  <para style="s1">Xoossay Ba Medhetetha Heemmees</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 104:1"/>Ta shempe, Godaa galata;</para>
  <para style="q2" vid="PSA 104:1">abeeti Godaw, ta Xoossaw ne gita;</para>
  <para style="q2" vid="PSA 104:1">neeni bonchonne teema ma7adasa.<verse eid="PSA 104:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 104:2"/>Poo7o afilada guuluntadasa;</para>
  <para style="q2" vid="PSA 104:2">neeni saluwa dunkaaneda toladasa.<verse eid="PSA 104:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 104:3"/>Ne keethaa salo bolla keexaasa;</para>
  <para style="q2" vid="PSA 104:3">shaara para gaare kessaasa;</para>
  <para style="q2" vid="PSA 104:3">carko qefe bolla uttada baasa.<verse eid="PSA 104:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 104:4"/>Carkoy new kiitancho,</para>
  <para style="q2" vid="PSA 104:4">tama laco new oosancho oothaasa.<verse eid="PSA 104:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 104:5"/>Ne, sa7aa iya baasuwa bolla essadasa;</para>
  <para style="q2" vid="PSA 104:5">hessa gisho, merinaw qaaxenna.<verse eid="PSA 104:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 104:6"/>Ciimmo abbay afilada biitta kammis;</para>
  <para style="q2" vid="PSA 104:6">haathay gita dereta kammis.<verse eid="PSA 104:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 104:7"/>Ne hanqetin haathati baqatidosona;</para>
  <para style="q2" vid="PSA 104:7">ne deshuwa si7ida wode qosetidosona.<verse eid="PSA 104:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 104:8"/>Enti dereta bollanne zangaarata giddo,</para>
  <para style="q2" vid="PSA 104:8">ne entaw giigisida bessaa goggidosona.<verse eid="PSA 104:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 104:9"/>Haathati simmidi biitta kammonnaada,</para>
  <para style="q2" vid="PSA 104:9">enti aadhanaw danda7onna zawa wothadasa.<verse eid="PSA 104:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 104:10"/>Neeni, pultoti zangaaran gogganaada oothadasa;</para>
  <para style="q2" vid="PSA 104:10">shaafa haathati dereta giddora goggoosona.<verse eid="PSA 104:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 104:11"/>Bazzo do7ati ubbay iyape uyoosona;</para>
  <para style="q2" vid="PSA 104:11">bazzo hareti iyape saamo aloosona.<verse eid="PSA 104:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 104:12"/>Salo kafoti he haatha matan banta keethaa keexidi,</para>
  <para style="q2" vid="PSA 104:12">tashiya giddon yexoosona.<verse eid="PSA 104:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 104:13"/>Ne gita dereta bolla salope ira buksaasa;</para>
  <para style="q2" vid="PSA 104:13">iya kushe ooso ayfen biittiya kallasu.<verse eid="PSA 104:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 104:14"/>Neeni mehes maata, asas kathi dolisaasa;</para>
  <para style="q2" vid="PSA 104:14">hessan asay biitta oothidi, kathi shiishees. <verse eid="PSA 104:14"/><verse number="15" style="v" sid="PSA 104:15"/>Asa wozana ufaysiya woyne,</para>
  <para style="q2" vid="PSA 104:15">som7o cil7isiya zaytenne</para>
  <para style="q2" vid="PSA 104:15">wolqa immiya kathi dolisaasa.<verse eid="PSA 104:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 104:16"/>Godaa mithati,</para>
  <para style="q2" vid="PSA 104:16">I tokida Libaanose zigati,</para>
  <para style="q2" vid="PSA 104:16">daro ira demmoosona.<verse eid="PSA 104:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 104:17"/>Kafoti banta keetha yan keexoosona;</para>
  <para style="q2" vid="PSA 104:17">xiloti xiidda bolla keexidi de7oosona.<verse eid="PSA 104:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 104:18"/>Dhoqa dereta bolla gaarati de7oosona;</para>
  <para style="q2" vid="PSA 104:18">gupalleti shucha qophon qosetoosona.<verse eid="PSA 104:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 104:19"/>Wode taybuwa erisana mela,</para>
  <para style="q2" vid="PSA 104:19">ne ageena medhadasa;</para>
  <para style="q2" vid="PSA 104:19">away ba wulliya wodiya erees.<verse eid="PSA 104:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 104:20"/>Neeni dhumaa medhadasa; qamma oothadasa;</para>
  <para style="q2" vid="PSA 104:20">he dhuman wora do7i ubbay keyees.<verse eid="PSA 104:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 104:21"/>Wodala gaammoti shankatishe gudoosona;</para>
  <para style="q2" vid="PSA 104:21">enti bantaw miyaba Xoossafe koyoosona.<verse eid="PSA 104:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 104:22"/>Awi doliya wode guye simmoosona;</para>
  <para style="q2" vid="PSA 104:22">banta bessaa gelidi zin7oosona.<verse eid="PSA 104:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 104:23"/>He wode asi ba oosos keyees;</para>
  <para style="q2" vid="PSA 104:23">sa7i qammana gakanaw oothees.<verse eid="PSA 104:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 104:24"/>Abeeti Godaw, ne oosoy ay mela daro;</para>
  <para style="q2" vid="PSA 104:24">ne cincatethan ne enta ubbaa medhadasa;</para>
  <para style="q2" vid="PSA 104:24">sa7i ne medhidaban kumis.<verse eid="PSA 104:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 104:25"/>Heko, Abbay gitanne dalga;</para>
  <para style="q2" vid="PSA 104:25">tayboy bayna qaaxiya medhetethan,</para>
  <para style="q2" vid="PSA 104:25">gitatanne guutha medhetethan kumidi de7ees.<verse eid="PSA 104:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 104:26"/>Iya bolla markabeti boosona;</para>
  <para style="q2" vid="PSA 104:26">ne medhida Leewataane geetetiya dawey iyan kaa7ees.<verse eid="PSA 104:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 104:27"/>Ne entaw koshshiya wodiyan</para>
  <para style="q2" vid="PSA 104:27">miyaba immana mela,</para>
  <para style="q2" vid="PSA 104:27">enti ubbay nena xeelloosona.<verse eid="PSA 104:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 104:28"/>Ne entaw immin enti maxoosona;</para>
  <para style="q2" vid="PSA 104:28">neeni ne kushiya miccin,</para>
  <para style="q2" vid="PSA 104:28">enti lo77oba kalloosona.<verse eid="PSA 104:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 104:29"/>Neeni ne som7uwa genthiya wode dagammoosona;</para>
  <para style="q2" vid="PSA 104:29">neeni shempuwa ekiya wode hayqidi,</para>
  <para style="q2" vid="PSA 104:29">banta biitta simmoosona.<verse eid="PSA 104:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 104:30"/>Shin neeni ne shempuwa immiya wode,</para>
  <para style="q2" vid="PSA 104:30">enti medhetoosona; biitta ooraxisaasa.<verse eid="PSA 104:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 104:31"/>Godaa bonchoy merinaw de7o;</para>
  <para style="q2" vid="PSA 104:31">Goday ba oosuwan ufayto.<verse eid="PSA 104:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 104:32"/>I biitta xeelliya wode biittay qaaxees;</para>
  <para style="q2" vid="PSA 104:32">I dereta bochiya wode dereti cuyoosona.<verse eid="PSA 104:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 104:33"/>Ta de7o laytha ubban Godaas yexana;</para>
  <para style="q2" vid="PSA 104:33">ta paxa de7iya wode ubban ta Xoossaa zammarana.<verse eid="PSA 104:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 104:34"/>Taani Godan ufaytiya gisho,</para>
  <para style="q2" vid="PSA 104:34">ta qofay iya ufayso.<verse eid="PSA 104:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 104:35"/>Nagaranchoti biittafe dhayo;</para>
  <para style="q2" vid="PSA 104:35">iita ootheysati de7opo.</para>
  <para style="q1" vid="PSA 104:35">Ta shempe, Godaa galata;</para>
  <para style="q2" vid="PSA 104:35">Goday galatetto.<verse eid="PSA 104:35"/></para>
  <chapter eid="PSA 104"/>
  <chapter number="105" style="c" sid="PSA 105"/>
  <para style="s1">Xoossa Gita Oosuwa Odite</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 105:1"/>Godaa galatite; iya suntha xeegite;</para>
  <para style="q2" vid="PSA 105:1">I oothidaba kawotethatas odite.<verse eid="PSA 105:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 105:2"/>Iya sabbite; galata mazmure yexite;</para>
  <para style="q2" vid="PSA 105:2">malaalsiya iya ooso ubbaa odite.<verse eid="PSA 105:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 105:3"/>Iya geeshsha sunthan ceeqite;</para>
  <para style="q2" vid="PSA 105:3">Godaa koyeyisata wozanay ufayto.<verse eid="PSA 105:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 105:4"/>Godaanne iya wolqan ammanetite;</para>
  <para style="q2" vid="PSA 105:4">ubba wode iya koyite.<verse eid="PSA 105:4"/></para>
  <para style="q1">
    <verse number="5-6" style="v" sid="PSA 105:5-6"/>Hinteno, iya aylliya Abrahaame zareto,</para>
  <para style="q2" vid="PSA 105:5-6">dooretida Yayqooba nayto,</para>
  <para style="q1" vid="PSA 105:5-6">I oothida malaalsiyabata,</para>
  <para style="q2" vid="PSA 105:5-6">iya malaatanne suure pirdaa hassayite.<verse eid="PSA 105:5-6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 105:7"/>I Godaa, nu Xoossaa;</para>
  <para style="q2" vid="PSA 105:7">iya pirday biitta ubbaa bollana.<verse eid="PSA 105:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 105:8"/>I ba caaquwa merinaw,</para>
  <para style="q2" vid="PSA 105:8">ba gelida qaala mukulu yeleta gakanaw naagees.<verse eid="PSA 105:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 105:9"/>I Abrahaamera caaqida ufaysa qaala,</para>
  <para style="q2" vid="PSA 105:9">Yisaaqas gelida ufaysa qaala,<verse eid="PSA 105:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 105:10"/>Yayqoobas woga,</para>
  <para style="q2" vid="PSA 105:10">Isra7eeles merinaa caaquwa</para>
  <para style="q2" vid="PSA 105:10">oothidi minthis.<verse eid="PSA 105:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 105:11"/>I, “Kanaane biitta new immana;</para>
  <para style="q2" vid="PSA 105:11">I ne kochaa gakida laata gidana” yaagis.<verse eid="PSA 105:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 105:12"/>Xoossa asati taybon guuthanne</para>
  <para style="q2" vid="PSA 105:12">Kanaane biittan bete asi gididi de7iya wode,<verse eid="PSA 105:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 105:13"/>Issi deriyape hara deriya,</para>
  <para style="q2" vid="PSA 105:13">issi kawotethaafe hara kawotethi yuuyidosona.<verse eid="PSA 105:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 105:14"/>Xoossay oonika enta un7ethana mela oothibeenna;</para>
  <para style="q2" vid="PSA 105:14">enta gisho kawota seeris.<verse eid="PSA 105:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 105:15"/>“Ta tiyidaysata bochofite;</para>
  <para style="q2" vid="PSA 105:15">ta nabeta qohopite” yaagis.<verse eid="PSA 105:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 105:16"/>Goday biittan kosha yeddidi,</para>
  <para style="q2" vid="PSA 105:16">enta kathaa ubbaa dhaysis.<verse eid="PSA 105:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 105:17"/>Shin I ba asaa ashshanaw,</para>
  <para style="q2" vid="PSA 105:17">issi addiya Gibxe kiittis;</para>
  <para style="q2" vid="PSA 105:17">he uray aylle gididi bayzetida Yoosefa.<verse eid="PSA 105:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 105:18"/>Iya tohoti biratan duxetidosona;</para>
  <para style="q2" vid="PSA 105:18">I santhalaatan qashetis.<verse eid="PSA 105:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 105:19"/>I kase odidaysi tumattana gakanaw,</para>
  <para style="q2" vid="PSA 105:19">Godaa qaalay iya paacis.<verse eid="PSA 105:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 105:20"/>Hessafe guye Gibxe kawoy ase yeddidi,</para>
  <para style="q2" vid="PSA 105:20">iya qasho keethafe kessis.<verse eid="PSA 105:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 105:21"/>Iya ba keethaa bolla godaa oothis;</para>
  <para style="q2" vid="PSA 105:21">baw de7iya ubbaa bolla shuumis.<verse eid="PSA 105:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 105:22"/>Ba moorinnata zorana mela,</para>
  <para style="q2" vid="PSA 105:22">ba cimata cincatethi tamaarsana mela shuumis.<verse eid="PSA 105:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 105:23"/>Isra7eeley Gibxe bis;</para>
  <para style="q2" vid="PSA 105:23">Yayqoobi Kaama biittan uttis.<verse eid="PSA 105:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 105:24"/>Goday ba asaa darsis;</para>
  <para style="q2" vid="PSA 105:24">enta morketape aathidi enta minthis.<verse eid="PSA 105:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 105:25"/>Ba asaa ixana mela Gibxe asaa wozanaa laammis;</para>
  <para style="q2" vid="PSA 105:25">ba aylleta cimmana mela oothis.<verse eid="PSA 105:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 105:26"/>Ba aylliya Musenne</para>
  <para style="q2" vid="PSA 105:26">ba doorida Aarona entako kiittis.<verse eid="PSA 105:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 105:27"/>Enti Gibxe asaa sinthan malaata,</para>
  <para style="q2" vid="PSA 105:27">Kaama biittan malaalsiyaba oothidosona.<verse eid="PSA 105:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 105:28"/>Goday dhumaa kiittidi, biitta dhumisis;</para>
  <para style="q2" vid="PSA 105:28">shin Gibxe asay iya kiita polibookona.<verse eid="PSA 105:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 105:29"/>Enta haatha suuthi laammidi,</para>
  <para style="q2" vid="PSA 105:29">molota wodhis.<verse eid="PSA 105:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 105:30"/>Enta biitta ubbaa,</para>
  <para style="q2" vid="PSA 105:30">kawo gadhoka shodhe kunthis.<verse eid="PSA 105:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 105:31"/>I kiittin, udunxenne biinne</para>
  <para style="q2" vid="PSA 105:31">enta biitta ubbaa bolla biinney wodhis.<verse eid="PSA 105:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 105:32"/>Ira gisho enta biitta bolla</para>
  <para style="q2" vid="PSA 105:32">shachi, dadanne wol7anthi bukisis.<verse eid="PSA 105:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 105:33"/>I enta woyniyanne balasiya shocis;</para>
  <para style="q2" vid="PSA 105:33">enta biittan de7iya mithaa mentherethis.<verse eid="PSA 105:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 105:34"/>I kiittin, booleynne</para>
  <para style="q2" vid="PSA 105:34">tayboy bayna duggoy keyis.<verse eid="PSA 105:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 105:35"/>Enta biittan dolida katha ubbaa mis;</para>
  <para style="q2" vid="PSA 105:35">gaden de7iya cil7oba ubbaa dhaysis.<verse eid="PSA 105:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 105:36"/>Goday Gibxe asaa bayra nayta ubbaa wodhis;</para>
  <para style="q2" vid="PSA 105:36">koyro yeletida ubbaa dhaysis.<verse eid="PSA 105:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 105:37"/>Hessafe guye, Isra7eele asaa</para>
  <para style="q2" vid="PSA 105:37">worqanne bira alleeqora kessis;</para>
  <para style="q2" vid="PSA 105:37">enta kochaa giddofe guye attiday oonika baawa.<verse eid="PSA 105:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 105:38"/>Gibxe asay entaw yayyida gisho,</para>
  <para style="q2" vid="PSA 105:38">enta kessan ufaytidosona.<verse eid="PSA 105:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 105:39"/>Goday enta kammanaw shaara miccis;</para>
  <para style="q2" vid="PSA 105:39">qamma entaw poo7isanaw tama giigisis.<verse eid="PSA 105:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 105:40"/>Enti miyaba oychida wode,</para>
  <para style="q2" vid="PSA 105:40">kuraacho daaniya kafota entaw yeddis;</para>
  <para style="q2" vid="PSA 105:40">enta salo kathi kalsis.<verse eid="PSA 105:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 105:41"/>I shuchaa phalqin, haathi pultis;</para>
  <para style="q2" vid="PSA 105:41">mela biittan shaafada goggis.<verse eid="PSA 105:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 105:42"/>I ba aylliya Abrahaames,</para>
  <para style="q2" vid="PSA 105:42">gelida geeshsha qaala hassayis.<verse eid="PSA 105:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 105:43"/>I ba asaa ufaysan,</para>
  <para style="q2" vid="PSA 105:43">ba dooridaysata ililsan kessis.<verse eid="PSA 105:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 105:44"/>I entaw allaga kawotethata biitta immis;</para>
  <para style="q2" vid="PSA 105:44">Harati daaburida goshsha laattidosona.<verse eid="PSA 105:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 105:45"/>I hessa oothiday enti iya wogaa</para>
  <para style="q2" vid="PSA 105:45">iya higgiya naagananne oothana melasa.</para>
  <para style="q2" vid="PSA 105:45">Goday galatetto!<verse eid="PSA 105:45"/></para>
  <chapter eid="PSA 105"/>
  <chapter number="106" style="c" sid="PSA 106"/>
  <para style="s1">Xoossay Gita, Iya Galatite</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 106:1"/>Godaa galatite!</para>
  <para style="q1" vid="PSA 106:1">I keeha gidiya gishonne</para>
  <para style="q2" vid="PSA 106:1">iya siiqoy merinaasa gidiya gisho,</para>
  <para style="q2" vid="PSA 106:1">Godaa galatite.<verse eid="PSA 106:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 106:2"/>Goday oothida wolqaama ooso odanaw,</para>
  <para style="q2" vid="PSA 106:2">woyko iya galataa ubbaa qoncisanaw</para>
  <para style="q2" vid="PSA 106:2">danda7ey oonee?<verse eid="PSA 106:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 106:3"/>Pirdaa naageysatinne</para>
  <para style="q2" vid="PSA 106:3">ubba toho xillobaa ootheysati anjetidaasaata.<verse eid="PSA 106:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 106:4"/>Abeeti Godaw, neeni ne asaas keehiya wode tana qopa;</para>
  <para style="q2" vid="PSA 106:4">enta neeni ashshiya wode tana alla.<verse eid="PSA 106:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 106:5"/>Hessika ne doorida asaa dichaa ta be7ana mela,</para>
  <para style="q2" vid="PSA 106:5">ne asaa ufaysan taani ufaytana melanne</para>
  <para style="q2" vid="PSA 106:5">ne asaara issife taani galatana melasa.<verse eid="PSA 106:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 106:6"/>Nuuni nu aawatada nagara oothida;</para>
  <para style="q2" vid="PSA 106:6">nu balida; iitabaa oothida.<verse eid="PSA 106:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 106:7"/>Nu aawati Gibxen de7iya wode,</para>
  <para style="q2" vid="PSA 106:7">malaalsiya ne oosuwa qopibookona.</para>
  <para style="q1" vid="PSA 106:7">Ne siiquwa darotethaa enti hassaybookona;</para>
  <para style="q2" vid="PSA 106:7">Zo7o abba matan iya bolla makallidosona.<verse eid="PSA 106:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 106:8"/>Gidoshin, I ba sunthaa gisho,</para>
  <para style="q2" vid="PSA 106:8">ba gita wolqaa erisanaw enta ashshis.<verse eid="PSA 106:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 106:9"/>I Zo7o abba kiittin, abbay melis;</para>
  <para style="q2" vid="PSA 106:9">mela biittara kanthidi aadhiyada,</para>
  <para style="q2" vid="PSA 106:9">ciimmo giddora enta kaalethidi pinthis.<verse eid="PSA 106:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 106:10"/>I enta ixeyisata kushepe ashshis;</para>
  <para style="q2" vid="PSA 106:10">morketa kushepe enta wozis.<verse eid="PSA 106:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 106:11"/>Enta morketa haathay mittis;</para>
  <para style="q2" vid="PSA 106:11">entafe issoyka attibeenna.<verse eid="PSA 106:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 106:12"/>He wode enti iya ufaysa qaala ammanidosona;</para>
  <para style="q2" vid="PSA 106:12">iya mazmuren sabboosona.<verse eid="PSA 106:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 106:13"/>Gidoshin, enti I oothidaba dogidosona;</para>
  <para style="q2" vid="PSA 106:13">I zoriya ogiya naagidi baanaw dosibookona.<verse eid="PSA 106:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 106:14"/>Mela biittan de7ishe daro amotidosona;</para>
  <para style="q2" vid="PSA 106:14">mela biittan Xoossaa paacidosona.<verse eid="PSA 106:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 106:15"/>Enti woossidaysa I immis;</para>
  <para style="q2" vid="PSA 106:15">shin iita harge enta giddo kiittis.<verse eid="PSA 106:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 106:16"/>Mela biittan dunkaanen de7ishe Musenne</para>
  <para style="q2" vid="PSA 106:16">Godaas dummatida Aarona qanaatidosona.<verse eid="PSA 106:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 106:17"/>Biittay dooyetidi Daatane mittis;</para>
  <para style="q2" vid="PSA 106:17">Abeero iya keetha asaara moogis.<verse eid="PSA 106:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 106:18"/>Enta maabara giddon tami eexis;</para>
  <para style="q2" vid="PSA 106:18">lacoy he iita asata xuuggis.<verse eid="PSA 106:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 106:19"/>Koreeba zuman worqafe</para>
  <para style="q2" vid="PSA 106:19">mara misile medhidosona;</para>
  <para style="q2" vid="PSA 106:19">he misiliya goyinnidosona.<verse eid="PSA 106:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 106:20"/>Enti, banta boncho Xoossa</para>
  <para style="q2" vid="PSA 106:20">maata miya mehe misilen laammidosona.<verse eid="PSA 106:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 106:21"/>Enti Gibxen gita ooso oothidanne</para>
  <para style="q2" vid="PSA 106:21">entana ashshida Xoossaa dogidosona.<verse eid="PSA 106:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 106:22"/>Kaama biittan oosetida malaalsiyabanne</para>
  <para style="q2" vid="PSA 106:22">Zo7o Abban hanida malaata oothidaasaa.<verse eid="PSA 106:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 106:23"/>Hessa gisho, Xoossay enta dhaysana gis;</para>
  <para style="q2" vid="PSA 106:23">shin dhaysonna mela iya hanqo zaaranaw,</para>
  <para style="q2" vid="PSA 106:23">Xoossay doorida Musey giddon eqis.<verse eid="PSA 106:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 106:24"/>Hessafe guye, enti</para>
  <para style="q2" vid="PSA 106:24">iya qaala ammanonna gisho,</para>
  <para style="q2" vid="PSA 106:24">he lo77o biitta kadhidosona.<verse eid="PSA 106:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 106:25"/>Enti banta dunkaaniya giddon zuuzumidosona</para>
  <para style="q2" vid="PSA 106:25">Godaa qaalas kiitetibookona.<verse eid="PSA 106:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 106:26"/>Hessa gisho, I enta bazzon yegganaw,</para>
  <para style="q2" vid="PSA 106:26">ba kushiya denthidi caaqis.<verse eid="PSA 106:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 106:27"/>Enta kochaa kawotethata giddon,</para>
  <para style="q2" vid="PSA 106:27">yegganawunne biitta bolla laallanaw caaqis.<verse eid="PSA 106:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 106:28"/>Hessafe guye, enti Bi7eel-Fagoora eeqa goyinneysatara issife gahetidosona;</para>
  <para style="q2" vid="PSA 106:28">shempoy bayna eeqatas yarshetida yarshuwa midosona.<verse eid="PSA 106:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 106:29"/>Banta oosuwan Godaa hanqethidosona;</para>
  <para style="q2" vid="PSA 106:29">hessa gaason enta giddon iita hargey wodhis.<verse eid="PSA 106:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 106:30"/>Shin Pinihaasi dendidi,</para>
  <para style="q2" vid="PSA 106:30">enta nagaraa pirdin,</para>
  <para style="q2" vid="PSA 106:30">iita hargey enta bollafe kichis.<verse eid="PSA 106:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 106:31"/>Hessika, iyaw, yeletethaafe yeletethaa gakanaw</para>
  <para style="q2" vid="PSA 106:31">merinaw xillotetha gididi taybetis.<verse eid="PSA 106:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 106:32"/>Mariba pultuwa matan Godaa hanqethidosona;</para>
  <para style="q2" vid="PSA 106:32">enta gaason Muse bolla metoy gakis.<verse eid="PSA 106:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 106:33"/>Enti iya yiloyidosona;</para>
  <para style="q2" vid="PSA 106:33">Muse doonape bessonna qaalay keyis.<verse eid="PSA 106:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 106:34"/>Goday dhaysite gin,</para>
  <para style="q2" vid="PSA 106:34">enti Kanaane asata dhaysibookona.<verse eid="PSA 106:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 106:35"/>He palabaape, enti he asatara</para>
  <para style="q2" vid="PSA 106:35">walaketidosona;</para>
  <para style="q2" vid="PSA 106:35">enta de7o woga kaallidosona.<verse eid="PSA 106:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 106:36"/>Xoossa asati enta eeqa goyinnidosona;</para>
  <para style="q2" vid="PSA 106:36">hessi entaw xihe gidis.<verse eid="PSA 106:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 106:37"/>Enti banta addenne macca nayta</para>
  <para style="q2" vid="PSA 106:37">tuna ayyaanatas yarshidosona.<verse eid="PSA 106:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 106:38"/>Enti xillo suuthu Kanaane eeqatas yarshidi,</para>
  <para style="q2" vid="PSA 106:38">banta addenne macca nayta suutha gussidosona;</para>
  <para style="q2" vid="PSA 106:38">he suuthan biittay tunis.<verse eid="PSA 106:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 106:39"/>Hessada enti banta ooson tunidosona;</para>
  <para style="q2" vid="PSA 106:39">banta hanotan banta layma kessidosona.<verse eid="PSA 106:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 106:40"/>Hessa gisho, Godaa hanqoy</para>
  <para style="q2" vid="PSA 106:40">iya asaa bolla eexis;</para>
  <para style="q2" vid="PSA 106:40">I ba laata shaatetis.<verse eid="PSA 106:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 106:41"/>I enta allaga kushen aathidi immis;</para>
  <para style="q2" vid="PSA 106:41">enta morketi enta haaridosona.<verse eid="PSA 106:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 106:42"/>Enta morketi enta un7ethidosona</para>
  <para style="q2" vid="PSA 106:42">banta shenen enta aysidosona.<verse eid="PSA 106:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 106:43"/>I enta daro wode ashshis;</para>
  <para style="q2" vid="PSA 106:43">shin enti banta makalla aggonna ixidosona;</para>
  <para style="q2" vid="PSA 106:43">banta nagaraa gaason dhayidosona.<verse eid="PSA 106:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 106:44"/>Gidoshin, I enta waasuwa si7is;</para>
  <para style="q2" vid="PSA 106:44">enta waayiya qopis.<verse eid="PSA 106:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 106:45"/>I enta gisho, ba ufaysa qaala hassayis;</para>
  <para style="q2" vid="PSA 106:45">ba siiquwa daruwan enta maaris.<verse eid="PSA 106:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 106:46"/>Enta di77ida ubbay,</para>
  <para style="q2" vid="PSA 106:46">entaw qadhetana mela oothis.<verse eid="PSA 106:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 106:47"/>Nuuni ne geeshsha sunthaa galatana mela</para>
  <para style="q2" vid="PSA 106:47">Abeeti Godaw, nu Xoossaw, nuna ashsha.</para>
  <para style="q1" vid="PSA 106:47">Ne bonchuwan nu ceeqetana mela,</para>
  <para style="q2" vid="PSA 106:47">kawotethata giddofe nuna shiisha.<verse eid="PSA 106:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 106:48"/>Isra7eele Goday, Xoossay,</para>
  <para style="q2" vid="PSA 106:48">merinaape merinaa gakanaw galatetto!</para>
  <para style="q2" vid="PSA 106:48">Asa ubbay, “Amin7i” yaago.</para>
  <para style="q2" vid="PSA 106:48">Godaa galatite!<verse eid="PSA 106:48"/></para>
  <chapter eid="PSA 106"/>
  <chapter number="107" style="c" sid="PSA 107"/>
  <para style="ms">Ichashantho Maxaafa</para>
  <para style="mr">(<ref loc="PSA 107-150">Maz 107—150</ref>)</para>
  <para style="s1">Meto Wode Elle Gakiya Xoossaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 107:1"/>I keeha gidiya gishonne</para>
  <para style="q2" vid="PSA 107:1">iya siiqoy merinaasa gidiya gisho;</para>
  <para style="q2" vid="PSA 107:1">Godaa galatite<verse eid="PSA 107:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 107:2"/>Goday ashshidaysati,</para>
  <para style="q2" vid="PSA 107:2">morke kushepe kessi ekidaysati</para>
  <para style="q2" vid="PSA 107:2">haysada yaagidi odeto.<verse eid="PSA 107:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 107:3"/>Enti Dolohapenne wulohape,</para>
  <para style="q2" vid="PSA 107:3">pudehapenne dugehape</para>
  <para style="q2" vid="PSA 107:3">biitta ubbaafe shiiqidaysata.<verse eid="PSA 107:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 107:4"/>Entafe issoti issoti mela biittan yuuyidosona.</para>
  <para style="q2" vid="PSA 107:4">Banta de7iya katamaa biya ogiya</para>
  <para style="q2" vid="PSA 107:4">demmanaw danda7ibookona.<verse eid="PSA 107:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 107:5"/>Enti koshatidosona; saamotidosona;</para>
  <para style="q2" vid="PSA 107:5">enti un7etidosona.<verse eid="PSA 107:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 107:6"/>Enti metootida wode,</para>
  <para style="q2" vid="PSA 107:6">Godaako waassidosona;</para>
  <para style="q2" vid="PSA 107:6">I enta waayiyape enta ashshis.<verse eid="PSA 107:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 107:7"/>Enti daana katama gakanaw,</para>
  <para style="q2" vid="PSA 107:7">enta suure ogen kaalethis.<verse eid="PSA 107:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 107:8"/>Merina iya siiquwa gishonne</para>
  <para style="q2" vid="PSA 107:8">I entaw oothida malaalsiya oosuwa gisho</para>
  <para style="q2" vid="PSA 107:8">enti Godaa galato.<verse eid="PSA 107:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 107:9"/>I saamotidaysata alisees;</para>
  <para style="q2" vid="PSA 107:9">koshatidaysata lo77oba kalsees.<verse eid="PSA 107:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 107:10"/>Issoti issoti sakana dhuman uttidosona;</para>
  <para style="q2" vid="PSA 107:10">birata santhalaatan waayidosona.<verse eid="PSA 107:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 107:11"/>Hessi haniday enti Ubbaafe Dhoqa Xoossaa,</para>
  <para style="q2" vid="PSA 107:11">kiita bolla makallida gishonne</para>
  <para style="q2" vid="PSA 107:11">iya zoriya kadhida gishosa.<verse eid="PSA 107:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 107:12"/>I enta waaye ooson daaburisis;</para>
  <para style="q2" vid="PSA 107:12">enta maaddiya asi dhayin kundidosona;<verse eid="PSA 107:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 107:13"/>Enti metootida wode,</para>
  <para style="q2" vid="PSA 107:13">Godaako waassidosona;</para>
  <para style="q2" vid="PSA 107:13">I enta waayiyape enta ashshis.<verse eid="PSA 107:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 107:14"/>I enta sakana dhumape kessis;</para>
  <para style="q2" vid="PSA 107:14">enti qashetida santhalaata duuthis.<verse eid="PSA 107:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 107:15"/>Iya siiquwa gishonne</para>
  <para style="q2" vid="PSA 107:15">I entaw oothida malaalsiya oosuwa gisho</para>
  <para style="q2" vid="PSA 107:15">enti Godaa galato.<verse eid="PSA 107:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 107:16"/>I naase birata pengeta menthis;</para>
  <para style="q2" vid="PSA 107:16">birata kasota qanxis.<verse eid="PSA 107:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 107:17"/>Issoti issoti eeya gididosona;</para>
  <para style="q2" vid="PSA 107:17">banta oothida nagara gaason</para>
  <para style="q2" vid="PSA 107:17">banta iitatetha gaason metootidosona.<verse eid="PSA 107:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 107:18"/>Enti kathi ixida gisho</para>
  <para style="q2" vid="PSA 107:18">hayqos gakidosona.<verse eid="PSA 107:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 107:19"/>Enti metootida wode,</para>
  <para style="q2" vid="PSA 107:19">Godaako waassidosona;</para>
  <para style="q2" vid="PSA 107:19">I enta waayiyape enta ashshis.<verse eid="PSA 107:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 107:20"/>I ba qaala kiittidi enta pathis;</para>
  <para style="q2" vid="PSA 107:20">duufope enta ashshis.<verse eid="PSA 107:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 107:21"/>Iya siiquwa gishonne</para>
  <para style="q2" vid="PSA 107:21">I entaw oothida malaalsiya oosuwa gisho</para>
  <para style="q2" vid="PSA 107:21">enti Godaa galato.<verse eid="PSA 107:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 107:22"/>Enti iyaw galata yarsho shiisho;</para>
  <para style="q2" vid="PSA 107:22">ufaysa yethan iya oosuwa odo.<verse eid="PSA 107:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 107:23"/>Issoti issoti markaben abba bollara bidosona;</para>
  <para style="q2" vid="PSA 107:23">abba bolla banta oosuwa oothidosona.<verse eid="PSA 107:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 107:24"/>Enti Godaa oosuwa be7idosona;</para>
  <para style="q2" vid="PSA 107:24">ciimmo abban oothida malaalsiyaba xeellidosona.<verse eid="PSA 107:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 107:25"/>I kiitida wode gotey dendis;</para>
  <para style="q2" vid="PSA 107:25">abba zuley qaaxis.<verse eid="PSA 107:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 107:26"/>Enti pude dendidosona;</para>
  <para style="q2" vid="PSA 107:26">duge ciimmon wodhidosona;</para>
  <para style="q2" vid="PSA 107:26">iita metoy gakin enta wozanay til7is.<verse eid="PSA 107:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 107:27"/>Enti mathotida asada</para>
  <para style="q2" vid="PSA 107:27">dhubetidi gandigaridosona;</para>
  <para style="q2" vid="PSA 107:27">enta eray maayis.<verse eid="PSA 107:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 107:28"/>Enti metootida wode,</para>
  <para style="q2" vid="PSA 107:28">Godaako waassidosona;</para>
  <para style="q2" vid="PSA 107:28">I enta waayiyape enta ashshis.<verse eid="PSA 107:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 107:29"/>I gotiya si77i oothis;</para>
  <para style="q2" vid="PSA 107:29">abba beeta sirphi oothis.<verse eid="PSA 107:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 107:30"/>Si77i gida gisho ufaytidosona;</para>
  <para style="q2" vid="PSA 107:30">enti koyida katamaa Goday gathis.<verse eid="PSA 107:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 107:31"/>Iya siiquwa gishonne</para>
  <para style="q2" vid="PSA 107:31">I entaw oothida malaalsiya oosuwa gisho</para>
  <para style="q2" vid="PSA 107:31">enti Godaa galato.<verse eid="PSA 107:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 107:32"/>Deriya shiiquwan iya gitatetha awaajo;</para>
  <para style="q2" vid="PSA 107:32">cimata duulatan iya galato.<verse eid="PSA 107:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 107:33"/>Goday shaafata melisis;</para>
  <para style="q2" vid="PSA 107:33">pultoti goggonnaada teqis.<verse eid="PSA 107:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 107:34"/>He bessan de7iya asaa iitatethaa gisho,</para>
  <para style="q2" vid="PSA 107:34">aradda biitta quu7e kessis.<verse eid="PSA 107:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 107:35"/>I mela biittan haathe eelisis;</para>
  <para style="q2" vid="PSA 107:35">mela biittan pultoy dhuuqanaada oothis.<verse eid="PSA 107:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 107:36"/>Koshatida asaa he bessan wothis;</para>
  <para style="q2" vid="PSA 107:36">bantaw daana katamaa yan keexidosona.<verse eid="PSA 107:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 107:37"/>Enti banta goshshan zeridosona;</para>
  <para style="q2" vid="PSA 107:37">woyne tokidosona;</para>
  <para style="q2" vid="PSA 107:37">daro muruuto shiishidosona.<verse eid="PSA 107:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 107:38"/>I enta anjin enti daridosona;</para>
  <para style="q2" vid="PSA 107:38">enta mehiya taybuwa guuthibeenna.<verse eid="PSA 107:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 107:39"/>Enti xoonetiya wodenne un7etiya wode,</para>
  <para style="q2" vid="PSA 107:39">metoninne azzanon kawuyiya wode,<verse eid="PSA 107:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 107:40"/>Goday enta halaqata kawushis;</para>
  <para style="q2" vid="PSA 107:40">mela biittan toylatana mela oothis.<verse eid="PSA 107:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 107:41"/>Shin manqota metope kessis;</para>
  <para style="q2" vid="PSA 107:41">enta soo asaa dorsa wudeda darsis.<verse eid="PSA 107:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 107:42"/>Suure asay hessa be7idi ufaytoosona;</para>
  <para style="q2" vid="PSA 107:42">shin iita asay yeellatidi si77i goosona.<verse eid="PSA 107:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 107:43"/>Cincati haysa ubbaa akeeko;</para>
  <para style="q2" vid="PSA 107:43">Godaa siiquwa qopo.<verse eid="PSA 107:43"/></para>
  <chapter eid="PSA 107"/>
  <chapter number="108" style="c" sid="PSA 108"/>
  <para style="s1">Xoossay Nu Bagga</para>
  <para style="d">Dawita Mazmure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 108:1"/>Ta wozanay minnidi de7ees;</para>
  <para style="q2" vid="PSA 108:1">abeeti Xoossaw, ta wozanay minnidi de7ees.</para>
  <para style="q2" vid="PSA 108:1">Ta new yexana; nena sabbana.<verse eid="PSA 108:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 108:2"/>Ta shempe, barka;</para>
  <para style="q2" vid="PSA 108:2">diithinne maasinqoy denda;</para>
  <para style="q2" vid="PSA 108:2">Ta wonta guura dendana.<verse eid="PSA 108:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 108:3"/>Abeeti Godaw, ta nena asaa giddon galatana;</para>
  <para style="q2" vid="PSA 108:3">kawotethaa giddon nena sabbana.<verse eid="PSA 108:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 108:4"/>Ne merinaa siiqoy salope dhoqa;</para>
  <para style="q2" vid="PSA 108:4">ne ammanetethay shaarape dhoqa.<verse eid="PSA 108:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 108:5"/>Abeeti Xoossaw, salope bollara ne dhoqu dhoqu ga;</para>
  <para style="q2" vid="PSA 108:5">ne bonchoy sa7a ubbaa bolla gido.<verse eid="PSA 108:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 108:6"/>Ne doseysati attana mela,</para>
  <para style="q2" vid="PSA 108:6">ne ushacha kushen nuna ashsha;</para>
  <para style="q2" vid="PSA 108:6">neeni ta woosa si7a.<verse eid="PSA 108:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 108:7"/>Xoossay ba geeshsha bessan haysada yaagis;</para>
  <para style="q2" vid="PSA 108:7">“Ta xoonada Seekema shaakana;</para>
  <para style="q2" vid="PSA 108:7">Sukota zangaara gishana.<verse eid="PSA 108:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 108:8"/>Galadinne Minaasey tabaa;</para>
  <para style="q2" vid="PSA 108:8">Efreemi ta huuphen wothiya uke;</para>
  <para style="q2" vid="PSA 108:8">Yihudi ta kawota xam7aa.<verse eid="PSA 108:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 108:9"/>Moo7abey ta meecetiya gabate;</para>
  <para style="q2" vid="PSA 108:9">Edoomey tabaa gideysa erisanaw</para>
  <para style="q2" vid="PSA 108:9">ta caammaa iya bolla wothana.</para>
  <para style="q2" vid="PSA 108:9">Filisxeeme xoonada gereerana” yaagis.<verse eid="PSA 108:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 108:10"/>Godaw, gimbetida katamaako, tana efanay oonee?</para>
  <para style="q2" vid="PSA 108:10">Edoome gakanaw tana kaalethanay oonee?<verse eid="PSA 108:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 108:11"/>Abeeti Xoossaw, nuna aggiday nena gidikii?</para>
  <para style="q2" vid="PSA 108:11">Abeeti Xoossaw, ne nu tooranchotara olas keyaka.<verse eid="PSA 108:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 108:12"/>Asa maadoy pathenna gisho,</para>
  <para style="q2" vid="PSA 108:12">morkiya olanaw ne nuna maadda.<verse eid="PSA 108:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 108:13"/>Xoossaa wolqan nu morketa xoonana;</para>
  <para style="q2" vid="PSA 108:13">nu morketa kawushanay iya.<verse eid="PSA 108:13"/></para>
  <chapter eid="PSA 108"/>
  <chapter number="109" style="c" sid="PSA 109"/>
  <para style="s1">Ta Xoossaw Tana Ashsha</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 109:1"/>Abeeti ta nena galatiya Xoossaw,</para>
  <para style="q2" vid="PSA 109:1">ne taw si77i goopa.<verse eid="PSA 109:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 109:2"/>Iita asatinne wordanchoti,</para>
  <para style="q2" vid="PSA 109:2">banta doona ta bolla dooyidosona;</para>
  <para style="q2" vid="PSA 109:2">banta wordo inxarsan ta bolla haasayoosona.<verse eid="PSA 109:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 109:3"/>Ixon ta yuushuwa teqidosona;</para>
  <para style="q2" vid="PSA 109:3">gaasoy bayna tana olidosona.<verse eid="PSA 109:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 109:4"/>Ta enta dosaysinne entaw woossayis;</para>
  <para style="q2" vid="PSA 109:4">gidoshin, enti tana mootosona.<verse eid="PSA 109:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 109:5"/>Ta lo77o oothin, taw iita zaarosona;</para>
  <para style="q2" vid="PSA 109:5">ta enta dosin, enti tana ixoosona.<verse eid="PSA 109:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 109:6"/>Ta morkiya bolla iita daynna shuuma;</para>
  <para style="q2" vid="PSA 109:6">mootanchoy iya ushachan eqo.<verse eid="PSA 109:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 109:7"/>Iya pilgiya wode I bala gididi bento;</para>
  <para style="q2" vid="PSA 109:7">iya woosay iyaw gome gido.<verse eid="PSA 109:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 109:8"/>Iya laythay qaammo;</para>
  <para style="q2" vid="PSA 109:8">iya shuumatetha hari eko.<verse eid="PSA 109:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 109:9"/>Iya nayti yi7o gido;</para>
  <para style="q2" vid="PSA 109:9">iya machiya am7o gido.<verse eid="PSA 109:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 109:10"/>Iya nayti woosancho gididi toylato;</para>
  <para style="q2" vid="PSA 109:10">banta de7iya humpa keethaafe goodeto.<verse eid="PSA 109:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 109:11"/>Iya shalo ubbaa acoy oyko;</para>
  <para style="q2" vid="PSA 109:11">I daaburidi kessidaba ubba allagi bonqo.<verse eid="PSA 109:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 109:12"/>Oonika iyaw keehopo;</para>
  <para style="q2" vid="PSA 109:12">iya naytas qadhetiya asi bentofo.<verse eid="PSA 109:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 109:13"/>Iya nayti ubbay hayqidi wuro;</para>
  <para style="q2" vid="PSA 109:13">kaalliya yeletethan iya sunthay dogeto.<verse eid="PSA 109:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 109:14"/>Iya aawata nagaray Godaa sinthan qofeto;</para>
  <para style="q2" vid="PSA 109:14">iya aaye nagaray qushetofo.<verse eid="PSA 109:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 109:15"/>Goday enta nagara ubba wode qopo;</para>
  <para style="q2" vid="PSA 109:15">enti sa7a bolla hassayetofo.<verse eid="PSA 109:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 109:16"/>I keeha oothanaw polo qopibeenna;</para>
  <para style="q2" vid="PSA 109:16">manqota, metootanchota,</para>
  <para style="q2" vid="PSA 109:16">qohetidaysata gooddidi wodhis.<verse eid="PSA 109:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 109:17"/>I baaddanaw dosida gisho,</para>
  <para style="q2" vid="PSA 109:17">I baadetidaysa gido.</para>
  <para style="q2" vid="PSA 109:17">I anjanaw dosonna gisho,</para>
  <para style="q2" vid="PSA 109:17">iya anjoy iyape haakis.<verse eid="PSA 109:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 109:18"/>Baadethi iya afilada ma7is;</para>
  <para style="q2" vid="PSA 109:18">iya baadethi haathada iya bolla laakisis;</para>
  <para style="q2" vid="PSA 109:18">zayteda iya meqethaa giddo gelo.<verse eid="PSA 109:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 109:19"/>Afilada iya kammo;</para>
  <para style="q2" vid="PSA 109:19">dancoda ubba wode iya xeessan de7o.<verse eid="PSA 109:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 109:20"/>Ha tana mooteysanne</para>
  <para style="q2" vid="PSA 109:20">ta bolla iita odeteyisata</para>
  <para style="q2" vid="PSA 109:20">Goday hessada oothidi seero.<verse eid="PSA 109:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 109:21"/>Shin abeeti Ubbaa Haariya Godaw,</para>
  <para style="q2" vid="PSA 109:21">ne suntha gisho tana maadda.</para>
  <para style="q1" vid="PSA 109:21">Ne merinaa siiquwanne</para>
  <para style="q2" vid="PSA 109:21">ne keehatetha gisho tana ashsha.<verse eid="PSA 109:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 109:22"/>Taani manqonne metootancho asi;</para>
  <para style="q2" vid="PSA 109:22">ta wozanay madunxis.<verse eid="PSA 109:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 109:23"/>Ta omarsa kuyada dhayana hanayis;</para>
  <para style="q2" vid="PSA 109:23">ta booleda qoqofetas.<verse eid="PSA 109:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 109:24"/>Xooman ta gulbatay daaburis;</para>
  <para style="q2" vid="PSA 109:24">ta asatethay laafin meqethi attis.<verse eid="PSA 109:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 109:25"/>Tana mooteysatas qelqisethas attas;</para>
  <para style="q2" vid="PSA 109:25">tana be7idi, banta huuphiya qaathosona.<verse eid="PSA 109:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 109:26"/>Abeeti Godaw ta Xoossaw, tana maadda;</para>
  <para style="q2" vid="PSA 109:26">merinaa ne siiquwada tana ashsha.<verse eid="PSA 109:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 109:27"/>Ne kushey haysa oothidaysanne,</para>
  <para style="q2" vid="PSA 109:27">ne haysa oothidaysa ta morketi ero.<verse eid="PSA 109:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 109:28"/>Enti tana baaddoosona, shin ne tana anjana;</para>
  <para style="q2" vid="PSA 109:28">tana gooddeysati yeellato; shin ne tana ufaysa.<verse eid="PSA 109:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 109:29"/>Tana mooteysati yeella ma7o;</para>
  <para style="q2" vid="PSA 109:29">banta kawushaa afilada ma7o.<verse eid="PSA 109:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 109:30"/>Taani ta inxarsan Godaa galatana;</para>
  <para style="q2" vid="PSA 109:30">deriya shiiquwan iya sabbana.<verse eid="PSA 109:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 109:31"/>I manqota gisho mootetees;</para>
  <para style="q2" vid="PSA 109:31">hayqos pirdetidaysata ashshees.<verse eid="PSA 109:31"/></para>
  <chapter eid="PSA 109"/>
  <chapter number="110" style="c" sid="PSA 110"/>
  <para style="s1">Xoossay Ta Miyena</para>
  <para style="d">Dawita mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 110:1"/>Goday ta godaa, “Ta ne morketa ne tohoy</para>
  <para style="q2" vid="PSA 110:1">yedhiya bessi oothana gakanaw,</para>
  <para style="q2" vid="PSA 110:1">haysan taape ushacha baggan utta” yaagis.<verse eid="PSA 110:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 110:2"/>Godaw ne minotetha xam7a Xiyoonepe yedda;</para>
  <para style="q2" vid="PSA 110:2">“Ne morketa haara” yaagana.<verse eid="PSA 110:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 110:3"/>Ne haariya gallas ne derey dosidi new haaretana;</para>
  <para style="q2" vid="PSA 110:3">ne geeshsha ma7uwa ma7ada,</para>
  <para style="q2" vid="PSA 110:3">wonta xalqeda ne kumetha wolqan phoolana.<verse eid="PSA 110:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 110:4"/>Goday, “Malkexaadeqi kahine gididaysada,</para>
  <para style="q2" vid="PSA 110:4">ne merinaw kahine gidana” yaagidi caaqis;</para>
  <para style="q2" vid="PSA 110:4">iya caaqoy laametenna.<verse eid="PSA 110:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 110:5"/>Goday ne ushachan de7ees;</para>
  <para style="q2" vid="PSA 110:5">ba hanquwa gallas kawota tincherethana.<verse eid="PSA 110:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 110:6"/>I kawotethata bolla pirdana;</para>
  <para style="q2" vid="PSA 110:6">ola denbata aha xalaala oothana;</para>
  <para style="q2" vid="PSA 110:6">biitta ubban de7iya kawota dhaysana.<verse eid="PSA 110:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 110:7"/>Kawoy oge lanqen de7iya pultuwafe uyidi,</para>
  <para style="q2" vid="PSA 110:7">I ba huuphiya dhoqu oothana.<verse eid="PSA 110:7"/></para>
  <chapter eid="PSA 110"/>
  <chapter number="111" style="c" sid="PSA 111"/>
  <para style="s1">Xoossa Galatite</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 111:1"/>Godaa galatite;</para>
  <para style="q2" vid="PSA 111:1">Suureta shiiqon</para>
  <para style="q2" vid="PSA 111:1">ta kumetha wozanan Godaa galatana.<verse eid="PSA 111:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 111:2"/>Godaa oosoti ay mela gite!</para>
  <para style="q2" vid="PSA 111:2">Entan ufaytiya ubbay enta qopees.<verse eid="PSA 111:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 111:3"/>Iya oosoti bonchoninne teeman kumis;</para>
  <para style="q2" vid="PSA 111:3">iya xillotethay merinaw de7ees.<verse eid="PSA 111:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 111:4"/>Iya malaalsiya oosoy hassayetishe daanada oothis;</para>
  <para style="q2" vid="PSA 111:4">I keehanne qadhetiya Godaa.<verse eid="PSA 111:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 111:5"/>Baw yayyeysatas kathi immees;</para>
  <para style="q2" vid="PSA 111:5">ba caaqo qaala merinaw baletenna.<verse eid="PSA 111:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 111:6"/>Allagata biitta ba asaas aathidi immidi,</para>
  <para style="q2" vid="PSA 111:6">ba gita wolqaa ba asaa bessis.<verse eid="PSA 111:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 111:7"/>Iya kushe oosoti tumanne suure;</para>
  <para style="q2" vid="PSA 111:7">iya woga ubbay ammanetidaysa.<verse eid="PSA 111:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 111:8"/>Enti merinaw eqidi de7oosona;</para>
  <para style="q2" vid="PSA 111:8">tumatethaninne suuretethan imetidosona.<verse eid="PSA 111:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 111:9"/>I ba asaa wozis;</para>
  <para style="q2" vid="PSA 111:9">caaqo entara merinaw essis;</para>
  <para style="q2" vid="PSA 111:9">iya sunthay geeshshinne yashsheysa.<verse eid="PSA 111:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 111:10"/>Cincatethas koyroy Godaas yashshi;</para>
  <para style="q2" vid="PSA 111:10">iya wogaa naageysatas lo77o akeeki de7ees.</para>
  <para style="q2" vid="PSA 111:10">Goday merinaw galatetto!<verse eid="PSA 111:10"/></para>
  <chapter eid="PSA 111"/>
  <chapter number="112" style="c" sid="PSA 112"/>
  <para style="s1">Xilloy Qaaxenna</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 112:1"/>Godaa galatite;</para>
  <para style="q2" vid="PSA 112:1">Godaas yayeysinne</para>
  <para style="q2" vid="PSA 112:1">iya kiita naageysi anjetidaysa.<verse eid="PSA 112:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 112:2"/>Iya nayti biittan wolqaama gidana;</para>
  <para style="q2" vid="PSA 112:2">suure asaa yeletay anjetana.<verse eid="PSA 112:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 112:3"/>Shaloynne duretethi iya keethan de7ees;</para>
  <para style="q2" vid="PSA 112:3">iya xillotethay merinaw daana.<verse eid="PSA 112:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 112:4"/>Keeha, xillonne qadhetiya asas,</para>
  <para style="q2" vid="PSA 112:4">dhuma giddon poo7oy poo7ees.<verse eid="PSA 112:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 112:5"/>Keehatethan coo tal7iya uraas,</para>
  <para style="q2" vid="PSA 112:5">ba oosuwa suuretethan oothiya uraas</para>
  <para style="q2" vid="PSA 112:5">keehabay yaana.<verse eid="PSA 112:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 112:6"/>Xillo asi awudeka kundenna;</para>
  <para style="q2" vid="PSA 112:6">I merinaw hassayetana.<verse eid="PSA 112:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 112:7"/>Iya wozanay hirgonna gishonne</para>
  <para style="q2" vid="PSA 112:7">I Godan ammanetiya gisho,</para>
  <para style="q2" vid="PSA 112:7">iitabaa si7ikoka I dagammenna;<verse eid="PSA 112:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 112:8"/>Iya wozanay mino gidiya gisho yayyenna;</para>
  <para style="q2" vid="PSA 112:8">wursethan iya morketi xoonetin be7ana.<verse eid="PSA 112:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 112:9"/>I manquwas darsidi immees;</para>
  <para style="q2" vid="PSA 112:9">iya xillotethay merinaw de7ees;</para>
  <para style="q2" vid="PSA 112:9">iya kacey bonchon dhoqu dhoqu gaana.<verse eid="PSA 112:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 112:10"/>Iita asi hessa be7idi yilotees;</para>
  <para style="q2" vid="PSA 112:10">mettershe saxishe coo dhayees;</para>
  <para style="q2" vid="PSA 112:10">iita asa amoy coo attana.<verse eid="PSA 112:10"/></para>
  <chapter eid="PSA 112"/>
  <chapter number="113" style="c" sid="PSA 113"/>
  <para style="s1">Nu Xoossa Meli Oonee?</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 113:1"/>Godaa galatite;</para>
  <para style="q2" vid="PSA 113:1">hinteno, Godaa aylleto,</para>
  <para style="q2" vid="PSA 113:1">Godaa sunthaa galatite.<verse eid="PSA 113:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 113:2"/>Godaa sunthay,</para>
  <para style="q2" vid="PSA 113:2">hachife merinaa gakanaw galatetto.<verse eid="PSA 113:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 113:3"/>Away doliyasuwape wulliyasuwa gakanaw,</para>
  <para style="q2" vid="PSA 113:3">Godaa sunthay galatetto.<verse eid="PSA 113:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 113:4"/>Goday kawotetha ubbaa haarees;</para>
  <para style="q2" vid="PSA 113:4">iya bonchoy saluwape dhoqa.<verse eid="PSA 113:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 113:5"/>Godaa nu Xoossaa meli oonee?</para>
  <para style="q2" vid="PSA 113:5">I bolla dhoqan ba araatan uttis.<verse eid="PSA 113:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 113:6"/>I salotanne sa7aa be7anaw</para>
  <para style="q2" vid="PSA 113:6">duge hokees.<verse eid="PSA 113:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 113:7"/>I manquwa baanape dhoqu oothees;</para>
  <para style="q2" vid="PSA 113:7">metootanchuwa bidope denthees.<verse eid="PSA 113:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 113:8"/>Moorinnatara lagge oothees;</para>
  <para style="q2" vid="PSA 113:8">halaqatara dhoqa bessan utisees.<verse eid="PSA 113:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 113:9"/>Mayntha maccasiw nayta aayo oothidi,</para>
  <para style="q2" vid="PSA 113:9">ufaysidi I keethan iyo bonchisees.</para>
  <para style="b" vid="PSA 113:9"/>
  <para style="p" vid="PSA 113:9">Godaa galatite!<verse eid="PSA 113:9"/></para>
  <chapter eid="PSA 113"/>
  <chapter number="114" style="c" sid="PSA 114"/>
  <para style="s1">Iya Sinthan Yashshan Kokorite</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 114:1"/>Isra7eele asay Gibxe biittafe keyida wode,</para>
  <para style="q2" vid="PSA 114:1">Yayqooba sheeshay allaga qaalan,</para>
  <para style="q2" vid="PSA 114:1">haasaya asaa aggidi bida wode,<verse eid="PSA 114:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 114:2"/>Yihuda asay Godaas geeshsha asi gidis;</para>
  <para style="q2" vid="PSA 114:2">Isra7eele asay iyaw haaretis.<verse eid="PSA 114:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 114:3"/>Abbay hessa be7idi baqatis;</para>
  <para style="q2" vid="PSA 114:3">Yordaanose shaafay guye simmis.<verse eid="PSA 114:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 114:4"/>Dereti deeshada gupidosona;</para>
  <para style="q2" vid="PSA 114:4">zumati dorsa marada dozgidosona.<verse eid="PSA 114:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 114:5"/>Abbaw, ne ayis baqatadii?</para>
  <para style="q2" vid="PSA 114:5">Yordaanose, ne ayis guye simmadii?<verse eid="PSA 114:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 114:6"/>Dereto, deeshada ayis gupidetii?</para>
  <para style="q2" vid="PSA 114:6">zumato, dorsada ayis dozgidetii?<verse eid="PSA 114:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 114:7"/>Neno biittaw, Godaa sinthan,</para>
  <para style="q2" vid="PSA 114:7">Yayqooba Xoossaa sinthan kokora.<verse eid="PSA 114:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 114:8"/>I zaalla eele haathi kessees;</para>
  <para style="q2" vid="PSA 114:8">mino zaalla haatha pulto oothees.<verse eid="PSA 114:8"/></para>
  <chapter eid="PSA 114"/>
  <chapter number="115" style="c" sid="PSA 115"/>
  <para style="s1">Nu Xoossay Dumma</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 115:1"/>Abeeti Godaw, nu gisho gidonashin,</para>
  <para style="q2" vid="PSA 115:1">ne siiquwanne ne ammanetetha gisho,</para>
  <para style="q2" vid="PSA 115:1">ne sunthaa boncha.<verse eid="PSA 115:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 115:2"/>Ayis kawotethati,</para>
  <para style="q2" vid="PSA 115:2">“Enta Xoossay awunee?” yaaganee?<verse eid="PSA 115:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 115:3"/>Nu Xoossay salon de7ees;</para>
  <para style="q2" vid="PSA 115:3">ba dosidaba ubbaa oothees.<verse eid="PSA 115:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 115:4"/>Shin enta eeqati ase kushen oosetidosona;</para>
  <para style="q2" vid="PSA 115:4">enti birapenne worqafe medhetidosona.<verse eid="PSA 115:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 115:5"/>Entaw dooni de7ees, shin haasayokona;</para>
  <para style="q2" vid="PSA 115:5">ayfey de7ees, shin xeellokona.<verse eid="PSA 115:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 115:6"/>Entaw haythi de7ees, shin si7okona;</para>
  <para style="q2" vid="PSA 115:6">siidhey de7ees, shin singokona.<verse eid="PSA 115:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 115:7"/>Entaw kushey de7ees, shin bochi erokona;</para>
  <para style="q2" vid="PSA 115:7">tohoy de7ees, shin hemetokona;</para>
  <para style="q2" vid="PSA 115:7">enta siixinathara kooshinchi keyenna.<verse eid="PSA 115:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 115:8"/>Enta medheysatinne</para>
  <para style="q2" vid="PSA 115:8">enta ammaneteysati enta mela gido.<verse eid="PSA 115:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 115:9"/>Isra7eele asaw, Godan ammanetite;</para>
  <para style="q2" vid="PSA 115:9">hintena maaddeynne hinte gondalley iya.<verse eid="PSA 115:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 115:10"/>Aarona keetha asaw, Godan ammanetite;</para>
  <para style="q2" vid="PSA 115:10">hintena maaddeynne hinte gondalley iya.<verse eid="PSA 115:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 115:11"/>Godaas yayyeysato, Godan ammanetite;</para>
  <para style="q2" vid="PSA 115:11">hintena maaddeynne hinte gondalley iya.<verse eid="PSA 115:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 115:12"/>Goday nuna qopees; I nuna anjana;</para>
  <para style="q2" vid="PSA 115:12">I Isra7eele asaa anjana;</para>
  <para style="q2" vid="PSA 115:12">I Aarona keetha asaa anjana.<verse eid="PSA 115:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 115:13"/>Godaas yayyeyisata,</para>
  <para style="q2" vid="PSA 115:13">guuthaa gita anjana.<verse eid="PSA 115:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 115:14"/>Goday hintena darso;</para>
  <para style="q2" vid="PSA 115:14">hintenanne hinte nayta anjo.<verse eid="PSA 115:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 115:15"/>Saluwanne sa7aa medhida</para>
  <para style="q2" vid="PSA 115:15">Goday hintena anjo.<verse eid="PSA 115:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 115:16"/>Saloy Xoossaba;</para>
  <para style="q2" vid="PSA 115:16">shin sa7a asas immis.<verse eid="PSA 115:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 115:17"/>Hayqidaysati Godaa galatokonna;</para>
  <para style="q2" vid="PSA 115:17">duufon zin7idaysati iya sabbokona.<verse eid="PSA 115:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 115:18"/>Shin nuuni, de7on de7eysati,</para>
  <para style="q2" vid="PSA 115:18">hachife merinaa gakanaw,</para>
  <para style="q2" vid="PSA 115:18">Godaa galatoos.</para>
  <para style="q2" vid="PSA 115:18">Godaa galatite.<verse eid="PSA 115:18"/></para>
  <chapter eid="PSA 115"/>
  <chapter number="116" style="c" sid="PSA 116"/>
  <para style="s1">Hayqope Attida Asa Galata</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 116:1"/>Goday ta waasuwanne ta woosa si7ida gisho,</para>
  <para style="q2" vid="PSA 116:1">taani iya dosayis.<verse eid="PSA 116:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 116:2"/>I ba haytha taako zaarida gisho,</para>
  <para style="q2" vid="PSA 116:2">ta de7o laytha ubban iya xeegana.<verse eid="PSA 116:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 116:3"/>Hayqoy xiheda tana teqis;</para>
  <para style="q2" vid="PSA 116:3">duufo hirgay tana oykis;</para>
  <para style="q2" vid="PSA 116:3">un7inne metoy tana qachis.<verse eid="PSA 116:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 116:4"/>He wode, “Abeeti Godaw, tana ashsha”</para>
  <para style="q2" vid="PSA 116:4">yaagada Godaa suntha xeegas.<verse eid="PSA 116:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 116:5"/>Goday keehanne xillo;</para>
  <para style="q2" vid="PSA 116:5">nu Xoossay qadhetees.<verse eid="PSA 116:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 116:6"/>Goday ashketa naagees;</para>
  <para style="q2" vid="PSA 116:6">ta metootida wode tana ashshis.<verse eid="PSA 116:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 116:7"/>Goday new keeha gidiya gisho,</para>
  <para style="q2" vid="PSA 116:7">hiza ta shempe, wopu ga.<verse eid="PSA 116:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 116:8"/>Goday ta shempuwa hayqope,</para>
  <para style="q2" vid="PSA 116:8">ta ayfiya afuthafe,</para>
  <para style="q2" vid="PSA 116:8">ta tohuwa dhubepe ashshis.<verse eid="PSA 116:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 116:9"/>Taani de7on de7eyisata giddon,</para>
  <para style="q2" vid="PSA 116:9">Godaa sinthan hemetayis.<verse eid="PSA 116:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 116:10"/>Taani, “Daro waayetas” gida wode,</para>
  <para style="q2" vid="PSA 116:10">ta ammanuwa aggabike.<verse eid="PSA 116:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 116:11"/>Taw sa7i haddirida wode,</para>
  <para style="q2" vid="PSA 116:11">“Asi ubbay wordancho” yaagas.<verse eid="PSA 116:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 116:12"/>I taw keehida keehatetha gisho</para>
  <para style="q2" vid="PSA 116:12">Godaas ay qanxanaw danda7iyana?<verse eid="PSA 116:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 116:13"/>Goday tana ashshida gisho galatana,</para>
  <para style="q2" vid="PSA 116:13">xuu7a woyne ushsha yarsho oothada shiishana.<verse eid="PSA 116:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 116:14"/>Iya asaa ubbaa sinthan</para>
  <para style="q2" vid="PSA 116:14">ta qangetha Godaas gathana.<verse eid="PSA 116:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 116:15"/>Geeshshata hayqoy</para>
  <para style="q2" vid="PSA 116:15">Godaa sinthan, daro al7o.<verse eid="PSA 116:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 116:16"/>Abeeti Godaw, taani ne aylle;</para>
  <para style="q2" vid="PSA 116:16">taani ne aylle, ne gadhinde na7aa;</para>
  <para style="q2" vid="PSA 116:16">tana qashope ne birshadasa.<verse eid="PSA 116:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 116:17"/>Godaw, ta galata yarsho new yarshana;</para>
  <para style="q2" vid="PSA 116:17">ne sunthaa xeegana.<verse eid="PSA 116:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 116:18"/>Asa ubbaa sinthan</para>
  <para style="q2" vid="PSA 116:18">ta qangetha Godaas gathana.<verse eid="PSA 116:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 116:19"/>Yerusalaamen de7iya Xoossa keethaa dabaaban,</para>
  <para style="q2" vid="PSA 116:19">ta qangetha gathana.</para>
  <para style="q2" vid="PSA 116:19">Godaa galatite.<verse eid="PSA 116:19"/></para>
  <chapter eid="PSA 116"/>
  <chapter number="117" style="c" sid="PSA 117"/>
  <para style="s1">Haa Yiite Godaa Galatana</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 117:1"/>Kawotethati ubbay Godaa galatite;</para>
  <para style="q2" vid="PSA 117:1">asa ubbay iya sabbite.<verse eid="PSA 117:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 117:2"/>Iya siiqoy nuus mino;</para>
  <para style="q2" vid="PSA 117:2">iya ammanetethay merinaasa.</para>
  <para style="q2" vid="PSA 117:2">Godaa galatite.<verse eid="PSA 117:2"/></para>
  <chapter eid="PSA 117"/>
  <chapter number="118" style="c" sid="PSA 118"/>
  <para style="s1">Iya Siiqoy Merinaasa</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 118:1"/>Goday keeha gidiya gisho galatite;</para>
  <para style="q2" vid="PSA 118:1">iya siiqoy merinaasa.<verse eid="PSA 118:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 118:2"/>Isra7eele asay,</para>
  <para style="q2" vid="PSA 118:2">“Iya siiqoy merinaasa” yaago.<verse eid="PSA 118:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 118:3"/>Aarona keetha asay,</para>
  <para style="q2" vid="PSA 118:3">“Iya siiqoy merinaasa” yaago.<verse eid="PSA 118:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 118:4"/>Godaas yayiya ubbay,</para>
  <para style="q2" vid="PSA 118:4">“Iya siiqoy merinaasa” yaago.<verse eid="PSA 118:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 118:5"/>Ta un7etida wode Godaako waassas;</para>
  <para style="q2" vid="PSA 118:5">I ta waasuwa si7idi tana la77a kessis.<verse eid="PSA 118:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 118:6"/>Goday taara de7iya gisho ta yayyike;</para>
  <para style="q2" vid="PSA 118:6">asi tana ay oothanee?<verse eid="PSA 118:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 118:7"/>Goday tana maaddanaw taara de7ees;</para>
  <para style="q2" vid="PSA 118:7">ta morketa xoonetethaa ta be7ana.<verse eid="PSA 118:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 118:8"/>Asan ammanetanape</para>
  <para style="q2" vid="PSA 118:8">Godan geemmidi atteysi lo77o.<verse eid="PSA 118:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 118:9"/>Gita asan ammanetanape</para>
  <para style="q2" vid="PSA 118:9">Godan geemmidi atteysi lo77o.<verse eid="PSA 118:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 118:10"/>Kawotethati ubbay tana teqidi oykidosona;</para>
  <para style="q2" vid="PSA 118:10">shin Godaa sunthan ta enta xoonas.<verse eid="PSA 118:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 118:11"/>Enti ta yuushuwa teqidosona;</para>
  <para style="q2" vid="PSA 118:11">shin Godaa sunthan ta enta xoonas.<verse eid="PSA 118:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 118:12"/>Enti ta yuushuwa mathada teqidosona;</para>
  <para style="q2" vid="PSA 118:12">Shin buurey taman eexeysada eexidi dhayidosona;</para>
  <para style="q2" vid="PSA 118:12">Godaa sunthan ta enta dhaysas.<verse eid="PSA 118:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 118:13"/>Taani sugetada kundanaw gakas;</para>
  <para style="q2" vid="PSA 118:13">shin Goday tana maaddis.<verse eid="PSA 118:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 118:14"/>Goday ta minotethaanne yethaa;</para>
  <para style="q2" vid="PSA 118:14">I tana ashsheysa gidis.<verse eid="PSA 118:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 118:15"/>Xillota dunkaaniyan ola xoonidi,</para>
  <para style="q2" vid="PSA 118:15">simmiya asaa ufaysas giyaba si7ite;</para>
  <para style="q2" vid="PSA 118:15">Godaa ushacha kushey gitaba oothis.<verse eid="PSA 118:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 118:16"/>Godaa ushacha kushey xoono immis;</para>
  <para style="q2" vid="PSA 118:16">Godaa ushacha kushey gitaba oothis.<verse eid="PSA 118:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 118:17"/>Taani hayqike; de7on daana;</para>
  <para style="q2" vid="PSA 118:17">Goday oothidaba awaajana.<verse eid="PSA 118:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 118:18"/>Goday tana iita seera seeris;</para>
  <para style="q2" vid="PSA 118:18">shin hayqos aathidi immibeenna.<verse eid="PSA 118:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 118:19"/>Taani gido gelada Godaa galatana mela,</para>
  <para style="q2" vid="PSA 118:19">xillotetha pengeta taw dooyite.<verse eid="PSA 118:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 118:20"/>Haysi Godaa penge;</para>
  <para style="q2" vid="PSA 118:20">xilloti iyara geloosona.<verse eid="PSA 118:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 118:21"/>Godaw, ne tana si7ida gishonne</para>
  <para style="q2" vid="PSA 118:21">taw xoono immida gisho ta nena galatayis.<verse eid="PSA 118:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 118:22"/>Gimbeysati kadhidi yeggida shuchay,</para>
  <para style="q2" vid="PSA 118:22">godaa xaphuwa minthiya shuchu gidis.<verse eid="PSA 118:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 118:23"/>Haysi Godaa ooso;</para>
  <para style="q2" vid="PSA 118:23">nu ayfiyas malaalsiyaba.<verse eid="PSA 118:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 118:24"/>Haysi gallasay Goday oothida gallas;</para>
  <para style="q2" vid="PSA 118:24">ane nuuni iyan ufaytoosinne ililoos.<verse eid="PSA 118:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 118:25"/>Godaw, ha77i nuna ashsha;</para>
  <para style="q2" vid="PSA 118:25">Godaw, ha77i nuus injeya.<verse eid="PSA 118:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 118:26"/>Godaa sunthan yaa asi anjetidaysa gido;</para>
  <para style="q2" vid="PSA 118:26">nuuni Xoossa keethaafe hintena anjoos.<verse eid="PSA 118:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 118:27"/>Goday Xoossaa; I nu bolla poo7isis;</para>
  <para style="q2" vid="PSA 118:27">yarsho bessan de7iya kaciyako keyite;</para>
  <para style="q2" vid="PSA 118:27">irxa tashe oykidi ba7aale bonchite.<verse eid="PSA 118:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 118:28"/>Neeni ta Xoossaa; ta nena galatana;</para>
  <para style="q2" vid="PSA 118:28">neeni ta Xoossaa; ta nena sabbana.<verse eid="PSA 118:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 118:29"/>Goday keeha gidiya gisho iya galatite;</para>
  <para style="q2" vid="PSA 118:29">iya siiqoy merinaasa.<verse eid="PSA 118:29"/></para>
  <chapter eid="PSA 118"/>
  <chapter number="119" style="c" sid="PSA 119"/>
  <para style="s1">Ne Higgey Ta Tohuwas Poo7o</para>
  <para style="qa">Aleef</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 119:1"/>Banta ogiyan borey baynaysatinne</para>
  <para style="q2" vid="PSA 119:1">Godaa wogaada hemeteysati anjetidaysata.<verse eid="PSA 119:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 119:2"/>Iya kiitaa naageysatinne</para>
  <para style="q2" vid="PSA 119:2">banta kumetha wozanan</para>
  <para style="q2" vid="PSA 119:2">iya koyeysati anjetidaysata.<verse eid="PSA 119:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 119:3"/>Enti bala oothidi erokona;</para>
  <para style="q2" vid="PSA 119:3">Godaa ogiyan hemetoosona.<verse eid="PSA 119:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 119:4"/>Ne kiita ammanetidi naagana mela,</para>
  <para style="q2" vid="PSA 119:4">neeni nuna kiittadasa.<verse eid="PSA 119:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 119:5"/>Ne wogaa naagada</para>
  <para style="q2" vid="PSA 119:5">ta ogey minnana mela koyayis.<verse eid="PSA 119:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 119:6"/>Ne kiita ubbaa akeekada,</para>
  <para style="q2" vid="PSA 119:6">ta polo yeellatike.<verse eid="PSA 119:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 119:7"/>Ne xillo pirdaa ta tamaarida wode,</para>
  <para style="q2" vid="PSA 119:7">ta nena suure wozanan galatana.<verse eid="PSA 119:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 119:8"/>Ta ne higgiya naagana;</para>
  <para style="q2" vid="PSA 119:8">tana polo yeggofa.<verse eid="PSA 119:8"/></para>
  <para style="qa">Beet</para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 119:9"/>Yalagay ba ogiya waatidi,</para>
  <para style="q2" vid="PSA 119:9">geeshshatethan naaganaw danda7ii?</para>
  <para style="q2" vid="PSA 119:9">Ne qaala kiitetiko danda7ees.<verse eid="PSA 119:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 119:10"/>Ta kumetha wozanan nena koyas;</para>
  <para style="q2" vid="PSA 119:10">ne kiitaape kare keyonnaada tana naaga.<verse eid="PSA 119:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 119:11"/>Taani ne bolla nagara oothonna mela</para>
  <para style="q2" vid="PSA 119:11">ne qaala ta wozanan qosas.<verse eid="PSA 119:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 119:12"/>Abeeti Godaw, ne galateta;</para>
  <para style="q2" vid="PSA 119:12">ne awaajuwa tana tamaarsa.<verse eid="PSA 119:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 119:13"/>Ne doonape keyiya pirda ubbaa</para>
  <para style="q2" vid="PSA 119:13">taani ta inxarsan odana.<verse eid="PSA 119:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 119:14"/>Duretethan ufayteysafe aathada,</para>
  <para style="q2" vid="PSA 119:14">ta ne higgiyan ufaytayis.<verse eid="PSA 119:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 119:15"/>Ne wogata zaara zaarada qopayis</para>
  <para style="q2" vid="PSA 119:15">ne ogiya loythada akeekayis.<verse eid="PSA 119:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 119:16"/>Taani ne higgiyan ufaytayis;</para>
  <para style="q2" vid="PSA 119:16">ne qaala dogike.<verse eid="PSA 119:16"/></para>
  <para style="qa">Gaamel</para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 119:17"/>Taani de7on daana melanne ne qaala kiitetana mela</para>
  <para style="q2" vid="PSA 119:17">taw ne aylliyas lo77oba ootha.<verse eid="PSA 119:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 119:18"/>Ne higgiyan de7iya malaalsiya tumatethaa</para>
  <para style="q2" vid="PSA 119:18">ta be7ana mela ta ayfiya dooya.<verse eid="PSA 119:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 119:19"/>Taani ha sa7an imathe;</para>
  <para style="q2" vid="PSA 119:19">ne kiita taape genthofa.<verse eid="PSA 119:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 119:20"/>Ta shempiya ubba wode</para>
  <para style="q2" vid="PSA 119:20">ne pirdaa laamotashe hayqasu.<verse eid="PSA 119:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 119:21"/>Otoreyisata, baadetidaysatanne,</para>
  <para style="q2" vid="PSA 119:21">ne kiitaape kare keyeyisata ne seerasa.<verse eid="PSA 119:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 119:22"/>Taani neeni odidaysa oothida gisho,</para>
  <para style="q2" vid="PSA 119:22">enta cashshaanne boriya ta bollafe digga.<verse eid="PSA 119:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 119:23"/>Hari attoshin halaqati shiiqidi,</para>
  <para style="q2" vid="PSA 119:23">ta bolla maqetikoka,</para>
  <para style="q2" vid="PSA 119:23">taani, ne oosanchoy,</para>
  <para style="q2" vid="PSA 119:23">ne awaajuwa zaara zaarada qopana.<verse eid="PSA 119:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 119:24"/>Ne markatethay tana ufaysees;</para>
  <para style="q2" vid="PSA 119:24">I tana zorees.<verse eid="PSA 119:24"/></para>
  <para style="qa">Daalet</para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 119:25"/>Taani hayqana hanayis;</para>
  <para style="q2" vid="PSA 119:25">ne gida qaalada tana ashsha.<verse eid="PSA 119:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 119:26"/>Taani ta ogiyaba new odin,</para>
  <para style="q2" vid="PSA 119:26">ne tana si7adasa;</para>
  <para style="q2" vid="PSA 119:26">hiza ne awaajuwa tana tamaarsa.<verse eid="PSA 119:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="PSA 119:27"/>Ne wogaa tana akeekisa;</para>
  <para style="q2" vid="PSA 119:27">malaalsiya oosuwa</para>
  <para style="q2" vid="PSA 119:27">taani zaara zaarada qopana.<verse eid="PSA 119:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="PSA 119:28"/>Azzanoy darida gisho ta shempoy daaburis;</para>
  <para style="q2" vid="PSA 119:28">neeni gida qaalada tana minthetha.<verse eid="PSA 119:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="PSA 119:29"/>Wordo oge taape haassa;</para>
  <para style="q2" vid="PSA 119:29">ne keehatethan ne higgiya tana tamaarsa.<verse eid="PSA 119:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="PSA 119:30"/>Taani tuma oge dooras;</para>
  <para style="q2" vid="PSA 119:30">ne pirdaa hayzas.<verse eid="PSA 119:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="PSA 119:31"/>Abeeti Godaw, ta ne higgiya minthada oykas;</para>
  <para style="q2" vid="PSA 119:31">hiza tana yeellayopa!<verse eid="PSA 119:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="PSA 119:32"/>Ta wozanaa la77a kessida gisho,</para>
  <para style="q2" vid="PSA 119:32">taani ne higgiya ogiyan woxayis.<verse eid="PSA 119:32"/></para>
  <para style="qa">He</para>
  <para style="q1">
    <verse number="33" style="v" sid="PSA 119:33"/>Abeeti Godaw,</para>
  <para style="q2" vid="PSA 119:33">ne awaajuwa birshethaa tana tamaarsa;</para>
  <para style="q2" vid="PSA 119:33">taani wursethi gakanaw iya naagana.<verse eid="PSA 119:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="PSA 119:34"/>Taani ne higgiya naagana malanne</para>
  <para style="q2" vid="PSA 119:34">ta kumetha wozanaape iyaw kittaatan mela,</para>
  <para style="q2" vid="PSA 119:34">ne taw akeeka imma.<verse eid="PSA 119:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="PSA 119:35"/>Taani iyan ufaytiya gisho,</para>
  <para style="q2" vid="PSA 119:35">ne kiita ogiyan tana kaaletha;<verse eid="PSA 119:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="PSA 119:36"/>Ta wozanaa amuwako gidonashin,</para>
  <para style="q2" vid="PSA 119:36">ne higgiyako tana zaara.<verse eid="PSA 119:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="PSA 119:37"/>Pathonnaba xeellonna mela,</para>
  <para style="q2" vid="PSA 119:37">ta ayfeta teqa;</para>
  <para style="q2" vid="PSA 119:37">ne ogiyan ta de7uwa ooraxisa.<verse eid="PSA 119:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="PSA 119:38"/>New yayyana mela,</para>
  <para style="q2" vid="PSA 119:38">ne gelida qaala, taw ne aylliyas, pola.<verse eid="PSA 119:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="PSA 119:39"/>Tana yashshiya cashsha taape digga;</para>
  <para style="q2" vid="PSA 119:39">ne pirday ay mela lo77o!<verse eid="PSA 119:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="PSA 119:40"/>Taani ne wogaa naaganaw amottayis;</para>
  <para style="q2" vid="PSA 119:40">neeni xillo gidiya gisho,</para>
  <para style="q2" vid="PSA 119:40">ta de7uwa ooraxisa.<verse eid="PSA 119:40"/></para>
  <para style="qa">Waw</para>
  <para style="q1">
    <verse number="41" style="v" sid="PSA 119:41"/>Abeeti Godaw, ne siiquwa tana bessa;</para>
  <para style="q2" vid="PSA 119:41">neeni gelida qaalada tana ashsha.<verse eid="PSA 119:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="PSA 119:42"/>Taani ne qaalan ammanetiya gisho,</para>
  <para style="q2" vid="PSA 119:42">tana cayeyisata zaaranaw danda7ayis.<verse eid="PSA 119:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="PSA 119:43"/>Taani ne pirda ufaysi oothida gisho,</para>
  <para style="q2" vid="PSA 119:43">ta inxarsaafe tumatethaa qaala dhaysofa.<verse eid="PSA 119:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="PSA 119:44"/>Taani merii merinaw</para>
  <para style="q2" vid="PSA 119:44">ne higgiya kiitetana.<verse eid="PSA 119:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="PSA 119:45"/>Taani ne woga poliya gisho,</para>
  <para style="q2" vid="PSA 119:45">aahon hemetana.<verse eid="PSA 119:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="PSA 119:46"/>Taani kawota sinthan eqada,</para>
  <para style="q2" vid="PSA 119:46">neeni gidaba odashe yeellatike.<verse eid="PSA 119:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="PSA 119:47"/>Taani ne kiitata dosayis,</para>
  <para style="q2" vid="PSA 119:47">entan ufaytayis.<verse eid="PSA 119:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="PSA 119:48"/>Taani dosiya ne kiita bonchayis;</para>
  <para style="q2" vid="PSA 119:48">ne awaajuwa zaara zaarada qopana.<verse eid="PSA 119:48"/></para>
  <para style="qa">Zaw</para>
  <para style="q1">
    <verse number="49" style="v" sid="PSA 119:49"/>Neeni taw, ne aylliyas,</para>
  <para style="q2" vid="PSA 119:49">immida qaala qopa;</para>
  <para style="q2" vid="PSA 119:49">ne qaalan taani ufaysi oothayis.<verse eid="PSA 119:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="PSA 119:50"/>Ne qaalay tana de7on wothees;</para>
  <para style="q2" vid="PSA 119:50">I meto wode tana minthethees.<verse eid="PSA 119:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="PSA 119:51"/>Otoranchoti tana likefe aathidi cayoosona;</para>
  <para style="q2" vid="PSA 119:51">shin taani ne higgiyafe sher7i giike.<verse eid="PSA 119:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="PSA 119:52"/>Abeeti Godaw,</para>
  <para style="q2" vid="PSA 119:52">benipe de7iya ne pirda taani hassayayis;</para>
  <para style="q2" vid="PSA 119:52">hessan taani minettayis.<verse eid="PSA 119:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="PSA 119:53"/>Iitati ne higgiya kiitetonaysa be7in,</para>
  <para style="q2" vid="PSA 119:53">tana yiloy wodhis.<verse eid="PSA 119:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="PSA 119:54"/>Taani de7iya allaga biittan</para>
  <para style="q2" vid="PSA 119:54">ne awaajoy taw yethi gidis.<verse eid="PSA 119:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="PSA 119:55"/>Abeeti Godaw,</para>
  <para style="q2" vid="PSA 119:55">taani qamma ne suntha qopayis;</para>
  <para style="q2" vid="PSA 119:55">ne higgiya naagayis.<verse eid="PSA 119:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="PSA 119:56"/>Ta Ne woga naagana;</para>
  <para style="q2" vid="PSA 119:56">I taw ooso gidis.<verse eid="PSA 119:56"/></para>
  <para style="qa">Heet</para>
  <para style="q1">
    <verse number="57" style="v" sid="PSA 119:57"/>Abeeti Godaw, ta saamay nena;</para>
  <para style="q2" vid="PSA 119:57">ta ne higgiya naaganaw qanxas.<verse eid="PSA 119:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="PSA 119:58"/>Ta kumetha wozanan nena woossayis;</para>
  <para style="q2" vid="PSA 119:58">ne gelida qaalada taw qadheta.<verse eid="PSA 119:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="PSA 119:59"/>Taani ta ogiya akeeka xeellada,</para>
  <para style="q2" vid="PSA 119:59">ne higgiya kaallanaw simmas.<verse eid="PSA 119:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="PSA 119:60"/>Taani ne kiita naaganaw,</para>
  <para style="q2" vid="PSA 119:60">eesotanaape attishin, gam7ike.<verse eid="PSA 119:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="PSA 119:61"/>Iitati taw xihe yeggikoka,</para>
  <para style="q2" vid="PSA 119:61">taani ne higgiya dogike.<verse eid="PSA 119:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="PSA 119:62"/>Ne xillo pirda gisho, nena galatanaw,</para>
  <para style="q2" vid="PSA 119:62">taani gidi bilahe dendayis.<verse eid="PSA 119:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="PSA 119:63"/>Taani new yayyeyisata ubbaasinne</para>
  <para style="q2" vid="PSA 119:63">ne wogaa naageysata dabbo.<verse eid="PSA 119:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="PSA 119:64"/>Abeeti Godaw, sa7i ne siiquwan kumis;</para>
  <para style="q2" vid="PSA 119:64">ne awaajuwa tana tamaarsa.<verse eid="PSA 119:64"/></para>
  <para style="qa">Xeet</para>
  <para style="q1">
    <verse number="65" style="v" sid="PSA 119:65"/>Abeeti Godaw, ne gelida qaalada</para>
  <para style="q2" vid="PSA 119:65">taw ne aylliyas keehaba oothadasa.<verse eid="PSA 119:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="PSA 119:66"/>Taani ne kiitatan ammanetiya gisho,</para>
  <para style="q2" vid="PSA 119:66">lo77o pirdanne eratethi tana tamaarsa.<verse eid="PSA 119:66"/></para>
  <para style="q1">
    <verse number="67" style="v" sid="PSA 119:67"/>Taani seeretanaape kase kare hemetas;</para>
  <para style="q2" vid="PSA 119:67">shin ha77i ne qaalas kiitetayis.<verse eid="PSA 119:67"/></para>
  <para style="q1">
    <verse number="68" style="v" sid="PSA 119:68"/>Neeni keeha; neeni keehaba oothaasa;</para>
  <para style="q2" vid="PSA 119:68">ne awaajuwa tana tamaarsa.<verse eid="PSA 119:68"/></para>
  <para style="q1">
    <verse number="69" style="v" sid="PSA 119:69"/>Otoranchoti ta sunthaa wordon iissoosona;</para>
  <para style="q2" vid="PSA 119:69">shin ta ne wogaa ta kumetha wozanan naagana.<verse eid="PSA 119:69"/></para>
  <para style="q1">
    <verse number="70" style="v" sid="PSA 119:70"/>Enta wozanay kumthi doccis;</para>
  <para style="q2" vid="PSA 119:70">shin taani ne higgiyan ufaytayis.<verse eid="PSA 119:70"/></para>
  <para style="q1">
    <verse number="71" style="v" sid="PSA 119:71"/>Ne higgiya tamaarana mela</para>
  <para style="q2" vid="PSA 119:71">ne tana seeridaysi taw lo77o gidis.<verse eid="PSA 119:71"/></para>
  <para style="q1">
    <verse number="72" style="v" sid="PSA 119:72"/>Daro worqafenne birape,</para>
  <para style="q2" vid="PSA 119:72">ne doonape keyiya higgey taw aadhees.<verse eid="PSA 119:72"/></para>
  <para style="qa">Yood</para>
  <para style="q1">
    <verse number="73" style="v" sid="PSA 119:73"/>Tana ne kushey medhis; ne kushey giigisis;</para>
  <para style="q2" vid="PSA 119:73">ne kiita tamaarana mela taw akeeka imma.<verse eid="PSA 119:73"/></para>
  <para style="q1">
    <verse number="74" style="v" sid="PSA 119:74"/>Taani ne qaalan ufaysi oothida gisho,</para>
  <para style="q2" vid="PSA 119:74">nena boncheysati tana be7idi ufayto.<verse eid="PSA 119:74"/></para>
  <para style="q1">
    <verse number="75" style="v" sid="PSA 119:75"/>Abeeti Godaw, ne pirday xillo gideysa eras;</para>
  <para style="q2" vid="PSA 119:75">ne tana seeriday ammanetethan gideysa ta akeekas.<verse eid="PSA 119:75"/></para>
  <para style="q1">
    <verse number="76" style="v" sid="PSA 119:76"/>Taw ne aylliyas gida qaalada,</para>
  <para style="q2" vid="PSA 119:76">ne siiqoy tana minthetho.<verse eid="PSA 119:76"/></para>
  <para style="q1">
    <verse number="77" style="v" sid="PSA 119:77"/>Ne higgey tana ufaysiya gisho,</para>
  <para style="q2" vid="PSA 119:77">taani de7on daana mela taw qadheta.<verse eid="PSA 119:77"/></para>
  <para style="q1">
    <verse number="78" style="v" sid="PSA 119:78"/>Otoranchoti tana wordon mootiya gisho yeellato;</para>
  <para style="q2" vid="PSA 119:78">taani ne wogaa zaara zaarada qopayis.<verse eid="PSA 119:78"/></para>
  <para style="q1">
    <verse number="79" style="v" sid="PSA 119:79"/>New yayyeysatinne</para>
  <para style="q2" vid="PSA 119:79">ne markatethaa ereysati taako yo.<verse eid="PSA 119:79"/></para>
  <para style="q1">
    <verse number="80" style="v" sid="PSA 119:80"/>Ta yeellatonna mela,</para>
  <para style="q2" vid="PSA 119:80">ta wozanay ne higgiyan borey baynaysa gido.<verse eid="PSA 119:80"/></para>
  <para style="qa">Kaaf</para>
  <para style="q1">
    <verse number="81" style="v" sid="PSA 119:81"/>Neeni tana ashshana mela,</para>
  <para style="q2" vid="PSA 119:81">taani naagashe daaburas;</para>
  <para style="q2" vid="PSA 119:81">taani ne qaalan ufaysi oothayis.<verse eid="PSA 119:81"/></para>
  <para style="q1">
    <verse number="82" style="v" sid="PSA 119:82"/>Neeni gida qaalay poletin</para>
  <para style="q2" vid="PSA 119:82">be7anaw naagishin ta ayfey teljumis.</para>
  <para style="q2" vid="PSA 119:82">“Ne tana awude minthethane” yaagas.<verse eid="PSA 119:82"/></para>
  <para style="q1">
    <verse number="83" style="v" sid="PSA 119:83"/>Cuyan kaqetida ogoroda gundas;</para>
  <para style="q2" vid="PSA 119:83">gidoshin ne awaajuwa balabiike.<verse eid="PSA 119:83"/></para>
  <para style="q1">
    <verse number="84" style="v" sid="PSA 119:84"/>Taani ne aylley awude gakanaw naago?</para>
  <para style="q2" vid="PSA 119:84">Tana yedetheyisata ne awude pirdanee?<verse eid="PSA 119:84"/></para>
  <para style="q1">
    <verse number="85" style="v" sid="PSA 119:85"/>Ne higgiya naagonna otoranchoti</para>
  <para style="q2" vid="PSA 119:85">tana oykanaw olla bookosona.<verse eid="PSA 119:85"/></para>
  <para style="q1">
    <verse number="86" style="v" sid="PSA 119:86"/>Ne kiita ubbay ammantheyisata;</para>
  <para style="q2" vid="PSA 119:86">gaasoy bayna asay tana yedethiya gisho</para>
  <para style="q2" vid="PSA 119:86">tana maadda.<verse eid="PSA 119:86"/></para>
  <para style="q1">
    <verse number="87" style="v" sid="PSA 119:87"/>Enti tana wodhi diggidi aggidosona;</para>
  <para style="q2" vid="PSA 119:87">shin ta ne wogaa aggabike.<verse eid="PSA 119:87"/></para>
  <para style="q1">
    <verse number="88" style="v" sid="PSA 119:88"/>Ne siiquwan ta de7uwa naaga;</para>
  <para style="q2" vid="PSA 119:88">ta ne kiitaa naagana.<verse eid="PSA 119:88"/></para>
  <para style="qa">Laamed</para>
  <para style="q1">
    <verse number="89" style="v" sid="PSA 119:89"/>Abeeti Godaw, ne qaalay merinaasa;</para>
  <para style="q2" vid="PSA 119:89">I salon minnidi de7ees.<verse eid="PSA 119:89"/></para>
  <para style="q1">
    <verse number="90" style="v" sid="PSA 119:90"/>Yeletape yeletaa gakanaw ne ammanetaasa;</para>
  <para style="q2" vid="PSA 119:90">ne ha sa7aa minthada essadasa; ika minnidi de7ees.<verse eid="PSA 119:90"/></para>
  <para style="q1">
    <verse number="91" style="v" sid="PSA 119:91"/>Ubbay ne aylle gidiya gisho,</para>
  <para style="q2" vid="PSA 119:91">hachi gakanaw ubbay ne kiittada minnidi de7ees;<verse eid="PSA 119:91"/></para>
  <para style="q1">
    <verse number="92" style="v" sid="PSA 119:92"/>Ne higgey tana ufaysonnaba gidiyako,</para>
  <para style="q2" vid="PSA 119:92">ta waayan ta dhayanashin.<verse eid="PSA 119:92"/></para>
  <para style="q1">
    <verse number="93" style="v" sid="PSA 119:93"/>Taani ne wogaa kumethi dogike;</para>
  <para style="q2" vid="PSA 119:93">neeni iyan tana de7on wothadasa.<verse eid="PSA 119:93"/></para>
  <para style="q1">
    <verse number="94" style="v" sid="PSA 119:94"/>Taani nebaa gidiya gisho tana ashsha;</para>
  <para style="q2" vid="PSA 119:94">taani ne wogaa naaganaw koyayis.<verse eid="PSA 119:94"/></para>
  <para style="q1">
    <verse number="95" style="v" sid="PSA 119:95"/>Iitati tana dhaysanaw zugidi naagoosona;</para>
  <para style="q2" vid="PSA 119:95">shin taani neena qopayis.<verse eid="PSA 119:95"/></para>
  <para style="q1">
    <verse number="96" style="v" sid="PSA 119:96"/>Polo geetetidaba ubbaas zawi de7eysa ta be7as;</para>
  <para style="q2" vid="PSA 119:96">shin polo gidida higgiyas zawi baawa.<verse eid="PSA 119:96"/></para>
  <para style="qa">Meem</para>
  <para style="q1">
    <verse number="97" style="v" sid="PSA 119:97"/>Taani ne higgiya waanada dosiyana!</para>
  <para style="q2" vid="PSA 119:97">kumetha gallas taani iya qopayis.<verse eid="PSA 119:97"/></para>
  <para style="q1">
    <verse number="98" style="v" sid="PSA 119:98"/>Ne kiitay ubba wode taara de7iya gisho,</para>
  <para style="q2" vid="PSA 119:98">ta morketape aathidi tana akeeka kessoosona.<verse eid="PSA 119:98"/></para>
  <para style="q1">
    <verse number="99" style="v" sid="PSA 119:99"/>Taani nee higgiya qopiya gisho,</para>
  <para style="q2" vid="PSA 119:99">ta astamaaretape aadhida cincatethi taw de7ees.<verse eid="PSA 119:99"/></para>
  <para style="q1">
    <verse number="100" style="v" sid="PSA 119:100"/>Taani ne wogaa kiitetiya gisho,</para>
  <para style="q2" vid="PSA 119:100">cimatape aathada akeekayis.<verse eid="PSA 119:100"/></para>
  <para style="q1">
    <verse number="101" style="v" sid="PSA 119:101"/>Taani ne qaala kiitetanaw koyiya gisho,</para>
  <para style="q2" vid="PSA 119:101">ta tohuwa iita oge ubbaafe naagas.<verse eid="PSA 119:101"/></para>
  <para style="q1">
    <verse number="102" style="v" sid="PSA 119:102"/>Neeni tana tamaarsida gisho,</para>
  <para style="q2" vid="PSA 119:102">ta ne higgiyafe gaxa keyike.<verse eid="PSA 119:102"/></para>
  <para style="q1">
    <verse number="103" style="v" sid="PSA 119:103"/>Ne qaalay waanidi mal7i!</para>
  <para style="q2" vid="PSA 119:103">ililo eessafe aadhidi mal7ees.<verse eid="PSA 119:103"/></para>
  <para style="q1">
    <verse number="104" style="v" sid="PSA 119:104"/>Ne wogaape akeeka demmas;</para>
  <para style="q2" vid="PSA 119:104">hessa gisho, geella oge ubbaa ixas.<verse eid="PSA 119:104"/></para>
  <para style="qa">Non</para>
  <para style="q1">
    <verse number="105" style="v" sid="PSA 119:105"/>Ne qaalay ta tohuwas xompe,</para>
  <para style="q2" vid="PSA 119:105">ta ogiyas poo7o.<verse eid="PSA 119:105"/></para>
  <para style="q1">
    <verse number="106" style="v" sid="PSA 119:106"/>Ne xillo pirdada daanaw,</para>
  <para style="q2" vid="PSA 119:106">ta caaqida caaquwa minthana.<verse eid="PSA 119:106"/></para>
  <para style="q1">
    <verse number="107" style="v" sid="PSA 119:107"/>Abeeti Godaw, ta waayey daro;</para>
  <para style="q2" vid="PSA 119:107">ne ufaysa qaalada tana de7on wotha.<verse eid="PSA 119:107"/></para>
  <para style="q1">
    <verse number="108" style="v" sid="PSA 119:108"/>Abeeti Godaw,</para>
  <para style="q2" vid="PSA 119:108">ta galataa yarshuwa eka;</para>
  <para style="q2" vid="PSA 119:108">tana ne pirdaa tamaarsa.<verse eid="PSA 119:108"/></para>
  <para style="q1">
    <verse number="109" style="v" sid="PSA 119:109"/>Ta shempoy ubba wode meton de7ees;</para>
  <para style="q2" vid="PSA 119:109">shin taani ne higgiya dogike.<verse eid="PSA 119:109"/></para>
  <para style="q1">
    <verse number="110" style="v" sid="PSA 119:110"/>Iitati taw gite yeggidosona;</para>
  <para style="q2" vid="PSA 119:110">shin taani ne wogaape kare keyabike.<verse eid="PSA 119:110"/></para>
  <para style="q1">
    <verse number="111" style="v" sid="PSA 119:111"/>Ne higgey taw merinaa shalo;</para>
  <para style="q2" vid="PSA 119:111">I ta wozanaas ufaysi immees.<verse eid="PSA 119:111"/></para>
  <para style="q1">
    <verse number="112" style="v" sid="PSA 119:112"/>Ta hayqana gakanaw</para>
  <para style="q2" vid="PSA 119:112">ne awaajuwada oothanaw qofa qachas.<verse eid="PSA 119:112"/></para>
  <para style="qa">Samket</para>
  <para style="q1">
    <verse number="113" style="v" sid="PSA 119:113"/>Taani nam7u qofi de7iya asaa ixayis;</para>
  <para style="q2" vid="PSA 119:113">shin ne higgiya dosayis.<verse eid="PSA 119:113"/></para>
  <para style="q1">
    <verse number="114" style="v" sid="PSA 119:114"/>Ne taw gondallenne qosetada attiya besse</para>
  <para style="q2" vid="PSA 119:114">taani ne qaalan ufaysi oothayis.<verse eid="PSA 119:114"/></para>
  <para style="q1">
    <verse number="115" style="v" sid="PSA 119:115"/>Taani ta Xoossaa kiita naagana mela,</para>
  <para style="q2" vid="PSA 119:115">hinteno, iita oothiya ubbay taape haakite.<verse eid="PSA 119:115"/></para>
  <para style="q1">
    <verse number="116" style="v" sid="PSA 119:116"/>Taani de7on daana mela</para>
  <para style="q2" vid="PSA 119:116">ne ufaysa qaalada tana minthetha;</para>
  <para style="q2" vid="PSA 119:116">ta ufaysaa dhumisopa.<verse eid="PSA 119:116"/></para>
  <para style="q1">
    <verse number="117" style="v" sid="PSA 119:117"/>Ta saro daana mela tana zempisa;</para>
  <para style="q2" vid="PSA 119:117">ta ubba wode ne awaajuwa si7ana.<verse eid="PSA 119:117"/></para>
  <para style="q1">
    <verse number="118" style="v" sid="PSA 119:118"/>Ne awaajuwafe haakeyisata ne koyaka;</para>
  <para style="q2" vid="PSA 119:118">enta cimoy hada.<verse eid="PSA 119:118"/></para>
  <para style="q1">
    <verse number="119" style="v" sid="PSA 119:119"/>Iitata ubbaa ne pitoda taybaasa;</para>
  <para style="q2" vid="PSA 119:119">hessa gisho, taani ne kiitaa dosayis.<verse eid="PSA 119:119"/></para>
  <para style="q1">
    <verse number="120" style="v" sid="PSA 119:120"/>Ta asatethay yashshan new kokorees;</para>
  <para style="q2" vid="PSA 119:120">ta ne higgiya daro yayyayis.<verse eid="PSA 119:120"/></para>
  <para style="qa">Ee</para>
  <para style="q1">
    <verse number="121" style="v" sid="PSA 119:121"/>Ta suurenne xillo oothas;</para>
  <para style="q2" vid="PSA 119:121">tana ta morketas aathada immofa.<verse eid="PSA 119:121"/></para>
  <para style="q1">
    <verse number="122" style="v" sid="PSA 119:122"/>Tana ne aylliya maaddanaw caaqa;</para>
  <para style="q2" vid="PSA 119:122">tana otoranchoti un7ethana mela oothofa.<verse eid="PSA 119:122"/></para>
  <para style="q1">
    <verse number="123" style="v" sid="PSA 119:123"/>Ne tana ashshana gada ta xeellishin,</para>
  <para style="q2" vid="PSA 119:123">ne xillo qaala ta naagishin,</para>
  <para style="q2" vid="PSA 119:123">ta ayfey teljumis.<verse eid="PSA 119:123"/></para>
  <para style="q1">
    <verse number="124" style="v" sid="PSA 119:124"/>Taw ne aylliyas, ne siiquwada ootha;</para>
  <para style="q2" vid="PSA 119:124">ne higgiya tana tamaarsa.<verse eid="PSA 119:124"/></para>
  <para style="q1">
    <verse number="125" style="v" sid="PSA 119:125"/>Tana ne aylliya ne siiquwa bessa;</para>
  <para style="q2" vid="PSA 119:125">ne wogaa erana mela taw akeeka imma.<verse eid="PSA 119:125"/></para>
  <para style="q1">
    <verse number="126" style="v" sid="PSA 119:126"/>Abeeti Godaw, asay ne higgiya menthida gisho,</para>
  <para style="q2" vid="PSA 119:126">ne pirdana wodey ha77i gakis.<verse eid="PSA 119:126"/></para>
  <para style="q1">
    <verse number="127" style="v" sid="PSA 119:127"/>Taani ne kiita worqafe aathada dosay;</para>
  <para style="q2" vid="PSA 119:127">ee, walahi bayna worqafe aathada dosayis.<verse eid="PSA 119:127"/></para>
  <para style="q1">
    <verse number="128" style="v" sid="PSA 119:128"/>Hessa gisho, ta ne wogata ubbaa kaallayis;</para>
  <para style="q2" vid="PSA 119:128">geella oge ubbaa ixas.<verse eid="PSA 119:128"/></para>
  <para style="qa">Pe</para>
  <para style="q1">
    <verse number="129" style="v" sid="PSA 119:129"/>Ne woga ubbay malaalsiyaba;</para>
  <para style="q2" vid="PSA 119:129">hessa gisho, ta iya kiitetayis.<verse eid="PSA 119:129"/></para>
  <para style="q1">
    <verse number="130" style="v" sid="PSA 119:130"/>Ne qaala birshethay poo7o immees;</para>
  <para style="q2" vid="PSA 119:130">cincatethi pacidaysatas akeeka immees.<verse eid="PSA 119:130"/></para>
  <para style="q1">
    <verse number="131" style="v" sid="PSA 119:131"/>Taani ne kiitaa saamotada,</para>
  <para style="q2" vid="PSA 119:131">ta doona dooyas.<verse eid="PSA 119:131"/></para>
  <para style="q1">
    <verse number="132" style="v" sid="PSA 119:132"/>Haa taako simma;</para>
  <para style="q2" vid="PSA 119:132">nena doseysatas ne ootheysada taw qadheta.<verse eid="PSA 119:132"/></para>
  <para style="q1">
    <verse number="133" style="v" sid="PSA 119:133"/>Ne ufaysa qaalada ta hemethaa suurisa;</para>
  <para style="q2" vid="PSA 119:133">nagari tana haarana mela oothofa.<verse eid="PSA 119:133"/></para>
  <para style="q1">
    <verse number="134" style="v" sid="PSA 119:134"/>Ta ne wogaa kiitetana mela</para>
  <para style="q2" vid="PSA 119:134">tana un7etheyisata kushepe woza.<verse eid="PSA 119:134"/></para>
  <para style="q1">
    <verse number="135" style="v" sid="PSA 119:135"/>Ne aylliya ta bolla ne som7uwa poo7isa;</para>
  <para style="q2" vid="PSA 119:135">ne higgiya tamaarsa.<verse eid="PSA 119:135"/></para>
  <para style="q1">
    <verse number="136" style="v" sid="PSA 119:136"/>Asay ne higgiya menthida gisho,</para>
  <para style="q2" vid="PSA 119:136">ta afuthay haathada goggees.<verse eid="PSA 119:136"/></para>
  <para style="qa">Xaade</para>
  <para style="q1">
    <verse number="137" style="v" sid="PSA 119:137"/>Abeeti Godaw, ne xillo;</para>
  <para style="q2" vid="PSA 119:137">ne pirday suure.<verse eid="PSA 119:137"/></para>
  <para style="q1">
    <verse number="138" style="v" sid="PSA 119:138"/>Ne higgey xillo;</para>
  <para style="q2" vid="PSA 119:138">ay wodeka ammanetees.<verse eid="PSA 119:138"/></para>
  <para style="q1">
    <verse number="139" style="v" sid="PSA 119:139"/>Ta morketi ne qaala toochida gisho,</para>
  <para style="q2" vid="PSA 119:139">ta mishay tamada eexidi keyis.<verse eid="PSA 119:139"/></para>
  <para style="q1">
    <verse number="140" style="v" sid="PSA 119:140"/>Ne ufaysa qaalay daro ammanetees;</para>
  <para style="q2" vid="PSA 119:140">ta ne aylley daro dosayis.<verse eid="PSA 119:140"/></para>
  <para style="q1">
    <verse number="141" style="v" sid="PSA 119:141"/>Taani pathonnanne kadhetida asi;</para>
  <para style="q2" vid="PSA 119:141">gidoshin ta ne wogaa dogike.<verse eid="PSA 119:141"/></para>
  <para style="q1">
    <verse number="142" style="v" sid="PSA 119:142"/>Ne xillotethay merinaw de7ees;</para>
  <para style="q2" vid="PSA 119:142">ne higgey tuma.<verse eid="PSA 119:142"/></para>
  <para style="q1">
    <verse number="143" style="v" sid="PSA 119:143"/>Metoynne un7i tana gakis;</para>
  <para style="q2" vid="PSA 119:143">shin ne kiitati tana ufaysoosona.<verse eid="PSA 119:143"/></para>
  <para style="q1">
    <verse number="144" style="v" sid="PSA 119:144"/>Ne wogay merinaw xillo;</para>
  <para style="q2" vid="PSA 119:144">ta de7on daana mela taw akeeka imma.<verse eid="PSA 119:144"/></para>
  <para style="qa">Qoof</para>
  <para style="q1">
    <verse number="145" style="v" sid="PSA 119:145"/>Abeeti Godaw, ta kumetha wozanaape</para>
  <para style="q2" vid="PSA 119:145">neeko waassas; tana alla;</para>
  <para style="q2" vid="PSA 119:145">Ta ne awaajuwa naagana.<verse eid="PSA 119:145"/></para>
  <para style="q1">
    <verse number="146" style="v" sid="PSA 119:146"/>Ta neeko waassas; tana ashsha;</para>
  <para style="q2" vid="PSA 119:146">ta ne higgiya naagana.<verse eid="PSA 119:146"/></para>
  <para style="q1">
    <verse number="147" style="v" sid="PSA 119:147"/>Xalqey caaronna wonta dendada,</para>
  <para style="q2" vid="PSA 119:147">tana maadda gada neeko waassayis;</para>
  <para style="q2" vid="PSA 119:147">ne gelida qaalan ufaysi wothayis.<verse eid="PSA 119:147"/></para>
  <para style="q1">
    <verse number="148" style="v" sid="PSA 119:148"/>Ne qaalaba zaara zaara qopanaw,</para>
  <para style="q2" vid="PSA 119:148">qamma utta aqayis.<verse eid="PSA 119:148"/></para>
  <para style="q1">
    <verse number="149" style="v" sid="PSA 119:149"/>Abeeti Godaw, ne siiquwa gisho, tana si7a;</para>
  <para style="q2" vid="PSA 119:149">ne xillo pirdada tana de7on wotha.<verse eid="PSA 119:149"/></para>
  <para style="q1">
    <verse number="150" style="v" sid="PSA 119:150"/>Tana yedethiya iitati tako matoosona;</para>
  <para style="q2" vid="PSA 119:150">shin enti ne higgiyafe haakoosona.<verse eid="PSA 119:150"/></para>
  <para style="q1">
    <verse number="151" style="v" sid="PSA 119:151"/>Shin abeeti Godaw, ne taw matan de7aasa;</para>
  <para style="q2" vid="PSA 119:151">ne kiita ubbay tuma.<verse eid="PSA 119:151"/></para>
  <para style="q1">
    <verse number="152" style="v" sid="PSA 119:152"/>Taani benipe doomada, ne higgiya tamaaras;</para>
  <para style="q2" vid="PSA 119:152">ne iya merinaw minthada essadasa.<verse eid="PSA 119:152"/></para>
  <para style="qa">Rees</para>
  <para style="q1">
    <verse number="153" style="v" sid="PSA 119:153"/>Ta ne higgiya dogonna gisho,</para>
  <para style="q2" vid="PSA 119:153">ta metuwa be7ada tana ashsha;<verse eid="PSA 119:153"/></para>
  <para style="q1">
    <verse number="154" style="v" sid="PSA 119:154"/>Ta gisho mootetada tana woza;</para>
  <para style="q2" vid="PSA 119:154">ne ufaysa qaalada tana de7on wotha.<verse eid="PSA 119:154"/></para>
  <para style="q1">
    <verse number="155" style="v" sid="PSA 119:155"/>Ne higgiya enti ekonna gisho,</para>
  <para style="q2" vid="PSA 119:155">iitati atotethi demmokona.<verse eid="PSA 119:155"/></para>
  <para style="q1">
    <verse number="156" style="v" sid="PSA 119:156"/>Abeeti Godaw, ne qadhey daro;</para>
  <para style="q2" vid="PSA 119:156">ne xillo pirdada tana de7on wotha.<verse eid="PSA 119:156"/></para>
  <para style="q1">
    <verse number="157" style="v" sid="PSA 119:157"/>Tana ixeysatinne yedetheysati daro;</para>
  <para style="q2" vid="PSA 119:157">shin ta ne higgiyafe gaxa keyike.<verse eid="PSA 119:157"/></para>
  <para style="q1">
    <verse number="158" style="v" sid="PSA 119:158"/>Enti ne kiita naagonna gisho,</para>
  <para style="q2" vid="PSA 119:158">ta nena kaddeyisata be7ada shaatettas.<verse eid="PSA 119:158"/></para>
  <para style="q1">
    <verse number="159" style="v" sid="PSA 119:159"/>Abeeti Godaw, ta ne wogaa doseysa be7a;</para>
  <para style="q2" vid="PSA 119:159">ne siiquwada tana de7on wotha.<verse eid="PSA 119:159"/></para>
  <para style="q1">
    <verse number="160" style="v" sid="PSA 119:160"/>Ne qaalay tuma;</para>
  <para style="q2" vid="PSA 119:160">ne xillo pirday merinaw de7ees.<verse eid="PSA 119:160"/></para>
  <para style="qa">Saan</para>
  <para style="q1">
    <verse number="161" style="v" sid="PSA 119:161"/>Halaqati tana coo yedethoosona;</para>
  <para style="q2" vid="PSA 119:161">shin ta wozanay ne qaala yayyees.<verse eid="PSA 119:161"/></para>
  <para style="q1">
    <verse number="162" style="v" sid="PSA 119:162"/>Darobaa di77ida asi ufayteysada,</para>
  <para style="q2" vid="PSA 119:162">ne ufaysa qaalan ta ufaytayis.<verse eid="PSA 119:162"/></para>
  <para style="q1">
    <verse number="163" style="v" sid="PSA 119:163"/>Taani wordo ixayis; shaatettayis;</para>
  <para style="q2" vid="PSA 119:163">shin ne higgiya dosayis.<verse eid="PSA 119:163"/></para>
  <para style="q1">
    <verse number="164" style="v" sid="PSA 119:164"/>Ne xillo pirdaa gisho,</para>
  <para style="q2" vid="PSA 119:164">ta nena gallas laapun toho galatayis.<verse eid="PSA 119:164"/></para>
  <para style="q1">
    <verse number="165" style="v" sid="PSA 119:165"/>Ne higgiya doseysatas polo sarotethi de7ees;</para>
  <para style="q2" vid="PSA 119:165">enta aybika dhubethanaw danda7enna.<verse eid="PSA 119:165"/></para>
  <para style="q1">
    <verse number="166" style="v" sid="PSA 119:166"/>Abeeti Godaw, ta ne atotetha ufaysan naagayis;</para>
  <para style="q2" vid="PSA 119:166">ne kiita kaallayis.<verse eid="PSA 119:166"/></para>
  <para style="q1">
    <verse number="167" style="v" sid="PSA 119:167"/>Taani ne higgiya naagayis;</para>
  <para style="q2" vid="PSA 119:167">ta kumetha wozanaape dosayis.<verse eid="PSA 119:167"/></para>
  <para style="q1">
    <verse number="168" style="v" sid="PSA 119:168"/>Ta oge ubbaa ne be7iya gisho,</para>
  <para style="q2" vid="PSA 119:168">taani ne higgiyanne ne wogaa naagana;<verse eid="PSA 119:168"/></para>
  <para style="qa">Taw</para>
  <para style="q1">
    <verse number="169" style="v" sid="PSA 119:169"/>Abeeti Godaw, ta waasoy ne sinthe gako;</para>
  <para style="q2" vid="PSA 119:169">ne ufaysa qaalada taw akeeka imma.<verse eid="PSA 119:169"/></para>
  <para style="q1">
    <verse number="170" style="v" sid="PSA 119:170"/>Ta woosay ne sinthe gako;</para>
  <para style="q2" vid="PSA 119:170">ne ufaysa qaalada tana ashsha.<verse eid="PSA 119:170"/></para>
  <para style="q1">
    <verse number="171" style="v" sid="PSA 119:171"/>Neeni ne awaajuwa tana tamaarsiya gisho,</para>
  <para style="q2" vid="PSA 119:171">ta doonape galati pultana.<verse eid="PSA 119:171"/></para>
  <para style="q1">
    <verse number="172" style="v" sid="PSA 119:172"/>Ne kiita ubbay xillo gidiya gisho,</para>
  <para style="q2" vid="PSA 119:172">ta inxarsay ne qaalaba yexana.<verse eid="PSA 119:172"/></para>
  <para style="q1">
    <verse number="173" style="v" sid="PSA 119:173"/>Taani ne wogaa doorida gisho,</para>
  <para style="q2" vid="PSA 119:173">ne kushey tana maaddanaw giigidaysa gido.<verse eid="PSA 119:173"/></para>
  <para style="q1">
    <verse number="174" style="v" sid="PSA 119:174"/>Abeeti Godaw, ne ashshana mela ta laamotayis;</para>
  <para style="q2" vid="PSA 119:174">ne higgey tana ufaysees.<verse eid="PSA 119:174"/></para>
  <para style="q1">
    <verse number="175" style="v" sid="PSA 119:175"/>Taani nena galatana mela,</para>
  <para style="q2" vid="PSA 119:175">tana de7on wotha;</para>
  <para style="q2" vid="PSA 119:175">ne pirday tana maaddo.<verse eid="PSA 119:175"/></para>
  <para style="q1">
    <verse number="176" style="v" sid="PSA 119:176"/>Taani dhayida dorsada toylatas;</para>
  <para style="q2" vid="PSA 119:176">tana ne aylliya koya;</para>
  <para style="q2" vid="PSA 119:176">ta ne kiita dogike.<verse eid="PSA 119:176"/></para>
  <chapter eid="PSA 119"/>
  <chapter number="120" style="c" sid="PSA 120"/>
  <para style="s1">Ta Xoossaw Tana Alla</para>
  <para style="d">Pudethe keyishe yexiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 120:1"/>Meto wode taani Godaa xeegin</para>
  <para style="q2" vid="PSA 120:1">I taw koyis.<verse eid="PSA 120:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 120:2"/>Godaw, wordo doonapenne</para>
  <para style="q2" vid="PSA 120:2">cimmiya inxarsafe tana ashsha.<verse eid="PSA 120:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 120:3"/>Hinteno, wordanchoto,</para>
  <para style="q2" vid="PSA 120:3">Goday hintena waatiko lo77o?</para>
  <para style="q2" vid="PSA 120:3">I hintena waatidi seeriko lo77o?<verse eid="PSA 120:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 120:4"/>I hintena leefetida ola tooran caddana;</para>
  <para style="q2" vid="PSA 120:4">xiifa bonqon hintena xuuggana.<verse eid="PSA 120:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 120:5"/>Ta Mosahan de7iya gishonne</para>
  <para style="q2" vid="PSA 120:5">Qedaare dunkaanen uttida gisho tana ayye!<verse eid="PSA 120:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 120:6"/>Sarotethi ixiya asaara</para>
  <para style="q2" vid="PSA 120:6">taani daro wode de7as.<verse eid="PSA 120:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 120:7"/>Taani saro asi;</para>
  <para style="q2" vid="PSA 120:7">shin ta sarotethaba haasaya wode,</para>
  <para style="q2" vid="PSA 120:7">enti olaba haasayoosona.<verse eid="PSA 120:7"/></para>
  <chapter eid="PSA 120"/>
  <chapter number="121" style="c" sid="PSA 121"/>
  <para style="s1">Taw Maadey Xoossafe Yees</para>
  <para style="d">Pudethe keyishe yexiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 121:1"/>Taw maadoy awupe yaane gada,</para>
  <para style="q2" vid="PSA 121:1">taani deretako xeellas.<verse eid="PSA 121:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 121:2"/>Taw maadoy</para>
  <para style="q2" vid="PSA 121:2">salonne sa7aa medhida Godaape yees.<verse eid="PSA 121:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 121:3"/>I ne tohuwa harchisenna;</para>
  <para style="q2" vid="PSA 121:3">nena naageysi dhiskenna.<verse eid="PSA 121:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 121:4"/>Isra7eele naageysi</para>
  <para style="q2" vid="PSA 121:4">zin7enanne dhiskenna.<verse eid="PSA 121:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 121:5"/>Goday nena naageysa;</para>
  <para style="q2" vid="PSA 121:5">ne ushachan gididi, new kuya gidana.<verse eid="PSA 121:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 121:6"/>Gallas awi nena meenna;</para>
  <para style="q2" vid="PSA 121:6">qamma ageeni nena qohenna.<verse eid="PSA 121:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 121:7"/>Goday qohiyaba ubbaafe nena naagana;</para>
  <para style="q2" vid="PSA 121:7">I nena saro wothana.<verse eid="PSA 121:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 121:8"/>Goday ne kessaane ne geluwa,</para>
  <para style="q2" vid="PSA 121:8">hachife merinaw naagana.<verse eid="PSA 121:8"/></para>
  <chapter eid="PSA 121"/>
  <chapter number="122" style="c" sid="PSA 122"/>
  <para style="s1">Ane Xoossa Keethi Boos</para>
  <para style="d">Dawiti pude keyishe yexiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 122:1"/>Enti tana, “Ane Xoossa keethi boos” yaagin,</para>
  <para style="q2" vid="PSA 122:1">tana ufaysis.<verse eid="PSA 122:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 122:2"/>Yerusalaame,</para>
  <para style="q2" vid="PSA 122:2">nuuni ne pengetara gelidi eqida.<verse eid="PSA 122:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 122:3"/>Yerusalaamey</para>
  <para style="q2" vid="PSA 122:3">danthetada minna keexetida lo77o katama.<verse eid="PSA 122:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 122:4"/>Godaa kiitaa maaran Isra7eele zareti,</para>
  <para style="q2" vid="PSA 122:4">Godaa galatanaw he katamaa yoosona.<verse eid="PSA 122:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 122:5"/>Dawita kochaafe kawotida ubbay,</para>
  <para style="q2" vid="PSA 122:5">banta asaas pirdanaw yan uttoosona.<verse eid="PSA 122:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 122:6"/>Yerusalaame sarotethaas haysada yaagidi woossite;</para>
  <para style="q2" vid="PSA 122:6">“Nena dosiya ubbay anjeto.<verse eid="PSA 122:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 122:7"/>Ne gimbeta giddon saroy gido;</para>
  <para style="q2" vid="PSA 122:7">ne kawo keethan wopatethi de7o” yaagite.<verse eid="PSA 122:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 122:8"/>Ta ishatanne ta dabbota gisho,</para>
  <para style="q2" vid="PSA 122:8">“Ne giddon saroy de7o” yaagana.<verse eid="PSA 122:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 122:9"/>Godaa nu Xoossaa keethaa gisho,</para>
  <para style="q2" vid="PSA 122:9">new lo77oba amottayis.<verse eid="PSA 122:9"/></para>
  <chapter eid="PSA 122"/>
  <chapter number="123" style="c" sid="PSA 123"/>
  <para style="s1">Nu Ayfey Nu Xoossa Bollana</para>
  <para style="d">Pudethe keyishe yexiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 123:1"/>Salon, ne araata bolla uttidayso,</para>
  <para style="q2" vid="PSA 123:1">taani pude neeko xeellayis.<verse eid="PSA 123:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 123:2"/>Adde aylley ba godaa kushe xeelleysada,</para>
  <para style="q2" vid="PSA 123:2">macca aylliya ba godate kushe be7eysada,</para>
  <para style="q2" vid="PSA 123:2">neeni nuna maarana gakanaw,</para>
  <para style="q2" vid="PSA 123:2">nu ayfey Godaako, nu Xoossaako xeellees.<verse eid="PSA 123:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 123:3"/>Nuus kadhey darida gisho, nuna maara;</para>
  <para style="q2" vid="PSA 123:3">abeeti Godaw, nuna maara.<verse eid="PSA 123:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 123:4"/>Nuuni otoranchota cashshaanne</para>
  <para style="q2" vid="PSA 123:4">saaphota kadhiya kallida.<verse eid="PSA 123:4"/></para>
  <chapter eid="PSA 123"/>
  <chapter number="124" style="c" sid="PSA 124"/>
  <para style="s1">Goday Nuura De7ees</para>
  <para style="d">Dawiti pude keyishe zammariya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 124:1"/>Goday nuura gidonaako, nu waananee?</para>
  <para style="q2" vid="PSA 124:1">Isra7eeley haysada yaagidi zaaro;<verse eid="PSA 124:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 124:2"/>“Goday nuura gidonnaako,</para>
  <para style="q2" vid="PSA 124:2">nu bolla asay dendida wode,<verse eid="PSA 124:2"/></para>
  <para style="q2">
    <verse number="3" style="v" sid="PSA 124:3"/>enta hanqoy nu bolla suullin,</para>
  <para style="q2" vid="PSA 124:3">nuna paxa mittanashin.<verse eid="PSA 124:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 124:4"/>Di7oy nuna efanashin;</para>
  <para style="q2" vid="PSA 124:4">shaafa haathay nuna mittanashin.<verse eid="PSA 124:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 124:5"/>Kixa haathay nuna maanashin” yaago.<verse eid="PSA 124:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 124:6"/>Nuna nu morketa achas</para>
  <para style="q2" vid="PSA 124:6">aathidi immiboona Goday galatetto.<verse eid="PSA 124:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 124:7"/>Kafoy shanka gitepe kessi ekeysada,</para>
  <para style="q2" vid="PSA 124:7">nuuni kessi ekida;</para>
  <para style="q2" vid="PSA 124:7">xihey meqis, nuuni kessi ekida.<verse eid="PSA 124:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 124:8"/>Salonne sa7aa medhida,</para>
  <para style="q2" vid="PSA 124:8">Godaa sunthan nuus maadoy yees.<verse eid="PSA 124:8"/></para>
  <chapter eid="PSA 124"/>
  <chapter number="125" style="c" sid="PSA 125"/>
  <para style="s1">Xoossay Ba Asaa Yuushona</para>
  <para style="d">Pudethe keyishe yexiya mazmure.</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 125:1"/>Godan ammaneteysati qaaxanaw danda7onna,</para>
  <para style="q2" vid="PSA 125:1">merinaw de7iya Xiyoone zuma mela.<verse eid="PSA 125:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 125:2"/>Dereti Yerusalaame yuushon de7eysada,</para>
  <para style="q2" vid="PSA 125:2">hachife merinaa gakanaw,</para>
  <para style="q2" vid="PSA 125:2">Goday ba asaa yuushon de7ees.<verse eid="PSA 125:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 125:3"/>Xilloti banta kushiya iitabas denthonna mela</para>
  <para style="q2" vid="PSA 125:3">iitata ayso xam7ay xillota biittan gam7enna.<verse eid="PSA 125:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 125:4"/>Abeeti Godaw, keeha asatasinne</para>
  <para style="q2" vid="PSA 125:4">wozana suure asatas lo77oba ootha.<verse eid="PSA 125:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 125:5"/>Shin neeni iita asata seeriya wode,</para>
  <para style="q2" vid="PSA 125:5">ne ogiya aggida asaaka seera.</para>
  <para style="p" vid="PSA 125:5">Isra7eeles saroy gido.<verse eid="PSA 125:5"/></para>
  <chapter eid="PSA 125"/>
  <chapter number="126" style="c" sid="PSA 126"/>
  <para style="s1">Xoossaw Nuna Zaarada Gashtisa</para>
  <para style="d">Pudethe keyishe yexiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 126:1"/>Goday di7ope zaaridi</para>
  <para style="q2" vid="PSA 126:1">nuna Xiyoone ehida wode</para>
  <para style="q2" vid="PSA 126:1">nuus amuho daanis.<verse eid="PSA 126:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 126:2"/>Nu doonay miichan,</para>
  <para style="q2" vid="PSA 126:2">nu inxarsay ufaysa yethan kumis.</para>
  <para style="q1" vid="PSA 126:2">He wode kawotethati banta giddon,</para>
  <para style="q2" vid="PSA 126:2">“Goday entaw gitaba oothis” yaagidosona.<verse eid="PSA 126:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 126:3"/>Tuma Goday nuus gitaba oothis;</para>
  <para style="q2" vid="PSA 126:3">nuka daro ufaytida.<verse eid="PSA 126:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 126:4"/>Godaw, Negebe mela biittan ira bukisada,</para>
  <para style="q2" vid="PSA 126:4">shaafa zaarada kuntheysada,</para>
  <para style="q2" vid="PSA 126:4">nu duussa ooratha.<verse eid="PSA 126:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 126:5"/>Yeekishe zeridaysati,</para>
  <para style="q2" vid="PSA 126:5">ufaysan yexishe cakana.<verse eid="PSA 126:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 126:6"/>Zerethi tookidi yeekishe bidaysati,</para>
  <para style="q2" vid="PSA 126:6">ufaysa yethe yexishe,</para>
  <para style="q2" vid="PSA 126:6">mirqe tookidi simmana.<verse eid="PSA 126:6"/></para>
  <chapter eid="PSA 126"/>
  <chapter number="127" style="c" sid="PSA 127"/>
  <para style="s1">Keethe Keexey Xoosse</para>
  <para style="d">Solomoney pude keyishe yexiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 127:1"/>Goday keethe keexona ixiko,</para>
  <para style="q2" vid="PSA 127:1">keexeysati coo daaburoosona.</para>
  <para style="q1" vid="PSA 127:1">Goday katamaa naagonna ixiko,</para>
  <para style="q2" vid="PSA 127:1">naageysati coo daaburoosona.<verse eid="PSA 127:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 127:2"/>Duussas koshshiyaba demmanaw,</para>
  <para style="q2" vid="PSA 127:2">wonta guura dendoy,</para>
  <para style="q2" vid="PSA 127:2">omarsi daro qamisidi geloy hada.</para>
  <para style="q1" vid="PSA 127:2">Goday ba doseysatas</para>
  <para style="q2" vid="PSA 127:2">shempo<note caller="+" style="f"><char style="fr" closed="false">127:2 </char><char style="fqa" closed="false">Shempo: </char><char style="ft" closed="false">Woyko dhisko </char></note> immees.<verse eid="PSA 127:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 127:3"/>Nayti Godaa imota;</para>
  <para style="q2" vid="PSA 127:3">yeloti tuma woyto.<verse eid="PSA 127:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 127:4"/>Issi asi na7atethan yelida adde nayti,</para>
  <para style="q2" vid="PSA 127:4">olancho kushen de7iya toora mela.<verse eid="PSA 127:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 127:5"/>Iya korojoti ha yiishshatan kumida asi anjetidaysa;</para>
  <para style="q2" vid="PSA 127:5">I ba morketara katama pengen,</para>
  <para style="q2" vid="PSA 127:5">mootetiya wode shatimmenna.<verse eid="PSA 127:5"/></para>
  <chapter eid="PSA 127"/>
  <chapter number="128" style="c" sid="PSA 128"/>
  <para style="s1">Xoosse Babiya Asi Anjetidaysa</para>
  <para style="d">Pudethe keyishe yexiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 128:1"/>Godaas yayyeysatinne iya ogiyan</para>
  <para style="q2" vid="PSA 128:1">hemeteysati ubbay anjetidaysata.<verse eid="PSA 128:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 128:2"/>Neeni ne daabura ayfe maana;</para>
  <para style="q2" vid="PSA 128:2">ufaytananne duretana.<verse eid="PSA 128:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 128:3"/>Ne machiya ne son ayfe</para>
  <para style="q2" vid="PSA 128:3">duurkukida woyne mela gidana.</para>
  <para style="q1" vid="PSA 128:3">Ne nayti ne gayta yuushon</para>
  <para style="q2" vid="PSA 128:3">shamaho aaca mela gidana.<verse eid="PSA 128:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 128:4"/>Godaas yayiya asi</para>
  <para style="q2" vid="PSA 128:4">tuma hessada anjetana.<verse eid="PSA 128:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 128:5"/>Goday nena Xiyoonepe anjo!</para>
  <para style="q2" vid="PSA 128:5">Neeni de7ida laytha ubban</para>
  <para style="q2" vid="PSA 128:5">Yerusalaame lo77otetha nena besso!<verse eid="PSA 128:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 128:6"/>Ne nayta nayta be7a!</para>
  <para style="q2" vid="PSA 128:6">Isra7eeles saroy gido!<verse eid="PSA 128:6"/></para>
  <chapter eid="PSA 128"/>
  <chapter number="129" style="c" sid="PSA 129"/>
  <para style="s1">Na7atethafe Doomidi Tana Un7ethidosona</para>
  <para style="d">Pudethe keyishe yexiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 129:1"/>Isra7eeley haysada yaago;</para>
  <para style="q1" vid="PSA 129:1">“Ta na7atethafe doomidi,</para>
  <para style="q2" vid="PSA 129:1">ta morketi tana un7ethidosona.<verse eid="PSA 129:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 129:2"/>Ee, enti ta na7atethafe doomidi,</para>
  <para style="q2" vid="PSA 129:2">tana un7ethidosona;</para>
  <para style="q2" vid="PSA 129:2">shin enti tana xoonibookona.<verse eid="PSA 129:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 129:3"/>Ta zokuwa xurqafen shocidi,</para>
  <para style="q2" vid="PSA 129:3">goshsha gade daanisidosona.”<verse eid="PSA 129:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 129:4"/>Shin Goday xillo gidiya gisho</para>
  <para style="q2" vid="PSA 129:4">iitata wodoruwa duuserethi yeggis.<verse eid="PSA 129:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 129:5"/>Xiyoone ixiya ubbay</para>
  <para style="q2" vid="PSA 129:5">yeellatidi guye simmo.<verse eid="PSA 129:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 129:6"/>Keetha huuphen dolida,</para>
  <para style="q2" vid="PSA 129:6">dicconna melida maata mela gido.<verse eid="PSA 129:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 129:7"/>He maata buucanaw kushen dankey</para>
  <para style="q2" vid="PSA 129:7">woyko mirqanaw oykey baawa.<verse eid="PSA 129:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 129:8"/>Ogera aadheysati,</para>
  <para style="q2" vid="PSA 129:8">“Goday wolqa immo” gin,</para>
  <para style="q2" vid="PSA 129:8">cakeysati “Godi anjo” giyabay deenna.<verse eid="PSA 129:8"/></para>
  <chapter eid="PSA 129"/>
  <chapter number="130" style="c" sid="PSA 130"/>
  <para style="s1">Ta Shempiya Nena Naagawusu</para>
  <para style="d">Pudethe keyishe yexiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 130:1"/>Godaw, taani meto ciimmon de7ashe,</para>
  <para style="q2" vid="PSA 130:1">neeko waassayis.<verse eid="PSA 130:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 130:2"/>Godaw, ta waasuwa si7a;</para>
  <para style="q2" vid="PSA 130:2">ta woosa ne haythay hayzo.<verse eid="PSA 130:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 130:3"/>Xoossaw, nu nagaraa ne xaafa oykidaako,</para>
  <para style="q2" vid="PSA 130:3">Godaw, ooni pirdafe attanaw danda7ii?<verse eid="PSA 130:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 130:4"/>Shin nuuni new yayyana mela,</para>
  <para style="q2" vid="PSA 130:4">nu nagaraa atto yaagasa.<verse eid="PSA 130:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 130:5"/>Taani Godaa laamotan naagayis;</para>
  <para style="q2" vid="PSA 130:5">ta shempiya laamotan naagawusu;</para>
  <para style="q2" vid="PSA 130:5">taani iya qaalan ufaysi wothayis.<verse eid="PSA 130:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 130:6"/>Sa7i awude wontane gidi,</para>
  <para style="q2" vid="PSA 130:6">naagiya wotaadarepe aathada,</para>
  <para style="q2" vid="PSA 130:6">taani Godaa laamotan naagayis.<verse eid="PSA 130:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 130:7"/>Iya siiqoy merinaasa gidiya gishonne</para>
  <para style="q2" vid="PSA 130:7">iyan kumetha atotethi de7iya gisho</para>
  <para style="q2" vid="PSA 130:7">Isra7eele, Godan ufaysi ootha;<verse eid="PSA 130:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 130:8"/>Goday Isra7eele,</para>
  <para style="q2" vid="PSA 130:8">iya nagaraa ubbaafe ashshana.<verse eid="PSA 130:8"/></para>
  <chapter eid="PSA 130"/>
  <chapter number="131" style="c" sid="PSA 131"/>
  <para style="s1">Xoossan Ammaneta</para>
  <para style="d">Pudethe keyishe Dawiti yexiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 131:1"/>Godaw, ta wozanay otortenna;</para>
  <para style="q2" vid="PSA 131:1">ta ayfeyka otoron xeellenna.</para>
  <para style="q1" vid="PSA 131:1">Ta qofan gitatana gada koyabike;</para>
  <para style="q2" vid="PSA 131:1">gahetonnaba ekana gada zaaturabike.<verse eid="PSA 131:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 131:2"/>Dhanthi duuxida na7i</para>
  <para style="q2" vid="PSA 131:2">ba aaye ki7on si77i geysada ta si77i gas.</para>
  <para style="q1" vid="PSA 131:2">Wayetho agida na7ada,</para>
  <para style="q2" vid="PSA 131:2">ta shempoy ta gaathan wopu gis.<verse eid="PSA 131:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 131:3"/>Isra7eele, hachife merinaa gakanaw</para>
  <para style="q2" vid="PSA 131:3">Godan ufaysi ootha.<verse eid="PSA 131:3"/></para>
  <chapter eid="PSA 131"/>
  <chapter number="132" style="c" sid="PSA 132"/>
  <para style="s1">Xoossay Xiyoone Dooris</para>
  <para style="d">Pudethe keyishe yexiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 132:1"/>Godaw, Dawitanne</para>
  <para style="q2" vid="PSA 132:1">I danda7ida metuwa ubbaa qopa.<verse eid="PSA 132:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 132:2"/>Godaas I caaqidaysa,</para>
  <para style="q2" vid="PSA 132:2">wolqaama gidida Yayqooba Xoossaas,</para>
  <para style="q2" vid="PSA 132:2">I odidaysa hassaya.<verse eid="PSA 132:2"/></para>
  <para style="q1">
    <verse number="3-5" style="v" sid="PSA 132:3-5"/>Godaas besse giigisana gakanaw,</para>
  <para style="q2" vid="PSA 132:3-5">Wolqaama gidida Yayqooba Xoossaas,</para>
  <para style="q2" vid="PSA 132:3-5">keethe keexana gakanaw,</para>
  <para style="q2" vid="PSA 132:3-5">ta soo gelike;</para>
  <para style="q2" vid="PSA 132:3-5">ta hiixan zin7ike.</para>
  <para style="q1" vid="PSA 132:3-5">Ta ayfey qilim7enna,</para>
  <para style="q2" vid="PSA 132:3-5">woyko tana dhiskoy ekenna.<verse eid="PSA 132:3-5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 132:6"/>Nuuni Taabotiyabaa</para>
  <para style="q2" vid="PSA 132:6">Efraatan si7ida;</para>
  <para style="q2" vid="PSA 132:6">Yi7aarime biittan iya demmida.<verse eid="PSA 132:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 132:7"/>“Ane I de7iya bessaa boos;</para>
  <para style="q2" vid="PSA 132:7">iya tohoy yedhiya bessan</para>
  <para style="q2" vid="PSA 132:7">iya goyinnoos.”<verse eid="PSA 132:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 132:8"/>Godaw, denda!</para>
  <para style="q2" vid="PSA 132:8">Ne minotethaa malla gidida</para>
  <para style="q2" vid="PSA 132:8">ne Taabotiyara ne keethaa gela.<verse eid="PSA 132:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 132:9"/>Ne kahineti xillotethi ma7o;</para>
  <para style="q2" vid="PSA 132:9">ne asay ufaysan yexo.<verse eid="PSA 132:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 132:10"/>Ne aylliya Dawita gisho,</para>
  <para style="q2" vid="PSA 132:10">neeni tiyida kawa aggofa.<verse eid="PSA 132:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 132:11"/>Goday Dawitas laametonna caaqo</para>
  <para style="q2" vid="PSA 132:11">haysada yaagidi caaqis;</para>
  <para style="q1" vid="PSA 132:11">“Ne gulbatape keyida,</para>
  <para style="q2" vid="PSA 132:11">ne naytape issuwa ne araatan utisana.<verse eid="PSA 132:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 132:12"/>Ne nayti ta caaquwanne</para>
  <para style="q2" vid="PSA 132:12">ta tamaarsiya timirtiya naagiko,</para>
  <para style="q2" vid="PSA 132:12">enta nayti ne araatan merinaw uttana” yaagis.<verse eid="PSA 132:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 132:13"/>Goday Xiyoone dooris;</para>
  <para style="q2" vid="PSA 132:13">baw de7iya bessi oothanaw amotidi,</para>
  <para style="q2" vid="PSA 132:13">haysada yaagis;<verse eid="PSA 132:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 132:14"/>“Haysi ta merinaw de7iya besse;</para>
  <para style="q2" vid="PSA 132:14">taani amotida gisho haysan daana.<verse eid="PSA 132:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 132:15"/>Taani daro kathi immada Xiyoone anjana;</para>
  <para style="q2" vid="PSA 132:15">iyan de7iya manqotaka kathi kalsana.<verse eid="PSA 132:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 132:16"/>Iyan de7iya kahineta atotethi mayzana;</para>
  <para style="q2" vid="PSA 132:16">iyan de7iya xilloti ufaysan yexana.<verse eid="PSA 132:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 132:17"/>He bessan Dawita zeriyape kawo kessana;</para>
  <para style="q2" vid="PSA 132:17">taani tiyida kawa kawotethan gam7isana.<verse eid="PSA 132:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 132:18"/>Taani iya morketa yeella mayzana;</para>
  <para style="q2" vid="PSA 132:18">shin iya huuphen de7iya kallachay phoolana” yaagas.<verse eid="PSA 132:18"/></para>
  <chapter eid="PSA 132"/>
  <chapter number="133" style="c" sid="PSA 133"/>
  <para style="s1">Issifetetha Go77a</para>
  <para style="d">Dawiti pudethe keyishe yexiya mazmure</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 133:1"/>Ishati issifethan de7eysi,</para>
  <para style="q2" vid="PSA 133:1">waani lo77i waani ufaysi!<verse eid="PSA 133:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 133:2"/>Hessi huuphen tigin, buuchaara goggiya,</para>
  <para style="q2" vid="PSA 133:2">Aarona buuchaara goggidi</para>
  <para style="q2" vid="PSA 133:2">iya hashiya gakiya al7o zayte mela.<verse eid="PSA 133:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 133:3"/>Hessi Armoona zumaape</para>
  <para style="q2" vid="PSA 133:3">Xiyoone Dereta gakanaw</para>
  <para style="q2" vid="PSA 133:3">wodhiya aka mela.</para>
  <para style="q1" vid="PSA 133:3">Goday yan anjuwanne,</para>
  <para style="q2" vid="PSA 133:3">de7uwa merinaw immis.<verse eid="PSA 133:3"/></para>
  <chapter eid="PSA 133"/>
  <chapter number="134" style="c" sid="PSA 134"/>
  <para style="s1">Haa Yiite Godaa Anjite</para>
  <para style="d">Pudethe keyishe yexiya mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 134:1"/>Hinteno, Godaa aylleto,</para>
  <para style="q2" vid="PSA 134:1">Godaa keethan qamma ootheysato,</para>
  <para style="q2" vid="PSA 134:1">ubbay yidi Godaa galatite.<verse eid="PSA 134:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 134:2"/>Xoossa keethan</para>
  <para style="q2" vid="PSA 134:2">hinte kushiya miccidi,</para>
  <para style="q2" vid="PSA 134:2">Godaa galatite.<verse eid="PSA 134:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 134:3"/>Saluwanne sa7aa medhida Goday</para>
  <para style="q2" vid="PSA 134:3">hintena Xiyoonepe anjo.<verse eid="PSA 134:3"/></para>
  <chapter eid="PSA 134"/>
  <chapter number="135" style="c" sid="PSA 135"/>
  <para style="s1">Xoossa Sunthay Merinaw Eretees</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 135:1"/>Godaa galatite!</para>
  <para style="q1" vid="PSA 135:1">Hinteno, Godaa aylleto,</para>
  <para style="q2" vid="PSA 135:1">Godaa sunthaa galatite!<verse eid="PSA 135:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 135:2"/>Hinteno, Godaa keethan,</para>
  <para style="q2" vid="PSA 135:2">nu Xoossa keethaa dabaaban eqeysato,</para>
  <para style="q2" vid="PSA 135:2">Godaa galatite!<verse eid="PSA 135:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 135:3"/>I keeha gidiya gisho Godaa galatite!</para>
  <para style="q2" vid="PSA 135:3">I lo77o gidiya gisho iya sunthaa sabbite!<verse eid="PSA 135:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 135:4"/>Goday Yayqooba babaa,</para>
  <para style="q2" vid="PSA 135:4">Isra7eele baw buzo oothidi dooris.<verse eid="PSA 135:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 135:5"/>Goday gita gideysanne</para>
  <para style="q2" vid="PSA 135:5">nu Goday, xoossata ubbaafe aadheysa</para>
  <para style="q2" vid="PSA 135:5">taani erayis.<verse eid="PSA 135:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 135:6"/>Salon sa7an, abbaninne iya giddon</para>
  <para style="q2" vid="PSA 135:6">Goday ba dosidaba ubbaa oothees.<verse eid="PSA 135:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 135:7"/>Shaara sa7aa gaxape denthees;</para>
  <para style="q2" vid="PSA 135:7">wol7anthi irara kiittees;</para>
  <para style="q2" vid="PSA 135:7">carko ba minja keethaafe kessees.<verse eid="PSA 135:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 135:8"/>Gibxe biittan asape mehe gakanaw,</para>
  <para style="q2" vid="PSA 135:8">bayra yeletida ubbaa wodhis.<verse eid="PSA 135:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 135:9"/>Neno Gibxe,</para>
  <para style="q2" vid="PSA 135:9">Paaronanne iya aylleta ubbaa seeranaw</para>
  <para style="q2" vid="PSA 135:9">malaatatanne malaalsiyabata kiittis.<verse eid="PSA 135:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 135:10"/>I daro kawotethata dhaysis;</para>
  <para style="q2" vid="PSA 135:10">wolqaama kawota wodhis.<verse eid="PSA 135:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 135:11"/>Amoore kawa Sihoona</para>
  <para style="q2" vid="PSA 135:11">Baasane kawa Oogenne</para>
  <para style="q2" vid="PSA 135:11">Kanaane kawota ubbaa wodhis.<verse eid="PSA 135:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 135:12"/>Enta biitta ba asaa,</para>
  <para style="q2" vid="PSA 135:12">Isra7eele laatisis.<verse eid="PSA 135:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 135:13"/>Godaw, ne sunthay merinaw daana;</para>
  <para style="q2" vid="PSA 135:13">yeletaape yeleta gakanaw ne hassayetana.<verse eid="PSA 135:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 135:14"/>Goday ba asaas pirdana;</para>
  <para style="q2" vid="PSA 135:14">I ba aylletas qadhetana.<verse eid="PSA 135:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 135:15"/>Kawotethata eeqati asa kushe oosota;</para>
  <para style="q2" vid="PSA 135:15">birapenne worqafe medhetidaysata.<verse eid="PSA 135:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 135:16"/>Entaw dooni de7ees, shin haasayokona;</para>
  <para style="q2" vid="PSA 135:16">ayfey de7ees, shin xeellokona.<verse eid="PSA 135:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 135:17"/>Haythi de7ees, shin si7okona;</para>
  <para style="q2" vid="PSA 135:17">enta siidhen shempoy baawa.<verse eid="PSA 135:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 135:18"/>Enta medhidaysatinne</para>
  <para style="q2" vid="PSA 135:18">entan ammaneteysati</para>
  <para style="q2" vid="PSA 135:18">ubbay entada hano.<verse eid="PSA 135:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 135:19"/>Isra7eele asaw Godaa galatite;</para>
  <para style="q2" vid="PSA 135:19">Aarona soo asaw Godaa galatite.<verse eid="PSA 135:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 135:20"/>Leewe soo asaw Godaa galatite;</para>
  <para style="q2" vid="PSA 135:20">Godaa yayyeysato ubbay Godaa galatite.<verse eid="PSA 135:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 135:21"/>Yerusalaamen de7iya Goday</para>
  <para style="q2" vid="PSA 135:21">Xiyoonen galatetto!</para>
  <para style="q2" vid="PSA 135:21">Godaa galatite!<verse eid="PSA 135:21"/></para>
  <chapter eid="PSA 135"/>
  <chapter number="136" style="c" sid="PSA 136"/>
  <para style="s1">Iya Maarotethay Merinaasa</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 136:1"/>Godaa galatite!</para>
  <para style="qr" vid="PSA 136:1">I keeha; iya siiqoy merinaasa.<verse eid="PSA 136:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 136:2"/>Xoossata Xoossaa galatite!</para>
  <para style="qr" vid="PSA 136:2">Iya siiqoy merinaasa.<verse eid="PSA 136:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 136:3"/>Godata Godaa galatite!</para>
  <para style="qr" vid="PSA 136:3">Iya siiqoy merinaasa.<verse eid="PSA 136:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 136:4"/>Iya xalaali gita malaalsiyaba oothees;</para>
  <para style="qr" vid="PSA 136:4">iya siiqoy merinaasa.<verse eid="PSA 136:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 136:5"/>Ba cincatethan salota medhis;</para>
  <para style="qr" vid="PSA 136:5">iya siiqoy merinaasa.<verse eid="PSA 136:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 136:6"/>Haatha bolla biitta miccis;</para>
  <para style="qr" vid="PSA 136:6">iya siiqoy merinaasa.<verse eid="PSA 136:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 136:7"/>Gita poo7ota medhis;</para>
  <para style="q2" vid="PSA 136:7">iya siiqoy merinaasa.<verse eid="PSA 136:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 136:8"/>Awi gallas haarana mela oothis;</para>
  <para style="qr" vid="PSA 136:8">iya siiqoy merinaasa.<verse eid="PSA 136:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 136:9"/>Ageeninne xoolintoti</para>
  <para style="q2" vid="PSA 136:9">qamma haarana mela oothis;</para>
  <para style="qr" vid="PSA 136:9">iya siiqoy merinaasa.<verse eid="PSA 136:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 136:10"/>Gibxe biittan bayrata wodhis;</para>
  <para style="qr" vid="PSA 136:10">iya siiqoy merinaasa.<verse eid="PSA 136:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 136:11"/>Isra7eele asaa Gibxefe kaalethidi kessis;</para>
  <para style="qr" vid="PSA 136:11">iya siiqoy merinaasa.<verse eid="PSA 136:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 136:12"/>Ba mino kushiyan,</para>
  <para style="q2" vid="PSA 136:12">ba wolqaama qesiyan haysa oothis;</para>
  <para style="qr" vid="PSA 136:12">iya siiqoy merinaasa.<verse eid="PSA 136:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 136:13"/>Zo7o Abbaa shaakis;</para>
  <para style="qr" vid="PSA 136:13">iya siiqoy merinaasa.<verse eid="PSA 136:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 136:14"/>Isra7eele asaa he abba giddora pinthis;</para>
  <para style="qr" vid="PSA 136:14">iya siiqoy merinaasa.<verse eid="PSA 136:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 136:15"/>Gibxe kawanne iya olanchota</para>
  <para style="q2" vid="PSA 136:15">Zo7o Abban muukisis;</para>
  <para style="qr" vid="PSA 136:15">iya siiqoy merinaasa.<verse eid="PSA 136:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 136:16"/>I ba asaa mela biittara kaalethis;</para>
  <para style="qr" vid="PSA 136:16">iya siiqoy merinaasa.<verse eid="PSA 136:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 136:17"/>Gita kawota shocis;</para>
  <para style="qr" vid="PSA 136:17">iya siiqoy merinaasa.<verse eid="PSA 136:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 136:18"/>Wolqaama kawota wodhis;</para>
  <para style="qr" vid="PSA 136:18">iya siiqoy merinaasa.<verse eid="PSA 136:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 136:19"/>Amoore kawa Sihoona wodhis;</para>
  <para style="qr" vid="PSA 136:19">iya siiqoy merinaasa.<verse eid="PSA 136:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 136:20"/>Baasane kawa Ooge wodhis;</para>
  <para style="qr" vid="PSA 136:20">iya siiqoy merinaasa.<verse eid="PSA 136:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 136:21"/>Enta biitta ba asaa laatisis;</para>
  <para style="qr" vid="PSA 136:21">iya siiqoy merinaasa.<verse eid="PSA 136:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 136:22"/>Ba aylliya Isra7eele laatisis;</para>
  <para style="qr" vid="PSA 136:22">iya siiqoy merinaasa.<verse eid="PSA 136:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 136:23"/>Nu kawuyida wode nuna qopis;</para>
  <para style="qr" vid="PSA 136:23">iya siiqoy merinaasa.<verse eid="PSA 136:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 136:24"/>Nuna nu morketape ashshis;</para>
  <para style="qr" vid="PSA 136:24">iya siiqoy merinaasa.<verse eid="PSA 136:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="PSA 136:25"/>Medhetetha ubbaas kathi immees;</para>
  <para style="qr" vid="PSA 136:25">iya siiqoy merinaasa.<verse eid="PSA 136:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="PSA 136:26"/>Salo Xoossaa galatite!</para>
  <para style="qr" vid="PSA 136:26">iya siiqoy merinaasa.<verse eid="PSA 136:26"/></para>
  <chapter eid="PSA 136"/>
  <chapter number="137" style="c" sid="PSA 137"/>
  <para style="s1">Aylletethan De7iya Asaa Yeeho</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 137:1"/>Babiloone shaafata matan uttidi,</para>
  <para style="q2" vid="PSA 137:1">Xiyoone qopida wode yeekida.<verse eid="PSA 137:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 137:2"/>He bessan nuuni</para>
  <para style="q2" vid="PSA 137:2">nu diithaa haatha gaxan dicciya,</para>
  <para style="q2" vid="PSA 137:2">mithata bolla kaqida.<verse eid="PSA 137:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 137:3"/>Nuna di77ida asati nuuni yexidi,</para>
  <para style="q2" vid="PSA 137:3">enta ufaysana mela</para>
  <para style="q2" vid="PSA 137:3">“Xiyoone yethatape issuwa ane nuus yexite” yaagidosona.<verse eid="PSA 137:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 137:4"/>Godaa yethaa nuuni allaga biittan</para>
  <para style="q2" vid="PSA 137:4">waati yexanee?<verse eid="PSA 137:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 137:5"/>Yerusalaame taani nena dogiko,</para>
  <para style="q2" vid="PSA 137:5">ta ushacha kushey tana balo.<verse eid="PSA 137:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 137:6"/>Taani nena hassayonna aggiko,</para>
  <para style="q2" vid="PSA 137:6">ta gita ufaysi gidida Yerusalaame dosonna ixiko,</para>
  <para style="q2" vid="PSA 137:6">ta inxarsay kottonuwara oyketo.<verse eid="PSA 137:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 137:7"/>Godaw, Yerusalaame di7etiya gallas</para>
  <para style="q2" vid="PSA 137:7">Edoome asay oothidaysa hassaya;</para>
  <para style="q1" vid="PSA 137:7">Enti, “Laallite! Laallite!</para>
  <para style="q2" vid="PSA 137:7">Hirki xaphuwa gakanaw laallite!”</para>
  <para style="m" vid="PSA 137:7">yaagidaysa dogopa.<verse eid="PSA 137:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 137:8"/>Babiloone, neeni dhayana!</para>
  <para style="q2" vid="PSA 137:8">Neeni nu bolla oothida iita oosuwas</para>
  <para style="q2" vid="PSA 137:8">halo kesseysi anjetidaysa.<verse eid="PSA 137:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 137:9"/>Ne guutha nayta oykidi,</para>
  <para style="q2" vid="PSA 137:9">zaalla bolla shoceysi anjetidaysa.<verse eid="PSA 137:9"/></para>
  <chapter eid="PSA 137"/>
  <chapter number="138" style="c" sid="PSA 138"/>
  <para style="s1">Xoossa Galatite</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 138:1"/>Godaw, ta kumetha wozanan nena galatana;</para>
  <para style="q2" vid="PSA 138:1">xoossata sinthan nena sabbana.<verse eid="PSA 138:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 138:2"/>Ne geeshsha keethaako simmada nena goyinnana;</para>
  <para style="q2" vid="PSA 138:2">ne siiquwa gishonne ne tumatethaa gisho galatana.</para>
  <para style="q1" vid="PSA 138:2">Ne sunthaa gishonne</para>
  <para style="q2" vid="PSA 138:2">ne qaala dhoqatethaa gisho galatana.<verse eid="PSA 138:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 138:3"/>Taani xeegida wode ne taw koyadasa;</para>
  <para style="q2" vid="PSA 138:3">ne minotethan tana minthadasa.<verse eid="PSA 138:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 138:4"/>Godaw, ne doonape keyiya qaala si7iya wode,</para>
  <para style="q2" vid="PSA 138:4">sa7an de7iya kawoti ubbay nena galato.<verse eid="PSA 138:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 138:5"/>Godaa bonchoy gita gidiya gisho,</para>
  <para style="q2" vid="PSA 138:5">enti Godaa ogiyaba yexo.<verse eid="PSA 138:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 138:6"/>Goday bolla dhoqan de7ikoka,</para>
  <para style="q2" vid="PSA 138:6">manqota keeha ayfen xeellees;</para>
  <para style="q2" vid="PSA 138:6">shin otoranchota haahon erees.<verse eid="PSA 138:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 138:7"/>Taani meto giddora hemetikoka,</para>
  <para style="q2" vid="PSA 138:7">neeni tana naagasa.</para>
  <para style="q1" vid="PSA 138:7">Ta morketa hanquwa bolla ne kushiya miccaasa;</para>
  <para style="q2" vid="PSA 138:7">ne ushacha kushiyan tana ashshaasa.<verse eid="PSA 138:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 138:8"/>Goday taw gelida qaala polana;</para>
  <para style="q2" vid="PSA 138:8">Godaw, ne siiqoy merinaasa;</para>
  <para style="q2" vid="PSA 138:8">Ne kushe oosuwa yegga aggofa.<verse eid="PSA 138:8"/></para>
  <chapter eid="PSA 138"/>
  <chapter number="139" style="c" sid="PSA 139"/>
  <para style="s1">Ta Wozana Pilgada Be7a</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 139:1"/>Godaw, neeni tana pilgada eradasa.<verse eid="PSA 139:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 139:2"/>Neeni ta utethaanne ta equwa eraasa;</para>
  <para style="q2" vid="PSA 139:2">ta qofa ubbaa haahon akeekasa.<verse eid="PSA 139:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 139:3"/>Taani biya bessaanne shempiya bessaa xomoosasa;</para>
  <para style="q2" vid="PSA 139:3">ta ogeta ubbaa eraasa.<verse eid="PSA 139:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 139:4"/>Godaw, taani ta inxarsan</para>
  <para style="q2" vid="PSA 139:4">issi qaala odetanaape sinthe,</para>
  <para style="q2" vid="PSA 139:4">ta qofa ubbaa eraasa.<verse eid="PSA 139:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 139:5"/>Neeni ta yuushuwan de7aasa;</para>
  <para style="q2" vid="PSA 139:5">ne kushiya ta bolla wothaasa.<verse eid="PSA 139:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 139:6"/>Ne eratethay tana daro malaalsees;</para>
  <para style="q2" vid="PSA 139:6">ta akeekape dhoqa.<verse eid="PSA 139:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 139:7"/>Ta ne Ayyaanape aw baqatanee?</para>
  <para style="q2" vid="PSA 139:7">ne sinthafe aw baanee?<verse eid="PSA 139:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 139:8"/>Pude salo keyiko ne yan de7aasa!</para>
  <para style="q2" vid="PSA 139:8">Duge Si7oole wodhikoka ne yan de7aasa.<verse eid="PSA 139:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 139:9"/>Doloha bagga paallada biiko,</para>
  <para style="q2" vid="PSA 139:9">woyko wuloha baggan haakada de7iko,<verse eid="PSA 139:9"/></para>
  <para style="q2">
    <verse number="10" style="v" sid="PSA 139:10"/>yan ne kushey tana kaalethees;</para>
  <para style="q2" vid="PSA 139:10">ne ushacha kushey tana zempisees.<verse eid="PSA 139:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 139:11"/>“Dhumaw tana gentha;</para>
  <para style="q2" vid="PSA 139:11">gallasaw qamma laameta” yaagiyakoka,<verse eid="PSA 139:11"/></para>
  <para style="q2">
    <verse number="12" style="v" sid="PSA 139:12"/>sakana dhumi new dhumenna;</para>
  <para style="q2" vid="PSA 139:12">qammi gallasada poo7ees;</para>
  <para style="q2" vid="PSA 139:12">new dhumi poo7o mela.<verse eid="PSA 139:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 139:13"/>Neeni ta giddo asatethaa medhadasa;</para>
  <para style="q2" vid="PSA 139:13">ta aaye ulon tana neeni tiladasa.<verse eid="PSA 139:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 139:14"/>Neeni tana malaalsiyabanne</para>
  <para style="q2" vid="PSA 139:14">yegelsi oothada medhida gisho,</para>
  <para style="q2" vid="PSA 139:14">taani nena galatayis.</para>
  <para style="q1" vid="PSA 139:14">Ne oosoti malaalsees!</para>
  <para style="q2" vid="PSA 139:14">taani hessa loythada erayis.<verse eid="PSA 139:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 139:15"/>Taani geema bessan medhetiya wode,</para>
  <para style="q2" vid="PSA 139:15">ta meqethay neepe geemmibeenna.</para>
  <para style="q1" vid="PSA 139:15">Ta asatethay ta aaye ulon ciimmo giddon</para>
  <para style="q2" vid="PSA 139:15">hiillan alleeqetidi oosetiya wode,<verse eid="PSA 139:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="PSA 139:16"/>ne ayfeti giigonna ta asatethaa be7idosona.</para>
  <para style="q2" vid="PSA 139:16">Buroo issoyka doometonna de7ishin,</para>
  <para style="q2" vid="PSA 139:16">ne taw buzoyida gallasa ubbay</para>
  <para style="q2" vid="PSA 139:16">ne mazgaben xaafetidosona.<verse eid="PSA 139:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 139:17"/>Xoossaw, ne taw qopiya qofay</para>
  <para style="q2" vid="PSA 139:17">waanida boncho!</para>
  <para style="q2" vid="PSA 139:17">Enta tayboy waanidi daride!<verse eid="PSA 139:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 139:18"/>Taani enta taybiyako shafepe daro;</para>
  <para style="q2" vid="PSA 139:18">taani barkiya wode ha77ika neera de7as.<verse eid="PSA 139:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 139:19"/>Xoossaw, neeni iitata wodhiyako aybe!</para>
  <para style="q2" vid="PSA 139:19">Suuthu gussiya asati taape haako!<verse eid="PSA 139:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 139:20"/>Enti ne bolla iitabaa haasayoosona;</para>
  <para style="q2" vid="PSA 139:20">ne morketi ne suntha iissoosona.<verse eid="PSA 139:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 139:21"/>Godaw, nena ixeyisata ta ixikina?</para>
  <para style="q2" vid="PSA 139:21">Ne bolla dendeyisata ta shaatetikina?<verse eid="PSA 139:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="PSA 139:22"/>Taani enta kumethi ixayis;</para>
  <para style="q2" vid="PSA 139:22">enta taani ta morkeda taybayis.<verse eid="PSA 139:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="PSA 139:23"/>Xoossaw, tana pilgada ta wozanaa era;</para>
  <para style="q2" vid="PSA 139:23">tana un7ethida ta qofaa be7a.<verse eid="PSA 139:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="PSA 139:24"/>Tanan iitabay de7iko xeella;</para>
  <para style="q2" vid="PSA 139:24">merina ogiyan tana kaaletha.<verse eid="PSA 139:24"/></para>
  <chapter eid="PSA 139"/>
  <chapter number="140" style="c" sid="PSA 140"/>
  <para style="s1">Iita Asa Kushepe Tana Ashsha</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 140:1"/>Godaw, iitatape tana ashsha;</para>
  <para style="q2" vid="PSA 140:1">makallanchotape tana naaga.<verse eid="PSA 140:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 140:2"/>Enti iita oothanaw maqetoosona;</para>
  <para style="q2" vid="PSA 140:2">gallas gallas ola denthoosona.<verse eid="PSA 140:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 140:3"/>Banta inxarsaa shoosha inxarsada qarayoosona;</para>
  <para style="q2" vid="PSA 140:3">enta doonan wodhiya marzey de7ees. <char style="qs">Salaha </char><verse eid="PSA 140:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 140:4"/>Godaw, iitata kushepe tana ashsha;</para>
  <para style="q2" vid="PSA 140:4">ta tohuwa qaxanaw qopiya</para>
  <para style="q2" vid="PSA 140:4">makallanchotape tana naaga.<verse eid="PSA 140:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 140:5"/>Otorancho asati taw xihe wothoosona;</para>
  <para style="q2" vid="PSA 140:5">gite hiixoosona;</para>
  <para style="q2" vid="PSA 140:5">tana oykanaw gite yeggoosona. <char style="qs">Salaha </char><verse eid="PSA 140:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 140:6"/>Godaa, “Neeni ta Xoossaa” gaana;</para>
  <para style="q2" vid="PSA 140:6">Godaw, ta woosa si7a.<verse eid="PSA 140:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 140:7"/>Ubbaa Haariya Godaw,</para>
  <para style="q2" vid="PSA 140:7">tana ashshiya minuwaw,</para>
  <para style="q2" vid="PSA 140:7">ola gallas taw gondalle gidadasa.<verse eid="PSA 140:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 140:8"/>Godaw, iitatas enta amuwa immofa;</para>
  <para style="q2" vid="PSA 140:8">enti otortonna mela enta maquwa polisopa. <char style="qs">Salaha </char><verse eid="PSA 140:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 140:9"/>Ta morketan tana xoonisopa;</para>
  <para style="q2" vid="PSA 140:9">enta doonape keyiya iitay</para>
  <para style="q2" vid="PSA 140:9">enta bolla simmo.<verse eid="PSA 140:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 140:10"/>Enta bolla xuuggiya tama bonqoy qoletto;</para>
  <para style="q2" vid="PSA 140:10">enti tama ollan yegeto;</para>
  <para style="q2" vid="PSA 140:10">keyanaw danda7onna olla holeto.<verse eid="PSA 140:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 140:11"/>Yooyamati biitta bolla de7opo;</para>
  <para style="q2" vid="PSA 140:11">buqeyisata iitabay yedethidi oyko.<verse eid="PSA 140:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 140:12"/>Goday manqotas pirdeysanne</para>
  <para style="q2" vid="PSA 140:12">metootanchotas mooteteysa erayis.<verse eid="PSA 140:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 140:13"/>Xilloti tuma ne sunthaa galatana;</para>
  <para style="q2" vid="PSA 140:13">suure asati ne sinthan daana.<verse eid="PSA 140:13"/></para>
  <chapter eid="PSA 140"/>
  <chapter number="141" style="c" sid="PSA 141"/>
  <para style="s1">Ne Haytha Taako Zaara</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 141:1"/>Godaw, taani nena xeegayis;</para>
  <para style="q2" vid="PSA 141:1">tana maaddanaw ellesa;</para>
  <para style="q2" vid="PSA 141:1">Ta neeko waassiya wode tana si7a!<verse eid="PSA 141:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 141:2"/>Ta woosay ixaaneda ne sinthe shiiqo;</para>
  <para style="q2" vid="PSA 141:2">ta kushe micethay omarsa yarsho mela gido.<verse eid="PSA 141:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 141:3"/>Godaw, ta doona naagiya asi wotha;</para>
  <para style="q2" vid="PSA 141:3">ta mettersha pengiya naaga.<verse eid="PSA 141:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 141:4"/>Iita oothiya asatara iita oothonna mela,</para>
  <para style="q2" vid="PSA 141:4">ta wozanaa iitako zaaropa;</para>
  <para style="q2" vid="PSA 141:4">enta gibira tana muzopa.<verse eid="PSA 141:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 141:5"/>Xillo asi tana seero, hessi taw keehatethi,</para>
  <para style="q2" vid="PSA 141:5">I tana hanqeto, hessi ta huuphen zayte tiyo mela.</para>
  <para style="q1" vid="PSA 141:5">Ta wozanay hessa ixenna;</para>
  <para style="q2" vid="PSA 141:5">Ta woosay ubba wode enta iita oosuwa bollana.<verse eid="PSA 141:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 141:6"/>Enta daynnati aafo holetiya wode,</para>
  <para style="q2" vid="PSA 141:6">ta qaalay tuma gideysa enti erana.<verse eid="PSA 141:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 141:7"/>Enti, “Asi biitta goyeysadanne phasha laalleysada,</para>
  <para style="q2" vid="PSA 141:7">nu meqethay duufo doonan laaletana” yaagosona.<verse eid="PSA 141:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 141:8"/>Ubbaa Haariya Godaw,</para>
  <para style="q2" vid="PSA 141:8">ta ayfey nena xeellees.</para>
  <para style="q1" vid="PSA 141:8">Taani neeko baqatayis;</para>
  <para style="q2" vid="PSA 141:8">tana hayqos aathada immofa.<verse eid="PSA 141:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 141:9"/>Enti taw yeggida gitiyapenne</para>
  <para style="q2" vid="PSA 141:9">iitaa ootheyisata xihiyape tana naaga.<verse eid="PSA 141:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 141:10"/>Taani saro aadhin,</para>
  <para style="q2" vid="PSA 141:10">iitati banta wothida gitiyan oyketo.<verse eid="PSA 141:10"/></para>
  <chapter eid="PSA 141"/>
  <chapter number="142" style="c" sid="PSA 142"/>
  <para style="s1">Neeni Taw Qosetiya Bessi</para>
  <para style="d">Dawiti gongolon de7iya wode xaafida timirte</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 142:1"/>Ta qaala dhoqu oothada Godaako waassayis;</para>
  <para style="q2" vid="PSA 142:1">maarota demmanaw iya woossayis.<verse eid="PSA 142:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 142:2"/>Ta oysha ubbaa iya bessayis;</para>
  <para style="q2" vid="PSA 142:2">ta metuwa ubbaa iyaw odayis.<verse eid="PSA 142:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 142:3"/>Taani heettida wode ne ta ogiya eraasa;</para>
  <para style="q2" vid="PSA 142:3">ta ogiyan gite yeggidi wothidosona.<verse eid="PSA 142:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 142:4"/>Taani ta yuushuwa xeelliya wode,</para>
  <para style="q2" vid="PSA 142:4">tana maaddey issoyka baawa.</para>
  <para style="q2" vid="PSA 142:4">Taani qosetada attiya bessi baawa;</para>
  <para style="q2" vid="PSA 142:4">tana naagiya oonika baawa.<verse eid="PSA 142:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 142:5"/>Godaw, taani neeko waassayis;</para>
  <para style="q2" vid="PSA 142:5">taani, “Ne taw baqatada attiya bessi;</para>
  <para style="q2" vid="PSA 142:5">de7on de7eyisata biittan ta saamay nena” yaagas.<verse eid="PSA 142:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 142:6"/>Taani daro metootiya gisho,</para>
  <para style="q2" vid="PSA 142:6">ta waasuwa si7a.</para>
  <para style="q1" vid="PSA 142:6">Tana yedetheysati wolqaamida gisho,</para>
  <para style="q2" vid="PSA 142:6">tana entafe ashsha.<verse eid="PSA 142:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 142:7"/>Ta ne sunthaa galatana mela,</para>
  <para style="q2" vid="PSA 142:7">tana qashope birsha.</para>
  <para style="q1" vid="PSA 142:7">Neeni taw keeha gidiya gisho,</para>
  <para style="q2" vid="PSA 142:7">xilloti ta yuushon shiiqana.<verse eid="PSA 142:7"/></para>
  <chapter eid="PSA 142"/>
  <chapter number="143" style="c" sid="PSA 143"/>
  <para style="s1">Ta Shempiya Nena Koyawusu</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 143:1"/>Godaw, ta woosa si7a;</para>
  <para style="q2" vid="PSA 143:1">maarota demmanaw ta waasseysa hayza.</para>
  <para style="q1" vid="PSA 143:1">Neeni xillotethaninne ne ammanetethan</para>
  <para style="q2" vid="PSA 143:1">taw zaaro imma.<verse eid="PSA 143:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 143:2"/>Ne sinthan xillo asi bayna gisho</para>
  <para style="q2" vid="PSA 143:2">tana ne aylliya pirdas shiishopa.<verse eid="PSA 143:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 143:3"/>Tana ta morkey yedethidi,</para>
  <para style="q2" vid="PSA 143:3">tincherethidi sa7an yeggis.</para>
  <para style="q1" vid="PSA 143:3">Beni hayqida asada</para>
  <para style="q2" vid="PSA 143:3">tana dhuman wothis.<verse eid="PSA 143:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 143:4"/>Hessa gisho taani heettas;</para>
  <para style="q2" vid="PSA 143:4">ta wozanayka til7is.<verse eid="PSA 143:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 143:5"/>Taani beni wodeta hassayayis;</para>
  <para style="q2" vid="PSA 143:5">ne oothida ooso ubbaa qopayis;</para>
  <para style="q2" vid="PSA 143:5">ne kushe ooso ubbaa akeekayis.<verse eid="PSA 143:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 143:6"/>Taani ta kushiya neeko miccas;</para>
  <para style="q2" vid="PSA 143:6">mela biitti haathe koyeysada,</para>
  <para style="q2" vid="PSA 143:6">ta shempoy nena saamotees. <char style="qs">Salaha </char><verse eid="PSA 143:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 143:7"/>Godaw, ta wozanay heettida gisho</para>
  <para style="q2" vid="PSA 143:7">taw zaaro immanaw ellesa.</para>
  <para style="q1" vid="PSA 143:7">Taani duufon geliya asada hanonna mela</para>
  <para style="q2" vid="PSA 143:7">ne som7uwa taape genthofa.<verse eid="PSA 143:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 143:8"/>Taani nenan ammanetiya gisho,</para>
  <para style="q2" vid="PSA 143:8">wonta wonta ne siiquwaba tana bessa.</para>
  <para style="q1" vid="PSA 143:8">Taani ta shempuwafe nena woossiya gisho,</para>
  <para style="q2" vid="PSA 143:8">ta baana ogiya tana bessa.<verse eid="PSA 143:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 143:9"/>Godaw, taani new maggannida gisho,</para>
  <para style="q2" vid="PSA 143:9">ta morketape tana ashsha.<verse eid="PSA 143:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 143:10"/>Neeni ta Xoossaa gidiya gisho,</para>
  <para style="q2" vid="PSA 143:10">ta ne sheniya oothana mela tana tamaarsa;</para>
  <para style="q2" vid="PSA 143:10">ne lo77o ayyaanay suure ogiyan tana kaaletho.<verse eid="PSA 143:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 143:11"/>Godaw, ne sunthaa gisho tana ashsha;</para>
  <para style="q2" vid="PSA 143:11">ne xillotethan tana metope kessa.<verse eid="PSA 143:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 143:12"/>Ne siiquwan ta morketa wodha;</para>
  <para style="q2" vid="PSA 143:12">ta ne aylle gidiya gisho</para>
  <para style="q2" vid="PSA 143:12">tana un7etheyisata ubbaa dhaysa.<verse eid="PSA 143:12"/></para>
  <chapter eid="PSA 143"/>
  <chapter number="144" style="c" sid="PSA 144"/>
  <para style="s1">Xoossay Taw Miixa</para>
  <para style="d">Dawita Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 144:1"/>Goday, ta zaallay, galatetto!</para>
  <para style="q2" vid="PSA 144:1">Ta kushiya ola tamaarsees;</para>
  <para style="q2" vid="PSA 144:1">ta biradheta tooras giigisees.<verse eid="PSA 144:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 144:2"/>I ta siiqo Xoossaanne ta qosetta attiya besse;</para>
  <para style="q2" vid="PSA 144:2">ta miixanne tana ashsheysa.</para>
  <para style="q1" vid="PSA 144:2">Ta gondallenne taani baqatada attiya besse;</para>
  <para style="q2" vid="PSA 144:2">I kawotethati taw haaretana mela oothis.<verse eid="PSA 144:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 144:3"/>Godaw, neeni iyaw qopanaw asi aybee?</para>
  <para style="q2" vid="PSA 144:3">Ne wozanan iyaw besse immanaw asa na7i aybee?<verse eid="PSA 144:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 144:4"/>Asi issi toho carkiya carko mela;</para>
  <para style="q2" vid="PSA 144:4">iya gallasati aadhiya kuya mela.<verse eid="PSA 144:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 144:5"/>Godaw, saluwa phalqada duge wodha!</para>
  <para style="q2" vid="PSA 144:5">dereta bocha; enti cuyo!<verse eid="PSA 144:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 144:6"/>Wol7anthi yeddada ne morketa laalla;</para>
  <para style="q2" vid="PSA 144:6">ne dongiya yiishshan dukada enta yedetha.<verse eid="PSA 144:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 144:7"/>Bollara ne kushiya yeddada,</para>
  <para style="q2" vid="PSA 144:7">tana wolqaama haathaafe goochada kessa;</para>
  <para style="q2" vid="PSA 144:7">allaga asata kushepe tana wosisa.<verse eid="PSA 144:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 144:8"/>Enti tuma haasayidi erokona;</para>
  <para style="q2" vid="PSA 144:8">banta ushacha kushiya denthidi</para>
  <para style="q2" vid="PSA 144:8">wordon caaqoosona.<verse eid="PSA 144:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 144:9"/>Xoossaw taani new ooratha mazmure yexana;</para>
  <para style="q2" vid="PSA 144:9">tammu shayan waaxetida diithan yexana.<verse eid="PSA 144:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 144:10"/>Kawotas xoono immaasa;</para>
  <para style="q2" vid="PSA 144:10">ne aylliya Dawita ashshaasa.<verse eid="PSA 144:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 144:11"/>Tana iita mashshafe ashsha;</para>
  <para style="q2" vid="PSA 144:11">allaga asata kushepe tana wosisa.</para>
  <para style="q1" vid="PSA 144:11">Enta doonay wordon,</para>
  <para style="q2" vid="PSA 144:11">enta ushacha kushey cimon kumis.<verse eid="PSA 144:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 144:12"/>Nu adde nayti banta na7atethan,</para>
  <para style="q2" vid="PSA 144:12">lo77o dicciya mitha mela gido.</para>
  <para style="q1" vid="PSA 144:12">Nu macca nayti kawo gadho alleeqisanaw,</para>
  <para style="q2" vid="PSA 144:12">oosetida tuuqe mela gido.<verse eid="PSA 144:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 144:13"/>Nu shaaleti dumma dumma katha qommon kumo;</para>
  <para style="q2" vid="PSA 144:13">heemetiya bessan de7iya nu dorsati</para>
  <para style="q2" vid="PSA 144:13">mukulaninne tammu mukulan yelo.<verse eid="PSA 144:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 144:14"/>Nu miizati birayso;</para>
  <para style="q2" vid="PSA 144:14">awucayona yeletidi daro;</para>
  <para style="q2" vid="PSA 144:14">nu ogetan waasoy si7etofo.<verse eid="PSA 144:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 144:15"/>Ha anjoti gakiya asati tuma anjetidaysata;</para>
  <para style="q2" vid="PSA 144:15">Xoossay entaw Godaa gidida asati anjetidaysata.<verse eid="PSA 144:15"/></para>
  <chapter eid="PSA 144"/>
  <chapter number="145" style="c" sid="PSA 145"/>
  <para style="s1">Xoossay Gita</para>
  <para style="d">Dawita Galata Mazmure</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 145:1"/>Ta Xoossaw, ta kawaw, ta nena gitayana;</para>
  <para style="q2" vid="PSA 145:1">ne sunthaa merinaw galatana.<verse eid="PSA 145:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 145:2"/>Taani nena ubba gallas sabbana;</para>
  <para style="q2" vid="PSA 145:2">ne sunthaa merinaw galatana.<verse eid="PSA 145:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 145:3"/>Goday gita; aadho galati iyaw bessees;</para>
  <para style="q2" vid="PSA 145:3">iya gitatethay asa qofape aadhees.<verse eid="PSA 145:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 145:4"/>Issi yeletay hara yeletas ne oosuwa odana;</para>
  <para style="q2" vid="PSA 145:4">ne malaalsiya oosota awaajana.<verse eid="PSA 145:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 145:5"/>Enti ne bonchuwa, ne teemaanne</para>
  <para style="q2" vid="PSA 145:5">ne gitatetha odana.</para>
  <para style="q2" vid="PSA 145:5">Taani ne malaalsiya oosuwa</para>
  <para style="q2" vid="PSA 145:5">zaara zaarada qopana.<verse eid="PSA 145:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 145:6"/>Malaalisiya gita ne oosuwaba odana;</para>
  <para style="q2" vid="PSA 145:6">taani ne gitatetha awaajana.<verse eid="PSA 145:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 145:7"/>Enti ne keehatetha darotethaa odana;</para>
  <para style="q2" vid="PSA 145:7">ne xillotethabaa ufaysan yexana.<verse eid="PSA 145:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 145:8"/>Goday keehanne qadheteysa;</para>
  <para style="q2" vid="PSA 145:8">hanqetanaw ellesenna; siiqon kumidaysa.<verse eid="PSA 145:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 145:9"/>Goday ubbaas keeha;</para>
  <para style="q2" vid="PSA 145:9">I ba medhetetha ubbaas qadhetees.<verse eid="PSA 145:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 145:10"/>Godaw, medhetetha ubbay nena galatana;</para>
  <para style="q2" vid="PSA 145:10">ne asa ubbay nena sabbana.<verse eid="PSA 145:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 145:11"/>Enti ne kawotethaa bonchuwaba odana;</para>
  <para style="q2" vid="PSA 145:11">ne wolqaaba odana.<verse eid="PSA 145:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 145:12"/>Hessan enti ne wolqaama oosuwabaanne</para>
  <para style="q2" vid="PSA 145:12">ne kawotethaa boncho teemaba erisana.<verse eid="PSA 145:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 145:13"/>Ne kawotethay merina kawotethi;</para>
  <para style="q2" vid="PSA 145:13">ne maatay yeleta ubbaa haarees.</para>
  <para style="q2" vid="PSA 145:13">Goday ba gida qaala ubban ammanetees;</para>
  <para style="q2" vid="PSA 145:13">ba ooso ubban keeha.<verse eid="PSA 145:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 145:14"/>Goday kundanaw gedgadeyisata katisees;</para>
  <para style="q2" vid="PSA 145:14">kundidaysata denthees.<verse eid="PSA 145:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 145:15"/>Ubbaa ayfey nena xeellees;</para>
  <para style="q2" vid="PSA 145:15">entaw koshshiya woden kathi immaasa.<verse eid="PSA 145:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 145:16"/>Neeni ne kushiya miccada,</para>
  <para style="q2" vid="PSA 145:16">medhetetha ubbaa amo alaasa.<verse eid="PSA 145:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 145:17"/>Xoossay ba oge ubban xillo;</para>
  <para style="q2" vid="PSA 145:17">ba ooso ubban keeha.<verse eid="PSA 145:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 145:18"/>Goday bana xeegiya ubbaas,</para>
  <para style="q2" vid="PSA 145:18">tuman bana xeegiya ubbaas matan de7ees.<verse eid="PSA 145:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 145:19"/>I baw yayyeyisata amuwa kunthees;</para>
  <para style="q2" vid="PSA 145:19">enta waasuwa si7idi ashshees.<verse eid="PSA 145:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 145:20"/>Goday bana doseyisata ubbaa naagees;</para>
  <para style="q2" vid="PSA 145:20">shin iitata ubbaa dhaysana.<verse eid="PSA 145:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="PSA 145:21"/>Taani ta doonan Godaa galatana;</para>
  <para style="q2" vid="PSA 145:21">Medhetetha ubbay iya geeshsha sunthaa</para>
  <para style="q2" vid="PSA 145:21">merinaw galato!<verse eid="PSA 145:21"/></para>
  <chapter eid="PSA 145"/>
  <chapter number="146" style="c" sid="PSA 146"/>
  <para style="s1">Kawotan Ammanetofite</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 146:1"/>Godaa galatite!</para>
  <para style="q2" vid="PSA 146:1">Ta shempe Godaa galata!<verse eid="PSA 146:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 146:2"/>Ta de7o laytha ubban Godaa galatana;</para>
  <para style="q2" vid="PSA 146:2">ta de7ida wode ubban ta Xoossaa sabbana.<verse eid="PSA 146:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 146:3"/>Halaqatan ammanetofite;</para>
  <para style="q2" vid="PSA 146:3">ashshanaw danda7onna asa na7an ceeqetofite.<verse eid="PSA 146:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 146:4"/>Enta shempoy keyiya wode biittako simmoosona;</para>
  <para style="q2" vid="PSA 146:4">enta halchoy ubbay he gallas aadhees.<verse eid="PSA 146:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 146:5"/>Yayqooba Xoossay maaddiya asinne</para>
  <para style="q2" vid="PSA 146:5">Godaa, ba Xoossan ufaysi oothiya asi anjetidaysa.<verse eid="PSA 146:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 146:6"/>Goday salonne sa7aa,</para>
  <para style="q2" vid="PSA 146:6">abbanne iya giddon de7iya ubbaa medhis;</para>
  <para style="q2" vid="PSA 146:6">Xoossay merinaw ammanetees.<verse eid="PSA 146:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 146:7"/>Goday un7etidaysatas pirdees;</para>
  <para style="q2" vid="PSA 146:7">koshatidaysatas kathi immees;</para>
  <para style="q2" vid="PSA 146:7">Goday qashetidaysata birshees;<verse eid="PSA 146:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 146:8"/>Goday qooqeta xeelisees.</para>
  <para style="q2" vid="PSA 146:8">Goday kundidaysata denthees;</para>
  <para style="q2" vid="PSA 146:8">Goday xillota dosees.<verse eid="PSA 146:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 146:9"/>Goday bete asata naagees;</para>
  <para style="q2" vid="PSA 146:9">Am7etanne yi7o nayta maaddees;</para>
  <para style="q2" vid="PSA 146:9">shin iitata ogiya dhaysees.<verse eid="PSA 146:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 146:10"/>Goday merinaw kawotana;</para>
  <para style="q2" vid="PSA 146:10">Xiyoone, ne Xoossay,</para>
  <para style="q2" vid="PSA 146:10">yeletethafe yeletethi gakanaw kawotana.</para>
  <para style="q2" vid="PSA 146:10">Godaa galatite!<verse eid="PSA 146:10"/></para>
  <chapter eid="PSA 146"/>
  <chapter number="147" style="c" sid="PSA 147"/>
  <para style="s1">Xoossay Meqida Wozana Koolees</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 147:1"/>Godaa galatite!</para>
  <para style="q2" vid="PSA 147:1">Nu Xoossaa saboy lo77o;</para>
  <para style="q2" vid="PSA 147:1">iya saboy ufaysiyabaanne bessiyaba.<verse eid="PSA 147:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 147:2"/>Goday Yerusalaame oorathana;</para>
  <para style="q2" vid="PSA 147:2">Isra7eelepe di7etidaysata shiishana.<verse eid="PSA 147:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 147:3"/>Wozani meqidaysata koolees;</para>
  <para style="q2" vid="PSA 147:3">enta madunthaa pathees.<verse eid="PSA 147:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 147:4"/>I xoolintota taybuwa erees;</para>
  <para style="q2" vid="PSA 147:4">enta ubbaa enta sunthan sunthan xeegees.<verse eid="PSA 147:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 147:5"/>Nu Goday gita; I wolqaama;</para>
  <para style="q2" vid="PSA 147:5">iya akeekas zawi baawa.<verse eid="PSA 147:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 147:6"/>Goday aadata zempisees;</para>
  <para style="q2" vid="PSA 147:6">shin iitata sa7an yeggees.<verse eid="PSA 147:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 147:7"/>Godaas galata yethi yexite;</para>
  <para style="q2" vid="PSA 147:7">nu Xoossaas diithan yexite.<verse eid="PSA 147:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 147:8"/>I saluwa shaara mayzees;</para>
  <para style="q2" vid="PSA 147:8">biittas ira immees;</para>
  <para style="q2" vid="PSA 147:8">zumata bolla maata dolisees.<verse eid="PSA 147:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 147:9"/>Mehetas kathi,</para>
  <para style="q2" vid="PSA 147:9">Koshatidi waassiya quuro naytas</para>
  <para style="q2" vid="PSA 147:9">miyaba immees.<verse eid="PSA 147:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 147:10"/>I parata wolqaninne</para>
  <para style="q2" vid="PSA 147:10">tooranchota minotethan ufaytenna.<verse eid="PSA 147:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 147:11"/>Shin Goday baw yayyeysataninne</para>
  <para style="q2" vid="PSA 147:11">iya maarotan ammaneteysatan ufaytees.<verse eid="PSA 147:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 147:12"/>Yerusalaame, Godaa galata!</para>
  <para style="q2" vid="PSA 147:12">Xiyoone, ne Xoossaa galata!<verse eid="PSA 147:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 147:13"/>I ne pengiya kobeta minthana;</para>
  <para style="q2" vid="PSA 147:13">ne giddon de7iya ne asaa anjana.<verse eid="PSA 147:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 147:14"/>I ne zawa sarotethan naagana;</para>
  <para style="q2" vid="PSA 147:14">nena lo77o gisten kalsana.<verse eid="PSA 147:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="PSA 147:15"/>I ba kiitaa biittas yeddees;</para>
  <para style="q2" vid="PSA 147:15">iya qaalay eeson gakees.<verse eid="PSA 147:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="PSA 147:16"/>I shachi bullukoda miccees;</para>
  <para style="q2" vid="PSA 147:16">caagana bidoda laallees.<verse eid="PSA 147:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="PSA 147:17"/>I shacha shuchada holees;</para>
  <para style="q2" vid="PSA 147:17">iya meeguwan oonika eqanaw danda7enna.<verse eid="PSA 147:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="PSA 147:18"/>I ba qaala kiittidi shacha maaysees.</para>
  <para style="q2" vid="PSA 147:18">I carkuwa kiittin haathi goggees.<verse eid="PSA 147:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="PSA 147:19"/>I ba qaala Yayqoobas,</para>
  <para style="q2" vid="PSA 147:19">ba higgiyanne wogaa</para>
  <para style="q2" vid="PSA 147:19">Isra7eeles awaajees.<verse eid="PSA 147:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="PSA 147:20"/>I hara kawotethatas hessa oothibeenna;</para>
  <para style="q2" vid="PSA 147:20">enti iya higgiya erokona.</para>
  <para style="q2" vid="PSA 147:20">Godaa galatite!<verse eid="PSA 147:20"/></para>
  <chapter eid="PSA 147"/>
  <chapter number="148" style="c" sid="PSA 148"/>
  <para style="s1">Xoossa Suntha Galatite</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 148:1"/>Godaa galatite!</para>
  <para style="q2" vid="PSA 148:1">Salope Godaa galatite;</para>
  <para style="q2" vid="PSA 148:1">bolla dhoqan iya galatite.<verse eid="PSA 148:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 148:2"/>Iya kiitanchoti ubbay iya galatite;</para>
  <para style="q2" vid="PSA 148:2">Salon de7iya iya olanchoti ubbay iya galatite.<verse eid="PSA 148:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 148:3"/>Away, ageenay iya galatite;</para>
  <para style="q2" vid="PSA 148:3">poo7iya xoolintoti ubbay iya galatite.<verse eid="PSA 148:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 148:4"/>Dhoqa saloti iya galatite;</para>
  <para style="q2" vid="PSA 148:4">Salope bollara de7iya haathati iya galatite.<verse eid="PSA 148:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 148:5"/>Enti ubbay Godaa sunthaa galato;</para>
  <para style="q2" vid="PSA 148:5">I kiittin enti medhetidosona.<verse eid="PSA 148:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 148:6"/>I enta merinaw enta bessan bessan wothis;</para>
  <para style="q2" vid="PSA 148:6">shaaretonna higge entaw immis.<verse eid="PSA 148:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 148:7"/>Sa7ape Godaa galatite!</para>
  <para style="q2" vid="PSA 148:7">abban de7iya gita medhetethato;</para>
  <para style="q2" vid="PSA 148:7">abba ciimmoto ubbay iya galatite.<verse eid="PSA 148:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 148:8"/>Wol7anthaw, shachaw, shaaraw,</para>
  <para style="q2" vid="PSA 148:8">caaganaw, iya kiita poliya carkuwaw,</para>
  <para style="q2" vid="PSA 148:8">ubbay iya galatite.<verse eid="PSA 148:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 148:9"/>Dereto, zumato,</para>
  <para style="q2" vid="PSA 148:9">meetetiya ayfe ayfiya mithato, zigato,</para>
  <para style="q2" vid="PSA 148:9">ubbay iya galatite.<verse eid="PSA 148:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="PSA 148:10"/>Meheto, do7ato,</para>
  <para style="q2" vid="PSA 148:10">sa7ara gooshetiya medhetethato,</para>
  <para style="q2" vid="PSA 148:10">paalliya kafoto ubbay iya galatite.<verse eid="PSA 148:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="PSA 148:11"/>Kawoto, kawotethato,</para>
  <para style="q2" vid="PSA 148:11">halaqato, deriya haareysato,</para>
  <para style="q2" vid="PSA 148:11">ubbay iya galatite.<verse eid="PSA 148:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="PSA 148:12"/>Panthato, geela7oto, cimato, nayto,</para>
  <para style="q2" vid="PSA 148:12">ubbay iya galatite.<verse eid="PSA 148:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="PSA 148:13"/>Iya sunthay ubbaafe dhoqa gidiya gishonne</para>
  <para style="q2" vid="PSA 148:13">iya bonchoy salotapenne sa7ape dhoqa gidiya gisho,</para>
  <para style="q2" vid="PSA 148:13">enti ubbay Godaa sunthaa galato.<verse eid="PSA 148:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="PSA 148:14"/>Iyaw mata gidida Isra7eele,</para>
  <para style="q2" vid="PSA 148:14">I dhoqu dhoqu oothis;</para>
  <para style="q2" vid="PSA 148:14">iya galatana mela enta minthethis.</para>
  <para style="q2" vid="PSA 148:14">Godaa galatite!<verse eid="PSA 148:14"/></para>
  <chapter eid="PSA 148"/>
  <chapter number="149" style="c" sid="PSA 149"/>
  <para style="s1">Xoossas Ooratha Mazmure Yexite</para>
  <para style="p">
    <verse number="1" style="v" sid="PSA 149:1"/>Godaa galatite!</para>
  <para style="q2" vid="PSA 149:1">Godaas ooratha yethi yexite!</para>
  <para style="q2" vid="PSA 149:1">xillota shiiquwan iya sabbite!<verse eid="PSA 149:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 149:2"/>Isra7eeley bantana medhidaysan ufayto;</para>
  <para style="q2" vid="PSA 149:2">Xiyooney banta kawan hashshu go.<verse eid="PSA 149:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 149:3"/>Durishe, karaabo baqishe,</para>
  <para style="q2" vid="PSA 149:3">diithi diixishe iya sunthaa sabbo.<verse eid="PSA 149:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 149:4"/>Goday ba asan ufaytees;</para>
  <para style="q2" vid="PSA 149:4">aadatas xoono immidi enta bonchees.<verse eid="PSA 149:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 149:5"/>Ne asay banta xoonuwan ufayto;</para>
  <para style="q2" vid="PSA 149:5">qamma kumethi ufaysan yexo.<verse eid="PSA 149:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 149:6"/>Enta doonan Xoossaa galatay,</para>
  <para style="q2" vid="PSA 149:6">enta kushiyan nam7u bagga qara mashshi de7o.<verse eid="PSA 149:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="PSA 149:7"/>Hessan enti kawotethata bolla halo keyana;</para>
  <para style="q2" vid="PSA 149:7">asaa seerana.<verse eid="PSA 149:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="PSA 149:8"/>Enta kawota santhalaatan,</para>
  <para style="q2" vid="PSA 149:8">enta moorinnata biratan qachana.<verse eid="PSA 149:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="PSA 149:9"/>Enta bolla xaafetida pirdaa polana;</para>
  <para style="q2" vid="PSA 149:9">Hessi Xoossaa asata ubbaas xoono.</para>
  <para style="q2" vid="PSA 149:9">Godaa galatite!<verse eid="PSA 149:9"/></para>
  <chapter eid="PSA 149"/>
  <chapter number="150" style="c" sid="PSA 150"/>
  <para style="s1">Medhetethi Ubbay Xoossa Galato</para>
  <para style="q1">
    <verse number="1" style="v" sid="PSA 150:1"/>Godaa galatite!</para>
  <para style="q2" vid="PSA 150:1">Iya geeshsha keethan Xoossaa galatite;</para>
  <para style="q2" vid="PSA 150:1">dhoqa salon iya galatite.<verse eid="PSA 150:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="PSA 150:2"/>Iya wolqaama oosota gisho iya galatite;</para>
  <para style="q2" vid="PSA 150:2">ubbaafe aadhiya iya gitatethaas iya galatite.<verse eid="PSA 150:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="PSA 150:3"/>Moyze punnishe iya galatite;</para>
  <para style="q2" vid="PSA 150:3">diithaninne maasinqon iya galatite.<verse eid="PSA 150:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="PSA 150:4"/>Karaabo baqishenne durishe iya galatite;</para>
  <para style="q2" vid="PSA 150:4">diithi diixishe, suusul7e punnishe iya galatite.<verse eid="PSA 150:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="PSA 150:5"/>Daala qaathishe iya galatite;</para>
  <para style="q2" vid="PSA 150:5">wolqaama daala girsan iya galatite.<verse eid="PSA 150:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="PSA 150:6"/>Shempora de7iya ubbay</para>
  <para style="q2" vid="PSA 150:6">Godaa galatite!</para>
  <para style="q2" vid="PSA 150:6">Goday galatetto!<verse eid="PSA 150:6"/></para>
  <chapter eid="PSA 150"/>
</usx>
