<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Hawaareta Ooso</para>
  <para style="toc1">Hawaareta Ooso</para>
  <para style="toc3">Hawa</para>
  <para style="toc2">Hawaareta</para>
  <para style="mt1">Hawaareta Ooso</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Hawaareta ooso maxaafay, Luqaasa wongela kaallidi xaafetida maxaafa. Maxaafas de7iya waanna qofay, Yesuusa kaallida koyro asati Geeshsha Ayyaani kaalethin, “Yerusalaamen, Yihuda biitta ubban, Samaaren, sa7a gaxape gaxa gakanaw” (<char style="xt"><ref loc="ACT 1:8">1:8</ref></char>) wongela biitta ubbaa waati gathidako odanaasa. Maxaafay, ammanoy Ayhude asaa giddon doometidi, kumetha alamen eretida ammano gidana gakanaw waanidi dalgidaako odees.</para>
  <para style="ip">Hawaareta ooso maxaafay, Yesuusa wongelay gakiya bessay woden woden dalgi dalgi beysanne woosa keethi eqidaysa qoncisiya heedzu ayfe qofatan shaaketees.</para>
  <para style="ip">1. Ammanoy Yesuusi salo bidaape guye doometidaysa odees.</para>
  <para style="ip">2. Ammanoy Isra7eele biitta ubba gakidaysa odees.</para>
  <para style="ip">3. Ammanoy Roome gujidi Medetiraane Abbaa yuushon de7iya biitta ubban dalgidaysa bessees.</para>
  <para style="ip">Hawaareta ooso maxaafan aadhidi bentey Geeshsha Ayyaana ooso gidishin, Phanxeqosxe gallas Yerusalaamen de7iya ammaniya asaa bolla Geeshsha Ayyaani wolqara wodhidaysa odees. Hessadaka, maxaafa giddon qoncida oosota ubban bentidaysada, Geeshsha Ayyaani woosa keethinne woosa keethi ayseysata kaalethidaysanne minthethidaysa gujidi odees.</para>
  <para style="ip">Hawaareta ooso maxaafan oosetida oosota kiitay, ammaniya asa de7oninne woosa keetha issifetethan de7iya wolqay ay mela giteeko bessees.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Markatethas giigetethi <char style="ior">(<ref loc="ACT 1:1-26">1:1-26</ref>)</char></para>
  <para style="io2">Yesuusa wursetha kiitaanne imetida ufaysa <char style="ior">(<ref loc="ACT 1:1-14">1:1-14</ref>)</char></para>
  <para style="io2">Yihuda bessan haraa dooro <char style="ior">(<ref loc="ACT 1:15-26">1:15-26</ref>)</char></para>
  <para style="io1">Yerusalaamen markatethi <char style="ior">(<ref loc="ACT 2:1-8:3">2:1—8:3</ref>)</char></para>
  <para style="io1">Yihudaninne Samaaren markatethi <char style="ior">(<ref loc="ACT 8:4-12:25">8:4—12:25</ref>)</char></para>
  <para style="io1">Phawuloosi hawaaretethan oothida oosuwa <char style="ior">(<ref loc="ACT 13:1-28:31">13:1—28:31</ref>)</char></para>
  <para style="io2">Koyro hawaaretetha buussaa <char style="ior">(<ref loc="ACT 13:1-14:28">13:1—14:28</ref>)</char></para>
  <para style="io2">Yerusalaame shiiquwa <char style="ior">(<ref loc="ACT 15:1-35">15:1-35</ref>)</char></para>
  <para style="io2">Nam7antho hawaaretetha buussaa <char style="ior">(<ref loc="ACT 15:36-18:22">15:36—18:22</ref>)</char></para>
  <para style="io2">Heedzantho hawaaretetha buussaa <char style="ior">(<ref loc="ACT 18:23-21:16">18:23—21:16</ref>)</char></para>
  <para style="io2">Phawuloosi Yerusalaamen, Qisaareninne Roomen <char style="ior">(<ref loc="ACT 21:17-28:31">21:17—28:31</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s1">Markatethas Giigetethi</para>
  <para style="p">
    <verse number="1-2" style="v" sid="ACT 1:1-2" />Tewofloosa, Yesuusi ba oosuwa oykida wodepe salo bida gallasaa gakanaw, oothidabaanne tamaarsidaba ubba taani ta koyro maxaafan xaafas. Salo baanape sinthe I ba doorida hawaareta, Geeshsha Ayyaanan kiittis.<note caller="-" style="x"><char style="xo" closed="false">1:1-2 </char><char style="xt" closed="false"><ref loc="LUK 1:1-4">Luqa 1:1-4</ref>.</char></note> <verse eid="ACT 1:1-2" /><verse number="3" style="v" sid="ACT 1:3" />I ba waayiyape guye, hayqope dendidaysa sidhey bayna qoncisidi entaw bana bessis. Oytamu gallas entaw qoncidi Xoossa kawotethaaba enta tamaarsis. <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" />Issi wode entara issife de7ishe enta haysada yaagidi kiittis: “Ta hintew odida, ta Aaway immana gida ufaysa qaala naagitepe attishin, Yerusalaamepe keyopite.<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 24:49">Luqa 24:49</ref>.</char></note> <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" />Yohaanisi haathan xammaqis, shin guutha wodepe guye, Geeshsha Ayyaanan hinte xammaqetana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">Maato 3:11</ref>; <ref loc="MRK 1:8">Mar 1:8</ref>; <ref loc="LUK 3:16">Luqa 3:16</ref>; <ref loc="JHN 1:33">Yoha 1:33</ref>.</char></note><verse eid="ACT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />Hawaareti issife Yesuusara shiiqida bessan, “Godaw, Isra7eeletas ne kawotetha zaarana wodey haysee?” yaagidi oychidosona.<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />Yesuusi entako, “Ta Aaway ba maatan oothiya wodenne laythi hinte eranaw danda7eketa. <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" />Shin Geeshsha Ayyaanay hinte bolla wodhiya wode, hinte wolqan kumana. Yaani simmidi, Yerusalaamen, Yihuda biitta ubban, Samaareninne sa7a gaxa gakanaw taw markata gidana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">Maato 28:19</ref>; <ref loc="MRK 16:15">Mar 16:15</ref>; <ref loc="LUK 24:47-48">Luqa 24:47-48</ref>.</char></note><verse eid="ACT 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 1:9" />Hessa gidaape guye enti xeellishin, dhoqu dhoqu gidi, salo bin, iya enta ayfepe shaari genthis.<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">Mar 16:19</ref>; <ref loc="LUK 24:50-51">Luqa 24:50-51</ref>.</char></note><verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />Yesuusi biya wode enti salo tishshi oothidi xeellishin, bootha ma7o ma7ida nam7u asati akeekona enta matan eqidi, <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />“Galila asato, salo xeellishe, hinte ayis eqidetii? Ha hinte be7ishin salo bida Yesuusi hessadaka simmidi yaana” yaagidosona.<verse eid="ACT 1:11" /></para>
  <para style="s1">Yihuda Bessan Maatiyasa Dooretetha</para>
  <para style="r">(<ref loc="MAT 27:3-10">Maato 27:3-10</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />Hessafe guye, hawaareti Shamaho zumaape Yerusalaame simmidosona. Shamaho zumay Yerusalaames matan de7ees. <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" />Enti Yerusalaame gelidi, banta de7iya bessa, pooqiya bolla keyidosona. Entika: Phexroosa, Yohaanisa, Yayqooba, Indiriyasa, Filphoosa, Toomasa, Bartelemoosa, Maatosa, Ilfiyoosa na7a Yayqooba, ba biittas mishetiya Simoonanne Yayqooba na7a Yihuda.<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">Maato 10:2-4</ref>; <ref loc="MRK 3:16-19">Mar 3:16-19</ref>; <ref loc="LUK 6:14-16">Luqa 6:14-16</ref>.</char></note> <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />Haysati ubbay maccasatara, Yesuusa aaye Mayraamiranne Yesuusa ishatara ubbay issi wozanan gididi minthidi woossosona.<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />He wode, Phexroosi xeetanne laatama gidiya ammaniya asay shiiqida bessan dendi eqidi, haysada yaagis: <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />“Asaw, Yesuusa oykidaysata kaalethida Yihudaba, Geeshsha Ayyaanay kase Dawita doonan odida Xoossa qaalay poletanaw bessees. <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />Yihudi nuura issife ha oosuwa oothanaw dooretida asi.”<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />Shin Yihudi ba iita oosuwan demmida miishen gade shammis. I sintha guthu kundin, iya uloy daaketis; iya maraace ubbay kare keyis.<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">Maato 10:2-4</ref>; <ref loc="MRK 3:16-19">Mar 3:16-19</ref>; <ref loc="LUK 6:14-16">Luqa 6:14-16</ref>.</char></note> <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />Yihuda bolla hanidaba Yerusalaamen de7iya asa ubbay si7is. Hessa gisho, he gadiya banta qaalan Akeldaama (Suutha gade) gidi xeegidosona.<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />“Hessika mazmure maxaafan,</para>
  <para style="q1" vid="ACT 1:20">“ ‘Iya keethay kallo atto;</para>
  <para style="q2" vid="ACT 1:20">oonika iyan de7opo.</para>
  <para style="q1" vid="ACT 1:20">Qassi iya shuumatetha hari eko’ geetetidi xaafetis.<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 69:25">Maz 69:25</ref>; <ref loc="PSA 109:8">109:8</ref>.</char></note><verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />“Hessa gisho, Godaa Yesuusi nu giddon simeretida wode ubban nuura de7eysatape, <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />qassi Xammaqiya Yohaanisa wodepe doomidi Godaa Yesuusi salo bida gallas gakanaw nuura de7eysatape issi asi iya denduwas nuura marka gidanaw bessees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 3:16">Maato 3:16</ref>; <ref loc="MRK 1:9">Mar 1:9</ref>; <ref loc="LUK 3:21">Luqa 3:21</ref>.</char></note><verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />Hessa gisho, asay dooruwas Yosxoosa woyko Barsabaasa geetetiya Yoosefanne Maatiyasa nam7a shiishidosona. <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />Hessafe guye, Xoossa woossishe, “Asa ubba wozana eriya Godaw, ha nam7atape ne oona dooridako nuna bessa. <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />Yihudi ba bessaa bidi, aggida oosuwanne hawaaretetha oosuwa ekana mela haysatape nuus qoncisa” yaagidosona. <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />Enta bolla saama yeggidosona. Saamay Maatiyasa bolla wodhin, Maatiyasi tammanne issi hawaareta bolla guzhetis.<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s1">Geeshsha Ayyaana Wodhetha</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />Phenxeqosxe gallasay gakida wode ammaniya asa ubbay issife issi bessan shiiqidi de7oosona.<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">Leewe 23:15-21</ref>; <ref loc="DEU 16:9-11">Zaare 16:9-11</ref>.</char></note> <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />Qoponna wolqaama goteda guummiya guunthay akeekona salope yidi enti de7iya keetha kumis. <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />Qassi tama laco daaniya inxarsati entaw bentishe, shaaketi shaaketi enta ubbaa bolla wodhidosona. <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />Enti ubbay Geeshsha Ayyaanan kumidi dumma dumma doonan odetana mela Geeshsha Ayyaanay enta danda7isin haasaya doomidosona.<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />He wode biitta ubbaafe yida Xoossas babbiya Ayhudeti Yerusalaamen de7oosona. <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />He guuntha si7ida wode daro asay shiiqidosona. Ammaniya asay enta qaalan odetishin si7ida gisho, <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />malaaletidi, “Ha odetiya asa ubbay Galila ase gidokonaayee? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />Yaatin, nuuni, nu yeletida biitta doonan enti odetishin waanidi si7anaw danda7ido? <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />Nuuni Pharxen, Meedonan, Elaaman, Masephexoomen de7eysati, Yihudan, Qaphadooqan, Phanxoosan, Iisen, <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />Pirgen, Phinfilen, Gibxen, Qaarena matan de7iya Liiben de7eyisata. Nuupe baggatika Roomepe yida asata. <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />Ayhudetinne Ayhudetetha ammano gelida asati, Qarxeesanne Arabe asati, Xoossay oothida gita oosuwa nu qaalan odetishin si7oos” yaagidosona. <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />Ubbay malaaletidi, gaanaba dhayidi, “La haysi ay guussee?” yaagidosona. <verse eid="ACT 2:12" /><verse number="13" style="v" sid="ACT 2:13" />Shin harati, “Haysati woyne uyidi mathotidosona” yaagidi qelqisidosona. <figure style="fig" alt="Pentecost" file="GPS_Pentecost_B&amp;W_Flat_English.tiff" size="span" ref="2:9-11">Phenxeqosxe Baliyas Asay Yida Dumma Dumma Gadeta</figure><verse eid="ACT 2:13" /></para>
  <para style="s1">Phexroosa Haasaya</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />Shin Phexroosi, tammanne issi hawaaretara dendi eqidi, ba qaala dhoqu oothidi, entaw haysada yaagidi odis: “Ayhudeto, Yerusalaamen de7iya ubbato, taani odeysa si7ite. <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />Wontafe heedzu saate gidiya gisho hinte qopeysada ha asati mathotibookona; hessi hintew ereto. <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />Shin haysi haniday nabey Iyyu7eeli odidaysi poletana melasa.<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />“ ‘Xoossay, wodiya wursethan haysada hanana yaagees:</para>
  <para style="q2" vid="ACT 2:17">taani asa ubbaa bolla ta Ayyaana gussana.</para>
  <para style="q1" vid="ACT 2:17">Hinte adde naytinne macca nayti,</para>
  <para style="q2" vid="ACT 2:17">tinbite odana.</para>
  <para style="q1" vid="ACT 2:17">Hinte yalagati qoncethi be7ana;</para>
  <para style="q2" vid="ACT 2:17">hinte cimati amuho amuhana.<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="JOL 2:28-32">Iyyu 2:28-32</ref>.</char></note><verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />He gallasatan tana ammaniya adde aylleta bollanne macca aylleta bolla</para>
  <para style="q2" vid="ACT 2:18">taani ta Ayyaana gussana;</para>
  <para style="q2" vid="ACT 2:18">enti tinbite odana.<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />Qassi taani bolla salon oorathaba,</para>
  <para style="q2" vid="ACT 2:19">garsa sa7anka malla bessaana.</para>
  <para style="q1" vid="ACT 2:19">Suuthay, tamaynne wolqaama caaganay bentana.<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />Gitanne boncho gidida Godaa gallasay</para>
  <para style="q2" vid="ACT 2:20">gakanaape sinthe awi dhumana;</para>
  <para style="q2" vid="ACT 2:20">ageeni suuthi daanana.<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />He wode hessada hanana;</para>
  <para style="q2" vid="ACT 2:21">Godaa sunthaa xeegiya oonika attana’ yaagis.<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />“Isra7eele asato, ha qaala si7ite. Naazirete Yesuusa oonatethay, Xoossay hinte giddon oothida wolqaama oosuwaninne malaatatan hintew qoncoysa hinte, hinte huuphen ereeta. <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" />Xoossa kase eraninne iya shenen, Yesuusi hintew aadhidi imetis. Hinte, nagaranchoti iya masqale bolla kaqidi wodhana mela aathidi immideta.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">Maato 27:35</ref>; <ref loc="MRK 15:24">Mar 15:24</ref>; <ref loc="LUK 23:33">Luqa 23:33</ref>; <ref loc="JHN 19:18">Yoha 19:18</ref>.</char></note> <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" />Shin Xoossay hayqo wolqa diggidi iya denthis. Hessa gisho, hayqoy iya oykanaw danda7ibeenna.<note caller="-" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 28:5-6">Maato 28:5-6</ref>; <ref loc="MRK 16:6">Mar 16:6</ref>; <ref loc="LUK 24:5">Luqa 24:5</ref>.</char></note> <verse eid="ACT 2:24" /><verse number="25" style="v" sid="ACT 2:25" />Dawiti iyabaa odishe,</para>
  <para style="q1" vid="ACT 2:25">“ ‘Taani yarkonna mela,</para>
  <para style="q2" vid="ACT 2:25">Goday ta ushachan de7ees.</para>
  <para style="q2" vid="ACT 2:25">Godaa ubba wode ta matan be7ayis.<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />Hessa gisho, ta wozanay ufaytis;</para>
  <para style="q2" vid="ACT 2:26">ta inxarsan ufaysi kumis;</para>
  <para style="q2" vid="ACT 2:26">hayqiya ta asatethay ufaysan daana.<verse eid="ACT 2:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 2:27" />Ayis giiko, ta shempuwa Si7oolen aggaka.</para>
  <para style="q2" vid="ACT 2:27">Qassi ne Geeshsha Na7a aha wooqisaka.<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />Neeni tana de7o oge erisadasa.</para>
  <para style="q2" vid="ACT 2:28">Neeni taara de7eysan ta ufaysay kumethi gidees’<note caller="-" style="x"><char style="xo" closed="false">2:28 </char><char style="xt" closed="false"><ref loc="PSA 16:8-11">Maz 16:8-11</ref>.</char></note> yaagis.<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />“Asaw, nu aawa Dawitaba ta hintew geeshshada odana. Dawiti hayqidi moogetis; iya duufoy hachi gakanaw nu matan de7ees. <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />Dawiti nabe gidida gisho, Xoossay iya sheeshape issuwa iya kawotetha araata bolla utisanaw iyaw caaqida caaquwa erees.<note caller="-" style="x"><char style="xo" closed="false">2:30 </char><char style="xt" closed="false"><ref loc="PSA 132:11">Maz 132:11</ref>; <ref loc="2SA 7:12-13">2 Same 7:12-13</ref>.</char></note> <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />Hessa gisho, Kiristoosa denduwa sinthe xeellidi, ‘Iya shempoy Si7oolen attibeenna; iya asatethayka wooqibeenna’ gidi odis.<verse eid="ACT 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 2:32" />“Xoossay, ha Yesuusa hayqope denthidaysas nuuni ubbay marka. <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />Hessa gisho, Xoossay baara haarana mela baape ushacha baggara iya dhoqu dhoqu oothidi, iyaw immana geetetida Geeshsha Ayyaana ekidi, haysa hinte ha77i be7eysanne si7eysa nu bolla gussis. <verse eid="ACT 2:33" /><verse number="34-35" style="v" sid="ACT 2:34-35" />Gaasoyka, Dawiti ba huuphen salo bibeenna shin yaagis.</para>
  <para style="q1" vid="ACT 2:34-35">“Goday, ta Godaa, ‘Taani ne morketa</para>
  <para style="q2" vid="ACT 2:34-35">ne tohoy yedhiyaso oothana gakanaw</para>
  <para style="q2" vid="ACT 2:34-35">haysan, taape ushacha baggara utta’ ” gis.</para>
  <para style="m" vid="ACT 2:34-35">yaagis.<note caller="-" style="x"><char style="xo" closed="false">2:34-35 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz 110:1</ref>.</char></note><verse eid="ACT 2:34-35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“Hessa gisho, ha hinte masqale bolla kaqida Yesuusa, Xoossay Godanne Kiristoosa oothidaysa Isra7eele asa ubbay tuma ero” yaagis.<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />Asay Phexroosi gidaysa si7ida wode banta wozanan boshetidi Phexroosanne hanko hawaaretako, “Ishato, yaatin nuuni ay oothino?” yaagidosona.<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />Phexroosi entako, “Hinte nagaray atto geetetana mela nagaraape simmidi, hinte issoy issoy Yesuus Kiristoosa sunthan xammaqetite. Xoossay immiya Geeshsha Ayyaana hinte ekana. <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />Gaasoyka Xoossay immana gida ufaysa qaalay hintew, hinte naytasinne Goday nu Xoossay baako xeegiya haahon de7iya ubbaasa” yaagis.<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />Phexroosi entaw hara qaalaka guji markatidi, “Ha wodiya geella asaa bolla yaanaw de7iya pirdafe hinte huuphiya ashshite” yaagidi zoris. <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />Phexroosi odidaysa ekidaysati xammaqetidosona. He gallas heedzu mukulu gidiya asay ammanidosona. <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />Enti hawaareta timirtiyan, issifetethan, uytha muusaninne woosan minnoosona.<verse eid="ACT 2:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />Hawaareta kushen daro oorathabaynne malaati oosetiya gisho asa ubbay yayidosona. <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" />Ammanida ubbay issife de7oosona; bantaw de7iyaba ubbaa issife shaaketoosona.<note caller="-" style="x"><char style="xo" closed="false">2:44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">Hawa 4:32-35</ref>.</char></note> <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />Enti bantaw de7iyaba bayzidi miishiya issuwas issuwas koshshida mela shaakosona. <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />Ubba gallas issi wozanan gididi xoossa keethan shiiqoosona. Banta keethan issoy issuwa xeegidi ufaysaninne ashke wozanan kathi moosona. <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />Xoossa galatishe asa ubban sabetidosona. Goday atteyisata gallas gallas enta bolla gujees.<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s1">Gunda Ura</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />Issi gallas Phexroosinne Yohaanisi woossanaw uddufun saaten Xoossa Keethi bidosona. <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />Yeletoosope doomidi wobbe gidida issi addey Xoossa Keethi geliya asaape miishe woossana mela ubba gallas lo77o geetetiya Xoossa Keetha pengen ehidi wothoosona. <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />He wobbe addey Phexroosinne Yohaanisi Xoossa Keethi gelana hanishin be7idi enta miishe woossis.<verse eid="ACT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 3:4" />Entika iya caddi xeellidi, “Nuuko haa xeella” yaagidosona. <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />Wobbe addey entafe ayko ekana daanin entako xeellis. <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />Shin Phexroosi iyako, “Taw miishey baawa, shin taw de7iyaba taani new immana. Naazirete Yesuus Kiristoosa sunthan dendada hemeta” yaagis.<verse eid="ACT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 3:7" />Hessafe guye, wobbe addiyas ushacha kushiya oykidi denthis. Ellesidi iya tohoynne qincafiley minni aggis. <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />Addey gupidi dendi eqis. Gedenne haa hemethi doomis. Hemetishe, gupishenne Xoossa galatishe entara issife Xoossa Keethi gelis.<verse eid="ACT 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 3:9" />I hemetishininne Xoossa galatishin asa ubbay iya be7idosona. <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />Be7ida ubbay miishe woossanaw lo77o geetetiya xoossa keetha pengen uttidaysi, iya gididaysa eridosona; I hanidaba be7idi malaaletidosona.<verse eid="ACT 3:10" /></para>
  <para style="s1">Phexroosa Haasaya</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />Addey Phexroosapenne Yohaanisape duuxike gidi oykidi de7ishin, asa ubbay malaaletidi, Solomone barandaa geetetiya bessan issife entako woxidosona. <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />Phexroosi asaa be7ida wode asaako, “Isra7eele asaw, ayis haysan malaaletetii? Woyko ayis nuna caddi xeelletii? Nuuni nu wolqan woyko nu xillotethan ha addiya hemethidaba hintew daanii? <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />Abrahaame, Yisaaqa, Yayqooba Xoossay, nu aawata Xoossay, ba na7aa Yesuusa bonchis. Shin hinte hayqos aathidi immidaysa Philaxoosi billanaw koyinka hinte iya sinthan, ‘Nuuni iya eroko’ yaagideta.<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EXO 3:15">Kessa 3:15</ref>.</char></note> <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" />Hinte geeshshanne xilluwa, ‘Nuuni iya eroko’ gidi, shempo wodhidaysa hintew billana mela Philaxoosa woossideta.<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">Maato 27:15-23</ref>; <ref loc="MRK 15:6-14">Mar 15:6-14</ref>; <ref loc="LUK 23:13-23">Luqa 23:13-23</ref>; <ref loc="JHN 19:12-15">Yoha 19:12-15</ref>.</char></note> <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />De7o immeysa hinte wodhideta, shin Xoossay hayqope iya denthis. Hessas nuuni marka. <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />Ha hinte be7eysinne eriya addey, paxidi minniday Yesuusa sunthan ammanidaysana. Ha hinte ubba sinthan iya haysada pathiday, I Yesuusa ammanida gishosa.<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />“Ha77ika ta ishato, hinteka hintena kaaletheysatada, eronna oothidaysa taani erayis. <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />Shin Xoossay beni nabeta ubba doonan, ‘Kiristoosi waaye ekanaw bessees’ yaagidaysi haysada poletana mela oothis. <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />Hiza, Xoossay hinte nagara atto gaana mela Godaako simmite. <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />Godaa matape minthetho wodey hintew yaana. Xoossay Kiristoosa gidana mela sinthatidi doorida Yesuusa hintew yeddana. <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />Xoossay ba geeshsha nabeta doonan beni odidaysa mela ubbabay ooraxiya wodey gakanaw Yesuusi salon gam7anaw bessees. <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />Musey, ‘Godaa Xoossay tana denthidaysa mela hinte giddofe hintew nabe denthana. Hinte I geysa ubbaa si7ite.<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="DEU 18:15">Zaare 18:15</ref>, <ref loc="DEU 18:18">18</ref>.</char></note> <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />He nabey odeysa si7onna asi oonika asaa giddofe shaaketidi dhayo’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="DEU 18:19">Zaare 18:19</ref>.</char></note><verse eid="ACT 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 3:24" />“Qassi Sameelape doomidi de7iya nabeti ubbay ha wodiyaba odidosona. <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />Hinte nabeta nayta; qassi Xoossay Abrahaames, ‘Sa7an de7iya asa ubbaa taani ne sheesha baggara anjana’ yaagidi nu aawatas gelida qaala laattiya nayta.<note caller="-" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="GEN 22:18">Medhe 22:18</ref>.</char></note> <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />Xoossay hintena ubbaa hinte iita ogepe zaaridi anjana mela ba na7a denthidi hintew koyro yeddis” yaagis.<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s1">Phexroosinne Yohaanisi Shango Sinthan</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />Phexroosinne Yohaanisi asaas odishin kahine halaqati, Xoossa Keethe naageysata halaqaynne Saduqaaweti entako yidosona. <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />Enti Yesuusi hayqope dendoysanne iya gaason hayqope dendoy de7eysa asaa tamaarsida gisho yilotidosona. <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />Hessa gisho, enta oykidi sa7i omarsida gisho wontana gakanaw qasho keethi gelsidosona. <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />Shin qaala si7idaysatape daroti ammanidosona. Ammanida adde asaa tayboy ichashu mukuluko bis.<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />Wontetha gallas deriya haareysati, cimatinne, higge astamaareti Yerusalaamen shiiqidosona. <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />He asa giddon kahine halaqay Haanni, Qayyaafi, Yohaanisi, Iskindireynne kahine halaqaa soo asati ubbay de7oosona. <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />Hawaareta banta sinthan essidi, “Aybi wolqan woyko oodde sunthan haysa hinte oothidetii?” yaagidi oychidosona.<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />He wode Phexroosi Geeshsha Ayyaanan kumidi, “Deriya haareysato, cimato, <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />hachi ha wobbe addiyas oosetida lo77o oosuwasinne I waanidi paxidaako hinte nuna oychiko, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />masqaliya bolla hinte kaqin, Xoossay hayqope denthida Naazirete Yesuus Kiristoosa sunthan ha addey paxidi hinte sinthan eqidaysi hintewunne Isra7eele asa ubbaas ereto.<verse eid="ACT 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="ACT 4:11" />“ ‘Gimbeysati boridi ixida shuchay,</para>
  <para style="q2" vid="ACT 4:11">godaa xaphuwa minthiya,</para>
  <para style="q2" vid="ACT 4:11">ubbaafe aadhiya shuchu gidis.</para>
  <para style="q1" vid="ACT 4:11">He shuchay Yesuusa.’<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="PSA 118:22">Maz 118:22</ref>.</char></note><verse eid="ACT 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />Hessa gisho, atotethi iya baggarape attishin, hara oodde baggaraka baawa. Nuuni iya sunthan attana mela asa ubbaas Xoossay salope garsan immida hara sunthi baawa” yaagis.<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />Shiiqida asay Phexroosinne Yohaanisi minnida minotetha be7ida wode enti tamaariboonna coo asi gididaysa akeekidi, malaaletidosona; enti Yesuusara de7eysa eridosona. <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />Qassi paxida addey Phexroosaranne Yohaanisara eqidaysa asay be7idi giyaba dhayidosona. <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />Shin Phexroosanne Yohaanisa kare keyana mela oothidi banta giddon, <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />“Ha asata nu ay oothino? Enta kushen oosetida gita malaatay Yerusalaamen de7iya ubbaas bentees. Nuuni hessa eroko gaanaw danda7oko. <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />Shin ha oday asaa giddon laaletonna mela hizape guye, ha asati Yesuusa sunthan oodeska odonna mela minthidi naagisana” yaagidi zoretidosona.<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />Enta xeegidi, Yesuusa sunthan hizape odonna mela woyko tamaarsonna mela kiittidosona. <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />Shin Phexroosinne Yohaanisi entako zaaridi, “Xoossas kiitetanaysafenne hintew kiitetanaysafe Xoossaa sinthan awusi lo77oko? Ane hinte pirdite. <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />Nuuni be7idabaanne si7idaba odonna agganaw danda7oko” yaagidosona.<verse eid="ACT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 4:21" />Biitta cimatinne deriya haareysati kasepe minthi naagisidi enta yeddi aggidosona. Asay hanidabaas Xoossaa galatiya gisho enta seeranaw danda7ibookona. <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />He malaatan hargefe paxida addiyas laythi oytamape aadhis.<verse eid="ACT 4:22" /></para>
  <para style="s1">Ammaniya Asaa Woosa</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />Phexroosinne Yohaanisi birshetidi banta dabbotako bidi, kahine halaqatinne cimati bantako gidaba ubbaa entaw odidosona. <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />Enti hessa si7ida wode issi wozanan gididi Xoossaa haysada yaagidi woossidosona: “Ubbaa Haariya Godaw, saluwa, sa7aa, abbanne enta giddon de7iya ubbaba medhidayso,<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="EXO 20:11">Kessa 20:11</ref>; <ref loc="NEH 9:6">Nahi 9:6</ref>; <ref loc="PSA 146:6">Maz 146:6</ref>.</char></note> <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />Neeni ne aylliya, nu aawa Dawita doonan Geeshsha Ayyaanan,</para>
  <para style="q1" vid="ACT 4:25">“ ‘Derey ayis yilotidonaa?</para>
  <para style="q2" vid="ACT 4:25">Asay ayis coo maqetidona?<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="PSA 2:1-2">Maz 2:1-2</ref>.</char></note><verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />Sa7aa kawotinne</para>
  <para style="q2" vid="ACT 4:26">deriya haareysati issife Godaa bollanne</para>
  <para style="q2" vid="ACT 4:26">Kiristoosa bolla dendidosona’ yaagadasa.<verse eid="ACT 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 4:27" />“Tumaka, Herodiisinne Phenxe Philaxoosi Ayhude gidonna asaaranne Isra7eele asaara ne doorida ne geeshsha Na7aa Yesuusa bolla dendanaw ha kataman shiiqidosona.<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="MAT 27:1-2">Maato 27:1-2</ref>; <ref loc="MRK 15:1">Mar 15:1</ref>; <ref loc="LUK 23:1">Luqa 23:1</ref>, <ref loc="LUK 23:7-11">7-11</ref>; <ref loc="JHN 18:28-29">Yoha 18:28-29</ref>.</char></note> <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />Qassi neeni ne wolqaaninne ne sheniyan oothana gada qopa uttidaba ubbaa polidosona. <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />Ha77ika Godaw, enta mandetha be7a; nuuni ne aylleti ne qaala kumetha wozanan odana mela nuna danda7isa. <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />Ne geeshsha na7aa Yesuusa sunthan harganchota pathanaw, oorathabaynne malaatati oosetana mela ne kushiya micca” gidi woossidosona.<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />Enti Xoossa woossidaape guye, he enti shiiqida bessay qaaxis. Enta ubban Geeshsha Ayyaani kumin Xoossaa qaala minotethan odidosona.<verse eid="ACT 4:31" /></para>
  <para style="s1">Koyro Ammanida Asa Issifetetha</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />Ammaneysati ubbay qofaninne wozanan issino gididosona. Enti bantaw de7iyaba tabaa goonnashin issife shaaketoosona.<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="ACT 2:44-45">Hawa 2:44-45</ref>.</char></note> <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />Hawaareti, Godaa Yesuusi hayqope dendidaysa gita wolqan markatoosona. Xoossay enta ubbaas aadho keehatetha darsidi immis. <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />Biitti woyko keethi de7eysati ubbay bayzi ekida miishiya ehiya gisho, ammaneyisata giddon metootanchoy issoyka baawa. <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />Miishe ehidi hawaaretas immoosona; he miishiya asaas koshshidaysada issuwas issuwas shaaki shaaki immees.<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />Qophiroosa geetetiya bessan yeletida Yoosefa geetetiya Leewe sheeshape gidida issoy de7ees. Iya sunthaa hawaareti Barnabaasa (Minthetho na7a) gidoosona. <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />Barnabaasi baw de7iya biitta bayzidi miishiya ehidi hawaaretas immis.<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s1">Hananiyanne Saphiiro</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />Issi Hananiya geetetiya addey ba mache Saphirira gade bayzis. <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />He bayzida miishiyape ba machiya erishin bagga ashshidi, attidaysa ehidi hawaaretas immis.<verse eid="ACT 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 5:3" />Shin Phexroosi Hananiyako, “Neeni Geeshsha Ayyaana cimmana melanne gadiya bayzida miishiyape shaakada ashshana mela Xalahey ne wozanan ayis gelidee? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />Neeni bayzanaape kase gadey nebaa gidenneyee? Qassi neeni bayza simminka miishey nebaa gidenneyee? Yaatin, hessa melaba oothanaw ayis ne wozanan qopadii? Neeni Xoossa bolla wordotadasape attishin, asa bolla wordotabaaka” yaagis.<verse eid="ACT 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 5:5" />Hanaani he qaala si7ida mela kundidi hayqis; hessa si7ida ubbay daro yayyis. <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />Na7atetha asati soo gelidi iya aha xaaxidi efidi moogidosona.<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />Heedzu saatepe guye Hananiya machiya hessa eronna de7ashe Phexroosi de7iyasuwa gelasu. <verse eid="ACT 5:7" /><verse number="8" style="v" sid="ACT 5:8" />Phexroosi iiko, “Hinte gadiya haysa mela miishes bayzidetii? Ane taw oda” yaagis.</para>
  <para style="p" vid="ACT 5:8">Iyaka, “Ee, haysa mela miishes bayzida” yaagasu.<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />Phexroosi maccasiw, “Neeranne ne azinara Godaa Ayyaana paacanaw ayis zoretidetii? Heko, ne azina moogida asati karen de7oosona; nenaka enti kare kessana” yaagis.<verse eid="ACT 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 5:10" />Maccasiya iiraka Phexroosa tohuwa matan kundada hayqa aggasu; na7atethati geliya wode hayqidaaro demmidi kare kessidi, I azina matan moogidosona. <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />Kumetha woosa keethaynne hessa si7ida hara asa ubbay daro yayyidosona.<verse eid="ACT 5:11" /></para>
  <para style="s1">Malaalsiyabatanne Malaatata</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />Hawaareti daro malaatatanne oorathabata asaa giddon oothosona. Ammaniya ubbay Solomone barandan issife shiiqoosona. <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />Hara asape entara gahetanaw issi asika minnibeenna, shin asay enta bonchees. <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />Ammaniya addetanne maccasata tayboy kaseysafe darishe bis. <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />Hessa gisho, asay harganchota halaninne algan tookidi Phexroosi aadhiya wode iya kuyay entafe issota issota bolla shempana mela oge doonan kessidi wothoosona. <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />Qassi daro asay Yerusalaame matan de7iya katamatape harganchotanne tuna ayyaani waaysiya asata ekidi yoosona; ubbayka paxidosona.<verse eid="ACT 5:16" /></para>
  <para style="s1">Hawaareta Bolla Goodi Dendis</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />Kahine halaqaynne iyara de7iya Saduqaaweti ubbay qanaaten kumidi hawaareta bolla dendidosona. <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />Hawaareta oykidi deriya qasho keethan yeggidosona. <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />Shin Godaa kiitanchoy qamma qasho keetha pengiya dooyidi hawaareta kare kessidi, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />“Bidi, xoossa keethan eqidi ha ooratha de7o qaala asa ubbaas odite” yaagis. <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />Hawaareti hessa si7ida wode wonta guura Xoossa Keethi gelidi tamaarso doomidosona.</para>
  <para style="p" vid="ACT 5:21">Kahineta halaqaynne iyara de7eysati yidi, Isra7eele cimata ubbaa xeegi shiishidi hawaareta banta sinthe ehana mela wotaadareta qasho keethi kiittidosona. <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />Shin wotaadareti qasho keethi bidi hawaareta demmibookona. Guye simmi yidi deriyas, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“Nuuni biya wode qasho keetha pengey minthi gordetin, naageysati pengen eqidaysata demmida. Shin nuuni kariya dooyiya wode giddon hari attoshin issi asika baawa” yaagidosona. <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />Hessa gisho, Xoossa Keethaa wotaadareta kiitteysinne kahine halaqati hessa si7ida wode, “Hawaareta bolla aybi hanidee?” yaagidi hirgidosona.<verse eid="ACT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 5:25" />He wode issi addey entako yidi, “Heko, qasho keethi hinte gelsida asati xoossa keethan eqidi asaa tamaarsoosona” yaagidi entaw odis. <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />Xoossa Keethaa wotaadareta kiitteysi ba wotaadaretara bidi hawaareta ehis. Shin enti bantana asay shuchan caddana gidi yayyida gisho enta aaddashidi ehidosona.<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />Enti hawaareta ehidi, shiiqida shanguwa sinthan essin kahine halaqay entako, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" />“Hintena nuuni he uraa sunthan tamaarsonna mela minthidi kiittibooko? Heko, hinte timirtiya Yerusalaame katamaa ubba gathideta. He uraa shempuwas nuna oythanaw qopeetii?” yaagidi oychis.<note caller="-" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="MAT 27:25">Maato 27:25</ref>.</char></note><verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />Phexroosaranne hanko hawaaretara entaw zaarishe, “Nuuni asas kiitetanaape Xoossas kiitetanaw bessees. <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />Masqaliya bolla hinte kaqidi wodhida Yesuusa, nu aawata Xoossay hayqope denthis. <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />Isra7eeleti nagaraape simmana melanne enta nagaray atto geetetana mela Xoossay Yesuusa haareysanne ashsheysa oothidi bonchon baape ushacha baggan utisis. <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />Hessas nuuni marka; qassi Xoossay bana ammaneysatas immida Geeshsha Ayyaanayka marka” yaagidosona.<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />Shiiqida asay hessa si7ida wode daro yilotidi, hawaareta wodhanaw qopidosona. <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />Shin asa ubban daro bonchetida Gamaaliyale geeteteysi, issi higge astamaareynne Farsaawey dendi eqidi hawaareta guutha wodes kare kessana mela kiittis. <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />Hessafe guye, shiiqida asaako, “Isra7eele asaw, ha asata bolla hinte oothanaw qopiyabaape naagetite. <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />Ayis giiko, haysafe kase Tewodaasi bana, ‘Taani gita’ gidi dendin, oyddu xeetu gidiya asati iyara issifidosona. Shin iya wodhin iya kaallida ubbay laaletin pathonna asi gididi attidosona. <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />Hessafe guye, asay taybetiya wode Galila Yihudi dendidi daro asa pangayidi kaalethis, shin iyaka wodhin iya kaallida asa ubbay laaletis. <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />Ha77ika ta hintew odayis; ha asatape shaaketite; enta bochofite. Ayis giiko, ha qofaanne ha oosuwa asi oothiyaba gidiko dhayana. <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />Shin ha qofaynne ha oosoy Xoossafe yidaba gidiko, hinte enta dhaysanaw danda7eketa. Hessada hanishe hinte Xoossara kaccetana” yaagidi odis. Hessa gisho, shiiqida asay Gamaaliyale zoriya ekidosona.<verse eid="ACT 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 5:40" />Hawaareta soo xeegidi lisson garaafisis. Hessafe guye, entako, “Yesuusa suntha nam7antho denthofite” gidi birshidi yeddidosona. <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />Yesuusa suntha gisho, enti kawuyanaysi bessiyaba gideysa erida gisho shanguwa sinthafe ufaytishe keyidosona. <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />Enti ubba gallas Xoossa keethaninne asaa son Yesuusi I Kiristoosa gideysa tamaarsonne sabbako aggibokona.<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s1">Laapun Asata Dooretetha</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />He wode kaalleyisata tayboy dari daridi bishin, Girike doona odetiya Ayhudeti Yihudan yeletidi de7iya Ayhudeta bolla zuuzumidosona. Ayis giiko, Girike doona odetiya Ayhudeti, “Gallas gallas imetiya kathan nu am7eti naaqetosona” yaagidosona. <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />Tammanne nam7u hawaareti woosa keetha asa ubbaa xeegidi, “Nuuni Xoossaa qaala odeysa aggidi kathi gishanaw bessenna. <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />Hiza, ishato, lo77o asata, Geeshsha Ayyaananinne cincatethan kumida laapun asata hinte giddofe doorite; nuuni enta ha oosuwas shuumana. <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />Shin nuuni, nu kumetha wodiya woosaninne qaala tamaarson peeshana” yaagidosona.<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />Hawaareti odida oday asa ubba ufaysis. Hessa gisho, ammanoynne Geeshsha Ayyaani kumida Isxifaanose, Filphoosa, Phirokoroosa, Niqaroona, Ximoona, Pharmenanne Ayhude ammano geli simmida Anxooke addiya Niqolawoosa dooridosona. <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />Enta hawaareta sinthan essin, hawaareti enta bolla kushe wothidi woossidosona.<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />Xoossaa qaalay dalgi dalgi bis. Yerusalaamen de7iya ammaneyisata tayboy dari daridi bis; daro kahinetika ammanidosona.<verse eid="ACT 6:7" /></para>
  <para style="s1">Isxifaanosey Oyketis</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />Isxifaanosey aadho keehatethaaninne wolqan kumidi asaa giddon oorathabatanne malaatata oothees. <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />Aylletethafe keyida ayhude woosa keetha asay Qereenapenne Iskindirepe Kilqefenne Iisepe yida issi issi asati dendidi Isxifaanosera palamidosona. <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />Shin Isxifaanosey Ayyaana wolqan odetiya cincatethaa enti eqetanaw danda7ibookona.<verse eid="ACT 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 6:11" />He wode enti, “Musenne Xoossaa I cayishin si7ida” giya wordo asata shammidosona. <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />Hessada oothidi biitta cimatanne higge astamaareta iya bolla denthidosona. Isxifaanose oykidi shanguwa sinthe efidosona. <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />Iya bolla paydida wordo markati, “Ha uray ha xoossa keethaanne Muse higgiya zaari zaari cayees. <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />I, ‘Haysi Naazirete Yesuusi, ha xoossa keetha laallana; qassi Musey nuus immida higgiya laammana’ yaagishin nuuni si7ida” yaagidosona.<verse eid="ACT 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 6:15" />Shango shiiqon uttida asa ubbay Isxifaanose loythidi xeelliya wode iya som7oy kiitancho som7o daanees.<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s1">Isxifaanose Haasaya</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />Kahineta halaqay Isxifaanoseko, “Haysi tumee?” yaagidi oychis.<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />Isxifaanosey, “Ta ishato, ta aawato, si7ite! Nu aawa Abrahaamey Kaaranen daanaw baanape sinthe Masephexoomen de7ishin, boncho Xoossay iyaw qoncidi,<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="GEN 12:1">Medhe 12:1</ref>.</char></note> <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />‘Ne biittafenne ne dabotape shaaketada taani nena bessiya biitta ba’ yaagis. <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />He wode Abrahaamey Kaldaaweta biittafe keyidi Kaaranen daanaw bis. Iya aaway hayqidaape guye Xoossay iya ha biitta ha77i hinte de7iya bessaa ehis.<note caller="-" style="x"><char style="xo" closed="false">7:4 </char><char style="xt" closed="false"><ref loc="GEN 11:31">Medhe 11:31</ref>; <ref loc="GEN 12:4">12:4</ref>.</char></note> <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />I ha biittafe hari attoshin tohoy yedhiya bessika Abrahaames immibeenna. Shin na7i iyaw bayna wode Xoossay ha biitta iyawunne iya sheeshas laata oothidi immanaysa qaala gelis.<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="GEN 12:7">Medhe 12:7</ref>; <ref loc="GEN 13:15">13:15</ref>; <ref loc="GEN 15:18">15:18</ref>; <ref loc="GEN 17:8">17:8</ref>.</char></note> <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />Xoossay Abrahaameko, ‘Ne sheeshay hara biittan imathatethan daana; yan oyddu xeetu laythi enti aylletethan haaretana.<note caller="-" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="GEN 15:13-14">Medhe 15:13-14</ref>.</char></note> <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />Shin taani ne sheesha haariya kawotethata pirdana. Hessafe guye, enti he biittafe keyidi haysan taw goyinnana’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="EXO 3:12">Kessa 3:12</ref>.</char></note> <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />Xoossay Abrahaame sheeshay qaxaretana mela iyara caaqin, Yisaaqi yeletida hospuntho gallasan qaxaris. Yisaaqi Yayqooba qaxaris; qassi Yayqoobi tammanne nam7u ba nayta, nu aawata mayzata qaxaris.<note caller="-" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="GEN 17:10-14">Medhe 17:10-14</ref>; <ref loc="GEN 21:2-4">21:2-4</ref>; <ref loc="GEN 25:26">25:26</ref>; <ref loc="GEN 29:31-35">29:31-35</ref>.</char></note><verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />“Yayqooba nayti Yoosefa qanaatidi Gibxe biittan aylletethas bayzidosona, shin Xoossay iyara de7ees.<note caller="-" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="GEN 37:11">Medhe 37:11</ref>, <ref loc="GEN 37:28">28</ref>; <ref loc="GEN 39:2">39:2</ref>, <ref loc="GEN 39:21">21</ref>.</char></note> <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />Iya, iya waaye ubbaafe kessis. Gibxe kawa sinthan sabanne cincatethi iyaw immis. Gibxe kawoy Yoosefas Gibxe biittanne ba gadhuwa ubbaa aysanaada aawatethi immis.<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="GEN 41:39-41">Medhe 41:39-41</ref>.</char></note><verse eid="ACT 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 7:11" />“Gibxe biittaninne Kanaane biittan ubban koshi gelidi daro asaa un7ethis. He wode nu mayzati kathi demmanaw danda7ibookona.<note caller="-" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="GEN 42:1-2">Medhe 42:1-2</ref>.</char></note> <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />Yayqoobi Gibxe biittan kathi de7eysa si7idi nu aawata koyro yaa yeddis. <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />Nam7antho buussan Yoosefi ba ishatas banatetha erisis. Gibxe kawoyka Yoosefa soo asa eris.<note caller="-" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="GEN 45:1">Medhe 45:1</ref>, <ref loc="GEN 45:16">16</ref>.</char></note> <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />Yoosefi ba aawa Yayqoobanne ba soo asa ubbaa, laapun tammanne ichashu asaa baako yaana mela kiittidi ehisis.<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="GEN 45:9-10">Medhe 45:9-10</ref>, <ref loc="GEN 45:17-18">17-18</ref>; <ref loc="GEN 46:27">46:27</ref>.</char></note> <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />Yayqoobi Gibxe biitta wodhis; inne iya nayti yan hayqidosona.<note caller="-" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GEN 46:1-7">Medhe 46:1-7</ref>; <ref loc="GEN 49:33">49:33</ref>.</char></note> <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />Enta ahay he bessaafe Seekema biitta tooketidi bidi, yan Abrahaamey Hamoore naytape daro biran shammida duufon moogetis.<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="GEN 23:3-16">Medhe 23:3-16</ref>; <ref loc="GEN 33:19">33:19</ref>; <ref loc="GEN 50:7-13">50:7-13</ref>.</char></note><verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />“Shin Xoossay Abrahaames immana gidaysa poliya wodey gakanaw matida wode Gibxe biittan de7iya nu asay dari dari bis.<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="EXO 1:7-8">Kessa 1:7-8</ref>.</char></note> <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />Hessafe guye, Yoosefa eronna hara kawoy Gibxe biittan kawotis. <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />He kawoy nu kochaa genidi guutha nayti hayqana mela enta kare kessi yeggana mela nu aawata un7ethis.<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="EXO 1:10-11">Kessa 1:10-11</ref>, <ref loc="EXO 1:22">22</ref>.</char></note><verse eid="ACT 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 7:20" />“He wode Musey yeletis; I Xoossaa sinthan daro lo77o na7a. Ba aawa keethan heedzu ageena gakanaw diccis.<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="EXO 2:2">Kessa 2:2</ref>.</char></note> <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />Musey wora holetida wode Gibxe kawa na7iya demma ekada ba na7a oothada iya dichasu.<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="EXO 2:3-10">Kessa 2:3-10</ref>.</char></note> <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />Musey Gibxeta cincatetha ubbaa tamaaridi odaninne ooson mino asi gidis.<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />“Muses laythi oytama kumida wode ba ishata, Isra7eeleta be7anaw ba wozanan qopis.<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="EXO 2:11-15">Kessa 2:11-15</ref>.</char></note> <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />Isra7eeletape issuwa Gibxe issoy qohishin be7idi he Isra7eele uraa maaddidi, he qohida Gibxe uraa wodhidi kushe zaaris. <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />Musey ba ishata ba baggara Xoossay ashshanaw haneysa enti akeekana gidi qopis, shin enti akeekibokona.<verse eid="ACT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 7:26" />“Wontetha gallas nam7u Isra7eele asati issoy issuwara wadhetishin demmidi enta sigethanaw koyidi, ‘Asaw, hinte ishanta; ayis issoy issuwa qohetii?’ yaagis.<verse eid="ACT 7:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 7:27" />“Shin ba laggiya qoheysi Museko, ‘Nena nu bolla haareysanne daynna oothiday oonee? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />Neeni zine Gibxe uraa wodhidaysada tanaka wodhanaw koyay?’ yaagidi Muse sugi yeddis. <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />Musey hessa si7ida wode Gibxefe betidi Midiyaame biittan bete asi gididi de7ishe nam7u adde nayta yelis.<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="EXO 18:3-4">Kessa 18:3-4</ref>.</char></note><verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />“Godaa kiitanchoy oytamu laythafe guye, Siina zuma matan de7iya bazzo tushiya giddon eexiya tama laco giddon Muses bentis.<note caller="-" style="x"><char style="xo" closed="false">7:30 </char><char style="xt" closed="false"><ref loc="EXO 3:1-10">Kessa 3:1-10</ref>.</char></note> <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />Musey ba be7idaysan malaaletidi, loythi be7anaw tushiya mati shiiqidi de7ishin, Godaa qaalay, <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />‘Taani ne aawata, Abrahaame Xoossaa, Yisaaqa Xoossaa, Yayqooba Xoossaa’ yaagishe Museko yis. Musey yashshan kokoridi xeellanaw danda7ibeenna.<verse eid="ACT 7:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 7:33" />“Goday Museko, ‘Neeni eqida biittay geeshshi gidiya gisho ne tohuwan de7iya caammaa kessa. <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />Taani Gibxen de7iya ta asaa un7etetha be7as. Enta waasuwa si7ada enta ashshanaw wodhas. Ha77i haaya! Taani nena Gibxe kiittana’ yaagis.<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />“Isra7eeleti Muse, ‘Nena nu bolla haareysanne daynna oothiday oonee?’ yaagidi ixidaysa tushiya giddon iyaw bentida kiitanchuwa baggara haareysanne ashsheysa oothidi Xoossay kiittis.<note caller="-" style="x"><char style="xo" closed="false">7:35 </char><char style="xt" closed="false"><ref loc="EXO 2:14">Kessa 2:14</ref>.</char></note> <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />He Musey Isra7eeleta Gibxefe kessidi malaalsiyabatanne oorathabata Gibxe biittaninne Zo7o Abban oothidi enta oytamu laythi mela biittan kaalethis.<note caller="-" style="x"><char style="xo" closed="false">7:36 </char><char style="xt" closed="false"><ref loc="EXO 7:5">Kessa 7:5</ref>; <ref loc="EXO 14:21">14:21</ref>; <ref loc="NUM 14:33">Taybo 14:33</ref>.</char></note><verse eid="ACT 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 7:37" />“Isra7eele asaako, ‘Xoossay tana denthidaysada hinte sheesha giddofe ta mela nabe hintew denthana’ yaagiday he Muse.<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="DEU 18:15">Zaare 18:15</ref>, <ref loc="DEU 18:18">18</ref>.</char></note> <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />Mela biittan shiiqida Isra7eele asaara de7idaysi, nu aawataranne Siina zuma bolla iyaw odida kiitanchuwara de7ida Musey iya. Yaatidi, Xoossaa de7o qaala nuus immanaw ekis.<note caller="-" style="x"><char style="xo" closed="false">7:38 </char><char style="xt" closed="false"><ref loc="EXO 19:1-20:17">Kessa 19:1—20:17</ref>; <ref loc="DEU 5:1-33">Zaare 5:1-33</ref>.</char></note><verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />“Shin nu mayzati Muses kiitetanaw dosibookona; iya ixidi guye Gibxe simmanaw amotidosona. <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />Qassi Aaronako, ‘Nuna kaalethiya xoossata nuus ootha. Ayis giiko, haysi nuna Gibxefe ehida Musey, waanidaako nuuni eroko’ yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">7:40 </char><char style="xt" closed="false"><ref loc="EXO 32:1">Kessa 32:1</ref>.</char></note> <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />He wode mari daanisidi eeqa oothidosona. He eeqas yarsho yarshidi banta kushen oothida oosuwan ufaytidosona.<note caller="-" style="x"><char style="xo" closed="false">7:41 </char><char style="xt" closed="false"><ref loc="EXO 32:2-6">Kessa 32:2-6</ref>.</char></note> <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />Shin Xoossay entaw zoko zaaris. Enti saluwa xoolintotas goyinnana mela enta yeggi aggis. Nabeta maxaafan,</para>
  <para style="q1" vid="ACT 7:42">“ ‘Isra7eele asato oytamu laythi kumethi</para>
  <para style="q2" vid="ACT 7:42">mela biittan shukida mehiyanne</para>
  <para style="q2" vid="ACT 7:42">yarshida yarshuwa taw yarshidetii?<note caller="-" style="x"><char style="xo" closed="false">7:42 </char><char style="xt" closed="false"><ref loc="AMO 5:25-27">Amo 5:25-27</ref>.</char></note><verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />Hinte, hintew goyinnanaw kessida eeqanne Moloka dunkaaniya</para>
  <para style="q2" vid="ACT 7:43">Rafana geetetiya hinte xoossaa xoolinto misiliya tookideta.</para>
  <para style="q1" vid="ACT 7:43">Taani hintena Babiloonepe</para>
  <para style="q2" vid="ACT 7:43">hini bagga yeddana’ geetetidi xaafetis.<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />“Nu aawatas mela biittan marka dunkaaney de7ees. Iyaka Xoossay Muse kiittidaysadanne iya bessidaysada oothis.<note caller="-" style="x"><char style="xo" closed="false">7:44 </char><char style="xt" closed="false"><ref loc="EXO 25:9">Kessa 25:9</ref>, <ref loc="EXO 25:40">40</ref>.</char></note> <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />Qassi nu aawati he dunkaaniya banta aawatape ekidi Xoossay kase goodida Ayhude gidonna asaa biitta oykida wode Iyyasura yaa ekidi gelidosona. He dunkaaney Dawita wode gakanawuka he bessan de7is.<note caller="-" style="x"><char style="xo" closed="false">7:45 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">Iyya 3:14-17</ref>.</char></note> <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />Dawiti Xoossan sabetis. Qassi Yayqooba Goday de7ana keethaa keexanaw Xoossaa woossis.<note caller="-" style="x"><char style="xo" closed="false">7:46 </char><char style="xt" closed="false"><ref loc="2SA 7:1-16">2 Same 7:1-16</ref>; <ref loc="1CH 17:1-14">1 Taari 17:1-14</ref>.</char></note> <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />Shin iyaw keethaa keexiday Solomone.<note caller="-" style="x"><char style="xo" closed="false">7:47 </char><char style="xt" closed="false"><ref loc="1KI 6:1-38">1 Kawo 6:1-38</ref>; <ref loc="2CH 3:1-17">2 Taari 3:1-17</ref>.</char></note><verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />“Hanoshin, Ubbaafe Bolla Xoossay asi keexida keethan deenna. Nabey gidaysa mela,<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />“ ‘Saloy ta araata,</para>
  <para style="q2" vid="ACT 7:49">sa7ika ta tohoy yedhiyaso.</para>
  <para style="q1" vid="ACT 7:49">Yaatin, taw hinte ay mela keethi keexanee?</para>
  <para style="q2" vid="ACT 7:49">Woyko taani shempiya bessi awunee?<note caller="-" style="x"><char style="xo" closed="false">7:49 </char><char style="xt" closed="false"><ref loc="ISA 66:1-2">Isa 66:1-2</ref>.</char></note> <verse eid="ACT 7:49" /><verse number="50" style="v" sid="ACT 7:50" />Ha ubbaa ta kushen oothabikina?’ yaagees Goday.<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />“Hinte waanida si7onna asee? Hinte wozanay Xoossaa qaala ekanaw ayis ixidee? Hinte haythay ayis tullidee? Hinte, hinte aawatatho ubba wode Geeshsha Ayyaanara eqeteta.<note caller="-" style="x"><char style="xo" closed="false">7:51 </char><char style="xt" closed="false"><ref loc="ISA 63:10">Isa 63:10</ref>.</char></note> <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />Nabeta giddofe hinte aawati gooddonay oonee? Xoossaa Na7ay, Xilloy yaanaysa kasetidi odidaysata wodhidosona. Ha77i hinte iya aathi immidi wodhideta. <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />Hinte kiitanchuwa kushepe Xoossa higgiya ekideta, shin kiitetibeketa” yaagis.<verse eid="ACT 7:53" /></para>
  <para style="s1">Isxifaanose Shuchan Cadetethi</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />Enti hessa si7ida wode banta wozanan Isxifaanose bolla daro yilotidi, banta mettersha saxidi mandidosona. <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />Shin Isxifaanosey Geeshsha Ayyaanan kumidi, salo pude xeellidi, Xoossaa bonchuwanne Yesuusa, Xoossa ushacha baggan eqidaysa be7is. <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />“Heko, taani saloy dooyetin, Asa Na7ay, Xoossaa ushacha baggan eqidaysa be7ayis” yaagis.<verse eid="ACT 7:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />Qaala dhoqu oothidi waassishe, banta haytha oykidi issife iyako woxidosona <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />Iya katamaape gaxa kessidi, shuchan caddidosona. Markati banta ma7uwa issi Saa7ola geetetiya na7atetha matan wothidosona.<verse eid="ACT 7:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="ACT 7:59" />Isxifaanosey, “Ta Godaa Yesuusa, ta shempuwa eka” yaagidi xeegishin enti iya shuchan caddoosona. <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />Gulbatidi, ba qaala dhoqu oothidi, “Ta Godaw, ha nagaraa entaw atto ga” yaagis. Hessa yaagidi simmida mela hayqi aggis.<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="s1">Saa7oli Ammaniya Asaa Gooda</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />Saa7oli Isxifaanose hayquwan ufaytis. He gallas Yerusalaamen de7iya woosa keethan gita goodi dendis. Hawaareti attishin, ammaneysati ubbay Yihuda biittaninne Samaare biittan laaletidosona. <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />Issi issi Xoossa asati Isxifaanose moogidosona; qassi iyaw daro yeekidosona. <verse eid="ACT 8:2" /><verse number="3" style="v" sid="ACT 8:3" />Shin Saa7oli woosa keetha dhaysanaw koyees. Soo soo yuuyi gelidi, ammaniya addetanne maccasata goochi goochi kessidi qasho keethi gelsees.<note caller="-" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="ACT 22:4-5">Hawa 22:4-5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref>.</char></note><verse eid="ACT 8:3" /></para>
  <para style="s1">Wongeli Samaare Gelis</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />Laaletida ammaneysati bida bessa ubban qaala odidosona. <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />Filphoosi Samaare katama bidi Kiristoosaba asaas odis. <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />Daro asay Filphoosi odidaysa si7ida wodenne I oothiya malaatata be7ida wode iya akeekidi si7idosona. <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />Tuna ayyaanati waassidi daro asaape keyidosona; qassi daro gundatinne wobbeti biletidosona. <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />He kataman de7iya asay daro ufaytidosona.<verse eid="ACT 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />Shin Simoona geetetiya issi uray he kataman de7ees. I, “Bana gita” gidi Samaare asaa marotethan malaalsishe gam7is. <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />Guuthafe gita gakanaw de7iya asa ubbay, “Gita Xoossa wolqay haysa” gidi iyabaa si7oosona. <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />Daro wodepe doomidi marotishe Samaare asa malaalsida gisho asay iyabaa si7oosona. <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />Shin Filphoosi Xoossaa kawotethabanne Yesuus Kiristoosa sunthaba addetasinne maccatas odin, enti iyabaa ammanidi xammaqetidosona. <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />Qassi Simoonika ba huuphen ammanidi xammaqetis. Filphoosara issife bida bessa ubban oosetiya gita malaatata be7idi malaaletis.<verse eid="ACT 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />Yerusalaamen de7iya hawaareti Samaare asay Xoossaa qaala ekidaysa si7ida wode Phexroosanne Yohaanisa entako yeddidosona. <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />Phexroosinne Yohaanisi bidi, ammaneysati Geeshsha Ayyaana ekana mela entaw Xoossaa woossidosona. <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />Ayis giiko, Samaare asati Godaa Yesuusa sunthaa xalaalan xammaqetidosonape attishin, entafe issuwa bollaka Geeshsha Ayyaanay wodhibeenna. <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />He wode Phexroosinne Yohaanisi banta kushe enta bolla wothin, enti Geeshsha Ayyaana ekidosona.<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />Hawaareti banta kushe enta bolla wothin, entaw Geeshsha Ayyaanay imetidaysa Simooni be7ida wode Phexroosasinne Yohaanisas miishe ehidi, <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />“Taanika ta kushe wothiya ubbay Geeshsha Ayyaana ekana mela ha maata taw immerketi” yaagis.<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />Shin Phexroosi iyako, “Neeni Xoossaa imota miishen shammanaw qopida gisho ne miishey neera dhayo. <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />Ne wozanay Xoossaa sinthan suure gidonna gisho, new haysan gishoy woyko qaadi baawa. <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />Hiza, ha ne wozana iitatetha gisho nagarape simma. Ne wozanan de7iya iita qofa Xoossay atto gaana mela Xoossaa woossa. <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />Gaasoyka, neeni iita qanaateninne nagara qashon de7eysa taani be7ayis” yaagis.<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />Simooni zaaridi, “Hinte gidaysafe issoyka tana gakonna mela taw Xoossaa woossite” yaagis.<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />Phexroosinne Yohaanisi markatidaapenne Godaa qaala odidaape guye Yerusalaame simmidosona. Samaaren de7iya daro gutatan wongela odidosona.<verse eid="ACT 8:25" /></para>
  <para style="s1">Filphoosanne Tophe Moorinna</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />Godaa kiitanchoy Filphoosako, “Dendada Yerusalaamepe Gaaza efiya mela biitta ogiyako ba. He ogey dugeha baggara de7ees” yaagis. <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />Filphoosi dendidi bis. Hindeke geetetiya Tophe kawees I miishe ubba naagiya Tophe asi de7ees. Ika goyinnanaw Yerusalaame bis. <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />Para gaaren uttidi, Yerusalaamepe ba biitta simmishe nabiya Isayaasa maxaafaa nabbabees.<verse eid="ACT 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 8:29" />Geeshsha Ayyaanay Filphoosako, “He gaariyako bada iya mati shiiqa” yaagis.<verse eid="ACT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 8:30" />Yaatin Filphoosi woxi bidi gakiya wode moorinnay nabiya Isayaasa maxaafape nabbabishin si7idi, “Ne nabbabeysi new gelii?” yaagis.<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />Moorinnay, “Taw odi gelsiya asi bayna waanidi gelanee?” yaagis. Baara gaariyan keyidi uttana mela Filphoosa woossis. <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />Moorinnay nabbabiya maxaafa kifiley,<note caller="-" style="x"><char style="xo" closed="false">8:32 </char><char style="xt" closed="false"><ref loc="ISA 53:7-8">Isa 53:7-8</ref>.</char></note></para>
  <para style="q1" vid="ACT 8:32">“I dorsada shuketanaw laagetis;</para>
  <para style="q2" vid="ACT 8:32">Dorsa mari ba ikisiya meedeyisata sinthan si77i geysada,</para>
  <para style="q2" vid="ACT 8:32">ika ba doona dooyibeenna.<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />I kawuyis; iyaw xillo pirdi dhayis;</para>
  <para style="q2" vid="ACT 8:33">iya de7oy ha sa7ape qanxetida gisho,</para>
  <para style="q2" vid="ACT 8:33">iya sheeshaba oone odanay?” yaagees.<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />Moorinnay zaaridi Filphoosako, “Nabey oodeba odii? Babaa odiye woyko hara asaba odii? Taw odarkii” yaagis. <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />Filphoosi, Xoossa qaala he bessaafe doomidi, Yesuusaba odiya Wongela iyaw odis.<verse eid="ACT 8:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 8:36" />Enti bishe haathi de7iyaso gakidosona. Moorinnay, “Haathe haysa be7a; ta xammaqetonna mela aybe diggey?” yaagis.<verse eid="ACT 8:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 8:37" />Filphoosi iyako, “Neeni ne kumetha wozanaape ammaniko danda7aasa” yaagis.</para>
  <para style="p" vid="ACT 8:37">I zaaridi, “Yesuus Kiristoosi Xoossaa Na7aa gideysa taani ammanayis” yaagis.<verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />Gaarey eqana mela moorinnay kiittin, nam7ay wodhidi haathan gelidosona; Filphoosi iya xammaqis. <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />Enti haathaafe gaxa keyida wode Godaa ayyaanay Filphoosa qoponna ekis. Nam7antho moorinnay Filphoosa be7ibeenna, shin ba ogiya ufaytishe bis. <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />Filphoosi Azaxoonan bana demmis. Qassi Qisaare yaana gakanaw katamatan yuuyidi wongela markatis.<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s1">Saa7oli Kiristoosa Ammanis</para>
  <para style="r">(<ref loc="ACT 22:6-16">Hawa 22:6-16</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />He wode Saa7oli Godaa kaalleyisata wodhanaw mandidi kahine halaqaako bis. <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />Godaa ogiya kaalliya addenne macca demmiko, qachishe Yerusalaame ehanaw, Damasqon de7iya ayhude woosa keethatas dabdaabe baw xaafana mela woossis.<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />I bidi, Damasqo katama gakanaw matishin, qoponna salope wolqaama poo7oy iya yuushon poo7is. <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />I sa7an kundidashin, “Saa7ola, Saa7ola, ayis tana goodday?” giya qaala si7is.<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />Saa7oli, “Godaw, neeni oonee?” yaagidi oychis.</para>
  <para style="p" vid="ACT 9:5">“Taani, neeni gooddiya Yesuusa” yaagis.<verse eid="ACT 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 9:6" />Shin Saa7oli kokorishenne malaaletishe, “Godaw, taani ay oothana mela koyay?” yaagis.</para>
  <para style="p" vid="ACT 9:6">Goday iyako, “Dendada katamaa gela; neeni oothanaw bessiyabay yan new odetana” yaagis.<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />Saa7olara oge biya asati aykoka odetonna eqi attidosona. Qaala si7oosona, shin oonaka be7ibookona. <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />Saa7oli kundida bessaafe dendidi xeelliya wode iya ayfey demmonna ixis. Hessa gisho, enti iya kushiya oykidi kaalethidi Damasqo gelsidosona. <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />Heedzu gallas gakanaw I xeellanaw danda7ibeenna; aykoka mibeenna; uybeenna.<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />Damasqon issi Hananiya geetetiya Yesuusa tamaarey de7ees. Goday qoncethan, “Hananiya” yaagidi xeegis.</para>
  <para style="p" vid="ACT 9:10">Hanaani zaaridi, “Ta Godaw, haysan de7ayis” yaagis.<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />Goday iyako, “Dendada Suure geetetiya ogiya bada, Yihuda son Saa7ola geetetiya Tarsesape yida uraa koya; Saa7oli woossees. <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />Qassi Hananiya geetetiya addey gelidi, Saa7oli nam7antho xeellana mela ba kushiya iya bolla wothishin qoncethan be7is” yaagis.<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />Hanaani zaaridi, “Godaw, Yerusalaamen ne geeshsha asaa bolla he uray ay mela iitabaa oothidaako taani daro asaape si7as. <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />Qassi Damasqon ne sunthaa xeegeyisata ubba qachanaw, kahine halaqati iyaw maata immidosona” yaagis.<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />Shin Goday iyako, “Saa7oli Ayhude gidonna asaa sinthan, kawota sinthaninne Isra7eele asaa sinthan, ta sunthaa erisanawunne taw oothanaw dooretida miishe gidiya gisho neeni iyako ba. <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />Ayis giiko, ta sunthaa gisho, I ay mela waaye ekanaw bessiyako taani iya bessaana” yaagis.<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />Hanaani bidi, soo gelidi, ba kushiya Saa7ola bolla wothidi, “Ta ishaa Saa7ola, neeni yaa ogiyan new bentida Yesuusi, neeni xeellana melanne Geeshsha Ayyaanan kumana mela Goday tana kiittis” yaagis. <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />Ellesidi, Saa7ola ayfepe issi poqo melabay wodhin, Saa7oli nam7antho xeellis. Qassi dendidi xammaqetis. <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />Kathi midi xaalidi, Damasqon de7iya ammaneysatara guutha gallas gam7is.<verse eid="ACT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 9:20" />Ellesidi Saa7oli, “Yesuusi Xoossaa Na7a” yaagidi Damasqon de7iya ayhude woosa keethatan qaala tamaarsis.<verse eid="ACT 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />Hessa si7ida ubbay malaaletidi, “Haysi Yerusalaamen Yesuusa sunthaa xeegeyisata qacheysa gidenneyee? Qassi haa yiday enta qachidi, kahine halaqata sinthe efanaasa gidennee?” yaagidosona.<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />Shin Saa7oli qaala odon minni minnidi bis. Yesuusi, I Kiristoosa gideysa qoncisidi odida gisho Damasqon de7iya Ayhudeti iyaw zaariyaba dhaydosona.<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />Daro gallasape guye, Ayhudeti shiiqidi, Saa7ola wodhanaw zoretidosona.<note caller="-" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="2CO 11:32-33">2 Qoro 11:32-33</ref>.</char></note> <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />Shin Ayhudeti bana wodhanaw qopidaysa Saa7oli si7is. Enti iya wodhanaw qammanne gallas katama pengen naagoosona. <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />Shin iya tamaareti iya qamma efidi, gimbe dirsa maskootera daachora wodhisidosona.<verse eid="ACT 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />Saa7oli Yerusalaame gakida wode ammaneysatara gahetanaw koyis. Shin I Kiristoosa ammanidaysi entaw tuma daanonna ixin iyaw yayyidosona. <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />Shin Barnabaasi Saa7ola hawaaretako efis. Ogen Goday waanidi qoncidaakonne odisidaako, qassi Saa7oli Damasqon Yesuusa sunthan yayyonna waatidi qaala odidaako entaw geeshshidi odis. <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />Saa7oli Yerusalaamen yuuyidi Godaa sunthan yayyonna qaala odishe, hawaaretara issife de7is. <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />Qassi Saa7oli Girike doonan haasaya Ayhudetara odetishe palamees. Shin enti iya wodhanaw koydosona. <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />Ammaniya asati hessa si7idi, Saa7oli Qisaare efidi Tarsesa yeddidosona.<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />Yihudan, Galilaninne Samaare ubban de7iya woosa keethati sarotethan de7idosona. Qassi minnidosona; Godaas yayyishe Geeshsha Ayyaana minthethon dari daridi bidosona.<verse eid="ACT 9:31" /></para>
  <para style="s1">Phexroosi Liideninne Yoophen</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />Phexroosi biitta ubba yuuyishe Liiden de7iya ammaniya asatako gakis. <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />Yan hospun laythi kumethi gundidi arsan zin7idi de7iya Eniya geetetiya addiya demmis. <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />Phexroosi, “Eniya, Yesuus Kiristoosi nena pathana; dendada ne hiixa dentha” yaagis. Ika ellesidi dendi eqis. <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />Liideninne Saaronan de7iya asa ubbay Eniya be7idi, Godaako simmidosona.<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />Yoophe kataman issi Xaabito geetetiya ammaniyara de7awusu. I sunthay Aramike doonan, “Xaabito”; Girike doonan, “Dorqa”; he nam7u suntha birshethay “gen7e” guussu. Iya ba de7ida wode ubban lo77oba oothashenne manqota maaddashe de7asu. <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />He wode iya hargada hayqin, asay I aha meeccidi, pooqe bolla kessidi zin7isidosona. <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />Liidey Yoophes mata. Ammaneysati Phexroosi Liiden de7eysa si7idi, “Hayyana nuuko ellesada ya” yaagidi nam7u asata iyako kiittidosona.<verse eid="ACT 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 9:39" />Hessa gisho, Phexroosi dendidi, entara bis. Yaa gakin, pooqe bolla de7iya kifile iya gelsidosona. Am7eti Phexroosa yuushon eqidi yeekishe Dorqa entara paxa de7ashe oothida qamisetanne afilata ubbaa Phexroosa bessidosona. <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />Phexroosi enta ubbaa kare kessidi, gulbatidi woossis. Qassi ahaako simmidi, “Xaabite, denda” yaagis. Xaabita ba ayfiya dooyada Phexroosa be7ada, denda uttasu. <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />Phexroosi iyo ba kushen maaddidi denthidi essis. Hessafe guye, ammaneysatanne am7eta xeegidi, dendidaro enta sinthe shiishis.<verse eid="ACT 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 9:42" />Ha oday, Yoophe katama ubbaa gakis; daro asay Godaa ammanidosona. <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />Phexroosi Yoophen Simoona geetetiya galba haasheysa son daro gallas gam7is.<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s1">Phexroosanne Qorneliyoosa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />Qisaaren, “Xaale ola asata” geetetiya olanchota giddon issi Qorneliyoosa geetetiya mato halaqay de7ees. <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />Qorneliyoosi ba soo asaara Xoossaa minthi ammaniya asinne Xoossaa goyinniya asi. Ayhude manqotaka daro maaddees, qassi Xoossaa ubba wode woossees. <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />Issi gallas uddufun saate heeran Xoossaa kiitanchoy iyako yidi, “Qorneliyoosa” gidi xeegishin I qoncethan geeshshidi be7is.<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />Qorneliyoosi dagammidi kiitanchuwa tishshi oothi xeellidi, “Godaw, I aybee?” yaagis.</para>
  <para style="p" vid="ACT 10:4">Kiitanchoy zaaridi, “Ne woosaynne manqota ne maaddeysi Xoossaa sinthan hassayetis. <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />Ha77i Yoophe ase kiittada, Phexroosa geetetiya Simoona ehisa. <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />Phexroosi abba doonan galba haashiya Simoona son imathatethi siiratis” yaagis.<verse eid="ACT 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 10:7" />Qorneliyoosi baw odida kiitanchoy bin, ba aylletape nam7atanne Xoossaa goyinniya ba mata wotaadaretape issuwa xeegidi, <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />entaw ubbaba odidi Yoophe kiittis.<verse eid="ACT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />Wontetha gallas enti bidi, Yoophe katama matishin usupun saate heeran Xoossaa woossanaw Phexroosi pooqe bolla keyis. <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />I koshatidi kathi maanaw koyis, shin kathi kaxishin I qoncethi be7is. <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />Saloy dooyetin, gita afila daaniyabay oyddu baggara oyketidi wodhishin I be7is. <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />Iyan oyddu tohora de7iya meheti, wora do7ati, ulora gooshetiya medhetethatinne salo kafoti ubbay de7ees. <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />He wode, “Phexroosaa, denda eqada shukada ma” giya qaalay iyako yis.<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />Shin Phexroosi, “Godaw, akay! Ta tunabaa ubbaraka ma erike” yaagis.<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />Qassi, “Xoossay geeshshidaysa neeni tuna goopa” giya qaalay nam7antho iyako yis. <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />Hessika, heedzu toho hanidaape guye he gita afila daaneysi ellesidi pude salo eketis.<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />Phexroosi ba be7ida qoncethaa birshethay, “Ay gidandesha?” gidi ba wozanan qopishin, Qorneliyoosi kiitida asati Simoona soo oychi demmidi karen eqidosona. <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />Banta qaala dhoqu oothidi, “Phexroosa geetetiya Simoona geetetiya imathay haysan de7ii?” yaagidi oychidosona.<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />Phexroosi qoncethan be7idaba qofa bolla de7ishin, Geeshsha Ayyaanay iyako, “Heko, heedzu asati nena koyoosona. <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />Dendada wodha, taani enta kiitida gisho sidhonna entara ba” yaagis.<verse eid="ACT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 10:21" />Phexroosi asatako wodhidi, “Hinte koyey tana; ayis yidetii?” yaagis.<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />Enti zaaridi, “Nuna mato halaqay Qorneliyoosi kiittis. I xillo, Xoossaa goyinniya asinne Ayhude asa ubban daro bonchetida asi. Qorneliyoosi, nena ba soo ehisidi qaala neepe si7ana mela geeshsha kiitanchoy iyaw odis” yaagidosona. <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />Phexroosi asata soo gelsidi mokis.</para>
  <para style="p" vid="ACT 10:23">Wontetha gallas, dendidi entara bis. Yoophe kataman de7iya ammaneysatape issoti issoti iyara issife bidosona. <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />Wontetha gallas, Qisaare gakidosona. Qorneliyoosi ba dabbotanne ba mata laggeta issife xeegi shiishidi, Phexroosa naagees. <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />Phexroosi soo gelana hanishin, Qorneliyoosi iyara gahetidi iya sinthan kundidi iyaw goyinnanaw koyis. <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />Shin Phexroosi, “Denda, taka ta huuphen ne mela ase” yaagidi iya denthis.<verse eid="ACT 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 10:27" />Phexroosi Qorneliyoosara odetishe soo geliya wode daro asay shiiqidaysa demmis. <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />I asaako, “Ayhude asi hara derera issifanaw woyko gahetanaw woga gidonnaysa hinte ereeta. Shin taani oonaka tuna woyko geeshshi gidenna goonna mela Xoossay tana bessis. <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />Hessa gisho, hinte taako kiittin ixoy bayna yas. Ha77i tana ayis xeegisidaako taw odite” yaagis.<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />Qorneliyoosi, “Taani hachi oyddu gallasape kase hannoode uddufun saate woosa woossishin, phooliya ma7o ma7ida asi ta sinthan eqis. <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />I taako, ‘Qorneliyoosa, Xoossay ne woosa si7is, neeni manqota maaddidaysaka hassayis. <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />Hiza, ase Yoophe kiittada, Simoon Phexroosa geysa xeegisa. Simoon Phexroosi Simoona geetetiya galba haashiya uraa son abba doonan siiratis’ yaagis. <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />Hessa gisho, taani neeko ellesada kiittas; ne lo77o yadasa. Hiza, Xoossay nena Kiittidaba ubbaa si7anaw ha77i nuuni ubbay haysan Godaa sinthan de7oos” yaagis.<verse eid="ACT 10:33" /></para>
  <para style="s1">Phexroosa Haasaya</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />Kaallidika, Phexroosi, “Xoossay asa som7o be7idi ase asape shaakenna.<note caller="-" style="x"><char style="xo" closed="false">10:34 </char><char style="xt" closed="false"><ref loc="DEU 10:17">Zaare 10:17</ref>.</char></note> <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />Shin ase ubbaa oona gidikoka baw yayyeysanne xillo ooso ootheysan Xoossay ufayteysa taani tuma akeekas. <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />Xoossay, ubbaa Godaa gidida Yesuus Kiristoosa baggara sarotethaa odishe ha Wongela Isra7eele asaas kiittidaysa hinte ereeta. <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />Yohaanisi xinqateba Galilan sabbakida wodiyape doomidi Yihuda biitta ubbaa gakanaw hanidaba hinte ereeta. <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />Xoossay Naazirete Yesuusas Geeshsha Ayyaananne wolqaa immis. Xoossay iyara de7iya gisho lo77oba I oothishe Xalahe kushen haaretida ubbaa pathishe yuuyis.<verse eid="ACT 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 10:39" />“Ayhude biittaninne Yerusalaamen I oothida ubbabaas nuuni markata. Enti masqaliya bolla kaqidi iya wodhidosona. <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />Shin Xoossay heedzantho gallasan hayqope iya denthidi asaas qoncana mela oothis. <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />He qoncethay Xoossay koyro doorida markatasafe attishin, asa ubbaasa gidenna. I hayqope dendidaape guye iyara midanne uyida. <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />Xoossay Wongela asaas nuuni odana melanne paxa de7eyisata bollanne hayqidaysata bolla pirdanaw shuumetiday Yesuusa gideysa markatana mela nuna kiittis. <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />Xoossay iya ammaniya ubbaa nagaray, iya sunthan atto geeteteysa nabeti markatoosona” yaagis.<verse eid="ACT 10:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />Phexroosi buroo he oda ongonnashin qaala si7iya ubbaa bolla Geeshsha Ayyaanay wodhis. <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />Phexroosara Yoophefe yida ammaniya qaxaretida Ayhude ubbay, Ayhude gidonnaysati bolla Geeshsha Ayyaanay gukida gisho malaaletidosona. <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />Gaasoyka, enti dumma dumma doonan odetishininne Xoossa gitatetha sabbishin si7idosona.</para>
  <para style="p" vid="ACT 10:46">He wode Phexroosi zaaridi, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“Haysati qassi nu mela Geeshsha Ayyaana ekidaysati xammaqetonna mela haathe digganay oonee?” yaagis. <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />Enti Yesuus Kiristoosa sunthan xammaqetana mela enta kiittis. Hessafe guye, enti bantara guutha gallas uttana mela Phexroosa woossidosona.<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s1">Phexroosi Ba Oothida Oosuwa Odis</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />Hawaaretinne Yihuda ubban de7iya ammaneysati, Ayhude gidonaysatika Xoossaa qaala ekidaysa si7idosona. <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />Phexroosi Yerusalaame bida wode qaxaretida ammaneysati, <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />iyako, “Neeni qaxaretiboonaysatako gelada entara kathi ayis maaddii?” yaagidosona.<verse eid="ACT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 11:4" />Shin Phexroosi hanidaba koyrope doomidi maaran maaran odis: <verse eid="ACT 11:4" /><verse number="5" style="v" sid="ACT 11:5" />“Taani Yoophe kataman Xoossaa woossashe qoncethi be7as. Gita afila daaniyabay oyddu baggara oyketidi salope wodhishe taako yis. <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />Taani tishshi ootha iya giddo xeelliya wode oyddu tohora de7iya meheta, wora do7ata, ulora gooshetiya medhetethatanne salo kafota be7as. <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />‘Phexroosaa, denda, shukada ma’ giya qaala si7as.<verse eid="ACT 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 11:8" />“Shin taani, ‘Godaw, akay, tunabay woyko geeyonnabay ubbaka ta doonako shiiqi erenna’ yaagas.<verse eid="ACT 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 11:9" />“ ‘Xoossay geeshshidaysa neeni tuna goopa’ giya qaalay nam7antho salope yis.<verse eid="ACT 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 11:10" />“Hessi heedzu toho hanin, wursethan ubbabay salo pude eketis. <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />He saatenka heedzu asati Qisaarepe taako kiitetidi taani de7iya keetha gaki aggidosona. <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />Sidhonna entara bana mela Ayyaanay taw odis. Qassi ha usupun ishati Yoophefe taara Qisaare bidaysatara Qorneliyoosa soo gelida. <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />Kiitanchoy iya son eqidi, ‘Yoophe kiittada Phexroosa geetetiya Simoona xeegisa. <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />Nenanne ne soo asa ubbaa ashshiya qaala I new odana’ gidaysa Qorneliyoos nuus odis.<verse eid="ACT 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 11:15" />“Taani haasaya doomiya wode Geeshsha Ayyaanay koyro nu bolla wodhidaysada enta bollaka wodhi aggis. <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" />He wode, ‘Yohaanisi haathan xammaqis, shin hinte Geeshsha Ayyaanan xammaqetana’ yaagida Godaa qaalay taw qofetis.<note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="ACT 1:5">Hawa 1:5</ref>.</char></note> <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />Xoossay nuus Godaa Yesuus Kiristoosa ammanidaysatas immida imota Ayhude gidonaysataska immiko, yaatin Xoossaa digganaw taani oonee?” yaagis.<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />Enti hessa si7ida wode banta palama aggidi, “Yaatin, Xoossay Ayhude gidonaysatika nagarape simmidi de7on daanada qaada immis” yaagidi Xoossaa galatidosona.<verse eid="ACT 11:18" /></para>
  <para style="s1">Anxooke Woosa Keethi</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />Isxifaanose hayqos gathida goodda gaason laaletida ammaneysati qaala Ayhudeta xalaalas odishe Sirofinqe, Qophiroosanne Anxooke gakanaw yuuyidosona.<note caller="-" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="ACT 8:1-4">Hawa 8:1-4</ref>.</char></note> <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />Shin Qophiroosapenne Qereenape yida issi issi ammaniya asati Anxooke bidi, Godaa Yesuusa Wongela Girike asaaska odidosona. <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />Godaa wolqay entara de7ees; qassi daro asay ammanidi Godaako simmidosona.<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />He odaa Yerusalaamen de7iya woosa keethay si7ida gisho Barnabaasa Anxooke kiittis. <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />Barnabaasi Anxooke bida wode Xoossaa aadho keehatetha oosuwa be7idi ufaytis. Enti ubbay banta kumetha wozanan Godan minnidi daana mela enta zoris. <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />Barnabaasi Geeshsha Ayyaanaynne ammanoy kumida lo77o asi gidiya gisho daro asay Godaa ammanidosona.<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />Hessafe guye, Barnabaasi Saa7ola koyanaw Tarsesa bis. <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />Yan Saa7ola demmida wode Anxooke ekidi yis. Barnabaasinne Saa7oli woosa keetha asaara laythi kumethi uttidi daro asaa tamaarsidosona. Ammaneysati Anxooken “Kiristaane” geetetidi koyro xeegetidosona.<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />He wode issi issi nabeti Yerusalaamepe Anxooke wodhidosona. <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" />Enta giddofe Agaboosa geysi dendidi biitta ubban gita koshi keyanaysa Ayyaana wolqan tinbite odis. Hessi haniday Roome Kawa Qalawudiyoosa wodena.<note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="ACT 21:10">Hawa 21:10</ref>.</char></note> <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />Ammaneysati huuphen huuphen banta wolqaa mela miishe kessidi Yihudan de7iya ammaneysatas maade yeddanaw qofa qachidosona. <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />Enti hessada oothidi, miishiya Barnabaasa bollanne Saa7ola bolla woosa keethaa cimatas yeddidosona.<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s1">Phexroosi Qasho Keethafe Kessi Ekis</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />He wode Kawoy Herodiisi<note caller="+" style="f"><char style="fr" closed="false">12:1 </char><char style="fqa" closed="false">Kawoy Herodiisi: </char><char style="ft" closed="false">Haysi kawoy Herodiisi, Herodiisa Agirpha geetetiya koyruwa. I, 37-44 Maarotetha Laytha gakanaw haaris. I kawa Herodiisas na7a na7a </char></note> woosa keetha asaape baggaa goodda doomis. <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />Yohaanisa ishaa Yayqooba mashshan wodhisis. <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />Hessi Ayhudeta ufaysidaysa be7idi, gujidi Phexroosaka oythis. Hessi haniday Paasika Ba7aale bonchiya gallasatana. <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />Phexroosa oykidi qachis. Paasika bonchiya gallasatape guye deriya sinthe aathanaw qopidi, oyddu oyddu wotaadareti iya naagana mela tammanne usupun wotaadaretas aathidi immis.<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Kessa 12:1-27</ref>.</char></note> <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />Hessa gisho, Phexroosi qasho keethan naagetees. Shin woosa keetha asay iyaw minthidi Xoossaa woossosona.<verse eid="ACT 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />Herodiisi Phexroosa asaa sinthe shiishanaape kase qamma Phexroosi nam7u baggara nam7u wotaadaretara santhalaatan qashetidi enta giddon dhiskis. Naageysati qasho keethaa pengetan eqidi naagoosona. <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />Akeekona de7ishin Godaa kiitanchoy qoncis. Qasho keethan poo7oy poo7is. Kiitanchoy Phexroosa miya bochi barkisidi, “Elle denda” yaagis. Iiraka santhalaatay iya kushiyape wodhi aggis. <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />Kiitanchoy iyako, “Ne ma7uwa ma7a, ne caammaaka aatha” yaagis. Phexroosi hessada oothis; kiitanchoy, “Ne laxana ma7ada tana kaalla” yaagis.<verse eid="ACT 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 12:9" />Phexroosi qasho keethafe keyidi kiitanchuwa kaallis. Iyaw qoncethi be7iyaba daanisipe attishin, kiitanchoy oothiyabay tuma daanibeenna. <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />Kiitanchoynne Phexroosi koyruwanne nam7antho wotaadariya aadhidi katamaa efiya birata pengiyako gakidosona. Pengey entaw barka dooyeti aggis. Enti keyidi issi ogiyara bishin kiitanchoy akeekona Phexroosape shaaketi aggis.<verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />Phexroosas wozani simmin, “Tana Goday ba kiitanchuwa kiittidi, Herodiisa kushepenne naagidi uttida Ayhude asa ubbaafe ashshidaysa ha77i tuma eras” yaagis.<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />I hessa akeekida wode daro asay issife shiiqidi Xoossaa woossiya bessaa, Marqoosa geetetiya Yohaanisa aaye Mayraami soo bis. <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />Yan karen eqidi xeegis. Issi Rooda geetetiya oosanchiya pengiya dooyanaw yasu. <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />Rooda Phexroosa qaala gididaysa erida wode ufaysan kumada kariya dooyenna guye woxa bada, “Phexroosi karen eqis” yaagada asaas odasu.<verse eid="ACT 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 12:15" />Asay iiko, “Neeni gooyay!” yaagidosona. Rooda Phexroosa gididaysa geeshshada odasu. Enti, “Hessi iya naagiya kiitanchuwa” yaagidosona.<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />Shin Phexroosi karen eqidi xeegidi aggonna ixin asay kariya dooyidi iya be7idi malaaletidosona. <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />Shin enti si77i gaana mela Phexroosi ba kushiyan mallidi Goday qasho keethafe iya waati kessidaako entaw qoncisi odidi, “Haysa Yayqoobasinne ammaniya asatas odite” gidi yaape keyidi haraso bis.<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />Sa7ay wontiya wode, “Phexroosi aw bide” gidi wotaadareti woli giddon daro kaccidosona. <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />Herodiisi Phexroosa koyisin, I dhayida wode naageysata qoridi, enta wodhana mela kiittis. Hessafe guye, Herodiisi Yihudape Qisaare wodhidi yan guutha wode uttis.<verse eid="ACT 12:19" /></para>
  <para style="s1">Herodiisa Hayquwa</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />Herodiisi Xiroosa asa bollanne Sidoona asaa bolla daro hanqetis. Enta biittay kathi Herodiisa biittafe demmiya gisho enti issife gididi iya Moorinna Bilasxoosa bantaw cima oothidi giiganaw Herodiisako bidosona.<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />Herodiisi bareda gallasan ba kawotethaa afilaa ma7idi, araata bolla uttidi asaas odis. <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />Asay, “Hessi Xoossaa qaala, asa qaala gidenna” yaagidi waassidosona. <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />Herodiisi Xoossaa bonchiboona gisho iiraka Godaa kiitanchoy iya dechin guxunen meetetidi hayqis.<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />Shin Xoossaa qaalay diccishenne dalgishe bees.<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />Barnabaasinne Saa7oli banta oosuwa polidi Marqoosa geetetiya Yohaanisa bantara ekidi Yerusalaamepe simmidosona.<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s1">Barnabaasanne Saa7ola</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />Anxooken de7iya woosa keethan nabetinne astamaareti de7oosona. Enti Barnabaasa, Kareethi geetetiya Simoona, Qereenape yida Lukiyoosa, Kawa Herodiisara diccida Minaahenne Saa7ola. <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />Enti Godaa goyinnishininne xoomishin Geeshsha Ayyaanay, “Taani xeegida oosuwas Barnabaasanne Saa7ola taw dummayite” yaagis.<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />Hessa gisho, enti xoomidaapenne woossidaape guye banta kushiya enta bolla wothidi yeddidosona.<verse eid="ACT 13:3" /></para>
  <para style="s1">Barnabaasinne Saa7oli Qophiroosan</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />Hessa gisho, Geeshsha Ayyaanay enta kiittis. Selewuqe bidosona; yaape markaben gelidi Qophiroosa haathan teqetida biitta bidosona. <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />Enti Silmana gakidi ayhude woosa keethatan Xoossaa qaala odidosona. Yohaanisi<note caller="+" style="f"><char style="fr" closed="false">13:5 </char><char style="fqa" closed="false">Yohaanisi: </char><char style="ft" closed="false">Ha bessan xaafetida Yohaanisi, hawaariya Yohaanisa gidonashin Yohaanisi Marqoosa geetetiya Marqoosa Wongela xaafidaysa.</char></note> maaddishe entara de7ees.<verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />Enti yuushoy abban teqetida biitta, Qophiroosa kanthidi Phaafu gakiya wode, issi wordancho nabiya, Bar-Yesuusa geetetiya Ayhude maruwa demmidosona. <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />He maroy deriya aysiya Sargiyoos Phawuloosa geetetiya akeekancho addiyara de7ees. Sargiyoos Phawuloosi Barnabaasanne Saa7ola baako xeegidi Xoossaa qaala si7anaw koyis. <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />Shin Girike doonan maruwa sunthay “Elmaasa” geetetees. I deriya haareysi ammanonna mela digganaw koyidi Barnabaasaranne Phawuloosara eqetis.<verse eid="ACT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 13:9" />Shin Phawuloosa geetetiya Saa7oli Geeshsha Ayyaanan kumidi maruwa caddi xeellidi, <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />“La, Xalahe na7aw, iitatethi ubbay kumidayso, xillotetha ubbaas morkiyaw, suure Godaa ogiya mirqeysa aggikii? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />Heko, ha77i Godaa kushey ne bolla de7ees. Neeni qooqe gidana; guutha wodes awa poo7o be7aka” yaagis.</para>
  <para style="p" vid="ACT 13:11">Iira caaganne dhumi iya ayfiya goozin, ba kushiya oykidi kaalethiya asi koyishe yuuyis. <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />Deriya ayseysi hessa be7ida wode Godaaba tamaarsiya timirtiyan malaaletidi ammanis.<verse eid="ACT 13:12" /></para>
  <para style="s1">Barnabaasinne Phawuloosi Phisde Anxooken</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />Phawuloosinne iyara de7eysati Phaafupe dendidi, Phinfilen de7iya Pharge markabera bidosona. Yohaanisi entafe shaaketidi Yerusalaame simmis. <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />Shin enti Phargefe aadhidi Phisden de7iya Anxooke gakidosona. Sambaata gallas ayhude woosa keethi gelidi uttidosona. <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />Muse higgeynne nabeta maxaafay nabbabetidaape guye ayhude woosa keetha halaqati, “Nu ishato, asaa minthethiya qaali hintew de7iyako asaas oderketi” yaagidi entako kiittidosona.<verse eid="ACT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 13:16" />Phawuloosi dendi eqidi ba kushe mallidi, “Isra7eele asatonne, Xoossaa goyinniya Ayhude gidonna asaw, si7ite. <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />Ha Isra7eele asaa Xoossay nu mayzata dooris. Gibxe biittan imathatethan enti de7ishin, enta darsidi ba gita wolqan Gibxe biittafe enta kessis.<note caller="-" style="x"><char style="xo" closed="false">13:17 </char><char style="xt" closed="false"><ref loc="EXO 1:7">Kessa 1:7</ref>; <ref loc="EXO 12:51">Kessa 12:51</ref>.</char></note> <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />Mela biittan oytamu laytha mela enta danda7is.<note caller="-" style="x"><char style="xo" closed="false">13:18 </char><char style="xt" closed="false"><ref loc="NUM 14:34">Taybo 14:34</ref>; <ref loc="DEU 1:31">Zaare 1:31</ref>.</char></note> <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />Kanaane biittan Ayhude gidonna laapun kawotethata diggidi enta biitta ba asaa laatisis.<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DEU 7:1">Zaare 7:1</ref>.</char></note><verse eid="ACT 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 13:20" />“Hessafe guye, nabiya Sameela wode gakanaw oyddu xeetanne ishatamu laytha mela aysiya daynnata entaw immis.<note caller="-" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="DEU 2:16">Zaare 2:16</ref>; <ref loc="1SA 3:20">1 Same 3:20</ref>.</char></note> <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />Hessafe guye, enti bantaw kawo immana mela woossin, Xoossay Biniyaame sheeshape Qiisa na7aa, Saa7ola oytamu laythi kawotana mela entaw immis.<note caller="-" style="x"><char style="xo" closed="false">13:21 </char><char style="xt" closed="false"><ref loc="1SA 8:5">1 Same 8:5</ref>; <ref loc="1SA 10:21">10:21</ref>.</char></note> <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />Xoossay Saa7ola shaaridaape guye enta bolla Dawita kawothis. Xoossay Dawitaba markatishe, ‘Taani koyiya ubbaa ta wozanaa mela oothiya Isseye na7aa Dawita demmas’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">13:22 </char><char style="xt" closed="false"><ref loc="1SA 13:14">1 Same 13:14</ref>; <ref loc="1SA 16:12">16:12</ref>; <ref loc="PSA 89:20">Maz 89:20</ref>.</char></note><verse eid="ACT 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 13:23" />“Xoossay, ‘Taani Dawita sheeshape Isra7eele deriya ashsheysa ehana’ gidaysa mela Yesuusa ehis. <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" />Yesuusi yaanape sinthe Isra7eele asa ubbay banta nagaraape simmidi xammaqetana mela Yohaanisi qaala odis.<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="MRK 1:4">Mar 1:4</ref>; <ref loc="LUK 3:3">Luqa 3:3</ref>.</char></note> <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" />Qassi Yohaanisi ba oosuwa wursana hanishe asaako, ‘Tana oona gidi qopeetii? Taani hinte naagiya Kiristoosa gidike, shin taani iya caammaa birshanaw taw bessonnaysi taape guyera yees’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="MAT 3:11">Maato 3:11</ref>; <ref loc="MRK 1:7">Mar 1:7</ref>; <ref loc="LUK 3:16">Luqa 3:16</ref>; <ref loc="JHN 1:20">Yoha 1:20</ref>, <ref loc="JHN 1:27">27</ref>.</char></note><verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />“Ta Ishato, Abrahaame sheeshato, qassi haysan Ayhude gidonashin Xoossas yayyeysato, ha atotetha qaalay nuus kiitetis. <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />Ayis giiko, Yerusalaamen de7iya asaynne enta halaqati Yesuusa eribookona. Sambaata ubban nabbabetiya nabeta qaala akeekibona gisho iya bolla pirdidi nabeti odida qaala polidosona. <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" />Yesuusa wodhisanaw issi gaasoyka entaw dhayin Philaxoosi iya wodhana mela woossidosona.<note caller="-" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 27:22-23">Maato 27:22-23</ref>; <ref loc="MRK 15:13-14">Mar 15:13-14</ref>; <ref loc="LUK 23:21-23">Luqa 23:21-23</ref>; <ref loc="JHN 19:15">Yoha 19:15</ref>.</char></note> <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" />Enti Yesuusabay Geeshsha Maxaafan xaafetidaba ubba polida wode masqaliyape iya wodhisidi moogidosona.<note caller="-" style="x"><char style="xo" closed="false">13:29 </char><char style="xt" closed="false"><ref loc="MAT 27:57-61">Maato 27:57-61</ref>; <ref loc="MRK 15:42-47">Mar 15:42-47</ref>; <ref loc="LUK 23:50-56">Luqa 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoha 19:38-42</ref>.</char></note> <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />Shin Xoossay hayqope Yesuusa denthis. <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" />Hessafe guye, I baara Galilape Yerusalaame yidaysatas daro toho bentis. Enti ha77i iyabaa asaas markatoosona.<note caller="-" style="x"><char style="xo" closed="false">13:31 </char><char style="xt" closed="false"><ref loc="ACT 1:3">Hawa 1:3</ref>.</char></note><verse eid="ACT 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 13:32" />“Xoossay nu aawatas immana gida Wongela nuuni hintew odoos. <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />Dawiti ba Mazmure Maxaafan nam7antho shempuwan,</para>
  <para style="q1" vid="ACT 13:33">“Neeni, ta Na7a,</para>
  <para style="q2" vid="ACT 13:33">taani hachi nena yelas”</para>
  <para style="m" vid="ACT 13:33">geetetidi xaafetida Yesuusa, Xoossay hayqope denthidi nu mayzatas immana gidaysa nuus enta naytas polis.<note caller="-" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Maz 2:7</ref>.</char></note> <verse eid="ACT 13:33" /><verse number="34" style="v" sid="ACT 13:34" />I wooqonna mela Xoossay hayqope iya denthon erisanaw,</para>
  <para style="q1" vid="ACT 13:34">“ ‘Taani Dawitas immana gida</para>
  <para style="q2" vid="ACT 13:34">ammanetida geeshsha anjuwa hintew immana’ ” yaagidi odis.<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="ISA 55:3">Isa 55:3</ref>.</char></note><verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />Hessa gisho, Mazmure Maxaafan hara bessan,</para>
  <para style="q1" vid="ACT 13:35">“ ‘Ne Geeshsha Na7aa aha wooqisaka’ yaagees.<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 16:10">Maz 16:10</ref>.</char></note><verse eid="ACT 13:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 13:36" />“Dawiti ba wode Xoossaa qofaa polidaape guye hayqidi ba aawatara moogetidi wooqis. <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />Shin Xoossay hayqope denthidaysi wooqibeenna.<verse eid="ACT 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 13:38" />“Hessa gisho, ta ishato, nagara atotethay Yesuusa baggara kasetidi hintew odetidaysa erite. Muse higgey nagaraape xillisanaw danda7enna. <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />Shin Yesuusa ammaniya ubbay nagaraape xillees. <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />Hessa gisho, nabeti gidaysi hinte bolla gakonna mela naagetite.<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />“ ‘Xoossay gidaba leqiseysato!</para>
  <para style="q2" vid="ACT 13:41">Be7ite! Malaaletite! Dhayite!</para>
  <para style="q2" vid="ACT 13:41">oonika odin, hinte ammanonna oosuwa</para>
  <para style="q2" vid="ACT 13:41">taani hinte wodiyan oothana’ ” yaagis.<note caller="-" style="x"><char style="xo" closed="false">13:41 </char><char style="xt" closed="false"><ref loc="HEB 1:5">Ibra 1:5</ref>.</char></note><verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />Phawuloosinne Barnabaasi Ayhude Woosa keethafe keyishin, kaalliya Sambaatan hessa gujidi odana mela asay entana woossidosona. <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />Shiiqoy laaletidaape guye, daro Ayhudetinne Ayhudeta ammanuwan gelidi Xoossaa goyinniya daroti Phawuloosanne Barnabaasa kaallidosona. Ammanidaysati Xoossaa aadho keehatethan minnidi daana mela enta zoridosona. <verse eid="ACT 13:43" /><verse number="44" style="v" sid="ACT 13:44" />Kaalliya Sambaatan kataman de7iya asaape daroti Xoossaa qaala si7anaw shiiqidosona. <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />Shin Ayhudeti daro asaa be7ida wode Phawuloosa qanaatidi iya haasaya ixidi iya cayidosona.<verse eid="ACT 13:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="ACT 13:46" />Phawuloosinne Barnabaasi yayyonna, “Xoossaa qaalay koyrottidi hintew odetanaw koshshees. Shin hinte qaala ixidi merinaa de7uwa ekanaw nuus bessenna gidi hinte, hinte huuphen pirdida gisho hiza nuuni Ayhude gidonaysatako simmoos. <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />Gaasoyka Goday,</para>
  <para style="q1" vid="ACT 13:47">“ ‘Alame kumethay ne baggara attana mela,</para>
  <para style="q2" vid="ACT 13:47">taani nena Ayhude gidonna deriyas poo7o oothas’ yaagidi nuna kiittis” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">13:47 </char><char style="xt" closed="false"><ref loc="ISA 42:6">Isa 42:6</ref>; <ref loc="ISA 49:6">49:6</ref>.</char></note><verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />Ayhude gidonnaysati hessa si7ida wode ufaytidi Xoossaa qaala bonchidosona. Qassi merinaa de7uwas dooretida ubbay ammanidosona. <verse eid="ACT 13:48" /><verse number="49" style="v" sid="ACT 13:49" />Godaa qaalay he biitta ubbaa gakis. <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />Shin Ayhudeti, Ayhude gidonna Xoosse goyinniya dure maccasatanne kataman de7iya gita asata Phawuloosa bollanne Barnabaasa bolla denthethidosona. He asati enta goodda doomidi banta biittafe kessidosona. <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" />Shin Phawuloosaranne Barnabaasara ixeysatas malla gidana mela banta tohuwape baana pitidi Iqoniyoone katama bidosona.<note caller="-" style="x"><char style="xo" closed="false">13:51 </char><char style="xt" closed="false"><ref loc="MAT 10:14">Maato 10:14</ref>; <ref loc="MRK 6:11">Mar 6:11</ref>; <ref loc="LUK 9:5">Luqa 9:5</ref>; <ref loc="LUK 10:11">10:11</ref>.</char></note> <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />Qassi Anxooken de7iya ammaneysati Geeshsha Ayyaananinne ufaysan kumidosona. <figure style="fig" alt="Paul's 1st Journey" file="Paul1-BW.tif" size="span" loc="ACT 13:1—14:28" ref="13:1—14:28">Phawuloosi Wongela Sabbakanaw Bida Koyro Ogiya</figure><verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s1">Phawuloosinne Barnabaasi Iqoniyoonen</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />Kaseysadaka, Phawuloosinne Barnabaasi Iqoniyoonen Ayhudeta woosa keethi gelidi daro Ayhudetinne Ayhude gidonnaysati ammanana gakanaw qaala odidosona. <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />Shin ammanibona Ayhudeti, Ayhude gidonnayisata wozanaa laammidi ishata bolla denthethidosona. <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />Hawaareti yan daro wodiya gam7idosona. Enti yayyonna Godaaba odidosona. Goday malaatatanne oorathaba enti oothana mela entaw maata immidi, I ba aadho keehatetha qaalay tuma gideysa qoncisis. <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />Shin he katama asay shaaketidi, baggay Ayhudetara baggay qassi Hawaaretara gidis.<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />Ayhude gidonaysatinne Ayhudeti banta halaqatara issife gididi hawaareta qohanawunne shuchan caddanaw koydosona. <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />Hawaareti hessa eridi, Lisxiranne Darbe geetetiya Liqa7oona katamatanne enta heeran de7iya biitta baqatidosona. <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />Yan Wongela odidosona.<verse eid="ACT 14:7" /></para>
  <para style="s1">Phawuloosinne Barnabaasi Lisxiraninne Darben</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />Yeletoosape doomidi nam7u tohoy wobbin hemeti eronna issi addey Lisxiran de7ees. <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />He addey Phawuloosi odishin uttidi si7ees. Phawuloosi iya tishshi oothi xeelliya wode paxanaw iyaw ammanoy de7eysa be7idi, <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />ba qaala dhoqu oothidi, “Sitti gada ne tohuwan eqa” yaagis. Yaatin, gupi dendi eqidi hemethi doomis.<verse eid="ACT 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 14:11" />Phawuloosi oothidaysa asay be7idi banta qaala dhoqu oothidi Liqa7oona doonan, “Xoossati ase daanidi nuuko wodhidosona” yaagidosona. <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />Barnabaasa, “Diya” gidi, Phawuloosi odan waannatiya gisho, iya, “Hermena” gidi sunthidosona. <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />Katamaape gaxan de7iya eeqa Diya keethaa kahineynne asay kormatanne alleeqo ciishshata hawaaretas yarshanaw koyidi katamaa penge ehidosona.<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />Shin Barnabaasinne Phawuloosi hessa si7ida wode enti oothanaw qopidaysa ixidi, banta ma7uwa peedhidosona. Asaa giddo woxi gelidi, <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />banta qaala dhoqu oothidi, “Asaw, haysa ayis oothetii? Nuka hinte mela ase. Ha pathonabape salonne sa7a, abbanne enta giddon de7iya ubbaba medhida de7o Xoossaako hinte simmana mela hintew nuuni Wongela odoos.<note caller="-" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="EXO 20:11">Kessa 20:11</ref>; <ref loc="PSA 146:6">Maz 146:6</ref>.</char></note> <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />I, beni asay banta oge baana mela yeddi aggis. <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />Shin ira saluwape bukisis, kathaaka wodiyan wodiyan immis, kathi immidi hintena daro ufaysis, yaatidi hintew lo77oba oothidi baw marka dhaysibeenna” yaagidosona. <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />Hawaareti hessa gidi, bantaw asay yarshonna mela waaydi diggidosona.<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />Anxookepenne Iqoniyoonepe yida Ayhudeti, asaa banta bagga zaaridi shuchan Phawuloosa caddidosona. I hayqidaba daanin katamaape gaxa goochi efidi yeggidosona. <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />Shin ammaneysati yidi, iya yuushon eqidashin I dendidi katamaa gelis. Wontetha gallas Barnabaasara issife Darbe bis.<verse eid="ACT 14:20" /></para>
  <para style="s1">Phawuloosinne Barnabaasi Soore Anxooke Simuwa</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />Enti Darbe kataman Wongela odidi darota ammanthidaape guye Lisxira, Iqoniyoonenne Phisden de7iya Anxooke simmidosona. <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />Yan ammaneyisata minthethishenne enti ammanon minnidi de7ana mela zorishe, “Xoossaa kawotethaa gelanaw nuuni daro waaye ekanaw bessees” yaagidi tamaarsidosona. <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />Qassi woosa keethatas huuphen huuphen cimata dooridosona. Xoomidaapenne woossidaape guye enti ammanida Godaas enta hadara immidosona.<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />Phisde biitta kanthi aadhidi Phinfile bidosona. <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />Phergen qaala odidaape guye Axaale bidosona. <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />Banta oosuwa polidaape guye, Axaalep Xoossa aadho keehatethas enta hadara immida Anxooke markabera guye simmidosona.<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />Anxooke gakida wode woosa keethaa asaa shiishidi Xoossay entara oothida oosuwa ubbaanne Ayhude gidonna asay ammanana mela entaw waati penge dooyidaako odidosona. <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />Hessan ammaneysatara daro wode gam7idosona.<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s1">Yerusalaame Shiiquwa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />Issi issi asati Yihudape Anxooke bidi, “Muse wogaatho hinte qaxaretonna ixiko attanaw danda7eketa” gidi ammaneyisata tamaarso doomidosona.<note caller="-" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="LEV 12:3">Leewe 12:3</ref>.</char></note> <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />Hessi Phawuloosanne Barnabaasa entara daro palamanadanne kaccanaada oothis. Hessa gisho, Anxooken de7iya issi issi asati Phawuloosaranne Barnabaasara Yerusalaame bidi Hawaaretaranne cimatara gahetidi he oda billanaw qofay qashetis.<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />Woosa keethay enta kiittin bidosona. Enti Sirofinqe Samaarera aadhishe Ayhude gidonnaysati Xoossako waanidi simmidaako odidosona. Hessi ammaneyisata ubbaa daro ufaysis. <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />Enti Yerusalaame gakida wode woosa keethay, Hawaaretinne cimati enta mokidosona. Xoossay bantara oothidaba ubba odidosona. <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />Shin Farsaaweta baggafe ammanida issi issi asati dendi eqidi, “Ayhude gidonashin ammanida asati qaxaretanawunne Muse higge naaganaw bessees” yaagidosona.<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />Hawaaretinne cimati hessa zorettanaw shiiqidosona. <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" />Daro zoretidaape guye, Phexroosi dendi eqidi, “Ta ishato, Ayhude gidonnaysati Wongela qaala ta doonape si7idi ammanana mela kasetidi tana Xoossay hinte giddofe dooridaysa hinte ereeta.<note caller="-" style="x"><char style="xo" closed="false">15:7 </char><char style="xt" closed="false"><ref loc="ACT 10:1-43">Hawa 10:1-43</ref>.</char></note> <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" />Asa wozana eriya Xoossay Geeshsha Ayyaana nuus immidaysada entawuka immidi tumayis.<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 2:4">Hawa 2:4</ref>; <ref loc="ACT 10:44">10:44</ref>.</char></note> <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />Ammanon enta wozana geeshshida gisho nu giddoninne enta giddon dummatethi wothibeenna. <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />Hessa gisho, nu aawatinne nuuni tookanaw danda7iboona qambara ammaneyisata morgen wothidi ha77i ayis hinte Xoossa paacetii? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />Godaa Yesuus Kiristoosa aadho keehatethan enti attidaysada nuka attidaysa ammanoos” yaagis.<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />Asay si77i gidi, Barnabaasinne Phawuloosi Ayhude gidonna asaa giddon banta baggara Xoossay oothida malaatatanne oorathaba ubbaa odishin si7oosona.<verse eid="ACT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 15:13" />Enti haasaya ongidaape guye Yayqoobi, “Ishato, ta geysa si7ite. <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />Xoossay Ayhude gidonnayisata giddofe ba ase dooranaw koyidi entana koyro waatidi qopidaako Simooni odis. <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />Nabeta qaalay haysara issino. Geeshsha Maxaafan,<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />“ ‘Haysafe guye, taani simmana,</para>
  <para style="q2" vid="ACT 15:16">kundida Dawita kawotetha denthana.<note caller="-" style="x"><char style="xo" closed="false">15:16 </char><char style="xt" closed="false"><ref loc="AMO 9:11-12">Amo 9:11-12</ref>.</char></note></para>
  <para style="q2" vid="ACT 15:16">Laaletida keethaaka zaara essana.<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />Attida asa ubbay taako yaana,</para>
  <para style="q2" vid="ACT 15:17">taani xeegida Ayhude gidonna asa ubbay tana koyana.<verse eid="ACT 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 15:18" />Benipe doomada hessi eretana mela oothida</para>
  <para style="q2" vid="ACT 15:18">Xoossay, taani yaagayis’ yaagees.<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />“Hessa gisho, ta qofay Xoossako simmiya Ayhude gidonnayisata nuuni waaysonaako lo77o. <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />Shin enti eeqas yarshetidi tunidaba moonna mela, laymatonna mela, bawuta moonna melanne suuthi uyonna mela entaw nuuni dabdaabe xaafanaw koshshees.<note caller="-" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="EXO 34:15-17">Kessa 34:15-17</ref>; <ref loc="LEV 17:10-16">Leewe 17:10-16</ref>; <ref loc="LEV 18:6-23">18:6-23</ref>.</char></note> <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />Muse higgey benipe doomidi Sambaatan Sambaatan ayhude woosa keethatan nabbabetishe katama ubban sabbaketees” yaagis.<verse eid="ACT 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />Hessafe guye, hawaaretinne cimati woosa keetha asa ubbaara issife banta giddofe guutha asata dooridi Phawuloosaranne Barnabaasara Anxooke yeddanaw qofa qachidosona. Enti daro bonchetida nam7u asata Barsabaasa geetetiya Yihudanne Sillaase dooridosona. <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />Haysada geetetidi xaafetida dabdaabe enta bolla yeddidosona: “Nuuni hawaaretinne cimati hinte ishati, Anxooken, Sooreninne Kilqen de7iya Ayhude gidonna ishatas nu sarothuwa kiittoos.<verse eid="ACT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 15:24" />“Nuuni kiittonna asati nu giddofe bidi, ‘Hinte qaxaretanawunne higgiya naaganaw bessees’ gidi, hintena waaysidaysanne yiloydaysa si7ida. <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />Nuuni dosiya Barnabaasanne Phawuloosa dooretida asatara issife hinteko kiittanaw issi wozanan nu qofaa qachida. <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />Enti nu Godaa Yesuus Kiristoosa gisho banta de7uwa aathidi immidosona. <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />Hessa gisho, nuuni xaafidaysa enti banta doonan gujidi hintew odana mela Yihudanne Sillaase kiitida.<verse eid="ACT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 15:28" />“Ha koshsheysatape attishin, hara tooho hintena toossonna mela nunne Geeshsha Ayyaanay oda qachida. <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />Eeqas yarshetidi tunidaba moopite, suuthu uyopite, bawuta moopite, laymatopite. Ha ubbaafe hinte huuphiya naagiko hinte lo77oba ootheeta. Hiza, saro de7ite” yaagidosona.<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />Hessa gisho, kiitetidaysati moyzetidi Anxooke bidi ammaniya asaa shiishidi, dabdaabe immidosona. <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />Enti he minthethiya dabdaabiya nabbabida wode ufaytidosona. <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />Qassi Yihudinne Sillaasey banta huuphen nabe gidiya gisho ammaneyisata loythi zoridi minthethidosona. <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />Enti Anxooken guutha gallas uttidaape guye ishati lo77ora moyzin bantana kiitidaysatako simmidosona. <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" /><note caller="+" style="f"><char style="fr" closed="false">15:34: </char><char style="ft" closed="false">Issi issi maxaafatan paydo 34 baawa.</char></note> [Shin Sillaasey yan attanaw koyis].<verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />Qassi Phawuloosinne Barnabaasi hara daro asatara issife Godaa qaala tamaarsishenne wongelaa odishe Anxooken gam7idosona.<verse eid="ACT 15:35" /></para>
  <para style="s1">Phawuloosanne Barnabaasa Shaaketetha</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />Guutha gallasape guye Phawuloosi Barnabaasako, “Nuuni Godaa qaala odida katama ubban ammaneysati waanidi de7iyako guye simmishe xomoosi be7oos” yaagis. <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />Barnabaasi Marqoosa geetetiya Yohaanisa bantara efanaw koyis. <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" />Shin Phawuloosi Marqoosa bantara efanaw koybeenna. Gaasoyka, I Phinfilen shaaketidi entara oothanaw bibeenna.<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="ACT 13:13">Hawa 13:13</ref>.</char></note> <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />Enta giddon iita ooshshi keyin issoy issuwafe shaaketidosona. Barnabaasi Marqoosa ekidi markabera Qophiroosa bis. <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />Shin Phawuloosi Sillaase dooris; ammaneysati Phawuloosa Xoossa aadho keehatethas hadara immidaape guye, I keyidi bis. <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />Yaatidi, woosa keethata minthethishe Sooreranne Kilqiyara aadhis. <figure style="fig" alt="Paul's 2nd Journey" file="Paul2-BW.tif" size="span" loc="ACT 15:36—18:22" ref="15:36—18:22">Phawuloosi Wongela Sabbakanaw Bida Nam7antho Ogiya</figure><verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s1">Ximotiyoosi Phawuloosaranne Sillaasera Gahetis</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />Phawuloosi Darbenne Lisxira bis. Yan Ximotiyoosa geetetiya ammaniya asi de7ees. Iya aayiya ammaniya Ayhude maccasi, iya aaway Girike asi. <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />Lisxiraninne Iqoniyoonen de7iya ammaneysati Ximotiyoosaba loythidi markatidosona. <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />Phawuloosi Ximotiyoosa baara efanaw koydi, iya aaway Girike asi gididaysa he bessan de7iya Ayhude ubbay eriya gisho iya qaxaris. <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />Enti katamatara bishe Yerusalaamen de7iya hawaaretinne cimati wothida higgiya ammaneysati naagana mela entaw odishe aadhidosona. <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />Hessa gisho, woosa keethati ammanon minnishe, taybonka gallas gallas dari dari bidosona.<verse eid="ACT 16:5" /></para>
  <para style="s1">Phawuloosi Maqedoone Baanaw Xeegetis</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />Iisen qaala odonna mela Geeshsha Ayyaanay enta diggida gisho, Pirgeranne Galatiya biittara aadhidosona. <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />Enti Miise zawa gakida wode Bitaane baanaw koydosona. Shin Yesuusa Ayyaanay enta diggis. <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />Hessa gisho, enti Miise matara aadhishe Xiro7aada wodhidosona. <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />Phawuloosi qamma qoncethan issi Maqedoone asi baako, “Maqedoone pinnada nuna maaddarki” yaagishe eqidi woossishin be7is. <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />Qoncethaa I be7idaape guye ellesidi nuuni Maqedoone baanaw koyda. Ayis giiko, wongela yan de7iya asaas odanaw Xoossay nuna xeegidaysa erida.<verse eid="ACT 16:10" /></para>
  <para style="s1">Liidiya Kiristoosa Ammanasu</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />Xiro7aadape dendidi markaben gelidi Samotiraaqe bida, wontetha gallas Naaphule bida. <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />Yaape dendidi Maqedoone biittan de7iya Filphisiyuusa katama bida. Filphisiyuusi Roome asay de7iya katama. Nuuni he kataman guutha gallas uttida.<verse eid="ACT 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 16:13" />Sambaata gallas katamaape gaxan Shaafa doonan Ayhudeti Xoossaa woossiya bessi de7eysa eridi yaa bida. He bessan shiiqida maccasaas qaala odida.<verse eid="ACT 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 16:14" />Nuna si7iya asape issi Liidiya geetetiya Tiyatroona katamaape yida, Xoossaa ammanida zo7o afila zal7iya, maccasiya de7awusu. Phawuloosi odeysa iya si7ana mela Xoossay I wozanaa dooyis. <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />Liidiya ba soo asaara issife xammaqetidaape guye nuuko, “Hinte tana Godaa tuma ammanasu giiko ta soo yedhite” gada minthada woossasu.<verse eid="ACT 16:15" /></para>
  <para style="s1">Phawuloosinne Sillaasey Qashetidosona</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />Nuuni Xoossaa woossiya bessaa bishin iita ayyaanay I bolla de7idi marothiya issi geela7o gadhindoy nuura gahetasu. Iya kaayada daro miishe ba godatas ehawusu. <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />Phawuloosanne nuna kaallada, “Haysati Ubbaafe Bolla Xoossaa aylleta! Enti hinte attana oge odeyisata” gada waassasu.<verse eid="ACT 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 16:18" />Ubba gallas hessada gawusu. Shin Phawuloosi yilotidi guye simmidi, he ayyaana, “Yesuus Kiristoosa sunthan neeni iipe keya” gidi kiittis. Iiraka iita ayyaanay iipe keyi aggis.<verse eid="ACT 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 16:19" />Shin I godati bantaw miishe demmiya ogey dhayidaysa be7idi, Phawuloosanne Sillaase oykidi, dabaaba daynnata sinthe goochi efidosona. <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />Daynnata sinthe enta efidi, “Haysati Ayhude asi gidishe nu katamaa asaa daro waaysosona. <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />Nuuni Roome biitta asi gidishe ekanawunne oothanaw woga gidonnaba tamaarsoosona” yaagidosona.<verse eid="ACT 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 16:22" />Asay issi bagga gididi, Phawuloosa bollanne Sillaase bolla dendidosona. Daynnati enta ma7uwa qaaridi xam7an shocana mela kiittidosona. <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />Enta daro wadhidaape guye, qasho keethi gelsidosona. Qasho keethaa naageysika enta minthi naagana mela kiittidosona. <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />Qasho keethaa naageysi he kiita ekidi, Phawuloosanne Sillaase qasho keethas qol7a gelsis. Enta tohuwa duxis.<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />Shin giddi bilahe gidiya wode Phawuloosaranne Sillaasera woossishenne mazmure yexishe Xoossaa galatoosona. Qasho keethan de7iya hara asatika enti giyaba si7oosona. <figure style="fig" alt="Paul and Silas in stocks" file="LB00337B.tif" size="span" ref="16:25">Phawuloosinne Silaasey Duxetidi De7ishin</figure> <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />Qoponna qasho keetha baasoy qaaxana gakanaw biitta qaaxoy hanis. He saatenka penge ubbay dooyetis; qashetida asa ubbaa santhalaatay birsheti wodhis. <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />Qasho keethaa naageysi dhiskofe barkida wode qasho keethaa penge ubbay dooyetidaysa be7idi qasho asay kessi eki bidaba daanin bana wodhanaw mashshe ekis. <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />Shin Phawuloosi qaala dhoqu oothidi “Nu ubbay haysan de7iya gisho neeni nena qohopa” yaagis.<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />Qasho keethaa naageysi xompe woossi ekidi ellesidi gaathi woxis. Kokorishe Phawuloosa sinthaninne Sillaase sinthan gufannis. <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />Enta kare kessidi, “Ta godato, taani attanaw ay oothanaw bessii?” yaagis.<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />Phawuloosaranne Sillaasera iyako, “Godaa Yesuus Kiristoosa ammana; neeranne ne soo asaara attana” yaagidosona. <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />Enti iyasinne iya son de7iya ubbaas Godaa qaala odidosona. <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />Qamma he saatenka qasho keetha naageysi enta efidi enta madunthaa meeccis. Ellesidi ba soo asa ubbaara xammaqetis. <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />Phawuloosanne Sillaase ba soo efidi entaw kathi aathis. I ba soo asa ubbaara Xoossa ammanida gisho ufaytis.<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />Sa7i wontin daynnati, “He asata billa” yaagidi wotaadareta halaqata iyako kiittidosona. <verse eid="ACT 16:35" /><verse number="36" style="v" sid="ACT 16:36" />Qasho keetha naageysi, “Hinte biletana mela daynnati kiittidosona. Hiza, keyidi saro biite” yaagidi he kiita Phawuloosas odis.<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />Shin Phawuloosi, “Nuuni Roome asi<note caller="+" style="f"><char style="fr" closed="false">16:37 </char><char style="fqa" closed="false">Roome asi: </char><char style="ft" closed="false">Phawuloosi Roome asi yaagidi bana xeegiday he wode Ayhude biitta haarey Roome kawotethaa gidida gishosa. He wode Roome biittan de7iya asay pirdi bayna garaafetokona.</char></note> gidishin enti nuna pirdi bayna asaa sinthan wadhidi, qasho keethan yeggidosona. Ha77i nuna geeman keyidi boo goonna? Hanenna, enti banta huuphen yidi nuna kesso” yaagis.<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />Wotaadare halaqati daynnatas hessa odin, Phawuloosaranne Sillaasera Roome biitta ase gididaysa si7ida wode yayyidosona. <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />Hessa gisho, daynnati yidi entako, “Nuuni hintena qohida” gidoosona. Qasho keethafe kare enta kessidi, katamape keydi baana mela woossidosona. <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />Phawuloosaranne Sillaasera qasho keethafe keyidi Liidiya soo bidosona. Yan ammaneysatara gaketidi enta minthethidi keydi bidosona.<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s1">Phawuloosi Teselonqen</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />Phawuloosaranne Sillaasera Amfipholisaranne Apholonara aadhidi Teselonqe bidosona. Yan ayhude woosa keethi de7ees. <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />Phawuloosi kaseysada yaa gelis. Hessan heedzu saaminta Xoossaa qaalape asaas odis. <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />Kiristoosi waaye ekanawunne hayqope dendanaw besseysa entaw qoncisidi odishe, “Yesuusi ha taani hintew odeysi Kiristoosa” yaagis. <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />Entafe issoti issoti oday tuma gideysa ma7idi Phawuloosaranne Sillaasera issifidosona. Hessadaka, Xoossaa goyinniya daro Girike asaynne daro bonchetida maccasatika entara issifidosona.<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />Shin Ayhudeti qanaatidi issi issi oosoy bayna iita asata ogepe shiishidosona. Kataman buqethi kessidosona; Phawuloosanne Sillaase asaas aathidi immanaw koydi Yaasona keethaa teqidosona. <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />Phawuloosinne Sillaasey entaw bentonna ixin, Yaasonanne issi issi ammaneyisata katamaa halaqatako goochi efidi, “Haysati biitta ubbaa buqeysati ha77i nuuko yidosona. <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />Yaasoni enta ba son wothis. Haysati, ‘Yesuusa geetetiya hara kawoy de7ees’ gidi Qeesare kiitaa menthosona” yaagidi dhoqu gida qaalan odidosona.<verse eid="ACT 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 17:8" />Shiiqida asaynne katama halaqati hessa si7idi hananaba dhaydosona. <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />Halaqati Yaasonanne harata waasera billidosona.<verse eid="ACT 17:9" /></para>
  <para style="s1">Phawuloosi Beeriyan</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />Ammaneysati Phawuloosanne Sillaase qammara Beeriya yeddidosona. Beeriya gakidi, ayhude woosa keethi gelidosona. <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />Beeriya asay Teselonqe asaape aadhida suureta. Enti qaala kumetha wozanape ekidosona; Phawuloosi gidaysi tuma gideysa shaaki eranaw gallas gallas Geeshsha Maxaafata pilgoosona. <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />Hessa gisho, entafe daroti, Giriketapeka bonchetida daro maccasatinne daro addeti ammanidosona.<verse eid="ACT 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 17:13" />Shin Teselonqen de7iya Ayhudeti Phawuloosi Xoossaa qaala Beeriyanka odidaysa si7ida wode Beeriya yidi asaa buqidosona. <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />Hessafe guye, ammaneysati ellesidi Phawuloosa abba mati yeddidosona. Shin Sillaaseynne Ximotiyoosi Beeriyan attidosona. <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />Phawuloosa moyzida asati Ateena gathidosona. He asati Sillaaseynne Ximotiyoosi bantaw danda7etida mela ellesidi baako yaana mela Phawuloosi kiitida kiita ekidi Beeriya simmidosona.<verse eid="ACT 17:15" /></para>
  <para style="s1">Phawuloosi Ateenan</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />Phawuloosi Ateenan Sillaasenne Ximotiyoosa naagishe, kataman eeqi kumidaysa be7idi yilotis. <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />Hessa gisho, ayhude woosa keethan Ayhudetaranne Xoossa goyinniya Ayhude gidonna asaara qassi baara gahetiya asaara ubba gallas palamees. <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />Epiqoroosenne Istoyke geetetiya cugatape issi issi eranchoti Phawuloosara palamidosona. Entafe issoti issoti, “Ha yooyamay ay odanaw koyii?” yaagidosona.</para>
  <para style="p" vid="ACT 17:18">Harati Phawuloosi Yesuusabaanne hayqope I dendidaysa bantaw odida gisho, “Ooratha xoossataba odiya daanees” yaagidosona.<verse eid="ACT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 17:19" />Phawuloosa oykidi Ariyospagoosa geetetiya shiiqo bessaa efidi, “Ha neeni tamaarsiya oorathabay aybeko nuna erisikii? <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />Ayis giiko, neeni nuus oorathaba odaasa; hiza hessi aybeko nuuni eranaw koyoos” yaagidosona. <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />Ateena asa ubbaynne yan de7iya imatha asay oorathaba odetonanne si7onna pee7okona.<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />Phawuloosi Ariyospagoosa sinthan eqidi, “Ateena asato, xoossatas ubbaban hinte daro yayyeysa taani be7ayis. <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />Taani hinte katamaara yuuyashe hinte goyinniya bessata be7iya wode, ‘Eretonna Xoossaas’ geetetidi xaafetida yarsho bessa demmas. Ha hinte eronnashin goyinneysa taani hintew odayis. <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" />Sa7anne sa7an de7iya ubbaba medhida Xoossay, salonne sa7a Goday, asi keexida keethan deenna.<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="1KI 8:27">1 Kawo 8:27</ref>; <ref loc="ISA 42:5">Isa 42:5</ref>; <ref loc="ACT 7:48">Hawa 7:48</ref>.</char></note> <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />I de7o, shemponne ubbaba asa ubbaas immiya gisho paci de7iya asada asa maade koyenna. <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />Xoossay asa koche ubbaa issi addiyafe medhidi biitta ubban wothis. Yaatidi enti daana wodiyasinne bessaas zawa immis. <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />I hessa oothiday asi iya koyana melanne pilgidi demmana melasa. Hanikoka I nuupe geemmibeenna. <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />Hintefe issi issi yexeysati, ‘Nuuni iya nayta’ gidaysada, ‘Nuuni iyan paxa de7oos, qaaxoos.’ <verse eid="ACT 17:28" /><verse number="29" style="v" sid="ACT 17:29" />Hiza, nuuni Xoossaa nayta gidiya gisho, ‘Xoossay asa hiillatethaninne qofan worqafe woyko birape woyko shuchafe oosetidaba daanees’ yaagidi qopanaw bessenna. <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />Hessa gisho, Xoossay beni wode asay eronna oothidaysa aggidi aadhis. Shin ha77i ubba bessan de7iya asay nagarape simmana mela kiitees. <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />Ayis giiko, Xoossay ba doorida addiyan sa7an de7iya asa ubbaa bolla xillo pirda pirdanaw qamma giigisi wothis. Iya hayqope denthidi hessa asa ubbaas tumayis” yaagis.<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />Entafe issi issi asati hayqope dendoba Phawuloosape si7idi, iya bolla qelqisidosona. Shin harati, “Nuuni hessa neepe gujidi si7anaw koyoos” yaagidosona. <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />Hessa gisho, Phawuloosi enta giddofe keyis. <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />Shin issi issi addeti Phawuloosara gaketidi ammanidosona. Enta giddofe Ariyospagoosan shiiquwan de7iya Diyonasiyoosa geetetiya addey, Damarso geetetiya issi maccasiyanne harati de7oosona.<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s1">Phawuloosi Qorontoosan</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />Hessafe guye, Phawuloosi Ateenape keyidi, Qorontoosa bis. <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />Yan Phanxoosan yeletida issi Ayhude addiya Aqila demmis. Ayhude asa ubbay Roomepe keyana mela kawoy Qalawudiyoosi kiitida gisho guutha wodepe kase I ba mache Phirisqillara Xaalepe yis. Phawuloosi entara gahetanaw bis. <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />Iya oosoy entaysada dunkaane siko gidiya gisho, entara uttidi issife oothis. <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />Phawuloosi Sambaata ubban Ayhudetanne Giriketa ammanthanaw ayhude woosa keethan palamees.<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />Sillaaseynne Ximotiyoosi Maqedoonepe yida wode Phawuloosi ba kumetha wodiya immidi Ayhudetas Yesuusi I, Kiristoosa gidi qaala odis. <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />Shin enti Phawuloosa ixidi iya cayin Phawuloosi ba ma7uwape baana qoqofishe, “Hinte gomey hintena oyko; taani hessan de7ike. Hizape guye, taani Ayhude gidonna asaako bayis” yaagis.<verse eid="ACT 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 18:7" />Yaape keyidi Xoossaa goyinniya Titos Yosxoosa geetetiya uraa soo bis. Yosxoosa keethay ayhude woosa keetha matan de7ees. <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />Ayhude woosa keetha halaqay Qarisphoosi ba soo asa ubbaara Godaa ammanis. Qorontoosa asatapeka daroti Xoossaa qaala si7ida wode ammanidi xammaqetidosona.<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />Goday issi qamma Phawuloosas qoncidi, “Yayyofa; oda, si77i goopa. <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />Taani neera de7ayis. Taw ha kataman daro asi de7iya gisho nena qohidi iitaban yeggana asi oonika baawa” yaagis. <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />Hessa gisho, Phawuloosi Xoossaa qaala asaa tamaarsishe issi laythinne usupun ageena entara uttis.<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />Gaaliyoosi Akaya biitta aysiya wode Ayhudeti issife Phawuloosa bolla dendidi pirda keethi iya efidi, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />“Ha addey higgiya ixidi, asay Xoossaa goyinnana mela oothees” yaagidosona.<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />Phawuloosi odetana hanishin, Gaaliyoosi Ayhudetako, “Ayhudeto, hessi iita ooso woyko naaqo gidiyako taani hintebaa danda7ada si7anaw bessees. <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />Shin qaalas, sunthasinne hinte higgiyas hinte palamiyaba gidiko hinte, hintew billite; hessa taani pirdike” yaagis. <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />Yaatidi, enta pirda keethafe kare kessis. <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />Hessafe guye, Girike asa ubbay ayhude woosa keetha halaqaa Sosteneesa oykidi pirda keethaa sinthan wadhidosona. Shin Gaaliyoosi hessa paxaba gibeenna.<verse eid="ACT 18:17" /></para>
  <para style="s1">Phirisqilla, Aqilanne Aphiloosa</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />Phawuloosi daro gallas Qorontoosan uttidaape guye ammaniya asaa sarothidi, Phirisqilliranne Aqilara markaben Soore bis. Shin I baanape sinthe baw gasoy de7iya gisho Kinkire kataman ba huuphiya buluusetis.<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="NUM 6:18">Taybo 6:18</ref>.</char></note> <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />Enti Efesoona gakida wode Phawuloosi Phirisqillonne Aqila yan aggis. Shin baw ayhude woosa keethi gelidi Ayhudetara odetis. <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />Enti bantara daro wode uttana mela Phawuloosa woossidosona shin I ixis. <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />Entafe shaaketishe, “Taani yaa baaliya Yerusalaamen bonchanaw bessees. Shin Xoossi giiko hinteko simma yaana” yaagidi Efesoonape markabiyan bis. <verse eid="ACT 18:21" /><verse number="22" style="v" sid="ACT 18:22" />Qisaare gakida wode Yerusalaame bidi woosa keethaa asaa sarothidaape guye Anxooke bis.<verse eid="ACT 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 18:23" />Yan guutha wode gam7idaape guye ammaniya asata ubbaa minthethishe Galatiyaranne Pirgera aadhis.<verse eid="ACT 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />Iskindiren yeletida issi Aphiloosa geetetiya Ayhude asi Efesoona bis. I oda eriya asinne Xoossaa qaala daro eriya asi. <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />Godaa ogiyaka tamaaris, ayyaanan xuugetidi Yesuusaba suure tamaarsees. Gidoshin, Yohaanisa xinqatiya xalaala erees. <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />I ayhude woosa keethan yayyonna tamaarsees. Phirisqillanne Aqili I odeysa si7ida wode bantara soo iya efidi Xoossaa ogiya kaseysafe geeshshidi iyaw odidosona.<verse eid="ACT 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 18:27" />Aphiloosi Akaya baanaw koyin Efesoonan de7iya ammaniya asay iya qofaa ekidi Akayan de7iya ammaneysati iya mokana mela entaw dabdaabiya xaafidosona. I yaa gakida wode Xoossaa aadho keehatetha baggara Yesuus Kiristoosa ammanidaysata daro maaddis. <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />Ayis giiko, Yesuusi, I, Kiristoosa gideysa Ayhudetas Xoossaa qaalape qoncisidi deriya sinthan minthi odidi enta lathis. <figure style="fig" alt="Paul's 3rd Journey" file="Paul3-BW.tif" size="span" loc="ACT 18:23—21:17" ref="18:23—21:17">Phawuloosi Wongela Sabbakanaw Bida Heedzantho Ogiya</figure><verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s1">Phawuloosi Efesoonan</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />Aphiloosi Qorontoosan de7ishin, Phawuloosi qommo baggara aadhidi Efesoona bis. Yan issi issi ammaniya asata demmis. <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />Entako, “Hinte ammanida wode Geeshsha Ayyaana ekidetii?” yaagidi oychis.</para>
  <para style="p" vid="ACT 19:2">Enti, “Akay, ekibooko; hari attoshin, Geeshsha Ayyaani de7iyabaka si7ibooko” yaagidosona.<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />Phawuloosi entako, “Yaatin, aybin xammaqetidetii?” yaagis.</para>
  <para style="p" vid="ACT 19:3">Enti, “Nuuni Yohaanisa xinqaten xammaqetida” yaagidi zaaridosona.<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />Phawuloosi, “Yohaanisi baape guyera yaa Yesuus Kiristoosan asay ammanana mela asaas odishe, nagarape simo bessiya xinqaten xammaqis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="MAT 3:11">Maato 3:11</ref>; <ref loc="MRK 1:4">Mar 1:4</ref>, <ref loc="MRK 1:7-8">7-8</ref>; <ref loc="LUK 3:4">Luqa 3:4</ref>, <ref loc="LUK 3:16">16</ref>; <ref loc="JHN 1:26-27">Yoha 1:26-27</ref>.</char></note><verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />Enti hessa si7ida wode Godaa Yesuus Kiristoosa tamaare gidanaw xammaqetidosona. <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />Phawuloosi ba kushiya enta bolla wothida wode Geeshsha Ayyaanay enta bolla wodhin, dumma dumma doonan odetidosona; qassi tinbite odidosona. <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />He bessan tammanne nam7a gidiya asati de7oosona.<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />Phawuloosi ayhude woosa keethi gelidi, Xoossa kawotethaaba yayyonna palamishenne loythi qoncisishe entara heedzu ageena gakanaw gam7is. <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />Shin entafe issoti issoti dhube gididi daro asaa sinthan Godaa ogiya cayidi ammanonna ixidosona. Phawuloosi ammaneyisata entafe shaaki ekidi Xiranoosa geetetiya timirte keethan ubba gallas enta tamaarsis. <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />Phawuloosi nam7u laythi gakanaw qaala odis. Hessa gisho, Iisen de7iya asa ubbay, Ayhudetinne Ayhude gidonnaysati Godaa qaala si7idosona.<verse eid="ACT 19:10" /></para>
  <para style="s1">Asqewa Nayta</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />Xoossay Phawuloosa kushen wolqaama malaatata oothis. <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />Hessa gisho, asay iya asatethaa bochida maarabe woyko ma7o harganchotas efoosona. Entika paxoosona; tuna ayyaanati entafe keyoosona.<verse eid="ACT 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 19:13" />Tuna ayyaanata kessishe yuuyiya Ayhudetape issoti issoti, “Phawuloosi sabbakiya Yesuusa sunthan keyite gidi hintena kiittoos” yaagidi, tuna ayyaanati oykida asaa bolla Godaa Yesuusa sunthaa xeegidosona. <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />Kahine halaqaa Asqewa geetetiya issi Ayhude addiyas hessa oothiya laapun nayti de7oosona.<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />Shin tuna ayyaanay entako, “Taani Yesuusaka Phawuloosaka erayis, shin hinte oonantee?” yaagis.<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />Tuna ayyaani oykida addey enta bolla gupi wodhidi, enta madunxisidi, he keethafe kallo baqatana gakanaw wolqaamis. <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />Efesoonan de7iya Ayhudetinne Ayhude gidonnaysati ubbay hessa si7idi daro yayyidosona. Godaa Yesuusa sunthay daro bonchetis. <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />Ammaneysatape daroti banta oothida iita oosuwa paaxishenne qoncen odishe yoosona. <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />Marotape daroti banta maxaafata shiishidi asa ubbaa sinthan xuuggidosona. He maxaafata gatiya tayboy ishatamu mukulu bira santime<note caller="+" style="f"><char style="fr" closed="false">19:19 </char><char style="fqa" closed="false">Bira santime: </char><char style="xt" closed="false"><ref loc="MAT 26:15">Maato 26:15</ref> </char><char style="ft" closed="false">xeellite.</char></note> gidis. <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />Hessada hanidi Xoossa qaalay diccishenne dalgishe bis.<verse eid="ACT 19:20" /></para>
  <para style="s1">Efesoonan Ooshshi Keyis</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />Hessi hanidaape guye Phawuloosi, “Taani Yerusalaame ba simmada Roome baanaw bessees” yaagidi Maqedooneranne Akayara aadhidi Yerusalaame baanaw qofa qachis. <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />Qassi bana maaddeysatape nam7ata Ximotiyoosanne Erasxoosa Maqedoone kiittidi, baw Iisen guutha wode gam7is.<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />He wode Godaa ogiya gisho Efesoonan wolqaama kachi keyis. <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />Issi bira oothiya Dimexiroosa geetetiya uray Arxemisi eeqa keetha misiliya birape oothidi daro wodhe demmees. <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />Hessa gisho, hessa mela ooso ootheyisata issife shiishidi, “Asaw, nu duretethay ha oosuwan gideysa hinte ereeta. <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />Haysi Phawuloosi, ‘Asa kushen oosetidaysati xoossata gidokona’ yaagidi, Efesoonaninne guutha biittatape attishin, kumetha Iise ubban de7iya daro asaa odi ammanthidaysanne balethidaysa hinte be7idetanne si7ideta. <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />Meto gididay, nu oosoy kadheteysa xalaala gidonashin, Iisenne biitta ubban de7iya asi goyinniya gita xoosse Arxemisi keethay bonchetonna atteysanne I gitatethay kundanaysa” yaagis.<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />Asay hessa si7ida wode shenen xuugetidi, “Efesoona Arxemisa gita” yaagidi waassidosona. <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />He waasoy katama ubbaa gakis. Phawuloosara hemetiya Maqedoone asata, Gaayoosanne Arxirokoosa oykidi goochishe kaassa bessaa woxidosona. <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />Phawuloosi asay shiiqida bessa gelanaw koyis, shin ammaneysati iya diggidosona. <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />Iise biitta halaqatape Phawuloosa lagge gidida issoti issoti Phawuloosako kiittidi, “Kaassa bessa qoncen keyada bentofa” gidi iya woossidosona.<verse eid="ACT 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 19:32" />Shiiqida asaas hananabay dhayis; dariya bagga asay hari attoshin ayis shiiqidako eronna gisho, issoy issibas waassiya wode hankoy harabas waassees. <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />Ayhudeti Iskindire geetetiya addiya aathidi bessin, issi issi asay I gaanaba odidi iya sinthe aathidosona. I asay si77i gaana mela ba kushen malli bessidi, asaas mootetanaw eqis. <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />Shin Iskindirey Ayhude asi gididaysa asay erida wode nam7u saate gidanaysa mela ubbay issi qaalan, “Efesoona Arxemisa gita” yaagidi waassidosona.<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />Wursethan, katamaa xaafey asaa si77i oothidi, “Efesoona asaw, Efesoona katamay gita Arxemisi eeqa keethinne salope wodhida I shucha misiliya naagey Efesoona asaa gideysa eronnay oonee? <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />Haysa kashi giya asi bayna gisho, hinte si77i gaanawunne dirgidi ayko oothonna agganaw bessees. <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />Hinte, ha asata eeqa keetha miishe kaysotonashin woyko nu xoossata cayiboonashin coo ha asata oykidi ehideta. <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />Hessa gisho, Dimexiroosinne iyara de7iya oosanchoti asaa mootanaw koyko, pirda keethay dooya de7ees; daynnatika de7oosona; enti mootanaw danda7oosona. <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />Shin hinte hara oda koyko, Shango shiiqon oday be7eto. <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />Hessa gidonna ixiko hachi hanidabaas Roome kawotethay nuna oychana. Ha buqethaas gaasoy bayna gisho, nuuni gaaso odanaw danda7oko” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />yaagidi shiiquwa laallis.<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s1">Phawuloosi Maqedooneninne Giriken</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />Waasoy dochidaape guye, Phawuloosi ammaniya asata xeegisidi enta zoridaape guye, sarothidi Maqedoone baanaw keyis. <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />He biittara aadhishe qaala odishe asaa daro minthethidaape guye Girike biitta bis. <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />I yan heedzu ageena uttidi, markabera Soore baanaw qopidi de7ishin, Ayhudeti bana wodhanaw koyeysa eridi Maqedoonera guye simmanaw koyis.<verse eid="ACT 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 20:4" />Phawuloosa moyzidaysati Beeriyape Pharhusa na7aa Sophaxiroosa, Teselonqefe Arsxirokoosanne Sikonduusa, Darbefe Gaayoosa, Iisepe Tikiqoosa, Xirofmoosanne Ximotiyoosa. <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />Hessati sinthe bidi nuna Xiro7aadan naagoosona. <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />Nuuni Uytha Baaliya bonchidaape guye, Filphisiyuusape markabera dendidi, ichashantho gallasan enta Xiro7aadan gakidi yan laapun gallas gam7ida.<verse eid="ACT 20:6" /></para>
  <para style="s1">Phawuloosi Xiro7aadan</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />Saamintafe koyro gallasan nuuni uythaa menthanaw shiiqidi de7ishin, Phawuloosi wontethe baanaw qopida gisho, entaw qaala odishe giddi bilahe gakanaw odaa adussis. <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />Nuuni shiiqidi uttida pooqiyan daro poo7oy de7ees. <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />Ewuxikoosa geetetiya issi na7atethay maskoote bolla uttidi, baana dogidi dhiskis. Phawuloosi oda adussida wode Ewuxikoosi dhisko eeyidi heedzantho pooqiyape kundidi hayqidaysa asay denthis. <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />Shin Phawuloosi wodhidi, iya bolla gufannis. Iya idimmidi, “I hayqibeenna, hirgofite” yaagis. <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />Hessafe guye, pude pooqiya bolla keyidi uythaa menthidi mis. Sa7ay wontana gakanaw asaas odidaape guye dendidi bis. <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />He paxida na7atetha soo efidi daro ufaytidosona.<verse eid="ACT 20:12" /></para>
  <para style="s1">Phawuloosi Efesoonape Moyzetis</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />Shin Phawuloosi bana yaape mokana mela nuus odida gisho, kasetidi markabiyako bidi, Asoosa baanaw dendida. Ayis giiko, I tohon baanaw qopida gisho nuna hessatho kiittis. <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />I nuura Asoosan gahetin markabiyan iya ekidi Mixiline bida. <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />Wontetha gallas yaape dendidi markaben Kiyoosa sinthan de7iya bessaa gakida; qassi wontetha gallas Saamosa pinnidi kaalliya gallas Milixe gakida. <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />Phawuloosi Iisen daro gam7onna Efesoona matara aadhanaw qopis. Baw danda7etiko Phanxeqosxe Baaliya gallas Yerusalaame gakanaw eesotees.<verse eid="ACT 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />Phawuloosi Milixepe Efesoona kiittidi woosa keethaa cimata xeegisis. <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />Woosa keetha cimati iyako yin, entako haysada yaagis: “Taani Iise gelida koyro gallasape doomida hintera de7ida wode ubban waana de7idaako hinte ereeta. <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />Ayhudeti duulatidi ta bolla meto gathikoka taani ashketethaninne daro afuthan Godaas oothas. <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />Dabaabanka hinte keethan keethan hintena tamaarsishe hintena maaddiyabape issibaaka pacisabike. <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />Taani Ayhudetasinne Ayhude gidonaysatas nagarape Xoossaako simmana melanne nu Godaa Yesuusa ammanana mela markatas.<verse eid="ACT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 20:22" />“Yan tana aybi gakaneeko erike, shin ha77i taani Geeshsha Ayyaanas kiitetada Yerusalaame bayis. <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />Geeshsha Ayyaanay qashoynne waayey tana naageysa katama ubban taw markatis. <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" />Shin ta wothaa polanawunne Godaa Yesuus Kiristoosape ekida oosuwa, Xoossaa aadho keehatetha Wongela markateysa polanaw ta shempiw pathonnabada taybas.<note caller="-" style="x"><char style="xo" closed="false">20:24 </char><char style="xt" closed="false"><ref loc="2TI 4:7">2 Ximo 4:7</ref>.</char></note><verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />“Taani ha77ika Xoossaa kawotethaa markatashe hinte ubbaa giddon yuuyas. Hizape guye, hintefe oonika tana be7onnaysa erayis. <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />Hessa gisho, hintefe issi uray dhaykoka ta oyshetonnaysa hachi hintew geeshshada odayis. <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />Ayis giiko, Xoossay oothanaw qopidaba ubbaa hintew aybibaaka ashshona odas.<verse eid="ACT 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 20:28" />“Ba na7aa suuthan wozida Xoossaa woosa keethaa naagite. Geeshsha Ayyaanay hintena halaqaa oothidi doorida wudiyasinne hinte huuphiyas naagetite. <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />Taani bidaape guye, wudiyas qadhetonna wozana mino suudhumeti hinte giddo gelanaysa taani erayis. <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />Ammaneyisata banta geedo kaalethanaw wordo tamaarsiya asati hinte giddofe dendana. <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />Hessa gisho, taani heedzu laythi qammanne gallas afuthan hintena huuphen huuphen minthethidaysa qopishe naagetite.<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />“Ha77ika hintena minthanawunne geeshsha asaara laatisanaw danda7iya Xoossaasinne iya aadho keehatetha qaalas hintena hadara immayis.<verse eid="ACT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 20:33" />“Taani oodde bira woyko worqa woyko afila amottabike. <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />Taani ta kushen oothada tananne taara de7eyisata koshshidaba maaddidaysa hinte, hinte huuphen ereeta. <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />Hinte haysada daaburidi oothishe daaburanchota maaddanaysanne Godaa Yesuusi, ‘Ekeysafe immeysi anjetidaysa’ gida qaala hinte qopanaw besseysa taani hintena ubbaban bessaas” yaagis.<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />Phawuloosi hessa odi ongidi enta ubbaara gulbatidi Xoossaa woossis. <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />Enti ubbayka Phawuloosa idimmidi yeekidi yeeridosona. <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />I Zaaridi, “Tana be7eketa” yaagida qaalay enta daro azzanthis. Enti markabiya gakanaw iya moyzidosona.<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s1">Phawuloosi Yerusalaame Buussaa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />Nuuni Efesoona cimatape shaaketida mela Qoosa bida. Wontetha gallas Rooda gakidi yaape Phaxara bida. <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />Sirofinqe pinniya markabe demmidi iyan gelidi baanaw dendida. <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />Nuuni Qophiroosa be7anaw danda7iya soo yidi, Qophiroosa haddirsa bagga aggidi Soore bida. Markabey ba caana yan wothanaw koyida gisho Xiroosa bida. <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />Yan ammaniya asata demmidi entara laapun gallas uttida. Phawuloosi Yerusalaame boonna mela enti iyaw Ayyaanan odidosona. <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />Nuuni entara uttiya wodey wurin keyidi bida. Enti ubbay banta maccasataranne banta naytara issife katamaape kare kessidi nuna moyzidosona. Nuuni abba doonan gulbatidi Xoossaa woossida. <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />Hessafe guye, woli sarothidi nu markabiyan gelida; enti banta soo simmidosona.<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />Nuuni abba ogiya ongidi, Xiroosape Phaxelemaasa gakida. Yan ammaniya asata sarothidi, enta matan issi gallas pee7ida. <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" />Wontetha gallas keyidi, Qisaare bida. Sabaakiya Filphoosa soo gakidi iya matan uttida. I Yerusalaamen kase dooretida laapunatape issuwa.<note caller="-" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="ACT 6:5">Hawa 6:5</ref>; <ref loc="ACT 8:5">8:5</ref>.</char></note> <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />Filphoosas nabe gidida oyddu geela7o nayti de7oosona.<verse eid="ACT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 21:10" />Nuuni undenna gallas yan uttidi de7ishin tinbite odiya issi Agaboosa geetetiya addey Yihudape Qisaare yis.<note caller="-" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="ACT 11:28">Hawa 11:28</ref>.</char></note> <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />Nuuko yidi Phawuloosa saqiya ekidi ba kushiyanne ba tohuwa qachidi, “Geeshsha Ayyaanay ha saqiya godaa, Yerusalaamen Ayhudeti haysada qachidi, Ayhude gidonna asaas aathidi immana yaagees” yaagis.<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />Nuuni hessa si7ida wode nunne yan de7iya asati Phawuloosi Yerusalaame boonna mela woossida. <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />Shin Phawuloosi zaaridi, “Hinte haysada yeekishe ayis ta wozanaa shugiseetii? Taani, Godaa Yesuusa sunthaa gisho qashetetha xalaala gidonashin Yerusalaamen hayqanawuka giigetas” yaagis.<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />Nu zoriya I ekonna ixin, “Godaa sheney hano” yaagidi si77i gida.<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />Yan guutha wode gam7idaape guye giigetidi Yerusalaame baanaw keyida. <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />Qisaaren de7iya ammaniya asatape guuthati nuura bidosona. Enti nuuni shempana bessi Minaasona geetetiya Qophiroosa addiya soo efidosona. Minaasoni koyro ammanida asaape issuwa.<verse eid="ACT 21:16" /></para>
  <para style="s1">Phawuloosi Yerusalaame Gakis</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />Nuuni Yerusalaame gakida wode ammaniya asati nuna ufaysan mokidosona. <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />Wontetha gallas Phawuloosinne nuuni Yayqoobara gahetanaw bida. Woosa keethaa cimati ubbatika yan de7oosona. <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />Phawuloosi enta sarothidaape guye Ayhude gidonna asaa giddon ba baggara Xoossay oothidaba ubbaa entaw odis.<verse eid="ACT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 21:20" />Enti hessa si7ida wode Xoossaa galatidi Phawuloosako haysada yaagidosona: “Nu ishaw, Ayhudeta giddon aapun mukulati Xoossaa ammanidako ne be7aasa; enti ubbayka higgiya minthi naagoosona. <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />Neeni Ayhude gidonnayisata biittan de7iya Ayhude ubbay banta nayta qaxaronna mela, Ayhudeta wogaa kaallonna melanne Muse higgiya ixana mela neeni tamaarseysa Yerusalaamen de7iya Ayhudeti si7idosona. <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />Yaatin aybi lo77o? Neeni yidaysa daroti si7ana.<verse eid="ACT 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 21:23" />“Hessa gisho, nuuni new odeysa si7a; gasoy de7iya oyddu asati nu matan de7oosona.<note caller="-" style="x"><char style="xo" closed="false">21:23 </char><char style="xt" closed="false"><ref loc="NUM 6:13-21">Taybo 6:13-21</ref>.</char></note> <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />Enta ekada entara geeya; qassi enti banta huuphiya meedettana mela entaw miishe imma. Enti kase nebaa si7idaysi tuma gidonaysanne neeni ne huuphenka higge naagiya asi gideysa ubbay erana.<verse eid="ACT 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 21:25" />“Shin ammanida Ayhude gidonna asata gidiko, enti eeqas yarshetidaba moonna mela, suuthu uyonna mela, bawuta moonna melanne laymatonna mela, nuuni oda qachidi, entaw dabdaabe xaafida” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ACT 15:29">Hawa 15:29</ref>.</char></note><verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />Hessafe guye, Phawuloosi wontetha gallas asata ekidi, entara geeyis. I banta geeyiya gallasay awude poletiyako erisanawunne banta yarshuwa awude yarshaneko erisanaw Xoossa Keethi gelis.<verse eid="ACT 21:26" /></para>
  <para style="s1">Phawuloosi Oyketis</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />Laapun gallasay wurana hanishin, Iisepe yida Ayhudeti xoossa keethan Phawuloosa be7idi, asa ubbaa denthethidi Phawuloosa oykidosona. <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />“Isra7eele asaw, nuna maaddite; ha uray, nu deriya, nu higgiyanne ha Xoossa Keetha ixana mela asa ubbaa tamaarsees. Hessika gidonna ixin Ayhude gidonnayisata Xoossa Keethi gelsidi, ha geeshsha bessaa tunisis” yaagidi waassidosona. <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" />Enti hessa giday kase Efesoona Xirofmoosa Phawuloosara kataman be7ida gisho ha77i Phawuloosi Xoossa keethi iya eki gelidaba entaw daanis.<note caller="-" style="x"><char style="xo" closed="false">21:29 </char><char style="xt" closed="false"><ref loc="ACT 20:4">Hawa 20:4</ref>.</char></note><verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />Katama ubbay buqetis; asa ubbay shiiqidi Phawuloosa oykidi Xoossa Keethafe kare goochidosona. Xoossa Keethaa pengeti ellesidi gordetidosona. <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />Asay Phawuloosa wodhana hanishin, “Yerusalaame katamay kumethi buqetis” giya oday Roome shaalaqaako gakis. <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />Shaalaqay wotaadaretanne mato halaqata ekidi woxishe yis. Asay shaalaqaanne wotaadareta be7ida wode Phawuloosa wadheysa aggaagidosona.<verse eid="ACT 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 21:33" />He wode shaalaqay shiiqidi, Phawuloosa oykidi, nam7u santhalaatan qashetana mela kiittis. Yaatidi, I oonekonne ay oothidaako asaa oychis. <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />Asaape baggay issiba gidi waassiya wode, harati haraba gidi waassees. Waasoy darida gisho, shaalaqay tumaa shaakanaw danda7etonna ixin, wotaadareti Phawuloosa banta de7iyaso efana mela kiittis. <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />Phawuloosi yedhi keyiya dethaa gakiya wode asaa sugethaa gisho wotaadareti iya tookidosona. <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />Daro asay, “I hayqo!” yaagidi waassishe kaalloosona.<verse eid="ACT 21:36" /></para>
  <para style="s1">Phawuloosi Asaas Zaaro Immis</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />Wotaaddareti Phawuloosa banta de7iyasuwa gelsana hanishin, Phawuloosi shaalaqaako, “Taani new issiba odo?” yaagis.</para>
  <para style="p" vid="ACT 21:37">I Phawuloosako, “Neeni Girike doona eray? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />Neeni haysafe sinthe buqethi medhidi shempo wodhida oyddu mukulu asata ekidi bazzo gelida Gibxe uraa gidikii?” yaagis.<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />Shin Phawuloosi, “Taani, Kilqiyan de7iya eretida Tersesee kataman yeletida Ayhude asi. Hayyana tana odisarkii?” yaagis.<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />Shaalaqay iyako, “Oda” yaagin Phawuloosi dethaa bolla eqidi, asay si77i gaana mela ba kushiyan mallis. Asay si77i gin Ibraawetho doonan haysada yaagis:<verse eid="ACT 21:40" /></para>
  <para style="b" />
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“Ta ishato, ta aawato, taani ha77i hintew immiya zaaruwa si7ite.” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />Phawuloosi entaw Ibraawetho doonan odeysa si7idi kaseysafe aathidi si77i gidoosona. I kaallidi,<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />“Taani Kilqiyan de7iya Tersesee yeletada ha kataman diccas. Ta astamaareyka Gamaaliyale; taani nu aawata higgiya mintha tamaarida, hachi hinte ubbay haneysada Xoossas mishetiya Ayhude asi.<note caller="-" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="ACT 5:34-39">Hawa 5:34-39</ref>.</char></note> <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" />Taani ha ogiya kaalliya maccatanne addeta oykada qasho keethan yeggashenne enta wodhisana gakanaw waaye bessida asi.<note caller="-" style="x"><char style="xo" closed="false">22:4 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Hawa 8:3</ref>; <ref loc="ACT 26:9-11">26:9-11</ref>.</char></note> <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />Hessadaka, kahine halaqaynne Shango ubbay tabaa markatanaw danda7ees. Taani Damasqon de7iya enta ishatas entafe dabdaabiya ekada yan de7iya asati qashetidi seeretana mela Yerusalaame enta ehanaw yaa bas.<verse eid="ACT 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“Taani bada Damasqo matida wode seeta gallas qoponna salope gita poo7oy ta yuushuwan poo7is. <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />Taani sa7an kunda de7ishin, ‘Saa7ola, Saa7ola, tana ayis yedethay?’ giya qaala si7as. <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />Taani zaarada, ‘Godaw, neeni oonee?’ yaagas. I zaaridi, ‘Taani, neeni gooddiya Naazirete Yesuusa’ yaagis. <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />Taara de7eysati poo7uwa be7idosonape attishin, taw odeysa qaala akeekibokona.<verse eid="ACT 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 22:10" />“Taani, ‘Godaw, ta ay ootho?’ yaagas.</para>
  <para style="p" vid="ACT 22:10">“Goday taako, ‘Dendada Damasqo ba. Neeni oothana mela Xoossay oothanaw qopidaba ubbay yan new odetana’ yaagis. <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />He wolqaama poo7uwa gaason ta ayfey qooqin, taara de7iya asati ta kushiya oykidi, tana goochin Damasqo gakas.<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />“Damasqon de7iya Ayhude ubbay daro bonchiya issi Hananiya geetetiya addey, nu higgiya boncheysinne Xoossaa minthi woosseysi de7ees. <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />Hanaani taako yidi, ta matan eqidi, ‘Ta ishaw Saa7ola, xeella’ yaagis. Ellesada taani iya xeella aggas.<verse eid="ACT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 22:14" />“I taako, ‘Nu aawata Xoossay neeni iya sheniya erana mela, iya xillo Na7aa be7ana melanne iya doonape qaala si7ana mela kasetidi nena dooris. <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />Neeni be7idabaanne si7idaba asa ubbaa sinthan iyaw markatana. <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />Ha77i ayis gam7ay? Dendada xammaqeta; iya sunthaa xeegada ne nagaraape meeceta’ yaagis.<verse eid="ACT 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“Taani guye Yerusalaame simmada xoossa keethan woossishin, taw qoncethi bentis. <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />Qoncethan Goday taako, ‘Ne taw markatiya markatethaa asay ekonna gisho ellesada Yerusalaamepe keya’ yaagishin taani be7as.<verse eid="ACT 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 22:19" />“Taani, ‘Godaw, ayhude woosa keetha ubban nena ammaneyisata oykada wadhidaysanne qasho keethan yeggidaysa enti eroosona. <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" />Enti ne marka Isxifaanose wodhiya wode taani he odan issifas. Qassi enta matan eqada iya wodheyisata ma7uwa naagayis’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="ACT 7:58">Hawa 7:58</ref>.</char></note><verse eid="ACT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 22:21" />“Goday taako, ‘Taani nena Ayhude gidonna asaako haahoso kiittiya gisho dendada ba’ ” yaagis.<verse eid="ACT 22:21" /></para>
  <para style="s1">Phawuloosi Roome Asi</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />Phawuloosi he qaala odidi ongana gakanaw asay I geysa si7oosona. Hessafe guye, banta qaala dhoqu oothidi, “Haysa biittafe dhaysa! I daanaw bessenna” yaagidosona.<verse eid="ACT 22:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 22:23" />Enti wocamishin, banta ma7uwa bolla holishininne baana bolla laallishin; <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />Shaalaqay be7idi wotaadareti Phawuloosa banta de7iyasuwa efana mela kiittis. Qassi asay ayis hessada wocamidaako eranaw koyidi Phawuloosa lisson garaafidi pilgana mela enta kiittis. <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />Shin wotaadareti Phawuloosa dafon minthi qachidi garaafana haniya wode Phawuloosi ba matan eqida mato halaqaako, “Roome asi pirdi bayna garaafeysi hintew wogee?” yaagis.<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />Mato halaqay hessa si7ida wode shaalaqaako bidi, “Ha addey Roome asi. Neeni ay oothanaw qopay?” yaagidi oychis.<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />Shaalaqay Phawuloosako shiiqidi, “Neeni Roome asee? Ane taw oda” yaagis.</para>
  <para style="p" vid="ACT 22:27">Phawuloosi, “Ee” yaagis.<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />Shaalaqay zaaridi, “Taani ha gadetetha daro miishen shammas” yaagis.</para>
  <para style="p" vid="ACT 22:28">Shin Phawuloosi, “Ta ha gadetetha yeletethan demma ekas” yaagis.<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />Hessa gisho, Phawuloosa pilganaw qopidaysati iira iyape shaaketidosona. Shaalaqay Roome asi santhalaatan qachidaysa erida wode yayyis.<verse eid="ACT 22:29" /></para>
  <para style="s1">Phawuloosi Ayhude Shango Sinthan</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />Wontetha gallas Shaalaqay, Ayhudeti Phawuloosa ayis mootidaako geeshshi eranaw koyis. Kahine halaqatinne shangoy ubbay shiiqana mela kiittis; qassi Phawuloosa qashope bilisidi enta sinthan essis.<verse eid="ACT 22:30" /></para>
  <para style="b" />
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />Phawuloosi shiiquwa caddi xeellidi, “Ta ishato, taani hachi gakanaw Xoossaa sinthan ta de7o ubban lo77o wozanan de7as” yaagis. <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />Kahine halaqay Hanaani, Phawuloosa doonan baqana mela iya matan eqidaysata kiittis. <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" />He wode Phawuloosi iyako, “La ha booqinte tiyida godaa daaneyso, Xoossay nena baqana. Neeni ta bolla higgiyatho pirdanaw uttada de7ashe higgey bayna tana baqana mela kiitay?” yaagis.<note caller="-" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="MAT 23:27-28">Maato 23:27-28</ref>.</char></note><verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />Phawuloosa matan eqidaysati iyako, “Ne Xoossaa kahine halaqaa cayay?” yaagidosona.<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />Phawuloosi, “Ta ishato, I kahine halaqa gididaysa taani erabike; ayis giiko Xoossaa qaalan, ‘Ne deriya ayseysa bolla iita qaala haasayopa’ geetetidi xaafetis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="EXO 22:28">Kessa 22:28</ref>.</char></note><verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />Shin Phawuloosi he bessan de7iya asaape baggati Saduqaaweta, baggati Farsaaweta gideysa be7idi, “Ta ishato, taani Farsaawenne Farsaawe na7a; ‘Hayqidaysati hayqope dendana’ gada taani ufaysan naagiya gisho enti ta bolla pirdoosona” yaagidi odis.<note caller="-" style="x"><char style="xo" closed="false">23:6 </char><char style="xt" closed="false"><ref loc="ACT 26:5">Hawa 26:5</ref>; <ref loc="PHP 3:5">Filphi 3:5</ref>.</char></note><verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />Phawuloosi hessa gida wode Farsaaweta giddoninne Saduqaaweta giddon ooshshi keyin shaaketidosona. <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" />Ayis giiko, Saduqaaweti, “Hayqida asi dendenna; kiitanchoyka ayyaanika baawa” yaagosona. Shin Farsaaweti nam7ayka de7eysa ammanoosona.<note caller="-" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">Maato 22:23</ref>; <ref loc="MRK 12:18">Mar 12:18</ref>; <ref loc="LUK 20:27">Luqa 20:27</ref>.</char></note> <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />Gita kachi keyis; Farsaaweta bagga gidida higge astamaareti dendi eqidi, “Ha uraa bolla aybi balaka demmibooko; iyaw ayyaani woyko kiitanchoy haasayonna aggenna” yaagidi palamidosona.<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />Ooshshay darin asay Phawuloosa shaqerethonna mela gidi, shaalaqay ba wotaadareti wodhidi enta giddofe iya ellesi kessidi banta de7iyasuwa efana mela kiittis.<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />He qamma Goday Phawuloosa matan eqidi, “Phawuloosa, neeni taw Yerusalaamen markatidaysada Roomenka markatanaw bessees; minna; aykoy baawa” yaagis.<verse eid="ACT 23:11" /></para>
  <para style="s1">Phawuloosa Wodhanaw Maqetidosona</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />Wontetha gallas Ayhudeti, “Phawuloosa wodhonna de7ishe mooko uyoko” gidi caaqidosona. <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />Phawuloosa bolla hessa maqetida asati oytamape daroosona. <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />Enti kahine halaqatakonne deriya cimatako bidi, “Nuuni Phawuloosa wodhonna de7ishe kathi giyaba mooko gidi caaqetida. <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />Hiza, hintenne shangoy iyabaa geeshshidi pilgiyabay de7iya daanisidi, Phawuloosa hinteko ehana mela shaalaqa oychite. Nuuni I ha shiiquwa gakanaape sinthe iya wodhanaw giigidi uttida” yaagidosona.<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />Shin Phawuloosa miche na7ay he maquwa si7ida wode, bidi wotaadareti de7iyasuwa gelidi, Phawuloosas odis. <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />Phawuloosi mato halaqatape issuwa xeegidi, “Ha na7ay shaalaqas odiyabay de7iya gisho iya shaalaqaako efa” yaagis.<verse eid="ACT 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 23:18" />Mato halaqay na7aa shaalaqaako efidi, “Qasho keethan de7iya Phawuloosi tana baako xeegidi, ha na7ay new odiyabay de7iya gisho, iya neeko ehana mela tana woossis” yaagis.<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />Shaalaqay na7aa kushiya oykidi, dumma kare kessidi, “Neeni taw odanabay aybee?” yaagidi oychis.<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />Na7ay shaalaqaako, “Ayhudeti Phawuloosaba kasepe minthi pilganaw koydaba daanisidi neeni wonto iya shiiquwa ehana mela nena woossanaw zoreta qachidosona. <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />Shin neeni enti giyaba si7opa. Ayis giiko, oytamape dariya asati Phawuloosa wodhonna de7ishe ‘Kathi mooko, haathe uyoko’ gidi caaqetidi, qosetidi iya naagoosona. Ha77i ne giyaba xalaala si7anaw naagoosona” yaagis.<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />Shaalaqay zaaridi, “Ha oda ne taw odidaysa hara oodeska odopa” yaagidi kiittidi na7aa guye yeddis.<verse eid="ACT 23:22" /></para>
  <para style="s1">Phawuloosi Filkisa Sinthan</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />Shaalaqay mato halaqatape nam7ata xeegidi, “Qammafe heedzu saaten Qisaare baanaw, nam7u xeetu wotaadareta, laapun tammu para asatanne nam7u xeetu tooranchota giigisite. <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />Deriya aysiya Filkisako Phawuloosa saro gathanaw toga mehe giigisite” yaagidi enta kiittis. <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />Shaalaqay Filkisas haysada giya dabdaabe xaafis:<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />“Qalawudiyoosa Lusiyoosape deriya aysiya boncho Filkisas, saroy new gido. <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />Ayhudeti ha uraa oykidi wodhana hanishin, I Roome biitta asi gidoysa erada wotaadaretara gakada iya ashshas. <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />Enti iya ayis mootiyako eranaw koyada enta shiiquwan iya shiishas. <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />Enti banta higgiyas iya mootidaysafe attishin, iya wodhisiyaba woyko qashisiyaba gidonnaysa ta demmas. <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />Enti ha uraa bolla maqetida zigirsay tana gakin, taani ellesada iya neeko yeddas. Iya mooteysati ne sinthan bidi mootana mela kiittas” yaagis.<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />Hessa gisho, wotaadareti kiitetidaysada Phawuloosa ekidi, qamma Antiphaxirisa gathidosona. <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />Wontetha gallas para asati iyara baana mela oothidi toho asati guye simmidosona. <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />Togay Qisaare gakidi dabdaabiya deriya ayseysas immidi, Phawuloosa iya sinthe aathidosona. <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />Deriya ayseysi dabdaabiya nabbabidaape guye, “Phawuloosa, ne aw awuraja asee?” gidi iya oychis. I Kilqiya asi gidoysa erida wode, <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />“Taani nebaa nena mooteysati yaa wode si7ana” yaagis. Wotaaddareti Phawuloosa Herodiisa gadhon naagana mela kiittis.<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s1">Ayhudeti Phawuloosa Mootidosona</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />Ichashu gallasape guye kahine halaqay, Hanaani, cimataranne Xerxeluusa geetetiya issi xabaqaara Qisaare bis. Enti deriya ayseysa bolla Phawuloosa mootidosona. <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />Phawuloosi xeegetidi gelida wode, Xerxeluusi iya haysada yaagidi mootis:</para>
  <para style="p" vid="ACT 24:2">“Boncho Filkisa, nuuni ne baggara daro sarotethaa demmida, ne lo77o aysuwan nu biittay daro laametis. <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />Boncho Filkisa, nuuni awunka awude gidin daro galatan hessa ekoos. <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />Taani nena gam7isonashin neeni ne keehatethan nubaa qanthan si7ana mela nena woossayis. <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />Ha uray dhube gididi biitta ubban de7iya Ayhudeta giddon buqethi medhidi Naaziraweta bagga asaa kaaletheysa gidoysa erida. <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />Hari attoshin, Xoossa Keetha tunisana hanishin nuuni iya oykida; nu higgiyada iya bolla pirdanaw qopida. <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />Shin shaalaqa Lusiyoosi yidi, wolqan nu kushepe iya wothi ekis. <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />Iya mooteysati neeko yaana mela kiittis. Neeni ne huuphen ha uraa pilgada nuuni iya mootiya mootuwa ubbaa eranaw danda7aasa” yaagis.<verse eid="ACT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 24:9" />Ayhudetika, “Ha oday tuma” gidi iya qofaa ma7idosona.<verse eid="ACT 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />Deriya ayseysi Phawuloosa oda gidi mallis. Phawuloosi haysada gidi zaaris: “Neeni daro wodepe doomada, ha asaas pirdashe de7eysa erada ta odas ufaysan zaaro immayis. <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />Taani Yerusalaame goyinnanaw keyin tammanne nam7u gallasape aadhonaysa neeni ne huuphen eranaw danda7aasa. <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />Ayhudeti tana Xoossaa Keethan gidin ayhude woosa keethan gidin kataman gidin ooderaka palamishin woyko asa shiishada maqishin issi asika demmibeenna. <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />Ha77ika enti tana mootiyabas marka demmanaw danda7okona.<verse eid="ACT 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 24:14" />“Shin taani haysa issiba ammanayis; taani higgen de7iyabaanne nabeti xaafida ubbaba ammanada, nu aawata Xoossaa, enti wordo giya ogiyan goyinnayis. <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />Enti banta huuphen ammaneysa mela xillotinne nagaranchoti hayqope dendanaysa taka ammanayis. <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />Hessa gisho, taani Xoossaa sinthaninne asaa sinthan ubba wode lo77o kahi taw daana mela minnayis.<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />“Taani Yerusalaamepe keyoosape daro laythafe guye ta biitta manqotas maade immanawunne yarsho yarshanaw Yerusalaame bas.<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="ACT 21:17-28">Hawa 21:17-28</ref>.</char></note> <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />Taani xoossa keethan hessa oothada geeshsha wogaa pola simmin tana demmidosona. He wode taara asi baawa, ooshshika keybeenna. <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />Shin Iisepe yida issi issi Ayhudeti hessan de7oosona; enti ta bolla oda koyko yidi tana ne bolla mootanaw danda7oosona. <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />Woyko taani shanguwa sinthe shiiqida wode oothida bali de7iko haysati ne sinthan de7eysati odonna. <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" />Taani enta giddon eqada, ‘Hayqidaysati dendana gada waassada odida gisho hachi hinte sinthan ta bolla pirdoosona’ gas; hessafe haraba oothabike” yaagis.<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">Hawa 23:6</ref>.</char></note><verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />Shin Filkisi Xoossaa ogiyaba geeshshi erida gisho, “Taani hinte oda shaalaqa Lusiyoosi yaa wode pirdana” yaagidi moyzis. <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />Filkisi qassi Phawuloosa qachonna naagana melanne iya dabbotape oonika iya oychanaw yishin diggonna mela mato halaqaa kiittis.<verse eid="ACT 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />Guutha gallasape guye, Filkisi Ayhude bagga gidida ba mache Dirusillara yidi Phawuloosa kiiti ehisidi Yesuus Kiristoosan ammanoba iyape si7is. <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />Phawuloosi xillotethabaa, ba huuphe haarobaanne yaanaw de7iya pirdaba odishin, Filkisi yayyidi, “Neeni ha77is ba; taw injetida wode nena xeegisana” yaagis. <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />He wode Phawuloosape wodhaafe ekanaw qopidi, iya zaari zaari xeegisidi iyara odetees.<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />Nam7u laythafe guye, Filkisa bessaa Phorqiyoos Fisxoosi ekis. Filkisi Ayhudeta ufaysanaw koyidi Phawuloosa billonna aggaagis.<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s1">Phawuloosi Fisxoosa Sinthan</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />Fisxoosi kawotida heedzu gallasape guye Qisaarepe Yerusalaame bis. <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />Yan kahine halaqatinne Ayhudeta kaaletheysati Phawuloosa mootidosona. <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />Phawuloosa Yerusalaame ehishin ogen qosetidi iya wodhanaw entaw injetana mela bantana maaddo gidi Fisxoosa woossidosona. <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />Fisxoosi entako, “Phawuloosi, Qisaaren qasho keethan de7ees; taani ta huuphenka ellesada guye simmana hanayis. <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />I balidabay de7iko hinte giddon aawateysati taara Qisaare bidi iya mootona” yaagidi zaaris.<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />Fisxoosi enta matan hospun woyko tammu gallasa mela gam7idaape guye Qisaare bis. Wontetha gallas pirda oyden uttidi Phawuloosa ehana mela kiittis. <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />I yin Yerusalaamepe yida Ayhudeti iya yuushuwan eqidi enti lathanaw danda7onna daro deexo mooto iya bolla shiishidosona. <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />Phawuloosi zaaridi, “Taani Ayhude higgiya gidin Xoossa Keethaa woyko Roome Kawa Qeesare naaqabike” yaagis.<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />Shin Fisxoosi Ayhudeta ufaysanaw koyidi Phawuloosako, “Yerusalaame bada ha mootuwaba yan ta sinthan pirdetanaw koyay?” yaagidi oychis.<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />Shin Phawuloosi, “Taani pirdetanaw bessiya Qeesare pirda keethan eqa kichas. Neeni loytha ereysada taani Ayhudeta aybinka naaqabike. <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />Hiza, taani naaqidabay woyko hayqos gathiyaba oothidaba gidiko hayqope tana ashsha giike. Shin enti tana mootiya mootoy mela gididaape guye oonika tana entaw aathidi immanaw danda7enna. Qeesarey tabaa pirdo gada oychayis” yaagis.<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />He wode Fisxoosi ba zoranchotara zoretidi, “Neeni Qeesarey tabaa pirdo gada oychadasa; Qeesareko baasa” yaagidi zaaris.<verse eid="ACT 25:12" /></para>
  <para style="s1">Phawuloosi Agirphanne Barniqe Sinthan</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />Guutha gallasape guye Kawoy Agirphinne Barniqey Fisxoosa sarothanaw Qisaare bidosona. <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />Yan enti daro gallas gam7in, Fisxoosi Kawas Phawuloosaba haysada yaagidi odis; “Filkisi billonna aggidi bida issi addey haysan de7ees. <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />Taani Yerusalaame bida wode kahine halaqatinne Ayhude cimati iya bolla pirdana mela tana woossidi iyabaa taw odidosona. <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />Taani, ‘Mootetida uray bana mooteyisata sinthan eqidi ba mootidabaas zaaro immonnashin, oona gidikoka aadhidi imeteysi Roome higge gidenna’ yaagada entaw zaaras.<verse eid="ACT 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 25:17" />“Hessa gisho, enti haysan shiiqida wode taani gam7onna wontetha gallas pirda keethaa gelada Phawuloosa ehana mela kiittas. <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />Iya mooteysati iya matan eqidi, iitaban iya mootonna aggokona gada taani qopidaysa mela iya mootibookona. <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />Shin enti banta haymaanotebanne Phawuloosi, ‘Paxa de7ees’ giya issi hayqida Yesuusa geetetiya addiyaba iyara palamoosona. <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />Ha oday tana shaakanaw metida gisho, Phawuloosi Yerusalaame bidi, yan pirdetanaw koyaako gada iya oychas. <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />Shin Phawuloosi ba oda Qeesarey iyabaa be7ana gakanaw qasho keethan gam7anaw oychis. Taani iya Qeesareko yeddana gakanaw I qashetana mela kiittas” yaagis.<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />Hessa gisho, Agirphi Fisxoosako, “Taani ta huuphenka he uray giyaba si7anaw koyayis” yaagis.</para>
  <para style="p" vid="ACT 25:22">Fisxoosi iyako, “Neeni wonto I giyaba si7ana” yaagis.<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />Wontetha gallas Agirphinne Barniqey gita bonchon shaalaqataranne kataman de7iya gita asatara yidi pirda keethi gelidosona. Fisxoosi Phawuloosa xeegisidi ehis. <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />Fisxoosi, “Kawaw Agirpha, haysan nuura de7iya asaw, Ayhudeti Yerusalaamenka haysanka waassidi, ‘I hizape guye paxa daanaw bessenna’ yaagidi, tana woossida uraa haysa be7eeta. <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />Shin iya hayqos gathiyaba aybibaaka taani demmabike. I ba huuphen, ‘Qeesarey tabaa pirdo yaagada oychayis’ gida gisho, Qeesareko iya yeddanaw qofa qachas. <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />Taani iyabaa ta godaa Qeesares xaafanaw gidiya gaasoy aybika baawa. Hessa gisho, iyabaa hinte be7iko ta xaafiyabay bentaneko gada hinte sinthe ubbaraka Kawaw, Agirpha, ne sinthe iya ehas. <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />Ayis giiko, qashetida asi bolla daynnas aathiya wode I ayis mootetidaako qoncisonna aggeysi taw eeyatethi daanees” yaagis.<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s1">Phawuloosa Zaaruwa</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />Agirphi Phawuloosako, “Neeni nebaa odanaw danda7aasa” yaagis. He wode Phawuloosi ba kushiya denthidi haysada yaagis:<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />“Kawaw, Agirpha, Ayhudeti tana mootidabaas zaaro immanaw hachi ne sinthan eqashe ta qaaday lo77o gada qopayis. <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />Neeni Ayhude woganne palama loythada eriya gisho tana saletonna si7ana mela nena woossayis.<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />“Taani na7atethafe doomada ta asaa giddoninne Yerusalaamen de7ida ta de7uwa Ayhude ubbay eroosona. <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" />Taani koyrope doomada, nu haymaanote higgiya minthidi naagiya Farsaaweta yaraape gideysa enti markatanaw koyko eroosona.<note caller="-" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">Hawa 23:6</ref>; <ref loc="PHP 3:5">Filphi 3:5</ref>.</char></note> <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />Ha77ika taani Xoossay nu aawatas immana gida ufaysaa naagiya gisho mootetada haysan eqas. <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />Qassi tammanne nam7u nu aawata sheeshay Xoossaa qammanne gallas minthidi goyinnishe Xoossay immana gidaysa ekanaw ufaysan naagoosona. Kawaw Agirpha, Ayhudeti tana mootey taani ufaysan hessa naagiya gishosa. <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />Ayhudeto, Xoossay hayqidaysata dentheysa ayis ammaneketii?<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />“Kase taani ta huuphenka Naazirete Yesuusa sunthaa teqanaw danda7etidaba ubbaa oothanaw bessees gada qopas.<note caller="-" style="x"><char style="xo" closed="false">26:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Hawa 8:3</ref>; <ref loc="ACT 22:4-5">22:4-5</ref>.</char></note> <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />Taani Yerusalaamen oothiday haysa. Kahine halaqatape maata ekada Xoossaa asatape darota qashisas. Enta wodhiya wodeka enta hayquwa dosas. <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />Daro wode ayhude woosa keethaa ubban enti seeretana melanne Yesuusa cayidi kaddana mela un7ethas. Taani wogi bayna enta hanqetada hari attoshin, hara biitta katamata gakanaw enta gooddas.<verse eid="ACT 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />“Taani ha odas kahine halaqatape maatanne kiitaa ekada Damasqo bayis. <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />Kawaw, taani seeta gallas ogen de7ishin awa poo7ope daro aadhiya poo7oy ta yuushuwaninne taara beyisata yuushuwan salope poo7is. <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />Nuuni ubbayka sa7an kundida wode Ibraawetho doonan, ‘Saa7ola, Saa7ola, tana ayis goodday? Neeni, nena caddiya birata xam7a qakiko nena qohaasa’ yaagidi taw odishin si7as.<verse eid="ACT 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 26:15" />“Taani, ‘Godaw, neeni oonee?’ yaagas.</para>
  <para style="p" vid="ACT 26:15">“Goday, ‘Taani, neeni gooddiya Yesuusa; <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />shin denda eqa. Hachi neeni tana be7idaysaninne sinthafe ta new bessanaysa haratas markatana mela ta oosancho oothada nena shuumanaw new bentas. <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />Isra7eele asatapenne taani nena entako kiittiya Ayhude gidonaysatape nena ashshana. <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />Neeni enta ayfiya dooyana, dhumape poo7oko, Xalahe kushepe Xoossako enta zaarana. Enti tanan ammanidi nagara atotetha ekana. Xoossay doorida asaa giddon banta laata demmana’ yaagis.<verse eid="ACT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“Kawaw Agirpha, hessa gisho, taw salope bentida qoncethas kiitetanaysa ixabike. <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" />Shin taani koyrottada Damasqon hessafe guye Yerusalaameninne Yihuda biitta ubban de7eysatinne Ayhude gidonnaysati banta nagaraape Xoossaako simmana melanne nagaraape simuwa bessiya ooso oothana mela qaala odas.<note caller="-" style="x"><char style="xo" closed="false">26:20 </char><char style="xt" closed="false"><ref loc="ACT 9:20">Hawa 9:20</ref>, <ref loc="ACT 9:28-29">28-29</ref>.</char></note> <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />Hessa gisho, Ayhudeti tana xoossa keethan oykidi wodhanaw koydosona. <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />Hachi gakanaw Xoossaa maadey taape shaaketibeenna; yaaniya gisho, guuthaasinne gitaas markatashe haysan eqas. Nabetinne Musey hanana gidi odidaysafe haraa issibaaka taani odidabay baawa. <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" />Hessika, ‘Kiristoosi waaye ekanaw bessees; qassi hayqope koyro dendidi Ayhudetasinne Ayhude gidonaysatas atotetha poo7o odanaw bessees’ gidaysa” yaagis.<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />Phawuloosi hessa yaagidi zaarishin, Fisxoosi ba qaala dhoqu oothidi, “Phawuloosa, ne gooyadasa; ne daro timirtey nena gooshshatethas gathis” yaagis.<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />Shin Phawuloosi, “Boncho Fisxoosa, taani tumabaanne bessiyaba odaysipe attishin, gooyabike. <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />Taani qoncen odiya odaa Kawoy erees. Ha oday geeman oosetiboonna gisho issoyka iyape geemmonaysa taani geeshshada erayis.<verse eid="ACT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 26:27" />“Kawaw Agirpha, neeni nabeta ammanaasa gidikii? Neeni ammaneysa taani erayis” yaagis.<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />Kawoy Agirphi, Phawuloosako, “Ha guutha saaten tana kiristaane oothanaw koyay?” yaagis.<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />Phawuloosi, “Daro wode gidin guutha wode ne xalaala gidonashin hachi tana si7iya ubbay ha qashuwape attishin, ta mela gidana mela Xoossaa woossayis” yaagis.<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />Hessafe guye, Kawoy Fisxoosi, Barniqeynne entara uttida ubbayka dendidosona. <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />Yaape keyidi bishe issoy issuwara, “Ha uray hayqos woyko qashos gathiyaba aykoka oothibeenna” yaagidi odetidosona. <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />Agirphi Fisxoosako, “Ha uray ‘Qeesarey tabaa pirdo’ goonnako biletanaw danda7ees shin” yaagis.<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s1">Phawuloosi Roome Bis</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />Nuuni markaben Xaale baanaw qachida wode Awugisxoosa wotaadareta geeteteysatape issi Yuuliyoosa geetetiya mato halaqaas Phawuloosanne hara guutha qasho asata aathidi iyaw immidosona. <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />Iise gaxan de7iya biittata biya Adramixiyoone markaben gelidi dendida. Maqedoone asi gidida Teselonqe Arsxirokoosi nuura de7ees.<verse eid="ACT 27:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 27:3" />Wontetha gallas nuuni Sidoona gakishin, Yuuliyoosi Phawuloosas keehidi ba laggetako bidi koshshiyaban maaddana mela entako iya yeddis. <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />Yaape dendidi sinthara nu bolla carkiya gisho haathan teqetida biitta, Qophiroosan zempidi aadhida. <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />Kilqiyanne Phinfile matan de7iya abba pinnidi Liiqen de7iya Mura gakida. <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />Yan mato halaqay Xaale biya Iskindire markabe demmidi, iyan nuna gelsis.<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />Nuuni daro gallas loddara bidi, daro meton Qandoosa katama mati gakida. Yaara baanaw nuna carkoy diggin Salmonara aadhidi haathan teqetida biitta, Qarxeesan zempidi aadhida. <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />Daro meton gaxa gaxa oykidi Laasa katamaa matan de7iya abba doonan “Markabey Wopu Gidi Shempiya bessi” geetetiya bessa gakida.<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />Nuuni yan daro wode gam7idaape guye xoomi biletida gisho hizape markaben buussi metiya gisho Phawuloosi enta zoris. <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />“Asaw, nu buussan gita boshinne daro qohoy de7eysi taw bentees; qohoy caana bollanne markabiya bolla xalaala gidonashin nu de7uwa bollaka gakana” yaagis. <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />Shin mato halaqay Phawuloosi gidaysafe aathidi markabiya laaggeysinne markabiya goday geysan ammanis. <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />He abba doonan de7iya katamay balgo ageena aathanaw entaw injetonna gisho, dariya asati bantaw danda7etiko Finqe katamaa gakidi balgo ageena yan aathanaw zoretidosona. Finqey pudeha-wulohapenne dugeha-wulohape giddon abba doonan de7iya katama.<verse eid="ACT 27:12" /></para>
  <para style="s1">Abba Bolla Gotey Dendis</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />Kawusha dugeha carkoy loddara carkida wode banta qopidaysada hanidaba entaw daanin dendidi, markabey qaaxonna mela oykiya birata pude ekidi Qarxeesa matara aadhidosona. <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />Shin daro gam7onna “Awuraqis” geetetiya wolqaama gotey haathan teqetida biittafe duge enta bolla dendis. <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />He gotey markabiya sugidi efonna diggida gisho carkoy markabiya ba dosida soo efis.<verse eid="ACT 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 27:16" />Nuuni yuushoy abban teqetida biitta, Qeedan zempidi bishe daro metootetidi markabiya wogoluwa ashshanaw danda7ida. <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />Enti wogoluwa pude kessidaape guye wodoruwan markabiya bolla xaaxidi, minthi qachidosona. Surtisa geetetiya shafiyan bantana dom7ethana gidi hirgidi, markabiya sharaa wodhisidi markabiya coo yeddi aggidosona.<verse eid="ACT 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 27:18" />Gotey wolqaamishe bin wontetha gallas caanaape baggaa abban holo oykidosona. <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />Heedzantho gallas markabiya miishiya ekidi banta kushen holidosona. <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />Nuuni daro gallas awa ayfenne xoolinto be7onna gishonne wolqaama uushoy nu bolla uushida gisho sinthafe nuuni shempora attana gidi qopibooko.<verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />He wode enti daro gallas kathi moonna gam7ida gisho Phawuloosi enta giddon dendi eqidi, “Asaw, hinte ta zoriya ekidi Qarxeesape dendonna aggidako ha metoynne qohoy nuna gakenna. <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />Shin taani hintena yayyofite gada zorayis; ayis giiko, ha markabey dhayanape attishin, hintefe issi asa shempoyka dhayenna. <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />Zine qamma ta iyabaa gididaysinne ta goyinniya Xoossay kiitida kiitanchoy ta matan eqidi, <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />‘Phawuloosa, yayyofa; neeni Roome biitta Kawa Qeesare sinthan eqanaw bessees. Heko Xoossay ne gisho neera biya asa ubbaa shempuwa ashshis’ yaagis. <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />Hessa gisho, asaw, yayyofite. He kiitanchoy taw odidaysi hananaysa taani ammanayis. <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />Shin carkoy nuna efidi issi yuushoy abban teqetida biitta gaxan holana” yaagis.<verse eid="ACT 27:26" /></para>
  <para style="s1">Markabey Meqis</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />Tammanne oyddantho qamman Adire Abban nuna carkoy gedenne haa sugishin, gidi bilahe gidiya wode markabiyan ootheysatas biittako matidaba daanis. <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />Enti ciimmotetha eranaw koyidi wodoro xeeran deexiyaba qachidi abban yeggin, abbay hospun tammu wadha gidis. Guuthi gam7idi, zaari yeggin usupun tammu wadha gidis. <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />Enti abba gaxan de7iya shuchan dom7etona mela yayyidi, markabey boonna mela oykiya oyddu biratata markabiyape guyera abban yeggidi, sa7i wontana mela Xoossaa woossosona. <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />Markabiyan ootheysati markabiyape baqatanaw koyidi, markabey boonna mela oykiya biratata markabiyape sintha baggara abban yeggiya daanin wogoluwa abban yeggidosona. <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />Phawuloosi mato halaqaakonne wotaadaretako, “Haysati markabiyan shempi uttonna ixiko hinte attanaw danda7eketa” yaagis. <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />Hessa gisho, wotaadareti wogoloy qashetida wodoruwa qanxidi yeddi aggidosona.<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />Sa7ay wontana hanishin ubbay kathi maana mela Phawuloosi asaako, “Hinte kathi moonna naagishe hachira tammanne oyddu gallas gam7ideta. <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />Hessa gisho, guutha kathi hinte maana mela taani hintena woossayis. Hinte gashtisana mela guutha kathi maanaw koshshees; hari attoshin hinte huuphe binaanape issoyka dhayenna” yaagis. <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />Phawuloosi hessa gidi uythi ekidi ubbaa sinthan Xoossaa galatis; uythaa menthidi muussu doomis. <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />Ubbay minetidi bantaw kathi ekidi midosona. <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />Nuuni markabiyan de7eysati nam7u xeetanne laapun tammanne usupuna. <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />Enti midi kallida wode caana gistiya abban yeggidi markabiya deexuwa kawushidosona. <verse eid="ACT 27:38" /><verse number="39" style="v" sid="ACT 27:39" />Sa7ay wontida wode markabiya oosanchoti aw biitta gakidaako eronnashin, abba gaxan de7iya shafenne silimo be7idosona. Bantaw danda7etiko markabiya he shafiyako shiishanaw qopidosona. <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />Yaatidi, markabey boonna mela oykiya biratata birshidi abban yeggidosona. He wode laagiya mithaa qachiya wodoruwa birshidosona. Hessafe guye, carkoy markabiya sinthe sugana mela markabiya efiya sharaa sintha baggara dhoqu oothidi buussu doomidosona. <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />Shin markabey shafe dooren dom7etidi mitetis. Markabiyas sintha baggay xuggunidi shafiya caddi oykidi qaaxonna ixin, guye baggay zuliya sugethan meqeretethi oykis.<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />Wotaaddareti qasho asaape issoyka haatha wadhidi kessi ekonna mela enta wodhanaw zoretidosona. <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />Shin mato halaqay Phawuloosa ashshanaw koyidi wotaadareta zoreta ixis. Haathe wadho eriya ubbay markabiyape haathan gupi gupi wodhidi kasetidi gaxa keyana mela kiittis. <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />Attidaysati sanqa bollanne, markabiya me7uwa bolla keyana mela kiittis. Hessada hanidi ubbay gaxa sarora keyidosona. <figure style="fig" alt="Paul's Journey to Rome" file="Paul4-BW.tif" size="span" loc="ACT 27:1—28:14" ref="27:1—28:14">Roome Buussaa</figure><verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s1">Phawuloosi Yuushoy Abban Teqetida Biitta Maltan</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />Nuuni gaxa saro keyida wode gakida bessay yuushoy abban teqetida biitta, Malta gideysa erida. <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />Malta asay nuus daro keeha keehidosona. Iri bukiya gishonne meegiya gisho tama eethidi nuna ubbaa mokidosona. <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />Phawuloosi daro afira shiishidi taman wothishin, shooshi seela gisho keyidi iya kushiya bolla xaaxetidi iya dukis. <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />Malta asay shooshi Phawuloosa kushen xaaxetidaysa be7ida wode issoy issuwako, “Tuma ha uray shempo wodhida asi; hari attoshin abbaafe I attinka xoossa pirdafe<note caller="+" style="f"><char style="fr" closed="false">28:4 </char><char style="fqa" closed="false">Xoossa pirdafe: </char><char style="ft" closed="false">He wode he biittan dumma dumma macca xoossati de7oosona. Entafe issiniya iita oothiya asaa pirdiyaro. Iya pirda xoossi geeteta xeegetasu.</char></note> attidi paxa daanaw danda7ibeenna” yaagidosona. <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />Shin Phawuloosi ba kushiyape shooshaa wuxarkidi, taman yeggis; iya aykoka qohibeenna. <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />Enti, “Iya asatethay kixees, woyko akeekona kundidi hayqees” gidi iya naagoosona. Shin daro wode naagidi iya asatethan aybika dummatidabay dhayin, “Hessi xoosse” yaagidi banta qofaa laammidosona. <verse eid="ACT 28:6" /><verse number="7" style="v" sid="ACT 28:7" />He heeran yuushoy abban teqetida biitta halaqaa, Pupliyoosa geeteteysas gadey de7ees; heedzu gallas gakanaw I nuna siiqon mokis. <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />Pupliyoosa aaway qoxo, mishanne ulo uttison hargetidi zin7idi de7ees. Phawuloosi iya soo gelidi iyaw Xoossaa woossis; ba kushiya iya bolla wothidi pathis. <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />Hessafe guye, yuushoy abban teqetida biitta, Maltan de7iya hargiya hara asatika yidi paxidosona. <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />Enti nuna daro boncho bonchidosona; nuuni markaben baanaw dendida wode oges koshshiyaba nuus immidosona.<verse eid="ACT 28:10" /></para>
  <para style="s1">Phawuloosi Roome Gakis</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />Heedzu ageenape guye, Maltan balgo aathidi Markaben gelidi Iskindire baanaw dendida. He markabiya bolla Diyosqoroosa geetetiya mente eeqata misiley de7ees. <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />Sirakuuse katamaa gelidi yan heedzu gallas uttida. <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />Yaape dendidi Regiyume katamaa gakida. Issi gallasape guye, dugeha bagga carkoy carkin, wontetha gallas Putiyoola katamaa gakida. <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />Yan nuuni issi issi ammaniya asata demmin, bantara saaminta gam7ana mela nuna woossidosona. Hessafe guye, Roome bida.<verse eid="ACT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 28:15" />Roomen de7iya ammaniya asati nubaa si7idi, Afiyoosa Giyan, Heedzu Imatha Keethi gakanaw nuna mokanaw yidosona. Phawuloosi enta be7ida wode Xoossaa galatidi minetis.<verse eid="ACT 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />Nuuni Roome gelida wode Phawuloosi bana naagiya wotaadariyara barka de7o geetetis.<verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />Heedzu gallasape guye, Phawuloosi Ayhudeta halaqata baako xeegisis. Enti shiiqida wode entako, “Ta ishato, taani nu asaa woyko nu aawata wogaa bolla aybi qohoka oothabike, shin tana Yerusalaamen qachidi Roome asaas aathidi immidosona. <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />Enti ta mootuwa be7idi hayqos gathiyaba ta bolla aybibaaka demmiboonna gisho tana billanaw qopidosona. <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" />Shin Ayhudeti hessa ixida wode, ‘Tabaa Qeesarey pirdo’ yaagasipe attishin, taani ta deriya mootiyabay de7in gidenna.<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 25:11">Hawa 25:11</ref>.</char></note> <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />Taani hintena xeegisiday hintena be7anawunne hintew haysa odanaasa. Taani ha santhalaatan qashetiday Isra7eele asay naagiya ufaysaa gishosa” yaagis.<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />Ayhude halaqati Phawuloosako, “Nuus Yihudape nebaa xaafetida dabdaabey gakibeenna. Yaape yida asatape issoyka nebaa iita odiday baawa. <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />Shin ha ne kaalliya ammanuwa dumma dumma bessan asay ixeysa nuuni eriya gisho ne qofaa si7anaw koyoos” yaagidosona.<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />Enti banta yaana gallas Phawuloosas qaxaridi, he gallas daridi I de7iyasuwa yidosona. I wontafe omarsi gakanaw Xoossaa kawotethaaba entaw markatis. Qassi enti Yesuusaba ammanana mela Muse higgiyafenne nabeta maxaafape qoncisidi enta tamaarsis. <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />Issoti issoti Phawuloosi gidaysa ammanidosona, shin harati ammanibookona. <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />Enti banta giddon oda ma7onna ixida wode Phawuloosi issiba gidaape guye bidosona. I haysada yaagis: “Geeshsha Ayyaanay nu aawatas nabiya Isayaasa doonan odidaysi tuma.<verse eid="ACT 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />“ ‘Neeni he asaako bada,</para>
  <para style="q2" vid="ACT 28:26">hinte sissi si7eeta, shin hintew gelenna;</para>
  <para style="q2" vid="ACT 28:26">hinte be7o be7eeta, shin demmeketa.<note caller="-" style="x"><char style="xo" closed="false">28:26 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">Isa 6:9-10</ref>.</char></note><verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />Ayis giiko, ha deriya wozanay muumis;</para>
  <para style="q2" vid="ACT 28:27">enta haythay tullis;</para>
  <para style="q2" vid="ACT 28:27">enta ayfeyka goozetis.</para>
  <para style="q1" vid="ACT 28:27">Hessi bayneko, enti banta ayfiyan be7idi,</para>
  <para style="q2" vid="ACT 28:27">banta haythan si7idi, banta wozanan akeekidi,</para>
  <para style="q2" vid="ACT 28:27">taako simmanashin;</para>
  <para style="q2" vid="ACT 28:27">taka enta pathanashin’ yaaga” yaagis.<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />“Hiza, haysi Xoossaa atotetha kiitay Ayhude gidonaysatas gideysa ereeta. Entika si7ana” yaagis.<verse eid="ACT 28:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 28:29" />Phawuloosi hessa gidaape guye, Ayhudeti banta giddon daro palamishe keyidi bidosona.<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />Phawuloosi kera keethan nam7u laythi kumethi de7is; yan de7ishe baako yaa ubbaa mokees. <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />Yashshi baynanne oonika diggonashin Xoossa kawotethaaba sabbakis; Godaa Yesuus Kiristoosaba qoncisidi tamaarsees.<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>