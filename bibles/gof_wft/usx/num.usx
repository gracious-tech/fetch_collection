<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NUM" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Taybo Maxaafa</para>
  <para style="toc1">Taybo Maxaafa</para>
  <para style="toc3">Taybo</para>
  <para style="toc2">Taybo</para>
  <para style="mt1">Taybo Maxaafa</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Taybo maxaafay, Isra7eele asay Siina zumaape dendida wodepe doomidi, Xoossay entaw immana gidi qaala gelida biittas doloha bagga zawa gakanaw hemetida oytamu laytha taarike odees. Maxaafa sunthay, Isra7eele asay Siina zumaape dendidi baanape sinthe, issi yeletape guye Yordaanose Shaafape doloha baggan, Moo7abe biittan, Musey asa taybida taybuwa bessees. Nam7u taybotape giddon de7iya woden, Isra7eele asay Kanaanepe dugeha bagga zawan de7iya Qaades-Barne matidi de7ees. Gidoshin, enti Xoossay immana gida biitta yaara gelanaw danda7ibookona. Hessa gisho, enti he heeran daro laythi aathidaape guye, Yordaanose Shaafape doloha baggara de7iya biitta gakidosona. Entafe baggay yan daanaw qofa qachin, attida asay Yordaanose pinnidi, Kanaane baanaw bantana giigisidosona.</para>
  <para style="ip">Taybo maxaafay, daro metoy gakiya wode yayyiyanne ufaysi qanxiya asaa taarike bessees. Xoossa bollanne enta kaalethana mela Xoossay doorida Muse bolla geellatethan dendida asaa taarike qoncisees. Asay daaburanchonne kiitetonna dere gidikoka, Xoossay ammanthiya Xoosse gididi, enta naagidi wothidaysa taarikey odees. Hessadaka, Musey issi issi toho danda7a dhaykoka, mino ammanoy iyaw de7iya gisho, Xoossasinne asas ammanetidi oothiya asi gididi bentis.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Koyro taybuwa <char style="ior">(<ref loc="NUM 1:1-4:49">1:1—4:49</ref>)</char></para>
  <para style="io1">Leewetanne dumma dumma higge <char style="ior">(<ref loc="NUM 5:1-8:26">5:1—8:26</ref>)</char></para>
  <para style="io1">Paasika Ba7aale <char style="ior">(<ref loc="NUM 9:1-23">9:1-23</ref>)</char></para>
  <para style="io1">Siina zumaape Moo7abe gakanaw hemetida hemetha <char style="ior">(<ref loc="NUM 10:1-15:41">10:1—15:41</ref>)</char></para>
  <para style="io1">Asa geellatetha <char style="ior">(<ref loc="NUM 16:1-17:13">16:1—17:13</ref>)</char></para>
  <para style="io1">Kahinetanne Leeweta <char style="ior">(<ref loc="NUM 18:1-19:22">18:1—19:22</ref>)</char></para>
  <para style="io1">Moo7abe gakanaw hemetida hemethi <char style="ior">(<ref loc="NUM 20:1-21:35">20:1—21:35</ref>)</char></para>
  <para style="io1">Balaamanne Balaaqa <char style="ior">(<ref loc="NUM 22:1-24:25">22:1—24:25</ref>)</char></para>
  <para style="io1">Asa ammanetona ixuwanne nam7antho taybuwa <char style="ior">(<ref loc="NUM 25:1-26:65">25:1—26:65</ref>)</char></para>
  <para style="io1">Selophaada macca naytanne Iyyasu dooretetha <char style="ior">(<ref loc="NUM 27:1-23">27:1-23</ref>)</char></para>
  <para style="io1">Dumma dumma higgetanne ba7aale wode yarshota <char style="ior">(<ref loc="NUM 28:1-30:16">28:1—30:16</ref>)</char></para>
  <para style="io1">Midiyaameta xoonetethanne Yordaanose pinetha <char style="ior">(<ref loc="NUM 31:1-36:13">31:1—36:13</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="NUM 1" />
  <para style="s1">Koyro Isra7eele Asa Taybetetha</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 1:1" />Isra7eele asay Gibxe biittafe keyida nam7antho laythan, nam7antho ageenan, he ageena koyro gallasan, Goday Siina mela biittan Geeshsha Dunkaaniyan Museko haysada yaagis; <verse eid="NUM 1:1" /><verse number="2" style="v" sid="NUM 1:2" />“Neeranne Aaronara Isra7eele asa ubbaa enta kochan kochan, qassi enta soo asan asan taybadi, adde asaa sunthaa xaafite. <verse eid="NUM 1:2" /><verse number="3" style="v" sid="NUM 1:3" />Laythi laatamanne iyape bolla gidida, oletanaw danda7iya Isra7eele asa ubbaa taybite. <verse eid="NUM 1:3" /><verse number="4" style="v" sid="NUM 1:4" />Kochape kochape issi issi asi ba soo asaas halaqa gididi hintena maaddo. <verse eid="NUM 1:4" /><verse number="5" style="v" sid="NUM 1:5" />Hintena maaddana asaa sunthay haysafe kaallidi xaafetidaysa.</para>
  <para style="li1" vid="NUM 1:5">Robeelape, Shade7ura na7aa Elixura; <verse eid="NUM 1:5" /><verse number="6" style="v" sid="NUM 1:6" />Simoonape Sursadaya na7a Salumi7eela;<verse eid="NUM 1:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 1:7" />Yihudape Amnadaabe na7aa Na7asoona;<verse eid="NUM 1:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 1:8" />Yisakoorape Zu7ara na7aa Natina7eela;<verse eid="NUM 1:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 1:9" />Zabloonape Heloona na7aa Eli7aaba;<verse eid="NUM 1:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 1:10" />Yoosefa naytape,</para>
  <para style="li1" vid="NUM 1:10">Efreemape Amhuda na7aa Elishama7a;</para>
  <para style="li1" vid="NUM 1:10">Minaasepe Padazuura na7aa Gamali7eela;<verse eid="NUM 1:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 1:11" />Biniyaamepe Gadiyoona na7aa Abdaana;<verse eid="NUM 1:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 1:12" />Daanape Amsadaya na7aa Aki7ezera;<verse eid="NUM 1:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 1:13" />Aseerape Okraana na7aa Pagi7eela;<verse eid="NUM 1:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 1:14" />Gaadape Ragu7eela na7aa Elyaasafa;<verse eid="NUM 1:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 1:15" />Niftaalemepe Enaana na7a Akira;<verse eid="NUM 1:15" /></para>
  <para style="li1">
    <verse number="16" style="v" sid="NUM 1:16" />Ha asay banta aawata keethaa asaape kaalethanaw dooretida Isra7eele yarata halaqata” yaagis.<verse eid="NUM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 1:17" />Yaatin Museynne Aaroni he dooretida asata ekidi, <verse eid="NUM 1:17" /><verse number="18" style="v" sid="NUM 1:18" />nam7antho ageenan koyro gallasan kumetha maabara xeegidi shiishidosona. Asay banta kochan kochan, qassi banta soo asan asan laatamu laythinne iyape bolla gidida adde ubbay xaafetis. <verse eid="NUM 1:18" /><verse number="19" style="v" sid="NUM 1:19" />Goday iya Kiittidaysada Musey enta Siina mela biittan taybis.<verse eid="NUM 1:19" /></para>
  <para style="p">
    <verse number="20-21" style="v" sid="NUM 1:20-21" />Oletanaw danda7iya adde ubbay, laatamu laythinne iyape bolla gidida adde ubbay taybetidi huuphen huuphen xaafetidosona. Enti banta kochan kochaaninne banta soo asan shaaketidi haysafe kaallidi de7iya taybo maaran mazgabetidosona.</para>
  <para style="li1" vid="NUM 1:20-21">Bayra na7aa Robeelape 46,500 <verse eid="NUM 1:20-21" /><verse number="22-23" style="v" sid="NUM 1:22-23" />Simoonape 59,300<verse eid="NUM 1:22-23" /></para>
  <para style="li1">
    <verse number="24-25" style="v" sid="NUM 1:24-25" />Gaadape 45,650<verse eid="NUM 1:24-25" /></para>
  <para style="li1">
    <verse number="26-27" style="v" sid="NUM 1:26-27" />Yihudape 74,600<verse eid="NUM 1:26-27" /></para>
  <para style="li1">
    <verse number="28-29" style="v" sid="NUM 1:28-29" />Yisakoorape 54,400<verse eid="NUM 1:28-29" /></para>
  <para style="li1">
    <verse number="30-31" style="v" sid="NUM 1:30-31" />Zabloonape 57,400<verse eid="NUM 1:30-31" /></para>
  <para style="li1">
    <verse number="32-33" style="v" sid="NUM 1:32-33" />Yoosefa na7aa Efreemape 40,500<verse eid="NUM 1:32-33" /></para>
  <para style="li1">
    <verse number="34-35" style="v" sid="NUM 1:34-35" />Yoosefa na7aa Minaasepe 32,200<verse eid="NUM 1:34-35" /></para>
  <para style="li1">
    <verse number="36-37" style="v" sid="NUM 1:36-37" />Biniyaamepe 35,400<verse eid="NUM 1:36-37" /></para>
  <para style="li1">
    <verse number="38-39" style="v" sid="NUM 1:38-39" />Daanepe 62,700<verse eid="NUM 1:38-39" /></para>
  <para style="li1">
    <verse number="40-41" style="v" sid="NUM 1:40-41" />Aseerape 41,500<verse eid="NUM 1:40-41" /></para>
  <para style="li1">
    <verse number="42-43" style="v" sid="NUM 1:42-43" />Niftaalemepe 53,400<verse eid="NUM 1:42-43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 1:44" />Musey, Aaroninne banta soo asaape asaape dooretida tammanne nam7u Isra7eele kochaa halaqati taybida asay haysata. <verse eid="NUM 1:44" /><verse number="45" style="v" sid="NUM 1:45" />Oletanaw danda7iya adde ubbay, laatamu laythinne iyape bolla gidida asay banta soo asan asan taybetidosona. <verse eid="NUM 1:45" /><verse number="46" style="v" sid="NUM 1:46" />Kumetha asaa tayboy 603,550.<verse eid="NUM 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 1:47" />Shin Leewe kochati taybetibookona. <verse eid="NUM 1:47" /><verse number="48" style="v" sid="NUM 1:48" />Gaasoyka kase Goday Museko haysada yaagis; <verse eid="NUM 1:48" /><verse number="49" style="v" sid="NUM 1:49" />“Leewe kochata taybopa; enta attida Isra7eele asaa taybon gelsofa. <verse eid="NUM 1:49" /><verse number="50" style="v" sid="NUM 1:50" />Leeweta, Geeshsha Dunkaaniyaninne iyan de7iya miisheta ubbaa bolla halaqa oothada shuuma. Enti Dunkaaniyanne iyan de7iya miisheta tookana; iya giddon oothananne iya yuushon dunkaanana. <verse eid="NUM 1:50" /><verse number="51" style="v" sid="NUM 1:51" />Geeshsha Dunkaaney shodetiya wode Leeweti shoddo; Geeshsha Dunkaaney eqiya wode Leeweti esso; entafe hari oonika iyako shiiqiko hayqo. <verse eid="NUM 1:51" /><verse number="52" style="v" sid="NUM 1:52" />Hanko Isra7eele asay banta heeraninne banta cugan cugan shaaketidi, banta dunkaaniya dunkaanona. <verse eid="NUM 1:52" /><verse number="53" style="v" sid="NUM 1:53" />Shin Godaa hanqoy Isra7eele maabara bolla wodhonna mela Leeweti Dunkaaniya yuushuwan banta dunkaaniya dunkaanidi naago” yaagis. <verse eid="NUM 1:53" /><verse number="54" style="v" sid="NUM 1:54" />Isra7eele asay Goday Muse kiitida ubbaa oothidosona.<verse eid="NUM 1:54" /></para>
  <chapter eid="NUM 1" />
  <chapter number="2" style="c" sid="NUM 2" />
  <para style="s1">Isra7eele Kochata Maara</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 2:1" />Goday Musenne Aarona haysada yaagis; <verse eid="NUM 2:1" /><verse number="2" style="v" sid="NUM 2:2" />Isra7eele asay banta kochan kochan mallanne banta kocha kocha erisiya bandira kaallidi, Geeshsha Dunkaaniyape guuthi haakidi iya yuushuwan dunkaanona.<verse eid="NUM 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 2:3" />Doloha baggara Yihuda kochay banta malla kaallidi dunkaanona. Yihuda kochaa kaalethey Amnadaabe na7aa Na7asoona. <verse eid="NUM 2:3" /><verse number="4" style="v" sid="NUM 2:4" />Iya cugaa tayboy 74,600.<verse eid="NUM 2:4" /></para>
  <para style="m">
    <verse number="5" style="v" sid="NUM 2:5" />Yihuda gakidi dunkaananay Yisakoore kochaa. Yisakoora kochaa kaalethey Zu7ara na7aa Natina7eela. <verse eid="NUM 2:5" /><verse number="6" style="v" sid="NUM 2:6" />Iya cugaa tayboy 54,400.<verse eid="NUM 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="NUM 2:7" />Iyape kaallidi Zabloona kochay dunkaanees. Zabloona kochaa kaalethey Heloona na7aa Eli7aaba. <verse eid="NUM 2:7" /><verse number="8" style="v" sid="NUM 2:8" />Iya cugaa tayboy 57,400<verse eid="NUM 2:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="NUM 2:9" />Yihuda baggan dunkaanida olanchota tayboy 186,400. Isra7eele asay gutaa yeddidi biya wode koyroti keyey enta.<verse eid="NUM 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 2:10" />Dugeha baggara Robeela kochay banta malla kaallidi dunkaanona. Enta kaalethey Sadiyoora na7aa Elisuura. <verse eid="NUM 2:10" /><verse number="11" style="v" sid="NUM 2:11" />Iya cugaa tayboy 46,500. <verse eid="NUM 2:11" /><verse number="12" style="v" sid="NUM 2:12" />Robeela gakidi dunkaaney Simoona kochaa. Simoona kochaa kaalethey Zurishadaya na7a Salumi7eela. <verse eid="NUM 2:12" /><verse number="13" style="v" sid="NUM 2:13" />Iya cuga tayboy 59,300.<verse eid="NUM 2:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="NUM 2:14" />Iyape kaallidi Gaade kochay dunkaanees. Enta kaalethey De7u7eela na7aa Eliyasaafa. <verse eid="NUM 2:14" /><verse number="15" style="v" sid="NUM 2:15" />Enta cugaa tayboy 45,650.<verse eid="NUM 2:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 2:16" />Robeela, baggan dunkaanida olanchota tayboy 151,450. Isra7eele asay gutaa yeddidi biya wode nam7antho keyey enta.<verse eid="NUM 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 2:17" />Hessafe guye, koyro keyiya Yihuda cugaapenne nam7antho keyiya Robeela cugaape giddon Geeshsha dunkaaniya tookidi Leeweti geloosona. Issi issi kochay banta dunkaanida maaran banta malla oykidi keyo.<verse eid="NUM 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 2:18" />Wuloha baggara Efreema baggay banta malla kaallidi dunkaanona. Entana kaalethey Amhuda na7aa Elishama7a. <verse eid="NUM 2:18" /><verse number="19" style="v" sid="NUM 2:19" />Enta cugaa tayboy 40,500. <verse eid="NUM 2:19" /><verse number="20" style="v" sid="NUM 2:20" />Enta gakidi Minaase kochay dunkaanees. Entana kaalethey Padazuura na7aa Gamali7eela. <verse eid="NUM 2:20" /><verse number="21" style="v" sid="NUM 2:21" />Enta olanchota tayboy 32,200. <verse eid="NUM 2:21" /><verse number="22" style="v" sid="NUM 2:22" />Iyape kaallidi dunkaaney Biniyaame kochaa. Biniyaame kochaa kaalethey Gidi7oona na7aa Abdaana. <verse eid="NUM 2:22" /><verse number="23" style="v" sid="NUM 2:23" />Enta cugaa tayboy 35,400. <verse eid="NUM 2:23" /><verse number="24" style="v" sid="NUM 2:24" />Efreema baggan dunkaanida olanchota tayboy 108,100. Isra7eele asay gutaa yeddidi biya wode heedzantho keyey enta.<verse eid="NUM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 2:25" />Pudeha baggara Daane kochay banta malla kaallidi dunkaanona. Entana kaalethey Amsadaya na7aa Aki7ezera. <verse eid="NUM 2:25" /><verse number="26" style="v" sid="NUM 2:26" />Enta cugaa tayboy 62,700. <verse eid="NUM 2:26" /><verse number="27" style="v" sid="NUM 2:27" />Entana gakidi Aseera kochay dunkaanees. Aseera kochaa kaalethey Okraana na7aa Pagi7eela. <verse eid="NUM 2:27" /><verse number="28" style="v" sid="NUM 2:28" />Enta cugaa tayboy 41,500. <verse eid="NUM 2:28" /><verse number="29" style="v" sid="NUM 2:29" />Iyape kaallidi Niftaaleme kochay dunkaanees. Niftaaleme kochaa kaalethey Enaana na7aa Akira. <verse eid="NUM 2:29" /><verse number="30" style="v" sid="NUM 2:30" />Enta cugaa tayboy 53,400<verse eid="NUM 2:30" /></para>
  <para style="m">
    <verse number="31" style="v" sid="NUM 2:31" />Daane baggan dunkaanida olanchota tayboy 157,600. Isra7eele asay gutaa yeddidi biya wode wursethan keyey enta.<verse eid="NUM 2:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 2:32" />Banta kochan kochan shaaketidi taybetida Isra7eele olanchota tayboy 603,550. <verse eid="NUM 2:32" /><verse number="33" style="v" sid="NUM 2:33" />Shin Goday Muse kiitidaysada, Leeweti hara Isra7eele asaara taybetibookona. <verse eid="NUM 2:33" /><verse number="34" style="v" sid="NUM 2:34" />Isra7eele asay, Goday Muse Kiittidaba ubbaa oothidosona. Enti banta mala kaallidi dunkaanidosona; qassi banta kochaanne banta soo asaa asaa kaallidi keyoosona.<verse eid="NUM 2:34" /></para>
  <chapter eid="NUM 2" />
  <chapter number="3" style="c" sid="NUM 3" />
  <para style="s1">Aarona Adde Nayta</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 3:1" />Goday Siina zuma bolla Musera odetiya wode de7iya Aaronanne Muse soo asay haysafe kaallidi xaafetidaysa. <verse eid="NUM 3:1" /><verse number="2" style="v" sid="NUM 3:2" />Aarona adde nayta sunthay, bayray Nadaaba, kaalley Abyooda, Alaazaranne Itamaara. <verse eid="NUM 3:2" /><verse number="3" style="v" sid="NUM 3:3" />He Aarona adde nayti ubbay, kahine gididi oothanaw tiyetidi shuumetidosona. <verse eid="NUM 3:3" /><verse number="4" style="v" sid="NUM 3:4" />Shin enta giddofe Naadabeynne Abyoodi Siina mela biittan Godaa sinthan geeshshi gidonna taman yarsho yarshidi hayqidosona. Entaw na7i baawa. Hessa gisho, enta aaway Aaroni paxa de7ida laytha ubban Alaazarinne Itamaara xalaali kahine gididi oothidosona.<verse eid="NUM 3:4" /></para>
  <para style="s1">Leeweta Ooso</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 3:5" />Goday Museko, <verse eid="NUM 3:5" /><verse number="6" style="v" sid="NUM 3:6" />“Leewe kochata ehada kahiniya Aarona maaddana mela enta iya sinthe shiisha. <verse eid="NUM 3:6" /><verse number="7" style="v" sid="NUM 3:7" />Enti Aaronanne Isra7eele maabara ubbaa Geeshsha Dunkaaniya sinthan dumma dumma ooso oothidi maaddo. <verse eid="NUM 3:7" /><verse number="8" style="v" sid="NUM 3:8" />Enti Geeshsha Dunkaaniya giddon de7iya miishe ubbaa aawatethan ayso. Isra7eele asaa gisho Geeshsha Dunkaaniya giddon ooso ubbaa enti oothonna. <verse eid="NUM 3:8" /><verse number="9" style="v" sid="NUM 3:9" />Aaronanne iya adde nayta maadana mela Leeweta shuuma. Enti Isra7eele asaa giddofe shaaketidi Aarona maaddana mela imetidosona. <verse eid="NUM 3:9" /><verse number="10" style="v" sid="NUM 3:10" />Aaronanne iya adde nayta kahine oothada shuuma. Entafe hara asi oonika Geeshsha dunkaaniyako shiiqiko hayqo” yaagis.<verse eid="NUM 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 3:11" />Qassi Goday Museko, <verse eid="NUM 3:11" /><verse number="12" style="v" sid="NUM 3:12" />“Taani Isra7eelen yeletiya bayra adde nayta gisho Leeweta ekas. Leeweti tabaa. <verse eid="NUM 3:12" /><verse number="13" style="v" sid="NUM 3:13" />Ayis giiko, bayra yeletida ubbay tabaa. Ta Gibxe biittan bayra yeletida ubbaa wodhida gallasan, Isra7eelen bayra yeletidaba ubbaa ase gidin, mehe gidin, taw dummayas. Enti tabaa gidana. Taani Godaa” yaagis.<verse eid="NUM 3:13" /></para>
  <para style="s1">Leeweta Taybuwa</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 3:14" />Qassika Goday Museko Siina mela biittan, <verse eid="NUM 3:14" /><verse number="15" style="v" sid="NUM 3:15" />“Leeweta enta kochan, qassi enta soo asan asan tayba. Yeletin issi ageenanne iyape bolla gidida adde nayta ubbaa tayba” yaagis. <verse eid="NUM 3:15" /><verse number="16" style="v" sid="NUM 3:16" />Yaatin Goday kiitidaysada Musey enta taybis.<verse eid="NUM 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 3:17" />Leewe adde nayti Gedisoona, Qahatanne Maraara. <verse eid="NUM 3:17" /><verse number="18" style="v" sid="NUM 3:18" />Gedisoona adde nayti Libinanne Same7a geetetoosona. <verse eid="NUM 3:18" /><verse number="19" style="v" sid="NUM 3:19" />Qahaata adde nayti Amraama, Yizihaara, Kebroonanne Uzi7eela. <verse eid="NUM 3:19" /><verse number="20" style="v" sid="NUM 3:20" />Meraara adde nayti Mahilanne Musa geetetoosona. Leeweta mayzati haysata.<verse eid="NUM 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 3:21" />Nam7u Gedisoona kochati Libinanne Sim7a. <verse eid="NUM 3:21" /><verse number="22" style="v" sid="NUM 3:22" />Yeletin issi ageenanne iyape bolla gidida adde nayta tayboy 7,500. <verse eid="NUM 3:22" /><verse number="23" style="v" sid="NUM 3:23" />Gedisoona kochati Geeshsha Dunkaaniyape guyen wuloha baggan dunkaanidosona. <verse eid="NUM 3:23" /><verse number="24" style="v" sid="NUM 3:24" />Gedisoona kochaa soo asaa halaqay La7eela na7aa Eliyasaafa. <verse eid="NUM 3:24" /><verse number="25" style="v" sid="NUM 3:25" />Gedisoona kochaas Geeshsha Dunkaaniya bolla de7iya aawatethay, Dunkaaniya, gaatha kamaa, kare kamaa, wula magarajuwa, <verse eid="NUM 3:25" /><verse number="26" style="v" sid="NUM 3:26" />Dunkaaniya yuushon de7iya dabaaba magarajuwa, yarsho bessa magarajuwa, dabaaba wula magarajuwa, wodorotanne iyan go7etiya miisheta ubbaa aawatethan aysoosona.<verse eid="NUM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 3:27" />Qahaata kochati Amraama, Yizihaara, Kebroonanne Uzi7eela. <verse eid="NUM 3:27" /><verse number="28" style="v" sid="NUM 3:28" />Yeletin issi ageenanne iyape bolla gidida adde nayta tayboy 8,600. Qahaata kochati Geeshsha Dunkaaniya aawatethan naagoosona. <verse eid="NUM 3:28" /><verse number="29" style="v" sid="NUM 3:29" />Qahaata kochati Geeshsha Dunkaaniyape dugeha baggara dunkaanidosona. <verse eid="NUM 3:29" /><verse number="30" style="v" sid="NUM 3:30" />Qahaata kochaa kaalethey Uzi7eela na7aa Elzafaana. <verse eid="NUM 3:30" /><verse number="31" style="v" sid="NUM 3:31" />Enti Taabotiya, xarpheeza, xompe wothiya kocaa, yarshsho bessaa, kahineti go7etiya Geeshsha Dunkaaniya miisheta, Ubbaafe Geeshsha Bessaa geliya wula bolla de7iya magarajuwa aawatethan ayso. <verse eid="NUM 3:31" /><verse number="32" style="v" sid="NUM 3:32" />Leeweta halaqay kahiniya Aarona na7aa Alaazara. I Geeshsha Bessan ootheysatas shuuma.<verse eid="NUM 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 3:33" />Meraara kochati Mahilanne Musa. <verse eid="NUM 3:33" /><verse number="34" style="v" sid="NUM 3:34" />Yeletin issi ageenanne iyape bolla gidida adde nayta tayboy 6,200. <verse eid="NUM 3:34" /><verse number="35" style="v" sid="NUM 3:35" />Meraara kochaa kaalethey Abikaala na7aa Zur7eela. Meraara kochay Geeshsha Dunkaaniyape pudeha baggara dunkaanidosona. <verse eid="NUM 3:35" /><verse number="36" style="v" sid="NUM 3:36" />Meraara kochay Dunkaaniya tuuqeta, liyoota, tuussatanne tuussati eqiya gedata, hessadaka giddon koshshiya miisheta ubbaa enti aawatethan aysoosona. <verse eid="NUM 3:36" /><verse number="37" style="v" sid="NUM 3:37" />Gujidika, Dunkaaniya yuushon de7iya dabaaba tuussatanne enta gedata, dhishetanne wodorota aawatethan aysoosona.<verse eid="NUM 3:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 3:38" />Geeshsha Dunkaaniya sinthan doloha baggara Musey, Aaroninne iya adde nayti dunkaanidosona. Geeshsha Dunkaaniya giddon Isra7eela asaa gisho oosetiya ooso ubbaa enti aawatethan aysoosona. Hara asi Geeshsha Dunkaaniyako shiiqiko hayqo.<verse eid="NUM 3:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 3:39" />Goday, Musenne Aarona Kiittidaysa mela issi ageenanne iyape bolla gidida Leeweta adde nayta tayboy 22,000.<verse eid="NUM 3:39" /></para>
  <para style="s1">Bayra Adde Nayta Wozo</para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 3:40" />Goday Museko, “Yeletin issi ageenanne iyape bolla gidida Isra7eele bayra adde nayta taybada enta suntha xaafa. <verse eid="NUM 3:40" /><verse number="41" style="v" sid="NUM 3:41" />Isra7eele bayra adde nayta bessan Leeweta, qassi Isra7eele bayra mehiya bessan Leeweta bayra mehiya taw eka. Taani Godaa” yaagis. <verse eid="NUM 3:41" /><verse number="42" style="v" sid="NUM 3:42" />Goday Muse kiitidaysada Isra7eelen bayra yeletida ubbaa taybis. <verse eid="NUM 3:42" /><verse number="43" style="v" sid="NUM 3:43" />Yeletin issi ageenanne iyape bolla gidida bayra adde nayta tayboy 22,273.<verse eid="NUM 3:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 3:44" />Goday Museko, <verse eid="NUM 3:44" /><verse number="45" style="v" sid="NUM 3:45" />“Isra7eele bayra adde nayta bessan Leeweta taw dummaya. Qassi Isra7eele bayra meheta bessan Leeweta bayra mehiya taw dummaya; taani Godaa. <verse eid="NUM 3:45" /><verse number="46" style="v" sid="NUM 3:46" />Isra7eele bayra adde nayta tayboy Leeweta bayra adde nayta taybuwape 273 aadhiya gisho he attidaysata taw woza. <verse eid="NUM 3:46" /><verse number="47" style="v" sid="NUM 3:47" />Issuwas issuwas geeshsha dunkaanen eretida mizaanen ichashu bira santimen woza. <verse eid="NUM 3:47" /><verse number="48" style="v" sid="NUM 3:48" />He wozo miishiya Aaronasinne iya adde naytas imma” yaagis. <verse eid="NUM 3:48" /><verse number="49" style="v" sid="NUM 3:49" />Palahidaysata wozo miishiya Musey shiishis. <verse eid="NUM 3:49" /><verse number="50" style="v" sid="NUM 3:50" />Geeshsha Dunkaaniya mizaaniya liken Isra7eele bayra adde nayta wozo miishiya 1,365 bira santime ekis. <verse eid="NUM 3:50" /><verse number="51" style="v" sid="NUM 3:51" />Goday kiitidaysada Musey wozo miishiya Aaronasinne iya adde naytas immis.<verse eid="NUM 3:51" /></para>
  <chapter eid="NUM 3" />
  <chapter number="4" style="c" sid="NUM 4" />
  <para style="s1">Qa7aata Kochaas Imetida Ooso</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 4:1" />Goday Musenne Aarona haysada yaagis; <verse eid="NUM 4:1" /><verse number="2" style="v" sid="NUM 4:2" />“Leewe kochatape Qahaata kochatanne enta soo asaa asaa shaakada tayba. <verse eid="NUM 4:2" /><verse number="3" style="v" sid="NUM 4:3" />Laythi 30-50 gakida adde ubbaa Geeshsha Dunkaaniyan oothanaw danda7eyisata tayba. <verse eid="NUM 4:3" /><verse number="4" style="v" sid="NUM 4:4" />Qahaata kochati Geeshsha Dunkaaniyan oothana oosoy Dunkaaniyan go7etiya geeshsha miisheta aawatethan naago.<verse eid="NUM 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 4:5" />“Asay gutaape baanaw dendiya wode Aaroninne iya adde nayti Geeshsha Dunkaaniya giddo gelidi, Caaqo Taabotiya sinthan de7iya magarajuwa wodhisidi he Caaqo Taabotiya iyara xaaxo. <verse eid="NUM 4:5" /><verse number="6" style="v" sid="NUM 4:6" />He kamaa bolla liiqo galba kammo; iya bolla gujidi kaalose carqe kammo; tookiya kasota sagaayotan aatho.<verse eid="NUM 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 4:7" />“Godaas shiiqiya uytha wothiya xarpheezaa bolla kaalose carqe kammo. Xarpheeza bolla saaneta, cilpata, xuu7atanne woyne ushsha yarshuwa duuqiya otota wothona. Uythay ubba wode xarpheeza bolla de7o. <verse eid="NUM 4:7" /><verse number="8" style="v" sid="NUM 4:8" />He ubbaa bolla zo7o carqe kammidi iya bolla qassi liiqo galba kammo; hessafe kaallidi tookiya kasota sagaayotan aatho.<verse eid="NUM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 4:9" />“Kaalose carqe ekidi xompe wothiya kocaa, iya xompetara, iya qaphetara, bido kessiya keretaranne zayte tigiya xaarotara ubbaa kammo. <verse eid="NUM 4:9" /><verse number="10" style="v" sid="NUM 4:10" />Yaatidi iya miisheta ubbaa liiqo galban kammidi tookiya arsa bolla wothona.<verse eid="NUM 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 4:11" />“Kaallidi worqa yarsho saaxiniya kaalose carqen kammo; qassi iya bollara liiqo galba yeggo. Yaatidi tookiya kasota sagaayotan aatho. <verse eid="NUM 4:11" /><verse number="12" style="v" sid="NUM 4:12" />Hessadaka, Geeshsha Dunkaaniya giddon go7etiya miisheta ubbaa kaalose carqen xaaxo; iya bolla liiqo galba yeggidi, tookiya alga bolla wotho.<verse eid="NUM 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 4:13" />“Naase yarsho bessaafe biduwa pitidi iya bolla ocha teera daaniya carqe kammo. <verse eid="NUM 4:13" /><verse number="14" style="v" sid="NUM 4:14" />Yarsho bessan go7etiya miisheta ubbaa; tama cooceta, asho qapheta, akaafatanne haatha kereta iya bolla wothidi, liiqo galba kammo. Yaatidi tookiya kasota sagaayotan aatho. <verse eid="NUM 4:14" /><verse number="15" style="v" sid="NUM 4:15" />Aaroninne iya adde nayti, geeshshabatanne iyan go7etiya geeshsha miisheta ubbaa kammidaape guye Isra7eele asay gutaape dendiya wode Qahaata kochay yidi tooko. Shin enti hayqonna mela geeshsha miisheta bochofo. Geeshsha Dunkaaney bessaafe dendiya wode qahaata kochaas de7iya aawatethay haysa.<verse eid="NUM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 4:16" />“Kahiniya Aarona na7ay Alaazari xompe zaytiya, sawiya ixaaniya, yarsho kathaanne tiyo zaytiya, hessadaka Geeshsha Dunkaaniyan de7iya dumma dumma geeshsha miisheta ubbaa bolla aawatethi de7ees” yaagis.<verse eid="NUM 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 4:17" />Goday Musekonne Aaronako, <verse eid="NUM 4:17" /><verse number="18" style="v" sid="NUM 4:18" />“Qahaata kochay Leewe kochaa giddofe hayqidi dhayana mela oothopite. <verse eid="NUM 4:18" /><verse number="19" style="v" sid="NUM 4:19" />Ubbaafe Geeshsha miishiyako shiiqidi hayqonna mela Aaroninne iya adde nayti Geeshsha Dunkaaniya giddo gelidi, Qohaata kochay huuphen huuphen oothana oosuwanne tookana toohuwa shaakidi besso. <verse eid="NUM 4:19" /><verse number="20" style="v" sid="NUM 4:20" />Qahaata kochay hayqonnaada geeshsha miisheta be7anaw guutha wodeska Dunkaaniya giddo gelopo” yaagis.<verse eid="NUM 4:20" /></para>
  <para style="s1">Gedisoona Kochaas Imetida Ooso</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 4:21" />Goday Museko, <verse eid="NUM 4:21" /><verse number="22" style="v" sid="NUM 4:22" />“Leewe kochaafe Gedisoona kochaanne enta soo asaa asaa shaakada tayba. <verse eid="NUM 4:22" /><verse number="23" style="v" sid="NUM 4:23" />Laythi 30-50 gakida adde ubbaa Geeshsha Dunkaaniya giddon oothanaw danda7eyisata tayba. <verse eid="NUM 4:23" /><verse number="24" style="v" sid="NUM 4:24" />Gedisoona kochati oothana oosoy haysafe kaallidi de7eysa; <verse eid="NUM 4:24" /><verse number="25" style="v" sid="NUM 4:25" />enti Geeshsha Dunkaaniya gaatha kamaa, kare kamaa, bollara yegetiya liiqo do7a galba, geliya wula bolla kaqetiya magarajuwa tooko. <verse eid="NUM 4:25" /><verse number="26" style="v" sid="NUM 4:26" />Hessadaka Geeshsha Dunkaaniyanne yarsho bessa yuushuwan de7iya dabaaba magarajota, dabaaba geliya wula bolla de7iya gesheta, wodorotanne iyaw go7etiya miisheta ubbaa tooko. Gedisoona kochay miishetan oothanaw bessiya ooso ubbaa ootho. <verse eid="NUM 4:26" /><verse number="27" style="v" sid="NUM 4:27" />Tooho gidin, hara ooso gidin, enti oothiya ooso ubbaa Aaroninne iya adde nayti enta kaalli oosiso. Enti tookanaw bessiyabata ubbaa ne aawatethan entaw gisha. <verse eid="NUM 4:27" /><verse number="28" style="v" sid="NUM 4:28" />Geeshsha Dunkaaniya giddon Gedisoona kochay oothana oosoy haysa. Enta oosuwa kahiniya Aarona na7ay Itamaari kaallidi oosiso.<verse eid="NUM 4:28" /></para>
  <para style="s1">Maraara Kochaas Imetida Ooso</para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 4:29" />“Leewe kochaafe Meraara kochaanne enta soo asaa asaa shaakada tayba. <verse eid="NUM 4:29" /><verse number="30" style="v" sid="NUM 4:30" />Laythi 30-50 gakida adde ubbaa Geeshsha Dunkaaniya giddon oothanaw danda7eyisata tayba.<verse eid="NUM 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 4:31" />“Enti Dunkaaniya tuuqeta, liyoota, tuussata, Dunkaaniya gedata, <verse eid="NUM 4:31" /><verse number="32" style="v" sid="NUM 4:32" />Dunkaaniya yuushon dabaaban eqiya tuussata, he tuussata gedata, dhisheta, wodorotanne iyan koshshiya miisheta ubbaa tooko. Issoy issoy tookanaw bessiya miishiya iya sunthan shaakada gisha. <verse eid="NUM 4:32" /><verse number="33" style="v" sid="NUM 4:33" />Geeshsha Dunkaaniya giddon Meraara kochay oothana oosoy haysa. Enti oothana ooso ubbaa kahiniya Aarona na7aa Itamaari aawatethan kaallidi oosiso” yaagis.<verse eid="NUM 4:33" /></para>
  <para style="s1">Leewe Kocha Taybuwa</para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 4:34" />Musey, Aaroninne Isra7eele halaqati Qahaata kocha enta soo asan asan shaakidi taybidosona. <verse eid="NUM 4:34" /><verse number="35" style="v" sid="NUM 4:35" />Laythi 30-50 gakida adde ubbaa Geeshsha Dunkaaniya giddon oothanaw danda7eyisata taybidosona. <verse eid="NUM 4:35" /><verse number="36" style="v" sid="NUM 4:36" />Enta tayboy 2,750. <verse eid="NUM 4:36" /><verse number="37" style="v" sid="NUM 4:37" />Goday Muse kiitidaysada Geeshsha Dunkaaniya giddon oothana mela Museynne Aaroni taybida Qahaata kochati haysata.<verse eid="NUM 4:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 4:38" />Gedisoona kochati banta soo asan asan shaaketidi taybetidosona. <verse eid="NUM 4:38" /><verse number="39" style="v" sid="NUM 4:39" />Laythi 30-50 gakida addeti ubbaa Geeshsha Dunkaaniya giddon oothanaw danda7eyisata <verse eid="NUM 4:39" /><verse number="40" style="v" sid="NUM 4:40" />tayboy 2,630. <verse eid="NUM 4:40" /><verse number="41" style="v" sid="NUM 4:41" />Goday Muse kiitidaysada Geeshsha Dunkaaniya giddon oothana mela Museynne Aaroni taybida Gedisoona kochati haysata.<verse eid="NUM 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 4:42" />Meraara kochati banta soo asan asan shaaketidi taybetidosona. <verse eid="NUM 4:42" /><verse number="43" style="v" sid="NUM 4:43" />Laythi 30-50 gakida addeti ubbay, Geeshsha Dunkaaniya giddon oothanaw danda7eyisata <verse eid="NUM 4:43" /><verse number="44" style="v" sid="NUM 4:44" />tayboy 3,200. <verse eid="NUM 4:44" /><verse number="45" style="v" sid="NUM 4:45" />Goday Muse kiitidaysada Geeshsha Dunkaaniya giddon oothana mela Museynne Aaroni taybida Meraara kochati haysata.<verse eid="NUM 4:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 4:46" />Musey, Aaroninne Isra7eele halaqati Leeweta ubbaa enta kochaaninne enta soo asan asan shaakidi tayba. <verse eid="NUM 4:46" /><verse number="47" style="v" sid="NUM 4:47" />Laythi 30-50 gakida addeti ubbay, Geeshsha Dunkaaniya giddon oothanawnune miisheta tookanaw danda7iya, <verse eid="NUM 4:47" /><verse number="48" style="v" sid="NUM 4:48" />Leeweta tayboy 8,580. <verse eid="NUM 4:48" /><verse number="49" style="v" sid="NUM 4:49" />Goday Muse kiitidaysada, enti huuphen huuphen taybetidosona. Hessadaka Goday Muse kiitidaysada enti oothana oosoynne tookana toohoy imetis.<verse eid="NUM 4:49" /></para>
  <chapter eid="NUM 4" />
  <chapter number="5" style="c" sid="NUM 5" />
  <para style="s1">Geeshsha Guta</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 5:1" />Goday Museko, <verse eid="NUM 5:1" /><verse number="2" style="v" sid="NUM 5:2" />“Isra7eele asay baro hargen oyketida asi woyko asatethafe goggiyabay de7iya asi woyko aha bochidi tunida asi oonaka banta gutaape kessana mela kiita. <verse eid="NUM 5:2" /><verse number="3" style="v" sid="NUM 5:3" />Ta enta giddon de7iya gutaa tunisonna mela ha geeshshi gidonna asati macca gidin adde enta giddofe kessada goodda” yaagis. <verse eid="NUM 5:3" /><verse number="4" style="v" sid="NUM 5:4" />Goday Muse kiitidaysada Isra7eele asay enta ubbaa gutaape kessidi gooddidosona.<verse eid="NUM 5:4" /></para>
  <para style="s1">Naaqo Aca</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 5:5" />Goday Museko, <verse eid="NUM 5:5" /><verse number="6" style="v" sid="NUM 5:6" />“Neeni Isra7eele asaas haysa oda; adde gidin woyko macci gidin oonika Godaas ammanetona ixidi hara asi naaqiko he uray bala oothis. <verse eid="NUM 5:6" /><verse number="7" style="v" sid="NUM 5:7" />I ba nagara paaxo; ba nagara acciya kumetha aca bolla xeetape laatamu kushe gujidi I naaqida uraas ciggo. <verse eid="NUM 5:7" /><verse number="8" style="v" sid="NUM 5:8" />Shin he naaqetida uray hayqidaba gidiko, aca ekanaw mata dabboy iyaw dhayko, he acay Godaas gididi kahiniyas imeto. He aca bolla gujidi iya nagara atotethas qoho yarshos gidiya maraze dorsi immo. <verse eid="NUM 5:8" /><verse number="9" style="v" sid="NUM 5:9" />Qassi Isra7eele asay Godaas immiya geeshsha imo ubbay he kahiniyas gido. <verse eid="NUM 5:9" /><verse number="10" style="v" sid="NUM 5:10" />Issi issi asi immiya geeshsha imotay he uraaba, shin kahiniyas immiko he imotay kahiniyasa” yaagis.<verse eid="NUM 5:10" /></para>
  <para style="s1">Azini Sidhiya Machiw</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 5:11" />Goday Museko, <verse eid="NUM 5:11" /><verse number="12" style="v" sid="NUM 5:12" />“Isra7eele asaas yaagada oda; issi addiya machiya kare hemetada iyaw ammanetona ixiko, <verse eid="NUM 5:12" /><verse number="13" style="v" sid="NUM 5:13" />hara addera aqiko, qassi hessa iya ba azinaape qosiko, iya laymatishin be7ida marki baynaba gidiko, <verse eid="NUM 5:13" /><verse number="14" style="v" sid="NUM 5:14" />I azinay iyo tunasu gidi sidhiko, woyko iya tunonna de7ishin I ba machiw sidhiko, <verse eid="NUM 5:14" /><verse number="15" style="v" sid="NUM 5:15" />he addey ba machiw kahiniyako efo. I gisho yarshanaw issi kilo giraame banga dhiille efo. He addey ba machiw sidhida gisho, I qohuwa qoncisiya katha yarsho gidiya gisho, dhiilliya bolla zayte tigopo; ixaane iya bolla wothofo.”<verse eid="NUM 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 5:16" />Kahiney he maccasiw Godaa sinthan esso. <verse eid="NUM 5:16" /><verse number="17" style="v" sid="NUM 5:17" />Geeshsha haathi keren eko. Geeshsha Dunkaaniya wuygiyape biitta ekidi he haathan gujo. <verse eid="NUM 5:17" /><verse number="18" style="v" sid="NUM 5:18" />He maccasiw Godaa sinthan esso; he maccase huuphiya billidi sidhida gisho yarshetiya qohuwa qoncisiya katha yarsho I kushen wotho; qassi kahiney ba kushen baadethi ehiya camo haatha keren oyko. <verse eid="NUM 5:18" /><verse number="19" style="v" sid="NUM 5:19" />Hessafe guye, maccasiw yaagidi caaqiso; “Neeni hara addera aqabonaba gidiko, nenatethaa tunisaboonaba gidiko, baadethi ehiya haathay new gome gidopo. <verse eid="NUM 5:19" /><verse number="20" style="v" sid="NUM 5:20" />Shin neeni ne azina aggada hara addera aqada tunidaba gidiko, <verse eid="NUM 5:20" /><verse number="21" style="v" sid="NUM 5:21" />Goday ne yelo keetha gundisidi, ne uluwa gabbisidi ne asaa sinthan nena baadetidaba ootho. <verse eid="NUM 5:21" /><verse number="22" style="v" sid="NUM 5:22" />Ha baadethi ehiya haathay ne uluwan gelidi ne uluwa gabbiso; ne yelo keethaa gundiso” yaagidi caaqiso.</para>
  <para style="p" vid="NUM 5:22">Maccasiya, “Amin7i, hessi tana gako” yaago.<verse eid="NUM 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 5:23" />“Haysafe guye, kahiney he baadetha xaafo; he xaafidaysa keriyan de7iya haathan meecco. <verse eid="NUM 5:23" /><verse number="24" style="v" sid="NUM 5:24" />Qangethi ehiya haatha maccasiw ushshanaape sinthe, <verse eid="NUM 5:24" /><verse number="25" style="v" sid="NUM 5:25" />kahiney maccase kushepe yarsho dhiilliya ekidi, dentho yarsho oothidi Godaas yarsho. <verse eid="NUM 5:25" /><verse number="26" style="v" sid="NUM 5:26" />Kahiney yarsho kathaafe zolle ekidi bala qoncisiya yarsho oothidi yarsho bessan xuuggo. Hessafe guye, maccasiw he haatha ushsho. <verse eid="NUM 5:26" /><verse number="27" style="v" sid="NUM 5:27" />Iya ba azinaas ammanetona ixada tunidaba gidiko baadetha haathay I uluwan camo saho medho. I uloy gabbana; I yelo keethayka gundana; iya ba asaa giddon baadetidaaro gidana. <verse eid="NUM 5:27" /><verse number="28" style="v" sid="NUM 5:28" />Iya tunaboonabanne xillo maccas gidiko, iya geeshshi gidana; na7a yelanaw danda7awusu.<verse eid="NUM 5:28" /></para>
  <para style="p">
    <verse number="29-30" style="v" sid="NUM 5:29-30" />“Issi asi ba machiw laymatasu gidi sidhiko woyko qaanatiko yarsho bessi ehidi iyo esso. Kahiney he wogaa ubbaa I bolla polo. <verse eid="NUM 5:29-30" /><verse number="31" style="v" sid="NUM 5:31" />Azinay, qohoy baynaba gidana, shin macciya ba nagaraa gaason gakiya waaye ubbaa tookana” yaagis.<verse eid="NUM 5:31" /></para>
  <chapter eid="NUM 5" />
  <chapter number="6" style="c" sid="NUM 6" />
  <para style="s1">Nazraawe Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 6:1" />Goday Museko, <verse eid="NUM 6:1" /><verse number="2" style="v" sid="NUM 6:2" />“Isra7eele asaa haysada gada kiita; adde gidin woyko macca bana Godaas dummayidi Naazirawe gidanaw qangiko, <verse eid="NUM 6:2" /><verse number="3" style="v" sid="NUM 6:3" />woyne woyko hara mathoyiya ushshi uyopo. Caalabanne mathoyaba uyopo; woyne teera, tiyanne mela moopo. <verse eid="NUM 6:3" /><verse number="4" style="v" sid="NUM 6:4" />I bana Godaas dummayida wode ubban, woyne ayfiya gidin poquwa gidin woyko kochaa gidin moopo.<verse eid="NUM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 6:5" />“I bana Godaas dummayida wode ubban, ba huuphiya meedetofo woyko qanxetofo. I ba huuphe binaana adussidi dicho. I bana Godaas dummayida wodey poletana gakanaw geeshshi gidanaw koshshees. <verse eid="NUM 6:5" /><verse number="6" style="v" sid="NUM 6:6" />I bana Godaas dummayida woden ubban ahako shiiqopo. <verse eid="NUM 6:6" /><verse number="7" style="v" sid="NUM 6:7" />I bana dummayidaysa erisey iya huuphiya gidiya gisho, iya aaway woyko iya aayiya woyko iya ishay woyko iya michiya hayqiko enta aha bochidi bana tunisopo. <verse eid="NUM 6:7" /><verse number="8" style="v" sid="NUM 6:8" />I bana Godaas dummayida wode ubban Godaas geeshshi.<verse eid="NUM 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 6:9" />“Asi iya matan qoponna hayqiko, Godaas geeshshi gidida ba huuphiya tunisiko laapun gallas gam7idi ba huuphiya meedeto. <verse eid="NUM 6:9" /><verse number="10" style="v" sid="NUM 6:10" />Hospuntha gallasan nam7u holleta woyko nam7u kuraachota Geeshsha Dunkaaniya pengen de7iya kahiniyas eho. <verse eid="NUM 6:10" /><verse number="11" style="v" sid="NUM 6:11" />Naazirawey aha bochidi tunida gisho nagarape iya geeshshanaw kahiney holletape issuwa nagara yarsho, hankuwa qassi xuussa yarsho oothidi yarsho. He gallas I ba huuphiya wogaada zaaridi Godaas geeshsho; <verse eid="NUM 6:11" /><verse number="12" style="v" sid="NUM 6:12" />I bana zaaridi Godaas dummayo. Yaatidi issi laytha maraze naaqo yarsho oothidi yarsho. I Godaas dummayida huuphey tunida gisho, kase I bana Godaas dummayidi de7ida wodey taybetenna.<verse eid="NUM 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 6:13" />“Issi naazirawey ba qangetha wodiya ongida wode polana wogay haysa; Geeshsha Dunkaaniya penge bidi; <verse eid="NUM 6:13" /><verse number="14" style="v" sid="NUM 6:14" />borey bayna issi laytha dorsa urge xuussa yarshos, issi laytha uzzo dorsi nagara yarshos, issi maraze issifetetha yarshos he bessaa eho. <verse eid="NUM 6:14" /><verse number="15" style="v" sid="NUM 6:15" />Qassi katha yarshonne ushsha yarsho entara issife yarshanaw eho. He katha yarshoy irshoy geliboonna lo77o dhiille shamaho zaytera uuketida orde uythinne shamaho zayten tiyetida lee7o gaytan eho.<verse eid="NUM 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 6:16" />“Kahiney he ubbaa nagara yarshonne xuussa yarsho oothidi Godaas yarsho. <verse eid="NUM 6:16" /><verse number="17" style="v" sid="NUM 6:17" />Kahiney maraziya gaytan de7iya uythaara Godaas issifetetha yarsho oothidi yarsho; kaallidi katha yarshuwanne ushsha yarshuwa yarsho. <verse eid="NUM 6:17" /><verse number="18" style="v" sid="NUM 6:18" />Naazirawey Godaas dummayida ba huuphiya Geeshsha Dunkaaniya pengen meedetidi, binaana issifetetha yarshoy eexiya taman yeggo.<verse eid="NUM 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 6:19" />“Naazirawey ba huuphiya meedetidaape guye, kahiney doysetida maraziya gedaa ashuwa gaytan de7iya orde uythaafenne lee7o uythaafe ekidi, Naazirawiya kushen wotho. <verse eid="NUM 6:19" /><verse number="20" style="v" sid="NUM 6:20" />Yaatidi kahiney he ubbaa yuusho yarsho oothidi, Godaas yarsho. He ubbay kahiniya gisho gidiya angaasuwaranne gedaara kahiniyas geeshsha yarsho gidees. Hessafe Godaas Naazirawey woyne ushsha uyo. <verse eid="NUM 6:20" /><verse number="21" style="v" sid="NUM 6:21" />Hiza Godaas bana dummayida Naazirawey oothana mela imetida wogay haysa. Shin naazirawey yarshanaw koshshiya yarshotape aathidi immanaw qangidaba gidiko, ba qangetha gathanaw koshshees” yaagis.<verse eid="NUM 6:21" /></para>
  <para style="s1">Kahineti Anjiya Anjuwa</para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 6:22" />Goday Museko, <verse eid="NUM 6:22" /><verse number="23" style="v" sid="NUM 6:23" />“Aaroninne iya adde nayti Isra7eele asaa anjiya wode haysada yaagidi anjite yaaga;<verse eid="NUM 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 6:24" />“ ‘Goday hintena anjo, Goday hintena naago;<verse eid="NUM 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="NUM 6:25" />Goday ba som7uwa hintew poo7iso; I hintew qadheto;<verse eid="NUM 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="NUM 6:26" />Goday ba keeha ayfiyan xeello; I hintew sarotethi immo’ yaagidi anjite” yaaga.<verse eid="NUM 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 6:27" />“Enti Isra7eele asaa ta sunthan anjiya wode ta enta anjana” yaagis.<verse eid="NUM 6:27" /></para>
  <chapter eid="NUM 6" />
  <chapter number="7" style="c" sid="NUM 7" />
  <para style="s1">Geeshsha Dunkaaniya Anjiso Imotata</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 7:1" />Musey Geeshsha Dunkaaniya tokidi ongida wode he Dunkaaniyanne iya miishiya, yarsho bessaanne iya miishiya ubbaa zayten tiyidi geeshshis. <verse eid="NUM 7:1" /><verse number="2" style="v" sid="NUM 7:2" />Hessafe guye, Isra7eele asaa kochan kochan taybidi kaalethiya wode halaqa gidida ubbay, <verse eid="NUM 7:2" /><verse number="3" style="v" sid="NUM 7:3" />Godaas imota shiishidosona. Enti immida imotay nam7u halaqa sunthan issi para gaare, qassi issi issi halaqa sunthan issi issi booru oothidi, usupun gaaretanne tammanne nam7u boorata Geeshsha Dunkaaniya ehidosona.<verse eid="NUM 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 7:4" />Goday Museko, <verse eid="NUM 7:4" /><verse number="5" style="v" sid="NUM 7:5" />“Geeshsha Dunkaaniya oosuwas go77ana mela neeni he imota entafe ekada, enta oosuwas oosuwas koshsheysada shaakada Leewetas imma” yaagis. <verse eid="NUM 7:5" /><verse number="6" style="v" sid="NUM 7:6" />Hessa gisho, Musey gaaretanne boorata ekidi Leewetas immis. <verse eid="NUM 7:6" /><verse number="7" style="v" sid="NUM 7:7" />Gedisoona kochaas koshsheysada shaakidi enta oosuwas nam7u gaaretanne oyddu boorata immis. <verse eid="NUM 7:7" /><verse number="8" style="v" sid="NUM 7:8" />Meraara kochaas koshsheysada shaakidi, enta oosuwas uyddu gaaretanne hospun boorata immis. Enta oosuwa aawatethan kaalethey kahiniya Aarona na7aa Itamaara. <verse eid="NUM 7:8" /><verse number="9" style="v" sid="NUM 7:9" />Shin Qahaata kochaa oosoy Dunkaaniya geeshsha miisheta hashen toho gidiya gisho Musey entaw para gaarenne booru immibeenna.<verse eid="NUM 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 7:10" />Musey yarsho bessi Godaas dummayida gallas halaqati yarsho bessa sinthe banta imota ehidosona. <verse eid="NUM 7:10" /><verse number="11" style="v" sid="NUM 7:11" />Goday Museko, “Issi issi gallas issi issi halaqay yarsho bessi Godaas dummayanaw ba imota immo” yaagis.<verse eid="NUM 7:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="NUM 7:12" />Koyro gallas ba imota ehiday Yihuda kochaafe Amnadaabe na7aa Na7asoona.<verse eid="NUM 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 7:13" />Na7asooni ehida imotay geeshsha dunkaanen eretida mizaanen 1,500 giraame birape oosetida picca Saane, 800 giraame birape oosetida ollatiya saane, nam7aaka katha yarsho yarshanaw zaytera walaketida lo77o dhiille kumidaysa; <verse eid="NUM 7:13" /><verse number="14" style="v" sid="NUM 7:14" />qassi 110 giraame worqafe oosetida ixaaney kumida shaate; <verse eid="NUM 7:14" /><verse number="15" style="v" sid="NUM 7:15" />xuussa yarshos, issi wofaano, issi maraze, issi laytha urge dorsi; <verse eid="NUM 7:15" /><verse number="16" style="v" sid="NUM 7:16" />nagara yarshos issi kole; <verse eid="NUM 7:16" /><verse number="17" style="v" sid="NUM 7:17" />issifetetha yarshos nam7u boorata, ichashu marazeta, ichashu koletanne ichashu urge dorsata ehis.</para>
  <para style="m" vid="NUM 7:17">Kaalliya hanko halaqatika Amnadaabe na7ay Na7asooni immidaysada banta imota ehidosona.<verse eid="NUM 7:17" /></para>
  <para style="p">
    <verse number="18-23" style="v" sid="NUM 7:18-23" />Nam7antho gallasan Yisakoora kochaafe Zu7ara na7ay Natina7eeli ba imota ehis.<verse eid="NUM 7:18-23" /></para>
  <para style="p">
    <verse number="24-29" style="v" sid="NUM 7:24-29" />Heedzantho gallasan Zabloona kochaafe Heloona na7ay Eli7aabi ba imota ehis.<verse eid="NUM 7:24-29" /></para>
  <para style="p">
    <verse number="30-35" style="v" sid="NUM 7:30-35" />Oyddantho gallasan Robeela, kochaafe Shade7ura na7ay Elizuuri ba imota ehis.<verse eid="NUM 7:30-35" /></para>
  <para style="p">
    <verse number="36-40" style="v" sid="NUM 7:36-40" />Ichashantho gallasan Simoona kochaafe Zurishadaya na7ay Salumi7eeli ba imota ehis.<verse eid="NUM 7:36-40" /></para>
  <para style="p">
    <verse number="41-47" style="v" sid="NUM 7:41-47" />Usupuntho gallasan Gaade kochaafe Ragu7eela na7ay Eliyasaafi ba imota ehis.<verse eid="NUM 7:41-47" /></para>
  <para style="p">
    <verse number="48-53" style="v" sid="NUM 7:48-53" />Laapuntha gallasan Efreema kochaafe Amhuda na7ay Elishama7i ba imota ehis.<verse eid="NUM 7:48-53" /></para>
  <para style="p">
    <verse number="54-59" style="v" sid="NUM 7:54-59" />Hospuntha gallasan Minaase kochaafe Padazuura na7ay Gamali7eeli ba imota ehis.<verse eid="NUM 7:54-59" /></para>
  <para style="p">
    <verse number="60-65" style="v" sid="NUM 7:60-65" />Uddufuntho gallasan Biniyaame kochaafe Gida7oona na7ay Abdaani ba imota ehis.<verse eid="NUM 7:60-65" /></para>
  <para style="p">
    <verse number="66-71" style="v" sid="NUM 7:66-71" />Tammantho gallasan Daane kochaafe Amsadaya na7ay Aki7ezeri ba imota ehis.<verse eid="NUM 7:66-71" /></para>
  <para style="p">
    <verse number="72-77" style="v" sid="NUM 7:72-77" />Tammanne issintho gallasan Aseera kochaafe Okraana na7ay Pagi7eeli ba imota ehis.<verse eid="NUM 7:72-77" /></para>
  <para style="p">
    <verse number="78-83" style="v" sid="NUM 7:78-83" />Tammanne nam7antho gallasan Niftaaleme kochaafe Enaana na7ay Akira ba imota ehis.<verse eid="NUM 7:78-83" /></para>
  <para style="p">
    <verse number="84" style="v" sid="NUM 7:84" />Yarsho bessay tiyetiya wode Godaas dummayanaw Isra7eele halaqati ehida imotay haysafe kaallidi de7eysa.</para>
  <para style="p" vid="NUM 7:84">Birape oosetida tammanne nam7u picca saanetanne ollatiya saaneta; worqafe oosetida tammanne nam7u ixaaney kumida shaateta ehidosona. <verse eid="NUM 7:84" /><verse number="85" style="v" sid="NUM 7:85" />Issoy issoy 1,500 giraame birape oosetida picca Saane; qassi issoy issoy 800 giraame birape oosetida ollatiya saane, geeshsha dunkaanen eretida mizaanen he ubbaa 28 kilo giraame ehidosona. <verse eid="NUM 7:85" /><verse number="86" style="v" sid="NUM 7:86" />Ixaaney kumida tammanne nam7u worqa shaateta 1.4 kilo giraame geeshsha dunkaanen eretida mizaanen shiishidosona. <verse eid="NUM 7:86" /><verse number="87" style="v" sid="NUM 7:87" />Xuussa yarshos shiiqida mehey katha yarshuwara wolla tammanne nam7u wofaanota, tammanne nam7u maraze, tammanne nam7u issi laytha urge dorsinne, tammanne nam7u koleta nagara yarshos shiishidosona. <verse eid="NUM 7:87" /><verse number="88" style="v" sid="NUM 7:88" />Issifetetha yarshos laatamanne oyddu boorati, usupun tammu marazeta, usupun tammu koleta, usupun tammu issi laytha urge dorsata shiishidosona. Geeshsha Dunkaaniya dummayanaw tiya wode shiiqida yarshoti haysata.<verse eid="NUM 7:88" /></para>
  <para style="p">
    <verse number="89" style="v" sid="NUM 7:89" />Musey Godaara odetanaw Geeshsha Dunkaaniya geliya wode caaqo taabotiya kamaa bolla de7iya nam7u kiruubetape giddon gididi Goday odishin si7is.<verse eid="NUM 7:89" /></para>
  <chapter eid="NUM 7" />
  <chapter number="8" style="c" sid="NUM 8" />
  <para style="s1">Xompeta Utetha Maara</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 8:1" />Goday Museko, <verse eid="NUM 8:1" /><verse number="2" style="v" sid="NUM 8:2" />“Aaroni laapun xompeta kocaa bolla wothiya wode poo7oy sintha baggara de7iya heera poo7isana mela oothidi wotho gada oda” yaagis.<verse eid="NUM 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 8:3" />Goday Muse kiitidaysada, Aaroni xompeta kocaa bolla wothidi sintha baggara de7iya heera poo7isana mela oothis. <verse eid="NUM 8:3" /><verse number="4" style="v" sid="NUM 8:4" />Xompe wothiya kocay, Goday Muse bessidaysada toomape bidi bolla ciishsha gakanaw qoxetida worqafe oosetis.<verse eid="NUM 8:4" /></para>
  <para style="s1">Leeweta geeshsho Woga</para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 8:5" />Goday Museko, <verse eid="NUM 8:5" /><verse number="6" style="v" sid="NUM 8:6" />“Isra7eele asaa giddofe Leeweta shaakada wogaada enta geeshsha. <verse eid="NUM 8:6" /><verse number="7" style="v" sid="NUM 8:7" />Neeni enta geeshshanaw haysada ootha; geeshshiya haatha ekada enta bolla wurxa; enti banta asatethaa ubbaa meedeto; banta ma7uwa meecco; yaanidi enti wogaada geeshshi gidana. <verse eid="NUM 8:7" /><verse number="8" style="v" sid="NUM 8:8" />Kaallidi enti issi wofaanonne katha yarshos gidiya zaytera walahetida lo77o dhiille eko; qassi neeni nagara yarshos hara issi wofaano eka. <verse eid="NUM 8:8" /><verse number="9" style="v" sid="NUM 8:9" />Hessafe guye Isra7eele asa ubbaa shiishada, Leeweta Geeshsha Dunkaaniya sinthe ehada essa. <verse eid="NUM 8:9" /><verse number="10" style="v" sid="NUM 8:10" />Isra7eele asay enta huuphiya bolla banta kushiya wotho. <verse eid="NUM 8:10" /><verse number="11" style="v" sid="NUM 8:11" />Leeweti Isra7eele asaa giddofe taw dummatidi oothana mela yuusho yarsho oothidi Aaroni ta sinthe shiisho. <verse eid="NUM 8:11" /><verse number="12" style="v" sid="NUM 8:12" />Leeweti banta kushiya nam7u wofaanota huuphen wotho. Leeweta nagara atotethas issuwa nagara yarsho, qassi hankuwa xuussa yarsho oothada Godaas yarsha.<verse eid="NUM 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 8:13" />“Leeweta shaakada taw dummaya; Aaronanne iya adde nayta enta bolla shuuma. <verse eid="NUM 8:13" /><verse number="14" style="v" sid="NUM 8:14" />Hessada oothada Leeweta Isra7eele asape taw dummaya; enti tabaa gidana.<verse eid="NUM 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 8:15" />“Neeni enta geeshshidaapenne dummayidaape guye Leeweti Geeshsha Dunkaaniyan banta oosuwa oothanaw yo. <verse eid="NUM 8:15" /><verse number="16" style="v" sid="NUM 8:16" />Isra7eele asaa giddofe kumethi enti taw imetidosona; Isra7eelen bayra yeletida adde nayta bessan Leeweta taw ekas. <verse eid="NUM 8:16" /><verse number="17" style="v" sid="NUM 8:17" />Isra7eele asaa giddon bayra yeletida ase gidin mehe gidin ubbay tabaa. Taani Gibxe biittan bayra ubbaa wodhida wode enta taw dummayas. <verse eid="NUM 8:17" /><verse number="18" style="v" sid="NUM 8:18" />Isra7eelen bayra yeletida adde nayta bessan taw Leeweta ekas. <verse eid="NUM 8:18" /><verse number="19" style="v" sid="NUM 8:19" />Isra7eele asaa giddofe Leeweta Aaronasinne iya adde naytas immas. Isra7eele asay Geeshsha Dunkaaniyako shiiqidi qohetonna mela Leeweti Isra7eele asaa gisho Geeshsha Dunkaaniyan oothanawunne nagara atotethi ehanaw dooretidosona” yaagis.<verse eid="NUM 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 8:20" />Goday Muse kiitidaysada, Musey, Aaroninne Isra7eele asa ubbay Leeweta dummayidosona. <verse eid="NUM 8:20" /><verse number="21" style="v" sid="NUM 8:21" />Leeweti bantana geeshshidosona; banta ma7uwa meeccidosona. Aaroni enta Godaas dumma imo oothidi shiishis; entaw nagara atotethas yarshidi enta geeshshis. <verse eid="NUM 8:21" /><verse number="22" style="v" sid="NUM 8:22" />Hessafe guye, Leeweti Aaronanne iya adde nayta aawatetha garsan gididi Geeshsha Dunkaaniya giddon banta oosuwa oothanaw yidosona. Goday Muse Leeweta dummayanaw kiitidaysada enti oothidosona.<verse eid="NUM 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 8:23" />Goday Museko, <verse eid="NUM 8:23" /><verse number="24" style="v" sid="NUM 8:24" />“Haysi Leeweti oothana wogaa; laythi laatamanne ichashanne iyape bolla gidida Leewe adde ubbay Geeshsha Dunkaaniyan oothanaw yo. <verse eid="NUM 8:24" /><verse number="25" style="v" sid="NUM 8:25" />Shin laythi ishatamu gidiya wode banta oosuwape shempo; zaari oothofo. <verse eid="NUM 8:25" /><verse number="26" style="v" sid="NUM 8:26" />Enti Geeshsha Dunkaaniyan oothiya banta ishata oothi maaddanaw danda7oosona. Shin enti bantaw ay oosoka oothofo. Hiza neeni Leeweta haysada oosisa” yaagis.<verse eid="NUM 8:26" /></para>
  <chapter eid="NUM 8" />
  <chapter number="9" style="c" sid="NUM 9" />
  <para style="s1">Paasika Ba7aale</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 9:1" />Isra7eele asay Gibxefe keyida nam7antho laythan koyro ageenan Siina mela biittan Goday Museko haysada yaagis; <verse eid="NUM 9:1" /><verse number="2" style="v" sid="NUM 9:2" />“Isra7eele asay Paasika Ba7aale iya qamman boncho. <verse eid="NUM 9:2" /><verse number="3" style="v" sid="NUM 9:3" />Ha ageenan tammanne oyddantho gallasan iya qamman omarsi iya woga ubbaadanne iya kiita ubbaada boncho” yaagis. <verse eid="NUM 9:3" /><verse number="4" style="v" sid="NUM 9:4" />Hessa gisho, Musey Isra7eele asay Paasika Ba7aale bonchana mela entaw odis. <verse eid="NUM 9:4" /><verse number="5" style="v" sid="NUM 9:5" />Goday Muse kiitidaysada, Isra7eele asay koyro ageenan tammanne oyddantho gallasan, omarsi Siina mela biittan Paasika Ba7aale bonchidosona.<verse eid="NUM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 9:6" />Shin entafe baggati aha bochidi tunida gisho he gallas Paasika Ba7aale bonchanaw danda7ibookona. Hessa gisho, enti he gallas Musekonne Aaronako yidi, <verse eid="NUM 9:6" /><verse number="7" style="v" sid="NUM 9:7" />“Nuuni aha bochida gisho tunida, shin he qamman hara Isra7eele asaara Godaas yarsho yarshonna mela ayis digetido?” yaagidosona.<verse eid="NUM 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 9:8" />Musey zaaridi, “Goday hintebaa taw odana gakanaw gam7ishite” yaagis.<verse eid="NUM 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 9:9" />Goday Museko, <verse eid="NUM 9:9" /><verse number="10" style="v" sid="NUM 9:10" />“Isra7eele asaako haysada yaaga; hintefe woyko hinte kochaafe oonika aha bochidi tuniko woyko ogetidabaa gidiko, Paasika Ba7aale bonchanaw danda7ees. <verse eid="NUM 9:10" /><verse number="11" style="v" sid="NUM 9:11" />Nam7antho ageenan tammanne oyddantho gallas omarsi Paasika Ba7aale boncho. Paasika dorsa uytharanne camo boncora mo. <verse eid="NUM 9:11" /><verse number="12" style="v" sid="NUM 9:12" />Sa7ay wontana gakanaw dorsa ashuwape aybika attofo; qassi iya meqethafe issuwaka menthofo. Paasika Baaliya woga ubbaa ootho. <verse eid="NUM 9:12" /><verse number="13" style="v" sid="NUM 9:13" />Shin geeshshinne ogetonna as Paasika bonchona ixiko, I ta asaa giddofe kuretto. Godaa yarshuwa iya qamman yarshiboona gisho ba nagaraa gisho pirda ekees.<verse eid="NUM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 9:14" />“Hinte giddon de7iya bete asi Paasika Ba7aale bonchanaw koyko, Paasika wogaada boncho. Betanchoynne biitta aawu na7i ubbay he wogaatho ootho” yaagis.<verse eid="NUM 9:14" /></para>
  <para style="s1">Tama Shaara</para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 9:15" />Geeshsha Dunkaaney toketida gallas shaaray Geeshsha Dunkaaniya ma7is. Omarsafe doomidi, wonta gakanaw Geeshsha Dunkaaniya bollara de7iya shaaray tama daanees. <verse eid="NUM 9:15" /><verse number="16" style="v" sid="NUM 9:16" />Hessada gallas gallas shaaray ma77ees; qamma qamma he shaaray tamada poo7ees. <verse eid="NUM 9:16" /><verse number="17" style="v" sid="NUM 9:17" />He shaaray Geeshsha Dunkaaniya bollafe dendiya wode ubban Isra7eele asay banta dunkaanida gutaape dendoosona. Qassi he shaaray wodhiya bessan Isra7eele asay dunkaanosona. <verse eid="NUM 9:17" /><verse number="18" style="v" sid="NUM 9:18" />Isra7eele asay Godaa kiitan gutaape dendoosona; qassi Godaa kiitan dunkaanosona. Shaaray Geeshsha Dunkaaniya bolla gam7iya wode ubban banta dunkaanida gutan gam7oosona. <verse eid="NUM 9:18" /><verse number="19" style="v" sid="NUM 9:19" />Shaaray Geeshsha Dunkaaniya bolla daro gallas gam7ikoka, Isra7eele asay Godaa kiita naagosonape attishin, awuka bookona. <verse eid="NUM 9:19" /><verse number="20" style="v" sid="NUM 9:20" />Issi issi toho shaaray Geeshsha Dunkaaniya bolla guutha gallas gam7ees. Gidikoka enti Godaa kiitan dunkaanosona; qassi Godaa kiitan gutaape dendoosona. <verse eid="NUM 9:20" /><verse number="21" style="v" sid="NUM 9:21" />Issi issi toho shaaray omarsafe wontana gakanaw xalaala gam7ees; shaaray dendiya wode enti dendoosona. Gallas gidin, qamma gidin, shaaray dendiya wode enti dendoosona. <verse eid="NUM 9:21" /><verse number="22" style="v" sid="NUM 9:22" />Shaaray Geeshsha Dunkaaniya bolla nam7u gallas gidin woyko issi ageena woyko issi laythi gam7in Isra7eele asay banta dunkaanida gutan gam7osonape attishin, bookona. Shin shaaray dendiya wode entika dendoosona. <verse eid="NUM 9:22" /><verse number="23" style="v" sid="NUM 9:23" />Goday Muse Kiittidaysada enti Godaa kiitan dunkaanosona qassi Godaa kiitan gutaape dendidi boosona.<verse eid="NUM 9:23" /></para>
  <chapter eid="NUM 9" />
  <chapter number="10" style="c" sid="NUM 10" />
  <para style="s1">Bira Biratape Oosetida Moyzeta</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 10:1" />Goday Museko, <verse eid="NUM 10:1" /><verse number="2" style="v" sid="NUM 10:2" />asaa shiiqos xeeganawunne dunkaanida gutaape denthanaw maaddiya nam7u moyzeta birape qoxada medha. <verse eid="NUM 10:2" /><verse number="3" style="v" sid="NUM 10:3" />Ha nam7u moyzeti punetiya wode asa ubbay Geeshsha Dunkaaniya pengen neeko shiiqo. <verse eid="NUM 10:3" /><verse number="4" style="v" sid="NUM 10:4" />Shin issi moyze xalaali punetiko, Isra7eele kochaa halaqati ne sinthe shiiqo. <verse eid="NUM 10:4" /><verse number="5" style="v" sid="NUM 10:5" />Moyzey koyro punetiya wode Geeshsha Dunkaaniyape doloha baggan dunkaanida kochay dendo. <verse eid="NUM 10:5" /><verse number="6" style="v" sid="NUM 10:6" />Moyzey nam7antho punetiya wode dugeha baggan dunkaanida kochay dendo. Moyzey hessatho punetiya wode gutaape dendanaw malla gido. <verse eid="NUM 10:6" /><verse number="7" style="v" sid="NUM 10:7" />Asa shiishanaw moyze punna, shin hankoysada dumma mallara punnofa. <verse eid="NUM 10:7" /><verse number="8" style="v" sid="NUM 10:8" />Kahineti, Aarona nayti moyze punno. Haysi newunne yaana yeletetha ubbaas merina woga gido.<verse eid="NUM 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 10:9" />“Hinte gadiya bolla ola denthida hinte morkiyara hinte oletanaw keyiya wode he moyzeta goochidi punnite. He wode Goday, hinte Xoossay hintena akeekidi, hinte morketape ashshana. <verse eid="NUM 10:9" /><verse number="10" style="v" sid="NUM 10:10" />Hinte ufaysa gallasatan hessika ageena xeeron, eretida ba7aaletan, xuussa yarsho wodeninne issifetetha yarsho wode moyze punnite. Hessi Xoossaa sinthan hintena akeekisiyaba gidana. Taani Godaa, hinte Xoossaa” yaagis.<verse eid="NUM 10:10" /></para>
  <para style="s1">Isra7eeleti Siina Yeddidi Denduwa</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 10:11" />Asay Gibxefe keyin, nam7antho laythan, nam7antho ageenan, laatamantho gallasan, shaaray Geeshsha Dunkaaniya bollafe dendis. <verse eid="NUM 10:11" /><verse number="12" style="v" sid="NUM 10:12" />Yaatin asay Siina mela biittafe maaran maaran dendidosona; shaaray Paarana mela biitta gakidi wodhis. <verse eid="NUM 10:12" /><verse number="13" style="v" sid="NUM 10:13" />Goday Muse kiitidaysada enti baanaw koyro dendidosona.<verse eid="NUM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 10:14" />Koyro Yihuda kochaa baggan dunkaanida kochay banta mala ekidi keyidosona. Entana kaalethey Amnadaabe na7aa Na7asoona. <verse eid="NUM 10:14" /><verse number="15" style="v" sid="NUM 10:15" />Yisakoora kochaa kaalethey Zu7ara na7aa Natina7eela. <verse eid="NUM 10:15" /><verse number="16" style="v" sid="NUM 10:16" />Zabloona kochaa kaalethey Heloona na7aa Eli7aaba.<verse eid="NUM 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 10:17" />Yaatin, Geeshsha Dunkaaney shodetin, Gedisoona kochatinne Meraara kochati tookidi dendidosona.<verse eid="NUM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 10:18" />Kaallidi Robeela kochaa baggan dunkaanida kochay banta mala oykide keyidosona. Robeela kochaa kaalethey Shade7ura na7aa Elizuura. <verse eid="NUM 10:18" /><verse number="19" style="v" sid="NUM 10:19" />Simoona kochaa kaalethey Zurishadaya na7aa Salumi7eela. <verse eid="NUM 10:19" /><verse number="20" style="v" sid="NUM 10:20" />Gaade kochaa kaalethey Ragu7eela na7aa Eliyasaafa.<verse eid="NUM 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 10:21" />Yaatin Qahaata kochay geeshsha miisheta tookidi dendidosona. Enti kaalliya guta gakanaape sinthe Geeshsha Dunkaaney toketidi uttees.<verse eid="NUM 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 10:22" />Kaallidi Efreema kochaa baggan dunkaanida kochati banta malla oykidi keyoosona. Efreema kochaa kaalethey Amhuda na7aa Elishama7a. <verse eid="NUM 10:22" /><verse number="23" style="v" sid="NUM 10:23" />Minaase kochaa kaalethey Padazuura na7aa Gamali7eela. <verse eid="NUM 10:23" /><verse number="24" style="v" sid="NUM 10:24" />Biniyaame kochaa kaalethey Gadiyoona na7aa Abdaana.<verse eid="NUM 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 10:25" />Wursethan Daane kochaa baggan dunkaanida kochay, ubbaas guye baggara kate gididi, banta malaoykidi keyidosona. Daane kochaa kaalethey Amsadaya na7aa Aki7ezera. <verse eid="NUM 10:25" /><verse number="26" style="v" sid="NUM 10:26" />Aseera kochaa kaalethey Okraana na7aa Pagi7eela. <verse eid="NUM 10:26" /><verse number="27" style="v" sid="NUM 10:27" />Niftaaleme kochaa kaalethey Enaana na7aa Akira. <verse eid="NUM 10:27" /><verse number="28" style="v" sid="NUM 10:28" />Isra7eele asay banta zerethan zerethan gutaape dendidi biya maaray hessa.<verse eid="NUM 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 10:29" />Musey Midiyaame addiya Ragu7eela na7aa Hobaabako, “Goday nuus immana gida biitta laattanaw boos; Goday Isra7eele anjana gida gisho nuura yedha; nuuni new lo77oba oothana” yaagis.<verse eid="NUM 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 10:30" />Yaatin Hobaabi, “Akay, taani ta biitta ta dabbotako baana” yaagis.<verse eid="NUM 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 10:31" />Musey zaaridi, “Hayyana, nuna yeggada boopa. Nu biya mela biittan nuuni dunkaanana bessaa ne eraasa; nu baana ogiya nuna kaalethanaw danda7aasa. <verse eid="NUM 10:31" /><verse number="32" style="v" sid="NUM 10:32" />Neeni nuura biiko, Goday nuus immiya anjuwa ubbaa Nu new shaakana” yaagis.<verse eid="NUM 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 10:33" />Asay Godaa zumaape dendidi, heedzu gallasa oge bidosona. Godaa caaqo Taabotey enti shempana bessi koyishe heedzu gallas entafe sinthe sinthe bis. <verse eid="NUM 10:33" /><verse number="34" style="v" sid="NUM 10:34" />Enti dunkaanida gutaape dendiya wode ubban Godaa shaaray gallas gallas entafe bollara de7ees. <verse eid="NUM 10:34" /><verse number="35" style="v" sid="NUM 10:35" />Taabotey dendiya wode ubban Musey, “Abeeti Godaw, denda; ne morketi laaleto; nena ixeysati ne sinthafe baqato” yaagees. <verse eid="NUM 10:35" /><verse number="36" style="v" sid="NUM 10:36" />Taabotey shempiya wode ubban Musey, “Abeeti Godaw, daro mukulan taybetiya Isra7eele asaako simma” yaagees.<verse eid="NUM 10:36" /></para>
  <chapter eid="NUM 10" />
  <chapter number="11" style="c" sid="NUM 11" />
  <para style="s1">Godaape Yida Tama</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 11:1" />Isra7eele asay bantana gakida metuwan Godaa bolla zuuzumidosona. Enta zuuzuntha Goday si7ida wode iya hanqoy eexin, xuuggiya tama enta bolla yeddis; he tamay enti dunkaanida gutaape issi bagga gaxaa mis. <verse eid="NUM 11:1" /><verse number="2" style="v" sid="NUM 11:2" />Yaatin Musey enta gisho Godaa woossana mela enti Museko yidi yeekidosona. Musey woossin tamay to7is. <verse eid="NUM 11:2" /><verse number="3" style="v" sid="NUM 11:3" />Godaa tamay enta giddon eexida gisho, he bessay Tabeera<note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="fqa" closed="false">Tabeera: </char><char style="ft" closed="false">Guussay “Tama xuussi” guussu.</char></note> geetetidi xeegetis.<verse eid="NUM 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 11:4" />Isra7eeletara Gibxefe keyida dumma dumma derey hara kathi maanaw daro amotidosona. Enti, “Nu asho awupe demmanee? <verse eid="NUM 11:4" /><verse number="5" style="v" sid="NUM 11:5" />Nuuni Gibxen de7iya wode miishe qanxonna miya moluwa, leehiya, habaabe, shunkurte, miskati bayna shunkurtenne tuumuwa hassayoos. <verse eid="NUM 11:5" /><verse number="6" style="v" sid="NUM 11:6" />Shin ha77i nu qoodhey gordetis; nu ayfeyka ha mannafe attishin, haraba aybaka be7enna” yaagidi yeekidosona.<verse eid="NUM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 11:7" />Mannay deebbo ayfe daanees; iya malay bootha adil7e ciishshe daanees. <verse eid="NUM 11:7" /><verse number="8" style="v" sid="NUM 11:8" />Mannay qamma wodhees; asay yuuyidi iya maxidi woxan gaaccidi woyko udulan caddidi kathoosona. Yaatidi uukosona; iya mal7oy shamaho zaytera uuketida uytha mela. <verse eid="NUM 11:8" /><verse number="9" style="v" sid="NUM 11:9" />Manni qamma enta gutan akara wodhees.<verse eid="NUM 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 11:10" />Asay banta dunkaaniya pengen pengen eqidi yeekishin Musey si7is. Enti Godaa hanquwa denthethida gisho, Musey un7etis. <verse eid="NUM 11:10" /><verse number="11" style="v" sid="NUM 11:11" />Musey Godaako, “Ne aylliya, ta bolla ayis ha metuwa ehadii? Ne tanan ayis ufaytabikii? Ne ha asa ubbaa toohuwa ta bolla ayis wothadii? <verse eid="NUM 11:11" /><verse number="12" style="v" sid="NUM 11:12" />Ha asa ubbaa ta qanthatadinayee? Woyko enta ta yeladinaayee? Ne enta mayzatas, immana gada caaqida biitta gatho gada na7a idimmada dichiya aseeda ta ki7on ayis enta yeggadii? <verse eid="NUM 11:12" /><verse number="13" style="v" sid="NUM 11:13" />Ha asa ubbaas ta asho awupe ehanee? Enti taako yidi, ‘Maanaw nuus asho imma’ yaagidi yeekosona. <verse eid="NUM 11:13" /><verse number="14" style="v" sid="NUM 11:14" />Taani ha asa ubbaa tarka tookanaw danda7ike; taw hessi deexo tooho. <verse eid="NUM 11:14" /><verse number="15" style="v" sid="NUM 11:15" />Hiza neeni tana haysada oothanaape taw qadheta; ha77i tana wodha; ha metuwape ta shempa aggana” yaagis.<verse eid="NUM 11:15" /></para>
  <para style="s1">Laapun Tammu Asaa Dooretetha</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 11:16" />Goday Museko, “Asaa kaalethanaw danda7iya Isra7eele halaqatape laapun tammu cimata doora. Enta Geeshsha Dunkaaniyako ehada ne matan essa. <verse eid="NUM 11:16" /><verse number="17" style="v" sid="NUM 11:17" />Taani wodhada neera yan odetana; ta new immida Ayyaanape shaakada enta bolla wothana. Neeni asaa toohuwa nerka tookonna mela enti nena maaddana.<verse eid="NUM 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 11:18" />“Neeni asaako haysada yaaga; ‘Wonto hinte asho maana gisho hintena geeshshite. Nu asho awupe demmanee? Nuus Gibxen sa7i lo77oshin’ yaagidi hinte yeekida yeehuwa Goday si7is. Ha77i Goday asho immana; hinteka maana. <verse eid="NUM 11:18" /><verse number="19" style="v" sid="NUM 11:19" />Hinte maanay issi gallas woyko nam7u gallas woyko ichashu gallas woyko tammu gallas woyko laatamu gallas xalaala gidenna. <verse eid="NUM 11:19" /><verse number="20" style="v" sid="NUM 11:20" />Shin ‘Hinte giddon de7iya Godaa hinte kadhida gishonne Gibxefe keyonna attidaako nuus lo77oshin gida gisho, hintew siidhera keyana gakanawunne hinte saletana gakanaw issi ageena kumethi hinte asho maana’ yaaga” yaagis.<verse eid="NUM 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 11:21" />Shin Musey Godaako, “Heko, ta 600,000 asaa kaalethashe de7ayis. Neeni issi ageena kumethi enti asho maana mela immana gaasa. <verse eid="NUM 11:21" /><verse number="22" style="v" sid="NUM 11:22" />Miiza wudenne dorsa wude ubbaa shukin entaw gidanee? Abban de7iya molo ubbaa shiishiyako entaw gidanee?” yaagis.<verse eid="NUM 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 11:23" />Yaatin, Goday Museko, “Godaa kushey qantheyee? Taani new odiyabay tumeekonne wordoko neeni ha77i be7ana” yaagis.<verse eid="NUM 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 11:24" />Hessa gisho, Musey kare keyidi, Goday gidaysa asaas odis. Isra7eele cimatape laapun tammu asaa shiishidi, Geeshsha Dunkaaniya yuushon essis. <verse eid="NUM 11:24" /><verse number="25" style="v" sid="NUM 11:25" />Yaatin, Goday shaarara wodhidi iyara odetis; iya bolla de7iya Ayyaanape ekidi, he laapun tammu cimata bolla wothis. Ayyaanay enta bolla shempida wode enti nabeda tinbite odidosona. Shin hessafe guye, zaaridi tinbite odibookona.<verse eid="NUM 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 11:26" />He laapun tammu cimatara xaafetida asatape Eldaadanne Modaada geetetiya nam7ati dunkaanida gutan attidi Geeshsha Dunkaaniyako yibookona. Shin enta bollaka Ayyaanay wodhin, dunkaanida gutan tinbite odidosona. <verse eid="NUM 11:26" /><verse number="27" style="v" sid="NUM 11:27" />Issi pantha addey Museko woxi yidi, “Eldaadinne Modaadi dunkaanida gutan tinbite odoosona” yaagis.<verse eid="NUM 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 11:28" />Yaanin, ba na7atethafe doomidi, Muse maaddiya Nawe na7aa Iyyasuy Museko, “Ta godaw, Muse, enta teqa” yaagis.<verse eid="NUM 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 11:29" />Shin Musey zaaridi, “Ta gisho ne qanaatay? Goday ba asa ubbaa bolla ba ayyaana wothidi nabeda tinbite odisiyaba gidiyako ta ufaytayis” yaagis. <verse eid="NUM 11:29" /><verse number="30" style="v" sid="NUM 11:30" />Yaatidi, Museynne Isra7eele cimati dunkaanida gutaa simmidosona.<verse eid="NUM 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 11:31" />Qoponna Goday carko denthidi, sa7ape nam7u wadha mela dhoqu gidi piradhiya kuraachota abbafe ehis. Enta dunkaaniya yuushuwan ubba baggara issi gallasa oge mela sa7an wodhidosona. <verse eid="NUM 11:31" /><verse number="32" style="v" sid="NUM 11:32" />He gallasinne he qamma ubbaa, qassi wontetha gallasika asay kare keyidi, he kuraachota oykidi shiishidosona. Entafe oonika 10 kilo giraamepe guuthu shiishibenna. Enti dunkaaniya guta yuushon melisanaw miccidosona. <verse eid="NUM 11:32" /><verse number="33" style="v" sid="NUM 11:33" />Shin ashoy buroo enta doonan de7ishininne meetetidi wuronna de7ishin, Godaa hanqoy asaa bolla eexis; Goday asaa wolqaama boshan shocis. <verse eid="NUM 11:33" /><verse number="34" style="v" sid="NUM 11:34" />Asho amotidi hayqida asaa enti he bessan moogida gisho he bessay Kebroot-Hataaba<note caller="+" style="f"><char style="fr" closed="false">11:34 </char><char style="fqa" closed="false">Kebroot-Hataaba: Ha sunthaa birshethay “Amo duufo” guussu.</char></note> geetetidi sunthetis. <verse eid="NUM 11:34" /><verse number="35" style="v" sid="NUM 11:35" />Asay he bessaafe dendi bidi Haxeroota geetetiya bessan dunkaanidosona.<verse eid="NUM 11:35" /></para>
  <chapter eid="NUM 11" />
  <chapter number="12" style="c" sid="NUM 12" />
  <para style="s1">Aaroninne Mayraama Musera Eqetidosona</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 12:1" />Musey Tophe biitta maccas ekida gisho, Mayraamanne Aaroni Muse yaagidi boridosona. <verse eid="NUM 12:1" /><verse number="2" style="v" sid="NUM 12:2" />“Goday Muse baggara xalaala odetidee? I nu baggara odibeennee?” yaagidosona. Goday enti gidaysa si7is. <verse eid="NUM 12:2" /><verse number="3" style="v" sid="NUM 12:3" />Musey biittan de7iya asa ubbaafe aadhiya aada asi.<verse eid="NUM 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 12:4" />Qoponna Goday Muse, Aaronanne Mayraamo, “Hinte heedzati Geeshsha Dunkaaniyako keyte” yaagis. Entika keyidosona. <verse eid="NUM 12:4" /><verse number="5" style="v" sid="NUM 12:5" />Goday shaara tuussara wodhidi Geeshsha Dunkaaniya pengen eqidi, Aarona! Mayraame! yaagidi xeegis. Enti nam7ay iya sinthe shiiqin, <verse eid="NUM 12:5" /><verse number="6" style="v" sid="NUM 12:6" />Goday, “Ta odeysa si7ite; hinte giddon nabey de7iko, ta iyaw qoncayis; qassi iyaw amuhon odayis. <verse eid="NUM 12:6" /><verse number="7" style="v" sid="NUM 12:7" />Shin ta aylley Muse hessada gidenna; I ta keetha ubban ammanetidaysa. <verse eid="NUM 12:7" /><verse number="8" style="v" sid="NUM 12:8" />Taani Musera som7on odetasipe attishin, leemison odike. I ta malaa be7ees. Yaatin, hinte ta aylliya Muse boranaw ayis yayyibeketii?” yaagis.<verse eid="NUM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 12:9" />Godaa hanqoy enta bolla eexin, I enta aggidi bis. <verse eid="NUM 12:9" /><verse number="10" style="v" sid="NUM 12:10" />Shaaray Geeshsha Dunkaaniya bollafe dendida wode Mayraama baro hargen milxi gada booxasu. Aaroni iiko simmidi xeelliya wode baro hargen oyketidaaro be7is. <verse eid="NUM 12:10" /><verse number="11" style="v" sid="NUM 12:11" />Aaroni Museko, “Hay ta godaw, nuuni eeyatethan oothida nagaraas nuna haysada seeropa. <verse eid="NUM 12:11" /><verse number="12" style="v" sid="NUM 12:12" />Iyo ba aaye ulope keyiya wode I asatethafe baggay meetetin, hayqidi yeletida na7a mela oothofa” yaagis.<verse eid="NUM 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 12:13" />Yaatin, Musey, “Abeeti Godaw, iyo patharki” yaagidi Godaa woossis.<verse eid="NUM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 12:14" />Goday Museko, “I aaway I som7on cuttiyaba gidiyako, iya laapun gallas yeellara gam7awusu gidikee? Hessa gisho, laapun gallas dunkaaniya gutaape iyo gaxa kessada dumma bessan wotha; hessafe guye, simmada yo” yaagis. <verse eid="NUM 12:14" /><verse number="15" style="v" sid="NUM 12:15" />Yaatin, Mayraama dunkaaniya gutaape gaxa keyada laapun gallas uttasu. Iya simmana gakanaw asay gutaa aggidi baanaw dendibeenna. <verse eid="NUM 12:15" /><verse number="16" style="v" sid="NUM 12:16" />Hessafe guye, asay Haxeroota geetetiya bessaafe dendidi, Paarana mela biittan dunkaanidosona.<verse eid="NUM 12:16" /></para>
  <chapter eid="NUM 12" />
  <chapter number="13" style="c" sid="NUM 13" />
  <para style="s1">Kanaane Wochanaw Kiitetida Asata</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 13:1" />Goday Museko, <verse eid="NUM 13:1" /><verse number="2" style="v" sid="NUM 13:2" />“Taani Isra7eeletas immana Kanaane biitta wochana mela tammanne nam7u Isra7eele kochaafe issi issi asi halaqa oothada kiitta” yaagis.<verse eid="NUM 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 13:3" />Yaatin Musey Goday kiitidaysada Paarana mela biittafe Isra7eele kochaafe tammanne nam7u halaqata kiittis. <verse eid="NUM 13:3" /><verse number="4" style="v" sid="NUM 13:4" />Enta sunthay haysafe kaallidi xaafetidaysata.</para>
  <para style="li1" vid="NUM 13:4">Robeela kochaafe Zakura na7aa Samu7a;<verse eid="NUM 13:4" /></para>
  <para style="li1">
    <verse number="5" style="v" sid="NUM 13:5" />Simoona kochaafe Hoora na7aa Shaafaxa;<verse eid="NUM 13:5" /></para>
  <para style="li1">
    <verse number="6" style="v" sid="NUM 13:6" />Yihuda kochaafe Yoofona na7aa Kaaleba;<verse eid="NUM 13:6" /></para>
  <para style="li1">
    <verse number="7" style="v" sid="NUM 13:7" />Yisakoora kochaafe Yoosefa na7aa Yigi7aala;<verse eid="NUM 13:7" /></para>
  <para style="li1">
    <verse number="8" style="v" sid="NUM 13:8" />Efreema kochaafe Nawe na7aa Awuse;<verse eid="NUM 13:8" /></para>
  <para style="li1">
    <verse number="9" style="v" sid="NUM 13:9" />Biniyaame kochaafe Raafu na7aa Falxa;<verse eid="NUM 13:9" /></para>
  <para style="li1">
    <verse number="10" style="v" sid="NUM 13:10" />Zabloona kochaafe Sooda na7aa Gadi7eela;<verse eid="NUM 13:10" /></para>
  <para style="li1">
    <verse number="11" style="v" sid="NUM 13:11" />Yoosefa na7aa Minaase kochaafe Suusa na7aa Gaade;<verse eid="NUM 13:11" /></para>
  <para style="li1">
    <verse number="12" style="v" sid="NUM 13:12" />Daane kochaafe Gamaala na7aa Ami7eela;<verse eid="NUM 13:12" /></para>
  <para style="li1">
    <verse number="13" style="v" sid="NUM 13:13" />Aseera kochaafe Mika7eela na7aa Satura;<verse eid="NUM 13:13" /></para>
  <para style="li1">
    <verse number="14" style="v" sid="NUM 13:14" />Niftaaleme kochaafe Waafisa na7aa Nahiba;<verse eid="NUM 13:14" /></para>
  <para style="li1">
    <verse number="15" style="v" sid="NUM 13:15" />Gaade kochaafe Maka na7aa Ge7u7eela.<verse eid="NUM 13:15" /></para>
  <para style="m">
    <verse number="16" style="v" sid="NUM 13:16" />He biitta wochana mela Musey kiitida asata sunthay haysata. Musey Nawe na7aa Awuse sunthaa Iyyasu gidi sunthaa laammis.<verse eid="NUM 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 13:17" />Musey enta, “Negebe mela biitta kanthidi pude derey dariya biitta keyte. <verse eid="NUM 13:17" /><verse number="18" style="v" sid="NUM 13:18" />Biittay ay mela biittako, asay ay mela minookonne taybon guutheko daroko be7ite. <verse eid="NUM 13:18" /><verse number="19" style="v" sid="NUM 13:19" />Enti de7iya biittay lo77oko iiteko, enta katamati diretidaakonne mela de7iyako, <verse eid="NUM 13:19" /><verse number="20" style="v" sid="NUM 13:20" />biittay araddeko laddeko, biittay woran kametidaakonne quu7eko be7ite. Minnite; he biittan de7iya katha ayfiyape ekonna yoopite” yaagis. He wodey woyney teeridi maxetiya wode.<verse eid="NUM 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 13:21" />Enti keyidi Siina mela biittafe doomidi, Lebo-Hamaata matan de7iya Rehooba gakanaw de7iya biitta wochidosona. <verse eid="NUM 13:21" /><verse number="22" style="v" sid="NUM 13:22" />Negebe mela biitta kanthidi, Kebroona gakidosona. He bessan Akmaana, Sesayanne Talmaya geetetiya Enaaqa kochati de7oosona. Kebrooni Gibxen de7iya Xo7aane katamaape laapun laythi koyrottidi keexetis.<verse eid="NUM 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 13:23" />Yaara kanthidi, Eshkola Zangaara bidi gakiya wode teera woyne tashiyara qanxidosona. He tashey deexo gidiya gisho nam7u asi kaso aathidi tookidosona. Iya bolla gujidi oromaanenne balase mithaa ayfe ekidi yidosona. <verse eid="NUM 13:23" /><verse number="24" style="v" sid="NUM 13:24" />Isra7eele asay he bessaafe woyne tashiya qanxida gisho he bessaa Eshkola Zangaara gidi xeegidosona.<verse eid="NUM 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 13:25" />Enti he biitta oytamu gallas wochidi guye simmidosona. <verse eid="NUM 13:25" /><verse number="26" style="v" sid="NUM 13:26" />Paarana mela biittan Qaadesan de7iya Museko, Aaronakonne Isra7eele maabara ubbaako yidosona. Enti be7idaba asa ubbaas odidosona; he biittafe ekidi yida ayfiyaka enta bessidosona.<verse eid="NUM 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 13:27" />Enti Museko, “Neeni nuna yeddida biitta bida; he biittan maathinne eessi goggees; he biitta ayfiyaka haysa be7a. <verse eid="NUM 13:27" /><verse number="28" style="v" sid="NUM 13:28" />Shin he biittan de7iya asay wolqaama; enta katamatika gimbe dirsan diretidaysatanne gita. Nuuni ubbaafe aathidi Enaaqa kochata yan be7ida. <verse eid="NUM 13:28" /><verse number="29" style="v" sid="NUM 13:29" />Amaaleqati Negebe mela biittan; Hitetinne, Yaabuseti derey dariya Amooreta biittan; qassi Kanaaneti Medetiraane Abbaa doonaninne Yordaanose shaafa gaxan de7oosona” yaagidosona.<verse eid="NUM 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 13:30" />Yaatin Kaalebi asaa Muse sinthan si77i oothidi, “Nuuni xoonanaw danda7iya gisho, ha77i keyidi he biitta yegisidi ane oykoos” yaagis.<verse eid="NUM 13:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 13:31" />Shin Kaalebara bida asati, “He biitta asay nuupe aadhidi minniya gisho, nuuni enta xoonanaw danda7oko” yaagidosona. <verse eid="NUM 13:31" /><verse number="32" style="v" sid="NUM 13:32" />Enti yuuyidi wochida biittaba Isra7eele asaas haysada yaagidi iita oda odidosona. “Nuuni wochida biittay yan de7iya asaaka miya biitta; yan de7iya asayka daro adusse. <verse eid="NUM 13:32" /><verse number="33" style="v" sid="NUM 13:33" />Nuuni yan Enaaqa koche gidida Nifilime asata be7ida. Enta be7ida ayfen nuna xeelliya wode nuuni xaqo mela; entika nuna hessada be7oosona” yaagidosona.<verse eid="NUM 13:33" /></para>
  <chapter eid="NUM 13" />
  <chapter number="14" style="c" sid="NUM 14" />
  <para style="s1">Asaa Zuuzuntha</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 14:1" />He wode qamma maabara ubbay banta qaala dhoqu oothidi yeekidosona. <verse eid="NUM 14:1" /><verse number="2" style="v" sid="NUM 14:2" />Isra7eele asay Muse bollanne Aarona bolla zuuzumidosona. Kumetha maabaray, “Nuuni Gibxe biittan de7ishe woyko ha mela biittan hayqida gidorko. <verse eid="NUM 14:2" /><verse number="3" style="v" sid="NUM 14:3" />Nuuni mashshan wurana mela Goday ha biitta nuna ayis ehii? Nu machetinne nu nayti di7etana; hessa hananaape guye Gibxe simoy nuus keehennee?” yaagidosona. <verse eid="NUM 14:3" /><verse number="4" style="v" sid="NUM 14:4" />Enti issoy issuwako, “Nuna kaalethiya asi dooridi guye Gibxe simmoos” yaagidosona.<verse eid="NUM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 14:5" />Yaatin, Museynne Aaroni he bessan shiiqida Isra7eele maabara sinthan som7ora sa7an gufannidosona. <verse eid="NUM 14:5" /><verse number="6" style="v" sid="NUM 14:6" />Biittaa wochanaw bida asaa giddofe Nawe na7aa Iyyasuynne Yoofona na7aa Kaalebi banta ma7uwa peedhidosona. <verse eid="NUM 14:6" /><verse number="7" style="v" sid="NUM 14:7" />Isra7eele maabaraako, “Nuuni kanthi keyidi wochida biittay daro lo77o. <verse eid="NUM 14:7" /><verse number="8" style="v" sid="NUM 14:8" />Goday nunan ufaytiyaba gidiko maathinne eessi goggiya biitta nuna gelsana; he biitta nuus immana. <verse eid="NUM 14:8" /><verse number="9" style="v" sid="NUM 14:9" />Hessa gisho, Godaa bolla makallofite. He biitta asaas yayyofite; enti nuus oythika gidokona. Entaw eeshoy baawa; Goday nuura de7ees; hinte entaw yayyofite” yaagidosona. <verse eid="NUM 14:9" /><verse number="10" style="v" sid="NUM 14:10" />Yaatin Isra7eele maabaray enta shuchan caddanaw dendis.</para>
  <para style="p" vid="NUM 14:10">He wode Godaa bonchoy Xoossaa Dunkaaniyan Isra7eele asa ubbaas qoncis. <verse eid="NUM 14:10" /><verse number="11" style="v" sid="NUM 14:11" />Goday Museko, “Ha asay tana kadhey awude gakanaasee? Taani enta giddon oothida malaatata be7ishe, awude gakanaw tanan ammanonna ixanee? <verse eid="NUM 14:11" /><verse number="12" style="v" sid="NUM 14:12" />Taani enta gadon shocada dhaysana, shin nena entafe dariyanne minniya kawotethas aawa oothana” yaagis.<verse eid="NUM 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 14:13" />Musey zaaridi Godaako, “Neeni ne wolqan ha asaa Gibxefe kessidaysa eriya Gibxeti hessa si7iko woyganee? <verse eid="NUM 14:13" /><verse number="14" style="v" sid="NUM 14:14" />Enti he biittan de7iya asaas hessa odana. Abeeti Godaw, neeni ha asaara de7eysa enti si7idosona. Abeeti Godaw, nuuni nena be7idaysa, ne shaaray nu bolla kuyatidaysanne gallas shaara tuussan, qamma tama tuussan neeni nuna kaalethidaysa enti be7idosona. <verse eid="NUM 14:14" /><verse number="15" style="v" sid="NUM 14:15" />Yaatin, ha77i neeni ha asa ubbaa issi toho wodha dhaysiyaba gidiko ne kase oothidaysa si7ida kawotethati, <verse eid="NUM 14:15" /><verse number="16" style="v" sid="NUM 14:16" />‘Goday, ha asaas immana gidi caaqida biitta enta gelsanaw danda7iboona gisho mela biittan wodhi dhaysis yaagidi’ odana.<verse eid="NUM 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 14:17" />“Hessa gisho, Godaw, ne wolqaa nuna bessa; ne nuus gelida qaala qopa. <verse eid="NUM 14:17" /><verse number="18" style="v" sid="NUM 14:18" />‘Goday elle hanqetenna; maarotinne siiqoy kumidaysa nagaranne geellatethi atto geysa; shin balida uraa seeronna aggenna. Yelidaysata nagaraa gisho heedzanthonne oyddantho yeletethi gakanaw nayta seerana’ yaagadasa. <verse eid="NUM 14:18" /><verse number="19" style="v" sid="NUM 14:19" />Ha asay Gibxefe keyoosope doomada hachi gakanaw enta maaridaysada ne merinaa siiquwan ha asaa nagaraa atto garki” yaagis.<verse eid="NUM 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 14:20" />Goday zaaridi, “Ne oychidaysada ta enta maarana. <verse eid="NUM 14:20" /><verse number="21" style="v" sid="NUM 14:21" />Shin ta de7o gideysadanne ta bonchoy sa7a ubbaa kumidaysada, <verse eid="NUM 14:21" /><verse number="22" style="v" sid="NUM 14:22" />ha asaape issi asika he biitta be7enna. Gibxe biittaninne mela biittan oothida malaatata ha asati be7idosona; shin enti tammu toho tana paacidi taw kiitetonna ixidosona. <verse eid="NUM 14:22" /><verse number="23" style="v" sid="NUM 14:23" />Hessa gisho, ta enta mayzatas immana gada caaqida biitta tana kadhidaysatape issoyka gelenna. <verse eid="NUM 14:23" /><verse number="24" style="v" sid="NUM 14:24" />Shin ta aylley Kaalebi entafe dummatiya gishonne tana polo wozanape kaallida gisho, I kase wochida biitta iyaw immana; iya zerethayka he biitta laattana. <verse eid="NUM 14:24" /><verse number="25" style="v" sid="NUM 14:25" />Shin ha77i Amaaleqatinne Kanaaneti zangaaran de7iya gisho, wonto Zo7o Abbaako efiya ogiya oykidi mela biitta guye simmite” yaagis.<verse eid="NUM 14:25" /></para>
  <para style="s1">Zuuzummida Asaa Seeretethaa</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 14:26" />Goday Musekonne Aaronako, <verse eid="NUM 14:26" /><verse number="27" style="v" sid="NUM 14:27" />“Ha iita asay ta bolla awude gakanaw zuuzumanee? Taani Isra7eele asaa zuuzuntha si7as. <verse eid="NUM 14:27" /><verse number="28" style="v" sid="NUM 14:28" />Hessa gisho, neeni entaw haysada gada oda; ‘Taani ta de7uwan caaqayis; hinte gidaysada ta hintew oothana.’ Taani, Goday haysa odayis. <verse eid="NUM 14:28" /><verse number="29" style="v" sid="NUM 14:29" />Asay taybetiya wode laythi laatamanne iyape bolla gidida asi ubbay ta bolla zuuzumida gisho, hinte ahay ha mela biittan kundana. <verse eid="NUM 14:29" /><verse number="30" style="v" sid="NUM 14:30" />Yoofona na7a Kaalebapenne Nawe na7a Iyyasupe attishin, hintefe oonika ta hintena laatisanaw caaqida biitta gelenna. <verse eid="NUM 14:30" /><verse number="31" style="v" sid="NUM 14:31" />Hinte, ‘Nu nayti di7eti attana’ gida hinte nayta, he hinte kadhida biitta gelsana; he biittay entaw laata gidana. <verse eid="NUM 14:31" /><verse number="32" style="v" sid="NUM 14:32" />Shin hinte ahay ha mela biittan kundidi attana. <verse eid="NUM 14:32" /><verse number="33" style="v" sid="NUM 14:33" />Hinte ammanetibona gisho, hintefe wursetha ahay ha mela biittan kundana gakanaw, hinte nayti ha mela biittan waayetishe oytamu laythi dorse heemmana. <verse eid="NUM 14:33" /><verse number="34" style="v" sid="NUM 14:34" />Hinte biitta wochida oytamu gallasaa taybon, issi gallasas issi laythi, oytamu laythi hinte nagaraa gisho waayetana; he wode ta hinte bolla ay mela hanqetidaako hinte erana. <verse eid="NUM 14:34" /><verse number="35" style="v" sid="NUM 14:35" />Issife ta bolla dendida ha iita maabara bolla ta haysada oothana; enti ha mela biittan kundi attana; haysan enti hayqana; ta Goday haysa odayis” yaagis.<verse eid="NUM 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 14:36" />He biitta wochana mela Musey kiitida asati simmidi, he biittaba iita oda odidi, Muse bolla asay zuuzumana mela oothidaysati, <verse eid="NUM 14:36" /><verse number="37" style="v" sid="NUM 14:37" />Godaa sinthan boshan hayqidosona. <verse eid="NUM 14:37" /><verse number="38" style="v" sid="NUM 14:38" />He biitta wochanaw bida asaape Yoofona na7ay Kaalebinne Nawe na7ay Iyyasu xalaali attidosona.<verse eid="NUM 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 14:39" />Musey hessa Isra7eele asaas odida wode asay daro yeekis. <verse eid="NUM 14:39" /><verse number="40" style="v" sid="NUM 14:40" />Wontetha gallas wonta guura dendidi, gezze biitta keyidi, “Nuuni nagara oothida, shin ha77i Goday nuus immana gida bessaa pude keyana” yaagidosona.<verse eid="NUM 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 14:41" />Shin Musey entako, “Godaa kiitaa hinte ayis menthetii? Hintew hanenna. <verse eid="NUM 14:41" /><verse number="42" style="v" sid="NUM 14:42" />Goday hintera doonna gisho, boopite; hinte morketi hintena xoonana. <verse eid="NUM 14:42" /><verse number="43" style="v" sid="NUM 14:43" />Amaaleqa asaaranne Kanaane asaara hinte oletidi mashshan hayqana. Godaas hinte kiitetonna ixida gisho, Goday hintera deenna” yaagis.<verse eid="NUM 14:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 14:44" />Shin enti Godaa Caaqo Taaboteynne Musey gutaape dendonna de7ishin, derey dariya biitta baanaw minnidi dendidosona. <verse eid="NUM 14:44" /><verse number="45" style="v" sid="NUM 14:45" />Yaanin derey dariya biittan de7iya Amaaleqa asaynne Kanaane asay enta ollan xoonidi, Horma gakanaw enta yedethidosona.<verse eid="NUM 14:45" /></para>
  <chapter eid="NUM 14" />
  <chapter number="15" style="c" sid="NUM 15" />
  <para style="s1">Yarsho Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 15:1" />Goday Museko, <verse eid="NUM 15:1" /><verse number="2" style="v" sid="NUM 15:2" />“Isra7eele asaa haysada yaaga; hinte daana mela ta hintew immiya biitta geliya wode, <verse eid="NUM 15:2" /><verse number="3" style="v" sid="NUM 15:3" />xuussa yarsho gidin woyko gaso yarsho gidin woyko dosan yarshiya yarsho gidin woyko ba7aale gallasa yarsho gidin, mehepe woyko dorsaafe Godaas taman xuugetiya sawiya yarsho yarshite. <verse eid="NUM 15:3" /><verse number="4" style="v" sid="NUM 15:4" />Yarshuwa yarshiya uray katha yarshuwas issi kilo giraame lo77o dhiille sayso litiro shamaho zayten munuqetidaysa eho. <verse eid="NUM 15:4" /><verse number="5" style="v" sid="NUM 15:5" />Qassi xuussa yarshos woyko hara yarshos ehiya issi issi dorsaara sayso litiro woyne ushsha yarsho oothidi giigisite. <verse eid="NUM 15:5" /><verse number="6" style="v" sid="NUM 15:6" />Maraze yarshiya wode nam7u kilo giraame lo77o dhiille issi litironne bagga shamaho zayten munuqetidaysa ehite. <verse eid="NUM 15:6" /><verse number="7" style="v" sid="NUM 15:7" />Ushsha yarshuwas siko litiro woyne ushsha yarshuwas ehite. Hessi Godaas sawiya yarsho gidana. <verse eid="NUM 15:7" /><verse number="8" style="v" sid="NUM 15:8" />Gaso woyko issifetetha yarshos wofaano xuussa yarsho oothada Godaas yarshiya wode, <verse eid="NUM 15:8" /><verse number="9" style="v" sid="NUM 15:9" />wofaanuwara issife heedzu kilo giraame lo77o dhiille, nam7u litiro shamaho zayten munuqetidaysa katha yarsho oothada eha. <verse eid="NUM 15:9" /><verse number="10" style="v" sid="NUM 15:10" />Ushsha yarshuwas bagga litiro woyne ushsha ehite. Hessi Godaas sawiya xuussa yarsho gidana.<verse eid="NUM 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 15:11" />“Issi issi wofaanoy woyko issi issi marazey woyko issi issi koley yarshetiya wode haysada hanidi ooseto. <verse eid="NUM 15:11" /><verse number="12" style="v" sid="NUM 15:12" />Daro mehey yarshetiya wode yarshetiya katha yarshoyka hessada daro. <verse eid="NUM 15:12" /><verse number="13" style="v" sid="NUM 15:13" />Isra7eele asi gidida oonika sawiya xuussa yarsho Godaas yarshiya wode ubban haysada oothanaw koshshees. <verse eid="NUM 15:13" /><verse number="14" style="v" sid="NUM 15:14" />Yaana yeletethan hinte giddon de7iya bete woyko hara asi oonika sawiya xuussa yarsho Godaas yarshanaw koyiko hessada oothanaw koshshees. <verse eid="NUM 15:14" /><verse number="15" style="v" sid="NUM 15:15" />Hintewunne hinte giddon de7iya bete asaas he wogay issino; hessi yaana yeletethaaska eqidi daana woga; Hinteka bete asatika Godaa sinthan issino. <verse eid="NUM 15:15" /><verse number="16" style="v" sid="NUM 15:16" />Hintewunne hinte giddon de7iya bete asaas higgeynne wogay issino” yaagis.<verse eid="NUM 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 15:17" />Goday Museko, <verse eid="NUM 15:17" /><verse number="18" style="v" sid="NUM 15:18" />“Isra7eele asaas haysada gada oda; taani hintena efiya biitta hinte gelidi, <verse eid="NUM 15:18" /><verse number="19" style="v" sid="NUM 15:19" />he biittan kaxiya kathi hinte miya wode he kathaafe xeera kessidi hinte Godaas yarshite. <verse eid="NUM 15:19" /><verse number="20" style="v" sid="NUM 15:20" />Hessika, bayra kaxida kathaafe uukida koyro uythi, gidishin, kathi bukiya wudumaafe immiya yarsho oothidi yarshite. <verse eid="NUM 15:20" /><verse number="21" style="v" sid="NUM 15:21" />Yeletetha ubban hinte biittan kaxida kathaafe koyruwa uukidi Godaas yarsho yarshite.<verse eid="NUM 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 15:22" />“Goday, Muses odida kiitaa hinte eronna ixidi naagonna attiko, <verse eid="NUM 15:22" /><verse number="23" style="v" sid="NUM 15:23" />woyko Goday iya baggara immida kiita ubbaa, Goday immida gallasaape doomidi yaana yeletetha gakanaw naagonna ixiko, <verse eid="NUM 15:23" /><verse number="24" style="v" sid="NUM 15:24" />qassi hessa Isra7eele maabaray eronna oothidaba gidiko maabara ubbay Godaas issi wofaano sawiya xuussa yarsho oothidi, wogay kiiteysada katha yarshuwaranne ushsha yarshuwara yarsho; qassi nagara yarsho oothidi issi kole yarsho. <verse eid="NUM 15:24" /><verse number="25" style="v" sid="NUM 15:25" />Kahiney kumetha Isra7eele maabaraas nagara atotetha yarsho shiishees. Enti eronna balida banta naaquwa gisho Godaas xuussa yarshonne nagara yarsho yarshida gisho enta nagaray atto geetetana. <verse eid="NUM 15:25" /><verse number="26" style="v" sid="NUM 15:26" />Isra7eele maabaraynne enta giddon de7iya bete asay eronna he bala oothida gisho asa ubbaa nagaray atto geetetana.<verse eid="NUM 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 15:27" />“Issi asi eronna nagara oothiko issi laytha kole nagara yarsho oothidi yarsho. <verse eid="NUM 15:27" /><verse number="28" style="v" sid="NUM 15:28" />Eronna de7ishe nagara oothida uraas kahiney Godaa sinthan nagara atotetha wogaa polo; iya nagaray atto geetetana. <verse eid="NUM 15:28" /><verse number="29" style="v" sid="NUM 15:29" />Eronna nagara oothida uraas kahiney Godaa sinthan nagara atotetha wogaa polo; iya nagaray atto geetetana.<verse eid="NUM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 15:30" />“Shin Isra7eele asi gidin woyko bete asi gidin erishe otoron nagara oothiya uray Godaa cayees. He uray deriya giddofe dhayo. <verse eid="NUM 15:30" /><verse number="31" style="v" sid="NUM 15:31" />He uray Godaa kiitaa erishe kadhida gishonne iya kiitaa kawushida gisho iyaw dhayoy bessees. Iya balay iya bolla gido” yaagis.<verse eid="NUM 15:31" /></para>
  <para style="s1">Sambaata Menthida Ura</para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 15:32" />Issi gallas Isra7eele asay mela biittan de7ishin, issi uray Sambaata gallas mithi mixishe oyketis. <verse eid="NUM 15:32" /><verse number="33" style="v" sid="NUM 15:33" />He uraa asay Museko, Aaronakonne Isra7eele maabaraako ehidosona. <verse eid="NUM 15:33" /><verse number="34" style="v" sid="NUM 15:34" />Enti iya bolla oothanaba eriboona gisho qashon gam7isidosona. <verse eid="NUM 15:34" /><verse number="35" style="v" sid="NUM 15:35" />Hessafe guye, Goday Museko, “Ha uray hayqanaw bessees; Isra7eele maabaray banta gutaape gaxa kessidi shuchan caddidi wodho” yaagis. <verse eid="NUM 15:35" /><verse number="36" style="v" sid="NUM 15:36" />Yaatin Isra7eele maabara ubbay Goday Muse kiitidaysada, gutaape gaxa kessidi shuchan caddidi wodhidosona.<verse eid="NUM 15:36" /></para>
  <para style="s1">Afila Macara Woga</para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 15:37" />Goday Museko, <verse eid="NUM 15:37" /><verse number="38" style="v" sid="NUM 15:38" />“Isra7eele asaas haysada gada oda; hintenne yaana yeletethay hinte afilaa gaxan macara kessidi he macara gaxan kaalose qacina sikite. <verse eid="NUM 15:38" /><verse number="39" style="v" sid="NUM 15:39" />He macaraa hinte be7iya wode ubban ta kiitata, akeekidi poleeta; taape haakidi hinte ayfiya amuwanne hinte wozanaa qofaa kaallidi laameteketa. <verse eid="NUM 15:39" /><verse number="40" style="v" sid="NUM 15:40" />He macaraa be7idi hinte ta kiita ubbaa akeekidi polananne Xoossaas dummatidaysata gidana. <verse eid="NUM 15:40" /><verse number="41" style="v" sid="NUM 15:41" />Taani Godaa, hinte Xoossaa; ta hinte Xoossaa gidanaw hintena Gibxefe kessas. Taani Godaa, hinte Xoossaa yaaga” yaagis.<verse eid="NUM 15:41" /></para>
  <chapter eid="NUM 15" />
  <chapter number="16" style="c" sid="NUM 16" />
  <para style="s1">Qore, Daatanenne Abeero</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 16:1" />Leewe kochaafe Qahaata koche gidida Yisi7ara na7ay Qorey, Robeela kochaafe Eli7aaba nayti Daataneynne Abeeroy qassi Faleta na7ay Oni, <verse eid="NUM 16:1" /><verse number="2" style="v" sid="NUM 16:2" />Muse bolla dendidosona. Entara nam7u xeetanne ishatamu asati de7oosona; he asati asan eretidaysatanne maabara kaaletheyisata. <verse eid="NUM 16:2" /><verse number="3" style="v" sid="NUM 16:3" />Enti Musenne Aarona sinthe shiiqidi, “Hinte darsideta; maabara ubbay geeshshi; Goday entara de7ees. Yaatin, Godaa maabara bolla hintena ayis dhoqu dhoqu oothetii?” yaagidosona.<verse eid="NUM 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 16:4" />Musey hessa si7ida wode Godaa sinthan gufannis. <verse eid="NUM 16:4" /><verse number="5" style="v" sid="NUM 16:5" />Qorekonne iya cugaako, “Goday wonto wonta ooni iya baggekonne ooni geeshsheko bessana; he I doorida uraa baako shiishana; he uray iyako shiiqana. <verse eid="NUM 16:5" /><verse number="6" style="v" sid="NUM 16:6" />Wonto wonta neeranne ne asaara haysa oothite; ixaane cuyisiya miishe ekidi, <verse eid="NUM 16:6" /><verse number="7" style="v" sid="NUM 16:7" />bonqo tama iyan wothidi, Godaa sinthan ixaane cuyisite. Goday dooriya uray I geeshshi gidana. Hinte, Leeweti zawape aadhideta.”<verse eid="NUM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 16:8" />Qassika Musey Qoreko, “Hinte Leeweti si7ite. <verse eid="NUM 16:8" /><verse number="9" style="v" sid="NUM 16:9" />Isra7eele Xoossay hintena ba maabara giddofe dummayidi, geeshsha dunkaaniyan oothana melanne ba asaa sinthan eqidi haggaazana mela baako shiishidaysi hintew guuxidee? <verse eid="NUM 16:9" /><verse number="10" style="v" sid="NUM 16:10" />I hintenanne hinte ishata Leeweta ubbaa baako shiishis; shin ha77i hinte kahineta bessaa koyeeta. <verse eid="NUM 16:10" /><verse number="11" style="v" sid="NUM 16:11" />Neeninne ne cuga ubbay Godaa bolla makallidi dendideta; hinte iya bolla zuuzumanaw I Aaroni oonee?” yaagis.<verse eid="NUM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 16:12" />“Yaatidi, Musey, Eli7aaba nayta, Daatanenne Abeero xeegisis; shin enti, ‘Nuuni booko’ yaagidosona. <verse eid="NUM 16:12" /><verse number="13" style="v" sid="NUM 16:13" />Neeni mela biittan nuna wodhanaw maathinne eessi goggiya biittafe nuna kessidaysi guuxis gada ha77i nu bolla halaqa gidanaw koyay? <verse eid="NUM 16:13" /><verse number="14" style="v" sid="NUM 16:14" />Neeni nuna maathinne eessi goggiya biitta gelsabaaka; woyko neeni nuus laata oothada goshsha gadenne woyne gade immabaaka; neeni nuna cimmaasa; nuuni booko” yaagidosona.<verse eid="NUM 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 16:15" />Yaatin, Musey daro hanqetidi, Godaako, “Neeni enta yarshuwa ekofa; ta entafe issuwaka qohabike; qassi hari attoshin issi hareka entafe ekabike” yaagis.<verse eid="NUM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 16:16" />Qassi Musey Qoreko, “Wonto neeranne ne asaara hessada Aaronika Godaa sinthe shiiqite. <verse eid="NUM 16:16" /><verse number="17" style="v" sid="NUM 16:17" />Issi issi asi ba ixaane cuyisiya miishiya eko; ixaaneka iyan wotho; ubbay issife nam7u xeetanne ishatamu ixaane cuyisiya miishe gidees; ixaane iyan wothidi Godaa sinthe shiisho. Neeninne Aaroni hinte ixaaniya hessada shiishite” yaagis. <verse eid="NUM 16:17" /><verse number="18" style="v" sid="NUM 16:18" />Yaatin, issi issi asi ba miishen ixaanenne tama bonqo wothidi geeshsha dunkaaniya pengen Museranne Aaronara issife eqidosona. <verse eid="NUM 16:18" /><verse number="19" style="v" sid="NUM 16:19" />Qorey ba asaara geeshsha dunkaaniya pengen Muse sinthaninne Aarona sinthan eqidosona. He wode Godaa bonchoy kumetha maabaraas qoncis. <verse eid="NUM 16:19" /><verse number="20" style="v" sid="NUM 16:20" />Goday Musekonne Aaronako, <verse eid="NUM 16:20" /><verse number="21" style="v" sid="NUM 16:21" />“Taani issi toho ha asaa dhaysana gisho, entafe shaaketite” yaagis.<verse eid="NUM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 16:22" />Shin Museynne Aaroni sa7an gufannidi, “Abeeti Xoossaw, asa shempo ubbaa medhida Xoossaw, issi asi nagara oothiko, neeni kumetha maabara hanqetayee?” yaagidosona.<verse eid="NUM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 16:23" />Yaatin, Goday Museko, <verse eid="NUM 16:23" /><verse number="24" style="v" sid="NUM 16:24" />“Asaas ‘Qore, Daatanenne Abeero dunkaaniya matape kichite’ gada oda” yaagis.<verse eid="NUM 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 16:25" />Musey dendidi, Daatanekonne Abeeroko bin, Isra7eele cimati iya kaallidosona. <verse eid="NUM 16:25" /><verse number="26" style="v" sid="NUM 16:26" />I Maabaraako, “Ha iita asaa dunkaaniya matape kichite; entaba aybibaaka bochofite. Akay, giiko, enta nagara gaason hinteka pitetidi dhayana” yaagidi minthidi odis.<verse eid="NUM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 16:27" />Yaatin asay Qore, Daatanenne Abeero dunkaaniya matape kichidosona. Daataneynne Abeeroy kare keyidi, banta machetaranne banta naytara banta dunkaaneta pengen eqidosona. <verse eid="NUM 16:27" /><verse number="28" style="v" sid="NUM 16:28" />Musey asaako, “Taani ha ooso ubbaa oothana mela, Goday tana kiittidaysanne taani ta shenen oothonaysa hinte eranay haysana. <verse eid="NUM 16:28" /><verse number="29" style="v" sid="NUM 16:29" />Ha asati asi hayqeysada hayqiko woyko asa bolla gakiyaba xalaali enta bolla gakiko Goday tana Kiittibeenna. <verse eid="NUM 16:29" /><verse number="30" style="v" sid="NUM 16:30" />Shin, Goday oorathaba oothidi, biittay dooyetidi entanne entaw de7iyaba ubbaa mittikonne enti paxa de7ishe duufo geliko he wode ha asati Godaa kadhidaysa hinte erana” yaagis.<verse eid="NUM 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 16:31" />I yaagidi ongida wode enti eqida biittay dooyetidi, <verse eid="NUM 16:31" /><verse number="32" style="v" sid="NUM 16:32" />entanne enta soo asaa, Qore cuga ubbaanne entaw de7iyaba ubbaa mittis. <verse eid="NUM 16:32" /><verse number="33" style="v" sid="NUM 16:33" />Yaatin enti bantaw de7iyaba ubbaara paxa de7ishe, duufo gelidosona. Biittay enta bolla gordetis; enti maabara giddofe dhayidosona. <verse eid="NUM 16:33" /><verse number="34" style="v" sid="NUM 16:34" />Enta waasuwa gaason enta matan de7iya Isra7eele asa ubbay, “Biittay nunaka mittana hanees” yaagidi baqatidosona.<verse eid="NUM 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 16:35" />Qassi tami Godaa matape yidi ixaane cuyisiya nam7u xeetanne ishatamu asaa mis.<verse eid="NUM 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 16:36" />Hessafe guye, Goday Museko, <verse eid="NUM 16:36" /><verse number="37" style="v" sid="NUM 16:37" />“Kahiney, Aarona na7aa Alaazari naase biratape oosetida ixaane cuyisiya miisheta xuugetida asaape ekidi, he miisheti geeshshi gidiya gisho, bonqo tama hara soo efidi laallana mela oda. <verse eid="NUM 16:37" /><verse number="38" style="v" sid="NUM 16:38" />He miisheti banta de7uwa dhaysanaw nagara oothida asay ixaane cuyisiya miishe. He miisheti Godaas imetida gishonne geeshshi gidiya gisho lee7isa qoxada yarsho bessa lanxa. Hessi Isra7eele asaas naagiso malla gido” yaagis.<verse eid="NUM 16:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 16:39" />Yaatin kahiney Alaazari ixaane cuyisiya miisheta ekidi yarsho bessa lanxanaw lee7isidi qoxis. <verse eid="NUM 16:39" /><verse number="40" style="v" sid="NUM 16:40" />Goday Muse baggara kiitidaysada, Aarona koche gidonna oonika Godaa sinthan ixaane cuyisanaw shiiqonna mela, ixas giiko, Qore bollanne iya kaalleyisata bolla gakidaysi iya gakonna mela Isra7eele asaa akeekisanaw haysata oothis.<verse eid="NUM 16:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 16:41" />Wontetha gallas Isra7eele maabara ubbay, “Godaa asaa hinte wodhideta” yaagidi Muse bollanne Aarona bolla zuuzumidosona. <verse eid="NUM 16:41" /><verse number="42" style="v" sid="NUM 16:42" />Enti Musenne Aarona bolla dendanaw shiiqidi, enti geeshsha dunkaaniya xeelliya wode shaaray geeshsha dunkaaniya kammin, Godaa bonchoy qoncis.<verse eid="NUM 16:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="NUM 16:43" />Hessafe guye, Museynne Aaroni geeshsha dunkaaniya sinthe yidi eqidosona. <verse eid="NUM 16:43" /><verse number="44" style="v" sid="NUM 16:44" />Yaatin Goday Museko, <verse eid="NUM 16:44" /><verse number="45" style="v" sid="NUM 16:45" />“Ha asaa giddofe kichite; ta enta issi tohon dhaysana” yaagis.</para>
  <para style="p" vid="NUM 16:45">Museynne Aaroni sa7an gufannidosona. <verse eid="NUM 16:45" /><verse number="46" style="v" sid="NUM 16:46" />Musey Aaronako, “Ixaane cuyisiya ne miishiya ekada yarsho bessaafe bonqo tama ekada iyan wotha; iya bolla ixaane gujada Isra7eele maabaraako efa. Godaa hanqoy iya matape keyi kichis; boshayka doomis” yaagis. <verse eid="NUM 16:46" /><verse number="47" style="v" sid="NUM 16:47" />Yaatin Aaroni, Musey kiitidaysada ba ixaane cuyisiya miishiya ekidi maabara giddo woxidi gelis. Boshay asaa wodho oykis shin, Aaroni ixaane cuyisidi asaas atotethi ehis. <verse eid="NUM 16:47" /><verse number="48" style="v" sid="NUM 16:48" />Yaatidi, I hayqidaysatanne paxata giddon eqin, boshay aggis. <verse eid="NUM 16:48" /><verse number="49" style="v" sid="NUM 16:49" />Qore gaason hayqida asay attishin, he boshan hayqida asaa tayboy 14,700. <verse eid="NUM 16:49" /><verse number="50" style="v" sid="NUM 16:50" />Boshay eqidaape guye, Aaroni geeshsha dunkaaniya pengen de7iya Museko simmis.<verse eid="NUM 16:50" /></para>
  <chapter eid="NUM 16" />
  <chapter number="17" style="c" sid="NUM 17" />
  <para style="s1">Aarona Xam7a Aacetha</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 17:1" />Goday Museko, <verse eid="NUM 17:1" /><verse number="2" style="v" sid="NUM 17:2" />“Isra7eele asay issi issi kochaa halaqatape issi issi xam7a ekidi tammanne nam7u xam7a new ehana mela entaw oda. He xam7aa bolla issi issi asaa sunthaa xaafa. <verse eid="NUM 17:2" /><verse number="3" style="v" sid="NUM 17:3" />Issi issi kochaa halaqaas issi xam7a koshshiya gisho, Leewe xam7aa bolla Aarona sunthaa xaafa. <verse eid="NUM 17:3" /><verse number="4" style="v" sid="NUM 17:4" />He xam7ata geeshsha dunkaaniya giddon ta neera gahetiya Taabotiya sinthan wotha. <verse eid="NUM 17:4" /><verse number="5" style="v" sid="NUM 17:5" />Ta dooriya uraa xam7ay aacana; hessada oothada hinte bolla Isra7eele asaa zuuzuntha ta teqana” yaagis.<verse eid="NUM 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 17:6" />Hessa Musey Isra7eele asaas odin, tammanne nam7u halaqati huuphen huuphen issi issi xam7a ehidosona. Aarona xam7ayka he xam7ata giddon de7ees. <verse eid="NUM 17:6" /><verse number="7" style="v" sid="NUM 17:7" />Musey he xam7ata ubbaa geeshsha dunkaaniya giddon Godaa sinthan wothis.<verse eid="NUM 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 17:8" />Wontetha gallas Musey geeshsha dunkaaniya giddo geliya wode Leewe koche gidida Aarona xam7ay aacidaysa, gambuxidaysa, ciiyidaysanne lawuze mitha ayfe ayfidaysa be7is. <verse eid="NUM 17:8" /><verse number="9" style="v" sid="NUM 17:9" />Musey xam7a ubbaa Godaa sinthafe ehidi Isra7eele asaa bessis. Enti hanidaba be7idaape guye issi issi halaqay banta xam7aa xam7aa ekidosona. <verse eid="NUM 17:9" /><verse number="10" style="v" sid="NUM 17:10" />Goday Museko, “Aarona xam7aa Taabotiya sinthan zaarada wotha. Makallida Isra7eele asay ta bolla zuuzuntha aggonna ixiko hayqanaysa entaw malaata oothada wotha” yaagis. <verse eid="NUM 17:10" /><verse number="11" style="v" sid="NUM 17:11" />Musey, Goday kiitidaysada oothis.<verse eid="NUM 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 17:12" />Isra7eele asay Museko, “Hessa gidiko, nu ubbay hayqana; dhayana. <verse eid="NUM 17:12" /><verse number="13" style="v" sid="NUM 17:13" />Geeshsha dunkaaniyako shiiqiya ubbay hayqana gidiko, nu ubbayka hayqoos guusseyee?” yaagidosona.<verse eid="NUM 17:13" /></para>
  <chapter eid="NUM 17" />
  <chapter number="18" style="c" sid="NUM 18" />
  <para style="s1">Kahinetanne Leeweta Oosuwa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 18:1" />Goday Aaronako, “Geeshsha dunkaaniyan oosetiya nagaraas neeni, ne adde naytinne ne aawa soo asay oyshetana; hinte kahinetetha oosuwan poletiya nagaraa nenne ne adde nayta xalaali oyshetana. <verse eid="NUM 18:1" /><verse number="2" style="v" sid="NUM 18:2" />Neeninne ne adde nayti geeshsha dunkaaniya sinthan oothiya wode hintena oothidi maadana mela Leewe koche gidida ne dabbota eha. <verse eid="NUM 18:2" /><verse number="3" style="v" sid="NUM 18:3" />Enti hintefe garsan geeshsha dunkaaniya ooso ubbaa oothonna; shin entika hinteka hayqonna mela enti geeshsha dunkaaniya miishiyakonne yarsho bessaako shiiqopo. <verse eid="NUM 18:3" /><verse number="4" style="v" sid="NUM 18:4" />Enti hintera issife gididi geeshsha Dunkaaniyan de7iya ooso ubbaa ootho. Shin Leewetape attishin, hara asi oonika hinte de7iya bessaa shiiqopo. <verse eid="NUM 18:4" /><verse number="5" style="v" sid="NUM 18:5" />Zaaridi Isra7eele asaa bolla hanqoy wodhonna mela geeshsha dunkaaniyaninne yarsho bessan oosetiya oosuwa hinte xalaala oothite. <verse eid="NUM 18:5" /><verse number="6" style="v" sid="NUM 18:6" />Leeweta, hinte dabbota, Isra7eele asaa giddofe ta dooras. Enti geeshsha dunkaaniya oosuwa oothana mela taani enta taw dummayas. <verse eid="NUM 18:6" /><verse number="7" style="v" sid="NUM 18:7" />Shin yarsho bessaaninne magarajuwafe gaatha baggan de7iya oosuwa nenne ne adde nayta xalaali oothite. Kahinetetha oosuwa taani hintew imota oothada immas; hara asi oonika he bessaa shiiqiko hayqo” yaagis.<verse eid="NUM 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 18:8" />Goday Aaronako, “Isra7eele asay taw immiya geeshsha imota ubbaa ta new immas. Taani newunne ne adde naytas merinaa gisho oothada immas. <verse eid="NUM 18:8" /><verse number="9" style="v" sid="NUM 18:9" />Taw imetiya daro geeshsha imuwape taman xuugetonna baggay hintebaa gidana. Enti taw immiya geeshsha imo ubbay katha yarsho gidin nagara yarsho gidin naaqo yarsho gidin newunne ne adde naytas gidana. <verse eid="NUM 18:9" /><verse number="10" style="v" sid="NUM 18:10" />Hinte hessa geeshsha bessan miite; adde ubbay hessa mo; hessi hintew geeshshi gidana.<verse eid="NUM 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 18:11" />“Qassi Isra7eele asay taw yarshiya yuusho yarsho ubbaa new, ne adde naytasinne ne macca naytas merinaw gisho oothada immas; hinte soo asaa giddon wogada tuna gidonna ubbay hessa mo.<verse eid="NUM 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 18:12" />“Isra7eele asay taw bayra oothidi immiya koyro ayfiyape, shamaho zayte ubbaa, yalaga woyne ubbaanne katha ubbaa new immas. <verse eid="NUM 18:12" /><verse number="13" style="v" sid="NUM 18:13" />Enti Godaas ehiya gaden koyro gakida ayfey hintesa; hinte soo asaa giddon wogaada tuna gidonna ubbay hessa mo.<verse eid="NUM 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 18:14" />“Isra7eele asaa giddofe Godaas dummatida ubbay hintesa. <verse eid="NUM 18:14" /><verse number="15" style="v" sid="NUM 18:15" />Bayra yeletida asi woyko mehey Isra7eele asay Godaas immida ubbay hintesa. Shin bayra yeletida adde na7anne bayra yeletida geeshshi gidonna mehe hinte wozanaw bessees. <verse eid="NUM 18:15" /><verse number="16" style="v" sid="NUM 18:16" />Issi ageena nayta wozanaw geeshsha dunkaanen eretida mizaanen ichashu bira santime wozo gate qanxite. <verse eid="NUM 18:16" /><verse number="17" style="v" sid="NUM 18:17" />Shin enti geeshshi gidiya gisho mehe, dorsenne deesha bayra hinte wozanaw koshshenna. Enta suutha yarsho bessa bolla gussa; Godaas sawiya xuussa yarsho oothada enta modho ashuwa taman xuugga. <verse eid="NUM 18:17" /><verse number="18" style="v" sid="NUM 18:18" />Angaasoynne ushacha geday yuusho yarshon nebaa gididaysada enta ashoyka nebaa. <verse eid="NUM 18:18" /><verse number="19" style="v" sid="NUM 18:19" />Isra7eele asay Godaas immiya geeshsha yarsho ubbaa new, ne adde naytasinne ne macca naytas merinaw gisho oothada immas. Hessi taani neeranne ne kochaara caaqiya merinaa caaquwa.”<verse eid="NUM 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 18:20" />Qassika Goday Aaronako, “Enta biittafe nena gakiya gishoy woyko laati baawa; Isra7eele asaa giddon ne laataynne nena gakiya gishoy tana.”<verse eid="NUM 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 18:21" />Goday, “Leeweti geeshsha Dunkaaniyan oothiya oosuwas damooze gidana mela Isra7eele asay taw ehiya asraata ubbaa entaw immas. <verse eid="NUM 18:21" /><verse number="22" style="v" sid="NUM 18:22" />Hachife doomidi Isra7eele asay banta nagara gaason hayqonna mela geeshsha dunkaaniyako shiiqopo. <verse eid="NUM 18:22" /><verse number="23" style="v" sid="NUM 18:23" />Geeshsha dunkaaniya giddon ootheysatinne iya giddon poletiya nagaraa tookey Leeweta. Hessi yeletetha ubbaas merinaa woga. Leewetas Isra7eele asaa giddon laati baawa. <verse eid="NUM 18:23" /><verse number="24" style="v" sid="NUM 18:24" />Hessa gisho, Isra7eele asay Godaas immiya asraata, ta Leewetas immas. Taani, entaw Isra7eele asaa giddon laati baawa giday hessasa” yaagis.<verse eid="NUM 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 18:25" />Qassi Goday Museko, <verse eid="NUM 18:25" /><verse number="26" style="v" sid="NUM 18:26" />“Neeni Leewetako haysada yaaga; taani hintew laata oothada immida asraata hinte Isra7eele asaape ekiya wode hinte he asraatape asraata Godaas immite. <verse eid="NUM 18:26" /><verse number="27" style="v" sid="NUM 18:27" />Hinte imoy wudummafe shiiqida kathada woyko gum7iya bessaafe ha77i keyida woyneda hintew taybetana. <verse eid="NUM 18:27" /><verse number="28" style="v" sid="NUM 18:28" />Hessadaka Isra7eele asaape hinte ekiya asraata ubbaafe dumma imo Godaas immite; hinte asraatape Godaa gisho gidida imota kahiniya Aaronas immite. <verse eid="NUM 18:28" /><verse number="29" style="v" sid="NUM 18:29" />Hinte ekiya imota ubbaafe lo77uwanne geeshsha Godaas gisho oothidi immanaw bessees. <verse eid="NUM 18:29" /><verse number="30" style="v" sid="NUM 18:30" />Ubbaafe lo77o imuwa hinte immiya wode attidaysi hintew buketiya wudumma kathaadanne gum7etiya woyniyada taybetana. <verse eid="NUM 18:30" /><verse number="31" style="v" sid="NUM 18:31" />Attidaysi geeshsha Dunkaaniyan hinte oothiya oosuwas damooze gidiya gisho hintenne hinte soo asay awunka maanaw danda7eeta. <verse eid="NUM 18:31" /><verse number="32" style="v" sid="NUM 18:32" />Lo77o baggaa Godaas immidaape guye hinte miiko hessi hintew nagara gidenna. Lo77o baggaa kessonna de7ishe he imotape midi hinte Isra7eele asaa imota tunisonna mela naagetite; hessa hinte oothonna ixiko hinte hayqana” yaagada Leewetas oda.<verse eid="NUM 18:32" /></para>
  <chapter eid="NUM 18" />
  <chapter number="19" style="c" sid="NUM 19" />
  <para style="s1">Geesho Haathe</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 19:1" />Goday Musekonne Aaronako, <verse eid="NUM 19:1" /><verse number="2" style="v" sid="NUM 19:2" />“Goday higgiyan kiitetida wogay haysa; borsoy bayna, I gannan qambari wodhiboonna zo7o ussu ehana mela Isra7eele asaas odite. <verse eid="NUM 19:2" /><verse number="3" style="v" sid="NUM 19:3" />Kahiniya Alaazaras iyo immite; gutaape iyo gaxa kessidi kahiniya sinthan shuko. <verse eid="NUM 19:3" /><verse number="4" style="v" sid="NUM 19:4" />Kahiney Alaazari I suuthaafe guuthara ekidi ba biradhiyan geeshsha dunkaaniyako simmidi laapun toho wurxo. <verse eid="NUM 19:4" /><verse number="5" style="v" sid="NUM 19:5" />Kahiney be7ishin ussiya xuugeto; galbay, ashoy, suuthaynne tocey xuugeto. <verse eid="NUM 19:5" /><verse number="6" style="v" sid="NUM 19:6" />Kahiney ziga mithi, hisoophe tashenne zo7o qacina ekidi ussiya eexiya taman yeggo. <verse eid="NUM 19:6" /><verse number="7" style="v" sid="NUM 19:7" />Hessafe guye, kahiney ba ma7uwanne ba asatethaa meecetidi gutaa gelo; shin omarsi gakanaw wogaada tuna gidana. <verse eid="NUM 19:7" /><verse number="8" style="v" sid="NUM 19:8" />He ussiw xuuggidaysi ba ma7uwanne ba asatethaa meeceto; ika omarsi gakanaw wogaada tuna gidana.<verse eid="NUM 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 19:9" />“Hessafe guye, hara geeshsha asi ussiya xuugetida biduwa shiishidi gutaape gaxan geeshsha bessan wotho. Isra7eele asay tunatethaafe geeshshiya haathan go7etanaw hessi naagetidi uttana; hessi nagaraape geeshshanaw go77ees. <verse eid="NUM 19:9" /><verse number="10" style="v" sid="NUM 19:10" />Qassi ussee biduwa shiishida urayka ba ma7uwa meecco; I omarsi gakanaw wogaada tuna gidana. Ha wogay Isra7eele asaasinne enta giddon de7iya hara dere asaas merinaa woga gidana.<verse eid="NUM 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 19:11" />“Aha bochiya oonika laapun gallas wogaada tuna gidana. <verse eid="NUM 19:11" /><verse number="12" style="v" sid="NUM 19:12" />Tunatethaafe geeshshiya haathan heedzantho gallasinne laapuntha gallas I bana geeshsho; hessafe guye, I wogaada geeshshi gidana. Shin heedzantho gallasinne laapuntha gallas I bana geeshshona ixiko I geeshshi gidenna. <verse eid="NUM 19:12" /><verse number="13" style="v" sid="NUM 19:13" />Hayqida asa aha bochiya oonika bana geeshshonna ixiko I Godaa dunkaaniya tunisees; he uray Isra7eele asaa giddofe kuretto. Tunatethaafe geeshshiya haathay iya bolla wurxetiboona gisho I tuna; I tuna gididi gam7ees.<verse eid="NUM 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 19:14" />“Issi asi dunkaaniya giddon hayqiko oothana wogay haysa; unkaaniya giddo geliya oonika, qassi dunkaaniya giddon de7iya oonika laapun gallas gakanaw tuna gidana. <verse eid="NUM 19:14" /><verse number="15" style="v" sid="NUM 19:15" />Hessadaka, kamettonna dooya de7iya miishe ubbay tuna gidana. <verse eid="NUM 19:15" /><verse number="16" style="v" sid="NUM 19:16" />Qassi denban hayqida asa aha woyko hargetidi hayqida asa aha woyko meqethi woyko duufo bochiya oonika laapun gallas gakanaw tuna gidana.<verse eid="NUM 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 19:17" />“Tunatethaafe geeshshanaw xuugetida ussee biduwape guuthara ekada oton yeggada pulto haathe iya bolla tiga. <verse eid="NUM 19:17" /><verse number="18" style="v" sid="NUM 19:18" />Geeshsha asi hisoophe wurco ekidi haathan naaqi kessidi, dunkaaniya, iya giddon de7iya miishiyanne asa ubbaa bolla wurxo. Qassi hayqida asa aha woyko meqethi woyko duufo woyko hargeti hayqida asi bochida asa bolla wurxo. <verse eid="NUM 19:18" /><verse number="19" style="v" sid="NUM 19:19" />Geeyida asi heedzantho gallasinne laapuntha gallas geeyiboonna uraa bolla wurxo. I laapuntha gallas he uraa tunatethaafe geeshsho; he geeyida addey, ba ma7uwanne ba asatethaa meeceto; he gallas omarsi I geeshshi gidana.<verse eid="NUM 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 19:20" />“Shin tuna uray bana geeshshonna ixiko, he uray geeshsha dunkaaniya tunisida gisho, Isra7eele asaa giddofe kuretto; tunatethaafe geeshshiya haathay iya bolla wurxetiboona gisho I tuna. <verse eid="NUM 19:20" /><verse number="21" style="v" sid="NUM 19:21" />Haysi hintew merina woga gidana. Tunatethaafe geeshshiya haatha wurxiya uray ba ma7uwa meecco; qassi tunatethaafe geeshshiya haatha bochiya oonika omarsi gakanaw tuna gidana. <verse eid="NUM 19:21" /><verse number="22" style="v" sid="NUM 19:22" />Tuna uray bochiya aybibayka tunees; qassi he miishiya bochiya oonika omarsi gakanaw tuna gidees” yaagis.<verse eid="NUM 19:22" /></para>
  <chapter eid="NUM 19" />
  <chapter number="20" style="c" sid="NUM 20" />
  <para style="s1">Zaallafe Pultida Haathe</para>
  <para style="r">(<ref loc="EXO 17:1-7">Kessa 17:1-7</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 20:1" />Koyro ageenan Isra7eele asa ubbay Siina mela biitta gakidi, Qaadesa geetetiya bessan dunkaanidosona. Mayraama yan hayqada moogetasu.<verse eid="NUM 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 20:2" />He bessan asaas haathi dhayin, asay Muse bollanne Aarona bolla dendidosona. <verse eid="NUM 20:2" /><verse number="3" style="v" sid="NUM 20:3" />Enti, “Nu ishati Godaa sinthan hayqida wode nuka hayqida gidorkoshin. <verse eid="NUM 20:3" /><verse number="4" style="v" sid="NUM 20:4" />Nunne nu mehey ha mela biittan hayqana mela Godaa maabara ha bessa ayis ehidetii? <verse eid="NUM 20:4" /><verse number="5" style="v" sid="NUM 20:5" />Gibxefe kessidi ha iita bessaa nuna ayis ehidetii? Haysan kathi woyko balasey woyko woyney woyko oromaaney baawa; hari attoshin uyetiya haathika haysan baawa” yaagidi Musera kacetidosona.<verse eid="NUM 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 20:6" />Yaatin Museynne Aaroni asaa matape geeshsha dunkaaniya penge bidi sa7an gufannidosona; Godaa bonchoyka entaw qoncis. <verse eid="NUM 20:6" /><verse number="7" style="v" sid="NUM 20:7" />Goday Museko, <verse eid="NUM 20:7" /><verse number="8" style="v" sid="NUM 20:8" />“Ne xam7a eka; neeranne ne ishaa Aaronara maabara shiishite. Enta sinthan zaallay haathe kessana mela oda. Hinte zaallafe haathe kessidi, entanne enta mehiya ushshana” yaagis. <verse eid="NUM 20:8" /><verse number="9" style="v" sid="NUM 20:9" />Goday kiitidaysada Musey Godaa sinthafe xam7aa ekis.<verse eid="NUM 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 20:10" />Museynne Aaroni maabara zaalla sinthan shiiqana mela oothidi, asaako, “Hinteno geellato, si7ite; ha zaallafe hintew nuuni tuma haathe kessanee?” yaagis. <verse eid="NUM 20:10" /><verse number="11" style="v" sid="NUM 20:11" />Musey ba xam7a denthidi zaalla nam7u toho shocis; haathi dhuuqidi keyin entinne enta meheti uyidosona.<verse eid="NUM 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 20:12" />Shin Goday Musekonne Aaronako, “Isra7eele asaa sinthan hinte ta geeshshatetha bessanaw ammanetibona gisho ta entaw immiya biitta ha asaa kaalethidi hinte geleketa” yaagis.<verse eid="NUM 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 20:13" />Isra7eele asay Godaara kacetida gishonne Goday ba geeshshatetha enta giddon qoncisida gisho he bessay Mariba<note caller="+" style="f"><char style="fr" closed="false">20:13 </char><char style="fqa" closed="false">Mariba: </char><char style="ft" closed="false">Kacetethi guussu.</char></note> haatha geetetis.<verse eid="NUM 20:13" /></para>
  <para style="s1">Isra7eeleti Edoomera Aadhethi Digetidosona</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 20:14" />Edoome kawako Musey Qaadesape haysada yaagidi kiita yeddis. “Ne ishay Isra7eeley haysada yaagees; nuna gakida meto ubbaa ne si7adasa. <verse eid="NUM 20:14" /><verse number="15" style="v" sid="NUM 20:15" />Nu mayzati duge Gibxe wodhidosona; yan nuuni daro laythi de7ida. Gibxeti nunanne nu aawata un7ethidosona. <verse eid="NUM 20:15" /><verse number="16" style="v" sid="NUM 20:16" />Nuuni Godaako waassin, I nu waasuwa si7idi, ba kiitanchuwa Kiitidi nuna Gibxefe kessis. Ha77i nuuni ne biitta gaxan de7iya Qaadesa kataman de7oos. <verse eid="NUM 20:16" /><verse number="17" style="v" sid="NUM 20:17" />Hayyana, nuuni ne biittaara kanthidi aadhana mela ootharki; nuuni ogepe gaxa keyoko; ne goshsha woyko woyne gade giddo geloko; nuuni haatha ollafe haathe uyoko. Nuuni kawo oge oykidi baana; nuuni ne biittara kanthidi aadhana gakanaw haddirsi woyko ushachi gooko” yaagis.<verse eid="NUM 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 20:18" />Shin Edoome asay, “Nu biittaara kanthisoko; hinte haysara kanthanaw qopiko, nuuni dendidi hintena olana” yaagidosona.<verse eid="NUM 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 20:19" />Yaatin Isra7eele asay, “Nuuni kawo ogiyara baana; nuuni woyko nu mehey hinte haathaafe uyiko, nuuni hessas gate ciggana; nuuni tohora aadhetha xalaala koyoos; haraba aykoka koyoko” yaagidosona.<verse eid="NUM 20:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 20:20" />Edoome asay zaaridi, “Hinte haysara aadhanaw danda7eketa” yaagis. Kaallidi, daronne wolqaama olanchota ekidi Isra7eele asaa olanaw keyis. <verse eid="NUM 20:20" /><verse number="21" style="v" sid="NUM 20:21" />Edoome asay banta biittara Isra7eele asaa aathona ixin, Isra7eele asay simmidi hara ogera bidosona.<verse eid="NUM 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 20:22" />Isra7eele asa ubbay Qaadesape dendidi Hoora zumako bidosona. <verse eid="NUM 20:22" /><verse number="23" style="v" sid="NUM 20:23" />Edoome zawan de7iya Hoora zuman, Goday Musekonne Aaronako, <verse eid="NUM 20:23" /><verse number="24" style="v" sid="NUM 20:24" />“Aaroni ba mayzatan gahetiya wodey gakis. Hinte nam7ay Mariba haatha matan ta kiitaa bolla geellatida gisho Isra7eele asaas ta immiya biitta I gelenna. <verse eid="NUM 20:24" /><verse number="25" style="v" sid="NUM 20:25" />Aaronanne iya na7aa Alaazara ekada Hoora zuma bolla keya. <verse eid="NUM 20:25" /><verse number="26" style="v" sid="NUM 20:26" />Aarona kahinetetha ma7uwa qaarada, iya na7aa Alaazara mayza. Aaroni yan hayqana” yaagis.<verse eid="NUM 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 20:27" />Goday kiitidaysada Musey oothis; Isra7eele asa ubbay be7ishin, enti Hoora zuma bolla keyidosona. <verse eid="NUM 20:27" /><verse number="28" style="v" sid="NUM 20:28" />Musey Aarona kahinetetha ma7uwa qaaridi iya na7aa Alaazara mayzis. Aaroni he zuma huuphen hayqis. Museynne Alaazari zumaape wodhidosona. <verse eid="NUM 20:28" /><verse number="29" style="v" sid="NUM 20:29" />Aaroni hayqidaysa Isra7eele asay erida wode Isra7eele asay Aaronas hastamu gallas yeekidosona.<verse eid="NUM 20:29" /></para>
  <chapter eid="NUM 20" />
  <chapter number="21" style="c" sid="NUM 21" />
  <para style="s1">Arada Xoonetethaa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 21:1" />Kanaane biittan, Negebe mela biittan de7iya Arada Kawoy, Isra7eele asay Ataarima efiya ogiyara yeysa si7ida wode Isra7eele asaara oletidi entafe guutha asaa di7idosona. <verse eid="NUM 21:1" /><verse number="2" style="v" sid="NUM 21:2" />He wode Isra7eele asay, “Neeni ha asaa nu kushen aathada immiko, nuuni entanne enta katamata kumethi dhaysana” yaagidi Godaas qangidosona. <verse eid="NUM 21:2" /><verse number="3" style="v" sid="NUM 21:3" />Goday Isra7eele asaa woosa si7idi, Kanaaneta enta kushen aathidi immin, enti Kanaanetanne enta katamata kumethi dhaysidosona. Hessa gisho, he bessay Horma<note caller="+" style="f"><char style="fr" closed="false">21:3 </char><char style="fqa" closed="false">Horma: </char><char style="ft" closed="false">Kumethi woyko polo dhayso guussu </char></note> geetetidi sunthetis.<verse eid="NUM 21:3" /></para>
  <para style="s1">Naase Biratape Oosetida Shooshu</para>
  <para style="p">
    <verse number="4" style="v" sid="NUM 21:4" />Isra7eele asay Hoora zumaape dendidi, Edoome biitta yuushuwara baanaw Zo7o Abbaako efiya ogiyara bidosona; shin oge bolla asaas danda7ay wuris. <verse eid="NUM 21:4" /><verse number="5" style="v" sid="NUM 21:5" />Asay, “Nuuni mela biitta hayqana mela Gibxefe nuna ayis kessidetii? Kathi baawa; haathi baawa; ha iita kathay nuna shaattis” yaagidi Xoossaa bollanne Muse bolla zuuzumidosona.<verse eid="NUM 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 21:6" />Yaatin, Goday asaa giddo marzera de7iya shooshi yeddin, Isra7eele asaape daroti duketidi hayqidosona. <verse eid="NUM 21:6" /><verse number="7" style="v" sid="NUM 21:7" />Asay Museko yidi, “Nuuni Godaa bollanne ne bolla zuuzumidi, nagara oothida. Goday ha shooshata nuupe haassana mela nuus woossarki” yaagidosona. Yaatin, Musey asaa gisho woossis.<verse eid="NUM 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 21:8" />He wode Goday Museko, “Naase biratape shooshi medhada, enta sinthan mitha bolla kaqa; shooshan duketida oonika iya be7iko paxana” yaagis. <verse eid="NUM 21:8" /><verse number="9" style="v" sid="NUM 21:9" />Yaatin, Musey naase biratape shooshi medhidi, mitha bolla kaqis. Shooshan duketida asa ubbay naase birata shooshaa be7idi paxidosona.<verse eid="NUM 21:9" /></para>
  <para style="s1">Hoora Zumaape Moo7abe Gakanaw</para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 21:10" />Isra7eele asay Hoorape dendidi Obota geetetiya bessan dunkaanidosona. <verse eid="NUM 21:10" /><verse number="11" style="v" sid="NUM 21:11" />Obotape dendidi, Moo7abepe sintha baggan de7iya mela biittan, doloha baggan Abariiman dunkaanidosona. <verse eid="NUM 21:11" /><verse number="12" style="v" sid="NUM 21:12" />Yaape dendidi, Zareeda Zangaaran dunkaanidosona. <verse eid="NUM 21:12" /><verse number="13" style="v" sid="NUM 21:13" />Yaape dendidi, Amooreta biitta gaxa gakanaw de7iya mela biittan Arnoona Shaafape hefinthan dunkaanidosona. Arnoona Shaafay Moo7abe biittasinne Amoore biittas giddon de7iya zawa. <verse eid="NUM 21:13" /><verse number="14" style="v" sid="NUM 21:14" />Hessa gisho, Godaa ola taarikiya odiya maxaafan, “Suufa heeran de7iya Waaheba katamaanne Arnoona Shaafa zangaara, <verse eid="NUM 21:14" /><verse number="15" style="v" sid="NUM 21:15" />Era katamaanne Moo7abe biitta zawa gakanaw de7iya zangaara” yaagetidi xaafetis.<verse eid="NUM 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 21:16" />Enti yaape dendidi, Goday Museko, “Asaa shiisha; ta entaw haathe immana” yaagidi odida Beera geetetiya haatha ollaako bidosona.<verse eid="NUM 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 21:17" />He wode Isra7eele asay ha mazmuriya yexidosona.</para>
  <para style="q1" vid="NUM 21:17">“Haatha ollaw, pulta;</para>
  <para style="q2" vid="NUM 21:17">Hinteka yexite.<verse eid="NUM 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 21:18" />Halaqati bookida haatha ollaas,</para>
  <para style="q2" vid="NUM 21:18">kaaletheysati kawotetha xam7aninne banta xam7an</para>
  <para style="q2" vid="NUM 21:18">bookida haatha ollaas yexite” yaagis.</para>
  <para style="p" vid="NUM 21:18">Enti he mela biittafe dendidi Mataana geetetiya bessaa bidosona. <verse eid="NUM 21:18" /><verse number="19" style="v" sid="NUM 21:19" />Maatanape Nahili7eela, Nahali7eelape Baamota geetetiya bessaa bidosona. <verse eid="NUM 21:19" /><verse number="20" style="v" sid="NUM 21:20" />Baamotape dendidi, Moo7aben de7iya zangaara bidosona; he zangaaray Pisga zumaape garsan bazzuwa ginan de7ees.<verse eid="NUM 21:20" /></para>
  <para style="s1">Sihoonanne Ooge Xoonetethaa</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 21:21" />Hessafe guye, Isra7eele asay Amoore kawa Sihooneko haysada yaagidi kiita yeddidosona. <verse eid="NUM 21:21" /><verse number="22" style="v" sid="NUM 21:22" />“Hayyana, nu ne biittara kanthidi aadhana mela ootharki; nuuni ogepe gaxa keyoko; ne goshsha woyko woyne gade giddo geloko; nuuni haatha ollafe haathe uyoko. Nuuni ne biittara kanthidi aadhana gakanaw haddirsi woyko ushachi gooko” yaagis.<verse eid="NUM 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 21:23" />Sihooney Isra7eele asay ba biittara kanthonna mela diggis. I ba olanchota ubbaa shiishidi, Isra7eele asaa olanaw mela biitta bis; Yahaaxa geetetiya bessaa bidi Isra7eele asaara oletis. <verse eid="NUM 21:23" /><verse number="24" style="v" sid="NUM 21:24" />Isra7eele asay olan Amooretape darota mashshan wodhidi, Arnoona Shaafape doomidi, Amooneta zawan de7iya Yaaboqa shaafa gakanaw oykis. Amoone asaa biitta zaway gimbetidi de7iya gisho, enti yaa gelibookona. <verse eid="NUM 21:24" /><verse number="25" style="v" sid="NUM 21:25" />Isra7eele asay Amooreta, Haseboonanne iya yuushuwan de7iya katamata ubbaa xooni ekidi yan uttidosona. <verse eid="NUM 21:25" /><verse number="26" style="v" sid="NUM 21:26" />Haseboona katamay Amooreta kawa Sihoone uttiya katama. Sihooney kase Moo7abe biitta kawa olidi, Arnoona shaafa gakanaw de7iya biitta ubbaa ekis.<verse eid="NUM 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 21:27" />Hessa gisho, leemison haysada yaagidosona;</para>
  <para style="q1" vid="NUM 21:27">“Haseboonako haayite;</para>
  <para style="q2" vid="NUM 21:27">ha katamay zaaridi keexeto;</para>
  <para style="q1" vid="NUM 21:27">Sihoone katamay</para>
  <para style="q2" vid="NUM 21:27">kase ba bessaa simmo.<verse eid="NUM 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="NUM 21:28" />Tami Haseboonape keyis;</para>
  <para style="q2" vid="NUM 21:28">lacoy Sihoona kataman bentis;</para>
  <para style="q1" vid="NUM 21:28">Moo7aben de7iya Era dhaysis;</para>
  <para style="q2" vid="NUM 21:28">Arnoona dhoqa bessata mis.<verse eid="NUM 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="NUM 21:29" />Moo7abe, nena ayye!</para>
  <para style="q2" vid="NUM 21:29">Kamoosha asay dhayideta.</para>
  <para style="q1" vid="NUM 21:29">Hinte adde nayti baqatanaada,</para>
  <para style="q2" vid="NUM 21:29">hinte macca nayti di7etanaada,</para>
  <para style="q2" vid="NUM 21:29">Amooreta kawa Sihoones immis.<verse eid="NUM 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="NUM 21:30" />Nuuni hinte kochata Haseboonape doomidi,</para>
  <para style="q2" vid="NUM 21:30">Diboona gakanaw kumethi dhaysida.</para>
  <para style="q1" vid="NUM 21:30">Medeba matan de7iya Noofa gakanaw</para>
  <para style="q2" vid="NUM 21:30">de7iya ubbaa tami dhaysis” yaagidosona.<verse eid="NUM 21:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 21:31" />Yaatidi, Isra7eele asay Amooreta biittan de7idosona. <verse eid="NUM 21:31" /><verse number="32" style="v" sid="NUM 21:32" />Qassi Musey wocheyisata Ya7izeera katamaa yeddin, Isra7eele asay he katamaanne iya heeran de7iya guutha katamata oykidi, yan de7iya Amooreta kessidi goodidosona.<verse eid="NUM 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 21:33" />Hessafe guye, Isra7eele asay simmidi, Baasane efiya ogiyara keyidosona. Baasane kawoy Oogey ba olanchotara Edraa7a kataman entara oletanaw keyis. <verse eid="NUM 21:33" /><verse number="34" style="v" sid="NUM 21:34" />Shin Goday Museko, “Ha uraas babofa; hiza, kawa Ooge, iya asaanne iya biitta ubbaa ne kushen aathada immas. Haseboonan uttidi haarida Amooreta kawa Sihoone bolla ootheysada neeni iya bolla oothana” yaagis. <verse eid="NUM 21:34" /><verse number="35" style="v" sid="NUM 21:35" />Hessa gisho, Isra7eele asay Ooge, iya naytanne iya asa ubbaa issoy attonna wodhidi iya biitta laattidosona.<verse eid="NUM 21:35" /></para>
  <chapter eid="NUM 21" />
  <chapter number="22" style="c" sid="NUM 22" />
  <para style="s1">Balaaqi Balaama Xeegisis</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 22:1" />Isra7eele asay dendidi, Iyaarko ginan, Yordaanosepe hefinthan de7iya Moo7abe denban dunkaanidosona.<verse eid="NUM 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="NUM 22:2" />Isra7eele asay Amooreta bolla oothidaysa ubbaa Sifoora na7ay Balaaqi si7is. <verse eid="NUM 22:2" /><verse number="3" style="v" sid="NUM 22:3" />Isra7eele asay daro gidida gisho, Moo7abeti daro dagammidi yayidosona. <verse eid="NUM 22:3" /><verse number="4" style="v" sid="NUM 22:4" />Moo7abeti Midiyaame cimatako, “Boori maata pitidi midi dhayseysada ha wude asay nu yuushuwan de7iya ubbaa midi dhaysana” yaagidosona.</para>
  <para style="p" vid="NUM 22:4">He wode Moo7abe kawoy, Sifoora na7ay Balaaqi, <verse eid="NUM 22:4" /><verse number="5" style="v" sid="NUM 22:5" />Amawa biittan, Efraxiisa shaafa matan, Patoora kataman de7iya Bi7oora na7aa Balaamako haysada yaagidi kiittis. “Gibxefe keyida daro asay biitta ubbaa ma7idi, ta matan dunkaanidosona. <verse eid="NUM 22:5" /><verse number="6" style="v" sid="NUM 22:6" />Enti taape daro wolqaama gidiya gisho, hayyana yada enta baaddarki. Ooni eri, ta enta xoonanawunne biittafe kessanaw danda7ana. Hiza, neeni anjeysi anjeteysa qassi neeni baaddeysi baadetidaba gideysa taani erayis” yaagis.<verse eid="NUM 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 22:7" />Moo7abe cimatinne Midiyaame cimati baadetha miishiya ekidi Balaamako bidi Balaaqi gidaysa iyaw odidosona. <verse eid="NUM 22:7" /><verse number="8" style="v" sid="NUM 22:8" />Balaami entako, “Hachi qamma haysan aqite; Goday taw odeysa ta hintew odana” yaagis. Yaanin, Moo7abe halaqati Balaamara gam7idosona.<verse eid="NUM 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 22:9" />Xoossay Balaama, “Haysati neera de7iya asati oonee?” yaagidi oychis.<verse eid="NUM 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 22:10" />Balaami Xoossaako, “Moo7abe kawoy, Sifoora na7ay Balaaqi, <verse eid="NUM 22:10" /><verse number="11" style="v" sid="NUM 22:11" />‘Gibxefe keyida daro asay, enti biitta ubbaa kumidosona. Neeni yada, enta baaddarki. Ooni eri, ta enta xoonanawunne biittafe kessanaw danda7onna aggike’ yaagidi enta taako Kiittis” yaagis.<verse eid="NUM 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 22:12" />Yaatin Xoossay Balaamako, “Neeni entara boopa; Isra7eele asay anjetida dere gidiya gisho, neeni enta baaddofa” yaagis.<verse eid="NUM 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 22:13" />Wontetha gallas wonta Balaami dendidi, Balaaqa halaqatako, “Taani hintera boonnada Goday diggida gisho, hinte biitta simmite” yaagis.<verse eid="NUM 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 22:14" />Moo7abe halaqati Balaaqako guye simmidi, “Balaami nuura yoonna ixis” yaagidosona.<verse eid="NUM 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 22:15" />Zaaridi Balaaqi kaseysatape aadho bonchetidanne taybon daro halaqata iyako kiittis. <verse eid="NUM 22:15" /><verse number="16" style="v" sid="NUM 22:16" />Enti Balaamako bidi, “Sifoora na7ay Balaaqi, ‘Neeni taako yaanaysa nena aybika teqofo. <verse eid="NUM 22:16" /><verse number="17" style="v" sid="NUM 22:17" />Ta new daro woyto immana; ne oychiyaba ubbaa ta new oothana. Hayyana yada ha asaa baaddarki’ yaagis” yaagidi odidosona.<verse eid="NUM 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 22:18" />Shin Balaami entako, “Balaaqi hari attoshin ba kawotethan kumida biraanne worqaa taw immiyaba gidikoka Godaa, ta Xoossaa kiitaa menthada aykoka pacisanaw woyko gujanaw danda7ike. <verse eid="NUM 22:18" /><verse number="19" style="v" sid="NUM 22:19" />Goday taw bessiya harabay de7iko ta erana mela hinteka hachi qamma haysan aqite” yaagis.<verse eid="NUM 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 22:20" />He qamma Xoossay Balaamako, “Ha asay nena xeeganaw yida gisho, neeni entara ba; shin ta new odeysa xalaala ootha” yaagis.<verse eid="NUM 22:20" /></para>
  <para style="s1">Balaamanne Iya Haariw</para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 22:21" />Yaatin wontetha gallas Balaami ba hariw kooridi Moo7abe halaqatara bis. <verse eid="NUM 22:21" /><verse number="22" style="v" sid="NUM 22:22" />Shin I biya gisho Xoossay hanqetis. He wode Balaami ba hariw toggidi, ba nam7u aylletara bishin Godaa kiitanchoy iya teqanaw ogen eqis. <verse eid="NUM 22:22" /><verse number="23" style="v" sid="NUM 22:23" />Godaa kiitanchoy mashsha shoddidi ogen eqidaysa hariya be7ada, ogiya aggada goshsha giddo gelasu. Balaami hariw ogen zaaranaw shocis.<verse eid="NUM 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 22:24" />Yaatin, Godaa kiitanchoy nam7u woyne gadetape giddon ya baggaranne ha baggara gimben diretida xuntha ogen eqis. <verse eid="NUM 22:24" /><verse number="25" style="v" sid="NUM 22:25" />Hariya Godaa kiitanchuwa be7ida wode gimbe dirsaako shiiqida, Balaama tohuwa gimbe dirsara oythasu; yaatin I hariw nam7antho shocis.<verse eid="NUM 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 22:26" />Hessafe guye, Godaa kiitanchoy sintha aadhidi, haddirsi woyko ushachi simmanaw ogey bayna xuntha bessan eqis. <verse eid="NUM 22:26" /><verse number="27" style="v" sid="NUM 22:27" />Hariya Godaa kiitanchuwa be7ada, Balaami toggidi de7ishin zin7asu; Balaami daro yilotidi, ba xam7an hariw shocis. <verse eid="NUM 22:27" /><verse number="28" style="v" sid="NUM 22:28" />Hessafe guye, Goday harey doona dooyin, hariya Balaama, “Ta new ay iissin tana heedzu toho shocadii?” yaagasu.<verse eid="NUM 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 22:29" />Balaami zaaridi, “Neeni tana yiloyida gishosa; ta kushen mashshi de7iyaba gidiyako ta nena ha77i wodhanashin” yaagis.<verse eid="NUM 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 22:30" />Hariya Balaamako, “Neeni hachi gakanaw toggiya ne hariw gidikina? Taani new haysada hana eriyana?” yaagasu.</para>
  <para style="p" vid="NUM 22:30">Balaami zaaridi, “Hana eraka” yaagis.<verse eid="NUM 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 22:31" />He wode Goday Balaama ayfiya dooyin, Godaa kiitanchoy shodetida mashsha oykidi ogen eqidaysa be7is. I lichi gidi som7ora sa7an gufannis. <verse eid="NUM 22:31" /><verse number="32" style="v" sid="NUM 22:32" />Godaa kiitanchoy, “Ne hariw heedzu toho ayis shocadii? Ne ogey ta sinthan geella gidiya gisho ta nena teqanaw yas. <verse eid="NUM 22:32" /><verse number="33" style="v" sid="NUM 22:33" />Hariya tana be7ada ta sinthafe heedzu toho hara soo simmasu. Hariya hara soo simmaboonnaba gidiyako, hannoode ta nena wodhada hariw ashshanashin” yaagis.<verse eid="NUM 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 22:34" />Balaami zaaridi, “Taani nagara oothas; neeni tana teqanaw oge bolla eqidaysa ta erabike. Ne dosonnaba gidiko ta ha77i guye simmana” yaagis.<verse eid="NUM 22:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 22:35" />Shin kiitanchoy Balaamako, “Neeni ha asatara ba; shin ta new odeysa xalaala oda” yaagis. Yaatin, Balaami Balaaqa biitta halaqatara bis.<verse eid="NUM 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 22:36" />Balaami yeysa Balaaqi si7ida wode Arnoona shaafa gaxan ba biitta zawan de7iya Moo7abeta kataman iya mokanaw bis. <verse eid="NUM 22:36" /><verse number="37" style="v" sid="NUM 22:37" />Balaaqi Balaamako, “Neeni ellesada yaana mela ta kiittabikina? Neeni ayis taako ellesada yabikii? Taani new kushe zaaranaw danda7ikina?” yaagis.<verse eid="NUM 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 22:38" />Balaami Balaaqako, “Heko, ha77i ta neeko yas; shin ta aykoka taape gaanaw danda7ike. Xoossay tana oda gidaba xalaala odana” yaagis. <verse eid="NUM 22:38" /><verse number="39" style="v" sid="NUM 22:39" />Yaatin, Balaami Balaaqara Qiriyat-Haxoota katamaa bis. <verse eid="NUM 22:39" /><verse number="40" style="v" sid="NUM 22:40" />Yan Balaaqi mehenne dorse yarshidi, ashuwape guuthara Balaamasinne iyara de7iya halaqatas immis.<verse eid="NUM 22:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 22:41" />Wontetha gallas Balaaqi Balaama Baamot-Ba7aali geetetiya bessa kessis; Balaami yan eqidi Isra7eele asape baggaa be7is.<verse eid="NUM 22:41" /></para>
  <chapter eid="NUM 22" />
  <chapter number="23" style="c" sid="NUM 23" />
  <para style="s1">Balaama Koyro Haasaya</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 23:1" />Balaami Balaaqako, “Haysan taw laapun yarsho bessata gimba; qassi laapun kormatanne laapun marazeta taw giigisa” yaagis. <verse eid="NUM 23:1" /><verse number="2" style="v" sid="NUM 23:2" />Balaami gidaysada Balaaqi oothis; enti nam7ay issi issi yarsho bessan issi kormanne issi maraze yarshidosona.<verse eid="NUM 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 23:3" />Yaatidi, Balaami Balaaqako, “Neeni ne yarshuwa matan de7aasha; taani gede baana. Ooni eri Goday taara gahetanaw yoonna aggenna; I taw qoncisiyaba ubbaa ta new odana” yaagidi issi dere bolla keyis. <verse eid="NUM 23:3" /><verse number="4" style="v" sid="NUM 23:4" />Yan Xoossay Balaamara gahetin, Balaami, “Taani laapun yarsho bessata giigisas; issi issi yarsho bessan issi kormanne issi maraze yarshas” yaagis.<verse eid="NUM 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 23:5" />Balaami gaanaba Goday iyaw odidi, “Neeni Balaaqako simmada iyaw ha kiita oda” yaagis. <verse eid="NUM 23:5" /><verse number="6" style="v" sid="NUM 23:6" />Balaami simmiya wode Balaaqi Moo7abe halaqata ubbaara ba yarshuwa matan eqis.<verse eid="NUM 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 23:7" />Balaami haysada yaagidi tinbite odis;</para>
  <para style="q1" vid="NUM 23:7">“Moo7abe kawoy, Balaaqi, doloha bagga deretape,</para>
  <para style="q2" vid="NUM 23:7">Soore biittafe tana ehis;</para>
  <para style="q1" vid="NUM 23:7">‘Haa ya; Yayqooba taw bada;</para>
  <para style="q2" vid="NUM 23:7">Isra7eele asaa baadda’ yaagis.<verse eid="NUM 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 23:8" />Xoossi baaddiboonaysa ta waatada baaddo?</para>
  <para style="q1" vid="NUM 23:8">Goday, baaddiboonaysa ta waatada baaddo?<verse eid="NUM 23:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 23:9" />Ta dhoqa zaalla huuphen eqada enta xeellayis;</para>
  <para style="q2" vid="NUM 23:9">zumaa bolla eqada enta be7ayis.</para>
  <para style="q1" vid="NUM 23:9">Enti bantarka de7iya dere;</para>
  <para style="q2" vid="NUM 23:9">enti hara kawotethatape dumma gideysa eroosona.<verse eid="NUM 23:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="NUM 23:10" />Yayqooba baana ooni taybi onganee?</para>
  <para style="q2" vid="NUM 23:10">Isra7eele saysuwa ooni taybi kanthanee?</para>
  <para style="q1" vid="NUM 23:10">Xillota hayquwa ta hayqarkina;</para>
  <para style="q2" vid="NUM 23:10">ta wursethay entaysada hano” yaagis.<verse eid="NUM 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 23:11" />Balaaqi Balaamako, “Neeni ta bolla oothiyabay aybee? Taani nena ta morketa baaddana mela ehas, shin neeni enta anjadasa; haraba aykoka oothabaaka” yaagis.<verse eid="NUM 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 23:12" />Balaami zaaridi, “Goday taw odeysafe haraa odoyee?” yaagis.<verse eid="NUM 23:12" /></para>
  <para style="s1">Balaama Nam7antho Haasaya</para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 23:13" />Balaaqi Balaamako, “Enta neeni be7anaw danda7iya hara bessi taara yedha; yanka ne entafe guuthara be7aasape attishin, ubbaa be7aka. Neeni yan eqada enta baaddarki” yaagis. <verse eid="NUM 23:13" /><verse number="14" style="v" sid="NUM 23:14" />Pisga deriya huuphen de7iya Xofima demba efis. Yan laapun yarsho bessata gimbidi, issi issi yarsho bessan issi kormanne issi maraze yarshis.<verse eid="NUM 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 23:15" />Balaami Balaaqako, “Neeni haysan ne yarshuwa matan de7aasha; taani Godaara gahetanaw gede baana” yaagis.<verse eid="NUM 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 23:16" />Goday Balaamara gahetidi, “Neeni Balaaqako simmada iyaw ha kiita oda” yaagis.<verse eid="NUM 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 23:17" />Balaami simmidi yaa wode Balaaqi Moo7abe biitta halaqatara yarshuwa matan eqidaysa demmis. Balaaqi iyako, “Goday new ay odidee?” yaagis.<verse eid="NUM 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 23:18" />Balaami haysada yaagidi tinbite odis;</para>
  <para style="q1" vid="NUM 23:18">“Sifoora na7aw, Balaaqa, denda;</para>
  <para style="q2" vid="NUM 23:18">ta odeysa loythada si7a.<verse eid="NUM 23:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 23:19" />Wordotanaw Xoossay ase gidenna;</para>
  <para style="q2" vid="NUM 23:19">ba qofaa laammanaw asa na7a gidenna.</para>
  <para style="q1" vid="NUM 23:19">Odidi, ba odidaysa oothennee?</para>
  <para style="q2" vid="NUM 23:19">Woyko ba gidaysa polennee?<verse eid="NUM 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="NUM 23:20" />Taani anjanaw kiita ekas;</para>
  <para style="q2" vid="NUM 23:20">I anjis; ta laammanaw danda7ike.<verse eid="NUM 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="NUM 23:21" />Yayqooba kochaa bolla iitabay yeenna;</para>
  <para style="q2" vid="NUM 23:21">Isra7eele asaa metoy gakenna.</para>
  <para style="q1" vid="NUM 23:21">Goday, enta Xoossay entara de7ees;</para>
  <para style="q2" vid="NUM 23:21">I entaw kawo gideysa awaajosona.<verse eid="NUM 23:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 23:22" />Xoossay enta Gibxefe kessis;</para>
  <para style="q2" vid="NUM 23:22">I mino menthada entaw oletees.<verse eid="NUM 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="NUM 23:23" />Yayqooba kochaa bolla biti oothenna;</para>
  <para style="q2" vid="NUM 23:23">Isra7eele asaa qohana murunnoy baawa.</para>
  <para style="q1" vid="NUM 23:23">Heko, Yayqoobasinne Isra7eeles</para>
  <para style="q2" vid="NUM 23:23">‘Xoossay oothidaba be7ite’ yaagana.<verse eid="NUM 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 23:24" />Ha asay macca gaammoda dendees;</para>
  <para style="q2" vid="NUM 23:24">ba oykidaba maana gakanaw,</para>
  <para style="q2" vid="NUM 23:24">ba wodhidaysa suuthaa uyana gakanaw,</para>
  <para style="q2" vid="NUM 23:24">shemponna gaammoda dendoosona” yaagis.<verse eid="NUM 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 23:25" />Yaatin, Balaaqi Balaamako, “Ne enta ubbaka baaddofa; ubbaka anjofa” yaagis.<verse eid="NUM 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 23:26" />Balaami zaaridi, “Taani Goday giyaba xalaala oothana gada new odabikina?” yaagis.<verse eid="NUM 23:26" /></para>
  <para style="s1">Balaama Heedzantho Haasaya</para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 23:27" />Balaaqi Balaamako, “Haaya; ta nena hara bessi efana. Ooni eri, hessan Xoossay ufaytidi, neeni yan eqada enta baaddana mela oothanaw danda7ees” yaagis. <verse eid="NUM 23:27" /><verse number="28" style="v" sid="NUM 23:28" />Balaaqi Balaama bazzuwa duge xeelliya Paa7ora zuma bolla efis.<verse eid="NUM 23:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 23:29" />Balaami, “Neeni haysan taw laapun yarsho bessata gimba; qassi laapun kormatanne laapun marazeta taw giigisa” yaagis. <verse eid="NUM 23:29" /><verse number="30" style="v" sid="NUM 23:30" />Balaami gidaysada Balaaqi oothis; issi issi yarsho bessan issi kormanne issi maraze yarshis.<verse eid="NUM 23:30" /></para>
  <chapter eid="NUM 23" />
  <chapter number="24" style="c" sid="NUM 24" />
  <para style="p">
    <verse number="1" style="v" sid="NUM 24:1" />Balaami Isra7eele anjeysi Godaa ufaysidaysa I be7ida wode kase I ootheysada bita malla koybeenna, shin ba som7uwa mela biittako zaaris. <verse eid="NUM 24:1" /><verse number="2" style="v" sid="NUM 24:2" />I dhoqu gidi xeelliya wode Isra7eele asay ba kochan kochan dunkaanidi uttidaysa be7iya wode Xoossaa Ayyaanay iya bolla wodhis. <verse eid="NUM 24:2" /><verse number="3" style="v" sid="NUM 24:3" />I haysada yaagidi tinbite odis;</para>
  <para style="q1" vid="NUM 24:3">“Bi7oora na7aa Balaama tinbitiya;</para>
  <para style="q2" vid="NUM 24:3">iya ayfey dooyetin xeelliya addiya tinbitiya;<verse eid="NUM 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="NUM 24:4" />Xoossay giyaba si7eysa tinbitiya;</para>
  <para style="q2" vid="NUM 24:4">I som7ora gufannin, iya ayfey dooyetidaysi;</para>
  <para style="q2" vid="NUM 24:4">Ubbaa danda7iya Xoossaa qoncethaa be7ida addiya tinbitey haysa.<verse eid="NUM 24:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="NUM 24:5" />Yayqooba, ne dunkaaneti,</para>
  <para style="q2" vid="NUM 24:5">Isra7eele, ne gutati,</para>
  <para style="q2" vid="NUM 24:5">ayba lo77oona.<verse eid="NUM 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="NUM 24:6" />Enti micetida zangaarada,</para>
  <para style="q2" vid="NUM 24:6">shaafa gaxan de7iya atakiltiya bessada,</para>
  <para style="q2" vid="NUM 24:6">Goday tokida godare uuthada,</para>
  <para style="q2" vid="NUM 24:6">haatha gaxan de7iya ziga mithada hanoosona.<verse eid="NUM 24:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="NUM 24:7" />Enta xuggay haathan kumana;</para>
  <para style="q2" vid="NUM 24:7">enta kochay gidiya haathi demmana.</para>
  <para style="q1" vid="NUM 24:7">Enta kawoy kawa Agaagape aadhana;</para>
  <para style="q2" vid="NUM 24:7">enta kawotethay bonchetana.<verse eid="NUM 24:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="NUM 24:8" />Xoossay enta Gibxefe kessis;</para>
  <para style="q2" vid="NUM 24:8">I mino menthada entaw oletees.</para>
  <para style="q1" vid="NUM 24:8">Enta morketa mentherethees;</para>
  <para style="q2" vid="NUM 24:8">enta meqethaa gaaccees;</para>
  <para style="q2" vid="NUM 24:8">ba dongiyan caddees.<verse eid="NUM 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="NUM 24:9" />Enti gaammoda zin7idosona;</para>
  <para style="q2" vid="NUM 24:9">macca gaammoda zaqullidosona;</para>
  <para style="q2" vid="NUM 24:9">enta boshechanaw danda7ey oonee?</para>
  <para style="q1" vid="NUM 24:9">Enta anjiya ubbay anjetana;</para>
  <para style="q2" vid="NUM 24:9">enta baaddiya ubbay baadetana” yaagis.<verse eid="NUM 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 24:10" />Yaatin, Balaaqi Balaama bolla yilotis. Ba kushiya baqidi Balaamako, “Ta morketa baaddana mela ta nena ehas, shin neeni heedzu toho enta anjadasa. <verse eid="NUM 24:10" /><verse number="11" style="v" sid="NUM 24:11" />Ha77i ellesada ne soo ba; ta nena darobaa woytana gas, shin neeni woytuwa ekonna mela Goday nena diggis” yaagis.<verse eid="NUM 24:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 24:12" />Balaami Balaaqako zaaridi, “Neeni taako kiitida asaako, <verse eid="NUM 24:12" /><verse number="13" style="v" sid="NUM 24:13" />‘Balaaqi hari attoshin ba kawotethan kumida biraanne worqaa taw immiyaba gidikoka Goday odidaysa menthada lo77o woyko iita ta shenen oothanaw danda7ike. Taani Goday giyaba xalaala odana’ gada new odabikinayee?” yaagis.<verse eid="NUM 24:13" /></para>
  <para style="s1">Balaama Oyddantho Haasaya</para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 24:14" />Balaami Balaaqako, “Taani ha77i ta asaako bayis; shin ne haaya; Isra7eele asay yaana wodiyan ne asaa oothanaba ta new odana” yaagis. <verse eid="NUM 24:14" /><verse number="15" style="v" sid="NUM 24:15" />I ba tinbitiya haysada yaagidi odis;</para>
  <para style="q1" vid="NUM 24:15">“Iya ayfey tishshi oothidi xeelliya,</para>
  <para style="q2" vid="NUM 24:15">Bi7oora na7aa Balaama tinbitey haysa.<verse eid="NUM 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="NUM 24:16" />Haysi Xoossay giyaba si7eysa tinbitiya,</para>
  <para style="q2" vid="NUM 24:16">Ubbaa danda7iya Xoossafe</para>
  <para style="q2" vid="NUM 24:16">gidida eratethi de7iya uray.</para>
  <para style="q1" vid="NUM 24:16">Lichi gidi som7ora gufannin,</para>
  <para style="q2" vid="NUM 24:16">iya ayfey dooyetidaysinne</para>
  <para style="q1" vid="NUM 24:16">Ubbaa Danda7iya Xoossaa</para>
  <para style="q2" vid="NUM 24:16">qoncethaa be7eysa tinbitey haysa.<verse eid="NUM 24:16" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="17" style="v" sid="NUM 24:17" />“Taani iya be7ayis, shin wodey ha7i gidenna;</para>
  <para style="q2" vid="NUM 24:17">ta iya xeellayis, shin matan deenna.</para>
  <para style="q1" vid="NUM 24:17">Yayqooba sheeshape xoolintoy keyana;</para>
  <para style="q2" vid="NUM 24:17">Isra7eelepe kawotetha xam7ay keyana.</para>
  <para style="q1" vid="NUM 24:17">Moo7abe asaa som7uwa I gaaccana;</para>
  <para style="q2" vid="NUM 24:17">Seeta asaa ubbaa huuphiya I tinchana.<verse eid="NUM 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="NUM 24:18" />Edoomey xoonetana;</para>
  <para style="q2" vid="NUM 24:18">iya morkey Sayrey oyketana;</para>
  <para style="q2" vid="NUM 24:18">shin Isra7eeley minni minni baana.<verse eid="NUM 24:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="NUM 24:19" />Yayqoobape haareysi keyana;</para>
  <para style="q2" vid="NUM 24:19">kataman paxa attidaysata dhaysana” yaagis.<verse eid="NUM 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 24:20" />Hessafe guye, Balaami Amaaleqa be7idi haysada yaagidi tinbite odis;</para>
  <para style="q1" vid="NUM 24:20">“Amaaleqi kawotethata giddon koyro,</para>
  <para style="q2" vid="NUM 24:20">shin enta wursethay dhayo” yaagis.<verse eid="NUM 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 24:21" />Qassi Balaami Qeena be7idi haysada yaagidi tinbite odis.</para>
  <para style="q1" vid="NUM 24:21">“Hinte de7iya bessay saro bessi;</para>
  <para style="q2" vid="NUM 24:21">hinte keethay zaalla bolla keexetis.<verse eid="NUM 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="NUM 24:22" />Shin Asooreti hintena di77iya wode,</para>
  <para style="q2" vid="NUM 24:22">hinte Qeena asay dhayana” yaagis.<verse eid="NUM 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 24:23" />Wursethan Balaami haysada yaagidi tinbite odis;</para>
  <para style="q1" vid="NUM 24:23">“Xoossay hessa oothiya wode,</para>
  <para style="q2" vid="NUM 24:23">ooni de7on daanaw danda7ii?<verse eid="NUM 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="NUM 24:24" />Markabeti Qophiroosape yaana;</para>
  <para style="q2" vid="NUM 24:24">enti Asoorenne Ebeera xoonana;</para>
  <para style="q2" vid="NUM 24:24">shin entika qassi dhayana” yaagis.<verse eid="NUM 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 24:25" />Hessafe guye, Balaami dendidi ba soo simmis; Balaaqika ba ogiya bis.<verse eid="NUM 24:25" /></para>
  <chapter eid="NUM 24" />
  <chapter number="25" style="c" sid="NUM 25" />
  <para style="s1">Moo7abeti Isra7eeleta Balethidosona</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 25:1" />Isra7eele asay Seexima geetetiya bessan dunkaanidi de7ishin, Isra7eele addeti Moo7abe maccatara laymato doomidosona. <verse eid="NUM 25:1" /><verse number="2" style="v" sid="NUM 25:2" />He maccasati banta xoossata yarshuwa maana mela xeegidosona. Enti he yarsho kathaa midi enta xoossata goyinnidosona. <verse eid="NUM 25:2" /><verse number="3" style="v" sid="NUM 25:3" />Isra7eeleti Bi7eel-Fagoora geetetiya eeqa goyinnida gisho Goday enta bolla hanqetis. <verse eid="NUM 25:3" /><verse number="4" style="v" sid="NUM 25:4" />Yaatin, Goday Museko, “Godaa hanqoy Isra7eelepe simmana mela kaalethiya asa ubbaa efada seeta gallas Godaa sinthan kaqa” yaagis. <verse eid="NUM 25:4" /><verse number="5" style="v" sid="NUM 25:5" />Musey Isra7eele daynnatako, “Hinte issoy issoy Bi7eel-Fagoora geetetiya eeqa goyinnida asa ubbaa wodhite” yaagis.<verse eid="NUM 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 25:6" />Museynne maabaray ubbay geeshsha dunkaaniya pengen yeekishin, Isra7eeletape issoy Midiyaame maccasiw enta sinthara aathidi, ba keetha asaako ehis. <verse eid="NUM 25:6" /><verse number="7" style="v" sid="NUM 25:7" />Kahiniya Aarona na7aa Alaazara na7ay Pinihaasi hessa be7ida wode maabara giddofe dendidi, toora ekidi, <verse eid="NUM 25:7" /><verse number="8" style="v" sid="NUM 25:8" />Isra7eele addiya kaallidi dunkaaniya giddo gelidi, uraanne maccasiw tooran caddidi kanthi kessis. Hessi hanin Isra7eeleta wursiya gadoy eqis. <verse eid="NUM 25:8" /><verse number="9" style="v" sid="NUM 25:9" />Shin he gadoy laatamanne oyddu mukulu asaa wodhis.<verse eid="NUM 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 25:10" />Goday Museko, <verse eid="NUM 25:10" /><verse number="11" style="v" sid="NUM 25:11" />“Kahiniya Aarona na7aa Alaazara na7ay Pinihaasi Isra7eele asaa giddon taani ta bonchuwas misheteysada mishetida gisho, taani hinte bolla hanqetida hanquwa doshisis. Taani ta qaanatiyan enta polo dhaysabike. <verse eid="NUM 25:11" /><verse number="12" style="v" sid="NUM 25:12" />Hessa gisho, taani ta sarotetha caaquwa iyara caaqanaysa Pinihaasas oda. <verse eid="NUM 25:12" /><verse number="13" style="v" sid="NUM 25:13" />I ba Xoossaa bonchuwas mishetida gishonne Isra7eele asaas nagara atotetha ehida gisho, inne iya kochay merinaw kahine gidana” yaagis.<verse eid="NUM 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 25:14" />Midiyaame maccaseera hayqida uraa sunthay Saalu na7aa Zimira geetetees. Saalu Simoona kochan issi kochaa halaqa. <verse eid="NUM 25:14" /><verse number="15" style="v" sid="NUM 25:15" />Hayqida Midiyaame maccase sunthay Kozibo; I aaway Zuri Midiyaameta kochaa halaqa.<verse eid="NUM 25:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 25:16" />Goday Museko, <verse eid="NUM 25:16" /><verse number="17" style="v" sid="NUM 25:17" />“Midiyaame biitta asaa morkidi enta wodhite. <verse eid="NUM 25:17" /><verse number="18" style="v" sid="NUM 25:18" />Enti hintena morkidi Paa7oran cimmidosona qassi bosha gallas Paa7oran hayqida Midiyaameta kochaa halaqa na7e Kozibi gaason hintena morkidosona” yaagis.<verse eid="NUM 25:18" /></para>
  <chapter eid="NUM 25" />
  <chapter number="26" style="c" sid="NUM 26" />
  <para style="s1">Nam7antho Isra7eele Asa Taybetetha</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 26:1" />Boshaape guye, Goday Musekonne kahiniya Aarona na7aa Alaazarako, <verse eid="NUM 26:1" /><verse number="2" style="v" sid="NUM 26:2" />“Laythi laatamanne iyape bolla gidida Isra7eeleta, olanaw danda7eyisata ubbaa, enta keethan keethan taybite” yaagis.<verse eid="NUM 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 26:3" />Yaatin, Museynne kahiney Alaazari Yordaanose Shaafape hefinthan, Iyaarko matan, Moo7abe denban asaa shiishidi, <verse eid="NUM 26:3" /><verse number="4" style="v" sid="NUM 26:4" />“Goday Muse kiitidaysada, laythi laatamanne iyape bolla gidida asaa taybidosona.”</para>
  <para style="p" vid="NUM 26:4">Gibxefe keyida Isra7eele asay haysata.<verse eid="NUM 26:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 26:5" />Isra7eele bayra na7aa Robeela kochati banta kochan kochan, Hanooka kochaa, Faalu kochaa, <verse eid="NUM 26:5" /><verse number="6" style="v" sid="NUM 26:6" />Hesiroona kochaanne Karma kochaa; <verse eid="NUM 26:6" /><verse number="7" style="v" sid="NUM 26:7" />Haysati Robeela kochata; enta kumetha tayboy 43,730. <verse eid="NUM 26:7" /><verse number="8" style="v" sid="NUM 26:8" />Faalu na7ay Eli7aaba; <verse eid="NUM 26:8" /><verse number="9" style="v" sid="NUM 26:9" />Eli7aaba adde nayti Nemu7eela, Daatanenne Abeero. Daataninne Abeeroy maabaray dooridaysata, shin enti Qorenne iya kaalleysatara tobbidi Godaa bolla makallidi Muse bollanne Aarona bolla dendidosona. <verse eid="NUM 26:9" /><verse number="10" style="v" sid="NUM 26:10" />Biittay dooyetidi enta Qorera issife mittis; enta kaalliya 250 asaa tami min hayqidosona. Yaatin, harati enta be7idi naagetana mela malla gididosona. <verse eid="NUM 26:10" /><verse number="11" style="v" sid="NUM 26:11" />Shin Qore adde nayti ubbay hayqidi dhaybookona.<verse eid="NUM 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 26:12" />Simoona kochati banta kochan kochan, Nemu7eela kochaa, Yamina kochaa, Yakina kochaa, <verse eid="NUM 26:12" /><verse number="13" style="v" sid="NUM 26:13" />Zaara kochaanne Saa7ula kochaa. <verse eid="NUM 26:13" /><verse number="14" style="v" sid="NUM 26:14" />Haysati Simoona kochata; enta kumetha tayboy 22,200.<verse eid="NUM 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 26:15" />Gaade kochati banta kocha kochan, Xifoona kochaa, Haggi kochaa, Shuuna kochaa, <verse eid="NUM 26:15" /><verse number="16" style="v" sid="NUM 26:16" />Esina kochaa, Era kochaa, <verse eid="NUM 26:16" /><verse number="17" style="v" sid="NUM 26:17" />Arooda kochaanne Ari7eela kochaa. <verse eid="NUM 26:17" /><verse number="18" style="v" sid="NUM 26:18" />Haysati Gaade kochata; enta kumetha tayboy 40,500.<verse eid="NUM 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 26:19" />Yihuda adde nayti Erinne Onani Kanaane biittan hayqidosona. <verse eid="NUM 26:19" /><verse number="20" style="v" sid="NUM 26:20" />Yihuda kochati banta kochan kochan, Seela kochaa, Faaresa kochaanne Zara kochaa. <verse eid="NUM 26:20" /><verse number="21" style="v" sid="NUM 26:21" />Faaresa kochay Hesiroonanne Hamuula. <verse eid="NUM 26:21" /><verse number="22" style="v" sid="NUM 26:22" />Haysati Yihuda kochata; enta kumetha tayboy 76,500.<verse eid="NUM 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 26:23" />Yisakoora kochati banta kochan kochan, Toolla kochaa, Puu7a kochaa, <verse eid="NUM 26:23" /><verse number="24" style="v" sid="NUM 26:24" />Yasuuba kochaanne Shimroona kochaa. <verse eid="NUM 26:24" /><verse number="25" style="v" sid="NUM 26:25" />Haysati Yisakoora kochata; enta kumetha tayboy 64,300.<verse eid="NUM 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 26:26" />Zabloona kochati banta kochan kochan, Sareda kochaa, Eloona kochaanne Yahilaala kochaa. <verse eid="NUM 26:26" /><verse number="27" style="v" sid="NUM 26:27" />Haysati Zabloona kochata; enta kumetha tayboy 60,500.<verse eid="NUM 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 26:28" />Yoosefa nayta Minaasenne Efreema kochati banta kochan kochan, <verse eid="NUM 26:28" /><verse number="29" style="v" sid="NUM 26:29" />Minaasey Makira yelis, Makiri Galada yelis. <verse eid="NUM 26:29" /><verse number="30" style="v" sid="NUM 26:30" />Galada kochati, Izera koche, Kelega koche, <verse eid="NUM 26:30" /><verse number="31" style="v" sid="NUM 26:31" />Asir7eela koche, Seekema kochaa, <verse eid="NUM 26:31" /><verse number="32" style="v" sid="NUM 26:32" />Shamida kochenne Hefeera koche. <verse eid="NUM 26:32" /><verse number="33" style="v" sid="NUM 26:33" />Hefeera na7ay Selophaadi macca na7a xalaala yelis; iyaw adde na7i baawa. Selophaada macca nayta sunthay Mahilo, No7o, Hoglo, Milkonne Tirxo. <verse eid="NUM 26:33" /><verse number="34" style="v" sid="NUM 26:34" />Haysati Minaase kochata; enta kumetha tayboy 52,700.<verse eid="NUM 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 26:35" />Efreema kochati banta kochan kochan, Shutula kochaa, Bekera kochaa, Tahana kochatanne <verse eid="NUM 26:35" /><verse number="36" style="v" sid="NUM 26:36" />Shutula na7aa Erana kochata. <verse eid="NUM 26:36" /><verse number="37" style="v" sid="NUM 26:37" />Haysati Efreema kochata; enta kumetha tayboy 32,500. Yoosefa kochati banta kochan kochan haysata.<verse eid="NUM 26:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="NUM 26:38" />Biniyaame kochati banta kochan kochan, Beella kochaa, Asbeela kochaa, Akira kochaa, <verse eid="NUM 26:38" /><verse number="39" style="v" sid="NUM 26:39" />Shufaama kochaa, Hufama kochaa, <verse eid="NUM 26:39" /><verse number="40" style="v" sid="NUM 26:40" />Beella na7aa Arada kochaanne Beella na7aa Naamane kochaa. <verse eid="NUM 26:40" /><verse number="41" style="v" sid="NUM 26:41" />Haysati Biniyaame kochata; enta kumetha tayboy 45,600.<verse eid="NUM 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 26:42" />Daane kochati Saama kochaa. <verse eid="NUM 26:42" /><verse number="43" style="v" sid="NUM 26:43" />Shuhaama kochaa kumetha tayboy 64,400.<verse eid="NUM 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 26:44" />Aseera kochati banta kochan kochan, Yimina kochaa, Yisiwa kochaa, Beri7a kochaa, <verse eid="NUM 26:44" /><verse number="45" style="v" sid="NUM 26:45" />Beri7a na7a Hebeera kochaanne Beri7a na7aa Malki7eela kochaa. <verse eid="NUM 26:45" /><verse number="46" style="v" sid="NUM 26:46" />Aseeras Saraho geetetiya macca na7i de7awusu. <verse eid="NUM 26:46" /><verse number="47" style="v" sid="NUM 26:47" />Haysati Aseera kochata; enta kumetha tayboy 53,400.<verse eid="NUM 26:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 26:48" />Niftaaleme kochati banta kochan kochan, Yahixeela kochaa, Guna kochaa, <verse eid="NUM 26:48" /><verse number="49" style="v" sid="NUM 26:49" />Yexera kochaanne Shileme kochaa. <verse eid="NUM 26:49" /><verse number="50" style="v" sid="NUM 26:50" />Haysati Niftaaleme kochata; enta kumetha tayboy 45,400.<verse eid="NUM 26:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="NUM 26:51" />Taybetida Isra7eele adde asaa tayboy kumethi 601,730.<verse eid="NUM 26:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="NUM 26:52" />Goday Museko, <verse eid="NUM 26:52" /><verse number="53" style="v" sid="NUM 26:53" />“Ha kochatas enta sunthaa sunthaa taybuwan biitta shaakada laata oothada entaw imma. <verse eid="NUM 26:53" /><verse number="54" style="v" sid="NUM 26:54" />Taybon dareysatas darsada qassi taybon guuxeysatas guuthada imma. Ubbayka xaafetida banta taybuwa keena eko. <verse eid="NUM 26:54" /><verse number="55" style="v" sid="NUM 26:55" />Shin biittay saaman shaaketo; issi issi kochay laata ekey ba kochaa sunthan gido. <verse eid="NUM 26:55" /><verse number="56" style="v" sid="NUM 26:56" />Issi issi laatay taybon darota giddoninne taybon guuthata giddon saaman shaaketees” yaagis.<verse eid="NUM 26:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="NUM 26:57" />Banta zerthan zerthan taybetida Leewe kochati haysata; Gedisoona kochaa, Qahaata kochaanne Meraara kochaa. <verse eid="NUM 26:57" /><verse number="58" style="v" sid="NUM 26:58" />Haysatika qassi Leewe kochata; Libina kochaa, Kebroona kochaa, Mohoola kochaa, Muse kochaanne Qore kochaa. Qahaati Amraama yelis. <verse eid="NUM 26:58" /><verse number="59" style="v" sid="NUM 26:59" />Amraama mache sunthay Yokebeedo; iya Gibxen Leewepe yeletida Leewe na7a. Iya Aarona, Musenne enta michiw Mayraamo yelasu. <verse eid="NUM 26:59" /><verse number="60" style="v" sid="NUM 26:60" />Aaronas Naadabe, Abyooda, Alaazaranne Itamaara geetetiya oyddu nayti de7oosona. <verse eid="NUM 26:60" /><verse number="61" style="v" sid="NUM 26:61" />Shin Naadabeynne Abyoodi Godaa sinthan geeshshi gidonna taman yarsho yarshida gisho boshan hayqidosona. <verse eid="NUM 26:61" /><verse number="62" style="v" sid="NUM 26:62" />Laythi issi ageenanne iyape bolla gidida Leewe adde nayta tayboy laatamanne heedzu mukula. Isra7eele asaa giddon entaw laata biitti imetiboonna gisho enti Isra7eeletara taybetibookona.<verse eid="NUM 26:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="NUM 26:63" />Yordaanose Shaafape hefinthan, Iyaarko matan, Moo7abe denban Museynne kahiney Alaazari Isra7eele asaa taybida wode taybetida asay haysa. <verse eid="NUM 26:63" /><verse number="64" style="v" sid="NUM 26:64" />Museynne kahiney Aaroni koyro Siina mela biittan Isra7eele taybida wode taybetida asaape mexi issi asika attibeenna. <verse eid="NUM 26:64" /><verse number="65" style="v" sid="NUM 26:65" />Goday ha Isra7eeletaba, “Enti ubbay mela biittan hayqana” yaagidi odida gisho, Yoofona na7aa Kaalebapenne Nawe na7aa Iyyasupe attishin, hari issi asika attibeenna.<verse eid="NUM 26:65" /></para>
  <chapter eid="NUM 26" />
  <chapter number="27" style="c" sid="NUM 27" />
  <para style="s1">Selophaada Macca Nayta Oysha</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 27:1" />Selophaadi Hefeera na7a; Hefeeri Galada na7a; Galadi Makira na7a; Makiri Minaase na7a; Minaasey Yoosefa na7a. Selophaada macca nayti Mahilo, No7o, Hoglo, Milkonne Tirxo. <verse eid="NUM 27:1" /><verse number="2" style="v" sid="NUM 27:2" />Ha macca nayti geeshsha dunkaaniya pengen Muse sinthan, kahiniya Alaazara sinthan, halaqata sinthaninne maabara ubbaa sinthan eqidi, <verse eid="NUM 27:2" /><verse number="3" style="v" sid="NUM 27:3" />“Nu aaway mela biittan hayqis; I ba nagaraa gaason hayqisipe attishin, Godaa bolla dendida Qore kaalleyisata giddon deenna. Iyaw adde na7i baawa. <verse eid="NUM 27:3" /><verse number="4" style="v" sid="NUM 27:4" />Yaatin, nu aaway adde na7a yeliboona gisho iya sunthay iya kochaa giddofe waanidi dhayii? Nu aawa dabbota giddon nuus laata biitta imma” gidoosona.<verse eid="NUM 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 27:5" />Yaatin, Musey enta oysha Godaa sinthe shiishis. <verse eid="NUM 27:5" /><verse number="6" style="v" sid="NUM 27:6" />Goday Museko, <verse eid="NUM 27:6" /><verse number="7" style="v" sid="NUM 27:7" />“Selophaada macca nayta oyshay like; enta aawa dabbota giddon neeni entaw laata biitta imma; iya gishoy enta laata gido. <verse eid="NUM 27:7" /><verse number="8" style="v" sid="NUM 27:8" />Qassi Isra7eele asaako, ‘Issi asi adde na7a yelonna hayqiko iya macca nayti laatto. <verse eid="NUM 27:8" /><verse number="9" style="v" sid="NUM 27:9" />Iyaw macca na7i baynaba gidiko iya ishati laatto. <verse eid="NUM 27:9" /><verse number="10" style="v" sid="NUM 27:10" />Iyaw ishi baynaba gidiko iya aawa ishati laatto. <verse eid="NUM 27:10" /><verse number="11" style="v" sid="NUM 27:11" />Iyaw aawa ishi baynaba gidiko iya mata dabboy laatto. Taani Goday nena kiitidaysada haysi Isra7eele asaas woga gido’ ” yaagis.<verse eid="NUM 27:11" /></para>
  <para style="s1">Muse Bessan Iyyasu Dooretetha</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 27:12" />Goday Museko, “Abariima Zumaa bolla keyada ta Isra7eele asaas immida biitta be7a. <verse eid="NUM 27:12" /><verse number="13" style="v" sid="NUM 27:13" />Ne be7idaape guye, ne ishaa Aaronada neka hayqada ne mayzatan gahetana. <verse eid="NUM 27:13" /><verse number="14" style="v" sid="NUM 27:14" />Xiina mela biittan, Mariba haatha matan asay ta bolla zuuzumida wode hinte nam7ay enta sinthan tana geeshshi oothidi bonchibeeketa” yaagis. (Mariba haathay Xiina mela biittan, Qaadesa geetetiya bessan de7iya pulto.)<verse eid="NUM 27:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 27:15" />Musey Godaako, <verse eid="NUM 27:15" /><verse number="16" style="v" sid="NUM 27:16" />“Asa ubbaas de7o immiya Godaa Xoossaw, ne asay henthanchoy bayna wude mela gidonnaada, <verse eid="NUM 27:16" /><verse number="17" style="v" sid="NUM 27:17" />ha asaa sinthan keyaanne geliya qassi enta kaalethidi kessiyanne gelsiya issi asi ha maabara bolla shuuma” yaagis.<verse eid="NUM 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 27:18" />Goday Museko, “Ayyaanay iyan de7iya Nawe na7aa Iyyasu ekada ne kushiya iya bolla wotha. <verse eid="NUM 27:18" /><verse number="19" style="v" sid="NUM 27:19" />Iya kahiniya Alaazara sinthaninne maabara ubbaa sinthan essada enti be7ishin shuuma. <verse eid="NUM 27:19" /><verse number="20" style="v" sid="NUM 27:20" />Isra7eele ubbay iyaw kiitetana mela ne maatape iyaw shaakada imma. <verse eid="NUM 27:20" /><verse number="21" style="v" sid="NUM 27:21" />Ika Uriimen Godaa sheniya oychidi shaakiya kahiniya Alaazara sinthan eqo. Iyyasuynne Isra7eele maabaray ubbay Alaazara kiitan keyonne gelo” yaagis.<verse eid="NUM 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 27:22" />Musey Goday kiitidaysada oothis; Iyyasu efidi, kahiniya Alaazara sinthaninne maabara ubbaa sinthan essis. <verse eid="NUM 27:22" /><verse number="23" style="v" sid="NUM 27:23" />Goday kiitidaysada Musey ba kushiya iya bolla wothidi shuumis.<verse eid="NUM 27:23" /></para>
  <chapter eid="NUM 27" />
  <chapter number="28" style="c" sid="NUM 28" />
  <para style="s1">Gallasa Yarshuwa</para>
  <para style="r">(<ref loc="EXO 29:38-46">Kessa 29:38-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 28:1" />Goday Museko, <verse eid="NUM 28:1" /><verse number="2" style="v" sid="NUM 28:2" />“Isra7eele asaa haysada yaagada kiitta; xuugetiya sawiya katha yarsho woden woden taw yarshite. <verse eid="NUM 28:2" /><verse number="3" style="v" sid="NUM 28:3" />Godaas taman xuugetidi yarshetiya yarshoy haysa; kumetha bollara de7iya issi laythi kumida nam7u marazeta wonta wonta xuussa yarsho oothidi yarshite. <verse eid="NUM 28:3" /><verse number="4" style="v" sid="NUM 28:4" />Marazetape issuwa wonta issuwa qassi omarsi yarshite. <verse eid="NUM 28:4" /><verse number="5" style="v" sid="NUM 28:5" />Qassi he maraziyara issi litiro shamaho zayten munuqetida issi kilo giraame lo77o giste dhiille katha yarsho yarshite. <verse eid="NUM 28:5" /><verse number="6" style="v" sid="NUM 28:6" />Haysi Godaa ufaysiya xuussa yarsho. Ika Siina zuma bolla yarshetida koyro xuussa yarsho. <verse eid="NUM 28:6" /><verse number="7" style="v" sid="NUM 28:7" />Koyro maraziyara issi litiro caala woyne ushsha yarsho oothidi yarsho bessan Godaas gussite. <verse eid="NUM 28:7" /><verse number="8" style="v" sid="NUM 28:8" />Omarsi nam7antho maraziya yarshiya wode koyroysa mela katha yarshuwanne ushsha yarshuwa gujidi yarshite. Ika Godaa ufaysiya sawo yarsho gidana.”<verse eid="NUM 28:8" /></para>
  <para style="s1">Sambaata Yarsho</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 28:9" />“Sambaata gallas borey bayna issi laythi kumida nam7u marazeta zayten munuqetida nam7u kilo giraame lo77o giste dhiille ekidi katha yarshonne ushsha yarsho oothidi yarshite. <verse eid="NUM 28:9" /><verse number="10" style="v" sid="NUM 28:10" />Gallas gallas yarshetiya xuussa yarshuwa bolla Sambaatan Sambaatan hinte yarshana xuussa yarshoynne ushsha yarshoy haysa.”<verse eid="NUM 28:10" /></para>
  <para style="s1">Ageena Xeero Yarsho</para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 28:11" />“Ageeni xeeriya koyro gallas nam7u wofaanota, issi marazenne issi laythi kumida borey bayna laapun dorsa urgeta xuussa yarsho oothidi Godaas yarshite. <verse eid="NUM 28:11" /><verse number="12" style="v" sid="NUM 28:12" />Issi issi wofaanuwara shamaho zayten munuqetida heedzu kilo giraame gidiya lo77o giste dhiillera katha yarsho oothidi yarshite. Qassi shamaho zayten munuqetida nam7u kilo giraame gidiya lo77o giste dhiilliya maraziyara wolla yarsha. <verse eid="NUM 28:12" /><verse number="13" style="v" sid="NUM 28:13" />Laapun marazetape issi issi maraze shamaho zayten munuqetida issi kilo giraame lo77o giste dhiillera xuugetiya sawiya katha yarsho oothada Godaas yarishsha. <verse eid="NUM 28:13" /><verse number="14" style="v" sid="NUM 28:14" />Qassi ushsha yarshuwa issi issi wofaanuwas nam7u litiro woyne, issi maraziyas issi litironne bagga woyne ushshaanne issi issi dorsa urgiyas issi litiro gidiya woyne ushshi shiishite. Haysi laytha giddon ageeni xeeriya koyro gallasan oosetiya xuussa yarsho. <verse eid="NUM 28:14" /><verse number="15" style="v" sid="NUM 28:15" />Gallas gallas yarshetiya xuussa yarshuwa bollanne ushsha yarshuwa bolla issi kole nagara yarsho oothidi Godaas yarshite.”<verse eid="NUM 28:15" /></para>
  <para style="s1">Paasika Yarsho</para>
  <para style="r">(<ref loc="LEV 23:5-14">Leewe 23:5-14</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 28:16" />“Koyro ageenan tammanne oyddantho gallasay Godaa Paasika bonchiya gallas gido. <verse eid="NUM 28:16" /><verse number="17" style="v" sid="NUM 28:17" />Qassi he ageenan tammanne ichashantho gallasan Uytha ba7aaley bonchetees; he gallasaape doomidi laapun gallas gakanaw irshoy geliboonna uytha miite. <verse eid="NUM 28:17" /><verse number="18" style="v" sid="NUM 28:18" />He gallasatape koyro gallasan goyinnanaw shiiqite; he gallasan ay oosoka oothopite. <verse eid="NUM 28:18" /><verse number="19" style="v" sid="NUM 28:19" />Borey bayna nam7u wofaanota, issi marazenne issi laythi kumida laapun dorsa urgeta xuussa yarsho oothidi Godaas yarshite. <verse eid="NUM 28:19" /><verse number="20" style="v" sid="NUM 28:20" />Issi wofaanuwara shamaho zayten munuqetida heedzu kilo giraame lo77o giste dhiille, issi maraziyara nam7u kilo giraame dhiillenne <verse eid="NUM 28:20" /><verse number="21" style="v" sid="NUM 28:21" />laapun dorsa urgetape issi issi dorsaara issi kilo giraame dhiille yarshite. <verse eid="NUM 28:21" /><verse number="22" style="v" sid="NUM 28:22" />Qassi issi deeshi deriya nagaraas atotethi gidana mela nagara yarsho oothidi yarshite. <verse eid="NUM 28:22" /><verse number="23" style="v" sid="NUM 28:23" />Hessa ubba wode gallas gallas yarshetiya yarshuwa bolla gujidi yarshite. <verse eid="NUM 28:23" /><verse number="24" style="v" sid="NUM 28:24" />Ubba wode oosetiya xuussa yarshuwa bollanne ushsha yarshuwa bolla gujidi laapun gallasi Godaas sawiya katha yarsho oothidi yarshite. <verse eid="NUM 28:24" /><verse number="25" style="v" sid="NUM 28:25" />Laapuntha gallasan goyinnoos shiiqite; he gallas ay oosoka oothopite.”<verse eid="NUM 28:25" /></para>
  <para style="s1">Katha Shiisho Ba7aale</para>
  <para style="r">(<ref loc="LEV 23:15-22">Leewe 23:15-22</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 28:26" />“Katha Shiisho Ba7aale saamintan koyro gallas goyinnoos shiiqiya wode hinte ooratha kathaafe yarsho yarshite; he wode ay oosoka oothopite. <verse eid="NUM 28:26" /><verse number="27" style="v" sid="NUM 28:27" />Nam7u wofaanota, issi maraziyanne issi laythi kumida laapun dorsa urgeta Godaas sawiya xuussa yarsho oothidi yarshite. <verse eid="NUM 28:27" /><verse number="28" style="v" sid="NUM 28:28" />Issi issi wofaanuwara shamaho zayten munuqetida heedzu kilo giraame lo77o giste dhiille, issi dorsa urgiyara nam7u kilo giraame dhiillenne <verse eid="NUM 28:28" /><verse number="29" style="v" sid="NUM 28:29" />laapun dorsa urgetape issi issi urgiyara issi kilo giraame giste dhiille ekidi yarshite. <verse eid="NUM 28:29" /><verse number="30" style="v" sid="NUM 28:30" />Iya bolla gujidi issi kole nagara atothetha yarsho oothidi yarshite. <verse eid="NUM 28:30" /><verse number="31" style="v" sid="NUM 28:31" />Gallas gallas yarshetiya yarshuwa bollanne ushsha yarshuwa bolla katha yarsho yarshite. Hinte yarshiya meheti borey baynaba gido.”<verse eid="NUM 28:31" /></para>
  <chapter eid="NUM 28" />
  <chapter number="29" style="c" sid="NUM 29" />
  <para style="s1">Moyze Puno Yarsho</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 29:1" />“Laapuntha ageenas koyro gallasan goyinnanaw shiiqite; ay oosoka oothopite; he gallasay moyzey punetiya gallas. <verse eid="NUM 29:1" /><verse number="2" style="v" sid="NUM 29:2" />Borey bayna issi wofaano, issi marazenne issi laythi kumida laapun dorsa urgeta sawiya xuussa yarsho oothidi Godaas yarshite. <verse eid="NUM 29:2" /><verse number="3" style="v" sid="NUM 29:3" />He wofaanuwara shamaho zayten munuqetida heedzu kilo giraame lo77o giste dhiille, issi maraziyara nam7u kilo giraame giste dhiillenne, <verse eid="NUM 29:3" /><verse number="4" style="v" sid="NUM 29:4" />laapun dorsa urgetape issi issi urgiyara issi kilo giraame dhiille yarshite. <verse eid="NUM 29:4" /><verse number="5" style="v" sid="NUM 29:5" />Qassi issi kole hintew nagaraa atotethas yarshite. <verse eid="NUM 29:5" /><verse number="6" style="v" sid="NUM 29:6" />Wogay kiiteysatho, ageena xeeron yarshetiya xuussa yarsho bolla, katha yarsho bolla, gallas gallas yarshetiya xuussa katha yarsho bollanne ushsha yarsho bolla gujidi yarshite; hessi Godaa sawiya xuussa yarsho.<verse eid="NUM 29:6" /></para>
  <para style="s1">Nagara Atotetha Yarsho</para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 29:7" />“Laapuntha ageenan tammantho gallasan ay oosoka oothopite; hintena kawushidi goyinnoos shiiqite. <verse eid="NUM 29:7" /><verse number="8" style="v" sid="NUM 29:8" />Borey bayna issi wofaano, issi marazenne issi laythi kumida laapun dorsa urgeta sawiya xuussa yarsho oothidi Godaas yarshite. <verse eid="NUM 29:8" /><verse number="9" style="v" sid="NUM 29:9" />Katha yarsho oothidi issi wofaanora shamaho zayten heedzu kilo giraame lo77o giste dhiille, issi dorsa urgiyara nam7u kilo giraame dhiillenne <verse eid="NUM 29:9" /><verse number="10" style="v" sid="NUM 29:10" />laapun dorsa urgetape issi issi urgiyara issi kilo giraame dhiille yarshite. <verse eid="NUM 29:10" /><verse number="11" style="v" sid="NUM 29:11" />Qassi nagara yarsho oothidi issi kole yarshite. Nagara atothetha yarshuwa bolla, gallas gallas yarshetiya xuussa yarshuwa bolla, katha yarshuwa bollanne ushsha yarshuwa bolla hessa gujidi yarshite.<verse eid="NUM 29:11" /></para>
  <para style="s1">Shaqara Ba7aale Yarsho</para>
  <para style="r">(<ref loc="LEV 23:33-44">Leewe 23:33-44</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 29:12" />“Laapuntha ageenan tammanne ichashantho gallasan, deexo ooso oothopite; laapun gallas kumethi Godaa bonchanaw Shaqara Ba7aale bonchite. <verse eid="NUM 29:12" /><verse number="13" style="v" sid="NUM 29:13" />Borey bayna tammanne heedzu wofaanota, nam7u marazeta, issi laythi kumida tammanne oyddu dorsa urgeta sawiya xuussa yarsho oothidi Godaas yarshite. <verse eid="NUM 29:13" /><verse number="14" style="v" sid="NUM 29:14" />Katha yarsho gidana mela tammanne heedzu wofaanotape issi issi wofaanuwara shamaho zayten munuqetida heedzu kilo giraame lo77o giste dhiille, nam7u marazetape issi issi urgiyara nam7u kilo giraame dhiillenne <verse eid="NUM 29:14" /><verse number="15" style="v" sid="NUM 29:15" />tammanne oyddu dorsa urgetape issi issi urgiyara issi kilo giraame dhiille yarshite. <verse eid="NUM 29:15" /><verse number="16" style="v" sid="NUM 29:16" />Qassi nagara yarshuwas issi kole yarshite. Hessi gallas gallas xuussa yarshuwa bolla, katha yarshuwa bollanne ushsha yarsho bolla gujidika yarshite.<verse eid="NUM 29:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 29:17" />“Nam7antho gallasan tammanne nam7u borey bayna wofaanota, nam7u marazetanne issi laythi kumida tammanne oyddu urgeta yarshite. <verse eid="NUM 29:17" /><verse number="18" style="v" sid="NUM 29:18" />Wofaanotara, marazetaranne dorsa urgetara katha yarshuwanne ushsha yarshuwa wogay kiitteysa mela enta taybuwada yarshite. <verse eid="NUM 29:18" /><verse number="19" style="v" sid="NUM 29:19" />Gallas gallas yarshetiya xuussa yarshuwa bolla, katha yarshuwa bollanne ushsha yarshuwa bolla gujidi nagara yarshuwas issi kole yarshite.<verse eid="NUM 29:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 29:20" />“Heedzantho gallasan borey bayna tammanne issi wofaanota, nam7u marazeta issi laythi kumida tammanne oyddu dorsa urgeta yarshite. <verse eid="NUM 29:20" /><verse number="21" style="v" sid="NUM 29:21" />Wofaanotara, marazetaranne dorsa urgetara katha yarshuwanne ushsha yarshuwa wogay kiitteysa mela enta taybuwada yarshite. <verse eid="NUM 29:21" /><verse number="22" style="v" sid="NUM 29:22" />Gallas gallas yarshetiya xuussa yarshuwa bolla, katha yarshuwa bollanne ushsha yarshuwa bolla nagara yarshos issi kole gujidi yarshite.<verse eid="NUM 29:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 29:23" />“Oyddantho gallasan borey bayna tammu wofaanota, nam7u marazetanne issi laythi kumida tammanne oyddu dorsa urgeta yarshite. <verse eid="NUM 29:23" /><verse number="24" style="v" sid="NUM 29:24" />Wofaanotara, marazetaranne dorsa urgetara katha yarshuwanne ushsha yarshuwa wogay kiitteysa mela enta taybuwada yarshite. <verse eid="NUM 29:24" /><verse number="25" style="v" sid="NUM 29:25" />Gallas gallas yarshetiya xuussa yarshuwa bolla, katha yarshuwa bollanne ushsha yarshuwa bolla gujidi nagara yarshos issi kole yarshite.<verse eid="NUM 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 29:26" />“Ichashantho gallasan borey bayna uddufun wofaanota, nam7u marazetanne issi laythi kumida tammanne oyddu dorsa urgeta yarshite. <verse eid="NUM 29:26" /><verse number="27" style="v" sid="NUM 29:27" />Wofaanotara, Marazetaranne dorsa urgetara katha yarshuwanne ushsha yarshuwa wogay kiiteysada enta taybuwada yarshite. <verse eid="NUM 29:27" /><verse number="28" style="v" sid="NUM 29:28" />Gallas gallas yarshetiya xuussa yarshuwa bolla, katha yarshuwa bollanne ushsha yarshuwa bolla gujidi nagara yarshos issi kole yarshite.<verse eid="NUM 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 29:29" />“Usupuntho gallasan borey bayna hospun wofaanota, nam7u marazetanne issi laythi kumida tammanne oyddu dorsa urgeta yarshite. <verse eid="NUM 29:29" /><verse number="30" style="v" sid="NUM 29:30" />Wofaanotara, Marazetaranne dorsa urgetara katha yarshuwanne ushsha yarshuwa wogay kiitteysa mela enta taybuwada yarshite. <verse eid="NUM 29:30" /><verse number="31" style="v" sid="NUM 29:31" />Gallas gallas yarshetiya xuussa yarshuwa bolla, katha yarshuwa bollanne ushsha yarshuwa bolla gujidi nagara yarshos issi kole yarshite.<verse eid="NUM 29:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 29:32" />“Laapuntha gallasan laapun wofaanota, nam7u marazetanne issi laythi kumida tammanne oyddu dorsa urgeta yarshite. <verse eid="NUM 29:32" /><verse number="33" style="v" sid="NUM 29:33" />Wofaanotara, Marazetaranne dorsa urgetara katha yarshuwanne ushsha yarshuwa wogay kiitteysa mela enta taybuwada yarshite. <verse eid="NUM 29:33" /><verse number="34" style="v" sid="NUM 29:34" />Gallas gallas yarshetiya xuussa yarshuwa bolla, katha yarshuwa bollanne ushsha yarshuwa bolla gujidi nagara yarshos issi kole yarshite.<verse eid="NUM 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 29:35" />“Hospuntha gallasan goyinnanaw shiiqite; ay oosoka oothopite. <verse eid="NUM 29:35" /><verse number="36" style="v" sid="NUM 29:36" />Borey bayna issi wofaano, issi maraze, issi laythi kumida laapun dorsa urgeta sawiya xuussa yarsho oothidi Godaas yarshite. <verse eid="NUM 29:36" /><verse number="37" style="v" sid="NUM 29:37" />Wofaanotara, Marazetaranne dorsa urgetara katha yarshuwanne ushsha yarshuwa wogay kiiteysada enta taybuwada yarshite. <verse eid="NUM 29:37" /><verse number="38" style="v" sid="NUM 29:38" />Gallas gallas yarshetiya xuussa yarshuwa bolla, katha yarshuwa bollanne ushsha yarshuwa bolla gujidi nagara yarshos issi kole yarshite.<verse eid="NUM 29:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 29:39" />“Hinte gaso yarshuwa bollanne hinte dosa yarshuwa bolla xuussa yarsho, katha yarsho, ushsha yarshonne issifetetha yarsho Baaliya bonchanaw kiitetida wodiyan yarshite” yaagis.<verse eid="NUM 29:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 29:40" />Musey, Goday bana kiittidaysa ubbaa Isra7eele asaas odis.<verse eid="NUM 29:40" /></para>
  <chapter eid="NUM 29" />
  <chapter number="30" style="c" sid="NUM 30" />
  <para style="s1">Gaso Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 30:1" />Musey Isra7eele zeretha halaqatako, “Godaa kiitay haysa; <verse eid="NUM 30:1" /><verse number="2" style="v" sid="NUM 30:2" />Issi asi Godaas issiba oothanaw caaqiko woyko issibaape bana naaganaw qangiko guye goonna polo.<verse eid="NUM 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 30:3" />“Ba aawa son de7iya geela7iya Godaas issiba oothanaw caaqiko woyko issibaape bana naaganaw qangiko, <verse eid="NUM 30:3" /><verse number="4" style="v" sid="NUM 30:4" />I aaway iya caaqidaysa woyko iya qangetidaysa si7idi, iyo diggonna ixiko, iya polanaw koshshees. <verse eid="NUM 30:4" /><verse number="5" style="v" sid="NUM 30:5" />Shin I aaway hessa si7idi iyo diggiko I caaqoynne I qangethay attanaw danda7ees. I aaway iyo diggida gisho Goday iw atto gaana.<verse eid="NUM 30:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 30:6" />“Gelonna macca na7iya caaqada de7ashe woyko issibaape bana naaganaw qangetada de7ashe azina geliko, <verse eid="NUM 30:6" /><verse number="7" style="v" sid="NUM 30:7" />I azinay hessa si7idi iyo diggonna ixiko iya ba caaquwanne ba qangetha polanaw koshshees. <verse eid="NUM 30:7" /><verse number="8" style="v" sid="NUM 30:8" />Shin I azinay hessa si7idi iyo diggiko iya caaqida caaqoy woyko qangetida qangethay iyo gomenna. Hessa Goday iw atto gaana.<verse eid="NUM 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 30:9" />“Shin am7iya woyko sayo maccasi caaqida caaquwa woyko qangida qangetha polanaw bessees.<verse eid="NUM 30:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 30:10" />“Azinara de7iya maccasi caaqiko woyko issiba oothanaw qangiko, <verse eid="NUM 30:10" /><verse number="11" style="v" sid="NUM 30:11" />I azinay hessa si7idi iyo diggonna ixiko, iya caaqida caaquwanne qangetida qangetha polo. <verse eid="NUM 30:11" /><verse number="12" style="v" sid="NUM 30:12" />I azinay hessa si7ida gallas iyo diggiko I caaqoy woyko iya oothanaw qangetida qangethay iyo gomenna. I azinay diggida gisho Goday iw atto gaana. <verse eid="NUM 30:12" /><verse number="13" style="v" sid="NUM 30:13" />I azinay iya caaqida caaquwa woyko iya bana kawushanaw qangetida qangetha laallanaw woyko minthanaw danda7ees. <verse eid="NUM 30:13" /><verse number="14" style="v" sid="NUM 30:14" />Shin I azinay he gallas woyko wontetha gallas aykoka goonna ixiko, I caaquwa woyko I qangetha minthis guussu. I hessa si7idi, si77i giiko I qofaa ma7is guussu. <verse eid="NUM 30:14" /><verse number="15" style="v" sid="NUM 30:15" />Shin I hessa si7i gam7idi zaari diggiyaba gidiko hessas oyshetey iya” yaagis.<verse eid="NUM 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 30:16" />Hiza haysi azina giddoninne machi giddon, ba aawara son de7iya geela7o giddoninne I aawa giddon de7iya gahetethaba Goday Muses immida wogaa.<verse eid="NUM 30:16" /></para>
  <chapter eid="NUM 30" />
  <chapter number="31" style="c" sid="NUM 31" />
  <para style="s1">Midiyaame Bolla Dendida Ola</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 31:1" />Goday Museko, <verse eid="NUM 31:1" /><verse number="2" style="v" sid="NUM 31:2" />“Isra7eele asaa qohida gisho Midiyaame asaa olada halo keya; hessafe guye, neeni hayqada ne mayzata gakana” yaagis.<verse eid="NUM 31:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 31:3" />Hessa gisho, Musey asaako, “Midiyaame asaa olidi Godaa halo keyana mela hinte giddofe guutha asaa olas dancisite. <verse eid="NUM 31:3" /><verse number="4" style="v" sid="NUM 31:4" />Issi issi Isra7eele kochaafe issi mukulu adde asaa olas yeddite” yaagis.<verse eid="NUM 31:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 31:5" />Hessa gisho, issi issi Isra7eele kochaafe issi issi mukulu asay keyidi, tammanne nam7u mukulu olanchoti olas giigidosona. <verse eid="NUM 31:5" /><verse number="6" style="v" sid="NUM 31:6" />Musey kahiniya Alaazara na7aa Pinihaasa aawatethan, issi issi kochaafe issi issi mukulu asi dooridi olas yeddis; Pinihaasi bishe geeshsha miishetanne mallas punniya zaye ekidi bis. <verse eid="NUM 31:6" /><verse number="7" style="v" sid="NUM 31:7" />Goday Muse kiitidaysada, enti Midiyaame asaa olidi adde ubbaa wodhidosona. <verse eid="NUM 31:7" /><verse number="8" style="v" sid="NUM 31:8" />Ichashu Midiyaame kawota, Ewa, Reqeema, Zura, Huranne Reeba geetetiya asata wodhidosona; qassi Bi7oora na7aa Balaamaka mashshan wodhidosona. <verse eid="NUM 31:8" /><verse number="9" style="v" sid="NUM 31:9" />Isra7eele asay Midiyaame maccasaanne nayta di7idosona; enta mehiya, dorsaanne deesha wudiyanne enta miishe ubbaa di7idosona. <verse eid="NUM 31:9" /><verse number="10" style="v" sid="NUM 31:10" />Enti de7iya katamatanne enta gutata ubbaa xuuggidosona. <verse eid="NUM 31:10" /><verse number="11" style="v" sid="NUM 31:11" />Asaa mehiyanne de7idaba ubbaa ekidi bidosona. <verse eid="NUM 31:11" /><verse number="12" style="v" sid="NUM 31:12" />Enti di7ida asaa, mehiyanne shalo ubbaa Iyaarkofe hefinthan, Yordaanose shaafa matan de7iya Moo7abe denban dunkaanida Museko, kahiniya Alaazarakonne Isra7eele maabaraako ehidosona.<verse eid="NUM 31:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 31:13" />Musey, kahiniya Alaazarinne maabara halaqati ubbay dunkaanida gutaape gaxa keyidi entana mokidosona. <verse eid="NUM 31:13" /><verse number="14" style="v" sid="NUM 31:14" />Musey olape simmida tora moconata, shaalaqatanne mato halaqata bolla hanqetis. <verse eid="NUM 31:14" /><verse number="15" style="v" sid="NUM 31:15" />Musey entako, “Maccasa ubbaa ayis wodhibeeketii? <verse eid="NUM 31:15" /><verse number="16" style="v" sid="NUM 31:16" />Enti Balaama zoriya si7idi, Pe7oora geetetiya bessan Isra7eele asay Godaa aggidi, boshan hayqanaada oothiday maccasa gideysa dogidetii? <verse eid="NUM 31:16" /><verse number="17" style="v" sid="NUM 31:17" />Hessa gisho, ha77i adde naytanne addera aqida maccas ubbaa wodhite. <verse eid="NUM 31:17" /><verse number="18" style="v" sid="NUM 31:18" />Shin addera aqiboona macca nayta ubbaa hintew ashshite. <verse eid="NUM 31:18" /><verse number="19" style="v" sid="NUM 31:19" />Hinte giddofe ase wodhida asi woyko aha bochida oonika gutaape gaxan laapun gallas utto; heedzantho gallasaninne laapuntha gallasan hintenanne hinte di77ida asaa geeshshite. <verse eid="NUM 31:19" /><verse number="20" style="v" sid="NUM 31:20" />Hessadaka ma7o ubbaa, galbafe, deesha ikisepenne mithafe oosetidabata ubbaa geeshshite” yaagis.<verse eid="NUM 31:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 31:21" />Kahiney Alaazari olape simmida olanchotako, “Goday Muses immida higgiya maaray haysa; <verse eid="NUM 31:21" /><verse number="22" style="v" sid="NUM 31:22" />Worqa, bira, naase, birata, qorqoro, irsaase, <verse eid="NUM 31:22" /><verse number="23" style="v" sid="NUM 31:23" />taman meetetonnabati ubbay taman geeyanaw bessees. Shin taman meetetiyabati geeshsho haathan geeyanaw bessees. <verse eid="NUM 31:23" /><verse number="24" style="v" sid="NUM 31:24" />Laapuntha gallasan hinte ma7uwa meeccite; hintena geeshshite. Hessafe guye, gutaa gelite” yaagis.<verse eid="NUM 31:24" /></para>
  <para style="s1">Di77idabaa Shaaketidosona</para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 31:25" />Goday Museko, <verse eid="NUM 31:25" /><verse number="26" style="v" sid="NUM 31:26" />“Neera, kahiniya Alaazararanne Isra7eele maabara halaqati di7etida asaanne mehiya taybite. <verse eid="NUM 31:26" /><verse number="27" style="v" sid="NUM 31:27" />Ola bidaysatasinne boonnaysatas nam7u kessidi shaakite. <verse eid="NUM 31:27" /><verse number="28" style="v" sid="NUM 31:28" />Ola bidaysata gishuwape ase gidin miizi gidin hare gidin dorse woyko deeshe gidin ichashu xeetape issino Godaas immite. <verse eid="NUM 31:28" /><verse number="29" style="v" sid="NUM 31:29" />Enta gishuwape ekida Godaa imota kahiniya Alaazaras immite. <verse eid="NUM 31:29" /><verse number="30" style="v" sid="NUM 31:30" />Hanko Isra7eeleta gakida gishuwape, ase gidin miizi gidin hare gidin dorse woyko deeshe gidin ishatammaafe issino ekidi Godaa Dunkaaniya aawatethan aysiya Leewetas immite” yaagis. <verse eid="NUM 31:30" /><verse number="31" style="v" sid="NUM 31:31" />Museynne kahiney Alaazari Goday kiitidaysada oothidosona.<verse eid="NUM 31:31" /></para>
  <para style="p">
    <verse number="32-35" style="v" sid="NUM 31:32-35" />Olanchoti bantaw ekin attida di7oy 675,000 dorsata, 72,000 miizata, 61,000 haretanne 32,000 geela7o macca nayta. <verse eid="NUM 31:32-35" /><verse number="36" style="v" sid="NUM 31:36" />Ola bidaysata gakida gishoy 337,500 dorsata; <verse eid="NUM 31:36" /><verse number="37" style="v" sid="NUM 31:37" />entafe Godaas imetiday 675. <verse eid="NUM 31:37" /><verse number="38" style="v" sid="NUM 31:38" />Miizati 36,000; entafe Godaas imetiday 72. <verse eid="NUM 31:38" /><verse number="39" style="v" sid="NUM 31:39" />Hareti 30,500; entafe Godaas imetiday 61. <verse eid="NUM 31:39" /><verse number="40" style="v" sid="NUM 31:40" />Maccasati 16,000; entafe Godaas imetiday 32. <verse eid="NUM 31:40" /><verse number="41" style="v" sid="NUM 31:41" />Goday Muse kiitidaysada Godaa imota kahiniya Alaazaras immis.<verse eid="NUM 31:41" /></para>
  <para style="p">
    <verse number="42-46" style="v" sid="NUM 31:42-46" />Ola boonna Isra7eele maabara gakida gishoy ola bida asaa gishuwara issi gina; ika 337,500 dorsata, 36,000 miizata, 30,500 haretanne 16,000 geela7o macca nayta. <verse eid="NUM 31:42-46" /><verse number="47" style="v" sid="NUM 31:47" />Isra7eele maabara gakida gishuwape ishatamu asaapenne mehiyape isso isso kessidi Goday iya kiitidaysada geeshsha Dunkaaniya aawatethan aysiya Leewetas immis.<verse eid="NUM 31:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 31:48" />Hessafe guye, tora moconati, shaalaqatinne mato halaqati Museko shiiqidi, <verse eid="NUM 31:48" /><verse number="49" style="v" sid="NUM 31:49" />“Nuuni ne aylleti nu aawatetha garsan de7iya olanchota taybin issoyka pacibeenna. <verse eid="NUM 31:49" /><verse number="50" style="v" sid="NUM 31:50" />Goday nu shempuwa ashshida gisho, nu issoy issoy ekida worqa alleeqota, sagaayota, toho albota, migiddota, haytha worqatanne qoodhe worqata Godaas immanaw ekidi yida” yaagidosona. <verse eid="NUM 31:50" /><verse number="51" style="v" sid="NUM 31:51" />Museynne kahiney Alaazari worqa alleeqota ubbaa entafe ekidosona. <verse eid="NUM 31:51" /><verse number="52" style="v" sid="NUM 31:52" />Shaalaqatinne mato halaqati Godaas immida worqay nam7u xeetu kilo giraame gidis. <verse eid="NUM 31:52" /><verse number="53" style="v" sid="NUM 31:53" />Hanko olanchoti ehida di7uwa bantaw ekidosona. <verse eid="NUM 31:53" /><verse number="54" style="v" sid="NUM 31:54" />Museynne kahiney Alaazari shalaqatapenne mato halaqatape ekida worqa Godaa sinthan Isra7eele asaa hassayisiyaba oothidi geeshsha dunkaaniya giddo ehidosona.<verse eid="NUM 31:54" /></para>
  <chapter eid="NUM 31" />
  <chapter number="32" style="c" sid="NUM 32" />
  <para style="s1">Yordaanosepe Hefinthan Utida Kochata</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 32:1" />Robeelanne Gaade kochaas daro mehey de7ees. Enti Ya7izeera biittaynne Galada biittay mehes inje gideysa, <verse eid="NUM 32:1" /><verse number="2" style="v" sid="NUM 32:2" />be7idi Museko, kahiniya Alaazarakonne Isra7eele maabara halaqatako yidi haysada yaagidosona. <verse eid="NUM 32:2" /><verse number="3-4" style="v" sid="NUM 32:3-4" />“Isra7eele asay laattana mela Goday maaddida biittay, Axaarotey, Dibooni, Ya7izeeri, Nimiri, Hasebooni, Eliyaali, Sebami, Naboynne Ba7ooni mehes inje biitta; nuus hinte aylletas daro mehey de7ees. <verse eid="NUM 32:3-4" /><verse number="5" style="v" sid="NUM 32:5" />Nuuni hinte sinthan saba demmidaba gidiko, he biitta nuus hinte aylleta laata oothidi immite; nuna Yordaanose shaafape hefinthi pinthofite” yaagidosona.<verse eid="NUM 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 32:6" />Musey Gaade kochatakonne Robeela kochatako, “Hinte bagga gidida Isra7eele asay olas biya wode hinte haysan uttanaw koyeetii? <verse eid="NUM 32:6" /><verse number="7" style="v" sid="NUM 32:7" />Goday entaw immida biitta enti pinnonna mela hinte ayis enta wozanaa shugiseetii? <verse eid="NUM 32:7" /><verse number="8" style="v" sid="NUM 32:8" />Qaadesa Barnefe ha biitta wochana mela hinte aawata ta yeddida wode entika haysada oothidosona. <verse eid="NUM 32:8" /><verse number="9" style="v" sid="NUM 32:9" />Enti Eshkola Zangaara gakanaw bidi he biitta be7i simmidi Isra7eeleti Goday entaw immida biitta gelonna mela Isra7eeleta wozanaa shugisidosona. <verse eid="NUM 32:9" /><verse number="10" style="v" sid="NUM 32:10" />Goday he gallas daro hanqetidi haysada yaagidi caaqis; <verse eid="NUM 32:10" /><verse number="11" style="v" sid="NUM 32:11" />‘Banta kumetha wozanaape tana kaalliboonna gisho, Gibxe biittafe keydaysatape laythi laatamanne iyape bolla gidida adde asaape issoyka Abrahaames, Yisaaqasinne Yayqoobas immana gada caaqida biitta gelekona. <verse eid="NUM 32:11" /><verse number="12" style="v" sid="NUM 32:12" />Banta kumetha wozanape kaallida gisho, Qeneza Yoofona na7aa Kaalebapenne Nawe na7aa Iyyasupe attishin, hari oonika gelenna’ yaagis. <verse eid="NUM 32:12" /><verse number="13" style="v" sid="NUM 32:13" />Godaa hanqoy Isra7eele asaa bolla eexida gisho Godaa sinthan iita oothida he yeletetha ubbay dhayana gakanaw mela biittan oytamu laythi toylatidosona. <verse eid="NUM 32:13" /><verse number="14" style="v" sid="NUM 32:14" />Hinteno, nagaranchota nayto hinte aawata bessan eqidi Goday Isra7eele asaa bolla gujidi hanqetana mela ootheeta. <verse eid="NUM 32:14" /><verse number="15" style="v" sid="NUM 32:15" />Hinte Godaa kaallonna ixiko, I qassika ba deriya mela biittan aggana. Entana gakiya dhayuwas hinte oyshetana” yaagis.<verse eid="NUM 32:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 32:16" />Enti Museko shiiqidi, “Nuuni haysan nu mehiyas dara, nu naytasinne nu machetas katama keexanaw koyoos. <verse eid="NUM 32:16" /><verse number="17" style="v" sid="NUM 32:17" />Shin Isra7eele asay banta bessaa ekana gakanaw nuuni ola miishe dancidi enta sinthan keyidi oletanaw giigetida. He wode he biittan de7iya asay nu naytanne nu macheta qohonna mela gimbetidi uttida katamatan de7ona. <verse eid="NUM 32:17" /><verse number="18" style="v" sid="NUM 32:18" />Isra7eele asa ubbay banta laata laata ekana gakanaw, nuuni nu soo simmoko. <verse eid="NUM 32:18" /><verse number="19" style="v" sid="NUM 32:19" />Nuuni nu laata Yordaanose shaafape hafinthan doloha baggan laattida gisho, Yordaanosepe hefinthan wuloha baggan entara laata ekoko” yaagidosona.<verse eid="NUM 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 32:20" />Musey entako, “Hinte geysi tuma gidiko haysan Godaa sinthan ola baanaw dancetite. <verse eid="NUM 32:20" /><verse number="21" style="v" sid="NUM 32:21" />Goday ba morketa ba sinthafe gooddana gakanaw hinte ola miishiya dancidi, Yordaanose shaafa Godaa sinthan pinniko, <verse eid="NUM 32:21" /><verse number="22" style="v" sid="NUM 32:22" />he biitta Goday xoonidaape guye hinte simmanaw danda7eeta. He wode hinte Godaasinne Isra7eele asaas oletidi polideta guussu. Qassi he biittay Godaa sinthan hintew laata gidana.<verse eid="NUM 32:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 32:23" />“Hinte hessa oothonna ixiko Godaa bolla nagara ootheeta; hiza, hinte nagaraa gisho hintena seeri gakanaysa loythi erite. <verse eid="NUM 32:23" /><verse number="24" style="v" sid="NUM 32:24" />Hinte hintew katamata, hinte mehiyas dara keexite, shin hinte gelida qaala polite” yaagis.<verse eid="NUM 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 32:25" />Gaade kochaynne Robeela, kochay Museko, “Nuuni ne aylleti ne kiitidaysada oothana. <verse eid="NUM 32:25" /><verse number="26" style="v" sid="NUM 32:26" />Nu nayti, nu macheti, nu dorsatinne nu mehey haysan Galada katamatan de7ishshona. <verse eid="NUM 32:26" /><verse number="27" style="v" sid="NUM 32:27" />Shin nuuni ne aylleti, olanchoti ubbay, neeni nu goday gidaysada oletanaw Godaa sinthan Yordaanose shaafa pinnana” yaagidosona.<verse eid="NUM 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 32:28" />Hessa gisho, Musey kahiniya Alaazara, Nawe na7a Iyyasunne Isra7eele kochata halaqata entaba yaagidi Kiittis. <verse eid="NUM 32:28" /><verse number="29" style="v" sid="NUM 32:29" />“Gaade kochaynne Robeela kochay ubbay ola miishiya dancidi, Godaa sinthan hintera Yordaanose shaafa pinnikonne hinte he biitta xooniko, hessafe guye, Galada biitta hinte enta laatisite. <verse eid="NUM 32:29" /><verse number="30" style="v" sid="NUM 32:30" />Shin enti ola miishiya dancidi, hintera pinnidi olas boonna ixiko, hinteda entaw Kanaane biittan laati imeto” yaagis.<verse eid="NUM 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 32:31" />Yaatin. Gaade kochaynne Robeela kochay zaaridi, “Nuuni ne aylleti Goday gidaysa oothana. <verse eid="NUM 32:31" /><verse number="32" style="v" sid="NUM 32:32" />Nuuni ola miishiya dancidi, Godaa sinthan Kanaane biitta gelanaw pinnana; shin nuuni laattiya laatay Yordaanosepe hafintha bagga gido” yaagidosona.<verse eid="NUM 32:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 32:33" />Hessa gisho, Musey Gaade kochaas, Robeela kochaasinne Yoosefa na7aa Minaase kochaafe baggaas Amoore kawa Sihoona kawotethaanne Baasane kawa Ooge kawotethaa enta yuushuwan de7iya katamatara immis. <verse eid="NUM 32:33" /><verse number="34" style="v" sid="NUM 32:34" />Gaade kochay Diboona, Axaarota, Aro7eera <verse eid="NUM 32:34" /><verse number="35" style="v" sid="NUM 32:35" />Axiroot-Shafaana, Ya7izeera, Yogiba, <verse eid="NUM 32:35" /><verse number="36" style="v" sid="NUM 32:36" />Beet-Nimiranne Beet-Harana geetetiya gimben diretida katamata zaaridi keexidosona; banta mehiyas dara keexidosona.<verse eid="NUM 32:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 32:37" />Robeela, kochay Haseboona, Eli7aala, Qiratayma, <verse eid="NUM 32:37" /><verse number="38" style="v" sid="NUM 32:38" />Naaba, Ba7aal-Ma7oonanne Sebama geetetiya katamata zaarethi keexidosona; he katamata sunthaa laammidosona.<verse eid="NUM 32:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="NUM 32:39" />Minaase na7aa Makira kochati Galada biitta oli oykidi yan de7iya Amooreta goodidosona. <verse eid="NUM 32:39" /><verse number="40" style="v" sid="NUM 32:40" />Hessa gisho, Minaase na7aa Makira kochaas Musey Galada biitta immin enti yan de7idosona. <verse eid="NUM 32:40" /><verse number="41" style="v" sid="NUM 32:41" />Minaase kochi gidida Ya7iri he si olli oykidi, “Ya7ira katamata” yaagidi sunthis. <verse eid="NUM 32:41" /><verse number="42" style="v" sid="NUM 32:42" />Nooba Qanaata katamaanne iya yuushuwan de7iya gutata ollan oykide, ba sunthan “Nooba” gidi sunthis.<verse eid="NUM 32:42" /></para>
  <chapter eid="NUM 32" />
  <chapter number="33" style="c" sid="NUM 33" />
  <para style="s1">Gibxefe Moo7abe Gakanaw</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 33:1" />Museynne Aaroni kaalethin, Isra7eele asay, banta cugan cugan Gibxefe keyidi siiratida gutata odiya taarikey haysa. <verse eid="NUM 33:1" /><verse number="2" style="v" sid="NUM 33:2" />Goday Kiittidaysa mela Musey enti siiratida bessata sunthaa ubbaa kaali kaali xaafis.<verse eid="NUM 33:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="NUM 33:3" />Isra7eele asay koyro ageenan, tammanne ichashantho gallasan, Paasika bonchiya nam7antho gallas dendidi, Gibxe asa ubbay be7ishin, yayyonna Ramisepe keyidosona. <verse eid="NUM 33:3" /><verse number="4" style="v" sid="NUM 33:4" />He wode Gibxe asay Godaa gadon hayqida banta bayra nayta moogosona. Hessada oothidi, Goday enta xoossata bolla pirda ehis.<verse eid="NUM 33:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 33:5" />Isra7eele asay Ramisepe dendidi Sukota geetetiya bessan dunkaanidosona.<verse eid="NUM 33:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 33:6" />Sukotape dendidi mela biitta gaxan de7iya Etaaman dunkaanidosona.<verse eid="NUM 33:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 33:7" />Etaamape dendidi Ba7ali-Xafoonape doloha baggan de7iya Pihahiroota simmidi Migdoola matan dunkaanidosona.<verse eid="NUM 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="NUM 33:8" />Pihahirootape dendidi, Zo7o Abbaa pinnidi, Suuza mela biitta bidosona. Etaama mela biittan heedzu gallas hemetidi Maaran dunkaanidosona.<verse eid="NUM 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 33:9" />Maarape dendidi tammanne nam7u pultotinne laapun tammu zambati de7iya Eliman dunkaanidosona.<verse eid="NUM 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 33:10" />Elimape dendidi Zo7o Abbaa matan dunkaanidosona.<verse eid="NUM 33:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="NUM 33:11" />Zo7o Abbaa matape dendidi Siina mela biittan dunkaanidosona.<verse eid="NUM 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="NUM 33:12" />Siina mela biittafe dendidi Rafaqan dunkaanidosona.<verse eid="NUM 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 33:13" />Rafaqape dendidi Elusan dunkaanidosona.<verse eid="NUM 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="NUM 33:14" />Elusape dendidi haathi bayna bessan Rafidiman dunkaanidosona.<verse eid="NUM 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="NUM 33:15" />Rafidimape dendidi Siina mela biittan dunkaanidosona.<verse eid="NUM 33:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 33:16" />Siina mela biittafe dendidi Kibirooti Hati7awan<note caller="+" style="f"><char style="fr" closed="false">33:16 </char><char style="fk" closed="false">Kibirooti Hati7awan: </char><char style="ft" closed="false">Amo duufo geetetiya bessi.</char></note> dunkaanidosona.<verse eid="NUM 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="NUM 33:17" />Kibirooti Hati7awape dendidi Haxerootan dunkaanidosona.<verse eid="NUM 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="NUM 33:18" />Haxerootape dendidi Irtiman dunkaanidosona.<verse eid="NUM 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="NUM 33:19" />Irtimape dendidi Irmoon-Pareezan dunkaanidosona.<verse eid="NUM 33:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 33:20" />Irmoon-Pareezape dendidi Libinan dunkaanidosona.<verse eid="NUM 33:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="NUM 33:21" />Libinape dendidi Irisan dunkaanidosona.<verse eid="NUM 33:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 33:22" />Irisape dendidi Qahelatan dunkaanidosona.<verse eid="NUM 33:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="NUM 33:23" />Qahelatape dendidi Shefara zuman dunkaanidosona.<verse eid="NUM 33:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="NUM 33:24" />Shefara zumaape dendidi Haraadan dunkaanidosona.<verse eid="NUM 33:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="NUM 33:25" />Haradape dendidi Maqhelotan dunkaanidosona.<verse eid="NUM 33:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 33:26" />Maqhelotape dendidi Tahatan dunkaanidosona.<verse eid="NUM 33:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="NUM 33:27" />Tahatape dendidi Taaran dunkaanidosona.<verse eid="NUM 33:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="NUM 33:28" />Taarape dendidi Mitiqan dunkaanidosona.<verse eid="NUM 33:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 33:29" />Mitiqape dendidi Hashimoonan dunkaanidosona.<verse eid="NUM 33:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 33:30" />Hashimoonape dendidi Moserootan dunkaanidosona.<verse eid="NUM 33:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="NUM 33:31" />Moserootape dendidi Ben-Ya7iqanan dunkaanidosona.<verse eid="NUM 33:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="NUM 33:32" />Ben-Ya7iqanape dendidi Hoor-Hagidigaadan dunkaanidosona.<verse eid="NUM 33:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="NUM 33:33" />Hoor-Hagidigadape dendidi Yoxibaatan dunkaanidosona.<verse eid="NUM 33:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="NUM 33:34" />Yoxibaatape dendidi Abroonan dunkaanidosona.<verse eid="NUM 33:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="NUM 33:35" />Abroonape dendidi Exiyoon-Gabiran dunkaanidosona.<verse eid="NUM 33:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="NUM 33:36" />Exiyooni-Gabirape dendidi Siina mela biittan Qaadesan dunkaanidosona.<verse eid="NUM 33:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="NUM 33:37" />Qaadesape dendidi Edoome biitta zawan de7iya Hoora zuman dunkaanidosona. <verse eid="NUM 33:37" /><verse number="38" style="v" sid="NUM 33:38" />Kahiney Aaroni Godaa kiitan Hoora zuma bolla keyidi, Isra7eele asay Gibxe biittafe keyida oytamantho laythan, ichashantho ageenan, koyro gallasan yan hayqis. <verse eid="NUM 33:38" /><verse number="39" style="v" sid="NUM 33:39" />Aaroni Hoora zuma bolla hayqiya wode iyaw laythi xeetanne laatamanne heedza.<verse eid="NUM 33:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="NUM 33:40" />Negebe mela biittan Kanaanen de7iya Arada Kawoy Isra7eele asaa yuussaa si7is.<verse eid="NUM 33:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="NUM 33:41" />Isra7eele asay Hoora zumaape dendidi Xalmoonan dunkaanidosona.<verse eid="NUM 33:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="NUM 33:42" />Xalmoonape dendidi Punoonan dunkaanidosona.<verse eid="NUM 33:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="NUM 33:43" />Punoonape dendidi Obotan dunkaanidosona.<verse eid="NUM 33:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="NUM 33:44" />Obotape dendidi Moo7abe biitta zawan de7iya Abariiman dunkaanidosona.<verse eid="NUM 33:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="NUM 33:45" />Abariimape dendidi Diboon-Gaadan dunkaanidosona.<verse eid="NUM 33:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="NUM 33:46" />Dibon-Gaadape dendidi Almoon-Dibilatayman dunkaanidosona.<verse eid="NUM 33:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="NUM 33:47" />Almoon-Dibilataymape dendidi Nabo zuma sinthan Abariima zumata bolla dunkaanidosona.<verse eid="NUM 33:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="NUM 33:48" />Abariima zumatape dendidi Iyaarkofe hefinthan, Yordaanose shaafa matan de7iya Moo7abe denban dunkaanidosona. <verse eid="NUM 33:48" /><verse number="49" style="v" sid="NUM 33:49" />Yordaanose shaafa matan de7iya Moo7abe denban, Beet-Yashimootapenne Abeel-Saxima Zangaarape giddon dunkaanidosona.<verse eid="NUM 33:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="NUM 33:50" />Iyaarkofe hefinthan, Yordaanose shaafa matan de7iya Moo7abe demban Goday Museko, <verse eid="NUM 33:50" /><verse number="51" style="v" sid="NUM 33:51" />“Isra7eele asaas yaagada oda; Yordaanose shaafa pinnidi, Kanaane biitta hinte geliya wode <verse eid="NUM 33:51" /><verse number="52" style="v" sid="NUM 33:52" />he biittan de7iya asa ubbaa hinte sinthafe yedethite. Shuchafe masetidi oosetida misiletanne sheeshidi medhida eeqata dhaysite. Dhoqa goyinno bessata ubbaa laallite. <verse eid="NUM 33:52" /><verse number="53" style="v" sid="NUM 33:53" />He biitta ta hintew immida gisho iya laattidi yan de7ite. <verse eid="NUM 33:53" /><verse number="54" style="v" sid="NUM 33:54" />Hinte kochan kochan saama kessidi biitta shaaketite. Taybon dariya kochatas dalga laata immite; taybon guuxiya kochatas guutha laata immite. Saaman enta gakida biittay entaba gidana. Biittaa hinte mayzata kochan kochan shaakidi ekite. <verse eid="NUM 33:54" /><verse number="55" style="v" sid="NUM 33:55" />Shin he biittan de7iya asaa hinte yedethonna ixiko, hinte ashshidaysati hinte ayfiyas pinco, hinte miyiyas agunthu gidana; hinte daana biittan ubba wode ola denthidi hintena waaysana. <verse eid="NUM 33:55" /><verse number="56" style="v" sid="NUM 33:56" />Hinte enta yedethonna ixiko, ta enta bolla oothanaw halchidaba hinte bolla oothana gada oda” yaagis.<verse eid="NUM 33:56" /></para>
  <chapter eid="NUM 33" />
  <chapter number="34" style="c" sid="NUM 34" />
  <para style="s1">Isra7eele Biitta Zawa</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 34:1" />Goday Museko, <verse eid="NUM 34:1" /><verse number="2" style="v" sid="NUM 34:2" />“Isra7eele asaas haysada gada oda; hinte Kanaane geliya wode ta hintew laata oothada immana biitta zaway haysa. <verse eid="NUM 34:2" /><verse number="3" style="v" sid="NUM 34:3" />Dugeha bagga zaway Siina mela biittafe dendidi Edoome zawa kanthees. Doloha baggara hinte zaway Maxine Abbaafe duge baggara doomidi, <verse eid="NUM 34:3" /><verse number="4" style="v" sid="NUM 34:4" />Aqirabima aadhiya bessaa shaakidi Siina biitta bazzuwa kanthidi dugeha baggara Qaades-Barne gakees. Yaape Hadar-Adaara kanthidi Aximoona gakees. <verse eid="NUM 34:4" /><verse number="5" style="v" sid="NUM 34:5" />Aximoonape dendidi Gibxe shaafa guye simmidi Medetiraane Abbaa gakees.<verse eid="NUM 34:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 34:6" />“Wuloha bagga zaway Medetiraane Abbaa gaxa gidana.<verse eid="NUM 34:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="NUM 34:7" />“Pudeha bagga zaway Medetiraane Abbaa kaallidi Hoora zuma gakanaw bees. <verse eid="NUM 34:7" /><verse number="8" style="v" sid="NUM 34:8" />Hoora zumaape Hamaata geliya bessaa gakanaw bees; he zawa wursethay Xadaada. <verse eid="NUM 34:8" /><verse number="9" style="v" sid="NUM 34:9" />Yaape dendidi Zifiroona gakidi, Haxar-Enaanan eqees; pudeha bagga zaway haysa.<verse eid="NUM 34:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 34:10" />“Doloha bagga zaway Haxar-Enaanape Safaama mallaa gakees. <verse eid="NUM 34:10" /><verse number="11" style="v" sid="NUM 34:11" />Safaama mallafe dendidi Aynape doloha baggara Irbila duge wodhidi Kenereeta Abbaafe doloha baggara de7iya zumata gakees. <verse eid="NUM 34:11" /><verse number="12" style="v" sid="NUM 34:12" />Hessafe hinte zaway duge Yordaanose shaafa wodhi zawaydi Maxine Abbaa gakees. Hinte biitta yuusho zawati haysata” yaagis.<verse eid="NUM 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="NUM 34:13" />Musey Isra7eele asaa haysada yaagidi Kiittis; “Uddufun bagga kochaas hinte saama yeggidi shaakana laata biittay haysa. <verse eid="NUM 34:13" /><verse number="14" style="v" sid="NUM 34:14" />Robeela kochay, Gaade kochaynne Minaase kochaafe baggay, <verse eid="NUM 34:14" /><verse number="15" style="v" sid="NUM 34:15" />banta laata Iyaarkofe hefinthan, Yordaanose Shaafape doloha baggan ekidosona” yaagis.<verse eid="NUM 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 34:16" />Goday Museko, <verse eid="NUM 34:16" /><verse number="17" style="v" sid="NUM 34:17" />“Kahiniya Alaazaranne Nawe na7aa Iyyasuy he biitta asaas shaako. <verse eid="NUM 34:17" /><verse number="18" style="v" sid="NUM 34:18" />Qassi biitta shaakanaw maadana mela issi issi kochaafe issi issi halaqa doorite.” <verse eid="NUM 34:18" /><verse number="19" style="v" sid="NUM 34:19" />Enta sunthay haysafe kaallidi de7eysa.</para>
  <para style="li1" vid="NUM 34:19">Yihuda kochaafe Yoofona na7aa Kaaleba;<verse eid="NUM 34:19" /></para>
  <para style="li1">
    <verse number="20" style="v" sid="NUM 34:20" />Simoona kochaafe Amhuda na7aa Salam7eela;<verse eid="NUM 34:20" /></para>
  <para style="li1">
    <verse number="21" style="v" sid="NUM 34:21" />Biniyaame kochaafe Kisiloona na7aa Eldaada;<verse eid="NUM 34:21" /></para>
  <para style="li1">
    <verse number="22" style="v" sid="NUM 34:22" />Daane kochaafe Yogila na7aa Buuqa;<verse eid="NUM 34:22" /></para>
  <para style="li1">
    <verse number="23" style="v" sid="NUM 34:23" />Yoosefa na7aa Minaase kochaafe Sufeeda na7aa Hani7eela;<verse eid="NUM 34:23" /></para>
  <para style="li1">
    <verse number="24" style="v" sid="NUM 34:24" />Yoosefa na7aa Efreema kochaafe Shifixaana na7aa; Qamu7eela;<verse eid="NUM 34:24" /></para>
  <para style="li1">
    <verse number="25" style="v" sid="NUM 34:25" />Zabloona kochaafe Farnaaka na7aa Elsafaana;<verse eid="NUM 34:25" /></para>
  <para style="li1">
    <verse number="26" style="v" sid="NUM 34:26" />Yisakoora kochaafe Hooza na7aa Palxi7eela;<verse eid="NUM 34:26" /></para>
  <para style="li1">
    <verse number="27" style="v" sid="NUM 34:27" />Aseera kochaafe Salooma na7aa Ahuda;<verse eid="NUM 34:27" /></para>
  <para style="li1">
    <verse number="28" style="v" sid="NUM 34:28" />Niftaaleme kochaafe Amhuda na7aa Padahi7eela;<verse eid="NUM 34:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 34:29" />Kanaane biitta Isra7eele asaas laata oothidi shaakidi immana mela Goday kiitida asati haysata” yaagis.<verse eid="NUM 34:29" /></para>
  <chapter eid="NUM 34" />
  <chapter number="35" style="c" sid="NUM 35" />
  <para style="s1">Leewetas Imetida Katamata</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 35:1" />Iyaarkofe hefinthan, Yordaanose shaafa matan de7iya Moo7abe denban, Goday Museko haysada yaagis; <verse eid="NUM 35:1" /><verse number="2" style="v" sid="NUM 35:2" />“Isra7eeleti banta laatape Leeweti daana katamatanne enta yuushuwan hentha biitta immana mela entaw oda. <verse eid="NUM 35:2" /><verse number="3" style="v" sid="NUM 35:3" />He katamati entaw duussa bessi gido; hentha biittati enta miizas, enta dorsaasinne enta hara mehetas gido. <verse eid="NUM 35:3" /><verse number="4" style="v" sid="NUM 35:4" />Hinte entaw immiya hentha biittay ubba baggara katamaa gimbe dirsaafe issi mukulu wadha gido. <verse eid="NUM 35:4" /><verse number="5" style="v" sid="NUM 35:5" />Katamaa giddo oothidi doloha baggara nam7u mukulu wadha, dugeha baggara nam7u mukulu wadha, wuloha baggara nam7u mukulu wadhanne pudeha baggara nam7u mukulu wadha wadhite. Leeweti he heera banta katamaas hentha biitta ootho.<verse eid="NUM 35:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="NUM 35:6" />“Leewetas hinte immida katamati, ase wodhida uray baqatidi attiya usupun katamata; hessata bolla gujidika, oytamanne nam7u hara katamata entaw immite. <verse eid="NUM 35:6" /><verse number="7" style="v" sid="NUM 35:7" />Oytamanne hospun katamata enta hentha biittara issife Leewetas immite. <verse eid="NUM 35:7" /><verse number="8" style="v" sid="NUM 35:8" />Isra7eele asaa laatape enta laata mela daro kochaafe daro katama, guutha kochaafe guutha katama ekidi Leewetas immite” yaagis.<verse eid="NUM 35:8" /></para>
  <para style="s1">Baqatidi Attiya Katamata</para>
  <para style="r">(<ref loc="DEU 19:1-13">Zaare 19:1-13</ref>; <ref loc="JOS 20:1-9">Iyya 20:1-9</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="NUM 35:9" />Goday Museko, <verse eid="NUM 35:9" /><verse number="10" style="v" sid="NUM 35:10" />“Isra7eele asaako haysada yaaga; Yordaanose shaafa pinnidi, Kanaane biitta hinte geliya wode, <verse eid="NUM 35:10" /><verse number="11" style="v" sid="NUM 35:11" />issi asi qoponna ase wodhidaba gidiko he uray baqatidi attana mela katamata hintew doorite. <verse eid="NUM 35:11" /><verse number="12" style="v" sid="NUM 35:12" />Yan suuthu zaaranaw koya hayqida uraa dabbotape I attees. Shempo wodhida deriya sinthan pirdas shiiqonna hayqanaw bessenna. <verse eid="NUM 35:12" /><verse number="13" style="v" sid="NUM 35:13" />Ha hinte immiya usupun katamati hinte baqatidi attiya katama gido. <verse eid="NUM 35:13" /><verse number="14" style="v" sid="NUM 35:14" />Heedzu katamati Yordaanose shaafape doloha baggan gido; qassi attida heedzati Kanaane biittan gido. <verse eid="NUM 35:14" /><verse number="15" style="v" sid="NUM 35:15" />Ha usupun katamati eronna ase wodhida Isra7eele asay, betanchotinne guutha wodes hinte giddon de7iya asati baqatidi attiya bessi gido.<verse eid="NUM 35:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="NUM 35:16" />“Issi asi hara asi birata miishen shocidi wodhiko he uray shempo wodhis; I hayqo. <verse eid="NUM 35:16" /><verse number="17" style="v" sid="NUM 35:17" />Issi asi wodhanaw danda7iya shuchan hara asi caddidi wodhiko he uray shempo wodhis; I hayqo. <verse eid="NUM 35:17" /><verse number="18" style="v" sid="NUM 35:18" />Issi asi wodhanaw danda7iya mitha miishen hara asi shocidi wodhiko he uray shempo wodhis; I hayqo. <verse eid="NUM 35:18" /><verse number="19" style="v" sid="NUM 35:19" />Suuthu zaariya mata dabboy he shempo wodhidaysa demmiko wodho.<verse eid="NUM 35:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="NUM 35:20" />“Issi asi hara asi ba wozanan morkidi sugi yeggiko woyko hayqo gidi iya bolla issiba holin he uray hayqiko, <verse eid="NUM 35:20" /><verse number="21" style="v" sid="NUM 35:21" />woyko morkidi ba kushe cuucummidi dechin he uray hayqiko, I shempo wodhis; I hayqo. Suuthu zaariya mata dabboy shempo wodhidaysa demmiko wodho.<verse eid="NUM 35:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="NUM 35:22" />“Shin morketethi baynan, issi asi hara asi akeekona sugidi woyko qoponna iya bolla issiba holiko, <verse eid="NUM 35:22" /><verse number="23" style="v" sid="NUM 35:23" />woyko wodhanaw danda7iya shuchu I be7onna iya bolla holin, he uray hayqiko, hessan morketethi bayna gishonne iya qohanaw qopidi dendonna gisho, <verse eid="NUM 35:23" /><verse number="24" style="v" sid="NUM 35:24" />duulatay iya giddoninne iya suutha zaaranaw koya uraa giddon pirdiya wogay kaallidi de7iya wogaatho gido. <verse eid="NUM 35:24" /><verse number="25" style="v" sid="NUM 35:25" />Eronna wodhidaysa suuthaa zaaranaw koyeysa kushepe he uraa duulatay ashshidi, I baqatidi attiya katamaa zaaro. He wode de7iya zayten tiyetida kahine halaqay hayqana gakanaw I yan de7o.<verse eid="NUM 35:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="NUM 35:26" />“Shin eronna wodhidaysi baqatidi attiya katamaa zawape betiko, <verse eid="NUM 35:26" /><verse number="27" style="v" sid="NUM 35:27" />hayqida uraa dabboy iya demmidi wodhiko, shempo wodhon oyshetenna. <verse eid="NUM 35:27" /><verse number="28" style="v" sid="NUM 35:28" />He wode de7iya kahine halaqay hayqana gakanaw he eronna wodhida uray baqatidi attiya kataman utto. Shin he kahine halaqay hayqidaape guye eronna wodhida uray ba soo simmanaw danda7ees.<verse eid="NUM 35:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="NUM 35:29" />“Ha wogaynne higgey hinte de7iya biittan hintewunne hinte zerethaas eqidi de7iya woga gido.<verse eid="NUM 35:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="NUM 35:30" />“Ase wodhida oonika I shempo wodhidaysa nam7u woyko heedzu marki markatiko hayqo, shin issi asa markatethan oonika hayqanaw bessenna. <verse eid="NUM 35:30" /><verse number="31" style="v" sid="NUM 35:31" />Qassi shempo wodhida asape aca ekofite; I hayqanaw bessees. <verse eid="NUM 35:31" /><verse number="32" style="v" sid="NUM 35:32" />Baqatidi attiya katama betida oodefeka kahine halaqay hayqanaape sinthe ba soo simmana mela aca iyape ekofite. <verse eid="NUM 35:32" /><verse number="33" style="v" sid="NUM 35:33" />Suuthi biitta tunisiya gisho suuthu gussofite. Suuthu gussida uraa suuthaafe attishin, suuthi gukida biitta hara ogera tunatethaafe geeshshiya wogi baawa. <verse eid="NUM 35:33" /><verse number="34" style="v" sid="NUM 35:34" />Taani, Goday Isra7eele asaa giddon de7iya gisho, hinte de7iya biitta, taani aqiya biitta tunisopite” yaagis.<verse eid="NUM 35:34" /></para>
  <chapter eid="NUM 35" />
  <chapter number="36" style="c" sid="NUM 36" />
  <para style="s1">Selophaada Macca Nayta Laata</para>
  <para style="p">
    <verse number="1" style="v" sid="NUM 36:1" />Yoosefa kochaafe, Minaase na7aa Makira na7aa Galada kochaa halaqati Musekonne Isra7eele halaqatako yidi <verse eid="NUM 36:1" /><verse number="2" style="v" sid="NUM 36:2" />“Nu godaw, Isra7eele asaas laata biitta saaman shaakada immana mela Goday nena kiittis; qassi nu ishaa Selophaada laata iya macca naytas immana mela nena kiittis. <verse eid="NUM 36:2" /><verse number="3" style="v" sid="NUM 36:3" />Enti hara koche gidida Isra7eele asi geliko enta laatay nu aawata laatape eketidi enta ekiya zerethas guzhetees. Hessa gisho, nuus saaman imetida laatay guuxees. <verse eid="NUM 36:3" /><verse number="4" style="v" sid="NUM 36:4" />Isra7eele asaas Ishatamantho Laytha bonchiya ba7aaley gakiya wode enta laatay enta ekida asaa kochaas guzhetees; hessa gidiko enta laatay nu aawata kochaa laatape eketana” yaagidosona.<verse eid="NUM 36:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="NUM 36:5" />Hessa gisho, Musey Godaape ekida kiitaa Isra7eele asaas haysada yaagidi odis; “Yoosefa kochay gidaysi like. <verse eid="NUM 36:5" /><verse number="6" style="v" sid="NUM 36:6" />Goday Selophaada macca naytabaa kiittidaysi haysa; enti bantaw dosida azina gelanaw danda7oosona, shin enta kochaafe gidanaw koshshees. <verse eid="NUM 36:6" /><verse number="7" style="v" sid="NUM 36:7" />Isra7eele asaa laatay issi kochaafe hara kochaas aadhofo; Isra7eele asay banta kochaa laata biitta minthidi naago. <verse eid="NUM 36:7" /><verse number="8" style="v" sid="NUM 36:8" />Isra7eele asa giddon laata biitta ekida maccasi oonika ba aawa koche gidida azina gelanaw koshshees. Hessada oothiko enta kochaa laatay enta kushen gam7ees. <verse eid="NUM 36:8" /><verse number="9" style="v" sid="NUM 36:9" />Yaatiko, laatay issi kochaafe hara kochaako aadhenna. Issi issi kochay ba laata biitta oykida mela daana” yaagis.<verse eid="NUM 36:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="NUM 36:10" />Yaatin, Selophaada macca nayti Goday Muse kiitidaysada oothidosona. <verse eid="NUM 36:10" /><verse number="11" style="v" sid="NUM 36:11" />Selophaada macca nayti, Mahilo, Tirxo, Hoglo, Milkonne No7o geeteteysati banta aawa ishata nayta gelidosona. <verse eid="NUM 36:11" /><verse number="12" style="v" sid="NUM 36:12" />Enti Yoosefa na7aa Minaase nayta kochaafe azina gelidosona; enta laatay enta aawa kochaas gidis. <verse eid="NUM 36:12" /><verse number="13" style="v" sid="NUM 36:13" />Iyaarkofe hefinthan, Yordaanose shaafa matan, de7iya Moo7abe Denban Muse baggara, Goday Isra7eele asaas kiitida higgetinne wogati haysata.<verse eid="NUM 36:13" /></para>
  <chapter eid="NUM 36" />
</usx>