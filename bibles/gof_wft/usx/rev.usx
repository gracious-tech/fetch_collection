<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Yohaanisa Qoncethi</para>
  <para style="toc1">Yohaanisa Qoncethi</para>
  <para style="toc3">Qon</para>
  <para style="toc2">Qon</para>
  <para style="mt1">Yohaanisa Qoncethi</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Yohaanisa qoncethay xaafetiday, ammaniya asay Yesuus Kiristoosa bantaw Goda oothidi, geeshshatethan de7ida gisho, metoynne waayey gakida wodena. Xaafey wudidi xeellida ayfe qofay, ammaniya asaa ufaysay kumethi gidana mela enta minthethidi, enta gakida goodanne metuwa giddon banta ammanuwan minnidi eqana mela denthethanaasa.</para>
  <para style="ip">Maxaafan dariya kifiley daronne kaalli kaallidi yida qoncethata oykees. Ha qoncethati he wode de7iya asaas gelees, shin haratas xuura gididi gam7is. Enti odetidaynne qonciday leemiso odana. Ha maxaafan de7iya tayboti, maka miishetinne do7ati deretanne ayyaana medhetethata leemiso. Mazmure azmaachey simmi simmidi yexeteysada, ha maxaafan de7iya huuphe qofati dumma dumma qoncethata baggara dumma dumma ogen simmi simmi shiiqidosona. Ha maxaafa birshethas dumma dumma qofay de7ikoka, iyaw huuphe qofay qonce. Hessika, “Xoossay Godaa Kiristoosa baggara zaarethonna ogen ba morketa, Xalahera gujidi, issitohonne wursethi xoonana. He xoonuwape guye, iyaw ammanetidi de7ida ba asaa ooratha salonne ooratha sa7a anjo laatisana” yaagees.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Yohaanisa haasaya <char style="ior">(<ref loc="REV 1:1-8">1:1-8</ref>)</char></para>
  <para style="io1">Yesuusi laapun woosa keethata giddon <char style="ior">(<ref loc="REV 1:9-20">1:9-20</ref>)</char></para>
  <para style="io1">Laapun woosa keethatas xaafetida kiita <char style="ior">(<ref loc="REV 2:1-3:22">2:1—3:22</ref>)</char></para>
  <para style="io1">Salon hanida goyinno qoncethaa <char style="ior">(<ref loc="REV 4:1-11">4:1-11</ref>)</char></para>
  <para style="io1">Xaatha maxaafanne laapun maatameta <char style="ior">(<ref loc="REV 5:1-6:17">5:1—6:17</ref>)</char></para>
  <para style="io1">Xoossa araata sinthan goyinno maara <char style="ior">(<ref loc="REV 7:1-17">7:1-17</ref>)</char></para>
  <para style="io1">Laapun moyzeta <char style="ior">(<ref loc="REV 8:2-11:19">8:2—11:19</ref>)</char></para>
  <para style="io1">Dawiyanne nam7u do7ata <char style="ior">(<ref loc="REV 12:1-13:18">12:1—13:18</ref>)</char></para>
  <para style="io1">Dumma dumma qoncethata <char style="ior">(<ref loc="REV 14:1-15:8">14:1—15:8</ref>)</char></para>
  <para style="io1">Laapun hanqo xuu7ata <char style="ior">(<ref loc="REV 16:1-21">16:1-21</ref>)</char></para>
  <para style="io1">Babiloone kundethi, do7anne wordo nabe <char style="ior">(<ref loc="REV 17:1-20:10">17:1—20:10</ref>)</char></para>
  <para style="io1">Wursetha pirda <char style="ior">(<ref loc="REV 20:11-15">20:11-15</ref>)</char></para>
  <para style="io1">Ooratha salonne sa7a <char style="ior">(<ref loc="REV 21:1-8">21:1-8</ref>)</char></para>
  <para style="io1">Ooratha Yerusalaame <char style="ior">(<ref loc="REV 21:9-22:5">21:9—22:5</ref>)</char></para>
  <para style="io1">Kiristoosi simmidi yaana <char style="ior">(<ref loc="REV 22:6-21">22:6-21</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="REV 1"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1"/>Eeson hananaw de7iyaba ba aylleta bessaana mela Xoossay iyaw immida Yesuus Kiristoosa qoncethay haysa. Yesuusi ba kiitanchuwa kiittidi, ba aylliya Yohaanisas qoncisis. <verse eid="REV 1:1"/><verse number="2" style="v" sid="REV 1:2"/>Yohaanisi Xoossaa kiitaa, Yesuus Kiristoosi oothidabaanne odidaba ubbaa markatis. <verse eid="REV 1:2"/><verse number="3" style="v" sid="REV 1:3"/>Ha ubbay hananaw wodey matida gisho, ha tinbite qaala nabbabiya oonika anjetidaysa; qassi ha qaala si7eysatinne xaafetida kiitaa naagiya ubbay anjetidaysata.<verse eid="REV 1:3"/></para>
  <para style="s1">Woosa Keethatas Kiitetida Sarotho</para>
  <para style="p">
    <verse number="4-5" style="v" sid="REV 1:4-5"/>Ha dabdaabey, Yohaanisape, Iise biittan de7iya laapun woosa keethatas xaafetis. Kaseka, ha77ika de7iya, sinthafeka yaanaw de7iya Xoossaafe, qassi iya araata sinthan de7iya laapun ayyaanatape, hessadaka, hayqope dendon koyro gididaysafe, sa7aa kawota haariya ammanetiya marka gidida Yesuus Kiristoosape, aadho keehatethaynne sarotethay hintew gido.<note caller="-" style="x"><char style="xo" closed="false">1:4-5 </char><char style="xt" closed="false"><ref loc="EXO 3:14">Kessa 3:14</ref>; <ref loc="REV 4:5">Qon 4:5</ref>.</char></note></para>
  <para style="p" vid="REV 1:4-5">Yesuusi nuna siiqees, qassi ba suuthan nagara aylletethaafe nuna la77a kessis.<note caller="-" style="x"><char style="xo" closed="false">1:4-5 </char><char style="xt" closed="false"><ref loc="ISA 55:4">Isa 55:4</ref>; <ref loc="PSA 89:27">Maz 89:27</ref>.</char></note> <verse eid="REV 1:4-5"/><verse number="6" style="v" sid="REV 1:6"/>Nuuni Xoossaa iya Aawas oothana mela nuna kawotethaa kahine oothis. Iyaw merinaape merinaa gakanaw bonchoynne wolqay gido. Amin7i.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="EXO 19:6">Kessa 19:6</ref>; <ref loc="REV 5:10">Qon 5:10</ref>.</char></note><verse eid="REV 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7"/>Heko, Yesuusi shaarara yees. Asa ubbay hari attoshin, iya caddida asayka iya be7ana. Sa7an de7iya asa ubbay iya gisho yeekana. Hessi tuma hanana! Amin7i.<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daane 7:13</ref>; <ref loc="MAT 24:30">Maato 24:30</ref>; <ref loc="MRK 13:26">Mar 13:26</ref>; <ref loc="LUK 21:27">Luqa 21:27</ref>; <ref loc="1TH 4:17">1 Tese 4:17</ref>; <ref loc="ZEC 12:10">Zaka 12:10</ref>; <ref loc="JHN 19:34">Yoha 19:34</ref>.</char></note><verse eid="REV 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8"/>“Kaseka, ha77ika de7eysi, sinthafeka yaana Goday, Ubbaafe Wolqaama Xoossay, Alfanne Omegi tana”<note caller="+" style="f"><char style="fr" closed="false">1:8 </char><char style="fqa" closed="false">Alfanne Omega: </char><char style="ft" closed="false">Girike doonan Alfanne Omegi koyronne wursetha pidaleta; birshethayka koyronne wursethi guussu.</char></note> yaagees Godaa Xoossay.<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="REV 22:13">Qon 22:13</ref>; <ref loc="EXO 3:14">Kessa 3:14</ref>.</char></note><verse eid="REV 1:8"/></para>
  <para style="s1">Godaa Qoncethi</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9"/>Taani, Yohaanisi, hinte ishay, hintera issife Yesuusan waayiya, iya kawotethaanne iya danda7aa be7as. Taani Xoossaa qaala gishonne Yesuusaba markatida gisho, yuushoy abban teqetida biittan, Paximon de7ayis. <verse eid="REV 1:9"/><verse number="10" style="v" sid="REV 1:10"/>Godaa gallasan ta Geeshsha Ayyaanan haaretada de7ayis; taape guyera moyze puno mela gita girsi si7as. <verse eid="REV 1:10"/><verse number="11" style="v" sid="REV 1:11"/>He girsay tana, “Ne be7eysa maxaafan xaafada, Iisen de7iya laapun woosa keethatas, Efesoona, Samirneesa, Phargamoona, Tiyatiroona, Sardeesa, Filadelfiyanne Loodoqe yedda” yaagis.<verse eid="REV 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12"/>Taani taw odiya girsaa be7anaw guye simmada xompe wothiya laapun worqa kocata be7as. <verse eid="REV 1:12"/><verse number="13" style="v" sid="REV 1:13"/>He kocata giddon asa na7a daaneysa be7as. I adussa afila ba tohuwa gathi ma7is, worqa dancon ba tiraa dancis.<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daane 7:13</ref>; <ref loc="DAN 10:5">Daane 10:5</ref>.</char></note> <verse eid="REV 1:13"/><verse number="14" style="v" sid="REV 1:14"/>Iya huupheynne iya binaanay bootha dorsa ikise mela woyko shacha mela boothi; iya ayfey tama laco daanees.<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="DAN 7:9">Daane 7:9</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="DAN 10:6">Daane 10:6</ref>.</char></note> <verse eid="REV 1:14"/><verse number="15" style="v" sid="REV 1:15"/>Iya tohoy taman seeridi zo77ida naase birata daanees; iya girsayka gita shaafa kooshincha mela.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="EZK 1:24">Hiz 1:24</ref>; <ref loc="EZK 43:2">43:2</ref>.</char></note> <verse eid="REV 1:15"/><verse number="16" style="v" sid="REV 1:16"/>I ba ushacha kushen laapun xoolintota oykis. Iya doonape nam7u baggara qaratida mashshay keyees. Iya som7oy seeta gallasa awa ayfe daanees.<verse eid="REV 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 1:17"/>Taani iya be7ida wode hayqida asada hanada iya tohuwa matan kundas. I ba ushacha kushiya ta bolla wothidi, “Yayyofa; Koyroynne Wursethay tana.<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="ISA 44:6">Isa 44:6</ref>; <ref loc="ISA 48:12">48:12</ref>; <ref loc="REV 2:8">Qon 2:8</ref>; <ref loc="REV 22:13">22:13</ref>.</char></note> <verse eid="REV 1:17"/><verse number="18" style="v" sid="REV 1:18"/>Taani de7on de7ayis; taani hayqas, shin Heko meri merinawuka de7on de7ayis. Hayqonne Si7oole qulpey ta kushena. <verse eid="REV 1:18"/><verse number="19" style="v" sid="REV 1:19"/>Hiza, ha77i haniyabanne sinthafe hananaba ne be7idaba xaafa. <verse eid="REV 1:19"/><verse number="20" style="v" sid="REV 1:20"/>Neeni ta ushacha kushen be7ida laapun xoolintotanne laapun worqa kocata birshethay haysa: Laapun xoolintoti laapun woosa keethata kiitanchota; laapun worqa kocati laapun woosa keethata.”<verse eid="REV 1:20"/></para>
  <chapter eid="REV 1"/>
  <chapter number="2" style="c" sid="REV 2"/>
  <para style="s1">Efesoona Woosa Keethi</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1"/>“Efesoona woosa keetha kiitanchuwas haysada yaagada xaafa.</para>
  <para style="pi" vid="REV 2:1">Ba ushacha kushen laapun xoolintota oykidaysinne laapun worqa kocata giddora hemeteysi haysada yaagees: <verse eid="REV 2:1"/><verse number="2" style="v" sid="REV 2:2"/>Taani ne oosuwa, ne daaburanne ne gencaa erayis. Neeni iita asataba gencanaw danda7aboonaysa erayis. Qassi hawaare gidonashin bantana, hawaare geyisata pilga erada enti wordancho gideysa demmidaysa ta erayis. <verse eid="REV 2:2"/><verse number="3" style="v" sid="REV 2:3"/>Neeni gencadasa; ta sunthaa gisho meto danda7adasa; xoonetabaaka. <verse eid="REV 2:3"/><verse number="4" style="v" sid="REV 2:4"/>Gidoshin, ha77i ta nena boriyabay de7ees; hessika neeni, ne koyro siiquwa aggadasa. <verse eid="REV 2:4"/><verse number="5" style="v" sid="REV 2:5"/>Hiza, ne ay mela dhoqa bessaafe kundidaako akeeka! Ne nagaraape simma; neeni kase oothiya oosuwa ootha. Neeni ne nagaraape simmonna ixiko, ne xompe wothiya kocaa iya bessaafe ekana. <verse eid="REV 2:5"/><verse number="6" style="v" sid="REV 2:6"/>Ha77i ta nena nashshiya issibay de7ees; ta ixiya Niqolaweeta oosuwa neka ixadasa.<verse eid="REV 2:6"/></para>
  <para style="pi">
    <verse number="7" style="v" sid="REV 2:7"/>Geeshsha Ayyaanay woosa keethatas giyaba si7anaw haythi de7iya oonika si7o. Xooniya oonika Xoossaa gannatiyan de7iya de7o mithee ayfepe maana mela maata immana.”<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="GEN 2:9">Medhe 2:9</ref>; <ref loc="REV 22:2">Qon 22:2</ref>; <ref loc="EZK 28:13">Hiz 28:13</ref>; <ref loc="EZK 31:8">31:8</ref>.</char></note><verse eid="REV 2:7"/></para>
  <para style="s1">Samirneesa Woosa Keethi</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8"/>Samirneesa woosa keethaa kiitanchuwas haysada yaagada xaafa.</para>
  <para style="pi" vid="REV 2:8">“Koyroynne wursethay, hayqidaysinne hayqope dendidaysi haysada yaagees:<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 44:6">Isa 44:6</ref>; <ref loc="ISA 48:12">48:12</ref>; <ref loc="REV 1:17">Qon 1:17</ref>; <ref loc="REV 22:13">22:13</ref>.</char></note><verse eid="REV 2:8"/></para>
  <para style="pi">
    <verse number="9" style="v" sid="REV 2:9"/>Taani ne waayanne ne manqotetha erayis; gidoshin neeni dure. Ayhude gidonashin bantana Ayhude geysati cayiya cashshaa ta erayis, shin enti Xalahe maabaran de7oosona. <verse eid="REV 2:9"/><verse number="10" style="v" sid="REV 2:10"/>Neeni ekanaw de7iya waayiya babofa. Xalahey hintefe issota issota paacanaw qasho keethan yeggana; tammu gallas gakanaw hinte waayetana. Hayqana gakanaw ammanetidaysa gida; ta new de7o kallacha immana.”<verse eid="REV 2:10"/></para>
  <para style="pi">
    <verse number="11" style="v" sid="REV 2:11"/>“Geeshsha Ayyaanay woosa keethatas giyaba si7anaw haythi de7iya oonika si7o. Xooniya oonika nam7antho hayquwan qohetenna.”<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="REV 20:14">Qon 20:14</ref>; <ref loc="REV 21:8">21:8</ref>.</char></note><verse eid="REV 2:11"/></para>
  <para style="s1">Phargamoona Woosa Keethi</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12"/>“Phargamoona woosa keethaa kiitanchuwas haysada yaagada xaafa.</para>
  <para style="pi" vid="REV 2:12">Nam7u baggara qaratida mashshay de7eysi haysada yaagees: <verse eid="REV 2:12"/><verse number="13" style="v" sid="REV 2:13"/>Taani ne de7iya bessaa erayis; neeni Xalahe araatay de7iya bessan de7aasa; ta sunthaa mintha naagadasa. Hari attoshin, Xalahey de7iya hinte kataman hayqida ta ammanetida markay, Antiphaasi, de7iya wodeka ammanuwa aggabaaka.<verse eid="REV 2:13"/></para>
  <para style="pi">
    <verse number="14" style="v" sid="REV 2:14"/>Gidoshin, ta nena boriya guuthabati de7oosona. Hessika Isra7eele asay eeqas yarshetida kathaa midi tunana melanne laymatetha nagara oothana mela Balaaqa tamaarsida Balaama timirtiya ekida issi issi asati neera de7oosona.<note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="NUM 22:5">Taybo 22:5</ref>.</char></note> <verse eid="REV 2:14"/><verse number="15" style="v" sid="REV 2:15"/>Hessadaka, Niqolaweeta timirtiya tamaariya asati neera de7oosona. <verse eid="REV 2:15"/><verse number="16" style="v" sid="REV 2:16"/>Hessa gisho, neeni ne nagaraape simma. Hessi hanonna ixiko, ta neeko ellesa yada he asata ta doonape keyiya mashshan olana.”<verse eid="REV 2:16"/></para>
  <para style="pi">
    <verse number="17" style="v" sid="REV 2:17"/>Geeshsha Ayyaanay woosa keethatas giyaba si7anaw haythi de7iya oonika si7o. Xooniya oodeska qosetidi de7iya mannafe<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="fqa" closed="false">Manna: </char><char style="ft" closed="false">Isra7eele asay mela biittan hemetiya wode salope Xoossay entaw immida dumma kathi woyko kiitancho kathi.</char></note> immana. Qassi ekiya uraape attishin, hara asi eronna ooratha sunthay xaafetida bootha shuchu taani iyaw immana.<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="EXO 16:14">Kessa 16:14</ref>.</char></note><verse eid="REV 2:17"/></para>
  <para style="s1">Tiyatroona Woosa Keethi</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18"/>“Tiyatiroona woosa keethaa kiitanchuwas haysada yaagada xaafa.</para>
  <para style="pi" vid="REV 2:18">Tama laco daaniya ayfey de7eysi, qassi taman seerida naase birata daaniya tohoy de7eysi, Xoossaa na7ay, haysada yaagees: <verse eid="REV 2:18"/><verse number="19" style="v" sid="REV 2:19"/>Taani ne oosuwa, ne siiquwa, ne ammanuwa, ne oosuwanne ne gencaa erayis. Neeni koyro ootheysafe ha77i aathada ootheysaka erayis.<verse eid="REV 2:19"/></para>
  <para style="pi">
    <verse number="20" style="v" sid="REV 2:20"/>Gidoshin, ta nena boriya issibay de7ees; bana nabe giya maccasiw, Elzabeelo, aykoka gabaaka. He maccasiya eeqas yarshetida kathaa midi tunanaadanne laymatanaada oothada ta aylleta balethasu.<note caller="-" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="1KI 16:31">1 Kawo 16:31</ref>; <ref loc="2KI 9:22">2 Kawo 9:22</ref>.</char></note> <verse eid="REV 2:20"/><verse number="21" style="v" sid="REV 2:21"/>Iya ba nagaraape simmana mela ta iw wode immas, shin iya simmanaw koyabuku. <verse eid="REV 2:21"/><verse number="22" style="v" sid="REV 2:22"/>Enti I bala ogiyape simmonna ixiko, ta iyo iita hargen yeggana; iira laymateysatika iita waaye waayetana. <verse eid="REV 2:22"/><verse number="23" style="v" sid="REV 2:23"/>Taani I nayta wodhana; qassi woosa keetha ubbay ta asa qofanne asa wozana ereysa gideysa erana. Ta issuwas issuwas hinte oosuwada oosuwada immana.”<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="PSA 7:9">Maz 7:9</ref>; <ref loc="JER 17:10">Ermi 17:10</ref>; <ref loc="PSA 62:12">Maz 62:12</ref>.</char></note> <verse eid="REV 2:23"/><verse number="24" style="v" sid="REV 2:24"/>Shin Tiyatiroonan de7iya harata, he iita timirtiya ekiboonaysatanne, “Xalahe gita xuura” geetetiya ha timirtiya tamaariboonna hintena hara deexo tooho toossike. <verse eid="REV 2:24"/><verse number="25" style="v" sid="REV 2:25"/>Gidoshin, ta yaana gakanaw hintew de7iyaba minthi naagite.<verse eid="REV 2:25"/></para>
  <para style="pi">
    <verse number="26" style="v" sid="REV 2:26"/>Xooneysasinne wursethi gakanaw taw kiitetiya oodeska kawotethata haarana mela maata immana.<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="PSA 2:8-9">Maz 2:8-9</ref>.</char></note><verse eid="REV 2:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="REV 2:27"/>“I enta birata xam7an haarana;</para>
  <para style="q2" vid="REV 2:27">meqa miishedaka mentherethana.”</para>
  <para style="pi" vid="REV 2:27">He maatay taani ta aawape ekida maata mela. <verse eid="REV 2:27"/><verse number="28" style="v" sid="REV 2:28"/>Qassi ta iyaw bakala xoolinto immana. <verse eid="REV 2:28"/><verse number="29" style="v" sid="REV 2:29"/>Geeshsha Ayyaanay woosa keethatas giyaba si7iya haythi de7iya oonika si7o.<verse eid="REV 2:29"/></para>
  <chapter eid="REV 2"/>
  <chapter number="3" style="c" sid="REV 3"/>
  <para style="s1">Sardeesa Woosa Keethi</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1"/>“Sardeesa woosa keetha kiitanchuwas haysada yaagada xaafa.</para>
  <para style="pi" vid="REV 3:1">Laapun Xoossaa ayyaanatanne laapun xoolintota oykidaysi haysada yaagees: Taani ne oosuwa erayis; asi nena paxa de7ees giikoka, ne hayqadasa. <verse eid="REV 3:1"/><verse number="2" style="v" sid="REV 3:2"/>Barka; attida guuthabanne hayqanaw matidaba mintha. Ne oosoy Xoossaa sinthan polo gidonnaysa demmas. <verse eid="REV 3:2"/><verse number="3" style="v" sid="REV 3:3"/>Hiza, ne ekidabaanne si7idaba akeeka; naaga; ne nagaraape simma. Neeni barkonna ixiko ta kaysoda yaana; ta ay wode yaaneko ne eraka.<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="MAT 24:43">Maato 24:43</ref>.</char></note><verse eid="REV 3:3"/></para>
  <para style="pi">
    <verse number="4" style="v" sid="REV 3:4"/>Shin banta ma7uwa qitayonna guutha asati Sardeesan de7oosona. Entaw bessiyaba gidiya gisho bootha ma7o ma7idi enti taara hemetana. <verse eid="REV 3:4"/><verse number="5" style="v" sid="REV 3:5"/>Xooniya oonika entaysada bootha ma7o ma7ana. Taani iya sunthaa de7o maxaafape quchike. Taani ta Aawa sinthaninne iya kiitanchota sinthan I tabaa gideysa markatana.<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="EXO 32:32">Kessa 32:32</ref>.</char></note> <verse eid="REV 3:5"/><verse number="6" style="v" sid="REV 3:6"/>Geeshsha Ayyaanay woosa keethatas giyaba si7iya haythi de7iya oonika si7o.<verse eid="REV 3:6"/></para>
  <para style="s1">Filaadelfiya Woosa Keethi</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7"/>“Filaadelfiya woosa keetha kiitanchuwas haysada yaagada xaafa.</para>
  <para style="pi" vid="REV 3:7">Geeshshaynne tumanchoy, Dawita qulpiya ba kushen oykidaysi, haysada yaagees: I gordin oonika dooyanaw danda7enna; qassi I dooyin oonika gordanaw danda7enna.<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ISA 22:22">Isa 22:22</ref>; <ref loc="JOB 12:14">Iyyo 12:14</ref>.</char></note> <verse eid="REV 3:7"/><verse number="8" style="v" sid="REV 3:8"/>Taani ne oosuwa eras; Heko ta ne sinthan oonika gordanaw danda7onna dooya penge wothas. Ne wolqay guutha gidikoka, ta qaala naagadasa; tana kaddabaaka. <verse eid="REV 3:8"/><verse number="9" style="v" sid="REV 3:9"/>Ayhude gidonashin, bantana Ayhude giya wordotanne Xalahe baggata neeko ehananne ne sinthan gulbatisana. Ta nena doseysa entana erisana.<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="ISA 49:23">Isa 49:23</ref>; <ref loc="ISA 60:14">60:14</ref>; <ref loc="ISA 43:4">Isa 43:4</ref>.</char></note> <verse eid="REV 3:9"/><verse number="10" style="v" sid="REV 3:10"/>Neeni, ‘Genca’ gada ta kiitida kiitaa naagida gisho, kumetha alamiya paacanaw yaa waaye wodiyape taani nena naagana.<verse eid="REV 3:10"/></para>
  <para style="pi">
    <verse number="11" style="v" sid="REV 3:11"/>Taani ellesada yaana; oonika ne kallachaa ekonna mela new de7iyaba minthada oyka. <verse eid="REV 3:11"/><verse number="12" style="v" sid="REV 3:12"/>Xoonidaysa ta xoossa keethan tuussu oothana; I yan merinaw daana. Taani ta Xoossaa sunthaanne ta Xoossaa katamaa sunthaa iya bolla xaafana; iyaka ta Xoossaa matape wodhiya ooratha Yerusalaame. Qassi taani ta ooratha sunthaaka I bolla xaafana.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="REV 21:2">Qon 21:2</ref>; <ref loc="ISA 62:2">Isa 62:2</ref>; <ref loc="ISA 65:15">65:15</ref>.</char></note> <verse eid="REV 3:12"/><verse number="13" style="v" sid="REV 3:13"/>Geeshsha Ayyaanay woosa keethatas giyaba si7iya haythi de7iya oonika si7o.<verse eid="REV 3:13"/></para>
  <para style="s1">Loodoqe Woosa Keethi</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14"/>“Loodoqe woosa keetha kiitanchuwas haysada yaagada xaafa.</para>
  <para style="b" vid="REV 3:14"/>
  <para style="pi" vid="REV 3:14">Amin7i gidida ammanetida tuma markay, Xoossaa medhetetha haareysi haysada yaagees:<note caller="-" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="PRO 8:22">Leemi 8:22</ref>.</char></note> <verse eid="REV 3:14"/><verse number="15" style="v" sid="REV 3:15"/>Taani ne oosuwa ubba erayis; neeni irxa woyko misha gidaka; neeni nam7aafe issuwa gidiko lo77o! <verse eid="REV 3:15"/><verse number="16" style="v" sid="REV 3:16"/>Neeni irxa woyko misha gidonashin, bol7o gidiya gisho ta nena ta doonape cuttana hanayis. <verse eid="REV 3:16"/><verse number="17" style="v" sid="REV 3:17"/>Hiza, neeni, ‘Taani dure, shallora de7ayis, taw aybibayka pacibeenna’ yaagasa. Shin neeni metootancho, manqo, qooqenne kallotida asi gideysa eraka. <verse eid="REV 3:17"/><verse number="18" style="v" sid="REV 3:18"/>Hessa gisho, ne duretanaw taman geeyida worqaa, ne yeella kalluwa kammanaw bootha ma7onne loytha xeellanaw danda7isiya ayfe dhale taape shammana mela nena ta zorayis.<verse eid="REV 3:18"/></para>
  <para style="pi">
    <verse number="19" style="v" sid="REV 3:19"/>Ta doseysa seeraysinne hanqayis; hiza minna; ne nagaraape simma.<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="PRO 3:12">Leemi 3:12</ref>; <ref loc="HEB 12:6">Ibra 12:6</ref>.</char></note> <verse eid="REV 3:19"/><verse number="20" style="v" sid="REV 3:20"/>Heko, ta karen eqada xeegayis. Oonika ta xeessaa si7idi, wulaa dooyiko, iyako gelana; iyara issife kathi maana; ika taara issife maana.<verse eid="REV 3:20"/></para>
  <para style="pi">
    <verse number="21" style="v" sid="REV 3:21"/>Ta xoonada ta Aawara iya araatan uttidaysada xooniday taara ta araatan uttana mela maata immana. <verse eid="REV 3:21"/><verse number="22" style="v" sid="REV 3:22"/>Geeshsha Ayyaanay woosa keethatas giyaba si7iya haythi de7ey oonika si7o” yaagis.<verse eid="REV 3:22"/></para>
  <chapter eid="REV 3"/>
  <chapter number="4" style="c" sid="REV 4"/>
  <para style="s1">Salon De7iya Araata</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1"/>Hessafe guye, taani salo xeelliya wode dooyetida penge be7as. Qassi ta kase si7ida moyze girsaa melay taako, “Ha keya; haysafe guye, hananaw de7iyaba ta nena bessaana” yaagis. <verse eid="REV 4:1"/><verse number="2" style="v" sid="REV 4:2"/>He wode ta Ayyaanan haaretada de7ayis. Heko, saluwan araata bolla issoy uttidaysa be7as.<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="EZK 1:26-28">Hiz 1:26-28</ref>; <ref loc="EZK 10:1">10:1</ref>.</char></note> <verse eid="REV 4:2"/><verse number="3" style="v" sid="REV 4:3"/>He uttidaysa malay yasphedenne sardiyoone al7o shucha mela. Iya araata yuushuwan al7o margide shuchi daaniya zuulli de7ees. <verse eid="REV 4:3"/><verse number="4" style="v" sid="REV 4:4"/>He araata yuushuwan laatamanne oyddu araatati de7oosona; enta bolla bootha ma7o ma7idi, huuphen worqa kallachaa wothida laatamanne oyddu cimati uttidosona. <verse eid="REV 4:4"/><verse number="5" style="v" sid="REV 4:5"/>Araatape wol7anthi, guunthinne deshoy keyees. Araata sinthan laapun poo7iya xompeti de7oosona; enti laapun Xoossaa ayyaanata.<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="EXO 19:16">Kessa 19:16</ref>; <ref loc="REV 1:4">Qon 1:4</ref>; <ref loc="REV 8:5">Qon 8:5</ref>; <ref loc="REV 11:19">11:19</ref>; <ref loc="REV 16:18">16:18</ref>; <ref loc="EZK 1:13">Hiz 1:13</ref>; <ref loc="ZEC 4:2">Zaka 4:2</ref>.</char></note> <verse eid="REV 4:5"/><verse number="6" style="v" sid="REV 4:6"/>Araata sinthan birille daaniya phooliya burcuko abbay de7ees.<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="EZK 1:22">Hiz 1:22</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="EZK 1:5-10">Hiz 1:5-10</ref>; <ref loc="EZK 10:14">10:14</ref>.</char></note></para>
  <para style="p" vid="REV 4:6">Sintharanne guyera ayfey de7iya oyddu de7ora de7iya medhetethati araata yuushuwaninne araata giddon de7oosona. <verse eid="REV 4:6"/><verse number="7" style="v" sid="REV 4:7"/>Koyro medhetetha medhoy gaammo daanees; nam7anthoy boori daanees; heedzanthoy ase daanees; qassi oyddanthoy piradhiya arganthi daanees. <verse eid="REV 4:7"/><verse number="8" style="v" sid="REV 4:8"/>Oyddu medhetethata ubbaas usupun qefey de7ees; enta asatethaa ubbay ayfen kumis.<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="EZK 1:18">Hiz 1:18</ref>; <ref loc="EZK 10:12">10:12</ref>; <ref loc="ISA 6:2">Isa 6:2</ref>.</char></note> Enti qammanne gallas qanxonna,</para>
  <para style="qc" vid="REV 4:8">“Geeshshaw, geeshshaw, geeshshaw,</para>
  <para style="qc" vid="REV 4:8">Godaw, Ubbaafe Wolqaama Xoossaw,</para>
  <para style="qc" vid="REV 4:8">Kaseka, ha77ika de7eyso, sinthafe yaanayso”</para>
  <para style="m" vid="REV 4:8">yaagosona. <verse eid="REV 4:8"/><verse number="9" style="v" sid="REV 4:9"/>He medhetethati araatan uttidaysasinne merinaw de7eysas saba, bonchonne galata immida wode, <verse eid="REV 4:9"/><verse number="10" style="v" sid="REV 4:10"/>laatamanne oyddu cimati araatan uttidaysanne merinaw de7eysa sinthan gufannidi goyinnidosona; banta kallachaa araata sinthan wothidi,<verse eid="REV 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11"/>“Nu Godaw, nu Xoossaw,</para>
  <para style="q2" vid="REV 4:11">neeni boncho, sabanne wolqaa ekanaw bessaasa.</para>
  <para style="q1" vid="REV 4:11">Neeni ubbaa medhadasa;</para>
  <para style="q2" vid="REV 4:11">ubbabay ne sheniyada hanis, medhetis”</para>
  <para style="m" vid="REV 4:11">yaagidosona.<verse eid="REV 4:11"/></para>
  <chapter eid="REV 4"/>
  <chapter number="5" style="c" sid="REV 5"/>
  <para style="s1">Dorsanne Xaatha Maxaafa</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1"/>Hessafe guye, araata bolla uttidaysa ushacha kushen giddoranne karera xaafetida laapun maatamen gordetida xaatha maxaafaa be7as.<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="EZK 2:9">Hiz 2:9</ref>.</char></note> <verse eid="REV 5:1"/><verse number="2" style="v" sid="REV 5:2"/>Issi mino kiitanchoy ba qaala dhoqu oothidi, “Maatamiya billanawunne maxaafaa dooyanaw bessey oonee?” yaagidi awaajishin be7as. <verse eid="REV 5:2"/><verse number="3" style="v" sid="REV 5:3"/>Shin salon gidin sa7an woyko sa7ape garsan gidin he xaatha maxaafaa billanawunne gidduwa be7anaw danda7ey oonika bentibeenna. <verse eid="REV 5:3"/><verse number="4" style="v" sid="REV 5:4"/>Xaatha maxaafaa billanawunne iya gidduwa be7anaw bessiya asi dhayida gisho ta daro yeekas. <verse eid="REV 5:4"/><verse number="5" style="v" sid="REV 5:5"/>Yaatin, cimatape issoy taako, “Yeekofa! Heko, Yihuda koche gidiya gaammoy, Dawita sheeshay, laapun maatameta billanawunne maxaafaa dooyanaw danda7is” yaagis.<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="GEN 49:9">Medhe 49:9</ref>; <ref loc="ISA 11:1">Isa 11:1</ref>.</char></note><verse eid="REV 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6"/>Hessafe guye, shuketida Dorsay araatas, oyddu de7on de7iya medhetethatasinne cimatas giddon, eqidaysa be7as. Iyaw laapun kacetinne laapun ayfeti de7oosona. Hessati sa7a ubbaa kiitetida Xoossaa laapun ayyaanata.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 53:7">Isa 53:7</ref>; <ref loc="ZEC 4:10">Zaka 4:10</ref>.</char></note> <verse eid="REV 5:6"/><verse number="7" style="v" sid="REV 5:7"/>He Dorsay bidi, araata bolla uttidaysa ushacha kushepe xaatha maxaafaa ekis. <verse eid="REV 5:7"/><verse number="8" style="v" sid="REV 5:8"/>I he xaatha maxaafaa ekida wode, de7on de7iya oyddu medhetethatinne laatamanne oyddu cimati Dorsa sinthan kundidosona. Enti issoy issoy diithinne geeshshata woosa gidida ixaaney kumida worqa shaate oykidosona.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 141:2">Maz 141:2</ref>.</char></note> <verse eid="REV 5:8"/><verse number="9" style="v" sid="REV 5:9"/>Enti,</para>
  <para style="q1" vid="REV 5:9">“Xaatha maxaafaa ekanaw,</para>
  <para style="q2" vid="REV 5:9">maatameta billanaw new bessees.<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="PSA 33:3">Maz 33:3</ref>; <ref loc="PSA 98:1">98:1</ref>; <ref loc="ISA 42:10">Isa 42:10</ref>.</char></note></para>
  <para style="q1" vid="REV 5:9">Ayis giiko, neeni shuketadasa;</para>
  <para style="q2" vid="REV 5:9">koche ubbaafe, dumma dumma doonape,</para>
  <para style="q2" vid="REV 5:9">yaratapenne kawotethata ubbaafe</para>
  <para style="q2" vid="REV 5:9">ne suuthan Xoossaas wozadasa.<verse eid="REV 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10"/>Enti iya Xoossaa Aawas oothana mela</para>
  <para style="q2" vid="REV 5:10">entana kahine kawotethi oothadasa.</para>
  <para style="q1" vid="REV 5:10">Entika biitta ubbaa haarana”</para>
  <para style="m" vid="REV 5:10">yaagidi ooratha mazmure yexidosona.<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="EXO 19:6">Kessa 19:6</ref>; <ref loc="REV 1:6">Qon 1:6</ref>.</char></note><verse eid="REV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11"/>Ta be7iya wode mukulu toho mukulunne tammu mukulu toho tammu mukulu gidiya kiitanchota girsaa si7as. Entika araata, oyddu de7on de7iya medhetethatanne, cimata yuushuwan eqidosona.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="DAN 7:10">Daane 7:10</ref>.</char></note> <verse eid="REV 5:11"/><verse number="12" style="v" sid="REV 5:12"/>He kiitanchoti dhoqu gida qaalan,</para>
  <para style="q1" vid="REV 5:12">“Shuketida Dorsay wolqaa, duretethi,</para>
  <para style="q2" vid="REV 5:12">cincatethinne minotethi,</para>
  <para style="q2" vid="REV 5:12">boncho, sabanne galataa ekanaw bessees”</para>
  <para style="m" vid="REV 5:12">yaagidosona.<verse eid="REV 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13"/>Hessafe guye, sa7an, salon, sa7ape garsaninne abba giddon de7iya medhetethi ubbay,</para>
  <para style="q1" vid="REV 5:13">“Araata bolla uttidaysasinne Dorsaas,</para>
  <para style="q2" vid="REV 5:13">galatay, bonchoy, sabinne wolqi,</para>
  <para style="q2" vid="REV 5:13">meri merinaw gido”</para>
  <para style="m" vid="REV 5:13">yaagidi yexishin si7as.<verse eid="REV 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14"/>Oyddu de7on de7iya medhetethati, “Amin7i” yaagidosona; qassi cimati gufannidi goyinnidosona.<verse eid="REV 5:14"/></para>
  <chapter eid="REV 5"/>
  <chapter number="6" style="c" sid="REV 6"/>
  <para style="s1">Laapun Maatameta Dooyetethi</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1"/>Dorsay laapun maatametape issuwa dooyishin be7as. Qassi oyddu de7on de7iya medhetethatape issoy, dada desho daaniya girsan, “Haaya!” yaagishin si7as. <verse eid="REV 6:1"/><verse number="2" style="v" sid="REV 6:2"/>Heko bootha para be7as. He para toggidaysi donge oykis; iya huuphen kallachi de7ees. Ika xoonishe xoonanaw keyis.<note caller="-" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="ZEC 1:7">Zaka 1:7</ref>.</char></note><verse eid="REV 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3"/>Qassi dorsay nam7antho maatamiya dooyida wode de7on de7iya nam7antho medhetethay, “Haaya!” yaagishin si7as. <verse eid="REV 6:3"/><verse number="4" style="v" sid="REV 6:4"/>Qassi hara siha zo7o pari keyis. He para toggidaysas sa7ape saro dhaysana melanne asay woli wursana mela maatinne gita mashshay imetis.<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="ZEC 1:7">Zaka 1:7</ref>.</char></note><verse eid="REV 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5"/>Dorsay heedzantho maatamiya dooyida wode de7on de7iya heedzantho medhetethay, “Haaya!” yaagishin si7as. Heko kareetha para be7as; ika ba kushen mizaane oykis.<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="ZEC 6:2">Zaka 6:2</ref>.</char></note> <verse eid="REV 6:5"/><verse number="6" style="v" sid="REV 6:6"/>Oyddu de7on de7iya medhetethata giddofe, “Issi gallasa oosos damooze, bagga kilo giste; qassi issi gallasa oosos damooze, issi kilonne bagga banga gido. Shin zaytiyanne woyniya qohopa” yaagishin si7as.<verse eid="REV 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7"/>Dorsay oyddantho maatamiya dooyida wode oyddantho de7on de7iya medhetethay, “Haaya!” yaagishin si7as. <verse eid="REV 6:7"/><verse number="8" style="v" sid="REV 6:8"/>Heko wanco para be7as. He para toggidaysa sunthay hayqo; iya geedo Si7ooley kaallees. Entaw alamepe oyddantho kushiya olan, koshan, gadoninne do7an wodhisana mela maati imetis.<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="EZK 14:21">Hiz 14:21</ref>.</char></note><verse eid="REV 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9"/>Dorsay ichashantho maatamiya dooyida wode enti Xoossaa qaala odida gishonne banta markatethan ammanetida gisho shuketida asaa shempota yarsho bessaafe garsan be7as. <verse eid="REV 6:9"/><verse number="10" style="v" sid="REV 6:10"/>Enti banta qaala dhoqu oothidi, “Ubbaa haariya Godaw, geeshshaw, tumanchuwaw, sa7an de7iya asaa bolla ne pirdanaynne nu suuthaa gisho halo keyanay awudee?” yaagidosona. <verse eid="REV 6:10"/><verse number="11" style="v" sid="REV 6:11"/>Enta issuwas issuwas bootha ma7oy imetis. Entaysada hanidi hayqanaw bessiya enta laggeta tayboy kumana gakanaw guutha wode shempana mela entaw odetis.<verse eid="REV 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12"/>Dorsay usupuntho maatamiya dooyida wode ta be7as; wolqaama biitta qaaxoy hanis. Awa ayfey kareexidi kayo ma7o mela gidis. Ageenayka zo77idi suuthu daanis.<note caller="-" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="REV 11:13">Qon 11:13</ref>; <ref loc="REV 16:18">16:18</ref>; <ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="JER 2:10">Ermi 2:10</ref>.</char></note> <verse eid="REV 6:12"/><verse number="13" style="v" sid="REV 6:13"/>Wolqaama carkoy carkidi balase mitha qawu7e ayfiya qoqofeysada saluwa xoolintoti sa7an qoqofetidosona.<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="ISA 34:4">Isa 34:4</ref>.</char></note> <verse eid="REV 6:13"/><verse number="14" style="v" sid="REV 6:14"/>Saloy xaatha maxaafada xaaxetidi aadhis; zumaynne yuushoy abban teqetida biittati banta bessaafe dhaydosona.<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="REV 16:20">Qon 16:20</ref>.</char></note> <verse eid="REV 6:14"/><verse number="15" style="v" sid="REV 6:15"/>Biitta kawoti, deriya haareysati, olla kaaletheysati, dureti, wolqaamati, aylletinne, womaannoti gongoloninne dere bolla de7iya zaalla hom7on qosetidosona.<note caller="-" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="ISA 2:19">Isa 2:19</ref>.</char></note> <verse eid="REV 6:15"/><verse number="16" style="v" sid="REV 6:16"/>Entika zumakonne zaallako, “Nu bolla wodhite; nuna qosite; araatan uttidaysa ayfiyapenne Dorsa hanquwafe nuna genthite.<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="HOS 10:8">Hose 10:8</ref>; <ref loc="LUK 23:30">Luqa 23:30</ref>.</char></note> <verse eid="REV 6:16"/><verse number="17" style="v" sid="REV 6:17"/>Hiza, gita hanqo gallasay gakis; danda7idi eqanay oonee?” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="JER 2:11">Ermi 2:11</ref>; <ref loc="MAL 3:2">Milki 3:2</ref>.</char></note><verse eid="REV 6:17"/></para>
  <chapter eid="REV 6"/>
  <chapter number="7" style="c" sid="REV 7"/>
  <para style="s1">144, 000 Asati Maletidosona</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1"/>Hessafe guye, oyddu kiitanchoti oyddu sa7aa gaxan eqidaysata be7as. He kiitanchoti sa7a bolla woyko abba bolla woyko ay mitha bolla carkoy oyddu sa7aa gaxape carkonna mela teqidosona.<note caller="-" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="JER 49:36">Ermi 49:36</ref>; <ref loc="DAN 7:2">Daane 7:2</ref>; <ref loc="ZEC 6:5">Zaka 6:5</ref>.</char></note> <verse eid="REV 7:1"/><verse number="2" style="v" sid="REV 7:2"/>Qassi de7o Xoossaa maatamiya oykida hara kiitanchoy doloha baggafe keyeysa be7as. He kiitanchoy ba qaala dhoqu oothidi, sa7aanne abba qohanaw wolqi imetida oyddu kiitanchota, <verse eid="REV 7:2"/><verse number="3" style="v" sid="REV 7:3"/>xeegidi, “Nuuni Xoossaa aylleta som7on maatamiya wothana gakanaw biitta woyko abba woyko mithaa qohopite” yaagis.<note caller="-" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="EZK 9:4">Hiz 9:4</ref>.</char></note><verse eid="REV 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 7:4"/>Yaatin, taani Xoossaa maatamey som7on wosetidaysata payduwa si7as. Isra7eele mayzata ubbaafe 144000 asaas som7on maatame wothis.<verse eid="REV 7:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 7:5"/>Yihuda kochaafe tammanne nam7u mukulu,</para>
  <para style="q1" vid="REV 7:5">Robeela kochaafe tammanne nam7u mukulu,</para>
  <para style="q1" vid="REV 7:5">Gaade kochaafe tammanne nam7u mukulu,<verse eid="REV 7:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 7:6"/>Aseera kochaafe tammanne nam7u mukulu,</para>
  <para style="q1" vid="REV 7:6">Niftaaleme kochaafe tammanne nam7u mukulu,</para>
  <para style="q1" vid="REV 7:6">Minaase kochaafe tammanne nam7u mukulu,<verse eid="REV 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 7:7"/>Simoona kochaafe tammanne nam7u mukulu;</para>
  <para style="q1" vid="REV 7:7">Leewe kochaafe tammanne nam7u mukulu,</para>
  <para style="q1" vid="REV 7:7">Yisakoora kochaafe tammanne nam7u mukulu,<verse eid="REV 7:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 7:8"/>Zabloona kochaafe tammanne nam7u mukulu,</para>
  <para style="q1" vid="REV 7:8">Yoosefa kochaafe tammanne nam7u mukulu,</para>
  <para style="q1" vid="REV 7:8">Biniyaame kochaafe tammanne nam7u mukulu,</para>
  <para style="m" vid="REV 7:8">asaa som7on maatame wothis.<verse eid="REV 7:8"/></para>
  <para style="s1">Bootha Ma7o Ma7ida Asata</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9"/>Hessafe guye, koche ubbaafe, kawotetha ubbaafe, yara ubbaafenne dumma dumma doonape zawi bayna daro asaa be7as. He asay bootha ma7o ma7idi, zamba haythi banta kushen oykidi, araata sinthaninne Dorsa sinthan eqidosona. <verse eid="REV 7:9"/><verse number="10" style="v" sid="REV 7:10"/>Enti banta qaala dhoqu oothidi, “Atotethay araatan uttida nu Xoossaafenne Dorsaafe yees” yaagidosona.<verse eid="REV 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 7:11"/>Kiitanchoti ubbay araata, cimatanne oyddu medhetethata yuushuwan eqidosona. Enti araata sinthan gufannidi Xoossaa goyinnidosona.<verse eid="REV 7:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 7:12"/>“Amin7i!</para>
  <para style="q2" vid="REV 7:12">Anjoy, bonchoy, cincatethi, galati, sabi</para>
  <para style="q2" vid="REV 7:12">wolqi, minotethi meri merinaw nu Xoossaas gido.</para>
  <para style="q1" vid="REV 7:12">Amin7i!”</para>
  <para style="m" vid="REV 7:12">yaagidosona.<verse eid="REV 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13"/>Cimatape issoy taako, “Ha bootha ma7uwa ma7ida asati oonantee? Enti awupe yidona?” yaagidi oychis.<verse eid="REV 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14"/>Taani zaarada, “Godaw, ne eraasa” yaagas.</para>
  <para style="p" vid="REV 7:14">Ika taako, “Haysati daro waaye waaydi aadhidaysata. Enti banta ma7uwa Dorsa suuthan meeccidi geeshshidosona.<note caller="-" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="DAN 12:1">Daane 12:1</ref>; <ref loc="MAT 24:21">Maato 24:21</ref>; <ref loc="MRK 13:19">Mar 13:19</ref>.</char></note> <verse eid="REV 7:14"/><verse number="15" style="v" sid="REV 7:15"/>Hessa gisho,</para>
  <para style="q2" vid="REV 7:15">enti Xoossaa araata sinthan gididi</para>
  <para style="q2" vid="REV 7:15">qammanne gallas iya keethan oothosona;</para>
  <para style="q2" vid="REV 7:15">araata bolla uttidaysi entaw kuya gidana.<verse eid="REV 7:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="REV 7:16"/>Hizape guye, enti koshatokona, saamotokona.</para>
  <para style="q2" vid="REV 7:16">Awi woyko mishi enta meenna.<note caller="-" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="ISA 49:10">Isa 49:10</ref>.</char></note><verse eid="REV 7:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 7:17"/>Araata giddon uttida Dorsay enta heemmana.</para>
  <para style="q2" vid="REV 7:17">De7o pulto haathaako enta kaalethana.<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 23:1">Maz 23:1</ref>; <ref loc="EZK 34:23">Hiz 34:23</ref>; <ref loc="PSA 23:2">Maz 23:2</ref>; <ref loc="ISA 49:10">Isa 49:10</ref>; <ref loc="ISA 25:8">Isa 25:8</ref>.</char></note></para>
  <para style="q1" vid="REV 7:17">Xoossay enta ayfepe afutha ubbaa quchana”</para>
  <para style="m" vid="REV 7:17">yaagis.<verse eid="REV 7:17"/></para>
  <chapter eid="REV 7"/>
  <chapter number="8" style="c" sid="REV 8"/>
  <para style="s1">Laapuntha Maatamey Dooyetis</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1"/>Dorsay laapuntha maatamiya dooyida wode bagga saate gideysa mela saloy si77i gis.<verse eid="REV 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 8:2"/>Hessafe guye, taani laapun moyzeti imetida laapun kiitanchota Xoossaa sinthan eqidaysata be7as.<verse eid="REV 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3"/>Ixaane cuyisiya worqa shaate oykida hara kiitanchoy yidi, yarsho bessa matan eqis. I araata sinthan de7iya worqa yarsho bessa bolla geeshshata ubbaa woosaara gujidi yarshana mela iyaw daro ixaaney imetis. <verse eid="REV 8:3"/><verse number="4" style="v" sid="REV 8:4"/>Ixaaniya cuyay geeshshata woosaara issife kiitanchuwa kushepe pude Xoossaako keyis. <verse eid="REV 8:4"/><verse number="5" style="v" sid="REV 8:5"/>Hessafe guye, kiitanchoy ixaane cuyisiya shaatiya ekidi, iyan yarsho bessaafe bonqo tama kunthidi sa7a duge holis. Yaatin deshoy, wol7anthi, girsinne biitta qaaxoy hanis.<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="LEV 16:12">Leewe 16:12</ref>; <ref loc="EZK 10:2">Hiz 10:2</ref>; <ref loc="EXO 19:16">Kessa 19:16</ref>; <ref loc="REV 11:19">Qon 11:19</ref>; <ref loc="REV 16:18">16:18</ref>.</char></note><verse eid="REV 8:5"/></para>
  <para style="s1">Laapun Moyzeta</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6"/>Hessafe guye, laapun kiitanchoti banta moyziya punnanaw giigetidosona.<verse eid="REV 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7"/>Koyro kiitanchoy ba moyziya punniya wode shachinne suuthara walaketida tami salope bukis. Sa7aape sikoy xuugetis; mithafe sikoy xuugetis; cil7o maata ubbay xuugetis.<note caller="-" style="x"><char style="xo" closed="false">8:7 </char><char style="xt" closed="false"><ref loc="EXO 9:23-25">Kessa 9:23-25</ref>; <ref loc="EZK 38:22">Hiz 38:22</ref>.</char></note><verse eid="REV 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8"/>Nam7antho kiitanchoy ba moyziya punnida wode wolqaama zuma daaniyabay taman eexishe abban yegetis. Yaatin, abbaafe sikoy suuthu gidis. <verse eid="REV 8:8"/><verse number="9" style="v" sid="REV 8:9"/>Abban de7on de7iya medhetethaafe sikoy hayqis; markabetape sikoy dhayis.<verse eid="REV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10"/>Heedzantho kiitanchoy ba moyziya punnida wode xompeda eexiya wolqaama xoolintoy shaafape sikuwa bollanne pultota bolla salope wodhis.<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="ISA 14:12">Isa 14:12</ref>.</char></note> <verse eid="REV 8:10"/><verse number="11" style="v" sid="REV 8:11"/>He xoolintuwa sunthay Camo geetetees. Haathaafe sikuwa camisis; haathay cammida gisho, daro asay he haatha uyidi hayqidosona.<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="JER 9:15">Ermi 9:15</ref>.</char></note><verse eid="REV 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12"/>Oyddantho kiitanchoy ba moyziya punnis. Awape, ageenapenne xoolintotape sikuwa dechis; enta poo7uwape sikoy dhumis. Gallasaape sikoy, qammaafeka sikoy dhumis.<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="EZK 32:7">Hiz 32:7</ref>; <ref loc="JOL 2:10">Iyyu 2:10</ref>.</char></note><verse eid="REV 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13"/>Issi arganthi salo dhoqu gidi, piradhishin be7as. He arganthay ba qaala dhoqu oothidi, “Attida heedzu kiitanchoti banta moyziya punnanaw de7iya gisho, sa7an de7iya asaa ayye! Ayye! Ayye!” yaagishin si7as.<verse eid="REV 8:13"/></para>
  <para style="b"/>
  <chapter eid="REV 8"/>
  <chapter number="9" style="c" sid="REV 9"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1"/>Hessafe guye, ichashantho kiitanchoy ba moyziya punnin salope duge sa7a kundida xoolinto be7as. He xoolintuwas wolqaama ollaa qulpey imetis. <verse eid="REV 9:1"/><verse number="2" style="v" sid="REV 9:2"/>Xoolintoy ollaa dooyida wode dalga coocepe keyiya cuyaa mela cuyay he ollaafe keyis. He ollaafe keyida cuyan awinne saloy dhumidosona.<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="GEN 19:28">Medhe 19:28</ref>.</char></note><verse eid="REV 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 9:3"/>He cuyape booley keyidi sa7an wodhis. Sa7an de7iya kornetas de7iya wolqaa mela wolqay booletas imetis.<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="EXO 10:12">Kessa 10:12</ref>.</char></note> <verse eid="REV 9:3"/><verse number="4" style="v" sid="REV 9:4"/>Xoossaa maatamey som7on bayna asaa xalaalape attishin, sa7an de7iya maata woyko mithi woyko ay cil7oba gidin qohonna mela booletas odetis.<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="EZK 9:4">Hiz 9:4</ref>.</char></note> <verse eid="REV 9:4"/><verse number="5" style="v" sid="REV 9:5"/>Booleti asaa ichashu ageena gakanaw paxa kaa7ana mela maati imetisipe attishin, asaa wodhana mela gidenna. Korney ase dukin zaameysa mela booley dukidi zaamisees. <verse eid="REV 9:5"/><verse number="6" style="v" sid="REV 9:6"/>He gallasatan asay hayqo koyana, shin demmenna. Enti hayqanaw amottana, shin hayqoy entafe haakana.<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="JOB 3:21">Iyyo 3:21</ref>; <ref loc="JER 8:3">Ermi 8:3</ref>.</char></note><verse eid="REV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7"/>Booley olas giigidi uttida para daanees. Booliya huuphen worqa kallachi de7ees; enta som7oyka asa som7o daanees.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="JOL 2:4">Iyyu 2:4</ref>.</char></note> <verse eid="REV 9:7"/><verse number="8" style="v" sid="REV 9:8"/>Iya binaanay maccasa binaana mela adusse. Enta achayka gaammo achi daanees.<note caller="-" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="JOL 1:6">Iyyu 1:6</ref>.</char></note> <verse eid="REV 9:8"/><verse number="9" style="v" sid="REV 9:9"/>Entaw tira bolla wothiya birata xururey de7ees; enta qefiya girsay oletanaw gaallabiya paranne para gaariya girsaa mela.<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="JOL 2:5">Iyyu 2:5</ref>.</char></note> <verse eid="REV 9:9"/><verse number="10" style="v" sid="REV 9:10"/>Entaw korne goyna daaniya goyninne dukiya yiishshi de7ees. He goynan ichashu ageena asaa qohana mela maati imetis. <verse eid="REV 9:10"/><verse number="11" style="v" sid="REV 9:11"/>Entana haariya kawoy de7ees; he kawoy olla kiitanchuwa. Iya sunthay Ibraawetho doonan Abdoona; qassi Girike doonan Apholiyoona geetetees. Iya sunthaa birshethay “Dhayseysa” guussu.<verse eid="REV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12"/>Koyro ayyey aadhis; Heko, buroo hara nam7u ayyeti eeson hanana.<verse eid="REV 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13"/>Usupuntho kiitanchoy ba moyziya punnis. Xoossaa sinthan eqida, worqa yarsho bessan de7iya oyddu kacetape issi girsi si7as.<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="EXO 30:1">Kessa 30:1</ref>.</char></note> <verse eid="REV 9:13"/><verse number="14" style="v" sid="REV 9:14"/>He girsay moyze oykida usupuntho kiitanchuwako, “Efraxiisa geetetiya gita shaafan qashetida oyddu kiitanchota birsha” yaagis. <verse eid="REV 9:14"/><verse number="15" style="v" sid="REV 9:15"/>Biitta bolla de7iya asaape sikuwa wodhana mela he saatiyas, he gallasaas, he ageenasinne he laythas giigidi uttida oyddu kiitanchoti birshetidosona. <verse eid="REV 9:15"/><verse number="16" style="v" sid="REV 9:16"/>Ola para toggiya olanchota paydoy daro xeetu miloone gideysa si7as.<verse eid="REV 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 9:17"/>Qassi ta qoncethan paratanne he parata toggida asaa be7as. He asay tiran wothiya birata xururey tama bonqo mela zo7o, yaakinte mela, kareetha kaalose melanne diinne mela ciliilo. Parata huuphey gaammo huuphe mela; enta doonape tami, cuyinne diinney keyis. <verse eid="REV 9:17"/><verse number="18" style="v" sid="REV 9:18"/>Parata doonape keyida taman, cuyaninne diinniyan he heedzu gadotan sa7an de7iya asaape sikoy hayqis. <verse eid="REV 9:18"/><verse number="19" style="v" sid="REV 9:19"/>He parata wolqay enta doona giddoninne goynan de7ees. Enta goynayka shoosha huuphe mela; enti iyara asaa qohoosona.<verse eid="REV 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20"/>Ha gadotape attidaysati banta kushe oosuwape simmibokona. Enti tuna ayyaanan worqafe, birape, naase biratapenne shuchafe oosetida eeqas goyinnoosona.<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="PSA 115:4">Maz 115:4</ref>.</char></note> Xeellanaw, si7anaw, hemetanaw danda7onna eeqatas goyinneysa aggibokona. <verse eid="REV 9:20"/><verse number="21" style="v" sid="REV 9:21"/>Asay wodheysa, biteysa, laymateysanne kayseysa aggidi maarota oychibookona.<verse eid="REV 9:21"/></para>
  <chapter eid="REV 9"/>
  <chapter number="10" style="c" sid="REV 10"/>
  <para style="s1">Kiitanchonne Guutha Maxaafa</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1"/>Hessafe guye, ta hara wolqaama kiitanchoy salope sa7a wodhishin be7as. I shaara ma7is; iya huuphiya bolla zuulli de7ees. Iya som7oy awa mela; iya tohoy tama tuussa mela. <verse eid="REV 10:1"/><verse number="2" style="v" sid="REV 10:2"/>He kiitanchoy dooya de7iya issi guutha xaatha maxaafaa ba kushen oykidi, ba ushacha tohuwa abba bolla, ba haddirsa tohuwa biitta bolla essis. <verse eid="REV 10:2"/><verse number="3" style="v" sid="REV 10:3"/>Gudiya gaammoda ba qaala dhoqu oothidi waassis. I waassida wode laapun dadati banta guuntha sissidosona.<verse eid="REV 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 10:4"/>Laapun dadati odetida wode ta xaafanaw giigetas. Shin salope, “Laapun dadati odidaysa maatamen gordafe attishin, xaafopa” giya girsaa si7as.<verse eid="REV 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5"/>Yaatidi, abba bollanne biitta bolla eqida, ta be7ida kiitanchoy, ba ushacha kushiya salo pude miccis.<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="EXO 20:11">Kessa 20:11</ref>; <ref loc="DEU 32:40">Zaare 32:40</ref>; <ref loc="DAN 12:7">Daane 12:7</ref>; <ref loc="AMO 3:7">Amo 3:7</ref>.</char></note> <verse eid="REV 10:5"/><verse number="6" style="v" sid="REV 10:6"/>I miccidi saloninne iya giddon de7iya ubbaa, sa7aninne iya giddon de7iya ubbaa, abbanne iya giddon de7iya ubbaa medhida, merinaw de7iya Xoossaa sunthan caaqidi, “Hizape guye, Xoossay gam7enna. <verse eid="REV 10:6"/><verse number="7" style="v" sid="REV 10:7"/>Shin laapuntha kiitanchoy ba moyziya punniya wode Xoossay ba aylle gidida nabeta baggara qoncisida xuura qofay poletana” yaagis.<verse eid="REV 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8"/>Hessafe guye, abba bollanne biitta bolla eqidi, “Iya kushen dooyetidi de7iya xaatha maxaafaa kiitanchuwa kushepe eka” yaagidi nam7antho taw odishin si7as.<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="EZK 2:8-3:3">Hiz 2:8—3:3</ref>.</char></note><verse eid="REV 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9"/>Taani he kiitanchuwako bada, guutha xaatha maxaafaa imma gada oychas. I taako, “Ekada ma; I ne ulon cammana, shin ne doonan eessada mal7ana” yaagis.<verse eid="REV 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10"/>Taani kiitanchuwa kushepe he guutha xaatha maxaafaa ekada mas; ta doonan eessada mal7is, shin ta ulon cammis. <verse eid="REV 10:10"/><verse number="11" style="v" sid="REV 10:11"/>Hessafe guye, taako, “Neeni yara ubbaas, dere ubbaas, dumma dumma doonan odeteysatasinne kawotas tinbite zaara odanaw bessees” yaagis.<verse eid="REV 10:11"/></para>
  <chapter eid="REV 10"/>
  <chapter number="11" style="c" sid="REV 11"/>
  <para style="s1">Nam7u Markata</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1"/>Hessafe guye, taw wadha xam7a immidi, “Bada xoossa keethaanne yarsho bessa wadha; yan goyinniya asataka payda.<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="EZK 40:3">Hiz 40:3</ref>; <ref loc="ZEC 2:1">Zaka 2:1</ref>.</char></note> <verse eid="REV 11:1"/><verse number="2" style="v" sid="REV 11:2"/>Shin Xoossa Keetha kare dabaabay Ayhude gidonna asaas imetida gisho wadhonna aggaaga. Ayhude gidonna asay geeshsha katamaa oytamanne nam7u ageena haarana.<note caller="-" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="LUK 21:24">Luqa 21:24</ref>.</char></note> <verse eid="REV 11:2"/><verse number="3" style="v" sid="REV 11:3"/>Taani kayo ma7o ma7ida ta nam7u markata kiittana; enti 1,260 gallas tinbite odana” yaagis.<verse eid="REV 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4"/>He nam7u markati alamiya Godaa sinthan eqiya nam7u shamaho mithatanne nam7u xompe wothiya kocata.<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="ZEC 4:3">Zaka 4:3</ref>.</char></note> <verse eid="REV 11:4"/><verse number="5" style="v" sid="REV 11:5"/>Oonika enta qohanaw koyko enta doonape tami keyidi, enta morketa dhaysees. Enta qohanaw koyiya oonika hessada hayqana. <verse eid="REV 11:5"/><verse number="6" style="v" sid="REV 11:6"/>Enti tinbite odiya wode iri bukonna mela saluwa gordanaw entaw maati de7ees. Entaw haathe suuthi kessanaw, qassi enti koyida mela biitta dumma dumma gadon dhaysanaw entaw maati de7ees.<note caller="-" style="x"><char style="xo" closed="false">11:6 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 Kawo 17:1</ref>; <ref loc="EXO 7:17">Kessa 7:17</ref>.</char></note><verse eid="REV 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7"/>Enti banta markatethaa ongidaape guye, ollaafe keyiya do7ay entana olana. He do7ay enta xoonana; wodhana.<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="DAN 7:7">Daane 7:7</ref>; <ref loc="REV 13:5">Qon 13:5</ref>.</char></note> <verse eid="REV 11:7"/><verse number="8" style="v" sid="REV 11:8"/>Enta Goday masqaliya bolla kaqetida gita katamaa ogiya bolla enta ahay yegetana. He katamay leemison Soodome woyko Gibxe geetetidi xeegetees.<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="ISA 1:9">Isa 1:9</ref>.</char></note> <verse eid="REV 11:8"/><verse number="9" style="v" sid="REV 11:9"/>Qassi koche ubbaafe, yara ubbaafe, dumma dumma doonapenne kawotethi ubbaafe yida asay enta aha heedzu gallasinne bagga gakanaw be7ana. Enta ahay moogetonna mela asay diggana. <verse eid="REV 11:9"/><verse number="10" style="v" sid="REV 11:10"/>Ha nam7u nabeti sa7an de7iya asaa waaysida gisho asay enta hayquwan ufaytana. Banta ufaysaa bessanaw issoy issuwas imota immana.<verse eid="REV 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 11:11"/>Heedzu gallasinne baggafe guye, de7o ayyaanay Xoossaa matape yidi entan gelin, enti dendi eqidosona. Enta be7ida ubbay gita yashshi yayyidosona.<note caller="-" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="EZK 37:10">Hiz 37:10</ref>.</char></note> <verse eid="REV 11:11"/><verse number="12" style="v" sid="REV 11:12"/>Hessafe guye, he nam7u nabeti, “Haa pude keyite” giya qaala salope si7idosona. Enta morketi entana be7ishin, enti shaaran gelidi pude salo bidosona.<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="2KI 2:11">2 Kawo 2:11</ref>.</char></note><verse eid="REV 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 11:13"/>He saatiyan biittay wolqaama qaaxo qaaxin, katamaape tammantho kushey dhayis. Qassi biitta qaaxon laapun mukulu asay hayqis. Attida asay daro kokoridi babidi; salo Xoossaas boncho immidosona.<note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="REV 6:12">Qon 6:12</ref>; <ref loc="REV 16:18">16:18</ref>.</char></note><verse eid="REV 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14"/>Nam7antho ayyey aadhis, shin Heko heedzantho ayyey eeson yaana.<verse eid="REV 11:14"/></para>
  <para style="s1">Laapuntha Moyze</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15"/>Laapuntha kiitanchoy ba moyziya punnis. Salope, “Sa7aa kawotethay nu Godaasinne Kiristoosas gidis; I merinaape merinaa gakanaw haarana” giya wolqaama qaalay si7etis.<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="EXO 15:18">Kessa 15:18</ref>; <ref loc="DAN 2:44">Daane 2:44</ref>; <ref loc="DAN 7:14">7:14</ref>.</char></note> <verse eid="REV 11:15"/><verse number="16" style="v" sid="REV 11:16"/>Yaatin, Xoossaa sinthan, banta araatan uttida laatamanne oyddu cimati gufannidi, Xoossas goyinnidi,<verse eid="REV 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 11:17"/>“Ha77ika kaseka de7eyso,</para>
  <para style="q1" vid="REV 11:17">Godaw, Ubbaafe Wolqaama Xoossaw,</para>
  <para style="q2" vid="REV 11:17">neeni gita wolqaa oykadasa.</para>
  <para style="q1" vid="REV 11:17">Neeni haaranaw doomida gisho,</para>
  <para style="q2" vid="REV 11:17">nuuni nena galatoos.<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="EXO 3:14">Kessa 3:14</ref>.</char></note><verse eid="REV 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18"/>Ayhude gidonna asay hanqetidosona,</para>
  <para style="q2" vid="REV 11:18">shin ne hanqoy yis.<note caller="-" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="PSA 2:5">Maz 2:5</ref>; <ref loc="PSA 110:5">110:5</ref>; <ref loc="PSA 115:13">115:13</ref>.</char></note></para>
  <para style="q1" vid="REV 11:18">Hayqidaysata bolla ne pirdiya wodey gakis;</para>
  <para style="q2" vid="REV 11:18">neeni ne aylleta, nabetas</para>
  <para style="q2" vid="REV 11:18">geeshshatasinne ne sunthaas yayyeysatas,</para>
  <para style="q2" vid="REV 11:18">guuthatasinne gitatas, enta oosuwada immiya wodey gakis.</para>
  <para style="q1" vid="REV 11:18">Alamiya dhayseysata dhaysiya wodey yis”</para>
  <para style="m" vid="REV 11:18">yaagidosona.<verse eid="REV 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19"/>Salon de7iya Xoossa Keethay dooyetis; iya giddon Xoossaa caaqo Taabotey bentis. Qassi wol7anthi wol7amis, deshoy dechis; daday dhuuqis; biitti qaaxis; shachi bukis.<note caller="-" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="REV 8:5">Qon 8:5</ref>; <ref loc="REV 16:18">16:18</ref>, <ref loc="REV 16:21">21</ref>.</char></note><verse eid="REV 11:19"/></para>
  <chapter eid="REV 11"/>
  <chapter number="12" style="c" sid="REV 12"/>
  <para style="s1">Maccasiwunne Dawiya</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1"/>Hessafe guye, salon wolqaama malaati bentis. Awa ma7ada, ageena bolla eqada, tammanne nam7u xoolinto kallacha ba huuphen wothida de7iya, issi maccasiya bentasu. <verse eid="REV 12:1"/><verse number="2" style="v" sid="REV 12:2"/>He maccasiya qanthe; shin iyo iqethi oykin un7etada waassasu.<verse eid="REV 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3"/>Qassi hara malaati salon bentis. Laapun huuphetinne tammu kaceti de7iya gita zo7o dawey bentis. I ba huupheta bolla laapun kallacha wothis.<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="DAN 7:7">Daane 7:7</ref>.</char></note> <verse eid="REV 12:3"/><verse number="4" style="v" sid="REV 12:4"/>He dawey ba goynan xoolintotape sikuwa salope dafidi sa7an yeggis. He dawey na7ay yeleti wodhida mela mittanaw koyidi, yelanaw eqetiya maccase sinthan eqis.<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="DAN 8:10">Daane 8:10</ref>.</char></note><verse eid="REV 12:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 12:5"/>He maccasiya kawotethaa ubbaa birata xam7an haaranaw de7iya adde na7a yelasu. Na7ay Xoossaakonne iya araatako pude eketis.<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="ISA 66:7">Isa 66:7</ref>; <ref loc="PSA 2:9">Maz 2:9</ref>.</char></note> <verse eid="REV 12:5"/><verse number="6" style="v" sid="REV 12:6"/>Maccasiya 1,260 gallas gakanaw iyo naagana mela Xoossay iw giigisi wothida bessaa mela biitta baqatasu.<verse eid="REV 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7"/>Salon oli medhetis. Mika7eeli ba kiitanchotara dawiyara oletis; dawey ba kiitanchotara gididi zaari oletis.<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="DAN 10:13">Daane 10:13</ref>.</char></note> <verse eid="REV 12:7"/><verse number="8" style="v" sid="REV 12:8"/>Shin dawey xoonetidi salon entaw de7iya bessi dhayidosona. <verse eid="REV 12:8"/><verse number="9" style="v" sid="REV 12:9"/>Gita dawey, beni shooshay, sa7an yegetis. Ika Daabuloosa woyko Xalahe geetetiya alamiya baletheysa. I ba kiitanchotara issife duge alamiya yegetis.<note caller="-" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="GEN 3:1">Medhe 3:1</ref>; <ref loc="LUK 10:18">Luqa 10:18</ref>.</char></note><verse eid="REV 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10"/>Hessafe guye, salon haysada giya qaala si7as.</para>
  <para style="q1" vid="REV 12:10">“Ha77i atotethay, wolqaynne kawotethay, nu Xoossasa;</para>
  <para style="q2" vid="REV 12:10">maatay Kiristoosas gidis.</para>
  <para style="q1" vid="REV 12:10">Hiza, qammanne gallas Xoossaa sinthan,</para>
  <para style="q2" vid="REV 12:10">nu ishata mooteysi salope duge holetis.<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="JOB 1:9">Iyyo 1:9</ref>.</char></note><verse eid="REV 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 12:11"/>Enti dorsa suuthaaninne banta markatethaa qaalan,</para>
  <para style="q2" vid="REV 12:11">iya olidi xoonidosona.</para>
  <para style="q1" vid="REV 12:11">Enti banta shempuwas mishetonna</para>
  <para style="q2" vid="REV 12:11">bantana hayqos aathidi immidosona.<verse eid="REV 12:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 12:12"/>Hessa gisho, saloninne iya giddon de7eysato ufaytite.</para>
  <para style="q2" vid="REV 12:12">Shin biittanne abba ayye!</para>
  <para style="q1" vid="REV 12:12">Hiza, Xalahey baw guutha wodey attidaysa erida gisho,</para>
  <para style="q2" vid="REV 12:12">wolqaama hanqon hinteko wodhis”</para>
  <para style="m" vid="REV 12:12">yaagis.<verse eid="REV 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13"/>Qassi dawey bana sa7a yeggidaysa be7ida wode adde na7a yelida maccasiw goodis. <verse eid="REV 12:13"/><verse number="14" style="v" sid="REV 12:14"/>Maccasiw shooshay qohonna mela heedzu laythinne bagga mashenne uyashe iya naagetiya bessi mela biitta piradhada baana mela nam7u wolqaama argantha qefey iw imetis.<note caller="-" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="DAN 7:25">Daane 7:25</ref>; <ref loc="DAN 12:7">12:7</ref>.</char></note><verse eid="REV 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 12:15"/>Yaatidi, maccasiw di7oy di77idi efana mela dawey shaafa haatha mela ba doonape maccase guyera cooyis. <verse eid="REV 12:15"/><verse number="16" style="v" sid="REV 12:16"/>Shin biittay maccasiw maaddis; biittay ba doona dooyidi dawiya doonape keyida haatha mittis. <verse eid="REV 12:16"/><verse number="17" style="v" sid="REV 12:17"/>He dawey maccase bolla daro hanqetidi, I kochata, Xoossaa kiitaa naageysatanne Yesuusi qoncisida tumaas ammanetidaysata olanaw bidi. <verse eid="REV 12:17"/><verse number="18" style="v" sid="REV 12:18"/>Abba gaxan de7iya shafiyan eqis.<verse eid="REV 12:18"/></para>
  <chapter eid="REV 12"/>
  <chapter number="13" style="c" sid="REV 13"/>
  <para style="s1">Nam7u Do7ata</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1"/>Hessafe guye, issi do7ay abbaafe keyishin be7as. Iyaw tammu kaceynne laapun huuphey de7ees. He tammu kaceta bolla tammu kallachati de7oosona. He huupheta bolla Xoossaa cashsha sunthati xaafetidi uttis.<note caller="-" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="DAN 7:3">Daane 7:3</ref>; <ref loc="REV 17:3">Qon 17:3</ref>.</char></note> <verse eid="REV 13:1"/><verse number="2" style="v" sid="REV 13:2"/>Ta be7ida do7ay maahe daanees; iya tohoy babantha toho mela; iya doonayka gaammo doona daanees. Dawey ba wolqaa, ba araatanne ba gita maata he do7aas immis.<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="DAN 7:4">Daane 7:4</ref>.</char></note><verse eid="REV 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 13:3"/>He do7aa huuphiyape issuwa bolla hayqos gathiya madunthi be7as, shin he madunthay paxis. Alamiya asa ubbay malaaletidi he do7aa kaallis. <verse eid="REV 13:3"/><verse number="4" style="v" sid="REV 13:4"/>Dawey ba maata do7aas immida gisho asa ubbay dawiya goyinnidosona. Qassi asay, “Do7aa meli oonee? Iyara oletanaw danda7ey oonee?” yaagidi do7aas goyinnidosona.<verse eid="REV 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5"/>He do7aas otortana melanne cayana mela dooni imetis; oytamanne nam7u ageena haarana mela maati iyaw imetis.<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="DAN 7:8">Daane 7:8</ref>, <ref loc="DAN 7:25">25</ref>; <ref loc="DAN 11:36">11:36</ref>.</char></note> <verse eid="REV 13:5"/><verse number="6" style="v" sid="REV 13:6"/>He do7ay Xoossaa, iya sunthaa, I de7iya bessaanne salon de7iya ubbaa baadethi oykis. <verse eid="REV 13:6"/><verse number="7" style="v" sid="REV 13:7"/>He do7ay geeshshatara oletidi, entana xoonana mela wolqi iyaw imetis. Yara ubbaa, dere ubbaa, dumma dumma doona ubbaa bollanne koche ubbaa bolla maati iyaw imetis.<note caller="-" style="x"><char style="xo" closed="false">13:7 </char><char style="xt" closed="false"><ref loc="DAN 7:21">Daane 7:21</ref>.</char></note> <verse eid="REV 13:7"/><verse number="8" style="v" sid="REV 13:8"/>Alamey medhetoosape doomidi, shuketida Dorsaa de7o maxaafan enta sunthay xaafetonna ha sa7an de7iya asa ubbay he do7aas goyinnana.<note caller="-" style="x"><char style="xo" closed="false">13:8 </char><char style="xt" closed="false"><ref loc="PSA 69:28">Maz 69:28</ref>.</char></note><verse eid="REV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9"/>Si7iya haythi de7iya asi si7o. <verse eid="REV 13:9"/><verse number="10" style="v" sid="REV 13:10"/>Oonika di7etanaw de7ey di7etees. Mashshan hayqanaw de7ey mashshan shuketana. Hessanka geeshshata danda7aynne ammanoy eretana.<note caller="-" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="JER 15:2">Ermi 15:2</ref>; <ref loc="JER 43:11">43:11</ref>.</char></note><verse eid="REV 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11"/>Qassika, hara do7i sa7ape keyishin be7as. Iyaw dorsa kace daaniya nam7u kacey de7ees; iya oday dawe oda mela. <verse eid="REV 13:11"/><verse number="12" style="v" sid="REV 13:12"/>He do7ay koyro do7aa bessan, iya maatan oothees. Ika hayqos gathiya madunthaafe paxida koyro do7aas; biittan de7iya asa ubbay goyinnana mela oothees. <verse eid="REV 13:12"/><verse number="13" style="v" sid="REV 13:13"/>He nam7antho do7ay hari attoshin, tama salope asa ubbaa sinthan wodhisana gakanaw gita malaatata oothis. <verse eid="REV 13:13"/><verse number="14" style="v" sid="REV 13:14"/>Koyro do7aa bessan oothana mela, iyaw imetida malaatatan sa7an de7iya asa ubbaa I balethis. Mashshan madunxidi paxida do7aa bonchoos misile giigisana mela entana kiittis. <verse eid="REV 13:14"/><verse number="15" style="v" sid="REV 13:15"/>Nam7antho do7ay koyro do7aa misiliyas shempo immidi odetana melanne iyaw goyinnonaysati hayqana mela oothiya maati imetis.<verse eid="REV 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 13:16"/>He nam7antho do7ay gitinne guuthi, manqoynne durey, womaanoynne aylley ba ushacha kushen woyko ba som7on malla wothana mela oothis. <verse eid="REV 13:16"/><verse number="17" style="v" sid="REV 13:17"/>He do7aa sunthay woyko iya sunthaa payduwa mallay bayna asi oonika bayzanawunne shammanaw danda7enna.<verse eid="REV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18"/>Cincatethi koshshey hessana. Eratethi de7iya oonika he do7aa payduwa birshethaa ero; he paydoy asa sunthi. He paydoy usupun xeetanne usupun tammanne usupuna.<verse eid="REV 13:18"/></para>
  <chapter eid="REV 13"/>
  <chapter number="14" style="c" sid="REV 14"/>
  <para style="s1">Dorsanne 144,000 Asata</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1"/>Hessafe guye, Dorsay Xiyoone zuma bolla eqidaysa be7as. Iyara iya sunthaynne iya Aawa sunthay enta som7on xaafetida, 144,000 asay de7ees.<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EZK 9:4">Hiz 9:4</ref>; <ref loc="REV 7:3">Qon 7:3</ref>.</char></note> <verse eid="REV 14:1"/><verse number="2" style="v" sid="REV 14:2"/>Salope gita haatha guunthunne dada guunthu daaniya wolqaama girsi si7as. Qassi ta si7ida girsay diithi diixishin si7etiya girsaa mela. <verse eid="REV 14:2"/><verse number="3" style="v" sid="REV 14:3"/>144,000 asay araata sinthan, oyddu de7on de7iya medhetethata sinthaninne cimata sinthan eqidi entafe hara oonika tamaaranaw danda7onna ooratha mazmure yexidosona. <verse eid="REV 14:3"/><verse number="4" style="v" sid="REV 14:4"/>Haysati maccasara bantana tunisonna naagida geeshshata. Enti dorsay biya bessi ubbaa kaalloosona. Enti Xoossaasinne Dorsaas bayra gididi, shiiqanaw sa7a asaa giddofe wozetidosona. <verse eid="REV 14:4"/><verse number="5" style="v" sid="REV 14:5"/>Enti wordoynne borey bayna asata.<note caller="-" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="ZEP 3:13">Sofo 3:13</ref>.</char></note><verse eid="REV 14:5"/></para>
  <para style="s1">Heedzu Kiitanchota</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6"/>Hessafe guye, merinaa Wongela sa7a bolla de7iya kawotethaa ubbaas, koche ubbaas, yara ubbaasinne dumma dumma doona ubbaas markatanaw salora piradhiya hara kiitancho be7as. <verse eid="REV 14:6"/><verse number="7" style="v" sid="REV 14:7"/>He kiitanchoy ba qaala dhoqu oothidi, “Xoossay alamiya pirdiya saatey gakida gisho Xoossaas yayyite; iya bonchite. Salo, sa7aa, abbanne pulto haatha medhida Xoossaa goyinnite” yaagis.<verse eid="REV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8"/>Koyroysa kaallidi hara nam7antho kiitanchoy, “Dere ubbaa tunanne mathoyiya woyne ushshida, gita Babilooney kundasu! Kundasu!” yaagidi waassis.<note caller="-" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="ISA 21:9">Isa 21:9</ref>; <ref loc="JER 51:8">Ermi 51:8</ref>; <ref loc="REV 18:2">Qon 18:2</ref>.</char></note><verse eid="REV 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9"/>Heedzantho kiitanchoy enta kaallidi, ba qaala dhoqu oothidi, “Do7aanne iya misiliya goyinniya qassi iya malla ba som7on woyko ba kushen wothiya oonika de7iko, <verse eid="REV 14:9"/><verse number="10" style="v" sid="REV 14:10"/>iya hanqo xuu7an kumida Xoossaa hanqo woyniya uyana. Enti geeshsha kiitanchota sinthaninne Dorsa sinthan eexiya diinne taman waayetana.<note caller="-" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="ISA 51:17">Isa 51:17</ref>; <ref loc="GEN 19:24">Medhe 19:24</ref>; <ref loc="EZK 38:22">Hiz 38:22</ref>.</char></note> <verse eid="REV 14:10"/><verse number="11" style="v" sid="REV 14:11"/>Enta waayiya cuyay meri merinaw cuyishe daana. Do7aanne iya misiliya goyinney qassi he do7aa suntha mallay de7iya oonika qammanne gallas shempoy bayna kaa7etana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="ISA 34:10">Isa 34:10</ref>.</char></note><verse eid="REV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12"/>Xoossaa kiitaa naageysatinne Yesuusa ammaneteysati genciya minotethay qonciya wodey hessa.<verse eid="REV 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13"/>Hessafe guye, “Hizape Godan hayqeysati anjetidaysata” giya qaala salope si7as.</para>
  <para style="p" vid="REV 14:13">Ayyaanay, “Ee tuma, enta oosoy enta kaalliya gisho, enti banta daaburaape shempana” yaagees.<verse eid="REV 14:13"/></para>
  <para style="s1">Kathi Shiisho Wode</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14"/>Hessafe guye, bootha shaara bolla uttida Asa Na7a daaneysa be7as. I ba huuphen worqa kallacha wothis; qassi ba kushen baaca oykis.<note caller="-" style="x"><char style="xo" closed="false">14:14 </char><char style="xt" closed="false"><ref loc="DAN 7:13-14">Daane 7:13-14</ref>.</char></note> <verse eid="REV 14:14"/><verse number="15" style="v" sid="REV 14:15"/>Hara kiitanchoy Xoossa keethafe keyidi, shaara bolla uttidaysako ba qaala dhoqu oothidi, “Kathaa shiisho wodey gakida gisho ne baaca yeddada kathaa caka; sa7an de7iya kathay gakis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">14:15 </char><char style="xt" closed="false"><ref loc="JOL 3:13">Iyyu 3:13</ref>.</char></note> <verse eid="REV 14:15"/><verse number="16" style="v" sid="REV 14:16"/>Yaatin shaara bolla uttidaysi ba baaca sa7a yeddidi, sa7an de7iya kathaa cakis.<verse eid="REV 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17"/>Qassika salon de7iya Xoossa keethafe hara kiitanchoy keyis; iyawuka oco baaci de7ees.<verse eid="REV 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18"/>Tama bolla maati de7iya hara kiitanchoy yarsho bessaafe keyis. I ba qaala dhoqu oothidi oco baaca oykida kiitanchuwako, “Woyne ayfey teerida gisho neeni oco baaca yeddada, sa7an de7iya woyniyape qanxa” yaagis. <verse eid="REV 14:18"/><verse number="19" style="v" sid="REV 14:19"/>He kiitanchoy ba baaca yeddidi, sa7an de7iya woyniyape qanxidi, Xoossaa gita hanquwa gum7iya bessan yeggis. <verse eid="REV 14:19"/><verse number="20" style="v" sid="REV 14:20"/>Enti Katamaape gaxan de7iya woyne ayfe gum7iya bessan yedhetidosona. Suuthi woyne gum7iya bessaafe keyidi issi mukulunne usupun xeetu kilo mitire mela haakidi, para puulo gakidi, dhoqu gidi eellis.<note caller="-" style="x"><char style="xo" closed="false">14:20 </char><char style="xt" closed="false"><ref loc="ISA 63:3">Isa 63:3</ref>; <ref loc="LAM 1:15">Mila 1:15</ref>; <ref loc="REV 19:15">Qon 19:15</ref>.</char></note><verse eid="REV 14:20"/></para>
  <chapter eid="REV 14"/>
  <chapter number="15" style="c" sid="REV 15"/>
  <para style="s1">Wursetha Boshata</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1"/>Taani salon hara gitanne malaalsiya malaata be7as. Xoossaa wursetha hanquwa qoncisiya laapun boshata oykida laapun kiitanchoti de7oosona.<verse eid="REV 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2"/>Qassi tamara walaketida burcuko abba daaneysa be7as. He abba gaxan do7aa, iya misiliyanne iya sunthaa taybuwa xoonidaysata be7as. Xoossay entaw immida diithaa oykidi eqidosona. <verse eid="REV 15:2"/><verse number="3" style="v" sid="REV 15:3"/>Enti Xoossaa aylliya Muse mazmuriyanne Dorsa mazmuriya haysada yaagidi yexoosona.</para>
  <para style="q1" vid="REV 15:3">“Godaw, Ubbaafe Wolqaama Xoossaw,</para>
  <para style="q2" vid="REV 15:3">ne oosoy gitanne malaalsiyaba.</para>
  <para style="q1" vid="REV 15:3">Dere ubbaa kawaw,</para>
  <para style="q2" vid="REV 15:3">ne ogey xillonne tuma.<note caller="-" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="EXO 15:1">Kessa 15:1</ref>.</char></note><verse eid="REV 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4"/>Geeshshi ne xalaala gidiya gisho,</para>
  <para style="q2" vid="REV 15:4">Godaw, new yayyonnaynne</para>
  <para style="q2" vid="REV 15:4">ne sunthaa bonchonay oonee?</para>
  <para style="q1" vid="REV 15:4">Ne xillo oosoy asa ubbaas qonce gidiya gisho,</para>
  <para style="q2" vid="REV 15:4">kawotethi ubbay ne sinthe yidi goyinnana”</para>
  <para style="m" vid="REV 15:4">yaagidi yexoosona.<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="JER 10:7">Ermi 10:7</ref>; <ref loc="PSA 86:9">Maz 86:9</ref>.</char></note><verse eid="REV 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5"/>Hessafe guye, salon dooyetidi de7iya Xoossa Keethaa, ika Markatetha Dunkaaniya be7as.<note caller="-" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="EXO 38:21">Kessa 38:21</ref>.</char></note> <verse eid="REV 15:5"/><verse number="6" style="v" sid="REV 15:6"/>Laapun boshata oykida laapun kiitanchoti Xoossa keethafe keyidosona. Enti geeshshinne phooliya liino ma7o ma7idosona; banta tiran worqa danco dancidosona. <verse eid="REV 15:6"/><verse number="7" style="v" sid="REV 15:7"/>Oyddu medhetethatape issoy, merinaw de7iya Xoossaa hanqoy kumida laapun worqa xuu7ata laapun kiitanchotas immis. <verse eid="REV 15:7"/><verse number="8" style="v" sid="REV 15:8"/>Xoossaa bonchuwafenne iya wolqaafe dendoysan Xoossa Keethay cuyan kumis. Laapun kiitanchoti oykida laapun boshati poletana gakanaw Xoossa Keetha oonika gelanaw danda7ibeenna.<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="EXO 40:34">Kessa 40:34</ref>; <ref loc="1KI 8:10">1 Kawo 8:10</ref>.</char></note><verse eid="REV 15:8"/></para>
  <chapter eid="REV 15"/>
  <chapter number="16" style="c" sid="REV 16"/>
  <para style="s1">Xoossa Hanqoy Kumida Xuu7ata</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1"/>Hessafe guye, Xoossa keethafe laapun kiitanchotako, “Bidi Xoossaa hanquwa laapun xuu7atape sa7an gussite” yaagidi, odiya wolqaama qaala si7as.<verse eid="REV 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2"/>Koyro kiitanchoy bidi, ba xuu7an de7eysa sa7an gussin, do7aa mallay de7eyisata bollanne iya misiliya goyinnidaysata bolla iitanne zaamiya madunthi keyis.<note caller="-" style="x"><char style="xo" closed="false">16:2 </char><char style="xt" closed="false"><ref loc="EXO 9:10">Kessa 9:10</ref>.</char></note><verse eid="REV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3"/>Nam7antho kiitanchoy ba xuu7an de7eysa abban gussin, abbay hayqida asa suuthi daanis. Qassi abban de7iya medhetetha ubbay hayqis.<verse eid="REV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4"/>Heedzantho kiitanchoy ba xuu7an de7eysa shaafataninne pulto haathatan gussin, haathati suuthi gididosona.<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="EXO 7:17">Kessa 7:17</ref>.</char></note> <verse eid="REV 16:4"/><verse number="5" style="v" sid="REV 16:5"/>Hessafe guye, haatha bolla maati de7iya kiitanchoy haysada yaagishin si7as.</para>
  <para style="q1" vid="REV 16:5">“Ha77ika benika de7iya geeshshaw,<note caller="-" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="EXO 3:14">Kessa 3:14</ref>.</char></note></para>
  <para style="q2" vid="REV 16:5">haysada ne pirdida gisho neeni xillo.<verse eid="REV 16:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 16:6"/>Enti geeshshata suuthaanne nabeta suuthaa gussida gisho,</para>
  <para style="q2" vid="REV 16:6">enti suuthu uyana mela oothadasa.</para>
  <para style="q1" vid="REV 16:6">Enti bantaw bessiyaba ekidosona”</para>
  <para style="m" vid="REV 16:6">yaagis. <verse eid="REV 16:6"/><verse number="7" style="v" sid="REV 16:7"/>Yarsho bessaafe,</para>
  <para style="q1" vid="REV 16:7">“Godaw, Ubbaafe Wolqaama Xoossaw,</para>
  <para style="q2" vid="REV 16:7">ne pirday tumanne xillo”</para>
  <para style="m" vid="REV 16:7">giya qaala si7as.<verse eid="REV 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8"/>Oyddantho kiitanchoy ba xuu7an de7eysa awa bolla gussin, away ba seelan asaa xuuggana mela awas wolqi imetis. <verse eid="REV 16:8"/><verse number="9" style="v" sid="REV 16:9"/>Asay wolqaama seelan xuugetidi, he boshata bolla maati de7iya Xoossaa sunthaa baaddidosona; banta nagaraape simmidi Xoossaa bonchibookona.<verse eid="REV 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10"/>Ichashantho kiitanchoy ba xuu7an de7eysa do7aa araata bolla gussin, he do7aa kawotethay dhumis. Asay un7aa gisho, banta inxarsaa saxoosona.<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="EXO 10:21">Kessa 10:21</ref>.</char></note> <verse eid="REV 16:10"/><verse number="11" style="v" sid="REV 16:11"/>Qassi asay un7aa gishonne madunthaa gisho, salo Xoossaa baaddidosona; banta oothida nagaraape simmibokona.<verse eid="REV 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12"/>Usupuntho kiitanchoy ba xuu7an de7eysa gita Efraxiisa shaafan gussin, doloha baggafe yaana kawotas ogey giigana mela haathay melis.<note caller="-" style="x"><char style="xo" closed="false">16:12 </char><char style="xt" closed="false"><ref loc="ISA 11:15">Isa 11:15</ref>.</char></note> <verse eid="REV 16:12"/><verse number="13" style="v" sid="REV 16:13"/>Hessafe guye, shodhe daaniya heedzu tuna ayyaanati dawiya doonape, do7aa doonapenne wordo nabiya doonape keyishin be7as. <verse eid="REV 16:13"/><verse number="14" style="v" sid="REV 16:14"/>Enti malaatata oothiya tuna ayyaanata. He heedzu tuna ayyaanati Ubbaafe Wolqaama Xoossaa gita gallasan hananaw de7iya olas shiishanaw alame kawota ubbaako baana.<verse eid="REV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15"/>“Heko, ta kaysoda yaana! Asa sinthan kallotonaadanne yeellatonnaada barkidi, ba ma7uwa naagiya uray anjetidaysa!” yaagis.<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="MAT 24:43">Maato 24:43</ref>.</char></note><verse eid="REV 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16"/>He tuna ayyaanati kawota Ibraawetho doonan Armagedoone geetetiya bessan shiishidosona.<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="2KI 23:29">2 Kawo 23:29</ref>; <ref loc="ZEC 12:11">Zaka 12:11</ref>.</char></note><verse eid="REV 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17"/>Laapuntha kiitanchoy ba xuu7an de7eysa carko bolla gussin, xoossa keethan de7iya araatape, “Poletis” giya wolqaama qaalay yis. <verse eid="REV 16:17"/><verse number="18" style="v" sid="REV 16:18"/>Hessafe wol7anthi wol7amis; daday dhuuqis, biittay qaaxis. Asi sa7an medhetoosape biitti hessa mela qaaxo qaaxibeenna. Hessi ubbaafe aadhida qaaxo.<note caller="-" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="REV 8:5">Qon 8:5</ref>; <ref loc="REV 11:13">11:13</ref>.</char></note> <verse eid="REV 16:18"/><verse number="19" style="v" sid="REV 16:19"/>Gita katamay heedza keyidi shaaketis; biitta ubban de7iya katamati dhaydosona. Xoossay gita katamaa Babiloone qopidi, ba iita hanqo woyne ushshay kumida xuu7aa iw immis.<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ISA 51:17">Isa 51:17</ref>.</char></note> <verse eid="REV 16:19"/><verse number="20" style="v" sid="REV 16:20"/>Yuushoy abban teqetida biittati dhaydosona; deretika bentibookona.<note caller="-" style="x"><char style="xo" closed="false">16:20 </char><char style="xt" closed="false"><ref loc="REV 6:14">Qon 6:14</ref>.</char></note> <verse eid="REV 16:20"/><verse number="21" style="v" sid="REV 16:21"/>Asaa bolla oytamanne ichashu kilo giraame mela deexiya wolqaama shachi salope bukis. Boshay daro iita gidiya gisho asay shacha bosha gisho Xoossaa baaddidosona.<note caller="-" style="x"><char style="xo" closed="false">16:21 </char><char style="xt" closed="false"><ref loc="EXO 9:23">Kessa 9:23</ref>.</char></note><verse eid="REV 16:21"/></para>
  <chapter eid="REV 16"/>
  <chapter number="17" style="c" sid="REV 17"/>
  <para style="s1">Gita Layma Maccasiw</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1"/>Laapun xuu7ata oykida laapun kiitanchotape issoy taako yidi, “Haaya; daro haathata bolla uttida gita laymatiya maccase bolla yaanaw de7iya pirdaa ta nena bessaana.<note caller="-" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="JER 51:13">Ermi 51:13</ref>.</char></note> <verse eid="REV 17:1"/><verse number="2" style="v" sid="REV 17:2"/>Alamiya kawoti iira laymatidosona; alamen de7iya asayka I laymatetha woyniya uyidi mathotidosona” yaagis.<note caller="-" style="x"><char style="xo" closed="false">17:2 </char><char style="xt" closed="false"><ref loc="ISA 23:17">Isa 23:17</ref>; <ref loc="JER 51:7">Ermi 51:7</ref>.</char></note><verse eid="REV 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3"/>He kiitanchoy tana Geeshsha Ayyaanan mela biitta efis. Yan issi maccasiya cashsha sunthay I bolla ubban xaafetidi uttida, zo7o do7aa toggidaaro be7as; he do7aas laapun huupheynne tammu kacey de7ees.<note caller="-" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="REV 13:1">Qon 13:1</ref>.</char></note> <verse eid="REV 17:3"/><verse number="4" style="v" sid="REV 17:4"/>He maccasiya kaalose ma7onne zo7o ma7o ma7asu; iya worqan, boncho shuchaninne inqo geetetiya al7o shuchan alleeqetasu. Iya ba kushen borsiyabaanne laymatetha tunatethan kumida worqa xuu7a oykasu.<note caller="-" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="JER 51:7">Ermi 51:7</ref>.</char></note> <verse eid="REV 17:4"/><verse number="5" style="v" sid="REV 17:5"/>I som7on xuura ooso birshethay de7iya sunthay, “Gita Babilooney, laymatethasinne sa7an de7iya tunabaa ubbaas aayo” giya xuufey xaafetidi uttis. <verse eid="REV 17:5"/><verse number="6" style="v" sid="REV 17:6"/>Qassi he maccasiya geeshshata suuthaanne Yesuusas markatishe hayqidaysata suuthaa uyada mathotidaaro ta be7ada malaaletas.<verse eid="REV 17:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 17:7"/>Kiitanchoy taako, “Neeni ayis malaaletay? Taani new maccase xuura odaanne iya tookida laapun huupheynne tammu kacey de7iya do7aa xuura odaa odana. <verse eid="REV 17:7"/><verse number="8" style="v" sid="REV 17:8"/>Neeni be7ida do7ay koyro de7ees, shin ha77i baawa. He do7ay ciimmo ollafe keyidi dhayos baana. Sa7i medhetoosape doomidi, de7o maxaafan enta sunthay xaafetiboonna sa7an de7iya asay, do7aa be7idi malaaletana. Hiza, I kase de7ees; ha77i baawa, shin sinthafe yaana.<note caller="-" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="DAN 7:7">Daane 7:7</ref>; <ref loc="REV 11:7">Qon 11:7</ref>; <ref loc="PSA 69:28">Maz 69:28</ref>.</char></note><verse eid="REV 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9"/>“Haysi cincatethinne akeeka koyees. Laapun huupheti maccasiya uttiya laapun dereta; hessati qassi laapun kawota. <verse eid="REV 17:9"/><verse number="10" style="v" sid="REV 17:10"/>Entafe ichashu kawoti kundidosona. Issoy ha77i gakanaw haarees; hanko Kawoy yibeenna. I yidi guutha wode takanaw bessees. <verse eid="REV 17:10"/><verse number="11" style="v" sid="REV 17:11"/>Sinthe de7ida do7ay, ha77i baynaysi, I ba huuphen hospuntho do7aa. I laapun do7atape issuwa; I dhayanaw bees.<verse eid="REV 17:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12"/>“Neeni be7ida tammu kaceti haaro doomiboonna tammu kawota. Shin enti do7aara issife issi saate kawotidi haaranaw entaw maati imetana.<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="DAN 7:24">Daane 7:24</ref>.</char></note> <verse eid="REV 17:12"/><verse number="13" style="v" sid="REV 17:13"/>Enta ubbaas issi qofay de7ees; enti banta wolqaanne banta maata do7aas immana. <verse eid="REV 17:13"/><verse number="14" style="v" sid="REV 17:14"/>Enti Dorsaara oletana, shin dorsay godata Godaanne kawota Kawo gidiya gisho, I xeegidaysati, dooridaysatinne ammanetidaysati he kawota xoonana” yaagis.<verse eid="REV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15"/>Kiitanchoy qassika taako, “Laymatiyara uttida he neeni be7ida haathati yarata, kawotethata, zerethatanne dumma dumma doonan odeteyisata. <verse eid="REV 17:15"/><verse number="16" style="v" sid="REV 17:16"/>Qassi neeni be7ida tammu kaceynne do7ay laymatiyaro ixana. Enti iw de7iya ubbaba ekana. Qassi iyo kallo ashshananne I ashuwa midigana; yaatidi enti iyo taman xuuggana. <verse eid="REV 17:16"/><verse number="17" style="v" sid="REV 17:17"/>Hiza, Xoossaa qaalay poletana gakanaw enta qofay issino gidana mela enti banta aysiya wolqaa do7aas immanaadanne Xoossay qopidaysa enti oothanaada enta wozanan Xoossay amo wothis. <verse eid="REV 17:17"/><verse number="18" style="v" sid="REV 17:18"/>He neeni be7ida maccasiya sa7a kawota haariya gita katamiw” yaagis.<verse eid="REV 17:18"/></para>
  <chapter eid="REV 17"/>
  <chapter number="18" style="c" sid="REV 18"/>
  <para style="s1">Babiloone Kundethaa</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1"/>Yaatidi, gita maati de7iya hara kiitanchoy salope wodhishin ta be7as. He kiitanchuwa bonchoy sa7a poo7isis. <verse eid="REV 18:1"/><verse number="2" style="v" sid="REV 18:2"/>He kiitanchoy ba qaala dhoqu oothidi,</para>
  <para style="q1" vid="REV 18:2">“Iya kundasu! Gita Babilooney kundasu!</para>
  <para style="q2" vid="REV 18:2">Babilooney tuna ayyaanati aqiya bessi gidasu.</para>
  <para style="q1" vid="REV 18:2">Dumma dumma iitabatas keethe gidasu;</para>
  <para style="q2" vid="REV 18:2">tuna kafotinne do7ati shempiya bessi gidasu.<note caller="-" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="ISA 21:9">Isa 21:9</ref>; <ref loc="JER 51:8">Ermi 51:8</ref>; <ref loc="REV 14:8">Qon 14:8</ref>; <ref loc="ISA 13:21">Isa 13:21</ref>; <ref loc="JER 50:39">Ermi 50:39</ref>.</char></note><verse eid="REV 18:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="REV 18:3"/>Asa koche ubbaa ba laymatetha woyniya ushshasu.</para>
  <para style="q2" vid="REV 18:3">Sa7aa kawoti iira laymatidosona.</para>
  <para style="q1" vid="REV 18:3">I miikotethaafe dendoysan</para>
  <para style="q2" vid="REV 18:3">biittan de7iya zal7anchoti duretidosona”</para>
  <para style="m" vid="REV 18:3">yaagis.<note caller="-" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="ISA 23:17">Isa 23:17</ref>; <ref loc="JER 51:7">Ermi 51:7</ref>.</char></note><verse eid="REV 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4"/>Hessafe guye, ta salope haysada giya hara qaala si7as.</para>
  <para style="q1" vid="REV 18:4">“I nagaraa iira koxonna melanne,</para>
  <para style="q2" vid="REV 18:4">iya ekanaw de7iya seera hinte ekonna mela,</para>
  <para style="q2" vid="REV 18:4">ta deriyaw iipe keyite.<note caller="-" style="x"><char style="xo" closed="false">18:4 </char><char style="xt" closed="false"><ref loc="ISA 23:17">Isa 23:17</ref>; <ref loc="JER 51:7">Ermi 51:7</ref>.</char></note><verse eid="REV 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5"/>Hiza, I nagaray salo gakanaw dooretis.</para>
  <para style="q2" vid="REV 18:5">Xoossay I naaquwa akeekis.<note caller="-" style="x"><char style="xo" closed="false">18:5 </char><char style="xt" closed="false"><ref loc="GEN 18:20">Medhe 18:20</ref>.</char></note><verse eid="REV 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6"/>Iya immidaysa mela zaaridi iw immite.</para>
  <para style="q2" vid="REV 18:6">Iya oothida oosuwas nam7u kushe iw zaarite.</para>
  <para style="q2" vid="REV 18:6">Iya giigisida ushsha bolla hinte nam7u kushe mathoyiya ushsha I xuu7an kunthite.<note caller="-" style="x"><char style="xo" closed="false">18:6 </char><char style="xt" closed="false"><ref loc="PSA 137:8">Maz 137:8</ref>; <ref loc="JER 50:29">Ermi 50:29</ref>.</char></note><verse eid="REV 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7"/>Iya baw bonchetidaysadanne iw injetidaysa mela,</para>
  <para style="q2" vid="REV 18:7">iyo metoothitenne kayoyite.</para>
  <para style="q1" vid="REV 18:7">Iya ba wozanan,</para>
  <para style="q2" vid="REV 18:7">‘Taani kaweeda uttas; ta azini bayna maccas gidike;</para>
  <para style="q2" vid="REV 18:7">taani ubbaka kayotike’ yaagasu.<verse eid="REV 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8"/>Hessa gisho, bosha ubbay,</para>
  <para style="q2" vid="REV 18:8">hargey, kayoynne koshi iyo issi gallas oykana.</para>
  <para style="q1" vid="REV 18:8">Qassi iya taman xuugetana;</para>
  <para style="q2" vid="REV 18:8">ayis giiko, I bolla pirdiya Xoossay wolqaama”</para>
  <para style="m" vid="REV 18:8">yaagis.<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="ISA 47:7-9">Isa 47:7-9</ref>.</char></note><verse eid="REV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9"/>“Iira laymatidaysatinne I miikotethan de7ida, alamiya kawoti he katamiya xuugetin keyiya cuyaa be7ida wode iw waassidi yeekana.<note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="EZK 26:16-17">Hiz 26:16-17</ref>.</char></note> <verse eid="REV 18:9"/><verse number="10" style="v" sid="REV 18:10"/>Enti he katame waayiya be7idi yayyida gisho, haaki eqidi,</para>
  <para style="q1" vid="REV 18:10">“ ‘Ha gita katame! Wolqaama katame!</para>
  <para style="q2" vid="REV 18:10">Babiloone, nena ayye!</para>
  <para style="q1" vid="REV 18:10">Neeni issi saate giddon ne pirda ekadasa’ yaagana.<verse eid="REV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11"/>“Enta markabiya caana hizape shammiya asi bayna gisho, sa7an de7iya zal7anchoti he katamaas waassananne kayotana.<note caller="-" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="EZK 27:31">Hiz 27:31</ref>.</char></note> <verse eid="REV 18:11"/><verse number="12" style="v" sid="REV 18:12"/>Enta worqa, bira, boncho shuchu, al7o shucha, kaalose ma7o, liino ma7o, haare ma7o, zo7o ma7o, dumma dumma sawo mithi, dangarsa zaale, al7o mithi, naase birata, goole shuchu,<note caller="-" style="x"><char style="xo" closed="false">18:12 </char><char style="xt" closed="false"><ref loc="EZK 27:12-13">Hiz 27:12-13</ref>, <ref loc="EZK 27:22">22</ref>.</char></note> <verse eid="REV 18:12"/><verse number="13" style="v" sid="REV 18:13"/>qarafa, qimame, ixaane, karbe, shitto, woyne, zayte, lo77o dhiille, giste, mehe, dorse, para, para gaare, aylletanne hara asata shammiya oonika baawa.<verse eid="REV 18:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 18:14"/>“Zal7anchoti maccaseeko, ‘Neeni amotida lo77oba ubbay neepe dhayis. Ne aqoynne alleeqetidaba ubbay neepe haakis. Neeni zaarada enta ubbaa demmaka’ yaagidosona. <verse eid="REV 18:14"/><verse number="15" style="v" sid="REV 18:15"/>He kataman zal7idi duretida zal7anchoti I metuwa babidi iipe haakidi eqana. Enti yeekananne kayotana.<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="EZK 27:31">Hiz 27:31</ref>.</char></note> <verse eid="REV 18:15"/><verse number="16" style="v" sid="REV 18:16"/>Qassi,</para>
  <para style="q1" vid="REV 18:16">“ ‘Liino, kaalose ma7onne zo7o ma7o ma7ada,</para>
  <para style="q2" vid="REV 18:16">worqan, boncho shuchaninne inqo geetetiya al7o shuchan alleeqetida,</para>
  <para style="q2" vid="REV 18:16">he gita katamees ayye! <verse eid="REV 18:16"/><verse number="17" style="v" sid="REV 18:17"/>Haysa mela gita shalo ubbay issi saate giddon dhayis’ yaagidosona.</para>
  <para style="p" vid="REV 18:17">“Markabiya laagiya ubbay, markabiyan biya ubbay, markabiya bolla oothiya ubbaynne abban zal7iya ubbay haaki eqidosona.<note caller="-" style="x"><char style="xo" closed="false">18:17 </char><char style="xt" closed="false"><ref loc="ISA 23:14">Isa 23:14</ref>; <ref loc="EZK 27:26">Hiz 27:26</ref>.</char></note> <verse eid="REV 18:17"/><verse number="18" style="v" sid="REV 18:18"/>He katamiya xuugetin keyiya cuyaa be7ida wode, ‘Ha gita katamiw daaniya hara katami de7ishsha?’ yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="EZK 27:32">Hiz 27:32</ref>.</char></note> <verse eid="REV 18:18"/><verse number="19" style="v" sid="REV 18:19"/>Enti banta huuphen baana qolidi, waassidosonanne kayotidosona.</para>
  <para style="q1" vid="REV 18:19">“ ‘Abbaa bolla markabeti de7iya ubbay,</para>
  <para style="q2" vid="REV 18:19">I shaluwan duretida ubbay,</para>
  <para style="q2" vid="REV 18:19">he katamiya issi saaten dhayida gisho,</para>
  <para style="q2" vid="REV 18:19">ayye! Ayye!<verse eid="REV 18:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="REV 18:20"/>Saluwaw, I dhayuwan ufayta!</para>
  <para style="q2" vid="REV 18:20">Geeshshato, hawaareto, nabeto,</para>
  <para style="q1" vid="REV 18:20">Xoossay hinte gisho I bolla pirdida gisho ufaytite’ yaagidosona.”<note caller="-" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="EZK 27:30">Hiz 27:30</ref>; <ref loc="DEU 32:43">Zaare 32:43</ref>; <ref loc="JER 51:48">Ermi 51:48</ref>.</char></note><verse eid="REV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21"/>Yaatin, mino kiitanchoy woxa daaniya gita shuchu denthidi abban holishe, “Gita katamiya Babilooney wolqan holettada haysada kundana; iya hachife guye ubbaka bentuku.<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="JER 51:63">Ermi 51:63</ref>.</char></note> <verse eid="REV 18:21"/><verse number="22" style="v" sid="REV 18:22"/>Diithi diixeysatinne yexeysati, suusul7enne moyze punneysati, hizape guye ne giddon ubbaka si7etokona. Ay kocha zal7e zal7iya asika ne giddon bentenna. Woxa girsi hizape guye ne giddon si7etenna.<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="ISA 24:8">Isa 24:8</ref>; <ref loc="EZK 26:13">Hiz 26:13</ref>.</char></note><note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="JER 7:34">Ermi 7:34</ref>; <ref loc="JER 25:10">25:10</ref>.</char></note> <verse eid="REV 18:22"/><verse number="23" style="v" sid="REV 18:23"/>Xompe poo7oy zaaridi ne giddon poo7enna. Macho ekeysinne azina geliyari qaali hizape guye ne giddon si7etenna. Ne zal7anchoti biitta ubban eretida wolqaamata. Ne bitan kawotethata ubbaa cimmadasa” yaagis.<verse eid="REV 18:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24"/>Nabeta suuthay, geeshshata suuthaynne biitta bolla hayqida asa ubbaa suuthay I giddon bentida gisho Babilooney pirdetasu.<note caller="-" style="x"><char style="xo" closed="false">18:24 </char><char style="xt" closed="false"><ref loc="JER 51:49">Ermi 51:49</ref>.</char></note><verse eid="REV 18:24"/></para>
  <para style="b"/>
  <chapter eid="REV 18"/>
  <chapter number="19" style="c" sid="REV 19"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1"/>Yaatin, salon daro asay,</para>
  <para style="q1" vid="REV 19:1">“Xoossay galatetto!</para>
  <para style="q2" vid="REV 19:1">Atotethay, bonchoynne wolqay nu Xoossaas gido.<verse eid="REV 19:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="REV 19:2"/>Iya pirday tumanne xillo.</para>
  <para style="q2" vid="REV 19:2">Sa7aa tunisida iita laymiw Xoossay pirdis.</para>
  <para style="q1" vid="REV 19:2">Xoossay ba aylleta suuthaa iipe achis”</para>
  <para style="m" vid="REV 19:2">yaagishin si7as.<note caller="-" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="DEU 32:43">Zaare 32:43</ref>; <ref loc="2KI 9:7">2 Kawo 9:7</ref>.</char></note><verse eid="REV 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 19:3"/>He asay zaaridi banta qaala dhoqu oothidi,</para>
  <para style="q1" vid="REV 19:3">“Xoossa galati gako.</para>
  <para style="q2" vid="REV 19:3">He katamiya merinaw cuyashe daana”</para>
  <para style="m" vid="REV 19:3">yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">19:3 </char><char style="xt" closed="false"><ref loc="ISA 34:10">Isa 34:10</ref>.</char></note><verse eid="REV 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 19:4"/>Laatamanne oyddu cimatinne de7on de7iya oyddu medhetethati araatan uttida Xoossaas gufannidi,</para>
  <para style="q1" vid="REV 19:4">“Amin7i! Xoossa galati gako”</para>
  <para style="m" vid="REV 19:4">yaagidi goyinnidosona.<verse eid="REV 19:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5"/>Yaatin,</para>
  <para style="q1" vid="REV 19:5">“Xoossa aylleti,</para>
  <para style="q2" vid="REV 19:5">Xoosse yayiya guuthinne giti ubbay,</para>
  <para style="q2" vid="REV 19:5">nu Xoossaa galatite”</para>
  <para style="m" vid="REV 19:5">giya qaalay araatape keyis.<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="PSA 115:13">Maz 115:13</ref>.</char></note><verse eid="REV 19:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 19:6"/>Yaatin, daro asada wocamiya, wolqaama shaafada guummiya, dadada dechiya girsay,</para>
  <para style="q1" vid="REV 19:6">“Xoossaa galati gako;</para>
  <para style="q2" vid="REV 19:6">nu Goday, Ubbaafe Wolqaama Xoossay kawotis.<note caller="-" style="x"><char style="xo" closed="false">19:6 </char><char style="xt" closed="false"><ref loc="EZK 1:24">Hiz 1:24</ref>; <ref loc="PSA 93:1">Maz 93:1</ref>; <ref loc="PSA 97:1">97:1</ref>; <ref loc="PSA 99:1">99:1</ref>.</char></note><verse eid="REV 19:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 19:7"/>Dorsaa yaaganoy gakida gishonne iya geliyara giigida gisho,</para>
  <para style="q2" vid="REV 19:7">nu ufaytoos, galatoosinne Dorsaa bonchoos.<verse eid="REV 19:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 19:8"/>Gelos giigidaara phooliyanne geeshshi gidida</para>
  <para style="q2" vid="REV 19:8">liino ma7ana mela iw imetis”</para>
  <para style="m" vid="REV 19:8">yaagishin ta si7as. (Liino ma7oy geeshshata xillo ooso leemiso.)<verse eid="REV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9"/>Hessafe guye, kiitanchoy taako, “Dorsa yaagano xeegetidaysati anjetidaysata” gada xaafa. He kiitanchoy gujidi, “Haysi Xoossaa tuma qaala” yaagis.<note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 22:2">Maato 22:2</ref>.</char></note><verse eid="REV 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10"/>He wode ta iya goyinnanaw iya tohuwa bolla kundas. Shin I, “Hessa oothofa! Taani Yesuusaba markatiya ne melanne ne ishata mela. Ne Xoossaa goyinna” yaagis. Hiza, Yesuusaba markatidaysatas nabetetha ayyaani de7ees.<verse eid="REV 19:10"/></para>
  <para style="s1">Bootha Para Toggidaysa</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11"/>Yaatin, saloy dooyetin, yan bootha pari de7eysa be7as. He para toggidaysi Ammanetidaysanne Tumancho geetetees. I xillotethan pirdesinne oletees.<note caller="-" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="EZK 1:1">Hiz 1:1</ref>.</char></note> <verse eid="REV 19:11"/><verse number="12" style="v" sid="REV 19:12"/>Iya ayfey tama laco daanees; iya huuphen daro kallachi de7ees. Iya bolla I attishin, hari oonika eronna xaafetida sunthi de7ees.<note caller="-" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="DAN 10:6">Daane 10:6</ref>.</char></note> <verse eid="REV 19:12"/><verse number="13" style="v" sid="REV 19:13"/>I suuthan muuketida ma7o ma7is; iya sunthayka Xoossaa Qaala. <verse eid="REV 19:13"/><verse number="14" style="v" sid="REV 19:14"/>Phooliyanne geeshshi gidida liino ma7ida salo olanchoti bootha parata toggidi iya geedo kaalloosona. <verse eid="REV 19:14"/><verse number="15" style="v" sid="REV 19:15"/>Kawotethata qanxiya qara mashshay iya doonape keyees. I birata xam7an asaa haarana. Ubbaafe Wolqaama Xoossaa hanqo woyne ushsha gum7iya bessaa I yedhana.<note caller="-" style="x"><char style="xo" closed="false">19:15 </char><char style="xt" closed="false"><ref loc="PSA 2:9">Maz 2:9</ref>; <ref loc="ISA 63:3">Isa 63:3</ref>; <ref loc="JOL 3:13">Iyyu 3:13</ref>; <ref loc="REV 14:20">Qon 14:20</ref>.</char></note> <verse eid="REV 19:15"/><verse number="16" style="v" sid="REV 19:16"/>Iya ma7uwa bollanne iya wodiriya bolla, “Kawota Kawuwanne godata Godaa” giya sunthay xaafetis.<verse eid="REV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17"/>Hessafe guye, issi kiitanchoy awa bolla eqidaysa be7as. He kiitanchoy salora piradhiya kafo ubbaas ba qaala dhoqu oothidi, “Haa yiite! Xoossaa gibira maanaw issi bessi shiiqite.<note caller="-" style="x"><char style="xo" closed="false">19:17 </char><char style="xt" closed="false"><ref loc="EZK 39:17-20">Hiz 39:17-20</ref>.</char></note> <verse eid="REV 19:17"/><verse number="18" style="v" sid="REV 19:18"/>Yidi kawota ashuwa, shaalaqata ashuwa, wotaadareta ashuwa, parata ashuwa, parata toggeyisata ashuwa, asa ubbaa ashuwa, aylleta ashuwa, womaannota ashuwa, gitatanne guuthata ashuwa miite” yaagis.<verse eid="REV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19"/>Do7ay, para toggidaysaranne iya olanchotara oletanaw sa7a kawotinne enta olanchoti issi bessi shiiqidashin be7as. <verse eid="REV 19:19"/><verse number="20" style="v" sid="REV 19:20"/>Shin he do7aynne iya sunthan malaatata oothida wordo nabey iyara issife oyketis. He malaatatan do7aa mallay de7eysatanne iya misiliya goyinneyisata I balethis. Do7aynne wordo nabey nam7ayka diinnen eexiya tama abban paxa yegetidosona.<note caller="-" style="x"><char style="xo" closed="false">19:20 </char><char style="xt" closed="false"><ref loc="REV 13:1-18">Qon 13:1-18</ref>.</char></note> <verse eid="REV 19:20"/><verse number="21" style="v" sid="REV 19:21"/>Attidaysati para toggidaysa doonape keyiya mashshan hayqidosona. Kafoti ubbay enta ashuwa midi kallidosona.<verse eid="REV 19:21"/></para>
  <chapter eid="REV 19"/>
  <chapter number="20" style="c" sid="REV 20"/>
  <para style="s1">Mukulu Laythi</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1"/>Zawi bayna olla qulpiyanne gita santhalaata ba kushen oykida issi kiitanchoy salope wodhishin be7as. <verse eid="REV 20:1"/><verse number="2" style="v" sid="REV 20:2"/>I dawiya oykidi mukulu laythas qachis. He dawey koyro shoosha, Daabuloosa woyko Xalahe.<note caller="-" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="GEN 3:1">Medhe 3:1</ref>.</char></note> <verse eid="REV 20:2"/><verse number="3" style="v" sid="REV 20:3"/>Kiitanchoy zawi bayna ollan iya yeggidi, mukulu laythi wurana gakanaw kawotethata zaari balethonna mela qulpen gordidi attamis. Hessafe guye, dawey guutha wodes biletanaw bessees.<verse eid="REV 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4"/>Hessafe guye, araatatanne araatata bolla uttidi pirdana mela maati imetidaysata be7as. Yesuusas markatida gishonne Xoossaa qaala odida gisho banta qoodhiya goyretida asaa shempuwa be7as. Enti do7aa woyko do7aa misiliya goyinnibookona. Enti do7aa malla banta som7on woyko banta kushen wothibookona. Enti hayqope dendidi Kiristoosara issife mukulu laythi haaridosona.<note caller="-" style="x"><char style="xo" closed="false">20:4 </char><char style="xt" closed="false"><ref loc="DAN 7:9">Daane 7:9</ref>.</char></note> <verse eid="REV 20:4"/><verse number="5" style="v" sid="REV 20:5"/>Haysi koyro denduwa; attida hanko hayqidaysati mukulu laythay wurana gakanaw hayqope dendibookona. <verse eid="REV 20:5"/><verse number="6" style="v" sid="REV 20:6"/>Koyro denduwas qaadi de7eysati anjetidaysatanne geeshshata. Enta bolla nam7antho hayquwas wolqi baawa. Enti Xoossaasinne Kiristoosas kahine gidana; iyara issife mukulu laythi haarana.<verse eid="REV 20:6"/></para>
  <para style="s1">Xalahe Xoonetethi</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7"/>Mukulu laythay wuridaape guye Xalahey qashope biletana. <verse eid="REV 20:7"/><verse number="8" style="v" sid="REV 20:8"/>I sa7aa gaxape gaxa gakanaw de7iya kawotethata, entika, Googenne Maagoge geeteteyisata balethidi olas shiishanaw keyana. Enta paydoy abba gaxan de7iya shafe mela.<note caller="-" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="EZK 38:2">Hiz 38:2</ref>.</char></note> <verse eid="REV 20:8"/><verse number="9" style="v" sid="REV 20:9"/>Enti biitta ubban laaletidi, geeshshata heeranne Xoossay dosiya katamaa teqidosona. Shin tami salope wodhidi entana mis.<verse eid="REV 20:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 20:10"/>Enta balethida Xalahey, do7aynne wordo nabey yegetida eexiya diinne tama abban yegetis. Enti qammanne gallas merinaw paxa kaa7etana.<verse eid="REV 20:10"/></para>
  <para style="s1">Wursetha Pirda</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11"/>Hessafe guye, gita bootha araata bolla uttidaysa be7as. Sa7inne saloy iya sinthafe baqatidosona; enti zaari bentibookona.<note caller="-" style="x"><char style="xo" closed="false">20:11 </char><char style="xt" closed="false"><ref loc="DAN 7:9-10">Daane 7:9-10</ref>.</char></note> <verse eid="REV 20:11"/><verse number="12" style="v" sid="REV 20:12"/>Hayqidaysati, gitatinne guuthati araata sinthan eqidaysata be7as; maxaafati dooyetidosona; qassi de7o maxaafa gidida hara maxaafi dooyetis. Hayqidaysati maxaafan xaafetida banta oosuwada pirda ekidosona. <verse eid="REV 20:12"/><verse number="13" style="v" sid="REV 20:13"/>Abbay ba giddon de7iya hayqidaysata immis; hayqoynne Si7ooley banta giddon de7iya hayqidaysata immidosona. Issi issi asi ba oosuwada pirda ekis. <verse eid="REV 20:13"/><verse number="14" style="v" sid="REV 20:14"/>Yaatin, hayqoynne Si7ooley tama abban yegetidosona. He tama abbay nam7antho hayqo. <verse eid="REV 20:14"/><verse number="15" style="v" sid="REV 20:15"/>De7o maxaafan iya sunthay xaafetiboonna asi oonika tama abban yegetis.<verse eid="REV 20:15"/></para>
  <chapter eid="REV 20"/>
  <chapter number="21" style="c" sid="REV 21"/>
  <para style="s1">Ooratha Salonne Ooratha Sa7a</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1"/>Taani ooratha salonne ooratha sa7a be7as. Koyro saloynne koyro sa7i dhayis; abbayka dhayis.<note caller="-" style="x"><char style="xo" closed="false">21:1 </char><char style="xt" closed="false"><ref loc="ISA 65:17">Isa 65:17</ref>; <ref loc="ISA 66:22">66:22</ref>; <ref loc="2PE 3:13">2 Phex 3:13</ref>.</char></note> <verse eid="REV 21:1"/><verse number="2" style="v" sid="REV 21:2"/>Geeshsha katamiya, ooratha Yerusalaamey, azina gelanaw alleeqetada giigada de7iya maccasada salope Xoossaa matape duge wodhishin be7as.<note caller="-" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="ISA 52:1">Isa 52:1</ref>; <ref loc="REV 3:12">Qon 3:12</ref>; <ref loc="ISA 61:10">Isa 61:10</ref>.</char></note><verse eid="REV 21:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 21:3"/>Araatape haysada yaagidi, odiya gita qaala si7as; “Xoossa Keethay asaara de7ees; Xoossay ba bonchuwara asaara issife daana. Enti iya dere gidana; Xoossay ba huuphen entara daana; I enta Xoossaa gidana.<note caller="-" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="EZK 37:27">Hiz 37:27</ref>; <ref loc="LEV 26:11">Leewe 26:11</ref>.</char></note> <verse eid="REV 21:3"/><verse number="4" style="v" sid="REV 21:4"/>Xoossay enta ayfepe afutha ubbaa quchana. Hizape hayqoy woyko kayoy woyko waasoy woyko waayey deenna. Gal77ay ubbay aadhis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="ISA 25:8">Isa 25:8</ref>; <ref loc="ISA 35:10">Isa 35:10</ref>; <ref loc="ISA 65:19">65:19</ref>.</char></note><verse eid="REV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5"/>Araata bolla uttidaysi, “Taani ubbaa oorathi oothana” yaagis. Qassi zaaridi taako, “Taani odeysi ammantheysanne tuma gidiya gisho xaafa” yaagis. <verse eid="REV 21:5"/><verse number="6" style="v" sid="REV 21:6"/>Qassi taako, “Poletis! Taani Alfanne Omega; Doomethinne Polo.<note caller="-" style="x"><char style="xo" closed="false">21:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1">Isa 55:1</ref>.</char></note> Saamotida oonaka de7o haatha pultofe gate qanxonna coo ushshana. <verse eid="REV 21:6"/><verse number="7" style="v" sid="REV 21:7"/>Xooniya oonika hessa ubbaa laattana; taani iyaw Xoossaa gidana; ika ta na7a gidana.<note caller="-" style="x"><char style="xo" closed="false">21:7 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 Same 7:14</ref>; <ref loc="PSA 89:26">Maz 89:26</ref>.</char></note> <verse eid="REV 21:7"/><verse number="8" style="v" sid="REV 21:8"/>Shin yashshanchota, ammanetonayisata, tunata, shempo wodheyisata, laymateyisata, biteyisata, eeqa goyinneysatanne wordanchota qaaday diinney eexiya tama abban gidana. Hessi nam7antho hayqo” yaagis.<verse eid="REV 21:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9"/>Laapun wursetha boshati kumida laapun xuu7ata oykida laapun kiitanchotape issoy taako yidi, “Haaya, taani nena gelos giigida Dorsaa machiw bessaana” yaagis. <verse eid="REV 21:9"/><verse number="10" style="v" sid="REV 21:10"/>Kiitanchoy tana zuma huuphe Geeshsha Ayyaanan kessidi, geeshsha katamay, Yerusalaamey, salope Xoossaa matape duge wodhishin bessis.<note caller="-" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="EZK 40:1">Hiz 40:1</ref>.</char></note> <verse eid="REV 21:10"/><verse number="11" style="v" sid="REV 21:11"/>He katamay Xoossaa bonchon poo7ees. He katamaa poo7oy yasphide geetetiya al7o shuchaa mela; geeshsha birilleda phoolees. <verse eid="REV 21:11"/><verse number="12" style="v" sid="REV 21:12"/>He katamaa dirsay wolqaamanne adusse. Iyaw tammanne nam7u pengetinne he pengeta naagiya tammanne nam7u kiitanchoti de7oosona. Pengeta bolla tammanne nam7u Isra7eele zerethata sunthay xaafetis.<note caller="-" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="EZK 48:30-35">Hiz 48:30-35</ref>.</char></note> <verse eid="REV 21:12"/><verse number="13" style="v" sid="REV 21:13"/>Doloha baggara heedzu pengeti, pudeha baggara heedzu pengeti, dugeha baggara heedzu pengetinne wuloha baggara heedzu pengeti de7oosona. <verse eid="REV 21:13"/><verse number="14" style="v" sid="REV 21:14"/>Katamaa gimbe dirsay tammanne nam7u shucha baasota bolla eqis. Enta bolla tammanne nam7u Dorsaa hawaareta sunthay xaafetis.<verse eid="REV 21:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 21:15"/>Taw odiya kiitanchuwas, katamaa, iya pengetanne iya dirsaa wadhiya worqa xam7ay de7ees.<note caller="-" style="x"><char style="xo" closed="false">21:15 </char><char style="xt" closed="false"><ref loc="EZK 40:3">Hiz 40:3</ref>.</char></note> <verse eid="REV 21:15"/><verse number="16" style="v" sid="REV 21:16"/>Katamaas oyddu maazaneti de7oosona; katamaa geesaynne gompay issi gina. Kiitanchoy katamaa ba xam7an wadhin, katamay tammanne nam7u mukulu kilo mitire gidis; katamaa geesay, gompaynne dhoqatethay issi gina. <verse eid="REV 21:16"/><verse number="17" style="v" sid="REV 21:17"/>Kiitanchoy qassi dirsaa wadhin, kiitanchoy go7etiya asa kushen issi xeetanne oytamanne oyddu wadha gidis.<verse eid="REV 21:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 21:18"/>Katamaa dirsay yasphide geetetiya shuchan diretis. Katamay mastooteda phooliya walahi bayna worqan oosetis. <verse eid="REV 21:18"/><verse number="19" style="v" sid="REV 21:19"/>Katamaa dirsaa baasoy ubba qommo bonchetida shuchan alleeqetis. Koyro hiixetida shuchay yasphide, nam7anthoy sanpare, heedzanthoy kelqedoone, oyddanthoy baluure, <verse eid="REV 21:19"/><verse number="20" style="v" sid="REV 21:20"/>ichashanthoy sardonkisa, usupunthoy sardiyoone, laapunthoy kiristiloobe, hospunthoy birille, uddufunthoy toophaze, tammanthoy kirisphiraasise, tammanne issinthoy yaakinte, tammanne nam7anthoy ametesxinoosa.<verse eid="REV 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 21:21"/>Tammanne nam7u pengetas tammanne nam7u al7o shuchi de7ees. Issi issi pengey issi al7o shuchan oosetis. Katamaa wogga ogey mastooteda phooliya walahi bayna worqafe oosetis.<note caller="-" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="ISA 54:11-12">Isa 54:11-12</ref>.</char></note><verse eid="REV 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22"/>Goday, Ubbaafe Wolqaama Xoossaynne Dorsay katamaas keethe gidiya gisho, ta he kataman Xoossa keethi be7abike. <verse eid="REV 21:22"/><verse number="23" style="v" sid="REV 21:23"/>Xoossaa bonchoy he katamaas poo7iya gishonne Dorsay iyaw xompe gidiya gisho katamaas awa woyko ageena poo7o koshshenna.<note caller="-" style="x"><char style="xo" closed="false">21:23 </char><char style="xt" closed="false"><ref loc="ISA 60:19">Isa 60:19</ref>.</char></note> <verse eid="REV 21:23"/><verse number="24" style="v" sid="REV 21:24"/>Kawotethati he katamaa poo7on hemetana; kawotika banta bonchuwa yaa ehana.<note caller="-" style="x"><char style="xo" closed="false">21:24 </char><char style="xt" closed="false"><ref loc="ISA 60:3">Isa 60:3</ref>.</char></note> <verse eid="REV 21:24"/><verse number="25" style="v" sid="REV 21:25"/>Qammi yan bayna gisho katamaa pengeti ubba gallas dooya gidana; ubbaraka gordetokona.<note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ISA 60:11">Isa 60:11</ref>.</char></note> <verse eid="REV 21:25"/><verse number="26" style="v" sid="REV 21:26"/>Kawotethata gitatethaynne bonchoy he katamaa yaana. <verse eid="REV 21:26"/><verse number="27" style="v" sid="REV 21:27"/>Dorsaa de7o maxaafan sunthay xaafetidaysata xalaali attishin, tunabaa woyko yeellayaba oothey woyko wordotey oonika he katamaa gelenna.<note caller="-" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="ISA 52:1">Isa 52:1</ref>; <ref loc="EZK 44:9">Hiz 44:9</ref>.</char></note><verse eid="REV 21:27"/></para>
  <para style="b"/>
  <chapter eid="REV 21"/>
  <chapter number="22" style="c" sid="REV 22"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1"/>Yaatidi, kiitanchoy tana Xoossaa kawotetha araatapenne Dorsaa kawotethaa araatape goggiya mastooteda phooliya de7o haatha shaafa bessis.<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="EZK 47:1">Hiz 47:1</ref>; <ref loc="ZEC 14:8">Zaka 14:8</ref>.</char></note> <verse eid="REV 22:1"/><verse number="2" style="v" sid="REV 22:2"/>He shaafay katama ogiya giddora duge goggees. Shaafape hefintha baggaranne hafintha baggara ageenan issi toho; laythan tammanne nam7u toho ayfiya de7o mithi de7ees. He mitha boncoy kawotethata ubbaa hargefe pathees.<note caller="-" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="GEN 2:9">Medhe 2:9</ref>.</char></note><verse eid="REV 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 22:3"/>He kataman aybi baadethika deenna. Xoossaa kawotetha araataynne Dorsaa kawotetha araatay he kataman daana. Xoossaa aylleti Xoossaas oothana.<note caller="-" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="ZEC 14:10">Zaka 14:10</ref>.</char></note> <verse eid="REV 22:3"/><verse number="4" style="v" sid="REV 22:4"/>Enti iya som7uwa be7ana; iya sunthay enta som7on xaafetana. <verse eid="REV 22:4"/><verse number="5" style="v" sid="REV 22:5"/>Hizape qammi deenna; Godaa Xoossay entaw xompe gidiya gisho entaw xompe woyko awa poo7o koshshenna. Enti meri merinaw kawotana.<note caller="-" style="x"><char style="xo" closed="false">22:5 </char><char style="xt" closed="false"><ref loc="ISA 60:19">Isa 60:19</ref>; <ref loc="DAN 7:18">Daane 7:18</ref>.</char></note><verse eid="REV 22:5"/></para>
  <para style="s1">Yesuusa Yuussaa</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6"/>Kiitanchoy taako, “Ha ta odiya qaalay tumanne ammantheysa. Goday, nabeta ba Geeshsha Ayyaanan kiittiya Xoossay, matan hananaba ba aylleta bessanaw ba kiitanchuwa kiittis” yaagis. <verse eid="REV 22:6"/><verse number="7" style="v" sid="REV 22:7"/>Yesuusi, “Heko ta ellesada yaana; ha maxaafan de7iya tinbite qaala naagiya oonika anjetidaysa” yaagis.<verse eid="REV 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8"/>Taani, Yohaanisi, he ubbaba si7as; be7as. Taani hessa si7ida wodenne be7ida wode hessa tana bessida kiitanchuwa goyinnanaw iya tohuwa bolla kundas. <verse eid="REV 22:8"/><verse number="9" style="v" sid="REV 22:9"/>Shin kiitanchoy taako, “Hessa oothofa! Taani needa, nabetada ne ishatadanne ha maxaafan de7iya ubbaa kiitetiya aylleta mela; Xoossaa goyinna” yaagis.<verse eid="REV 22:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 22:10"/>Kiitanchoy zaaridi, “Ha ubbay poletiya wodey matatida gisho ha maxaafan xaafetida tinbite qaala maatamen gordofa. <verse eid="REV 22:10"/><verse number="11" style="v" sid="REV 22:11"/>Iita oothey gujidi iita ootho; tuney gujidi tuno. Lo77o oothey gujidi lo77o ootho; geeyey gujidi geeyo” yaagis.<note caller="-" style="x"><char style="xo" closed="false">22:11 </char><char style="xt" closed="false"><ref loc="DAN 12:10">Daane 12:10</ref>.</char></note><verse eid="REV 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12"/>Yesuusi, “Heko, taani ellesada yaana. Issuwas issuwas iya oosuwada immanaw ta woytoy taara de7ees.<note caller="-" style="x"><char style="xo" closed="false">22:12 </char><char style="xt" closed="false"><ref loc="ISA 40:10">Isa 40:10</ref>; <ref loc="ISA 62:11">62:11</ref>; <ref loc="PSA 28:4">Maz 28:4</ref>; <ref loc="JER 17:10">Ermi 17:10</ref>.</char></note> <verse eid="REV 22:12"/><verse number="13" style="v" sid="REV 22:13"/>Taani Alfanne Omega; Koyronne Wursethi; Doomethinne Polo.<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="REV 1:8">Qon 1:8</ref>, <ref loc="REV 1:17">17</ref>; <ref loc="REV 2:8">2:8</ref>; <ref loc="ISA 44:6">Isa 44:6</ref>; <ref loc="ISA 48:12">48:12</ref>.</char></note><verse eid="REV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14"/>“Banta ma7uwa meeccidi geeshsheysati anjetidaysata. De7o mithee ayfiya maanawunne katamaa pengiyara gelanaw entaw maati imetis.<note caller="-" style="x"><char style="xo" closed="false">22:14 </char><char style="xt" closed="false"><ref loc="GEN 2:9">Medhe 2:9</ref>; <ref loc="GEN 3:22">3:22</ref>.</char></note> <verse eid="REV 22:14"/><verse number="15" style="v" sid="REV 22:15"/>Shin kanati, biteysati, laymateysati, shempo wodheysati, eeqa goyinneysati, wordo doseysatinne ootheysati karen de7oosona.<verse eid="REV 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16"/>“Taani, Yesuusi, ha markatethaa hintew, woosa keethatas odana mela ta kiitanchuwa kiittas. Taani Dawita sheeshinne koche. Taani poo7iya guura bakala” yaagis.<note caller="-" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="ISA 11:1">Isa 11:1</ref>.</char></note><verse eid="REV 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17"/>Geeshsha Ayyaanaynne gelanaw giigida maccasiya, “Haaya” yaagosona. Qassi haysa si7iya oonika, “Haaya” yaago. Saamotida oonika haayo; de7o haatha koyiya oonika coo eko.<note caller="-" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="ISA 55:1">Isa 55:1</ref>.</char></note><verse eid="REV 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18"/>Taani ha maxaafan xaafetida tinbite qaala si7iya oonaka zorayis. Oonika ha qaala bolla issiba gujiko, Xoossay ha maxaafan xaafetida bosha iya bolla gujana.<note caller="-" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="DEU 4:2">Zaare 4:2</ref>; <ref loc="DEU 12:32">12:32</ref>.</char></note> <verse eid="REV 22:18"/><verse number="19" style="v" sid="REV 22:19"/>Oonika maxaafan de7iya tinbite qaalape issiba pacisiko, Xoossay ha maxaafan xaafetida de7o mithaa ayfiyapenne geeshsha katamaape iya qaada pacisana.<verse eid="REV 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20"/>Ha ubbaa markateysi, “Tuma, taani ellesada yaana” yaagees.</para>
  <para style="p" vid="REV 22:20">Amin7i; Godaa Yesuusa, haaya.<verse eid="REV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21"/>Godaa Yesuus Kiristoosa aadho keehatethay hinte ubbaara gido. Amin7i.<verse eid="REV 22:21"/></para>
  <chapter eid="REV 22"/>
</usx>
