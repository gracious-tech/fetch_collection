<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Filmoona Kiitaa</para>
  <para style="toc1">Filmoona Kiitaa</para>
  <para style="toc3">Filmo</para>
  <para style="toc2">Filmoona</para>
  <para style="mt1">Phawuloosi Filmoonas</para>
  <para style="mt2">Xaafida Kiitaa</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Filmooni eretida ammaniya asi. I Qolaasiyasa woosa keetha asi gidonna attenna. Filmoonas Anasmoosa geetetiya aylley de7ees. He aylley ba godaape betidi bida wode qasho keethan de7iya Phawuloosara gahetis. Anasmoosi Yesuusa ammanana mela oothiday Phawuloosa. Phawuloosi, Filmoonas xaafida dabdaabey, Filmooni guye simmidi, iyako biya ba aylliyara sigetana mela akeekisees. Gujidika ha77i Anasmoosi ammaniya asi gidida gisho, hizape guye, ammaniya ishada iya mokidi ekana melape attishin, aylleda iya taybonna mela iyaw odees.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Sarotho <char style="ior">(<ref loc="PHM 1:1-3">1-3</ref>)</char></para>
  <para style="io1">Anasmoosa gisho Phawuloosi Filmoona woossi <char style="ior">(<ref loc="PHM 1:4-22">4-22</ref>)</char></para>
  <para style="io1">Sarothonne anjo <char style="ior">(<ref loc="PHM 1:22-25">22-25</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />Taani Phawuloosi, Yesuus Kiristoosa gisho qashon de7eysinne nu ishaa Ximotiyoosi, nuura oothiya nuuni dosiya Filmoonas, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" />ne son shiiqiya woosa keethatas, nu miche Afbiyaasinne nuura issife de7iya wotaadare Arkiphaasas xaafida kiita.<note caller="-" style="x"><char style="xo" closed="false">2 </char><char style="xt" closed="false"><ref loc="COL 4:17">Qola 4:17</ref>.</char></note><verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />Xoossaa nu Aawapenne nu Godaa Yesuus Kiristoosape aadho keehatethaynne sarotethay hintew gido.<verse eid="PHM 1:3" /></para>
  <para style="s1">Filmoona Siiquwanne Ammanuwa</para>
  <para style="p">
    <verse number="4-5" style="v" sid="PHM 1:4-5" />Neeni geeshshata doseysanne Godaa Yesuusa ammaneysa taani si7iya gisho, Xoossaa woossashe nena qopiya wode ubban ta Xoossaa galatayis. <verse eid="PHM 1:4-5" /><verse number="6" style="v" sid="PHM 1:6" />Neeni ne ammanuwa haratas shaakeysi nuus Kiristoos Yesuusa baggara yaa lo77oba ubbaa erisana mela taani Xoossaa woossayis. <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />Geeshshata wozanay ne oosuwan minnida gisho, ta ishaw, taani ne siiquwan daro ufaysinne minthetho demmas.<verse eid="PHM 1:7" /></para>
  <para style="s1">Phawuloosi Filmoona Woossees</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />Hessa gisho, neeni oothanaw bessiyaba oothana mela nena kiittanaw Kiristoosa baggara taw minotethay de7ees. <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />Taani, cimay Phawuloosi, Kiristoos Yesuusas ha77ika qashon de7eysi, siiqon nena woossayis. <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" />Taani qashon de7ashe iyaw zoriya aawa gidada ta na7aa Anasmoosa gisho nena woossayis.<note caller="-" style="x"><char style="xo" closed="false">10 </char><char style="xt" closed="false"><ref loc="COL 4:9">Qola 4:9</ref>.</char></note> <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />I kase nena maaddenna, shin ha77i nenaka tanaka tuma maaddiya asi.<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12-13" style="v" sid="PHM 1:12-13" />Taani wozanape dosiya Anasmoosa neeko yeddayis. Taani Wongela gisho qashetidashin, ne gisho taw oothidi tana maaddana mela ta matan iya ashshanaw koyas. <verse eid="PHM 1:12-13" /><verse number="14" style="v" sid="PHM 1:14" />Shin ne sheneda oothanaw koyasipe attishin, neera zorettonna wolqan aykoka oothanaw koyke.<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />Anasmoosi guutha wode neepe shaaketidaysi, ooni eri simmidi ubba wode neera de7onna aggenna. <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />Hiza, haysafe guye Anasmoosi aylle gidonashin, ayllefe I daro aadhees. I taw ay mela siiqo ishe! Qassi I new asa baggaraka Godaa baggaraka aadhida isha.<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />Hiza, neeni tana ne lagge giyaba gidiko tana mokeysada iya moka. <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />I nena qohidabay woyko I acotidabay de7iko taape eka. <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />He acuwa ta qanxana gada taani Phawuloosi, ta kushen xaafayis. Neeni taw ne shempuwa acota uttidaysa taani nena akeekisanaw koshshenna.<verse eid="PHM 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PHM 1:20" />Ta ishaw, Godaa baggara neepe maade demmanaw koyayis. Kiristoosa baggara tana minthetha. <verse eid="PHM 1:20" /><verse number="21" style="v" sid="PHM 1:21" />Taani gidaysafe daro neeni oothanaysa erada qassi ne taw kiitetanaysa ammanada haysa xaafayis.<verse eid="PHM 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PHM 1:22" />Xoossay hinte woosa si7idi tana hinteko guye zaarana gada qopiya gisho, taw imathi shempiya keethi giigisa.<verse eid="PHM 1:22" /></para>
  <para style="s1">Sarotho</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />Kiristoos Yesuusa gisho taara qashon de7iya Ephafiri nena saro saro gees.<note caller="-" style="x"><char style="xo" closed="false">23 </char><char style="xt" closed="false"><ref loc="COL 1:7">Qola 1:7</ref>; <ref loc="COL 4:12">4:12</ref>.</char></note> <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" />Qassi taara issife oothiya Marqoosi, Arsxirokoosi, Deemasinne Luqaasi nena saro goosona.<note caller="-" style="x"><char style="xo" closed="false">24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">Hawa 12:12</ref>, <ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="ACT 19:29">19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="COL 4:10">Qola 4:10</ref>, <ref loc="COL 4:14">14</ref>; <ref loc="2TI 4:10-11">2 Ximo 4:10-11</ref>.</char></note><verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />Godaa Yesuus Kiristoosa aadho keehatethay hinte ayyaanara gido.<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>