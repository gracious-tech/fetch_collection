<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LUK" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Luqaasa Wongela</para>
  <para style="toc1">Luqaasa Wongela</para>
  <para style="toc3">Luqa</para>
  <para style="toc2">Luqaasa</para>
  <para style="mt1">Luqaasi Xaafida</para>
  <para style="mt2">Yesuus Kiristoosa Wongela</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Luqaasi Yesuusi doorida tammanne nam7u hawaareta giddon deenna. Luqaasa wongelay, Yesuusi koyro nabeta doonan yaana geetetidi odetidaysa, Isra7eeleti naagishe de7iya “Kiristoosa” gideysanne asa koche ubbaa ashshanaw de7ey iya gideysa qoncisees. Luqaasi ba maxaafan, Yesuusi, “Manqotas wongela sabbakanaw” ba aawape kiitetidaysanne he wongelay asay de7iya dumma dumma metuwape kesseysa gideysa odees. Luqaasa wongela giddon, Yesuusa yuussaba odiya koyro shempotaninne Yesuusi salo bidaysa odiya wursetha shempotan qoncidi odetiday ufaysaba. Yesuusi salo bidaape guye ammanoy waanidi diccidaakonne dalgidaako odiya taarikiya ha wongela xaafey hawaareta ooso maxaafan xaafis.</para>
  <para style="ip">Kiitanchota mazmuriya, Yesuusi yeletida wode henthachoti bidi iya be7idaysa odiya taarikey de7ey Luqaasa wongelana. Qassi Yesuusi na7atethan xoossa keethi bidaysa, qadhetiya Samaare addiyabanne dhaydi bentida na7aba odiya taarikey, Luqaasa wongela xalaalan bentiya taarike. Woosabay, Geeshsha Ayyaanabay, maccasas imetida bessaynne Xoossi nagara atto geysi, Luqaasa wongelan gaxape gaxa gakanaw de7iya waanna qofata.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Gelo qofa <char style="ior">(<ref loc="LUK 1:1-4">1:1-4</ref>)</char></para>
  <para style="io1">Xammaqiya Yohaanisanne Yesuusa yeletethi <char style="ior">(<ref loc="LUK 1:5-2:52">1:5—2:52</ref>)</char></para>
  <para style="io1">Xammaqiya Yohaanisa oosuwa <char style="ior">(<ref loc="LUK 3:1-20">3:1-20</ref>)</char></para>
  <para style="io1">Yesuusa xinqatenne paacetethi <char style="ior">(<ref loc="LUK 3:21-4:13">3:21—4:13</ref>)</char></para>
  <para style="io1">Yesuusi Galilan oothida oosuwa <char style="ior">(<ref loc="LUK 4:14-9:50">4:14—9:50</ref>)</char></para>
  <para style="io1">Galilape Yerusalaame gakanaw <char style="ior">(<ref loc="LUK 9:51-19:27">9:51—19:27</ref>)</char></para>
  <para style="io1">Yerusalaame heeran aathida wursetha saaminta <char style="ior">(<ref loc="LUK 19:28-23:56">19:28—23:56</ref>)</char></para>
  <para style="io1">Hayqope dendo, asaas bentonne salo buussu <char style="ior">(<ref loc="LUK 24:1-53">24:1-53</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="LUK 1" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 1:1" />Boncho Tewofloosa, nu giddon poletidabas daroti, bantaw danda7etida mela xaafidosona. <verse eid="LUK 1:1" /><verse number="2" style="v" sid="LUK 1:2" />He taarikiya enti xaafiday koyrope doomidi ayfe markatinne qaala haggaazeysati nuus odidaysa. <verse eid="LUK 1:2" /><verse number="3" style="v" sid="LUK 1:3" />Taka ta baggara koyrope akeeka xeellidaape guye, he taarikiya hanota maarayada new xaafoy lo77o gididi bentis. <verse eid="LUK 1:3" /><verse number="4" style="v" sid="LUK 1:4" />Hessika, ne tamaaridabay tuma gideysa erisanaasa.<verse eid="LUK 1:4" /></para>
  <para style="s1">Xammaqiya Yohaanisa Yeletethi</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 1:5" />Yihuda kawa Herodiisa wode Abiya yaraape gidida Zakaryaasa geetetiya Ayhude kahiney de7ees. Iya machiyaka Aarona sheeshape. I sunthayka Elsabeexo.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="1CH 24:10">1 Taari 24:10</ref>.</char></note> <verse eid="LUK 1:5" /><verse number="6" style="v" sid="LUK 1:6" />Nam7ayka Godaa wogaanne kiita ubbaa naagidi borey bayna Xoossaa sinthan xillotethan de7idosona. <verse eid="LUK 1:6" /><verse number="7" style="v" sid="LUK 1:7" />Hanope attishin, Elsabeexa maynthi gidida gisho entaw na7i baawa; nam7ayka qassi cimidosona.<verse eid="LUK 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 1:8" />Issi gallas Zakaryaasi ba gishuwa maaran Xoossaa sinthan kahinetethan haggaazees. <verse eid="LUK 1:8" /><verse number="9" style="v" sid="LUK 1:9" />Kahinetetha wogan Xoossa Keethi gelidi ixaane cuyisanaw iya saami gakis. <verse eid="LUK 1:9" /><verse number="10" style="v" sid="LUK 1:10" />Ixaaney cuyaa wode asay karen woossees.<verse eid="LUK 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 1:11" />Godaa kiitanchoy yarsho yarshiya bessaafe ushacha baggara eqidi bentis. <verse eid="LUK 1:11" /><verse number="12" style="v" sid="LUK 1:12" />Zakaryaasi iya be7ida wode dagammidi daro yayyis. <verse eid="LUK 1:12" /><verse number="13" style="v" sid="LUK 1:13" />Shin kiitanchoy iyako, “Zakaryaasa yayyofa; ne woosay si7etis. Ne machiya Elsabeexa adde na7a yelana, iya Yohaanisa gada ne sunthana. <verse eid="LUK 1:13" /><verse number="14" style="v" sid="LUK 1:14" />I new injenne ufaysi gidana; daroti iya yeletethan ufaytana. <verse eid="LUK 1:14" /><verse number="15" style="v" sid="LUK 1:15" />Godaa sinthan I gita gidana; woyne ushshi gidin hara mathoyiya ushsha uyenna. Ba aaye ulon de7ishe Geeshsha Ayyaanan kumana.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="NUM 6:3">Taybo 6:3</ref>.</char></note> <verse eid="LUK 1:15" /><verse number="16" style="v" sid="LUK 1:16" />Isra7eele asatape darota banta Godaa, Xoossaako zaarana. <verse eid="LUK 1:16" /><verse number="17" style="v" sid="LUK 1:17" />Aawata wozana naytako zaarana, kiitetonayisata xillota cincatethaako zaarana mela, Godaas bessiya dere giigisanaw Eeliyaasa ayyaananinne wolqan Godaa sinthan baana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAL 4:5-6">Milki 4:5-6</ref>.</char></note><verse eid="LUK 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 1:18" />Zakaryaasi kiitanchuwako, “Ta hessa aybin eranee? Taaranne ta machera cimida” yaagis.<verse eid="LUK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 1:19" />Kiitanchoy zaaridi, “Taani Xoossaa sinthan eqiya Gabreele. Ha mishiraachuwa new odanaw Xoossaafe kiitetas.<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="DAN 8:16">Daane 8:16</ref>; <ref loc="DAN 9:21">9:21</ref>.</char></note> <verse eid="LUK 1:19" /><verse number="20" style="v" sid="LUK 1:20" />Heko, wodiya naagidi poletiya ta qaala ne ammanonna ixida gisho, haysi poletana gakanaw neeni muume gidana, odetanawuka danda7aka” yaagis.<verse eid="LUK 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 1:21" />He wode Zakaryaasi Xoossa Keethi gelidi gam7ida gisho, aybi hanide gidi asay karen naagishe gam7is. <verse eid="LUK 1:21" /><verse number="22" style="v" sid="LUK 1:22" />I kare keyidi entana odisanaw danda7ibeenna. Malli besope attishin, odetanaw danda7onaysa be7ida wode qoncethi be7idaysa eridosona.<verse eid="LUK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 1:23" />Zakaryaasi ba haggaazuwa polidi soo simmis. <verse eid="LUK 1:23" /><verse number="24" style="v" sid="LUK 1:24" />Hessafe guye, iya machiya Elsabeexa qanthatasu. Ichashu ageena kumethi bana genthada gam7asu. <verse eid="LUK 1:24" /><verse number="25" style="v" sid="LUK 1:25" />Iya, “Goday ba maarotan ta boriya asaa giddofe digganaw be7idi ha wodiyan haysa oothis” yaagasu.<verse eid="LUK 1:25" /></para>
  <para style="s1">Yesuusa yeletethay koyrottidi odetis</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 1:26" />Elsabeexa qanthatin usupuntho ageenan, Xoossay kiitanchuwa Gabreele Galila biittan de7iya Naazirete katamaa kiittis. <verse eid="LUK 1:26" /><verse number="27" style="v" sid="LUK 1:27" />Kawa Dawita sheeshape gidida Yoosefa geetetiya uraas oyshetida geela7eeko kiittis. He geela7iya Mayraamo geetetawusu.<note caller="-" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 1:18">Maato 1:18</ref>.</char></note> <verse eid="LUK 1:27" /><verse number="28" style="v" sid="LUK 1:28" />Kiitanchoy iiko bidi, “Daro dosetidaare, saroy new gido, Xoossay neera de7ees; neeni anjetidaaro” yaagis.<verse eid="LUK 1:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 1:29" />Mayraama iya odan daro dagammada, “Haysi aybi sarotho” gada heetasu. <verse eid="LUK 1:29" /><verse number="30" style="v" sid="LUK 1:30" />Kiitanchoy zaaridi, “Mayraame, babofa; neeni Xoossa sinthan saba demmadasa. <verse eid="LUK 1:30" /><verse number="31" style="v" sid="LUK 1:31" />Heko neeni qanthatana adde na7a yelana, iya sunthaa Yesuusa gada sunthana.<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="MAT 1:21">Maato 1:21</ref>.</char></note> <verse eid="LUK 1:31" /><verse number="32" style="v" sid="LUK 1:32" />I gita gidana, Ubbaafe Bolla Xoossaa na7aa geetetidi xeegetana. Godaa Xoossay iya aawa Dawita araata iyaw immana.<note caller="-" style="x"><char style="xo" closed="false">1:32 </char><char style="xt" closed="false"><ref loc="2SA 7:12-13">2 Same 7:12-13</ref>, <ref loc="2SA 7:16">16</ref>; <ref loc="ISA 9:7">Isa 9:7</ref>.</char></note> <verse eid="LUK 1:32" /><verse number="33" style="v" sid="LUK 1:33" />I Yayqooba sheesha bolla merinaw kawotana; iya kawotethaas zawi baawa” yaagis.<verse eid="LUK 1:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 1:34" />Mayraama kiitanchuwako, “Hessi waanidi hananee? Ta adde erike” yaagasu.<verse eid="LUK 1:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 1:35" />Kiitanchoy zaaridi, “Geeshsha Ayyaanay ne bolla wodhana, Ubbaafe Bolla Xoossaa wolqay ne bolla kuyatana. Hessa gisho, yeletiya geeshsha na7ay Xoossaa Na7aa geetetana. <verse eid="LUK 1:35" /><verse number="36" style="v" sid="LUK 1:36" />Heko, ne dabiya Elsabeexa ba cimatetha laythan adde na7a qanthatasu. Iya maynthi geetetidaaro, shin ha77i usupuntho ageena oykasu. <verse eid="LUK 1:36" /><verse number="37" style="v" sid="LUK 1:37" />Xoossaa xooniyabay baawa”<note caller="-" style="x"><char style="xo" closed="false">1:37 </char><char style="xt" closed="false"><ref loc="GEN 18:14">Medhe 18:14</ref>.</char></note> yaagis.<verse eid="LUK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 1:38" />Mayraama, “Heko, taani Godaa aylliw, ne qaalada taw hano” yaagasu. Hessafe guye, kiitanchoy iipe shaaketis.<verse eid="LUK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 1:39" />Mayraama he saamintan dendada Yihuda biittan de7iya issi derey dariya katama basu. <verse eid="LUK 1:39" /><verse number="40" style="v" sid="LUK 1:40" />Zakaryaasa soo gelada Elsabeexo sarothasu. <verse eid="LUK 1:40" /><verse number="41" style="v" sid="LUK 1:41" />Elsabeexa Mayraami sarothuwa si7ida wode I uluwan de7iya na7ay ufaysan gupis. Elsabeexa Geeshsha Ayyaanan kumada, <verse eid="LUK 1:41" /><verse number="42" style="v" sid="LUK 1:42" />ba qaala dhoqu oothada, “Neeni maccasa giddofe anjetidaaro, ne qanthatida na7ayka anjetidaysa. <verse eid="LUK 1:42" /><verse number="43" style="v" sid="LUK 1:43" />Hanoshin, ta Godaa aaye, neeni taako yaana mela taani oonee? <verse eid="LUK 1:43" /><verse number="44" style="v" sid="LUK 1:44" />Heko ne sarothuwa ta si7ida wode ta uluwan de7iya na7ay ufaysan gupis. <verse eid="LUK 1:44" /><verse number="45" style="v" sid="LUK 1:45" />Goday polana gidi immida qaala ammanidara, iya anjetidaaro” yaagasu.<verse eid="LUK 1:45" /></para>
  <para style="s1">Mayraami mazmuriya</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 1:46" />Mayraama haysada yaagasu:</para>
  <para style="q1" vid="LUK 1:46">“Ta shempiya Godaa bonchawusu,<note caller="-" style="x"><char style="xo" closed="false">1:46 </char><char style="xt" closed="false"><ref loc="1SA 2:1-10">1 Same 2:1-10</ref>.</char></note><verse eid="LUK 1:46" /></para>
  <para style="q2">
    <verse number="47" style="v" sid="LUK 1:47" />ta Ayyaanay dhaliya Xoossan ufaytees.<verse eid="LUK 1:47" /></para>
  <para style="q1">
    <verse number="48" style="v" sid="LUK 1:48" />I ba aylle kawushatethaa be7is.</para>
  <para style="q1" vid="LUK 1:48">Hachife doomidi yeletethi ubbay tana anjetidaaro gaana.<note caller="-" style="x"><char style="xo" closed="false">1:48 </char><char style="xt" closed="false"><ref loc="1SA 1:11">1 Same 1:11</ref>.</char></note><verse eid="LUK 1:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="LUK 1:49" />Ayis giiko, wolqaama gidida I, taw gitaba oothis.</para>
  <para style="q2" vid="LUK 1:49">Iya sunthay Geeshshaa.<verse eid="LUK 1:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="LUK 1:50" />Iya boncheyisata bolla,</para>
  <para style="q2" vid="LUK 1:50">iya maarotethay merinaape merinaa gakanaasa.<verse eid="LUK 1:50" /></para>
  <para style="q1">
    <verse number="51" style="v" sid="LUK 1:51" />Ba qesiyan minoba oothis,</para>
  <para style="q2" vid="LUK 1:51">banta wozanan otorteyisata laallis.<verse eid="LUK 1:51" /></para>
  <para style="q1">
    <verse number="52" style="v" sid="LUK 1:52" />Wolqaama kawota araatape kawushis;</para>
  <para style="q2" vid="LUK 1:52">bantana kawushidaysata kaaboyis.<note caller="-" style="x"><char style="xo" closed="false">1:52 </char><char style="xt" closed="false"><ref loc="JOB 5:11">Iyyo 5:11</ref>; <ref loc="JOB 12:19">12:19</ref>.</char></note><verse eid="LUK 1:52" /></para>
  <para style="q1">
    <verse number="53" style="v" sid="LUK 1:53" />Koshatidaysata lo77oban kalsis,</para>
  <para style="q2" vid="LUK 1:53">shin dureta mela kushe yeddis.<verse eid="LUK 1:53" /></para>
  <para style="q1">
    <verse number="54" style="v" sid="LUK 1:54" />Ba maarota qopidi,</para>
  <para style="q2" vid="LUK 1:54">Ba aylliya Isra7eele maaddis.<verse eid="LUK 1:54" /></para>
  <para style="q1">
    <verse number="55" style="v" sid="LUK 1:55" />Hessika nu aawatas odida qaala,</para>
  <para style="q2" vid="LUK 1:55">Abrahaamesinne iya sheeshas gidaysa merinaw polanaasa”<note caller="-" style="x"><char style="xo" closed="false">1:55 </char><char style="xt" closed="false"><ref loc="GEN 17:7">Medhe 17:7</ref>.</char></note></para>
  <para style="m" vid="LUK 1:55">yaagasu.<verse eid="LUK 1:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="LUK 1:56" />Mayraama Elsabeexi matan heedzu ageena mela gam7ada ba soo simmasu.<verse eid="LUK 1:56" /></para>
  <para style="s1">Xammaqiya Yohaanisa yeletethaa</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 1:57" />Elsabeexis yelo qammay gakin adde na7a yelasu. <verse eid="LUK 1:57" /><verse number="58" style="v" sid="LUK 1:58" />I shoorotinne I dabboti Goday gita maarota oothidaysa si7idi, iira issife ufaytidosona. <verse eid="LUK 1:58" /><verse number="59" style="v" sid="LUK 1:59" />Hospuntha gallasan yooga na7aa qaxaranaw yidosona. Iya aawa sunthan Zakaryaasa gidi sunthanaw koydosona.<note caller="-" style="x"><char style="xo" closed="false">1:59 </char><char style="xt" closed="false"><ref loc="LEV 12:3">Leewe 12:3</ref>.</char></note> <verse eid="LUK 1:59" /><verse number="60" style="v" sid="LUK 1:60" />Shin aayiya, “Akay, Yohaanisa geetetanaw bessees” yaagasu. <verse eid="LUK 1:60" /><verse number="61" style="v" sid="LUK 1:61" />Entika, “Ne dabbotape ha sunthan xeegetiday oonika baawa” yaagidosona. <verse eid="LUK 1:61" /><verse number="62" style="v" sid="LUK 1:62" />Iya aaway oona gidi sunthaneko eranaw koyidi iya malla oychidosona. <verse eid="LUK 1:62" /><verse number="63" style="v" sid="LUK 1:63" />I xaafiyabaa oychi ekidi, “Iya sunthay Yohaanisa” gidi xaafis. Ubbay I xaafidaysa be7idi malaaletidosona. <verse eid="LUK 1:63" /><verse number="64" style="v" sid="LUK 1:64" />Iira Zakaryaasa inxarsay biletis, Xoossaa galatishe odetethi oykis. <verse eid="LUK 1:64" /><verse number="65" style="v" sid="LUK 1:65" />Shooroti ubbay yashshan kumidosona. Ha hanidabay derey dariya Yihuda biittan odetis. <verse eid="LUK 1:65" /><verse number="66" style="v" sid="LUK 1:66" />Hessa si7ida ubbay, “Ha na7ay ay hanandesha” gidi banta giddon odetidosona. Godaa kushey iyara de7ees.<verse eid="LUK 1:66" /></para>
  <para style="s1">Zakaryaasa mazmuriya</para>
  <para style="p">
    <verse number="67" style="v" sid="LUK 1:67" />Yohaanisa aaway Zakaryaasi Geeshsha Ayyaanan kumidi haysada yaagidi tinbite odis.<verse eid="LUK 1:67" /></para>
  <para style="q1">
    <verse number="68" style="v" sid="LUK 1:68" />“Isra7eele Goday galatetto,</para>
  <para style="q2" vid="LUK 1:68">yidi ba asaa wozis.<verse eid="LUK 1:68" /></para>
  <para style="q1">
    <verse number="69" style="v" sid="LUK 1:69" />Ba aylliya Dawita keethan</para>
  <para style="q2" vid="LUK 1:69">atotetha kaciya denthis.<verse eid="LUK 1:69" /></para>
  <para style="q1">
    <verse number="70" style="v" sid="LUK 1:70" />Hessika beni wode geeshsha nabeta doonan odetidaysa mela,<verse eid="LUK 1:70" /></para>
  <para style="q1">
    <verse number="71" style="v" sid="LUK 1:71" />Iya ashoy nu morketapenne</para>
  <para style="q2" vid="LUK 1:71">nuura eqetiya ubbaa kushiyape.<verse eid="LUK 1:71" /></para>
  <para style="q1">
    <verse number="72" style="v" sid="LUK 1:72" />Hessa I oothiday nu aawatas ba maarota bessanaasinne,</para>
  <para style="q2" vid="LUK 1:72">ba geeshsha caaquwa naaganaassa.<verse eid="LUK 1:72" /></para>
  <para style="q1">
    <verse number="73" style="v" sid="LUK 1:73" />Nu aawa Abrahaames caaqida</para>
  <para style="q2" vid="LUK 1:73">caaquwa qopanaasinne<verse eid="LUK 1:73" /></para>
  <para style="q2">
    <verse number="74" style="v" sid="LUK 1:74" />nu morketa kushepe kessidi</para>
  <para style="q2" vid="LUK 1:74">yashshi bayna iya haggaazana melasa.<verse eid="LUK 1:74" /></para>
  <para style="q1">
    <verse number="75" style="v" sid="LUK 1:75" />Nu laytha ubban geeshshatethaninne xillotethan</para>
  <para style="q2" vid="LUK 1:75">ba sinthan nuna essanaasa.<verse eid="LUK 1:75" /></para>
  <para style="q1">
    <verse number="76" style="v" sid="LUK 1:76" />Qassi la na7aw, neeni Ubbaafe Bolla Xoossaa nabe geetetana.<note caller="-" style="x"><char style="xo" closed="false">1:76 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Milki 3:1</ref>.</char></note></para>
  <para style="q1" vid="LUK 1:76">Godaa ogiya loythanaw ne iya sinthan baana.<verse eid="LUK 1:76" /></para>
  <para style="q1">
    <verse number="77" style="v" sid="LUK 1:77" />Enta nagaray qushetin,</para>
  <para style="q2" vid="LUK 1:77">enti atotethi demmanaysa ne Godaa deriyas odana.<verse eid="LUK 1:77" /></para>
  <para style="q1">
    <verse number="78" style="v" sid="LUK 1:78" />Nu Xoossaa lo77o maarotethaafe dendoysan</para>
  <para style="q2" vid="LUK 1:78">wonta xalqey nuus saluwape keyis.<verse eid="LUK 1:78" /></para>
  <para style="q1">
    <verse number="79" style="v" sid="LUK 1:79" />Hessika dhumaninne,</para>
  <para style="q2" vid="LUK 1:79">hayqo kuya garsan de7eysatas poo7isanaasa,</para>
  <para style="q2" vid="LUK 1:79">nu tohuwaka saro ogiyako zaaranaasa”</para>
  <para style="m" vid="LUK 1:79">yaagis.<note caller="-" style="x"><char style="xo" closed="false">1:79 </char><char style="xt" closed="false"><ref loc="ISA 9:2">Isa 9:2</ref>.</char></note><verse eid="LUK 1:79" /></para>
  <para style="p">
    <verse number="80" style="v" sid="LUK 1:80" />Na7ay diccis, Ayyaanan minnis, Isra7eele asaas qoncana gakanaw mela biittan de7is.<verse eid="LUK 1:80" /></para>
  <chapter eid="LUK 1" />
  <chapter number="2" style="c" sid="LUK 2" />
  <para style="s1">Yesuusa yeletethaa</para>
  <para style="r">(<ref loc="MAT 1:18-25">Maato 1:18-25</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 2:1" />He wode Roome biittan de7iya asa ubbay taybetana melanne sunthay xaafetana mela kawoy Awugisxoosi kiittis. <verse eid="LUK 2:1" /><verse number="2" style="v" sid="LUK 2:2" />Hessika Qerenoosi Soore biitta aysiya wode oosetida koyro taybuwa. <verse eid="LUK 2:2" /><verse number="3" style="v" sid="LUK 2:3" />Hessa gisho, issi issi asi ba sunthaa xaafetanaw ba yeletida biitta bis.<verse eid="LUK 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 2:4" />Yoosefika Dawita keethaafenne yaraape gidida gisho, Galila Naazirete katamaape dendidi Dawita katama gidida Yihuda Beeteleme bis. <verse eid="LUK 2:4" /><verse number="5" style="v" sid="LUK 2:5" />Bishe, yelanaw wodey wurida I oychi wothida, Mayraamira wolla xaafetanaw bis. <verse eid="LUK 2:5" /><verse number="6" style="v" sid="LUK 2:6" />Enti yan de7ishin iw yelo wodey gakis. <verse eid="LUK 2:6" /><verse number="7" style="v" sid="LUK 2:7" />Ba bayra na7aa yelasu. Curqara xaaxada imathi aqiya keethan bessi dhayida gisho daran mehe muziya gongen zin7isasu.<verse eid="LUK 2:7" /></para>
  <para style="s1">Henthanchotanne kiitanchota</para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 2:8" />He gadiyan qamma dorsa wudiya naagishe karen aqiya henthanchoti de7oosona. <verse eid="LUK 2:8" /><verse number="9" style="v" sid="LUK 2:9" />Godaa kiitanchoy hassayonna yidi enta matan eqis. Godaa bonchoy enta yuushuwan poo7is; entika wolqaama yashshi yayyidosona. <verse eid="LUK 2:9" /><verse number="10" style="v" sid="LUK 2:10" />Shin kiitanchoy, “Yayyofite! Heko, asaa ubbaas gidiya gita ufaysaa mishiraachuwa ekada yas. <verse eid="LUK 2:10" /><verse number="11" style="v" sid="LUK 2:11" />Hessika, Dawita kataman ashsheysi hintew hachi yeletis. I Godaa Kiristoosa. <verse eid="LUK 2:11" /><verse number="12" style="v" sid="LUK 2:12" />Zoqale na7i curqara xaaxetidi gongen zin7idaysa hinte demmana; hessika hintew malla gido” yaagis.<verse eid="LUK 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 2:13" />Qoponna daro salo kiitanchoti kiitanchuwara issife qoncidi,<verse eid="LUK 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="LUK 2:14" />“Bonchoy Xoossaas dhoqa saluwan,</para>
  <para style="q2" vid="LUK 2:14">saroy biitta bolla Xoossay dosiya asaas gido”</para>
  <para style="m" vid="LUK 2:14">yaagidi galatidosona.<verse eid="LUK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 2:15" />Kiitanchoti entafe shaaketidi saluwa keydaape guye henthanchoti, “Ane Goday nuus qoncisidabaanne hanidaba be7anaw Beeteleme boos” yaagidosona.<verse eid="LUK 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 2:16" />Entika ellesidi bidosona. Mayraamo, Yoosefanne zoqale na7aa gongen zin7idaysa be7idosona. <verse eid="LUK 2:16" /><verse number="17" style="v" sid="LUK 2:17" />Be7i simmidi na7aba entaw odetoysa, qoncisidi he bessan de7iya asaas markatidosona. <verse eid="LUK 2:17" /><verse number="18" style="v" sid="LUK 2:18" />Hessa si7ida ubbay henthanchoti odidaysan malaaletidosona. <verse eid="LUK 2:18" /><verse number="19" style="v" sid="LUK 2:19" />Mayraama hanidaba ubbaa ba wozanan qopashe de7asu. <verse eid="LUK 2:19" /><verse number="20" style="v" sid="LUK 2:20" />Henthanchoti entaw odetidaysada hanin be7idosona. Hessa gisho, banta si7idabaasinne be7idaba ubbaas Xoossaa bonchishenne galatishe simmidosona.<verse eid="LUK 2:20" /></para>
  <para style="s1">Yesuusa Xoossa Keethi Efidosona</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 2:21" />Hospuntha qamman, qaxaro wodey gakin, I qanthatanaape sinthe kiitanchoy wothida sunthan Yesuusa geetetis.<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="LEV 12:3">Leewe 12:3</ref>; <ref loc="LUK 1:3">Luqa 1:3</ref>.</char></note> <verse eid="LUK 2:21" /><verse number="22" style="v" sid="LUK 2:22" />Muse woga mela enta geeshshatetha wodey poletidaape guye Yoosefaranne Mayraamira yooga na7aa banta Godaas immanaw Yerusalaame bidosona. <verse eid="LUK 2:22" /><verse number="23" style="v" sid="LUK 2:23" />Hessika, Godaa wogan, “Adde gidida bayra na7i ubbay Godaas dummatidaysa gido” geetetidi xaafetidaysa polanaasa.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="EXO 13:2">Kessa 13:2</ref>, <ref loc="EXO 13:12">12</ref>.</char></note> <verse eid="LUK 2:23" /><verse number="24" style="v" sid="LUK 2:24" />Qassi Godaa wogan, nam7u kuraacho woyko holle yarshanaw efidosona. <verse eid="LUK 2:24" /><verse number="25" style="v" sid="LUK 2:25" />He wode geeshshinne ammanora mino gidida Simoona geetetiya asi Yerusalaamen de7ees. I Isra7eeleta atotetha naagishe de7ees. Geeshsha Ayyaanayka iya bolla de7ees. <verse eid="LUK 2:25" /><verse number="26" style="v" sid="LUK 2:26" />Qassi Kiristoosa be7onna hayqonnaysa Geeshsha Ayyaanay iyaw qoncisin eridi de7ees. <verse eid="LUK 2:26" /><verse number="27" style="v" sid="LUK 2:27" />I he gallas Ayyaanay kaalethin Xoossa Keethi bis. Na7aa aayeranne aawara wogaa polanaw yooga na7aa Yesuusa ekidi gelida wode, <verse eid="LUK 2:27" /><verse number="28" style="v" sid="LUK 2:28" />Simooni moki ekidi na7aa idimmidi,<verse eid="LUK 2:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 2:29" />“Godaw ne taw gelida qaala mela,</para>
  <para style="q2" vid="LUK 2:29">ha77i ne aylliya saron moyza.<verse eid="LUK 2:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="LUK 2:30" />Ta ayfey asaa ubbaa sinthan ne giigisida,<verse eid="LUK 2:30" /></para>
  <para style="q2">
    <verse number="31" style="v" sid="LUK 2:31" />ne ashuwa be7is.<verse eid="LUK 2:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="LUK 2:32" />Hessika kawotethata ubbaas,</para>
  <para style="q2" vid="LUK 2:32">Xoossaa ogiya qoncisiya poo7o,</para>
  <para style="q2" vid="LUK 2:32">ne asaa Isra7eeleska boncho”</para>
  <para style="m" vid="LUK 2:32">yaagidi Xoossaa galatis.<note caller="-" style="x"><char style="xo" closed="false">2:32 </char><char style="xt" closed="false"><ref loc="ISA 42:6">Isa 42:6</ref>; <ref loc="ISA 49:6">49:6</ref>; <ref loc="ISA 52:10">52:10</ref>.</char></note><verse eid="LUK 2:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 2:33" />Yoosefaranne Mayraamira iyaw odetidaban malaaletidosona. <verse eid="LUK 2:33" /><verse number="34" style="v" sid="LUK 2:34" />Simooni enta anjis. Aaye Mayraamiko, “Heko daro asaa wozanaa qofay qoncana mela, Isra7eelen de7iya darotas enta kundethaasinne denduwas Xoossan dooretis. <verse eid="LUK 2:34" /><verse number="35" style="v" sid="LUK 2:35" />Qassi eqeteysatas malla gidana. Ne shempuwaraka qassi mashshi aadhana” yaagis. <verse eid="LUK 2:35" /><verse number="36" style="v" sid="LUK 2:36" />Qassi Aseera yaraape gidida Faanu7ela na7iya Haanna geetetiya nabey de7awusu. Iya daro cimasu; iya ba koyro azinaara laapun laythi de7asu. <verse eid="LUK 2:36" /><verse number="37" style="v" sid="LUK 2:37" />I azinay hayqin hospun tammanne oyddu laythi gidana gakanaw qammanne gallas pacey bayna woosaninne xooman xoossa keethan haggaazasu. <verse eid="LUK 2:37" /><verse number="38" style="v" sid="LUK 2:38" />Iya he saatiyan bada Xoossaa galatasu; Yerusalaame wozetetha naagiya ubbaas yooga na7aba markatasu. <verse eid="LUK 2:38" /><verse number="39" style="v" sid="LUK 2:39" />Yoosefaranne Mayraamira Godaa higgiyan kiitetida woga ubbaa polidaape guye Galila biittan de7iya banta katama Naazirete simmidosona.<note caller="-" style="x"><char style="xo" closed="false">2:39 </char><char style="xt" closed="false"><ref loc="MAT 2:23">Maato 2:23</ref>.</char></note> <verse eid="LUK 2:39" /><verse number="40" style="v" sid="LUK 2:40" />Na7ay diccishenne minnishe bis. Cincatethan kumis; Xoossaa aadho keehatethay iya bolla de7ees.<verse eid="LUK 2:40" /></para>
  <para style="s1">Yesuusi Xoossa Keethan</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 2:41" />Yoosefaranne Mayraamira Paasika Ba7aale bonchanaw laythan laythan Yerusalaame boosona.<note caller="-" style="x"><char style="xo" closed="false">2:41 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">Kessa 12:1-27</ref>; <ref loc="DEU 16:1-8">Zaare 16:1-8</ref>.</char></note> <verse eid="LUK 2:41" /><verse number="42" style="v" sid="LUK 2:42" />Yesuusas tammanne nam7u laythi gidiya wode kase meezetidaysada ba7aale bonchanaw bidosona. <verse eid="LUK 2:42" /><verse number="43" style="v" sid="LUK 2:43" />Baaliya bonchidaape guye soo simmiya wode na7ay Yesuusi Yerusalaamen attis. Shin Yoosefaranne Mayraamira I Yerusalaamen attoysa eribookona. <verse eid="LUK 2:43" /><verse number="44" style="v" sid="LUK 2:44" />I soo simmiya asaara wolla de7iya daanin enti issi gallasa oge bidosona. I baynaysa eridaape guye banta dabbotanne laggeta matan koydosona. <verse eid="LUK 2:44" /><verse number="45" style="v" sid="LUK 2:45" />I yan dhayin koyishe guye Yerusalaame gakanaw bidosona.<verse eid="LUK 2:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 2:46" />Heedzu gallasape guye xoossa keethan astamaareta giddon uttidi entaba si7ishenne enta oychishe de7ishin demmidosona. <verse eid="LUK 2:46" /><verse number="47" style="v" sid="LUK 2:47" />Iya si7iya ubbay iya akeekaninne zaaruwan malaaletidosona.<verse eid="LUK 2:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 2:48" />Soo asay iya demmida wode malaaletidosona. Iya aayaka, “Ta na7aw, ayis nuna haysada oothadii? Ne aawaranne taara nena koyishe un7etida” yaagasu.<verse eid="LUK 2:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 2:49" />Yesuusi entako, “Tana ayis koyeetii? Ta, ta aawa keethan daanaw besseysa ereketi” yaagis. <verse eid="LUK 2:49" /><verse number="50" style="v" sid="LUK 2:50" />Shin I entako gidaba enti akeekibokona.<verse eid="LUK 2:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 2:51" />Hessafe guye, entara issife Naazirete katama bis. Entaw kiitetishe de7is. Iya aayiya he ubbaa ba wozanan wothada naagasu. <verse eid="LUK 2:51" /><verse number="52" style="v" sid="LUK 2:52" />Yesuusi, cincatethan, geesaninne teeman Xoossaa sinthaninne asa sinthan diccis.<note caller="-" style="x"><char style="xo" closed="false">2:52 </char><char style="xt" closed="false"><ref loc="1SA 2:26">1 Same 2:26</ref>; <ref loc="PRO 3:4">Leemi 3:4</ref>.</char></note><verse eid="LUK 2:52" /></para>
  <chapter eid="LUK 2" />
  <chapter number="3" style="c" sid="LUK 3" />
  <para style="s1">Xammaqiya Yohaanisi Oge Pitees</para>
  <para style="r">(<ref loc="MAT 3:1-12">Maato 3:1-12</ref>; <ref loc="MRK 1:1-8">Mar 1:1-8</ref>; <ref loc="JHN 1:19-28">Yoha 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 3:1" />Kawoy Xibaryoosi Roome biittan kawotin, tammanne ichashantho laythan, Phenxe Philaxoosi Yihuda haariya wode, Herodiisi Galila haariya wode, iya ishaa Filphoosi Ixuuriyasanne Xirakondoosa haariya wode, Lisaniyoosi Ablaanisa haariya wode, <verse eid="LUK 3:1" /><verse number="2" style="v" sid="LUK 3:2" />Haannaranne Qayyaafara kahine halaqa gidi de7ishin, Xoossaa qaalay Zakaryaasa na7aa Yohaanisako mela biitta yis. <figure style="fig" alt="High priest" file="HK00267B.tif" size="col" ref="3:2">Kahine Halaqa</figure> <verse eid="LUK 3:2" /><verse number="3" style="v" sid="LUK 3:3" />Yohaanisi, “Hinte nagaraape simmitenne xammaqetite. Xoossay hinte nagaraa atto gaana” yaagidi tamaarsishe Yordaanose Shaafa heeran de7iya biitta ubbaa bis. <verse eid="LUK 3:3" /><verse number="4" style="v" sid="LUK 3:4" />Hessika nabey Isayaasi ba maxaafan,<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="ISA 40:3-5">Isa 40:3-5</ref>.</char></note></para>
  <para style="q1" vid="LUK 3:4">“Mela biittan ba qaala dhoqu oothidi,</para>
  <para style="q2" vid="LUK 3:4">waassiya uraa qaalay,</para>
  <para style="q1" vid="LUK 3:4">‘Godaa ogiya giigisite,</para>
  <para style="q2" vid="LUK 3:4">horogaaka piddi oothite.<verse eid="LUK 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="LUK 3:5" />Aafo ubbay kumana,</para>
  <para style="q2" vid="LUK 3:5">zumaynne derey ziqi gaana.</para>
  <para style="q1" vid="LUK 3:5">Wobbe ogey luulana,</para>
  <para style="q2" vid="LUK 3:5">giigonna horogay qinxi gaana.<verse eid="LUK 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="LUK 3:6" />Asho ma7ida ubbay,</para>
  <para style="q2" vid="LUK 3:6">Xoossaa ashuwa be7ana’ ”</para>
  <para style="m" vid="LUK 3:6">gidi xaafidaysada hanis.<verse eid="LUK 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 3:7" />Yohaanisi, ba kushen xammaqetanaw yida asaako, “Hinteno, shoosha nayto yaanaw de7iya hanquwafe attana mela hintena zoriday oonee?<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Maato 12:34</ref>; <ref loc="MAT 23:33">23:33</ref>.</char></note> <verse eid="LUK 3:7" /><verse number="8" style="v" sid="LUK 3:8" />Hiza, hinte simuwa qoncisiya lo77o ooso oothite, hinte wozanan, ‘Nuus, nu aaway Abrahaamey de7ees gidi ceeqetofite.’ Haa si7ite, ha shuchatape Xoossay Abrahaames na7a kessanaw danda7ees.<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="JHN 8:33">Yoha 8:33</ref>.</char></note> <verse eid="LUK 3:8" /><verse number="9" style="v" sid="LUK 3:9" />Heko, beexey mithaa xaphon de7ees. Hiza, lo77o ayfe ayfonna mitha ubbay qanxetidi taman yegetana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MAT 7:19">Maato 7:19</ref>.</char></note><verse eid="LUK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 3:10" />Asay, “Yaatin nuuni ay oothinoo?” yaagidi oychidosona.<verse eid="LUK 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 3:11" />Yohaanisi zaaridi, “Nam7u afili de7iya asi baynaysas immo. Kathi de7eysi baynaysas immo” yaagis.<verse eid="LUK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 3:12" />Qaraxa qanxiseysati xammaqetanaw yidi, “Astamaariyaw, nuuni ay oothinoo?” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LUK 7:29">Luqa 7:29</ref>.</char></note><verse eid="LUK 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 3:13" />I zaaridi, “Hinte qanxisanaw kiitetoysafe aathidi ekofite” yaagis. <verse eid="LUK 3:13" /><verse number="14" style="v" sid="LUK 3:14" />Qassi wotaadareti yidi, “Nuuni ay oothinoo” yaagidi oychidosona.</para>
  <para style="p" vid="LUK 3:14">Yohaanisi, “Oodebaaka wolqan dafidi ekofite, oonaka wordon mootopite, hinte damoozey hintew gido; ufaytidi de7ite” yaagis.<verse eid="LUK 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 3:15" />Asay Kiristoosa naagishe de7iya gisho, Yohaanisa, “I Kiristoosa gidandesha?” gidi qopidosona. <verse eid="LUK 3:15" /><verse number="16" style="v" sid="LUK 3:16" />Yohaanisi ubbaas zaaridi, “Taani hintena haathan xammaqayis, shin taape aadhidi wolqaameysi yaana. Taani iya caammaa wodoruwa billanaw bessonna asi. I hintena Geeshsha Ayyaananinne taman xammaqana. <verse eid="LUK 3:16" /><verse number="17" style="v" sid="LUK 3:17" />Wudumman de7iya kathaa polo geeshshanaw pithey iya kushen de7ees. Geeshsha kathaa ba shaaliyan qolana; kaliya dhayonna taman xuuggana” yaagis.<verse eid="LUK 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 3:18" />Qassi Yohaanisi asaa daro zore zoridi Wongela<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="fqa" closed="false">Wongela: </char><char style="ft" closed="false">Girike doonan Wongela geetetiya qaalay daro ufaysiya oda woyko mishiraacho guussu. He mishiraachoyka Kiristoosi asa koche ubbaa merinaa pirdaafe ashshanaw kiitetidi yida gita ufaysaa (</char><char style="xt"><ref loc="LUK 1:19">Luqa 1:19</ref>; <ref loc="LUK 2:10">2:10</ref></char>).</note> odis.<verse eid="LUK 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 3:19" />Shin Yohaanisi Herodiisi ba ishaa machiw, Herodiyada, ekida gishonne haraa iita oosota gisho hanqeetida wode,<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="MAT 14:3-4">Maato 14:3-4</ref>; <ref loc="MRK 6:17-18">Mar 6:17-18</ref>.</char></note> <verse eid="LUK 3:19" /><verse number="20" style="v" sid="LUK 3:20" />Herodiisi kaseysa bolla haraba ubbaa gujidi Yohaanisa woyne gelsis.<verse eid="LUK 3:20" /></para>
  <para style="s1">Yesuusa Xammaqetethi</para>
  <para style="r">(<ref loc="MAT 1:1-17">Maato 1:1-17</ref>; <ref loc="MAT 3:13-17">3:13-17</ref>; <ref loc="MRK 1:9-11">Mar 1:9-11</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 3:21" />Yohaanisi qashetanaape sinthe asaa ubbaa xammaqidi simmin, qasi Yesuusika xammaqetis. I woossishin saloy dooyetis. <verse eid="LUK 3:21" /><verse number="22" style="v" sid="LUK 3:22" />Geeshsha Ayyaanay holleda bentishe iya bolla uttis. Salope “Taani dosiya na7ay nena; ne tana ufaysaasa” giya qaalay yis.<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Medhe 22:2</ref>; <ref loc="PSA 2:7">Maz 2:7</ref>; <ref loc="ISA 42:1">Isa 42:1</ref>; <ref loc="MAT 3:17">Maato 3:17</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 9:35">Luqa 9:35</ref>.</char></note><verse eid="LUK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 3:23" />Yesuusi tamaarso oykiya wode iyaw hastamu laythi gidishin, asay iya Yoosefa na7a gidi qopis.</para>
  <para style="q1" vid="LUK 3:23">Yoosefi Eele na7a, <verse eid="LUK 3:23" /><verse number="24" style="v" sid="LUK 3:24" />Eeley Mata na7a,</para>
  <para style="q1" vid="LUK 3:24">Mati Leewe na7a, Leewey Malka na7a,</para>
  <para style="q1" vid="LUK 3:24">Malki Yoona na7a, Yooni Yoosefa na7a,<verse eid="LUK 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 3:25" />Yoosefi Mataata na7a, Mataati Amoxe na7a,</para>
  <para style="q1" vid="LUK 3:25">Amoxey Nahoome na7a, Nahoomey Asiliime na7a,</para>
  <para style="q1" vid="LUK 3:25">Asiliimey Naage na7a, <verse eid="LUK 3:25" /><verse number="26" style="v" sid="LUK 3:26" />Naagey Ma7aate na7a,</para>
  <para style="q1" vid="LUK 3:26">Ma7aatey Mataata na7a, Mataati Samaye na7a,<verse eid="LUK 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LUK 3:27" />Samayey Yihuda na7a, Yihudi Yonaana na7a, Yoonaney Rase na7a,</para>
  <para style="q1" vid="LUK 3:27">Rasey Zarubaabela na7a, Zarubaabeli Salatiyaala na7a,</para>
  <para style="q1" vid="LUK 3:27">Salatiyaali Neera na7a, <verse eid="LUK 3:27" /><verse number="28" style="v" sid="LUK 3:28" />Neeri Malka na7a,</para>
  <para style="q1" vid="LUK 3:28">Malki Hade na7a, Hadi Qoosama na7a,</para>
  <para style="q1" vid="LUK 3:28">Qoosami Elmodaana na7a, Elmodaani Era na7a,<verse eid="LUK 3:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="LUK 3:29" />Eri Yoose7a na7a, Yoose7i Alaazara na7a,</para>
  <para style="q1" vid="LUK 3:29">Alaazari Yoraame na7a, Yoraamey Mata na7a,</para>
  <para style="q1" vid="LUK 3:29">Mata Leewe na7a, <verse eid="LUK 3:29" /><verse number="30" style="v" sid="LUK 3:30" />Leewey Simoona na7a,</para>
  <para style="q1" vid="LUK 3:30">Simooni Yihuda na7a, Yihudi Yoosefa na7a,</para>
  <para style="q1" vid="LUK 3:30">Yoosefi Yonaana na7a, Yoonaney Eliyaqeeme na7a,<verse eid="LUK 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="LUK 3:31" />Eliyaqeemi Maliya na7a, Maliyi Maynaane na7a,</para>
  <para style="q1" vid="LUK 3:31">Maynaaney Mata na7a, Mati Naatana na7a,</para>
  <para style="q1" vid="LUK 3:31">Naatani Dawita na7a, <verse eid="LUK 3:31" /><verse number="32" style="v" sid="LUK 3:32" />Dawiti Isseye na7a,</para>
  <para style="q1" vid="LUK 3:32">Isseyey Iyobeeda na7a, Iyobeedi Boo7eza na7a,</para>
  <para style="q1" vid="LUK 3:32">Boo7ezi Salmoona na7a, Salmoona Na7asoona na7a,<verse eid="LUK 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="LUK 3:33" />Na7asooni Amnadaabe na7a, Amnadaabey Raame na7a, Raamey Arne na7a,</para>
  <para style="q1" vid="LUK 3:33">Arney Asroome na7a, <verse eid="LUK 3:33" /><verse number="34" style="v" sid="LUK 3:34" />Asroomey Faaresa na7a,</para>
  <para style="q1" vid="LUK 3:34">Faaresi Yihuda na7a,</para>
  <para style="q1" vid="LUK 3:34">Yihudi Yayqooba na7a,</para>
  <para style="q1" vid="LUK 3:34">Yayqoobi Yisaaqa na7a, Yisaaqi Abrahaame na7a,</para>
  <para style="q1" vid="LUK 3:34">Abrahaamey Taara na7a, <verse eid="LUK 3:34" /><verse number="35" style="v" sid="LUK 3:35" />Taari Nakoora na7a,</para>
  <para style="q1" vid="LUK 3:35">Naakorey Saruga na7a, Sarugi Rehu na7a,</para>
  <para style="q1" vid="LUK 3:35">Rehuy Faleqa na7a, Faleqi Ebeera na7a,</para>
  <para style="q1" vid="LUK 3:35">Ebeeroy Seela na7a, <verse eid="LUK 3:35" /><verse number="36" style="v" sid="LUK 3:36" />Seeli Qaynama na7a,</para>
  <para style="q1" vid="LUK 3:36">Qaynami Arfakisaade na7a, Arfakisaadi Seema na7a,</para>
  <para style="q1" vid="LUK 3:36">Seemi Nohe na7a, Nohey Laameha na7a,<verse eid="LUK 3:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="LUK 3:37" />Laamehi Matusaala na7a, Matusaali Heenoke na7a,</para>
  <para style="q1" vid="LUK 3:37">Heenokey Yaareda na7a, Yaaredi Malal7eela na7a,</para>
  <para style="q1" vid="LUK 3:37">Malal7eeli Qaynana na7a, <verse eid="LUK 3:37" /><verse number="38" style="v" sid="LUK 3:38" />Qaynani Henoosa na7a,</para>
  <para style="q1" vid="LUK 3:38">Henoosi Seeta na7a, Seeti Addaame na7a,</para>
  <para style="q1" vid="LUK 3:38">Addaamey Xoossaa na7a.<verse eid="LUK 3:38" /></para>
  <chapter eid="LUK 3" />
  <chapter number="4" style="c" sid="LUK 4" />
  <para style="s1">Yesuusi Paacetethi</para>
  <para style="r">(<ref loc="MAT 4:1-11">Maato 4:1-11</ref>; <ref loc="MRK 1:12-13">Mar 1:12-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 4:1" />Yesuusi Geeshsha Ayyaanan kumidi Yordaanose Shaafape simmida mela Ayyaanay iya mela biitta efis. <verse eid="LUK 4:1" /><verse number="2" style="v" sid="LUK 4:2" />Yan oytamu gallasinne qamma xalahen paacetis. He gallasatan aykoka moonna gam7ida gisho wursethan koshatis.<verse eid="LUK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 4:3" />Xalahey iyako, “Neeni Xoossaa na7a gidiko ane haysi shuchay uythu gido gada kiitta” yaagis.<verse eid="LUK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 4:4" />Yesuusi zaaridi, “Asi uytha xalaalan deenna geetetidi xaafetis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">Zaare 8:3</ref>.</char></note><verse eid="LUK 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 4:5" />Hessafe guye, Xalahey Yesuusa adussa dere bolla kessidi ha alamiya kawotethata ayfe qiphi zaaranaw bessis. <verse eid="LUK 4:5" /><verse number="6" style="v" sid="LUK 4:6" />Xalahey, “Ha ubbaas maataynne bonchoy taw imetis. Taani dosida oodeska immiya gisho new immana. <verse eid="LUK 4:6" /><verse number="7" style="v" sid="LUK 4:7" />Hessa gisho, neeni taw goyinniko ubbay new gidana” yaagis.<verse eid="LUK 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 4:8" />Yesuusi zaaridi, “Ne Godaa, ne Xoossaa, iya xalaala goyinna geetetidi xaafetis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 6:13">Zaare 6:13</ref>.</char></note><verse eid="LUK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 4:9" />Wursethan Xalahey Yesuusa Yerusalaame efidi Xoossa Keethas huuphiya bolla essidi, “Neeni Xoossaa na7a gidiko ane duge sa7an nena yegga. <verse eid="LUK 4:9" /><verse number="10" style="v" sid="LUK 4:10" />Ayis giiko,</para>
  <para style="q1" vid="LUK 4:10">“ ‘Nena naagiya Kiitanchota</para>
  <para style="q2" vid="LUK 4:10">Xoossay ne gisho kiittana.<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">Maz 91:11-12</ref>.</char></note><verse eid="LUK 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="LUK 4:11" />Enti ne tohoy shuchan dhubetonna mela,</para>
  <para style="q2" vid="LUK 4:11">banta kushiyan dhoqu oothidi nena denthana’ geetetidi xaafetis”</para>
  <para style="m" vid="LUK 4:11">yaagis.<verse eid="LUK 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 4:12" />Yesuusi zaaridi, “Ne Godaa Xoossaa paacofa geetetidi xaafetis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="DEU 6:16">Zaare 6:16</ref>.</char></note><verse eid="LUK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 4:13" />Xalahey Yesuusa paaciya wursidaape guye hara inje wode demmana gakanaw iyape shaaketis.<verse eid="LUK 4:13" /></para>
  <para style="s1">Yesuusi Galilan Tamaarso Doometha</para>
  <para style="r">(<ref loc="MAT 4:12-17">Maato 4:12-17</ref>; <ref loc="MRK 1:14-15">Mar 1:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 4:14" />Yesuusi Ayyaana wolqan kumidi Galila simmis. Iya sunthay heeran de7iya biitta ubban keyis. <verse eid="LUK 4:14" /><verse number="15" style="v" sid="LUK 4:15" />I ayhude woosa keethi gelidi tamaarsis; asa ubbay iya galatidosona.<verse eid="LUK 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 4:16" />Yaape I diccida katamaa Naazirete yis. Kase meezetidaysada Sambaata gallas ayhude woosa keethi gelis. Nabbabanawuka dendi eqis. <verse eid="LUK 4:16" /><verse number="17" style="v" sid="LUK 4:17" />Nabiya Isayaasa maxaafay iyaw imetin, dooyidi, haysada yaagidi xaafetidaysa demmis:<verse eid="LUK 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="LUK 4:18" />“Godaa Ayyaanay ta bolla de7ees,</para>
  <para style="q2" vid="LUK 4:18">manqotas Wongela odana mela</para>
  <para style="q2" vid="LUK 4:18">Xoossay tana dooris.</para>
  <para style="q1" vid="LUK 4:18">Qashetidaysatas biletethi,</para>
  <para style="q2" vid="LUK 4:18">qooqidaysata xeelisanaasinne</para>
  <para style="q2" vid="LUK 4:18">un7etidaysata birshana mela,<note caller="-" style="x"><char style="xo" closed="false">4:18 </char><char style="xt" closed="false"><ref loc="ISA 61:1-2">Isa 61:1-2</ref>.</char></note><verse eid="LUK 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="LUK 4:19" />Xoossay keehanaw qopida laytha odana mela tana kiittis”</para>
  <para style="m" vid="LUK 4:19">yaagis.<verse eid="LUK 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 4:20" />Hessafe guye, maxaafaa xaaxidi haggaazeysas immidi tamaarsanaw uttis. Ayhude woosa keethan de7iya asati ubbay caddi xeelloosona. <verse eid="LUK 4:20" /><verse number="21" style="v" sid="LUK 4:21" />I, “Haysi hinte haythan hinte si7iya ha maxaafaa qaalay hachi poletis” yaagis.<verse eid="LUK 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 4:22" />Ubbay iyabaa darsidi odetoosona. Qassi iya doonape keyiya aadho keehatethan kumida qaalan malaaletishe, “Haysi Yoosefa na7aa gidenneyee?” yaagidosona.<verse eid="LUK 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 4:23" />I, “ ‘Neno dhale aawaw nena ashsha, Qifirnahooman ne oothidaba nu si7oysa qassi haysan ne kataman ootha’ giya leemisuwan hinte tana gaanaysas sidhey baawa” yaagis. <verse eid="LUK 4:23" /><verse number="24" style="v" sid="LUK 4:24" />Qassi, “Tuma odayis; nabey ba yeletida biittan bonchetenna.<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="JHN 4:44">Yoha 4:44</ref>.</char></note><verse eid="LUK 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 4:25" />“Ta hintew tuma odayis; saloy heedzu laythinne bagga gordetin mino koshi biitta ubban de7iya Eeliyaasa wode daro am7eti Isra7eelen de7oosona.<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 Kawo 17:1</ref>.</char></note> <verse eid="LUK 4:25" /><verse number="26" style="v" sid="LUK 4:26" />Eeliyaasi entafe issinnekoka kiitetibeenna. Shin Saraptan de7iya am7eeko kiitetis.<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="1KI 17:8-16">1 Kawo 17:8-16</ref>.</char></note> <verse eid="LUK 4:26" /><verse number="27" style="v" sid="LUK 4:27" />Nabiya Elsa wode Isra7eelen daro baro harganchoti de7oosona. Shin Soore uraa Ni7imaanepe attishin, oonika paxibeenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="2KI 5:1-14">2 Kawo 5:1-14</ref>.</char></note><verse eid="LUK 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 4:28" />Ayhude woosa keethan de7iya asa ubbay hessa si7ida wode daro yilotidosona. <verse eid="LUK 4:28" /><verse number="29" style="v" sid="LUK 4:29" />Banta uttida bessaafe dendidi dere bolla keexetida katamaape gaxa kessidi sugi yeddanaw aafo doona efidosona. <verse eid="LUK 4:29" /><verse number="30" style="v" sid="LUK 4:30" />Shin I enta giddora kanthidi aadhis.<verse eid="LUK 4:30" /></para>
  <para style="s1">Yesuusi Tuna Ayyaana Kessis</para>
  <para style="r">(<ref loc="MRK 1:21-28">Mar 1:21-28</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 4:31" />Yaape Galila biittan de7iya Qifirnahooma katamaa bis. Yan Sambaata gallas asaa tamaarsis. <verse eid="LUK 4:31" /><verse number="32" style="v" sid="LUK 4:32" />I tamaarsey maatara gidiya gisho ubbay iya timirtiyan malaaletidosona.<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="MAT 7:28-29">Maato 7:28-29</ref>; <ref loc="PSA 91:11-12">Maz 91:11-12</ref>.</char></note><verse eid="LUK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 4:33" />Ayhude woosa keethan tuna ayyaanay oykida uray de7ees. <verse eid="LUK 4:33" /><verse number="34" style="v" sid="LUK 4:34" />I, “Naazirete Yesuusa nuna ayis waaysay nuupe haaka; neeni yiday nuna dhaysanaseyee? Neeni ooneko taani erayis. Neeni Xoossaafe yida Geeshsha” yaagidi waassis.<verse eid="LUK 4:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 4:35" />Yesuusi tuna ayyaanako, “Si7i gada ha uraape keya” yaagidi hanqis. Tuna ayyaanay uraa asaa ubbaa sinthan holi yeggidi aykoka qohonna yeddidi keyis.<verse eid="LUK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 4:36" />Asa ubbay malaaletidosona. Woliko, “Hanos, haysi aybi timirtee? Tuna ayyaanata maataninne wolqan kiittees; entika keyoosona” yaagidosona. <verse eid="LUK 4:36" /><verse number="37" style="v" sid="LUK 4:37" />Iya sunthay heera ubban keyis.<verse eid="LUK 4:37" /></para>
  <para style="s1">Yesuusi Daro Harganchota Pathis</para>
  <para style="r">(<ref loc="MAT 8:14-17">Maato 8:14-17</ref>; <ref loc="MRK 1:29-34">Mar 1:29-34</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 4:38" />Hessafe guye, Yesuusi ayhude woosa keethafe keyidi Simoona soo gelis. Simoona mache aayiya mino qoxo misha hargen saketasu. Iyo pathana mela Yesuusa woossidosona. <verse eid="LUK 4:38" /><verse number="39" style="v" sid="LUK 4:39" />I hiixako shiiqi hokidi I hargiya hanqis. Mishay aggin ellesa dendada enta mokasu.<verse eid="LUK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 4:40" />Away wullana hanishin dumma dumma hargiyan oyketida asaa iyako ehidosona. I issuwa issuwa bolla ba kushiya wothidi pathis. <verse eid="LUK 4:40" /><verse number="41" style="v" sid="LUK 4:41" />Tuna ayyaanati qassi, “Neeni, Xoossaa na7aa” gidi waassishe daro asaape keyidosona. Shin I entana hanqis. I Kiristoosa gideysa enti eriya gisho, issibaaka odetonna mela diggis.<verse eid="LUK 4:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 4:42" />Buroo wontiya wode Yesuusi issi geema bessi bis. Asay koyishe I de7iya bessaa yidosona. Entafe I shaaketidi boonna mela digganaw koydosona. <verse eid="LUK 4:42" /><verse number="43" style="v" sid="LUK 4:43" />Shin I, “Taani hara katamata bada Xoossaa kawotethaa Wongela markatanaw bessees. Ta kiitetiday hessasa” yaagis. <verse eid="LUK 4:43" /><verse number="44" style="v" sid="LUK 4:44" />Yihuda biittan de7iya ayhude woosa keethan sabbakis.<verse eid="LUK 4:44" /></para>
  <chapter eid="LUK 4" />
  <chapter number="5" style="c" sid="LUK 5" />
  <para style="s1">Koyro Tamaareta Xeegethaa</para>
  <para style="r">(<ref loc="MAT 4:18-22">Maato 4:18-22</ref>; <ref loc="MRK 1:16-20">Mar 1:16-20</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 5:1" />Issi gallas Yesuusi Gensareexe Abbaa matan eqidashin daro asay iya yuushuwa un7ethidi, I tamaarsiya Xoossaa qaala si7oosona.<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="MAT 13:1-2">Maato 13:1-2</ref>; <ref loc="MRK 3:9-10">Mar 3:9-10</ref>; <ref loc="MRK 4:1">4:1</ref>.</char></note> <verse eid="LUK 5:1" /><verse number="2" style="v" sid="LUK 5:2" />Yan haatha gaxan de7iya nam7u wogolota be7is. Molo oykiya asati wogolotape wodhidi banta gitiya meeccosona. <figure style="fig" alt="Fisher men in their fishing boat" file="HK00208B.tif" size="col" ref="5:2">Molo Oykiya Ase</figure> <verse eid="LUK 5:2" /><verse number="3" style="v" sid="LUK 5:3" />He wogolotape Simoonaysan gelidi biittafe guuthi giddo shiishana mela oychis. Yaatidi, he wogoluwa bolla uttidi asaa tamaarsis.<verse eid="LUK 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 5:4" />Ba timirtiya ongidaape guye Simoonako, “Gede ciimmuwako shiishada moluwa oykanaw hinte gitiya yeggite” yaagis.<verse eid="LUK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 5:5" />Simooni zaaridi, “Astamaariyaw, qamma kumethi daaburishe aqidi aykoka oykibooko, shin ne giiko gitiya yeggana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="JHN 21:3">Yoha 21:3</ref>.</char></note><verse eid="LUK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 5:6" />Enti gitiya yeggida wode gitey daaketana gakanaw daro molo oykidosona.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="JHN 21:6">Yoha 21:6</ref>.</char></note> <verse eid="LUK 5:6" /><verse number="7" style="v" sid="LUK 5:7" />Hara wogolon de7iya banta laggeti yidi, bantana maaddana mela wuttidi xeegidosona. Enti yidi nam7u wogoloti, haathan mitettana gakanaw molon kunthidosona.<verse eid="LUK 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 5:8" />Simoon Phexroosi hessa be7ida wode, Yesuusa sinthan kundidi, “Godaw, taani nagarancho asi gidiya gisho, taape shaaketa” yaagis. <verse eid="LUK 5:8" /><verse number="9" style="v" sid="LUK 5:9" />I hessa giday, inne iyara de7eysati oykida moluwa darotethan malaaletida gishosa. <verse eid="LUK 5:9" /><verse number="10" style="v" sid="LUK 5:10" />Qassi Simoona lagge gidida Zabdiyoosa nayti Yayqoobaranne Yohaanisara malaaletidosona. Yesuusi Simoonako, “Babofa! Hizape neeni ase oykiya asi gidana” yaagis. <verse eid="LUK 5:10" /><verse number="11" style="v" sid="LUK 5:11" />Enti wogolota gaxa shiishidaape guye ubbaa aggidi Yesuusa kaallidosona.<verse eid="LUK 5:11" /></para>
  <para style="s1">Baro Harganchoy Paxis</para>
  <para style="r">(<ref loc="MAT 8:1-4">Maato 8:1-4</ref>; <ref loc="MRK 1:40-45">Mar 1:40-45</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 5:12" />Yesuusi katamatape issuwan de7ishin issi baro hargen<note caller="+" style="f"><char style="fr" closed="false">5:12 </char><char style="fqa" closed="false">Baro harge: </char><char style="ft" closed="false">Baro hargey asa galba bolla keyiya harge. Isra7eele biittan baro harganchoti hara asaape dummatidi de7oosonape attishin, asaara gahetokona.</char></note> oyketida asi he kataman de7ees. He uray Yesuusa be7idi iya sinthan gufannidi, “Godaw, ne shene gidiko tana geeshshanaw danda7aasa” gidi woossis.<verse eid="LUK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 5:13" />Yesuusi ba kushiya yeddi bochidi, “Ee, ta shene; geeyiya” yaagis. Iira baro hargey uraape kichis.<verse eid="LUK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 5:14" />Yesuusi, “Haysa oodeska odopa, shin bada nenatethaa Ayhude kahine bessa. Ne geeyidaysas marka gidana mela Musey kiitida yarsho yarsha” gidi kiittis.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Leewe 14:1-32</ref>.</char></note><verse eid="LUK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 5:15" />Gidoshin, iya sunthay kasepe aadhidi eretishe bis. Daro asay I odiyaba si7anawunne banta hargiyafe paxanaw yoosona. <verse eid="LUK 5:15" /><verse number="16" style="v" sid="LUK 5:16" />Shin Yesuusi daro wode geema bessi bidi woossees.<verse eid="LUK 5:16" /></para>
  <para style="s1">Gunda Ura</para>
  <para style="r">(<ref loc="MAT 9:1-8">Maato 9:1-8</ref>; <ref loc="MRK 2:1-12">Mar 2:1-12</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 5:17" />Issi gallas Yesuusi tamaarsishin Galilapenne Yihuda heera ubbaafe qassi Yerusalaamepe yida Farsaawetinne higge astamaareti yan uttidosona. Asaa pathiya Godaa wolqayka iyara de7ees. <verse eid="LUK 5:17" /><verse number="18" style="v" sid="LUK 5:18" />He wode asay issi gunda asi halara tookidi ehidosona. Soo gelsidi iya sinthan wothanaw qopidosona. <verse eid="LUK 5:18" /><verse number="19" style="v" sid="LUK 5:19" />Shin asaa darotethaafe dendoysan soo gelsanaw xoonetidi keethaa bolla keyidi, kaara qawuxidi, harganchuwa halara asaa shaakidi Yesuusa sinthan yeggidosona.<verse eid="LUK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 5:20" />Yesuusi enta ammanuwa be7idi, “La addiyaw, ne nagaray atto geetetis” yaagis.<verse eid="LUK 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 5:21" />Higge astamaaretinne Farsaaweti, “Haysi Xoossaa bolla yaagidi odetey oonee? Issi Xoossafe attishin, hari nagara atto gaanaw danda7ey oonee?” yaagidi qopidosona.<verse eid="LUK 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 5:22" />Yesuusi enta qofaa erida gisho entako, “Hinte wozanan hessatho ayis qopeetii? <verse eid="LUK 5:22" /><verse number="23" style="v" sid="LUK 5:23" />‘Ne nagaray qushetis geysafenne dendada ba geysafe awusi kawuyii?’ <verse eid="LUK 5:23" /><verse number="24" style="v" sid="LUK 5:24" />Shin ta hessa giday Asa Na7i sa7a bolla nagara ato gaanaw maati de7eysa hinte erana melasa.” Hessafe kaallidi, gunda uraako, “Denda; ne algaa tookada ne soo ba” yaagis. <verse eid="LUK 5:24" /><verse number="25" style="v" sid="LUK 5:25" />I ellesi dendidi enta sinthan eqis; I tooketidi yida algaa tookidi Xoossaa galatishe ba soo bis. <verse eid="LUK 5:25" /><verse number="26" style="v" sid="LUK 5:26" />He wode ubbayka malaaletidosona. Xoossaa galatishe, “Hachi gita malaata be7ida” yaagidi yashetidosona.<verse eid="LUK 5:26" /></para>
  <para style="s1">Leewe Xeegetetha</para>
  <para style="r">(<ref loc="MAT 9:9-13">Maato 9:9-13</ref>; <ref loc="MRK 2:13-17">Mar 2:13-17</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 5:27" />Hessafe guye, Yesuusi yaape keyidi bis. Leewe geetetiya issi qaraxa qanxiseysi qaraxa qanxisiya bessan uttidaysa be7idi, “Tana kaalla” yaagis. <verse eid="LUK 5:27" /><verse number="28" style="v" sid="LUK 5:28" />I ubbaba aggidi, dendidi iya kaallis.<verse eid="LUK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 5:29" />He Leewey ba son gita gibira giigisis. Daro qaraxa qanxiseysatinne hara asati katha bolla uttidosona. <verse eid="LUK 5:29" /><verse number="30" style="v" sid="LUK 5:30" />Farsaawetinne higge astamaareti, “Qaraxa qanxeysataranne nagaranchotara ayis meetinne uyeetii?” yaagidi Yesuusa tamaareta bolla zuuzumidosona.<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">Luqa 15:1-2</ref>.</char></note><verse eid="LUK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 5:31" />Yesuusi entako, “Harganchotasafe attishin, paxatas aakime koshshenna. <verse eid="LUK 5:31" /><verse number="32" style="v" sid="LUK 5:32" />Taani nagaranchota maarotako zaaranaasafe attishin, geeshshata xeeganaw yabiike” yaagidi zaaris.<verse eid="LUK 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 5:33" />Enti Yesuusako, “Yohaanisa tamaareti daro wode xoomosona, woossosona; qassi Farsaaweta tamaaretika hessatho oothosona. Shin neysati ubba wode moosonanne uyoosona” yaagidosona.<verse eid="LUK 5:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 5:34" />Yesuusi entako, “Machiw ekeysi entara de7ishin xeegetida asay xoomana mela oothanaw danda7eetii? <verse eid="LUK 5:34" /><verse number="35" style="v" sid="LUK 5:35" />Shin mushuray entafe shaaketana gallasay yaana, he wode enti xoomana.”<verse eid="LUK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 5:36" />Qassi yaagidi leemiso odis; “Ooratha ma7ope peedhidi gal7a ma7o bolla sikey oonika baawa. Hessatho oothiko ooratha ma7uwa peedhees, oorathay gal7aas giigenna. <verse eid="LUK 5:36" /><verse number="37" style="v" sid="LUK 5:37" />Mal7anto woyne gal7a ogoron qoliya oonika baawa. Hessa oothiko, ooratha woyney gal7a ogoruwa dhusees; woyney gukees ogoroyka maaddonnaba gidees. <verse eid="LUK 5:37" /><verse number="38" style="v" sid="LUK 5:38" />Hessa gisho, ooratha woyney ooratha ogoron qolettanaw bessees. <verse eid="LUK 5:38" /><verse number="39" style="v" sid="LUK 5:39" />Hiza, caalay lo77o giya gisho, caala woyne uyi simmidi mal7anto koyey oonika baawa” yaagis.<verse eid="LUK 5:39" /></para>
  <chapter eid="LUK 5" />
  <chapter number="6" style="c" sid="LUK 6" />
  <para style="s1">Sambaata Bonchanaw Bessii?</para>
  <para style="r">(<ref loc="MAT 12:1-8">Maato 12:1-8</ref>; <ref loc="MRK 2:23-28">Mar 2:23-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 6:1" />Issi Sambaata gallas Yesuusi giste gade giddora aadhees. Yesuusa tamaareti tiya banga duuthidi banta kushen shirkidi moosona.<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">Zaare 23:25</ref>.</char></note> <verse eid="LUK 6:1" /><verse number="2" style="v" sid="LUK 6:2" />Shin Farsaaweta giddofe issoti issoti, “Sambaata gallas oothanaw bessonnaba ayis oothetii?” yaagidosona.<verse eid="LUK 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 6:3" />Yesuusi entako zaaridi, “Dawiti koshatida wode baara de7eysatara issife oothoysa nabbabibeketii?<note caller="-" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 Same 21:1-6</ref>.</char></note> <verse eid="LUK 6:3" /><verse number="4" style="v" sid="LUK 6:4" />Xoossa Keethi gelidi Ayhude kahineta xalaalas bessiya daabbuwa mis; baara de7eysataska immis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Leewe 24:9</ref>.</char></note> <verse eid="LUK 6:4" /><verse number="5" style="v" sid="LUK 6:5" />Qassi Yesuusi, “Asa Na7ay Sambaata Godaa” yaagis.<verse eid="LUK 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 6:6" />Hara Sambaata gallas Yesuusi ayhude woosa keethi gelidi tamaarsees. He bessan ushacha kushey silida issi asi de7ees. <verse eid="LUK 6:6" /><verse number="7" style="v" sid="LUK 6:7" />Higge astamaaretinne Farsaaweti iya mootanaw gaaso koyidi Sambaata gallas pathiko be7ana gidi naagoosona. <verse eid="LUK 6:7" /><verse number="8" style="v" sid="LUK 6:8" />Shin Yesuusi enta qofaa eridi kushey silida uraako, “Dendada asaa giddon eqa” yaagis. Urayka dendi eqis.<verse eid="LUK 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 6:9" />Yesuusi, “Ane ta hintena issiba oychayis; Sambaata gallas oothanaw bessey lo77obayeye iitabayee? Shempo ashoye woyko dhayso?” yaagis.<verse eid="LUK 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 6:10" />Qassi Yesuusi iya yuushuwan de7iya asaa yuushshi xeellidi uraako, “Ne kushiya piddi ootha” yaagis. Urayka I gidaysada oothin kushey paxis. <verse eid="LUK 6:10" /><verse number="11" style="v" sid="LUK 6:11" />Shin higge astamaaretinne Farsaaweti daro yilotidosona. Yesuusa bolla ay oothino gidi banta giddon maqetidosona.<verse eid="LUK 6:11" /></para>
  <para style="s1">Tammanne Nam7u Hawaareta</para>
  <para style="r">(<ref loc="MAT 10:1-4">Maato 10:1-4</ref>; <ref loc="MRK 3:13-19">Mar 3:13-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 6:12" />He wode gallasatape issuwan Yesuusi woossanaw zuma bolla keyis. Qamma kumethi woossishe aqis. <verse eid="LUK 6:12" /><verse number="13" style="v" sid="LUK 6:13" />Wontethe ba tamaareta xeegidi enta giddofe tammanne nam7ata dooridi, entana, “Hawaareta” gidi sunthis. <verse eid="LUK 6:13" /><verse number="14" style="v" sid="LUK 6:14" />Entika, Phexroosa gidi sunthida Simoona, iya ishaa Indiriyasa, Yayqooba, Yohaanisa, Filphoosa, Bartelemoosa, <verse eid="LUK 6:14" /><verse number="15" style="v" sid="LUK 6:15" />Maatosa, Toomasa, Ilfiyoosa na7aa Yayqooba, ba biittas mishetiya Simoona, <verse eid="LUK 6:15" /><verse number="16" style="v" sid="LUK 6:16" />Yayqooba na7aa Yihudanne Yesuusa aathidi immida Asqoroota Yihuda.<verse eid="LUK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 6:17" />Yesuusi entara issife zumaape wodhidi demba bessan eqis. Iya tamaaretape daroti he bessan de7oosona. Yihuda biitta ubbaafe Yerusalaamepe, Xiroosapenne Sidoona abba gaxape yida daro asay de7ees. <verse eid="LUK 6:17" /><verse number="18" style="v" sid="LUK 6:18" />Enti yiday, I tamaarsiyaba si7anawunne banta hargiyafe paxanaasa. Tuna ayyaanan waayetiya asatika paxidosona. <verse eid="LUK 6:18" /><verse number="19" style="v" sid="LUK 6:19" />Wolqi iyape keyidi asa ubbaa pathiya gisho asay iya bochanaw koyoosona.<verse eid="LUK 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 6:20" />Ba tamaareta xeellidi haysada yaagis:</para>
  <para style="q1" vid="LUK 6:20">“Hinteno, manqoto, hinte anjetidaysata;</para>
  <para style="q2" vid="LUK 6:20">Xoossaa kawotethay hintesa.<verse eid="LUK 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="LUK 6:21" />Hinte ha77i koshateysati anjetidaysata,</para>
  <para style="q2" vid="LUK 6:21">hinte kallana.</para>
  <para style="q1" vid="LUK 6:21">Hinte ha77i yeekeysati anjetidaysata</para>
  <para style="q2" vid="LUK 6:21">hinte miicana.<verse eid="LUK 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="LUK 6:22" />Asay hintena Asa Na7aa gisho,</para>
  <para style="q2" vid="LUK 6:22">ixiya wode,</para>
  <para style="q2" vid="LUK 6:22">hintena hiliya wode,</para>
  <para style="q2" vid="LUK 6:22">hintena enti toochiya wodenne,</para>
  <para style="q2" vid="LUK 6:22">iita sunthu enti hintew immiya wode</para>
  <para style="q2" vid="LUK 6:22">hinte anjetidaysata.<note caller="-" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="PRO 4:14">Leemi 4:14</ref>.</char></note><verse eid="LUK 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 6:23" />“Heko, hinte woytoy salon gita gidiya gisho he wode ufaysan gupite. Ayis giiko, beni enta aawati nabeta bolla hessada oothidosona.”<note caller="-" style="x"><char style="xo" closed="false">6:23 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 Taari 36:16</ref>; <ref loc="ACT 7:52">Hawa 7:52</ref>.</char></note><verse eid="LUK 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="LUK 6:24" />“Shin dureto hintena ayye!</para>
  <para style="q2" vid="LUK 6:24">hinte ha77i lo77o duussaa ekideta.<verse eid="LUK 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="LUK 6:25" />Ha77i kallidaysato hintena ayye!</para>
  <para style="q2" vid="LUK 6:25">hinte koshatana.</para>
  <para style="q1" vid="LUK 6:25">Ha77i miiceysato hintenosho</para>
  <para style="q2" vid="LUK 6:25">hinte kayotananne yeekana.<verse eid="LUK 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="LUK 6:26" />Asi ubbay hinte lo77otetha xalaala odiya wode hintena ayye!</para>
  <para style="q2" vid="LUK 6:26">Enta aawati beni wordancho nabeta bolla hessada oothidosona.<verse eid="LUK 6:26" /></para>
  <para style="s1">Hinte Morketa Dosite</para>
  <para style="r">(<ref loc="MAT 5:38-48">Maato 5:38-48</ref>; <ref loc="MAT 7:12">7:12</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 6:27" />“Shin tana si7iya hintew ta odayis; hinte morketa dosite; hintena ixeysatas lo77oba oothite. <verse eid="LUK 6:27" /><verse number="28" style="v" sid="LUK 6:28" />Hintena baaddeyisata anjite, hintena naaqeysatas woossite. <verse eid="LUK 6:28" /><verse number="29" style="v" sid="LUK 6:29" />Issi bagga shakala baqeysas hanko bagga bessa. Ne laxana ekana geysas ne shamziya gujada imma. <verse eid="LUK 6:29" /><verse number="30" style="v" sid="LUK 6:30" />Nena woossiya ubbaas imma; neepe ekida oonaka zaaro gada oychofa. <verse eid="LUK 6:30" /><verse number="31" style="v" sid="LUK 6:31" />Asay hintew oothana mela hinte koyaba ubbaa hinteka asaas oothite.<note caller="-" style="x"><char style="xo" closed="false">6:31 </char><char style="xt" closed="false"><ref loc="MAT 7:17">Maato 7:17</ref>.</char></note><verse eid="LUK 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 6:32" />“Hinte, hintena dosiya asata xalaala dosiko, ay galati hintew de7ii? Hari attoshin, nagaranchotika bantana doseyisata dosoosona. <verse eid="LUK 6:32" /><verse number="33" style="v" sid="LUK 6:33" />Hintew lo77oba ootheyisata xalaalas lo77oba oothiko hintew ay galati de7ii? Nagaranchotika hessada oothosona. <verse eid="LUK 6:33" /><verse number="34" style="v" sid="LUK 6:34" />Tal7e zaarana asa xalaalas hinte tal7iko ay dumma galatetetii? Nagaranchotika guye zaarana asi be7idi tal7oosona.”<verse eid="LUK 6:34" /></para>
  <para style="s1">Hara Asa Bolla Pirdofa</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 6:35" />“Shin hinte morketa dosite; entaw lo77oba oothite. Guye ekanaw qoponna tal7ite. Hessan hinte ekana woytoy gita gidana. Hinte Ubbaafe Bolla Xoossaa nayta gidana. I bana galatonaysatasinne iitatas keeha. <verse eid="LUK 6:35" /><verse number="36" style="v" sid="LUK 6:36" />Hinte aaway keeha gidoysada hinteka keeha gidite.<verse eid="LUK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 6:37" />“Asa bolla pirdofite; hinte bolla pirdetenna. Hinte boretonna mela oonaka boropite. Atto giite; Xoossay hintew atto gaana. <verse eid="LUK 6:37" /><verse number="38" style="v" sid="LUK 6:38" />Immite; hintew imetana. Hinte makidaban hintew zaari maketana, ubbaraka lo77o makiyaban baqidi, suuddi kunthidi, laaletana gakanaw hintew maketi imetana” yaagis.<verse eid="LUK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 6:39" />Qassika Yesuusi yaagidi entaw leemiso odis; “Qooqey qooqe kaalethanaw danda7ii? Kaalethiko nam7ayka woli ekidi aafon wullokonayee?<note caller="-" style="x"><char style="xo" closed="false">6:39 </char><char style="xt" closed="false"><ref loc="MAT 15:14">Maato 15:14</ref>.</char></note> <verse eid="LUK 6:39" /><verse number="40" style="v" sid="LUK 6:40" />Tamaarey astamaarepe aadhenna. Shin loythi tamaarida uray ba astamaariyatho hanees.<note caller="-" style="x"><char style="xo" closed="false">6:40 </char><char style="xt" closed="false"><ref loc="MAT 10:24-25">Maato 10:24-25</ref>; <ref loc="JHN 13:16">Yoha 13:16</ref>; <ref loc="JHN 15:20">15:20</ref>.</char></note><verse eid="LUK 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 6:41" />“Ne ishaa ayfen de7iya buuriya ayis be7ay? Ne ayfen de7iya tuussu daaneysa ayis be7ikii? <verse eid="LUK 6:41" /><verse number="42" style="v" sid="LUK 6:42" />Ne ayfen de7iya tuussu daaneysa be7onna ne ishaako, ‘Ta ishaw, ne ayfen de7iya buuriya kesso’ gaanaw waana danda7ey? Neno cubbuwaw, koyrottada ne ayfen de7iya tuussu daaneysa kessa. Hessafe guye, ne isha ayfen de7iya buuriya kessanaw geeshshada xeellana.<verse eid="LUK 6:42" /></para>
  <para style="s1">Mithinne Iya Ayfe</para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 6:43" />“Lo77o mithi iita ayfe ayfena; hessadaka iita mithi lo77o ayfe ayfena. <verse eid="LUK 6:43" /><verse number="44" style="v" sid="LUK 6:44" />Ayfe ayfiya mithi ubbay ba ayfen eretees. Agunthafe balase ayfey maxetenna qassi laadepe woyne ayfey maxetenna.<note caller="-" style="x"><char style="xo" closed="false">6:44 </char><char style="xt" closed="false"><ref loc="MAT 12:33">Maato 12:33</ref>.</char></note> <verse eid="LUK 6:44" /><verse number="45" style="v" sid="LUK 6:45" />Lo77o asi ba wozanan kumida lo77obaape lo77oba kessees. Iita asi ba wozanan kumida iitabaape iitabaa kessees. Asi ba wozanan kumidi palahidabaape ba doonan odetees.<note caller="-" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="LUK 12:34">12:34</ref>.</char></note><verse eid="LUK 6:45" /></para>
  <para style="s1">Keethe Keexiya Nam7u Asata</para>
  <para style="r">(<ref loc="MAT 7:24-27">Maato 7:24-27</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 6:46" />“Ta geysa ootheketa, shin yaatin ayis tana, ‘Godaw, Godaw, geetii?’ <verse eid="LUK 6:46" /><verse number="47" style="v" sid="LUK 6:47" />Taako yeynne ta qaala si7idi poliya ubbay oona daaniyako ta hintena bessaana. <verse eid="LUK 6:47" /><verse number="48" style="v" sid="LUK 6:48" />I keethe keexanaw ziqi oothi, olla bookidi, garsan de7iya zaalla bolla keethe essida cinca ura daanees. Di7oy di77idi he keetha sugis, shin minthidi keexida gisho, qaaxanaw danda7ibeenna. <verse eid="LUK 6:48" /><verse number="49" style="v" sid="LUK 6:49" />Shin ta qaala si7idi oothonay ba keetha shafe bolla keexida ura daanees. Di7oy di77idi he keethaa sugida wode ellesidi kundis. He keethay wolqaama kundethi kundis” yaagis.<verse eid="LUK 6:49" /></para>
  <chapter eid="LUK 6" />
  <chapter number="7" style="c" sid="LUK 7" />
  <para style="s1">Mato Halaqaa Ammano</para>
  <para style="r">(<ref loc="MAT 8:5-13">Maato 8:5-13</ref>; <ref loc="JHN 4:43-54">Yoha 4:43-54</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 7:1" />Yesuusi hessa ubbaa asaa sinthan tamaarsidi ongidaape guye, Qifirnahooma katamaa bis. <verse eid="LUK 7:1" /><verse number="2" style="v" sid="LUK 7:2" />He bessan issi mato halaqay de7ees. I daro dosiya aylley hargetidi hayqos gakis. <verse eid="LUK 7:2" /><verse number="3" style="v" sid="LUK 7:3" />I Yesuusaba si7ida wode ba aylliya pathana mela iya woosso gidi issi issi Ayhude cimata Yesuusako kiittis. <verse eid="LUK 7:3" /><verse number="4" style="v" sid="LUK 7:4" />Kiitetidaysati, Yesuusako bidi, “Ne iyaw haysa oothanaw bessees. <verse eid="LUK 7:4" /><verse number="5" style="v" sid="LUK 7:5" />Ayis giiko, ha uray nu asaa dosees, ayhude woosa keethaaka keexis” gidi minthi woossidosona <verse eid="LUK 7:5" /><verse number="6" style="v" sid="LUK 7:6" />Yesuusika entara bis.</para>
  <para style="p" vid="LUK 7:6">Mato halaqaa sooko matiya wode ba laggeta iyako kiittidi, “Godaw, ta kaarape garsan ne gelanaw ta bessonna gisho, daaburopa. <verse eid="LUK 7:6" /><verse number="7" style="v" sid="LUK 7:7" />Taka tana ne sinthe shiiqanaw bessiya asi gada qopike. Shin ne issi qaala oda; ta aylley paxana. <verse eid="LUK 7:7" /><verse number="8" style="v" sid="LUK 7:8" />Taw taape bollara halaqay de7ees, taape garsan ta kiittiya wotaadareti de7oosona. Issuwa, ‘Ba’ giiko bees, hankuwa, ‘Haaya’ giiko yees. Ta aylliyako, ‘Hanno ootha’ giiko oothees” yaagis.<verse eid="LUK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 7:9" />Yesuusi hessa si7ida wode malaaletis. Guye simmidi baara yaa asaako, “Taani hintew tuma odayis; hari attoshin Isra7eelenka haysa mela gita ammano demmabike” yaagis. <verse eid="LUK 7:9" /><verse number="10" style="v" sid="LUK 7:10" />Kiitetida asati soo simmiya wode aylley paxin demmidosona.<verse eid="LUK 7:10" /></para>
  <para style="s1">Am7e Na7a</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 7:11" />Guutha wodepe guye Yesuusi Nayne katamaa bis. Iya tamaaretaranne hara daro asati iyara bidosona. <verse eid="LUK 7:11" /><verse number="12" style="v" sid="LUK 7:12" />I katamaa gelana haniya wode aha tookida daro asati katamaape keyoosona. Hayqida na7ay ba aayes issuwa, iyaka am7o gidada de7awusu. Katama asaape daroti iira de7oosona. <verse eid="LUK 7:12" /><verse number="13" style="v" sid="LUK 7:13" />Goday iyo be7ida wode qadhetidi, “Yeekofa” yaagis.<verse eid="LUK 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 7:14" />Shiiqidi hala bochin tookida asati eqidosona. Yesuusi, “La, yalagaw denda” yaagis. <verse eid="LUK 7:14" /><verse number="15" style="v" sid="LUK 7:15" />Hayqidaysi dendi uttidi oda oykis. Yesuusi na7aa ekidi aayes immis.<verse eid="LUK 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 7:16" />Asa ubbay yashetidi, “Gita nabey nu giddon dendis; Xoossay ba asaa be7is” yaagidi Xoossaa galatidosona. <verse eid="LUK 7:16" /><verse number="17" style="v" sid="LUK 7:17" />Iya sunthay Yihudaninne he heeran de7iya biitta ubban si7etis.<verse eid="LUK 7:17" /></para>
  <para style="s1">Yesuusanne Xammaqiya Yohaanisa</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 7:18" />Xammaqiya Yohaanisa tamaareti hessa ubbaa Yohaanisas odidosona. I enta giddofe nam7ata xeegidi, <verse eid="LUK 7:18" /><verse number="19" style="v" sid="LUK 7:19" />“Yaana geetetiday neneyee? Woyko haraa naagino?” yaagidi oychite gidi Godaako kiittis.<verse eid="LUK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 7:20" />Asati “Yesuusako bidi, Xammaqiya Yohaanisi, ‘Yaana geetetiday neneyee? Woyko haraa naagino?’ giite gidi nuna neeko kiittis” yaagidosona.<verse eid="LUK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 7:21" />He saatenka Yesuusi daro asaa hargiyafe pathis. Tuna ayyaanata kessis, qooqida ayfiyaka xeelisis. <verse eid="LUK 7:21" /><verse number="22" style="v" sid="LUK 7:22" />Yohaanisa matape kiitetidi yidaysatako, “Bidi hinte be7idaysanne si7idaysa Yohaanisas odite. Ayfe qooqeti xeelloosona, gundati birshetidi hemetoosona, baro harganchoti geeyosona, tulleti si7oosona, hayqidaysati hayqope dendoosona, manqotas Wongelay sabbaketees.<note caller="-" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="ISA 35:5-6">Isa 35:5-6</ref>; <ref loc="ISA 61:1">61:1</ref>.</char></note> <verse eid="LUK 7:22" /><verse number="23" style="v" sid="LUK 7:23" />Tanan dhubetonna oonika anjetidaysa.”<verse eid="LUK 7:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 7:24" />Yohaanisi kiittidaysati bidaape guye Yesuusi asaas Yohaanisaba yaagidi odis: “Hinte ay be7anaw mela biitta keydetii? Carkoy qaathiya maata be7anaseyee? <verse eid="LUK 7:24" /><verse number="25" style="v" sid="LUK 7:25" />Yaatin, ay be7anaw keydetii? Koyse ma7o ma7ida asaa be7anaseyee? Koyse ma7o ma7idaysatinne sa7i injetida asay kawo gadhon de7oosona. <verse eid="LUK 7:25" /><verse number="26" style="v" sid="LUK 7:26" />Yaatin, ay be7anaw keydetii? Nabiya be7anaseyee? Ee, ta yaagayis: hinte be7anaw keyday nabepe aadheysa.<verse eid="LUK 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="LUK 7:27" />“ ‘Ne ogiya ne sinthan giigisiya</para>
  <para style="q2" vid="LUK 7:27">ta kiitanchuwa neepe sinthe ta kiittana’<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Milki 3:1</ref>.</char></note></para>
  <para style="m" vid="LUK 7:27">geetetidi xaafetiday iyassa. <verse eid="LUK 7:27" /><verse number="28" style="v" sid="LUK 7:28" />Ta hintew odayis; maccasape yeletidaysata giddofe Yohaanisape aadhey baawa. Xoossaa kawotethan ubbaafe guuxeysi, I ubbaafe gita gidana” yaagis.<verse eid="LUK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 7:29" />Hari attoshin, Yesuusa qaala si7ida qaraxa qanxiseysati ubbay Yohaanisa kushen xammaqetidi Xoossay xillo gideysa qoncisidosona.<note caller="-" style="x"><char style="xo" closed="false">7:29 </char><char style="xt" closed="false"><ref loc="MAT 21:32">Maato 21:32</ref>; <ref loc="LUK 3:12">Luqa 3:12</ref>.</char></note> <verse eid="LUK 7:29" /><verse number="30" style="v" sid="LUK 7:30" />Shin Farsaawetinne higge astamaareti Yohaanisa kushen xammaqetonna ixidi Xoossaa zoriya leqsidosona.<verse eid="LUK 7:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 7:31" />Yesuusi kaallidi haysada yaagis: “Hiza, ha wodiya yeletethaa aybira daaniso? Entika oona daanonna? <verse eid="LUK 7:31" /><verse number="32" style="v" sid="LUK 7:32" />Giya giddon uttidi woli xeegidi, ‘Nu hintew suusul7e punnin, hinte yexeketa. Nu sabbidi zeleelin, hinte yeekeketa’ giya nayta daanosona. <verse eid="LUK 7:32" /><verse number="33" style="v" sid="LUK 7:33" />Xammaqiya Yohaanisi moonnanne uyonna yin, ‘Iita ayyaanara de7ees gideta.’ <verse eid="LUK 7:33" /><verse number="34" style="v" sid="LUK 7:34" />Asa Na7ay mishenne uyishe yin, ‘Yarambanne ushshancho, qaraxa qanxiseysatanne nagaranchota dabbo’ gideta. <verse eid="LUK 7:34" /><verse number="35" style="v" sid="LUK 7:35" />Hiza, cincatethaa tumatethay iya nayta ubbaa matan eretis” yaagis.<verse eid="LUK 7:35" /></para>
  <para style="s1">Yesuusa Shitto Tiyida Issi Maccasiw</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 7:36" />Issi Farsaawey Yesuusa kathi muzanaw ba soo xeegis. I Farisaawiya soo bidi gayta bolla uttis. <verse eid="LUK 7:36" /><verse number="37" style="v" sid="LUK 7:37" />He kataman issi nagarancho maccasi, Yesuusi Farisaawiya son gibira bolla de7eysa si7ida wode daro al7o philqaaxe shitto ekada yasu.<note caller="-" style="x"><char style="xo" closed="false">7:37 </char><char style="xt" closed="false"><ref loc="MAT 26:7">Maato 26:7</ref>; <ref loc="MRK 14:3">Mar 14:3</ref>; <ref loc="JHN 12:3">Yoha 12:3</ref>.</char></note> <verse eid="LUK 7:37" /><verse number="38" style="v" sid="LUK 7:38" />Yesuusape guye baggara, iya tohuwa matan eqada yeekashe iya tohuwa ba afuthaara laakothawusu. Ba binaanara iya tohuwa quchashenne yeerashe shitto tiyasu.<verse eid="LUK 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 7:39" />Gibira giigisida Farsaawey hessa be7ida wode ba wozanan, “Haysi nabe gidiyako ha maccasiya, iya bochiyara ooneko qassi iya nagarancho gideysaka I eranashin” yaagis.<verse eid="LUK 7:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 7:40" />Yesuusi, “Simoona, ta new odiyabay de7ees” yaagis.</para>
  <para style="p" vid="LUK 7:40">I, “Astamaariyaw, taw oda” yaagis.<verse eid="LUK 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 7:41" />Yesuusi iyako, “Nam7u asati issi uraape miishe tal7idosona. Issoy ichashu xeetu bira hankoy qassi ishatamu bira tal7idosona. <verse eid="LUK 7:41" /><verse number="42" style="v" sid="LUK 7:42" />Nam7ayka tal7iya cigganaw xoonetin, nam7ataska tal7iya maaris. Hiza, ha nam7atape he uraa daro dosanay new oona daani” yaagis.<verse eid="LUK 7:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 7:43" />Simooni, “Daro acoy maaretida uray daro dosana daanees” yaagis. Yesuusi, “Ne tuma pirdadasa” yaagis. <verse eid="LUK 7:43" /><verse number="44" style="v" sid="LUK 7:44" />Hessafe guye, Yesuusi maccaseeko simmi xeellidi, Simoonako, “Hanno maccasiw be7ay? Taani ne soo gelin hari attishin, ne taw toho haathe immabaaka, shin iya ta tohuwa ba afuthan laakothada ba binaanan quchasu. <verse eid="LUK 7:44" /><verse number="45" style="v" sid="LUK 7:45" />Neeni tana yeera ekabaaka, shin iya ta ne soo gelosape doomada ta tohuwa yeero aggabuku. <verse eid="LUK 7:45" /><verse number="46" style="v" sid="LUK 7:46" />Neeni ta huuphiyan zayte tiyabaka, shin iya ta tohuwa shitto tiyawusu. <verse eid="LUK 7:46" /><verse number="47" style="v" sid="LUK 7:47" />Iya tana daro dosida gisho, I daro nagaray atto geetetis. Guutha nagari atto geetetida uray guuthara dosees.”<verse eid="LUK 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LUK 7:48" />Yesuusi maccaseeko, “Ne nagaray atto geetetis” yaagis.<verse eid="LUK 7:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 7:49" />Iyara issife gaytan uttidi miya imathati, “Nagara atto yaagey, I haysi oonee?” yaagidi banta wozanan qopidosona.<verse eid="LUK 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 7:50" />Yesuusi maccaseeko, “Ne ammanoy nena ashshis; saro ba” yaagis.<verse eid="LUK 7:50" /></para>
  <chapter eid="LUK 7" />
  <chapter number="8" style="c" sid="LUK 8" />
  <para style="p">
    <verse number="1" style="v" sid="LUK 8:1" />Hessafe guye, Yesuusi Xoossaa kawotethaa Wongela sabbakishe katamaaranne gutaara aadhis. He wode tammanne nam7u hawaareti iyara de7oosona. <verse eid="LUK 8:1" /><verse number="2" style="v" sid="LUK 8:2" />Qassi tuna ayyaanapenne dumma dumma hargiyafe paxida issi issi maccasati iyara de7oosona. Entika, laapun tuna ayyaanati keyida Magdela Mayraamo,<note caller="-" style="x"><char style="xo" closed="false">8:2 </char><char style="xt" closed="false"><ref loc="MAT 27:55-56">Maato 27:55-56</ref>; <ref loc="MRK 15:40-41">Mar 15:40-41</ref>; <ref loc="LUK 23:49">Luqa 23:49</ref>.</char></note> <verse eid="LUK 8:2" /><verse number="3" style="v" sid="LUK 8:3" />Herodiisa shuuma Kuuza machiw Yohaana, Soosinaranne qassi hara daroti entana miishen maaddeysati de7oosona.<verse eid="LUK 8:3" /></para>
  <para style="s1">Zerethi Zeriya Ura Leemiso</para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 8:4" />Daro asay dumma dumma katamaape iyako shiiqin leemison entaw odis. <verse eid="LUK 8:4" /><verse number="5" style="v" sid="LUK 8:5" />“Issi goshshanchoy zerethi zeranaw keyis. I zerishin issi issi zerethay oge gaxan wodhidi yedhetis, salo kafoti maxidosona. <verse eid="LUK 8:5" /><verse number="6" style="v" sid="LUK 8:6" />Harati shaalloy garsan de7iya biitta bolla wodhidosona. Buroo dolida mela biittan laahoy bayna gisho miccidosona. <verse eid="LUK 8:6" /><verse number="7" style="v" sid="LUK 8:7" />Hara zerethay qassi aguntha giddon wodhis. Agunthaara wolla diccida gisho agunthay cuullidi bessan ashshis. <verse eid="LUK 8:7" /><verse number="8" style="v" sid="LUK 8:8" />Harati lo77o biitta bolla wodhidosona. Dolida wode xeetu kushe ayfidosona.” Hessa odi ongidi, ba qaala dhoqu oothidi, “Si7iya haythi de7iya ubbay si7o” yaagis.<verse eid="LUK 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 8:9" />Iya tamaareti, “Ha leemisuwa birshethay aybee?” yaagidi oychidosona <verse eid="LUK 8:9" /><verse number="10" style="v" sid="LUK 8:10" />I, “Xoossaa kawotethaa xuuraa erana mela hintew imetis. Shin harati be7ishe demmonna mela, si7ishe akeekona mela leemison odayis.<note caller="-" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="ISA 6:9">Isa 6:9</ref>.</char></note><verse eid="LUK 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 8:11" />“Hiza, ha leemisuwa birshethay haysa: koche yaagetiday Xoossaa qaala. <verse eid="LUK 8:11" /><verse number="12" style="v" sid="LUK 8:12" />Oge gaxan wodhida zerethay qaala si7eyisata. Gidoshin, enti ammanidi attonna mela Xalahey qaala enta wozanaape maxi diggees. <verse eid="LUK 8:12" /><verse number="13" style="v" sid="LUK 8:13" />Shaalloy garsan de7iya biitta bolla wodhida zerethay qaala si7idi ufaysan ekeyisata. Enti ha77is ammanoosonape attishin, xaphoy bayna gisho paacey gakiya wode ellesidi kaddoosona. <verse eid="LUK 8:13" /><verse number="14" style="v" sid="LUK 8:14" />Aguntha giddon zeretida zerethay qaala si7eyisata. Entika alamiya qofan, duretethaninne sa7a duussaa miikotethan cuuletidi besseysada ayfibookona. <verse eid="LUK 8:14" /><verse number="15" style="v" sid="LUK 8:15" />Lo77o biittan wodhida zerethay lo77o wozanan qaala si7idi naageysatanne danda7an minnidi ayfe ayfeyisata.<verse eid="LUK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 8:16" />“Xompe oythidi, daacho kammey woyko arsafe garsan wothey deenna. Geliya asi be7ana mela dhoqa bessan wothees.<note caller="-" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="MAT 5:15">Maato 5:15</ref>; <ref loc="LUK 11:33">Luqa 11:33</ref>.</char></note><verse eid="LUK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 8:17" />“Hessa gisho, qonce keyonna qosetidi attiyabay, eretonna geemmidi attiyabay deenna.<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="MAT 10:26">Maato 10:26</ref>; <ref loc="LUK 12:2">Luqa 12:2</ref>.</char></note><verse eid="LUK 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 8:18" />“Hiza, hinte qaala waati si7iyako akeekite. De7iya ubbaas guzhetidi imetana, baynaysas hari attoshin iyaw de7iya guuthiyaka iyape eketana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="MAT 25:29">Maato 25:29</ref>; <ref loc="LUK 19:26">Luqa 19:26</ref>.</char></note><verse eid="LUK 8:18" /></para>
  <para style="s1">Yesuusa Aayeranne Ishatara</para>
  <para style="r">(<ref loc="MAT 12:46-50">Maato 12:46-50</ref>; <ref loc="MRK 3:31-35">Mar 3:31-35</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 8:19" />Yesuusa aayeranne ishatara iyako yidosona. Shin asaa darotethaafe dendoysan iya demmanaw danda7ibookona. <verse eid="LUK 8:19" /><verse number="20" style="v" sid="LUK 8:20" />Issi asi Yesuusako, “Ne aayeranne ne ishatara nena koyidi karen naagoosona” yaagis.<verse eid="LUK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 8:21" />Yesuusi zaaridi, “Xoossa qaala si7idi ooson peesheysati ubbay, taw aayonne taw isha” yaagis.<verse eid="LUK 8:21" /></para>
  <para style="s1">Yesuusi Hobbiya Seeris</para>
  <para style="r">(<ref loc="MAT 8:23-27">Maato 8:23-27</ref>; <ref loc="MRK 4:35-41">Mar 4:35-41</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 8:22" />Issi gallas Yesuusaranne iya tamaaretara issife wogolon gelidi, “Abbaa pinnoos” yaagis. Entika baanaw dendidosona. <verse eid="LUK 8:22" /><verse number="23" style="v" sid="LUK 8:23" />Abbaa bollara enti pinnanaw bishin Yesuusi dhiskis. Qoponna mino carkoy abba bolla dendis. Haathi wogoluwan gelin wogoloy mitetethi oykiya wode ubbay babidosona.<verse eid="LUK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 8:24" />Iya tamaareti iyako shiiqidi, “Godaw! Godaw! nu dhayos” yaagidi Yesuusa denthidosona.</para>
  <para style="p" vid="LUK 8:24">Yesuusi dendidi carkuwanne gotiya hanqis. Ellesidi carkoynne gotey wopu gis; sarotethi simmis. <verse eid="LUK 8:24" /><verse number="25" style="v" sid="LUK 8:25" />Yesuusi ba tamaaretako, “Hinte ammanoy awunee?” yaagis. Entika, yayyishenne malaaletishe issoy issuwako, “Carkoynne haathay kiiteteysi, I haysi oonee” yaagidosona.<verse eid="LUK 8:25" /></para>
  <para style="s1">Tuna Ayyaani Iyape Keyda Ura</para>
  <para style="r">(<ref loc="MAT 8:28-34">Maato 8:28-34</ref>; <ref loc="MRK 5:1-20">Mar 5:1-20</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 8:26" />Abba pinnidi Galila baggara de7iya Gergesoone biitta gakidosona. <verse eid="LUK 8:26" /><verse number="27" style="v" sid="LUK 8:27" />Yesuusi wogolope keyidi sa7an wodhishin tuna ayyaanan oyketida uray katamaape keydi iyara gahetis. Daro laythi ma7o ma7onna kallo duufon de7eesipe attishin, soo gelenna. <verse eid="LUK 8:27" /><verse number="28" style="v" sid="LUK 8:28" />Yesuusa be7ida wode iya sinthan gufannidi, ba qaala dhoqu oothidi, “Ubbaafe Bolla Xoossaa na7aw Yesuusa neera taw aybi issifetethi de7ii? Hayyana tana ha77i un7ethofarki” yaagis. <verse eid="LUK 8:28" /><verse number="29" style="v" sid="LUK 8:29" />Hessa I giday, tuna ayyaanay uraape keyana mela Yesuusi hanqida gishosa. Daro wode tuna ayyaanay iya haarida gisho santhalaataninne toho qachiya biratan qashetidi naagetees. Shin qashuwa duuthidi tuna ayyaanan laagetidi mela biitta gelis.<verse eid="LUK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 8:30" />Yesuusi, “Ne sunthay oone” yaagidi oychis.</para>
  <para style="p" vid="LUK 8:30">I, daro tuna ayyaanati iya oykida gisho bana, “Leegiyona” gis. <verse eid="LUK 8:30" /><verse number="31" style="v" sid="LUK 8:31" />Tuna ayyaanati bantana Si7oole kiittonna mela woossidosona.<verse eid="LUK 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 8:32" />He bessan zooze bolla miya guduntho wudey hemetees. Hini gudunthotan gelino gidi woossidosona, ika “Gelite” gis. <verse eid="LUK 8:32" /><verse number="33" style="v" sid="LUK 8:33" />Tuna ayyaanati uraape keyidi gudunthotan gelidosona. Wudey deriyape duge gurguxidi abban gelis.<verse eid="LUK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 8:34" />Henthanchoti hanidaysa be7ida wode woxi bidi, katamaninne guta ubban odidosona. <verse eid="LUK 8:34" /><verse number="35" style="v" sid="LUK 8:35" />Asay hanidaba be7anaw keyidi Yesuusako yidosona. Tuna ayyaanay keyida uray ma7o ma7idi, iya wozanay simmin, Yesuusa toho matan uttidaysa demmidi yayyidosona. <verse eid="LUK 8:35" /><verse number="36" style="v" sid="LUK 8:36" />Iya be7ida asay tuna ayyaanan oyketida uray waanidi paxidaako odidosona. <verse eid="LUK 8:36" /><verse number="37" style="v" sid="LUK 8:37" />Gergesoone yuushon de7iya asay gita yashshi yayidi, Yesuusi banta matape baana mela woossidosona. I wogoluwan gelidi guye simmis.<verse eid="LUK 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 8:38" />Tuna ayyaanay keyida uray Yesuusara daanaw woossis. <verse eid="LUK 8:38" /><verse number="39" style="v" sid="LUK 8:39" />Shin Yesuusi iyako, “Ne soo simma, Xoossay ay mela gitaba new oothidaako oda” yaagidi moyzis. Urayka Yesuusi ay mela gitaba iyaw oothidaako katama ubban markatishe bis.<verse eid="LUK 8:39" /></para>
  <para style="s1">Hayqida Na7iwunne Hargetiya Maccasiw</para>
  <para style="r">(<ref loc="MAT 9:18-26">Maato 9:18-26</ref>; <ref loc="MRK 5:21-43">Mar 5:21-43</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 8:40" />Asay naagidi gam7ida gisho Yesuusi simmiya wode moki ekidosona. <verse eid="LUK 8:40" /><verse number="41" style="v" sid="LUK 8:41" />Ayhude woosa keetha halaqa gidida Iyaroosa geetetiya uray ba soo yaana mela Yesuusa tohuwa bolla wodhidi woossis. <verse eid="LUK 8:41" /><verse number="42" style="v" sid="LUK 8:42" />Iyaw tammanne nam7u laythi gidida macca na7i saketada hayqos gakada de7awusu. Yesuusi biya wode asay iya un7ethees. <verse eid="LUK 8:42" /><verse number="43" style="v" sid="LUK 8:43" />Tammanne nam7u laythi suuthi goggishe gam7ida maccasi de7awusu. Iya baw de7iya miishiya aakimetas immada ongasu. Shin paxanaw danda7abuku. <verse eid="LUK 8:43" /><verse number="44" style="v" sid="LUK 8:44" />Iya Yesuusas guye baggara shiiqada, iya afilaa macaraa bochasu, iiraka goggiya suuthay eqi aggis.<verse eid="LUK 8:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 8:45" />Yesuusi, “Tana bochiday oonee?” yaagis. Ubbay, “Nu bochibooko” yaagin, Phexroosi, “Astamaariyaw, daro asay kaallishininne un7ethishin be7ashe waanada, ‘Tana bochiday oonee?’ gay” yaagis.<verse eid="LUK 8:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 8:46" />Shin Yesuusi, “Issi asi tana bochis; ayis giiko, wolqi taape keyoysi taw eretis” yaagis.<verse eid="LUK 8:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 8:47" />Maccasiya, ibay qoncidaysa erida wode kokorashe yada Yesuusa tohuwa bolla kundasu. Ayis bochidaakonne waanada ellesada paxidaako asaa ubbaa sinthan markatasu. <verse eid="LUK 8:47" /><verse number="48" style="v" sid="LUK 8:48" />I, “Ta naate, ne ammanoy nena pathis; saro ba” yaagis.<verse eid="LUK 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 8:49" />Yesuusi oda ongonna de7ishin, ayhude woosa keetha halaqaa, Iyaroosa soope issi asi yidi, “Iyaroosa, ne na7iya hayqasu; astamaariya mela daabursofa” yaagis.<verse eid="LUK 8:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 8:50" />Shin Yesuusi hessa si7idi Iyaroosako, “Babofa! Ammana, ne na7iya paxana” yaagis.<verse eid="LUK 8:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 8:51" />Yesuusi Iyaroosa soo gakida wode Phexroosape, Yohaanisape, Yayqoobape, na7e aawapenne aayepe attishin, hari gelana mela koybeenna. <verse eid="LUK 8:51" /><verse number="52" style="v" sid="LUK 8:52" />He bessan de7iya asa ubbay na7ees mishetidi yeekishin, Yesuusi, “Yeekofite Na7iya dhiskasupe attishin, hayqabuuku” yaagis.<verse eid="LUK 8:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 8:53" />Asay na7iya hayqidaysa eriya gisho, iya oda leqidi miicidosona. <verse eid="LUK 8:53" /><verse number="54" style="v" sid="LUK 8:54" />Shin Yesuusi na7e kushiya oykidi, “Naatte denda” yaagis. <verse eid="LUK 8:54" /><verse number="55" style="v" sid="LUK 8:55" />Na7ees shempoy simmin denda eqasu. Yesuusi entako, “Iwu miyaba immite” yaagis. <verse eid="LUK 8:55" /><verse number="56" style="v" sid="LUK 8:56" />Na7ee aawaranne aayera malaaletidosona. Shin Yesuusi haysa, “Oodeska odopite” yaagis.<verse eid="LUK 8:56" /></para>
  <chapter eid="LUK 8" />
  <chapter number="9" style="c" sid="LUK 9" />
  <para style="s1">Tammanne Nam7u Hawaareti Kiitetidosona</para>
  <para style="r">(<ref loc="MAT 10:5-15">Maato 10:5-15</ref>; <ref loc="MRK 6:7-13">Mar 6:7-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 9:1" />Yesuusi tammanne nam7u hawaareta baako xeegidi, tuna ayyaanata kessana melanne harge ubbaa pathana mela wolqanne maata immis. <verse eid="LUK 9:1" /><verse number="2" style="v" sid="LUK 9:2" />Xoossaa kawotethaaba markatanaadanne harganchota pathanaada kiittis. <verse eid="LUK 9:2" /><verse number="3" style="v" sid="LUK 9:3" />I entako, “Xam7a gidin ogoro gidin kathi gidin miishe gidin laammidi ma7iya afila gidin oges gidi aykoka oykofite.<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luqa 10:4-11</ref>.</char></note> <verse eid="LUK 9:3" /><verse number="4" style="v" sid="LUK 9:4" />He katamaape hinte keyana gakanaw imathatethan hinte gelida keethan gam7ite. <verse eid="LUK 9:4" /><verse number="5" style="v" sid="LUK 9:5" />Oonika hintena mokonna ixiko he katamaape keyishe entaw marka gidana mela hinte tohuwan de7iya baana pitidi keyite.” <verse eid="LUK 9:5" /><verse number="6" style="v" sid="LUK 9:6" />Entika kiitetidaysada keyidi wongela odishenne dumma dumma gutatan harganchota pathishe aadhidosona.<verse eid="LUK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 9:7" />Galila biitta haariya Herodiisi Yesuusi oothidaba ubbaa si7ida wode dagammis. Ayis giiko, issi issi asati Yohaanisi hayqope dendonna aggenna yaagosona.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="MAT 16:14">Maato 16:14</ref>; <ref loc="MRK 8:28">Mar 8:28</ref>; <ref loc="LUK 9:19">Luqa 9:19</ref>.</char></note> <verse eid="LUK 9:7" /><verse number="8" style="v" sid="LUK 9:8" />Baggati, “Eeliyaasi qoncis” goosona; harati qassi, “Beni nabetape issoy hayqope dendis” yaagidi odetoosona. <verse eid="LUK 9:8" /><verse number="9" style="v" sid="LUK 9:9" />Shin Herodiisi, “Taani Yohaanisa qoodhiya qanxisada wodhas. Yaatin, haysatho yaagetidi iyabaa odetey, I oonee?” yaagidi ba ayfen be7anaw koyees.<verse eid="LUK 9:9" /></para>
  <para style="s1">Ichashu Mukulu Asaa</para>
  <para style="r">(<ref loc="MAT 14:13-21">Maato 14:13-21</ref>; <ref loc="MRK 6:30-44">Mar 6:30-44</ref>; <ref loc="JHN 6:1-14">Yoha 6:1-14</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 9:10" />Tammanne nam7u hawaareti guye simmi yidi, enti oothidaba ubbaa Yesuusas odidosona. I entana ekidi Beetesayda katamaape gaxa efis. <verse eid="LUK 9:10" /><verse number="11" style="v" sid="LUK 9:11" />Shin daro asay Yesuusa gideysa eridi iya kaallidosona. I enta moki ekidi Xoossaa kawotethaaba tamaarsis; paxanaw koyeysataka pathis.<verse eid="LUK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 9:12" />Sa7i omarsiya wode tammanne nam7u hawaareti iyako shiiqidi, “Nu de7ey mela biitta gidiya gisho asay dumma dumma gutatanne katamata bidi, kathinne aqiya bessi koyana mela asaa moyza” yaagidosona.<verse eid="LUK 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 9:13" />Shin I, “Entaw miyaba hinte immite” yaagis.</para>
  <para style="p" vid="LUK 9:13">Enti, “Nuus de7ey ichashu uythinne nam7u molo gidiya gisho, ha asaas gidiya kathi nuuni bidi shammonna ixiko gidenna” yaagidosona. <verse eid="LUK 9:13" /><verse number="14" style="v" sid="LUK 9:14" />He bessan ichashu mukulu gidiya addeti de7oosona.</para>
  <para style="p" vid="LUK 9:14">Yesuusi ba tamaaretako, “Ishataman ishataman shaaki shaaki asaa utisite” yaagis.<verse eid="LUK 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 9:15" />Iya tamaareti, I kiitidaysada asaa utisidosona. <verse eid="LUK 9:15" /><verse number="16" style="v" sid="LUK 9:16" />I ichashu uythaanne nam7u molota ekidi, salo xeellidi, Xoossaa galatidi, menthidi asaa ubbaa gathana mela ba tamaaretas immis. <verse eid="LUK 9:16" /><verse number="17" style="v" sid="LUK 9:17" />Ubbay midi kallidosona. Entafe attida tiifey tammanne nam7u gayta kumethi gidis.<verse eid="LUK 9:17" /></para>
  <para style="s1">Phexroosa Markatetha</para>
  <para style="r">(<ref loc="MAT 16:13-19">Maato 16:13-19</ref>; <ref loc="MRK 8:27-29">Mar 8:27-29</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 9:18" />Yesuusi ba xalaala woossishin, iya tamaareti iyako yidosona. I, “Asay tana oona goonna?” gidi oychis.<verse eid="LUK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 9:19" />Enti zaaridi “Issoti issoti, ‘Xammaqiya Yohaanisa, baggati Eeliyaasa, harati qassi, beni nabetape issoy hayqope dendis’ yaagosona” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">9:19 </char><char style="xt" closed="false"><ref loc="MAT 14:1">Maato 14:1</ref>, <ref loc="MAT 14:2">2</ref>; <ref loc="MRK 6:14-15">Mar 6:14-15</ref>; <ref loc="LUK 9:7-8">Luqa 9:7-8</ref>.</char></note><verse eid="LUK 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 9:20" />I zaaridi, “Yaatin hinte tana oona geetii?” yaagis. Phexroosi, “Neeni Xoossaafe kiitetida Kiristoosa” yaagidi zaaris.<note caller="-" style="x"><char style="xo" closed="false">9:20 </char><char style="xt" closed="false"><ref loc="JHN 16:20-28">Yoha 16:20-28</ref>; <ref loc="MRK 8:30-9:1">Mar 8:30—9:1</ref>.</char></note><verse eid="LUK 9:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 9:21" />Yesuusi haysa oodeska odopite gidi minthidi odis. <verse eid="LUK 9:21" /><verse number="22" style="v" sid="LUK 9:22" />Qassika Yesuusi, “Asa Na7i daro metuwa ekana. Biitta cimata, kahine halaqatanne higge astamaareta kushen aadhidi imetana. Enti iya wodhana, shin I heedzantho gallas hayqope dendana” yaagis.<verse eid="LUK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 9:23" />Yesuusi asaa ubbaako, “Tana kaallanaw koyey oonika de7iko bana kaddo, ba masqaliya gallas gallas tookidi tana kaallo.<note caller="-" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Maato 10:38</ref>; <ref loc="LUK 14:27">Luqa 14:27</ref>.</char></note> <verse eid="LUK 9:23" /><verse number="24" style="v" sid="LUK 9:24" />Ba shempiw ashshanaw koya ubbay iyo dhaysees, ba shempiw ta gisho gidi dhaysiya oonika iyo ashshees.<note caller="-" style="x"><char style="xo" closed="false">9:24 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Maato 10:39</ref>; <ref loc="LUK 17:33">Luqa 17:33</ref>; <ref loc="JHN 12:25">Yoha 12:25</ref>.</char></note> <verse eid="LUK 9:24" /><verse number="25" style="v" sid="LUK 9:25" />Asi alame ubbaa haaridi, gidoshin, ba shempiw dhaysiyaba woyko qohiyaba gidiko iya ay maaddii? <verse eid="LUK 9:25" /><verse number="26" style="v" sid="LUK 9:26" />Oonika tananinne ta qaalan yeellatiko, Asa Na7i ba bonchuwara hessadaka aawa bonchuwaranne Geeshsha kiitanchota bonchuwara yaa wode iyan yeellatana. <verse eid="LUK 9:26" /><verse number="27" style="v" sid="LUK 9:27" />Ta hintew tuma odayis; haysan eqidaysata giddofe Xoossaa kawotethaa be7onnashin hayqonna asati de7oosona” yaagis.<verse eid="LUK 9:27" /></para>
  <para style="s1">Yesuusa Malay Laametis</para>
  <para style="r">(<ref loc="MAT 17:1-8">Maato 17:1-8</ref>; <ref loc="MRK 9:2-8">Mar 9:2-8</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 9:28" />Yesuusi he oda odin, hospun gallasape guye, Phexroosa, Yayqoobanne Yohaanisa baara ekidi woossanaw zuma bolla keyis.<note caller="-" style="x"><char style="xo" closed="false">9:28 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 Phex 1:17-18</ref>.</char></note> <verse eid="LUK 9:28" /><verse number="29" style="v" sid="LUK 9:29" />I woosa bolla de7ishin iya ayfe karey laametis; afilayka booxidi, awa mela phoolis. <verse eid="LUK 9:29" /><verse number="30" style="v" sid="LUK 9:30" />Nam7u asati, entika Museranne Eeliyaasara bonchon qoncidi, <verse eid="LUK 9:30" /><verse number="31" style="v" sid="LUK 9:31" />Yerusalaamen poletanaw de7iyaba, hessika, I ha alamiyape shaaketanaba iyara odetoosona. <verse eid="LUK 9:31" /><verse number="32" style="v" sid="LUK 9:32" />Phexroosanne iyara de7eyisata dhiskoy efin, enti dhiskofe barkiya wode iya bonchuwanne iyara eqida nam7u asata be7idosona. <verse eid="LUK 9:32" /><verse number="33" style="v" sid="LUK 9:33" />Asati Yesuusape shaaketidi baana hanishin, Phexroosi Yesuusako, “Godaw, nu haysan gidiko nuus ay mela lo77o! Issino new, issino Muses, issino Eeliyaasas oothidi, heedzu shaqara shaqaroos” yaagis. Shin I ay gidaako erenna.<verse eid="LUK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 9:34" />I yaagidi odetishin shaaray yidi entana kammis. Enti he shaara giddo gelishe babidosona. <verse eid="LUK 9:34" /><verse number="35" style="v" sid="LUK 9:35" />Shaara giddofe, “Ta doorida na7ay haysa iya si7ite” giya qaali si7etis.<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="ISA 42:1">Isa 42:1</ref>; <ref loc="MAT 3:17">Maato 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luqa 3:22</ref>.</char></note> <verse eid="LUK 9:35" /><verse number="36" style="v" sid="LUK 9:36" />Qaali si7etidaape guye, Yesuusi barka de7ishe bentis. He wode enti be7idaba oodeska odonna, banta wozanan oykidi si77i gidoosona.<verse eid="LUK 9:36" /></para>
  <para style="s1">Tuna Ayyaani Oykida Na7a</para>
  <para style="r">(<ref loc="MAT 17:14-18">Maato 17:14-18</ref>; <ref loc="MRK 9:14-27">Mar 9:14-27</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 9:37" />Wontethe enti zuma bollafe wodhiya wode daro asay yidi iyara gahetidosona. <verse eid="LUK 9:37" /><verse number="38" style="v" sid="LUK 9:38" />He wode asaa giddofe issi asi, “Astamaariyaw, ta issi na7aa yada be7arki. <verse eid="LUK 9:38" /><verse number="39" style="v" sid="LUK 9:39" />Tuna ayyaanay qoponna oykidi waasisees; goponto yegisidi qakerethees, asatethaa qohidi un7ethidi yeddees. <verse eid="LUK 9:39" /><verse number="40" style="v" sid="LUK 9:40" />Ne tamaareti kessana mela woossas, shin enti danda7ibookona” yaagidi woossis.<verse eid="LUK 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 9:41" />Yesuusi, “Ammanoy bayna geella yeletato, awude gakanaw ta hintera daane, hintena danda7anee? Ne na7aa bada haa ekaya” yaagis.<verse eid="LUK 9:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 9:42" />Na7aa ekidi yaa wode tuna ayyaanay sa7an holi yeggidi kokorsis. Shin Yesuusi tuna ayyaana hanqidi na7aape kessis. Na7aaka na7aa aawas immis. <verse eid="LUK 9:42" /><verse number="43" style="v" sid="LUK 9:43" />Asa ubbay Xoossaa gita wolqan malaaletidosona. Enti I oothidaban malaaletishin, Yesuusi ba tamaaretako, <verse eid="LUK 9:43" /><verse number="44" style="v" sid="LUK 9:44" />“Haysa ta hintew odeysa loythi si7ite; Asa Na7i morketa kushen aadhidi imetana” yaagis. <verse eid="LUK 9:44" /><verse number="45" style="v" sid="LUK 9:45" />Shin I gidabay entafe geemmida gisho, akeekibokona. Hessa gisho, zaaridi oychanaw babidosona.<verse eid="LUK 9:45" /></para>
  <para style="s1">Ubbaafe Aadhey Oonee?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Maato 18:1-5</ref>; <ref loc="MRK 9:33-37">Mar 9:33-37</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 9:46" />Yesuusa tamaareti, “Nu giddon gita gidanay oonee?” gidi palama oykidosona.<note caller="-" style="x"><char style="xo" closed="false">9:46 </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luqa 22:24</ref>.</char></note> <verse eid="LUK 9:46" /><verse number="47" style="v" sid="LUK 9:47" />Yesuusi enta wozanaa qofaa eridi yooga na7aa ba matan essidi, <verse eid="LUK 9:47" /><verse number="48" style="v" sid="LUK 9:48" />“Ha yooga na7aa ta sunthan mokiya oonika tana mokees, tana mokey tana kiittidaysa mokees, hinte ubbaafe guuxeysi, I gita gidana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Maato 10:40</ref>; <ref loc="LUK 10:16">Luqa 10:16</ref>; <ref loc="JHN 13:20">Yoha 13:20</ref>.</char></note><verse eid="LUK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 9:49" />Yohaanisi, “Godaw, issi asi ne sunthan tuna ayyaanata kessishin be7idi, I nuura gidonna gisho diggida” yaagis.<verse eid="LUK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 9:50" />Yesuusi zaaridi, “Hintera eqetonnaysi, I hinte bagga. Hessa gisho, iya diggofite” yaagis.<verse eid="LUK 9:50" /></para>
  <para style="s1">Yesuusi Samaaren Ixetis</para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 9:51" />Yesuusi salo biya wodey matatida gisho, Yerusalaame baanaw qanxidi dendis. <verse eid="LUK 9:51" /><verse number="52" style="v" sid="LUK 9:52" />Samaare biittan de7iya issi gutaa bidi, ubbaba iyaw giigisana mela ase yaa kiittis. <verse eid="LUK 9:52" /><verse number="53" style="v" sid="LUK 9:53" />Shin I bey Yerusalaame gidiya gisho, enti iya moki ekibookona. <verse eid="LUK 9:53" /><verse number="54" style="v" sid="LUK 9:54" />Yesuusa tamaareti Yayqoobaranne Yohaanisara hessa be7idi, “Godaw, salope tami wodhidi enta mo gaana mela ne koyay” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">9:54 </char><char style="xt" closed="false"><ref loc="2KI 1:9-16">2 Kawo 1:9-16</ref>.</char></note> <verse eid="LUK 9:54" /><verse number="55" style="v" sid="LUK 9:55" />Shin Yesuusi guye simmi enta hanqetidi, “Hinte garsan aybi ayyaani de7iyako hinte ereketa. Asa Na7i ase ashshanaw yisipe attishin, dhaysanaasa gidenna” yaagis. <verse eid="LUK 9:55" /><verse number="56" style="v" sid="LUK 9:56" />Yaape dendidi hara guta bidosona.<verse eid="LUK 9:56" /></para>
  <para style="s1">Yesuusa Kaaloy Cigsiya Gate</para>
  <para style="r">(<ref loc="MAT 8:19-22">Maato 8:19-22</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 9:57" />Enti ogera bishin, issi asi, “Ne biya soo ubba ta kaallana” yaagis.<verse eid="LUK 9:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 9:58" />Yesuusi zaaridi, “Workanatas olli, salo kafotas keethi de7ees, shin Asa Na7i ba huuphe shempisiya bessi baawa” yaagis.<verse eid="LUK 9:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 9:59" />Hankuwako, “Neeni tana kaalla” yaagis. Shin uray, “Godaw, koyrottada ta aawa moogada yaana” yaagis.<verse eid="LUK 9:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 9:60" />Shin Yesuusi, “Hayqidaysati hayqidaysata moogana mela entaw aggaaga; neeni bada Xoossaa kawotethaa sabbaka” yaagis.<verse eid="LUK 9:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 9:61" />Qassi hara asi, “Godaw, ta nena kaallana, shin koyrottada ta soo asa sarothada yaana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">9:61 </char><char style="xt" closed="false"><ref loc="1KI 19:20">1 Kawo 19:20</ref>.</char></note><verse eid="LUK 9:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="LUK 9:62" />Yesuusi zaaridi, “Koxe oykidi guye xeelliya oonika Xoossa kawotethas bessenna” yaagis.<verse eid="LUK 9:62" /></para>
  <chapter eid="LUK 9" />
  <chapter number="10" style="c" sid="LUK 10" />
  <para style="s1">Laapun Tammanne Nam7u Tamaareti Kiitetidosona</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 10:1" />Hessafe guye, Goday hara laapun tammanne nam7u<note caller="+" style="f"><char style="fr" closed="false">10:1 </char><char style="fqa" closed="false">Laapun tammanne nam7u: </char><char style="ft" closed="false">Issi issi maxaafati laapun tamma goosona; qassi paydo 17 xeella.</char></note> asata dooris. I baanaw qopida katamanne guta ubba sinthatidi baana mela nam7a nam7a oothidi kiittis. <verse eid="LUK 10:1" /><verse number="2" style="v" sid="LUK 10:2" />Yesuusi entako, “Heko, shiiqana kathay daro shin oosanchoti guutha. Yaaniya gisho, katha goday oosanchota kiittana mela woossite.<note caller="-" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="MAT 9:37-38">Maato 9:37-38</ref>.</char></note> <verse eid="LUK 10:2" /><verse number="3" style="v" sid="LUK 10:3" />Hiza, biite, taani hintena dorsatada suudhumeta giddo yeddana.<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="MAT 10:16">Maato 10:16</ref>.</char></note> <verse eid="LUK 10:3" /><verse number="4" style="v" sid="LUK 10:4" />Hinte biya ogiyas aykoka oykofite, miishe gidin kathi gidin caamma oykofite. Oge bolla oonaka sarothofite.<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">Maato 10:7-14</ref>; <ref loc="MRK 6:8-11">Mar 6:8-11</ref>; <ref loc="LUK 9:3-5">Luqa 9:3-5</ref>.</char></note> <verse eid="LUK 10:4" /><verse number="5" style="v" sid="LUK 10:5" />Hinte geliya keethe ubbaa koyrottidi, ‘Saroy ha keethaas gido’ yaagite. <verse eid="LUK 10:5" /><verse number="6" style="v" sid="LUK 10:6" />Saro dosiya asi he bessan de7iko, hinte saroy yan shempana; ixas giiko hinte saroy hintew simmana. <verse eid="LUK 10:6" /><verse number="7" style="v" sid="LUK 10:7" />Oosanchos damooze bessiya gisho, hinte gelida keethan hintew shiishidaba ubbaa mishenne uyishe yan gam7ite. Issuwa soope issuwa soo yuuyopite.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="2CO 9:14">2 Qoro 9:14</ref>; <ref loc="1TI 5:8">1 Ximo 5:8</ref>.</char></note> <verse eid="LUK 10:7" /><verse number="8" style="v" sid="LUK 10:8" />Ay katamaka hinte geliya wode asay hintena mokidi, hintew shiishidaba ubbaa miite. <verse eid="LUK 10:8" /><verse number="9" style="v" sid="LUK 10:9" />He kataman de7iya harganchota pathishe, ‘Xoossaa kawotethay hinteko matis’ yaagidi odite. <verse eid="LUK 10:9" /><verse number="10" style="v" sid="LUK 10:10" />Shin issi katamaa geliya wode asay hintena mokonna ixiko dabaaba keyidi haysada giite:<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Hawa 13:51</ref>.</char></note> <verse eid="LUK 10:10" /><verse number="11" style="v" sid="LUK 10:11" />‘Nu tohuwa bolla de7iya hinte katamaa baana pittoos, shin Xoossaa kawotethi hinteko matatidaysa erite.’<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 10:7-14">Maato 10:7-14</ref>; <ref loc="MRK 6:8-11">Mar 6:8-11</ref>; <ref loc="LUK 9:3-5">Luqa 9:3-5</ref>.</char></note> <verse eid="LUK 10:11" /><verse number="12" style="v" sid="LUK 10:12" />Pirda gallasan, ha katamaape Soodome katamaas pirdi kawushe gidanaysa ta hintew odayis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="GEN 19:24-28">Medhe 19:24-28</ref>; <ref loc="MAT 10:15">Maato 10:15</ref>; <ref loc="MAT 11:24">11:24</ref>.</char></note><verse eid="LUK 10:12" /></para>
  <para style="s1">Ammanonna Ixida Katamata</para>
  <para style="r">(<ref loc="MAT 11:20-24">Maato 11:20-24</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 10:13" />Kaallidika, Yesuusi, “Neno Korazine, neno Beetesayda, ayye! Hintenan oosetida malaatati Xiroosaninne Sidoonan oosetidaako yan de7iya asay kayo ma7o ma7idi, bidintha bolla uttidi, beni maarotan geli agganashin.<note caller="-" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">Isa 23:1-18</ref>; <ref loc="EZK 26:1-21">Hiz 26:1-21</ref>; <ref loc="JOL 3:4-8">Iyyu 3:4-8</ref>; <ref loc="AMO 1:9-10">Amo 1:9-10</ref>; <ref loc="ZEC 9:2-4">Zaka 9:2-4</ref>.</char></note> <verse eid="LUK 10:13" /><verse number="14" style="v" sid="LUK 10:14" />Hessa gisho, hintefe aathidi Xiroosasinne Sidoonas Xoossa pirdi kawuyana. <verse eid="LUK 10:14" /><verse number="15" style="v" sid="LUK 10:15" />Neka Qifirnahooma, salo gakanaw nena dhoqu oothanaw koyay? Ne duge Si7oole holetana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ISA 14:13-15">Isa 14:13-15</ref>.</char></note><verse eid="LUK 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 10:16" />Qassika Yesuusi ba tamaaretako, “Hintena si7ey tana si7ees, hintena ekonnay tana ekenna, tana ekonnay tana kiittidaysa ekenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Maato 10:40</ref>; <ref loc="MRK 9:37">Mar 9:37</ref>; <ref loc="LUK 9:48">Luqa 9:48</ref>; <ref loc="JHN 13:20">Yoha 13:20</ref>.</char></note><verse eid="LUK 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 10:17" />Laapun tammanne nam7u tamaareti kiitetida bessaafe daro ufaytishe simmidosona. Yesuusako shiiqidi, “Godaw, ne sunthan tuna ayyaanatika nuus kiitetidosona” yaagidosona.<verse eid="LUK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 10:18" />Yesuusi entako, “Xalahey salope wol7anthada wodhishin ta be7as. <verse eid="LUK 10:18" /><verse number="19" style="v" sid="LUK 10:19" />Heko, shooshinne korne yedhana melanne morkiya wolqa zaarana mela maata hintew immas. Hintena qohanabay aykoyka deenna.<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="PSA 19:13">Maz 19:13</ref>.</char></note><figure style="fig" alt="Scorpion" file="BK00058B.tif" size="col" ref="10:19">Korne</figure> <verse eid="LUK 10:19" /><verse number="20" style="v" sid="LUK 10:20" />Gidoshin, hinte sunthay salo mazgaben xaafetida gisho, ufaytitepe attishin, tuna ayyaanati kiitetida gisho ufaytofite” yaagis.<verse eid="LUK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 10:21" />He wode, Yesuusi Geeshsha Ayyaanan ufaytidi, “Saluwa sa7aa Godaw, haysa cincatapenne eranchotape genthada yalagatas qoncisida gisho galateta. Ee, ta aawaw, hessa ne oothanaw lo77o shene gidis.<verse eid="LUK 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 10:22" />“Ubbabay ta aawape taw imetis. Na7ay ooneko aawape attishin, hari woyko na7ay qoncisanaw koyeysafe hari oonika aawa erey baawa” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="JHN 3:35">Yoha 3:35</ref>; <ref loc="JHN 10:15">10:15</ref>.</char></note><verse eid="LUK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 10:23" />Kaallidika, Yesuusi ba tamaaretas dumma, “Hinte be7eysa be7eysati anjetidaysata. <verse eid="LUK 10:23" /><verse number="24" style="v" sid="LUK 10:24" />Tuma daro nabetinne kawoti hinte be7eysanne si7eysa be7anawunne si7anaw amotidosona, shin be7ibookona, si7ibookona” yaagis.<verse eid="LUK 10:24" /></para>
  <para style="s1">Tuma Siiqo</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 10:25" />Heko, issi gallas Muse woga eriya issi uray dendidi Yesuusa yaagidi paace oysho oychis. “Astamaariyaw, merina de7o laattanaw taani ay ootho?” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 22:35-40">Maato 22:35-40</ref>; <ref loc="MRK 12:28-34">Mar 12:28-34</ref>.</char></note><verse eid="LUK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 10:26" />Yesuusi, “Muse maxaafan xaafetidaysi woygii? Ne waata nabbabay?” yaagis.<verse eid="LUK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 10:27" />Addey zaaridi, “ ‘Ne Godaa ne Xoossaa, ne kumetha wozanape, ne kumetha shempofe, ne kumetha wolqaafenne ne kumetha qofaape dosa. Qassi ne shooruwa ne huupheda dosa’ yaagees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Leewe 19:18</ref>; <ref loc="DEU 6:5">Zaare 6:5</ref>.</char></note><verse eid="LUK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 10:28" />Yesuusi iyako, “Neeni like zaaradasa, neka hessada ootha. Neeni merinaw de7on daana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="LEV 18:5">Leewe 18:5</ref>.</char></note><verse eid="LUK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 10:29" />Shin uray bana xillo oothanaw koyidi, “I ta shooroy oonee?” yaagis.<verse eid="LUK 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 10:30" />Iya oyshaas Yesuusi yaagidi zaaro immis; “Issi ase de7eysi Yerusalaame katamape duge Iyaarko katama bishin, oge bolla pangati keyidi shocidosona. Iya ma7uwa qaari ekidi hayqopenne paxape giddon yeggidi bidosona. <verse eid="LUK 10:30" /><verse number="31" style="v" sid="LUK 10:31" />Guyepe, Ayhude kahine issoy he ogiyara ba buussu bishe uraa be7idi deshshi gidi aadhis. <verse eid="LUK 10:31" /><verse number="32" style="v" sid="LUK 10:32" />Qassi issi Leewe de7eysi he bessaa gakishe uraa be7idi, hara soora aadhidi bis. <verse eid="LUK 10:32" /><verse number="33" style="v" sid="LUK 10:33" />Shin, issi Samaare biitta ase de7eysi he ogiyara yishe uraa be7idi iyaw qadhetis<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2CH 28:15">2 Taari 28:15</ref>.</char></note> <verse eid="LUK 10:33" /><verse number="34" style="v" sid="LUK 10:34" />Iyako shiiqidi, iya maduntha bolla zaytenne woyne tigidi qachis. Ba hariya bolla utisidi imathi aqiya keethe efis. He bessan iyaw koshshiyaba ubbaa oothis. <verse eid="LUK 10:34" /><verse number="35" style="v" sid="LUK 10:35" />Wontethe nam7u dinaare kessidi imatha keetha aawas immidi, ‘Hayyana ha uraa loytha xeella. Taani new immidaysafe bollara ne kessiyaba ubbaa ta new ciggana’ yaagis.<verse eid="LUK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 10:36" />“Hiza, ha heedzu asatape pangati shocida uraas shoorotey new oona daanii?”<verse eid="LUK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 10:37" />Uray zaaridi, “Iyaw qadhetidaysaka” yaagis.</para>
  <para style="p" vid="LUK 10:37">Yesuusi, “Neka bada hessada ootha” yaagis.<verse eid="LUK 10:37" /></para>
  <para style="s1">Yesuusi Martanne Mayraami Son</para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 10:38" />Yesuusi ba tamaaretara oge bishe issi guta gakis. Yan Marta geetetiya issi maccasiya, iya ba son mokasu.<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="JHN 11:1">Yoha 11:1</ref>.</char></note> <verse eid="LUK 10:38" /><verse number="39" style="v" sid="LUK 10:39" />Iwuka Mayraamo geetetiya michiya de7awusu, Mayraama qaala si7ashe Godaa tohuwa matan uttasu. <verse eid="LUK 10:39" /><verse number="40" style="v" sid="LUK 10:40" />Shin Marta daro ooson un7etada Yesuusako shiiqada, “Godaw, ta michiya oosuwa ta xalaalas yeggada utta aggin ta daaburiya wode neeni be7ashe si77i gay? Iya tana maaddana mela odikii” yaagasu.<verse eid="LUK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 10:41" />Shin Goday zaaridi, “Marta, Marta, neeni daroban un7etasaanne metootasa. <verse eid="LUK 10:41" /><verse number="42" style="v" sid="LUK 10:42" />Gidoshin, koyetey issiba xalaala. Mayraama lo77oba doorasu, hessika iipe eketenna” yaagis.<verse eid="LUK 10:42" /></para>
  <chapter eid="LUK 10" />
  <chapter number="11" style="c" sid="LUK 11" />
  <para style="s1">Yesuusi Woosaba Tamaarsis</para>
  <para style="r">(<ref loc="MAT 6:9-13">Maato 6:9-13</ref>; <ref loc="MAT 7:7-11">7:7-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 11:1" />Issi gallas Yesuusi issi bessan woossees. Woosaa wursida wode iya tamaaretape issoy, “Godaw, Yohaanisi ba tamaareta woosa tamaarsida mela neka nuna woosa tamaarsa” yaagis.<verse eid="LUK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LUK 11:2" />Yesuusi, “Haysada yaagidi woossite:</para>
  <para style="q1" vid="LUK 11:2">“ ‘Salon de7iya nu aawaw</para>
  <para style="q2" vid="LUK 11:2">ne geeshsha sunthay anjeto;</para>
  <para style="q2" vid="LUK 11:2">ne kawotethay yo.<verse eid="LUK 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="LUK 11:3" />Nu gallasa kathaa hachi hachi nuus imma.<verse eid="LUK 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="LUK 11:4" />Nuna qoheyisata nuuni atto geysada,</para>
  <para style="q2" vid="LUK 11:4">nu nagara atto ga;</para>
  <para style="q2" vid="LUK 11:4">paacen nuna gelsofa’ yaagite” yaagis.<verse eid="LUK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 11:5" />Kaallidika, Yesuusi ba tamaaretako yaagis: “Leemisos hintefe issuwas laggey de7ees. I giddi bilahe ba laggiya soo bidi, ‘Ta laggiyaw, miyabay de7iko taw immarki. <verse eid="LUK 11:5" /><verse number="6" style="v" sid="LUK 11:6" />Taw lagge gidida issi asi ogepe yin, iyaw aathiyaba dhayas’ yaagiko,<verse eid="LUK 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 11:7" />“Iya laggey keetha giddon gididi, ‘Hayyana tana waaysopa, pengey gordetis. Ta naytika taara arsa bolla zin7idosona. Yaaniya gisho, dendada ne koyaba immanaw danda7ike’ yaagiyee? <verse eid="LUK 11:7" /><verse number="8" style="v" sid="LUK 11:8" />Ta hintew odayis; laggetetha gisho dendidi immanaw koyonna ixikoka woosan salethida gisho, dendidi koshshiyaba ubba immees.<verse eid="LUK 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 11:9" />“Hessa gisho, taani hintew odayis; woossite hintew imetana; koyite hinte demmana; kare yidi xeegite hintew dooyetana. <verse eid="LUK 11:9" /><verse number="10" style="v" sid="LUK 11:10" />Gaasoyka, woossiya ubbay ekees; koyey demmees; kare yidi xeegeysas dooyetees.<verse eid="LUK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 11:11" />“Hinteno, aawato hinte giddofe na7i uythi woossin, shuchu immey oonee? Molo woossin shooshi immey oonee? <verse eid="LUK 11:11" /><verse number="12" style="v" sid="LUK 11:12" />Woyko phuuphulle woossiko korne immii? <verse eid="LUK 11:12" /><verse number="13" style="v" sid="LUK 11:13" />Hinte iitata gidishe hinte naytas lo77oba immo eriko, salon de7iya hinte aaway woosseysatas Geeshsha Ayyaana waatidi aathidi immennee?” yaagis.<verse eid="LUK 11:13" /></para>
  <para style="s1">Yesuusanne Bi7eel-Zebuula</para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 11:14" />Issi gallas Yesuusi, doona muumisida tuna ayyaana issi uraape kessis. Tuna ayyaanay keyida mela muume uray odetis. Asayka malaaletis. <verse eid="LUK 11:14" /><verse number="15" style="v" sid="LUK 11:15" />Shin issoti issoti, “Tuna ayyaana halaqa, Bi7eel-Zebuula wolqan tuna ayyaanata kessees” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Maato 9:34</ref>; <ref loc="MAT 10:25">10:25</ref>.</char></note> <verse eid="LUK 11:15" /><verse number="16" style="v" sid="LUK 11:16" />Harati qassi paacees salope malla bessaana mela koydosona.<note caller="-" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Maato 12:38</ref>; <ref loc="MAT 16:1">16:1</ref>; <ref loc="MRK 8:11">Mar 8:11</ref>.</char></note><verse eid="LUK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 11:17" />Shin Yesuusi enta qofaa eridi entako, “Woli giddon shaaketiya kawotethi ubbay dhayees; woli giddon shaaketiya keethi kundees. <verse eid="LUK 11:17" /><verse number="18" style="v" sid="LUK 11:18" />Xalahey woli giddon shaaketiko iya kawotethay waanidi minnidi eqanee? Hinte tana, ‘I tuna ayyaanata Bi7eel-Zebuula wolqan kessees’ yaageeta. <verse eid="LUK 11:18" /><verse number="19" style="v" sid="LUK 11:19" />Hiza, taani tuna ayyaana Bi7eel-Zebuula wolqan kessiyaba gidiko hinte nayti oodde wolqan kessonaasha? Hessa gisho, enti hinte bolla pirdeyisata gidana. <verse eid="LUK 11:19" /><verse number="20" style="v" sid="LUK 11:20" />Shin taani tuna ayyaanata Xoossa biradhen kessiyaba gidiko, hiza, Xoossaa kawotethay hinteko matidaysa erite.<verse eid="LUK 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 11:21" />“Mino asi tooranne gondalle oykidi, ba keetha naagiyaba gidiko, iya shaloy boshetenna. <verse eid="LUK 11:21" /><verse number="22" style="v" sid="LUK 11:22" />Hanoshin, iyape aadhidi mino gidida asi yidi, iya qohidi xooniko, ammanetida tooranne gondalle wosisi ekidi, iya shaluwa bonqidi haras shaakees.<verse eid="LUK 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 11:23" />“Taara gidonaysi tana ixees; taara shiishonnaysi laallees.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MRK 9:40">Mar 9:40</ref>.</char></note><verse eid="LUK 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 11:24" />“Tuna ayyaanay asape keyda wode shempiya bessi koydi haathi bayna soora yuuyees. Shempiya bessi dhayda wode, ‘Ta keydasuwa simmana’ yaagees. <verse eid="LUK 11:24" /><verse number="25" style="v" sid="LUK 11:25" />I simmiya wode keethay pitetidi lo77idi de7ishin demmis. <verse eid="LUK 11:25" /><verse number="26" style="v" sid="LUK 11:26" />Hessafe guye, bidi iyape aadhidi iitida hara laapun tuna ayyaanata ekidi yees. Iyan gelidi duussu oykees. He uraas koyroysafe aadhidi guyeysi iita gidees” yaagis.<verse eid="LUK 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 11:27" />Yesuusi hessa oda bolla de7ishin, issi maccasi asaa gaathafe dendada, ba qaala dhoqu oothada, “Nena tookida uloynne neeni dhammida dhanthati anjetidosona” yaagasu.<verse eid="LUK 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 11:28" />Shin I, “Anjetidaysati Xoossaa qaala si7idi kiiteteyisata” yaagis.<verse eid="LUK 11:28" /></para>
  <para style="s1">Yoonasa Malaata</para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 11:29" />Daro asay shiiqida wode Yesuusi, “Ha yeletethay iita yeletethi; ooratha malla koyees. Shin Yoonasa malaatape attishin, hari entaw imetenna.<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="MAT 16:4">Maato 16:4</ref>; <ref loc="MRK 8:12">Mar 8:12</ref>.</char></note> <verse eid="LUK 11:29" /><verse number="30" style="v" sid="LUK 11:30" />Yoonasi Nanawe asaas malla gidida mela Asa Na7ika ha yeletethaas malla gidana.<note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JHN 3:4">Yoha 3:4</ref>.</char></note> <verse eid="LUK 11:30" /><verse number="31" style="v" sid="LUK 11:31" />Dugeha kawiya pirda gallas ha yeletethaara dendada pirdana. Gaasoyka, iya Solomone cincatethaa si7anaw biitta gaxape dendada yasu. Heko Solomonepe aadhey haysan de7ees<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 Kawo 10:1-10</ref>; <ref loc="2CH 9:1-12">2 Taari 9:1-12</ref>.</char></note> <verse eid="LUK 11:31" /><verse number="32" style="v" sid="LUK 11:32" />Nanawe asati pirda gallas ha yeletethaara dendidi enta bolla pirdana. Gaasoyka, Yoonasa sibkatiyan maarota gelidosona. Heko, Yoonasape aadhey haysan de7ees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="JHN 3:5">Yoha 3:5</ref>.</char></note><verse eid="LUK 11:32" /></para>
  <para style="s1">Asatetha Poo7o</para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 11:33" />“Xompe oythidi qosa bessan woyko oto giddon wothiya asi deenna. Asi poo7uwa be7ana mela dhoqa bessan wothees.<note caller="-" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="MAT 5:15">Maato 5:15</ref>; <ref loc="MRK 4:21">Mar 4:21</ref>; <ref loc="LUK 8:16">Luqa 8:16</ref>.</char></note> <verse eid="LUK 11:33" /><verse number="34" style="v" sid="LUK 11:34" />Ne asatethaas poo7oy ne ayfiya. Ne ayfey lo77o gidiko, ne kumetha asatethay poo7ees. Nena ayfey sakiko ne asatethay ubbay dhumees. <verse eid="LUK 11:34" /><verse number="35" style="v" sid="LUK 11:35" />Hessa gisho, ne garsan de7iya poo7oy dhumonna mela naageta. <verse eid="LUK 11:35" /><verse number="36" style="v" sid="LUK 11:36" />Hiza, ne kumetha asatethay poo7o gidiko, ne asatethanka hari dhuma bessi dhayiko, ne asatethaa kumethay wolile poo7o mela gidees” yaagis.<verse eid="LUK 11:36" /></para>
  <para style="s1">Usupun Ayyeta</para>
  <para style="r">(<ref loc="MAT 23:1-36">Maato 23:1-36</ref>; <ref loc="MRK 12:38-40">Mar 12:38-40</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 11:37" />Yesuusi ba oda ongida mela issi Farsaawey baara kathi maana mela xeegis. Yesuusi, iyara issife gelidi gibira bolla uttis. <verse eid="LUK 11:37" /><verse number="38" style="v" sid="LUK 11:38" />Farsaawey Yesuusi kathi maanape sinthe kushe meecconaysa be7idi malaaletis.<verse eid="LUK 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 11:39" />Goday iyako, “Hinte Farsaaweti quulesinne shaates bolla bagga meeceta. Shin hinte gaathay uuzetethaninne iitatethan kumis. <verse eid="LUK 11:39" /><verse number="40" style="v" sid="LUK 11:40" />Hinteno, eeyato, kare bagga medhiday, gaatha bagga medhiday iya gidennee? <verse eid="LUK 11:40" /><verse number="41" style="v" sid="LUK 11:41" />Shin quuliyaninne shaatiyan de7eysa manqotas immite. He wode hintew ubbabay geeshshi gidana.<verse eid="LUK 11:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 11:42" />“Farsaaweto hintena ayye! Sawope, xalootepenne hessa melabaape asraata kesseeta. Shin xillotethinne Xoosse dosoy hintenan baawa. Harata aggonna haysataka oothanaw bessees, shin aggideta.<note caller="-" style="x"><char style="xo" closed="false">11:42 </char><char style="xt" closed="false"><ref loc="LEV 27:30">Leewe 27:30</ref>.</char></note><verse eid="LUK 11:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 11:43" />“Farsaaweto hintena ayye! Ayhude woosa keethan boncho oyde, giya giddon boncho sarotho doseeta.<verse eid="LUK 11:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 11:44" />“Mali dhayin, asay eronna bollara biya duufo daaneysato hintena ayye!” yaagis.<verse eid="LUK 11:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 11:45" />Higge astamaarey zaaridi, “Astamaariyaw, ne hessa gashe nuna cayaasa” yaagis.<verse eid="LUK 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LUK 11:46" />Yesuusi, “Hinteno, higge astamaareto, hintenaka ayye! Asay tookanaw danda7onna deexo tooho toosseta, shin hinte hinte huuphes hari attoshin biradhe xeeranka bocheketa.<verse eid="LUK 11:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 11:47" />“Hinte aawati wodhida nabeta duufuwa hinte giigisiya gisho, hintena ayye! <verse eid="LUK 11:47" /><verse number="48" style="v" sid="LUK 11:48" />Hiza, hinte aawata oosuwa minthanaw enti wodhida nabeta duufuwa hinte loythiya gisho, enta iita oosuwas hinte marka. <verse eid="LUK 11:48" /><verse number="49" style="v" sid="LUK 11:49" />Hessa gisho, Xoossay ba cincatethan, ‘Nabetanne hawaareta ta hintew kiittana, shin hinte baggata wodhana; harata gooddana’ yaagis. <verse eid="LUK 11:49" /><verse number="50" style="v" sid="LUK 11:50" />Ha yeletethay alamey medhetoosape hanno gakanaw gukida nabeta ubbaa suuthas oyshetana. <verse eid="LUK 11:50" /><verse number="51" style="v" sid="LUK 11:51" />Aabelape doomidi yarsho bessaasinne xoossa keethafe gidduwan gukida Zakaryaasa suutha gisho ha yeletethay oyshetana.<note caller="-" style="x"><char style="xo" closed="false">11:51 </char><char style="xt" closed="false"><ref loc="GEN 4:8">Medhe 4:8</ref>; <ref loc="2CH 24:20-21">2 Taari 24:20-21</ref>.</char></note><verse eid="LUK 11:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 11:52" />“Higge astamaareto, hintena ayye! Eratetha qulpiya hinte kushen oykideta, shin hintew geleketa harataka gelseketa” yaagis.<verse eid="LUK 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LUK 11:53" />Yesuusi yaape baanaw keyiya wode, higge astamaaretinne Farsaaweti iyara eqetidi oyshon waaysosona. <verse eid="LUK 11:53" /><verse number="54" style="v" sid="LUK 11:54" />Iya doonape keyiya qaalan iya oykanaw koydi hessa oothidosona.<verse eid="LUK 11:54" /></para>
  <chapter eid="LUK 11" />
  <chapter number="12" style="c" sid="LUK 12" />
  <para style="s1">Ayyaana Minthetho</para>
  <para style="r">(<ref loc="MAT 10:26-27">Maato 10:26-27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 12:1" />He wode daro mukulun taybetiya asay woli bolla yedhetana gakanaw asi asa bolla shiiqidi de7ishin, Yesuusi ba tamaaretako, “Farsaaweta irshofe naagetite. Hessika enta cubbotethaa.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 16:6">Maato 16:6</ref>; <ref loc="MRK 8:15">Mar 8:15</ref>.</char></note> <verse eid="LUK 12:1" /><verse number="2" style="v" sid="LUK 12:2" />Qonconna qosetidi, eretonna geemmidi attiyabay aykoyka baawa.<note caller="-" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="MRK 4:22">Mar 4:22</ref>; <ref loc="LUK 8:17">Luqa 8:17</ref>.</char></note> <verse eid="LUK 12:2" /><verse number="3" style="v" sid="LUK 12:3" />Hiza, hinte dhuman odetidabay ubbay poo7on si7etana, qol7a gaathan kalkashidabay dabaaban odetana.<verse eid="LUK 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 12:4" />“Ta baggato, ta odeysa si7ite; ashuwa wodhoosonape attishin, haraa aykoka oothanaw danda7onaysatas babofite. <verse eid="LUK 12:4" /><verse number="5" style="v" sid="LUK 12:5" />Hanoshin, hinte babanaw besseysa ta hintew qoncisana. Hessika wodhidaape guye Gaannamen yegganaw wolqay de7eysas iyaw babite. Ee, tuma odayis; iyaw babite. <verse eid="LUK 12:5" /><verse number="6" style="v" sid="LUK 12:6" />Ichashu buubeti issi santimes bayzetokonayee? Hanoshin, entafe issinnaka Xoossaa sinthan dogetuku. <verse eid="LUK 12:6" /><verse number="7" style="v" sid="LUK 12:7" />Hari attoshin, hinte huuphe binaanayka paydetidi de7ees. Hiza, babofite; daro buubetape hinte aadheta.<verse eid="LUK 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 12:8" />“Ta odeysa si7ite; asa sinthan taw markatiya ubbaas Asa Na7i Xoossa kiitanchota sinthan markatana. <verse eid="LUK 12:8" /><verse number="9" style="v" sid="LUK 12:9" />Asa sinthan tana kaddeysas Xoossa kiitanchota sinthan ta iya kaddana. <verse eid="LUK 12:9" /><verse number="10" style="v" sid="LUK 12:10" />Asa Na7a bolla kadhe qaala haasaya ubbay maarota demmana, shin Geeshsha Ayyaana bolla kadhe qaala odeteysi maaretenna.<note caller="-" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="MAT 12:32">Maato 12:32</ref>; <ref loc="MRK 3:29">Mar 3:29</ref>.</char></note><verse eid="LUK 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 12:11" />“Asi hintena oykidi ayhude woosa keethan, daynnata sinthaninne kawota sinthan gooshechiya wode ay odanekonne woygi zaaraneko hirgofite.<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="MAT 10:19-20">Maato 10:19-20</ref>; <ref loc="MRK 13:11">Mar 13:11</ref>; <ref loc="LUK 21:14-15">Luqa 21:14-15</ref>.</char></note> <verse eid="LUK 12:11" /><verse number="12" style="v" sid="LUK 12:12" />He wode hinte odanaba Geeshsha Ayyaani hintena tamaarsana” yaagis.<verse eid="LUK 12:12" /></para>
  <para style="s1">Dure Ura Eeyatethi</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 12:13" />Asaa giddofe issi asi Yesuusako yidi, “Ta ishay taw nu aawa laatape shaakana mela iyaw oda” yaagis.<verse eid="LUK 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 12:14" />Yesuusi zaaridi, “La addiyaw, hinte bolla tana daynnanne laata shaakiya cima oothiday oonee?” yaagis. <verse eid="LUK 12:14" /><verse number="15" style="v" sid="LUK 12:15" />Gujidika, Yesuusi, “Asa de7oy shalo darotethan gidonna gisho yaare aggidi minthidi hintena naagite” yaagis.<verse eid="LUK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 12:16" />Kaallidika leemison, “Gadey daro kathi immiya issi dure uray de7ees. <verse eid="LUK 12:16" /><verse number="17" style="v" sid="LUK 12:17" />He uray, ‘Ta katha taani shiishanaw bessi guuxida gisho ay ootho?’ yaagidi ba wozanan qopis. <verse eid="LUK 12:17" /><verse number="18" style="v" sid="LUK 12:18" />Hizape yaatana; kase de7iya shaaleta laallada haraa dalga shaaleta keexana. Kathinne taw de7iyaba ubbaa iyan yeggana. <verse eid="LUK 12:18" /><verse number="19" style="v" sid="LUK 12:19" />Ba shempeko, ‘Ta shempete, daro laythas new gidiya shalo shiishas. Hiza, shempada ma, uya, ufayta’ yaagana.<verse eid="LUK 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 12:20" />“Shin Xoossay, ‘La, eeya uraw, hachi qamma ne shempiya neepe eketawusu. Hiza, ne shiishidabay ooddes gidanee?’ yaagis.<verse eid="LUK 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 12:21" />“Hessa gisho, baw duretethi sa7an shiishiya asas, Xoossaa matan dure gidonna asaas wursethay ha ura mela” yaagis.<verse eid="LUK 12:21" /></para>
  <para style="s1">Un7etofite</para>
  <para style="r">(<ref loc="MAT 6:25-34">Maato 6:25-34</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 12:22" />Hessafe guye, Yesuusi ba tamaaretako, “Hiza, ta odiyaba si7ite, hinte shempuwas ay miino? Hinte asatethaas ay ma7ino? yaagidi un7etofite. <verse eid="LUK 12:22" /><verse number="23" style="v" sid="LUK 12:23" />Shempoy kathafe, asatethi afilape aadhees. <verse eid="LUK 12:23" /><verse number="24" style="v" sid="LUK 12:24" />Kafota be7ite zerokona, kiishokona, eleynne shaaley entaw baawa. Shin Xoossay entana muzees. Hinte kafotape daro aadheta. <verse eid="LUK 12:24" /><verse number="25" style="v" sid="LUK 12:25" />Hanoshin, hintefe un7etidi ba laytha bolla issi qamma gujanaw danda7ey oonee? <verse eid="LUK 12:25" /><verse number="26" style="v" sid="LUK 12:26" />Hiza, ha guuthaba oothanaw danda7onna hinte, harabas ayis un7etetii? <verse eid="LUK 12:26" /><verse number="27" style="v" sid="LUK 12:27" />Ane ciishshati waanidi dicciyako be7ite. Waayokonanne suqokona. Hari attoshin, Solomoney ba de7iya boncho ubban entafe issuwa melaka ma7ibeenna.<note caller="-" style="x"><char style="xo" closed="false">12:27 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 Kawo 10:4-7</ref>; <ref loc="2CH 9:3-6">2 Taari 9:3-6</ref>.</char></note> <verse eid="LUK 12:27" /><verse number="28" style="v" sid="LUK 12:28" />Hinteno, ammanoy pacidaysato, hiza, Xoossay hachi bentidi wonto taman yegetana ciishshata haysada mayziko, hintena waati aathidi mayzennee? <verse eid="LUK 12:28" /><verse number="29" style="v" sid="LUK 12:29" />Hessa gisho, ay mino woyko ay uyino gidi un7etofite. <verse eid="LUK 12:29" /><verse number="30" style="v" sid="LUK 12:30" />He ubbaas Xoossaa ammanonna asati un7etoosona. Shin hinte aaway Xoossay hessi ubbay hintew koshsheysa erees. <verse eid="LUK 12:30" /><verse number="31" style="v" sid="LUK 12:31" />Ubbaafe aathidi Xoossa kawotetha koyite; hessi ubbay hintew guji imetana.<verse eid="LUK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 12:32" />“Hinteno, guutha dereto, yayyofite; hinte aawa Xoossay kawotetha hintew immanaw ufaytees. <verse eid="LUK 12:32" /><verse number="33" style="v" sid="LUK 12:33" />Hintew de7iyaba bayzidi manqotas immite. Kaysoy ekonnason, bili moonnason, cimonna karxiitan, wuronna shalo salon shiishite. <verse eid="LUK 12:33" /><verse number="34" style="v" sid="LUK 12:34" />Hinte wozanay hinte shaloy de7iya bessan gidana.<verse eid="LUK 12:34" /></para>
  <para style="s1">Barkidi Naago</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 12:35" />“Qanthan dancidi giigetite; hinte xompey poo7o.<note caller="-" style="x"><char style="xo" closed="false">12:35 </char><char style="xt" closed="false"><ref loc="MAT 25:1-13">Maato 25:1-13</ref>.</char></note> <verse eid="LUK 12:35" /><verse number="36" style="v" sid="LUK 12:36" />Banta goday yaaganope simmana gakanaw barkidi naageysatada, goday yidi xeegiya wode ellesidi dooyanaw giigida asata daanite.<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="MRK 13:34-36">Mar 13:34-36</ref>.</char></note> <verse eid="LUK 12:36" /><verse number="37" style="v" sid="LUK 12:37" />Banta goday simmiya wode dhiskonna de7ishe naageysati anjetidaysata. Tuma gayis; goday qanthan dancidi gayta yuushon utisidi mokees. <verse eid="LUK 12:37" /><verse number="38" style="v" sid="LUK 12:38" />Goday laade gidin, giddi bilahe gidin, woyko wonti maathe gidin yidi, hessa mela dhiskona naagishin demmiya he aylleti anjetidaysata. <verse eid="LUK 12:38" /><verse number="39" style="v" sid="LUK 12:39" />Shin haysa erite; kaysoy awude yaaneko keetha aaway eriyako keethay boketiya wode si77i gidi be7enna.<note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 24:23-44">Maato 24:23-44</ref>.</char></note> <verse eid="LUK 12:39" /><verse number="40" style="v" sid="LUK 12:40" />Hinteka giigidi naagite; Asa Na7i hinte qoponna wode yaana” yaagis.<verse eid="LUK 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 12:41" />Phexroosika, “Godaw ha leemisuwa nu xalaalas odaye woyko asa ubbaasee?” yaagis.<verse eid="LUK 12:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 12:42" />Goday zaaridi, “Hiza, kathaa muzanaw bessiya wodiyan immana mela goday ba aylleta bolla shuumida ammantheysinne wozanaama halaqay oonee? <verse eid="LUK 12:42" /><verse number="43" style="v" sid="LUK 12:43" />Goday simmiya wode hessa mela oothishe bentiya aylley, I anjetidaysa <verse eid="LUK 12:43" /><verse number="44" style="v" sid="LUK 12:44" />Ta hintew tuma odayis; ba godaas de7iya shalo ubbaa bolla I, shuumetana. <verse eid="LUK 12:44" /><verse number="45" style="v" sid="LUK 12:45" />Shin he aylley, ‘Ta goday elle yeenna’ yaagidi ba wozanan qopidi, macca aylletanne adde aylleta wadhiko, qassi baw koyda mela mishenne uyishe mathotiko, <verse eid="LUK 12:45" /><verse number="46" style="v" sid="LUK 12:46" />he aylliya goday, I qoponna gallasaninne hirgonna wode yaana. Yidi iya qanxerethidi, iya qaada ammanonna asaara oothana.<verse eid="LUK 12:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 12:47" />“Godaa sheniyada giigonnaysinne iya goday ay dosiyako erishe oothonna aylley daro garaafetana. <verse eid="LUK 12:47" /><verse number="48" style="v" sid="LUK 12:48" />Shin ba godaa sheniya eronna attidi garaafetanaw besseysa oothiday guuthara garaafetana. Gaasoyka daro imetidaysafe daro koyetees, daro hadara ekidaysafeka daro immana gidi naagetees.<verse eid="LUK 12:48" /></para>
  <para style="s1">Sarotethi Gidonashin Shaaketethi</para>
  <para style="r">(<ref loc="MAT 10:34-36">Maato 10:34-36</ref>)</para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 12:49" />“Taani yiday biitta bolla tama oythanaasa. Ha77i tamay oykiyako tana waanidi ufaysandesha! <verse eid="LUK 12:49" /><verse number="50" style="v" sid="LUK 12:50" />Hanoshin, ta ha77i xammaqetey xinqatey de7ees. I poletana gakanaw ta daro un7etayis.<note caller="-" style="x"><char style="xo" closed="false">12:50 </char><char style="xt" closed="false"><ref loc="MRK 10:38">Mar 10:38</ref>.</char></note> <verse eid="LUK 12:50" /><verse number="51" style="v" sid="LUK 12:51" />Sa7a bolla sarotethi ehanaw yida hintew daanii? Gidenna, ta yiday shaakanaasa. <verse eid="LUK 12:51" /><verse number="52" style="v" sid="LUK 12:52" />Ha77ife doomidi woli giddon shaaketida ichashu keethaa asati issife de7oosona. Nam7ati heedzata bolla, heedzatika nam7ata bolla, dendidi shaaketoosona. <verse eid="LUK 12:52" /><verse number="53" style="v" sid="LUK 12:53" />Aaway na7aa bolla, na7ayka aawa bolla, aayiya na7e bolla, na7iya aaye bolla, azinaa aayiya na7a mache bolla, na7a machiya azina aaye bolla, dendidi shaaketana.”<note caller="-" style="x"><char style="xo" closed="false">12:53 </char><char style="xt" closed="false"><ref loc="MIC 7:6">Miki 7:6</ref>.</char></note><verse eid="LUK 12:53" /></para>
  <para style="s1">Wodetaba Ero</para>
  <para style="r">(<ref loc="MAT 16:2-3">Maato 16:2-3</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 12:54" />Qassika asaako, “Wuloha baggara saloy shaaratiya wode be7idi, ellesidi, ‘Iri yaana’ yaageeta, hessadaka hanees. <verse eid="LUK 12:54" /><verse number="55" style="v" sid="LUK 12:55" />Dugeha carkoy carkiya wode ‘Sa7i awana’ yaageeta, hessadaka hanees” yaagis. <verse eid="LUK 12:55" /><verse number="56" style="v" sid="LUK 12:56" />Hinteno, cubboto, Salobanne sa7aba shaakidi ereetashin ha wodiya shaakidi eroy hintena waanidi xoonidee?<verse eid="LUK 12:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 12:57" />“Yaatin, hinte huuphes ayis tuma pirdeketii? <verse eid="LUK 12:57" /><verse number="58" style="v" sid="LUK 12:58" />Ne morkiyara wolla daynna sinthan eqanaw bashe oge bolla giiganaw koya. Ne giigonna ixiko gooshechidi daynna sinthe nena efana. Daynnay nena qachiya asas aathidi immana. I nena woynen yeggana. <verse eid="LUK 12:58" /><verse number="59" style="v" sid="LUK 12:59" />Si7ite, issi bakani attonna cigga ongana gakanaw ne yaape keyonnaysa era” yaagis.<verse eid="LUK 12:59" /></para>
  <chapter eid="LUK 12" />
  <chapter number="13" style="c" sid="LUK 13" />
  <para style="s1">Nagarape Simo</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 13:1" />He wode Yesuusako asay yidi Philaxoosi wodhidi enta suuthara enta yarshuwa walakida Galila asaaba odida asati he bessan de7oosona. <verse eid="LUK 13:1" /><verse number="2" style="v" sid="LUK 13:2" />I haysada yaagidi zaaris; “Yaatin he Galila asati he iita hayqo hayqida gisho, Galilan de7iya asa ubbaafe aadhida nagarancho daanonna? <verse eid="LUK 13:2" /><verse number="3" style="v" sid="LUK 13:3" />Gidenna! Gidoshin, hinteka maarotan simmonna ixiko, ubbay hessada dhayana. <verse eid="LUK 13:3" /><verse number="4" style="v" sid="LUK 13:4" />Woyko qassi Salihoome geetetiya bessan gimbey woddidi wodhida tammanne hospun asay Yerusalaamen de7iya asa ubbaafe aadhida nagarancho daanonna? <verse eid="LUK 13:4" /><verse number="5" style="v" sid="LUK 13:5" />Gidenna! Shin hinteka maarotan simmonna ixiko ubbay hessada dhayana.”<verse eid="LUK 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 13:6" />Qassika Yesuusi haysada gidi leemiso odis: “Issi uraas woyne gaden toketida balase mithi de7awusu. I iipe ayfe demmanaw koydi aykoka demmibeenna. <verse eid="LUK 13:6" /><verse number="7" style="v" sid="LUK 13:7" />Woyne gadiya goday woyne oosanchuwako, ‘Ayfe demmanaw koyada heedzu laythi simeretada aykoka demmabike. Hessa gisho, qanxa digga; ayis biitta melisay?’ yaagis.<verse eid="LUK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 13:8" />“Shin oosanchoy, ‘Godaw, I yuushuwa oothada osha yeggana gakanaw ha laythas aggarki. <verse eid="LUK 13:8" /><verse number="9" style="v" sid="LUK 13:9" />Ha laythi ayfiko lo77o, ixiko qanxa agga’ ” yaagidi zaaris.<verse eid="LUK 13:9" /></para>
  <para style="s1">Zoko Kuuna Maccasiw</para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 13:10" />Yesuusi Sambaata gallas ayhude woosa keethan tamaarsees. <verse eid="LUK 13:10" /><verse number="11" style="v" sid="LUK 13:11" />He bessan tammanne hospun laythi tuna ayyaani zoko kuunisida issi maccasiya de7awusu. Iya kuunape dendoysan suure eqanaw danda7uku. <verse eid="LUK 13:11" /><verse number="12" style="v" sid="LUK 13:12" />Yesuusi iyo be7ida wode xeegidi, “Ha maccasete, ne hargiyafe paxadasa” yaagis. <verse eid="LUK 13:12" /><verse number="13" style="v" sid="LUK 13:13" />Ba kushiya I bolla wothin, iya ellesada, suurada eqasu. Xoosse galatasu.<verse eid="LUK 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 13:14" />Shin ayhude woosa keetha halaqay yilotidi asaako, “Ooso oothiya usupun gallasati de7oosona. Hessa gisho, he gallasatan yidi paxitepe attishin, Sambaata gallas gidenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="EXO 20:9-10">Kessa 20:9-10</ref>; <ref loc="DEU 5:13-14">Zaare 5:13-14</ref>.</char></note><verse eid="LUK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 13:15" />Goday, “Cubboto, hinte giddofe boori woyko hare Sambaata gallas zadalope billidi haathe ushshanaw efonnay oonee? <verse eid="LUK 13:15" /><verse number="16" style="v" sid="LUK 13:16" />Yaatin, ha maccasiya Abrahaame na7a gidashe xalahen qashetada tammanne hospun laythi kumethi de7idaaris Sambaata gallas birshetethi koshshennee?” yaagidi oychis.<verse eid="LUK 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 13:17" />I hessa odida wode eqeteysati ubbay yeellatidosona. Shin asa ubbay I oothida malaalsiya ooso ubban ufaytidosona.<verse eid="LUK 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 13:18" />Hessafe guye, Yesuusi haysada yaagis, “Xoossa kawotethi ay daanii? Iya aybira daaniso? <verse eid="LUK 13:18" /><verse number="19" style="v" sid="LUK 13:19" />Xoossa kawotethi issi asi ba goshshan tokida wola ayfe mela. I diccidi mithi gidis. Salo kafoti iya tashiya bolla shempidosona.”<verse eid="LUK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 13:20" />Qassi, “Xoossaa kawotetha aybira daaniso? <verse eid="LUK 13:20" /><verse number="21" style="v" sid="LUK 13:21" />Issi maccasiya daro dhiillera walakada munuqida guutha irsho daanees” yaagis.<verse eid="LUK 13:21" /></para>
  <para style="s1">Xuuntha Wula</para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 13:22" />Hessafe guye, Yesuusi Yerusalaame bishe I kanthiya ogiyan de7iya katamataninne gutatan tamaarsishe aadhis. <verse eid="LUK 13:22" /><verse number="23" style="v" sid="LUK 13:23" />Issi asi Yesuusako, “Godaw, attanay guutha asa xalaalee?” yaagidi oychis.</para>
  <para style="p" vid="LUK 13:23">Yesuusi entako, <verse eid="LUK 13:23" /><verse number="24" style="v" sid="LUK 13:24" />“Si7ite, xuuntha wulara gelanaw baaxetite. Daroti gelanaw koyoosona shin entaw hanenna. <verse eid="LUK 13:24" /><verse number="25" style="v" sid="LUK 13:25" />Keetha aaway dendidi wulaa gordidaape guye, ‘Nuus dooyarki’ yaagishe karen eqidi xeessi oyketa. Shin I, ‘Hinte oonekonne awupe yidaako ta erike’ gidi zaarana. <verse eid="LUK 13:25" /><verse number="26" style="v" sid="LUK 13:26" />He wode hinte, ‘Neera wolla mida, uyida, nu dabaabanka tamaarsadasa’ yaagana.<verse eid="LUK 13:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 13:27" />“I zaaridi, ‘Hinte oonekonne awupe yidaako erike. Hinteno, geellato taape haakite’ yaagana.<note caller="-" style="x"><char style="xo" closed="false">13:27 </char><char style="xt" closed="false"><ref loc="PSA 6:8">Maz 6:8</ref>.</char></note> <verse eid="LUK 13:27" /><verse number="28" style="v" sid="LUK 13:28" />Abrahaame, Yisaaqa, Yayqoobanne nabeta ubbaa Xoossa kawotethan be7ana, shin hinte karen wodhidi attiya wode hintew yeehonne ache garcethi gidana. <verse eid="LUK 13:28" /><verse number="29" style="v" sid="LUK 13:29" />Asay dolohape, wulohape, pudehapenne dugehape yidi Xoossaa kawotethan gibira bolla uttana.<note caller="-" style="x"><char style="xo" closed="false">13:29 </char><char style="xt" closed="false"><ref loc="MAT 8:11-12">Maato 8:11-12</ref>; <ref loc="MAT 22:13">22:13</ref>; <ref loc="MAT 25:30">25:30</ref>.</char></note> <verse eid="LUK 13:29" /><verse number="30" style="v" sid="LUK 13:30" />Hessa gisho, ha77i dethan guye gididaysatape sinthe gidanaysati, sinthe gididaysatape guye gidanaysati de7oosona” yaagis.<note caller="-" style="x"><char style="xo" closed="false">13:30 </char><char style="xt" closed="false"><ref loc="MAT 19:30">Maato 19:30</ref>; <ref loc="MAT 20:16">20:16</ref>; <ref loc="MRK 10:31">Mar 10:31</ref>.</char></note><verse eid="LUK 13:30" /></para>
  <para style="s1">Yesuusi Yerusalaames Yeekis</para>
  <para style="r">(<ref loc="MAT 23:37-39">Maato 23:37-39</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 13:31" />He wode Farsaawetape issoti issoti yidi, “Herodiisi nena wodhanaw koyiya gisho ha bessaafe dendada ba” gidoosona.<verse eid="LUK 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 13:32" />I zaaridi, “Bidi, he workanaas, ‘Heko, hachinne wonto tuna ayyaanata kessana, harganchota pathana, heedzantho gallasan kuushsha bolla gakana’ yaagis giite. <verse eid="LUK 13:32" /><verse number="33" style="v" sid="LUK 13:33" />Hanope attishin, nabey Yerusalaamepe karen hayqanaw bessenna. Hessa gisho, hachi, wontonne wonti pee7in he bessa baanaw dendas.<verse eid="LUK 13:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 13:34" />“Yerusalaame, Yerusalaame, nabeta wodhiyare, neeko kiitetidaysata shuchan caddiyare, kuttoy ba nayta ba qefiyape garsan shiishiyada ne nayta ta qesiyape garsan aapun toho shiishanaw koyadina, shin hinte ixas gideta. <verse eid="LUK 13:34" /><verse number="35" style="v" sid="LUK 13:35" />Ta hintew odayis; hinte keethay kaysatana. Godaa sunthan yeysi anjetidaysa hinte gaana gakanaw tana demmeketa” yaagis.<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Maz 118:26</ref>; <ref loc="JER 22:5">Ermi 22:5</ref>.</char></note><verse eid="LUK 13:35" /></para>
  <chapter eid="LUK 13" />
  <chapter number="14" style="c" sid="LUK 14" />
  <para style="s1">Yesuusi Farsaawiya Son</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 14:1" />Issi Sambaata gallas Yesuusi issi Farsaaweta halaqa soo kathi maanaw geliya wode asay caddi xeelloosona. <verse eid="LUK 14:1" /><verse number="2" style="v" sid="LUK 14:2" />He bessan shawuhe hargen waayetiya issi asi iyaw sintha baggara zin7is. <verse eid="LUK 14:2" /><verse number="3" style="v" sid="LUK 14:3" />Yesuusi Farsaawetanne higge astamaareta, “Sambaata gallas hargancho pasoy wogeye woga gidennee?” yaagidi oychis. <verse eid="LUK 14:3" /><verse number="4" style="v" sid="LUK 14:4" />Enti si77i gidoosona. Yesuusi hargetiya uraa bochi pathidi moyzis.<verse eid="LUK 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 14:5" />“Qassika hintefe issuwas na7i woyko boori Sambaata gallas aafon wulliko, ellesidi kessonnay oonee?”<note caller="-" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="MAT 12:11">Maato 12:11</ref>.</char></note> yaagidi oychis. <verse eid="LUK 14:5" /><verse number="6" style="v" sid="LUK 14:6" />Enti issibaaka zaaranaw danda7ibookona.<verse eid="LUK 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 14:7" />Yesuusi imatuwas xeegetidaysati boncho bessi doorishin be7idi, ha leemisuwa odis: <verse eid="LUK 14:7" /><verse number="8" style="v" sid="LUK 14:8" />“Issi asi nena yaagano xeegiko boncho bessan uttofa. Neepe aadhidi bonchetiya asi xeegetanaw danda7ees.<note caller="-" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="PRO 25:6-7">Leemi 25:6-7</ref>.</char></note> <verse eid="LUK 14:8" /><verse number="9" style="v" sid="LUK 14:9" />Hintena nam7ataka xeegidaysi yidi, ‘Ne bessa ha imathas yedda’ giya wode neeni yeellatashe ziqa bessi wodhaasa. <verse eid="LUK 14:9" /><verse number="10" style="v" sid="LUK 14:10" />Gidoshin, ne xeegetida wode koyrottada ziqa bessi be7ada utta. Xeegoysi yidi, ‘Ta laggiyaw, ha boncho bessan utta’ yaagana. He wode neera issife xeegetida asa ubbaa sinthan ne bonchetana. <verse eid="LUK 14:10" /><verse number="11" style="v" sid="LUK 14:11" />Bana dhoqu dhoqu oothiya ubbay kawuyana; bana ziqi ziqi oothiya ubbay dhoqu dhoqu gaana.”<note caller="-" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="MAT 23:12">Maato 23:12</ref>; <ref loc="LUK 18:14">Luqa 18:14</ref>.</char></note><verse eid="LUK 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LUK 14:12" />Qassi Yesuusi iya mokida keetha aawako, “Quma woyko kaho imato xeegiya wode, neeni kushe zaaro xeegonna mela ne laggeta woyko ne ishata woyko ne dabbota woyko ne dure shoorota imato xeegopa. <verse eid="LUK 14:12" /><verse number="13" style="v" sid="LUK 14:13" />Gidoshin, ne imato giigisida wode manqota, wobbeta, gundatanne qooqeta xeega; neeni anjetana. <verse eid="LUK 14:13" /><verse number="14" style="v" sid="LUK 14:14" />Haysati kushe zaaranaw danda7onna gisho kushe zaaroy geeshshata dendo gallasan new simmana” yaagis.<verse eid="LUK 14:14" /></para>
  <para style="s1">Gita Imato Leemiso</para>
  <para style="r">(<ref loc="MAT 22:1-10">Maato 22:1-10</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 14:15" />Yesuusara wolla imato bolla uttoyisata giddofe issoy, hessa si7idi, “Xoossa kawotethan imato bolla utteysi anjetidaysa” yaagis.<verse eid="LUK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 14:16" />Yesuusi, “Issi asi gita imato giigisidi daro asata xeegis. <verse eid="LUK 14:16" /><verse number="17" style="v" sid="LUK 14:17" />Imatoy moketiya saatey gakiya wode, xeegetida imathata, ‘Heko ubbabay giigis, haa yiite’ yaagidi xeeganaada ba aylliya kiittis.<verse eid="LUK 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 14:18" />“Shin ubbayka banta gaaso gaaso medhidosona. Issoy, ‘Ha77i buroo gade shammida gisho, bada be7anaw koshshees; hayyana tana aggarki yaaga’ yaagis. <verse eid="LUK 14:18" /><verse number="19" style="v" sid="LUK 14:19" />Hankoy, ‘Ichashu waatha boori shammas; entana waaxa be7ana gisho hayyana tana lancofa’ yaagis. <verse eid="LUK 14:19" /><verse number="20" style="v" sid="LUK 14:20" />Qassi haray, ‘Taani buroo meddan de7iya gisho, yaanaw danda7ike’ yaagis.<verse eid="LUK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 14:21" />“Aylley simmi yidi he ubbaa ba godaas odis. He wode yaagano aaway hanqetidi aylliyako, ‘Ellesada kataman de7iya wogga ogetanne daggalata bada, manqota, wobbeta, qooqetanne gundata haa eha’ yaagis.<verse eid="LUK 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 14:22" />“Aylley, ‘Ta godaw, ne kiittidaysi ubbay poletis, shin ha77ika bessi de7ees’ yaagis.<verse eid="LUK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 14:23" />“Goday aylliyako, ‘Horogata bollanne, gade giddo ogeta keya, ta keethay kumana gakanaw demmida ubba yaana mela ootha. <verse eid="LUK 14:23" /><verse number="24" style="v" sid="LUK 14:24" />Ta hintew odayis; imato xeegetidaysatape oonika ta gibiraape moonnaysa erite’ gis” yaagis.<verse eid="LUK 14:24" /></para>
  <para style="s1">Godaa Kaaloy Cigsiya Gate</para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 14:25" />Daro asay iyara wolla bishin, Yesuusi entako guye simmidi, <verse eid="LUK 14:25" /><verse number="26" style="v" sid="LUK 14:26" />“Taako yaa ubbay ba aawanne ba aayiw, ba machiwnne ba nayta, ba ishatanne ba micheta, hari attoshin ba de7uwa ixonnay ta tamaare gidanaw danda7enna.<note caller="-" style="x"><char style="xo" closed="false">14:26 </char><char style="xt" closed="false"><ref loc="MAT 10:37">Maato 10:37</ref>.</char></note> <verse eid="LUK 14:26" /><verse number="27" style="v" sid="LUK 14:27" />Ba masqaliya tookidi tana kaallonnay ta tamaare gidanaw danda7enna.<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="MAT 10:13">Maato 10:13</ref>; <ref loc="MAT 16:24">16:24</ref>; <ref loc="MRK 8:34">Mar 8:34</ref>; <ref loc="LUK 9:23">Luqa 9:23</ref>.</char></note><verse eid="LUK 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 14:28" />“Hintefe issi asi shucha keethi keexanaw koyko, keetha keexidi onganaw ay mela miishe koshshiyako koyrottidi eranaw qopi be7onnay oonee? <verse eid="LUK 14:28" /><verse number="29" style="v" sid="LUK 14:29" />Hessa gidonna ixiko, ha uray baaso shuchu hiixin qustethi xooniko, <verse eid="LUK 14:29" /><verse number="30" style="v" sid="LUK 14:30" />be7iya ubbay, ‘Ha uray gimbethi oykin qustanaw iya xoonis’ yaagidi boroosona.<verse eid="LUK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 14:31" />“Woyko issi kawoy hara kawora oletanaw dendishe laatamu mukulu olanchota eki yaa kawuwara tammu mukulu olanchotara eqetanaw danda7anaysanne danda7onaysa uttidi zorettonay oonee? <verse eid="LUK 14:31" /><verse number="32" style="v" sid="LUK 14:32" />Eqetanaw danda7etonaba gidiko, he kawuwara haahon de7ishin giiganaw koyrottidi cima yeddidi oychees. <verse eid="LUK 14:32" /><verse number="33" style="v" sid="LUK 14:33" />Hessadaka, hintefe oonika baw de7iyaba ubba aggonna ixiko, ta tamaare gidanaw danda7enna.<verse eid="LUK 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 14:34" />“Maxiney lo77o, shin maxiney ba mal7uwa aggiko, waanidi maxine geetetanaw danda7ii? <verse eid="LUK 14:34" /><verse number="35" style="v" sid="LUK 14:35" />Biittatethasinne araddatethas maaddona gisho wora yegetees. Hiza, si7iya haythi de7iya asi si7o” yaagis.<verse eid="LUK 14:35" /></para>
  <chapter eid="LUK 14" />
  <chapter number="15" style="c" sid="LUK 15" />
  <para style="s1">Dhayda Dorsa Leemiso</para>
  <para style="r">(<ref loc="MAT 18:12-14">Maato 18:12-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 15:1" />Issi gallas qaraxa qanxeysatinne nagaranchoti Yesuusa timirtiya si7anaw iya yuushon shiiqidosona.<note caller="-" style="x"><char style="xo" closed="false">15:1 </char><char style="xt" closed="false"><ref loc="LUK 5:29-30">Luqa 5:29-30</ref>.</char></note> <verse eid="LUK 15:1" /><verse number="2" style="v" sid="LUK 15:2" />Shin Farsaawetinne higge astamaareti, “Haysi uray nagaranchota shiishidi ekees, entara issife mees” yaagidi zuuzumidosona.<verse eid="LUK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 15:3" />Yesuusi ha leemisuwa entaw yaagidi odis: <verse eid="LUK 15:3" /><verse number="4" style="v" sid="LUK 15:4" />“Hinte giddofe issuwas xeetu dorsati de7iyaba gidiko entafe issoy dhayiko uddufun tammanne uddufunata bazzon aggidi dhayoysa demmana gakanaw koyonnay oonee? <verse eid="LUK 15:4" /><verse number="5" style="v" sid="LUK 15:5" />Demmida wode ufaytidi ba gannan tookidi, <verse eid="LUK 15:5" /><verse number="6" style="v" sid="LUK 15:6" />ba soo simmees. Ba laggetanne shoorota xeegidi, ‘Dhayida ta dorsa demmas, taara issife ufaytite’ yaagees. <verse eid="LUK 15:6" /><verse number="7" style="v" sid="LUK 15:7" />Hessadaka, maaroti koshshonna uddufun tammanne uddufun xillotape aathidi, maarotan geliya issi nagaranchuwa gaason salon gita ufaysi gidees.<verse eid="LUK 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 15:8" />“Woyko tammu biri de7iya issi maccasiya tammaafe iissiya dhayiko demmana gakanaw xompe oythada keetha pittada mintha koyonnay oonee? <verse eid="LUK 15:8" /><verse number="9" style="v" sid="LUK 15:9" />Demmida wode ba laggetanne ba shoorota xeegada ‘Dhayida ta issi bira demmida gisho taara ufaytite’ yaagawusu. <verse eid="LUK 15:9" /><verse number="10" style="v" sid="LUK 15:10" />Si7ite, hessa mela issi maarotethan geliya nagaranchuwan Xoossaa kiitanchota sinthan ufaysi gidees” yaagis.<verse eid="LUK 15:10" /></para>
  <para style="s1">Dhayda Na7a Leemiso</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 15:11" />Zaaridi Yesuusi, “Issi uraas nam7u nayti de7oosona. <verse eid="LUK 15:11" /><verse number="12" style="v" sid="LUK 15:12" />Entafe kaalo na7ay ba aawako, ‘Ta aawaw, ne shaluwape ta gishuwa taw imma’ yaagis. Aaway ba shaluwa ba naytas shaakis. <verse eid="LUK 15:12" /><verse number="13" style="v" sid="LUK 15:13" />Guutha gallasape guye, kaalo na7ay ba gishuwa ubbaa, qachi ekidi haaho biitta bis. Yan altacan shaluwa toochidi ongis. <verse eid="LUK 15:13" /><verse number="14" style="v" sid="LUK 15:14" />I baw de7iyaba ubba wursidaape guye he biitta ubban mino koshi keyin metootis. <verse eid="LUK 15:14" /><verse number="15" style="v" sid="LUK 15:15" />Hessa gisho, he biitta asaape issuwa soo gaata gelis. Uray iya guduntho heemmana mela ba moothu yeddis. <verse eid="LUK 15:15" /><verse number="16" style="v" sid="LUK 15:16" />Gudunthoti miya harquwafe maanaw amottis, shin iyoka iyaw immiya asi bentibeenna. <verse eid="LUK 15:16" /><verse number="17" style="v" sid="LUK 15:17" />I ba wozanaako simmidi, ‘Aapun ta aawa aylletas kathi wora wodhin ta haysan koshara hayqanaw gakadina?’ <verse eid="LUK 15:17" /><verse number="18" style="v" sid="LUK 15:18" />Dendada ta aawako bada, ‘Ta aawaw, salon Xoossa, sa7an nena qohas. <verse eid="LUK 15:18" /><verse number="19" style="v" sid="LUK 15:19" />Hizape ne na7a geetetada xeegetanaw taw bessonna gisho, ne son de7iya aylletape issuwada tana payda’ yaagana” yaagis. <verse eid="LUK 15:19" /><verse number="20" style="v" sid="LUK 15:20" />Hessa gisho, dendidi ba aawako bis.</para>
  <para style="p" vid="LUK 15:20">“Hanoshin, I buroo haahon de7ishin aaway qadhetidi, iyako woxi bidi, idimmidi yeeris. <verse eid="LUK 15:20" /><verse number="21" style="v" sid="LUK 15:21" />Na7ayka, ‘Ta aawaw salon Xoossa, sa7an nena ta qohas. Hizape ne na7a geetetada xeegetanaw bessike’ yaagis.<verse eid="LUK 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 15:22" />“Iya aaway aylleta xeegidi, ‘Ellesidi ubbaafe lo77o gidida ma7o ehidi iya mayzite; iya biradhen sagaayo, iya tohon caamma aathite. <verse eid="LUK 15:22" /><verse number="23" style="v" sid="LUK 15:23" />Modho gatarmentho ehidi shukite, moos, ufaytoos. <verse eid="LUK 15:23" /><verse number="24" style="v" sid="LUK 15:24" />Ta na7ay haysi hayqis, shin ha77i paxis; dhayis, shin bentis’ yaagis. Hessafe guye, ufaysi doomidosona.<verse eid="LUK 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 15:25" />“He wode bayra na7ay goshsha gaden de7ees. Yaape yishe soo matishin yethinne gufa girsi si7is. <verse eid="LUK 15:25" /><verse number="26" style="v" sid="LUK 15:26" />I, aylletape issuwa xeegidi haniyabay aybeko eranaw oychis. <verse eid="LUK 15:26" /><verse number="27" style="v" sid="LUK 15:27" />Aylley, ‘Ne ishay saro yida gisho ne aaway modho gatarmentho iyaw shukis’ yaagis.<verse eid="LUK 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 15:28" />“Bayra ishay yilotidi soo gelanawuka koybeenna. Aaway kare keyidi soo gelana mela iya woossis. <verse eid="LUK 15:28" /><verse number="29" style="v" sid="LUK 15:29" />Shin I ba aawako, ‘Heko, haysa mela laythi ta new aylletada ne kiitaape issuwaka pacisonna new kiitetin, taani ta laggetara ufaytana mela hari attoshin issi laaqa deeshe immabaaka. <verse eid="LUK 15:29" /><verse number="30" style="v" sid="LUK 15:30" />Hanoshin, haysi ne na7ay ne shaluwa laymatara dhaysidi yin, modho gatarmentho shukadasa’ ” yaagis.<verse eid="LUK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 15:31" />“Aawayka, ‘Ta na7aw, neeni ubba wode taara de7aasa, taba ubbay neesa. <verse eid="LUK 15:31" /><verse number="32" style="v" sid="LUK 15:32" />Haysi ne ishay hayqis, shin paxis; dhayis, shin bentis. Hessa gisho, daro ufaytanaw bessees’ yaagana” yaagis.<verse eid="LUK 15:32" /></para>
  <chapter eid="LUK 15" />
  <chapter number="16" style="c" sid="LUK 16" />
  <para style="s1">Ammanetona Shuuma Leemiso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 16:1" />Yesuusi ba tamaaretako, “Issi dure uraas iyape garsara issi shuumi de7ees. He shuumay ba godaa shaluwa toochees giya worey keetha aawa gakis. <verse eid="LUK 16:1" /><verse number="2" style="v" sid="LUK 16:2" />Keetha aaway shuuma xeegisidi, ‘Taani woygiyaba si7adina? Hizape neeni ta keethas shuuma gidada oothanaw danda7onna gisho, ta shaluwa taw sheedha’ yaagis.<verse eid="LUK 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 16:3" />“He shuumay ba wozanan haysada yaagidi qopis: ‘Ta goday tana shuumatethaafe wothana hanees, goya aqanaw wolqi baawa, woossa maanaw yeellayees; yaatin ta waano? <verse eid="LUK 16:3" /><verse number="4" style="v" sid="LUK 16:4" />Shuumatethaafe ta wodhiya wode asay tana mokana mela oothanaba ta erayis’ yaagis.<verse eid="LUK 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 16:5" />“Hessa gisho, iya godaa acoy de7iya asaa issuwa issuwa xeegi ehidi koyro uraako, ‘Ne bolla ta godaa acoy ay meli de7ii?’ yaagidi oychis.<verse eid="LUK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 16:6" />“I, ‘Laatamu barmeele zayte acoy de7ees’ yaagis.</para>
  <para style="p" vid="LUK 16:6">“Shuumay, ‘Wule warqatiya he7e, ellesada, tammu barmeele zayte acoy de7ees gada xaafa’ yaagis.<verse eid="LUK 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 16:7" />“Hessafe kaallidi nam7anthuwako, ‘New aapuni de7ii?’ yaagis.</para>
  <para style="p" vid="LUK 16:7">“I, ‘Heedzu xeetanne laapun tammu kuntaale giste acoy de7ees’ yaagis.</para>
  <para style="p" vid="LUK 16:7">“Shuumay, ‘Ne wule warqatiya he7e, ellesada, 296 kuntaale yaagada xaafa’ yaagis. <verse eid="LUK 16:7" /><verse number="8" style="v" sid="LUK 16:8" />Keetha aaway ammanetibona shuuma iya cincatethaas nashshis. Ha alamiya nayti ase oythan poo7o naytape aadhida wozanaamata.<verse eid="LUK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 16:9" />“Hessa gisho, ta hintew odayis; ha alamiya miishey wuriya wode merinaa keethan moketana mela ha miishiyara hintew laggeta shammite. <verse eid="LUK 16:9" /><verse number="10" style="v" sid="LUK 16:10" />Ubbaafe guuthaban ammanetiday daroban ammanetidaysa gidees. Qassi ubbaafe guuthaban ammanetonaysi daroban ammanetena. <verse eid="LUK 16:10" /><verse number="11" style="v" sid="LUK 16:11" />Hiza, ha alame miishen hinte ammanetona ixiko, tuma miishe hintew ooni hadara immanee? <verse eid="LUK 16:11" /><verse number="12" style="v" sid="LUK 16:12" />Hinte hara asa miishen ammanetona ixiko, hinte buzo miishe hintew ooni immanee?<verse eid="LUK 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 16:13" />“Issi aylley nam7u godatas haaretanaw danda7enna. Issuwa ixiko hankuwa dosees woyko issuwako shiiqiko hankuwa kadhees. Hessadaka, hinte Xoossasinne miishes haaretanaw danda7eketa.”<note caller="-" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="MAT 6:24">Maato 6:24</ref>.</char></note><verse eid="LUK 16:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 16:14" />Miishe dosiya Farsaaweti hessa si7ida wode Yesuusa qelqisidosona. <verse eid="LUK 16:14" /><verse number="15" style="v" sid="LUK 16:15" />I, “Hinte, hintena asa sinthan xilliseeta, shin Xoossay hinte wozana erees. Asa sinthan bonchetidaysi Xoossa sinthan boretidaysa.<verse eid="LUK 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 16:16" />“Muse higgeynne nabeta kiitay Yohaanisa gakanaw hintew odetishe gam7is. Hessafe guye, Xoossaa kawotethaa Wongelay sabbaketishe gam7is. Asi ubbay yaa gelanaw dafetees.<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="MAT 11:12-13">Maato 11:12-13</ref>.</char></note> <verse eid="LUK 16:16" /><verse number="17" style="v" sid="LUK 16:17" />Gidoshin, higgiyafe issi laafa pidaley attanaape saloynne sa7i aadheysi kawuyees.<note caller="-" style="x"><char style="xo" closed="false">16:17 </char><char style="xt" closed="false"><ref loc="MAT 5:18">Maato 5:18</ref>.</char></note><verse eid="LUK 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 16:18" />“Ba machiw yeddidi haraa ekiya ubbay laammees. Ba azinaape anjetidaaro ekeysika laammees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Maato 5:32</ref>; <ref loc="2CO 7:10-11">2 Qoro 7:10-11</ref>.</char></note><verse eid="LUK 16:18" /></para>
  <para style="s1">Dure Uraanne Alaazara</para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 16:19" />“Al7onne alleeqo afila ma7iya, sa7i injetin gallas gallas ufaysan de7iya issi dure asi de7ees. <verse eid="LUK 16:19" /><verse number="20" style="v" sid="LUK 16:20" />Hari qassi asatethay kumethi madunxida issi Alaazara geetetiya manqoy he dure uraa karen yegetidi attidaysi de7ees. <verse eid="LUK 16:20" /><verse number="21" style="v" sid="LUK 16:21" />Koshape dendoysan dure ura gaytape wodhiya tiifiya maanaw amotishe de7ees. Hari attoshin, kanati yidi iya maduntha laacosona.<verse eid="LUK 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 16:22" />“He manqoy hayqis; kiitanchoti iya Abrahaame ki7o efidosona. Qassi dure urayka hayqidi moogetis. <verse eid="LUK 16:22" /><verse number="23" style="v" sid="LUK 16:23" />Si7oolen un7etidi de7ishe dhoqu gidi haahon Abrahaamenne iya ki7on de7iya Alaazara be7is. <verse eid="LUK 16:23" /><verse number="24" style="v" sid="LUK 16:24" />I, ‘Aawaw Abrahaame, taw qadhetarki; ha tama lacon un7etada de7iya gisho Alaazari ba biradhiya haathan yeddidi ta inxarsa laakothana mela hayyana iya yeddarki’ yaagidi waassis.<verse eid="LUK 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 16:25" />“Shin Abrahaamey iyako, ‘Ta na7aw, ne sa7an de7iya wode lo77obata ekidaysa, qassi Alaazari iitabata ekidaysa akeeka. Shin ha77i I haysan ufaytees, qassi neeni waayetashe de7aasa’ yaagis. <verse eid="LUK 16:25" /><verse number="26" style="v" sid="LUK 16:26" />Ha ubbaafe aadhidi, ‘Haape hinteko, hinipe haa nuuko aadhanaw koyeysati pinnonna mela nuusinne hintew giddon gita aafoy de7ees’ yaagis.<verse eid="LUK 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 16:27" />“Dure uray, ‘Aawaw, yaako Alaazara ta aawa soo kiittana mela ta nena woossayis. <verse eid="LUK 16:27" /><verse number="28" style="v" sid="LUK 16:28" />Taw ichashu ishati de7idosona, entika ha waaye bessaa yoonna mela entaw bidi markato’ yaagis.<verse eid="LUK 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 16:29" />“Shin Abrahaamey, ‘Entaw Museranne nabetara de7oosona; enti odiyaba si7onna’ yaagis.<verse eid="LUK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 16:30" />“Dure uray, ‘Aawaw Abrahaame, hessatho gidenna; issi asi hayqope dendidi biiko enti maarotan gelana’ yaagis.<verse eid="LUK 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 16:31" />“Abrahaamey, ‘Musenne nabeta si7onna ixiko, hari attoshin hayqope issi asi dendi odikoka ammanokona’ yaagis.”<verse eid="LUK 16:31" /></para>
  <chapter eid="LUK 16" />
  <chapter number="17" style="c" sid="LUK 17" />
  <para style="s1">Asas Dhube Gidopa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 17:1" />Yesuusi ba tamaaretako, “Ase dhubethidi nagaran gelsiyabay yoonna aggenna. Gidoshin, nagaran gelana mela oothiya ura ayye!” yaagis. <verse eid="LUK 17:1" /><verse number="2" style="v" sid="LUK 17:2" />He uray kaalotape issuwa balethanaape woxa ba qoodhen qachidi abban wulliko iyaw lo77o. <verse eid="LUK 17:2" /><verse number="3" style="v" sid="LUK 17:3" />Hessa gisho naagetite.<note caller="-" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="MAT 18:15">Maato 18:15</ref>.</char></note></para>
  <para style="p" vid="LUK 17:3">“Ne ishay nagara oothiko hanqeta; qiirotidi maarotethan simmiko, iyaw atto yaaga. <verse eid="LUK 17:3" /><verse number="4" style="v" sid="LUK 17:4" />Issi gallasan laapun toho qohidi, laapun toho, ‘Taani ta nagaraa eras tana maara’ yaagidi neeko yiiko iyaw atto ga.”<verse eid="LUK 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 17:5" />Hawaareti Godaako, “Ammano nuus gujarki” yaagidosona.<verse eid="LUK 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 17:6" />Goday, “Gaashe ayfe mela ammanoy hintew de7iko ‘Haysa wolaa shodetada abba giddon toketa’ yaagiko hintew kiitetana” yaagis.<verse eid="LUK 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 17:7" />Gujidika Yesuusi, “Hinte giddofe issuwas goshshanchoy woyko dorse heemmiya aylley de7iko ooso gadepe woyko wudepe soo simmiya wode, ‘Elle haayada kathi maanaw utta’ yaagey de7ii? <verse eid="LUK 17:7" /><verse number="8" style="v" sid="LUK 17:8" />Deenna, ‘Taw kaho giigisa; taani mada, uyada aggana gakanaw eqada muza. Hessafe guye, neeni qassi maasanne uyaasa’ yaageneyee? <verse eid="LUK 17:8" /><verse number="9" style="v" sid="LUK 17:9" />Hiza, goday, aylley kiita polida gisho anjiyee? <verse eid="LUK 17:9" /><verse number="10" style="v" sid="LUK 17:10" />Hessa gisho, hinteka kiitetoysa ubbaa polida wode, ‘Nu pathonna aylleta; oothanaw bessiya oosuwa polida’ yaagite” yaagis.<verse eid="LUK 17:10" /></para>
  <para style="s1">Baro Hargefe Geeyda Tammu Asata</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 17:11" />Yesuusi Yerusalaame bishe Samaarisinne Galilas giddora kanthidi aadhis. <verse eid="LUK 17:11" /><verse number="12" style="v" sid="LUK 17:12" />Issi gutaa geliya wode baro hargen oyketida tammu asati iya demmidosona. Entika haahon eqidi, <verse eid="LUK 17:12" /><verse number="13" style="v" sid="LUK 17:13" />“Godaa Yesuusa, nuus qadhetarki” yaagidi waassidosona.<verse eid="LUK 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 17:14" />I enta be7ida wode, “Bidi hintenatethaa Ayhude kahine bessite” yaagis. Enti ogiya bolla bishe paxidosona.<note caller="-" style="x"><char style="xo" closed="false">17:14 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Leewe 14:1-32</ref>.</char></note><verse eid="LUK 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 17:15" />Entafe issoy ba paxuwa be7ida wode dhoqu gida qaalan Xoossa bonchishe Yesuusako simmis. <verse eid="LUK 17:15" /><verse number="16" style="v" sid="LUK 17:16" />I, Samaare biitta asi, shin Yesuusa toho bolla gufannidi iya galatis.<verse eid="LUK 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 17:17" />Yesuusi, “Paxiday tammu asata gidokonaayee? Yaatin, uddufunati aw bidonaa? <verse eid="LUK 17:17" /><verse number="18" style="v" sid="LUK 17:18" />Ha allaga uraape<note caller="+" style="f"><char style="fr" closed="false">17:18 </char><char style="fqa" closed="false">Ha allaga uraape: </char><char style="ft" closed="false">Baro hargiyafe paxida uray allaga geetetiday I Ayhude gidonna gishosa.</char></note> attishin, hari simmidi Xoossa galatey deenna guusseyee?” yaagidi oychis. <verse eid="LUK 17:18" /><verse number="19" style="v" sid="LUK 17:19" />Uraako, “Ne ammanoy nena pathis; dendada ba” yaagis.<verse eid="LUK 17:19" /></para>
  <para style="s1">Xoossa Kawotetha Yuussaa</para>
  <para style="r">(<ref loc="MAT 24:23-28">Maato 24:23-28</ref>, <ref loc="MAT 24:37-41">37-41</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 17:20" />Farsaaweti, “Xoossa kawotethay awude yaanee?” gidi Yesuusa oychidosona. I, “Xoossaa kawotethay bentiya mallan yeenna. <verse eid="LUK 17:20" /><verse number="21" style="v" sid="LUK 17:21" />Qassika iya, ‘Hannina woyko hinina yaaganaw danda7enna. Ayis giiko, Xoossa kawotethay hinte giddon de7ees’ ” yaagidi zaaris.<verse eid="LUK 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 17:22" />Yesuusi ba tamaaretako, “Asa Na7a gallasatape issuwa be7anaw hinte amotiya wodey yaana, shin hinte be7eketa. <verse eid="LUK 17:22" /><verse number="23" style="v" sid="LUK 17:23" />Asay, ‘I yan de7ees’ woyko, ‘Haysan de7ees’ yaagana, shin entana kaallidi boopite. <verse eid="LUK 17:23" /><verse number="24" style="v" sid="LUK 17:24" />Wol7anthi wol7amidi salo gaxape gaxa poo7isiya mela Asa Na7aa yuussaa gallasay hessada hanana. <verse eid="LUK 17:24" /><verse number="25" style="v" sid="LUK 17:25" />Shin hessi hananaape sinthe Asa Na7ay daro waayanawunne ha yeletethan ixetanaw bessees. <verse eid="LUK 17:25" /><verse number="26" style="v" sid="LUK 17:26" />Nohe wode hanidaysa mela Asa Na7a woden hessada hanana.<note caller="-" style="x"><char style="xo" closed="false">17:26 </char><char style="xt" closed="false"><ref loc="GEN 6:5-8">Medhe 6:5-8</ref>.</char></note> <verse eid="LUK 17:26" /><verse number="27" style="v" sid="LUK 17:27" />Nohey Markabiyan gelida qamma gakanaw asay mishenne uyishe, ekishenne gelishe de7ishin dhayo haathay yidi ubbaa dhaysis.<note caller="-" style="x"><char style="xo" closed="false">17:27 </char><char style="xt" closed="false"><ref loc="GEN 7:6-24">Medhe 7:6-24</ref>.</char></note> <verse eid="LUK 17:27" /><verse number="28" style="v" sid="LUK 17:28" />Looxe laythanka hessatho hanis. Asay mishenne uyishe, shammishenne bayzishe, tokishenne keexishe, gam7idosona.<note caller="-" style="x"><char style="xo" closed="false">17:28 </char><char style="xt" closed="false"><ref loc="GEN 18:20-19:25">Medhe 18:20—19:25</ref>.</char></note> <verse eid="LUK 17:28" /><verse number="29" style="v" sid="LUK 17:29" />Looxey Soodomepe keyida gallas diinne geetetiya xuuggiyabay salope bukidi ubbaa dhaysis. <verse eid="LUK 17:29" /><verse number="30" style="v" sid="LUK 17:30" />Asa Na7ay qonciya wodeka hessada hanana.<verse eid="LUK 17:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 17:31" />“He gallasan karen de7iya oonika keetha giddon de7iyaba ekanaw soo gelopo. Hessadaka, gaden de7iya asi aykoska soo simmofo.<note caller="-" style="x"><char style="xo" closed="false">17:31 </char><char style="xt" closed="false"><ref loc="MAT 24:17-18">Maato 24:17-18</ref>; <ref loc="MRK 13:15-16">Mar 13:15-16</ref>.</char></note> <verse eid="LUK 17:31" /><verse number="32" style="v" sid="LUK 17:32" />Looxe machiw akeekite;<note caller="-" style="x"><char style="xo" closed="false">17:32 </char><char style="xt" closed="false"><ref loc="GEN 19:26">Medhe 19:26</ref>.</char></note> <verse eid="LUK 17:32" /><verse number="33" style="v" sid="LUK 17:33" />ba shempiw ashshanaw koyiya asi oonika dhaysana; ba shempiw aathidi immiya oonika I ashshana.<note caller="-" style="x"><char style="xo" closed="false">17:33 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Maato 10:39</ref>; <ref loc="MAT 16:25">16:25</ref>; <ref loc="MRK 8:35">Mar 8:35</ref>; <ref loc="LUK 9:24">Luqa 9:24</ref>; <ref loc="JHN 12:25">Yoha 12:25</ref>.</char></note> <verse eid="LUK 17:33" /><verse number="34" style="v" sid="LUK 17:34" />Ta hintew odayis; he gallasan nam7u asati issi arsan zin7ana; issoy eketana, hankoy attana. <verse eid="LUK 17:34" /><verse number="35" style="v" sid="LUK 17:35" />Nam7u maccasati wolla gaaccishin iissiya eketana, hankiya attana. <verse eid="LUK 17:35" /><verse number="36" style="v" sid="LUK 17:36" />Nam7u asati wolla gaden goyeysatape issoy eketana, hankoy attana”<note caller="+" style="f"><char style="fr" closed="false">17:36: </char><char style="ft" closed="false">Issi issi maxaafatan paydo 36 deenna.</char></note> yaagis.<verse eid="LUK 17:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 17:37" />Enti, “Godaw aw eketanee?” yaagidi oychidosona.</para>
  <para style="p" vid="LUK 17:37">I, “Bawuti de7iya bessan ankoti shiiqoosona” yaagis.<verse eid="LUK 17:37" /></para>
  <chapter eid="LUK 17" />
  <chapter number="18" style="c" sid="LUK 18" />
  <para style="s1">Am7e Woosa Leemiso</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 18:1" />Yesuusi ba tamaareta azallonna ubba wode woossana mela tamaarsanaw koyidi yaagidi leemiso odis: <verse eid="LUK 18:1" /><verse number="2" style="v" sid="LUK 18:2" />“Issi kataman Xoossas yashetonna, asas yeellatonna issi daynni de7ees <verse eid="LUK 18:2" /><verse number="3" style="v" sid="LUK 18:3" />He kataman issi am7iya de7awusu. Iyaka, ‘Ta giddoninne ta morkiya giddon de7iya mootuwa pirda’ yaagada ubba wode he daynnaako simeretawusu. <verse eid="LUK 18:3" /><verse number="4" style="v" sid="LUK 18:4" />Daynnay guutha wodes I odaa si7onna ixis, shin guyepe ba wozanan, ‘Taani Xoossas yayyonna, asas yeellatonna ixikoka, <verse eid="LUK 18:4" /><verse number="5" style="v" sid="LUK 18:5" />ha am7iya tana waaysiya gisho iw pirdana; yaatonna ixiko ubba wode yada tana salethana’ ” yaagidi qopis.<verse eid="LUK 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 18:6" />Godayka, “Geella daynnay gidaysa si7ideta; <verse eid="LUK 18:6" /><verse number="7" style="v" sid="LUK 18:7" />Xoossay qammanne gallas iyako waassiya ba dooridaysatas pirdeneyee? Entana maaddanaw gam7iyee? <verse eid="LUK 18:7" /><verse number="8" style="v" sid="LUK 18:8" />Ta hintew odeysa si7ite, ellesidi pirdana. Gidoshin, Asa Na7i yaa wode sa7a bolla ammano demmandesha?” yaagis.<verse eid="LUK 18:8" /></para>
  <para style="s1">Farsaawiyanne Qaraxa Qanxisiya Ura</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 18:9" />Qassi zaaridi, Yesuusi, bantana xillo asada oothidi ceeqeteysatasinne harata kadheysatas haysada yaagidi leemiso odis: <verse eid="LUK 18:9" /><verse number="10" style="v" sid="LUK 18:10" />“Nam7u asati woossanaw Xoossa Keethi bidosona. Issoy Farsaawe hankoy qassi qaraxa qanxisiya asi. <verse eid="LUK 18:10" /><verse number="11" style="v" sid="LUK 18:11" />Farsaawey eqidi baw woossishe, ‘Xoossaw taani harata mela bonqancho, geellanne laymatiya asi, aadhada qassi ha qaraxa qanxisiya uraa mela gidonna gisho nena galatayis. <verse eid="LUK 18:11" /><verse number="12" style="v" sid="LUK 18:12" />Saamintafe nam7u toho xoomayis, ta demmiyaba ubbaafe asraata kessayis’ yaagis.<verse eid="LUK 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 18:13" />“Shin qaraxa qanxiseysi haahon eqidi hari attoshin salo dhoqu gidi xeellanawka yayyidi ba tiraa iccishe ‘Xoossaw, tana nagaranchuwa maararki’ gidi woossis.<note caller="-" style="x"><char style="xo" closed="false">18:13 </char><char style="xt" closed="false"><ref loc="MAT 23:12">Maato 23:12</ref>; <ref loc="LUK 14:11">Luqa 14:11</ref>.</char></note> <verse eid="LUK 18:13" /><verse number="14" style="v" sid="LUK 18:14" />Ta hintew odeysa si7ite; Farsaawiyape haysi qaraxa qanxiseysi Xoossaa sinthan xillo gididi ba soo simmis. Ayis giiko, bana dhoqu dhoqu oothiya asi kawuyana, bana kawushiya asi dhoqu dhoqu gaana” yaagis.<verse eid="LUK 18:14" /></para>
  <para style="s1">Yesuusanne Yooga Nayta</para>
  <para style="r">(<ref loc="MAT 19:13-30">Maato 19:13-30</ref>; <ref loc="MRK 10:13-31">Mar 10:13-31</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 18:15" />Yesuusi yooga nayta bolla ba kushiya wothidi anjana mela asay iyako ehoosona. Yesuusa tamaareti hessa be7idi “Ayis Yesuusako eheetii?” yaagidi kaccidosona. <verse eid="LUK 18:15" /><verse number="16" style="v" sid="LUK 18:16" />Shin Yesuusi nayta baako xeegidi, “Yooga nayti taako yaanaysa diggofite; yo giite. Ayis giiko, Xoossa kawotethay entada hanidaysatasa. <verse eid="LUK 18:16" /><verse number="17" style="v" sid="LUK 18:17" />Taani hintew tuma odayis; Xoossa kawotetha yooga naytatho ekonnay oonika yaa gelenna” yaagis.<verse eid="LUK 18:17" /></para>
  <para style="s1">Dure Ura Oysha</para>
  <para style="r">(<ref loc="MAT 19:16-30">Maato 19:16-30</ref>; <ref loc="MRK 10:17-31">Mar 10:17-31</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 18:18" />Ayhude halaqatape issoy, “Keeha astamaariyaw, merina de7o demmanaw ay ootho?” yaagidi oychis.<verse eid="LUK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 18:19" />Yesuusi iyako, “Ayis tana keehaw yaagada xeegay? Issi Xoossafe attishin, hari keehi baawa. <verse eid="LUK 18:19" /><verse number="20" style="v" sid="LUK 18:20" />Laammofa, wodhopa, kaysotopa, wordo markatofa, ne aawanne ne aayiw boncha” giya kiita eray gidi oychis.<note caller="-" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Kessa 20:12-16</ref>; <ref loc="DEU 5:16-20">Zaare 5:16-20</ref>.</char></note><verse eid="LUK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LUK 18:21" />Urayka, “Hessata ubbaa taani na7atethafe doomada naagashe gam7as” yaagis.<verse eid="LUK 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 18:22" />Yesuusi hessa si7ida wode, “Hiza, new issibay pacees; new de7iyaba ubbaa bayzada manqotas imma; salon nena shaloy naagees. Yaata simmada, tana kaalla” yaagis. <verse eid="LUK 18:22" /><verse number="23" style="v" sid="LUK 18:23" />Shin uray hessa si7ida wode iyaw daro shaloy de7iya gisho daro qiirotis.<verse eid="LUK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 18:24" />Yesuusi uraa be7idi, “Dure asas Xoossa kawotethi geloy waanidi un7andesha? <verse eid="LUK 18:24" /><verse number="25" style="v" sid="LUK 18:25" />Durey Xoossa kawotethi gelanaysafe gimaley narpe luhora kantheysi kawuyees” yaagis.<verse eid="LUK 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 18:26" />Hessa si7ida asay, “Hessa gidiko ooni attanee?” yaagidosona.<verse eid="LUK 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 18:27" />Yesuusi, “Asas danda7etonabay Xoossas danda7etees” yaagis.<verse eid="LUK 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 18:28" />Phexroosi, “Heko nuuni nubaa ubbaa aggidi nena kaallida” yaagis.<verse eid="LUK 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 18:29" />“Yesuusi tuma ta hintew odayis; Xoossaa kawotethaas gidi ba keethaa woyko ba machiw woyko ba ishata woyko ba aawanne ba aayiw woyko ba nayta aggiday; <verse eid="LUK 18:29" /><verse number="30" style="v" sid="LUK 18:30" />ha wodiyan dako daro, yaana alamen merina de7o ekonnay oonika baawa” yaagis.<verse eid="LUK 18:30" /></para>
  <para style="s1">Yesuusi Ba Hayquwaba Heedzantho Odis</para>
  <para style="r">(<ref loc="MAT 20:17-19">Maato 20:17-19</ref>; <ref loc="MRK 10:32-34">Mar 10:32-34</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 18:31" />Yesuusi tammanne nam7ata baako xeegidi, “Ane Yerusalaame boos, nabeti Asa Na7aba xaafidaba ubbay yan poletana. <verse eid="LUK 18:31" /><verse number="32" style="v" sid="LUK 18:32" />I Ayhude gidonna asaas aadhidi imetana. Enti iya toochana, cayananne iya bolla cuttana. <verse eid="LUK 18:32" /><verse number="33" style="v" sid="LUK 18:33" />Iya garaafidaape guye, wodhana, shin heedzantho gallasan I hayqope dendana” yaagis.<verse eid="LUK 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 18:34" />Shin iya tamaareti he ubbaafe issibaaka akeekibokona. Iya xuuray entaw qosetida gisho I woygidaako eribookona.<verse eid="LUK 18:34" /></para>
  <para style="s1">Qooqey Xeellis</para>
  <para style="r">(<ref loc="MAT 20:29-34">Maato 20:29-34</ref>; <ref loc="MRK 10:46-52">Mar 10:46-52</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 18:35" />Yesuusi Iyaarko matiya wode issi qooqe uray oge gaxan uttidi woossees. <verse eid="LUK 18:35" /><verse number="36" style="v" sid="LUK 18:36" />Qooqe uray asay he bessaara aadhishin si7idi, “I aybee?” gidi oychis. <verse eid="LUK 18:36" /><verse number="37" style="v" sid="LUK 18:37" />Enti, “Naazirete Yesuusi haysara aadhees” yaagidosona.<verse eid="LUK 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 18:38" />I, “Dawita na7aw, Yesuusa, tana maararki” yaagidi waassis.<verse eid="LUK 18:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 18:39" />Sinthe sinthe biya asati, “Si7i ga” gidi hanqetidosona. Shin I, “Dawita na7aw, tana maara” yaagidi darsidi waassis.<verse eid="LUK 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 18:40" />Yesuusi eqidi uraa baako ehana mela kiittis. Urayka, iyako shiiqin, <verse eid="LUK 18:40" /><verse number="41" style="v" sid="LUK 18:41" />“Ta new ay oothana mela koyay?” yaagidi oychis.</para>
  <para style="p" vid="LUK 18:41">Qooqey, “Godaw ta xeellanaw koyayis” yaagis.<verse eid="LUK 18:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 18:42" />Yesuusi, “Xeella, ne ammanoy nena pathis” yaagis. <verse eid="LUK 18:42" /><verse number="43" style="v" sid="LUK 18:43" />Uray ellesidi xeelli aggis. Xoossaa bonchishe Yesuusa kaallis. Asa ubbay hessa be7idi Xoosse galatidosona.<verse eid="LUK 18:43" /></para>
  <chapter eid="LUK 18" />
  <chapter number="19" style="c" sid="LUK 19" />
  <para style="s1">Qaraxa Qanxisiya Zakiyoosa</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 19:1" />Yesuusi Iyaarko gelidi aadhees. <verse eid="LUK 19:1" /><verse number="2" style="v" sid="LUK 19:2" />Yan Zakiyoosa geetetiya qaraxa qanxiseyisata halaqay de7ees. I daro dure. <verse eid="LUK 19:2" /><verse number="3" style="v" sid="LUK 19:3" />I Yesuusi ooneko be7anaw koyis. I qanthi gidiya gisho asaa darotethaafe dendoysan Yesuusa be7anaw danda7ibeenna. <verse eid="LUK 19:3" /><verse number="4" style="v" sid="LUK 19:4" />Yesuusa be7anaw koyidi I biya ogiyas sinthe woxi bidi issi boobba mitha bolla keyis.<verse eid="LUK 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 19:5" />Yesuusi he bessaa gakishe dhoqu gidi be7idi, “Zakiyoosa, hachi ta ne son pee7anaw bessiya gisho elle wodha” yaagis. <verse eid="LUK 19:5" /><verse number="6" style="v" sid="LUK 19:6" />I ellesi wodhidi ufaysan Yesuusa mokis.<verse eid="LUK 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 19:7" />He bessan de7iya asaa ubbay hessa be7idi, “Nagaranchuwa soo gelidi moketaniw hanees” yaagidi zuuzumidosona. <verse eid="LUK 19:7" /><verse number="8" style="v" sid="LUK 19:8" />Gidoshin, Zakiyoosi eqidi Godaako, “Godaw, Heko taw de7iya shalo ubbaafe baggaa manqotas immana. Asape aybaka wordon balethada ekidaba gidiko oyddu kushe zaarana” yaagis.<verse eid="LUK 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 19:9" />Yesuusi qassi, “Ha uray Abrahaame na7a gidida gisho hachi atotethay ha soo yis. <verse eid="LUK 19:9" /><verse number="10" style="v" sid="LUK 19:10" />Asa Na7ay yiday dhayidaysa koyanaasanne ashshanaasa” yaagis.<note caller="-" style="x"><char style="xo" closed="false">19:10 </char><char style="xt" closed="false"><ref loc="MAT 18:10">Maato 18:10</ref>.</char></note><verse eid="LUK 19:10" /></para>
  <para style="s1">Tammu Minaane Leemiso</para>
  <para style="r">(<ref loc="MAT 25:14-30">Maato 25:14-30</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="LUK 19:11" />Asay hessa si7iya wode, Yesuusi Yerusalaame matatida gishonne Xoossaa kawotethay ha77i matara qoncana daanida gisho entaw leemiso odis.<note caller="-" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">Maato 25:14-30</ref>.</char></note> <verse eid="LUK 19:11" /><verse number="12" style="v" sid="LUK 19:12" />Hessa gisho, Yesuusi, “Issi gita asi de7eysi baw kawotethi ekidi yaanaw hara biitta bis. <verse eid="LUK 19:12" /><verse number="13" style="v" sid="LUK 19:13" />Iyaw oothiya aylletape tammata xeegidi issuwas issuwas tammu minaane<note caller="+" style="f"><char style="fr" closed="false">19:13 </char><char style="fk" closed="false">Minaane: </char><char style="ft" closed="false">Minaaney Girike doona. Issi minaaney issi gallasa oosanchos heedzu ageena damooze gidees.</char></note> immidi ‘Ta simmada yaana gakanaw ha miishiyara zal7ite’ yaagis.<verse eid="LUK 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 19:14" />“He biitta asay iya ixiya gisho, ha uray nu bolla kawotana mela nu koyoko yaagidi ase iya guyera kiittidosona.<verse eid="LUK 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LUK 19:15" />“Gidoshin, he uray kawo gididi ba biitta simmis. He tammu aylleti I immida miishiyan ay mela zal7idi wodhisidaako eranaw koyidi entana xeegisis.<verse eid="LUK 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LUK 19:16" />“Koyroysi yidi, ‘Godaw, ne taw immida miishey haraa tamma wodhis’ yaagis.<verse eid="LUK 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 19:17" />“Iya Goday, ‘Neno ammanetida aylliyaw lo77o oothadasa. Neeni guuthaban ammanetida gisho new tammu katamata bolla maata immas’ yaagis.<verse eid="LUK 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 19:18" />“Nam7anthoy yidi, ‘Godaw, ne taw immida miishey haraa ichasha wodhis’ yaagis.<verse eid="LUK 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 19:19" />“Goday iyako, ‘Newuka qassi ichashu katamata bolla maata immas’ yaagis.<verse eid="LUK 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 19:20" />“Heko heedzanthoy yidi, ‘Godaw, ta curqan xaaxada naagida ne miishiya hannashu. <verse eid="LUK 19:20" /><verse number="21" style="v" sid="LUK 19:21" />Ayis giiko, neeni nebaa gidonnaba ekeysanne ne zeronnaba cakiya iita asi gidiya gisho new yayyas’ yaagis.<verse eid="LUK 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LUK 19:22" />“Iya goday zaaridi, ‘Neno iita aylliyaw ne doonatho ta nena pirdana. Ta wothonnaba ekeysanne zeronnaba cakiya asi gideysa ne eriko, <verse eid="LUK 19:22" /><verse number="23" style="v" sid="LUK 19:23" />ta yada ta miishiya wodhera ekana mela zal7iya asaas ayis immabikii?’<verse eid="LUK 19:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 19:24" />“Iya goday he bessan eqidaysatako, ‘Iyara de7iya miishiya ekidi tamma wodhisidaysas immite’ yaagis.<verse eid="LUK 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 19:25" />“Enti, ‘Godaw, iyaw kaseka tammu minaaney de7ees’ yaagidosona.<verse eid="LUK 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 19:26" />“Goday, ta hintew odayis; ‘De7iya ubbaas hari guzhetana, shin baynaysafe haray atto iyaw de7iyaraka eketana.<note caller="-" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Maato 13:12</ref>; <ref loc="MRK 4:25">Mar 4:25</ref>; <ref loc="LUK 8:18">Luqa 8:18</ref>.</char></note> <verse eid="LUK 19:26" /><verse number="27" style="v" sid="LUK 19:27" />Gidoshin, ta enta bolla kawotonna mela koydaysata he ta morketa ha ta sinthe ehidi gora7ite’ gis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">19:27 </char><char style="xt" closed="false"><ref loc="MAT 25:14-30">Maato 25:14-30</ref>.</char></note><verse eid="LUK 19:27" /></para>
  <para style="s1">Gita Bonchon Yerusalaame Geluwa</para>
  <para style="r">(<ref loc="MAT 21:1-11">Maato 21:1-11</ref>; <ref loc="MRK 11:1-11">Mar 11:1-11</ref>; <ref loc="JHN 12:12-19">Yoha 12:12-19</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 19:28" />Yesuusi hessa odidaape guye, entafe sinthe hemetidi Yerusalaame bis. <verse eid="LUK 19:28" /><verse number="29" style="v" sid="LUK 19:29" />Shamaho zuma<note caller="+" style="f"><char style="fr" closed="false">19:29 </char><char style="fqa" closed="false">Shamaho zuma: </char><char style="ft" closed="false">Shamahoy daro doliya zuma guussu.</char></note> bolla de7iya Beetefaagenne Bitaane matida wode ba tamaaretape nam7ata kiittidi, <verse eid="LUK 19:29" /><verse number="30" style="v" sid="LUK 19:30" />“Hinte sinthan de7iya gutaa biite, hinte yaa gakiya wode oonika toggonna qashetidi de7iya hare mari demmana. Iya billidi haa eki yiite. <verse eid="LUK 19:30" /><verse number="31" style="v" sid="LUK 19:31" />Oonika, ‘Ayis billeetii?’ gidi oychiko, ‘Goday iya koyees’ yaagite” yaagis.<verse eid="LUK 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 19:32" />Kiitetidaysati bidi I gidaysada hanin be7idosona. <verse eid="LUK 19:32" /><verse number="33" style="v" sid="LUK 19:33" />Enti hare maraa billishin godati be7idi, “Hare maraa ayis billeetii?” yaagidosona.<verse eid="LUK 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 19:34" />Enti zaaridi, “Goday iya koyees” yaagidosona.<verse eid="LUK 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 19:35" />Yaape hare maraa Yesuusako ehidosona. Banta ma7uwa hare maraa zokon yeggidi Yesuusa hare maraa bolla utisidosona. <verse eid="LUK 19:35" /><verse number="36" style="v" sid="LUK 19:36" />Asayka I biya ogiya bolla banta ma7uwa hiixidosona.<verse eid="LUK 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 19:37" />Shamaho zuma dugethe wodhisiya ogiyako matiya wode, taybon keehi daro asay enti be7ida malaalsiyaban ufaytidi banta qaala dhoqu oothidi,<verse eid="LUK 19:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="LUK 19:38" />“Godaa sunthan yaa kawoy anjetidaysa</para>
  <para style="q2" vid="LUK 19:38">saluwan saroy</para>
  <para style="q2" vid="LUK 19:38">ubbaafe dhoqa saluwan bonchoy</para>
  <para style="q2" vid="LUK 19:38">Xoossaas gido”</para>
  <para style="m" vid="LUK 19:38">yaagidi Xoossaa galatidosona.<note caller="-" style="x"><char style="xo" closed="false">19:38 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Maz 118:26</ref>.</char></note><verse eid="LUK 19:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 19:39" />Asaa giddofe issi issi Farsaaweti Yesuusako, “Astamaariyaw, ne tamaareta hayzite gada hanqeta” yaagidosona.<verse eid="LUK 19:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 19:40" />I entako, “Enti si77i giiko shuchati waassana” yaagis.<verse eid="LUK 19:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 19:41" />Yesuusi Yerusalaame matishe katamaa be7idi iyaw yeekis. <verse eid="LUK 19:41" /><verse number="42" style="v" sid="LUK 19:42" />“New saro gidanaysa hachi ne eridaba gidiyakoshin, ha77i ne ayfiyape geemmis. <verse eid="LUK 19:42" /><verse number="43" style="v" sid="LUK 19:43" />Ne morketi ne yuushuwa diridi dumma dumma ogiyara nena teqidi un7ethiya wodey yaana. <verse eid="LUK 19:43" /><verse number="44" style="v" sid="LUK 19:44" />Nenanne ne dirsaa garsan de7iya ne nayta dhaysana. Issi issi shuchu denthidi laallana, ayis giiko Xoossay nena ashshanaw yaa wodiya erabaaka” yaagidi iw yeekis.<verse eid="LUK 19:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 19:45" />Hessafe guye, Yesuusi Xoossa Keethi gelidi zal7eyisata yaape goodis. <verse eid="LUK 19:45" /><verse number="46" style="v" sid="LUK 19:46" />Qassi, “ ‘Ta keethay Xoossaa woossiya keethi gidana’ gidi xaafetis, shin hinte ta keethaa pangata gongolo oothideta” yaagis.<note caller="-" style="x"><char style="xo" closed="false">19:46 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa 56:7</ref>; <ref loc="JER 7:11">Ermi 7:11</ref>.</char></note><verse eid="LUK 19:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 19:47" />Gallas gallas xoossa keethan tamaarsees. Kahineta halaqati, higge astamaaretinne deriya cimati iya wodhanaw oge koyoosona.<note caller="-" style="x"><char style="xo" closed="false">19:47 </char><char style="xt" closed="false"><ref loc="LUK 21:37">Luqa 21:37</ref>.</char></note> <verse eid="LUK 19:47" /><verse number="48" style="v" sid="LUK 19:48" />Gidoshin, asa ubbay iya timirtiya banta wozana yeggidi si7iya gisho, entaw oothanabay dhayis.<verse eid="LUK 19:48" /></para>
  <chapter eid="LUK 19" />
  <chapter number="20" style="c" sid="LUK 20" />
  <para style="s1">Yesuusa Maatay Oyshetetha</para>
  <para style="r">(<ref loc="MAT 21:23-27">Maato 21:23-27</ref>; <ref loc="MRK 11:27-33">Mar 11:27-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 20:1" />Issi gallas Yesuusi xoossa keethan asaa tamaarsishininne Wongela markatishin, kahine halaqati, higge astamaaretinne deriya cimati issife iyako yidi, <verse eid="LUK 20:1" /><verse number="2" style="v" sid="LUK 20:2" />“Neeni haysata aybi maatan oothiyako nuus oda. Ha maata new immiday oonee?” yaagidi oychidosona.<verse eid="LUK 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 20:3" />I entako, “Taka hintena issiba oychana, ane taw zaarite. <verse eid="LUK 20:3" /><verse number="4" style="v" sid="LUK 20:4" />Xammaqiya Yohaanisa xinqatey Xoossafeye asapee?” yaagis.<verse eid="LUK 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 20:5" />Enti woli giddon yaagidi zoretidosona: “Xoossafe giiko yaatin, ayis ammanibeketii?” yaagana.<verse eid="LUK 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 20:6" />“Asape giiko, asa ubbay Yohaanisi nabe gideysa ammaniya gisho nuna shuchan caddana.”<verse eid="LUK 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 20:7" />Yaaniya gisho, “Awupeko nu eroko” yaagidi zaaridosona.<verse eid="LUK 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 20:8" />Yesuusi zaaridi, “Hiza, taka ay maatan haysata oothiyako hintew odike” yaagis.<verse eid="LUK 20:8" /></para>
  <para style="s1">Goshshanchota Leemiso</para>
  <para style="r">(<ref loc="MAT 21:33-46">Maato 21:33-46</ref>; <ref loc="MRK 12:1-12">Mar 12:1-12</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 20:9" />Hessafe guye, Yesuusi yaagidi ha leemisuwa asaas odis: “Issi asi woyne tokis. Goshshanchotas kera immidi daro wode gam7idi yaanaw hara biitta bis.<note caller="-" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="ISA 5:1">Isa 5:1</ref>.</char></note> <verse eid="LUK 20:9" /><verse number="10" style="v" sid="LUK 20:10" />Woyne ayfiya maxiya wodey gakin woyne ayfiyape iyaw yeddana mela goshshanchotako ba aylliya kiittis. Shin goshshanchoti he aylliya oykidi wadhidi mela kushe yeddidosona. <verse eid="LUK 20:10" /><verse number="11" style="v" sid="LUK 20:11" />Kaallidika hara aylliya kiittis. Qassi goshshanchoti iya wadhidi, kawushidi mela kushe yeddidosona. <verse eid="LUK 20:11" /><verse number="12" style="v" sid="LUK 20:12" />Ha77ika zaaridi heedzantho aylliya kiittis. Goshshanchoti iyaka madunxisidi woyne gadiya giddofe gaxa kessidi yeggidosona.<verse eid="LUK 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 20:13" />“Woyne gadiya goday, ‘Yaatin ta ay ootho? Ane qassi ta dosiya ta na7a yeddana; ooni eri enti iya bonchona aggokona’ yaagis.<verse eid="LUK 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 20:14" />“Shin goshshanchoti uraa na7a be7ida wode, ‘Haysi iya laattanaysa, haa yiite iya wodhana, yaatiko laatay nuus gidana’ yaagidi zoretidosona. <verse eid="LUK 20:14" /><verse number="15" style="v" sid="LUK 20:15" />Woyne gadiya giddofe gaxa kessidi wodhidosona. Yaatin, woyne gadiya goday he asata waatanee? <verse eid="LUK 20:15" /><verse number="16" style="v" sid="LUK 20:16" />Yidi he goshshanchota dhaysana, woyne gadiya hara asatas immana. Asay hessa si7ida wode ‘Shinchalle hessa melaba gathofo’ yaagidosona.<verse eid="LUK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 20:17" />“Yesuusi enta caddi xeellidi,</para>
  <para style="q1" vid="LUK 20:17">“ ‘Yaatin, gimbe keexiya asati borida shuchay,</para>
  <para style="q2" vid="LUK 20:17">keethaas malanne minotethi immiya ubbaafe aadhiya shuchi gidis’</para>
  <para style="m" vid="LUK 20:17">geetetidi xaafetidaysa birshethay aybee?<note caller="-" style="x"><char style="xo" closed="false">20:17 </char><char style="xt" closed="false"><ref loc="PSA 118:22">Maz 118:22</ref>.</char></note> <verse eid="LUK 20:17" /><verse number="18" style="v" sid="LUK 20:18" />He shuchaa bolla kundiya ubbay qoxettana, shuchay iya bolla wodhiya ubbay liiqana” yaagis.<verse eid="LUK 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 20:19" />Higge astamaaretinne kahine halaqati ha leemisoy odetiday enta bolla gideysa eridi he wode iya oykanaw koydosona, shin asaas babidosona.<verse eid="LUK 20:19" /></para>
  <para style="s1">Giiraba</para>
  <para style="r">(<ref loc="MAT 22:15-22">Maato 22:15-22</ref>; <ref loc="MRK 12:13-17">Mar 12:13-17</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 20:20" />Hessa gisho, Yesuusa deriya haariya Roome kawa maatas aathidi immanaw koyidi iya doonape bala qaala naagoosona. Hessa polisanaw xillo daanidi cimmiya asata iyako kiittidosona. <verse eid="LUK 20:20" /><verse number="21" style="v" sid="LUK 20:21" />Kiitetidi bida asati, “Astamaariyaw, neeni odeysinne tamaarseysi like gideysa, qassi Xoossaa ogiya tumatethan tamaarseysanne oonaka shaakonnaysa nu eroos. <verse eid="LUK 20:21" /><verse number="22" style="v" sid="LUK 20:22" />Hanoshin, Roome kawas giira giiranaw bessi bessennee?” yaagidi iya oychidosona.<verse eid="LUK 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 20:23" />Shin I enta wozanaa iitatetha erida gisho, <verse eid="LUK 20:23" /><verse number="24" style="v" sid="LUK 20:24" />“Ane tana issi santime bessite, Iya bolla de7iya misileynne sunthay oodebayee?” yaagis.</para>
  <para style="p" vid="LUK 20:24">Enti zaaridi, “Roome Kawa Qeesareysa” yaagidosona.<verse eid="LUK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 20:25" />I zaaridi, “Yaatiko, Qeesareba Qeesares, Xoossaba Xoossaas immite” yaagis.<verse eid="LUK 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 20:26" />Hessa gisho, I zaarida zaaruwan asaa sinthan bala demmanaw danda7ibookona. Iya zaaruwan malaaletidi si77i gidoosona.<verse eid="LUK 20:26" /></para>
  <para style="s1">Hayqope Dendoba</para>
  <para style="r">(<ref loc="MAT 22:23-33">Maato 22:23-33</ref>; <ref loc="MRK 12:18-27">Mar 12:18-27</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="LUK 20:27" />Hayqope dendoy baawa giya Saduqaawetape issoti issoti Yesuusako yidi,<note caller="-" style="x"><char style="xo" closed="false">20:27 </char><char style="xt" closed="false"><ref loc="ACT 23:8">Hawa 23:8</ref>.</char></note> <verse eid="LUK 20:27" /><verse number="28" style="v" sid="LUK 20:28" />“Astamaariyaw, issi asi macho ekidi na7a yelonna hayqiko, iya ishay he maccasiw ekidi nayta yelidi ba ishaas koche ashshana mela Musey xaafis.<note caller="-" style="x"><char style="xo" closed="false">20:28 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Zaare 25:5</ref>.</char></note> <verse eid="LUK 20:28" /><verse number="29" style="v" sid="LUK 20:29" />Heko laapun ishati de7oosona. Koyroysi macho ekidi na7a yelonna hayqis. <verse eid="LUK 20:29" /><verse number="30" style="v" sid="LUK 20:30" />Nam7anthoy iyo ekidi na7a yelonna hayqis. <verse eid="LUK 20:30" /><verse number="31" style="v" sid="LUK 20:31" />Heedzanthoyka hessatho hanis. Laapunati ubbay hessada hanidi iyo ekidosona, shin na7a yelonna hayqidosona. <verse eid="LUK 20:31" /><verse number="32" style="v" sid="LUK 20:32" />Wursethan maccasiya hayqasu. <verse eid="LUK 20:32" /><verse number="33" style="v" sid="LUK 20:33" />Hiza, laapun addey iyo ekida gisho hayqope dendiya wode iya oodde macho gidanee?” yaagidi oychidosona.<verse eid="LUK 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 20:34" />Yesuusi zaaridi, “Asay ha wodiyan ekoosonanne geloosona. <verse eid="LUK 20:34" /><verse number="35" style="v" sid="LUK 20:35" />Shin hayqope dendidi yaana alamiyan daanaw besseysati ekokonanne gelokona. <verse eid="LUK 20:35" /><verse number="36" style="v" sid="LUK 20:36" />Enti kiitancho mela gidiya gisho sinthafe hayqokona. Hayqope dendida gisho enti Xoossaa nayta. <verse eid="LUK 20:36" /><verse number="37" style="v" sid="LUK 20:37" />Musey Godaa, ‘Abrahaame Godaa, Yisaaqa Godaa, Yayqooba Godaa’ gidi tushiya giddon xuugetiya tama taarikiya xaafidaysan hayqida asay dendeysa bessees.<note caller="-" style="x"><char style="xo" closed="false">20:37 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Kessa 3:6</ref>.</char></note> <verse eid="LUK 20:37" /><verse number="38" style="v" sid="LUK 20:38" />Ubbay iyaw de7on de7eyisata gidiya gisho I de7on de7eyisata Godaape attishin, hayqidaysata Godaa gidenna” yaagidi zaaris.<verse eid="LUK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 20:39" />Higge astamaaretape issoti issoti, “Astamaariyaw, lo77oba odadasa” yaagidosona. <verse eid="LUK 20:39" /><verse number="40" style="v" sid="LUK 20:40" />Hessafe guye, hara oysho oychanaw yayyidosona.<verse eid="LUK 20:40" /></para>
  <para style="s1">Kiristoosi Oodde Na7ee?</para>
  <para style="r">(<ref loc="MAT 22:41-46">Maato 22:41-46</ref>; <ref loc="MRK 12:35-37">Mar 12:35-37</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="LUK 20:41" />Iyape kaallidi Yesuusi entako, “Asay Kiristoosa waatidi Dawita na7a yaagona? <verse eid="LUK 20:41" /><verse number="42-43" style="v" sid="LUK 20:42-43" />Ayis giiko, Dawiti ba huuphen ba maxaafan,</para>
  <para style="q1" vid="LUK 20:42-43">“ ‘Xoossay ta Godaako “Ta ne morketa</para>
  <para style="q2" vid="LUK 20:42-43">ne tohoy yedhiyaso oothana gakanaw</para>
  <para style="q2" vid="LUK 20:42-43">taape ushacha baggan utta” gis’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">20:42-43 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz 110:1</ref>.</char></note><verse eid="LUK 20:42-43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 20:44" />“Hiza, Dawiti Kiristoosa, ‘Godaa gidi xeegishe iyaw na7a waanidi gidii?’ ” yaagis.<verse eid="LUK 20:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 20:45" />Derey ubbay si7ishin ba tamaaretako, <verse eid="LUK 20:45" /><verse number="46" style="v" sid="LUK 20:46" />“Adussa ma7o ma7idi yuushshe doseysatape, giyan boncho sarotho, ayhude woosa keethan boncho oyde, moketiya sonka boncho bessi koyiya higge astamaaretape naagetite. <verse eid="LUK 20:46" /><verse number="47" style="v" sid="LUK 20:47" />Enti am7eta keethaa kalloyoosona, xillo asi daanidi woosa adussosona. Hessati ubbaafe aadhiya iita pirda ekana” yaagis.<verse eid="LUK 20:47" /></para>
  <chapter eid="LUK 20" />
  <chapter number="21" style="c" sid="LUK 21" />
  <para style="s1">Am7e Muxaata</para>
  <para style="r">(<ref loc="MRK 12:41-44">Mar 12:41-44</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 21:1" />Dure asay xoossa keethan muxaata saaxiniyan yeggishin Yesuusi dhoqu gidi asaa be7is. <verse eid="LUK 21:1" /><verse number="2" style="v" sid="LUK 21:2" />Qassi issi manqo am7iya nam7u sikina yeggishin be7idi, <verse eid="LUK 21:2" /><verse number="3" style="v" sid="LUK 21:3" />“Ta hintew tuma odayis; ha manqo am7iya ubbaafe aathada immasu. <verse eid="LUK 21:3" /><verse number="4" style="v" sid="LUK 21:4" />Ayis giiko, ha asa ubbay bantaw de7iyabaape immidosona, shin iya ba pacaape, baw de7iya aquwa ubbaa immasu” yaagis.<verse eid="LUK 21:4" /></para>
  <para style="s1">Wode Wursetha Malaatata</para>
  <para style="r">(<ref loc="MAT 24:3-14">Maato 24:3-14</ref>; <ref loc="MRK 13:3-23">Mar 13:3-23</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="LUK 21:5" />Yesuusa tamaaretape issoti issoti Xoossa Keethay daro lo77iya shuchaninne asay Xoossaas immida imotan lo77idaysa odetoosona. <verse eid="LUK 21:5" /><verse number="6" style="v" sid="LUK 21:6" />Shin Yesuusi, “Ha hinte be7iyabay ubbay laaletonna, shuchi shucha bolla gimbetida mela attonna wodey yaana” yaagis.<verse eid="LUK 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 21:7" />Entika, “Astamaariyaw, ha ubbay hananay awudee? Qassi haysi hananaysas malaatay aybee?” yaagidi oychidosona.<verse eid="LUK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 21:8" />Yesuusi yaagidi entaw zaaro immis: “Baletonna mela naagetite. Daroti, ‘Taani Kiristoosa, wodey matatis’ yaagishe ta sunthan yaana, shin hinte enta kaallopite. <verse eid="LUK 21:8" /><verse number="9" style="v" sid="LUK 21:9" />Hinte olabaanne asaa geellatetha si7iya wode dagammofite. Hessi sinthatidi hananaysi attonnaba gidiya gisho wodiya wursethay ellesidi yeenna” yaagis.<verse eid="LUK 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LUK 21:10" />Kaallidika, “Derey deriya bolla, kawotethay kawotethaa bolla dendana. <verse eid="LUK 21:10" /><verse number="11" style="v" sid="LUK 21:11" />Gita biitta qaaxoy hanana, koshaynne gadoy dumma dumma bessan darana, yashshiyabaynne gita malaatati salope qoncana. <verse eid="LUK 21:11" /><verse number="12" style="v" sid="LUK 21:12" />Shin ha ubbay hananaape sinthe ta sunthaa gisho gidi asay hintena gooddananne oykana. Ayhude woosa keethaninne qasho keethan hintena yeggana. Kawota sinthenne deriya haareyisata sinthe hintena efana. <verse eid="LUK 21:12" /><verse number="13" style="v" sid="LUK 21:13" />Hessika tabaa hinte entaw markatanaw lo77o oge gidana. <verse eid="LUK 21:13" /><verse number="14" style="v" sid="LUK 21:14" />Hessa gisho, hinte oyshetiya wode woygidi zaaro immane gidi hinte wozanan un7etonna mela akeekite.<note caller="-" style="x"><char style="xo" closed="false">21:14 </char><char style="xt" closed="false"><ref loc="LUK 12:11-12">Luqa 12:11-12</ref>.</char></note> <verse eid="LUK 21:14" /><verse number="15" style="v" sid="LUK 21:15" />Ayis giiko, hinte morketi hintera eqetanawunne palamanaw danda7onna doonanne cincatethi ta hintew immana. <verse eid="LUK 21:15" /><verse number="16" style="v" sid="LUK 21:16" />Hari attoshin, hintena yelidaysati, hinte ishati, hinte dabbotinne laggeti hintena aathidi immana. Hinte giddofe issota issota wodhana. <verse eid="LUK 21:16" /><verse number="17" style="v" sid="LUK 21:17" />Ta sunthaa gisho asa ubbaa sinthan hinte ixetidaysata gidana. <verse eid="LUK 21:17" /><verse number="18" style="v" sid="LUK 21:18" />Shin hari attoshin, hinte binaanape issoyka dhayenna. <verse eid="LUK 21:18" /><verse number="19" style="v" sid="LUK 21:19" />Polo danda7an hinte, hinte shempuwa ashshana.”<verse eid="LUK 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 21:20" />“Yerusalaame katamay wotaadaren diretidi uttidashin hinte be7iko iyaw dhayoy matatidaysa erite. <verse eid="LUK 21:20" /><verse number="21" style="v" sid="LUK 21:21" />He wode Yihudan de7iya ubbay deriyako baqato, kataman de7eysati yaape keyo, gaxariyan de7eysati katama gelopo. <verse eid="LUK 21:21" /><verse number="22" style="v" sid="LUK 21:22" />Ayis giiko, ha xaafetidabay poletana mela hessi Xoossay kushe zaariya wode.<note caller="-" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="HOS 9:7">Hose 9:7</ref>.</char></note> <verse eid="LUK 21:22" /><verse number="23" style="v" sid="LUK 21:23" />Sa7a bolla gita metoy yaana, hessanka asaa bolla Xoossaa hanqoy yaana. Hessa gisho, qanthatidaysatanne dhantheyisata ayye! <verse eid="LUK 21:23" /><verse number="24" style="v" sid="LUK 21:24" />Enti mashshan hayqana, asa ubbay allaga biitta di7etana. Ayhude gidonna asaa wodey poletana gakanaw Yerusalaamey entanan yedhetidaysa gidana.<verse eid="LUK 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 21:25" />“Awan, ageenaninne, xoolintota bolla malaatati hanidi bentana. Abbaafenne zuliya deshuwape dendoysan biittan de7iya asay un7etananne yarkana.<note caller="-" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="EZK 32:7">Hiz 32:7</ref>; <ref loc="JER 2:31">Ermi 2:31</ref>; <ref loc="REV 6:12">Qon 6:12</ref>.</char></note> <verse eid="LUK 21:25" /><verse number="26" style="v" sid="LUK 21:26" />Saluwa wolqati buqettana gisho asay yashshaninne biitta bolla aybi hanandesha gidi naagon bantana baletana. <verse eid="LUK 21:26" /><verse number="27" style="v" sid="LUK 21:27" />He wode Asa Na7ay wolqaninne gita bonchuwan shaarara yishin enti be7ana.<note caller="-" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daane 7:13</ref>; <ref loc="REV 1:7">Qon 1:7</ref>.</char></note> <verse eid="LUK 21:27" /><verse number="28" style="v" sid="LUK 21:28" />Hinte atotethay matatida gisho ha hanoti poletethi oykiya wode giigeti eqite, hinte huuphiya dhoqu oothidi xeellite” yaagis.<verse eid="LUK 21:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LUK 21:29" />Kaallidika, haysada gidi leemiso odis; “Balase mithinne hara mithata ubbaa be7ite. <verse eid="LUK 21:29" /><verse number="30" style="v" sid="LUK 21:30" />Enti aaciya wode torchey matatidaysa hinte ereeta. <verse eid="LUK 21:30" /><verse number="31" style="v" sid="LUK 21:31" />Hessada ha hanoti poletishin hinte be7iko Xoossaa kawotethay matatidaysa erite.<verse eid="LUK 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 21:32" />“Ta hintew tuma odayis; ha ubbay poletana gakanaw ha yeletethay aadhenna. <verse eid="LUK 21:32" /><verse number="33" style="v" sid="LUK 21:33" />Saloynne sa7i aadhana, shin ta qaalay aadhenna.<verse eid="LUK 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 21:34" />“Hiza, dhassi bayna de7on, ushsha daroninne duussabaas un7etethan hinte wozanay oyketonna melanne he qammay akeekona xiheda hinte bolla gakonna mela naagetite. <verse eid="LUK 21:34" /><verse number="35" style="v" sid="LUK 21:35" />He qammay biitta kumethan de7iya ubbaa bolla gakana. <verse eid="LUK 21:35" /><verse number="36" style="v" sid="LUK 21:36" />Hessa gisho, yaa iitaape attanawunne Asa Na7a sinthan eqanaw danda7ana mela ubba wode minnidi woossite” yaagis.<verse eid="LUK 21:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 21:37" />Gallas gallas Yesuusi xoossa keethan tamaarsishe, qamma qamma Shamaho zuma bolla keyidi aqees.<note caller="-" style="x"><char style="xo" closed="false">21:37 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luqa 19:47</ref>.</char></note> <verse eid="LUK 21:37" /><verse number="38" style="v" sid="LUK 21:38" />Asa ubbay iya si7anaw wonta guura iyako Xoossaa Keethi yoosona.<verse eid="LUK 21:38" /></para>
  <chapter eid="LUK 21" />
  <chapter number="22" style="c" sid="LUK 22" />
  <para style="s1">Yihudi Yesuusa Aathidi Immanaw Maqetis</para>
  <para style="r">(<ref loc="MAT 26:1-5">Maato 26:1-5</ref>, <ref loc="MAT 26:14-16">14-16</ref>; <ref loc="MRK 14:1-2">Mar 14:1-2</ref>, <ref loc="MRK 14:10-11">10-11</ref>; <ref loc="JHN 11:45-53">Yoha 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 22:1" />He wode “Paasika” giya Uytha Ba7aaley matis.<note caller="-" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1">Kessa 12:1</ref>.</char></note> <verse eid="LUK 22:1" /><verse number="2" style="v" sid="LUK 22:2" />Kahine halaqatinne higge astamaareti ase yayiya gisho, waatidi Yesuusa banta giddofe dhaysaneko oge koyoosona. <verse eid="LUK 22:2" /><verse number="3" style="v" sid="LUK 22:3" />Xalahey tammanne nam7atape issuwa gidida Asqoroota Yihuda geeteteysa gido gelis. <verse eid="LUK 22:3" /><verse number="4" style="v" sid="LUK 22:4" />Yihudi kahine halaqatakonne Xoossa Keetha naageysata halaqatako bidi Yesuusa waati aathidi immaneko entara maqetis. <verse eid="LUK 22:4" /><verse number="5" style="v" sid="LUK 22:5" />Entika hessan ufaytidi miishe immanaw iyara zoretidosona. <verse eid="LUK 22:5" /><verse number="6" style="v" sid="LUK 22:6" />Ika zoretethan giigis. Aathi entaw immanaw asi bayna inje wode naagishe de7ees.<verse eid="LUK 22:6" /></para>
  <para style="s1">Wursetha Kaho</para>
  <para style="r">(<ref loc="MAT 26:17-25">Maato 26:17-25</ref>; <ref loc="MRK 14:12-21">Mar 14:12-21</ref>; <ref loc="JHN 13:21-30">Yoha 13:21-30</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="LUK 22:7" />Hessafe guye, Paasika dorsay shuketiya Uytha Ba7aaley gakis. <verse eid="LUK 22:7" /><verse number="8" style="v" sid="LUK 22:8" />Yesuusi, “Paasika kahuwa maana mela bidi nuus giigisite” yaagidi Phexroosanne Yohaanisa kiittis. <verse eid="LUK 22:8" /><verse number="9" style="v" sid="LUK 22:9" />Enti, “Nu awun giigisana mela ne koyay” yaagidi oychidosona. <verse eid="LUK 22:9" /><verse number="10" style="v" sid="LUK 22:10" />I entako, “Heko hinte katama gelishin haatha oto tookida addey hintera gahetana. I bidi geliya keethaa iya kaallidi gelite. <verse eid="LUK 22:10" /><verse number="11" style="v" sid="LUK 22:11" />Astamaarey godaako, ‘Ta ta tamaaretara wolla Paasika kahuwa maanaw imatha keethi awunee? yaagis’ giite. <verse eid="LUK 22:11" /><verse number="12" style="v" sid="LUK 22:12" />I pooqiya bolla hiixetidi giigidi de7iya dalga kifile hintena bessaana, yan giigisite” yaagis. <verse eid="LUK 22:12" /><verse number="13" style="v" sid="LUK 22:13" />Enti bidi Yesuusi gidaysada hanin demmidosona. Paasika ba7aale kahuwa yan giigisidosona.<verse eid="LUK 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LUK 22:14" />Saateyka gakida wode Yesuusi hawaaretara wolla kahuwa bolla uttis. <verse eid="LUK 22:14" /><verse number="15" style="v" sid="LUK 22:15" />I entako, “Ta waaye ekanaape sinthe ha kahuwa hintera maanaw daro amottas. <verse eid="LUK 22:15" /><verse number="16" style="v" sid="LUK 22:16" />Hiza, si7ite! Xoossaa kawotethan haysas birshethay poletana gakanaw ha kahuwa zaarada miike” yaagis. <verse eid="LUK 22:16" /><verse number="17" style="v" sid="LUK 22:17" />Ushshaa ekidi galati simmidi, “He7ite haysa hinte giddon shaaketite. <verse eid="LUK 22:17" /><verse number="18" style="v" sid="LUK 22:18" />Si7ite! Xoossaa kawotethay yaana gakanaw hachife doomada ha woyne ushshafe zaarada uyike” yaagis.<verse eid="LUK 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 22:19" />Uythaa ekidi, galati simmidi, “Haysi hintew imetiya ta ashuwa. Haysa oothishe tana qopite” yaagidi menthidi entaw immis.<verse eid="LUK 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 22:20" />Hessadaka, kahuwape guye, ushsha ekidi, “Ha ushshay hintew gukida ta suuthan gidiya ooratha caaquwa.<note caller="-" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="JER 31:31">Ermi 31:31</ref>.</char></note> <verse eid="LUK 22:20" /><verse number="21" style="v" sid="LUK 22:21" />Gidoshin, tana aathidi immana uraa kushey taara issife gaytaana.<note caller="-" style="x"><char style="xo" closed="false">22:21 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Maz 41:9</ref>.</char></note> <verse eid="LUK 22:21" /><verse number="22" style="v" sid="LUK 22:22" />Asa Na7ay iyaw geetetoysa mela hayqanaw de7ees, shin iya aathidi immiya uraa ayye!” yaagis. <verse eid="LUK 22:22" /><verse number="23" style="v" sid="LUK 22:23" />Enti banta giddon, “Haysa ooni oothanee” gidi woli oychidosona.<verse eid="LUK 22:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LUK 22:24" />Qassi enta giddon gita gidanay oone giya palami medhetis.<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="MAT 18:1">Maato 18:1</ref>; <ref loc="MRK 9:34">Mar 9:34</ref>; <ref loc="LUK 9:46">Luqa 9:46</ref>.</char></note> <verse eid="LUK 22:24" /><verse number="25" style="v" sid="LUK 22:25" />Yesuusi entako, “Deriya kawoti banta asaa wolqan haaroosona; banta deriya bolla godateysataska bantana, ‘Lo77o ootheyisata’ yaagidi xeegosona.<note caller="-" style="x"><char style="xo" closed="false">22:25 </char><char style="xt" closed="false"><ref loc="MAT 20:25-27">Maato 20:25-27</ref>; <ref loc="MRK 10:42-44">Mar 10:42-44</ref>.</char></note> <verse eid="LUK 22:25" /><verse number="26" style="v" sid="LUK 22:26" />Shin hinte giddon hessa mela gidopo. Hinte giddon bayratey kaaloda hano;<note caller="-" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">Maato 23:11</ref>; <ref loc="MRK 9:35">Mar 9:35</ref>.</char></note> kaaletheysi kaalleysada hano. <verse eid="LUK 22:26" /><verse number="27" style="v" sid="LUK 22:27" />Hanoshin, mokeysafenne Moketeysafe awusi aadhii? Moketeysa gidenneyee? Shin taani hinte giddon mokeysa mela.<note caller="-" style="x"><char style="xo" closed="false">22:27 </char><char style="xt" closed="false"><ref loc="REV 13:12">Qon 13:12</ref>.</char></note><verse eid="LUK 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 22:28" />“Hinteka ta metuwan taape shaaketonna taara minnidi eqidaysata. <verse eid="LUK 22:28" /><verse number="29-30" style="v" sid="LUK 22:29-30" />Hinte ta gaytape maana mela, uyana melanne araatata bolla uttidi tammanne nam7u Isra7eele sheeshata bolla pirdana mela ta aaway tana shuumidaysada taka hintena ta kawotethan shuumana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">22:29-30 </char><char style="xt" closed="false"><ref loc="MAT 19:28">Maato 19:28</ref>.</char></note><verse eid="LUK 22:29-30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LUK 22:31" />Kaallidika Yesuusi, “Simoona, Simoona, Xalahey hintena gisteda harqanaw woossis. <verse eid="LUK 22:31" /><verse number="32" style="v" sid="LUK 22:32" />Shin taani ne ammanoy dhayonna mela new gaannatas. Neka simmida wode ne ishata mintha” yaagis.<verse eid="LUK 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LUK 22:33" />Simooni, “Godaw, taani neera qashetanawunne hayqanaw giigetas” yaagis.<verse eid="LUK 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LUK 22:34" />Yesuusi Phexroosako, “Ta new odayis; hachi kuttoy waassanaape sinthe ne tana heedzu toho kaddana” yaagis. <verse eid="LUK 22:34" /><verse number="35" style="v" sid="LUK 22:35" />Kaallidika, Yesuusi entako, “Taani hintena korojoy, karxiitinne caammi baynna kiitida wode hintew pacidabay de7ii?” yaagidi oychis.<note caller="-" style="x"><char style="xo" closed="false">22:35 </char><char style="xt" closed="false"><ref loc="MAT 10:9-10">Maato 10:9-10</ref>; <ref loc="MRK 6:8-9">Mar 6:8-9</ref>; <ref loc="LUK 9:3">Luqa 9:3</ref>.</char></note></para>
  <para style="p" vid="LUK 22:35">Enti zaaridi, “Aykoyka pacibeenna” yaagidosona.<verse eid="LUK 22:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 22:36" />I entako, “Ha77i korojoynne karxiiti de7ey oyko; mashshi baynay ba afilaa bayzidi mashsha shammo. <verse eid="LUK 22:36" /><verse number="37" style="v" sid="LUK 22:37" />Haa si7ite! ‘Geellatara taybetis’ geetetidi xaafetidaysi tanan poletanaw bessees. Ee, ta gisho xaafetidabay poleteysi tumatis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="ISA 53:12">Isa 53:12</ref>.</char></note><verse eid="LUK 22:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 22:38" />Iya tamaareti, “Godaw haysan nam7u mashshati de7oosona” yaagidosona.</para>
  <para style="p" vid="LUK 22:38">I, “Gidana” yaagis.<verse eid="LUK 22:38" /></para>
  <para style="s1">Yesuusi Shamaho Deriya Bolla Woossis</para>
  <para style="r">(<ref loc="MAT 26:36-46">Maato 26:36-46</ref>; <ref loc="MRK 14:32-42">Mar 14:32-42</ref>)</para>
  <para style="p">
    <verse number="39" style="v" sid="LUK 22:39" />Yesuusi kase meezetidaysada dendidi Shamaho zuma bolla keyis. Iya tamaareti iya kaallidosona. <verse eid="LUK 22:39" /><verse number="40" style="v" sid="LUK 22:40" />He bessaa gakida wode, “Paacen gelonna mela woossite” yaagis. <verse eid="LUK 22:40" /><verse number="41" style="v" sid="LUK 22:41" />Entafe shuchi holin gakiya soo mela haakidi gulbatidi woossis. <verse eid="LUK 22:41" /><verse number="42" style="v" sid="LUK 22:42" />“Ta aawaw, ne shene gidiko ha metuwa taape aatha. Shin ta shene gidopo ne sheney hano” yaagidi woossis. <verse eid="LUK 22:42" /><verse number="43" style="v" sid="LUK 22:43" />Kiitanchoy salope qoncidi minthis. <verse eid="LUK 22:43" /><verse number="44" style="v" sid="LUK 22:44" />Daro un7etidi minnidi woossees. Iya cawayka suuthi xokiyada sa7an xokees.<verse eid="LUK 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 22:45" />Yesuusi woosa wursidi ba tamaaretako yis. Enti, azzanope dendoysan daaburidi dhiskidashin demmidi, <verse eid="LUK 22:45" /><verse number="46" style="v" sid="LUK 22:46" />“Ayis dhisketii? Paacen gelonna mela dendidi woossite” yaagis.<verse eid="LUK 22:46" /></para>
  <para style="s1">Yesuusi Oyketis</para>
  <para style="r">(<ref loc="MAT 26:47-56">Maato 26:47-56</ref>; <ref loc="MRK 14:43-50">Mar 14:43-50</ref>; <ref loc="JHN 18:3-11">Yoha 18:3-11</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 22:47" />I buroo oda bolla de7ishin daro asati yidosona. Tammanne nam7atape issoy Yihuda geeteteysi entana kaalethees. I Yesuusa yeeranaw mati shiiqis. <verse eid="LUK 22:47" /><verse number="48" style="v" sid="LUK 22:48" />Shin Yesuusi, “Yihuda, Asa Na7aa yeerada aatha immanee?” yaagis.<verse eid="LUK 22:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="LUK 22:49" />Yesuusa tamaareti he hanuwa be7idi, “Godaw mashshan shocino?” yaagidosona. <verse eid="LUK 22:49" /><verse number="50" style="v" sid="LUK 22:50" />Enta giddofe issoy kahine halaqaa oosanchuwa shocidi ushacha haytha qanxidi yeggis.<verse eid="LUK 22:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="LUK 22:51" />Shin Yesuusi, “Agga! Diggofite”<note caller="+" style="f"><char style="fr" closed="false">22:51 </char><char style="fqa" closed="false">Agga! Diggofite: </char><char style="ft" closed="false">Yesuusi ha bessan agga yaagiday iya ashshanaw gidi asati uraa haytha qanxoysa agga qanxofa gidaysanne, harati iya oykanaw yidaysata diggofite ha77i enta wode yaagidaysa nam7u qofata woli gathidi oykis.</char></note> yaagis. Uraa haythaa bochidi pathis.<verse eid="LUK 22:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="LUK 22:52" />Hessafe guye, Yesuusi bana oykanaw yida kahine halaqatako, Xoossa Keetha naageysata shuumatakonne cimatako, “Paanno oykiya asada mashshenne xam7a oykidi yidetii? <verse eid="LUK 22:52" /><verse number="53" style="v" sid="LUK 22:53" />Ubba gallas xoossa keethan ta hintera de7iya wode ta bolla kushe wothibeeketa. Shin haysi dhuma kawotethay haarida wodenne hinte wode” yaagis.<note caller="-" style="x"><char style="xo" closed="false">22:53 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luqa 19:47</ref>; <ref loc="LUK 21:37">21:37</ref>.</char></note><verse eid="LUK 22:53" /></para>
  <para style="s1">Phexroosi Yesuusa Kaddis</para>
  <para style="r">(<ref loc="MAT 26:57-58">Maato 26:57-58</ref>, <ref loc="MAT 26:67-75">67-75</ref>; <ref loc="MRK 14:53-54">Mar 14:53-54</ref>, <ref loc="MRK 14:66-72">66-72</ref>; <ref loc="JHN 18:12-18">Yoha 18:12-18</ref>, <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="54" style="v" sid="LUK 22:54" />Hessafe guye, Yesuusa oykidi kahine halaqaa zabbaa efidosona. Phexroosi haahon Yesuusa kaallees. <verse eid="LUK 22:54" /><verse number="55" style="v" sid="LUK 22:55" />Asati kahine halaqaa zabban tama eethidi wolla uttidashin Phexroosi entara issife uttis. <verse eid="LUK 22:55" /><verse number="56" style="v" sid="LUK 22:56" />Issi gadhindiya Phexroosi tama matan uttidaysa cadda xeellada, “Ha uray iyara de7ees” yaagasu.<verse eid="LUK 22:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="LUK 22:57" />Shin Phexroosi, “Ha maccasete ta he uraa erike” yaagidi kaddis.<verse eid="LUK 22:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="LUK 22:58" />Guutha wodepe guye issi hara addey iya be7idi, “Neka entafe issuwa” yaagis.</para>
  <para style="p" vid="LUK 22:58">Shin Phexroosi, “Ha addiyaw tana gidike” yaagis.<verse eid="LUK 22:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LUK 22:59" />Issi saate mela gam7idaape guye issi hara addey tillisidi, “Ha uray Galilape gidiya gisho sidhey bayna iyara de7ees” yaagis.<verse eid="LUK 22:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="LUK 22:60" />Shin Phexroosi, “Ha addiyaw, ne geysa ta erike” yaagis. I he oda ongonna de7ishin kuttoy waassis.<verse eid="LUK 22:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="LUK 22:61" />Goday guye simmidi Phexroosa xeellis. Phexroosi, “Hachi kuttoy waassanaape sinthe ne tana heedzu toho kaddana” yaagidi, Goday odida qaala akeekis. <verse eid="LUK 22:61" /><verse number="62" style="v" sid="LUK 22:62" />Phexroosi kare keyidi daro kokoridi yeekis.<verse eid="LUK 22:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="LUK 22:63" />Yesuusa naagiya asati iya leqisonne deshethi oykidosona. <verse eid="LUK 22:63" /><verse number="64" style="v" sid="LUK 22:64" />Iya ayfiya goozidi “Ane tinbite oda; nena dechiday oonee?” yaagidi oychoosona. <verse eid="LUK 22:64" /><verse number="65" style="v" sid="LUK 22:65" />Hara daro cashshe cayidi kawushoosona.<verse eid="LUK 22:65" /></para>
  <para style="s1">Yesuusi Pirda Shango Sinthan</para>
  <para style="r">(<ref loc="MAT 26:59-66">Maato 26:59-66</ref>; <ref loc="MRK 14:55-64">Mar 14:55-64</ref>; <ref loc="JHN 18:19-24">Yoha 18:19-24</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="LUK 22:66" />Sa7i wontiya wode Ayhude biitta cimati, kahine halaqatinne higge astamaareti shiiqidi, Yesuusa banta sinthe shiishidosona. <verse eid="LUK 22:66" /><verse number="67" style="v" sid="LUK 22:67" />Enti, “Neeni Kiristoosee? Ane nuus oda?” yaagidi oychidosona.</para>
  <para style="p" vid="LUK 22:67">Yesuusi, “Ta odiyako ammaneketa. <verse eid="LUK 22:67" /><verse number="68" style="v" sid="LUK 22:68" />Ta oychiyako zaareketa. <verse eid="LUK 22:68" /><verse number="69" style="v" sid="LUK 22:69" />Shin Asa Na7ay haysafe gede baggan wolqaama Xoossaa ushacha baggan uttana” yaagis.<verse eid="LUK 22:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="LUK 22:70" />He wode ubbay, “Yaatin, neeni Xoossaa na7ee?” yaagidosona.</para>
  <para style="p" vid="LUK 22:70">I, “Ta Xoossaa na7a gideysa hinte gideta” yaagis.<verse eid="LUK 22:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="LUK 22:71" />Enti, “Hiza, hara marka ay koshshii? I ba inxarsan odishin nu si7ida” yaagidosona.<verse eid="LUK 22:71" /></para>
  <chapter eid="LUK 22" />
  <chapter number="23" style="c" sid="LUK 23" />
  <para style="s1">Yesuusi Philaxoosa Sinthan</para>
  <para style="r">(<ref loc="MAT 27:1-2">Maato 27:1-2</ref>, <ref loc="MAT 27:11-14">11-14</ref>; <ref loc="MRK 15:1-5">Mar 15:1-5</ref>; <ref loc="JHN 18:28-38">Yoha 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 23:1" />He bessan shiiqida shangoti ubbay dendidi Yesuusa Philaxoosako efidosona. <verse eid="LUK 23:1" /><verse number="2" style="v" sid="LUK 23:2" />“Ha uray nu asaa balethishin, kawas giira giironna mela diggishininne qassi, ‘Taani Kiristoosa hinte kawa’ yaagishin demmida” yaagidi mootidosona.<verse eid="LUK 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LUK 23:3" />Philaxoosi Yesuusa, “Neeni Ayhudeta kawo?” yaagidi oychis.</para>
  <para style="p" vid="LUK 23:3">Yesuusi, “Ee, ne gidaysa mela” yaagis.<verse eid="LUK 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LUK 23:4" />Philaxoosi kahine halaqatakonne asaako, “Ha uraa bolla taani issi balaka demmabike” yaagis. <verse eid="LUK 23:4" /><verse number="5" style="v" sid="LUK 23:5" />Shin enti, “Ha uray Galilape doomidi haysa gakanaw Yihuda kumetha iitabas denthethees” yaagidi minthi odidosona.<verse eid="LUK 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LUK 23:6" />Philaxoosi hessa si7ida wode Yesuusi Galila aseeko eranaw koyidi iya oychis. <verse eid="LUK 23:6" /><verse number="7" style="v" sid="LUK 23:7" />Yesuusi Herodiisa biittafe yida asi gideysa Philaxoosi erida wode Herodiisi he wode Yerusalaamen de7iya gisho iyako yeddis.<verse eid="LUK 23:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 23:8" />Herodiisi Yesuusa be7anaw daro wodepe koyishe de7iya gisho, iya be7ida wode daro ufaytis. Ayis giiko, iyabaa si7ida gisho malaalsiyaba oothin be7anaw amotishe de7ees. <verse eid="LUK 23:8" /><verse number="9" style="v" sid="LUK 23:9" />Herodiisi Yesuusa daro oyshota oychis, shin I aykoka zaaribeenna. <verse eid="LUK 23:9" /><verse number="10" style="v" sid="LUK 23:10" />Kahineta halaqatinne higge astamaareti yan eqidi minthidi iya mootosona. <verse eid="LUK 23:10" /><verse number="11" style="v" sid="LUK 23:11" />Herodiisaranne iya wotaadaretara Yesuusa kadhidosonanne leqsidosona. Boncho afila mayzidi Philaxoosako zaaridi yeddidosona. <verse eid="LUK 23:11" /><verse number="12" style="v" sid="LUK 23:12" />Herodiisaranne Philaxoosara kase morkeshin he gallas wolla giigidosona.<verse eid="LUK 23:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 23:13" />Philaxoosi kahine halaqata, asaa haareysatanne asaa xeegidi, <verse eid="LUK 23:13" /><verse number="14" style="v" sid="LUK 23:14" />“ ‘Ha uray asaa geellatethas denthethees’ gidi taako ehideta. Taka hinte sinthan pilgada hinte shiishida mootuwas aybi balaka demmabike. <verse eid="LUK 23:14" /><verse number="15" style="v" sid="LUK 23:15" />Herodiisi, hessatho aybi balaka iya bolla demmiboonna gisho nuuko yeddis. Tumaka ha uray hayqos gathiya aybi balaka oothibeenna. <verse eid="LUK 23:15" /><verse number="16" style="v" sid="LUK 23:16" />Hessa gisho, iya garaafada billa yeddana” yaagis. <verse eid="LUK 23:16" /><verse number="17" style="v" sid="LUK 23:17" />Hessa I giday Paasika Ba7aale wode issi asi entaw billanaysi iyaw attonnaba gidiya gishosa.<verse eid="LUK 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LUK 23:18" />Derey ubbay issi bolla, “Ha uraa gede digga, nuus Barbaana billa” yaagidi waassidosona. <verse eid="LUK 23:18" /><verse number="19" style="v" sid="LUK 23:19" />Barbaani katamaa giddon asaa iitabas denthethidi ase wodhidi qashetida asi.<verse eid="LUK 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LUK 23:20" />Philaxoosi Yesuusa billanaw koyidi asaas zaari odis. <verse eid="LUK 23:20" /><verse number="21" style="v" sid="LUK 23:21" />Gidoshin, asay, “Kaqa! Kaqa!” yaagidi waassidosona. <verse eid="LUK 23:21" /><verse number="22" style="v" sid="LUK 23:22" />Philaxoosi heedzantho, “Ha uray qohidabay aybee? Wodhos gathiya bala ta demmabike. Hessa gisho, garaafada yedda aggana” yaagis.<verse eid="LUK 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LUK 23:23" />Enti banta qaala dhoqu oothidi, “Kaqetanaw bessees” gidi minthi waassidosona. Enta waasoyka xoonis. <verse eid="LUK 23:23" /><verse number="24" style="v" sid="LUK 23:24" />Enta oysha gisho, gidi Philaxoosi iya bolla pirdis. <verse eid="LUK 23:24" /><verse number="25" style="v" sid="LUK 23:25" />Ase iitabas denthethidaysanne ase wodhidi qashetidaysa billana mela woossida gisho he uraa entaw billis. Shin Yesuusa enti koydaba oothana mela entaw aathidi immis.<verse eid="LUK 23:25" /></para>
  <para style="s1">Yesuusa Kaqetetha</para>
  <para style="r">(<ref loc="MAT 27:31-44">Maato 27:31-44</ref>; <ref loc="MRK 15:21-32">Mar 15:21-32</ref>; <ref loc="JHN 19:17-27">Yoha 19:17-27</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LUK 23:26" />Yesuusa oykidi efishin Simoona geetetiya Qereena biitta addey gaxarepe yishin, demmidi masqaliya toossidi Yesuusa kaallidi baana mela un7ethidosona. <verse eid="LUK 23:26" /><verse number="27" style="v" sid="LUK 23:27" />Daro asaynne banta tiraa iccishe yeekiya maccasati iya guyera kaalloosona.<verse eid="LUK 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 23:28" />Shin Yesuusi entako guye simmidi, “Hinteno, Yerusalaame maccasato, hinte huuphesinne hinte naytas yeekitepe attishin, taw yeekofite. <verse eid="LUK 23:28" /><verse number="29" style="v" sid="LUK 23:29" />‘Heko maynthati, yelonna ulotinne dhanthonna dhanthati anjetidosona’ hinte yaagana gallasay yaana. <verse eid="LUK 23:29" /><verse number="30" style="v" sid="LUK 23:30" />He wode dereta, ‘Nu bolla kundite’, zumataka, ‘Nuna kammite’ yaagana.<note caller="-" style="x"><char style="xo" closed="false">23:30 </char><char style="xt" closed="false"><ref loc="HOS 10:8">Hose 10:8</ref>; <ref loc="REV 6:16">Qon 6:16</ref>.</char></note> <verse eid="LUK 23:30" /><verse number="31" style="v" sid="LUK 23:31" />Hiza, qaye mithaa hessatho oothiko mela mithaa waatandesha?” yaagis.<verse eid="LUK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LUK 23:32" />Iyara wodhanaw hara nam7u worandzota efidosona. <verse eid="LUK 23:32" /><verse number="33" style="v" sid="LUK 23:33" />Qeraaniyo<note caller="+" style="f"><char style="fr" closed="false">23:33 </char><char style="fqa" closed="false">Qeraaniyo: </char><char style="ft" closed="false">Qeraaniyo geysi Girike doona. Aramike doonan “Golgota” woyko “Huuphe guugge” guussu. Qeraaniyo geetetiya sunthay imetiday Yesuusi kaqetiday asa huuphe guugge daaniya bessan gidiya gishosa. He bessay Roome kawotethay worandzota kaqiya bessi. (</char><char style="xt"><ref loc="MAT 27:33">Maato 27:33</ref>; <ref loc="MRK 15:22">Mar 15:22</ref>; <ref loc="JHN 19:17">Yoha 19:17</ref></char>) </note> geetetiya bessaa gathidi kaqidosona. Worandzotape issuwa ushacha baggara hankuwa haddirsa baggara kaqidosona. <verse eid="LUK 23:33" /><verse number="34" style="v" sid="LUK 23:34" />Yesuusi, “Ta aawaw, enti ay oothiyako eronna gisho, neeni entaw atto yaaga” yaagis.<note caller="-" style="x"><char style="xo" closed="false">23:34 </char><char style="xt" closed="false"><ref loc="PSA 22:18">Maz 22:18</ref>.</char></note></para>
  <para style="p" vid="LUK 23:34">Enti iya afilaa bolla saama yeggidi shaaketidi ekidosona.<verse eid="LUK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 23:35" />Asay eqidi xeelloosona, shin deriya haareysati, “Harata ashshis; Xoossay doorida Kiristoosi iya gidiko ane bana asho” yaagidi leqsidosona.<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">Maz 22:18</ref>; <ref loc="PSA 22:7">Maz 22:7</ref>.</char></note> <verse eid="LUK 23:35" /><verse number="36" style="v" sid="LUK 23:36" />Wotaaddareti iyako shiiqidi, caala woyne ushsha immidosona.<note caller="-" style="x"><char style="xo" closed="false">23:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Maz 69:21</ref>.</char></note> <verse eid="LUK 23:36" /><verse number="37" style="v" sid="LUK 23:37" />Yaatidi, “Neeni Ayhudeta kawo gidiko ne huuphiya ashsha” yaagidi leqsidosona.<verse eid="LUK 23:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 23:38" />Iyaw huuphe baggara, “Haysi Ayhudeta kawo” giya xuufey de7ees. <verse eid="LUK 23:38" /><verse number="39" style="v" sid="LUK 23:39" />Kaqetida worandzotape issoy cashshe sa7ara goochishe, “Ane neeni Kiristoosa gidiko, nenaka nunaka ashsha” yaagis.<verse eid="LUK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LUK 23:40" />Shin hanko worandzoy, “Neeni haysa mela pirdan de7ashe hari attoshin, Xoossas yayyikii? <verse eid="LUK 23:40" /><verse number="41" style="v" sid="LUK 23:41" />Nuuni nu oothida nagaraa gisho bessiya pirda ekoos, shin ha uray issi iitabaa oothibeenna” yaagidi hanqetis.<verse eid="LUK 23:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="LUK 23:42" />Qassika, “Yesuusa, ne ne kawotethaara yaa wode tana qopa” yaagis.<verse eid="LUK 23:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LUK 23:43" />Yesuusi, “Ta new tuma odayis; hachi neeni taara gannaten gidana” yaagis.<verse eid="LUK 23:43" /></para>
  <para style="p">
    <verse number="44-45" style="v" sid="LUK 23:44-45" />He gallas usupun saatepe bidi uddufun saate gakanaw away poo7uwa diggida gisho, biitta ubbaa bolla dhuma gidis. Xoossa Keetha geshey daaketidi nam7an shaaketis.<note caller="-" style="x"><char style="xo" closed="false">23:44-45 </char><char style="xt" closed="false"><ref loc="EXO 26:31">Kessa 26:31</ref>.</char></note> <verse eid="LUK 23:44-45" /><verse number="46" style="v" sid="LUK 23:46" />Yesuusi, qaala dhoqu oothidi, “Ta aawaw, ta ta shempiw ne kushen sheedhayis” yaagidi hayqis.<note caller="-" style="x"><char style="xo" closed="false">23:46 </char><char style="xt" closed="false"><ref loc="PSA 31:5">Maz 31:5</ref>.</char></note><verse eid="LUK 23:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LUK 23:47" />Mato halaqay, hanidaysa be7idi, “Haysi uray tumaka xillo” yaagidi Xoossaa galatis. <verse eid="LUK 23:47" /><verse number="48" style="v" sid="LUK 23:48" />Ha haniyaba be7anaw he bessaa shiiqida asa ubbay hanidaba be7ida wode banta tiraa iccishe banta soo simmidosona. <verse eid="LUK 23:48" /><verse number="49" style="v" sid="LUK 23:49" />Gidoshin, Yesuusa matan eriya asa ubbay, hessadaka Galilape kaallidi yida maccasati hessa be7ishe haahon eqidosona.<note caller="-" style="x"><char style="xo" closed="false">23:49 </char><char style="xt" closed="false"><ref loc="LUK 8:2">Luqa 8:2</ref>.</char></note><verse eid="LUK 23:49" /></para>
  <para style="p">
    <verse number="50-51" style="v" sid="LUK 23:50-51" />Ayhude shangotape issoy, Yoosefa geetetiya uray de7ees. I Armaate geetetiya Yihuda katamaape yis. I lo77onne Xillo asi gidiya gisho Xoossaa kawotethaa yuussaa naagees. Shangotape issuwa gidishe enta zoretethaaninne oosuwan deenna. <verse eid="LUK 23:50-51" /><verse number="52" style="v" sid="LUK 23:52" />He uray Philaxoosako bidi, Yesuusa aha mooganaw taw imma gidi woossis. <verse eid="LUK 23:52" /><verse number="53" style="v" sid="LUK 23:53" />Philaxoosi eka yaagin, Yesuusa aha wodhisidi afilara xaaxis. Zaallafe woocidi kessida hara asi moogetonna ooratha duufon wothis. <verse eid="LUK 23:53" /><verse number="54" style="v" sid="LUK 23:54" />Sambaati gelana haniya gisho, he gallasay giigetetha qamma.<verse eid="LUK 23:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="LUK 23:55" />Galilape dendidi Yesuusa kaallidi yida maccasati Yoosefara bidi iya aha waati moogiyako duufuwa akeekidi be7idosona. <verse eid="LUK 23:55" /><verse number="56" style="v" sid="LUK 23:56" />Yaape simmidi shittonne qibaate giigisidosona. Higgey kiitteysa mela Sambaata gallas shempi pee7idosona.<note caller="-" style="x"><char style="xo" closed="false">23:56 </char><char style="xt" closed="false"><ref loc="EXO 20:10">Kessa 20:10</ref>; <ref loc="DEU 5:14">Zaare 5:14</ref>.</char></note><verse eid="LUK 23:56" /></para>
  <chapter eid="LUK 23" />
  <chapter number="24" style="c" sid="LUK 24" />
  <para style="s1">Yesuusa Hayqope Denduwa</para>
  <para style="r">(<ref loc="MAT 28:1-10">Maato 28:1-10</ref>; <ref loc="MRK 16:1-8">Mar 16:1-8</ref>; <ref loc="JHN 20:1-10">Yoha 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LUK 24:1" />Saamintafe koyro gallas, wogga wode wonta daro guura, maccasati banta giigisida shittuwa ekidi duufuwa bidosona. <verse eid="LUK 24:1" /><verse number="2" style="v" sid="LUK 24:2" />Enti yaa gakiya wode duufuwa doonan de7iya shuchay gonderetidi kichoysa demmidosona. <verse eid="LUK 24:2" /><verse number="3" style="v" sid="LUK 24:3" />Enti duufuwa gaathi gelidosona, shin Godaa Yesuusa aha demmibookona. <verse eid="LUK 24:3" /><verse number="4" style="v" sid="LUK 24:4" />Enti yan eqidi aybi hanide gidi qopishin akeekona daro phooliya afila ma7ida nam7u asati enta matan eqidosona. <verse eid="LUK 24:4" /><verse number="5" style="v" sid="LUK 24:5" />Maccasati yashetidi banta huuphiya sa7an ziqi oothidi de7ishin, asati entako, “De7on de7eysa hayqota giddon ayis koyeetii? <verse eid="LUK 24:5" /><verse number="6-7" style="v" sid="LUK 24:6-7" />I haysan deenna; hayqope dendis, ‘Asa Na7ay nagaranchota kushen aadhidi imetana; entika iya kaqana.<note caller="-" style="x"><char style="xo" closed="false">24:6-7 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Maato 16:21</ref>; <ref loc="MAT 17:22-23">17:22-23</ref>; <ref loc="MAT 20:18-19">20:18-19</ref>; <ref loc="MRK 8:31">Mar 8:31</ref>; <ref loc="MRK 9:31">9:31</ref>; <ref loc="MRK 10:33-34">10:33-34</ref>; <ref loc="LUK 9:22">Luqa 9:22</ref>; <ref loc="LUK 18:31-33">18:31-33</ref>.</char></note> I heedzantho qamman hayqope dendana’ yaagidi, I hintera Galilan de7ishe hintew odida qaala qopite” yaagis.<verse eid="LUK 24:6-7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LUK 24:8" />Maccasati he wode iya qaala qopidosona.<verse eid="LUK 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LUK 24:9" />Maccasati duufuwape simmidi hanidaba ubbaa tammanne issotasinne haratasika odidosona. <verse eid="LUK 24:9" /><verse number="10" style="v" sid="LUK 24:10" />Hessa hawaaretas odiday Magdela Mayraamo, Yohaana, Yayqooba aayiw Mayraamonne entara de7iya hara maccasata. <verse eid="LUK 24:10" /><verse number="11" style="v" sid="LUK 24:11" />Shin entaw maccasati odidaysi elmo daanin ammanibookona. <verse eid="LUK 24:11" /><verse number="12" style="v" sid="LUK 24:12" />Shin Phexroosi dendi woxidi duufo bis. He bessaa gakidi, hokidi gaathi xeelliya wode moogo afilaa xalaala be7is. Hanidaban malaaletishe ba soo simmis.<verse eid="LUK 24:12" /></para>
  <para style="s1">Emahoose Oge Bolla</para>
  <para style="r">(<ref loc="MRK 16:12-13">Mar 16:12-13</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="LUK 24:13" />He gallas kaalliya tamaaretape nam7ati Yerusalaamepe tammanne issi kilo mitire haakiya Emahoose guta boosona. <verse eid="LUK 24:13" /><verse number="14" style="v" sid="LUK 24:14" />Enti wolla hanidaba ubbaa odetoosona. <verse eid="LUK 24:14" /><verse number="15" style="v" sid="LUK 24:15" />Enti he hanotaba qopishenne odetishe biya wode Yesuusi ba huuphen shiiqidi entara bees. <verse eid="LUK 24:15" /><verse number="16" style="v" sid="LUK 24:16" />Hanoshin, enti iya eronna mela enta ayfey oyketis.<verse eid="LUK 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LUK 24:17" />I, “Hinte wolla oge bolla de7ishe odeteysi aybee?” yaagis.</para>
  <para style="p" vid="LUK 24:17">Enti azzanidi si77i gidi eqidosona. <verse eid="LUK 24:17" /><verse number="18" style="v" sid="LUK 24:18" />Entafe issoy Qeliyoophe geeteteysi, “Ha qammata giddon Yerusalaamen hanidaba eronnaysi, ne biittas imatheyee?” yaagis.<verse eid="LUK 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LUK 24:19" />I zaaridi, “I hanidaysi aybee?” yaagidi oychis.</para>
  <para style="p" vid="LUK 24:19">Enti, “Xoossaa sinthaninne asa sinthan oosoninne odan mino nabe gidida Naazirete Yesuusaba. <verse eid="LUK 24:19" /><verse number="20" style="v" sid="LUK 24:20" />Iya kahine halaqatinne haareysati hayqo pirdas aathi immidi, kaqidosona. <verse eid="LUK 24:20" /><verse number="21" style="v" sid="LUK 24:21" />Nuuni Isra7eele asaa wozande gidi ufaytidi naagidashin haysi hanin hachi heedzantho qamma. <verse eid="LUK 24:21" /><verse number="22" style="v" sid="LUK 24:22" />Qassi nu giddofe issi issi maccasati nuna malaalsidosona. Enti hachi wonta guura duufuwa bidosona. <verse eid="LUK 24:22" /><verse number="23" style="v" sid="LUK 24:23" />Iya aha dhayida wode simmi yidi, ‘I paxa de7ees’ giya kiitanchoti qoncin be7ida yaagidi odidosona. <verse eid="LUK 24:23" /><verse number="24" style="v" sid="LUK 24:24" />Nu giddofeka issoti issoti duufuwa bidi maccasati odidaysatho hanin be7idosona, shin iya be7ibookona” yaagis.<verse eid="LUK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LUK 24:25" />I entako, “Hinteno, akeekona asato, hinte wozanay nabeti odidaba ubbaa ammananaw gam7eysato, <verse eid="LUK 24:25" /><verse number="26" style="v" sid="LUK 24:26" />Kiristoosi ha metuwa ekanawunne ba bonchuwan gelanaw bessennee?” yaagis. <verse eid="LUK 24:26" /><verse number="27" style="v" sid="LUK 24:27" />Musepenne nabeta ubbaafe dendidi Geeshsha Maxaafan iyabay xaafetidaysa ubbaa entaw qoncisis.<verse eid="LUK 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LUK 24:28" />Enti biya gutaako matatida wode Yesuusi aadhidi haaho soo biya daanin, <verse eid="LUK 24:28" /><verse number="29" style="v" sid="LUK 24:29" />Enti, “Sa7ay qammida gisho nuura aqa” yaagidi minthidi woossidosona. Hessa gisho, entara aqanaw gelis.<verse eid="LUK 24:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LUK 24:30" />Entara issife gayta bolla uttidi, uythaa denthidi, menthidi, anjidi entaw immis. <verse eid="LUK 24:30" /><verse number="31" style="v" sid="LUK 24:31" />He wode enti erana mela enta ayfey dooyetis. Entika eridosona. Shin I entafe geemmis. <verse eid="LUK 24:31" /><verse number="32" style="v" sid="LUK 24:32" />Enti, “Nu ogiya bolla de7ishin I nuus Geeshsha Maxaafaa birshishininne nuna odisishin, nu wozanay xuugetibeennee?” yaagidosona. <verse eid="LUK 24:32" /><verse number="33" style="v" sid="LUK 24:33" />He wode dendidi guye Yerusalaame yidosona. Tammanne issotinne harati issi bolla shiiqidi de7ishin demmidosona. <verse eid="LUK 24:33" /><verse number="34" style="v" sid="LUK 24:34" />Enti, “Goday tuma dendis; Simoonas qoncis” yaagidosona.<verse eid="LUK 24:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LUK 24:35" />He nam7u tamaareti Emmahuuse ogiya bolla de7ishin hanidaysanne uythaa menthida wode waati iya eridaako entaw odidosona.<verse eid="LUK 24:35" /></para>
  <para style="s1">Yesuusi Ba Tamaaretas Qoncis</para>
  <para style="r">(<ref loc="MAT 28:16-20">Maato 28:16-20</ref>; <ref loc="MRK 16:14-18">Mar 16:14-18</ref>; <ref loc="JHN 20:19-23">Yoha 20:19-23</ref>; <ref loc="ACT 1:6-8">Hawa 1:6-8</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="LUK 24:36" />Nam7u tamaareti hessa oda bolla de7ishin, Yesuusi enta giddon eqidi, “Saroy hintew gido” yaagis.<verse eid="LUK 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LUK 24:37" />Gidoshin, enti dagammidi, moytille be7ida daanin yayyidosona.<verse eid="LUK 24:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LUK 24:38" />I entako, “Ayis babidetii? Ayis sidhey hinte wozanan gelidee? <verse eid="LUK 24:38" /><verse number="39" style="v" sid="LUK 24:39" />Ta kushiyanne ta tohuwa be7ite; taani tana. Qassi oykidi be7ite; tanan hinte be7eysada, moytilles ashoynne meqethi baawa” yaagis. <verse eid="LUK 24:39" /><verse number="40" style="v" sid="LUK 24:40" />Yaagidi, ba tohuwanne ba kushiya enta bessis. <verse eid="LUK 24:40" /><verse number="41" style="v" sid="LUK 24:41" />Enti ufaysafe dendoysan ammanonna malaaletethan de7ishin, Yesuusi entako, “Haysan hintew miyabay de7ii?” yaagis. <verse eid="LUK 24:41" /><verse number="42" style="v" sid="LUK 24:42" />Enti issi caacetida molo iyaw immidosona. <verse eid="LUK 24:42" /><verse number="43" style="v" sid="LUK 24:43" />I ekidi enta sinthan mis.<verse eid="LUK 24:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LUK 24:44" />I, “Ta hintera gam7ida wode ubban Muse maxaafatan, nabeta maxaafataninne Mazmure maxaafatan, ta gisho xaafetidabay ubbay poletanaw bessees yaagada ta hintew odida qaalay haysa” yaagis.<verse eid="LUK 24:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LUK 24:45" />He wode Geeshsha Maxaafata akeekana mela enta wozanaa dooyis. <verse eid="LUK 24:45" /><verse number="46" style="v" sid="LUK 24:46" />Hessadaka, “Kiristoosi waaye ekana, heedzantho qamman hayqope dendana yaagidi xaafetis. <verse eid="LUK 24:46" /><verse number="47" style="v" sid="LUK 24:47" />Yerusalaamepe dendidi asaa ubbaas nagaraape maarotethaynne atotethay iya sunthan markatana. <verse eid="LUK 24:47" /><verse number="48" style="v" sid="LUK 24:48" />Hinte hessas markata. <verse eid="LUK 24:48" /><verse number="49" style="v" sid="LUK 24:49" />Heko, taka ta aaway immida ufaysaa hintew yeddana. Hinte salope wolqa ma7ana gakanaw Yerusalaame kataman gam7ite” yaagis.<note caller="-" style="x"><char style="xo" closed="false">24:49 </char><char style="xt" closed="false"><ref loc="ACT 1:4">Hawa 1:4</ref>.</char></note><verse eid="LUK 24:49" /></para>
  <para style="s1">Yesuusi Pude Salo Bis</para>
  <para style="r">(<ref loc="MRK 16:19-20">Mar 16:19-20</ref>; <ref loc="ACT 1:9-11">Hawa 1:9-11</ref>)</para>
  <para style="p">
    <verse number="50" style="v" sid="LUK 24:50" />Hessafe guye, Bitaane katamaa entana ekidi bis. Ba kushiya denthidi anjis.<note caller="-" style="x"><char style="xo" closed="false">24:50 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">Hawa 1:9-11</ref>.</char></note> <verse eid="LUK 24:50" /><verse number="51" style="v" sid="LUK 24:51" />Entana anjishe entafe shaaketidi pude salo eketis. <verse eid="LUK 24:51" /><verse number="52" style="v" sid="LUK 24:52" />Enti ziggi goyinnidi daro ufaysan Yerusalaame simmidosona. <verse eid="LUK 24:52" /><verse number="53" style="v" sid="LUK 24:53" />Xoossaa ubbaa wode galatishe xoossa keethan gam7idosona.<verse eid="LUK 24:53" /></para>
  <chapter eid="LUK 24" />
</usx>