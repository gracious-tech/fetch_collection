<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Ibraawe Kiita</para>
  <para style="toc1">Ibraawe Kiita</para>
  <para style="toc3">Ibra</para>
  <para style="toc2">Ibraawe</para>
  <para style="mt1">Ibraawe Asaas</para>
  <para style="mt2">Xaafetida Kiita</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Ha kiitay xaafetiday, wolqaama metoy gakin, banta ammanuwa agganaw matida ammaniya asaasa. Ha maxaafa xaafey, Yesuus Kiristoosi wursethinne tuma Xoossa qoncethi gideysa Ibraawe asaas bessees. Ammaniya asay banta ammanuwan minnana mela enta minthethees. I hessan heedzu ayfe qofata qoncisidi bessees.</para>
  <para style="ipi">1. Yesuusi ba ekida metuwan Aawas tuma kiitetida merina Xoossa Na7a. I Xoossa Na7a gidida gisho, Gal7a Caaquwa wode de7iya nabetape, kiitanchotapenne Musepe bolla.</para>
  <para style="ipi">2. Yesuusi Gal7a Caaquwa kahinetape daro aadhiya merina kahine gideysa Xoossay ba huuphen markatis.</para>
  <para style="ipi">3. Yesuusa baggara ammaniya asi nagarape, yashafenne hayqope attees. Yesuusi kahine halaqa gideysada, kase Ibraaweta ammano woganinne mehe yarshon kuyada bentiya atotetha oosuwa ha77i tuma oothis.</para>
  <para style="ip">Xaafey Isra7eele asa taariken daro eretida asaa ammano leemiso oothi ekidi (Shem 11) ha maxaafa nabbabiya asay banta ammanuwan minnana mela akeekisees. Hessadaka, shempo 12 nabbabiya asay banta ayfiya Yesuusa bolla wothidi, banta ammanuwan minnana melanne ay metoynne waayey gakikoka, gencana mela zorees. Wursethan zoreninne akeekiso qaalan ba kiita kuuyees.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Xoossay Kiristoosa baggara qoncis <char style="ior">(<ref loc="HEB 1:1-4">1:1-4</ref>)</char></para>
  <para style="io1">Kiristoosi kiitanchotape bolla <char style="ior">(<ref loc="HEB 1:4-2:18">1:4—2:18</ref>)</char></para>
  <para style="io1">Kiristoosi Musepenne Iyyasupe bolla <char style="ior">(<ref loc="HEB 3:1-4:13">3:1—4:13</ref>)</char></para>
  <para style="io1">Kiristoosa kahinetethay bolla <char style="ior">(<ref loc="HEB 4:14-7:28">4:14—7:28</ref>)</char></para>
  <para style="io1">Kiristoosa caaqoy bolla <char style="ior">(<ref loc="HEB 8:1-9:22">8:1—9:22</ref>)</char></para>
  <para style="io1">Kiristoosa yarshoy bolla <char style="ior">(<ref loc="HEB 9:23-10:39">9:23—10:39</ref>)</char></para>
  <para style="io1">Ammano bayratethi <char style="ior">(<ref loc="HEB 11:1-12:29">11:1—12:29</ref>)</char></para>
  <para style="io1">Xoosse ufaysiya de7o <char style="ior">(<ref loc="HEB 13:1-19">13:1-19</ref>)</char></para>
  <para style="io1">Akeekisonne zore <char style="ior">(<ref loc="HEB 13:20-25">13:20-25</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s1">Na7ay Kiitanchotape Bolla</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />Kase Xoossay, nu aawatas nabeta baggara dumma dumma ogen daro wode odis. <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />Shin ha wursetha wodiyan ubbaa iya laatisida qassi alame iya baggara medhida ba Na7aa baggara nuus odis. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />Na7ay Xoossaa bonchuwa phoolethaanne kumetha Xoossa Xoossatetha ekidi, ba wolqaama qaalan ha alamiya katisidi oykis. Asaa enta nagaraape geeshidaape guye Ubbaafe Bolla Xoossaa ushacha baggan saluwan uttis.<verse eid="HEB 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />Iyaw imetida sunthay kiitanchota sunthafe bolla gideysada I entafe bolla. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />Hiza, Xoossay kiitanchotape oodeko,</para>
  <para style="q1" vid="HEB 1:5">“Neeni ta Na7a;</para>
  <para style="q2" vid="HEB 1:5">ta hachi new aawa gidas” gidee?</para>
  <para style="m" vid="HEB 1:5">Woyko qassi oodeko,</para>
  <para style="q1" vid="HEB 1:5">“Taani iyaw aawa gidana;</para>
  <para style="q2" vid="HEB 1:5">ika taw na7a gidana” gidee?<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Maz 2:7</ref>; <ref loc="2SA 7:14">2 Same 7:14</ref>; <ref loc="1CH 17:13">1 Taari 17:13</ref>.</char></note><verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />Qassi Xoossay ba bayra Na7aa ha alamiya kiittishe,</para>
  <para style="q1" vid="HEB 1:6">“Xoossaa kiitanchoti ubbay iyaw goyinno”</para>
  <para style="m" vid="HEB 1:6">yaagis.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 32:43">Zaare 32:43</ref>.</char></note> <verse eid="HEB 1:6" /><verse number="7" style="v" sid="HEB 1:7" />Xoossay kiitanchotaba odishe,</para>
  <para style="q1" vid="HEB 1:7">“Xoossay ba Kiitanchota carko,</para>
  <para style="q2" vid="HEB 1:7">ba aylleta tama laco oothees”</para>
  <para style="m" vid="HEB 1:7">yaagees.<note caller="-" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="PSA 104:4">Maz 104:4</ref>.</char></note> <verse eid="HEB 1:7" /><verse number="8" style="v" sid="HEB 1:8" />Shin ba Na7aba odishe,</para>
  <para style="q1" vid="HEB 1:8">“Xoossaw, ne araatay merinaw de7ees.</para>
  <para style="q2" vid="HEB 1:8">Ne kawotethaa ne xillotethan aysaasa.<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="PSA 45:6-7">Maz 45:6-7</ref>.</char></note><verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />Neeni xillotethi dosadasa; iita ixadasa.</para>
  <para style="q2" vid="HEB 1:9">Xoossay, ne Goday, nena ne laggetape aathidi dooris,</para>
  <para style="q2" vid="HEB 1:9">ufaysa zayte<note caller="+" style="f"><char style="fr" closed="false">1:9 </char><char style="fqa" closed="false">Ufaysa zayte: </char><char style="ft" closed="false">I kawotiya wode asay ufaysan ililidi iya kawotheysa bessees.</char></note> nena tiyis”</para>
  <para style="m" vid="HEB 1:9">yaagees. <verse eid="HEB 1:9" /><verse number="10" style="v" sid="HEB 1:10" />Xoossay Zaaridi,</para>
  <para style="q1" vid="HEB 1:10">“Godaw, koyro neeni sa7a medhadasa;</para>
  <para style="q2" vid="HEB 1:10">saloti ne kushe ooso.<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="PSA 102:25-27">Maz 102:25-27</ref>.</char></note><verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />Hessati ubbay dhayana;</para>
  <para style="q2" vid="HEB 1:11">shin neeni daana.</para>
  <para style="q2" vid="HEB 1:11">Enti ubbay afilada wurana.<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />Neeni enta saleenada xaaxana;</para>
  <para style="q2" vid="HEB 1:12">qassi enti afilada laametana.</para>
  <para style="q1" vid="HEB 1:12">Shin neeni ubba wode nena;</para>
  <para style="q2" vid="HEB 1:12">ne laythayka wurenna”</para>
  <para style="m" vid="HEB 1:12">yaagees. <verse eid="HEB 1:12" /><verse number="13" style="v" sid="HEB 1:13" />Shin Xoossay kiitanchotape oodeko,</para>
  <para style="q1" vid="HEB 1:13">“Taani ne morketa ne tohoy</para>
  <para style="q2" vid="HEB 1:13">yedhiyaso oothana gakanaw,</para>
  <para style="q2" vid="HEB 1:13">haysan taape ushacha baggan utta” gidee?<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz 110:1</ref>.</char></note><verse eid="HEB 1:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="HEB 1:14" />Kiitanchoti ubbay atotethi demmanaw de7iya asata maaddanaw Xoossay kiitida ayyaanata gidokonaayee?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s1">Gita Anjo</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />Hessa gisho, nuuni si7ida tumaape haraso eketonna mela he si7idaysa minthidi naaganaw bessees. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />Hiza, kiitanchota baggara odetida qaalay tuma gidiko, iya naaqoynne kiitetonna ixoy pirda ehiyaba gidiko, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />yaatin, nuuni haysa mela gita atotetha ixas giiko, waanidi attanee? Koyro Goday ba huuphen he atotetha odis; qassi iyape si7idaysati nuus geeshshidi markatidosona. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />Qassi Xoossay malaatatan, oorathabatan, dumma dumma mallataninne ba sheniyada immida Geeshsha Ayyaana imotatan markatethaa minthis.<verse eid="HEB 2:4" /></para>
  <para style="s1">Yesuusi Ase Gidis</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />Xoossay ha nuuni odiya sinthafe yaana alamiya, kiitanchotas haarisibeenna. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />Geeshsha Maxaafay issi bessan haysada yaagees:</para>
  <para style="q1" vid="HEB 2:6">“Neeni asas qopanaw asi aybee?</para>
  <para style="q2" vid="HEB 2:6">Woyko neeni iya naaganaw I aybee?<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="PSA 8:4-6">Maz 8:4-6</ref>.</char></note><verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />Ne iya kiitanchotape guutha wodes guuthadasa;</para>
  <para style="q2" vid="HEB 2:7">Iya huuphen bonchonne saba kallacha wothadasa.<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />Qassi ubbaba iya tohuwape garsan wothadasa”</para>
  <para style="m" vid="HEB 2:8">yaagees. Xoossay ubbaba iyaw haarisiya wode iyaw haaretiboonabay aybika baawa. Shin ha77i ubbabay iyaw haaretishin nuuni be7ibooko. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />Shin nuuni kiitanchotape guuthara guuxida Yesuusa be7oos. Xoossaa aadho keehatetha gaason Yesuusi asa ubbaas hayqis. I waaye hayqo hayqida gisho, bonchonne saba kallacha iya huuphen wothis. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />Ubbabay iyawunne iya gaason medhetida Xoossay, daro nayta baara bonchisanaw enta atotetha huuphiya, Yesuusa waayen polo oothanaw iyaw bessees.<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />Yesuusinne he I geeshshida asa ubbay issi aawa nayta. Yesuusi enta, “Ta ishata” gidi xeeganaw yeellatonnay hessasa. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />Yesuusi,</para>
  <para style="q1" vid="HEB 2:12">“Taani ne sunthaa ta ishatas awaajana;</para>
  <para style="q2" vid="HEB 2:12">deriya shiiquwan nena galatana”</para>
  <para style="m" vid="HEB 2:12">yaagees.<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="PSA 22:22">Maz 22:22</ref>.</char></note> <verse eid="HEB 2:12" /><verse number="13" style="v" sid="HEB 2:13" />Qassi I, “Taani ta ammanuwa iya bolla wothana” Qassika, “Xoossay taw immida naytara ta haysan de7ayis” yaagees.<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="ISA 8:17-18">Isa 8:17-18</ref>.</char></note><verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />Nayti ashoynne suuthi de7eyisata gidiya gisho, Yesuusika entada ase gidis. I hessa oothiday, hayqo bolla wolqi de7iya Xalahiya ba hayquwan dhaysanaasa. <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />Qassi banta de7o laytha ubban hayqo yashshan aylletidi de7eyisata aylletethaafe wozanaasa.<verse eid="HEB 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 2:16" />Tuma Yesuusi yiday Abrahaame koche maaddanaasafe attishin, kiitanchota maaddanaasa gidenna.<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 41:8-9">Isa 41:8-9</ref>.</char></note> <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />Asaa nagaray atto geetetana mela Xoossaa sinthan maariyanne ammanetida kahine halaqa gidis. Hessa gisho, I ubbaban ba ishata daananaw bessees. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />I ba huuphen paacen waayetida gisho paaceteyisata maaddanaw danda7ees.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s1">Yesuusi Musepe Bolla</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />Hessa gisho, Xoossay xeegida geeshsha ishato, nu ammanon Godaa gidi xeegiya hawaariyanne kahine halaqaa Yesuusa be7ite. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />Musey Xoossaa Keetha ubban ammanetidaysada Yesuusika bana doorida Xoossaas ammanetidaysa. <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />Keethe keexeysi keethafe aadhidi boncheteysada Yesuusi Musepe aadhiya boncho ekanaw bessees. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />Issi issi keethaa keexida asi de7ees, shin ubbaa giigisiday Xoossaa. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />Musey Xoossaa Keetha ubban ammanetida aylle gididi, Xoossay sinthafe gaanabas marka gidis. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />Shin Kiristoosi xoossa keethan na7ada ammanetidaysa. Nuuni ekana gidi naagiya ufaysaa minthidi naagiko Xoossaa keethi gidoos.<verse eid="HEB 3:6" /></para>
  <para style="s1">Xoossa Asas De7iya Shempo</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />Hessa gisho, Geeshsha Ayyaanay geysada,</para>
  <para style="q1" vid="HEB 3:7">“Hachi hinte Xoossay geysa si7iya wode,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />mela biittan paaciya gallas,</para>
  <para style="q2" vid="HEB 3:8">hinte aawati makallidaysada,</para>
  <para style="q2" vid="HEB 3:8">hinte wozanaa minthofite.<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />Hinte aawati tana paacidosona;</para>
  <para style="q2" vid="HEB 3:9">oytamu laythi ta oosuwa be7idosona.<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />Hessa gisho, ta he yeletethaa hanqetada,</para>
  <para style="q2" vid="HEB 3:10">‘Enti ubba wode banta wozanan baloosona;</para>
  <para style="q2" vid="HEB 3:10">ta ogiya eribookona’ yaagas.<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />Hessa gisho, taani ta hanquwan caaqada,</para>
  <para style="q2" vid="HEB 3:11">‘Ta shempo bessaa ubbaka gelokona’ yaagas”<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="PSA 95:7-11">Maz 95:7-11</ref>.</char></note></para>
  <para style="m" vid="HEB 3:11">yaagees.<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />Ta ishato, hintefe oodenka, de7o Xoossaafe hintena shaakiya iitanne ammanonna wozani doonna mela naagetite. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />Hintefe oonaka nagari balethin, ba wozanaa minthonna mela “Hachi” yaagetidi xeegetishin gallas gallas issoy issuwara zoretite. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />Nu koyro ammanuwa nuuni wursethi gakanaw minthidi naagiko, Kiristoosara issife laattana. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />Geeshsha Maxaafan,</para>
  <para style="q1" vid="HEB 3:15">“Hachi Xoossay geysa hinte si7iya wode,</para>
  <para style="q2" vid="HEB 3:15">he wode enti makallatethan hanidaysada,</para>
  <para style="q2" vid="HEB 3:15">hinte wozanaa minthofite”</para>
  <para style="m" vid="HEB 3:15">yaagis.<note caller="-" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">Maz 95:7-8</ref>.</char></note><verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />Xoossay giyaba si7idi makalliday oonee? Musey Gibxefe kaalethi kessida ubbaa gidokonaayee?<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="NUM 14:1-35">Taybo 14:1-35</ref>.</char></note> <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />Xoossay oytamu laythi oona hanqetidee? Nagara oothidaysatanne enta ahay mela biittan wodhi attida asata gidokonaayee? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />Qassi Xoossay, “Ta shempo bessaa geleketa” yaagidi caaqiday, iyaw kiitetonna ixida asaape attishin, oodesee? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />Hiza, enti he shempo bessaa gelonna attiday ammanibona gisho, gideysa nu be7oos.<verse eid="HEB 3:19" /></para>
  <para style="b" />
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />Hiza, Xoossay nuna ba shempo bessaa gelsana gida qaalay buroo sinthafe de7iya gisho, hintefe oonika he shempo bessaa gelonna attonna mela naagetoos. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />Entaw Wongelay sabbaketidaysada, nuuska sabbaketis. Shin enti si7idaba ammanidi ekiboonna gisho enta go77ibeenna. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />Gidoshin, alamey medhetoosape doomidi Xoossaa oosoy poletidaysa gidikoka, Xoossay,</para>
  <para style="q1" vid="HEB 4:3">“Taani ta hanquwan caaqada,</para>
  <para style="q2" vid="HEB 4:3">ta shempo bessaa ubbaka gelokona”</para>
  <para style="m" vid="HEB 4:3">gidaysada, nuuni ammanidaysati iya shempo bessaa gelana.<note caller="-" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="PSA 95:11">Maz 95:11</ref>.</char></note> <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />Laapuntha gallasaaba issi bessan, “Xoossay laapuntha gallasan ba ooso ubbaafe shempis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="GEN 2:2">Medhe 2:2</ref>.</char></note> <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />Qassika he bessan, “Enti ta shempo bessaa ubbaraka gelokona” yaagis.<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="PSA 95:11">Maz 95:11</ref>.</char></note> <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />Koyro Wongela si7idaysati kiitetonna ixidi shempo bessaa gelibookona. Yaaniya gisho, ha77ika he shempo bessaa gelana issi issi asati de7oosona. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />Hessa gisho, Xoossay, “Hachi” gidi xeegishe issi gallas nuus qanxis. Daro wodepe guye Xoossay Dawita baggara,</para>
  <para style="q1" vid="HEB 4:7">“Xoossay giyaba hachi hinte si7iya wode,</para>
  <para style="q2" vid="HEB 4:7">hinte wozanaa minthofite”</para>
  <para style="m" vid="HEB 4:7">yaagidi odis.<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="PSA 95:7-8">Maz 95:7-8</ref>.</char></note> <verse eid="HEB 4:7" /><verse number="8" style="v" sid="HEB 4:8" />Iyyasuy entaw shempuwa immidaba gidiyako, Xoossay hara gallasaba guyepe odennashin.<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="DEU 31:7">Zaare 31:7</ref>; <ref loc="JOS 22:4">Iyya 22:4</ref>.</char></note> <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />Hiza, Xoossaa asaas Sambaata shempoy naagetidi de7ees. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />Xoossaa shempo bessaa geliya oonika, Xoossay ba oosuwape shempidaysada ika ba oosuwape shempana.<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="GEN 2:2">Medhe 2:2</ref>.</char></note> <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />Hessa gisho, oonika he asaa kiitetetha ixuwa kaallidi, kundonaada Xoossaa shempo bessaa gelanaw minnoos.<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />Xoossaa qaalay de7onne ootheysa. Nam7u baggara qaratida mashshafeka aadhidi oco. I shempo, ayyaana, xaphonne kolize gakanaw kanthidi caddees. Qassi asa wozanan de7iya geemmida qofaanne amuwa shaakidi pirdees. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />Xoossaa sinthafe qosetiyabay ayba medhetethika baawa. Iya ayfe sinthan ubbabay qoncenne kallo de7ees. Nuuni zaaro immanaw bessey iya sinthana.<verse eid="HEB 4:13" /></para>
  <para style="s1">Yesuusi Gita Kahine Halaqa</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />Hiza, salo keyida gita kahine halaqay, Xoossaa na7ay Yesuusi, nuus de7iya gisho, nu ammanuwa minthidi naagoos. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />Nu kahine halaqay nu daaburiya wode nuus qadhetanaw danda7eysa. I nuuda ubbaban paacetisipe attishin, nagara oothibeenna. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />Hiza, maarotethaa ekanawunne maade koshshiya wode aadho keehatetha demmanaw aadho keehatethay de7iyasuwa Xoossaa araatako yayyonna shiiqoos.<verse eid="HEB 4:16" /></para>
  <para style="b" />
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />Issi issi kahine halaqi asaa giddofe dooretidi, Xoossara gathiyaban asaa gisho imotanne nagara yarsho yarshanaw shuumetees. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />I ba huuphen daaburancho gidiya gisho, eronnaysatasinne baleysatas qadhetanaw danda7ees. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />I ba nagara gishonne asa ubbaa nagara gisho yarsho yarshanaw bessey hessasa.<note caller="-" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="LEV 9:7">Leewe 9:7</ref>.</char></note><verse eid="HEB 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 5:4" />Oonika ha bonchuwa baw ekanaw danda7enna, shin Aaroni kahine halaqa gidanaw xeegidaysada Xoossan xeegetanaw bessees.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="EXO 28:1">Kessa 28:1</ref>.</char></note> <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />Hessadaka, Kiristoosi kahine halaqa gidiya bonchuwa baw ekibeenna. Shin Xoossay iya,</para>
  <para style="q1" vid="HEB 5:5">“Neeni ta Na7a;</para>
  <para style="q2" vid="HEB 5:5">hachi ta new Aawa gidas”</para>
  <para style="m" vid="HEB 5:5">yaagees.<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 2:7">Maz 2:7</ref>.</char></note> <verse eid="HEB 5:5" /><verse number="6" style="v" sid="HEB 5:6" />Qassi harason,</para>
  <para style="q1" vid="HEB 5:6">“Malkexaadeqi kahine gididaysada,</para>
  <para style="q2" vid="HEB 5:6">neeni merinaw kahine gidana”</para>
  <para style="m" vid="HEB 5:6">yaagees.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Maz 110:4</ref>.</char></note><verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />Yesuusi ase gididi ha alamiyan de7iya wode bana hayqope ashshanaw danda7iya Xoossaa daro yeehoninne afuthan woossis. I, iya bonchidi kiitetida gisho Xoossay iya woosa si7is.<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="MAT 26:36-46">Maato 26:36-46</ref>; <ref loc="MRK 14:32-42">Mar 14:32-42</ref>; <ref loc="LUK 22:39-46">Luqa 22:39-46</ref>.</char></note> <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />Yesuusi Xoossaa Na7a gidikoka ba waayetida waayan kiitetethi tamaaris. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />Hessanka, Yesuusi ba oosuwa polidaape guye baw kiitetiya ubbay merinaa atotetha demmana mela gaaso gidis. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />Xoossay Malkexaadeqa shuumidaysada kahine halaqa oothidi iya shuumis.<verse eid="HEB 5:10" /></para>
  <para style="s1">Hinte Ammanuwan Daaburopite</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />Ha nu oda bolla guji odanabay darobay de7ees, shin hinte akeekay guutha gidiya gisho hintew odi gelsanaw waaysees. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" />Hinte hannoode astamaare gidanaw bessees, shin Xoossaa qaala koyro timirtiya hintena zaari tamaarsiya hara asi koshshees. Hinte mino kathi maanaw danda7onna gisho maathi koshshees.<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CO 3:2">2 Qoro 3:2</ref>.</char></note> <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />Maathi paahetiya oonika yooga na7a gidiya gisho, lo77onne iita shaaki erenna. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />Shin mino kathi lo77onne iita shaaki eriya kahaama asaasa.<verse eid="HEB 5:14" /></para>
  <para style="b" />
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />Hiza, Kiristoosaba tamaarsiya koyro timirtiya aggidi Kiristoosan kahaamatethako boos. Hayqo oosope simobaanne Xoossaa ammanoba koyro timirtiyako guye simmoko. <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />Hessadaka, xinqatetaba,<note caller="+" style="f"><char style="fr" closed="false">6:2 </char><char style="fqa" closed="false">Xinqatetaba: </char><char style="ft" closed="false">Ha bessan xinqatetaba geetetiday dumma dumma geeshsho wogataba odanaasa.</char></note> kushe wosobaa, hayqope dendobaanne merina pirdaba zaari tamaaroko. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />Xoossay giiko nu hessa oothana.<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />Issi toho poo7oy poo7idaysata, salo imota ekidaysata, Geeshsha Ayyaanan shaaketidaysata, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />lo77o Xoossaa qaalanne sinthafe yaana alamiya wolqaa be7idaysata, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />guyepe kaddidaysata nagaraape nam7antho zaaranaw danda7etenna. Ayis giiko, enti banta dhayuwas Xoossaa Na7aa zaari kaqiya mela masqaliya bolla iya kaqosonanne asa sinthan kawushoosona.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />Ubba wode I bolla bukiya ira uyada, goyida uraa maaddiya kathi immiya biittiya Xoossan anjetidaaro. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />Shin agunthinne kinchote doliya biittiya aybibaaka maadduku; iw baadethay matatis; wursethan xuugetana.<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="GEN 3:17-18">Medhe 3:17-18</ref>.</char></note><verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />Nu siiqo ishato, nuuni haysada odiyaba gidikoka, hintena atotethako kaalethiya lo77obay hintew de7eysa eroos. <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />Xoossay suure pirdeysa. Xoossay, hinte oothida oosuwanne kase gidin ha77ika ammaneyisata maaddidi, iyaw de7iya siiquwa bessidaysa dogenna. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />Hinte ubbay ufaysan naageysa demmana gakanaw ha minotethaa wursethi gakanaw bessaana mela nu amottoos. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />Hinte ammanoninne danda7an naagiya ufaysaa laattiya asaa daanana melape attishin, azalla gidana mela koyoko.<verse eid="HEB 6:12" /></para>
  <para style="s1">Xoossa Ufaysa Qaalay Sidhisena</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />Xoossay Abrahaames immana gidi caaqida wode baape aadhiya hari giti bayna gisho ba huuphen caaqis. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />Iyako, “Taani nena anjana; ne zerethaaka darsana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="GEN 22:16-17">Medhe 22:16-17</ref>.</char></note> <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />Abrahaamey danda7an naagidi Xoossay immana gida ufaysaa ekis.<verse eid="HEB 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 6:16" />Asi caaqishe baape gitatiya uran caaqees; he caaqoy geetetidaba minthidi, palama ubbaa teqees. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />Hessa gisho, Xoossay ba laametonna qofaa ufaysa qaala laatteysatas qoncisanaw koyida gisho caaqon minthis. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />Xoossay wordotenna. Iya ufaysa qaalaynne caaqoy, nam7ayka laametokona. Ha nam7ubatan nu sinthan de7iya ufaysaa oykanaw danda7ana mela geshe demmanaw iyako baqatida nuuni, wolqaama minthetho demmana.<verse eid="HEB 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 6:19" />Ha ufaysay nu shempuwa, markabey qaaxonnaada minthi oykiya birata mela. He ufaysay magarajuwafe guye baggan de7iya geeshsha bessaa gelis.<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="LEV 16:2">Leewe 16:2</ref>.</char></note> <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />Yesuusi Malkexaadeqa shuumatethaada merinaw kahine halaqa gididi, nu gisho nuupe sinthatidi he bessaa gelis.<note caller="-" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Maz 110:4</ref>.</char></note><verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s1">Kahiniya Malkexaadeqa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />Malkexaadeqey, Saleema Kawoy, Ubbaafe Bolla Xoossaa kahine. He Malkexaadeqi Abrahaamey kawota oli xoonidi simmishin iyara gahetidi iya anjis.<note caller="-" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="GEN 14:17-20">Medhe 14:17-20</ref>.</char></note> <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />Abrahaamey ba di77idaba ubbaafe iyaw asraata kessidi immis. Malkexaadeqa sunthay koyro “Xillotethaa kawa”, nam7antho, “Saleema kawo” birshethayka “Sarotethaa kawa” guussu. <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />Malkexaadeqas aayiya woyko aawu woyko kocha paydoy baawa. Iya yeletethaas doomethi woyko iya de7uwas wursethi baawa, shin Xoossaa Na7a daanidi merinaw kahine gidis.<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />Malkexaadeqi ay mela giteeko be7ite. Nu aawata mayzay, Abrahaamey, ba de77idabaape iyaw asraata immis. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />Kahine gidiya Leewe kochay Isra7eele asape, hessika Abrahaame koche gidida banta ishatape asraata ekana mela higgey kiittees.<note caller="-" style="x"><char style="xo" closed="false">7:5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">Taybo 18:21</ref>.</char></note> <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />Malkexaadeqi Leewe koche gidonna ixikoka Abrahaamepe asraata ekis; ufaysa qaali de7iya Abrahaame anjis. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />Guuthay gitan anjeteysi palanthenna.<verse eid="HEB 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 7:8" />Issi baggara, asraata ekeysati hayqiya asata, shin hara baggara asraata ekeysi de7on de7ees yaagidi odetidaysa. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />Hiza, asraata ekiya Leewey, Abrahaame baggara asraata immis gaanaw danda7etees. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />Ayis giiko, Malkexaadeqi Abrahaamera gahetiya wode Leewey yeletiboonnaba gidikoka, ba mayza Abrahaame gulbatan de7ees.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />Isra7eele asaas higgey Leewe kahinetetha baggara imetis. Ha Leewe kahinetethay polo gididaba gidiyako Aaronaysa mela gidonashin, Malkexaadeqa mela hara kahine shuumanaw ayis koshshidee? <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />Hiza, kahineti laametiya wode higgeyka qassi laametanaw bessees. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />Ha nu iyabaa odiya uray hara koche; iya sheeshape oonika yarsho bessan kahinetethan oothibeenna. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />Nu Goday Yihuda sheeshape yidaysi eretidaysa. Gidoshin, Musey kahineteba odishe Yihuda kochaaba aybaka odibeenna.<verse eid="HEB 7:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />Malkexaadeqa mela hara kahiney yidaba gidiyako ha nu odiyabay aadhidi qoncana. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />I kahine gididay dhayonna de7o wolqanaape attishin, ba mayzaa wogaaninne higgen gidenna. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />Geeshsha Maxaafay,</para>
  <para style="q1" vid="HEB 7:17">“Malkexaadeqa kahinetetha mela,</para>
  <para style="q2" vid="HEB 7:17">neeni merinaw kahine”</para>
  <para style="m" vid="HEB 7:17">yaagidi markatees.<note caller="-" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Maz 110:4</ref>.</char></note> <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />Koyro higgey daaburanchonne maaddonnaba gidiya gisho shaaretis. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />Muse higgey aybinka polo oothanaw danda7ibeenna. Shin nuuni iya baggara Xoossaako shiiqiya ubbaafe aadhiya ufaysa qaalay nuus imetis.<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />Kiristoosi kahine gidiya wode Xoossay caaqis, shin harati kahine gidida wode hessa mela caaqoy baawa. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />Shin Yesuusi caaqon kahine gidis. Xoossay yaagidi caaqis;</para>
  <para style="q1" vid="HEB 7:21">“Goday caaqis; I ba qofaa laammenna;</para>
  <para style="q2" vid="HEB 7:21">‘Neeni merinaa kahine’ ”</para>
  <para style="m" vid="HEB 7:21">yaagis.<note caller="-" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="PSA 110:4">Maz 110:4</ref>.</char></note> <verse eid="HEB 7:21" /><verse number="22" style="v" sid="HEB 7:22" />Ha caaquwa gaason Yesuusi nuus ubbaafe aadhiya qaala caaquwas waase gidis.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />Kahinetethan oothonna mela hayqoy enta diggida gisho koyro kahineta tayboy daro. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />Shin Yesuusi merinaw de7iya gisho iya kahinetetha hari laattenna. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />Hessa gisho, I ubba wode enta gisho gaannatanaw merinaw de7iya gisho Xoossaako iya baggara yeyisata polo ashshanaw danda7ees.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />Hiza, nuus koshshiyaba immiya, geeshshay, boreynne tuni baynaysi, nagaranchotape shaaketidaysinne saluwape aadhidi dhoqida kahine halaqay nuus koshshees. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />I hanko kahine halaqata mela koyro ba nagara gisho, kaallidi asaa nagaraa gisho gallas gallas yarsho yarshanaw koshshenna. I bana yarshida wode zaarethonna ogen issi toho bana yarshis.<note caller="-" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="LEV 9:7">Leewe 9:7</ref>.</char></note> <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />Muse higgey daaburancho asaa kahine halaqa oothidi shuumees. Shin higgiyafe guye yida caaqo qaalay merinaw polo gidida Xoossaa Na7aa shuumis.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s1">Yesuusi Nu Kahine Halaqa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />Nuuni haasaya gitabay hessa. Saluwan Ubbaafe Bolla Xoossaa araatape ushacha baggan uttida haysa mela kahine halaqay nuus de7ees.<note caller="-" style="x"><char style="xo" closed="false">8:1 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz 110:1</ref>.</char></note> <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />I asan gidonashin, Godan eqida tuma dunkaaniyan xoossa keethan oothees.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />Kahine halaqa ubbay imonne yarsho yarshanaw shuumetees. Hessa gisho, ha kahiney yarshanaw issibay daanaw koshshees. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />Higgey kiiteysada yarshiya kahineti de7iya gisho, Kiristoosi sa7an de7iyaba gidiyako I kahine gidenna. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />Enti kahinetethan oothiya dunkaaney salon de7eysas leemisonne kuya. Musey dunkaaniya essiya wode Xoossay iyako, “Taani nena zumaa bolla bessida leemisuwa kaallada ootha” yaagis.<note caller="-" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="NUM 18:21">Taybo 18:21</ref>.</char></note> <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />Shin Yesuusi giddo gididi sigethiya caaqoy, koyro caaquwape aadheysada I ekida oosoy entaysafe aadhees. Hessi eqiday aadhiya caaqo qaalana.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />Koyro caaquwan bali baynaba gidiyako nam7antho caaqo koshshenna. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />Shin Goday enta boridi, haysada yaagis:</para>
  <para style="q1" vid="HEB 8:8">“Taani Isra7eele asaaranne Yihuda asaara</para>
  <para style="q2" vid="HEB 8:8">ooratha caaqo caaqiya wodey yaana.<note caller="-" style="x"><char style="xo" closed="false">8:8 </char><char style="xt" closed="false"><ref loc="JER 31:31-34">Ermi 31:31-34</ref>.</char></note><verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />He caaqoy ta enta aawata Gibxe biittafe kushiya oykada,</para>
  <para style="q2" vid="HEB 8:9">goocha kessida wode entara caaqida caaquwa mela gidenna.</para>
  <para style="q1" vid="HEB 8:9">Enti ta caaquwan ammanetibona gisho,</para>
  <para style="q2" vid="HEB 8:9">taani enta yegga aggas yaagees Goday.<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />Shin hizape guye Isra7eele asaara</para>
  <para style="q2" vid="HEB 8:10">ta caaqana caaqoy haysa yaagees Goday.</para>
  <para style="q1" vid="HEB 8:10">Taani ta higgiya enta guuggiyan wothana;</para>
  <para style="q2" vid="HEB 8:10">enta wozanan xaafana.</para>
  <para style="q1" vid="HEB 8:10">Taani enta Xoossaa gidana;</para>
  <para style="q2" vid="HEB 8:10">entika ta ase gidana.<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />Entafe oonika ba shooruwa woyko ba ishaa,</para>
  <para style="q2" vid="HEB 8:11">‘Godaa era’ yaagidi tamaarsenna.</para>
  <para style="q1" vid="HEB 8:11">Enti guuthafe gita gakanaw</para>
  <para style="q2" vid="HEB 8:11">ubbay tana erana.<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />Taani enta naaquwa atto gaana;</para>
  <para style="q2" vid="HEB 8:12">enta nagaraa zaara qopike” yaagees.<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />Xoossay ha caaquwa “Oorathi” gidi xeegishe koyroysa gal7isis. Hiza, gal7aynne ceegay dhayiya wodey gakis.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s1">Sa7a Xoossa Keethan De7iya Goyinno</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />Koyro caaquwas Xoossaa goyinniya wogaynne sa7a Xoossa Keethay de7ees. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />Dunkaaney eqis. Iyan xompe wothiya kocay, xarpheezaynne Godaa sinthan wothiya uythay de7ees; he bessay Geeshsha Bessaa geetetees.<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="EXO 26:1-30">Kessa 26:1-30</ref>; <ref loc="EXO 25:31-40">25:31-40</ref>.</char></note> <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />Nam7antho magarajuwafe guye baggara de7iya bessay Ubbaafe Geeshsha Bessaa geetetees.<note caller="-" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">Kessa 26:31-33</ref>.</char></note> <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />Iya giddon ixaane cuyisiya worqa saaxineynne worqan meeshetida caaqo Taabotey de7ees. He caaqo Taabotiyan mannay de7iya worqa xaaroy, aacida Aarona xam7aynne Muse higgey xaafetida nam7u loche shuchati de7oosona.<note caller="-" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="EXO 30:1-6">Kessa 30:1-6</ref>; <ref loc="EXO 25:10-16">25:10-16</ref>; <ref loc="EXO 16:33">16:33</ref>; <ref loc="NUM 17:8-10">Taybo 17:8-10</ref>; <ref loc="EXO 25:16">Kessa 25:16</ref>; <ref loc="DEU 10:3-5">Zaare 10:3-5</ref>.</char></note> <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />He Taabotiyape bolla baggara atotetha kamaa banta qefiyan genthiya boncho kiruubeti de7oosona. Shin ha77i he ubbaa qoncisidi odanaw danda7oko.<note caller="-" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="EXO 25:18-22">Kessa 25:18-22</ref>.</char></note><verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />Ha ubbay haysada giigidaape guye, kahineti ubba wode banta oosuwa oothanaw dunkaaniyas koyro kifiliya geloosona.<note caller="-" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="NUM 18:2-6">Taybo 18:2-6</ref>.</char></note> <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />Shin kahine halaqaa xalaali dunkaaniyas nam7antho kifiliya laythafe issi toho gelees. I yaa gelishe ba nagaraa gishonne asay eronna oothida nagaraa gisho suutha yarsho ekonna gelenna.<note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="LEV 16:2-34">Leewe 16:2-34</ref>.</char></note> <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />Koyro dunkaaney eqidi de7ishin, Ubbaafe Geeshsha Bessaa efiya ogey buroo dooyetiboonaysa Geeshsha Ayyaanay hessan erisees.<verse eid="HEB 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 9:9" />Hessi ha wodiyas leemiso; Xoossas imetiya imoynne yarshoy goyinniya uraa kaha geeshshanaw danda7onaysa haysi bessees. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />Hessati muussaba, ushshabaanne dumma dumma meecha wogata odeyisata. Enti ooratha wogay yaana gakanaw oosetiya kare bagga wogata.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />Shin Kiristoosi ha77i nu demmida lo77obatas kahine halaqa gididi yis. I gelida dunkaaney gitanne polo gididaysa. He dunkaaney asa kushen oosetibeenna qassi ha alamiyaba gidenna. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />Kiristoosi Ubbaafe Geeshsha Bessaa geliya wode deesha suuthinne mari suuthi ekidi gelibeenna. Shin merinaa atotetha immanaw ba suuthaa ekidi zaarethonna ogen issi toho gelis. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />Deesha suuthaynne korma suuthay, xuugetida ussa bidoy, tunida asaa bolla dharcetidi entana geeshshiyaba gidiko,<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="LEV 16:15-16">Leewe 16:15-16</ref>; <ref loc="NUM 19:9">Taybo 19:9</ref>, <ref loc="NUM 19:17-19">17-19</ref>.</char></note> <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />merinaa Geeshsha Ayyaana baggara borey bayna yarsho oothidi, Xoossaas bana immida Kiristoosa suuthay, de7o Xoossaa goyinnana mela hayqo kaalethiya oosuwape nu kaha waati aathidi geeshshennee?<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />Hessa gisho, xeegetidaysati Xoossay immida merinaa laata ekana mela Kiristoosi ooratha caaquwas giddo gididi sigetheysa gidis. Hessi haniday asay koyro caaquwape garsan de7iya wode oothida nagaraape entana wozanaw I hayqidaysana.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />Hiza, keekey de7iko, he keekida uraa hayqoy eretanaw koshshees. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />Keekida uray hayqiko iya keekey minnees. Keekida uray hayqonna attiko iya keekey oothenna.<verse eid="HEB 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 9:18" />Hari attoshin, koyro caaqoyka suuthi bayna minnibeenna. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />Musey higge kiita ubbaa asaas odidaape guye mara suuthinne deesha suuthi haathara walakidi, zo7o dorsa ikisenne hisoophe wurco ekidi, maxaafaa bollanne asaa bolla wurxis.<note caller="-" style="x"><char style="xo" closed="false">9:19 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">Kessa 24:6-8</ref>.</char></note> <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />Musey asaako, “Hinte naagana mela Xoossay kiitida suutha caaqoy haysa” yaagis. <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />Hessadaka, dunkaaniya bollanne oothiya miishe ubbaa bolla suuthaa wurxis.<note caller="-" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LEV 8:15">Leewe 8:15</ref>.</char></note> <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />Tumaka higgey geysada guuthabatape attishin, ubbabay suuthan geeyees. Suuthi gukonnashin atotethi baawa.<note caller="-" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="LEV 17:11">Leewe 17:11</ref>.</char></note><verse eid="HEB 9:22" /></para>
  <para style="s1">Yesuusi Polo Yarshetis</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />Saluwabaas leemiso gididaysati ubbay mehe yarshon geeyanaw koshshees. Shin salobati banta huuphen hessafe aadhiya yarshuwan geeyanaw koshshees.<verse eid="HEB 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 9:24" />Kiristoosi tuma Xoossa keethaas leemiso gidida, asa kushen oosetida Ubbaafe Geeshsha Bessaa gelibeenna. Shin I ha77i nu gisho, Xoossaa sinthan bentanaw saluwa gelis. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />Kahine halaqay laythan laythan ba suuthi gidonnaysa ekidi, Ubbaafe Geeshsha Bessa gelees. Shin Kiristoosi daro toho bana yarshanaw salo gelibeenna. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />Hessada hanidaba gidiyako, Kiristoosi alamey medhetoosape doomidi daro toho waayetanaw koshshees. Shin ha77i wodiya wursethan nagara digganaw bana yarshidi zaarethonna ogen issi toho bentis.<verse eid="HEB 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 9:27" />Asi ubbay issi toho hayqanaw hessafe guye pirdetanaw bessees. <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />Hessadaka, Kiristoosi daro asaa nagara digganaw issi toho yarshetis. Shin I nagara tookanaw gidonashin, bana naageysata ashshanaw nam7antho qoncana.<note caller="-" style="x"><char style="xo" closed="false">9:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">Isa 53:12</ref>.</char></note><verse eid="HEB 9:28" /></para>
  <para style="b" />
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />Muse higgey yaanaw de7iya lo77obatas kuyape attishin, ba huuphen waanna gidenna. Hessa gisho, laythan laythan pacey bayna yarshetiya yarshoy goyinnanaw shiiqiya asaa polo oothanaw danda7enna. <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />Higgey enta polo oothanaw danda7idaba gidiyako enti yarsho yarsheysa agganashin. Qassi goyinnanaw shiiqiya asay banta nagaraape geeyana; enta kahayka entana bala gidi mootenna. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />Shin he yarshoti laythan laythan nagara qofisoosona. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />Ayis giiko, korma suuthinne deesha suuthi nagara digganaw danda7enna.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />Hessa gisho, Kiristoosi ha alamiya yida wode haysada yaagis:<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="PSA 40:6-8">Maz 40:6-8</ref>.</char></note></para>
  <para style="q1" vid="HEB 10:5">“Neeni yarshonne imo koyabaaka;</para>
  <para style="q2" vid="HEB 10:5">shin taw asho giigisadasa.<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />Neeni xuussa yarshoninne</para>
  <para style="q2" vid="HEB 10:6">nagara yarshon ufaytabaaka.<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />He wode, ‘Ta gisho maxaafan xaafetidaysada,</para>
  <para style="q2" vid="HEB 10:7">Godaw, taani ne sheniya oothanaw yas’ yaagas”</para>
  <para style="m" vid="HEB 10:7">yaagis. <verse eid="HEB 10:7" /><verse number="8" style="v" sid="HEB 10:8" />Yarshoy yarshetana mela higgey kiittiyaba gidikoka, Kiristoosi koyro, “Neeni yarshonne imo, xuussa yarshonne nagara yarsho koyabaaka; entan ufaytabaaka” yaagis. <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />Kaallidika I, “Godaw, Heko taani ne sheniya oothanaw yas” yaagis. Hessa gisho, Kiristoosi nam7anthuwa essanaw koyroysa shaaris. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />Yesuus Kiristoosi Xoossaa sheniya oothidi, zaarethonna ogen issi toho ba ashuwa yarshida gisho nuuni geeyida.<verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />Kahine ubbay, nagara digganaw danda7onna he yarshota gallas gallas yarshishe eqidi ba oosuwa oothees.<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="EXO 29:38">Kessa 29:38</ref>.</char></note> <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />Shin Kiristoosi ubba wodes gidiya issi nagara yarshuwa yarshidi, Xoossaafe ushacha baggan uttis.<note caller="-" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz 110:1</ref>.</char></note> <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />He wodiyape doomidi iya morketi iya tohoy yedhiyabaa oothana gakanaw naagees. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />I zaarethonna ogen issi toho bana yarshida yarshuwan geeshshata merinaw polo oothis.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />Qassi Geeshsha Ayyaanay nuus haysa markatees. Koyro haysada yaagis:<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“He gallasatape guye,</para>
  <para style="q2" vid="HEB 10:16">taani entara caaqiya caaqoy haysa:</para>
  <para style="q1" vid="HEB 10:16">Taani ta higgiya enta qofan wothana;</para>
  <para style="q2" vid="HEB 10:16">enta wozanan xaafana”</para>
  <para style="m" vid="HEB 10:16">yaagees.<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="JER 31:33">Ermi 31:33</ref>.</char></note> <verse eid="HEB 10:16" /><verse number="17" style="v" sid="HEB 10:17" />Kaallidika,</para>
  <para style="q1" vid="HEB 10:17">“Taani enta nagaraanne</para>
  <para style="q2" vid="HEB 10:17">enta iita oosuwa zaara qopike”</para>
  <para style="m" vid="HEB 10:17">yaagees.<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="JER 31:34">Ermi 31:34</ref>.</char></note> <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />Hiza, nagari atto geetetidaape guye nagaras yarshetiya yarsho koshshenna.<verse eid="HEB 10:18" /></para>
  <para style="s1">Ane Xoossako Shiiqoos</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />Hiza, ta ishato, nuuni Yesuusa suuthaa baggara Ubbaafe Geeshsha Bessaa gelanaw nuus minotethi de7ees. <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />Nu gelanay Kiristoosi ba magarajuwa, hessika ba ashuwa baggara nuus dooyida oorathinne de7o gidida ogiyana. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />Nuus Xoossa Keetha bolla shuumetida gita kahine halaqay de7ees. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />Nuuni iita kahape geeyanaw nu wozanaa wurxetidi, nu asatethaa xillo haathan meecetidi, suure wozananinne polo ammanon Xoossaako shiiqoos.<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="LEV 8:30">Leewe 8:30</ref>; <ref loc="EZK 36:25">Hiz 36:25</ref>.</char></note><verse eid="HEB 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 10:23" />Nuus ufaysa qaala immida Xoossay ammanetidaysa gidiya gisho nu markatiya ufaysaa ushachi haddirsi goonna minthidi oykoos. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />Issoy issuwa siiqosinne lo77o oosos waati denthethaneko ane qopoos. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />Issoti issoti meeze oothidi shiiqeysa aggidaysada nuuni issife shiiqeysa aggoko. Shin Godaa gallasay matatidaysa hinte be7iya gisho hessa kaseysafe aathidi oothite.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />Nuuni tuma eratethaa ekidaape guye erishe nagara oothiko, hizape nu nagaraa gisho yashetana yarshoy baawa. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />Shin hiza attiday yashshiya pirdaanne Xoossaa morketa xuugganaw giigida wolqaama tama.<note caller="-" style="x"><char style="xo" closed="false">10:27 </char><char style="xt" closed="false"><ref loc="ISA 26:11">Isa 26:11</ref>.</char></note> <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />Muse higgiya kiitetonna ixida oonika nam7u woyko heedzu asi iya bolla markatiko qadhey baynashin hayqees.<note caller="-" style="x"><char style="xo" closed="false">10:28 </char><char style="xt" closed="false"><ref loc="DEU 17:6">Zaare 17:6</ref>; <ref loc="DEU 19:15">19:15</ref>.</char></note> <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />Yaatin, Xoossaa Na7aa kadhida uray, bana geeshshida Xoossaa caaqo suuthaa tunabaada qopida uray, qassi aadho keehatetha Ayyaana cayida uray, ay mela iita pirdaa ekanaw bessiyako ane qopite.<verse eid="HEB 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 10:30" />Hiza, “Halo kesoy tabaa, ta kushe zaarana” gidaysa nu eroos. Qassika, “Goday ba asa pirdana” yaagis. <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />De7o Xoossaa kushen kundethi daro yashshees.<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />Hintew Xoossaa poo7oy poo7idaape guye hinte daro waayen, gita baaxen gencida beni wodiya qopite. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />Issi issi toho hinte asa sinthan cayetideta; goodetideta; issi issi toho hessa mela waayey gakida asaara issife waayideta. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />Qashon de7iya asaaska qadhetideta. Hintew lo77onne dhayonna shaloy salon de7eysa hinte erida gisho hinte shaloy bonqetiya wode ufaysan danda7ideta.<verse eid="HEB 10:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 10:35" />Hessa gisho, gita woytoy de7iya hinte minotethaa yeggofite. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />Xoossaa sheniya polidi, I hintew immana gida ufaysaa ekana gakanaw gencanaw koshshees. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />Hiza, Geeshsha Maxaafan,</para>
  <para style="q1" vid="HEB 10:37">“I, yaana gidaysi yaana; gam7enna.<note caller="-" style="x"><char style="xo" closed="false">10:37 </char><char style="xt" closed="false"><ref loc="HEB 2:3-4">Ibra 2:3-4</ref>.</char></note><verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />Shin ta xilloy, tanan ammanetidi daana;</para>
  <para style="q2" vid="HEB 10:38">oonika guye simmiko tana ufaysenna”</para>
  <para style="m" vid="HEB 10:38">yaagees. <verse eid="HEB 10:38" /><verse number="39" style="v" sid="HEB 10:39" />Nuuni ammanidi attiya asaa baggafe attishin, guye simmidi dhayiya asaa bagga gidoko.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s1">Ammano</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />Ammano guussay, demmana gidi ufaysan ammanetidi naagiyabanne nu be7onnaba be7iyada oothidi ekiyaba. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />Beni aawati ammanon Xoossaafe markatethi ekidosona.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />Alamey Xoossaa qaalan medhetidaysa nu ammanon eroos. Qassi bentiyabay bentonnabape medhetis.<note caller="-" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="GEN 1:1">Medhe 1:1</ref>; <ref loc="PSA 33:6">Maz 33:6</ref>, <ref loc="PSA 33:9">9</ref>; <ref loc="JHN 1:3">Yoha 1:3</ref>.</char></note><verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />Aabeli Qaayelape aadhiya yarsho Xoossaas yarshiday ammanonna. Xoossay Aabela imuwa ufaytidi ekida wode I xillo gididaysa markatis. Aabeli hari attoshin, hayqidika ba ammanuwan ha77i gakanaw odees.<note caller="-" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="GEN 4:3-10">Medhe 4:3-10</ref>.</char></note><verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />Heenokey hayqonna salo biday ammanonna. Xoossay iya ekida gisho oonika iya be7anaw danda7ibeenna. Heenokey salo eketanaape sinthe I Xoossaa ufaysida asi gideysi odetis.<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="GEN 5:21-24">Medhe 5:21-24</ref>.</char></note> <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />Ammanoy bayna oonika Xoossaa ufaysanaw danda7enna. Xoossaako yaa oonika Xoossay de7eysanne bana koyeysatas woyto immeysa ammananaw koshshees.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />Nohey buroo bentonnabas Xoossi iyaw odida wode Xoossas yayidi, bananne ba soo asaa ashshanaw ammanon markabe keexis. Yaatidi ba ammanuwan alame pirdidi, ammanon bentiya xillotethi Xoossafe ekis.<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 6:13-22">Medhe 6:13-22</ref>.</char></note><verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />Abrahaamey laata oothidi ekana biitta baana mela Xoossay iya xeegida wode hari attoshin, I aw biyako eronna ixikoka kiitetiday ammanonna.<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="GEN 12:1-5">Medhe 12:1-5</ref>.</char></note> <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />Abrahaamey Xoossay iyaw immana gida biittan bete asada de7iday ammanonna. Xoossay he immana gidaysa iyara issife laattanaw de7iya Yisaaqaranne Yayqoobara wolla dunkaanen de7is.<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="GEN 35:27">Medhe 35:27</ref>.</char></note> <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />I, Xoossay qopidi keexida xaala baasoy de7iya katamaa naagees.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />Saara ba huuphen cimidabaa gidikoka ufaysi immida Xoossay ammanetidaysa gideysa erida gisho qanthatanaw wolqa demmiday ammanonna.<note caller="-" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="GEN 18:11-14">Medhe 18:11-14</ref>; <ref loc="GEN 21:2">21:2</ref>.</char></note> <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />Hessa gisho, hayqida asi daaniya issi addiyafe salo xoolinto melanne abba gaxan de7iya tayboy bayna shafe mela zerethi yeletidosona.<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="GEN 15:5">Medhe 15:5</ref>; <ref loc="GEN 22:17">22:17</ref>; <ref loc="GEN 32:12">32:12</ref>.</char></note><verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />He asa ubbay bantaw geetetida ufaysaa qaala ekonna ammanon hayqidosona. Shin haahora hessa be7idi, demmidaada oothidi, ufaysan ekidosona. Qassi enti sa7an imathenne bete asi gideysa eridosona.<note caller="-" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="GEN 23:4">Medhe 23:4</ref>; <ref loc="1CH 29:15">1 Taari 29:15</ref>; <ref loc="PSA 39:12">Maz 39:12</ref>.</char></note> <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />Hessada giya asay banta biitta naageysa qoncen bessees. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />Enti he aggidi keyida biitta guye qopidaba gidiyako guye simmanaw danda7oosona. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />Shin ha77i aadhidi lo77iya salo biitta laamotosona. Hessa gisho, Xoossay entaw katama giigisida gisho, “Enta Xoossaa” geetetidi xeegetanaw yeellatenna.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />Abrahaamey paacetida wode Yisaaqa yarshiday ammanonna. He ufaysa qaala ekida Abrahaamey ba issi na7aa yarshanaw giigis.<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">Medhe 22:1-14</ref>.</char></note> <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />Xoossay Abrahaameko, “Ne kochay Yisaaqa baggara xeegetana” yaagidi odis.<note caller="-" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="GEN 21:12">Medhe 21:12</ref>.</char></note> <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />Xoossay hayqope denthanaw danda7eysa Abrahaamey ammanida gisho, Yisaaqa hayqope paxi dendidaada oothidi zaari ekis.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />Yisaaqi wodepe hananaba eridi Yayqoobanne Eesawe anjiday ammanonna.<note caller="-" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="GEN 27:27-29">Medhe 27:27-29</ref>, <ref loc="GEN 27:39-40">39-40</ref>.</char></note><verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />Yayqoobi hayqana hanishe, issi issi Yoosefa nayta anjidaynne guufe bolla katidi goyinniday ammanonna.<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="GEN 47:3">Medhe 47:3</ref>; <ref loc="GEN 48:1-20">48:1-20</ref>.</char></note><verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />Yoosefi hayqanaw matida wode Isra7eele asay Gibxefe keyanaysa odidaynne ba meqethaa oothanaba enta kiittiday ammanonna.<note caller="-" style="x"><char style="xo" closed="false">11:22 </char><char style="xt" closed="false"><ref loc="GEN 50:24-25">Medhe 50:24-25</ref>; <ref loc="EXO 13:19">Kessa 13:19</ref>.</char></note><verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />Musey yeletidaape guye iya aayanne iya aaway mala lo77o na7a gididaysa be7idi heedzu ageena qottiday ammanonna; enti kawa awaajuwa babibookona.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="EXO 1:22">Kessa 1:22</ref>; <ref loc="EXO 2:2">2:2</ref>.</char></note><verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />Musey diccidaape guye Gibxe kawa na7e na7a geetetanaysa ixiday ammanonna.<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="EXO 2:10-12">Kessa 2:10-12</ref>.</char></note> <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />Musey nagaran guutha wodes ufaytanaape, Xoossaa asaara waaye ekanaysa dooris. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />I wodepe demmana woytuwa tishshi oothidi xeellida gisho, Gibxe shaluwape aathidi Kiristoosa gisho boretanaysi daro aadhiya duretethi gididaysa eris.<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />Musey Kawa hanquwa yayyonna, Gibxefe keyday ammanonna. Bentonna Xoossaa be7ida asada hanidi ba qofan gencis. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />Hayqo ehiya kiitanchoy Isra7eele asaa bayra nayta wodhonna mela Musey Paasikanne suutha wurxetha wogaa oothiday ammanonna.<note caller="-" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="EXO 12:21-30">Kessa 12:21-30</ref>.</char></note><verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />Isra7eele asay mela biittara hemetiyada hemetidi, Zo7o Abbaa pinniday ammanonna. Shin Gibxe asay gelanaw paacidi be7iya wode haathay enta mittis.<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="EXO 14:21-31">Kessa 14:21-31</ref>.</char></note><verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />Isra7eele asay Iyaarko katamaa shucha dirsaa laapun gallas yuuyidi, kundisiday ammanonna.<note caller="-" style="x"><char style="xo" closed="false">11:30 </char><char style="xt" closed="false"><ref loc="JOS 6:12-21">Iyya 6:12-21</ref>.</char></note> <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />Laymiya Ra7aaba biitta wocheyisata mokida gisho, kiitetonna asaara hayqonna attiday ammanonna.<note caller="-" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">Iyya 2:1-21</ref>; <ref loc="JOS 6:22-25">6:22-25</ref>.</char></note><verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />Hiza, haraa ta ay go? Gediyoonaba, Baaraqaba, Samsoonaba, Yoftaaheba, Dawitaba, Sameelaba, qassi nabetaba odanaw taw wodey gidenna.<note caller="-" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="JDG 6:11-8:32">Ayse 6:11—8:32</ref>; <ref loc="JDG 4:6-5:31">4:6—5:31</ref>; <ref loc="JDG 13:2-16">13:2-16</ref>; <ref loc="JDG 11:1-12">11:1-12</ref>; <ref loc="1SA 16:1">1 Same 16:1</ref>; <ref loc="1KI 2:11">1 Kawo 2:11</ref>; <ref loc="1SA 1:1-25">1 Same 1:1-25</ref>.</char></note> <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />Enti ammanon kawotethata xoonidosona; xillotethan aysidosona; Xoossay immana gida ufaysaa ekidosona; gaammota doona gordidosona;<note caller="-" style="x"><char style="xo" closed="false">11:33 </char><char style="xt" closed="false"><ref loc="DAN 6:1-27">Daane 6:1-27</ref>.</char></note> <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />tama wolqaa toysidosona; morketa mashshafe attidosona; banta daaburan minnidosona; olan wolqaama gididosona; allaga toora goodidosona.<note caller="-" style="x"><char style="xo" closed="false">11:34 </char><char style="xt" closed="false"><ref loc="DAN 3:1-30">Daane 3:1-30</ref>.</char></note> <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />Maccasati banta hayqidaysata hayqope paxin ekidosona.</para>
  <para style="p" vid="HEB 11:35">Qassi harati aadhiya hayqope dendo ekanaw koyidi qashope biletanaysa ixidosona.<note caller="-" style="x"><char style="xo" closed="false">11:35 </char><char style="xt" closed="false"><ref loc="1KI 17:17-24">1 Kawo 17:17-24</ref>; <ref loc="2KI 4:25-37">2 Kawo 4:25-37</ref>.</char></note> <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />Harati asan boretidi lisson garaafetidosona; harati santhalaatan qashetidi qasho keethan yegetidosona.<note caller="-" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="1KI 22:26-27">1 Kawo 22:26-27</ref>; <ref loc="2CH 18:25-26">2 Taari 18:25-26</ref>; <ref loc="JER 20:2">Ermi 20:2</ref>; <ref loc="JER 37:15">37:15</ref>; <ref loc="JER 38:6">38:6</ref>.</char></note> <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />Enti shuchan cadetidosona; magaazen nam7a keyidi phalqetidosona; paacetidosona; mashshan hayqidosona; entaw ubbabay dhayin metootidosona. Dorsa itenne deesha ite ma7idi yuuyidosona.<note caller="-" style="x"><char style="xo" closed="false">11:37 </char><char style="xt" closed="false"><ref loc="2CH 24:21">2 Taari 24:21</ref>.</char></note> <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />Entaw ha alamey giigonna ixin mela biittan, dere bolla, gongoloninne olla giddon yuuyidosona.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />Xoossay enta ammanuwaba markatikoka, he ubbay geetetida ufaysa qaala ekibookona. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />Xoossay nuus lo77oba qopi wothida gisho enti nuuni bayna polo gidokona.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s1">Xoossay Nuus Aawa</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />Hiza, shaarada nu yuushuwan darida haysa mela markati nu matan de7iya gisho nuna dhubiya ubbaanne oykidi haariya nagaraa diggidi, nu sinthan de7iya gaadde wothaa gencan woxoos. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />Nu ammanuwas oge dooydaysanne nu wursetha poluwako nuna gathiya Yesuusa bolla nu ayfiya wothoos. Yesuusi wodepe de7iya ufaysaa gisho masqaliya waayiya danda7idi, yeella hayquwa kadhidi, Xoossaafe ushacha baggan uttis.<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />Hiza, hinte doccidi ufaysi qanxonna mela nagaranchota ixuwa danda7ida Yesuusa qopite. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />Nagarara de7iya baaxiyan buroo suuthu gussana gakanaw eqetibeketa. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />Xoossay ba qaalan, ba naytada hintena zoridaysa dogideta.<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="JOB 5:17">Iyyo 5:17</ref>; <ref loc="PRO 3:11-12">Leemi 3:11-12</ref>.</char></note></para>
  <para style="q1" vid="HEB 12:5">“Ta na7aw, Xoossaa seera leqofa;</para>
  <para style="q2" vid="HEB 12:5">I nena seeriya wode ufaysi qanxofa.<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />Goday ba dosiya uraa seerees;</para>
  <para style="q2" vid="HEB 12:6">qassi ba na7ada ekiya ubba garaafes” yaagees.<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />Xoossay hintena ba naytada seeriya wode gencite; Aaway seeronna na7i oonee? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />Xoossay ba nayta ubbaa seerees; hinte seerettonna ixiko tuma iya nayta gidonashin balako nayta. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />Qassi nuna yelida nu aawati nuna seerosona; nuka entana bonchoos. Yaatin, nuuni nu ayyaana Aawas waanidi aathidi haaretoko? <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />Hiza, nu aawati bantaw lo77o daanida mela guutha wodes nuna seeridosona. Shin Xoossay nu go77as, nu iya geeshshatethan shaaketana mela seerees. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />Nuuni seeretiya wode yiloyeesipe attishin, ufaysenna. Shin guyepe seeretethi meezetida asaas seeray, saroy kumida xillotethaa ayfe ayfisees.<verse eid="HEB 12:11" /></para>
  <para style="s1">Zorenne Naagiso</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />Hiza, hinte argaacida qesiyanne hinte daaburida gulbata minthite.<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ISA 35:3">Isa 35:3</ref>.</char></note> <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />Wobbey paxana melape attishin, aathidi meqonna mela hinte tohuwas suure oge giigisite.<note caller="-" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="PRO 4:26">Leemi 4:26</ref>.</char></note><verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />Asa ubbaara saro daanawunne geeshshatethan daanaw minnite; geeshshatethi bayna oonika Godaa be7anaw danda7enna. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />Hintefe oodeska Xoossaa aadho keehatethay paconnaada, qassi camo ayfe ayfidi daro asaa tunisiyanne dhaysiya zerethada gidonna mela naagetite.<note caller="-" style="x"><char style="xo" closed="false">12:15 </char><char style="xt" closed="false"><ref loc="DEU 29:18">Zaare 29:18</ref>.</char></note> <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />Hinte giddon laymatiya asi woyko issi toho miya kathas ba bayratetha toochidi bayzida Eesawe mela asi doonna mela naagetite.<note caller="-" style="x"><char style="xo" closed="false">12:16 </char><char style="xt" closed="false"><ref loc="GEN 25:29-34">Medhe 25:29-34</ref>.</char></note> <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />Guyepe Eesawey he anjuwa ekanaw koyida wode digetidaysa ereeta. I he anjuwa afuthan minnidi koykoka, demmanaw danda7ibeenna; I nagaraape simmanaw qaada demmibeenna.<note caller="-" style="x"><char style="xo" closed="false">12:17 </char><char style="xt" closed="false"><ref loc="GEN 27:30-40">Medhe 27:30-40</ref>.</char></note><verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />Hinte kushen boshetiya Siina deriyako, eexiya tamaako, dhumaako, caaganaako, gotiyaako,<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="EXO 4:11-12">Kessa 4:11-12</ref>; <ref loc="EXO 19:16-22">19:16-22</ref>; <ref loc="EXO 20:18-21">20:18-21</ref>.</char></note> <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />moyze punuko woyko qaalay si7etiya bessaako yibeeketa. He qaala si7ida asay hara guzha qaala si7onna mela woossidosona. <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />Ayis giiko, “Hari attoshin, do7i he zumaa bochiko, shuchan cadetidi hayqo” yaagida kiitaa enti tookanaw danda7ibookona.<note caller="-" style="x"><char style="xo" closed="false">12:20 </char><char style="xt" closed="false"><ref loc="EXO 19:12-13">Kessa 19:12-13</ref>.</char></note> <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />He haniyabay daro daganthiyaba gidida gisho Museyka, “Taani yashshan kokoras” yaagis.<note caller="-" style="x"><char style="xo" closed="false">12:21 </char><char style="xt" closed="false"><ref loc="DEU 9:19">Zaare 9:19</ref>.</char></note><verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />Shin hinte Xiyoone zumako, de7o Xoossay de7iya Yerusalaame katamaako, issife shiiqidi ufaytiya daro mukulu kiitanchotako saluwa yideta. <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />Enta sunthay salon xaafetida woosa keethaa bayra naytako, asa ubbaa dayna gidida Xoossaako, polo gidida xillo asaa ayyaanatako yideta. <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />Ooratha caaquwas giddo gididi sigethiya Yesuusako, Aabela suuthaafe aadhiyaba odiya wurxetida suuthako yideta.<note caller="-" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="GEN 4:10">Medhe 4:10</ref>.</char></note><verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />Hintew odiya ura qaala ixas goonna mela naagetite. Kaseysati sa7an gididi odida kiita si7onna ixidi, kessi ekiboonnaba gidiko, yaatin, salon gididi odiya qaala nuuni ixas giiko waanidi kessi ekanee?<note caller="-" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="EXO 20:22">Kessa 20:22</ref>.</char></note> <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />He wode iya qaalay sa7a qaathis. Shin ha77i taani, “Sa7a xalaala gidonashin, issi toho zaarada saluwaka qaathana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="HAG 2:6">Hagge 2:6</ref>.</char></note> <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />“Issi toho zaarada” giya qaalay qaaxonnabay minnidi daanaysa, qassi qaaxiya medhetidabati dhayanaysa bessees.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />Nuuni qaaxanaw danda7onna kawotethaa ekiya gisho Xoossaa galatoos; Xoossaa ufaysiya ogen bonchoninne yashshatethan iya goyinnoos. <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />Hiza, nu Xoossay tuma xuuggiya tama.<note caller="-" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 4:24">Zaare 4:24</ref>.</char></note><verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s1">Wursetha Zore</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />Ammaniya asada issoy issuwara polo siiqetite. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />Imathe mokeysa dogopite. Issi issi asati hessada oothishe eronna kiitanchota mokidosona.<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="GEN 18:1-8">Medhe 18:1-8</ref>; <ref loc="GEN 19:1-3">19:1-3</ref>.</char></note> <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />Qashon de7eyisata hinteka entara issife qashon de7iyada oothidi entana qopite. Waaye ekiya asaara issife hinteka waaye ekiyada oothidi entana qopite.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />Ekoynne geloy asa ubbaa matan bonchetidaba gido. Qassi Xoossay laymateysatanne laammeyisata pirdanaw de7iya gisho azinaynne machiya issoy issuwas ammanetanaw bessees.<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />Miishe siiqope hintena naagite; hintew de7iyaban alite. Xoossay, “Taani nena ubbaraka yeggike woyko aggike” yaagis.<note caller="-" style="x"><char style="xo" closed="false">13:5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">Zaare 31:6</ref>, <ref loc="DEU 31:8">8</ref>; <ref loc="JOS 1:5">Iyya 1:5</ref>.</char></note> <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />Hessa gisho, nuuni ammanetidi,</para>
  <para style="q1" vid="HEB 13:6">“Goday tana maaddeysa;</para>
  <para style="q2" vid="HEB 13:6">ta yayyike; asi tana ay oothanee?”</para>
  <para style="m" vid="HEB 13:6">yaagos.<note caller="-" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="PSA 118:6">Maz 118:6</ref>.</char></note><verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />Xoossaa qaala koyro hintew odida hintena kaaletheyisata qopite. Enti waanidi de7idaako enta duussaa be7idi enta ammanuwa kaallite.<verse eid="HEB 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 13:8" />Yesuus Kiristoosi zineka hachika merinawuka laametenna. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />Dumma dumma ooratha timirten haraso bidi dhayopite; boopite. Nu wozanay Xoossaa aadho keehatethan minnanaw besseesipe attishin, min go77onna kathan wogaa polon gidopo.<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />Shin dunkaaniya giddon oothiya kahineti he yarsho kathaafe maanaw entaw maati bayna yarsho bessay nuus de7ees. <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />Kahine halaqay nagara yarshos mehe suuthi ekidi yarshanaw Ubbaafe Geeshsha Bessaa gelees. Shin he mehiya ashuwa dirsaafe karen xuuggees.<note caller="-" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="LEV 16:27">Leewe 16:27</ref>.</char></note> <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />Hessadaka, Yesuusi deriya nagaraape ba suuthan geeshshanaw katamaa pengiyafe karen waayetis. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />Hiza, nuuni boriya tookidi dirsaafe kare iyako keyoos. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />Hiza, nuus haysan merinaw de7iya katami baawa, shin nuuni yaana katamaa naagoos.<verse eid="HEB 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 13:15" />Hiza, Yesuusa baggara ubba wode iya sunthaas markatiya mettersha galata yarsho Xoossaas immoos. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />Lo77oba oosonne hintew de7iyabaape metootida asaas imo dogopite. Hiza, hessa mela yarshoy Xoossaa ufaysees.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />Hintena kaaletheysatas kiitetite; enti giyaba oothite. Enti banta oothiyabas Xoossaa sinthan oyshetanaw de7iya gisho, hintena heemmoosona. Hinte entaw kiitetiko, banta oosuwa ufaytidi oothana; hessi hanonna ixiko, enti azzanishe oothana; hessi hintena aybibaaka maaddenna.<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />Nuus Xoossaa woossite. Nu kahay geeshshi; nu ubba wode lo77oba oothanaw koyoos. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />Taani hinteko ellesada yaana mela hinte taw minthidi Xoossaa woossana mela ta hintena hadara gayis.<verse eid="HEB 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />Sarotethaa Xoossay, dorsa heemmiya nu Godaa Yesuusa, ba merinaa caaqo suuthan hayqope denthidaysi, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />iya sheniya oothana mela lo77oba ubban I hintena danciso. Iya ufaysiyabaa Yesuus Kiristoosa baggara nunan Xoossay ootho. Yesuus Kiristoosa baggara Xoossaas merinaape merinaa gakanaw bonchoy gido. Amin7i.<verse eid="HEB 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />Ta ishato, ta ha dabdaabiya hintew qanthan xaafida gisho, hinte ta zoriya saletonna ekana mela ta hintena woossayis.<verse eid="HEB 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 13:23" />Nu ishay, Ximotiyoosi qashope biletidaysa erite. I ellesidi taako yiiko ta iyara hintena bada be7ana.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />Hintena kaaletheysatanne ammaniya ubbaa saro giite. Xaalepe yida ammaniya asay hintena saro yaagosona.<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />Xoossaa aadho keehatethay hinte ubbaara gido. Amin7i.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>