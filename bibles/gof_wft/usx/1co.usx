<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">1 Qorontoosa Kiita</para>
  <para style="toc1">1 Qorontoosa Kiita</para>
  <para style="toc3">1 Qoro</para>
  <para style="toc2">1 Qorontoosa</para>
  <para style="mt1">Phawuloosi Qorontoosa Asaas</para>
  <para style="mt2">Xaafida Koyro Kiita</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Phawuloosi Qorontoosa asaas xaafida koyro kiitay xaafetiday, Phawuloosi Qorontoosan essida woosa keethan ammaniya asaa de7oninne ammano bolla dendida metuwas zaaro immanaasa. He wode Qorontoosa katamay, dumma dumma asay de7iya Girike katamanne Akaya biittas waanna katama. Qorontoosa katamay zal7en eretida, wogan minnida, dumma dumma iita de7on dalgidanne haymaanote darotethan eretida biitta.</para>
  <para style="ip">Ha kiitan, hawaarey minthidi odey, Qorontoosa woosa keethan medhetida shaahetethaba, dumma dumma iita de7oba, laymatethaba, eko geloba, Geeshsha Ayyaana imotatabanne hayqope dendoba. Yesuus Kiristoosa wongeli ha oyshata waatidi zaariyako hawaarey minthidi odees.</para>
  <para style="ip">Phawuloosi, shempo tammanne heedzan, siiqoy ammanope, ufaysafenne dumma dumma Geeshsha Ayyaana imotatape odees. Ammaniya asay issoy issuwa siiqiyaba gidiko, woosa keethan medhetiya metoti qanthan simmees. Siiqoy dhayko, palami, shaaketethi, ixoynne hessa hessa melabati darees.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Gelo qofa <char style="ior">(<ref loc="1CO 1:1-9">1:1-9</ref>)</char></para>
  <para style="io1">Ammaniya asaa giddon medhetida shaaketethi <char style="ior">(<ref loc="1CO 1:9-4:21">1:9—4:21</ref>)</char></para>
  <para style="io1">Laymatethinne issoy issuwara siga de7o <char style="ior">(<ref loc="1CO 5:1-7:40">5:1—7:40</ref>)</char></para>
  <para style="io1">Eeqa aggidi Xoosse boncho <char style="ior">(<ref loc="1CO 8:1-11:1">8:1—11:1</ref>)</char></para>
  <para style="io1">Woosa keethinne goyinno woga <char style="ior">(<ref loc="1CO 11:2-14:40">11:2—14:40</ref>)</char></para>
  <para style="io1">Kiristoosi hayqo xoonidi dendis <char style="ior">(<ref loc="1CO 15:1-58">15:1-58</ref>)</char></para>
  <para style="io1">Metootetida asaas imetiya imota <char style="ior">(<ref loc="1CO 16:1-4">16:1-4</ref>)</char></para>
  <para style="io1">Oge buussaa halchonne sarotho <char style="ior">(<ref loc="1CO 16:5-24">16:5-24</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="1CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1"/>Xoossaa sheniyan Yesuus Kiristoosa hawaare gidanaw xeegetida Phawuloosinne, nu isha Sosteneesi, <verse eid="1CO 1:1"/><verse number="2" style="v" sid="1CO 1:2"/>Qorontoosan de7iya Xoossa woosa keethaas, Yesuus Kiristoosan geeydaysatasinne geeshshi gidana mela xeegetidaysatas; qassi entawunne nuus Godaa gidiya nu Godaa Yesuus Kiristoosa suntha ubba bessan xeegiya ubbaas.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 18:1">Hawa 18:1</ref>.</char></note><verse eid="1CO 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3"/>Xoossay, nu Aawaynne Goday Yesuus Kiristoosi hintew aadho keehatethaanne sarotethaa immo.<verse eid="1CO 1:3"/></para>
  <para style="s1">Phawuloosi Xoosse Galatees</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4"/>Xoossay Kiristoos Yesuusa baggara hintew immida aadho keehatetha gisho, taani ubba wode Xoossaa galatayis. <verse eid="1CO 1:4"/><verse number="5" style="v" sid="1CO 1:5"/>Iyan odaninne eratetha ubban hinte duretideta. <verse eid="1CO 1:5"/><verse number="6" style="v" sid="1CO 1:6"/>Taani Kiristoosaba markatidaysi tuma gideysa hessi qoncisees. <verse eid="1CO 1:6"/><verse number="7" style="v" sid="1CO 1:7"/>Hessa gisho, hinte nu Godaa Yesuus Kiristoosa yuussaa naagishe de7ishin, ay ayyaana imoyka hintew pacenna. <verse eid="1CO 1:7"/><verse number="8" style="v" sid="1CO 1:8"/>Nu Godaa Yesuus Kiristoosi simmiya wode hinte boretonayisata gidana mela wursethi gakanaw I hintena minthana. <verse eid="1CO 1:8"/><verse number="9" style="v" sid="1CO 1:9"/>Ba Na7a, nu Godaa, Yesuus Kiristoosara issifetethi daana mela hintena xeegida Xoossay ammanetidaysa.<verse eid="1CO 1:9"/></para>
  <para style="s1">Woosa Keethan De7iya Shaaketethi</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10"/>Ta ishato, hinte giddon shaaketethi doonna melanne hinte issi wozananinne issi qofan isso gididi daana mela, nu Godaa Yesuus Kiristoosa sunthan hintena woossayis. <verse eid="1CO 1:10"/><verse number="11" style="v" sid="1CO 1:11"/>Ta ishato, Qelo7e soo asay hinte giddon ooshshi de7eysa taw odidosona. <verse eid="1CO 1:11"/><verse number="12" style="v" sid="1CO 1:12"/>Ta hintew odeysi haysa: hintefe issoti issoti, “Taani Phawuloosasa; taani Aphiloosasa; taani Phexroosassa; taani Kiristoosassa” yaageeta.<note caller="-" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ACT 18:24">Hawa 18:24</ref>.</char></note> <verse eid="1CO 1:12"/><verse number="13" style="v" sid="1CO 1:13"/>Kiristoosi shaaketideyee? Hinte gisho, masqaliya bolla kaqetiday Phawulooseyee? Woyko hinte Phawuloosa sunthan xammaqetidetiyee?<verse eid="1CO 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14"/>Taani Qarisphoosinne Gaayoosi attishin, hintefe oonaka xammaqaboonna gisho, Xoosse galatayis.<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 18:8">Hawa 18:8</ref>; <ref loc="ACT 19:29">Hawa 19:29</ref>; <ref loc="ROM 16:23">Roome 16:23</ref>.</char></note> <verse eid="1CO 1:14"/><verse number="15" style="v" sid="1CO 1:15"/>Hessa gisho, oonika hintena ta sunthan xammaqetideta gaanaw danda7enna. <verse eid="1CO 1:15"/><verse number="16" style="v" sid="1CO 1:16"/>[Qassi Isxifaanose soo asaaka ta xammaqidaysa akeekayis, shin hara oona xammaqidaako hassayike.] <verse eid="1CO 1:16"/><verse number="17" style="v" sid="1CO 1:17"/>Kiristoosi tana kiittiday wongela odana melasafe attishin, xammaqana mela gidenna. Kiristoosi masqaley hada gidonna mela taani asa cincatetha qaalan odike.<verse eid="1CO 1:17"/></para>
  <para style="s1">Kiristoosi Xoossa Wolqanne Cincatethi</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18"/>Kiristoosa masqala qaalay dhayeysatas eeyatethi, shin nuus atteysatas Xoossa wolqa. <verse eid="1CO 1:18"/><verse number="19" style="v" sid="1CO 1:19"/>Geeshsha Maxaafan,</para>
  <para style="q1" vid="1CO 1:19">“Taani cincata cincatethaa dhaysana;</para>
  <para style="q2" vid="1CO 1:19">akeekanchota akeeka balethana”</para>
  <para style="m" vid="1CO 1:19">yaagees.<note caller="-" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ISA 29:14">Isa 29:14</ref>.</char></note><verse eid="1CO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 1:20"/>Yaatin, cinci awun de7ii? Higge astamaarey awunee? Woyko ha sa7a eranchoy awun de7ii? Xoossay ha sa7aa cincatetha eeyatethi oothibeennee?<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="JOB 12:17">Iyyo 12:17</ref>; <ref loc="ISA 19:12">Isa 19:12</ref>; <ref loc="ISA 33:18">33:18</ref>; <ref loc="ISA 44:25">44:25</ref>.</char></note><verse eid="1CO 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21"/>Ha sa7aa asay banta cincatethan Xoossa eronna mela ba cincatethan diggidi, eeyatethan taybetiya, nuuni odiya qaalan ammaneyisata ashshanaw Xoossa shene gidis. <verse eid="1CO 1:21"/><verse number="22" style="v" sid="1CO 1:22"/>Ayhudeti malaata be7anaw koyoosona; qassi Giriketi cincatethi koyoosona. <verse eid="1CO 1:22"/><verse number="23" style="v" sid="1CO 1:23"/>Shin nuuni masqale bolla kaqetida Kiristoosa sabbakoos. Hessi Ayhudetas dhube; qassi Giriketas eeyatethi gidis. <verse eid="1CO 1:23"/><verse number="24" style="v" sid="1CO 1:24"/>Shin Xoossay xeegidaysatas, Ayhude gidin, Girike gidin Kiristoosi Xoossa wolqaanne iya cincatethaa. <verse eid="1CO 1:24"/><verse number="25" style="v" sid="1CO 1:25"/>Xoossa eeyatethi asa cincatethafe aadhees; qassi Xoossa daaburay asa minotethafe minnees.<verse eid="1CO 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26"/>Hiza, ta ishato, Xoossay hintena xeegiya wode hinte ay mela aseeko qopite. Asa qofan, hinte giddofe daroti cinca, wolqaamanne dhoqa koche gideketa. <verse eid="1CO 1:26"/><verse number="27" style="v" sid="1CO 1:27"/>Shin Xoossay cincata yeellayanaw alamen de7iya eeyata dooris; qassi minota yeellayanaw alamen de7iya daaburanchota dooris. <verse eid="1CO 1:27"/><verse number="28" style="v" sid="1CO 1:28"/>Ha alamiyan gita geetetidaba dhaysanaw, Xoossi, ha sa7aa kawushaba, kadhetidabanne pathonaba dooris. <verse eid="1CO 1:28"/><verse number="29" style="v" sid="1CO 1:29"/>Xoossa sinthan oonika ceeqetonna mela hessa oothis. <verse eid="1CO 1:29"/><verse number="30" style="v" sid="1CO 1:30"/>Shin, hintew Kiristoos Yesuusara issifetethi daana mela Xoossay hessa oothis. I, nuus Xoossafe cincatethi, xillotethi, geeshshatethinne atotethi gidis. <verse eid="1CO 1:30"/><verse number="31" style="v" sid="1CO 1:31"/>Hessa gisho, Geeshsha Maxaafan, “Ceeqetiya oonika Godan ceeqo” yaagees.<note caller="-" style="x"><char style="xo" closed="false">1:31 </char><char style="xt" closed="false"><ref loc="JER 9:24">Ermi 9:24</ref>.</char></note><verse eid="1CO 1:31"/></para>
  <chapter eid="1CO 1"/>
  <chapter number="2" style="c" sid="1CO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1"/>Ta ishato, taani koyro Xoossa qaala hintew odashe yida wode, doona bilatethaninne cincatethan yabiike. <verse eid="1CO 2:1"/><verse number="2" style="v" sid="1CO 2:2"/>Taani hintera de7iya wode masqaliya bolla kaqetida Yesuus Kiristoosape attishin, haraba eranaw koyke gada qofa qachas. <verse eid="1CO 2:2"/><verse number="3" style="v" sid="1CO 2:3"/>Ta hintera de7iya wode daaburan, yashshaninne daro kokorsan de7as.<note caller="-" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ACT 18:9">Hawa 18:9</ref>.</char></note> <verse eid="1CO 2:3"/><verse number="4" style="v" sid="1CO 2:4"/>Ta kiitaynne ta timirtey doona bilatethaninne cincatethan gidonashin, Geeshsha Ayyaana wolqa qoncisethaana. <verse eid="1CO 2:4"/><verse number="5" style="v" sid="1CO 2:5"/>Hessika, hinte ammanoy Xoossaa wolqaanape attishin, asa cincatethan zemponna melasa.<verse eid="1CO 2:5"/></para>
  <para style="s1">Xoossa Cincatethi</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6"/>Ayyaana de7on diccidaysatas nuuni cincatetha qaalan odoos. Shin he cincatethay, ha sa7a cincatethi woyko dhayanaw de7iya ha sa7a haareyisata cincatethi gidenna. <verse eid="1CO 2:6"/><verse number="7" style="v" sid="1CO 2:7"/>Shin nuuni odiya cincetethay, daro wodepe sinthe Xoossay nu bonchuwas giigisidaysanne geemmidi de7iya xuura cincatethi. <verse eid="1CO 2:7"/><verse number="8" style="v" sid="1CO 2:8"/>Ha sa7aa haareysatape oonika ha cincatetha eribookona. Enti eridaba gidiyako, boncho Godaa masqaliya bolla kaqokona. <verse eid="1CO 2:8"/><verse number="9" style="v" sid="1CO 2:9"/>Shin Geeshsha Maxaafan,</para>
  <para style="q1" vid="1CO 2:9">“Ayfey be7iboonaba,</para>
  <para style="q2" vid="1CO 2:9">haythi si7iboonaba,</para>
  <para style="q2" vid="1CO 2:9">wozani qopiboonnaba,</para>
  <para style="q2" vid="1CO 2:9">Xoossay bana doseysatas giigisis” yaagees.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="ISA 64:4">Isa 64:4</ref>.</char></note><verse eid="1CO 2:9"/></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10"/>Xoossay ba xuura ba Ayyaana baggara nuus qoncisis. Geeshsha Ayyaanay hari attoshin, geemmida Xoossa xuura ubba pilgees. <verse eid="1CO 2:10"/><verse number="11" style="v" sid="1CO 2:11"/>Asan de7iya asa ayyaanape attishin, asaba oonika erenna. Hessadaka, Xoossaba, Xoossa Ayyaanape attishin, oonika erenna. <verse eid="1CO 2:11"/><verse number="12" style="v" sid="1CO 2:12"/>Xoossay nuus coo immidaba nu erana mela Xoossa Ayyaana ekidaape attishin, ha sa7a ayyaana ekibooko.<verse eid="1CO 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13"/>Nuuni ayyaanaba, ayyaana asatas asa cincatethan gidonashin, Xoossa Ayyaanay immiya cincatethan tamaarsoos. <verse eid="1CO 2:13"/><verse number="14" style="v" sid="1CO 2:14"/>Geeshsha Ayyaani bayna asi Xoossa Ayyaana imotata ekenna. Hessi iyaw eeyatethi; ubbay Geeshsha Ayyaanan pilgetiya gisho, I eranaw danda7enna. <verse eid="1CO 2:14"/><verse number="15" style="v" sid="1CO 2:15"/>Geeshsha Ayyaani de7iya asi ubbaba pilgees, shin iya oonika pilgenna. <verse eid="1CO 2:15"/><verse number="16" style="v" sid="1CO 2:16"/>Geeshsha Maxaafan,</para>
  <para style="q1" vid="1CO 2:16">“Godaa wozana erey oonee?</para>
  <para style="q2" vid="1CO 2:16">Iya zoranaw danda7ey oonee?”</para>
  <para style="m" vid="1CO 2:16">geetetidi xaafetidaysa mela. Shin nuus Kiristoosa wozani de7ees.<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ISA 40:13">Isa 40:13</ref>.</char></note><verse eid="1CO 2:16"/></para>
  <chapter eid="1CO 2"/>
  <chapter number="3" style="c" sid="1CO 3"/>
  <para style="s1">Woosa Keethan De7iya Shaaketethi</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1"/>Ta ishato, hinte Kiristoosan buroo yooganne ammanonna asatho de7iya gisho, taani ayyaanaba hintew odanaw danda7abike. <verse eid="1CO 3:1"/><verse number="2" style="v" sid="1CO 3:2"/>Hinte mino kathi maanaw danda7iboona gisho, taani hintena maathi paahas; ha77ika danda7ibeeketa.<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="HEB 5:12-13">Ibra 5:12-13</ref>.</char></note> <verse eid="1CO 3:2"/><verse number="3" style="v" sid="1CO 3:3"/>Ha77ika hinte ammanonna asada de7eeta. Hinte giddon de7iya qanaateynne ooshshi hinte ammanonna asada de7eysa erisennee? Hinte ammanonna asada haneeta. <verse eid="1CO 3:3"/><verse number="4" style="v" sid="1CO 3:4"/>Hintefe issoy, “Taani Phawuloosasa” haray qassi, “Taani Aphiloosasa” giiko, ammanonna asa mela gideketii?<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2CO 1:12">2 Qoro 1:12</ref>.</char></note><verse eid="1CO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5"/>Yaatin, Aphiloosi oonee? Phawuloosi oonee? Nuuni hintena ammanthida Xoossaa oosanchota. Xoossay issuwas issuwas immida imota mela oothiya oosanchota gidokonaayee? <verse eid="1CO 3:5"/><verse number="6" style="v" sid="1CO 3:6"/>Taani tokas; Aphiloosi haathe ushshis, shin dichey Xoosse.<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">Hawa 18:4-11</ref>, <ref loc="ACT 18:24-28">24-28</ref>.</char></note> <verse eid="1CO 3:6"/><verse number="7" style="v" sid="1CO 3:7"/>Hessa gisho, dichiya Xoossafe attishin, tokeyka haathe ushsheyka aykoka gidenna. <verse eid="1CO 3:7"/><verse number="8" style="v" sid="1CO 3:8"/>Tokeynne haathe ushshey woli mela, shin issoy issoy ba oosuwa mela Xoossay immiya woytuwa ekana. <verse eid="1CO 3:8"/><verse number="9" style="v" sid="1CO 3:9"/>Nuuni issife Xoossas oothiya iya oosanchota gidiya gisho, hinte Xoossa shooqa; Xoossa keethi. <verse eid="1CO 3:9"/><verse number="10" style="v" sid="1CO 3:10"/>Xoossay taw immida aadho keehatetha mela hiillancho anaaxeda baaso yeggas. Hara asi iya bolla keexees. Shin iya bolla keexiya oonika waatidi keexiyako, baw naageto. <verse eid="1CO 3:10"/><verse number="11" style="v" sid="1CO 3:11"/>Issi toho yegetida baasope hara baaso yegganaw oonika danda7enna. He baasoyka Yesuus Kiristoosa. <verse eid="1CO 3:11"/><verse number="12" style="v" sid="1CO 3:12"/>Shin ha baasuwa bolla oonika worqan woyko biran gidin, al7o shuchan woyko mithan gidin, maatan woyko maqan keexiko, <verse eid="1CO 3:12"/><verse number="13" style="v" sid="1CO 3:13"/>issi issi asi he baasuwa bolla aybin keexidako pirda gallas taman paacetidi qoncana. <verse eid="1CO 3:13"/><verse number="14" style="v" sid="1CO 3:14"/>Oonika he baasuwa bolla keexida keethay taman xuugetonna attiko, ba woytuwa ekana. <verse eid="1CO 3:14"/><verse number="15" style="v" sid="1CO 3:15"/>Shin oodde oosoyka taman xuugetiko, he uraas woytoy baawa. Gidoshin, I ba huuphen tamape kessi ekida asada attana.<verse eid="1CO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16"/>Hinte Xoossa keethi gideysanne Xoossa Ayyaani hintenan de7eysa ereketii? <verse eid="1CO 3:16"/><verse number="17" style="v" sid="1CO 3:17"/>Oonika Xoossaa keethi laalliko, Xoossi iya laallana. Xoossa keethi geeshshi; he keethayka hintena.<verse eid="1CO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18"/>Oonika bana cimmofo. Ha sa7aa cincatethan bana cinca oothidi ekiya oonika Xoossaa sinthan cinca gidanaw eeya gido. <verse eid="1CO 3:18"/><verse number="19" style="v" sid="1CO 3:19"/>Ha sa7a cincatethay Xoossa sinthan eeyatethi. Geeshsha Maxaafan,</para>
  <para style="q1" vid="1CO 3:19">“Xoossay cincata enta gene qofan oykees” yaagees.<note caller="-" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="JOB 5:13">Iyyo 5:13</ref>.</char></note><verse eid="1CO 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="1CO 3:20"/>Qassi, “Cincata qofay maaddonnaba gideysa Goday erees” yaagees.<note caller="-" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="PSA 94:11">Maz 94:11</ref>.</char></note><verse eid="1CO 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 3:21"/>Hessa gisho, ubbay hintebaa gidiya gisho, oonika asan ceeqetofo. <verse eid="1CO 3:21"/><verse number="22" style="v" sid="1CO 3:22"/>Phawuloosi, Aphiloosinne Phexroosi, ha alamey, de7oy, hayqoy, ha77i de7ey, sinthafe yaanaysi, ubbay hintesa. <verse eid="1CO 3:22"/><verse number="23" style="v" sid="1CO 3:23"/>Hinte Kiristoosassa; Kiristoosi Xoossasa.<verse eid="1CO 3:23"/></para>
  <chapter eid="1CO 3"/>
  <chapter number="4" style="c" sid="1CO 4"/>
  <para style="s1">Kiristoosa Hawaareta</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1"/>Asay nuna Kiristoosa aylledanne Xoossa xuura qoncisanaw hadari imetida asada oothidi qopo. <verse eid="1CO 4:1"/><verse number="2" style="v" sid="1CO 4:2"/>Hadara ekida asati banta Godaas ammanetidaysata gidanaw bessees. <verse eid="1CO 4:2"/><verse number="3" style="v" sid="1CO 4:3"/>Shin hinte woyko hari tana pirdiko, taw aykoka gidenna. Hari attoshin, taka ta bolla pirdike. <verse eid="1CO 4:3"/><verse number="4" style="v" sid="1CO 4:4"/>Ta kahay geeshshi, shin hessi taani polo xillo gideysa bessenna. Ta bolla pirdanay Godaa xalaala. <verse eid="1CO 4:4"/><verse number="5" style="v" sid="1CO 4:5"/>Hessa gisho, wodey gakonna, Goday yoonna oodde bollaka pirdofite. I dhuman geemmidaba poo7on kessenna; asa wozanan qosetida qofa qoncisana. He wode, issoy issoy Xoossafe galataa ekana.<verse eid="1CO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6"/>Ta ishato, hinte gisho, tananne Aphiloosa, hintew leemiso oothada odas. Hessa ta oothiday, “Xaafetidaysafe aadhofa” giya zoriya hinte nuupe tamaarana melasa. Hessa gisho, oonika issuwa sabidi hankuwa kadhanaw bessenna. <verse eid="1CO 4:6"/><verse number="7" style="v" sid="1CO 4:7"/>Ne haratape aybin aadhay? Neeni ekaboonabay aybi de7ii? Neeni ekidaba hara asape ekida gidiko, yaatin, ekiboonna asada ayis ceeqetay?<verse eid="1CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8"/>Ha77i hinte kallideta. Ha77i hinte duretideta. Nuuni bayna hinte xalaala kawotideta. Hinte tuma kawotidaba gidiyako, nuka hintera kawotanashin. <verse eid="1CO 4:8"/><verse number="9" style="v" sid="1CO 4:9"/>Taw, Xoossay nuna hawaareta, hayqos pirdetida asada, asa ubbaafe nuna guye aathida daanees. Nuuni ha alamiyas, kiitanchotasinne asaas kaassaba gidida.<verse eid="1CO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 4:10"/>Nuuni Kiristoosa gisho eeya gidida, shin hinte Kiristoosan cincata gidideta. Nuuni daaburancho, shin hinte mino gidideta. Hinte bonchetideta, shin nuuni tooshetida. <verse eid="1CO 4:10"/><verse number="11" style="v" sid="1CO 4:11"/>Ha77i gakanaw nu koshatoos, saamotoos, kallotoos, wadhetoos; daana soo dhaydi toylatoos. <verse eid="1CO 4:11"/><verse number="12" style="v" sid="1CO 4:12"/>Nuuni nu kushen oothidi aqoos. Nuna asi baaddiya wode anjoos; nuna goodiya wode danda7oos.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">Hawa 18:3</ref>.</char></note> <verse eid="1CO 4:12"/><verse number="13" style="v" sid="1CO 4:13"/>Nu bolla iitabaa odetiya wode lo77o qaala zaaros. Nu ha77i gakanaw ha alamiya pitonne wora yegetiya buure gidida.<verse eid="1CO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14"/>Taani hessa xaafiday, ta dosiya naytada, hintena zoranaw xaafasipe attishin, yeellayanaw gidenna. <verse eid="1CO 4:14"/><verse number="15" style="v" sid="1CO 4:15"/>Kiristoosan hintena dichiya taybope bolla gidida kaaletheysati de7ikoka, hintew daro aawati dookona. Ta hintena Kiristoos Yesuusa wongelan yelas. <verse eid="1CO 4:15"/><verse number="16" style="v" sid="1CO 4:16"/>Hiza, hinte tana leemiso oothidi kaallana mela hintena woossayis.<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="2CO 11:1">2 Qoro 11:1</ref>; <ref loc="PHP 3:17">Filphi 3:17</ref>.</char></note> <verse eid="1CO 4:16"/><verse number="17" style="v" sid="1CO 4:17"/>Hessa gisho, ammanetida, ta dosiya, Godan ta na7a, Ximotiyoosa hinteko kiittayis. I dumma dumma bessan de7iya woosa keethan taani tamaarsida, Kiristoosa Yesuusan de7iya, ta ogiya hintena hassayisana.<verse eid="1CO 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18"/>Taani hinteko yoonnaba daanin, otortiya issi issi asati de7oosona. <verse eid="1CO 4:18"/><verse number="19" style="v" sid="1CO 4:19"/>Shin Goday giiko, mata wode taani hinteko baana. He wode otoranchota haasaya xalaala gidonashin, enta wolqaaka erana. <verse eid="1CO 4:19"/><verse number="20" style="v" sid="1CO 4:20"/>Xoossaa kawotethay oda gidonashin, wolqa. <verse eid="1CO 4:20"/><verse number="21" style="v" sid="1CO 4:21"/>Taani hinteko xam7ara booye woyko siiqoranne ashke ayyaanara boo? Awusa dooretii?<verse eid="1CO 4:21"/></para>
  <chapter eid="1CO 4"/>
  <chapter number="5" style="c" sid="1CO 5"/>
  <para style="s1">Asaa Giddon De7iya Yeellaya Ooso</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1"/>Hinte giddon laymatethi de7eysi zigiretees. Hessa mela laymatethi hari attoshin, ammanonna asayka oothokona. Hinte giddon ba aawa machera tunida asi de7ees.<note caller="-" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="DEU 22:30">Zaare 22:30</ref>.</char></note> <verse eid="1CO 5:1"/><verse number="2" style="v" sid="1CO 5:2"/>Hinte hessan qiirotanawunne yeellatanaw bessenne, shin otortideta. Hessa mela borsoba oothida ura hinte giddofe kessanaw bessennee?<verse eid="1CO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 5:3"/>Taani ashon hintera doona ixikoka ayyaanan ta hintera de7ayis. Taani hintera de7iya asada hanada hessa mela oosuwa oothida ura bolla pirdas. <verse eid="1CO 5:3"/><verse number="4" style="v" sid="1CO 5:4"/>Nu Godaa Yesuus Kiristoosa sunthan hinte shiiqiya wode taani ayyaanan hintera daana. Hessan Godaa Yesuus Kiristoosa wolqay hintera gidana. <verse eid="1CO 5:4"/><verse number="5" style="v" sid="1CO 5:5"/>He ura nagara ashoy<note caller="+" style="f"><char style="fr" closed="false">5:5 </char><char style="fqa" closed="false">Nagara ashoy: </char><char style="ft" closed="false">Nagara medhoy woyko nagara asatethay.</char></note> dhaydi, iya ayyaanay Godaa Yesuusa pirda gallasan attana mela I, Xalahes aadhidi imeto.<verse eid="1CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6"/>Hinte ceeqoy lo77o gidenna. Guutha irshoy munuqa ubba dentheysa ereketiyee?<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="GAL 5:9">Gala 5:9</ref>.</char></note> <verse eid="1CO 5:6"/><verse number="7" style="v" sid="1CO 5:7"/>Hinte ha77i irshoy bayna munuqa gidana mela, hintefe nagara irsho kessite. Nuus Paasika dorse gidida Kiristoosi yarshetis.<note caller="-" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="EXO 12:5">Kessa 12:5</ref>.</char></note> <verse eid="1CO 5:7"/><verse number="8" style="v" sid="1CO 5:8"/>Hessi gisho, geneynne iitatethi de7iya irshora gidonashin, tumatethinne geeshshatethi de7iya uythara nu baaliya bonchoos.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EXO 13:7">Kessa 13:7</ref>; <ref loc="DEU 16:3">Zaare 16:3</ref>.</char></note><verse eid="1CO 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9"/>Ta kase xaafida dabdaabiyan hinte laymatiya asara gahetonna mela hintew odas. <verse eid="1CO 5:9"/><verse number="10" style="v" sid="1CO 5:10"/>Hessa guussay ha alamiyan de7iya laymateysatara woyko uuzetara woyko kaysotara woyko eeqa goyinneysatara polo gahetofite guussu gidenna. Hessa gidiko, ha alamiyape hinte keyanaw bessees shin attis. <verse eid="1CO 5:10"/><verse number="11" style="v" sid="1CO 5:11"/>Shin ammanayis yaagishe laymateysatara woyko uuzetara woyko eeqa goyinneysatara woyko cayeysatara woyko mathoteysatara woyko kaysotara gahetofite gada hintew odayis. Hessa mela asara hari attoshin, kathika moopite.<verse eid="1CO 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12"/>Woosa keethafe karera de7eyisata bolla pirdanaw tana aybe gathey? Woosa keethan de7eyisata bolla hinte pirdeketiyee? <verse eid="1CO 5:12"/><verse number="13" style="v" sid="1CO 5:13"/>Shin karera de7eyisata bolla Xoossay pirdana. He iitaba oothiya ura hinte giddofe kessite.<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="DEU 13:5">Zaare 13:5</ref>; <ref loc="DEU 17:7">17:7</ref>.</char></note><verse eid="1CO 5:13"/></para>
  <chapter eid="1CO 5"/>
  <chapter number="6" style="c" sid="1CO 6"/>
  <para style="s1">Asaa Giddon De7iya Mooto</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1"/>Hinte giddofe issoy issuwara mootoy de7iko, hessa ammaniya asaa sinthan pirdetanaysa aggidi, ammanonna asa sinthan pirdetanaw waanidi bii? <verse eid="1CO 6:1"/><verse number="2" style="v" sid="1CO 6:2"/>Ammaniya asay alame bolla pirdanaysa hinte ereketii? Yaatin, hinte alame bolla pirdiyaba gidiko, haysa mela guuthaba pirdanaw waanidi danda7eketii? <verse eid="1CO 6:2"/><verse number="3" style="v" sid="1CO 6:3"/>Nuuni kiitanchota bolla pirdanaysa ereketii? Yaatin, ha sa7a duussaba bolla pirdanaysi hintena waanidi xoonii? <verse eid="1CO 6:3"/><verse number="4" style="v" sid="1CO 6:4"/>Yaatin, hessa mela metoy hinte giddon medhetiko, woosa keetha ayfen kadhetida asa sinthan pirdetanaw waatidi efeetii? <verse eid="1CO 6:4"/><verse number="5" style="v" sid="1CO 6:5"/>Taani hintena yeellayanaw hessa gayis. Hinte giddon kacetida ishata sigethanaw danda7iya akeeka asi baawee? <verse eid="1CO 6:5"/><verse number="6" style="v" sid="1CO 6:6"/>Yaatin, issi ammaniya ishay hanko ammaniya isha pirda keethan ammanonna asaa sinthan mootanaw bessii?<verse eid="1CO 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7"/>Hiza, hinte issoy issuwa mootiyaba gidiko hessi hinte kundethaa bessees. Hessafe hinte qohetiko keehennee? Hinte cimetiko lo77ennee? <verse eid="1CO 6:7"/><verse number="8" style="v" sid="1CO 6:8"/>Shin hinte woli giddon ammaneysati, issoy issuwa qohetanne cimmeeta.<verse eid="1CO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 6:9"/>Geellati Xoossa kawotethi laattonaysa hinte ereketii? Hintena cimmofite; laymateysati woyko eeqa goyinneysati woyko laammeysati woyko addera addera gaheteysati, <verse eid="1CO 6:9"/><verse number="10" style="v" sid="1CO 6:10"/>woyko kaysoti woyko uuzeti woyko mathoteysati woyko cayeysati woyko bonqeysati Xoossa kawotethi laattokona. <verse eid="1CO 6:10"/><verse number="11" style="v" sid="1CO 6:11"/>Hintefe issi issi asati kase hessa mela. Shin ha77i, hinte Godaa Yesuus Kiristoosa sunthaninne Xoossaa Ayyaanan meecetideta; geeydeta; xillideta.<verse eid="1CO 6:11"/></para>
  <para style="s1">Hinte Asatethan Xoosse Bonchite</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12"/>Hinte, “Nu koydaba oothanaw danda7oos” yaageeta. Shin ubbay maaddenna. “Taani koydaba ubba oothanaw danda7ayis” yaageeta. Shin aybika tana haarenna. <verse eid="1CO 6:12"/><verse number="13" style="v" sid="1CO 6:13"/>Hinte, “Kathi ulosa; uloyka kathasa” yaageeta. Shin Xoossi uloka kathika dhaysanaysa ta hintew odayis. Nu asatethay Godasafe attishin, laymatethas gidenna. Godayka nu asatethasa. <verse eid="1CO 6:13"/><verse number="14" style="v" sid="1CO 6:14"/>Xoossay Godaa hayqope denthidaysada, nunaka hayqope ba wolqan denthana.<verse eid="1CO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15"/>Hinte asatethay Kiristoosa asatethafe issi bagga gideysa ereketii? Yaatin, taani Kiristoosa asatethafe issi bagga efada laymatetha asatethi gidana mela ootho? Hanenna! <verse eid="1CO 6:15"/><verse number="16" style="v" sid="1CO 6:16"/>Laymatiya addey, I gahetiya maccaseera issi asatethi gideysa ereketii? Geeshsha Maxaafan, “Enti nam7ay issi asatethi gidana” geetetidi xaafetis.<note caller="-" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Medhe 2:24</ref>.</char></note> <verse eid="1CO 6:16"/><verse number="17" style="v" sid="1CO 6:17"/>Shin Godaara issifiya asi iyara ayyaanan issino gidees.<verse eid="1CO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18"/>Laymatethafe haakite. Issi asi oothiya hara nagari iya asatethafe karera oosetees, shin laymatiya asi ba asatethaa bolla nagara oothees. <verse eid="1CO 6:18"/><verse number="19" style="v" sid="1CO 6:19"/>Hinte asatethay, Xoossay hintew immida hintenan de7iya Geeshsha Ayyaana keethi gideysa ereketii? Hinte hintebaa gideketa.<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="2CO 3:16">2 Qoro 3:16</ref>; <ref loc="2CO 6:16">2 Qoro 6:16</ref>.</char></note> <verse eid="1CO 6:19"/><verse number="20" style="v" sid="1CO 6:20"/>Xoossay hintena gaten shammis. Hessa gisho, hinte asatethan Xoosse bonchite.<verse eid="1CO 6:20"/></para>
  <chapter eid="1CO 6"/>
  <chapter number="7" style="c" sid="1CO 7"/>
  <para style="s1">Eko Gelobaa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1"/>Hinte taw xaafida dabdaabiyas zaaroy haysa. Issi asi maccas bochonna aggiko lo77o. <verse eid="1CO 7:1"/><verse number="2" style="v" sid="1CO 7:2"/>Shin laymatethafe attanaw issi issi addey macho eko; qassi issi issi maccasas azini de7o.<verse eid="1CO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 7:3"/>Azinay ba machees, qassi machiya ba azinaas bessiyaba kuntho. <verse eid="1CO 7:3"/><verse number="4" style="v" sid="1CO 7:4"/>Machees ba asatethaa bolla maati baawa, shin maati I azinasa. Hessadaka, azinas ba asatethaa bolla maati baawa, shin maati machesa. <verse eid="1CO 7:4"/><verse number="5" style="v" sid="1CO 7:5"/>Hinte woosan guutha wode gam7anaw zoretethan gidonna ixiko, issoy issuwa diggofite. Hessa gaason hintenatethaa haaranaw xoonetin, Xalahey hintena paaconna mela issife de7ite. <verse eid="1CO 7:5"/><verse number="6" style="v" sid="1CO 7:6"/>Shin taani hintena zoranaw haysa gaysipe attishin, kiita gidenna. <verse eid="1CO 7:6"/><verse number="7" style="v" sid="1CO 7:7"/>Asi ubbay taada macho ekonna de7iyako dosayis, shin Xoossi issuwas issuwas immida dumma imoti de7ees. Issuwas haysa mela hankuwas hessa mela imoti de7ees.<verse eid="1CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8"/>Macho ekiboonaysatasinne azina geliboonnaysatas qassi am7etas taani odey, taada de7ite gada zorayis. <verse eid="1CO 7:8"/><verse number="9" style="v" sid="1CO 7:9"/>Shin amon xuugeteysafe ekeysinne geleysi lo77o gidiya gisho, enti bantana haaranaw danda7onna ixiko, ekonne gelo.<verse eid="1CO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10"/>Taani ekidaysatanne gelidaysata haysada gada zorayis; tana gidike Goday kiittees; machiya ba azinaape shaaketofo.<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Maato 5:32</ref>; <ref loc="MAT 19:9">19:9</ref>; <ref loc="MRK 10:11-12">Mar 10:11-12</ref>; <ref loc="LUK 16:18">Luqa 16:18</ref>.</char></note> <verse eid="1CO 7:10"/><verse number="11" style="v" sid="1CO 7:11"/>Shin shaaketiko hara azina gelonna barka de7o woyko ba azinara sigeto. Azini ba machiw billofo.<verse eid="1CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12"/>Shin haratas Godaa gidonashin, taani haysada gayis. Ammanonna macha de7iya ammaniya azini de7iko, iya machiya iyara issife daanaw koyko iyo billofo. <verse eid="1CO 7:12"/><verse number="13" style="v" sid="1CO 7:13"/>Qassi ammanonna azini de7iya ammaniya macha de7iko, I azinay iira issife daanaw koyko iyape biletofo. <verse eid="1CO 7:13"/><verse number="14" style="v" sid="1CO 7:14"/>Ammanonna azini ba ammaniya mache baggara xillees; qassi ammanonna machiya ba ammaniya azina baggara xillawusu. Hessi bayneko, hinte nayti tuna gidoosona, shin ha77i enti geeshshi. <verse eid="1CO 7:14"/><verse number="15" style="v" sid="1CO 7:15"/>Shin ammanonna azinay woyko machiya billanaw koyko billo. Ammaniya machiya woyko azinay hessa melaban qashetokona. Xoossi nuna sarotethan daana mela xeegis. <verse eid="1CO 7:15"/><verse number="16" style="v" sid="1CO 7:16"/>Neno, ammaniya machete, neeni ammanonna ne azina ashshaneko ay eray? Woyko ammaniya azinaw, neeni ammanonna ne machiw ashshaneko ay eray?<verse eid="1CO 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17"/>Issi issi asi Goday iyaw immida imotadanne Xoossay iya xeegidaysada de7o. Woosa keetha ubban taani tamaarsiya wogay haysa. <verse eid="1CO 7:17"/><verse number="18" style="v" sid="1CO 7:18"/>Oonika qaxaretidi xeegetidaba gidiko, qaxaretonada hanopo. Qaxaretonna xeegetida oonika de7iko, qaxaretanaw koyopo. <verse eid="1CO 7:18"/><verse number="19" style="v" sid="1CO 7:19"/>Xoossa kiitaa polanaw besseesipe attishin, qaxaretin qaxaretonna aggin aykoka maaddenna.<verse eid="1CO 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 7:20"/>Issi issi asi Xoossay bana xeegiya wode de7eysada de7o. <verse eid="1CO 7:20"/><verse number="21" style="v" sid="1CO 7:21"/>Xoossay nena xeegiya wode neeni ayllee? Aykoy baawa hessas un7etofa. Shin neeni aylletethafe la77a keyanaw danda7iko la77a keya. <verse eid="1CO 7:21"/><verse number="22" style="v" sid="1CO 7:22"/>Aylle gididi de7ishe Godan xeegetida asi Godan aylletethafe la77a keyis. Hessadaka, aylle gidonna de7ishe, Godan xeegetida asi Kiristoosa aylle. <verse eid="1CO 7:22"/><verse number="23" style="v" sid="1CO 7:23"/>Xoossay hintena gaten shammida gisho asa aylle gidopite. <verse eid="1CO 7:23"/><verse number="24" style="v" sid="1CO 7:24"/>Ta ishato, hinte issoy issoy xeegetiya wode de7iya de7uwan Xoossara issife de7ite.<verse eid="1CO 7:24"/></para>
  <para style="s1">Am7etabanne Soyzibonaysatabaa</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25"/>Geela7otaba Goday tana kiittidabay baawa. Shin Goday taw immida maarotetha mela taani hintena zorayis. <verse eid="1CO 7:25"/><verse number="26" style="v" sid="1CO 7:26"/>Hiza, ha77i metuwa gisho, ekonna woyko gelonna duussi taw lo77o daanees. <verse eid="1CO 7:26"/><verse number="27" style="v" sid="1CO 7:27"/>Ne macho ekidaba gidiko, shaaketanaw koyopa. Neeni macho ekaboonaba gidiko, ekanaw koyopa. <verse eid="1CO 7:27"/><verse number="28" style="v" sid="1CO 7:28"/>Shin ne macho ekiko nagari baawa. Hessada geela7iya azina geliko nagari baawa. Shin ekiya geliya asaas ha sa7an daro metoy de7iya gisho hinte hessafe attana mela taani koyayis.<verse eid="1CO 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29"/>Ta ishato, ta gey hessa; wodey wuris. Hizape guye macha de7ey macho ekonnaada de7o. <verse eid="1CO 7:29"/><verse number="30" style="v" sid="1CO 7:30"/>Yeekeysati yeekonaada, ufayteysati ufaytonnaada, shammeysati aykoyka baynaada bantana taybo. <verse eid="1CO 7:30"/><verse number="31" style="v" sid="1CO 7:31"/>Ha sa7aa shalon maadeteysati maadetiboonada hano. Ha alamiya malay aadhana.<verse eid="1CO 7:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32"/>Hinte hirgi bayna daana mela ta dosayis. Macho ekiboonaysi Godaa ufaysanaw koya gisho, Godaaba qopees. <verse eid="1CO 7:32"/><verse number="33" style="v" sid="1CO 7:33"/>Shin macho ekidaysi ba machiw ufaysanaw koya gisho, ha sa7aba qopees. <verse eid="1CO 7:33"/><verse number="34" style="v" sid="1CO 7:34"/>Iya qofay nam7an shaaketees. Azina gelaboonna geela7iya ba asatethaninne ba shempuwan geeyada Godaa ufaysanaw koya gisho, Godaaba qopawusu. Shin azina gelidaara ba azina ufaysanaw koya gisho, sa7aba qopawusu. <verse eid="1CO 7:34"/><verse number="35" style="v" sid="1CO 7:35"/>Taani hessa hintew odey, hinte maadetana melasafe attishin, hintena un7ethanaw gidenna. Shin hinte qofay shaaketonna maaran de7idi Godaa ufaysiyaba hinte oothana mela taani odayis.<verse eid="1CO 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36"/>Oonika ba oychida geela7es gelo wodey aadhis gidi iyo agganaw qopiko, hessi qassi iw lo77o gidonnaysi iyaw si7etiko, ba koydaysa ootho; enti eketo, geleto; hessan nagari baawa. <verse eid="1CO 7:36"/><verse number="37" style="v" sid="1CO 7:37"/>Shin issi asi un7ethiyabay dhayin, ba wozanan minnidi, bana haaridi, ba oychida geela7iw ekenaw agganaw koyko loythis. <verse eid="1CO 7:37"/><verse number="38" style="v" sid="1CO 7:38"/>Hessa gisho, geela7iw ekiya uray lo77o oothis; qassi ekonna uray daro lo77o oothis.<verse eid="1CO 7:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39"/>Machiya ba azinay paxa de7iya wode ubban iyara qashetasu. Shin I azinay hayqiko, ba dosida azina gelanaw danda7awusu. Gidoshin, iya geliya addey ammaniya asi gidanaw bessees. <verse eid="1CO 7:39"/><verse number="40" style="v" sid="1CO 7:40"/>Ta qofan gidiko, iya gelonna de7iko ufaysan daana. Qassi taw, ta bolla Xoossa Ayyaani de7iya daanees.<verse eid="1CO 7:40"/></para>
  <chapter eid="1CO 7"/>
  <chapter number="8" style="c" sid="1CO 8"/>
  <para style="s1">Eeqas Yarshetida Kathaba</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1"/>Eeqas yarshetiya kathaba gidiko nu ubbay eroos. Eratethi otorsees, shin siiqoy dichees. <verse eid="1CO 8:1"/><verse number="2" style="v" sid="1CO 8:2"/>Oonika bana erayis gidi qopiko, I buroo eranaw besseysa eribeenna. <verse eid="1CO 8:2"/><verse number="3" style="v" sid="1CO 8:3"/>Shin oonika Xoosse siiqiko, I Xoossa matan eretidaysa.<verse eid="1CO 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4"/>Hessa gisho, eeqas yarshetida kathi muussaba gidiko, ha alamiyan Godi issi Xoossafe attishin, hari bayna gisho, eeqi pathonnaba gideysa nuuni eroos. <verse eid="1CO 8:4"/><verse number="5" style="v" sid="1CO 8:5"/>Xoosse gidonashin, saloninne sa7an xoosse geetetidi xeegetiya daro xoossatinne godati de7ikoka, <verse eid="1CO 8:5"/><verse number="6" style="v" sid="1CO 8:6"/>ubbaba medhida, nu iyabaa gidida, issi Xoossi, Aawi, nuus de7ees<note caller="-" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="DEU 6:4">Zaare 6:4</ref>; <ref loc="DEU 10:13">10:13</ref>.</char></note>. Ubbay iya baggara medhetida, nuka iya baggara de7o demmida issi Goday, Yesuus Kiristoosi nuus de7ees.<verse eid="1CO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7"/>Shin ha erey ubba matan deenna. Issi issi asay eeqa goyinnora meezetida gisho, kathi miya wode eeqas yarshetidaba oothidi ekoosona. He wode enta kahay daabura gidiya gisho tunees. <verse eid="1CO 8:7"/><verse number="8" style="v" sid="1CO 8:8"/>Shin kathi nuna Xoossara daboyenna. Nu moonna aggidi aykoka qohetoko; qassi midi dumma go7etoko.<verse eid="1CO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9"/>Shin hinte koydaba maanaw maati hintew de7ikoka hessi ammanon minnonna asata dhubonna mela naagetite. <verse eid="1CO 8:9"/><verse number="10" style="v" sid="1CO 8:10"/>Neeni nena erancho gada eeqas yarshetida kathi maanaw eeqa keethan uttidashin, ammanon minnonna asi nena be7iko, hessi eeqas yarshetida kathi I maana mela denthetheneyee? <verse eid="1CO 8:10"/><verse number="11" style="v" sid="1CO 8:11"/>Hiza, ne eratetha gaason Kiristoosi iya gisho hayqida, ammanon minnonna ne ishay dhayis. <verse eid="1CO 8:11"/><verse number="12" style="v" sid="1CO 8:12"/>Hessada oothidi, ammanon minnonna hinte ishata qohishenne enta kaha madunxisishe Kiristoosa qoheeta. <verse eid="1CO 8:12"/><verse number="13" style="v" sid="1CO 8:13"/>Hessa gisho, kathi ta isha dhubiyaba gidiko, I dhubetonna mela ubbaraka asho miike.<verse eid="1CO 8:13"/></para>
  <chapter eid="1CO 8"/>
  <chapter number="9" style="c" sid="1CO 9"/>
  <para style="s1">Hawaareta Maata</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1"/>Taani yeda de7iya asi gidikina? Ta hawaare gidikina? Taani nu Godaa Yesuus Kiristoosa be7abikina? Hinte Godan ta daabura ayfe gideketii? <verse eid="1CO 9:1"/><verse number="2" style="v" sid="1CO 9:2"/>Hinte Godaaba gidiya gisho, ta haratas hawaare gidonna ixikoka, hintew hawaare gideysas hinte marka.<verse eid="1CO 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3"/>Tana hawaare gidenna geysatas taani immiya zaaroy haysa. <verse eid="1CO 9:3"/><verse number="4" style="v" sid="1CO 9:4"/>Nu hintefe maanawunne uyanaw tuma nuus maati baawee? <verse eid="1CO 9:4"/><verse number="5" style="v" sid="1CO 9:5"/>Hanko hawaaretada, Godaa ishatadanne Phexroosada, ammaniya nu macheta ekidi hemetanaw nuus maati baawee? <verse eid="1CO 9:5"/><verse number="6" style="v" sid="1CO 9:6"/>Woyko oothidi aqanaw bessey taaranne Barnabaasa xalaalee? <verse eid="1CO 9:6"/><verse number="7" style="v" sid="1CO 9:7"/>Ba miishen wotaadaretathi oothey oonee? Woyko woyne tokidi, iyape ayfe moonnay oonee? Woyko wude heemmishe, he wudiyape maathi uyonnay oonee?<verse eid="1CO 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8"/>Taani hessa asa qofatho gaynayee? Muse higgey hessa geeneyee? <verse eid="1CO 9:8"/><verse number="9" style="v" sid="1CO 9:9"/>Muse Higgiyan, “Wuduman kathi yedhiya boora doona qachofa” geetetidi xaafetis. Yaatin Xoossay hessa booras qopidi odidee?<note caller="-" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="DEU 25:4">Zaare 25:4</ref>; <ref loc="1TI 5:18">1 Ximo 5:18</ref>.</char></note> <verse eid="1CO 9:9"/><verse number="10" style="v" sid="1CO 9:10"/>Xoossay hessa giday nuus qopidi gidennee? Ee, nu gishosa. Biitta goyeysinne katha geeshsheysi bana gakeysa ekana gidi ufaysan oothanaw bessees geetetidi tuma nu gisho xaafetis. <verse eid="1CO 9:10"/><verse number="11" style="v" sid="1CO 9:11"/>Nuuni hinte giddon ayyaana zerethi zerida gidiko, ashos koshshiyaba nu hintefe ekiko, hessi gitabayee?<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">Roome 15:27</ref>.</char></note> <verse eid="1CO 9:11"/><verse number="12" style="v" sid="1CO 9:12"/>Harati hessa hintefe ekanaw entaw maati de7iko, nuus entafe aadhiya maati deennee?</para>
  <para style="p" vid="1CO 9:12">Shin nuuni Kiristoosa wongelas dhube gidonna mela, ubbaba gencosipe attishin, he maatan go7etibooko. <verse eid="1CO 9:12"/><verse number="13" style="v" sid="1CO 9:13"/>Xoossa keethan oothiya asati banta katha xoossa keethafe ekeysa ereketii? Qassi yarsho bessan oothiya asati yarshuwafe ekeysa ereketii?<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="DEU 25:4">Zaare 25:4</ref>; <ref loc="1TI 5:18">1 Ximo 5:18</ref>.</char></note> <verse eid="1CO 9:13"/><verse number="14" style="v" sid="1CO 9:14"/>Hessadaka, wongela markateysati duussas koshshiyaba wongelape ekana mela Goday kiittis.<note caller="-" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">Maato 10:10</ref>; <ref loc="LUK 10:7">Luqa 10:7</ref>.</char></note><verse eid="1CO 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15"/>Shin taani ha maata ubban aykoka go7etabike. Taani hessa xaafiday ta maata bonchisanaw koyada gidenna. Oonika ta ceequwa hada oothanaape hayqoy taw lo77o. <verse eid="1CO 9:15"/><verse number="16" style="v" sid="1CO 9:16"/>Taani wongela odey kiitetida gishosafe attishin, tana ceeqisiyaba gidenna. Wongela odonna ixiko, tana ayye! <verse eid="1CO 9:16"/><verse number="17" style="v" sid="1CO 9:17"/>Taani wongela dosada odiko, taw woytoy de7ees. Shin taani wongela dosonna odiyaba gidiko, hessa Xoossi taw hadara immis. <verse eid="1CO 9:17"/><verse number="18" style="v" sid="1CO 9:18"/>Yaatin, ta woytoy aybee? Taani wongela odiya wode ta maatan go7etonna, wongela gatey bayna odeysi taw woyto.<verse eid="1CO 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19"/>Taani oodeska aylle gidike, shin darota maaddanaw ubbaas aylle gidas. <verse eid="1CO 9:19"/><verse number="20" style="v" sid="1CO 9:20"/>Taani Ayhudeta maaddanaw entara enta gidas. Ta huuphen higgefe garsan de7ike, shin higgefe garsan de7eyisata maaddanaw higgefe garsan de7iya asi gidas. <verse eid="1CO 9:20"/><verse number="21" style="v" sid="1CO 9:21"/>Xoossa higgiyafe kare keyonna, Kiristoosa higgiyas kiitetashe, higgey baynayisata maaddanaw higgey bayna asada hanas. <verse eid="1CO 9:21"/><verse number="22" style="v" sid="1CO 9:22"/>Taani daaburanchota maaddanaw daaburancho gidas. Taani issota issota maaddanaw ubbaara ubbaba hanas. <verse eid="1CO 9:22"/><verse number="23" style="v" sid="1CO 9:23"/>Taani wongela anjuwa shaaketanaw, wongela gisho, ha ubbaa hanas.<verse eid="1CO 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24"/>Wothan gaaddetiya ubbay woxees, shin issuwa xalaali woyto ekeysa ereketii? Hessada hinteka woyto ekanaw woxite. <verse eid="1CO 9:24"/><verse number="25" style="v" sid="1CO 9:25"/>Gaaddetiya asa ubbay ubbaban bantana haarees. Enti hessa daaburey dhayiya woyto ekanaasa. Shin nuuni daaburey merina woyto ekanaasa. <verse eid="1CO 9:25"/><verse number="26" style="v" sid="1CO 9:26"/>Hessa gisho, taani qofi bayna asada woxike. Carko yimpiya asada coo kushe yeddike. <verse eid="1CO 9:26"/><verse number="27" style="v" sid="1CO 9:27"/>Shin taani haratas wongela odidaape guye, taani ta huuphen yegetida asi gidonna mela ta asatethaa wolqan haarada taw kiitetana mela oothayis.<verse eid="1CO 9:27"/></para>
  <chapter eid="1CO 9"/>
  <chapter number="10" style="c" sid="1CO 10"/>
  <para style="s1">Eeqa Goyinnofite</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1"/>Ta ishato, taani hinte haysa akeekana mela koyayis. Nu mayzati ubbay shaarape garsara hemetidosona; ubbay abba pinnidosona.<note caller="-" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="EXO 13:21-22">Kessa 13:21-22</ref>; <ref loc="EXO 14:22-29">14:22-29</ref>.</char></note> <verse eid="1CO 10:1"/><verse number="2" style="v" sid="1CO 10:2"/>Enti Musera issifanaw shaaraninne abban xammaqetidosona. <verse eid="1CO 10:2"/><verse number="3" style="v" sid="1CO 10:3"/>Enti ubbay issi ayyaana kathi midosona.<note caller="-" style="x"><char style="xo" closed="false">10:3 </char><char style="xt" closed="false"><ref loc="EXO 16:35">Kessa 16:35</ref>.</char></note> <verse eid="1CO 10:3"/><verse number="4" style="v" sid="1CO 10:4"/>Qassi ubbay issi ayyaana ushsha uyidosona. Enti bantana kaalliya ayyaana zaallafe pultida ushsha uyidosona; he zaallayka Kiristoosa.<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="EXO 17:6">Kessa 17:6</ref>; <ref loc="NUM 20:11">Taybo 20:11</ref>.</char></note> <verse eid="1CO 10:4"/><verse number="5" style="v" sid="1CO 10:5"/>Shin Xoossay entafe darotan ufaytiboonna gisho, enta ahay mela biittan wodhidi attis.<note caller="-" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="NUM 14:29-30">Taybo 14:29-30</ref>.</char></note><verse eid="1CO 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6"/>Enti iitaba amotidaysada, nuka iitaba amottonna mela he ubbay nuus leemiso gidis.<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="NUM 11:4">Taybo 11:4</ref>.</char></note> <verse eid="1CO 10:6"/><verse number="7" style="v" sid="1CO 10:7"/>Geeshsha Maxaafan, “Asay maanawunne uyanaw uttidosona; qassi yexanaw dendidosona” geetetidaysada entafe issoti issoti eeqa goyinnidaysa mela hinte eeqa goyinnofite.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="EXO 32:6">Kessa 32:6</ref>.</char></note> <verse eid="1CO 10:7"/><verse number="8" style="v" sid="1CO 10:8"/>Entafe issoti issoti laymatidaysada nu laymatanaw bessenna. Hessa gaason entafe issi gallas laatamanne heedzu mukulay hayqis.<note caller="-" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="NUM 25:1-18">Taybo 25:1-18</ref>.</char></note> <verse eid="1CO 10:8"/><verse number="9" style="v" sid="1CO 10:9"/>Entafe issoti issoti Godaa paacidi shooshan duketidi hayqidaysada nu Godaa paacanaw bessenna.<note caller="-" style="x"><char style="xo" closed="false">10:9 </char><char style="xt" closed="false"><ref loc="NUM 21:5-6">Taybo 21:5-6</ref>.</char></note> <verse eid="1CO 10:9"/><verse number="10" style="v" sid="1CO 10:10"/>Entafe issoti issoti zuuzumidi hayqo ehiya kiitanchuwan dhayidaysada hinteka zuuzumofite.<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="NUM 16:41-49">Taybo 16:41-49</ref>.</char></note><verse eid="1CO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11"/>Ha enta bolla gakida ubbay nu naagetana mela nuus leemiso gidis. Qassi wode wursethaa bolla de7iya nuus timirte gidana mela ha ubbay xaafetis.<verse eid="1CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12"/>Hessa gisho, ta eqas giya oonika kundonna mela bana naago. <verse eid="1CO 10:12"/><verse number="13" style="v" sid="1CO 10:13"/>Ase ubbaa gakiya paacepe attishin, dumma paacey hintena gakibeenna. Hinte wolqay danda7eysafe aadhiya paacen hinte paacetonna mela aathidi immonna Xoossay ammanetidaysa. Hintena paacey gakiya wode he paaciya I hintena danda7isana. Qassi he paaciyape hinte keyana ogiya I giigisana.<verse eid="1CO 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14"/>Hiza, ta al7o ishato, eeqa goyinnofe haakite. <verse eid="1CO 10:14"/><verse number="15" style="v" sid="1CO 10:15"/>Hinte wozanaama asi gidida gisho ta haysa odayis. Taani geysi tuma gideysa hinte hinte huuphen pirdite. <verse eid="1CO 10:15"/><verse number="16" style="v" sid="1CO 10:16"/>Nuuni Xoossaa galatidi shaaketiya anjo xuu7ay Kiristoosa suuthara issifetethi de7eysa gidenneyee? Qassi nuuni bathiya uythay Kiristoosa ashuwara issifetethi de7eysa gidenneyee?<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">Maato 26:26-28</ref>; <ref loc="MRK 14:22-24">Mar 14:22-24</ref>; <ref loc="LUK 22:19-20">Luqa 22:19-20</ref>.</char></note> <verse eid="1CO 10:16"/><verse number="17" style="v" sid="1CO 10:17"/>Nuuni daro gidikoka uythay issino, nu he issi uytha shaaketiya gisho issi asatethi.<verse eid="1CO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18"/>Ane Isra7eele asay oothidaysa akeekite. Yarshetida yarshuwa meysati yarsho bessaara issifetethi baaweyee?<note caller="-" style="x"><char style="xo" closed="false">10:18 </char><char style="xt" closed="false"><ref loc="LEV 7:6">Leewe 7:6</ref>.</char></note> <verse eid="1CO 10:18"/><verse number="19" style="v" sid="1CO 10:19"/>Taani ay gaanaw koyada gayna? Eeqas yarshetida kathay woyko eeqay pathiyaba guusseyee? <verse eid="1CO 10:19"/><verse number="20" style="v" sid="1CO 10:20"/>Gidenna, enti yarshey Xoossas gidonashin, tuna ayyaanatasa. Hessa gisho, hintew tuna ayyaanatara issifetethi daana mela koyke.<note caller="-" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="DEU 32:17">Zaare 32:17</ref>.</char></note> <verse eid="1CO 10:20"/><verse number="21" style="v" sid="1CO 10:21"/>Hinte Godaa xuu7ape uyishe, qassi tuna ayyaanata xuu7ape uyanaw danda7eketa. Godaa gaytape mishe qassi tuna ayyaanata gaytape maanaw danda7eketa. <verse eid="1CO 10:21"/><verse number="22" style="v" sid="1CO 10:22"/>Nuuni hessa oothidi Godaa yiloyno? Nuuni iyape aadhiya minoyee?<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="DEU 32:21">Zaare 32:21</ref>.</char></note><verse eid="1CO 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23"/>Hinte, “Ubbabaa oothonna mela diggiyabay baawa” geeta, shin ubbay maaddenna. Hinte, “Ubbabaa oothonna mela diggiyabay baawa” geeta, shin ubbay dichenna.<note caller="-" style="x"><char style="xo" closed="false">10:23 </char><char style="xt" closed="false"><ref loc="2CO 6:12">2 Qoro 6:12</ref>.</char></note> <verse eid="1CO 10:23"/><verse number="24" style="v" sid="1CO 10:24"/>Issi issi asi, hara asi maaddiyaba qopanaw besseesipe attishin, bana maaddiyaba xalaala qopofo.<verse eid="1CO 10:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25"/>Hinte kaha sidhen gelsiya oysha denthonna giyan bayzetiya ashuwa coo miite. <verse eid="1CO 10:25"/><verse number="26" style="v" sid="1CO 10:26"/>Ayis giiko, sa7inne sa7an de7iya ubbay Godaaba.<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="PSA 24:1">Maz 24:1</ref>.</char></note><verse eid="1CO 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27"/>Issi ammanonna asi hintena imatanaw koydi xeegiko baanaw koyko biite. Hinte kahan medhetiya oyshan sidhonna hinte sinthe aathiyaba ubba miite. <verse eid="1CO 10:27"/><verse number="28" style="v" sid="1CO 10:28"/>Shin issi asi, “Haysi eeqas yarshetidaba” giiko, he hintew odida addiya gishonne kaha gisho he katha moopite. <verse eid="1CO 10:28"/><verse number="29" style="v" sid="1CO 10:29"/>Taani, kaha gisho gey, he hintew odida ura kaha guussufe attishin, hinte kaha gidenna.</para>
  <para style="p" vid="1CO 10:29">Hara asa kaha gisho gada taani ta la77atetha bolla ayis pirdo? <verse eid="1CO 10:29"/><verse number="30" style="v" sid="1CO 10:30"/>Taani miya katha Xoossa galatada miiko balidada ayis boretiyana?<verse eid="1CO 10:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31"/>Hiza, hinte ay miiko ay uyiko, woyko ay oothikoka ubbaba Xoossa bonchoos oothite. <verse eid="1CO 10:31"/><verse number="32" style="v" sid="1CO 10:32"/>Ayhudeta gidin Giriketa gidin woyko Xoossa woosa keethi gidin oodeska dhube gidopite. <verse eid="1CO 10:32"/><verse number="33" style="v" sid="1CO 10:33"/>Taani ubba wode darota ashshanaw enti maadetiya oge koyaysipe attishin tana maaddiya oge koyke.<verse eid="1CO 10:33"/></para>
  <para style="b"/>
  <chapter eid="1CO 10"/>
  <chapter number="11" style="c" sid="1CO 11"/>
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1"/>Taani Kiristoosa leemisuwa kaalleysada, hinteka tana kaallite.<note caller="-" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="2CO 4:16">2 Qoro 4:16</ref>; <ref loc="PHP 3:17">Filphi 3:17</ref>.</char></note><verse eid="1CO 11:1"/></para>
  <para style="s1">Goyinno Maara</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2"/>Hinte ubbaban tana qopiya gishonne taani tamaarsida timirtiya minthidi naagida gisho taani hintena galatayis. <verse eid="1CO 11:2"/><verse number="3" style="v" sid="1CO 11:3"/>Shin Kiristoosi adde ubbaas huuphe, addey maccasas huuphe, qassi Xoossi Kiristoosas huuphe gideysa hinte erana mela koyayis. <verse eid="1CO 11:3"/><verse number="4" style="v" sid="1CO 11:4"/>Ba huuphiya guuluntidi Xoosse woossiya woyko tinbite odiya addey ubbay huuphe gidida Kiristoosa toochees. <verse eid="1CO 11:4"/><verse number="5" style="v" sid="1CO 11:5"/>Ba huuphiya qaconna Xoosse woossiya woyko tinbite odiya maccasiya huuphe gidida ba azina toochawusu. Ba huuphiya qaconna maccasiya ba huuphiya meedetida maccasa mela.<verse eid="1CO 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 11:6"/>Maccasi ba huuphe kammonna ixiko, ba huuphiya qanxeto. Shin iw huuphe qanxoy woyko meedoy borso gidiko, ba huuphiya qaco. <verse eid="1CO 11:6"/><verse number="7" style="v" sid="1CO 11:7"/>Addey Xoossa leemisonne Xoossa boncho gidiya gisho, ba huuphiya kammanaw bessenna, shin maccasi addes boncho.<note caller="-" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="GEN 1:26-27">Medhe 1:26-27</ref>.</char></note> <verse eid="1CO 11:7"/><verse number="8" style="v" sid="1CO 11:8"/>Maccasi addefe medhetasupe attishin, addey maccasape medhetibeenna.<note caller="-" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="GEN 2:18-23">Medhe 2:18-23</ref>.</char></note> <verse eid="1CO 11:8"/><verse number="9" style="v" sid="1CO 11:9"/>Maccasi addes medhetisipe attishin, addey maccasas medhetibeenna. <verse eid="1CO 11:9"/><verse number="10" style="v" sid="1CO 11:10"/>Haysa gishonne kiitanchota gisho maccasi baw maati de7eysa bessiya malla ba huuphen qacanaw bessees.<verse eid="1CO 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 11:11"/>Shin Godaa qofan maccasi addey bayna deenna; addeyka maccasi bayna deenna. <verse eid="1CO 11:11"/><verse number="12" style="v" sid="1CO 11:12"/>Maccasi addefe medhetidaysada addeyka maccasape yeletis. Shin ubbayka Xoossafe medhetis.<verse eid="1CO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13"/>Ane hinte pirdite; maccasi ba huuphe kammonna Xoossa woossanaw bessii? <verse eid="1CO 11:13"/><verse number="14" style="v" sid="1CO 11:14"/>Addey ba huuphiya dichiko iyaw borso gideysa hari attoshin medhetethi hintena tamaarsennee? <verse eid="1CO 11:14"/><verse number="15" style="v" sid="1CO 11:15"/>Shin maccasi ba huuphe dichiko iw boncho gidennee? Maccasas huuphey imetiday iya bana kammana melasa. <verse eid="1CO 11:15"/><verse number="16" style="v" sid="1CO 11:16"/>Shin haysa bolla palamanaw koya asi de7iko, nuus gidin woyko Xoossa woosa keethatas gidin haysafe hara wogi baawa.<verse eid="1CO 11:16"/></para>
  <para style="s1">Godaa Kaho Eko Maara</para>
  <para style="r">(<ref loc="MAT 26:26-29">Maato 26:26-29</ref>; <ref loc="MRK 14:22-25">Mar 14:22-25</ref>; <ref loc="LUK 22:14-20">Luqa 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17"/>Hinte issife shiiqey go77as gidonashin qohos gidiya gisho, ha77i taani immiya kiitan hintena nashike. <verse eid="1CO 11:17"/><verse number="18" style="v" sid="1CO 11:18"/>Taani koyro si7iday, woosa keethan shiiqiya wode hinte giddon shaaketethi de7eysa. Ha ta si7idaysi tuma gideysa ammanayis. <verse eid="1CO 11:18"/><verse number="19" style="v" sid="1CO 11:19"/>Hinte giddofe tumi de7eysati oonanteko eretana mela hinte giddon shaahoy daanaysi attenna. <verse eid="1CO 11:19"/><verse number="20" style="v" sid="1CO 11:20"/>Hinte issife shiiqiya wode hinte shiiqey Godaa kahuwa maanasa gidenna. <verse eid="1CO 11:20"/><verse number="21" style="v" sid="1CO 11:21"/>Hinte kathi miya wode issoy issuwa naagonna baysa baysa miya gisho, issoy koshatees hankoy qassi mathotees. <verse eid="1CO 11:21"/><verse number="22" style="v" sid="1CO 11:22"/>Tuma hinte maanawunne uyanaw hintew keethi baawee? Woyko Xoossa woosa keethi kadheetii? Aykoy bayna manqota yeellayetii? Ta hintena woygo? Haysas ta hintena nashoyee? Nashshike.<verse eid="1CO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23"/>Taani hintew immida timirtiya Godaape ekas. Goday Yesuusi aadhidi imetiya qamma uythu ekidi, <verse eid="1CO 11:23"/><verse number="24" style="v" sid="1CO 11:24"/>Xoossaa galatis. Uythaa bathidi “He7ite; miite. Haysi hintew imetiya ta ashuwa. Haysa mishe tana hassayite” yaagis. <verse eid="1CO 11:24"/><verse number="25" style="v" sid="1CO 11:25"/>Hessadaka, kahuwa midi simmin, xuu7aa ekidi, “Haysi xuu7ay ta suuthan eqiya ooratha caaquwa. Hinte iyape uyaa wode ubban tana hassayite” yaagis.<note caller="-" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="EXO 24:6-8">Kessa 24:6-8</ref>; <ref loc="JER 31:31-34">Ermi 31:31-34</ref>.</char></note> <verse eid="1CO 11:25"/><verse number="26" style="v" sid="1CO 11:26"/>Hinte ha uytha miya wodenne ha xuu7a uyaa wode ubban Goday yaana gakanaw iya hayquwa odeeta.<verse eid="1CO 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 11:27"/>Hessa gisho, bessonna ogen Godaa uytha miya woyko Godaa xuu7a uya oonika iya ashuwanne suutha toochida gisho ba nagaran oyshetees. <verse eid="1CO 11:27"/><verse number="28" style="v" sid="1CO 11:28"/>Shin asi bana paaco. Yaatidi uytha mo; xuu7ape uyo. <verse eid="1CO 11:28"/><verse number="29" style="v" sid="1CO 11:29"/>Godaa ashuwaba shaakidi eronna, uytha meynne xuu7ape uyey, ba bolla pirda meesinne uyees. <verse eid="1CO 11:29"/><verse number="30" style="v" sid="1CO 11:30"/>Hessa gisho, hinte giddofe daroti daaburidosona; hargidosona; qassi undenna asati hayqidosona. <verse eid="1CO 11:30"/><verse number="31" style="v" sid="1CO 11:31"/>Shin nuuni nuna paacidi be7idaba gidiyako, nu bolla pirdetanashin. <verse eid="1CO 11:31"/><verse number="32" style="v" sid="1CO 11:32"/>Alamey pirdetiya wode nuuni alamiyara pirdetonna mela ha77i Goday nuna seerees.<verse eid="1CO 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33"/>Hessa gisho, ta ishato, Godaa kahuwa ekanaw hinte shiiqiya wode issoy issuwa naagidi ekite. <verse eid="1CO 11:33"/><verse number="34" style="v" sid="1CO 11:34"/>Hinte shiiqoy pirdas gidonna mela koshatida oonika de7iko, ba son mo.</para>
  <para style="p" vid="1CO 11:34">Attidaba taani yaa bada hintew odana.<verse eid="1CO 11:34"/></para>
  <chapter eid="1CO 11"/>
  <chapter number="12" style="c" sid="1CO 12"/>
  <para style="s1">Geeshsha Ayyaana Imotata</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1"/>Ta ishato, Geeshsha Ayyaana imotataba hinte erana mela ta koyas. <verse eid="1CO 12:1"/><verse number="2" style="v" sid="1CO 12:2"/>Hinte Xoossaa ammanonna wode dooni bayna eeqatan gooshetidi, hinte eronna soo bidaysa ereeta. <verse eid="1CO 12:2"/><verse number="3" style="v" sid="1CO 12:3"/>Xoossaa Ayyaanay kaalethiya asi oonika, “Yesuusi baadeto” yaagenna. Qassi Geeshsha Ayyaanay kaalethonna de7ishin, oonika, “Yesuusi Godaa” gaanaw danda7onaysa hinte erana mela koyayis.<verse eid="1CO 12:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4"/>Dumma dumma Ayyaana imotati de7oosona, shin imotata immiya Ayyaanay issuwa.<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="ROM 12:6-8">Roome 12:6-8</ref>.</char></note> <verse eid="1CO 12:4"/><verse number="5" style="v" sid="1CO 12:5"/>Nu Godaas oothiya dumma dumma oosoti de7oosona, shin Goday issuwa. <verse eid="1CO 12:5"/><verse number="6" style="v" sid="1CO 12:6"/>Nu Godaas oothiya dumma dumma ogeti de7oosona, shin he ogetan oothiya asa ubban oothiya Xoossay issuwa. <verse eid="1CO 12:6"/><verse number="7" style="v" sid="1CO 12:7"/>Shin issuwas issuwas imetida imotatan harata maaddana mela Geeshsha Ayyaanay qoncees.<verse eid="1CO 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 12:8"/>Geeshsha Ayyaanay issuwas cincatethi kumida qaala immees; qassi issuwas eratethi kumida qaala immees. <verse eid="1CO 12:8"/><verse number="9" style="v" sid="1CO 12:9"/>He Geeshsha Ayyaanay issuwas ammano, hankuwas qassi pathiya wolqaa immees. <verse eid="1CO 12:9"/><verse number="10" style="v" sid="1CO 12:10"/>Geeshsha Ayyaanay issuwas malaata oothiya wolqaa, issuwas tinbite odiya wolqaa immees. Issuwas ayyaanape ayyaana shaaki eriya wolqaa, issuwas dumma dumma doonan odiya wolqaa, qassi issuwas dumma dumma doonan odetidaysa birshiya wolqaa immees. <verse eid="1CO 12:10"/><verse number="11" style="v" sid="1CO 12:11"/>Shin ha ubbaa oothey he issi Geeshsha Ayyaana. I koyiya mela issi issi asaas dumma dumma imota immees.<verse eid="1CO 12:11"/></para>
  <para style="s1">Asatethinne Billiteta</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12"/>Issi asatethan daro billiteti de7oosona, shin he dumma dumma billiteti issi asatethi gidoosona. Hessadaka, Kiristoosi dumma dumma billiteti de7iya asatethaa mela.<note caller="-" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="ROM 12:4-5">Roome 12:4-5</ref>.</char></note> <verse eid="1CO 12:12"/><verse number="13" style="v" sid="1CO 12:13"/>Nuuni Ayhude gidin Girike gidin aylle gidin womaanno gidin, ubbay issi asatethi gidanaw Geeshsha Ayyaanan xammaqetida. Qassi nu ubbay issi Geeshsha Ayyaana ekida.<verse eid="1CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14"/>Nu asatethan dumma dumma billiteti de7oosonape attishin, issi billite gidenna. <verse eid="1CO 12:14"/><verse number="15" style="v" sid="1CO 12:15"/>Tohoy, “Taani kushe gidonna gisho billite gidike” giiko, I hessa gida gisho billitetethay attiyee? <verse eid="1CO 12:15"/><verse number="16" style="v" sid="1CO 12:16"/>Haythi, “Taani ayfe gidonna gisho billite gidike” giiko, I hessa gida gisho asatethafe issi billite gideysi attiyee? <verse eid="1CO 12:16"/><verse number="17" style="v" sid="1CO 12:17"/>Asatetha ubbay ayfe xalaala gididaako, nu aybin si7anee? Qassi asatethi ubbay haytha xalaala gididaako nu aybin singanee?<verse eid="1CO 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 12:18"/>Shin Xoossay ba koydaysada, asatethaa giddon dumma dumma billiteta wothis. <verse eid="1CO 12:18"/><verse number="19" style="v" sid="1CO 12:19"/>Ubbay issi billite gididaako asatethi waanidi daanee? <verse eid="1CO 12:19"/><verse number="20" style="v" sid="1CO 12:20"/>Shin billiteti daro gidikoka, asatethay issuwa.<verse eid="1CO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21"/>Ayfey kusheko, “Ne taw koshshaka” gaanaw danda7enna. Woyko huuphey tohoko, “Ne taw koshshaka” gaanaw danda7enna. <verse eid="1CO 12:21"/><verse number="22" style="v" sid="1CO 12:22"/>Shin daabura daaniya asatethaa billiteti nuus aadhidi koshshosona. <verse eid="1CO 12:22"/><verse number="23" style="v" sid="1CO 12:23"/>Boncho koshshenna gidi nu qopiya nu billitetape baggata daro bonchoos. Qassi nu borsetiya nu asatethaa billiteta aathidi bonchidi naagoos. <verse eid="1CO 12:23"/><verse number="24" style="v" sid="1CO 12:24"/>Nu be7in borsonna asatethaa billitetas boncho koshshenna. Shin Xoossay nu asatethaa billiteta wolira gasethidi borsiya billitetas aadhiya boncho immis. <verse eid="1CO 12:24"/><verse number="25" style="v" sid="1CO 12:25"/>Asatetha billiteti issoy issuwara shaako medhonna wolis qopana mela oothidi medhis. <verse eid="1CO 12:25"/><verse number="26" style="v" sid="1CO 12:26"/>Asatetha billitetape issoy saketiko billiteti ubbay iyara saketoosona. Asatetha billitetape issoy bonchetiko billiteti ubbay iyara ufaytoosona.<verse eid="1CO 12:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27"/>Hinte ubbay Kiristoosa asatethi; qassi hinte issoy issoy iya billiteta. <verse eid="1CO 12:27"/><verse number="28" style="v" sid="1CO 12:28"/>Woosa keethan Xoossay, koyro hawaareta, nam7antho nabeta, heedzantho astamaareta, kaallidi malaata ootheyisata, patheyisata, harata maaddeyisata, woosa keetha ayseysatanne, dumma dumma doonan odeteyisata wothis.<note caller="-" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">Efe 4:11</ref>.</char></note><verse eid="1CO 12:28"/></para>
  <para style="m">
    <verse number="29" style="v" sid="1CO 12:29"/>Ubbay hawaaree? Ubbay nabee? Ubbay astamaaree? Ubbay malaata oothii? <verse eid="1CO 12:29"/><verse number="30" style="v" sid="1CO 12:30"/>Ubbay pathiyee? Ubbay dumma dumma doonan odeetii? Ubbay dumma dumma doonan odetoysa birshii? <verse eid="1CO 12:30"/><verse number="31" style="v" sid="1CO 12:31"/>Shin ubbaafe aadhiya imota minthidi koyite.</para>
  <para style="p" vid="1CO 12:31">Qassi ubbaafe aadhiya ogiya ta hintena bessaana.<verse eid="1CO 12:31"/></para>
  <chapter eid="1CO 12"/>
  <chapter number="13" style="c" sid="1CO 13"/>
  <para style="s1">Tuma Siiqo</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1"/>Taani asa qaalanne kiitancho qaala odetanaw danda7ikoka, taw siiqoy dhayiko, coo giiriya daala mela. <verse eid="1CO 13:1"/><verse number="2" style="v" sid="1CO 13:2"/>Tinbite odiya imoti taw de7ikoka, xuura ubbaa erikoka, eratethi ubbay de7ikoka, qassi deriya denthidi haraso efiya ammanoy taw de7ikoka, siiqoy dhayiko, ta aykoka gidike.<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Maato 17:20</ref>; <ref loc="MAT 21:21">21:21</ref>; <ref loc="MRK 11:23">Mar 11:23</ref>.</char></note> <verse eid="1CO 13:2"/><verse number="3" style="v" sid="1CO 13:3"/>Taw de7iyaba ubbaa manqotas immikoka, hari attoshin, tana tamas aatha immikoka, siiqoy dhayiko tana aykoka maaddenna.<verse eid="1CO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4"/>Siiqoy danda7ancho. Siiqoy keeha. Siiqoy qanaatenna. Siiqoy ceeqetenna. Siiqoy otorenna. <verse eid="1CO 13:4"/><verse number="5" style="v" sid="1CO 13:5"/>Siiqoy bessonnaba oothenna. Siiqoy uuzetenna. Siiqoy yilotenna. Siiqoy ba qoho paydenna. <verse eid="1CO 13:5"/><verse number="6" style="v" sid="1CO 13:6"/>Siiqoy tuman ufaytesipe attishin, wordon ufaytenna. <verse eid="1CO 13:6"/><verse number="7" style="v" sid="1CO 13:7"/>Siiqoy ubbaa danda7ees; ubbaa ammanees; lo77obay hanana gidi, ufaysan naagees; ubbaa gencees.<verse eid="1CO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8"/>Siiqoy wursethi gakanaw dhayenna. Shin tinbitey attana; dumma dumma doonan odeteysi attana; eratethika aadhana. <verse eid="1CO 13:8"/><verse number="9" style="v" sid="1CO 13:9"/>Nu eratethaafe guuthi eroos; tinbitepe baggaa odoos. <verse eid="1CO 13:9"/><verse number="10" style="v" sid="1CO 13:10"/>Shin polo gididaysi yaa wode polo gidonnaysi attana.<verse eid="1CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11"/>Taani na7a de7iya wode na7ada haasayis; na7ada qopayis; na7ada akeekayis. Ta kahaamida wode na7atetha hanuwa aggas. <verse eid="1CO 13:11"/><verse number="12" style="v" sid="1CO 13:12"/>Ha77i poo7oy bayna son mastooten be7eysada be7oos, shin he wode nu qoncen be7ana. Ha77i nu eratethaafe guutha eroos, shin he wode Xoossay nuna ereysada polo erana.<verse eid="1CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13"/>Hiza, ammanoy, ufaysinne siiqoy, ha heedzati eqidi daana. Shin haysatape aadhey siiqo.<verse eid="1CO 13:13"/></para>
  <chapter eid="1CO 13"/>
  <chapter number="14" style="c" sid="1CO 14"/>
  <para style="s1">Tinbitenne Dumma Dumma Doona</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1"/>Siiqo kaallite. Ayyaana imotata minthidi koyite; ubbaafe aathidi, tinbite imota minthidi koyite. <verse eid="1CO 14:1"/><verse number="2" style="v" sid="1CO 14:2"/>Dumma dumma doonan odetiya asi Xoossaas odeesipe attishin, asas odenna. Shin asas qonciboonna xuuraa Ayyaana wolqan odetiya gisho, oonika I odeteysa akeekenna. <verse eid="1CO 14:2"/><verse number="3" style="v" sid="1CO 14:3"/>Shin tinbite odeysati ase dichanaw, minthethanawunne minthanaw asas odees. <verse eid="1CO 14:3"/><verse number="4" style="v" sid="1CO 14:4"/>Dumma dumma doonan odiya asi bana dichees. Shin tinbite odiya asi woosa keethaa dichees.<verse eid="1CO 14:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5"/>Hinte ubbay dumma dumma doonan odetiyako ta dosayis, shin tinbite odanaysa aathada dosayis. Dumma dumma doonan odeteysa woosa keethi dichanaw birshiya asi dhayiko, dumma dumma doona odeteysafe tinbite odeysi aadhees.<verse eid="1CO 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 14:6"/>Shin ta ishato, taani hinteko bada, qoncethan woyko eratethan woyko tinbite odon woyko timirten gidonashin, dumma dumma doonan odetiko hintena ay maaddanee? <verse eid="1CO 14:6"/><verse number="7" style="v" sid="1CO 14:7"/>Dumma dumma yetha miishetas issi qommo girsi de7iko, suusul7e girsinne diitha girsi waatidi shaaki eranee? <verse eid="1CO 14:7"/><verse number="8" style="v" sid="1CO 14:8"/>Qassi moyze punoy geeyidi eretonna ixiko olas giigetey oonee? <verse eid="1CO 14:8"/><verse number="9" style="v" sid="1CO 14:9"/>Hessadaka, dumma dumma doonan hinte odeteysi qonce gidonna ixiko hinte odeysa ooni eranee? Hessi carkos odiya mela.<verse eid="1CO 14:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 14:10"/>Ha alamiyan daro doonati de7oosona; he ubbaas birshethi de7ees. <verse eid="1CO 14:10"/><verse number="11" style="v" sid="1CO 14:11"/>Shin issi asi odetiya doona taani eronna ixiko I taw imathe gidees; taka iyaw imathe gidayis. <verse eid="1CO 14:11"/><verse number="12" style="v" sid="1CO 14:12"/>Hessadaka, Geeshsha Ayyaana imota hinte ekanaw minthidi koyko, woosa keethi dichanaw ubbaafe aadhiya imota koyite.<verse eid="1CO 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13"/>Dumma dumma doonan odetiya asi ba odaa birshanaw birshetha imotay imetana mela Xoossaa woosso. <verse eid="1CO 14:13"/><verse number="14" style="v" sid="1CO 14:14"/>Taani dumma dumma doonan Xoossaa woossiko, ta ayyaanay woossees, shin ta wozanay aykoka go7etenna. <verse eid="1CO 14:14"/><verse number="15" style="v" sid="1CO 14:15"/>Yaatin, ta ay oothanaw koshshii? Taani ta ayyaanan woossayis; ta wozananka woossayis. Taani ta ayyaanan yexayis; ta wozananka yexayis. <verse eid="1CO 14:15"/><verse number="16" style="v" sid="1CO 14:16"/>Hessa gidonna ixiko neeni ne ayyaanan Xoossaa galatiya wode he bessan neeni geysa eronna asi ne galateysa woygidi, “Amin7i” gaanee? <verse eid="1CO 14:16"/><verse number="17" style="v" sid="1CO 14:17"/>Neeni Xoossaa galateysi lo77o, shin hara asi maaddenna.<verse eid="1CO 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18"/>Ta hinte ubbaafe aathada dumma dumma doonan odetiya gisho Xoossaa galatayis. <verse eid="1CO 14:18"/><verse number="19" style="v" sid="1CO 14:19"/>Shin taani woosa keethan harata tamaarsanaw dumma dumma doonan tammu mukulu qaala odetanaape ichashu qaala eretiya doonan odetanaw dosayis.<verse eid="1CO 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20"/>Ta ishato, hinte qofan naytada hanopite. Hinte iitabas naytada hanitepe attishin, hinte qofan kahaamata gidite. <verse eid="1CO 14:20"/><verse number="21" style="v" sid="1CO 14:21"/>Goday, Geeshsha Maxaafan,</para>
  <para style="q1" vid="1CO 14:21">“Taani ha asaas,</para>
  <para style="q2" vid="1CO 14:21">dumma dumma doonan odetiya asaaninne</para>
  <para style="q2" vid="1CO 14:21">imatha inxarsan odetiya asan odana.</para>
  <para style="q1" vid="1CO 14:21">Shin hessi haninika tana si7okona” yaagees.<note caller="-" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="ISA 28:11-12">Isa 28:11-12</ref>.</char></note><verse eid="1CO 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 14:22"/>Hiza, dumma dumma doonan haasayoy, ammanonna asaas malla gideesipe attishin, ammaniya asaasa gidenna. Tinbitey ammaniya asaas malla gideesipe attishin, ammanonna asaasa gidenna.<verse eid="1CO 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23"/>Woosa keethaa asay issife shiiqiya wode, ubbay dumma dumma doonan odetiko eronna woyko ammanonna asay hinte shiiquwa yidi, “Haysati gooyosona” gookonayee? <verse eid="1CO 14:23"/><verse number="24" style="v" sid="1CO 14:24"/>Shin eronna woyko ammanonna asay woosa keethi yaa wode asay tinbite odishin, si7iko ba nagaraa akeekana; qassi I si7ida qaalan pirdetana. <verse eid="1CO 14:24"/><verse number="25" style="v" sid="1CO 14:25"/>Enti iya wozanan geemmida qofaa qoncisana. Hessadaka, “Tuma Xoossay hinte giddon de7ees” yaagidi markatidi, gufannidi Xoossaas goyinnana.<verse eid="1CO 14:25"/></para>
  <para style="s1">Goyinno Maara</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26"/>Ta ishato, nu woygino? Hinte issife shiiqiya wode issuwas mazmurey de7ees; issuwas tamaarso imoti de7ees; issuwas qoncethi de7ees; issuwas dumma dumma doonan haasayoy de7ees; issuwas birshetha imoti de7ees. He ubbay woosa keethi dichiyaba gidanaw bessees. <verse eid="1CO 14:26"/><verse number="27" style="v" sid="1CO 14:27"/>Dumma dumma doonan odetiya asati de7iko, nam7a woyko dariko heedza gididi maaran maaran odetanaw bessees. Enti odeteysa hara asi birsho. <verse eid="1CO 14:27"/><verse number="28" style="v" sid="1CO 14:28"/>Shin birshiya asi dhayiko, dumma dumma doonan odeteysi woosa keethan si77i go. Bawunne ba Xoossaas odo.<verse eid="1CO 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 14:29"/>Tinbite odeysati nam7a woyko heedza gididi odo. Qassi harati enti giyaba pirdona. <verse eid="1CO 14:29"/><verse number="30" style="v" sid="1CO 14:30"/>He shiiquwan de7iya hara asas issibay qonciko kase odeteysi si77i go. <verse eid="1CO 14:30"/><verse number="31" style="v" sid="1CO 14:31"/>Ubbay tamaarana melanne ubbay minnana mela maaran maaran tinbite odanaw danda7eeta. <verse eid="1CO 14:31"/><verse number="32" style="v" sid="1CO 14:32"/>Nabeta ayyaanay nabetas kiitetees. <verse eid="1CO 14:32"/><verse number="33" style="v" sid="1CO 14:33"/>Geeshshata woosa keetha ubbay meezetidaysada Xoossay sarotetha Xoossaafe attishin, buqethi medhiya Xoossi gidenna.<verse eid="1CO 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="1CO 14:34"/>Maccasi woosa keethan si77i go. Muse higgey geysada enti haaretofe attishin, woosa keethan odanaw entaw maati baawa. <verse eid="1CO 14:34"/><verse number="35" style="v" sid="1CO 14:35"/>Maccasi woosa keethan haasayoy borso gidiya gisho issiba eranaw koyko son banta azinata oychonna.<verse eid="1CO 14:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36"/>Xoossaa qaala koyro hinte ehidetii? Woyko Xoossaa qaalay hinte xalaalako yidee? <verse eid="1CO 14:36"/><verse number="37" style="v" sid="1CO 14:37"/>Oonika bana nabe woyko bana Xoossaa asi gidi qopiko, taani hintew xaafeysi Godaa kiitta gideysa akeeko. <verse eid="1CO 14:37"/><verse number="38" style="v" sid="1CO 14:38"/>Shin oonika akeekona ixiko ika akeeketofo.<verse eid="1CO 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39"/>Hessa gisho, ta ishato, tinbite odanaw minthidi amotite; qassi dumma dumma doonan odeteysaka diggofite. <verse eid="1CO 14:39"/><verse number="40" style="v" sid="1CO 14:40"/>Shin ubbayka woganinne maaran gido.<verse eid="1CO 14:40"/></para>
  <chapter eid="1CO 14"/>
  <chapter number="15" style="c" sid="1CO 15"/>
  <para style="s1">Kiristoosi Hayqope Denduwa</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1"/>Ta ishato, ta hintew markatida wongela hinte ekidaysanne hinte ammanoy iyan eqidaysa hinte akeekana mela taani koyayis. <verse eid="1CO 15:1"/><verse number="2" style="v" sid="1CO 15:2"/>Ta tamaarsida wongela minthidi oykiko hinte iyan attana. Hessi hanonna ixiko hinte ammanoy hada gidana.<verse eid="1CO 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3"/>Taani ekida ubbaafe aadhiya kiitaa kasetada hintew immas. Hessika, Geeshsha Maxaafay geysada, Kiristoosi nu nagaraa gisho hayqis.<note caller="-" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="ISA 53:5-12">Isa 53:5-12</ref>.</char></note> <verse eid="1CO 15:3"/><verse number="4" style="v" sid="1CO 15:4"/>Moogetis; Geeshsha Maxaafay geysada, heedzantho gallasan hayqope dendis.<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="PSA 16:8-10">Maz 16:8-10</ref>; <ref loc="MAT 12:40">Maato 12:40</ref>; <ref loc="ACT 2:24-32">Hawa 2:24-32</ref>.</char></note> <verse eid="1CO 15:4"/><verse number="5" style="v" sid="1CO 15:5"/>Phexroosas qoncis. Hessafe guye, tammanne nam7u hawaaretas qoncis.<note caller="-" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="MAT 28:16-17">Maato 28:16-17</ref>; <ref loc="MRK 16:14">Mar 16:14</ref>; <ref loc="LUK 24:34">Luqa 24:34</ref>, <ref loc="LUK 24:36">36</ref>; <ref loc="JHN 20:19">Yoha 20:19</ref>.</char></note> <verse eid="1CO 15:5"/><verse number="6" style="v" sid="1CO 15:6"/>Hessafe guye, ichashu xeetape dariya asaas issitoho qoncis. Entafe dariya baggay ha77i gakanaw paxa de7oosona, shin guuthati hayqidosona. <verse eid="1CO 15:6"/><verse number="7" style="v" sid="1CO 15:7"/>Hessafe guye, Yayqoobas qoncis; guyepe ba hawaareta ubbaas qoncis.<verse eid="1CO 15:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8"/>Qassi wursethan awucaya mela gidida taw qoncis.<note caller="-" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">Hawa 9:3-6</ref>.</char></note> <verse eid="1CO 15:8"/><verse number="9" style="v" sid="1CO 15:9"/>Taani Yesuusa hawaareta ubbaafe laafa. Taani Xoossaa woosa keethaa gooddida gisho Yesuusa hawaare geetetada xeegetanaw bessonnaysa.<note caller="-" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Hawa 8:3</ref>.</char></note> <verse eid="1CO 15:9"/><verse number="10" style="v" sid="1CO 15:10"/>Shin Xoossaa aadho keehatethan ta ha77i gididaysa gidas; I taw immida aadho keehatethay mela attibeenna. Taani hanko hawaaretape aathada daaburas. Shin taara de7iya Xoossaa aadho keehatethay oothisipe attishin, tana gidike. <verse eid="1CO 15:10"/><verse number="11" style="v" sid="1CO 15:11"/>Hiza, tana gidin enti, nu ubbay tamaarsey hessa; hinteka he kiitaa ammanideta.<verse eid="1CO 15:11"/></para>
  <para style="s1">Hayqida Asi Hayqope Dendo</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12"/>Kiristoosi hayqope dendidaysa nu sabbakiya wode hintefe issoti issoti yaatin, woygidi, “Hayqope dendoy baawa” yaagona? <verse eid="1CO 15:12"/><verse number="13" style="v" sid="1CO 15:13"/>Hayqope dendoy baynaba gidiko Kiristoosi hayqope dendibeenna guussu. <verse eid="1CO 15:13"/><verse number="14" style="v" sid="1CO 15:14"/>Kiristoosi hayqope dendiboonaba gidiko nu timirtey qassi hinte ammanoyka hada. <verse eid="1CO 15:14"/><verse number="15" style="v" sid="1CO 15:15"/>Hayqope dendoy baynashin, nuuni Xoossay, “Kiristoosa hayqope denthis” yaagidi sabbakishe Xoossaa wordancho markata gidida guussu. <verse eid="1CO 15:15"/><verse number="16" style="v" sid="1CO 15:16"/>Hayqida asay hayqope dendiboonaba gidiko hiza, Kiristoosi hayqope dendibeenna. <verse eid="1CO 15:16"/><verse number="17" style="v" sid="1CO 15:17"/>Kiristoosi hayqope dendonaba gidiko, hinte ammanoy hada; qassi hinte ha77i gakanaw hinte nagaran de7eeta. <verse eid="1CO 15:17"/><verse number="18" style="v" sid="1CO 15:18"/>Hiza, Kiristoosa ammanidi hayqidaysatika dhayidosona guussu. <verse eid="1CO 15:18"/><verse number="19" style="v" sid="1CO 15:19"/>Nuuni ha alamiya de7uwa xalaalas Kiristoosan ufaysi oothidaba gidiko, ha sa7an de7iya asa ubbaafe nubay aadhida yibbata.<verse eid="1CO 15:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20"/>Shin Kiristoosi hayqidaysatas hayqope dendon bayra gididi tuma dendis. <verse eid="1CO 15:20"/><verse number="21" style="v" sid="1CO 15:21"/>Hayqoy issi asa baggara ha alamiya yidaysada hayqope dendoy issi asa baggara yis. <verse eid="1CO 15:21"/><verse number="22" style="v" sid="1CO 15:22"/>Addaame baggara asa ubbay hayqidaysada Kiristoosa baggara asa ubbay de7on daana. <verse eid="1CO 15:22"/><verse number="23" style="v" sid="1CO 15:23"/>Shin issoy issoy ba maaran maaran dendana. Kiristoosi ubbaafe kasetidi dendis; hessafe guye, Kiristoosaysati I yaa wode dendana.<verse eid="1CO 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 15:24"/>Hessafe guye, Kiristoosi halaqatethi, maatanne wolqa ubbaa dhaysidi, kawotethaa Xoossa Aawas immiya wode wodiya wursethay yaana. <verse eid="1CO 15:24"/><verse number="25" style="v" sid="1CO 15:25"/>Xoossay iya morketa ubbaa iya tohuwape garsan wothana gakanaw Kiristoosi haaranaw bessees.<note caller="-" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz 110:1</ref>.</char></note> <verse eid="1CO 15:25"/><verse number="26" style="v" sid="1CO 15:26"/>Wursethan I dhaysanaw de7iya morkey hayqo. <verse eid="1CO 15:26"/><verse number="27" style="v" sid="1CO 15:27"/>Geeshsha Maxaafan, “Xoossay ubbaba iya maatape garsan haarisis” geetetidi xaafetis. Shin ubbaa iya maatape garsan haarisis geysi, ubbaba iya maatape garsan haarisida Xoossaa gujenna.<note caller="-" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="PSA 8:6">Maz 8:6</ref>.</char></note> <verse eid="1CO 15:27"/><verse number="28" style="v" sid="1CO 15:28"/>Ubbabay Kiristoosa maatape garsan haaretidaape guye Kiristoosi qassi ba huuphen ubbaba baw haarisida Xoossaas haaretana. He wode Xoossay ba xalaala ubbaa haarana.<verse eid="1CO 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29"/>Hayqidaysati dendonaba gidiko enta gisho xammaqetiya asaas ayba wodhey de7ii? Hayqidaysati dendonaba gidiko yaatin, ayis, asay hayqidaysata gisho xammaqetoona?<verse eid="1CO 15:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="1CO 15:30"/>Yaatin, nuuni ayis ubba wode nunatethaa metos aathidi immoona? <verse eid="1CO 15:30"/><verse number="31" style="v" sid="1CO 15:31"/>Ta ishato, ta gallas gallas hayqos aadhada imetayis. Hessika, Godaa Kiristoos Yesuusan de7iya de7uwa issifetethan hintenan ceeqiya gishosa. <verse eid="1CO 15:31"/><verse number="32" style="v" sid="1CO 15:32"/>Asa qofatho gidiko, taani Efesoonan do7ara butetidaysi tana ay maaddii? Hayqidaysati hayqope dendonaba gidiko, “Wonto nu hayqiya gisho hachi maana uyana” giya asaa mela gidoos.<note caller="-" style="x"><char style="xo" closed="false">15:32 </char><char style="xt" closed="false"><ref loc="ISA 22:13">Isa 22:13</ref>.</char></note><verse eid="1CO 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33"/>Cimetofite! Iita laggetethi lo77o amale iissees. <verse eid="1CO 15:33"/><verse number="34" style="v" sid="1CO 15:34"/>Hinte akeekako simmite. Nagara oothopite. Hintefe issi issi asay Xoossaa erokona. Taani hintena yeellayanaw hessa gayis.<verse eid="1CO 15:34"/></para>
  <para style="s1">Dendo Asatethi</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35"/>Issi asi, “Hayqida asay waanidi dendanee? Enti ay mela asatethara yaanee?” yaagonna aggenna. <verse eid="1CO 15:35"/><verse number="36" style="v" sid="1CO 15:36"/>Neno eeyaw, neeni biittan zeriya zerethay hayqonna dolenna. <verse eid="1CO 15:36"/><verse number="37" style="v" sid="1CO 15:37"/>Neeni zerey giste gidin woyko hara katha qommo ayfe xalaala zerasaape attishin, dolida dolaa gidenna. <verse eid="1CO 15:37"/><verse number="38" style="v" sid="1CO 15:38"/>Shin Xoossay zerethaas ba dosida mela medhetethi immees. Dumma dumma zerethaas dumma dumma asatethi immees. <verse eid="1CO 15:38"/><verse number="39" style="v" sid="1CO 15:39"/>Medhetetha ubbaa ashoy isso gidenna. Shin asa ashoy issuwa; mehe ashoy dumma; kafota ashoy dumma; qassi molo ashoy dumma.<verse eid="1CO 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40"/>Salo asatethi de7ees; qassi sa7a asatethi de7ees. Shin salo asatethaa bonchoy dumma; qassi sa7a asatethaa bonchoy dumma. <verse eid="1CO 15:40"/><verse number="41" style="v" sid="1CO 15:41"/>Awa bonchoy dumma; ageena bonchoy dumma; xoolintota bonchoy dumma; issi xoolintoy hanko xoolintuwafe bonchon dummatees.<verse eid="1CO 15:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42"/>Hayqidaysati hayqope dendiya wode hessada hanana. Hayqiya asatethay zeretees; hayqonna asatethi gididi dendees. <verse eid="1CO 15:42"/><verse number="43" style="v" sid="1CO 15:43"/>Tooshen zeretidi, bonchon dendana; daaburan zeretidi, wolqan dendana. <verse eid="1CO 15:43"/><verse number="44" style="v" sid="1CO 15:44"/>Medhetetha asatethay zeretidi, ayyaana asatethi gididi dendana. Medheta asatethi de7iko, ayyaana asatethi<note caller="+" style="f"><char style="fr" closed="false">15:44 </char><char style="fqa" closed="false">Ayyaana asatethi: </char><char style="ft" closed="false">Geeshsha Ayyaanay haarida woyko Geeshsha Ayyaanay de7o immida asatethi guussu.</char></note> de7ees.<verse eid="1CO 15:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="1CO 15:45"/>Hessadaka, Geeshsha Maxaafan, “Koyro addey, Addaamey, paxa de7iya ase gididi medhetis”<note caller="-" style="x"><char style="xo" closed="false">15:45 </char><char style="xt" closed="false"><ref loc="GEN 2:7">Medhe 2:7</ref>.</char></note> yaagees. Shin wursetha Addaamey, Kiristoosi, de7o immiya ayyaana gidis. <verse eid="1CO 15:45"/><verse number="46" style="v" sid="1CO 15:46"/>Shin medheta asi koyro yin, guyepe ayyaana asi yisipe attishin, ayyaana asi koyro yibeenna. <verse eid="1CO 15:46"/><verse number="47" style="v" sid="1CO 15:47"/>Koyro Addaamey biittafe medhetida biitta asi; nam7antho Addaamey salope yida salo asi. <verse eid="1CO 15:47"/><verse number="48" style="v" sid="1CO 15:48"/>Biittafe medhetidaysati biittafe medhetidaysa daanosona. Saloysati salope yidaysa daanosona. <verse eid="1CO 15:48"/><verse number="49" style="v" sid="1CO 15:49"/>Nuuni biittafe medhetida addiya daaneysa mela salope yida addiya daanana.<verse eid="1CO 15:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50"/>Ta ishato, ta geysi hessa; ha77i nu ma7ida asatethay Xoossaa kawotethaa laattanaw danda7enna. Wooqiya asatethay wooqonna asatethaa laattenna.<verse eid="1CO 15:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51"/>Ta hintew issi xuura odana. Nu ubbay hayqoko, shin wursethan ubbay laametana. <verse eid="1CO 15:51"/><verse number="52" style="v" sid="1CO 15:52"/>Moyzey punetiya wode, ayfey qiphi xeellanaw hassayonna laametana. Hayqida asay wooqonna asi gididi dendana; nuka laametana.<note caller="-" style="x"><char style="xo" closed="false">15:52 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1 Tese 4:15-17</ref>.</char></note> <verse eid="1CO 15:52"/><verse number="53" style="v" sid="1CO 15:53"/>Haysi wooqeysi wooqonnaysa, haysi hayqeysi hayqonnaysa ma7anaw bessees.<verse eid="1CO 15:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="1CO 15:54"/>Haysi wooqeysi wooqonnaysa, qassi haysi hayqeysi hayqonnaysa ma7iya wode, Geeshsha Maxaafan, “Hayqoy xoonon mitetis”<note caller="-" style="x"><char style="xo" closed="false">15:54 </char><char style="xt" closed="false"><ref loc="ISA 25:8">Isa 25:8</ref>.</char></note> giya qaalay poletana. <verse eid="1CO 15:54"/><verse number="55" style="v" sid="1CO 15:55"/>Hessadaka,</para>
  <para style="q1" vid="1CO 15:55">“Hayqo, ne xoonoy awun de7ii?</para>
  <para style="q2" vid="1CO 15:55">Hayqo, ne qohiya wolqay awun de7ii?”<note caller="-" style="x"><char style="xo" closed="false">15:55 </char><char style="xt" closed="false"><ref loc="HOS 13:14">Hose 13:14</ref>.</char></note></para>
  <para style="m" vid="1CO 15:55">gida qaalay poletana. <verse eid="1CO 15:55"/><verse number="56" style="v" sid="1CO 15:56"/>Hayqoy dukiya wolqay nagara; qassi nagara wolqay higge. <verse eid="1CO 15:56"/><verse number="57" style="v" sid="1CO 15:57"/>Shin nu Godaa Yesuus Kiristoosa baggara nuus xoono immiya Xoossaa galati gako.<verse eid="1CO 15:57"/></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58"/>Hessa gisho, ta siiqo ishato, qaaxonna minnidi eqite. Godaa oosuwan hinte daabureysi coo gidonnaysa eridi ubba wode Godaa oosuwa azallonna oothite.<verse eid="1CO 15:58"/></para>
  <chapter eid="1CO 15"/>
  <chapter number="16" style="c" sid="1CO 16"/>
  <para style="s1">Ammaniya Asaas Shiiqida Imota</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1"/>Ammaniya asaas miishe shiishobaa Galatiya woosa keethatas taani kiittidaysada hinteka oothite.<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="ROM 15:25-26">Roome 15:25-26</ref>.</char></note> <verse eid="1CO 16:1"/><verse number="2" style="v" sid="1CO 16:2"/>Miishiya shiishoy ta hinteko biya wode gidonna mela issoy issoy saamintafe koyro gallas, wogga wode, wogga wode, ba demmeysafe kessidi ba son dagayo. <verse eid="1CO 16:2"/><verse number="3" style="v" sid="1CO 16:3"/>Taani yaa bida wode miishiya Yerusalaame gathana mela hinte dooriya asaas dabdaabe immada enta Yerusalaame kiittana. <verse eid="1CO 16:3"/><verse number="4" style="v" sid="1CO 16:4"/>Entara ta buussay koshshiyaba gidiko enti taara baanaw danda7oosona.<verse eid="1CO 16:4"/></para>
  <para style="s1">Phawuloosa Halcho</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5"/>Taani Maqedoonera aadhanaw qopida gisho, yaa bada hinteko yaana.<note caller="-" style="x"><char style="xo" closed="false">16:5 </char><char style="xt" closed="false"><ref loc="ACT 19:21">Hawa 19:21</ref>.</char></note> <verse eid="1CO 16:5"/><verse number="6" style="v" sid="1CO 16:6"/>Ta biya bessa aw gidikoka, ta buussan hinte tana maaddana mela hinte matan guutha wode gam7onna aggike. Balgo ageenata hinte matan aathona waaya aggana. <verse eid="1CO 16:6"/><verse number="7" style="v" sid="1CO 16:7"/>Taani ogera aadhashe hintena be7anaw koyke. Goday giiko, hinte matan guutha wode takanaw qopayis.<verse eid="1CO 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8"/>Shin taani Phanxeqosxe Ba7aaley gakanaw Efesoonan gam7ana. <verse eid="1CO 16:8"/><verse number="9" style="v" sid="1CO 16:9"/>Taw oosoy kumida dalga pengey dooyetis, shin daro eqetiya morketi de7oosona.<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">Leewe 23:15-21</ref>; <ref loc="DEU 16:9-11">Zaare 16:9-11</ref>; <ref loc="ACT 19:8-10">Hawa 19:8-10</ref>.</char></note><verse eid="1CO 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10"/>I ta mela Godaa ooso oothiya asi gidiya gisho, Ximotiyoosi hinteko biiko, hinte matan I hirgonna daana mela oothite.<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="2CO 4:17">2 Qoro 4:17</ref>.</char></note> <verse eid="1CO 16:10"/><verse number="11" style="v" sid="1CO 16:11"/>Oonika iya kadhopo. I taako saro simmana mela iya maaddidi moyzite. Taani I hanko ammaneysatara simmanaysa naagayis.<verse eid="1CO 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12"/>Nu ishaa Aphiloosi hanko ammaneysatara hinteko baana mela ta iya mintha woossas. Ha77i hinteko baanaw koybeenna, shin iyaw injetiya wode hinteko baana.<verse eid="1CO 16:12"/></para>
  <para style="s1">Zorenne Sarotho</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13"/>Barkite; Ammanon eqite; xaalite; minnite. <verse eid="1CO 16:13"/><verse number="14" style="v" sid="1CO 16:14"/>Ooso ubbaa siiqon oothite.<verse eid="1CO 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15"/>Ta ishato, Isxifaanoseynne iya soo asay Akayan enti koyro ammanidaysata gideysanne ammaneyisata maaddanaw bantana aathidi immidaysa hinte ereeta.<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="2CO 1:16">2 Qoro 1:16</ref>.</char></note> <verse eid="1CO 16:15"/><verse number="16" style="v" sid="1CO 16:16"/>Hinteka enta mela asaasinne, entara ooson daaburiya ubbaas kiitetana mela ta hintena woossayis.<verse eid="1CO 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17"/>Isxifaanosey, Ferdonaxisinne Akayqoosi taako yidaysi tana ufaysis. Hinte bayna bessan enti hintena gididi ta pacaa kunthidosona. <verse eid="1CO 16:17"/><verse number="18" style="v" sid="1CO 16:18"/>Enti hintena ufaysidaysada tanaka ufaysidosona. Hessa mela asata dogopite.<verse eid="1CO 16:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19"/>Iise woosa keetha asay hintena saro goosona. Aqilinne Phirisqilla banta son shiiqiya woosa keetha asaara issife hintena Godaa sunthan wozanape sarothoosona.<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">Hawa 18:2</ref>.</char></note> <verse eid="1CO 16:19"/><verse number="20" style="v" sid="1CO 16:20"/>Ammaniya ishati ubbay hintena saro yaagosona.</para>
  <para style="p" vid="1CO 16:20">Geeshsha yeeretethi yeeretishe issoy issuwa sarothite. <verse eid="1CO 16:20"/><verse number="21" style="v" sid="1CO 16:21"/>Taani, Phawuloosi, ha sarothuwa ta kushen xaafas.<verse eid="1CO 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22"/>Godaa dosonna asi de7iko, baadetidaysa gido. Nu Godaw, haaya!<verse eid="1CO 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23"/>Godaa Yesuus Kiristoosa aadho keehatethay hintera gido.<verse eid="1CO 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24"/>Ta siiqoy Kiristoos Yesuusan de7iya hinte ubbaara gido. Amin7i.<verse eid="1CO 16:24"/></para>
  <chapter eid="1CO 16"/>
</usx>
