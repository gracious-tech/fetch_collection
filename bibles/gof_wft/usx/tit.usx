<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Tito Kiita</para>
  <para style="toc1">Tito Kiita</para>
  <para style="toc3">Tito</para>
  <para style="toc2">Tito</para>
  <para style="mt1">Phawuloosi Titos</para>
  <para style="mt2">Xaafida Kiita</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Titoy Ayhude gidonna asi, shin guyepe ammanidi, Phawuloosi wongela oosuwa oothiya wode matan iya maaddida asi. He wode Titoy, woosa keetha xeellanawunne naaganaw Qarxeesa woosa keethan attis. Ha kiitay heedzu ayfe qofata oykees.</para>
  <para style="ipi">1. Woosa keethi aysiya asay, iita duussu de7iya Qarxeesa asaa matan ay mela lo77o duussu daanaw koshshiyako Tito akeekisees.</para>
  <para style="ipi">2. Woosa keetha giddon de7iya dumma dumma cugata, hessika, cima asata, dondza addetanne aylleta waati tamaarsanaw bessiyako Tito zorees.</para>
  <para style="ipi">3. Ammaniya asi ammanon waanidi daaneko, hessika, sarotethaninne siiqon daanaba, woosa keetha giddofe ooshshi, palamanne shaahetethi digganaba Titos zore immees.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Gelo qofa <char style="ior">(<ref loc="TIT 1:1-4">1:1-4</ref>)</char></para>
  <para style="io1">Woosa keethi kaalethiya asaas imetida kiita <char style="ior">(<ref loc="TIT 1:5-16">1:5-16</ref>)</char></para>
  <para style="io1">Dumma dumma cugata imetida zore <char style="ior">(<ref loc="TIT 2:1-3:11">2:1—3:11</ref>)</char></para>
  <para style="io1">Zorenne sarotho <char style="ior">(<ref loc="TIT 3:12-15">3:12-15</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="TIT 1" />
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1" />Yesuus Kiristoosa hawaareynne Xoossa aylley, Phawuloosi, xaafida dabdaabiya. Xoossay doorida asaa ammanuwa dichanaadanne tuma ayyaana de7uwa waanidi daaneko bessiya tumaa eraako enta kaalethanaw taani kiitetas. <verse eid="TIT 1:1" /><verse number="2" style="v" sid="TIT 1:2" />He ammanoynne eratethay merinaa de7uwa ufaysaa bolla zempis. Hessa daro wodepe sinthe wordotonna Xoossay nuus immana gidi qaala gelis. <verse eid="TIT 1:2" /><verse number="3" style="v" sid="TIT 1:3" />Nuna ashshiya Xoossay ba woden ha kiitaa odana mela taw hadara immis.<verse eid="TIT 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4" />Nu kothe ammanuwan ta tuma na7aa gidida Tito,</para>
  <para style="p" vid="TIT 1:4">Xoossaa Aawapenne nuna ashshiya Yesuus Kiristoosape aadho keehatethay, maarotethaynne sarotethay new gido.<note caller="-" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2CO 8:23">2 Qoro 8:23</ref>; <ref loc="GAL 2:3">Gala 2:3</ref>; <ref loc="2TI 4:10">2 Ximo 4:10</ref>.</char></note><verse eid="TIT 1:4" /></para>
  <para style="s1">Titoy Qarxeesan</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5" />Taani nena Qarxeesan aggada yiday, neeni attidaba giigisanaadanne taani kiittidaysada katamaa ubban woosa keetha cimata doorana melasa. <verse eid="TIT 1:5" /><verse number="6" style="v" sid="TIT 1:6" />Cimi boretonaysa, issi mache azinaa, maara dhayon woyko kiitetetha ixon asi boronna ammaniya nayti de7iya asi gidanaw bessees.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="1TI 3:2-7">1 Ximo 3:2-7</ref>.</char></note> <verse eid="TIT 1:6" /><verse number="7" style="v" sid="TIT 1:7" />Woosa keetha cimi Xoossaa oosuwa hadara ekida gisho, boretonaysa, otortonaysa, elle yilotonnaysa, mathotonaysa, oda medhonaysanne bessonna go77as dafetonaysa gidanaw bessees. <verse eid="TIT 1:7" /><verse number="8" style="v" sid="TIT 1:8" />Shin imathe mokeysa, lo77oba ubbaa doseysa, akeekancho, xillo, geeshshinne bana haareysa gidanaw bessees. <verse eid="TIT 1:8" /><verse number="9" style="v" sid="TIT 1:9" />Harata suure timirtiyan minthethanawunne he timirtiya ixeyisata zaaranaw ba tamaarida tuma qaalan minnidi eqanaw bessees.<verse eid="TIT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10" />Kiitetonaysati, pathonna oda odeteysati, cimmeysati ubbaka qaxaretetha wogaa naagiya daro asati de7oosona. <verse eid="TIT 1:10" /><verse number="11" style="v" sid="TIT 1:11" />Enti bessonna ogen miishe demmanaw koyidi, tamaarsanaw bessonnaba tamaarsishe keetha asaa ubbaa iissiya gisho enta timirtiya teqanaw bessees. <verse eid="TIT 1:11" /><verse number="12" style="v" sid="TIT 1:12" />Enta nabetape issoy, “Qarxeesa asay ubba wode wordo odetoosona; iita do7atanne azalla yarambata”<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fk" closed="false">Qarxeesa asay ubba wode wordo odetoosona; iita do7atanne azalla yarambata: </char><char style="ft" closed="false">Hessa yaagidi odida nabey Ephimendeesa geetetees.</char></note> yaagis. <verse eid="TIT 1:12" /><verse number="13" style="v" sid="TIT 1:13" />Ha markatethay tuma markatethi. Hessa gisho, entaw tuma ammanoy daana mela enta hanqeta. <verse eid="TIT 1:13" /><verse number="14" style="v" sid="TIT 1:14" />Tumaa ixiya asaa timirtiyanne Ayhudeta pathonna tossiya si7onna mela enta seera. <verse eid="TIT 1:14" /><verse number="15" style="v" sid="TIT 1:15" />Bantaw geeshshi gididaysatas ubbay geeshshi, shin tunatasinne ammanonaysatas enta qofaynne kahay tunida gisho, entaw aybika geeshshi gidenna. <verse eid="TIT 1:15" /><verse number="16" style="v" sid="TIT 1:16" />Enti nu Xoossaa eroos goosona, shin banta oosuwan iya kaddoosona. Enti Xoossan ixetidaysata, kiitetonaysatanne lo77o ooso ubbaas gidonnayisata.<verse eid="TIT 1:16" /></para>
  <para style="b" />
  <chapter eid="TIT 1" />
  <chapter number="2" style="c" sid="TIT 2" />
  <para style="s1">Dumma Dumma Kiita</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1" />Shin neeni suure timirtiya phalqonna timirte tamaarsanaw bessees. <verse eid="TIT 2:1" /><verse number="2" style="v" sid="TIT 2:2" />Cima addeti bantana haareyisata, wopu gidaysata, bonchetidaysata, ammanon, siiqoninne danda7an, mino gidana mela zora. <verse eid="TIT 2:2" /><verse number="3" style="v" sid="TIT 2:3" />Hessadaka, cima maccasay banta duussan geeshshata, zigironnayisata, woyne ushshan haaretonnaysatanne lo77oba tamaarseyisata gidana mela tamaarsa. <verse eid="TIT 2:3" /><verse number="4" style="v" sid="TIT 2:4" />Enti hessada haniko yalaga maccasay banta azinatanne banta nayta siiqana mela tamaarsanaw danda7oosona. <verse eid="TIT 2:4" /><verse number="5" style="v" sid="TIT 2:5" />Xoossaa qaalay boretonna mela bantana haareyisata, geeshshata, banta son ootheyisata, keehatanne banta azinatas kiiteteyisata gidana mela yalaga maccasa tamaarsonna.<verse eid="TIT 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6" />Hessadaka, dondza addeti bantana haarana mela zora. <verse eid="TIT 2:6" /><verse number="7" style="v" sid="TIT 2:7" />Neeni ne huuphen lo77o ooso ubban entaw leemiso gida. Neeni ne timirtiyan eqidaysanne ammanetidaysa gida. <verse eid="TIT 2:7" /><verse number="8" style="v" sid="TIT 2:8" />Nu morketi nuna zigiranaw gaasoyabay entaw dhayin enti yeellatana mela neeni boretonna lo77o oda odeeta.<verse eid="TIT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9" />Aylleti ubbaban banta godatas kiitetana mela enta ufaysana melanne entara palamonna mela zora. <verse eid="TIT 2:9" /><verse number="10" style="v" sid="TIT 2:10" />Enti banta godatape kaysotopo. Hessika, nuna ashshiya Xoossaa timirtey, ubba ogen dosetidaysa gidana mela banta oothiya oosuwan ammaneteyisata gideysa bessaana mela enta zora.<verse eid="TIT 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11" />Ase ashshiya Xoossa aadho keehatethay asa ubbaas qoncis. <verse eid="TIT 2:11" /><verse number="12" style="v" sid="TIT 2:12" />He aadho keehatethay, nu nagaranne ha alamiya amuwa aggidi, ha wodiyan nuna haaridi, tuma ayyaana de7uwaninne xillotethan daana mela nuna tamaarsees. <verse eid="TIT 2:12" /><verse number="13" style="v" sid="TIT 2:13" />Nuuni anjetida ufaysaa gidida gita Xoossaanne nuna ashshiya Yesuus Kiristoosa boncho qoncethaa naagoos. <verse eid="TIT 2:13" /><verse number="14" style="v" sid="TIT 2:14" />Iita ooso ubbaafe nuna wozanawunne lo77oba oothanaw amotiya ba geeshsha asi kessanaw nu gisho bana aathidi immis.<note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="PSA 130:8">Maz 130:8</ref>; <ref loc="EXO 19:5">Kessa 19:5</ref>; <ref loc="DEU 4:20">Zaare 4:20</ref>; <ref loc="DEU 7:6">7:6</ref>; <ref loc="DEU 14:2">14:2</ref>; <ref loc="1PE 2:9">1 Phex 2:9</ref>.</char></note><verse eid="TIT 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15" />Neeni haysa tamaarsa; kumetha maatan zora, seera; oonika nena kadhopo.<verse eid="TIT 2:15" /></para>
  <chapter eid="TIT 2" />
  <chapter number="3" style="c" sid="TIT 3" />
  <para style="s1">Go77iya Oosota</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1" />Asay deriya haareysatas, aawatethay de7eysatas haaretanaw, kiitetanawunne lo77o ooso ubbaa oothanaw giigetidaysata gidana mela akeekisa. <verse eid="TIT 3:1" /><verse number="2" style="v" sid="TIT 3:2" />Qassi enti oodde bollaka iita odetonna mela, saro asi gidana mela, ashketanne asa ubbaas qadheteyisata gidana mela zora. <verse eid="TIT 3:2" /><verse number="3" style="v" sid="TIT 3:3" />Nuuni kase eeyata, kiitetonayisata, baletidaysata, dumma dumma asho ufaysasinne amos aylletidaysata. Nuuni iitatethaninne qanaaten kumidaysata; nu ase ixeyisata, asika nuna ixeyisata. <verse eid="TIT 3:3" /><verse number="4" style="v" sid="TIT 3:4" />Shin ashshiya Xoossaa keehatethaynne siiqoy qoncida wode, <verse eid="TIT 3:4" /><verse number="5" style="v" sid="TIT 3:5" />nu oothida xillo oosuwa gisho gidonashin, ba maarotethaa gisho nuna ashshis. Nuna I ashshiday, nam7antho yeletethaa meechaninne Geeshsha Ayyaana baggara immida ooratha de7uwana. <verse eid="TIT 3:5" /><verse number="6" style="v" sid="TIT 3:6" />He Ayyaana, Xoossay nuna ashshiya Yesuus Kiristoosa baggara nu bolla darsidi gussis. <verse eid="TIT 3:6" /><verse number="7" style="v" sid="TIT 3:7" />Ba aadho keehatetha baggara nuna xillisidi merinaa de7uwa laata ufaysaa oykana mela hessa oothis. <verse eid="TIT 3:7" /><verse number="8" style="v" sid="TIT 3:8" />Ha qaalay ammanetida qaala. Xoossaa ammaneysati lo77o ooso oothanaw giigidaysata gidana mela ne ha qaala minthada odana mela ta koyayis. Haysati ase ubbaas lo77onne go77eyisata. <verse eid="TIT 3:8" /><verse number="9" style="v" sid="TIT 3:9" />Shin eeyatetha palamape, kocha taybope, kachafenne higge gaason dendiya ooshshafe naageta. Hessi go77inne wodhey baynaba. <verse eid="TIT 3:9" /><verse number="10" style="v" sid="TIT 3:10" />Shaahetethi medhiya uraa koyro zora; nam7antho hanqeta, hessafe guye, iyape haaka. <verse eid="TIT 3:10" /><verse number="11" style="v" sid="TIT 3:11" />Hessa mela asi geellanne nagarancho; I ba bolla pirdeysa era.<verse eid="TIT 3:11" /></para>
  <para style="s1">Wursetha Zore</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12" />Taani balgo yan shaacanaw qopida gisho, Arxemaasa woyko Tikiqoosa neeko kiittiya wode ne taako Niqophilyoona yaanaw minna.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">Hawa 20:4</ref>; <ref loc="EPH 6:21-22">Efe 6:21-22</ref>; <ref loc="COL 4:7-8">Qola 4:7-8</ref>; <ref loc="2TI 4:12">2 Ximo 4:12</ref>.</char></note> <verse eid="TIT 3:12" /><verse number="13" style="v" sid="TIT 3:13" />Higge eriya Zeemasinne Aphiloosi oge biya wode entaw koshshiyabay paconna mela enta maadda. <verse eid="TIT 3:13" /><verse number="14" style="v" sid="TIT 3:14" />Nu asayka pathonna asi gididi attonna mela bantaw koshshiyaba demmana mela lo77o ooso oothanaw minnidi tamaaro.<verse eid="TIT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15" />Taara de7iya ubbay nena saro goosona; ammanon nuna siiqiya asaa saro ga.</para>
  <para style="p" vid="TIT 3:15">Xoossaa aadho keehatethay hinte ubbaara gido. Amin7i.<verse eid="TIT 3:15" /></para>
  <chapter eid="TIT 3" />
</usx>