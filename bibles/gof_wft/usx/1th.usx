<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">1 Teselonqe Kiita</para>
  <para style="toc1">1 Teselonqe Kiita</para>
  <para style="toc3">1 Tese</para>
  <para style="toc2">1 Teselonqe</para>
  <para style="mt1">Phawuloosi Teselonqe Asaas</para>
  <para style="mt2">Xaafida Koyro Kiita</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Teselonqey, Roome kawotethan de7iya Maqedoone biittas waanna katama. Phawuloosi Teselonqen woosa keetha Filphisiyuusa yeddidi bidaape guye essis. Gidoshin, Ayhudeta ammano kaallanaw giigetidi uttida Ayhude gidonna asay, Phawuloosi tamaarsiya ammano timirtiyan xoonetida gisho, Ayhudeti qanaatidi, Phawuloosa timirtiya phalqidosona. Hessa gisho, Phawuloosi gam7onashin Teselonqe yeddidi, Beeriya bis (<char style="xt"><ref loc="1TH 1:9-10">1:9-10</ref></char>). Guyepe, I Teselonqe gakida wode iya maaddiya Ximotiyoosi, Teselonqe woosa keethan de7iya hanotata iyaw geeshshidi odis.</para>
  <para style="ip">Phawuloosi koyro kiita Teselonqe asaas xaafiday, ammaniya asaa zoranaasanne minthethanaasa. I enta ammanuwabanne enta siiquwaba lo77o markatethi si7ida wode Xoosse galatis. Kase I enta giddon de7ida wode ay mela duussu de7idaako enta hassaysees. Hessafe guye, Kiristoosa nam7antho yuussaba oyshetida oyshaas zaaro immees. He oyshatape guuthati, “Kiristoosi nam7antho yaanape sinthe hayqida ammaniya asi, Kiristoosa yuussay immiya merina de7o ekanaw danda7ii? Kiristoosi nam7antho yaanay awudee?” geeteteyisata. Phawuloosi he inje wodiya go7etidi, “Kiristoosa nam7antho yuussaa ufaysan naagishe I yaana gakanaw wopu gidi hinte ooso oothite” yaagidi zorees.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Gelo qofa <char style="ior">(<ref loc="1TH 1:1-3">1:1-3</ref>)</char></para>
  <para style="io1">Teselonqe asaa ammanonne leemiso duussa <char style="ior">(<ref loc="1TH 1:4-3:13">1:4—3:13</ref>)</char></para>
  <para style="io1">Xoosse ufaysiya de7o <char style="ior">(<ref loc="1TH 4:1-12">4:1-12</ref>)</char></para>
  <para style="io1">Kiristoosa nam7antho yuussaba <char style="ior">(<ref loc="1TH 4:13-5:11">4:13—5:11</ref>)</char></para>
  <para style="io1">Wursetha zorenne sarotho <char style="ior">(<ref loc="1TH 5:12-28">5:12-28</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="1TH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1"/>Phawuloosi Sillaaseynne Ximotiyoosi Teselonqe woosa keethan de7iya, Xoossaa Aawabanne Godaa Yesuus Kiristoosaba gidida asaas xaafida kiita.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 17:1">Hawa 17:1</ref>.</char></note></para>
  <para style="p" vid="1TH 1:1">Aadho keehatethaynne saroy hintew gido.<verse eid="1TH 1:1"/></para>
  <para style="s1">Teselonqe Asaa De7onne Ammano</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2"/>Nuuni Xoossaa woossiya wode ubban hintena qopishe hinte gisho ubba wode Xoossaa galatoos. <verse eid="1TH 1:2"/><verse number="3" style="v" sid="1TH 1:3"/>Xoossaa nu Aawa sinthan ammanon hinte oothida oosuwa, siiqon hinte daaburida daaburanne Yesuus Kiristoosan de7iya ufaysaa ekanaw hinte minnidi eqida equwa ubba wode nuuni qopoos.<verse eid="1TH 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 1:4"/>Nu ishato, Xoossay hintena doseysanne ba ase oothidi hintena dooridaysa nuuni eroos. <verse eid="1TH 1:4"/><verse number="5" style="v" sid="1TH 1:5"/>Ayis giiko, nuuni Wongela doona xalaalan gidonashin, wolqan, Geeshsha Ayyaananinne Wongela tumaa ammanon hintew ehida. Nuuni hintera gam7ida wode ubban hinte gisho waanidi de7idaako hinte ereeta. <verse eid="1TH 1:5"/><verse number="6" style="v" sid="1TH 1:6"/>Hinte daro meto ekikoka Geeshsha Ayyaanay immiya ufaysan kiitaa ekideta; nunanne Godaa daanideta.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="ACT 17:5-9">Hawa 17:5-9</ref>.</char></note> <verse eid="1TH 1:6"/><verse number="7" style="v" sid="1TH 1:7"/>Hessa gisho, Maqedoonenne Akaya biittan de7iya ammaniya ubbaas leemiso gidideta. <verse eid="1TH 1:7"/><verse number="8" style="v" sid="1TH 1:8"/>Godaa qaalay hintefe keyidi, Maqedooneninne Akaya xalaalan gidonashin, Xoossaa hinte ammaneysi ubbason si7etis. Hiza, nuuni gaanabay aykoyka baawa. <verse eid="1TH 1:8"/><verse number="9" style="v" sid="1TH 1:9"/>Nuuni hinteko bida wode hinte nuna mokida mokuwanne hinte, hinte eeqa aggidi tumaanne de7o Xoossaa haggaazanaw hinte simmidaysa enti banta huuphen odoosona. <verse eid="1TH 1:9"/><verse number="10" style="v" sid="1TH 1:10"/>Qassi Xoossaa Na7ay, Yesuusi, Xoossay hayqope denthidaysi, sinthafe yaana Xoossaa hanquwafe nuna ashshanaysi, salope yaanaysa hinte naageysa enti markatoosona.<verse eid="1TH 1:10"/></para>
  <chapter eid="1TH 1"/>
  <chapter number="2" style="c" sid="1TH 2"/>
  <para style="s1">Phawuloosi Teselonqen Oothida ooso</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1"/>Ta ishato, nuuni hinteko biday mela gidonnaysa hinte, hinte huuphen ereeta. <verse eid="1TH 2:1"/><verse number="2" style="v" sid="1TH 2:2"/>Shin nuuni hinteko Teselonqe yaanape sinthe Filphisiyuusa kataman waayetidaysanne cayetidaysa hinte ereeta. Daro ixoy de7ikoka hintew iya Wongela odana mela Xoossay nuus minotethi immis.<note caller="-" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="ACT 16:19-24">Hawa 16:19-24</ref>; <ref loc="ACT 17:1-9">17:1-9</ref>.</char></note> <verse eid="1TH 2:2"/><verse number="3" style="v" sid="1TH 2:3"/>Nuuni hintena zoriday balethon woyko cimon woyko genen gidenna.<verse eid="1TH 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 2:4"/>Shin Xoossay nunan ammanetidi ba Wongela odana mela nuus hadara immida gisho odoos. Nu hessa oothey nu wozanaa be7iya Xoossaa ufaysanaasafe attishin, ase ufaysanaasa gidenna. <verse eid="1TH 2:4"/><verse number="5" style="v" sid="1TH 2:5"/>Nu miishe yaaridi wordo hintena sabbishe hinteko yoonnaysa loythidi ereeta; Xoossay nuus marka. <verse eid="1TH 2:5"/><verse number="6" style="v" sid="1TH 2:6"/>Nuuni hintefe gidin woyko hara asa oodefeka boncho koyibooko. <verse eid="1TH 2:6"/><verse number="7" style="v" sid="1TH 2:7"/>Nuuni Kiristoosa hawaare gideysada nuus koshshiyaba immite gidi ekanaw danda7oos, shin aayiya ba nayta dicheysa mela hinte giddon ashke gidida. <verse eid="1TH 2:7"/><verse number="8" style="v" sid="1TH 2:8"/>Nu hintena dosida gisho Xoossaa Wongela hintew shaako xalaala gidonashin, nu de7uwaka hintew immanaw giigida. Hinte nuus daro al7o. <verse eid="1TH 2:8"/><verse number="9" style="v" sid="1TH 2:9"/>Nu ishato, nu oosuwanne nu daabura ereeta. Hintew Xoossaa Wongela odishe, hintena waaysonna mela qammanne gallas oothida.<verse eid="1TH 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10"/>Nu de7oy hinte ammaneyisata mataninne Xoossaa sinthan geeshshi, xillonne boretonaysa gideysas hinte marka. <verse eid="1TH 2:10"/><verse number="11" style="v" sid="1TH 2:11"/>Nuuni hintew huuphen huuphen yelidaysati banta naytas haneysada hanidaysa ereeta. <verse eid="1TH 2:11"/><verse number="12" style="v" sid="1TH 2:12"/>Nu hintena zorida, minthethida. Qassi ba kawotethaanne ba bonchuwa shaakanaw hintena xeegiya Xoossaa ufaysiya de7o hinte daana mela hintew minthidi odida.<verse eid="1TH 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13"/>Hintew nuuni Xoossaa qaala odida wode asa qaalada gidonashin, Xoossaa qaalada si7idi ekida gisho nuuni ubba wode Xoossaa galatoos. I tuma Xoossaa qaala; Xoossaa qaalay ammaniya hintenan oothees.<verse eid="1TH 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 2:14"/>Ta ishato, hinte Yihuda biittan de7iya woosa keethatanne yan Kiristoos Yesuusa kaalliya asatada hanideta. Enta Ayhudeti waaysidaysada hintenaka hinte biitta asay waaysidosona.<note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="ACT 17:5">Hawa 17:5</ref>.</char></note> <verse eid="1TH 2:14"/><verse number="15" style="v" sid="1TH 2:15"/>He Ayhudeti Godaa Yesuusanne nabeta wodhidosona; qassi nuna goodidosona. Enti Xoossaa ufaysonaysatanne ase ubbaa ixeyisata.<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ACT 9:23">Hawa 9:23</ref>, <ref loc="ACT 9:29">29</ref>; <ref loc="ACT 13:45">13:45</ref>, <ref loc="ACT 13:50">50</ref>; <ref loc="ACT 14:2">14:2</ref>, <ref loc="ACT 14:5">5</ref>, <ref loc="ACT 14:19">19</ref>; <ref loc="ACT 17:5">17:5</ref>, <ref loc="ACT 17:13">13</ref>; <ref loc="ACT 18:12">18:12</ref>.</char></note> <verse eid="1TH 2:15"/><verse number="16" style="v" sid="1TH 2:16"/>Enti hari attoshin, Ayhude gidonna asay attana mela nuuni entaw qaala odeysa diggoosona. Hessada hanidi enta nagaraa xuu7ay kumana gakanaw ubba wode nagara oothosona. Wursethan, Xoossaa hanqoy enta bolla wodhees.<verse eid="1TH 2:16"/></para>
  <para style="s1">Teselonqe Asaa Be7anaw Amotees</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17"/>Shin nu ishato, nuuni nu qofan gidonashin, ashon hintefe shaaketidi guutha wode gam7idaysan hintena daro laamotidi be7anaw koyida. <verse eid="1TH 2:17"/><verse number="18" style="v" sid="1TH 2:18"/>Nu simmi hinteko baanaw koyida. Taani ta huuphen hinteko baanaw koyas, shin Xalahey nuna diggis. <verse eid="1TH 2:18"/><verse number="19" style="v" sid="1TH 2:19"/>Hiza, nu Godaa Yesuus Kiristoosi yaa wode, nu ufaysay woyko nu ceeqetiya nu kallachay oonee? Hintena gideketiyee? <verse eid="1TH 2:19"/><verse number="20" style="v" sid="1TH 2:20"/>Tuma hinte nu bonchonne nu ufaysi.<verse eid="1TH 2:20"/></para>
  <para style="b"/>
  <chapter eid="1TH 2"/>
  <chapter number="3" style="c" sid="1TH 3"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1"/>Hessa gisho, nuus gencanaw danda7etonna ixin, Ateena kataman nurka attanaw qofa qachida.<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="ACT 17:15">Hawa 17:15</ref>.</char></note> <verse eid="1TH 3:1"/><verse number="2" style="v" sid="1TH 3:2"/>Hintena zoranaadanne ammanon hintena minthethanaada nuura issife Xoossas ootheysanne Kiristoosa Wongela odiya nu ishaa Ximotiyoosa hinteko kiitida. <verse eid="1TH 3:2"/><verse number="3" style="v" sid="1TH 3:3"/>Hintena gakida goodan hintefe oonika guye simmofo. He gooday nuus Xoossa shene gideysa hinte, hinte huuphen ereeta. <verse eid="1TH 3:3"/><verse number="4" style="v" sid="1TH 3:4"/>Nu hintera de7iya wode goodi gakanaysa hintew koyrottidi odida. Hinte ereysa mela hessada hanis. <verse eid="1TH 3:4"/><verse number="5" style="v" sid="1TH 3:5"/>Hessa gisho, taw gencanaw danda7etonna ixin, “Ooni eri Xalahey enta paacidi nu daabura mela ashshona aggenna” gada hinte ammanuwaba eranaw Ximotiyoosa hinteko kiittas.<verse eid="1TH 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6"/>Ha77i Ximotiyoosi hinte matape yidi, hinte ammanuwabanne hinte siiquwaba lo77o wore nuus odis. Qassi hinte ubba wode nuus lo77o qopeysanne nuuni hintena be7anaw laamoteysada hinteka nuna be7anaw laamoteysa I nuus odis.<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 18:5">Hawa 18:5</ref>.</char></note> <verse eid="1TH 3:6"/><verse number="7" style="v" sid="1TH 3:7"/>Ta ishato, nuna gakiya waayaninne nu meto ubban hinte ammanuwa gisho hintenan minetida. <verse eid="1TH 3:7"/><verse number="8" style="v" sid="1TH 3:8"/>Hinte Godan minnidi de7iko nuka de7on de7oos. <verse eid="1TH 3:8"/><verse number="9" style="v" sid="1TH 3:9"/>Hiza, nuuni hinte gaason demmida ufaysas Xoossaa waati galatino? <verse eid="1TH 3:9"/><verse number="10" style="v" sid="1TH 3:10"/>Nuuni hintena be7anawunne hinte ammanuwan pacidaba kunthanaw qammanne gallas nu kumetha wozanan Xoossaa woossoos.<verse eid="1TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11"/>Xoossay nu aaway ba huupheninne nu Goday Yesuus Kiristoosi nu hinteko baana ogiya giigiso. <verse eid="1TH 3:11"/><verse number="12" style="v" sid="1TH 3:12"/>Nu hintena daro doseysada Goday hinte issoy issuwa siiqiya siiqonne ase ubbaa siiqiya siiqo hintew darsonne gujo. <verse eid="1TH 3:12"/><verse number="13" style="v" sid="1TH 3:13"/>Nu Goday Yesuus Kiristoosi ba geeshshatara yaa wode Xoossaa, nu aawa sinthan hinte wozanay geeshshinne borey baynaysa oothidi I hintena minthethana.<verse eid="1TH 3:13"/></para>
  <chapter eid="1TH 3"/>
  <chapter number="4" style="c" sid="1TH 4"/>
  <para style="s1">Xoosse Ufaysiya De7o</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1"/>Wursethan, ta ishato, Xoossaa ufaysanaw hinte waanidi daanaw bessiyako nuupe tamaarideta. Hessi hinte koyrope de7ida de7uwa, shin ha77i hinte kaseysafe aathidi oothanaada Godaa Yesuusa sunthan hintena woossosinne zoroos. <verse eid="1TH 4:1"/><verse number="2" style="v" sid="1TH 4:2"/>Nuuni Godaa Yesuusa maatan hintena kiitida kiitay awuseko ereeta.<verse eid="1TH 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1TH 4:3"/>Xoossay, hinte geeshshi gidana melanne laymatonna mela koyees. <verse eid="1TH 4:3"/><verse number="4" style="v" sid="1TH 4:4"/>Hinte issoy issoy, hinte machetara geeshshatethaninne bonchon daanaw bessees. <verse eid="1TH 4:4"/><verse number="5" style="v" sid="1TH 4:5"/>Xoossaa eronnanne ammanonna asada laymatetha amon xuugetofite. <verse eid="1TH 4:5"/><verse number="6" style="v" sid="1TH 4:6"/>Nu kase hintew odidaysadanne minthi zoridaysada Goday hessa melaba oothiya ubbaa pirdiya gisho, oonika haysatan ba ammaniya ishaa naaqanawunne cimmanaw bessenna. <verse eid="1TH 4:6"/><verse number="7" style="v" sid="1TH 4:7"/>Xoossay nuna geeshshatethan daana mela xeegisipe attishin, tunatethan daana mela xeegibeenna. <verse eid="1TH 4:7"/><verse number="8" style="v" sid="1TH 4:8"/>Hessa gisho, ha timirtiya ixiya oonika hintew Geeshsha Ayyaana immiya Xoossaa ixeesipe attishin, ase gidenna.<verse eid="1TH 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9"/>Hinte issoy issuwa waati siiqaneko Xoossay hintena tamaarsida gisho, ha77i siiqoba nu hintew xaafanaw koshshenna. <verse eid="1TH 4:9"/><verse number="10" style="v" sid="1TH 4:10"/>Qassi Maqedoone biittan de7iya ammaniya ishata ubbaa tuma hinte doseeta. Shin nu ishato, ha77ika hinte enta aathidi dosana mela hintena woossoos.<verse eid="1TH 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 4:11"/>Nuuni kase hintew odidaysada wopu gida de7uwa de7ite. Hinte, hinte ooso oothidi hintew duussas koshshiyaba demmite. <verse eid="1TH 4:11"/><verse number="12" style="v" sid="1TH 4:12"/>Hessada haniko, ammanonayisata matan hinte bonchetana; qassi hintena koshshiyabas oonaka aaddasheketa.<verse eid="1TH 4:12"/></para>
  <para style="s1">Goday Yaana</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13"/>Nu ishato, ammanidi hayqida asati hananaba hinte erana mela nu koyoos. Hinte enta gisho ufaysi bayna asada kayotofite. <verse eid="1TH 4:13"/><verse number="14" style="v" sid="1TH 4:14"/>Nuuni, Yesuusi hayqidaysanne qassi hayqope dendidaysa ammanoos. Hessadaka, Xoossay Yesuusa ammanidi hayqidaysata iyara wolla ehanaysa ammanoos.<verse eid="1TH 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15"/>Goday nuus odidaysada Goday yaa gallas iyara gahetanaw nuuni paxa de7eysati, hayqidaysatape sinthatoko. <verse eid="1TH 4:15"/><verse number="16" style="v" sid="1TH 4:16"/>Goday wolqaama kiitara, kiitanchota halaqa girsara, Xoossaa moyze punora, salope wodhana. Kiristoosa ammanidi hayqidaysati koyrottidi hayqope dendana. <verse eid="1TH 4:16"/><verse number="17" style="v" sid="1TH 4:17"/>Hessafe guye, he wode nuuni paxa de7eysati, Godaara shaaran gahetanaw entara issife salo eketana. Hessafe guye, nuuni Godaara issife merinaw daana. <verse eid="1TH 4:17"/><verse number="18" style="v" sid="1TH 4:18"/>Hessa gisho, ha qaalan issoy issuwa minthethite.<verse eid="1TH 4:18"/></para>
  <chapter eid="1TH 4"/>
  <chapter number="5" style="c" sid="1TH 5"/>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1"/>Ta ishato, ha hanoti hanana wodiyanne ageena hintew xaafanaw koshshenna. <verse eid="1TH 5:1"/><verse number="2" style="v" sid="1TH 5:2"/>Godaa Gallasay kaysoy qamma yeysada yaanaysa hinte loythi ereeta.<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 24:43">Maato 24:43</ref>; <ref loc="LUK 12:39">Luqa 12:39</ref>; <ref loc="2PE 3:10">2 Phex 3:10</ref>.</char></note> <verse eid="1TH 5:2"/><verse number="3" style="v" sid="1TH 5:3"/>Asay, “Sa7i saro, aykoyka hanenna” yaagishin, maccas iqethi oykeysada dhayoy enti qoponna enta bolla yaana. Enti ay ogenka kessi ekokona.<verse eid="1TH 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1TH 5:4"/>Shin nu ishato, he gallasay hintew kaysoy yeysada yaanaw hinte dhuman de7eketa. <verse eid="1TH 5:4"/><verse number="5" style="v" sid="1TH 5:5"/>Hinte ubbay poo7o asinne gallasan de7iya asi; nuuni qamma asi woyko dhuma asi gidoko. <verse eid="1TH 5:5"/><verse number="6" style="v" sid="1TH 5:6"/>Hessa gisho, nuuni harati dhiskeysada dhiskanaw bessenna; nuuni barkanawunne giigidi daanaw bessees. <verse eid="1TH 5:6"/><verse number="7" style="v" sid="1TH 5:7"/>Dhiskeysati qamma dhiskoosona; mathoteysati qamma mathotosona. <verse eid="1TH 5:7"/><verse number="8" style="v" sid="1TH 5:8"/>Shin nuuni gallasa asi gidiya gisho giigidi daanaw bessees. Ammanonne siiqo xurureda tiran ma7idi, atotetha ufaysaa huuphen wothiya ola birata barneexada wothidi daanaw bessees.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="ISA 59:17">Isa 59:17</ref>; <ref loc="EPH 6:13-17">Efe 6:13-17</ref>.</char></note> <verse eid="1TH 5:8"/><verse number="9" style="v" sid="1TH 5:9"/>Xoossay nuna nu Godaa Yesuus Kiristoosa baggara kumetha atotethi ekana mela doorisipe attishin, hanqos dooribeenna. <verse eid="1TH 5:9"/><verse number="10" style="v" sid="1TH 5:10"/>Nuuni paxa de7in woyko hayqin, Kiristoosi yaa wode iyara issife daana mela Kiristoosi nu gisho hayqis. <verse eid="1TH 5:10"/><verse number="11" style="v" sid="1TH 5:11"/>Hessa gisho, hinte kase ootheysada, issoy issuwa minthethitenne dichite.<verse eid="1TH 5:11"/></para>
  <para style="s1">Zorenne Sarotho</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12"/>Nu ishato, hinte giddon ootheyisata, hintena kaalethana melanne zorana mela Goday dooridaysata bonchana mela hintena woossoos. <verse eid="1TH 5:12"/><verse number="13" style="v" sid="1TH 5:13"/>Enti oothiya oosuwa gisho, enta daro bonchitenne siiqite. Issoy issuwara sarotethan de7ite.<verse eid="1TH 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14"/>Nu ishato, nuuni hintena zoroos. Boozata hanqite; babeyisata minthethite; daaburanchota maaddite; ase ubbaa danda7ite. <verse eid="1TH 5:14"/><verse number="15" style="v" sid="1TH 5:15"/>Oonika iita gisho iita zaaronna mela naagetite. Hinte wolisinne asa ubbaas lo77oba oothanaw minnite.<verse eid="1TH 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16"/>Ubba wode ufaytite. <verse eid="1TH 5:16"/><verse number="17" style="v" sid="1TH 5:17"/>Ubba wode Xoossaa woossite. <verse eid="1TH 5:17"/><verse number="18" style="v" sid="1TH 5:18"/>Ubbaban galatite. Kiristoos Yesuusa baggara Xoossay hintefe koyey hessa.<verse eid="1TH 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19"/>Geeshsha Ayyaana oosuwa toysopite. <verse eid="1TH 5:19"/><verse number="20" style="v" sid="1TH 5:20"/>Tinbite qaala kadhopite. <verse eid="1TH 5:20"/><verse number="21" style="v" sid="1TH 5:21"/>Ubbabaa paacite; lo77oba ekite. <verse eid="1TH 5:21"/><verse number="22" style="v" sid="1TH 5:22"/>Iita ooso ubbaafe haakite.<verse eid="1TH 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23"/>Saro immiya Xoossay ba huuphen hintena polo geeshsho. Nu Goday Yesuus Kiristoosi yaana gallasaas, Xoossay hinte ayyaana, hinte shempuwanne hinte kumetha asatethaa borey bayna naago. <verse eid="1TH 5:23"/><verse number="24" style="v" sid="1TH 5:24"/>Hintena xeegeysi ammanetidaysa gidiya gisho, hessa I polana.<verse eid="1TH 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25"/>Nu ishato, nuus Xoossaa woossite.<verse eid="1TH 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26"/>Ammaniya asa ubbaa geeshsha yeeretethan sarothite.<verse eid="1TH 5:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27"/>Hinte ha kiitaa ammaniya asa ubbaas nabbabanaada Godaa sunthan hintena woossayis.<verse eid="1TH 5:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28"/>Nu Godaa Yesuus Kiristoosa aadho keehatethay hintera issife gido. Amin7i.<verse eid="1TH 5:28"/></para>
  <chapter eid="1TH 5"/>
</usx>
