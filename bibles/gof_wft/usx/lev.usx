<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LEV" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Leeweta Maxaafa</para>
  <para style="toc1">Leeweta Maxaafa</para>
  <para style="toc3">Leewe</para>
  <para style="toc2">Leeweta</para>
  <para style="mt1">Leeweta Maxaafa</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Leeweta maxaafay, Leewe kochaafe gidida Leeweti waatidi banta oosuwa oothaneko qoncisees. He oosotape koyroy, asay kumetha xaalatethan Xoossako shiiqana mela yarsho shiisho; nam7anthoy, tunanne tuna gidonabata shaakidi asaa Xoossa sinthan tunatethafe geeshsho.</para>
  <para style="ip">Maxaafas gul7a qofay Xoossa geeshshatethi. “Taani, Goday, hinte Xoossay, geeshshi gidiya gisho, hinteka geeshshi gidite” yaagis. Qassi Xoossa asay ha geeshshi gidida Isra7eele Xoossara shiphi gidi daana melanne waanidi iya goyinnanaw bessiyako paadidi bessees.</para>
  <para style="ip">Leeweta maxaafan daro eretida kiitay, Yesuusi gita kiita gidi nam7antho dethan wothida, “Ase ubbaa ne huupheda dosa” geetetidi xaafetida qaala (<char style="xt"><ref loc="LEV 19:18">Leewe 19:18</ref></char>).</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Yarsho wogata <char style="ior">(<ref loc="LEV 1:1-7:38">1:1—7:38</ref>)</char></para>
  <para style="io1">Kahineta shuumo woga <char style="ior">(<ref loc="LEV 8:1-36">8:1-36</ref>)</char></para>
  <para style="io1">Aarona yarshuwa <char style="ior">(<ref loc="LEV 9:1-24">9:1-24</ref>)</char></para>
  <para style="io1">Nam7u kahineta hayquwa <char style="ior">(<ref loc="LEV 10:1-20">10:1-20</ref>)</char></para>
  <para style="io1">Tunanne tuna gidonabata <char style="ior">(<ref loc="LEV 11:1-15:33">11:1—15:33</ref>)</char></para>
  <para style="io1">Atotethaa gallasinne iya wogata <char style="ior">(<ref loc="LEV 16:1-34">16:1-34</ref>)</char></para>
  <para style="io1">Dumma dumma higgeta <char style="ior">(<ref loc="LEV 17:1-20:27">17:1—20:27</ref>)</char></para>
  <para style="io1">Dumma dumma ba7aaleta boncho woga <char style="ior">(<ref loc="LEV 21:1-25:55">21:1—25:55</ref>)</char></para>
  <para style="io1">Anjonne seera <char style="ior">(<ref loc="LEV 26:1-46">26:1-46</ref>)</char></para>
  <para style="io1">Qaala caaqonne yarsho wogata <char style="ior">(<ref loc="LEV 27:1-34">27:1-34</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="LEV 1" />
  <para style="s1">Xuussa Yarsho</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1" />Godaa Xoossay, Geeshsha Dunkaaniya giddon gididi Muse xeegidi yaagis; <verse eid="LEV 1:1" /><verse number="2" style="v" sid="LEV 1:2" />Isra7eele asaas haysada yaagada oda; hintefe oonika Godaas yarsho yarshiya wode ba mehiyape, ba dorsafenne ba deeshape eho. <verse eid="LEV 1:2" /><verse number="3" style="v" sid="LEV 1:3" />He yarshoy mehepe xuussa yarshos gidiko borey bayna wofaano gido. Goday he yarshuwa ekana mela Geeshsha Dunkaaniya geliya pengen yarsho. <verse eid="LEV 1:3" /><verse number="4" style="v" sid="LEV 1:4" />Yarshuwa yarshiya uray xuussa yarshos ehida mehiya huuphen ba kushiya wotho. Hessi iya nagara atotethas Goday ekida yarsho gidana. <verse eid="LEV 1:4" /><verse number="5" style="v" sid="LEV 1:5" />I he wofaanuwa Godaa sinthan shuko; kahineti, Aarona nayti he suuthaa ekidi, Geeshsha Dunkaane geliya pengen de7iya yarsho bessa oyddu maazaneta bolla wurxo. <verse eid="LEV 1:5" /><verse number="6" style="v" sid="LEV 1:6" />He mehiya galbaa qaaridi, ashuwa qommon qommon kesso. <verse eid="LEV 1:6" /><verse number="7" style="v" sid="LEV 1:7" />Kahiniya Aarona nayti yarsho bessan mithi wothidi tama eetho. <verse eid="LEV 1:7" /><verse number="8" style="v" sid="LEV 1:8" />Kahineti, Aarona nayti he kessida ashuwa bolla huuphiyanne modhuwa gujidi, yarsho bessan taman de7iya mithaa bolla maarayidi wotho. <verse eid="LEV 1:8" /><verse number="9" style="v" sid="LEV 1:9" />Shin he uray ulo ashuwanne gedata haathan meecco. Kahiney he ubbaa yarsho bessan xuuggo; hessi Godaas taman xuugetiya sawo tonku giya yarsho gidana.<verse eid="LEV 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 1:10" />Xuugetiya yarshos I immiya imoy dorsaafe woyko deeshape gidiko, borey bayna maraze woyko kole gido. <verse eid="LEV 1:10" /><verse number="11" style="v" sid="LEV 1:11" />He mehiya yarsho bessaafe pudeha baggara Godaa sinthan shuko. Kahineti, Aarona nayti he suuthaa ekidi yarsho bessa oyddu maazaneta ubbaa bolla wurxo. <verse eid="LEV 1:11" /><verse number="12" style="v" sid="LEV 1:12" />He uray ashuwa qommon qommon kesso; kahiney he kessida ashuwa bolla huuphiyanne modhuwa gujidi, yarsho bessan taman de7iya mithaa bolla maarayidi wotho. <verse eid="LEV 1:12" /><verse number="13" style="v" sid="LEV 1:13" />Shin he uray ulo ashuwanne gedata haathan meecco; kahiney he ubbaa yarsho bessan xuuggo; hessi Godaas taman xuugetiya sawo tonku giya yarsho gidana.<verse eid="LEV 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 1:14" />Godaas yarshetiya xuussa yarshoy kafo gidiko holle woyko kuraacho gido. <verse eid="LEV 1:14" /><verse number="15" style="v" sid="LEV 1:15" />Kahiney hessa ekidi qoodhiya kushera duutho; huuphiya yarsho bessa bolla de7iya taman xuuggo. Iya suuthay yarsho bessa miyera guko. <verse eid="LEV 1:15" /><verse number="16" style="v" sid="LEV 1:16" />Ulo ashuwanne qefiya kessidi, yarsho bessaafe doloha baggara bido qoliya bessan yeggo. <verse eid="LEV 1:16" /><verse number="17" style="v" sid="LEV 1:17" />I he kafuwa qefeta oykidi shaako, shin kumethi shaakofo. Kahiney yarsho bessa bolla de7iya taman wothidi xuuggo; hessi Godaas taman xuugetiya sawo tonku giya yarsho gidana.<verse eid="LEV 1:17" /></para>
  <chapter eid="LEV 1" />
  <chapter number="2" style="c" sid="LEV 2" />
  <para style="s1">Katha Yarsho</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1" />Oonika katha yarsho Godaas yarshiya wode he yarshoy lo77o dhiille gido; iya bolla zaytenne ixaane gujo. <verse eid="LEV 2:1" /><verse number="2" style="v" sid="LEV 2:2" />Hessa kahine gidida Aarona naytako eho; kahineti he lo77o dhiilliyafe issi kuuca ekidi, zaytenne ixaane ubbaa gujidi yarsho bessa bolla taman xuuggo. Hessi Godaas taman xuugetiya sawo tonku giya qofiso yarsho gidana. <verse eid="LEV 2:2" /><verse number="3" style="v" sid="LEV 2:3" />Katha yarshuwafe attidaysi Aaronasinne iya naytas gidana. Hessi Godaas taman xuugetida ubbaafe geeshsha yarsho gidana.<verse eid="LEV 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4" />Yarshetiya uythay coocen kompetida gidiko, zaytera munuqetida lo77o dhiille gido. He uythay irshoy bayna zayten munuqetidaysa woyko lee7on uuketidi zayten tiyetidaysa gido. <verse eid="LEV 2:4" /><verse number="5" style="v" sid="LEV 2:5" />Yarshetiya uythay beshen uuketidaba gidiko, irshoy bayna zayten munuqetida lo77o dhiille gido. <verse eid="LEV 2:5" /><verse number="6" style="v" sid="LEV 2:6" />Iya menthada iya bolla zayte tigada katha yarsho oothada yarsha. <verse eid="LEV 2:6" /><verse number="7" style="v" sid="LEV 2:7" />Ne yarshiya kathay oton kaxidaba gidiko zayten munuqetida lo77o dhiille gido. <verse eid="LEV 2:7" /><verse number="8" style="v" sid="LEV 2:8" />Hessada hanidi giigida kathaa yarshuwa Godaas ehada kahiniyas imma; kahiney hessa ekidi yarsho bessan yarsho. <verse eid="LEV 2:8" /><verse number="9" style="v" sid="LEV 2:9" />Kahiney he katha yarshuwa ekidi, yarsho bessan xuussa yarsho oothidi taman xuuggo. Hessi Godaas taman xuugetiya sawo tonku giya qofiso yarsho gidana. <verse eid="LEV 2:9" /><verse number="10" style="v" sid="LEV 2:10" />Katha yarshuwafe attidaysi Aaronasinne iya naytas gidana. Hessi Godaas taman xuugetida ubbaafe geeshsha yarsho gidana.<verse eid="LEV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11" />Neeni irsho woyko eessi Godaas taman xuuggada yarshanaw bessonna gisho Godaas hinte ehiya katha yarshoy irshoy de7iyaba gidopo. <verse eid="LEV 2:11" /><verse number="12" style="v" sid="LEV 2:12" />Hayisata bayra yarsho oothidi Godaas yarshanaw danda7eeta, shin sawo tonku giya yarsho oothidi Godaas yarsho bessan xuuggofite. <verse eid="LEV 2:12" /><verse number="13" style="v" sid="LEV 2:13" />Maxiney, neeni ne Xoossara caaqida caaquwas malla gidiya gisho ne katha yarsho ubban maxine yegga. Ne katha yarsho ubbaa maxinen mal7etha. <verse eid="LEV 2:13" /><verse number="14" style="v" sid="LEV 2:14" />Neeni kathaafe bayra Godaas ehiya wode caacetidi shirketida tiya gidanaw bessees. <verse eid="LEV 2:14" /><verse number="15" style="v" sid="LEV 2:15" />Hessi katha yarsho gidiya gisho iya bolla zayte tiga; ixaane wotha. <verse eid="LEV 2:15" /><verse number="16" style="v" sid="LEV 2:16" />Kahiney he caacetidi shirketidanne zaytey tigetida katha yarshuwafe bagga ekidi ixaane ubbaara qofiso yarsho oothidi Godaas taman xuuggo.<verse eid="LEV 2:16" /></para>
  <chapter eid="LEV 2" />
  <chapter number="3" style="c" sid="LEV 3" />
  <para style="s1">Issifetetha Yarsho</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1" />Issi asi issifetetha yarshos ba mehiyape borey bayna ussi woyko wofaano Godaa sinthe shiisho. <verse eid="LEV 3:1" /><verse number="2" style="v" sid="LEV 3:2" />Yarshanaw ehida mehiya huuphen ba kushiya wothidi Geeshsha Dunkaaniya pengen shuko. Kahineti, Aarona nayti suuthaa ekidi yarsho bessa oyddu maazaniya bolla wurxo. <verse eid="LEV 3:2" /><verse number="3" style="v" sid="LEV 3:3" />Issifetetha yarshuwafe xuussa yarsho oothidi Godaas shiisho; hessika ulo ashuwa kammida moodhiya, <verse eid="LEV 3:3" /><verse number="4" style="v" sid="LEV 3:4" />nam7u kilahota, enta bolla de7iya moodhiyanne tiriya xeera baggaa eko. <verse eid="LEV 3:4" /><verse number="5" style="v" sid="LEV 3:5" />Aarona nayti hessa xuussa yarshuwara issife yarsho bessa bolla de7iya mithaa bolla wothidi xuuggo. Hessi Godaas xuugetiya sawo tonku giya yarsho gidana.<verse eid="LEV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6" />Issifetetha yarshos shiiqey macca woyko adde dorse gidiko borey baynaba gido. <verse eid="LEV 3:6" /><verse number="7" style="v" sid="LEV 3:7" />Issi asi dorsa urge yarshiyaba gidiko hessa Godaa sinthan shiisho. <verse eid="LEV 3:7" /><verse number="8" style="v" sid="LEV 3:8" />He dorsa urgiya huuphen ba kushiya wothidi Geeshsha Dunkaaniya pengen shuko. Aarona nayti suuthaa ekidi yarsho bessa oyddu maazaniya bolla wurxo. <verse eid="LEV 3:8" /><verse number="9" style="v" sid="LEV 3:9" />Issifetetha yarshuwafe Godaas xuussa yarsho oothidi yarsho; hessika modhuwa, goynaape bidi zoko meqethaa gakanaw de7iya modhuwa, ulo ashuwa kammida moodhiya, <verse eid="LEV 3:9" /><verse number="10" style="v" sid="LEV 3:10" />nam7u kilahota, enta kammida moodhiya tiriya xeera baggaa eko. <verse eid="LEV 3:10" /><verse number="11" style="v" sid="LEV 3:11" />Kahiney hessa Godaas xuussa yarsho oothidi yarsho bessan xuuggo.<verse eid="LEV 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12" />I yarshey deeshe gidiko I hessa Godaa sinthe shiisho. <verse eid="LEV 3:12" /><verse number="13" style="v" sid="LEV 3:13" />Iya huuphen ba kushiya wothidi Geeshsha Dunkaaniya sinthan shuko. Aarona nayti suuthaa ekidi yarsho bessa yuushuwa wurxo. <verse eid="LEV 3:13" /><verse number="14" style="v" sid="LEV 3:14" />I he yarshuwafe ekidi Godaas xuussa yarsho oothidi yarsho; hessika ulo ashuwa kammida moodhiya ubbaa, <verse eid="LEV 3:14" /><verse number="15" style="v" sid="LEV 3:15" />nam7u kilahota, enta kammida moodhiya tiriya xeera baggaa eko. <verse eid="LEV 3:15" /><verse number="16" style="v" sid="LEV 3:16" />Kahiney hessa Godaas sawo tonku giya yarsho oothidi yarsho bessan xuuggo. Modho ubbay Godaaba.<verse eid="LEV 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 3:17" />Hinte modhonne suuthi moopite. Hessi hinttesnne yaana yeletethay de7iya bessa awunka naagiya woga gido.<verse eid="LEV 3:17" /></para>
  <chapter eid="LEV 3" />
  <chapter number="4" style="c" sid="LEV 4" />
  <para style="s1">Nagara Yarsho</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1" />Goday Museko haysada yaagis; <verse eid="LEV 4:1" /><verse number="2" style="v" sid="LEV 4:2" />Neeni Isra7eele asaas haysada yaagada oda; oonika qoponna nagara oothiko woyko Godaa kiitatape issuwa menthiko, <verse eid="LEV 4:2" /><verse number="3" style="v" sid="LEV 4:3" />Dooretida kahiney nagara oothidi asaa gomen gathiko, I ba oothida nagaraa gisho borey bayna wofaano Godaas nagara yarsho oothidi eho. <verse eid="LEV 4:3" /><verse number="4" style="v" sid="LEV 4:4" />He wofaanuwa Geeshsha Dunkaaniya penge ehidi, huuphen ba kushiya wothidi Godaa sinthan shuko. <verse eid="LEV 4:4" /><verse number="5" style="v" sid="LEV 4:5" />Dooretida kahiney wofaanuwa suuthaafe guuthara ekidi Geeshsha Dunkaaniya gelsidi, <verse eid="LEV 4:5" /><verse number="6" style="v" sid="LEV 4:6" />ba biradhiya suuthan yeddi ekidi Geeshsha Dunkaaniya magarajuwa sinthan Godaa sinthan laapun toho wurxo. <verse eid="LEV 4:6" /><verse number="7" style="v" sid="LEV 4:7" />Kahiney guutha suuthi ekidi Geeshsha Dunkaaniyan Godaa sinthan sawiya ixaane cuyisiya bessan de7iya kaceta tiyo. Attida suuthaa Geeshsha Dunkaaniya geliya penge baggara de7iya xuussa yarsho bessa garsan gusso. <verse eid="LEV 4:7" /><verse number="8" style="v" sid="LEV 4:8" />Nagara yarshos shuketida wofaanuwa modhuwa ubbaa, ulo ashuwa ma7ida modhuwa, <verse eid="LEV 4:8" /><verse number="9" style="v" sid="LEV 4:9" />nam7u kilahota, enta kammida moodhiyanne tiriya xeera baggaa eko. <verse eid="LEV 4:9" /><verse number="10" style="v" sid="LEV 4:10" />Issifetetha yarshos shuketida wofaanuwa modhuwa kessidaysada iyape modhuwa kesso. Kahiney xuussa yarsho oothidi yarsho bessan xuuggo. <verse eid="LEV 4:10" /><verse number="11" style="v" sid="LEV 4:11" />Shin wofaanuwa galbaa, iya ashuwa ubbaa, iya huuphiya, iya tohota, ulo ashuwa, tociya, <verse eid="LEV 4:11" /><verse number="12" style="v" sid="LEV 4:12" />ashuwape attidaysa ubbaa gutaape kare kessidi bido yeggiya woga mela geeshsha bessi efidi yan taman xuuggo.<verse eid="LEV 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13" />Isra7eele maabara ubbay qoponna nagara oothikonne Godaa kiitatape issuwa menthiko hessi entafe qosetikoka entaw bala gididi taybetana. <verse eid="LEV 4:13" /><verse number="14" style="v" sid="LEV 4:14" />Enti oothida nagaraa akeekiya wode nagara yarshos haniya wofaano Geeshsha Dunkaaniya sinthe eho. <verse eid="LEV 4:14" /><verse number="15" style="v" sid="LEV 4:15" />Maabara cimati banta kushiya wofaanuwa huuphen wothidi Godaa sinthan shuko. <verse eid="LEV 4:15" /><verse number="16" style="v" sid="LEV 4:16" />Dooretida kahiney wofaanuwa suuthaafe guuthara ekidi Geeshsha Dunkaaniya gido gelo. <verse eid="LEV 4:16" /><verse number="17" style="v" sid="LEV 4:17" />I ba biradhiya suuthan yeddi ekidi magarajuwa sintha baggara Godaa sinthan laapun toho wurxo. <verse eid="LEV 4:17" /><verse number="18" style="v" sid="LEV 4:18" />Qassi guutha suuthi ekidi, Geeshsha Dunkaaniya giddon Godaa sinthan ixaane cuyisiya bessan de7iya kaceta bolla tiyo. Attida suuthaa Geeshsha Dunkaaniya geliya pengiya baggara de7iya xuussa yarsho bessa garsan gusso. <verse eid="LEV 4:18" /><verse number="19" style="v" sid="LEV 4:19" />Modho ubbaa ekidi yarsho bessan xuuggo. <verse eid="LEV 4:19" /><verse number="20" style="v" sid="LEV 4:20" />Ha wofaanuwaka nagara yarshos shuketida wofaanuwa mela oothada shiisha. Hessada oothidi, kahiney nagara atotetha wogaa polana; asaa nagaray atto geetetana. <verse eid="LEV 4:20" /><verse number="21" style="v" sid="LEV 4:21" />Kahiney wofaanuwa gutaape kare kessidi, koyro wofaanoy xuugetidaysada iyaka xuuggo; hessi maabaraas yarshetiya nagara yarsho.<verse eid="LEV 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22" />Asaa kaalethiya shuumatape issoy qoponna nagara oothikonne Godaa Xoossaa kiitaape issuwa menthiko he uray bala. <verse eid="LEV 4:22" /><verse number="23" style="v" sid="LEV 4:23" />I ba oothida nagaraa akeekidaape guye, borey bayna issi kole eho. <verse eid="LEV 4:23" /><verse number="24" style="v" sid="LEV 4:24" />He koliya huuphen ba kushiya wothidi xuussa yarshoy yarshetiya bessan Godaa sinthan shuko; hessi nagara yarsho. <verse eid="LEV 4:24" /><verse number="25" style="v" sid="LEV 4:25" />Kahiney ba biradhiya suuthan yeddi ekidi, xuussa yarsho bessan de7iya kaceta bolla tiyo; attida suuthaa qassi xuussa yarsho bessa garsan gusso. <verse eid="LEV 4:25" /><verse number="26" style="v" sid="LEV 4:26" />Issifetetha yarshos shiiqida modhuwa ubbaa xuuggidaysada ha koliya modhuwa xuuggo. Hessada oothidi, kahiney he uraa nagara qushisees; he uraa nagaray atto geetetana.<verse eid="LEV 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27" />Maabaraape issi asi qoponna nagara oothikonne Godaa kiitaape issuwa menthiko he uray bala gidees. <verse eid="LEV 4:27" /><verse number="28" style="v" sid="LEV 4:28" />I ba oothida nagaraa akeekidaape guye borey bayna macca deeshi ba nagaraa gisho eho. <verse eid="LEV 4:28" /><verse number="29" style="v" sid="LEV 4:29" />Ba kushiya he deeshe huuphen wotho; yaatidi xuussa yarsho bessan nagara yarsho oothidi shuko. <verse eid="LEV 4:29" /><verse number="30" style="v" sid="LEV 4:30" />Hessafe guye, kahiney he deeshe suuthan ba biradhiya yeddi ekidi xuussa yarsho bessan de7iya kaceta bolla tiyo. Attida suutha ubbaa yarsho bessaafe garsan gusso. <verse eid="LEV 4:30" /><verse number="31" style="v" sid="LEV 4:31" />Issifetetha yarshos shuketida mehiyape modhuwa kessidaysa mela he deeshe modhuwa qaari kessidi, yarsho bessan Godaas sawo tonku giya yarsho oothidi xuuggo. Hessada oothidi, kahiney he uraa nagaraa qushisees; iya nagaray atto geetetana.<verse eid="LEV 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32" />He uray ba nagaraa gisho yarshey dorse gidiko, borey bayna macca dorse gido. <verse eid="LEV 4:32" /><verse number="33" style="v" sid="LEV 4:33" />I ba kushiya he dorse huuphen wotho; yaatidi, xuussa yarsho mehe shukiya bessan shuko. <verse eid="LEV 4:33" /><verse number="34" style="v" sid="LEV 4:34" />Hessafe guye, kahiney dorse suuthan ba biradhiya yeddi ekidi xuussa yarshoy yarshetiya bessan de7iya kaceta bolla tiyo. Attida suuthaa yarsho bessaafe garsan gusso. <verse eid="LEV 4:34" /><verse number="35" style="v" sid="LEV 4:35" />Issifetetha yarshos shuketida mehiyape modhuwa kessidaysada he dorse modhuwa qori kessidi, yarsho bessan Godaas xuussa yarsho oothidi xuuggo. Hessada oothidi, kahiney he uraa nagaraa qushisees; iya nagaray atto geetetana.<verse eid="LEV 4:35" /></para>
  <chapter eid="LEV 4" />
  <chapter number="5" style="c" sid="LEV 5" />
  <para style="p">
    <verse number="1" style="v" sid="LEV 5:1" />Issi asi ba be7idaba woyko ba eriyaba markatana mela oyshetidi markatonna ixiko he uray nagara oothida gisho seereto.<verse eid="LEV 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 5:2" />Issi asi eronna de7ishe tunabaa, hessika, hayqida do7a woyko mehe woyko sa7ara gooshetiya do7ata bochiko, hessi tuna gideysa I eronna ixikoka tuna gidiya gisho bala gidees.<verse eid="LEV 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 5:3" />Issi asi eronna de7ishe asa asatethafe goggidi tunisiyaba bochiko, hessi tuna gideysa I eronna ixiko, tuna gidiya gisho bala gidees.<verse eid="LEV 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 5:4" />Issi asi iitaba gidin lo77oba oothanaw eeson caaqikonne ba caaqidaysa dogidi, guyepe I akeekida wodepe doomidi bala gidees.<verse eid="LEV 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 5:5" />Issi asi ha odetida balatape issuwa oothidaba gidiko ba oothida nagaraa paaxo. <verse eid="LEV 5:5" /><verse number="6" style="v" sid="LEV 5:6" />I ba oothida nagaraa gisho Godaas ba mehiya giddofe macca dorse woyko macca deeshe nagaraa yarsho oothidi shiisho. Kahiney ekidi he uraa nagaraa qushethas yarshana.<verse eid="LEV 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7" />Issi asi ba oothida nagaraa gisho yarshanaw dorse woyko deeshe shammanaw iyaw gatey gakonna ixiko nam7u kuraachota woyko nam7u holleta, issuwa nagara yarshos qassi issuwa xuussa yarshos oothidi Godaas eho. <verse eid="LEV 5:7" /><verse number="8" style="v" sid="LEV 5:8" />I enta kahiniyas immo; kahiney nam7u holletape issuwa qoodhiya mirqidi duuthonnashin, nagara yarsho oothidi shiisho. <verse eid="LEV 5:8" /><verse number="9" style="v" sid="LEV 5:9" />Yaatidi suuthaafe guuthara ekidi, yarsho bessa matan wurxo; attida suuthaa yarsho bessa garsan gusso; hessi nagara yarsho. <verse eid="LEV 5:9" /><verse number="10" style="v" sid="LEV 5:10" />Hanko holliya qassi higgey kiiteysada xuussa yarsho oothidi xuuggo. Kahiney haysada oothidi, uray oothida nagaraa qushisanaw yarsho yarshees; he uraa nagaray atto geetetana.<verse eid="LEV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 5:11" />Shin issi asi nam7u holle woyko nam7u kuraacho ehanaw gatey gakonna ixiko, issi kilo giraame lo77o dhiille ba nagaraa gisho yarsho oothidi eho. He dhiilley nagara yarsho gidiya gisho zaytey woyko ixaaney iya bolla guzhetofo. <verse eid="LEV 5:11" /><verse number="12" style="v" sid="LEV 5:12" />I hessa ehidi kahiniyas immo; kahiney he dhiilliyafe issi kuuca ekidi, Godaas shiiqiya katha yarshuwara gathidi, qofiso oothidi yarsho bessan xuuggo; hessi nagara yarsho. <verse eid="LEV 5:12" /><verse number="13" style="v" sid="LEV 5:13" />Issi asi ha nagaratape issuwa oothiko haysada oothidi iya nagara qushisees; he uraa nagaray atto geetetana. He yarshuwafe attidaysi katha yarshuwada kahiniyas gido.<verse eid="LEV 5:13" /></para>
  <para style="s1">Naaqo Yarsho</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14" />Goday Museko haysada yaagis; <verse eid="LEV 5:14" /><verse number="15" style="v" sid="LEV 5:15" />Oonika Godaa naaqikonne geeshsha miisheta tunisidi qoponna nagara oothiko ba naaquwas ba mehiya giddofe borey bayna issi maraze Godaas eho. Iya gatey geeshsha dunkaanen eretida mizaane ginan cigeto; hessi naaqo yarsho. <verse eid="LEV 5:15" /><verse number="16" style="v" sid="LEV 5:16" />I geeshsha miisheta bolla nagara oothida gisho koyro cigganaw bessiya gatiya bolla xeetape laatamu kushe gujidi kahiniyas immo. Kahiney hessa maraziyara gathi yarshidi uraa naaquwa qushisees; iya nagaray atto geetetees.<verse eid="LEV 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 5:17" />Issi asi qoponnashin, Godaa kiitatape issuwa menthidi nagara oothiko I hessa eronna ixikoka bala gidiya gisho ba nagaran seereto. <verse eid="LEV 5:17" /><verse number="18" style="v" sid="LEV 5:18" />I ba mehiyape borey baynanne gate kunthiya issi maraze naaqo yarshos kahiniyako eho. Kahiney he maraziya yarshidi uraa naaquwa qushisees; iya naaqoy atto geetetees. <verse eid="LEV 5:18" /><verse number="19" style="v" sid="LEV 5:19" />I tumape Godaa naaqida gisho hessi naaqo yarsho.<verse eid="LEV 5:19" /></para>
  <chapter eid="LEV 5" />
  <chapter number="6" style="c" sid="LEV 6" />
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1" />Goday Museko haysada yaagis; <verse eid="LEV 6:1" /><verse number="2" style="v" sid="LEV 6:2" />Issi asi hara asi hadara wothidaba woyko tal7idaba lahiko woyko bonqiko woyko cimmiko, <verse eid="LEV 6:2" /><verse number="3" style="v" sid="LEV 6:3" />woyko dhayidabaa demmidi ta be7abike gidi wordon caaqikonne asi oothiya haysa melabaape issuwa oothiko, <verse eid="LEV 6:3" /><verse number="4" style="v" sid="LEV 6:4" />hessan nagarancho gididi bentiko, kaysidaba woyko bonqidaba woyko hadara ekidaba woyko dhayin demmidaba, <verse eid="LEV 6:4" /><verse number="5" style="v" sid="LEV 6:5" />woyko wordon caaqidi ekida kumetha shaluwa godaas zaaro. Qassi ba naaqo yarshuwa yarshiya gallas ba ekidaba bolla xeetape laatamu kushe gujidi shaluwa godaas immo. <verse eid="LEV 6:5" /><verse number="6" style="v" sid="LEV 6:6" />Qassi ba naaquwa gisho Godaas yarsho yarshiya wode ba mehiya giddofe borey bayna issi maraze kahiniyako eho. He dorsay naaqo yarshos gate kuntheysa gido. <verse eid="LEV 6:6" /><verse number="7" style="v" sid="LEV 6:7" />Kahiney he dorsaa yarshidi he uraa naaquwa qushisees; he uraa naaqoy atto geetetana.<verse eid="LEV 6:7" /></para>
  <para style="s1">Xuussa Yarsho</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 6:8" />Goday Museko haysada yaagis; <verse eid="LEV 6:8" /><verse number="9" style="v" sid="LEV 6:9" />Aaronanne iya adde nayta haysada yaagada kiitta; xuussa yarshuwas de7iya wogay haysa; xuussa yarshoy sa7i wontana gakanaw yarsho bessan de7o. Tamay yarsho bessan qamma kumethi eexishe aqo. <verse eid="LEV 6:9" /><verse number="10" style="v" sid="LEV 6:10" />Kahiney liinope dadetida qamise ma7idi, sure dancidi, xuussa yarshuwa tamay mida biduwa kaashidi yarsho bessa miyen laallo. <verse eid="LEV 6:10" /><verse number="11" style="v" sid="LEV 6:11" />Yaatidi ma7uwa qaari wothidi hara ma7o ma7idi he biduwa gutaape gaxa efidi wogaada geeshsha bessan qolo. <verse eid="LEV 6:11" /><verse number="12" style="v" sid="LEV 6:12" />Yarsho bessaa bolla de7iya tamay to7onna ubba wode eexishe de7o. Kahiney wonta wonta mithi iya bolla gujo. Xoossa yarshuwa mitha bolla maaran wothidi, issifetetha yarshuwa modhuwa iya bolla xuuggo. <verse eid="LEV 6:12" /><verse number="13" style="v" sid="LEV 6:13" />Tamay yarsho bessa bolla ubba wode eexishe de7o; to7anaw koshshenna.<verse eid="LEV 6:13" /></para>
  <para style="s1">Katha Yarsho</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 6:14" />Katha yarshos imetida wogay haysa; kahine gidida Aarona nayti yarsho bessaafe sintha baggara Godaa sinthan yarsho. <verse eid="LEV 6:14" /><verse number="15" style="v" sid="LEV 6:15" />Kahiney issi kuuca lo77o dhiillenne zayte ekidi katha yarshuwa bolla de7iya ixaaniyara yarsho bessan Godaas sawo tonku giya qofiso yarsho oothidi xuuggo. <verse eid="LEV 6:15" /><verse number="16" style="v" sid="LEV 6:16" />Iyape attidaysa Aaroninne iya adde nayti uythi uukidi Dunkaaniya dabaaban de7iya geeshsha bessan mo. <verse eid="LEV 6:16" /><verse number="17" style="v" sid="LEV 6:17" />He uythay irshoy bayna uuketo. Taman xuussa yarshuwafe hessa taani entaw gisho oothada immas. Nagara yarshuwa melanne naaqo yarshuwa mela I ubbaafe geeshshi. <verse eid="LEV 6:17" /><verse number="18" style="v" sid="LEV 6:18" />Godaas taman xuussa yarshuwafe enta gakiya gisho gidiya gisho yaa yeletethan Aarona koche gidida addeti ubbay hessa mo. He yarshuwa, geeshshi gidonna oonika bochofo.<verse eid="LEV 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 6:19" />Goday Museko haysada yaagis; <verse eid="LEV 6:19" /><verse number="20" style="v" sid="LEV 6:20" />Aaroninne iya adde nayti kahinetethan tiyetiya wode issi kilo giraame gidiya lo77o dhiille katha yarsho oothidi Godaas eho. Iyape baggaa wonta, baggaa omarsi yarsho. <verse eid="LEV 6:20" /><verse number="21" style="v" sid="LEV 6:21" />He dhiilley zaytera walaketidi loythi munuqetidi bashen uuketo; iya menthada yarsho bessan sawo tonku giya katha yarsho oothada Godaas yarsha. <verse eid="LEV 6:21" /><verse number="22" style="v" sid="LEV 6:22" />Qassi Aarona adde naytape iya kahinetetha laattanaw tiyetiya oonika he wogaa giigisees. Hessi Godaas ubba wode yarshetiya yarsho gidiya gisho kumethi xuugeto. <verse eid="LEV 6:22" /><verse number="23" style="v" sid="LEV 6:23" />Kahiney katha yarshuwa guye ashshona xuugganaw koshshees; I meetetanaw bessenna.<verse eid="LEV 6:23" /></para>
  <para style="s1">Nagara Yarsho</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 6:24" />Goday Museko haysada yaagis; <verse eid="LEV 6:24" /><verse number="25" style="v" sid="LEV 6:25" />Aaronasinne iya adde naytas haysada yaaga; “Nagara yarsho wogay haysa; nagaras shuketiya yarshoy xuussa yarshoy shuketiya bessan Godaa sinthan shuketto. He yarshoy ubbaafe geeshsha yarsho. <verse eid="LEV 6:25" /><verse number="26" style="v" sid="LEV 6:26" />He yarshuwa yarshiya kahiney Dunkaaniya dabaaban de7iya geeshsha bessan mo. <verse eid="LEV 6:26" /><verse number="27" style="v" sid="LEV 6:27" />He ashuwa bochiya oonika geeshshi gido; qassi shukishin suuthi ma7uwa bochiko he ma7oy geeshsha bessan meeceto. <verse eid="LEV 6:27" /><verse number="28" style="v" sid="LEV 6:28" />Ashoy kaxida otoy meqo; birata disten kaxidaba gidiko he miishiya qaacidi haathan meeccanaw koshshees. <verse eid="LEV 6:28" /><verse number="29" style="v" sid="LEV 6:29" />Kahine kochaafe adde gidida oonika he ashuwa mo; he yarshoy ubbaafe geeshshi. <verse eid="LEV 6:29" /><verse number="30" style="v" sid="LEV 6:30" />Shin Geeshsha bessan nagara atotethas suuthaa ekidi Dunkaaniya giddo gelidaba gidiko he mehiya ashoy meetetanaw koshshenna; I taman xuugetanaw bessees.”<verse eid="LEV 6:30" /></para>
  <chapter eid="LEV 6" />
  <chapter number="7" style="c" sid="LEV 7" />
  <para style="s1">Naaqo Yarsho</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1" />Ubbaafe geeshshi gidiya gisho naaqo yarsho wogay haysa; <verse eid="LEV 7:1" /><verse number="2" style="v" sid="LEV 7:2" />Xuussa yarsho mehey shuketiya bessan naaqo yarsho mehey shuketto; iya suuthay yarsho bessa oyddu baggan wurxeto. <verse eid="LEV 7:2" /><verse number="3" style="v" sid="LEV 7:3" />Iya modhuwa ubbaa, hessika goynaape bidi zoko meqethaa gakanaw de7iya modhuwa, ulo ashuwa kammida moodhiya, <verse eid="LEV 7:3" /><verse number="4" style="v" sid="LEV 7:4" />nam7u kilahota, enta kammida moodhiyanne tiriya xeera baggaa ekidi yarsho. <verse eid="LEV 7:4" /><verse number="5" style="v" sid="LEV 7:5" />Kahiney haysata taman xuussa yarsho oothidi Godaas yarsho; hessi naaqo yarsho. <verse eid="LEV 7:5" /><verse number="6" style="v" sid="LEV 7:6" />Kahine yara gidida adde ubbay he yarsho ashuwa mo. He yarshoy ubbaafe geeshshi gidiya gisho geeshsha bessan meeteto.<verse eid="LEV 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 7:7" />Naaqo yarshuwanne nagara yarshuwa wogay issinno. He mehiya ashoy nagara atotethas yarshida kahiniyas imetees. <verse eid="LEV 7:7" /><verse number="8" style="v" sid="LEV 7:8" />Oonika xuussa yarsho mehe ehin ekidi yarshiya kahiney he mehiya galba baw eko. <verse eid="LEV 7:8" /><verse number="9" style="v" sid="LEV 7:9" />Coocen kompetida woyko oton kaxida woyko bashen uuketida ubbay he yarshuwa yarshida kahiniyas imetees. <verse eid="LEV 7:9" /><verse number="10" style="v" sid="LEV 7:10" />Qassi zaytera munuqetida woyko munuqetonna katha yarsho ubbay Aarona adde nayta ubbaas issi gina shaaketidi imetees.<verse eid="LEV 7:10" /></para>
  <para style="s1">Issifetetha Yarsho</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11" />Issi asi issifetetha yarsho Godaas yarshiya wode iyaw de7iya wogay haysa; <verse eid="LEV 7:11" /><verse number="12" style="v" sid="LEV 7:12" />I yarshey galata yarsho gidiko he yarshuwara issife zaytera munuqida uythu, irshoy gelonna uuketidi zayten tiyetida lee7o uythunne lo77o dhiillefe zaytera munuqetida uythu shiisho. <verse eid="LEV 7:12" /><verse number="13" style="v" sid="LEV 7:13" />He issifetetha yarshuwara issife irshora uuketida uythaa imota oothidi yarsho. <verse eid="LEV 7:13" /><verse number="14" style="v" sid="LEV 7:14" />He issi issi uythaafe issuwa denthidi Godaas yarsho oothidi eho. Hessi issifetetha yarshuwa suuthaa wurxida kahiniyas imeto. <verse eid="LEV 7:14" /><verse number="15" style="v" sid="LEV 7:15" />He mehiya ashoy he gallas meeteto; wontas aybika attofo.<verse eid="LEV 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 7:16" />Shin iya yarshoy gaso yarsho woyko dosa yarsho gidiko he ashoy he yarshetida gallas meeteto; iyape attey de7iko wontetha gallas meeteto. <verse eid="LEV 7:16" /><verse number="17" style="v" sid="LEV 7:17" />He ashuwape palahidi heedzantho gallas gakanaw gam7iko hessi taman xuugeto. <verse eid="LEV 7:17" /><verse number="18" style="v" sid="LEV 7:18" />Issi asi shiishida issifetetha yarsho ashoy heedzantho gallasan meetetiko iya yarshoy eketenna; yarshoy yarshetidada taybetenna. He yarshoy tuna; iyape mida oonika ba nagaran oyshetees.<verse eid="LEV 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 7:19" />Tunabaa bochida ashoy meetetofo; I taman xuugetanaw koshshees. Hara ashuwa wogan tuna gidonna asi oonika maana giiko mo. <verse eid="LEV 7:19" /><verse number="20" style="v" sid="LEV 7:20" />Shin issi asi tuna gidi uttidi, Godaas shiiqida issifetetha yarsho ashuwape miyaba gidiko, he uray asaa giddofe kuretto. <verse eid="LEV 7:20" /><verse number="21" style="v" sid="LEV 7:21" />Issi asi tunaba bochiko, asa tunatethi gidin woyko tuna mehe gidin woyko hara ixetiya tunaba bochidi, Godaas yarshetida issifetetha yarsho ashuwape miiko, he uray ba asaa giddofe kureto.<verse eid="LEV 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22" />Goday Museko haysada yaagis; <verse eid="LEV 7:22" /><verse number="23" style="v" sid="LEV 7:23" />Isra7eele asaas haysada yaagada oda; korma woyko maraze woyko kole modho ashuwa moopite. <verse eid="LEV 7:23" /><verse number="24" style="v" sid="LEV 7:24" />Hayqida mehe woyko do7i wodhida mehiya modhuwa harabas go7etitepe attishin, iyape aybaka moopite. <verse eid="LEV 7:24" /><verse number="25" style="v" sid="LEV 7:25" />Godaas taman xuussa yarshos shiiqiya mehiya modho ashuwa miya oonika ba asaa giddofe kuretto. <verse eid="LEV 7:25" /><verse number="26" style="v" sid="LEV 7:26" />Hinte de7iya bessan awun gidikoka, kafo suuthi woyko mehe suuthi moopite. <verse eid="LEV 7:26" /><verse number="27" style="v" sid="LEV 7:27" />Suuthi miya oonika ba asaa giddofe kuretto.<verse eid="LEV 7:27" /></para>
  <para style="s1">Kahineta Gishuwa</para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 7:28" />Goday Museko haysada yaagis; <verse eid="LEV 7:28" /><verse number="29" style="v" sid="LEV 7:29" />Isra7eele asaas haysada yaagada oda; Godaas issifetetha yarsho shiishiya oonika he issifetetha yarshuwafe shaakidi ba imota oothidi Godaas dummayidi yarsho. <verse eid="LEV 7:29" /><verse number="30" style="v" sid="LEV 7:30" />Hessa I Godaas taman xuussa yarsho oothidi, ba kushen ekidi eho. Qassi modhuwa angaasuwara gathi ehidi yuusho yarsho oothidi Godaa sinthan yarsho. <verse eid="LEV 7:30" /><verse number="31" style="v" sid="LEV 7:31" />Kahiney yarsho bessan modhuwa xuuggo; shin angaasoy Aaronasinne iya adde naytas imeto. <verse eid="LEV 7:31" /><verse number="32" style="v" sid="LEV 7:32" />Hinte issifetetha yarshuwafe ushacha gedaa imota oothidi kahiniyas immite. <verse eid="LEV 7:32" /><verse number="33" style="v" sid="LEV 7:33" />He ushacha geday issifetetha yarshuwa suuthaanne modhuwa yarshiya kahiniya gakiya gisho gido. <verse eid="LEV 7:33" /><verse number="34" style="v" sid="LEV 7:34" />Taani Isra7eele asaa issifetetha yarshuwafe yuusho angaasuwan shiiqida gedaa Isra7eele asaape ekada, kahiniya Aaronasinne iya adde naytas gisho oothada immas. Hessi enta gakiya enta gisho gidiya gisho Isra7eele asay merinaw hessa entaw immishe daana.<verse eid="LEV 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 7:35" />Aaroninne iya adde nayti kahine gididi shuumetida gallas Godaas shiiqida xuussa yarshuwafe, hesika entaw gisho gididi imetis. <verse eid="LEV 7:35" /><verse number="36" style="v" sid="LEV 7:36" />Goday enta kahinetethas tiyida gallas, hessa entaw immana mela Isra7eele asaa kiittis; hessi yaana yeletethan eqidi de7iya woga gidana.<verse eid="LEV 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 7:37" />Hiza xuussa yarshuwa, katha yarshuwa, nagara yarshuwa, naaqo yarshuwa, kahineti tiyetiya wode yarshetiya yarshuwanne issifetetha yarshuwa wogay haysa. <verse eid="LEV 7:37" /><verse number="38" style="v" sid="LEV 7:38" />Isra7eele asay Siina mela biittan banta yarshuwa Godaas yarshana mela Goday kiitida gallas, Siina zuma bolla Goday Muse kiitida wogay haysa.<verse eid="LEV 7:38" /></para>
  <chapter eid="LEV 7" />
  <chapter number="8" style="c" sid="LEV 8" />
  <para style="s1">Kahineta Shuumo Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1" />Goday Muses haysada yaagidi odis; <verse eid="LEV 8:1" /><verse number="2" style="v" sid="LEV 8:2" />Aaronanne iya adde nayta, entara issife kahinetetha ma7uwa, tiyo zaytiya, nagara yarshuwa shuketiya kormaa, nam7u marazetanne, irshoy geliboonna uuketida uythaa wothiya gayta ekada ya. <verse eid="LEV 8:2" /><verse number="3" style="v" sid="LEV 8:3" />Qassi Isra7eele asa ubbaa xeegada Dunkaaniya penge shiisha.<verse eid="LEV 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 8:4" />Musey Goday kiitidaysada oothis; asa ubbay dunkaaniya penge shiiqis. <verse eid="LEV 8:4" /><verse number="5" style="v" sid="LEV 8:5" />Musey asaako, ta oothana mela Goday kiittidaysi haysa.<verse eid="LEV 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 8:6" />Musey Aaronanne iya adde nayta ehidi haathan meeccis. <verse eid="LEV 8:6" /><verse number="7" style="v" sid="LEV 8:7" />Aarona ma7uwa mayzidi, danco dancisis; adussa ma7uwa mayzidi iya bolla efuude ma7uwa mayzis. Efuudiya alleeqisidi daddida saqiyan Aarona xeessara gathidi qachis. <verse eid="LEV 8:7" /><verse number="8" style="v" sid="LEV 8:8" />Efuudiya bolla tira kiise sikidi iyan Uriimenne Tumiime wothis. <verse eid="LEV 8:8" /><verse number="9" style="v" sid="LEV 8:9" />Aarona huuphen xaatha qace wothis. Goday Muse kiitidaysada xaatha qaciya sintha baggara Geeshsha worqa guche misiliya wothis.<verse eid="LEV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 8:10" />Hessafe guye Musey tiyo zaytiya ekidi, Dunkaaniyanne Dunkaaniya giddon de7iya miishe ubbaa tiyidi dummayis. <verse eid="LEV 8:10" /><verse number="11" style="v" sid="LEV 8:11" />He zaytiyape ekidi yarsho bessa bolla laapun toho wurxis; iya miisheta, meecha keriyanne iya utuwa dummayanaw he zaytiyara tiyis. <verse eid="LEV 8:11" /><verse number="12" style="v" sid="LEV 8:12" />He tiyo zaytiyape guuthara ekidi Aarona huuphen tigidi iya dummayis. <verse eid="LEV 8:12" /><verse number="13" style="v" sid="LEV 8:13" />Goday Muse kiittidaysada Musey Aarona adde nayta sinthe aathidi ma7o mayzidi danco dancisis. Enta huuphen xaatha qace wothis.<verse eid="LEV 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 8:14" />Musey nagara yarshos yarshetiya kormaa ehis; Aaroninne iya adde nayti he kormaa huuphen banta kushiya wothidosona. <verse eid="LEV 8:14" /><verse number="15" style="v" sid="LEV 8:15" />Musey he kormaa shukidi iya suuthan ba biradhiya yeddi ekidi, yarsho bessan de7iya kaceta tiyidi yarsho bessa geeshshis. Attida suuthaa yarsho bessaafe garsan gussis; hessada oothidi yarsho bessa Xoossas dummayidi geeshshis. <verse eid="LEV 8:15" /><verse number="16" style="v" sid="LEV 8:16" />Musey ulo ashuwa kammida modhuwa ubba, tiriya xeera baggaa, kilahotanne enta kammida modhuwa ekidi, yarsho bessan xuuggis. <verse eid="LEV 8:16" /><verse number="17" style="v" sid="LEV 8:17" />Shin Goday Muse kiitidaysada korma galbaa, attida ashuwanne tociya gutaape gaxa kessidi xuuggis.<verse eid="LEV 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18" />Hessafe guye, Musey xuussa yarshos maraze ehis; Aaroninne iya adde nayti he maraziya huuphen banta kushiya wothidosona. <verse eid="LEV 8:18" /><verse number="19" style="v" sid="LEV 8:19" />Musey he maraziya shukis; iya suuthaa yarsho bessa oyddu maazaneta bolla wurxis. <verse eid="LEV 8:19" /><verse number="20" style="v" sid="LEV 8:20" />Musey maraziya ashuwa qommon qommon qanxerethis; huuphiya, attida ashuwanne modhuwa xuuggis. <verse eid="LEV 8:20" /><verse number="21" style="v" sid="LEV 8:21" />Goday Muse kiitidaysada ulo ashuwanne gedata meeccidi, kumetha dorsaa Godaas sawo tonku giya xuussa yarsho oothidi yarsho bessan xuuggis.<verse eid="LEV 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22" />Kahineti shuumetiya wode shiiqiya nam7antho dorsaa Musey ehis; Aaroninne iya adde nayti he dorsaa huuphen banta kushiya wothidosona. <verse eid="LEV 8:22" /><verse number="23" style="v" sid="LEV 8:23" />Musey he maraziya shukis; iya suuthaafe ekidi, Aaronas ushacha haythaa, ushacha kushiya wogga biradhiyanne, ushacha tohuwa wogga biradhiya tiyis. <verse eid="LEV 8:23" /><verse number="24" style="v" sid="LEV 8:24" />Qassi Musey Aarona adde nayta sinthe aathidi, he suuthaafe ekidi, enta ushacha haythaa, ushacha kushiya wogga biradhiyanne ushacha tohuwa wogga biradhiya tiyis. Yaatidi, Musey attida suuthaa yarsho bessa oyddu maazaneta bolla wurxis.<verse eid="LEV 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 8:25" />Modhdhuwa, goynaape bidi zoko meqethaa gakanaw de7iya modhuwa, tiriya xeera baggaa, kilahotanne enta kammida modhuwanne ushacha gedaa ekis. <verse eid="LEV 8:25" /><verse number="26" style="v" sid="LEV 8:26" />Godaa sinthan de7iya gaytape irshoy bayna uuketida issi uythaa, uuketidi zayten tiyetida issi uythaanne lee7on uuketida uythaa ekidi modhuwa bollanne ushacha gedaa bolla wothis. <verse eid="LEV 8:26" /><verse number="27" style="v" sid="LEV 8:27" />I he katha ubbaa Aarona kusheninne iya adde nayta kushen wothin, Godaa sinthan yuusho yarsho oothidi yarshidosona. <verse eid="LEV 8:27" /><verse number="28" style="v" sid="LEV 8:28" />Musey he kathaa enta kushepe ekidi, xuussa yarshuwara gathidi, kahineta shuumiya wode Godaas sawo tonku giya yarsho oothidi yarsho bessan xuuggis. <verse eid="LEV 8:28" /><verse number="29" style="v" sid="LEV 8:29" />Qassi Musey angaasuwa ekidi, yuusho yarsho oothidi Godaa sinthan yarshis. Goday Muse kiitidaysada, kahineta shuumiya wode yarshetiya maraziya ashuwape hessi Muse gakiya gisho.<verse eid="LEV 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30" />Musey tiyo zaytiyapenne yarsho bessan de7iya suuthaafe ekidi, Aarona bollanne iya ma7uwa bolla, iya adde nayta bollanne, enta ma7uwa bolla wurxis; Aaronanne iya ma7uwa, iya naytanne enta ma7uwa dummayis.<verse eid="LEV 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31" />Musey Aaronanne iya adde naytako haysada yaagis; ashuwa Dunkaaniya pengen kathite; Aaroninne iya adde nayti ta kiitidaysada gaytan de7iya geeshsha uythaara miite. <verse eid="LEV 8:31" /><verse number="32" style="v" sid="LEV 8:32" />He ashuwapenne uythaafe palahiday de7iko taman xuuggite. <verse eid="LEV 8:32" /><verse number="33" style="v" sid="LEV 8:33" />Kahineta shuumiya wogay laapun gallas ekiya gisho he wogay poletiya laapun gallasay wurana gakanaw Dunkaaniya pengefe kare keyopite. <verse eid="LEV 8:33" /><verse number="34" style="v" sid="LEV 8:34" />Goday kiittin hachi poletida wogay hinte nagaraa quchanaasa. <verse eid="LEV 8:34" /><verse number="35" style="v" sid="LEV 8:35" />Dunkaaniya pengen laapun gallas kumethi gallasinne qamma gam7ite; Godaa wogaa naagite; ixiko hinte hayqana. Tana Goday kiittiday haysa. <verse eid="LEV 8:35" /><verse number="36" style="v" sid="LEV 8:36" />Aaroninne iya adde nayti Goday Muse baggara kiittidaba ubbaa oothidosona.<verse eid="LEV 8:36" /></para>
  <chapter eid="LEV 8" />
  <chapter number="9" style="c" sid="LEV 9" />
  <para style="s1">Aarona Koyro Yarshuwa</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1" />Hospuntha gallas Musey Aarona, iya adde naytanne Isra7eele cimata xeegis. <verse eid="LEV 9:1" /><verse number="2" style="v" sid="LEV 9:2" />Aaronako haysada yaagis; borey bayna issi korma nagaraa yarshos, qassi issi maraze xuussa yarshos Godaa sinthe shiisha. <verse eid="LEV 9:2" /><verse number="3" style="v" sid="LEV 9:3" />Borey bayna issi kole nagara yarshos, issi laythi kumida marinne dorsa urge xuussa yarshos bantaw ehana mela Isra7eele asaas oda. <verse eid="LEV 9:3" /><verse number="4" style="v" sid="LEV 9:4" />Qassi issifetetha yarshos issi korma, issi marazenne katha yarshos zaytera munuqetida dhiille ehana mela entaw oda. Hachi Goday hintew qoncana gisho hessa oothite.<verse eid="LEV 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 9:5" />Enti Musey kiittidaba ubbaa Geeshsha Dunkaaniya sinthe ehidosona; maabara ubbay shiiqidi Godaa sinthan eqidosona. <verse eid="LEV 9:5" /><verse number="6" style="v" sid="LEV 9:6" />Musey entako, Godaa bonchoy hintew qoncana mela hinte oothana mela Goday kiittiday haysa.<verse eid="LEV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 9:7" />Musey Aaronako haysada yaagis; “Yarsho bessaako shiiqada ne nagaraa gisho nagara yarshonne xuussa yarsho yarsha. Goday kiitidaysada asaa nagaraa atotethas yarsho yarsha.”<verse eid="LEV 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8" />Aaroni yarsho bessaako yidi, ba nagaraa gisho yarshetiya maraa shukis. <verse eid="LEV 9:8" /><verse number="9" style="v" sid="LEV 9:9" />Aarona nayti suuthaa ekidi iyaw ehidosona; I, ba biradhiya he suuthan yeddi ekidi, yarsho bessan de7iya kaceta tiyis; attida suuthaa yarsho bessaafe garsan gussis. <verse eid="LEV 9:9" /><verse number="10" style="v" sid="LEV 9:10" />Goday Muse kiitidaysada, ashuwape modhuwa, kilahotanne tiriya xeera baggaa ekidi yarsho bessan xuuggis. <verse eid="LEV 9:10" /><verse number="11" style="v" sid="LEV 9:11" />Shin attida ashuwanne galbaa gutaape kare kessidi xuuggis.<verse eid="LEV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12" />Aaroni xuussa yarshos shiiqida mehiya shukis; iya nayti suuthaa ekidi iyaw ehidosona. I yarsho bessa oyddu maazaneta bolla wurxis. <verse eid="LEV 9:12" /><verse number="13" style="v" sid="LEV 9:13" />Enti ashuwa qommon qommon kessidi, huuphiyara wolla iyaw ehidosona; I ekidi yarsho bessan xuuggis. <verse eid="LEV 9:13" /><verse number="14" style="v" sid="LEV 9:14" />Ulo ashuwanne gedata haathan meeccidi, yarsho bessan de7iya xuussa yarshuwa bolla wothidi xuuggis.<verse eid="LEV 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 9:15" />Hessafe guye, Aaroni asaa gisho yarsho yarshis. I asaa nagaraa gisho yarshetiya koliya ekidi shukis; I kase ba nagaraa yarshidaysada enta nagaraa gisho yarshis. <verse eid="LEV 9:15" /><verse number="16" style="v" sid="LEV 9:16" />Wogay kiiteysada xuussa yarshos shiiqiya mehiya ehidi yarshis. <verse eid="LEV 9:16" /><verse number="17" style="v" sid="LEV 9:17" />Katha yarshuwa ehidi, iyape issi kuuca ekidi, wonta wonta xuussa yarshuwa bolla gujidi yarsho bessan xuuggis.<verse eid="LEV 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 9:18" />Aaroni kormanne maraziya asaas issifetetha yarsho oothidi shukis; iya adde nayti suuthaa iyaw ehidosona; I he suuthaa ekidi yarsho bessa oyddu maazaneta bolla wurxis. <verse eid="LEV 9:18" /><verse number="19" style="v" sid="LEV 9:19" />Kormanne maraziya ashuwape modhuwa, goynaape bidi zoko meqethaa gakanaw de7iya modhuwa, ulo ashuwa kammida modhuwa, kilahotanne tiriya xeera baggaa ekidi, <verse eid="LEV 9:19" /><verse number="20" style="v" sid="LEV 9:20" />enti angaaysuwa bolla wothin, Aaroni yarsho bessan xuuggis. <verse eid="LEV 9:20" /><verse number="21" style="v" sid="LEV 9:21" />Goday Muse kiitidaysada, Aaroni angaaysuwanne ushacha gedaa yuusho yarsho oothidi Godaa sinthan yuushshis.<verse eid="LEV 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22" />Hessafe guye, Aaroni ba kushiya asaako denthidi enta anjis. I nagara yarshuwa, xuussa yarshuwanne issifetetha yarshuwa yarshidaape guye yarsho bessaafe wodhis. <verse eid="LEV 9:22" /><verse number="23" style="v" sid="LEV 9:23" />Museynne Aaroni Geeshsha Dunkaaniya giddo gelidosona; enti yaape keyidi asaa anjidosona. He wode Godaa bonchoy asa ubbaas qoncis. <verse eid="LEV 9:23" /><verse number="24" style="v" sid="LEV 9:24" />Godaa matape tami wodhidi, yarsho bessan de7iya xuussa yarshuwanne modhuwa mis. Asa ubbay hessa be7ida wode ililidosona; gufannidi bonchidosona.<verse eid="LEV 9:24" /></para>
  <chapter eid="LEV 9" />
  <chapter number="10" style="c" sid="LEV 10" />
  <para style="s1">Naadabanne Abiyooda Hayquwa</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1" />Aarona adde nayti, Naadabinne Abyoodi, banta ixaane cuyisiya miishe ekidi iya bolla tama wothidosona; iya bolla ixaane gujidosona. Goday enta kiittiboona coo tama Godaa sinthan shiishidosona. <verse eid="LEV 10:1" /><verse number="2" style="v" sid="LEV 10:2" />Hessa gaason Godaa matape tami yidi enta min, enti Godaa sinthan hayqidosona. <verse eid="LEV 10:2" /><verse number="3" style="v" sid="LEV 10:3" />Musey Aaronako, Goday,</para>
  <para style="q1" vid="LEV 10:3">“Taani asaa giddofe taako shiiqeyisata,</para>
  <para style="q2" vid="LEV 10:3">ta geeshshatetha bessaana.</para>
  <para style="q1" vid="LEV 10:3">Qassi asa ubbaa sinthan</para>
  <para style="q2" vid="LEV 10:3">ta bonchetana”</para>
  <para style="m" vid="LEV 10:3">gidi odidaysa haysa be7a.</para>
  <para style="p" vid="LEV 10:3">Aaroni zaaro immonna si77i gis.<verse eid="LEV 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4" />Musey Aarona aawa ishaa Uzi7eela adde nayta Misa7eelanne Elzafaana xeegidi, “Haa yidi hinte aawa ishaa nayta aha Geeshsha Dunkaaniya sinthafe denthidi, gutaape gaxa kessite” yaagis. <verse eid="LEV 10:4" /><verse number="5" style="v" sid="LEV 10:5" />Enti yidi, Musey kiitidaysada enta kahinetetha ma7uwara enta aha tookidi, gutaape gaxa kessidosona.<verse eid="LEV 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 10:6" />Musey Aaronanne iya adde nayta, Alaazaranne Itamaara haysada yaagis; “Hinte hayqonna melanne Goday ba asaa bolla hanqetonna mela hinte huuphiya meedopite; hinte ma7uwaka daakofite. Shin hinte ishati, Isra7eele asay, Goday ba taman wodhidaysatas yeeko. <verse eid="LEV 10:6" /><verse number="7" style="v" sid="LEV 10:7" />Godaa tiyo zaytey hinte bolla di7iya gisho Dunkaaniya pengefe kare keyopite; keyiko hinte hayqana” yaagis. Enti Musey gidaysada oothidosona.<verse eid="LEV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8" />Goday Aaronako haysada yaagis; <verse eid="LEV 10:8" /><verse number="9" style="v" sid="LEV 10:9" />Hinte hayqonna mela Dunkaaniya gido geliya wode nenne ne nayti woyne ushshi woyko hara mathoyiya ushshi uyopite; hessi sinthafe yaana yeletethaas merinaw eqidi de7iya woga gidana. <verse eid="LEV 10:9" /><verse number="10" style="v" sid="LEV 10:10" />Hinte geeshshabanne geeshshi gidonaba qassi tunabaanne tuna gidonaba shaakidi erite. <verse eid="LEV 10:10" /><verse number="11" style="v" sid="LEV 10:11" />Goday Muse baggara odida woga ubbaa Isra7eele asaa tamaarsite.<verse eid="LEV 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12" />Musey Aaronanne attida iya adde nayta Alaazaranne Itamaara haysada yaagis; Godaas xuussa yarshuwafe attida katha yarshuwa ekidi irsho yeggonna uukite. I ubbaafe geeshshi gidiya gisho yarsho bessaa matan miite. <verse eid="LEV 10:12" /><verse number="13" style="v" sid="LEV 10:13" />Godaas xuussa yarshuwafe hessi nenanne ne adde nayta gakiya gisho gidiya gisho, hessa hinte geeshsha bessan miite; Haysa hinte oothana mela Goday tana kiittis. <verse eid="LEV 10:13" /><verse number="14" style="v" sid="LEV 10:14" />Shin yuusho yarshos shiiqida angaaysuwanne gedaa neeni, ne adde naytinne ne macca nayti geeshsha bessan miite. Hessi Isra7eele asay shiishiya issifetetha yarshuwafe nenanne ne adde nayta gakiya hinte gisho. <verse eid="LEV 10:14" /><verse number="15" style="v" sid="LEV 10:15" />Godaas yarshida gedaanne yuusho yarshos shiiqida angaasuwa modhuwara issife gathidi Godaa sinthan yuusho yarsho oothidi yarshanaw shiiqo. Goday kiitidaysada, hessi newunne ne adde naytas merinaw hintena gakiya gisho gidana.<verse eid="LEV 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16" />Musey nagara yarshos shiiqida deesha enti waatidaako eranaw koyidi oychis; I xuugetidaysa erida wode attida Aarona adde nayta, Alaazaranne Itamaara bolla hanqetis. <verse eid="LEV 10:16" /><verse number="17" style="v" sid="LEV 10:17" />“Nagaraa yarshos shiiqida ashuwa ayis geeshsha bessan mibeeketii? I ubbaafe geeshshi. Godaa sinthan asaa nagaraa diggidi asaas atotethi immana mela hessi hintew imetis. <verse eid="LEV 10:17" /><verse number="18" style="v" sid="LEV 10:18" />He mehiya suuthay geeshsha Dunkaaniya giddo geliboonna gisho, taani hintena kiitidaysada, hinte iya geeshsha bessan maanaw bessees, shin aggideta” yaagis.<verse eid="LEV 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 10:19" />Aaroni Museko, “Heko, ha asati hachi banta nagaraa yarshuwanne xuussa yarshuwa Godaa sinthe ehidosona. Gidoshin, hessa melabay ta bolla gakis. Taani nagaraa yarshuwa hachi midaba gidiyako, Goday ufaytanashin attidee?” yaagis. <verse eid="LEV 10:19" /><verse number="20" style="v" sid="LEV 10:20" />Musey hessa si7ida wode iya zaaruwan ufaytis.<verse eid="LEV 10:20" /></para>
  <chapter eid="LEV 10" />
  <chapter number="11" style="c" sid="LEV 11" />
  <para style="s1">Tunanne Tuna Gidonna Do7ata</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1" />Goday Musekonne Aaronako, <verse eid="LEV 11:1" /><verse number="2" style="v" sid="LEV 11:2" />Isra7eele asaas haysada yaagidi odite; “Biitta bolla de7iya mehetapenne do7atape hinte maanaysati haysata; <verse eid="LEV 11:2" /><verse number="3" style="v" sid="LEV 11:3" />Shuquley phalqetidaysatanne waammotiya meheta miite. <verse eid="LEV 11:3" /><verse number="4" style="v" sid="LEV 11:4" />Shin waammotishe shuquley phalqetonaysatanne shuquley phalqethi gididi waammotonayisata moopite. Gimaley waammotees, shin shuquley phalqetonna gisho, hintew tuna gido. <verse eid="LEV 11:4" /><verse number="5" style="v" sid="LEV 11:5" />Gupalley waammotees, shin shuquley phalqetonna gisho, hintew tuna gido. <verse eid="LEV 11:5" /><verse number="6" style="v" sid="LEV 11:6" />Eshey waammotees, shin shuquley phalqethi gidonna gisho, hintew tuna gido. <verse eid="LEV 11:6" /><verse number="7" style="v" sid="LEV 11:7" />Guduntho moopite; iyaw shuquley phalqethi, shin waammotonna gisho, I hintew tuna. <verse eid="LEV 11:7" /><verse number="8" style="v" sid="LEV 11:8" />Hinte hessata moopite; enta bawuta bochofite; enti hintew tuna.<verse eid="LEV 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 11:9" />“Haatha giddon de7iya medhetetha ubbaafe hinte maanaysati haysata; Abbaa giddon woyko shaafa haatha giddon de7iya ubbaafe qefeynne poqoy de7iya ubbaa miite. <verse eid="LEV 11:9" /><verse number="10" style="v" sid="LEV 11:10" />Shin abba giddon woyko goggiya haathan de7iya qefeynne poqoy bayna medhetethati hintew tuna gidiya gisho moopite. <verse eid="LEV 11:10" /><verse number="11" style="v" sid="LEV 11:11" />Haysati hintew tuna; enta moopite; enta bawuta bochofite. <verse eid="LEV 11:11" /><verse number="12" style="v" sid="LEV 11:12" />Qefeynne poqoy bayna haatha giddon de7iya medhetethati ubbay hintew tuna.<verse eid="LEV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 11:13" />“Kafotape hintew tuna gididaysatinne hinte maanaw bessonnaysati haysata; arganthi, anko, molo kafo, <verse eid="LEV 11:13" /><verse number="14" style="v" sid="LEV 11:14" />xilo, phirco qommo ubbaa, <verse eid="LEV 11:14" /><verse number="15" style="v" sid="LEV 11:15" />quuro ubbaa <verse eid="LEV 11:15" /><verse number="16" style="v" sid="LEV 11:16" />yancho, solo, qoolle, gutto ubbaa, <verse eid="LEV 11:16" /><verse number="17" style="v" sid="LEV 11:17" />guutha gutto, hazazo, diidinthe, <verse eid="LEV 11:17" /><verse number="18" style="v" sid="LEV 11:18" />haatha kutto, shi7a anko, daare anko, <verse eid="LEV 11:18" /><verse number="19" style="v" sid="LEV 11:19" />silaago, saabisanne iya qommo ubba, ayyaana kafonne shirshiqo.<verse eid="LEV 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20" />“Qefera de7iya oyddu tohon hemetiya laafa medhetethati ubbay hintew tuna. <verse eid="LEV 11:20" /><verse number="21" style="v" sid="LEV 11:21" />Gidoshin, qefey de7iya oyddu tohon hemeteysatape enta tohuwape bollara gupanaw maaddiya tohoy de7eyisata miite. <verse eid="LEV 11:21" /><verse number="22" style="v" sid="LEV 11:22" />Hessatika, boole qommo ubbaa, xaqo ubbaanne sere ubbaa. <verse eid="LEV 11:22" /><verse number="23" style="v" sid="LEV 11:23" />Shin hara qefera de7iya oyddu tohoy de7iya medhetethati ubbay hintew tuna.<verse eid="LEV 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24" />“Haysati hintena tunisana; enta bawuta bochiya oonika omarsi gakanaw tuna gidana. <verse eid="LEV 11:24" /><verse number="25" style="v" sid="LEV 11:25" />Enta bawuta denthiya oonika ba ma7uwa meecco; shin omarsi gakanaw I tuna gido. <verse eid="LEV 11:25" /><verse number="26" style="v" sid="LEV 11:26" />Shuquley de7ishe phalqethi gidonnaysati woyko waammotonnaysati ubbay hintew tuna; enta bochiya oonika tunees. <verse eid="LEV 11:26" /><verse number="27" style="v" sid="LEV 11:27" />Oyddu tohotan hemetiya do7a ubbaafe gindera hemeteysati hintew tuna; enta bawuta bochiya oonika omarsi gakanaw tunees. <verse eid="LEV 11:27" /><verse number="28" style="v" sid="LEV 11:28" />Enta bawuta denthiya oonika ba ma7uwa meecco; shin omarsi gakanaw I tuna. Entika hintew tuna.<verse eid="LEV 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 11:29" />“Sa7ara hemeteysatape haysati hintew tuna. Entika giro, ecere, dumma dumma koche, <verse eid="LEV 11:29" /><verse number="30" style="v" sid="LEV 11:30" />geegge, haylasho, korche, wakallanne shaaqancho. <verse eid="LEV 11:30" /><verse number="31" style="v" sid="LEV 11:31" />Sa7ara hemetiya ubbaafe haysati hintew tuna; enta bawuta bochiya oonika omarsi gakanaw tuna gidees. <verse eid="LEV 11:31" /><verse number="32" style="v" sid="LEV 11:32" />Enta bawuta bochiya ay miisheyka tuna gidees; mitha miishey woyko ma7oy woyko galbi woyko ogoroy tuna gidees. Enta bawutay bochida miishe ubbay haathan muuketidi omarsi gakanaw gam7o; hessafe guye geeshshi gidana. <verse eid="LEV 11:32" /><verse number="33" style="v" sid="LEV 11:33" />Entafe issuwa bawutay oto giddon wodhidi bentiko, iya giddon de7iyaba ubbay tuna; he otuwa menthite. <verse eid="LEV 11:33" /><verse number="34" style="v" sid="LEV 11:34" />Ay kathi gidin he otuwa giddon de7iya haathaafe xokiko, he kathay tuna gidees; uyetiyaba gidin, he otuwa giddon de7iko tuna gidees. <verse eid="LEV 11:34" /><verse number="35" style="v" sid="LEV 11:35" />He bawutape issoy wodhida miishe ubbay tuna; cooce woyko oto gidikoka menthite; enti hintew tuna. <verse eid="LEV 11:35" /><verse number="36" style="v" sid="LEV 11:36" />He bawutay bochida ubbay tuna gidikoka pultoynne haatha olli tunenna. <verse eid="LEV 11:36" /><verse number="37" style="v" sid="LEV 11:37" />Enta bawutape issoy zeretha katha bolla wodhiko, hessi tunenna. <verse eid="LEV 11:37" /><verse number="38" style="v" sid="LEV 11:38" />Shin he zerethaa bolla haathi gukidi simmin, enta bawutape issoy iya bolla wodhiko, he zerethay hintew tuna.<verse eid="LEV 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 11:39" />“Meetetiya mehetape issoy bawutiko, iya bawuta bochiya oonika omarsi gakanaw tuna. <verse eid="LEV 11:39" /><verse number="40" style="v" sid="LEV 11:40" />Oonika he mehiya bawutape miiko, ba ma7uwa meecco; omarsi gakanaw I tuna. Oonika iya bawuta tookidi denthiko, ba ma7uwa meecco; omarsi gakanaw I tuna.<verse eid="LEV 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41" />“Sa7ara gooshetiya medhetethi ubbay hintew tuna; iya moopite. <verse eid="LEV 11:41" /><verse number="42" style="v" sid="LEV 11:42" />Ulora gooshetiyaba gidin, oyddu tohora hemetiyaba gidin, daro tohoy de7iyaba gidin, sa7ara gooshetiya medhetethi ubbay hintew tuna gidiya gisho moopite. <verse eid="LEV 11:42" /><verse number="43" style="v" sid="LEV 11:43" />Ha sa7ara gooshetiya medhetethatan hintena tunisopite; enta gaason hinte asatethaa tunisopite. <verse eid="LEV 11:43" /><verse number="44" style="v" sid="LEV 11:44" />Taani Godaa, hinte Xoossaa. Taani geeshshi gidiya gisho, hintena dummayidi geeshshi gidite. Sa7ara gooshetiyabatan hinte asatethaa tunisopite. <verse eid="LEV 11:44" /><verse number="45" style="v" sid="LEV 11:45" />Taani hintew Xoosse gidanaw hintena Gibxe biittafe kessida hinte Godaa. Hesaa gisho, taani geeshshi gidiya gisho, hinteka geeshshi gidite.<verse eid="LEV 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 11:46" />“Mehe, kafo, haatha giddon qaaxiya medhetethi ubbaanne sa7ara hemetiya medhetetha ubbaa wogay haysa. <verse eid="LEV 11:46" /><verse number="47" style="v" sid="LEV 11:47" />Hessan hinte tunanne tuna gidonnayisata giddon, qassi meetetiyanne meetetonna medhetethata giddon de7iya dummatethaa shaakidi erana.”<verse eid="LEV 11:47" /></para>
  <chapter eid="LEV 11" />
  <chapter number="12" style="c" sid="LEV 12" />
  <para style="s1">Maccasi Yeli Simmidi Geeyiya Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1" />Goday Museko haysada yaagis; <verse eid="LEV 12:1" /><verse number="2" style="v" sid="LEV 12:2" />Isra7eele asaas haysada yaagada oda; “Issi maccasi qanthatada adde na7a yeliko, ba kushe metuwa be7iya wode tuna gideysada laapun gallas gakanaw tuna gidana. <verse eid="LEV 12:2" /><verse number="3" style="v" sid="LEV 12:3" />Hospuntha gallas na7ay qaxaretanaw koshshees. <verse eid="LEV 12:3" /><verse number="4" style="v" sid="LEV 12:4" />Hessafe guye, maccasiya ba yelo suuthay xiz7ana gakanaw hastamanne heedzu gallas gam7o; qassi ba geeyiya gallasay wurana gakanaw geeshshaba bochofo; Geeshsha Dunkaaniyaka gelopo.<verse eid="LEV 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 12:5" />“Shin issi maccasi macca na7a yeliko, ba kushe meto be7ida wode iya tuna gididaysada nam7u saaminta gakanaw iya tuna gidana. Hessafe guye, ba yelo suuthay xiz7ana gakanaw usupun tammanne usupun gallas gam7o.<verse eid="LEV 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 12:6" />“Maccasiya adde na7a woyko macca na7a yelada ba geeyiya wodiya ongidaape guye, xuussa yarshos issi laytha dorsenne nagara yarshos qassi issi holle woyko issi kuraacho Geeshsha Dunkaaniya pengen de7iya kahiniyako eho. <verse eid="LEV 12:6" /><verse number="7" style="v" sid="LEV 12:7" />Kahiney hessa ekidi Godaa sinthan I nagaraa atotethas yarshees. Hessafe guye, iya geeyana. Adde na7a woyko macca na7a yeliya maccasas de7iya wogay haysa.<verse eid="LEV 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 12:8" />“Shin iya issi laytha dorse ehanaw danda7onna ixiko, nam7u holleta woyko nam7u kuraachota eho. Entafe issoy xuussa yarshos, qassi issoy nagara yarshos gido. Hessada oothidi kahiney I nagaraa atotethas yarshees; iyaka geeshshi gidana.”<verse eid="LEV 12:8" /></para>
  <chapter eid="LEV 12" />
  <chapter number="13" style="c" sid="LEV 13" />
  <para style="s1">Goga Harge Higgeta</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1" />Goday Musekonne Aaronako haysada yaagis; <verse eid="LEV 13:1" /><verse number="2" style="v" sid="LEV 13:2" />“Issi asa asatethaa bolla kixi wodhiko woyko shattoy woyko iralley keyiko iya gogay hargen laametiko, he uraa kahiniya Aaronako woyko kahine gidida iya adde naytape issuwako eho. <verse eid="LEV 13:2" /><verse number="3" style="v" sid="LEV 13:3" />Kahiney iya goga bolla de7iya madunthaa be7o. He madunxida bessan de7iya ikisey booxikonne madunthay ollatiko, hessi goga harge. Kahiney hessa be7idi uray tuna gideysa eriso. <verse eid="LEV 13:3" /><verse number="4" style="v" sid="LEV 13:4" />Shin iya gogaa bolla de7iya madunthay boothi gididi, gogaape kanthidi ollatiboonaba gidiko he madunthaa bolla de7iya ikisey booxonnaba gidiko, kahiney he uraa dumma keethan laapun gallas gordidi wotho. <verse eid="LEV 13:4" /><verse number="5" style="v" sid="LEV 13:5" />Laapuntha gallas kahiney iya zaaridi be7o; I be7iya wode madunthay uraa gogaa bolla dalgonna kaseysda de7iko, kahiney he uraa nam7antho dumma keethan laapun gallas gordidi wotho. <verse eid="LEV 13:5" /><verse number="6" style="v" sid="LEV 13:6" />Qassika laapuntha gallas kahiney iya be7o; I be7iya wode madunthay dalgonna ixidi dhayi dhayi biiko, kahiney I tuna gideysa eriso. Hessi goo7o gideysa eriso; he uray ba ma7uwa meeccidi tuna gidonaysa erisees. <verse eid="LEV 13:6" /><verse number="7" style="v" sid="LEV 13:7" />Shin I geeyanaw bana kahiniya bessidaape guye, he goo7oy iya gogaa bolla dalgi dalgi biiko I zaaridi bana bessanaw kahiniyako boo. <verse eid="LEV 13:7" /><verse number="8" style="v" sid="LEV 13:8" />Kahiney iya be7o; he goo7oy uraa gogaa bolla dalgi dalgi biiko, hessi goga harge gidiya gisho kahiney I tuna gideysa eriso.<verse eid="LEV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9" />“Oonika goga hargen oyketiko iya kahiniyako eho. <verse eid="LEV 13:9" /><verse number="10" style="v" sid="LEV 13:10" />Kahiney iya be7iya wode iya gogaa bolla bootha kixi de7iko, ikisey boothi laammikonne he kixa giddon ashoy bentiko, <verse eid="LEV 13:10" /><verse number="11" style="v" sid="LEV 13:11" />hessi gogaa bolla gam7ida harge gidiya gisho, kahiney I tuna gideysa eriso. I tuna gideysi eretida gisho, iya dumma keethan gordidi wothanaw koshshenna. <verse eid="LEV 13:11" /><verse number="12" style="v" sid="LEV 13:12" />Kahiney goga hargey addiya asatethaa bolla dalgiko, huuphepe toho gakanaw ubbaa ma77idaba gidiko be7o. <verse eid="LEV 13:12" /><verse number="13" style="v" sid="LEV 13:13" />He goga hargey iya asatethaa ubbaa ma7iko, iya asatethay kumethi laametidi boothi gidida gisho, I tuna gidonaysa kahiney eriso. <verse eid="LEV 13:13" /><verse number="14" style="v" sid="LEV 13:14" />Shin he maduntha giddora ashoy bentiko I tuna. <verse eid="LEV 13:14" /><verse number="15" style="v" sid="LEV 13:15" />Kahiney he ashuwa be7idi he uray tuna gideysa eriso. He ashoy goga harge gidiya gisho I tuna. <verse eid="LEV 13:15" /><verse number="16" style="v" sid="LEV 13:16" />Shin he ashoy qassika laametidi booxiko, he uray kahiniyako bo. <verse eid="LEV 13:16" /><verse number="17" style="v" sid="LEV 13:17" />Kahiney iya be7o; iya madunthay booxidaba gidiko, he uray tuna gidonaysa kahiney eriso; I tuna gidana.<verse eid="LEV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 13:18" />“Issi asa bolla merkoy wodhidi paxidaba gidiko, <verse eid="LEV 13:18" /><verse number="19" style="v" sid="LEV 13:19" />iya bessan bootha kixay wodhiko woyko zo77ida iralley keyiko he uray kahiniyako bo. <verse eid="LEV 13:19" /><verse number="20" style="v" sid="LEV 13:20" />Kahiney iya be7o; he madunthay ollatiko, madunthaa bolla de7iya ikisey laametidi booxiko, he uray tuna gideysa kahiney eriso. Hessi merkoda doomida goga harge. <verse eid="LEV 13:20" /><verse number="21" style="v" sid="LEV 13:21" />Shin kahiney be7iya wode ikisey booxonnaba gidiko, madunthay gogaa kanthidi ollatiboonaba gidiko, qassi dhayi dhayi biiko, kahiney iya dumma keethan laapun gallas gordidi wotho. <verse eid="LEV 13:21" /><verse number="22" style="v" sid="LEV 13:22" />Hessi iya gogaa bolla dalgi dalgi biiko, hessi goga harge gidiya gisho he uray tuna gideysa kahiney eriso. <verse eid="LEV 13:22" /><verse number="23" style="v" sid="LEV 13:23" />Shin he iralley dalgi dalgi boonna issi bessan de7iko, hessi merkoy paxida beeta gidiya gisho, he uray tuna gidonaysa eriso.<verse eid="LEV 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 13:24" />“Tami issi asi miiko he mida bessan bootha woyko zo7o iralley keyiko, <verse eid="LEV 13:24" /><verse number="25" style="v" sid="LEV 13:25" />kahiney he bessa be7o. He bessan de7iya ikisey booxikonne he madunthay ollatiko, hessi goga harge. I tamay mida bessaara keyida gisho kahiney I tuna gideysa eriso. <verse eid="LEV 13:25" /><verse number="26" style="v" sid="LEV 13:26" />Shin kahiney be7iya wode he madunthaa bolla de7iya ikisey booxonnaba gidiko, madunthay gogaa kanthidi ollatiboonaba gidikonne qassi dhayi dhayi bidaba gidiko, kahiney iya dumma keethan laapun gallas gordidi wotho. <verse eid="LEV 13:26" /><verse number="27" style="v" sid="LEV 13:27" />Laapuntha gallas kahiney iya be7iya wode he bessay dalgi dalgi biiko, hessi goga harge gidiya gisho I tuna gideysa kahiney eriso. <verse eid="LEV 13:27" /><verse number="28" style="v" sid="LEV 13:28" />Shin he madunthay gogaa bolla dalgonna aggidi issi bessan uttikonne dhayi dhayi biiko, hessi tamay mida bessan attida beeta gidiya gisho, I tuna gidonaysa kahiney eriso.<verse eid="LEV 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29" />“Issi addey woyko maccasa huuphen woyko gaco bolla madunthi keyiko, <verse eid="LEV 13:29" /><verse number="30" style="v" sid="LEV 13:30" />kahiney he madunthaa be7iya wode madunthay gogaa kanthidi ollatiko iya bolla de7iya ikisey lee7idi galal7o daaniko, hessi huuphen woyko gaco bolla keyiya qaachiya goga harge gidiya gisho, he uray tuna gideysa kahiney eriso. <verse eid="LEV 13:30" /><verse number="31" style="v" sid="LEV 13:31" />Qassi kahiney he hargiya be7iya wode gogaa kanthidi ollatiboonaba gidiko, kareetha ikisey iya bolla dhayiko, he qaachiya hargey de7iya uraa kahiney dumma keethan laapun gallas gordidi wotho. <verse eid="LEV 13:31" /><verse number="32" style="v" sid="LEV 13:32" />Laapuntha gallas kahiney he hargiya be7iya wode qaachiya hargey dalgonnaba gidiko, iya bolla galal7o daaniya ikisey baynaba gidikonne gogaa kanthidi ollatiboonaba gidiko, <verse eid="LEV 13:32" /><verse number="33" style="v" sid="LEV 13:33" />he ura qaachiya bessan de7iya ikisiya gidonashin, madunthaa yuushon de7iya ikisiya meedo. Kahiney he uraa dumma keethan hara laapun gallas gordidi wotho. <verse eid="LEV 13:33" /><verse number="34" style="v" sid="LEV 13:34" />Laapuntha gallas kahiney he qaachiya bessaa be7iya wode uraa galbaa bolla dalgonna ixikonne gogaa kanthidi ollatonna ixiko, he uray tuna gidonaysa kahiney eriso. Uray ba ma7uwa meeccidi geeshshi gidana. <verse eid="LEV 13:34" /><verse number="35" style="v" sid="LEV 13:35" />Shin I geeydaape guye, qaachiya hargey he uraa galba bolla dalgi dalgi biiko, <verse eid="LEV 13:35" /><verse number="36" style="v" sid="LEV 13:36" />kahiney iya be7iya wode he qaachiya hargey dalgidaba gidiko, he uray tunida gisho kahiney galal7o daaniya ikisiya koyopo. <verse eid="LEV 13:36" /><verse number="37" style="v" sid="LEV 13:37" />Shin kahiney be7iya wode he qaachiya bessay dalgonnaba gidikonne kareetha ikisey iya bolla dolidaba gidiko, he qaachiya bessay paxis. He uray tuna gidonna gisho, I geeshshi gideysa kahiney eriso.<verse eid="LEV 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38" />“Issi adde woyko maccasa goga bolla bootha iralley keyiko, <verse eid="LEV 13:38" /><verse number="39" style="v" sid="LEV 13:39" />kahiney be7iya wode enta gogaa bolla de7iya iralley bulla gidiko, hessi gogaa bolla coo keydaba gidiya gisho he uray tuna gidenna.<verse eid="LEV 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 13:40" />“Issi asas huuphe binaanay qoqofetiko, bo77a gideesipe attishin, I tuna gidenna. <verse eid="LEV 13:40" /><verse number="41" style="v" sid="LEV 13:41" />Issi asi sinthara bo77atiko, iya tiishshi misipe attishin, I tuna gidenna. <verse eid="LEV 13:41" /><verse number="42" style="v" sid="LEV 13:42" />Shin iya bo77i woyko tiishshi midaysa bolla zo7o woyko bootha madunthi keyiko, hessi iya bo77an woyko iya tiishsha bolla keyida goga harge. <verse eid="LEV 13:42" /><verse number="43" style="v" sid="LEV 13:43" />Iya kahiney be7iya wode iya bo77i woyko tiishshi midaysa bolla de7iya madunthay galba bolla keyiya goga harge mela zo7o gidiko, <verse eid="LEV 13:43" /><verse number="44" style="v" sid="LEV 13:44" />he uray tuma goga hargen oyketida hargancho. I tuna gidiya gishonne iya hargey iya huuphen de7iya gisho I tuna gideysa kahiney eriso.<verse eid="LEV 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LEV 13:45" />“Goga hargey oykida asi peedhetida ma7o ma7o; ba huuphiya pixopo; ba doona kammo; ba qaala dhoqu oothidi, ‘Taani tuna, taani tuna!’ yaago. <verse eid="LEV 13:45" /><verse number="46" style="v" sid="LEV 13:46" />He hargey iya bolla de7ida wode ubban I tuna. I tuna gidiya gisho, asaape shaaketidi, gutaape karen barka de7o.<verse eid="LEV 13:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 13:47" />“Ay ma7o bolla buuqida bessi bentiko, he ma7oy suufe gidin woyko liino gidin, <verse eid="LEV 13:47" /><verse number="48" style="v" sid="LEV 13:48" />qacinape woyko shalope dadetida liino woyko suufe gidin, galba woyko galbafe oosetida ma7o gidin, <verse eid="LEV 13:48" /><verse number="49" style="v" sid="LEV 13:49" />he ma7uwa bolla bentida buuqay ciliilo woyko zo7o mala bessiko, I qacinape woyko shalope dadetidaba gidin, galba woyko galbafe oosetidaba gidin, hessi asape ase oykiya harge gidiya gisho, hessa kahiney bessanaw koshshees. <verse eid="LEV 13:49" /><verse number="50" style="v" sid="LEV 13:50" />Kahiney he buuqa be7idi, he buuqida ma7uwa dumma keethan laapun gallas gordidi wotho. <verse eid="LEV 13:50" /><verse number="51" style="v" sid="LEV 13:51" />Laapuntha gallas kahiney he ma7uwa be7iya wode he ma7uwa bolla de7iya buuqay dalgi dalgi biiko, I qacina woyko shalo gidin, galba woyko galbafe oosetida ma7o gidin, hessi issuwafe issuwa oykiya buuqa harge gidiya gisho he ma7oy tuna. <verse eid="LEV 13:51" /><verse number="52" style="v" sid="LEV 13:52" />He ma7oy qacina woyko shalo gidin, liino woyko suufe gidin, galbafe oosetidaba ayba gidin, kahiney iya xuuggo. Hessi issuwafe issuwa oykiya buuqa harge gidiya gisho, I xuugetanaw bessees.<verse eid="LEV 13:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LEV 13:53" />“Shin kahiney be7iya wode he buuqa ma7uwa bolla dalgiboonaba gidiko, I qacina woyko shalo woyko galbafe oosetidaba ayba gidin, <verse eid="LEV 13:53" /><verse number="54" style="v" sid="LEV 13:54" />he buuqay de7iya ma7uwa meeccana mela kahiney kiitto. Hessafe guye, he ma7uwa dumma keethan hara laapun gallas gordidi wotho. <verse eid="LEV 13:54" /><verse number="55" style="v" sid="LEV 13:55" />He ma7oy meecetidaape guye qassika kahiney be7iya wode he buuqay ba malaa laammonnabaa gidikonne dalgi dalgi boonna ixikoka I tuna. He buuqa bessay ma7uwas guye baggara woyko sintha baggara de7ikoka he ma7oy taman xuugetanaw koshshees. <verse eid="LEV 13:55" /><verse number="56" style="v" sid="LEV 13:56" />Shin he ma7uwa meecci simmin kahiney be7iya wode buuqay dhayi dhayi biiko, I galba gidin, qacina woyko shalo gidin, he buuqay de7iya bessaa kahiney daakidi kesso. <verse eid="LEV 13:56" /><verse number="57" style="v" sid="LEV 13:57" />Hessafe guye, ma7uwa bolla simmidi keyiko, he ma7oy qacina woyko shalo gidin, galbafe oosetidaba gidin, hessi dalgi dalgi biiko he buuqay de7iya ma7oy taman xuugetanaw bessees. <verse eid="LEV 13:57" /><verse number="58" style="v" sid="LEV 13:58" />Shin meecetida ma7oy qacina woyko shalo gidin, woyko galbafe oosetidaba ma7o gidin, buuqa malay dhayiko, he ma7oy nam7antho meeceto; Hessafe guye, I geeyees” yaagis.<verse eid="LEV 13:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LEV 13:59" />Issi ma7oy suufe woyko liino gidin, qacina woyko shalo gidin, woyko galbafe oosetidaba gidin, he ma7uwa geeshshi woyko tuna yaagisanaw danda7iya wogay haysa.<verse eid="LEV 13:59" /></para>
  <chapter eid="LEV 13" />
  <chapter number="14" style="c" sid="LEV 14" />
  <para style="s1">Goga Hargefe Geesho Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1" />Goday Museko haysada yaagis; <verse eid="LEV 14:1" /><verse number="2" style="v" sid="LEV 14:2" />Goga hargey oykida uray geeyiya gallas oothanaw koshshiya wogay haysa. He uraa kahiniyako ehanaw koshshees. <verse eid="LEV 14:2" /><verse number="3" style="v" sid="LEV 14:3" />Kahiney gutaape gaxaa keyidi iya hargiya be7o. I be7iya wode goga hargey uraa asatethafe dhayidabaa gidiko, <verse eid="LEV 14:3" /><verse number="4" style="v" sid="LEV 14:4" />kahiney nam7u tuna gidonna kafota, ziga mitha qanxo, zo7o qacinanne hisoophe bonco he hargiyafe geeyiya uraa gisho ehana mela kiitto. <verse eid="LEV 14:4" /><verse number="5" style="v" sid="LEV 14:5" />Hessafe guye, kahiney nam7u kafotape issuwa pultofe duuqidi keren qolida haatha bolla shukana mela kiitto. <verse eid="LEV 14:5" /><verse number="6" style="v" sid="LEV 14:6" />Hanko kafuwa zo7o qacinaranne hisoophe boncora ekidi, keren de7iya pulto haatha bolla shukida kafuwa suuthan naaqo. <verse eid="LEV 14:6" /><verse number="7" style="v" sid="LEV 14:7" />He suuthaa, he goga hargiyafe geeyiya uraa bolla laapun toho wurxo; he uray tuna gidonaysa eriso; paxa de7iya kafuwa demba yeddo.<verse eid="LEV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 14:8" />He hargiyafe geeyiya uray ba ma7uwa meecco; ba asatethaa bolla de7iya ikise ubbaa meedeto; ba asatethaa meeceto. Hessafe guye, I geeyidi guta gelo, shin ba dunkaaniya giddo gelonna laapun gallas karen gam7o. <verse eid="LEV 14:8" /><verse number="9" style="v" sid="LEV 14:9" />Laapuntha gallas ba huuphiya, buuchaa, deemuwanne ba asatethaa bolla de7iya hara ikise ubbaa meedeto; qassi ba ma7uwa meecco; ba asatethaka meeceto; Hessafe guye, I geeshshi gidana.<verse eid="LEV 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 14:10" />Hospuntha gallasan borey bayna nam7u urge dorsatanne issi laythi gidida issi macca dorse eho. Qassi katha yarshos zaytera munuqetida heedzu kilo giraame lo77o dhiillenne issi litiro zaytepe siko eho. <verse eid="LEV 14:10" /><verse number="11" style="v" sid="LEV 14:11" />Iya geeshshiya kahiney uraanne I ehida yarshotara issife Geeshsha Dunkaaniya pengen Godaa sinthan shiisho.<verse eid="LEV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 14:12" />Kahiney nam7u dorsa urgetape issuwa ekidi, issi litiros siko zaytera issife naaqo yarsho oothidi shiisho; he shiiqida yarshuwa yuusho yarsho oothidi Godaa sinthan shiisho. <verse eid="LEV 14:12" /><verse number="13" style="v" sid="LEV 14:13" />Yaatidi, I he dorsa urgiya nagara yarshonne xuussa yarsho shukiya geeshsha bessan shuko. Nagara yarshuwa mela naaqo yarshoyka kahiniyas imetees; ika ubbaafe aadhida geeshshi. <verse eid="LEV 14:13" /><verse number="14" style="v" sid="LEV 14:14" />Kahiney naaqo yarshuwa suuthaafe guuthi ekidi, he geeyiya uraas ushacha bagga haythaa, ushacha kushiya wogga biradhiyanne ushacha tohuwa wogga biradhiya tiyo. <verse eid="LEV 14:14" /><verse number="15" style="v" sid="LEV 14:15" />Hessafe guye, kahiney zaytiyape guuthara ekidi, ba haddirsa kushiya qaaqan tigo.<verse eid="LEV 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 14:16" />He haddirsa kushiya qaaqan de7iya zaytiya ba ushacha kushe biradhiya yeddi yeddi ekidi, Godaa sinthan laapun toho wurxo. <verse eid="LEV 14:16" /><verse number="17" style="v" sid="LEV 14:17" />Yaatidi, ba kushiya qaaqan de7iya zaytiyape ekidi, geeyiya uraas ushacha haytha, ushacha kushiya wogga biradhiyanne ushacha tohuwa wogga biradhiya kase naaqo yarshuwa suuthaa tiyida bessan tiyo. <verse eid="LEV 14:17" /><verse number="18" style="v" sid="LEV 14:18" />Qassi ba kushiya qaaqan attida zaytiya kahiney geeyiya uraa huuphen gusso; yaatidi Godaa sinthan he uraa nagaraa atto yaagiso.<verse eid="LEV 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 14:19" />Hessafe guye kahiney geeyiya uraa nagara atotethas shiiqida yarshuwa yarshees; kallidi qassi xuussa yarshos shiiqida mehiya shukees. <verse eid="LEV 14:19" /><verse number="20" style="v" sid="LEV 14:20" />Kahiney xuussa yarshuwa katha yarshuwara issife yarsho bessan wothidi xuuggees; yaatidi uraa nagaraa atto yaagisees; he uray geeyees.<verse eid="LEV 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21" />Shin uray hessa ubbaa ehanaw danda7onna manqo gidiko, Godaa sinthan iya nagaraa atotethas yuushshanaw naaqo yarshos issi dorsa urge eho. Katha yarshos zaytera munuqetida issi kilo giraame lo77o dhiillenne issi litiro zaytepe sikuwa eho. <verse eid="LEV 14:21" /><verse number="22" style="v" sid="LEV 14:22" />Baw danda7etida mela nam7u holle woyko nam7u kuraacho issuwa nagaraa yarshos, issuwa xuussa yarshos eho.<verse eid="LEV 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 14:23" />Hospuntha gallas ba tunatethaafe geeyiya uray Geeshsha Dunkaaniya pengen Godaa sinthe ehidi kahiniyas immo. <verse eid="LEV 14:23" /><verse number="24" style="v" sid="LEV 14:24" />Kahiney naaqo yarshos yida dorsa urgiyanne zaytiya ekidi, yuusho yarsho oothidi Godaa sinthan yuushsho. <verse eid="LEV 14:24" /><verse number="25" style="v" sid="LEV 14:25" />Naaqo yarshos yida dorsa urgiya shuko; He urgiya suuthaafe guuthara ekidi, ha geeyiya uraa ushacha haytha, ushacha kushiya wogga biradhiyanne ushacha tohuwa wogga biradhiya tiyo. <verse eid="LEV 14:25" /><verse number="26" style="v" sid="LEV 14:26" />Kahiney zaytiyape guuthara ba haddirsa kushiya qaaqan tigo. <verse eid="LEV 14:26" /><verse number="27" style="v" sid="LEV 14:27" />Haddirsa kushiya qaaqan de7iya zaytiyape ushacha kushiya biradhiya yeddi ekidi, Godaa sinthan laapun toho wurxo. <verse eid="LEV 14:27" /><verse number="28" style="v" sid="LEV 14:28" />Kahiney ba kushiya qaaqan de7iya zaytiyape guuthara ekidi, geeyiya uraas ushacha haytha, ushacha kushiya wogga biradhiyanne ushacha tohuwa wogga biradhiya kase naaqo yarsho suuthaa tiyida bessan tiyo. <verse eid="LEV 14:28" /><verse number="29" style="v" sid="LEV 14:29" />Godaa sinthan uraa nagaraa atotethas kahiney ba kushen attida zaytiya geeyiya uraa huuphen tigo. <verse eid="LEV 14:29" /><verse number="30" style="v" sid="LEV 14:30" />Hessafe guye, geeyiya uray baw danda7etidaysa mela holle woyko kuraacho eho. <verse eid="LEV 14:30" /><verse number="31" style="v" sid="LEV 14:31" />Issuwa nagara yarshos nam7anthuwa xuussa yarshos katha yarshuwara issife shiisho. Kahiney geeyiya uraa nagaraa Godaa sinthan iya nagaraa atto yaagiso. <verse eid="LEV 14:31" /><verse number="32" style="v" sid="LEV 14:32" />Ba asatethaa bolla de7iya goga hargiyafe geeyanaw manqotethi diggida uraas de7iya wogay haysa.<verse eid="LEV 14:32" /></para>
  <para style="s1">Keetha Bolla Keyiya Buuqa</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33" />Goday Musekonne Aaronako haysada yaagis; <verse eid="LEV 14:33" /><verse number="34" style="v" sid="LEV 14:34" />“Taani hintew immiya Kanaane biitta hinte geliya wode he biittan de7iya hinte keethafe issuwan taani buuqa yeddiya wode, <verse eid="LEV 14:34" /><verse number="35" style="v" sid="LEV 14:35" />he uray kahiniyako bidi, ‘Ta keetha bolla buuqa daaniyabay de7ees’ yaagidi odo. <verse eid="LEV 14:35" /><verse number="36" style="v" sid="LEV 14:36" />Kahiney soo gelidi buuqa qommuwa be7anaape kasetidi, son de7iyabay ubbay tuna geetetonna mela son de7iyaba ubbaa kare kessana mela kiitto; hessafe guye, kahiney be7anaw soo gelo. <verse eid="LEV 14:36" /><verse number="37" style="v" sid="LEV 14:37" />I gelidi be7iya wode buuqay godaa bolla ciliilo woyko zo7o malla bessikonne qassi godaa midi ollayidi giddo geliko, <verse eid="LEV 14:37" /><verse number="38" style="v" sid="LEV 14:38" />kahiney kare keyidi, keethaa laapun gallas gakanaw gordo. <verse eid="LEV 14:38" /><verse number="39" style="v" sid="LEV 14:39" />Laapuntha gallasan kahiney he keethaa zaaridi xeelliya wode he buuqay keetha godaa bolla dalgiko, <verse eid="LEV 14:39" /><verse number="40" style="v" sid="LEV 14:40" />buuqay de7iya shucha ubbaa godaape shoddidi, katamaape gaxa kessidi tuna bessan yeggana mela kiitto. <verse eid="LEV 14:40" /><verse number="41" style="v" sid="LEV 14:41" />Kaallidi godaa meeshida urqa soo baggara bookidi, yuushshi aathidi qoqofana mela ootho; yaatidi he urqa katamaape gaxan de7iya tuna bessan yeggo. <verse eid="LEV 14:41" /><verse number="42" style="v" sid="LEV 14:42" />Hessafe guye, he shodetida shuchata bessan hara shuchata wotho; hara urqan keethaa meesho.<verse eid="LEV 14:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43" />“Shuchay shodetin, urqay qoqofetin, hara urqa meeshi simmin, buuqay keethaa giddon zaari bentiko, <verse eid="LEV 14:43" /><verse number="44" style="v" sid="LEV 14:44" />kahiney hessa be7o. I be7iya wode buuqay he keethaa giddon dalgiko, hessi asape ase oykiya buuqa harge gidiya gisho he kathay tuna. <verse eid="LEV 14:44" /><verse number="45" style="v" sid="LEV 14:45" />Hessa gisho, he keethaa, iya shuchaa, iya mithaanne I meeshetida urqa ubbaa laallidi katamaape gaxa efidi, tuna bessan yeggo. <verse eid="LEV 14:45" /><verse number="46" style="v" sid="LEV 14:46" />He keethay gordan gam7iya wode iya gido geliya oonika omarsi gakanaw tuna. <verse eid="LEV 14:46" /><verse number="47" style="v" sid="LEV 14:47" />He keethan aqiya woyko kathi miya uray ba ma7uwa meecco.<verse eid="LEV 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48" />“Shin kahiney yidi xeelliya wode keethay meeshetidi simmin, zaaridi dalgonna ixiko, buuqay dhayida gisho, he keethay tuna gidonaysa kahiney eriso. <verse eid="LEV 14:48" /><verse number="49" style="v" sid="LEV 14:49" />Keethaa geeshshanaw nam7u kafota, ziga mitha qanxo, zo7o qacinanne hisoophe bonco eho. <verse eid="LEV 14:49" /><verse number="50" style="v" sid="LEV 14:50" />Kafotape issuwa pultofe duuqidi keren qolida haathan shuko. <verse eid="LEV 14:50" /><verse number="51" style="v" sid="LEV 14:51" />Hessafe guye, zigaa, hisoophe boncuwa, zo7o qacinanne paxa de7iya kafuwa ekidi, keren de7iya shuketida kafuwa suuthaninne pulto haathan yeddi ekidi laapun toho he keethaa wurxo. <verse eid="LEV 14:51" /><verse number="52" style="v" sid="LEV 14:52" />Yaatidi, kahiney he keethaa kafuwa suuthan, pulto haathan, paxa de7iya kafuwan, ziga mithan, hisoophe boncuwaninne zo7o qacinan geeshsho. <verse eid="LEV 14:52" /><verse number="53" style="v" sid="LEV 14:53" />Paxa de7iya kafuwa katamaape gaxa yeddo. Hessada oothidi, keethaa geeshshiya wogaa polees; keethay geeshshi gidees.<verse eid="LEV 14:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 14:54" />“Dumma dumma goga hargeesinne goo7o hargees imetida wogay haysa. <verse eid="LEV 14:54" /><verse number="55" style="v" sid="LEV 14:55" />Ma7o bolla woyko keetha bolla keyiya buuqa harge gidin, <verse eid="LEV 14:55" /><verse number="56" style="v" sid="LEV 14:56" />kixa gidin, merko gidin, iralle gidin, <verse eid="LEV 14:56" /><verse number="57" style="v" sid="LEV 14:57" />issibay tuna gideysanne tuna gidonnaysa erisiya wogay haysa.”<verse eid="LEV 14:57" /></para>
  <chapter eid="LEV 14" />
  <chapter number="15" style="c" sid="LEV 15" />
  <para style="s1">Asatethafe Goggidi Tunisiyabata</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1" />Goday Musekonne Aaronako haysada yaagis; <verse eid="LEV 15:1" /><verse number="2" style="v" sid="LEV 15:2" />Isra7eele asaas haysada yaagidi odite; “Issi asa asatethafe goggiyabay de7iko hessi tuna. <verse eid="LEV 15:2" /><verse number="3" style="v" sid="LEV 15:3" />Goggiyabay de7iya uraa tuna oothiya wogay haysa; he goggiyabay aggin, aggonna ixin, he uraa tuna oothees.<verse eid="LEV 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 15:4" />“Iya asatethafe goggiyabay de7iya uray zin7iya hiixaynne uttiya oyde ubbay tuna. <verse eid="LEV 15:4" /><verse number="5" style="v" sid="LEV 15:5" />Iya hiixa bochiya oonika ba ma7uwa meecco; ba asatethaka meeceto; yaatidi omarsi gakanaw tuna gidees. <verse eid="LEV 15:5" /><verse number="6" style="v" sid="LEV 15:6" />Goggiyabay de7iya uray uttidaba bolla uttiya oonika ba ma7uwa meecco; ba asatethaka meeceto; yaatidi omarsi gakanaw tuna gidees.<verse eid="LEV 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 15:7" />“Goggiyabay de7iya uraa asatethaa bochiya oonika ba ma7uwa meecco; ba asatethaa meeceto; yaatidi omarsi gakanaw I tuna gidees.<verse eid="LEV 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 15:8" />“Goggiyabay de7iya asi tuna gidonna asa bolla cutiko, he uray ba ma7uwa meecco; ba asatethaka meeceto; yaatidi omarsi gakanaw I tuna gidees.<verse eid="LEV 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 15:9" />“Goggiyabay de7iya uray uttiya toga koori tuna. <verse eid="LEV 15:9" /><verse number="10" style="v" sid="LEV 15:10" />Iyape garsara de7iyaba bochiya oonika omarsi gakanaw tuna gidees; qassi hessa tookiya oonika ba ma7uwa meecco; ba asatetha meeceto; yaatidi omarsi gakanaw I tuna gidees.<verse eid="LEV 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 15:11" />“Goggiyabay de7iya asi ba kushiya meecetonna bochiya asi oonika ba ma7uwa meecco; ba asatethaa meeceto; yaatidi omarsi gakanaw tuna gidees.<verse eid="LEV 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 15:12" />“Goggiyabay de7iya uray bochiya oto ubbaa menthite; mithafe oosetida miishe ubbay haathan meeceto.<verse eid="LEV 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13" />“Goggiyabay de7iya asi he gogiyabape geeyida wodepe laapun gallas gam7o. Ba ma7uwa meecco; ba asatethaa pulto haathan meeceto; yaatidi I geeshshi gidees. <verse eid="LEV 15:13" /><verse number="14" style="v" sid="LEV 15:14" />Hospuntha gallasan nam7u holleta woyko nam7u kuraachota ekidi, Geeshsha Dunkaaniya penge, Godaa sinthe ehidi kahiniyas immo. <verse eid="LEV 15:14" /><verse number="15" style="v" sid="LEV 15:15" />Kahiney holletape issuwa nagara yarshos, issuwa qassi xuussa yarshos yarshees; yaatidi kahiney uraa asatethafe goggiyaba gisho Godaa sinthan iya nagaraa atto yaagisees.<verse eid="LEV 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16" />“Issi addefe iya atunthay gukiko, ba kumetha asatethaka meeceto; yaatidi omarsi gakanaw I tuna gidees. <verse eid="LEV 15:16" /><verse number="17" style="v" sid="LEV 15:17" />Atunthay bochida ma7o ubbay woyko galba ubbay haathan meeceto; yaatidi omarsi gakanaw tuna gidees. <verse eid="LEV 15:17" /><verse number="18" style="v" sid="LEV 15:18" />Issi addey maccara aqin, iya atunthay gukiko, nam7ayka haathan meeceto; yaatidi omarsi gakanaw enti tuna gidoosona.<verse eid="LEV 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19" />“Issi maccasi ba kushe meto be7iko, laapun gallas gakanaw iya tuna; iyo bochiya oonika omarsi gakanaw tuna.<verse eid="LEV 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 15:20" />“Ba kushe meto wode iya zin7iya hiixaynne iya uttiya oydey ubbay tuna. <verse eid="LEV 15:20" /><verse number="21" style="v" sid="LEV 15:21" />Iya zin7iya hiixa bochiya ubbay ba ma7uwa meecco; ba asatethaka meeceto; yaatidi omarsi gakanaw tuna gido. <verse eid="LEV 15:21" /><verse number="22" style="v" sid="LEV 15:22" />Iya uttiyaba bochiya ubbay ba ma7uwa meecco; ba asatethaa meeceto; yaatidi omarsi gakanaw tuna gido. <verse eid="LEV 15:22" /><verse number="23" style="v" sid="LEV 15:23" />Iya zin7iya hiixa gidin woyko iya uttiyaba bochiya oonika omarsi gakanaw tuna.<verse eid="LEV 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 15:24" />“Issi maccasi kushe metora de7iya wode addey iira aqiko, he kushe metuwa I bochiko, laapun gallas gakanaw I tuna gidees; I zin7iya hiixa ubbay tuna gidees.<verse eid="LEV 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 15:25" />“Issi maccasi, ba kushe meto wodey aadhin, suuthi aggonna goggiko woyko kushe meto wodey ba qammafe aadhidi goggiko, kushe meto wode iya tuna gididaysada suuthay eqana gakanaw iya tuna gidawusu. <verse eid="LEV 15:25" /><verse number="26" style="v" sid="LEV 15:26" />Suuthi iipe goggiya wode iya zin7iya hiixa ubbay, ba kushe meto be7iya wode iya zin7ida hiixa melanne iya uttiya oydiya mela tuna gidees. <verse eid="LEV 15:26" /><verse number="27" style="v" sid="LEV 15:27" />He tunidabata bochiya oonika tuna gidiya gisho I ba ma7uwa meecco; ba asatethaa meeceto; yaatidi omarsi gakanaw tuna gidees.<verse eid="LEV 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 15:28" />“Iipe goggiya suuthay eqiko, iya he wodepe doomada laapun gallas gam7o; hessafe guye, iya geeshshi gidana. <verse eid="LEV 15:28" /><verse number="29" style="v" sid="LEV 15:29" />Hospuntha gallas iya nam7u holleta woyko nam7u kuraachota ehada Geeshsha Dunkaaniya pengen kahiniyas immo. <verse eid="LEV 15:29" /><verse number="30" style="v" sid="LEV 15:30" />Kahiney holletape issuwa nagaraa yarshos, issuwa xuussa yarshos yarsho. Yaatidi, kahiney iipe goggiya tunatethaa gisho Godaa sinthan I nagaraa atto yaagisees.<verse eid="LEV 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31" />“Isra7eele asay banta giddon de7iya Geeshsha Dunkaaniya tunisidi, hayqonna mela neeni haysada oothada enti bantana tunisiyabape dummayidi daana mela naaga.”<verse eid="LEV 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 15:32" />Iya asatethafe goggiyabay de7iya asas, iya atunathay gukin tuniya addes, <verse eid="LEV 15:32" /><verse number="33" style="v" sid="LEV 15:33" />ba kushe meto gaason tuniya maccasas, adde gidin macca gidin goggiyabay de7iya asaasinne tunida maccara aqiya addes imetida wogay haysa.<verse eid="LEV 15:33" /></para>
  <chapter eid="LEV 15" />
  <chapter number="16" style="c" sid="LEV 16" />
  <para style="s1">Nagara Atotetha Gallasaa</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1" />Aarona adde nayti nam7ay Godaa sinthe shiiqidi hayqidaape guye, Goday Museko haysada yaagis: <verse eid="LEV 16:1" /><verse number="2" style="v" sid="LEV 16:2" />Taani Taabotiya nagara atotetha kamaa bolla shaaran gidada qonciya gisho magarajuwafe guyen de7iya Ubbaafe Geeshsha Bessaa ba koyida wode gelidi hayqonna mela ne ishaa Aaronas oda. <verse eid="LEV 16:2" /><verse number="3" style="v" sid="LEV 16:3" />Aaroni nagaraa yarshos issi wofaano, xuussa yarshos issi maraze ekidi Ubbaafe Geeshsha Bessaa gelo. <verse eid="LEV 16:3" /><verse number="4" style="v" sid="LEV 16:4" />Aaroni liinope oosetida geeshsha adussa qamisenne garsara ma7etiya ma7o ma7o. Liinope oosetida danco danco; hessada ba huuphen liinope oosetida xaatha qace wotho. He ma7oti geeshshi gidiya gisho, ma7anape sinthe ba asatethaa meeceto.<verse eid="LEV 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 16:5" />Isra7eele maabaray nagara yarshos nam7u koleta, xuussa yarshos issi maraze Aaronas eho. <verse eid="LEV 16:5" /><verse number="6" style="v" sid="LEV 16:6" />Aaroni ba nagarasinne ba soo asaa nagaraa atotethas issi wofaano yarsho. <verse eid="LEV 16:6" /><verse number="7" style="v" sid="LEV 16:7" />Hessafe guye, nam7u koleta Geeshsha Dunkaaniya pengen Godaa sinthe eho. <verse eid="LEV 16:7" /><verse number="8" style="v" sid="LEV 16:8" />He nam7u deeshata ekidi issuwa Godaasa, issuwa qassi Azaazelasa<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="fqa" closed="false">Azaazelasa: </char><char style="ft" closed="false">Ibraawetho doonan mela biitta yedeteysa guussu.</char></note> gidi enta bolla saama yeggo. <verse eid="LEV 16:8" /><verse number="9" style="v" sid="LEV 16:9" />Aaroni saaman Godaas gidida deesha ekidi nagara yarsho oothidi yarsho. <verse eid="LEV 16:9" /><verse number="10" style="v" sid="LEV 16:10" />Shin saaman Azaazelas gidida deesha asa nagaraa atotethas mela biitta yeddanaw paxa de7ishin Godaas shiisho.<verse eid="LEV 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 16:11" />Aaroni ba nagarasinne ba soo asaa nagaraa atotethas issi wofaano nagaraa yarsho oothidi shiisho. Yaatidi ba nagaraa gisho he wofaanuwa shuko. <verse eid="LEV 16:11" /><verse number="12" style="v" sid="LEV 16:12" />Godaa sinthan de7iya yarsho bessaafe ixaane cuyisiya miishen bonqo kunthidi, liiqidi gaacetida sawiya ixaane nam7u kuuca ekidi magarajuwa giddo gelo. <verse eid="LEV 16:12" /><verse number="13" style="v" sid="LEV 16:13" />Godaa sinthan de7iya taman ixaane wotho. I hayqonna mela ixaaniya cuyay Taabotiya bolla de7iya nagara atotetha kamaa kammo. <verse eid="LEV 16:13" /><verse number="14" style="v" sid="LEV 16:14" />Wofaanuwa suuthaafe guuthara ekidi, ba biradhiya yeddi ekidi atotetha kamaa sintha baggaa wurxo. Nagara atotetha kamaa sintha baggara de7iya bessaa laapun toho wurxo.<verse eid="LEV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 16:15" />Hessafe guye, asaa nagaraa gisho gidiya deesha shukidi, iya suuthaa magarajuwa giddo ehidi, wofaanuwa suutha wurxidaysada nagara atotetha kamaanne Taabotiya sinthaa wurxo. <verse eid="LEV 16:15" /><verse number="16" style="v" sid="LEV 16:16" />Ubbaafe Geeshsha Bessaa Isra7eele asaa tunatethafenne nagarape geeshshees. Enti tunabaa oothishin, enta giddon de7iya Geeshsha Dunkaaniya haysada oothidi geeshsho. <verse eid="LEV 16:16" /><verse number="17" style="v" sid="LEV 16:17" />Aaroni Ubbaafe Geeshsha Bessaa gelidi, ba nagaraa, ba soo asaa nagaraanne kumetha Isra7eele asaa nagaraa atotethas yarshidi keyana gakanaw, oonika geeshsha Dunkaaniya giddon de7opo.<verse eid="LEV 16:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 16:18" />Hessafe guye, Godaa sinthan de7iya yarsho bessa keyidi iya geeshsho. Wofaanuwa suuthaafenne deesha suuthaafe guuthara ekidi, yarsho bessa yuushuwan de7iya kaceta tiyo. <verse eid="LEV 16:18" /><verse number="19" style="v" sid="LEV 16:19" />He suuthan ba biradhiya yeddi ekidi laapun toho wurxo; hessada oothidi Isra7eele asaa tunatethaafe he yarsho bessa geeshsho.<verse eid="LEV 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20" />Aaroni Ubbaafe Geeshsha bessaa, geeshsha Dunkaaniyanne yarsho bessa geeshshiya wogaa polidaape guye, paxa de7iya deesha shiisho. <verse eid="LEV 16:20" /><verse number="21" style="v" sid="LEV 16:21" />Aaroni ba nam7u kushiya paxa de7iya deesha huuphen wothidi, Isra7eele asaa naaqo ubbaa, enta makalla ubbaa, enta nagara ubbaa paaxo. Yaatidi he deesha huuphen hessa toosso; he deesha efana mela giigisida uraa bolla mela biitta yeddo. <verse eid="LEV 16:21" /><verse number="22" style="v" sid="LEV 16:22" />Deeshay enta nagara ubbaa tookidi, asi bayna bessi mela biitta bo.<verse eid="LEV 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23" />Hessafe guye, Aaroni Geeshsha Dunkaaniya bidi Ubbaafe Geeshsha bessaa gelo. Liinope oosetida kase I ma7idi gelida ma7uwa qaaridi yan wotho. <verse eid="LEV 16:23" /><verse number="24" style="v" sid="LEV 16:24" />Geeshsha bessan ba asatethaa meecetidi, ba kase ma7uwa ma7i keyidi ba nagaraanne asaa nagaraa atotethas xuussa yarsho yarshsho. <verse eid="LEV 16:24" /><verse number="25" style="v" sid="LEV 16:25" />Nagara yarshuwa modhuwa yarsho bessan xuuggo.<verse eid="LEV 16:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 16:26" />Bazzo yedetiya deesha efida uray ba ma7uwa meecco; ba asatethaa meeceto; yaati simmidi guta gelo.<verse eid="LEV 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 16:27" />Nagara atotethas Aaroni enta suuthaa Ubbaafe Geeshsha bessaa ehida wofaanuwanne deesha galbaa, attida ashuwanne tociya gutaape gaxa kessidi xuuggo. <verse eid="LEV 16:27" /><verse number="28" style="v" sid="LEV 16:28" />Hessa xuuggida uray ba ma7uwa meecco; ba asatethaa meeceto; hessafe guye, gutaa gelo.<verse eid="LEV 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29" />Haysi hintew merinaa woga gido; laapuntha ageenay gelida tammantho gallas hintena kawushite; biitta aawu na7a gidin woyko hara biitta asi gidin, ay oosoka oothopite. <verse eid="LEV 16:29" /><verse number="30" style="v" sid="LEV 16:30" />Ayis giiko he gallasay hinte nagara atotethi demmiya gallas; hinte Godaa sinthan hinte nagara ubbaafe geeyana. <verse eid="LEV 16:30" /><verse number="31" style="v" sid="LEV 16:31" />Hessi hintew gita Sambaata shempo gallas gidana. He gallas hintena kawushite; hessi hintew merinaa woga gido. <verse eid="LEV 16:31" /><verse number="32" style="v" sid="LEV 16:32" />Qassi ba aawa bessan kahine gidana mela tiyetiyanne dummatiya kahiney geeshshi gidida liinope oosetida ma7uwa ma7idi, nagaraa atotetha wogaa polo. <verse eid="LEV 16:32" /><verse number="33" style="v" sid="LEV 16:33" />I ubbaafe Geeshsha bessaa, Geshsha Dunkaaniya, yarsho bessa, kahinetanne Isra7eele asa ubbaa geeshsho. <verse eid="LEV 16:33" /><verse number="34" style="v" sid="LEV 16:34" />Isra7eele asa ubbaa nagaraa atotethas laythan laythan issi toho oothanaw haysi hintew merina woga gido. Goday kiitidaysada Musey oothis.<verse eid="LEV 16:34" /></para>
  <chapter eid="LEV 16" />
  <chapter number="17" style="c" sid="LEV 17" />
  <para style="s1">Suuthu Moonna Mela Digetis</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 17:1" />Goday Museko haysada yaagis; <verse eid="LEV 17:1" /><verse number="2" style="v" sid="LEV 17:2" />“Aaronas iya adde naytasinne Isra7eele asa ubbaas haysada yaagada oda; Goday kiittidaysi haysa; <verse eid="LEV 17:2" /><verse number="3" style="v" sid="LEV 17:3" />Isra7eele asaape oonika boori woyko maraze woyko kole gutan woyko gutaape gaxan shukidi, <verse eid="LEV 17:3" /><verse number="4" style="v" sid="LEV 17:4" />Godaas imota oothidi immanaw Geeshsha Dunkaaniya penge Godaa sinthe ehonna ixiko, I he suuthan oyshetees. He uray suuthu gussida gisho ba asaa giddofe kuretto. <verse eid="LEV 17:4" /><verse number="5" style="v" sid="LEV 17:5" />Hessa gisho, Isra7eele asay yarsho mehe coo denban shukeysa aggidi, Godaa sinthan Geeshsha Dunkaaniya pengen de7iya kahiniyako eho. Kahiney hessa ekidi, Godaas issifetetha yarsho oothidi shuko. <verse eid="LEV 17:5" /><verse number="6" style="v" sid="LEV 17:6" />Kahiney Geeshsha Dunkaaniya pengen de7iya yarsho bessa bolla he suuthaa wurxo. Modhdhuwa Godaas sawo tonku giya yarsho oothidi xuuggo. <verse eid="LEV 17:6" /><verse number="7" style="v" sid="LEV 17:7" />Isra7eele asay Godaa aggidi kaallida tuna ayyaanatas zaaridi banta yarshuwa yarshofo. Hessi entawunne yaana yeletethaa ubbaas merinaa woga gido.<verse eid="LEV 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 17:8" />“Entako haysada yaaga; Isra7eele asaape gidin woyko enta giddon de7iya allaga biitta asape gidin, oonika xuussa yarsho woyko hara yarsho shiishiya wode, <verse eid="LEV 17:8" /><verse number="9" style="v" sid="LEV 17:9" />Godaas yarshanaw Geeshsha Dunkaaniya penge ehonna ixiko, he uray ba asaa giddofe kuretto.<verse eid="LEV 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10" />“Isra7eele asaape woyko enta giddon de7iya allaga biitta asaape oonika suuthu miiko, he suuthaa miya uraa bolla ta zoko zaarana; taani he uraa asaa giddofe kurana. <verse eid="LEV 17:10" /><verse number="11" style="v" sid="LEV 17:11" />Ayis giiko asho ma7ida ubbaa de7oy iya suuthaa giddon de7ees; suuthi de7oy iya giddon de7iya gisho nagara atto giisees. Hinte nagara atotethas suuthu yarshana mela hintew immas. <verse eid="LEV 17:11" /><verse number="12" style="v" sid="LEV 17:12" />Taani Isra7eele asaako, hintefe woyko hinte giddon de7iya allaga biitta asaape oonika suuthu moopo yaagiday hessa gishosa.<verse eid="LEV 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 17:13" />“Isra7eele asaape woyko enta giddon de7iya allaga biitta asaape oonika meetetiya do7a woyko kafo shankatidi wodhiko, iya suuthaa sa7an gussidi biitta kammo. <verse eid="LEV 17:13" /><verse number="14" style="v" sid="LEV 17:14" />Ayis giiko asho ma7ida ubbaa de7oy iya suutha giddona. Asho ma7ida medhetethata ubbaa de7oy iya suutha giddon de7iya gisho, suuthu moopite; qassi miya oonika ba asaa giddofe kuretto yaagada Isra7eele asaas odas.<verse eid="LEV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 17:15" />“Isra7eele asaa gidin woyko enta giddon de7iya allaga biitta asaa gidin, oonika bawuta woyko do7i wodhidaba miiko, ba ma7uwa meecco; ba asatethaa meeceto; yaatidi omarsi gakanaw tuna gidees. Hessafe guye, I geeshshi gidana. <verse eid="LEV 17:15" /><verse number="16" style="v" sid="LEV 17:16" />Ba ma7uwa meecconna ixiko, ba asatethaa meecetonna aggiko, I ba nagaraa baw tookees.”<verse eid="LEV 17:16" /></para>
  <chapter eid="LEV 17" />
  <chapter number="18" style="c" sid="LEV 18" />
  <para style="s1">Digetida Macca Adde Gahetethi</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1" />Goday Museko haysada yaagis; <verse eid="LEV 18:1" /><verse number="2" style="v" sid="LEV 18:2" />“Isra7eele asaas haysada yaagada oda; taani Godaa, hinte Xoossaa. <verse eid="LEV 18:2" /><verse number="3" style="v" sid="LEV 18:3" />Hinte kase de7ida Gibxe asay ootheysada oothopite; woyko ha77i taani hintena gelsiya Kanaane biitta asay ootheysada oothopite; enta wogaa kaallopite. <verse eid="LEV 18:3" /><verse number="4" style="v" sid="LEV 18:4" />Hinte ta kiitta oothite; ta wogaa naagite; taani Godaa, hinte Xoossaa. <verse eid="LEV 18:4" /><verse number="5" style="v" sid="LEV 18:5" />Ta kiitaanne ta wogaa naagite, hinte hessa oothiko de7on daana. Taani Godaa.<verse eid="LEV 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6" />“Hintefe oonika ba mata dabbora xaallofo. Taani Godaa.<verse eid="LEV 18:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 18:7" />“Ne aayiw xaallada ne aawa kawushofa. Iya ne aayiw gidiya gisho iyo xaallofa.<verse eid="LEV 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 18:8" />“Ne aawa machiw xaallada ne aawa kawushofa.<verse eid="LEV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 18:9" />“Ne michiw xaallofa; son yeletida woyko karen yeletida ne aawa na7iw woyko ne aaye na7iw xaallofa.<verse eid="LEV 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 18:10" />“Ne na7aa na7iw woyko ne na7e na7iw xaallada ne nena kawushofa.<verse eid="LEV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 18:11" />“Ne micho gidiya gisho ne aawa mache na7iw xaallofa.<verse eid="LEV 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 18:12" />“Ne aawa michiw xaallofa; iya ne aawas mata dabbo.<verse eid="LEV 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 18:13" />“Ne aaye michiw xaallofa; iya ne aayes mata dabbo.<verse eid="LEV 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 18:14" />“Ne aawa ishaa machiw xaallofa; iya ne aawa ishaa machiw. <verse eid="LEV 18:14" /><verse number="15" style="v" sid="LEV 18:15" />Ne na7aa machiw xaallofa; iya ne na7aa machiw.<verse eid="LEV 18:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 18:16" />“Ne ishaa machiw xaallada ne ishaa kawushofa.<verse eid="LEV 18:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 18:17" />“Aayiwunne I na7iw xaallofa; I na7e na7iw woyko I na7aa na7iw xaallofa. Enti iw mata dabbo gidiya gisho, hessi iita tuna.<verse eid="LEV 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 18:18" />“Ne machiya paxa de7ishin, ne mache michiw dawuthofa.<verse eid="LEV 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19" />“Kushe metora de7iya maccasi xaallofa.<verse eid="LEV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 18:20" />“Neeni tunonna mela ne shooruwa machiw xaallofa.<verse eid="LEV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 18:21" />“Ne Xoossaa sunthay cayetonna mela ne naytape issuwa taman xuuggada, Moloka giya eeqas yarsho oothada immofa. Taani Godaa.<verse eid="LEV 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 18:22" />“Xoossa sinthan ixetidaba gidiya gisho maccasara gaheteysada addera gahetofa.<verse eid="LEV 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 18:23" />“Neeni tunonna mela mehera gahetofa; maccasi mehera gahetanaw mehe sinthe aadhofo. Hessi wogan baynaba.<verse eid="LEV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24" />“Taani hinte sinthafe yedethiya kawotethati he oosotan tunida gisho, hinte he oosotan enta mela tunopite. <verse eid="LEV 18:24" /><verse number="25" style="v" sid="LEV 18:25" />Hari attoshin, biittayka tunida gisho, iya nagaraa gisho ta iya seeras. Biittiya banan de7ey asaa cuttasu. <verse eid="LEV 18:25" /><verse number="26" style="v" sid="LEV 18:26" />Shin hinte ta higgiyanne ta kiita naagite. Hintena gidin woyko hinte giddon de7iya allaga biitta asaa gidin oonika hessa mela tuna ooso oothopite.<verse eid="LEV 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 18:27" />“Hintefe kase ha biittan de7ida asay hessa mela tunabaa oothida gisho, biittiya tunasu. <verse eid="LEV 18:27" /><verse number="28" style="v" sid="LEV 18:28" />Hinte ha biitta tunisiko, hintefe kase de7ida kawotethata ha biittiya cuttidaysada hintenaka cuttonna mela naagetite. <verse eid="LEV 18:28" /><verse number="29" style="v" sid="LEV 18:29" />Hessata daaniya tuna oosotape issuwaka oothiya asi de7iko, he uray ba asaa giddofe kuretto. <verse eid="LEV 18:29" /><verse number="30" style="v" sid="LEV 18:30" />Hessa gisho, hintefe kase de7ida asati oothida tuna oosota ubbaa oothidi hinte tunonna mela ta kiitta naagite; taani Godaa, hinte Xoossaa” yaagis.<verse eid="LEV 18:30" /></para>
  <chapter eid="LEV 18" />
  <chapter number="19" style="c" sid="LEV 19" />
  <para style="s1">Dumma Dumma Higgeta</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1" />Goday Museko haysada yaagis. <verse eid="LEV 19:1" /><verse number="2" style="v" sid="LEV 19:2" />Isra7eele asa ubbaas haysada yaagada oda; “Taani, Goday, hinte Xoossay, geeshshi gidiya gisho, hinteka geeshshi gidite.<verse eid="LEV 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 19:3" />“Hintefe issoy issoy ba aawanne ba aayiw boncho; ta Sambaata bonchite. Taani Godaa, hinte Xoossaa.<verse eid="LEV 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 19:4" />“Tana aggidi eeqata goyinnofite; woyko biratape oosetida xoossata hintew oothopite. Taani Godaa, hinte Xoossaa.<verse eid="LEV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5" />“Hinte issifetetha yarsho Godaas yarshiya wode he yarshoy hinte gisho eketana mela besseysada yarshite. <verse eid="LEV 19:5" /><verse number="6" style="v" sid="LEV 19:6" />He yarshoy hinte yarshida gallas woyko wontetha gallas meeteto; heedzantho gallas gakanaw attiday de7iko taman xuugeto. <verse eid="LEV 19:6" /><verse number="7" style="v" sid="LEV 19:7" />Heedzantho gallas meetetiko, hessi tunisiyaba; taani hessa ekike. <verse eid="LEV 19:7" /><verse number="8" style="v" sid="LEV 19:8" />Hessa miya oonika Godaas geeshshi gididaba tunisida gisho ba nagaran oyshetana. He uray ba asaa giddofe kuretto.<verse eid="LEV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9" />“Hinte gaden kaxida kathaa hinte cakiya wode gadiya gaxaa gakanaw de7eysa cakofite; caki simmin de7iya poshiliya qoropite. <verse eid="LEV 19:9" /><verse number="10" style="v" sid="LEV 19:10" />Ne woyne ayfiya maxiya wode mithaa bolla qosetidi attidaysa woyko sa7an wodhida woyne ayfiya maxopa. Hessa manqotasinne bete asaas aggaaga. Taani Godaa, hinte Xoossaa.<verse eid="LEV 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11" />“Kaysotopite.</para>
  <para style="p" vid="LEV 19:11">“Wordotopite.</para>
  <para style="p" vid="LEV 19:11">“Issoy issuwa cimmofite.<verse eid="LEV 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 19:12" />“Ta sunthan wordo caaqofite; hinte Xoossaa sunthaa tunisopite. Taani hinte Godaa.<verse eid="LEV 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13" />“Ne shooruwa bolla gene oothofa; woyko iya bonqofa.</para>
  <para style="p" vid="LEV 19:13">“Une oothiya uraa damooziya diggada, issi qammaka ne matan aysopa.<verse eid="LEV 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 19:14" />“Tulliya cayopa; woyko qooqiya sinthan dhube wothofa, shin neeni Xoossas yayya. Taani ne Godaa.<verse eid="LEV 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15" />“Pirda geellayopite; manquwa iya manqotetha gisho maaddada pirdofa; duriya iya duretetha gisho yayyada aggofa. Shin ne shooruwas suure pirda.<verse eid="LEV 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 19:16" />“Ne asaa giddon iita zigirsi ekada yuuyopa.</para>
  <para style="p" vid="LEV 19:16">“Ne shooruwa hayqos gathiyaba aykoka oothofa. Taani ne Godaa.<verse eid="LEV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 19:17" />“Ne ishaa ne wozanan ixofa. Ne shooruwa gaason ne nagara oothonna mela iya hanqa.<verse eid="LEV 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 19:18" />“Halo keyopa; ne asaape issuwa bollaka shifopa. Shin ne shooruwa ne huupheda dosa. Taani ne Godaa.<verse eid="LEV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 19:19" />“Ta kiitata naaga.</para>
  <para style="p" vid="LEV 19:19">“Issi qommo mehe hara qommo mehera biraysisopa.</para>
  <para style="p" vid="LEV 19:19">“Issi shooqan nam7u qommo zerethi zeropa.</para>
  <para style="p" vid="LEV 19:19">“Nam7u qommofe oosetida ma7o ma7ofa.<verse eid="LEV 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20" />“Issi asi azinas oyshetada de7ishin, wozo miishey imetidi wuronnashin woyko la77a keyonnashin, he ayllera aqiko enti seeretanaw bessees, shin enti hayqanaw bessenna. <verse eid="LEV 19:20" /><verse number="21" style="v" sid="LEV 19:21" />Gidoshin, he uray ba naaqo yarshos gidiya maraze Geeshsha Dunkaaniya pengen Godaa sinthe eho. <verse eid="LEV 19:21" /><verse number="22" style="v" sid="LEV 19:22" />Kahiney he naaqo yarsho maraziya ekidi, ura nagara atotethas Godaa sinthan yarshees; iya nagaray atto geetetana.<verse eid="LEV 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23" />“Hinte Kanaane biitta geliya wode ayfe immiya ay qommo mithi tokikoka, he mithaa ayfey meetetonna mela digetidaysa akeekite. Heedzu laythi wurana gakanaw he mithaa ayfey meetetofo. <verse eid="LEV 19:23" /><verse number="24" style="v" sid="LEV 19:24" />Oyddantho laythan he mithaa ayfey Godaas galatas shiiqiya geeshsha yarsho gidana. <verse eid="LEV 19:24" /><verse number="25" style="v" sid="LEV 19:25" />Ichashantho laythan he mithaa ayfiya miite. Hinte hessada oothiko, hinte mithaa ayfey darana. Taani Godaa, hinte Xoossaa.<verse eid="LEV 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26" />“Suuthi iya giddon de7iya asho moopite. Marotopite woyko bitopite.<verse eid="LEV 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 19:27" />“Hinte huuphe binaana garsara yuushshi aathidi ciiropite; hinte buuchaa yuushshi aathidi meedopite.<verse eid="LEV 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 19:28" />“Hayqida asa gisho hinte asatethaa gaaropite; woyko cacha beeta hinte asatethaa bolla medhofite. Taani ne Godaa.<verse eid="LEV 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29" />“Biittiya laymatethaninne tunatethan kumonna mela ne macca na7iw laymatethas aatha immada tunisopa.<verse eid="LEV 19:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 19:30" />“Ta Sambaata bonchite; ta goyinnetiya bessaa bonchite. Taani Godaa.<verse eid="LEV 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31" />“Moytille odisiya asaako woyko marotako boopite; hinte tunonna mela enta koyopite. Taani Godaa, hinte Xoossaa.<verse eid="LEV 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32" />“Dondza asinne cima asi be7iya wode uttida bessaafe denda eqada enta boncha; ne Xoossaas yayya. Taani Godaa.<verse eid="LEV 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33" />“Hinte biittan de7iya bete ase sugopite. <verse eid="LEV 19:33" /><verse number="34" style="v" sid="LEV 19:34" />Hinte biittan de7iya bete asi hinte gade asada xeellite; iya hinte huupheda dosite. Hinte kase Gibxe biittan bete asi gididi de7ideta. Taani Godaa, hinte Xoossaa.<verse eid="LEV 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35" />“Hinte wadhiyaban, makiyabaninne mizaanen wordotopite. <verse eid="LEV 19:35" /><verse number="36" style="v" sid="LEV 19:36" />Hinte mizaaney, hinte makiyabaynne wadhiyabay issino gido. Taani hintena Gibxe biittafe kessada ehida Godaa hinte Xoossaa.<verse eid="LEV 19:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 19:37" />“Hinte ta higgiyanne ta kiitaa ubbaa naagitenne oothite. Taani Godaa.”<verse eid="LEV 19:37" /></para>
  <chapter eid="LEV 19" />
  <chapter number="20" style="c" sid="LEV 20" />
  <para style="s1">Kiitetetha Ixoy Ehiya Seera</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1" />Goday Museko haysada yaagis. <verse eid="LEV 20:1" /><verse number="2" style="v" sid="LEV 20:2" />Isra7eele asaas haysada yaagada oda; “Isra7eele asaape gidin, woyko hinte giddon de7iya allaga asaape gidin, oonika ba na7a moloka geetetiya eeqas aathidi immiko, I hayqo; Isra7eele asay iya shuchan caddidi wodho. <verse eid="LEV 20:2" /><verse number="3" style="v" sid="LEV 20:3" />Ba na7aa moloka geetetiya eeqas immidi ta Dunkaaniya tuniseynne ta geeshsha sunthaa kawushey ta sinthan ixetidaba gidana. Ta asaa giddofe shaakada taani iya dhaysana. <verse eid="LEV 20:3" /><verse number="4" style="v" sid="LEV 20:4" />Shin he uraa Isra7eele asay be7ishe qelli gidi aadhikonne wodhonna ixiko, <verse eid="LEV 20:4" /><verse number="5" style="v" sid="LEV 20:5" />taani he addiyanne iya soo asaa morkana; iyanne Moloka kaallidaysata enta deriya giddofe shaakada dhaysana.<verse eid="LEV 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6" />“Oonika tana ammanetona ixidi moytille xeegikonne maro soo biiko, taani iyaw morke gidana; asaa giddofe iya dhaysana.<verse eid="LEV 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 20:7" />“Taani, Goday, hinte Xoossaa gidiya gisho, hinte hintena dummayite; geeshshi gidite. <verse eid="LEV 20:7" /><verse number="8" style="v" sid="LEV 20:8" />Ta wogaa naagite; iya polite. Taani hintena geeshshiya, hinte Godaa.<verse eid="LEV 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 20:9" />“Oonika ba aawa woyko ba aayiw cayiko hayqo. I ba aawa woyko ba aayiw cayida gisho, iya suutha acoy iya bolla gido.<verse eid="LEV 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 20:10" />“Issi asi ba shooruwa machiw xaalliko, enti nam7ay hayqo. <verse eid="LEV 20:10" /><verse number="11" style="v" sid="LEV 20:11" />Issi asi ba aawa machiw xaalliko, I ba aawa kawushis; enti nam7ay hayqo. Enta suuthaa acoy enta bolla gido. <verse eid="LEV 20:11" /><verse number="12" style="v" sid="LEV 20:12" />Issi asi ba na7aa machiw xaalliko, enti nam7ay hayqo. Enti tunabaa oothidosona; enta suuthaa acoy enta bolla gido.<verse eid="LEV 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 20:13" />“Issi addey maccasara gaheteysada addera gahetiko, enti nam7ay ixetidaba oothida gisho hayqo. Enta suuthaa acoy enta bolla gido. <verse eid="LEV 20:13" /><verse number="14" style="v" sid="LEV 20:14" />Issi asi na7iwunne aayiw macho ekiko, hessi tunabaa. Hinte giddon tunatethi doonna mela inne enti taman xuugeto.<verse eid="LEV 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 20:15" />“Issi asi mehera gahetiko, I hayqo; he miiziw wodhite. <verse eid="LEV 20:15" /><verse number="16" style="v" sid="LEV 20:16" />Issi maccasi mehera gahetiko he maccasiyanne he mehey nam7ay hayqo; enta suuthaa acoy enta bolla gido.<verse eid="LEV 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17" />“Issi asi ba aawa na7iw woyko ba aaye na7iw macho ekiko, hessi tunabaa. Enti banta asaa giddofe shaaketidi hayqo. I ba michiw kawushida gisho, ba nagaran baw oysheto. <verse eid="LEV 20:17" /><verse number="18" style="v" sid="LEV 20:18" />Issi asi kushe metora de7iya maccasara aqiko, I qetha qaarida gisho, enti nam7ay banta asaa giddofe kuretto.<verse eid="LEV 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 20:19" />“Ne aaye michiw woyko ne aawa michiw xaallofa; hessa oothey ba mata dabbotetha kawushshees. Enti nam7ay banta nagaran oysheto. <verse eid="LEV 20:19" /><verse number="20" style="v" sid="LEV 20:20" />Issi asi ba aawa ishaa machiw xaalliko, I ba aawa ishaa kawushis. Enti banta nagaran bantaw oysheto; enti nam7ay na7a yelonna hayqana. <verse eid="LEV 20:20" /><verse number="21" style="v" sid="LEV 20:21" />Issi asi ba ishaa machiw ekiko, hessi tuna. I ba ishaa kawushis; enti nam7ay yelo dhayana.<verse eid="LEV 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22" />“Hinte daana mela ta hintena gelsiya biittay hintena cuttonna mela hinte ta higgiyanne ta kiitaa naagite. <verse eid="LEV 20:22" /><verse number="23" style="v" sid="LEV 20:23" />Taani hinte sinthafe dhaysiya asaa de7uwa wogaa kaallopite. Enti hessa ubbaa oothida gisho, ta enta ixas. <verse eid="LEV 20:23" /><verse number="24" style="v" sid="LEV 20:24" />Hinte enta biitta laatana; maathinne eessi goggey biitta hintew immana. Taani hintena hara asaape dummayada kessida, Godaa hinte Xoossaa.<verse eid="LEV 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 20:25" />“Hessa gisho, hinte tunanne tuna gidonna mehetanne kafota shaakidi erite. Taani hessati hintew tuna gada wothida meheta, kafotanne biittan qaaxiyabata ubban hintena tunisopite. <verse eid="LEV 20:25" /><verse number="26" style="v" sid="LEV 20:26" />Taani Goday geeshshi gidiya gishonne hinte tabaa gidana mela hintena hara asaape dummayida gisho, hinteka taw geeshshi gidite.<verse eid="LEV 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27" />“Addey woyko macci moytillera haasayiko woyko marotiko, enti hayqanaw bessees. Enti shuchan cadetidi hayqo; enta suuthaa acoy enta bolla gido.”<verse eid="LEV 20:27" /></para>
  <chapter eid="LEV 20" />
  <chapter number="21" style="c" sid="LEV 21" />
  <para style="s1">Kahinetas Imetida Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 21:1" />Goday Museko, “Kahine gidida Aarona adde naytas haysada yaagada oda. Hintefe oonika <verse eid="LEV 21:1" /><verse number="2" style="v" sid="LEV 21:2" />ba mata dabbo, ba aaye, ba aawa, ba adde na7aa, ba macca na7e, ba ishaa, <verse eid="LEV 21:2" /><verse number="3" style="v" sid="LEV 21:3" />woyko azina gelonna, iya son de7iya ba miche aha gidonna ixiko, hayqida asa aha bochidi bana tunisopo. <verse eid="LEV 21:3" /><verse number="4" style="v" sid="LEV 21:4" />Ekoninne gelon dabbotida asa aha bochidi bana tunisopo.<verse eid="LEV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 21:5" />“Kahineti kayos banta huuphiyanne banta buuchaa meedopo; woyko banta asatethaa gaaropo. <verse eid="LEV 21:5" /><verse number="6" style="v" sid="LEV 21:6" />Enti Godaas xuussa yarshonne katha yarsho shiishiya kahineta gidiya gisho banta Xoossaas geeshshi gido; banta Xoossaa sunthaa tunisopo. Hessa gisho, enti geeshshi gidanaw bessees.<verse eid="LEV 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 21:7" />“Kahineti banta Xoossaas geeshshi gidiya gisho, kahineti layma maccasi, geela7o gidonna maccasi woyko azini yeddida maccasi ekofo. <verse eid="LEV 21:7" /><verse number="8" style="v" sid="LEV 21:8" />Kahineti hinte Xoossaas katha yarsho yarsheyisata gidiya gisho, hinte enta geeshshi oothidi ekite. Hintena geeshshiya Goday, taani, geeshshi gidiya gisho, enti geeshshi gido. <verse eid="LEV 21:8" /><verse number="9" style="v" sid="LEV 21:9" />Kahiniya na7iya laymatada bana tunisiko, iya ba aawa kawushasu; iya taman xuugetada hayqo.<verse eid="LEV 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10" />“Kahine halaqay, iya huuphen tiyo zaytey gukidaysinne kahinetetha ma7uwa ma7anaw dummatidaysi, ba huuphiyape xaatha qacciya denthofo; ba ma7uwa daakofo. <verse eid="LEV 21:10" /><verse number="11" style="v" sid="LEV 21:11" />Ahi de7iya soo gelopo; hari attoshin ba aawa woyko ba aaye aha gidikoka, hessa bochidi bana tunisopo. <verse eid="LEV 21:11" /><verse number="12" style="v" sid="LEV 21:12" />Iya dummayanaw tiyida Xoossaa zaytey iya bolla de7iya gisho, kahiney Geeshsha Dunkaaniyape keyopo; Geeshsha Dunkaaniya tunisopo. Taani Godaa.<verse eid="LEV 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 21:13" />“I ekiya machiya geela7o gido. <verse eid="LEV 21:13" /><verse number="14" style="v" sid="LEV 21:14" />Azini hayqida maccasi woyko azini yeddida maccasi woyko layma maccasi macho ekofo. Shin ba asaa giddofe geela7o macca na7a dooridi macho eko. <verse eid="LEV 21:14" /><verse number="15" style="v" sid="LEV 21:15" />Hessi hanonna ixiko, ba asaa giddon ba nayta tuna oothees. Taani iya geeshsheysa, iya Godaa.”<verse eid="LEV 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16" />Goday Museko haysada yaagis. <verse eid="LEV 21:16" /><verse number="17" style="v" sid="LEV 21:17" />“Neeni Aaronas haysada yaagada oda; ne kochaafe asatethan borey de7iya oonika katha yarsho taw yarshanaw bessenna. <verse eid="LEV 21:17" /><verse number="18" style="v" sid="LEV 21:18" />Asatethan borey de7iya asi, hessika qooqe woyko wobbe woyko som7oy iitida asi woyko laqoy de7iya asi, <verse eid="LEV 21:18" /><verse number="19" style="v" sid="LEV 21:19" />woyko tohoy woyko kushey silida asi, <verse eid="LEV 21:19" /><verse number="20" style="v" sid="LEV 21:20" />woyko kuuna asi woyko daro qantha asi woyko ayfe mulca asi woyko puusoy oykida asi woyko iralley de7iya asi woyko shuufa asi taw katha yarsho yarshanaw bessenna. <verse eid="LEV 21:20" /><verse number="21" style="v" sid="LEV 21:21" />Kahiniya Aarona kochaafe asatethan borey de7iya asi oonika Godaas xuussa yarshonne katha yarsho shiishanaw yarsho bessa yaanaw bessenna. <verse eid="LEV 21:21" /><verse number="22" style="v" sid="LEV 21:22" />I geeshsha kathaanne Ubbaafe geeshshi gidida ba Xoossaa kathaa maanaw danda7ees. <verse eid="LEV 21:22" /><verse number="23" style="v" sid="LEV 21:23" />Shin iya asatethan borey de7iya asi gidiya gisho, I ta Dunkaaniya tunisonna mela magarajuwako woyko yarsho bessaako shiiqopo. Entana geeshshiya Goday tana.”<verse eid="LEV 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 21:24" />Musey hessa ubbaa Aaronas, iya adde naytasinne Isra7eele asa ubbaas odis.<verse eid="LEV 21:24" /></para>
  <chapter eid="LEV 21" />
  <chapter number="22" style="c" sid="LEV 22" />
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1" />Goday Museko haysada yaagis; <verse eid="LEV 22:1" /><verse number="2" style="v" sid="LEV 22:2" />Ta geeshsha sunthaa enti tunisonna mela, Isra7eele asay taw dummayida imotata Aaroninne iya adde nayti bonchon ekidi, geeshshatethan naagana mela entaw oda. Taani Godaa.<verse eid="LEV 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 22:3" />Entako haysada yaaga; “Yaana yeletetha ubban hinte kochaafe oonika tunidi de7ishe, Isra7eele asay Godaas dummayida geeshsha yarshuwako shiiqiko, he uray ta sinthan bentofo. Taani Godaa.<verse eid="LEV 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 22:4" />“Aarona kochaafe goga hargey de7iya, woyko asatethafe goggiyabay de7iya oonika geeyana gakanaw geeshsha yarshuwa moopo. Aha bochidi tunidaba woyko iya atunthay gukida uraa bochiya oonika tuna. <verse eid="LEV 22:4" /><verse number="5" style="v" sid="LEV 22:5" />Qassi sa7ara gooshetiya tunisiyabata, woyko aybibanka tuna gididaba bochiya oonika, <verse eid="LEV 22:5" /><verse number="6" style="v" sid="LEV 22:6" />woyko hessa melaba bochiya oonika, omarsi gakanaw tuna gidees. I ba asatethaa haathan meecetonna de7ishe, geeshsha yarshuwafe maanaw koshshenna. <verse eid="LEV 22:6" /><verse number="7" style="v" sid="LEV 22:7" />Awi wulliya wode I geeshshi gidees. Hessafe guye, he geeshsha yarshuwafe bana gakiya gishuwa mo. <verse eid="LEV 22:7" /><verse number="8" style="v" sid="LEV 22:8" />Hayqidaba woyko do7i wodhida mehe asho moopo; hessi tunisiyaba. Taani Godaa.<verse eid="LEV 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 22:9" />“Kahineti ta wogaa naago; enti iya naagonna ixidi banta balan hayqana. Enta geeshshiya Goday tana.<verse eid="LEV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 22:10" />“He geeshsha yarshuwa kahiniya soo asaape attishin, hara asi moopo. Kahiniya soo yida imathe gidin, qaxaretidi oothiya ase gidin moopo. <verse eid="LEV 22:10" /><verse number="11" style="v" sid="LEV 22:11" />Shin kahiney ba biran shammida aylley woyko iya son yeletida aylley he kathaa mo. <verse eid="LEV 22:11" /><verse number="12" style="v" sid="LEV 22:12" />Kahine gidonna asi gelida kahiniya na7iya he geeshsha yarshuwafe moopo. <verse eid="LEV 22:12" /><verse number="13" style="v" sid="LEV 22:13" />Shin I azinay hayqiko woyko iyo yeddiko qassi iw na7i bayna ixiko, iya kase ba geela7otethan de7idaysada simmada ba aawa son de7iko, iya ba aawa gakeysafe mo. Shin hara asi oonika hessafe moopo.<verse eid="LEV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 22:14" />“Issi asi eronna de7ishe geeshsha yarshuwafe miiko, he I mida kathaa gatiya bolla xeetaape laatamu kushe gujidi kahiniyas immo. <verse eid="LEV 22:14" /><verse number="15" style="v" sid="LEV 22:15" />Isra7eele asay Godaas yarshiya geeshsha yarshuwa kahineti tunisopo. <verse eid="LEV 22:15" /><verse number="16" style="v" sid="LEV 22:16" />Enti banta ehida geeshsha yarshuwa bantaw midi nagaran oyshetana mela oothofo. Enta geeshshiya Goday tana.”<verse eid="LEV 22:16" /></para>
  <para style="s1">Eketonna Yarshota</para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17" />Goday Museko haysada yaagis; <verse eid="LEV 22:17" /><verse number="18" style="v" sid="LEV 22:18" />“Aaronas, iya adde naytasinne Isra7eele asa ubbaas haysada yaagada oda; Isra7eele asi gidin woyko enta giddon de7iya bete asi gidin, oonika Godaas xuussa yarsho ba dosan immey woyko ba qangetha gathey, <verse eid="LEV 22:18" /><verse number="19" style="v" sid="LEV 22:19" />he yarshoy eketana mela borey bayna wofaano, woyko maraze woyko kole eho. <verse eid="LEV 22:19" /><verse number="20" style="v" sid="LEV 22:20" />Borey de7iya ay meheyka eketonna gisho hessa shiishopite.<verse eid="LEV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 22:21" />“Issi asi ba qangetha gathanaw issifetetha yarsho Godaas yarshiya wode woyko ba mehiyape dosan imota Godaas shiishiya wode hessi eketana mela he mehey borey baynaba gido. <verse eid="LEV 22:21" /><verse number="22" style="v" sid="LEV 22:22" />Hinte mehiyape qooqe woyko meqo woyko wobbe woyko giyiya madunthi woyko puusoy woyko shattoy de7iyaba Godaas yarshofite. Taman xuussa yarsho oothidi yarsho bessan Godaas shiishopite. <verse eid="LEV 22:22" /><verse number="23" style="v" sid="LEV 22:23" />Iya bolla laqoy medheti woyko bolla paci de7iya korma woyko dorse issi asi ba dosan immiya yarsho shiishanaw danda7ees; shin qangetha gasos gidiko hessi eketenna. <verse eid="LEV 22:23" /><verse number="24" style="v" sid="LEV 22:24" />Sanga woyko madunxidaba Godaas yarshofite. Hinte biittan hessa melaba oothopite. <verse eid="LEV 22:24" /><verse number="25" style="v" sid="LEV 22:25" />Hinte giddon de7iya allaga asatape ekida hessa mela mehiya hinte Xoossaas katha yarsho oothidi shiishopite. Enta bolla borey de7iya gisho hinte gisho eketokona.”<verse eid="LEV 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26" />Goday Museko haysada yaagis; <verse eid="LEV 22:26" /><verse number="27" style="v" sid="LEV 22:27" />“Boora na7i woyko marazey woyko koley yeletiya wode laapun gallas ba aayera gam7o. Hospuntha gallasape doomidi, Godaas xuussa yarsho oothidi shiishanaw danda7etees. <verse eid="LEV 22:27" /><verse number="28" style="v" sid="LEV 22:28" />Miizi woyko dorse I maraara issi gallas shukofite.<verse eid="LEV 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 22:29" />“Hinte galata yarsho Godaas shiishiya wode hinte yarshoy eketana mela yarshite. <verse eid="LEV 22:29" /><verse number="30" style="v" sid="LEV 22:30" />Yarshoy yarshetida gallas meetetidi wuranaw koshshees; iyape wontos ashshofite. Taani Godaa.<verse eid="LEV 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31" />“Ta kiitta naagitenne polite. Taani Godaa. <verse eid="LEV 22:31" /><verse number="32" style="v" sid="LEV 22:32" />Ta geeshsha sunthaa tunisopite. Ta geeshshi gideysi Isra7eele asaa giddon eretanaw bessees. Hintena geeshshiya Goday tana. <verse eid="LEV 22:32" /><verse number="33" style="v" sid="LEV 22:33" />Hinte Xoosse gidanaw hintena Gibxe biittafe kessiday tana. Taani Godaa.”<verse eid="LEV 22:33" /></para>
  <chapter eid="LEV 22" />
  <chapter number="23" style="c" sid="LEV 23" />
  <para style="s1">Eretida Ba7aale Gallasata</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1" />Goday Museko haysada yaagis; <verse eid="LEV 23:1" /><verse number="2" style="v" sid="LEV 23:2" />Isra7eele asaas haysada yaagada oda; Geeshsha shiiqo yaagidi awaajishe, hinte bonchanaw bessiya eretida Godaa ba7aaleti haysata.<verse eid="LEV 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 23:3" />Hinte usupun gallas ooso ootheeta, shin laapuntha gallasay hinte shempiya Sambaata gallas. He gallas geeshsha shiiqo shiiqite; ay oosoka oothopite; hinte de7iya bessa ubban hessi Godaas Sambaata.<verse eid="LEV 23:3" /></para>
  <para style="s1">Paasika Ba7aalenne Uytha Ba7aale</para>
  <para style="r">(<ref loc="NUM 28:16-25">Taybo 28:16-25</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4" />Enta woden woden geeshsha shiiqo oothidi hinte bonchanaw bessiya eretida Godaa ba7aaleti haysata; <verse eid="LEV 23:4" /><verse number="5" style="v" sid="LEV 23:5" />Koyro ageenan tammanne oyddantho gallas sa7i omarsiya wode Godaa Paasikay doomees.<verse eid="LEV 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 23:6" />He ageenan tammanne ichashantho gallasan Godaas Uytha Ba7aale gallasay doomees. Hessa gisho, laapun gallasatan irshoy geliboonna uythi miite. <verse eid="LEV 23:6" /><verse number="7" style="v" sid="LEV 23:7" />He gallasatape koyro gallas geeshsha shiiqo shiiqite; ooso oothopite. <verse eid="LEV 23:7" /><verse number="8" style="v" sid="LEV 23:8" />Laapun gallas ubbaa Godaas xuussa yarsho yarshite; laapuntha gallasan geeshsha shiiqo shiiqite; ooso oothopite.<verse eid="LEV 23:8" /></para>
  <para style="s1">Bayra Kathi</para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9" />Goday Museko haysada yaagis; <verse eid="LEV 23:9" /><verse number="10" style="v" sid="LEV 23:10" />Isra7eele asaas haysada yaagada oda; taani hintew immiya biitta gelidi hinte kathi cakiya wode, he kathaa koyro mirqiya kahiniyas ehite. <verse eid="LEV 23:10" /><verse number="11" style="v" sid="LEV 23:11" />Goday hintebaa ekana mela Sambaata kaalliya wontetha gallas kahiney he mirqiya Godaa sinthan dhoqu oothidi yuushsho. <verse eid="LEV 23:11" /><verse number="12" style="v" sid="LEV 23:12" />Hinte mirqiya yuushshida he gallas borey bayna issi laytha maraze xuussa yarsho oothidi Godaas shiishite. <verse eid="LEV 23:12" /><verse number="13" style="v" sid="LEV 23:13" />He yarshuwara issife shamaho zaytera munuqetida nam7u kilo giraame lo77o dhiille katha yarsho oothidi shiishite. Hessi Godaas sawo tonku giya xussa yarsho gidana; iyara issife issi litiro gidiya woyne ushshi shiishite. <verse eid="LEV 23:13" /><verse number="14" style="v" sid="LEV 23:14" />Ha yarshuwa hinte, hinte Xoossaas shiishiya gallasay gakanaw, wacha kathaafe qaye woyko caaca woyko uukidi moopite. Hessi hinte de7iya bessa ubban yaana yeletethaas merinaa woga gido.<verse eid="LEV 23:14" /></para>
  <para style="s1">Katha Shiisho Ba7aale</para>
  <para style="r">(<ref loc="NUM 28:26-31">Taybo 28:26-31</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15" />Hinte yuusho yarsho mirqiya ehida Sambaata wontetha gallasaape doomidi, laapun saaminta taybite. <verse eid="LEV 23:15" /><verse number="16" style="v" sid="LEV 23:16" />Laapuntha Sambaata kaalliya wontetha gallasay gakanaw ishatamu gallas taybite; wacha kathaafe yarsho Godaas shiishite. <verse eid="LEV 23:16" /><verse number="17" style="v" sid="LEV 23:17" />Hinte de7iya bessaafe nam7u kilo giraame gidiya lo77o dhiilliyan irsho yeggidi uukida nam7u uythi yuusho yarshos ekidi yiite. Hessi wacha kathaafe Godaas shiiqiya yarsho gidees. <verse eid="LEV 23:17" /><verse number="18" style="v" sid="LEV 23:18" />He uythaara issife borey bayna issi laythi gidida laapun dorsa urgeta, issi wofaanonne nam7u marazeta shiishite. Enta katha yarshoranne ushsha yarshora issife Godaas xuugetiya sawo tonku giya yarsho oothidi yarshite. <verse eid="LEV 23:18" /><verse number="19" style="v" sid="LEV 23:19" />Qassi issi kole nagara yarshos, issi laythi gidida nam7u dorsa urgeta issifetetha yarshos shiishite.<verse eid="LEV 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 23:20" />Kahiney bayra kathaa, uythaanne nam7u dorsa urgeta yuusho yarsho oothidi, Godaa sinthan dhoqu oothidi yuushsho. Hessati Godaas geeshshi; kahinetas qassi gisho. <verse eid="LEV 23:20" /><verse number="21" style="v" sid="LEV 23:21" />He gallas hintew geeshsha shiiqo gidana mela awaajite; ooso oothopite. Haysi hinte de7iya bessa ubban yaana yeletethaas merinaa woga gido.<verse eid="LEV 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 23:22" />Hinte biittan kaxida kathaa cakiya wode gadiya gaxaa gakanaw cakofite; cakishin attida poshiliya qoropite; hessa manqotasinne bete asaas aggaagite. Taani Godaa hinte Xoossaa.<verse eid="LEV 23:22" /></para>
  <para style="s1">Moyze Puno Ba7aale</para>
  <para style="r">(<ref loc="NUM 29:1-6">Taybo 29:1-6</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23" />Goday Museko haysada yaagis; <verse eid="LEV 23:23" /><verse number="24" style="v" sid="LEV 23:24" />Isra7eele asaas haysada yaagada oda; laapuntha ageenan koyro gallasaa shempo gallas oothidi bonchite; hassayiso moyze punnishe geeshsha shiiqo shiiqite. <verse eid="LEV 23:24" /><verse number="25" style="v" sid="LEV 23:25" />He gallas Godaas xuussa yarsho shiishitepe attishin, ooso oothopite.<verse eid="LEV 23:25" /></para>
  <para style="s1">Nagara Atotetha Gallasaa</para>
  <para style="r">(<ref loc="NUM 29:7-11">Taybo 29:7-11</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26" />Goday Museko haysada yaagis; <verse eid="LEV 23:26" /><verse number="27" style="v" sid="LEV 23:27" />Laapuntha ageenan tammantho gallasay nagara atotetha gallas; he gallas geeshsha shiiqo shiiqite. He gallas hintena kawushite; Godaas xuussa yarsho shiishite. <verse eid="LEV 23:27" /><verse number="28" style="v" sid="LEV 23:28" />He gallasay Godaa hinte Xoossaa sinthan hinte nagaray qushetana mela hinte nagaraa atotetha gallas gidiya gisho he gallasan ooso oothopite. <verse eid="LEV 23:28" /><verse number="29" style="v" sid="LEV 23:29" />He gallas banatetha kawushonna asi oonika ba asaa giddofe kuretto. <verse eid="LEV 23:29" /><verse number="30" style="v" sid="LEV 23:30" />He gallas ooso oothiya uraa oonaka taani iya asaa giddofe kurana. <verse eid="LEV 23:30" /><verse number="31" style="v" sid="LEV 23:31" />He gallas ooso oothopite. Haysi hinte de7iya bessa ubban yaana yeletethaas merinaa woga gido. <verse eid="LEV 23:31" /><verse number="32" style="v" sid="LEV 23:32" />Hessi hintew dummatida shempo gallas; he gallas hintenatethaa kawushite. He ageenan uddufuntho gallas omarsafe doomidi, tammantha gallas omarsi gakanaw hinte Sambaata bonchite.<verse eid="LEV 23:32" /></para>
  <para style="s1">Shaqara Ba7aale</para>
  <para style="r">(<ref loc="NUM 29:12-40">Taybo 29:12-40</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33" />Goday Museko haysada yaagis; <verse eid="LEV 23:33" /><verse number="34" style="v" sid="LEV 23:34" />Isra7eele asaas haysada yaagada oda; laapuntha ageenan tammanne ichashantho gallasaape doomidi, laapun gallas gakanaw Godaas Shaqara Ba7aale. <verse eid="LEV 23:34" /><verse number="35" style="v" sid="LEV 23:35" />He gallasatape koyro gallasan geeshsha shiiqo shiiqite; ooso oothopite. <verse eid="LEV 23:35" /><verse number="36" style="v" sid="LEV 23:36" />Laapun gallas ubban Godaas xuussa yarsho shiishite; hospuntho gallasan geeshsha shiiqo shiiqite. Godaas xuussa katha yarsho shiishite. He gallasay baaliya wursetha gallas gidiya gisho, ooso oothopite.<verse eid="LEV 23:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 23:37" />Xuussa yarsho, katha yarsho, hara yarshotanne ushsha yarsho koshshiya woden Godaas shiishanaw geeshsha shiiqo oothidi awaajana Godaa ba7aaleti haysata. <verse eid="LEV 23:37" /><verse number="38" style="v" sid="LEV 23:38" />Ha yarshoti Godaa Sambaatatape, Godaas immiya imotatape, qangetha imotatapenne dosan immiya imotatape dumma.<verse eid="LEV 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39" />Hinte gaden kaxida kathaa shiishidaape guye, tammanne ichashantho gallasaape doomidi laapun gallas gakanaw Godaa ba7aale bonchite. Koyro gallasaynne hospuntho gallasay hintew dumma shempo gallas gidana. <verse eid="LEV 23:39" /><verse number="40" style="v" sid="LEV 23:40" />Koyro gallas lo77o mitha ayfe, zamba tashe, cil7o mitha haythenne shaafa gaxan dicciya mitha haythi ekidi, Godaa hinte Xoossaa sinthan ufaytishe laapun gallas ba7aale bonchite. <verse eid="LEV 23:40" /><verse number="41" style="v" sid="LEV 23:41" />He baaliya laythan laythan laapuntha ageenan laapun gallas Godaa bonchite. Hessi yaana yeletethaas merinaa woga gido. <verse eid="LEV 23:41" /><verse number="42" style="v" sid="LEV 23:42" />He laapun gallasaa shaqaran de7ite; Isra7eele asi gidida ubbay he shaqaran de7o. <verse eid="LEV 23:42" /><verse number="43" style="v" sid="LEV 23:43" />Taani hintena Gibxe biittafe kessida wode shaqaran daana mela oothidaysa yaana yeletethay erana. Taani Godaa hinte Xoossaa.<verse eid="LEV 23:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 23:44" />Hessada oothidi, Musey Godaa ba7aaleta bonchiya wogaa Isra7eele asaas odis.<verse eid="LEV 23:44" /></para>
  <chapter eid="LEV 23" />
  <chapter number="24" style="c" sid="LEV 24" />
  <para style="s1">Xompeta Naago</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 24:1" />Goday Museko haysada yaagis; <verse eid="LEV 24:1" /><verse number="2" style="v" sid="LEV 24:2" />Xompey to7onna eexishe daana mela iyaw koshshiya gum7idi xillisida shamaho zayte new ehana mela Isra7eele asaa kiitta. <verse eid="LEV 24:2" /><verse number="3" style="v" sid="LEV 24:3" />Geeshsha Dunkaaniya giddon de7iya markatetha magarajuwafe kare baggara omarsafe wonta gakanaw Aaroni Godaa sinthan he xompiya ubba wode eetho. Yaana yeletetha ubbaas hessi merinaa woga gido. <verse eid="LEV 24:3" /><verse number="4" style="v" sid="LEV 24:4" />Xompe wothiya walahi bayna worqa kocaa bolla de7iya xompeti Godaa sinthan ubba wode eexana mela Aaroni naago.<verse eid="LEV 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5" />Tammanne nam7u kilo giraame gidiya lo77o dhiille ekada tammanne nam7u uythi uuka. <verse eid="LEV 24:5" /><verse number="6" style="v" sid="LEV 24:6" />He uythata usupuna usupuna nam7u maaran Godaa sinthan de7iya walahi bayna worqa xarpheeza bolla wotha. <verse eid="LEV 24:6" /><verse number="7" style="v" sid="LEV 24:7" />Godaas xuugetanaw shiiqida katha yarsho gideysa erisanaw, nam7u maarata miyen geeshsha ixaane wotha. <verse eid="LEV 24:7" /><verse number="8" style="v" sid="LEV 24:8" />Ha uythaa Sambaatan Sambaatan ubba wode Aaroni Isra7eele asaa gisho merinaa caaqo oothidi Godaa sinthan wotho. <verse eid="LEV 24:8" /><verse number="9" style="v" sid="LEV 24:9" />Hessi Aaronanne iya adde nayta gakiya gisho; enti iya geeshsha bessan mo. Hessi Godaas xuussa yarshuwafe wogaada Aaronanne iya nayta gakiya gisho gidiya gisho Ubbaafe Geeshshi.<verse eid="LEV 24:9" /></para>
  <para style="s1">Suure Pirda</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 24:10" />Ba aayen Isra7eele, ba aawan Gibxe asi gidida issi uray de7ees. Issi gallas I hara Isra7eele asara heeran wadhetis. <verse eid="LEV 24:10" /><verse number="11" style="v" sid="LEV 24:11" />Ba aayen Isra7eele gidida uray Godaa sunthaa cayis; yaatin iya asay Museko ehidosona. He uraa aayiya Daane koche gidida Debira na7a. I sunthay Salomito. <verse eid="LEV 24:11" /><verse number="12" style="v" sid="LEV 24:12" />He uraa waataneko Godaa sheney qoncana gakanaw iya naagisidosona.<verse eid="LEV 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 24:13" />Goday Muse haysada yaagis; <verse eid="LEV 24:13" /><verse number="14" style="v" sid="LEV 24:14" />He cayida uraa gutaape gaxa kessa. I cayishin si7ida asa ubbay banta kushiya iya huuphiya bolla wotho; Isra7eele maabara ubbay iya shucha caddidi wodho. <verse eid="LEV 24:14" /><verse number="15" style="v" sid="LEV 24:15" />Isra7eele asaas haysada yaagada oda; issi asi ba Xoossaa cayiko, I ba nagaran oyshetana. <verse eid="LEV 24:15" /><verse number="16" style="v" sid="LEV 24:16" />Godaa sunthaa cayiya asi hayqo; Isra7eele maabara ubbay iya shuchan caddo. Bete asi woyko gade asi Godaa sunthaa cayiko hayqo.<verse eid="LEV 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 24:17" />Ase wodhida asi hayqo. <verse eid="LEV 24:17" /><verse number="18" style="v" sid="LEV 24:18" />Asa mehe wodhida asi oonika ba wodhida mehiya gisho paxa mehiya qanxo. <verse eid="LEV 24:18" /><verse number="19" style="v" sid="LEV 24:19" />Issi asi ba shooruwa qohiko, I oothidaysada iya bolla ooseto. <verse eid="LEV 24:19" /><verse number="20" style="v" sid="LEV 24:20" />Menthiko me77o; ayfe gisho ayfe; acha gisho ache. Asa bolla qoho gathida oonika I gathida qohuwada iya bolla gako. <verse eid="LEV 24:20" /><verse number="21" style="v" sid="LEV 24:21" />Mehe wodhida asi he mehiya gatiya qanxo; shin ase wodhida asi hayqo. <verse eid="LEV 24:21" /><verse number="22" style="v" sid="LEV 24:22" />Bete asaasinne Isra7eele asas higgey issino gido. Taani Godaa hinte Xoossaa.<verse eid="LEV 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 24:23" />Musey hessa Isra7eele asaas odis; enti he cayida uraa gutaape gaxa kessidi, shuchan caddidi wodhidosona. Yaatidi Isra7eele asay Goday Muse kiitidaysada oothidosona.<verse eid="LEV 24:23" /></para>
  <chapter eid="LEV 24" />
  <chapter number="25" style="c" sid="LEV 25" />
  <para style="s1">Sambaata Laythi</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1" />Siina zuma bolla Goday Museko haysada yaagis. <verse eid="LEV 25:1" /><verse number="2" style="v" sid="LEV 25:2" />Neeni Isra7eele asaas haysada yaagada oda; taani hintew immiya biitta hinte geliya wode biittiya ba huuphen Godaa Sambaata boncho. <verse eid="LEV 25:2" /><verse number="3" style="v" sid="LEV 25:3" />Usupun laythi kumethi hinte gaden zerite; usupun laythi kumethi hinte woyne xeera xunqite; iya ayfiya maxite. <verse eid="LEV 25:3" /><verse number="4" style="v" sid="LEV 25:4" />Shin laapuntha laythay biittas shempo Sambaata; hessi Godaa Sambaata. He laapuntha laythan gaden zeropite; hinte woyne xeeraa xunqofite. <verse eid="LEV 25:4" /><verse number="5" style="v" sid="LEV 25:5" />Hinte biittan aasebo kaxidaba shiishopite; woyne xeera xunqofite; ayfiya maxopite. He laythay biittas kumethi shempo laythi gido. <verse eid="LEV 25:5" /><verse number="6" style="v" sid="LEV 25:6" />He Sambaata laythan biittay oosetonna de7ishin kaxiya kathaa neeni, ne adde aylley, ne macca aylley, ne son une oothey, guutha wodes de7iya bete asi maanaw danda7ees. <verse eid="LEV 25:6" /><verse number="7" style="v" sid="LEV 25:7" />Hessadaka, ne mehiyasinne ne biittan de7iya do7atas gidiya kathi demmana; biittan kaxiyaba ubbay meeteto.<verse eid="LEV 25:7" /></para>
  <para style="s1">Ishatammantho Laythi</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8" />Laythatas giddon de7iya laapun Sambaatata tayba; laapun Sambaatatas laytha tayboy laapun toho laapuna; hessika oytamanne uddufun laythi. <verse eid="LEV 25:8" /><verse number="9" style="v" sid="LEV 25:9" />Laapuntha ageenan, tammantho gallas bonchetiya nagara atotetha gallasan moyze punniya asi biitta ubbaa kiitta. <verse eid="LEV 25:9" /><verse number="10" style="v" sid="LEV 25:10" />Ishatammantho laytha dummayidi, he biittan de7iya ubbaas la77atethi awaajite. Hessi hintew Ishatammantho Laytha Ba7aale. He wode hinte ubbay hinte gadiyakonne hinte soo asaako simmite. <verse eid="LEV 25:10" /><verse number="11" style="v" sid="LEV 25:11" />He laythay hintew Ishatammantho Laytha Ba7aale. He laythan zeropite; aasebo kaxidaba cakofite; xeera xunqonna ayfida woyne ayfiya maxopite. <verse eid="LEV 25:11" /><verse number="12" style="v" sid="LEV 25:12" />Hessi Ishatammantho Laytha Ba7aale gidiya gisho I hintew geeshshi; goyonna coo denban kaxidaba miite.<verse eid="LEV 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13" />He Ishatammantho Laytha Ba7aale wode asi ubbay ba gade simmo.<verse eid="LEV 25:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 25:14" />Hinte, hinte shooruwape gade shammiko woyko iyaw bayziko issoy issuwa cimmofite. <verse eid="LEV 25:14" /><verse number="15" style="v" sid="LEV 25:15" />Hinte Ishatammantho Laytha Baaliyape guye de7iya laythata taybuwan hinte shooruwape shammite. Hinte shooroy gadey kathi immanaw de7iya laythata taybuwada bayzo. <verse eid="LEV 25:15" /><verse number="16" style="v" sid="LEV 25:16" />Laytha tayboy daro gidiko gatey darees; laythata tayboy guuxiko gatey guuxees. Gadiya lo77otethaada hinte shooroy hintew bayzees. <verse eid="LEV 25:16" /><verse number="17" style="v" sid="LEV 25:17" />Hinte issoy issuwa cimmofite; shin hinte, hinte Xoossaa yayyite. Taani Godaa, hinte Xoossaa.<verse eid="LEV 25:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18" />Hinte ha biittan saro daana mela ta kiitta polite; ta higgiya naagite. <verse eid="LEV 25:18" /><verse number="19" style="v" sid="LEV 25:19" />Biittay ba ayfiya hintew immin hinte kallana gakanaw maana; he biittan hinte saro daana. <verse eid="LEV 25:19" /><verse number="20" style="v" sid="LEV 25:20" />Heko, nuuni zeronna aggidi, qassi kathi shiishonna aggidi, laapuntha laythan ay maanee? giiko, <verse eid="LEV 25:20" /><verse number="21" style="v" sid="LEV 25:21" />taani usupuntho laythan ta anjuwa hintew kiittana; biittay heedzu laythas gidiya kathi immana. <verse eid="LEV 25:21" /><verse number="22" style="v" sid="LEV 25:22" />Hospuntha laythan hinte, hinte biittan zeriya wode shaacha kathaa maana. Hinte zeriya kathaa uddufuntho laythan shiishana gakanaw shaacha kathaa maana.<verse eid="LEV 25:22" /></para>
  <para style="s1">Shalo Zaaro Woga</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23" />Biittay tabaa gidiya gishonne hinte he biittan imathenne bete gididi de7iya gisho biitta simmonnaada oothidi bayzopite. <verse eid="LEV 25:23" /><verse number="24" style="v" sid="LEV 25:24" />Hinte oykida gadiya godati, wozana maatay Isra7eele ubban naagetanaw bessees.<verse eid="LEV 25:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 25:25" />Issi Isra7eele asi manqidi ba gadiyape bayziko, iya mata dabboy he gadiya iyaw wozo. <verse eid="LEV 25:25" /><verse number="26" style="v" sid="LEV 25:26" />Iyaw he gadiya woziya dabboy dhayiko, I wonto duretidi woziya miishe demmiko zaaridi wozanaw danda7ees. <verse eid="LEV 25:26" /><verse number="27" style="v" sid="LEV 25:27" />Ba bayzida wodepe doomidi de7iya laytha taybidi, attida laytha miishiya shammidaysas zaaro; yaatidi I ba gadiya simmo. <verse eid="LEV 25:27" /><verse number="28" style="v" sid="LEV 25:28" />Shin iyaw he gadiya wozanaw gidiya miishey dhayiko, Ishatammantho Laytha Ba7aaley gakanaw gadey shammida uraa kushen gam7o. Ishatammantho Laytha Ba7aale wode iya gadey iyaw simmo.<verse eid="LEV 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29" />Issi asi gimbetida katama giddon de7iya keethe bayziko, I bayzida wodiyape bidi issi laythi kumana gakanaw zaaridi wozanaw danda7ees. <verse eid="LEV 25:29" /><verse number="30" style="v" sid="LEV 25:30" />Shin issi laytha giddon wozanaw danda7etonna ixiko, he gimbetida katamaa giddon de7iya keethay shammida uraasinne iya kochaas gidees. Ishatammantho Laytha Ba7aale wode simmenna. <verse eid="LEV 25:30" /><verse number="31" style="v" sid="LEV 25:31" />Shin gimbetiboona heeran de7iya keethati gade mela wozetoosona. Ishatammantho Laytha Ba7aale wode bayzidaysas simmoosona.<verse eid="LEV 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 25:32" />Gidoshin, Leeweti katamatan de7iya banta keethaa banta koyida wode wozanaw danda7oosona. <verse eid="LEV 25:32" /><verse number="33" style="v" sid="LEV 25:33" />Leewetape issi asi enta katamaa giddon de7iya keethaa bayzidi wozanaw xoonetiko, he enta katamaa giddon de7iya keethay Ishatammantho Laytha Baaliya wode simmees. Leeweta katamaa giddon de7iya keethay Isra7eele asaa giddon Leewetasa. <verse eid="LEV 25:33" /><verse number="34" style="v" sid="LEV 25:34" />Shin enta katamaa yuushuwan de7iya hentha biittay entaw merinaa aqo gidiya gisho bayzetenna.<verse eid="LEV 25:34" /></para>
  <para style="s1">Tal7e Woga</para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35" />Issi Isra7eele asi manqidi bana aysanaw xoonetiko, imathada woyko bete asada I neera daana mela maadda. <verse eid="LEV 25:35" /><verse number="36" style="v" sid="LEV 25:36" />Iya neera wothanaw iyape yelo ekofa woyko wodhe moopa. Shin ne Xoossaa yayya. <verse eid="LEV 25:36" /><verse number="37" style="v" sid="LEV 25:37" />Ne bira iyaw yelora tal7ofa; ne kathaa iyaw wodhera bayzopa. <verse eid="LEV 25:37" /><verse number="38" style="v" sid="LEV 25:38" />Hintew Kanaane biitta immanawunne hinte Xoossaa gidanaw, hintena Gibxe biittafe kessida, taani, Godaa hinte Xoossaa.<verse eid="LEV 25:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39" />Issi Isra7eele asi manqidi, bana new aylle oothidi bayziko iya aylleda oosisopa. <verse eid="LEV 25:39" /><verse number="40" style="v" sid="LEV 25:40" />I bete asada une oothidi Ishatammantho Laytha Ba7aaley gakanaw neera de7o. <verse eid="LEV 25:40" /><verse number="41" style="v" sid="LEV 25:41" />He wode I ba naytara issife ne soope keyidi ba soo asaako boo; ba aawa gade simmo. <verse eid="LEV 25:41" /><verse number="42" style="v" sid="LEV 25:42" />Isra7eele asay taani Gibxe biittafe kessida ta aylle gidiya gisho enti aylletethas bayzetofo. <verse eid="LEV 25:42" /><verse number="43" style="v" sid="LEV 25:43" />Neeni enta un7ethada haaropa; shin neeni, ne Xoossaa yayya.<verse eid="LEV 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 25:44" />New addenne macca aylley daana mela koyiko, ne yuushuwan de7iya kawotethatape shamma. <verse eid="LEV 25:44" /><verse number="45" style="v" sid="LEV 25:45" />Hinte biittan de7iya bete asaa nayta shammanaw danda7eeta. Hinte biittan de7ishe yeletida enta soo asaape hintew shalo oothanaw danda7eeta. <verse eid="LEV 25:45" /><verse number="46" style="v" sid="LEV 25:46" />Hintefe guye, hinte nayti enta merinaw laattana mela hinte naytas immite. Hinte enta ubba wode hinte aylle oothanaw danda7eeta; shin Isra7eele asi un7ethidi haaropite.<verse eid="LEV 25:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47" />Ne matan de7iya imathi woyko bete asi duretiko, iya matan de7iya Isra7eele uray manqidi, ne matan de7iya imathas woyko bete uraas woyko imatha addiya kochaafe issuwas bana bayziko, <verse eid="LEV 25:47" /><verse number="48" style="v" sid="LEV 25:48" />I bayzetidi simmin, iya wozanaw danda7etees; iya dabbotape issoy iya wozo. <verse eid="LEV 25:48" /><verse number="49" style="v" sid="LEV 25:49" />Iya aawa ishay, woyko iya aawa ishaa na7ay woyko iya yaraape mata dabboy iya wozo; woyko I ba huuphen duretidi bana wozo. <verse eid="LEV 25:49" /><verse number="50" style="v" sid="LEV 25:50" />I bana shammida uraara gididi, I bana bayzida laythafe doomidi Ishatammantho Laytha Ba7aaley gakanaw de7iya laythata taybo. Iya la77atetha gatey, he laytha taybuwa keena gido. I bana shammidaysara gam7ida wodiya gatey issi asi une oothidi demmiya miishiyara gina gido. <verse eid="LEV 25:50" /><verse number="51" style="v" sid="LEV 25:51" />Ishatammantho Laytha Ba7aaley gakanaw daro laythi attidaba gidiko, ba bayzetida gatiyape he laytha taybon bana woziya gatiya qanxo. <verse eid="LEV 25:51" /><verse number="52" style="v" sid="LEV 25:52" />Ishatammantho Laytha Ba7aaley gakanaw attida laythay guutha gidiko, bana shammidaysara issife taybidi, he laytha taybon bana woziya gatiya qanxo. <verse eid="LEV 25:52" /><verse number="53" style="v" sid="LEV 25:53" />I laythan laythan une oothiya asada bana shammidaysara de7o; iya goday iya un7ethidi haaranaw bessenna.<verse eid="LEV 25:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 25:54" />Shin I hessa mela hanon wozetonna ixiko, Ishatammantho Laytha Ba7aaley gakiya wode inne iya nayti aylletethafe keyo. <verse eid="LEV 25:54" /><verse number="55" style="v" sid="LEV 25:55" />Isra7eele asay, ta Gibxe biittafe kessida ta aylle. Taani, Godaa hinte Xoossaa.<verse eid="LEV 25:55" /></para>
  <chapter eid="LEV 25" />
  <chapter number="26" style="c" sid="LEV 26" />
  <para style="s1">Kiitetethi Ehiya Woyto</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1" />Goyinnanaw eeqata oothopite; qassi hawulte woyko eeqa tuussu woyko shucha eeqa essofite. Taani Godaa, hinte Xoossaa. <verse eid="LEV 26:1" /><verse number="2" style="v" sid="LEV 26:2" />Ta Sambaatata naagite; ta goyinno bessaa bonchite. Taani Godaa.<verse eid="LEV 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3" />Hinte ta higgiya kaallikonne ta kiita naagiko, <verse eid="LEV 26:3" /><verse number="4" style="v" sid="LEV 26:4" />taani hintew ira woden woden immana; biittay kathaa darsidi dolisana; gaden de7iya mithay ayfana. <verse eid="LEV 26:4" /><verse number="5" style="v" sid="LEV 26:5" />Hinte kathaa shiishidi ongonna de7ishin woyne maxiya wodey gakana; woyniya maxidi wursonna kathaa zeriya wodey gakana. Hinte kallana gakanaw kathi maana; hinte, hinte biittan saro daana.<verse eid="LEV 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 26:6" />Taani biittas sarotethi immana; oonika hintena yashisonna hinte zin7ana. Iita do7ata taani biittafe dhaysana; hinte biittan nam7antho oli dendenna. <verse eid="LEV 26:6" /><verse number="7" style="v" sid="LEV 26:7" />Hinte morketa hinte yedethana; enti hinte sinthan mashshan hayqana. <verse eid="LEV 26:7" /><verse number="8" style="v" sid="LEV 26:8" />Hintefe ichashay xeeta yedethana; qassi xeetay tammu mukula yedethana. Hinte morketi hinte sinthan mashshan hayqana.<verse eid="LEV 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 26:9" />Taani hintena maarota ayfen be7ana; hintena ayfisana; hintena darsana; taani ta caaquwa hintera minthana. <verse eid="LEV 26:9" /><verse number="10" style="v" sid="LEV 26:10" />Hinte shaacha kathaa midi wursonna de7ishe, wacha kathaa wothanaw, shaacha kathaa diggidi besse giigisana. <verse eid="LEV 26:10" /><verse number="11" style="v" sid="LEV 26:11" />Taani ta de7iya bessaa hinte giddon oothana; taani hintena ixike. <verse eid="LEV 26:11" /><verse number="12" style="v" sid="LEV 26:12" />Taani hinte giddon hemetana; hinte Xoossaa gidana; hinte ta ase gidana. <verse eid="LEV 26:12" /><verse number="13" style="v" sid="LEV 26:13" />Hinte Gibxetas aylle gidonna mela he biittafe hintena kessida Goday, taani hinte Xoossaa. Taani hinte aylletetha qambara menthas; hinte dhoqu gidi hemetana mela oothas.<verse eid="LEV 26:13" /></para>
  <para style="s1">Kiitetetha Ixoy Ehiya Seera</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14" />Shin hinte taana si7onna ixikonne, ta kiita polonna ixiko, <verse eid="LEV 26:14" /><verse number="15" style="v" sid="LEV 26:15" />ta wogaa kadhiko, ta kiita ubbaa polonna ixidi ta caaquwa menthanaw ta higgiya boriko, <verse eid="LEV 26:15" /><verse number="16" style="v" sid="LEV 26:16" />he wode taani hinte bolla haysa oothana; hinte akeekona de7ishin yashshi, gilqatethi, hinte ayfiya teljumisiyanne hinte asatethaa melisiya misha harge hinte bolla yeddana. Hinte morketi maana gisho hinte zeriya zerethay mela gidana. <verse eid="LEV 26:16" /><verse number="17" style="v" sid="LEV 26:17" />Ta hintena iita ayfen xeellana; hinte morketa sinthan hinte kundana; hintena ixeysati haarana; oonika yedethonna hinte baqatana.<verse eid="LEV 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 26:18" />Hessa ubbaa oothinka hinte tana si7onna ixiko, taani hinte nagaraa gisho hinte seera laapun dako oothana. <verse eid="LEV 26:18" /><verse number="19" style="v" sid="LEV 26:19" />Ta hinte otoruwa menthana; saluwa birata; sa7aa naase birata oothana. <verse eid="LEV 26:19" /><verse number="20" style="v" sid="LEV 26:20" />Hinte biittay kathi, hinte mithay ayfe immonna gisho hinte wolqay coo bessan wurana.<verse eid="LEV 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21" />Hinte taw ixas giikonne tana si7onna ixiko, hinte nagara mela laapun dako gado taani hinte bolla ehana. <verse eid="LEV 26:21" /><verse number="22" style="v" sid="LEV 26:22" />Taani hinte bolla bazzo do7ata yeddana; enti hinte nayta bonqana. Hinte meheta dhaysana; hinte taybuwa guuthana; hessa gaason hinte hemetiya ogey husatana.<verse eid="LEV 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23" />He seera ubban hinte taako simmonna ixiko, <verse eid="LEV 26:23" /><verse number="24" style="v" sid="LEV 26:24" />he wode taka hintew ixas gaana. Hinte nagaraa gisho taani ta huuphen hintena laapun dako seerana. <verse eid="LEV 26:24" /><verse number="25" style="v" sid="LEV 26:25" />Ta caaquwa hinte menthida gisho, kushe zaaranaw mashsha hinte bolla ehana. Hinte, hinte katamatan shiiqikoka, taani hinte bolla gado yeddana. Hinte, hinte morketa kushen aadhidi imetana. <verse eid="LEV 26:25" /><verse number="26" style="v" sid="LEV 26:26" />Hinte kathaa taani dhaysiya wode tammu maccasati issi beshen uythu uukana; he uythaa mizaanen shaakidi ekana; hinte hessa maana shin kalleketa.<verse eid="LEV 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27" />Ha ubban hinte tana si7onna ixikonne hinte iitatethan gujidi biiko, <verse eid="LEV 26:27" /><verse number="28" style="v" sid="LEV 26:28" />ta hinte bolla hanqon dendana. Hinte nagaraa gisho taani hintena laapun dako seerana. <verse eid="LEV 26:28" /><verse number="29" style="v" sid="LEV 26:29" />Hinte, hinte adde naytanne hinte macca nayta ashuwa maana. <verse eid="LEV 26:29" /><verse number="30" style="v" sid="LEV 26:30" />Taani, hinte dhoqa goyinno bessata dhaysana; hinte ixaane yarshiya bessaa laallana. Taani hinte aha hinte eeqata aha bolla holana; taani hintena polo ixana. <verse eid="LEV 26:30" /><verse number="31" style="v" sid="LEV 26:31" />Taani hinte katamata baysa oothana; hinte goyinno bessata dhaysana; hinte sawiya yarshuwa singike. <verse eid="LEV 26:31" /><verse number="32" style="v" sid="LEV 26:32" />Taani hinte biitta dhaysana; he biittan de7iya morketi hessan malaaletana. <verse eid="LEV 26:32" /><verse number="33" style="v" sid="LEV 26:33" />Taani hintena kawotethata giddon laallana; hinte bolla ta mashshaa shoddana. Hinte biittay baysatana; hinte katamati laaletana. <verse eid="LEV 26:33" /><verse number="34" style="v" sid="LEV 26:34" />Hinte morketa biittan de7iya wode, baysa giigidi de7iya hinte biittay ba Sambaata bonchana. He wode hinte biittay shempananne ba Sambaata bonchishe ufaytana. <verse eid="LEV 26:34" /><verse number="35" style="v" sid="LEV 26:35" />Hinte he biittan de7iya wode Sambaatatan demmiboonna shempuwa ha77i baysa gidida wode demmana.<verse eid="LEV 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LEV 26:36" />Hinte di7etidi biya wode guye attida asata wozanan yashshi yeddana; carkoy qaathiya bonco girsay enta daganthana; enti mashshafe baqatiya mela baqatana; enta oonika yedethonna kundana. <verse eid="LEV 26:36" /><verse number="37" style="v" sid="LEV 26:37" />Oonika yedethonna olape baqatiyada baqatishe, issoy issuwara dhubetidi kundana. Hinte, hinte morketa sinthan eqanaw hintew wolqi dhayana. <verse eid="LEV 26:37" /><verse number="38" style="v" sid="LEV 26:38" />Kawotethata giddon hinte dhayana; hinte morketa biittan hinte mitetidi dhayana. <verse eid="LEV 26:38" /><verse number="39" style="v" sid="LEV 26:39" />Morketa biittan attidaysati banta nagaraa gishonne banta aawata nagaraa gisho gilqidi dhayana.<verse eid="LEV 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40" />Shin enti banta nagaraanne ta bolla makallidi si7onna ixida banta aawata nagaraa paaxiko, <verse eid="LEV 26:40" /><verse number="41" style="v" sid="LEV 26:41" />ta enta ixanaadanne enta morketa biitta yedethannaada oothida banta nagaraa aggikonne enta kiitetonna wozanay simmiko, <verse eid="LEV 26:41" /><verse number="42" style="v" sid="LEV 26:42" />Taani Yayqoobara, Yisaaqaranne Abrahaamera caaqida caaquwa hassayana; enta biitta zaara qopana. <verse eid="LEV 26:42" /><verse number="43" style="v" sid="LEV 26:43" />Enta biittay baysa attana; he enti dhayin baysa gididi de7ida woden biittay Sambaata bonchishe ufaytana. Enti ta kiitaa kadhida gishonne ta wogaa leqida gisho banta nagaraa seera ekana.<verse eid="LEV 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 26:44" />Gidoshin, enti banta morketa biittan de7ida wode kumethi dhayana gakanaw entara de7iya ta caaquwa menthike; enta yeggike. Taani, Godaa enta Xoossaa. <verse eid="LEV 26:44" /><verse number="45" style="v" sid="LEV 26:45" />Taani enta Xoossaa gidanaw, kawotethati xeellishin, Gibxe biittafe kessida enta mayzatara taani caaqida caaquwa enta gisho hassayana. Taani Godaa.<verse eid="LEV 26:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46" />Goday Siina zuma bolla Muse baggara baapenne Isra7eele asaape giddon wothida wogati kiitatinne higgeti haysata.<verse eid="LEV 26:46" /></para>
  <chapter eid="LEV 26" />
  <chapter number="27" style="c" sid="LEV 27" />
  <para style="s1">Wozo Woga</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1" />Goday Museko haysada yaagis. <verse eid="LEV 27:1" /><verse number="2" style="v" sid="LEV 27:2" />Isra7eele asaas haysada yaagada oda; issi asi Godaas ase immanaw qangiko, wozo gatiya ne gammatidaysa mela he uraa gisho miishe qanxo. <verse eid="LEV 27:2" /><verse number="3" style="v" sid="LEV 27:3" />Laatamu laythafe bidi usupun tammu laythi gakanaw de7iya adde gidiko geeshsha dunkaanen eretida mizaanen usupun xeetu bira santime qanxo. <verse eid="LEV 27:3" /><verse number="4" style="v" sid="LEV 27:4" />Macca gidiko hastamu bira santime qanxo. <verse eid="LEV 27:4" /><verse number="5" style="v" sid="LEV 27:5" />Ichashu laythafe bidi laatamu laythi gakanaw de7iya adde gidiko laatamu bira santime qanxo; qassi maccas gidiko tammu bira santime qanxo. <verse eid="LEV 27:5" /><verse number="6" style="v" sid="LEV 27:6" />Issi ageenape bidi ichashu laythi gakanaw de7iya adde gidiko ichashu bira santime qanxo; qassi maccas gidiko heedzu bira santime qanxo. <verse eid="LEV 27:6" /><verse number="7" style="v" sid="LEV 27:7" />Laythi usupun tammanne iyape bolla gidida adde gidiko, tammanne ichashu bira santime; qassi maccas gidiko tammu bira santime qanxo. <verse eid="LEV 27:7" /><verse number="8" style="v" sid="LEV 27:8" />Qangida uray neeni gammatidaysa qanxanaw danda7onna manqo gidiko, I ba qangetha gathanaw immida uraa ehidi kahiniya sinthan esso; qangetida uray qanxanaw danda7eysa keena qopidi kahiney gammato.<verse eid="LEV 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9" />Issi asi Godaas yarsho oothidi immanaw qangiday mehe gidiko Godaas imetiya mehe ubbay geeshshi gidees. <verse eid="LEV 27:9" /><verse number="10" style="v" sid="LEV 27:10" />He mehiya gisho hara mehe immofo; woyko iya hara mehera laammofo. Lo77uwa iitaara woyko iitaa lo77uwara laammofo; shin I laammiko, koyro meheynne laame immida mehey nam7ayka geeshshi gido. <verse eid="LEV 27:10" /><verse number="11" style="v" sid="LEV 27:11" />Issi asi Godaas yarsho oothidi immanaw gepida mehey geeshshi gidonna ixiko, he uray he mehiya kahiniya sinthe eho. <verse eid="LEV 27:11" /><verse number="12" style="v" sid="LEV 27:12" />Lo77o gidin, iita gidin kahiney he mehiya gammato; kahiney gammatidaysi iyaw gate gido. <verse eid="LEV 27:12" /><verse number="13" style="v" sid="LEV 27:13" />Shin he mehiya goday zaaridi wozanaw koyiko, he mehiya gatiya bolla xeetape laatamu kushe gujo.<verse eid="LEV 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14" />Issi asi ba keethaa geeshshi oothidi Godaas dummayiko, lo77o gidin, iita gidin kahiney he keethaa gammato; kahiney gammatidaysi iyaw gate gido. <verse eid="LEV 27:14" /><verse number="15" style="v" sid="LEV 27:15" />Ba keethaa geeshshi oothidi Godaas dummayida uray zaaridi wozanaw koyiko, he keethaa gatiya bolla xeetape laatamu kushe gujo; simmidi keethay iyabaa gidees.<verse eid="LEV 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16" />Issi asi ba laata gadiyape shaakidi geeshshi oothidi Godaas dummayiko, he gadiya gatey iyan zeretiya zerethan gammateto. Hessika nam7u xeetanne laatamu kilo giraame banga zeriya gade gidiko, ishatamu saqile qanxo. <verse eid="LEV 27:16" /><verse number="17" style="v" sid="LEV 27:17" />I ba gadiya Ishatammantho Laytha Ba7aalepe doomidi geeshshi oothidi Godaas dummayiko, he gadiya kumetha gatiya qanxo. <verse eid="LEV 27:17" /><verse number="18" style="v" sid="LEV 27:18" />Shin I ba gadiya Ishatammantho Laytha Ba7aaley aadhin, geeshshi oothidi Godaas dummayiko, kaallidi de7iya Ishatammantho Laytha Ba7aaley gakanaw de7iya laythata kahiney taybidi, iya kumetha gatiyape wodho. <verse eid="LEV 27:18" /><verse number="19" style="v" sid="LEV 27:19" />He gadiya geeshshi oothidi Godaas dummayida uray zaaridi wozanaw koyiko, gammatetida gatiya bolla xeetape laatamu kushe gujo; simmidi gadey iyabaa gidees. <verse eid="LEV 27:19" /><verse number="20" style="v" sid="LEV 27:20" />Shin I gadiya zaaridi wozanaape sinthe hara asas bayziko, he gadiya wozanaw danda7enna. <verse eid="LEV 27:20" /><verse number="21" style="v" sid="LEV 27:21" />Ishatammantho Laytha Ba7aaley gakin gadey yedetiya wode he gadey nam7antho guye simmonna Godaas geeshshi gido; he gadey kahinetaba gidees.<verse eid="LEV 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 27:22" />Issi asi hara asape shammida gadiya geeshshi oothidi Godaas dummayanaw koyiko, <verse eid="LEV 27:22" /><verse number="23" style="v" sid="LEV 27:23" />kaalliya Ishatammantho Laytha Ba7aaley gakanaw de7iya gatiya kahiney gammatiko, uray he gallas gammatida gatiya qanxo; He miishey Godaas dummatida miishe gidana. <verse eid="LEV 27:23" /><verse number="24" style="v" sid="LEV 27:24" />Ishatammantho Laytha Ba7aaley gakiya wode he gadey koyro laatan ekidi bayzida uraas simmees.<verse eid="LEV 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 27:25" />Enta gatey geeshsha dunkaaniyan eretida mizaanen gammatetees. (Issi saqiley laatamu Geera gidees).<verse eid="LEV 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26" />Shin oonika bayra yeletida mehe Godaas dummayidi shiishanaw danda7enna; I kaseka Godaaba. Miizi woyko dorse gidin Godaaba. <verse eid="LEV 27:26" /><verse number="27" style="v" sid="LEV 27:27" />He mehey geeshshi gidonna ixiko, I gammatetida gatiya bolla ichashape issi kushe gujidi iya goday zaaridi wozo. I wozonna ixiko, gammatetida gatiyan hara asas bayzeto.<verse eid="LEV 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28" />Issi asi Godaas dummayidi immidabay ayba gidikoka, ase woyko mehe woyko iya laata gade gidin, bayzetenanne wozetenna. I dummayidaba ubbay Godaas Ubbaafe geeshshi. <verse eid="LEV 27:28" /><verse number="29" style="v" sid="LEV 27:29" />Asaa giddofe hayqana mela pirdetida asi oonika wozetofo; he uray hayqo.<verse eid="LEV 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30" />Gaden kaxida kathi woyko mitha ayfe gidin tammaafe issoy Godaaba. Hessi Godaas geeshshi. <verse eid="LEV 27:30" /><verse number="31" style="v" sid="LEV 27:31" />Issi asi ba asraata wozanaw koyiko, iya gatiya bolla xeetape laatamu kushe gujidi wozo. <verse eid="LEV 27:31" /><verse number="32" style="v" sid="LEV 27:32" />Miiza asraata woyko dorsa asraata woyko deesha asraata gidin, henthanchuwa xam7afe garsara aadhiya tammaafe issoy Godaas geeshshi. <verse eid="LEV 27:32" /><verse number="33" style="v" sid="LEV 27:33" />Tammantho mehey iita gidin, lo77o gidin dooropo; woyko iya haraara laammofo. Laammiko, koyroynne laame immida nam7ay Godaas geeshshi gidoosona; zaaridi wozanaw danda7etenna.<verse eid="LEV 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 27:34" />Siina zuma bolla Goday Muse baggara Isra7eele asaa kiitida kiitay haysa.<verse eid="LEV 27:34" /></para>
  <chapter eid="LEV 27" />
</usx>