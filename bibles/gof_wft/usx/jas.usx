<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Yayqooba Kiita</para>
  <para style="toc1">Yayqooba Kiita</para>
  <para style="toc3">Yay</para>
  <para style="toc2">Yayqooba</para>
  <para style="mt1">Yayqoobi Xaafida Kiita</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Yayqooba kiitay, ammaniya asi gallas gallas ba de7uwa kaalethiya qofata oykis. Ha kiitay xaafetiday, biitta ubban laaletida tammanne nam7u Ayhude kochatasa. Ha maxaafa xaafey, cincatethi nuuni ooson peeshiya oge bessees; ammaniya asi mokobanne lo77o kandos oge bessiya odata misileda qoncisees.</para>
  <para style="ip">Yayqooba kiitay, manqotethaba, duretethaba, paaceba, lo77o kandoba, qanaateba, ammanoba, lo77o oosoba, inxarsi haaroba, cincatethaba, ooshshaba, otoroba, ashketethaba, hara asa bolla pirdoba, ceeqetethaba, gencaba, woosabanne ammaniya asi oothanaw bessiyaba ubbaa qoridi bessees.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Sarotho <char style="ior">(<ref loc="JAS 1:1">1:1</ref>)</char></para>
  <para style="io1">Ammanonne cincatethi <char style="ior">(<ref loc="JAS 1:2-18">1:2-18</ref>)</char></para>
  <para style="io1">Sissinne kiitetethi <char style="ior">(<ref loc="JAS 1:19-27">1:19-27</ref>)</char></para>
  <para style="io1">Manqotethinne duretethi <char style="ior">(<ref loc="JAS 2:1-13">2:1-13</ref>)</char></para>
  <para style="io1">Ammanonne ooso <char style="ior">(<ref loc="JAS 2:14-26">2:14-26</ref>)</char></para>
  <para style="io1">Cincatethinne inxarsi haaroba <char style="ior">(<ref loc="JAS 3:1-18">3:1-18</ref>)</char></para>
  <para style="io1">Ha alamiyara dabotethi medhofa <char style="ior">(<ref loc="JAS 4:1-5:6">4:1—5:6</ref>)</char></para>
  <para style="io1">Danda7a, keehatethinne woosa <char style="ior">(<ref loc="JAS 5:7-20">5:7-20</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="JAS 1"/>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1"/>Xoossaanne Godaa Yesuus Kiristoosa aylley, Yayqoobi, biitta ubban laaletida tammanne nam7u sheeshatas kiitida kiita.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">Maato 13:55</ref>; <ref loc="MRK 6:3">Mar 6:3</ref>; <ref loc="ACT 15:13">Hawa 15:13</ref>; <ref loc="GAL 1:19">Gala 1:19</ref>.</char></note></para>
  <para style="p" vid="JAS 1:1">Saro, ay mela de7eetii?<verse eid="JAS 1:1"/></para>
  <para style="s1">Ammanonne Cincatethi</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2"/>Ta ishato, hintena dumma dumma paacey gakiya wode hinte lo77oba demmidaada kumetha ufaysan ekite. <verse eid="JAS 1:2"/><verse number="3" style="v" sid="JAS 1:3"/>Hinte ammanuwa paacetethay danda7a hintew immeysa ereeta. <verse eid="JAS 1:3"/><verse number="4" style="v" sid="JAS 1:4"/>Hinte wursethi gakanaw danda7iko aybi pacey bayna polonne kumethi gideta. <verse eid="JAS 1:4"/><verse number="5" style="v" sid="JAS 1:5"/>Hintefe oodeska cincatethi dhayiko Xoossaa woosso. Iyaw imetana. Xoossay oonaka boronna ubbaas keehatethan immiya Xoosse. <verse eid="JAS 1:5"/><verse number="6" style="v" sid="JAS 1:6"/>Shin I woossiya wode sidhonna ammanon Xoossaa woosso. Sidhiya oonika carkoy sugin qaaxiya abba zule mela. <verse eid="JAS 1:6"/><verse number="7-8" style="v" sid="JAS 1:7-8"/>Nam7u qofi de7eynne ba ogiyan eqonna oonika Godaape aykoka demmana gidi qopofo.<verse eid="JAS 1:7-8"/></para>
  <para style="s1">Manqo Asinne Dure Asi</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9"/>Ammaniya manqo asati, Xoossay entana dhoqu oothiya wode ufayto. <verse eid="JAS 1:9"/><verse number="10" style="v" sid="JAS 1:10"/>Qassi ammaniya dure asati Xoossay entana ziqi oothiya wode ufayto. Dure asati ciishshada dhayana.<note caller="-" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">Isa 40:6-7</ref>.</char></note> <verse eid="JAS 1:10"/><verse number="11" style="v" sid="JAS 1:11"/>Away ba mishaara keyidi maata melisin, ciishshay qoletees; iya lo77otethayka dhayees. Hessadaka, dure asati banta oosuwan daaburishe dhayana.<verse eid="JAS 1:11"/></para>
  <para style="s1">Ase Gakiya Paace</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12"/>Metuwa xoonidi aadhidaape guye, Xoossay bana siiqeysatas immana gidi qaala gelida de7o kallachaa ekana gisho, meton genciya asi anjetidaysa. <verse eid="JAS 1:12"/><verse number="13" style="v" sid="JAS 1:13"/>Oonika paacetiya wode, “Tana Xoossay paacees” goopo. Xoossay iitan paacetenna; qassi I oonaka paacenna. <verse eid="JAS 1:13"/><verse number="14" style="v" sid="JAS 1:14"/>Shin issi issi asi ba iita amuwan gooshetiya wodenne cimetiya wode paacetees. <verse eid="JAS 1:14"/><verse number="15" style="v" sid="JAS 1:15"/>Hessafe guye, amotethi qanthatidi nagara yelees; qassi nagari diccidi hayqo yelees.<verse eid="JAS 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16"/>Ta siiqo ishato, cimetofite. <verse eid="JAS 1:16"/><verse number="17" style="v" sid="JAS 1:17"/>Lo77o imoynne kumetha anjo ubbay salopenne saluwa poo7uwa medhida Xoossaa aawape yees. Xoossay kuyada ubba wode laametenna. <verse eid="JAS 1:17"/><verse number="18" style="v" sid="JAS 1:18"/>Nuuni, iya medhetethas koyro gidana mela nuna tuma qaalan ba shenen yelis.<verse eid="JAS 1:18"/></para>
  <para style="s1">Sissinne Ooso</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19"/>Ta siiqo ishato, haysa akeekite. Asi ubbay si7anaw elleso, shin odetanawunne hanqetanaw ellesopo. <verse eid="JAS 1:19"/><verse number="20" style="v" sid="JAS 1:20"/>Asa hanqoy Xoossay koyiya xillotethaa ehenna. <verse eid="JAS 1:20"/><verse number="21" style="v" sid="JAS 1:21"/>Hessa gisho, tuna hanotanne iitatetha ubbaa diggidi, Xoossay hinte wozanan tokida hinte shempuwa ashshanaw danda7iya qaala aadatethan ekite.<verse eid="JAS 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22"/>Shin Xoossaa qaala ooson peeshshitepe attishin, sissa xalaalan hintena cimmofite. <verse eid="JAS 1:22"/><verse number="23" style="v" sid="JAS 1:23"/>Qaala si7idi oothonna asi, I ba som7uwa mastooten be7iya asa mela. <verse eid="JAS 1:23"/><verse number="24" style="v" sid="JAS 1:24"/>I ba som7uwa be7idi bees, shin I ay daaniyako ellesi dogees. <verse eid="JAS 1:24"/><verse number="25" style="v" sid="JAS 1:25"/>Shin oonika aylletethafe kessiya polo higgiya akeekan be7idi, kaallidi naagey, si7idaysa dogonna ooson peeshshiya uray, ba ooso ubban anjetana.<verse eid="JAS 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26"/>Ba inxarsaa naagonna ammanayis giya uray bana cimees; iya ammanoy hada. <verse eid="JAS 1:26"/><verse number="27" style="v" sid="JAS 1:27"/>Xoossaa Aawa sinthan borey bayna geeshsha ammanoy haysa: aayiya aawu bayna naytanne am7eta maadonne alamiya tunaape bana naago.<verse eid="JAS 1:27"/></para>
  <chapter eid="JAS 1"/>
  <chapter number="2" style="c" sid="JAS 2"/>
  <para style="s1">Ase Shaakofa</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1"/>Ta ishato, hinte nu boncho Godaa Yesuus Kiristoosa ammaniyaba gidiko, asa som7o xeellidi ase bonchofite. <verse eid="JAS 2:1"/><verse number="2" style="v" sid="JAS 2:2"/>Leemisos, worqa migiddo aathidi, lo77o ma7o ma7ida dure asi hinte shiiquwa yis. Qassi curqa ma7o ma7ida manqo asika yis. <verse eid="JAS 2:2"/><verse number="3" style="v" sid="JAS 2:3"/>Lo77o ma7o ma7ida addiya hinte aathidi bonchidi, “Ne haysan lo77iya oydiyan utta” gidi, qassi manqo addiya, “Ne yan eqa woyko haysan ta tohuwa matan sa7an utta” geeta. <verse eid="JAS 2:3"/><verse number="4" style="v" sid="JAS 2:4"/>Yaatin, hinte, hinte giddon shaaketethi medheysatanne iita qofara de7iya daynnata mela gideketiyee?<verse eid="JAS 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5"/>Ta siiqo ishato, si7ite. Ammanon dure gidana melanne bana siiqeysatas immana gida salo kawotethaa laattana mela ha sa7an de7iya manqota Xoossay dooribeneyee? <verse eid="JAS 2:5"/><verse number="6" style="v" sid="JAS 2:6"/>Shin hinte manqota toocheta. Hintena un7etheysati dureta gidokonaayee? Hintena daynna sinthe goocheysati enta gidokonaayee? <verse eid="JAS 2:6"/><verse number="7" style="v" sid="JAS 2:7"/>Hinte xeegetida lo77o Godaa sunthaa cayeysati enta gidokonaayee?<verse eid="JAS 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8"/>Shin Geeshsha Maxaafan, “Ase ubbaa nena ne doseysada dosa” geetetidi xaafetida Xoossaa kawotethaa higgiya hinte poliko lo77o ootheeta.<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Leewe 19:18</ref>.</char></note> <verse eid="JAS 2:8"/><verse number="9" style="v" sid="JAS 2:9"/>Shin hinte asa som7o xeellidi bonchiko, nagara ootheeta qassi higgey hintena higge menthida asada pirdana. <verse eid="JAS 2:9"/><verse number="10" style="v" sid="JAS 2:10"/>Oonika higge ubbaafe issuwa menthidi, attida ubbaa naagiko ubbaa menthidaada taybetees. <verse eid="JAS 2:10"/><verse number="11" style="v" sid="JAS 2:11"/>“Laammofa” gida Goday, qassi “Wodhopa” gis. Shin neeni laammonna aggada wodhidaba gidiko, higgiya menthadasa.<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">Kessa 20:13-14</ref>; <ref loc="DEU 5:17-18">Zaare 5:17-18</ref>.</char></note> <verse eid="JAS 2:11"/><verse number="12" style="v" sid="JAS 2:12"/>Aylletethafe kessiya higgiya sinthan pirda ekanaw de7iya asada odetitenne oothite. <verse eid="JAS 2:12"/><verse number="13" style="v" sid="JAS 2:13"/>Ase maaronna oonaka Xoossay maaronna pirdana. Shin maarotethay pirdaa xoonees.<verse eid="JAS 2:13"/></para>
  <para style="s1">Ammanonne Ooso</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14"/>Ta ishato, hintefe issi asi taw ammanoy de7ees gidi, ba ammanuwa ooson bessonna ixiko iya ay maaddanee? Iya ammanoy iya ashshanaw danda7ii? <verse eid="JAS 2:14"/><verse number="15" style="v" sid="JAS 2:15"/>Leemisos issi ishay woyko issi michiya kallotikonne entaw miyabay dhayiko, <verse eid="JAS 2:15"/><verse number="16" style="v" sid="JAS 2:16"/>hintefe issi asi entako, “Saro biite! Tama kayite! Kallidi miite!” gidi, koshshiyaba entaw immonna ixiko enta ay maaddii? <verse eid="JAS 2:16"/><verse number="17" style="v" sid="JAS 2:17"/>Hessa gisho, oosoy bayna ammanoy barka hayqidaysa.<verse eid="JAS 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18"/>Shin issi asi, “New ammanoy de7ees; qassi taw oosoy de7ees. Neeni ne ammanuwa ne oosuwape shaakada tana bessa; taka ta ammanuwa ta oosuwan nena bessaana” gaana. <verse eid="JAS 2:18"/><verse number="19" style="v" sid="JAS 2:19"/>Neeni, issi Xoossay de7eysa ammanaasa; hessi lo77o. Tuna ayyaanatika ammanoosona; yashshan kokoroosona. <verse eid="JAS 2:19"/><verse number="20" style="v" sid="JAS 2:20"/>Neno eeyaw! Ammanoy oosope shaaketidi maaddonnaysa eranaw koyay? <verse eid="JAS 2:20"/><verse number="21" style="v" sid="JAS 2:21"/>Nu aawa Abrahaamey, ba na7aa Yisaaqa yarsho bessa bolla wothida wode ba oosuwan xillibeennee?<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">Medhe 22:1-14</ref>.</char></note> <verse eid="JAS 2:21"/><verse number="22" style="v" sid="JAS 2:22"/>Iya ammanoynne iya oosoy issife oothidaysa be7ikii? Iya ammanoy iya oosuwan poletis. <verse eid="JAS 2:22"/><verse number="23" style="v" sid="JAS 2:23"/>Geeshsha Maxaafay, “Abrahaamey Xoossaa ammanis. Xoossay hessa iyaw xillotethi oothidi taybis” gidaysi poletis. Qassi I Xoossaa dabbo geetetidi xeegetis.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">Medhe 15:6</ref>; <ref loc="2CH 20:7">2 Taari 20:7</ref>; <ref loc="ISA 41:8">Isa 41:8</ref>.</char></note> <verse eid="JAS 2:23"/><verse number="24" style="v" sid="JAS 2:24"/>Asi ammano xalaalan gidonashin, ooson xilleysa be7aasa.<verse eid="JAS 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25"/>Hessadaka, laymiya Ra7aaba Isra7eelepe kiitetidaysata mokada hara ogera enta moyzida wode ba oosuwan xillabeekee?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">Iyya 2:1-21</ref>.</char></note><verse eid="JAS 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26"/>Shempoy shaaketida asatethay hayqo gideysada, oosoy shaaketida ammanoyka hayqidaysa.<verse eid="JAS 2:26"/></para>
  <chapter eid="JAS 2"/>
  <chapter number="3" style="c" sid="JAS 3"/>
  <para style="s1">Ne Inxarsa Naaga</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1"/>Ta ishato, hintefe daroti astamaare gidopo. Nu, astamaareti haratape aadhiya pirdaa ekanaysa hinte ereeta. <verse eid="JAS 3:1"/><verse number="2" style="v" sid="JAS 3:2"/>Nu ubbay daroban baletoos. Ba odan baletonna oonika banatetha naaganaw danda7iya polo asi. <verse eid="JAS 3:2"/><verse number="3" style="v" sid="JAS 3:3"/>Parati nuus kiitetana mela bixaala barsidi nuuni koyiya bessi ubbaa efoos. <verse eid="JAS 3:3"/><verse number="4" style="v" sid="JAS 3:4"/>Markabey hessa mela gita gidishe wolqaama carkuwan sugetikoka, enta laaggeysi ba koyiya bessi zaaridi laagiya guutha mithan laagetidi bees. <verse eid="JAS 3:4"/><verse number="5" style="v" sid="JAS 3:5"/>Hessada inxarsi asatethaa giddon guutha gidikoka daro gitaban ceeqetees.</para>
  <para style="p" vid="JAS 3:5">Guutha tami daro gita wora xuuggees. <verse eid="JAS 3:5"/><verse number="6" style="v" sid="JAS 3:6"/>Inxarsi tama mela. Inxarsi nu asatethaa giddon iitan kumida alame; asatethaa ubbaa tunisees. Gaannamepe keyiya tamada nu de7uwa wotha ubbaa xuuggees. <verse eid="JAS 3:6"/><verse number="7" style="v" sid="JAS 3:7"/>Do7atanne kafota, ulora goosheteysatanne abban de7iya medhetethata ubbaa asi haarees; entika haaretidosona. <verse eid="JAS 3:7"/><verse number="8" style="v" sid="JAS 3:8"/>Shin oonika inxarsi haaranaw danda7ibeenna. Inxarsi wodhiya marzey kumida haaretonna iita medhetethi. <verse eid="JAS 3:8"/><verse number="9" style="v" sid="JAS 3:9"/>Nu inxarsan, nu, Godaanne Xoossaa galatoos. Qassi iyara Xoossaa leemison Medhetida asaa baaddoos. <verse eid="JAS 3:9"/><verse number="10" style="v" sid="JAS 3:10"/>Issi doonape galatinne baadethi keyees. Ta ishato, hessada hananaw bessenna.<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="GEN 1:26">Medhe 1:26</ref>.</char></note> <verse eid="JAS 3:10"/><verse number="11" style="v" sid="JAS 3:11"/>Pultoy issi ollafe mal7iya haathinne cammiya haathi pultanaw danda7ii? <verse eid="JAS 3:11"/><verse number="12" style="v" sid="JAS 3:12"/>Ta ishato, balase mithi shamaho ayfanaw danda7ii? Woyko woyne mithi balase mitha ayfe ayfanaw danda7ii? Camo haathaafe mal7o haathi keyanaw danda7enna.<verse eid="JAS 3:12"/></para>
  <para style="s1">Salo Cincatethinne Sa7a Cincatethi</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13"/>Hinte giddon cincinne akeekanchoy oonee? Ba lo77o de7uwa, ashketethaninne cincatethan oosetida ooson besso. <verse eid="JAS 3:13"/><verse number="14" style="v" sid="JAS 3:14"/>Shin hinte wozanan cammiya qinaateynne bana dosoy de7iko ceeqetofite; tumaa bolla wordotopite. <verse eid="JAS 3:14"/><verse number="15" style="v" sid="JAS 3:15"/>Hessa mela cincatethay salope yidaba gidonashin, hessi asaba, alameba, xalaheba. <verse eid="JAS 3:15"/><verse number="16" style="v" sid="JAS 3:16"/>Qinaateynne bana dosoy de7iya son ooshshinne iita ooso ubbay de7oosona. <verse eid="JAS 3:16"/><verse number="17" style="v" sid="JAS 3:17"/>Shin bollafe yaa cincatethay ubbaafe sinthe geeshshi. Qassi sarotethi, aadatethi, si7idi ekeysa, qadheteysa, lo77o ayfey kumidaysa, ase shaakonnaysanne cubbotethi baynaysa. <verse eid="JAS 3:17"/><verse number="18" style="v" sid="JAS 3:18"/>Sarotethaa doseysati sarotethi zeridi xillotethi buucosona.<verse eid="JAS 3:18"/></para>
  <chapter eid="JAS 3"/>
  <chapter number="4" style="c" sid="JAS 4"/>
  <para style="s1">Alamiyara Dabotopite</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1"/>Ooshshinne oli hinte giddo awupe yii? Enti yey hinte asatethaa haaranaw oletiya hinte asho amuwape gidenneyee? <verse eid="JAS 4:1"/><verse number="2" style="v" sid="JAS 4:2"/>Hinte amotteeta, shin demmeketa; hessa gisho, wodheeta. Minthi koyeeta, shin demmanaw danda7eketa; hessa gisho, ooyeteetanne oleteeta. Hinte Xoossaa woossonna gisho koyaba demmeketa. <verse eid="JAS 4:2"/><verse number="3" style="v" sid="JAS 4:3"/>Hinte woosseta, shin demmeketa. Hinte asho amuwa polanaw wobbe ogen woossiya gisho demmeketa. <verse eid="JAS 4:3"/><verse number="4" style="v" sid="JAS 4:4"/>Hinteno, laymateysato! Ha alamiya dosey Xoossara morke gideysa ereketii? Ha alamiyara dabbotanaw koyey oonika Xoossara morke. <verse eid="JAS 4:4"/><verse number="5" style="v" sid="JAS 4:5"/>Geeshsha Maxaafay, “Xoossay nunan daana mela oothida Ayyaanay, nuuni iyaw buzo gidana mela amottees” gidaysa coo gidaba daanii? <verse eid="JAS 4:5"/><verse number="6" style="v" sid="JAS 4:6"/>Shin Geeshsha Maxaafay, “Xoossay otoranchota ixees, shin bantana ashketas maarotethi immees” giya gisho, Xoossay maarotethi darsidi immees.<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">Leemi 3:34</ref>.</char></note><verse eid="JAS 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7"/>Hessa gisho, Xoossaas haaretite; Xalahiyara eqetite; I hintefe haakana. <verse eid="JAS 4:7"/><verse number="8" style="v" sid="JAS 4:8"/>Xoossaako shiiqite; I hinteko shiiqana. Hinteno, nagaranchoto, hinte kushiya meecetite; nam7u qofi de7eysato, hinte wozanaa geeshshite. <verse eid="JAS 4:8"/><verse number="9" style="v" sid="JAS 4:9"/>Kayotite, yeekitenne afuxite. Hinte miichay yeehon, hinte ufaysay azzanon laameto. <verse eid="JAS 4:9"/><verse number="10" style="v" sid="JAS 4:10"/>Godaa sinthan hintenatethaa kawushite; hintena dhoqu dhoqu oothana.<verse eid="JAS 4:10"/></para>
  <para style="s1">Asa Bolla Pirdofite</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11"/>Ta ishato, issoy issuwa zigiropite. Ba ishaa zigireynne iya bolla pirdey higge zigiresinne higge bolla pirdees. Neeni higge bolla pirdiko higge bolla pirdeysa gidaasape attishin, higge poleysa gidaka. <verse eid="JAS 4:11"/><verse number="12" style="v" sid="JAS 4:12"/>Higge immeynne pirdey Xoossaa xalaala. Ashshanawunne dhaysanaw danda7ey iya. Yaatin, ne asa bolla pirdey neeni oonee?<verse eid="JAS 4:12"/></para>
  <para style="s1">Ceeqetofite</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13"/>Hinte, “Nuuni hachi woyko wonto ya katamaa woyko ha katamaa baana; yan laythi uttana; zal7idi wodhisana” yaageysato, si7ite.<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="PRO 27:1">Leemi 27:1</ref>.</char></note> <verse eid="JAS 4:13"/><verse number="14" style="v" sid="JAS 4:14"/>Wonto aybi hananeeko hinte ereketa. Hinte de7oy waananeko erey oonee? Hinte guutha wode bentidi dhayiya aka mela. <verse eid="JAS 4:14"/><verse number="15" style="v" sid="JAS 4:15"/>Hessa aggidi, “Goday giiko nuuni daana; haysa woyko hessa oothana” yaaganaw bessees. <verse eid="JAS 4:15"/><verse number="16" style="v" sid="JAS 4:16"/>Shin hinte ha77i otortetanne ceeqeteta. Hessa mela ceeqo ubbay iita.<verse eid="JAS 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17"/>Hessa gisho, lo77oba oothanaw erishe oothonna uraas hessi nagara.<verse eid="JAS 4:17"/></para>
  <chapter eid="JAS 4"/>
  <chapter number="5" style="c" sid="JAS 5"/>
  <para style="s1">Duretas Imetida Zore</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1"/>Hinteno, dureto, hinte bolla iita metoy yaa gisho yeekitenne zeleelite. <verse eid="JAS 5:1"/><verse number="2" style="v" sid="JAS 5:2"/>Hinte shaloy buuqis; hinte afilayka bilan meetetis.<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 6:19">Maato 6:19</ref>.</char></note> <verse eid="JAS 5:2"/><verse number="3" style="v" sid="JAS 5:3"/>Hinte worqaynne hinte biray shi7is. He shi7ay hinte bolla marka gidana. I hinte asatethaa tamada maana. Hinte ha wurida qammatan hintew shalo dagayeeta. <verse eid="JAS 5:3"/><verse number="4" style="v" sid="JAS 5:4"/>Hinte gaden oothi pee7ida asaa une miishiya qanxibeketa. Hessi hinte bolla waassees. He asata waasoy wolqaama Godaa haythan si7etis.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">Zaare 24:14-15</ref>.</char></note> <verse eid="JAS 5:4"/><verse number="5" style="v" sid="JAS 5:5"/>Ha sa7an hinte ulo xalaalas qopidi, injen de7ideta. Shukas giigetida meheda hintena dhiikideta. <verse eid="JAS 5:5"/><verse number="6" style="v" sid="JAS 5:6"/>Hintera eqetanaw danda7onna xillo asa bolla pirdideta iya wodhideta.<verse eid="JAS 5:6"/></para>
  <para style="s1">Gencanne Woosa</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7"/>Ta ishato, Goday yaana gakanaw gencite. Goshshanchoy torche iraynne sila iray yaana gakanaw gencidi al7o kathaa naagidi waati gathi ekiyako qopite. <verse eid="JAS 5:7"/><verse number="8" style="v" sid="JAS 5:8"/>He goshshanchuwada hinteka gencite. Godaa yuussay matatida gisho ufaysan naagite.<verse eid="JAS 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9"/>Ta ishato, Xoossay hinte bolla pirdonna mela issoy issuwa bolla zuuzumofite. Pirdeysi pengen eqis. <verse eid="JAS 5:9"/><verse number="10" style="v" sid="JAS 5:10"/>Ta ishato, waayan gencida, Godaa sunthan odida nabeta leemiso oothidi ekite. <verse eid="JAS 5:10"/><verse number="11" style="v" sid="JAS 5:11"/>Danda7an gencidaysata nuuni anjetidaysata goos. Iyyobi waanidi gencidaako hinte si7ideta. Goday wursethan iya waati maaddidaako be7ideta. I maarotinne qadhey kumida Godaa gidiya gisho hessa oothis.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">Iyyo 1:21-22</ref>; <ref loc="JOB 2:10">2:10</ref>; <ref loc="PSA 103:8">Maz 103:8</ref>.</char></note><verse eid="JAS 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12"/>Shin ubbaafe sinthe, ta ishato, saluwan gidin woyko sa7an gidin woyko hara aybinka caaqofite. Xoossaa pirdan hinte gelonnaada hinte oday ee gidiko, “Ee” giite; akay gidiko, “Akay” giite.<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">Maato 5:34-37</ref>.</char></note><verse eid="JAS 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13"/>Hinte giddon meto ekiya oonika de7iko Xoossaa woosso. Ufaytiya oonika de7iko galatan yexo. <verse eid="JAS 5:13"/><verse number="14" style="v" sid="JAS 5:14"/>Hintefe hargetiya oonika de7iko woosa keetha cimata xeego. Enti Godaa sunthan shamaho zayte tiyidi iyaw Xoossaa woosso.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">Maato 5:34-37</ref>.</char></note> <verse eid="JAS 5:14"/><verse number="15" style="v" sid="JAS 5:15"/>Ammanon woossida woosay harganchuwa pathana. Goday iya, hargiyafe denthana; I nagara oothidaba gidikoka Goday iya maarana. <verse eid="JAS 5:15"/><verse number="16" style="v" sid="JAS 5:16"/>Hessa gisho, hinte paxana mela hinte nagara issoy issuwas paaxitenne issoy issuwas woossite. Xillo asa woosay wolqaama ooso oothees. <verse eid="JAS 5:16"/><verse number="17" style="v" sid="JAS 5:17"/>Eeliyaasi nu mela ase. Iri sa7an bukonna mela minthidi Xoossaa woossin heedzu laythinne usupun ageena sa7an iri bukibeenna.<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 Kawo 17:1</ref>; <ref loc="1KI 18:1">18:1</ref>.</char></note> <verse eid="JAS 5:17"/><verse number="18" style="v" sid="JAS 5:18"/>Zaaridi I Xoossaa woossin salope iri bukis; sa7ika kathi dolisees.<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1 Kawo 18:42-45</ref>.</char></note><verse eid="JAS 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19"/>Ta ishato, hintefe oonika tuma ogiyape buutiko, haray iya tumaako zaariko, <verse eid="JAS 5:19"/><verse number="20" style="v" sid="JAS 5:20"/>nagaranchuwa iya bala ogiyape zaariya oonika, iya shempuwa hayqope ashsheysanne iya daro nagaraas maarota immeysa ero.<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">Leemi 10:12</ref>; <ref loc="1PE 4:8">1 Phex 4:8</ref>.</char></note><verse eid="JAS 5:20"/></para>
  <chapter eid="JAS 5"/>
</usx>
