<?xml version="1.0" encoding="UTF-8"?>
<usx version="2.6">
  <book code="JAS" style="id">- Goofa</book>
  <para style="h">Yayqooba</para>
  <para style="toc3">Yay</para>
  <para style="toc2">Yayqooba</para>
  <para style="toc1">Yayqoobi Xaafida Kiitaa</para>
  <para style="mt">Yayqoobi Xaafida Kiitaa</para>
  <para style="imt">Gaatha Qofaa</para>
  <para style="ip">Yayqooba kiitay, ammaniyaa asi gallas gallas ba de7uwa kaalethiya qofata oykkis. Ha kiitay xaafettiday, biitta ubban laalettida tammanne nam77u Ayhude zerethaassa. Ha maxaafaa xaafey, cinccatethi nuuni ooson peeshshiya hiillaa, ammaniyaa asaa mokobaanne lo77o kanddos oge bessiya odata misileda qonccisees.</para>
  <para style="ip">Yayqooba kiitay, Manqotethabaa, duretethabaa, paacebaa, lo77o kanddobaa, qanaatebaa, ammanobaa, lo77o oosobaa, inxarssa haarobaa, cinccatethabaa, issoy issuwara ooshshabaa, otorobaa, ashkketethabaa, hara asa bolla pirddabaa, ceeqetethabaa, genccabaa, woosabaanne ammaniyaa asi oothanaw bessiyabaa ubbaa qoridi xaafis.</para>
  <para style="ip">Yayqooba kiitay, ammano de7on ammanoy ooson pee7iya hanotata qonccisidi bessees.</para>
  <para style="iot">Yayqooba kiitaa ayfe qofata</para>
  <para style="io1">Sarotho 1:1</para>
  <para style="io1">Ammanonne cinccatethi 1:2-8</para>
  <para style="io1">Manqotethinne duretethi 1:9-11</para>
  <para style="io1">Paace 1:12-18</para>
  <para style="io1">Xoossaa qaala sissinne ooson peesho 1:19-27</para>
  <para style="io1">Ase asappe dummayo koshshonayssa 2:1-13</para>
  <para style="io1">Ammanonne ooso 2:14-26</para>
  <para style="io1">Inxarssi haarobaa 3:1-18</para>
  <para style="io1">Ammaniya asinne ha alamiya 4:1-5:6</para>
  <para style="io1">Dumma dumma zoreta 5:7-20</para>
  <para style="ie"/>
  <chapter number="1" style="c"/>
  <para style="p">
    <verse number="1" style="v"/>Xoossaanne Godaa Yesuus Kiristtoosa aylley, Yayqoobi, biitta ubban laalettida tammanne nam77u sheeshatas kiittida kiita.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="MAT 13:55">Maato 13:55</ref>; <ref loc="MRK 6:3">Mar 6:3</ref>; <ref loc="ACT 15:13">Ha@O 15:13</ref>; <ref loc="GAL 1:19">Gala 1:19</ref></char></note></para>
  <para style="p">Saro, ay mela de7eetii?</para>
  <para style="s">Ammanonne cinccatethi</para>
  <para style="p">
    <verse number="2" style="v"/>Ta ishato, hinttena dumma dumma paacey gakkiya wode hintte lo77obaa demmidaada kumetha ufayssan ekkite. <verse number="3" style="v"/>Hintte ammanuwa paacetethay dandda7a hinttew immeyssa ereeta. <verse number="4" style="v"/>Hintte wurssethi gakkanaw dandda7ikko aybi pacey baynna polonne kumethi gideta. <verse number="5" style="v"/>Hinttefe oodeskka cinccatethi dhayikko Xoossaa woosso. Iyaw imettana. Xoossay oonakka boronna ubbaas keehatethan immiya Xoosse. <verse number="6" style="v"/>Shin I woossiya wode sidhonna ammanon Xoossaa woosso. Sidhiya oonikka carkkoy sugin qaaxxiya abbaa zule mela. <verse number="7-8" style="v"/>Nam77u qofi de7eynne ba ogiyan eqqonna oonikka Godaappe aykkoka demmana gidi qoppofo.</para>
  <para style="s">Manqo asaanne dure asaa</para>
  <para style="p">
    <verse number="9" style="v"/>Ammaniya manqo asati, Xoossay enttana dhoqqu oothiya wode ufaytto. <verse number="10" style="v"/>Qassi ammaniyaa dure asati Xoossay enttana ziqqi oothiya wode ufaytto. Dure asati ciishshada dhayana.<note caller="-" style="x"><char style="xo" closed="false">1:10-11 </char><char style="xt" closed="false"><ref loc="ISA 40:6-7">Isa 40:6-7</ref></char></note> <verse number="11" style="v"/>Away ba mishaara keyidi maataa melisin, ciishshay serees; iya lo77otethayka dhayees. Hessadakka, dure asati bantta oosuwan daaburishe dhayana.</para>
  <para style="s">Ase gakkiya paaciya</para>
  <para style="p">
    <verse number="12" style="v"/>Metuwa xoonidi aadhdhidaappe guye, Xoossay bana siiqeyssatas immana gidi qaala gelida de7o kallachcha ekkana gisho, meton gencciya asi anjjettidayssa. <verse number="13" style="v"/>Oonikka paacettiya wode, “Tana Xoossay paaces” gooppo. Xoossay iitan paacettenna; qassi I oonakka paaccenna. <verse number="14" style="v"/>Shin issi issi asi ba iita amuwaan gooshettiya wodenne cimettiya wode paacettees. <verse number="15" style="v"/>Hessafe guye, amotethi qanthattidi nagara yelees; qassi nagari diccidi hayqo yelees.</para>
  <para style="p">
    <verse number="16" style="v"/>Ta siiqo ishato, cimettofite. <verse number="17" style="v"/>Lo77o imoynne kumetha anjjo ubbay saloppenne saluwa poo7uwa medhdhida Xoossaa aawappe yees. Xoossay kuyada ubba wode laamettenna. <verse number="18" style="v"/>Nuuni, iya medhetethaas koyro gidana mela nuna tuma qaalan ba shenen yelis.</para>
  <para style="s">Sissinne ooso</para>
  <para style="p">
    <verse number="19" style="v"/>Ta siiqo ishato, hayssa akeekite. Asi ubbay si7anaw elleso, shin odettanawunne hanqettanaw ellesoppo. <verse number="20" style="v"/>Asa hanqoy Xoossay koyaa xillotethaa ehenna. <verse number="21" style="v"/>Hessa gisho, tuna hanotanne iitatetha ubbaa diggidi, Xoossay hintte wozanan tokkida hintte shemppuwa ashshanaw dandda7iya qaala aadatethan ekkite.</para>
  <para style="p">
    <verse number="22" style="v"/>Shin Xoossaa qaala ooson peeshshiteppe attin sissa xalaalan hinttena cimmofite. <verse number="23" style="v"/>Qaalaa si7idi oothonna asi, I ba som77uwa masttoten be7iya asa mela. <verse number="24" style="v"/>I ba som77uwa be7idi bees, shin I ay daaniyakko ellesi dogees. <verse number="25" style="v"/>Shin oonikka aylletethafe kessiya polo higgiya akeekan be7idi, kaallidi naagey, si7idayssa dogonna ooson peeshshiya uray, ba ooso ubban anjjettana.</para>
  <para style="p">
    <verse number="26" style="v"/>Ba inxarssaa naagonna ammanays giya uray bana cimmees; iya ammanoy hada. <verse number="27" style="v"/>Xoossaa Aawa sinthan borey baynna geeshsha ammanoy hayssa: aaya aawu baynna naytanne am77eta maadonne alamiya tunaappe bana naago.</para>
  <chapter number="2" style="c"/>
  <para style="s">Ase shaakkofa</para>
  <para style="p">
    <verse number="1" style="v"/>Ta ishato, hintte nu bonchcho Godaa Yesuus Kiristtoosa ammaniyabaa gidikko, asa som77o xeellidi ase bonchchofite. <verse number="2" style="v"/>Leemisos, worqqa migiddo aathidi, lo77o ma7o ma77ida dure asi hintte shiiquwa yis. Qassi curqqa ma7o ma77ida manqo asikka yis. <verse number="3" style="v"/>Lo77o ma7o ma77ida addiya hintte aathi bonchchidi, “Ne hayssan lo77iya oydiyan utta” gidi, qassi manqo addiya, “Ne yan eqqa woykko hayssan ta tohuwa matan sa7an utta” geeta. <verse number="4" style="v"/>Yaatin, hinttee, hintte giddon shaaketethi medhdheyssatanne iita qofara de7iya daynnata mela gidekketiyye?</para>
  <para style="p">
    <verse number="5" style="v"/>Ta siiqo ishato, si7ite. Ammanon dure gidana melanne bana siiqeyssatas immana gida salo kawotethaa laattana mela ha sa7an de7iya manqota Xoossay dooribeenneyye? <verse number="6" style="v"/>Shin hintte manqota toochcheeta. Hinttena un77etheyssati dureta gidokkonaayye? Hinttena daynna sinthi goochcheyssati entta gidokkonaayye? <verse number="7" style="v"/>Hintte xeegettida lo77o Godaa sunthaa cayeyssati entta gidokkonaayye?</para>
  <para style="p">
    <verse number="8" style="v"/>Shin Geeshsha Maxaafan, “Ase ubbaa nena ne doseyssada dosa” geetettidi xaafettida Xoossaa kawotethaa higgiya hintte polikko lo77o ootheeta.<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Leewe 19:18</ref></char></note> <verse number="9" style="v"/>Shin hintte asa som77o xeellidi bonchchiko, nagara ootheeta qassi higgey hinttena higge menthida asada pirddana. <verse number="10" style="v"/>Oonikka higge ubbaafe issuwa menthidi, attida ubbaa naagikko ubbaa menthidaada taybettees. <verse number="11" style="v"/>“Laammofa” gida Goday, qassi “Wodhoppa” gis. Shin neeni laammonna aggada wodhidabaa gidikko, higgiya menthadasa.<note caller="-" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="EXO 20:13-14">Kessa 20:13-14</ref>; <ref loc="DEU 5:17-18">Zaare 5:17-18</ref></char></note> <verse number="12" style="v"/>Aylletethafe kessiya higgiya sinthan pirdda ekkanaw de7iya asada odetitenne oothite. <verse number="13" style="v"/>Ase maaronna oonakka Xoossay maaronna pirddana. Shin maarotethay pirddaa xoonees.</para>
  <para style="s">Ammanonne ooso</para>
  <para style="p">
    <verse number="14" style="v"/>Ta ishato, hinttefe issi asi taw ammanoy de7ees gidi, ba ammanuwa ooson bessonna ixxiko iya ay maaddanee? Iya ammanoy iya ashshanaw dandda7ii? <verse number="15" style="v"/>Leemisos issi ishay woykko issi michchiya kallotikonne enttaw miyabay dhayikko, <verse number="16" style="v"/>hinttefe issi asi enttako, “Saro biite! Tama kayite! Kallidi miite!” gidi, koshshiyabaa enttaw immonna ixxiko entta ay maaddii? <verse number="17" style="v"/>Hessa gisho, oosoy baynna ammanoy barkka hayqqidayssa.</para>
  <para style="p">
    <verse number="18" style="v"/>Shin issi asi, “New ammanoy de7ees; qassi taw oosoy de7ees. Neeni ne ammanuwa ne oosuwappe shaakkada tana bessa; takka ta ammanuwa ta oosuwan nena bessana” gaana. <verse number="19" style="v"/>Neeni, issi Xoossay de7eyssa ammanaasa; hessi lo77o. Tuna ayyaanatikka ammanoosona; yashshan kokkorosona. <verse number="20" style="v"/>Neno eeyaw! Ammanoy oosoppe shaakettidi maaddonnayssa eranaw koyay? <verse number="21" style="v"/>Nu aawa Abrahamey, ba na7aa Yisaaqa yarshsho bessaa bolla wothida wode ba oosuwan xillibeenne?<note caller="-" style="x"><char style="xo" closed="false">2:21 </char><char style="xt" closed="false"><ref loc="GEN 22:1-14">Medhe 22:1-14</ref></char></note> <verse number="22" style="v"/>Iya ammanoynne iya oosoy issife oothidayssa be7ikki? Iya ammanoy iya oosuwan polettis. <verse number="23" style="v"/>Geeshsha Maxaafay, “Abrahamey Xoossaa ammanis. Xoossay hessa iyaw xillotethi oothidi taybis” gidayssi polettis. Qassi I Xoossaa dabbo geetettidi xeegettis.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 15:6">Medhe 15:6</ref>; <ref loc="2CH 20:7">2Taari 20:7</ref>; <ref loc="ISA 41:8">Isa 41:8</ref></char></note> <verse number="24" style="v"/>Asi ammano xalaalan gidonnashin, ooson xilleyssa be7aasa.</para>
  <para style="p">
    <verse number="25" style="v"/>Hessadakka, laymiya Ra7aaba Isra7eeleppe kiitettidayssata mokkada hara ogera entta moyzida wode ba oosuwan xillabeekke?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="JOS 2:1-21">Iya 2:1-21</ref></char></note></para>
  <para style="p">
    <verse number="26" style="v"/>Shemppoy shaakettida asatethay hayqo gideyssada, oosoy shaakettida ammanoykka hayqqidayssa.</para>
  <chapter number="3" style="c"/>
  <para style="s">Inxarssi naago</para>
  <para style="p">
    <verse number="1" style="v"/>Ta ishato, hinttefe daroti asttamaare gidoppo. Nu, asttamaareti haratappe aadhdhiya pirddaa ekkanayssa hintte ereeta. <verse number="2" style="v"/>Nu ubbay daroban balettoos. Ba odan balettonna oonikka banatethaa naaganaw dandda7iya polo asi. <verse number="3" style="v"/>Parati nuus kiitettana mela bixaala barssidi nuuni koyaa bessi ubbaa efoos. <verse number="4" style="v"/>Markkabey hessa mela gita gidishe wolqqaama carkkuwan sugettikokka, entta laaggeyssi ba koyaa bessi zaaridi laaggiya guutha mithan laagettidi bees. <verse number="5" style="v"/>Hessada inxarssi asatethaa giddon guutha gidikkoka daro gitaban ceeqettees.</para>
  <para style="p">Guutha tami daro gita woraa xuuggees. <verse number="6" style="v"/>Inxarssi tama mela. Inxarssi nu asatethaa giddon iitan kumida alame; asatetha ubbaa tunisees. Gaannameppe keyaa tamada nu de7uwa wotha ubbaa xuuggees. <verse number="7" style="v"/>Do7atanne kafota, ulora gooshetteyssatanne abban de7iya medhetethata ubbaa asi haarees; enttika haarettidosona. <verse number="8" style="v"/>Shin oonikka inxarssi haaranaw dandda7ibeenna. Inxarssi wodhiya marzey kumida haarettonna iita medhetethi. <verse number="9" style="v"/>Nu inxarssan, nu, Godaanne Xoossaa galatoos. Qassi iyara Xoossaa leemison Medhettida asaa qanggoos. <verse number="10" style="v"/>Issi doonappe galatinne qanggethi keyees. Ta ishato, hessada hananaw bessenna.<note caller="-" style="x"><char style="xo" closed="false">3:9-10 </char><char style="xt" closed="false"><ref loc="GEN 1:26">Medhe 1:26</ref></char></note> <verse number="11" style="v"/>Pulttoy issi ollaafe mal7iya haathinne cammiya haathi pulttanaw dandda7ii? <verse number="12" style="v"/>Ta ishato, balase mithi shamaho ayfanaw dandda7ii? Woykko woyne mithi balase mitha ayfe ayfanaw dandda7ii? Camo haathafe mal7o haathi keyanaw dandda7enna.</para>
  <para style="s">Salo cinccatethaanne sa7a cinccatethaa</para>
  <para style="p">
    <verse number="13" style="v"/>Hintte giddon cinccinne akeekanchchoy oonee? Ba lo77o de7uwa, ashkketethaninne cinccatethan oosettida ooson besso. <verse number="14" style="v"/>Shin hintte wozanan cammiya qanaateynne bana dosoy de7ikko ceeqettofite; tumaa bolla worddotoppite. <verse number="15" style="v"/>Hessa mela cinccatethay saloppe yidabaa gidonnashin, hessi asabaa, alamebaa, xalahebaa. <verse number="16" style="v"/>Qanaateynne bana dosoy de7iya son ooshshinne iita ooso ubbay de7oosona. <verse number="17" style="v"/>Shin bollafe yaa cinccatethay ubbaafe sinthe geeshshi. Qassi sarotethi, aadatethi, si7idi ekkeyssa, qadhetteyssa, lo77o ayfey kumidayssa, ase shaakkonnayssanne cubbotethi baynnayssa. <verse number="18" style="v"/>Sarotethaa doseyssati sarotethi zeridi xillotethi buuccosona.</para>
  <chapter number="4" style="c"/>
  <para style="s">Ha alamiyara dabbotoppite</para>
  <para style="p">
    <verse number="1" style="v"/>Ooshshinne oli hintte giddo awuppe yii? Entti yey hintte asatethaa haaranaw olettiya hintte asho amuwaappe gidenneyye? <verse number="2" style="v"/>Hintte amotteeta, shin demmeketa; hessa gisho, wodheeta. Minthi koyeeta, shin demmanaw dandda7ekketa; hessa gisho, ooyetteetanne oletteeta. Hintte Xoossaa woossonna gisho koyabaa demmeketa. <verse number="3" style="v"/>Hintte woosseta, shin demmeketa. Hintte asho amuwaa polanaw wobbe ogen woossiya gisho demmeketa. <verse number="4" style="v"/>Hinttenoo, laymateyssato! Ha alamiya dosey Xoossara morkke gideyssa erekketii? Ha alamiyara dabbotanaw koyey oonikka Xoossaara morkke. <verse number="5" style="v"/>Geeshsha Maxaafay, “Xoossay nunan daana mela oothida Ayyaanay, nuuni iyaw buzo gidana mela amottees” gidayssa coo gidabaa daanii? <verse number="6" style="v"/>Shin Geeshsha Maxaafay, “Xoossay otoranchchota ixxees, shin banttana kawushsheyssatas maarotethaa immees” yaagiya gisho, Xoossay maarotethaa darssidi immees.<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PRO 3:34">Leemi 3:34</ref></char></note></para>
  <para style="p">
    <verse number="7" style="v"/>Hessa gisho, Xoossaas haarettite; Xalahiyara eqettite; I hinttefe haakkana. <verse number="8" style="v"/>Xoossaakko shiiqite; I hintteko shiiqana. Hinttenoo, nagaranchchoto, hintte kushiya meecettite; nam77u qofi de7eyssato, hintte wozanaa geeshshite. <verse number="9" style="v"/>Kayottite, yeekkitenne afuxite. Hintte miichchay yeehon, hintte ufayssay azzanon laameto. <verse number="10" style="v"/>Godaa sinthan hinttenatethaa kawushshite; hinttena dhoqqu dhoqqu oothana.</para>
  <para style="s">Asa bolla pirddofite</para>
  <para style="p">
    <verse number="11" style="v"/>Ta ishato, issoy issuwa zigiroppite. Ba ishaa zigireynne iya bolla pirddey higge zigireesinne higge bolla pirddees. Neeni higge bolla pirddiko higge bolla pirddeyssa gidaasappe attin higge poleyssa gidakka. <verse number="12" style="v"/>Higge immeynne pirddey Xoossaa xalaala. Ashshanawunne dhayssanaw dandda7ey iya. Yaatin, ne asa bolla pirddey neeni oonee?</para>
  <para style="s">Ceeqettofite</para>
  <para style="p">
    <verse number="13" style="v"/>Hintte, “Nuuni hachchi woykko wontto ya katamaa woykko ha katamaa baana; yan laythi uttana; zal77idi wodhisana” yaageyssato, si7ite.<note caller="-" style="x"><char style="xo" closed="false">4:13-14 </char><char style="xt" closed="false"><ref loc="PRO 27:1">Leemi 27:1</ref></char></note> <verse number="14" style="v"/>Wontto aybi hananeekko hintte erekketa. Hintte de7oy waananekko erey oonee? Hintte guutha wode benttidi dhayiya akka mela. <verse number="15" style="v"/>Hessa aggidi, “Goday giikko nuuni daana; hayssa woykko hessa oothana” yaaganaw bessees. <verse number="16" style="v"/>Shin hintte ha77i otortteetanne ceeqetteeta. Hessa mela ceeqo ubbay iita.</para>
  <para style="p">
    <verse number="17" style="v"/>Hessa gisho, lo77obaa oothanaw erishe oothonna uraas hessi nagara.</para>
  <chapter number="5" style="c"/>
  <para style="s">Duretas imettida zore</para>
  <para style="p">
    <verse number="1" style="v"/>Hinttenoo, dureto, hintte bolla iita metoy yaa gisho yeekkitenne zeleelite. <verse number="2" style="v"/>Hintte shaloy buuqqis; hintte afilaykka bilan meetettis.<note caller="-" style="x"><char style="xo" closed="false">5:2-3 </char><char style="xt" closed="false"><ref loc="MAT 6:19">Maato 6:19</ref></char></note> <verse number="3" style="v"/>Hintte worqqaynne hintte biray shi7is. He shi7ay hintte bolla markka gidana. I hintte asatethaa tamada maana. Hintte ha wurida qammatan hinttew shalo dagayeeta. <verse number="4" style="v"/>Hintte gaden oothi pee7ida asaa kera miishiya qanxibeekketa. Hessi hintte bolla waasses. He asata waasoy wolqqaama Godaa haythan si7ettis.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="DEU 24:14-15">Zaare 24:14-15</ref></char></note> <verse number="5" style="v"/>Ha sa7an hintte ulo xalaalas qoppidi, injjen de7ideta. Shukas giigettida meheda hinttena dhiikkideta. <verse number="6" style="v"/>Hinttera eqettanaw dandda7onna xillo asa bolla pirddideta iya wodhideta.</para>
  <para style="s">Genccanne woosaa</para>
  <para style="p">
    <verse number="7" style="v"/>Ta ishato, Goday yaana gakkanaw genccite. Goshshanchchoy torchche iraynne sila iray yaana gakkanaw genccidi al77o kathaa naagidi waati gathi ekkiyako qoppite. <verse number="8" style="v"/>He goshshanchchuwada hintteka genccite. Godaa yuussay matattida gisho ufayssan naagite.</para>
  <para style="p">
    <verse number="9" style="v"/>Ta ishato, Xoossay hintte bolla pirddonna mela issoy issuwa bolla zuuzummofite. Pirddeyssi penggen eqqis. <verse number="10" style="v"/>Ta ishato, waayan genccida, Godaa sunthan odida nabeta leemiso oothidi ekkite. <verse number="11" style="v"/>Dandda7an genccidayssata nuuni anjjettidayssata goos. Iyoobey waanidi genccidaako hintte si7ideta. Goday wurssethan iya waati maaddidaakko be7ideta. I maarotinne qadhey kumida Godaa gidiya gisho hessa oothis.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JOB 1:21-22">Iyo 1:21-22</ref>; <ref loc="JOB 2:10">2:10</ref>; <ref loc="PSA 103:8">Maz 103:8</ref></char></note></para>
  <para style="p">
    <verse number="12" style="v"/>Shin ubbaafe sinthe, ta ishato, saluwan gidin woykko sa7an gidin woykko hara aybinkka caaqqofite. Xoossaa pirddan hintte gelonnaada hintte oday ee gidikko, “Ee” giite; akkay gidikko, “Akkay” giite.<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="MAT 5:34-37">Maato 5:34-37</ref></char></note></para>
  <para style="p">
    <verse number="13" style="v"/>Hintte giddon meto gakkiya oonikka de7ikko Xoossaa woosso. Ufayttiya oonikka de7ikko galatan yexxo. <verse number="14" style="v"/>Hinttefe harggettiya oonikka de7ikko woosa keetha cimata xeego. Entti Godaa sunthan shamaho zayte tiyidi iyaw Xoossaa woosso. <verse number="15" style="v"/>Ammanon woossida woosay hargganchchuwa pathana. Goday iya, harggiyafe denthana; I nagara oothidabaa gidikkoka Goday iya maarana. <verse number="16" style="v"/>Hessa gisho, hintte paxana mela hintte nagara issoy issuwas paaxitenne issoy issuwas woossite. Xillo asa woosay wolqqaama ooso oothees. <verse number="17" style="v"/>Eliyaasi nu mela ase. Iri sa7an bukkonna mela minthidi Xoossaa woossin heedzu laythinne usuppun ageena sa7an iri bukkibeenna.<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1Kawo 17:1</ref>; <ref loc="1KI 18:1">18:1</ref></char></note> <verse number="18" style="v"/>Zaaridi I Xoossaa woossin saloppe iri bukkis; sa7aykka kathi mokkis.<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="1KI 18:42-45">1Kawo 18:42-45</ref></char></note></para>
  <para style="p">
    <verse number="19" style="v"/>Ta ishato, hinttefe oonikka tuma ogiyappe buutikko, haray iya tumaakko zaarikko, <verse number="20" style="v"/>nagaranchchuwa iya bala ogiyappe zaariya oonikka, iya shemppuwa hayqoppe ashsheyssanne iya daro nagaraas maarota immeyssa ero.<note caller="-" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="PRO 10:12">Leemi 10:12</ref>; <ref loc="1PE 4:8">1Phexi 4:8</ref></char></note></para>
  <para style="restore">02-Oct-2008@09:05, Backup Description=23-Sep-2008@16:55, Ed Owen -</para>
</usx>
