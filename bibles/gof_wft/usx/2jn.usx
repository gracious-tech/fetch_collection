<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">2 Yohaanisa Kiita</para>
  <para style="toc1">2 Yohaanisa Kiita</para>
  <para style="toc3">2 Yoha</para>
  <para style="toc2">2 Yohaanisa</para>
  <para style="mt1">Yohaanisi Xaafida</para>
  <para style="mt2">Nam7antho Kiita</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Yohaanisi xaafida nam7antho kiita, Yesuusa hawaare gidida cimay, Yohaanisi xaafis. Ha kiitay xaafetiday dooretida godatesanne I naytasa. Ha qantha kiitay xaafetiday,</para>
  <para style="ipi">1. Enti issoy issuwara siiqetana mela akeekisanaasa;</para>
  <para style="ipi">2. Wordo astamaaretapenne enta timirtiyafe naagetana mela qofisanaasa.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Sarothonne woosa <char style="ior">(<ref loc="2JN 1:1-3">1-3</ref>)</char></para>
  <para style="io1">Siiqonne tumatethi <char style="ior">(<ref loc="2JN 1:4-6">4-6</ref>)</char></para>
  <para style="io1">Wordo timirtefe naagetethi <char style="ior">(<ref loc="2JN 1:7-11">7-11</ref>)</char></para>
  <para style="io1">Sarotho <char style="ior">(<ref loc="2JN 1:12-13">12-13</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />Ta cimay dooretida godatesinne I naytas kiitida kiita. Ta xalaala gidonashin, tumaa eriya ubbay hintena dosoosona. <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />Ha tumay nunan de7iya gishonne merinaw nuura daana gisho taani hintena tuma dosayis.<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />Xoossaa nu Aawanne iya Na7aa Yesuus Kiristoosa aadho keehatethay, maarotethaynne sarotethay tumanine siiqon issife nuura gido.<verse eid="2JN 1:3" /></para>
  <para style="s1">Tumanne Siiqo</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />Aaway nuna kiittidaysada, ne naytape baggati, tumaas kiiteteysa be7ada taani daro ufaytas. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" />Godate, ha77ika nuuni ubbay issoy issuwa siiqana mela taani nena woossayis. Ha kiitay koyrope nuura de7iya kiitaape attishin, taani new ooratha kiita xaafike.<note caller="-" style="x"><char style="xo" closed="false">5 </char><char style="xt" closed="false"><ref loc="JHN 13:34">Yoha 13:34</ref>; <ref loc="JHN 15:12">15:12</ref>, <ref loc="JHN 15:17">17</ref>.</char></note> <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />Tuma siiqoy nuuni Xoossaa kiitaa naagidi daanaysa. Qassi koyrope hinte si7idaysada iya kiitay, hinte ubbay siiqon daana melasa.<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />Yesuus Kiristoosi ase gididi yidaysa ammanonna, daro balethiya asati, alamen dendidosona. Hessa mela asi oonika baletheysanne Kiristoosa morke. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />Hinte oothida kumetha woytuwa ekanaw minnite. Hinte oothidaysi dhayonna mela naagetite.<verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />Kiristoosa timirtiyan doonnaysasinne iyape haakiya uraas Xoossay baawa. Kiristoosa timirtiyan de7iya uraas Aawaynne Na7ay de7oosona. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />Oonika hinteko yishe ha timirtiya ehonna ixiko, hinte soo gelsofite; saroka goopite. <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />Iya saro giya oonika iya iita oosuwan iyara shaaketees.<verse eid="2JN 1:11" /></para>
  <para style="s1">Sarotho</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />Taani hintew xaafanaw koyida darobay de7ees, shin worqateninne qalamen xaafanaw koyke. Nu ufaysay poletana mela hintera som7on gahetada odetanaw hinteko baana gada qopayis.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />Xoossay doorida ne miche nayti nena saro yaagosona.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>