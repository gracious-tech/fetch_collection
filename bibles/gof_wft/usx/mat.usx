<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Maatosa Wongela</para>
  <para style="toc1">Maatosa Wongela</para>
  <para style="toc3">Maato</para>
  <para style="toc2">Maatosa</para>
  <para style="mt1">Maatosi Xaafida</para>
  <para style="mt2">Yesuus Kiristoosa Wongela</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Maatosa Wongelay, yaana geetetidi ufaysan naagetey ashshiya Yesuusa gideysanne Xoossay gal7a caaquwan ba asaas immida ufaysa qaala poliday iya baggara gideysa odiya Wongela. Ha Wongelay Yesuusi enta giddon yeletidi diccida Ayhudeta xalaalas gidonashin, kumetha alamiyasa.</para>
  <para style="ip">Maatosi ba maxaafa Yesuusa yeletethan doomidi, iya xammaqetethanne iya paacetetha odees. Kaallidi, I Galilan sabbakidaba, tamaarsidabanne harganchota pathidaba odees. Yesuusi Galilape Yerusalaame bidaysanne sa7a bolla de7ishe wursetha saamintan hanidabata, hessika: iya kaqetetha, iya hayquwanne iya denduwa qoncisees.</para>
  <para style="ip">Ha wongelay, Yesuusi Xoossa higge birshanaw maati de7eysanne Xoossa kawotethaaba tamaarsiya gita astamaare oothidi ekees. Iya timirtey, dumma dumma maaran giigetida ichashu kifiletan shaaketees.</para>
  <para style="ipi">1. Xoossa kawotethan de7iya asa hanota, maatanne wursetha qaada odiya Zuma Bolla Timirtiya (Shem 5—7).</para>
  <para style="ipi">2. Tammanne nam7u tamaareti Wongela odanaw biya wode entaw imetida kiita (Shem 10).</para>
  <para style="ipi">3. Xoossaa kawotethaaba tamaarsanaw shiiqida dumma dumma leemisota (Shem 13).</para>
  <para style="ipi">4. Yesuusa tamaare geysas birshethay ay guusseko tamaarsiya timirte (Shem 18).</para>
  <para style="ipi">5. Wode wursethinne Xoossa kawotetha yuussaba odiya timirte (Shem 24—25).</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Yesuus Kiristoosa yeletethinne iya susa <char style="ior">(<ref loc="MAT 1:1-2:23">1:1—2:23</ref>)</char></para>
  <para style="io1">Xammaqiya Yohaanisa oosuwa <char style="ior">(<ref loc="MAT 3:1-12">3:1-12</ref>)</char></para>
  <para style="io1">Yesuusa xinqatenne paacetethi <char style="ior">(<ref loc="MAT 3:13-4:11">3:13—4:11</ref>)</char></para>
  <para style="io1">Yesuusi Galilan ba oosuwa oykethi <char style="ior">(<ref loc="MAT 4:12-18:35">4:12—18:35</ref>)</char></para>
  <para style="io1">Galilape Yerusalaame gakanaw <char style="ior">(<ref loc="MAT 19:1-20:34">19:1—20:34</ref>)</char></para>
  <para style="io1">Yerusalaame heeran aathid wursetha saaminta <char style="ior">(<ref loc="MAT 21:1-27:66">21:1—27:66</ref>)</char></para>
  <para style="io1">Godaa hayqope denduwanne asas qoncethi <char style="ior">(<ref loc="MAT 28:1-20">28:1-20</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="MAT 1"/>
  <para style="s1">Yesuusa Yeleta Susa</para>
  <para style="r">(<ref loc="LUK 3:23-38">Luqa 3:23-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1"/>Haysafe kaallidi xaafetidaysi Dawita na7a Abrahaame na7a gidida Yesuus Kiristoosa yeletethaa.<verse eid="MAT 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2"/>Abrahaamey Yisaaqa yelis;</para>
  <para style="q1" vid="MAT 1:2">Yisaaqi Yayqooba yelis;</para>
  <para style="q1" vid="MAT 1:2">Yayqoobi Yihudanne iya ishata yelis;<verse eid="MAT 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 1:3"/>Yihudi Timaaripe Faaresanne Zaara yelis;</para>
  <para style="q1" vid="MAT 1:3">Faaresi Asroome yelis;</para>
  <para style="q1" vid="MAT 1:3">Asroomey Raame yelis;<verse eid="MAT 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 1:4"/>Raamey Amnadaabe yelis;</para>
  <para style="q1" vid="MAT 1:4">Amnadaabey Na7asoona yelis;</para>
  <para style="q1" vid="MAT 1:4">Na7asooni Salmoona yelis;<verse eid="MAT 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 1:5"/>Salmoona Raabipe Boo7eza yelis;</para>
  <para style="q1" vid="MAT 1:5">Boo7ezi Uruutipe Iyobeeda yelis;</para>
  <para style="q1" vid="MAT 1:5">Iyobeedi Isseye yelis;<verse eid="MAT 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 1:6"/>Isseyey kawa Dawita yelis;</para>
  <para style="q1" vid="MAT 1:6">Dawiti koyro Ooriyo machefe Solomone yelis;<verse eid="MAT 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 1:7"/>Solomoney Orobi7aama yelis;</para>
  <para style="q1" vid="MAT 1:7">Orobi7aamey Abiya yelis;</para>
  <para style="q1" vid="MAT 1:7">Abiyi Asaafa yelis;<verse eid="MAT 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 1:8"/>Asaafi Iyosaafexa yelis;</para>
  <para style="q1" vid="MAT 1:8">Iyosaafexi Iyoraama yelis;</para>
  <para style="q1" vid="MAT 1:8">Iyoraami Ooziyana yelis;<verse eid="MAT 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 1:9"/>Ooziyani Iyo7ataame yelis;</para>
  <para style="q1" vid="MAT 1:9">Iyo7atami Akaaza yelis;</para>
  <para style="q1" vid="MAT 1:9">Akaazi Hizqiyaasa yelis;<verse eid="MAT 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 1:10"/>Hizqiyaasi Minaase yelis;</para>
  <para style="q1" vid="MAT 1:10">Minaasey Amoone yelis;</para>
  <para style="q1" vid="MAT 1:10">Amooni Iyosiyaasa yelis;<verse eid="MAT 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 1:11"/>Isra7eele asay di7etidi Babiloone biitta bida wode Iyosiyaasi Ikoniyaananne iya ishata yelis.<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="2KI 24:14-15">2 Kawo 24:14-15</ref>; <ref loc="2CH 36:10">2 Taari 36:10</ref>; <ref loc="JER 27:20">Ermi 27:20</ref>.</char></note><verse eid="MAT 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 1:12"/>Babiloone biitta Isra7eele asay di7etidi bidaape guye Ikoniyaani Salatiyaala yelis.</para>
  <para style="q1" vid="MAT 1:12">Salatiyaali Zarubaabela yelis;<verse eid="MAT 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 1:13"/>Zarubaabeli Abdiyu yelis;</para>
  <para style="q1" vid="MAT 1:13">Abdiyuy Eliyaqeeme yelis;</para>
  <para style="q1" vid="MAT 1:13">Eliyaqeemi Azaara yelis;<verse eid="MAT 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="MAT 1:14"/>Azaari Saadoqa yelis;</para>
  <para style="q1" vid="MAT 1:14">Saadoqi Akime yelis;</para>
  <para style="q1" vid="MAT 1:14">Akimey Elyuuda yelis;<verse eid="MAT 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 1:15"/>Elyuudi Alaazara yelis;</para>
  <para style="q1" vid="MAT 1:15">Alaazari Maatane yelis;</para>
  <para style="q1" vid="MAT 1:15">Maataney Yayqooba yelis;<verse eid="MAT 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 1:16"/>Yayqoobi Yoosefa yelis;</para>
  <para style="q1" vid="MAT 1:16">Yoosefi Kiristoosa geetetiya Yesuusa yelida Mayraami azina.<verse eid="MAT 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17"/>Hiza, yeletethay Abrahaamepe Dawita gakanaw tammanne oydda. Dawitape bidi Babiloone di7uwa gakanaw tammanne oydda. Babiloone di7uwape bidi Kiristoosa gakanaw tammanne oyddu yeletethi gidees.<verse eid="MAT 1:17"/></para>
  <para style="s1">Yesuus Kiristoosa Yeletethi</para>
  <para style="r">(<ref loc="LUK 2:1-7">Luqa 2:1-7</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18"/>Yesuus Kiristoosa yeletethaa taarikey haysafe kaalleysa. Iya aayiya Mayraama Yoosefas oysheta de7ashe Yoosefara gahetonna Geeshsha Ayyaanape qanthatasu.<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="LUK 1:27">Luqa 1:27</ref>.</char></note> <verse eid="MAT 1:18"/><verse number="19" style="v" sid="MAT 1:19"/>Yoosefi Xillo asi gidida gisho iyo asan kessanaw koybeenna. Yaaniya gisho qosan iyo agganaw qopis. <verse eid="MAT 1:19"/><verse number="20" style="v" sid="MAT 1:20"/>I he qofan de7ishin Xoossaa kiitanchoy amuhon qoncidi, “Dawita na7aw, Yoosefa, Mayraama qanthatiday Geeshsha Ayyaanape gidiya gisho iyo ekanaw yayyofa” yaagis. <verse eid="MAT 1:20"/><verse number="21" style="v" sid="MAT 1:21"/>Iya adde na7a yelana, I ba deriya enta nagaraape ashshiya gisho iya sunthaa ne Yesuusa gada xeegana.<note caller="-" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="LUK 1:31">Luqa 1:31</ref>.</char></note><verse eid="MAT 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22"/>Goday nabiya Isayaasa doonan, <verse eid="MAT 1:22"/><verse number="23" style="v" sid="MAT 1:23"/>“Heko geela7iya qanthatana; adde na7a yelana; iya sunthay Amanu7eela” geetetana goysi poletana mela ha ubbay hanis. Amanu7eela geysas birshethay “Xoossay nuura de7ees” guussu.<note caller="-" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="ISA 7:14">Isa 7:14</ref>.</char></note><verse eid="MAT 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24"/>Yoosefi dhiskofe barkidi Godaa kiitanchoy kiittidaysa mela Mayraamo ba soo efis. <verse eid="MAT 1:24"/><verse number="25" style="v" sid="MAT 1:25"/>Shin ba bayra na7a yelana gakanaw iyo bochibeenna;<note caller="+" style="f"><char style="fr" closed="false">1:25 </char><char style="fk" closed="false">Iyo bochibeenna: </char><char style="ft" closed="false">Machira azinara aqeysada issife aqibookona guussu.</char></note> yeletida na7aka Yesuusa gidi xeegis.<note caller="-" style="x"><char style="xo" closed="false">1:25 </char><char style="xt" closed="false"><ref loc="LUK 2:21">Luqa 2:21</ref>.</char></note><verse eid="MAT 1:25"/></para>
  <chapter eid="MAT 1"/>
  <chapter number="2" style="c" sid="MAT 2"/>
  <para style="s1">Dolohape Yida Asata</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1"/>Kawa Herodiisa woden Yesuusi Yihuda biittan Beeteleme kataman yeletidaape guye xoolinto taybiya asati dolohape Yerusalaame yidi, <verse eid="MAT 2:1"/><verse number="2" style="v" sid="MAT 2:2"/>“Yeletida Ayhude kawoy awun de7ii? Nuuni doloha baggara keyida iya xoolintuwa be7idi iyaw goyinnanaw yida” yaagidi oychidosona. <verse eid="MAT 2:2"/><verse number="3" style="v" sid="MAT 2:3"/>Kawoy Herodiisi hessa si7ida wode dagammis. Yerusalaamen de7iya asa ubbayka dagammidosona. <verse eid="MAT 2:3"/><verse number="4" style="v" sid="MAT 2:4"/>Herodiisi kahine halaqatanne higge astamaareta baako xeegidi, “Kiristoosi awun yeletandesha?” yaagidi enta oychis.<verse eid="MAT 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5"/>Entika, “Yihuda Beetelemena; nabey,<verse eid="MAT 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6"/>“ ‘Yihudan de7iya Beeteleme,<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="MIC 5:2">Miki 5:2</ref>.</char></note></para>
  <para style="q2" vid="MAT 2:6">Yihudan de7iya gooba katamatape,</para>
  <para style="q2" vid="MAT 2:6">neeni aybinka guuxaka.</para>
  <para style="q1" vid="MAT 2:6">Ta deriya Isra7eele aysanaysi,</para>
  <para style="q2" vid="MAT 2:6">neepe keyana’ gidi xaafis”</para>
  <para style="m" vid="MAT 2:6">yaagidosona.<verse eid="MAT 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7"/>Hessafe guye, Herodiisi dolohape yida asata geeman xeegidi, xoolintuwa enti be7ida wodiya entafe geeshshidi eris. <verse eid="MAT 2:7"/><verse number="8" style="v" sid="MAT 2:8"/>I entana Beeteleme yeddishe, “Bidi yeletida na7aa minthidi koyite; iya hinte demmida wode taka bada iyaw goyinnana mela simmidi yishe taw odite” yaagis. <verse eid="MAT 2:8"/><verse number="9" style="v" sid="MAT 2:9"/>Entika kawoy Herodiisi gidaysa si7idi bidosona. Enti doloha baggara be7ida xoolintoy entana kaalethishe na7ay de7iyasuwa gakanaw efis. <verse eid="MAT 2:9"/><verse number="10" style="v" sid="MAT 2:10"/>Enti he xoolintuwa be7ida wode gita ufaysi ufaytidosona. <verse eid="MAT 2:10"/><verse number="11" style="v" sid="MAT 2:11"/>Soo gelidi na7aa ba aaye Mayraamira de7eysa be7idosona. Iyaw gulbatidi goyinnidosona. Banta saaxiniya dooyidi worqa, ixaanenne karbe iyaw immidosona. <verse eid="MAT 2:11"/><verse number="12" style="v" sid="MAT 2:12"/>Enti Herodiisako guye simmonna mela Xoossay amuhon entaw odin, hara ogera banta biitta simmidosona.<verse eid="MAT 2:12"/></para>
  <para style="s1">Gibxe Baqato</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13"/>Doloha baggafe yida asati bidaape guye, Godaa kiitanchoy Yoosefas amuhon qoncidi, “Herodiisi na7aa wodhanaw koyiya gisho denda; ellesada na7aanne na7aa aayiw ekada Gibxe biitta ba. Ne simmana wodiya ta new odana gakanaw yan gam7a” yaagis.<verse eid="MAT 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14"/>Hessa gisho, Yoosefi he qamman dendidi, na7aanne na7aa aayiw ekidi Gibxe bis. <verse eid="MAT 2:14"/><verse number="15" style="v" sid="MAT 2:15"/>Nabiya doonan Xoossay, “Taani, ta na7aa, Gibxe biittafe xeegas”<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="HOS 11:1">Hose 11:1</ref>.</char></note> geetetida qaalay poletana mela Herodiisi hayqana gakanaw I yan de7is.<verse eid="MAT 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16"/>Hessafe guye, doloha baggafe yida asati iya cimmidaysa erida wode daro yilotis. I kase entafe si7idaysada Beetelemeninne he heeran de7iya nam7u laythi kumidaysatanne nam7u laythafe garsan de7iya adde nayta ubbaa ba wotaadareta yeddidi wodhisis.<verse eid="MAT 2:16"/></para>
  <para style="p">
    <verse number="17-18" style="v" sid="MAT 2:17-18"/>Nabiya Ermiyaasa doonan,</para>
  <para style="q1" vid="MAT 2:17-18">“Yeehoynne zelelsi,</para>
  <para style="q2" vid="MAT 2:17-18">Rama kataman si7etis.</para>
  <para style="q1" vid="MAT 2:17-18">Raheela ba naytas yeekawusu;</para>
  <para style="q2" vid="MAT 2:17-18">enti hayqida gisho</para>
  <para style="q2" vid="MAT 2:17-18">minettanaw danda7abuku”</para>
  <para style="m" vid="MAT 2:17-18">gidi odidaysi poletis.<note caller="-" style="x"><char style="xo" closed="false">2:17-18 </char><char style="xt" closed="false"><ref loc="JER 31:15">Ermi 31:15</ref>.</char></note><verse eid="MAT 2:17-18"/></para>
  <para style="s1">Naazirete Simuwa</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19"/>Herodiisi hayqidaape guye Gibxen Godaa kiitanchoy Yoosefas amuhon qoncidi, <verse eid="MAT 2:19"/><verse number="20" style="v" sid="MAT 2:20"/>“Na7aa wodhanaw koyiya asati hayqida gisho, dendada na7aanne na7aa aayiw ekada Isra7eele biitta simma” yaagis.<verse eid="MAT 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 2:21"/>Yoosefi dendidi na7aanne na7aa aayiw ekidi Isra7eele biitta simmis. <verse eid="MAT 2:21"/><verse number="22" style="v" sid="MAT 2:22"/>Shin Arkeliyoosi Yihudan ba aawa Herodiisa bessan kawotidaysa si7ida wode yaa baanaw yayyis. Xoossay amuhon iyaw qoncisin Galila biitta bis. <verse eid="MAT 2:22"/><verse number="23" style="v" sid="MAT 2:23"/>Nabeta doonan, “Naazirete asi geetetana” gidi odetidaysi poletana mela Naazirete katamaa bidi yan de7is.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MRK 1:24">Mar 1:24</ref>; <ref loc="LUK 2:39">Luqa 2:39</ref>; <ref loc="JHN 1:45">Yoha 1:45</ref>.</char></note><verse eid="MAT 2:23"/></para>
  <chapter eid="MAT 2"/>
  <chapter number="3" style="c" sid="MAT 3"/>
  <para style="s1">Xammaqiya Yohaanisa Oge Giigisuwa</para>
  <para style="r">(<ref loc="MRK 1:1-8">Mar 1:1-8</ref>; <ref loc="LUK 3:1-17">Luqa 3:1-17</ref>; <ref loc="JHN 1:19-28">Yoha 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1-2" style="v" sid="MAT 3:1-2"/>He wode Xammaqiya Yohaanisi, “Xoossaa kawotethay matatida gisho hinte nagaraape simmite” yaagidi sabbakishe Yihuda mela biitta bis.<note caller="-" style="x"><char style="xo" closed="false">3:1-2 </char><char style="xt" closed="false"><ref loc="MAT 4:17">Maato 4:17</ref>; <ref loc="MRK 1:15">Mar 1:15</ref>.</char></note> <verse eid="MAT 3:1-2"/><verse number="3" style="v" sid="MAT 3:3"/>Nabiya Isayaasi Yohaanisaba odidaysa mela,</para>
  <para style="q1" vid="MAT 3:3">“Mela biittan,</para>
  <para style="q2" vid="MAT 3:3">issoy ba qaala dhoqu oothidi,</para>
  <para style="q1" vid="MAT 3:3">‘Godaa ogiya giigisite.</para>
  <para style="q1" vid="MAT 3:3">Iya horoga piddi oothite’ gis”<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isa 40:3</ref>.</char></note></para>
  <para style="m" vid="MAT 3:3">yaagetiday iyassa yaagis.<verse eid="MAT 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4"/>Yohaanisi gimale ikisepe oosetida afila ma77ees. Ba xeessan dafo dancees. I miya kathayka boolenne degera eessi.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 Kawo 1:8</ref>.</char></note> <verse eid="MAT 3:4"/><verse number="5" style="v" sid="MAT 3:5"/>Asay he wode Yerusalaame katamaape, Yihuda biitta ubbaafenne Yordaanose Shaafa heerape iyako yoosona. <verse eid="MAT 3:5"/><verse number="6" style="v" sid="MAT 3:6"/>Banta nagaraa paaxidi Yordaanose Shaafan Yohaanisa kushen xammaqetosona.<verse eid="MAT 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7"/>Yohaanisi, daro Farsaawetinne Saduqaaweti xammaqetanaw baako yeyisata be7idi, entako, “Ha iita shooshato, yaana Xoossaa hanquwafe baqatana mela hintena oone zoriday?<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Maato 12:34</ref>; <ref loc="MAT 23:33">23:33</ref>.</char></note> <verse eid="MAT 3:7"/><verse number="8" style="v" sid="MAT 3:8"/>Hiza, hinte, hinte nagaraape simmidaysa erisiyaba oothite. <verse eid="MAT 3:8"/><verse number="9" style="v" sid="MAT 3:9"/>Hinte, hinte wozanan, ‘Abrahaamey, nu aaway de7ees’ gidi qopofite. Loythi si7ite! Xoossay ha shuchatape Abrahaames na7a kessanaw danda7ees.<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="JHN 8:33">Yoha 8:33</ref>.</char></note> <verse eid="MAT 3:9"/><verse number="10" style="v" sid="MAT 3:10"/>Beexey mitha xaphon giigidi uttis; lo77o ayfe ayfonna mitha ubbay qanxetidi taman yegetana.<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 7:19">Maato 7:19</ref>.</char></note><verse eid="MAT 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 3:11"/>“Hinte, hinte nagaraape simmidaysa erisanaw taani hintena haathan xammaqayis. Shin taape guyera yeysi hintena Geeshsha Ayyaananinne taman xammaqana. I taape daro wolqaamees; taani hari attoshin iya caammaa tookanawuka bessike. <verse eid="MAT 3:11"/><verse number="12" style="v" sid="MAT 3:12"/>Kathaa geeshshiya pithey iya kushen de7ees. Kathaa loythi geeshshees; gistiya ba shaaliyan qolana, shin punuwa to7onna taman xuuggana” yaagis.<verse eid="MAT 3:12"/></para>
  <para style="s1">Yesuusa Xammaqetetha</para>
  <para style="r">(<ref loc="MRK 1:9-11">Mar 1:9-11</ref>; <ref loc="LUK 3:21-22">Luqa 3:21-22</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13"/>He wode Yesuusi Yohaanisa kushen xammaqetanaw Galilape Yordaanose Shaafa bis. <verse eid="MAT 3:13"/><verse number="14" style="v" sid="MAT 3:14"/>Shin Yohaanisi iya digganaw koyidi, “Taani nenan xammaqetanaw koshshishin neeni taako yay?” yaagis. <verse eid="MAT 3:14"/><verse number="15" style="v" sid="MAT 3:15"/>Shin Yesuusi zaaridi, “Xoossay nuupe koyaba ubbaa nu polanaw bessiya gisho, ha77i taw ero ga” yaagis. Yohaanisi iyaw ero gidi ekis. <verse eid="MAT 3:15"/><verse number="16" style="v" sid="MAT 3:16"/>Yesuusi xammaqetida mela haathaafe keyis. Iiraka saloy dooyetin Xoossaa Ayyaanay holleda yishin qassi ba bolla wol7amidi wodhishin be7is. <verse eid="MAT 3:16"/><verse number="17" style="v" sid="MAT 3:17"/>He wode, “Ta dosiya, iyan tana ufaysiya ta na7ay haysa” giya qaalay salope yis.<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="MAT 12:18">Maato 12:18</ref>; <ref loc="MAT 17:5">17:5</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 9:35">Luqa 9:35</ref>.</char></note><verse eid="MAT 3:17"/></para>
  <chapter eid="MAT 3"/>
  <chapter number="4" style="c" sid="MAT 4"/>
  <para style="s1">Yesuusa Paacetetha</para>
  <para style="r">(<ref loc="MRK 1:12-13">Mar 1:12-13</ref>; <ref loc="LUK 4:1-13">Luqa 4:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1"/>Hessafe guye, Xalahey Yesuusa paacana mela Geeshsha Ayyaanay Yesuusa mela biitta efis.<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="HEB 2:18">Ibra 2:18</ref>; <ref loc="HEB 4:15">4:15</ref>.</char></note> <verse eid="MAT 4:1"/><verse number="2" style="v" sid="MAT 4:2"/>Oytamu qammanne oytamu gallas xoomidaape guye koshatis. <verse eid="MAT 4:2"/><verse number="3" style="v" sid="MAT 4:3"/>Xalahey Yesuusako yidi “Neeni Xoossaa na7a gidiko, ane ha shuchati uythi gidana mela kiitta” yaagis.<verse eid="MAT 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4"/>Yesuusi zaaridi, “ ‘Asi Xoossaa doonape keyiya qaala ubban de7eesipe attishin, uytha xalaalan deenna’ geetetidi Xoossaa qaalan xaafetis”<note caller="-" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="DEU 8:3">Zaare 8:3</ref>.</char></note> yaagis.<verse eid="MAT 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5"/>Kaallidika, Xalahey Yesuusa geeshsha katamaa efidi, Xoossaa keetha huuphiya kessidi, <verse eid="MAT 4:5"/><verse number="6" style="v" sid="MAT 4:6"/>“Neeni Xoossa na7a gidiko, ane duge sa7an kunda.<note caller="-" style="x"><char style="xo" closed="false">4:6 </char><char style="xt" closed="false"><ref loc="PSA 91:11">Maz 91:11</ref>.</char></note></para>
  <para style="q1" vid="MAT 4:6">“ ‘Ne tohoy shuchan dhubetonna mela,</para>
  <para style="q2" vid="MAT 4:6">banta kushiyan nena denthana mela,</para>
  <para style="q2" vid="MAT 4:6">Xoossay ba kiitanchota ne gisho kiittana’</para>
  <para style="m" vid="MAT 4:6">geetetidi Xoossaa qaalan xaafetis” yaagis.<verse eid="MAT 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7"/>Yesuusi iyako, “Qassika, ‘Xoossaa qaalan ne Godaa, ne Xoossaa paacofa’ yaagetidi xaafetis” gidi zaaris.<note caller="-" style="x"><char style="xo" closed="false">4:7 </char><char style="xt" closed="false"><ref loc="DEU 6:16">Zaare 6:16</ref>.</char></note><verse eid="MAT 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8"/>Wursethan Xalahey Yesuusa issi wolqaama zuma huuphe kessidi alamiya kawotethata enta bonchuwara issife bessidi, <verse eid="MAT 4:8"/><verse number="9" style="v" sid="MAT 4:9"/>“Ne taw kundada goyinniko ta new ha ubbaa immana” yaagis.<verse eid="MAT 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10"/>Yesuusi zaaridi, “Ha Xalahiyaw, taape haaka! ‘Ne Godaa, ne Xoossaa goyinna, iya xalaala haggaaza’ geetetidi Xoossaa qaalan xaafetis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="DEU 6:13">Zaare 6:13</ref>.</char></note><verse eid="MAT 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11"/>Hessafe guye, Xalahey aggidi bis; kiitanchoti yidi iya haggaazidosona.<verse eid="MAT 4:11"/></para>
  <para style="s1">Yesuusa Tamaarso Doometha</para>
  <para style="r">(<ref loc="MRK 1:14-15">Mar 1:14-15</ref>; <ref loc="LUK 4:14-15">Luqa 4:14-15</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12"/>Yesuusi, Yohaanisi qashetoysa si7ida wode Galila biitta bis.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="MAT 14:3">Maato 14:3</ref>; <ref loc="MRK 6:17">Mar 6:17</ref>; <ref loc="LUK 3:19-20">Luqa 3:19-20</ref>.</char></note> <verse eid="MAT 4:12"/><verse number="13" style="v" sid="MAT 4:13"/>Naazirete katamaa aggidi Zabloonaninne Niftaaleme heeran, abba matan de7iya Qifirnahooma katamaa bidi yan de7is.<note caller="-" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="JHN 2:12">Yoha 2:12</ref>.</char></note> <verse eid="MAT 4:13"/><verse number="14" style="v" sid="MAT 4:14"/>Hessi haniday nabiya Isayaasa doonan,<verse eid="MAT 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15"/>“Zabloona biittan, Niftaaleme biittan,</para>
  <para style="q2" vid="MAT 4:15">Yordaanose Shaafape hefinthan,</para>
  <para style="q2" vid="MAT 4:15">abba ogiya gaxan de7iya,</para>
  <para style="q2" vid="MAT 4:15">Ayhude gidonna derey de7iya Galilan,<note caller="-" style="x"><char style="xo" closed="false">4:15 </char><char style="xt" closed="false"><ref loc="ISA 9:1-2">Isa 9:1-2</ref>.</char></note><verse eid="MAT 4:15"/></para>
  <para style="q2">
    <verse number="16" style="v" sid="MAT 4:16"/>dhuman de7iya derey,</para>
  <para style="q2" vid="MAT 4:16">wolqaama poo7o be7is.</para>
  <para style="q1" vid="MAT 4:16">Hayqo kuya biittan,</para>
  <para style="q2" vid="MAT 4:16">de7eysatas poo7oy keyis”</para>
  <para style="m" vid="MAT 4:16">yaagidi odetida qaalay poletana melasa.<verse eid="MAT 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17"/>He wodepe doomidi Yesuusi, “Xoossaa kawotethay matatida gisho hinte nagaraape simmite” yaagidi qaala sabbakees.<note caller="-" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Maato 3:2</ref>.</char></note><verse eid="MAT 4:17"/></para>
  <para style="s1">Koyro Tamaareta Xeegethaa</para>
  <para style="r">(<ref loc="MRK 1:16-20">Mar 1:16-20</ref>; <ref loc="LUK 5:1-11">Luqa 5:1-11</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18"/>Yesuusi Galila Abbaa matara aadhishe nam7u ishata, Phexroosa geetetiya Simoonanne iya ishaa Indiriyasa be7is. Enti molo oykeyisata gidida gisho banta gitiya abban yeggoosona. <verse eid="MAT 4:18"/><verse number="19" style="v" sid="MAT 4:19"/>Yesuusi entana, “Haa yiite; tana kaallite; taani hintena ase oythi tamaarsana” yaagis. <verse eid="MAT 4:19"/><verse number="20" style="v" sid="MAT 4:20"/>Entika, ellesidi banta gitiya yeggi aggidi Yesuusa kaallidosona.<verse eid="MAT 4:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21"/>Yesuusi yaape buroo gede sinthe aadhishe hara nam7u ishata, Zabdiyoosa nayta, Yayqoobanne Yohaanisa be7is. Banta aawa Zabdiyoosara issife wogoluwa giddon banta gitiya giigiseyisata xeegis. <verse eid="MAT 4:21"/><verse number="22" style="v" sid="MAT 4:22"/>Entika, ellesidi banta wogoluwanne banta aawa aggidi Yesuusa kaallidosona.<verse eid="MAT 4:22"/></para>
  <para style="s1">Yesuusi Harganchota Pathis</para>
  <para style="r">(<ref loc="LUK 6:17-19">Luqa 6:17-19</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23"/>Yesuusi ayhude woosa keethatan tamaarsishe, salo kawotethaa Wongela odishenne dumma dumma hargiyafe asaa pathishe Galila biitta ubban yuuyis.<note caller="-" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 9:35">Maato 9:35</ref>; <ref loc="MRK 1:39">Mar 1:39</ref>.</char></note><verse eid="MAT 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 4:24"/>Hessafe dendoysan iya sunthay Soore biitta ubban keyis. Dumma dumma hargen oyketidaysatanne waayeteyisata, tuna ayyaanan oyketidaysata, shoci yeggiya hargen oyketidaysatanne, gundata iyako ehidosona; ika entana pathis.<verse eid="MAT 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 4:25"/>Asay Galilape, Tammu Katamatape, Yerusalaamepe, Yihudapenne Yordaanose Shaafa hefinthan de7iya biittafe yida daro asay iya kaallidosona.<verse eid="MAT 4:25"/></para>
  <chapter eid="MAT 4"/>
  <chapter number="5" style="c" sid="MAT 5"/>
  <para style="s1">Dere Bolla Tamaarsida Timirte</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1"/>Daro derey shiiqidaysa Yesuusi be7ida wode zumaa bolla keyidi uttis. Iya tamaareti iyako shiiqin, <verse eid="MAT 5:1"/><verse number="2" style="v" sid="MAT 5:2"/>haysada yaagidi tamaarsis:<verse eid="MAT 5:2"/></para>
  <para style="s1">Tuma Ufaysi</para>
  <para style="r">(<ref loc="LUK 6:2-23">Luqa 6:2-23</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3"/>“Banta ayyaanan manqoti anjetidaysata,</para>
  <para style="q2" vid="MAT 5:3">salo kawotethay entassa.<verse eid="MAT 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4"/>Yeekeysati anjetidaysata,</para>
  <para style="q2" vid="MAT 5:4">enti minthetho demmana.<note caller="-" style="x"><char style="xo" closed="false">5:4 </char><char style="xt" closed="false"><ref loc="ISA 61:2">Isa 61:2</ref>.</char></note><verse eid="MAT 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5"/>Banta wozanan ashketi anjetidaysata,</para>
  <para style="q2" vid="MAT 5:5">enti sa7aa laattana.<note caller="-" style="x"><char style="xo" closed="false">5:5 </char><char style="xt" closed="false"><ref loc="PSA 37:11">Maz 37:11</ref>.</char></note><verse eid="MAT 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6"/>Xillobaa oothanaw koshateysatinne saamoteysati anjetidaysata,</para>
  <para style="q2" vid="MAT 5:6">enti kallana.<note caller="-" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1">Isa 55:1</ref>.</char></note><verse eid="MAT 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7"/>Maareysati anjetidaysata,</para>
  <para style="q2" vid="MAT 5:7">enti maarotethi demmana.<verse eid="MAT 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8"/>Wozana geeshshati anjetidaysata,</para>
  <para style="q2" vid="MAT 5:8">enti Xoossaa be7ana.<note caller="-" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="PSA 24:3">Maz 24:3</ref>.</char></note><verse eid="MAT 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9"/>Sigetheysati anjetidaysata,</para>
  <para style="q2" vid="MAT 5:9">enti Xoossaa nayta geetetidi xeegetana.<verse eid="MAT 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10"/>Xillobaa oothiya gisho gidi,</para>
  <para style="q2" vid="MAT 5:10">goodeteysati anjetidaysata,</para>
  <para style="q2" vid="MAT 5:10">salo kawotethay entassa.<note caller="-" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="1PE 3:14">1 Phex 3:14</ref>.</char></note><verse eid="MAT 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11"/>“Asay hintena ta gisho gidi cayiya wode, gooddiya wodenne hinte bolla iitabaa ubbaa wordon odisiya wode hinte anjetidaysata.<note caller="-" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="1PE 4:14">1 Phex 4:14</ref>.</char></note> <verse eid="MAT 5:11"/><verse number="12" style="v" sid="MAT 5:12"/>Hinte woytoy salon gita gidiya gisho ufaytite, hashshu giite. Hintefe kase de7iya nabeta hessada goodidosona.<note caller="-" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="2CH 36:16">2 Taari 36:16</ref>; <ref loc="ACT 7:52">Hawa 7:52</ref>.</char></note><verse eid="MAT 5:12"/></para>
  <para style="s1">Maxinenne Poo7o</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13"/>“Hinte biittas maxine; maxiney ba maxinetetha aggiko, ba mal7otetha waati zaari demmanee? Kare holin asan yedhetanaape attishin, aybiska maaddenna.<note caller="-" style="x"><char style="xo" closed="false">5:13 </char><char style="xt" closed="false"><ref loc="MRK 9:50">Mar 9:50</ref>; <ref loc="LUK 14:34-35">Luqa 14:34-35</ref>.</char></note><verse eid="MAT 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14"/>“Hinte biittas poo7o; zuma bolla de7iya katamiya qosetanaw danda7uku.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="JHN 8:12">Yoha 8:12</ref>; <ref loc="JHN 9:5">9:5</ref>.</char></note> <verse eid="MAT 5:14"/><verse number="15" style="v" sid="MAT 5:15"/>Xompe oythidi son de7iya asa ubbaas poo7ana mela dhoqa son wotheesipe attishin, daallo giddon wothey baawa.<note caller="-" style="x"><char style="xo" closed="false">5:15 </char><char style="xt" closed="false"><ref loc="MRK 4:21">Mar 4:21</ref>; <ref loc="LUK 8:16">Luqa 8:16</ref>; <ref loc="LUK 11:33">11:33</ref>.</char></note> <verse eid="MAT 5:15"/><verse number="16" style="v" sid="MAT 5:16"/>Hessa mela asay hinte lo77o oosuwa be7idi, salon de7iya hinte aawa bonchana mela hinte poo7oy asa sinthan poo7o.<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="1PE 2:12">1 Phex 2:12</ref>.</char></note><verse eid="MAT 5:16"/></para>
  <para style="s1">Muse Higge</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17"/>“Taani Muse higgiyanne nabeta qaala shaaranaw yida hintew daanopo. Taani, enti odidaysi tuma gideysa qoncisanaw yasipe attishin, shaaranaw yabiike. <verse eid="MAT 5:17"/><verse number="18" style="v" sid="MAT 5:18"/>Ta hintew tuma odayis; saloynne sa7i aadhana gakanaw higge ubbay poletanaape attishin, higgiyafe issi qaalay woyko pidaley aadhenna.<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="LUK 16:17">Luqa 16:17</ref>.</char></note> <verse eid="MAT 5:18"/><verse number="19" style="v" sid="MAT 5:19"/>Hessa gisho, ha kiitatape guuxiya issi kiitaa menthiya oonika qassi harata hessatho oothana mela tamaarsey oonika salo kawotethan ubbaafe guutha gidana. Shin ha kiitaa poleysinne harataka polana mela tamaarsey salo kawotethan gita gidana. <verse eid="MAT 5:19"/><verse number="20" style="v" sid="MAT 5:20"/>Ta hintew odayis; hinte xillotethay Farsaaweta xillotethaafenne higge astamaareta xillotethafe aadhona ixiko, salo kawotethaa geleketa.<verse eid="MAT 5:20"/></para>
  <para style="s1">Wodhoba</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21"/>“Hinte mayzatas, ‘Wodhopite; shempo wodhida oonika pirdetana’ geetetoysa si7ideta.<note caller="-" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="EXO 20:13">Kessa 20:13</ref>; <ref loc="DEU 5:17">Zaare 5:17</ref>.</char></note> <verse eid="MAT 5:21"/><verse number="22" style="v" sid="MAT 5:22"/>Shin ta hintew odayis; ba isha bolla hanqetiya ubbay pirdetana. Ba ishaa cayiya oonika daynna sinthe pirdas shiiqana. Ba ishaako, ‘Eeyay’ giya oonika qassi gaanname taman pirdetana.<verse eid="MAT 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23"/>“Hessa gisho, neeni ne yarshuwa yarshiya wode, ne isha qohidabay new akeeketiko, <verse eid="MAT 5:23"/><verse number="24" style="v" sid="MAT 5:24"/>ne yarshuwa he bessan aggada ba; koyrota bada ne ishaara giiga; yaata simmada, ne yarshuwa Xoossaas yarsha.<verse eid="MAT 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25"/>“Nena mooteysara pirda keethi bashe oge bolla iyara giiga. Hessi atto giiko I nena daynna sinthe efana. Daynnay nena qacheysas aathidi immana; I nena woynen yeggana. <verse eid="MAT 5:25"/><verse number="26" style="v" sid="MAT 5:26"/>Ta tuma odayis; ne bolla pirdetida acuwa issi santimey attonna cigga ongana gakanaw qasho keethafe keyaka.<verse eid="MAT 5:26"/></para>
  <para style="s1">Laymatethaba</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27"/>“Haysafe kase, ‘Laymatopite’ geetetoysa si7ideta.<note caller="-" style="x"><char style="xo" closed="false">5:27 </char><char style="xt" closed="false"><ref loc="EXO 20:14">Kessa 20:14</ref>; <ref loc="DEU 5:18">Zaare 5:18</ref>.</char></note> <verse eid="MAT 5:27"/><verse number="28" style="v" sid="MAT 5:28"/>Shin ta hintew odayis, maccas xeellidi, amotida ubbay ba wozanan iira laymatees. <verse eid="MAT 5:28"/><verse number="29" style="v" sid="MAT 5:29"/>Ne ushacha ayfey new nagaras gaaso gidiko, kessa hola. Ne asatethay kumethi gaanname taman wodhanaape ne asatethafe issoy dhayiko new lo77o.<note caller="-" style="x"><char style="xo" closed="false">5:29 </char><char style="xt" closed="false"><ref loc="MAT 18:9">Maato 18:9</ref>; <ref loc="MRK 9:47">Mar 9:47</ref>.</char></note> <verse eid="MAT 5:29"/><verse number="30" style="v" sid="MAT 5:30"/>Ne ushacha kushey new nagaras gaaso gidiko, iya qanxa hola. Ne asatethay kumethi gaanname taman wodhanaape ne asatethafe issoy dhayiko, new lo77o.<note caller="-" style="x"><char style="xo" closed="false">5:30 </char><char style="xt" closed="false"><ref loc="MAT 18:8">Maato 18:8</ref>; <ref loc="MRK 9:43">Mar 9:43</ref>.</char></note><verse eid="MAT 5:30"/></para>
  <para style="s1">Macho Anjoba</para>
  <para style="r">(<ref loc="MAT 19:9">Maato 19:9</ref>; <ref loc="MRK 10:11-12">Mar 10:11-12</ref>; <ref loc="LUK 16:18">Luqa 16:18</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31"/>“ ‘Ba machees anjo worqate immo’ geetetis.<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="MAT 19:7">Maato 19:7</ref>; <ref loc="MRK 10:4">Mar 10:4</ref>.</char></note> <verse eid="MAT 5:31"/><verse number="32" style="v" sid="MAT 5:32"/>Shin ta hintew odayis; ba machiya laymatonna de7ishin billiya oonika iya laymatana mela oothees. Hessadaka, anjetida maccasiw ekiya ubbay laymatees.<note caller="-" style="x"><char style="xo" closed="false">5:32 </char><char style="xt" closed="false"><ref loc="MAT 19:9">Maato 19:9</ref>; <ref loc="MRK 10:11-12">Mar 10:11-12</ref>; <ref loc="LUK 16:18">Luqa 16:18</ref>; <ref loc="2CO 7:10-11">2 Qoro 7:10-11</ref>.</char></note><verse eid="MAT 5:32"/></para>
  <para style="s1">Caaqoba</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33"/>“Hinte mayzatako, ‘Wordon caaqofite; hinte Xoossaa sinthan caaqidaysa polite’ geetetidaysa si7ideta.<note caller="-" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="LEV 19:12">Leewe 19:12</ref>; <ref loc="NUM 30:2">Taybo 30:2</ref>; <ref loc="DEU 23:21">Zaare 23:21</ref>.</char></note> <verse eid="MAT 5:33"/><verse number="34" style="v" sid="MAT 5:34"/>Shin ta hintew odayis; ubbaraka caaqofite. Xoossay uttiya araata gidiya gisho, salon caaqofite.<note caller="-" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="MAT 23:22">Maato 23:22</ref>.</char></note> <verse eid="MAT 5:34"/><verse number="35" style="v" sid="MAT 5:35"/>Iya tohoy yedhiya soo gidiya gisho, sa7anka caaqofite. Gita kawa katama gidiya gisho, Yerusalaamenka caaqofite.<note caller="-" style="x"><char style="xo" closed="false">5:35 </char><char style="xt" closed="false"><ref loc="ISA 66:1">Isa 66:1</ref>; <ref loc="PSA 48:2">Maz 48:2</ref>.</char></note> <verse eid="MAT 5:35"/><verse number="36" style="v" sid="MAT 5:36"/>Hinte binaanape issuwaka boothi woyko kareethi oothanaw danda7onna gisho, hinte, hinte huuphenka caaqofite. <verse eid="MAT 5:36"/><verse number="37" style="v" sid="MAT 5:37"/>Hessa gisho, hinte qaalay, ‘Ee’ woyko ‘Akay’ gido. Hessafe kare keyey Xalahepe yees.<verse eid="MAT 5:37"/></para>
  <para style="s1">Halo Keyopa</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38"/>“ ‘Ayfe gisho ayfe; acha gisho ache’ geetetidaysa si7ideta.<note caller="-" style="x"><char style="xo" closed="false">5:38 </char><char style="xt" closed="false"><ref loc="EXO 21:24">Kessa 21:24</ref>; <ref loc="LEV 24:20">Leewe 24:20</ref>; <ref loc="DEU 19:19">Zaare 19:19</ref>.</char></note> <verse eid="MAT 5:38"/><verse number="39" style="v" sid="MAT 5:39"/>Shin ta hintew odayis; hinte bolla iitabaa oothiya uraara eqetofite. Oonika ne ushacha shakala baqiko ne haddirsa shakala bessa. <verse eid="MAT 5:39"/><verse number="40" style="v" sid="MAT 5:40"/>Issi asi ne shamziya ekanaw nena mootiko, ne kootiya gujada imma. <verse eid="MAT 5:40"/><verse number="41" style="v" sid="MAT 5:41"/>Issi asi nena wolqan babaa toossidi issi saate oge baara baana mela nena un7ethiko, iyara nam7u saate oge ba. <verse eid="MAT 5:41"/><verse number="42" style="v" sid="MAT 5:42"/>Woossiya oodeska imma; neepe tal7anaw koyiya oonaka diggofa.<verse eid="MAT 5:42"/></para>
  <para style="s1">Ne Morketa Dosa</para>
  <para style="r">(<ref loc="LUK 6:27-36">Luqa 6:27-36</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43"/>“ ‘Nena doseysa dosa; nena ixeysa ixa’ geetetoysa si7ideta. <verse eid="MAT 5:43"/><verse number="44" style="v" sid="MAT 5:44"/>Shin ta hintew odayis; hinte morketa dosite; hintena qoheysatas woossite. <verse eid="MAT 5:44"/><verse number="45" style="v" sid="MAT 5:45"/>Hessatho hinte oothiko, salon de7iya hinte aawas hinte nayta gidana. I iitatasinne lo77otas awa kessees; xillotasinne nagaranchotas ba ira bukisees. <verse eid="MAT 5:45"/><verse number="46" style="v" sid="MAT 5:46"/>Hintena dosiya asaa xalaala hinte dosiko, hintew ay woytoy de7ii? Hari attoshin, qaraxa qanxiseysatika hessa oothosona. <verse eid="MAT 5:46"/><verse number="47" style="v" sid="MAT 5:47"/>Hinte, hinte ishata xalaala sarothiko, haratape ay hara aadhiyaba oothidetii? Hari attoshin, Xoossaa ammanonna asayka hessa oothosona. <verse eid="MAT 5:47"/><verse number="48" style="v" sid="MAT 5:48"/>Hiza, salon de7iya hinte aaway polo gidoysada hinteka polo gidite.”<note caller="-" style="x"><char style="xo" closed="false">5:48 </char><char style="xt" closed="false"><ref loc="LEV 19:2">Leewe 19:2</ref>; <ref loc="DEU 18:13">Zaare 18:13</ref>.</char></note><verse eid="MAT 5:48"/></para>
  <chapter eid="MAT 5"/>
  <chapter number="6" style="c" sid="MAT 6"/>
  <para style="s1">Manqotas Imoba</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1"/>“Asi be7o gidi hinte lo77o oosuwa asa sinthan oothonnaada naagetite. Hessatho hanonna ixiko salon de7iya hinte Aawape woyto demmeketa.<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="MAT 23:5">Maato 23:5</ref>.</char></note><verse eid="MAT 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2"/>“Hinte manqotas immiya wode asa sinthan bonchetanaw gidi cubboti ogiya doonaninne ayhude woosa keethatan ootheysada asi be7o gidi oothopite. Ta hintew tuma odayis; enti banta kumetha woytuwa ekidosona. <verse eid="MAT 6:2"/><verse number="3" style="v" sid="MAT 6:3"/>Shin hinte manqotas immiya wode hinte ushacha kushey ootheysa hinte haddirsa kushey eropo; <verse eid="MAT 6:3"/><verse number="4" style="v" sid="MAT 6:4"/>hinte imoy geeman gido. Geeman ootheysa be7iya hinte aaway hintew woytuwa qoncen immana.<verse eid="MAT 6:4"/></para>
  <para style="s1">Woosaba</para>
  <para style="r">(<ref loc="LUK 11:2-4">Luqa 11:2-4</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5"/>“Woosa woossishe cubbotatho hanopite. Enti, bantana asi be7o gidi ayhude woosa keethaninne ogiya doonan eqidi woosseysa dosoosona. Ta hintew tuma odayis; enti banta kumetha woytuwa ekidosona.<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="LUK 18:10-14">Luqa 18:10-14</ref>.</char></note> <verse eid="MAT 6:5"/><verse number="6" style="v" sid="MAT 6:6"/>Shin neeni woossiya wode, ne soo gela, wulaa gordada geeman de7iya ne Aawa woossa; geeman oosetidaysa be7iya ne aaway new woytuwa immana. <verse eid="MAT 6:6"/><verse number="7" style="v" sid="MAT 6:7"/>Hinte woossiya wode ammanonna asatho coo qaala darsidi woossofite. Enti adussi woossin Xoossay si7ees gidi qopoosona. <verse eid="MAT 6:7"/><verse number="8" style="v" sid="MAT 6:8"/>Hessa gisho, entaysada hanopite. Ayis giiko, hinte aaway hintew ay koshshiyako hinte woossanaape sinthatidi erees.<verse eid="MAT 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9"/>“Hiza, hinte yaagidi woossite:</para>
  <para style="q1" vid="MAT 6:9">“ ‘Salon de7iya nu aawaw,</para>
  <para style="q2" vid="MAT 6:9">ne geeshsha sunthay anjeto.<verse eid="MAT 6:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10"/>Ne kawotethay yo,</para>
  <para style="q2" vid="MAT 6:10">ne sheney salon hanidaysada</para>
  <para style="q2" vid="MAT 6:10">sa7anka hano.<verse eid="MAT 6:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MAT 6:11"/>Gallasa kathaa hachi hachi nuus imma.<verse eid="MAT 6:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="MAT 6:12"/>Nuuni nuna qohidaysata, atto geysada,</para>
  <para style="q2" vid="MAT 6:12">nuuska nu qohuwa atto ga.<verse eid="MAT 6:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="MAT 6:13"/>Nuna iitape ashshafe attishin,</para>
  <para style="q2" vid="MAT 6:13">paacen gelsofa.</para>
  <para style="q1" vid="MAT 6:13">[Kawotethay, wolqaynne bonchoy</para>
  <para style="q2" vid="MAT 6:13">merinaw neesa; Amin7i.’]<verse eid="MAT 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14"/>“Hinte hintena qohidaysata atto giiko, salon de7iya hinte Aaway hinte qohuwaka atto gaana.<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="MRK 11:25-26">Mar 11:25-26</ref>.</char></note> <verse eid="MAT 6:14"/><verse number="15" style="v" sid="MAT 6:15"/>Shin hinte hara asa nagara atto goonna ixiko hinte Aaway hinte nagara atto geenna.<verse eid="MAT 6:15"/></para>
  <para style="s1">Xoomaba</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16"/>“Hinte xoomiya wode cubbotatho kayotofite. Ayis giiko, enti xoomeysa asi erana mela banta som7uwa qitayoosona. Ta tuma odayis; enti banta woytuwa ekidosona.<verse eid="MAT 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 6:17"/>“Shin neeni xoomiya wode ne som7uwa meecca, ne huuphiya tiyetta. <verse eid="MAT 6:17"/><verse number="18" style="v" sid="MAT 6:18"/>Hessada ne oothiko ne xoomiya xoomay asape geemmidaysa, shin geeman de7iya ne Aaway eriya xooma gidana. Geeman oosetidaysa be7iya ne Aaway new woytuwa immana.<verse eid="MAT 6:18"/></para>
  <para style="s1">Salon Shalo Shiisho</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19"/>“Bili miya bessan, birati shi7iyason, kaysoy bookidi ekiyason, ha sa7an, hintew shalo shiishopite.<note caller="-" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="JAS 5:2">Yay 5:2</ref>.</char></note> <verse eid="MAT 6:19"/><verse number="20" style="v" sid="MAT 6:20"/>Shin bili moonnason, birati shi7onnason, kaysoy bookidi ekonnason salon hintew shalo shiishite. <verse eid="MAT 6:20"/><verse number="21" style="v" sid="MAT 6:21"/>Ne shaloy de7iyasuwan ne wozanay de7ana.<verse eid="MAT 6:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22"/>“Ayfey asatethas xompe. Hessa gisho, ne ayfey paxa gidiko ne kumetha asatethay poo7o gidees. <verse eid="MAT 6:22"/><verse number="23" style="v" sid="MAT 6:23"/>Ne ayfey hargancho gidiko ne kumetha asatethay dhuma gidees. Hiza, nenan de7iya poo7oy dhuma gidiko, dhumay ay mela aadhidi dhumandeesha!<verse eid="MAT 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24"/>“Issi asi nam7u godaas haaretanaw danda7enna. Issuwa dosiko hankuwa ixees; woyko issuwa bonchiko hankuwa kadhees. Xoossasinne miishes haaretanaw danda7eketa.<verse eid="MAT 6:24"/></para>
  <para style="s1">Un7etofite</para>
  <para style="r">(<ref loc="LUK 12:22-31">Luqa 12:22-31</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25"/>“Hiza, si7ite! Hinte de7on daanaw, ‘Ay maanee? Ay uyanee? Ay ma7anee?’ gidi un7etofite; de7oy kathafe woyko asatethi ma7ope aadhenee? <verse eid="MAT 6:25"/><verse number="26" style="v" sid="MAT 6:26"/>Salo kafota xeellite; enti zerokona, buucokona, shaalen yeggokona, shin hinte salo aaway enta muzees. Hinte entafe daro aadheketii? <verse eid="MAT 6:26"/><verse number="27" style="v" sid="MAT 6:27"/>Hinte giddofe daro un7etidi ba laytha bolla issi gallas gujanaw danda7ey de7ii?<verse eid="MAT 6:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28"/>“Qassi hinte ma7iyabaas ayis un7etetii? Ane ciishshata be7ite, ooson daaburokona woyko suqokona. <verse eid="MAT 6:28"/><verse number="29" style="v" sid="MAT 6:29"/>Si7ite! Hari attoshin, kawa Solomoney ba boncho ubban ha ciishshatape issuwa melaka ma7ibeenna.<note caller="-" style="x"><char style="xo" closed="false">6:29 </char><char style="xt" closed="false"><ref loc="1KI 10:4-7">1 Kawo 10:4-7</ref>; <ref loc="2CH 9:3-6">2 Taari 9:3-6</ref>.</char></note> <verse eid="MAT 6:29"/><verse number="30" style="v" sid="MAT 6:30"/>Hinteno, ammanoy pacidaysato, Xoossay hachi bentidi wonto taman wodhanaw de7iya maata yaatidi mayziyaba gidiko, hintena entafe aathidi waati mayzennee? <verse eid="MAT 6:30"/><verse number="31" style="v" sid="MAT 6:31"/>Hessa gisho, ‘Ay maanee? Ay uyanee? Ay ma7anee?’ gidi un7etofite. <verse eid="MAT 6:31"/><verse number="32" style="v" sid="MAT 6:32"/>He ubbaa Xoossaa ammanonna asay darsidi demmanaw un7etoosona. Hinte salo aaway he ubbay hintew koshsheysa erees. <verse eid="MAT 6:32"/><verse number="33" style="v" sid="MAT 6:33"/>Shin ubbaafe sinthe Xoossaa kawotethaanne iya xillotethaa koyite; he ubbay hintew guji imetana. <verse eid="MAT 6:33"/><verse number="34" style="v" sid="MAT 6:34"/>Hessa gisho, wontos qopishe un7etofite. Wontoysi wontos aqo; issi issi gallasay baw gidiya metora de7ees.<verse eid="MAT 6:34"/></para>
  <chapter eid="MAT 6"/>
  <chapter number="7" style="c" sid="MAT 7"/>
  <para style="s1">Asa Bolla Pirdofa</para>
  <para style="r">(<ref loc="LUK 6:37-42">Luqa 6:37-42</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1"/>“Hinte bolla pirdetonna mela harata bolla pirdofite. <verse eid="MAT 7:1"/><verse number="2" style="v" sid="MAT 7:2"/>Ayis giiko, harata bolla hinte pirdeysada hinte bolla pirdetana; hinte haratas makidaban hintew zaari maketana.<note caller="-" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="MRK 4:24">Mar 4:24</ref>.</char></note> <verse eid="MAT 7:2"/><verse number="3" style="v" sid="MAT 7:3"/>Ne ayfen de7iya tuussu daaneysa be7onna ne ishaa ayfen de7iya buuriya ayis be7ay? <verse eid="MAT 7:3"/><verse number="4" style="v" sid="MAT 7:4"/>Ne ayfen tuussi de7ishin ne ishaa ayfen de7iya buuriya kesso gaanaw waana danda7ay? <verse eid="MAT 7:4"/><verse number="5" style="v" sid="MAT 7:5"/>Neno cubbuwaw, koyrottada ne ayfen de7iya tuussi daaneysa kessa. Iyape guye, ne ishaa ayfen de7iya buuriya kessanaw ne geeshsha xeellana.<verse eid="MAT 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6"/>“Guye simmidi hintena saxona mela geeshshaba kanatas yeggofite. Banta tohuwan yedhidi iissonna mela hinte al7o inquwa gudunthota sinthan yeggofite.<verse eid="MAT 7:6"/></para>
  <para style="s1">Woossite Koyte Xeegite</para>
  <para style="r">(<ref loc="LUK 11:9-13">Luqa 11:9-13</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7"/>“Woossite hintew imetana, koyite hinte demmana, kare yidi xeegite hintew dooyetana. <verse eid="MAT 7:7"/><verse number="8" style="v" sid="MAT 7:8"/>Woossiya oodeska imetana, koyiya oodeska bentana, kare yidi xeegiya oodeska dooyetenna.<verse eid="MAT 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 7:9"/>“Hinte giddofe ba na7i uythi woossiko shuchi immey oonee? <verse eid="MAT 7:9"/><verse number="10" style="v" sid="MAT 7:10"/>Woyko molo woossiko shooshi immey de7ii? <verse eid="MAT 7:10"/><verse number="11" style="v" sid="MAT 7:11"/>Yaatin hinte iita gidishe hinte naytas lo77oba imo eriko, hinte salo aaway bana woosseysatas lo77oba waati darsidi immenee? <verse eid="MAT 7:11"/><verse number="12" style="v" sid="MAT 7:12"/>Harati hintew oothana mela hinte koyaba ubbaa hinteka haratas oothite. Ayis giiko, Muse higgeynne nabeti tamaarsey haysa.<note caller="-" style="x"><char style="xo" closed="false">7:12 </char><char style="xt" closed="false"><ref loc="LUK 6:31">Luqa 6:31</ref>.</char></note><verse eid="MAT 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13"/>“Xuuntha wulara gelite; ayis giiko, dhayos efiya ogey wogga, wulayka dalga. Iyara geliya asayka daro. <verse eid="MAT 7:13"/><verse number="14" style="v" sid="MAT 7:14"/>Shin de7uwako efiya ogeynne wulay xuunthu; yaa geliya asayka guutha.<verse eid="MAT 7:14"/></para>
  <para style="s1">Mithi Ba Ayfen Eretees</para>
  <para style="r">(<ref loc="LUK 6:43-44">Luqa 6:43-44</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15"/>“Bolla baggara dorse daanidi banta gaathan suudhume gididi hinte giddo geliya wordancho nabetape naagetite.<figure style="fig" alt="Sheep and wolves" file="LB00011B.tif" size="span" ref="7:15">Dorsenne Suudhuma</figure> <verse eid="MAT 7:15"/><verse number="16" style="v" sid="MAT 7:16"/>Hinte enta, enta ayfiyape erana; agunthafe woyney, kinchotepe laadey maxetenna. <verse eid="MAT 7:16"/><verse number="17" style="v" sid="MAT 7:17"/>Hessa mela lo77o mithi ubbay lo77o ayfe ayfees; iita mithi iita ayfe ayfees. <verse eid="MAT 7:17"/><verse number="18" style="v" sid="MAT 7:18"/>Lo77o mithi iita ayfe ayfena, qassi iita mithi lo77o ayfe ayfanaw danda7enna. <verse eid="MAT 7:18"/><verse number="19" style="v" sid="MAT 7:19"/>Lo77o ayfe ayfonna mithi ubbay qanxetidi taman xuugetana.<note caller="-" style="x"><char style="xo" closed="false">7:19 </char><char style="xt" closed="false"><ref loc="MAT 3:10">Maato 3:10</ref>; <ref loc="LUK 3:9">Luqa 3:9</ref>.</char></note> <verse eid="MAT 7:19"/><verse number="20" style="v" sid="MAT 7:20"/>Hessa gisho, hinte enta, enta ayfiyan erana.<note caller="-" style="x"><char style="xo" closed="false">7:20 </char><char style="xt" closed="false"><ref loc="MAT 12:33">Maato 12:33</ref>.</char></note><verse eid="MAT 7:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21"/>“Salon de7iya ta aawa sheniya oothiya uray salo kawotethi gelanaape attishin, coo tana ‘Godaw, Godaw’ giya ubbay salo kawotethi gelenna. <verse eid="MAT 7:21"/><verse number="22" style="v" sid="MAT 7:22"/>Pirda gallas daroti, ‘Godaw, Godaw, ne sunthan tinbite odibooko? Ne sunthan tuna ayyaanata kessibooko? Ne sunthan malaatata oothibooko?’ yaagana. <verse eid="MAT 7:22"/><verse number="23" style="v" sid="MAT 7:23"/>He wode taani, ‘Ta hintena ubbaraka erike, hinte iita ootheysati taape haakite’ yaagana.<note caller="-" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="PSA 6:8">Maz 6:8</ref>.</char></note><verse eid="MAT 7:23"/></para>
  <para style="s1">Keethe Keexiya Nam7u Asata</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24"/>“Hiza, ha ta qaala si7idi oothiya oonika ba keethaa shucha bolla keexida wozanaama asa mela. <verse eid="MAT 7:24"/><verse number="25" style="v" sid="MAT 7:25"/>Iray bukis, di7oy di77is, carkoyka carkidi he keethaa sugis. Shin keethay shucha baaso bolla keexetida gisho kundibeenna. <verse eid="MAT 7:25"/><verse number="26" style="v" sid="MAT 7:26"/>Ha ta qaala si7idi oothonna oonika ba keethaa shafe bolla keexida eeya uraa mela. <verse eid="MAT 7:26"/><verse number="27" style="v" sid="MAT 7:27"/>Iray bukidi, di7oy di77idi, carkoyka carkidi, he keethaa sugin, he keethay kundis; iya kundethayka wolqaama” yaagis.<verse eid="MAT 7:27"/></para>
  <para style="p">
    <verse number="28-29" style="v" sid="MAT 7:28-29"/>Yesuusi ba oda ongida wode iya timirtey higge astamaareta mela gidonashin, maatara gidiya gisho asay iya timirtiyan malaaletidosona.<note caller="-" style="x"><char style="xo" closed="false">7:28-29 </char><char style="xt" closed="false"><ref loc="MRK 1:22">Mar 1:22</ref>; <ref loc="LUK 4:32">Luqa 4:32</ref>.</char></note><verse eid="MAT 7:28-29"/></para>
  <chapter eid="MAT 7"/>
  <chapter number="8" style="c" sid="MAT 8"/>
  <para style="s1">Baro Harganchoy Paxis</para>
  <para style="r">(<ref loc="MRK 1:40-45">Mar 1:40-45</ref>; <ref loc="LUK 5:12-16">Luqa 5:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1"/>Yesuusi zumaape wodhiya wode daro asay iya kaallidosona. <verse eid="MAT 8:1"/><verse number="2" style="v" sid="MAT 8:2"/>Heko issi baro harganchoy iyako shiiqidi, iya sinthan gulbatidi, “Godaw, ne shene gidiko tana geeshshada pathanaw danda7aasa” yaagis. <verse eid="MAT 8:2"/><verse number="3" style="v" sid="MAT 8:3"/>Yesuusi ba kushiya yeddidi iya bochidi, “Ee, ta shene, paxa” yaagis. Uray iiraka geeyi aggis. <verse eid="MAT 8:3"/><verse number="4" style="v" sid="MAT 8:4"/>Yesuusi iyako, “Ne paxuwa oodeska odopa. Shin bada ne geeyada paxoysa kahine bessa. Ne paxuwas marka gidana mela bada Musey kiitida yarshuwa yarsha” yaagis.<note caller="-" style="x"><char style="xo" closed="false">8:4 </char><char style="xt" closed="false"><ref loc="LEV 14:1">Leewe 14:1</ref>.</char></note><verse eid="MAT 8:4"/></para>
  <para style="s1">Mato Halaqa Ammano</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5"/>Yesuusi Qifirnahooma katama gakida wode, issi mato halaqay iyako shiiqidi, <verse eid="MAT 8:5"/><verse number="6" style="v" sid="MAT 8:6"/>“Godaw, ta aylley asatethay gundin daro hargetidi, son zin7idi de7ees” yaagidi woossis.<verse eid="MAT 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7"/>Yesuusi zaaridi, “Taani bada iya pathana” yaagis.<verse eid="MAT 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8"/>Shin mato halaqay zaaridi, “Godaw, ne ta soo gelanaw bessiya asi gidike, shin ne han uttada qaala xalaala oda, ta aylley paxana. <verse eid="MAT 8:8"/><verse number="9" style="v" sid="MAT 8:9"/>Ayis giiko, taape bollara tana kiittiya asati de7oosona, qassi taape garsara taw kiiteteysati de7oosona. Entafe issuwa, ‘Ba’ giyade bees; hankuwa qassi ‘Haaya!’ giyade yees. Ta aylliya, ‘Haysa ootha’ giyade oothees” yaagis.<verse eid="MAT 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10"/>Yesuusi hessa si7ida wode malaaletidi, bana kaalliya asaako, “Ta hintew tuma odayis; taani haysa mela ammano Isra7eele asanka be7abike. <verse eid="MAT 8:10"/><verse number="11" style="v" sid="MAT 8:11"/>Ta hintew odayis; daroti dolohapenne wulohape yidi, salo kawotethan Abrahaamera, Yisaaqaranne Yayqoobara issife imato bolla uttana.<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="LUK 13:29">Luqa 13:29</ref>.</char></note> <verse eid="MAT 8:11"/><verse number="12" style="v" sid="MAT 8:12"/>Shin salo kawotethaa laattanaw bessishin attidaysati kare dhuman holetana. Yan entaw yeehonne acha garcethi gidana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 22:13">Maato 22:13</ref>; <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">Luqa 13:28</ref>.</char></note><verse eid="MAT 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 8:13"/>Yesuusi mato halaqaako, “Ne soo ba, ne ammanuwatho new hano” yaagis. Iya aylley iiraka paxi aggis.<verse eid="MAT 8:13"/></para>
  <para style="s1">Yesuusi Daro Harganchota Pathis</para>
  <para style="r">(<ref loc="MRK 1:29-34">Mar 1:29-34</ref>; <ref loc="LUK 4:38-41">Luqa 4:38-41</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14"/>Yesuusi Phexroosa soo geliya wode, Phexroosa mache aayiya qoxo misha hargen saketada zin7idaaro be7is. <verse eid="MAT 8:14"/><verse number="15" style="v" sid="MAT 8:15"/>Yesuusi I kushiya bochida wode qoxoynne mishay aggaagis. Paxa dendada iya mokasu.<verse eid="MAT 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16"/>He wode omarsi tuna ayyaanan oyketida daro asata, asay Yesuusako ehidosona. Ika tuna ayyaanata ba qaalan kessis, harganchota ubbaa pathis. <verse eid="MAT 8:16"/><verse number="17" style="v" sid="MAT 8:17"/>Hessanka nabiya Isayaasi,</para>
  <para style="q1" vid="MAT 8:17">“I nu hargiya baw ekis,</para>
  <para style="q2" vid="MAT 8:17">nu daabura tookis”</para>
  <para style="m" vid="MAT 8:17">gida qaalay poletis.<note caller="-" style="x"><char style="xo" closed="false">8:17 </char><char style="xt" closed="false"><ref loc="ISA 53:4">Isa 53:4</ref>.</char></note><verse eid="MAT 8:17"/></para>
  <para style="s1">Yesuusa Kaaloy Cigsiya Gate</para>
  <para style="r">(<ref loc="LUK 9:57-62">Luqa 9:57-62</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18"/>Yesuusi daro asay iya yuushuwan eqidaysa be7idi, abbaafe hefinthi pinnana mela ba tamaareta kiittis. <verse eid="MAT 8:18"/><verse number="19" style="v" sid="MAT 8:19"/>Higge astamaaretape issoy, “Astamaariyaw, ne biya bessa ubbaa ta kaallana” yaagis.<verse eid="MAT 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20"/>Yesuusi iyako “Workanatas olli de7ees, salo kafotas keethi de7ees. Shin Asa Na7aas ba huuphiya shempisiya bessi baawa” yaagis.<verse eid="MAT 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21"/>Yesuusa kaalliya asatape issoy, “Godaw, taani sinthata bada ta aawa moogada yaana” yaagis.<verse eid="MAT 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22"/>Shin Yesuusi, “Hayqidaysati banta hayqota moogo; neeni tana kaalla” yaagis.<verse eid="MAT 8:22"/></para>
  <para style="s1">Yesuusi Hobbiya Seeris</para>
  <para style="r">(<ref loc="MRK 4:35-41">Mar 4:35-41</ref>; <ref loc="LUK 8:22-25">Luqa 8:22-25</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23"/>Yesuusi baanaw wogoluwan gelida wode, iya tamaaretika iyara baanaw gelidosona. <verse eid="MAT 8:23"/><verse number="24" style="v" sid="MAT 8:24"/>Enti qoponna de7ishin, wolqaama hobbey haatha bolla dendin wogoloy mitettanaw gakis. Shin Yesuusi dhiskis. <verse eid="MAT 8:24"/><verse number="25" style="v" sid="MAT 8:25"/>Iya tamaareti iyako shiiqidi iya barkethidi, “Godaw, nu dhayos nuna ashsharki” yaagidosona.<verse eid="MAT 8:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26"/>Yesuusi entako, “Hinteno, ammanoy pacidaysato, ayis yayyetii?” yaagis. Dendidi, hobbiyanne gotiya essis. Ellesidi ubbabay si77i gis.<verse eid="MAT 8:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27"/>Iya tamaareti malaaletidi, “Haysi, hari attoshin, hobbeynne gotey kiiteteysi waanida asee?” yaagidosona.<verse eid="MAT 8:27"/></para>
  <para style="s1">Tuna Ayyaani Oykida Nam7u Asata</para>
  <para style="r">(<ref loc="MRK 5:1-20">Mar 5:1-20</ref>; <ref loc="LUK 8:26-39">Luqa 8:26-39</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28"/>Yesuusi abbaafe hefinthan de7iya Gergesoone biitta gakida wode tuna ayyaanay oykida nam7u asati duufope keyidi iyara gahetidosona. Enti daro iitanne yashshiya asata gidiya gisho asi he bessaara aadhanaw danda7enna. <verse eid="MAT 8:28"/><verse number="29" style="v" sid="MAT 8:29"/>Entika, “Xoossaa Na7aw, nunanne nena aybe gathey? Wodey gakonna de7ishin nuna pirdanaw yadii?” gidi waassidosona.<verse eid="MAT 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30"/>Entafe daro haakonna guduntho wudey hemetees. <verse eid="MAT 8:30"/><verse number="31" style="v" sid="MAT 8:31"/>Tuna ayyaanati Yesuusa, “Ne nuna kessanaba gidiko, hini guduntho wudiya giddo yeddarki” yaagidi woossidosona.<verse eid="MAT 8:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32"/>Yesuusi, “Biite” yaagis. Tuna ayyaanati asatape keyidi gudunthotan gelidosona. Gudunthoti ubbay aafo doonara dirgidi bidi abban mitetidi hayqidosona.<verse eid="MAT 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33"/>Guduntho wudiya heemmeysati baqatidi katama bidi, hanidabaanne tuna ayyaanay oykida asata bolla oosetidaba ubbaa odidosona. <verse eid="MAT 8:33"/><verse number="34" style="v" sid="MAT 8:34"/>Yaatin, kataman de7iya asa ubbay Yesuusa be7anaw keyidosona. Enti Yesuusa be7ida wode banta biittafe keyidi baana mela woossidosona.<verse eid="MAT 8:34"/></para>
  <chapter eid="MAT 8"/>
  <chapter number="9" style="c" sid="MAT 9"/>
  <para style="s1">Gunda Ura</para>
  <para style="r">(<ref loc="MRK 2:1-12">Mar 2:1-12</ref>; <ref loc="LUK 5:17-26">Luqa 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1"/>Hessafe guye, Yesuusi wogoluwan gelidi, abba pinnidi ba katamaa bis. <verse eid="MAT 9:1"/><verse number="2" style="v" sid="MAT 9:2"/>Hanida guutha asati issi gunda ura algara tookidi Yesuusako ehidosona. Yesuusi enta ammanuwa be7idi, gunda uraa, “Ta na7aw, yayyofa; ne nagaray atto geetetis” yaagis.<verse eid="MAT 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3"/>He saatiyan, Ayhude higge astamaaretape issoti issoti, “Haysi Xoossaa cashshe gidenne” yaagidi banta wozanan qopidosona.<verse eid="MAT 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4"/>Yesuusi enta qofaa eridi, “Iitabaa hinte wozanan ayis qopeetii? <verse eid="MAT 9:4"/><verse number="5" style="v" sid="MAT 9:5"/>Hanoshin, ‘Ne nagaray atto geetetis’ geysafenne ‘Denda eqada ba’ geysafe awusi kawuyii? <verse eid="MAT 9:5"/><verse number="6" style="v" sid="MAT 9:6"/>Shin sa7a bolla nagara atto gaanaw Asa Na7aas maati de7eysa ta hintena erisana” yaagidi, gunda addiyako, “Denda eqa, ne algaa tookada, ne soo ba” yaagis.<verse eid="MAT 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7"/>Gunda uray dendidi ba soo bis. <verse eid="MAT 9:7"/><verse number="8" style="v" sid="MAT 9:8"/>Derey hessa be7idi malaaletidosona. Hessa mela maata asas immida Xoossaa galatidosona.<verse eid="MAT 9:8"/></para>
  <para style="s1">Maatosa Xeegetethi</para>
  <para style="r">(<ref loc="MRK 2:13-17">Mar 2:13-17</ref>; <ref loc="LUK 5:27-32">Luqa 5:27-32</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9"/>Yesuusi yaape dendidi bishe Maatosa geysa qaraxa qanxisiya bessan uttidashin be7idi, “Tana kaalla” yaagis.</para>
  <para style="p" vid="MAT 9:9">Ika dendidi kaallis.<verse eid="MAT 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10"/>Yesuusi Maatosa son gayta bolla uttidashin, qaraxa qanxisiya daro asatinne nagaranchoti yidi iyaranne iya tamaaretara issife maanaw uttidosona.<note caller="-" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="LUK 15:1-2">Luqa 15:1-2</ref>.</char></note> <verse eid="MAT 9:10"/><verse number="11" style="v" sid="MAT 9:11"/>Issi issi Farsaaweti hessa be7idi, Yesuusa tamaareta, “Hinte astamaarey qaraxa qanxiseysataranne nagaranchotara ayis mii?” yaagidosona.<verse eid="MAT 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12"/>Yesuusi hessa si7idi, “Dhale koshshey harganchotasafe attishin, paxatasa gidenna. <verse eid="MAT 9:12"/><verse number="13" style="v" sid="MAT 9:13"/>Shin hinte bidi, ‘Taani hinte yarshuwa gidonashin hinte harata maarana mela koyayis’ geetetidi xaafetidaysi ay guusseko erite. Ayis giiko, taani nagaranchota xeeganaw yasipe attishin, xillota xeeganaw yabiike” yaagis.<note caller="-" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAT 12:7">Maato 12:7</ref>; <ref loc="HOS 6:6">Hose 6:6</ref>.</char></note><verse eid="MAT 9:13"/></para>
  <para style="s1">Yesuusi Xoomaba Oyshetis</para>
  <para style="r">(<ref loc="MRK 2:18-22">Mar 2:18-22</ref>; <ref loc="LUK 5:33-39">Luqa 5:33-39</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14"/>He wode Yohaanisa tamaareti Yesuusako shiiqidi, “Nunne Farsaaweti xoomos, shin ne tamaareti ayis xoomokonaa?” yaagidi oychidosona.<verse eid="MAT 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15"/>Yesuusi zaaridi entako, “Machiw ekeysi entara de7ishin xeegetidi yida asay kayotanaw danda7onna? Mushuray enta matape eketana wodey yaana, enti he wode xoomana.<verse eid="MAT 9:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16"/>“Ooratha ma7ope peedhidi gal7a ma7o bolla sikey oonika baawa. Hessatho oothiko oorathay gal7a peedhees. Peedhethayka guji dalgees. <verse eid="MAT 9:16"/><verse number="17" style="v" sid="MAT 9:17"/>Ooratha woyne gal7a ogoron qoliya oonika baawa. Hessatho oothiko ooratha woyney gal7a ogoruwa dhusees woyneyka gukees; ogoroyka nam7antho maaddonnaba gidees. Shin ooratha woyney ooratha ogoron qoletanaw bessees. Hessatho oosetiko nam7ayka iitonna naagetoosona” yaagis. <figure style="fig" alt="Wineskin" file="LB00145B.tif" size="col" ref="9:17">Woyne Ogoro</figure><verse eid="MAT 9:17"/></para>
  <para style="s1">Hayqida Na7iwunne Hargetiya Maccasiw</para>
  <para style="r">(<ref loc="MRK 5:21-43">Mar 5:21-43</ref>; <ref loc="LUK 8:40-56">Luqa 8:40-56</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18"/>Yesuusi hessa odo bolla de7ishin, Ayhude halaqatape issoy iyako yidi, iya sinthan gulbatidi, “Ta na7iya ha77i hayqasu, shin iya paxana mela neeni yada ne kushiya I bolla wotharki” gidi woossis. <verse eid="MAT 9:18"/><verse number="19" style="v" sid="MAT 9:19"/>Yesuusi dendidi iyara bis; iya tamaaretika kaallidosona.<verse eid="MAT 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20"/>I bishin tammanne nam7u laythi kumethi suuthi goggidi waaysiya issi maccasiya guyera shiiqada Yesuusa afilaa macaraa bochasu. <verse eid="MAT 9:20"/><verse number="21" style="v" sid="MAT 9:21"/>Iya ba wozanan, “Ta iya afilaa macaraa xalaala bochiyako paxana” yaagada qopasu.<verse eid="MAT 9:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22"/>Yesuusi guye simmi iyo xeellidi, “Ta naatte, yayyofa! Nena ne ammanoy pathis” yaagis. Maccasiya ellesada paxa aggasu.<verse eid="MAT 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23"/>Yesuusi Ayhude halaqaa soo gakiya wode zaye punneysatanne yeekeyisata be7idi, <verse eid="MAT 9:23"/><verse number="24" style="v" sid="MAT 9:24"/>“Ane kichite; guutha na7iya dhiskasupe attishin, hayqabuuku” yaagis. Shin asay iya bolla miicidosona. <verse eid="MAT 9:24"/><verse number="25" style="v" sid="MAT 9:25"/>Asaa kare kessidaape guye soo gelidi, na7e kushiya oykis, na7iya denda eqasu. <verse eid="MAT 9:25"/><verse number="26" style="v" sid="MAT 9:26"/>He worey he biitta ubbaa gakis.<verse eid="MAT 9:26"/></para>
  <para style="s1">Nam7u Qooqe Asata</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27"/>Yesuusi yaape dendidi gede sinthe biya wode nam7u qooqeti banta qaala dhoqu oothidi, “Dawita na7aw, nuna maararki” yaagishe iya kaallidosona.<verse eid="MAT 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28"/>Yesuusi soo gelida wode qooqeti iya kaallidi yidosona. Yesuusi entako, “Taani hessa oothanaw danda7eysa hinte ammanetii?” yaagis.</para>
  <para style="p" vid="MAT 9:28">Entika, “Ee, Godaw” yaagidi zaaridosona.<verse eid="MAT 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29"/>Hessafe guye, Yesuusi enta ayfiya bochidi entako, “Hintew, hinte ammanuwatho hano” yaagis. <verse eid="MAT 9:29"/><verse number="30" style="v" sid="MAT 9:30"/>Enta ayfeyka dooyetis. Yesuusi entako, “Haysa oodeska odopite” yaagidi minthi odis. <verse eid="MAT 9:30"/><verse number="31" style="v" sid="MAT 9:31"/>Shin asati bidi Yesuusaba he biitta ubban odidosona.<verse eid="MAT 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32"/>Enti yaape keyiya wode asay tuna ayyaanay oykidi muumisida issi asi Yesuusako ehidosona. <verse eid="MAT 9:32"/><verse number="33" style="v" sid="MAT 9:33"/>Tuna ayyaanay keydaape guye muume uray odetis. Dereyka malaaletidi, “Haysa mela oorathabay Isra7eele biittan hanibeenna” yaagidosona.<verse eid="MAT 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34"/>Shin Farsaaweti, “Tuna ayyaanata halaqan tuna ayyaanata kessees” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="MAT 10:25">Maato 10:25</ref>; <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">Mar 3:22</ref>; <ref loc="LUK 11:15">Luqa 11:15</ref>.</char></note><verse eid="MAT 9:34"/></para>
  <para style="s1">Oosanchoti Guutha</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35"/>Yesuusi ayhude woosa keethatan tamaarsishe, salo kawotethaa Wongela sabbakishe, asaa harge ubbaafe pathishe katamataninne guta ubban yuuyis.<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Maato 4:23</ref>; <ref loc="MRK 1:39">Mar 1:39</ref>; <ref loc="LUK 4:44">Luqa 4:44</ref>.</char></note> <verse eid="MAT 9:35"/><verse number="36" style="v" sid="MAT 9:36"/>Daro derey, heemmiya asi bayna dorsada entana be7iya asi dhayin un7etidi de7eyisata be7idi entaw qadhetis.<note caller="-" style="x"><char style="xo" closed="false">9:36 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Taybo 27:17</ref>; <ref loc="1KI 22:17">1 Kawo 22:17</ref>; <ref loc="2CH 18:16">2 Taari 18:16</ref>; <ref loc="EZK 34:5">Hiz 34:5</ref>; <ref loc="MRK 6:34">Mar 6:34</ref>.</char></note> <verse eid="MAT 9:36"/><verse number="37" style="v" sid="MAT 9:37"/>Ba tamaaretako, “Shiiqana kathay daro, shin kathaa shiishiya asay guutha.<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="LUK 10:2">Luqa 10:2</ref>.</char></note> <verse eid="MAT 9:37"/><verse number="38" style="v" sid="MAT 9:38"/>Hessa gisho, Goday kathaa shiishiya oosanchota yeddana mela woossite” yaagis.<verse eid="MAT 9:38"/></para>
  <chapter eid="MAT 9"/>
  <chapter number="10" style="c" sid="MAT 10"/>
  <para style="s1">Tammanne Nam7u Hawaareta</para>
  <para style="r">(<ref loc="MRK 3:13-19">Mar 3:13-19</ref>; <ref loc="LUK 6:12-16">Luqa 6:12-16</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1"/>Yesuusi tammanne nam7u tamaareta baako xeegidi, tuna ayyaanata kessana melanne harge ubbaa pathana mela entaw maata immis.<verse eid="MAT 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2"/>Yesuusi kiitida tammanne nam7u hawaareta sunthay: koyroy Phexroosa geetetiya Simoonanne iya ishaa Indiriyasa, Zabdiyoosa na7aa Yayqoobanne iya ishaa Yohaanisa, <verse eid="MAT 10:2"/><verse number="3" style="v" sid="MAT 10:3"/>Filphoosanne Bartelemoosa, Toomasanne qaraxa qanxisiya Maatosa, Ilfiyoosa na7aa Yayqooba, Taadiyosa, <verse eid="MAT 10:3"/><verse number="4" style="v" sid="MAT 10:4"/>ba biittas mishetiya Simoonanne Yesuusa aathidi immida Asqoroota Yihuda.<verse eid="MAT 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5"/>He tammanne nam7ata Yesuusi kiittidi yeddishe, “Ayhude gidonna deriyako boopite, qassi Samaareta katamaka gelopite. <verse eid="MAT 10:5"/><verse number="6" style="v" sid="MAT 10:6"/>Shin Isra7eele keethaafe gidida hini dhayida dorsatako biite. <verse eid="MAT 10:6"/><verse number="7" style="v" sid="MAT 10:7"/>Yaa bidi, ‘Salo kawotethay matatis’ gidi odite.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">Luqa 10:4-12</ref>.</char></note> <verse eid="MAT 10:7"/><verse number="8" style="v" sid="MAT 10:8"/>Harganchota pathite, hayqidaysata hayqope denthite, baro harganchota geeshshi pathite, tuna ayyaanata kessite. Hinte coo ekidaysa coo immite. <verse eid="MAT 10:8"/><verse number="9" style="v" sid="MAT 10:9"/>Hinte kiisen worqa, woyko bira santime oykofite. <verse eid="MAT 10:9"/><verse number="10" style="v" sid="MAT 10:10"/>Hinte ogiyas karxiito, nam7u afila, woyko caamma woyko xam7a oykofite; oosanchuwas gallasa kathi koshshees.<note caller="-" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="2CO 9:14">2 Qoro 9:14</ref>; <ref loc="1TI 5:18">1 Ximo 5:18</ref>.</char></note><verse eid="MAT 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11"/>“Hinte issi katamaa woyko gutaa geliya wode hintena mokidi ekanaw ufaytiya uraa koyidi iya son shempite; hinte baana gakanaw yan gam7ite. <verse eid="MAT 10:11"/><verse number="12" style="v" sid="MAT 10:12"/>Qassi oodde sooka gelishe sarothite. <verse eid="MAT 10:12"/><verse number="13" style="v" sid="MAT 10:13"/>He keethay hintena mokiko hinte sarothida saroy entana gako, shin enti mokonna ixiko hinte sarothida saroy hintew guye simmo. <verse eid="MAT 10:13"/><verse number="14" style="v" sid="MAT 10:14"/>Oonika hintena mokonnanne hinte odiyaba si7onna ixiko he keethaafe woyko he katamaape keyishe hinte tohuwan de7iya baana pitidi keyite.<note caller="-" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Hawa 13:51</ref>.</char></note> <verse eid="MAT 10:14"/><verse number="15" style="v" sid="MAT 10:15"/>Ta hintew tuma odayis; Xoossaa pirda gallasan he katamaape Soodomesinne Gamoora katamatas pirday kawuyana.<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 11:24">Maato 11:24</ref>; <ref loc="GEN 19:24">Medhe 19:24</ref>.</char></note><verse eid="MAT 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16"/>“Ta hintena dorsatada suudhumeta giddo yeddana. Hessa gisho, shooshada cincata, holleda aadata gidite.<note caller="-" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="LUK 10:3">Luqa 10:3</ref>.</char></note> <verse eid="MAT 10:16"/><verse number="17" style="v" sid="MAT 10:17"/>Asay hintena pirda daynnatas aathidi immana, qassi ayhude woosa keethan hintena garaafana. Hessa gisho, entafe naagetite.<note caller="-" style="x"><char style="xo" closed="false">10:17 </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">Mar 13:9-11</ref>; <ref loc="LUK 12:11-12">Luqa 12:11-12</ref>; <ref loc="LUK 21:12-15">21:12-15</ref>.</char></note> <verse eid="MAT 10:17"/><verse number="18" style="v" sid="MAT 10:18"/>Ta gisho gidi hintena deriya haareyisata sinthenne kawota sinthe efana. Enta sinthaninne Ayhude gidonna deriya sinthan eqidi hinte tabaa markatana. <verse eid="MAT 10:18"/><verse number="19" style="v" sid="MAT 10:19"/>Shin hintena pirdas aathidi immiya wode, woygidi zaarino gidi un7etofite; he saatiyan hinte gaanaba Xoossay hintew immana. <verse eid="MAT 10:19"/><verse number="20" style="v" sid="MAT 10:20"/>Ayis giiko, hintenan odetey hinte Aawa Geeshsha Ayyaanape attishin, hintena gideketa.<verse eid="MAT 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21"/>“Ishay ba isha, aaway ba na7a, hayqos aathidi immana, nayti bantana yelidaysata bolla dendidi enta wodhisana.<note caller="-" style="x"><char style="xo" closed="false">10:21 </char><char style="xt" closed="false"><ref loc="MRK 13:12">Mar 13:12</ref>; <ref loc="LUK 21:16">Luqa 21:16</ref>.</char></note> <verse eid="MAT 10:21"/><verse number="22" style="v" sid="MAT 10:22"/>Ta gisho gidi asa ubbay hintena ixana, shin wursethi gakanaw minniday attana.<note caller="-" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="MAT 24:9">Maato 24:9</ref>; <ref loc="MRK 13:13">Mar 13:13</ref>; <ref loc="LUK 21:17">Luqa 21:17</ref>; <ref loc="MAT 24:13">Maato 24:13</ref>; <ref loc="MRK 13:13">Mar 13:13</ref>.</char></note> <verse eid="MAT 10:22"/><verse number="23" style="v" sid="MAT 10:23"/>Issi heerape hintena enti gooddiko hara katama baqatite. Taani hintew tuma odayis; Asa Na7ay yaana gakanaw, hinte Isra7eele katama ubbaa kantheketa.<verse eid="MAT 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24"/>“Tamaarey ba astamaariyape, aylley ba godaape aadhenna.<note caller="-" style="x"><char style="xo" closed="false">10:24 </char><char style="xt" closed="false"><ref loc="LUK 6:40">Luqa 6:40</ref>; <ref loc="JHN 13:16">Yoha 13:16</ref>; <ref loc="JHN 15:20">15:20</ref>.</char></note> <verse eid="MAT 10:24"/><verse number="25" style="v" sid="MAT 10:25"/>Tamaarey ba astamaariya, aylley ba godaa daaniko iyaw gidana. Keetha goda Bi7eel-Zebuula giiko iya soo asaa waatidi iissidi xeegenee?<note caller="-" style="x"><char style="xo" closed="false">10:25 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Maato 9:34</ref>; <ref loc="MAT 12:24">12:24</ref>; <ref loc="MRK 3:22">Mar 3:22</ref>; <ref loc="LUK 11:15">Luqa 11:15</ref>.</char></note><verse eid="MAT 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26"/>“Hiza, asas yayyofite. Kametidabay qonconna, qosetidabay geeshshi keyonna attenna.<note caller="-" style="x"><char style="xo" closed="false">10:26 </char><char style="xt" closed="false"><ref loc="MRK 4:22">Mar 4:22</ref>; <ref loc="LUK 8:17">Luqa 8:17</ref>.</char></note> <verse eid="MAT 10:26"/><verse number="27" style="v" sid="MAT 10:27"/>Taani hintew dhuman odiyaba hinte poo7on odite; ta hintew haythan kalkashidaba dabaaban awaajite. <verse eid="MAT 10:27"/><verse number="28" style="v" sid="MAT 10:28"/>Ashope attishin, shempo wodhanaw danda7onaysatas yayyofite. Shin shempuwanne ashuwa gaannamen dhaysanaw danda7iya Xoossaas yayyite. <verse eid="MAT 10:28"/><verse number="29" style="v" sid="MAT 10:29"/>Nam7u buubeti issi santimen bayzetokonayee? Hanope attishin, entafe issinnaka hinte Xoossay goonna de7ishin sa7an wodhuku. <verse eid="MAT 10:29"/><verse number="30" style="v" sid="MAT 10:30"/>Hari attoshin, hinte huuphe binaanayka paydetidi de7ees. <verse eid="MAT 10:30"/><verse number="31" style="v" sid="MAT 10:31"/>Hiza, daro buubetape hinte aadhiya gisho yayyofite.<verse eid="MAT 10:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32"/>“Asa sinthan taw markatiya ubbaas taanika salon de7iya ta aawa sinthan markatana. <verse eid="MAT 10:32"/><verse number="33" style="v" sid="MAT 10:33"/>Shin asa sinthan tana kaddeysa taanika salon de7iya ta aawa sinthan kaddana.<note caller="-" style="x"><char style="xo" closed="false">10:33 </char><char style="xt" closed="false"><ref loc="2TI 2:12">2 Ximo 2:12</ref>.</char></note><verse eid="MAT 10:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34"/>“Taani sa7an saro ehanaw yida hintew daanopo. Taani toorape attishin, sarotethi ehanaw yabiike. <verse eid="MAT 10:34"/><verse number="35" style="v" sid="MAT 10:35"/>Taani yiday,</para>
  <para style="q1" vid="MAT 10:35">“ ‘Na7aa aawape</para>
  <para style="q2" vid="MAT 10:35">macca na7iw aayepe</para>
  <para style="q2" vid="MAT 10:35">na7aa machiw azina aayepe shaakanaasa.<note caller="-" style="x"><char style="xo" closed="false">10:35 </char><char style="xt" closed="false"><ref loc="MIC 7:6">Miki 7:6</ref>.</char></note><verse eid="MAT 10:35"/></para>
  <para style="q2">
    <verse number="36" style="v" sid="MAT 10:36"/>Asas morketi iya soo asata gidana.’<verse eid="MAT 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37"/>“Taape aathidi ba aawa woyko ba aayiw dosey, tabaa gidanaw bessenna. Ba adde na7a woyko ba macca na7iw taape aathidi dosey, tabaa gidanaw bessenna. <verse eid="MAT 10:37"/><verse number="38" style="v" sid="MAT 10:38"/>Ba masqaliya tookidi tana kaallonna oonika tabaa gidanaw bessenna.<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="MAT 16:24">Maato 16:24</ref>; <ref loc="MRK 8:34">Mar 8:34</ref>; <ref loc="LUK 9:23">Luqa 9:23</ref>.</char></note> <verse eid="MAT 10:38"/><verse number="39" style="v" sid="MAT 10:39"/>Ba shempuwa ashshanaw koyey dhaysana, shin ba shempuwa ta gisho aathidi immey ashshana.<note caller="-" style="x"><char style="xo" closed="false">10:39 </char><char style="xt" closed="false"><ref loc="MAT 16:25">Maato 16:25</ref>; <ref loc="MRK 8:35">Mar 8:35</ref>; <ref loc="LUK 9:24">Luqa 9:24</ref>; <ref loc="LUK 17:33">17:33</ref>; <ref loc="JHN 12:25">Yoha 12:25</ref>.</char></note><verse eid="MAT 10:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40"/>“Hintena mokey tana mokees, tana mokey qassi tana kiittidaysa mokees.<note caller="-" style="x"><char style="xo" closed="false">10:40 </char><char style="xt" closed="false"><ref loc="LUK 10:16">Luqa 10:16</ref>; <ref loc="JHN 13:20">Yoha 13:20</ref>; <ref loc="MRK 9:37">Mar 9:37</ref>; <ref loc="LUK 9:48">Luqa 9:48</ref>.</char></note> <verse eid="MAT 10:40"/><verse number="41" style="v" sid="MAT 10:41"/>Nabiya nabe sunthan mokey, nabiyatho woytetana; qassi xilluwa xillo sunthan mokey, xilluwatho woytetana. <verse eid="MAT 10:41"/><verse number="42" style="v" sid="MAT 10:42"/>Ta hintew tuma odayis; ha ta tamaaretape guuxiya issuwas tana kaalliya gisho hari attoshin guutha irxa haathi immiko iya woytoy dhayenna” yaagis.<verse eid="MAT 10:42"/></para>
  <chapter eid="MAT 10"/>
  <chapter number="11" style="c" sid="MAT 11"/>
  <para style="s1">Xammaqiya Yohaanisi Kiitida Asata</para>
  <para style="r">(<ref loc="LUK 7:18-35">Luqa 7:18-35</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1"/>Yesuusi tammanne nam7u tamaareta kiitidaape guye yaape dendidi tamaarsanawunne sabbakanaw Galila katamata bis.<verse eid="MAT 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2"/>Yohaanisi qasho keethan de7ishe Kiristoosi oothiyabata si7idi, ba tamaaretape iyako kiittidi, <verse eid="MAT 11:2"/><verse number="3" style="v" sid="MAT 11:3"/>“Yaana geetetiday neneyee? Woyko nuuni haraa naagino?” yaagidi oychis.<verse eid="MAT 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4"/>Yesuusi entako zaaridi, “Bidi hinte si7iyabaanne hinte be7iyaba Yohaanisas odite. <verse eid="MAT 11:4"/><verse number="5" style="v" sid="MAT 11:5"/>Qooqeti xeelloosona, wobbeti hemetoosona, baro harganchoti paxoosona, tulleti si7oosona, hayqidaysati hayqope dendoosona; manqotas Wongelay sabbaketees.<note caller="-" style="x"><char style="xo" closed="false">11:5 </char><char style="xt" closed="false"><ref loc="ISA 35:5">Isa 35:5</ref>.</char></note> <verse eid="MAT 11:5"/><verse number="6" style="v" sid="MAT 11:6"/>Tanan dhubetonay anjetidaysa” yaagis.<verse eid="MAT 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7"/>Yohaanisa tamaareti guye simmidi bin, Yesuusi deriyas Yohaanisaba odishe, “Ha mela biitta ay be7anaw keydetii? Carkoy qaathiya mayre be7anaw yidetiyee? <verse eid="MAT 11:7"/><verse number="8" style="v" sid="MAT 11:8"/>Yaatin, ay be7anaw keydetii? Koyse ma7o ma7ida ase be7anaseyee? Koyse ma7o ma7ida asati kawo gadhon de7oosona. <verse eid="MAT 11:8"/><verse number="9" style="v" sid="MAT 11:9"/>Yaatin, ay be7anaw keydetii? Nabe be7anaseyee? Heko, hinte nabepe aadheysa be7eeta.<verse eid="MAT 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 11:10"/>“Ne ogiya ne sinthan giigisiya</para>
  <para style="q2" vid="MAT 11:10">ta kiitanchuwa neepe sinthe kiittana”</para>
  <para style="m" vid="MAT 11:10">geetetidi xaafetiday iyassa.<note caller="-" style="x"><char style="xo" closed="false">11:10 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Milki 3:1</ref>.</char></note><verse eid="MAT 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 11:11"/>Ta hintew tuma odayis; maccasape yeletidaysata giddofe Yohaanisape aadhey oonika baawa; salo kawotethan ubbaafe guuxey I, iyape aadhana. <verse eid="MAT 11:11"/><verse number="12" style="v" sid="MAT 11:12"/>Xammaqiya Yohaanisa wodiyape doomidi hachi gakanaw salo kawotethay daro naaqetees, minnida asati wolqan yaa gelana.<note caller="-" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="LUK 16:16">Luqa 16:16</ref>.</char></note> <verse eid="MAT 11:12"/><verse number="13" style="v" sid="MAT 11:13"/>Nabeti ubbaynne Muse higgey Yohaanisa wode gakanaw salo kawotethaaba tinbite odidosona. <verse eid="MAT 11:13"/><verse number="14" style="v" sid="MAT 11:14"/>Hiza, hinte enta kiitaa ammanana gidiko, yaana geetetida Eeliyaasi, I Yohaanisa.<note caller="-" style="x"><char style="xo" closed="false">11:14 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Milki 4:5</ref>; <ref loc="MAT 17:10">Maato 17:10</ref>.</char></note> <verse eid="MAT 11:14"/><verse number="15" style="v" sid="MAT 11:15"/>Hiza, si7iya haythi de7ey si7o.<verse eid="MAT 11:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16"/>“Hiza, ha wodiya yeletethaa aybira daaniso? Giya giddon uttidi woli xeegidi,<verse eid="MAT 11:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="MAT 11:17"/>“ ‘Nu hintew suusul77e punnin;</para>
  <para style="q2" vid="MAT 11:17">hinte yexeketa.</para>
  <para style="q1" vid="MAT 11:17">Nu sabbidi zeleelin;</para>
  <para style="q2" vid="MAT 11:17">hinte yeekeketa’</para>
  <para style="m" vid="MAT 11:17">giya nayta daanosona. <verse eid="MAT 11:17"/><verse number="18" style="v" sid="MAT 11:18"/>Xammaqiya Yohaanisi moonnanne uyonna yin, ‘Tuna ayyaani de7ees’ yaagideta. <verse eid="MAT 11:18"/><verse number="19" style="v" sid="MAT 11:19"/>Asa Na7ay mishenne uyishe yin, ‘Yarambanne ushshancho, qaraxa qanxiseysatanne nagaranchota dabbo’ yaagideta. Hiza, cincatethaa tumatethay iya oosuwan qoncees” yaagis.<verse eid="MAT 11:19"/></para>
  <para style="s1">Ammanonna Ixida Katamata</para>
  <para style="r">(<ref loc="LUK 10:13-15">Luqa 10:13-15</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20"/>Hessafe guye, Yesuusi daro malaatata oothida katamatan de7iya asati banta nagaraape simmidi maarotan gelonna ixida gisho entana, <verse eid="MAT 11:20"/><verse number="21" style="v" sid="MAT 11:21"/>“Korazine katamaw nena ayye! Beetesayda katamaw nena ayye! Ayis giiko, hinte giddon oosetida malaatati Xiroosaninne Sidoonan oosetida gidiyako, enti beni bido tiyetidi, kayo ma7o ma7idi banta nagarape simmi aggana.<note caller="-" style="x"><char style="xo" closed="false">11:21 </char><char style="xt" closed="false"><ref loc="ISA 23:1-18">Isa 23:1-18</ref>; <ref loc="JOL 3:4-8">Iyyu 3:4-8</ref>; <ref loc="AMO 1:9-10">Amo 1:9-10</ref>; <ref loc="ZEC 9:2-4">Zaka 9:2-4</ref>.</char></note> <verse eid="MAT 11:21"/><verse number="22" style="v" sid="MAT 11:22"/>Shin ta hintew odayis; pirda gallas hintefe aathidi Xiroosasinne Sidoonas pirday kawuyana. <verse eid="MAT 11:22"/><verse number="23" style="v" sid="MAT 11:23"/>Qassi, Qifirnahooma, neeni pude salo keyanaw koyay? Hanenna! Neeni Si7oolen yegetana. Ayis giiko, ne giddon oosetida malaatati Soodomen oosetidaba gidiyako, Soodomey hachi gakanaw de7anashin.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ISA 14:13">Isa 14:13</ref>.</char></note> <verse eid="MAT 11:23"/><verse number="24" style="v" sid="MAT 11:24"/>Shin ta new odayis; pirda gallas neepe aathidi Soodomes pirday kawuyana” yaagidi hanqetis.<note caller="-" style="x"><char style="xo" closed="false">11:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">Maato 10:15</ref>; <ref loc="LUK 10:12">Luqa 10:12</ref>.</char></note><verse eid="MAT 11:24"/></para>
  <para style="s1">Kiristoosi Immiya Shempo</para>
  <para style="r">(<ref loc="LUK 10:21-22">Luqa 10:21-22</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25"/>He wode Yesuusi, “Aawaw, saluwanne sa7aa Godaw, neeni haysa eranchotapenne cincatape genthada naytas qoncisida gisho, nena galatayis. <verse eid="MAT 11:25"/><verse number="26" style="v" sid="MAT 11:26"/>Ee, ta Aawaw, haysi ne lo77o sheniyada hanis.<verse eid="MAT 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27"/>“Ubbay taw ta Aawape imetis. Aawape hari Na7a erey baawa, Na7aapenne I entaw qoncisanaw koyeysatape hari Aawa eranaw danda7ey baawa.<note caller="-" style="x"><char style="xo" closed="false">11:27 </char><char style="xt" closed="false"><ref loc="JHN 1:18">Yoha 1:18</ref>; <ref loc="JHN 3:35">3:35</ref>; <ref loc="JHN 10:15">10:15</ref>.</char></note><verse eid="MAT 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28"/>“Hinteno, daaburanchoto, toohoy deexida ubbay taako haa yiite; taani hintena shempisana. <verse eid="MAT 11:28"/><verse number="29" style="v" sid="MAT 11:29"/>Taani ta wozanan ashkenne aada gidiya gisho, ta qambaran gelite, taape tamaarite; hinte, hinte shempuwas shempo demmana.<note caller="-" style="x"><char style="xo" closed="false">11:29 </char><char style="xt" closed="false"><ref loc="JER 6:16">Ermi 6:16</ref>.</char></note> <verse eid="MAT 11:29"/><verse number="30" style="v" sid="MAT 11:30"/>Ta qambaray liiqo, qassi ta toohoyka kawushe” yaagis.<verse eid="MAT 11:30"/></para>
  <chapter eid="MAT 11"/>
  <chapter number="12" style="c" sid="MAT 12"/>
  <para style="s1">Sambaata Bonchanaw Bessii?</para>
  <para style="r">(<ref loc="MRK 2:23-28">Mar 2:23-28</ref>; <ref loc="LUK 6:1-5">Luqa 6:1-5</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1"/>Hessafe guye, Sambaata gallas, Yesuusi gade giddora aadhees. Yesuusa tamaareti koshatida gisho tiya banga shirikidi moosona.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="DEU 23:25">Zaare 23:25</ref>.</char></note> <verse eid="MAT 12:1"/><verse number="2" style="v" sid="MAT 12:2"/>Shin Farsaaweti hessa be7idi Yesuusako, “Heko, ne tamaareti Sambaata gallas oothanaw bessonnaba oothosona” yaagidosona.<verse eid="MAT 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3"/>Yesuusi zaaridi, “Dawiti koshatida wode iyara de7eysatara ay oothidaako nabbabibeketii?<note caller="-" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 Same 21:1-6</ref>.</char></note> <verse eid="MAT 12:3"/><verse number="4" style="v" sid="MAT 12:4"/>Dawiti Xoossaa keethi gelidi kahineta xalaalape attishin, inne iyara de7eysatas bessonna geeshsha daabbuwa mis.<note caller="-" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Leewe 24:9</ref>.</char></note> <verse eid="MAT 12:4"/><verse number="5" style="v" sid="MAT 12:5"/>Woyko kahineti Sambaata wogaa shaaridi xoossa keethan Sambaata gallas ooso oothiko entaw bala gidonnaysa Muse higgiyan nabbabibeketii?<note caller="-" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 28:9-10">Taybo 28:9-10</ref>.</char></note> <verse eid="MAT 12:5"/><verse number="6" style="v" sid="MAT 12:6"/>Shin si7ite! Xoossa Keethaafe aadhey haysan de7ees. <verse eid="MAT 12:6"/><verse number="7" style="v" sid="MAT 12:7"/>‘Taani hinte yarshuwa gidonashin harata maarana mela koyayis’ giya qaalay woy guuseko hinte eridaako, xillo asa bolla pirdeketa.<note caller="-" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="MAT 9:13">Maato 9:13</ref>; <ref loc="HOS 6:6">Hose 6:6</ref>.</char></note> <verse eid="MAT 12:7"/><verse number="8" style="v" sid="MAT 12:8"/>Asa Na7ay Sambaata Godaa” yaagis.<verse eid="MAT 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9"/>Yesuusi yaape bidi ayhude woosa keethi gelis. <verse eid="MAT 12:9"/><verse number="10" style="v" sid="MAT 12:10"/>Yan kushey gundida issi uray de7ees. Yesuusa mootanaw gaaso koyiya asati, “Sambaata gallas pathanaw bessi bessennee?” yaagidi oychidosona.<verse eid="MAT 12:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11"/>I entako, “Hinte giddofe issuwas dorsi Sambaata gallas aafon wulliko, goochidi kessonnay oonee?<note caller="-" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="LUK 14:5">Luqa 14:5</ref>.</char></note> <verse eid="MAT 12:11"/><verse number="12" style="v" sid="MAT 12:12"/>Yaatin asi dorsaafe waanidi daro aadhenee? Hessa gisho, Sambaata gallas lo77oba oosoy bessees” yaagis.<verse eid="MAT 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 12:13"/>Hessafe guye, Yesuusi addiyako, “Ne kushiya piddi ootha” yaagin, uray piddi oothis. Iya kushey paxidi hanko kushiyada hanis. <verse eid="MAT 12:13"/><verse number="14" style="v" sid="MAT 12:14"/>Shin Farsaaweti yaape kare keyidi, Yesuusa waati wodhaneko maqetidosona.<verse eid="MAT 12:14"/></para>
  <para style="s1">Dooretida Xoossa Aylliya</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15"/>Yesuusi enta qofaa eridi he bessaa aggidi hara soo bis. Daro asay iya kaallidi bidosona, harganchota ubbaa pathis. <verse eid="MAT 12:15"/><verse number="16" style="v" sid="MAT 12:16"/>Yesuusi, “Tabaa hara oodeska odopite” yaagidi minthi odis. <verse eid="MAT 12:16"/><verse number="17" style="v" sid="MAT 12:17"/>Hessika nabiya Isayaasi,<verse eid="MAT 12:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18"/>“Heko ta doorida aylley,</para>
  <para style="q2" vid="MAT 12:18">ta doseysi, tana ufayseysi,</para>
  <para style="q2" vid="MAT 12:18">taani ta ayyaana, iya bolla shempisana;<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">Isa 42:1-4</ref>.</char></note></para>
  <para style="q2" vid="MAT 12:18">I, Ayhude gidonna deriyas suure pirdaba awaajana.<verse eid="MAT 12:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19"/>I palamenna woyko kaccenna;</para>
  <para style="q2" vid="MAT 12:19">ba qaalaka denban coo sissenna.<verse eid="MAT 12:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20"/>Suure pirdan xoono demmana gakanaw,</para>
  <para style="q2" vid="MAT 12:20">dincetida mayre menthenna,</para>
  <para style="q2" vid="MAT 12:20">cuyiyaa muqaada toysenna.<verse eid="MAT 12:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="MAT 12:21"/>Ayhude gidonna derey ubbay iyan ufaysi wothana”</para>
  <para style="m" vid="MAT 12:21">yaagidi xaafidaysi poletana melasa.<verse eid="MAT 12:21"/></para>
  <para style="s1">Yesuusanne Bi7eel-Zebuula</para>
  <para style="r">(<ref loc="MRK 3:20-30">Mar 3:20-30</ref>; <ref loc="LUK 11:14-23">Luqa 11:14-23</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22"/>Hessafe guye, tuna ayyaanan oyketida qooqenne muume ase de7eysa iyako ehidosona. Yesuusi ura pathin, uray xeellis; odetis. <verse eid="MAT 12:22"/><verse number="23" style="v" sid="MAT 12:23"/>Asa ubbay malaaletidi, “Haysi Dawita Na7aa gidandesha?” yaagidosona.<verse eid="MAT 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24"/>Shin Farsaaweti hessa si7idi, “Ha uray tuna ayyaanata kessey tuna ayyaanata halaqa Bi7eel-Zebuula wolqaana” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">12:24 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Maato 9:34</ref>; <ref loc="MAT 10:25">10:25</ref>.</char></note><verse eid="MAT 12:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25"/>Yesuusi enta qofaa eridi, “Woli giddon shaaketiya kawotetha ubbay kundana; qassi woli giddon shaaketiya katamay woyko keethay minnidi eqenna. <verse eid="MAT 12:25"/><verse number="26" style="v" sid="MAT 12:26"/>Xalahey Xalahe kessiyaba gidiko ba giddon shaaketis guussu. Hessatho haniyaba gidiko iya kawotethay waanidi minnidi eqanaw danda7ii? <verse eid="MAT 12:26"/><verse number="27" style="v" sid="MAT 12:27"/>Taani tuna ayyaana kessey Bi7eel-Zebuula wolqan gidiko hintena kaalliya asati oodde wolqan kessannee? Hessa gisho, hintena kaalliya asati hintena pirdana. <verse eid="MAT 12:27"/><verse number="28" style="v" sid="MAT 12:28"/>Shin taani tuna ayyaanata kessey Xoossaa Ayyaanan gidiko, Xoossaa kawotethay hinteko yis.<verse eid="MAT 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29"/>“Woyko issi asi wolqaama asa soo gelidi iya shaluwa bonqanaw koyko koyrottidi he uraa qachonna ixiko waatidi danda7ii? Yaatiko iya shaluwa bonqanaw danda7ees.<verse eid="MAT 12:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30"/>“Taara gidonnay oonika taara eqetees; qassi taara issife shiishonna ubbay laallees.<note caller="-" style="x"><char style="xo" closed="false">12:30 </char><char style="xt" closed="false"><ref loc="MRK 9:40">Mar 9:40</ref>.</char></note> <verse eid="MAT 12:30"/><verse number="31" style="v" sid="MAT 12:31"/>Hessa gisho, si7ite; asay oothiya ay nagarinne cashsha qaali ubbay atto geetetana, shin Geeshsha Ayyaana cayiya oodeska iya nagaray atto geetetenna.<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luqa 12:10</ref>.</char></note> <verse eid="MAT 12:31"/><verse number="32" style="v" sid="MAT 12:32"/>Oonika Asa Na7a bolla iitabaa odetiko iyaw atto geetetana, shin Geeshsha Ayyaana bolla iitabaa odetiya oodeska ha sa7an gidin yaana alamiyan iya nagaray atto geetetenna.<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luqa 12:10</ref>.</char></note><verse eid="MAT 12:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33"/>“Lo77o mithay lo77o ayfe ayfees; qassi iita mithay iita ayfees. Hiza, mithay eretey ba ayfiyana. <verse eid="MAT 12:33"/><verse number="34" style="v" sid="MAT 12:34"/>Hinteno, shoosha nayto, hinte iita gidishe waanidi lo77oba odetanaw danda7eetii? Asi ba wozanan kumidabaape doonan odetees.<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="MAT 3:7">Maato 3:7</ref>; <ref loc="MAT 23:33">23:33</ref>; <ref loc="LUK 3:7">Luqa 3:7</ref>; <ref loc="MAT 15:18">Maato 15:18</ref>; <ref loc="LUK 6:45">Luqa 6:45</ref>.</char></note> <verse eid="MAT 12:34"/><verse number="35" style="v" sid="MAT 12:35"/>Lo77o asi ba wozanan wothida lo77obaape, lo77oba kessees; iita asi ba wozanan wothida iitabaape, iitabaa kessees. <verse eid="MAT 12:35"/><verse number="36" style="v" sid="MAT 12:36"/>Shin si7ite, asay odetiya coo oda ubbaas pirda gallas zaaro immana. <verse eid="MAT 12:36"/><verse number="37" style="v" sid="MAT 12:37"/>Ayis giiko, ne odetiya ne qaalan xillana; ne odetiya ne qaalay ne bolla pirdana” yaagis.<verse eid="MAT 12:37"/></para>
  <para style="s1">Yoonasa Malaata</para>
  <para style="r">(<ref loc="MRK 8:11-12">Mar 8:11-12</ref>; <ref loc="LUK 11:29-32">Luqa 11:29-32</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38"/>Hessafe guye, issi issi Farsaawetinne higge astamaareti Yesuusako, “Astamaariyaw, neeni malaata oothada nuna bessa” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">12:38 </char><char style="xt" closed="false"><ref loc="MAT 16:1">Maato 16:1</ref>; <ref loc="MRK 8:11">Mar 8:11</ref>; <ref loc="LUK 11:16">Luqa 11:16</ref>.</char></note><verse eid="MAT 12:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39"/>Shin Yesuusi zaaridi, “Ammanetonanne iita yeletethay malaata koyees. Shin nabiya Yoonasa malaatape hara malaati iyaw imetenna.<note caller="-" style="x"><char style="xo" closed="false">12:39 </char><char style="xt" closed="false"><ref loc="MAT 16:4">Maato 16:4</ref>; <ref loc="MRK 8:12">Mar 8:12</ref>.</char></note> <verse eid="MAT 12:39"/><verse number="40" style="v" sid="MAT 12:40"/>Yoonasi gita molo ulon heedzu gallasinne heedzu qamma gam7idaysa mela Asa Na7ay heedzu gallasinne heedzu qamma biitta garsan gam7ana.<note caller="-" style="x"><char style="xo" closed="false">12:40 </char><char style="xt" closed="false"><ref loc="JHN 1:17">Yoha 1:17</ref>.</char></note> <verse eid="MAT 12:40"/><verse number="41" style="v" sid="MAT 12:41"/>Nanawe asay pirda gallas dendidi ha yeletethaa bolla pirdana; ayis giiko, enti Yoonasi sabbakin, si7idi banta nagaraape simmidosona. Heko, Yoonasape aadheysi haysan de7ees.<note caller="-" style="x"><char style="xo" closed="false">12:41 </char><char style="xt" closed="false"><ref loc="JHN 3:5">Yoha 3:5</ref>.</char></note> <verse eid="MAT 12:41"/><verse number="42" style="v" sid="MAT 12:42"/>Pirda gallas dugeha kawiya dendada ha yeletethaa bolla pirdana; ayis giiko, iya Solomone cincatethaa si7anaw biitta gaxape yasu. Heko, Solomonepe aadhey haysan de7ees.<note caller="-" style="x"><char style="xo" closed="false">12:42 </char><char style="xt" closed="false"><ref loc="1KI 10:1-10">1 Kawo 10:1-10</ref>; <ref loc="2CH 9:1-12">2 Taari 9:1-12</ref>.</char></note><verse eid="MAT 12:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43"/>“Tuna ayyaanay asape keydaape guye baw shempiya bessi koyidi haathi bayna mela bessan daaburees, shin ba koyiya shempuwa demmenna. <verse eid="MAT 12:43"/><verse number="44" style="v" sid="MAT 12:44"/>Yaanin, ‘Ta agga keyida keetha simmada baana’ yaagees. I simmiya wode keethay kaysi gideysanne pitetidi giigidi uttidaysa demmees. <verse eid="MAT 12:44"/><verse number="45" style="v" sid="MAT 12:45"/>Hiza, simmi bidi, baape iitiya hara laapun iita ayyaanata ekidi yees; entika uraa giddo gelidi de7oosona. He uraas kaseysafe guyeysi daro iitees. Ha iita yeletethaa bolla hessa mela hanana” yaagis.<verse eid="MAT 12:45"/></para>
  <para style="s1">Yesuusa Aayiwunne Iya Ishata</para>
  <para style="r">(<ref loc="MRK 3:31-35">Mar 3:31-35</ref>; <ref loc="LUK 8:19-21">Luqa 8:19-21</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46"/>Yesuusi deriyas oda bolla de7ishin iya aayanne iya ishati iya odisanaw koyidi karen eqidosona. <verse eid="MAT 12:46"/><verse number="47" style="v" sid="MAT 12:47"/>Issi asi iyako, “Ne aayanne ne ishati nena odisanaw koyidi karen eqidosona” yaagis.<verse eid="MAT 12:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48"/>Yesuusi zaaridi, “Ta aayiya oonee? Ta ishatika oonantee?” yaagis. <verse eid="MAT 12:48"/><verse number="49" style="v" sid="MAT 12:49"/>Ba kushiyara tamaareta mallishe, “Be7ite, ta aayanne ta ishati haysata. <verse eid="MAT 12:49"/><verse number="50" style="v" sid="MAT 12:50"/>Salon de7iya ta Aawa sheniya oothiya ubbay ta isha, ta michonne ta aayo” yaagis.<verse eid="MAT 12:50"/></para>
  <chapter eid="MAT 12"/>
  <chapter number="13" style="c" sid="MAT 13"/>
  <para style="s1">Zerethi Zeriya Ura Leemiso</para>
  <para style="r">(<ref loc="MRK 4:1-9">Mar 4:1-9</ref>; <ref loc="LUK 8:4-8">Luqa 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1"/>He gallas Yesuusi soope keyidi abba gaxan uttis. <verse eid="MAT 13:1"/><verse number="2" style="v" sid="MAT 13:2"/>Daro derey iya yuushuwan shiiqin asaa abba gaxan aggaagidi wogolon gelidi uttis.<note caller="-" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="LUK 5:1">Luqa 5:1</ref>.</char></note> <verse eid="MAT 13:2"/><verse number="3" style="v" sid="MAT 13:3"/>Asaas darobaa leemison yaagidi odis:</para>
  <para style="p" vid="MAT 13:3">“Issi goshshanchoy zerethi zeranaw keyis. <verse eid="MAT 13:3"/><verse number="4" style="v" sid="MAT 13:4"/>I zeriya wode issi issi zerethati oge gaxan wodhidosona; entaka kafoti yidi maxi midosona. <verse eid="MAT 13:4"/><verse number="5" style="v" sid="MAT 13:5"/>Issi issi zerethati garsan shaalloy de7iya biitta bolla wodhidosona. Daro biitti bayna gisho ellesidi dolis. <verse eid="MAT 13:5"/><verse number="6" style="v" sid="MAT 13:6"/>Shin away keyin shullis; xaphoy bayna gisho melis. <verse eid="MAT 13:6"/><verse number="7" style="v" sid="MAT 13:7"/>Issi issi zerethay aguntha giddon wodhis; agunthay diccidi he dolaa cuullis. <verse eid="MAT 13:7"/><verse number="8" style="v" sid="MAT 13:8"/>Harati qassi aradda biitta bolla wodhis; dolidi ayfe ayfis. Issoy xeeta, issoy usupun tamma, issoy qassi hastama ayfis. <verse eid="MAT 13:8"/><verse number="9" style="v" sid="MAT 13:9"/>Si7iya haythi de7iya uray si7o” yaagis.<verse eid="MAT 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10"/>Yesuusa tamaareti iyako shiiqidi, “Ayis neeni deriyas leemison oday?” yaagidi oychidosona.<verse eid="MAT 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11"/>I zaaridi, “Hintew salo kawotethaa xuuraa eray imetis, shin entaw imetibeenna. <verse eid="MAT 13:11"/><verse number="12" style="v" sid="MAT 13:12"/>De7iya ubbaas guzhetana, iyaw darana, shin baynaysafe hari attoshin iyaw de7iyaraka eketana.<note caller="-" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="MAT 25:29">Maato 25:29</ref>; <ref loc="MRK 4:25">Mar 4:25</ref>; <ref loc="LUK 8:18">Luqa 8:18</ref>; <ref loc="LUK 19:26">19:26</ref>.</char></note> <verse eid="MAT 13:12"/><verse number="13" style="v" sid="MAT 13:13"/>Hessa gisho, taani enti, xeellishe demmonna mela, si7ishe si7onna mela woyko akeekona mela entaw leemison odayis.<verse eid="MAT 13:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 13:14"/>“Isayaasi ba maxaafan odidaysi enta bolla poletis. I odishe,</para>
  <para style="q1" vid="MAT 13:14">“ ‘Hinte sissi si7eeta, shin akeekeketa;</para>
  <para style="q2" vid="MAT 13:14">hinte xeelleta, shin be7eketa.<verse eid="MAT 13:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15"/>Ayis giiko, ha asaa wozanay zel7umis;</para>
  <para style="q2" vid="MAT 13:15">banta haythaa erishe tullisidosona,</para>
  <para style="q2" vid="MAT 13:15">banta ayfiya goozidosona.</para>
  <para style="q2" vid="MAT 13:15">Hessi bayneko enti banta ayfiyan be7idi,</para>
  <para style="q2" vid="MAT 13:15">banta haythan si7idi,</para>
  <para style="q2" vid="MAT 13:15">banta wozanan akeekidi,</para>
  <para style="q2" vid="MAT 13:15">taako simmana,</para>
  <para style="q2" vid="MAT 13:15">taka enta pathanashin’ yaagis.<verse eid="MAT 13:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16"/>“Shin hinte ayfeti be7iya gishonne hinte haythati si7iya gisho hinte anjetidaysata.<note caller="-" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="LUK 10:23-24">Luqa 10:23-24</ref>.</char></note> <verse eid="MAT 13:16"/><verse number="17" style="v" sid="MAT 13:17"/>Ta hintew tuma odayis; daro nabetinne xilloti hinte be7eysa be7anawunne hinte si7eysa si7anaw amotidosona, shin entaw hanibeenna.<verse eid="MAT 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18"/>“Hiza, ha zerethi zeriya uraa leemisuwa si7ite. <verse eid="MAT 13:18"/><verse number="19" style="v" sid="MAT 13:19"/>Oge gaxan wodhida zerethi leemisoy haysa: salo kawotethaa qaala si7idi akeekona uraa wozanape Xalahey yidi iya wozanan de7iya zeretha maxi diggees. <verse eid="MAT 13:19"/><verse number="20" style="v" sid="MAT 13:20"/>Shaalloy garsan de7iya biitta bolla zeretidaysi qaala si7idi ellesidi ufaysan ekeyisata. <verse eid="MAT 13:20"/><verse number="21" style="v" sid="MAT 13:21"/>Shin xapho yeddanaw danda7onna gisho daro gam7okona. Qaala gaason metoy woyko goodetethi yaa wode ellesi dhubetoosona. <verse eid="MAT 13:21"/><verse number="22" style="v" sid="MAT 13:22"/>Aguntha gaathan zeretidaysi qaala si7is, shin ha alamiya duussaa Hirgaynne duretetha qofay qaala cuulliya gisho ayfe ayfonna attees. <verse eid="MAT 13:22"/><verse number="23" style="v" sid="MAT 13:23"/>Shin aradda biittan zeretida zerethay akeekan qaala si7iya uraa. I ayfe ayfees; issoy xeeta, issoy usupun tamma issoy qassi hastama ayfees” yaagis.<verse eid="MAT 13:23"/></para>
  <para style="s1">Leeshsho Leemiso</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24"/>Yesuusi entaw hara leemiso odis, “Xoossaa kawotethay ba goshshan lo77o zerethi zerida uraa daanees. <verse eid="MAT 13:24"/><verse number="25" style="v" sid="MAT 13:25"/>Shin asi ubbay dhiskin iya morkey yidi gistiya giddon leeshsho zeridi bis. <verse eid="MAT 13:25"/><verse number="26" style="v" sid="MAT 13:26"/>Gistey diccidi ayfiya wode leeshshoy iya giddon bentis.<verse eid="MAT 13:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 13:27"/>“Gadiya godaa aylleti godaako bidi, ‘Godaw, ne goshshan ne lo77o zerethi zerabikisho? Yaatin, leeshshoy awupe yidee?’ yaagidosona.<verse eid="MAT 13:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 13:28"/>“I entako, ‘Hessa morkey oothis’ yaagis.</para>
  <para style="p" vid="MAT 13:28">“Aylleti godaako, ‘Nu bidi leeshuwa shoddana mela koyay?’ yaagidosona.<verse eid="MAT 13:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 13:29"/>“Shin I, ‘Atto bochofite; hinte leeshuwa shoddayis gishin gistey shodetana. <verse eid="MAT 13:29"/><verse number="30" style="v" sid="MAT 13:30"/>Bochofite; caka wodey gakanaw issife dicco. He wode cakiya asata leeshuwa sinthatidi maxidi taman xuugganaw mirqen mirqen qachite. Shin gistiya shiishidi ta shaaliyan qolite’ yaagana” yaagis.<verse eid="MAT 13:30"/></para>
  <para style="s1">Ayfe Guutha Mithee Leemiso</para>
  <para style="r">(<ref loc="MRK 4:30-32">Mar 4:30-32</ref>; <ref loc="LUK 13:18-19">Luqa 13:18-19</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31"/>Qassi hara leemiso yaagidi odis; “Salo kawotethay issi asi ba goshshan bakida guutha mithee ayfe daanees. <verse eid="MAT 13:31"/><verse number="32" style="v" sid="MAT 13:32"/>He mithee ayfey hara mitha ayfetape guutha, shin iya dolaa diccida hara mithata ubbaafe aadhada gitatawusu. I tashiyan kafoti keexidi uttana gakanaw wolqaama mithi gidawusu” yaagis.<verse eid="MAT 13:32"/></para>
  <para style="s1">Irsho Leemiso</para>
  <para style="r">(<ref loc="LUK 13:20-21">Luqa 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33"/>Kaallidika, Yesuusi hara leemiso odis; “Salo kawotethay issi maccasi heedzu gabate dhiille eka munuqada, munuqay dendana mela iyan gujida irsho daanees” yaagis.<verse eid="MAT 13:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34"/>Yesuusi deriyas he leemisuwa ubbaa odis. Leemisoy bayna issibaaka odibeenna. <verse eid="MAT 13:34"/><verse number="35" style="v" sid="MAT 13:35"/>Nabey ba maxaafan,</para>
  <para style="q1" vid="MAT 13:35">“Taani ta doona, leemison dooyana;</para>
  <para style="q2" vid="MAT 13:35">saloynne sa7i medhetoosape,</para>
  <para style="q2" vid="MAT 13:35">geemmidaysa odayis”</para>
  <para style="m" vid="MAT 13:35">yaagidi odidaysi hessan poletis.<note caller="-" style="x"><char style="xo" closed="false">13:35 </char><char style="xt" closed="false"><ref loc="PSA 78:2">Maz 78:2</ref>.</char></note><verse eid="MAT 13:35"/></para>
  <para style="s1">Leeshsho Leemiso Birshetha</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36"/>Yesuusi deriya moyzidi soo gelis. Iya tamaareti iyako shiiqidi, “Goshshan de7iya leeshuwa birshethaa nuus oda” yaagidosona.<verse eid="MAT 13:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37"/>I zaaridi, “Lo77o zerethi zeriday Asa Na7a. <verse eid="MAT 13:37"/><verse number="38" style="v" sid="MAT 13:38"/>Goshshay ha alamiya. Lo77o zerethay salo kawotethaa nayta. Leeshshoy Xalahe nayta. <verse eid="MAT 13:38"/><verse number="39" style="v" sid="MAT 13:39"/>Leeshuwa zeriday morkiya Xalahe. Caka wodey, wode wursethi; cakeysati kiitanchota.<verse eid="MAT 13:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 13:40"/>“Leeshshoy maxetidi taman xuugeteysa mela wodiya wursethan hessada hanana. <verse eid="MAT 13:40"/><verse number="41" style="v" sid="MAT 13:41"/>Asa Na7ay ba kiitanchota kiittana. Enti nagaras gaaso gideysatanne iita oothiya ubbaa maxidi iya kawotethaafe kessana. <verse eid="MAT 13:41"/><verse number="42" style="v" sid="MAT 13:42"/>Maxi shiishidi yeehoynne acha garcethi de7iya to7onna taman yeggana. <verse eid="MAT 13:42"/><verse number="43" style="v" sid="MAT 13:43"/>He wode xilloti banta Aawa kawotethan awada poo7ana. Si7iya haythi de7ey si7o!<verse eid="MAT 13:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44"/>“Xoossaa kawotethay goshshan moogetida miishe daanees. Issi asi he miishiya demmidi zaari moogis. Daro ufaytidi bidi baw de7iyaba ubbaa bayzidi he goshsha gadiya shammis.<verse eid="MAT 13:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45"/>“Hessadaka, qassi salo kawotethay inqu geetetiya al7o shuchata koyiya zal7ancho daanees. <verse eid="MAT 13:45"/><verse number="46" style="v" sid="MAT 13:46"/>Daro al7o inquwa demmidi bidi baw de7iyaba ubbaa bayzidi iya shammis.<verse eid="MAT 13:46"/></para>
  <para style="s1">Molo Oykiya Gite Leemiso</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47"/>“Qassi Xoossaa kawotethay abban yegetida dumma dumma qommo molo oykiya gitiya daanees. <verse eid="MAT 13:47"/><verse number="48" style="v" sid="MAT 13:48"/>Molo oykiya asati moloy gitiyan kumin abbaafe gaxa kessidosona. Yan uttidi lo77uwa qori qori daachon yeggidosona, shin iita molota wora holidosona. <verse eid="MAT 13:48"/><verse number="49" style="v" sid="MAT 13:49"/>Wodiya wursethan hessatho hanana. Kiitanchoti yidi nagaranchota xillotape shaakidi, <verse eid="MAT 13:49"/><verse number="50" style="v" sid="MAT 13:50"/>yeehoynne acha garcethi de7iya to7onna taman yeggana.<verse eid="MAT 13:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51"/>“Ha ubbay hintew gelidee?” yaagidi enta oychis.</para>
  <para style="p" vid="MAT 13:51">Enti zaaridi, “Ee” yaagidosona.<verse eid="MAT 13:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52"/>Yesuusi, “Hiza, salo kawotethaa eraa ekidi higgiya tamaarsiya ubbay, ba minjida shaluwape oorathaanne gal7a kessiya ase daanees” yaagis.<verse eid="MAT 13:52"/></para>
  <para style="s1">Yesuusi Naazireten Ixetis</para>
  <para style="r">(<ref loc="MRK 6:1-6">Mar 6:1-6</ref>; <ref loc="LUK 4:16-30">Luqa 4:16-30</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53"/>Yesuusi ha leemisuwa odi wursidaape guye yaape dendidi bis. <verse eid="MAT 13:53"/><verse number="54" style="v" sid="MAT 13:54"/>Ba yeletida biitta bidi ayhude woosa keethan deriya tamaarsis. Enti malaaletidi, “Ha uray ha cincatethaanne ha malaatata oothiya wolqaa awupe ekidee? <verse eid="MAT 13:54"/><verse number="55" style="v" sid="MAT 13:55"/>Haysi anaaxiya na7aa gidenneyee? Iya aaye sunthay Mayraamo gidennee? Iya ishati Yayqooba, Yoosefa, Simoonanne Yihuda gidokonaayee? <verse eid="MAT 13:55"/><verse number="56" style="v" sid="MAT 13:56"/>Iya micheti nuura de7oosona gidokona? Yaatin, ha uray ha ubbaa awupe ekidee?” yaagidosona. <verse eid="MAT 13:56"/><verse number="57" style="v" sid="MAT 13:57"/>Hessa gisho, I giyaba ekonna ixidosona.<note caller="-" style="x"><char style="xo" closed="false">13:57 </char><char style="xt" closed="false"><ref loc="JHN 4:43">Yoha 4:43</ref>.</char></note></para>
  <para style="p" vid="MAT 13:57">Shin Yesuusi, “Nabey ba yeletida biittaninne ba soo asaa matan bonchetenna” yaagis. <verse eid="MAT 13:57"/><verse number="58" style="v" sid="MAT 13:58"/>Enti ammanonna ixida gisho daro malaatata he bessan oothibeenna.<verse eid="MAT 13:58"/></para>
  <chapter eid="MAT 13"/>
  <chapter number="14" style="c" sid="MAT 14"/>
  <para style="s1">Xammaqiya Yohaanisa Hayquwa</para>
  <para style="r">(<ref loc="MRK 6:14-29">Mar 6:14-29</ref>; <ref loc="LUK 9:7-9">Luqa 9:7-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1"/>He wode Galila aysiya Herodiisi<note caller="+" style="f"><char style="fr" closed="false">14:1 </char><char style="fqa" closed="false">Herodiisi: </char><char style="ft" closed="false">Haysi kawa Herodiisa Antiphaasa. I, Yihudanne Peeriya Kiristoosi yeletanaape sinthe 4-39 ML gakanaw haaris. I Kawa Herodiisas na7a.</char></note> Yesuusaba si7is. <verse eid="MAT 14:1"/><verse number="2" style="v" sid="MAT 14:2"/>Ba aylletako, “Haysi Xammaqiya Yohaanisa; I hayqope dendis. Yaanida gisho, ha ubbaa malaatata I oothees” yaagis.<verse eid="MAT 14:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3"/>I hessa giday Herodiisi ba ishaa Filphoosa mache Herodiyadi gaason Yohaanisa qasho keethi gelsida gishosa. <verse eid="MAT 14:3"/><verse number="4" style="v" sid="MAT 14:4"/>Yohaanisi Herodiisa, “Ne iyo ekanaw woga gidenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">Luqa 3:19-20</ref>; <ref loc="LEV 18:16">Leewe 18:16</ref>; <ref loc="LEV 20:21">20:21</ref>.</char></note> <verse eid="MAT 14:4"/><verse number="5" style="v" sid="MAT 14:5"/>Herodiisi Yohaanisa wodhanaw koyis, shin derey Yohaanisa nabe oothidi be7iya gisho yashetis.<verse eid="MAT 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6"/>Herodiisi ba yeletida gallasa bonchiya wode, Herodiyada na7iya asaa sinthan yethan durada iya ufaysasu. <verse eid="MAT 14:6"/><verse number="7" style="v" sid="MAT 14:7"/>Yaatin, I, “Iya koyaba ubbaa immana gidi” caaqis. <verse eid="MAT 14:7"/><verse number="8" style="v" sid="MAT 14:8"/>Na7iya ba aaye zoriya si7ada Herodiisako, “Xammaqiya Yohaanisa huuphiya keren wothada taw imma” yaagasu. <verse eid="MAT 14:8"/><verse number="9" style="v" sid="MAT 14:9"/>Iya yaagin kawoy qiirotis, shin ba caaquwa gishonne baara de7iya imathata gisho gidi I oyshay poletana mela kiittis. <verse eid="MAT 14:9"/><verse number="10" style="v" sid="MAT 14:10"/>Kawoy ase kiittidi Yohaanisi qasho keethan de7ishin iya qoodhiya gora7isis. <verse eid="MAT 14:10"/><verse number="11" style="v" sid="MAT 14:11"/>Huuphiya keren wothi ehidi na7ees immidosona; na7iyaka ekada ba aayes efasu. <verse eid="MAT 14:11"/><verse number="12" style="v" sid="MAT 14:12"/>Yohaanisa tamaareti yidi iya aha efidi moogidosona. Iyape guye hanidaba ubbaa bidi Yesuusas odidosona.<verse eid="MAT 14:12"/></para>
  <para style="s1">Ichashu Mukulu Asaa</para>
  <para style="r">(<ref loc="MRK 6:30-44">Mar 6:30-44</ref>; <ref loc="LUK 9:10-17">Luqa 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoha 6:1-14</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13"/>Yesuusi hanidaba si7ida wode wogolon gelidi he bessaafe issi geemmiya soo barka bis. Asay hessa si7idi katamatape dendidi tohon iya kaallidosona. <verse eid="MAT 14:13"/><verse number="14" style="v" sid="MAT 14:14"/>Yesuusi wogoluwape wodhidi daro asaa be7idi entaw qadhetis. Enta giddon de7iya harganchota pathis.<verse eid="MAT 14:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15"/>Sa7ay omarsishe biya wode Yesuusa tamaareti iyako shiiqidi, “Ha bessay asi bayna bessi, sa7ika qammis. Yaaniya gisho, heeran de7iya gutata bidi bantaw shammidi maana mela deriya yedda” yaagidosona.<verse eid="MAT 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16"/>Shin Yesuusi entako, “Derey moonna baanaw koshshenna; enti maanaba hinte immite” yaagis.<verse eid="MAT 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17"/>Enti zaaridi, “Nuus haysan ichashu uythaafenne nam7u molope hari baawa” yaagidosona.<verse eid="MAT 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18"/>Ika, “Ane enta haa ehite” yaagis. <verse eid="MAT 14:18"/><verse number="19" style="v" sid="MAT 14:19"/>Kaallidika, derey maatan uttana mela odis. Ichashu uythaanne nam7u molota ekidi, salo xeellidi galati simmidi, uythaa menthidi ba tamaaretas immis; enti qassi deriyas immidosona. <verse eid="MAT 14:19"/><verse number="20" style="v" sid="MAT 14:20"/>Ubbay midi kallidosona. Yesuusa tamaareti mishin attidaysa tammanne nam7u gayta denthidosona. <verse eid="MAT 14:20"/><verse number="21" style="v" sid="MAT 14:21"/>Kathaa mida asay maccasaynne nayti attishin, ichashu mukulu gidees.<verse eid="MAT 14:21"/></para>
  <para style="s1">Yesuusi Abba Bollara Hemetis</para>
  <para style="r">(<ref loc="MRK 6:45-52">Mar 6:45-52</ref>; <ref loc="JHN 6:15-21">Yoha 6:15-21</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22"/>Yesuusi ba tamaareti wogolon gelidi baape sinthatidi abbaafe he pinthi pinnana mela kiittidi baw deriya moyzanaw guye attis. <verse eid="MAT 14:22"/><verse number="23" style="v" sid="MAT 14:23"/>Deriya moyzi simmidi barka woossanaw issi zuma bolla keyis. Sa7ay qamminka I barka yan gam7is. <verse eid="MAT 14:23"/><verse number="24" style="v" sid="MAT 14:24"/>He wode wogoloy abba bolla bishin sintha baggara carkoy dendin hobbey wogoluwa un7ethis.<verse eid="MAT 14:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25"/>Wontimaatha bolla Yesuusi abba bolla hemetishe ba tamaaretako yis. <verse eid="MAT 14:25"/><verse number="26" style="v" sid="MAT 14:26"/>Iya tamaareti, I abba bolla hemetishe bantako yeysa be7idi yayyidosona. Entika, “Haysi moytille” gidi yayyidi waassidosona.<verse eid="MAT 14:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27"/>Shin Yesuusi ellessidi, “Aykoy baawa! Yayyofite! Tanabay” yaagis.<verse eid="MAT 14:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28"/>Phexroosi iyako, “Godaw, nena gidiko, taani haatha bollara hemetada neeko baana mela tana kiitta” yaagis.<verse eid="MAT 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29"/>Yesuusi Phexroosako, “Haaya” yaagis.</para>
  <para style="p" vid="MAT 14:29">Phexroosi wogoluwape wodhidi haatha bollara hemetishe Yesuusako buussu oykis. <verse eid="MAT 14:29"/><verse number="30" style="v" sid="MAT 14:30"/>Shin wolqaama carkuwa be7idi yayyis. Haathan mitetethi oykida wode, “Godaw! tana ashsharki!” yaagidi waassis.<verse eid="MAT 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31"/>Yesuusi ellesidi ba kushiya yeddi iya oykidi, “Neno, ammanoy pacidayso ayis sidhay” yaagis.<verse eid="MAT 14:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32"/>Yesuusaranne Phexroosara wogoluwan gelida wode carkoy si77i gis. <verse eid="MAT 14:32"/><verse number="33" style="v" sid="MAT 14:33"/>Wogoluwa giddon de7iya iya tamaareti, “Neeni tumaka Xoossa Na7a” gidi goyinnidosona.<verse eid="MAT 14:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34"/>Enti abba pinnidi Gensareexe biitta gakidosona. <verse eid="MAT 14:34"/><verse number="35" style="v" sid="MAT 14:35"/>He biittan de7iya asay Yesuusa erida wode banta heeran de7iya guta ubba kiita yeddidosona. Asay harganchota ubbaa iyako ehidosona. <verse eid="MAT 14:35"/><verse number="36" style="v" sid="MAT 14:36"/>Harganchoti iya afila macaraa xalaala bochana mela woossidosona. Bochida ubbayka paxidosona.<verse eid="MAT 14:36"/></para>
  <chapter eid="MAT 14"/>
  <chapter number="15" style="c" sid="MAT 15"/>
  <para style="s1">Farsaaweta Woga</para>
  <para style="r">(<ref loc="MRK 7:1-13">Mar 7:1-13</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1"/>Hessafe guye, issi issi Farsaawetinne higge astamaareti Yerusalaamepe Yesuusako yidi, <verse eid="MAT 15:1"/><verse number="2" style="v" sid="MAT 15:2"/>“Ne tamaareti ayis nu aawata wogaa menthona? Enti kathi maanape sinthe banta kushiya meecetokona” yaagidi oychidosona.<verse eid="MAT 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 15:3"/>Yesuusi zaaridi, “Hinte, hinte wogaa gisho, Xoossaa kiitaa poleysa ayis ixeetii? <verse eid="MAT 15:3"/><verse number="4" style="v" sid="MAT 15:4"/>Ayis giiko, Xoossay, ‘Ne aawanne ne aayiw boncha. I ba aawa woyko ba aayiw cayeysi hayqo gibeennee?’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Kessa 20:12</ref>; <ref loc="DEU 5:16">Zaare 5:16</ref>; <ref loc="EXO 21:17">Kessa 21:17</ref>; <ref loc="LEV 20:9">Leewe 20:9</ref>.</char></note> <verse eid="MAT 15:4"/><verse number="5" style="v" sid="MAT 15:5"/>Shin hinte, issi asi ba aawa woyko ba aayiw maaddanabay de7ishin, ‘Haysa ta Xoossas yarshas giiko, <verse eid="MAT 15:5"/><verse number="6" style="v" sid="MAT 15:6"/>ba aawa woyko ba aayiw bonchanaw bessenna’ yaageeta. Yaatidi hinte, hinte wogaa polanaw Xoossaa qaala mentheta. <verse eid="MAT 15:6"/><verse number="7" style="v" sid="MAT 15:7"/>Hinteno, cubboto, Isayaasi hintebaa like odis,<verse eid="MAT 15:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8"/>“ ‘Ha asay tana banta doonan bonchees,</para>
  <para style="q2" vid="MAT 15:8">shin enta wozanay taape haahon de7ees.<verse eid="MAT 15:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9"/>Asay tana coo goyinnoosona;</para>
  <para style="q2" vid="MAT 15:9">enti asi medhida kiitaa</para>
  <para style="q2" vid="MAT 15:9">Xoossaa higge daanisidi tamaarsoosona’ gis” yaagis.<verse eid="MAT 15:9"/></para>
  <para style="s1">Ase Tunisiyabata</para>
  <para style="r">(<ref loc="MRK 7:14-23">Mar 7:14-23</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10"/>Yesuusi daro asaa baako xeegidi, “Si7ite! Akeekite! <verse eid="MAT 15:10"/><verse number="11" style="v" sid="MAT 15:11"/>Ase tunisiyabay doonara geliyaba gidonashin doonape keyaaba” yaagis.<verse eid="MAT 15:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12"/>Hessafe guye, Yesuusa tamaareti iyako yidi, “Farsaaweti neeni gidaysa si7idi dhubetidaysa akeekay?” yaagidosona.<verse eid="MAT 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13"/>Shin Yesuusi zaaridi, “Salon de7iya ta aaway tokiboonna mithi ubbay shodetana. <verse eid="MAT 15:13"/><verse number="14" style="v" sid="MAT 15:14"/>Entaba Hirgofite; enti qooqe kaalethiya qooqeta. Qooqey qooqe kaalethiko, nam7ayka ollan kundana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="LUK 6:39">Luqa 6:39</ref>.</char></note><verse eid="MAT 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15"/>Phexroosi zaaridi, “Ha leemisuwa birshethaa nuus odarkii” yaagis.<verse eid="MAT 15:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16"/>Yesuusi entako, “Hintewuka ha77i gakanaw gelibeennee? <verse eid="MAT 15:16"/><verse number="17" style="v" sid="MAT 15:17"/>Doonara geliyaba ubbay ulo gelidi kare keyeysa ereketii? <verse eid="MAT 15:17"/><verse number="18" style="v" sid="MAT 15:18"/>Shin doonara keyaabay wozanape keyees. Ase tunisiyabati hessata.<note caller="-" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="MAT 12:34">Maato 12:34</ref>.</char></note> <verse eid="MAT 15:18"/><verse number="19" style="v" sid="MAT 15:19"/>Entika:- asa wozana giddofe keyiya iita qofa, wodho, laymatethi, iita ooso, kayso, wordo markatethi, cashshe. <verse eid="MAT 15:19"/><verse number="20" style="v" sid="MAT 15:20"/>Hessa daaniyabati ase tuniseesipe attishin, meecetonna kushera meysi tunisenna” yaagis.<verse eid="MAT 15:20"/></para>
  <para style="s1">Issi Maccase Ammano</para>
  <para style="r">(<ref loc="MRK 7:24-30">Mar 7:24-30</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21"/>Hessafe guye, Yesuusi yaape keyidi Xiroosanne Sidoona katamati de7iya biitta bis. <verse eid="MAT 15:21"/><verse number="22" style="v" sid="MAT 15:22"/>Issi Kanaane biitta maccas Yesuusako yada, ba qaala dhoqu oothada, “Godaw, Dawita na7aw, taw qadhetarki; ta na7iw tuna ayyaanay oykidi iita waaysees” yaagasu.<verse eid="MAT 15:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23"/>Shin Yesuusi issi qaalaka zaaronna si77i gis. Yesuusa tamaareti iyako yidi, “Ha maccasiya nu geedo kaalla kaallada, woossawusu. Hessa gisho, neeni iyo moyzarki” yaagidi woossidosona.<verse eid="MAT 15:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24"/>Yesuusi zaaridi, “Taani wudepe dhayida dorsada Isra7eele keethaafe dhayida asata xalaalas kiitetas” yaagis.<verse eid="MAT 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25"/>Shin iya, iya sinthan kundada, “Godaw, tana maaddarkii?” yaagasu.<verse eid="MAT 15:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26"/>I zaaridi, “Nayta kathi ekidi kanatas yeggeysi lo77o gidenna” yaagis.<verse eid="MAT 15:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27"/>Maccasiyaka, “Godaw, hessi tuma, shin hari attoshin kanati banta godati mishin, gaytape wodhiya tiifiya moosona” yaagasu.<verse eid="MAT 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28"/>Yesuusi zaaridi, “Ha maccasete, ne ammanoy gita; ne koydaysada new hano” yaagis. I na7iya iiraka paxa aggasu.<verse eid="MAT 15:28"/></para>
  <para style="s1">Daro Harganchoti Paxidosona</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29"/>Yesuusi yaape dendidi Galila Abbaa mati bis. Issi zuma bolla keyidi, yan uttis. <verse eid="MAT 15:29"/><verse number="30" style="v" sid="MAT 15:30"/>Daro asay bantara, wobbeta, qooqeta, kuunata, doona muumetanne, hara daro harganchota ekidi, iyako ehidi iya sinthan wothidosona. Yesuusi entana pathis. <verse eid="MAT 15:30"/><verse number="31" style="v" sid="MAT 15:31"/>Hessa gisho, muumeti odetishin, kuunati piddi gishin, wobbeti hemetishin, qooqeti xeellishin asay be7idi malaaletidi, Isra7eele Xoossaa galatidosona.<verse eid="MAT 15:31"/></para>
  <para style="s1">Oyddu Mukulu Asa</para>
  <para style="r">(<ref loc="MRK 8:1-10">Mar 8:1-10</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32"/>Yesuusi ba tamaareta baako xeegidi, “Ha daro asay taara heedzu gallas gam7ida gishonne entaw ha77i miyabay bayna gisho taani entaw qadhetayis. Enti ogen daaburidi kundonna mela ayko muzonna enta mela yeddanaw koyke” yaagis.<verse eid="MAT 15:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33"/>Iya tamaareti zaaridi, “Nuuni ha bazzuwan haysa keena asaas gidiya kathi awupe demmanee?” yaagidosona.<verse eid="MAT 15:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34"/>Yesuusi entako, “Hintew aapun uythi de7ii?” yaagidi oychis.</para>
  <para style="p" vid="MAT 15:34">Enti zaaridi, “Laapun uythinne laafa molotape guuthi de7ees” yaagidosona.<verse eid="MAT 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35"/>Yesuusi deriya sa7an uttite yaagidi kiittis. <verse eid="MAT 15:35"/><verse number="36" style="v" sid="MAT 15:36"/>Hessafe guye, he laapun uythaanne moluwa ekidi Xoossaa galatis. Menthidi ba tamaaretas immis. Iya tamaareti daro asaas gishidosona.<verse eid="MAT 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 15:37"/>Asa ubbay midi kallidosona. Iya tamaareti, mishin attida tiifiya laapun gita gayta kumethi denthidosona. <verse eid="MAT 15:37"/><verse number="38" style="v" sid="MAT 15:38"/>Mida asay maccasinne na7a paydonna adde xalaali oyddu mukulu. <verse eid="MAT 15:38"/><verse number="39" style="v" sid="MAT 15:39"/>Yesuusi deriya yeddidaape guye wogoluwan gelidi Magedoona biitta bis.<verse eid="MAT 15:39"/></para>
  <chapter eid="MAT 15"/>
  <chapter number="16" style="c" sid="MAT 16"/>
  <para style="s1">Malaata Be7anaw Oychida Oysha</para>
  <para style="r">(<ref loc="MRK 8:11-13">Mar 8:11-13</ref>; <ref loc="LUK 12:54-56">Luqa 12:54-56</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1"/>Farsaawetinne Saduqaaweti Yesuusako yidosona. Iya paacanaw koyidi, bantana salope malaata besso gidi oychidosona.<note caller="-" style="x"><char style="xo" closed="false">16:1 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Maato 12:38</ref>; <ref loc="LUK 11:16">Luqa 11:16</ref>.</char></note> <verse eid="MAT 16:1"/><verse number="2" style="v" sid="MAT 16:2"/>Shin I entako, “Sa7i omarsiya wode, ‘Saloy zo77ida gisho wonto booqallana’ yaageeta. <verse eid="MAT 16:2"/><verse number="3" style="v" sid="MAT 16:3"/>Wontiya wode, ‘Saloy zo77idi shaaratida gisho iri bukana’ yaageeta. Yaatin hinte salo mallaa be7idi ereeta, shin wodiya malla eranaw danda7ibeeketa. <verse eid="MAT 16:3"/><verse number="4" style="v" sid="MAT 16:4"/>Iitanne ammanonna yeletethay malaata koyees. Shin iyaw Yoonasa malaatape hara malaati imetenna” yaagis. Hessafe guye, entana yan aggidi hara soo bis.<note caller="-" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Maato 12:39</ref>; <ref loc="LUK 11:29">Luqa 11:29</ref>.</char></note><verse eid="MAT 16:4"/></para>
  <para style="s1">Farsaawetanne Saduqaaweta Irsho</para>
  <para style="r">(<ref loc="MRK 8:14-21">Mar 8:14-21</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5"/>Enti abbaafe hefinthi pinnida wode daabbo ekidi yaanaysa dogidosona. <verse eid="MAT 16:5"/><verse number="6" style="v" sid="MAT 16:6"/>Yesuusi entako, “Farsaawetapenne Saduqaaweta irshuwafe naagetite” yaagis.<note caller="-" style="x"><char style="xo" closed="false">16:6 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luqa 12:1</ref>.</char></note> <verse eid="MAT 16:6"/><verse number="7" style="v" sid="MAT 16:7"/>Entika banta garsan, “I hessa giday nu daabbo ekidi yoonna gishosa gidana” yaagidosona. <verse eid="MAT 16:7"/><verse number="8" style="v" sid="MAT 16:8"/>Yesuus enta qofaa eridi, “Hinteno, ammanoy pacidaysato! Daabbo ekonna yida gisho woli giddon ayis odeteetii? <verse eid="MAT 16:8"/><verse number="9" style="v" sid="MAT 16:9"/>Ha77ika hinte akeeketii? Ichashu mukulu asaas ichashu uythaa gishidaysanne enti midi kallin hinte aapun gayta kumethi denthidaako dogidetii?<note caller="-" style="x"><char style="xo" closed="false">16:9 </char><char style="xt" closed="false"><ref loc="MAT 14:17">Maato 14:17</ref>.</char></note> <verse eid="MAT 16:9"/><verse number="10" style="v" sid="MAT 16:10"/>Hessadaka, laapun uythaa oyddu mukulu asaas gishidaysanne enti midi kallin, hinte aapun gita gayta kumethi denthidaako akeekeketii?<note caller="-" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="MAT 15:34">Maato 15:34</ref>.</char></note> <verse eid="MAT 16:10"/><verse number="11" style="v" sid="MAT 16:11"/>Hiza, taani Farsaawetanne Saduqaaweta irshuwafe naagetite gada odeysi daabboba gidonnaysa akeekeketii?” yaagis. <verse eid="MAT 16:11"/><verse number="12" style="v" sid="MAT 16:12"/>Yaatin, iya tamaareti Yesuusi odey munuqa denthanaw yegetiya irshoba gidonashin Farsaawetanne Saduqaaweta timirtiyafe naagetanaysa gideysa akeekidosona.<verse eid="MAT 16:12"/></para>
  <para style="s1">Phexroosa Markatetha</para>
  <para style="r">(<ref loc="MRK 8:27-30">Mar 8:27-30</ref>; <ref loc="LUK 9:18-21">Luqa 9:18-21</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13"/>Yesuusi Qisaare Filphoosa biitta gakida wode ba tamaaretako, “Asay, Asa Na7aa oona goonna?” yaagidi oychis.<verse eid="MAT 16:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 16:14"/>Entika, “Issoti issoti Xammaqiya Yohaanisa, harati Eeliyaasa qassi hankoti Ermiyaasa woyko nabetape issuwa goosona” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">16:14 </char><char style="xt" closed="false"><ref loc="MAT 14:1">Maato 14:1</ref>.</char></note><verse eid="MAT 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 16:15"/>Yesuusi zaaridi, “Yaatin, hinte tana oona geetii?” gidi enta oychis.<verse eid="MAT 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 16:16"/>Simoona Phexroosi zaaridi, “Neeni Kiristoosa, de7o Xoossaa na7a” yaagis.<note caller="-" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="JHN 6:68">Yoha 6:68</ref>.</char></note><verse eid="MAT 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 16:17"/>Yesuusi Phexroosako, “Yoona na7aa Simoona, neeni anjetidaysa! Haysa new qoncisiday saluwan de7iya ta aawape attishin, ase gidenna. <verse eid="MAT 16:17"/><verse number="18" style="v" sid="MAT 16:18"/>Ta new odayis Phexroosa, neeni zaalla! Taani ha zaalla bolla ta woosa keethaa keexana. Hayqo wolqatika iyo xoonokona. <verse eid="MAT 16:18"/><verse number="19" style="v" sid="MAT 16:19"/>Salo kawotethaa qulpeta ta new immana. Sa7an neeni diggiyabay ubbay salon Xoossaa matan digetidaba gidana. Sa7an neeni hano giyabay ubbay salon Xoossaa matan hanidaba gidana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="MAT 18:18">Maato 18:18</ref>; <ref loc="JHN 20:23">Yoha 20:23</ref>.</char></note><verse eid="MAT 16:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 16:20"/>Hessafe guye, I, Kiristoosa gideysa oodeska odonna mela ba tamaareta minthidi kiittis.<verse eid="MAT 16:20"/></para>
  <para style="s1">Yesuusi Bana Gakana Waaya Odis</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21"/>He wodiyape doomidi Yesuusi ba tamaaretas, “Taani Yerusalaame baanaw bessees. Yan deriya cimatan, kahine halaqatanne higge astamaareta kushen waaye ekanaw bessees. Enti tana wodhana, shin taani heedzantho gallas hayqope dendana” yaagidi qoncisis.<verse eid="MAT 16:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 16:22"/>Phexroosi Yesuusa gaxa kessidi, “Godaw, hessi hanenna! Hessa melabay nena ubbaraka gakofo!” yaagidi hanqetis.<verse eid="MAT 16:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 16:23"/>Yesuusi Phexroosako guye simmidi, “Ha Xalahiyaw, taape haaka! Neeni asa qofa qopaasape attishin, Xoossaa qofa qoponna gisho taw dhube gidaasa” yaagis.<verse eid="MAT 16:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24"/>Hessafe guye, Yesuusi ba tamaaretako, “Oonika tana kaallanaw koyaba gidiko bana kaddo, ba masqaliya tookidi tana kaallo.<note caller="-" style="x"><char style="xo" closed="false">16:24 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Maato 10:38</ref>; <ref loc="LUK 14:27">Luqa 14:27</ref>.</char></note> <verse eid="MAT 16:24"/><verse number="25" style="v" sid="MAT 16:25"/>Ba de7uwa ashshanaw koyiya ubbay dhaysees. Shin ba de7uwa ta gisho gidi aathidi immeysi ashshees.<note caller="-" style="x"><char style="xo" closed="false">16:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Maato 10:39</ref>; <ref loc="LUK 17:33">Luqa 17:33</ref>; <ref loc="JHN 12:25">Yoha 12:25</ref>.</char></note> <verse eid="MAT 16:25"/><verse number="26" style="v" sid="MAT 16:26"/>Asi alame kumethi baw oothidi, gidoshin ba shempuwa dhaysiko iya ay maaddii? Woyko asi ba shempuwa laame ay immanaw danda7ii? <verse eid="MAT 16:26"/><verse number="27" style="v" sid="MAT 16:27"/>Asa na7ay ba aawa bonchuwan ba kiitanchotara yaana. He wode issi issi uraas iya oosuwada immana.<note caller="-" style="x"><char style="xo" closed="false">16:27 </char><char style="xt" closed="false"><ref loc="MAT 25:31">Maato 25:31</ref>; <ref loc="PSA 62:12">Maz 62:12</ref>; <ref loc="ROM 2:6">Roome 2:6</ref>.</char></note> <verse eid="MAT 16:27"/><verse number="28" style="v" sid="MAT 16:28"/>Ta tuma odayis; haysan eqida asatape Asa Na7ay kawo gididi simmeysa be7ana gakanaw hayqonnaysati haysan de7oosona” yaagis.<verse eid="MAT 16:28"/></para>
  <chapter eid="MAT 16"/>
  <chapter number="17" style="c" sid="MAT 17"/>
  <para style="s1">Yesuusa Malay Laametis</para>
  <para style="r">(<ref loc="MRK 9:2-13">Mar 9:2-13</ref>; <ref loc="LUK 9:28-36">Luqa 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1"/>Usupun gallasape guye Yesuusi, Phexroosa, Yayqoobanne iya ishaa Yohaanisa baara ekidi bantarka gidanaw zuma bolla keyis.<note caller="-" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 Phex 1:17-18</ref>.</char></note> <verse eid="MAT 17:1"/><verse number="2" style="v" sid="MAT 17:2"/>Yan enta sinthan Yesuusa malay kumethi laametis; iya som7oyka awada xolqis. Iya ma7oyka daro booxis. <verse eid="MAT 17:2"/><verse number="3" style="v" sid="MAT 17:3"/>Heko, Museynne Eeliyaasi iyara odetishin be7idosona. <verse eid="MAT 17:3"/><verse number="4" style="v" sid="MAT 17:4"/>Phexroosi Yesuusako, “Nuuni haysa hashshu yida. Ne koyko issino new, issino Muses, issino Eeliyaasas haysan heedzu shaqara shaqarana” yaagis. <verse eid="MAT 17:4"/><verse number="5" style="v" sid="MAT 17:5"/>Phexroosi hessa buroo odishin bootha shaaray entana kammis. Shaara giddora, “Tana ufaysiya, ta dosiya na7ay haysa, iya si7ite!” giya qaalay yis.<note caller="-" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Medhe 22:2</ref>; <ref loc="PSA 2:7">Maz 2:7</ref>; <ref loc="ISA 42:1">Isa 42:1</ref>; <ref loc="MAT 3:17">Maato 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luqa 3:22</ref>; <ref loc="DEU 18:15">Zaare 18:15</ref>.</char></note> <verse eid="MAT 17:5"/><verse number="6" style="v" sid="MAT 17:6"/>Yesuusa tamaareti hessa si7ida wode dagammidi banta som7uwara sa7an kundidosona. <verse eid="MAT 17:6"/><verse number="7" style="v" sid="MAT 17:7"/>Shin Yesuusi entako shiiqidi enta bochidi, “Dendite, yayyofite!” yaagis. <verse eid="MAT 17:7"/><verse number="8" style="v" sid="MAT 17:8"/>Enti dhoqu gidi be7iya wode Yesuusape hara oonaka be7ibookona.<verse eid="MAT 17:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9"/>Enti zumaa bollafe wodhishin Yesuusi entako, “Asa Na7ay hayqope dendana gakanaw ha hinte be7idaba oodeska odopite” gidi kiittis. <verse eid="MAT 17:9"/><verse number="10" style="v" sid="MAT 17:10"/>Yesuusa tamaareti, “Yaatin, higge astamaareti Eeliyaasi Kiristoosape kasetidi yaana giday aybisee?” yaagidi oychidosona.<note caller="-" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Milki 4:5</ref>.</char></note><verse eid="MAT 17:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 17:11"/>Yesuusi zaaridi, “Ee! Eeliyaasi kaseti yidi ubbaba giigisana. <verse eid="MAT 17:11"/><verse number="12" style="v" sid="MAT 17:12"/>Shin ta hintew tuma odayis; Eeliyaasi kasetidi yis. Entika iya bolla koydaba oothidosonape attishin, iya shaaki eribookona. Hessada Asa Na7ay enta kushen waayetana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="MAT 11:14">Maato 11:14</ref>.</char></note><verse eid="MAT 17:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 17:13"/>He wode Yesuusi giday Xammaqiya Yohaanisaba gideysa akeekidosona.<verse eid="MAT 17:13"/></para>
  <para style="s1">Tuna Ayyaani Oykida Na7a</para>
  <para style="r">(<ref loc="MRK 9:14-29">Mar 9:14-29</ref>; <ref loc="LUK 9:37-43">Luqa 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14"/>Enti deriyape asaako simmiya wode issi asi Yesuusa sinthan gulbatidi, <verse eid="MAT 17:14"/><verse number="15" style="v" sid="MAT 17:15"/>“Godaw, hayyana ta na7aas qadhetarki; iya shocidi yeggiya hargey daro un7ethidi tamaninne haathan yeggees. <verse eid="MAT 17:15"/><verse number="16" style="v" sid="MAT 17:16"/>Ne tamaaretako ehas, shin enti pathanaw danda7ibookona” yaagis.<verse eid="MAT 17:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17"/>Yesuusi zaaridi, “Hinteno, ammanonna geella yeletethaw awude gakanaw ta hintera daanee? Awude gakanaw ta hintena danda7anee? Ane na7aa haa eki yiite” yaagis. <verse eid="MAT 17:17"/><verse number="18" style="v" sid="MAT 17:18"/>Yesuusi tuna ayyaana hanqin, tuna ayyaanay na7aape keyis; he saatenka na7ay paxis. <verse eid="MAT 17:18"/><verse number="19" style="v" sid="MAT 17:19"/>Hessafe guye, Yesuusa tamaareti bantarka iyako shiiqidi, “Nuuni tuna ayyaana kessanaw danda7iboonay aybisee?” yaagidi oychidosona. <verse eid="MAT 17:19"/><verse number="20" style="v" sid="MAT 17:20"/>I entako, “Hintew ammanoy laafida gishosa. Ta hintew tuma odayis; gaashe ayfe mela ammanoy hintew de7iko ‘Ha zumaa haysafe dendada gede aadha’ giiko hintew kiitetana. Hintew danda7etonabay deenna. <verse eid="MAT 17:20"/><verse number="21" style="v" sid="MAT 17:21"/>[Shin hessa melay woosapenne xoomape attishin, haran keyenna”] yaagis.<note caller="-" style="x"><char style="xo" closed="false">17:21 </char><char style="xt" closed="false"><ref loc="MAT 21:21">Maato 21:21</ref>; <ref loc="MRK 11:23">Mar 11:23</ref>; <ref loc="2CO 13:2">2 Qoro 13:2</ref>.</char></note><note caller="+" style="f"><char style="fr" closed="false">17:21 </char><char style="ft" closed="false">Issi issi beni maxaafatan paydo 21 deenna.</char></note><verse eid="MAT 17:21"/></para>
  <para style="s1">Yesuusi Ba Hayquwaba Zaaridi Odis</para>
  <para style="r">(<ref loc="MRK 9:30-32">Mar 9:30-32</ref>; <ref loc="LUK 9:43-45">Luqa 9:43-45</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22"/>Yesuusa tamaareti Galilan shiiqidi de7ishin Yesuusi entako, “Asa Na7i asa kushen aadhidi imetana. <verse eid="MAT 17:22"/><verse number="23" style="v" sid="MAT 17:23"/>Enti iya wodhana, shin I heedzantho gallas hayqope dendana” yaagis.</para>
  <para style="p" vid="MAT 17:23">Iya tamaaretika daro qiirotidosona.<verse eid="MAT 17:23"/></para>
  <para style="s1">Xoossa Keetha Giira</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24"/>Yesuusaranne iya tamaaretara Qifirnahooma katama gakida wode Xoossa Keetha giira qanxiseysati Phexroosako yidi, “Hinte astamaarey Xoossa Keetha giira giirii?” yaagidi oychidosona.<note caller="-" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="EXO 30:13">Kessa 30:13</ref>.</char></note><verse eid="MAT 17:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25"/>Phexroosi zaaridi, “Giirees” yaagis. Phexroosi soo geliya wode Yesuusi kasetidi, “Phexroosa, new ay daanii? Ha sa7aa kawotethati qaraxanne giira oope ekona? Gade asapeye woyko asa gade asapee?”<note caller="+" style="f"><char style="fr" closed="false">17:25 </char><char style="fk" closed="false">Gade asapeye woyko asa gade asapee: </char><char style="ft" closed="false">He wode kawotethati banta gade asape giira ekokona.</char></note> yaagidi oychis.<verse eid="MAT 17:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26"/>Phexroosi “Asa gade asape” gidi zaaris.</para>
  <para style="p" vid="MAT 17:26">Yesuusi zaaridi, “Gade asay giira giirokona guussu. <verse eid="MAT 17:26"/><verse number="27" style="v" sid="MAT 17:27"/>Shin enti dhubetonna mela abba bada molo oykanaw manxaqo yegga. Koyro ne oykiya moluwa doona dooyada giiras gidiya miishe ne gishonne ta gisho efada giira” yaagis.<verse eid="MAT 17:27"/></para>
  <chapter eid="MAT 17"/>
  <chapter number="18" style="c" sid="MAT 18"/>
  <para style="s1">Ubbaafe Aadhey Oonee?</para>
  <para style="r">(<ref loc="MRK 9:33-37">Mar 9:33-37</ref>; <ref loc="LUK 9:46-48">Luqa 9:46-48</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1"/>He wode Yesuusa tamaareti yidi, “Salo kawotethan ubbaafe aadhey oonee?” yaagidi oychidosona.<note caller="-" style="x"><char style="xo" closed="false">18:1 </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luqa 22:24</ref>.</char></note> <verse eid="MAT 18:1"/><verse number="2" style="v" sid="MAT 18:2"/>Yesuusi issi guutha na7a xeegidi enta giddon essidi haysada yaagis. <verse eid="MAT 18:2"/><verse number="3" style="v" sid="MAT 18:3"/>“Taani hintew tuma odayis; hinte laametonnanne guutha naytada hanonna ixiko salo kawotethaa ubbaraka gelanaw danda7eketa.<note caller="-" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="MRK 10:15">Mar 10:15</ref>; <ref loc="LUK 18:17">Luqa 18:17</ref>.</char></note> <verse eid="MAT 18:3"/><verse number="4" style="v" sid="MAT 18:4"/>Hiza, ha guutha na7ada bana kawushiya oonika salo kawotethan ubbaafe aadheysa gidana. <verse eid="MAT 18:4"/><verse number="5" style="v" sid="MAT 18:5"/>Haysa mela na7a ta sunthan mokiya oonika tana mokees.<verse eid="MAT 18:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6"/>“Shin tanan ammaniya ha guuthatape issuwa nagara oothana mela dhube gidiya oonika gita gaacha woxa ba qoodhen qachidi ciimmo abban mitetiko iyaw lo77o. <verse eid="MAT 18:6"/><verse number="7" style="v" sid="MAT 18:7"/>Alamen asay nagara oothana mela oothiyabati de7iya gisho alamiya ayye! Hessa melabati yoonna attenna, shin dhubey iya gaason yaa uraa ayye!<verse eid="MAT 18:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8"/>“Ne kushey woyko ne tohoy nena balethiko neepe qanxa yegga. Neeni nam7u kushera woyko nam7u tohora merinaa taman yegetanaape kushe woyko toho duuxa gidada merinaa de7o demmeysi new lo77o.<note caller="-" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="MAT 5:30">Maato 5:30</ref>.</char></note> <verse eid="MAT 18:8"/><verse number="9" style="v" sid="MAT 18:9"/>Qassi ne ayfey nena balethiko iyo wooca kessada wora hola. Neeni nam7u ayfera gaanname taman yegeteysafe issi ayfera merinaa de7uwa geleysi new lo77o.<note caller="-" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Maato 5:29</ref>.</char></note><verse eid="MAT 18:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10"/>“Ta hintew odayis; salon de7iya enta naagiya kiitanchoti ubba wode salon de7iya ta Aawa sinthan de7iya gisho, hinte ha guuthatape issuwaka kadhonna mela naagetite.<note caller="-" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="LUK 19:10">Luqa 19:10</ref>.</char></note> <verse eid="MAT 18:10"/><verse number="11" style="v" sid="MAT 18:11"/>Asa Na7ay dhaydaysata ashshanaw yis”<note caller="+" style="f"><char style="fr" closed="false">18:11 </char><char style="fqa" closed="false">Asa Na7ay dhayidaysata ashshanaw yis: </char><char style="ft" closed="false">Issi issi beni maxaafati paydo 11 gujoosona.</char></note> yaagis.<verse eid="MAT 18:11"/></para>
  <para style="s1">Dhayda Dorsa Leemiso</para>
  <para style="r">(<ref loc="LUK 15:3-7">Luqa 15:3-7</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12"/>Qassi Yesuusi, “Hintew ay daanii? Issi uraas xeetu dorsati de7eysatape issoy dhayiko uddufun tammanne uddufunata deriya bolla yeggi aggidi he dhayidaysa koyanaw beennee? <verse eid="MAT 18:12"/><verse number="13" style="v" sid="MAT 18:13"/>Ta tuma odayis; I demmida wode uddufun tammanne uddufunatape aathidi dhayidi bentida issi dorsa gisho ufaytees. <verse eid="MAT 18:13"/><verse number="14" style="v" sid="MAT 18:14"/>Hessadaka, salon de7iya hinte aaway ha guuthatape issoy dhayana mela koyenna.<verse eid="MAT 18:14"/></para>
  <para style="s1">Qohida Asi Waatanee?</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15"/>“Ne ishay nena qohiko nerka iyako bada iya qohuwa iyaw oda. I nena si7iko iya new isha ootha.<note caller="-" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="LUK 17:3">Luqa 17:3</ref>.</char></note> <verse eid="MAT 18:15"/><verse number="16" style="v" sid="MAT 18:16"/>Shin I nena si7onna ixiko, nam7u woyko heedzu asa markan mootoy lasetiya gisho, issi woyko nam7u asi ekada iyako ba.<note caller="-" style="x"><char style="xo" closed="false">18:16 </char><char style="xt" closed="false"><ref loc="DEU 19:15">Zaare 19:15</ref>.</char></note> <verse eid="MAT 18:16"/><verse number="17" style="v" sid="MAT 18:17"/>I entana si7onna ixiko, woosa keethas oda. Woosa keethi giyaba si7onna ixiko ammanonna asada woyko qaraxa qanxisiya asada iya payda.<verse eid="MAT 18:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18"/>“Ta hintew tuma odayis; sa7an hinte diggiyabati ubbay salon Xoossaa matan digetidaba gidana. Sa7an hinte hano giyabati ubbay salon Xoossa matan hanidaba gidana.<note caller="-" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="MAT 16:19">Maato 16:19</ref>; <ref loc="JHN 20:23">Yoha 20:23</ref>.</char></note><verse eid="MAT 18:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19"/>“Qassika ta hintew odayis; sa7an hintefe nam7ay banta woossiyabas issi wozanan gididi Xoossaa woossiyaba gidiko salon de7iya ta Aaway hintew oothana. <verse eid="MAT 18:19"/><verse number="20" style="v" sid="MAT 18:20"/>Tana kaalleysatape nam7a woyko heedza gididi shiiqiya bessan taani enta giddon bentana” yaagis.<verse eid="MAT 18:20"/></para>
  <para style="s1">Atto Guussaba</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21"/>He wode Phexroosi Yesuusako yidi, “Godaw, ta ishay tana qohiko aapun toho taani atto gaanaw bessii? Laapun toho gakanaaseyee?” gidi oychis.<note caller="-" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="LUK 17:3-4">Luqa 17:3-4</ref>.</char></note><verse eid="MAT 18:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22"/>Yesuusi zaaridi, “Gidenna, laapun tammu toho laapunape attishin, laapun toho gidenna.<note caller="-" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="GEN 4:24">Medhe 4:24</ref>.</char></note><verse eid="MAT 18:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 18:23"/>“Hessa gisho, Xoossaa kawotethay ba oosanchotara ba miishey pacidaakonne palahidaako be7anaw qopida kawa daanees. <verse eid="MAT 18:23"/><verse number="24" style="v" sid="MAT 18:24"/>He kawoy miishey pacidaakonne palahidaako be7iya wode daro gindiginda acoy de7iya issi uraa iyako ehidosona. <verse eid="MAT 18:24"/><verse number="25" style="v" sid="MAT 18:25"/>Shin he aylley acuwa qanxanaw xoonetin iyara, iya machera, iya naytinne iyaw de7iyabay ubbay bayzetidi acoy cigetana mela iya goday kiittis. <verse eid="MAT 18:25"/><verse number="26" style="v" sid="MAT 18:26"/>Yaatin aylley ba godaa tohuwa bolla gulbatidi, ‘Ta godaw, hayyana guutha wode takarki, ta acuwa ubbaa ta ciggana’ yaagidi woossis. <verse eid="MAT 18:26"/><verse number="27" style="v" sid="MAT 18:27"/>Kawoy iyaw qadhetidi, yeddi aggis; iya acuwa maaris.<verse eid="MAT 18:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28"/>“Shin he aylley keyi bidi ba lagge oosanchotape issoy baape daro guutha miishe tal7idaysa, ‘Ne bolla de7iya ta miishiya taw cigga’ gidi qoodhe oykis.<verse eid="MAT 18:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 18:29"/>“He iya lagee aylley iya sinthan gulbatidi, ‘Hayyana guutha wode takarki taani ta acuwa ubbaa ciggana’ yaagidi woossis.<verse eid="MAT 18:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 18:30"/>“Shin ixidi eki efidi ba laggey acuwa qanxana gakanaw qasho keethi gelsis. <verse eid="MAT 18:30"/><verse number="31" style="v" sid="MAT 18:31"/>Hessa gisho, hara lagge oosanchoti hessa be7ida wode daro yilotidi, bidi banta godaas I oothidaba ubbaa odidosona.<verse eid="MAT 18:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 18:32"/>“Yaatin kawoy he aylliya xeegisidi, ‘Ha iita aylliyaw, neeni tana woossida gisho, ta ne acuwa ubbaa new maaras. <verse eid="MAT 18:32"/><verse number="33" style="v" sid="MAT 18:33"/>Yaatin, taani ne acuwa maaridaysada neeni ne lagge aylliya acuwa maaranaw new bessennee?’ yaagis. <verse eid="MAT 18:33"/><verse number="34" style="v" sid="MAT 18:34"/>Hessa gisho, kawoy daro yilotidi, I ba acuwa ubbaa ciggana gakanaw paxa kaa7etana mela qasho keethan yeggis.<verse eid="MAT 18:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35"/>“Hessadaka, hinte issoy issoy hinte ishaa wozanape maaronna ixiko salon de7iya ta Aaway hintena hessada oothana” yaagis.<verse eid="MAT 18:35"/></para>
  <chapter eid="MAT 18"/>
  <chapter number="19" style="c" sid="MAT 19"/>
  <para style="s1">Eko Geloba</para>
  <para style="r">(<ref loc="MRK 10:1-12">Mar 10:1-12</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1"/>Yesuusi hessa odi ongidaape guye, Galilape dendidi Yordaanose Shaafape hefinthan de7iya Yihuda biitta bis. <verse eid="MAT 19:1"/><verse number="2" style="v" sid="MAT 19:2"/>Daro asay iya kaallidi bin enta giddofe harganchota pathis.<verse eid="MAT 19:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3"/>Farsaaweti iya paacanaw koyidi iyako yidi, “Issi asi ay gaasonka ba machiw yeddanaw bessii?” yaagidi oychidosona.<verse eid="MAT 19:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4"/>Yesuusi zaaridi, “Xoossay koyro addenne maccas oothi medhidaysa hinte nabbabibeketii?<note caller="-" style="x"><char style="xo" closed="false">19:4 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Medhe 1:27</ref>; <ref loc="GEN 5:1">5:1</ref>.</char></note> <verse eid="MAT 19:4"/><verse number="5" style="v" sid="MAT 19:5"/>‘Hessa gisho, Issi asi ba aawanne ba aayiw aggidi ba machera issino gidees, nam7ayka issi asho gidoosona.’<note caller="-" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Medhe 2:24</ref>.</char></note> <verse eid="MAT 19:5"/><verse number="6" style="v" sid="MAT 19:6"/>Hessa gisho, enti issi asi gidoosonape attishin, nam7u asi gidokona. Hiza, Xoossi qachidaysa asi shaakofo” yaagis.<verse eid="MAT 19:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7"/>Farsaaweti, “Yaatin, Musey issi asi anjo worqate immidi yeddana mela ayis kiittidee?” yaagidi oychidosona.<note caller="-" style="x"><char style="xo" closed="false">19:7 </char><char style="xt" closed="false"><ref loc="GEN 24:1">Medhe 24:1</ref>.</char></note><verse eid="MAT 19:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8"/>Yesuusi zaaridi, “Hinte, hinte macheta yeddana mela Musey hintena kiittiday, hinte wozanaa minotethaa gishope attishin, koyrope hessa mela gidenna. <verse eid="MAT 19:8"/><verse number="9" style="v" sid="MAT 19:9"/>Ta hintew odayis; ba machiya laymatonna de7ishin yeddidi hara ekiya oonika laammees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Maato 5:32</ref>; <ref loc="2CO 7:10">2 Qoro 7:10</ref>.</char></note><verse eid="MAT 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10"/>Iya tamaareti iyako, “Azinabaynne machibay hessa mela gidiko eko geloy attiko lo77o” yaagidosona.<verse eid="MAT 19:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11"/>Yesuusi zaaridi, “Hessa mela timirtey Xoossay danda7a immidaysatasafe attishin, asa ubbaasa gidenna. <verse eid="MAT 19:11"/><verse number="12" style="v" sid="MAT 19:12"/>Hiza, yeletishe shuufa gididi yeletidaysati de7oosona, qassi asi qaaratidaysati de7oosona, qassi salo kawotethaa gisho gidi bantana shuufaydaysati de7oosona. Hessa gisho, haysa ekanaw danda7iya oonika eko” yaagis.<verse eid="MAT 19:12"/></para>
  <para style="s1">Yesuusi Yooga Nayta Anjis</para>
  <para style="r">(<ref loc="MRK 10:13-16">Mar 10:13-16</ref>; <ref loc="LUK 18:15-17">Luqa 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13"/>Yesuusi ba kushiya guutha nayta bolla wothidi entaw woossana mela issi issi asay nayta iyako ehidosona. Shin iya tamaareti asaa hanqetidosona. <verse eid="MAT 19:13"/><verse number="14" style="v" sid="MAT 19:14"/>Shin Yesuusi, “Xoossaa kawotethay haysata melasa gidiya gisho, guutha nayti taako yeysa diggofite; yo giite” yaagis.<verse eid="MAT 19:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15"/>Ba kushiya enta bolla wothidaape guye he bessaafe aggidi bis.<verse eid="MAT 19:15"/></para>
  <para style="s1">Dure Na7atetha Ura</para>
  <para style="r">(<ref loc="MRK 10:17-31">Mar 10:17-31</ref>; <ref loc="LUK 18:18-30">Luqa 18:18-30</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16"/>Issi gallas issi uray Yesuusako yidi, “Astamaariyaw, taani merinaa de7o demmanaw ay lo77oba ootho?” yaagis. <verse eid="MAT 19:16"/><verse number="17" style="v" sid="MAT 19:17"/>Yesuusi iyako, “Lo77oba ne tana ayis oychay? Issi Xoossaafe attishin, hari lo77oy baawa. Shin neeni merinaa de7uwa ekanaw koyko kiitata naaga” yaagis.<verse eid="MAT 19:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18"/>Uray zaaridi, “Awusa kiitata” yaagidi oychis.</para>
  <para style="p" vid="MAT 19:18">Yesuusi zaaridi, “Wodhopa, laymatopa, kaysotopa, wordo markatofa,<note caller="-" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="EXO 20:13-16">Kessa 20:13-16</ref>; <ref loc="DEU 5:17-20">Zaare 5:17-20</ref>.</char></note> <verse eid="MAT 19:18"/><verse number="19" style="v" sid="MAT 19:19"/>ne aawanne ne aayiw boncha, ne shooruwa ne huupheda dosa” yaagis.<note caller="-" style="x"><char style="xo" closed="false">19:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Kessa 20:12</ref>; <ref loc="DEU 5:16">Zaare 5:16</ref>; <ref loc="LEV 19:18">Leewe 19:18</ref>.</char></note><verse eid="MAT 19:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20"/>He na7atethay, “Taani haysata ubbaa na7atethafe doomada naagas. Yaatin, hari taw paciyabay aybee?” yaagidi oychis.<verse eid="MAT 19:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21"/>Yesuusi zaaridi, “Neeni polo gidanaw koyko bada new de7iyaba bayzada manqotas imma; neeni salon duretana. Yaata simma yada tana kaalla” yaagis.<verse eid="MAT 19:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22"/>Shin he na7atetha uray daro dure gidiya gisho, hessa si7ida wode azzanishe aggidi bis. <verse eid="MAT 19:22"/><verse number="23" style="v" sid="MAT 19:23"/>Hessafe guye, Yesuusi ba tamaareta, “Taani hintew tuma odayis; durey salo kawotethi gelanaysi daro meto. <verse eid="MAT 19:23"/><verse number="24" style="v" sid="MAT 19:24"/>Dure asi Xoossaa kawotethaa gelanaysafe gimaley narpe luhora aadheysi kawuyees” yaagis. <figure style="fig" alt="Man leading unloaded camel" file="LB00039B.tif" size="span" ref="19:24">Gimale Goochiya Asi</figure><verse eid="MAT 19:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25"/>Yesuusa tamaareti hessa si7idi malaaletidi, “Yaatin, ooni attanaw danda7ii?” yaagidi oychidosona.<verse eid="MAT 19:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26"/>Yesuusi enta caddi xeellidi, “Haysi asas danda7etenna, shin Xoossas ubbay danda7etees” yaagis.<verse eid="MAT 19:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27"/>Phexroosi zaaridi, “Nuuni ubbaba aggidi nena kaallida. Yaatin, nuuni ay demmanee?” yaagis. <verse eid="MAT 19:27"/><verse number="28" style="v" sid="MAT 19:28"/>Yesuusi entako haysada yaagis: “Taani hintew tuma odayis; Asa Na7ay yaana alamiyan ba boncho araatan uttiya wode hinte tammanne nam7ati, tana kaallidaysati, tammanne nam7u araatan uttidi tammanne nam7u Isra7eele zerethata bolla pirdana.<note caller="-" style="x"><char style="xo" closed="false">19:28 </char><char style="xt" closed="false"><ref loc="MAT 25:31">Maato 25:31</ref>; <ref loc="LUK 22:30">Luqa 22:30</ref>.</char></note> <verse eid="MAT 19:28"/><verse number="29" style="v" sid="MAT 19:29"/>Ta sunthaa gisho keethe woyko ishata woyko micheta woyko aawa woyko aayiw woyko nayta woyko gadee aggiday oonika xeetu kushe ekana. Qassi merinaa de7uwaka ekana. <verse eid="MAT 19:29"/><verse number="30" style="v" sid="MAT 19:30"/>Shin daroti ha77i dethan sinthe gididaysati guye gidana, qassi guye gididaysati sinthe gidana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">19:30 </char><char style="xt" closed="false"><ref loc="MAT 20:16">Maato 20:16</ref>; <ref loc="LUK 13:30">Luqa 13:30</ref>.</char></note><verse eid="MAT 19:30"/></para>
  <chapter eid="MAT 19"/>
  <chapter number="20" style="c" sid="MAT 20"/>
  <para style="s1">Une Oothiya Asaa Leemiso</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1"/>“Xoossaa kawotethay ba woyne gaden une oothiya asi oosisanaw wonta guura keyida ura daanees. <verse eid="MAT 20:1"/><verse number="2" style="v" sid="MAT 20:2"/>I he une oothiya asa hachi hachi issi dinaare<note caller="+" style="f"><char style="fr" closed="false">20:2 </char><char style="fqa" closed="false">Issi dinaare: </char><char style="ft" closed="false">Issi asi issi gallas oothi pee7idi ekiya miishe.</char></note> qanxanaw entara giigidi, enta ba woyne gadiya giddo yeddis.<verse eid="MAT 20:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 20:3"/>“Qassi wontafe heedzu saate gidishin keyidi ooso dhayidi giya bolla eqida hara asata demmis. <verse eid="MAT 20:3"/><verse number="4" style="v" sid="MAT 20:4"/>I entako, ‘Hinteka ta woyne gadee giddo bidi oothite, taani hintew bessiya gatiya qanxana’ yaagis. <verse eid="MAT 20:4"/><verse number="5" style="v" sid="MAT 20:5"/>Entika bidosona. Qassika I usupun saateninne uddufun saaten keyidi hessada oothis. <verse eid="MAT 20:5"/><verse number="6" style="v" sid="MAT 20:6"/>Tammanne issi saate gidishin I keyiya wode harati yan eqidaysata demmidi, ‘Hinte ooso oothonna gallas kumethi haysan ayis eqidi pee7idetii?’ yaagis.<verse eid="MAT 20:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 20:7"/>“Enti zaaridi, ‘Nuna une oosisiya asi dhayida gishosa’ yaagidosona.</para>
  <para style="p" vid="MAT 20:7">“Ika, ‘Hinteka ta woyne gadiya giddo bidi oothite’ yaagis.<verse eid="MAT 20:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8"/>“Sa7i omarsin, woyne gadiya goday oosanchota halaqaako, ‘Oosanchota xeegada wursethan ooso gelidaysatape doomada koyro gelidaysata gakanaw enta gatiya qanxa’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="LEV 19:13">Leewe 19:13</ref>; <ref loc="DEU 24:15">Zaare 24:15</ref>.</char></note> <verse eid="MAT 20:8"/><verse number="9" style="v" sid="MAT 20:9"/>Tammanne issi saaten ooso oykidaysati yidi, huuphen huuphen issi issi dinaare ekidosona. <verse eid="MAT 20:9"/><verse number="10" style="v" sid="MAT 20:10"/>Koyro ooso oykidaysati yidi, bantaw daro imetana gidi qopidosona. Shin entika huuphen huuphen issi issi dinaare ekidosona. <verse eid="MAT 20:10"/><verse number="11" style="v" sid="MAT 20:11"/>Banta miishiya eki simmidi godaa bolla zuuzumidosona. <verse eid="MAT 20:11"/><verse number="12" style="v" sid="MAT 20:12"/>‘Haysati guyepe yidi issi saate xalaala oothidosona. Shin gallas kumethi awa suulan daaburidi pee7ida nuura enti waanidi issino gidoona’ yaagidosona.<verse eid="MAT 20:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13"/>“Woyniya goday oosanchotape issuwako, ‘Ta ishaw, taani nena qohabike; ne taara giigiday issi dinaaresa gidennee? <verse eid="MAT 20:13"/><verse number="14" style="v" sid="MAT 20:14"/>Ne miishiya ekada ne soo ba. Ta omarsi yidaysaska neysa mela immanaw koyayis. <verse eid="MAT 20:14"/><verse number="15" style="v" sid="MAT 20:15"/>Taani ta miishiyan koydaba oothanaw taw maati baawee? Woyko taani keeha gidida gisho neeni qanaatay?’ yaagis.<verse eid="MAT 20:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 20:16"/>“Hessada ha77i dethan guye gididaysati sinthatana, sinthatidaysati qassi guyetana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">20:16 </char><char style="xt" closed="false"><ref loc="MAT 19:30">Maato 19:30</ref>; <ref loc="MRK 10:31">Mar 10:31</ref>; <ref loc="LUK 13:30">Luqa 13:30</ref>.</char></note><verse eid="MAT 20:16"/></para>
  <para style="s1">Yesuusi Ba Hayquwaba Heedzantho Odis</para>
  <para style="r">(<ref loc="MRK 10:32-34">Mar 10:32-34</ref>; <ref loc="LUK 18:31-34">Luqa 18:31-34</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17"/>Yesuusi Yerusalaame bishe, tammanne nam7u tamaareta dumma gaxa kessidi entako yaagis: <verse eid="MAT 20:17"/><verse number="18" style="v" sid="MAT 20:18"/>“Heko, nuuni ha77i Yerusalaame buussaa bolla de7oos. Yan Asa Na7ay kahine halaqatasinne higge astamaaretas aadhidi imetana. Enti iya bolla hayqo pirda pirdana. <verse eid="MAT 20:18"/><verse number="19" style="v" sid="MAT 20:19"/>Iya Ayhude gidonna deriyas aathidi immana. Enti iya kawushana, garaafana, yaatidi iya masqaliya bolla kaqana. Shin I heedzantho gallas hayqope dendana” yaagis.<verse eid="MAT 20:19"/></para>
  <para style="s1">Zabdiyoosa Nayta Aaye Woosa</para>
  <para style="r">(<ref loc="MRK 10:35-45">Mar 10:35-45</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20"/>He wode Zabdiyoosa machiya ba nam7u adde naytara Yesuusako yada, iya sinthan gulbatada issiba iya woossasu.<verse eid="MAT 20:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21"/>Yesuusi iiko, “Ne ay koyay?” yaagis.</para>
  <para style="p" vid="MAT 20:21">Iya zaarada, “Ne kawotethan ha ta nam7u nayti issoy ne ushachan issoy ne haddirsan utto garki!” yaagasu.<verse eid="MAT 20:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22"/>Shin Yesuusi naytako zaaridi, “Hinte ay woossiyako ereketa; taani uyanaw de7iya waaye xuu7aa uyanaw danda7eetii?” yaagis.</para>
  <para style="p" vid="MAT 20:22">Entika, “Ee danda7oos” yaagidosona.<verse eid="MAT 20:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23"/>Yesuusi, “Tumaka taani uyanaw de7iya xuu7ape hinte uyana. Shin ta ushachaninne haddirsan uttanayisata doorey tana gidike. He bessay imetey, ta aaway immanaw giigisida asatasa” yaagis.<verse eid="MAT 20:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24"/>Attida tammu iya tamaareti hessa si7ida wode nam7u ishata bolla hanqetidosona. <verse eid="MAT 20:24"/><verse number="25" style="v" sid="MAT 20:25"/>Shin Yesuusi enta ubbaa xeegidi haysada yaagis. “Ayhude gidonna asaa haareysati banta asaa bolla godateysanne enta kaaletheysati wolqan haareysa hinte ereeta. <verse eid="MAT 20:25"/><verse number="26" style="v" sid="MAT 20:26"/>Shin hinte giddon hessada gidopo. Hintefe gitatanaw koyiya oonika hintew aylle gido.<note caller="-" style="x"><char style="xo" closed="false">20:26 </char><char style="xt" closed="false"><ref loc="MAT 23:11">Maato 23:11</ref>; <ref loc="MRK 9:35">Mar 9:35</ref>; <ref loc="LUK 22:26">Luqa 22:26</ref>.</char></note> <verse eid="MAT 20:26"/><verse number="27" style="v" sid="MAT 20:27"/>Hinte giddon ubbaafe bolla gidanaw koyiya oonika hintew aylle gidanaw bessees. <verse eid="MAT 20:27"/><verse number="28" style="v" sid="MAT 20:28"/>Hessadaka, Asa Na7ay ase haggaazanawunne daro asaa wozanaw ba shempuwa immanaw yisipe attishin, asan haggaazetanaw yibeenna” yaagis.<verse eid="MAT 20:28"/></para>
  <para style="s1">Nam7u Qooqeti Paxidosona</para>
  <para style="r">(<ref loc="MRK 10:46-52">Mar 10:46-52</ref>; <ref loc="LUK 18:35-43">Luqa 18:35-43</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29"/>Hessafe guye, Yesuusi ba tamaaretara Iyaarkofe keyidi bishin, daro asay entana kaallidosona. <verse eid="MAT 20:29"/><verse number="30" style="v" sid="MAT 20:30"/>Oge gaxan uttida nam7u qooqeti Yesuusi yaara aadheysa si7idi, “Godaw, Dawita Na7aw, nuus qadhetarki” yaagidi waassidosona. <verse eid="MAT 20:30"/><verse number="31" style="v" sid="MAT 20:31"/>Daro asay entana, “Hayzite” yaagidi kaccidosona. Shin enti, “Godaw, Dawita na7aw, nuus qadhetarki” gidi guji waassidosona.<verse eid="MAT 20:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32"/>Yesuusi eqidi, enta xeegidi, “Ta hintew ay oothana mela koyeetii?” yaagidi oychis.<verse eid="MAT 20:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33"/>Entika, “Godaw, nu ayfey xeellana mela koyoos” yaagidosona. <verse eid="MAT 20:33"/><verse number="34" style="v" sid="MAT 20:34"/>Yesuusi entaw qadhetidi, enta ayfiya bochis. Ellesidi enta ayfey xeellis; enti iya kaallidi bidosona.<verse eid="MAT 20:34"/></para>
  <chapter eid="MAT 20"/>
  <chapter number="21" style="c" sid="MAT 21"/>
  <para style="s1">Gita Bonchon Yerusalaame Geluwa</para>
  <para style="r">(<ref loc="MRK 11:1-11">Mar 11:1-11</ref>; <ref loc="LUK 19:28-40">Luqa 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoha 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1"/>Yesuusaranne iya tamaaretara Yerusalaame matidi, Shamaho zuma bolla de7iya Beetefaage geetetiya gutaa gakishe, Yesuusi ba tamaaretape nam7ata baape sinthe yaagidi kiittis: <verse eid="MAT 21:1"/><verse number="2" style="v" sid="MAT 21:2"/>“Hintefe sinthan de7iya guta biite. Yan issi harey qashon de7iyaro I maarara hinte demmana. Enta billidi haa eki yiite. <verse eid="MAT 21:2"/><verse number="3" style="v" sid="MAT 21:3"/>Oonika hintena oychiko, ‘Goday entana koyees’ yaagite. I entana iiraka yeddi aggana” yaagis.<verse eid="MAT 21:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4"/>Hessika nabey,<verse eid="MAT 21:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5"/>“Xiyoone katamaas,</para>
  <para style="q2" vid="MAT 21:5">‘Heko, ne kawoy ashke gididi, hare bollanne</para>
  <para style="q2" vid="MAT 21:5">hare mara bolla uttidi, neeko yees’ yaagite”</para>
  <para style="m" vid="MAT 21:5">yaagidi xaafidaysi poletana mela hessi hanis.<note caller="-" style="x"><char style="xo" closed="false">21:5 </char><char style="xt" closed="false"><ref loc="ZEC 9:9">Zaka 9:9</ref>.</char></note><verse eid="MAT 21:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6"/>Iya tamaareti bidi Yesuusi enta kiitidaysada oothidosona. <verse eid="MAT 21:6"/><verse number="7" style="v" sid="MAT 21:7"/>Hariiwunne hare maraa ehidi bollara ma7ida banta ma7uwa enta zokon yeggidosona. Yesuusi ma7ota bolla uttis. <verse eid="MAT 21:7"/><verse number="8" style="v" sid="MAT 21:8"/>Daro asay banta ma7uwa ogiyan hiixidosona. Harati bonco tashidi oge bolla yeggidosona. <verse eid="MAT 21:8"/><verse number="9" style="v" sid="MAT 21:9"/>Yesuusape sinthara hemeteysatinne iyape guyera kaalliya daro asay,</para>
  <para style="q1" vid="MAT 21:9">“Hosaana!<note caller="+" style="f"><char style="fr" closed="false">21:9 </char><char style="fk" closed="false">Hosaana: </char><char style="ft" closed="false">Ibraawetho doonan hosaana guussay “Nuna ashsha” guussu. Qassi asay Xoossaa galatanaw go7etiya qaala.</char></note> Dawita na7ay galatetto!</para>
  <para style="q2" vid="MAT 21:9">Godaa sunthan yeysi anjetidaysa!</para>
  <para style="q1" vid="MAT 21:9">Bonchoy Ubbaafe Dhoqa Saluwan Xoossaas gido!”</para>
  <para style="m" vid="MAT 21:9">yaagidi waassidosona.<note caller="-" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">Maz 118:25</ref>.</char></note><verse eid="MAT 21:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10"/>Yesuusi Yerusalaame katamaa gelida wode he kataman de7iya asa ubbay, “Haysi oonee?” yaagidi yarkidosona.<verse eid="MAT 21:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11"/>Asay, “Haysi Galilan de7iya Naazirete katamaape yida nabiya Yesuusa” yaagidosona.<verse eid="MAT 21:11"/></para>
  <para style="s1">Xoossa Keethafe Zal7eyisata Kessis</para>
  <para style="r">(<ref loc="MRK 11:15-19">Mar 11:15-19</ref>; <ref loc="LUK 19:45-48">Luqa 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoha 2:13-22</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12"/>Yesuusi Xoossa Keethi gelidi, yan bayzeysatanne shammeyisata ubbaa kare goodis. Miishe laammeyisata xarpheezatanne holleta bayziya oydeta shiri yeggis. <verse eid="MAT 21:12"/><verse number="13" style="v" sid="MAT 21:13"/>Ika entako, “Xoossaa qaalan, ‘Ta keethay Xoossaa woossiya keethi geetetana’ geetetidi xaafetis. Shin hinte pangati qosetiya gongolo oothideta” yaagis.<note caller="-" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa 56:7</ref>; <ref loc="JER 7:11">Ermi 7:11</ref>.</char></note><verse eid="MAT 21:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14"/>Yesuusi xoossa keethan de7ishin qooqetinne gundati iyako yin enta pathis. <verse eid="MAT 21:14"/><verse number="15" style="v" sid="MAT 21:15"/>Shin kahine halaqatinne higge astamaareti Yesuusi oothida malaalsiyabata be7idaysasinne guutha nayti xoossa keethan, “Dawita na7ay, galatetto” yaagidi waasseysa si7idi hanqetidosona. <verse eid="MAT 21:15"/><verse number="16" style="v" sid="MAT 21:16"/>Enti Yesuusako, “Haysati geysa ne si7ay?” yaagidosona.</para>
  <para style="p" vid="MAT 21:16">Yesuusi, “Ee si7ayis, Xoossaa qaalan, ‘Guutha nayta doonaninne dhammiya nayta doonan galata wothadasa’ geetetidi xaafetidaysa hinte nabbabibeketii?” yaagis. <verse eid="MAT 21:16"/><verse number="17" style="v" sid="MAT 21:17"/>Entana yan aggidi Bitaane katamaa bidi aqis.<verse eid="MAT 21:17"/></para>
  <para style="s1">Yesuusi Baaddida Balase Mithiw</para>
  <para style="r">(<ref loc="MRK 11:12-14">Mar 11:12-14</ref>, <ref loc="MRK 11:20-24">20-24</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18"/>Yesuusi wonta guura katama simmidi yishe koshatis. <verse eid="MAT 21:18"/><verse number="19" style="v" sid="MAT 21:19"/>Oge gaxan issi balase mithi be7idi iiko bis. Shin haythafe attishin, hara aykoka demmibeenna. Hessa gisho, iyo, “Hizape nam7antho ayfe ayfopa!” yaagis. He balase mithiya ellesada mela aggasu.<verse eid="MAT 21:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20"/>Iya tamaareti hessa be7idi, “Ha balasiya waanada ellesa meladee?” yaagidi malaaletidosona.<verse eid="MAT 21:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21"/>Yesuusi zaaridi, “Taani hintew tuma odayis; hintew ammanoy de7iko, qassi hinte sidhonna ixiko balase bolla taani oothidaysa mela xalaala ootheketa, shin ‘Ha zumaa shodetada abban wodha’ yaagiko hanana.<note caller="-" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Maato 17:20</ref>; <ref loc="2CO 13:2">2 Qoro 13:2</ref>.</char></note><figure style="fig" alt="Fig tree" file="LB00085B.tif" size="col" ref="21:22">Balasi Mithi</figure> <verse eid="MAT 21:21"/><verse number="22" style="v" sid="MAT 21:22"/>Ammanidi hinte woossiyaba aybiba gidikoka hinte ekana” yaagis.<verse eid="MAT 21:22"/></para>
  <para style="s1">Yesuusa Maatay Oyshetetha</para>
  <para style="r">(<ref loc="MRK 11:27-33">Mar 11:27-33</ref>; <ref loc="LUK 20:1-8">Luqa 20:1-8</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23"/>Yesuusi Xoossa Keetha gelidi tamaarsishin, kahine halaqatinne Ayhude cimati iyako yidi, “Neeni haysa oothana mela new ay maati de7ii? New ha maata immiday oonee?” yaagidi oychidosona.<verse eid="MAT 21:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24"/>Yesuusi entako, “Taanika hintena issiba oychayis; hinte taw hessa zaariko, taani ay maatan oothiyako hintew odana. <verse eid="MAT 21:24"/><verse number="25" style="v" sid="MAT 21:25"/>Yohaanisi xammaqana mela maatay awupe imetidee? Xoossafeye asapee?” yaagis.</para>
  <para style="p" vid="MAT 21:25">Enti banta giddon zoretidi, “Nuuni, ‘Xoossafe’ giiko, I nuna, ‘Yaatin ayis ammanibeketii?’ yaagana. <verse eid="MAT 21:25"/><verse number="26" style="v" sid="MAT 21:26"/>Nuuni, ‘Asape’ giiko, asa ubbay Yohaanisa nabe oothi xeelliya gisho, asaa yayyoos” yaagidosona. <verse eid="MAT 21:26"/><verse number="27" style="v" sid="MAT 21:27"/>Hessa gisho, “Nuuni eroko” yaagidi zaaridosona.</para>
  <para style="p" vid="MAT 21:27">Ika, “Hiza, taanika haysa ay maatan oothiyako hintew odike” yaagis.<verse eid="MAT 21:27"/></para>
  <para style="s1">Nam7u Nayta Leemiso</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28"/>“Yesuusi kaallidika haysada yaagis: nam7u adde nayti de7iya issi uray de7ees. He uray bayra na7aako bidi, ‘Ta na7aw, hachi woyne giddo bada ootha’ yaagis. <verse eid="MAT 21:28"/><verse number="29" style="v" sid="MAT 21:29"/>Na7ay zaaridi, ‘Atto biike’ yaagis. Shin guyepe ba wozanan qopi ekidi oothanaw bis. <verse eid="MAT 21:29"/><verse number="30" style="v" sid="MAT 21:30"/>Aaway ba kaalo na7aako bidi, ba bayra na7aako gidaysada kiittis. Ika, ‘Ero, ta aawaw’ yaagis. Shin bibeenna. <verse eid="MAT 21:30"/><verse number="31" style="v" sid="MAT 21:31"/>Ha nam7u naytape ba aawas kiitetidaysi awusee?” yaagis.</para>
  <para style="p" vid="MAT 21:31">Entika, “Bayra” yaagidosona.</para>
  <para style="p" vid="MAT 21:31">Yesuusi entako, “Ta hintew tuma odayis; qaraxa qanxiseysatinne laymateysati hintefe sinthatidi Xoossaa kawotethaa gelana. <verse eid="MAT 21:31"/><verse number="32" style="v" sid="MAT 21:32"/>Xammaqiya Yohaanisi suure ogiya tamaarsishe yin I geysa ammanibeketa. Shin qaraxa qanxiseysatinne laymateysati ammanidosona. Hinte hari attoshin, enta be7idika hinte nagaraape simmidi ammanibeketa” yaagis.<note caller="-" style="x"><char style="xo" closed="false">21:32 </char><char style="xt" closed="false"><ref loc="LUK 3:12">Luqa 3:12</ref>; <ref loc="LUK 7:29-30">7:29-30</ref>.</char></note><verse eid="MAT 21:32"/></para>
  <para style="s1">Goshshanchota Leemiso</para>
  <para style="r">(<ref loc="MRK 12:1-12">Mar 12:1-12</ref>; <ref loc="LUK 20:9-19">Luqa 20:9-19</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33"/>Qassika Yesuusi haysada yaagis; “Hara leemiso si7ite, woyne tokida issi uray de7ees. He woyniya yuushuwa diris. Woyne gum7iya olla bookis. Woyniya naaganaw shako shaakis. Hessafe guye, gadiya kothe immidi hara biitta bis.<note caller="-" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 5:1-2">Isa 5:1-2</ref>.</char></note> <verse eid="MAT 21:33"/><verse number="34" style="v" sid="MAT 21:34"/>Woyne ayfiya maxiya wodey gakin bana gakiya baggaa ekidi yaana mela ba aylleta entako yeddis. <verse eid="MAT 21:34"/><verse number="35" style="v" sid="MAT 21:35"/>Kothe aawati iya aylleta oykidi issuwa wadhidosona, hankuwa wodhidosona qassi attidaysa shuchan caddidosona. <verse eid="MAT 21:35"/><verse number="36" style="v" sid="MAT 21:36"/>Woyne atakiltiya goday kaseysatape dariya hara aylleta kiittis. Kothe aawati enta bollaka hankoyisata bolla oothidaysada oothidosona. <verse eid="MAT 21:36"/><verse number="37" style="v" sid="MAT 21:37"/>Wursethan I, ‘Ta na7aa enti bonchana!’ yaagidi ba na7aa entako kiittis.<verse eid="MAT 21:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 21:38"/>“Shin kothe aawati na7aa be7idi banta giddon ‘Gadiya laattanaysi haysa, iya wodhidi gadiya nuuni laattoos!’ yaagidosona. <verse eid="MAT 21:38"/><verse number="39" style="v" sid="MAT 21:39"/>Na7a oykidi woyne gadiya giddofe gaxa kessidi wodhidosona.<verse eid="MAT 21:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40"/>“Hiza, woyne gadiya goday yaa wode he kothe aawata waatanee?” yaagidi oychis.<verse eid="MAT 21:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41"/>Enti zaaridi, “I he iita asata iita wodho wodhidi, woyney ayfiya wode iya gakiya baggaa woden woden immiya hara kothe aawatas immana” yaagidosona.<verse eid="MAT 21:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42"/>Yesuusi zaaridi entako, Xoossaa qaalan,</para>
  <para style="q1" vid="MAT 21:42">“ ‘Gimbeysati boridi ixida shuchay,</para>
  <para style="q2" vid="MAT 21:42">godaa xaphuwa minthiya, ubbaafe aadhiya shuchaa gidis.</para>
  <para style="q1" vid="MAT 21:42">Haysi Goday oothidaba;</para>
  <para style="q2" vid="MAT 21:42">nu ayfiyas malaalsiyaba’</para>
  <para style="m" vid="MAT 21:42">geetetidi xaafetidaysa nabbabibeketii?<note caller="-" style="x"><char style="xo" closed="false">21:42 </char><char style="xt" closed="false"><ref loc="PSA 118:22">Maz 118:22</ref>.</char></note><verse eid="MAT 21:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43"/>“Hessa gisho, taani hintew odayis; Xoossaa kawotethay hintefe eketidi lo77o ayfe ayfiya asatas imetana. <verse eid="MAT 21:43"/><verse number="44" style="v" sid="MAT 21:44"/>[Ha shucha bolla kundiya oonika meqeretana. Qassi ha shuchay iya bolla wodhiya urayka gaacetana”]<note caller="+" style="f"><char style="fr" closed="false">21:44: </char><char style="ft" closed="false">Issi issi beni maxaafati paydo 44 gujoosona. (</char><char style="xt"><ref loc="LUK 20:18">Luqa 20:18</ref></char> xeellite) </note> yaagis.<verse eid="MAT 21:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45"/>Kahine halaqatinne Farsaaweti Yesuusi odida leemisuwan bantana odidaysa eridosona. <verse eid="MAT 21:45"/><verse number="46" style="v" sid="MAT 21:46"/>Enti Yesuusa oykanaw koydosona, shin asay Yesuusa nabe oothidi xeelliya gisho, asaas yayyidosona.<verse eid="MAT 21:46"/></para>
  <chapter eid="MAT 21"/>
  <chapter number="22" style="c" sid="MAT 22"/>
  <para style="s1">Yaagano Xeessa Leemiso</para>
  <para style="r">(<ref loc="LUK 14:15-24">Luqa 14:15-24</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1"/>Yesuusi asaas zaaridi haysada yaagidi leemiso odis. <verse eid="MAT 22:1"/><verse number="2" style="v" sid="MAT 22:2"/>“Xoossaa kawotethay ba na7aas yaagano giigisida kawa daanees. <verse eid="MAT 22:2"/><verse number="3" style="v" sid="MAT 22:3"/>He kawoy yaagano yaana mela odi wothida asata xeeganaw ba aylleta kiittis. Shin asati yaanaw koybookona. <verse eid="MAT 22:3"/><verse number="4" style="v" sid="MAT 22:4"/>Qassi hara aylleta xeegidi, xeegetida asatako bidi, ‘Taani ta sangatanne modhida gatarmenthota shukas; ubbabay giigis. Ta yaaganuwa haa yiite yaagite’ yaagidi kiittis. <verse eid="MAT 22:4"/><verse number="5" style="v" sid="MAT 22:5"/>Shin xeegetidaysati xeessaa ixidi, banta oosos oosos bidosona. Issoy ba goshshas, hankoy ba zal7iyas bis. <verse eid="MAT 22:5"/><verse number="6" style="v" sid="MAT 22:6"/>Harati qassi kawa aylleta oykidi, kawushi wadhidi wodhidosona.<verse eid="MAT 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 22:7"/>“Kawoy daro yilotidi, ba wotaadareta yeddidi shempo wodhidaysata wodhisis, enta katamaka xuuggis. <verse eid="MAT 22:7"/><verse number="8" style="v" sid="MAT 22:8"/>Hessafe guye, ba aylletako, ‘Yaaganoy giigis, shin xeegetidaysati yaaganuwas bessiya asi gidokona. <verse eid="MAT 22:8"/><verse number="9" style="v" sid="MAT 22:9"/>Hessa gisho, wogga ogeta bidi, demmida asi ubbaa yaaganuwa yaana mela xeegite’ yaagis. <verse eid="MAT 22:9"/><verse number="10" style="v" sid="MAT 22:10"/>Aylleti ogiya bolla bidi banta demmida asi ubbaa lo77otanne iitata ehidi yaagano shaqara gelsidi kunthidosona.<verse eid="MAT 22:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11"/>“Shin kawoy kathaa maanaw uttida asaa be7anaw gelida wode yaagano ma7o ma7iboona issi asi demmis. <verse eid="MAT 22:11"/><verse number="12" style="v" sid="MAT 22:12"/>Iyako, ‘La, ne yaagano ma7o ma7onna waanada haysa geladii?’ yaagis. Shin uray si77i gis.<verse eid="MAT 22:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 22:13"/>“Kawoy ba aylletako, ‘Ha uraa kushiyanne tohuwa qachidi, kare dhumaa kessi yeggite. Yan iyaw yeehonne acha garcethi gidana’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Maato 8:12</ref>; <ref loc="MAT 25:30">25:30</ref>; <ref loc="LUK 13:28">Luqa 13:28</ref>.</char></note><verse eid="MAT 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14"/>“Hessadaka, Xoossaa kawotethaas xeegetidaysati daro shin dooretidaysati guutha” yaagis.<verse eid="MAT 22:14"/></para>
  <para style="s1">Giiraba</para>
  <para style="r">(<ref loc="MRK 12:13-17">Mar 12:13-17</ref>; <ref loc="LUK 20:20-26">Luqa 20:20-26</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15"/>Hessafe guye, Farsaaweti bidi, Yesuusa waati odan oykaneeko zoretidosona. <verse eid="MAT 22:15"/><verse number="16" style="v" sid="MAT 22:16"/>Banta tamaaretanne Herodiisa baggatape issota issota kiittidosona. Entika, “Astamaariyaw, ne tuma odeysa nu eroos. Neeni asape ase shaakaka, asa woygandes gada aykoka oothaka, Xoossa oge tumatethan tamaarsaasa. <verse eid="MAT 22:16"/><verse number="17" style="v" sid="MAT 22:17"/>Ane nuus oda, nuuni Roome Kawas giira giiranaw bessi bessennee?” yaagidosona.<verse eid="MAT 22:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18"/>Shin Yesuusi enta iita qofaa eridi, “Ha cubboto, tana ayis paacetii? <verse eid="MAT 22:18"/><verse number="19" style="v" sid="MAT 22:19"/>Giira giiriya miishiya tana bessite” yaagis. Entika iyaw santime ehidosona. <verse eid="MAT 22:19"/><verse number="20" style="v" sid="MAT 22:20"/>I, “Ha sunthaynne misiley oodebayee?” yaagis.<verse eid="MAT 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21"/>Enti, “Roome Kawoysa” yaagidosona.</para>
  <para style="p" vid="MAT 22:21">Yaatin Yesuusi entako, “Hiza, Kawas besseysa kawas, Xoossas besseysa Xoossas immite” yaagis.<verse eid="MAT 22:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22"/>Enti hessa si7ida wode malaaletidi iya matape aggidi bidosona.<verse eid="MAT 22:22"/></para>
  <para style="s1">Hayqope Dendoba</para>
  <para style="r">(<ref loc="MRK 12:18-27">Mar 12:18-27</ref>; <ref loc="LUK 20:27-40">Luqa 20:27-40</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23"/>He gallas hayqope dendoy baawa giya Saduqaaweti Yesuusako yidi, yaagidi iya oychidosona.<note caller="-" style="x"><char style="xo" closed="false">22:23 </char><char style="xt" closed="false"><ref loc="ACT 23:8">Hawa 23:8</ref>.</char></note> <verse eid="MAT 22:23"/><verse number="24" style="v" sid="MAT 22:24"/>“Astamaariyaw, ‘Musey, issi asi na7a yelonna hayqiko, he hayqidaysa ishay iya machiw ekidi, ba ishaas na7a yelo’ yaagidi kiittis.<note caller="-" style="x"><char style="xo" closed="false">22:24 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Zaare 25:5</ref>.</char></note> <verse eid="MAT 22:24"/><verse number="25" style="v" sid="MAT 22:25"/>Nu eriya laapun ishati de7oosona. Bayray macho ekidi na7a yelonna hayqis. Iya machiw iya kaalo ishay ekis. <verse eid="MAT 22:25"/><verse number="26" style="v" sid="MAT 22:26"/>Hessadaka, he maccasiw ekida nam7anthoyka, heedzanthoyka, bidi laapunati wurana gakanaw ubbay hayqidosona. <verse eid="MAT 22:26"/><verse number="27" style="v" sid="MAT 22:27"/>Ubbaafe guye he maccasiya hayqasu. <verse eid="MAT 22:27"/><verse number="28" style="v" sid="MAT 22:28"/>Yaatin, laapunati ubbay iyo ekida gisho, hayqope dendiya gallas, he maccasiya laapunatape awusas macho gidanee?” yaagidosona.<verse eid="MAT 22:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29"/>Yesuusi zaaridi, “Hinte Xoossaa qaalay tamaarsiyaba woyko iya wolqaa eronna gisho baleeta. <verse eid="MAT 22:29"/><verse number="30" style="v" sid="MAT 22:30"/>Asay hayqope dendiya wode salon de7iya kiitanchota mela gidanaape attishin, ekokona gelokona. <verse eid="MAT 22:30"/><verse number="31" style="v" sid="MAT 22:31"/>Qassi hayqida asati hayqope dendanaba Xoossay hintew odidaysa nabbabibeketii? <verse eid="MAT 22:31"/><verse number="32" style="v" sid="MAT 22:32"/>Xoossay, ‘Taani Abrahaame Xoossaa, Yisaaqa Xoossaa, Yayqooba Xoossaa’ yaagis. Hessa gisho, Xoossay paxa de7eyisata Xoossaafe attishin, hayqidaysata Xoossaa gidenna”<note caller="+" style="f"><char style="fr" closed="false">22:32 </char><char style="fqa" closed="false">Xoossay paxa de7eyisata Xoossaafe attishin, hayqidaysata Xoossaa gidenna: </char><char style="ft" closed="false">Yesuusi ha bessan odey Xoossay ha hayqida heedzatas Xoosse gidiko enti de7on de7oosona yaageysa.</char></note> yaagis.<note caller="-" style="x"><char style="xo" closed="false">22:32 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Kessa 3:6</ref>.</char></note><verse eid="MAT 22:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33"/>Daro asay hessa si7idi, iya timirtiyan malaaletidosona.<verse eid="MAT 22:33"/></para>
  <para style="s1">Ubbaafe Bayra Kiita</para>
  <para style="r">(<ref loc="MRK 12:28-34">Mar 12:28-34</ref>; <ref loc="LUK 10:25-28">Luqa 10:25-28</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34"/>Yesuusi Saduqaawetas gaanaba dhaysidaysa Farsaaweti si7ida wode issife shiiqidosona. <verse eid="MAT 22:34"/><verse number="35" style="v" sid="MAT 22:35"/>Enta giddofe issi higge astamaarey Yesuusa paace oysho oychis. <verse eid="MAT 22:35"/><verse number="36" style="v" sid="MAT 22:36"/>“Astamaariyaw, higge ubbaafe aadheysi awusee?” yaagidi oychis.<verse eid="MAT 22:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37"/>Yesuusi zaaridi, “ ‘Ne Godaa, ne Xoossaa, ne kumetha wozanape, ne kumetha shempuwafe, ne kumetha qofaape dosa.<note caller="-" style="x"><char style="xo" closed="false">22:37 </char><char style="xt" closed="false"><ref loc="DEU 6:5">Zaare 6:5</ref>.</char></note> <verse eid="MAT 22:37"/><verse number="38" style="v" sid="MAT 22:38"/>Ubbaafe aadheysinne bayra kiitay haysa. <verse eid="MAT 22:38"/><verse number="39" style="v" sid="MAT 22:39"/>Nam7antho ubbaafe aadhiya kiitay, ase ubbaa ne huuphiya ne doseysada dosa’ yaageysa.<note caller="-" style="x"><char style="xo" closed="false">22:39 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Leewe 19:18</ref>.</char></note> <verse eid="MAT 22:39"/><verse number="40" style="v" sid="MAT 22:40"/>Muse higgeynne nabeta timirtey ubbay ha kiitata bolla katoosona” yaagis.<note caller="-" style="x"><char style="xo" closed="false">22:40 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luqa 10:25-28</ref>.</char></note><verse eid="MAT 22:40"/></para>
  <para style="s1">Kiristoosi Oodde Na7ee?</para>
  <para style="r">(<ref loc="MRK 12:35-37">Mar 12:35-37</ref>; <ref loc="LUK 20:41-44">Luqa 20:41-44</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41"/>Farsaaweti issi bolla shiiqidi de7ishin, Yesuusi entana, <verse eid="MAT 22:41"/><verse number="42" style="v" sid="MAT 22:42"/>“Kiristoosaba hinte woygetii? I oodde na7ee?” yaagidi oychis.</para>
  <para style="p" vid="MAT 22:42">Enti, “I Kawa Dawita na7a” yaagidi zaaridosona.<verse eid="MAT 22:42"/></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 22:43"/>Yesuusi entako, “Yaatin, Dawiti Geeshsha Ayyaanan gididi waatidi Kiristoosa, ‘Godaa’ gidi xeegii? Dawiti gishe,<verse eid="MAT 22:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44"/>“ ‘Godaa Xoossay, ta Godaako,<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="fk" closed="false">Ta Godaako: </char><char style="ft" closed="false">Ha bessan Dawiti ta Godaa gidi xeegey Kiristoosa.</char></note><note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz 110:1</ref>.</char></note></para>
  <para style="q2" vid="MAT 22:44">ne morketa ne tohoy yedhiyaso oothana gakanaw,</para>
  <para style="q2" vid="MAT 22:44">haysan taape ushacha baggan<note caller="+" style="f"><char style="fr" closed="false">22:44 </char><char style="fk" closed="false">Ushacha baggan: </char><char style="ft" closed="false">Maatanne boncho bessi.</char></note> utta’ gis.<note caller="-" style="x"><char style="xo" closed="false">22:44 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz 110:1</ref>.</char></note><verse eid="MAT 22:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="MAT 22:45"/>Hiza, Dawiti Kiristoosa Godaa gidi xeegiko, waanidi Kiristoosi Dawita na7a gidii?”</para>
  <para style="m" vid="MAT 22:45">yaagis.<verse eid="MAT 22:45"/></para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 22:46"/>Yesuusas issi qaala zaaranaw danda7ida asi oonika baawa. Qassi he gallasape doomidi hara oysha oychanaw oonika danda7ibeenna.<verse eid="MAT 22:46"/></para>
  <chapter eid="MAT 22"/>
  <chapter number="23" style="c" sid="MAT 23"/>
  <para style="s1">Higge Astamaaretanne Farsaaweta Ayye!</para>
  <para style="r">(<ref loc="MRK 12:38-39">Mar 12:38-39</ref>; <ref loc="LUK 11:43-46">Luqa 11:43-46</ref>; <ref loc="LUK 20:45-46">20:45-46</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1"/>Hessafe guye, Yesuusi shiiqida asaasinne ba tamaaretas haysada yaagis. <verse eid="MAT 23:1"/><verse number="2" style="v" sid="MAT 23:2"/>“Higge astamaaretinne Farsaaweti Muse higgiya billanaw maatara de7oosona. <verse eid="MAT 23:2"/><verse number="3" style="v" sid="MAT 23:3"/>Hessa gisho, enti hintena kiittiya ubbaa oothitenne naagite. Shin enti ootheysada oothopite. Ayis giiko, enti odeysada oothokona. <verse eid="MAT 23:3"/><verse number="4" style="v" sid="MAT 23:4"/>Enti tookanaw danda7etonna tooho qachidi asaa toossosona. Shin bantaw hari attoshin, he toohuwa asay tookiya wode biradhe xeeran bochanaw koyokona.<verse eid="MAT 23:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 23:5"/>“Shin enti banta ooso ubbaa asi be7onna mela oothosona. Banta som7oninne qesen qachiya maxaafaa xiqisey de7iya kitaafe dalgisoosona, banta ma7uwa macaraa adussosona.<note caller="+" style="f"><char style="fr" closed="false">23:5 </char><char style="fqa" closed="false">Som7oninne qesen qachiya maxaafaa, ma7uwa maccara adussosona: </char><char style="ft" closed="false">Hessa enti oothey taani Xoossas imetas giya malla bessanaasa (Zaare 15:37-41).</char></note><note caller="-" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="MAT 6:1">Maato 6:1</ref>; <ref loc="DEU 6:8">Zaare 6:8</ref>; <ref loc="NUM 15:38">Taybo 15:38</ref>.</char></note> <verse eid="MAT 23:5"/><verse number="6" style="v" sid="MAT 23:6"/>Moketiya bessan boncho bessinne ayhude woosa keethatan daro lo77iya oyde dosoosona. <verse eid="MAT 23:6"/><verse number="7" style="v" sid="MAT 23:7"/>Asay giyan entana bonchon sarothanaysanne ‘Astamaariyaw’ gidi xeeganaysa koyoosona.<verse eid="MAT 23:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 23:8"/>“Shin hinte astamaarey issuwa xalaala gidida gishonne hinte ubbay ishata gidida gisho, ‘Astamaariyaw’ geetetidi xeegetofite. <verse eid="MAT 23:8"/><verse number="9" style="v" sid="MAT 23:9"/>Hintew salon issi aawa xalaali de7iya gisho, ha sa7an oonaka ‘Aawaw’ gidi xeegopite. <verse eid="MAT 23:9"/><verse number="10" style="v" sid="MAT 23:10"/>Hintew issi Goday Kiristoosa xalaali de7iya gisho ‘Godaw’ geetetidi xeegetofite. <verse eid="MAT 23:10"/><verse number="11" style="v" sid="MAT 23:11"/>Hinte giddon bayratey hinte aylle gido.<note caller="-" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="MAT 20:26">Maato 20:26</ref>.</char></note> <verse eid="MAT 23:11"/><verse number="12" style="v" sid="MAT 23:12"/>Bana gitaya oonika kawuyana; bana kawushiya oonika gitatana.<note caller="-" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LUK 14:11">Luqa 14:11</ref>; <ref loc="LUK 18:14">18:14</ref>.</char></note><verse eid="MAT 23:12"/></para>
  <para style="s1">Higge Astamaaretinne Farsaaweti Boretidosona</para>
  <para style="r">(<ref loc="MRK 12:40">Mar 12:40</ref>; <ref loc="LUK 11:39-42">Luqa 11:39-42</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13"/>“Hinteno, cubboto, higge astamaaretonne Farsaaweto, asa sinthan salo kawotethaa gordeysato hintena ayye! Hinte, hinte huuphen geleketa qassi harataka gelseketa.<verse eid="MAT 23:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 23:14"/>“[Hinteno cubboto, higge astamaaretonne, Farsaaweto, am7eta keetha hinte bonqishe, asi be7o gidi woosa adusseta. Hessa gisho, hintena ayye! Ubbaafe aadhiya pirday hintena naagees.]<note caller="+" style="f"><char style="fr" closed="false">23:14: </char><char style="ft" closed="false">Issi issi beni maxaafati paydo 14 gujoosona.</char></note><verse eid="MAT 23:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15"/>“Hinteno, cubboto, higge astamaaretonne Farsaaweto, hinte issi uraa ammanthanaw abbaranne sa7ara yuuyeta. Shin hinte iya ammanthida wode he uraa hintefe aathidi Gaannames giigetidaysa oothiya gisho, hintena ayye!<verse eid="MAT 23:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16"/>“Oonika xoossa keethan caaqiko aykoyka baawa. Shin Xoossaa Keethan de7iya worqan caaqiko, he caaqoy iya gomana giya qooqeto, hintew qooqidi harata kaaletheysato, hintena ayye! <verse eid="MAT 23:16"/><verse number="17" style="v" sid="MAT 23:17"/>Hinteno, eeyato, qooqeto, worqay aadhiyee? Worqiya Xoossas dummaya xoossa keethay aadhii? <verse eid="MAT 23:17"/><verse number="18" style="v" sid="MAT 23:18"/>Qassi ‘Oonika yarsho bessan caaqiko, aykoyka baawa. Shin oonika iya bolla de7iya yarshuwan caaqiko, he caaqoy iya gomana’ yaagidi tamaarseeta. <verse eid="MAT 23:18"/><verse number="19" style="v" sid="MAT 23:19"/>Hinteno, qooqeto, yarshoy aadhiyee? Yarshuwa Xoossas dummaya bessay aadhii? <verse eid="MAT 23:19"/><verse number="20" style="v" sid="MAT 23:20"/>Hessa gisho, yarsho bessan caaqiya uray, he yarsho bessaaninne iya bolla de7iya ubbaban caaqees. <verse eid="MAT 23:20"/><verse number="21" style="v" sid="MAT 23:21"/>Xoossa keethan caaqiya uray, he xoossa keethaninne iyan de7iya Xoossan caaqees. <verse eid="MAT 23:21"/><verse number="22" style="v" sid="MAT 23:22"/>Salon caaqiya uray Xoossaa araataninne he araata bolla uttiya Xoossan caaqees.<note caller="-" style="x"><char style="xo" closed="false">23:22 </char><char style="xt" closed="false"><ref loc="ISA 66:1">Isa 66:1</ref>; <ref loc="MAT 5:34">Maato 5:34</ref>.</char></note><verse eid="MAT 23:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23"/>“Hinteno, cubboto, higge astamaaretonne Farsaaweto, hintena ayye! Hinte kareetha sawope, naatiropenne okashepe asraata kesseeta. Shin higgen de7iya aadhidi koshsheyisata aggideta. Hessika, suure pirda, qadhetethinne ubbaban ammanetethi. Harataka aggonashin haysata hinte oothanaw bessees.<note caller="-" style="x"><char style="xo" closed="false">23:23 </char><char style="xt" closed="false"><ref loc="LEV 27:30">Leewe 27:30</ref>.</char></note> <verse eid="MAT 23:23"/><verse number="24" style="v" sid="MAT 23:24"/>Hintew qooqidi hara asi kaaletheysato, hinte ushshafe udunxe kessidi gimale miteeta.<verse eid="MAT 23:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25"/>“Hinteno, cubboto, higge astamaaretonne Farsaaweto, hintena ayye! Hinte shaatiyasinne keriyas bolla baggaa geeshsheeta. Shin entaw garsan bonqeynne uuzetethi kumi uttis. <verse eid="MAT 23:25"/><verse number="26" style="v" sid="MAT 23:26"/>Neno qooqe Farsaawiyaw, shaatiyasinne keriyas garsa kasetada geeshsha. Hessafe guye, bolla baggayka geeshshi gidana.<verse eid="MAT 23:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27"/>“Hinteno, cubboto, higge astamaaretonne Farsaaweto, hintena ayye! Kare baggara qalame tiyetidi lo77idi, giddon meqethinne wooqidabay kumida duufota daaneta.<note caller="-" style="x"><char style="xo" closed="false">23:27 </char><char style="xt" closed="false"><ref loc="ACT 23:3">Hawa 23:3</ref>.</char></note> <verse eid="MAT 23:27"/><verse number="28" style="v" sid="MAT 23:28"/>Hessadaka, bolla baggara asas lo77o daaneta. Shin hinte garsan cubbotethinne iitatethi kumis.<verse eid="MAT 23:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29"/>“Hinteno, cubboto, higge astamaaretonne Farsaaweto, hintena ayye! Hinte nabetas duufo keexeta, qassi xillota duufuwaka loytheeta. <verse eid="MAT 23:29"/><verse number="30" style="v" sid="MAT 23:30"/>Qassi hinte, ‘Nuuni beni nu aawata wode de7idaba gidiyako, entara issife nabeta suuthaa gussokoshin’ yaageeta. <verse eid="MAT 23:30"/><verse number="31" style="v" sid="MAT 23:31"/>Hessa gisho, hinte nabeta wodhida asaa nayta gideysa hinte hinte huuphen markateeta. <verse eid="MAT 23:31"/><verse number="32" style="v" sid="MAT 23:32"/>Hiza, hinte aawati doomidaysa hinte polite.<verse eid="MAT 23:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 23:33"/>“Ha shooshato, shoosha nayto, hinte Gaanname pirdaafe waanidi attanee?<note caller="-" style="x"><char style="xo" closed="false">23:33 </char><char style="xt" closed="false"><ref loc="MAT 3:7">Maato 3:7</ref>; <ref loc="MAT 12:34">12:34</ref>; <ref loc="LUK 3:7">Luqa 3:7</ref>.</char></note> <verse eid="MAT 23:33"/><verse number="34" style="v" sid="MAT 23:34"/>Hessa gisho, heko, taani nabeta, cinca asatanne astamaareta hinteko kiittana. Entafe issota issota hinte wodhananne masqala bolla kaqana. Baggata ayhude woosa keethatan lisson garaafananne katamaape katama gooddana. <verse eid="MAT 23:34"/><verse number="35" style="v" sid="MAT 23:35"/>Hessa gisho, xilluwa Aabela wodhida wodepe doomidi, Xoossa Keethasinne yarsho bessaafe giddon hinte wodhida Baraka na7a Zakaryaasa wode gakanaw hayqida xillo asa ubba gisho, hinte seeretana.<note caller="-" style="x"><char style="xo" closed="false">23:35 </char><char style="xt" closed="false"><ref loc="GEN 4:8">Medhe 4:8</ref>; <ref loc="2CH 24:20">2 Taari 24:20</ref>.</char></note> <verse eid="MAT 23:35"/><verse number="36" style="v" sid="MAT 23:36"/>Taani hintew tuma odayis; hintenne hinte aawati oothida nagaraas ha pirda ubbay ha yeletethaa bolla gakana.<verse eid="MAT 23:36"/></para>
  <para style="s1">Yesuusi Yerusalaames yeekis</para>
  <para style="r">(<ref loc="LUK 13:34-35">Luqa 13:34-35</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37"/>“Yerusalaame, Yerusalaame, nabeta wodhiyare! Xoossay neeko kiittidaysata shuchan caddiyare! Kuttoy ba nayta ba qefen hapheysada taani ne asaa ta qesiyan gechanaw aapun toho koyadina! Shin tana diggadasa. <verse eid="MAT 23:37"/><verse number="38" style="v" sid="MAT 23:38"/>Hiza, heko, hinte keethay kaysi gidana.<note caller="-" style="x"><char style="xo" closed="false">23:38 </char><char style="xt" closed="false"><ref loc="JER 22:5">Ermi 22:5</ref>.</char></note> <verse eid="MAT 23:38"/><verse number="39" style="v" sid="MAT 23:39"/>Taani hintew odayis; ‘Godaa sunthan yeysi anjetidaysa’ hinte gaana gakanaw nam7antho tana be7eketa” yaagis.<note caller="-" style="x"><char style="xo" closed="false">23:39 </char><char style="xt" closed="false"><ref loc="PSA 118:26">Maz 118:26</ref>.</char></note><verse eid="MAT 23:39"/></para>
  <chapter eid="MAT 23"/>
  <chapter number="24" style="c" sid="MAT 24"/>
  <para style="s1">Xoossa Keethay laaletonna Attenna</para>
  <para style="r">(<ref loc="MRK 13:1-2">Mar 13:1-2</ref>; <ref loc="LUK 21:5-6">Luqa 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1"/>Yesuusi Xoossa Keethafe keyidi bishin, iya tamaareti iyako yidi, malaaletidi Xoossa Keetha gimbiya bessidosona. <verse eid="MAT 24:1"/><verse number="2" style="v" sid="MAT 24:2"/>Yesuusi entako zaaridi, “Ee! Haysa ubbaa be7eetii? Taani hintew tumaa odayis; shuchi shucha bolla gimbetida mela laaletonna attenna” yaagis.<verse eid="MAT 24:2"/></para>
  <para style="s1">Sinthafe Hananabata</para>
  <para style="r">(<ref loc="MRK 13:3-13">Mar 13:3-13</ref>; <ref loc="LUK 21:7-19">Luqa 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3"/>Yesuusi Shamaho zuma bolla uttidashin, iya tamaareti bantarka iyako yidi, “Hessi awude hananeeko nuus oda. Qassi ne yuussasinne wodiya wursethaas malaatay aybee?” yaagidi oychidosona.<verse eid="MAT 24:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4"/>Yesuusi zaaridi, “Hintena oonika balethonna mela naagetite! <verse eid="MAT 24:4"/><verse number="5" style="v" sid="MAT 24:5"/>Ayis giiko, daro asati ta sunthan, ‘Taani Kiristoosa, Xoossay asaa ashshanaw kiittidaysa’ yaagishe yidi daro asaa balethana. <verse eid="MAT 24:5"/><verse number="6" style="v" sid="MAT 24:6"/>Matan de7iya ola girsaa, haahon de7iya ola wore si7anaw de7eeta. Hessa melabay hananaw bessiya gisho Hirgofite. Shin wursethay buroona. <verse eid="MAT 24:6"/><verse number="7" style="v" sid="MAT 24:7"/>Derey deriyara, issi kawotethay hara kawotethaara oletana. Koshaynne biitta qaaxoy ubba bessan hanana. <verse eid="MAT 24:7"/><verse number="8" style="v" sid="MAT 24:8"/>Hessi ubbay yelo iqethas zooke mela.<verse eid="MAT 24:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9"/>“He wode asay hintena waayees aathidi immana, qachananne wodhana. Ta sunthaa gisho asa ubbay hintena ixana.<note caller="-" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Maato 10:22</ref>.</char></note> <verse eid="MAT 24:9"/><verse number="10" style="v" sid="MAT 24:10"/>He wode daroti ammano aggana. Banta giddon issoy issuwa aathidi immana, issoy issuwa ixana. <verse eid="MAT 24:10"/><verse number="11" style="v" sid="MAT 24:11"/>Qassi daro wordo nabeti dendidi darota balethana. <verse eid="MAT 24:11"/><verse number="12" style="v" sid="MAT 24:12"/>Geellatethi dariya gisho, daro asaa siiqoy irxana. <verse eid="MAT 24:12"/><verse number="13" style="v" sid="MAT 24:13"/>Shin wursethi gakanaw genciya uray attana.<note caller="-" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Maato 10:22</ref>.</char></note> <verse eid="MAT 24:13"/><verse number="14" style="v" sid="MAT 24:14"/>Asa ubbaas marka gidana mela Xoossaa kawotethaa Wongelay biitta ubban odetana. Hessafe guye, wursethay yaana.<verse eid="MAT 24:14"/></para>
  <para style="s1">Tuna Dhayo</para>
  <para style="r">(<ref loc="MRK 13:14-23">Mar 13:14-23</ref>; <ref loc="LUK 21:20-24">Luqa 21:20-24</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15"/>“Hessa gisho, nabiya Daaneli odida dhayo tunatethay geeshsha bessan eqidaysa hinte be7ana.<note caller="-" style="x"><char style="xo" closed="false">24:15 </char><char style="xt" closed="false"><ref loc="DEU 9:27">Zaare 9:27</ref>; <ref loc="DEU 11:31">11:31</ref>; <ref loc="DEU 12:11">12:11</ref>.</char></note> (Akeekiso: Hessi woy guusseko nabbabeysi akeeko!) <verse eid="MAT 24:15"/><verse number="16" style="v" sid="MAT 24:16"/>He wode Yihuda biittan de7eysati deriyako baqato. <verse eid="MAT 24:16"/><verse number="17" style="v" sid="MAT 24:17"/>Keetha huuphen de7iya uray ba son de7iyaba ekanaw soo gelonna baqato.<note caller="-" style="x"><char style="xo" closed="false">24:17 </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luqa 17:31</ref>.</char></note> <verse eid="MAT 24:17"/><verse number="18" style="v" sid="MAT 24:18"/>Gaden de7eysi ba ma7uwa ekanaw guye simmofo. <verse eid="MAT 24:18"/><verse number="19" style="v" sid="MAT 24:19"/>He wode qantha maccasatasinne dhanthiya maccasatas daro un7a gidana. <verse eid="MAT 24:19"/><verse number="20" style="v" sid="MAT 24:20"/>Balgon woyko Sambaatan hinte baqatoy gidonna mela Xoossaa woossite. <verse eid="MAT 24:20"/><verse number="21" style="v" sid="MAT 24:21"/>Ayis giiko, sa7i medhetoosape hachi gakanaw hanonnabay, qassi sinthafeka ubbaraka hanonna waayey he wode hanana.<note caller="-" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="GEN 12:1">Medhe 12:1</ref>; <ref loc="REV 7:14">Qon 7:14</ref>.</char></note> <verse eid="MAT 24:21"/><verse number="22" style="v" sid="MAT 24:22"/>Xoossay he gallasata taybuwa guuthonnaako ase gidida oonika attenna. Shin I ba doorida asata gisho, he gallasata taybuwa guuthana.<verse eid="MAT 24:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23"/>“He wode oonika hintena, ‘Heko, Kiristoosi haysan’ woyko ‘Hinin de7ees’ yaagiko ammanopite. <verse eid="MAT 24:23"/><verse number="24" style="v" sid="MAT 24:24"/>Ayis giiko, wordo Kiristoosatinne wordo nabeti dendana. Entaw danda7etiko, hari attoshin Xoossay dooridaysataka balethanaw gita malaatatanne malaalsiyabata oothana. <verse eid="MAT 24:24"/><verse number="25" style="v" sid="MAT 24:25"/>Akeekite, taani hintew haysa kasetada odas.<verse eid="MAT 24:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26"/>“Hessa gisho, asay hinteko, ‘Heko, Kiristoosi bazzon de7ees’ giiko, yaa boopite. Woyko hinteko, ‘Heko, qol7an de7ees’ giiko, entaba ammanopite.<note caller="-" style="x"><char style="xo" closed="false">24:26 </char><char style="xt" closed="false"><ref loc="LUK 17:23-24">Luqa 17:23-24</ref>.</char></note> <verse eid="MAT 24:26"/><verse number="27" style="v" sid="MAT 24:27"/>Ayis giiko, wol7anthi salon wol7amidi, dolohape wuloha gakanaw benteysada, Asa Na7aa yuussay hessada hanana.<verse eid="MAT 24:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28"/>“Bawuti de7iyason ankoti shiiqana.<note caller="-" style="x"><char style="xo" closed="false">24:28 </char><char style="xt" closed="false"><ref loc="LUK 17:37">Luqa 17:37</ref>.</char></note><verse eid="MAT 24:28"/></para>
  <para style="s1">Kiristoosi Nam7antho Yaana</para>
  <para style="r">(<ref loc="MRK 13:24-27">Mar 13:24-27</ref>; <ref loc="LUK 21:25-28">Luqa 21:25-28</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29"/>“He wode he waaye gallasatape guye,</para>
  <para style="q2" vid="MAT 24:29">ellesidi away dhumana,</para>
  <para style="q2" vid="MAT 24:29">ageenay ba poo7uwa diggana.<note caller="-" style="x"><char style="xo" closed="false">24:29 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="JER 2:10">Ermi 2:10</ref>.</char></note></para>
  <para style="q1" vid="MAT 24:29">Xoolintoti salope wodhana,</para>
  <para style="q2" vid="MAT 24:29">qassi salon de7iya wolqati buqettana.<verse eid="MAT 24:29"/></para>
  <para style="m">
    <verse number="30" style="v" sid="MAT 24:30"/>He wode Asa Na7aa yuussaa mallay saluwa bolla bentana. Sa7an de7iya asi ubbay yeekana. Qassi Asa Na7ay, wolqaranne gita bonchuwara saluwa shaara giddora yishin enti be7ana.<note caller="-" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="DEU 7:13">Zaare 7:13</ref>; <ref loc="ZEC 12:10">Zaka 12:10</ref>.</char></note> <verse eid="MAT 24:30"/><verse number="31" style="v" sid="MAT 24:31"/>I ba kiitanchota gita moyze punora kiittana. Enti sa7aa oyddu baggaa bidi, ha gaxape ya gaxa gakanaw de7iya iyaw dooretidaysata shiishana.<verse eid="MAT 24:31"/></para>
  <para style="s1">Balase Mithee Leemiso</para>
  <para style="r">(<ref loc="MRK 13:28-31">Mar 13:28-31</ref>; <ref loc="LUK 21:29-33">Luqa 21:29-33</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32"/>“Balase mithafe tamaarite. Iya aacada hayxiya wode torchey matatidaysa hinte ereeta. <verse eid="MAT 24:32"/><verse number="33" style="v" sid="MAT 24:33"/>Hessadaka, hinte ha ubbaba be7iya wode Yesuusi matidi pengen de7eysa erite. <verse eid="MAT 24:33"/><verse number="34" style="v" sid="MAT 24:34"/>Taani hintew tuma odayis; ha ubbabay poletana gakanaw, ha yeletethay aadhenna. <verse eid="MAT 24:34"/><verse number="35" style="v" sid="MAT 24:35"/>Saloynne sa7i aadhana, shin ta qaalay ubbaka aadhenna.<note caller="-" style="x"><char style="xo" closed="false">24:35 </char><char style="xt" closed="false"><ref loc="GEN 6:5">Medhe 6:5</ref>.</char></note><verse eid="MAT 24:35"/></para>
  <para style="s1">Yesuusi Yaana Wode Oonika Erenna</para>
  <para style="r">(<ref loc="MRK 13:32-37">Mar 13:32-37</ref>; <ref loc="LUK 17:26-30">Luqa 17:26-30</ref>, <ref loc="LUK 17:34-36">34-36</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36"/>“He gallasaanne he saatiya salon de7iya ta aawape attishin, hari salo kiitanchota gidin woyko Na7aa gidin oonika erenna. <verse eid="MAT 24:36"/><verse number="37" style="v" sid="MAT 24:37"/>Asa Na7aa yuussay, Nohe wode hanidaysa mela gidana.<note caller="-" style="x"><char style="xo" closed="false">24:37 </char><char style="xt" closed="false"><ref loc="GEN 6:5">Medhe 6:5</ref>.</char></note> <verse eid="MAT 24:37"/><verse number="38" style="v" sid="MAT 24:38"/>He wode dhayo haathay yaanape sinthe Nohey markabiyan gelida gallasa gakanaw, asay mishenne uyishe, ekishenne gelishe gam7is. <verse eid="MAT 24:38"/><verse number="39" style="v" sid="MAT 24:39"/>Dhayo haathay yidi, enta ubbaa dhaysana gakanaw akeekibokona. Asa Na7aa yuussayka hessada hanana.<verse eid="MAT 24:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 24:40"/>“He wode nam7u asati gaden oothana. Entafe issoy eketana, hankoy attana. <verse eid="MAT 24:40"/><verse number="41" style="v" sid="MAT 24:41"/>Nam7u maccasati issife gaaccana. Entafe issiniya eketana hankiya attana.<verse eid="MAT 24:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 24:42"/>“Hiza, hinte Goday ay gallas yaaneko hinte eronna gisho, minnidi naagite. <verse eid="MAT 24:42"/><verse number="43" style="v" sid="MAT 24:43"/>Shin kaysoy qammafe ay saaten yaaneko goday eriyako, ba keethay booketonna mela barkidi naaganashin.<note caller="-" style="x"><char style="xo" closed="false">24:43 </char><char style="xt" closed="false"><ref loc="LUK 12:39-40">Luqa 12:39-40</ref>.</char></note> <verse eid="MAT 24:43"/><verse number="44" style="v" sid="MAT 24:44"/>Hessadaka, Asa Na7ay hinte qoponna saaten yaana gisho, hinteka giigidi de7ite.<verse eid="MAT 24:44"/></para>
  <para style="s1">Iitanne Lo77o Aylle Leemiso</para>
  <para style="r">(<ref loc="LUK 12:41-48">Luqa 12:41-48</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45"/>“Yaatin, ba soo asaas kathaa koshshiya wodiyan immana mela iya goday doorida ammantheysinne wozanaama aylley oonee? <verse eid="MAT 24:45"/><verse number="46" style="v" sid="MAT 24:46"/>I ba goday kiittidaysa oothishin iya goday yidi demmiya aylley anjetidaysa. <verse eid="MAT 24:46"/><verse number="47" style="v" sid="MAT 24:47"/>Taani hintew tuma odayis; goday he aylliya babaa ubbaa bolla shuumana. <verse eid="MAT 24:47"/><verse number="48" style="v" sid="MAT 24:48"/>Shin he aylley iita gidiko, ‘Ta goday gam7idi yaana’ yaagidi ba wozanan qopidi, <verse eid="MAT 24:48"/><verse number="49" style="v" sid="MAT 24:49"/>ba lagge oosanchota wadho doomiko, mathoteysatara miikonne uyiko, <verse eid="MAT 24:49"/><verse number="50" style="v" sid="MAT 24:50"/>he aylliya goday I qoponna gallasinne I eronna saaten, <verse eid="MAT 24:50"/><verse number="51" style="v" sid="MAT 24:51"/>yidi iya qanxerethana. Iya qaada cubbotara oothana. He bessan iyaw yeehonne ache garcethi gidana.<verse eid="MAT 24:51"/></para>
  <chapter eid="MAT 24"/>
  <chapter number="25" style="c" sid="MAT 25"/>
  <para style="s1">Tammu Geela7ota Leemiso</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1"/>“He wode salo kawotethay banta xompe oykidi, macho ehanaw bida addiya mokanaw keyida tammu geela7ota daanees.<note caller="-" style="x"><char style="xo" closed="false">25:1 </char><char style="xt" closed="false"><ref loc="LUK 12:35">Luqa 12:35</ref>.</char></note> <verse eid="MAT 25:1"/><verse number="2" style="v" sid="MAT 25:2"/>Entafe ichashati eeya, qassi ichashati cinca. <verse eid="MAT 25:2"/><verse number="3" style="v" sid="MAT 25:3"/>Eeyati xompe oykidosona, shin guzha zayte oykibookona. <verse eid="MAT 25:3"/><verse number="4" style="v" sid="MAT 25:4"/>Shin cincati banta xompenne hara guzha zayte oykidosona. <verse eid="MAT 25:4"/><verse number="5" style="v" sid="MAT 25:5"/>Machiw ekeysi gam7in, he geela7oti bantana dhiskoy oykin dhiskidosona.<verse eid="MAT 25:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6"/>“Giddi bilahe gidiya wode, ‘Heko, machiw eheysi gakis, iya mokanaw keyite’ giya gita caboy si7etis.<verse eid="MAT 25:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 25:7"/>“He wode he geela7oti ubbay barkidi, banta xompiya giigisidosona. <verse eid="MAT 25:7"/><verse number="8" style="v" sid="MAT 25:8"/>Eeyati cincatako, ‘Nu xompey to7ana haniya gisho, hinte zaytiyape nuus immerketi’ yaagidosona.<verse eid="MAT 25:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 25:9"/>“Shin cincati zaaridi, ‘Akay, nuusinne hintew gidiya zaytey baawa. Hessa gisho, bidi hintew shammidi ekite’ yaagidosona. <verse eid="MAT 25:9"/><verse number="10" style="v" sid="MAT 25:10"/>Eeya geela7oti zayte shammanaw bin, machiw ekeysi puttu gis. Giigeti uttida ichashu geela7oti iyara issife yaagano keethi gelidosona; kareyka gordeti aggis.<verse eid="MAT 25:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11"/>“Guyepe hanko geela7oti yidi, ‘Godaw, godaw, nuus dooyarki’ yaagidosona.<verse eid="MAT 25:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 25:12"/>“Shin I zaaridi, ‘Taani hintew tuma odayis; ta hintena erike!’<verse eid="MAT 25:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13"/>“Hiza, Asa Na7ay yaana gallasaa woyko saatiya hinte eronna gisho barkidi naagite.<verse eid="MAT 25:13"/></para>
  <para style="s1">Heedzu Oosanchota Leemiso</para>
  <para style="r">(<ref loc="LUK 19:11-27">Luqa 19:11-27</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14"/>“Xoossaa kawotethay ba oosanchota xeegidi baw de7iyaba entaw sheedhidi oge baanaw keyida uraa daanees.<note caller="-" style="x"><char style="xo" closed="false">25:14 </char><char style="xt" closed="false"><ref loc="LUK 19:11-27">Luqa 19:11-27</ref>.</char></note> <verse eid="MAT 25:14"/><verse number="15" style="v" sid="MAT 25:15"/>Entaw huuphen huuphen enta wolqaa mela issuwas ichashu karxiite bira, issuwas nam7u karxiite bira qassi issuwas issi karxiite bira immidi ba ogiya bis. <verse eid="MAT 25:15"/><verse number="16" style="v" sid="MAT 25:16"/>Ichashu karxiite bira ekida aylley ellesi bidi zal7idi, hara ichashu karxiite bira wodhisis. <verse eid="MAT 25:16"/><verse number="17" style="v" sid="MAT 25:17"/>Hessadaka, qassi nam7u karxiite bira ekida aylley hara nam7u karxiite bira wodhisis. <verse eid="MAT 25:17"/><verse number="18" style="v" sid="MAT 25:18"/>Shin issi karxiite bira ekidaysi bidi, olla bookidi, ba godaa miishiya moogis.<verse eid="MAT 25:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19"/>“Daro wodepe guye he aylleta goday yidi, ba miishiya entara salla7is. <verse eid="MAT 25:19"/><verse number="20" style="v" sid="MAT 25:20"/>Ichashu karxiite bira ekida aylley yidi, hara ichashu karxiite bira ehidi, ‘Ta godaw, neeni taw ichashu karxiite bira immadasa. Shin taani hara ichashu karxiite bira wodhisas’ yaagis. <verse eid="MAT 25:20"/><verse number="21" style="v" sid="MAT 25:21"/>Iya goday, ‘Zamboy! Neeni lo77onne ammanthiya aylle; neeni guuthaban ammanetadasa. Taani nena darobaa bolla shuumana; haa gelada ne godaara ufayta’ yaagis.<verse eid="MAT 25:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22"/>“Qassi nam7u karxiite bira ekidaysi yidi, ‘Ta godaw, neeni taw nam7u karxiite bira immadasa. Shin taani hara nam7u karxiite bira wodhisas’ yaagis. <verse eid="MAT 25:22"/><verse number="23" style="v" sid="MAT 25:23"/>Iya goday, ‘Zamboy! Neeni lo77onne ammanthiya aylle; neeni guuthaban ammanetadasa. Taani nena darobaa bolla shuumana; haa gelada ne godaara ufayta’ yaagis.<verse eid="MAT 25:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24"/>“Qassi issi karxiite bira ekidaysi yidi, ‘Ta godaw, neeni zeronna bessafe cakiyanne dharcona bessafe maxiya iita asi gideysa taani erayis. <verse eid="MAT 25:24"/><verse number="25" style="v" sid="MAT 25:25"/>Hessa gisho, yayyada ne bira biittan moogas. Ne miishey haysish’ yaagis.<verse eid="MAT 25:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26"/>“Iya goday zaaridi, ‘Ha iita azalla aylliyaw, taani zeronna bessafe cakeysanne dharcona bessafe maxiya asi gideysa eradasa. <verse eid="MAT 25:26"/><verse number="27" style="v" sid="MAT 25:27"/>Yaatin, neeni ta miishiya banken wothidaba gidiyako, taani simmiya wode ta miishiya wodhera ekanaysa diggadasa. <verse eid="MAT 25:27"/><verse number="28" style="v" sid="MAT 25:28"/>Hessa gisho, miishiya iyape ekidi, tammu karxiite biri de7eysas immite. <verse eid="MAT 25:28"/><verse number="29" style="v" sid="MAT 25:29"/>Ayis giiko, de7iya ubbaas guzhetananne darana. Shin baynaysafe hari attoshin, he iyaw de7iya guuthiyaka eketana.<note caller="-" style="x"><char style="xo" closed="false">25:29 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Maato 13:12</ref>; <ref loc="MRK 4:25">Mar 4:25</ref>; <ref loc="LUK 8:18">Luqa 8:18</ref>.</char></note> <verse eid="MAT 25:29"/><verse number="30" style="v" sid="MAT 25:30"/>Ha maaddonna aylliya kare dhumaa kessi yeggite. Yan iyaw yeehonne ache garcethi gidana’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="MAT 8:12">Maato 8:12</ref>; <ref loc="MAT 22:13">22:13</ref>; <ref loc="LUK 13:28">Luqa 13:28</ref>.</char></note><verse eid="MAT 25:30"/></para>
  <para style="s1">Wode Wursetha Pirda</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31"/>“Asa Na7ay, kiitancho ubbatara, ba bonchuwara yaa wode I ba boncho kawotetha araata bolla uttana.<note caller="-" style="x"><char style="xo" closed="false">25:31 </char><char style="xt" closed="false"><ref loc="MAT 16:27">Maato 16:27</ref>; <ref loc="MAT 19:28">Maato 19:28</ref>.</char></note> <verse eid="MAT 25:31"/><verse number="32" style="v" sid="MAT 25:32"/>Biittan de7iya asi ubbay iya sinthe shiiqana. Henthanchoy dorsata deeshatape shaakeysada I he asaa nam7an shaakana. <verse eid="MAT 25:32"/><verse number="33" style="v" sid="MAT 25:33"/>Qassi dorsata ushacha baggara deeshata haddirsa baggara essana.<verse eid="MAT 25:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 25:34"/>“Hessafe guye, kawoy ushacha baggara de7eysatako haysada yaagana: ‘Ta Aaway anjidaysato, ha yidi sa7i medhetiya wodepe doomidi hintew giigida kawotetha laattite. <verse eid="MAT 25:34"/><verse number="35" style="v" sid="MAT 25:35"/>Ayis giiko, taani koshatin muzideta, saamotin ushshideta, eretonna imatha asi gidada bin mokideta, <verse eid="MAT 25:35"/><verse number="36" style="v" sid="MAT 25:36"/>kallotin mayzideta, hargetin hargisideta, qashetin tana oychideta’ yaagana.<verse eid="MAT 25:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37"/>“Hessafe guye, xilloti zaaridi, ‘Godaw, neeni koshatin awude be7idi muzido? Woyko neeni saamotin awude be7idi ushshido? <verse eid="MAT 25:37"/><verse number="38" style="v" sid="MAT 25:38"/>Neeni imathe gidada yin awude be7idi mokido? Woyko neeni kallotin awude mayzido? <verse eid="MAT 25:38"/><verse number="39" style="v" sid="MAT 25:39"/>Neeni hargin woyko qashetin neeko bidi nena awude oychido?’ yaagana. <verse eid="MAT 25:39"/><verse number="40" style="v" sid="MAT 25:40"/>Kawoy zaaridi, ‘Taani hintew tuma odayis; hinte tana kaalliya ha ubbaafe guuxeysas oothidaysa taw oothideta’ yaagana.<verse eid="MAT 25:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41"/>“He wode haddirsa baggara de7eysatako, ‘Ha baadetidaysato, ta matape haakite. Xalahesinne iya kiitanchotas giigida merinaa taman biite. <verse eid="MAT 25:41"/><verse number="42" style="v" sid="MAT 25:42"/>Ayis giiko, koshatin tana muzibeeketa; saamotin ushshibeeketa. <verse eid="MAT 25:42"/><verse number="43" style="v" sid="MAT 25:43"/>Taani imathe gidada bin tana mokibeketa, kallotin mayzibeeketa, hargininne qashetin tana oychibeeketa’ yaagana.<verse eid="MAT 25:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44"/>“He wode enti, ‘Godaw, neeni koshatin woyko saamotin woyko imathe gidada bin woyko kallotin woyko hargin woyko qashetin be7idi nena awude maaddonna ixido?’ yaagidi zaarana.<verse eid="MAT 25:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 25:45"/>“He wode kawoy zaaridi entako, ‘Taani hintew tuma odayis; hinte tana kaalliya ha ubbaafe guuxeysa maaddonna ixidaysi, tana maaddonna ixidaysa’ yaagana. <verse eid="MAT 25:45"/><verse number="46" style="v" sid="MAT 25:46"/>Hessa gisho, he asati merinaa pirdas qassi xilloti merinaa de7uwas baana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">25:46 </char><char style="xt" closed="false"><ref loc="DAN 12:2">Daane 12:2</ref>.</char></note><verse eid="MAT 25:46"/></para>
  <chapter eid="MAT 25"/>
  <chapter number="26" style="c" sid="MAT 26"/>
  <para style="s1">Yesuusa Bolla Maqetidosona</para>
  <para style="r">(<ref loc="MRK 14:1-2">Mar 14:1-2</ref>; <ref loc="LUK 22:1-2">Luqa 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoha 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1"/>Yesuusi ha timirtiya ubbaa wursida wode ba tamaaretako, <verse eid="MAT 26:1"/><verse number="2" style="v" sid="MAT 26:2"/>“Nam7u gallasape guye, Paasika Ba7aale bonchiya gallas gideysa ereeta. He gallas Asa Na7i masqale bolla kaqetanaw asa kushen aadhidi imetana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">26:2 </char><char style="xt" closed="false"><ref loc="EXO 12:1">Kessa 12:1</ref>.</char></note><verse eid="MAT 26:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3"/>He wode kahine halaqatinne cimati, Qayyaafa geetetiya kahine halaqaa keethan shiiqidi, <verse eid="MAT 26:3"/><verse number="4" style="v" sid="MAT 26:4"/>asi eronna Yesuusa oykidi, wodhanaw maqetidosona. <verse eid="MAT 26:4"/><verse number="5" style="v" sid="MAT 26:5"/>Shin enti, “Asay ooshshi kessonna mela gidi, Paasika bonchiya gallas hessa oothoko” yaagidosona.<verse eid="MAT 26:5"/></para>
  <para style="s1">Yesuusa Shitto Tiyida Maccasiw</para>
  <para style="r">(<ref loc="MRK 14:3-9">Mar 14:3-9</ref>; <ref loc="JHN 12:1-8">Yoha 12:1-8</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6"/>Yesuusi Bitaane kataman baro hargida Simoona son de7ees. <verse eid="MAT 26:6"/><verse number="7" style="v" sid="MAT 26:7"/>Yesuusi imatuwa bolla de7ishin issi maccasiya albasxiroosa philqaaxe kumetha daro al7o shitto eka yada Yesuusa huuphen tigasu.<note caller="-" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="LUK 7:37">Luqa 7:37</ref>.</char></note> <verse eid="MAT 26:7"/><verse number="8" style="v" sid="MAT 26:8"/>Shin Yesuusa tamaareti hessa be7idi hanqetidi, “Ha shittoy coo iitey aybisee? <verse eid="MAT 26:8"/><verse number="9" style="v" sid="MAT 26:9"/>Ha shittoy al7o gaten bayzetidi, miishey manqotas imetanaw danda7etees” yaagidosona.<verse eid="MAT 26:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10"/>Yesuusi enti geysa eridi, entako, “Ha maccasiw ayis waaysetii? Iya taw lo77oba oothasu. <verse eid="MAT 26:10"/><verse number="11" style="v" sid="MAT 26:11"/>Manqoti ubba wode hintera daana. Shin taani hintera ubba wode de7ike.<note caller="-" style="x"><char style="xo" closed="false">26:11 </char><char style="xt" closed="false"><ref loc="DEU 15:11">Zaare 15:11</ref>.</char></note> <verse eid="MAT 26:11"/><verse number="12" style="v" sid="MAT 26:12"/>Iya ha shittuwa ta bolla tigidaysi tana mooganaw giigisanaasa. <verse eid="MAT 26:12"/><verse number="13" style="v" sid="MAT 26:13"/>Taani hintew tuma odayis; biitta ubban ha Wongelay sabbaketiya bessan awunka, asay iyo hassayana mela iya oothidaysi odetana” yaagis.<verse eid="MAT 26:13"/></para>
  <para style="s1">Yihudi Yesuusa Aathidi Imuwa</para>
  <para style="r">(<ref loc="MRK 14:10-11">Mar 14:10-11</ref>; <ref loc="LUK 22:3-6">Luqa 22:3-6</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14"/>He wode tammanne nam7u Yesuusa tamaaretape issoy, Asqoroota Yihuda geeteteysi kahine halaqatako, <verse eid="MAT 26:14"/><verse number="15" style="v" sid="MAT 26:15"/>bidi, “Taani hintew Yesuusa aatha immiko, hinte taw ay immanee?” yaagidi enta oychis.<note caller="-" style="x"><char style="xo" closed="false">26:15 </char><char style="xt" closed="false"><ref loc="ZEC 11:12">Zaka 11:12</ref>.</char></note> Enti zoretidi hastamu bira santime<note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="fqa" closed="false">Bira santime: </char><char style="ft" closed="false">Aykoyka guzhetiboona geeshsha bira santime guussu.</char></note><note caller="+" style="f"><char style="fr" closed="false">26:15 </char><char style="fqa" closed="false">Hastamu bira santime: </char><char style="ft" closed="false">Hastamu bira santimey Isra7eele biittan aylley shametiyanne bayzetiya gate.</char></note> immidosona. <verse eid="MAT 26:15"/><verse number="16" style="v" sid="MAT 26:16"/>Hessafe guye, Yihudi Yesuusa aathidi immanaw injetiya wode wochees.<verse eid="MAT 26:16"/></para>
  <para style="s1">Godaa Kahuwa</para>
  <para style="r">(<ref loc="MRK 14:22-26">Mar 14:22-26</ref>; <ref loc="LUK 22:15-20">Luqa 22:15-20</ref>; <ref loc="2CO 11:23-25">2 Qoro 11:23-25</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17"/>Uytha Ba7aale bonchiya koyro gallas, Yesuusa tamaareti iyako yidi, “Paasika bonchiya gallas neeni maana kathi nuuni awun giigisino?” yaagidosona.<verse eid="MAT 26:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18"/>Yesuusi entako, “Kataman de7iya addiyako bidi, ‘Astamaarey, taw wodey gakida gisho, ta tamaaretara Paasika bonchiya gallasa ne son aathana yaagees’ yaagite” yaagis.<verse eid="MAT 26:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19"/>Iya tamaareti Yesuusi bantana kiitidaysada oothidi, Paasika Ba7aale gallas maana kathaa giigisidosona.<verse eid="MAT 26:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20"/>Sa7ay omarsiya wode, Yesuusi tammanne nam7u hawaaretara kathi maanaw uttis. <verse eid="MAT 26:20"/><verse number="21" style="v" sid="MAT 26:21"/>Enti mishin, Yesuusi entako, “Taani hintew tuma odayis; hintefe issi uray tana aathidi immana” yaagis.<verse eid="MAT 26:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22"/>Enti daro dagammidi, issoy issoy, “Godaw, tuma taneshsha?” gidi iya oychidosona.<verse eid="MAT 26:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23"/>Yesuusi zaaridi, “Ba kushiya taara issife shaatiyan yeddeysi I tana aathidi immana.<note caller="-" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Maz 41:9</ref>.</char></note> <verse eid="MAT 26:23"/><verse number="24" style="v" sid="MAT 26:24"/>Asa Na7ay, Xoossaa qaalan iyaw xaafetidaysada hayqana. Shin Asa Na7aa aathidi immiya uraa ayye! He uray yeletonna attidaako iyaw lo77oshin” yaagis.<verse eid="MAT 26:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25"/>Iya aathidi immanaw de7iya Yihudi zaaridi, “Astamaariyaw, neeni gey taneyee?” yaagis.</para>
  <para style="p" vid="MAT 26:25">Yesuusi zaaridi, “Neeni ne huuphen gadasa” yaagis.<verse eid="MAT 26:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26"/>Enti mishin, Yesuusi uythaa ekidi Xoossaa galatis. He uythaa menthidi ba tamaaretas immidi, “He7ite, miite, haysi ta ashuwa” yaagis.<verse eid="MAT 26:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27"/>Xuu7aa ekidi, Xoossaa galatis. Entaw immidi, “Ubbay haysafe uyite. <verse eid="MAT 26:27"/><verse number="28" style="v" sid="MAT 26:28"/>Haysi daro asa nagara atotethas mela gukiya ta suuthaa. Ha suuthay Xoossay hintera geliya caaquwa mintheysa.<note caller="-" style="x"><char style="xo" closed="false">26:28 </char><char style="xt" closed="false"><ref loc="EXO 24:8">Kessa 24:8</ref>; <ref loc="JER 31:31">Ermi 31:31</ref>.</char></note> <verse eid="MAT 26:28"/><verse number="29" style="v" sid="MAT 26:29"/>Shin taani hintew odayis; taani ta Aawa kawotethan ooratha woyne ushsha hintera uyana gallasa gakanaw nam7antho ha woyne ushsha uyike” yaagis.<verse eid="MAT 26:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30"/>Galata mazmure yexidaape guye, Shamaho zuma bidosona.<verse eid="MAT 26:30"/></para>
  <para style="s1">Phexroosi Yesuusa Kaddanaysi Odetis</para>
  <para style="r">(<ref loc="MRK 14:27-31">Mar 14:27-31</ref>; <ref loc="LUK 22:31-34">Luqa 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoha 13:36-38</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31"/>He wode Yesuusi entako,</para>
  <para style="q1" vid="MAT 26:31">“ ‘Xoossay henthanchuwa shocana</para>
  <para style="q2" vid="MAT 26:31">dorsatika laaletana’</para>
  <para style="m" vid="MAT 26:31">geetetidi Xoossa qaalan xaafetidaysa mela hachi qamma hinte ubbay tana aggidi baqatana.<note caller="-" style="x"><char style="xo" closed="false">26:31 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Zaka 13:7</ref>.</char></note> <verse eid="MAT 26:31"/><verse number="32" style="v" sid="MAT 26:32"/>Shin taani hayqope dendidaape guye hintefe sinthatada Galila baana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">26:32 </char><char style="xt" closed="false"><ref loc="MAT 28:16">Maato 28:16</ref>.</char></note><verse eid="MAT 26:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33"/>Phexroosi zaaridi, “Enti ubbay nena aggidi baqatikoka, taani nena aggike” yaagis.<verse eid="MAT 26:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34"/>Yesuusi Phexroosako, “Taani new tuma odayis; hachi qamma kuttoy waassanaape sinthe neeni tana heedzu toho kaddana” yaagis.<verse eid="MAT 26:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35"/>Phexroosi zaaridi, “Taani neera issife hayqope attishin, nena ubbaka kaddike” yaagis.</para>
  <para style="p" vid="MAT 26:35">Hanko iya tamaareti ubbayka hessada gidoosona.<verse eid="MAT 26:35"/></para>
  <para style="s1">Yesuusi Geetasamanen Woossis</para>
  <para style="r">(<ref loc="MRK 14:32-42">Mar 14:32-42</ref>; <ref loc="LUK 22:39-46">Luqa 22:39-46</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36"/>Yaatidi, Yesuusi ba tamaaretara Geetasemaane geetetiya bessaa bidi, entako, “Taani hini bada Xoossaa woossashana, hinte haysan uttite” yaagis. <verse eid="MAT 26:36"/><verse number="37" style="v" sid="MAT 26:37"/>Phexroosanne Zabdiyoosa nayta nam7ata baara eki bidi daro azzanonne un7etethi doomis. <verse eid="MAT 26:37"/><verse number="38" style="v" sid="MAT 26:38"/>Qassika entako, “Taani hayqos gathiya un7a un7etas. Haysan taara gam7itenne minnidi naagite” yaagis.<verse eid="MAT 26:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39"/>Guuthi sinthe bidi biittan gufannidi, “Ta Aawaw, danda7etiyaba gidiko ha waaye xuu7aa taape digga. Shin ne sheney hanope attishin, ta sheney hanopo” yaagidi Xoossaa woossis.<verse eid="MAT 26:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40"/>Yesuusi ba tamaaretako simmi yidi enti dhiskidashin demmis. Phexroosako, “Hinte issi saatekoka dhiskonna taara minnanaw danda7ibeeketii? <verse eid="MAT 26:40"/><verse number="41" style="v" sid="MAT 26:41"/>Paacen hinte gelonna mela barkidi naagitenne Xoossaa woossite. Hintew lo77o amoy de7ees, shin hinte daaburancho asi” yaagis.<verse eid="MAT 26:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42"/>Yesuusi qassi nam7antho bidi, “Ta Aawaw, taani ha waaye xuu7ape uyonna de7ishe aadhanaw danda7etonnaba gidiko ne sheney hano” yaagidi Xoossaa woossis. <verse eid="MAT 26:42"/><verse number="43" style="v" sid="MAT 26:43"/>Qassika simmi yaa wode iya tamaareta ayfiya dhiskoy goozin, zin7idashin demmis.<verse eid="MAT 26:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44"/>Qassika enta aggidi, bidi kase qaala zaari heedzantho woossis. <verse eid="MAT 26:44"/><verse number="45" style="v" sid="MAT 26:45"/>Hessafe guye, ba tamaaretako yidi, “Ha77i gakanaw dhisketinne shempetii? Heko, Asa Na7i, nagaranchota kushen aadhidi imetiya saatey gakis. <verse eid="MAT 26:45"/><verse number="46" style="v" sid="MAT 26:46"/>Dendidi yedhite, tana aathidi immeysi haysish gakis” yaagis.<verse eid="MAT 26:46"/></para>
  <para style="s1">Yesuusi Oyketis</para>
  <para style="r">(<ref loc="MRK 14:43-50">Mar 14:43-50</ref>; <ref loc="LUK 22:47-53">Luqa 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoha 18:3-12</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47"/>Yesuusi buroo hessa haasayishin, tammanne nam7u tamaaretape issoy, Yihudi gaki wodhis. Kahine halaqatinne deriya cimati kiitida daro asati mashshenne xam7a oykidi iyara issife yidosona. <verse eid="MAT 26:47"/><verse number="48" style="v" sid="MAT 26:48"/>Yesuusa aathidi immiya Yihudi he daro asaako, “Taani yeereysi hinte koyeysi iya, iya oykite” yaagidi malla immi wothis.<verse eid="MAT 26:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49"/>Iiraka Yesuusako shiiqidi, “Astamaariyaw, saro de7ay” yaagidi iya yeeris.<verse eid="MAT 26:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50"/>Yesuusi iyako, “Ta laggiyaw, neeni oothanaba ootha agga”<note caller="+" style="f"><char style="fr" closed="false">26:50: </char><char style="ft" closed="false">Ta laggiyaw, neeni oothanaba ootha agga: woyko hara birshethay ta laggiyaw, ne haysan ay oothay? </char></note> yaagis.</para>
  <para style="p" vid="MAT 26:50">Hessafe guye, shiiqidi, Yesuusa oykidosona. <verse eid="MAT 26:50"/><verse number="51" style="v" sid="MAT 26:51"/>Yesuusara de7eysatape issoy ba mashsha shoddidi kahine halaqaa aylliya shocidi, iya haythaa qanxidi yeggis. <verse eid="MAT 26:51"/><verse number="52" style="v" sid="MAT 26:52"/>Shin Yesuusi, “Ne mashsha guye shoohuwan zaara. Ayis giiko, mashsha shoddiya ubbay mashshan hayqana. <verse eid="MAT 26:52"/><verse number="53" style="v" sid="MAT 26:53"/>Ta, ta Aawa woossiyako daro mukulun taybetiya kiitanchota yeddanaw danda7onnaba new daanii? <verse eid="MAT 26:53"/><verse number="54" style="v" sid="MAT 26:54"/>Yaatin, Xoossaa qaalan hessada hananaw bessees geetetidaysi waanidi poletanee?” yaagis.<verse eid="MAT 26:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55"/>He saatiyan, Yesuusi he shiiqida daro asaako, “Tana panga oothidi oykanaw mashshanne xam7a oykidi yidetii? Taani xoossa keethan gallas gallas tamaarsashe hintera de7iya wode tana oykibeeketa.<note caller="-" style="x"><char style="xo" closed="false">26:55 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luqa 19:47</ref>; <ref loc="LUK 21:37">21:37</ref>.</char></note> <verse eid="MAT 26:55"/><verse number="56" style="v" sid="MAT 26:56"/>Shin haysi ubbay hanidaysi nabeti Xoossaa qaalan xaafidaysi poletana melasa” yaagis.</para>
  <para style="p" vid="MAT 26:56">He wode iya tamaareti ubbay iya aggidi baqatidosona.<verse eid="MAT 26:56"/></para>
  <para style="s1">Yesuusi Pirda Shango Sinthan</para>
  <para style="r">(<ref loc="MRK 14:53-65">Mar 14:53-65</ref>; <ref loc="LUK 22:54-55">Luqa 22:54-55</ref>, <ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yoha 18:13-14</ref>, <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57"/>Yesuusa oykidaysati kahine halaqaa Qayyaafako iya efidosona. Yan higge astamaaretinne biitta cimati shiiqidi de7oosona. <verse eid="MAT 26:57"/><verse number="58" style="v" sid="MAT 26:58"/>Shin Phexroosi kahine halaqaa zabbaa gakanaw haahon iya kaallis. Iya wursethay shaaketana gakanaw zabbaa gelidi naageysatara uttis.<verse eid="MAT 26:58"/></para>
  <para style="p">
    <verse number="59" style="v" sid="MAT 26:59"/>Kahine halaqatinne shiiqida asa ubbay Yesuusa wodhanaw iya bolla wordo marka koydosona. <verse eid="MAT 26:59"/><verse number="60" style="v" sid="MAT 26:60"/>Daroti yidi iya bolla wordo marka markatidosona, shin aykoka demmibookona. Guyepe nam7u asati yidi, <verse eid="MAT 26:60"/><verse number="61" style="v" sid="MAT 26:61"/>“Ha uray, ‘Taani Xoossa Keetha laallada heedzu gallasan zaara keexanaw danda7ayis’ yaagis” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">26:61 </char><char style="xt" closed="false"><ref loc="JHN 2:19">Yoha 2:19</ref>.</char></note><verse eid="MAT 26:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62"/>Kahineta halaqay dendi eqidi Yesuusako, “Haysati nena mootiya mootuwas neeni zaariyabay baawee?” yaagis. <verse eid="MAT 26:62"/><verse number="63" style="v" sid="MAT 26:63"/>Shin Yesuusi si77i gis. Qassika kahine halaqay, “Taani nena de7o Xoossaa sunthan oykayis; neeni Xoossaa Na7aa Kiristoosa gidiko nuus oda” yaagis.<verse eid="MAT 26:63"/></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64"/>Yesuusi zaaridi, “Neeni ne huuphenka gadasa. Shin taani hintew odayis; hizape guye, Asa Na7ay wolqaama Xoossaa ushacha baggan uttidashin, qassi salo shaarara yishin hinte be7ana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">26:64 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daane 7:13</ref>.</char></note><verse eid="MAT 26:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65"/>He wode kahine halaqay daro yilotidi ba ma7uwa peedhidi, “Haysa be7ite Xoossaa cayis! Nuna hara marka ay koshshii? I ha77i cayidaysa hinte si7ideta.<note caller="-" style="x"><char style="xo" closed="false">26:65 </char><char style="xt" closed="false"><ref loc="LEV 24:15-16">Leewe 24:15-16</ref>.</char></note> <verse eid="MAT 26:65"/><verse number="66" style="v" sid="MAT 26:66"/>Hinte qofay aybee?” yaagis.</para>
  <para style="p" vid="MAT 26:66">Entika, “Iyaw hayqo bessees” yaagidi zaaridosona.<verse eid="MAT 26:66"/></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67"/>Yaatin, enti iya som7on cuttidi dechidosona. Harati iya baqidi,<note caller="-" style="x"><char style="xo" closed="false">26:67 </char><char style="xt" closed="false"><ref loc="ISA 50:6">Isa 50:6</ref>.</char></note> <verse eid="MAT 26:67"/><verse number="68" style="v" sid="MAT 26:68"/>“Kiristoosa! Nena dechiday oonee? Ane nuus oda” yaagidosona.<verse eid="MAT 26:68"/></para>
  <para style="s1">Phexroosi Yesuusa Kaddis</para>
  <para style="r">(<ref loc="MRK 14:66-72">Mar 14:66-72</ref>; <ref loc="LUK 22:56-62">Luqa 22:56-62</ref>; <ref loc="JHN 18:15-18">Yoha 18:15-18</ref>, <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69"/>Phexroosi zabban uttidashin, issi aylliya iyako yada, “Neenika Galila Yesuusara issife de7aasa” yaagasu.<verse eid="MAT 26:69"/></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70"/>Shin I enta ubbaa sinthan he aylleko, “Neeni giyabay aybeko taani erike” yaagidi kaddis.<verse eid="MAT 26:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MAT 26:71"/>Qassi bidi dirsaa pengeko gakishin hara aylliya iya be7ada, yan de7iya asaako, “Ha uray Naazirete Yesuusara de7ees” yaagasu.<verse eid="MAT 26:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72"/>Phexroosi nam7antho caaqidi, “Taani he uraa erike!” yaagis.<verse eid="MAT 26:72"/></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73"/>Guuthu gam7ishin, yan eqida asati Phexroosako yidi, “Neka tuma entara issife de7aasa; neeni ne odan eretasa” yaagidosona.<verse eid="MAT 26:73"/></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74"/>Hessafe guye, Phexroosi, “Taani he uraa erike!” yaagidi, bana baadethinne caaqo doomis.</para>
  <para style="p" vid="MAT 26:74">He wode iiraka kuttoy waassi aggis. <verse eid="MAT 26:74"/><verse number="75" style="v" sid="MAT 26:75"/>Yesuusi iyako, “Neeni kuttoy waassanaape sinthe tana heedzu toho kaddana” gidaysa Phexroosi akeekidi, kare keyidi iita yeeho yeekis.<verse eid="MAT 26:75"/></para>
  <chapter eid="MAT 26"/>
  <chapter number="27" style="c" sid="MAT 27"/>
  <para style="s1">Yihudi Suletidi Hayqis</para>
  <para style="r">(<ref loc="MRK 15:1">Mar 15:1</ref>; <ref loc="LUK 23:1-3">Luqa 23:1-3</ref>; <ref loc="JHN 18:28-32">Yoha 18:28-32</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1"/>Wonta guura kahine halaqatinne biitta cimati ubbay Yesuusa wodhisanaw maqetidosona. <verse eid="MAT 27:1"/><verse number="2" style="v" sid="MAT 27:2"/>Enti Yesuusa qachi efidi deriya haariya Philaxoosas aathidi immidosona.<verse eid="MAT 27:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3"/>He wode Yesuusa oythida Yihudi, Philaxoosi Yesuusa bolla pirdidaysa be7idi, qiirotidi, he hastamu bira santime kahine halaqatasinne deriya cimatas guye zaaris.<note caller="-" style="x"><char style="xo" closed="false">27:3 </char><char style="xt" closed="false"><ref loc="ACT 1:18-19">Hawa 1:18-19</ref>.</char></note> <verse eid="MAT 27:3"/><verse number="4" style="v" sid="MAT 27:4"/>“Taani xillo asi hayqos aatha immada nagara oothas” yaagis.</para>
  <para style="p" vid="MAT 27:4">Shin enti, “Hessi nu meto gidenna ne meto” yaagidosona.<verse eid="MAT 27:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5"/>Yihudi miishiya Xoossa Keethan yeggi aggidi enta matape bidi, suletidi hayqis.<verse eid="MAT 27:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6"/>Kahine halaqati miishiya ekidi, “Ha miishey suutha miishe gidiya gisho, nuuni Xoossa Keethaa miishiyara gatheysi woga gidenna” yaagidosona. <verse eid="MAT 27:6"/><verse number="7" style="v" sid="MAT 27:7"/>Hessafe guye, issife zoretidi, bete asi mooganaw mana biitta shammidosona. <verse eid="MAT 27:7"/><verse number="8" style="v" sid="MAT 27:8"/>Hessa gisho, he gadey hachi gakanaw suutha biitta geetetidi xeegetees.<verse eid="MAT 27:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9"/>Nabiya Ermiyaasi, “Isra7eele asay iyaw qanxanaw gammatida hastamu bira santime ekidosona.<note caller="-" style="x"><char style="xo" closed="false">27:9 </char><char style="xt" closed="false"><ref loc="ZEC 11:12-13">Zaka 11:12-13</ref>.</char></note> <verse eid="MAT 27:9"/><verse number="10" style="v" sid="MAT 27:10"/>Goday tana kiitidaysada mana biitta shammanaw immidosona” gidaysi he wode poletis.<verse eid="MAT 27:10"/></para>
  <para style="s1">Yesuusi Philaxoosa Sinthan</para>
  <para style="r">(<ref loc="MRK 15:2-5">Mar 15:2-5</ref>; <ref loc="LUK 23:3-5">Luqa 23:3-5</ref>; <ref loc="JHN 18:33-38">Yoha 18:33-38</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11"/>Yesuusi deriya haariya Philaxoosa sinthe shiiqin, Philaxoosi iyako, “Neeni Ayhude kawo?” yaagidi oychis.</para>
  <para style="p" vid="MAT 27:11">Yesuusi zaaridi, “Ne gadasa” yaagis.<verse eid="MAT 27:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 27:12"/>Kahine halaqatinne biitta cimati iya mootiya wode entaw aybi zaaroka immibeenna.<verse eid="MAT 27:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13"/>He wode Philaxoosi Yesuusako, “Haysati nena mootiya mootuwa ubbaa si7ikii?” yaagis.<verse eid="MAT 27:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14"/>Yesuusi hari attoshin, issi qaalaka zaaronna ixin, deriya haareysi daro malaaletis.<verse eid="MAT 27:14"/></para>
  <para style="s1">Yesuusi Hayqo Pirdetis</para>
  <para style="r">(<ref loc="MRK 15:6-15">Mar 15:6-15</ref>; <ref loc="LUK 23:13-25">Luqa 23:13-25</ref>; <ref loc="JHN 18:39-40">Yoha 18:39-40</ref>; <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15"/>Deriya haareysi laythan laythan Paasika Ba7aale bonchiya gallasan, asay koyiya issi asi qashope birshiya wogi de7ees. <verse eid="MAT 27:15"/><verse number="16" style="v" sid="MAT 27:16"/>He wode issi Barbaana Yesuusa geetetiya daro eretida iita asi qasho keethan de7ees. <verse eid="MAT 27:16"/><verse number="17" style="v" sid="MAT 27:17"/>Hessa gisho, daro asay shiiqidi de7ishin Philaxoosi, “Taani hintew Barbaana billoye woyko Yesuusa geetetiya Kiristoosa billo?” yaagidi asaa oychis. <verse eid="MAT 27:17"/><verse number="18" style="v" sid="MAT 27:18"/>I hessa giday enti qanaatidi Yesuusa oythidaysa eriya gishosa.<verse eid="MAT 27:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19"/>Philaxoosi pirda keethan uttidashin, iya machiya, “Taani hachi qamma amuhon iyabaa daro waayetashe aqida gisho, he xillo uraa bolla aybibaaka oothofa” yaagada kiittasu.<verse eid="MAT 27:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20"/>He wode kahine halaqati, “Barbaani bileto, Yesuusi hayqo” gidi Philaxoosa woossana mela asaa cimmidosona.<verse eid="MAT 27:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 27:21"/>Philaxoosi zaaridi, “Taani enta nam7aafe hintew oona billana mela koyeetii?” yaagidi oychis.</para>
  <para style="p" vid="MAT 27:21">Enti, “Barbaana billana mela koyoos” yaagidosona.<verse eid="MAT 27:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22"/>Philaxoosi, “Yaatin, Yesuusa geetetiya Kiristoosa waato?” yaagidi enta oychis.</para>
  <para style="p" vid="MAT 27:22">Ubbay zaaridi, “Masqaliya bolla iya kaqa” yaagidosona.<verse eid="MAT 27:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23"/>Philaxoosi asaako, “Ayis? I ay iitabaa oothidee?” yaagidi oychis.</para>
  <para style="p" vid="MAT 27:23">Shin asay kaseysafe aathidi, “Masqaliya bolla iya kaqa” gidi waassidosona.<verse eid="MAT 27:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24"/>Ooshshi denthethofe hara aybibaaka oothanaw danda7etonaysa Philaxoosi be7idi, haathe ekidi, “Ha uraa hayquwan taani de7ike. Hessa oothey hintena” yaagidi asaa sinthan ba kushiya meecetis.<note caller="-" style="x"><char style="xo" closed="false">27:24 </char><char style="xt" closed="false"><ref loc="DEU 21:6">Zaare 21:6</ref>.</char></note><verse eid="MAT 27:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25"/>Asa ubbay zaaridi, “Iya suuthaa gomey nunanne nu nayta gako” yaagidosona.<verse eid="MAT 27:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26"/>Yaatin, Philaxoosi Barbaana entaw billidi, Yesuusa lisson garaafidi, masqaliya bolla kaqetidi hayqana mela entaw aathidi immis.<verse eid="MAT 27:26"/></para>
  <para style="s1">Yesuusa Bolla Qelqisidosona</para>
  <para style="r">(<ref loc="MRK 15:16-20">Mar 15:16-20</ref>; <ref loc="JHN 19:2-3">Yoha 19:2-3</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27"/>Hessafe guye, Philaxoosa wotaadareti Yesuusa deriya haareysa soo eki efin, wotaadareti ubbay iya yuushuwan eqidosona. <verse eid="MAT 27:27"/><verse number="28" style="v" sid="MAT 27:28"/>Iya afilaa qaari ekidi zo7o afila<note caller="+" style="f"><char style="fr" closed="false">27:28 </char><char style="fqa" closed="false">Zo7o afila: </char><char style="ft" closed="false">Beni wode kawoti bollara ma7iya afila.</char></note> mayzidosona. <verse eid="MAT 27:28"/><verse number="29" style="v" sid="MAT 27:29"/>Qassi aguntha kallacha giigisidi, iya huuphen wothidosona. Iya ushacha kushiyan mayre xam7a oythidi, iya sinthan gulbatidi, “Ayhude kawaw, mukulu laythi kawota!” yaagidi, iya bolla qelqisidosona. <verse eid="MAT 27:29"/><verse number="30" style="v" sid="MAT 27:30"/>Iya bolla cuttidosona. He mayre xam7aa ekidi, iya huuphen shocidosona. <verse eid="MAT 27:30"/><verse number="31" style="v" sid="MAT 27:31"/>Enti iya bolla qelqisidaape guye, zo7o afilaa iyape qaari ekidi, iya afilaa iya mayzidosona. Masqaliya bolla iya kaqanaw eki efidosona.<verse eid="MAT 27:31"/></para>
  <para style="s1">Yesuusi Kaqetis</para>
  <para style="r">(<ref loc="MRK 15:21-32">Mar 15:21-32</ref>; <ref loc="LUK 23:25-43">Luqa 23:25-43</ref>; <ref loc="JHN 19:17-27">Yoha 19:17-27</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32"/>Enti kare keyidi, issi Simoona geetetiya Qereena biitta asi demmidi, Yesuusa masqaliya wolqan toossidosona. <verse eid="MAT 27:32"/><verse number="33" style="v" sid="MAT 27:33"/>Golgota geetetiya bessi gakidosona. “Golgota” guussay “Guugge bessi” guussu. <verse eid="MAT 27:33"/><verse number="34" style="v" sid="MAT 27:34"/>Hessan enti ciiye walaketida woyne ushsha uyo gidi iyaw immidosona. Shin I hessa ganxi ekidi, uyonna ixis.<note caller="-" style="x"><char style="xo" closed="false">27:34 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Maz 69:21</ref>.</char></note><verse eid="MAT 27:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35"/>Enti masqaliya bolla iya kaqidaysafe guye, iya afilaa shaakidi, saama yeggidi ekidosona.<note caller="-" style="x"><char style="xo" closed="false">27:35 </char><char style="xt" closed="false"><ref loc="PSA 22:18">Maz 22:18</ref>.</char></note> <verse eid="MAT 27:35"/><verse number="36" style="v" sid="MAT 27:36"/>Hessafe guye, yan uttidi iya naagidosona. <verse eid="MAT 27:36"/><verse number="37" style="v" sid="MAT 27:37"/>Qassi, “Haysi Ayhude Kawa Yesuusa” giya mooto xuufiya iya huuphe son wothidosona. <verse eid="MAT 27:37"/><verse number="38" style="v" sid="MAT 27:38"/>Yesuusara he wode nam7u pangata issuwa iyape ushacha baggan, hankuwa iyape haddirsa baggara, masqaliya bolla kaqidosona.<verse eid="MAT 27:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39"/>Ogiyara aadhiya asay Yesuusa boridi, iya bolla cuttishe,<note caller="-" style="x"><char style="xo" closed="false">27:39 </char><char style="xt" closed="false"><ref loc="PSA 22:7">Maz 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>.</char></note> <verse eid="MAT 27:39"/><verse number="40" style="v" sid="MAT 27:40"/>“Xoossa Keethaa laallada heedzu gallasa giddon keexeyso, nena ashsha. Neeni Xoossaa Na7a gidiko, ane masqaliya bollafe wodha” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="MAT 26:61">Maato 26:61</ref>; <ref loc="JHN 2:19">Yoha 2:19</ref>.</char></note><verse eid="MAT 27:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41"/>Hessadaka, kahine halaqati, higge astamaaretinne biitta cimati issife Yesuusa bolla qelqisidosona. Haysada yaagidosona: <verse eid="MAT 27:41"/><verse number="42" style="v" sid="MAT 27:42"/>“Harata ashshis, shin bana ashshanaw danda7ibeenna. I Isra7eele kawo gidiko, ane masqaliya bollafe ha77i wodho, nuka iya ammanana. <verse eid="MAT 27:42"/><verse number="43" style="v" sid="MAT 27:43"/>Xoossan I ammanetees, Xoossay iya ashshanaw koyko ane ashsho. Ayis giiko, I bana, ‘Taani Xoossaa Na7a’ gees” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">27:43 </char><char style="xt" closed="false"><ref loc="PSA 22:8">Maz 22:8</ref>.</char></note><verse eid="MAT 27:43"/></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44"/>Qassi hari attoshin, iyara masqaliya bolla kaqetida pangatika hessada gidi iya bolla qelqisidosona.<verse eid="MAT 27:44"/></para>
  <para style="s1">Yesuusa Hayquwa</para>
  <para style="r">(<ref loc="MRK 15:33-41">Mar 15:33-41</ref>; <ref loc="LUK 23:44-49">Luqa 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoha 19:28-30</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45"/>Usupun saatepe bidi, uddufun saate gakanaw biitta ubbay dhumis. <verse eid="MAT 27:45"/><verse number="46" style="v" sid="MAT 27:46"/>Uddufun saate gidiya wode Yesuusi, “Elohe, Elohe, lama sabaqtanii?” gidi gita waaso waassis. “Elohe, Elohe, lama sabaqtanii?” geysa birshethay “Ta Xoossaw, ta Xoossaw, tana ayis aggadii?” guussu.<note caller="-" style="x"><char style="xo" closed="false">27:46 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Maz 22:1</ref>.</char></note><verse eid="MAT 27:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47"/>Hessan eqida asaape issoti issoti hessa si7idi, “Ha uray Eeliyaasa xeegees” yaagidosona. <verse eid="MAT 27:47"/><verse number="48" style="v" sid="MAT 27:48"/>Iira entafe issoy woxi bidi, isponje ekidi, caala woyne ushsha kunthis. Hessa mayre xam7a xeeran wothidi ushshanaw iya doonako shiishis.<note caller="-" style="x"><char style="xo" closed="false">27:48 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Maz 69:21</ref>.</char></note> <verse eid="MAT 27:48"/><verse number="49" style="v" sid="MAT 27:49"/>Shin hankoti, “Naaga, Eeliyaasi iya ashshanaw yaaneko ane be7oos” yaagidosona. <verse eid="MAT 27:49"/><verse number="50" style="v" sid="MAT 27:50"/>Yesuusi nam7antho gita waaso waassidi, hayqi aggis.<verse eid="MAT 27:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51"/>He saaten xoossa keethan kaqetida magaraajoy qommofe duge gakanaw nam7u keyidi, peedheti wodhis. Biittay qaaxis, zaallayka phalqetis.<note caller="-" style="x"><char style="xo" closed="false">27:51 </char><char style="xt" closed="false"><ref loc="EXO 26:31">Kessa 26:31</ref>.</char></note> <verse eid="MAT 27:51"/><verse number="52" style="v" sid="MAT 27:52"/>Duufoti dooyetin Xoossaa asatape daroti hayqope dendidosona. <verse eid="MAT 27:52"/><verse number="53" style="v" sid="MAT 27:53"/>Enti duufope keyidi, Yesuusi hayqope dendidaape guye, geeshsha katamaa bidosona; yan enti daro asaas bentidosona.<verse eid="MAT 27:53"/></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54"/>Mato halaqaynne iyara Yesuusa naagiya wotaadareti biittay qaaxidaysanne hessan hanidaba be7ida wode daro yayyidi “Tuma haysi Xoossaa Na7aa” yaagidosona.<verse eid="MAT 27:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55"/>Hessan daro maccasati, Galilape doomidi Yesuusa haggaazishe kaallidaysati haahon eqidi xeelloosona.<note caller="-" style="x"><char style="xo" closed="false">27:55 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luqa 8:2-3</ref>.</char></note> <verse eid="MAT 27:55"/><verse number="56" style="v" sid="MAT 27:56"/>Enta giddon Magdela Mayraama,<note caller="+" style="f"><char style="fr" closed="false">27:56 </char><char style="fqa" closed="false">Magdela Mayraamo: </char><char style="ft" closed="false">Guussay Magdela katamaape yida Mayraamo guussu.</char></note> Yayqoobanne Yoosefa aayiya Mayraamanne Zabdiyoosa machiya de7oosona.<verse eid="MAT 27:56"/></para>
  <para style="s1">Yesuusi Moogetis</para>
  <para style="r">(<ref loc="MRK 15:42-47">Mar 15:42-47</ref>; <ref loc="LUK 23:50-56">Luqa 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoha 19:38-42</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57"/>Sa7ay omarsiya wode Yoosefa geetetiya issi dure aday, Armaate katamape yis. I ba huuphenka Yesuusa kaalliya asi. <verse eid="MAT 27:57"/><verse number="58" style="v" sid="MAT 27:58"/>Yoosefi Philaxoosako bidi, Yesuusa aha ekanaw woossis. Philaxoosi ahay Yoosefas imetana mela kiittis. <verse eid="MAT 27:58"/><verse number="59" style="v" sid="MAT 27:59"/>Yesuusa aha ekidi, geeshsha moogo afilan xaaxis. <verse eid="MAT 27:59"/><verse number="60" style="v" sid="MAT 27:60"/>Baw moogetanaw shuchafe woocida ooratha gongolon iya aha wothis. Qassi he gongoluwa doonan gita shuchaa gondorsi wothidi, aggidi bis. <verse eid="MAT 27:60"/><verse number="61" style="v" sid="MAT 27:61"/>Magdela Mayraamanne hanko Mayraama he gongoluwako simmidi uttidosona.<verse eid="MAT 27:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62"/>Wontethe Sambaata gallas, kahine halaqatinne Farsaaweti Philaxoosako yidi, haysada yaagidosona: <verse eid="MAT 27:62"/><verse number="63" style="v" sid="MAT 27:63"/>“Godaw, ha wordanchoy paxa de7ishe, ‘Taani heedzu gallasape guye, hayqope dendana’ yaagidaysi nuus hassayetis.<note caller="-" style="x"><char style="xo" closed="false">27:63 </char><char style="xt" closed="false"><ref loc="MAT 16:21">Maato 16:21</ref>; <ref loc="MAT 17:23">17:23</ref>; <ref loc="MAT 20:19">20:19</ref>; <ref loc="MRK 8:31">Mar 8:31</ref>; <ref loc="MRK 9:31">9:31</ref>; <ref loc="MRK 10:33">10:33</ref>.</char></note> <verse eid="MAT 27:63"/><verse number="64" style="v" sid="MAT 27:64"/>Hessa gisho, I moogetida gongoluwa heedzu gallas gakanaw, minthi naagana mela kiittarki. Hessi hanonna ixiko, iya tamaareti bidi iya aha kaysi dhaysidi, ‘Hayqope dendis’ yaagidi asaas odiko nam7antho balesoy koyroysafe ubba haa iitana” yaagidosona.<verse eid="MAT 27:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65"/>Philaxoosi entako, “Hintew naageysati de7oosona; bidi hintew danda7etida mela naagisite” yaagis.<verse eid="MAT 27:65"/></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66"/>Hessa gisho, enti bidi duufoy boshetonna mela shuchaa bolla maatame wothidi wotaadaretan naagisidosona.<verse eid="MAT 27:66"/></para>
  <chapter eid="MAT 27"/>
  <chapter number="28" style="c" sid="MAT 28"/>
  <para style="s1">Yesuusi Hayqope Denduwa</para>
  <para style="r">(<ref loc="MRK 16:1-10">Mar 16:1-10</ref>; <ref loc="LUK 24:1-12">Luqa 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoha 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1"/>Sambaati aadhin, wogga wode wonta guura, Magdela Mayraamanne hanko Mayraama Yesuusi moogetida gongoluwa be7anaw bidosona. <verse eid="MAT 28:1"/><verse number="2" style="v" sid="MAT 28:2"/>Qoponna wolqaama biitta qaaxoy hanis. Godaa kiitanchoy salope wodhidi duufuwa doonan de7iya shuchaa gondorsidi iya bolla uttis. <verse eid="MAT 28:2"/><verse number="3" style="v" sid="MAT 28:3"/>Iya malay wol7anthi daanees. Iya ma7oyka shachada boothi. <verse eid="MAT 28:3"/><verse number="4" style="v" sid="MAT 28:4"/>Naageysati kiitanchuwa be7idi, yashshan kokoridi, hayqida asada hanidosona.<verse eid="MAT 28:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5"/>Kiitanchoy maccasatako, “Hinte masqaliya bolla kaqetida Yesuusa koyeysa taani eriya gisho, yayyofite. <verse eid="MAT 28:5"/><verse number="6" style="v" sid="MAT 28:6"/>I kase odidaysa mela hayqope dendis; haysan deenna. Haa yidi iya zin7isida bessaa be7ite. <verse eid="MAT 28:6"/><verse number="7" style="v" sid="MAT 28:7"/>Hinte ha77i ellesi bidi, iya tamaaretas, ‘Yesuusi hayqope dendis. Qassi I hintefe sinthatidi Galila baana; hinte iya yan be7ana’ yaagidi odite. Taani hintew haysa odanaw yas” yaagis.<verse eid="MAT 28:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8"/>Enti yayyishenne daro ufaytishe, duufuwa matape ellessidi bidi, iya tamaaretas odanaw woxidosona.<verse eid="MAT 28:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9"/>Qoponna Yesuusi entara gahetidi entako, “Saroy hintew gido” yaagis. Enti iyako shiiqidi, iya tohuwa oykidi iyaw goyinnidosona. <verse eid="MAT 28:9"/><verse number="10" style="v" sid="MAT 28:10"/>He wode Yesuusi entako, “Yayyofite; bidi ta tamaareti Galila baana mela entaw odite. Enti yan tana be7ana” yaagis.<verse eid="MAT 28:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11"/>He maccasati bishin, duufuwa naagiya wotaadaretape baggati katamaa bidi, hanidaba ubbaa kahine halaqatas odidosona. <verse eid="MAT 28:11"/><verse number="12" style="v" sid="MAT 28:12"/>Kahine halaqatinne cimati shiiqidi zoretidi, wotaadaretas daro miishe immidi, <verse eid="MAT 28:12"/><verse number="13" style="v" sid="MAT 28:13"/>“ ‘Nuuni dhiskidashin iya tamaareti qamma yidi, iya aha kaysidosona’ yaagite. <verse eid="MAT 28:13"/><verse number="14" style="v" sid="MAT 28:14"/>Ha odaa deriya haareysi si7iko, hessi hinte bala gidonnaysa nuuni iya odi ammanthana. Hintena aybika Hirgisopo” yaagidosona.<verse eid="MAT 28:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15"/>Wotaaddareti miishiya ekidi, kiitetidaysada oothidosona. Ha oday Ayhude matan hachi gakanaw odetishe de7ees.<verse eid="MAT 28:15"/></para>
  <para style="s1">Gita Kiita</para>
  <para style="r">(<ref loc="MRK 16:14-18">Mar 16:14-18</ref>; <ref loc="LUK 24:36-49">Luqa 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoha 20:19-23</ref>; <ref loc="ACT 1:6-8">Hawa 1:6-8</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16"/>Tammanne issi iya tamaareti Yesuusi bantana biite gida Galila Zumaa bolla Keyidosona.<note caller="-" style="x"><char style="xo" closed="false">28:16 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Maato 26:32</ref>; <ref loc="MRK 14:28">Mar 14:28</ref>.</char></note> <verse eid="MAT 28:16"/><verse number="17" style="v" sid="MAT 28:17"/>Yan enti iya be7ida wode iyaw goyinnidosona, shin entafe issoti issoti sidhidosona.<verse eid="MAT 28:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 28:18"/>Yesuusi entako shiiqidi, “Saloninne sa7an maati ubbay taw imetis. <verse eid="MAT 28:18"/><verse number="19" style="v" sid="MAT 28:19"/>Hiza, hinte ubba bessi bidi, Aawa, Na7aa, Geeshsha Ayyaana sunthan ase ubbaa xammaqidi tana kaalleyisata oothite.<note caller="-" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 1:8">Hawa 1:8</ref>.</char></note> <verse eid="MAT 28:19"/><verse number="20" style="v" sid="MAT 28:20"/>Taani hintena kiittidaba ubbaa enti naagana mela enta tamaarsite. Taani wodiya wursethaa gakanaw ubba wode hintera de7ayis” yaagis.<verse eid="MAT 28:20"/></para>
  <chapter eid="MAT 28"/>
</usx>
