<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">2 Phexroosa Kiita</para>
  <para style="toc1">2 Phexroosa Kiita</para>
  <para style="toc3">2 Phex</para>
  <para style="toc2">2 Phexroosa</para>
  <para style="mt1">Phexroosi Xaafida</para>
  <para style="mt2">Nam7antho Kiita</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Hawaariya Phexroosi xaafida nam7antho kiitay, dumma dumma bessan de7iya beni ammaniya asaasa. Ha kiitay xaafetida gaasoy, wordo astamaareta iita oosuwanne enta timirtiya gaason medhetida yeella de7uwa ammaniya asay ixana melasa. He medhetida metota digganaw oge gidanay, Yesuusa banta ayfen be7ida asatinne I tamaarsiya wode banta haythan si7ida asati tamaarsida timirtiya baggara Xoossabanne Godaa Yesuus Kiristoosaba ammanthiya era oykethi. Xaafey minthidi odiday, “Kiristoosi nam7antho yeenna” giya wordo timirtiyaba. He qofa minthidi odishe, “Kiristoosi simmidi yoonna gam7iday, asi ubbay ba nagarape simmana melape attishin, oonika dhayana mela koyonna gishosa” yaagees.</para>
  <para style="iot">Maxaafa Ayfe qofata</para>
  <para style="io1">Sarothonne woosa <char style="ior">(<ref loc="2PE 1:1-2">1:1-2</ref>)</char></para>
  <para style="io1">Ammaniya asay daana duussa <char style="ior">(<ref loc="2PE 1:3-15">1:3-15</ref>)</char></para>
  <para style="io1">Kiristoosa bonchuwa <char style="ior">(<ref loc="2PE 1:16-21">1:16-21</ref>)</char></para>
  <para style="io1">Wordo astamaaretanne nabeta <char style="ior">(<ref loc="2PE 2:1-22">2:1-22</ref>)</char></para>
  <para style="io1">Kiristoosa nam7antho yuussay tuma <char style="ior">(<ref loc="2PE 3:1-18">3:1-18</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />Yesuus Kiristoosa hawaareynne iya aylley, taani, Simooni Phexroosi, nu Xoossaanne nuna ashshiya Yesuus Kiristoosa xillotethaa baggara nuysa mela al7o ammano ekidaysatas ha dabdaabiya xaafas.<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />Xoossaanne nu Godaa Yesuusa eron aadho keehatethaynne saroy hintew kumo.<verse eid="2PE 1:2" /></para>
  <para style="s1">Xoossaa Xeessaanne Dooruwa</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />Ba bonchoninne lo77otethan nuna xeegida iya eron de7osinne Xoossaa daanidi daanaw koshshiyaba ubbaa Xoossay ba wolqan nuus immis. <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />Hinte iita amo gaason medhetiya ha alamiyan de7iya dhayope kessi ekanaadanne Xoossaa xoossatethan shaaketanaada, ha imotata baggara daro al7onne gita ufaysaa nuus immis. <verse eid="2PE 1:4" /><verse number="5" style="v" sid="2PE 1:5" />Hessa gisho, minnidi, hinte ammanuwa bolla lo77otethi, lo77otetha bolla eratethi, <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />eratetha bolla bana haaro, bana haaro bolla genca, genca bolla Xoossaa daano, <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />Xoossaa daano bolla ishatetha keehatethi, ishatetha keehatetha bolla siiqo gujite. <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />Haysati hintew daridi de7iyaba gidiko, Godaa Yesuus Kiristoosa eron maaddiya asinne ayfera de7iya asi oothana. <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />Shin hessati bayna oonika matan de7iyaba xalaala be7iya qooqe. I ba kase nagaraape geeyidaysa dogis.<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />Hessa gisho, ta ishato, hinte xeessanne hinte dooruwa minthanaw kaseysafe aathidi minnite. Hinte hessata oothiyaba gidiko, dhubeteketa. <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />Hessan nu Godaanne nuna ashshiya Yesuus Kiristoosa merinaa kawotethaa geliya kumetha maatay hintew imetana.<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />Hessa gisho, hinte haysata eriyabaanne he oykida tuman minnidi de7iyaba gidikoka, taani haysata ubba wode hintena hassayiso aggike. <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />Taani shempora de7ida wode ubban hintena hassayisanaysi koshshiyaba gada qopayis. <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />Nu Godaa Yesuus Kiristoosi taw qoncisadaysada taani ha hayqiya asatethaa gam7onna qaara yeggada baanaysa erayis. <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />Taani hintefe shaaketikoka hinte haysata ubba wode akeekana mela taw danda7etiyaba ubbaa oothana.<verse eid="2PE 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />Nuuni Godaa Kiristoosa wolqaanne iya yuussaba hintew odey, iya gita bonchuwa be7idipe attishin, medhi kessida hayse gidenna. <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" />Daro wolqaama bonchuwafe, “Taani ufaytiya, ta dosiya na7ay haysa” giya qaalay yida wode, Xoossaa Aawape bonchonne galata ekis.<note caller="-" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAT 17:1-5">Maato 17:1-5</ref>; <ref loc="MRK 9:2-7">Mar 9:2-7</ref>; <ref loc="LUK 9:28-35">Luqa 9:28-35</ref>.</char></note> <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />Nuuni geeshsha zumaa bolla iyara de7iya wode he qaalay salope yishin si7ida.<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />Nuus hessafe aadhiya ammanetida tinbite qaali de7ees. Sa7i wontana gakanawunne bakali hinte wozanan dolana gakanaw, dhuman poo7iya poo7o asi naageysada, hinte he qaala naagiko lo77o ootheeta. <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />Ubbaafe kasetidi haysa erite. Geeshsha Maxaafan xaafetida tinbite qaala oonika ba dosidaada birshanaw danda7enna. <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />Tinbite ubbaa, Xoossay kiitida asati Geeshsha Ayyaanay kaalethin, odidosonape attishin, asa shenen odibookona.<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s1">Wordo Astamaareta</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />Shin wordo nabeti kase asaa giddon de7eysa mela ha77ika wordo astamaareti hinte giddon dendana. Enti bantana wozida, Godaa kaddidi, dhaysiya wordo timirtiya ehana. Hessan enti banta bolla ellesidi dhayo ehoosona. <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />Daro asay yeellayiya enta iita ogiya kaallana; enta gaason tuma ogey cayetana. <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />Wordo astamaareti miishe yaaridi bantaw medhi kessida haysen hintena bonqana. Benipe doomidi enta pirday giigidi uttis; enta dhayoyka entana naagidi uttis.<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />Nagara oothida kiitanchotas Xoossay qadhetonna, pirda gallas gakanaw gaanname dhuma ollan enta qachi yeggis. <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />Hessadaka, Xoossay xillotethabaa odiya Nohenne hara laapun asata ashshidi, Xoossaa goyinnona asay de7iya beni alamiya qadhetonna dhayo haathan dhaysis.<note caller="-" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="GEN 6:1-7:24">Medhe 6:1—7:24</ref>.</char></note> <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />Geellatas leemiso gidana mela Xoossay Soodomenne Gamoora katamata bido oothidi xuuggidi dhaysis.<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="GEN 19:24">Medhe 19:24</ref>.</char></note> <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />Higges kiitetonna laymatiya asata giddon waayetishe de7ida xillo Looxe Xoossay ashshis.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="GEN 19:1-16">Medhe 19:1-16</ref>.</char></note> <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />He xillo addey enta giddon de7ishe, enti oothiya iita oosuwa gallas gallas be7ida wodenne si7ida wode iya lo77o wozanay un7etees. <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />Hessa gidiko, Goday, bana goyinniya asata paacepe waati ashshaneko, qassi nagaranchota pirda gallasaas gakanaw waatidi seerishe naagisaneeko erees. <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />Ubbaafe aathidi tuna amon asho qofa kaalleysatanne maata aawata kadheyisata, pirda gallas gakanaw Goday naagisis.</para>
  <para style="p" vid="2PE 2:10">He asati ganje minonne otorancho gidiya gisho, salo medhetethata cayishe yayyokonna. <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />Shin kiitanchoti wordo astamaaretape wolqaninne minotethan daro aadhosonashin Godaa sinthan salo medhetethata cayokona. <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />Shin he asati banta eronnaban gelidi cayoosona. Enti oyketanawunne hayqanaw yeletida, wozani bayna do7a mela hanoosona; entika wora do7ada coo dhayana.<verse eid="2PE 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2PE 2:13" />Enti gathida metuwada zaari metootana. Seeta gallas yexishe gupeysa ufaysiyabaa gidi qopoosona. Enti kawushatanne tunata gidi de7ishe hintera shaaketiya siiqo imatuwan ufaytoosona. <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />Laymatiya maccasi xeellidi aggonna ayfey entaw de7ees; qassi nagara ootheysa aggokona. Ammanon minniboonna asaa cimmoosona. Entaw ubba wode amotiya wozani de7ees; enti baadetidaysata. <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />Enti suure oge aggidi, makalla miishe siiqidi balida, Bi7oora na7aa Balaama ogiya kaallidosona.<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="NUM 22:4-35">Taybo 22:4-35</ref>.</char></note> <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />I ba nagara gaason hanqetis; dooni bayna harey asada haasayidi nabiya gooshshatethaa teqis.<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />He asati melida pultota melanne carkoy tookidi efiya shaara mela; enta naagey sakana dhumaa. <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />Enti hadanne otoro oda odetishe balan de7iya asaa giddofe kessi ekidi buroo minniboonna asata laymatetha asho amon cimmidi balethoosona. <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />Enti bantaw dhayo aylletethan de7ishe haratako, “Hinte aylletethafe keyana” yaagosona. Ayis giiko, asi ba xoonetidaba ubbaas aylle. <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />Enti ashshiya nu Godaa Yesuus Kiristoosa eridi ha alamiya tunatethaafe kessi ekidaape guye, zaari qaxetidi xoonetiko kase de7iya de7uwape guyeysi entaw iita gidana. <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />Enti xillotetha ogiya eri simmidi aggeysafe koyrottidi geeshsha kiitta eronnaako entaw lo77oshin. <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />“Kani ba cooshshaako guye simmees” qassi, “Meecetida gudunthoy guye simmidi urqan gondoretees” giya leemisoy tuma gideysi enta bolla oothees.<note caller="-" style="x"><char style="xo" closed="false">2:22 </char><char style="xt" closed="false"><ref loc="PRO 26:11">Leemi 26:11</ref>.</char></note><verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s1">Goday Yaana</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />Ta siiqo ishato, haysi ta hintew xaafida dabdaabey nam7antho. Taani ha nam7u dabdaabetaka hintew xaafiday, hinte suure qofaa qopanaada hintena denthethanaasa. <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />Qassi geeshsha nabeti beni odida qaalanne nuna ashshiya Goday, hawaareta baggara kiitida kiitta hinte hassayana mela koyayis. <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" />Ubbaafe kasetidi, wode wursethan banta amuwa kaallidi ase toocheysati, toochishe yaanaysa erite.<note caller="-" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="JUD 1:18">Yihu 18</ref>.</char></note> <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />Enti, “Ta yaana gidaysi awun de7ii? Nu aawati hayqidosona, shin ubbabay sa7i medhetoosape doomidi de7eysada de7ees” yaagosona. <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />Daro wodepe kase saloy Xoossaa qaalan medhetidaysa; qassi sa7i haathafenne haathan medhetidaysa erishe kaddoosona.<note caller="-" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="GEN 1:6-9">Medhe 1:6-9</ref>.</char></note> <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />He wode de7iya sa7ay haathan mitetidi dhayis.<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 7:11">Medhe 7:11</ref>.</char></note> <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />Shin ha77i de7iya saloynne sa7i, geellati pirdetiya gallasaynne dhayiya gallasay gakanaw he qaalan tamas naagetidi de7oosona.<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />Shin ta siiqo ishato, ha issiba dogopite. Godaa matan issi gallasi mukulu laytha mela gideysanne mukulu laythi issi gallasa mela gideysa dogopite.<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="PSA 90:4">Maz 90:4</ref>.</char></note> <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />Issoti issoti gam7is gidi qopeysada, Goday ba ufaysa qaala gisho gam7enna. Shin oonika dhayonna mela koyidi, ubbay banta nagaraape simmana mela hinte gisho gidi gencees.<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />Shin Godaa gallasay kaysoda yaana. He gallasan saloti wolqaama guunthan dhayana; salo medhetethati taman xuugetana; sa7inne iya bolla de7iya ubbay dhayana.<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 24:43">Maato 24:43</ref>; <ref loc="LUK 12:39">Luqa 12:39</ref>; <ref loc="1TH 5:2">1 Tese 5:2</ref>; <ref loc="REV 16:15">Qon 16:15</ref>.</char></note> <verse eid="2PE 3:10" /><verse number="11" style="v" sid="2PE 3:11" />Hiza, ubbabay hessada hanida dhayiyaba gidiko hinte ay mela asi gidanaw bessii? Hinte geeshshinne Xoossaa daaniya de7o daanaw bessees. <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />Hinte sinthara yaa Xoossaa gallasaa naagishe hintew danda7etiyaba ubbaa oothidi he gallasaa eesoyite. He gallas salotinne iyan de7iyabay taman xuugetana; wolqaama suulan til7ana. <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" />Shin nuuni xillotethi haariya ooratha salonne ooratha sa7a Xoossaa ufaysa qaalada naagoos.<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="ISA 65:17">Isa 65:17</ref>; <ref loc="ISA 66:22">66:22</ref>; <ref loc="REV 21:1">Qon 21:1</ref>.</char></note><verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />Hessa gisho, ta siiqo ishato, nu he gallasaa naagiya gisho pokoynne borey baynayisata gididi, Godaara saron daanaw minnite. <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />Asi ubbay attana mela koyidi Goday danda7eysa dogopite. Qassi nu siiqo ishay, Phawuloosi, Xoossay iyaw immida cincatethan hessada hintew xaafis. <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />I ba dabdaabeta ubban hessataba xaafis. Iya dabdaabeta giddon akeekanaw waaysiya qofati de7oosona. Tamaariboonnanne minniboonna asati hara Xoossaa qaala mirqeysada ha kiitataka dhayanaw machidi mirqoosona.<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />Hessa gisho, ta siiqo ishato, hinte hessa eriya gisho makallata balan cimetidi, dhayonna melanne minnidi de7iya bessaafe kundonna mela naagetite. <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />Shin hinte nuna ashshiya nu Godaa, Yesuus Kiristoosa aadho keehatethaaninne eratethan diccite. Iyaw ha77ika merinawuka bonchoy gido. Amin7i.<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>