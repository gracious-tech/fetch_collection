<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PRO" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Leemiso Maxaafa</para>
  <para style="toc1">Leemiso Maxaafa</para>
  <para style="toc3">Leemi</para>
  <para style="toc2">Leemiso</para>
  <para style="mt1">Leemiso Maxaafa</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Leemiso Maxaafay haysenne Leemiso odan giigida, duussa woganne ammano timirte. Ha maxaafape daro baggay gallas gallas ase gakiya hanotata odees. Maxaafay koyro doomishe, “Xoossas yashatethi cincatethas koyro” (<char style="xt"><ref loc="PRO 1:7">1:7</ref></char>) yaagis. Ha maxaafay tamaarsey, ammano wogan asi oothanaba xalaala gidonashin, asi ba gallasa duussan hananaw bessiya lo77o kanduwanne oothanaw bessiya lo77o ooso gujidi tamaarsees.</para>
  <para style="ip">Leemiso maxaafatape baggay asa buzo de7oba odees; baggay issi soo asa duussaba odees; baggay oosobanne zal7eba odees. Leemiso maxaafay xoosse bonchiya asi “Cinca” gidi, Xoosse eronna asi “Eeya” gees. Leemiso maxaafay ashketethaba, cincatethaba, danda7aba qadhebaanne ammanetethaba daro timirte tamaarsees.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Leemisota go77a <char style="ior">(<ref loc="PRO 1:1-9:18">1:1—9:18</ref>)</char></para>
  <para style="io1">Solomone leemisota <char style="ior">(<ref loc="PRO 10:1-24:34">10:1—24:34</ref>)</char></para>
  <para style="io1">Dumma dumma leemisota <char style="ior">(<ref loc="PRO 25:1-29:27">25:1—29:27</ref>)</char></para>
  <para style="io1">Agura leemisota <char style="ior">(<ref loc="PRO 30:1-33">30:1-33</ref>)</char></para>
  <para style="io1">Limu7eela aaye timirte <char style="ior">(<ref loc="PRO 31:1-31">31:1-31</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="PRO 1" />
  <para style="s1">Leemiso Go77a</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 1:1" />Haysati Isra7eele kawa Dawita na7aa Solomone leemisota. <verse eid="PRO 1:1" /><verse number="2" style="v" sid="PRO 1:2" />Leemisoti asay cincatethi, seeranne era haasaya akeekanaw maaddoosona. <verse eid="PRO 1:2" /><verse number="3" style="v" sid="PRO 1:3" />Enti cincatethi, xillotethi, suure pirdinne suure wozani daana mela tamaarsoosona. <verse eid="PRO 1:3" /><verse number="4" style="v" sid="PRO 1:4" />Eeyatas akeeka immees; na7atethatas eratethinne kahaamatethi immees. <verse eid="PRO 1:4" /><verse number="5" style="v" sid="PRO 1:5" />Cincati ha leemisota si7idi, era gujoosona; akeekanchoti lo77o zore ekoosona. <verse eid="PRO 1:5" /><verse number="6" style="v" sid="PRO 1:6" />Hessan leemisotanne enta birshethaa, cincatetha odaanne enta qan7isheta akeekanaw danda7etees.<verse eid="PRO 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 1:7" />Godaas yashshi cincatethas doomethi; shin eeyati cincatethinne seera kadhoosona.<verse eid="PRO 1:7" /></para>
  <para style="s1">Cincatethi New Miishe Ootha</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 1:8" />Ta na7aw, ne aawa zoriya si7a;</para>
  <para style="q2" vid="PRO 1:8">ne aaye timirtiya kadhopa.<verse eid="PRO 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 1:9" />Hessi ne huuphiyas boncho kallacha;</para>
  <para style="q2" vid="PRO 1:9">ne qoodhiyas gozda gidana.<verse eid="PRO 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 1:10" />Ta na7aw, nena nagaranchoti</para>
  <para style="q2" vid="PRO 1:10">cimmiko ero goopa.<verse eid="PRO 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 1:11" />Enti, “Nuura yedha;</para>
  <para style="q2" vid="PRO 1:11">ase wodhanaw hokidi naagoos;</para>
  <para style="q2" vid="PRO 1:11">xillota wodhanaw qosetoos.<verse eid="PRO 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 1:12" />Si7ooley mitteysada nuka enta paxa mittoos;</para>
  <para style="q2" vid="PRO 1:12">nu enta ollan yegetiya asada oothana.<verse eid="PRO 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 1:13" />Nuuni al7o miishe ubbaa demmana;</para>
  <para style="q2" vid="PRO 1:13">nu keethaa bonqe miishen kunthana.<verse eid="PRO 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 1:14" />Nuura laggeta;</para>
  <para style="q2" vid="PRO 1:14">nu demmidaba issife shaaketana” yaagana.<verse eid="PRO 1:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 1:15" />Ta na7aw, entara hemetofa;</para>
  <para style="q2" vid="PRO 1:15">enta ogiyara baanaw ne tohuwa denthofa.<verse eid="PRO 1:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 1:16" />Enti iitabaa oothanaw woxoosona;</para>
  <para style="q2" vid="PRO 1:16">asa suuthi gussanaw yaa haa goosona.<verse eid="PRO 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 1:17" />Kafoy xeellishin,</para>
  <para style="q2" vid="PRO 1:17">iya oykanaw gite yegethi maaddenna.<verse eid="PRO 1:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 1:18" />Shin enti banta suuthi gussanaw hokosona;</para>
  <para style="q2" vid="PRO 1:18">banta shempuwa wodhanaw qosetoosona.<verse eid="PRO 1:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 1:19" />Genen go77a demmiya asa wursethi hessa mela;</para>
  <para style="q2" vid="PRO 1:19">enti shiishida shaloy enta shempuwa ekees.<verse eid="PRO 1:19" /></para>
  <para style="s1">Cincatethi Xeegees</para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 1:20" />Cincatethi daggala bolla eqada xeegawusu;</para>
  <para style="q2" vid="PRO 1:20">dabaaban ba qaala dhoqu oothada sissawusu. <verse eid="PRO 1:20" /><verse number="21" style="v" sid="PRO 1:21" />Cincatethi asi shiiqiya bessan eqada xeegawusu;</para>
  <para style="q2" vid="PRO 1:21">katamaa geliya pengen eqada haysada yaagawusu.<verse eid="PRO 1:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 1:22" />“Hinteno, akeeki pacidaysato,</para>
  <para style="q2" vid="PRO 1:22">hinte awude gakanaw eeya gididi daanee?</para>
  <para style="q1" vid="PRO 1:22">Qelqiseysato, awude gakanaw ufaytanee?</para>
  <para style="q2" vid="PRO 1:22">Eeyato, awude gakanaw eratethi ixanee?<verse eid="PRO 1:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 1:23" />Ta seera hinte si7idaba gidiyako,</para>
  <para style="q2" vid="PRO 1:23">taani ta eraa hinte bolla gussana;</para>
  <para style="q2" vid="PRO 1:23">ta qaalaka hintena tamaarsana.<verse eid="PRO 1:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 1:24" />Shin ta xeegida wode hinte koyonna ixida gisho;</para>
  <para style="q2" vid="PRO 1:24">taani kushe miccin oonika akeekibona gisho;<verse eid="PRO 1:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 1:25" />Ta zoriya hinte kadhida gisho;</para>
  <para style="q2" vid="PRO 1:25">ta seeraka ekiboonna gisho;<verse eid="PRO 1:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 1:26" />Hintena metoy gakiya wode ta miicana;</para>
  <para style="q2" vid="PRO 1:26">hinte dagaman kokoriya wode ta qelqisana. <verse eid="PRO 1:26" /><verse number="27" style="v" sid="PRO 1:27" />Gadoy uushoda hinte bolla yaa wode,</para>
  <para style="q2" vid="PRO 1:27">metoy goteda hinte bolla eqiya wode,</para>
  <para style="q2" vid="PRO 1:27">un7inne waayey hinte bolla gakiya wode,</para>
  <para style="q2" vid="PRO 1:27">taani hintena qelqisana.<verse eid="PRO 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 1:28" />“He wode enti tana xeegana; shin ta koyke;</para>
  <para style="q2" vid="PRO 1:28">enti tana minthidi koyana; shin demmokona. <verse eid="PRO 1:28" /><verse number="29" style="v" sid="PRO 1:29" />Enti eratethi ixida gisho;</para>
  <para style="q2" vid="PRO 1:29">Godaa yashshi dooriboonna gisho, <verse eid="PRO 1:29" /><verse number="30" style="v" sid="PRO 1:30" />Ta zoriya ekiboonna gisho;</para>
  <para style="q2" vid="PRO 1:30">ta seera kadhida gisho; <verse eid="PRO 1:30" /><verse number="31" style="v" sid="PRO 1:31" />Enti banta oosuwa ayfiya maana;</para>
  <para style="q2" vid="PRO 1:31">banta qofaa ayfiya kallana. <verse eid="PRO 1:31" /><verse number="32" style="v" sid="PRO 1:32" />Akeeki pacidaysata cincatethafe haakeysi wodhees;</para>
  <para style="q2" vid="PRO 1:32">eeyata qelli guussi dhaysees. <verse eid="PRO 1:32" /><verse number="33" style="v" sid="PRO 1:33" />Shin ta odiyaba si7iya ubbay saro daana;</para>
  <para style="q2" vid="PRO 1:33">meto hirgafeka shempana.”<verse eid="PRO 1:33" /></para>
  <chapter eid="PRO 1" />
  <chapter number="2" style="c" sid="PRO 2" />
  <para style="s1">Cincatetha Go77a</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 2:1" />Ta na7aw, ta timirtiya ne ekiko;</para>
  <para style="q2" vid="PRO 2:1">ta kiitaa ne wozanan wothiko; <verse eid="PRO 2:1" /><verse number="2" style="v" sid="PRO 2:2" />ne haythaa cincatethako zaariko;</para>
  <para style="q2" vid="PRO 2:2">ne wozanaa akeekako zaariko;<verse eid="PRO 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 2:3" />Eratethi xeegiko;</para>
  <para style="q2" vid="PRO 2:3">akeeka dhoqu oothada xeegiko;<verse eid="PRO 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 2:4" />Bira woyko geemmida miishe koyeysada,</para>
  <para style="q2" vid="PRO 2:4">neeni eratethi koyko,<verse eid="PRO 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 2:5" />He wode neeni Godaas yashshi guussi aybeko erana;</para>
  <para style="q2" vid="PRO 2:5">Xoossaa loythada erana.<verse eid="PRO 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 2:6" />Goday cincatethi immees;</para>
  <para style="q2" vid="PRO 2:6">iyape eratethinne akeeki bentees.<verse eid="PRO 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 2:7" />I suuretas maaddiya zore minjees;</para>
  <para style="q2" vid="PRO 2:7">borey baynaysatas gondalle gidees.<verse eid="PRO 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 2:8" />Suure pirda ogiya naagees;</para>
  <para style="q2" vid="PRO 2:8">iyaw ammaneteyisata ogiya minthees.<verse eid="PRO 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 2:9" />He wode neeni xillotethi, suure pirdaa,</para>
  <para style="q2" vid="PRO 2:9">suure ogenne lo77o oosoy aybeko akeekana.<verse eid="PRO 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 2:10" />Cincatethi ne wozana giddo gelana;</para>
  <para style="q2" vid="PRO 2:10">eratethi new ufaysi gidana.<verse eid="PRO 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 2:11" />Shaakidi eroy nena naagana;</para>
  <para style="q2" vid="PRO 2:11">akeeki nena kammana.<verse eid="PRO 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 2:12" />Cincatethi nena iita asata ogiyape naagana;</para>
  <para style="q2" vid="PRO 2:12">geella odape nena ashshana.<verse eid="PRO 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 2:13" />Enti nagara dhuman daanaw,</para>
  <para style="q2" vid="PRO 2:13">xillotetha ogiya aggidosona.<verse eid="PRO 2:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 2:14" />Iita ooson ufaytoosona;</para>
  <para style="q2" vid="PRO 2:14">geellatethan hashshu goosona.<verse eid="PRO 2:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 2:15" />Enta oosoy mirqethi;</para>
  <para style="q2" vid="PRO 2:15">enta de7oy geella.<verse eid="PRO 2:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 2:16" />Cincatethi layma maccasape,</para>
  <para style="q2" vid="PRO 2:16">qaalan cimmiya laggethofe nena ashshana.<verse eid="PRO 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 2:17" />Iya ba na7atetha azina aggaagasu;</para>
  <para style="q2" vid="PRO 2:17">Xoossa sinthan caaqida caaquwa dogasu.<verse eid="PRO 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 2:18" />I soo ogey hayqoko gathees;</para>
  <para style="q2" vid="PRO 2:18">iiko buussi moytilletako gathees.<verse eid="PRO 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 2:19" />Iiko biya oonika guye simmenna;</para>
  <para style="q2" vid="PRO 2:19">de7o oge demmenna.<verse eid="PRO 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 2:20" />Hessa aggada, lo77o asata leemisuwa kaalla;</para>
  <para style="q2" vid="PRO 2:20">xillo asata hemethaa naaga.<verse eid="PRO 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 2:21" />Suure asatinne borey baynaysati,</para>
  <para style="q2" vid="PRO 2:21">biittan adussa laythi daana.<verse eid="PRO 2:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 2:22" />Shin iitati biittafe shodetana;</para>
  <para style="q2" vid="PRO 2:22">ammanetonaysati dhayana.<verse eid="PRO 2:22" /></para>
  <chapter eid="PRO 2" />
  <chapter number="3" style="c" sid="PRO 3" />
  <para style="s1">Godan Ammaneta</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 3:1" />Ta na7aw, ta timirtiya dogopa;</para>
  <para style="q2" vid="PRO 3:1">ta kiitaa ne wozanan wotha.<verse eid="PRO 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 3:2" />Enti ne laytha adussana;</para>
  <para style="q2" vid="PRO 3:2">injenne sarotethi new gujana.<verse eid="PRO 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 3:3" />Siiqoynne tumatethi neepe haakofo;</para>
  <para style="q2" vid="PRO 3:3">enta ne qoodhen qacha; ne wozanan xaafa.<verse eid="PRO 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 3:4" />Hessa oothiko ne Xoossanne asa sinthan</para>
  <para style="q2" vid="PRO 3:4">sabetananne nashetana.<verse eid="PRO 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 3:5" />Ne kumetha wozanan Godaa ammaneta;</para>
  <para style="q2" vid="PRO 3:5">ne akeekan zempofa.<verse eid="PRO 3:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 3:6" />Ne ooso ubban iya sinthaya;</para>
  <para style="q2" vid="PRO 3:6">I nena suure oge kaalethana.<verse eid="PRO 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 3:7" />Nena ne huuphen cinca oothofa;</para>
  <para style="q2" vid="PRO 3:7">Godaa yayya; iitape haaka.<verse eid="PRO 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 3:8" />Hessi ne asatethaas payyatethi ehana;</para>
  <para style="q2" vid="PRO 3:8">ne meqethaaka xaalisana.<verse eid="PRO 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 3:9" />Ne shaluwan Godaa boncha;</para>
  <para style="q2" vid="PRO 3:9">koyro ayfida kathaafe</para>
  <para style="q2" vid="PRO 3:9">bayraa immada iya boncha.<verse eid="PRO 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 3:10" />Hessa ne oothiko, ne shaaliyan kathi kumana;</para>
  <para style="q2" vid="PRO 3:10">ne daalloy woyne ushshan kumidi palahana.<verse eid="PRO 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 3:11" />Ta na7aw, Godaa seera kadhopa;</para>
  <para style="q2" vid="PRO 3:11">I nena seeriya wode lancofa.<verse eid="PRO 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 3:12" />Aaway ba dosiya na7a seereysada,</para>
  <para style="q2" vid="PRO 3:12">Goday ba dosiya uraa seerees.<verse eid="PRO 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 3:13" />Cincatethi demmeynne,</para>
  <para style="q2" vid="PRO 3:13">akeeka baw miishe oothiya uray anjetidaysa.<verse eid="PRO 3:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 3:14" />Cincatethi birape aadhidi go77ees;</para>
  <para style="q2" vid="PRO 3:14">worqafe aadhidi maaddees.<verse eid="PRO 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 3:15" />Cincatethi worqafe aadhidi al7o;</para>
  <para style="q2" vid="PRO 3:15">ne demmanaw amotiya ubbay cincatethara ginenna.<verse eid="PRO 3:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 3:16" />Cincatethi ushacha kushen adussa laythi,</para>
  <para style="q2" vid="PRO 3:16">haddirsa kushen duretethinne boncho oykasu.<verse eid="PRO 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 3:17" />I ogeti ufaysiya ogeta;</para>
  <para style="q2" vid="PRO 3:17">I horogay saro horoga.<verse eid="PRO 3:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 3:18" />Iya bana oykeysatas de7o mithi;</para>
  <para style="q2" vid="PRO 3:18">iyo minthidi oykiya ubbay anjetidaysata.<verse eid="PRO 3:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 3:19" />Goday ba cincatethan sa7aa medhis;</para>
  <para style="q2" vid="PRO 3:19">ba akeekan salota minthis.<verse eid="PRO 3:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 3:20" />Iya eratethan shaafati goggoosona;</para>
  <para style="q2" vid="PRO 3:20">shaaratape iri bukees.<verse eid="PRO 3:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 3:21" />Ta na7aw, suure pirdanne</para>
  <para style="q2" vid="PRO 3:21">shaakidi ero minthada oyka</para>
  <para style="q2" vid="PRO 3:21">enti neepe shaaketofo.<verse eid="PRO 3:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 3:22" />Enti new de7o gidana;</para>
  <para style="q2" vid="PRO 3:22">injenne ufaysi immana.<verse eid="PRO 3:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 3:23" />He wode ne hirgi bayna hemetana;</para>
  <para style="q2" vid="PRO 3:23">ne tohoy dhubetenna.<verse eid="PRO 3:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 3:24" />Neeni zin7iya wode yayyaka;</para>
  <para style="q2" vid="PRO 3:24">qamma kumethi mal7o dhisko dhiskana.<verse eid="PRO 3:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 3:25" />Akeekona gakiya gados yayyaka;</para>
  <para style="q2" vid="PRO 3:25">iitati dhayiya dhayuwan dagammaka.<verse eid="PRO 3:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 3:26" />Goday new zempo gidana;</para>
  <para style="q2" vid="PRO 3:26">ne tohoy xihen oyketonnaada I naagana.<verse eid="PRO 3:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 3:27" />New wolqi de7ishin,</para>
  <para style="q2" vid="PRO 3:27">metootida uraas lo77oba ooso aggofa.<verse eid="PRO 3:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 3:28" />Ha77i maaddanaw danda7ashe ne shooruwa,</para>
  <para style="q2" vid="PRO 3:28">“Simmada ya; ta new wonto immana” yaagopa. <verse eid="PRO 3:28" /><verse number="29" style="v" sid="PRO 3:29" />Nena ammanetidi, ne matan de7iya,</para>
  <para style="q2" vid="PRO 3:29">ne shooruwa bolla gene oothofa.<verse eid="PRO 3:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 3:30" />Nena qohonna de7ishin,</para>
  <para style="q2" vid="PRO 3:30">ase coo mootopa.<verse eid="PRO 3:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 3:31" />Gene oothiya asata qanaatopa;</para>
  <para style="q2" vid="PRO 3:31">enta iita oosuwa kaallofa.<verse eid="PRO 3:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 3:32" />Goday iita oothiya asata ixees;</para>
  <para style="q2" vid="PRO 3:32">shin suureta dosees.<verse eid="PRO 3:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 3:33" />Goday iita oothiya asaa keethaa baaddees;</para>
  <para style="q2" vid="PRO 3:33">shin suureba oothiya asaa keethaa anjees.<verse eid="PRO 3:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 3:34" />Otoron qelqiseyisata Goday qelqisees;</para>
  <para style="q2" vid="PRO 3:34">shin bantana kawusheyisata sabbees.<verse eid="PRO 3:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 3:35" />Cincati boncho demmana;</para>
  <para style="q2" vid="PRO 3:35">shin eeyati kawuyana.<verse eid="PRO 3:35" /></para>
  <chapter eid="PRO 3" />
  <chapter number="4" style="c" sid="PRO 4" />
  <para style="s1">Cincatethi Ubbaafe Bolla</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 4:1" />Ta nayto, hinte aawa zoriya si7ite;</para>
  <para style="q2" vid="PRO 4:1">loythi si7ite; hinte akeeka demmana.<verse eid="PRO 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 4:2" />Ta hintew lo77o timirte immiya gisho,</para>
  <para style="q2" vid="PRO 4:2">ta timirtiya kadhopite.<verse eid="PRO 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 4:3" />Taka ta aawas na7a;</para>
  <para style="q2" vid="PRO 4:3">ta aayes iya dosiya issi na7a.<verse eid="PRO 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 4:4" />Ta aaway tana haysada yaagidi tamaarsis;</para>
  <para style="q2" vid="PRO 4:4">“Ta oday new gelo; ta kiita naaga;</para>
  <para style="q2" vid="PRO 4:4">neeni hessa oothiko de7on daana.<verse eid="PRO 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 4:5" />Cincatethinne akeeka demmanaw minna;</para>
  <para style="q2" vid="PRO 4:5">ta new odiyaba dogopa; iyape kare keyopa.<verse eid="PRO 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 4:6" />Cincatethas zoko zaaropa; iya nena ashshana;</para>
  <para style="q2" vid="PRO 4:6">iyo dosa; iya nena naagana.<verse eid="PRO 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 4:7" />Cincatethi aadhiya gisho iyo demma;</para>
  <para style="q2" vid="PRO 4:7">new de7iyaba wursidi ekikoka akeeka demma.<verse eid="PRO 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 4:8" />Ne iyo boncha;</para>
  <para style="q2" vid="PRO 4:8">iya nena dhoqu dhoqu oothana;</para>
  <para style="q2" vid="PRO 4:8">ne iyo oykiko, iya nena bonchana.<verse eid="PRO 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 4:9" />Iya ne huuphiyas saba gidana;</para>
  <para style="q2" vid="PRO 4:9">boncho kallacha immana” yaagis.<verse eid="PRO 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 4:10" />Ta na7aw, si7a; ta odeysa eka;</para>
  <para style="q2" vid="PRO 4:10">ne laythay aduqana.<verse eid="PRO 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 4:11" />Taani nena cincatetha oge kaalethana;</para>
  <para style="q2" vid="PRO 4:11">suure horoga bessaana.<verse eid="PRO 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 4:12" />Ne hemetiya wode dhubiyabay deenna;</para>
  <para style="q2" vid="PRO 4:12">woxiyakoka dhubetaka.<verse eid="PRO 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 4:13" />Ta timirtiya loytha naaga; yeddofa;</para>
  <para style="q2" vid="PRO 4:13">timirtey new de7o immiya gisho loytha naaga.<verse eid="PRO 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 4:14" />Nagaranchota ogiyara boopa;</para>
  <para style="q2" vid="PRO 4:14">iita asata ogiyan hemetofa.<verse eid="PRO 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 4:15" />Iyape haaka; iyan hemetofa;</para>
  <para style="q2" vid="PRO 4:15">guye simma; ne ogiyan ba.<verse eid="PRO 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 4:16" />Enti iitaba oothonna de7ishin dhiskoy ekenna;</para>
  <para style="q2" vid="PRO 4:16">enti ase dhubbonna de7ishin dhiskoy efenna.<verse eid="PRO 4:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 4:17" />Enti nagara kathada moosona;</para>
  <para style="q2" vid="PRO 4:17">geellatethi ushshada uyoosona.<verse eid="PRO 4:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 4:18" />Xillota ogey seeta gallas gakanaw,</para>
  <para style="q2" vid="PRO 4:18">guji guji poo7iya wonta xalqe mela.<verse eid="PRO 4:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 4:19" />Shin geellata ogey sakana dhuma mela;</para>
  <para style="q2" vid="PRO 4:19">enti aybin dhubetiyakoka erokona.<verse eid="PRO 4:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 4:20" />Ta na7aw, ta odeysa si7a;</para>
  <para style="q2" vid="PRO 4:20">ne haythaa taako zaara.<verse eid="PRO 4:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 4:21" />Ne ayfiya sinthafe haassofa;</para>
  <para style="q2" vid="PRO 4:21">ne wozanan naaga.<verse eid="PRO 4:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 4:22" />Enta demmiya ubbaas enti de7o;</para>
  <para style="q2" vid="PRO 4:22">enti asatethas payyatethi immoosona.<verse eid="PRO 4:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 4:23" />De7oy iyape pultiya gisho,</para>
  <para style="q2" vid="PRO 4:23">ubbaafe aathada ne wozanaa minthada naaga.<verse eid="PRO 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 4:24" />Ne doonape iita haasaya digga;</para>
  <para style="q2" vid="PRO 4:24">wordo haasaya ne matape haassa.<verse eid="PRO 4:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 4:25" />Sitti gada sinthe xeella;</para>
  <para style="q2" vid="PRO 4:25">ne ayfey ne sinthan de7iyaba</para>
  <para style="q2" vid="PRO 4:25">tishshi oothidi xeello.<verse eid="PRO 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 4:26" />Ne tohuwa ogiya giigisa;</para>
  <para style="q2" vid="PRO 4:26">suure oge xalaalan hemeta.<verse eid="PRO 4:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 4:27" />Suure ogepe ushachi haddirsi goopa;</para>
  <para style="q2" vid="PRO 4:27">ne tohoy iita oge boonnada naaga.<verse eid="PRO 4:27" /></para>
  <chapter eid="PRO 4" />
  <chapter number="5" style="c" sid="PRO 5" />
  <para style="s1">Laymatethafe Haaka</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 5:1" />Ta na7aw, ta cincatetha hayza si7a;</para>
  <para style="q2" vid="PRO 5:1">ne haythaa ta timirtiyako zaara.<verse eid="PRO 5:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 5:2" />Hessi nena wozanaama oothana;</para>
  <para style="q2" vid="PRO 5:2">ne oday ne eratethaa qoncisana.<verse eid="PRO 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 5:3" />Layma maccasa inxarsafe ililo eessi xokees;</para>
  <para style="q2" vid="PRO 5:3">I oday oysape aadhidi looxikees.<verse eid="PRO 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 5:4" />Shin wursethan iya godare uthada cammawusu;</para>
  <para style="q2" vid="PRO 5:4">nam7u baggara qanxiya mashshada qara.<verse eid="PRO 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 5:5" />I tohoy hayqoko bees;</para>
  <para style="q2" vid="PRO 5:5">I tangoy duufo gathees.<verse eid="PRO 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 5:6" />Iya de7o oge qopuku; I ogey geella;</para>
  <para style="q2" vid="PRO 5:6">shin geella gideysa iya eruku.<verse eid="PRO 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 5:7" />Ta na7aw, tana si7a;</para>
  <para style="q2" vid="PRO 5:7">ta odeysafe keyopa.<verse eid="PRO 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 5:8" />Layma maccasa heera boopite;</para>
  <para style="q2" vid="PRO 5:8">I keetha pengiyako shiiqopite.<verse eid="PRO 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 5:9" />Hessi hanonna ixiko hinte bonchuwa harati ekana;</para>
  <para style="q2" vid="PRO 5:9">na7atethan wozana mino asa kushen hinte hayqana.<verse eid="PRO 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 5:10" />Hinte aquwa allagati ekana;</para>
  <para style="q2" vid="PRO 5:10">hinte daaburadi shiishidabay hara asas gidana.<verse eid="PRO 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 5:11" />Wursethan hinte ashoynne</para>
  <para style="q2" vid="PRO 5:11">hinte asatethay wurin hinte yeekana.<verse eid="PRO 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 5:12" />Hinte yaagana; “Ta ayis timirte ixadina?</para>
  <para style="q2" vid="PRO 5:12">Ta wozanay seera ayis kadhidee?<verse eid="PRO 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 5:13" />Taani ta astamaareta si7abike;</para>
  <para style="q2" vid="PRO 5:13">tana zoreyisata zoriya ekabike.<verse eid="PRO 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 5:14" />Hesaa gisho, ta asay shiiqida shiiquwan,</para>
  <para style="q2" vid="PRO 5:14">kawuyanaw matas” yaagana.<verse eid="PRO 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 5:15" />Neeni ne pultuwafe haathe uya;</para>
  <para style="q2" vid="PRO 5:15">ne mache xalaala siiqa.<verse eid="PRO 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 5:16" />Ne pultuwa dabaaban,</para>
  <para style="q2" vid="PRO 5:16">ne olla haatha denban ayis gussay?<verse eid="PRO 5:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 5:17" />Enta new buzo ootha;</para>
  <para style="q2" vid="PRO 5:17">hara allaga uraara koxofa.<verse eid="PRO 5:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 5:18" />Ne pultoy new anjeto;</para>
  <para style="q2" vid="PRO 5:18">ne na7atetha machera ufayta.<verse eid="PRO 5:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 5:19" />Lo77iya gaaredaninne ufaysiya gen7eda</para>
  <para style="q2" vid="PRO 5:19">I dhanthay ubba wode nena alo;</para>
  <para style="q2" vid="PRO 5:19">ubba wode I siiqoy nena di77o.<verse eid="PRO 5:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 5:20" />Ta na7aw, layma maccasan ayis di7etay?</para>
  <para style="q2" vid="PRO 5:20">Hara asa macho ayis qoommay?<verse eid="PRO 5:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 5:21" />Asi oothiyaba ubbaa Goday be7ees;</para>
  <para style="q2" vid="PRO 5:21">I hemetiya horoga ubbaa xeellees.<verse eid="PRO 5:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 5:22" />Nagaranchuwa I oothida nagaray oykees;</para>
  <para style="q2" vid="PRO 5:22">Iya nagaraa gitey iya qachees.<verse eid="PRO 5:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 5:23" />I ba eeyatethan dhayis;</para>
  <para style="q2" vid="PRO 5:23">bana naagiboonna gisho hayqis.<verse eid="PRO 5:23" /></para>
  <chapter eid="PRO 5" />
  <chapter number="6" style="c" sid="PRO 6" />
  <para style="s1">Eeyatethafe Haaka</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 6:1" />Ta na7aw, miishe tal7ida ne shooruwas waase gelidaba gidiko,</para>
  <para style="q2" vid="PRO 6:1">hara asas kushe baqada caaqidaba gidiko,<verse eid="PRO 6:1" /></para>
  <para style="q2">
    <verse number="2" style="v" sid="PRO 6:2" />ne caaqida ne caaquwan xihen gelidaba gidiko,</para>
  <para style="q2" vid="PRO 6:2">ne doonape keyida qaalan oyketidaba gidiko,<verse eid="PRO 6:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 6:3" />hiza ne shooruwa kushen geladasa.</para>
  <para style="q1" vid="PRO 6:3">Hessa gisho, ta na7aw, iyape keyanaw koyko,</para>
  <para style="q2" vid="PRO 6:3">ne shooruwa soo bada waasetetha</para>
  <para style="q2" vid="PRO 6:3">ne bollafe wothana mela aaddashada iya woossa.<verse eid="PRO 6:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 6:4" />Hessa oothonna de7ashe zin7ofa;</para>
  <para style="q2" vid="PRO 6:4">dhiskoyka nena ekofo.<verse eid="PRO 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 6:5" />Shankafe gen7ey kessi ekiyada,</para>
  <para style="q2" vid="PRO 6:5">gitepe kafoy attiyada nena ashsha.<verse eid="PRO 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 6:6" />Neno azallaw, zimadoko ba;</para>
  <para style="q2" vid="PRO 6:6">iyape cincatethi tamaara.<verse eid="PRO 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 6:7" />Zimaddota kiittey baawa,</para>
  <para style="q2" vid="PRO 6:7">halaqi woyko enta haarey baawa.<verse eid="PRO 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 6:8" />Shin bantaw maanaba bone minjoosona;</para>
  <para style="q2" vid="PRO 6:8">kathi cakiya wode bantaw koshshiya kathaa shiishosona.<verse eid="PRO 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 6:9" />Neno azallaw, ne awude gakanaw dhiskay?</para>
  <para style="q2" vid="PRO 6:9">Ne dhiskofe awude barkanee?<verse eid="PRO 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 6:10" />Neeni “guuthu zin7ana; guuthu dhiskana;</para>
  <para style="q2" vid="PRO 6:10">kushe shiisha ekada guuthu shempana” yaagasa.<verse eid="PRO 6:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 6:11" />He wode manqotethi pangada,</para>
  <para style="q2" vid="PRO 6:11">paci ola miishe oykida asada ne bolla yaana.<verse eid="PRO 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 6:12" />Laafanne iita asi yuuyidi oda mirqees;<verse eid="PRO 6:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 6:13" />I ba ayfen qam7otees;</para>
  <para style="q2" vid="PRO 6:13">ba tohon bessees; ba biradhen mallees.<verse eid="PRO 6:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 6:14" />Iya ulon geellatethi de7ees; iitabaa qopees;</para>
  <para style="q2" vid="PRO 6:14">ubba wode ooshshu medhees.<verse eid="PRO 6:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 6:15" />Hessa gisho dhayoy akeekona iya bolla yaana;</para>
  <para style="q2" vid="PRO 6:15">I hassayonna meqana; zaaridi paxenna.<verse eid="PRO 6:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 6:16" />Goday ixiya usupun qommoti de7oosona;</para>
  <para style="q2" vid="PRO 6:16">I shaatetiya qommoti laapuna;<verse eid="PRO 6:16" /></para>
  <para style="q2">
    <verse number="17" style="v" sid="PRO 6:17" />kadhidi xeelliya ayfe,</para>
  <para style="q2" vid="PRO 6:17">wordotiya inxarsi,</para>
  <para style="q2" vid="PRO 6:17">xillo asata wodhiya kushe,<verse eid="PRO 6:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="PRO 6:18" />iitaba maqiya wozanaa,</para>
  <para style="q2" vid="PRO 6:18">iitabaako woxanaw eesotiya toho,<verse eid="PRO 6:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 6:19" />Wordo bolla wordo gujiya wordo marka,</para>
  <para style="q2" vid="PRO 6:19">ishata giddon ooshshi medhiya asi.<verse eid="PRO 6:19" /></para>
  <para style="s1">Laymatethafe Naageta</para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 6:20" />Ta na7aw, ne aawa kiita pola;</para>
  <para style="q2" vid="PRO 6:20">ne aaye timirtiya aggofa.<verse eid="PRO 6:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 6:21" />Enta ubba wode ne wozanan oyka;</para>
  <para style="q2" vid="PRO 6:21">ne qoodhiyan qacha.<verse eid="PRO 6:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 6:22" />Ne hemetiya wode enti nena kaalethana;</para>
  <para style="q2" vid="PRO 6:22">ne zin7iya wode, enti nena naagana;</para>
  <para style="q2" vid="PRO 6:22">ne barkiya wode enti nena zorana.<verse eid="PRO 6:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 6:23" />Godaa kiitay xompe; iya timirtey poo7o;</para>
  <para style="q2" vid="PRO 6:23">iya seeray de7oko efiya oge.<verse eid="PRO 6:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 6:24" />Ha timirteti iita maccafenne</para>
  <para style="q2" vid="PRO 6:24">hara cimmiya maccasa inxarsafe nena naagana.<verse eid="PRO 6:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 6:25" />I mala lo77otethay nena qadhethofo;</para>
  <para style="q2" vid="PRO 6:25">I qam7otoy nena di77ofo.<verse eid="PRO 6:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 6:26" />Issi addey guutha miishen layma maccas demmanaw danda7ees;</para>
  <para style="q2" vid="PRO 6:26">shin hara asa macho laggethoy shempo ekees.<verse eid="PRO 6:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 6:27" />Tama idimmin</para>
  <para style="q2" vid="PRO 6:27">iya ma7oy meetetonna attey de7ii?<verse eid="PRO 6:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 6:28" />Tama bonqo yedhin,</para>
  <para style="q2" vid="PRO 6:28">iya tohoy xuugetonna attey de7ii?<verse eid="PRO 6:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 6:29" />Asa macho laggethiya uray hessa mela;</para>
  <para style="q2" vid="PRO 6:29">iyo bochiya ubbay seerettonna attenna.<verse eid="PRO 6:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 6:30" />Kaysoy koshatidi maanaw kaysiko,</para>
  <para style="q2" vid="PRO 6:30">asi iya borenna.<verse eid="PRO 6:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 6:31" />Shin I oyketiyabaa gidiko,</para>
  <para style="q2" vid="PRO 6:31">laapun kushe qanxana;</para>
  <para style="q2" vid="PRO 6:31">ba son de7iya miishe ubbaa immana.<verse eid="PRO 6:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 6:32" />Shin maccasara laymatiya asi wozani bayna asi;</para>
  <para style="q2" vid="PRO 6:32">he uray ba shempuwa dhaysees.<verse eid="PRO 6:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 6:33" />Deshethinne kawushi iya qaada;</para>
  <para style="q2" vid="PRO 6:33">yeelli iyape qushetenna.<verse eid="PRO 6:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 6:34" />Qanaatey azinas yilo denthethees;</para>
  <para style="q2" vid="PRO 6:34">halo kessiya wode iw qadhetenna.<verse eid="PRO 6:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 6:35" />I ay acaka ekenna;</para>
  <para style="q2" vid="PRO 6:35">ay mela imotika iya hanquwa doshisenna.<verse eid="PRO 6:35" /></para>
  <chapter eid="PRO 6" />
  <chapter number="7" style="c" sid="PRO 7" />
  <para style="s1">Layma Maccasape Naageta</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 7:1" />Ta na7aw, ta qaala naaga;</para>
  <para style="q2" vid="PRO 7:1">ta kiitaa ne wozanan wotha.<verse eid="PRO 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 7:2" />De7on daanaw ta kiita ootha;</para>
  <para style="q2" vid="PRO 7:2">ta timirtiya ne ayfe na77eda naaga.<verse eid="PRO 7:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 7:3" />Ne kushen enta qacha;</para>
  <para style="q2" vid="PRO 7:3">ne wozanan enta xaafa.<verse eid="PRO 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 7:4" />Cincatethi ne michida,</para>
  <para style="q2" vid="PRO 7:4">akeeka ne mata dabboda xeella.<verse eid="PRO 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 7:5" />Enti nena layma maccasapenne</para>
  <para style="q2" vid="PRO 7:5">ba qaalan cimmiya hara maccasape naagana.<verse eid="PRO 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 7:6" />Issi gallas ta maskootera kare xeellas.<verse eid="PRO 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 7:7" />Eratethi pacida na7atethata be7as;</para>
  <para style="q2" vid="PRO 7:7">enta giddofe issoy daro eeya.<verse eid="PRO 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 7:8" />He na7atethay ogera bishe,</para>
  <para style="q2" vid="PRO 7:8">issi layma maccase keethaa matara aadhees;</para>
  <para style="q2" vid="PRO 7:8">I soo efiya ogiya simmidi I sooko bis.<verse eid="PRO 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 7:9" />He wode sa7i laadees.<verse eid="PRO 7:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 7:10" />Maccasiya iya demmasu;</para>
  <para style="q2" vid="PRO 7:10">iya layma gideysa I ma7oy erisees;</para>
  <para style="q2" vid="PRO 7:10">iya asa cimmanaw halchada keyasu.<verse eid="PRO 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 7:11" />Iya xaltaamanne yeelli bayna maccas;</para>
  <para style="q2" vid="PRO 7:11">son wopu gada uttuku.<verse eid="PRO 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 7:12" />Iya issi toho ogen, issi toho giyan,</para>
  <para style="q2" vid="PRO 7:12">issi toho dabaaban eqada naagawusu.<verse eid="PRO 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 7:13" />Iya he na7atetha qoommada yeerasu;</para>
  <para style="q2" vid="PRO 7:13">iya tishshi oothada xeellashe haysada yaagasu;<verse eid="PRO 7:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 7:14" />“Taani ta yarshuwa yarshada,</para>
  <para style="q2" vid="PRO 7:14">ta qangetha hachi gathas.<verse eid="PRO 7:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 7:15" />Yaatada nena mokanaw keyas;</para>
  <para style="q2" vid="PRO 7:15">nena daro koyas; hiza nena demmas.<verse eid="PRO 7:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 7:16" />Taani Gibxefe yida,</para>
  <para style="q2" vid="PRO 7:16">alleeqetida afila hiixas.<verse eid="PRO 7:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 7:17" />Taani ta hiixa,</para>
  <para style="q2" vid="PRO 7:17">karbefe, almunepenne qarafape,</para>
  <para style="q2" vid="PRO 7:17">oosetida shittuwa puukas.<verse eid="PRO 7:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 7:18" />Haaya; wontana gakanaw siiqo aloos;</para>
  <para style="q2" vid="PRO 7:18">qoometidi ufaytoos.<verse eid="PRO 7:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 7:19" />Ta azinay son deenna;</para>
  <para style="q2" vid="PRO 7:19">haaho biitta bis.<verse eid="PRO 7:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 7:20" />Miishe karxiita kunthidi bida gisho,</para>
  <para style="q2" vid="PRO 7:20">ageena kumonna soo simmenna” yaagasu.<verse eid="PRO 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 7:21" />Ba mal7o odan iya balethasu;</para>
  <para style="q2" vid="PRO 7:21">ba liiqo inxarsan iya cimmasu.<verse eid="PRO 7:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 7:22" />Boori shukettanaw beysada,</para>
  <para style="q2" vid="PRO 7:22">gaari eesotidi xihen geleysada,</para>
  <para style="q2" vid="PRO 7:22">I iyo kaallidi bis.<verse eid="PRO 7:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 7:23" />Toori iya wozanaa caddidaada hanis;</para>
  <para style="q2" vid="PRO 7:23">gite giddo gelida kafo daanis;</para>
  <para style="q2" vid="PRO 7:23">hessi ubbay iya shempuwa dhaysanaw haneysa eribeenna.<verse eid="PRO 7:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 7:24" />Hiza ta na7aw, tana si7a;</para>
  <para style="q2" vid="PRO 7:24">ta doonape keyiya qaala hayza.<verse eid="PRO 7:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="PRO 7:25" />Ne wozanay maccasa geedo boopo;</para>
  <para style="q2" vid="PRO 7:25">I ogiyan gelada dhayopa.<verse eid="PRO 7:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 7:26" />Iya cadda yeggidaysati daro;</para>
  <para style="q2" vid="PRO 7:26">iya wodhidaysati guutha gidokona.<verse eid="PRO 7:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 7:27" />I soy duufoko efiya oge;</para>
  <para style="q2" vid="PRO 7:27">hayqoko kaalethiya horoga.<verse eid="PRO 7:27" /></para>
  <chapter eid="PRO 7" />
  <chapter number="8" style="c" sid="PRO 8" />
  <para style="s1">Cincatetha Oge</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 8:1" />Cincatethi xeegawusu; si7ite;</para>
  <para style="q2" vid="PRO 8:1">akeeki ba qaala dhoqu oothida sissawusu.<verse eid="PRO 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 8:2" />Oge doonan de7iya zumata bollanne</para>
  <para style="q2" vid="PRO 8:2">daggala ogiyan iya eqawusu.<verse eid="PRO 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 8:3" />Dirsa penge matan, katamaa geliya pengen eqada,</para>
  <para style="q2" vid="PRO 8:3">ba qaala dhoqu oothada haysada yaagawusu.<verse eid="PRO 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 8:4" />Asaw, ta hintena xeegayis;</para>
  <para style="q2" vid="PRO 8:4">asa koche ubbaa xeegayis.<verse eid="PRO 8:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 8:5" />Hinteno eratethi baynaysato eratethi tamaarite;</para>
  <para style="q2" vid="PRO 8:5">hinteno eeyato, akeeka demmite.<verse eid="PRO 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 8:6" />Taani lo77oba odiya gisho si7ite;</para>
  <para style="q2" vid="PRO 8:6">taani doonape suurebay keyees.<verse eid="PRO 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 8:7" />Taani tuma odetayis;</para>
  <para style="q2" vid="PRO 8:7">wordoy ta matan ixetidaba.<verse eid="PRO 8:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 8:8" />Ta oday tuma;</para>
  <para style="q2" vid="PRO 8:8">geella woyko mirqethi gidenna.<verse eid="PRO 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 8:9" />Akeeki de7iya uraas ta oday like;</para>
  <para style="q2" vid="PRO 8:9">eri de7iya uraas ta oday qonce.<verse eid="PRO 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 8:10" />Birape aathidi ta zoriya doorite;</para>
  <para style="q2" vid="PRO 8:10">geeshsha worqafe aathidi eratethi doorite.<verse eid="PRO 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 8:11" />Cincatethi zo7o al7o shuchafe aadhees;</para>
  <para style="q2" vid="PRO 8:11">ne amotiya ubbay iira liketenna.<verse eid="PRO 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 8:12" />Taw, cincatethas akeeki de7ees;</para>
  <para style="q2" vid="PRO 8:12">eratethinne shaakidi eroy tabaa.<verse eid="PRO 8:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 8:13" />Godaas yashshi iitatethi ixo;</para>
  <para style="q2" vid="PRO 8:13">taani otoronne ceeqetethi ixayis;</para>
  <para style="q2" vid="PRO 8:13">iita ogenne wordo oda dosike.<verse eid="PRO 8:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 8:14" />Zoreynne lo77o eray tabaa;</para>
  <para style="q2" vid="PRO 8:14">akeekinne wolqi taw de7ees.<verse eid="PRO 8:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 8:15" />Kawoti ta baggara kawotoosona;</para>
  <para style="q2" vid="PRO 8:15">haareysati suure higge ta baggara kessoosona.<verse eid="PRO 8:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 8:16" />Halaqati ta maaddin deriya haaroosona;</para>
  <para style="q2" vid="PRO 8:16">biitta aysiya gita asata ta maaddayis.<verse eid="PRO 8:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 8:17" />Tana doseyisata ta dosayis;</para>
  <para style="q2" vid="PRO 8:17">tana minthidi koyeysati demmana.<verse eid="PRO 8:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 8:18" />Duretethinne bonchoy taara de7oosona;</para>
  <para style="q2" vid="PRO 8:18">wuronna shaloynne injey ta matana.<verse eid="PRO 8:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 8:19" />Hinte taape demmiya go77ay,</para>
  <para style="q2" vid="PRO 8:19">geeshsha worqafenne birape aadhees.<verse eid="PRO 8:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 8:20" />Ta xillotetha ogen hemetayis;</para>
  <para style="q2" vid="PRO 8:20">suure pirda ogiyara kanthayis.<verse eid="PRO 8:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 8:21" />Tana doseysatas ta shalo immana;</para>
  <para style="q2" vid="PRO 8:21">enta keethaa duretethan kunthana.<verse eid="PRO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 8:22" />“Goday tana ubbaafe koyro medhis;</para>
  <para style="q2" vid="PRO 8:22">benipeka iya oosuwas doomethay tana.<verse eid="PRO 8:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 8:23" />Alamey medhetanaape kase</para>
  <para style="q2" vid="PRO 8:23">taani shuumetas.<verse eid="PRO 8:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 8:24" />Abbay bayna wode, pultoti dhuuqonna</para>
  <para style="q2" vid="PRO 8:24">de7ishin ta yeletas.<verse eid="PRO 8:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 8:25" />Deretinne zumati medhetanaape</para>
  <para style="q2" vid="PRO 8:25">sinthe ta yeletas. <verse eid="PRO 8:25" /><verse number="26" style="v" sid="PRO 8:26" />Goday sa7aanne sa7an de7iya ubbaa medhanaape sinthe</para>
  <para style="q2" vid="PRO 8:26">woyko koyro kophe biittay oosetanaape sinthe ta yeletas.<verse eid="PRO 8:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 8:27" />Goday salota miccida wode,</para>
  <para style="q2" vid="PRO 8:27">abbatape bollara salo gufantho giigisida wode,</para>
  <para style="q2" vid="PRO 8:27">taani yan de7ayis.<verse eid="PRO 8:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 8:28" />Goday shaarata bollara wothida wode,</para>
  <para style="q2" vid="PRO 8:28">abba pultota dhuusida wode,<verse eid="PRO 8:28" /></para>
  <para style="q2">
    <verse number="29" style="v" sid="PRO 8:29" />abba haathati imetida zawape pinnidi, bolla aadhonada,</para>
  <para style="q2" vid="PRO 8:29">I enta kiitida wode sa7aa baasuwa minthida wode,</para>
  <para style="q2" vid="PRO 8:29">taani yan de7ayis.<verse eid="PRO 8:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 8:30" />He wode ta iya matan waanna oosancho;</para>
  <para style="q2" vid="PRO 8:30">ubba wode ta iya ufaysayis;</para>
  <para style="q2" vid="PRO 8:30">tawuka iya sinthan ufaytayis.<verse eid="PRO 8:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 8:31" />I medhida alamiyan ufaytayis;</para>
  <para style="q2" vid="PRO 8:31">asa naytika tana ufaysoosona.<verse eid="PRO 8:31" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="32" style="v" sid="PRO 8:32" />“Hiza ta nayto, si7ite;</para>
  <para style="q2" vid="PRO 8:32">ta odeysada ootheysati anjetidaysata.<verse eid="PRO 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 8:33" />Ta timirtiya si7ite; cinca gidite;</para>
  <para style="q2" vid="PRO 8:33">si7idaba dogopite.<verse eid="PRO 8:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 8:34" />Taani odidaba si7iya uray,</para>
  <para style="q2" vid="PRO 8:34">gallas gallas ta pengiyan bentiya uray,</para>
  <para style="q2" vid="PRO 8:34">ta pengiyan naagiya uray anjetidaysa.<verse eid="PRO 8:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 8:35" />Tana demmiday de7o demmees;</para>
  <para style="q2" vid="PRO 8:35">Godaape saba ekees.<verse eid="PRO 8:35" /></para>
  <para style="q1">
    <verse number="36" style="v" sid="PRO 8:36" />Shin tana demmonna uray bana qohees;</para>
  <para style="q2" vid="PRO 8:36">tana ixiya ubbay hayqo dosees.”<verse eid="PRO 8:36" /></para>
  <chapter eid="PRO 8" />
  <chapter number="9" style="c" sid="PRO 9" />
  <para style="s1">Cincatethi, Eratethinne Eeyatethi</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 9:1" />Cincatethi ba keethaa keexasu;</para>
  <para style="q2" vid="PRO 9:1">laapun tuussata ba keethaas essasu.<verse eid="PRO 9:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 9:2" />Iya ba giigisiya gibiras modho mehe shukasu;</para>
  <para style="q2" vid="PRO 9:2">woyne aggasu; gayta asaa sinthe aathasu.<verse eid="PRO 9:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 9:3" />Asaa xeeganaw ba aylleta kiittasu;</para>
  <para style="q2" vid="PRO 9:3">oosanchoti katamaa dhoqa bessan eqidi, <verse eid="PRO 9:3" /><verse number="4" style="v" sid="PRO 9:4" />Hinteno, eri pacidaysato haa gelite! Eeyatako haysada yaagasu. <verse eid="PRO 9:4" /><verse number="5" style="v" sid="PRO 9:5" />“Haa yiite; ta kathaa miite;</para>
  <para style="q2" vid="PRO 9:5">ta aggida woyniya uyite. <verse eid="PRO 9:5" /><verse number="6" style="v" sid="PRO 9:6" />Hinte eeyatethi aggidi de7on de7ite;</para>
  <para style="q2" vid="PRO 9:6">akeekidi hemetite” yaagasu.<verse eid="PRO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 9:7" />Qelqisiya uraa seeriya asi cashshe ekees;</para>
  <para style="q2" vid="PRO 9:7">iita uraa zoriya asi baw qohetees.<verse eid="PRO 9:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 9:8" />Qelqisiya uraa zoropa; I nena ixana;</para>
  <para style="q2" vid="PRO 9:8">cinca uraa zora; I nena dosana. <verse eid="PRO 9:8" /><verse number="9" style="v" sid="PRO 9:9" />Cincatethi uraa tamaarsa; I cinca gidana;</para>
  <para style="q2" vid="PRO 9:9">Xillo uraa tamaarsa; I era gujana.<verse eid="PRO 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 9:10" />Godaas yashshi cincatethas doomethi, Geeshsha Godaa eroy akeeka.<verse eid="PRO 9:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 9:11" />Ta gaason ne laythay darana;</para>
  <para style="q2" vid="PRO 9:11">ne de7o laythay aduqana.<verse eid="PRO 9:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 9:12" />Ne cinca gidiko, go7etey nena;</para>
  <para style="q2" vid="PRO 9:12">Ne qelqisiya asi gidiko nena qohaasa.<verse eid="PRO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 9:13" />Eeyo maccasi waaso darawusu;</para>
  <para style="q2" vid="PRO 9:13">iw yeelli baawa; iya aykoka eruku.<verse eid="PRO 9:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 9:14" />Iya ba karen woyko katamaa dhoqa bessan uttawusu. <verse eid="PRO 9:14" /><verse number="15" style="v" sid="PRO 9:15" />Banta ogiya biya asaa xeegada, <verse eid="PRO 9:15" /><verse number="16" style="v" sid="PRO 9:16" />“Hinteno, eri pacidaysato</para>
  <para style="q2" vid="PRO 9:16">taako haa yiite” yaagasu. Eri baynaysatako, <verse eid="PRO 9:16" /><verse number="17" style="v" sid="PRO 9:17" />“Kaysidi uyaa haathi mal7ees;</para>
  <para style="q2" vid="PRO 9:17">geeman miya kathi lo77ees” yaagasu.<verse eid="PRO 9:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 9:18" />Shin hayqida asay yan de7eysa,</para>
  <para style="q2" vid="PRO 9:18">I imathatika duufon de7eysa I erenna.<verse eid="PRO 9:18" /></para>
  <chapter eid="PRO 9" />
  <chapter number="10" style="c" sid="PRO 10" />
  <para style="s1">Solomone Leemisota</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 10:1" />Haysati Solomone leemisota.</para>
  <para style="q1" vid="PRO 10:1">Cinca na7i ba aawa ufaysees;</para>
  <para style="q2" vid="PRO 10:1">shin eeya na7i ba aayiw azzanthees.<verse eid="PRO 10:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 10:2" />Nagaran demmida miishey go77enna;</para>
  <para style="q2" vid="PRO 10:2">shin xillotethi hayqope ashshees.<verse eid="PRO 10:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 10:3" />Goday xillota koshaysenna;</para>
  <para style="q2" vid="PRO 10:3">shin nagaranchota amuwa polisenna.<verse eid="PRO 10:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 10:4" />Azallatethi manqisees;</para>
  <para style="q2" vid="PRO 10:4">shin minnidi oosoy dureyees.<verse eid="PRO 10:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 10:5" />Cinca asi ba kathaa bone shiishees;</para>
  <para style="q2" vid="PRO 10:5">shin kathi cakiya wode dhiskiya asi kawuyees.<verse eid="PRO 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 10:6" />Xillo asi anjetees;</para>
  <para style="q2" vid="PRO 10:6">shin nagarancho asi</para>
  <para style="q2" vid="PRO 10:6">ba makallatethaa doonan genthees.<verse eid="PRO 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 10:7" />Xilluwa sunthay anjon xeegetishe de7ees;</para>
  <para style="q2" vid="PRO 10:7">shin nagaranchota sunthay elle dogetees.<verse eid="PRO 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 10:8" />Cinca asi kiittidaba oothees;</para>
  <para style="q2" vid="PRO 10:8">shin eeya asi dhayoko bees.<verse eid="PRO 10:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 10:9" />Suure asi saro de7ees;</para>
  <para style="q2" vid="PRO 10:9">shin geella asi ba gomen oyketees.<verse eid="PRO 10:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 10:10" />Gene ayfen qam7otiya asi meto ehees;</para>
  <para style="q2" vid="PRO 10:10">shin yayyonna seeriya asi sarotethi medhees.<verse eid="PRO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 10:11" />Xillo asa odi de7o pulto;</para>
  <para style="q2" vid="PRO 10:11">shin nagarancho asa odi makalla genthees.<verse eid="PRO 10:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 10:12" />Ixoy palama denthethees;</para>
  <para style="q2" vid="PRO 10:12">shin siiqoy bala ubbaa kammees.<verse eid="PRO 10:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 10:13" />Wozanaama asi cincatethan odees;</para>
  <para style="q2" vid="PRO 10:13">shin eeya asa zokoy xam7as attees.<verse eid="PRO 10:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 10:14" />Cincati eratethi dagayoosona;</para>
  <para style="q2" vid="PRO 10:14">shin eeyata doonay dhayo dafees.<verse eid="PRO 10:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 10:15" />Dure asa miishey diretida katamada naagees;</para>
  <para style="q2" vid="PRO 10:15">shin manqotethi manqota dhaysees.<verse eid="PRO 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 10:16" />Xillo asa oosoy iya de7o;</para>
  <para style="q2" vid="PRO 10:16">shin iita asa wursethay dhayo.<verse eid="PRO 10:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 10:17" />Seerin simmiya asi de7o ogen hemetees;</para>
  <para style="q2" vid="PRO 10:17">shin seerin ixiya asi balees.<verse eid="PRO 10:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 10:18" />Ixo kammiya asi wordancho;</para>
  <para style="q2" vid="PRO 10:18">zigirsi laaliya asi eeya.<verse eid="PRO 10:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 10:19" />Daro haasaya giddon nagari dhayenna;</para>
  <para style="q2" vid="PRO 10:19">shin ba doona shiishiya asi cinca.<verse eid="PRO 10:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 10:20" />Xillo asa inxarsi geeshsha bira mela;</para>
  <para style="q2" vid="PRO 10:20">shin iita asa wozani iitaban kumis.<verse eid="PRO 10:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 10:21" />Xillo asa odi daro asaa go77ees;</para>
  <para style="q2" vid="PRO 10:21">shin eeyati banta paca wozanan hayqoosona.<verse eid="PRO 10:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 10:22" />Godaa anjoy dure kessees;</para>
  <para style="q2" vid="PRO 10:22">he duretetha bolla meto gujenna.<verse eid="PRO 10:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 10:23" />Eeya uraas iitabaa oosoy kaassa mela;</para>
  <para style="q2" vid="PRO 10:23">shin wozanaama asi cincatethan ufaytees.<verse eid="PRO 10:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 10:24" />Iita asi hirgidabay iya bolla gakana;</para>
  <para style="q2" vid="PRO 10:24">shin xilloy amotidabay imetana.<verse eid="PRO 10:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 10:25" />Gotey aadhiya wode nagaranchoy bentenna;</para>
  <para style="q2" vid="PRO 10:25">shin xilloti merinaw minnidi daana.<verse eid="PRO 10:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 10:26" />Caalabay ache, cuyi ayfe qoheysada,</para>
  <para style="q2" vid="PRO 10:26">azalla asi kiittidaysa yiloyees. <verse eid="PRO 10:26" /><verse number="27" style="v" sid="PRO 10:27" />Godaas yashshi laythi adussees;</para>
  <para style="q2" vid="PRO 10:27">shin nagaranchota laythay qaammees.<verse eid="PRO 10:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 10:28" />Xillo asi ufaysi yaana gidi naagees;</para>
  <para style="q2" vid="PRO 10:28">shin nagaranchota ufaysay dhayana.<verse eid="PRO 10:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 10:29" />Godaa ogey xillotas baqatidi attiya besse;</para>
  <para style="q2" vid="PRO 10:29">shin iita oothiya asaas dhayo.<verse eid="PRO 10:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 10:30" />Xilloti ubba wode qaaxokona;</para>
  <para style="q2" vid="PRO 10:30">shin iitati biitta bolla dookona.<verse eid="PRO 10:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 10:31" />Xillo asi cincatethan odees;</para>
  <para style="q2" vid="PRO 10:31">shin geellaba odetiya inxarsi qanxetana<verse eid="PRO 10:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 10:32" />Xillo asa inxarsi bessiya haasaya erees;</para>
  <para style="q2" vid="PRO 10:32">shin iita asaa oday wobbe.<verse eid="PRO 10:32" /></para>
  <chapter eid="PRO 10" />
  <chapter number="11" style="c" sid="PRO 11" />
  <para style="q1">
    <verse number="1" style="v" sid="PRO 11:1" />Goday wordo mizaane ixees;</para>
  <para style="q2" vid="PRO 11:1">shin like mizaanen ufaytees.<verse eid="PRO 11:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 11:2" />Otoroy yaa wode kawushatethi yees;</para>
  <para style="q2" vid="PRO 11:2">shin ashketethan cincatethi yees.<verse eid="PRO 11:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 11:3" />Xillota enta suuretethay kaalethees;</para>
  <para style="q2" vid="PRO 11:3">shin iita asata enta geellatethay dhaysis.<verse eid="PRO 11:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 11:4" />Hanqo gallas duretethi go77enna;</para>
  <para style="q2" vid="PRO 11:4">shin xillotethi hayqope ashshees.<verse eid="PRO 11:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 11:5" />Borey bayna uraa ogiya xillotethay suurisees;</para>
  <para style="q2" vid="PRO 11:5">shin iita uray ba iitatethan kundees.<verse eid="PRO 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 11:6" />Suureta enta xillotethay ashshees; shin ammanetonayisata enta amoy xihe gididi oykana.<verse eid="PRO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 11:7" />Iita asi hayqiya wode, I naagiya ufaysay iyara issife hayqees; I ba wolqan ceeqetiyabay ubbayka dhayees.<verse eid="PRO 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 11:8" />Xilloy metope attees; iya gisho iitaa bolla metoy yees.<verse eid="PRO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 11:9" />Xoossaa kaddida asi ba doonan asa dhaysis; shin xilloti eran kessi ekoosona.<verse eid="PRO 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 11:10" />Xilloti bonchetiya wode, katamay ufaytees; qassi iitati hayqiya wode, hashshu gees.<verse eid="PRO 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 11:11" />Xillota anjuwa gaason katamay diccees; shin iita uraa odi katamaa dhaysis.<verse eid="PRO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 11:12" />Ba shooruwa kadhiya uraas wozani baawa; shin akeekancho uray si77i gees.<verse eid="PRO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 11:13" />Zigiriya asi xuuraa laallees; shin ammanetiya asi xuuraa genthees.<verse eid="PRO 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 11:14" />Kaalethiyabay dhayiko, kawotethay kundees; shin daro zoreysati de7iko, saroy de7ees.<verse eid="PRO 11:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 11:15" />Erenna uraas waase gidiya asi tumape metootana; hessafe waase gidonna ixeysi lo77o.<verse eid="PRO 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 11:16" />Ulo keeha maccasi bonchetawusu; shin iita asi duretetha xalaala duretees.<verse eid="PRO 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 11:17" />Keeha asi baw lo77oba oothees; shin wozana mino asi bana qohees.<verse eid="PRO 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 11:18" />Iita asi demmiya miishey cimo; shin xillotethaa zeriya uray tuma woyto cakana.<verse eid="PRO 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 11:19" />Xillotethan minnidi de7iya uray paxa de7ana; shin iitatethaa kaalliya uray hayqana.<verse eid="PRO 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 11:20" />Goday iita qofay de7iya asata ixees; shin suure hemeteysatan ufaytees.<verse eid="PRO 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 11:21" />Iita asi seerettonna attenna; shin xillota kochay attana.<verse eid="PRO 11:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 11:22" />Qofi bayna mala lo77o macca puulatethay</para>
  <para style="q2" vid="PRO 11:22">guduntho sidhen aathida worqaa mela.<verse eid="PRO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 11:23" />Xillota amuwas poloy lo77o xalaala; shin iitata amuwas poloy hanqo xalaala.<verse eid="PRO 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 11:24" />Issi issi asati banta miishe asas coo keehosona; shin enta aqoy haa darees. Hara asati qassi banta miishas pala uuzettoosona; shin enta aqoy yaa pacees.<verse eid="PRO 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 11:25" />Keeha asi duretana; harata maaddiya asi maadetana.<verse eid="PRO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 11:26" />Kathi al77in bayzanaw minjiya uraa asay baaddees. Shin ba kathaa asay koyiya wode bayziya uraa anjees.<verse eid="PRO 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 11:27" />Lo77oba minthidi koyiya uray ufaysaa demmees; shin iitabaa koyiya uraa iitabay demmees.<verse eid="PRO 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 11:28" />Ba duretetha ammanetiya asi kundana; shin xilloti balgo mithada.<verse eid="PRO 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 11:29" />Ba soo asaa bolla buqethi denthiya uray go7etiyabay aybika baawa. Eeyatika cincatas aylle gidana.<verse eid="PRO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 11:30" />Xillo asi de7o ayfe ayfiya mitha mela; shempo ashsheysati cincata.<verse eid="PRO 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 11:31" />Xilloti sa7an banta ooso gate ekiyaba gidiko, iitatinne nagaranchati banta oosuwas ekana gatey waanidi darandeesha!<verse eid="PRO 11:31" /></para>
  <chapter eid="PRO 11" />
  <chapter number="12" style="c" sid="PRO 12" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 12:1" />Seera dosiya uray eratethi dosees; shin seera ixiya uray eeya.<verse eid="PRO 12:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 12:2" />Lo77o asi Godaape saba demmees; shin Goday genanchota pirdees.<verse eid="PRO 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 12:3" />Asi iitatethan minnidi eqenna;</para>
  <para style="q2" vid="PRO 12:3">shin xillota xaphoy qaaxenna.<verse eid="PRO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 12:4" />Wozanaama machiya ba azinaas kallacha mela; shin ba azina kawushiya machiya meqethi miya ajaaje mela.<verse eid="PRO 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 12:5" />Xilluwa qofay suure; shin iitata zorey cimo.<verse eid="PRO 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 12:6" />Iitata zoretay asa qohanaasa; shin xillota zoretay enta ashshanaasa.<verse eid="PRO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 12:7" />Iita asati kundana; entaw zerethika attenna; shin xillota kochay minnidi de7ana.<verse eid="PRO 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 12:8" />Asi ba cincatetha mela galatetees; shin geella qofay de7iya asi kadhetees.<verse eid="PRO 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 12:9" />Dure asi daanidi, meton de7iya asaape coo asa daanidi, oothiiddi ba de7o sugiya asi keeha.<verse eid="PRO 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 12:10" />Xillo asi ba mehes qadhetees, shin wozana mino asas qadhey baawa.<verse eid="PRO 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 12:11" />Ba biitta minthi oothiya uray kathi kallees; shin pathonnaba yedethiya uray akeeki pacidaysa.<verse eid="PRO 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 12:12" />Iitati nagarancho asata di77anaw amottoosona; shin xillota xaphoy daayidi de7ana.<verse eid="PRO 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 12:13" />Iita asa iya doonape keyida odi xihe gididi oykees; shin xilloy metope kessi ekees.<verse eid="PRO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 12:14" />Asi ba doonape keyiya qaalan lo77oba kallees; ba oothida ooso gatiya ekees.<verse eid="PRO 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 12:15" />Eeya asi biya buussay aw iya huuphen like daanees; shin cinca asi zore si7ees.<verse eid="PRO 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 12:16" />Eeya uraa hanqoy ellesidi eretees; shin cinca asi cashshe wuda geenna.<verse eid="PRO 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 12:17" />Tumaa haasayiya asi suureba odees; shin wordo markay wordo odees.<verse eid="PRO 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 12:18" />Akeekona odetiya odi mashshada caddees;</para>
  <para style="q2" vid="PRO 12:18">shin cinca inxarsay pathees.<verse eid="PRO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 12:19" />Wordo odi guutha wodesa; shin tuma odi merinaw de7ana.<verse eid="PRO 12:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 12:20" />Iita qopiya asaa wozanan cimoy de7ees;</para>
  <para style="q2" vid="PRO 12:20">shin saroba zoreteyisata wozanan ufaysay kumees.<verse eid="PRO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 12:21" />Xillota metoy gakenna; shin iitatas metoy darana.<verse eid="PRO 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 12:22" />Goday wordanchota ixees; shin tumancho asatan I ufaytees.<verse eid="PRO 12:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 12:23" />Cinca asi ba eraa qottees; shin eeyati banta eeyatetha odoosona.<verse eid="PRO 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 12:24" />Minnidi oothiya uray dere haarees; shin azalla asi haaretees.<verse eid="PRO 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 12:25" />Un7an kumida wozani azzano ehees; shin keeha odi iya ufaysees.<verse eid="PRO 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 12:26" />Xillo asi ba shooruwa zoridi, suure oge kaalethees; shin iitati oge tumaape haassees.<verse eid="PRO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 12:27" />Azalla asi shankatidi ehida asho kathenna;</para>
  <para style="q2" vid="PRO 12:27">shin minnidi oothiya uray ba miishiyas mishetees.<verse eid="PRO 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 12:28" />Xillotethaa ogen de7oy de7ees; he ogen hayqoy baawa.<verse eid="PRO 12:28" /></para>
  <chapter eid="PRO 12" />
  <chapter number="13" style="c" sid="PRO 13" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 13:1" />Erancho na7ay ba aawa seera si7ees; shin qelqiseysi seera ekenna.<verse eid="PRO 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 13:2" />Asi ba doonape keyiya qaalan lo77oba ekees; shin ammanetonaysati makallaba amottoosona.<verse eid="PRO 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 13:3" />Ba doona naagiya uray ba shempuwa naagees;</para>
  <para style="q2" vid="PRO 13:3">shin eeson haasaya uray bana dhaysees.<verse eid="PRO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 13:4" />Azallay amottees; amotikonne aybaka demmenna; shin minnidi ootheysati kallana.<verse eid="PRO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 13:5" />Xillo asati wordo oda ixoosona. Shin iita asata odi yeellayeesinne kawushshees.<verse eid="PRO 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 13:6" />Suure de7uwa de7iya uraa iya xillotethay naagees; shin nagarancho iya nagaray ongees.<verse eid="PRO 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 13:7" />Bana dure daanisiya asi de7ees; shin iyaw aybinne baawa; qassi bana manqo daanisiya asi de7ees; shin iyaw daro aqoy de7ees.<verse eid="PRO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 13:8" />Asi ba miishen ba shempo wozanaw danda7ees; shin manquwa yashisiyabay baawa.<verse eid="PRO 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 13:9" />Xillota poo7oy phoolees;</para>
  <para style="q2" vid="PRO 13:9">shin iitata xompey to7ana.<verse eid="PRO 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 13:10" />Otoroy ooshshi yelees; shin zore ekeysati cincata.<verse eid="PRO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 13:11" />Daaburi bayna demmida miishey eeson dhayees; shin minni oothidi demmida aqoy, dari daridi bees.<verse eid="PRO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 13:12" />Koyiyabay poletonna gam7eysi azzanthees; shin amotidabay poleteysi ufaysees.<verse eid="PRO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 13:13" />Zore kadhiya uray meton gelees; shin kiita bonchiya uray saro de7ana.<verse eid="PRO 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 13:14" />Cincatethi immiya timirtey de7o pulto; higgey ase hayqo xihepe kessi ekanaw maaddees.<verse eid="PRO 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 13:15" />Akeeki de7iya uray bonchetees; shin ammanetona ixoy qohos gathees.<verse eid="PRO 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 13:16" />Cinca asi ubbay eran oothees; shin eeyi ba eeyatetha qoncisees.<verse eid="PRO 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 13:17" />Iita asati kiitetidi, meton geloosona; shin ammanthiya asati kiitetidi, sarotethi ehoosona.<verse eid="PRO 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 13:18" />Seera ixiya asi manqeesinne yeellatees;</para>
  <para style="q2" vid="PRO 13:18">shin seera ekiya uray bonchetees.<verse eid="PRO 13:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 13:19" />Amotidabay poleteysi daro ufaysees;</para>
  <para style="q2" vid="PRO 13:19">shin iitati iitabaape haakanaw koyokona.<verse eid="PRO 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 13:20" />Cinca asara hemetiya asi cinca gidees;</para>
  <para style="q2" vid="PRO 13:20">shin eeya asara hemetiya asi meton gelees.<verse eid="PRO 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 13:21" />Nagaranchota iita qaaday kaallees;</para>
  <para style="q2" vid="PRO 13:21">shin duretethi xillota woyto.<verse eid="PRO 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 13:22" />Lo77o asi ba nayta nayta laatisees;</para>
  <para style="q2" vid="PRO 13:22">shin nagaranchuwa aqoy xilluwas dagayetees.<verse eid="PRO 13:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 13:23" />Manquwa goshshay daro kathi ayfenaw danda7ees;</para>
  <para style="q2" vid="PRO 13:23">shin suure pirda pacan dhayees.<verse eid="PRO 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 13:24" />Pircon seeranaw dosonna asi ba na7aa ixees;</para>
  <para style="q2" vid="PRO 13:24">shin ba na7aa siiqiya uray minnidi seerees.<verse eid="PRO 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 13:25" />Xilloy, uloy kallana gakanaw mees;</para>
  <para style="q2" vid="PRO 13:25">shin nagaranchoy ubba wode koshatana.<verse eid="PRO 13:25" /></para>
  <chapter eid="PRO 13" />
  <chapter number="14" style="c" sid="PRO 14" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 14:1" />Cinca maccasi ba keethaa keexawusu;</para>
  <para style="q2" vid="PRO 14:1">shin eeya maccasiya ba keethaa ba kushen laallawusu.<verse eid="PRO 14:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 14:2" />Suure hemetiya asi Godaa yayyees;</para>
  <para style="q2" vid="PRO 14:2">shin ba oge geellayiya asi Godaa kadhees.<verse eid="PRO 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PRO 14:3" />Eeya odi iya zokuwas xam7a ehees;</para>
  <para style="q2" vid="PRO 14:3">shin cincata inxarsay enta naagees.<verse eid="PRO 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PRO 14:4" />Boori bayna ixiko shaaley kaysi gidees;</para>
  <para style="q2" vid="PRO 14:4">shin goshsha boori de7iko, ne shaaley kathan kumees.<verse eid="PRO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 14:5" />Ammanetiya marki ubba wode tuma odees;</para>
  <para style="q2" vid="PRO 14:5">shin wordo marki wordo xalaala odetees.<verse eid="PRO 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 14:6" />Qelqisiya asi cincatethi koyees, shin demmenna;</para>
  <para style="q2" vid="PRO 14:6">akeeki de7iya asi eratethi demoy waaysenna.<verse eid="PRO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 14:7" />Eeya asape haaka;</para>
  <para style="q2" vid="PRO 14:7">neeni iya odape eratethi demmaka.<verse eid="PRO 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 14:8" />Cinca asi cinca gidiya ba oothiyaba erees;</para>
  <para style="q2" vid="PRO 14:8">shin eeya asa eeyatethay iya balethees.<verse eid="PRO 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 14:9" />Eeyati nagara oothishe, qiirotanaysa aggidi qelqisoosona;</para>
  <para style="q2" vid="PRO 14:9">shin suureti banta nagaray atto geetetanaw koyoosona.<verse eid="PRO 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 14:10" />Issi issi wozani ba azzanuwa erees;</para>
  <para style="q2" vid="PRO 14:10">iya ufaysa oonika iyara koxenna.<verse eid="PRO 14:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 14:11" />Iitata keethay laaletana;</para>
  <para style="q2" vid="PRO 14:11">shin suureta keethay minnidi daana.<verse eid="PRO 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 14:12" />Asas like daaniya ogey de7ees;</para>
  <para style="q2" vid="PRO 14:12">shin iya wursethay hayqoko gathees.<verse eid="PRO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 14:13" />Miicha wodeka wozanan azzanoy de7ees;</para>
  <para style="q2" vid="PRO 14:13">ufaysa wursethay azzano gidanaw danda7ees.<verse eid="PRO 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 14:14" />Iita asi ba iita oosuwa gate ekana;</para>
  <para style="q2" vid="PRO 14:14">lo77o asika ba lo77o oosuwa gate ekana.<verse eid="PRO 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 14:15" />Eeya asi ubbaba ammanees;</para>
  <para style="q2" vid="PRO 14:15">shin cinca asi akeekidi tangees.<verse eid="PRO 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 14:16" />Cinca asi Godaa yayyees; iitape haakees;</para>
  <para style="q2" vid="PRO 14:16">shin eeya asi eesotesinne iitape naagetenna.<verse eid="PRO 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 14:17" />Elle hanqetiya asi eeya ooso oothees;</para>
  <para style="q2" vid="PRO 14:17">shin cinca asi danda7ancho.<verse eid="PRO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PRO 14:18" />Akeeki bayna asi ba eeyatetha gatiya ekoosona;</para>
  <para style="q2" vid="PRO 14:18">shin cinca asi eratethi kallachada goxoosona.<verse eid="PRO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 14:19" />Iitati lo77ota sinthan gulbatana;</para>
  <para style="q2" vid="PRO 14:19">nagaranchati xillota pengen hokana.<verse eid="PRO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 14:20" />Manqoy ba shooruwan ixetees;</para>
  <para style="q2" vid="PRO 14:20">shin duretas daro laggeti de7oosona.<verse eid="PRO 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 14:21" />Ba shooruwa kadhiya asi nagara oothees;</para>
  <para style="q2" vid="PRO 14:21">shin manquwa maaddiya asi anjetidaysa.<verse eid="PRO 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 14:22" />Iitabaa maqeteysati baloosona gidokona?</para>
  <para style="q2" vid="PRO 14:22">shin lo77oba oothanaw halcheysati</para>
  <para style="q2" vid="PRO 14:22">ammanetethinne siiqo demmoosona.<verse eid="PRO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 14:23" />Minnidi oothiya ooso ubban wodhey de7ees;</para>
  <para style="q2" vid="PRO 14:23">shin coo odi manqotethi ehees.<verse eid="PRO 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 14:24" />Cincatas enta duretethay entaw kallacha;</para>
  <para style="q2" vid="PRO 14:24">shin eeyati guji guji eeyoosona.<verse eid="PRO 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 14:25" />Tuma marki shempo ashshees;</para>
  <para style="q2" vid="PRO 14:25">shin wordo marki balethees.<verse eid="PRO 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 14:26" />Godaa yayiya asas mino miixay de7ees;</para>
  <para style="q2" vid="PRO 14:26">iya naytas baqatidi attiya bessi de7ees.<verse eid="PRO 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 14:27" />Godaa yashshi de7o pulto;</para>
  <para style="q2" vid="PRO 14:27">hayqo xihepe ase ashshees.<verse eid="PRO 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 14:28" />Kawo gitatethi I haariya asaa darotethaana;</para>
  <para style="q2" vid="PRO 14:28">shin haaretiya asi dhayiko ika pathenna.<verse eid="PRO 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 14:29" />Danda7ancho asas gita akeeki de7ees;</para>
  <para style="q2" vid="PRO 14:29">shin elle hanqetiya asi ba eeyatetha qoncisees.<verse eid="PRO 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 14:30" />Saro wozani asatethas payyatethi immees;</para>
  <para style="q2" vid="PRO 14:30">shin qanaatey asatethas ajaaje harge mela.<verse eid="PRO 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="PRO 14:31" />Manqota naaqiya asi enta medhidaysa cayees;</para>
  <para style="q2" vid="PRO 14:31">shin metootanchotas keehiya asi Xoossaa bonchees.<verse eid="PRO 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="PRO 14:32" />Iitati banta iita ooson kundana;</para>
  <para style="q2" vid="PRO 14:32">shin xillotas hayqope attiya miixi de7ees.<verse eid="PRO 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="PRO 14:33" />Akeekancho asa wozanan cincatethi kumis;</para>
  <para style="q2" vid="PRO 14:33">shin eeyati cincatethi aybeko erokona.<verse eid="PRO 14:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="PRO 14:34" />Xillotethi issi kawotetha dhoqu dhoqu oothees;</para>
  <para style="q2" vid="PRO 14:34">shin nagari ay asika kawushshees.<verse eid="PRO 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="PRO 14:35" />Erancho aylletanan kawoy ufaytees;</para>
  <para style="q2" vid="PRO 14:35">shin yeellaya aylley kawa hanqethees.<verse eid="PRO 14:35" /></para>
  <chapter eid="PRO 14" />
  <chapter number="15" style="c" sid="PRO 15" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 15:1" />Liiqo inxarsi hanqo zarbisees;</para>
  <para style="q2" vid="PRO 15:1">shin dom7ethiya qaali hanqo denthethees.<verse eid="PRO 15:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 15:2" />Cincata inxarsay era puulayees;</para>
  <para style="q2" vid="PRO 15:2">shin eeyata doonay eeyatethi pultisees.<verse eid="PRO 15:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 15:3" />Godaa ayfeti ubba bessi xeelloosona;</para>
  <para style="q2" vid="PRO 15:3">iitatanne lo77ota shaakidi be7oosona.<verse eid="PRO 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 15:4" />Lo77o odi de7o mitha mela;</para>
  <para style="q2" vid="PRO 15:4">shin geella odi ayyaana menthees.<verse eid="PRO 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 15:5" />Eeyi ba aawa seera kadhees;</para>
  <para style="q2" vid="PRO 15:5">shin ba aawa seera ekiya asi cinca.<verse eid="PRO 15:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 15:6" />Xillo uraa keethan daro miishey de7ees;</para>
  <para style="q2" vid="PRO 15:6">shin iitata soo geliya miishey meto ehees.<verse eid="PRO 15:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 15:7" />Cincata doonay era zerees;</para>
  <para style="q2" vid="PRO 15:7">shin eeyata wozanay hessa mela gidenna.<verse eid="PRO 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 15:8" />Goday iitata yarshuwa ixees;</para>
  <para style="q2" vid="PRO 15:8">shin suureta woosan I ufaytees.<verse eid="PRO 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 15:9" />Goday iita asata ogiya ixees;</para>
  <para style="q2" vid="PRO 15:9">shin xillotethi kaalleyisata I dosees.<verse eid="PRO 15:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 15:10" />Like ogiya aggida asi pirdi naagees;</para>
  <para style="q2" vid="PRO 15:10">seera ixiya asi hayqees.<verse eid="PRO 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 15:11" />Duufoynne dhayoy Godaa sinthan qonce;</para>
  <para style="q2" vid="PRO 15:11">yaatin, asa wozana qofay waani iyape geemmanee?<verse eid="PRO 15:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 15:12" />Qelqisiya asi seera dosenna;</para>
  <para style="q2" vid="PRO 15:12">cincatape zore oychenna.<verse eid="PRO 15:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 15:13" />Wozani ufaytin, som7oy poo7ees;</para>
  <para style="q2" vid="PRO 15:13">shin wozani azzaniko, ayyaani meqees.<verse eid="PRO 15:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 15:14" />Akeeka wozani de7iya asi eratethi koyees;</para>
  <para style="q2" vid="PRO 15:14">shin eeyati banta eeyatethan ufaytoosona.<verse eid="PRO 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 15:15" />Manqota de7oy ubba wode baaxe;</para>
  <para style="q2" vid="PRO 15:15">shin ufaytiya asi ubba wode alees.<verse eid="PRO 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 15:16" />Ooshshara de7iya gita aqope</para>
  <para style="q2" vid="PRO 15:16">Godaa yashshara de7iya guuthabay keeha.<verse eid="PRO 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 15:17" />Ooshshi de7iya bessan modho asho maanape</para>
  <para style="q2" vid="PRO 15:17">siiqoy de7iya bessan santhi keeha.<verse eid="PRO 15:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 15:18" />Hanqoy ooshshi kessees;</para>
  <para style="q2" vid="PRO 15:18">shin danda7i ooshshi irxisees.<verse eid="PRO 15:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 15:19" />Azalla asa ogey agunthan diretis;</para>
  <para style="q2" vid="PRO 15:19">shin suure asa ogey giiga.<verse eid="PRO 15:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 15:20" />Cinca na7i ba aawa ufaysees;</para>
  <para style="q2" vid="PRO 15:20">shin eeya na7i ba aayiw kadhees.<verse eid="PRO 15:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 15:21" />Wozani bayna asi ba eeyatethan ufaytees;</para>
  <para style="q2" vid="PRO 15:21">shin wozanaama asi bessiya ba oothees.<verse eid="PRO 15:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 15:22" />Zorey dhayiko, qopidabay haddirees;</para>
  <para style="q2" vid="PRO 15:22">daro zorey de7iya bessan qopidabay poletees.<verse eid="PRO 15:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 15:23" />Oyshas bessiya zaaro imoy he uraa ufaysees;</para>
  <para style="q2" vid="PRO 15:23">ba woden odetiya odi ay mela ufaysi!<verse eid="PRO 15:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 15:24" />Garsan de7iya si7oolepe attana mela</para>
  <para style="q2" vid="PRO 15:24">de7o ogey akeeka uraa pude kaalethees.<verse eid="PRO 15:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 15:25" />Goday otoranchota keetha laallana;</para>
  <para style="q2" vid="PRO 15:25">shin am7e zawa naagees.<verse eid="PRO 15:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 15:26" />Goday iitata qofaa ixees;</para>
  <para style="q2" vid="PRO 15:26">shin geeshsha qaalan I ufaytees.<verse eid="PRO 15:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 15:27" />Wordon wodhe demmanaw aaliya asi</para>
  <para style="q2" vid="PRO 15:27">ba soo asaa bolla meto ehees;</para>
  <para style="q2" vid="PRO 15:27">shin wodhaafe ixiya asi de7on daana.<verse eid="PRO 15:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 15:28" />Xillo asi odetanape sinthatidi qopees;</para>
  <para style="q2" vid="PRO 15:28">shin iitata inxarsaape iitabay pultees.<verse eid="PRO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="PRO 15:29" />Goday iitatape haakees;</para>
  <para style="q2" vid="PRO 15:29">shin xillota woosa si7ees.<verse eid="PRO 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="PRO 15:30" />Som7oy pashkin wozani ufaytees;</para>
  <para style="q2" vid="PRO 15:30">mishiraachoy meqethi minthees.<verse eid="PRO 15:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 15:31" />De7o immiya zore si7iya asi</para>
  <para style="q2" vid="PRO 15:31">cincatethara issife daana.<verse eid="PRO 15:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 15:32" />Seera ixiya asi bana qohees;</para>
  <para style="q2" vid="PRO 15:32">shin seera ekiya asi akeeka demmees.<verse eid="PRO 15:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 15:33" />Godaas yashshi cincatethi tamaarsees;</para>
  <para style="q2" vid="PRO 15:33">ashketethi bonchofe sinthatees.<verse eid="PRO 15:33" /></para>
  <chapter eid="PRO 15" />
  <chapter number="16" style="c" sid="PRO 16" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 16:1" />Asi ba wozanan halchees;</para>
  <para style="q2" vid="PRO 16:1">shin like zaaroy Godaape bentees.<verse eid="PRO 16:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 16:2" />Asi oothiya ooso ubbay iyaw like daanees;</para>
  <para style="q2" vid="PRO 16:2">shin Goday dendo qofaa be7ees.<verse eid="PRO 16:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 16:3" />Ne ooso ubbaa Godaas hadara imma;</para>
  <para style="q2" vid="PRO 16:3">neeni qopidabay poletana.<verse eid="PRO 16:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 16:4" />Goday ubbabay qopidaysatho bana mela oothees;</para>
  <para style="q2" vid="PRO 16:4">hanikoka, makallanchota wursethay dhayo.<verse eid="PRO 16:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 16:5" />Goday otoranchota ixees;</para>
  <para style="q2" vid="PRO 16:5">enti seerettonna attokona.<verse eid="PRO 16:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 16:6" />Siiqoninne ammanetethan nagari atto geetetees;</para>
  <para style="q2" vid="PRO 16:6">Godaas yayyidi asi iitabaape attees.<verse eid="PRO 16:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 16:7" />Asa hemethi Godaa ufaysiyabaa gidiko,</para>
  <para style="q2" vid="PRO 16:7">I ba morketara saro daanada oothees.<verse eid="PRO 16:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 16:8" />Xillotethan bentiya guuthabay,</para>
  <para style="q2" vid="PRO 16:8">wordon demmiya daro wodhepe lo77o.<verse eid="PRO 16:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 16:9" />Asi wozanan ba oothanaba halchees;</para>
  <para style="q2" vid="PRO 16:9">shin halchoy Godaa maaden poletees.<verse eid="PRO 16:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 16:10" />Kawoy Xoossaafe ekida maatan pirdees;</para>
  <para style="q2" vid="PRO 16:10">iya inxarsay suure pirdees.<verse eid="PRO 16:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 16:11" />Gina mizaanetinne maka miisheti Godaaba;</para>
  <para style="q2" vid="PRO 16:11">bayziyaba ubban geney doonna mela Goday koyees.<verse eid="PRO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 16:12" />Kawoti iita ooso ixoosona;</para>
  <para style="q2" vid="PRO 16:12">enta araatay xillotethan eqees.<verse eid="PRO 16:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 16:13" />Kawoti xillo inxarsan ufaytoosona;</para>
  <para style="q2" vid="PRO 16:13">tumaa haasaya uraa dosoosona.<verse eid="PRO 16:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 16:14" />Kawa hanqoy hayqo kiitancho mela;</para>
  <para style="q2" vid="PRO 16:14">shin cinca asi hanquwa irxisees.<verse eid="PRO 16:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 16:15" />Kawa som7oy poo7iko de7oy de7ees;</para>
  <para style="q2" vid="PRO 16:15">Iya lo77otethay ira ehiya shaara mela.<verse eid="PRO 16:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 16:16" />Cincatethi demoy worqa demope aadhees;</para>
  <para style="q2" vid="PRO 16:16">akeeka demoy bira demope lo77o.<verse eid="PRO 16:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 16:17" />Suureta ogey iitape haako;</para>
  <para style="q2" vid="PRO 16:17">ba hemethaa naagiya uray ba shempuwa naagees.<verse eid="PRO 16:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 16:18" />Otoroy dhayo kaalethees;</para>
  <para style="q2" vid="PRO 16:18">ceeqetethi kundethi ehees.<verse eid="PRO 16:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 16:19" />Otoranchotara di7o shaaketanaape,</para>
  <para style="q2" vid="PRO 16:19">ashke gididi manqidi de7eysi lo77o.<verse eid="PRO 16:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 16:20" />Zore si7iya uraas I oothiyaba ubbay injetana;</para>
  <para style="q2" vid="PRO 16:20">Godan ammanetiya uray anjetana.<verse eid="PRO 16:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 16:21" />Ba qofan cinca gidida asi akeekancho geetetees;</para>
  <para style="q2" vid="PRO 16:21">lo77o qaali eratethi gujees.<verse eid="PRO 16:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 16:22" />Cinca asas eratethi de7o pulto mela;</para>
  <para style="q2" vid="PRO 16:22">shin eeyata seeroy coo wode wursees.<verse eid="PRO 16:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 16:23" />Cinca asi odetanaape sinthe qopees;</para>
  <para style="q2" vid="PRO 16:23">iya mettershay eratethi gujees.<verse eid="PRO 16:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 16:24" />Lo77o qaali eessa ililoda mal7ees;</para>
  <para style="q2" vid="PRO 16:24">shempos mal7o; meqethas paxo gidees.<verse eid="PRO 16:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 16:25" />Asas suure daaniya ogey de7ees;</para>
  <para style="q2" vid="PRO 16:25">shin wursethan hayqoko gathees.<verse eid="PRO 16:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 16:26" />Asi minnidi oothana mela oothey katha amo;</para>
  <para style="q2" vid="PRO 16:26">koshi minnidi oothana mela denthethees.<verse eid="PRO 16:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 16:27" />Kawusha asi iitabaa halchees;</para>
  <para style="q2" vid="PRO 16:27">iya oday tamada xuuggees.<verse eid="PRO 16:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 16:28" />Wobe asi ooshshi denthethees;</para>
  <para style="q2" vid="PRO 16:28">zigirsi ammanetiya laggeta shaakees.<verse eid="PRO 16:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 16:29" />Gene asi ba shooruwa cimmees;</para>
  <para style="q2" vid="PRO 16:29">lo77o gidonna oge kaalethees.<verse eid="PRO 16:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 16:30" />Ba ayfen qam7otiya asi geellaba qopees;</para>
  <para style="q2" vid="PRO 16:30">ba mettersha saxidi mandiya asi iitabaa oothees.<verse eid="PRO 16:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 16:31" />Puulumida huuphey boncho kallacha;</para>
  <para style="q2" vid="PRO 16:31">hessika bentey xillo de7o de7ina.<verse eid="PRO 16:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 16:32" />Wolqaama asi gidanaape danda7a asi gidoy lo77o,</para>
  <para style="q2" vid="PRO 16:32">daro katamata olidi oykanaape bana haaroy aadhees.<verse eid="PRO 16:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 16:33" />Asi saama yeggees;</para>
  <para style="q2" vid="PRO 16:33">shin wursetha zaaroy Godaape bentees.<verse eid="PRO 16:33" /></para>
  <chapter eid="PRO 16" />
  <chapter number="17" style="c" sid="PRO 17" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 17:1" />Ooshshi de7iya bessan de7iya gita gibiraape</para>
  <para style="q2" vid="PRO 17:1">saroynne wopi de7iya bessan uytha poqoy lo77o.<verse eid="PRO 17:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 17:2" />Cinca aylley pathonna ba godaa na7aa haarees;</para>
  <para style="q2" vid="PRO 17:2">iya ishatara issife laata shaaketees.<verse eid="PRO 17:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 17:3" />Worqinne biri taman paaceteysada;</para>
  <para style="q2" vid="PRO 17:3">Goday asa wozana paacees.<verse eid="PRO 17:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 17:4" />Iita asi iita haasaya si7ees;</para>
  <para style="q2" vid="PRO 17:4">wordanchoy wordo haasaya hayzees.<verse eid="PRO 17:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 17:5" />Manqota bolla qelqisiya asi enta medhida Xoossaa cayees;</para>
  <para style="q2" vid="PRO 17:5">hara asi gakiya meton ufaytiya asi seerettonna attenna.<verse eid="PRO 17:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 17:6" />Na7a na7i cima asas kallacha;</para>
  <para style="q2" vid="PRO 17:6">aawati banta naytas boncho.<verse eid="PRO 17:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 17:7" />Lo77o odi eeya asas giigenna;</para>
  <para style="q2" vid="PRO 17:7">hessadaka wordo odi ayseysas giigenna.<verse eid="PRO 17:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 17:8" />Wodhaafe immeysas wodhaafey bita mela;</para>
  <para style="q2" vid="PRO 17:8">I biya bessa ubbay iyaw injetees.<verse eid="PRO 17:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 17:9" />Qoho genthiya uray siiqo koyees;</para>
  <para style="q2" vid="PRO 17:9">shin oda zaaridi zaaridi woociya uray,</para>
  <para style="q2" vid="PRO 17:9">ammanetiya laggeta shaakees.<verse eid="PRO 17:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 17:10" />Eeyay xeetu toho lisson shocin ereysafe;</para>
  <para style="q2" vid="PRO 17:10">akeeki de7iya asas coo hanqoy era immees.<verse eid="PRO 17:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 17:11" />Iita asi ubba wode geella;</para>
  <para style="q2" vid="PRO 17:11">qadhey bayna asi iya bolla kiitetana.<verse eid="PRO 17:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 17:12" />Eeyara iya eeyatethan gahetanaape</para>
  <para style="q2" vid="PRO 17:12">marati eketida maahera gahetethi lo77o.<verse eid="PRO 17:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 17:13" />Lo77o oothidaysas iita kushe zaariya</para>
  <para style="q2" vid="PRO 17:13">uraa soope iitabay kichenna.<verse eid="PRO 17:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 17:14" />Ooshshi doomishe haatha dhawa mentheysa mela;</para>
  <para style="q2" vid="PRO 17:14">hessa gisho ooshshi doomanaape koyrottada palama agga.<verse eid="PRO 17:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 17:15" />Nagaranchuwa xillisoynne</para>
  <para style="q2" vid="PRO 17:15">xilluwa bolla pirdoy,</para>
  <para style="q2" vid="PRO 17:15">nam7ayka Goday ixiya ooso.<verse eid="PRO 17:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 17:16" />Cincatethi demmanaw amoy bayna de7ishin,</para>
  <para style="q2" vid="PRO 17:16">eeya kushen de7iya miishey ay iya maaddii?<verse eid="PRO 17:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 17:17" />Laggey ubba wodeka lagge;</para>
  <para style="q2" vid="PRO 17:17">ishi meto wode maaddanaw yeletees.<verse eid="PRO 17:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 17:18" />Akeeki bayna asi eronna uraa</para>
  <para style="q2" vid="PRO 17:18">acuwa qanxanaw waase gidees.<verse eid="PRO 17:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 17:19" />Ooshshu dosiya asi nagara dosees;</para>
  <para style="q2" vid="PRO 17:19">ubba wode ceeqetiya asi ba bolla dhayo xeegees.<verse eid="PRO 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 17:20" />Wobe qofi de7iya asi lo77oba demmenna;</para>
  <para style="q2" vid="PRO 17:20">ba inxarsan cimmiya asi meton gelees.<verse eid="PRO 17:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 17:21" />Eeyaa na7a yelida aawi azzanees;</para>
  <para style="q2" vid="PRO 17:21">eeya na7a aawas ufaysi deenna.<verse eid="PRO 17:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 17:22" />Ufaytiya wozani asas lo77o dhale;</para>
  <para style="q2" vid="PRO 17:22">shin meqida wozani asas wolqa dhaysees.<verse eid="PRO 17:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 17:23" />Iita asi pirda geellayanaw</para>
  <para style="q2" vid="PRO 17:23">geeman wodhaafe ekees.<verse eid="PRO 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 17:24" />Akeeka asi cincatethi ba sinthafe haassenna;</para>
  <para style="q2" vid="PRO 17:24">shin eeya asa ayfey sa7a gaxa yuuyees.<verse eid="PRO 17:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 17:25" />Eaya na7i ba aawa azzanthees;</para>
  <para style="q2" vid="PRO 17:25">ba aayiwuka camisees.<verse eid="PRO 17:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 17:26" />Xillo asi seeroy bessenna;</para>
  <para style="q2" vid="PRO 17:26">suure asi shocoy lo77o gidenna.<verse eid="PRO 17:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 17:27" />Guutha qaala haasaya asi erancho;</para>
  <para style="q2" vid="PRO 17:27">wopa ayyaani de7iya asi akeekancho.<verse eid="PRO 17:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 17:28" />Eeya asi si77i giiko cinca daanees;</para>
  <para style="q2" vid="PRO 17:28">ba doona dooyonna ixiko erancho daanees.<verse eid="PRO 17:28" /></para>
  <chapter eid="PRO 17" />
  <chapter number="18" style="c" sid="PRO 18" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 18:1" />Shaahetethi koyiya asi ba amuwa kaallees;</para>
  <para style="q2" vid="PRO 18:1">suure qofa ubbaa ixees.<verse eid="PRO 18:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 18:2" />Eeya asi ba qofaa xalaala qoncisanaw dosees;</para>
  <para style="q2" vid="PRO 18:2">hara asape era ekanaw dosenna.<verse eid="PRO 18:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 18:3" />Iitatethi yaa wode kadhey yees;</para>
  <para style="q2" vid="PRO 18:3">kawushatethi yaa wode yeelli yees.<verse eid="PRO 18:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 18:4" />Asa doonape keya odi,</para>
  <para style="q2" vid="PRO 18:4">ciimmo haatha mela;</para>
  <para style="q2" vid="PRO 18:4">cincatethi goggiya pulto mela.<verse eid="PRO 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 18:5" />Naaqida uraa maaddidi, xilluwa pirdaa</para>
  <para style="q2" vid="PRO 18:5">geellayeysi lo77o gidenna.<verse eid="PRO 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 18:6" />Eeya asa odi ooshshu denthethees;</para>
  <para style="q2" vid="PRO 18:6">iya doonay wadho xeegees.<verse eid="PRO 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 18:7" />Eeya asa odi bana qohees;</para>
  <para style="q2" vid="PRO 18:7">iya oday xihe gididi iya oykees.<verse eid="PRO 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 18:8" />Zigirsi mal7o katha mela;</para>
  <para style="q2" vid="PRO 18:8">ufaysishe duge ganje gakees.<verse eid="PRO 18:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 18:9" />Azalla asi</para>
  <para style="q2" vid="PRO 18:9">dhaysiya asape aybaka dummatenna.<verse eid="PRO 18:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 18:10" />Godaa sunthay mino gimbe mela;</para>
  <para style="q2" vid="PRO 18:10">xillo asi yaa woxidi saro attees.<verse eid="PRO 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 18:11" />Dure asata duretethay gimbetida katama mela;</para>
  <para style="q2" vid="PRO 18:11">enta qofan enta duretethay</para>
  <para style="q2" vid="PRO 18:11">mino dirsada enta naagiyaba daanees.<verse eid="PRO 18:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 18:12" />Otoroy kundethafe sinthatees;</para>
  <para style="q2" vid="PRO 18:12">ashketethi boncho ehees.<verse eid="PRO 18:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 18:13" />Si7onna de7ishe zaaro imoy,</para>
  <para style="q2" vid="PRO 18:13">he uraas eeyatethinne yeella.<verse eid="PRO 18:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 18:14" />Daana gidi qopiko, iya ayyaanay harge danda7isees;</para>
  <para style="q2" vid="PRO 18:14">shin ufaysi qanxiko iya maaddey baawa.<verse eid="PRO 18:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 18:15" />Akeeka asi eratethi koyees;</para>
  <para style="q2" vid="PRO 18:15">cinca asa haythi cincatethi si7ees.<verse eid="PRO 18:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 18:16" />Imoti immeysas oge dooyees;</para>
  <para style="q2" vid="PRO 18:16">gita asatara erisees.<verse eid="PRO 18:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 18:17" />Daynna sinthan koyro shiiqidi mootiya uray,</para>
  <para style="q2" vid="PRO 18:17">iya morkey yin, iya oychana gakanaw,</para>
  <para style="q2" vid="PRO 18:17">ubba wode bana xillo gidi qopees.<verse eid="PRO 18:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 18:18" />Saama yegethi palama teqees;</para>
  <para style="q2" vid="PRO 18:18">nam7u palamiya asata shaakees.<verse eid="PRO 18:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 18:19" />Qohetida ishay gimbetida</para>
  <para style="q2" vid="PRO 18:19">katamape aadhidi minnees;</para>
  <para style="q2" vid="PRO 18:19">iya palamay birata gorde mela.<verse eid="PRO 18:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 18:20" />Asi ba doona odan ba ulo kunthees;</para>
  <para style="q2" vid="PRO 18:20">ba inxarsaa ayfen kallees.<verse eid="PRO 18:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 18:21" />Hayqoynne de7oy inxarsana;</para>
  <para style="q2" vid="PRO 18:21">neeni ne inxarsaa ayfiya maana.<verse eid="PRO 18:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 18:22" />Macho demmiday lo77oba demmis;</para>
  <para style="q2" vid="PRO 18:22">i, Godaape teema demmees.<verse eid="PRO 18:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 18:23" />Manqo asi aaddashidi odetees;</para>
  <para style="q2" vid="PRO 18:23">shin dure asi otoron zaarees.<verse eid="PRO 18:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 18:24" />Daro laggey de7iya asi ba bolla meto ehees;</para>
  <para style="q2" vid="PRO 18:24">shin ishape aadhidi matatiya laggey de7ees.<verse eid="PRO 18:24" /></para>
  <chapter eid="PRO 18" />
  <chapter number="19" style="c" sid="PRO 19" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 19:1" />Ba doonan wordotiya eeya asape</para>
  <para style="q2" vid="PRO 19:1">ba de7uwan borey bayna manqoy lo77o.<verse eid="PRO 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 19:2" />Eri bayna dafetethi lo77o gidenna;</para>
  <para style="q2" vid="PRO 19:2">eeso daroy oge balethees.<verse eid="PRO 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 19:3" />Asi ba eeyatethan ba de7uwa iissees;</para>
  <para style="q2" vid="PRO 19:3">yaatidi Godaa bolla yilotees.<verse eid="PRO 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 19:4" />Duretethi daro lagge shiishees;</para>
  <para style="q2" vid="PRO 19:4">shin manqotethi de7iya laggeta duuthees.<verse eid="PRO 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 19:5" />Wordo marki seerettonna attenna;</para>
  <para style="q2" vid="PRO 19:5">wordo odetey kessi ekenna.<verse eid="PRO 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 19:6" />Daro asay shuuma som7o koyoosona;</para>
  <para style="q2" vid="PRO 19:6">imota immiya asara asi ubbay dabbotees.<verse eid="PRO 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 19:7" />Manqo asi hari attoshin iya ishati ixoosona;</para>
  <para style="q2" vid="PRO 19:7">iya laggeti iyape haakoosona;</para>
  <para style="q2" vid="PRO 19:7">I enta aaddashinka enti iya koyokona.<verse eid="PRO 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 19:8" />Cincatethi demmiya asi ba shempuwa dosees;</para>
  <para style="q2" vid="PRO 19:8">eratethi minthidi oykiya uraas injetees.<verse eid="PRO 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 19:9" />Wordo marki seerettonna attenna;</para>
  <para style="q2" vid="PRO 19:9">wordo odetey dhayana.<verse eid="PRO 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 19:10" />Eeya asas inje de7oy bessenna;</para>
  <para style="q2" vid="PRO 19:10">aylley halaqata haaroy daro iita.<verse eid="PRO 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 19:11" />Cincatethi ase danda7a tamaarsees;</para>
  <para style="q2" vid="PRO 19:11">qoho kadhidi aadhethi bonchisees.<verse eid="PRO 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 19:12" />Kawa hanqoy gaammo gudetha mela;</para>
  <para style="q2" vid="PRO 19:12">shin iya nashshoy maata aacisiya aka mela.<verse eid="PRO 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 19:13" />Eeya na7i ba aawa dhaysees;</para>
  <para style="q2" vid="PRO 19:13">doonama macha xokiya keetha mela.<verse eid="PRO 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 19:14" />Asi keethenne shalo aawupe laattees;</para>
  <para style="q2" vid="PRO 19:14">shin akeeka macho Goday immees.<verse eid="PRO 19:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 19:15" />Azallatethi dhisko ehees;</para>
  <para style="q2" vid="PRO 19:15">ooso oothonna asi koshatees.<verse eid="PRO 19:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 19:16" />Kiita naagiya asi ba shempuwa naagees;</para>
  <para style="q2" vid="PRO 19:16">shin qelli giya asi hayqees.<verse eid="PRO 19:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 19:17" />Manqos keehiya asi Godaas tal7ees;</para>
  <para style="q2" vid="PRO 19:17">Goday he lo77o oosuwa gisho woytees.<verse eid="PRO 19:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 19:18" />Simo ufaysi de7ishin ne nayta seera;</para>
  <para style="q2" vid="PRO 19:18">seeronna ixiko, ne enta dhaysaasa.<verse eid="PRO 19:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 19:19" />Elle shenetiya asi ba gatiya ekanaw bessees;</para>
  <para style="q2" vid="PRO 19:19">neeni iya issi toho ashshiyaba gidiko,</para>
  <para style="q2" vid="PRO 19:19">hara wodeka ne iya hessada ashshanaysi attenna.<verse eid="PRO 19:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 19:20" />Zore si7a; tamaaranaw koya;</para>
  <para style="q2" vid="PRO 19:20">neeni wursethi gakanaw cinca gidana.<verse eid="PRO 19:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 19:21" />Asi darobaa halchees;</para>
  <para style="q2" vid="PRO 19:21">shin Goday gidabay poletees.<verse eid="PRO 19:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 19:22" />Asape koyetey ammanetethi;</para>
  <para style="q2" vid="PRO 19:22">wordo gidanaape manqo gideysi lo77o.<verse eid="PRO 19:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 19:23" />Godaas yashshi de7oko kaalethees;</para>
  <para style="q2" vid="PRO 19:23">iya yayiya asi kallidi de7ees; iiti iya bochenna.<verse eid="PRO 19:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 19:24" />Issi issi asi daro azalla;</para>
  <para style="q2" vid="PRO 19:24">hari attoshin woxen tushkida</para>
  <para style="q2" vid="PRO 19:24">uythaa pude baaranaw waayetees.<verse eid="PRO 19:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 19:25" />Neeni qelqisiya asi shociko,</para>
  <para style="q2" vid="PRO 19:25">akeeki pacidaysi cincatethi tamaarana;</para>
  <para style="q2" vid="PRO 19:25">akeeka asi ne hanqetiko, I eratethi demmana.<verse eid="PRO 19:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 19:26" />Ba aawa bonqiya na7ay,</para>
  <para style="q2" vid="PRO 19:26">ba aayiw yedethiya na7ay,</para>
  <para style="q2" vid="PRO 19:26">yeellanne kawushatethi ehiya na7a.<verse eid="PRO 19:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 19:27" />Ta na7aw, ne zore si7onna ixiko,</para>
  <para style="q2" vid="PRO 19:27">era ogiyape haakaasa.<verse eid="PRO 19:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 19:28" />Wordo marki suure pirda bolla qelqisees;</para>
  <para style="q2" vid="PRO 19:28">iita asa dooni iitatethi mittees.<verse eid="PRO 19:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 19:29" />Qelqisiya asas pirda</para>
  <para style="q2" vid="PRO 19:29">eeyatas wadho koshshees.<verse eid="PRO 19:29" /></para>
  <chapter eid="PRO 19" />
  <chapter number="20" style="c" sid="PRO 20" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 20:1" />Mathoya ushshi eeyanne ooshancho oothees;</para>
  <para style="q2" vid="PRO 20:1">ushshan baletiya asi cinca gidanaw danda7enna.<verse eid="PRO 20:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PRO 20:2" />Kawo hanqoy gaammo gudetha mela;</para>
  <para style="q2" vid="PRO 20:2">iya yiloyiya asi ba shempuwa bolla pirdees.<verse eid="PRO 20:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 20:3" />Palamape haakeysi boncho;</para>
  <para style="q2" vid="PRO 20:3">shin eeya asi ooyetanaw ellesees.<verse eid="PRO 20:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 20:4" />Azalla goshshanchoy wode naagidi goyenna;</para>
  <para style="q2" vid="PRO 20:4">kathi cakiya wode I woossanaw koyees;</para>
  <para style="q2" vid="PRO 20:4">shin aybaka demmenna.<verse eid="PRO 20:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PRO 20:5" />Asa wozana halchoy ciimmo haatha mela;</para>
  <para style="q2" vid="PRO 20:5">shin wozanaama asi duuqidi kessees.<verse eid="PRO 20:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 20:6" />Daro asati banta lo77otetha odoosona;</para>
  <para style="q2" vid="PRO 20:6">shin tuma ammanetiya asi demmanay oonee?<verse eid="PRO 20:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 20:7" />Xillo asi borey bayna de7o de7ees;</para>
  <para style="q2" vid="PRO 20:7">iya kaalliya iya nayti anjetidaysata.<verse eid="PRO 20:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 20:8" />Kawoy pirdanaw ba araatan uttiya wode,</para>
  <para style="q2" vid="PRO 20:8">iita ubbaa ba ayfen harqidi kessees.<verse eid="PRO 20:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 20:9" />“Ta wozanay geeshshi; tanan nagari baawa”</para>
  <para style="q2" vid="PRO 20:9">gaanaw danda7iya asi daanesha?<verse eid="PRO 20:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 20:10" />Goday wordo mizaanenne</para>
  <para style="q2" vid="PRO 20:10">gina gidonna maka miishen go7eteyisata ixees.<verse eid="PRO 20:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 20:11" />Na7i geeshshinne suure gideysi</para>
  <para style="q2" vid="PRO 20:11">I oothiya ooson eretees.<verse eid="PRO 20:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 20:12" />Si7iya haythinne xeelliya ayfe,</para>
  <para style="q2" vid="PRO 20:12">Goday medhis.<verse eid="PRO 20:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 20:13" />Dhiskon ne wode wursiko ne manqana;</para>
  <para style="q2" vid="PRO 20:13">minnada oothiko ne kathi kallana.<verse eid="PRO 20:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 20:14" />Shammiya asi, “Qohees! Qohees!” yaagees;</para>
  <para style="q2" vid="PRO 20:14">shin bidaape guye, “Gelan shammas” yaagidi ceeqetees.<verse eid="PRO 20:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 20:15" />Worqey kumis; al7o shuchika bentees;</para>
  <para style="q2" vid="PRO 20:15">shin eri kumida inxarsi ubbaafe aadhida alleeqo.<verse eid="PRO 20:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 20:16" />Eronna asas waase geliya uraa ma7uwa qaari ekite;</para>
  <para style="q2" vid="PRO 20:16">imatha asas waase geliya uraa ma7o oykite.<verse eid="PRO 20:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 20:17" />Wordon demmida kathi mal7ees;</para>
  <para style="q2" vid="PRO 20:17">shin aqidi pee7ishe doonan aceda hanees.<verse eid="PRO 20:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 20:18" />Zore ekada ne qofaa qacha;</para>
  <para style="q2" vid="PRO 20:18">zore ekonna de7ashe ola boopa.<verse eid="PRO 20:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 20:19" />Zigiriya asi xuura genthenna;</para>
  <para style="q2" vid="PRO 20:19">hessa gisho, coo haasaya asape haaka.<verse eid="PRO 20:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 20:20" />Ba aawa woyko ba aayiw baaddiya asa,</para>
  <para style="q2" vid="PRO 20:20">de7o xompey sakana dhuman to7ana.<verse eid="PRO 20:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 20:21" />Koyrora eeson shiiqida shaloy</para>
  <para style="q2" vid="PRO 20:21">wursethan anjetenna.<verse eid="PRO 20:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 20:22" />Nena qohida uraa qohada zaarana goopa;</para>
  <para style="q2" vid="PRO 20:22">Godan ammaneta; I nena ashshana.<verse eid="PRO 20:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 20:23" />Goday nam7u qommo mizaane ixees;</para>
  <para style="q2" vid="PRO 20:23">wordo mizaaney iya ufaysenna.<verse eid="PRO 20:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 20:24" />Asay baana ogiya Goday kaalethees;</para>
  <para style="q2" vid="PRO 20:24">yaatin, asi ba de7on baana ogiya</para>
  <para style="q2" vid="PRO 20:24">waatidi akeekanaw danda7ii?<verse eid="PRO 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 20:25" />Eeson, “Haysa taani Xoossas immas” guussinne</para>
  <para style="q2" vid="PRO 20:25">guyepe qiirotethi asas xihe.<verse eid="PRO 20:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 20:26" />Cinca kawoy geellata shaakidi erees;</para>
  <para style="q2" vid="PRO 20:26">I enta qadhetonna seerees.<verse eid="PRO 20:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 20:27" />Asa ayyaani Godaas xompe;</para>
  <para style="q2" vid="PRO 20:27">iya gaatha asatethaa ubbaa pilgidi xeellees.<verse eid="PRO 20:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 20:28" />Siiqoynne ammanetethi kawa naagoosona;</para>
  <para style="q2" vid="PRO 20:28">iya araatay tuma pirdan minnees.<verse eid="PRO 20:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 20:29" />Yalagata bonchoy enta wolqaa;</para>
  <para style="q2" vid="PRO 20:29">cimata bonchoy enta puulunthaa.<verse eid="PRO 20:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 20:30" />Mino seeri iitatethi shoddees;</para>
  <para style="q2" vid="PRO 20:30">wadhoy iita wozana laammees.<verse eid="PRO 20:30" /></para>
  <chapter eid="PRO 20" />
  <chapter number="21" style="c" sid="PRO 21" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 21:1" />Kawo wozani Godaa kushena;</para>
  <para style="q2" vid="PRO 21:1">iya wozanaa dhawa haathada</para>
  <para style="q2" vid="PRO 21:1">ba koyida soo zaarees.<verse eid="PRO 21:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 21:2" />Asi oothiyaba ubbay iyaw like daanees;</para>
  <para style="q2" vid="PRO 21:2">shin Goday iya wozanaa qofaa paacees.<verse eid="PRO 21:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 21:3" />Yarsho yarshanaape aathidi,</para>
  <para style="q2" vid="PRO 21:3">xillonne suure ootheysa Goday dosees.<verse eid="PRO 21:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 21:4" />Iitati otoroninne ceeqetethan eretoosona;</para>
  <para style="q2" vid="PRO 21:4">hessi qassi nagara.<verse eid="PRO 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 21:5" />Mino oothiya asa halchoy dureyees;</para>
  <para style="q2" vid="PRO 21:5">shin eesotiya ubbay manqees.<verse eid="PRO 21:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 21:6" />Wordon dagayida shaloy pentoda dhayees;</para>
  <para style="q2" vid="PRO 21:6">hessa koyeysati hayqo koyoosona.<verse eid="PRO 21:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 21:7" />Iitati suureba oothanaw koyonna gisho,</para>
  <para style="q2" vid="PRO 21:7">enta geella oosoy enta ekidi bees.<verse eid="PRO 21:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 21:8" />Nagaranchoti geella ogen hemetoosona;</para>
  <para style="q2" vid="PRO 21:8">shin geeshshati suureba oothosona.<verse eid="PRO 21:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 21:9" />Doonatiya machira issi keethan daanape</para>
  <para style="q2" vid="PRO 21:9">kare darmachan duussi lo77o.<verse eid="PRO 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 21:10" />Iitati iitaba oothanaw amottoosona;</para>
  <para style="q2" vid="PRO 21:10">banta shoorotas qadhetokona.<verse eid="PRO 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 21:11" />Qelqisiya asi seeretiya wode</para>
  <para style="q2" vid="PRO 21:11">wozani bayna uray cincatethi tamaarees;</para>
  <para style="q2" vid="PRO 21:11">wozanaama uray era demmees.<verse eid="PRO 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 21:12" />Xillo Xoossay iitata son oosetiyaba ubbaa be7ees;</para>
  <para style="q2" vid="PRO 21:12">enta shiri yeggidi dhaysees.<verse eid="PRO 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 21:13" />Manqota waasuwa si7anaape gidi,</para>
  <para style="q2" vid="PRO 21:13">ba haythaa tucciya uray, ika waassana;</para>
  <para style="q2" vid="PRO 21:13">I waassin alliya asi dhayana.<verse eid="PRO 21:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 21:14" />Geeman immiya imoy hanqo doshisees;</para>
  <para style="q2" vid="PRO 21:14">qosan immida wodhaafey hanqo irxisees.<verse eid="PRO 21:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 21:15" />Suure pirdi pirdetiya wode,</para>
  <para style="q2" vid="PRO 21:15">xilloti ufaytoosona;</para>
  <para style="q2" vid="PRO 21:15">shin iita ootheyisata daganthees.<verse eid="PRO 21:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 21:16" />Akeeka ogiya haakiya uraa</para>
  <para style="q2" vid="PRO 21:16">hayqoy naagees.<verse eid="PRO 21:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 21:17" />Injetin daana giya uray manqees;</para>
  <para style="q2" vid="PRO 21:17">woynenne zayte dosiya uray duretenna.<verse eid="PRO 21:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 21:18" />Xoossa asata ashshanaw iita asati seeretosona;</para>
  <para style="q2" vid="PRO 21:18">ammanetona asati suure asata gisho seeretosona.<verse eid="PRO 21:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 21:19" />Doonatiyanne yilotiya machira daanape</para>
  <para style="q2" vid="PRO 21:19">bazzon de7oy lo77o.<verse eid="PRO 21:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 21:20" />Wozanaama uraa son mal7o quminne oysi minjettees;</para>
  <para style="q2" vid="PRO 21:20">shin eeya asi de7iyaba ubbaa midigees.<verse eid="PRO 21:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 21:21" />Xillotethinne siiqo koyiya uraa laythay aduqees;</para>
  <para style="q2" vid="PRO 21:21">he uray xillotethinne boncho demmees.<verse eid="PRO 21:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 21:22" />Wozanaama asi wolqaama olanchota katamaa olidi oykees;</para>
  <para style="q2" vid="PRO 21:22">enti ammanetiya mino miixaa laallees.<verse eid="PRO 21:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 21:23" />Ba doonanne ba inxarsaa</para>
  <para style="q2" vid="PRO 21:23">naagiya asi bana metope naagees.<verse eid="PRO 21:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 21:24" />Otoreynne ceeqetey qelqisiya asi;</para>
  <para style="q2" vid="PRO 21:24">I otorancho gidida gisho asas qopenna.<verse eid="PRO 21:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 21:25" />Oothanaw koyonna gisho</para>
  <para style="q2" vid="PRO 21:25">azalla amoy wodhees.<verse eid="PRO 21:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 21:26" />Azalla asi ubba wode darobaa demmanaw amottees;</para>
  <para style="q2" vid="PRO 21:26">shin xilloy baw ashshona immees.<verse eid="PRO 21:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 21:27" />Goday iitata yarshuwa ixees;</para>
  <para style="q2" vid="PRO 21:27">enti iyaw iita qofan shiishiya yarshuwa aathidi ixees.<verse eid="PRO 21:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 21:28" />Wordo marki dhayana;</para>
  <para style="q2" vid="PRO 21:28">shin tuma marki eqidi daana.<verse eid="PRO 21:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 21:29" />Iita asi bessona xaala xaalees;</para>
  <para style="q2" vid="PRO 21:29">shin suure asi yuushshi qopees.<verse eid="PRO 21:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 21:30" />Asi ba cincatethan, akeekaninne zoren</para>
  <para style="q2" vid="PRO 21:30">Godaara eqetanaw danda7enna.<verse eid="PRO 21:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 21:31" />Olas para kooranaw danda7etees;</para>
  <para style="q2" vid="PRO 21:31">shin xoonoy Godaaba.<verse eid="PRO 21:31" /></para>
  <chapter eid="PRO 21" />
  <chapter number="22" style="c" sid="PRO 22" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 22:1" />Lo77o sunthi daro duretethafe aadhees;</para>
  <para style="q2" vid="PRO 22:1">bonchoy birapenne worqafe aadhees.<verse eid="PRO 22:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 22:2" />Durenne manqo Goday medhis;</para>
  <para style="q2" vid="PRO 22:2">hessan enti nam7ay issino.<verse eid="PRO 22:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 22:3" />Cinca asi iita be7idi qosetidi attees;</para>
  <para style="q2" vid="PRO 22:3">shin akeeki bayna asi meton gelidi qohetees.<verse eid="PRO 22:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 22:4" />Ashketethinne Godaa yashshi,</para>
  <para style="q2" vid="PRO 22:4">duretethi, bonchonne de7o immees.<verse eid="PRO 22:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 22:5" />Iitata ogen agunthinne xihey de7ees;</para>
  <para style="q2" vid="PRO 22:5">shin bana naagiya asi entafe haakees.<verse eid="PRO 22:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 22:6" />Na7i waanidi daanaw bessiyako tamaarsa;</para>
  <para style="q2" vid="PRO 22:6">I cimiya wodeka iyape haakenna.<verse eid="PRO 22:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 22:7" />Durey manquwa haarees;</para>
  <para style="q2" vid="PRO 22:7">tal7e ekiday tal7e immidaysas aylle gidees.<verse eid="PRO 22:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 22:8" />Nagara zeriya uray waaye cakees;</para>
  <para style="q2" vid="PRO 22:8">iya hanqo xam7ay meqana.<verse eid="PRO 22:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 22:9" />Ba kathaa manqotas shaakiya gisho</para>
  <para style="q2" vid="PRO 22:9">keeha asi anjetana.<verse eid="PRO 22:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 22:10" />Qelqisiya asi diggiko,</para>
  <para style="q2" vid="PRO 22:10">palami, ooshshinne cashshi attana.<verse eid="PRO 22:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 22:11" />Wozani geeshshi gidida asinne</para>
  <para style="q2" vid="PRO 22:11">lo77o oda dosiya asi kawora dabbotees.<verse eid="PRO 22:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 22:12" />Godaa ayfey eratethi naagees;</para>
  <para style="q2" vid="PRO 22:12">shin wordanchota qaala shiri yeggees.<verse eid="PRO 22:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 22:13" />Azalla asi, “Karen gaammoy de7ees;</para>
  <para style="q2" vid="PRO 22:13">tana ogen maana” yaagees.<verse eid="PRO 22:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 22:14" />Layma maccasa dooni wolqaama olla mela;</para>
  <para style="q2" vid="PRO 22:14">Goday hanqetidaysati iyan kundoosona.<verse eid="PRO 22:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 22:15" />Eeyatethi na7a wozanan de7ees;</para>
  <para style="q2" vid="PRO 22:15">shin pircoy iyape haassees.<verse eid="PRO 22:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 22:16" />Shalo shiishanaw manquwa naaqeynne</para>
  <para style="q2" vid="PRO 22:16">dure asas imota immiya nam7ay manqana.<verse eid="PRO 22:16" /></para>
  <para style="s1">Hastamu Cinca Zoreta</para>
  <para style="r">(<ref loc="PRO 22:17-24:22">22:17—24:22</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 22:17" />Ne haytha zaarada cincata qaala si7a;</para>
  <para style="q2" vid="PRO 22:17">ne wozanaa ta timirtiyako zaara.<verse eid="PRO 22:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 22:18" />Enta ne wozanan wothikonne</para>
  <para style="q2" vid="PRO 22:18">ne doonan enta haasayiko, ne ufaytana.<verse eid="PRO 22:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 22:19" />Ne ammanoy Godan gidana mela,</para>
  <para style="q2" vid="PRO 22:19">taani nena hachi tamaarsayis.<verse eid="PRO 22:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 22:20" />Taani new zorenne eratethi kumida</para>
  <para style="q2" vid="PRO 22:20">hastamu leemisota xaafas.<verse eid="PRO 22:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 22:21" />Nena kiittidaysas like zaaro zaarana mela,</para>
  <para style="q2" vid="PRO 22:21">taani nena tumatethi tamaarsas.<verse eid="PRO 22:21" /></para>
  <para style="s2">1</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 22:22" />Manqotas aybika bayna gisho, enta bonqofa;</para>
  <para style="q2" vid="PRO 22:22">pirdan enta maata dhaysofa.<verse eid="PRO 22:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 22:23" />Goday enta gisho mootetana;</para>
  <para style="q2" vid="PRO 22:23">enta bonqidaysata I bonqana.<verse eid="PRO 22:23" /></para>
  <para style="s2">2</para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 22:24" />Yilotiya uraara laggetopa;</para>
  <para style="q2" vid="PRO 22:24">elle shenetiya uraara hemetofa.<verse eid="PRO 22:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 22:25" />Neeni iya yiluwara meezetiko,</para>
  <para style="q2" vid="PRO 22:25">guyepe agganaw danda7aka.<verse eid="PRO 22:25" /></para>
  <para style="s2">3</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 22:26" />Asa aco ta qanxana gada</para>
  <para style="q2" vid="PRO 22:26">waase gidopa.<verse eid="PRO 22:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 22:27" />Ne qanxiyaba dhayiko,</para>
  <para style="q2" vid="PRO 22:27">ne zin7iya hiixay attonna,</para>
  <para style="q2" vid="PRO 22:27">new de7iyaba ubbay eketana.<verse eid="PRO 22:27" /></para>
  <para style="s2">4</para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 22:28" />Ne mayzati tokida</para>
  <para style="q2" vid="PRO 22:28">beni zawa shoddofa.<verse eid="PRO 22:28" /></para>
  <para style="s2">5</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 22:29" />Ba oosuwan loohida asi be7adii?</para>
  <para style="q2" vid="PRO 22:29">I coo asatas gidonashin kawotas oothees.<verse eid="PRO 22:29" /></para>
  <chapter eid="PRO 22" />
  <chapter number="23" style="c" sid="PRO 23" />
  <para style="s2">6</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 23:1" />Halaqara kathi maanaw uttiya wode,</para>
  <para style="q2" vid="PRO 23:1">neera de7eysa akeeka.<verse eid="PRO 23:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 23:2" />Neeni daro yaramba asi gidiko naageta.<verse eid="PRO 23:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 23:3" />I nena paacanaw danda7iya gisho,</para>
  <para style="q2" vid="PRO 23:3">mal7o kathas yaaretopa.<verse eid="PRO 23:3" /></para>
  <para style="s2">7</para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 23:4" />Duretana gada daaburopa;</para>
  <para style="q2" vid="PRO 23:4">ne qofaa haaranaw cinca gida.<verse eid="PRO 23:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 23:5" />Hessa mela duretethi ne xeellishin dhayana;</para>
  <para style="q2" vid="PRO 23:5">qefe kessidi arganthada salo paallana.<verse eid="PRO 23:5" /></para>
  <para style="s2">8</para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 23:6" />Uuze asa kathi moopa;</para>
  <para style="q2" vid="PRO 23:6">iya mal7o kathay nena amoyopo.<verse eid="PRO 23:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 23:7" />Qoodhepe qommon “Ma; uya” gees;</para>
  <para style="q2" vid="PRO 23:7">shin iya wozanay neera gidenna.<verse eid="PRO 23:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 23:8" />Ne mida guutha kathaaka cooyana;</para>
  <para style="q2" vid="PRO 23:8">ne galatay mela gidana.<verse eid="PRO 23:8" /></para>
  <para style="s2">9</para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 23:9" />Ne cincatetha haasaya kadhiya gisho,</para>
  <para style="q2" vid="PRO 23:9">eeya asas paxaba haasayopa.<verse eid="PRO 23:9" /></para>
  <para style="s2">10</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 23:10" />Beni zawa shoddofa;</para>
  <para style="q2" vid="PRO 23:10">yi7o nayta zawa sugopa.<verse eid="PRO 23:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 23:11" />Enta ashshiya Goday mino gidiya gisho;</para>
  <para style="q2" vid="PRO 23:11">i, enta gisho neera mootetana.<verse eid="PRO 23:11" /></para>
  <para style="s2">11</para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 23:12" />Ne wozanaa zore qaalako,</para>
  <para style="q2" vid="PRO 23:12">ne haytha timirteko zaara.<verse eid="PRO 23:12" /></para>
  <para style="s2">12</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 23:13" />Na7a seeronna aggofa;</para>
  <para style="q2" vid="PRO 23:13">ne iya pircon shociko I hayqenna.<verse eid="PRO 23:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 23:14" />Ne iya pircon shociko,</para>
  <para style="q2" vid="PRO 23:14">iya shempuwa hayqope ashshaasa.<verse eid="PRO 23:14" /></para>
  <para style="s2">13</para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 23:15" />Ta na7aw, ne wozanay cinca gidiko,</para>
  <para style="q2" vid="PRO 23:15">ta wozanay ufaytana.<verse eid="PRO 23:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 23:16" />Ne inxarsay suureba haasaya wode,</para>
  <para style="q2" vid="PRO 23:16">ta gaatha asatethay ufaytees.<verse eid="PRO 23:16" /></para>
  <para style="s2">14</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 23:17" />Nagaranchota qanaatopa;</para>
  <para style="q2" vid="PRO 23:17">shin ubba wode Godaa yayya.<verse eid="PRO 23:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 23:18" />Yaatiko new sintha de7oy suurana;</para>
  <para style="q2" vid="PRO 23:18">ne ufaysay dhayenna.<verse eid="PRO 23:18" /></para>
  <para style="s2">15</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 23:19" />Ta na7aw, si7a; cinca gida;</para>
  <para style="q2" vid="PRO 23:19">ne wozanaa suure ogiyan naaga.<verse eid="PRO 23:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 23:20" />Daro woyne ushshu uyeysataranne</para>
  <para style="q2" vid="PRO 23:20">asho maanaw yaareteysatara hemetofa.<verse eid="PRO 23:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 23:21" />Mathoteysatinne yarambati manqana;</para>
  <para style="q2" vid="PRO 23:21">dhisko daroy curqa mayzees.<verse eid="PRO 23:21" /></para>
  <para style="s2">16</para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 23:22" />Nena yelida ne aaway odiyaba si7a;</para>
  <para style="q2" vid="PRO 23:22">ne aayiya cimida wode kadhopa.<verse eid="PRO 23:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 23:23" />Tumaa, cinca, seeranne</para>
  <para style="q2" vid="PRO 23:23">akeeka shammafe attishin, bayzopa.<verse eid="PRO 23:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 23:24" />Xillo na7a aawi daro ufaytees;</para>
  <para style="q2" vid="PRO 23:24">wozanaama na7a yelida asi iyan ceeqetees.<verse eid="PRO 23:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 23:25" />Ne aawaynne ne aayiya nenan ufayto;</para>
  <para style="q2" vid="PRO 23:25">nena yelidaara hashshu go.<verse eid="PRO 23:25" /></para>
  <para style="s2">17</para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 23:26" />Ta na7aw, ne wozanaa taw imma;</para>
  <para style="q2" vid="PRO 23:26">ne ayfeti ta ogiya kallo.<verse eid="PRO 23:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 23:27" />Layma maccasi ciimmo haatha mela;</para>
  <para style="q2" vid="PRO 23:27">laggetho maccasi xuntha olla mela.<verse eid="PRO 23:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 23:28" />Iya paannoda zugada naagawusu;</para>
  <para style="q2" vid="PRO 23:28">ammanetona addeta darsawusu.<verse eid="PRO 23:28" /></para>
  <para style="s2">18</para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 23:29" />Waasoy oossee? Azzanoy oossee?</para>
  <para style="q2" vid="PRO 23:29">Ooshshi oossee? Zuuzunthi oossee?</para>
  <para style="q1" vid="PRO 23:29">Gaasoy bayna madunxethi oossee?</para>
  <para style="q2" vid="PRO 23:29">Ayfe zo7oy oossee?<verse eid="PRO 23:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 23:30" />Woyne ushshu uyishe wode ongeysatasa gidennee?</para>
  <para style="q2" vid="PRO 23:30">Walahetida woyne ushsha</para>
  <para style="q2" vid="PRO 23:30">ganxidi be7eysatasa gidennee?<verse eid="PRO 23:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 23:31" />Woyne ushshi zo7ida wode,</para>
  <para style="q2" vid="PRO 23:31">iya malay birille giddon phooliya wode,</para>
  <para style="q2" vid="PRO 23:31">uyin mal7ishe geliya wode iya xeellofa.<verse eid="PRO 23:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 23:32" />Wursethan shooshada I dukees;</para>
  <para style="q2" vid="PRO 23:32">iita shooshada ba marziya puukees.<verse eid="PRO 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 23:33" />Ne ayfey be7i eronnabaa be7ana;</para>
  <para style="q2" vid="PRO 23:33">ne wozanay suure qopanaw danda7enna.<verse eid="PRO 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 23:34" />Neeni abba giddon zin7ida,</para>
  <para style="q2" vid="PRO 23:34">markabiya tuussa bolla katida ase daanasa.<verse eid="PRO 23:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="PRO 23:35" />Neeni, “Enti tana dechidosona;</para>
  <para style="q2" vid="PRO 23:35">shin ta qohetabike.</para>
  <para style="q1" vid="PRO 23:35">Enti tana wadhidosona;</para>
  <para style="q2" vid="PRO 23:35">shin taw eretibeenna.</para>
  <para style="q1" vid="PRO 23:35">Hara ushshu uyanaw</para>
  <para style="q2" vid="PRO 23:35">taani awude dendanee?” yaagana.<verse eid="PRO 23:35" /></para>
  <chapter eid="PRO 23" />
  <chapter number="24" style="c" sid="PRO 24" />
  <para style="s2">19</para>
  <para style="q1">
    <verse number="1" style="v" sid="PRO 24:1" />Ta na7aw, iita asata qanaatopa;</para>
  <para style="q2" vid="PRO 24:1">entara laggetanaw amottofa.<verse eid="PRO 24:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 24:2" />Enti ubba wode iitabaa maqetoosona;</para>
  <para style="q2" vid="PRO 24:2">banta inxarsan gene haasayoosona.<verse eid="PRO 24:2" /></para>
  <para style="s2">20</para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 24:3" />Keethi cincatethan keexetees;</para>
  <para style="q2" vid="PRO 24:3">akeekan minnees.<verse eid="PRO 24:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 24:4" />Eri de7iko, qol7i</para>
  <para style="q2" vid="PRO 24:4">al7obaaninne lo77oban kumees.<verse eid="PRO 24:4" /></para>
  <para style="s2">21</para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 24:5" />Cinca asi wolqaama asape aadhees;</para>
  <para style="q2" vid="PRO 24:5">era asi mino asape lo77o.<verse eid="PRO 24:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 24:6" />Olas keyanaape koyro halchanaw koshshees;</para>
  <para style="q2" vid="PRO 24:6">daro zore zoriya asatan xoonoy bentees.<verse eid="PRO 24:6" /></para>
  <para style="s2">22</para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 24:7" />Eeya asi cincatethi akeekanaw danda7enna;</para>
  <para style="q2" vid="PRO 24:7">shiiqo bessan I odiyabay aybika baawa.<verse eid="PRO 24:7" /></para>
  <para style="s2">23</para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 24:8" />Iita oothanaw qopiya asi</para>
  <para style="q2" vid="PRO 24:8">gene asi geetetees.<verse eid="PRO 24:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 24:9" />Eeya asa qofi nagara;</para>
  <para style="q2" vid="PRO 24:9">qelqisiya asi ixetees.<verse eid="PRO 24:9" /></para>
  <para style="s2">24</para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 24:10" />Meto wode ne dol7iko,</para>
  <para style="q2" vid="PRO 24:10">ne wolqay guutha.<verse eid="PRO 24:10" /></para>
  <para style="s2">25</para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 24:11" />Pirdi bayna hayqos beyisata ashsha;</para>
  <para style="q2" vid="PRO 24:11">shukettanaw biya wode si77i gada xeellofa.<verse eid="PRO 24:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 24:12" />Ne, “Ta hessa erike” giiko,</para>
  <para style="q2" vid="PRO 24:12">wozana eriya i, be7ennee?</para>
  <para style="q1" vid="PRO 24:12">Ne de7uwa naageysi erennee?</para>
  <para style="q2" vid="PRO 24:12">Asa ubbaas iya oosuwada oosuwada zaarennee?<verse eid="PRO 24:12" /></para>
  <para style="s2">26</para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 24:13" />Ta na7aw, eessi lo77o gidiya gisho,</para>
  <para style="q2" vid="PRO 24:13">eessi ma; ililo eessi mal7ees.<verse eid="PRO 24:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 24:14" />Cincatethika hessada</para>
  <para style="q2" vid="PRO 24:14">ne shempuwas mal7o gideysa era.</para>
  <para style="q1" vid="PRO 24:14">Neeni iya demmiyaba gidiko,</para>
  <para style="q2" vid="PRO 24:14">sinthara yaana keehay nebaa;</para>
  <para style="q2" vid="PRO 24:14">ne ufaysay dhayenna.<verse eid="PRO 24:14" /></para>
  <para style="s2">27</para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 24:15" />Xillo asa keethi bonqanaw naagopa;</para>
  <para style="q2" vid="PRO 24:15">iya aquwa dhaysanaw dendofa.<verse eid="PRO 24:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 24:16" />Xillo asi laapun toho kundikoka dendees;</para>
  <para style="q2" vid="PRO 24:16">shin iitati gadon dhayana.<verse eid="PRO 24:16" /></para>
  <para style="s2">28</para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 24:17" />Ne morkey kundiya wode ufaytofa;</para>
  <para style="q2" vid="PRO 24:17">I dhubetiya wode hashshu goopa.<verse eid="PRO 24:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 24:18" />Goday hessa be7idi ufaytenna;</para>
  <para style="q2" vid="PRO 24:18">iya hanqetonna aggaagana.<verse eid="PRO 24:18" /></para>
  <para style="s2">29</para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 24:19" />Iita ootheyisata gaason hirgofa;</para>
  <para style="q2" vid="PRO 24:19">enta mela gidarkina gada qopofa.<verse eid="PRO 24:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 24:20" />Iita asas sinthara yaana keehi baawa;</para>
  <para style="q2" vid="PRO 24:20">iitata xompey to7ana.<verse eid="PRO 24:20" /></para>
  <para style="s2">30</para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 24:21" />Ta na7aw, Godaanne kawa yayya;</para>
  <para style="q2" vid="PRO 24:21">enta bolla makalleysatara hemetofa.<verse eid="PRO 24:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 24:22" />Hessa mela asata qoponna metoy gakees;</para>
  <para style="q2" vid="PRO 24:22">kawuwapenne Godaape yaana meto oone erey?<verse eid="PRO 24:22" /></para>
  <para style="s1">Hara Cinca Zoreta</para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 24:23" />Cincati gujidi haysada yaagidosona;</para>
  <para style="q1" vid="PRO 24:23">Som7o be7idi pirdoy lo77o gidenna.<verse eid="PRO 24:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 24:24" />Qohidaysa lo77o oothadasa</para>
  <para style="q2" vid="PRO 24:24">giya daynna, asi baaddana;</para>
  <para style="q2" vid="PRO 24:24">kawotethati iya ixana.<verse eid="PRO 24:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 24:25" />Qohidaysa ne bala</para>
  <para style="q2" vid="PRO 24:25">giya daynnati lo77oba ekana</para>
  <para style="q2" vid="PRO 24:25">daro anjo demmana.<verse eid="PRO 24:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 24:26" />Tuma zaaro zaariya asi,</para>
  <para style="q2" vid="PRO 24:26">tuma lagge mela.<verse eid="PRO 24:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 24:27" />Kasetada ne gadiya goya; kathi zera;</para>
  <para style="q2" vid="PRO 24:27">hessafe guye, ne keethaa keexa.<verse eid="PRO 24:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 24:28" />Ne shooruwa bolla gaasoy bayna markatofa;</para>
  <para style="q2" vid="PRO 24:28">ne doonan cimmofa.<verse eid="PRO 24:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 24:29" />“I taw oothidaysada ta iyaw oothana;</para>
  <para style="q2" vid="PRO 24:29">ta iyaw kushe zaarana” yaagopa.<verse eid="PRO 24:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 24:30" />Taani booza asa goshshara aadhas;</para>
  <para style="q2" vid="PRO 24:30">azalla addiya woyne gadera kanthas.<verse eid="PRO 24:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 24:31" />Agunthinne sharaafi goozi wothis;</para>
  <para style="q2" vid="PRO 24:31">yuushon de7iya dirsayka laaletis.<verse eid="PRO 24:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 24:32" />Taani iya be7ida wode qopas;</para>
  <para style="q2" vid="PRO 24:32">iyape timirte ekas.<verse eid="PRO 24:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 24:33" />Neeni guuthu liipha; guuthu dhiska;</para>
  <para style="q2" vid="PRO 24:33">ne kushiya shiishada guuthu shempa.<verse eid="PRO 24:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="PRO 24:34" />Shin manqotethi paannoda yaana;</para>
  <para style="q2" vid="PRO 24:34">duussa waayey ola miishe oykida asada puttu gaana.<verse eid="PRO 24:34" /></para>
  <chapter eid="PRO 24" />
  <chapter number="25" style="c" sid="PRO 25" />
  <para style="s1">Hara Solomone Leemisota</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 25:1" />Haysati Yihuda kawa Hizqiyaasa asati duuqidi xaafida Solomone leemisota.<verse eid="PRO 25:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 25:2" />Xuura genthoy Xoossas boncho;</para>
  <para style="q2" vid="PRO 25:2">xuura pilgidi kesoy kawotas boncho.<verse eid="PRO 25:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 25:3" />Saloy dhoqu gidaysadanne</para>
  <para style="q2" vid="PRO 25:3">sa7i ziqa gididaysada</para>
  <para style="q2" vid="PRO 25:3">kawota qofaa asi eranaw danda7enna.<verse eid="PRO 25:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 25:4" />Birape qita digga;</para>
  <para style="q2" vid="PRO 25:4">hessafe guye, hiillanchoy loythana.<verse eid="PRO 25:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 25:5" />Kawo sinthafe iita asata digga;</para>
  <para style="q2" vid="PRO 25:5">iya araatay xillotethan minnidi eqana.<verse eid="PRO 25:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 25:6" />Kawo sinthan eqiya wode ceeqetofa;</para>
  <para style="q2" vid="PRO 25:6">gita asata giddon new besse koyopa.<verse eid="PRO 25:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 25:7" />Neepe gitatiya asas besse immanaw</para>
  <para style="q2" vid="PRO 25:7">halaqay nena denthin, kawuyeysafe,</para>
  <para style="q2" vid="PRO 25:7">I nena, “Ha dhoqa bessan utta” geysi lo77o.<verse eid="PRO 25:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 25:8" />Ne ayfen be7idaba markatanaw</para>
  <para style="q2" vid="PRO 25:8">daynna sinthe baanaw ellesopa.</para>
  <para style="q1" vid="PRO 25:8">Ne markata simmin hara asi</para>
  <para style="q2" vid="PRO 25:8">ne markatethay bala gideysa qoncisiko, ne yeellatana.<verse eid="PRO 25:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 25:9" />Ne giddoninne ne shooruwa giddon palami medhetiko,</para>
  <para style="q2" vid="PRO 25:9">iyara odetada ne palama wursa;</para>
  <para style="q2" vid="PRO 25:9">hara asa xuura qoncisopa.<verse eid="PRO 25:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 25:10" />Hessi hanonna ixiko ne odeysa si7ida asi</para>
  <para style="q2" vid="PRO 25:10">nena kawushana;</para>
  <para style="q2" vid="PRO 25:10">ne sunthay zaaridi simmonnaada iitana.<verse eid="PRO 25:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 25:11" />Bessiya wode odetida like qaali,</para>
  <para style="q2" vid="PRO 25:11">bira miishe bolla tigetida worqa alleeqo mela.<verse eid="PRO 25:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 25:12" />Era asi zoriya zore si7iya haythas,</para>
  <para style="q2" vid="PRO 25:12">hessi worqafe woyko geeshsha worqafe</para>
  <para style="q2" vid="PRO 25:12">oosetida alleeqo mela.<verse eid="PRO 25:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 25:13" />Katha cakiya wode irxa haathi uyin aleysada,</para>
  <para style="q2" vid="PRO 25:13">ammanthiya kiitanchoy bana kiittoysa ufaysees.<verse eid="PRO 25:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 25:14" />Immonnaba immana gidi ceeqetiya asi</para>
  <para style="q2" vid="PRO 25:14">iri bayna shaaranne carko mela.<verse eid="PRO 25:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 25:15" />Danda7a asi halaqa odidi mayzees;</para>
  <para style="q2" vid="PRO 25:15">liiqo qaali meqethi kanthi gelees.<verse eid="PRO 25:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 25:16" />Eessi demmiko kallana gakanaw ma;</para>
  <para style="q2" vid="PRO 25:16">shin darsiko nena cooshshana.<verse eid="PRO 25:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 25:17" />Nena uufishe ixonnaada,</para>
  <para style="q2" vid="PRO 25:17">ne shooruwa soo ubba wode boopa.<verse eid="PRO 25:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 25:18" />Ba shooruwa bolla wordon markatiya asi,</para>
  <para style="q2" vid="PRO 25:18">xam7i, mashshinne toori qoheysada qohees.<verse eid="PRO 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="PRO 25:19" />Meto wode ammanetona asan zempoy,</para>
  <para style="q2" vid="PRO 25:19">qaaxiya achan coommiyanne</para>
  <para style="q2" vid="PRO 25:19">silida tohon hemeteysa mela.<verse eid="PRO 25:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 25:20" />Azzanida asas yethi yexiya asi,</para>
  <para style="q2" vid="PRO 25:20">meego wode ma7o qaariyanne</para>
  <para style="q2" vid="PRO 25:20">maduntha bolla caalaba tigiya asa mela.<verse eid="PRO 25:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 25:21" />Ne morkey koshatiko muza;</para>
  <para style="q2" vid="PRO 25:21">saamotiko ushsha.<verse eid="PRO 25:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 25:22" />Ne hessa oothiko iya huuphen tama bonqo</para>
  <para style="q2" vid="PRO 25:22">kaashidi qoleysa mela;</para>
  <para style="q2" vid="PRO 25:22">Goday nena woytana.<verse eid="PRO 25:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 25:23" />Doloha bagga carkoy ira eheysada,</para>
  <para style="q2" vid="PRO 25:23">zigirsi hanqo ehees.<verse eid="PRO 25:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 25:24" />Doonatiya machira issi keethan daanape</para>
  <para style="q2" vid="PRO 25:24">kare barandan duussi lo77o.<verse eid="PRO 25:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 25:25" />Daaburida asi irxa haathi uyidi aleysada,</para>
  <para style="q2" vid="PRO 25:25">haaho biittafe yaa lo77o odi ufaysees.<verse eid="PRO 25:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 25:26" />Iita asa sinthan gulbatiya xillo asi,</para>
  <para style="q2" vid="PRO 25:26">buullotida pultonne iitida olla haatha mela.<verse eid="PRO 25:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 25:27" />Daro eessi muussi lo77o gidenna;</para>
  <para style="q2" vid="PRO 25:27">hessadaka, ba boncho koshshi bonchisenna.<verse eid="PRO 25:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 25:28" />Bana haaronna asi</para>
  <para style="q2" vid="PRO 25:28">dirsi laaletida katama mela.<verse eid="PRO 25:28" /></para>
  <chapter eid="PRO 25" />
  <chapter number="26" style="c" sid="PRO 26" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 26:1" />Bone shachi, kathi cakiya wode iri koshshonaysada,</para>
  <para style="q2" vid="PRO 26:1">eeyas boncho koshshenna.<verse eid="PRO 26:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 26:2" />Kafoti yaanne haanne piradhishe ase qohonnaysada,</para>
  <para style="q2" vid="PRO 26:2">gaasoy bayna baaddiya baadethi ase gakenna.<verse eid="PRO 26:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 26:3" />Paras lisso, hares bixaala koshsheysada</para>
  <para style="q2" vid="PRO 26:3">eeya zokos xam7a koshshees.<verse eid="PRO 26:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 26:4" />Eeya asas iya eeyatethaada zaaropa;</para>
  <para style="q2" vid="PRO 26:4">zaariko ne iya mela gidana.<verse eid="PRO 26:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 26:5" />Eeya asas iya eeyatetha qoncisada zaara;</para>
  <para style="q2" vid="PRO 26:5">hessi hanonna ixiko I bana cinca gidi qopana.<verse eid="PRO 26:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 26:6" />Eeya asa bolla kiita yedoy,</para>
  <para style="q2" vid="PRO 26:6">ba toho qanxi yeggeysa mela</para>
  <para style="q2" vid="PRO 26:6">woyko wodhiyaba uyeysa mela.<verse eid="PRO 26:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 26:7" />Eeya asa leemisoy,</para>
  <para style="q2" vid="PRO 26:7">silida toho mela maaddenna.<verse eid="PRO 26:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 26:8" />Eeya asas boncho imoy,</para>
  <para style="q2" vid="PRO 26:8">shuchu yambarshan qachi wothidi</para>
  <para style="q2" vid="PRO 26:8">yambaranaw paaciya asa mela.<verse eid="PRO 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PRO 26:9" />Eeya asa leemisoy</para>
  <para style="q2" vid="PRO 26:9">mathotida asi ba kushe caddida agunthu</para>
  <para style="q2" vid="PRO 26:9">kessanaw baaxeteysa mela.<verse eid="PRO 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 26:10" />Eeya asa woyko ba oge biya asi</para>
  <para style="q2" vid="PRO 26:10">une oosisanaw qaxariya asi</para>
  <para style="q2" vid="PRO 26:10">ba toora shaaran xongiya asa mela.<verse eid="PRO 26:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="PRO 26:11" />Kani ba cooshshako guye simmidi laaceysada,</para>
  <para style="q2" vid="PRO 26:11">eeya asi ba eeyatetha zaari zaari qoncisees.<verse eid="PRO 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PRO 26:12" />Bana cinca oothidi xeelliya asape</para>
  <para style="q2" vid="PRO 26:12">eeya asas lo77o qaadi de7ees.<verse eid="PRO 26:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="PRO 26:13" />“Azalla asi ogen gaammoy de7ees;</para>
  <para style="q2" vid="PRO 26:13">yashshiya gaammoy ogen yuuyees” yaagees.<verse eid="PRO 26:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PRO 26:14" />Sanqi maxaafe bolla yaanne haanne qaaxeysada,</para>
  <para style="q2" vid="PRO 26:14">azalla asi ba hiixan yaanne haanne shiretees.<verse eid="PRO 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PRO 26:15" />Issi issi azalla asi hari attoshin,</para>
  <para style="q2" vid="PRO 26:15">woxen tushidi baaranaw waayetees.<verse eid="PRO 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="PRO 26:16" />Azalla asi markara odiya laapun cincatape</para>
  <para style="q2" vid="PRO 26:16">bana aadhida cinca gidi qopees.<verse eid="PRO 26:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PRO 26:17" />Bana gathiyabay baynaban palamiya asi</para>
  <para style="q2" vid="PRO 26:17">ogera biya kana haythi oykiya asa mela.<verse eid="PRO 26:17" /></para>
  <para style="p">
    <verse number="18-19" style="v" sid="PRO 26:18-19" />Ba shooruwa, “Taani kaasse gayis”</para>
  <para style="q2" vid="PRO 26:18-19">yaagidi cimmiya asi,</para>
  <para style="q2" vid="PRO 26:18-19">gooyidi bonqo tama holiya,</para>
  <para style="q2" vid="PRO 26:18-19">woyko wodhiya donge toora dukiya asa mela.<verse eid="PRO 26:18-19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="PRO 26:20" />Mithi wuriko tami to7ees;</para>
  <para style="q2" vid="PRO 26:20">zigirsi dhayiko ooshshi attees.<verse eid="PRO 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PRO 26:21" />Xiifi bonqo darseysadanne</para>
  <para style="q2" vid="PRO 26:21">mithi tama darseysada</para>
  <para style="q2" vid="PRO 26:21">palama darsiya asi ooshshu darsees.<verse eid="PRO 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="PRO 26:22" />Zigirsa qaali mal7o katha mela</para>
  <para style="q2" vid="PRO 26:22">ufaysishe duge ganje bees.<verse eid="PRO 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PRO 26:23" />Wozanan iitabay de7ishin,</para>
  <para style="q2" vid="PRO 26:23">ba inxarsan cimo qaala haasaya asi</para>
  <para style="q2" vid="PRO 26:23">biran lanxetida urqa miishe mela.<verse eid="PRO 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="PRO 26:24" />Gene asi ba wozanan de7iya iitatethaa</para>
  <para style="q2" vid="PRO 26:24">ba inxarsan genthees.<verse eid="PRO 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 26:25" />Iya wozanan laapun tunati kumida gisho,</para>
  <para style="q2" vid="PRO 26:25">I lo77o qaala haasaykoka iya ammanopa.<verse eid="PRO 26:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="PRO 26:26" />Ba morketetha I genthikoka,</para>
  <para style="q2" vid="PRO 26:26">I oothiya iitay dabaaban qoncana.<verse eid="PRO 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PRO 26:27" />Haratas olla bookiya asi he ollan baw kundana;</para>
  <para style="q2" vid="PRO 26:27">harata bolla shuchu gondorsiya asa bolla</para>
  <para style="q2" vid="PRO 26:27">he shuchay simmidi gondoretana.<verse eid="PRO 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="PRO 26:28" />Wordotiya inxarsi ba qohida asata ixees;</para>
  <para style="q2" vid="PRO 26:28">cimo odi kundethi kaalethees.<verse eid="PRO 26:28" /></para>
  <chapter eid="PRO 26" />
  <chapter number="27" style="c" sid="PRO 27" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 27:1" />Wontoy ehanaba ne eronna gisho</para>
  <para style="q2" vid="PRO 27:1">wontoban ceeqetofa.<verse eid="PRO 27:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 27:2" />Hara asi nena galatope attishin neeni nena galatopa;</para>
  <para style="q2" vid="PRO 27:2">asi ne gisho markatofe attishin, neeni ne keehatethabaa odopa.<verse eid="PRO 27:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 27:3" />Shuchi gita tooho; shafey deexo;</para>
  <para style="q2" vid="PRO 27:3">shin eeya asi medhiya ooshshi</para>
  <para style="q2" vid="PRO 27:3">nam7aafeka deexees.<verse eid="PRO 27:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 27:4" />Hanqos qadhey baawa;</para>
  <para style="q2" vid="PRO 27:4">yiloy dhaysiya di7o mela;</para>
  <para style="q2" vid="PRO 27:4">shin qanaatey ubbaafe iita.<verse eid="PRO 27:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 27:5" />Geemmida siiqope</para>
  <para style="q2" vid="PRO 27:5">baliya wode qoncen hanqetethi lo77o.<verse eid="PRO 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 27:6" />Morkey nena tammu toho yeeranaape</para>
  <para style="q2" vid="PRO 27:6">siiqoy nena madunxiseysi lo77o.<verse eid="PRO 27:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 27:7" />Kallida asi ililo eessi shaattees;</para>
  <para style="q2" vid="PRO 27:7">shin koshatida uraa cammiyabay mal7ees.<verse eid="PRO 27:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 27:8" />Ba soo aggidi yuuyiya asi,</para>
  <para style="q2" vid="PRO 27:8">ba keethaa aggada paalliya kafo mela.<verse eid="PRO 27:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 27:9" />Shittoynne sawiya ixaaney ase ufayseysada</para>
  <para style="q2" vid="PRO 27:9">siiqo lagge zorey hessada ufaysees.<verse eid="PRO 27:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 27:10" />Ne laggetanne ne aawa laggeta aggofa;</para>
  <para style="q2" vid="PRO 27:10">ne metootida wode ne ishaa soo boopa;</para>
  <para style="q2" vid="PRO 27:10">haahon de7iya ishape matan de7iya shooroy lo77o.<verse eid="PRO 27:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 27:11" />Ta na7aw, cinca gida; tana ufaysa;</para>
  <para style="q2" vid="PRO 27:11">tana kadhiya asaas ta zaaro immana.<verse eid="PRO 27:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 27:12" />Cinca asi metoy yaa wode be7idi qosetees;</para>
  <para style="q2" vid="PRO 27:12">shin akeeki bayna asi bidi meton gelees;</para>
  <para style="q2" vid="PRO 27:12">yaatidi guyepe qiirotees.<verse eid="PRO 27:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 27:13" />Eronna asas waase geliya uraa ma7uwa qaari ekite;</para>
  <para style="q2" vid="PRO 27:13">imatha asas waase gelida uraa ma7uwa oykite.<verse eid="PRO 27:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 27:14" />Wonta guura ba qaala dhoqu oothidi,</para>
  <para style="q2" vid="PRO 27:14">ba shooruwa sarotey iya baaddiya asa mela.<verse eid="PRO 27:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 27:15" />Doonatiya machanne</para>
  <para style="q2" vid="PRO 27:15">aathiya keethi issino.<verse eid="PRO 27:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 27:16" />Carko teqanaw, zayte kuucidi oykanaw danda7etonaysada,</para>
  <para style="q2" vid="PRO 27:16">iyo si77i oothanaw danda7etenna.<verse eid="PRO 27:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 27:17" />Birati birata posheysada,</para>
  <para style="q2" vid="PRO 27:17">asi issoy issuwafe tamaarees.<verse eid="PRO 27:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 27:18" />Balase mithi loythidi naagiya asi iya ayfe maana;</para>
  <para style="q2" vid="PRO 27:18">ba halaqaa kaaboya oosanchoy bonchetana.<verse eid="PRO 27:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 27:19" />Haathi mastooteda som7o besseysada,</para>
  <para style="q2" vid="PRO 27:19">asa wozani iya oonatetha bessees.<verse eid="PRO 27:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 27:20" />Hayqoynne Duufoy kalli eronnaysada,</para>
  <para style="q2" vid="PRO 27:20">asa ayfey kallidi erenna.<verse eid="PRO 27:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 27:21" />Birinne worqey taman paacetidi geeyeysada,</para>
  <para style="q2" vid="PRO 27:21">asi ba ekiya galatan paacetees.<verse eid="PRO 27:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 27:22" />Kathi udulan caddeysada,</para>
  <para style="q2" vid="PRO 27:22">eeya asi udulan caddiyakoka</para>
  <para style="q2" vid="PRO 27:22">iyape eeyatethay kichenna.<verse eid="PRO 27:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 27:23" />Ne dorsata hanota loythada era;</para>
  <para style="q2" vid="PRO 27:23">ne wudiyaka akeekada heemma.<verse eid="PRO 27:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 27:24" />Ayis giiko, duretethi merinaw deenna;</para>
  <para style="q2" vid="PRO 27:24">kallachika yeletethafe yeletethaas aadhenna.<verse eid="PRO 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PRO 27:25" />Mela maatay buucetin, aaca maati keya wode,</para>
  <para style="q2" vid="PRO 27:25">deriya bolla de7iya maatay shiiqidaape guye,<verse eid="PRO 27:25" /></para>
  <para style="q2">
    <verse number="26" style="v" sid="PRO 27:26" />dorsata ikisepe ne new ma7o kessana;</para>
  <para style="q2" vid="PRO 27:26">deeshata bayzada gade shammana.<verse eid="PRO 27:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 27:27" />Attida deeshata maathay new,</para>
  <para style="q2" vid="PRO 27:27">ne soo asaasinne ne macca aylletas kathi gidana.<verse eid="PRO 27:27" /></para>
  <chapter eid="PRO 27" />
  <chapter number="28" style="c" sid="PRO 28" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 28:1" />Iitati oonika yedethonna baqatoosona;</para>
  <para style="q2" vid="PRO 28:1">shin xilloti gaammo mela yayyonna de7oosona.<verse eid="PRO 28:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 28:2" />Issi kawotethay makalliko, haareysati daroosona;</para>
  <para style="q2" vid="PRO 28:2">shin kaaletheysi cincanne akeekancho gidiko,</para>
  <para style="q2" vid="PRO 28:2">sarotethinne wopi de7ees.<verse eid="PRO 28:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 28:3" />Manqota un7ethiya kawoy</para>
  <para style="q2" vid="PRO 28:3">kathi dhaysiya wolqaama ira mela.<verse eid="PRO 28:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 28:4" />Higge bonchona asi iita asaa sabbees;</para>
  <para style="q2" vid="PRO 28:4">shin higge bonchiya asi iita asaa ixees.<verse eid="PRO 28:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 28:5" />Iita asatas suure pirdi gelenna;</para>
  <para style="q2" vid="PRO 28:5">shin Godaa goyinniya asi ubbaa akeekes.<verse eid="PRO 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="PRO 28:6" />Dure gididi cimmiya asi gidanaape,</para>
  <para style="q2" vid="PRO 28:6">suure asi gididi manqo gideysi lo77o.<verse eid="PRO 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="PRO 28:7" />Higge naagiya na7ay akeeka na7a;</para>
  <para style="q2" vid="PRO 28:7">shin pathonna asara hemetey ba aawa yeellayees.<verse eid="PRO 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PRO 28:8" />Mishe yelon tal7eynne ase bonqidi duretiya asi</para>
  <para style="q2" vid="PRO 28:8">he aquwa manqotas keehiya asas shiishees.<verse eid="PRO 28:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 28:9" />Higge si7anaape gidi ba haytha tucciya,</para>
  <para style="q2" vid="PRO 28:9">uraa woosay Godaa sinthan ixetidaba.<verse eid="PRO 28:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 28:10" />Suureta iita ogen kaalethiya uray</para>
  <para style="q2" vid="PRO 28:10">ba bookida ollan kundana;</para>
  <para style="q2" vid="PRO 28:10">shin geeshshati lo77oba laattana.<verse eid="PRO 28:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 28:11" />Dure asi bana cinca gidi qopees;</para>
  <para style="q2" vid="PRO 28:11">shin akeeki de7iya manqoy iya paacees.<verse eid="PRO 28:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 28:12" />Xilloti xooniya wode asa ubbay ufaytees;</para>
  <para style="q2" vid="PRO 28:12">shin iitati maata oykiya wode asay qosetees.<verse eid="PRO 28:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 28:13" />Ba nagaraa genthiya asi aacenna;</para>
  <para style="q2" vid="PRO 28:13">shin paaxeynne nagara aggey maarota ekana.<verse eid="PRO 28:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 28:14" />Godaa ubba wode yayiya asi anjetidaysa;</para>
  <para style="q2" vid="PRO 28:14">shin ba wozana minthiya asi meton gelana.<verse eid="PRO 28:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 28:15" />Manqo asaa haariya iita halaqay,</para>
  <para style="q2" vid="PRO 28:15">gudiya gaammonne koshatida babantha mela.<verse eid="PRO 28:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 28:16" />Akeeki bayna kawoy ba deriya qohees;</para>
  <para style="q2" vid="PRO 28:16">shin ase qohonna halaqi daro laythi haarana.<verse eid="PRO 28:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 28:17" />Ase wodhiya asi hayqana gakanaw baqatishe de7ees;</para>
  <para style="q2" vid="PRO 28:17">iya oonika maaddenna.<verse eid="PRO 28:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 28:18" />Borey bayna hemetiya asi qohetenna;</para>
  <para style="q2" vid="PRO 28:18">shin geella asi akeekona kundana.<verse eid="PRO 28:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 28:19" />Minnidi oothiya asi kathi kallees;</para>
  <para style="q2" vid="PRO 28:19">shin pathonna amo kaalliya asi manqotethi laattana.<verse eid="PRO 28:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 28:20" />Ammanetiya uray daro anjetana;</para>
  <para style="q2" vid="PRO 28:20">shin duretanaw woxiya asi meto be7ana.<verse eid="PRO 28:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 28:21" />Som7o be7idi pirdoy lo77o gidenna;</para>
  <para style="q2" vid="PRO 28:21">shin asi baso uytha gisho gidi qohees.<verse eid="PRO 28:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 28:22" />Yaare asi duretanaw baqetees;</para>
  <para style="q2" vid="PRO 28:22">manqotethi akeekona oykanaysa erenna.<verse eid="PRO 28:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 28:23" />Ase coo sabbiya asape</para>
  <para style="q2" vid="PRO 28:23">hanqetiya asi guyepe galatetees.<verse eid="PRO 28:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 28:24" />Ba aawanne ba aayiw kaysotidi, “Nagara oothabike”</para>
  <para style="q2" vid="PRO 28:24">giya asinne demmidaba dhaysiya asi issino.<verse eid="PRO 28:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 28:25" />Uuze asi ooshshi denthees;</para>
  <para style="q2" vid="PRO 28:25">shin Godan ammanetiya asi kallees.<verse eid="PRO 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 28:26" />Banan ammanetiya asi eeya;</para>
  <para style="q2" vid="PRO 28:26">shin cincatethan hemetiya asi saro de7ees.<verse eid="PRO 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 28:27" />Manqos immiya asi metootenna;</para>
  <para style="q2" vid="PRO 28:27">shin enta be7anaape gidi qilim7ey baadetana.<verse eid="PRO 28:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 28:28" />Iita asati shuumetiya wode asay qosetees;</para>
  <para style="q2" vid="PRO 28:28">shin enti dhayiya wode xilloti daroosona.<verse eid="PRO 28:28" /></para>
  <chapter eid="PRO 28" />
  <chapter number="29" style="c" sid="PRO 29" />
  <para style="p">
    <verse number="1" style="v" sid="PRO 29:1" />Daro wode seeretidi simmonna asi</para>
  <para style="q2" vid="PRO 29:1">hassayonna meqana;</para>
  <para style="q2" vid="PRO 29:1">he uraas paxoy baawa.<verse eid="PRO 29:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 29:2" />Xillo asati shuumetiya wode asay ufaytees;</para>
  <para style="q2" vid="PRO 29:2">shin iitati biitta haariya wode asay un7etees.<verse eid="PRO 29:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 29:3" />Cincatethi dosiya asi ba aawa ufaysees;</para>
  <para style="q2" vid="PRO 29:3">shin layma maccasa heeran yuuyiya asi ba miishiya wursees.<verse eid="PRO 29:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 29:4" />Tuma pirdan kawoy ba kawotethaa wopu oothees;</para>
  <para style="q2" vid="PRO 29:4">shin wodhaafe ekiya kawoy ba kawotethaa dhaysees.<verse eid="PRO 29:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 29:5" />Ba shooruwa cimon sabbiya asi,</para>
  <para style="q2" vid="PRO 29:5">ba tohos xihe yeggees.<verse eid="PRO 29:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 29:6" />Iita asi ba nagaran oyketees;</para>
  <para style="q2" vid="PRO 29:6">shin xillo asi ufaytees; yexees.<verse eid="PRO 29:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 29:7" />Xillo asi manqotas suure pirdees;</para>
  <para style="q2" vid="PRO 29:7">shin iita asati hessa erokona.<verse eid="PRO 29:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 29:8" />Cayiya asati kataman ooshshu denthoosona;</para>
  <para style="q2" vid="PRO 29:8">shin cinca asati hanqo irxisoosona.<verse eid="PRO 29:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 29:9" />Cinca asi eeya asa pirda keethi efiko,</para>
  <para style="q2" vid="PRO 29:9">eeyay hanqetees; qidhees; iyaw saroy baawa.<verse eid="PRO 29:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 29:10" />Suuthu gussanaw saamotiya asati suure asi ixoosona;</para>
  <para style="q2" vid="PRO 29:10">xillo asaa wodhanaw koyoosona.<verse eid="PRO 29:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 29:11" />Eeya asi ba hanquwa yeddi bessees;</para>
  <para style="q2" vid="PRO 29:11">shin cinca asi bana haarees.<verse eid="PRO 29:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 29:12" />Shuumay wordo oda si7iyaba gidiko,</para>
  <para style="q2" vid="PRO 29:12">iya moorinnati ubbay iita gidoosona.<verse eid="PRO 29:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 29:13" />Manqoynne ase naaqiya asi issiba koxoosona;</para>
  <para style="q2" vid="PRO 29:13">enta nam7aas ayfe immiday Godaa.<verse eid="PRO 29:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 29:14" />Kawoy manqotas suure pirdiko,</para>
  <para style="q2" vid="PRO 29:14">I ba araatan gam7ana.<verse eid="PRO 29:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 29:15" />Pircon seeri naytas cincatethi immees;</para>
  <para style="q2" vid="PRO 29:15">shin yedan diccida na7i ba aayiw kawushshees.<verse eid="PRO 29:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 29:16" />Iita asati dariya wode nagari darees;</para>
  <para style="q2" vid="PRO 29:16">shin xilloti enta kundethaa be7ana.<verse eid="PRO 29:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 29:17" />Ne na7aa seera;</para>
  <para style="q2" vid="PRO 29:17">I new saro immana;</para>
  <para style="q2" vid="PRO 29:17">I nena ufaysana.<verse eid="PRO 29:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 29:18" />Qoncethi bayna ixiko derey yeda gidees;</para>
  <para style="q2" vid="PRO 29:18">shin higge naagiya asi anjetidaysa.<verse eid="PRO 29:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 29:19" />Aylley coo oda xalaalan seeretenna;</para>
  <para style="q2" vid="PRO 29:19">iyaw geliyakoka I kiitetenna.<verse eid="PRO 29:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 29:20" />Eeson haasaya asi be7a eray?</para>
  <para style="q2" vid="PRO 29:20">Iyape eeya asas ufaysi de7ees.<verse eid="PRO 29:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 29:21" />Ne aylliya na7a yeda dichiko,</para>
  <para style="q2" vid="PRO 29:21">iya wursethay azzano gidana.<verse eid="PRO 29:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 29:22" />Hanqetiya asi ooshshu denthethees;</para>
  <para style="q2" vid="PRO 29:22">elle yilotiya asi daro nagara oothees.<verse eid="PRO 29:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 29:23" />Otoroy ase kawushshees;</para>
  <para style="q2" vid="PRO 29:23">shin ashke ayyaani de7iya asi bonchetees.<verse eid="PRO 29:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 29:24" />Kaysora laggetiya asi bana ixiya asi;</para>
  <para style="q2" vid="PRO 29:24">I dabaaban tuma odiko seeretees;</para>
  <para style="q2" vid="PRO 29:24">I tumaa odonna ixiko Godan baadetana.<verse eid="PRO 29:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 29:25" />Asas yashshi he uraas xihe gidees;</para>
  <para style="q2" vid="PRO 29:25">shin Godan ammanetiya asi saro de7ees.<verse eid="PRO 29:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 29:26" />Daroti maati de7iya asape made koyoosona;</para>
  <para style="q2" vid="PRO 29:26">shin suure pirdi Godaape bentees.<verse eid="PRO 29:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 29:27" />Xilloti nagaranchota shaatettoosona;</para>
  <para style="q2" vid="PRO 29:27">iitati suure asaa ixoosona.<verse eid="PRO 29:27" /></para>
  <chapter eid="PRO 29" />
  <chapter number="30" style="c" sid="PRO 30" />
  <para style="s1">Agura Leemisota</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 30:1" />Yaaqe na7aa Agura leemisoti haysafe kaallidi xaafetidaysata. Aguri Iti7eelasinne Ukaalas haysa haasayis. <verse eid="PRO 30:1" /><verse number="2" style="v" sid="PRO 30:2" />Taani asa ubbaafe aadhida eeya;</para>
  <para style="q2" vid="PRO 30:2">asas de7iya akeeki taw deenna.<verse eid="PRO 30:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="PRO 30:3" />Taani cincatethi tamaarabike;</para>
  <para style="q2" vid="PRO 30:3">Geeshsha Xoossabaaka erike.<verse eid="PRO 30:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 30:4" />Salo pude keyidi duge wodhiday oonee?</para>
  <para style="q2" vid="PRO 30:4">Carko ba kushen oykiday,</para>
  <para style="q2" vid="PRO 30:4">haathe ba afilan yiiciday,</para>
  <para style="q2" vid="PRO 30:4">sa7aa gaxaa minthidi essiday oonee?</para>
  <para style="q1" vid="PRO 30:4">Iya sunthay oonee?</para>
  <para style="q2" vid="PRO 30:4">Iya na7aa sunthay oonee?</para>
  <para style="q2" vid="PRO 30:4">Iya eriya gidiko ane taw oda?<verse eid="PRO 30:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 30:5" />Xoossa qaalan borey baawa; ubbay tuma</para>
  <para style="q2" vid="PRO 30:5">iyan ammanetiya ubbaas I gondalle.<verse eid="PRO 30:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 30:6" />Iya qaala bolla aybaka gujofa;</para>
  <para style="q2" vid="PRO 30:6">gujiko I nena seerana;</para>
  <para style="q2" vid="PRO 30:6">ne wordancho gideysa I qoncisana.<verse eid="PRO 30:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 30:7" />Godaw, ta nena nam7ubba oychayis;</para>
  <para style="q2" vid="PRO 30:7">ta hayqana gakanaw enta tana diggofa.<verse eid="PRO 30:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 30:8" />Ta ase cimmonna melanne wordo haasayonna mela tana naaga;</para>
  <para style="q2" vid="PRO 30:8">taw koshshiya kathi immafe attishin, tana dure woyko manqo oothofa.<verse eid="PRO 30:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 30:9" />Dure gidada, “Goday oonee?” gada nena kaddana;</para>
  <para style="q2" vid="PRO 30:9">manqo gidada, kaysada ta Xoossaa sunthaa cayisana.<verse eid="PRO 30:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PRO 30:10" />Nena baaddonna melanne</para>
  <para style="q2" vid="PRO 30:10">iya baadethay new gome gidonna mela,</para>
  <para style="q2" vid="PRO 30:10">aylliya iya godaara zigropa.<verse eid="PRO 30:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 30:11" />Ba aawa baaddiyanne ba aayiw anjona yeletethi de7ees.<verse eid="PRO 30:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 30:12" />Daro tuna gidi uttidi</para>
  <para style="q2" vid="PRO 30:12">bantana geeshshi oothiya asati de7oosona.<verse eid="PRO 30:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 30:13" />Otoron kumida asatinne</para>
  <para style="q2" vid="PRO 30:13">ase kadhidi xeelliya asati de7oosona.<verse eid="PRO 30:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 30:14" />Enta achay mashshe gidin,</para>
  <para style="q2" vid="PRO 30:14">enta gaccoy toora gidin,</para>
  <para style="q2" vid="PRO 30:14">manqotanne metootanchota naaqidi,</para>
  <para style="q2" vid="PRO 30:14">entaba bonqiya asati de7oosona.<verse eid="PRO 30:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 30:15" />Ullathas nam7u macca nayti de7oosona;</para>
  <para style="q2" vid="PRO 30:15">enti, “Hamma! Hamma!” yaagidi waassoosona.</para>
  <para style="q1" vid="PRO 30:15">Kallidi eronna heedzubati de7oosona;</para>
  <para style="q2" vid="PRO 30:15">oyddanthoy qassi “Gidana” gidi erenna.<verse eid="PRO 30:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 30:16" />Hessati,</para>
  <para style="q2" vid="PRO 30:16">duufo,</para>
  <para style="q2" vid="PRO 30:16">maynnida maccas,</para>
  <para style="q2" vid="PRO 30:16">haathe kallidi eronna mela biittanne,</para>
  <para style="q2" vid="PRO 30:16">“Gidana!” gidi eronna tama.<verse eid="PRO 30:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 30:17" />Ba aawa leqiya na7aa ayfiya,</para>
  <para style="q2" vid="PRO 30:17">ba aayiya cimin kadhiya na7aa ayfiya,</para>
  <para style="q2" vid="PRO 30:17">zangaaran de7iya quuroti woocana;</para>
  <para style="q2" vid="PRO 30:17">iya ashuwa ankoti maana.<verse eid="PRO 30:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 30:18" />Tana heedzubati malaalsoosona;</para>
  <para style="q2" vid="PRO 30:18">oyddanthoy ubba taw gelenna.<verse eid="PRO 30:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 30:19" />Hessati,</para>
  <para style="q2" vid="PRO 30:19">salora paalliya arganthi,</para>
  <para style="q2" vid="PRO 30:19">zaalla bollara kolxiya shooshi</para>
  <para style="q2" vid="PRO 30:19">abba bollara biya markabenne</para>
  <para style="q2" vid="PRO 30:19">geela7ora shiiqo oyketida adde.<verse eid="PRO 30:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 30:20" />Layma maccasi haniya hanoyka hessa mela;</para>
  <para style="q2" vid="PRO 30:20">Iya masu; shin ba doona quchada,</para>
  <para style="q2" vid="PRO 30:20">“Taani aykoka balabiike” yaagawusu.<verse eid="PRO 30:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 30:21" />Heedzuban biitti qaaxees;</para>
  <para style="q2" vid="PRO 30:21">oyddanthuwa ubba tookanaw danda7etenna.<verse eid="PRO 30:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 30:22" />Hessatika,</para>
  <para style="q2" vid="PRO 30:22">aylley kawotida wode,</para>
  <para style="q2" vid="PRO 30:22">eeya asi kathi kallida wode,<verse eid="PRO 30:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="PRO 30:23" />asi ixida maccasi azina gelida wodenne</para>
  <para style="q2" vid="PRO 30:23">macca aylliya ba godatiw laattida wode medhetiya hanota.<verse eid="PRO 30:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 30:24" />Sa7a bolla oyddu guutha medhetethati de7oosona;</para>
  <para style="q2" vid="PRO 30:24">shin enti aadhida cinca.<verse eid="PRO 30:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 30:25" />Hessatika,</para>
  <para style="q1" vid="PRO 30:25">Cuncalley wolqi bayna medhetethi;</para>
  <para style="q2" vid="PRO 30:25">shin bantaw miyaba bone shiishidi, minjoosona.<verse eid="PRO 30:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 30:26" />Gupaleti wolqi baynayisata;</para>
  <para style="q2" vid="PRO 30:26">shin banta keetha zaalla qophon keexoosona.<verse eid="PRO 30:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 30:27" />Booletas kawoy baawa;</para>
  <para style="q2" vid="PRO 30:27">shin enti ubbay maaran zattoosona.<verse eid="PRO 30:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 30:28" />Zareti kushen oyketoosona;</para>
  <para style="q2" vid="PRO 30:28">shin kawo gadhon de7oosona.<verse eid="PRO 30:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 30:29" />Banta maata bessishe hemetiya heedzu medhetethati de7oosona;</para>
  <para style="q2" vid="PRO 30:29">oyddanthoy lo77o hemethi hemetees.<verse eid="PRO 30:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 30:30" />Hessika,</para>
  <para style="q2" vid="PRO 30:30">do7a ubbaafe minonne yashshi eronna gaammo.<verse eid="PRO 30:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 30:31" />Macca kuttota giddon hemetiya adde kutto,</para>
  <para style="q2" vid="PRO 30:31">wude kaalethiya deesha kole;</para>
  <para style="q2" vid="PRO 30:31">ba olanchota giddon qoncen eqiya kawa.<verse eid="PRO 30:31" /></para>
  <para style="q1">
    <verse number="32" style="v" sid="PRO 30:32" />Neeni eeyada otortidaba gidikoka,</para>
  <para style="q2" vid="PRO 30:32">iita oothanaw halchidaba gidiko,</para>
  <para style="q2" vid="PRO 30:32">ane taki gada qopa.<verse eid="PRO 30:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="PRO 30:33" />Maathi bukey oysu kesseysada,</para>
  <para style="q2" vid="PRO 30:33">siidhe dichin suuthi yeysada,</para>
  <para style="q2" vid="PRO 30:33">hanqo denthethoy ooshshu ehees.<verse eid="PRO 30:33" /></para>
  <chapter eid="PRO 30" />
  <chapter number="31" style="c" sid="PRO 31" />
  <para style="s1">Kawa Limu7eela Leemisota</para>
  <para style="p">
    <verse number="1" style="v" sid="PRO 31:1" />Haysafe kaallidi xaafetida leemisoy, kawa Limu7eela aayiya kawa Limu7eela tamaarsidaysa.<verse eid="PRO 31:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="PRO 31:2" />Ta na7aw, ta ulope wodhidayso,</para>
  <para style="q2" vid="PRO 31:2">taani qangetada yelidayso,<verse eid="PRO 31:2" /></para>
  <para style="q2">
    <verse number="3" style="v" sid="PRO 31:3" />maccasan ne wolqaa wursofa;</para>
  <para style="q2" vid="PRO 31:3">kawota dhaysiya maccasatan ne minotethaa dhaysofa.<verse eid="PRO 31:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="PRO 31:4" />“Limu7eela, woyne ushshi kawotas bessenna;</para>
  <para style="q2" vid="PRO 31:4">mathoyiya ushshi shuumatas bessenna.<verse eid="PRO 31:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="PRO 31:5" />Enti uyaa wode higge baloosona;</para>
  <para style="q2" vid="PRO 31:5">naaqetida asaa maata qelli goosona.<verse eid="PRO 31:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PRO 31:6" />Mathoyaa ushshu hayqana haniya uraasinne</para>
  <para style="q2" vid="PRO 31:6">sa7i iitida uraas immite.<verse eid="PRO 31:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PRO 31:7" />Enti banta manqotethaanne</para>
  <para style="q2" vid="PRO 31:7">banta waayiya doganaw uyo.<verse eid="PRO 31:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PRO 31:8" />Banta gisho odetanaw danda7onna asaa gisho ne odeeta;</para>
  <para style="q2" vid="PRO 31:8">maaddiya asi baynayisata gisho ne eqa.<verse eid="PRO 31:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PRO 31:9" />Enta miyen eqada entaw suure pirda;</para>
  <para style="q2" vid="PRO 31:9">manqotanne metootanchota maata naaga” yaagada tamaarsasu.<verse eid="PRO 31:9" /></para>
  <para style="s1">Wozanaama Macho</para>
  <para style="p">
    <verse number="10" style="v" sid="PRO 31:10" />“Wozanaama macho ooni demmanaw danda7ii?</para>
  <para style="q2" vid="PRO 31:10">I gatey zo7o al7o shuchafe aadhees.<verse eid="PRO 31:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PRO 31:11" />I azinay iyo ammanetees;</para>
  <para style="q2" vid="PRO 31:11">iyaw koshshiyabaape aybika pacenna.<verse eid="PRO 31:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="PRO 31:12" />Iya ba de7o laytha ubban,</para>
  <para style="q2" vid="PRO 31:12">iyaw lo77obaape attishin, iitaba oothuku.<verse eid="PRO 31:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="PRO 31:13" />Suufenne liino koyada,</para>
  <para style="q2" vid="PRO 31:13">ufaytashe ba kushen oothawusu.<verse eid="PRO 31:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="PRO 31:14" />Iya zal7anchota markabe mela;</para>
  <para style="q2" vid="PRO 31:14">ba kathaa haaho biittafe shiishawusu.<verse eid="PRO 31:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="PRO 31:15" />Iya ba soo asaas kathi giigisanawunne</para>
  <para style="q2" vid="PRO 31:15">ba macca aylletas ooso immanaw,</para>
  <para style="q2" vid="PRO 31:15">sa7i wontonna de7ishin dendawusu.<verse eid="PRO 31:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="PRO 31:16" />Lo77o gade koyada shammawusu;</para>
  <para style="q2" vid="PRO 31:16">ba kushen oothada demmida</para>
  <para style="q2" vid="PRO 31:16">miishen woyne tokawusu.<verse eid="PRO 31:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="PRO 31:17" />Iya ba xeessa minthada dancawusu;</para>
  <para style="q2" vid="PRO 31:17">ba qesiya oosos minthawusu.<verse eid="PRO 31:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="PRO 31:18" />Iya wodhe demmanaw minnada zal7awusu;</para>
  <para style="q2" vid="PRO 31:18">iya oothashe qamisiya gisho I xompey to7enna.<verse eid="PRO 31:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="PRO 31:19" />Iya ba hindziritiya oykawusu;</para>
  <para style="q2" vid="PRO 31:19">ba biradhen loythada suqawusu.<verse eid="PRO 31:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="PRO 31:20" />Iya manqotasinne metootanchotas immawusu.<verse eid="PRO 31:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="PRO 31:21" />I soo asa ubbay ho77iya ma7o ma7iya gisho,</para>
  <para style="q2" vid="PRO 31:21">shachi bukikoka iya hirguku.<verse eid="PRO 31:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="PRO 31:22" />Alga bolla hiixiya ma7o sikawusu;</para>
  <para style="q2" vid="PRO 31:22">liinope oosetida ocha teera daaniya ma7o ma7awusu.<verse eid="PRO 31:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="PRO 31:23" />Biitta cimati shiiqiya dubbushan</para>
  <para style="q2" vid="PRO 31:23">I azinay bonchetida asi.<verse eid="PRO 31:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="PRO 31:24" />Liinope ma7onne danco oothada,</para>
  <para style="q2" vid="PRO 31:24">zal7anchotas bayzawusu.<verse eid="PRO 31:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="PRO 31:25" />Iya minonne boncho asi;</para>
  <para style="q2" vid="PRO 31:25">yaana laytha ubban ufaytada de7awusu.<verse eid="PRO 31:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="PRO 31:26" />Cincatethan ba doona dooyawusu;</para>
  <para style="q2" vid="PRO 31:26">ammanthiya zorey I inxarsan de7ees.<verse eid="PRO 31:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="PRO 31:27" />Iya ba soo asaa de7uwa injeyanaw ubba wode oothawusu;</para>
  <para style="q2" vid="PRO 31:27">azallatethi I bolla bentidi erenna.<verse eid="PRO 31:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="PRO 31:28" />I nayti dendidi, iyo nashshoosona;</para>
  <para style="q2" vid="PRO 31:28">I azinay iyo yaagidi galatees;<verse eid="PRO 31:28" /></para>
  <para style="q1">
    <verse number="29" style="v" sid="PRO 31:29" />Lo77oba oothiya daro maccasati de7oosona;</para>
  <para style="q2" vid="PRO 31:29">shin ne enta ubbaafe aadhasa” yaagees.<verse eid="PRO 31:29" /></para>
  <para style="q1">
    <verse number="30" style="v" sid="PRO 31:30" />Mali cimmees;</para>
  <para style="q2" vid="PRO 31:30">yegelssatethi dhayana.</para>
  <para style="q1" vid="PRO 31:30">Shin Godaa yayiya maccasiya,</para>
  <para style="q2" vid="PRO 31:30">iya anjetidaaro.<verse eid="PRO 31:30" /></para>
  <para style="q1">
    <verse number="31" style="v" sid="PRO 31:31" />Iya oothidaba ubbaas iyo woytite;</para>
  <para style="q2" vid="PRO 31:31">I ooso ubbay dabaaban iyo galatiso.<verse eid="PRO 31:31" /></para>
  <chapter eid="PRO 31" />
</usx>