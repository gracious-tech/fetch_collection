<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Marqoosa Wongela</para>
  <para style="toc1">Marqoosa Wongela</para>
  <para style="toc3">Mar</para>
  <para style="toc2">Marqoosa</para>
  <para style="mt1">Marqoosi Xaafida</para>
  <para style="mt2">Yesuus Kiristoosa Wongela</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Marqoosa Wongelay koyro doomishe, “Haysi Xoossa na7aa Yesuus Kiristoosa Wongela doomethi” yaagees. Ha Wongelan Yesuusi ooso asinne maata aawa gididi bentees. Iya maatay, iya timirtiyan, tuna ayyaana bolla de7iya wolqaaninne ase nagarape maaron qoncidi eretis. Yesuusi, “Taani, ase nagara aylletethafe kessanaw ta shempuwa aathada immanaw yida Asa Na7aa” yaagidi ba doonan odis.</para>
  <para style="ip">Marqoosi Yesuusa taarikiya suurenne wolqara de7iya ogen odis. Marqoosi Yesuusa qaalanne timirtiya gidonashin, I oothida malaalsiya oosota bayrayidi odees. Marqoosi Xammaqiya Yohaanisa taarikiya, Yesuusa xinqatiya, iya paacetetha, iya timirtiyanne I ase pathida ogeta dalgisidi odees. Aqi aqi bishin Yesuusa tamaareti, Yesuusa gujidi eri eri bidosona, shin Yesuusa ixeysati aathidi ixishe bidosona. Maxaafa wursetha shempoti wursetha saamintan, Yesuusa de7on poletida oosota, hessatika iya kaqetethaanne iya denduwa odoosona.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Wongela doomethi <char style="ior">(<ref loc="MRK 1:1-13">1:1-13</ref>)</char></para>
  <para style="io1">Yesuusi ba oosuwa Galilan doomis <char style="ior">(<ref loc="MRK 1:14-9:50">1:14—9:50</ref>)</char></para>
  <para style="io1">Yesuusi Yerusalaamen oothida oosuwa <char style="ior">(<ref loc="MRK 10:1-52">10:1-52</ref>)</char></para>
  <para style="io1">Yerusalaame heeran aathida wursetha saaminta <char style="ior">(<ref loc="MRK 11:1-15:47">11:1—15:47</ref>)</char></para>
  <para style="io1">Yesuusi hayqope denduwa <char style="ior">(<ref loc="MRK 16:1-8">16:1-8</ref>)</char></para>
  <para style="io1">Hayqope dendidi asaas bentonne salo buussu <char style="ior">(<ref loc="MRK 16:9-20">16:9-20</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s1">Xammaqiya Yohaanisi Oge Pitetha</para>
  <para style="r">(<ref loc="MAT 3:1-12">Maato 3:1-12</ref>; <ref loc="LUK 3:1-18">Luqa 3:1-18</ref>; <ref loc="JHN 1:19-28">Yoha 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Haysi Xoossa Na7a Yesuus Kiristoosa wongelaa doomethi. <verse eid="MRK 1:1"/><verse number="2" style="v" sid="MRK 1:2"/>Nabiya Isayaasi xaafida maxaafan Xoossay,</para>
  <para style="q1" vid="MRK 1:2">“Heko, taani ta kiitanchuwa</para>
  <para style="q2" vid="MRK 1:2">taani neepe sinthe yeddana.</para>
  <para style="q1" vid="MRK 1:2">I ne ogiya giigisana.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="MAL 3:1">Milki 3:1</ref>.</char></note><verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>Issoy mela biittan ba qaala dhoqu oothidi,</para>
  <para style="q2" vid="MRK 1:3">‘Godaa ogiya giigisite;</para>
  <para style="q1" vid="MRK 1:3">I hemetana horoga</para>
  <para style="q2" vid="MRK 1:3">iyaw suurisite gis’ ”</para>
  <para style="m" vid="MRK 1:3">yaagees.<note caller="-" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">Isa 40:3</ref>.</char></note><verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>Xammaqiya Yohaanisi asaa xammaqishe, “Hinte nagaraape simmidi xammaqetite; Xoossay hinte nagaraa atto gaana” yaagidi qaala odishe mela biittafe yis. <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>Yihuda biittan de7iya asa ubbaynne Yerusalaame katamaa asa ubbay Yohaanisako yoosona. Banta nagara paaxin, Yohaanisi enta Yordaanose Shaafan xammaqees.<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>Yohaanisi gimale ikisepe dadetida afila ma77ees. Ba xeessan dafo dancees; qassi boolenne degera eessi mees.<note caller="-" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 Kawo 1:8</ref>.</char></note> <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>Yohaanisi qaala odishe, “Taape guyera daro minneysi yees. Hari attoshin, taani iya caammaa wodoruwa hokada billanaw bessike. <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>Taani hintena haathan xammaqayis, shin I hintena Geeshsha Ayyaanan xammaqana” yaagis.<verse eid="MRK 1:8"/></para>
  <para style="s1">Yesuusa Xammaqetethinne Paacetethi</para>
  <para style="r">(<ref loc="MAT 3:13-17">Maato 3:13-17</ref>; <ref loc="MAT 4:1-11">4:1-11</ref>; <ref loc="LUK 3:21-22">Luqa 3:21-22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>Yesuusi he wode Galila biittan de7iya Naazirete katamaape yin, Yohaanisi Yordaanose Shaafan iya xammaqis. <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>Yesuusi haathaafe keyiya wode saloy dooyetin, Geeshsha Ayyaanay ba bolla holleda wodhishin be7is. <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/>Qassi salope, “Taani dosiya ta na7ay nena; ta nenan ufaytayis” giya qaalay yis.<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="GEN 22:2">Medhe 22:2</ref>; <ref loc="PSA 2:7">Maz 2:7</ref>; <ref loc="ISA 42:1">Isa 42:1</ref>; <ref loc="MAT 3:17">Maato 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">Mar 9:7</ref>; <ref loc="LUK 3:22">Luqa 3:22</ref>.</char></note><verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>Iira Geeshsha Ayyaanay Yesuusa mela biitta efis. <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>Yesuusi mela biittan Xalahen paacetishe oytamu gallas gam7is. Do7atara de7is, shin kiitanchoti yidi iya maaddidosona.<verse eid="MRK 1:13"/></para>
  <para style="s1">Yesuusi Xeegida Koyro Tamaareta</para>
  <para style="r">(<ref loc="MAT 4:12-22">Maato 4:12-22</ref>; <ref loc="LUK 4:14-15">Luqa 4:14-15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>Yohaanisi qashetidaape guye, Yesuusi Xoossaa kawotethaa Wongela odishe Galila biitta bis. <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/>Yan, “Wodey gakis; Xoossaa kawotethay matatis. Hinte nagaraape simmidi, Wongelan ammanite” yaagis.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Maato 3:2</ref>.</char></note><verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>Yesuusi Galila Abbaa matara aadhishe, molo oykiya, Simoonanne iya ishaa Indiriyasa, banta gitiya abban yeggeyisata be7is. <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>Entako, “Tana kaallite; taani hintena ase oythu tamaarsana” yaagis. <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>Enti ellesidi banta gitiya yeggi aggidi Yesuusa kaallidosona.<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>Yesuusi guuthi sinthe bidi, nam7u ishata Zabdiyoosa nayta, Yayqoobanne Yohaanisa wogoluwa giddon banta gitiya giigiseyisata be7is. <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>I enta be7ida mela xeegis. Enti banta aawa Zabdiyoosa, iya oosanchotara wogoluwa giddon yeggi aggidi Yesuusa kaallidi bidosona.<verse eid="MRK 1:20"/></para>
  <para style="s1">Tuna Ayyaani Oykida Ura</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luqa 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>Enti Qifirnahooma katamaa gelidosona. Sambaati gelida mela Yesuusi ellesidi ayhude woosa keethi gelidi tamaarso oykis. <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/>Maatara de7iya asada tamaarsesipe attishin, higge astamaaretatho tamaarsonna gisho, asay iya timirtiyan malaaletidosona.<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">Maato 7:28</ref>.</char></note><verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>He wode tuna ayyaanay oykida issi uray ayhude woosa keethi gelidi ba qaala dhoqu oothidi, <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>“Naazirete Yesuusa, neeni nuupe ay koyay? Nuna dhaysanaw yadii? Neeni ooneko ta erayis; neeni Xoossaa Geeshshaa gidikii?” yaagis.<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>Yesuusi he tuna ayyaana, “Hayza, ha addiyafe keya” gidi kiittis.<verse eid="MRK 1:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26"/>Tuna ayyaanay uraa daferethidi, waassidi iyape keyis. <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>Asa ubbay malaaletidi, “Haysi aybee? Ha uray ba maatan hari attoshin tuna ayyaanataka kiittees. Enti iyaw kiitetoosona; haysi aybi ooratha timirtee?” gidi, banta giddon issoy issuwa oychidosona.<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>Yesuusa sunthay ellesidi Galila biittan de7iya heera ubban keyis.<verse eid="MRK 1:28"/></para>
  <para style="s1">Daro Harganchoti Paxidosona</para>
  <para style="r">(<ref loc="MAT 8:14-17">Maato 8:14-17</ref>; <ref loc="LUK 4:38-41">Luqa 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>Yesuusi ayhude woosa keethafe keyidi, Yayqoobaranne Yohaanisara Simoona soonne Indiriyasa soo bis. <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>Simoona mache aayiya qoxo misha hargada zin7idaaro Yesuusi yaa gakiya wode iyaw odidosona. <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>I iiko shiiqidi, I kushiya oykidi, iyo denthidi essis. Qoxoynne mishay aggin iya enta mokasu.<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Hargida asa ubbaanne tuna ayyaanati oykida asa ubbaa omarsi away wullidaape guye, iyako ehidosona. <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>Kataman de7iya asa ubbay he keetha kare shiiqidosona. <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>Yesuusi dumma dumma hargen oyketida daro asaa pathidi, daro tuna ayyaanata kessis. I ooneko tuna ayyaanati erida gisho, enta odisonna diggis.<verse eid="MRK 1:34"/></para>
  <para style="s1">Yesuusi Galilan Tamaarso Doometha</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luqa 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>Yesuusi wonta guura dendidi, asi bayna bessi bidi, yan Xoossaa woossis. <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>Simooninne iyara de7eysati iya koyishe bidosona. <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>Enti iya demmidi, “Asa ubbay nena koyees” yaagidosona.<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>Yesuusi qassi enta, “He heeran de7iya hara katamata yedhite. Taani yiday Wongela odanaw gidiya gisho yanka qaala odanaw bessees” yaagis. <verse eid="MRK 1:38"/><verse number="39" style="v" sid="MRK 1:39"/>Ayhude woosa keethatan qaala odishenne tuna ayyaanata kessishe, Galila biitta ubban yuuyis.<note caller="-" style="x"><char style="xo" closed="false">1:39 </char><char style="xt" closed="false"><ref loc="MAT 4:23">Maato 4:23</ref>; <ref loc="MAT 9:35">9:35</ref>.</char></note><verse eid="MRK 1:39"/></para>
  <para style="s1">Baro Harganchuwa</para>
  <para style="r">(<ref loc="MAT 8:1-4">Maato 8:1-4</ref>; <ref loc="LUK 5:12-17">Luqa 5:12-17</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>Baroy oykida issi uray Yesuusako yidi, iya sinthan gulbatidi, “Neeni koyko tana geeshshanaw danda7aasa” yaagidi woossis.<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>Yesuusi iyaw qadhetidi, ba kushiya yeddidi iya bochidi, “Taani koyayis, geeyiya” yaagis. <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>Ellesidi baroy uraa yeddin uray paxis. <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>Yesuusi uraa minthi naagisidi kessi yeddis. <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/>Yesuusi iya, “Nena era, haysa oodeska odopa. Shin bada ne asatethaa kahine bessa. Neeni ha77i geeshshi gididaysa asaa erisanaw, Musey kiitida yarshuwa yarsha” yaagis.<note caller="-" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1">Leewe 14:1</ref>.</char></note><verse eid="MRK 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>Shin uray bidi, guta ubban asa ubbaas odis. Hessa gisho, Yesuusi qonce keyidi, katama gelanaw danda7ibeenna. Shin asi bayna bessan gaxan de7is; qassi asay ubba bessafe iyako yoosona.<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s1">Gunda Ura</para>
  <para style="r">(<ref loc="MAT 9:1-8">Maato 9:1-8</ref>; <ref loc="LUK 5:17-26">Luqa 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>Guutha gallasape guye, Yesuusi Qifirnahooma simmidi, son de7ees giya oday si7etis. <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>Asaa keethay ekonna ixin, hari attoshin kareyka xuummana gakanaw daro asay shiiqin, Yesuusi qaala tamaarsis. <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>Oyddu asati issi gunda uraa tookidi iyako ehidosona. <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>Asay darida gisho, uraa Yesuusako shiishanaw entaw danda7etonna ixin, Yesuusi de7iya ginara keetha qaaridi, kaara qawuxidi uraa I zin7ida algara duge yeddidi Yesuusa sinthan wodhisidosona. <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>Yesuusi enta ammanuwa be7idi, he gunda uraa, “Ta na7aw, ne nagaray atto geetetis” yaagis.<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>Higge astamaaretape he bessan uttida issoti issoti banta wozanan, <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>“La ha uray haysa mela iitabaa Xoossaa bolla ayis odeetii? Xoossaa xalaalape attishin, hari ooni nagara atto gaanaw danda7ii?” gidi qopidosona.<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>Enti banta wozanan hessada qopidaysa Yesuusi ellesidi ba ayyaanan eridi, entako, “Hinte hinte wozanan ayis hessada qopeetii? <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/>Gunda uraa, ‘Ne nagaray atto geetetis’ geysi mateyee? Woyko, ‘Denda eqada ne algaa tookada ba’ geysi matee? <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/>Shin taw, Asa Na7aas, sa7a bolla nagara atto gaanaw maati de7eysa hinte erana mela” gidi he gunda uraako, <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/>“Nena gayis, denda eqada ne algaa tookada ne soo ba” yaagis.<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>Uray ellesi dendi eqidi, ba algaa tookidi asa ubbay be7ishin bis. Asa ubbay malaaletidi, “Nuuni haysa mela malaalsiyaba be7i eroko” yaagidi Xoossaa galatidosona.<verse eid="MRK 2:12"/></para>
  <para style="s1">Yesuusi Leewe Xeessa</para>
  <para style="r">(<ref loc="MAT 9:9-13">Maato 9:9-13</ref>; <ref loc="LUK 5:27-32">Luqa 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>Yesuusi qassi Galila Abbaa doona simmi bidi, baako yida asa ubbaa tamaarsis. <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>Yaara aadhishe, Ilfiyoosa na7aa Leewe geeteteysi qaraxa qanxisiya bessan uttidaysa be7idi, “Tana kaalla” yaagis. Leewey dendi eqidi iya kaallis.<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>Yesuusi kathi maanaw Leewe son uttis. Iya kaalliya asay daro gidiya gisho, qaraxa qanxisiya daro asaynne nagaranchoti iyaranne iya tamaaretara issife uttidosona. <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>Higge astamaare gidida issi issi Farsaaweti Yesuusi nagaranchotaranne qaraxa qanxiseysatara kathi mishin be7idi, “I ayis nagaranchotaranne qaraxa qanxiseysatara kathi mii?” yaagidi, iya tamaareta oychidosona.<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>Yesuusi enti geysa si7idi, “Harganchotape attishin, paxatas aakime koshshenna. Taani nagaranchota xeeganaw yasipe attishin, xillota xeeganaw yabiike” yaagidi entaw zaaris.<verse eid="MRK 2:17"/></para>
  <para style="s1">Yesuusi Xoomaba Oyshetis</para>
  <para style="r">(<ref loc="MAT 9:14-17">Maato 9:14-17</ref>; <ref loc="LUK 5:33-39">Luqa 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>Xammaqiya Yohaanisa tamaaretinne Farsaaweti xoomosona. Issi issi asati Yesuusako yidi, “Yohaanisa tamaaretinne Farsaaweta tamaareti xoomosona, shin ne tamaareti ayis xoomokonaa?” yaagidosona.<verse eid="MRK 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19"/>Yesuusi entako, “Yaaganuwa yida asati machiw ekeysi entara de7ishin, xoomanaw danda7onna? Machiw ekeysi entara de7ishin, xoomanaw danda7okona. <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/>Shin machiw ekeysi enta matape eketana wodey yaana, enti he wode xoomana.<verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>“Gal7a ma7o bolla ooratha carqe wothidi sikiya asi baawa. Wothidi sikiko, oorathay ceega ma7uwa daakees; daakethayka kaseysafe darees. <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/>Qassi mal7anto woyne ceega ogoron qoliya asi baawa. Shin qoliko, he woyney ogoruwa daakees, bawuka gukees, ogoroyka iitees. Shin mal7anto woyney ooratha ogoron qoletees” yaagis.<verse eid="MRK 2:22"/></para>
  <para style="s1">Sambaataba Bonchanaw Bessii?</para>
  <para style="r">(<ref loc="MAT 12:1-8">Maato 12:1-8</ref>; <ref loc="LUK 6:1-5">Luqa 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>Yesuusi issi Sambaata gallas banga gade giddora aadhishin, iya tamaareti iyara bishe banga tiya shirkidi moosona.<note caller="-" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="DEU 23:25">Zaare 23:25</ref>.</char></note> <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>Farsaaweti Yesuusako, “Heko, ne tamaareti Sambaata gallas woga gidonnaba ayis oothonna?” yaagidosona.<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>Yesuusi entako, “Dawiti koshatidi, miyaba koyida wode, baara de7eysatara oothidaysa nabbabibeketii?<note caller="-" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="1SA 21:1-6">1 Same 21:1-6</ref>.</char></note> <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/>Abyataari kahine halaqa gididi de7iya wode Dawiti Xoossa keethi gelidi, kahineta xalaali maanape attishin, oonika maanaw woga gidonnaysa Godaa sinthan wothida daabbuwa mis, baara de7eystaska immis” yaagis.<note caller="-" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="LEV 24:9">Leewe 24:9</ref>.</char></note><verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>Qassika Yesuusi entako, “Sambaati asa na7a go77as medhetisipe attishin, asi Sambaatas medhetibeenna. <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/>Hessa gisho, Asa Na7ay, hari attoshin Sambaataska Godaa” yaagis.<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s1">Kushey Silida Ura</para>
  <para style="r">(<ref loc="MAT 12:9-14">Maato 12:9-14</ref>; <ref loc="LUK 6:6-11">Luqa 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>Yesuusi ayhude woosa keethi simmi gelis. Yan kushey gundida issi uray de7ees. <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>Issi issi asay Yesuusa mootanaw koyidi, kushey gundida uraa Sambaata gallas I pathikonne aggiko be7anaw koyidi minthidi naagoosona. <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>Yesuusi kushey gundida uraa, “Denda eqada haa sinthe ya” yaagis. <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>Hessafe guye, asaako, “Sambaata gallas lo77oba ootheysi wogeye iitabaa ootheysi wogee? Asa shempo ashoye woyko wodho?” yaagidi oychis.</para>
  <para style="p" vid="MRK 3:4">Shin asay si77i gis. <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>Yesuusi hanqetidi, enta yuushshi aathi xeellidi, enti odin si7onnayisata gidiya gisho, enta bolla daro azzanis. He addiyako, “Ne kushiya piddi ootha” yaagis. Uray piddi oothin iya kushey paxis. <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>Ellesidi Farsaaweti ayhude woosa keethafe kare keyidi, Yesuusa waati wodhaneko maqetanaw Herodiisa baggatara issi soo shiiqidosona.<verse eid="MRK 3:6"/></para>
  <para style="s1">Daro Asi Yesuusa Kaallees</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>Yesuusi ba tamaaretara Galila Abbaako bis. Galilapenne Yihudape yida daro asay iya kaallidosona. <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>Qassika Yerusalaamepe, Edomiyaasape, Yordaanose Shaafa pinthafe, Xiroosa katamaapenne Sidoona katamaape Yesuusi oothidaba si7idi, daro asay iyako yidosona. <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/>Asaa darotethaafe dendoysan iya un7ethonna mela iya tamaareti wogolo iyaw giigisana mela kiittis.<note caller="-" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MRK 4:1">Mar 4:1</ref>; <ref loc="LUK 5:1-3">Luqa 5:1-3</ref>.</char></note> <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>Daro asaa I pathida gisho, hargiya asa ubbay iya bochanaw sugetoosona. <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>Tuna ayyaanay oykida asati iya be7ida wode iya sinthan kundidi, banta qaala dhoqu oothidi, “Neeni Xoossaa Na7aa gidikii?” yaagosona.<verse eid="MRK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12"/>He tuna ayyaanati iya oonatetha oodeska qoncisonna mela entaw minthidi odis.<verse eid="MRK 3:12"/></para>
  <para style="s1">Tammanne Nam7u Hawaareta</para>
  <para style="r">(<ref loc="MAT 10:1-4">Maato 10:1-4</ref>; <ref loc="LUK 6:12-16">Luqa 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>Yesuusi deriya bolla keyidi, ba koyida asata baako xeegis; entika iyako bidosona. <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>Enti baara daana melanne qaala tamaarsana mela tammanne nam7ata dooridi, enta, “Hawaareta”<note caller="+" style="f"><char style="fr" closed="false">3:14 </char><char style="fqa" closed="false">Hawaare: </char><char style="ft" closed="false">Hawaare guussay kiitetidaysa guussu.</char></note> gidi sunthis. <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>Tuna ayyaanataka kessana mela entaw maata immis.<verse eid="MRK 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>I doorida tammanne nam7ati haysata: Phexroosa yaagidi sunthida Simoona, <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>Bo7anerges (Dada Nayta) yaagidi sunthidaysata, Zabdiyoosa nayta Yayqoobanne Yayqooba ishaa Yohaanisa, <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>Indiriyasa, Filphoosa, Bartelemoosa, Maatosa, Toomasa, Ilfiyoosa na7a Yayqooba, Taadiyosa, ba biittas mishetiya Simoonanne, <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>Yesuusa aathidi immida Asqoroota Yihuda.<verse eid="MRK 3:19"/></para>
  <para style="s1">Yesuusanne Bi7eel-Zebuula</para>
  <para style="r">(<ref loc="MAT 12:22-32">Maato 12:22-32</ref>; <ref loc="LUK 11:14-23">Luqa 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>Hessafe guye, Yesuusi soo bis. Qassi daro asay shiiqin, inne iya tamaareti hari attoshin kathi maanawuka danda7ibookona. <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>Asay iya, “Gooyees” giya gisho, iya dabboti hessa si7idi iya ekanaw bidosona.<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>Higge astamaaretape issoti issoti Yerusalaamepe yidi, “Iya bolla Bi7eel-Zebuuli de7ees”, I, “Xalahey wolqan tuna ayyaanata kessees” yaagidi odetidosona.<note caller="-" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="MAT 9:34">Maato 9:34</ref>; <ref loc="MAT 10:25">10:25</ref>.</char></note><verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>Yesuusi asaa baako xeegidi leemiso odis. “Xalahey Xalahe waati kessanaw danda7ii? <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/>Issi kawotethay ba giddon shaaketiko he kawotethay eqanaw danda7enna. <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/>Hessadaka, issi keetha asay banta giddon shaaketiko dhayanape attishin, daanaw danda7okona. <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/>Hiza, Xalahey baara kacetidi shaaketiko dhayope attishin, daanaw danda7enna.<verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>“Shin koyrottidi wolqaama uraa qachonna de7ishe iya keetha gelidi, iya miishiya bonqanaw danda7iya asi baawa. Qachi simmidi iya keetha bonqanaw danda7ees.<verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>“Taani hintew tuma odayis; Xoossay asa naytas nagara ubbaanne enti cayiya cashshe ubbaa atto gaana. <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/>Shin Geeshsha Ayyaana bolla iitabaa odetiya oodeska merinaa nagara gidanaape attishin, Xoossay ubbaraka iya maarenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Luqa 12:10</ref>.</char></note> <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>Yesuusi hessa giday, issi issi asati, “Iya bolla tuna ayyaanay de7ees” yaagida gishosa.<verse eid="MRK 3:30"/></para>
  <para style="s1">Yesuusa Aayiwunne Iya Ishata</para>
  <para style="r">(<ref loc="MAT 12:46-50">Maato 12:46-50</ref>; <ref loc="LUK 8:19-21">Luqa 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>Iya aayanne iya ishati yidi karen eqidi, iyako ase kiittidi iya xeegidosona. <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>Iya matan uttida daro asati, “Heko, ne aayeranne ne ishatara karen eqidi nena koyoosona” yaagidosona.<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>Yesuusi zaaridi, “Ta aayiya oonee? Qassi ta ishati oonantee?” yaagis. <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>Ba matan uttida asa yuushshi aathi xeellidi, “Heko, ta aayanne ta ishati haysata. <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/>Xoossay sheniya oothiya ubbay ta isha, ta michonne ta aayo” yaagis.<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s1">Zerethi Zeriya Ura Leemiso</para>
  <para style="r">(<ref loc="MAT 13:1-9">Maato 13:1-9</ref>; <ref loc="LUK 8:4-8">Luqa 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>Yesuusi zaaridi Galila Abbaa matan tamaarsees. Daro asay iya matan yuushuwan shiiqin, abban de7iya wogoluwa giddo gelidi uttis, asa ubbay Abbaa matan de7ees.<note caller="-" style="x"><char style="xo" closed="false">4:1 </char><char style="xt" closed="false"><ref loc="LUK 5:1">Luqa 5:1</ref>.</char></note> <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>I enta darobaa leemison tamaarsis. Tamaarsishe haysada yaagis:<verse eid="MRK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3"/>“Si7ite! Issi uray zerethi zeranaw keyis. <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/>I zerishin, issi issi zerethay oge gaxan wodhis; kafoti yidi midosona. <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/>Issi issi zerethay garsan shaalloy de7iya biitta bolla wodhis. Daro biitti bayna gisho, he zerethay ellesidi dolis. <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/>Shin awi keyida wode shullis. Loythidi xapho yeddiboonna gisho, ellesi melis. <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/>Issi issi zerethay aguntha giddon wodhis. Dolidaysa agunthay diccidi cuullida gisho ayfe ayfonna attis. <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/>Issi issi zerethay aradda biittan wodhidi dolis. Diccidi issoy hastama, issoy usupun tamma issoy xeeta ayfis” yaagis. <verse eid="MRK 4:8"/><verse number="9" style="v" sid="MRK 4:9"/>“Si7iya haythi de7iya oonika si7o” yaagis.<verse eid="MRK 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>Yesuusi odidaysa si7ida issi issi asatinne tammanne nam7u tamaareti Yesuusi barka de7ishin, iyako shiiqidi he leemisuwa birshethaa oychidosona. <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>Yesuusi entako haysada yaagis: “Hintew Xoossaa kawotethaa xuuraa eroy imetis. Shin haratas kawotethaafe karen de7eysatas ubbabay leemison odetees. <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/>Gaasoyka,</para>
  <para style="q1" vid="MRK 4:12">“ ‘Enti xeelloosona, shin demmokona.</para>
  <para style="q1" vid="MRK 4:12">Si7oosona, shin akeekokona.</para>
  <para style="q1" vid="MRK 4:12">Enti demmiyakonne akeekiyako,</para>
  <para style="q2" vid="MRK 4:12">Xoossaako simmana</para>
  <para style="q2" vid="MRK 4:12">ika enta maaranashin’ ”<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9">Isa 6:9</ref>.</char></note></para>
  <para style="m" vid="MRK 4:12">yaagis. <verse eid="MRK 4:12"/><verse number="13" style="v" sid="MRK 4:13"/>Yesuusi entako, “Ha leemisoy hintew gelennee? Yaatin, leemiso ubbaa hinte waati akeekanee? <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/>Zereysi Xoossaa qaala zerees. <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/>Qaalay zeretiya wode oge gaxan wodhidaysati qaala si7idaysata. Shin Xalahey ellesidi, yidi enta wozanan zeretida qaala maxi diggees. <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/>Hessadaka, garsan shaalloy de7iya biittan zeretidaysi qaala si7idi, ellesidi ufaysan ekeysa. <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/>Shin iyaw mino xaphoy bayna gisho ha77issafe attishin, gam7okona. Guutha wodepe guye qaala gaason waayey woyko goodi gakiya wode ellesidi dhubetoosona. <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/>Aguntha giddon zeretidaysi qaala si7eyisata. <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/>Shin ha sa7a de7uwas hirgoy, duretetha dosoynne haraba amotteysi iya wozanan gelidi qaala cuulliya gisho ayfe ayfonna attis. <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/>Shin aradda biittan zeretidaysati qaala si7idi ekeyisata. Enti issoy hastama, issoy usupun tamma issoy xeeta ayfis” yaagis.<verse eid="MRK 4:20"/></para>
  <para style="s1">Geeman De7iya Xompe</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luqa 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>Yesuusi gujidi, “Xompe ekidi, daachofe woyko algafe garsan wothiya asi de7ii? Dhoqa bessan wothenneyee?<note caller="-" style="x"><char style="xo" closed="false">4:21 </char><char style="xt" closed="false"><ref loc="MAT 5:15">Maato 5:15</ref>; <ref loc="LUK 11:33">Luqa 11:33</ref>.</char></note> <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/>Hiza, qosetidabay ubbay qonce keyana; geemmidabay ubbay eretonna attenna.<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">Maato 10:26</ref>; <ref loc="LUK 12:2">Luqa 12:2</ref>.</char></note> <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/>Si7iya haythi de7iya oonika si7o” yaagis.<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>Qassi entako, “Hinte si7iyaba akeekidi si7ite! Xoossaa qaala hinte si7eysa mela I hintew akeeka immana. Ubbaka hintew darsidi immana. <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/>Issibay de7iya uraas guji imetana, baynaysafe hari attoshin, iyaw de7iya he guuthiyaka eketana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">Maato 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">Luqa 19:26</ref>.</char></note><verse eid="MRK 4:25"/></para>
  <para style="s1">Dicciya Zeretha Leemiso</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>Yesuusi zaaridi, “Xoossaa kawotethay ba gaden zerethi zeriya asa mela. <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/>He uray qamma dhiskees; wonta dendees. I ba huuphen waaniyako eronna de7ishin he zerethay doleesinne diccees. <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/>Biittay kathi barka immees. Koyro dolidi diccees, kaallidi ayfanaw gambuxees, wursethan kumetha ayfe ayfees. <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/>Shin kathay gakiya wode uray ellesidi baacara geli aggees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="JOL 3:13">Iyyu 3:13</ref>.</char></note><verse eid="MRK 4:29"/></para>
  <para style="s1">Ayfe Guutha Mithee Leemiso</para>
  <para style="r">(<ref loc="MAT 13:31-34">Maato 13:31-34</ref>; <ref loc="LUK 13:18-19">Luqa 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>Yesuusi, “Nuuni Xoossaa kawotethaa ay daanees gaanee? Woyko aybira leemisanee? <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/>Xoossaa kawotethay ayfe guutha mithi daanees. He mithaa ayfiya zeriya wode sa7an de7iya mitha ayfe ubbaafe guuxees. <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/>Zerin dolidi atakilte ubbaafe gitatees; daro daashshi daayees. Kafoti iya tashiya bolla keexidi uttana gakanaw daayees” yaagis.<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>Yesuusi haysa mela daro leemison asay akeekanaw danda7eysa mela qaala odis. <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>Asaas leemisoy bayna odenna. Shin Yesuusi ba tamaareta xalaalara de7iya wode, entaw ubbaba birshidi odis.<verse eid="MRK 4:34"/></para>
  <para style="s1">Yesuusi Hobbiya Seeris</para>
  <para style="r">(<ref loc="MAT 8:23-27">Maato 8:23-27</ref>; <ref loc="LUK 8:22-25">Luqa 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>He gallas sa7i omarsin, Yesuusi ba tamaaretako, “Abbaafe hefinthi pinnoos” yaagis. <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>Iya tamaareti daro asa yeggi aggidi, Yesuusi kase geli uttida wogoluwan gelidi Yesuusa bantara efidosona. Hara wogolotika yan de7oosona. <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>Wolqaama gotey dendidi, hobbey wogoluwa shocin, kumana gakanaw wogoluwa giddo haathi gelis. <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>He wode Yesuusi wogoluwan guye baggara borkotidi dhiskis. Iya tamaareti iya denthidi, “Astamaariyaw, nuuni dhayiya wode ne si77i gada xeellay?” yaagidosona.<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>Yaatin, I barkidi gotiya, “Si7i ga” gidi, abbaaka, “Wopu ga” gis. Goteyka si77i gin ubbabay wopu gis. <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>Yesuusi ba tamaaretako, “Ayis haysada babetii? Hintew ammanoy waanidi dhayidee?” yaagis.<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>Enti daro babidi banta giddon, “Haysi hari attoshin, goteynne abbay kiiteteysi oonee?” yaagidosona.<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s1">Tuna Ayyaani Oykida Ura</para>
  <para style="r">(<ref loc="MAT 8:28-34">Maato 8:28-34</ref>; <ref loc="LUK 8:26-39">Luqa 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>Yesuusinne iya tamaareti abba pinnidi, Gergesoone biitta gakidosona. <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>Yesuusi wogoluwape wodhiya wode tuna ayyaanay oykida issi uray duufope keyidi iyara gahetis. <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>He uray aqi pee7idi de7ey duufona. Iya oonika santhalaatan qachanaw danda7enna. <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>I daro toho duthaninne santhalaatan qashetidi de7ees. Shin santhalaata duuserethees, dutha mentherethees. Iya teqanaw danda7iya oonika baawa. <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>I qammanne gallas he duufuwaninne dere bolla waassees, ba asatethaa shuchan gaarees.<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>Yesuusa haahon be7ida wode woxi bidi iya sinthan gulbatis. <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>He uray ba qaala dhoqu oothidi, “Ubbaafe Bolla Xoossaa Na7aw Yesuusa, nenanne tana aybe gathey? Tana dhaysona mela taani nena Xoossaa sunthan woossayis” yaagis. <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>I hessa giday Yesuusi iya, “La ha tuna ayyaanaw, ha addiyafe keya” yaagida gishosa.<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>Yesuusi iyako, “Ne sunthay oonee?” yaagidi oychis.</para>
  <para style="p" vid="MRK 5:9">I, “Nuuni daro gidiya gisho, ta sunthay Leegiyona” yaagis. <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>Tuna ayyaanati bantana he biittafe kessi yeddonna mela Yesuusa minthidi woossidosona.<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>He deriya bolla daro guduntho wudey hemetees. <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>Tuna ayyaanati Yesuusako, “Nuna hini guduntho wudiyako yeddarki, entan bidi geloos” yaagidi woossidosona. <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>Yesuusi entako, “Biite” yaagis. Yaatin tuna ayyaanati addiyafe keyidi gudunthotan gelidosona. Nam7u mukulu gidiya guduntho wudey aafo doonara dirgidi bidi abban gelidi mitetidosona.<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>Guduntho wudiya heemmeysati baqati bidi hanidaba katamaninne gaxariyan odidosona. Yaatin asay hanidaba be7anaw keyidosona. <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>Asay Yesuusako yaa wode tuna ayyaanan oyketida uraa be7idosona. I ba wozanaako simmidi, ma7o ma7idi, yan uttidaysa be7ida wode ubbay yayyidosona. <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>Hessa be7ida asati tuna ayyaanati oykida uraa bollanne gudunthota bolla hanidaba ubbaa asaas odidosona. <verse eid="MRK 5:16"/><verse number="17" style="v" sid="MRK 5:17"/>Hessa gisho, asay banta biittafe Yesuusi baana mela woossidosona.<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>Yesuusi wogoluwan geliya wode kase tuna ayyaanay oykidi yeddida uray, Yesuusa kaallanaw iya woossis. <verse eid="MRK 5:18"/><verse number="19" style="v" sid="MRK 5:19"/>Shin Yesuusi ixidi iyako, “Ne soo simmada, Goday new ay mela gitaba oothidaakonne new ay mela keehidaako ne soo asaas oda” yaagis. <verse eid="MRK 5:19"/><verse number="20" style="v" sid="MRK 5:20"/>Uray bidi Tammu Katamaa geetetiya bessan yuuyidi, Yesuusi baw ay mela gitaba oothidaako odis. I odidaysa si7ida asa ubbay malaaletidosona.<verse eid="MRK 5:20"/></para>
  <para style="s1">Hayqida Na7iwunne Hargetiya Maccasiw</para>
  <para style="r">(<ref loc="MAT 9:18-26">Maato 9:18-26</ref>; <ref loc="LUK 8:40-56">Luqa 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>Yesuusi simmidi, wogoluwan gelidi, abba pinnidaape guye daro asay abba gaxan iya yuushuwan shiiqidosona. <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>Iyaroosa geetetiya ayhude woosa keetha halaqatape issoy, Yesuusa be7ida wode iyako yidi iya tohuwa bolla <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>kundidi, “Ta na7iya hargada hayqana hanawusu. Iya paxada de7ana mela yada ne kushiya I bolla wotharki” yaagidi Yesuusa minthidi woossis.<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>Yesuusi Iyaroosara bis. I bishin daro asay iya kaallidi un7ethidosona.<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>Tammanne nam7u laythi Ipe suuthi dhohiya issi maccasiya de7awusu. <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>Daro aakimeti iyo aakimidosona, shin iya paxa kaa7etasu. Iya ba miishiya ubbaa wursinka iw haa iitisipe attishin, aykoka maaddibeenna. <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>He maccasiya Yesuusaba si7ada, asaa kanthada Yesuusa guyera yada iya ma7uwa bochasu. <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>Iya, “Taani hari attoshin iya ma7uwa bochiyako paxana” gada qopasu.<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>Iipe goggiya suuthay iiraka eqi aggis. Iya ba waayiyape paxidaysa ba asatethan erasu. <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>Yesuusi baape wolqi keydaysa ba huuphen eridi, ellesidi daro asa giddon guye simmidi, “Ta ma7uwa bochiday oonee?” yaagis.<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>Iya tamaareti, “Asay nena sugeysa be7ashe, ‘Woygada tana oone bochiday yaagay?’ ” yaagidosona.<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>Yesuusi hessa ooni oothidaako be7anaw yuushshi aathi xeellis. <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>Shin maccasiya baw hanidaba erada, yashshan kokorashe yada Yesuusa sinthan gufannasu; qassi hanidaba ubbaa tumaa iyaw odasu. <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>Yaanin, Yesuusi iiko, “Ta naatte, nena ne ammanoy pathis, saron ba, ne waayapeka paxa” yaagis.<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>Yesuusi buroo hessa odishin, ayhude woosa keetha halaqaa soope kiitetida asati yidi, “Ne na7iya hayqasu, astamaariya ayis daabursay?” yaagidosona.<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>Shin Yesuusi enti geysa si7idi, ayhude woosa keetha halaqaako, “Ammano xalaala ammanape attishin, babofa” yaagis. <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>Yesuusi Phexroosape, Yayqoobapenne Yayqooba ishaa Yohaanisape hari oonika bana kaallonna mela diggis. <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>Enti ayhude woosa keetha halaqaa soo gakiya wode Yesuusi asay kaha dhayidi yeekeysanne zeleeleysa be7is. <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>Gelidi asaako, “Ayis kaha dhayidi yeeketii? Na7iya dhiskasupe attishin, hayqabuuku” yaagis.<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>Asay iya bolla miicis. Shin asa ubbaa kare kessidi, na7e aawa, aayiwunne heedzu tamaareta baara ekidi na7iya de7iyasuwa gelis. <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>Yesuusi na7e kushiya oykidi, “Xaalita, quumi” (Guutha naatte, nena gayis denda) yaagis.<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>Na7iya ellesa denda eqada hemetasu. Iya tammanne nam7u laytha na7a. Hessan asay daro malaaletidosona. <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>Yesuusi hessa enti oodeska odonna mela enta minthi kiittis. Enti iw miyaba immana mela odis.<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s1">Yesuusi Naazireten Ixetis</para>
  <para style="r">(<ref loc="MAT 13:53-58">Maato 13:53-58</ref>; <ref loc="LUK 4:16-30">Luqa 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>Yesuusi yaape keyidi, ba tamaareta kaalethidi, ba katama Naazirete bis. <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>Sambaata gallas ayhude woosa keethan tamaarso oykis. I tamaarseysa si7ida daro asay malaaletidi, “Haysi ha ubbaa awupe demmidee? Ha cincatethaa I awupe ekidee? Ha malaatata oothiya maata I awupe demmidee? <figure style="fig" alt="Man reading inside synagogue" file="LB00244B.tif" size="col" ref="6:2">Issiasi Ayhude Woosakeethan Nabbabishin</figure> <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Haysi anaaxiya gidennee? Mayraami na7a, Yayqooba, Yoosa, Yihudanne Simoona ishaa gidenneyee? Iya micheti nuura haysan de7okonayee?” yaagidi, I giyaba ekonna ixidosona.<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>Yesuusi he asaako, “Nabey ba biittan, ba dabbotaninne ba soo asan bonchetenafe attishin, harata matan bonchetees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="JHN 4:43">Yoha 4:43</ref>.</char></note> <verse eid="MRK 6:4"/><verse number="5" style="v" sid="MRK 6:5"/>I he bessan ba kushiya guutha asaa bolla wothidi pathidaysafe attishin, hara malaatata oothanaw danda7ibeenna. <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>Asay ammanibona gisho daro malaaletis.</para>
  <para style="s1" vid="MRK 6:6">Tammanne Nam7u Hawaareta Kiitetidosona</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">Maato 10:5-15</ref>; <ref loc="LUK 9:1-6">Luqa 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Hessafe guye, Yesuusi he heeran de7iya gutatan asaa tamaarsees. <verse eid="MRK 6:6"/><verse number="7" style="v" sid="MRK 6:7"/>Yesuusi tammanne nam7u tamaareta baako xeegidi, nam7aa nam7aa gathidi kiittis. Entaw tuna ayyaanata kessiya wolqaa immis. <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/>Enta, “Oge xam7afe attishin, kathi, karxiita, hinte kiisen miishe aybibaaka oykofite.<note caller="-" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Luqa 10:4-11</ref>.</char></note> <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>Hinte tohuwan caamma aathite, shin nam7u afila oykofite” yaagis. <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>Qassika, “Hintena asi mokida soo awunka gidin he bessaa yeddidi baana gakanaw he keethan gam7ite. <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/>Hintena asi mokonasuwa woyko hinte odiyaba si7onnasuwa awun gidikoka, he biittan de7iya asaas marka gidana mela he bessaafe keyishe, hinte tohuwape baana pitite” yaagis.<note caller="-" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="ACT 13:51">Hawa 13:51</ref>.</char></note><verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>Tammanne nam7u tamaareti bidi, asay banta nagaraape simmanaada qaala odidosona. <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/>Enti asape daro tuna Ayyaanata kessidosona. Daro harganchota zayte tiyidi pathidosona.<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">Yay 5:14</ref>.</char></note><verse eid="MRK 6:13"/></para>
  <para style="s1">Xammaqiya Yohaanisa Hayquwa</para>
  <para style="r">(<ref loc="MAT 14:1-12">Maato 14:1-12</ref>; <ref loc="LUK 9:7-9">Luqa 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>Yesuusa sunthay ubba bessan keyida gisho, Kawoy Herodiisi iyabaa si7is. Issi issi asay, “Xammaqiya Yohaanisi hayqope dendis, hessa gisho ha malaatata oothey iya” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="MAT 16:14">Maato 16:14</ref>; <ref loc="MRK 8:28">Mar 8:28</ref>; <ref loc="LUK 9:19">Luqa 9:19</ref>.</char></note><verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>Baggati, “Haysi Eeliyaasa gidennee?” yaagidosona.</para>
  <para style="p" vid="MRK 6:15">Harati qassi, “Haysi beni wode nabetape issuwa gidonna aggenna” yaagidosona.<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>Shin Herodiisi hessa si7ida wode, “Haysi taani qoodhiya qanxisida Xammaqiya Yohaanisa gidennee? I hayqope dendis” yaagis.<verse eid="MRK 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17"/>Herodiisi ba ishaa Filphoosa machiw Herodiyada ekida gisho I gaason Yohaanisa oythidi qashisis. <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>Yohaanisi Herodiisa, “Neeni ne ishaa machiw ekanaw bessenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="LUK 3:19-20">Luqa 3:19-20</ref>.</char></note><verse eid="MRK 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>Herodiyada Yohaanisa ba ulon morkada iya wodhisanaw koyasu, shin danda7abuku. <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>Yohaanisi xillonne geeshsha asi gididaysa Herodiisi erida gisho, iyaw babidi loythi naagisees. Herodiisi Yohaanisi giyaba si7anaw dosikoka I giyaba si7iya wode daro dagammees.<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>Herodiisi ba yeletida gallasa bonchanaw deriya haareysatas, shaalaqatasinne Galilan de7iya gita asaas imato giigisis. Hessi Herodiyadas inje gallas gidis. <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>Herodiyada na7iya imathay moketiya bessaa gela durada, Herodiisanne iya imathata ufaysasu. Kawoy na7iw, “Ne koyaba ayba gidikoka tana oycha, taani new immana” yaagis. <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>Qassi iw caaqidi, “Neeni oychiyaba ayba gidikoka, taani new immana. Hari attoshin, ta kawotethaa baggaa gidikoka taani new immana” yaagis.<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>Na7iya kare keyada ba aayeko, “Ay imma go?” gada oychasu.</para>
  <para style="p" vid="MRK 6:24">I aayiya, “Xammaqiya Yohaanisa huuphiya imma ga” yaagasu.<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>Na7iya ellesada kawako bada, “Xammaqiya Yohaanisa huuphiya saanen wothada ha77i taw immana mela koyayis” yaagasu.<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>Yaanin, kawoy daro qiirotis, shin ba imathata gisho iw caaqida ba caaquwa menthanaw koybeenna. <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>Hessa gisho, ellesidi naageysa Yohaanisa huuphiya ehana mela kiittis. Naageysi qasho keethi bidi Yohaanisa qoodhiya qanxis. <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>He qanxetida huuphiya saanen wothi ehidi na7ees immis. Na7iya qassi ba aayes immasu. <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>Yohaanisa tamaareti hessa si7ida wode bidi iya aha eki efidi moogidosona.<verse eid="MRK 6:29"/></para>
  <para style="s1">Ichashu Mukulu Asaa</para>
  <para style="r">(<ref loc="MAT 14:13-21">Maato 14:13-21</ref>; <ref loc="LUK 9:10-17">Luqa 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoha 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>Tammanne nam7u hawaareti simmi yidi enti oothidabaanne tamaarsidaba ubbaa Yesuusas odidosona. <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>Entako yaa asaynne biya asay darida gisho, Yesuusaranne iya tamaaretara, hari attoshin kathi maanawuka enta gathonna ixis. Yaanin, Yesuusi entako, “Nurka guuthi shempi ekanaw asi bayna bessi yedhite” yaagis. <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>Hessa gisho, enti bantarka wogolon gelidi asi bayna bessi bidosona.<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>Enti bishin daro asay enta be7idi eridosona. Yaatin, katama ubbaafe asay tohora woxi bidi enti biya bessaa entafe sinthe gakidosona. <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/>Yesuusi wogoluwape wodhidi daro asa be7is. Asay heemmiya asi bayna dorsa mela gididaysa be7idi entaw qadhetidi enta darobaa tamaarsis.<note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Taybo 27:17</ref>; <ref loc="1KI 22:17">1 Kawo 22:17</ref>; <ref loc="EZK 34:5">Hiz 34:5</ref>; <ref loc="MAT 9:36">Maato 9:36</ref>.</char></note><verse eid="MRK 6:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 6:35"/>Sa7ay omarsiya wode Yesuusa tamaareti iyako yidi, “Haysi bessay asi bayna bessi; ha77i sa7ika qammis. <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>Asay gutatanne katamata bidi bantaw miyaba shammana mela asa yedda” yaagidosona.<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>Shin Yesuusi zaaridi entako, “Asaas miyaba hinte immite” yaagis.</para>
  <para style="p" vid="MRK 6:37">Enti, “Nuuni bidi nam7u xeetu dinaaren uythu shammidi asaa muzana mela koyay?” yaagidi oychidosona.<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>Yesuusi entako, “Hintew aapun uythi de7ii? Ane bidi be7ite” yaagis.</para>
  <para style="p" vid="MRK 6:38">Enti be7idi, “Ichashu uythunne nam7u molo” yaagidosona.<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>Yesuusi ba tamaareta asa ubbaa cugan cugan shaakidi maatan utisana mela kiittis. <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>Asay xeetu cuganinne ishatamu cugan shaaketi shaaketi uttidosona. <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>Yesuusi ichashu uythaanne nam7u molota ekidi, pude salo xeellidi Xoossaa galatis. Uythaa menthidi asaas gishana mela ba tamaaretas immis. Qassi nam7u molota enta ubbaas shaakis. <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>Asa ubbay midi kallidosona. <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>Attida uytha tiifiyanne molota tiifiya, iya tamaareti tammanne nam7u gayta kumethi denthidosona. <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>Uythaa mida adde asaa tayboy ichashu mukulu.<verse eid="MRK 6:44"/></para>
  <para style="s1">Yesuusi Abba bollara Hemetis</para>
  <para style="r">(<ref loc="MAT 14:22-33">Maato 14:22-33</ref>; <ref loc="JHN 6:15-21">Yoha 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>Ellesidi Yesuusi ba tamaareti wogoluwan gelidi, abbaafe hefinthan de7iya Beetesayda baape sinthatidi baana mela kiittis. Shin baw asaa moyzanaw guye attis. <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>Asaa moyzidaape guye, Xoossaa woossanaw zuma bolla keyis.<verse eid="MRK 6:46"/></para>
  <para style="p">
    <verse number="47" style="v" sid="MRK 6:47"/>Sa7ay qammiya wode wogoloy abba giddon de7ees, shin Yesuusi abbaafe gaxan barka de7ees. <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>Carkoy iya tamaaretako carkiya gisho, abba pidhoy waayseysa Yesuusi be7is. Wontimaathe sa7i geeyana haniya wode I abba bolla hemetishe entako yidi, enta yeggidi aadhanaw koyis. <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>Shin I abba bolla hemetishin, enti be7idi, entaw moytille daanin waassidosona. <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>Enti ubbay iya be7idi, yashshan kokoridosona.</para>
  <para style="p" vid="MRK 6:50">Shin Yesuusi ellesidi entako, “Tana, aykoy baawa; yayyofite” yaagis. <verse eid="MRK 6:50"/><verse number="51" style="v" sid="MRK 6:51"/>Yesuusi wogoluwan gelidi entara issife uttin carkoy wopu gis. Enti daro malaaletidosona. <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>Enta wozanay zel7umida gisho, enti uythabaa akeekibokona.<verse eid="MRK 6:52"/></para>
  <para style="s1">Gensareexen Harganchoti Paxidosona</para>
  <para style="r">(<ref loc="MAT 14:34-36">Maato 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>Enti abba pinnidi, Gensareexe biitta gakidi, wogoluwa gaxa shiishidi qachidosona. <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>Enti wogoluwape wodhiya wode asay ellesidi Yesuusa eridosona. <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>Enti heeran de7iya biitta ubban woxeretidi harganchota halan tookidi, “Yesuusi de7ees” gin si7ida bessaa ehidosona. <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>Asay I bida soo ubban, gaxariyan gidin, kataman, de7iya harganchota dabaaba efoosona. Harganchoti iya afilaa macaraa gidikoka bochana mela asay iya woossidosona. Bochida ubbay paxis.<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s1">Farsaaweta Woga</para>
  <para style="r">(<ref loc="MAT 15:1-9">Maato 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>Yerusalaamepe yida guutha Farsaawetinne higge astamaareti Yesuusa matan shiiqidosona. <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>Yesuusa tamaaretape issoti issoti geeyonna kushiyan, hessika kushe meecetonna kathi meyisata be7idosona.<verse eid="MRK 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3"/>Farsaawetinne Ayhude asa ubbay banta aawata wogaatho banta kushiya meecetonna mookonna. <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>Hessadaka, enti giyape shametidaba meecconna de7ishe mokonna. Qassi enti banta aawatape ekida hara daro wogi de7ees: hessika sineta, kereta, birata miishetanne arsa meecciya wogaa naageysa.<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>Farsaawetinne higge astamaareti Yesuusa, “Ne tamaareti ayis aawata wogaa menthidi banta kushiya meecetonna kathi moonna?” yaagidi oychidosona.<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>Yesuusi entako, “Isayaasi hintena cubbota,</para>
  <para style="q1" vid="MRK 7:6">“ ‘Haysi asay tana ba inxarsa xalaalan bonchees,</para>
  <para style="q2" vid="MRK 7:6">shin enta wozanay taape haahon de7ees.<note caller="-" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="ISA 29:13">Isa 29:13</ref>.</char></note><verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>Asi medhida wogaa Xoossaa higge daanisidi tamaarsiya gisho,</para>
  <para style="q2" vid="MRK 7:7">enti taw mela goyinnoosona’ ”</para>
  <para style="m" vid="MRK 7:7">gidi xaafidaysi tuma.<verse eid="MRK 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>“Hinte Xoossaa kiitaa aggidi asa wogaa minthidi naageta” yaagis.<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>Qassika Yesuusi, “Hinte hinte wogaa naagidi Xoossaa kiitaa yeggi agganaw lo77o oge demmideta. <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/>Musey, ‘Ne aawanne ne aayiw boncha’, qassi ‘Ba aawanne ba aayiw cayeysi hayqanaw bessees’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Kessa 20:12</ref>; <ref loc="DEU 5:16">Zaare 5:16</ref>; <ref loc="EXO 21:17">Kessa 21:17</ref>; <ref loc="LEV 20:9">Leewe 20:9</ref>.</char></note> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/>Shin issi asi ba aawa woyko ba aayiw maaddanaysa aggidi, ‘Haysi taani Xoossas immida yarsho’ giiko, <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/>I ba aawa woyko ba aayiw maaddonna mela ootheeta. <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/>Hessadaka, hinte harata tamaarsida hinte wogan Xoossaa qaala kadhideta. Hessa mela hara darobaa ootheeta” yaagis.<verse eid="MRK 7:13"/></para>
  <para style="s1">Ase Tunisiyabata</para>
  <para style="r">(<ref loc="MAT 15:10-20">Maato 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>Yesuusi daro asaa qassika baako xeegidi, “Ubbay taani odeysa si7itenne akeekite. <verse eid="MRK 7:14"/><verse number="15" style="v" sid="MRK 7:15"/>Asa wozanape keyaabay ase tuniseesipe attishin, karepe asa ulo gelidi ase tunisiyabay aybika baawa. <verse eid="MRK 7:15"/><verse number="16" style="v" sid="MRK 7:16"/>Si7iya haythi de7iya oonika si7o” yaagis.<verse eid="MRK 7:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>Yesuusi daro asaa yeggi aggidi soo gelin iya tamaareti he leemisuwaba iya oychidosona. <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>I entako, “Hintewuka qassi gelibeennee? Karepe asan geliyabay aybika ase tunisanaw danda7onnaysa akeeketii? <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/>Ayis giiko, kathi asa ulo giddo gelidi kanthidi aadhesipe attishin, asa wozana giddo gelenna” yaagis. Hessan Yesuusi kathi ubbay geeshshi gideysa erisis.<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>Kaallidika, Yesuusi, “Asa tunisiyabay asa wozana giddofe keyaaba. <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/>Asa wozana giddofe keyaabay iita qofa, laymatethi, kayso, ase wodho, laame, <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/>iita amo, iitatethi, gene, qayxe, cimo, qanaate, cashshe, otoronne boozatethi. <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/>Ha iitabay ubbayka asa wozana giddofe keyidi ase tunisees” yaagis.<verse eid="MRK 7:23"/></para>
  <para style="s1">Issi Maccase Ammano</para>
  <para style="r">(<ref loc="MAT 15:21-28">Maato 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>Yesuusi yaape keyidi, Xiroosa katama matan de7iya biitta bis. I issi keethi gelidi yan de7eysa oonika erana mela koybeenna. Shin qosetidi gam7anaw danda7ibeenna. <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>Shin I guutha na7iw tuna ayyaanay oykida issi maccasiya Yesuusaba si7ada ellesa iyako yada iya tohuwa bolla kundasu. <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>Iya Ayhude maccasi giduku; iya yeletiday Sirofinqe biittana. Iya, ba na7epe tuna ayyaana kessana mela Yesuusa woossasu.<verse eid="MRK 7:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 7:27"/>Shin Yesuusi zaaridi, “Nayti koyrottidi kathaa kallo; nayta kathaa ekidi kanatas yeggeysi lo77o gidenna” yaagis.<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>Maccasiya zaarada, “Ta Godaw hessi tuma, shin gayta matan de7iya kanati naytape wodhiya tiifiya moosona” yaagasu.<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>Yesuusi qassi iiko, “Ha ne qaala gisho, ne soo ba; tuna ayyaanay ne na7epe keyis” yaagis.<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>Maccasiya ba soo biya wode tuna ayyaanay iipe keyin hiixan zin7idaaro demmasu.<verse eid="MRK 7:30"/></para>
  <para style="s1">Tullenne Muume Ura</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>Yesuusi Xiroosa katamaape keyidi, Sidoonaranne Tammu Katamata geetetiya biittara kanthidi Galila Abbaako bis. <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>Asay tullenne waayidi odetiya asi Yesuusako ehidi, ba kushiya iya bolla wothana mela iya woossidosona. <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>Yesuusi barka he uraa daro asape gaxa kessidi, ba biradhiya iya haythan yeddis. Qassi cuchu cuttidi iya inxarsaa bochis. <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>Salo pude xeellidi, tooki shempidi, “Eftah” gis. Birshethayka “Dooyeta” guussu. <verse eid="MRK 7:34"/><verse number="35" style="v" sid="MRK 7:35"/>Uraa haythay ellesidi dooyetis, qashetida inxarsayka birshetis, uray geeshshidi odetis.<verse eid="MRK 7:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 7:36"/>Yesuusi asaako, “Haysa oodeska odopite” yaagis. Shin I daro minthidi odopite gin, asay odaa yaa darsis. <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>Hessa si7ida asa ubbay daro malaaletidi, “Ubbabaa I loythi oothees. Hari attoshin, tulliya sissees, muumiya odisees” yaagidosona.<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s1">Oyddu Mukulu Asaa</para>
  <para style="r">(<ref loc="MAT 15:32-39">Maato 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>Guutha wodepe guye, daro asay Yesuusako shiiqidosona. Asaas miyabay dhayin Yesuusi ba tamaareta baako xeegidi, <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/>“Ha asay taara heedzu gallas gakanaw gam7idi, aykoka miyaba demmiboonna gisho, tana asay qadhethees. <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/>Taani asaa koshara soo yeddiko asay bishe ogen daaburidi kundana, bagga asay haahosoope yidosona” yaagis.<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>Yesuusa tamaareti zaaridi, “Ha mela biittan ha asa ubbaa muzanaw gidiya kathi demmanaw danda7ey oonee?” yaagidosona.<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>Yesuusi entako, “Hintew aapun uythi de7ii?” yaagidi oychis.</para>
  <para style="p" vid="MRK 8:5">Enti zaaridi, “Laapun uythi de7ees” yaagidosona.<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>Yesuusi asay sa7an uttana mela kiittis. Yaatidi, laapun uythaa ekidi Xoossaa galati simmidi he uythaa menthidi, asaas gishana mela ba tamaaretas immis. Iya tamaareti asaas gishidosona. <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>Entaw qassi guutha laafa moloti de7oosona. Yesuusi he molota gisho Xoossaa galatidi, asaas gishana mela ba tamaareta kiittis. <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>Asa ubbay midi kallidosona. Iya tamaareti attida tiifiya laapun gayta kumethi denthidosona. <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>Kathaa mida asaa tayboy oyddu mukulu gidana. Hessafe guye, Yesuusi asa yeddis. <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>I qassi ba tamaaretara ellesi wogolon gelidi Dalmanuuta biitta bis.<verse eid="MRK 8:10"/></para>
  <para style="s1">Malaata Be7anaw Oychida oysha</para>
  <para style="r">(<ref loc="MAT 16:1-4">Maato 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>Farsaaweti yidi Yesuusa paacanaw koyidi, salope bantana malaata bessaana mela Yesuusara palama oykidosona.<note caller="-" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">Maato 12:38</ref>; <ref loc="LUK 11:16">Luqa 11:16</ref>.</char></note><verse eid="MRK 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 8:12"/>Yesuusi tooki shempidi, “Ha wodiya asay ayis malaata koyii? Taani hintew tuma odayis; ha wodiya asaas ay malaatika imetenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Maato 12:39</ref>; <ref loc="LUK 11:29">Luqa 11:29</ref>.</char></note> <verse eid="MRK 8:12"/><verse number="13" style="v" sid="MRK 8:13"/>I enta yan yeggi aggidi zaari wogolon gelidi abbaafe hefinthi pinnis.<verse eid="MRK 8:13"/></para>
  <para style="s1">Farsaawetanne Herodiisa Irsho</para>
  <para style="r">(<ref loc="MAT 16:5-12">Maato 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>Iya tamaareti kathi efanaysa dogidosona; entaw wogoluwa giddon issi uythaafe hari baawa. <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/>Yesuusi entako, “Hintena erite. Farsaaweta irshuwafenne Herodiisa irshuwafe naagetite” yaagidi kiittis.<note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Luqa 12:1</ref>.</char></note><verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>Enti banta giddon, “I haysa gey nuus uythi bayna gishosa” yaagidosona.<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>Yesuusi enti geysa eridi entako, “Hintew uythi bayna gisho ayis odeteetii? Ha77ika ereketii? Woyko akeekeketii? Hinte wozanay doccidee? <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/>Hintew ayfey de7ishin be7eketii? Haythi de7ishin si7eketii? Hinte akeeketii?<note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">Ermi 5:21</ref>; <ref loc="EZK 12:2">Hiz 12:2</ref>; <ref loc="MRK 4:12">Mar 4:12</ref>.</char></note> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/>Taani ichashu uythaa ichashu mukulu asaas bathida wode aapun gayta kumethi tiife denthidetii?” yaagis.</para>
  <para style="p" vid="MRK 8:19">Entika, “Tammanne nam7u gayta kumethi” yaagidosona.<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>“Hessadaka, taani laapun uythaa oyddu mukulu asaas bathida wode aapun gayta kumetha tiife denthidetii?” yaagis.</para>
  <para style="p" vid="MRK 8:20">Enti, “Laapun gayta kumethi denthida” yaagidosona.<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>Yaatin, “Ha77ika akeekibeketii?” yaagis.<verse eid="MRK 8:21"/></para>
  <para style="s1">Beetesaydan De7iya Issi Qooqe</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>Enti Beetesayda katamaa bidosona. Guutha asati qooqe uraa Yesuusako ehidi he uraa bochana mela iya woossidosona. <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>Yesuusi qooqe uraa kushiya oykidi katamaape gaxa kessis. Iya ayfiyan cuttidi ba kushiya iya bolla wothidi, “New aykoy bentii?” yaagidi oychis.<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>Uray dhoqu gidi xeellidi, “Taw asay bentees, shin asay hemetishe mithi daanees” yaagis.<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>Hessafe guye, Yesuusi zaaridi, uraa ayfiyan ba kushiya wothis. Uray loythi xeellis, iya ayfey paxis, ubbaba geeshshidi be7is. <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>Yesuusi addiyako, “Ne soo ba, shin gutaa gelopa” yaagidi kiittis.<verse eid="MRK 8:26"/></para>
  <para style="s1">Phexroosa Markatetha</para>
  <para style="r">(<ref loc="MAT 16:13-20">Maato 16:13-20</ref>; <ref loc="LUK 9:18-21">Luqa 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>Yesuusi ba tamaaretara Qisaare Filphoosa matan de7iya gutaa bis. Enti bishin oge bolla Yesuusi, “Tana asay oona goonna?” yaagidi ba tamaareta oychis.<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>Iya tamaareti, “Issi issi asay nena, ‘Xammaqiya Yohaanisa’ goosona; harati, ‘Eeliyaasa goosona’ qassi harati, ‘Nabetape issuwa’ goosona” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 6:14">Mar 6:14</ref>.</char></note><verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>Yesuusi entako, “Yaatin hinte tana oona geetii?” yaagidi oychis.</para>
  <para style="p" vid="MRK 8:29">Phexroosi, “Neeni Kiristoosa” yaagidi zaaris.<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>Yesuusi, “Tabaa oodeska odopite” yaagidi enta kiittis.<verse eid="MRK 8:30"/></para>
  <para style="s1">Yesuusi Bana Gakana Waayiya Odis</para>
  <para style="r">(<ref loc="MAT 16:21-28">Maato 16:21-28</ref>; <ref loc="LUK 9:22-27">Luqa 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>Yesuusi ba tamaaretako, “Asa Na7ay, daro meto ekanaw bessees; cimati, kahine halaqatinne higge astamaareti iya ixanaw bessees. Enti iya wodhanawunne I, heedzu gallasape guye, hayqope dendanaw bessees” yaagidi enta tamaarsis. <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>I hessa entaw geeshshidi odis. Phexroosi iya issi bagga zaaridi hanqetis.<verse eid="MRK 8:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 8:33"/>Shin Yesuusi guye simmidi, ba tamaareta xeellidi, Phexroosa hanqetidi, “Ha Xalahey, taape haaka. Neeni asi dosiyaba qopaasape attishin, Xoossay dosiyaba qopaka” yaagis.<verse eid="MRK 8:33"/></para>
  <para style="s1">Yesuusa Kaaloy Cigisiya Gate</para>
  <para style="r">(<ref loc="MAT 10:38-39">Maato 10:38-39</ref>; <ref loc="MAT 16:24-28">16:24-28</ref>; <ref loc="LUK 9:23-27">Luqa 9:23-27</ref>; <ref loc="LUK 14:26-27">14:26-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>Qassika Yesuusi daro asaanne ba tamaareta baako xeegidi, “Tana kaallanaw koyiya oonika bana kaddo; ba masqaliya tookidi tana kaalo.<note caller="-" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">Maato 10:38</ref>; <ref loc="LUK 14:27">Luqa 14:27</ref>.</char></note> <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/>Ba shempuwa ashshanaw koyiya uray dhaysana. Shin ta gishonne Wongela gisho ba shempuwa dhaysiya uray ashshana.<note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Maato 10:39</ref>; <ref loc="LUK 17:33">Luqa 17:33</ref>; <ref loc="JHN 12:25">Yoha 12:25</ref>.</char></note> <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/>Issi asi sa7an de7iya ubbaba baw shiishidi, ba shempuwa dhaysiko iya ay maaddanee? <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/>Issi asi ba shempuwa wozanaw ay immanaw danda7ii? <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/>Xoossaa ammanonna ha iita yeletethan, issi asi tananinne ta qaalan yeellatiko, Asa Na7ay, qassi ba Aawa bonchon geeshsha kiitanchotara yaa wode iyan yeellatana” yaagis.<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="s1">Yesuusa Malay Laametis</para>
  <para style="r">(<ref loc="MAT 17:1-13">Maato 17:1-13</ref>; <ref loc="LUK 9:28-36">Luqa 9:28-36</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>Yesuusi entako, “Taani hintew tuma odayis; Xoossaa kawotethay wolqara yeysa be7onna hayqonna issi issi asati haysan de7oosona” yaagis.<verse eid="MRK 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>Yesuusi usupun gallasape guye, baara Phexroosa, Yayqoobanne Yohaanisa ekidi, enta xalaala gita zuma bolla kessidi enta sinthan laametis.<note caller="-" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="2PE 1:17-18">2 Phex 1:17-18</ref>.</char></note> <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>Iya ma7oyka phoolis; sa7an ma7o meecciya oonika geeshshanaw danda7onnaysa mela daro booxis. <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>He heedzu tamaareti, Eeliyaasinne Musey Yesuusara odetishin be7idosona.<verse eid="MRK 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 9:5"/>Phexroosi Yesuusa, “Astamaariyaw, nuuni haysan de7eysi nuus lo77o; nu heedzu shaqarata issuwa new, issuwa Muses, qassi issuwa Eeliyaasas shaqarana” yaagis. <verse eid="MRK 9:5"/><verse number="6" style="v" sid="MRK 9:6"/>Iyaranne hankotara daro yayyida gisho Phexroosi ay giyakoka eribeenna.<verse eid="MRK 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7"/>Hessafe guye, shaaray yidi enta kammin shaarape, “Haysi ta dosiya, ta Na7aa, I geysa si7ite” giya qaalay yis. <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>Ellesidi enti yuushshi aathidi xeelliya wode, Yesuusape attishin, haraa oonaka banta matan be7ibookona.<note caller="-" style="x"><char style="xo" closed="false">9:8 </char><char style="xt" closed="false"><ref loc="MAT 3:17">Maato 3:17</ref>; <ref loc="MRK 1:11">Mar 1:11</ref>; <ref loc="LUK 3:22">Luqa 3:22</ref>.</char></note><verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>Enti zumaa bollafe wodhishin, Yesuusi entako, “Asa Na7ay, hayqope dendana gakanaw, hinte be7idaba oodeska odopite” yaagidi kiittis.<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>I kiittidaysa enti, “Ero” gidi, “Ha hayqope dendo guussay woyguuse” gidi, banta giddon odetidosona.<verse eid="MRK 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 9:11"/>Enti zaaridi, “Higge astamaareti, ‘Eeliyaasi koyrottidi yaanaw bessees’ ayis goonna?” yaagidi oychidosona.<note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Milki 4:5</ref>; <ref loc="MAT 11:14">Maato 11:14</ref>.</char></note><verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>Yesuusi zaaridi “Eeliyaasi koyrottidi yidi, ubbaba giigisees; yaatin, Geeshsha Maxaafan, ‘Asa Na7i daro waayetana; ixetana’ yaagidi aybis xaafetidee? <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/>Shin taani hintew odayis; Eeliyaasi yis; qassi iyabay Geeshsha Maxaafan xaafetidaysada, asay iya bolla banta koydaba oothidosona” yaagis.<verse eid="MRK 9:13"/></para>
  <para style="s1">Tuna Ayyaani Oykida Na7a</para>
  <para style="r">(<ref loc="MAT 17:14-21">Maato 17:14-21</ref>; <ref loc="LUK 9:37-43">Luqa 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>Yesuusi, Phexroosi, Yayqoobinne Yohaanisi hanko iya tamaaretako simmidi yaa wode, daro asay enta yuushuwan eqidaysatanne higge astamaare gidida guutha asati entara palameysa be7idosona. <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>He daro asay Yesuusa be7ida wode malaaletidi, ellesidi iyako woxi yidi, iya sarothidosona. <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>Yesuusi ba tamaaretako, “Entara ay palameetii?” yaagidi oychis.<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>He daro asa giddofe issi uray zaaridi, “Astamaariyaw, ta na7aa bolla odetethi diggiya tuna ayyaanay de7iya gisho, iya neeko ekada yas. <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>Ha tuna ayyaanay iya oykiya wode ubban, iya shoci yeggees; iya doonara gopontoy yees; qassi ache garcisees; asatethayka minnees. Iyape ha tuna ayyaana kessana mela, ne tamaaretas odas, shin kessanaw danda7ibookona” yaagis.<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>Yesuusi zaaridi entako, “Ammanonna ha wodiya asaw! Taani hintera awude gakanaw daanee? Qassi hintena awude gakanaw danda7anee? Na7aa taako haa eki yiite” yaagis. <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>Enti na7aa iyako ehidosona; he tuna ayyaanay Yesuusa be7ida mela na7aa kokorsis; na7ay sa7an kundidi, doonara gopontoy toofu gishin gondoretis. <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>Yesuusi he na7aa aawako, “Haysi ne na7aa oykoosape ay mela wode gidanee?” yaagidi oychis.</para>
  <para style="p" vid="MRK 9:21">Na7aa aaway, “I guuthan de7ishin oykis. <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>Iya wodhanaw daro wode tamaninne haathan yeggees, shin ne danda7iko, nuus qadhetarki, nuna maaddarki” yaagis.<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>Yesuusi iya, “ ‘Neeni danda7iko gay?’ Ammaniya oodeska ubbabay danda7etees” yaagis.<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>Ellesidi na7aa aaway ba qaala dhoqu oothidi, “Taani ammanayis, shin guja ammananada tana maaddarki” yaagis.<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>Yesuusi asay dari dari beysa be7idi, tuna ayyaana, “Ha tullenne muume ayyaanaw, ha na7aape keya gada nena ta kiittayis; qassi nam7antho iyan gelopa” yaagis.<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>He tuna ayyaanay waassidi, na7aa daro kokorsidi, iyape keyis. Na7ay hayqida daanin, daro asay, “Na7ay hayqis” yaagidosona. <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>Shin Yesuusi na7aa kushiya oykidi denthin, na7ay dendi eqis.<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>Yesuusi soo gelidaysafe guye, iya tamaareti, “Nuuni he tuna ayyaana kessanaw ayis danda7ibooko?” yaagidi Yesuusa dumma oychidosona.<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>Yesuusi zaaridi, “Hessa melay woosapenne xoomape attishin, haraban keyanaw danda7enna” yaagis.<verse eid="MRK 9:29"/></para>
  <para style="s1">Yesuusi Ba Hayquwaba Zaaridi Odis</para>
  <para style="r">(<ref loc="MAT 17:22-23">Maato 17:22-23</ref>; <ref loc="LUK 9:43-45">Luqa 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>Enti he bessaafe dendidi, Galilara aadhidi bidosona; Yesuusi ba de7iyasuwa oonika erana mela koybeenna. <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>I ba tamaaretako, “Asa Na7aa, asi asas aathidi immananne wodhana; I heedzu gallasape guye, hayqope dendana” yaagidi tamaarsees.<verse eid="MRK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>Shin entaw I geysi gelibeenna; qassi iya oychanawuka yayyidosona.<verse eid="MRK 9:32"/></para>
  <para style="s1">Ubbaafe Aadhey Oonee?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Maato 18:1-5</ref>; <ref loc="LUK 9:46-48">Luqa 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>Enti Qifirnahooma katamaa bidi soo gelidaysafe guye, Yesuusi entako, “Ogen ay odeteetii?” yaagidi oychis. <verse eid="MRK 9:33"/><verse number="34" style="v" sid="MRK 9:34"/>Shin enti, “Nu giddon ubbaafe aadhanay oonee?” yaagidi palamida gisho, si77i gidoosona.<note caller="-" style="x"><char style="xo" closed="false">9:34 </char><char style="xt" closed="false"><ref loc="LUK 22:24">Luqa 22:24</ref>.</char></note> <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/>Yesuusi uttidi, tammanne nam7u tamaareta xeegidi, “Oonika sinthe aadhanaw koyko, ubbaafe guye aadhidi, ubbaas aylle gidanaw bessees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">Maato 20:26</ref>.</char></note><verse eid="MRK 9:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 9:36"/>Issi guutha na7aa ekidi, enta giddon essis; he guutha na7aa idimmidi entako, <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/>“Haysa mela guutha naytape issuwa ta sunthan mokiya oonika tana mokees; qassi tana mokiya oonika tana kiittidaysaka mokeesipe attishin, ta xalaala mokenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Maato 10:40</ref>; <ref loc="LUK 10:16">Luqa 10:16</ref>; <ref loc="JHN 13:20">Yoha 13:20</ref>.</char></note><verse eid="MRK 9:37"/></para>
  <para style="s1">Nuna Ixonnay Nu Bagga</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luqa 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>Yohaanisi, “Astamaariyaw, issi asi ne sunthan tuna Ayyaanata kessishin nuuni be7idi, nu bagga gidonna gisho, iya diggida” yaagis.<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>Shin Yesuusi, “Oonika ta sunthan Xoossay oothiya malaatata oothidi, ellesidi ta bolla iitabaa odetanaw danda7ey bayna gisho diggofite. <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/>Nubaa ixonna uray nu bagga.<note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">Maato 12:30</ref>; <ref loc="LUK 11:23">Luqa 11:23</ref>.</char></note> <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/>Taani hintew tuma odayis; hinte tabaa gidiya gisho, oonika hintew ta sunthan halo haathi uyanaw immikoka, ba woytuwa ekana.<note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">Maato 10:42</ref>.</char></note><verse eid="MRK 9:41"/></para>
  <para style="s1">Hara Asas Dhube Gidopa</para>
  <para style="r">(<ref loc="MAT 18:6-9">Maato 18:6-9</ref>; <ref loc="LUK 17:1-2">Luqa 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>“Tana ammaniya ha guuthatape issuwa balethiya oonika, gaacha wogga woxa ba qoodhen qachidi, abban wulliyako iyaw lo77o. <verse eid="MRK 9:42"/><verse number="43-44" style="v" sid="MRK 9:43-44"/>Ne kushey nena balethiko, qanxa hola. Neeni nam7u kushera to7onna gaanname taman yegeteysafe, duuxa kushera de7uwa geloy new lo77o.<note caller="-" style="x"><char style="xo" closed="false">9:43-44 </char><char style="xt" closed="false"><ref loc="MAT 5:30">Maato 5:30</ref>.</char></note> <verse eid="MRK 9:43-44"/><verse number="45-46" style="v" sid="MRK 9:45-46"/>Ne tohoy nena balethiko, qanxa hola. Neeni nam7u tohuwara gaanname taman yegeteysafe, wobbe gidada de7uwa geleysi new lo77o. <verse eid="MRK 9:45-46"/><verse number="47" style="v" sid="MRK 9:47"/>Ne ayfey nena balethiko, wooca kessa hola. Neeni nam7u ayfiyara gaanname taman yegeteysafe, issi ayfiyara Xoossaa kawotethaa geleysi new lo77o.<note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Maato 5:29</ref>.</char></note> <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/>Yan enta miya guxuney hayqenna, tamayka to7enna.<note caller="-" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">Isa 66:24</ref>.</char></note><verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>“Yarshoy maxinen geeyeysa mela asi ubbay taman harqetana. <verse eid="MRK 9:49"/><verse number="50" style="v" sid="MRK 9:50"/>Maxiney lo77o, shin I mal7onna ixiko, zaaridi waati mal7ethanee? Hintenan maxiney de7o. Yaanidi, issoy issuwara sarotethan de7ite” yaagis.<note caller="-" style="x"><char style="xo" closed="false">9:50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">Maato 5:13</ref>; <ref loc="LUK 14:34">Luqa 14:34</ref>.</char></note><verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s1">Eko Gelo Timirte</para>
  <para style="r">(<ref loc="MAT 19:1-2">Maato 19:1-2</ref>; <ref loc="LUK 16:18">Luqa 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>Yesuusi hessafe dendidi, Yihuda biitta bidi Yordaanose Shaafa pinnis. Daro asay zaaridi iyako shiiqin, kaseysadaka he asaa tamaarsis.<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>Issi issi Farsaaweti paacanaw koyidi Yesuusa, “Issi asi ba machiw yeddana mela Muse higgey kiittii?” yaagidi iya oychidosona.<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>I zaaridi, “Musey hintena woygidi kiittidee?” yaagis.<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>Enti, “Musey, ‘Issi asi ba machees anjo worqate immidi yeddo’ gis” yaagidosona.<note caller="-" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DEU 24:1">Zaare 24:1</ref>.</char></note><verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>Yesuusi zaaridi, enta “Hinte odin si7onnayisata gidiya gisho, Musey ha kiitaa hintew xaafis. <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/>Shin Xoossay koyro medhiya wode, addenne macca oothidi, enta medhis.<note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Medhe 1:27</ref>; <ref loc="GEN 5:1">5:1</ref>.</char></note> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/>Hessa gisho, issi asi ba aawanne ba aayiw aggidi, ba machera issife de7ees.<note caller="-" style="x"><char style="xo" closed="false">10:7 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Medhe 2:24</ref>.</char></note> <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/>Enti nam7ay issi ase gidoosona; hizape, enti issi ase gidoosonape attishin, nam7u asi gidokona. <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/>Hessa gisho, Xoossay issife qachidaysa asi shaakofo” yaagis.<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>Enti soo simmida wode, iya tamaareti ha odabaa Yesuusa nam7antho oychidosona. <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/>Yesuusi entako, “Ba machiw yeddidi hara ekiya oonika laymatees.<note caller="-" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">Maato 5:32</ref>; <ref loc="2CO 7:10-11">2 Qoro 7:10-11</ref>.</char></note> <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/>Qassi maccasiyaka ba azinaape keyada hara azina geliko laymatawusu” yaagis.<verse eid="MRK 10:12"/></para>
  <para style="s1">Yesuusi Yooga Nayta Anjis</para>
  <para style="r">(<ref loc="MAT 19:13-15">Maato 19:13-15</ref>; <ref loc="LUK 18:15-17">Luqa 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>Yesuusi guutha nayta bolla ba kushiya wothana mela, issi issi asay nayta iyako ehoosona, shin iya tamaareti he asa hanqetidosona. <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>Yesuusi hessa be7idi, ba tamaareta hanqetidi; entako, “Guutha nayti taako yeysa diggofite; Xoossaa kawotethay haysata melasa. <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/>Taani hintew tuma odayis; Xoossaa kawotethaa guutha na7ada ekonna uray oonika he kawotethaa ubbaraka gelenna” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">Maato 18:3</ref>.</char></note> <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>Guutha nayta idimmidi, ba kushiya enta issuwa issuwa bolla wothidi anjis.<verse eid="MRK 10:16"/></para>
  <para style="s1">Dure Na7atetha Ura</para>
  <para style="r">(<ref loc="MAT 19:16-30">Maato 19:16-30</ref>; <ref loc="LUK 18:18-30">Luqa 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>Yesuusi baanaw keyda wode, issi uray woxi yidi, iya sinthan gulbatidi, “Keeha astamaariyaw, taani merinaa de7o laattanaw ay ootho?” yaagidi oychis.<verse eid="MRK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18"/>Yesuusi, “Ayis tana keehaw gada xeegay? Xoossaa xalaalape attishin, hari keehi oonika baawa. <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/>Xoossaa kiitaa, wodhopa; laymatopa; kaysotopa; wordo markatofa; inxarsan cimmofa; ne aawanne ne aayiw boncha yaageysa eraasa” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">Kessa 20:12-16</ref>; <ref loc="DEU 5:16-20">Zaare 5:16-20</ref>.</char></note><verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>Uray, “Astamaariyaw, taani hessa ubbaa na7atethafe doomada ha77i gakanaw naagayis” yaagis.<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>Yesuusi uraa tishshi oothi xeellidi dosis; “New issibay pacees; bada new de7iyaba ubbaa bayzada, he miishiya manqotas imma; neeni salon dure gidana. Yaata simmada tana kaalla” yaagis. <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>Shin uray hessa si7idi, I daro dure gidiya gisho, ba som7uwa kareethis, ufaytonna aggidi bis.<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>Yesuusi ba tamaareta yuushshi aathi xeellidi, “Dure asi Xoossaa kawotethaa gelanaysi waanidi metandeesha!” yaagis.<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>Iya tamaareti iya timirtiya si7idi malaaletidosona. Shin Yesuusi qassika entako, “Nayto, Xoossaa kawotethaa gelanaysi waanidi metandeesha! <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/>Dure asi Xoossaa kawotethaa gelanaysafe, gimaley narpe luhora aadheysi kawuyees” yaagis.<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>Iya tamaareti malaaletidi, “Yaatin, ooni attanee?” yaagidi, issoy issuwa oychidosona.<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>Yesuusi enta tishshi oothi xeellidi, “Haysi Xoossas danda7etesipe attishin, asas danda7etenna; Xoossas ubbabay danda7etees” yaagis.<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>Phexroosi Yesuusako, “Heko; nuuni nubaa ubbaa aggidi, nena kaallida” yaagis.<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>Yesuusi “Taani hintew tuma odayis; ta gishonne wongela gisho, keethe woyko ishata woyko micheta woyko aawa woyko aayo woyko machiw woyko nayta woyko gade aggida oonika, <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/>ha77i ha wodiyan xeetu kushe keetha, ishata, micheta, aayeta, nayta, gadiya, goodetethara issife ekana. Sinthafe yaana wodiyanka merinaa de7uwa ekana. <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/>Shin daroti ha77i dethan sinthe gididaysati guye gidana, qassi daroti ha77i guye gididaysati sinthe gidana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">Maato 20:16</ref>; <ref loc="LUK 13:30">Luqa 13:30</ref>.</char></note><verse eid="MRK 10:31"/></para>
  <para style="s1">Yesuusi Ba Hayquwaba Heedzantho Odis</para>
  <para style="r">(<ref loc="MAT 20:17-19">Maato 20:17-19</ref>; <ref loc="LUK 18:31-34">Luqa 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>Yesuusaranne iya tamaaretara Yerusalaame bishin, Yesuusi ba tamaareta sinthan hemetees. Enti malaaletidosona. Iya kaalleysatika yayyidosona. Nam7antho, tammanne nam7u tamaareta gaxa kessidi, bana gakanaba dumma entaw haysada yaagidi odis. <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/>“Heko, nuuni Yerusalaame ha77i keyoos. Yan Asa Na7ay, kahine halaqatasinne higge astamaaretas aadhidi imetana. Enti iya bolla hayqo pirdaa pirdana; qassi Ayhude gidonna deriyas iya aathidi immana. <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/>Ayhude gidonna derey iya toochana, iya bolla cuttana, lisson garaafananne wodhana. I heedzu gallasape guye, hayqope dendana” yaagis.<verse eid="MRK 10:34"/></para>
  <para style="s1">Yayqoobanne Yohaanisa Woosa</para>
  <para style="r">(<ref loc="MAT 20:20-28">Maato 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>Zabdiyoosa nayti Yayqoobinne Yohaanisi Yesuusako yidi, “Astamaariyaw, nuuni nena woossiyaba ubbaa nuus oothana mela koyoos” yaagidosona.<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>Yesuusi entako, “Taani hintew ay ootho?” yaagis.<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>Enti, “Neeni ne boncho kawotethan uttiya wode, nuupe issuwa ushacha baggara qassi issuwa haddirsa baggara utisarki” yaagidosona.<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>Shin Yesuusi entako, “Hinte ay woossiyako ereketa, ta uyanaw de7iya xuu7aa uyanaw danda7eetii? Qassi taani xammaqetanaw de7iya xinqatiya xammaqetanaw danda7eetii?” yaagis.<note caller="-" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">Luqa 12:50</ref>.</char></note><verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>Enti zaaridi, “Ee danda7oos” yaagidosona.</para>
  <para style="p" vid="MRK 10:39">Yesuusi qassi, “Tumaka ta uyanaw de7iya xuu7aa hinte uyana, taani xammaqetanaw de7iya xinqatiya hinte xammaqetana. <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/>Shin taape ushacha baggaranne haddirsa baggara uttanayisata dooranaw taw maati baawa, shin he bessay Xoossay immanaw giigisidi wothidaysatasa” yaagis.<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>Hanko tammu tamaareti hessa si7ida wode, Yayqoobanne Yohaanisa bolla hanqetidosona. <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/>Yesuusi enta ubbaa baako xeegidi, “Ayhude gidonna asaa halaqati deriya haareyisata geetetidi xeegeteysanne haareysatas deriya bolla maati de7eysa hinte ereeta.<note caller="-" style="x"><char style="xo" closed="false">10:42 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">Luqa 22:25-26</ref>; <ref loc="MAT 23:11">Maato 23:11</ref>; <ref loc="MRK 9:35">Mar 9:35</ref>; <ref loc="LUK 22:26">Luqa 22:26</ref>.</char></note> <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/>Shin hinte giddon hessa mela gidenna; hinte giddon gitatanaw koyey oonika hintew aylle gidanaw bessees. <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/>Qassi hinte giddon ubbaafe bolla gidanaw koyey oonika hinte ubbaas aylle gidanaw bessees. <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/>Hari attoshin, Asa Na7ayka, asaas oothanawunne darota wozanaw ba shempuwa aathidi immanaw ysipe attishin, asi iyaw oothana mela yibeenna” yaagis.<verse eid="MRK 10:45"/></para>
  <para style="s1">Qooqiya Barximoosa</para>
  <para style="r">(<ref loc="MAT 20:29-34">Maato 20:29-34</ref>; <ref loc="LUK 18:35-43">Luqa 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>Enti Iyaarko katama bidosona. Yesuusi ba tamaaretaranne daro asaara Iyaarkofe keyishin, Ximoosa na7ay, qooqey, Barximoosa geeteteysi, oge gaxan woossishe uttis. <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>Barximoosi, yaara aadhey Naazirete Yesuusa gididaysa si7ida wode, ba qaala dhoqu oothidi, “Dawita na7aa Yesuusa, tana maararki!” yaagis.<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>Daro asay iya, “Hayza!” gidi hanqetidosona.</para>
  <para style="p" vid="MRK 10:48">Shin, I ba qaala kaseysafe daro dhoqu oothidi, “Dawita na7aw, tana maararki!” yaagis.<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>Yesuusi eqidi, “Iya haa xeegite” yaagis.</para>
  <para style="p" vid="MRK 10:49">Enti qooqiyako, “Aykoy baawa, denda eqa, nena xeegees” yaagidosona. <verse eid="MRK 10:49"/><verse number="50" style="v" sid="MRK 10:50"/>Qooqey ba ma7uwa holi yeggidi, gupi dendi eqidi, Yesuusako bis.<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>Yesuusi, “Taani new ay oothana mela koyay?” yaagis.</para>
  <para style="p" vid="MRK 10:51">Qooqey, “Astamaariyaw, ta xeellanaw koyayis” yaagis.<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>Yesuusi, “Ba, ne ammanoy nena pathis” yaagis. Iiraka iya ayfey xeellin, Yesuusa kaallis.<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s1">Gita Bonchon Yerusalaame Geluwa</para>
  <para style="r">(<ref loc="MAT 21:1-11">Maato 21:1-11</ref>; <ref loc="LUK 19:28-40">Luqa 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoha 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>Enti Yerusalaame matishe, Shamaho zuma matan de7iya Beetefaagenne Bitaane katamata gakidosona. Yesuusi ba tamaaretape nam7ata sinthe kiittidi, <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/>“Hintefe sinthan de7iya gutaa biite; yaa gelida mela oonika toggiboonna qashon de7iya hare mari hinte demmana, iya billidi, haa eki yiite. <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/>Oonika hintena, ‘Haysa ayis oothetii?’ yaagidi oychiko, ‘Goday iya koyees, ellesidi haa yeddana’ yaagite” yaagis.<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>Enti bidi, hare mari kare bolla oge matan qashetidi de7eysa demmidi billidosona. <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>He bessan eqida issi issi asati entako, “Hare maraa waatanaw billeetii?” yaagidi oychidosona. <verse eid="MRK 11:5"/><verse number="6" style="v" sid="MRK 11:6"/>Iya tamaareti Yesuusi bantana kiittidaysa odin, asati yeddi aggidosona. <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>Enti hare maraa Yesuusako ehidi, banta ma7uwa iya zokon hiixin Yesuusi he hare maraa toggis. <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>Daro asay banta ma7uwa ogiyan hiixidosona; qassi harati mitha tashe tashidi, ogen hiixidosona. <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/>Yesuusape sinthara hemetiya asaynne iya kaalliya asay banta qaala dhoqu oothidi,</para>
  <para style="q1" vid="MRK 11:9">“Hosaana!<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="fk" closed="false">Hosaana: </char><char style="xt"><ref loc="MAT 21:9">Maato 21:9</ref></char> be7ite.</note> Xoossay galatetto!</para>
  <para style="q2" vid="MRK 11:9">Godaa sunthan yeysi anjetidaysa.<note caller="-" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">Maz 118:25</ref>.</char></note><verse eid="MRK 11:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 11:10"/>Godaa sunthan yaa nu aawa</para>
  <para style="q2" vid="MRK 11:10">Dawita kawotethay anjetidaysa.</para>
  <para style="q1" vid="MRK 11:10">Ubbaafe Bolla Salon</para>
  <para style="q2" vid="MRK 11:10">de7iya Xoossay galatetto”</para>
  <para style="m" vid="MRK 11:10">yaagidosona.<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>Yesuusi Yerusalaame bidi, Xoossaa Keetha gelis. Qassi ubbaba yuuyi xeellidaape guye, sa7i qammiya gisho, tammanne nam7u tamaaretara Bitaane katama bis.<verse eid="MRK 11:11"/></para>
  <para style="s1">Yesuusi Baaddida Balase Mithiw</para>
  <para style="r">(<ref loc="MAT 21:18-19">Maato 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>Wontetha gallas enti Bitaanepe keyidi bishin, Yesuusi koshatis. <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>Haahon issi balase mithiw haytha xalaala ma7a uttidaaro be7idi, I bolla ayfey bentiko gidi, be7anaw iiko bis, shin iiko I biya wode, haytha xalaalape attishin, issi ayfeka demmibeenna; ayis giiko, balasey ayfiya wodey gakibeenna. <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>Yesuusi he balasiw, “Hiza, asi neepe merinaw ayfe moopo” yaagis. Iya tamaareti I geysa si7idosona.<verse eid="MRK 11:14"/></para>
  <para style="s1">Xoossa Keethan Zal7eyisata Kessis</para>
  <para style="r">(<ref loc="MAT 21:12-17">Maato 21:12-17</ref>; <ref loc="LUK 19:45-48">Luqa 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoha 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>Enti Yerusalaame bidosona; Yesuusi Xoossa Keethi gelidi, yan bayzeysatanne shammeyisata kare goodo oykis; qassi miishe laammeyisata xarpheezanne holle bayzeyisata oydiya shiri yeggidi, <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>asi aybibaaka tookidi, xoossa keetha giddora aadhona mela diggis. <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/>Yesuusi asaa haysada yaagidi tamaarsis: “Geeshsha Maxaafan, ‘Ta keethay asi ubbay Xoossaa woossiya keethi gidana’ geetetidi xaafetis. Shin hinte iya pangati qosetiya gongolo oothideta” yaagis.<note caller="-" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">Isa 56:7</ref>; <ref loc="JER 7:11">Ermi 7:11</ref>.</char></note><verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>Kahine halaqatinne higge astamaareti hessa si7idi, iya wodhanaw oge koydosona. Shin daro asay iya timirtiyan malaaletiya gisho, iyaw babidosona.<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>Sa7ay omarsiya wode Yesuusinne iya tamaareti katamaape gaxa keyidosona.<verse eid="MRK 11:19"/></para>
  <para style="s1">Balase Mithiya Melasu</para>
  <para style="r">(<ref loc="MAT 21:20-22">Maato 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>Enti wontetha gallas he ogiyara aadhishe, he balasiya xaphora melidaaro be7idosona. <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>Phexroosi akeekidi, “Astamaariyaw, Heko, neeni baaddida balasiya melasu” yaagis.<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>Yesuusi zaaridi, “Xoossaa ammanite. <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/>Taani hintew tuma odayis; oonika ba wozanan sidhonna gidabay hananaysa ammanidi, ha zumaa, ‘Dendada abban kunda’ yaagiko iyaw hanana.<note caller="-" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">Maato 17:20</ref>; <ref loc="2CO 13:2">2 Qoro 13:2</ref>.</char></note> <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/>Hessa gisho, taani hintew odayis; Xoossaa hinte woossiyabanne oychiyaba ayba gidikoka ekidaada ammanite, hinte ekana. <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/>Xoossaa woossanaw hinte eqiya wode, salon de7iya hinte Aaway hinte nagara atto gaana mela, oonika hintena naaqidabay de7iko, iyaw atto giite. <verse eid="MRK 11:25"/><verse number="26" style="v" sid="MRK 11:26"/>Shin asa nagara hinte atto goonna ixiko, salon de7iya hinte Aawayka hinte nagaraa hintew atto geenna” yaagis.<verse eid="MRK 11:26"/></para>
  <para style="s1">Yesuusa Maatay Oyshetis</para>
  <para style="r">(<ref loc="MAT 21:23-27">Maato 21:23-27</ref>; <ref loc="LUK 20:1-8">Luqa 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>Enti zaaridi Yerusalaame bidosona. Yesuusi xoossa keethan hemetishin, kahine halaqati, higge astamaaretinne cimati iyako yidi, <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>“Neeni haysa oothanaw new ay maati de7ii? Woyko new ha maata immiday oonee?” yaagidosona.<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>Yesuusi zaaridi, “Ta hintena issiba oychana, taw odite. Ta qassi haysa ay maatan oothiyako, hintew odana. <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/>Yohaanisa xinqatey Xoossafeye woyko asapee? Taw odite” yaagis.<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>Enti banta giddon palama doomidi, “Nuuni, ‘Xoossafe’ giiko, I nuuko, ‘Yaatin, Yohaanisi odidaysa ayis ammanibeketii?’ yaagana. <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>‘Asape giiko’ asa ubbay Yohaanisi nabe gideysa eroosona.” Hessa gisho, asaas yayidosona. <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>Hessa gisho, enti Yesuusako, “Nuuni eroko” yaagidi zaaridosona.</para>
  <para style="p" vid="MRK 11:33">Yesuusi, “Taanika haysa ay maatan oothiyako, hintew odike” yaagis.<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s1">Goshshanchota Leemiso</para>
  <para style="r">(<ref loc="MAT 21:33-46">Maato 21:33-46</ref>; <ref loc="LUK 20:9-19">Luqa 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>Yesuusi entaw leemison yaagidi odis: “Issi uray woyne tokidi, iya yuushon dirsi diris. Qassi he woyne gum7iya olla bookis. Iya naaganaw adussa shako shakis. Hessafe guye, kothe oothiya asas immidi, hara biitta bis.<note caller="-" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ISA 5:1">Isa 5:1</ref>.</char></note> <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/>Woyne ayfiya maxiya wodey gakin, bana gakiya gishuwa ehana mela, issi ba aylliya kothe aawatako yeddis. <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/>Kothe aawati iya aylliya oykidi wadhidi, mela kushe yeddidosona. <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/>Nam7antho hara aylle entako kiittin, enti he aylliya huuphiya qoo7idi kawushidi yeddidosona. <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/>Woyne atakiltiya goday qassika hara aylle kiittis. He aylliya wodhidosona, qassi hara darota hessada oothidosona, issota issota wadhidi, harata wodhidosona.<verse eid="MRK 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 12:6"/>“Woyne atakiltiya godaas kiittanaw ubbaafe wursethan I daro dosiya ba na7aa xalaali attis. I, ‘Enti ta na7aa bonchona aggokona’ gidi, ba na7aa entako kiittis.<verse eid="MRK 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 12:7"/>“Shin kothe aawati banta giddon, ‘Laattanaysi haysa; yedhite iya wodhoos; iya laatay nubaa gidana!’ yaagidosona. <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/>Na7aa oykidi wodhidi, iya aha woyne gadiya giddofe gaxa kessidi yeggidosona.<verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>“Hiza, woyne gadiya goday waatanee? Yidi he kothe aawata wodhi ongidi, woyniya kothe oothiya hara asas immana.<verse eid="MRK 12:9"/></para>
  <para style="q1">
    <verse number="10-11" style="v" sid="MRK 12:10-11"/>“ ‘Gimbeysati boridi ixida shuchay</para>
  <para style="q2" vid="MRK 12:10-11">godaa xaphuwa minthiya,</para>
  <para style="q2" vid="MRK 12:10-11">ubbaafe aadhiya shuchu gidis.</para>
  <para style="q1" vid="MRK 12:10-11">Haysi Goday oothidaba;</para>
  <para style="q2" vid="MRK 12:10-11">qassi nu ayfiyaska malaalsiyaba’</para>
  <para style="m" vid="MRK 12:10-11">yaageysa Geeshsha Maxaafape nabbabibeketii?” yaagis.<note caller="-" style="x"><char style="xo" closed="false">12:10-11 </char><char style="xt" closed="false"><ref loc="PSA 118:22-23">Maz 118:22-23</ref>.</char></note><verse eid="MRK 12:10-11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>Kahine halaqati, higge astamaaretinne cimati Yesuusi he leemisuwa banta bolla leemisidaysa erida gisho, iya oykanaw koydosona, shin asaas yayyidi, aggidi bidosona.<verse eid="MRK 12:12"/></para>
  <para style="s1">Giiraba</para>
  <para style="r">(<ref loc="MAT 22:15-22">Maato 22:15-22</ref>; <ref loc="LUK 20:20-26">Luqa 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>Qassi iya odaape bala demmidi, iya oykana mela, Farsaawetapenne Herodiisa baggatape guutha asata iyako kiittidosona. <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>Enti iyako yidi, “Astamaariyaw, neeni tuma odeteysanne asape ase shaakonnaysa nuuni eroos. Neeni ase dummayaka; qassi Xoossaa ogiya tumatethan tamaarsaasa. Nuuni Roome biitta Kawa Qeesares giira giireysi wogeye woga gidennee? Giira giirane agganee?” yaagidosona.<verse eid="MRK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15"/>Shin Yesuusi enta cubbotethaa eridi, “Tana ayis paacetii? Ane issi santime tana bessite” yaagis. <verse eid="MRK 12:15"/><verse number="16" style="v" sid="MRK 12:16"/>Enti iyaw ehidosona, “Ha misileynne sunthay oodebayee?” yaagidi enta oychis.</para>
  <para style="p" vid="MRK 12:16">Enti, “Roome Kawa Qeesareysa” yaagidosona.<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>Yesuusi zaaridi, “Yaatiko, Qeesareba Qeesares, Xoossaba Xoossaas immite” yaagin enti iyabaa malaaletidosona.<verse eid="MRK 12:17"/></para>
  <para style="s1">Hayqope Dendoba</para>
  <para style="r">(<ref loc="MAT 22:23-33">Maato 22:23-33</ref>; <ref loc="LUK 20:27-40">Luqa 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>Hayqida asi dendenna giya Saduqaawetape issi issi asati Yesuusako yidi, haysada yaagidi, iya oychidosona.<note caller="-" style="x"><char style="xo" closed="false">12:18 </char><char style="xt" closed="false"><ref loc="ACT 23:8">Hawa 23:8</ref>.</char></note> <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/>“Astamaariyaw, Musey nuus higgiya xaafishe, ‘Macho ekida asi na7a yelonna hayqiko, he hayqidaysa ishay iya machiw ekidi, ba ishaas na7a yelanaw bessees’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">12:19 </char><char style="xt" closed="false"><ref loc="DEU 25:5">Zaare 25:5</ref>.</char></note> <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>Beni wode laapun ishati de7eysatape bayray macho ekidi, na7a yelonna hayqis. <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>Nam7anthoy iyo ekis, ika na7a yelonna hayqis. Heedzanthoyka hessada hanis. <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>Laapunatika hessatho iyo ekidi, na7a yelonna hayqidosona. Ubbaafe guye, qassi he maccasiya hayqasu. <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>Yaatin, laapunati iyo ekida gisho hayqida asay hayqope dendiya gallas, iya entafe awusas macho gidanee?” yaagidosona.<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>Yesuusi zaaridi, “Hinte baletey, Geeshsha Maxaafata woyko Xoossaa wolqaa eronna gishosa! <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/>Hayqida asay hayqope dendiya gallas, salon de7iya kiitanchota mela gidanaape attishin, ekokona; gelekona. <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/>Shin hayqidaysata denduwaba gidiko, Muse maxaafan xaafetida xuugetiya tushiyaba odiya bessan, Xoossay Museko, ‘Taani, Abrahaame Xoossa, Yisaaqa Xoossa, Yayqooba Xoossa’ gidaysa nabbabibeketii?<note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Kessa 3:6</ref>.</char></note> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/>Hessa gisho, I, paxa de7eyisata Xoossaafe attishin, hayqidaysata Xoosse gidenna. Hinte daro balideta” yaagis.<verse eid="MRK 12:27"/></para>
  <para style="s1">Ubbaafe Bayra Kiita</para>
  <para style="r">(<ref loc="MAT 22:34-40">Maato 22:34-40</ref>; <ref loc="LUK 10:25-28">Luqa 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>Higge astamaaretape issoy enti palameysa shiiqidi si7is. Qassi Yesuusi entaw loythi zaaridaysa si7idi, “Kiita ubbaafe aadhiya kiitay awusee?” yaagidi Yesuusa oychis.<note caller="-" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luqa 10:25-28</ref>.</char></note><verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>Yesuusi zaaridi, iya haysada yaagis: “Kiita ubbaafe aadhiya kiitaa si7ite; ‘Isra7eele asaw, Goday nu Xoossay issi Godaa.<note caller="-" style="x"><char style="xo" closed="false">12:29 </char><char style="xt" closed="false"><ref loc="DEU 6:4-5">Zaare 6:4-5</ref>.</char></note> <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/>Ne Godaa ne Xoossaa ne kumetha wozanape, ne kumetha shempuwafe, ne kumetha qofaape, ne kumetha wolqaafe dosa’ yaagees. <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/>Qassi kiita ubbaafe aadhiya nam7antho kiitay haysa; ‘Ase ubbaa ne huuphiyada dosa’ yaageysa; haysatape aadhiya hara kiiti baawa” yaagis.<note caller="-" style="x"><char style="xo" closed="false">12:31 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Leewe 19:18</ref>.</char></note><verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>Higge astamaarey Yesuusako, “Astamaariyaw, tuma gadasa; neeni ‘Xoossay issi Xoossaa xalaala. Iyape attishin, hari baawa’ gidaysi tuma.<note caller="-" style="x"><char style="xo" closed="false">12:32 </char><char style="xt" closed="false"><ref loc="DEU 4:35">Zaare 4:35</ref>.</char></note> <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/>Xoossaa kumetha wozanape, kumetha qofaapenne kumetha wolqaafe doseysinne qassi ase ubbaa ba huuphiyada doseysi, xuussa yarshofenne hara yarsho ubbaafe aadhees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hose 6:6</ref>.</char></note><verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>Yesuusi higge astamaariya zaaroy aadhida erancho asa zaaro gididaysa be7idi, “Neeni Xoossaa kawotethaafe haakabaaka” yaagis; hessafe guye, Yesuusa haraba oychanaw oonika minnibeenna.<note caller="-" style="x"><char style="xo" closed="false">12:34 </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">Luqa 10:25-28</ref>.</char></note><verse eid="MRK 12:34"/></para>
  <para style="s1">Kiristoosi Oodde Na7ee?</para>
  <para style="r">(<ref loc="MAT 22:41-46">Maato 22:41-46</ref>; <ref loc="LUK 20:41-46">Luqa 20:41-46</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>Yesuusi xoossa keethan tamaarsishe, haysada yaagis: “Higge astamaareti Kiristoosa woygidi Dawita na7a goonna? <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/>Dawiti Geeshsha Ayyaanan kumidi,</para>
  <para style="q1" vid="MRK 12:36">“ ‘Goday, ta Godaa, “Taani ne morketa</para>
  <para style="q2" vid="MRK 12:36">ne tohoy yedhiyaso oothana gakanaw,</para>
  <para style="q2" vid="MRK 12:36">haysan taape ushacha baggara utta” gis’ yaagis.<note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz 110:1</ref>.</char></note><verse eid="MRK 12:36"/></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>Dawiti ba huuphen Kiristoosa, ‘Godaa’ gidi xeegiko, yaatin, Kiristoosi waanidi, Dawita na7a gidi?” yaagis.</para>
  <para style="p" vid="MRK 12:37">Daro asay Yesuusi geysa ufaysan si7idosona.<verse eid="MRK 12:37"/></para>
  <para style="s1">Higge Astamaaretanne Farsaaweta Ayye!</para>
  <para style="r">(<ref loc="MAT 23:1-36">Maato 23:1-36</ref>; <ref loc="LUK 20:45-47">Luqa 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38"/>Yesuusi tamaarsishe, haysada yaagis: “Higge astamaaretape naagetite; enti adussa ma7o ma7idi yuuyeysanne giyanka asay enta bonchidi sarotheysa dosoosona. <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/>Enti ayhude woosa keethatan daro lo77iya oydiya dosoosona; qassi asi bantana mokiya bessan boncho bessi dosoosona. <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/>Enti am7eta keethaa bonqidi, bantaw lo77o daananaw woosa adussosona; enti ubbaafe aadhiya pirdaa ekana” yaagis.<verse eid="MRK 12:40"/></para>
  <para style="s1">Am7e Muxaata</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luqa 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>Yesuusi xoossa keethan muxaata yeggiya saaxiniya matan uttidi, asay ba miishiya he saaxiniyan yeggeysa be7is; daro dure asay daro miishiya he saaxiniyan yeggoosona. <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>Issi manqo am7iya yada, nam7u bakanna he saaxiniyan yeggasu. <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>Yesuusi ba tamaareta xeegidi, “Taani hintew tuma odayis; muxaata saaxiniyan yeggida asa ubbaafe ha manqo am7iya darsada yeggasu. <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/>Ayis giiko, harati ubbay bantaw palahida miishiyape yeggidosona. Shin iya ba pacaape, baw de7iya aquwa kumethi immasu” yaagis.<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s1">Xoossa Keethay Laaletonna Attenna</para>
  <para style="r">(<ref loc="MAT 24:1-2">Maato 24:1-2</ref>; <ref loc="LUK 21:5-6">Luqa 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>Yesuusi Xoossa Keethafe keyishin, iya tamaaretape issoy, “Astamaariyaw, ha lo77o shuchaanne ha lo77o shucha keethaa be7ay!” yaagis.<verse eid="MRK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2"/>Yesuusi zaaridi, “Ha gita shucha keethaa be7ay? Ha keethay shuchi shucha bolla gimbetida mela laaletonna attenna; issi shuchika attonna ubbay laaletana” yaagis.<verse eid="MRK 13:2"/></para>
  <para style="s1">Wode Wursetha Malaatata</para>
  <para style="r">(<ref loc="MAT 24:3-14">Maato 24:3-14</ref>; <ref loc="LUK 21:7-19">Luqa 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>Yesuusi Xoossa keethafe hini baggara Shamaho zuma bolla uttidashin, Phexroosi, Yayqoobi, Yohaanisinne Indiriyasi bantarka iyako yidi, <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>“Haysi awude hananeeko nuus oda; ha ubbay poletana wodiya erisiya malaatay aybee?” yaagidi oychidosona.<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>Yesuusi qassi entako haysada yaagidi odis. “Hintena oonika balethonna mela naagetite. <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/>Daro asati ta sunthan, ‘Taani Kiristoosa’ yaagidi tamaarsishe yidi, daro asaa balethana. <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/>Matan de7iya olaanne haahon de7iya ola wore hinte si7iya wode hirgofite. Hessa melabay hananaw bessees, shin wursethay buroona. <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/>Issi biitta asay hara biitta asaara oletana; qassi issi kawotethay hara kawotethatara oletana; biitta qaaxoy ubba bessan hanana; koshay daana, shin hessi ubbay yelo iqethas zooke mela.<verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>“Shin hinte, hinte huuphen naagetite. Ayis giiko, asi hintena oykidi, pirda keethas aathidi immana; qassi ayhude woosa keethatanka hintena lisson garaafana; deriya haareyisata sinthaninne kawota sinthan ta gisho hinte markatanaw eqana.<note caller="-" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">Maato 10:17-20</ref>; <ref loc="LUK 12:11-12">Luqa 12:11-12</ref>.</char></note> <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/>Wursethay gakanaape sinthe wongelay koyro dere ubbaas odetanaw bessees. <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/>Enti hintena pirda keethi ehiya wodenne aathidi immiya wode, woygidi odaneko koyro hirgofite; he saatiyan Xoossay hintew immiyaba odite. Hintenan Geeshsha Ayyaanay odeteesipe attishin, hintena gideketa.<verse eid="MRK 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 13:12"/>“Ishay ba ishaa, aaway ba na7aa wodhisana. Nayti bantana yelidaysata bolla dendidi, enta wodhisana. <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/>Asa ubbay hintena ta suntha gisho ixana, shin wursethi gakanaw minniday attana.<note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Maato 10:22</ref>.</char></note><verse eid="MRK 13:13"/></para>
  <para style="s1">Yaana Iita Metuwa</para>
  <para style="r">(<ref loc="MAT 24:15-28">Maato 24:15-28</ref>; <ref loc="LUK 21:20-24">Luqa 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>“Shin dhayo tunatethay eqanaw bessonna bessan eqidashin hinte be7ana.” (Akeekiso: Hessi woy guusseko nabbabeysi akeeko!) “Yihuda biittan he wode de7eysati deriyako baqato.<note caller="-" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DEU 9:27">Zaare 9:27</ref>; <ref loc="DEU 11:31">11:31</ref>; <ref loc="DEU 12:11">12:11</ref>.</char></note> <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/>Keetha huuphen de7iya urayka issiba ekanaw duge wodhidi, ba soo gelopo.<note caller="-" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="LUK 17:31">Luqa 17:31</ref>.</char></note> <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/>Gaden de7eysi ba ma7uwa ekanaw guye simmofo. <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/>He wode qanthatida maccasatasinne dhanthiya maccasatas daro un7a gidana. <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/>Shin haysi ubbay haniya wodey balgo gidonna mela, Xoossaa woossite. <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/>Ayis giiko, Xoossay alamiya medhida wodiyape doomidi, ha77i gakanaw haniboonna metoynne sinthafeka hanonna metoy asa bolla he wode hanana.<note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DEU 12:1">Zaare 12:1</ref>; <ref loc="REV 7:14">Qon 7:14</ref>.</char></note> <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/>Goday he gallasata taybuwa guuthonnaako, ase gidida oonika attenna. Shin I ba doorida asa gisho, he gallasata taybuwa guuthees.<verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>“He wode oonika hintena, ‘Heko, Kiristoosi haysan de7ees woyko Kiristoosi hinin de7ees’ yaagiko, hessa ammanopite. <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/>Wordancho Kiristoosatinne wordo nabeti dendidi bantaw danda7etiko, hari attoshin Xoossay dooridaysataka balethanaw malaatatanne malaalsiyabata bessaana. <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/>Shin hinte naagetite; taani hintew ubbaba kasetada odas.<verse eid="MRK 13:23"/></para>
  <para style="s1">Asa Na7a Yuussaa</para>
  <para style="r">(<ref loc="MAT 24:29-31">Maato 24:29-31</ref>; <ref loc="LUK 21:25-28">Luqa 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>“Shin he wode he waayiyape guye,</para>
  <para style="q2" vid="MRK 13:24">away dhumana;</para>
  <para style="q2" vid="MRK 13:24">ageenay poo7uwa aggana.<note caller="-" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="ISA 13:10">Isa 13:10</ref>; <ref loc="JER 2:10">Ermi 2:10</ref>.</char></note><verse eid="MRK 13:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="MRK 13:25"/>Xoolintoti salope kundana;</para>
  <para style="q2" vid="MRK 13:25">qassi salon de7iya wolqatika qaaxana.<note caller="-" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">Isa 34:4</ref>; <ref loc="REV 6:13">Qon 6:13</ref>; <ref loc="JER 2:10">Ermi 2:10</ref>.</char></note><verse eid="MRK 13:25"/></para>
  <para style="m">
    <verse number="26" style="v" sid="MRK 13:26"/>He wode Asa Na7ay, gita wolqaranne bonchuwara shaara giddora yishin enti be7ana.<note caller="-" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DEU 7:13">Zaare 7:13</ref>; <ref loc="REV 1:7">Qon 1:7</ref>.</char></note> <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/>He wode I kiitanchota sa7a oyddu bagga kiittana; sa7a gaxape salo gaxa gakanaw, Xoossay doorida asaa shiishana.<verse eid="MRK 13:27"/></para>
  <para style="s1">Balase Mithafe Tamaarite</para>
  <para style="r">(<ref loc="MAT 24:32-35">Maato 24:32-35</ref>; <ref loc="LUK 21:29-33">Luqa 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>“Leemisuwa balase mithafe akeekite; balasiya aaciya wodenne I haythay cil7iya wode, torchey matatidaysa hinte ereeta. <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/>Hessadaka, hinte he ubbabay haneysa be7iya wode, I matidi penge gakidaysa erite. <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/>Taani hintew tuma odayis; ha ubbabay hanana gakanaw haysan de7iya asa ubbay hayqenna. <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/>Saloynne sa7i aadhana, shin ta qaalay aadhenna.<verse eid="MRK 13:31"/></para>
  <para style="s1">Yesuusi Yaana Galasay Eretenna</para>
  <para style="r">(<ref loc="MAT 24:36-44">Maato 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>“Shin he gallasaanne he saatiya Aawa xalaalape attishin, hari attoshin salon de7iya kiitanchota gidin woyko Na7aa gidin oonika erey baawa.<note caller="-" style="x"><char style="xo" closed="false">13:32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">Maato 24:36</ref>.</char></note> <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/>He wodey awude gidaneeko, hinte eronna gisho, naagetitenne minnite. <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/>Ta yuussay, ba keetha aggidi, oge biya asa mela. Uray ba aylletas huuphen huuphen ooso immidi enta ba oosuwa bolla aawa oothis; qassi naageysi minthidi naagana mela kiittis.<note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36">Luqa 12:36</ref>.</char></note><verse eid="MRK 13:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 13:35"/>“Hessa gisho, minnite. Ayis giiko, goday omarsi gidin woyko giddi bilahe gidin woyko kutto waaso gidin woyko wonti maathe gidin awude yaaneko, hinte ereketa. <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/>Hinte akeekona I yidi hinte dhiskidi de7ishin demmonna mela minnite. <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/>Taani hintew odeysa asa ubbaas odayis; minnite” yaagis.<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s1">Yesuusa Bolla Maqetidosona</para>
  <para style="r">(<ref loc="MAT 26:1-5">Maato 26:1-5</ref>; <ref loc="LUK 22:1-2">Luqa 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoha 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>Paasika Ba7aale bonchiya gallasinne Uytha Ba7aale bonchiya gallasi gakanaw nam7u gallasi attis. Kahine halaqatinne higge astamaareti asi eronna Yesuusa oykidi wodhiya oge koyoosona.<note caller="-" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1">Kessa 12:1</ref>.</char></note> <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>“Asay ooshshi kessonna mela Paasika bonchiya gallasan hessa oothoko” yaagidosona.<verse eid="MRK 14:2"/></para>
  <para style="s1">Yesuusa Shitto Tiyida Maccasiw</para>
  <para style="r">(<ref loc="MAT 26:6-13">Maato 26:6-13</ref>; <ref loc="JHN 12:1-8">Yoha 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>Yesuusi Bitaane kataman baro hargancho gidida Simoona son gibira bolla uttidashin, issi maccasiya albasxiroosa shuchafe oosetida philqaaxe kumetha nardoose geetetiya daro al7o shitto ekada yasu. He philqaaxe menthada shittuwa Yesuusa huuphen tigasu.<note caller="-" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37">Luqa 7:37</ref>.</char></note> <figure style="fig" alt="Alabaster jars" file="HK00142B.tif" size="col" ref="14:3">Albasxiroosa</figure> <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>He bessan de7iya asape issoy issoy hanqetidi, “Ha shittoy mela coo iitey aybisee? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Ha shittuwa heedzu xeetu dinaaren<note caller="+" style="f"><char style="fr" closed="false">14:5 </char><char style="fk" closed="false">Heedzu xeetu dinaare: </char><char style="ft" closed="false">Issi asas laythan cigetiya lo77o daamozepe bolla gidiya miishe.</char></note> bayzidi, miishiya manqotas immanaw danda7etees” yaagidi banta giddon odetidosona. Yaatidi, he maccasiw daro boridosona.<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>Shin Yesuusi “Ha maccasiw aykoka goopite; iyo ayis waaysetii? Iya taw lo77oba oothasu. <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/>Manqoti ubba wode hintera de7oosona. Hinte koyida wode awudeka hinte enta maaddanaw danda7eeta, shin taani ubba wode hintera de7ike.<note caller="-" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">Zaare 15:11</ref>.</char></note> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/>Iya ba danda7idaysa oothasu; qassi tana moogoos giigisanaw kasetada shitto tiyasu. <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/>Taani hintew tuma odayis; sa7a ubban wongela odiya bessa awunka, asay iyo akeekana mela ha iya oothidaysi odetana” yaagis.<verse eid="MRK 14:9"/></para>
  <para style="s1">Yihudi Yesuusa Aathidi Imuwa</para>
  <para style="r">(<ref loc="MAT 26:14-16">Maato 26:14-16</ref>; <ref loc="LUK 22:3-6">Luqa 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>Tammanne nam7u tamaaretape issoy Asqoroota Yihuda geeteteysi Yesuusa kahine halaqatas aathidi immanaw entako bis. <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>Enti hessa si7ida wode ufaytidi, “Nuuni new miishe immana” yaagidosona; Yihudi Yesuusa aathidi immanaw inje wode koyees.<verse eid="MRK 14:11"/></para>
  <para style="s1">Godaa Kahuwa</para>
  <para style="r">(<ref loc="MAT 26:26-30">Maato 26:26-30</ref>; <ref loc="LUK 22:14-20">Luqa 22:14-20</ref>; <ref loc="2CO 11:23-25">2 Qoro 11:23-25</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>Uytha miya gallas bonchiya koyro gallas, Paasika katha maanaw maraze shukiya wode, Yesuusa tamaareti iyako, “Paasika bonchiya gallas neeni maana katha nuuni aw bidi giigisino?” gidi oychidosona.<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>Yesuusi ba tamaaretape nam7ata haysada yaagidi kiittis: “Katamaa biite; hinte bishin, otora haathe tookida issi uray hintera gahetana; iya kaallite. <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/>I bidi geliya keetha godaa, ‘Astamaarey neeko, “Taani ta tamaaretara Paasika maanaw imatha kifiley awunee?” yaagees’ yaagite. <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/>Goday hintena pooqiya bolla de7iya giigidi uttida dalga kifile bessaana; hessan giigisite” yaagis. <figure style="fig" alt="Two-story house with steps to roof" file="LB00235B.tif" size="col" ref="14:15">Ayhude Keetha Kaara</figure><verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>He nam7u tamaareti keyidi, katama bidosona; Yesuusi entaw odidaysada demmidi, Paasika kathi giigisidosona.<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>Sa7ay omarsiya wode Yesuusi tammanne nam7u tamaaretara yaa bis. <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/>Enti uttidi kathi mishin, Yesuusi entako, “Taani hintew tuma odayis; hintefe issoy taara meysi, tana aathidi immana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">Maz 41:9</ref>.</char></note><verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>Iya tamaareti dagammidi, banta huuphen huuphen, “Tuma taneshsha?” yaagidi iya oychidosona.<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>Yesuusi zaaridi, “He uray, hinte tammanne nam7atape issuwa; I taara issife tushanaw ba uytha shaaten yeddeysa. <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/>Asa Na7ay, Geeshsha Maxaafay hayqana gidaysada hayqana, shin Asa Na7a, aathidi immiya ura ayye! He uray yeletonna attidaako iyaw lo77oshin” yaagis.<verse eid="MRK 14:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>Enti mishin, Yesuusi uythaa ekidi, Xoossaa galatis; he uytha menthidi, ba tamaaretas immishe, “He7ite, haysi ta ashuwa” yaagis.<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>Xuu7a ekidi, Xoossaa galatidi, entaw immin ubbayka he xuu7ape uyidosona. <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/>Yesuusi, “Haysi ooratha caaquwan daro asaa gisho gukiya ta suutha. <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/>Taani hintew tuma odayis; taani Xoossaa kawotethan ooratha woyne uyana gallasi gakanaw zaarada ha woyniyape uyike” yaagis.<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>Mazmure yexidaape guye, Shamaho zuma bolla bidosona.<verse eid="MRK 14:26"/></para>
  <para style="s1">Phexroosi Yesuusa Kaddanaysi Odetis</para>
  <para style="r">(<ref loc="MAT 26:31-35">Maato 26:31-35</ref>; <ref loc="LUK 22:31-34">Luqa 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoha 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>Yesuusi entako, “Hinte ubbay tana yeggi aggidi baqatana; Geeshsha Maxaafay,</para>
  <para style="q1" vid="MRK 14:27">“ ‘Xoossay wude aawa shocana,</para>
  <para style="q2" vid="MRK 14:27">dorsati ubbay laaletana’</para>
  <para style="m" vid="MRK 14:27">yaagees.<note caller="-" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">Zaka 13:7</ref>.</char></note> <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/>Shin taani hayqope dendidaape guye, hintefe sinthatada Galila baana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">Maato 28:16</ref>.</char></note><verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>Phexroosi zaaridi, “Enti ubbay nena yeggi aggidi baqatikoka, ta nena aggike” yaagis.<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>Yesuusi Phexroosako, “Taani new tuma odayis; hachi qamma kuttoy nam7u toho waassanaape sinthe neeni tana heedzu toho kaddana” yaagis.<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>Shin Phexroosi kaseysafe minthidi, “Taani hari attoshin, neera issife hayqiyakoka, nena kaddike” yaagis. Qassi harati ubbatika hessada gidoosona.<verse eid="MRK 14:31"/></para>
  <para style="s1">Yesuusi Geetasamanen Woossis</para>
  <para style="r">(<ref loc="MAT 26:36-46">Maato 26:36-46</ref>; <ref loc="LUK 22:39-46">Luqa 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>Geetasemaane geetetiya bessaa bidosona; Yesuusi ba tamaaretako, “Taani Xoossaa woossada simmana gakanaw hinte haysan uttishite” yaagis.<verse eid="MRK 14:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 14:33"/>Yesuusi Phexroosa, Yayqoobanne Yohaanisa baara ekidi bis; daro waayetisinne un7etis. <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>Qassi entako, “Taani hayqana gakanaw azzanas, haysan gam7ishite; dhiskofite” yaagis.<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>Guuthi sinthe shiiqidi, sa7an gufannidi, danda7etiyaba gidiko, he waayiya saatey baape aadhana mela, Xoossa woossis. <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/>Qassi, “Abba, ta Aawaw, ubbabay new danda7etees, ha waaye xuu7aa taape digga. Shin ne sheney hanope attishin, ta sheney hanopo” yaagis.<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>Yesuusi ba tamaaretako simmi yidi, enti dhiskidashin demmidi, Phexroosako, “Simoona, dhiskadii? Neeni issi saateka barkada naaganaw danda7abikii? <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/>Paacen hinte gelonna mela barkidi naagitenne Xoossaa woossite. Hintew lo77o amoy de7ees, shin hinte daaburancho asi” yaagis.<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>Qassika bidi kaseysada Xoossa woossis. <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>Ba tamaaretako guye simmidi yaa wode, dhiskidashin demmis. Enta ayfiya dhiskoy goozi wothida gisho, iyako ay odetiyakoka erokona.<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>Heedzantho entako yidi, “Ha77i gakanawuka dhisketinne shempetii? Hiza, gidana; saatey gakis; be7ite! Asa Na7ay, nagarancho asaas aadhidi imetana wodey gakis. <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/>Dendidi yedhite; be7ite, tana aathidi immanaysi gakis” yaagis.<verse eid="MRK 14:42"/></para>
  <para style="s1">Yesuusa Oyketetha</para>
  <para style="r">(<ref loc="MAT 26:47-56">Maato 26:47-56</ref>; <ref loc="LUK 22:47-53">Luqa 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoha 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>Yesuusi hessa buroo odishin, tammanne nam7u iya tamaaretape issoy, Yihudi, ellesidi gaki wodhis. Qassi kahine halaqati, higge astamaaretinne cimati kiittin, mashshanne xam7a oykida daro asay iyara issife yidosona. <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>Yesuusa aathidi immanaysi he daro asaas, “Taani yeeriya uray iya; iya oykidi, loythi naagidi efite” yaagidi malla odi wothis.<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>Yihudi gaki wodhida mela Yesuusako shiiqidi, “Astamaariyaw” yaagidi Yesuusa yeeri ekis. <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>He daro asay Yesuusa oykidosona. <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>Shin matan eqidaysatape issoy ba mashsha shoddidi kahine halaqaa aylliya shocidi, iya haytha qanxidi holis.<verse eid="MRK 14:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 14:48"/>Yesuusi zaaridi, he shiiqida daro asaako, “Tana panga kessidi, panga oykeysada oykanaw mashshenne xam7a oykidi yidetii? <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/>Taani xoossa keethan tamaarsashe, gallas gallas hintera de7iya wode tana oykibeeketa, shin Geeshsha Maxaafay gidaysi poletanaw bessees” yaagis.<note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Luqa 19:47</ref>; <ref loc="LUK 21:37">21:37</ref>.</char></note><verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>Iya tamaareti ubbay iya yeggi aggidi baqatidosona.<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>Laxana xalaala ma7ida issi na7atetha uray Yesuusa kaalleysa asay oykis. <verse eid="MRK 14:51"/><verse number="52" style="v" sid="MRK 14:52"/>Shin he uray laxana yeggi aggidi, xire kallo baqatis.<verse eid="MRK 14:52"/></para>
  <para style="s1">Yesuusi Pirda Shango Sinthan</para>
  <para style="r">(<ref loc="MAT 26:57-68">Maato 26:57-68</ref>; <ref loc="LUK 22:54-55">Luqa 22:54-55</ref>, <ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">Yoha 18:13-14</ref>, <ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>Asay Yesuusa kahine halaqaa soo efidosona. Yan kahine halaqati, cimatinne higge astamaareti shiiqidi de7oosona. <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>Phexroosi kahine halaqaa zabbaa gakanaw haahon iya kaalli bidi yan naageysatara uttidi tama kayees.<verse eid="MRK 14:54"/></para>
  <para style="p">
    <verse number="55" style="v" sid="MRK 14:55"/>Kahine halaqatinne shiiqida asa ubbay Yesuusa wodhanaw iya bolla marka koydosona, shin aykoka demmibookona. <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>Daro asati iya bolla wordo markatidosona, shin enta markatethay issino gidibeenna.<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57-58" style="v" sid="MRK 14:57-58"/>Issi issi asati dendi eqidi Yesuusa bolla, “I, ‘Taani asi keexida ha Xoossa Keetha laallada, asa kushen keexetiboonna hara Xoossa Keetha heedzu gallasa giddon keexana’ gishin nuuni si7ida” yaagidi wordo markatidosona.<note caller="-" style="x"><char style="xo" closed="false">14:57-58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">Yoha 2:19</ref>.</char></note> <verse eid="MRK 14:57-58"/><verse number="59" style="v" sid="MRK 14:59"/>Gidoshin, enta markatethay hessanka issino gidibeenna.<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>Kahine halaqay asa ubba sinthan dendi eqidi, “Haysati nena mootiya mootuwas ne zaariyabay baawee?” yaagidi Yesuusa oychis. <verse eid="MRK 14:60"/><verse number="61" style="v" sid="MRK 14:61"/>Shin Yesuusi si77i gis; aykoka zaaribeenna. Kahine halaqay, “Anjetida Xoossaa Na7ay, Kiristoosi neneyee?” yaagidi zaari oychis.<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>Yesuusi zaaridi, “Ee tana, hinte Asa Na7ay, wolqaama Xoossaafe ushacha baggara uttidashin qassi saluwa shaarara yishin be7ana” yaagis.<note caller="-" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">Daane 7:13</ref>.</char></note><verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>Kahine halaqay ba ma7uwa peedhidi, “Nuna hara marka ay koshshii? <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/>Hinte iya cashsha si7ideta; hinte qofay aybee?” yaagis. Enti ubbay, “I hayqanaw bessees” yaagidi iya bolla pirdidosona.<note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:15">Leewe 24:15</ref>.</char></note><verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>Entafe issoti issoti iya bolla cutethi oykidosona. Iya ayfiya goozidi baqishe, “Nena dechiday oonee? Ane nuus oda!” yaagidosona. Naageysati iya eki efidi garaafidosona.<verse eid="MRK 14:65"/></para>
  <para style="s1">Phexroosi Yesuusa Kaddis</para>
  <para style="r">(<ref loc="MAT 26:69-75">Maato 26:69-75</ref>; <ref loc="LUK 22:56-62">Luqa 22:56-62</ref>; <ref loc="JHN 18:15-18">Yoha 18:15-18</ref>, <ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>Phexroosi kahine halaqaa zabban garsa baggara de7ishin, kahine halaqa gadhindotape issiniya ya yasu. <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>Phexroosi tama kayeysa demmada, tishshi ootha xeellada, “Neka Naazirete Yesuusara de7aasa” yaagasu.<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>Shin Phexroosi, “Ne geysi aybeko ta erike, taw akeeketena” yaagidi kaddis. Yaagi simmidi, zago keyiya wode iiraka kuttoy waassis.<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>He gadhindiya Phexroosa be7ada, iya matan eqida asatako, “Ha urayka entara de7ees” gada zaara odasu. <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>Shin Phexroosi qassika kaddis.</para>
  <para style="p" vid="MRK 14:70">Guuthu gam7ishin, matan eqida asati nam7antho Phexroosako, “Neeni Galila biitta asi gidiya gisho tuma entara de7aasa” yaagidosona.<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>Shin Phexroosi, “Taani hinte giya uraa erike!” yaagidi bana baadethinne caaqo oykis.<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>Ellesidi kuttoy nam7antho waassi aggis. Phexroosi, Yesuusi iyako, “Neeni kuttoy nam7u toho waassanaape sinthe heedzu toho tana kaddana” gidaysa akeekidi daro yeekis.<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s1">Yesuusi Philaxoosa Sinthan</para>
  <para style="r">(<ref loc="MAT 27:1-2">Maato 27:1-2</ref>, <ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luqa 23:1-5</ref>; <ref loc="JHN 18:28-38">Yoha 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>Wonta guura ellesidi kahine halaqati, cimati, higge astamaaretinne Ayhude shangoti ubbay shiiqidi maqetidosona. Enti Yesuusa qachi efidi Philaxoosas aathidi immidosona.<verse eid="MRK 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 15:2"/>Philaxoosi iyako, “Neeni Ayhude kawo?” yaagidi oychis.</para>
  <para style="p" vid="MRK 15:2">Yesuusi zaaridi, “Ne gadasa” yaagis.<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>Kahine halaqati Yesuusa daroban mootidosona. <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>Shin Philaxoosi zaaridi Yesuusako, “New zaariyabay baawee? Enti ne bolla ay mela mootuwa ehiyako be7ikii?” yaagis.<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>Shin Yesuusi haraba zaaronna ixin, Philaxoosi malaaletis.<verse eid="MRK 15:5"/></para>
  <para style="s1">Yesuusi Hayqo Pirdetis</para>
  <para style="r">(<ref loc="MAT 27:15-26">Maato 27:15-26</ref>; <ref loc="LUK 23:13-25">Luqa 23:13-25</ref>; <ref loc="JHN 18:39-40">Yoha 18:39-40</ref>; <ref loc="JHN 19:1-16">19:1-16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>Philaxoosas Paasika Ba7aale bonchiya gallasan asay koya issi asi qashope billiya meezey de7ees. <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>He wode issi Barbaana geetetiya uray ooshshu kessidi shempo wodhida asaara issife qasho keethan de7ees. <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>Shiiqida daro asay Philaxoosi kaseysada oothana mela iya oychidosona. <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>Philaxoosi asa zaaridi, “Taani hintew Ayhudeta kawa billanaysa koyeetii?” yaagidi oychis. <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Hessa I giday, kahine halaqati Yesuusa qanaatidi aathidi immidaysa eriya gishosa.<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>Shin kahine halaqati Yesuusa gisho Barbaana billanaada, he shiiqida asay Philaxoosa woossana mela asaa maqidosona. <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>Philaxoosi zaaridi, “Yaatin, ha hinte Ayhude kawo geysa waato?” yaagis.<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>Asay Philaxoosa bolla waassidi, “Masqale bolla iya kaqa” yaagidosona.<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>Philaxoosi, “Ayis? I ay iitaba oothidee?” yaagis.</para>
  <para style="p" vid="MRK 15:14">Shin asay kaseysafe guji waassidi, “Masqale bolla iya kaqa” yaagidosona.<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>Philaxoosi asaa ufaysanaw koyidi, Barbaana billis. Yaatidi, lisson Yesuusa garaafisidi, masqaliya bolla kaqana mela entaw aathidi immis.<verse eid="MRK 15:15"/></para>
  <para style="s1">Yesuusi Tooshetis</para>
  <para style="r">(<ref loc="MAT 27:27-31">Maato 27:27-31</ref>; <ref loc="JHN 19:2-3">Yoha 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>Hessafe guye, wotaadareti Yesuusa deriya haareysa ooso keethi efidi, hara wotaadareta ubbaa issife xeegidosona. <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>Qassi zo7o afila iya mayzidosona; aguntha kallacha giigisidi, iya huuphen wothidosona. <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>Hessafe guye, iyako, “Ayhudeta kawaw merinaw kawota” yaagidi, iyaw ziggidosona. <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>Iya huuphiya xam7an shocidosona; qassi iya bolla cuttidosona; gulbatidi iyaw goyinnidosona. <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>Iya toochidaape guye zo7o afila iyape qaari ekidi, iya afila iya mayzidi masqale bolla iya kaqanaw efidosona.<verse eid="MRK 15:20"/></para>
  <para style="s1">Yesuusi Kaqetis</para>
  <para style="r">(<ref loc="MAT 27:32-44">Maato 27:32-44</ref>; <ref loc="LUK 23:26-43">Luqa 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoha 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>Enti bishe, Iskindirenne Rufoosa aawa, Simoona geetetiya Qereena biitta asi, gaxarepe katama yeysara gahetidi, Yesuusa masqaliya wolqan toossidosona.<note caller="-" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">Roome 16:13</ref>.</char></note> <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>Yaatidi Golgota geetetiya bessaa Yesuusa efidosona. “Golgota” guussay “Huuphe guugge” guussu. <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Sakoy si7etonna mela karbera walaketida woyne uyo gidi iyaw immidosona; shin I uyonna ixis. <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/>Enti masqale bolla iya kaqidosona. Oona aybi gakaneeko gidi iya afila shaakidi saama yeggidosona.<verse eid="MRK 15:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 15:25"/>Enti masqale bolla iya kaqiya wode wontafe heedzu saate. <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>Enti, “Ayhude kawa” yaagidi iya mootiya xuufe xaafidi wothidosona. <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>Yesuusara nam7u pangata issuwa iyape ushacha baggara hankuwa iyape haddirsa baggara masqale bolla kaqidosona. <verse eid="MRK 15:27"/><verse number="28" style="v" sid="MRK 15:28"/>Geeshsha Maxaafay, “Iitabaa oothida asatara I paydetis” geetetidaysi poletis.<note caller="-" style="x"><char style="xo" closed="false">15:28 </char><char style="xt" closed="false"><ref loc="ISA 53:12">Isa 53:12</ref>.</char></note><verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>Ogera aadhiya asay Yesuusa kadhidi, banta huuphiya qaathidi cayidosona. “Heko! Xoossa Keetha laallada heedzu gallasa giddon keexana geyso,<note caller="-" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 22:7">Maz 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>; <ref loc="MRK 14:58">Mar 14:58</ref>; <ref loc="JHN 2:19">Yoha 2:19</ref>.</char></note> <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>ane masqaliya bollafe wodha; ne huuphiya ashsha” yaagidosona.<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>Hessadaka, kahine halaqati higge asatamaaretara issife Yesuusa toochidi, “Harata ashshis, shin bana ashshanaw danda7enna; <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>nuuni be7idi ammanana mela Kiristoosi, Isra7eele Kawoy, ane masqale bollafe ha77i wodho” yaagidosona. Qassi hari attoshin, iyara masqale bolla kaqetidaysatika iya toochidosona.<verse eid="MRK 15:32"/></para>
  <para style="s1">Yesuusa Hayquwa</para>
  <para style="r">(<ref loc="MAT 27:45-56">Maato 27:45-56</ref>; <ref loc="LUK 23:44-49">Luqa 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoha 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>Usupun saatepe doomidi, uddufun saate gakanaw biitta ubbay dhumis. <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/>Uddufun saaten Yesuusi, “Elohe, Elohe, lama sabaqtanii?” yaagidi waassis. Hessa guussay, “Ta Xoossaw, ta Xoossaw, tana ayis aggadii?” guussu.<note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Maz 22:1</ref>.</char></note><verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>Hessan eqida asape issoy issoy hessa si7idi, “Heko, Eeliyaasa xeegees” yaagis. <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/>He asape issoy woxidi, isponjen caala woyne kunthis; hessa xam7a xeeran wothidi, “Naagite; Eeliyaasi masqale bollafe iya wodhisanaw yaaneko ane be7oos” yaagidi, Yesuusa doonako ushshanaw shiishis.<note caller="-" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Maz 69:21</ref>.</char></note><verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>Hessafe guye, Yesuusi waassis; hayqis.<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>Xoossa keethan kaqetida magaraajoy qommofe duge gakanaw, nam7u keyidi daaketi wodhis.<note caller="-" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="EXO 26:31">Kessa 26:31</ref>.</char></note> <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>Masqaliyape sintha baggara yan eqida issi mato halaqay, Yesuusi waanidi hayqidaako be7ida wode, “Ha uray tuma Xoossa Na7a” yaagis.<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>Hessa haahon eqidi be7iya guutha maccasati de7oosona. Enta giddon Magdela Mayraama, kaaluwa Yayqoobanne Yoosa aayiya Mayraamanne Salooma de7oosona. <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>He maccasati Yesuusi Galilan de7iya wode iya kaallidaysatanne iya mokidaysata qassi Yesuusara issife Yerusalaame bida hara daro maccasati yan de7oosona.<note caller="-" style="x"><char style="xo" closed="false">15:41 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">Luqa 8:2-3</ref>.</char></note><verse eid="MRK 15:41"/></para>
  <para style="s1">Yesuusi Moogetis</para>
  <para style="r">(<ref loc="MAT 27:57-61">Maato 27:57-61</ref>; <ref loc="LUK 23:50-56">Luqa 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoha 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v" sid="MRK 15:42-43"/>Sa7i omarsida wode, shiiqida asan bonchetida Ayhude shangotape issoy, Yoosefa geetetiya uray, Xoossa kawotethay yaanaysa naagishe de7eysi, Armaate katama asi de7eysi yis. Wontethe Sambaatas giigetiya gallas gidida gisho, Yoosefi minnidi Philaxoosako bidi, Yesuusa aha ekanaw woossis. <verse eid="MRK 15:42-43"/><verse number="44" style="v" sid="MRK 15:44"/>Philaxoosi, Yesuusi hayqidaysa si7ida wode malaaletis; mato halaqa xeegidi, “I hayqidi gam7idee?” yaagidi oychis. <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>Philaxoosi, Yesuusi hayqidaysa mato halaqaape si7idi, iya aha Yoosefas immis. <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>Yoosefi moogo afila shammis; Yesuusa aha masqaliyape wothidi, afilan xaaxidi, shuchafe woocetida duufon iya aha moogis. Qassi he duufuwa doonan gita shuchu gondorsidi wothis. <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>Magdela Mayraamanne Yoosa aayiya Mayraama Yesuusa aha enti awun moogidako be7oosona.<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s1">Yesuusa Hayqope Denduwa</para>
  <para style="r">(<ref loc="MAT 28:1-8">Maato 28:1-8</ref>; <ref loc="LUK 24:1-12">Luqa 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoha 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>Sambaati aadhidaape guye, Magdela Mayraama, Yayqooba aayiya Mayraamanne Salooma bidi, Yesuusa aha tiyanaw shitto shammidosona. <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>Wogga wode wonta daro guura xalqey caarishin, duufo bidosona. <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>Enti banta giddon issoy issuwara, “Duufuwa doonape nuus shuchaa oonee gondorsidi digganay?” yaagidi odetidosona.<verse eid="MRK 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 16:4"/>Enti xeelliya wode he daro gita shuchay gondoretidi kichidaysa be7idosona. <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>Yesuusi moogetida duufuwa giddo geliya wode issi pantha addey bootha ma7o ma7idi, ushacha baggara uttidaysa be7idi dagammidosona.<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>Shin I entako, “Dagammofite; masqaliya bolla kaqetida, Naazirete Yesuusa hinte koyeysa taani erayis. I haysan deenna, hayqope dendis. Enti iya moogida bessa haysa be7ite. <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/>Ha77i bidi Yesuusa tamaaretasinne Phexroosas, ‘Yesuusi hintefe sinthatidi Galila bees. I, hintew odidaysada hinte iya yan be7ana’ yaagidi odite” yaagis.<note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Maato 26:32</ref>; <ref loc="MRK 14:28">Mar 14:28</ref>.</char></note><verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>Maccasati yashshan kokorishe duufope keyidi baqatidosona. Qassi enti yayyida gisho, hessa oodeska aykoka odibookona.<note caller="+" style="f"><char style="fr" closed="false">16:8: </char><char style="ft" closed="false">Issi issi beni maxaafati Marqoosa Wongela paydo 8 bolla essoosona. Qassi issi issi maxaafati paydo 9-20 gakanaw de7iya qofaa gujokona. Gidoshin, paydo 8 kaallidi de7iya gujoosona. Hessika [Maccasati bidi, kiitanchoy odidaba ubbaa Phexroosasinne iyara de7eysatas qanthan odidosona. Hessafe guye, Yesuusi ba tamaareta geeshshinne merinaa atotetha Wongela kiitaa dolohape wuloha gakanaw kiittis.] </char></note><verse eid="MRK 16:8"/></para>
  <para style="s1">Yesuusi Magdela Mayraamis Qoncis</para>
  <para style="r">(<ref loc="MAT 28:9-10">Maato 28:9-10</ref>; <ref loc="JHN 20:11-18">Yoha 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9"/>Yesuusi hayqope dendidaape guye, wogga gallas wonta, laapun tuna ayyaanata kessida Magdela Mayraamis koyrottidi bentis. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>Iya bada kase iyara de7eysatas, enti azzanishenne yeekishe de7ishin odasu. <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>Shin Yesuusi paxa de7eysanne iw bentidaysa enti si7ida wode iya geysa ammanibookona.<verse eid="MRK 16:11"/></para>
  <para style="s1">Yesuusi Nam7u Tamaaretas Qoncis</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luqa 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>Hessafe guye, entafe nam7ati katamaape keyidi bishin, oge bolla Yesuusi kasepe dummatidi entaw bentis. <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>Enti guye simmidi, haratas odidosona, shin haratika enta odaa tuma gibookona.<verse eid="MRK 16:13"/></para>
  <para style="s1">Yesuusi Tammanne Issi Tamaaretas Qoncis</para>
  <para style="r">(<ref loc="MAT 28:16-20">Maato 28:16-20</ref>; <ref loc="LUK 24:36-49">Luqa 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoha 20:19-23</ref>; <ref loc="ACT 1:6-8">Hawa 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>Guyepe tammanne issi iya tamaareti kathi mishin, Yesuusi entaw bentis. Entaw ammanoy bayna gishonne hayqope I dendidaysa be7ida asay odin, enti ammanonna ixida gisho I enta boris.<verse eid="MRK 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 16:15"/>I entako, “Biitta ubbaa bidi asa ubbaas wongela odite.<note caller="-" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">Hawa 1:8</ref>.</char></note> <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/>Ammaneynne xammaqetey attana, shin ammanonay pirdetana. <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/>Ammaneysatas ha malaatati imetana. Enti ta sunthan tuna ayyaanata kessana, ooratha doonan odetana. <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/>Enti shooshu oykikoka woyko wodhiyaba uyikoka enta qohenna. Qassi enti banta kushiya harganchota bolla wothidi enta pathana” yaagis.<verse eid="MRK 16:18"/></para>
  <para style="s1">Yesuusi Pude Salo bis</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luqa 24:50-53</ref>; <ref loc="ACT 1:9-11">Hawa 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>Goday Yesuusi tamaaretara odetidaape guye, pude salo keyis; Xoossafe ushacha baggara uttis.<note caller="-" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 1:9">Hawa 1:9</ref>.</char></note> <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>Iya tamaareti bida bessa ubban qaala odidosona. Godayka entara issife oothees. Enti odiya qaalay tuma gididaysa Xoossay entaw immiya malaatatan erisis.<verse eid="MRK 16:20"/></para>
  <chapter eid="MRK 16"/>
</usx>
