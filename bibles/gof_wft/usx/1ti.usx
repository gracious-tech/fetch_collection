<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">1 Ximotiyoosa Kiita</para>
  <para style="toc1">1 Ximotiyoosa Kiita</para>
  <para style="toc3">1 Ximo</para>
  <para style="toc2">1 Ximotiyoosa</para>
  <para style="mt1">Phawuloosi Ximotiyoosas</para>
  <para style="mt2">Xaafida Koyro Kiita</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Ximotiyoosa geetetiya, ammaniya na7atethay, Guutha Iisen yeletis (<char style="xt"><ref loc="ACT 16:1-3">Hawa 16:1-3</ref></char>). Iya aayiya Ayhude; iya aaway qassi Girike asi. I Phawuloosara issife oothees; qassi wongela ooson Phawuloosa matan maaddiya asi. Phawuloosi, Ximotiyoosas xaafida koyro kiitay, heedzu ayfe odata minthidi xeellees.</para>
  <para style="ipi">Ha kiita koyro qofay, woosa keethan dendida wordo timirtiyaba minthidi odees. Ha imatha timirtey Ayhude timirtiyafe bagga, qassi Ayhude gidonna asa timirtiyafe bagga ekees. Hessika, “Ha bentiya alamey nagaran iitida gisho, asi atotethi demmanaw dumma gidida xuura eranaw, issi issi kathata moonna agganawnne macho ekona woyko azina gelonna daanaw koshshees” giya qofaa baaso oothidi dendis.</para>
  <para style="ipi">Nam7antho qofay, woosa keetha aysobanne goyinno wogaaba tamaarsiya timirte, hessadaka woosa keethi kaaletheysatinne enta maaddeysati ay mela maara duussu daanaw bessiyako odees.</para>
  <para style="ipi">Heedzantho qofay, Ximotiyoosi Yesuus Kiristoosas oothiya lo77o asi waanidi gidanaw bessiyako, qassi ammaniya asaa matan iyaw de7iya aawatethay aybeko, Phawuloosi iya zorida zoriya bessees.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Gelo qofa <char style="ior">(<ref loc="1TI 1:1-2">1:1-2</ref>)</char></para>
  <para style="io1">Woosa keethi aysiya asaa <char style="ior">(<ref loc="1TI 1:3-3:13">1:3—3:13</ref>)</char></para>
  <para style="io1">Nu ammanuwa xuura <char style="ior">(<ref loc="1TI 3:14-4:5">3:14—4:5</ref>)</char></para>
  <para style="io1">Ximotiyoosas imetida zore <char style="ior">(<ref loc="1TI 4:6-6:21">4:6—6:21</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Nuna ashshiya Xoossaaninne nu ufaysan naagiya Yesuus Kiristoosan kiitetida, Yesuus Kiristoosa hawaare gidida, Phawuloosape, <verse eid="1TI 1:1" /><verse number="2" style="v" sid="1TI 1:2" />ammanon taw tuma na7a gidida Ximotiyoosas.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">Hawa 16:1</ref>.</char></note></para>
  <para style="p" vid="1TI 1:2">Xoossaa nu Aawa, nu Godaa Kiristoosa aadho keehatethay, maarotethaynne sarotethay new gido.<verse eid="1TI 1:2" /></para>
  <para style="s1">Wordo Timirtefe Naagetethi</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Taani Maqedoone bashe nena hadaridaysada, issi issi asati wordo timirtiya tamaarseysa digganaw ne Efesoonan gam7ana mela koyayis. <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />Enti go77i bayna hayse odanne banta kocha taybuwa agganaada oda. Hessa melabay palama kaaletheesipe attishin, ammanon oosetiya Xoossaa oosuwas maaddenna. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />Ha kiitaa huuphe qofay geeshsha wozanape, lo77o kahapenne tuma ammanuwape bentiya siiquwa denthethanaasa. <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />Issi issi asati haysa aggidi, pathonna odako simmidosona. <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />Enti Xoossaa higgiya astamaare gidanaw koyoosona. Shin enti ay odiyako woyko tuma oothidi odeysi I aybeko erokona.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Asi besseysada higgiyan go7etiko higgey lo77o gideysa eroos. <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />Issiba akeekanaw koshshees. Higgey lo77o asaas medhetibeenna. Shin higgey, higge mentheyisata, worandzota, Xoosse yayyonnayisata, shempo wodheyisata, nagaranchota, geeshshatethi baynayisata, tunata, hari attoshin banta aayiw woyko aawa wodheyisata, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />laammeyisata, addey addera laymateyisata, ase bayzeyisata, wordanchota, wordon caaqeyisata, woyko tuma timirtiyara gahetonna ay ooso ootheyisata seeranaw keyis. <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />He timirtey bonchonne anjetida Xoossay taani awaajana mela taw hadara immida Wongela giddon de7ees.<verse eid="1TI 1:11" /></para>
  <para style="s1">Xoossa Maarotethas Galata</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Taani oothiya oosuwan taw wolqaa immida nu Godaa Kiristoos Yesuusa galatayis. Tana ba oosuwas shuumidi he oosuwas besseysa gidi taybida gisho iya galatayis. <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />Taani haysafe kase iya cayeysa, iya yedetheysanne metootheysa gidikoka taani hessa eronnanne ammanonna oothida gisho Xoossay tana maaris.<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Hawa 8:3</ref>; <ref loc="ACT 9:4-5">9:4-5</ref>.</char></note> <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />Nu Goday ba aadho keehatetha ta bolla gussidi, he aadho keehatethaara ammanonne siiqo Kiristoos Yesuusa baggara taw immis.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />“Kiristoos Yesuusi nagaranchota ashshanaw ha alamiya yis” giya qaalay ammantheysanne asa ubbay ekanaw besseysa. Ubbaafe aadhida nagaranchoy tana. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />Shin merinaa de7uwa ekanaw iya ammaniya asaas taani leemiso gidana mela Yesuus Kiristoosi daro danda7is. Taw ubbaafe aadhida nagaranchuwas Xoossay ba maarota darsis. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />Ayfen bentonnaysas, issi Xoossaas, hayqonaysas, merinaa Kawas, merinaape merinaa gakanaw galataynne bonchoy gido. Amin7i.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />Ximotiyoosa, ta na7aw, kase nebaa nabeti odida qaala bolla eqada ha kiitaa hadara new immayis. Ne he qaala kaalliko lo77o olaa oletana. <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />Ammanoynne lo77o kahi new de7o. Issoti issoti kaha dhayidi markabey hobben dhayeysada banta ammanuwa dhaysidosona. <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />Hessa hanidaysata giddon Hemeneyoosinne Iskindirey de7oosona. Enti tamaaridi Xoossaa cayeysa aggana mela taani Xalahes entana aatha immas.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s1">Ubbaas Woossite</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Ubbaafe sinthatada, asa ubbaas Xoossaa oychanaw, woossanaw, gaannatanawunne galatanaw besseysa taani nena akeekisayis. <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />Nuuni tuma ayyaana de7oninne geeshshatethan Xoossaa goyinnishe sarotethaninne wopu gida de7on daana mela kawotasinne shuumata ubbaas woossite. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Hessa mela woosay nuna ashshiya Xoossaa sinthan lo77onne ufaysiyabaa. <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />Xoossay asi ubbay attanaadanne tumaa eranaada koyees. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Issi Xoossi de7ees. Xoossafenne asape giddon gididi sigethiya issoy de7ees; ika ase gidida Kiristoos Yesuusa. <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />I asa ubbaa wozanaw bana aathidi immis. Xoossay ba wodiyan asa ubbaa wozanaw koyeysa bessiya markay haysa. <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />Xoossay tana Wongelas astamaarenne hawaare oothidi dooriday hessasa. Taani tuma odayis; wordotike; ammanoninne tuman Ayhude gidonna asaas markatana mela Xoossay tana shuumis.<note caller="-" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="2TI 1:11">2 Ximo 1:11</ref>.</char></note><verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Hessa gisho, ubba bessan de7iya addeti, bantana Xoossaas dummayidi, hanqonne palama diggidi, banta kushiya pude denthidi Xoossaa woossana mela koyayis.<verse eid="1TI 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 2:9" />Hessada maccasay bantana haaridaysa qoncisiya, bonchoynne maari de7iya ma7uwa ma7anaw bessees. Enti maari bayna huuphe dathan, worqan woyko inqon, woyko al7o afilan bantana alleeqisopo.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="1PE 3:3">1 Phex 3:3</ref>.</char></note> <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />Shin Xoossaas goyinnayis giya maccasay bantaw besseysada lo77oba oothonna.<verse eid="1TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 2:11" />Maccasi kiitetethan si77i gidi tamaaro. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Taani maccasay tamaarsana mela woyko adde bolla aawatana mela gidonashin, si77i gidi daana mela koyayis. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Addaamey koyro medhetis; guyepe Hewaanna medhetasu.<note caller="-" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="GEN 2:7">Medhe 2:7</ref>, <ref loc="GEN 2:21-22">21-22</ref>.</char></note> <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />Qassi cimetada Xoossaa higgiya menthiday maccasipe attishin, Addaame gidenna.<note caller="-" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="GEN 3:1-6">Medhe 3:1-6</ref>.</char></note> <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />Shin maccasi ammanon, siiqoninne geeshshatethan bantana haaridi de7iko<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fqa" closed="false">Bantana haaridi de7iko: </char><char style="ft" closed="false">Woyko iya yelida nayti ammanon, siiqoninne geeshshatethan bantana haaridi de7iko.</char></note> nayta yelon attana.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s1">Woosa Keetha Cimata</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Oonika, “Woosa keethi kaalethiya asi gidanaw koyko lo77oba amottees” giya oday tuma. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Woosa keethaa kaalethiya asi boretonaysa, issi mache xalaali de7eysa, maaran de7eysa, bana haareysa, besseysada ootheysa, imathe mokeysa, tamaarsanaw danda7eysa,<note caller="-" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="TIT 1:6-9">Tito 1:6-9</ref>.</char></note> <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />mathotonaysa, ooyetonnaysa, palamonnaysa, miishe siiqonnaysa, <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />iya nayti iyaw kiiteteysanne boncheysa, ba keethaa aysanaw danda7eysa gidanaw bessees. <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />Issi asi ba keethaa aysanaw danda7onna ixiko, Xoossaa woosa keethi waati aysanaw danda7ii?<verse eid="1TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 3:6" />Otoron sugetidi, Xalahey Xoossaa pirdan kundidaysada kundonna mela, oorathi ammanida asi gidanaw bessenna. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Boreninne Xalahe xihen gelonna mela he uray ammanonna asa matan nasheteysa gidanaw bessees.<verse eid="1TI 3:7" /></para>
  <para style="s1">Woosa Keetha Daaqoneta</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Hessada qassi woosa keethaa daaqoneti bonchetidaysata, nam7u doona odetonayisata, daro woyne ushshu uyonayisata, miishe yaaretonayisata, <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />ammanuwa xuuraa geeshsha kahan naageysata gidanaw bessees. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Enti koyrottidi paacetanaw koshshees; enta bolla borey bayna ixiko, woosa keethaa daaqone gididi ootho.<verse eid="1TI 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 3:11" />Hessadaka, enta maccasati bonchetidaysata, zigironnayisata, maaran de7eyisata, ubbaban ammaneteyisata gidanaw bessees.<verse eid="1TI 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 3:12" />Woosa keethaa daaqoneti issi machi xalaali de7eysa gido. Ba naytanne ba keethaa loythi ayseysa gidanaw bessees. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />Woosa keethaa daaqone gididi, lo77o ooso ootheysati, entaw gita boncho qassi Kiristoos Yesuusan bantaw de7iya ammanuwaba odanaw daro minotethi demmana.<verse eid="1TI 3:13" /></para>
  <para style="s1">Ammano Gita Xuura</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Taani ha kiitaa new xaafashe, ellesada neeko baana gada ufaysi wothayis. <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />Shin taani boonna gam7iko, Xoossaa Keethan asay waanidi daanaw bessiyako erana mela haysa new xaafayis. De7o Xoossaa keethay tumatethaas tuussinne baaso. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Nu ammanuwa xuuray sidhey bayna gita.</para>
  <para style="q1" vid="1TI 3:16">Kiristoosi asho ma7idi qoncis;</para>
  <para style="q2" vid="1TI 3:16">Iya tumatethaa Geeshsha Ayyaanay markatis.</para>
  <para style="q1" vid="1TI 3:16">Kiitanchotas bentis;</para>
  <para style="q2" vid="1TI 3:16">I kawotetha ubbaas sabbaketis.</para>
  <para style="q1" vid="1TI 3:16">Alamen de7iya asan ammanetis;</para>
  <para style="q2" vid="1TI 3:16">bonchon salo eketis.<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s1">Wordo Astamaareta</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />Yaana wodiyan balethiya ayyaanatanne tuna ayyaanata timirte kaallidi, issi issi asay ammanuwa kaddanaysa Geeshsha Ayyaanay qoncisidi odis. <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />Hessa mela timirtey enta kahay doccin, asaa balethiya wordancho astamaaretape yees.<verse eid="1TI 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 4:3" />Hessa mela asati ekonne gelo qassi issi issi kathata moonna mela diggoosona. Shin ammaneysatinne tumaa ereysati Xoossaa galati woossidi maana mela Xoossay kathi medhis. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Xoossay medhida ubbabay lo77o. Xoossaa galatidi miiko wora wodhiyabay aybika baawa. <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />Ubbabay Xoossaa qaalaninne woosan geeshshi gidees.<verse eid="1TI 4:5" /></para>
  <para style="s1">Kiristoosa Ammanthiya Aylle</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Hessa gisho, neeni ha timirtiya ammaneyisata tamaarsiko, nu ammanuwaninne lo77o timirtiya kiitetada diccida, Kiristoos Yesuusa lo77o aylle gidana. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Shin go77i bayna tuma gidonna odapenne cima maccasa haysepe baqata. Tuma ayyaana de7on daanaw nena loohisa. <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />Asi ba asatethaa minthanaw oothiya oosoy guuthas maaddees. Shin tuma ayyaana de7on bana loohisoy ha77iska merinawuka de7o immiya ufaysi de7iya gisho, ubbaas maaddees. <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Ha qaalay asa ubbay ekanaw bessiya tuma oda. <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />Nuuni asa ubbaa, ubbaafe aathidi ammaneyisata ashshiya de7o Xoossaafe ekana gidi ufaysan naagiya gisho, hessas nuuni ooson daaburosinne baaxetoos.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />Haysa kiittanne tamaarsa. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />Neeni yalaga gidiya gisho, nena oonika kadhopo. Shin ammaneysatas neeni odan, ooson, siiqon, ammanoninne geeshshatethan leemiso gida. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Taani yaana gakanaw asaas Geeshsha maxaafaa nabbabon, sabbakoninne tamaarson minna. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Tinbitey odetin, cimati banta kushiya ne bolla wothida wode neeni ekida, nenan de7iya Geeshsha Ayyaana imota kadhopa.<verse eid="1TI 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 4:15" />Ne dichay asa ubbaas qoncana mela hessa mintha qopa; haysa ubba wode ootha. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Ne huuphiyasinne ne timirtiyas naageta. Neeni hessa ubba wode oothiko nenanne nena si7eyisata ashshaasa.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s1">Am7etaba Imetida Zore</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Cima addeta ne aawada bonchafe attishin, hanqetofa. Yalaga addeta ne ishada oothada xeella. <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />Cima maccasata ne aayida, yalaga maccasata ne michida, polo geeshshatethan oyka.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />Azini hayqida tuma am7eta boncha. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Shin am7ees nayti woyko nayta nayti de7iko, he nayti tuma ayyaana de7on de7eysa bessanaw bantana yelidaysatanne, banta wogga aayiwunne wogga aawa maaddidi kushe zaaro tamaaro. Hessi Xoossaa ufaysiyabaa.<verse eid="1TI 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1TI 5:5" />Barka de7iya tuma am7iya Xoossafe maade demmanaw ufaysan naagasu. Gallasinne qamma Xoossay bana maaddana mela woossawusunne oychawusu. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Shin ha alamiyan lo77o duussaa xalaala koyiya am7iya paxa de7ashe hayqidaaro. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Oonika enta boronna mela ha kiitaa entaw imma. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Shin ba dabbotas, ubbaafe aathidi ba soo asaas qoponna oonika ba ammanuwa kaddidaysa; ammanonna asapeka aadhida iita.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />Laythi usupun tammu kumiboona am7e sunthaa mazgaben xaafopa. Qassi hessa bolla iya ba azinaas ammanetidaro gidanaw koshshees. <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />Nayta dishon, imatha mokon, geeshshata tohuwa meechan, metootiya asaa maaden, lo77o ooso ubbaas bana aatha immidaaronne lo77o ooson eretidaaro gidanaw bessees.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />Shin yalaga am7eta sunthaa mazgaben xaafopa. Entana azina gelo gelo giya asho amoy oykiya wode Kiristoosa aggana. <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />Enti koyro gelida qaala menthida gisho pirdetana. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Hessa bolla enti ooso dhayidi keethafe keethe yuuyana. Yuushsha xalaala gidonashin, zigirsaninne bantana gathonnaban gelidi bessonnaba odetoosona. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Hessa gisho, nu morketi nu bolla odetiya iitabaa demmonna mela yalaga am7eti azina gelidi, na7a yelidi, banta keethaa aysana mela zorayis. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Haysafe kase guutha am7eti Xalahe kaallanaw guye simmidosona.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />Issi ammaniya maccasees soo asaa giddon am7eti de7iko, iya enta maaddanaw bessees. Hessada oothiko, woosa keethaas toohoy kawuyees. He wode woosa keethay maade bessiya tuma am7eta maaddanaw danda7ees.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />Woosa keethi loythi heemmiya cimati, ubbaafe aathidi, qaala sabbakoninne tamaarson daabureysati dako boncho ekanaw bessees. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />Geeshsha Maxaafay, “Wudumman kathaa yedhiya boora doona qachofa” hessadaka, “Oosanchoy ba damooziya ekanaw bessees”<note caller="-" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="DEU 25:4">Zaare 25:4</ref>; <ref loc="MAT 10:10">Maato 10:10</ref>; <ref loc="LUK 10:7">Luqa 10:7</ref>.</char></note> yaagees.<verse eid="1TI 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TI 5:19" />Nam7u woyko heedzu marki bayna, woosa keetha cima mootiyaba si7opa.<note caller="-" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="DEU 17:6">Zaare 17:6</ref>; <ref loc="DEU 19:15">19:15</ref>.</char></note> <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Harati yayyana mela nagara oothiya oonaka asa ubbaa sinthan hanqeta.<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />Neeni asa som7o be7onna, issuwa issuwafe dummayonna ha kiitaa naagana mela Xoossaa, Godaa Yesuus Kiristoosanne dooretida kiitanchota sinthan ta nena zorayis. <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />Oodde bollaka ne kushiya wothada shuumanaw ellesopa. Harata nagaran gelopa; nena geeshshatethan naaga.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />Neeni ubba wode hargetiya gishonne ne ulo hargiya gisho haatha xalaala uyopa; guutha woyne uya.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />Issi issi asata nagaray qonce; enta nagaray enta pirdanaw entafe sinthe aadhees, shin harata nagaray guyepe gam7idi qoncees. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Hessada, lo77o oosoyka qonce; qonconna ixikoka geemmanaw danda7enna.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="s1">Aylletas Imetida Zore</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Xoossaa sunthaynne nu timirtey cayetonna mela aylletethan de7eysati bantana haariya godata boncho. <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />Ammaniya godati de7iya aylleti, enta godati entaw isha gidiya gisho enta kadhopo. Enta oosuwan maadetiya godati, ammaneysatanne dosetidaysata gidiya gisho enti kasepe aathidi oothanaw bessees. Neeni haysa tamaarsanawunne enti oothana mela zoranaw bessees.<verse eid="1TI 6:2" /></para>
  <para style="s1">Tuma Duretethi</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />Oonika dumma timirte tamaarsiyaba gidiko, nu Godaa Yesuus Kiristoosa tuma qaalaranne nu ammano timirtiyara gahetenna. <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />He uray otoron sugeteesipe attishin, aykoka erenna. Entaw issi qofa bolla palamanawunne ooyetanaw iita amoy de7ees. Hessi qanaate, ooshshi, cashshe, iita sidhenne, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />giigonna palama kaalethees. Qassi entaw iita wozani de7ees; tumaa balidosona; enti Xoossaa ammanoy duretethas oge gidi qopoosona.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />Shin taw de7iyabay gidana giya asas tuma ayyaana de7oy gita wodhe. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />Nuuni ha alamiya aykoka ehibooko; qassi iyape aykoka ekidi booko. <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Nuus kathinne ma7oy de7iko hessi gidana. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Shin duretethi koyeysati paaceninne xihen geloosona. Qassi entana duge dafiyanne dhaysiya eeyatethinne qohiya amon kundoosona. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Miishe siiqoy iitatetha ubbaas pulto. Issoti issoti miishe amotishe ammanope baletidi daro meton bantana yeggidosona.<verse eid="1TI 6:10" /></para>
  <para style="s1">Zorenne Kiita</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Shin neno, Xoossa aso, hessafe baqata. Xillotethaa, Xoossaa daano, ammano, siiqo, danda7anne ashketethi kaalla. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Ammano baaxiya loytha baaxeta. Daro asaa sinthan ne markatida ne ammanuwaba, Xoossay nena iyaw xeegida merinaa de7uwa oyka. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" />Ubbaas de7o immiya Xoossaa sinthaninne, Phenxe Philaxoosa sinthan lo77o marka markatida Kiristoos Yesuusa sinthan ta nena kiittayis.<note caller="-" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JHN 18:37">Yoha 18:37</ref>.</char></note> <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />Nu Godaa Yesuus Kiristoosi qoncana gakanaw ha kiitaa balinne borey bayna naaga. <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />Ba xalaala ubbaa haariya boncho Xoossay, kawota kawoy, godata Goday, ba qopida qamman Yesuus Kiristoosa zaari kiittana. <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />Issi iya xalaali hayqenna. Oonika shiiqanaw danda7onna poo7on de7ees. Oonika iya be7ibeenna; qassi be7anawuka danda7enna. Bonchoynne merinaa wolqay iyaw gido. Amin7i.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />Ha alamiya dureti coo dhayiya shalon otortonna melanne ceeqonna mela oda. Nuus koshshiyaba palahisidi immiya nuna anjiya, dure Xoossan ammanetana mela enta kiitta. <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />Enti lo77o ooso oothanaada lo77o ooson duretanaada, keehatanne haratas shaakeyisata gidana mela kiitta. <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />Hessi entaw sinthas mino baaso gidiya gisho, he wode enti tuma de7oy ay daaniyako erana.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Ximotiyoosa, issi issi asay, “Eratethi” giya eeya palamapenne hada odape baqata; new imetida hadara naaga. <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />Issoti issoti nuus eratethi de7ees yaagishe ammanuwa aggidosona.</para>
  <para style="p" vid="1TI 6:21">Xoossaa aadho keehatethay hinte ubbaara gido.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>