<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Ermiyaasa Milalsa</para>
  <para style="toc1">Ermiyaasa Milalsa</para>
  <para style="toc3">Mila</para>
  <para style="toc2">Milalsa</para>
  <para style="mt1">Ermiyaasa Milalsa</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Ermiyaasa Milalsay, K.Y.S. 600 laytha heeran, Yerusalaame laaletethanne asaa di7etetha gaason, ginxon giigida ichashu azzano milalsata oykis. Ha maxaafa daro baggay yeehobaanne zelelsaba odikoka, Xoossan ammanetethabanne ufaysan duussaba odiya kifileti de7oosona.</para>
  <para style="ip">Ha ginxota Ayhude asay banta biitta bolla gakida dhayuwa hassayanaw laythan laythan xooman azzano goyinno wogata poliya gallasatan go7etoosona.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Yerusalaame waayiya <char style="ior">(<ref loc="LAM 1:1-22">1:1-22</ref>)</char></para>
  <para style="io1">Xoossa hanqonne Yerusalaame pirdetethi <char style="ior">(<ref loc="LAM 2:1-22">2:1-22</ref>)</char></para>
  <para style="io1">Xoossa deriyas Ufaysi de7ees <char style="ior">(<ref loc="LAM 3:1-66">3:1-66</ref>)</char></para>
  <para style="io1">Yerusalaamey zine, hachinne wonto <char style="ior">(<ref loc="LAM 4:1-22">4:1-22</ref>)</char></para>
  <para style="io1">Maarota woossa <char style="ior">(<ref loc="LAM 5:1-22">5:1-22</ref>)</char></para>
  <para style="ie"/>
  <chapter number="1" style="c" sid="LAM 1"/>
  <para style="s1">Yerusalaame Waaye</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 1:1"/>Kase asi kumida katamiya</para>
  <para style="q2" vid="LAM 1:1">ha77i waanada asi bayna bessi gidadee?</para>
  <para style="q1" vid="LAM 1:1">Kase kawotethata giddon gita gididaara</para>
  <para style="q2" vid="LAM 1:1">ha77i waanada am7o gidadee?</para>
  <para style="q1" vid="LAM 1:1">Katamata giddon kawo gididaara</para>
  <para style="q2" vid="LAM 1:1">ha77i waanada aylle gidadee?<verse eid="LAM 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 1:2"/>Qamma yibbata yeeho yeekashe aqawusu;</para>
  <para style="q2" vid="LAM 1:2">afuthi I ayfe karera duge wodhees.</para>
  <para style="q1" vid="LAM 1:2">Kase iyo doseysatape</para>
  <para style="q2" vid="LAM 1:2">ha77i iyo minthethiya issoyka baawa.</para>
  <para style="q1" vid="LAM 1:2">I laggeti iyo aathidi immidosona;</para>
  <para style="q2" vid="LAM 1:2">iw morke gididosona.<verse eid="LAM 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 1:3"/>Yihudi naaqetada; aylletada di7etasu;</para>
  <para style="q2" vid="LAM 1:3">ha77i kawotethata giddon de7awusu;</para>
  <para style="q2" vid="LAM 1:3">shin shempo bessi demmabuku.</para>
  <para style="q1" vid="LAM 1:3">Iya metootada de7ishin,</para>
  <para style="q2" vid="LAM 1:3">yedetheysati iyo demmidosona.<verse eid="LAM 1:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 1:4"/>Laytha ba7aale bonchanaw yaa asi bayna gisho,</para>
  <para style="q2" vid="LAM 1:4">Xiyoone ogeti yeekosona.</para>
  <para style="q1" vid="LAM 1:4">I dirsa pengeti baysatidosona;</para>
  <para style="q2" vid="LAM 1:4">I kahineti oolosona.</para>
  <para style="q1" vid="LAM 1:4">Yan de7iya geela7o nayti un7etidosona;</para>
  <para style="q2" vid="LAM 1:4">iyaka un7etada yeekawusu.<verse eid="LAM 1:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 1:5"/>I morketi iw godaa gididosona;</para>
  <para style="q2" vid="LAM 1:5">entaw injetin de7idosona.</para>
  <para style="q1" vid="LAM 1:5">I, nagaraa gaason Goday iyo un7ethis;</para>
  <para style="q2" vid="LAM 1:5">I nayti morketan di7etidi bidosona.<verse eid="LAM 1:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 1:6"/>Xiyooni bonchoy iipe qaaretis;</para>
  <para style="q2" vid="LAM 1:6">I, halaqatika miya bessi dhayida gaarada hanidosona;</para>
  <para style="q1" vid="LAM 1:6">Enti wolqa dhayidi</para>
  <para style="q2" vid="LAM 1:6">bantana yedetheyisata sinthafe baqatidosona.<verse eid="LAM 1:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 1:7"/>Yerusalaamey ba metuwanne ba un7a gallasan,</para>
  <para style="q2" vid="LAM 1:7">beni ba boncho shaluwa hassayawusu.</para>
  <para style="q1" vid="LAM 1:7">I, asay morketa kushen aadhidi imetida wode,</para>
  <para style="q2" vid="LAM 1:7">iyo maaddiya issoyka bentibeenna.</para>
  <para style="q1" vid="LAM 1:7">I morketi iyo xeellidi,</para>
  <para style="q2" vid="LAM 1:7">I dhayuwan miicidosona.<verse eid="LAM 1:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 1:8"/>Yerusalaamey gita nagara oothida gisho tunasu;</para>
  <para style="q2" vid="LAM 1:8">iyo bonchida ubbay I kalluwa be7ida gisho kadhees;</para>
  <para style="q2" vid="LAM 1:8">iya oolashe guye simmasu.<verse eid="LAM 1:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 1:9"/>Tunatethi I afilaa bolla bentis;</para>
  <para style="q2" vid="LAM 1:9">sinthafe ba bolla yaanaba qopabuuku.</para>
  <para style="q1" vid="LAM 1:9">I kundethay daganthiyaba gidis;</para>
  <para style="q2" vid="LAM 1:9">iyo minthethiya oonika baawa.</para>
  <para style="q1" vid="LAM 1:9">Iya, “Abeeti Godaw, ta un7etetha be7a!</para>
  <para style="q2" vid="LAM 1:9">ta morketi tana xoonidosona” yaagasu.<verse eid="LAM 1:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 1:10"/>Morketi I boncho shaluwa bonqidosona;</para>
  <para style="q2" vid="LAM 1:10">kase ne maabara giddo gelonna mela,</para>
  <para style="q2" vid="LAM 1:10">neeni diggida asati, I keethaa gelishin be7asu.<verse eid="LAM 1:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 1:11"/>I asati koshatidi kathi demmanaw oolosona;</para>
  <para style="q2" vid="LAM 1:11">enti de7on daanaw banta shaluwa kathan laammoosona.</para>
  <para style="q1" vid="LAM 1:11">Yerusalaamey haysada yaagasu;</para>
  <para style="q2" vid="LAM 1:11">Abeeti Godaw, tana xeella;</para>
  <para style="q2" vid="LAM 1:11">ta kawushatethaa be7a!<verse eid="LAM 1:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 1:12"/>Hinteno, haysara aadheysato,</para>
  <para style="q2" vid="LAM 1:12">haysi hintew aykoka daanennee?</para>
  <para style="q1" vid="LAM 1:12">Ane be7ite; akeekite;</para>
  <para style="q2" vid="LAM 1:12">ba eexiya hanqo gallasan,</para>
  <para style="q1" vid="LAM 1:12">Xoossay ta bolla ehida</para>
  <para style="q2" vid="LAM 1:12">metuwa mela metoy de7ii?<verse eid="LAM 1:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 1:13"/>Bollafe tama duge yeddis;</para>
  <para style="q2" vid="LAM 1:13">he tamay ta meqethaa giddo gelis.</para>
  <para style="q1" vid="LAM 1:13">Ta tohoy xihen oyketis; tana guye zaaris;</para>
  <para style="q2" vid="LAM 1:13">tana gallas ubbaa labbanthidi yeggi aggis.<verse eid="LAM 1:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 1:14"/>Ta oothida nagara ubbaa shiishi qachidi,</para>
  <para style="q2" vid="LAM 1:14">qambarada ta gannan wothis;</para>
  <para style="q2" vid="LAM 1:14">yaatidi ta wolqaa wursis.</para>
  <para style="q1" vid="LAM 1:14">Ta eqetanaw danda7onna asaas,</para>
  <para style="q2" vid="LAM 1:14">tana aathidi immis.<verse eid="LAM 1:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 1:15"/>Goday ta giddon de7iya</para>
  <para style="q2" vid="LAM 1:15">wolqaama olanchota ubbaa diggis.</para>
  <para style="q1" vid="LAM 1:15">Ta yalagata dhaysanaw wode qachis;</para>
  <para style="q2" vid="LAM 1:15">woyne yedheysada,</para>
  <para style="q2" vid="LAM 1:15">Goday Yihuda geela7ota yedhis.<verse eid="LAM 1:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 1:16"/>Taani yeekashe ta afuthaa gussey hessasa;</para>
  <para style="q2" vid="LAM 1:16">tana minthetheynne katisiya oonika baawa;</para>
  <para style="q2" vid="LAM 1:16">morkey goobin, ta nayti un7etidosona.<verse eid="LAM 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="LAM 1:17"/>Xiyooney ba kushiya miccasu;</para>
  <para style="q2" vid="LAM 1:17">shin iyo minthethiya oonika baawa.</para>
  <para style="q1" vid="LAM 1:17">I yuushuwan de7eysati</para>
  <para style="q2" vid="LAM 1:17">iyo morkanaada Goday oothis.</para>
  <para style="q2" vid="LAM 1:17">Yerusalaamey enta giddon tuna gidasu.<verse eid="LAM 1:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 1:18"/>Iya haysada yaagasu; “Goday xillo;</para>
  <para style="q2" vid="LAM 1:18">iya kiitetonna ixiday tana.</para>
  <para style="q1" vid="LAM 1:18">Hinteno, asato ubbay si7ite; ta metuwaka be7ite;</para>
  <para style="q2" vid="LAM 1:18">ta panthatinne ta geela7oti di7etidosona.<verse eid="LAM 1:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 1:19"/>Ta laggeta xeegas; shin enti tana cimmidosona;</para>
  <para style="q2" vid="LAM 1:19">kahinetinne cimati banta shempuwa ashshanaw,</para>
  <para style="q2" vid="LAM 1:19">kathi koyishe katama giddon hayqidosona.<verse eid="LAM 1:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 1:20"/>Abeeti Godaw, ta waayiya be7a!</para>
  <para style="q2" vid="LAM 1:20">ta garsay dagammis.</para>
  <para style="q1" vid="LAM 1:20">Taani daro makallida gisho, ta wozanay meqis;</para>
  <para style="q2" vid="LAM 1:20">karen mashshi wursees; son hayqoy de7ees.<verse eid="LAM 1:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 1:21"/>Asay ta zelelsa si7idosona;</para>
  <para style="q2" vid="LAM 1:21">shin tana minthethiya issi asika baawa.</para>
  <para style="q1" vid="LAM 1:21">Ta morketi ta metuwa si7idosona;</para>
  <para style="q2" vid="LAM 1:21">ne ta bolla oothidaban ufaytidosona.</para>
  <para style="q1" vid="LAM 1:21">Enti taada hanana mela,</para>
  <para style="q2" vid="LAM 1:21">enta bolla ne awaajida gallasaa eha!<verse eid="LAM 1:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 1:22"/>Enta iitatetha ubbay ne sinthe gako;</para>
  <para style="q2" vid="LAM 1:22">ta nagaraa gisho tana seeridaysada entaka seera;</para>
  <para style="q2" vid="LAM 1:22">ta zelelsay daris; ta wozanayka meqis.”<verse eid="LAM 1:22"/></para>
  <chapter eid="LAM 1"/>
  <chapter number="2" style="c" sid="LAM 2"/>
  <para style="s1">Qadhey Bayna Seera</para>
  <para style="q1">
    <verse number="1" style="v" sid="LAM 2:1"/>Goday ba hanqo shaarape garsan,</para>
  <para style="q2" vid="LAM 2:1">Xiyoone na7iw, waatidi wothide!</para>
  <para style="q1" vid="LAM 2:1">Isra7eele bonchuwa salope sa7a holis;</para>
  <para style="q2" vid="LAM 2:1">ba hanquwa gallas,</para>
  <para style="q2" vid="LAM 2:1">iya tohoy yedhiya bessaa qopibeenna.<verse eid="LAM 2:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 2:2"/>Goday Yihudan keethata ubbaa qadhetonna dhaysis;</para>
  <para style="q2" vid="LAM 2:2">ba hanquwan Yihuda biitta miixaa ubbaa laallis;</para>
  <para style="q2" vid="LAM 2:2">he kawotethaanne halaqata sa7an duge yeggidi kawushis.<verse eid="LAM 2:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 2:3"/>Ba wolqaama hanquwan Isra7eele wolqaa mentherethis;</para>
  <para style="q2" vid="LAM 2:3">morkey iya olanaw yaa wode</para>
  <para style="q2" vid="LAM 2:3">Goday ba ushacha kushiya enta bollafe diggis.</para>
  <para style="q1" vid="LAM 2:3">Ba yuushuwan de7iyaba ubbaa miya tamada,</para>
  <para style="q2" vid="LAM 2:3">Yayqooba bolla tama lacoy eexis.<verse eid="LAM 2:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 2:4"/>Morkeda I ba dongiya enta bolla dafis;</para>
  <para style="q2" vid="LAM 2:4">un7ethiya iya ushacha kushey giigis.</para>
  <para style="q1" vid="LAM 2:4">Ayfees lo77iya asa ubbaa wodhis;</para>
  <para style="q2" vid="LAM 2:4">Xiyoone bolla ba sheniya tamada qolis.<verse eid="LAM 2:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 2:5"/>Goday morkeda hanidi, Isra7eele dhaysis;</para>
  <para style="q2" vid="LAM 2:5">kawo gadhotanne miixa ubbaa laallis</para>
  <para style="q2" vid="LAM 2:5">yihuda asaas yeehonne kayo gujis.<verse eid="LAM 2:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 2:6"/>Ba keetha atakilte gaden de7iya shaqarada shoddidi holis;</para>
  <para style="q2" vid="LAM 2:6">laytha ba7aaletinne Sambaatati dogetanaada oothis;</para>
  <para style="q2" vid="LAM 2:6">ba gita hanquwan kawanne kahiniya kawushis.<verse eid="LAM 2:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 2:7"/>Goday ba yarsho bessa kadhis; ba keethaa aggaagis;</para>
  <para style="q2" vid="LAM 2:7">kawo gadhota gimbiya morketa kushen yeggis.</para>
  <para style="q1" vid="LAM 2:7">Laytha ba7aale bonchiya gallasa wocamada,</para>
  <para style="q2" vid="LAM 2:7">morketi Xoossa keethan wocamidosona.<verse eid="LAM 2:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 2:8"/>Goday Xiyooni na7e dirsa gimbiya,</para>
  <para style="q2" vid="LAM 2:8">laallanaw qachis; I bolla wadha wodoro yeggis.</para>
  <para style="q1" vid="LAM 2:8">Iyo dhaysona de7ishe ba kushiya zaarenna;</para>
  <para style="q2" vid="LAM 2:8">gimbeynne miixay issife kundanaada oothis.<verse eid="LAM 2:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 2:9"/>Yerusalaame penge sanqati biittan moogetidosona;</para>
  <para style="q2" vid="LAM 2:9">enta gorde mithata mentherethidi dhaysis.</para>
  <para style="q1" vid="LAM 2:9">Kawoynne moorinnati di7etidi kawotethata giddo bidosona;</para>
  <para style="q2" vid="LAM 2:9">higge tamaarsey baawa;</para>
  <para style="q2" vid="LAM 2:9">nabetika hizape guye qoncethi be7okona.<verse eid="LAM 2:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 2:10"/>Xiyoone cimati si77i gidi biittan uttidosona;</para>
  <para style="q2" vid="LAM 2:10">banta huuphen baana qolidi kayo ma7o ma7idosona;</para>
  <para style="q2" vid="LAM 2:10">Yerusalaame geela7oti sa7an duge hokidosona.<verse eid="LAM 2:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 2:11"/>Ta asay dhayida gisho,</para>
  <para style="q2" vid="LAM 2:11">guutha nayti katamaa ogiya bolla</para>
  <para style="q2" vid="LAM 2:11">daaburidi kundida gisho,</para>
  <para style="q2" vid="LAM 2:11">ta ayfey afuthan tulcatis;</para>
  <para style="q2" vid="LAM 2:11">ta wozanay azzanon dagammis.<verse eid="LAM 2:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 2:12"/>Enti banta aayetako,</para>
  <para style="q2" vid="LAM 2:12">“Kathi imma! haathe imma”</para>
  <para style="m" vid="LAM 2:12">yaagidi waassoosona;</para>
  <para style="q2" vid="LAM 2:12">katamaa ogiyan madunxidi labbaniya asada,</para>
  <para style="q2" vid="LAM 2:12">enti daaburin enta shempoy enta aayeta ki7on keyees.<verse eid="LAM 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="LAM 2:13"/>Yerusalaame naatte, taani nebaa ay gaanee?</para>
  <para style="q2" vid="LAM 2:13">ne qohuwa ta aybira ginayo?</para>
  <para style="q1" vid="LAM 2:13">Dosetida Xiyoone geela7e, ta nena waatada minthetho?</para>
  <para style="q2" vid="LAM 2:13">Ne madunthay abba mela ciimmo;</para>
  <para style="q2" vid="LAM 2:13">nena ooni pathanaw danda7ii?<verse eid="LAM 2:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 2:14"/>Ne nabeti wordonne pathonna qoncethi be7idosona;</para>
  <para style="q2" vid="LAM 2:14">ne di7etonna mela ne nagaraa qoncisidi odibookona;</para>
  <para style="q2" vid="LAM 2:14">enti balethiya wordo qoncethi new be7idosona.<verse eid="LAM 2:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 2:15"/>Ne matara aadhiya ubbay ba kushiya baqees;</para>
  <para style="q2" vid="LAM 2:15">“Biittan ubbaafe aadhada lo77iya katamiya hanno?</para>
  <para style="q1" vid="LAM 2:15">Biitta ubbaas ufaysi geetetida katamiya hanno?”</para>
  <para style="q2" vid="LAM 2:15">yaagidi nena qelqisishe banta huuphiya qaathidosona.<verse eid="LAM 2:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 2:16"/>Ne morketi ubbay banta doona</para>
  <para style="q2" vid="LAM 2:16">ne bolla dooyidosona;</para>
  <para style="q2" vid="LAM 2:16">ne bolla qelqisidosona.</para>
  <para style="q1" vid="LAM 2:16">Banta achaa qarcishe haysada yaagosona;</para>
  <para style="q2" vid="LAM 2:16">nu enta dhaysida, nu amotiday hessa</para>
  <para style="q2" vid="LAM 2:16">wursethan be7ida.<verse eid="LAM 2:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 2:17"/>Goday ba qopidaba oothis;</para>
  <para style="q2" vid="LAM 2:17">kase odida ba qaala polis.</para>
  <para style="q1" vid="LAM 2:17">Yerusalaames qadhetonna iyo laallis</para>
  <para style="q1" vid="LAM 2:17">I morketi ufaytana mela,</para>
  <para style="q2" vid="LAM 2:17">morketa wolqaa minthis.<verse eid="LAM 2:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 2:18"/>Xiyoone, ne dirsa gimbey Godaako waasso!</para>
  <para style="q2" vid="LAM 2:18">ne afuthay qammanne gallas shaafada goggo!</para>
  <para style="q1" vid="LAM 2:18">Newuka shempofa;</para>
  <para style="q2" vid="LAM 2:18">ne ayfiyas shempo immofa!<verse eid="LAM 2:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 2:19"/>Qamma dendada waassa;</para>
  <para style="q2" vid="LAM 2:19">Godaa sinthan ne wozanaa haathada gussa.</para>
  <para style="q1" vid="LAM 2:19">Koshatidi oge doonan kundida ne nayta shempuwas</para>
  <para style="q2" vid="LAM 2:19">ne kushiya iyako pude denthada woossa!<verse eid="LAM 2:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 2:20"/>Abeeti Godaw, be7a!</para>
  <para style="q2" vid="LAM 2:20">kase haysada neeni oodde bolla oothadii?</para>
  <para style="q1" vid="LAM 2:20">Aayeti banta ki7on ko77isidi</para>
  <para style="q2" vid="LAM 2:20">dichida banta nayta mo gay?</para>
  <para style="q2" vid="LAM 2:20">kahinetinne nabeti Xoossa keethan hayqo gay?<verse eid="LAM 2:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 2:21"/>Ciminne na7atethi oge bolla kundidosona;</para>
  <para style="q2" vid="LAM 2:21">geela7otinne panthati mashshan wuridosona.</para>
  <para style="q1" vid="LAM 2:21">Neeni ne hanquwa gallas enta wodhadasa;</para>
  <para style="q2" vid="LAM 2:21">entaw qadhetonna enta buthadasa.<verse eid="LAM 2:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 2:22"/>Gibira gallas ase xeegeysada,</para>
  <para style="q2" vid="LAM 2:22">daganthiya ta morketa ubba bessafe xeegadasa.</para>
  <para style="q1" vid="LAM 2:22">Godaa hanqo gallasan</para>
  <para style="q2" vid="LAM 2:22">oonika kessi ekibeenna woyko attibeenna.</para>
  <para style="q1" vid="LAM 2:22">Taani ta ki7on ko77isada dichida</para>
  <para style="q2" vid="LAM 2:22">nayta ubbaa morkey wodhidi dhaysis.<verse eid="LAM 2:22"/></para>
  <chapter eid="LAM 2"/>
  <chapter number="3" style="c" sid="LAM 3"/>
  <para style="s1">Xoossay Ammanthees</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 3:1"/>Godaa shene xam7an</para>
  <para style="q2" vid="LAM 3:1">meto be7ida asi tana.<verse eid="LAM 3:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 3:2"/>Tana ba sinthafe kessidi,</para>
  <para style="q2" vid="LAM 3:2">poo7oy bayna dhuman wothis.<verse eid="LAM 3:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 3:3"/>Gallas kumethi tana shocanaw</para>
  <para style="q2" vid="LAM 3:3">zaari zaari ba kushiya denthis.<verse eid="LAM 3:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 3:4"/>I, ta galbaanne ta ashuwa cimisis;</para>
  <para style="q2" vid="LAM 3:4">ta meqethaa menthis.<verse eid="LAM 3:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 3:5"/>I, ta yuushuwa metoninne</para>
  <para style="q2" vid="LAM 3:5">daaburan diris.<verse eid="LAM 3:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 3:6"/>Beni hayqida asada</para>
  <para style="q2" vid="LAM 3:6">tana dhuman wothis.<verse eid="LAM 3:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 3:7"/>Ta kessa ekonna mela,</para>
  <para style="q2" vid="LAM 3:7">ta yuushuwa diris;</para>
  <para style="q2" vid="LAM 3:7">deexo duthan tana duxis.<verse eid="LAM 3:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 3:8"/>Taani maade koyada iya xeegin,</para>
  <para style="q2" vid="LAM 3:8">iyako waassin, tana si7onna ixis.<verse eid="LAM 3:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 3:9"/>Ta ogiya wolqaama shuchan gordis;</para>
  <para style="q2" vid="LAM 3:9">ta ogiya geellayis.<verse eid="LAM 3:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 3:10"/>I, taw zugidi naagiya babantha mela,</para>
  <para style="q2" vid="LAM 3:10">qosetidi naagiya gaammo mela gidis.<verse eid="LAM 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 3:11"/>I, tana ta ogiyape kessidi duuserethis;</para>
  <para style="q2" vid="LAM 3:11">tana asi bayna bessan yeggi aggis.<verse eid="LAM 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 3:12"/>Ba dongiya dafidi,</para>
  <para style="q2" vid="LAM 3:12">tana dukanaw mallis.<verse eid="LAM 3:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 3:13"/>Ba dongiya dafidi,</para>
  <para style="q2" vid="LAM 3:13">ta wozana ayfen caddis.<verse eid="LAM 3:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 3:14"/>Taani asa ubbaas miichas attas;</para>
  <para style="q2" vid="LAM 3:14">gallas kumethi bore yethas gidas.<verse eid="LAM 3:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 3:15"/>I, tana meton camisis;</para>
  <para style="q2" vid="LAM 3:15">camo godare uuthi tana ushshidi kalsis.<verse eid="LAM 3:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 3:16"/>I, ta achaa acen menthis;</para>
  <para style="q2" vid="LAM 3:16">tana baanan yedhis.<verse eid="LAM 3:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 3:17"/>Saroy taape haakis;</para>
  <para style="q2" vid="LAM 3:17">taani inje duussu dogas.<verse eid="LAM 3:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 3:18"/>Hessa gisho,</para>
  <para style="q2" vid="LAM 3:18">“Ta wolqay taape eketis;</para>
  <para style="q2" vid="LAM 3:18">taani Godan wothida ufaysa ubbay dhayis”</para>
  <para style="m" vid="LAM 3:18">yaagas.<verse eid="LAM 3:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 3:19"/>Ta metuwanne ta un7aa hassayin de7oy tana cammis.<verse eid="LAM 3:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 3:20"/>Ta hessa kumethi dogike; ta shempoy azzanees.<verse eid="LAM 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="LAM 3:21"/>Gidoshin, ta issiba ta wozanan qopiya wode ta ufaysan kumayis.<verse eid="LAM 3:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 3:22"/>Hessika, nuuni dhayboonay</para>
  <para style="q2" vid="LAM 3:22">Godaa siiquwape dendoysana;</para>
  <para style="q2" vid="LAM 3:22">iya qadhey wuri erenna.<verse eid="LAM 3:22"/></para>
  <para style="q1">
    <verse number="23" style="v" sid="LAM 3:23"/>Enti wonta wonta oorathi;</para>
  <para style="q2" vid="LAM 3:23">ne daro ammanthasa.<verse eid="LAM 3:23"/></para>
  <para style="q1">
    <verse number="24" style="v" sid="LAM 3:24"/>Goday ta saama;</para>
  <para style="q2" vid="LAM 3:24">hessa gisho, ta iyan ufaysi wothana.<verse eid="LAM 3:24"/></para>
  <para style="q1">
    <verse number="25" style="v" sid="LAM 3:25"/>Iyan banta ufaysa wotheysatasinne</para>
  <para style="q2" vid="LAM 3:25">iya koyeysatas Goday lo77o.<verse eid="LAM 3:25"/></para>
  <para style="q1">
    <verse number="26" style="v" sid="LAM 3:26"/>Asi si77i gidi Godaa atotethan naagiko lo77o.<verse eid="LAM 3:26"/></para>
  <para style="q1">
    <verse number="27" style="v" sid="LAM 3:27"/>As ba na7atethan meto danda7a tamaariko lo77o.<verse eid="LAM 3:27"/></para>
  <para style="q1">
    <verse number="28" style="v" sid="LAM 3:28"/>Goday meto ehiya wode si77i gidi utto.<verse eid="LAM 3:28"/></para>
  <para style="q1">
    <verse number="29" style="v" sid="LAM 3:29"/>Iyaw sinthafe ufaysi daanaw danda7iya gisho bana ziqi ootho.<verse eid="LAM 3:29"/></para>
  <para style="q1">
    <verse number="30" style="v" sid="LAM 3:30"/>I ba shakala baqeysas immo; cashshe kallo.<verse eid="LAM 3:30"/></para>
  <para style="q1">
    <verse number="31" style="v" sid="LAM 3:31"/>Goday ase merinaw yeggenna.<verse eid="LAM 3:31"/></para>
  <para style="q1">
    <verse number="32" style="v" sid="LAM 3:32"/>I asa bolla meto ehikoka,</para>
  <para style="q2" vid="LAM 3:32">ba merina siiquwa darotethan zaaridi qadhetees.<verse eid="LAM 3:32"/></para>
  <para style="q1">
    <verse number="33" style="v" sid="LAM 3:33"/>I asa bolla meto woyko un7a ehidi ufaytenna.<verse eid="LAM 3:33"/></para>
  <para style="q1">
    <verse number="34" style="v" sid="LAM 3:34"/>Bittan de7iya qasho asa banta tohuwpe garsan yedhiya wode,<verse eid="LAM 3:34"/></para>
  <para style="q1">
    <verse number="35" style="v" sid="LAM 3:35"/>Ubbaafe Wolqaama Xoossaa sinthan asa maati yedhetiya wode,<verse eid="LAM 3:35"/></para>
  <para style="q1">
    <verse number="36" style="v" sid="LAM 3:36"/>Xillo pirdi dhayiya wode Goday hessa ubbaa be7eneyee?<verse eid="LAM 3:36"/></para>
  <para style="q1">
    <verse number="37" style="v" sid="LAM 3:37"/>Goday kiittonashin odidi polisanaw danda7ey oonee?<verse eid="LAM 3:37"/></para>
  <para style="q1">
    <verse number="38" style="v" sid="LAM 3:38"/>Iitaba gidin lo77oba odi poley Ubbaafe Dhoqa Xoossa gidenneyee?<verse eid="LAM 3:38"/></para>
  <para style="q1">
    <verse number="39" style="v" sid="LAM 3:39"/>Yaatin, asi de7on de7ishe ba nagaraa gisho seeretiya wode ayis zuuzumii?<verse eid="LAM 3:39"/></para>
  <para style="q1">
    <verse number="40" style="v" sid="LAM 3:40"/>Ane nu ogiya paacoos; Godaako simmoos.<verse eid="LAM 3:40"/></para>
  <para style="q1">
    <verse number="41" style="v" sid="LAM 3:41"/>Nu wozanaa nu kushiyara salon de7iya Xoossaako denthidi haysada yaagos:<verse eid="LAM 3:41"/></para>
  <para style="q1">
    <verse number="42" style="v" sid="LAM 3:42"/>Nu nena naaqida; new makallida;</para>
  <para style="q2" vid="LAM 3:42">neka nuus atto gabaaka.<verse eid="LAM 3:42"/></para>
  <para style="q1">
    <verse number="43" style="v" sid="LAM 3:43"/>Ne hanquwan kametada nuna yedethada;</para>
  <para style="q2" vid="LAM 3:43">ne nuus qadhetonna nuna wodhadasa.<verse eid="LAM 3:43"/></para>
  <para style="q1">
    <verse number="44" style="v" sid="LAM 3:44"/>Nu woosay neeko gakonnaada, nenatethaa shaaran kammadasa.<verse eid="LAM 3:44"/></para>
  <para style="q1">
    <verse number="45" style="v" sid="LAM 3:45"/>Asaa giddon nuna pitonne buure oothadasa.<verse eid="LAM 3:45"/></para>
  <para style="q1">
    <verse number="46" style="v" sid="LAM 3:46"/>Nu morketi ubbay nu bolla banta doona dooyidosona.<verse eid="LAM 3:46"/></para>
  <para style="q1">
    <verse number="47" style="v" sid="LAM 3:47"/>Nu dagamaninne giten gelida; metoninne un7an laaletida.<verse eid="LAM 3:47"/></para>
  <para style="q1">
    <verse number="48" style="v" sid="LAM 3:48"/>Ta asaa gakida waayiya gaason ta ayfepe afuthu shaafada goggees.<verse eid="LAM 3:48"/></para>
  <para style="q1">
    <verse number="49" style="v" sid="LAM 3:49"/>Ta ayfey aggonna afuxees.<verse eid="LAM 3:49"/></para>
  <para style="q1">
    <verse number="50" style="v" sid="LAM 3:50"/>Goday salope duge be7ana gakanaw hessi hanees.<verse eid="LAM 3:50"/></para>
  <para style="q1">
    <verse number="51" style="v" sid="LAM 3:51"/>Ta kataman de7iya maccasata bolla gakidaba ta ayfey be7ida wode ta wozanay azzanis.<verse eid="LAM 3:51"/></para>
  <para style="q1">
    <verse number="52" style="v" sid="LAM 3:52"/>Coo tana morkeysati kafo shankatiyada tana shankatidosona.<verse eid="LAM 3:52"/></para>
  <para style="q1">
    <verse number="53" style="v" sid="LAM 3:53"/>Ta paxa de7ishin tana ollan yeggidi,</para>
  <para style="q2" vid="LAM 3:53">ollaa doona shuchan gordidosona.<verse eid="LAM 3:53"/></para>
  <para style="q1">
    <verse number="54" style="v" sid="LAM 3:54"/>Haathi kumidi ta huuphera goggiya wode ta dhayas gada qopas.<verse eid="LAM 3:54"/></para>
  <para style="q1">
    <verse number="55" style="v" sid="LAM 3:55"/>Abeeti Godaw, ta ciimmo ollan de7ashe ne sunthaa xeegas.<verse eid="LAM 3:55"/></para>
  <para style="q1">
    <verse number="56" style="v" sid="LAM 3:56"/>Ta waasuwa si7anaada ta nena woossiya wode tana si7adasa.<verse eid="LAM 3:56"/></para>
  <para style="q1">
    <verse number="57" style="v" sid="LAM 3:57"/>Taani nena xeegida wode taako shiiqada, “Babofa” yaagadasa.<verse eid="LAM 3:57"/></para>
  <para style="q1">
    <verse number="58" style="v" sid="LAM 3:58"/>Abeeti Godaw ne ta mootuwa mootetada tana wozadasa.<verse eid="LAM 3:58"/></para>
  <para style="q1">
    <verse number="59" style="v" sid="LAM 3:59"/>Abeeti Godaw, ne ta un7aa be7adasa;</para>
  <para style="q2" vid="LAM 3:59">hessa gisho, ne taw pirda.<verse eid="LAM 3:59"/></para>
  <para style="q1">
    <verse number="60" style="v" sid="LAM 3:60"/>Enti halo keyanaw ta bolla maqetiya maquwa ubbaa be7adasa.<verse eid="LAM 3:60"/></para>
  <para style="q1">
    <verse number="61" style="v" sid="LAM 3:61"/>Abeeti Godaw, enti tana cayiya cashshaanne</para>
  <para style="q2" vid="LAM 3:61">ta bolla maqetiya maquwa ubbaa si7adasa.<verse eid="LAM 3:61"/></para>
  <para style="q1">
    <verse number="62" style="v" sid="LAM 3:62"/>Ta morketi gallas kumethi</para>
  <para style="q2" vid="LAM 3:62">ta bolla zuuzumeysanne kalkasheysa si7adasa.<verse eid="LAM 3:62"/></para>
  <para style="q1">
    <verse number="63" style="v" sid="LAM 3:63"/>Enti uttishenne eqishe tana boridi yexoosona.<verse eid="LAM 3:63"/></para>
  <para style="q1">
    <verse number="64" style="v" sid="LAM 3:64"/>Abeeti Godaw, enti oothida oosuwas bessiya zaaruwa entaw qanxa!<verse eid="LAM 3:64"/></para>
  <para style="q1">
    <verse number="65" style="v" sid="LAM 3:65"/>Enta wozanaa eysa; ne baadethay enta gako.<verse eid="LAM 3:65"/></para>
  <para style="q1">
    <verse number="66" style="v" sid="LAM 3:66"/>Abeeti Godaw, ne enta ne hanquwan yedetha;</para>
  <para style="q2" vid="LAM 3:66">salope garsan enta dhaysa.<verse eid="LAM 3:66"/></para>
  <chapter eid="LAM 3"/>
  <chapter number="4" style="c" sid="LAM 4"/>
  <para style="s1">Geeshsha Shuchati Laaletidosona</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 4:1"/>Worqey phooleysa waanidi aggidee?</para>
  <para style="q2" vid="LAM 4:1">geeshsha worqay waanidi dammidee? Xoossa keethay gimbetida shuchay oge doonan laaletis.<verse eid="LAM 4:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 4:2"/>Kase al7o worqa mela bonchetida Xiyoone nayti</para>
  <para style="q2" vid="LAM 4:2">ha77i biittafe medhetida oto gididosona.<verse eid="LAM 4:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 4:3"/>Hari attoshin worakani ba mari dhanthawusu;</para>
  <para style="q2" vid="LAM 4:3">shin ta asay bazzon de7iya yanchoda, ba naytas iita gidis.<verse eid="LAM 4:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 4:4"/>Saamo gaason yooga nayta inxarsay kottonora oyketis;</para>
  <para style="q2" vid="LAM 4:4">nayti kathi woossosona;</para>
  <para style="q2" vid="LAM 4:4">shin entaw immiya oonika baawa.<verse eid="LAM 4:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 4:5"/>Kase mal7o katha xalaala meysati</para>
  <para style="q2" vid="LAM 4:5">ha77i oge doonan koshan wuridosona.</para>
  <para style="q1" vid="LAM 4:5">Kase liino ma7idi diccidaysati</para>
  <para style="q2" vid="LAM 4:5">ha77i bido bolla zin7idosona.<verse eid="LAM 4:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 4:6"/>Ta asaa nagaray,</para>
  <para style="q2" vid="LAM 4:6">oodde kusheyka iyo bochonna,</para>
  <para style="q2" vid="LAM 4:6">qoponna shiretidi wodhida Soodome asa nagarape daro.<verse eid="LAM 4:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 4:7"/>Yihuda halaqati shachafe aadhida geeshshi,</para>
  <para style="q2" vid="LAM 4:7">maathafe aadhida boothu.</para>
  <para style="q1" vid="LAM 4:7">Enta asatethay zo7o inqofe aadhida aarise;</para>
  <para style="q2" vid="LAM 4:7">enta medhoy sanpare al7o shucha mela.<verse eid="LAM 4:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 4:8"/>Shin ha77i enta som7oy shaalape aadhidi kareexis;</para>
  <para style="q2" vid="LAM 4:8">asasi ogen enta be7idi erenna;</para>
  <para style="q2" vid="LAM 4:8">enta gogay meqethaara oyketidi mithada melis.<verse eid="LAM 4:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 4:9"/>Miyaba dhayidi, koshan hayqidaysatape</para>
  <para style="q2" vid="LAM 4:9">olan hayqidaysati lo77o.<verse eid="LAM 4:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 4:10"/>Ta asaa bolla yida dhayuwa gaason,</para>
  <para style="q2" vid="LAM 4:10">qadhetiya aayeti banta nayta doysidi midosona.<verse eid="LAM 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 4:11"/>Godaa hanqo xuu7ay kumis; I ba suulliya sheniya tigis.</para>
  <para style="q2" vid="LAM 4:11">Yerusalaame baasuwa tama oythis.<verse eid="LAM 4:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 4:12"/>Ha sa7a kawotape woyko kawotethatan de7iya asaape oonika</para>
  <para style="q2" vid="LAM 4:12">morkey Yerusalaame pengiyara gelana gidi ammanibena.<verse eid="LAM 4:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 4:13"/>Shin haysi haniday iya nabetinne nagarasinne iya kahineti oothida naaquwasa,</para>
  <para style="q2" vid="LAM 4:13">xillota suuthaa iya giddon gussida gishosa.<verse eid="LAM 4:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 4:14"/>Enti qooqe asada, oge tattafoosona;</para>
  <para style="q2" vid="LAM 4:14">enti suuthan tunida gisho</para>
  <para style="q2" vid="LAM 4:14">enta ma7uwa oonika bochanaw koyenna.<verse eid="LAM 4:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 4:15"/>Hessa gisho, asay, “Kichite! hinte tuna gidiya gisho,</para>
  <para style="q2" vid="LAM 4:15">nuna bochofite!” yaagidi enta bolla waassidosona.</para>
  <para style="q1" vid="LAM 4:15">Enti baqatidi toylatiya wode,</para>
  <para style="q2" vid="LAM 4:15">kawotethatan de7iya asay,</para>
  <para style="q2" vid="LAM 4:15">“Hinte nuura haysan daanaw danda7eketa” yaagidosona.<verse eid="LAM 4:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 4:16"/>Goday enta laallis; I entaba zaaridi qopenna;</para>
  <para style="q2" vid="LAM 4:16">enta kahineti bonchetokona;</para>
  <para style="q2" vid="LAM 4:16">enta cimati nashetookona.<verse eid="LAM 4:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 4:17"/>Nu ayfey maado demmanaw xeellishe coo daaburis;</para>
  <para style="q2" vid="LAM 4:17">nuna ashshanaw danda7onna</para>
  <para style="q2" vid="LAM 4:17">kawotethatape maado naagida.<verse eid="LAM 4:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 4:18"/>Asay nu gedaa kaalliya gisho,</para>
  <para style="q2" vid="LAM 4:18">nu katama ogera hemetanaw danda7ibooko.</para>
  <para style="q1" vid="LAM 4:18">Nu wursethay matis; nu laythay wuris;</para>
  <para style="q2" vid="LAM 4:18">nuus dhayo wodeyka gakis.<verse eid="LAM 4:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 4:19"/>Nuna yedetheysati piradhiya arganthafe aadhidi eesotoosona;</para>
  <para style="q2" vid="LAM 4:19">enti nuna dere huuphera yedethidosona;</para>
  <para style="q2" vid="LAM 4:19">bazzon hokidi nuna naagidosona.<verse eid="LAM 4:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 4:20"/>Goday tiyida kawoy, nu de7uwas shempoy,</para>
  <para style="q2" vid="LAM 4:20">enta xihiyan oyketis.</para>
  <para style="q1" vid="LAM 4:20">Nu iya kuya garsan uttidi,</para>
  <para style="q2" vid="LAM 4:20">kawotethata giddon daana gidi qopida.<verse eid="LAM 4:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 4:21"/>Hinteno, Uxa biittan de7iya Edoome asaw,</para>
  <para style="q2" vid="LAM 4:21">ufaytite; hashshu giite.</para>
  <para style="q1" vid="LAM 4:21">Shin xuu7ay hinte bolla yaana;</para>
  <para style="q2" vid="LAM 4:21">hinte mathotidi kallo attana.<verse eid="LAM 4:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 4:22"/>Hinteno, Xiyoone asaw, hinte seeray gidana;</para>
  <para style="q2" vid="LAM 4:22">I hizape hintena di7o biittan wothenna.</para>
  <para style="q1" vid="LAM 4:22">Shin Edoome asaw, hinte seeretana;</para>
  <para style="q2" vid="LAM 4:22">hinte nagarayka qoncana.<verse eid="LAM 4:22"/></para>
  <chapter eid="LAM 4"/>
  <chapter number="5" style="c" sid="LAM 5"/>
  <para style="s1">Godaw, Nuna Neeko Zaara</para>
  <para style="p">
    <verse number="1" style="v" sid="LAM 5:1"/>Abeeti Godaw, nuna gakidaba ubbaa qopa;</para>
  <para style="q2" vid="LAM 5:1">nu kawushatethaa be7a!<verse eid="LAM 5:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="LAM 5:2"/>Nu laatay allagatas,</para>
  <para style="q2" vid="LAM 5:2">nu keethayka imatha asaas imetis.<verse eid="LAM 5:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="LAM 5:3"/>Nuuni aawi hayqida na7a gidida;</para>
  <para style="q2" vid="LAM 5:3">nu aayetika am7o gididosona.<verse eid="LAM 5:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="LAM 5:4"/>Nuuni ushsha haatha shammidi ekoos;</para>
  <para style="q2" vid="LAM 5:4">eethiya mithas gate qanxoos.<verse eid="LAM 5:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="LAM 5:5"/>Nuna yedetheysati nu gindiya garsana;</para>
  <para style="q2" vid="LAM 5:5">nu daaburida shin shempanaw danda7ibooko.<verse eid="LAM 5:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="LAM 5:6"/>Nuuni kathi kallana gidi,</para>
  <para style="q2" vid="LAM 5:6">Gibxetasinne Asooretas kushe immida.<verse eid="LAM 5:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="LAM 5:7"/>Nagara oothiday nu mayzata,</para>
  <para style="q2" vid="LAM 5:7">shin enti ha77i dookona;</para>
  <para style="q2" vid="LAM 5:7">enti ekanaw bessiya seera ekiday nuna.<verse eid="LAM 5:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="LAM 5:8"/>Nuna aylleti haaroosona;</para>
  <para style="q2" vid="LAM 5:8">enta kushepe nuna ashshiya oonika baawa.<verse eid="LAM 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="LAM 5:9"/>Mashshan wodheysati bazzon de7iya gisho,</para>
  <para style="q2" vid="LAM 5:9">nu shempuwa bayzidi kathi demmida.<verse eid="LAM 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="LAM 5:10"/>Iita kosha gaason,</para>
  <para style="q2" vid="LAM 5:10">nu gogay tama cooceda michees.<verse eid="LAM 5:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="LAM 5:11"/>Maccasata Xiyoonen</para>
  <para style="q2" vid="LAM 5:11">geela7ota Yihuda katamatan</para>
  <para style="q2" vid="LAM 5:11">wolqan oykidi tunisidosona.<verse eid="LAM 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="LAM 5:12"/>Halaqata efidi kaqidosona;</para>
  <para style="q2" vid="LAM 5:12">cimati bonchetibookona.<verse eid="LAM 5:12"/></para>
  <para style="q1">
    <verse number="13" style="v" sid="LAM 5:13"/>Yalaga addeti woxan gaaccidosona;</para>
  <para style="q2" vid="LAM 5:13">adde nayti deexo mithi tookidi gandigaridosona.<verse eid="LAM 5:13"/></para>
  <para style="q1">
    <verse number="14" style="v" sid="LAM 5:14"/>Cimati katama pengen pirdanaw utteysa aggidosona;</para>
  <para style="q2" vid="LAM 5:14">yalaga addeti nayti yethi dogidosona.<verse eid="LAM 5:14"/></para>
  <para style="q1">
    <verse number="15" style="v" sid="LAM 5:15"/>Nu wozanaape ufaysi kichis;</para>
  <para style="q2" vid="LAM 5:15">nu dursay yeehon laametis.<verse eid="LAM 5:15"/></para>
  <para style="q1">
    <verse number="16" style="v" sid="LAM 5:16"/>Nu huuphiyape kallachay kundis;</para>
  <para style="q2" vid="LAM 5:16">nu nagara oothida gisho nuna ayye!<verse eid="LAM 5:16"/></para>
  <para style="q1">
    <verse number="17" style="v" sid="LAM 5:17"/>Hessa gisho, nu wozanay daaburis;</para>
  <para style="q2" vid="LAM 5:17">nu ayfey teljumis.<verse eid="LAM 5:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="LAM 5:18"/>Xiyoone Derey baysa gidida gisho,</para>
  <para style="q2" vid="LAM 5:18">workanati yan gupoosona.<verse eid="LAM 5:18"/></para>
  <para style="q1">
    <verse number="19" style="v" sid="LAM 5:19"/>Abeeti Godaw, ne merinaw haarasa;</para>
  <para style="q2" vid="LAM 5:19">ne araatay yeletaape yeletaa gakanaasa.<verse eid="LAM 5:19"/></para>
  <para style="q1">
    <verse number="20" style="v" sid="LAM 5:20"/>Neeni nuna ayis ubba wode dogay?</para>
  <para style="q2" vid="LAM 5:20">haysa mela adussa wode nuna ayis aggay?<verse eid="LAM 5:20"/></para>
  <para style="q1">
    <verse number="21" style="v" sid="LAM 5:21"/>Abeeti Godaw, nuna neeko zaara; nu simmana;</para>
  <para style="q2" vid="LAM 5:21">nu wodiya beniysatho zaarada ooratha.<verse eid="LAM 5:21"/></para>
  <para style="q1">
    <verse number="22" style="v" sid="LAM 5:22"/>Neeni nuna polo aggadiyee?</para>
  <para style="q2" vid="LAM 5:22">Ne hanquwas zawi baaweyee?<verse eid="LAM 5:22"/></para>
  <chapter eid="LAM 5"/>
</usx>
