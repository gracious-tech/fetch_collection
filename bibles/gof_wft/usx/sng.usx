<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="SNG" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Solomone Mazmure Maxaafa</para>
  <para style="toc1">Solomone Mazmure Maxaafa</para>
  <para style="toc3">Solo</para>
  <para style="toc2">Solomone</para>
  <para style="mt1">Solomone Mazmure Maxaafa</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">“Solomone Mazmure Maxaafa” geetetiya maxaafay siiqo ginxon xaafetida maxaafa. Ha ginxotape daro baggay mazmure maaran xaafetis. Ha ginxoti xaafetishe, addey maccasas, qassi maccasi addes xaafida ginxo. Ha maxaafay issi issi birshethatan “Siiqo Saba” woyko “Mazmuretape Aadhiya Mazmure” geetetees. Hara birshethan qassi “Solomone Mazmure” geetetidi eretees.</para>
  <para style="ip">Ha mazmurey dumma dumma ogen birshetishe gam7is. Issi issi asay, Kiristoosasinne woosa keethas giddon de7iya siiqo bessiya leemiso gidi qopoosona. Ayhudeti qassi, “Xoossasinne Isra7eele asaas giddon de7iya siiqo leemisota oykida maxaafa” goosona.</para>
  <para style="ip">Gidoshin, ha mazmurey adde giddoninne macca giddon de7iya siiqo mazmure. Issi mehe heemmiya panthay issi mehe heemmiya geela7iw demmanaw koyees (1:7-8). Enti banta mazmuriya wode wonto enti eketi geletiya wode enta ufaysay kumethi gidanaysa qoncisosona.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Koyro Mazmure <char style="ior">(<ref loc="SNG 1:1-2:7">1:1—2:7</ref>)</char></para>
  <para style="io1">Nam7antho Mazmure <char style="ior">(<ref loc="SNG 2:8-3:5">2:8—3:5</ref>)</char></para>
  <para style="io1">Heedzantho Mazmure <char style="ior">(<ref loc="SNG 3:6-5:1">3:6—5:1</ref>)</char></para>
  <para style="io1">Oyddantho Mazmure <char style="ior">(<ref loc="SNG 5:2-6:3">5:2—6:3</ref>)</char></para>
  <para style="io1">Ichashantho Mazmure <char style="ior">(<ref loc="SNG 6:4-8:4">6:4—8:4</ref>)</char></para>
  <para style="io1">Usupuntho Mazmure <char style="ior">(<ref loc="SNG 8:5-14">8:5-14</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="SNG 1" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 1:1" />Mazmure ubbaafe aadhiya Solomone mazmurey haysa.<verse eid="SNG 1:1" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 1:2" />Ne siiqoy woynepe aadhidi ufaysiya gisho</para>
  <para style="q2" vid="SNG 1:2">tana zaara zaara yeera.<verse eid="SNG 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 1:3" />Ne tiyetiya shittoy waanidi sawii!</para>
  <para style="q2" vid="SNG 1:3">Ne sunthay goggiya shitto mela;</para>
  <para style="q2" vid="SNG 1:3">Geela7oti nena siiqey hessasa.<verse eid="SNG 1:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 1:4" />Tana neera ekada ba; ane issife woxoos!</para>
  <para style="q2" vid="SNG 1:4">Kawaw, tana ne quruxuwan gelsa.</para>
  <para style="b" vid="SNG 1:4" />
  <para style="s1" vid="SNG 1:4">Yerusalaame maccasata</para>
  <para style="q1" vid="SNG 1:4">Nenan nu ufaytoos;</para>
  <para style="q2" vid="SNG 1:4">ne siiquwa woyne ushshafe aathidi nashshoos.</para>
  <para style="q2" vid="SNG 1:4">Maccasi ubbay nena siiqeysa bessa.<verse eid="SNG 1:4" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 1:5" />Hinteno, Yerusalaame maccasato si7ite;</para>
  <para style="q2" vid="SNG 1:5">taani kareethi gidikoka mala lo77o.</para>
  <para style="q1" vid="SNG 1:5">Ta kareethatethay Qedaare dunkaane mela;</para>
  <para style="q2" vid="SNG 1:5">shin ta malay Solomone magarajota mela.<verse eid="SNG 1:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 1:6" />Ta malaa kareethiday awa;</para>
  <para style="q2" vid="SNG 1:6">taani kareethi gidida gisho tana boropite.</para>
  <para style="q1" vid="SNG 1:6">Ta ishati, ta aaye nayti taara ooyetidi,</para>
  <para style="q2" vid="SNG 1:6">tana woyne gade naagisidosona;</para>
  <para style="q2" vid="SNG 1:6">hessa gisho ta woyniya naagabike.<verse eid="SNG 1:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 1:7" />Ta siiquwaw, ane taw oda;</para>
  <para style="q2" vid="SNG 1:7">ne dorsaa wudiya awun heemmay?</para>
  <para style="q2" vid="SNG 1:7">Seeta gallas enta awun shempisay?</para>
  <para style="q1" vid="SNG 1:7">Nena demmanaw ne laggeta wudiya kaallada,</para>
  <para style="q2" vid="SNG 1:7">ayis guuluntada biya maccas gido?<verse eid="SNG 1:7" /></para>
  <para style="b" />
  <para style="s1">Panthaa</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 1:8" />Maccasa ubbaafe lo77iyare,</para>
  <para style="q2" vid="SNG 1:8">Bessaa eronna ixiko dorsata geedo kaalla.</para>
  <para style="q1" vid="SNG 1:8">Ne deesha marata henthanchota</para>
  <para style="q2" vid="SNG 1:8">dunkaaniya matan heemma.<verse eid="SNG 1:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="SNG 1:9" />Ta siiqe! Gibxe kawo para gaareta goochiya,</para>
  <para style="q2" vid="SNG 1:9">parata giddon de7iya magaayeda lo77aasa.<verse eid="SNG 1:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 1:10" />Ne haythan de7iya alleequwara shiiqidi,</para>
  <para style="q2" vid="SNG 1:10">ne shakalay waanidi lo77i!</para>
  <para style="q2" vid="SNG 1:10">Ne qoodhey al7o shuchan alleeqetis.<verse eid="SNG 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 1:11" />Nuuni new biran cadetida,</para>
  <para style="q2" vid="SNG 1:11">worqa alleequwa oosisana.<verse eid="SNG 1:11" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 1:12" />Kawoy gayta bolla uttidashin,</para>
  <para style="q2" vid="SNG 1:12">ta shittuwa sawoy keethan tonku gis.<verse eid="SNG 1:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 1:13" />Ta siiqoy ta dhanthata giddon de7iya,</para>
  <para style="q2" vid="SNG 1:13">xuntetida sawiya karbe daanees.<verse eid="SNG 1:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 1:14" />Ta siiqoy, Engaada woyne gaden,</para>
  <para style="q2" vid="SNG 1:14">dolida heena ciishsha mela.<verse eid="SNG 1:14" /></para>
  <para style="b" />
  <para style="s1">Panthaa</para>
  <para style="p">
    <verse number="15" style="v" sid="SNG 1:15" />Ta siiqe, neeni waana lo77ay!</para>
  <para style="q2" vid="SNG 1:15">Neeni waana lo77ay!</para>
  <para style="q2" vid="SNG 1:15">Ne ayfeti holle ayfeda lo77oosona.<verse eid="SNG 1:15" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 1:16" />Ta siiquwaw, neeni waanna lo77ay!</para>
  <para style="q2" vid="SNG 1:16">Ayba ufaysay;</para>
  <para style="q2" vid="SNG 1:16">nu arsay cil7o maata mela ufaysees.<verse eid="SNG 1:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 1:17" />Nu keethaa tuussay ziga;</para>
  <para style="q2" vid="SNG 1:17">nu kaaray xiiddan oyketis.<verse eid="SNG 1:17" /></para>
  <chapter eid="SNG 1" />
  <chapter number="2" style="c" sid="SNG 2" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 2:1" />Taani Saaronan doliya ciishshanne</para>
  <para style="q2" vid="SNG 2:1">zangaaran doliya suufe ciishsha mela.<verse eid="SNG 2:1" /></para>
  <para style="b" />
  <para style="s1">Panthaa</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 2:2" />Ta siiqiya maccasa giddon be7iya wode,</para>
  <para style="q2" vid="SNG 2:2">aguntha giddon bentiya suufe ciishsha mela.<verse eid="SNG 2:2" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 2:3" />Ta siiqoy hara panthata giddon xeelliya wode</para>
  <para style="q2" vid="SNG 2:3">woran de7iya apile mithaa mela.</para>
  <para style="q1" vid="SNG 2:3">Tana daro ufaysin, iya kuyaa giddon uttas;</para>
  <para style="q2" vid="SNG 2:3">iya ayfey min tana mal7ees.<verse eid="SNG 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 2:4" />I tana gibira miya keethi gelsis;</para>
  <para style="q2" vid="SNG 2:4">ba siiquwa bandirada ta bolla dhoqu dhoqu oothis. <verse eid="SNG 2:4" /><verse number="5" style="v" sid="SNG 2:5" />Taani iya siiquwan oyketada hargida gisho,</para>
  <para style="q2" vid="SNG 2:5">zabibe ayfe muzidi tana gashtisite;</para>
  <para style="q2" vid="SNG 2:5">apile muzidi ta wolqaa minthite.<verse eid="SNG 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 2:6" />Ba haddirsa kushiya tana borkotisis;</para>
  <para style="q2" vid="SNG 2:6">ba ushacha kushiyan tana qoommis.<verse eid="SNG 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 2:7" />Hinteno, Yerusalaame yalaga maccasaw,</para>
  <para style="q2" vid="SNG 2:7">siiqoy baw dosidi dendana gakanaw,</para>
  <para style="q2" vid="SNG 2:7">iya hinte barkethonna mela,</para>
  <para style="q2" vid="SNG 2:7">ta hintena gen7eninne wora woshi7en ammatayis.<verse eid="SNG 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="SNG 2:8" />Ta siiquwa girsay deriya bollara gupishenne,</para>
  <para style="q2" vid="SNG 2:8">zumaa bollara xongetishe yeysi si7etees.<verse eid="SNG 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 2:9" />Ta siiqoy woshi7e woyko gen7e mari daanees;</para>
  <para style="q2" vid="SNG 2:9">Heko, nu keethaa matan eqis;</para>
  <para style="q2" vid="SNG 2:9">maskootera soo xeellees;</para>
  <para style="q2" vid="SNG 2:9">magarajuwa giddora xeellees.<verse eid="SNG 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 2:10" />Ta siiqoy, haysada yaagees;</para>
  <para style="q2" vid="SNG 2:10">“Ta siiqe, denda!</para>
  <para style="q2" vid="SNG 2:10">Ta yegelsse, haaya, issife ane boos.<verse eid="SNG 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 2:11" />Heko, balgoy aadhis;</para>
  <para style="q2" vid="SNG 2:11">irayka eqis.<verse eid="SNG 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 2:12" />Biittan ciishshi ciiyis;</para>
  <para style="q2" vid="SNG 2:12">yethi yexiya ageenay gakis;</para>
  <para style="q2" vid="SNG 2:12">holle yethi nu biittan si7etis.<verse eid="SNG 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 2:13" />Balase mithay ayfe doomis;</para>
  <para style="q2" vid="SNG 2:13">woyney ciiyis;</para>
  <para style="q2" vid="SNG 2:13">ciishsha sawoy biittan tonku gees.</para>
  <para style="q1" vid="SNG 2:13">Ta siiqe, denda; ta yegelsse,</para>
  <para style="q2" vid="SNG 2:13">haaya; ane issife boos.”<verse eid="SNG 2:13" /></para>
  <para style="b" />
  <para style="s1">Panthaa</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 2:14" />Aafo doonan zaalla qophon,</para>
  <para style="q2" vid="SNG 2:14">qosetida holle daaniyare;</para>
  <para style="q2" vid="SNG 2:14">ane issi toho tana ne som7uwa bessa;</para>
  <para style="q2" vid="SNG 2:14">ne girsa sissa.</para>
  <para style="q1" vid="SNG 2:14">Ne qaalay tana mal7ees;</para>
  <para style="q2" vid="SNG 2:14">ne som7oy daro lo77ees.<verse eid="SNG 2:14" /></para>
  <para style="b" />
  <para style="s1">Yerusalaame Geela7ota</para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 2:15" />Nu woyney ciiyis;</para>
  <para style="q2" vid="SNG 2:15">nu woyne gadiya iissiya workanata,</para>
  <para style="q2" vid="SNG 2:15">he guutha butaleta xihen oykite.<verse eid="SNG 2:15" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 2:16" />Ta siiqoy tabaa; taanika iyabaa;</para>
  <para style="q2" vid="SNG 2:16">ciishshata giddon I ba wudiya heemmees.<verse eid="SNG 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="SNG 2:17" />Sa7i geeyana gakanaw,</para>
  <para style="q2" vid="SNG 2:17">kuyay dhayana gakanaw,</para>
  <para style="q2" vid="SNG 2:17">ta siiquwaw, gen7eda woyko woshi7e marada,</para>
  <para style="q2" vid="SNG 2:17">aafotiya deriyara woxashe haa simma.<verse eid="SNG 2:17" /></para>
  <chapter eid="SNG 2" />
  <chapter number="3" style="c" sid="SNG 3" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 3:1" />Qamma kumethi hiixan zin7ada,</para>
  <para style="q2" vid="SNG 3:1">ta siiquwa demmanaw amottas;</para>
  <para style="q2" vid="SNG 3:1">minthada koyas; shin demmabike.<verse eid="SNG 3:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 3:2" />Katamaa giddon de7iya dalganne</para>
  <para style="q2" vid="SNG 3:2">xuntha ogeta ubban yuuyas.</para>
  <para style="q2" vid="SNG 3:2">Ta siiquwa demmanaw koyas;</para>
  <para style="q2" vid="SNG 3:2">minthada koyas; shin demmanaw danda7abike.<verse eid="SNG 3:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 3:3" />Katamaa yuuyidi naageysati tana demmidosona;</para>
  <para style="q2" vid="SNG 3:3">taani, “Ta siiquwa be7idetii?” yaagada oychas.<verse eid="SNG 3:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 3:4" />Enta aggada aadhida mela ta siiquwa demmas;</para>
  <para style="q2" vid="SNG 3:4">I taape kessi ekonnaada minthada oykas.</para>
  <para style="q1" vid="SNG 3:4">Ta aaye soo efas;</para>
  <para style="q2" vid="SNG 3:4">ta yeletida kifiliya gelsas.<verse eid="SNG 3:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 3:5" />Hinteno Yerusalaame macca nayto,</para>
  <para style="q2" vid="SNG 3:5">siiqoy baw dosidi dendana gakanaw,</para>
  <para style="q2" vid="SNG 3:5">iya hinte barkisonna mela</para>
  <para style="q2" vid="SNG 3:5">taani hintena gen7eninne woshi7en ammatayis.<verse eid="SNG 3:5" /></para>
  <para style="b" />
  <para style="s1">Yerusalaame Geela7ota</para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 3:6" />Zal7ancho ixaanedanne karbeda sawiyara,</para>
  <para style="q2" vid="SNG 3:6">cuya tuussu daaniyara,</para>
  <para style="q2" vid="SNG 3:6">hanna mela biittafe yaara iya oonee?<verse eid="SNG 3:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 3:7" />Heko, Solomone para gaariya yawusu;</para>
  <para style="q2" vid="SNG 3:7">he para gaariw Isra7eelepe dooretida,</para>
  <para style="q2" vid="SNG 3:7">usupun tammu wolqaama tooranchoti ajabidosona.<verse eid="SNG 3:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 3:8" />Enti ubbay mashsha oythan meezetidosona;</para>
  <para style="q2" vid="SNG 3:8">olanka paacetidosona.</para>
  <para style="q1" vid="SNG 3:8">Qamma gakiya metuwa teqanaw,</para>
  <para style="q2" vid="SNG 3:8">enti mashshe dancidi giigidosona.<verse eid="SNG 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 3:9" />Kawa Solomoney para gaare giddon,</para>
  <para style="q2" vid="SNG 3:9">baw uttiya araata giigisis;</para>
  <para style="q2" vid="SNG 3:9">iya araatay Libaanosepe yida mithan oosetis.<verse eid="SNG 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 3:10" />Araata tuussay biran lanxetis;</para>
  <para style="q2" vid="SNG 3:10">zempoy worqan alleeqetis.</para>
  <para style="q1" vid="SNG 3:10">Oydey ocha teera daaniya qacinan kametis;</para>
  <para style="q2" vid="SNG 3:10">gaathay Yerusalaame geela7ota siiqon alleeqetis.<verse eid="SNG 3:10" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 3:11" />Hinteno, Xiyoone geela7oto,</para>
  <para style="q2" vid="SNG 3:11">kawa Solomone be7anaw haayite.</para>
  <para style="q1" vid="SNG 3:11">I daro ufaytida iya yaaganuwa gallas</para>
  <para style="q2" vid="SNG 3:11">iya aayiya iya huuphen wothida kallacha wothis.<verse eid="SNG 3:11" /></para>
  <chapter eid="SNG 3" />
  <chapter number="4" style="c" sid="SNG 4" />
  <para style="s1">Panthaa</para>
  <para style="p">
    <verse number="1" style="v" sid="SNG 4:1" />Ta siiqe, neeni waana lo77ay!</para>
  <para style="q2" vid="SNG 4:1">Neeni waanida yegelsse!</para>
  <para style="q1" vid="SNG 4:1">Ne ayfeti guulunthaa giddora be7iya wode,</para>
  <para style="q2" vid="SNG 4:1">holleda lo77oosona.</para>
  <para style="q1" vid="SNG 4:1">Ne binaanay Galada zumaape</para>
  <para style="q2" vid="SNG 4:1">wodhiya deesha wude daanees.<verse eid="SNG 4:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 4:2" />Ne achay meedetidi haathan meecetida,</para>
  <para style="q2" vid="SNG 4:2">ubbay mente yeliya,</para>
  <para style="q2" vid="SNG 4:2">enta giddon awucayey bayna dorsa wude mela.<verse eid="SNG 4:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 4:3" />Ne mettershay zo7o qacina daanees;</para>
  <para style="q2" vid="SNG 4:3">ne haasaya wode daro ufaysoosona.</para>
  <para style="q1" vid="SNG 4:3">Ne nam7u shakalay guulunthaa giddora xeelliya wode,</para>
  <para style="q2" vid="SNG 4:3">nam7a kessidi phalqida oromaane daanosona.<verse eid="SNG 4:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 4:4" />Ne qoodhey loythi oothida,</para>
  <para style="q2" vid="SNG 4:4">iya bolla olanchota gondalley de7iya,</para>
  <para style="q2" vid="SNG 4:4">mukulu mino olanchota gondalley kaqetida,</para>
  <para style="q2" vid="SNG 4:4">Dawita adussa gimbiya daanees.<verse eid="SNG 4:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 4:5" />Ne nam7u dhanthati mente yeletida,</para>
  <para style="q2" vid="SNG 4:5">lo77o ciishshata giddon</para>
  <para style="q2" vid="SNG 4:5">miya woshi7e marata daanosona.<verse eid="SNG 4:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 4:6" />Sa7i geeyanaape sinthe,</para>
  <para style="q2" vid="SNG 4:6">dhumay kichanaape sinthe,</para>
  <para style="q2" vid="SNG 4:6">karbe deriyanne ixaane zuma bada shempana.<verse eid="SNG 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 4:7" />Ta siiqe, ne asatethay kumethi lo77o;</para>
  <para style="q2" vid="SNG 4:7">nenan boretiyabay baawa.<verse eid="SNG 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 4:8" />Ta mushurate, Libaanosepe haaya;</para>
  <para style="q2" vid="SNG 4:8">Gaammoy pee7iya, maahey aqiya,</para>
  <para style="q1" vid="SNG 4:8">Amaana zumaape, Sanira liiphepe</para>
  <para style="q2" vid="SNG 4:8">Armoona huuphiyape wodha.<verse eid="SNG 4:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 4:9" />Ta siiqe, micho gidida ta mushurate;</para>
  <para style="q2" vid="SNG 4:9">ne ayfiya xeeloynne ne qoodhiya alleeqoy,</para>
  <para style="q2" vid="SNG 4:9">ta wozanaa ufaysan gooshshis.<verse eid="SNG 4:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 4:10" />Ta siiqo micho gidida ta mushurate!</para>
  <para style="q2" vid="SNG 4:10">Ne siiqoy tana waani ufaysi!</para>
  <para style="q1" vid="SNG 4:10">Ne siiqoy woyne ushshafe aadhidi ufaysees;</para>
  <para style="q2" vid="SNG 4:10">ne shittoy ubbaafe aadhidi sawees.<verse eid="SNG 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 4:11" />Ta mushurate, ne mettershafe ililo eessi xokees;</para>
  <para style="q2" vid="SNG 4:11">Ne doonape eessinne maathi pultees;</para>
  <para style="q2" vid="SNG 4:11">ne ma7oy Libaanose shittoda sawees.<verse eid="SNG 4:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 4:12" />Ta siiqo micho gidida ta mushurate,</para>
  <para style="q2" vid="SNG 4:12">ne yuushoy diretidi naagetiya atakilte bessa mela;</para>
  <para style="q2" vid="SNG 4:12">ne haratas gordetida, taw dooyetida pulto mela.<verse eid="SNG 4:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 4:13" />Neeni atakilte giddon,</para>
  <para style="q2" vid="SNG 4:13">oromaaney, dooretida atakilte ayfeti,</para>
  <para style="q2" vid="SNG 4:13">nardoose geetetiya ayfeti de7iya bessa mela.<verse eid="SNG 4:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 4:14" />Nardoosey, laadey, sawiya maati, qarafin,</para>
  <para style="q2" vid="SNG 4:14">ixaanada sawiyabati de7oosona.</para>
  <para style="q1" vid="SNG 4:14">Karbey, godare uutha ciishshinne</para>
  <para style="q2" vid="SNG 4:14">dumma dumma qimame atakilteti doloosona.<verse eid="SNG 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 4:15" />Neeni atakilte bessa ushshiya pulto mela;</para>
  <para style="q2" vid="SNG 4:15">de7o haathi bentiya olla mela;</para>
  <para style="q2" vid="SNG 4:15">Libaanose zumaape goggiya shaafa mela.<verse eid="SNG 4:15" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 4:16" />Pudeha bagga carkuwaw, denda!</para>
  <para style="q2" vid="SNG 4:16">dugeha bagga carkuwaw, haaya!</para>
  <para style="q1" vid="SNG 4:16">Ta atakiltiya bolla carka!</para>
  <para style="q2" vid="SNG 4:16">iya sawoy tonku go.</para>
  <para style="q1" vid="SNG 4:16">Ta siiqoy ba atakiltiya giddo yo;</para>
  <para style="q2" vid="SNG 4:16">daro mal7iya ayfeta mo.<verse eid="SNG 4:16" /></para>
  <chapter eid="SNG 4" />
  <chapter number="5" style="c" sid="SNG 5" />
  <para style="s1">Panthaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 5:1" />Ta miche, ta mushurate,</para>
  <para style="q2" vid="SNG 5:1">taani ta atakiltiya giddo gelas.</para>
  <para style="q1" vid="SNG 5:1">Ta karbiyanne ta shitto ciishsha qoras;</para>
  <para style="q2" vid="SNG 5:1">taani eessa uythi mas;</para>
  <para style="q2" vid="SNG 5:1">ta woyniyanne ta maatha uyas.</para>
  <para style="b" vid="SNG 5:1" />
  <para style="s1" vid="SNG 5:1">Yerusalaame Geela7ota</para>
  <para style="b" vid="SNG 5:1" />
  <para style="q1" vid="SNG 5:1">Iya laggeto, miite uyite;</para>
  <para style="q2" vid="SNG 5:1">siiqo alana gakanaw uyite.<verse eid="SNG 5:1" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="SNG 5:2" />Taani dhiskas; shin ta wozanay barkis;</para>
  <para style="q2" vid="SNG 5:2">ta siiqoy haysada yaagidi pengiya qonkishin si7as.</para>
  <para style="q1" vid="SNG 5:2">“Ta miche, ta siiqe, ta yegelsse;</para>
  <para style="q2" vid="SNG 5:2">borey bayna ta holle,</para>
  <para style="q2" vid="SNG 5:2">taw pengiya dooya.</para>
  <para style="q1" vid="SNG 5:2">Ta huuphey akan laakis;</para>
  <para style="q2" vid="SNG 5:2">ta binaanay qamma puusen irxis.”<verse eid="SNG 5:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 5:3" />Ta ma7uwa qaaras, zaarada ma7oyee?</para>
  <para style="q2" vid="SNG 5:3">Ta tohuwa meecetas, zaarada qitayoyee?<verse eid="SNG 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 5:4" />Ta siiqoy ibitha xoo7era ba kushiya soo yeddis;</para>
  <para style="q2" vid="SNG 5:4">ta wozanay iya gisho seellees.<verse eid="SNG 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 5:5" />Ta siiquwas dooyanaw dendas;</para>
  <para style="q2" vid="SNG 5:5">pengiya dooyanaw kobiya oykiya wode,</para>
  <para style="q2" vid="SNG 5:5">ta kushiyape karbey,</para>
  <para style="q2" vid="SNG 5:5">ta biradhiyafe shittoy xokees.<verse eid="SNG 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 5:6" />Ta siiquwas kariya dooyas, shin I deenna;</para>
  <para style="q2" vid="SNG 5:6">iya qaala si7anaw daro amottas.</para>
  <para style="q1" vid="SNG 5:6">Minthada koyas, shin iya demmabike;</para>
  <para style="q2" vid="SNG 5:6">xeegas, shin taw koybeenna.<verse eid="SNG 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 5:7" />Katamaa naageysati tana demmidi,</para>
  <para style="q2" vid="SNG 5:7">wadhidosona; madunxisidosona.</para>
  <para style="q1" vid="SNG 5:7">Katamaa dirsaa naageysati,</para>
  <para style="q2" vid="SNG 5:7">ta laxana qaari ekidosona.<verse eid="SNG 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 5:8" />Hinteno, Yerusalaame geela7oto,</para>
  <para style="q2" vid="SNG 5:8">ta siiquwa demmiko,</para>
  <para style="q2" vid="SNG 5:8">taani iya siiquwan hargidaysa,</para>
  <para style="q2" vid="SNG 5:8">hadara iyaw odite.<verse eid="SNG 5:8" /></para>
  <para style="s1">Yerusalaame Geela7ota</para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 5:9" />Neno, maccasa ubbaafe lo77iyara,</para>
  <para style="q2" vid="SNG 5:9">ne laggey haratape waanidi dummatii?</para>
  <para style="q1" vid="SNG 5:9">Neeni nuna hadara gey,</para>
  <para style="q2" vid="SNG 5:9">I haratape aybin dummatii?<verse eid="SNG 5:9" /></para>
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 5:10" />Ta siiqoy mala lo77onne ayanta;</para>
  <para style="q2" vid="SNG 5:10">tammu mukulu addeta giddon iya meli baawa.<verse eid="SNG 5:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 5:11" />Iya huuphey al7o worqa daanees;</para>
  <para style="q2" vid="SNG 5:11">iya binaanay lo77onne quuro mela kareethi.<verse eid="SNG 5:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 5:12" />Iya ayfey shaafa matan eqida,</para>
  <para style="q2" vid="SNG 5:12">maathan meecetida holleta daanees.<verse eid="SNG 5:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 5:13" />Iya shakalay sawiya qimamey toketida madabeda lo77ees;</para>
  <para style="q2" vid="SNG 5:13">iya mettershay karbe shittoy xokiya wora ciishshada lo77ees.<verse eid="SNG 5:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 5:14" />Iya qesey al7o shuchan alleeqetida worqa xam7ada lo77ees;</para>
  <para style="q2" vid="SNG 5:14">iya asatethay sanpare al7o shuchan alleeqetida dangarsa zaale mela.<verse eid="SNG 5:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="SNG 5:15" />Iya tohoti worqa baason eqida salo shucha tuussi daanosona;</para>
  <para style="q2" vid="SNG 5:15">iya malay zigan alleeqetida Libaanose zuma mela.<verse eid="SNG 5:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="SNG 5:16" />Iya doonay eessada mal7ees;</para>
  <para style="q2" vid="SNG 5:16">iya kumetha asatethay lo77ees.</para>
  <para style="q1" vid="SNG 5:16">Hinteno Yerusalaame geela7oto,</para>
  <para style="q2" vid="SNG 5:16">ta siiqoynne ta laggey haysa daannes.<verse eid="SNG 5:16" /></para>
  <chapter eid="SNG 5" />
  <chapter number="6" style="c" sid="SNG 6" />
  <para style="s1">Yerusalaame Geela7ota</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 6:1" />Maccasa ubbaafe lo77iyare, ne laggey awu bidee?</para>
  <para style="q2" vid="SNG 6:1">Nu neera koyana mela I bida gina nuus oda.<verse eid="SNG 6:1" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 6:2" />Ta siiqoy dorsa wude heemmanaw,</para>
  <para style="q2" vid="SNG 6:2">lo77o ciishsha shiishanaw,</para>
  <para style="q2" vid="SNG 6:2">shitto maatay de7iya atakiltiya giddo bis.<verse eid="SNG 6:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 6:3" />Taani ta siiquwaba; ta siiqoy tabaa;</para>
  <para style="q2" vid="SNG 6:3">I ciishsha giddon wude heemmees.<verse eid="SNG 6:3" /></para>
  <para style="b" />
  <para style="s1">Panthaa</para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 6:4" />Ta siiqe, ne Tirsa katameeda lo77aasa;</para>
  <para style="q2" vid="SNG 6:4">Yerusalaameda daro lo77aasa.</para>
  <para style="q1" vid="SNG 6:4">Bandira oykidi salpiya,</para>
  <para style="q2" vid="SNG 6:4">olanchoda yashshaasa.<verse eid="SNG 6:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 6:5" />Enti tana un7ethida gisho,</para>
  <para style="q2" vid="SNG 6:5">hayyana ne ayfiya taape dentha.</para>
  <para style="q1" vid="SNG 6:5">Ne binaanay Galada zumaape wodhiya,</para>
  <para style="q2" vid="SNG 6:5">deesha wude daanees.<verse eid="SNG 6:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 6:6" />Ne achay meecetidi keyiya,</para>
  <para style="q2" vid="SNG 6:6">ubbay mente yeliya,</para>
  <para style="q2" vid="SNG 6:6">enta giddon awucayey bayna dorsa wude mela.<verse eid="SNG 6:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 6:7" />Ne nam7u shakalay guulunthaa giddora xeelliya wode,</para>
  <para style="q2" vid="SNG 6:7">nam7u kessidi phalqida oromaane daanosona.<verse eid="SNG 6:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 6:8" />Usupun tammu macca kawoti,</para>
  <para style="q2" vid="SNG 6:8">hospun tammu laggethoti,</para>
  <para style="q2" vid="SNG 6:8">tayboy bayna geela7oti de7oosona.<verse eid="SNG 6:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 6:9" />Shin borey bayna ta holliya taw dumma;</para>
  <para style="q2" vid="SNG 6:9">iya ba aayes issinno.</para>
  <para style="q1" vid="SNG 6:9">Iyo yelida aayiya ubbaafe aathada iyo dosawusu;</para>
  <para style="q2" vid="SNG 6:9">Geela7oti iyo be7idi, “Hanna anjetidaaro” yaagosona;</para>
  <para style="q2" vid="SNG 6:9">macca kawotinne laggethoti iyo sabboosona.<verse eid="SNG 6:9" /></para>
  <para style="b" />
  <para style="s1">Yerusalaame Geela7ota</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 6:10" />Hanna wonta xalqeda doliyara,</para>
  <para style="q2" vid="SNG 6:10">ageenada poo7iyara, xalqeda caddiyara,</para>
  <para style="q2" vid="SNG 6:10">bandira oykidi salpe keyida,</para>
  <para style="q2" vid="SNG 6:10">olanchoda yashshiyara hanna oonee?<verse eid="SNG 6:10" /></para>
  <para style="b" />
  <para style="s1">Panthaa</para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 6:11" />Taani zangaaran toketida mithata be7anaw,</para>
  <para style="q2" vid="SNG 6:11">woyney aacidako oromaaney ayfidaako xeellanaw,</para>
  <para style="q2" vid="SNG 6:11">duge ocholone gade wodhas.<verse eid="SNG 6:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 6:12" />Ta qoponna de7ishin ta amoy tana efidi,</para>
  <para style="q2" vid="SNG 6:12">kawa asaa para gaareta giddon tana utisis.<verse eid="SNG 6:12" /></para>
  <para style="b" />
  <para style="s1">Yerusalaame Geela7ota</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 6:13" />Neno Sulaamape yidaare, haaya; haa simma;</para>
  <para style="q2" vid="SNG 6:13">Nu nena loythidi xeellana mela haa simma.</para>
  <para style="b" vid="SNG 6:13" />
  <para style="s1" vid="SNG 6:13">Geela7iw</para>
  <para style="q1" vid="SNG 6:13">Daro asaa sinthan yexiya asada,</para>
  <para style="q2" vid="SNG 6:13">tana ayis xeelleetii?<verse eid="SNG 6:13" /></para>
  <chapter eid="SNG 6" />
  <chapter number="7" style="c" sid="SNG 7" />
  <para style="s1">Panthaa</para>
  <para style="q1">
    <verse number="1" style="v" sid="SNG 7:1" />Kawo na7ada lo77iyare,</para>
  <para style="q2" vid="SNG 7:1">Laxana caamma aathida ne tohoti waani lo77i!</para>
  <para style="q1" vid="SNG 7:1">Ne sheechey hiillanchoy qoxidi,</para>
  <para style="q2" vid="SNG 7:1">alleeqisida al7o shuchu daanees.<verse eid="SNG 7:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 7:2" />Ne gul7ay woyney kumida birille daanees;</para>
  <para style="q2" vid="SNG 7:2">ne xeessa yuushoy ciishshan qashetida giste mirqe daanees.<verse eid="SNG 7:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 7:3" />Ne dhanthati mente yeletida,</para>
  <para style="q2" vid="SNG 7:3">gen7e mari daanosona.<verse eid="SNG 7:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 7:4" />Ne qoodhey dangarsa zaalen</para>
  <para style="q2" vid="SNG 7:4">alleeqetida adussa shako mela.</para>
  <para style="q1" vid="SNG 7:4">Ne ayfey gita Haseboona katama pengiya matan,</para>
  <para style="q2" vid="SNG 7:4">de7iya zeero haatha daanees.</para>
  <para style="q1" vid="SNG 7:4">Ne siidhey Damasqoko zaaridi gimbida,</para>
  <para style="q2" vid="SNG 7:4">Libaanose gimbiya daanees.<verse eid="SNG 7:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 7:5" />Ne huuphey Qarmeloosa zuma daanees;</para>
  <para style="q2" vid="SNG 7:5">ne binaanay qacina xaathi daanees;</para>
  <para style="q2" vid="SNG 7:5">ne huuphiya dathay kawa ufaysees.<verse eid="SNG 7:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 7:6" />Ta siiqe, ne waanna lo77ay!</para>
  <para style="q2" vid="SNG 7:6">Ne waanida yegelsse!</para>
  <para style="q2" vid="SNG 7:6">Ne siiqoy tana waani ufaysi!<verse eid="SNG 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 7:7" />Ne geesay zamba daanees;</para>
  <para style="q2" vid="SNG 7:7">ne dhanthay zamba mor77e daanees.<verse eid="SNG 7:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 7:8" />Taani, “Zamba bolla keyana;</para>
  <para style="q2" vid="SNG 7:8">iya ayfiya maxana” yaagas.</para>
  <para style="q1" vid="SNG 7:8">Ne dhanthay woyne mor7e mela;</para>
  <para style="q2" vid="SNG 7:8">ne siidhiyara keya peenoy apileda sawees.<verse eid="SNG 7:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 7:9" />Ne doonape keyiya peenoy</para>
  <para style="q2" vid="SNG 7:9">lo77o woyne mela.</para>
  <para style="b" vid="SNG 7:9" />
  <para style="s1" vid="SNG 7:9">Geela7iw</para>
  <para style="q1" vid="SNG 7:9">Hiza lo77iya woyne ushshay,</para>
  <para style="q2" vid="SNG 7:9">ne siiqe mettershafenne achafe giddora,</para>
  <para style="q2" vid="SNG 7:9">lepi gidi goggo.<verse eid="SNG 7:9" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="10" style="v" sid="SNG 7:10" />Taani ta siiquwaba; ika tana amottees.<verse eid="SNG 7:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 7:11" />Ta siiquwaw, haaya;</para>
  <para style="q2" vid="SNG 7:11">katamaape keyidi gaxare boos;</para>
  <para style="q2" vid="SNG 7:11">nam7ay qamma yan aathana.<verse eid="SNG 7:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 7:12" />Wonta guura woyne atakiltiya giddo boos;</para>
  <para style="q2" vid="SNG 7:12">woyney ciiyidaako, ayfe aathidako,</para>
  <para style="q2" vid="SNG 7:12">oromaaney ayfidaako ane be7oos.</para>
  <para style="q1" vid="SNG 7:12">Taani ta siiquwa nena yan bessaana.<verse eid="SNG 7:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 7:13" />Inkoye ayfe sawoynne</para>
  <para style="q2" vid="SNG 7:13">dumma dumma ufaysiya atakilte ayfey</para>
  <para style="q2" vid="SNG 7:13">nu karen kumis.</para>
  <para style="q1" vid="SNG 7:13">Ta siiquwaw! Ha ayfetape teeridaysanne</para>
  <para style="q2" vid="SNG 7:13">oorathi maxidaysa new wothas.<verse eid="SNG 7:13" /></para>
  <chapter eid="SNG 7" />
  <chapter number="8" style="c" sid="SNG 8" />
  <para style="p">
    <verse number="1" style="v" sid="SNG 8:1" />Ne taw ta aaye dhanthi dhammida</para>
  <para style="q2" vid="SNG 8:1">ta isha gididaako aybe!</para>
  <para style="q1" vid="SNG 8:1">Ta nena ogen demmada yeeridaako,</para>
  <para style="q2" vid="SNG 8:1">tana oonika borennashin.<verse eid="SNG 8:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="SNG 8:2" />Taani nena kaalethada,</para>
  <para style="q2" vid="SNG 8:2">tana tamaarsida ta aaye soo gelsarkinashin.</para>
  <para style="q1" vid="SNG 8:2">Mal7iya Oromaane gum7ethaanne</para>
  <para style="q2" vid="SNG 8:2">lo77iya woyne ushsha ta nena yan ushsharkina.<verse eid="SNG 8:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="SNG 8:3" />Tana ne haddirsa kushey borkotisees,</para>
  <para style="q2" vid="SNG 8:3">ne ushacha kushey tana qoommes.<verse eid="SNG 8:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="SNG 8:4" />Hinteno, Yerusalaame geela7oto,</para>
  <para style="q2" vid="SNG 8:4">ta siiqoy ba wode dendana gakanaw,</para>
  <para style="q2" vid="SNG 8:4">koyrottidi hinte iya denthonaada hadara gayis.<verse eid="SNG 8:4" /></para>
  <para style="b" />
  <para style="s1">Yerusalaame Geela7ota</para>
  <para style="q1">
    <verse number="5" style="v" sid="SNG 8:5" />Ba siiquwa hashen zempada,</para>
  <para style="q2" vid="SNG 8:5">mela biittafe yaara hanna oonee?</para>
  <para style="b" vid="SNG 8:5" />
  <para style="s1" vid="SNG 8:5">Geela7iw</para>
  <para style="b" vid="SNG 8:5" />
  <para style="q1" vid="SNG 8:5">Beni ne aayiya nena iqetada yelida,</para>
  <para style="q2" vid="SNG 8:5">apile mithaa garsan ne zin7idashin,</para>
  <para style="q2" vid="SNG 8:5">nena ta barkisas.<verse eid="SNG 8:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="SNG 8:6" />Merina siiquwan tana ne wozanan attama;</para>
  <para style="q2" vid="SNG 8:6">ne qesiyan maatameda ta xalaala oyka.</para>
  <para style="q1" vid="SNG 8:6">Siiqoy hayqo mela mino;</para>
  <para style="q2" vid="SNG 8:6">qanaatey si7oole mela iita;</para>
  <para style="q2" vid="SNG 8:6">iya lacoy Xoossaa tama laco mela.<verse eid="SNG 8:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="SNG 8:7" />Daro haathi siiqo tama toysanaw danda7enna;</para>
  <para style="q2" vid="SNG 8:7">di7oyka meeccidi efanaw danda7enna.</para>
  <para style="q1" vid="SNG 8:7">Asi siiqo shammanaw baw de7iya ubbaa immikoka,</para>
  <para style="q2" vid="SNG 8:7">siiqoy miishen shametonna gisho, asi iya kadhees.<verse eid="SNG 8:7" /></para>
  <para style="b" />
  <para style="s1">Geela7e Ishata</para>
  <para style="q1">
    <verse number="8" style="v" sid="SNG 8:8" />Dhanthi tiran uttiboona micha nuus de7awusu;</para>
  <para style="q2" vid="SNG 8:8">azini iyo oychiko, nu iw ay oothanee?<verse eid="SNG 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="SNG 8:9" />Iya gimbe dirsi gidiyako,</para>
  <para style="q2" vid="SNG 8:9">nuuni I bolla adussa bira gimbe gimbana;</para>
  <para style="q2" vid="SNG 8:9">iya dirsa penge gidiyako ziga ibithe medhana.<verse eid="SNG 8:9" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="p">
    <verse number="10" style="v" sid="SNG 8:10" />Taani dirsa gimbe;</para>
  <para style="q2" vid="SNG 8:10">ta dhanthay gimbe bolla de7iya shako mela;</para>
  <para style="q2" vid="SNG 8:10">taani ta siiquwara de7iya wode I tanan ufaytees.<verse eid="SNG 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="SNG 8:11" />Solomones Ba7aal-Hamoonan woyne gadey de7ees;</para>
  <para style="q2" vid="SNG 8:11">he woyne gadiya une ootheysatas immis.</para>
  <para style="q1" vid="SNG 8:11">Kera ekidaysati ayfiya gisho,</para>
  <para style="q2" vid="SNG 8:11">issoy issoy mukulu bira iyaw ehoosona.<verse eid="SNG 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="SNG 8:12" />Shin taw ta buzo woyne gadey de7ees;</para>
  <para style="q2" vid="SNG 8:12">Solomone, neeni mukulu bira eka;</para>
  <para style="q2" vid="SNG 8:12">une ekidi ootheysati nam7u xeetu bira eko.<verse eid="SNG 8:12" /></para>
  <para style="b" />
  <para style="s1">Panthaa</para>
  <para style="q1">
    <verse number="13" style="v" sid="SNG 8:13" />Neno, atakiltiya giddon de7iya ta siiqe,</para>
  <para style="q2" vid="SNG 8:13">ne laggeti ne qaala si7anaw koyoosona;</para>
  <para style="q2" vid="SNG 8:13">ne qaala tanaka sissa.<verse eid="SNG 8:13" /></para>
  <para style="b" />
  <para style="s1">Geela7iw</para>
  <para style="q1">
    <verse number="14" style="v" sid="SNG 8:14" />Ta siiquwaw, taako elle ya!</para>
  <para style="q2" vid="SNG 8:14">shitto maatay doliya dereta bollara,</para>
  <para style="q2" vid="SNG 8:14">gupiya gen7e woyko woshi7e marada hana.<verse eid="SNG 8:14" /></para>
  <chapter eid="SNG 8" />
</usx>