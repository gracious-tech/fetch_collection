<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Galatiya Kiita</para>
  <para style="toc1">Galatiya Kiita</para>
  <para style="toc3">Gala</para>
  <para style="toc2">Galatiya</para>
  <para style="mt1">Phawuloosi Galatiya Asaas</para>
  <para style="mt2">Xaafida Kiita</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Galatiyan de7iya woosa keethas xaafetida kiitan, Phawuloosi tuma hawaare gideysanne iya kiitayka tuma gideysa, ba kiita nabbabiya asay akeekana mela qofisees (<char style="xt"><ref loc="GAL 1:1-10">1:1-10</ref></char>). I hessa giday, issi issi asay “Phawuloosi wordo hawaare qassi iya kiitayka wordo” gidi odetiya gishosa. Phawuloosi, Ayhude gidonna asaas wongela sabbakana mela xeegetida tuma hawaare (<char style="xt"><ref loc="GAL 1:18-2:10">1:18—2:10</ref></char>).</para>
  <para style="ip">Oonika Yesuusa ammanida wode ooratha de7o demmis; hessa gisho, Muse higge naaganaw koshshenna. Phawuloosi, “Asi Xoossa sinthan xillanaw danda7ey ammano xalaalan” yaagidi tamaarsis. Shin Guutha Iisen, Galatiya biittan de7iya woosa keethan, “Asi Xoossa sinthan xillanaw Yesuusa ammano xalaala gidonashin, Muse higgeka naaganaw koshshees” yaagidi Phawuloosa timirtiya phalqiya asati dendidosona.</para>
  <para style="ip">Phawuloosi Galatiya kiita xaafiday, ha wordo timirtiyan cimetida asaa tuma ammanokonne ammano de7oko zaaranaasa. Phawuloosi Yesuusa hawaare gideysa tillayidi odis. Iya hawaare oothidi xeegiday ase gidonashin, Xoosse gideysanne I kiitetiday Ayhude gidonna asas gideysa qoncisidi odis.</para>
  <para style="ip">Merina de7o ekanaw qulpey ammano xalaala. Hessas leemiso gidey, Abrahaamey xilliday ammanonape attishin, ooson woyko higge naagon gidonaysa entaw marka oothidi immees. Ammanoy iyaw aybeko Phawuloosi odishe, “Taani Xoossas daana mela higge baggara higges hayqas. Taani Kiristoosara masqaliya bolla kaqetas. Taani hizape taw de7ike, shin Kiristoosi tanan de7ees. Taani ha77i de7iya de7uwa, tana dosidi ta gisho bana aathidi immida Xoossa Na7aa ammanada de7ayis” (<char style="xt"><ref loc="GAL 2:19-20">2:19-20</ref></char>).</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Gelo qofa <char style="ior">(<ref loc="GAL 1:1-10">1:1-10</ref>)</char></para>
  <para style="io1">Phawuloosi hawaaretethas dooretis <char style="ior">(<ref loc="GAL 1:11-24">1:11-24</ref>)</char></para>
  <para style="io1">Phawuloosi ba kiittas mootetees <char style="ior">(<ref loc="GAL 2:1-21">2:1-21</ref>)</char></para>
  <para style="io1">Atotethas ogey ammano xalaala <char style="ior">(<ref loc="GAL 3:1-4:31">3:1—4:31</ref>)</char></para>
  <para style="io1">Geeshsha Ayyaananinne siiqon de7ite <char style="ior">(<ref loc="GAL 5:1-6:10">5:1—6:10</ref>)</char></para>
  <para style="io1">Akeekisonne sarotho <char style="ior">(<ref loc="GAL 6:11-18">6:11-18</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />Asape woyko asa baggara gidonashin, Yesuus Kiristoosapenne iya hayqope denthida Xoossaa Aawape hawaare gidana mela kiitetida ta Phawuloosi, <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />taara de7iya ammaniya ishati ubbay, Galatiyan de7iya woosa keethatas kiitida kiitaa.<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />Xoossay nu Aawaynne nu Godaa Yesuus Kiristoosi hintew aadho keehatethaanne sarotethaa immo.<verse eid="GAL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4" />Ha iita wodiyape nuna ashshanaw, nu Xoossaa, nu Aawa shenen Kiristoosi nu nagara gisho bana aathidi immis. <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />Xoossaas Merinaape merinaa gakanaw bonchoy gido. Amin7i.<verse eid="GAL 1:5" /></para>
  <para style="s1">Tuma Wongelay issino</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />Kiristoosa aadho keehatethan hintena xeegida Xoossaa aggidi, hara Wongelako, hinte ellesidi, waanidi simmidaako tana malaalsees. <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />Hintena balethanawunne Kiristoosa wongela wobbisanaw koyiya guutha asati de7oosonape attishin, tuma Wongelay issino. <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />Shin nuna gidin woyko salo kiitancho gidin nuuni hintew koyro odida Wongelape dummatiya hara Wongela hintew odiyaba gidiko, I baadetidaba gido. <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />Haysafe sinthe nuuni gidaysada ha77ika zaarada gayis. Hinte ekida Wongelape dummatiya Wongela oonika hintew odiko he uray baadetidaba gido.<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />Yaatin, tana asi nashshana mela koyaanayee? Woyko Xoossi nashshana mela koyayna? Woyko ta ase ufaysanaw koyayna? Ta ase ufaysanaw koyaba gidiko, Kiristoosa aylle gidike.<verse eid="GAL 1:10" /></para>
  <para style="s1">Phawuloosa xeegetethaa</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />Ta ishato, ta hintew odida Wongelay asape gidonnaysa hinte erana mela ta koyayis. <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />Taw ha Wongela Yesuusi Kiristoosi qoncisisipe attishin, asape ekabike woyko asi tana tamaarsibeenna.<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />Ta kase Ayhude ammanon de7iya wode waana de7idaako, hinte si7ideta. Ta woosa keethaa qadhey bayna gooddanawunne dhaysanaw baaxetas.<note caller="-" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">Hawa 8:3</ref>; <ref loc="ACT 22:4-5">22:4-5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref>.</char></note> <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" />Ayhude ammano naagon, ta woden de7iya Ayhude ishatape aadhayis. Nu aawata wogaas aadhada mishetayis.<note caller="-" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 22:3">Hawa 22:3</ref>.</char></note><verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />Shin ta buroo ta aaye ulon de7ishin Xoossay tana dooris; ba aadho keehatethan tana xeegis.<note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">Hawa 9:3-6</ref>; <ref loc="ACT 22:6-10">22:6-10</ref>; <ref loc="ACT 26:13-18">26:13-18</ref>.</char></note> <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />Ayhude gidonna asaas Wongela odana mela Xoossay ba Na7aa taw qoncisida wode ta ooderaka zorettabike. <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />Woyko taape sinthe hawaare gididaysatara gahetanaw Yerusalaame babike. Shin ta kasetada Arabe biitta bas; hessafe simmada Damasqo katamaa yas. <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" />Heedzu laythafe guye, Phexroosara gahetanaw Yerusalaame bada iyara tammanne ichashu gallas uttas.<note caller="-" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="ACT 9:26-30">Hawa 9:26-30</ref>.</char></note> <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />Shin Godaa ishaa Yayqoobape attishin, hanko hawaareta be7abike.<verse eid="GAL 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20" />Ta hintew xaafiydaysi wordo gidonnaysa Xoossaa sinthan hintew qoncisayis.<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />Hessafe guye, taani Soore biittanne Kilqiya biitta bas. <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />Yihudan de7iya woosa keethaa asay tana be7idi eribookona. <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />Shin enti, “Kase nuna gooddiya uray, ha77i he I dhaysanaw koyiya ammanuwaba sabbakees” yaageysa si7idosona. <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />Si7ida ubbay ta gaason Xoossaa galatidosona.<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s1">Hawaareti Phawuloosa ekidosona</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />Tammanne oyddu laythafe guye, Barnabaasara zaarada Yerusalaame bas. He wode Tito taara ekada bas.<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="ACT 11:30">Hawa 11:30</ref>; <ref loc="ACT 15:2">15:2</ref>.</char></note> <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />Xoossay taw qoncisida qoncethan yaa bada Ayhude gidonna asaa giddon ta sabbakiya Wongela entaw qoncisas. Kase ta woxida wothaynne ha77ika ta woxiya wothay hada gidonna mela gada kaaletheyisata dumma shiishada entaw odas. <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />Hari attoshin, taara de7iya Titoy Girike asi gidikoka, qaxareto gidi un7ethibookona. <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />Gidoshin, ammaniya ishata daanidi nu giddo gelida issoti issoti I qaxaretana mela koydosona. He asati Kiristoos Yesuusan nuus de7iya la77atetha wochidi be7anaw geeman nu giddo gelidi zaaridi nuna aylle oothanaw koyoosona. <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />Shin tuma Wongelay hintenan minnidi daana mela nuuni hari attoshin, guutha wodeska entaw kushe immibooko.<verse eid="GAL 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6" />Shin halaqa daaniya asata oonatethay taw aykoka gidenna. Xoossay asa som7o be7idi pirdenna. Ha asati ta markatiya Wongela bolla gujidabay baawa.<note caller="-" style="x"><char style="xo" closed="false">2:6 </char><char style="xt" closed="false"><ref loc="DEU 10:17">Zaare 10:17</ref>.</char></note> <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />Shin Phexroosi, Ayhudetas Wongela odana mela Xoossay iyaw hadara immidaysada tawuka Ayhude gidonna asaas Wongela odiya hadara immidaysa enti guyepe be7idosona. <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />Hiza, Phexroosi Ayhudeta hawaare gidana mela oothida Xoossay, taka Ayhude gidonna asaas hawaare gidana mela oothis. <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />Qassi tuussu daanidi bentiya Yayqoobi, Phexroosinne Yohaanisi, taw imetida aadho keehatetha be7ida wode nuura issifidaysa qoncisanaw ta kushiyanne Barnabaasa kushiya oykidosona. Nuuni Ayhude gidonna asaako, qassi enti Ayhude asaako baanaw giigidosona. <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />Enti nuna minthidi hadara giday, nuuni manqotas qopanaysa. Kaseka ta hessa oothanaw amottayis.<verse eid="GAL 2:10" /></para>
  <para style="s1">Phawuloosi Phexroosa timirtiya phalqis</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />Phexroosi Anxooke katamaa yida wode I balida gisho taani iya som7on “Neeni baladasa” gas. <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />Yayqoobi kiitida guutha asay yaanape sinthe I Ayhude gidonna asaara mees, shin enti yidaape guye, “Ayhude gidonna asaape ammanidaysati qaxaretanaw bessees” giya asaas yayyidi entafe shaaketis. <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />Qassi hanko ammanida Ayhudeti Phexroosa hanuwa kaallidosona. Hari attoshin, Barnabaasika iya qofan gooshetis.<verse eid="GAL 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14" />Shin enti Wongela tumatethan suure hemetonnaysa be7ada, Phexroosa asa ubbaa sinthan, “Neeni Ayhude gidashe, Ayhude wogaatho gidonashin, Ayhude gidonna asada de7aasa; yaatin, waanada Ayhude gidonnayisata, ‘Ayhude wogan de7ite gada wolqatay?’ ” yaagas.<verse eid="GAL 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />Nuuni yeletan Ayhude, shin nagarancho gidida Ayhude gidonna asaa mela gidoko. <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" />Shin asi Yesuus Kiristoosa ammanidi xilleesipe attishin, higge naagidi xillonnaysa eroos. Oonika higge naagidi xillonna gisho, nuka higge naagidi gidonashin, Kiristoosan ammanidi xillana mela Kiristoosi Yesuusa ammanida.<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="PSA 143:2">Maz 143:2</ref>; <ref loc="ROM 3:20">Roome 3:20</ref>, <ref loc="ROM 3:22">22</ref>.</char></note><verse eid="GAL 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17" />Nu Ayhudetika Kiristoosa baggara xillanaw koshshees. Hessa gidiko nuka hara asada nagarancho gideysa be7oos. Yaatin, nu nagara oothana mela denthethey Kiristoosa guusseyee? Ubbaka gidenna! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />Hiza, ta laallidaysa zaarada keexiyaba gidiko taani ta huuphen higge mentheysa gideysa qoncisayis. <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />Taani Xoossaas daana mela higge baggara higges hayqas. <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />Taani Kiristoosara masqaliya bolla kaqetas. Taani hizape taw de7ike, shin Kiristoosi tanan de7ees. Ta ha77i de7iya de7oy, tana dosidi ta gisho bana aathidi immida Xoossaa Na7aa ammanada de7ayis. <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />Taani Xoossaa aadho keehatetha hada oothike. Xillotethi asas higge baggara bentiyaba gidiyako, Kiristoosi coo hayqis guussu.<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s1">Xillotethi ammanonna</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />Hinteno, akeeki bayna Galatiya asato, hinte ayfiya sinthan Kiristoosi masqale bolla kaqetida misileda qoncidi bentees. Yaatin, tumaas hinte kiitetonna mela hintena bitiday oonee?<note caller="-" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="DEU 27:26">Zaare 27:26</ref>.</char></note> <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />Ta issiba eranaw koyayis; hinte Geeshsha Ayyaana ekiday higge naagidiye woyko hinte si7ida Wongela ammanidi ekidetii? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />Hinte hessa mela eeyee? Hinte Xoossaa Ayyaanan doomidi, ha77i wolqan polanaw koyeetii? <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />Hinte Wongela gaason daro waayetiday melee? He waaye ubbay coo gididee? <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />Xoossay hintew Geeshsha Ayyaana immeynne hinte giddon malaatata oothey, hinte higge naagida gishoye woyko Wongela si7idi ammanida gisho?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />Ane Abrahaame be7ite, “I Xoossaa ammanis; Xoossay iyaw hessa xillotethi oothidi ekis”<note caller="-" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="GEN 15:6">Medhe 15:6</ref>; <ref loc="ROM 4:3">Roome 4:3</ref>.</char></note> geetetidi xaafetis. <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" />Hiza, ammaneysati Abrahaame nayta gideysa erite.<note caller="-" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 4:16">Roome 4:16</ref>.</char></note> <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />Xoossay Ayhude gidonna asaa ammanon xillisanaysa Geeshsha Maxaafay be7idi, “Kawotetha ubbay nenan anjetana” yaagidi, Wongela Abrahaames kasetidi odis.<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="GEN 12:3">Medhe 12:3</ref>.</char></note> <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />Hessa gisho, ammaniya ubbay ammanida Abrahaamera issife anjetidosona.<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />Higge naagidi xillana giya oonika baadetidaysa. Ayis giiko, Geeshsha Maxaafan, “Higge maxaafan xaafetida ubbaa naagonna oonika baadetidaysa gido” geetetidi xaafetis.<note caller="-" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="DEU 27:26">Zaare 27:26</ref>.</char></note> <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />“Xilloy ammanon daana” geetetidi xaafetida gisho, oonika Xoossaa sinthan higge naagidi xillonnaysi eretidaba.<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="HEB 2:4">Ibra 2:4</ref>.</char></note> <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />Higgey ammanon zempenna. Shin, “Higgiya naagiya oonika higgiyan de7on daana” yaagees.<note caller="-" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="LEV 18:5">Leewe 18:5</ref>.</char></note><verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />“Mitha bolla kaqetidi hayqiya oonika baadetidaysa” geetetidi xaafetida gisho, Kiristoosi nu gisho baadetidaysa gididi, nuna higge baadethafe wozis.<note caller="-" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="DEU 21:23">Zaare 21:23</ref>.</char></note> <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />Xoossay Abrahaames immida anjoy, Yesuus Kiristoosa baggara Ayhude gidonna asaa gakana melanne Xoossay immana gida Geeshsha Ayyaana nuuni ammanon ekana mela hessa oothis.<verse eid="GAL 3:14" /></para>
  <para style="s1">Higgenne Ufaysa Qaala</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />Ta ishato, ta hintew asa de7on meeze gididi de7iyaba leemiso oothada odayis. Asi caaqida caaqoy minnidaape guye, oonika he caaquwa shaaranaw woyko iya bolla haraa gujanaw danda7enna. <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />Xoossay he keeke qaala Abrahaamesinne iya zerethaas immis. Geeshsha Maxaafay, daro asas odiyada, “Ne zerethatas” geenna. Shin issi asas odiyada, “Ne zerethaas” yaagees; ika Kiristoosa.<note caller="-" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="GEN 12:7">Medhe 12:7</ref>.</char></note><verse eid="GAL 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 3:17" />Taani gey haysa; oyddu xeetanne hastamu laythafe guye imetida higgey, koyro Xoossay minthida caaquwa shaaridi ufaysa qaala dhaysanaw danda7enna.<note caller="-" style="x"><char style="xo" closed="false">3:17 </char><char style="xt" closed="false"><ref loc="EXO 12:40">Kessa 12:40</ref>.</char></note> <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" />Xoossay immiya laatay higgen eketiyaba gidiyako Xoossay immida ufaysaa baggara gideysi attees. Shin Xoossay ba aadho keehatethan laata Abrahaames ufaysa qaala baggara immis.<note caller="-" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ROM 4:14">Roome 4:14</ref>.</char></note><verse eid="GAL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />Yaatin, higgey ayis imetidee? Higgey imetiday, Abrahaames ufaysa qaali imetida kochay yaana gakanaw iita oosoy aybeko erisanaasa. Higgey kiitanchota baggara imetidi, giddo gididi sigethiya issi asa baggara ooso bolla pee7is. <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />Giddo gididi sigethiya uray issi asa xalaalas gidenna, shin Xoossay issino.<verse eid="GAL 3:20" /></para>
  <para style="s1">Aylletanne Nayta</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />Yaatin, higgey Xoossaa ufaysa qaalara eqetiyee? Akay, gidenna! Higgey imetiday asas de7o immanaw gidiyako, xillotethi higge baggara bentanashin. <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />Shin Yesuus Kiristoosa ammanin bentiya ufaysa qaalay ammaneysatas imetana mela kumetha alamey nagaras haaretidi de7eysa Geeshsha Maxaafay odees.<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />Shin ammanoy yaanape kase higgey nuna qachi wothis. He ammanoy qoncana gakanaw higgey nu bolla gordi wothis. <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />Hessa gisho, nuuni ammanon xillana mela Kiristoosi yaana gakanaw higgey na7a naagiya asa mela nuna naageysa gidis. <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />Shin ha77i ammanoy yida gisho, higgey hizape guye na7a naagiya asa mela nuna naageysi attis.<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />Hinte ubbay Yesuus Kiristoosa ammanidi Xoossaa nayta gidideta. <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />Kiristoosara issino gidanaw xammaqetida ubbay Kiristoosa ma7oda ma7ideta. <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />Hinte ubbay Kiristoosan issino gidiya gisho, Ayhude asaa giddoninne Girike asaa giddon, aylle giddoninne womaanno giddon, adde giddoninne maccasa giddon dummatethi baawa. <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" />Hiza, hinte Kiristoosaba gidiko hinte Abrahaame zare. Xoossaa ufaysa qaalada hinte laatteyisata.<note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="ROM 4:13">Roome 4:13</ref>.</char></note><verse eid="GAL 3:29" /></para>
  <para style="b" />
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />Ta geysi haysa. Laattey na7aa gidi de7ishe, shalo ubbay iyabaa gidikoka, I ayllefe aykoka dummatenna. <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />Shin iya aaway gida wodey gakanaw I hadara ekidaysata kusheninne naageysata kushen de7ees. <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />Hessadaka, nuuni na7atethan de7iya wode alamiya wogaas aylletidi de7ida. <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />Shin wodey gakida wode Xoossay higgefe garsan, maccasape yeletida ba na7aa kiittis. <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" />I hessa oothiday, higges haaretidi de7eyisata wozanawunne nuna ba nayta oothanaasa.<note caller="-" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="ROM 8:15-17">Roome 8:15-17</ref>.</char></note><verse eid="GAL 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6" />Nu Xoossaa nayta gidiya gisho, “Abbaa, Aawaw” gidi xeegiya ba Na7aa Ayyaana nu wozanaa giddo kiittis. <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />Hessa gisho, hizape neeni Xoossaa na7ape attishin, aylle gidaka. Neeni iya na7a gidiko, Xoossaa laatteysa gidadasa.<verse eid="GAL 4:7" /></para>
  <para style="s1">Phawuloosi Galatiya Asaas Qopees</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />Hinte kase Xoossaa eronna wode xoosse gidonaysatas aylle gididi haaretideta. <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />Shin ha77i hinte Xoossaa erideta; ubbaraka Xoossan eretideta. Yaatin pathonnanne go77onna alame wogatako guye waanidi simmetii? Wodhi eqidi, waanidi entaw aylle gidanaw koyeetii? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />Dumma gidida gallasata, ageenata, wodetanne laythata hinte loythi boncheta. <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />Tana hintebay yashshees; ta hintew coo daaburadinasha?<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />Ta ishato, ta hinteda hanida gisho, hinteka taada hanite gada hintena woossayis. Hinte tana aybinka qohibeeketa. <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />Taani koyro hargetashe hintew Wongela odidaysa hinte ereeta. <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />Ta hargey hintew paace gidikoka, tana saletibeketa; ixibeketa. Shin tana Xoossaa kiitancho woyko Kiristoos Yesuusa mokeysada mokideta.<verse eid="GAL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 4:15" />Yaatin, he hintew de7iya ufaysay ubbay aw bidee? Hintew danda7etidaako, hinte taw, hinte ayfiya kessidi immiyako ixonnaysa ta markatayis. <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />Yaatin, ta hintew tuma odida gisho hintew morke gidadinaayee?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />He asati hintena bantako zaaranaw koyoosona, shin enta qofay lo77osa gidenna. Enta qofay hintena shaakanaasanne hinte entaw qopana mela oothanaasa. <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />Lo77oba oothanaw amotiko lo77o, shin hessi ta hintera de7iya wode xalaala gidonashin ubba wode gido.<verse eid="GAL 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 4:19" />Ta siiqo nayto, Kiristoosi hintenan misiletana gakanaw maccasi yelos iqeteysada ta hinte gisho iqetayis. <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />Hintebay taw haddin ta un7etas; ha77i hinte giddon ta bentada shenetada odiyako ay mela dosaynashin.<verse eid="GAL 4:20" /></para>
  <para style="s1">Aggaaronne Saaro</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />Muse higgen haaretidi daanaw koyeysato, ane taw odite; higgey ay giyako ereketii? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />Geeshsha Maxaafay, “Abrahaames gadhindefenne godatefe yeletida nam7u nayti de7oosona” yaagees.<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="GEN 16:15">Medhe 16:15</ref>; <ref loc="GEN 21:2">21:2</ref>.</char></note> <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />Gadhinde na7ay asi na7a yeliya maaran yeletis, shin godate na7ay Xoossaa ufaysa qaalan yeletis.<verse eid="GAL 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24" />Ha maccasati nam7u caaqotas leemiso gididi eketoosona. Entafe issinniya, Siina zumaape yidaara, ba nayta aylletethas yelasu; iyaka Aggaaro. <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />Aggaara Arabe biittan de7iya Siina zuman leemisetada ha77i de7iya Yerusalaame daanawusu. Ayis giiko, iya ba naytara aylletethan de7awusu. <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />Shin salon de7iya Yerusalaamey aylletethan de7uku; iya nu ubbaas aayo. <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />Geeshsha Maxaafay,</para>
  <para style="q1" vid="GAL 4:27">“Naatte, yelonna maynthete ufayta;</para>
  <para style="q2" vid="GAL 4:27">naate iqeta eronnaare ilila.</para>
  <para style="q1" vid="GAL 4:27">Azinara de7iya maccaseepe,</para>
  <para style="q2" vid="GAL 4:27">azini bayna maccasees nayti daro” yaagees.<note caller="-" style="x"><char style="xo" closed="false">4:27 </char><char style="xt" closed="false"><ref loc="ISA 54:1">Isa 54:1</ref>.</char></note><verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />Ta ishato, hinte Yisaaqada Xoossaa ufaysa qaalan yeletida nayta. <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />Shin he wode asa maarada yeletidaysi, Ayyaana wolqan yeletidaysa goodis. Hachika hessa mela.<note caller="-" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="GEN 21:9">Medhe 21:9</ref>.</char></note> <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />Shin Geeshsha Maxaafay woygii? “Gadhinde na7ay godate na7aara issife laattonna gisho, aylliw I na7aara wolla kessa yedda” yaagees.<note caller="-" style="x"><char style="xo" closed="false">4:30 </char><char style="xt" closed="false"><ref loc="GEN 21:10">Medhe 21:10</ref>.</char></note> <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />Hessa gisho, ta ishato, nuuni godate naytape attishin, gadhinde nayta gidoko.<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s1">Kiristoosan De7iya La77atethi</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />Nuuni la77atethan daana mela Kiristoosi nuna aylletethaafe kessis. Hiza, minnidi eqite; zaaridi aylletetha qambaran gelopite.<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />Ta, Phawuloosi, geysa si7ite. Hinte qaxaretanaw koyko, Kiristoosi hintena aykoka maaddenna. <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />Qaxaretiya oonika higgey kiittiya ubbaa polanaw besseysa gujada ta odayis. <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />Higge naagidi xillanaw koyeysato, Kiristoosape shaaketideta; Xoossaa aadho keehatethaafe kundideta. <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />Shin nuuni Xoossaa Ayyaana baggara ammanon xillanaw ufaysan naagoos. <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />Hiza, Kiristoos Yesuusan de7iko, siiqon qonciya ammanope attishin, qaxaretin, qaxaretonna aggin nuna aykoka maaddenna.<verse eid="GAL 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />Kase hinte lo77o woxeeta, shin ha77i tumaas kiitetonna mela hintena diggiday oonee? <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />Haysa mela iita cimoy hintena xeegida Xoossaafe yibeenna. <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" />Hessika, “Guutha irshoy munuqa ubbaa denthees”<note caller="-" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="2CO 5:6">2 Qoro 5:6</ref>.</char></note> geetetidi xaafetidaysa mela. <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />Hintew hara qofi baynaysas ta Godan ammanetayis. Shin hintena buqiya oonika Xoossafe ba pirdaa ekana.<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />Ta ishato, ta ha77i gakanaw qaxararetethi sabbakiyaba gidiko, yaatin tana ayis gooddona? Hessi tuma gidiyako Kiristoosa masqaliyaba tamaarsoy asas dhube gidennashin. <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />Hintena buqeysati qaxaretetha xalaala gidonashin, bantana qaaratiyakoka ta dosayis.<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />Ta ishato, hinte la77a daanaw xeegetideta. Gidoshin, hinte la77atethay asho amo polanaw hintew gaaso gidopo; hessafe aathidi issoy issuwa siiqon maaddite. <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />Higge ubbay, “Ase needa dosa” giya issi qaalan qashetis.<note caller="-" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="LEV 19:18">Leewe 19:18</ref>.</char></note> <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />Shin hinte issoy issuwara saxetiyabaanne meetetiyabaa gidiko, hinte woli wursonna mela naagetite.<verse eid="GAL 5:15" /></para>
  <para style="s1">Ayyaana De7onne Asho De7o</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />Hiza, ta hintew odayis; Ayyaanan de7ite; hinte asho amuwa polopite. <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" />Asho amoy Ayyaana amuwara morke; qassi Ayyaana amoyka asho amuwara morke. Enti issoy issuwara ixetiya gisho hinte dosiyaba oothanaw danda7eketa.<note caller="-" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ROM 7:15-23">Roome 7:15-23</ref>.</char></note> <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />Shin Ayyaanay hintena kaalethiyaba gidiko higgey hintena haarenna.<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />Asho oosoti eretidaysata; entika, laymatethi, tunatethi, qayxe, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />eeqa goyinno, bita, morketethi, kachi, qanaate, hanqo, bana doso, shaaketethi, iita tobbo <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />gene, matho, yethinne hessa hessa melata. Kase ta hintew odidaysada ha77ika ta hintew odayis. Haysa melabata ootheysati Xoossaa kawotethaa laattokona.<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />Shin Ayyaana ayfey, siiqo, ufaysi, sarotethi, danda7a, keehatethi, lo77otethi, ammano, <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />ashketethi, bana haaro. Haysa melabata ixiya higgey baawa.<verse eid="GAL 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 5:24" />Kiristoos Yesuusaba gididaysati banta ashuwa iya iita qofaranne iya amuwara issife masqaliya bolla kaqidosona. <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />Nu Ayyaanan de7iyaba gidiko, nuna Ayyaanay kaaletho. <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />Ane issoy issuwa yiloyishenne qanaatishe coo ceeqeteysa aggoos.<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s1">Issoy Issuwa Maaddite</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />Ta ishato, issi asi nagaran kundiko, Ayyaanan de7iya hinte he uraa ashketethan suurisite. Shin neeni hessa melaban paacetonna mela nena naaga. <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />Issoy issuwa deexo toohuwa tookite. Yaatiko Kiristoosa higgiya poleeta. <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />Issi asi aykoyka baawashin, bana haratape lo77o gidi qopiko, I bana cimmees. <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />Shin issi issi asi ba oosuwa paaco. Hessafe guye, haratara bana gaaddeyeysa aggidi baw ceeqetiyaba demmees. <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />Issi issi asi ba toohuwa baw tookanaw bessees.<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />Xoossaa qaala tamaariya oonika lo77oba ubbaa ba astamaariyara shaaketees.<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />Hinte, hintena cimmofite. Asi ba zeridabaa zaaridi cakiya gisho Xoossaa bolla qelqisopite. <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />Ba asho amuwa kunthanaw zeriya oonika, ba asho amuwape hayqo buucana. Shin Ayyaana ufaysanaw zeriya oonika Ayyaanape merinaa de7o cakana. <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />Ane lo77o ooso oothanaw azalleysa aggoos. Nuuni azallonna ixiko wodey gakiya wode nu zeridaysa cakana. <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />Nu inje wode demmiko, asa ubbaas, aathidika ammaniya asaas lo77oba oothoos.<verse eid="GAL 6:10" /></para>
  <para style="s1">Zorenne Sarotho</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />Taani ta kushen, ay mela gita pidalen hintew xaafidaako be7ite. <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />Asa sinthan lo77o gididi bentanaw koyiya asati hinte qaxaretana mela koyoosona. Shin hessa enti oothey, Kiristoosa masqaliya gisho entana goodi gakonna melasa. <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />Enti hinte qaxaretethan ceeqetanaw koyidi hintena qaxareto goosonape attishin, qaxaretidaysatika banta huuphen higgiya naagokona.<verse eid="GAL 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 6:14" />Shin alamey taw kaqetidaysafenne taanika alamiyas kaqetida, Godaa Yesuus Kiristoosa masqaliyape attishin, hara ceeqoy taape haako. <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />Hiza, qaxaretin qaxaretonna aggin aykoka maaddenna. Maaddey ooratha medhetethi gido. <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />Ha wogaa kaalliya ubbaasinne Xoossaa dere gidida Isra7eeles sarotethinne maarotethi gido.<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />Taani Yesuusas madunxida beeta ta asatethan tookida gisho, hizape tana oonika waaysopo.<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />Ta ishato, nu Godaa Yesuus Kiristoosa aadho keehatethay hintera gido. Amin7i.<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>