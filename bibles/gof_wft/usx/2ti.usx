<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">2 Ximotiyoosa Kiita</para>
  <para style="toc1">2 Ximotiyoosa Kiita</para>
  <para style="toc3">2 Ximo</para>
  <para style="toc2">2 Ximotiyoosa</para>
  <para style="mt1">Phawuloosi Ximotiyoosas</para>
  <para style="mt2">Xaafida Nam7antho Kiita</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Phawuloosi Ximotiyoosas xaafida nam7antho kiitay, Phawuloosara issife oothiyanne Phawuloosa matan maaddiya na7atetha, Ximotiyoosa zorida zoriya oykis. He zoriya ayfe qofay, “Gencan minnanaw bessees” giya zore. Ximotiyoosi zorenne minthetho qaala ekiday, Yesuus Kiristoosaba tuma markatana mela, wongela qaalanne Gal7a Caaqo timirtiya minthidi oykana melanne metoynne ixoy darikoka tamaarsoninne wongela sabbakon minnana melasa.</para>
  <para style="ip">Ximotiyoosi, hadanne eeyatetha palamape haakana mela iyaw dumma mino zorey imetis. Hessa mela oday ase dhaysesipe attishin aykoka maaddenna.</para>
  <para style="ip">He ubban Ximotiyoosi akeekanaw bessiyabay, Phawuloosa hanotaanne iya duussa; hessika, iya ammanuwa, iya genca, iya siiquwa, iya danda7aanne iya gakida metuwa leemiso oothidi kaallanaysa. Phawuloosi ha kiita xaafiday, I ba wotha ongidi hayqos giigetida wodena.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Gelo qofa <char style="ior">(<ref loc="2TI 1:1-2">1:1-2</ref>)</char></para>
  <para style="io1">Godan yeellatopa <char style="ior">(<ref loc="2TI 1:3-18">1:3-18</ref>)</char></para>
  <para style="io1">Ammanthiya Kiristoosa wotaadare gida <char style="ior">(<ref loc="2TI 2:1-26">2:1-26</ref>)</char></para>
  <para style="io1">Wursetha woden asay ay daanane <char style="ior">(<ref loc="2TI 3:1-9">3:1-9</ref>)</char></para>
  <para style="io1">Ammanetada de7a <char style="ior">(<ref loc="2TI 3:10-4:8">3:10—4:8</ref>)</char></para>
  <para style="io1">Sarothonne anjo <char style="ior">(<ref loc="2TI 4:19-22">4:19-22</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />Xoossaa shenen, Yesuus Kiristoosan bentida de7o ufaysaa markatanaw Yesuus Kiristoosa hawaare gidida Phawuloosape, <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" />ta dosiya na7aa Ximotiyoosas kiitetida kiita.</para>
  <para style="p" vid="2TI 1:2">Xoossaa Aawapenne nu Godaa Kiristoos Yesuusape aadho keehatethay, maarotethaynne sarotethay new gido.<note caller="-" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="ACT 16:1">Hawa 16:1</ref>.</char></note><verse eid="2TI 1:2" /></para>
  <para style="s1">Ximotiyoosas Imetida Zore</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />Taani, ta woosan qammanne gallas nena qopayis. Taani woossiya wode ta mayzata Xoossaanne taani lo77o kahan haggaaziya Xoossaa ne gisho galatayis. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />Taani ne afuthaa qopayis; nena be7ada ufaytanaw daro laamotayis.<verse eid="2TI 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TI 1:5" />Qassi new de7iya tuma ammanuwa erayis. He ammanoy beni ne wogga aaye Loydininne ne aaye Ewuniqin de7iya ammanuwa mela.<note caller="-" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">Hawa 16:1</ref>.</char></note> <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />Hessa gisho, taani ta kushiya ne bolla wothida wode Xoossay new immida imota neeni zaara eethana mela akeekisayis. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />Ayis giiko, Xoossay nuus wolqaa, siiqonne nu huuphe haariya Ayyaana immispe attishin, yashsha ayyaana immibeenna.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />Hiza, nu Godaas markatanaw yeellatopa; qassi iya gisho qashetida tananka yeellatopa. Shin Xoossay new immiya wolqan Wongela gisho, taara meto eka. <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />Xoossay ba sheneninne ba aadho keehatethan nuna ashshidi, ba geeshsha dere oothanaw nuna doorisipe attishin, nuuni oothida oosuwa gisho gidenna. Ha aadho keehatetha Kiristoos Yesuusa baggara merinaa wodetape sinthe nuus immis. <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />Ha77i ha aadho keehatethay nuna ashshiya Kiristoos Yesuusa yuussan qoncis. I hayqo wolqaa dhaysidi, Wongela baggara dhayonna de7o nuus qoncisis.<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />Taani Wongela sabaake, hawaarenne astamaare gidana mela Xoossay tana dooris.<note caller="-" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="1TI 2:7">1 Ximo 2:7</ref>.</char></note> <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />Taani hessa gisho ha metuwa ekayis; shin ta ammaney ooneko eriya gisho yeellatike. Taw imetida hadara he gallasay gakanaw I naaganaw danda7eysa erayis.<verse eid="2TI 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TI 1:13" />Taani nena tamaarsida tuma qaala leemiso ootha oykada Kiristoos Yesuusa baggara nubaa gidida ammanuwaninne siiquwan de7a. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />Nu giddon de7iya Geeshsha Ayyaana wolqan new imetida lo77o hadara naaga.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />Iise biittan de7iya ubbay taape haakidaysa eraasa; enta giddon Figeluusinne Hermogeneesi de7oosona.<verse eid="2TI 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 1:16" />Anesfoori tana daro wode minthethida gisho Goday iya soo asaas qadheto. Taani qasho keethan de7iya wode I tanan yeellatibeenna. <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />Hessa bolla I Roome katamaa yida wode tana minthi koyidi demmis. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />Wursetha gallasan Goday iyaw qadhetana mela taani Godaa woossayis. Efesoona kataman I tana ay mela maaddidaako ne loytha eraasa.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s1">Yesuus Kiristoosan Minna</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />Hiza, ta na7aw, Kiristoos Yesuusan de7iya maarotethan minna. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />Daro markata sinthan taani nena tamaarsida timirtiya, harata tamaarsanaw danda7iya ammanetida asaas hadara imma.<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />Yesuus Kiristoosas ammanthiya wotaadare gidada taara meto eka. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />Ola wotaadarey ba tora mocona ufaysanaw giigeteesipe attishin, hara ooson bana peeshshenna. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />Hessadaka, gaadde woxiya oonika bessiya ogera gaaddetonna ixiko woyto ekenna. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />Goshshan daaburiya goshshanchoy ba daabura ayfiyape miya koyro asi gidanaw bessees. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />Ne akeekana mela Goday nena maaddana gisho, ta new odidaba ne wozanan naaga.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />Taani markatiya Wongela mela hayqope dendida, Dawita koche gidida Yesuus Kiristoosa qopa. <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />Taani wongela odiya gisho, iitabaa oothida asada, qashetada meto ekayis. Shin Xoossaa qaalay qashetenna. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />Hessa gisho, Xoossay doorida asati Kiristoos Yesuusan de7iya atotetha merinaa bonchuwara ekana mela enta gisho ubbaban waayetayis.<verse eid="2TI 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 2:11" />Haysada giya tuma qaali de7ees;</para>
  <para style="q1" vid="2TI 2:11">“Nuuni iyara hayqidaba gidiko,</para>
  <para style="q2" vid="2TI 2:11">Iyara issife de7ana.<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />Nuuni genciko,</para>
  <para style="q2" vid="2TI 2:12">iyara issife kawotana.</para>
  <para style="q1" vid="2TI 2:12">Nuuni iya kaddiko,</para>
  <para style="q2" vid="2TI 2:12">I nuna kaddana.<note caller="-" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="MAT 10:33">Maato 10:33</ref>; <ref loc="LUK 12:9">Luqa 12:9</ref>.</char></note><verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />Nuuni ammanetona ixiko,</para>
  <para style="q2" vid="2TI 2:13">I ammanetidaysa gididi daana.</para>
  <para style="q1" vid="2TI 2:13">Ayis giiko, I bana</para>
  <para style="q2" vid="2TI 2:13">kaddanaw danda7enna” yaagees.<verse eid="2TI 2:13" /></para>
  <para style="s1">Mino Oosancho</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />Neeni enta haysa akeekisa; enti qaalata gaason palamonna mela, Godaa sinthan enta zora. Hessi si7eyisata dhaysesipe attishin, aykoka maaddenna. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />Neeni tuma qaala suuretethan tamaarseysanne yeellayonna oosancho gidada, Xoossay nashshiya asada, nenatethaa iyaw immanaw minna. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />Shin ha alamiyas injetiya go77onna odape baqata. Hessa mela oday ase Xoossaafe haassees. <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />Hessa mela oday asatethi midigiya paxonna woyzazire maduntha mela. Hessa mela odaa odeteyisata giddofe Hemeneyoosinne Filixoosi de7oosona. <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />Ha asati tuma ogiya aggidi, “Hayqida asay hayqope beni dendidosona” yaagidi guutha asata ammanuwa dhaysidosona.<verse eid="2TI 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 2:19" />Gidoshin, Xoossay mino zaalla hiixida gisho qaaxanaw danda7enna. Iya bolla, “Goday ba asaa erees. Godaa sunthaa xeegiya oonika iita oosope haako” giya qaalay xaafetis.<note caller="-" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="NUM 16:5">Taybo 16:5</ref>.</char></note><verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />Issi gita keethan worqafe woyko birape oosetida miisheta xalaala gidonashin, mithafe woyko urqafe oosetida miishetika de7oosona. Hessatape baggati boncho oosos, qassi baggati tooshetiya oosos pee7osona. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />Hessa gisho, oonika iita ubbaa aggikonne bana geeshshiko, boncho ooso oothiya miishe gidana. Enta de7oy geeshshinne Godaa ufaysiyabaa, qassi enti lo77o ooso ubbaa oothanaw danda7eyisata gidana.<verse eid="2TI 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 2:22" />Na7atetha iita amuwape baqata. Geeshsha wozanan Godaa xeegiya asatara issife, xillotethaa, ammanuwa, siiqonne sarotethaa kaalla.<verse eid="2TI 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2TI 2:23" />Shin ooshshi medheysa erada eeyatethinne hada gidida palamape haaka. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />Godaa oosanchoy asa ubbaas keeha, lo77o tamaarseysanne danda7ancho gidanaw besseesipe attishin, ooyetanaw bessenna. <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />I baara eqeteyisata ashketethan seereysa gidanaw bessees. Enti banta nagaraape simmidi tumaa eranaada Xoossay oothaneko ooni eri. <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />Enti banta wozanaako simmidi ba sheniya oothana mela enta oykida Xalahe xihiyape kessi ekana.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s1">Wode Wursetha Malaatata</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />Wursetha gallasan un7ethiya wodey yaanaysa era. <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />Asay bantana doseyisata, miishe siiqeyisata, ceeqeteyisata, otoreyisata, cayeyisata, bantana yelidaysatas kiitetonaysta, galatonaysta, geeshshatethi baynayisata, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />siiqoy baynayisata, maarotethi eronnayisata, zigireyisata, bantana haaronnayisata, wozana minota, lo77o dosonnayisata, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />morkees aathidi immeyisata, qofi baynayisata, otoron sugeteyisata, Xoossaafe aathidi asho ufaysanaw doseyisata gidana. <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />Enti ammaniya daanosonape attishin, ammano wolqaa kaddoosona; neeni hessa mela asatape baqata.<verse eid="2TI 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 3:6" />Entafe issoti issoti asa keethaa gelidi nagaran oyketidaysatanne dumma dumma amon sugetiya daaburancho maccasata bolla godatosoona. <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />He maccasati ubba wode tamaarosonashin, tumaa eranaw danda7okona. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />Yaanesinne Yambareesi Musera eqetidaysada ha asati guuggey oothonaysatanne ammanon kundida asata gidiya gisho tumaara eqetoosona.<note caller="-" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="EXO 7:11">Kessa 7:11</ref>.</char></note> <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />Shin Yaanesanne Yambareesa eeyatethay qoncidaysada enta eeyatethayka asa ubbaa sinthan qoncana gisho entaw hanenna.<verse eid="2TI 3:9" /></para>
  <para style="s1">Wursetha Zore</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />Shin neeni ta timirtiya, ta duussaa, ta qofaa, ta ammanuwa, ta danda7aa, ta siiquwa, ta gencaa, <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" />ta goodetethanne ta metuwa eraasa. Anxooke, Iqoniyoonen, Lisxira katamatan tana gakidabaanne taani danda7ida metuwa eraasa; Goday tana he ubbaafe ashshis.<note caller="-" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">Hawa 13:14-52</ref>; <ref loc="ACT 14:1-20">14:1-20</ref>.</char></note> <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />Kiristoos Yesuusan Xoossaa ufaysiya de7o daanaw koyiya ubbay goodettana. <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />Iita asatinne baletheysati bantaw baletishenne harata balethishe kasepe iiti iiti baana.<verse eid="2TI 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 3:14" />Shin ne tamaarida tumaaninne ne ammanida ammanuwan eqa. Ne oodefe tamaaridaako eraasa. <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />Neeni ne na7atethafe doomada Kiristoosa Yesuusa ammanada, atotethi demmiya cincatethi immanaw danda7iya Geeshsha Maxaafata eradasa. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />Geeshsha Maxaafaa ubbay Xoossaafe imetida qaala. He maxaafay tumaa tamaarsanaw, balidaysata seeranaw, suurisanawunne xillotetha duussas koshshiya zore immanaw maaddees. <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />Xoossaa asi polonne lo77o ooso ubbaa oothanaw giigidaysa gidana mela maaddees.<verse eid="2TI 3:17" /></para>
  <para style="b" />
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />Taani nena Xoossaa sinthaninne, kawo gididi haaranaw qonciya wode paxatanne hayqidaysata pirdanaw de7iya Kiristoos Yesuusa sinthan zorayis. <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />Qaala oda; wodey injetin injetonna ixin minnada oda. Daro danda7aninne tamaarson asaa zora seeranne denthetha. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />Asay tuma timirtiya si7onna ixiya wodey yaana. Enti banta amuwa kaallidi, bantaw si7anaw ufaysiyabaa odiya astamaareta shiishosona. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />Enti tuma timirtiya aggidi, tuma gidonna odaa si7anaw banta haytha zaarosona. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />Shin neeni ubbaban nena haara. Meto danda7a. Wongela markatetha oosuwa ootha. New imetida Xoossaa ooso ubbaa pola.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />Taani yarshetiya wodey gakis; ha alamiya aggada biya wodey matis. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />Taani lo77o ola oletas; ta gaaddiya woxada wursas; ammanuwa naagas. <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />Sinthafe xillotetha kallachay<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="fqa" closed="false">Xillotetha kallachay: </char><char style="ft" closed="false">Xillotetha de7o gisho, ta ekana kallachaa. Xillotethaa taw kallacha oothidi immees guussu.</char></note> tana naagees. Hessa xillo pirdaa pirdiya Goday he gallas taw immana. Hessa ta xalaalas gidonashin, iya qoncethaa amotiya ubbaas immana.<verse eid="2TI 4:8" /></para>
  <para style="s1">Phawuloosa Buzo Qofa</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />Ellesa yada tana be7a. <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" />Deemasi ha77i alamiya dosidi, tana aggidi, Teselonqe katamaa bis. Qerqisi Galatiya biitta, qassi Titoy Dilmaxe biitta bis.<note caller="-" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="COL 4:14">Qola 4:14</ref>; <ref loc="PHM 1:24">Filmo 24</ref>; <ref loc="2CO 8:23">2 Qoro 8:23</ref>; <ref loc="GAL 2:3">Gala 2:3</ref>; <ref loc="TIT 1:4">Tito 1:4</ref>.</char></note> <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" />Luqaasa xalaali taara de7ees. Marqoosi Xoossa ooson tana maaddanaw danda7iya gisho, neera ekada ya.<note caller="-" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="COL 4:14">Qola 4:14</ref>; <ref loc="PHM 1:24">Filmo 24</ref>; <ref loc="ACT 12:12">Hawa 12:12</ref>, <ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">Qola 4:10</ref>.</char></note> <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" />Taani Tikiqoosa Efesoona katama kiittas.<note caller="-" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">Hawa 20:4</ref>; <ref loc="EPH 6:21-22">Efe 6:21-22</ref>; <ref loc="COL 4:7-8">Qola 4:7-8</ref>.</char></note> <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" />Neeni yashe, Xiro7aada kataman Karpoosa matan aggada yida ta kootiyanne maxaafata taw ekada ya. Ubbaka galban xaafetida maxaafata ekonna yoopa.<verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />Birata qoxiya Iskindirey tana daro qohis; Goday iya oosuwada iyaw zaarana.<note caller="-" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="1TI 1:20">1 Ximo 1:20</ref>; <ref loc="PSA 62:12">Maz 62:12</ref>; <ref loc="ROM 2:6">Roome 2:6</ref>.</char></note> <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />I nu timirtiya daro ixiya gisho iyape nena naaga.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />Koyro ta mootetiya wode ubbay aggidi bidosonape attishin, oonika tana maaddibeenna. Xoossay he naaquwa entaw taybopo. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />Shin taani kumetha kiitaa Ayhude gidonna asa ubbaas markatin, enti si7ana mela Goday ta matan eqidi taw wolqa immis. Qassi koshatida gaammoda doona dooyida hayquwape tana ashshis. <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />Goday tana iita ubbaafe ashshidi ba salo kawotetha saron efana. Iyaw merinaape merinaa gakanaw bonchoy gido. Amin7i.<verse eid="2TI 4:18" /></para>
  <para style="s1">Sarotho</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />Phirisqillas, Aqilasinne Anesfoora soo asaas ta sarothuwa oda.<note caller="-" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="ACT 18:2">Hawa 18:2</ref>; <ref loc="2TI 1:16-17">2 Ximo 1:16-17</ref>.</char></note> <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" />Erasxoosi Qorontoosa kataman attis. Xirofmoosi hargetida gisho, Milixe kataman aggas.<note caller="-" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="ACT 19:22">Hawa 19:22</ref>; <ref loc="ROM 16:23">Roome 16:23</ref>; <ref loc="ACT 20:4">Hawa 20:4</ref>; <ref loc="ACT 21:29">21:29</ref>.</char></note> <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />Balgoy gelanaape sinthe ellesada ya.</para>
  <para style="p" vid="2TI 4:21">Ewubulusi, Phudeesi, Linuusi, Qilaadeynne hara ammaniya asati ubbay nena saro goosona.<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />Goday Yesuus Kiristoosi ne ayyaanara gido.</para>
  <para style="p" vid="2TI 4:22">Xoossaa maarotethay hinte ubbaara gido.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>