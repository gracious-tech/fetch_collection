<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Gofa Full Bible Latin Version Final</book>
  <para style="h">Efesoona Kiita</para>
  <para style="toc1">Efesoona Kiita</para>
  <para style="toc3">Efe</para>
  <para style="toc2">Efesoona</para>
  <para style="mt1">Phawuloosi Efesoona Asaas</para>
  <para style="mt2">Xaafida Kiita</para>
  <para style="imt">Gaatha Qofa</para>
  <para style="ip">Phawuloosi Efesoonan de7iya ammaniya asaas xaafida kiitan ubbaafe aathidi bessey, “Wodey gakiya wode Xoossay polanaw qopida qofay, saloninne sa7an de7iya medhetetha ubbay Kiristoosape garsan gidana melasa” giya qofa (<char style="xt"><ref loc="EPH 1:10">1:10</ref></char>). Yesuus Kiristoosara de7iya issifetethan, asa kochi ubbay issino gidana mela ha gita qofa ooson peeshana mela Xoossa asaa akeekisees.</para>
  <para style="ip">Efesoona kiitan, koyro shaahuwan, xaafey kaara qofa gidida issifetethaba xaafanaw doomidaysa dalgisidi, Xoossa Aaway ba asaa waatidi dooridako, entika iya na7aa, Yesuus Kiristoosan banta nagarape maarota demmidi waanidi la77a keydakonne, Xoossa gita ufaysa qaalay Geeshsha Ayyaana baggara tuma gideysi waanidi eretidako odees. Nam7antho shaahuwan qassi, xaafey ha kiita nabbabiya asay, Kiristoosan entaw de7iya issifetethay tuma gidana mela enti waanidi daanaw bessiyako qofisees.</para>
  <para style="ip">Asay Kiristoosan de7iya issifetethan waanidi daanaw bessiyako dumma dumma leemison qoncis. Woosa keethi asatethaa leemiso gidiya wode Kiristoosi he asatethaas huuphe. Woosa keethi gimbe keethan leemisetiya wode Kiristoosi keetha minthiya maazane shuchu. Woosa keethi machin leemisetiya wode Kiristoosi azinan leemisetis. Xaafey Kiristoosa baggara qoncida Xoossa aadho keehatetha daro nashshidi odishe, qofay ciimmo gidida oda odis. Phawuloosi, ubbaba Kiristoosa siiquwa, iya yarshetetha, I immida nagara atotetha, iya aadho keehatethaanne iya geeshshatetha baggara xeellees.</para>
  <para style="iot">Maxaafa Ayfe Qofata</para>
  <para style="io1">Sarotho <char style="ior">(<ref loc="EPH 1:1-2">1:1-2</ref>)</char></para>
  <para style="io1">Kiristoosanne woosa keethi <char style="ior">(<ref loc="EPH 1:3-3:21">1:3—3:21</ref>)</char></para>
  <para style="io1">Kiristoosan de7iya ooratha de7uwa <char style="ior">(<ref loc="EPH 4:1-6:20">4:1—6:20</ref>)</char></para>
  <para style="io1">Akeekisonne sarotho <char style="ior">(<ref loc="EPH 6:21-24">6:21-24</ref>)</char></para>
  <para style="ie" />
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Xoossaa shenen Kiristoos Yesuusa hawaare gidida Phawuloosape, Efesoonan de7iya geeshshatasinne Kiristoos Yesuusa ammaneysatas xaafetida kiitaa.<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 18:19-21">Hawa 18:19-21</ref>; <ref loc="ACT 19:1">19:1</ref>.</char></note><verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />Xoossaa nu Aawapenne Godaa Yesuus Kiristoosape aadho keehatethaynne sarotethay hintew gido.<verse eid="EPH 1:2" /></para>
  <para style="s1">Kiristoosan de7iya ayyaana anjuwa</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Salon de7iya ayyaana anjo ubban Kiristoosa baggara nuna anjida, nu Godaa Yesuus Kiristoosa Aaway, Xoossay galatetto. <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />Nuuni iya sinthan geeshshatanne borey baynayisata gidana mela Xoossay alamey medhetanaape kase Kiristoosa baggara ba siiquwan nuna dooris. <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />Xoossay ba sheniyan ba dosidaysada Yesuus Kiristoosa baggara nuna ba nayta oothanaw kasetidi qopi wothis. <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />Xoossay ba siiqiya Na7aa baggara nuus coo immida aadho keehatethay bonchetana mela hessa oothis.<verse eid="EPH 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 1:7" />Xoossaa aadho keehatetha duretethaada Kiristoosa suuthan wozetidi nagara atotetha demmida. <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />Ba aadho keehatetha cincatethaninne eratethan kunthidi nuus immis.<note caller="-" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="COL 1:14">Qola 1:14</ref>.</char></note> <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />Xoossay ba dosidaysada Kiristoosa baggara iya sheniya xuuraa nu erana mela oothis. <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />Wodey gakiya wode Xoossay polanaw qopida qofay, saloninne sa7an de7iya medhetetha ubbay Kiristoosape garsan gidana melasa.<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />Ubbabaa ba sheniyada oothiya Xoossay, kasetidi halchidaysa Kiristoosa baggara nuuni iyabaa gidana mela nuna dooris. <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />Hessa I oothiday, Kiristoosan ufaysi wothidi naagon koyro gidida nuuni Xoossaa bonchuwa galatan qoncisana melasa. <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />Hinteka hinte atotetha Wongela, hessika tuma qaala si7ida wode Kiristoosa ammanideta. Xoossay hintew immana gida Geeshsha Ayyaanan hinte attametideta. <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />Xoossaa bonchoy galatetana mela Xoossay ba asaa wozana gakanaw Geeshsha Ayyaana nuus oythu oothidi immis.<verse eid="EPH 1:14" /></para>
  <para style="s1">Phawuloosa woosa</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Hessa gisho, Godaa Yesuusa hinte ammaneysanne geeshshata ubbaa hinte siiqeysa ta si7ida wode <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />ta woosan hintena qopashe hinte gisho Xoossaa galateysa aggabike. <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />Godaa Yesuus Kiristoosa Xoossay, boncho Aaway, Xoossaa hinte aathidi eranaada cincatethaanne qoncetha ayyaana hintew immanaada taani Xoossaa woossayis. <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />Xoossay hintena xeegida ufaysaynne geeshshati laattiya boncho laatay ay mela daroko hinte erana mela Xoossay hinte wozana ayfiya dooyana mela taani Xoossaa woossayis.<verse eid="EPH 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 1:19" />Qassi iya ammaniya nunan oothiya iya wolqay ay mela aadhida giteeko hinte erana mela woossayis. He wolqay xoonetonanne daaburonna wolqaa. Ha nunan de7idi oothiya wolqaynne, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />Kiristoosa hayqope denthidi, salon Xoossaafe ushacha baggara utisida gita wolqay issino.<note caller="-" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Maz 110:1</ref>.</char></note> <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />Iya sunthay, ayseysatapenne maata aawatape, haareysatapenne godatape, bolla gididi ha alamiya xalaalan gidonashin, sinthafe yaana alamiyanka hara sunthata ubbaafe dhoqa. <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />Xoossay ubba Kiristoosa tohope garsan haarisis; qassi woosa keethan, ubbaban Godaa gidana mela iya shuumis.<note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="PSA 8:6">Maz 8:6</ref>; <ref loc="COL 1:22-23">Qola 1:22-23</ref>; <ref loc="COL 1:18">1:18</ref>.</char></note> <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />Woosa keethi Kiristoosa kumethi oothiya iya asatethi. Medhetethay de7iya bessa ubban Kiristoosi ba huuphen ubbaba kuntheysa.<verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s1">Kiristoosan hayqope de7o pinethi</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Haysafe kase hinte, hinte nagaraanne hinte qohuwa gaason hayqidaysata.<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="COL 2:13">Qola 2:13</ref>.</char></note> <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />He wode hinte ha alamiya iita ogiya kaallideta. Carkuwa bolla de7iya ayyaana wolqata halaqaasinne ha77ika Xoossaas kiitetonna asaa haariya ayyaanas kiitetideta. <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />Nu ubbayka kase he asata giddon nu asho amuwanne nu wozanaa sheniya kaallidi de7ida. Nuka harata mela nu medhetethan Xoossaa hanquwa ekanaw de7eyisata.<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />Shin Xoossaa gita maarotethaafenne nuus de7iya gita siiquwape dendidaysan, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />hari attoshin nuuni nu qohuwan hayqidi de7ishin Kiristoosa baggara nuus de7o immis. Hinteka attiday Xoossaa aadho keehatethaana. <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />Xoossay nuna Kiristoosara issife hayqope denthidi salon iyara issife wothis. <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />I hessa oothiday, Kiristoos Yesuusa baggara nuus qoncisida ba keehatethaanne zawi bayna ba aadho keehatetha duretetha yaana laythan nuna bessanaasa. <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />Hinte aadho keehatethan ammanon attideta. Hessika, Xoossaa imotape attishin, hinte ooson bentidaba gidenna. <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />Oonika ceeqetonna mela atotethay bentiday ooson gidenna. <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Nuuni Xoossaa medhetethi; I nuus kasetidi giigisi wothida lo77o oosota oothana mela Kiristoos Yesuusa baggara oorathi medhetida.<verse eid="EPH 2:10" /></para>
  <para style="s1">Kiristoosara de7iya issifetetha</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Hessa gisho, hinteno yeletan Ayhude gidonaysato, Ayhudeti bantaw asa kushen qaxaretidi, hintena qassi qaxaretiboonayisata gidi xeegeysa akeekite. <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />He wode hinte Kiristoosape shaaketi de7idaysa, Isra7eele asaas allaga gididi de7idaysa, Xoossaa ufaysa qaalape haakidi de7idaysanne ha alamiyan ufaysinne Xoossi bayna de7idaysa akeekite. <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Shin hinte kase haakidi de7idaysati, ha77i Kiristoos Yesuusan de7idi Kiristoosa suuthan mata shiiqideta.<verse eid="EPH 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 2:14" />Kiristoosi nu sarotethaa; I Ayhudenne Ayhude gidonna asaa timidi, nam7aa shaaki wothida morketetha godaa laallis. <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />I banan ha nam7u kochatape issi ooratha ase medhidi, higgiya iya kiitaranne wogatara issife ba asatethan dhaysidi sarotethi immis.<note caller="-" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="COL 2:14">Qola 2:14</ref>.</char></note> <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />Kiristoosi masqaliya bolla hayqidi morketetha dhaysis; qassi nam7u kochata issi asatethi oothidi Xoossara sigethis.<note caller="-" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="COL 1:20">Qola 1:20</ref>.</char></note> <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Kiristoosi yidi, Xoossaafe haakidi de7iya hintew, qassi matidi de7iya entaw sarotetha Wongela odis.<note caller="-" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="ISA 57:19">Isa 57:19</ref>.</char></note> <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Nu ubbay iya baggara issi Ayyaanan Aawa sinthe shiiqanaw danda7oos.<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Hizape hinte allaga woyko imathe gideketa, shin hinte ha77i geeshshata biitta asinne Xoossaa soo asi. <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />Hinte hawaaretinne nabeti baasida baasuwa bolla keexetideta. Godaa xaphuwa minthiya shuchay Kiristoos Yesuusa. <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />Iyan keetha ubbay issife oyketidi Godan geeshsha Xoossa keethi gidanaw diccees. <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />Hinte qassi Xoossay ba Ayyaanan de7iya keethi gidanaw Kiristoosan issife keexeteta.<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s1">Ayhude gidonna asaas hawaare gidida Phawuloosa</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Hessa gisho, taani, Phawuloosi, Ayhude gidonna hinte gisho Kiristoos Yesuusan qasho asi gidas. <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />Ta hintena maaddana mela Xoossay ba aadho keehatethan taw immida ha oosuwaba hinte loythi si7ideta. <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />Ta hintew kase qanthan xaafidaysada Xoossay ba xuuraa qoncethan taw qoncisis. <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />Ta xaafidaysa hinte nabbabiya wode Kiristoosa xuuraa ta ay mela eridaako hinte akeekanaw danda7eeta.<note caller="-" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="COL 1:26-27">Qola 1:26-27</ref>.</char></note> <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />Ha xuuray geeshsha hawaaretasinne nabetas ha77i Ayyaana baggara qoncidaysada beni wode asaas hessada qoncisibeenna. <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />Xuuray haysa: Ayhude gidonna asay Wongela baggara Isra7eeletara issife Xoossaa anjuwa laattoosona. Isra7eeletara issi keetha asi gidoosona; Kiristoos Yesuusa baggara Xoossaa ufaysa qaala ekoosona.<verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />Xoossay ba oothiya wolqaa baggara taw immida aadho keehatethan ha Wongelas oosancho gidas. <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />Taani geeshshata ubbaafe laafa gidikoka Ayhude gidonna asaas zawi bayna Kiristoosa duretetha Wongela odana mela ha aadho keehatethay taw imetis. <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />Qassi kase wodiyan ubbaa medhida Xoossan qosetidi de7iya xuuras, Xoossaa qofay aybeko qoncisanaw aadho keehatethay taw imetis. <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />Xoossay hessa oothiday ha77i wodiyan woosa keetha baggara salon de7iya halaqatasinne haareysatas ba dumma dumma qoncethaa erisanaasa. <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />Xoossay ba merinaa qofaa nu Godaa Kiristoos Yesuusa baggara polanaw hessa oothis. <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />Nu ammanon yashshi bayna Xoossako shiiqana mela Kiristoosi nuus minotethinne la77atethi immis.<verse eid="EPH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 3:13" />Taani hinte gisho waaye ekiya gisho, hinte ta waayan yeellatonnaada hintena woossayis; taani hinte bonchuwas waayetayis.<verse eid="EPH 3:13" /></para>
  <para style="s1">Efesoona asaas woosetida woosa</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Taani aawa sinthan gulbatada woossey hessa gishosa. <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />Saloninne sa7an de7iya issi issi soo asay iyan sunthetees. <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />Xoossay ba boncho duretethaafe hinte garsa asatethaa minthiya wolqaa ba Ayyaana baggara immana mela hintew woossayis. <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />Qassi ammanon Kiristoosi hinte wozanan daana melanne hinte siiqon xapho yeddidi minnidi daana mela woossayis. <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />Hessadaka, Kiristoosa siiqoy ay mela dalgeko, adusseko, dhoqekonne ciimmoko geeshshata ubbaara, hinte akeekana wolqa demmana mela woossayis. <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />Eratethaafe aadhiya Kiristoosa siiquwa hinte erana mela qassi de7o immiya Xoossaa wolqan hinte kumana mela ta woossayis.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Hiza, nu giddon oothiya ba wolqaa baggara nuuni woosseysafe woyko qopeysafe aathidi oothanaw danda7iya Xoossaas, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />woosa keethaninne Kiristoos Yesuusan wode ubban merinaape merinaa gakanaw bonchoy gido. Amin7i.<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s1">Nuuni Kiristoosan Issino</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Hiza, Godaa gisho qashetida taani, hinte xeegetida xeessas bessiya de7o daana mela hintena woossayis. <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />Hinte ubba wode aadatanne hayo gidite; issoy issuwa danda7itenne siiqon de7ite.<note caller="-" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="COL 3:12-13">Qola 3:12-13</ref>.</char></note> <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />Sarotethan qashetidi Ayyaanay immiya issifetetha naaganaw minnite. <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Xoossay hintena xeegida wode issi ufaysas xeegidaysada issi asatethinne issi Ayyaani de7ees. <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />Issi Goday, issi ammanoynne issi xinqatey de7ees. <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />Ubbaafe bolla gidida, ubbaa baggara oothiyanne ubbaa giddon de7iya issi Xoossay, ubbaa Aaway de7ees.<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />Shin Kiristoosi immanaw koydaysada nu issoy issoy dumma dumma imota ekida. <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Hessa gisho, Xoossaa qaalay,</para>
  <para style="q1" vid="EPH 4:8">“I pude keyida wode</para>
  <para style="q2" vid="EPH 4:8">di7etida darota baara ekidi bis;</para>
  <para style="q2" vid="EPH 4:8">asaaska imota immis”</para>
  <para style="m" vid="EPH 4:8">yaagees.<note caller="-" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="PSA 68:18">Maz 68:18</ref>.</char></note> <verse eid="EPH 4:8" /><verse number="9" style="v" sid="EPH 4:9" />Yaatin, “Pude keyis” guussay woy guussee? I koyro duge, sa7aa ziqa bessaa wodhis guussu gidonna ixiko ay guussee? <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Ha duge wodhidaysi, ubba bessan bentanaw ubbaafe dhoqa saluwa keydaysi iya.<verse eid="EPH 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 4:11" />I issota issota hawaareta, issota issota nabeta, issota issota Wongela sabaaketa, issota issota woosa keethi heemmeyisata, issota issota astamaareta oothidi immis. <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />I hessa oothiday Kiristoosa asatethi gidida woosa keethi dichanawunne ammaniya asaa Xoossaa oosos giigisanaasa. <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />Hessadaka, nu ubbay Xoossaa Na7aa eridi ammanon bentiya issifetethaako gakidi, Kiristoosa ayyaana de7uwa kumethi gakidi diccana melasa.<verse eid="EPH 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 4:14" />Hizape guye, asaa gene cimon giigida balethiya wordo timirte carkoninne hobben gedenne haa kuullo kaa7iya nayta mela gidanaw bessenna. <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />Shin nuuni tumaa siiqon odishe, asatethaas huuphe gidiya Kiristoosara de7iya issifetetha guji guji dichoos. <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />Kumetha asatethay Kiristoosa bolla zempees qassi dumma dumma asatethaa billiteti issoy issuwara oyketidi uttis. Issi issi asatethaa kifiley ba oosuwa oothiya wode kumetha asatethay siiqon diccees.<note caller="-" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="COL 2:19">Qola 2:19</ref>.</char></note><verse eid="EPH 4:16" /></para>
  <para style="s1">Gal7a De7onne Ooratha De7o</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Hessa gisho, taani haysa hintew Godaa sunthan odaysinne markatayis. Go77i bayna qofaa qopiya Ayhude gidonna asatada de7opite. <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />Enta qofay dhumis; banta wozanaa muumisidosona. Enti eratetha dhayoninne ixas gidi Xoossay immiya de7uwape haakidosona. <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />Enti yeella giyaba erokona; enti laymatethas bantana aathidi immidosona; qassi tunabaa ubbaa guye goonna oothosona.<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />Shin hinte Kiristoosa eriday hessa mela ogen gidenna. <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />Iyabaa tuma si7ideta. Qassi Yesuusan de7iya tumaa mela iyape tamaarideta. <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />Hinte kase de7ida de7o ogiya aggite. Qassi ba cimmiya amon dhayiya hinte ceega asatethaa diggite.<note caller="-" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="COL 3:9">Qola 3:9</ref>.</char></note> <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />Hinte wozanaa qofan ooraxite. <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />Tuma xillotethaninne geeshshatethan Xoossaa leemison medhetida ooratha asatethaa ma7ite.<note caller="-" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="GEN 1:26">Medhe 1:26</ref>; <ref loc="COL 3:10">Qola 3:10</ref>.</char></note><verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Hiza, wordo odetofite. Nuuni ubbay Kiristoosa asatethaa billiteta gidiya gisho asa ubbaara tuma odetite.<note caller="-" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="ZEC 8:16">Zaka 8:16</ref>.</char></note> <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Hanqetite, shin hinte hanquwan nagara oothopite. Hinte hanqeti de7ishin awi wullofo.<note caller="-" style="x"><char style="xo" closed="false">4:26 </char><char style="xt" closed="false"><ref loc="PSA 4:4">Maz 4:4</ref>.</char></note> <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />Xalahes besse immofite. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Kaysotiya uray hizape guye kaysotopo. Shin manqota maaddiyabay iyaw daana mela ba kushen lo77oba ootho.<verse eid="EPH 4:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EPH 4:29" />Hinte doonape iita qaali keyopo. Shin si7eyisata go77ana melanne harata minthethiya koshshiya lo77o qaali hinte doonape keyo. <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />Xoossay hintena woziya gallasas hintena attamidi wothida Xoossaa Ayyaana azzanthofite. <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Cametethi, yilo, hanqo, waaso, cashshenne iita ubbaa hintefe haassite. <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Aathidi issoy issuwas keehanne qadheteyisata gidite. Xoossay Kiristoosa baggara hintew atto gidaysada hinteka wolis atto giite.<note caller="-" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="COL 3:13">Qola 3:13</ref>.</char></note><verse eid="EPH 4:32" /></para>
  <para style="b" />
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Hiza, Xoossay dosiya naytada iya daanite. <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />Kiristoosi nuna dosidi bana nu gisho Xoossaas sawiya imonne yarsho oothidi immidaysada hinteka siiqon de7ite.<note caller="-" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="EXO 29:18">Kessa 29:18</ref>; <ref loc="PSA 40:6">Maz 40:6</ref>.</char></note><verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />Shin laymatethi, tunatethinne uuzetethi ammaniya asaas bessonna gisho hinte giddon ubbaraka si7etofo. <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />Xoossaa galatitepe attishin, yeellayabaynne eeya odi woyko qidhey hintew bessonna gisho hinte giddon ubbaka de7opo. <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Haysa erite; oonika laymatey woyko tunabaa oothey woyko uuzetey Kiristoosa kawotethaanne Xoossaa kawotethaa laattanaw danda7enna. Uuzetethi eeqa goyinno mela.<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />Hayisata gaason Xoossaa hanqoy kiitetonna asaa bolla yaana gisho oonika hintena pathonna odan cimmofo. <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Hessa mela asaara issifetethi oothopite. <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />Kase hinte dhuman de7ideta, shin ha77i Godaa baggara poo7on de7eeta. Hiza, poo7o asada poo7on simeretite. <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />Poo7oy lo77otethi, xillotethinne tumatethi ayfees.<verse eid="EPH 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 5:10" />Godaa ufaysiyabaa oothanaw koyite. <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Go77i bayna dhuma ooso qoncisitepe attishin, iyara issifopite. <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />Enti geeman oothiya oosuwa hari attoshin odanawuka yeellayees. <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Shin ubbabay poo7on keyiya wode qoncen bentees. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Poo7oy ubbaba qoncen bessees. Hessa gisho,</para>
  <para style="q1" vid="EPH 5:14">“Neno dhiskeyso barka;</para>
  <para style="q2" vid="EPH 5:14">hayqope denda;</para>
  <para style="q1" vid="EPH 5:14">Kiristoosi ne bolla poo7ana” yaagetis.<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Hiza, hinte waanidi de7iyako akeeki be7ite. Cincata giditepe attishin, eeyata gidopite. <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />Laythay iita gidiya gisho injetiya wode ubbaa go7etite.<note caller="-" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="COL 4:5">Qola 4:5</ref>.</char></note> <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Hessa gisho, Godaa sheney aybeko akeekitepe attishin, eeyopite.<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />Geeshsha Ayyaanan gallas gallas kumitepe attishin, dhayoko hintena kaalethiya gisho woyne ushshan mathotofite. <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />Mazmuren, sabaninne ayyaana yethan, issoy issuwara odetite. Qassi hinte wozanan yexishenne sabbishe Godaa galatite.<note caller="-" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="COL 3:16-17">Qola 3:16-17</ref>.</char></note> <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />Nu Godaa Yesuus Kiristoosa sunthan ubba wode Xoossaa Aawa ubbabaas galatite.<verse eid="EPH 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 5:21" />Kiristoosa bonchuwas gidi issoy issuwas haaretite.<verse eid="EPH 5:21" /></para>
  <para style="s1">Azinabanne Machiba</para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />Macheto, Godaas haareteysada hinte azinatas haaretite.<note caller="-" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="COL 3:18">Qola 3:18</ref>; <ref loc="1PE 3:1">1 Phex 3:1</ref>.</char></note> <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Kiristoosi woosa keethaas huuphe gideysada azinika ba machees huuphe. Qassi Kiristoos ba asatethi gidida woosa keethaa ashsheysa. <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Shin woosa keethay Kiristoosas haareteysada macheti banta azinatas ubbaban haaretanaw bessees.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />Azinatoo, Kiristoosi woosa keethaa dosidi bana iw immidaysada hinteka hinte macheta dosite.<note caller="-" style="x"><char style="xo" closed="false">5:25 </char><char style="xt" closed="false"><ref loc="COL 3:19">Qola 3:19</ref>; <ref loc="1PE 3:7">1 Phex 3:7</ref>.</char></note> <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />I woosa keethaa ba qaala baggara haathan meeccidi geeshshis. <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />Kiristoosi woosa keethaa qiti woyko som7o tuussi woyko hessa melabay bayna I kumetha bonchuwara geeshshinne boretonaaro oothidi baako shiishanaw koyidi hessa oothis. <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Hessadaka, azinati bantana doseysada banta macheta dosanaw bessees. Ba machiw doseysi bana dosees. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Bana ixiya asi oonika baawa, shin Kiristoosi woosa keethaas ootheysada ba asatethaa muzeesinne naagees. <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />Nuuni Kiristoosa asatethaa billiteta.<verse eid="EPH 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EPH 5:31" />Xoossaa qaalay, “Hessa gisho, asi ba aawanne ba aayiw aggidi, ba machera issife daana; enti nam7ayka issi asho gidana” yaagees.<note caller="-" style="x"><char style="xo" closed="false">5:31 </char><char style="xt" closed="false"><ref loc="GEN 2:24">Medhe 2:24</ref>.</char></note> <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Haysi gita xuura, shin taani hessa Kiristoosabaanne woosa keethabaa leemiso oothada odayis. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Gidoshin, hinte issoy issoy hinte macheta hinte, hintena doseysada dosite. Issi issi macha ba azinaa bonchanaw bessees.<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s1">Naytanne Enta Yelidaysata</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Nayto, hinte Godaaba gidiya gisho hintena yelidaysatas kiitetite. Hessi hintew bessiyaba.<note caller="-" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="COL 3:20">Qola 3:20</ref>.</char></note> <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“Ne aayiwunne ne aawa boncha.” Hessi ufaysa qaali de7iya koyro kiitaa.<note caller="-" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="EXO 20:12">Kessa 20:12</ref>; <ref loc="DEU 5:16">Zaare 5:16</ref>.</char></note> <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“Ne hessa poliyaba gidiko ubbay new injetana; ne laythay sa7a bolla aduqana.”<verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />Aawato, hinte nayta Godaa qaala tamaarsoninne enta kaaleson dichitepe attishin, entana caamisopite.<note caller="-" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="COL 3:21">Qola 3:21</ref>.</char></note><verse eid="EPH 6:4" /></para>
  <para style="s1">Godatanne Aylleta</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Aylleto, Kiristoosas kiiteteysada hinte sa7a godatas yashshan, bonchoninne suure wozanan kiitetite.<note caller="-" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="COL 3:22-25">Qola 3:22-25</ref>.</char></note> <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />Enta sinthan saba demmanaw enti be7iya wode xalaala oothopite. Shin Kiristoosa aylletada Xoossaa sheniya wozanape polite. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />Asas gidonashin, Godaas gidi hinte kumetha wozanaape oothite. <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />Aylle gidin woyko godaa gidin issoy issoy ba oothida lo77o oosuwas Godaape woyto ekanaysa ereeta.<verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Godato, asa som7o be7idi maaddonna Goday, saluwan de7eysa ereeta. Hessa gisho, hinte aylleta mandeysa aggidi enti hintew bonchon kiiteteysa mela hinte entaw lo77oba oothite.<note caller="-" style="x"><char style="xo" closed="false">6:9 </char><char style="xt" closed="false"><ref loc="COL 4:1">Qola 4:1</ref>; <ref loc="DEU 10:17">Zaare 10:17</ref>; <ref loc="COL 3:25">Qola 3:25</ref>.</char></note><verse eid="EPH 6:9" /></para>
  <para style="s1">Xoossa Ola Miishe</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Wursethan, Godaaninne iya gita wolqan minnite. <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Xalahe cimuwa eqetanaw danda7ana mela Xoossay hintew immida ola miishiya ubbaa ma7ite. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Nu olay asara gidonashin, salon de7iya tuna ayyaana olanchotara, maata aawatara, haareysataranne ha dhuma alamiya wolqatara.<verse eid="EPH 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 6:13" />Hessa gisho, iita gallasaa teqanawunne ubbaa polidi, minnidi eqanaw hinte danda7ana mela Xoossaa ola miisheta ubbaa ma7ite. <verse eid="EPH 6:13" /><verse number="14-15" style="v" sid="EPH 6:14-15" />Tumaa xeessan dancoda dancidi, xillotethaa xurureda tiran wothidi, sarotethaa Wongela hinte tohuwan caammada aathidi minnidi eqite.<note caller="-" style="x"><char style="xo" closed="false">6:14-15 </char><char style="xt" closed="false"><ref loc="ISA 11:5">Isa 11:5</ref>; <ref loc="ISA 59:17">Isa 59:17</ref>; <ref loc="ISA 52:7">52:7</ref>.</char></note> <verse eid="EPH 6:14-15" /><verse number="16" style="v" sid="EPH 6:16" />He ubbaafe aathidi, Xalahey yeddiya laxiya tama donge ubbaa toysanaw danda7iya ammanuwa ubba wode gondalleda oykite. <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Xoossaa atotetha birata barneexada hinte huuphen wothite; qassi Geeshsha Ayyaana mashsha ika, Xoossaa qaala oykite.<note caller="-" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="ISA 59:17">Isa 59:17</ref>.</char></note> <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />Woossa aggofite; haratasika gaannatite; ubba wode Ayyaanan woossite. Hessan, geeshshatas saletonna minnidi ubba wode woossite. <figure style="fig" alt="Roman soldier in armor" file="LB00196B.tif" size="span" ref="6:18">Roome Wotaadarey Kumetha Ola Miishe Ma77idi</figure><verse eid="EPH 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 6:19" />Taani Wongela xuuraa yashshi bayna qoncisada odana mela Xoossay taw qaala immana mela woossite. <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />Taani hessa oothanaw kiitetas ha77ika qashon de7ey he Wongela gishosa. Yaaniya gisho, taani yashshi bayna besseysada odana mela taw woossite.<verse eid="EPH 6:20" /></para>
  <para style="s1">Sarotho</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Taani waana de7iyakonne ay oothiyako hinte erana mela nu siiqo ishay, Godaa oosuwan ammanetida oosanchoy, Tikiqoosi, tabaa ubbaa hintew odana.<note caller="-" style="x"><char style="xo" closed="false">6:21 </char><char style="xt" closed="false"><ref loc="ACT 20:4">Hawa 20:4</ref>; <ref loc="2TI 4:12">2 Ximo 4:12</ref>; <ref loc="COL 4:7-8">Qola 4:7-8</ref>.</char></note> <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />Nuuni ubbay waanidi de7iyako hintew odana melanne hintena minthethana mela taani iya hinteko kiittas.<note caller="-" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="GEN 21:10">Medhe 21:10</ref>.</char></note><verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />Xoossaa Aawape, Godaa Yesuus Kiristoosape sarotethaynne siiqoy ammanora issife ammaniya ubbaas gido. <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />Irxonna siiqon nu Godaa Yesuus Kiristoosa siiqiya ubbaara Xoossaa aadho keehatethay gido.<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>