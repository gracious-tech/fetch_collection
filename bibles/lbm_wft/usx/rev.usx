<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Lodhi</book>
  <para style="h">प्रकाशितवाक्य</para>
  <para style="toc3">प्रकाशितवाक्य</para>
  <para style="toc2">प्रकाशितवाक्य</para>
  <para style="toc1">यूहन्ना को प्रकाशितवाक्य</para>
  <para style="mt2">प्रकाशितवाक्य यूहन्ना के द्वारा</para>
  <para style="mt1">प्रकाशितवाक्य यूहन्ना को द्वारा</para>
  <para style="imt">परिचय</para>
  <para style="ip">प्रकाशितवाक्य या किताब नयो नियम को आखरी किताब आय, अऊर वा आखिर म लिख्यो गयो। प्रेरित यूहन्ना न यीशु मसीह को जनम को बाद सन ९५ को आस पास वा लिख्यो गयी <char style="xt"><ref loc="REV 1:1">१:१</ref></char> अऊर ओनच यूहन्ना रचित सुसमाचार अऊर यूहन्ना की १, २, ३ चिट्ठी लिखी। योच यूहन्ना को लोग “यीशु जेको पर प्रेम करत होतो” असो मान क पहिचानत होतो। <char style="xt"><ref loc="JHN 13:23">यूहन्ना १३:२३</ref></char> यीशु मसीह को सुसमाचार को वजह सी पतमुस नाम को द्वीप पर जब सजा भोग रह्यो होतो, तब ओन या किताब लिख्यो <char style="xt"><ref loc="REV 1:9">१:९</ref>।</char></para>
  <para style="ip">या किताब लिखन को यूहन्ना को उद्देश यो होतो कि मोरो पढ़न वालो ख यीशु को संग विश्वास म रहन लायी प्रोत्साहन देनो अऊर यीशु को फिर सी वापस आनो जवर होतो। येकोलायी ओको म आशा निर्मान करनो <char style="xt"><ref loc="REV 1:3">१:३</ref>; <ref loc="REV 22:7">२२:७</ref></char> ओन सब विश्वासियों ख या चिट्ठी लिखी पर विशेषता या हय कि वा साथ मण्डलियों ख लिख्यो जिन्को उल्लेख <char style="xt"><ref loc="REV 2-3">२–३</ref></char> म मिलय हय। यूहन्ना खुद की लिखावट ख परमेश्वर को तरफ सी आयो हुयो सन्देश, भविष्यवानी असो बतावय हय अऊर जिन बातों ख खुद न देख्यो उन बातों को वर्नन ऊ अलंकारिक भाषा म लिखय हय। या जो किताब आय, यो पुरानो नियम को कुछ भागो सी मिलतो झुलतो अऊर विशेषता <char style="xt"><ref loc="ZEC 6:1-8">जकर्याह ६:१-८</ref></char> इन वचनों सी ओकी समानता देखो वसोच सात तुरही अऊर सात कटोरा यो परमेश्वर न मिस्र पर आयो हुयो दु:ख को जसो हय। <char style="xt"><ref loc="EXO 7-9">निर्गमन ७–९</ref></char> प्रकाशितवाक्य आखरी दिनो को वर्नन करय हय आखिर म यीशु विजयी जसो होयेंन अऊर ओको पर विश्वास करन वालो ओको संग जीन्दो रहेंन असो ऊ कह्य हय। या किताब को द्वारा तुम्ख चेतावनी मिले, अऊर यीशु को फिर सी आन को बारे म तुम्ख आशा मिलेंन।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. सुरूवात म यूहन्ना खुद की पहिचान कर क् ओख भविष्यवानी कसो प्राप्त भयी यो बताय क सुरूवात करय हय। <char style="ior"><ref loc="REV 1:1-20">१:१-२०</ref></char></para>
  <para style="io1">२. यीशु को तरफ सी सात मण्डलियों ख प्रत्येक्ष मिल्यो हुयो सन्देश यूहन्ना देवय हय। <char style="ior"><ref loc="REV 1:1-3:22">१:१–३:२२</ref> </char></para>
  <para style="io1">३. तब ऊ सात सिक्का को उल्लेख करय हय। <char style="ior"><ref loc="REV 4:1-8:5">४:१–८:५</ref></char> अऊर सात तुरही को वर्नन करय हय। <char style="ior"><ref loc="REV 8:6-11:19">८:६–११:१९</ref></char></para>
  <para style="io1">४. ओको बाद यूहन्ना एक छोटो लड़का सात मुंड वालो सांप सी कसो लड़ाई यो बतावय हय। <char style="ior"><ref loc="REV 12:1-14:20">१२:१–१४:२०</ref></char></para>
  <para style="io1">५. ओको बाद यूहन्ना सात गुस्सा को बारे म लिखय हय। <char style="ior"><ref loc="REV 15:1-16:18">१५:१–१६:१८</ref></char></para>
  <para style="io1">६. ओको बाद परमेश्वर ओको आसमान को दुश्मन पर कसो विजय हासिल करय हय, यो बतावय हय। <char style="ior"><ref loc="REV 17:1-20:15">१७:१–२०:१५</ref></char></para>
  <para style="io1">७. जो नयो आसमान अऊर नयी धरती आखिर म आवन वाली हय ओको वर्नन करय हय। <char style="ior"><ref loc="REV 21:1-22:21">२१:१–२२:२१</ref></char></para>
  <chapter number="1" style="c" sid="REV 1"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1"/>यीशु मसीह को प्रकाशन, जो ओख परमेश्वर न येकोलायी दियो कि अपनो सेवकों ख हि बाते, जिन्को जल्दी होनो जरूरी हय, दिखाये; अऊर ओन अपनो स्वर्गदूतों ख भेज क ओको द्वारा अपनो सेवक यूहन्ना ख बतायो, <verse eid="REV 1:1"/><verse number="2" style="v" sid="REV 1:2"/>यूहन्ना न परमेश्वर को वचन अऊर यीशु मसीह की गवाही, मतलब जो कुछ ओन देख्यो होतो ओकी गवाही दी। <verse eid="REV 1:2"/><verse number="3" style="v" sid="REV 1:3"/>धन्य हय हि जो या किताब ख पढ़य हय, अऊर धन्य हय हि भविष्यवानी को सन्देश ख सुनावय हय अऊर जो लिख्यो हय ओको अनुसार चलय हय; कहालीकि या सब बाते घटित होन को समय जवर हय।<verse eid="REV 1:3"/></para>
  <para style="s">सात मण्डलियों ख नमस्कार</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१:४ </char>
      <char style="xt" closed="false">
        <ref loc="REV 4:5">प्रकाशितवाक्य ४:५</ref>
      </char>
    </note>यूहन्ना को तरफ सी आसिया प्रान्त की सात मण्डलियों को नाम: ऊ परमेश्वर को तरफ सी जो हय, अऊर जो होतो, अऊर जो आवन वालो हय; अऊर उन सात आत्मावों को तरफ सी जो ओको सिंहासन को सामने हंय, <verse eid="REV 1:4"/><verse number="5" style="v" sid="REV 1:5"/>अऊर यीशु मसीह को तरफ सी जो विश्वास लायक गवाह अऊर मरयो हुयो म सी जीन्दो होन वालो म पहिलौठा अऊर धरती को राजावों को शासक हय। तुम्ख अनुग्रह अऊर शान्ति मिलती रहे।</para>
  <para style="p" vid="REV 1:5">ऊ हम सी प्रेम रखय हय, अऊर ओन अपनो खून को द्वारा हम्ख पापों सी छुड़ायो हय, <verse eid="REV 1:5"/><verse number="6" style="v" sid="REV 1:6"/><note caller="+" style="x"><char style="xo" closed="false">१:६ </char><char style="xt" closed="false"><ref loc="REV 5:10">प्रकाशितवाक्य ५:१०</ref></char></note>अऊर हम्ख एक राज्य अऊर अपनो पिता परमेश्वर लायी याजक भी बनाय दियो। यीशु मसीह की महिमा अऊर पराक्रम हमेशा हमेशा रहे। आमीन।<verse eid="REV 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१:७ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">मत्ती २४:३०</ref>; <ref loc="MRK 13:26">मरकुस १३:२६</ref>; <ref loc="LUK 21:27">लूका २१:२७</ref>; <ref loc="1TH 4:17">१ थिस्सलुनीकियों ४:१७</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:34">यूहन्ना १९:३४</ref>,<ref loc="JHN 19:37">३७</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">मत्ती २४:३०</ref>
      </char>
    </note>देखो, ऊ बादलो को संग आय रह्यो हय, अऊर हर एक आंखी ओख देखेंन, हि भी जिन्न ओख बेध्यो होतो हि भी ओख देखेंन, अऊर धरती को पूरो गोत्र ओको वजह शोक करेंन। आमीन।<verse eid="REV 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१:८ </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:13">प्रकाशितवाक्य २२:१३</ref>
      </char>
    </note>प्रभु परमेश्वर, जो हय अऊर जो होतो अऊर जो आवन वालो हय, जो सर्वशक्तिमान हय, यो कह्य हय, “मयच पहिलो अऊर आखरी आय।”<verse eid="REV 1:8"/></para>
  <para style="s">मसीह को दर्शन</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9"/>मय यूहन्ना, जो तुम्हरो भाऊ आय अऊर यीशु को बड़ी कठिनायी अऊर राज्य अऊर धीरज म तुम्हरो सहभागी हय, परमेश्वर को वचन अऊर यीशु की गवाही को वजह पतमुस नाम को टापू म होतो। <verse eid="REV 1:9"/><verse number="10" style="v" sid="REV 1:10"/>मय प्रभु को दिन आत्मा म आय गयो, अऊर अपनो पीछू तुरही को जसो बड़ो आवाज यो कहतो सुन्यो, जो कुछ तय देख रह्यो हय ओख एक किताब म लिखतो जा अऊर या किताब ख सात शहरों की मण्डलियों म भेज दे। <verse eid="REV 1:10"/><verse number="11" style="v" sid="REV 1:11"/>“जो कुछ तय देख रह्यो हय ओख एक किताब म लिखतो जा अऊर या किताब ख सातों मण्डलियों को जवर भेज दे, मतलब इफिसुस, अऊर स्मुरना, अऊर पिरगमुन, अऊर थुआतीरा, अऊर सरदीस, अऊर फिलदिलफिया, अऊर लौदीकिया ख।” <figure style="fig" alt="Map of seven churches in Asia" file="hk00378c.tif" size="col" copy="Horace Knowles ©" ref="१:११">एशिया को सात मण्डलियों को नकाशा</figure><verse eid="REV 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12"/>तब मय न ओख, जो मोरो सी बोल रह्यो होतो, देखन लायी अपनो मुंह फिरायो; अऊर पीछू घुम क मय न सोनो की सात दीवट देख्यो, <verse eid="REV 1:12"/><verse number="13" style="v" sid="REV 1:13"/>अऊर उन दीवट को बीच म आदमी को बेटा जसो एक आदमी ख देख्यो, जो पाय तक कपड़ा पहिन्यो, अऊर छाती पर सोनो को पट्टा बान्ध्यो हुयो होतो। <verse eid="REV 1:13"/><verse number="14" style="v" sid="REV 1:14"/>ओकी मुंड अऊर बाल सफेद ऊन जसो उज्वल होतो, अऊर ओकी आंखी आगी को जसी चमकत होती। <verse eid="REV 1:14"/><verse number="15" style="v" sid="REV 1:15"/>ओको पाय उत्तम पीतर को जसो होतो जो मानो भट्टी म तपायो गयो हय, अऊर ओकी आवाज एक पानी को झरना को जसी लग रही होती <verse eid="REV 1:15"/><verse number="16" style="v" sid="REV 1:16"/>ऊ अपनो दायो हाथ म सात तारा धरयो हुयो होतो, अऊर ओको मुंह सी तेज दोधारी तलवार निकलत होती। ओको चेहरा भर दोपहर म निकल्यो हुयो सूरज को जसो चमकदार होतो। <verse eid="REV 1:16"/><verse number="17" style="v" sid="REV 1:17"/><note caller="+" style="x"><char style="xo" closed="false">१:१७ </char><char style="xt" closed="false"><ref loc="REV 2:8">प्रकाशितवाक्य २:८</ref>; <ref loc="REV 22:13">२२:१३</ref></char></note>जब मय न ओख देख्यो त ओको पाय पर मरयो हुयो आदमी को जसो गिर पड़्यो। ओन मोरो पर अपनो दायो हाथ रख क कह्यो, “मत डर!” मय पहिलो अऊर आखरी आय; <verse eid="REV 1:17"/><verse number="18" style="v" sid="REV 1:18"/>मय जीन्दो हय अऊर मय मर गयो होतो, अऊर अब देख मय हमेशा हमेशा जीन्दो रहूं। मृत्यु अऊर अधोलोक की कुंजी पर मोरो अधिकार हय। <verse eid="REV 1:18"/><verse number="19" style="v" sid="REV 1:19"/>येकोलायी जो बाते तय न देखी हंय अऊर जो बाते होय रही हंय, अऊर जो बाते येको बाद होन वाली हंय, उन सब ख लिख ले। <verse eid="REV 1:19"/><verse number="20" style="v" sid="REV 1:20"/>मतलब उन सात तारा को भेद जिन्ख तय न मोरो दायो हाथ म देख्यो होतो, अऊर उन सात सोनो को दीवट को भेद: हि सात तारा सातों मण्डलियों को दूत आय, अऊर हि सात दीवट सात मण्डलियां हंय।<verse eid="REV 1:20"/></para>
  <chapter eid="REV 1"/>
  <chapter number="2" style="c" sid="REV 2"/>
  <para style="s">इफिसुस ख सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1"/>“इफिसुस की मण्डली को दूत ख यो लिख।</para>
  <para style="p" vid="REV 2:1">“जो सातों तारा अपनो दायो हाथ म धरयो हुयो हय, अऊर सोनो की सातों दीवट को बीच म चलय हय, ऊ यो कह्य हय कि <verse eid="REV 2:1"/><verse number="2" style="v" sid="REV 2:2"/>जो तय न करयो अऊर तोरो मेहनत को काम ख अऊर तोरो धीरज ख जानु हय; अऊर यो भी कि तय बुरो लोगों ख देख नहीं सकय, अऊर जो अपनो आप ख प्रेरित कह्य हंय, अऊर हयच नहाय, उन्ख तय न उन्ख परख क झूठो पायो। <verse eid="REV 2:2"/><verse number="3" style="v" sid="REV 2:3"/>तय धीरज रखय हय, अऊर मोरो नाम लायी दु:ख उठातो उठातो थक्यो नहीं। <verse eid="REV 2:3"/><verse number="4" style="v" sid="REV 2:4"/>पर मोख तोरो विरुद्ध यो कहनो हय कि तय न अपनो पहिलो सो प्रेम छोड़ दियो हय। <verse eid="REV 2:4"/><verse number="5" style="v" sid="REV 2:5"/>येकोलायी याद कर कि तय कहां सी गिरयो हय, अऊर पापों सी मन फिराव अऊर पहिले को जसो काम कर जसो तय पहिले करत होतो। यदि तय पापों सी मन नहीं फिरायजो, त मय तोरो जवर आय क तोरो दीवट ख ओकी जागा सी हटाय देऊ। <verse eid="REV 2:5"/><verse number="6" style="v" sid="REV 2:6"/>पर हव, तोरो म या बात त हय कि तय नीकुलइयों को कामों सी घृना करय हय, जिन्कोसी मय भी घृना करू हय।”<verse eid="REV 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२:७ </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:2">प्रकाशितवाक्य २२:२</ref>
      </char>
    </note>“जेको कान हय ऊ सुन ले कि आत्मा मण्डलियों सी का कह्य हय।</para>
  <para style="p" vid="REV 2:7">“जो जय पाये, मय ओख ऊ जीवन को झाड़ म सी जो परमेश्वर को बगीचा म बढ़न वालो झाड़ सी हय, फर खान को अधिकार देऊ।”<verse eid="REV 2:7"/></para>
  <para style="s">स्मुरना ख सन्देश</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२:८ </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:17">प्रकाशितवाक्य १:१७</ref>; <ref loc="REV 22:13">२२:१३</ref></char>
    </note>“स्मुरना की मण्डली को दूत ख यो लिख।</para>
  <para style="p" vid="REV 2:8">“जो पहिलो अऊर आखरी हय, जो होतो अऊर अब फिर सी जीन्दो भय गयो हय, ऊ यो कह्य हय कि <verse eid="REV 2:8"/><verse number="9" style="v" sid="REV 2:9"/>मय तोरी कठिनायी अऊर गरीबी ख जानु हय पर तय धनी हय, जो अपनो आप ख यहूदी कह्य हंय पर हयच नहाय, अऊर तोरो विरुद्ध म जो बुरी बाते कह्य हय उन्ख मय जानु हय। हि शैतान की सभा आय। <verse eid="REV 2:9"/><verse number="10" style="v" sid="REV 2:10"/>जो दु:ख तोख झेलनो पड़ेंन, उन सी मत डर। देखो, शैतान तुम म सी कुछ ख जेलखाना म डालन पर हय ताकि तुम परख्यो जावो; अऊर तुम्ख दस दिन तक कठिनायी उठानो पड़ेंन। जीव जात तक विश्वास लायक रहो, त मय तोख विजय को मुकुट तोख जीवन देऊ।”<verse eid="REV 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२:११ </char>
      <char style="xt" closed="false">
        <ref loc="REV 20:14">प्रकाशितवाक्य २०:१४</ref>; <ref loc="REV 21:8">२१:८</ref></char>
    </note>“जेको कान हय ऊ सुन ले कि आत्मा मण्डलियों सी का कह्य हय। जो जय पाये, ओख दूसरी मृत्यु सी हानि नहीं पहुंचेंन।”<verse eid="REV 2:11"/></para>
  <para style="s">पिरगमुन ख सन्देश</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12"/>“पिरगमुन की मण्डली को दूत ख यो लिख।</para>
  <para style="p" vid="REV 2:12">“जेको जवर दोधारी अऊर तेज तलवार हय, ऊ यो कह्य हय कि <verse eid="REV 2:12"/><verse number="13" style="v" sid="REV 2:13"/>मय यो जानु हय कि तय उत रह्य हय जित शैतान को सिंहासन हय। तय मोरो संग सच्चो हय, अऊर मोरो पर विश्वास करन सी उन दिनो म भी पीछू नहीं हट्यो जिन्म मोरो विश्वास लायक गवाह अन्तिपास, तुम्हरो बीच ऊ जागा पर मार दियो गयो जित शैतान रह्य हय। <verse eid="REV 2:13"/><verse number="14" style="v" sid="REV 2:14"/>पर मोख तोरो विरोध कुछ बाते कहनी हंय, कहालीकि तुम्हरो बिच कुछ असो हंय, जो बिलाम की शिक्षा ख मानय हंय, जेन बच्चा ख सिखायो होतो कि इस्राएल को लोगों ख मूर्तियों ख चढ़ायो हुयो खाना खान अऊर व्यभिचार करन को द्वारा उन्ख पाप म गिरावन को लायी अगुवायी करे। <verse eid="REV 2:14"/><verse number="15" style="v" sid="REV 2:15"/>वसोच तोरो बिच म कुछ असो हंय, जो नीकुलइयों की शिक्षा ख मानय हंय। <verse eid="REV 2:15"/><verse number="16" style="v" sid="REV 2:16"/>येकोलायी पापों सी मन फिराव, नहीं त मय तोरो जवर जल्दीच आय क अपनो मुंह की तलवार सी उन्को संग लड़ाई करतो।”<verse eid="REV 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१७ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:48-50">यूहन्ना ६:४८-५०</ref>
      </char>
    </note>“जेको कान हय ऊ सुन ले कि आत्मा मण्डलियों सी का कह्य हय।”</para>
  <para style="p" vid="REV 2:17">“जो जय पाये, ओख मय गुप्त मन्ना म सी देऊ, अऊर उन म सी हर एक ख सफेद गोटा भी देऊ; अऊर ऊ गोटा पर एक नयो नाम लिख्यो हुयो होयेंन, जेक ओको पान वालो को अलावा अऊर कोयी नहीं जानेंन।”<verse eid="REV 2:17"/></para>
  <para style="s">थुआतीरा ख सन्देश</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18"/>थुआतीरा की मण्डली को दूत ख यो लिख।</para>
  <para style="p" vid="REV 2:18">“परमेश्वर को टुरा जेकी आंखी आगी की ज्वाला की जसी, अऊर जेको पाय उत्तम पीतर को जसो चमकदार हंय, ऊ यो कह्य हंय कि <verse eid="REV 2:18"/><verse number="19" style="v" sid="REV 2:19"/>मय तोरो कामों, तोरो प्रेम अऊर विश्वास अऊर सेवा अऊर धीरज ख जानु हय। अऊर यो भी कि तोरो पिछलो कामों सी अभी को काम पहिले सी बढ़ क हंय यो भी जानु हय। <verse eid="REV 2:19"/><verse number="20" style="v" sid="REV 2:20"/>पर मोरो जवर तोरो विरोध यो कहनो हय कि तय इजेबेल नाम की बाई ख सह रह्यो हय जो अपनो आप ख परमेश्वर की सन्देश वाहक कह्य हय। अऊर ओकी शिक्षा को द्वारा वा मोरो सेवकों ख व्यभिचार को प्रति तथा मूर्तियों ख चढ़ायो हुयो खाना खान ख मोरो सेवकों की गलत अगुवायी करय हय। <verse eid="REV 2:20"/><verse number="21" style="v" sid="REV 2:21"/>मय न ओख पापों सी मन फिरावन लायी अवसर दियो, पर वा अपनो अनैतिकता सी मन फिरावनो नहीं चाहत होती। <verse eid="REV 2:21"/><verse number="22" style="v" sid="REV 2:22"/>अऊर मय न तकलीफ को बिस्तर पर डालन वालो हय तथा उन्ख भी जो ओको संग व्यभिचार म सामिल हय, ताकी हि ऊ समय तक गहन तकलीफ ख झेलतो रहे जब तक हि ओको संग करयो अपनो बुरो कर्म को लायी मन नहीं फिराये। <verse eid="REV 2:22"/><verse number="23" style="v" sid="REV 2:23"/>मय ओको अनुयायीयों ख मार डालू; तब सब मण्डलियायें जान लेयेंन कि दिल अऊर मन को परखन वालो मयच आय, अऊर मय तुम म सी हर एक ख ओको कामों को अनुसार बदला देऊ।”<verse eid="REV 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24"/>“पर तुम थुआतीरा को बाकी लोगों सी, जितनो यो शिक्षा ख नहीं मानय अऊर उन बातों ख जिन्ख शैतान की गहरो रहस्य बाते कह्य हंय नहीं सिख्यो, यो कहू हय कि मय तुम पर अऊर बोझ नहीं डालू। <verse eid="REV 2:24"/><verse number="25" style="v" sid="REV 2:25"/>पर हव, जो तुम्हरो जवर हय ओको पर मोरो आनो तक चलतो रहो। <verse eid="REV 2:25"/><verse number="26" style="v" sid="REV 2:26"/>जो जय पाये अऊर मोरो कामों को अनुसार आखरी तक करतो रहे, मय ओख राष्ट्रों पर अधिकार देऊ जो मय न अपनो बाप सी प्राप्त करयो होतो: <verse eid="REV 2:26"/><verse number="27" style="v" sid="REV 2:27"/>अऊर उन्ख राष्ट्रों पर अधिकार देऊ हि लोहा की सलाक को संग शासन करे, अऊर उन्ख माटी को बर्तन को जसो टुकड़ा म तोड़ दे। <verse eid="REV 2:27"/><verse number="28" style="v" sid="REV 2:28"/>अऊर मय ओख भुन्सारे को तारा भी देऊ।”<verse eid="REV 2:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29"/>जेको कान हय ऊ सुन ले कि आत्मा मण्डलियों सी का कह्य हय।<verse eid="REV 2:29"/></para>
  <chapter eid="REV 2"/>
  <chapter number="3" style="c" sid="REV 3"/>
  <para style="s">सरदीस ख सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1"/>“सरदीस की मण्डली को दूत ख यो लिख।</para>
  <para style="p" vid="REV 3:1">“जेको जवर परमेश्वर की सात आत्मायें अऊर सात तारा हंय, ऊ यो कह्य हय कि मय तोरो कामों ख जानु हय: लोगों को कहनो हय कि तय जीन्दो त हय, पर वास्तव म मरयो हुयो हय। <verse eid="REV 3:1"/><verse number="2" style="v" sid="REV 3:2"/>येकोलायी उठ जा, अऊर ओख मजबूत कर जो बाकी हय, ओको पहिले को जो बाकी रह्य गयी हंय, कहालीकि मय न तोरो कोयी काम ख अपनो परमेश्वर की नजर म पूरो नहीं पायो। <verse eid="REV 3:2"/><verse number="3" style="v" sid="REV 3:3"/><note caller="+" style="x"><char style="xo" closed="false">३:३ </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्ती २४:४३</ref>,<ref loc="MAT 24:44">४४</ref>; <ref loc="LUK 12:39">लूका १२:३९</ref>,<ref loc="LUK 12:40">४०</ref>; <ref loc="REV 16:15">प्रकाशितवाक्य १६:१५</ref></char></note>येकोलायी याद कर कि तय न कसी शिक्षा प्राप्त करी अऊर सुनी होती, अऊर ओको पालन कर अऊर पापों सी मन फिराव। यदि तय नहीं जाग्यो त मय चोर को जसो तोरो जवर आऊं, अऊर तय ऊ समय ख नहीं जान सकजो कि मय कब आऊं। <verse eid="REV 3:3"/><verse number="4" style="v" sid="REV 3:4"/>पर हव, सरदीस म तोरो यहां कुछ असो लोग हंय जिन्न अपनो–अपनो कपड़ा अशुद्ध नहीं करयो। हि सफेद कपड़ा पहिन्यो हुयो मोरो संग घुमेंन, कहालीकि हि यो लायक हंय।”<verse eid="REV 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 3:5"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:५ </char>
      <char style="xt" closed="false">
        <ref loc="REV 20:12">प्रकाशितवाक्य २०:१२</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:32">मत्ती १०:३२</ref>; <ref loc="LUK 12:8">लूका १२:८</ref></char>
    </note>“जो जय पाये ओख योच तरह सफेद कपड़ा पहिनायो जायेंन, अऊर मय ओको नाम जीवन की किताब म सी कोयी भी रीति सी नहीं काटू; बल्की अपनो बाप अऊर ओको स्वर्गदूतों को जसो ओको नाम खुलो तौर पर घोषित करू। <verse eid="REV 3:5"/><verse number="6" style="v" sid="REV 3:6"/>जेको कान हय ऊ सुन ले कि आत्मा मण्डलियों सी का कह्य हय।”<verse eid="REV 3:6"/></para>
  <para style="s">फिलदिलफिया ख सन्देश</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7"/>“फिलदिलफिया की मण्डली को दूत ख यो लिख: जो पवित्र अऊर सत्य हय, अऊर जो दाऊद की कुंजी रखय हय, अऊर जो दरवाजा ऊ खोलय हय, ओख कोयी बन्द नहीं कर सकय अऊर बन्द करयो हुयो ख कोयी खोल नहीं सकय, ऊ यो कह्य हय कि।”<verse eid="REV 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 3:8"/>“मय तोरो कामों ख जानु हय; देख, मय न तोरो आगु एक दरवाजा खोल क रख्यो हय, जेक कोयी बन्द नहीं कर सकय; मय जानु हय कि तोरी सामर्थ थोड़ी हय, फिर भी तय न मोरी शिक्षा को पालन करयो हय अऊर तय मोरो नाम संग विश्वास लायक रह्यो।” <verse eid="REV 3:8"/><verse number="9" style="v" sid="REV 3:9"/>देख, मय शैतान को उन मण्डली वालो ख तोरो वश म कर देऊ जो यहूदी बन बैठ्यो हंय, पर हयच नहाय बल्की झूठ बोलय हंय देख, मय असो करू कि हि आय क तोरो घुटना को बल पर गिरेंन, अऊर यो जान लेयेंन कि मय न तोरो सी प्रेम रख्यो हय। <verse eid="REV 3:9"/><verse number="10" style="v" sid="REV 3:10"/>कहालीकि तुम्ख धैर्यपूर्वक सहनशीलता को मोरो आदेश को पालन करयो हय अऊर मय भी वा कठिन समय सी तुम्हरी रक्षा करू, जो यो धरती पर रहन वालो ख परखन लायी पूरो जगत पर आवन वालो हय। <verse eid="REV 3:10"/><verse number="11" style="v" sid="REV 3:11"/>मय जल्दीच आवन वालो हय; जो कुछ तोरो जवर हय ओख पकड़्यो रह्य कि ताकी कोयी तुम्हरो विजय को मुकुट कोयी छीन नहीं ले। <verse eid="REV 3:11"/><verse number="12" style="v" sid="REV 3:12"/><note caller="+" style="x"><char style="xo" closed="false">३:१२ </char><char style="xt" closed="false"><ref loc="REV 21:2">प्रकाशितवाक्य २१:२</ref></char></note>जो विजयी होयेंन ओख मय अपनो परमेश्वर को मन्दिर को खम्बा बनाऊं, अऊर हि यो मन्दिर सी कभी बाहेर नहीं जायेंन; अऊर मय उन पर मोरो परमेश्वर को नाम अऊर मोरो परमेश्वर को शहर को नाम नयो यरूशलेम लिखूं, जो मोरो परमेश्वर को स्वर्ग सी खल्लो उतरेंन। मय उन पर अपनो नयो नाम भी लिखूं।<verse eid="REV 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13"/>जेको कान हय ऊ सुन ले कि आत्मा मण्डलियों सी का कह्य हय।<verse eid="REV 3:13"/></para>
  <para style="s">लौदीकिया ख सन्देश</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14"/>“लौदीकिया की मण्डली को दूत ख यो लिख।</para>
  <para style="p" vid="REV 3:14">“जो ‘आमीन’ अऊर विश्वास लायक अऊर सच्चो गवाह हय, अऊर परमेश्वर की सृष्टि को शासक हय, ऊ यो कह्य हय कि <verse eid="REV 3:14"/><verse number="15" style="v" sid="REV 3:15"/>मय तोरो कामों ख जानु हय कि तय नहीं त ठंडो हय नहीं गरम: भलो होतो कि तय ठंडो या गरम होतो। <verse eid="REV 3:15"/><verse number="16" style="v" sid="REV 3:16"/>येकोलायी कि तय कुनकुनो हय, अऊर नहीं ठंडो हय अऊर नहीं गरम, मय तोख अपनो मुंह म सी उगलन जाय रह्यो हय। <verse eid="REV 3:16"/><verse number="17" style="v" sid="REV 3:17"/>तय कह्य हय कि मय धनी आय अऊर धनवान भय गयो हय अऊर मोख कोयी चिज कि कमी नहाय; अऊर यो नहीं जानय कि तय दयालु अऊर बेकार अऊर गरीब अऊर अन्धो अऊर नंगो हय। <verse eid="REV 3:17"/><verse number="18" style="v" sid="REV 3:18"/>येकोच लायी मय तोख सलाह देऊ हय कि आगी म तपायो हुयो शुद्ध सोना मोरो सी ले ले कि तय धनी होय जाये, अऊर सफेद कपड़ा ले ले कि पहिन क तोख अपनो लज्जा को नंगो पन झाक, अऊर अपनी आंखी म लगावन लायी सुर्मा लगाव कि तय देखन लगजो। <verse eid="REV 3:18"/><verse number="19" style="v" sid="REV 3:19"/><note caller="+" style="x"><char style="xo" closed="false">३:१९ </char><char style="xt" closed="false"><ref loc="HEB 12:6">इब्रानियों १२:६</ref></char></note>मय जेको जेकोसी प्रेम करू हय, उन सब ख उलाहना अऊर ताड़ना देऊ हय; येकोलायी साहस म रहो, अऊर पापों सी मन फिरावो। <verse eid="REV 3:19"/><verse number="20" style="v" sid="REV 3:20"/>देख, मय द्वार पर खड़ो हुयो खटखटाऊ हय; यदि कोयी मोरी आवाज सुन क द्वार खोलेंन, त मय ओको जवर अन्दर आय क ओको संग जेवन करू अऊर ऊ मोरो संग।<verse eid="REV 3:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 3:21"/>“जो जय पाये मय ओख अपनो संग अपनो सिंहासन पर बैठाऊं, जसो मय भी जय पा क अपनो बाप को संग ओको सिंहासन पर बैठ गयो। <verse eid="REV 3:21"/><verse number="22" style="v" sid="REV 3:22"/>जेको कान हय ऊ सुन ले की आत्मा मण्डलियों सी का कह्य हय।”<verse eid="REV 3:22"/></para>
  <chapter eid="REV 3"/>
  <chapter number="4" style="c" sid="REV 4"/>
  <para style="s">स्वर्ग म आराधना</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1"/>इन बातों को बाद जो मय न नजर करी त का देखूं हय, कि स्वर्ग म एक द्वार खुल्यो हुयो हय, अऊर जेक मय न पहिले तुरही को जसो आवाज सी अपनो संग बाते करतो सुन्यो होतो, उच कह्य हय, “यहां ऊपर आय जा; अऊर मय हि बाते तोख दिखाऊं, जेको इन बातों को बाद पूरो होनो जरूरी हय।” <verse eid="REV 4:1"/><verse number="2" style="v" sid="REV 4:2"/>फिर तुरतच आत्मा न मोरो पर नियंत्रन करयो। मय न देख्यो कि मोरो सामने स्वर्ग म सिंहासन होतो अऊर ओको पर कोयी विराजमान होतो। <verse eid="REV 4:2"/><verse number="3" style="v" sid="REV 4:3"/>जो ओको पर बैठ्यो हय ऊ यशब अऊर माणिक्य को गोटा जसो दिखायी देवय हय, अऊर ऊ सिंहासन को चारयी तरफ चमकीलो जसो एक इंद्रधनुष दिखायी देवय हय। <verse eid="REV 4:3"/><verse number="4" style="v" sid="REV 4:4"/>ऊ सिंहासन को चारयी तरफ चौबीस सिंहासन अऊर होतो; अऊर इन सिंहासनों पर चौबीस बुजूर्ग लोग सफेद कपड़ा पहिन्यो हुयो बैठ्यो होतो, अऊर उन्को मुंड पर सोनो को मुकुट होतो। <verse eid="REV 4:4"/><verse number="5" style="v" sid="REV 4:5"/><note caller="+" style="x"><char style="xo" closed="false">४:५ </char><char style="xt" closed="false"><ref loc="REV 8:5">प्रकाशितवाक्य ८:५</ref>; <ref loc="REV 11:19">११:१९</ref>; <ref loc="REV 16:18">१६:१८</ref>; </char><char style="xt" closed="false"><ref loc="REV 1:4">प्रकाशितवाक्य १:४</ref></char></note>ऊ सिंहासन म सी बिजली की चमक तथा मेघों की गर्जना निकल रही हय अऊर सिंहासन को सामनेच प्रकाश देन वाली सात मशाले जल रही होती, जो परमेश्वर की सात आत्मायें हंय, <verse eid="REV 4:5"/><verse number="6" style="v" sid="REV 4:6"/>अऊर भी सिंहासन को सामने पारदर्शी काच को स्फटिक समुन्दर जसो होतो।</para>
  <para style="p" vid="REV 4:6">सिंहासन को ठीक सामने तथा ओको दोयी तरफ चार प्रानी होतो, उन्को आगु पीछू आंखीच आंखी होती। <verse eid="REV 4:6"/><verse number="7" style="v" sid="REV 4:7"/>पहिलो प्रानी सिंह को जसो होतो, अऊर दूसरों प्रानी बईल को जसो होतो, अऊर तीसरो प्रानी को मुंह आदमियों को जसो होतो, अऊर चौथो प्रानी उड़तो हुयो गरूड़ को जसो होतो। <verse eid="REV 4:7"/><verse number="8" style="v" sid="REV 4:8"/>चारयी प्रानियों को छे-छे पंखा होतो, अऊर चारयी तरफ अऊर अन्दर आंखीच आंखी होती; अऊर हि रात दिन बिना आराम लियो यो कह्य हंय,</para>
  <para style="q1" vid="REV 4:8">“पवित्र, पवित्र, पवित्र प्रभु परमेश्वर, सर्वशक्तिमान,</para>
  <para style="q2" vid="REV 4:8">जो होतो अऊर जो हय अऊर जो आवन वालो हय।”<verse eid="REV 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9"/>जब हि प्रानी ओको जो सिंहासन पर बैठ्यो होतो, अऊर जो हमेशा हमेशा जीन्दो हय, महिमा अऊर आदर अऊर धन्यवाद करत होतो; <verse eid="REV 4:9"/><verse number="10" style="v" sid="REV 4:10"/>तब चौबीसों बुजूर्ग लोग सिंहासन पर बैठ्यो हय ओको चरनों म गिर क ऊ सदा हमेशा जीन्दो रहन वालो की आराधना करय हय। हि सिंहासन को सामने अपनो मुकुट डाल देवय हय अऊर कह्य हय,<verse eid="REV 4:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11"/>“हे हमरो प्रभु अऊर परमेश्वर, तयच महिमा</para>
  <para style="q2" vid="REV 4:11">अऊर आदर अऊर सामर्थ को लायक हय;</para>
  <para style="q1" vid="REV 4:11">कहालीकि तय नच सब चिजे सृजी अऊर हि</para>
  <para style="q2" vid="REV 4:11">तोरीच इच्छा सी हि अस्तित्व म आयी होती अऊर जीन्दी हय।”<verse eid="REV 4:11"/></para>
  <chapter eid="REV 4"/>
  <chapter number="5" style="c" sid="REV 5"/>
  <para style="s">किताब अऊर मेंढीं को बच्चा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1"/>जो सिंहासन पर बैठ्यो होतो, मय न ओको दायो हाथ म एक किताब अऊर मेम्ना ख देख्यो जो अन्दर अऊर बाहेर लिखी हुयी होती, अऊर वा सात मुहर लगाय क बन्द करी गयी होती। <verse eid="REV 5:1"/><verse number="2" style="v" sid="REV 5:2"/>फिर मय न एक शक्तिशाली स्वर्गदूत ख देख्यो जो ऊचो आवाज सी यो घोषना कर रह्यो होतो, “या किताब ख खोलन अऊर ओकी मुहरें तोड़न को लायक कौन हय?” <verse eid="REV 5:2"/><verse number="3" style="v" sid="REV 5:3"/>पर नहीं स्वर्ग म, नहीं धरती पर, नहीं धरती को खल्लो कोयी वा किताब ख खोलन अऊर वा किताब को अन्दर देखन को लायक कोयी नहीं मिल्यो। <verse eid="REV 5:3"/><verse number="4" style="v" sid="REV 5:4"/>तब मय फूट फूट क रोवन लग्यो, कहालीकि वा किताब ख खोलन यां ओको पर नजर डालन को लायक कोयी नहीं मिल्यो। <verse eid="REV 5:4"/><verse number="5" style="v" sid="REV 5:5"/>येको पर उन बुजूर्ग लोगों म सी एक न मोरो सी कह्यो, “मत रो; देख, यहूदा को वंश को ऊ सिंह जो दाऊद को वंशज हय, ऊ मुहर तोड़न अऊर लपेट्यो हुयो किताब ख खोलन लायी समर्थ हय।”<verse eid="REV 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6"/>तब मय न देख्यो कि मेम्ना सिंहासन को बिचो बिच खड़ो हय। चारयी प्रानियों अऊर उन बुजूर्ग लोगों सी घिरयो हुयो हय, ऊ असो प्रगट भयो कि मानो ओकी बली चढ़ायी गयी हय। ओको सात सिंग होतो अऊर सात आंखी होती; जो परमेश्वर की सात आत्मायें हय उन्ख पूरो धरती पर भेज्यो गयो होतो। <verse eid="REV 5:6"/><verse number="7" style="v" sid="REV 5:7"/>मेम्ना न आय क ओको दायो हाथ सी जो सिंहासन पर बैठ्यो होतो, वा किताब ले ली। <verse eid="REV 5:7"/><verse number="8" style="v" sid="REV 5:8"/>जब ओन किताब ले ली, त हि चारयी प्रानी अऊर चौबीसों बुजूर्ग लोगों न ऊ मेम्ना को सामने घुटना टेक्यो। उन्म सी हर एक को हाथ म वीणा अऊर धूप, जो पवित्र लोगों की प्रार्थनाये हंय, हि सुगन्धित चिजे सी भरयो हुयो सोनो को कटोरा होतो।<verse eid="REV 5:8"/></para>
  <para style="q1">
    <verse number="9" style="v" sid="REV 5:9"/>हि एक नयो गीत गाय रह्यो होतो,</para>
  <para style="q1" vid="REV 5:9">“तय या किताब लेन ख</para>
  <para style="q2" vid="REV 5:9">अऊर येको पर लगी मुहरें खोलन को समर्थ हय</para>
  <para style="q1" vid="REV 5:9">कहालीकि तोरी हत्या बली को रूप म कर दियो गयो होतो</para>
  <para style="q2" vid="REV 5:9">अऊर ओको द्वारा परमेश्वर को लोगों ख हर जाति सी अऊर भाषा सी अऊर सब गोत्रों सी सब राष्ट्रों सी मोल लियो,<verse eid="REV 5:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">५:१० </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:6">प्रकाशितवाक्य १:६</ref>
      </char>
    </note>अऊर उन्ख हमरो परमेश्वर की सेवा करन लायी एक राज्य अऊर याजक बनायो;</para>
  <para style="q2" vid="REV 5:10">अऊर हि धरती पर राज्य करेंन।”<verse eid="REV 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11"/>फिर सी मय न देख्यो, अऊर हजारों अऊर लाखों स्वर्गदूतों को ध्वनियों ख सुन्यो, हि ऊ सिंहासन, उन चार प्रानियों तथा बुजूर्ग लोगों को चारयी तरफ खड़ो होतो,<verse eid="REV 5:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="REV 5:12"/>अऊर हि ऊचो आवाज सी गीत गाय रह्यो होतो;</para>
  <para style="q2" vid="REV 5:12">“ऊ मेम्ना जो मारयो गयो होतो उच सामर्थ, धन, ज्ञान, शक्ति, आदर,</para>
  <para style="q2" vid="REV 5:12">महिमा अऊर स्तुति प्राप्त करन लायक हय!”<verse eid="REV 5:12"/></para>
  <para style="m">
    <verse number="13" style="v" sid="REV 5:13"/>फिर मय न स्वर्ग म अऊर धरती पर, अऊर धरती को खल्लो अऊर समुन्दर को पूरो प्रानियों अऊर ब्रम्हांड को प्रानियों ख यो गातो सुन्यो,</para>
  <para style="q1" vid="REV 5:13">“जो सिंहासन पर बैठ्यो हय ओको अऊर मेम्ना की स्तुति आदर,</para>
  <para style="q2" vid="REV 5:13">महिमा अऊर सामर्थ राज्य</para>
  <para style="q2" vid="REV 5:13">हमेशा हमेशा रहे!”<verse eid="REV 5:13"/></para>
  <para style="m">
    <verse number="14" style="v" sid="REV 5:14"/>अऊर चारयी प्रानियों न आमीन कह्यो, अऊर बुजूर्ग लोगों न घुटना टेक क आराधना करी।<verse eid="REV 5:14"/></para>
  <chapter eid="REV 5"/>
  <chapter number="6" style="c" sid="REV 6"/>
  <para style="s">सात मुहरें</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1"/>फिर मय न देख्यो कि मेम्ना न उन सात मुहरों म सी एक ख खोल्यो; अऊर उन चारयी प्रानियों म सी एक को मेघ गर्जना को जसो आवाज सुन्यो, “आवो!” <verse eid="REV 6:1"/><verse number="2" style="v" sid="REV 6:2"/>मय न नजर डाली त पायो कि मोरो सामने एक सफेद घोड़ा हय, अऊर ओको सवार धनुष लियो हुयो हय; अऊर ओख एक मुकुट दियो गयो, अऊर ऊ विजय करतो हुयो निकल्यो कि जीत हासिल करे।<verse eid="REV 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3"/>जब मेम्ना न दूसरी मुहर खोल्यो, त मय न दूसरों प्रानी ख यो कहतो सुन्यो, “आवो!” <verse eid="REV 6:3"/><verse number="4" style="v" sid="REV 6:4"/>फिर एक अऊर घोड़ा आयो जो लाल रंग को होतो; ओको पर बैठ्यो सवार ख या शक्ति दी गयी कि धरती सी शान्ति छीन ले, अऊर लोगों सी परस्पर हत्यायें करवावन लायी। ओख एक बड़ी तलवार दी गयी।<verse eid="REV 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5"/>जब मेम्ना न तीसरी मुहर खोली, त मय न तीसरो प्रानी ख यो कहतो सुन्यो, “आवो!” मय न नजर करी, अऊर देखो एक कारो घोड़ा हय, अऊर ओको सवार को हाथ म एक तराजू हय; <verse eid="REV 6:5"/><verse number="6" style="v" sid="REV 6:6"/>अऊर मय न उन चारयी प्रानियों को बीच म सी एक आवाज कहतो सुन्यो, “एक दिन की मजूरी को बदला एक दिन को खान को गहूं को चुन अऊर एक दिन की मजूरी को लायी तीन दिन तक खान को जौ, पर जैतून को झाड़ अऊर अंगूररस की बाड़ियों ख हानि मत पहुंचावों!”<verse eid="REV 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7"/>जब ओन चौथी मुहर खोली, त मय न चौथो प्रानी को आवाज यो कहतो सुन्यो, “आवो!” <verse eid="REV 6:7"/><verse number="8" style="v" sid="REV 6:8"/>फिर मय न नजर करी, अऊर मोरो जसो, एक पीलो रंग को घोड़ा होतो; अऊर ओको सवार को नाम मृत्यु होतो, अऊर अधोलोक ओको पीछू पीछू होतो; अऊर उन्ख धरती की एक चौथाई पर यो अधिकार दियो गयो कि युद्ध, अकाल, महामारी, अऊर धरती को जंगली पशु को द्वारा लोगों ख मार डाले।<verse eid="REV 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9"/>जब ओन पाचवी मुहर खोली, त मय न वेदी को खल्लो उन्को आत्मावों ख देख्यो जो परमेश्वर को वचनों को प्रचार करन को वजह अऊर ऊ गवाहों म विश्वास लायक रहन को वजह जो उन्न दी होती ओको वजह मारयो गयो होतो। <verse eid="REV 6:9"/><verse number="10" style="v" sid="REV 6:10"/>उन्न बड़ो आवाज सी पुकार क कह्यो, “हे सर्वशक्तिमान प्रभु, हे पवित्र अऊर सत्य; तय कब तक धरती को न्याय नहीं करजो? अऊर हम्ख मारन वालो ख कब तक सजा नहीं देजो?” <verse eid="REV 6:10"/><verse number="11" style="v" sid="REV 6:11"/>उन्म सी हर एक ख सफेद कपड़ा दियो गयो, अऊर उन्को सी कह्यो गयो कि अऊर थोड़ी देर तक आराम करो, जब तक कि उन्को उन संगी सेवकों अऊर विश्वासियों कि मरन की संख्या पूरी नहीं होय जावय जिन्की वसीच हत्या करी जान वाली हय जसी तुम्हरी करी गयी हय।<verse eid="REV 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">६:१२ </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:13">प्रकाशितवाक्य ११:१३</ref>; <ref loc="REV 16:18">१६:१८</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:29">मत्ती २४:२९</ref>; <ref loc="MRK 13:24">मरकुस १३:२४</ref>,<ref loc="MRK 13:25">२५</ref>; <ref loc="LUK 21:25">लूका २१:२५</ref></char>
    </note>जब मेम्ना न छठवी मुहर खोली, त मय न देख्यो कि एक बड़ो भूईडोल भयो, अऊर सूरज असो कालो पड़ गयो हय जसो कोयी शोक मनातो हुयो आदमी को कपड़ा होवय हंय अऊर पूरो चन्दा खून को जसो लाल भय गयो। <verse eid="REV 6:12"/><verse number="13" style="v" sid="REV 6:13"/>आसमान को तारा धरती पर असो गिर पड़्यो जसो बड़ो तूफान सी हल क अंजीर को झाड़ म सी कच्चो फर झड़य हंय। <verse eid="REV 6:13"/><verse number="14" style="v" sid="REV 6:14"/><note caller="+" style="x"><char style="xo" closed="false">६:१४ </char><char style="xt" closed="false"><ref loc="REV 16:20">प्रकाशितवाक्य १६:२०</ref></char></note>आसमान असो सरक गयो जसो किताब ख लपेटन को जसो सुकड़ क लपेट गयो; अऊर हर एक पहाड़ी, अऊर द्वीप, अपनो अपनो जागा म हट गयो। <verse eid="REV 6:14"/><verse number="15" style="v" sid="REV 6:15"/>तब धरती को राजा, अऊर मुख्य याजक, सरदार, धनवान अऊर शक्तिशाली लोग, अऊर हर एक सेवक अऊर स्वतंत्र आदमी पहाड़ियों की गुफावों म अऊर चट्टानों म जाय क लूक्यो, <verse eid="REV 6:15"/><verse number="16" style="v" sid="REV 6:16"/><note caller="+" style="x"><char style="xo" closed="false">६:१६ </char><char style="xt" closed="false"><ref loc="LUK 23:30">लूका २३:३०</ref></char></note>अऊर पहाड़ियों अऊर चट्टानों सी कहन लग्यो, “हम पर गिर पड़ो; अऊर हम्ख ओको मुंह सी जो सिंहासन पर बैठ्यो हय, अऊर मेम्ना को प्रकोप सी हम्ख लूकाय लेवो। <verse eid="REV 6:16"/><verse number="17" style="v" sid="REV 6:17"/>कहालीकि उन्को प्रकोप को भयानक दिन आय पहुंच्यो हय, असो कौन हय जो ओको सामना कर सकय हय?”<verse eid="REV 6:17"/></para>
  <chapter eid="REV 6"/>
  <chapter number="7" style="c" sid="REV 7"/>
  <para style="s">एक लाख चौवालीस हजार इस्राएल को लोग</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1"/>येको बाद मय न धरती को चारयी कोना पर चार स्वर्गदूत खड़ो देख्यो। हि धरती को चारयी हवावों ख रोक्यो हुयो होतो ताकि धरती पर समुन्दर पर कोयी झाड़ पर हवा नहीं चले। <verse eid="REV 7:1"/><verse number="2" style="v" sid="REV 7:2"/>फिर मय न एक अऊर स्वर्गदूत ख जीवतो परमेश्वर की मुहर लियो हुयो पूर्व सी ऊपर को तरफ आवतो देख्यो; ओन उन चारयी स्वर्गदूतों सी जिन्ख धरती अऊर समुन्दर की हानि करन को अधिकार दियो गयो होतो, ऊचो आवाज सी पुकार क कह्यो, <verse eid="REV 7:2"/><verse number="3" style="v" sid="REV 7:3"/>“जब तक हम अपनो परमेश्वर को सेवकों को मस्तक पर मुहर नहीं लगाय देजे, तब तक धरती अऊर समुन्दर अऊर झाड़ों ख हानि मत पहुंचाजो।” <verse eid="REV 7:3"/><verse number="4" style="v" sid="REV 7:4"/>जिन पर परमेश्वर की मुहर दी गयी मय न उन्की गिनती सुनी, मतलब इस्राएल की सन्तानों को बारा गोत्रों म सी एक लाख चौवालीस हजार पर मुहर दी गयी: <verse eid="REV 7:4"/><verse number="5" style="v" sid="REV 7:5"/>हर एक गोत्र म सी बारा हजार पर मुहर लगायी गयी, यहूदा को गोत्र म सी बारा हजार पर मुहर दी गयी: रूबेन को गोत्र म सी बारा हजार पर, गाद को गोत्र म सी बारा हजार पर। <verse eid="REV 7:5"/><verse number="6" style="v" sid="REV 7:6"/>आशेर को गोत्र म सी बारा हजार पर, नप्ताली को गोत्र म सी बारा हजार पर, मनश्शिह को गोत्र म सी बारा हजार पर, <verse eid="REV 7:6"/><verse number="7" style="v" sid="REV 7:7"/>शिमोन को गोत्र म सी बारा हजार पर, लेवी को गोत्र म सी बारा हजार पर, इस्साकार को गोत्र म सी बारा हजार पर, <verse eid="REV 7:7"/><verse number="8" style="v" sid="REV 7:8"/>जबूलून को गोत्र म सी बारा हजार पर, यूसुफ को गोत्र म सी बारा हजार पर, अऊर बिन्यामीन को गोत्र म सी बारा हजार पर मुहर दी गयी।<verse eid="REV 7:8"/></para>
  <para style="s">एक बड़ी भीड़</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9"/>येको बाद मय न नजर करी, अऊर देखो, हर एक जाति अऊर गोत्र, अऊर राष्ट्र अऊर भाषा म सी एक असी बड़ी भीड़, जेक कोयी गिन नहीं सकत होतो, सफेद कपड़ा पहिन्यो अऊर अपनो हाथों म खजूर की डगाली लियो हुयो सिंहासन को सामने अऊर मेम्ना को सामने खड़ी होती, <verse eid="REV 7:9"/><verse number="10" style="v" sid="REV 7:10"/>अऊर बड़ी आवाज सी पुकार क कह्य हय, “उद्धार को लायी हमरो परमेश्वर को, जो सिंहासन पर बैठ्यो हय, हमरो परमेश्वर को तरफ सी अऊर मेम्ना को तरफ सी उद्धार हय!” <verse eid="REV 7:10"/><verse number="11" style="v" sid="REV 7:11"/>अऊर पूरो स्वर्गदूत ऊ सिंहासन अऊर बुजूर्ग लोग अऊर चारयी प्रानियों को चारयी तरफ खड़ो हंय; फिर हि सिंहासन को सामने मुंह को बल गिर पड़्यो अऊर परमेश्वर की आराधना करी, <verse eid="REV 7:11"/><verse number="12" style="v" sid="REV 7:12"/>अऊर कह्यो “आमीन! हमरो परमेश्वर की स्तुति अऊर महिमा अऊर ज्ञान अऊर धन्यवाद अऊर आदर अऊर सामर्थ अऊर शक्ति हमेशा हमेशा बनी रहे। आमीन!”<verse eid="REV 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13"/>येको पर बुजूर्ग लोगों म सी एक न मोरो सी कह्यो, “यो सफेद कपड़ा पहिन्यो हुयो कौन आय, अऊर कहां सी आयो हंय?”<verse eid="REV 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">७:१४ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:21">मत्ती २४:२१</ref>; <ref loc="MRK 13:19">मरकुस १३:१९</ref></char>
    </note>मय न ओको सी कह्यो, “हे मालिक, तयच जानय हय।”</para>
  <para style="p" vid="REV 7:14">ओन मोरो सी कह्यो, “यो हि लोग आय, जो कठोर यातनावों को बीच सी होय क आयो हंय; इन्न अपनो-अपनो कपड़ा मेम्ना को खून म धोय क सफेद करयो हंय। <verse eid="REV 7:14"/><verse number="15" style="v" sid="REV 7:15"/>योच वजह हि परमेश्वर को सिंहासन को सामने हंय, अऊर ओको मन्दिर म दिन-रात ओकी सेवा करय हंय, अऊर जो सिंहासन पर बैठ्यो हय, हि ओकी उपस्थिति म उन्की रक्षा करेंन। <verse eid="REV 7:15"/><verse number="16" style="v" sid="REV 7:16"/>हि फिर सी भूखो अऊर प्यासो नहीं रहेंन; अऊर नहीं त सूरज कड़कड़ाती धूप उन्ख जलाय पायेंन, <verse eid="REV 7:16"/><verse number="17" style="v" sid="REV 7:17"/>कहालीकि मेम्ना जो सिंहासन को बीच म हय ऊ उन्को चरवाहा रहेंन, अऊर उन्ख जीवन देन वालो पानी को झरना को जवर लिजायो करेंन; अऊर परमेश्वर उन्की आंखी सी सब आसु पोछ डालेंन।”<verse eid="REV 7:17"/></para>
  <chapter eid="REV 7"/>
  <chapter number="8" style="c" sid="REV 8"/>
  <para style="s">सातवी मुहर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1"/>जब ओन सातवी मुहर खोली, त स्वर्ग म अरधो तास तक सन्नाटा छाय गयो। <verse eid="REV 8:1"/><verse number="2" style="v" sid="REV 8:2"/>तब मय न उन सातों स्वर्गदूतों ख देख्यो जो परमेश्वर को सामने खड़ो रह्य हंय, अऊर उन्ख सात तुरही दी गयी होती।<verse eid="REV 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3"/>फिर एक स्वर्गदूत सोनो को धूपदान लियो हुयो आयो, अऊर वेदी को जवर खड़ो भयो; अऊर ओख धूप दियो गयो कि सब परमेश्वर को लोगों की प्रार्थनावों को संग सोनो की वा वेदी पर, जो सिंहासन को सामने हय चढ़ाये। <verse eid="REV 8:3"/><verse number="4" style="v" sid="REV 8:4"/>ऊ धूप को धुवा परमेश्वर को लोगों की प्रार्थनावों सहित स्वर्गदूत को हाथ सी परमेश्वर को सामने पहुंच गयो। <verse eid="REV 8:4"/><verse number="5" style="v" sid="REV 8:5"/><note caller="+" style="x"><char style="xo" closed="false">८:५ </char><char style="xt" closed="false"><ref loc="REV 11:19">प्रकाशितवाक्य ११:१९</ref>; <ref loc="REV 16:18">१६:१८</ref></char></note>फिर स्वर्गदूत न ऊ धूपदान ख पकड़्यो ओख वेदी की आगी भरयो अऊर जमीन पर फेक दियो। ओको पर मेघों की गर्जना अऊर भीषन आवाज अऊर बिजली की चमक अऊर भूईडोल होन लग्यो।<verse eid="REV 8:5"/></para>
  <para style="s">सात तुरही</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6"/>तब हि सातों स्वर्गदूत जिन्को जवर सात तुरही होती उन्ख फूकन ख तैयार भयो।<verse eid="REV 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7"/>पहिले स्वर्गदूत न तुरही फूकी, अऊर खून सी मिली हुयी गारगोटी अऊर आगी पैदा भयी, अऊर धरती पर खल्लो कुड़ायी गयी। जेकोसी धरती को एक तिहाई भाग जर क भस्म भय गयी, एक तिहाई झाड़ जर गयो, अऊर सब हरी घास भी जल गयी।<verse eid="REV 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8"/>दूसरों स्वर्गदूत न तुरही फूकी, त मानो आगी को जलतो हुयो एक बड़ो पहाड़ी जसो समुन्दर म फेक दियो गयो हो। येको सी एक तिहाई समुन्दर खून म बदल गयो, <verse eid="REV 8:8"/><verse number="9" style="v" sid="REV 8:9"/>अऊर समुन्दर को एक तिहाई जीवजन्तु मर गयो अऊर एक तिहाई जहाजें नाश भय गयो।<verse eid="REV 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10"/>तीसरो स्वर्गदूत न तुरही फूकी, अऊर एक बड़ो तारा जो मशाल को जसो जलत हुयो स्वर्ग सी टूट्यो, अऊर एक तिहाई नदियों म अऊर झरना को पानी पर जाय पड़्यो। <verse eid="REV 8:10"/><verse number="11" style="v" sid="REV 8:11"/>ऊ तारा को नाम कड़वाहट होतो; अऊर एक तिहाई पानी कड़वाहट म बदल गयो, अऊर बहुत सो आदमी ऊ पानी ख पीनो सी बहुत सो लोग मर गयो कहालीकि पानी कड़ू भय गयो होतो।<verse eid="REV 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12"/>जब चौथो स्वर्गदूत न तुरही फूकी, त एक तिहाई सूरज अऊर संग म एक तिहाई चन्दा अऊर एक तिहाई तारा पर मुसीबत आयी। येकोलायी उन्को एक तिहाई हिस्सा कालो पड़ गयो परिनाम स्वरूप एक तिहाई दिन तथा एक तिहाई रात अन्धारो म डुब गयो।<verse eid="REV 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13"/>जब मय न फिर देख्यो, त आसमान को बीच म एक गरूड़ ख उड़तो अऊर ऊचो आवाज सी यो कहतो सुन्यो, “उन तीन स्वर्गदूतों की तुरही को आवाज को वजह, जिन्को फूकनो अभी बाकी हय, धरती को रहन वालो पर कष्ट हो, कष्ट हो, कष्ट हो!”<verse eid="REV 8:13"/></para>
  <chapter eid="REV 8"/>
  <chapter number="9" style="c" sid="REV 9"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1"/>जब पाचवों स्वर्गदूत न तुरही फूकी, त मय न स्वर्ग सी धरती पर एक तारा गिरतो हुयो देख्यो, अऊर ओख अधोलोक कुण्ड की कुंजी दी गयी। <verse eid="REV 9:1"/><verse number="2" style="v" sid="REV 9:2"/>फिर ऊ तारा न अधोलोक कुण्ड ख खोल्यो, अऊर ओको म सी असो धुवा निकल रह्यो होतो जसो ऊ एक बड़ी भट्टी सी निकल रह्यो हय, अऊर अधोलोक सी निकल्यो हुयो सी सूरज अऊर हवा कालो पड़ गयो। <verse eid="REV 9:2"/><verse number="3" style="v" sid="REV 9:3"/>ऊ धुवा म सी धरती पर टिड्डियां निकली, अऊर उन्ख धरती की बिच्छूवों को जसी शक्ति दी गयी। <verse eid="REV 9:3"/><verse number="4" style="v" sid="REV 9:4"/>उन्को सी कह्यो गयो कि नहीं धरती की घास ख, नहीं कोयी हरियाली ख, नहीं कोयी झाड़ ख हानि पहुंचावों, केवल उन आदमियों ख हानि पहुंचावों जिन्को मस्तक पर परमेश्वर की मुहर नहीं होती। <verse eid="REV 9:4"/><verse number="5" style="v" sid="REV 9:5"/>टिड्डियां को दल ख निर्देश दियो गयो होतो कि उन्ख लोगों ख मार डालन को त नहीं पर पाच महीना तक तकलीफ देन को अधिकार दियो गयो: अऊर उन्की यातना असी होती जसी बिच्छू को डंक मारनो सी आदमी ख होवय हय। <verse eid="REV 9:5"/><verse number="6" style="v" sid="REV 9:6"/>उन पाच महीना को अन्दर आदमी अपनी मृत्यु ख ढूंढेंन अऊर नहीं पायेंन; मरन की लालसा करेंन, अऊर उन्को सी मृत्यु दूर भगेंन।<verse eid="REV 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7"/>हि टिड्डियां लड़ाई को लायी तैयार करयो हुयो घोड़ा को जसी दिख रह्यो होतो। अऊर उन्को मुंड पर सुनहरी सोनो को मुकुट होतो; अऊर उन्को मुंह आदमियों को जसो दिख रह्यो होतो। <verse eid="REV 9:7"/><verse number="8" style="v" sid="REV 9:8"/>उन्को बाल बाईयों को बाल जसो अऊर दात सिंह को दात जसो होतो। <verse eid="REV 9:8"/><verse number="9" style="v" sid="REV 9:9"/>उन्की छाती असी दिख रही होती मानो लोहा की झिलम हो; अऊर उन्को पंखा को आवाज लड़ाई म जातो हुयो बहुत सारो घोड़ा को रथों सी पैदा हुयो आवाज को जसी होती। <verse eid="REV 9:9"/><verse number="10" style="v" sid="REV 9:10"/>उन्की पूछी बिच्छूवों को डंक को जसी होती अऊर उन्म लोगों ख पाच महीना तक दु:ख पहुंचान की शक्ति मिली होती, <verse eid="REV 9:10"/><verse number="11" style="v" sid="REV 9:11"/>अधोलोक को दूत उन पर राजा होतो; ओको नाम इब्रानी म अबद्दोन, अऊर यूनानी म अपुल्लयोन जेको अर्थ हय “विनाशक।”<verse eid="REV 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12"/>पहिली विपत्ति खतम भय गयी हय, देखो, अब येको बाद दोय विपत्तिया अऊर आवन वाली हंय।<verse eid="REV 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13"/>फिर छठवो स्वर्गदूत न तुरही फूकी त सोनो की वेदी जो परमेश्वर को सामने हय ओको सींगो म सी मय न असो आवाज सुन्यो, <verse eid="REV 9:13"/><verse number="14" style="v" sid="REV 9:14"/>मानो कोयी छठवो स्वर्गदूत सी, जेको जवर तुरही होती, कह्य रह्यो हय, “उन चार स्वर्गदूतों ख जो बड़ी नदी फरात को जवर बन्ध्यो हुयो हंय, खोल दे।” <verse eid="REV 9:14"/><verse number="15" style="v" sid="REV 9:15"/>त चारयी दूत छोड़ दियो गयो हि उच घड़ी, उच दिन, उच महीना, अऊर उच साल को लायी तैयार रख्यो गयो होतो, ताकी हि एक तिहाई मानव जाति ख मार डाले। <verse eid="REV 9:15"/><verse number="16" style="v" sid="REV 9:16"/>उन्की घुड़सवार सैनिकों की गिनती बीस करोड़ होती; मय न उनकी गिनती सुनी। <verse eid="REV 9:16"/><verse number="17" style="v" sid="REV 9:17"/>मोख यो दर्शन म घोड़ा अऊर उन्को असो सवार दिखायी दियो जिन्की छाती की झिलम धधकती आगी जसी लाल, अऊर गहरो निलो, अऊर गन्धक जसो पिलो दिखायी दियो, अऊर घोड़ा की मुंड सिंहों को मुंड को जसो अऊर उन्को मुंह सी आगी, धुवा अऊर गन्धक निकलन को जसो दिखायी दियो। <verse eid="REV 9:17"/><verse number="18" style="v" sid="REV 9:18"/>इन तीन महामारियों मतलब उन्को मुंह सी निकल रही आगी, धुवा अऊर गन्धक सी एक तिहाई मानव जाति ख मार डाल्यो गयो। <verse eid="REV 9:18"/><verse number="19" style="v" sid="REV 9:19"/>कहालीकि उन घोड़ा की सामर्थ उन्को मुंह अऊर उन्की पूछी म होती; येकोलायी कि उन्की पूछी सांपो जसी होती, अऊर उन पूछी की मुंड भी होतो अऊर इन्को सी हि हानि पहुंचात होतो।<verse eid="REV 9:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20"/>इन पर बाकी को असो मानव जाति न जो इन महामारी सी भी नहीं मरयो गयो होतो, अपनो हाथों को बनायो हुयो चिजों सी मन नहीं फिरायो, तथा दुष्ट आत्मावों की, यां सोनो, चांदी, कासा, गोटा अऊर लकड़ी की मूर्तियों की आराधना नहीं छोड़ी जो नहीं देख सकय हय, नहीं सुन सकय हय, अऊर नहीं चल सकय हंय। <verse eid="REV 9:20"/><verse number="21" style="v" sid="REV 9:21"/>अऊर जो हत्यायें, जादूटोना, व्यभिचार, अऊर चोरी उन्न करी होती, उन्को सी मन नहीं फिरायो।<verse eid="REV 9:21"/></para>
  <chapter eid="REV 9"/>
  <chapter number="10" style="c" sid="REV 10"/>
  <para style="s">स्वर्गदूत अऊर छोटी किताब</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1"/>फिर मय न स्वर्ग सी खल्लो उतरतो हुयो एक अऊर सामर्थी स्वर्गदूत ख देख्यो। ओन बादर ख ओढ़्यो हुयो होतो, ओको मुंड को आजु बाजू एक इंद्रधनुष होतो। ओको मुंह सूरज को जसो होतो, अऊर ओको पाय आगी को खम्बा को जसो होतो। <verse eid="REV 10:1"/><verse number="2" style="v" sid="REV 10:2"/>ओको हाथ म एक छोटी सी खुली हुयी किताब होती। ओन अपनो दायो पाय समुन्दर पर अऊर बायो पाय धरती पर रख दियो, <verse eid="REV 10:2"/><verse number="3" style="v" sid="REV 10:3"/>फिर ऊ सिंह को जसो गरजतो हुयो ऊचो आवाज म चिल्लायो, त सात गर्जन को संग आवाज सुनायी दियो। <verse eid="REV 10:3"/><verse number="4" style="v" sid="REV 10:4"/>जब सातों गर्जन को आवाज सुनायी दे दियो, त मय लिखन ख होतो, पर मय न स्वर्ग सी यो आवाज सुन्यो, “जो बाते गर्जन को उन सात शब्दों सी सुनी हंय उन्ख गुप्त रखो, येख लिखो मत!”<verse eid="REV 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5"/>जो स्वर्गदूत ख मय न समुन्दर अऊर धरती पर खड़ो देख्यो होतो, ओन अपनो दायो हाथ स्वर्ग को तरफ उठायो, <verse eid="REV 10:5"/><verse number="6" style="v" sid="REV 10:6"/>अऊर जो हमेशा जीन्दो रह्य हय, अऊर जेन स्वर्ग ख, धरती ख, अऊर समुन्दर ख, अऊर जो कुछ उन म हय उन्ख बनायो हय। स्वर्गदूत न कह्यो, “अब कोयी देर नहीं होयेंन! <verse eid="REV 10:6"/><verse number="7" style="v" sid="REV 10:7"/>पर जब सातवों स्वर्गदूत ख सुनन म आयेंन मतलब जब ऊ अपनी तुरही फूकन पर होना तब भी परमेश्वर की वा गुप्त योजना पूरी होय जायेंन, जेक ओन अपनो सेवकों अऊर भविष्यवक्तावों पर घोषित करयो।”<verse eid="REV 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8"/>जो आवाज ख मय न स्वर्ग सी बोलतो सुन्यो होतो, ऊ फिर मोरो संग बाते करन लग्यो, “जा, जो स्वर्गदूत समुन्दर अऊर धरती पर खड़ो हय, ओको हाथ म की खुली हुयी किताब ले ले।”<verse eid="REV 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9"/>मय न स्वर्गदूत को जवर जाय क कह्यो, “या छोटी किताब मोख दे।” ओन मोरो सी कह्यो, “ले, येख खाय ले; येको सी त तोरो पेट खट्टो होय जायेंन, पर तोरो मुंह म यो शहेद को जसो मीठो होय जायेंन।”<verse eid="REV 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10"/>येकोलायी मय वा छोटी किताब ऊ स्वर्गदूत को हाथ सी ले क खाय गयो। ऊ मोरो मुंह म शहेद जसो मीठो त लग्यो, पर जब मय ओख गिटक गयो, त मोरो पेट खट्टो भय गयो। <verse eid="REV 10:10"/><verse number="11" style="v" sid="REV 10:11"/>तब मोरो सी यो कह्यो गयो, “तोख बहुत सो लोगों, जातियों, भाषावों, अऊर राजावों को बारे म फिर भविष्यवानी करनो पड़ेंन।”<verse eid="REV 10:11"/></para>
  <chapter eid="REV 10"/>
  <chapter number="11" style="c" sid="REV 11"/>
  <para style="s">दोय गवाह</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1"/>फिर मोख नापन लायी एक छड़ी दी गयी, अऊर कोयी न कह्यो, “उठ, परमेश्वर को मन्दिर अऊर वेदी, ख नाप ले, अऊर मन्दिर म आराधना करन वालो की गिनती कर ले। <verse eid="REV 11:1"/><verse number="2" style="v" sid="REV 11:2"/><note caller="+" style="x"><char style="xo" closed="false">११:२ </char><char style="xt" closed="false"><ref loc="LUK 21:24">लूका २१:२४</ref></char></note>पर मन्दिर को बाहेर को आंगन छोड़ दे; ओख मत नाप कहालीकि ऊ गैरयहूदी ख दियो गयो हय, अऊर हि पवित्र नगर ख बयालीस महीना तक पाय को खल्लो रौंद देयेंन। <verse eid="REV 11:2"/><verse number="3" style="v" sid="REV 11:3"/>मय अपनो दोय गवाहों ख पूरो अधिकार देऊ अऊर ऊ एक हजार दोय सौ साठ दिन तक भविष्यवानी करेंन। हि उन्को बोरा को असो कपड़ा धारन करेंन जिन्ख शोक प्रदर्शित करन लायी पहिनायो जावय हय।”<verse eid="REV 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4"/>यो उच जैतून को दोय झाड़ अऊर दोय दीवट आय जो धरती को प्रभु को सामने खड़ो रह्य हंय। <verse eid="REV 11:4"/><verse number="5" style="v" sid="REV 11:5"/>यदि कोयी उन्ख हानि पहुंचानो चाहवय हय, त उन्को मुंह सी आगी निकल क उन्को दुश्मनों ख भस्म करय हय; अऊर यदि कोयी उन्ख हानि पहुंचानो चाहेंन, त जरूर योच रीति सी मार डाल्यो जायेंन। <verse eid="REV 11:5"/><verse number="6" style="v" sid="REV 11:6"/>उन्ख अधिकार हय कि आसमान ख बन्द करे, कि उन्की भविष्यवानी को दिनो म पानी नहीं बरसे; अऊर उन्ख सब पानी को झरना पर अधिकार हय कि ओख खून म बदल सके, अऊर उन्ख यो भी अधिकार हय की हि जब चाहे उतनो बार हर तरह की विपत्ति धरती पर लाय सकय हय।<verse eid="REV 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">११:७ </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:5-7">प्रकाशितवाक्य १३:५-७</ref>; <ref loc="REV 17:8">१७:८</ref></char>
    </note>जब हि परमेश्वर को सन्देश की घोषना कर चुक्यो होना तब अधोलोक म सी हिंसक पशु निकल क उन्को विरोध म लड़ाई करेंन। अऊर ऊ उन्ख मार देयेंन। <verse eid="REV 11:7"/><verse number="8" style="v" sid="REV 11:8"/>उन्को लाश ऊ महानगर की सड़क पर पड़्यो रहेंन, यो नगर चिन्ह आत्मिक रीति सी सदोम अऊर मिस्र कहलावय हय, योच उन्को प्रभु ख भी क्रूस पर चढ़ाय क मारयो गयो होतो। <verse eid="REV 11:8"/><verse number="9" style="v" sid="REV 11:9"/>सब राष्ट्रों सब वंशों सब भाषावों अऊर सब गोत्रों को लोग उन्को लाशों ख साढ़े तीन दिन तक देखतो रहेंन, अऊर उन्को लाशों ख कब्र म रखन नहीं देयेंन। <verse eid="REV 11:9"/><verse number="10" style="v" sid="REV 11:10"/>धरती को रहन वालो उन्की मृत्यु सी खुश अऊर मगन होयेंन, अऊर एक दूसरों को जवर दान भेजेंन, कहालीकि इन दोयी भविष्यवक्तावों न धरती को रहन वालो ख बहुत सतायो होतो। <verse eid="REV 11:10"/><verse number="11" style="v" sid="REV 11:11"/>पर साढ़े तीन दिन को बाद परमेश्वर को तरफ सी जीवन को श्वास उन्म सिरयो, अऊर हि अपनो पाय को बल खड़ो भय गयो, अऊर उन्को देखन वालो पर बड़ो डर छाय गयो। <verse eid="REV 11:11"/><verse number="12" style="v" sid="REV 11:12"/>तब हि दोय भविष्यवक्तावों ख स्वर्ग सी एक बड़ो आवाज सुनायी दियो, “यहां ऊपर आय आवो!” त हि स्वर्ग म चली गयो। उन्ख ऊपर जातो हुयो उन्को दुश्मनों न देख्यो। <verse eid="REV 11:12"/><verse number="13" style="v" sid="REV 11:13"/><note caller="+" style="x"><char style="xo" closed="false">११:१३ </char><char style="xt" closed="false"><ref loc="REV 6:12">प्रकाशितवाक्य ६:१२</ref>; <ref loc="REV 16:18">१६:१८</ref></char></note>फिर उच घड़ी एक बड़ो भूईडोल भयो, अऊर नगर को दसवों भाग गिर पड़्यो; अऊर ऊ भूईडोल सी सात हजार आदमी मर गयो, अऊर हि डर गयो होतो अऊर स्वर्ग को परमेश्वर की महानता की महिमा करत होतो।<verse eid="REV 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14"/>दूसरी विपत्ति बीत गयी; पर देखो, तीसरी विपत्ति जल्दी आवन वाली हय।<verse eid="REV 11:14"/></para>
  <para style="s">सातवी तुरही</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15"/>जब सातवों स्वर्गदूत न तुरही फूकी, त आसमान म तेज आवाज होन लगी। “हि कह्य रही होती अब जगत को राज्य हमरो प्रभु को आय अऊर ओको मसीह म ओको राज्य हमेशा हमेशा को लायी रहेंन।” <verse eid="REV 11:15"/><verse number="16" style="v" sid="REV 11:16"/>तब चौबीसों बुजूर्ग लोग जो परमेश्वर को सामने अपनो अपनो सिंहासन पर बैठ्यो होतो, मुंह को बल गिर क परमेश्वर की आराधना कर रह्यो होतो, <verse eid="REV 11:16"/><verse number="17" style="v" sid="REV 11:17"/>यो कहन लग्यो,</para>
  <para style="q1" vid="REV 11:17">“हे सर्वशक्तिमान प्रभु परमेश्वर, जो हय अऊर जो होतो,</para>
  <para style="q1" vid="REV 11:17">हम तोरो धन्यवाद करजे हंय कि तय न अपनी महाशक्ति सी सब को शासन को सुरूवात करयो होतो।<verse eid="REV 11:17"/></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18"/>राष्ट्रों को लोग गुस्सा होतो,</para>
  <para style="q2" vid="REV 11:18">पर तोरो प्रकोप आय पड़्यो,</para>
  <para style="q2" vid="REV 11:18">अऊर ऊ समय आय पहुंच्यो हय कि मरयो हुयो को न्याय करयो जाये,</para>
  <para style="q1" vid="REV 11:18">अऊर तोरो सेवक भविष्यवक्तावों</para>
  <para style="q2" vid="REV 11:18">अऊर पवित्र लोगों ख अऊर उन छोटो बड़ो ख</para>
  <para style="q2" vid="REV 11:18">जो तोरो नाम सी डरय हंय प्रतिफल दियो जाये,</para>
  <para style="q1" vid="REV 11:18">अऊर जो धरती बिगाड़ रह्यो हय उन्ख नाश करयो जाये।”<verse eid="REV 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">११:१९ </char>
      <char style="xt" closed="false">
        <ref loc="REV 8:5">प्रकाशितवाक्य ८:५</ref>; <ref loc="REV 16:18">१६:१८</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="REV 16:21">प्रकाशितवाक्य १६:२१</ref>
      </char>
    </note>अऊर परमेश्वर को जो मन्दिर स्वर्ग म हय ऊ खोल्यो गयो, अऊर ओको मन्दिर म ओको वाचा को सन्दूक दिखायी दियो। अऊर बिजलियां, शब्द, गर्जन, भूईडोल भयो अऊर बड़ी गारगोटी गिरयो।<verse eid="REV 11:19"/></para>
  <chapter eid="REV 11"/>
  <chapter number="12" style="c" sid="REV 12"/>
  <para style="s">बाई अऊर अजगर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1"/>फिर आसमान म एक बड़ो चिन्ह दिखायी दियो, मतलब एक बाई जो सूरज ओढ़्यो हुयी होती, अऊर चन्दा ओको पाय खल्लो होतो, अऊर ओको मुंड पर बारा तारा को मुकुट होतो। <verse eid="REV 12:1"/><verse number="2" style="v" sid="REV 12:2"/>वा गर्भवती भयी, अऊर वा चिल्लावत होती, कहालीकि वा बच्चा जनन की पीड़ा म होती।<verse eid="REV 12:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3"/>एक अऊर रहस्यमय चिन्ह आसमान म दिखायी दियो; अऊर देखो, एक बड़ो लाल अजगर होतो, जेको सात मुंड अऊर दस सींग होतो, अऊर ओको मुंड पर सात राजमुकुट होतो। <verse eid="REV 12:3"/><verse number="4" style="v" sid="REV 12:4"/>ओकी पूछी न आसमान को तारा की एक तिहाई हिस्सा ख खीच क धरती पर फेक दियो। वा बाई जो बच्चा ख जनम देन वाली होती, ऊ अजगर ओको सामने खड़ो भयो कि जब वा बच्चा ख जनम दे, त ऊ बच्चा ख गिटक जाये। <verse eid="REV 12:4"/><verse number="5" style="v" sid="REV 12:5"/>फिर वा बाई न एक बच्चा ख जनम दियो जो एक लड़का होतो अऊर ऊ बच्चा ख सब राष्ट्रों पर लोहा की सलाक को संग शासन करनो होतो, पर ऊ बच्चा ख उठाय क परमेश्वर अऊर ओको सिंहासन को सामने लिजायो गयो। <verse eid="REV 12:5"/><verse number="6" style="v" sid="REV 12:6"/>अऊर वा बाई ऊ जंगल ख भग गयी जित परमेश्वर को तरफ सी ओको लायी एक जागा तैयार करी गयी होती कि उत वा बाई एक हजार दोय सौ साठ दिन तक सम्भाल्यो जाये।<verse eid="REV 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:७ </char>
      <char style="xt" closed="false">
        <ref loc="JUD 1:9">यहूदा १:९</ref>
      </char>
    </note>फिर स्वर्ग म लड़ाई भयी, मीकाईल अऊर ओको स्वर्गदूत अजगर सी लड़न ख निकल्यो, अऊर अजगर अऊर ओको दूत ओको सी लड़्यो; <verse eid="REV 12:7"/><verse number="8" style="v" sid="REV 12:8"/>पर भारी नहीं पड़्यो, अऊर स्वर्ग म उन्को लायी रहन की अनुमति नहीं रही। <verse eid="REV 12:8"/><verse number="9" style="v" sid="REV 12:9"/><note caller="+" style="x"><char style="xo" closed="false">१२:९ </char><char style="xt" closed="false"><ref loc="LUK 10:18">लूका १०:१८</ref></char></note>अऊर ऊ अजगर ख खल्लो ढकेल दियो गयो, यो उच पुरानो सांप आय बुरो या शैतान कह्यो गयो हय। यो पूरो जगत ख भरमावय हय। ओख अऊर ओको दूतों ख धरती पर फेक्यो गयो होतो।<verse eid="REV 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10"/>फिर मय न स्वर्ग सी यो बड़ो आवाज आवतो हुयो सुन्यो,</para>
  <para style="q2" vid="REV 12:10">“अब हमरो परमेश्वर को उद्धार अऊर सामर्थ</para>
  <para style="q3" vid="REV 12:10">अऊर राज्य</para>
  <para style="q2" vid="REV 12:10">अऊर ओको मसीह को अधिकार प्रगट</para>
  <para style="q3" vid="REV 12:10">भयो हय,</para>
  <para style="q2" vid="REV 12:10">कहालीकि हमरो भाऊवों अऊर बहिनों पर दोष</para>
  <para style="q3" vid="REV 12:10">लगावन वालो, जो रात दिन हमरो परमेश्वर को सामने उन पर दोष लगायो करत होतो,</para>
  <para style="q2" vid="REV 12:10">स्वर्ग सी गिराय दियो गयो हय।” <verse eid="REV 12:10"/><verse number="11" style="v" sid="REV 12:11"/>हि मेम्ना को खून को वजह अऊर अपनी गवाही को वचन को वजह ओको पर जीत हासिल करी, अऊर उन्न अपनो जीवो ख प्रिय नहीं जान्यो, अऊर हि अपनो जीवन ख छोड़न अऊर मरन लायी तैयार होतो। <verse eid="REV 12:11"/><verse number="12" style="v" sid="REV 12:12"/>“यो वजह हे स्वर्गों अऊर उन्म रहन वालो, मगन हो; पर हे धरती, अऊर समुन्दर, तुम पर हाय! कहालीकि शैतान बड़ो गुस्सा को संग तुम्हरो जवर उतर आयो हय, कहालीकि जानय हय कि ओको जवर थोड़ोच समय अऊर बाकी हय।”<verse eid="REV 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13"/>जब अजगर को समझ म आयो की ओख धरती पर फेक दियो हय, त ओन वा बाई को पीछा करनो सुरू कर दियो, जेन टुरा ख जनम दियो होतो। <verse eid="REV 12:13"/><verse number="14" style="v" sid="REV 12:14"/>पर वा बाई ख बड़ो गरूड़ को दोय पंखा दियो गयो कि सांप को सामने सी उड़ क जंगल म ऊ जागा पहुंच जाये, जित ओख अजगर को हमला सी सुरक्षित रखन म साढ़े तीन साल तक ध्यान रख्यो जायेंन। <verse eid="REV 12:14"/><verse number="15" style="v" sid="REV 12:15"/>अऊर सांप न वा बाई को पीछू अपनो मुंह सी नदी को जसो पानी बहायो कि ओख यो नदी सी बहाय दे। <verse eid="REV 12:15"/><verse number="16" style="v" sid="REV 12:16"/>पर धरती न वा बाई की मदत करी, अऊर अपनो मुंह खोल क वा नदी ख जो अजगर न अपनो मुंह सी बहायी होती पी लियो। <verse eid="REV 12:16"/><verse number="17" style="v" sid="REV 12:17"/>येको बाद ऊ अजगर वा बाई पर गुस्सा भयो, अऊर बाई को बाकी वंशजों को संग, जो परमेश्वर को आज्ञावों को पालन करय हय, यीशु को गवाहों ख धारन करय हय, ऊ उन्को संग लड़ाई करन लायी निकल पड़्यो। <verse eid="REV 12:17"/><verse number="18" style="v" sid="REV 12:18"/>अऊर ऊ सांप समुन्दर को किनार पर खड़ो भय गयो।<verse eid="REV 12:18"/></para>
  <chapter eid="REV 12"/>
  <chapter number="13" style="c" sid="REV 13"/>
  <para style="s">दोय हिंसक पशुवों</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१३:१ </char>
      <char style="xt" closed="false">
        <ref loc="REV 17:3">प्रकाशितवाक्य १७:३</ref>,<ref loc="REV 17:7-12">७-१२</ref></char>
    </note>तब मय न एक हिंसक पशु ख समुन्दर म सी निकलतो हुयो देख्यो, जेको दस सींग अऊर सात मुंड होतो। ओको सींगो पर दस राजमुकुट, अऊर ओकी मुंडी पर परमेश्वर की निन्दा को नाम लिख्यो हुयो होतो। <verse eid="REV 13:1"/><verse number="2" style="v" sid="REV 13:2"/>जो हिंसक पशु मय न देख्यो ऊ चीता को जसो होतो; अऊर ओको पाय आसवल को जसो, अऊर मुंह सिंह को जसो होतो। ऊ अजगर न अपनी सामर्थ अऊर अपनो सिंहासन अऊर बड़ो अधिकार ओख दे दियो। <verse eid="REV 13:2"/><verse number="3" style="v" sid="REV 13:3"/>मय न ओको मुंडी म सी एक पर असो भारी घाव लग्यो देख्यो मानो ऊ मरन पर हय, तब ओको जीव घातक घाव अच्छो होय गयो, अऊर पूरी धरती को लोग ऊ हिंसक पशु को पीछू-पीछू अचम्भा करतो हुयो चल्यो। <verse eid="REV 13:3"/><verse number="4" style="v" sid="REV 13:4"/>लोगों न अजगर की पूजा करी, कहालीकि ओन जनावर ख अपनो अधिकार दे दियो होतो, अऊर यो कह्य क हिंसक पशु की पूजा करी, “यो जनावर को जसो कौन हय? कौन येको सी लड़ सकय हय?”<verse eid="REV 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5"/>बड़ो बोल बोलन अऊर परमेश्वर की निन्दा करन लायी ओख एक मुंह दियो गयो, अऊर ओख बयालीस महीना तक काम करन को अधिकार दियो गयो। <verse eid="REV 13:5"/><verse number="6" style="v" sid="REV 13:6"/>तब ओन परमेश्वर की निन्दा करनो सुरू कर दियो, ऊ परमेश्वर को नाम अऊर जित ऊ रह्य हय ऊ जागा तथा जो स्वर्ग म रह्य हय, उन्की निन्दा करन लग्यो। <verse eid="REV 13:6"/><verse number="7" style="v" sid="REV 13:7"/>ओख यो भी अधिकार दियो गयो कि परमेश्वर को लोगों सी विरोध म लड़े अऊर उन पर जय पाये, अऊर ओख हर एक गोत्र अऊर लोग, भाषा, अऊर राष्ट्र पर अधिकार दियो गयो। <verse eid="REV 13:7"/><verse number="8" style="v" sid="REV 13:8"/>जगत कि निर्मिती सी पहिले जिन्को नाम बली करयो गयो मेम्ना को जीवन की किताब म लिख्यो गयो हय, उन्ख छोड़ सब धरती पर रहन वालो लोग ऊ हिंसक पशु की आराधना करेंन।<verse eid="REV 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9"/>जेको कान हय ऊ सुने। <verse eid="REV 13:9"/><verse number="10" style="v" sid="REV 13:10"/>जेक कैद म पड़नो हय, ऊ कैद म पड़ेंन; जो तलवार सी मारेंन, जरूरी हय कि ऊ तलवार सी मारयो जायेंन। येकोलायी परमेश्वर को लोगों न धीरज अऊर विश्वास रखनो जरूरी हय।<verse eid="REV 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11"/>फिर मय न एक अऊर हिंसक पशु ख जमीन म सी निकलतो हुयो देख्यो, ओको मेम्ना को जसो दोय सींग होतो, अऊर ऊ अजगर को जसो बोलत होतो। <verse eid="REV 13:11"/><verse number="12" style="v" sid="REV 13:12"/>ऊ पहिले हिंसक पशु को पूरो अधिकार ओको सामने काम म लावत होतो; अऊर धरती अऊर ओको पर रहन वालो सी ऊ पहिलो पशु की, जेको जीव घातक घाव अच्छो भय गयो होतो, ओकी पूजा पूरो जगत को लोगों सी करावत होतो। <verse eid="REV 13:12"/><verse number="13" style="v" sid="REV 13:13"/>दूसरों हिंसक पशु बड़ो-बड़ो चिन्ह दिखावत होतो, यहां तक कि आदमियों को सामने आसमान सी धरती पर आगी बरसाय देत होतो। <verse eid="REV 13:13"/><verse number="14" style="v" sid="REV 13:14"/>उन चिन्हों को वजह, जिन्ख ऊ हिंसक पशु को सामने दिखावन को अधिकार ओख दियो गयो होतो, ऊ धरती को रहन वालो ख भरमावत होतो अऊर धरती को रहन वालो सी कहत होतो कि जो पशु पर तलवार को घाव लग्यो होतो ऊ जीन्दो भय गयो हय, ओकी मूर्ति बनावो। <verse eid="REV 13:14"/><verse number="15" style="v" sid="REV 13:15"/>ओख ऊ हिंसक पशु की मूर्ति म जीव डालन को अधिकार दियो गयो कि पशु की मूर्ति बोलन लगे, अऊर जितनो लोग ऊ पशु की मूर्ति की पूजा नहीं करय, उन्ख मरवाय डाले। <verse eid="REV 13:15"/><verse number="16" style="v" sid="REV 13:16"/>दूसरों हिंसक पशु न छोटो-बड़ो, धनी-गरीब, सेवक अऊर स्वतंत्र सब लोगों ख विवश करयो कि हि अपनो अपनो हाथों यां मस्तकों पर ओकी छाप लगवाये, <verse eid="REV 13:16"/><verse number="17" style="v" sid="REV 13:17"/>कि ओख छोड़ जेको पर छाप मतलब ऊ हिंसक पशु को नाम यां अंक हो, दूसरों कोयी लेन-देन नहीं कर सके।<verse eid="REV 13:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18"/>ज्ञान येकोच म हय: जेको म बुद्धि हय ऊ यो हिंसक पशु को अंक को अर्थ निकाल ले, कहालीकि ऊ अंक कोयी लोग को नाम सी सम्बन्धित हय, अऊर ओको अंक हय छे सौ छियासठ।<verse eid="REV 13:18"/></para>
  <chapter eid="REV 13"/>
  <chapter number="14" style="c" sid="REV 14"/>
  <para style="s">मेम्ना अऊर ओको लोग</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१४:१ </char>
      <char style="xt" closed="false">
        <ref loc="REV 7:3">प्रकाशितवाक्य ७:३</ref>
      </char>
    </note>फिर मय न नजर करी, अऊर देख्यो, ऊ मेम्ना सिय्योन पहाड़ी पर खड़ो हय, अऊर ओको संग एक लाख चौवालीस हजार लोग हंय, जिन्को मस्तक पर ओको अऊर ओको बाप को नाम लिख्यो हुयो हय। <verse eid="REV 14:1"/><verse number="2" style="v" sid="REV 14:2"/>अऊर स्वर्ग सी मोख एक असो आवाज सुनायी दियो जो पानी को झरना अऊर बड़ो गर्जन को जसो आवाज होतो, अऊर जो आवाज मय न सुन्यो ऊ असो होतो मानो संगीतकारों संगीत बजाय रह्यो हंय। <verse eid="REV 14:2"/><verse number="3" style="v" sid="REV 14:3"/>हि सिंहासन को सामने अऊर चारयी प्रानियों अऊर बुजूर्ग लोग को सामने एक नयो गीत गाय रह्यो होतो। उन एक लाख चौवालीस हजार लोग ख छोड़ क, जो धरती पर सी मोल ले क छुड़ायो गयो होतो, उन्ख छोड़ दूसरों कोयी भी लोग ऊ गीत ख सीख नहीं सकत होतो। <verse eid="REV 14:3"/><verse number="4" style="v" sid="REV 14:4"/>हि असो लोग होतो जिन्न कोयी बाई को संसर्ग सी अपनो आप ख अशुद्ध नहीं करयो होतो। कहालीकि हि कुंवारो होतो, जित कहीं मेम्ना जात होतो हि ओको अनुसरन करत होतो पूरी मानव जाती सी उन्ख मोल ले क छुड़ायो गयो होतो। हि परमेश्वर अऊर मेम्ना को लायी फसल को पहिलो फर होतो। <verse eid="REV 14:4"/><verse number="5" style="v" sid="REV 14:5"/>उन्को मुंह सी कभी झूठ नहीं निकल्यो होतो, हि निर्दोष हंय।<verse eid="REV 14:5"/></para>
  <para style="s">तीन स्वर्गदूत</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6"/>फिर मय न एक अऊर स्वर्गदूत ख आसमान को बीच म उड़तो हुयो देख्यो, जेको जवर धरती पर को रहन वालो की हर एक राष्ट्र, अऊर गोत्र, भाषा, अऊर लोगों ख सुनावन लायी अनन्त काल को सुसमाचार होतो। <verse eid="REV 14:6"/><verse number="7" style="v" sid="REV 14:7"/>ओन बड़ो आवाज सी कह्यो, “परमेश्वर सी डरो, अऊर ओकी महानता की महिमा करो, कहालीकि ओको न्याय करन को समय आय पहुंच्यो हय; ओकी आराधना करो, जेन आसमान, धरती, समुन्दर अऊर पानी को सोता ख बनायो।”<verse eid="REV 14:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१४:८ </char>
      <char style="xt" closed="false">
        <ref loc="REV 18:2">प्रकाशितवाक्य १८:२</ref>
      </char>
    </note>फिर येको बाद एक अऊर, दूसरों, स्वर्गदूत यो कहतो हुयो आयो, “गिर पड़्यो, ऊ बड़ो बेबीलोन गिर पड़्यो, जेन अपनो व्यभिचार की कोपमय दारू पूरी लोगों ख पिलायी हय।”<verse eid="REV 14:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9"/>उन दिनो को बाद एक अऊर तीसरो स्वर्गदूत आयो अऊर बड़ो आवाज सी यो कहतो हुयो आयो, “जो कोयी ऊ हिंसक पशु अऊर ओकी मूर्ति की पूजा करे, अऊर अपनो मस्तक या अपनो हाथ पर ओकी छाप ले <verse eid="REV 14:9"/><verse number="10" style="v" sid="REV 14:10"/>त ऊ परमेश्वर की प्रकोप की दारू पीयेंन, असी अमिश्रित तीखी मदिरा जो परमेश्वर को प्रकोप को कटोरा म तैयार करी गयी हय। ऊ लोग ख पवित्र स्वर्गदूतों अऊर मेम्ना को सामने धधकती हुयी आगी अऊर गन्धक म यातनायें दियो जायेंन की पीड़ा म पड़ेंन। <verse eid="REV 14:10"/><verse number="11" style="v" sid="REV 14:11"/>उन्की पीड़ा को धुवा हमेशा हमेशा उठतो रहेंन, अऊर जो ऊ हिंसक पशु अऊर ओकी मूर्ति की पूजा करय हंय, अऊर जो ओको नाम की छाप लेवय हंय, उन्ख रात दिन चैन नहीं मिलेंन।”<verse eid="REV 14:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12"/>येकोलायी पवित्र लोगों ख धीरज रखनो जरूरी हय, जो परमेश्वर की आज्ञावों ख मानय अऊर यीशु पर विश्वास रखय हंय।<verse eid="REV 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13"/>फिर मय न स्वर्ग सी यो आवाज सुन्यो, “लिख: अब सी हि लोग धन्य होयेंन जो प्रभु म बन्यो रह्य क मरय हंय।” आत्मा कह्य हय, “हव, कहालीकि हि अपनो पूरो मेहनत सी आराम पायेंन, अऊर उन्को सेवा को फर उन्ख मिलेंन।”<verse eid="REV 14:13"/></para>
  <para style="s">धरती की कटनी</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14"/>मय न नजर करी, अऊर देखो, एक सफेद बादर हय, अऊर ऊ बादर पर आदमी को बेटा को जसो कोयी बैठ्यो हय, जेको मुंड पर सोनो को मुकुट अऊर हाथ म तेज हसिया हय। <verse eid="REV 14:14"/><verse number="15" style="v" sid="REV 14:15"/>फिर एक अऊर स्वर्गदूत न मन्दिर म सी निकल क ओको सी, जो बादर पर बैठ्यो होतो, बड़ो आवाज सी पुकार क कह्यो, “अपनो हसिया चलाव अऊर फसल जमा कर कहालीकि फसल काटन को समय आय पहुंच्यो हय, येकोलायी की धरती की फसल पक गयी हय।” <verse eid="REV 14:15"/><verse number="16" style="v" sid="REV 14:16"/>येकोलायी जो बादर पर बैठ्यो होतो ओन धरती पर अपनो हसिया लगायो, अऊर धरती की फसल काट ली गयी।<verse eid="REV 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17"/>फिर एक अऊर स्वर्गदूत ऊ मन्दिर म सी निकल्यो जो स्वर्ग म हय, अऊर ओको जवर भी तेज हसिया होतो।<verse eid="REV 14:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18"/>फिर एक अऊर स्वर्गदूत, जेक आगी पर अधिकार होतो, वेदी म सी निकल्यो, अऊर जेको जवर तेज हसिया होतो ओको सी ऊचो आवाज सी कह्यो, “अपनो तेज हसिया लगाय क धरती की बेला को अंगूर को गूच्छा काट ले, कहालीकि ओको अंगूर पक गयो हय।” <verse eid="REV 14:18"/><verse number="19" style="v" sid="REV 14:19"/>तब ऊ स्वर्गदूत न धरती पर अपनो हसिया चलायो अऊर धरती को अंगूर उतार लियो अऊर उन्ख परमेश्वर को भयंकर प्रकोप को बड़ो रसकुण्ड म डाल दियो; <verse eid="REV 14:19"/><verse number="20" style="v" sid="REV 14:20"/><note caller="+" style="x"><char style="xo" closed="false">१४:२० </char><char style="xt" closed="false"><ref loc="REV 19:15">प्रकाशितवाक्य १९:१५</ref></char></note>अऊर नगर को बाहेर ऊ रसकुण्ड म अंगूर रौंद्यो गयो, अऊर रसकुण्ड म सी इतनो खून निकल्यो कि दोय मीटर दूर सी घोड़ा की लगाम तक पहुंच्यो, अऊर सौ कोस तक बह गयो।<verse eid="REV 14:20"/></para>
  <chapter eid="REV 14"/>
  <chapter number="15" style="c" sid="REV 15"/>
  <para style="s">आखरी महामारी को संग स्वर्गदूत</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1"/>फिर मय न आसमान म एक अऊर बड़ो अऊर अद्भुत चिन्ह देख्यो, मय न देख्यो की सात स्वर्गदूत सात आखरी महामारियों ख लियो हुयो हय, यो आखरी विनाश आय कहालीकि इन्को संग परमेश्वर को प्रकोप भी खतम होय जावय हय।<verse eid="REV 15:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2"/>फिर मोख एक काच को एक समुन्दर दिखायी दियो जेको म मानो आगी हो। अऊर मय न देख्यो कि जिन्न ऊ हिंसक पशु की मूर्ति पर अऊर ओको नाम सी सम्बन्धित संख्या पर विजय पा ली हय, हि भी ऊ काच को समुन्दर पर खड़ो हय। उन्न परमेश्वर को द्वारा दी गयी विणाये पा ली। <verse eid="REV 15:2"/><verse number="3" style="v" sid="REV 15:3"/>हि परमेश्वर को सेवक मूसा अऊर मेम्ना को गीत गाय रह्यो होतो,</para>
  <para style="q1" vid="REV 15:3">“हि कर्म जिन्ख तय करय हय महान हय;</para>
  <para style="q2" vid="REV 15:3">तोरो कर्म अद्भुत हय, तोरी शक्ति अनन्त हय, प्रभु परमेश्वर,</para>
  <para style="q1" vid="REV 15:3">तोरो रस्ता सच्चो अऊर सच्चो सी भरयो हुयो हय,</para>
  <para style="q2" vid="REV 15:3">सब राष्ट्रों को राजा हय।”<verse eid="REV 15:3"/></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4"/>“हे प्रभु, कौन तोरो सी नहीं डरेंन</para>
  <para style="q2" vid="REV 15:4">अऊर तोरो नाम की महिमा नहीं करेंन?</para>
  <para style="q2" vid="REV 15:4">कहालीकि केवल तयच पवित्र हय।</para>
  <para style="q1" vid="REV 15:4">पूरो राष्ट्रों को लोग आय क</para>
  <para style="q2" vid="REV 15:4">तोरो सामने दण्डवत करेंन,</para>
  <para style="q2" vid="REV 15:4">कहालीकि तोरो न्याय को काम प्रगट भय गयो हंय।”<verse eid="REV 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5"/>येको बाद मय न देख्यो कि स्वर्ग को मन्दिर मतलब वाचा को तम्बू ख खोल्यो गयो; <verse eid="REV 15:5"/><verse number="6" style="v" sid="REV 15:6"/>अऊर हि सातों स्वर्गदूत जिन्को जवर सातों महामारियां होती, मलमल को शुद्ध अऊर चमकदार कपड़ा पहिन्यो अऊर छाती पर सोनो को पट्टा बान्ध्यो हुयो मन्दिर सी निकल्यो। <verse eid="REV 15:6"/><verse number="7" style="v" sid="REV 15:7"/>तब उन चारयी प्रानियों म सी एक न उन सात स्वर्गदूतों ख परमेश्वर, जो हमेशा हमेशा जीन्दो रह्य हय, को प्रकोप सी भरयो हुयो सोनो को सात कटोरा दियो; <verse eid="REV 15:7"/><verse number="8" style="v" sid="REV 15:8"/>अऊर परमेश्वर की महिमा अऊर ओकी सामर्थ को वजह मन्दिर धुवा सी भर गयो, अऊर जब तक उन सातों स्वर्गदूतों की सातों महामारियां खतम नहीं भयी तब तक कोयी मन्दिर को अन्दर कोयी सिर नहीं सक्यो।<verse eid="REV 15:8"/></para>
  <chapter eid="REV 15"/>
  <chapter number="16" style="c" sid="REV 16"/>
  <para style="s">परमेश्वर को प्रकोप को कटोरा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1"/>तब मय न सुन्यो मन्दिर म ऊचो आवाज उन सात स्वर्गदूतों सी यो कह्य रह्यो हय, “जावो, परमेश्वर को प्रकोप को सातों कटोरा ख धरती पर कुड़ाय देवो।”<verse eid="REV 16:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2"/>येकोलायी पहिलो स्वर्गदूत न जाय क अपनो कटोरा धरती पर कुड़ाय दियो। परिनाम स्वरूप उन लोगों को, जिन पर उन हिंसक पशु को छाप लिख्यो होतो जो ओकी मूर्ति की पूजा करत होतो, उन पर भयानक अऊर दर्दनाक छाला फूट आयो।<verse eid="REV 16:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3"/>येको बाद दूसरों स्वर्गदूत न अपनो कटोरा समुन्दर पर कुड़ाय दियो, अऊर ऊ मरयो हुयो आदमी को खून जसो बन गयो, अऊर समुन्दर म रहन वालो सब जीवजन्तु मर गयो।<verse eid="REV 16:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4"/>फिर तीसरो स्वर्गदूत न अपनो कटोरा नदियों अऊर पानी को झरना पर कुड़ाय दियो, अऊर ऊ खून बन गयो। <verse eid="REV 16:4"/><verse number="5" style="v" sid="REV 16:5"/>तब मय न पानी को मालिक स्वर्गदूत ख यो कहतो सुन्यो, “ऊ तयच आय जो सच्चो हय, जो हमेशा हमेशा सी, तयच आय जो पवित्र तय न जो करयो हय न्याय हय। <verse eid="REV 16:5"/><verse number="6" style="v" sid="REV 16:6"/>उन्न परमेश्वर को लोगों अऊर भविष्यवक्तावों को खून बहायो, तय सच्चो हय तय न उन्ख पीवन ख बस खूनच दियो, कहालीकि हि योच लायक हंय।” <verse eid="REV 16:6"/><verse number="7" style="v" sid="REV 16:7"/>फिर मय न वेदी सी यो आवाज सुन्यो, “हव, हे सर्वशक्तिमान प्रभु परमेश्वर, तोरो न्याय सच्चो अऊर नेक हंय।”<verse eid="REV 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8"/>चौथो स्वर्गदूत न अपनो कटोरा सूरज पर कुड़ाय दियो, अऊर भयानक गर्मी की आगी सी आदमियों ख जलाय देन को अधिकार दियो गयो। <verse eid="REV 16:8"/><verse number="9" style="v" sid="REV 16:9"/>अऊर लोग भयानक गर्मी सी झुलस गयो, अऊर उन्न परमेश्वर को नाम ख कोस्यो कहालीकि की इन विनाशों पर ओकोच अधिकार हय। पर उन्न कोयी मन नहीं फिरायो अऊर नहीं ओख महिमा प्रदान करी।<verse eid="REV 16:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10"/>पाचवों स्वर्गदूत न अपनो कटोरा ऊ हिंसक पशु को सिंहासन पर कुड़ाय दियो, अऊर ओको राज्य पर अन्धारो छाय गयो। अऊर लोगों न तकलीफ को मारे अपनी जीबली चबाय ली, <verse eid="REV 16:10"/><verse number="11" style="v" sid="REV 16:11"/>अऊर अपनी पीड़ावों अऊर फोड़ा को वजह स्वर्ग को परमेश्वर की निन्दा करी; पर अपनो अपनो कामों सी हि उन्को पापों सी नहीं फिरयो।<verse eid="REV 16:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12"/>छठवो स्वर्गदूत न अपनो कटोरा महा नदी फरात पर कुड़ाय दियो, अऊर ओको पानी सूख गयो कि पूर्व दिशा सी आवन वालो राजावों को लायी रस्ता तैयार होय जाये। <verse eid="REV 16:12"/><verse number="13" style="v" sid="REV 16:13"/>फिर मय न ऊ अजगर को मुंह सी, अऊर ऊ हिंसक पशु को मुंह सी, अऊर ऊ झूठो भविष्यवक्ता को मुंह सी तीन अशुद्ध आत्मावों ख मेंढका को रूप म निकलतो देख्यो। <verse eid="REV 16:13"/><verse number="14" style="v" sid="REV 16:14"/>यो चिन्ह दिखावन वाली शैतान की दुष्ट आत्मायें आय। या तीन आत्मायें जो पूरो जगत को राजावों को जवर निकल क येकोलायी जावय हंय कि उन्ख सर्वशक्तिमान परमेश्वर को ऊ बड़ो दिन की लड़ाई को लायी जमा करे।<verse eid="REV 16:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:१५ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:43">मत्ती २४:४३</ref>,<ref loc="MAT 24:44">४४</ref>; <ref loc="LUK 12:39">लूका १२:३९</ref>,<ref loc="LUK 12:40">४०</ref>; <ref loc="REV 3:3">प्रकाशितवाक्य ३:३</ref></char>
    </note>“देख, मय चोर को जसो आऊं हय; धन्य ऊ हय जो जागतो रह्य हय, अऊर अपनो कपड़ा की रक्षा करय हय कि नंगो नहीं फिरे, अऊर लोग ओख लज्जित होतो नहीं देखे!”<verse eid="REV 16:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16"/>फिर बुरी आत्मावों न राजावों ख एक संग ऊ जागा जमा करयो, जो इब्रानी म हरमगिदोन कहलावय हय।<verse eid="REV 16:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17"/>सातवों स्वर्गदूत न अपनो कटोरा हवा पर कुड़ाय दियो, अऊर मन्दिर को सिंहासन सी यो बड़ो आवाज भयो, “भय गयो!” <verse eid="REV 16:17"/><verse number="18" style="v" sid="REV 16:18"/><note caller="+" style="x"><char style="xo" closed="false">१६:१८ </char><char style="xt" closed="false"><ref loc="REV 8:5">प्रकाशितवाक्य ८:५</ref>; <ref loc="REV 11:13">११:१३</ref>,<ref loc="REV 11:19">१९</ref></char></note>तब बिजलियां चमकी, अऊर आवाज अऊर मेघों को गर्जन भयो, अऊर एक असो भयानक भूईडोल भी भयो। जब सी आदमी की उत्पत्ति धरती पर भयी, तब सी असो भयानक भूईडोल कभी नहीं आयो होतो। <verse eid="REV 16:18"/><verse number="19" style="v" sid="REV 16:19"/>येको सी ऊ बड़ो नगर को तीन टुकड़ा भय गयो, अऊर पूरो राष्ट्रों को नगर नाश भय गयो; परमेश्वर न महान बेबीलोन ख सजा देन लायी याद करयो होतो। अऊर ऊ ओख अपनो भभकतो हुयो गुस्सा की दारू सी भरयो हुयो प्याला ओख पिवन ख दियो होतो। <verse eid="REV 16:19"/><verse number="20" style="v" sid="REV 16:20"/><note caller="+" style="x"><char style="xo" closed="false">१६:२० </char><char style="xt" closed="false"><ref loc="REV 6:14">प्रकाशितवाक्य ६:१४</ref></char></note>अऊर हर एक टापू अपनी जागा सी गायब भय गयो, अऊर पूरो पहाड़ी को पता नहीं चल्यो। <verse eid="REV 16:20"/><verse number="21" style="v" sid="REV 16:21"/><note caller="+" style="x"><char style="xo" closed="false">१६:२१ </char><char style="xt" closed="false"><ref loc="REV 11:19">प्रकाशितवाक्य ११:१९</ref></char></note>आसमान सी आदमियों पर बड़ी बड़ी गारगोटी गिरी, जो चालीस किलो की होती, अऊर येकोलायी कि या विपत्ति बहुतच भारी होती, लोगों न गारगोटी की विपत्ति को वजह परमेश्वर की निन्दा करी।<verse eid="REV 16:21"/></para>
  <chapter eid="REV 16"/>
  <chapter number="17" style="c" sid="REV 17"/>
  <para style="s">प्रसिद्ध वेश्या</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1"/>येको बाद उन सात स्वर्गदूतों को जवर हि सात कटोरा होतो, उन्म सी एक न आय क मोरो सी यो कह्यो, “इत आव, ताकी बहुत सी नदियों को किनारे बैठी वा प्रसिद्ध वेश्या को सजा ख दिखाऊं। <verse eid="REV 17:1"/><verse number="2" style="v" sid="REV 17:2"/>जेको संग धरती को राजावों न व्यभिचार करयो; अऊर धरती को रहन वालो ओको व्यभिचार की दारू सी नशा म चूर भय गयो होतो।”<verse eid="REV 17:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१७:३ </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:1">प्रकाशितवाक्य १३:१</ref>
      </char>
    </note>तब मोख पूरी रीति सी आत्मा न नियंत्रन करयो, अऊर स्वर्गदूत मोख जंगल को तरफ ले गयो। उत मय न लाल रंग को हिंसक पशु पर वा बाई ख बैठ्यो देख्यो, ओको पर परमेश्वर को निन्दा को नाम ख सब जागा पर लिख्यो होतो, अऊर हिंसक पशु को सात मुंड अऊर दस सींग होतो। <verse eid="REV 17:3"/><verse number="4" style="v" sid="REV 17:4"/>या बाई जामुनी अऊर लाल रंग को कपड़ा पहिन्यो होती, अऊर सोनो अऊर बहुमूल्य रत्नों अऊर मोतियों सी सजी हुयी होती, अऊर ओको संग म एक सोनो को कटोरा होतो जो घृणित चिजों सी अऊर ओको व्यभिचार की अशुद्ध चिजों सी भरयो हुयो होतो। <verse eid="REV 17:4"/><verse number="5" style="v" sid="REV 17:5"/>ओको मस्तक पर यो नाम लिख्यो होतो, “भेद, महान बेबीलोन धरती की वेश्यावों अऊर घृणित चिजों की माता।”<verse eid="REV 17:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 17:6"/>मय न वा बाई ख परमेश्वर को लोगों को खून अऊर यीशु को प्रति विश्वास लायक होतो ओको वजह मारयो गयो उन्को खून पीनो सी मतवाली भय गयी हय; ओख देख क मय चकित भय गयो। <verse eid="REV 17:6"/><verse number="7" style="v" sid="REV 17:7"/>तब ऊ स्वर्गदूत न मोरो सी कह्यो, “तय कहाली चकित भयो? मय या बाई अऊर ऊ हिंसक पशु को, जेको पर हवा सवार हय अऊर जेको सात मुंड अऊर दस सींग हंय, तोख ओको भेद बताऊ हय।<verse eid="REV 17:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 17:8"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१७:८ </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:7">प्रकाशितवाक्य ११:७</ref>
      </char>
    </note>“जो हिंसक पशु तय न देख्यो हय, ऊ पहिले कभी जीन्दो होतो पर अब जीन्दो नहाय, फिर भी अधोलोक सी निकलेंन तब भी ओको विनाश होय जायेंन; अऊर धरती को रहन वालो जिन्को नाम जगत की उत्पत्ति को समय सी जीवन की किताब म लिख्यो नहीं गयो, यो पशु की या दशा देख क कि पहिले जीन्दो होतो अऊर अब नहाय पर फिर प्रगट होयेंन, यो देख क फिर धरती को सब लोग अचम्भा करेंन। <verse eid="REV 17:8"/><verse number="9" style="v" sid="REV 17:9"/>यो समझन लायी बुद्धि अऊर ज्ञान होना, हि सातों मुंड सात पहाड़ी आय जिन पर वा बाई बैठी हय, हि सात मुंड सात राजा भी आय। <verse eid="REV 17:9"/><verse number="10" style="v" sid="REV 17:10"/>जिन म सी पाच त गिर चुक्यो हंय, अऊर एक अभी हय, अऊर एक अभी शासन कर रह्यो हय, अऊर दूसरों अभी तक आयो नहाय। पर ऊ जब आयेंन त ओकी या नियत हय ऊ कुछ देरच शासन कर पायेंन। <verse eid="REV 17:10"/><verse number="11" style="v" sid="REV 17:11"/>जो हिंसक पशु एक समय जीन्दो होतो, अऊर अब जीन्दो नहाय, ऊ खुद आठवो राजा हय जो उन सातों म सीच एक आय, ओको भी विनाश होन वालो हय। <verse eid="REV 17:11"/><verse number="12" style="v" sid="REV 17:12"/>जो दस सींग तय न देख्यो हि दस राजा आय जिन्न अब तक शासन को सुरूवात नहीं करयो हय, पर ओख ऊ हिंसक पशु को संग घड़ी भर शासन करन को अधिकार मिलेंन। <verse eid="REV 17:12"/><verse number="13" style="v" sid="REV 17:13"/>हि दस लोग एक मन होयेंन, अऊर हि अपनी अपनी सामर्थ अऊर अधिकार ऊ हिंसक पशु ख सौंप देयेंन। <verse eid="REV 17:13"/><verse number="14" style="v" sid="REV 17:14"/>हि मेम्ना को विरुद्ध लड़ाई करेंन, पर मेम्ना अपनो बुलायो हुयो, चुन्यो हुयो अऊर विश्वास लायक अनुयायीयों ख जमा कर क् उन्ख हराय देयेंन, कहालीकि ऊ प्रभुवों को प्रभु अऊर राजावों को राजा आय।”<verse eid="REV 17:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15"/>फिर स्वर्गदूत न मोरो सी कह्यो, “जो पानी तय न देख्यो, जिन पर वेश्या बैठी हय, हि त राष्ट्र, लोग अऊर वंश अऊर भाषाये हंय। <verse eid="REV 17:15"/><verse number="16" style="v" sid="REV 17:16"/>जो दस सींग तय न देख्यो, हि अऊर हिंसक पशु सी दुस्मनी रखेंन, तथा ओको सब कुछ छीन क ओख बिना कपड़ा को छोड़ जायेंन, अऊर ओको शरीर खाय जायेंन, अऊर ओख आगी म जलाय डालेंन। <verse eid="REV 17:16"/><verse number="17" style="v" sid="REV 17:17"/>अपनो इच्छा ख पूरो करन लायी परमेश्वर न उन सब ख एक मत कर क्, उन्को मन म योच बैठाय दियो हय कि, हि जब तक परमेश्वर को वचन पूरो नहीं होय जावय, तब तक शासन करन को अपनो अधिकार ऊ हिंसक पशु ख सौंप दे। <verse eid="REV 17:17"/><verse number="18" style="v" sid="REV 17:18"/>वा बाई, जेक तुम न देख्यो हय, ऊ बड़ो नगर आय जो धरती को राजावों पर शासन करय हय।”<verse eid="REV 17:18"/></para>
  <chapter eid="REV 17"/>
  <chapter number="18" style="c" sid="REV 18"/>
  <para style="s">बेबीलोन को गिरनों</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1"/>येको बाद मय न एक अऊर स्वर्गदूत ख स्वर्ग सी उतरतो देख्यो, जेक बड़ो अधिकार प्राप्त होतो; अऊर धरती ओको तेज सी चमक उठी। <verse eid="REV 18:1"/><verse number="2" style="v" sid="REV 18:2"/><note caller="+" style="x"><char style="xo" closed="false">१८:२ </char><char style="xt" closed="false"><ref loc="REV 14:8">प्रकाशितवाक्य १४:८</ref></char></note>ओन ऊचो आवाज सी पुकार क कह्यो, “वा गिर गयी, बेबीलोन की बड़ी नगरी गिर गयी हय! वा दुष्ट आत्मा को निवास, अऊर हर एक अशुद्ध आत्मा को अड्डा, अऊर हर एक तरह की पक्षिंयों अशुद्ध अऊर घृणित पशुवों को अड्डा बन गयो। <verse eid="REV 18:2"/><verse number="3" style="v" sid="REV 18:3"/>कहालीकि सब राष्ट्रों न ओकी दारू मतलब अनैतिकता की भयंकर वासना ख पियो हय। यो धरती को राजावों न ओको संग अनैतिक व्यभिचार करयो हय अऊर यो जगत को व्यापारी ओको भोग वासना सी सम्पन्न बन्यो हंय।”<verse eid="REV 18:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4"/>फिर मय न स्वर्गदूत सी अऊर एक आवाज सुन्यो,</para>
  <para style="q1" vid="REV 18:4">“हे मोरो लोगों, ओको म सी निकल आवो कि</para>
  <para style="q2" vid="REV 18:4">तुम ओको पापों म भागी मत बनो,</para>
  <para style="q2" vid="REV 18:4">अऊर ओकी सजा म खुद सहभागी मत बनो।<verse eid="REV 18:4"/></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5"/>कहालीकि ओको पापों को ढेर स्वर्ग तक पहुंच गयो हय,</para>
  <para style="q2" vid="REV 18:5">अऊर ओको अपराध को काम परमेश्वर ख याद आयो हंय।<verse eid="REV 18:5"/></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6"/>तुम भी ओको संग वसोच व्यवहार करो; जसो ओन तुम्हरो संग करयो, ओको बदला दुगुना ओको संग करो। तुम्हरो लायी जो कटोरा म ओन मदिरा मिलायी वसोच ओको संग दुगुनी मिलावों।<verse eid="REV 18:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7"/>कहालीकि जो महिमा अऊर वैभव ओन खुद ख दियो तुम उच ढंग सी ओख यातनायें अऊर तकलीफ देवो। कहालीकि ऊ खुदच अपनो खुद ख कहती रह्य हय, ‘मय विराजमान रानी आय, मय विधवा नहाय; अऊर मय कभी शोक नहीं करू।’<verse eid="REV 18:7"/></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8"/>यो वजह एकच दिन म ओको पर विपत्तिया आय पड़ेंन,</para>
  <para style="q2" vid="REV 18:8">मतलब मृत्यु, अऊर शोक, अऊर अकाल;</para>
  <para style="q1" vid="REV 18:8">अऊर वा आगी सी भस्म कर दी जायेंन,</para>
  <para style="q2" vid="REV 18:8">कहालीकि ओको न्याय करन वालो प्रभु परमेश्वर शक्तिमान हय।”<verse eid="REV 18:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9"/>धरती को राजा जिन्न ओको संग व्यभिचार अऊर सुखविलास करयो, जब ओको जरन को धुवा देखेंन, त ओको लायी रोयेंन अऊर विलाप करेंन। <verse eid="REV 18:9"/><verse number="10" style="v" sid="REV 18:10"/>ओको तकलीफ को डर को मारे हि बड़ो दूर खड़ो होय क कहेंन, “हे बड़ो नगर, बेबीलोन! हे दृढ़ नगर, हाय! हाय! तोरी सजा तोख घड़ी भर मच मिल गयो हय।”<verse eid="REV 18:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11"/>“धरती को व्यापारी ओको लायी रोयेंन अऊर विलाप करेंन, कहालीकि उन्की चिजे अब कोयी मोल नहीं लेयेंन; <verse eid="REV 18:11"/><verse number="12" style="v" sid="REV 18:12"/>मतलब सोनो, चांदी, रत्न, मोती, अऊर मलमल, अऊर जामुनी, चमकदार, अऊर लाल रंग को कपड़ा, अऊर हर तरह की सुगन्धित लकड़ी, अऊर हत्ती को दात की हर तरह की चिजे, अऊर बहुमूल्य लकड़ी अऊर पीतर अऊर लोहा अऊर संगमरमर की सब तरह तरह की चिजे, <verse eid="REV 18:12"/><verse number="13" style="v" sid="REV 18:13"/>अऊर कलमी, मसाला, धूप, अत्तर, लुबान, दारू, तेल, मैदा, गहूं, गाय बईल, मेंढीं शेरी, घोड़ा, रथ, अऊर सेवक, अऊर आदमी को शरीरों अऊर उन्को जीव तक। <verse eid="REV 18:13"/><verse number="14" style="v" sid="REV 18:14"/>व्यापारी ओको सी कहेंन हि सब उत्तम फर जेको म तोरो दिल रम्यो होतो, ऊ सब अदृश्य भय गयी हय अऊर तोरो सब सुख विलाश वैभव चली गयो हय अब नहीं कभी ढूंढ पावों।”<verse eid="REV 18:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 18:15"/>हि व्यापारी जो इन चिजे को व्यापार करतो हुयो धनवान भय गयो होतो, हि ओको संग ओकी तकलीफ म सहभागी होन को डर को वजह दूरच खड़ो होयेंन, अऊर हि रोयेंन अऊर विलाप करेंन, <verse eid="REV 18:15"/><verse number="16" style="v" sid="REV 18:16"/>अऊर कहेंन “हाय! हाय!” यो बड़ो नगर जो मलमल, अऊर जामुनी अऊर लाल रंग को कपड़ा पहिन्यो होतो, अऊर सोना अऊर रत्नों अऊर मोतियों सी सज्यो हुयो होतो।<verse eid="REV 18:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 18:17"/>अऊर घड़ी भर म ओकी पूरी सम्पत्ति मिट गयी। हर एक माझी अऊर यात्री अऊर मल्लाह, अऊर जितनो समुन्दर म व्यापार करय हंय, सब दूर खड़ो भयो, <verse eid="REV 18:17"/><verse number="18" style="v" sid="REV 18:18"/>अऊर ओको जरन को धुवा देखतो हुयो पुकार क कहेंन, “कौन सो नगर यो बड़ो नगर को जसो बन्यो हय?” <verse eid="REV 18:18"/><verse number="19" style="v" sid="REV 18:19"/>अऊर अपनो अपनो मुंडी पर धूल डालेंन, अऊर रोवतो हुयो अऊर विलाप करतो हुयो कहेंन, महानगर हाय! हाय! यो कितनो भयावह अऊर भयानक हय जेकी सम्पत्ति को द्वारा समुन्दर को सब जहाज वालो धनी भय गयो होतो, घड़ी भर म ओको सब कुछ उजड़ गयो।<verse eid="REV 18:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20"/>हे स्वर्ग, अऊर हे परमेश्वर को लोगों, अऊर प्रेरितों, अऊर भविष्यवक्तावों, ओको विनाश पर खुशी मनावो, कहालीकि परमेश्वर न ओख ठीक वसोच दोष दियो हय जसो ऊ दण्ड ओन तुम्ख दियो होतो!<verse eid="REV 18:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21"/>फिर एक ताकतवर स्वर्गदूत न बड़ी चक्की को पाट को जसो एक गोटा उठायो, अऊर यो कह्य क समुन्दर म फेक दियो, “बड़ो नगर बेबीलोन असोच हिंसक रीति सी खल्लो फेक दियो जायेंन अऊर फिर कभी ओको पता नहीं चलेंन।” <verse eid="REV 18:21"/><verse number="22" style="v" sid="REV 18:22"/>“वानी बजावन वालो, अऊर गावन वालो, अऊर बांसुरी बजावन वालो, अऊर तुरही फूकन वालो को आवाज फिर कभी तोरो म सुनायी नहीं देयेंन; अऊर कोयी उद्धम को कोयी कारीगर भी फिर कभी तोरो म नहीं मिलेंन; अऊर चक्की पिसन को आवाज फिर कभी तोरो म सुनायी नहीं देयेंन; <verse eid="REV 18:22"/><verse number="23" style="v" sid="REV 18:23"/>अऊर दीया को प्रकाश फिर कभी तोरो म नहीं दिखेंन, अऊर दूल्हा अऊर दुल्हिन को आवाज फिर कभी तोरो म सुनायी नहीं देयेंन। तोरो व्यापारी धरती म सब सी शक्तिशाली होतो, अऊर धरती को पूरो लोग तोरो झूठो चमत्कारों को वजह सी भरमायो गयो होतो। <verse eid="REV 18:23"/><verse number="24" style="v" sid="REV 18:24"/>भविष्यवक्तावों अऊर परमेश्वर को लोगों, अऊर धरती पर मारयो गयो सब लोगों को खून बेबीलोन नगर म पायो गयो होतो।”<verse eid="REV 18:24"/></para>
  <chapter eid="REV 18"/>
  <chapter number="19" style="c" sid="REV 19"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1"/>येको बाद मय न स्वर्ग म मानो बड़ी भीड़ को लोगों को ऊचो आवाज सी यो कहतो सुन्यो, “हल्लिलूय्याह! उद्धार अऊर महिमा अऊर सामर्थ हमरो परमेश्वर कीच आय। <verse eid="REV 19:1"/><verse number="2" style="v" sid="REV 19:2"/>कहालीकि ओको न्याय सच्चो अऊर उचित हंय। ओन वा वेश्या को, जो अपनो व्यभिचार सी धरती ख भ्रष्ट करत होती, न्याय करयो अऊर परमेश्वर न अपनो सेवकों को खून को बदला लियो हय।” <verse eid="REV 19:2"/><verse number="3" style="v" sid="REV 19:3"/>फिर दूसरी बार उन्न चिल्लाय क कह्यो, “हल्लिलूय्याह! ओको जरन को धुवा हमेशा हमेशा उठतो रहेंन।” <verse eid="REV 19:3"/><verse number="4" style="v" sid="REV 19:4"/>तब चौबीसों बुजूर्गों अऊर चारयी प्रानियों न गिर क परमेश्वर ख दण्डवत कर क् आराधना करयो, जो सिंहासन पर बैठ्यो होतो। अऊर कह्यो, “आमीन! परमेश्वर की स्तुति हो!”<verse eid="REV 19:4"/></para>
  <para style="s">मेम्ना को बिहाव को जेवन</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5"/>तब सिंहासन म सी एक आवाज निकल्यो, “सब ओको सेवक अऊर सब लोग दोयी बड़ो या छोटो हमरो परमेश्वर की स्तुति करो, तुम जो ओको सी डरय हय।” <verse eid="REV 19:5"/><verse number="6" style="v" sid="REV 19:6"/>फिर मय न एक बड़ी भीड़ को जसो, जलप्रवाह को गर्जन को जसो अऊर मेघों कि बड़ी जोर गर्जनों को जसो आवाज सुन्यो, मय न उन्ख कहतो सुन्यो “परमेश्वर की स्तुति हो! कहालीकि प्रभु हमरो परमेश्वर सर्वशक्तिमान राजा आय। <verse eid="REV 19:6"/><verse number="7" style="v" sid="REV 19:7"/>आवो, हम खुश अऊर मगन हो, अऊर ओकी महानता को लायी ओकी महिमा करे, कहालीकि मेम्ना को बिहाव को समय आय गयो हय, अऊर ओकी दुल्हिन न अपनो खुद ख तैयार कर लियो हय। <verse eid="REV 19:7"/><verse number="8" style="v" sid="REV 19:8"/>ओख स्वच्छ अऊर चमकदार मलमल को कपड़ा पहिनन ख दियो गयो। कहालीकि मलमल परमेश्वर को लोगों को अच्छो कामों को प्रतिक हय।”<verse eid="REV 19:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१९:९ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:2">मत्ती २२:२</ref>,<ref loc="MAT 22:3">३</ref></char>
    </note>तब स्वर्गदूत न मोरो सी कह्यो, “यो लिख, कि धन्य हि हंय, जो मेम्ना को बिहाव को जेवन म बुलायो गयो हंय।” अऊर स्वर्गदूत न मोरो सी कह्यो, “यो परमेश्वर को सत्य वचन आय।”<verse eid="REV 19:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10"/>तब मय ओकी आराधना करन लायी ओको पाय पर गिर पड़्यो। पर ओन मोरो सी कह्यो, “असो मत कर, मय तोरो जसो अऊर दूसरों विश्वासियों को जसो एक सेवक आय, हि सब यीशु न प्रगट करी हुयी सच्चायी ख पकड़्यो हुयो हय। परमेश्वर की स्तुति करो कहालीकि जो सच्चायी यीशु न प्रगट करी हि भविष्यवक्तावों ख प्रेरना देवय हय।”<verse eid="REV 19:10"/></para>
  <para style="s">सफेद घोड़ा को सवार</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11"/>फिर मय न स्वर्ग ख खुल्यो हुयो देख्यो, अऊर उत एक सफेद घोड़ा होतो; अऊर घोड़ा को सवार ख विश्वसनिय अऊर सत्य कह्यो जावय होतो, कहालीकि सच्चायी को संग ऊ निर्णय करय हय अऊर ओकी लड़ाई लड़य हय। <verse eid="REV 19:11"/><verse number="12" style="v" sid="REV 19:12"/>ओकी आंखी असी होती मानो अग्नि की ज्वाला जसी लपेट होती, अऊर ओको मुंड पर बहुत सो राजमुकुट होतो। ओको पर एक नाम लिख्यो होतो, पर ओख छोड़ क ऊ का होतो कोयी नहीं जानय। <verse eid="REV 19:12"/><verse number="13" style="v" sid="REV 19:13"/>ऊ खून छिड़क्यो हुयो कपड़ा पहिन्यो होतो, अऊर ओको नाम परमेश्वर को शब्द होतो। <verse eid="REV 19:13"/><verse number="14" style="v" sid="REV 19:14"/>स्वर्ग की सेना सफेद घोड़ा पर सवार अऊर सफेद अऊर शुद्ध मलमल को कपड़ा पहिन्यो हुयो ओको पीछू पीछू होती। <verse eid="REV 19:14"/><verse number="15" style="v" sid="REV 19:15"/><note caller="+" style="x"><char style="xo" closed="false">१९:१५ </char><char style="xt" closed="false"><ref loc="REV 14:20">प्रकाशितवाक्य १४:२०</ref></char></note>राष्ट्रों ख हरावन लायी ओको मुंह सी एक तेज तलवार निकलय हय। ऊ उन पर लोहा को राजदण्ड सी शासन करेंन, अऊर सर्वशक्तिमान परमेश्वर को भयानक प्रकोप की भाति ऊ अंगूररस ख रौंदेंन। <verse eid="REV 19:15"/><verse number="16" style="v" sid="REV 19:16"/>ओको कपड़ा अऊर जांघ पर यो नाम लिख्यो हय: “राजावों को राजा अऊर प्रभुवों को प्रभु।”<verse eid="REV 19:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17"/>फिर मय न एक स्वर्गदूत ख सूरज पर खड़ो हुयो देख्यो। ओन बड़ो आवाज सी पुकार क आसमान को बीच म सी उड़न वालो सब पक्षिंयों सी कह्यो, “आवो, परमेश्वर को बड़ो भोज को लायी जमा होय जावो, <verse eid="REV 19:17"/><verse number="18" style="v" sid="REV 19:18"/>आवो अऊर राजावों को मांस, अऊर सरदारों को मांस, अऊर सिपाहियों को मांस, अऊर शक्तिमान आदमियों को मांस, अऊर घोड़ा को अऊर उन्को सवारों को मांस, अऊर उन्को शरीर, अऊर सेवक छोटो अऊर बड़ो, सब लोगों को शरीर खावो।”<verse eid="REV 19:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19"/>फिर मय न ऊ हिंसक पशु, अऊर धरती को राजावों अऊर उनकी सेनावों ख ऊ घोड़ा को सवार अऊर ओकी सेना सी लड़न लायी जमा देख्यो। <verse eid="REV 19:19"/><verse number="20" style="v" sid="REV 19:20"/><note caller="+" style="x"><char style="xo" closed="false">१९:२० </char><char style="xt" closed="false"><ref loc="REV 13:1-18">प्रकाशितवाक्य १३:१-१८</ref></char></note>ऊ हिंसक पशु, अऊर ओको संग ऊ झूठो भविष्यवक्ता दोयी ख कैदी बनायो गयो जेन ओको सामने असो चिन्ह दिखायो होतो जिन्को द्वारा ओन उन्ख भरमायो जिन पर ऊ पशु की छाप होती अऊर जो वा मूर्ति की पूजा करत होतो। उन हिंसक पशु अऊर झूठो भविष्यवक्ता ख भी जरती हुयी आगी म जीन्दो डाल्यो गयो। <verse eid="REV 19:20"/><verse number="21" style="v" sid="REV 19:21"/>बाकी को सैनिक ऊ घोड़ा को सवार की तलवार सी, जो ओको मुंह सी निकलत होती, मार डाल्यो गयो; अऊर सब पक्षी उन्को मांस खाय क सन्तुष्ट भय गयो।<verse eid="REV 19:21"/></para>
  <chapter eid="REV 19"/>
  <chapter number="20" style="c" sid="REV 20"/>
  <para style="s">हजार साल</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1"/>फिर मय न एक स्वर्गदूत ख स्वर्ग सी उतरतो देख्यो, जेको हाथ म अधोलोक की कुंजी अऊर एक बड़ी संकली होती। <verse eid="REV 20:1"/><verse number="2" style="v" sid="REV 20:2"/>ओन ऊ अजगर, मतलब पुरानो सांप ख, जो इब्लीस अऊर शैतान हय, पकड़ क हजार साल को लायी संकली सी बान्ध दियो, <verse eid="REV 20:2"/><verse number="3" style="v" sid="REV 20:3"/>तब ओन ऊ स्वर्गदूत न ओख अधोलोक म डाल क ताला लगाय दियो अऊर ओको पर मुहर लगाय दी ताकी जब हजार साल पूरो होन तक ऊ लोगों ख फिर नहीं भरमाय सकय। हजार साल पूरो होन को बाद थोड़ो समय को लायी ओख छोड्यो जानो जरूरी हय।<verse eid="REV 20:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4"/>फिर मय न सिंहासनों ख देख्यो, अऊर जो ओको पर बैठ्यो होतो, अऊर उन्ख न्याय करन को अधिकार दियो गयो होतो। मय न उन्की आत्मावों ख भी देख्यो, जिन्को मुंड यीशु की गवाही देनो अऊर परमेश्वर को वचन को वजह काट्यो गयो होतो, अऊर जिन्न ऊ हिंसक पशु की, अऊर नहीं ओकी मूर्ति की पूजा करी होती, अऊर नहीं ओकी छाप अपनो मस्तक अऊर हाथों पर ली होती। अऊर जीन्दो मसीह को संग राजावों को नायी एक हजार साल तक राज्य करतो रहेंन। <verse eid="REV 20:4"/><verse number="5" style="v" sid="REV 20:5"/>जब तक यो हजार साल पूरो नहीं भयो तब तक बाकी मरयो हुयो जीन्दो नहीं भयो। यो त पहिलो पुनरुत्थान आय। <verse eid="REV 20:5"/><verse number="6" style="v" sid="REV 20:6"/>धन्य अऊर पवित्र ऊ आय, जो यो पहिलो पुनरुत्थान को भागी हय। असो पर दूसरी मृत्यु को कुछ भी अधिकार नहाय, हि मसीह अऊर परमेश्वर को याजक होयेंन अऊर ओको संग एक हजार साल तक राज्य करेंन।<verse eid="REV 20:6"/></para>
  <para style="s">शैतान की हार</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7"/>जब हजार साल पूरो होय जायेंन त शैतान कैद सी छोड़ दियो जायेंन। <verse eid="REV 20:7"/><verse number="8" style="v" sid="REV 20:8"/>अऊर ऊ पूरी धरती पर फैलेंन राष्ट्रों ख बहकान लायी निकल पड़ेंन, ऊ गोग अऊर मागोग ख बहकायेंन। ऊ उन्ख लड़ाई को लायी जमा करेंन। हि उतनोच अनगिनत होयेंन जितनो समुन्दर किनार की रेतु को कन। <verse eid="REV 20:8"/><verse number="9" style="v" sid="REV 20:9"/>हि पूरी धरती पर फैल जायेंन हि परमेश्वर को लोगों को छावनी अऊर प्रिय नगर ख घेर लेयेंन; पर आगी स्वर्ग सी खल्लो आयेंन अऊर उन्ख भस्म कर देयेंन। <verse eid="REV 20:9"/><verse number="10" style="v" sid="REV 20:10"/>उन्को भरमावन वालो शैतान आगी अऊर गन्धक की ऊ झील म, जेको म ऊ हिंसक पशु अऊर झूठो भविष्यवक्ता भी होयेंन, इन दोयी ख डाल दियो जायेंन; अऊर हि रात दिन हमेशा हमेशा तकलीफ म तड़पतो रहेंन।<verse eid="REV 20:10"/></para>
  <para style="s">आखरी न्याय</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11"/>तब मय न एक बड़ो सफेद सिंहासन अऊर ओख, जो ओको पर बैठ्यो हुयो हय, देख्यो; ओको सामने सी धरती अऊर आसमान भग खड़ो भयो, अऊर उन्को पता नहीं चल पायो। <verse eid="REV 20:11"/><verse number="12" style="v" sid="REV 20:12"/>तब मय न छोटो बड़ो सब मरयो हुयो ख सिंहासन को सामने खड़ो हुयो देख्यो, अऊर किताबे खोली गयी; अऊर फिर एक अऊर किताब खोली गयी, मतलब जीवन की किताब; अऊर जसो उन किताबों म लिख्यो हुयो होतो, वसोच उन्को कामों को अनुसार मरयो हुयो को न्याय करयो गयो। <verse eid="REV 20:12"/><verse number="13" style="v" sid="REV 20:13"/>जो मृतक लोग समुन्दर म होतो, उन्ख समुन्दर न दे दियो, अऊर मृत्यु अऊर अधोलोक न भी अपनो अपनो मृतक लोगों ख सौंप दियो। अऊर उन म सी हर एक को कामों को अनुसार उन सब को न्याय करयो गयो। <verse eid="REV 20:13"/><verse number="14" style="v" sid="REV 20:14"/>येको बाद मृत्यु अऊर अधोलोक आगी की झील म डाल्यो गयो। या आगी की झील दूसरी मृत्यु आय; <verse eid="REV 20:14"/><verse number="15" style="v" sid="REV 20:15"/>अऊर जो कोयी को नाम जीवन की किताब म लिख्यो हुयो नहीं मिल्यो, ऊ आगी की झील म डाल्यो गयो।<verse eid="REV 20:15"/></para>
  <chapter eid="REV 20"/>
  <chapter number="21" style="c" sid="REV 21"/>
  <para style="s">नयो आसमान अऊर नयी धरती</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२१:१ </char>
      <char style="xt" closed="false">
        <ref loc="2PE 3:13">२ पतरस ३:१३</ref>
      </char>
    </note>फिर मय न नयो आसमान अऊर नयी धरती ख देख्यो, कहालीकि पहिलो आसमान अऊर पहिली धरती गायब होय चुकी होती, अऊर सब समुन्दर भी नहीं रह्यो। <verse eid="REV 21:1"/><verse number="2" style="v" sid="REV 21:2"/><note caller="+" style="x"><char style="xo" closed="false">२१:२ </char><char style="xt" closed="false"><ref loc="REV 3:12">प्रकाशितवाक्य ३:१२</ref></char></note>फिर मय न पवित्र नगर नयो यरूशलेम ख स्वर्ग सी परमेश्वर को जवर सी उतरतो देख्यो। ऊ नगरी ख जो दुल्हिन को समान होती जो अपनो पति लायी सिंगार करयो होना। <verse eid="REV 21:2"/><verse number="3" style="v" sid="REV 21:3"/>फिर मय न सिंहासन म सी कोयी ख ऊचो आवाज सी यो कहतो हुयो सुन्यो, “देखो, अब परमेश्वर को घर आदमियों को बीच म हय। अऊर ऊ उन्को संग रहेंन, अऊर हि ओको लोग होयेंन। अऊर परमेश्वर खुद उन्को संग रहेंन अऊर उन्को परमेश्वर होयेंन। <verse eid="REV 21:3"/><verse number="4" style="v" sid="REV 21:4"/>ऊ उन्की आंखी सी सब आसु पोछ डालेंन। अऊर येको बाद मृत्यु नहीं रहेंन, अऊर नहीं शोक, नहीं विलाप, नहीं तकलीफ रहेंन; पुरानी सब बाते खतम भय गयी हय।”<verse eid="REV 21:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5"/>अऊर जो सिंहासन पर बैठ्यो होतो, ओन कह्यो, “देख, मय सब कुछ नयो कर देऊ हय।” तब ओन कह्यो, “लिख ले, कहालीकि यो वचन विश्वास लायक अऊर सत्य हंय।” <verse eid="REV 21:5"/><verse number="6" style="v" sid="REV 21:6"/>फिर ओन मोरो सी कह्यो, “या बाते पूरी भय गयी हंय। मय अल्फा अऊर ओमेगा आय, पहिलो अऊर आखरी आय। अऊर जो कोयी प्यासो हय ओख मय जीवन को जल को सोता सी फुकट म पिवन को अधिकार देऊ। <verse eid="REV 21:6"/><verse number="7" style="v" sid="REV 21:7"/>जो विजयी होयेंन उच यो सब मोरो सी पायेंन, अऊर मय ओको परमेश्वर होऊं अऊर हि मोरो बेटा होयेंन। <verse eid="REV 21:7"/><verse number="8" style="v" sid="REV 21:8"/>पर डरपोकों, अऊर अविश्वासियों, घिनौना, हत्यारों, व्यभिचारियों, टोन्हों, मूर्तिपूजकों, अऊर सब झूठो को भाग ऊ झील म मिलेंन जो आगी अऊर गन्धक सी जरती रह्य हय: या दूसरी मृत्यु आय।”<verse eid="REV 21:8"/></para>
  <para style="s">नयो यरूशलेम</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9"/>फिर जिन सात स्वर्गदूतों को जवर सात आखरी विपत्तियों सी भरयो हुयो सात कटोरा होतो, उन्म सी एक मोरो जवर आयो, अऊर मोरो संग बाते कर क् कह्यो, “इत आव, मय तोख दुल्हिन मतलब मेम्ना की पत्नी दिखाऊं।” <verse eid="REV 21:9"/><verse number="10" style="v" sid="REV 21:10"/>अऊर आत्मा को द्वारा नियंत्रित भयो अऊर स्वर्गदूत न मोख एक बड़ो अऊर ऊचो पहाड़ी पर ले गयो, अऊर ओन मोख पवित्र नगरी यरूशलेम दिखायो ऊ परमेश्वर को तरफ सी स्वर्ग सी खल्लो उतर रही होती। <verse eid="REV 21:10"/><verse number="11" style="v" sid="REV 21:11"/>अऊर ऊ परमेश्वर की महिमा को संग चमक रही होती, अऊर नगरी बहुमूल्य गोटा, यशब को जसो अऊर काच तरह साफ होती। <verse eid="REV 21:11"/><verse number="12" style="v" sid="REV 21:12"/>नगरी को चारयी तरफ बड़ो ऊचो शहरपनाह होतो जेको म बारा द्वार होतो। उन बारा द्वारों पर स्वर्गदूत होतो। तथा बारा द्वारों पर इस्राएल को बारा गोत्रों को नाम लिख्यो होतो। <verse eid="REV 21:12"/><verse number="13" style="v" sid="REV 21:13"/>इन म सी तीन द्वार पूर्व को तरफ तीन द्वार, उत्तर को तरफ तीन द्वार, दक्षिन को तरफ तीन द्वार, अऊर पश्चिम को तरफ तीन द्वार होती। <verse eid="REV 21:13"/><verse number="14" style="v" sid="REV 21:14"/>नगर को शहरपनाह बारा गोटावों को नीव पर बनायो गयो होतो, अऊर हर एक पर मेम्ना को बारा प्रेरितों को बारा नाम लिख्यो होतो। <verse eid="REV 21:14"/><verse number="15" style="v" sid="REV 21:15"/>जो स्वर्गदूत मोरो संग बाते कर रह्यो होतो ओको जवर नगर अऊर ओको द्वारों अऊर ओकी शहरपनाह ख नापन लायी एक सोनो को छड़ी होतो। <verse eid="REV 21:15"/><verse number="16" style="v" sid="REV 21:16"/>ऊ नगर ख वर्गाकार म बसायो गयो होतो अऊर ओकी लम्बाई, चौड़ाई को बराबर होती; अऊर ओन ऊ छड़ी सी नगर ख नाप्यो, त दोय हजार चार सौ को निकल्यो: ओकी लम्बाई अऊर चौड़ाई अऊर ऊचाई बराबर होती। <verse eid="REV 21:16"/><verse number="17" style="v" sid="REV 21:17"/>ओन ओकी शहरपनाह ख यानेकि जो आदमियों को नाप होतो ऊ स्वर्गदूत को हाथ म होतो नाप सी नाप्यो, त एक सौ चौवालीस हाथ निकली। <verse eid="REV 21:17"/><verse number="18" style="v" sid="REV 21:18"/>ओकी शहरपनाह यशब की बनी होती, अऊर नगर असो शुद्ध सोनो को होतो जो साफ काच को जसो हो। <verse eid="REV 21:18"/><verse number="19" style="v" sid="REV 21:19"/>ऊ शहरपनाह की नीव हर तरह को बहुमूल्य गोटावों सी सवारी हुयी होती; पहिली नीव यशब की, दूसरी नीलमणि की, तीसरी स्फटिक की, चौथी मलकत की, <verse eid="REV 21:19"/><verse number="20" style="v" sid="REV 21:20"/>पाचवी गोमेदक की, छठवी माणिक्य की, सातवी पीतमणि की, आठवी पेरोज की, नववी पुखराज की, दसवी लहसनिए की, ग्यारहवी धूम्रकान्त की, अऊर बारहवी याकूत की होती। <verse eid="REV 21:20"/><verse number="21" style="v" sid="REV 21:21"/>बारा द्वार बारा मोतियों को होतो; एक एक द्वार एक एक मोती को बन्यो होतो। नगर की सड़क साफ काच को जसो शुद्ध सोनो की होती।<verse eid="REV 21:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22"/>मय न ओको म कोयी मन्दिर नहीं देख्यो, कहालीकि सर्वशक्तिमान प्रभु परमेश्वर अऊर मेम्ना ओको मन्दिर हय। <verse eid="REV 21:22"/><verse number="23" style="v" sid="REV 21:23"/>ऊ नगर म सूरज अऊर चन्दा को उजाड़ो की जरूरत नहीं, कहालीकि परमेश्वर को तेज सी ओको म उजाड़ो होय रह्यो हय, अऊर मेम्ना ओको दीया हय। <verse eid="REV 21:23"/><verse number="24" style="v" sid="REV 21:24"/>जाति–जाति को लोग ओकी ज्योति म चले–फिरेंन, अऊर धरती को राजा अपनो अपनो वैभव ओको म लायेंन। <verse eid="REV 21:24"/><verse number="25" style="v" sid="REV 21:25"/>ओकी द्वार पूरो दिन भर खुली रहेंन, अऊर रात उत नहीं होयेंन। <verse eid="REV 21:25"/><verse number="26" style="v" sid="REV 21:26"/>अऊर लोग राष्ट्रों को वैभव अऊर धन को सामान ओको म लायेंन। <verse eid="REV 21:26"/><verse number="27" style="v" sid="REV 21:27"/>पर ओको म कोयी अपवित्र चिज, या घृणित काम करन वालो, या झूठ को गढ़न वालो कोयी रीति सी सिरय नहीं, पर केवल हि लोग जिन्को नाम मेम्ना को जीवन की किताब म लिख्यो हंय।<verse eid="REV 21:27"/></para>
  <chapter eid="REV 21"/>
  <chapter number="22" style="c" sid="REV 22"/>
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1"/>येको बाद ऊ स्वर्गदूत न मोख जीवन देन वालो पानी की नदी दिखायी। वा नदी स्फटिक को जसी उज्वल होती। ऊ परमेश्वर अऊर मेम्ना को सिंहासन सी निकलत होती <verse eid="REV 22:1"/><verse number="2" style="v" sid="REV 22:2"/>ऊ नगर की सड़क को बीचो बीच सी बहत होती। नदी को यो पार अऊर ओन पार जीवन को झाड़ होतो; उन पर हर साल बारा बार फर लगत होतो हर महीना म एक बार, अऊर ऊ झाड़ियों को पाना सी राष्ट्रों को लोगों ख निरोगी करन लायी होतो।<verse eid="REV 22:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 22:3"/>अऊर नगर म कोयी भी परमेश्वर को श्राप म नहीं रहेंन, अऊर परमेश्वर को सिंहासन अऊर मेम्ना ऊ नगरी म रहेंन अऊर ओको सेवक ओकी सेवा करेंन। <verse eid="REV 22:3"/><verse number="4" style="v" sid="REV 22:4"/>हि ओको मुंह देखेंन, अऊर ओको नाम ओको हाथों पर लिख्यो हुयो होना। <verse eid="REV 22:4"/><verse number="5" style="v" sid="REV 22:5"/>फिर रात नहीं होयेंन, अऊर उन्ख दीया अऊर सूरज को प्रकाश की जरूरत नहीं होयेंन, कहालीकि प्रभु परमेश्वर उन्को प्रकाश होयेंन, अऊर ऊ राजा को जसो हमेशा हमेशा शासन करेंन।<verse eid="REV 22:5"/></para>
  <para style="s">यीशु को आवनो</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6"/>फिर ऊ स्वर्गदूत न मोरो सी कह्यो, “या बाते सत्य अऊर विश्वास को लायक हंय। अऊर प्रभु परमेश्वर, जो भविष्यवक्तावों ख ओकी आत्मा देवय हय, अपनो स्वर्गदूत ख येकोलायी भेज्यो कि अपनो सेवकों ख हि बाते, जिन्को जल्दी पूरो होनो जरूरी हय, दिखाये।”<verse eid="REV 22:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7"/>“देख, मय जल्दी आवन वालो हय! धन्य हय ऊ जो या किताब की भविष्यवानी की बाते पालन करय हय।”<verse eid="REV 22:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8"/>मय उच यूहन्ना आय, जो या बाते सुनत अऊर देखत होतो। जब मय न सुन्यो अऊर देख्यो, त जो स्वर्गदूत मोख या बाते दिखावत होतो, मय ओको पाय पर दण्डवत आराधना करन लायी गिर पड़्यो। <verse eid="REV 22:8"/><verse number="9" style="v" sid="REV 22:9"/>पर ओन मोरो सी कह्यो, “देख, असो मत कर; कहालीकि मय तोरो, अऊर तोरो भाऊ भविष्यवक्तावों, अऊर या किताब की बातों को मानन वालो को संगी सेवक हय। परमेश्वर कि आराधना कर।” <verse eid="REV 22:9"/><verse number="10" style="v" sid="REV 22:10"/>फिर ओन मोरो सी कह्यो, “या किताब की भविष्यवानी की बातों ख गुप्त मत रख; कहालीकि या सब बातों को पूरो होन को समय बहुत जवर हय। <verse eid="REV 22:10"/><verse number="11" style="v" sid="REV 22:11"/>जो अधर्म करय हय, ऊ अन्याय करतो रहे; अऊर जो मलिन हय, ऊ मलिन बन्यो रहे; अऊर जो अच्छो हय, ऊ अच्छो बन्यो रहे; अऊर जो सच्चो हय; ऊ पवित्र बन्यो रहे।”<verse eid="REV 22:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12"/>“देख, मय जल्दी आवन वालो हय; अऊर हर एक को काम को अनुसार मोहबदला देन लायी प्रतिफल मोरो जवर हय। <verse eid="REV 22:12"/><verse number="13" style="v" sid="REV 22:13"/><note caller="+" style="x"><char style="xo" closed="false">२२:१३ </char><char style="xt" closed="false"><ref loc="REV 1:8">प्रकाशितवाक्य १:८</ref>; </char><char style="xt" closed="false"><ref loc="REV 1:17">प्रकाशितवाक्य १:१७</ref>; <ref loc="REV 2:8">२:८</ref></char></note>मय अल्फा अऊर ओमेगा, पहिलो अऊर आखरी, आदि अऊर अन्त आय।<verse eid="REV 22:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14"/>“धन्य हि आय, जो अपनो कपड़ा धोय लेवय हंय, कहालीकि उन्ख जीवन को झाड़ को जवर आवन को अधिकार मिलेंन, अऊर हि द्वार सी होय क नगर म सिरेंन। <verse eid="REV 22:14"/><verse number="15" style="v" sid="REV 22:15"/>पर कुत्ता, अऊर टोन्हा करन वालो, अऊर अनैतिक सम्बन्ध करन वालो, अऊर हत्यारों, अऊर मूर्तिपूजक, अऊर हर एक झूठ को चाहन वालो अऊर गढ़न वालो बाहेर रहेंन।<verse eid="REV 22:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16"/>“यीशु न अपनो स्वर्गदूत ख येकोलायी भेज्यो कि तुम्हरो आगु मण्डलियों को बारे म इन बातों की गवाही दे। मय दाऊद को परिवार को वंशज आय, अऊर भोर को चमकतो हुयो तारा आय।”<verse eid="REV 22:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17"/>आत्मा अऊर दुल्हिन दोयी कह्य हंय, “आव!”</para>
  <para style="p" vid="REV 22:17">अऊर सुनन वालो भी कहे, “आव!”</para>
  <para style="p" vid="REV 22:17">जो प्यासो हय ऊ आवो, अऊर जो कोयी चाहे ऊ जीवन को जल को ईनाम फुकट भाव सी ले।<verse eid="REV 22:17"/></para>
  <para style="s">समापन</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18"/>मय यूहन्ना हर एक आदमी ख, जो या किताब की भविष्यवानी की बाते सुनय हय, चेतावनी देऊ हय: यदि कोयी आदमी इन बातों म कुछ बढ़ाये त परमेश्वर उन विपत्तियों ख, जो इन किताब म लिखी हंय, ओको शिक्षा पर बढ़ायेंन। <verse eid="REV 22:18"/><verse number="19" style="v" sid="REV 22:19"/>यदि कोयी या भविष्यवानी की किताब की बातों म सी कुछ निकाल डाले, त परमेश्वर ऊ जीवन को झाड़ अऊर पवित्र नगर म सी, जेको वर्नन या किताब म हय, ओको भाग निकाल देयेंन।<verse eid="REV 22:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20"/>यीशु जो इन बातों को गवाह हय, ऊ कह्य हय, “हव, मय जल्दी आय रह्यो हय।” आमीन। हे प्रभु यीशु आव!<verse eid="REV 22:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21"/>प्रभु यीशु को अनुग्रह परमेश्वर को लोगों को संग रहे। आमीन।<verse eid="REV 22:21"/></para>
  <chapter eid="REV 22"/>
</usx>
