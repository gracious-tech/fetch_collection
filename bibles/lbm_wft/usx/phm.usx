<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Lodhi</book>
  <para style="h">फिलेमोन</para>
  <para style="toc3">फिलेमोन</para>
  <para style="toc2">फिलेमोन</para>
  <para style="toc1">फिलेमोन को नाम पौलुस प्रेरित की चिट्ठी</para>
  <para style="mt2">फिलेमोन के नाम पौलुस प्रेरित की पत्री</para>
  <para style="mt1">फिलेमोन को नाम पौलुस प्रेरित की चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">फिलेमोन की या छोटी किताब प्रेरित पौलुस को द्वारा लिखी गयी होती। <char style="xt"><ref loc="PHM 1:1">१:१</ref></char> पौलुस जेलखाना म होतो तब ओन या चिट्ठी ख लिख्यो होतो, जेको अर्थ हय कि ऊ रोम सी लिख रह्यो होतो। अगर ऊ रोम सी होतो त या मसीह को जनम को ६१ साल बाद लिख्यो होना जो ऊ समय कुलुस्सियों न भी लिख्यो होतो।</para>
  <para style="ip">या चिट्ठी फिलेमोन नाम को एक व्यक्ति ख लिख्यो होतो। फिलेमोन मण्डली को सदस्य अऊर मालिक भी होतो पौलुस न ओको सी पुच्छ्यो कि ऊ अपनो सेवक उनेसिमुस ख सजा नहीं देयेंन, जो फिलेमोन को इत सी भग गयो होतो, रोमन शासन को द्वारा फिलेमोन को उनेसिमुस ख मौत की सजा देन को अधिकार होतो, पौलुस फिलेमोन को एक मसीह भाऊ को रूप म उनेसिमुस ख स्वीकार करनो यां प्रोत्साहित करन लायी प्रेरक तर्कों को उपयोग करत होतो, अऊर यो भी सुझाव देत होतो की उनेसिमुस ख पौलुस को संग सेवा करन की अनुमति देत होतो। <char style="xt"><ref loc="PHM 1:13-14">१:१३-१४</ref></char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पौलुस फिलेमोन ख नमस्कार करय हय। <char style="ior"><ref loc="PHM 1:1-3">१:१-३</ref></char></para>
  <para style="io1">२. पौलुस उनेसिमुस को तरफ सी पूछय हय कि फिलेमोन ओख एक मसीह भाऊ को रूप म स्वीकार करेंन। <char style="ior"><ref loc="PHM 1:4-21">१:४-२१</ref></char></para>
  <para style="io1">३. पौलुस की यात्रा करनो अऊर बधायी भेजन की घोषना कर क् चिट्ठी लिखनो बन्द करय हय। <char style="ior"><ref loc="PHM 1:22-25">१:२२-२५</ref></char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />तीमुथियुस अऊर मय पौलुस को तरफ सी जो प्रभु मसीह यीशु को लायी मय बन्दी बन्यो हय, हमरो प्रिय भाऊ सहकर्मी फिलेमोन, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" /><note caller="+" style="x"><char style="xo" closed="false">१:२ </char><char style="xt" closed="false"><ref loc="COL 4:17">कुलुस्सियों ४:१७</ref></char></note>अऊर बहिन अफफिया, अऊर हमरो संगी योद्धा अरखिप्पुस अऊर फिलेमोन को घर म जमा होन वाली मण्डली को नाम।<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />हमरो पिता परमेश्वर अऊर प्रभु यीशु मसीह को तरफ सी अनुग्रह अऊर शान्ति तुम्ख मिलती रहे।<verse eid="PHM 1:3" /></para>
  <para style="s">फिलेमोन को प्रेम अऊर विश्वास</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />भाऊ फिलेमोन, मय हमेशा परमेश्वर को धन्यवाद करू हय, अऊर अपनी प्रार्थनावों म भी तोख याद करू हय। <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />कहालीकि मय प्रभु यीशु मसीह को लोगों को प्रति तुम्हरो प्रेम अऊर विश्वास को बारे म सुनतो रहू हय, <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />मय प्रार्थना करू हय कि आप खुद को विश्वास ख बाटन म तत्पर बन्यो रहे जेकोसी यीशु मसीह म एकता को द्वारा हमरी जीवन की पूरी अच्छी बातों को तुम्ख पूरी रीति सी ज्ञान हो। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />कहालीकि हे भाऊ, मोख तोरो प्रेम सी बहुत खुशी अऊर प्रोत्साहन मिल्यो, येकोलायी कि तोरो सी परमेश्वर को लोगों को मन खुश भय गयो हंय।<verse eid="PHM 1:7" /></para>
  <para style="s">उनेसिमुस लायी बिनती</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />येकोलायी कि मोख मसीह म भाऊ होन को नाते जो तुम ख करनो चाहिये ओख धीरज सी बतावन को अधिकार मोरो म हय। <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />तब भी ऊ प्रेम को वजह मोख यानेकि पौलुस को लायी जो अब यीशु मसीह को कैदी भी आय, योच ठीक जान पड़्यो कि तोरो सी बिनती करू। <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" /><note caller="+" style="x"><char style="xo" closed="false">१:१० </char><char style="xt" closed="false"><ref loc="COL 4:9">कुलुस्सियों ४:९</ref></char></note>त मय उनेसिमुस को तरफ सी आप ख बिनती करू हय, जो मसीह म मोरो टुरा हय अऊर जब मय जेलखाना को समय मय ओको आत्मिक बाप बन्यो। <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />ऊ त पहिले तोरो कुछ काम को नहीं होतो, पर अब तोरो अऊर मोरो दोयी को बड़ो काम को हय।<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />ओखच यानेकि जो मोरो दिल को टुकड़ा आय, मय न ओख तोरो जवर लौटाय दियो हय। <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />ओख मय अपनोच जवर रखनो चाहत होतो कि तोरो तरफ सी यो जेल म जो सुसमाचार को वजह हय, तोरी जागा पर मोरी सेवा करे। <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />पर मय न तोरी इच्छा को बिना कुछ भी करनो नहीं चाह्यो कि तोरी यो कृपा दबाव सी नहीं पर खुशी सी होय।<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />शायद ऊ मोरो सी कुछ दिन लायी योच वजह अलग भयो कि अनन्त काल तक तोरो जवर रहे। <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />पर अब सी सेवक को जसो नहीं, बल्की सेवक सी भी अच्छो, यानेकि ऊ मोख त प्रिय हय पर ऊ आदमी अऊर एक प्रभु भाऊ होन को नाते ओख मोरो सी जादा प्रेम करो।<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />येकोलायी यदि तय मोख सहभागी समझय हय, त ओख यो तरह स्वीकार कर जसो मोख करय हय। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />अऊर यदि ओन तोरी कुछ हानि करी हय, यां ओको पर तोरो कुछ कर्जा आवय हय, त मोरो नाम पर लिख ले। <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />मय पौलुस अपनो हाथ सी लिखूं हय, कि मय खुद भर देऊ; अऊर मोख कुछ बतावन की जरूरत नहाय, कि तय त मोरो जीवन भर को लायी मोरो कर्जदार हय। <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />हे भाऊ, मोख तोरो सी प्रभु यीशु मसीह म यो फायदा प्राप्त हो मोरो दिल ख ताजगी मिले।<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />मय निश्चित होय क यो तोख लिखू हय, जो मय न तोख करन लायी कह्यो ऊ तय करजो। अऊर यो जानु हय कि जो कुछ मय कहू हय, तय ओको सी कहीं बढ़ क करजो। <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />अऊर यो भी कि मोरो लायी रूकन की जागा तैयार रख। मोख आशा हय कि तुम्हरी प्रार्थनावों को द्वारा परमेश्वर मोख तुम्हरो जवर लौटाय देयेंन।<verse eid="PHM 1:22" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:२३ </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">कुलुस्सियों १:७</ref>; <ref loc="COL 4:12">४:१२</ref></char>
    </note>इपफ्रास, जो मसीह यीशु म मोरो संग कैदी हय, <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" /><note caller="+" style="x"><char style="xo" closed="false">१:२४ </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेरितों १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref>; <ref loc="COL 4:10">कुलुस्सियों ४:१०</ref>; </char><char style="xt" closed="false"><ref loc="ACT 19:29">प्रेरितों १९:२९</ref>; <ref loc="ACT 27:2">२७:२</ref>; <ref loc="COL 4:10">कुलुस्सियों ४:१०</ref>; </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सियों ४:१४</ref>; <ref loc="2TI 4:10">२ तीमुथियुस ४:१०</ref>; </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सियों ४:१४</ref>; <ref loc="2TI 4:11">२ तीमुथियुस ४:११</ref></char></note>अऊर मरकुस अऊर अरिस्तर्खुस अऊर देमास अऊर लूका जो मोरो सहकर्मी हंय, इन्को तोख प्रनाम।<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />हमरो प्रभु यीशु मसीह को अनुग्रह तुम सब पर बन्यो रहेंन।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>