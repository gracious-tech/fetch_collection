<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1PE" style="id">-Lodhi</book>
  <para style="h">१ पतरस</para>
  <para style="toc3">१ पतरस</para>
  <para style="toc2">१ पतरस</para>
  <para style="toc1">पतरस की पहली चिट्ठी</para>
  <para style="mt2">पतरस की पहली पत्री</para>
  <para style="mt1">पतरस की पहिली चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">१ पतरस की चिट्ठी प्रेरित पतरस को द्वारा लिखी गयी होती। पतरस न यो कह्य क अपनी चिट्ठी सुरू करी कि ऊ कौन होतो अऊर कोन्को लायी ऊ लिख रह्यो होतो। उन्न उन सब मसीह भाऊवों ख चिट्ठी सी सम्बोधित करयो जिन्ख उन्न “अनजानो” कह्यो <char style="xt"><ref loc="1PE 1:1">१:१</ref></char>, <char style="xt"><ref loc="1PE 1:17">१:१७</ref></char>, अऊर <char style="xt"><ref loc="1PE 2:11">२:११</ref></char>। उन्न अपनो पढ़न वालो ख यो तरह कुछ बार बतायो कहालीकि हि अलग अलग देशों म बिखरयो हुयो होतो। कहालीकि या चिट्ठी कुछ तरीका सी इफिसियों ख पौलुस कि चिट्ठी जसी दिखय हय, कुछ लोग मानय हय कि मसीह को जनम को ६५ साल बाद इफिसियों को बाद १ पतरस लिख्यो गयो होतो। पतरस न रोम सी या चिट्ठी लिखी होती जेक ओन बेबीलोन कह्यो <char style="xt"><ref loc="1PE 5:13">५:१३</ref>। </char></para>
  <para style="ip">पतरस कह्य हय कि उन्न या चिट्ठी ख “तुम्ख प्रोत्साहित करन अऊर यो प्रमाणित करन को उद्देश सी लिख्यो कि यो परमेश्वर कि सच्ची कृपा आय” <char style="xt"><ref loc="1PE 5:12">५:१२</ref>।</char> <char style="xt"><ref loc="1PE 2:11-3:7">१ पतरस २:११–३:७</ref></char> <char style="xt"><ref loc="EPH 5:18-6:9">इफिसियों ५:१८–६:९</ref></char> अऊर <char style="xt"><ref loc="COL 3:18-4:6">कुलुस्सियों ३:१८–४:६</ref></char> को बीच कुछ समानता हय। ऊ दुखियों ख दु:ख होन पर हिम्मत सी प्रोत्साहित करय हय कहालीकि अन्त जवर हय। <char style="xt"><ref loc="1PE 4:1">४:१</ref> </char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. अपनो पढ़न वालो ख सम्बोधित करन लायी पतरस खुद ख पेश करय हय। <char style="ior"><ref loc="1PE 1:1-2">१:१-२</ref> </char></para>
  <para style="io1">२. फिर ऊ उद्धार को लायी परमेश्वर को धन्यवाद करय हय कि हि सब मेल मिलाप करय हय अऊर येको अर्थ उन्को जीवन को लायी आय। <char style="ior"><ref loc="1PE 1:3-2:10">१:३–२:१०</ref></char></para>
  <para style="io1">३. हर समय ऊ विश्वासियों ख निर्देश देवय हय कि कसो जगत म अच्छो तरह सी रहनो हय अऊर पति अऊर पत्नी अऊर सेवक अऊर गुरु को बीच अलग अलग रिश्ता ख सम्बोधित करय हय। <char style="ior"><ref loc="1PE 2:11-4:11">२:११–४:११</ref></char></para>
  <para style="io1">४. ओको बाद पतरस दु:ख को समय उन्ख हिम्मत सी प्रोत्साहित करय हय। <char style="ior"><ref loc="1PE 4:12-5:11">४:१२–५:११</ref></char></para>
  <para style="io1">५. तब ऊ अपनी चिट्ठी लिखनो बन्द कर देवय हय। <char style="ior"><ref loc="1PE 5:12-14">५:१२-१४</ref></char></para>
  <chapter number="1" style="c" sid="1PE 1"/>
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1"/>पतरस को तरफ सी जो यीशु मसीह को प्रेरित हय, उन चुन्यो हुयो परमेश्वर को लोग जो पुन्तुस, गलातिया, कप्पदूकिया, आसिया अऊर बितूनिया म तितर-बितर होय क निर्वाशित जसो रह्य हंय, <verse eid="1PE 1:1"/><verse number="2" style="v" sid="1PE 1:2"/>तुम पिता परमेश्वर को पूर्व उद्देश को अनुसार चुन्यो गयो हय अऊर ओकी आत्मा को द्वारा पवित्र लोग ठहरायो गयो, येकोलायी की यीशु मसीह की आज्ञा माने अऊर ओको खून को छिड़काव को द्वारा पवित्र ठहरायो गयो हय।</para>
  <para style="p" vid="1PE 1:2">तुम पर परमेश्वर को तरफ सी अनुग्रह अऊर शान्ति बहुतायत सी होती रहे।<verse eid="1PE 1:2"/></para>
  <para style="s">एक जीन्दी आशा</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3"/>हमरो प्रभु यीशु मसीह को परमेश्वर पिता को धन्यवाद हो, जेन यीशु मसीह को मरयो हुयो म सी जीन्दो करन को द्वारा, अपनी बड़ी दया सी हम्ख जीन्दी आशा लायी नयो जनम दियो, <verse eid="1PE 1:3"/><verse number="4" style="v" sid="1PE 1:4"/>मतलब एक अविनाशी, अऊर निर्मल, अजर विरासत लायी जो तुम्हरो लायी स्वर्ग म रखी हय; <verse eid="1PE 1:4"/><verse number="5" style="v" sid="1PE 1:5"/>जो विश्वास को द्वारा सुरक्षित हय परमेश्वर की सामर्थ को द्वारा ऊ उद्धार लायी जो आखरी समय म प्रगट होन को लायी तैयार हय।<verse eid="1PE 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6"/>येकोलायी तुम बहुतायत सी खुश रहो, हालांकि अभी थोड़ो समय को लायी अलग अलग तरह की परीक्षावों को वजह दु:ख उठानो पड़ेंन; <verse eid="1PE 1:6"/><verse number="7" style="v" sid="1PE 1:7"/>अऊर यो येकोलायी हय कि तुम्हरो विश्वास परख्यो जाये, जो आगी सी तपायो हुयो नाशवान सोना सी भी बहुत जादा किमती हय, उन्को उद्देश यो हय कि ऊ शुद्ध निकले, जब यीशु मसीह प्रगट होयेंन ऊ दिन तब तुम्ख प्रशंसा अऊर महिमा अऊर आदर मिलेंन। <verse eid="1PE 1:7"/><verse number="8" style="v" sid="1PE 1:8"/>तुम ओको सी प्रेम करय हय जब की तुम न ओख देख्यो नहीं, अऊर तुम ओको पर विश्वास करय हय जब की तुम न अभी ओख देख्यो नहीं त तुम महिमामय खुशी सी खुश होय जावो शब्दों सी बयान नहीं करयो जाय सकय; <verse eid="1PE 1:8"/><verse number="9" style="v" sid="1PE 1:9"/>तुम्हरो आत्मावों को उद्धार यो जो तुम्हरो विश्वास को उद्देश तुम ओको म प्राप्त करय हय।<verse eid="1PE 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10"/>योच उद्धार को बारे म उन भविष्यवक्तावों न ध्यान सी खोजबीन अऊर जांच-पड़ताल करी, जिन्न ऊ अनुग्रह को बारे म जो तुम पर होन ख होतो, भविष्यवानी करी होती। <verse eid="1PE 1:10"/><verse number="11" style="v" sid="1PE 1:11"/>उन भविष्यवक्तावों न खोज करी ऊ समय कब अऊर कसो आयेंन। ऊ यो समय होतो जेको बारे म मसीह की आत्मा जो उन्म होती जो बाते मसीह पर आवन वालो दु:ख अऊर ओको बाद प्रगट होन वाली महिमा को बारे म निर्देशन करत होती। <verse eid="1PE 1:11"/><verse number="12" style="v" sid="1PE 1:12"/>परमेश्वर न उन भविष्यवक्तावों पर प्रगट करयो गयो कि हि अपनी खुद की नहीं बल्की तुम्हरी सेवा लायी यो बाते कहत होतो, जिन्को समाचार अब तुम्ख उन्को द्वारा मिल्यो जिन्न पवित्र आत्मा सी, जो स्वर्ग सी भेज्यो गयो, तुम्ख सुसमाचार सुनायो; अऊर इन बातों ख स्वर्गदूत भी ध्यान सी समझन की इच्छा रखय हंय।<verse eid="1PE 1:12"/></para>
  <para style="s">पवित्र जीवन की बुलाहट</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13"/>येकोलायी मानसिक रूप सी सचेत रहो; खुद नियंत्रन म रहो, जब यीशु मसीह प्रगट होयेंन तब जो आशीष तुम ख मिलन की हय, ओको पर अपनी आशा पूरी रीति सी लगायो रखो। <verse eid="1PE 1:13"/><verse number="14" style="v" sid="1PE 1:14"/>आज्ञाकारी बच्चां को जसो, ऊ समय की बुरी इच्छावों को अनुसार अपनो आप ख मत ढालो जो तुम म पहिले होती, जब तुम अज्ञानी होतो। <verse eid="1PE 1:14"/><verse number="15" style="v" sid="1PE 1:15"/>पर जसो तुम्हरो बुलावन वालो पवित्र हय, वसोच तुम भी अपनो पूरो चाल-चलन म पवित्र बनो। <verse eid="1PE 1:15"/><verse number="16" style="v" sid="1PE 1:16"/>कहालीकि शास्त्र म लिख्यो हय, “पवित्र बनो, कहालीकि मय पवित्र हय।”<verse eid="1PE 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17"/>अऊर यदि तुम, हरेक को कर्मों को अनुसार पक्षपात रहित होय क न्याय करन वालो परमेश्वर ख प्रार्थना म हे बाप कह्य क पुकारय हय, त यो धरती पर परदेशी होय क परमेश्वर ख सम्मान देतो हुयो डर को संग जीवन जीवो। <verse eid="1PE 1:17"/><verse number="18" style="v" sid="1PE 1:18"/>कहालीकि तुम जानय हय कि तुम्हरो निकम्मो चाल-चलन को तरीका जो बापदादों सी चल्यो आवय हय, ओको सी तुम्हरो छुटकारा चांदी-सोना यानेकि बेकार चिजों को द्वारा नहीं भयो; <verse eid="1PE 1:18"/><verse number="19" style="v" sid="1PE 1:19"/>बल्की बहुमूल्य मसीह को अर्पन को द्वारा जो एक निर्दोष अऊर निष्कलंक मेम्ना को जसो होतो। <verse eid="1PE 1:19"/><verse number="20" style="v" sid="1PE 1:20"/>सृष्टि को निर्मान को पहिले परमेश्वर को द्वारा मसीह ख चुन्यो गयो होतो, पर तुम्हरो लायी आखरी दिनो म ओख प्रगट करयो गयो। <verse eid="1PE 1:20"/><verse number="21" style="v" sid="1PE 1:21"/>ऊ मसीह को द्वारा तुम ऊ परमेश्वर पर विश्वास करय हय, जेन ओख मरयो हुयो म सी जीन्दो करयो अऊर महिमा दी कि ताकी तुम्हरो विश्वास अऊर आशा परमेश्वर पर टिक्यो रहेंन।<verse eid="1PE 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22"/>जब तुम न सच को पालन करतो हुयो सच्चो भाईचारा को प्रेम ख प्रदर्शित करन लायी अपनो आप ख निष्कपट कर लियो हय त पूरो दिल को संग आपस म एक दूसरों सी प्रेम करे। <verse eid="1PE 1:22"/><verse number="23" style="v" sid="1PE 1:23"/>कहालीकि तुम न नाशवान नहीं पर अविनाशी बीज सी, परमेश्वर को जीवतो अऊर हमेशा ठहरन वालो वचन को द्वारा नयो जनम पायो हय। <verse eid="1PE 1:23"/><verse number="24" style="v" sid="1PE 1:24"/>कहालीकि</para>
  <para style="q1" vid="1PE 1:24">जसो शास्त्र म लिख्यो हय “हर एक प्रानी घास को जसो हय,</para>
  <para style="q2" vid="1PE 1:24">अऊर ओकी पूरी शोभा</para>
  <para style="q1" vid="1PE 1:24">जंगली फूलो को जसो हय। अऊर घास सुक जावय हय।<verse eid="1PE 1:24"/></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25"/>पर प्रभु को वचन हमेशा हमेशा स्थिर रह्य हय।”</para>
  <para style="m" vid="1PE 1:25">अऊर योच सुसमाचार को वचन हय जो तुम्ख घोषित करयो गयो होतो।<verse eid="1PE 1:25"/></para>
  <chapter eid="1PE 1"/>
  <chapter number="2" style="c" sid="1PE 2"/>
  <para style="s">सजीव गोटा अऊर पवित्र प्रजा</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1"/>येकोलायी सब तरह की बुरायी, अऊर कपट, जलन या अपमानित भाषा ख अपनो आप म सी निकाल देवो। <verse eid="1PE 2:1"/><verse number="2" style="v" sid="1PE 2:2"/>नयो जनम भयो बच्चां को जसो शुद्ध आत्मिक दूध को प्यासो रहो, येकोलायी येको पिवन को द्वारा तुम्हरो विकास अऊर उद्धार बचायो जाये। <verse eid="1PE 2:2"/><verse number="3" style="v" sid="1PE 2:3"/>जसो कि शास्त्र म लिख्यो हय, अपनो आप जान लियो कि प्रभु कितनो भलो हय।<verse eid="1PE 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4"/>प्रभु को जवर आवो, ऊ सजीव गोटा जो लोगों को द्वारा बेकार समझ क नकार दियो होतो पर जो परमेश्वर को लायी बहुमूल्य हय ओको द्वारा चुन्यो गयो होतो, <verse eid="1PE 2:4"/><verse number="5" style="v" sid="1PE 2:5"/>तुम भी सजीव गोटा को जसो आत्मिक मन्दिरों को रूप म बनायो जाय रह्यो हय ताकी एक असो पवित्र याजकमण्डल को रूप म सेवा कर सको जेको कर्तव्य असो आध्यात्मिक बलिदान समर्पित करय हय जो यीशु मसीह को द्वारा परमेश्वर को स्वीकार लायक हो। <verse eid="1PE 2:5"/><verse number="6" style="v" sid="1PE 2:6"/>यो कारण पवित्र शास्त्र म भी लिख्यो हय:</para>
  <para style="q1" vid="1PE 2:6">“मय एक बहुमूल्य गोटा चुन्यो हय</para>
  <para style="q2" vid="1PE 2:6">जेक मय न सिय्योन को कोना को गोटा रख्यो हय;</para>
  <para style="q2" vid="1PE 2:6">जो कोयी ओको म विश्वास करेंन ऊ कभी भी शर्मिन्दा नहीं होयेंन।”<verse eid="1PE 2:6"/></para>
  <para style="m">
    <verse number="7" style="v" sid="1PE 2:7"/>तुम विश्वासियों को लायी यो गोटा बहुत बहुमूल्य हय; पर जो विश्वास नहीं करय:</para>
  <para style="q1" vid="1PE 2:7">ऊ गोटा जेक राजमिस्त्रियों न बेकार समझ क</para>
  <para style="q2" vid="1PE 2:7">नकारयो उच गोटा सब को लायी महत्वपूर्ण कोना को गोटा बन गयो:<verse eid="1PE 2:7"/></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8"/>अऊर शास्त्र म यो भी लिख्यो हय,</para>
  <para style="q1" vid="1PE 2:8">“यो ऊ गोटा आय जो लोगों ख ठेस पहुंचायेंन,</para>
  <para style="q2" vid="1PE 2:8">यो चट्टान जो लोगों ख ठोकर दे क गिरायेंन,”</para>
  <para style="m" vid="1PE 2:8">ऊ ठोकर खायेंन कहालीकि हि परमेश्वर को वचन पर विश्वास नहीं करय अऊर योच उन्को लायी परमेश्वर की इच्छा होती।<verse eid="1PE 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२:९ </char>
      <char style="xt" closed="false">
        <ref loc="TIT 2:14">तीतुस २:१४</ref>
      </char>
    </note>पर तुम एक चुन्यो हुयो वंश, अऊर राज-पदधारी याजकों को समाज, पवित्र प्रजा, अऊर परमेश्वर को खुद को लोग हो, येकोलायी कि जेन तुम्ख अन्धारो म सी अपनी अद्भुत ज्योति म बुलायो हय, ओको महान काम की घोषना करो। <verse eid="1PE 2:9"/><verse number="10" style="v" sid="1PE 2:10"/>एक समय होतो जब तुम प्रजा नहीं होतो पर अब तुम परमेश्वर की प्रजा हो। एक समय होतो जब तुम दया को लायक नहीं होतो पर अब तुम पर परमेश्वर न दया दिखायी हय।<verse eid="1PE 2:10"/></para>
  <para style="s">परमेश्वर को सेवक</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11"/>हे प्रिय संगियों, मय तुम सी, जो यो जगत म अजनबी को रूप म हय, आग्रह करू हय कि ऊ शारीरिक इच्छावों सी दूर रहो जो तुम्हरी आत्मावों सी लड़ती रह्य हय। <verse eid="1PE 2:11"/><verse number="12" style="v" sid="1PE 2:12"/>गैरयहूदी को बीच अपनो व्यवहार इतनो अच्छो बनायो रखो कि चाहे हि अपराधी को रूप म तुम्हरी आलोचना करे पर तुम्हरो अच्छो कर्मों को परिनाम स्वरूप ओको आवन को दिन हि परमेश्वर ख महिमा प्रदान करे।<verse eid="1PE 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13"/>प्रभु को लायी अपनो आप ख हर मानव अधिकारी को अधीन रहो: सर्वोच्च को अधीन येकोलायी कि ऊ सब पर शासन करय हय, <verse eid="1PE 2:13"/><verse number="14" style="v" sid="1PE 2:14"/>अऊर शासकों को, कहालीकि हि गलत काम करन वालो ख न्याय देन अऊर अच्छो लोगों की बड़ायी को लायी ओको भेज्यो हुयो हंय। <verse eid="1PE 2:14"/><verse number="15" style="v" sid="1PE 2:15"/>कहालीकि परमेश्वर तुम सी यो चाहवय हय कि तुम अपनो अच्छो कार्यो सी मुर्ख लोगों की अज्ञानता की बातों ख चुप कराय देवो। <verse eid="1PE 2:15"/><verse number="16" style="v" sid="1PE 2:16"/>अपनो आप ख स्वतंत्र व्यक्ति को जसो जीवन बितावो; पर अपनी यो स्वतंत्रता को उपयोग बुरी बातों ख झाकन को लायी मत करो पर परमेश्वर को सेवकों को जसो जीवो। <verse eid="1PE 2:16"/><verse number="17" style="v" sid="1PE 2:17"/>सब को आदर करो, अपनो दूसरों विश्वासी भाऊवों सी प्रेम रखो, परमेश्वर को आदर को संग डर मानो, राजा को सम्मान करो।<verse eid="1PE 2:17"/></para>
  <para style="s">मसीह हमरो आदर्श</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18"/>हे सेवकों, अपनो आप ख अपनो मालिकों को अधीन रखो अऊर उन्ख पूरो रीति सी आदर देवो, नहीं केवल उन्को जो अच्छो अऊर दूसरों को लायी चिन्ता करय हय बल्की उन ख भी जो कठोर हय। <verse eid="1PE 2:18"/><verse number="19" style="v" sid="1PE 2:19"/>कहालीकि यदि कोयी परमेश्वर को बिचार कर क् अन्याय सी दु:ख उठातो हुयो कठिनायी सहय हय त यो अच्छो हय। <verse eid="1PE 2:19"/><verse number="20" style="v" sid="1PE 2:20"/>कहालीकि यदि तुम न अपराध कर क् घूसा खायो अऊर धीरज धरयो, त येको म का बड़ायी की बात हय? पर यदि अच्छो काम कर क् दु:ख उठावय हय अऊर धीरज धरय हय, त यो परमेश्वर ख अच्छो भावय हय। <verse eid="1PE 2:20"/><verse number="21" style="v" sid="1PE 2:21"/>पर तुम्ख परमेश्वर न येकोच लायी बुलायो हय, की मसीह न दु:ख उठायो हय, असो कर क् हमरो लायी एक उदाहरन छोड़्यो हय ताकी हम ओको पद चिन्हों पर चले। <verse eid="1PE 2:21"/><verse number="22" style="v" sid="1PE 2:22"/>ओन कोयी पाप नहीं करयो अऊर कोयी न ओको मुंह सी झूठी बात नहीं सुनी। <verse eid="1PE 2:22"/><verse number="23" style="v" sid="1PE 2:23"/>जब ऊ अपमानित भयो तब ओन कोयी को अपमान कर क् प्रतिउत्तर नहीं दियो। जब ओन दु:ख झेल्यो, ओन कोयी ख धमकी नहीं दी बल्की ऊ सच्चो न्याय करन वालो परमेश्वर म अपनी आशावों ख रख्यो। <verse eid="1PE 2:23"/><verse number="24" style="v" sid="1PE 2:24"/>मसीह न खुदच हमरो पापों ख अपनो शरीर पर क्रूस पर ओढ़ लियो ताकी हम अपनो पापों को प्रती हमरी मृत्यु होय जाये अऊर सच्चायी को लायी जीये। यो ओको उन घावों को कारणच भयो जिन्कोसी तुम चंगो करयो गयो हय। <verse eid="1PE 2:24"/><verse number="25" style="v" sid="1PE 2:25"/>तुम मेंढा को जसो होतो जो अपनो रस्ता भटक गयो होतो पर अब खुद फिर सी वापस अपनो चरवाहा अऊर तुम्हरो आत्मावों को रख वालो को जवर लायो गयो हय।<verse eid="1PE 2:25"/></para>
  <chapter eid="1PE 2"/>
  <chapter number="3" style="c" sid="1PE 3"/>
  <para style="s">पति अऊर पत्नी</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">इफिसियों ५:२२</ref>; <ref loc="COL 3:18">कुलुस्सियों ३:१८</ref></char>
    </note>योच रीति सी हे पत्नियों, अपनो आप ख अपनो पति को अधीन रहो, ताकी यदि कोयी परमेश्वर को वचन पर विश्वास नहीं करे त वा अपनो व्यवहार सी विश्वास करन को लायी जीतो जाये। येकोलायी तुम्ख ओको सी कोयी बात करन की भी जरूरत नहाय, <verse eid="1PE 3:1"/><verse number="2" style="v" sid="1PE 3:2"/>कहालीकि हि देखेंन की तुम्हरो व्यवहार कसो शुद्ध अऊर भक्तिपूर्ण हय। <verse eid="1PE 3:2"/><verse number="3" style="v" sid="1PE 3:3"/><note caller="+" style="x"><char style="xo" closed="false">३:३ </char><char style="xt" closed="false"><ref loc="1TI 2:9">१ तीमुथियुस २:९</ref></char></note>अपनो आप ख सुन्दर करन लायी बाहरी साज सिंगार को इस्तेमाल मत करे, जसो की बाल गूथन, यां फिर सोनो को जेवर पहिनन, यां तरह-तरह को कपड़ा पहिनन, <verse eid="1PE 3:3"/><verse number="4" style="v" sid="1PE 3:4"/>बल्की तुम्हरी सुन्दरता तुम्हरो मन व्यक्तित्व बनावय हय, कोमल यां शान्त आत्मा को अविनाशी सजावट सी सुसज्जित रहो, परमेश्वर की नजर म मूल्यवान हय। <verse eid="1PE 3:4"/><verse number="5" style="v" sid="1PE 3:5"/>पहिले को काल म पवित्र बाईयां भी, जो परमेश्वर पर आशा रखत होती, अपनो आप ख योच रीति सी संवारती अऊर अपनो-अपनो पति को अधीन रहत होती। <verse eid="1PE 3:5"/><verse number="6" style="v" sid="1PE 3:6"/>जसी सारा अपनो पति अब्राहम की आज्ञा मानत होती, अऊर ओख मोरो मालिक कहत होती। योच तरह तुम भी यदि भलायी करो अऊर कोयी तरह को डर सी भयभित मत हो, त सारा की बेटियां ठहरो।<verse eid="1PE 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:७ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:25">इफिसियों ५:२५</ref>; <ref loc="COL 3:19">कुलुस्सियों ३:१९</ref></char>
    </note>वसोच हे पतियों, तुम भी समझदारी सी पत्नियों को संग जीवन बितावो, अऊर बाई ख कमजोर जान क ओको आदर करो, यो समझ क कि हम दोयी परमेश्वर को जीवन को वरदान म उन्ख अपनो सह उत्तराधिकारी मानो, ताकी तुम्हरी प्रार्थनावों म रुकावट मत पड़े।<verse eid="1PE 3:7"/></para>
  <para style="s">भलायी करन को वजह सताव</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8"/>आखरी म तुम सब को सब एक मन अऊर कृपामय सहानुभूति, भाऊवों सी प्रेम रखन वालो, अऊर दयालुता सी, अऊर एक दूसरों सी नम्र बनो। <verse eid="1PE 3:8"/><verse number="9" style="v" sid="1PE 3:9"/>बुरायी को बदला बुरायी मत करो अऊर नहीं श्राप को बदला श्राप देवो; बल्की प्रतिउत्तर आशीष देवो, कहालीकि आशीष हय जो परमेश्वर न तुम ख देन को वचन दियो होतो जब तुम्ख बुलायो होतो। <verse eid="1PE 3:9"/><verse number="10" style="v" sid="1PE 3:10"/>जसो शास्त्र म लिख्यो हय,</para>
  <para style="q1" vid="1PE 3:10">“यदि तुम्ख अपनो जीवन की खुशी लेनो हय,</para>
  <para style="q2" vid="1PE 3:10">अऊर अच्छो समय की इच्छा रखय हय त,</para>
  <para style="q2" vid="1PE 3:10">अऊर ओख चाहिये की बुरी बात बोलन सी रोके</para>
  <para style="q2" vid="1PE 3:10">अऊर झूठ बोलनो बन्द करे।<verse eid="1PE 3:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11"/>ऊ बुरायी को संग छोड़े, अऊर भलायीच करे;</para>
  <para style="q2" vid="1PE 3:11">ऊ पूरो दिल सी शान्ति पावन लायी कोशिश करे।<verse eid="1PE 3:11"/></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12"/>कहालीकि प्रभु की आंखी न्यायियों पर लगी रह्य हंय,</para>
  <para style="q2" vid="1PE 3:12">अऊर ओको कान ओकी प्रार्थना को तरफ लगी रह्य हंय;</para>
  <para style="q2" vid="1PE 3:12">पर प्रभु बुरायी करन वालो को विरुद्ध मुंह फेर लेवय हय।”<verse eid="1PE 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13"/>यदि तुम भलायी करन को लायी तैयार रहो त तुम्हरी बुरायी करन वालो फिर कौन हय? <verse eid="1PE 3:13"/><verse number="14" style="v" sid="1PE 3:14"/><note caller="+" style="x"><char style="xo" closed="false">३:१४ </char><char style="xt" closed="false"><ref loc="MAT 5:10">मत्ती ५:१०</ref></char></note>यदि तुम सच्चायी को वजह दु:ख भी उठावय हय, त धन्य हो; पर लोगों को डरानो सी मत डरो, अऊर घबरावो मत, <verse eid="1PE 3:14"/><verse number="15" style="v" sid="1PE 3:15"/>पर अपनो मन म मसीह को लायी आदर रखो, अऊर ओख प्रभु जान क आदर देवो। अऊर यदि कोयी तुम्ख अपनी आशा को बारे म जो तुम म हय समझावन ख कहेंन त ओख उत्तर देन लायी हमेशा तैयार रहो, <verse eid="1PE 3:15"/><verse number="16" style="v" sid="1PE 3:16"/>पर हि विनम्रता अऊर आदर को संगच करो अऊर अपनो विवेक ख शुद्ध रखो, ताकी यीशु मसीह म तुम्हरो आचरन की निन्दा करन वालो लोग तुम्हरो अपमान करतो हुयो शर्मायेंन। <verse eid="1PE 3:16"/><verse number="17" style="v" sid="1PE 3:17"/>कहालीकि यदि परमेश्वर की याच इच्छा हो कि तुम भलायी करन को वजह दु:ख उठावों, त यो बुरायी करन को बदला दु:ख उठानो सी बहुत अच्छो हय। <verse eid="1PE 3:17"/><verse number="18" style="v" sid="1PE 3:18"/>येकोलायी मसीह भी पूरो पापों लायी एकच बार मरयो, मतलब ऊ जो सच्चो होतो ऊ पापियों को लायी मारयो गयो कि हम्ख परमेश्वर को जवर ले जाये। शरीर को भाव सी त ऊ मारयो गयो पर आत्मा को भाव सी जीन्दो करयो गयो। <verse eid="1PE 3:18"/><verse number="19" style="v" sid="1PE 3:19"/>अऊर ओकी आत्मा की स्थिति म जाय क बन्दी आत्मावों ख सन्देश दियो, <verse eid="1PE 3:19"/><verse number="20" style="v" sid="1PE 3:20"/>या वा आत्मायें आय जो ऊ समय म परमेश्वर की आज्ञा नहीं मानन वाली होती, जब नूह को जहाज बनायो जाय रह्यो होतो अऊर परमेश्वर धीरज को संग इन्तजार कर रह्यो होतो ऊ जहाज म थोड़ो लोग यानेकि आठ प्रानी पानी सी बचायो गयो। <verse eid="1PE 3:20"/><verse number="21" style="v" sid="1PE 3:21"/>यो ऊ बपतिस्मा को जसो हय जेकोसी अब तुम्हरो उद्धार होवय हय, येको म शरीर को मईल धोवनो नहीं बल्की एक अच्छो विवेक को लायी परमेश्वर सी वाचा हय। अब त तुम्ख यीशु मसीह को पुनरुत्थान को द्वारा बचावय हय। <verse eid="1PE 3:21"/><verse number="22" style="v" sid="1PE 3:22"/>ऊ स्वर्ग पर जाय क परमेश्वर को दायो तरफ बैठ गयो; अऊर स्वर्गदूत अऊर अधिकारी अऊर सामर्थ को काम ओको अधीन करयो गयो हंय।<verse eid="1PE 3:22"/></para>
  <chapter eid="1PE 3"/>
  <chapter number="4" style="c" sid="1PE 4"/>
  <para style="s">परिवर्तित जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1"/>येकोलायी जब कि मसीह न शरीर म होय क दु:ख उठायो त तुम भी उच मनसा ख अवजार को जसो धारन करो, कहालीकि जेन शरीर म दु:ख उठायो ऊ पाप सी छूट गयो, <verse eid="1PE 4:1"/><verse number="2" style="v" sid="1PE 4:2"/>अब सी आगु, तुम्हरो धरती पर को जीवन मानविय इच्छावों को अनुसार नहीं बल्की परमेश्वर की इच्छा को अनुसार जीवन जीये। <verse eid="1PE 4:2"/><verse number="3" style="v" sid="1PE 4:3"/>कहालीकि गैरयहूदी जो बाते हि करनो पसंद करत होतो ऊ बात की इच्छा को अनुसार, अऊर असभ्यता, वासना, पियक्कड़पन, लीलाक्रिडा, रंगरैली अऊर घृणित मूर्तिपूजा म जित तक हम न पहिले समय गवायो, उच बहुत भयो। <verse eid="1PE 4:3"/><verse number="4" style="v" sid="1PE 4:4"/>येको सी हि अचम्भा करय हंय कि तुम असो भारी घृणित, अऊर लापरवाही को जीवन जीन म शामिल नहीं होवय; येकोलायी हि तुम्हरी निन्दा करय हय। <verse eid="1PE 4:4"/><verse number="5" style="v" sid="1PE 4:5"/>पर जो मरयो हुयो अऊर जीन्दो को न्याय करन को लायी तैयार हय ऊ परमेश्वर ख ऊ खुद अपनो व्यवहार को लेखा-जोखा देयेंन। <verse eid="1PE 4:5"/><verse number="6" style="v" sid="1PE 4:6"/>येकोलायी उन विश्वासी ख जो मर चुक्यो हय सुसमाचार सुनायो होतो कि शारीरिक रूप सी चाहे उन्को मानविय स्तर पर न्याय हो, पर आत्मिक रूप सी परमेश्वर को अनुसार जीन्दो रहे।<note caller="+" style="f"><char style="fr" closed="false">४:६ </char><char style="ft" closed="false">१ पतरस ३:१८-२०</char></note><verse eid="1PE 4:6"/></para>
  <para style="s">परमेश्वर को उपहार को अच्छो देखरेख करन वालो</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7"/>सब बातों को अन्त तुरतच होन वालो हय; येकोलायी संय्यमी होय क प्रार्थना को लायी सचेत रहो। <verse eid="1PE 4:7"/><verse number="8" style="v" sid="1PE 4:8"/>सब म बड़ी बात या हय कि एक दूसरों सी घनिष्ट प्रेम रखो, कहालीकि प्रेम कुछ पापों ख झाक देवय हय। <verse eid="1PE 4:8"/><verse number="9" style="v" sid="1PE 4:9"/>बिना कुड़कुड़ाये एक दूसरों अतिथियों को स्वागत करो। <verse eid="1PE 4:9"/><verse number="10" style="v" sid="1PE 4:10"/>जेक जो वरदान मिल्यो हय, ऊ ओख परमेश्वर को अलग अलग तरह को दान को भलो व्यवस्थापक को जसो एक दूसरों की सेवा म लगाये। <verse eid="1PE 4:10"/><verse number="11" style="v" sid="1PE 4:11"/>जो कोयी प्रचार करे; जो कोयी सेवा करे, त ऊ वा शक्ति सी करे जो परमेश्वर देवय हय; येकोलायी सब बातों म यीशु मसीह को द्वारा, परमेश्वर ख प्रशंसा मिले। महिमा अऊर साम्राज्य हमेशा हमेशा ओकोच आय। आमीन।<verse eid="1PE 4:11"/></para>
  <para style="s">मसीह होन को नाते दु:ख उठानो</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12"/>हे प्रिय संगियों, जब तुम्हरी अग्नि परीक्षा होवय हय तब एक विचित्र बाते देख क अचम्भित मत होय। कि कोयी अजीब बात तुम पर बीत रही हय। <verse eid="1PE 4:12"/><verse number="13" style="v" sid="1PE 4:13"/>पर जसो मसीह को दु:खों म शामिल होवय हय, तब खुशी मनावो, जेकोसी ओकी महिमा ख प्रगट होतो समय भी तुम पूरी खुशी सी भर जावो। <verse eid="1PE 4:13"/><verse number="14" style="v" sid="1PE 4:14"/>तब यदि मसीह को नाम को लायी तुम्हरी निन्दा करी जावय हय त तुम धन्य हो, कहालीकि महिमामय परमेश्वर की आत्मा, तुम पर छाया करय हय। <verse eid="1PE 4:14"/><verse number="15" style="v" sid="1PE 4:15"/>तुम म सी कोयी व्यक्ति हत्यारों यां चोर यां कुकर्मी होन को, या दूसरों को काम म हाथ डालन को वजह दु:ख नहीं पाये। <verse eid="1PE 4:15"/><verse number="16" style="v" sid="1PE 4:16"/>पर यदि मसीही होन को वजह दु:ख पाये, त लज्जित मत हो, पर या बात को लायी परमेश्वर ख महिमा देवो कहालीकि तुम न मसीह को नाम धारन करयो।<verse eid="1PE 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17"/>कहालीकि न्याय करन की सुरूवात को समय आय चुक्यो हय कि पहिले परमेश्वर को लोगों को न्याय करयो जायेंन; अऊर जब कि न्याय को सुरूवात हम सीच होयेंन त ओको का अन्त होयेंन जो परमेश्वर को सुसमाचार ख नहीं मानय? <verse eid="1PE 4:17"/><verse number="18" style="v" sid="1PE 4:18"/>असो पवित्र शास्त्र म लिख्यो हय,</para>
  <para style="q1" vid="1PE 4:18">“यदि सच्चो आदमी कठिनायी सी उद्धार पायेंन,</para>
  <para style="q2" vid="1PE 4:18">त भक्तिहीन अऊर पापी को का ठिकाना?”<verse eid="1PE 4:18"/></para>
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19"/>येकोलायी जो परमेश्वर की इच्छा को अनुसार दु:ख उठावय हंय, हि भलायी करतो हुयो अपनो आप ख विश्वास लायक सृजनहार को हाथ म सौंप दे।<verse eid="1PE 4:19"/></para>
  <chapter eid="1PE 4"/>
  <chapter number="5" style="c" sid="1PE 5"/>
  <para style="s">बुजूर्गों अऊर नवयुवकों ख सन्देश</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1"/>तुम म जो बुजूर्ग हंय, मय उन्को जसो बुजूर्ग अऊर मसीह को दु:खों को गवाह अऊर प्रगट होन वाली महिमा म शामिल होय क उन्ख यो समझाऊ हय <verse eid="1PE 5:1"/><verse number="2" style="v" sid="1PE 5:2"/><note caller="+" style="x"><char style="xo" closed="false">५:२ </char><char style="xt" closed="false"><ref loc="JHN 21:15-17">यूहन्ना २१:१५-१७</ref></char></note>कि परमेश्वर को ऊ झुण्ड की, जो तुम्हरो बीच म हय रखवाली करो; अऊर यो दबाव सी नहीं पर परमेश्वर की इच्छा को अनुसार खुशी सी, अऊर पैसाच को लायी नहीं पर मन लगाय क कर। <verse eid="1PE 5:2"/><verse number="3" style="v" sid="1PE 5:3"/>जो लोग देख-रेख को लायी तुम्ख सौंप्यो गयो हंय, उन पर अधिकार मत जतावो, बल्की झुण्ड को लायी एक आदर्श बनो। <verse eid="1PE 5:3"/><verse number="4" style="v" sid="1PE 5:4"/>जब प्रधान रख वालो प्रगट होयेंन, त तुम्ख महिमा को मुकुट दियो जायेंन जेकी शोभा कभी घटय नहाय।<verse eid="1PE 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5"/>योच तरह हे नवयुवकों, तुम भी धर्म बुजूर्गों को अधीन रहो, तुम एक दूसरों की सेवा करन को लायी विनम्रता धारन करो कहालीकि शास्त्र कह्य हय। “परमेश्वर अभिमानियों को विरोध करय हय, पर दिनो पर अनुग्रह करय हय।”<note caller="+" style="f"><char style="fr" closed="false">५:५ </char><char style="ft" closed="false">नीतिवचन ३:३४</char></note> <verse eid="1PE 5:5"/><verse number="6" style="v" sid="1PE 5:6"/><note caller="+" style="x"><char style="xo" closed="false">५:६ </char><char style="xt" closed="false"><ref loc="MAT 23:12">मत्ती २३:१२</ref>; <ref loc="LUK 14:11">लूका १४:११</ref>; <ref loc="LUK 18:14">१८:१४</ref></char></note>येकोलायी परमेश्वर को शक्तिशाली हाथ को खल्लो दीनता सी रहो, जेकोसी ऊ तुम्ख ठीक समय पर बढ़ायेंन। <verse eid="1PE 5:6"/><verse number="7" style="v" sid="1PE 5:7"/>अपनी पूरी चिन्ता ओकोच पर डाल देवो, कहालीकि ओख तुम्हरो ध्यान हय।<verse eid="1PE 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8"/>सचेत रहो, अऊर जागतो रहो; कहालीकि तुम्हरो दुस्मन शैतान, एक गर्जन वालो सिंह को जसो इत-उत घुमतो हुयो यो ताक म रह्य हय कि कोख फाड़ खाये। <verse eid="1PE 5:8"/><verse number="9" style="v" sid="1PE 5:9"/>विश्वास म मजबूत होय क, अऊर यो जान क ओको सामना करो कि तुम्हरो भाऊ जो जगत म हंय असोच दु:ख सह रह्यो हंय। <verse eid="1PE 5:9"/><verse number="10" style="v" sid="1PE 5:10"/>अब परमेश्वर जो पूरो अनुग्रह को दाता हय, जेन तुम्ख यीशु मसीह म अपनी अनन्त महिमा को लायी बुलायो, तुम्हरो थोड़ो देर तक दु:ख उठावन को बाद खुदच तुम्ख सिद्ध अऊर स्थिर अऊर बलवन्त करेंन। <verse eid="1PE 5:10"/><verse number="11" style="v" sid="1PE 5:11"/>ओकोच साम्राज्य हमेशा हमेशा रहे। आमीन।<verse eid="1PE 5:11"/></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">५:१२ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 15:22">प्रेरितों १५:२२</ref>,<ref loc="ACT 15:40">४०</ref></char>
    </note>मय न तुम्ख एक संक्षिप्त चिट्ठी सिलवानुस को मदत सी लिख्यो, जेक मय विश्वास लायक मसीह भाऊ मानु हय। मय तुम ख प्रोत्साहित करनो चाहऊं हय अऊर अपनी गवाही देऊ हय जो परमेश्वर को सच्चो अनुग्रह हय। येकोच म स्थिर रहो।<verse eid="1PE 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">५:१३ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 12:12">प्रेरितों १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref>; <ref loc="COL 4:10">कुलुस्सियों ४:१०</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref></char>
    </note>बेबीलोन नगर की मण्डली जो तुम्हरो जसो दुबारा चुन्यो गयो हय, हि तुम्ख नमस्कार करय हय अऊर मसीह म मोरो बेटा मरकुस तुम्ख नमस्कार करय हंय।<verse eid="1PE 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 5:14"/>एक दूसरों ख प्रेम सी गलो लगाय क नमस्कार करो। जो सब मसीह म हय शान्ति मिले।<verse eid="1PE 5:14"/></para>
  <chapter eid="1PE 5"/>
</usx>
