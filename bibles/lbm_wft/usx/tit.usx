<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="TIT" style="id">- Lodhi</book>
  <para style="h">तीतुस</para>
  <para style="toc3">तीतुस</para>
  <para style="toc2">तीतुस</para>
  <para style="toc1">तीतुस को नाम पौलुस प्रेरित की चिट्ठी</para>
  <para style="mt2">तीतुस के नाम पौलुस प्रेरित की पत्री</para>
  <para style="mt1">तीतुस को नाम पौलुस प्रेरित की चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">तीतुस की किताब पौलुस कि चार चिट्ठी म सी एक आय जेक मण्डली को बजाय कोयी आदमी ख सम्बोधित करयो जात होतो। दूसरी तीन चिट्ठी १ तीमुथियुस, २ तीमुथियुस अऊर फिलेमोन आय। पौलुस तीतुस ख लिख रह्यो होतो, पर ओन यो भी लिख्यो कि चिट्ठी सार्वजनिक रूप सी बड़ो रीति सी पढ़्यो जाय सकय हय। हम येख जान सकजे हय कहालीकि ऊ एक प्रेरित को रूप म अपनी योग्यता बतावय हय, जो कि तीतुस पहिले सीच जानत होतो। पौलुस न शायद मसीह को जनम को बाद ६३-६५ साल को बीच या चिट्ठी ख लिख्यो होतो।</para>
  <para style="ip">पौलुस न तीतुस ख क्रेते द्वीप पर मौजूद मण्डली को नेतृत्व करन को निर्देश दियो होतो। पौलुस न अगुवा ख मण्डली को मुखिया को चुनन अऊर प्रशिक्षण पर निर्देश देन लायी या चिट्ठी ख लिख्यो होतो। ओन तीमुथियुस ख अपनी चिट्ठियों म सब ख एक जसो निर्देश दियो। ओकी चिट्ठी म वर्नन करयो गयो हय कि कसो मण्डली को अगुवा ख उंचो पद वालो मान क आयोजित करयो जानो चाहिये। मण्डली को अगुवा ख अज नेतृत्व म जरूरी स्तर पर सावधानी सी ध्यान देनो चाहिये।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पौलुस न मसीही अगुवा की नियुक्त करन लायी तीतुस ख निर्देश दियो। <char style="ior"><ref loc="TIT 1:1-16">१:१-१६</ref></char></para>
  <para style="io1">२. फिर ऊ लोगों ख मसीही जीवन जीन लायी तैयार करन लायी भी निर्देश देवय हय। <char style="ior"><ref loc="TIT 2:1-3:11">२:१–३:११</ref></char></para>
  <para style="io1">३. आखिरकार, पौलुस अपनी कुछ योजनावों ख साझा कर क् अऊर बधायी भेज क चिट्ठी लिखनो बन्द करय हय। <char style="ior"><ref loc="TIT 3:12-15">३:१२-१५</ref></char></para>
  <chapter number="1" style="c" sid="TIT 1"/>
  <para style="p">
    <verse number="1" style="v" sid="TIT 1:1"/>पौलुस को तरफ सी जो परमेश्वर को सेवक अऊर यीशु मसीह को प्रेरित हय।</para>
  <para style="p" vid="TIT 1:1">परमेश्वर को चुन्यो हुयो लोगों ख उन्को विश्वास म मदत करन लायी अऊर हमरो धर्म को सच्चो ज्ञान को तरफ बड़ावन लायी भेज्यो गयो हय। <verse eid="TIT 1:1"/><verse number="2" style="v" sid="TIT 1:2"/>ऊ अनन्त जीवन की आशा पर जेकी प्रतिज्ञा परमेश्वर न, जो झूठ बोल नहीं सकय सनातन काल सी करी हय, <verse eid="TIT 1:2"/><verse number="3" style="v" sid="TIT 1:3"/>पर ठीक समय पर अपनो वचन ख ऊ प्रचार सी प्रगट करयो, जो हमरो उद्धारकर्ता परमेश्वर की आज्ञा को अनुसार मोख सौंप्यो गयो अऊर प्रचार करयो गयो हय।<verse eid="TIT 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="TIT 1:4"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१:४ </char>
      <char style="xt" closed="false">
        <ref loc="2CO 8:23">२ कुरिन्थियों ८:२३</ref>; <ref loc="GAL 2:3">गलातियों २:३</ref>; <ref loc="2TI 4:10">२ तीमुथियुस ४:१०</ref></char>
    </note>तीतुस को नाम, जो विश्वास को सहभागिता को बिचार सी मोरो सच्चो बेटा आय!</para>
  <para style="p" vid="TIT 1:4">परमेश्वर पिता अऊर हमरो उद्धारकर्ता मसीह यीशु को तरफ सी तोख अनुग्रह अऊर शान्ति मिलती रहे।<verse eid="TIT 1:4"/></para>
  <para style="s">क्रेते म तीतुस को कार्य</para>
  <para style="p">
    <verse number="5" style="v" sid="TIT 1:5"/>मय येकोलायी तोख क्रेते म छोड़ आयो होतो कि तय बची बातों ख सुधारे, अऊर मोरी आज्ञा को अनुसार नगर नगर को मण्डलियों को बुजूर्गों ख चुने। <verse eid="TIT 1:5"/><verse number="6" style="v" sid="TIT 1:6"/><note caller="+" style="x"><char style="xo" closed="false">१:६ </char><char style="xt" closed="false"><ref loc="1TI 3:2-7">१ तीमुथियुस ३:२-७</ref></char></note>जो निर्दोष अऊर एकच पत्नी को पति हो, जिन को बच्चा विश्वासी हो, अऊर अनुशासन हिनता को दोष उन पर नहीं लगायो जाय सके तथा ऊ कानुन को पालन करन वालो भी नहीं हो। <verse eid="TIT 1:6"/><verse number="7" style="v" sid="TIT 1:7"/>कहालीकि मुखिया ख परमेश्वर को काम को व्यवस्थापक होन को वजह ऊ निर्दोष होन ख होना; ओख हटिलो नहीं, जल्दी गुस्सा करन वालो नहीं, पियक्कड़ नहीं, मार पीट करन वालो नहीं, अऊर नहीं पैसा को लालची हो, <verse eid="TIT 1:7"/><verse number="8" style="v" sid="TIT 1:8"/>पर मेहमान को आदर करन वालो, भलायी को चाहन वालो, संय्यमी, सच्चो, पवित्र अऊर सभ्यतासिल होनो चाहिये; <verse eid="TIT 1:8"/><verse number="9" style="v" sid="TIT 1:9"/>ओख ऊ विश्वास करन लायक अऊर सिद्धता पर सहमत होन वालो सन्देश ख मजबुतायी सी पकड़ ख रहनो चाहिये यो तरह लोगों ख सच्चायी की शिक्षा दे क उन्ख प्रोत्साहित करे अऊर येको संग जो येको विरोधी आय ओको खण्डन कर सके।<verse eid="TIT 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="TIT 1:10"/>कहालीकि बहुत सो लोग नियम ख तोड़न वालो, बकवास करन वालो अऊर धोका देन वालो आय; विशेष कर यहूदी म सी आयो हय। <verse eid="TIT 1:10"/><verse number="11" style="v" sid="TIT 1:11"/>यो जरूरी हय कि इन्को मुंह बन्द करनो चाहिये। कहालीकि हि लोग बुरो उपदेश की कमायी लायी बेकार बाते सिखाय क घर को घर बिगाड़ देवय हंय। <verse eid="TIT 1:11"/><verse number="12" style="v" sid="TIT 1:12"/>उन म सी एक क्रेते कोच भविष्यवक्ता न, लोगों को बारे म खुद कह्यो हय जो उन्कोच आय, कह्यो हय, “क्रेती को निवासी हमेशा झूठ बोलय हय, दुष्ट पशु, अऊर आलसी पेटू होवय हंय।” <verse eid="TIT 1:12"/><verse number="13" style="v" sid="TIT 1:13"/>या गवाही सच हय, येकोलायी उन्ख कठोरता सी चेतावनी दियो कर कि हि विश्वास म पक्को होय जाये, <verse eid="TIT 1:13"/><verse number="14" style="v" sid="TIT 1:14"/>अऊर यहूदियों की कथा कहानियों अऊर उन आदमियों की आज्ञावों पर मन नहीं लगाये, जो सच ख इन्कार करय हय। <verse eid="TIT 1:14"/><verse number="15" style="v" sid="TIT 1:15"/>शुद्ध लोगों लायी सब चिजे शुद्ध हंय, पर अशुद्ध अऊर अविश्वासियों को लायी कुछ भी शुद्ध नहाय, बल्की उनकी बुद्धी अऊर विवेक दोयी अशुद्ध हंय। <verse eid="TIT 1:15"/><verse number="16" style="v" sid="TIT 1:16"/>हि कह्य हंय कि हम परमेश्वर ख जानजे हंय, पर अपनो कामों सी ओको इन्कार करजे हंय; कहालीकि हि घृणित अऊर आज्ञा नहीं मानन वालो हंय, अऊर कोयी अच्छो काम को लायक नहाय।<verse eid="TIT 1:16"/></para>
  <chapter eid="TIT 1"/>
  <chapter number="2" style="c" sid="TIT 2"/>
  <para style="s">आचरन को लायी सही शिक्षा</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 2:1"/>पर तय असी बाते सिखायो कर जो सच्चो सिद्धान्त को लायक हंय। <verse eid="TIT 2:1"/><verse number="2" style="v" sid="TIT 2:2"/>यानेकि बुजूर्ग आदमी सालिन, सचेत अऊर स्वंय नियंत्रित हो; अऊर उन्को विश्वास म मजबूत, प्रेम अऊर धैर्यपूर्वक सहनशील हो। <verse eid="TIT 2:2"/><verse number="3" style="v" sid="TIT 2:3"/>योच तरह बूढ्ढी बाईयां को चाल चलन पवित्र लोगों को जसो हो; वा निन्दक नहीं बने, दारू को व्यसन कि लत उन्ख नहीं हो, पर अच्छी बाते सिखावन वाली होना <verse eid="TIT 2:3"/><verse number="4" style="v" sid="TIT 2:4"/>ताकि हि जवान बाईयों ख चेतावनी देती रहेंन कि अपनो पतियों ख अऊर बच्चा सी प्रेम रखे; <verse eid="TIT 2:4"/><verse number="5" style="v" sid="TIT 2:5"/>अऊर खुद नियंत्रित, पवित्र, अपनो घर की देखरेख, दयालु अऊर अपनो पति को अधीन रहन वाली बने, ताकि कोयी भी परमेश्वर को तरफ सी आवन वाली वचन की निन्दा नहीं करे।<verse eid="TIT 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="TIT 2:6"/>असोच जवान आदमियों ख भी समझायो कर कि खुद नियंत्रित हो। <verse eid="TIT 2:6"/><verse number="7" style="v" sid="TIT 2:7"/>सब बातों म अपनो आप ख सच्चो आचरन को उदाहरन बन। तोरो शिक्षा म सफाई, गम्भीरता, <verse eid="TIT 2:7"/><verse number="8" style="v" sid="TIT 2:8"/>अऊर असी सच्चायी पायो जाये कि कोयी ओकी आलोचना नहीं कर सकेंन, तोरो दुश्मन शर्मिन्दा हो कहालीकि तोरो विरोध म बुरो कहन ख कुछ नहीं रहेंन।<verse eid="TIT 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="TIT 2:9"/>सेवकों ख सिखावो कि अपनो मालिक को अधीन रहे, अऊर सब बातों म उन्ख खुश रखेंन। अऊर उलट क उन्ख जवाब नहीं दे; <verse eid="TIT 2:9"/><verse number="10" style="v" sid="TIT 2:10"/>चोरी चालाकी नहीं करे, पर सब तरह सी पूरो विश्वासी निकले कि हि सब बातों म हमरो उद्धारकर्ता परमेश्वर कि शिक्षा की हर तरह की शोभा बढ़ाये।<verse eid="TIT 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="TIT 2:11"/>कहालीकि परमेश्वर को ऊ अनुग्रह प्रगट हय, जो सब आदमियों को उद्धार को वजह हय, <verse eid="TIT 2:11"/><verse number="12" style="v" sid="TIT 2:12"/>अऊर ऊ अनुग्रह हम्ख सिखावय हय कि हम अभक्ति अऊर सांसारिक अभिलाषावों ख त्याग दे अऊर खुद ख नियंत्रित, उचित अऊर भक्तिमय जीवन यो जगत म जीये। <verse eid="TIT 2:12"/><verse number="13" style="v" sid="TIT 2:13"/>अऊर ऊ धन्य आशा की मतलब अपनो महान परमेश्वर अऊर उद्धारकर्ता यीशु मसीह की महिमा को प्रगट होन की बाट देखतो रहे। <verse eid="TIT 2:13"/><verse number="14" style="v" sid="TIT 2:14"/><note caller="+" style="x"><char style="xo" closed="false">२:१४ </char><char style="xt" closed="false"><ref loc="1PE 2:9">१ पतरस २:९</ref></char></note>जेन अपनो आप ख हमरो लायी दे दियो कि हम्ख हर तरह को बुरायीयों सी छुड़ाये, अऊर हम्ख ओकोच शुद्ध लोग बनाये अऊर हम अच्छो-अच्छो कामों सी तत्पर रहे।<verse eid="TIT 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 2:15"/>पूरो अधिकार को संग या बाते सिखाव, जसो तय तोरो विरोधियों ख डाटय अऊर प्रोत्साहित करय हय कि कोयी तोख बेकार समझनो नहीं पाये।<verse eid="TIT 2:15"/></para>
  <chapter eid="TIT 2"/>
  <chapter number="3" style="c" sid="TIT 3"/>
  <para style="s">मसीही चाल-चलन</para>
  <para style="p">
    <verse number="1" style="v" sid="TIT 3:1"/>लोगों ख याद दिलाव कि हि शासकों अऊर अधिकारियों को अधीन रहे, अऊर उन्की आज्ञा को पालन करे, अऊर हर एक अच्छो काम लायी तैयार रहे, <verse eid="TIT 3:1"/><verse number="2" style="v" sid="TIT 3:2"/>उन्ख बताव कोयी की निन्दा मत करो, पर शान्तता सी अऊर दोस्ती सी रहो; अऊर सब को संग हमेशा नरम स्वभाव रखे। <verse eid="TIT 3:2"/><verse number="3" style="v" sid="TIT 3:3"/>कहालीकि हम भी पहिले नासमझ, अऊर आज्ञा नहीं मानन वालो, अऊर गलत होतो। अऊर कुछ तरह की इच्छावों अऊर सुखविलास को चाहत म होतो, अऊर बैरभाव, अऊर जलन करन म जीवन बितावत होतो, अऊर घृना रखत होतो, अऊर एक दूसरों सी दुश्मनी रखत होतो। <verse eid="TIT 3:3"/><verse number="4" style="v" sid="TIT 3:4"/>पर जब हमरो उद्धारकर्ता परमेश्वर की भलायी अऊर प्रेम प्रगट भयो, <verse eid="TIT 3:4"/><verse number="5" style="v" sid="TIT 3:5"/>त ओन हमरो उद्धार करयो; अऊर यो अच्छो कर्मों को वजह सी नहीं, जो हम न खुद करयो, पर ओकी दया सी हम्ख बचायो पवित्र आत्मा को द्वारा, जो हम्ख नयो जनम देवय हय अऊर धोय क हम्ख नयो जीवन देवय हय। <verse eid="TIT 3:5"/><verse number="6" style="v" sid="TIT 3:6"/>परमेश्वर न हम पर पवित्र आत्मा ख उद्धारकर्ता यीशु मसीह को द्वारा भरपूरी सी दियो हय। <verse eid="TIT 3:6"/><verse number="7" style="v" sid="TIT 3:7"/>अपनो अनुग्रह को द्वारा ओको संग सच्चो ठहरायो हय, ताकी हम अनन्त जीवन की आशा ख उत्तराधिकार ख पा सके।<verse eid="TIT 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="TIT 3:8"/>यो सच कह्यो गयो हय, अऊर मय चाहऊ हय कि तय इन बातों को बारे म हिम्मत सी बोले येकोलायी कि जिन्न परमेश्वर पर विश्वास करयो हय, हि अच्छो-अच्छो कामों म लग्यो रहन को ध्यान रखे। या बाते अच्छी अऊर आदमियों को फायदा की हंय। <verse eid="TIT 3:8"/><verse number="9" style="v" sid="TIT 3:9"/>पर मूर्खता को विवादों, अऊर वंशावलियों, अऊर विरोध अऊर झगड़ा सी जो व्यवस्था को बारे म हो, बच्यो रहे; कहालीकि हि निष्फल अऊर बेकार हय। <verse eid="TIT 3:9"/><verse number="10" style="v" sid="TIT 3:10"/>जो फूट डालय हय ओख कम सी कम दोय बार चेतावनी दे, अऊर फिर ओख अकेलो छोड़ दे। <verse eid="TIT 3:10"/><verse number="11" style="v" sid="TIT 3:11"/>कहालीकि तुम जानय हय कि असो लोग पापी भय गयो हय अऊर उन्को जवर ऊ गलत होन को प्रमान देवय हय।<verse eid="TIT 3:11"/></para>
  <para style="s">आखरी निर्देश</para>
  <para style="p">
    <verse number="12" style="v" sid="TIT 3:12"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१२ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">प्रेरितों २०:४</ref>; <ref loc="EPH 6:21">इफिसियों ६:२१</ref>,<ref loc="EPH 6:22">२२</ref>; <ref loc="COL 4:7">कुलुस्सियों ४:७</ref>,<ref loc="COL 4:8">८</ref>; <ref loc="2TI 4:12">२ तीमुथियुस ४:१२</ref></char>
    </note>जब मय तोरो जवर अरतिमास यां तुखिकुस ख भेजूं त मोरो जवर निकुपुलिस नगर म आवन की कोशिश करजो, कहालीकि मय न उच ठंडी को समय बितावन को परख लियो हय। <verse eid="TIT 3:12"/><verse number="13" style="v" sid="TIT 3:13"/><note caller="+" style="x"><char style="xo" closed="false">३:१३ </char><char style="xt" closed="false"><ref loc="ACT 18:24">प्रेरितों १८:२४</ref>; <ref loc="1CO 16:12">१ कुरिन्थियों १६:१२</ref></char></note>जेनास वकील अऊर अपुल्लोस ख कोशिश कर क् आगु पहुंचाय दे, अऊर देख कि उन्ख कोयी चिज की कमी नहीं होनो पाये। <verse eid="TIT 3:13"/><verse number="14" style="v" sid="TIT 3:14"/>हमरो लोग भी अच्छो काम करनो सिखनो चाहिये ताकि जो जरूरी हय ओकी पूर्ति होय सके अऊर बेकार को जीवन नहीं जीये।<verse eid="TIT 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="TIT 3:15"/>मोरो सब संगियों को तोख नमस्कार।</para>
  <para style="p" vid="TIT 3:15">जो विश्वास को वजह हम सी प्रीति रखय हंय, उन्ख नमस्कार। तुम सब पर अनुग्रह होतो रहेंन।<verse eid="TIT 3:15"/></para>
  <chapter eid="TIT 3"/>
</usx>
