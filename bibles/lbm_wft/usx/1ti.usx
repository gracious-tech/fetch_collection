<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Lodhi</book>
  <para style="h">१ तीमुथियुस</para>
  <para style="toc3">१ तीमुथियुस</para>
  <para style="toc2">१ तीमुथियुस</para>
  <para style="toc1">तीमुथियुस को नाम पौलुस प्रेरित की पहली चिट्ठी</para>
  <para style="mt2">तीमुथियुस के नाम पौलुस प्रेरित की पहली पत्री</para>
  <para style="mt1">तीमुथियुस को नाम पौलुस प्रेरित की पहिली चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">प्रेरित पौलुस को तरफ सी ओको सेवक तीमुथियुस ख लिखी गयी एक चिट्ठी आय। तीमुथियुस शायद मसीह को जनम को बाद ६२-६४ साल को लगभग लिख्यो गयो होतो। यो पौलुस को जीवन को आखरी समय को जवर होतो। पौलुस को तीमुथियुस को संग करिबी रिश्ता होतो अऊर एक टुरा को रूप म ओख कुछ बार भेज्यो गयो होतो। <char style="xt"><ref loc="PHP 2:22">फिलिप्पियों २:२२</ref></char> <char style="xt"><ref loc="1TI 1:2">१ तीमुथियुस १:२</ref>; <ref loc="1TI 1:18">१:१८</ref></char>।</para>
  <para style="ip">यो पौलुस की चार चिट्ठियों म सी एक आय ऊ एक आदमी को बजाय पूरी मण्डली ख सम्बोधित कर रह्यो हय। दूसरी तीन चिट्ठी २ तीमुथियुस, तीतुस अऊर फिलेमोन आय। पहिलो तीमुथियुस न मण्डली की प्रार्थना पर बहुत सारो निर्देश दियो <char style="xt"><ref loc="1TI 2:1-15">२:१-१५</ref>,</char> मण्डली को अगुवा को लायी योग्यता <char style="xt"><ref loc="1TI 3:1-13">३:१-१३</ref>,</char> अऊर झूठो शिक्षकों को खिलाफ चेतावनी <char style="xt"><ref loc="1TI 1:3-11">१:३-११</ref>; <ref loc="1TI 4:1-5">४:१-५</ref>; <ref loc="1TI 6:2-5">६:२-५</ref>।</char> को लायी योग्यता पर आदेश बहुत कुछ शामिल हय। पौलुस यो दर्शावय हय कि तीमुथियुस मण्डली को बीच एक अगुवा बनन लायी आयो होतो। १ तीमुथियुस को कुछ सिद्धान्त हय कि हमरो दिन म मण्डली को अगुवा कि मदद को लायी उत को लोग मण्डली को सेवा कार्य को सम्बन्ध म शामिल हय।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पौलुस को तरफ सी तीमुथियुस ख नमस्कार। <char style="ior"><ref loc="1TI 1:1-2">१:१-२</ref></char></para>
  <para style="io1">२. झूठो शिक्षकों को खिलाफ चेतावनी। <char style="ior"><ref loc="1TI 1:3-11">१:३-११</ref></char></para>
  <para style="io1">३. पौलुस को लायी यीशु मसीह को धन्यवाद। <char style="ior"><ref loc="1TI 1:12-19">१:१२-१९</ref></char></para>
  <para style="io1">४. फिर ऊ प्रार्थना अऊर मण्डली को अगुवा को बारे म तीमुथियुस ख निर्देश। <char style="ior"><ref loc="1TI 2-3">२–३</ref></char></para>
  <para style="io1">५. पौलुस को तीमुथियुस ख कुछ निर्देश दे क अपनी चिट्ठी बन्द करी। <char style="ior"><ref loc="1TI 4-6">४–६</ref></char></para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />हमरो उद्धारकर्ता परमेश्वर अऊर हमरी आशा को आधार मसीह यीशु की आज्ञा सी मसीह यीशु को प्रेरित पौलुस को तरफ सी हय।<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:२ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">प्रेरितों १६:१</ref>
      </char>
    </note>तीमुथियुस को नाम जो विश्वास म मोरो सच्चो बेटा हय: पिता परमेश्वर, अऊर हमरो प्रभु मसीह यीशु को तरफ सी तोख कृपा, दया अऊर शान्ति मिलती रहेंन।<verse eid="1TI 1:2" /></para>
  <para style="s">झूठी शिक्षा देन वालो को विरुद्ध चेतावनी</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />जसो मय न मकिदुनिया ख जातो समय तोख समझायो होतो, कि इफिसुस म रह्य क कुछ लोगों ख बिनती करी कि झूठी शिक्षा मत दे, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />उन्ख तुम असो कहो कि जो उन पुरानी काल्पनिक कहानियों अऊर अनन्त वंशावलियों पर मन नहीं लगाये, जिन्कोसी झगड़ा होवय हंय, अऊर यो परमेश्वर को काम नहीं, यो विश्वास द्वारा हय। <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />आज्ञा को उद्देश यो हय कि प्रेम, शुद्ध मन अऊर अच्छो विवेक, अऊर निष्कपट विश्वास को द्वारा आवय हय। <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />इन ख छोड़ क कितनो लोग फालतु बात को तरफ भटक गयो हंय, <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />अऊर व्यवस्थापक त बननो चाहवय हंय, पर जो बाते कह्य अऊर जिन ख मजबुतायी सी बोलय हंय, उन्ख समझय भी नहाय।<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />पर हम जानजे हंय कि यदि कोयी व्यवस्था ख ठीक रीति सी काम म लाये त ऊ ठीक हय। <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />हम यो भी जानजे हय कि व्यवस्था अच्छो लोग को लायी नहाय पर व्यवस्था तोड़न वालो, विद्रोही, परमेश्वर को अपमान करन वालो, पापियों, अपवित्र अऊर अधार्मिक आदमियों, माय बाप को, हत्या करन वालो। <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />व्यभिचारियों, पुरुषगामियों, गुलामों ख बेचन वालो, झूठ बोलन वालो, अऊर झूठी गवाही देन वालो, अऊर इन्को अलावा सच्चो सिद्धान्त की शिक्षा को सब विरोधियों को लायी ठहरायो गयो हय। <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />यो सुसमाचार महिमामय परमेश्वर जेको जवर पूरी आशीषें हय ओको द्वारा मोख सौंप्यो गयो हय।<verse eid="1TI 1:11" /></para>
  <para style="s">पौलुस पर परमेश्वर को अनुग्रह</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />मय अपनो प्रभु मसीह यीशु को जेन मोख सामर्थ दियो हय, धन्यवाद करू हय कि ओन मोख विश्वास लायक समझ क अपनो सेवा लायी चुन लियो हय। <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" /><note caller="+" style="x"><char style="xo" closed="false">१:१३ </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेरितों ८:३</ref>; <ref loc="ACT 9:4">९:४</ref>,<ref loc="ACT 9:5">५</ref></char></note>मय त फिर भी पहिले निन्दा करन वालो, अऊर सतावन वालो, अऊर हिन्सा करन वालो होतो, तब भी मोरो पर दया भयी, कहालीकि मय न अविश्वास की दशा म बिना समझ्यो यो काम करत होतो। <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />अऊर हमरो प्रभु को अनुग्रह ऊ विश्वास अऊर प्रेम को संग जो मसीह यीशु म हय, बहुतायत सी भयो। <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />या बात सच अऊर हर तरह सी मानन लायक हय मसीह यीशु पापियों को उद्धार करन लायी जगत म आयो, उन म सी सब सी बड़ो पापी मय आय। <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />पर मोरो पर येकोलायी दया भयी कि मय सब सी बड़ो पापी म यीशु मसीह अपनी पूरी सहनशीलता दिखाये, कि जो लोग ओको पर विश्वास करेंन हि अनन्त जीवन लायी मय एक आदर्श बनू। <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />अब अनन्त युग को राजा मतलब अविनाशी, अनदेखे, केवल एक परमेश्वर को आदर अऊर महिमा हमेशा होती रहे। आमीन।<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />हे मोरो बेटा तीमुथियुस, जो तोरो बारे म वचन कि भविष्यवानी करी गयी होती ओको अनुसार, मय आज्ञा देऊ हय कि तय वचन ख अवजार को अनुसार अच्छी लड़ाई लड़तो रहे, <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />अऊर विश्वास अऊर ऊ अच्छो विवेक ख पकड़्यो रख, जेक नकारन को वजह कितनो को विश्वास रूपी जहाज डुब गयो। <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />उनच म सी हुमिनयुस अऊर सिकन्दर हंय, जिन्ख मय न शैतान ख सौंप दियो हय कि ताकी ऊ सिखे कि दूसरों की निन्दा करनो बन्द कर दे।<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">आराधना कि सलाह</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />जब मय सब सी पहिले यो आग्रह करू हय कि बिनती, प्रार्थना, निवेदन, अऊर धन्यवाद सब लोगों को लायी करयो जाये। <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />राजावों अऊर सब ऊचो पद वालो को निमित्त येकोलायी कि हम शान्ति अऊर चैन को संग परमेश्वर ख आदर देतो हुयो अऊर पवित्रता सी जीवन बिताये। <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />यो अच्छो हय अऊर हमरो उद्धारकर्ता परमेश्वर ख स्वीकार लायक हय, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />जो यो चाहवय हय कि सब आदमियों बचायो जाये, अऊर हि सच को ज्ञान ख अच्छो सी जान ले। <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />कहालीकि परमेश्वर एकच हय, अऊर परमेश्वर अऊर आदमियों को बीच म भी एकच मध्यस्थी हय, मतलब मसीह यीशु जो आदमी हय। <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />यीशु न अपनो आप ख सब को छुटकारा को दाम को तौर पर खुद ख बलिदान कर दियो, अऊर येकी गवाही ठीक समय पर दी गयी। <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" /><note caller="+" style="x"><char style="xo" closed="false">२:७ </char><char style="xt" closed="false"><ref loc="2TI 1:11">२ तीमुथियुस १:११</ref></char></note>या गवाही लायी मय सच कहू हय, झूठ नहीं बोलू, कि मय योच उद्देश सी प्रचारक अऊर प्रेरित अऊर गैरयहूदियों लायी विश्वास अऊर सच्चो विश्वास को शिक्षक नियुक्त करयो गयो हय।<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />मण्डली म आराधना को समय मय चाहऊ हय सब लोग हाथ उठाय क प्रार्थना करे हर जागा आदमी बिना गुस्सा अऊर वाद विवाद को पवित्र हाथों ख उठाय क प्रार्थना करतो रहे। <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" /><note caller="+" style="x"><char style="xo" closed="false">२:९ </char><char style="xt" closed="false"><ref loc="1PE 3:3">१ पतरस ३:३</ref></char></note>मय यो भी चाहऊ हय कि बाईयां भी अपनो आप ख सभ्यता अऊर नम्रता को संग, सोभायमान कपड़ा सी अपनो आप ख संवारे; नहीं की बाल गूथनो अऊर सोना अऊर मोतियों अऊर बहुमूल्य कपड़ा सी, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />पर अच्छो कामों सी, कहालीकि परमेश्वर की भक्ति करन वाली बाईयों ख योच ठीक हय। <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />बाई ख शान्तता अऊर पूरी अधीनता सी सीखनो चाहिये। <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />मय अनुमति नहीं देऊ हय कि बाई शिक्षा दे, अऊर नहीं आदमी पर अधिकार जताये, पर चुपचाप रहे। <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />कहालीकि आदम ख पहिले बनायो गयो, ओको बाद हवा ख बनायो गयो; <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />अऊर आदम जो बहकायो गयो होतो, पर बाई बहकाव म आय गयी होती अऊर ओन परमेश्वर को नियम ख तोड़्यो। <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />तब भी बच्चा जनन को द्वारा उद्धार पायेंन, यदि वा सभ्यता को संग विश्वास, प्रेम, अऊर पवित्रता म स्थिर रहे।<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">मण्डली म मुखिया</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />यदि कोयी अपनो मन म तय कर लियो हय कि जो मुखिया बननो चाहवय हय, ऊ अच्छो पद कि इच्छा करय हय। <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" /><note caller="+" style="x"><char style="xo" closed="false">३:२ </char><char style="xt" closed="false"><ref loc="TIT 1:6-9">तीतुस १:६-९</ref></char></note>यो जरूरी हय कि मण्डली को मुखिया निर्दोष, अऊर एकच पत्नी को पति, सभ्य, आत्मसंयमी, आदरनिय, अतिथि-सत्कार करन वालो, अऊर सिखावन म निपुन हो। <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />पिवन वालो यां मार पीट करन वालो मत बनो; बल्की नरम स्वभाव हो, अऊर नहीं झगड़ालू, अऊर नहीं धन को लालची हो। <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />ऊ अपनो घर को अच्छो इन्तजाम करय हय, अऊर अपनो बाल-बच्चा ख असो अनुशासन म रखे की ओको आज्ञा पालन करतो हुयो ओको आदर करन वालो हो। <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />जब यदि कोयी अपनो घरच को इन्तजाम करनो नहीं जानय हय, त परमेश्वर की मण्डली की रखवाली कसो करेंन? <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />फिर यो कि विश्वास म परिपक्क हो, असो नहीं हो कि घमण्ड कर क् शैतान को जसो सजा पाये। <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />अऊर मण्डली को बाहेर वालो म भी ओको अच्छो नाम हो, असो नहीं होय कि अपमानित होय क शैतान को फन्दा म फस जाय।<verse eid="1TI 3:7" /></para>
  <para style="s">मण्डली म सेवक</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />वसोच मण्डली को सेवकों ख भी समझदार होनो चाहिये, कपटी, पियक्कड़ अऊर नहीं पैसा को लोभी हो; <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />पर विश्वास को सच ख शुद्ध विवेक सी गहरायी सी पकड़्यो रखे। <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />अऊर यो उन्की भी पहिले परख होय जाये, तब यदि निर्दोष निकले त मण्डली को सेवक को काम करे। <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />योच तरह सी उन्की पत्नियों आदर पावन को लायक बाईयां हो यां निन्दा करन वाली नहीं हो, पर सभ्य अऊर पूरी बातों म विश्वास लायक हो। <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />मण्डली को सेवक ख एकच पत्नी को पति रहे अऊर बाल-बच्चा अऊर अपनो घरो को अच्छो इन्तजाम करनो जानत होना। <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />जो मण्डली को सेवक अच्छो काम करय हंय, हि अपनो लायी अच्छो पद अऊर मसीह यीशु म विश्वास को बारे म महान निश्चिता ख प्राप्त करय हय, अऊर बड़ी हिम्मत सी बोलय हंय।<verse eid="1TI 3:13" /></para>
  <para style="s">महान रहस्य</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />मय तोरो जवर जल्दी आवन की आशा रखन पर भी या चिट्ठी तोख लिखू हय, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />कि यदि मोख देर होय जावय हय, त या चिट्ठी सी जानो कि तुम लोग परमेश्वर को घराना म जो जीन्दो परमेश्वर की मण्डली हय अऊर जो सच को खम्बा अऊर नीव हय, लोगों न आपस म कसो चाल चलन करनो चाहिये। <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />येको म सक नहाय कि भक्ति को भेद गम्भीर हय,</para>
  <para style="q1" vid="1TI 3:16">मतलब ऊ जो शरीर म प्रगट भयो,</para>
  <para style="q2" vid="1TI 3:16">आत्मा म सच्चो ठहरयो,</para>
  <para style="q2" vid="1TI 3:16">स्वर्गदूतों ख दिखायी दियो,</para>
  <para style="q1" vid="1TI 3:16">अऊर उन्को बारे म कुछ राष्ट्रों म ओको प्रचार करयो गयो,</para>
  <para style="q2" vid="1TI 3:16">जगत म ओको पर विश्वास करयो गयो,</para>
  <para style="q2" vid="1TI 3:16">अऊर महिमा म ऊपर उठायो गयो।<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">झूठो शिक्षक</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />पवित्र आत्मा स्पष्टता सी कह्य हय कि आवन वालो समयो म कितनो लोग भटकावन वाली आत्मावों, को पीछू चलेंन, अऊर विश्वास ख छोड़ देयेंन अऊर भटकावन वाली आत्मावों अऊर दुष्ट आत्मा द्वारा सिखायी हुयी बातों को पीछू चलेंन। <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />यो उन झूठो कपटी आदमियों को वजह होयेंन, जिन्को अन्तरमन मर गयो हय जसो की जलतो हुयो लोहा सी लसायो गयो हय, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />जो बिहाव करन सी रोकेन, अऊर भोजन की कुछ चिजों सी दूर रहन की आज्ञा देयेंन, जिन्ख परमेश्वर न येकोलायी बनायो कि विश्वासी अऊर सच को पहिचानन वालो ओख धन्यवाद को संग खाये। <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />कहालीकि परमेश्वर न बनायी हुयी हर एक चिज अच्छी हय, पर कोयी चिज अस्वीकार करन को लायक नहाय; पर यो कि धन्यवाद को संग खायी जाये, <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />कहालीकि परमेश्वर को वचन अऊर प्रार्थना सी शुद्ध होय जावय हय।<verse eid="1TI 4:5" /></para>
  <para style="s">यीशु मसीह को अच्छो सेवक</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />यदि तय भाऊवों ख इन बातों को याद दिलातो रहजो, अऊर विश्वास की सच्चायी सी अऊर अच्छी शिक्षा की बातों सी, जो तय मानत आयो हय त मसीह यीशु को अच्छो सेवक ठहरजो। <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />परमेश्वर रहित कथा कहानियां अऊर बूढ्ढिंयो द्वारा सुनायी कहानियों सी अलग रह्य; अऊर भक्ति की साधना कर। <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />कहालीकि शरीर की साधना सी कम फायदा होवय हय, पर भक्ति सब बातों को लायी लाभदायक हय, कहालीकि यो समय को जीवन अऊर आवन वालो जीवन को भी आश्वासन येकोच लायी हय। <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />या बात सच हय अऊर हर तरह सी विश्वास लायक अऊर मानन लायक हय। <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />कहालीकि हम मेहनत अऊर कोशिश येकोलायी करजे हंय कि हमरी आशा ऊ जीन्दो परमेश्वर पर हय, जो सब आदमियों को अऊर विशेष कर विश्वासियों को उद्धारकर्ता हय।<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />इन बातों की आज्ञा दे अऊर सिखातो रह्यो। <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />कोयी तोरी जवानी ख बेकार नहीं समझे; पर बातों म, अऊर चाल-चलन, अऊर प्रेम, अऊर विश्वास, अऊर पवित्रता म विश्वासियों को लायी आदर बन जा। <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />जब तक मय नहीं आऊं, तब तक शास्त्र ख पढ़न अऊर उपदेश देन अऊर सिखावन म मगन रह्य। <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />जो वरदान तोख दियो गयो हय, अऊर भविष्यवानी सी बुजूर्गों को हाथ रखतो समय तोख मिल्यो होतो, अनदेखो मत कर। <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />इन बातों ख सोचतो रह्य अऊर इनमच अपनो ध्यान लगायो रह्य, ताकि तोरी उन्नति सब लोगों पर प्रगट हो। <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />अपनो जीवन की अऊर अपनो शिक्षा की चौकसी रख। इन बातों पर स्थिर रह्य, कहालीकि यदि असो करतो रहजो त तय अपनो अऊर अपनो सुनावन वालो लायी भी उद्धार को वजह होजो।<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">विश्वासियों को प्रति जिम्मेदारियां</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />कोयी बुजूर्ग ख कठोरता सी मत डाट, पर ओख बाप समझ क बिनती कर, अऊर जवानों ख भाऊ मान क व्यवहार कर; <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />बूढ्ढी बाईयों ख माता जान क; अऊर जवान बाईयों ख पूरी पवित्रता सी बहिन जान क समझाय दे।<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />उन विधवावों को, ध्यान रख, जो सचमुच जरूरत मन्द हंय। <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />यदि कोयी विधवा को बालबच्चा अऊर नाती-पोता होना, त उन्न अपनो माय बाप अऊर दादा दादी को पालन पोषन को बदला चुकावन अऊर अपनो परिवार की चिन्ता करन को द्वारा अपनो धर्म को कार्य ख अपनो जीवन कार्य म लाये कहालीकि येको सी परमेश्वर खुश होवय हय। <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />जो विधवा सचमुच जरूरत मन्द हय, अऊर ओको कोयी नहाय, अऊर ओन अपनी पूरी आशा वा परमेश्वर पर रखी हय, अऊर रात दिन बिनती अऊर प्रार्थना करतो हुयो परमेश्वर सी मदत मांगय हय; <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />पर जो विधवा भोगविलास म जीवय हय, वा जीतो जी मर गयी हय। <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />इन बातों को भी निर्देश दियो कर ताकि हि निर्दोष रहे। <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />पर यदि जो कोयी अपनो रिश्तेदार अऊर अपनो घराना की चिन्ता नहीं करेंन, त ऊ विश्वास सी मुकर गयो हय अऊर अविश्वासी सी भी बुरो बन गयो हय।<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />उन विधवा को सुची म आर्थिक मदत ले रही हय वाच विधवा को नाम लिख्यो जाये जो साठ साल सी कम की नहीं हो, अऊर एकच पति की विश्वास लायक हो, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />अऊर भलो काम म अच्छी रही हो, जेन बच्चा को पालन-पोषन करयो होना; अतिथियों की सेवा करी होना, सन्तो को पाय धोयो होना, दुखियों कि मदत करी होना, अऊर हर एक अच्छो काम म मन लगायो होना।<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />पर जवान विधवावों ख सुची म सम्मिलित मत करो, कहालीकि मसीह को प्रति उन्को समर्पन पर जब उनकी विषय वासना की पूरी इच्छा हावी होवय हय त हि बिहाव करनो चाहवय हंय, <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />अऊर दोषी ठहरावय हंय, कहालीकि उन्न अपनो पहिले प्रतिज्ञा ख तोड़ दियो हय। <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />येको अलावा बिना काम को बनय हय अऊर घर-घर घुम क आलसी होनो सीखय हंय, अऊर केवल आलसी होनोच नहीं घर घर बाते करती रह्य हय अऊर बेवजह व्यस्त होवय हय असी बाते बोलय हय जो उन्ख नहीं बोलनो चाहिये। <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />येकोलायी मय यो चाहऊ हय कि जवान विधवाये बिहाव करे, अऊर बच्चा जने अऊर घरदार सम्भाले, अऊर कोयी विरोधी ख बदनाम करन को अवसर नहीं दे। <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />कहालीकि कुछ एक बहक क शैतान को पीछू भय गयो हंय। <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />यदि कोयी विश्वासिनी को यहां विधवाये होना, त वाच उनकी मदत करेंन कि मण्डली पर बोझ नहीं हो, ताकि ऊ उनकी मदत कर सकेंन जो सचमुच विधवाये जरूरत मन्द हंय।<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />जो बुजूर्ग मण्डली को अच्छो इन्तजाम करय हंय, विशेष कर क् हि जो वचन सुनावन अऊर सिखावन म मेहनत करय हंय, दोय गुना मजूरी को लायक समझ्यो जाये। <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" /><note caller="+" style="x"><char style="xo" closed="false">५:१८ </char><char style="xt" closed="false"><ref loc="MAT 10:10">मत्ती १०:१०</ref>; <ref loc="LUK 10:7">लूका १०:७</ref></char></note>कहालीकि शास्त्र कह्य हय, “दांवन वालो बईल को मुंह मत बान्धजो,” कहालीकि “मजूर अपनी मजूरी को हक्कदार हय।” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />कोयी दोष कोयी बुजूर्ग पर लगायो जाय त दोय यां तीन गवाहों को बिना ओख मत सुन। <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />पाप करन वालो ख सब को सामने डाट दे, ताकि अऊर लोग भी डरे।<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />परमेश्वर, अऊर मसीह यीशु अऊर चुन्यो हुयो स्वर्गदूतों ख मौजूद जान क मय तोख चेतावनी देऊ हय इन निर्देषो ख मानतो रह्य, अऊर बिना मतभेद को कोयी भी काम पक्षपात अऊर कोयी एक को बाजू ले क मत कर। <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />मण्डली सेवा नियुक्ति लायी कोयी पर तुरतच हाथ मत रखजो, अऊर दूसरों को पापों म सामिल मत होजो; अपनो आप ख पवित्र बनायो रखजो।<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />केवल पानीच पीवन वालो मत रह्य, पर अपनो पेट को अऊर अपनो बार-बार बीमार होन को वजह थोड़ो-थोड़ो अंगूररस भी काम म लायो कर।<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />कुछ लोगों को पाप प्रगट होय जावय हंय अऊर न्याय लायी पहिले सी पहुंच जावय हंय, पर कुछ लोगों को पाप बाद म प्रगट होवय हंय। <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />योच तरह अच्छो काम भी स्पष्ट रूप सी प्रगट होवय हय पर जो काम प्रगट नहीं होवय हि लूक नहीं सकय।<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />जितनो सेवक गुलामी को बोझ म हंय, हि अपनो अपनो स्वामी ख बड़ो आदर लायक जाने, ताकि परमेश्वर को नाम अऊर शिक्षा की निन्दा नहीं हो। <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />जिन्को स्वामी विश्वासी हंय उन्ख हि भाऊ होन को वजह कम आदर नहीं दिखाये। बल्की उनकी अऊर भी जादा सेवा करे, कहालीकि सेवा फायदा मिलय हय हि विश्वासी हय अऊर हि उन ख प्रिय हंय। इन बातों ख सिखावो अऊर करन को लायी असोच प्रोत्साहित करतो रहो।<verse eid="1TI 6:2" /></para>
  <para style="s">झूठी शिक्षा अऊर धन को लोभ</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />यदि कोयी अऊरच तरह की शिक्षा देवय हय अऊर सच्ची बातों ख, मतलब हमरो प्रभु यीशु मसीह को निर्देषो ख अऊर वा शिक्षा ख नहीं मानय, जो दैविय शिक्षा को अनुसार हय, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />त ऊ घमण्डी भय गयो, अऊर कुछ नहीं जानय; बल्की ओख झगड़ा अऊर शब्दों पर दिमाग लगावन को रोग हय, जेकोसी जलन, अऊर झगड़ा, अऊर निन्दा की बाते, अऊर बुरो-बुरो शक, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />अऊर उन आदमियों म बेकार लड़ाई-झगड़ा पैदा होवय हंय जिन्की बुद्धि भ्रष्ट भय गयी हय, अऊर हि सत्य सी दूर भय गयो हंय, जो सोचय हंय कि भक्ति कमायी को द्वार हय।<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />पर सन्तुष्ट सहित भक्ति करनोंच सब सी बड़ी कमायी हय। <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />कहालीकि हम जगत म कुछ नहीं लायो हंय अऊर नहीं कुछ लिजाय सकजे हंय। <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />यदि हमरो जवर खान ख अऊर पहिनन ख हो, त इन्कोच पर सन्तुष्ट करनो चाहिये। <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />पर जो धनी होनो चाहवय हंय, हि असी परीक्षा अऊर फन्दा अऊर बहुत सी मुर्खतापूर्न अऊर हानिकारक लालसा म फसय हंय, जो आदमियों ख बिगाड़ देवय हंय अऊर विनाश की गहरी खायी म ढकेल देवय हंय। <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />कहालीकि पैसा को लोभ सब तरह की बुरायीयों की जड़ी आय, जेक हासिल करन की कोशिश करतो हुयो बहुत सो न विश्वास सी भटक क अपनो आप ख कुछ तरह को दु:खों म फस गयो हय।<verse eid="1TI 6:10" /></para>
  <para style="s">व्यक्तिगत निर्देश</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />पर हे परमेश्वर को लोग, तय इन बातों सी भग, अऊर सच्चायी, भक्ति, विश्वास, प्रेम, धीरज अऊर नम्रता को पीछा कर। <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />विश्वास की अच्छी दवड़; अऊर ऊ अनन्त जीवन ख हासिल कर ले, जेको लायी तय बुलायो गयो अऊर बहुत सो गवाहों को सामने अच्छो अंगीकार करयो होतो। <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" /><note caller="+" style="x"><char style="xo" closed="false">६:१३ </char><char style="xt" closed="false"><ref loc="JHN 18:37">यूहन्ना १८:३७</ref></char></note>मय तोख या आज्ञा परमेश्वर को सामने, जो सब ख जीवन देवय हय, अऊर मसीह यीशु ख गवाह कर क् जेन पुन्तियुस पिलातुस को सामने अच्छी गवाही दी, या आज्ञा देऊ हय, <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />कि तय हमरो प्रभु यीशु मसीह ख प्रगट होन तक या आज्ञा ख निष्कलंक अऊर निर्दोष रख, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />परमेश्वर ओख सही समय पर प्रगट करेंन जो आशिषित हय, ऊ एकच शासक अऊर राजावों को राजा अऊर प्रभुवों को प्रभु हय। <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />अऊर अमरता केवल ओकीच हय, अऊर ऊ ज्योति म रह्य हय, जित तक कोयी पहुंच नहीं सकय हय, अऊर नहीं ओख कोयी आदमी न देख्यो अऊर नहीं कभी देख सकय हय। ऊ प्रतिष्ठा अऊर राज्य अनन्त काल तक रहेंन। आमीन।<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />यो जगत को धनवानों ख आज्ञा दे कि हि घमण्डी मत बनो अऊर अनिश्चित धन पर आशा नहीं रखे, पर परमेश्वर पर जो हमरो सुख को लायी सब कुछ बहुतायत सी देवय हय। <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />उन्ख आज्ञा दे की हि भलायी करे, अऊर भलो कामों म धनी बने, अऊर उदारता सी मदत देन म तैयार रहे, <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />अऊर आगु लायी एक अच्छी नीव डाल रखे कि सच्चो जीवन ख वश म कर ले।<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />हे तीमुथियुस, यो धरोहर की रखवाली कर; अऊर जेक कुछ लोग गलत बात ज्ञान कह्य हय, उन्को अधार्मिक वाद विवाद अऊर विरोध की बातों सी दूर रह्य। <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />कितनो लोगों न प्रतिज्ञा करयो हय कि उन्ख ज्ञान हय फिर भी हि विश्वास सी भटक गयो हंय।</para>
  <para style="p" vid="1TI 6:21">तुम पर अनुग्रह होतो रहे।<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>