<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Lodhi</book>
  <para style="h">२ तीमुथियुस</para>
  <para style="toc3">२ तीमुथियुस</para>
  <para style="toc2">२ तीमुथियुस</para>
  <para style="toc1">तीमुथियुस को नाम पौलुस प्रेरित की दूसरी चिट्ठी</para>
  <para style="mt2">तीमुथियुस के नाम पौलुस प्रेरित की दूसरी पत्री</para>
  <para style="mt1">तीमुथियुस को नाम पौलुस प्रेरित की दूसरी चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">२ तीमुथियुस की किताब प्रेरित पौलुस को दूसरों सेवक तीमुथियुस लायी दूसरी चिट्ठी आय। २ तीमुथियुस पौलुस को जीवन को आखरी म लिखी गयी होती। यो समय रोम म ओख बन्दी बनाय लियो गयो होतो <char style="xt"><ref loc="2TI 1:16">१:१६</ref>।</char> पौलुस न तीमुथियुस को संग घनो सम्बन्ध रख्यो अऊर हमेशा ओख एक टुरा को रूप म दर्शायो हय। <char style="xt"><ref loc="PHP 2:22">फिलिप्पियों २:२२</ref>,</char> <char style="xt"><ref loc="1TI 1:2">१ तीमुथियुस १:२</ref>; <ref loc="1TI 1:18">१:१८</ref>।</char></para>
  <para style="ip">या पौलुस की चार चिट्ठियों म सी एक आय जेक मण्डली को बजाय कोयी आदमी ख सम्बोधित करयो जावय हय। दूसरी तीन असी चिट्ठी १ तीमुथियुस, तीतुस अऊर फिलेमोन आय। ऊ समय को दौरान २ तीमुथियुस लिख्यो गयो होतो, रोमन साम्राज्य को मसीहियों ख सतायो जाय रह्यो होतो। शायद योच वजह होतो की पौलुस जेलखाना म होतो अऊर तीमुथियुस ख कठिनायी ख एकसमना करन को निर्देश देत होतो। १ तीमुथियुस म, पौलुस न तीमुथियुस ख झूठो शिक्षकों को बारे म कुछ चेतावनी दी। <char style="xt"><ref loc="1TI 1:16-18">१ तीमुथियुस १:१६-१८</ref></char> ऊ तीमुथियुस ख भी बतावय हय कि आगु कठिन समय रहेंन<char style="xt"><ref loc="2TI 3:1">३:१</ref>। </char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पौलुस अऊर तीमुथियुस को अभिवादन सी सुरू होवय हय। अऊर फिर ओख प्रोत्साहित करय हय। <char style="ior"><ref loc="2TI 1:1-18">१:१-१८</ref></char></para>
  <para style="io1">२. तब ऊ तीमुथियुस ख सहन करन लायी चुनौती देवय हय। <char style="ior"><ref loc="2TI 2:1-13">२:१-१३</ref></char></para>
  <para style="io1">३. हर समय ऊ ओख कुछ दूसरों निर्देश देवय हय। <char style="ior"><ref loc="2TI 2:14-26">२:१४-२६</ref></char></para>
  <para style="io1">४. फिर ऊ ओख भविष्य की घटनावों अऊर जवाब देन को सही तरीका को बारे म चेतावनी देवय हय। <char style="ior"><ref loc="2TI 3:1-4:8">३:१–४:८</ref></char></para>
  <para style="io1">५. पौलुस तीमुथियुस लायी कुछ व्यक्तिगत बातों को संग चिट्ठी लिखनो बन्द करय हय। <char style="ior"><ref loc="2TI 4:9-22">४:९-२२</ref> </char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />पौलुस को तरफ सी जो परमेश्वर की इच्छा सी जो मसीह यीशु को प्रेरित हय, अऊर जेक मसीह यीशु म एक होन लायी प्रतिज्ञा को प्रचार करन लायी भेज्यो हय। <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" /><note caller="+" style="x"><char style="xo" closed="false">१:२ </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेरितों १६:१</ref></char></note>प्रिय बेटा तीमुथियुस को नाम परमेश्वर बाप अऊर हमरो प्रभु मसीह यीशु की तरफ सी मोख अनुग्रह अऊर दया अऊर शान्ति मिलती रहे।<verse eid="2TI 1:2" /></para>
  <para style="s">धन्यवाद अऊर प्रोत्साहन</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />मय परमेश्वर ख धन्यवाद करू हय जेकी सेवा मय शुद्ध विवेक सी करू हय, जसो मोरो बाप दादावों न करयो। अऊर रात दिन जब मय हमेशा अपनी प्रार्थनावों म तुम्ख याद करू हय, तब मय ओख धन्यवाद करू हय। <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />अऊर तोरो आसुवों की सुधि ले क तोरो सी मिलन की आशा रखू हय कि खुशी सी भर जाऊं। <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" /><note caller="+" style="x"><char style="xo" closed="false">१:५ </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेरितों १६:१</ref></char></note>मय तोरो ऊ सच्चो विश्वास की याद करू हय, जो पहिले तोरी आजी लोइस अऊर तोरी माय यूनीके म होती, अऊर तोख निश्चय हय कि उच विश्वास तोरो म भी हय। <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />योच वजह मय तोख याद दिलाऊं हय कि तय ऊ वरदान ख जीन्दो रख जो तोरो ऊपर मोरो हाथ रखन को द्वारा परमेश्वर न तोख दियो। <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />कहालीकि परमेश्वर न हम्ख डर की नहीं पर सामर्थ, प्रेम अऊर संय्यम की आत्मा दी हय।<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />येकोलायी हमरो प्रभु की गवाही सी, अऊर मोरो सी जो मसीह को कैदी हय, लज्जित मत हो, पर ऊ सामर्थ जो परमेश्वर न तोख दी हय ओको अनुसार सुसमाचार को लायी मोरो संग दु:ख उठाव। <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />जेन हम्ख बचायो अऊर पवित्र जीवन जीन को लायी बुलायो, अऊर यो हमरो कामों को अनुसार नहीं; पर ओको उद्देश अऊर ऊ अनुग्रह को अनुसार हय। ओन यो अनुग्रह हम पर करयो हय मतलब प्रभु यीशु मसीह को द्वारा अनन्त काल को सुरूवात सी हम पर भयो हय। <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />पर अब हमरो उद्धारकर्ता मसीह यीशु को प्रगट होनो सी प्रगट भयो। जेन मृत्यु को सामर्थ ख नाश करयो अऊर अनन्त जीवन को सुसमाचार को द्वारा प्रगट करयो।<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:११ </char>
      <char style="xt" closed="false">
        <ref loc="1TI 2:7">१ तीमुथियुस २:७</ref>
      </char>
    </note>जेको लायी परमेश्वर न मोख प्रचारक, प्रेरित अऊर शिक्षक लायी नियुक्त करयो, ताकी मय सुसमाचार की घोषना करू। <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />यो वजह मय इन दु:खों ख भी उठाऊ हय, पर लजाऊ नहीं, कहालीकि मय ओख जेक पर मय न विश्वास करयो हय, जानु हय; अऊर मोख निश्चय हय कि वा मोरी धरोहर की ऊ दिन तक रखवाली कर सकय हय। <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />जो सही बाते मोरो सी सुनी हय कि प्रभु यीशु मसीह म अच्छी शिक्षा, विश्वास अऊर प्रेम को संग, एक आदर्श को रूप म कायम रख। <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />अऊर पवित्र आत्मा सी जो हम म बस्यो हुयो हय, या अच्छी बातों की रखवाली कर।<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />तय जानय हय कि आसिया प्रान्त वालो सब मोरो सी फिर गयो हंय, जिन्म फूगिलुस अऊर हिरमुगिनेस हंय। <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />उनेसिफुरुस को घरानों पर प्रभु दया करेंन, कहालीकि ओन बहुत बार मोख सुख पहुंचायो तथा ऊ मोरी संकली म रहन सी लज्जित नहीं भयो। <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />पर जब ऊ रोम शहर म आयो, जब तक मय नहीं मिल्यो तब तक मोख ढूंढतो रह्यो। <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />प्रभु करे कि ऊ दिन ओको पर प्रभु की दया हो अऊर जो जो सेवा ओन इफिसुस म करी हय उन्ख भी तय अच्छो सी जानय हय।<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">मसीह यीशु को सच्चो सिपाही</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />येकोलायी हे मोरो बेटा, तय ऊ अनुग्रह सी जो यीशु मसीह म हमरी एकता को द्वारा हय, बलवन्त हो जाय; <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />अऊर जो शिक्षाये तय न बहुत सो गवाह को सामने मोरो सी सुनी हंय, उन्ख विश्वासी आदमियों ख सौंप दे; जो दूसरों ख भी सिखावन को लायक हो।<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />मसीह यीशु को अच्छो योद्धा को जसो मोरो संग दु:ख उठाव। <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />जब कोयी योद्धा लड़ाई पर जावय हय, त येकोलायी कि अपनो भरती करन वालो ख खुश करे, अपनो आप ख जगत को कामों म नहीं फसावय। <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />अगर कोयी अपनी दवड़ म व्यवस्था को पालन नहीं करे त ईनाम नहीं पावय। <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />जो किसान मेहनत करय हय, उपज को पहिलो हिस्सा ओख मिलनो चाहिये। <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />जो मय कहू हय ओको पर ध्यान दे, अऊर प्रभु तोख इन सब बातों की समझ देयेंन।<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />असो यीशु मसीह ख याद रख, जो मरयो हुयो म सी जीन्दो भयो, अऊर दाऊद को वंश सी हय अऊर यो मोरो सुसमाचार को अनुसार हय। <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />कहालीकि सुसमाचार सुनावन लायी मय दु:ख उठाऊ हय, अऊर यहां तक कि अपराधी को जसो जंजीरो म बान्ध्यो जाऊं हय। पर परमेश्वर को वचन जंजीरो म बन्ध्यो नहाय। <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />यो वजह मय चुन्यो हुयो लोगों को लायी सब कुछ सहू हय, कि हि भी उद्धार ख जो मसीह यीशु म हय अनन्त महिमा को संग पाये। <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />या बात सच हय, कि यदि हम</para>
  <para style="q1" vid="2TI 2:11">ओको संग मर गयो हय,</para>
  <para style="q2" vid="2TI 2:11">त ओको संग जाबोंन भी;<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१२ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:33">मत्ती १०:३३</ref>; <ref loc="LUK 12:9">लूका १२:९</ref></char>
    </note>यदि हम धीरज सी सहतो रहबोंन,</para>
  <para style="q2" vid="2TI 2:12">त ओको संग राज भी करबोंन;</para>
  <para style="q1" vid="2TI 2:12">यदि हम ओको इन्कार करबोंन</para>
  <para style="q2" vid="2TI 2:12">त ऊ भी हमरो इन्कार करेंन;<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />यदि हम अविश्वासी भी होना,</para>
  <para style="q2" vid="2TI 2:13">तब भी ऊ विश्वास लायक बन्यो रह्य हय,</para>
  <para style="q2" vid="2TI 2:13">कहालीकि ऊ खुद अपनो इन्कार नहीं कर सकय।<verse eid="2TI 2:13" /></para>
  <para style="s">अच्छो मजूर</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />इन बातों की याद उन्ख दिलाव अऊर प्रभु को सामने चिताय दे कि शब्दों पर दिमाग मत लगायो करे, जिन्कोसी कुछ फायदा नहीं होवय बल्की सुनन वालो को आत्मिक रूप सी नाश होय जावय हंय। <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />अपनो आप ख परमेश्वर को स्वीकारन लायक अऊर असो काम करन वालो ठहरान की कोशिश कर, जो लज्जित होनो नहीं पाये, अऊर जो सच को वचन ख ठीक रीति सी सिखावय हय। <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />बेकार अऊर अधार्मिक वाद विवाद सी बच्यो रह्य, कहालीकि या गलत बाते लोगों ख परमेश्वर सी दूर ले जायेंन, <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />असो लोगों कि शिक्षाये खुलो घाव को जसो शरीर म फैलतच जायेंन। हुमिनयुस अऊर फिलेतुस उन्म म सी हय। <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />जो यो कह्य क कि पुनरुत्थान भय गयो हय अऊर सत्य सी भटक गयो हंय कितनो ख त विश्वास सी नाश कर देवय हंय। <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />तब भी परमेश्वर की पक्की नीव बनी रह्य हय, अऊर ओख पर यो छाप लगी हय: “प्रभु अपनो लोगों ख पहिचानय हय,” अऊर “जो कोयी प्रभु को नाम लेवय हय, ऊ अधर्म सी बच्यो रहेंन।”<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />बड़ो घर म नहीं केवल सोना-चांदीच को, पर लकड़ी अऊर माटी को बर्तन भी होवय हंय; कुछ खास अवसर को वापरन को लायी अऊर कुछ साधारन वापरन लायी। <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />यदि कोयी अपनो आप ख बुरी बातों सी शुद्ध करे, त ऊ खास अवसर वापरन को लायी अऊर खास उद्देश को संग कहालीकि ऊ अपनो मालिक लायी समर्पित अऊर उपयोगी होयेंन, अऊर हर एक अच्छो काम लायी उपयोग म लायो जायेंन। <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />जवानी की इच्छावों सी भग, अऊर जो शुद्ध मन सी प्रभु को नाम लेवय हय उन्को संग सच्चो, अऊर विश्वास, अऊर प्रेम, अऊर शान्ति को पीछा कर। <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />पर मूर्खता अऊर नासमझदारी को विवादों सी अलग रह्य, कहालीकि तय जानय हय कि इन्को सी झगड़ा पैदा होवय हंय। <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />प्रभु को सेवक ख झगड़ालू नहीं होनो चाहिये, पर ऊ सब को संग दयालु अऊर सहनशील अऊर अच्छो सिखावन वालो हो। <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />ऊ विरोधियों ख नम्रता सी समझाये, का जाने परमेश्वर उन्ख मौका दे कि हि अपनो पापों सी फिर क मन फिरावय कि हि भी सच ख पहिचानेंन, <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />अऊर हि सचेत होय क शैतान को फन्दा सी छूट जाये। जेन उन्ख ओकी इच्छा पूरी करन लायी बन्दी बनायो।<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">आखरी दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />पर यो याद रख कि आखरी दिनो म कठिन समय आयेंन। <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />कहालीकि आदमी स्वार्थी, लालची, अभिमानी, निन्दक, माय बाप की आज्ञा टालन वालो, एहसान नहीं मानन वालो, अपवित्र, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />प्रेमरहित, क्षमारहित, निन्दा करन वालो, असंयमी, कठोर, भलायी को बैरी, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />विश्वासघाती, कठोर, अभिमानी, अऊर परमेश्वर को प्रेम नहीं बल्की सुखविलास को चाहन वालो होयेंन। <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />हि भक्ति को भेष त धरेंन, पर ओकी सामर्थ ख नहीं मानेंन; असो लोगों सी दूर रहजो। <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />इन म सी हि लोग हंय जो घरो म चुपचाप घुस आवय हंय, अऊर उन कमजोर बाईयों ख वश म कर लेवय हंय जो पापों को दोष सी दबी अऊर हर तरह की अभिलाषावों को वश म हंय, <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />अऊर हमेशा सीखती त रह्य हय पर सच ख नहीं जानय। <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />जसो यन्नेस अऊर यम्ब्रेस न मूसा को विरोध करयो होतो, वसोच हि भी सच को विरोध करय हंय; हि असो आदमी हंय, जिन्की बुद्धी भ्रष्ट भय गयी हय अऊर हि विश्वास को बारे म असफल हंय। <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />पर हि येको सी आगु नहीं बढ़ सकय, कहालीकि सब लोग उन्की मुर्खता देखेंन कि हि कितनो मुर्ख हय। वसोच जसो यन्नेस अऊर यम्ब्रेस को संग भयो।<verse eid="2TI 3:9" /></para>
  <para style="s">आखरी निर्दोष</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />पर तय मोरी शिक्षा, आचरन, मोरो जीवन जीन को उद्देश, विश्वास, धीरज, प्रेम, अऊर सहनशीलता, या पूरी बातों ख अच्छी तरह सी जानय हय। <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" /><note caller="+" style="x"><char style="xo" closed="false">३:११ </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">प्रेरितों १३:१४-५२</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:1-7">प्रेरितों १४:१-७</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:8-20">प्रेरितों १४:८-२०</ref></char></note>मोरो सताव अऊर मोरो दु:ख। अन्ताकिया अऊर इकुनियुम अऊर लुस्रा म मोख कितनो भयानक यातनायें दी गयी होती। जेक मय न सह्यो हय तय जानय हय, पर फिर भी प्रभु न मोख इन सब सी छुड़ायो हय। <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />पर जितनो मसीह यीशु म एक रूप होय क भक्ति को संग जीवन जीनो चाहवय हंय हि सब सतायो जायेंन; <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />पर दुष्ट अऊर बहकान वालो धोका देतो हुयो अऊर धोका खातो हुयो, बिगड़तो चली जायेंन। <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />पर तय उन सच की बातों पर जो तय न सिख्यो हंय अऊर विश्वास करयो हय, यो जान क मजबूत बन्यो रह्य कि तय न उन्ख कौन्सो लोगों सी सिख्यो हय, <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />अऊर तय बचपन सी पवित्र शास्त्र ख जानय हय, जो तोख बुद्धी देवय हय कि तय यीशु मसीह म विश्वास को द्वारा उद्धार तक पहुंचे। <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />पूरो पवित्र शास्त्र परमेश्वर की प्रेरना सी रच्यो गयो हय हि लोगों ख सच की शिक्षा देन, अऊर उन्ख सुधारन, अऊर उनकी बुरायी दर्शावन अऊर लायक जीवन जीन को लायी निर्देश देन लायी फायदेमंद हय, <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />ताकि परमेश्वर को लोग पूरी रीति सी सिद्ध होय जाये, अऊर हर एक अच्छो काम को लायी तैयार होय जाये।<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />परमेश्वर अऊर प्रभु यीशु मसीह की उपस्थिति म जो जीन्दो अऊर मरयो हुयो को न्याय करेंन अऊर राजा बन क शासन करन आयेंन। गवाह मान क मय बिनती करू हय। <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />कि तय वचन को प्रचार कर, समय अऊर असमय तैयार रह्य, सब तरह की सहनशीलता अऊर शिक्षा को संग गलती को सुधार करनो अऊर डाटनो अऊर प्रोत्साहित करनो। <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />कहालीकि असो समय आयेंन जब लोग सच्चो उपदेश नहीं सह सकेंन, ऊ केवल खुद ख समाधान मिले असी बाते कानो सी सुनन को लायी अपनी अभिलाषावों को अनुसार अपनो लायी बहुत सो उपदेशक जमा कर लेयेंन, <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />अऊर अपनो कान सच सी फिराय क काल्पनिक कथा कहानियों पर लगायेंन। <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />पर तय सब बातों म खुद पर ध्यान रख, दु:ख उठाव, सुसमाचार प्रचार को काम कर, अऊर अपनी सेवा ख पूरी कर।<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />कहालीकि बली चढ़ावन लायी मोरी घड़ी आय गयी हय, अऊर मोरो यो जीवन ख त्यागन को समय आय गयो हय। <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />मय अच्छी कुश्ती लड़ चुक्यो हय, मय न अपनी दौड़ पूरी कर लियो हय, मय न विश्वास की रखवाली करी हय। <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />भविष्य म मोरो लायी जीत को ईनाम रख्यो हुयो हय। जेक प्रभु, जो सच्चो अऊर सच्चायी हय, मोख ऊ दिन देयेंन, अऊर मोखच नहीं बल्की उन सब ख भी जो ओको प्रगट होन ख प्रिय जानय हंय।<verse eid="2TI 4:8" /></para>
  <para style="s">व्यक्तिगत सन्देश</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />मोरो जवर तुरतच आवन की कोशिश कर। <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" /><note caller="+" style="x"><char style="xo" closed="false">४:१० </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सियों ४:१४</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref>; </char><char style="xt" closed="false"><ref loc="2CO 8:23">२ कुरिन्थियों ८:२३</ref>; <ref loc="GAL 2:3">गलातियों २:३</ref>; <ref loc="TIT 1:4">तीतुस १:४</ref></char></note>कहालीकि देमास न यो जगत ख प्रिय जान क मोख छोड़ दियो हय अऊर थिस्सलुनीके नगर ख चली गयो हय। क्रेसेन्स गलातिया प्रदेश ख चली गयो अऊर तीतुस दलमतिया ख चली गयो हय। <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" /><note caller="+" style="x"><char style="xo" closed="false">४:११ </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्सियों ४:१४</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref>; </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेरितों १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref>; <ref loc="COL 4:10">कुलुस्सियों ४:१०</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref></char></note>केवल लूका मोरो संग हय। मरकुस ख धर क चली आव; कहालीकि सेवा को लायी ऊ मोरो बहुत मदद को हय। <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" /><note caller="+" style="x"><char style="xo" closed="false">४:१२ </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेरितों २०:४</ref>; <ref loc="EPH 6:21">इफिसियों ६:२१</ref>,<ref loc="EPH 6:22">२२</ref>; <ref loc="COL 4:7">कुलुस्सियों ४:७</ref>,<ref loc="COL 4:8">८</ref></char></note>तुखिकुस ख मय न इफिसुस भेज्यो हय। <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" /><note caller="+" style="x"><char style="xo" closed="false">४:१३ </char><char style="xt" closed="false"><ref loc="ACT 20:6">प्रेरितों २०:६</ref></char></note>जब तय आयजो त जो कोट त्रोआस म करपुस को यहां छोड़ आयो हय ऊ ले क आयजो; अऊर मोरी किताबे विशेष कर क् चमड़ा पर लिखी चिट्ठी ख ले क आयजो। <figure style="fig" alt="Scrolls standing by ink well" file="hk00153c.tif" size="col" copy="Horace Knowles ©" ref="४:१३">अच्छो तरह सी स्याही लगी हुयी किताब </figure><verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१४ </char>
      <char style="xt" closed="false">
        <ref loc="1TI 1:20">१ तीमुथियुस १:२०</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ROM 2:6">रोमियों २:६</ref>
      </char>
    </note>सिकन्दर धातु को काम करन वालो न मोख बहुत हानि पहुंचायी हय; परमेश्वर ओख ओको कामों को अनुसार फर देयेंन। <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />तय भी ओको सी सावधान रह, कहालीकि ओन हमरी उपदेशों को बहुतच विरोध करयो हय।<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />पहिले मोरो पक्ष म कोयी न मोरो साथ नहीं दियो, बल्की सब न मोख छोड़ दियो होतो। भलो होय कि येको उन्ख लेखा देनो नहीं पड़ेंन। <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />पर प्रभु मोरो संग खड़ो रह्यो अऊर मोख सामर्थ दियो, ताकि मोरो सी पूरो-पूरो प्रचार हो अऊर सब गैरयहूदियों सुन ले। मय मौत की सजा सी छुड़ायो गयो। <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />अऊर प्रभु मोख हर एक बुरो काम सी छुड़ायेंन, अऊर अपनो स्वर्गीय राज्य म सुरक्षित पहुंचायेंन। ओकीच महिमा हमेशा-हमेशा होती रहेंन। आमीन।<verse eid="2TI 4:18" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१९ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">प्रेरितों १८:२</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="2TI 1:16">२ तीमुथियुस १:१६</ref>,<ref loc="2TI 1:17">१७</ref></char>
    </note>प्रिस्का अऊर अक्विला ख अऊर उनेसिफुरुस को घराना ख नमस्कार। <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" /><note caller="+" style="x"><char style="xo" closed="false">४:२० </char><char style="xt" closed="false"><ref loc="ACT 19:22">प्रेरितों १९:२२</ref>; <ref loc="ROM 16:23">रोमियों १६:२३</ref>; </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेरितों २०:४</ref>; <ref loc="ACT 21:29">२१:२९</ref></char></note>इरास्तुस कुरिन्थुस म रह्य गयो, अऊर त्रुफिमुस ख मय न मिलेतुस म बीमार छोड्यो हय।<verse eid="2TI 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2TI 4:21" />ठंडी सी पहिले चली आवन की कोशिश कर। यूबूलुस, अऊर पूदेंस, अऊर लीनुस अऊर क्लौदिया, अऊर सब विश्वासी भाऊवों-बहिनों को तोख नमस्कार।<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />प्रभु तोरी आत्मा को संग रहे।</para>
  <para style="p" vid="2TI 4:22">तुम पर परमेश्वर को अनुग्रह होतो रहे।<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>