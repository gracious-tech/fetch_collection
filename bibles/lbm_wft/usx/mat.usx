<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">-Lodhi</book>
  <para style="h">मत्ती</para>
  <para style="toc3">मत्ती</para>
  <para style="toc2">मत्ती</para>
  <para style="toc1">मत्ती रचित यीशु मसीह का सुसमाचार</para>
  <para style="mt2">मत्ती रचित यीशु मसीह का सुसमाचार</para>
  <para style="mt1">मत्ती रचित यीशु मसीह को सुसमाचार</para>
  <para style="imt">परिचय</para>
  <para style="ip">मत्ती रचित सुसमाचार यो ऊ नयो नियम की चार किताबों म सी एक आय, जो यीशु मसीह को जीवन ख बतावय हय, या चार किताबों म सी यो एक सुसमाचार कहलायो गयो हय, येको मतलब हय, कि इन चारों म हर एक किताब सुसमाचार आय। यीशु को स्वर्ग म जान को बाद हि किताबे मत्ती, मरकुस, लूका अऊर यूहन्ना न लिख्यो हय। मत्ती रचित सुसमाचार कब लिख्यो गयो येकी जानकारी विद्वान लोगों ख नहाय। फिर भी हम असो कह्य सकजे हय कि यीशु को जनम को करीब ६० साल को बाद या किताब लिखी गयी हय, योच तरह कित लिखी गयी हय यो मालूम नहाय फिर भी बहुतों को माननो हय कि या किताब पलिस्तिन म यां यरूशलेम नगर म लिखी गयी होना।</para>
  <para style="ip">या किताब को लेखक मत्ती आय जो एक यीशु को चेला होन को पहिले एक कर लेनवालो होतो ओख लेवी नाम सी भी पहिचान्यो जात होतो, मत्ती बारा प्रेरितों म सी एक होतो अऊर ओन यहूदी लोगों लायी लिख्यो होतो, यो वजह हम देखजे हय कि या किताब म ६० सी भी ज्यादा सन्दर्भ पुरानो नियम को हय, जेको बारे म भविष्यवानी भयी, ऊ मुक्तिदाता मसीह यीशुच आय, यो ऊ बतानो चाहत होतो, मत्ती न परमेश्वर को राज्य को बारे म भी बहुत कुछ लिख्यो, यहूदियों कि या आशा होती कि मसीह राजनैतिक राज्य को राजा बनेंन। मत्ती यो बिचार ख आव्हान दे क परमेश्वर को आत्मिक राज्य को वर्नन करय हय।</para>
  <para style="ip">यो मत्ती रचित सुसमाचार या एक अच्छी किताब आय, जेकोसी एक नयो नियम की सुरूवात की, या किताब पुरानो नियम को तरफ बार बार हमरो ध्यान आकर्षित करय हय, या किताब पुरानो अऊर नयो नियम इन दोयी ख जोड़ देवय हय, विद्वानों ख असो सुझाव देवय हय कि या किताब म मूसा न लिख्यो हुयो, पंचग्रंथ, “जो पुरानो नियम की पाच किताबे आय, उन्को नमुना को अनुकरन करय हय, यीशु न जो पहाड़ी पर उपदेश दियो,” अध्याय <char style="xt"><ref loc="MAT 5-7">५–७</ref></char> तक परमेश्वर न मूसा ख जो नियम शास्त्र दियो हय, येकी तुलना हम ओको सी कर सकजे हय। <char style="xt"><ref loc="DEU 19:3-23:25">व्यवस्थाविवरन १९:३–२३:२५</ref></char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. यीशु को जनम सी अऊर ओकी सेवा की सुरूवात सी मत्ती अपनो सुसमाचार की सुरूवात करय हय। <char style="ior"><ref loc="MAT 1-4">१–४</ref></char></para>
  <para style="io1">२. येको बाद म मत्ती यीशु की सेवा को बारे म जो बहुत बातों की शिक्षा दियो हय, ओको बारे म बतावय हय। <char style="ior"><ref loc="MAT 5-25">५–२५</ref></char></para>
  <para style="io1">३. मत्ती रचित सुसमाचार जो आखरी भाग यो यीशु की सेवा को काम ख दिखावय हय जेको म ऊची पहाड़ी मतलब ओको मरन अऊर पुनरुत्थान ख दिखावय हय। <char style="ior"><ref loc="MAT 26-28">२६–२८</ref></char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">यीशु की वंशावली</para>
  <para style="r">(<ref loc="LUK 3:23-38">लूका ३:२३-३८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />अब्राहम की सन्तान, दाऊद की सन्तान, अऊर यीशु मसीह की लिखित वंशावली। <verse eid="MAT 1:1" /><verse number="2" style="v" sid="MAT 1:2" />अब्राहम सी इसहाक पैदा भयो, इसहाक सी याकूब, याकूब सी यहूदा अऊर ओको भाऊ पैदा भयो, <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />यहूदा अऊर तामार सी फिरिस अऊर जोरह पैदा भयो, फिरिस सी हिस्रोन, अऊर हिस्रोन सी एराम, <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />एराम सी अम्मीनादाब, अम्मीनादाब सी नहशोन, अऊर नहशोन सी सलमोन, <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />सलमोन अऊर राहब सी बोअज, बोअज अऊर रूत सी ओबेद, अऊर ओबेद सी यिशै, <verse eid="MAT 1:5" /><verse number="6" style="v" sid="MAT 1:6" /><note caller="+" style="x"><char style="xo" closed="false">१:६ </char><char style="xt" closed="false"><ref loc="2SA 12:24">२ शमूएल १२:२४</ref></char></note>अऊर यिशै सी दाऊद राजा। अऊर दाऊद सी सुलैमान वा बाई सी पैदा भयो जो पहिले उरिय्याह की पत्नी होती, <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />सुलैमान सी रहबाम पैदा भयो, रहबाम सी अबिय्याह, अऊर अबिय्याह सी आसा, <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />आसा सी यहोशाफात, यहोशाफात सी योराम, अऊर योराम सी उज्जियाह पैदा भयो, <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />अऊर उज्जियाह सी योताम, योताम सी आहाज, अऊर आहाज सी हिजकिय्याह, <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />हिजकिय्याह सी मनश्शिह, मनश्शिह सी आमोन, अऊर आमोन सी योशिय्याह पैदा भयो, <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />अऊर बन्दी होय क बेबीलोन जान को समय म योशिय्याह सी यकुन्याह, अऊर ओको भाऊ पैदा भयो।<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />बन्दी बेबीलोन पहुंचाय जान को बाद यकुन्याह सी शालतिएल पैदा भयो, अऊर शालतिएल सी जरुब्बाबिल, <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />अऊर जरुब्बाबिल सी अबीहूद, अबीहूद सी इल्याकीम, अऊर इल्याकीम सी अजोर, <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />अऊर अजोर सी सदोक, सदोक सी अखीम, अऊर अखीम सी इलीहूद, <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />इलीहूद सी इलियाजार, इलियाजार सी मत्तान, अऊर मत्तान सी याकूब, <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />याकूब सी यूसुफ पैदा भयो, जो मरियम को पति होतो, अऊर मरियम सी यीशु पैदा भयो, जो मसीह कहलावय हय।<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />यो तरह अब्राहम सी दाऊद तक चौदा पीढ़ी भयी, अऊर दाऊद को समय सी बेबीलोन ख बन्दी होय क पहुंचायो जानो तक चौदा पीढ़ी भयी, अऊर बन्दी होय क बेबीलोन ख पहुंचायो जानो को समय सी मसीह तक चौदा पीढ़ी भयी।<verse eid="MAT 1:17" /></para>
  <para style="s">यीशु को जनम</para>
  <para style="r">(<ref loc="LUK 1:26-38">लूका १:२६-३८</ref>; <ref loc="LUK 2:1-7">२:१-७</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१८ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:27">लूका १:२७</ref>
      </char>
    </note>यीशु मसीह को जनम यो तरह सी भयो, कि जब ओकी माय मरियम की मंगनी यूसुफ को संग भय गयी, त उन्को एक तन होन सी पहिलेच वा पवित्र आत्मा को तरफ सी गर्भवती पायी गयी। <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />येकोलायी ओको पति यूसुफ न जो सच्चो होन को वजह ओख बदनाम नहीं करन की इच्छा सी चुपचाप सी ओख छोड़ देन को बिचार करयो। <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />जब ऊ यो बातों ख सोच रह्यो होतो त प्रभु को स्वर्गदूत ओख सपनो म दिखायी दे क कहन लग्यो, “हे यूसुफ! दाऊद की सन्तान, तय मरियम ख अपनी पत्नी बनानो सी मत डर, कहालीकि जो ओको गर्भ म हय, ऊ पवित्र आत्मा को तरफ सी हय। <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" /><note caller="+" style="x"><char style="xo" closed="false">१:२१ </char><char style="xt" closed="false"><ref loc="LUK 1:31">लूका १:३१</ref></char></note>वा बेटा ख जनम देयेंन अऊर तय ओको नाम यीशु रखजो, कहालीकि ऊ अपनो लोगों ख उन्को पापों सी बचायेंन।”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:२२ </char>
      <char style="xt" closed="false">
        <ref loc="ISA 7:14">यशायाह ७:१४</ref>
      </char>
    </note>यो पूरो येकोलायी भयो कि जो वचन प्रभु न भविष्यवक्ता को द्वारा कह्यो होतो, ऊ पूरो हो: <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />“देखो, एक कुंवारी गर्भवती होयेंन अऊर एक बेटा ख जनम देयेंन, अऊर ओको नाम इम्मानुएल रख्यो जायेंन,” जेको मतलब हय “परमेश्वर हमरो संग।”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />तब यूसुफ नींद सी जाग क प्रभु को स्वर्गदूत को आज्ञानुसार ओख अपनो घर बिहाव कर क् लायो; <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" /><note caller="+" style="x"><char style="xo" closed="false">१:२५ </char><char style="xt" closed="false"><ref loc="LUK 2:21">लूका २:२१</ref></char></note>अऊर मरियम को जवर तब तक नहीं गयो जब तक ओन बेटा ख जनम नहीं दियो। अऊर यूसुफ न ओको नाम यीशु रख्यो।<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">पूर्व दिशा को मेहमान ख यीशु सी मिलनो</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />हेरोदेस राजा को दिनो म जब यहूदिया प्रदेश को बैतलहम गांव म यीशु को जनम भयो, त पूर्व दिशा सी कुछ जोतिषी यरूशलेम म आय क पूछन लग्यो, <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />“यहूदियों को राजा जेको जनम भयो हय, कित हय? कहालीकि हम्न पूर्व दिशा म ओको तारा देख्यो हय अऊर ओख दण्डवत प्रनाम करन आयो हंय।”<verse eid="MAT 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 2:3" />राजा हेरोदेस न यो सुन्यो त ऊ अऊर ओको संग पूरो यरूशलेम घबराय गयो। <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />तब ओन लोगों को पूरो मुख्य याजकों अऊर धर्मशास्त्रियों ख जमा कर क् उन्को सी पुच्छ्यो, “मसीह को जनम कित होनो चाहिये?”<verse eid="MAT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 2:5" />उन्न ओको सी कह्यो, “यहूदिया प्रदेश को बैतलहम गांव म, कहालीकि भविष्यवक्ता को द्वारा असो लिख्यो गयो हय:<verse eid="MAT 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 2:6" />“हे बैतलहम गांव, तय जो यहूदा को प्रदेश म हय,</para>
  <para style="q2" vid="MAT 2:6">तय यहूदा को अधिकारियों म कोयी सी छोटो नहाय,</para>
  <para style="q1" vid="MAT 2:6">कहालीकि तोरो म सी एक शासक निकलेंन</para>
  <para style="q2" vid="MAT 2:6">जो मोरी प्रजा इस्राएल को रखवाली करेंन।”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />तब हेरोदेस न जोतिषियों ख चुपचाप सी बुलाय क उन्को सी पुच्छ्यो कि तारा ठीक कौन्सो समय दिखायी दियो होतो, <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />अऊर यो कह्य क उन्ख बैतलहम भेज्यो, “जावो, ऊ बालक को बारे म ठीक-ठीक मालूम करो, अऊर जब ऊ मिल जायेंन त मोख खबर देवो ताकि मय भी आय क ओख प्रनाम करूं।”<verse eid="MAT 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 2:9" />हि राजा की बात सुन क चली गयो, अऊर जो उच तारा उन्न पूर्व दिशा म देख्यो होतो ऊ उन्को आगु आगु चलन लग्यो; अऊर जित बच्चा होतो, ऊ जागा को ऊपर पहुंच क रूक गयो।<verse eid="MAT 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 2:10" />ऊ तारा ख देख क हि बहुत खुश भयो। <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />जोतिषियों न ऊ घर म जाय क ऊ बच्चा ख ओकी माय मरियम को संग देख्यो, अऊर झुक क बच्चा ख नमस्कार करयो, अऊर अपनो-अपनो झोली खोल क ओख सोना, लुबान, अऊर गन्धरस की भेंट चढ़ायो। <figure style="fig" alt="Frankincense branch, censer and incense altar" file="bk00116c.tif" size="col" copy="Horace Knowles ©" ref="२:११">लुभान, धूप दानी अऊर धूप वेदी</figure><verse eid="MAT 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 2:12" />तब सपनो म परमेश्वर सी या चेतावनी पा क कि राजा हेरोदेस को जवर फिर नहीं लौटजो, हि दूसरी रस्ता सी अपनो देश ख चली गयो।<verse eid="MAT 2:12" /></para>
  <para style="s">मिस्र देश ख भग जानो</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />जब हि चली गयो त, प्रभु को एक दूत न सपनो म यूसुफ ख दिखायी दे क कह्यो, “उठ, ऊ बच्चा ख अऊर ओकी माय ख ले क मिस्र देश ख निकल जा; अऊर जब तक मय तोरो सी नहीं कहूं, तब तक उतच रहजो; कहालीकि हेरोदेस राजा यो बच्चा ख ढूंढन पर हय कि ओख मरवाय डाले।”<verse eid="MAT 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 2:14" />तब ऊ रात मच उठ क बच्चा अऊर ओकी माय ख ले क मिस्र ख चली गयो, <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" /><note caller="+" style="x"><char style="xo" closed="false">२:१५ </char><char style="xt" closed="false"><ref loc="HOS 11:1">होशे ११:१</ref></char></note>अऊर हेरोदेस को मरन तक उतच रह्यो। येकोलायी कि ऊ वचन जो प्रभु न भविष्यवक्ता को द्वारा कह्यो होतो पूरो भयो: “मय न अपनो बेटा ख मिस्र सी बुलायो।”<verse eid="MAT 2:15" /></para>
  <para style="s">बच्चां ख मार डालनो</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />जब हेरोदेस न यो देख्यो, कि जोतिषियों न ओको संग धोका करयो हय, तब ऊ गुस्सा सी भर गयो, अऊर लोगों ख भेज क जोतिषियों सी ठीक-ठीक बतायो गयो समय को अनुसार बैतलहम अऊर ओको आजु-बाजू की जागा को सब बच्चां ख जो दोय साल को यां ओको सी छोटो होतो, मरवाय डाल्यो।<verse eid="MAT 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 2:17" />तब जो वचन यिर्मयाह भविष्यवक्ता को द्वारा कह्यो गयो होतो, ऊ पूरो भयो:<verse eid="MAT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 2:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१८ </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:15">यिर्मयाह ३१:१५</ref>
      </char>
    </note>“रामाह गांव म एक दु:ख भरी आवाज सुनायी दियो,</para>
  <para style="q2" vid="MAT 2:18">रोवनो अऊर बड़ो विलाप;</para>
  <para style="q1" vid="MAT 2:18">राहेल अपनो बच्चां लायी रोवत होती,</para>
  <para style="q2" vid="MAT 2:18">अऊर चुप होनो नहीं चाहत होती, कहालीकि ओको त पूरो बच्चां</para>
  <para style="q2" vid="MAT 2:18">मर गयो होतो।”<verse eid="MAT 2:18" /></para>
  <para style="s">मिस्र देश सी लौटनो</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />हेरोदेस को मरन को बाद, प्रभु को दूत न मिस्र म यूसुफ ख सपनो म दर्शन दे क कह्यो, <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />“उठ, बच्चा अऊर ओकी माय ख ले क इस्राएल को देश म चली जा, कहालीकि जो बच्चा को जीव लेनो चाहावत होतो, हि मर गयो हंय।” <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />ऊ उठ्यो, अऊर बच्चा अऊर ओकी माय ख संग ले क इस्राएल को देश म आयो।<verse eid="MAT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 2:22" />पर यो सुन क कि अरखिलाउस अपनो बाप हेरोदेस की जागा पर यहूदिया पर राज्य कर रह्यो हय, उत जानो सी डरयो। फिर सपनो म परमेश्वर सी सुचना पा क गलील प्रदेश म चली गयो, <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" /><note caller="+" style="x"><char style="xo" closed="false">२:२३ </char><char style="xt" closed="false"><ref loc="MRK 1:24">मरकुस १:२४</ref>; <ref loc="LUK 2:39">लूका २:३९</ref>; <ref loc="JHN 1:45">यूहन्ना १:४५</ref></char></note>अऊर नासरत नाम को एक नगर म जाय बसयो, ताकि ऊ वचन पूरो होय, जो भविष्यवक्तावों सी कह्यो गयो होतो : “ऊ नासरी कहलायेंन।”<verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">बपतिस्मा देन वालो यूहन्ना को उपदेश</para>
  <para style="r">(<ref loc="MRK 1:1-8">मरकुस १:१-८</ref>; <ref loc="LUK 3:1-18">लूका ३:१-१८</ref>; <ref loc="JHN 1:19-28">यूहन्ना १:१९-२८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />उन दिनो म यूहन्ना बपतिस्मा देन वालो यहूदिया को सुनसान जागा म आय क यो प्रचार करन लग्यो: <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" /><note caller="+" style="x"><char style="xo" closed="false">३:२ </char><char style="xt" closed="false"><ref loc="MAT 4:17">मत्ती ४:१७</ref>; <ref loc="MRK 1:15">मरकुस १:१५</ref></char></note>“पापों सी मन फिरावो, कहालीकि स्वर्ग को राज्य जवर आय गयो हय।” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" /><note caller="+" style="x"><char style="xo" closed="false">३:३ </char><char style="xt" closed="false"><ref loc="ISA 40:3">यशायाह ४०:३</ref></char></note>यो उच आय जेकी चर्चा यशायाह भविष्यवक्ता को द्वारा करी गयी:</para>
  <para style="q1" vid="MAT 3:3">“जंगल म एक पुकारन वालो को आवाज होय रह्यो</para>
  <para style="q2" vid="MAT 3:3">हय, कि प्रभु को रस्ता तैयार करो,</para>
  <para style="q2" vid="MAT 3:3">अऊर ओकी सड़के सीधी करो।”<verse eid="MAT 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 3:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:४ </char>
      <char style="xt" closed="false">
        <ref loc="2KI 1:8">२ राजा १:८</ref>
      </char>
    </note>यूहन्ना ऊंट को बाल को कपड़ा पहिन्यो होतो अऊर कमर म चमड़ा को पट्टा बान्ध्यो हुयो होतो। ओको जेवन टिड्डियां अऊर जंगली शहेद होतो। <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />तब यरूशलेम, अऊर पूरो यहूदिया क्षेत्र, अऊर यरदन को आजु-बाजू को गांव म रहन वालो सब लोग निकल क ओको जवर आयो, <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />उन्न अपनो अपनो पापों को पश्चाताप कर क् यरदन नदी म ओको सी बपतिस्मा लियो।<verse eid="MAT 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 3:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:७ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:34">मत्ती १२:३४</ref>; <ref loc="MAT 23:33">२३:३३</ref></char>
    </note>पर जब ओन अपनो जवर बहुत सो फरीसियों अऊर सदूकियों ख बपतिस्मा लेन लायी आवतो देख्यो, त ओन कह्यो, “हे सांप को पिल्ला, तुम्ख कौन न जताय दियो कि आवन वालो गुस्सा सी भगो? <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />येकोलायी पापों सी मन फिराव की लायक फर लावो; <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" /><note caller="+" style="x"><char style="xo" closed="false">३:९ </char><char style="xt" closed="false"><ref loc="JHN 8:33">यूहन्ना ८:३३</ref></char></note>अऊर अपनो अपनो मन म यो मत सोचो कि हमरो बाप अब्राहम आय; कहालीकि मय तुम सी सच कहू हय कि परमेश्वर इन गोटा सी अब्राहम लायी सन्तान पैदा कर सकय हय।” <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" /><note caller="+" style="x"><char style="xo" closed="false">३:१० </char><char style="xt" closed="false"><ref loc="MAT 7:19">मत्ती ७:१९</ref></char></note>टंग्या झाड़ों की जड़ी पर रखी हुयी हय, येकोलायी जो जो झाड़ अच्छो फर नहीं लावय, ऊ काट्यो अऊर आगी म झोक्यो जावय हय। <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />“मय त पानी सी तुम्ख मन फिराव को बपतिस्मा देऊ हय; पर जो मोरो बाद आवन वालो हय; ऊ मोरो सी ताकतवर हय; कि मय ओको पाय कि चप्पल उठावन को लायक नहाय। ऊ तुम्ख पवित्र आत्मा अऊर आगी सी बपतिस्मा देयेंन। <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />ओको सूपा ओको हाथ म हय, अऊर ऊ अपनो खरियान अच्छो तरह सी साफ करेंन, अऊर अपनो गहूं ख त ढोला म जमा करेंन, पर भूसा ख ऊ आगी म जलायेंन जो बुझन की नहीं।”<verse eid="MAT 3:12" /></para>
  <para style="s">यीशु को बपतिस्मा</para>
  <para style="r">(<ref loc="MRK 1:9-11">मरकुस १:९-११</ref>; <ref loc="LUK 3:21-22">लूका ३:२१-२२</ref>; <ref loc="JHN 1:31-34">यूहन्ना १:३१-३४</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />ऊ समय यीशु गलील प्रदेश सी यरदन नदी को किनार पर यूहन्ना को जवर ओको सी बपतिस्मा लेन आयो। <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />पर यूहन्ना यो कह्य क ओख रोकन लग्यो, “मोख त तोरो हाथ सी बपतिस्मा लेन कि जरूरत हय, अऊर तय मोरो जवर आयो हय?”<verse eid="MAT 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 3:15" />पर यीशु न ओख यो उत्तर दियो, “अब त असोच होन दे, कहालीकि हम्ख यो रीति सी सब सच्चायी ख पूरो करनो ठीक हय।” तब ओन ओकी बात मान ली।<verse eid="MAT 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 3:16" />अऊर यीशु बपतिस्मा ले क तुरतच पानी सी ऊपर आयो, अऊर उच समय ओको लायी स्वर्ग खुल गयो, अऊर ओन परमेश्वर को आत्मा ख कबूत्तर को जसो उतरतो अऊर अपनो ऊपर आवतो देख्यो। <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" /><note caller="+" style="x"><char style="xo" closed="false">३:१७ </char><char style="xt" closed="false"><ref loc="MAT 12:18">मत्ती १२:१८</ref>; <ref loc="MAT 17:5">१७:५</ref>; <ref loc="MRK 1:11">मरकुस १:११</ref>; <ref loc="LUK 9:35">लूका ९:३५</ref></char></note>अऊर, स्वर्ग सी या आकाशवानी भयी: “यो मोरो प्रिय बेटा आय, जेकोसी मय बहुत सन्तुष्ट हय।”<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">यीशु की परीक्षा</para>
  <para style="r">(<ref loc="MRK 1:12-13">मरकुस १:१२-१३</ref>; <ref loc="LUK 4:1-13">लूका ४:१-१३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१ </char>
      <char style="xt" closed="false">
        <ref loc="HEB 2:18">इब्रानियों २:१८</ref>; <ref loc="HEB 4:15">४:१५</ref></char>
    </note>तब आत्मा यीशु ख सुनसान जागा म ले गयो ताकि शैतान सी ओकी परीक्षा हो। <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />जब ऊ चालीस दिन अऊर चालीस रात उपवास कर लियो, तब ओख बहुत भूख लगी। <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />तब शैतान न जवर आय क ओको सी कह्यो, “यदि तय परमेश्वर को बेटा आय, त कह्य दे, कि यो गोटा रोटी बन जाये।”<verse eid="MAT 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 4:4" />यीशु न उत्तर दियो: “यो शास्त्र म लिख्यो हय, ‘आदमी केवल रोटीच सी नहीं, पर हर एक वचन सी जो परमेश्वर को मुंह सी निकलय हय, जीन्दो रहेंन।’”<verse eid="MAT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 4:5" />तब शैतान ओख पवित्र नगर यरूशलेम म ले गयो अऊर मन्दिर को ऊचाई पर खड़ो करयो, <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" /><note caller="+" style="x"><char style="xo" closed="false">४:६ </char><char style="xt" closed="false"><ref loc="PSA 91:11-12">भजन ९१:११-१२</ref></char></note>अऊर ओको सी कह्यो, “यदि तय परमेश्वर को बेटा आय, त अपनो आप ख खल्लो गिराय दे; कहालीकि शास्त्र म लिख्यो हय; ‘ऊ तोरो बारे म अपनो स्वर्गदूतों ख आज्ञा देयेंन, अऊर हि तोख हाथों-हाथ उठाय लेयेंन; कहीं असो नहीं होय कि तोरो पाय म गोटा सी ठेस लग जाये।’”<verse eid="MAT 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 4:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:७ </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:16">व्यवस्थाविवरन ६:१६</ref>
      </char>
    </note>यीशु न ओको सी कह्यो, “नियम शास्त्र म यो भी लिख्यो हय: ‘तय प्रभु अपनो परमेश्वर की परीक्षा नहीं करजो।’”<verse eid="MAT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 4:8" />तब शैतान ओख एक बहुत ऊचो पहाड़ी पर ले गयो अऊर सारो जगत को राज्य अऊर ओको वैभव दिखाय क <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />ओको सी कह्यो, “यदि तय झुक क मोख दण्डवत प्रनाम करजो, त मय यो सब कुछ तोख दे देऊं।”<verse eid="MAT 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 4:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१० </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:13">व्यवस्थाविवरन ६:१३</ref>
      </char>
    </note>तब यीशु न ओको सी कह्यो, “हे शैतान दूर होय जा, कहालीकि शास्त्र म लिख्यो हय: ‘तय प्रभु अपनो परमेश्वर ख प्रनाम कर, अऊर केवल ओकीच सेवा कर।’”<verse eid="MAT 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 4:11" />तब शैतान ओको जवर सी चली गयो, अऊर देखो, स्वर्गदूत आय क ओकी सेवा करन लग्यो।<verse eid="MAT 4:11" /></para>
  <para style="s">यीशु की सेवकायी की सुरूवात</para>
  <para style="r">(<ref loc="MRK 1:14">मरकुस १:१४</ref>,<ref loc="MRK 1:15">१५</ref>; <ref loc="LUK 4:14">लूका ४:१४</ref>,<ref loc="LUK 4:15">१५</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१२ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:3">मत्ती १४:३</ref>; <ref loc="MRK 6:17">मरकुस ६:१७</ref>; <ref loc="LUK 3:19">लूका ३:१९</ref>,<ref loc="LUK 3:20">२०</ref></char>
    </note>जब यीशु न यो सुन्यो कि यूहन्ना बन्दी बनाय लियो गयो हय, त ऊ गलील ख चली गयो। <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" /><note caller="+" style="x"><char style="xo" closed="false">४:१३ </char><char style="xt" closed="false"><ref loc="JHN 2:12">यूहन्ना २:१२</ref></char></note>अऊर ऊ नासरत नगर ख छोड़ क कफरनहूम नगर म, जो झील को किनार जबूलून अऊर नप्ताली को देश म हय, जाय क रहन लग्यो; <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />ताकि जो यशायाह भविष्यवक्ता को द्वारा कह्यो गयो होतो, ऊ पूरो हो:<verse eid="MAT 4:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 4:15" />झील को रस्ता सी “जबूलून अऊर नप्ताली को देश, यरदन को पार,</para>
  <para style="q2" vid="MAT 4:15">गैरयहूदियों को गलील<verse eid="MAT 4:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="MAT 4:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१६ </char>
      <char style="xt" closed="false">
        <ref loc="ISA 9:1-2">यशायाह ९:१-२</ref>
      </char>
    </note>जो लोग अन्धारो म बैठ्यो होतो,</para>
  <para style="q2" vid="MAT 4:16">उन्न बड़ी ज्योति देखी;</para>
  <para style="q1" vid="MAT 4:16">अऊर जो मृत्यु को देश म बैठ्यो होतो,</para>
  <para style="q2" vid="MAT 4:16">उन पर ज्योति चमकी।”<verse eid="MAT 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 4:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१७ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:2">मत्ती ३:२</ref>
      </char>
    </note>ऊ समय सी यीशु न प्रचार करनो अऊर यो कहनो सुरू करयो, “पापों सी मन फिरावो कहालीकि स्वर्ग को राज्य जवर आय गयो हय।”<verse eid="MAT 4:17" /></para>
  <para style="s">यीशु को चारयी मछवारों ख बुलावनो</para>
  <para style="r">(<ref loc="MRK 1:16-20">मरकुस १:१६-२०</ref>; <ref loc="LUK 5:1-11">लूका ५:१-११</ref>; <ref loc="JHN 1:35-42">यूहन्ना १:३५-४२</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />गलील की झील को किनार फिरतो हुयो यीशु न दोय भाऊवों यानेकि शिमोन ख जो पतरस कहलावय हय, अऊर ओको भाऊ अन्द्रियास ख झील म जार डालतो हुयो देख्यो; कहालीकि हि मछवारा होतो। <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />यीशु न उन सी कह्यो, “मोरो पीछू चली आवो, त मय तुम्ख लोगों ख परमेश्वर को राज्य म लावन लायी सिखाऊं।” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />हि तुरतच जार ख छोड़ क ओको पीछू भय गयो।<verse eid="MAT 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 4:21" />उत सी आगु जाय क, यीशु न अऊर दोय भाऊवों ख यानेकि जब्दी को बेटा याकूब अऊर ओको भाऊ यूहन्ना ख देख्यो। हि अपनो बाप जब्दी को संग डोंगा पर अपनो जारो ख सुधारत होतो। ओन उन्ख भी बुलायो। <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />हि तुरतच डोंगा अऊर अपनो बाप ख छोड़ क ओको पीछू भय गयो।<verse eid="MAT 4:22" /></para>
  <para style="s">यीशु को रोगियों ख चंगो करनों,</para>
  <para style="r">(<ref loc="LUK 6:17-19">लूका ६:१७-१९</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:२३ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:35">मत्ती ९:३५</ref>; <ref loc="MRK 1:39">मरकुस १:३९</ref></char>
    </note>यीशु पूरो गलील म फिरतो हुयो उन्को यहूदियों को सभागृह म शिक्षा करतो, अऊर राज्य को सुसमाचार प्रचार करतो, अऊर लोगों की हर तरह की बीमारियों को चंगो करयो अऊर कमजोरी ख दूर करयो। <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />अऊर पूरो सीरिया देश म ओको यश फैल गयो; अऊर लोग सब बीमारों ख जो अलग अलग तरह की बीमारियों अऊर दु:खों म जकड़्यो हुयो होतो, अऊर जेको म दुष्ट आत्मायें होती, अऊर मिर्गी वालो अऊर लकवा को रोगियों ख, ओको जवर लायो अऊर ओन पूरो ख चंगो करयो। <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />गलील अऊर दिकापुलिस, यरूशलेम, यहूदिया, अऊर यरदन नदी को ओन पार सी भीड़ की भीड़ ओको पीछू चली गयी।<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">यीशु को पहाड़ी उपदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />ऊ यो भीड़ ख देख क पहाड़ी पर चढ़ गयो, अऊर जब बैठ गयो त ओको चेलां ओको जवर आयो। <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />अऊर ऊ अपनो मुंह खोल क उन्ख यो उपदेश देन लग्यो।<verse eid="MAT 5:2" /></para>
  <para style="s">धन्य वचन</para>
  <para style="r">(<ref loc="LUK 6:20-23">लूका ६:२०-२३</ref>)</para>
  <para style="q1">
    <verse number="3" style="v" sid="MAT 5:3" />“धन्य हंय हि, जो मन को नरम हय,</para>
  <para style="q2" vid="MAT 5:3">कहालीकि स्वर्ग को राज्य उन्कोच हय।”<verse eid="MAT 5:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="MAT 5:4" />“धन्य हंय हि, जो शोक करय हय,</para>
  <para style="q2" vid="MAT 5:4">कहालीकि हि समाधान पायेंन।”<verse eid="MAT 5:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 5:5" />“धन्य हंय हि, जो नम्र हंय,</para>
  <para style="q2" vid="MAT 5:5">कहालीकि हि धरती को वारीसदार होयेंन।”<verse eid="MAT 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="MAT 5:6" />“धन्य हंय हि, जो सच्चायी को भूखो अऊर प्यासो हंय,</para>
  <para style="q2" vid="MAT 5:6">कहालीकि हि सन्तुष्ट करयो जायेंन।”<verse eid="MAT 5:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MAT 5:7" />“धन्य हंय हि, जो दयालु हंय,</para>
  <para style="q2" vid="MAT 5:7">कहालीकि उन पर दया करयो जायेंन।”<verse eid="MAT 5:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 5:8" />“धन्य हंय हि, जिन को मन शुद्ध हंय,</para>
  <para style="q2" vid="MAT 5:8">कहालीकि हि परमेश्वर ख देखेंन।”<verse eid="MAT 5:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 5:9" />“धन्य हंय हि, जो मिलाप करावन वालो हंय,</para>
  <para style="q2" vid="MAT 5:9">कहालीकि हि परमेश्वर को बच्चां कहलायेंन।”<verse eid="MAT 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 5:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:१० </char>
      <char style="xt" closed="false">
        <ref loc="1PE 3:14">१ पतरस ३:१४</ref>
      </char>
    </note>“धन्य हंय हि, जो सच्चायी को वजह सतायो जावय हंय,</para>
  <para style="q2" vid="MAT 5:10">कहालीकि स्वर्ग को राज्य उन्कोच आय।”<verse eid="MAT 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 5:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:११ </char>
      <char style="xt" closed="false">
        <ref loc="1PE 4:14">१ पतरस ४:१४</ref>
      </char>
    </note>“धन्य हय तुम, जब आदमी मोरो वजह तुम्हरी निन्दा करेंन, अऊर सतायो अऊर झूठ बोल बोल क तुम्हरो विरोध म सब तरह की बुरी बात कहेंन। <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" /><note caller="+" style="x"><char style="xo" closed="false">५:१२ </char><char style="xt" closed="false"><ref loc="ACT 7:52">प्रेरितों ७:५२</ref></char></note>तब खुश अऊर मगन होजो, कहालीकि तुम्हरो लायी स्वर्ग म बड़ो प्रतिफल हय। येकोलायी कि उन्न उन भविष्यवक्तावों ख जो तुम सी पहिलो होतो योच रीति सी सतायो होतो।”<verse eid="MAT 5:12" /></para>
  <para style="s">नमक अऊर ज्योति</para>
  <para style="r">(<ref loc="MRK 9:50">मरकुस ९:५०</ref>; <ref loc="LUK 14:34">लूका १४:३४</ref>,<ref loc="LUK 14:35">३५</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:१३ </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:50">मरकुस ९:५०</ref>; <ref loc="LUK 14:34">लूका १४:३४</ref>,<ref loc="LUK 14:35">३५</ref></char>
    </note>“तुम धरती को नमक आय; पर यदि नमक को स्वाद बिगड़ जायेंन, त ऊ फिर कौन्सी चिज सी नमकीन करयो जायेंन? तब ऊ कोयी काम को नहाय, केवल येको कि बाहेर फेक्यो जाये अऊर लोगों को पाय को खल्लो खुंद्यो जाये।”<verse eid="MAT 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 5:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:१४ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 8:12">यूहन्ना ८:१२</ref>; <ref loc="JHN 9:5">९:५</ref></char>
    </note>“तुम जगत की ज्योति आय। जो नगर पहाड़ी पर बस्यो हुयो हय ऊ लुक नहीं सकय। <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" /><note caller="+" style="x"><char style="xo" closed="false">५:१५ </char><char style="xt" closed="false"><ref loc="MRK 4:21">मरकुस ४:२१</ref>; <ref loc="LUK 8:16">लूका ८:१६</ref>; <ref loc="LUK 11:33">११:३३</ref></char></note>अऊर लोग दीया जलाय क बर्तन को खल्लो नहीं पर दीवाल पर प्रकाश देन की जागा पर रखय हंय, तब ओको सी घर को सब लोगों ख प्रकाश पहुंचय हय। <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" /><note caller="+" style="x"><char style="xo" closed="false">५:१६ </char><char style="xt" closed="false"><ref loc="1PE 2:12">१ पतरस २:१२</ref></char></note>उच तरह तुम्हरो प्रकाश लोगों को आगु चमके कि हि तुम्हरो भलायी को कामों ख देख क तुम्हरो बाप की, जो स्वर्ग म हय, बड़ायी करे।”<verse eid="MAT 5:16" /></para>
  <para style="s">व्यवस्था की शिक्षा</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />“यो मत समझो, कि मय व्यवस्था यां भविष्यवक्तावों की किताबों ख खतम करन लायी आयो हय, खतम करन लायी नहीं, पर पूरो करन आयो हय। <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" /><note caller="+" style="x"><char style="xo" closed="false">५:१८ </char><char style="xt" closed="false"><ref loc="LUK 16:17">लूका १६:१७</ref></char></note>कहालीकि मय तुम सी सच कहूं हय, कि जब तक आसमान अऊर धरती टल नहीं जाये, तब तक व्यवस्था सी एक मात्रा यां बिन्दु भी बिना पूरो हुयो नहीं टलेंन।<note caller="+" style="f"><char style="fr" closed="false">५:१८ </char><char style="ft" closed="false">सभी चिजों को अन्त यां येको सभी उपदेश सच हंय।</char></note> <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />येकोलायी जो कोयी इन छोटी सी छोटी आज्ञावों म सी कोयी एक ख तोड़े, अऊर वसोच लोगों ख सिखायेंन, ऊ स्वर्ग को राज्य म सब सी छोटो कहलायेंन; पर जो कोयी उन आज्ञावों को पालन करेंन अऊर उन्ख सिखायेंन, उच स्वर्ग को राज्य म महान कहलायेंन। <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />कहालीकि मय तुम सी कहूं हय, कि यदि तुम्हरी सच्चायी धर्मशास्त्रियों अऊर फरीसियों की सच्चायी सी बढ़ क नहाय, त तुम स्वर्ग को राज्य म कभी सिरनो नहीं पावों।”<verse eid="MAT 5:20" /></para>
  <para style="s">गुस्सा अऊर हत्या</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />“तुम्न सुन लियो हय, कि पूर्वजों सी कह्यो गयो होतो कि ‘हत्या नहीं करनो,’ अऊर जो कोयी हत्या करेंन ऊ कचहरी म सजा को लायक जायेंन। <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />पर मय तुम सी यो कहूं हय, कि जो कोयी अपनो भाऊ पर गुस्सा करेंन, ऊ कचहरी म सजा को लायक होयेंन, अऊर जो कोयी अपनो भाऊ ख निकम्मा कहेंन ऊ महासभा म सजा को लायक होयेंन; अऊर जो कोयी कहेंन ‘अरे मूर्ख’ ऊ नरक की आगी को सजा को लायक होयेंन।”<verse eid="MAT 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 5:23" />“येकोलायी यदि तय अपनी भेंट अर्पन की वेदी पर लावय, अऊर उत तोख याद आवय, कि तोरो भाऊ को मन म तोरो लायी कुछ विरोध हय, <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />त अपनी भेंट उत वेदी को आगु छोड़ दे, अऊर जाय क पहिले अपनो भाऊ सी मेल मीलाप कर अऊर तब आय क अपनी भेंट चढ़ाव।”<verse eid="MAT 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 5:25" />“जब तक तय आरोप लगान वालो को संग रस्ता म हय, ओको सी मेल मीलाप कर लेवो कहीं असो नहीं होय कि आरोप लगान वालो तोख न्यायधीश ख सौंप देयेंन, अऊर न्यायधीश तोख सिपाही ख सौंप देयेंन, अऊर तोख जेलखाना म डाल दियो जाये। <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />मय तोरो सी सच कहू हय कि जब तक तय पूरो दाम नहीं भर देजो तब तक उत सी छूटनो नहीं पायजो।”<verse eid="MAT 5:26" /></para>
  <para style="s">व्यभिचार को विषय म शिक्षा</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />“तुम सुन चुक्यो हय कि कह्यो गयो होतो, ‘व्यभिचार मत करो।’ <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />पर मय तुम सी यो कहूं हय, कि जो भी कोयी बाई पर बुरी नजर डालेंन ऊ अपनो मन म ओको सी व्यभिचार कर चुक्यो रहेंन। <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" /><note caller="+" style="x"><char style="xo" closed="false">५:२९ </char><char style="xt" closed="false"><ref loc="MAT 18:9">मत्ती १८:९</ref>; <ref loc="MRK 9:47">मरकुस ९:४७</ref></char></note>यदि तोरी दायो आंखी तोख ठोकर खिलावय, त ओख निकाल क फेक दे; कहालीकि तोरो लायी योच ठीक हय कि तोरो शरीर म सी एक अंग नाश होय जायेंन पर तोरो पूरो शरीर नरक म नहीं डाल्यो जायेंन। <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" /><note caller="+" style="x"><char style="xo" closed="false">५:३० </char><char style="xt" closed="false"><ref loc="MAT 18:8">मत्ती १८:८</ref>; <ref loc="MRK 9:43">मरकुस ९:४३</ref></char></note>यदि तोरो दायो हाथ तोरो सी पाप करवावय, त ओख काट क फेक दे; कहालीकि तोरो लायी योच ठीक हय कि तोरो शरीर म सी एक अंग नाश होय जाय पर तोरो पूरो शरीर नरक म नहीं डाल्यो जाय।”<verse eid="MAT 5:30" /></para>
  <para style="s">छोड़चिट्ठी</para>
  <para style="r">(<ref loc="MAT 19:9">मत्ती १९:९</ref>; <ref loc="MRK 10:11">मरकुस १०:११</ref>,<ref loc="MRK 10:12">१२</ref>; <ref loc="LUK 16:18">लूका १६:१८</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:३१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:7">मत्ती १९:७</ref>; <ref loc="MRK 10:4">मरकुस १०:४</ref>; <ref loc="MRK 5:31">५:३१</ref> </char>
      <char style="xt" closed="false">
        <ref loc="DEU 24:1-14">व्यवस्थाविवरन २४:१-१४</ref>
      </char>
    </note>“यो भी कह्यो गयो होतो, ‘जो कोयी अपनी पत्नी ख छोड़ देनो चाहवय, त ओख छोड़चिट्ठी दे।’ <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" /><note caller="+" style="x"><char style="xo" closed="false">५:३२ </char><char style="xt" closed="false"><ref loc="MAT 19:9">मत्ती १९:९</ref>; <ref loc="MRK 10:11">मरकुस १०:११</ref>,<ref loc="MRK 10:12">१२</ref>; <ref loc="LUK 16:18">लूका १६:१८</ref>; <ref loc="1CO 7:10">१ कुरिन्थियों ७:१०</ref>,<ref loc="1CO 7:11">११</ref></char></note>पर मय तुम सी यो कहू हय कि जो कोयी अपनी पत्नी ख व्यभिचार को अलावा कोयी अऊर वजह सी छोड़ दे, त ऊ ओको सी व्यभिचार करावय हय; अऊर जो कोयी वा छोड़ी हुयी सी बिहाव करे, ऊ व्यभिचार करय हय।”<verse eid="MAT 5:32" /></para>
  <para style="s">कसम को बारे म शिक्षा</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“तब तुम सुन चुक्यो हय कि पुरानो समय को लोगों सी कह्यो गयो होतो, ‘झूठी कसम मत खाजो, पर प्रभु को लायी अपनी कसम ख पूरी करजो।’ <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" /><note caller="+" style="x"><char style="xo" closed="false">५:३४ </char><char style="xt" closed="false"><ref loc="JAS 5:12">याकूब ५:१२</ref>; </char><char style="xt" closed="false"><ref loc="MAT 23:22">मत्ती २३:२२</ref></char></note>पर मय तुम सी यो कहू हय कि कभी कसम मत खावो; न त स्वर्ग की, कहालीकि ऊ परमेश्वर को सिंहासन हय; <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />नहीं धरती की, कहालीकि ऊ ओको पाय को खल्लो की चौकी आय; नहीं यरूशलेम की, कहालीकि ऊ महाराजा को नगर आय। <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />अपनो मुंड की भी कसम मत खाजो कहालीकि तय एक बाल ख भी नहीं सफेद, नहीं कारो कर सकय हय। <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />पर तुम्हरी बात ‘हव’ की ‘हव’ यां ‘नहीं’ की ‘नहीं’ हो; कहालीकि जो कोयी येको सी जादा होवय हय ऊ बुरायी सी होवय हय।”<verse eid="MAT 5:37" /></para>
  <para style="s">बदला की भावना</para>
  <para style="r">(<ref loc="LUK 6:29">लूका ६:२९</ref>,<ref loc="LUK 6:30">३०</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“तुम्न सुन लियो हय कि कह्यो गयो होतो, ‘आंखी को बदला आंखी, अऊर दात को बदला दात।’ <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />पर मय तुम सी यो कहू हय कि जो तुम सी बुरो व्यवहार करय हय ओको सी सामना मत करजो; पर जो कोयी तोरो दायो गाल पर थापड़ मारे, ओको तरफ दूसरों भी गाल घुमाय दे। <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />यदि कोयी तोरो पर जबरदस्ती कर क् तोरो कुरता लेनो चाहेंन, त ओख बाहेर को कोट भी ले लेन दे। <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />अऊर यदि कोयी तोख दबाव म एक कोस ले जायेंन, त तय ओको संग दोय कोस चली जाजो। <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />जो कोयी तोरो सी मांगे, ओख दे; अऊर जो तोरो सी उधार लेनो चाहेंन, ओको सी मुंह न फिराव।”<verse eid="MAT 5:42" /></para>
  <para style="s">दुश्मनों सी प्रेम</para>
  <para style="r">(<ref loc="LUK 6:27">लूका ६:२७</ref>,<ref loc="LUK 6:28">२८</ref>,<ref loc="LUK 6:32-36">३२-३६</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />“तुम्न सुन लियो हय कि कह्यो गयो होतो, ‘अपनो पड़ोसी सी प्रेम रखजो, अऊर दुश्मन सी बैर।’ <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />पर मय तुम सी यो कहू हय कि अपनो दुश्मनों सी प्रेम रखजो अऊर अपनो सतावन वालो लायी प्रार्थना करजो। <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />जेकोसी तुम अपनो स्वर्गीय पिता की सन्तान बन सको कहालीकि ऊ भलो अऊर बुरो दोयी पर अपनो सूरज उगावय हय, अऊर सच्चो अऊर बुरो दोयी पर पानी बरसावय हय। <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />कहालीकि यदि तुम अपनो प्रेम रखन वालो सीच प्रेम रखजो, त तुम्हरो लायी का प्रतिफल होयेंन? का कर लेनवालो भी असोच नहीं करय? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />यदि तुम केवल अपनो भाऊवों लायी भलायी करय हय, त कौन सो बड़ो काम करय हय? का गैरयहूदी भी असो नहीं करय? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />येकोलायी कि तुम सिद्ध बनो, जसो तुम्हरो स्वर्गीय पिता सिद्ध हय।”<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">दान को बारे म सिखानो</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">६:१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:5">मत्ती २३:५</ref>
      </char>
    </note>“चौकस रहो!” तुम आदमी ख दिखावन लायी अपनो सच्चायी को काम मत करो, नहीं त अपनो स्वर्गीय पिता सी कुछ भी फर नहीं पावों।<verse eid="MAT 6:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 6:2" />“येकोलायी जब तय दान करय हय, त अपनो आगु पोंगा मत बजवा, जसो कपटी, सभावों अऊर गलियो म करय हंय, ताकि लोग उन्की बड़ायी करे। मय तुम सी सच कहू हय कि हि अपनो प्रतिफल पा लियो। <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />पर जब तय दान करय, त जो तोरो दायो हाथ करय हय, ओख तोरो बायो हाथ नहीं जाननो पाये। <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />ताकि तोरो दान गुप्त रहे, अऊर तब तोरो बाप जो गुप्त म देखय हय, तोख प्रतिफल देयेंन।”<verse eid="MAT 6:4" /></para>
  <para style="s">प्रार्थना की शिक्षा</para>
  <para style="r">(<ref loc="LUK 11:2-4">लूका ११:२-४</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">६:५ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 18:10-14">लूका १८:१०-१४</ref>
      </char>
    </note>“जब तय प्रार्थना करय हय, त कपटियों को जसो नहीं हो, कहालीकि लोगों ख दिखावन लायी यहूदियों को सभागृह म अऊर रस्ता कि मोड़ों पर खड़ो होय क प्रार्थना करनो उन्ख पसंद हय। मय तुम सी सच कहू हय कि हि अपनो प्रतिफल पा लियो <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />पर जब तय प्रार्थना करय हय, त अपनी कोठरी म जा; अऊर दरवाजा बन्द कर क् अपनो बाप सी जो गुप्त म हय प्रार्थना कर। तब तोरो बाप जो गुप्त म देखय हय, तोख प्रतिफल देयेंन।”<verse eid="MAT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 6:7" />प्रार्थना करतो समय गैरयहूदियों को जसो बक-बक मत करो, कहालीकि हि समझय हंय कि उन्को बहुत बोलनो सी उन्की सुनी जायेंन। <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />येकोलायी तुम उन्को जसो मत बनो, कहालीकि तुम्हरो बाप तुम्हरो मांगनो सी पहिलेच जानय हय कि तुम्हरी का-का जरूरत हंय। <verse eid="MAT 6:8" /><verse number="9" style="v" sid="MAT 6:9" />येकोलायी तुम यो रीति सी प्रार्थना करतो रहो:</para>
  <para style="q1" vid="MAT 6:9">“हे हमरो पिता, तय जो स्वर्ग म हय;</para>
  <para style="q2" vid="MAT 6:9">तोरो नाम पवित्र मान्यो जाये।”<verse eid="MAT 6:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="MAT 6:10" />“तोरो राज्य आये।</para>
  <para style="q2" vid="MAT 6:10">तोरी इच्छा जसी स्वर्ग म पूरी होवय हय, वसी धरती पर भी हो”<verse eid="MAT 6:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="MAT 6:11" />“हमरी दिन भर की रोटी अज हम्ख दे।”<verse eid="MAT 6:11" /></para>
  <para style="q2">
    <verse number="12" style="v" sid="MAT 6:12" />“अऊर जो तरह हम न अपनो अपराधियों ख माफ करयो हय,</para>
  <para style="q2" vid="MAT 6:12">वसोच तय भी हमरो अपराधो ख माफ कर।”<verse eid="MAT 6:12" /></para>
  <para style="q2">
    <verse number="13" style="v" sid="MAT 6:13" />“अऊर हम्ख परीक्षा म मत लाव,</para>
  <para style="q2" vid="MAT 6:13">पर बुरायी सी बचाव; कहालीकि राज्य पराक्रम अऊर महिमा हमेशा तोरीच हंय।” आमीन।<verse eid="MAT 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 6:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">६:१४ </char>
      <char style="xt" closed="false">
        <ref loc="MRK 11:25">मरकुस ११:२५</ref>,<ref loc="MRK 11:26">२६</ref></char>
    </note>“येकोलायी यदि तुम आदमी को अपराध माफ करो, त तुम्हरो स्वर्गीय पिता भी तुम्ख माफ करेंन। <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />अऊर यदि तुम लोगों को अपराध माफ नहीं करो, त तुम्हरो स्वर्गीय पिता भी तुम्हरो अपराध माफ नहीं करेंन।”<verse eid="MAT 6:15" /></para>
  <para style="s">उपवास की शिक्षा</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />“जब तुम उपवास करो, त कपटियों को जसो तुम्हरो मुंह पर उदासी नहीं रहन ख होना, कहालीकि हि अपनो मुंह असो बनायो रह्य हंय, कि लोग उन्ख उपवासी हय असो जान सके। मय तुम सी सच कहू हय कि हि अपनो प्रतिफल पा चुक्यो हय। <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />पर जब तय उपवास करजो त अपनो चेहरा धोव अऊर बाल पर तेल लगाय क कंग्गी कर, <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />ताकि लोग नहीं पर तोरो बाप जो गुप्त म हय, तोख उपवासी जाने। यो दशा म तोरो बाप जो गुप्त म देखय हय, तोख प्रतिफल देयेंन।”<verse eid="MAT 6:18" /></para>
  <para style="s">स्वर्गीय धन</para>
  <para style="r">(<ref loc="LUK 12:33">लूका १२:३३</ref>,<ref loc="LUK 12:34">३४</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">६:१९ </char>
      <char style="xt" closed="false">
        <ref loc="JAS 5:2">याकूब ५:२</ref>,<ref loc="JAS 5:3">३</ref></char>
    </note>“अपनो लायी धरती पर धन जमा मत करो, जित कीड़ा अऊर जंग लगय हंय, अऊर चोर तिजोरी तोड़ क चोरी करय हंय। <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />पर अपनो लायी स्वर्ग म धन जमा करो, जित नहीं त कीड़ा अऊर नहीं जंग लगय हंय, अऊर जित चोर तिजोरी तोड़ क चोरी करय हंय। <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />कहालीकि जित तोरो धन हय उत तोरो मन भी लग्यो रहेंन।”<verse eid="MAT 6:21" /></para>
  <para style="s">शरीर की ज्योति</para>
  <para style="r">(<ref loc="LUK 11:34-36">लूका ११:३४-३६</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />“शरीर को दीया आंखी आय : येकोलायी यदि तोरी आंखी अच्छी हय, त तोरो पूरो शरीर भी उजाड़ो होयेंन। <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />पर यदि तोरी आंखी बुरी हय, त तोरो पूरो शरीर अन्धारो म रहेंन; त अगर तोरो म उजाड़ो जो अन्धारो हय, त यो कितनो गहरो होयेंन!”<verse eid="MAT 6:23" /></para>
  <para style="s">परमेश्वर अऊर धन</para>
  <para style="r">(<ref loc="LUK 16:13">लूका १६:१३</ref>; <ref loc="LUK 12:22-31">१२:२२-३१</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />“कोयी आदमी दोय मालिक की सेवा नहीं कर सकय, कहालीकि ऊ एक सी दुश्मनी अऊर दूसरों सी प्रेम रखेंन, यां एक सी मिल्यो रहेंन अऊर दूसरों ख तुच्छ जानेंन। तुम परमेश्वर अऊर धन दोयी की सेवा नहीं कर सकय।”<verse eid="MAT 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 6:25" />“येकोलायी मय तुम सी कहू हय कि अपनो जीव लायी यो चिन्ता मत करजो कि हम का खाबो अऊर का पीबो; अऊर न अपनो शरीर लायी कि का पहिनबो। का जीव भोजन सी, अऊर शरीर कपड़ा सी बढ़ क नहाय?” <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />आसमान को पक्षिंयों ख देखो! हि नहीं बोवय हंय, न काटय हंय, अऊर न अपनो घोसला म जमा करय हंय; फिर भी तुम्हरो स्वर्गीय पिता उन्ख खिलावय हय। का तुम उन्को सी जादा कीमत नहीं रखय? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />तुम म सी असो कौन हय, जो चिन्ता करन सी अपनी उमर म एक घड़ी भी बढ़ाय सकय हय?<verse eid="MAT 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 6:28" />अऊर कपड़ा लायी कहाली चिन्ता करय हय? जंगली फूलो ख देखो कि हि कसो बढ़य हंय! हि नहीं त मेहनत करय, न काटय हंय। <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />तब भी मय तुम सी कहू हय कि सुलैमान भी, अपनो पूरो वैभव म उन्म सी कोयी को जसो कपड़ा पहिन्यो हुयो नहीं होतो। <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />येकोलायी जब परमेश्वर मैदान को घास ख, जो अज हय अऊर कल आगी म झोक दियो जायेंन, असो कपड़ा पहिनावय हय, त हे अविश्वासियों, तुम्ख ऊ इन सी बढ़ क कहाली नहीं पहिनायेंन?<verse eid="MAT 6:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 6:31" />“येकोलायी तुम चिन्ता कर क् यो मत कहजो कि हम का खाबो, यां का पीबो, यां का पहिनबो। <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />कहालीकि गैरयहूदी इन सब चिजों की खोज म रह्य हंय, पर तुम्हरो स्वर्गीय पिता जानय हय कि तुम्ख इन सब चिजों की जरूरत हय। <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />येकोलायी पहिले तुम परमेश्वर को राज्य अऊर ओको सच्चायी की खोज करो त यो सब चिजे भी तुम्ख मिल जायेंन। <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />येकोलायी कल की चिन्ता मत करो, कहालीकि कल को दिन अपनी चिन्ता खुद कर लेयेंन; अज लायी अजच को दु:ख बहुत हय।”<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">दूसरों पर दोष नहीं लगावनो</para>
  <para style="r">(<ref loc="LUK 6:37">लूका ६:३७</ref>,<ref loc="LUK 6:38">३८</ref>,<ref loc="LUK 6:41">४१</ref>,<ref loc="LUK 6:42">४२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />“दोष मत लगावो कि तुम्हरो पर भी दोष नहीं लगायो जाये, <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" /><note caller="+" style="x"><char style="xo" closed="false">७:२ </char><char style="xt" closed="false"><ref loc="MRK 4:24">मरकुस ४:२४</ref></char></note>कहालीकि जो तरह तुम दोष लगावय हय, उच तरह सी तुम पर भी दोष लगायो जायेंन; अऊर जो नाप सी तुम नापय हय, उच नाप सी तुम्हरो लायी भी नाप्यो जायेंन।” <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />“तय कहाली अपनो भाऊ की आंखी को तिनका ख देखय हय, अऊर अपनी आंखी को लट्ठा तोख नहीं सूझय? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />जब तोरीच आंखी म लट्ठा हय, त तय अपनो भाऊ सी कसो कह्य सकय हय, ‘लाव मय तोरी आंखी सी तिनका निकाल देऊ?’ <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />हे कपटी, पहिले अपनी आंखी म सी लट्ठा निकाल ले, तब तय अपनो भाऊ की आंखी को तिनका अच्छो सी देख क निकाल सकजो।”<verse eid="MAT 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 7:6" />“पवित्र चिज कुत्ता ख मत दे, अऊर अपनो मोती डुक्करों को आगु मत डालो; असो न होय कि हि उन्ख पाय खल्लो खुंदेन अऊर पलट क तुम ख फाड़ डालेंन।<verse eid="MAT 7:6" /></para>
  <para style="s">मांगो त पावों</para>
  <para style="r">(<ref loc="LUK 11:9-13">लूका ११:९-१३</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />“मांगो, त तुम्ख दियो जायेंन; ढूंढो त तुम पावों; खटखटावों, त तुम्हरो लायी खोल्यो जायेंन। <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />कहालीकि जो कोयी मांगय हय, ओख मिलय हय; अऊर जो ढूंढय हय, ऊ पावय हय; अऊर जो खटखटावय हय, ओको लायी खोल्यो जायेंन। <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />तुम म सी असो कौन आदमी हय, कि यदि ओको बेटा ओको सी रोटी मांगेंन, त ऊ ओख गोटा देयेंन? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />यां मच्छी मांगेंन, त ओख सांप देयेंन? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />येकोलायी जब तुम बुरो होय क, अपनो बच्चां ख अच्छी चिजे देनो जानय हय, त तुम्हरो स्वर्गीय पिता अपनो मांगन वालो ख अच्छी चिजे कहाली नहीं देयेंन?<verse eid="MAT 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 7:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">७:१२ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:31">लूका ६:३१</ref>
      </char>
    </note>“यो वजह जो कुछ तुम चाहवय हय कि लोग तुम्हरो संग करे, तुम भी उन्को संग वसोच करो; कहालीकि मूसा की व्यवस्था अऊर भविष्यवक्तावों की शिक्षा याच आय।<verse eid="MAT 7:12" /></para>
  <para style="s">निरून्द अऊर चौड़ी रस्ता</para>
  <para style="r">(<ref loc="LUK 13:24">लूका १३:२४</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />“निरून्द द्वार सी सिरो, कहालीकि चौड़ो हय ऊ फाटक अऊर सरल हय ऊ रस्ता जो नाश को तरफ लिजावय हय; अऊर बहुत सो हंय जो ओको सी सिरय हंय। <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />कहालीकि निरून्द हय ऊ फाटक अऊर कठिन हय ऊ रस्ता जो जीवन को तरफ लिजावय हय; अऊर थोड़ो हंय जो ओख पावय हंय।<verse eid="MAT 7:14" /></para>
  <para style="s">जसो झाड़ वसो फर</para>
  <para style="r">(<ref loc="LUK 6:43">लूका ६:४३</ref>,<ref loc="LUK 6:44">४४</ref>,<ref loc="LUK 6:46">४६</ref>; <ref loc="LUK 13:25-27">१३:२५-२७</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />“झूठो भविष्यवक्तावों सी चौकस रहो, जो मेंढीं को रूप म तुम्हरो जवर आवय हंय, पर आखरी म हि फाड़न वालो भेड़िया आय। <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />उन्को फर सी तुम उन्ख जान जावो। का लोग झाड़ियों सी अंगूर, यां काटा को झुड़ूपो सी अंजीर तोड़य हंय? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />असो तरह हर एक अच्छो झाड़ अच्छो फर लावय हय अऊर बुरो झाड़ बुरो फर लावय हय। <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />अच्छो झाड़ बुरो फर नहीं लाय सकय, अऊर न बुरो झाड़ अच्छो फर लाय सकय हय। <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" /><note caller="+" style="x"><char style="xo" closed="false">७:१९ </char><char style="xt" closed="false"><ref loc="MAT 3:10">मत्ती ३:१०</ref>; <ref loc="LUK 3:9">लूका ३:९</ref></char></note>जो जो झाड़ अच्छो फर नहीं लावय, ऊ काट क आगी म डाल दियो जावय हय। <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" /><note caller="+" style="x"><char style="xo" closed="false">७:२० </char><char style="xt" closed="false"><ref loc="MAT 12:33">मत्ती १२:३३</ref></char></note>यो तरह उन्को फर सी तुम भविष्यवक्तावों ख जान लेवो।<verse eid="MAT 7:20" /></para>
  <para style="s">मय तुम्ख कभी नहीं जानु हय</para>
  <para style="r">(<ref loc="LUK 13:25-27">लूका १३:२५-२७</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />“जो मोरो सी, ‘हे प्रभु! हे प्रभु!’ कह्य हय, उन्म सी हर एक स्वर्ग को राज्य म सिर नहीं सकेंन, पर उच जो मोरो स्वर्गीय पिता की इच्छा पर चलय हय। <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />न्याय को दिन बहुत सो लोग मोरो सी कहेंन, ‘हे प्रभु, हे प्रभु, का हम्न तोरो नाम सी भविष्यवानी नहीं करी, अऊर तोरो नाम सी दुष्ट आत्मावों ख नहीं निकाल्यो, अऊर तोरो नाम सी सामर्थ को काम नहीं करयो?’ <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />तब मय उन्को सी खुल क कह्य देऊं, ‘मय न तुम्ख कभी नहीं जान्यो। हे कुकर्मियों मोरो जवर सी चली जावो।’<verse eid="MAT 7:23" /></para>
  <para style="s">दोय तरह को घर बनान वालो आदमी</para>
  <para style="r">(<ref loc="LUK 6:47-49">लूका ६:४७-४९</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />“येकोलायी जो कोयी मोरी या बाते सुन क उन्ख मानय हय, ऊ उन बुद्धिमान आदमी को जसो ठहरेंन जेन अपनो घर चट्टान पर बनायो। <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />अऊर पानी बरस्यो, अऊर बाढ़ आयी, अऊर आन्धिया चली, अऊर यो सब ऊ घर सी टकरायी, तब भी ऊ नहीं गिरयो, कहालीकि ओको नींव चट्टान पर डाल्यो गयो होतो।<verse eid="MAT 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 7:26" />“पर जो कोयी मोरी या बाते सुनय हय अऊर उन पर नहीं चलय, यो ऊ मूर्ख आदमी को जसो ठहरेंन जेन अपनो घर रेतु पर बनायो। <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />अऊर पानी बरस्यो, अऊर बाढ़ आयी, अऊर आन्धिया चली, अऊर ऊ घर सी टकरायी अऊर ऊ गिर क नाश भय गयो।”<verse eid="MAT 7:27" /></para>
  <para style="s">यीशु को अधिकार</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">७:२८ </char>
      <char style="xt" closed="false">
        <ref loc="MRK 1:22">मरकुस १:२२</ref>; <ref loc="LUK 4:32">लूका ४:३२</ref></char>
    </note>जब यीशु या बाते कह्य चुक्यो, त असो भयो कि भीड़ ओको उपदेश सी चकित भयी, <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />कहालीकि ऊ उन्को धर्मशास्त्रियों को जसो नहीं पर अधिकार को जसो उन्ख उपदेश देत होतो।<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">कोढ़ को रोगी ख चंगो करनो</para>
  <para style="r">(<ref loc="MRK 1:40-45">मरकुस १:४०-४५</ref>; <ref loc="LUK 5:12-16">लूका ५:१२-१६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />जब यीशु पहाड़ी सी उतरयो, त एक बड़ी भीड़ ओको पीछू भय गयी। <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />अऊर देखो, एक कोढ़ी न जवर आय क ओख प्रनाम करयो अऊर कह्यो, “हे प्रभु, यदि तय चाहवय, त मोख शुद्ध कर सकय हय।”<verse eid="MAT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 8:3" />यीशु न हाथ बढ़ाय क ओख छूयो, अऊर कह्यो, “मय चाहऊ हय, तय शुद्ध होय जा।” अऊर ऊ तुरतच कोढ़ सी चंगो भय गयो। <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />यीशु न ओको सी कह्यो, “देख, कोयी सी मत कहजो, पर जाय क अपनो आप ख याजक ख दिखाव अऊर जो चढ़ावा मूसा न ठहरायो हय ओख भेंट चढ़ाव, ताकि लोगों लायी गवाही हो।”<verse eid="MAT 8:4" /></para>
  <para style="s">एक सूबेदार को विश्वास</para>
  <para style="r">(<ref loc="LUK 7:1-10">लूका ७:१-१०</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />जब ऊ कफरनहूम नगर म आयो त एक रोमन अधिकारी न ओको जवर आय क ओको सी बिनती करी, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />“हे प्रभु, मोरो सेवक ख घर म लकवा मारयो हय अऊर ओख बहुत दु:ख होय रह्यो हय।”<verse eid="MAT 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 8:7" />यीशु न ओको सी कह्यो, “मय आय क ओख चंगो करूं।”<verse eid="MAT 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 8:8" />जवाबदार अधिकारी न उत्तर दियो, “हे प्रभु, मय यो लायक नहाय कि तय मोरो छत को खल्लो आये, पर केवल आज्ञा दे त मोरो सेवक चंगो होय जायेंन। <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />कहालीकि मय भी दूसरों को अधीन हय, अऊर सिपाही मोरो अधीन हंय। जब मय एक सी कहूं हय, ‘जा!’ त ऊ जावय हय; अऊर दूसरों सी कहूं हय, ‘आव!’ त ऊ आवय हय; अऊर जब अपनो सेवक सी कहूं हय, ‘यो कर!’ त ऊ करय हय।”<verse eid="MAT 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 8:10" />यो सुन क यीशु ख अचम्भा भयो, अऊर जो ओको पीछू आय रह्यो होतो उन्को सी कह्यो, “मय तुम सी सच कहू हय कि मय न इस्राएल म भी असो विश्वास नहीं पायो। <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" /><note caller="+" style="x"><char style="xo" closed="false">८:११ </char><char style="xt" closed="false"><ref loc="LUK 13:29">लूका १३:२९</ref></char></note>अऊर मय तुम सी कहू हय कि पूर्व अऊर पश्चिम सी बहुत सो लोग आय क अब्राहम अऊर इसहाक अऊर याकूब को संग स्वर्ग को राज्य म भोज म बैठेंन। <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" /><note caller="+" style="x"><char style="xo" closed="false">८:१२ </char><char style="xt" closed="false"><ref loc="MAT 22:13">मत्ती २२:१३</ref>; <ref loc="MAT 25:30">२५:३०</ref>; <ref loc="LUK 13:28">लूका १३:२८</ref></char></note>पर राज्य को प्रजा बाहेर अन्धारो म डाल दियो जायेंन: उत रोवनो अऊर दात को कटरनो होयेंन।” <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />तब यीशु न अधिकारी सी कह्यो, “जा, जसो तोरो विश्वास हय, वसोच तोरो लायी हो।”</para>
  <para style="p" vid="MAT 8:13">अऊर ओको सेवक उच घड़ी चंगो भय गयो।<verse eid="MAT 8:13" /></para>
  <para style="s">यीशु द्वारा रोगियों ख चंगो करनो</para>
  <para style="r">(<ref loc="MRK 1:29-34">मरकुस १:२९-३४</ref>; <ref loc="LUK 4:38-41">लूका ४:३८-४१</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />यीशु जब पतरस को घर आयो, त ओन पतरस की सासु ख बुखार म पड़ी देख्यो। <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />यीशु न ओको हाथ छूयो अऊर ओको बुखार उतर गयो, अऊर वा उठ क ओकी सेवा-भाव करन लगी।<verse eid="MAT 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 8:16" />जब शाम भयी तब हि ओको जवर बहुत सो लोगों ख लायो जेको म दुष्ट आत्मायें होती अऊर यीशु न उन आत्मावों ख अपनो वचन सी निकाल दियो; अऊर सब बीमारों ख चंगो करयो। <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" /><note caller="+" style="x"><char style="xo" closed="false">८:१७ </char><char style="xt" closed="false"><ref loc="ISA 53:4">यशायाह ५३:४</ref></char></note>ताकि जो वचन यशायाह भविष्यवक्ता सी कह्यो गयो होतो ऊ पूरो हो: “यीशु न खुदच हमरी कमजोरियों ख पकड़ लियो अऊर हमरी बीमारियों ख उठाय लियो।”<verse eid="MAT 8:17" /></para>
  <para style="s">यीशु को चेला बनन की कीमत</para>
  <para style="r">(<ref loc="LUK 9:57-62">लूका ९:५७-६२</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />यीशु न जब अपनो चारयी तरफ एक बड़ी भीड़ देखी त चेलां ख झील को ओन पार जान को आदेश दियो। <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />तब एक धर्मशास्त्री न जवर आय क ओको सी कह्यो, “हे गुरु, जित कहीं तय जाजो, मय तोरो पीछू होय जाऊं।”<verse eid="MAT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 8:20" />यीशु न ओको सी कह्यो, “लोमड़ियों की गुफा अऊर आसमान को पक्षिंयों को घोसला होवय हंय; पर आदमी को बेटा लायी मुंड रखन की भी जागा नहाय।”<verse eid="MAT 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 8:21" />एक अऊर चेला न ओको सी कह्यो, “हे प्रभु, मोख पहिले जान दे कि मय अपनो बाप ख गाड़ देऊ।”<verse eid="MAT 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 8:22" />यीशु न ओको सी कह्यो, “तय मोरो पीछू होय जा, अऊर मुर्दों ख अपनो मुर्दा गाड़न दे।”<verse eid="MAT 8:22" /></para>
  <para style="s">आन्धी ख शान्त करनो</para>
  <para style="r">(<ref loc="MRK 4:35-41">मरकुस ४:३५-४१</ref>; <ref loc="LUK 8:22-25">लूका ८:२२-२५</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />जब यीशु डोंगा पर चढ़्यो, त ओको चेला ओको पीछू गयो। <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />अऊर देखो, झील म अचानक असो बड़ो तूफान उठ्यो कि डोंगा लहर सी दबन लग्यो, पर यीशु सोय रह्यो होतो। <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />तब चेलावों न जवर आय क ओख जगायो अऊर कह्यो, “हे प्रभु, हम्ख बचाव, हम नाश होय रह्यो हंय।”<verse eid="MAT 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 8:26" />यीशु न उन्को सी कह्यो, “हे अविश्वासियों, कहाली डरय हय?” तब ओन उठ क आन्धी अऊर पानी ख डाट्यो, अऊर सब शान्त भय गयो।<verse eid="MAT 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 8:27" />अऊर हि अचम्भा कर क् कहन लग्यो, “यो कसो आदमी आय कि आन्धी अऊर पानी भी ओकी आज्ञा मानय हंय।”<verse eid="MAT 8:27" /></para>
  <para style="s">यीशु दुष्ट आत्मा–ग्रस्त लोगों ख चंगो करनो</para>
  <para style="r">(<ref loc="MRK 5:1-20">मरकुस ५:१-२०</ref>; <ref loc="LUK 8:26-39">लूका ८:२६-३९</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />जब यीशु ओन पार गदरेनियों को देश म पहुंच्यो, त दोय आदमी जिन्म दुष्ट आत्मायें होती कब्रो सी निकलतो हुयो ओख मिल्यो। हि इतनो खतरनाक होतो कि कोयी ऊ रस्ता सी जाय नहीं सकत होतो। <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />उन्न चिल्लाय क कह्यो, “हे परमेश्वर को बेटा, हमरो तोरो सी का काम? का तय समय सी पहिले हम्ख दु:ख देन ख इत आयो हय?”<verse eid="MAT 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 8:30" />उन्को सी कुछ दूरी पर बहुत सो डुक्करों को एक झुण्ड चर रह्यो होतो। <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />दुष्ट आत्मावों न ओको सी यो कह्य क बिनती करी, “यदि तय हम्ख निकालय हय, त डुक्करों को झुण्ड म भेज दे।”<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />यीशु न उन्को सी कह्यो, “जावो!” अऊर हि निकल क डुक्करों म समाय गयी अऊर देखो, पूरो झुण्ड ढलान पर सी झपट क झील को किनार पर गिर पड़्यो, अऊर पानी म डुब क मरयो।<verse eid="MAT 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 8:33" />उन्को चरवाहे भग क अऊर नगर म जाय क या सब बाते अऊर जेको म दुष्ट आत्मायें होती उन्को पूरो हाल सुनायो। <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />तब पूरो नगर को लोग यीशु सी मिलन ख निकल आयो, अऊर ओख देख क बिनती करी कि हमरी सीमा सी बाहेर चली जा।<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">लकवा को रोगी ख चंगो करनो</para>
  <para style="r">(<ref loc="MRK 2:1-12">मरकुस २:१-१२</ref>; <ref loc="LUK 5:17-26">लूका ५:१७-२६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />तब यीशु डोंगा पर चढ़ क ओन पार गयो, अऊर अपनो नगर म आयो। <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />अऊर देखो, कुछ लोग एक लकवा को रोगी ख खटिया पर रख क ओको जवर लायो। यीशु न उन्को विश्वास ख देख क, ऊ लकवा को रोगी सी कह्यो, “हे बेटा, हिम्मत रख; तोरो पाप माफ भयो।”<verse eid="MAT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 9:3" />येको पर कुछ धर्मशास्त्रियों न आपस म बोलन लग्यो, “यो त परमेश्वर की निन्दा करय हय।”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />यीशु न उन्को मन की बाते जान क कह्यो, “तुम लोग अपनो-अपनो मन म बुरो बिचार कहाली लाय रह्यो हय? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />सहज का हय? यो कहनो, ‘तोरो पाप माफ भयो,’ यां यो कहनो, ‘उठ अऊर चल फिर।’ <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />पर तुम यो जान लेवो कि आदमी को बेटा ख धरती पर पाप माफ करन को अधिकार हय।” येकोलायी यीशु न लकवा को रोगी सी कह्यो, “उठ, अपनी खटिया उठाव, अऊर अपनो घर चली जा।”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />ऊ उठ क अपनो घर चली गयो। <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />लोग यो देख क डर गयो अऊर परमेश्वर की महिमा करन लग्यो जेन लोगों ख असो अधिकार दियो हय।<verse eid="MAT 9:8" /></para>
  <para style="s">मत्ती को बुलायो जानो</para>
  <para style="r">(<ref loc="MRK 2:13-17">मरकुस २:१३-१७</ref>; <ref loc="LUK 5:27-32">लूका ५:२७-३२</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />उत सी आगु जाय क यीशु न मत्ती नाम को एक आदमी ख कर वसुली की चौकी पर बैठ्यो देख्यो, अऊर ओको सी कह्यो, “मोरो पीछू चली आव।”</para>
  <para style="p" vid="MAT 9:9">ऊ उठ क ओको पीछू चली गयो।<verse eid="MAT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 9:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">९:१० </char>
      <char style="xt" closed="false">
        <ref loc="LUK 15:1">लूका १५:१</ref>,<ref loc="LUK 15:2">२</ref></char>
    </note>जब ऊ घर म जेवन करन लायी बैठ्यो त बहुत सो कर लेनवालो अऊर पापी आय क यीशु अऊर ओको चेलावों को संग जेवन करन बैठ्यो। <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />यो देख क फरीसियों न ओको चेलावों सी कह्यो, “तुम्हरो गुरु कर लेनवालो अऊर पापियों को संग कहाली खावय हय?”<verse eid="MAT 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 9:12" />यो सुन क यीशु न उन्को सी कह्यो, “डाक्टर भलो चंगो लायी नहीं पर बीमारों लायी जरूरी हय। <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" /><note caller="+" style="x"><char style="xo" closed="false">९:१३ </char><char style="xt" closed="false"><ref loc="MAT 12:7">मत्ती १२:७</ref></char></note>येकोलायी तुम जाय क येको मतलब सीख लेवो: ‘मय बलिदान नहीं पर दया चाहऊ हय।’ कहालीकि मय सच्चो लोगों ख नहीं, पर पापियों ख बुलावन ख आयो हय।”<verse eid="MAT 9:13" /></para>
  <para style="s">उपवास को प्रश्न</para>
  <para style="r">(<ref loc="MRK 2:18-22">मरकुस २:१८-२२</ref>; <ref loc="LUK 5:33-39">लूका ५:३३-३९</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />तब बपतिस्मा देन वालो यूहन्ना को चेलावों न ओको जवर आय क कह्यो, “का वजह हय कि हम अऊर फरीसी इतनो उपवास करजे हंय, पर तोरो चेला उपवास नहीं करय?”<verse eid="MAT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 9:15" />यीशु न उन्को सी कह्यो, “दूल्हा उन्को संग हय, त का बराती शोक कर सकय हंय? पर ऊ दिन आयेंन जब दूल्हा उन्को सी अलग कर दियो जायेंन, ऊ समय हि उपवास करेंन।<verse eid="MAT 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 9:16" />“नयो कपड़ा को थेगड़ पुरानो कपड़ा पर कोयी नहीं लगावय, कहालीकि ऊ थेगड़ ऊ कपड़ा सी कुछ अऊर खीच लेवय हय, अऊर ऊ ज्यादा फट जावय हय। <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />अऊर लोग नयो अंगूररस पुरानी मशकों म नहीं भरय हंय, कहालीकि असो करनो सी मशके फट जावय हंय, अऊर अंगूररस बह जावय हय; अऊर मशके नाश होय जावय हंय; पर नयो अंगूररस नयी मशकों म भरय हंय अऊर हि दोयी बच्यो रह्य हंय।”<verse eid="MAT 9:17" /></para>
  <para style="s">रोमी अधिकारी की मरी बेटी अऊर बीमार बाई</para>
  <para style="r">(<ref loc="MRK 5:21-43">मरकुस ५:२१-४३</ref>; <ref loc="LUK 8:40-56">लूका ८:४०-५६</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />ऊ उन्को सी यो बाते कह्यच रह्यो होतो, कि देखो, एक मुखिया न आय क ओख प्रनाम करयो अऊर कह्यो, “मोरी बेटी अभी मरी हय, पर चल क अपनो हाथ ओको पर रखजो, त वा जीन्दी होय जायेंन।”<verse eid="MAT 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 9:19" />यीशु उठ क अपनो चेलावों को संग ओको पीछू भय गयो।<verse eid="MAT 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 9:20" />अऊर देखो, एक बाई न जेक बारा साल सी खून बहन कि बीमारी होती, पीछू सी आय क ओको कपड़ा को कोना ख छूय लियो। <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />कहालीकि वा अपनो मन म कहत होती, “यदि मय ओको कपड़ा ख छूय लेऊ त चंगी होय जाऊं।”<verse eid="MAT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 9:22" />यीशु न मुड़ क ओख देख्यो अऊर कह्यो, “बेटी हिम्मत रख; तोरो विश्वास न तोख चंगो करयो हय।” येकोलायी वा बाई उच घड़ी चंगी भय गयी।<verse eid="MAT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 9:23" />जब यीशु ऊ मुखिया को घर म पहुंच्यो अऊर पेपाड़ी बजावन वालो अऊर भीड़ ख हल्ला मचावत देख्यो, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />तब कह्यो, “हट जा, बेटी मरी नहाय, पर सोय रही हय।” याच बात पर हि ओकी मजाक उड़ावन लग्यो। <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />पर जब भीड़ ख बाहेर निकाल दियो त यीशु अन्दर जाय क बेटी को हाथ पकड़्यो अऊर वा जीन्दी भय गयी। <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />अऊर या बात की चर्चा ऊ पूरो देश म फैल गयी।<verse eid="MAT 9:26" /></para>
  <para style="s">यीशु द्वारा दोय अन्धा ख चंगो करनो</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />जब यीशु उत सी आगु बढ़्यो, त दोय अन्धा ओको पीछू यो पुकारतो हुयो चल्यो, “हे दाऊद की सन्तान, हम पर दया कर!”<verse eid="MAT 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 9:28" />जब यीशु घर म पहुंच्यो, त हि अन्धा ओको जवर आयो, अऊर यीशु न उन्को सी कह्यो, “का तुम्ख विश्वास हय कि मय तुम्ख चंगो कर सकू हय?”</para>
  <para style="p" vid="MAT 9:28">उन्न ओको सी कह्यो, “हव, प्रभु!”<verse eid="MAT 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 9:29" />तब यीशु न यो कहतो हुयो उन्की आंखी ख छूय क कह्यो, “तुम्हरो विश्वास को जसो तुम्हरो लायी हो।” <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />अऊर उन्की आंखी खुल गयी। यीशु न उन्ख चिताय क कह्यो, “चौकस रहो, कोयी या बात ख नहीं जाने।”<verse eid="MAT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 9:31" />पर उन्न निकल क पूरो देश म ओकी बात फैलाय दियो।<verse eid="MAT 9:31" /></para>
  <para style="s">एक मुक्का ख चंगो करनो</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />जब हि बाहेर जाय रह्यो होतो, त देख्यो, लोग एक मुक्का ख जेको म दुष्ट आत्मायें होती, ओको जवर लायो; <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />अऊर जब दुष्ट आत्मा निकाल दियो गयो, त मुक्का बोलन लग्यो। येको पर भीड़ न अचम्भा कर क् कह्यो, “इस्राएल म असो कभी नहीं देख्यो गयो।”<verse eid="MAT 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 9:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">९:३४ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:25">मत्ती १०:२५</ref>; <ref loc="MAT 12:24">१२:२४</ref>; <ref loc="MRK 3:22">मरकुस ३:२२</ref>; <ref loc="LUK 11:15">लूका ११:१५</ref></char>
    </note>पर फरीसियों न कह्यो, “यो त दुष्ट आत्मावों को सरदार की मदत सी शैतानी आत्मावों ख निकालय हय।”<verse eid="MAT 9:34" /></para>
  <para style="s">यीशु की दया</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />
    <note caller="+" style="x">
      <char style="xo" closed="false">९:३५ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:23">मत्ती ४:२३</ref>; <ref loc="MRK 1:39">मरकुस १:३९</ref>; <ref loc="LUK 4:44">लूका ४:४४</ref></char>
    </note>यीशु सब नगरों अऊर गांवो म जाय जाय क उन्को सभागृहों म उपदेश करतो, अऊर राज्य को सुसमाचार प्रचार करतो, अऊर कुछ तरह की बीमारी अऊर कमजोरी ख दूर करतो रह्यो। <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" /><note caller="+" style="x"><char style="xo" closed="false">९:३६ </char><char style="xt" closed="false"><ref loc="MRK 6:34">मरकुस ६:३४</ref></char></note>जब यीशु न भीड़ ख देख्यो त ओख लोगों पर तरस आयो, कहालीकि हि उन मेंढीं को जसो होतो जिन्को कोयी चरवाहा नहीं होतो दु:खी अऊर भटक्यो हुयो को जसो होतो। <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" /><note caller="+" style="x"><char style="xo" closed="false">९:३७ </char><char style="xt" closed="false"><ref loc="LUK 10:2">लूका १०:२</ref></char></note>तब ओन अपनो चेलावों सी कह्यो, “पकी फसल त बहुत हंय, पर मजूर थोड़ो हंय। <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />येकोलायी फसल को मालिक सी प्रार्थना करो कि अपनो खेत की फसल काटन लायी मजूर भेज दे।”<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">बारा प्रेरित</para>
  <para style="r">(<ref loc="MRK 3:13-19">मरकुस ३:१३-१९</ref>; <ref loc="LUK 6:12-16">लूका ६:१२-१६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />तब यीशु न अपनो बारयी चेलावों ख जवर बुलाय क, उन्ख दुष्ट आत्मावों पर अधिकार दियो कि उन्ख निकाले अऊर सब तरह की बीमारियों अऊर सब तरह की कमजोरियों ख दूर करे।<verse eid="MAT 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 10:2" />इन बारयी प्रेरितों को नाम यो हंय: पहिलो शिमोन, जो पतरस कहलावय हय, अऊर ओको भाऊ अन्द्रियास; जब्दी को टुरा याकूब, अऊर ओको भाऊ यूहन्ना; <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />फिलिप्पुस, अऊर बरतुल्मै, थोमा, अऊर कर लेनवालो मत्ती, हलफई को टुरा याकूब, अऊर तद्दै, <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />शिमोन कनानी, अऊर यहूदा इस्करियोती जेन ओख पकड़वाय भी दियो होतो।<verse eid="MAT 10:4" /></para>
  <para style="s">बारयी प्रेरितों की सेवकायी</para>
  <para style="r">(<ref loc="MRK 6:7-13">मरकुस ६:७-१३</ref>; <ref loc="LUK 9:1-6">लूका ९:१-६</ref>; <ref loc="LUK 10:4-12">१०:४-१२</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />इन बारयी चेलावों ख यीशु न यो आज्ञा दे क भेज्यो: “गैरयहूदियों को तरफ मत जाजो, अऊर सामरियों को कोयी नगर म मत सिरजो। <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />पर इस्राएल को घरानों की गुमी हुयी मेंढीं को जवर जाजो। <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />अऊर चलतो-चलतो यो प्रचार करो: ‘स्वर्ग को राज्य जवर आय गयो हय।’ <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />बीमारों ख चंगो करो, मरयो हुयो ख जीन्दो करो, कोढ़ियों ख शुद्ध करो, दुष्ट आत्मावों ख निकालो। तुम न बिना कुछ दियो प्रभु की आशीष अऊर शक्तियां पायी हंय, येकोलायी उन्ख दूसरों ख बिना कुछ लियो मुक्त भाव सी देवो।”<verse eid="MAT 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 10:9" />“अपनो खीसा म नहीं त सोना, अऊर नहीं चांदी, अऊर नहीं तांबो को पैसा रखजो; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" /><note caller="+" style="x"><char style="xo" closed="false">१०:१० </char><char style="xt" closed="false"><ref loc="1CO 9:14">१ कुरिन्थियों ९:१४</ref>; <ref loc="1TI 5:18">१ तीमुथियुस ५:१८</ref></char></note>रस्ता लायी नहीं झोली रखो, नहीं दूसरों कुरता, नहीं जूता अऊर नहीं लाठी रखो, कहालीकि मजूर ख ऊ दियो जानो चाहिये जेकी उन्ख जरूरत हय।”<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />“जो कोयी नगर यां गांव म जावो, त पता लगावो कि उत कौन विश्वास लायक हय। अऊर बिदा होन तक उतच रुक्यो रहो। <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />जब तुम ऊ घर म सिरतो हुयो उन्को सी कहो कि तुम्ख शान्ति मिले। <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />यदि ऊ घर को लोग तुम्हरो स्वागत करेंन त तुम्हरी शान्ति उन पर पहुंचेंन, पर यदि हि स्वागत नहीं करेंन त तुम्हरी शान्ति तुम्हरो जवर लौट आयेंन। <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" /><note caller="+" style="x"><char style="xo" closed="false">१०:१४ </char><char style="xt" closed="false"><ref loc="ACT 13:51">प्रेरितों १३:५१</ref></char></note>जो कोयी तुम्ख स्वीकार नहीं करे अऊर तुम्हरी बाते नहीं सुनेंन, त ऊ घर यां ऊ नगर सी निकलतो हुयो अपनो पाय की धूल झाड़तो हुयो वापस लौट जावो। <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" /><note caller="+" style="x"><char style="xo" closed="false">१०:१५ </char><char style="xt" closed="false"><ref loc="MAT 11:24">मत्ती ११:२४</ref></char></note>मय तुम सी सच कहू हय कि न्याय को दिन ऊ नगर की दशा सी सदोम अऊर गमोरा को देश की दशा ज्यादा सहन लायक होयेंन।”<verse eid="MAT 10:15" /></para>
  <para style="s">आवन वाली मुसीबत</para>
  <para style="r">(<ref loc="MRK 13:9-13">मरकुस १३:९-१३</ref>; <ref loc="LUK 21:12-17">लूका २१:१२-१७</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१०:१६ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:3">लूका १०:३</ref>
      </char>
    </note>“देखो, मय तुम्ख मेंढीं को जसो भेड़ियों को बीच म भेजूं हय, येकोलायी सांप को जसो बुद्धिमान अऊर कबूत्तरों को जसो भोलो बनो।”<verse eid="MAT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 10:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१०:१७ </char>
      <char style="xt" closed="false">
        <ref loc="MRK 13:9-11">मरकुस १३:९-११</ref>; <ref loc="LUK 12:11">लूका १२:११</ref>,<ref loc="LUK 12:12">१२</ref>; <ref loc="LUK 21:12-15">२१:१२-१५</ref></char>
    </note>“पर लोगों सी चौकस रहो,” कहालीकि हि तुम्ख महासभावों म सौंपेंन, अऊर अपनी पंचायतो म तुम्ख कोड़ा मारेंन। <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />तुम मोरो वजह शासक अऊर राजावों को आगु उन पर, अऊर गैरयहूदियों पर गवाह होन लायी पहुंचायो जायेंन। <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />जब हि तुम्ख पकड़वायेंन त तुम या चिन्ता मत करो कि हम कसो तरह सी का कहबोंन, कहालीकि जो कुछ तुम ख कहनो होना, ऊ उच समय तुम्ख बताय दियो जायेंन। <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />कहालीकि बोलन वालो तुम नोहोय, पर तुम्हरो स्वर्गीय पिता की आत्मा जो तुम म बोलय हय।<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१०:२१ </char>
      <char style="xt" closed="false">
        <ref loc="MRK 13:12">मरकुस १३:१२</ref>; <ref loc="LUK 21:16">लूका २१:१६</ref></char>
    </note>“भाऊ, अपनो भाऊ ख अऊर बाप अपनो बेटा ख, मार डालन लायी सौंपेंन, अऊर बच्चा अपनो माय बाप को विरोध म खड़ो होय क उन्ख मरवाय डालेंन। <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" /><note caller="+" style="x"><char style="xo" closed="false">१०:२२ </char><char style="xt" closed="false"><ref loc="MAT 24:9">मत्ती २४:९</ref>; <ref loc="MRK 13:13">मरकुस १३:१३</ref>; <ref loc="LUK 21:17">लूका २१:१७</ref>; </char><char style="xt" closed="false"><ref loc="MAT 24:13">मत्ती २४:१३</ref>; <ref loc="MRK 13:13">मरकुस १३:१३</ref></char></note>मोरो नाम को वजह सब लोग तुम सी दुश्मनी करेंन, पर जो आखरी तक धीरज रखेंन ओकोच उद्धार होयेंन।” <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />जब हि तुम्ख एक नगर म सतायेंन त दूसरों नगर म भग जावो। मय तुम सी सच कहूं हय, कि येको सी पहले कि तुम इस्राएल को सब नगरों को चक्कर पूरो करो, आदमी को बेटा दुबारा आय जायेंन।<verse eid="MAT 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 10:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१०:२४ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 6:40">लूका ६:४०</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:16">यूहन्ना १३:१६</ref>; <ref loc="JHN 15:20">१५:२०</ref></char>
    </note>“चेला अपनो गुरु सी बड़ो नहीं होवय; अऊर नहीं सेवक अपनो मालिक सी। <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" /><note caller="+" style="x"><char style="xo" closed="false">१०:२५ </char><char style="xt" closed="false"><ref loc="MAT 9:34">मत्ती ९:३४</ref>; <ref loc="MAT 12:24">१२:२४</ref>; <ref loc="MRK 3:22">मरकुस ३:२२</ref>; <ref loc="LUK 11:15">लूका ११:१५</ref></char></note>चेला अपनो गुरु को, अऊर सेवक अपनो मालिक को बराबर होन मच बहुत हय। जब उन्न घर को मालिक ख शैतान<note caller="+" style="f"><char style="fr" closed="false">१०:२५ </char><char style="ft" closed="false">बालजबूल शैतान को सरदार</char></note> कह्यो त ओको घर वालो ख का कुछ नहीं कहेंन।”<verse eid="MAT 10:25" /></para>
  <para style="s">प्रभु सी डरे</para>
  <para style="r">(<ref loc="LUK 12:2-7">लूका १२:२-७</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१०:२६ </char>
      <char style="xt" closed="false">
        <ref loc="MRK 4:22">मरकुस ४:२२</ref>; <ref loc="LUK 8:17">लूका ८:१७</ref></char>
    </note>येकोलायी लोगों सी मत डरो; कहालीकि कुछ ढक्यो नहीं जो खोल्यो नहीं जायेंन, अऊर नहीं कुछ लुक्यो हय जो जान्यो नहीं जायेंन। <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />जो मय तुम सी अन्धारो म कहूं हय, ओख तुम उजाड़ो म कहो; अऊर जो कानो कान सुनय हय, ओख तुम छत पर सी प्रचार करो। <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />उन्को सी मत डरो जो शरीर ख नाश करय हंय, पर आत्मा ख नाश नहीं कर सकय, पर परमेश्वर सी डरो, जो आत्मा अऊर शरीर दोयी ख नरक म नाश कर सकय हय। <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />का एक पैसा म दोय पक्षी नहीं बिकय? तब भी तुम्हरो स्वर्गीय पिता की इच्छा को बिना उन्म सी एक भी धरती पर नहीं गिर सकय। <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />तुम्हरो मुंड को सब बाल भी गिन्यो हुयो हंय। <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />येकोलायी डरो मत; तुम बहुत सी पक्षी सी बहुत महत्वपूर्ण हय। <figure style="fig" alt="Flat-roofed, olden house in Israel" file="lb00234c.tif" size="col" copy="Horace Knowles ©" ref="१०:२७">सपाट छत, पुरानो समय को इस्राएल म घर</figure><verse eid="MAT 10:31" /></para>
  <para style="s">यीशु ख माननो यां नहीं माननो</para>
  <para style="r">(<ref loc="LUK 12:8-9">लूका १२:८-९</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />“जो कोयी लोगों को आगु मोख मान लेयेंन, ओख मय भी अपनो स्वर्गीय पिता को आगु मान लेऊ। <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" /><note caller="+" style="x"><char style="xo" closed="false">१०:३३ </char><char style="xt" closed="false"><ref loc="2TI 2:12">२ तीमुथियुस २:१२</ref></char></note>पर जो कोयी लोगों को आगु मोरो इन्कार करेंन, ओको सी मय भी अपनो स्वर्गीय पिता को आगु इन्कार करूं।”<verse eid="MAT 10:33" /></para>
  <para style="s">यीशु को आगमन को परिनाम</para>
  <para style="r">(<ref loc="LUK 12:51-53">लूका १२:५१-५३</ref>; <ref loc="LUK 14:26">१४:२६</ref>,<ref loc="LUK 14:27">२७</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />“यो मत समझो कि मय धरती पर शान्ति लावन लायी आयो हय, पर मय शान्ति लावन नहीं, पर तलवार चलावन आयो हय। <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />मय त आयो हय कि: ‘बच्चां ख ओको बाप सी, अऊर बेटी ख ओकी माय सी, अऊर बहू ख ओकी सासु सी अलग कर देऊ;’ <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" /><note caller="+" style="x"><char style="xo" closed="false">१०:३६ </char><char style="xt" closed="false"><ref loc="MIC 7:6">मीका ७:६</ref></char></note>आदमी को दुश्मन ओको घर कोच लोग होयेंन।”<verse eid="MAT 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 10:37" />“जो माय यां बाप ख मोरो सी ज्यादा अच्छो जानय हय, ऊ मोरो लायक नहाय; अऊर जो बेटा यां बेटी ख मोरो सी ज्यादा प्रिय जानय हय, ऊ मोरो लायक नहाय। <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" /><note caller="+" style="x"><char style="xo" closed="false">१०:३८ </char><char style="xt" closed="false"><ref loc="MAT 16:24">मत्ती १६:२४</ref>; <ref loc="MRK 8:34">मरकुस ८:३४</ref>; <ref loc="LUK 9:23">लूका ९:२३</ref></char></note>अऊर जो अपनो क्रूस उठाय क मोरो पीछू नहीं चलय ऊ मोरो लायक नहाय। <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" /><note caller="+" style="x"><char style="xo" closed="false">१०:३९ </char><char style="xt" closed="false"><ref loc="MAT 16:25">मत्ती १६:२५</ref>; <ref loc="MRK 8:35">मरकुस ८:३५</ref>; <ref loc="LUK 9:24">लूका ९:२४</ref>; <ref loc="LUK 17:33">१७:३३</ref>; <ref loc="JHN 12:25">यूहन्ना १२:२५</ref></char></note>जो अपनो जीव बचावय हय, ऊ ओख खोयेंन; अऊर जो मोरो वजह अपनो जीव खोवय हय, ऊ ओख पायेंन।”<verse eid="MAT 10:39" /></para>
  <para style="s">प्रतिफल</para>
  <para style="r">(<ref loc="MRK 9:41">मरकुस ९:४१</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१०:४० </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:16">लूका १०:१६</ref>; <ref loc="JHN 13:20">यूहन्ना १३:२०</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:37">मरकुस ९:३७</ref>; <ref loc="LUK 9:48">लूका ९:४८</ref></char>
    </note>“जो तुम्ख स्वीकार करय हय, ऊ मोख स्वीकार करय हय; अऊर जो मोख स्वीकार करय हय, ऊ मोरो भेजन वालो ख स्वीकार करय हय। <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />जो भविष्यवक्ता ख भविष्यवक्ता जान क स्वीकार करय, ऊ भविष्यवक्ता को प्रतिफल पायेंन; अऊर जो सच्चो ख सच्चो जान क स्वीकार करे, ऊ सच को प्रतिफल पायेंन। <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />जो कोयी इन छोटो म सी एक ख मोरो चेला जान क मोख केवल एक गिलास ठंडो पानी पिलाये, त मय तुम सी सच कहूं हय, ऊ कोयी रीति सी अपनो प्रतिफल जरूर पायेंन।”<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">बपतिस्मा देन वालो यूहन्ना को तरफ सी सन्देश</para>
  <para style="r">(<ref loc="LUK 7:18-35">लूका ७:१८-३५</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />जब यीशु अपनो बारयी चेलावों ख शिक्षा दे चुक्यो, त ऊ उन्को नगरों म उपदेश अऊर प्रचार करन ख उत सी चली गयो।<verse eid="MAT 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 11:2" />जब यूहन्ना न जेलखाना म मसीह को कामों को समाचार सुन्यो अऊर अपनो चेलावों ख ओको सी यो पूछन भेज्यो, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />“का आवन वालो तयच आय, का हम कोयी दूसरों की रस्ता देखबो?”<verse eid="MAT 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 11:4" />यीशु न उत्तर दियो, “जो कुछ तुम सुनय हय अऊर देखय हय, ऊ सब जाय क यूहन्ना सी कह्य देवो, <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />कि अन्धा देखय हंय अऊर लंगड़ा चलय फिरय हंय, कोढ़ी शुद्ध करयो जावय हंय, अऊर बहिरा सुनय हंय, मुर्दों ख जीन्दो करयो जावय हंय, अऊर गरीबों ख सुसमाचार सुनायो जावय हय। <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />अऊर धन्य हय, जो मोरो वजह ठोकर नहीं खावय।”<verse eid="MAT 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 11:7" />जब हि उत सी चली गयो, त यीशु यूहन्ना को बारे म लोगों सी कहन लग्यो, “तुम सुनसान जंगल म का देखन गयो होतो? का हवा सी हलतो हुयो घास ख? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />तब तुम का देखन गयो होतो? का चमकदार कपड़ा पहिन्यो हुयो आदमी ख? देखो, जो चमकदार कपड़ा पहिनय हंय, हि राजभवनों म रह्य हंय! <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />त फिर कहाली गयो होतो? का कोयी भविष्यवक्ता ख देखन ख? हव, मय तुम सी कहू हय कि भविष्यवक्ता सी भी बड़ो ख। <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" /><note caller="+" style="x"><char style="xo" closed="false">११:१० </char><char style="xt" closed="false"><ref loc="MAL 3:1">मलाकी ३:१</ref></char></note>यो उच आय जेको बारे म लिख्यो हय: ‘देख, मय अपनो दूत ख तोरो आगु भेजूं हय, जो तोरो आगु तोरो रस्ता तैयार करेंन।’ <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />मय तुम सी सच कहू हय कि जो बाईयों सी जनम लियो हय, उन्म सी यूहन्ना बपतिस्मा देन वालो सी कोयी बड़ो नहीं भयो; पर जो स्वर्ग को राज्य म छोटो सी छोटो हय ऊ ओको सी बड़ो हय। <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" /><note caller="+" style="x"><char style="xo" closed="false">११:१२ </char><char style="xt" closed="false"><ref loc="LUK 16:16">लूका १६:१६</ref></char></note>यूहन्ना बपतिस्मा देन वालो को दिनो सी अब तक स्वर्ग को राज्य म बलपूर्वक सिरतो रह्यो हय, अऊर बलवान ओख छीन लेवय हंय। <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />कहालीकि सब भविष्यवक्तावों अऊर मूसा की व्यवस्था, यूहन्ना को आनो तक भविष्यवानी करत रह्यो होतो। <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" /><note caller="+" style="x"><char style="xo" closed="false">११:१४ </char><char style="xt" closed="false"><ref loc="MAT 17:10-13">मत्ती १७:१०-१३</ref>; <ref loc="MRK 9:11-13">मरकुस ९:११-१३</ref></char></note>अऊर चाहो त मानो कि एलिय्याह जो आवन वालो होतो, ऊ योच आय। <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />जेको कान होना ऊ सुन ले।<verse eid="MAT 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 11:16" />“मय यो पीढ़ी को लोगों की तुलना कौन्को सी करू? हि उन बच्चां को जसो हंय, जो बजार म बैठ्यो हुयो एक दूसरों सी पुकार क कह्य हंय: <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />‘हम न तुम्हरो लायी बांसुरी बजायी, अऊर तुम नहीं नाच्यो; हम न विलाप करयो, अऊर तुम रोयो नहीं।’ <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />कहालीकि यूहन्ना बपतिस्मा देन वालो नहीं खातो आयो अऊर नहीं पीतो, अऊर हि कह्य हंय, ‘ओको म दुष्ट आत्मा हय।’ <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />आदमी को बेटा खातो पीतो आयो, अऊर हि कह्य हंय ‘देखो, खादाड़ अऊर पियक्कड़ आदमी, कर लेनवालो अऊर पापियों को संगी!’ पर परमेश्वर को ज्ञान अपनो कामों सी सच्चो ठहरायो गयो हय।”<verse eid="MAT 11:19" /></para>
  <para style="s">अविश्वासी गांव</para>
  <para style="r">(<ref loc="LUK 10:13-15">लूका १०:१३-१५</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />तब यीशु उन नगरों को बारे म धिक्कारन लग्यो, जिन्म ओन बहुत सो सामर्थ को काम करयो होतो, लेकिन उन्न अपनो मन नहीं फिरायो होतो। <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />“हाय, खुराजीन! हाय, बैतसैदा! नगर जो सामर्थ को काम तुम म करयो गयो, यदि हि सूर अऊर सैदा म करयो जातो, त बोरा ओढ़ क, अऊर राखड़ म बैठ क हि अपनो पापों सी कब को फिराय लेतो। <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />पर मय तुम सी कहू हय कि न्याय को दिन तुम्हरी दशा सी सूर अऊर सैदा की दशा जादा सहन लायक होयेंन। <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />हे कफरनहूम, का तय स्वर्ग तक ऊंचो करयो जाजो? तय त अधोलोक तक खल्लो जाजो! जो सामर्थ को काम तोरो म करयो गयो हंय, यदि सदोम म करयो जातो, त ऊ अज तक बन्यो रहतो। <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" /><note caller="+" style="x"><char style="xo" closed="false">११:२४ </char><char style="xt" closed="false"><ref loc="MAT 10:15">मत्ती १०:१५</ref>; <ref loc="LUK 10:12">लूका १०:१२</ref></char></note>पर मय तुम सी कहू हय कि न्याय को दिन तोरी दशा सी सदोम की दशा जादा सहन लायक होयेंन।”<verse eid="MAT 11:24" /></para>
  <para style="s">बोझ सी दब्यो लोगों लायी आराम</para>
  <para style="r">(<ref loc="LUK 10:21">लूका १०:२१</ref>,<ref loc="LUK 10:22">२२</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />उच समय यीशु न कह्यो, “हे बाप, स्वर्ग अऊर धरती को प्रभु, मय तोरो धन्यवाद करू हय कि तय न इन बातों ख ज्ञानियों अऊर पड़्यो लिख्यो सी लुकाय क रख्यो हय, अऊर बच्चां पर प्रगट करयो हय। <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />हव, हे बाप, कहालीकि तोख योच अच्छो लग्यो।<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">११:२७ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 3:35">यूहन्ना ३:३५</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:18">यूहन्ना १:१८</ref>; <ref loc="JHN 10:15">१०:१५</ref></char>
    </note>“मोरो बाप न मोख सब कुछ सौंप दियो हय; अऊर कोयी बेटा ख नहीं जानय, केवल बाप ख; अऊर कोयी बाप ख नहीं जानय, केवल बेटा ख; अऊर ऊ जेक बेटा प्रगट करयो।<verse eid="MAT 11:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 11:28" />“हे सब मेहनत करन वालो अऊर बोझ सी दब्यो हुयो लोगों, मोरो जवर आवो; मय तुम्ख आराम देऊं। <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />मोरो बोझ अपनो ऊपर उठाय लेवो, अऊर मोरो सी सीखो; कहालीकि मय नम्र अऊर मन म नरम हय: अऊर तुम अपनो मन म आराम पावों। <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />कहालीकि मोरो जूवा सहज अऊर मोरो बोझ हल्को हय।”<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">आराम दिन को बारे म प्रश्न</para>
  <para style="r">(<ref loc="MRK 2:23-28">मरकुस २:२३-२८</ref>; <ref loc="LUK 6:1-5">लूका ६:१-५</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />ऊ समय यीशु आराम दिन म खेतो म सी होय क जाय रह्यो होतो, अऊर ओको चेलावों ख भूख लगी त हि गहूं को लोम्बा तोड़-तोड़ क खान लग्यो। <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />फरीसियों न यो देख क ओको सी कह्यो, “देख, तोरो चेला ऊ काम कर रह्यो हंय, जो आराम को दिन मूसा को नियम को अनुसार उचित नहाय।”<verse eid="MAT 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 12:3" />यीशु उन्को सी कह्यो, “का तुम्न नहीं पढ़्यो, कि जब दाऊद अऊर ओको संगी ख भूख लगी त ओन का करयो? <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />ऊ कसो परमेश्वर को मन्दिर म गयो, अऊर अर्पन की रोटी खायी, ओख अऊर ओको संगियों ख उन्की रोटी मूसा को नियम को अनुसार उचित नहाय। पर केवल याजकों ख उचित होतो? <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />का तुम न मूसा की व्यवस्था म नहीं पढ़्यो कि याजक आराम दिन को मन्दिर म आराम दिन की विधि ख तोड़न पर भी निर्दोष ठहरय हंय? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />पर मय तुम सी कहू हय कि इत ऊ हय जो आराधनालय सी भी बड़ो हय।” <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" /><note caller="+" style="x"><char style="xo" closed="false">१२:७ </char><char style="xt" closed="false"><ref loc="MAT 9:13">मत्ती ९:१३</ref></char></note>“यदि तुम येको मतलब जानतो, ‘मय दया सी सन्तुष्ट होऊं हय, बलिदान सी नहीं,’ त तुम निर्दोष ख दोषी नहीं ठहरायतो। <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />आदमी को बेटा त आराम दिन को भी प्रभु आय।”<verse eid="MAT 12:8" /></para>
  <para style="s">सूख्यो हाथ वालो आदमी की चंगायी</para>
  <para style="r">(<ref loc="MRK 3:1-6">मरकुस ३:१-६</ref>; <ref loc="LUK 6:6-11">लूका ६:६-११</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />उत सी चल क यीशु उन्को सभागृह म आयो। <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />उत एक आदमी होतो, जेको हाथ म लकवा भयो होतो। फरीसियों न यीशु पर दोष लगावन लायी ओको सी पुच्छ्यो, “का आराम को दिन नियम को अनुसार चंगो करनो उचित हय?”<verse eid="MAT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 12:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:११ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 14:5">लूका १४:५</ref>
      </char>
    </note>यीशु न उन्को सी कह्यो, “तुम म असो कौन हय जेकी एकच मेंढीं हय, अऊर ऊ आराम दिन गड्डा म गिर जाये, त ऊ ओख पकड़ क नहीं निकालेंन? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />भलो, आदमी की कीमत मेंढा सी कितनो बढ़ क हय! येकोलायी आराम दिन म भलायी करनो नियम को अनुसार उचित हय।” <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />तब यीशु न ऊ आदमी सी कह्यो, “अपनो हाथ बढ़ाव।”</para>
  <para style="p" vid="MAT 12:13">ओन बढ़ायो, अऊर ऊ तब दूसरों हाथ को जसो अच्छो भय गयो। <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />तब फरीसियों न बाहेर जाय क ओको विरोध म चर्चा करयो कि ओख कसो तरह सी नाश करबो।<verse eid="MAT 12:14" /></para>
  <para style="s">परमेश्वर को चुन्यो हुयो सेवक</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />यो जान क यीशु उत सी चली गयो। अऊर बहुत लोग ओको पीछू होय लियो, अऊर ओन सब ख चंगो करयो, <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />अऊर उन्ख चितायो कि मोख प्रगट मत करजो, <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />ताकि जो वचन यशायाह भविष्यवक्ता सी कह्यो गयो होतो, ऊ पूरो हो:<verse eid="MAT 12:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="MAT 12:18" />“देखो, यो मोरो सेवक आय, जेक मय न चुन्यो हय:</para>
  <para style="q2" vid="MAT 12:18">मोरो प्रिय, जेकोसी मोरो मन खुश हय:</para>
  <para style="q1" vid="MAT 12:18">मय अपनी आत्मा ओको पर डालू,</para>
  <para style="q2" vid="MAT 12:18">अऊर ऊ गैरयहूदियों ख न्याय को सुसमाचार देयेंन।<verse eid="MAT 12:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="MAT 12:19" />ऊ नहीं झगड़ा करेंन, अऊर नहीं धूम मचायेंन,</para>
  <para style="q2" vid="MAT 12:19">अऊर नहीं बजारों म जोर सी चिल्लाय क भाषन सुनायेंन।<verse eid="MAT 12:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="MAT 12:20" />ऊ कुचल्यो हुयो घास ख नहीं तोड़ेंन,</para>
  <para style="q2" vid="MAT 12:20">अऊर धुवा देन वाली बत्ती ख नहीं बुझायेंन,</para>
  <para style="q1" vid="MAT 12:20">जब तक ऊ न्याय ख मजबूत नहीं कराये।<verse eid="MAT 12:20" /></para>
  <para style="q2">
    <verse number="21" style="v" sid="MAT 12:21" />अऊर पूरो राष्ट्र को लोग ओको नाम पर आशा रखेंन।”<verse eid="MAT 12:21" /></para>
  <para style="s">यीशु अऊर बालजबूल</para>
  <para style="r">(<ref loc="MRK 3:20-30">मरकुस ३:२०-३०</ref>; <ref loc="LUK 11:14-23">लूका ११:१४-२३</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />तब लोग एक अन्धा अऊर मुक्का ख यीशु को जवर लायो; जेको म दुष्ट आत्मायें होती, अऊर ओन ओख अच्छो करयो, अऊर ऊ बोलन अऊर देखन लग्यो। <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />येको पर सब लोग अचम्भित होय क कहन लग्यो, “यो का दाऊद की सन्तान आय?”<verse eid="MAT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 12:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:२४ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:34">मत्ती ९:३४</ref>; <ref loc="MAT 10:25">१०:२५</ref></char>
    </note>पर फरीसियों न यो सुन क कह्यो, “यो त दुष्ट आत्मावों को मुखिया बालजबूल की मदत को बिना शैतानी आत्मावों ख नहीं निकालय।”<verse eid="MAT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 12:25" />यीशु न उन्को मन की बात जान क उन्को सी कह्यो, “जो कोयी राज्य म फूट होवय हय, ऊ उजड़ जावय हय; अऊर कोयी नगर यां घराना जेको म फूट होवय हय, बन्यो नहीं रहेंन।” <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />अऊर यदि शैतानच शैतान ख निकाले, त ऊ अपनोच विरोधी भय गयो हय; तब ओको राज्य कसो बन्यो रहेंन? <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />भलो, यदि मय बालजबूल की मदत सी दुष्ट आत्मावों ख निकालू हय, त तुम्हरो अनुयायी कौन की मदत सी निकालय हंय? येकोलायी हिच तुम्हरो न्याय करेंन। <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />पर यदि मय परमेश्वर की आत्मा की मदत सी दुष्ट आत्मावों ख निकालू हय, त परमेश्वर को राज्य तुम्हरो जवर आय गयो हय।<verse eid="MAT 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 12:29" />“कसो कोयी आदमी कोयी ताकतवर को घर म घुस क ओको माल लूट सकय हय जब तक कि पहिले ऊ ताकतवर ख नहीं बान्ध ले? तब तक ऊ ओको घर को माल लूट नहीं लेयेंन।”<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:३० </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:40">मरकुस ९:४०</ref>
      </char>
    </note>जो मोरो संग नहाय ऊ मोरो विरोध म हय, अऊर जो मोरो संग नहीं ऊ जमा करय हय अऊर बिखरावय हय। <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />येकोलायी मय तुम सी कहू हय कि आदमी को सब तरह को पाप अऊर निन्दा माफ करयो जायेंन, पर पवित्र आत्मा कि निन्दा माफ नहीं करी जायेंन। <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" /><note caller="+" style="x"><char style="xo" closed="false">१२:३२ </char><char style="xt" closed="false"><ref loc="LUK 12:10">लूका १२:१०</ref></char></note>जो कोयी आदमी को बेटा को विरोध म कोयी बात कहेंन, ओको यो अपराध माफ करयो जायेंन, पर जो कोयी पवित्र आत्मा को विरोध म कुछ कहेंन, ओको अपराध नहीं त यो जगत म अऊर नहीं स्वर्ग म माफ करयो जायेंन।<verse eid="MAT 12:32" /></para>
  <para style="s">झाड़ अऊर ओको फर</para>
  <para style="r">(<ref loc="LUK 6:43-45">लूका ६:४३-४५</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:३३ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:20">मत्ती ७:२०</ref>; <ref loc="LUK 6:44">लूका ६:४४</ref></char>
    </note>“यदि एक झाड़ अच्छो हय, त ओको फर भी अच्छो रहेंन, यदि एक झाड़ बुरो हय, त ओको फर भी बुरो रहेंन; कहालीकि झाड़ अपनो फर सीच पहिचान्यो जावय हय। <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" /><note caller="+" style="x"><char style="xo" closed="false">१२:३४ </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्ती ३:७</ref>; <ref loc="MAT 23:33">२३:३३</ref>; <ref loc="LUK 3:7">लूका ३:७</ref>; </char><char style="xt" closed="false"><ref loc="MAT 15:18">मत्ती १५:१८</ref>; <ref loc="LUK 6:45">लूका ६:४५</ref></char></note>हे सांप को बच्चां, तुम बुरो होय क कसी अच्छी बाते कह्य सकय हय? कहालीकि जो मन म भरयो हय, उच मुंह पर आवय हय। <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />अच्छो आदमी मन को अन्दर सी अच्छी बाते निकालय हय, अऊर बुरो आदमी उच मन सी बुरी बाते निकालय हय।<verse eid="MAT 12:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 12:36" />“अऊर मय तुम सी कहू हय कि जो बुरी बाते आदमी कहेंन, न्याय को दिन हि हर एक वा बात को हिसाब देयेंन। <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />कहालीकि तय अपनी बातों को वजह निर्दोष, अऊर अपनी बातों को वजह दोषी ठहरायो जाजो।”<verse eid="MAT 12:37" /></para>
  <para style="s">स्वर्गीय चिन्ह की मांग</para>
  <para style="r">(<ref loc="MRK 8:11">मरकुस ८:११</ref>,<ref loc="MRK 8:12">१२</ref>; <ref loc="LUK 11:29-32">लूका ११:२९-३२</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:३८ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:1">मत्ती १६:१</ref>; <ref loc="MRK 8:11">मरकुस ८:११</ref>; <ref loc="LUK 11:16">लूका ११:१६</ref></char>
    </note>येको पर कुछ धर्मशास्त्रियों अऊर फरीसियों न ओको सी कह्यो, “हे गुरु, हम तोरो सी एक चमत्कार को चिन्ह देखनो चाहजे हय।”<verse eid="MAT 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 12:39" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:३९ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:4">मत्ती १६:४</ref>; <ref loc="MRK 8:12">मरकुस ८:१२</ref></char>
    </note>ओन उन्ख उत्तर दियो, “यो पीढ़ी को बुरो अऊर व्यभिचारी लोग चिन्ह ढूंढय हंय, पर योना भविष्यवक्ता को चिन्ह ख छोड़ कोयी अऊर चिन्ह उन्ख नहीं दियो जायेंन। <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />योना तीन दिन अऊर तीन रात बड़ी मच्छी को पेट म रह्यो, वसोच आदमी को बेटा तीन दिन अऊर तीन रात धरती को अन्दर रहेंन। <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />नीनवे को लोग न्याय को दिन यो पीढ़ी को लोगों को संग उठ क उन्ख दोषी ठहरायेंन, कहालीकि उन्न योना को प्रचार सुन क मन फिरायो; अऊर देखो, इत ऊ हय जो योना सी भी बड़ो हय। <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />दक्षिन की रानी न्याय को दिन यो पीढ़ी को लोगों को संग उठ क उन्ख दोषी ठहरायेंन, कहालीकि ऊ सुलैमान को ज्ञान सुनन लायी धरती को छोर सी आयी हय; अऊर देखो, इत ऊ हय जो सुलैमान सी भी बड़ो हय।<verse eid="MAT 12:42" /></para>
  <para style="s">शैतानी आत्मा की वापसी</para>
  <para style="r">(<ref loc="LUK 11:24-26">लूका ११:२४-२६</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />“जब दुष्ट आत्मा आदमी म सी निकल जावय हय, त सूखी जागा म आराम ढूंढती फिरय हय, अऊर नहीं पावय हय। <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />तब कह्य हय, ‘मय अपनो उच घर म जित सी निकली होती, उतच लौट जाऊं।’ अऊर लौट क आवय हय त ओख खाली, झाड़्यो-बुहारयो अऊर सज्यो-सजायो पावय हय। <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />तब ऊ जाय क अपनो सी अऊर बुरी सात आत्मावों ख अपनो संग लावय हय। अऊर हि ओको म घुस क उत वाश करय हंय, अऊर ऊ आदमी की पुरानी दशा पहिले सी भी बुरी होय जावय हय। त यो पीढ़ी को बुरो लोगों की दशा भी असीच होयेंन।”<verse eid="MAT 12:45" /></para>
  <para style="s">यीशु की माय अऊर भाऊ</para>
  <para style="r">(<ref loc="MRK 3:31-35">मरकुस ३:३१-३५</ref>; <ref loc="LUK 8:19-21">लूका ८:१९-२१</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />जब यीशु भीड़ सी बाते कर रह्यो होतो, तब ओकी माय अऊर भाऊ बाहेर खड़ो होतो अऊर ओको सी बाते करनो चाहत होतो। <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />कोयी न यीशु सी कह्यो, “देख, तोरी माय अऊर तोरो भाऊ बाहेर खड़ो हंय। अऊर तोरो सी बाते करनो चाहवय हंय।”<verse eid="MAT 12:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MAT 12:48" />यो सुन क यीशु न कहन वालो ख उत्तर दियो, “कौन आय मोरी माय? अऊर कौन हंय मोरो भाऊ?” <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />अऊर अपनो चेलावों को तरफ अपनो हाथ बढ़ाय क कह्यो, “देखो, मोरी माय अऊर मोरो भाऊ हि आय। <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />कहालीकि जो कोयी मोरो स्वर्गीय पिता की इच्छा पर चलय हय, उच मोरो भाऊ, अऊर मोरी बहिन, अऊर मोरी माय आय।”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">बीज बोवन वालो को दृष्टान्त</para>
  <para style="r">(<ref loc="MRK 4:1-9">मरकुस ४:१-९</ref>; <ref loc="LUK 8:4-8">लूका ८:४-८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />उच दिन यीशु घर सी निकल क झील को किनार को जवर जाय बैठ्यो। <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" /><note caller="+" style="x"><char style="xo" closed="false">१३:२ </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">लूका ५:१-३</ref></char></note>अऊर ओको जवर असी बड़ी भीड़ जमा भयी कि ऊ डोंगा पर चढ़ गयो, अऊर पूरी भीड़ किनार पर खड़ी रही। <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />अऊर ओन उन्को सी दृष्टान्तों म बहुत सी बाते कहीं।</para>
  <para style="p" vid="MAT 13:3">“एक बोवन वालो बीज बोवन निकल्यो। <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />बोवतो समय कुछ बीज रस्ता को किनारे गिरयो अऊर पक्षिंयों न आय क उन्ख खाय लियो। <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />कुछ बीज गोटाड़ी जमीन पर गिरयो, जित उन्ख जादा माटी नहीं मिली अऊर गहरी माटी नहीं मिलन को वजह हि जल्दी उग गयो। <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />पर सूरज निकलन पर हि जर गयो, अऊर जमीन म जड़ी नहीं पकड़न को वजह हि सूख गयो। <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />कुछ बीज काटा को झुडूप म गिरयो अऊर काटा को झुडूप न बढ़ क उन्ख दबाय डाल्यो। <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />पर कुछ बीज अच्छी जमीन पर गिरयो, अऊर फर लायो, कोयी सौ गुना, कोयी साठ गुना, अऊर कोयी तीस गुना। <figure style="fig" alt="Jesus teaching the crowd by the sea" file="lb00299c.tif" size="col" copy="Horace Knowles ©" ref="१३:२">समुन्दर म डोंगा पर चढ़ क यीशु भीड़ ख शिक्षा देतो हुयो</figure><verse eid="MAT 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 13:9" />“जेको कान हय ऊ सुन ले।”<verse eid="MAT 13:9" /></para>
  <para style="s">दृष्टान्तों को उद्देश्य</para>
  <para style="r">(<ref loc="MRK 4:10-12">मरकुस ४:१०-१२</ref>; <ref loc="LUK 8:9-10">लूका ८:९-१०</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />चेलावों न जवर आय क यीशु सी कह्यो, “तय लोगों सी दृष्टान्तों म कहाली बाते करय हय?”<verse eid="MAT 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 13:11" />यीशु न उत्तर दियो, “तुम ख स्वर्ग को राज्य को भेद की समझ दी गयी हय, पर उन्ख नहीं।” <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" /><note caller="+" style="x"><char style="xo" closed="false">१३:१२ </char><char style="xt" closed="false"><ref loc="MAT 25:29">मत्ती २५:२९</ref>; <ref loc="MRK 4:25">मरकुस ४:२५</ref>; <ref loc="LUK 8:18">लूका ८:१८</ref>; <ref loc="LUK 19:26">१९:२६</ref></char></note>कहालीकि जेको जवर हय, ओख दियो जायेंन, अऊर ओको जवर बहुत होय जायेंन; पर जेको जवर कुछ भी नहाय, ओको सी सब कुछ भी ले लियो जायेंन। <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />मय उन्को सी दृष्टान्तों म येकोलायी बाते करू हय कि हि देखतो हुयो भी नहीं देखय अऊर सुनतो हुयो भी नहीं सुनय, अऊर नहीं समझय। <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" /><note caller="+" style="x"><char style="xo" closed="false">१३:१४ </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यशायाह ६:९-१०</ref></char></note>उन्को बारे म यशायाह की या भविष्यवानी पूरी होवय हय:</para>
  <para style="q1" vid="MAT 13:14">“तुम कानो सी त सुनो, पर समझो नहीं;</para>
  <para style="q2" vid="MAT 13:14">अऊर आंखी सी त देखो, पर तुम्ख दिखेंन नहीं।<verse eid="MAT 13:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="MAT 13:15" />कहालीकि इन लोगों को मन मोटो भय गयो हय,</para>
  <para style="q2" vid="MAT 13:15">अऊर हि कानो सी ऊचो सुनय हंय</para>
  <para style="q2" vid="MAT 13:15">अऊर उन्न अपनी आंखी मूंद लियो हंय;</para>
  <para style="q1" vid="MAT 13:15">कहीं असो नहीं होय कि हि आंखी सी देखे,</para>
  <para style="q2" vid="MAT 13:15">अऊर कानो सी सुने</para>
  <para style="q2" vid="MAT 13:15">अऊर मन सी समझे,</para>
  <para style="q1" vid="MAT 13:15">अऊर फिर जाय,</para>
  <para style="q2" vid="MAT 13:15">अऊर मय उन्ख चंगो करूं।”<verse eid="MAT 13:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 13:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१३:१६ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:23">लूका १०:२३</ref>,<ref loc="LUK 10:24">२४</ref></char>
    </note>पर धन्य हंय तुम्हरी आंखी, की वा देखय हंय; अऊर तुम्हरो कान की सुनय हंय। <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />कहालीकि मय तुम सी सच कहू हय कि बहुत सो भविष्यवक्तावों न अऊर न्यायियों न चाह्यो कि जो बाते तुम देखय हय, देखो, पर नहीं देख पायो; अऊर जो बाते तुम सुनय हय, सुनो, पर नहीं सुन सको।<verse eid="MAT 13:17" /></para>
  <para style="s">बीज बोवन वालो दृष्टान्त की व्याख्या</para>
  <para style="r">(<ref loc="MRK 4:13-20">मरकुस ४:१३-२०</ref>; <ref loc="LUK 8:11-15">लूका ८:११-१५</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />“अब तुम बोवन वालो को दृष्टान्त को मतलब सुनो: <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />जो कोयी राज्य को वचन सुन क नहीं समझय, ओको मन म जो कुछ बोयो गयो होतो, ओख ऊ शैतान आय क छीन लेवय हय। यो उच वचन आय, जो रस्ता को किनार म बोयो गयो होतो। <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />अऊर जो गोटाड़ी जमीन पर बोयो गयो, यो ऊ आय, जो वचन सुन क तुरतच खुशी को संग मान लेवय हय। <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />पर अपनो म जड़ी नहीं रखन को वजह ऊ थोड़ो दिन को हय, अऊर जब वचन को वजह कठिनायी यां उपद्रव होवय हय, त तुरतच ठोकर खावय हय। <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />जो काटा को झुड़ूप म बोयो गयो, यो ऊ आय, जो वचन ख सुनय हय, पर यो जगत की चिन्ता अऊर धन को धोका वचन ख दबाय देवय हय, अऊर ऊ फर नहीं लावय। <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />जो अच्छी जमीन म बोयो गयो, यो ऊ आय, जो वचन ख सुन क समझय हय, अऊर फर लावय हय; कोयी सौ गुना, कोयी साठ गुना, अऊर कोयी तीस गुना।”<verse eid="MAT 13:23" /></para>
  <para style="s">जंगली बीज को दृष्टान्त</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />यीशु न उन्ख एक अऊर दृष्टान्त दियो: “स्वर्ग को राज्य ऊ आदमी को जसो हय जेन अपनो खेत म अच्छो बीज बोयो। <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />पर जब लोग सोय रह्यो होतो त ओको दुश्मन आय क गहूं को बीच म जंगली बीज बोय क चली गयो। <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />जब अंकुर निकल्यो अऊर लोम्ब लगी, त जंगली दाना को पौधा भी दिखायी दियो। <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />येको पर घर को सेवकों न आय क ओको सी कह्यो, ‘हे मालिक, का तय न अपनो खेत म अच्छो बीज नहीं बोयो होतो? तब जंगली दाना को पौधा ओको म कित सी आयो?’ <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />ओन उन्को सी कह्यो, ‘यो कोयी दुश्मन को काम आय।’ सेवकों न ओको सी कह्यो, ‘का तोरी इच्छा हय, कि हम जाय क उन पौधा ख उखाड़ दे?’ <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />ओन कह्यो, ‘नहीं, असो नहीं होय कि जंगली दाना को पौधा जमा करतो हुयो तुम उन्को संग गहूं भी उखाड़ लेवो। <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />काटन तक दोयी ख एक संग बढ़न देवो, अऊर काटन को समय मय काटन वालो सी कहूं कि पहिले जंगली दाना को पौधा जमा कर क् जलावन लायी उन्को बोझा बान्ध लेवो, अऊर गहूं ख मोरो ढोला म जमा कर देवो।’”<verse eid="MAT 13:30" /></para>
  <para style="s">राई को बीज को दृष्टान्त</para>
  <para style="r">(<ref loc="MRK 4:30-32">मरकुस ४:३०-३२</ref>; <ref loc="LUK 13:18">लूका १३:१८</ref>,<ref loc="LUK 13:19">१९</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />यीशु न उन्ख एक अऊर दृष्टान्त दियो: “स्वर्ग को राज्य राई को एक दाना को जसो हय, जेक कोयी आदमी न ले क अपनो खेत म बोय दियो। <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />ऊ सब बीज सी छोटो त होवय हय पर जब बढ़ जावय हय तब सब साग-पात सी बड़ो होवय हय; अऊर असो झाड़ होय जावय हय कि आसमान को पक्षी आय क ओकी डगालियों पर बसेरा करय हंय।”<verse eid="MAT 13:32" /></para>
  <para style="s">खमीर को दृष्टान्त</para>
  <para style="r">(<ref loc="LUK 13:20">लूका १३:२०</ref>,<ref loc="LUK 13:21">२१</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />यीशु न एक अऊर दृष्टान्त उन्को सी कह्यो: “स्वर्ग को राज्य खमीर को जसो हय जेक एक बाई तीन पसेरी मतलब बारा किलो खमीर आटा म मिलाय दियो अऊर तब तक मिलावत रही जब तक चुन आखिर म फुग नहीं जाये।”<verse eid="MAT 13:33" /></para>
  <para style="s">यीशु को द्वारा दृष्टान्तों को प्रयोग</para>
  <para style="r">(<ref loc="MRK 4:33">मरकुस ४:३३</ref>,<ref loc="MRK 4:34">३४</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 13:34" />या सब बाते यीशु न दृष्टान्तों म लोगों सी कहीं, अऊर बिना दृष्टान्त सी ऊ उन्को सी कुछ नहीं कहत होतो, <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" /><note caller="+" style="x"><char style="xo" closed="false">१३:३५ </char><char style="xt" closed="false"><ref loc="PSA 78:2">भजन ७८:२</ref></char></note>कि जो वचन भविष्यवक्ता सी कह्यो गयो होतो, ऊ पूरो हो:</para>
  <para style="q1" vid="MAT 13:35">“मय दृष्टान्त कहन ख अपनो मुंह खोलूं:</para>
  <para style="q2" vid="MAT 13:35">मय उन बातों ख जो जगत की उत्पत्ति सी लुक रही हंय प्रगट करूं।”<verse eid="MAT 13:35" /></para>
  <para style="s">जंगली बीज को दृष्टान्त की व्याख्या</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />तब यीशु भीड़ ख छोड़ क घर म आयो, अऊर ओको चेलावों न यीशु को जवर आय क कह्यो, “खेत को जंगली दाना को दृष्टान्त हम्ख समझाय दे।”<verse eid="MAT 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 13:37" />यीशु न उन्ख उत्तर दियो, “अच्छो बीज ख बोवन वालो आदमी को बेटा आय। <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />खेत जगत आय अच्छो बीज राज्य की सन्तान, अऊर जंगली बीज दुष्ट की सन्तान आय। <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />जो दुश्मन न उन्ख बोयो ऊ शैतान आय; कटायी जगत को अन्त हय, अऊर काटन वालो स्वर्गदूत आय। <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />येकोलायी जसो जंगली दाना जमा करयो जावय अऊर जलायो जावय हंय वसोच जगत को अन्त म होयेंन। <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />आदमी को बेटा अपनो स्वर्गदूतों ख भेजेंन, अऊर हि ओको राज्य म सी सब ठोकर को वजह ख अऊर अधर्म को काम करन वालो ख जमा करेंन, <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />अऊर उन्ख आगी को कुण्ड म डालेंन, जित रोवनो अऊर दात कटरनो होयेंन। <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />ऊ समय सच्चो लोग अपनो स्वर्गीय पिता को राज्य म सूरज को जसो चमकेंन। जेको कान हय ऊ सुन ले।<verse eid="MAT 13:43" /></para>
  <para style="s">लूक्यो हुयो खजाना को दृष्टान्त</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />“स्वर्ग को राज्य खेत म लूक्यो हुयो धन को जसो हय, जेक कोयी आदमी न पायो अऊर ओख फिर सी लूकाय दियो, अऊर ओको वजह खुश होय क ओन अपनो सब कुछ बिक दियो अऊर ऊ खेत ख लेय लियो।<verse eid="MAT 13:44" /></para>
  <para style="s">अनमोल मोती को दृष्टान्त</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />“फिर स्वर्ग को राज्य एक व्यापारी को जसो हय जो अच्छो मोतियों की खोज म होतो। <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />जब ओख एक कीमती मोती मिल्यो त ओन जाय क अपनो सब कुछ बिक डाल्यो अऊर ओख ले लियो।<verse eid="MAT 13:46" /></para>
  <para style="s">जार को दृष्टान्त</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />“फिर स्वर्ग को राज्य ऊ बड़ो जार को जसो हय जो समुन्दर म डाल्यो गयो, अऊर हर तरह की मच्छी अऊर जीवजन्तु ख जमा कर क् लायो। <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />अऊर जब जार मच्छी अऊर जीवजन्तु सी भर गयो, त मछवारों न ओख किनार पर झीकन क लायो, अऊर बैठ क अच्छो बर्तनों म मच्छी अऊर जीव ख जमा करयो अऊर बेकार बेकार ख फेक दियो। <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />जगत को अन्त म असोच होयेंन। स्वर्गदूत आय क बुरो ख सच्चो लोगों सी अलग करेंन, <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />अऊर उन्ख आगी को कुण्ड म डालेंन। जित रोवनो अऊर दात कटरनो होयेंन।<verse eid="MAT 13:50" /></para>
  <para style="s">पुरानी अऊर नयी शिक्षा को महत्व</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />“का तुम न यो सब बाते समझी?”</para>
  <para style="p" vid="MAT 13:51">चेला न उत्तर दियो “हव।”<verse eid="MAT 13:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MAT 13:52" />यीशु न उन्को सी कह्यो, “येकोलायी हर एक धर्मशास्त्री जो स्वर्ग को राज्य को चेला बन्यो हय, ऊ घर को मालिक को जसो हय जो अपनो भण्डार सी नयी अऊर पुरानी चिजे निकालय हय।”<verse eid="MAT 13:52" /></para>
  <para style="s">नासरत नगर म यीशु को इन्कार करनो</para>
  <para style="r">(<ref loc="MRK 6:1-6">मरकुस ६:१-६</ref>; <ref loc="LUK 4:16-30">लूका ४:१६-३०</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />जब यीशु यो सब दृष्टान्त कहन को बाद, उत सी चली गयो। <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />अऊर अपनो नगर म आय क उन्को आराधनालय म उन्ख असो उपदेश देन लग्यो कि हि अचम्भित होय क कहन लग्यो, “येख यो ज्ञान अऊर अद्भुत सामर्थ को काम कित सी मिल्यो? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />का यो बढ़यी को बेटा नोहोय? अऊर का येकी माय को नाम मरियम अऊर येको भाऊ को नाम याकूब, यूसुफ, शिमोन अऊर यहूदा नोहोय? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />अऊर का येकी सब बहिन हमरो बीच म नहीं रह्य? फिर येख यो सब कित सी मिल्यो?” <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" /><note caller="+" style="x"><char style="xo" closed="false">१३:५७ </char><char style="xt" closed="false"><ref loc="JHN 4:44">यूहन्ना ४:४४</ref></char></note>यो तरह उन्न ओको वजह ठोकर खायी।</para>
  <para style="p" vid="MAT 13:57">पर यीशु न उन्को सी कह्यो, “भविष्यवक्ता को अपनो देश अऊर अपनो घर ख छोड़ अऊर कहीं भी अपमान नहीं होवय।” <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />अऊर ओन उत उन्को अविश्वास को वजह बहुत सो सामर्थ को काम नहीं करयो।<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">यूहन्ना बपतिस्मा देन वालो की हत्या</para>
  <para style="r">(<ref loc="MRK 6:14-29">मरकुस ६:१४-२९</ref>; <ref loc="LUK 9:7-9">लूका ९:७-९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />ऊ समय देश को चौथाई भाग को राजा हेरोदेस न यीशु की चर्चा सुनी, <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />अऊर अपनो सेवकों सी कह्यो, “यो यूहन्ना बपतिस्मा देन वालो आय! ऊ मरयो हुयो म सी फिर सी जीन्दो भयो हय, येकोलायी ओको सी यो सामर्थ को काम प्रगट होवय हंय।”<verse eid="MAT 14:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 14:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१४:३ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 3:19">लूका ३:१९</ref>,<ref loc="LUK 3:20">२०</ref></char>
    </note>कहालीकि हेरोदेस न अपनो भाऊ फिलिप्पुस की पत्नी हेरोदियास को वजह, यूहन्ना ख पकड़ क बान्ध्यो अऊर जेलखाना म डाल दियो होतो। <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />कहालीकि यूहन्ना न ओको सी कह्यो होतो कि येख रखनो तोरो लायी उचित नहाय। <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />येकोलायी ऊ ओख मार डालनो चाहत होतो, पर लोगों सी डरत होतो कहालीकि हि ओख भविष्यवक्ता मानत होतो।<verse eid="MAT 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 14:6" />पर जब हेरोदेस को जनम दिन आयो, त हेरोदियास की बेटी न उत्सव म नाच दिखाय क हेरोदेस ख खुश करयो। <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />येको पर ओन कसम खाय क वचन दियो, “जो कुछ तय मोख मांगजो, मय तोख देऊं।”<verse eid="MAT 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 14:8" />वा अपनी माय ख उकसायो जानो सी बोली, “यूहन्ना बपतिस्मा देन वालो को मुंड थारी म यहां मोख मंगाय देवो।”<verse eid="MAT 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 14:9" />राजा दु:खी भयो, पर अपनी कसम को, अऊर संग म जेवन करन बैठन वालो को वजह, आज्ञा दियो कि दे दियो जाये। <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />अऊर ओन जेलखाना म लोगों ख भेज क यूहन्ना को मुंड कटाय दियो; <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />अऊर ओको मुंड थारी म लायो अऊर बेटी ख दियो गयो, अऊर ओन अपनी माय को जवर ले गयी। <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />तब यूहन्ना को चेला आयो अऊर ओकी लाश ख लिजाय क गाड़ दियो, अऊर जाय क यीशु ख समाचार दियो।<verse eid="MAT 14:12" /></para>
  <para style="s">पाच हजार आदमियों ख खिलानो</para>
  <para style="r">(<ref loc="MRK 6:30-44">मरकुस ६:३०-४४</ref>; <ref loc="LUK 9:10-17">लूका ९:१०-१७</ref>; <ref loc="JHN 6:1-14">यूहन्ना ६:१-१४</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />जब यीशु न यूहन्ना को बारे म यो सुन्यो, त ऊ डोंगा पर चढ़ क उत सी कोयी सुनसान जागा को, एकान्त म चली गयो। लोग यो सुन क नगर-नगर सी पैदल चल ख ओको पीछू चली गयो। <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />ओन निकल क एक बड़ी भीड़ देखी अऊर उन पर तरस खायो, अऊर उन्को बीमारों ख चंगो करयो।<verse eid="MAT 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 14:15" />जब शाम भयी त ओको चेलावों न ओको जवर आय क कह्यो, “यो सुनसान जागा आय अऊर देर होय रही हय; लोगों ख बिदा करयो जाये कि हि बस्तियों म जाय क अपनो लायी भोजन ले ले।”<verse eid="MAT 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 14:16" />पर यीशु न उन्को सी कह्यो, “उन्को जानो जरूरी नहाय! तुमच इन्क खान ख देवो।”<verse eid="MAT 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 14:17" />उन्न ओको सी कह्यो, “इत हमरो जवर पाच रोटी अऊर दोय मच्छी ख छोड़ क अऊर कुछ नहाय।”<verse eid="MAT 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 14:18" />यीशु न कह्यो, “उन्ख इत मोरो जवर लावो।” <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />तब यीशु न लोगों ख घास पर बैठन ख कह्यो, अऊर उन पाच रोटी अऊर दोय मच्छी ख लियो; अऊर स्वर्ग को तरफ देख क धन्यवाद करयो अऊर रोटी तोड़-तोड़ क चेलावों ख दियो, अऊर चेलावों न लोगों ख। <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />जब सब लोग खाय क सन्तुष्ट भय गयो, त चेलावों न बच्यो हुयो टुकड़ा सी भरी हुयी बारा टोकनियां उठायी। <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />अऊर खान वालो बाईयों अऊर बच्चां ख छोड़ क, पाच हजार आदमियों को लगभग होतो।<verse eid="MAT 14:21" /></para>
  <para style="s">यीशु को पानी पर चलनो</para>
  <para style="r">(<ref loc="MRK 6:45-52">मरकुस ६:४५-५२</ref>; <ref loc="JHN 6:15-21">यूहन्ना ६:१५-२१</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />तब यीशु न तुरतच अपनो चेलावों ख डोंगा पर चढ़न लायी मजबूर करयो कि हि ओको सी पहिले ओन पार चली जाये, जब तक ऊ लोगों ख बिदा करे। <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />ऊ लोगों ख बिदा कर क्, प्रार्थना करन ख अलग पहाड़ी पर चली गयो; अऊर शाम ख ऊ उत अकेलो होतो। <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />ऊ समय डोंगा किनार सी दूर झील को बीच लहरो सी डगमगावत होतो, कहालीकि हवा आगु की होती।<verse eid="MAT 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 14:25" />अऊर यीशु तीन बजे सी छे बजे को बीच भुन्सारो म झील पर चलतो हुयो उन्को जवर आयो। <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />चेला ओख झील पर चलतो हुयो देख क घबराय गयो। अऊर कहन लग्यो, “यो भूत आय!” अऊर डर को मारे चिल्लावन लग्यो।<verse eid="MAT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 14:27" />तब यीशु न तुरतच उन्को सी बाते करी अऊर कह्यो, “हिम्मत रखो! मय आय, डरो मत!”<verse eid="MAT 14:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 14:28" />पतरस न ओख उत्तर दियो, “हे प्रभु, यदि तयच आय, त मोख अपनो जवर पानी पर चल क आवन कि आज्ञा दे।”<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />ओन कह्यो, “आव!” तब पतरस डोंगा पर सी उतर क यीशु को जवर जाय क पानी पर चलन लग्यो। <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />पर हवा ख देख क डर गयो, अऊर जब डुबन लग्यो त चिल्लाय क कह्यो, “हे प्रभु, मोख बचाव!”<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />यीशु न तुरतच हाथ बढ़ाय क ओख धर लियो अऊर ओको सी कह्यो, “हे अविश्वासी, तय न कहाली सक करयो?”<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />जब हि डोंगा पर चढ़ गयो, त हवा रुक गयी। <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />येको पर उन्न जो डोंगा पर होतो, ओख दण्डवत प्रनाम कर क् कह्यो, “सचमुच, तय परमेश्वर को बेटा आय।”<verse eid="MAT 14:33" /></para>
  <para style="s">गन्नेसरत म रोगियों ख चंगो करनो</para>
  <para style="r">(<ref loc="MRK 6:53-56">मरकुस ६:५३-५६</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />हि झील को ओन पार उतर क गन्नेसरत म पहुंच्यो। <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />उत को लोगों न ओख पहिचान लियो अऊर आजु बाजू को पूरो देश म सुसमाचार भेज्यो, अऊर सब बीमारों ख ओको जवर लायो, <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />अऊर ओको सी बिनती करन लग्यो कि ऊ उन्ख अपनो कपड़ा को कोना ख छूवन दे; अऊर जितनो न ओको कपड़ा ख छूयो, हि चंगो भय गयो।<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">पूर्वजों की शिक्षा</para>
  <para style="r">(<ref loc="MRK 7:1-13">मरकुस ७:१-१३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />तब यरूशलेम सी कुछ फरीसी अऊर धर्मशास्त्री यीशु को जवर आय क कहन लग्यो, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />“तोरो चेला बुजूर्गों की परम्परावों ख कहाली टालय हंय, कि हाथ धोयो बिना रोटी खावय हंय?” <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />यीशु न उन्ख उत्तर दियो, “तुम भी अपनी परम्परावों को वजह कहाली परमेश्वर की आज्ञा टालय हय?” <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />कहालीकि परमेश्वर न कह्यो हय, “अपनो बाप अऊर माय को आदर करजो, अऊर जो कोयी बाप यां माय ख बुरो कहेंन, ऊ मार डाल्यो जाय।” <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />पर तुम कह्य हय कि यदि कोयी अपनो बाप यां माय सी कहे, “जो कुछ तोख मोरो सी फायदा मिल सकत होतो, ऊ परमेश्वर ख दान कर दियो,” <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />त ऊ अपनो बाप को आदर नहीं करय, यो तरह तुम न अपनी परम्परा को वजह परमेश्वर को वचन ख टाल दियो। <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />हे कपटियों, यशायाह न तुम्हरो बारे म या भविष्यवानी ठीकच करी हय: <figure style="fig" alt="Ceremonial washing" file="lb00280c.tif" size="col" copy="Horace Knowles ©" ref="१५:२">यहूदियों की हाथ धोवन कि रिती </figure><verse eid="MAT 15:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="MAT 15:8" />“हि लोग होठों सी त मोरो आदर करय हंय,</para>
  <para style="q2" vid="MAT 15:8">पर उन्को मन मोरो सी दूर रह्य हय।<verse eid="MAT 15:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="MAT 15:9" />अऊर हि बेकार म मोरी भक्ति करय हंय,</para>
  <para style="q2" vid="MAT 15:9">कहालीकि उन्की शिक्षा त केवल आदमियों को सिखायो हुयो नियम शास्त्र हंय।”<verse eid="MAT 15:9" /></para>
  <para style="s">अशुद्ध करन वाली बाते</para>
  <para style="r">(<ref loc="MRK 7:14-23">मरकुस ७:१४-२३</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />तब ओन भीड़ ख अपनो जवर बुलाय क उन्को सी कह्यो, “सुनो, अऊर समझो: <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />जो मुंह म जावय हय, ऊ आदमी ख अशुद्ध नहीं करय, पर जो मुंह सी निकलय हय, उच आदमी ख अशुद्ध करय हय।”<verse eid="MAT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 15:12" />तब चेलावों न आय क यीशु सी कह्यो, “का तय जानय हय कि फरीसियों न यो वचन सुन क ठोकर खायो?”<verse eid="MAT 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 15:13" />ओन उत्तर दियो, “हर एक रोप जो मोरो स्वर्गीय पिता न नहीं लगायो, ऊ उखाड़्यो जायेंन। <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" /><note caller="+" style="x"><char style="xo" closed="false">१५:१४ </char><char style="xt" closed="false"><ref loc="LUK 6:39">लूका ६:३९</ref></char></note>उन्ख जान देवो; हि अन्धा रस्ता दिखावन वालो आय अऊर अन्धा यदि अन्धो आदमी ख रस्ता दिखाये, त दोयीच गड्डा म गिर जायेंन।”<verse eid="MAT 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 15:15" />यो सुन क पतरस न ओको सी कह्यो, “यो दृष्टान्त हम्ख समझाय दे।”<verse eid="MAT 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 15:16" />यीशु न कह्यो, “का तुम भी अब तक नासमझ हय? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />का तुम नहीं जानय कि जो कुछ मुंह म जावय हय, ऊ पेट म पड़य हय, अऊर शरीर सी निकल जावय हय? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" /><note caller="+" style="x"><char style="xo" closed="false">१५:१८ </char><char style="xt" closed="false"><ref loc="MAT 12:34">मत्ती १२:३४</ref></char></note>पर जो कुछ मुंह सी निकलय हय, ऊ मन सी निकलय हय, अऊर उच आदमी ख अशुद्ध करय हय। <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />कहालीकि बुरो बिचार, हत्या, परस्त्रीगमन, व्यभिचार, चोरी, झूठी गवाही अऊर निन्दा यो मन सीच निकलय हय। <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />योच आय जो आदमी ख अशुद्ध करय हंय, पर बिना हाथ धोयो जेवन करनो आदमी ख अशुद्ध नहीं करय।”<verse eid="MAT 15:20" /></para>
  <para style="s">बाई को विश्वास</para>
  <para style="r">(<ref loc="MRK 7:24-30">मरकुस ७:२४-३०</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />यीशु उत सी निकल क, सूर अऊर सैदा को प्रदेश को तरफ चली गयो। <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />अऊर देखो, ऊ प्रदेश की एक कनानी बाई निकल क आयी, अऊर जोर की आवाज सी कहन लगी, “हे प्रभु! दाऊद की सन्तान, मोरो पर दया कर! मोरी बेटी ख दुष्ट आत्मा सताय रही हय।”<verse eid="MAT 15:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 15:23" />पर ओन ओख कुछ भी उत्तर नहीं दियो। चेलावों न ओको जवर आय क बिनती करन लग्यो, “येख भेज दे, कहालीकि वा चिल्लाती हमरो पीछू आय रही हय।”<verse eid="MAT 15:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 15:24" />पर यीशु न उत्तर दियो, “इस्राएल को घराना की खोयी हुयी मेंढीं ख छोड़ मय कोयी को जवर नहीं भेज्यो गयो।”<verse eid="MAT 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 15:25" />पर वा आयी, अऊर यीशु ख प्रनाम कर क् कहन लगी, “हे प्रभु, मोरी मदद कर!”<verse eid="MAT 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 15:26" />यीशु न उत्तर दियो, “बच्चा की रोटी ले क कुत्ता को आगु डालनो ठीक नहाय।”<verse eid="MAT 15:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 15:27" />यो बात पर बाई न कह्यो, “सच हय प्रभु, पर कुत्ता भी ऊ जुठो खावय हंय, जो उन्को मालिक की मेज सी गिरय हंय।”<verse eid="MAT 15:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 15:28" />येको पर यीशु न ओख उत्तर दियो, “हे बाई, तोरो विश्वास बड़ो हय। जसो तय चाहवय हय, तोरो लायी वसोच हो।” अऊर ओकी बेटी उच घड़ी सी चंगी भय गयी।<verse eid="MAT 15:28" /></para>
  <para style="s">कुछ रोगियों ख चंगो करनो</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />यीशु उत सी गलील को झील को जवर आयो, अऊर उत पहाड़ी पर चढ़ क बैठ गयो। <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />तब भीड़ की भीड़ ओको जवर आयी। हि अपनो संग बहुत लंगड़ा, अन्धा, मुक्का, टुण्डा अऊर दूसरों बहुत सो ख ओको जवर लायो, अऊर उन्ख ओको पाय पर डाल दियो, अऊर ओन उन्ख चंगो कर दियो। <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />जब लोगों न देख्यो कि मुक्का बोलय, अऊर टुण्डा चंगो होवय, अऊर लंगड़ा चलय, अऊर अन्धा देखय हंय त अचम्भा कर क् इस्राएल को परमेश्वर की बड़ायी करी।<verse eid="MAT 15:31" /></para>
  <para style="s">चार हजार लोगों ख खिलानो</para>
  <para style="r">(<ref loc="MRK 8:1-10">मरकुस ८:१-१०</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />यीशु न अपनो चेलावों ख बुलाय क कह्यो, “मोख यो भीड़ पर तरस आवय हय, कहालीकि हि तीन दिन सी मोरो संग हंय अऊर उन्को जवर कयीच खान को नहाय। मय उन्ख भूखो भेजनो नहीं चाहऊ, कहीं असो नहीं होय कि रस्ता म थक क रह्य जाये।”<verse eid="MAT 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 15:33" />चेलावों न यीशु सी कह्यो, “हम्ख यो जंगल म कित सी इतनी रोटी मिलेंन कि हम इतनी बड़ी भीड़ ख सन्तुष्ट करबो?”<verse eid="MAT 15:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 15:34" />यीशु न उन्को सी पुच्छ्यो, “तुम्हरो जवर कितनी रोटी हंय?”</para>
  <para style="p" vid="MAT 15:34">उन्न कह्यो, “सात, अऊर थोड़ी सी छोटी मच्छी।”<verse eid="MAT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 15:35" />तब यीशु न लोगों ख जमीन पर बैठन की आज्ञा दियो। <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />अऊर उन सात रोटी अऊर मच्छी ख लियो, अऊर धन्यवाद कर क् तोड़्यो, अऊर अपनो चेलावों ख देतो गयो, अऊर चेलावों न लोगों ख। <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />तब सब खाय क सन्तुष्ट भय गयो अऊर चेलावों न बच्यो हुयो टुकड़ा सी भरयो हुयो सात टोकनी उठायी। <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />जितनो न खायो, उन्म बाईयों अऊर बच्चां को अलावा चार हजार आदमी होतो।<verse eid="MAT 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 15:39" />तब उन भीड़ ख बिदा कर क् डोंगा पर चढ़ गयो, अऊर मगदन क्षेत्र म आयो।<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">स्वर्गीय चिन्ह की मांग</para>
  <para style="r">(<ref loc="MRK 8:11-13">मरकुस ८:११-१३</ref>; <ref loc="LUK 12:54-56">लूका १२:५४-५६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">मत्ती १२:३८</ref>; <ref loc="LUK 11:16">लूका ११:१६</ref></char>
    </note>यीशु को जवर फरीसियों अऊर सदूकियों न आय क परखन लायी ओको सी कह्यो, “हम्ख स्वर्ग को कोयी चिन्ह दिखाव।” <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />यीशु न उन्ख उत्तर दियो, “शाम ख तुम कह्य हय, ‘मौसम अच्छो रहेंन, कहालीकि आसमान लाल हय,’ <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />अऊर भुन्सारे म कह्य हय, ‘अज आन्धी आयेंन, कहालीकि आसमान लाल अऊर धूंधलो हय।’ तुम आसमान को हवामान ख देख क ओको भेद बताय सकय हय, पर समय को चिन्ह को भेद कहाली नहीं बताय सकय? <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" /><note caller="+" style="x"><char style="xo" closed="false">१६:४ </char><char style="xt" closed="false"><ref loc="MAT 12:39">मत्ती १२:३९</ref>; <ref loc="LUK 11:29">लूका ११:२९</ref></char></note>यो युग को बुरो अऊर व्यभिचारी लोग चिन्ह ढूंढय हंय, पर योना को चिन्ह ख छोड़ उन्ख अऊर कोयी चिन्ह दियो नहीं जायेंन।”</para>
  <para style="p" vid="MAT 16:4">अऊर ऊ उन्ख छोड़ क चली गयो।<verse eid="MAT 16:4" /></para>
  <para style="s">फरीसियों अऊर सदूकियों की शिक्षा को खमीर</para>
  <para style="r">(<ref loc="MRK 8:14-21">मरकुस ८:१४-२१</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />चेला समुन्दर को ओन पार पहुंच्यो, पर हि रोटी धरनो भूल गयो होतो। <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" /><note caller="+" style="x"><char style="xo" closed="false">१६:६ </char><char style="xt" closed="false"><ref loc="LUK 12:1">लूका १२:१</ref></char></note>यीशु न उन्को सी कह्यो, “देखो, फरीसियों अऊर सदूकियों को खमीर जसो शिक्षा सी चौकस रहजो।” <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />हि आपस म बिचार करन लग्यो, “हम न रोटी नहीं लायो येकोलायी ऊ असो कह्य हय।” <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />यो जान क, यीशु न उन्को सी कह्यो, “हे अविश्वासियों, तुम आपस म कहाली बिचार करय हय कि हमरो जवर रोटी नहाय? <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" /><note caller="+" style="x"><char style="xo" closed="false">१६:९ </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">मत्ती १४:१७-२१</ref></char></note>का तुम अब तक नहीं समझ्यो? का याद करय कि जब पाच हजार लोगों लायी पाच रोटी होती त तुम्न कितनी टोकनियां उठायी होती? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><note caller="+" style="x"><char style="xo" closed="false">१६:१० </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">मत्ती १५:३४-३८</ref></char></note>अऊर चार हजार लायी सात रोटी होती त तुम्न कितनी टोकनी उठायी होती? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />तुम कहाली नहीं समझय कि मय न तुम्हरो सी रोटी को बारे म नहीं कह्यो, पर यो कि तुम फरीसियों अऊर सदूकियों को खमीर सी चौकस रहजो।” <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />तब चेला को समझ म आयो कि ओन रोटी को खमीर को बारे म नहीं, पर फरीसियों अऊर सदूकियों की शिक्षा सी चौकस रहन लायी कह्यो होतो।<verse eid="MAT 16:12" /></para>
  <para style="s">पतरस न यीशु ख मसीह स्वीकारयो</para>
  <para style="r">(<ref loc="MRK 8:27-30">मरकुस ८:२७-३०</ref>; <ref loc="LUK 9:18-21">लूका ९:१८-२१</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />यीशु कैसरिया फिलिप्पी को प्रदेश म आयो, अऊर अपनो चेलावों सी पूछन लग्यो, “लोग आदमी को बेटा ख का कह्य हंय?” <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" /><note caller="+" style="x"><char style="xo" closed="false">१६:१४ </char><char style="xt" closed="false"><ref loc="MAT 14:1">मत्ती १४:१</ref>,<ref loc="MAT 14:2">२</ref>; <ref loc="MRK 6:14">मरकुस ६:१४</ref>,<ref loc="MRK 6:15">१५</ref>; <ref loc="LUK 9:7">लूका ९:७</ref>,<ref loc="LUK 9:8">८</ref></char></note>उन्न कह्यो, “कुछ त यूहन्ना बपतिस्मा देन वालो कह्य हंय, अऊर कुछ एलिय्याह, अऊर कुछ यिर्मयाह यां भविष्यवक्तावों म सी कोयी एक कह्य हंय।” <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />ओन उन्को सी कह्यो, “पर तुम मोख का कह्य हय?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" /><note caller="+" style="x"><char style="xo" closed="false">१६:१६ </char><char style="xt" closed="false"><ref loc="JHN 6:68">यूहन्ना ६:६८</ref>,<ref loc="JHN 6:69">६९</ref></char></note>शिमोन पतरस न उत्तर दियो, “तय जीन्दो परमेश्वर को बेटा मसीह आय।” <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />यीशु न ओख उत्तर दियो, “हे शिमोन, योना को बेटा, तय धन्य हय; कहालीकि मांस अऊर खून न नहीं; पर मोरो बाप न जो स्वर्ग म हय, यो बात तोरो पर प्रगट करी हय। <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />अऊर मय भी तोरो सी कहू हय कि तय पतरस आय, अऊर मय यो गोटा पर अपनी मण्डली बनाऊं, अऊर मृत्यु की सामर्थ ओको पर हावी नहीं होयेंन। <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" /><note caller="+" style="x"><char style="xo" closed="false">१६:१९ </char><char style="xt" closed="false"><ref loc="MAT 18:18">मत्ती १८:१८</ref>; <ref loc="JHN 20:23">यूहन्ना २०:२३</ref></char></note>मय तोख स्वर्ग को राज्य की कुंजी देऊं: अऊर जो कुछ तय धरती पर बान्धजो, ऊ स्वर्ग म बन्धेंन; अऊर जो कुछ तय धरती पर खोलजो, ऊ स्वर्ग म खुलेंन।” <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />तब ओन चेलावों ख चितायो कि कोयी सी मत कहजो कि मय मसीह आय।<verse eid="MAT 16:20" /></para>
  <para style="s">अपनो मरनो को बारे म यीशु की भविष्यवानी</para>
  <para style="r">(<ref loc="MRK 8:31-33">मरकुस ८:३१-३३</ref>; <ref loc="LUK 9:22">लूका ९:२२</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />ऊ समय सी यीशु अपनो चेलावों ख बतावन लग्यो, “जरूरी हय कि मय यरूशलेम ख जाऊं अऊर बुजूर्गों, अऊर मुख्य याजकों, अऊर धर्मशास्त्रियों को हाथ सी बहुत दु:ख उठाऊ; अऊर मार डाल्यो जाऊं; अऊर तीसरो दिन जीन्दो होऊं।” <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />येको पर पतरस ओख अलग लिजाय क डाटन लग्यो, “हे प्रभु परमेश्वर असो नहीं करे! तोरो संग असो कभी नहीं होयेंन।” <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />ओन मुड़ क पतरस सी कह्यो, “हे शैतान, मोरो आगु सी दूर होय जा! तय मोरो लायी ठोकर को वजह हय; कहालीकि तय परमेश्वर की बातों पर नहीं, पर आदमियों की बातों पर मन लगावय हय।”<verse eid="MAT 16:23" /></para>
  <para style="s">यीशु को पीछू चलन को मतलब</para>
  <para style="r">(<ref loc="MRK 8:34-9:1">मरकुस ८:३४–९:१</ref>; <ref loc="LUK 9:23-27">लूका ९:२३-२७</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:२४ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">मत्ती १०:३८</ref>; <ref loc="LUK 14:27">लूका १४:२७</ref></char>
    </note>तब यीशु न अपनो चेलावों सी कह्यो, “यदि कोयी मोरो पीछू आवनो चाहवय, त अपनो खुद को इन्कार करे अऊर अपनो क्रूस उठाये, अऊर मोरो पीछू हो ले। <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" /><note caller="+" style="x"><char style="xo" closed="false">१६:२५ </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्ती १०:३९</ref>; <ref loc="LUK 17:33">लूका १७:३३</ref>; <ref loc="JHN 12:25">यूहन्ना १२:२५</ref></char></note>कहालीकि जो कोयी अपनो जीव बचावनो चाहेंन, ऊ ओख खोयेंन; अऊर जो कोयी मोरो लायी अपनो जीव खोयेंन, ऊ ओख पायेंन। <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />यदि आदमी पूरो जगत ख पा ले अऊर अपनो जीव की हानि उठायेंन, त ओख का फायदा होयेंन? यो आदमी अपनो जीव को बदला का देयेंन? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" /><note caller="+" style="x"><char style="xo" closed="false">१६:२७ </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्ती २५:३१</ref>; </char><char style="xt" closed="false"><ref loc="ROM 2:6">रोमियों २:६</ref></char></note>आदमी को बेटा अपनो स्वर्गदूतों को संग अपनो बाप की महिमा म आयेंन, अऊर ऊ घड़ी ‘ऊ हर एक ख ओको काम को अनुसार प्रतिफल देयेंन।’ <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />मय तुम सी सच कहू हय कि जो इत खड़ो हंय, उन्म सी कुछ असो हंय कि हि जब तक आदमी को बेटा ख ओको राज्य म आवतो हुयो नहीं देख लेयेंन, तब तक मरन को स्वाद कभी नहीं चखेंन।”<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">यीशु को रूप को बदलाव</para>
  <para style="r">(<ref loc="MRK 9:2-13">मरकुस ९:२-१३</ref>; <ref loc="LUK 9:28-36">लूका ९:२८-३६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />छे दिन को बाद यीशु न पतरस अऊर याकूब अऊर ओको भाऊ यूहन्ना ख अपनो संग ले क उन्ख एकान्त म कोयी ऊचो पहाड़ी पर ले गयो। <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />उत उन्को आगु ओको रूप को बदलाव भयो अऊर ओको मुंह सूरज को जसो चमक्यो अऊर ओको कपड़ा प्रकाश को जसो उजलो भय गयो। <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />अऊर मूसा अऊर एलिय्याह ओको संग बाते करतो हुयो उन्ख दिखायी दियो।<verse eid="MAT 17:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 17:4" />येको पर पतरस न यीशु सी कह्यो, “हे प्रभु, हमरो इत रहनो अच्छो हय। यदि तोरी इच्छा हय त मय इत तीन मण्डा बनाऊं; एक तोरो लायी, एक मूसा लायी, अऊर एक एलिय्याह लायी।” <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" /><note caller="+" style="x"><char style="xo" closed="false">१७:५ </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्ती ३:१७</ref>; <ref loc="MAT 12:18">१२:१८</ref>; <ref loc="MRK 1:11">मरकुस १:११</ref>; <ref loc="LUK 3:22">लूका ३:२२</ref></char><char style="xt" closed="false"><ref loc="2PE 1:17">२ पतरस १:१७</ref>,<ref loc="2PE 1:18">१८</ref></char></note>ऊ बोलतच रह्यो होतो कि एक उज्वल बादर न उन्ख छाय लियो, अऊर ऊ बादर म सी यो आवाज निकली: “यो मोरो प्रिय बेटा आय, जेकोसी मय बहुत खुश हय: येकी सुनो।” <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />जब चेलावों न यो सुन्यो त हि मुंह को बल गिरयो अऊर बहुत डर गयो। <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />यीशु न जवर आय क उन्ख छूयो, अऊर कह्यो, “उठो, डरो मत।” <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />तब उन्न ऊपर देख्यो अऊर यीशु ख छोड़ अऊर कोयी ख नहीं देख्यो।<verse eid="MAT 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 17:9" />जब हि पहाड़ी सी उतर रह्यो होतो तब यीशु न उन्ख यो आज्ञा दियो, “जब तक आदमी को बेटा मरयो हुयो म सी जीन्दो नहीं होवय, तब तक जो कुछ तुम न देख्यो हय कोयी सी मत कहजो।” <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />येको पर ओको चेलावों न ओको सी पुच्छ्यो, “फिर धर्मशास्त्री कहाली कह्य हंय कि एलिय्याह को पहिलो आवनो जरूरी हय?” <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />ओन उत्तर दियो, “एलिय्याह जरूर आयेंन,” अऊर सब कुछ सुधारेंन। <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" /><note caller="+" style="x"><char style="xo" closed="false">१७:१२ </char><char style="xt" closed="false"><ref loc="MAT 11:14">मत्ती ११:१४</ref></char></note>पर मय तुम सी कहू हय कि एलिय्याह आय गयो हय, अऊर लोगों न ओख नहीं जान्यो; पर जसो उन्न चाह्यो वसोच ओको संग करयो। वसोच आदमी को बेटा भी उन्को हाथ सी दु:ख उठायेंन। <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />तब चेलावों न समझ्यो कि ओन हमरो सी यूहन्ना बपतिस्मा देन वालो को बारे म कह्यो होतो।<verse eid="MAT 17:13" /></para>
  <para style="s">मिर्गी की दुष्ट आत्मा सी पीड़ित बच्चा ख चंगायी</para>
  <para style="r">(<ref loc="MRK 9:14-29">मरकुस ९:१४-२९</ref>; <ref loc="LUK 9:37-43">लूका ९:३७-४३</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />जब हि भीड़ को जवर पहुंच्यो, त एक आदमी यीशु को जवर आयो, अऊर ओको आगु घुटना टेक क कहन लग्यो, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />“हे प्रभु, मोरो बेटा पर दया कर! कहालीकि ओख मिर्गी आवय हय, अऊर ऊ बहुत दु:ख उठावय हय; अऊर बार-बार कभी आगी अऊर कभी पानी म गिर पड़य हय। <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />मय ओख तोरो चेलावों को जवर लायो होतो, पर हि ओख चंगो नहीं कर सक्यो।”<verse eid="MAT 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 17:17" />यीशु न उत्तर दियो, “हे अविश्वासी अऊर जिद्दी लोगों, मय कब तक तुम्हरो संग रहूं? मय कब तक तुम्हरी सहूं? ओख इत मोरो जवर लावो।” <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />तब यीशु न दुष्ट आत्मा ख डाट्यो, अऊर वा ओको म सी निकल गयी; अऊर बेटा उच घड़ी चंगो भय गयो।<verse eid="MAT 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 17:19" />तब चेलावों न एकान्त म यीशु को जवर आय क कह्यो, “हम दुष्ट आत्मा कहाली नहीं निकाल सक्यो?”<verse eid="MAT 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 17:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१७:२० </char>
      <char style="xt" closed="false">
        <ref loc="MAT 21:21">मत्ती २१:२१</ref>; <ref loc="MRK 11:23">मरकुस ११:२३</ref>; <ref loc="1CO 13:2">१ कुरिन्थियों १३:२</ref></char>
    </note>ओन उन्को सी कह्यो, “अपनो विश्वास की कमी को वजह सी, कहालीकि मय तुम सी सच कहू हंय, यदि तुम्हरो विश्वास राई को दाना को बराबर भी हय, त यो पहाड़ी सी कहजो, ‘इत सी सरक क उत चली जा,’ त ऊ चली जायेंन; अऊर कोयी बात तुम्हरो लायी असम्भव नहीं होयेंन। <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />पर यो जाति प्रार्थना अऊर उपवास को अलावा अऊर कोयी उपाय सी नहीं निकलय।”<note caller="+" style="f"><char style="fr" closed="false">१७:२१ </char><char style="ft" closed="false">यो वचन हस्तलेखों म नहीं पायो जावय</char></note><verse eid="MAT 17:21" /></para>
  <para style="s">अपनो मरनो यां पुनरुत्थान की भविष्यवानी यीशु को द्वारा</para>
  <para style="r">(<ref loc="MRK 9:30-32">मरकुस ९:३०-३२</ref>; <ref loc="LUK 9:43-45">लूका ९:४३-४५</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />जब हि गलील क्षेत्र म होतो, त यीशु न उन्को सी कह्यो, “आदमी को बेटा आदमियों को हाथ म पकड़ायो जायेंन; <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />हि ओख मार डालेंन, अऊर ऊ तीसरो दिन जीन्दो होयेंन।” यो बात पर चेला बहुत उदास भयो।<verse eid="MAT 17:23" /></para>
  <para style="s">मन्दिर को कर</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />जब हि कफरनहूम पहुंच्यो, त मन्दिर को कर लेनवालो न पतरस को जवर आय क पुच्छ्यो, “का तुम्हरो गुरु मन्दिर को कर नहीं देवय?”<verse eid="MAT 17:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 17:25" />ओन कह्यो, “हव, देवय हय।”</para>
  <para style="p" vid="MAT 17:25">जब ऊ घर म आयो, त यीशु न पहिले ओको सी पुच्छ्यो, “शिमोन, तय का सोचय हय? धरती को राजा चुंगी यां कर कौन्को सी लेवय हंय, अपनो बेटा सी यां परायो सी?”<verse eid="MAT 17:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 17:26" />पतरस न ओको सी कह्यो, “परायो सी।”</para>
  <para style="p" vid="MAT 17:26">यीशु न ओको सी कह्यो, “त बेटा कर देनो सी बच गयो। <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />पर असो नहीं होय कि हम उन्को लायी ठोकर को वजह बने, तय झील को किनार जाय क गरी डाल, अऊर जो मच्छी पहिले निकले, ओख ले; अऊर ओको मुंह खोलन पर तोख एक सिक्का मिलेंन, ओख ले क मोरो अऊर अपनो बदला को उन्ख दे देजो।”<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">स्वर्ग को राज्य म बड़ो कौन?</para>
  <para style="r">(<ref loc="MRK 9:33-37">मरकुस ९:३३-३७</ref>; <ref loc="LUK 9:46-48">लूका ९:४६-४८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१८:१ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">लूका २२:२४</ref>
      </char>
    </note>ऊ समय चेला यीशु को जवर आय क पूछन लग्यो, “स्वर्ग को राज्य म सब सी बड़ो कौन हय?”<verse eid="MAT 18:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 18:2" />येको पर ओन एक बच्चा ख जवर बुलाय क उन्को बीच म खड़ो करयो, <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" /><note caller="+" style="x"><char style="xo" closed="false">१८:३ </char><char style="xt" closed="false"><ref loc="MRK 10:15">मरकुस १०:१५</ref>; <ref loc="LUK 18:17">लूका १८:१७</ref></char></note>अऊर कह्यो, “मय तुम सी सच कहू हय कि जब तक तुम नहीं फिरो अऊर बच्चा को जसो नहीं बनो, त तुम स्वर्ग को राज्य म सिरनो नहीं पावों। <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />जो कोयी अपनो आप ख यो बच्चा को जसो छोटो करेंन, ऊ स्वर्ग को राज्य म बड़ो होयेंन। <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />अऊर जो कोयी मोरो नाम सी एक असो बच्चा ख स्वीकार करय हय ऊ मोख स्वीकार करय हय।<verse eid="MAT 18:5" /></para>
  <para style="s">पाप करन की परीक्षा</para>
  <para style="r">(<ref loc="MRK 9:42-48">मरकुस ९:४२-४८</ref>; <ref loc="LUK 17:1">लूका १७:१</ref>,<ref loc="LUK 17:2">२</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />“पर जो कोयी इन छोटो म सी जो मोरो पर विश्वास करय हंय एक ख ठोकर खिलावय, त ओको लायी ठीक होतो कि ओको गरो म गरहट को पाट लटकाय क ओख समुन्दर की गहरायी म डुबायो जातो। <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />ठोकरो को वजह सी जगत पर हाय! ठोकरो को लगनो जरूरी हय; पर हाय ऊ आदमी पर जेकोसी ठोकर लगय हय।<verse eid="MAT 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 18:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१८:८ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:30">मत्ती ५:३०</ref>
      </char>
    </note>“यदि तोरो हाथ यां तोरो पाय तोख ठोकर खिलावय, त ओख काट क फेक दे; कहालीकि तोरो लायी टुण्डा यां लंगड़ा होय क जीवन म सिरनो येको सी कहीं अच्छो हय कि तय दोय हाथ यां दोय पाय होतो हुयो, अनन्त आगी म डाल्यो जाये। <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" /><note caller="+" style="x"><char style="xo" closed="false">१८:९ </char><char style="xt" closed="false"><ref loc="MAT 5:29">मत्ती ५:२९</ref></char></note>यदि तोरी आंखी तोख ठोकर खिलावय, त ओख निकाल क फेक दे; कहालीकि तोरो लायी एक आंखी सी अन्धो होय क जीवन म सिरनो येको सी कहीं अच्छो हय कि दोय आंखी रह्य क भी तय नरक की आगी म डाल्यो जाये।<verse eid="MAT 18:9" /></para>
  <para style="s">खोयी हुयी मेंढा को दृष्टान्त</para>
  <para style="r">(<ref loc="LUK 15:3-7">लूका १५:३-७</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 18:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१८:१० </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:10">लूका १९:१०</ref>
      </char>
    </note>“देखो, तुम इन छोटो म सी कोयी ख भी तुच्छ नहीं जानो; कहालीकि मय तुम सी कहू हय कि स्वर्ग म उन्को दूत मोरो स्वर्गीय पिता को मुंह हमेशा देखय हय। <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />कहालीकि आदमी को बेटा खोयो हुयो ख बचावन आयो हय।<verse eid="MAT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />“तुम का सोचय हय? यदि कोयी आदमी की सौ मेंढीं हय, अऊर उन्म सी एक भटक जाये, त का ऊ निन्यानवे ख पहाड़ी पर छोड़ क ऊ भटक्यो हुयो मेंढा ख नहीं ढूंढेंन? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />अऊर यदि असो होय कि ओख मिल जावय, त मय तुम सी सच कहू हय कि ऊ उन निन्यानवे मेंढीं लायी जो भटक्यो नहीं होतो, इतनो खुशी नहीं करेंन जितनो कि यो मेंढा लायी करेंन। <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />असोच तुम्हरो बाप की जो स्वर्ग म हय यो इच्छा नहाय कि इन छोटो म सी एक भी नाश होय।<verse eid="MAT 18:14" /></para>
  <para style="s">भाऊ अऊर बहिन को पाप</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१८:१५ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:3">लूका १७:३</ref>
      </char>
    </note>“यदि तोरो भाऊ तोरो विरोध म अपराध करे, त जा अऊर अकेलो म बातचीत कर क् ओख समझाव; यदि ऊ तोरी सुनय त तय न अपनो भाऊ ख पा लियो। <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />यदि ऊ नहीं सुनय, त एक यां दोय लोगों ख अपनो संग अऊर लिजाव, कि ‘हर एक बात दोय यां तीन गवाहों को मुंह सी निश्चित करयो जाये।’ <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />यदि ऊ उन्की भी नहीं मानय, त मण्डली सी कह्य दे, पर यदि ऊ मण्डली की भी न मानय त तय ओख गैरयहूदी अऊर कर लेनवालो जसो जान।<verse eid="MAT 18:17" /></para>
  <para style="s">रोकनो अऊर अवसर देनो</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१८:१८ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:19">मत्ती १६:१९</ref>; <ref loc="JHN 20:23">यूहन्ना २०:२३</ref></char>
    </note>“मय तुम सी सच कहूं हय, जो कुछ तुम धरती पर बान्धो, ऊ स्वर्ग म बन्धेंन अऊर जो कुछ तुम धरती पर खोलो, ऊ स्वर्ग म खुलेंन।<verse eid="MAT 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />“तब मय तुम सी सच कहूं हय, यदि तुम म सी दोय लोग धरती पर कोयी बात लायी एक मन होय क ओख मांगेंन, त ऊ मोरो बाप को तरफ सी जो स्वर्ग म हय, उन्को लायी होय जायेंन। <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />कहालीकि जित दोय यां तीन मोरो नाम पर जमा होवय हंय, उत मय उन्को बीच म होऊं हय।”<verse eid="MAT 18:20" /></para>
  <para style="s">निर्दयी सेवक को दृष्टान्त</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१८:२१ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:3">लूका १७:३</ref>,<ref loc="LUK 17:4">४</ref></char>
    </note>तब पतरस न जवर आय क ओको सी कह्यो, “हे प्रभु, यदि मोरो भाऊ अपराध करतो रह्यो, त मय कितनो बार ओख माफ करूं? का सात बार तक?”<verse eid="MAT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 18:22" />यीशु न ओको सी कह्यो, “मय तोरो सी यो नहीं कहूं कि सात बार तक, बल्की सात बार को सत्तर गुना तक।” <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />येकोलायी स्वर्ग को राज्य ऊ राजा को जसो हय, जेन अपनो सेवकों सी हिसाब लेनो चाह्यो। <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />जब ऊ हिसाब लेन लग्यो, त एक लोग ओको जवर लायो गयो जो करोड़ो को कर्जदार होतो। <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />जब कि कर्ज चुकावन लायी ओको जवर कुछ भी नहीं होतो, त ओको मालिक न कह्यो, “यो अऊर येकी पत्नी अऊर येको बाल-बच्चा अऊर जो कुछ येको हय सब कुछ बेच्यो जाये, अऊर कर्ज चुकाय दियो जाये। <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />येको पर ऊ सेवक न गिर क ओख प्रनाम करयो, अऊर कह्यो, हे मालिक धीरज धर, मय सब कुछ भर देऊं।” <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />तब ऊ सेवक को मालिक न दया कर क ओख छोड़ दियो, अऊर ओको कर्ज भी माफ कर दियो।<verse eid="MAT 18:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 18:28" />“पर जब ऊ सेवक बाहेर निकल्यो, त ओको संगी सेवकों म सी एक ओख मिल्यो जो ओको सौ दीनार को कर्जदार होतो; ओन ओख पकड़ क ओकी घाटी पिचकल्यो अऊर कह्यो, ‘जो कुछ तोरो पर कर्ज हय भर दे।’ <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />येको पर ओको संगी सेवक ओको पाय पर गिर क ओको सी बिनती करन लग्यो, ‘धीरज धर, मय सब भर देऊं।’ <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />ओन नहीं मान्यो, पर जाय क ओख जेलखाना म डाल दियो कि जब तक कर्ज भर नहीं दे तब तक उतच रहे। <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />ओको संगी सेवक यो जो भयो होतो ओख देख क बहुत उदास भयो, अऊर जाय क अपनो मालिक ख पूरो हाल बताय दियो। <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />तब ओको मालिक न ओख बुलाय क ओको सी कह्यो, ‘हे दुष्ट सेवक, तय न जो मोरो सी बिनती करी, त मय न तोरो पूरो कर्ज माफ कर दियो। <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />येकोलायी जसो मय न तोरो पर दया करी, वसोच का तोख भी अपनो संगी सेवक पर दया करनो नहीं चाहत होतो?’ <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />अऊर ओको मालिक न गुस्सा म आय क ओख सजा देन वालो को हाथ म सौंप दियो, कि जब तक ऊ पूरो कर्ज भर नहीं दे, तब तक ऊ उन्को हाथ म रहेंन।<verse eid="MAT 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 18:35" />“येकोलायी यदि तुम म सी हर एक अपनो भाऊ ख मन सी माफ नहीं करेंन, त मोरो बाप जो स्वर्ग म हय, तुम सी भी वसोच करेंन।”<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">छोड़चिट्ठी को बारे म यीशु की शिक्षा</para>
  <para style="r">(<ref loc="MRK 10:1-12">मरकुस १०:१-१२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />जब यीशु या बाते कह्य दियो, तब गलील सी चली गयो; अऊर यरदन नदी को पार यहूदिया को प्रदेश म आयो। <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />तब बड़ी भीड़ ओको पीछू भय गयी, अऊर ओन उत उन्ख चंगो करयो।<verse eid="MAT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 19:3" />तब फरीसी ओकी परीक्षा लेन लायी ओको जवर आय क कहन लग्यो, “का कोयी भी अपनी पत्नी ख कोयी भी वजह सी छोड़ देनो उचित हय?”<verse eid="MAT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 19:4" />ओन उत्तर दियो, “का तुम न नहीं पढ़्यो कि जेन उन्ख बनायो? ओन सुरूवात सीच नर अऊर नारी बनायो, <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" /><note caller="+" style="x"><char style="xo" closed="false">१९:५ </char><char style="xt" closed="false"><ref loc="GEN 2:24">उत्पत्ति २:२४</ref></char></note>अऊर कह्यो ‘येकोलायी आदमी अपनो माय-बाप सी अलग होय क अपनी पत्नी को संग रहेंन अऊर हि दोयी एक शरीर होयेंन?’ <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />येकोलायी हि अब दोय नहीं, पर एक शरीर हंय। येकोलायी जेक परमेश्वर न जोड़्यो हय, ओख आदमी अलग नहीं करे।”<verse eid="MAT 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 19:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१९:७ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:31">मत्ती ५:३१</ref>
      </char>
    </note>उन्न यीशु सी कह्यो, “त मूसा न यो कहाली ठहरायो हय कि कोयी पति अपनी पत्नी ख छोड़चिट्ठी दे क छोड़ दे?”<verse eid="MAT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 19:8" />ओन उन्को सी कह्यो, “मूसा न तुम्हरो मन की कठोरता को वजह तुम्ख अपनी-अपनी पत्नी ख छोड़ देन की आज्ञा दी, पर सुरूवात सी असो नहीं होतो। <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" /><note caller="+" style="x"><char style="xo" closed="false">१९:९ </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्ती ५:३२</ref>; <ref loc="1CO 7:10">१ कुरिन्थियों ७:१०</ref>,<ref loc="1CO 7:11">११</ref></char></note>अऊर मय तुम सी कहूं हय, कि जो कोयी व्यभिचार ख छोड़ अऊर कोयी वजह सी अपनी पत्नी ख छोड़ क दूसरी सी बिहाव करे, त ऊ व्यभिचार करय हय।”<verse eid="MAT 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 19:10" />तब चेलावों न यीशु सी कह्यो, “यदि आदमी को अपनी पत्नी को संग असो सम्बन्ध हय, त यो अच्छो हय कि बिहाव नहीं करे।”<verse eid="MAT 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 19:11" />पर ओन कह्यो, “हि सब बिहाव को बिना नहीं रह्य सकय हंय, पर केवल उच रह्य सकय हय जेक यो दान दियो गयो हय। <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />कहालीकि कुछ नपुसक असो हंय, जो अपनी माय को गर्भ सी असो पैदा भयो; अऊर कुछ नपुसक असो हंय, जिन्ख आदमी न नपुसक बनायो; अऊर कुछ नपुसक असो भी हंय, जिन्न स्वर्ग को राज्य लायी अपनो आप ख नपुसक बनायो हय। जो येख स्वीकार कर सकय हय, ऊ स्वीकार करे।”<verse eid="MAT 19:12" /></para>
  <para style="s">बच्चां ख आशीर्वाद</para>
  <para style="r">(<ref loc="MRK 10:13-16">मरकुस १०:१३-१६</ref>; <ref loc="LUK 18:15-17">लूका १८:१५-१७</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />तब लोग बच्चां ख ओको जवर लायो कि ऊ उन पर हाथ रख क प्रार्थना करे, पर चेलावों न उन्ख डाट्यो। <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />तब यीशु न कह्यो, “बच्चां ख मोरो जवर आवन देवो, अऊर उन्ख मना मत कर, कहालीकि स्वर्ग को राज्य असोच को हय।”<verse eid="MAT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 19:15" />अऊर ऊ उन पर हाथ रखन को बाद उत सी चली गयो।<verse eid="MAT 19:15" /></para>
  <para style="s">धनी आदमी</para>
  <para style="r">(<ref loc="MRK 10:17-31">मरकुस १०:१७-३१</ref>; <ref loc="LUK 18:18-30">लूका १८:१८-३०</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />एक आदमी यीशु को जवर आयो अऊर ओको सी कह्यो, “हे गुरु, मय कौन सो भलो काम करूं कि अनन्त जीवन पाऊ?”<verse eid="MAT 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 19:17" />यीशु न ओको सी कह्यो, “तय मोरो सी भलायी को बारे म कहाली पूछय हय? भलो त एकच हय, पर यदि तय जीवन म सिरनो चाहवय हय, त आज्ञावों ख मानतो जावो।”<verse eid="MAT 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 19:18" />ओन ओको सी कह्यो, “कौन सी आज्ञा?”</para>
  <para style="p" vid="MAT 19:18">यीशु न कह्यो, “यो कि हत्या नहीं करनो, व्यभिचार नहीं करनो, चोरी नहीं करनो, झूठी गवाही नहीं देनो, <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />अपनो बाप अऊर अपनी माय को आदर करनो, अऊर अपनो पड़ोसी सी अपनो जसो प्रेम रखनो।”<verse eid="MAT 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 19:20" />ऊ जवान न यीशु सी कह्यो, “इन सब ख त मय न मान्यो हय; अब मोरो म कौन्सी बात की कमी हय?”<verse eid="MAT 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 19:21" />यीशु न ओको सी कह्यो, “यदि तय सिद्ध होनो चाहवय हय त जा, अपनो धन जायजाद बेच क गरीबों ख दे, अऊर तोख स्वर्ग म धन मिलेंन: अऊर आय क मोरो पीछू हो जा।”<verse eid="MAT 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 19:22" />पर ऊ जवान यो बात सुन्क उदास होय क चली गयो, कहालीकि ऊ बहुत धनी होतो।<verse eid="MAT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 19:23" />तब यीशु न अपनो चेलावों सी कह्यो, “मय तुम सी सच कहू हय कि धनवान को स्वर्ग को राज्य म सिरनो कठिन हय। <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />तुम सी फिर कहू हय कि परमेश्वर को राज्य म धनवान को सिरनो सी ऊंट को सूई को नाक म सी निकल जानोच सहज हय।”<verse eid="MAT 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 19:25" />यो सुन क चेलावों न बहुत अचम्भित होय क कह्यो, “फिर कौन्को उद्धार होय सकय हय?”<verse eid="MAT 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 19:26" />यीशु न उन्को तरफ देख क कह्यो, “आदमियों सी त यो नहीं होय सकय, पर परमेश्वर सी सब कुछ होय सकय, हय।”<verse eid="MAT 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 19:27" />येको पर पतरस न यीशु सी कह्यो, “देख, हम त सब कुछ छोड़ क् तोरो पीछू भय गयो हंय: त हम्ख का मिलेंन?”<verse eid="MAT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 19:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१९:२८ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 25:31">मत्ती २५:३१</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:30">लूका २२:३०</ref>
      </char>
    </note>यीशु न उन्को सी कह्यो, “मय तुम सी सच कहू हय कि नयी सृष्टि म जब आदमी को बेटा अपनी महिमा को सिंहासन पर बैठेंन, त तुम भी जो मोरो पीछू भय गयो हय, बारयी सिंहासनों पर बैठ क, इस्राएल को बारयी गोत्रों को न्याय करो। <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />अऊर जो कोयी न घरो, यां भाऊवों यां बहिनों, यां बाप यां माय, यां बाल-बच्चां यां खेतो ख मोरो नाम लायी छोड़ दियो हय, ओख सौ गुना मिलेंन, अऊर ऊ अनन्त जीवन को अधिकारी होयेंन।” <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" /><note caller="+" style="x"><char style="xo" closed="false">१९:३० </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्ती २०:१६</ref>; <ref loc="LUK 13:30">लूका १३:३०</ref></char></note>पर बहुत सो जो पहिलो हंय ऊ पिछलो होयेंन; अऊर जो पिछलो हंय, ऊ पहिलो होयेंन।<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">बाड़ी को मजूरों को दृष्टान्त</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“स्वर्ग को राज्य कोयी घर को मालिक को जसो हय, जो सबेरे निकल्यो कि अपनी अंगूर की बाड़ी म मजूरों ख काम म लगाये। <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />ओन हर एक मजूरों सी एक <note caller="+" style="f"><char style="fr" closed="false">२०:२ </char><char style="ft" closed="false">रोमन सरकार को एक दीनार को मतलब हय एक दिन कि मजूरी </char></note>दीनार रोज पर ठहरायो अऊर उन्ख अपनी अंगूर की बाड़ी म काम पर भेज्यो। <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />तब नव बजे निकल क ओन दूसरों कुछ लोगों ख बजार म बेकार खड़ो देख्यो, <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />अऊर ओन कह्यो, ‘तुम भी अंगूर की बाड़ी म जावो, अऊर जो कुछ ठीक हय, तुम्ख देऊं।’ <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />येकोलायी हि भी गयो, तब ओन दूसरों बार बारा बजे अऊर तीन बजे निकल क वसोच करयो। <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />दिन डुबन को पहिले ओन पाच बजे फिर निकल क दूसरों ख खड़ो पायो, अऊर ओन कह्यो, ‘तुम कहाली इत दिन भर बेकार म खड़ो रह्यो?’ <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />उन्न ओको सी कह्यो, ‘कोयी न हम्ख मजूरी पर नहीं लगायो।’ ओन ओको सी कह्यो, ‘तुम भी अंगूर की बाड़ी म जावो।’”<verse eid="MAT 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 20:8" />“शाम ख अंगूर की बाड़ी को मालिक न अपनो मुनीम सी कह्यो, ‘मजूरों ख बुलाय क पिछलो सी ले क पहिलो तक उन्ख मजूरी दे।’ <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />पाच बजे जो मजूर ख लगायो गयो होतो, त उन्ख भी एक एक दीनार मिल्यो। <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />जो पहिले आयो उन्न यो समझ्यो कि हम्ख जादा मिलेंन, पर उन्ख भी एक एक दीनारच मिल्यो। <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />जब मिल्यो त हि घर मालिक पर कुड़कुड़ाय क कहन लग्यो, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />‘इन पिछलो न एकच घंटा काम करयो, अऊर तय न उन्ख हमरो बराबर कर दियो, जिन्न दिन भर काम करयो अऊर तपन झेली?’”<verse eid="MAT 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 20:13" />ओन उन्म सी एक ख उत्तर दियो, “हे संगी, मय तोरो सी कुछ अन्याय नहीं करू। का तय नच मोरो सी एक दीनार मजूरी नहीं ठहरायो होतो? <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />जो तोरो हय, ओख ले अऊर चली जा; मोरी इच्छा यो हय कि जितनो तोख देऊं उतनोच यो पिछलो वालो ख भी देऊं। <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />का यो उचित नहाय कि जो मोरो हय ओको म सी जो चाहऊ ऊ करूं? का मोरो अच्छो होन को वजह तय बुरी नजर सी देखय हय?” <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" /><note caller="+" style="x"><char style="xo" closed="false">२०:१६ </char><char style="xt" closed="false"><ref loc="MAT 19:30">मत्ती १९:३०</ref>; <ref loc="MRK 10:31">मरकुस १०:३१</ref>; <ref loc="LUK 13:30">लूका १३:३०</ref></char></note>योच तरह सी “जो पीछू हंय, हि आगु होयेंन; अऊर जो आगु हंय हि पीछू होयेंन।”<verse eid="MAT 20:16" /></para>
  <para style="s">अपनो मरनो को बारे म यीशु की तीसरी भविष्यवानी</para>
  <para style="r">(<ref loc="MRK 10:32-34">मरकुस १०:३२-३४</ref>; <ref loc="LUK 18:31-34">लूका १८:३१-३४</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />यीशु यरूशलेम ख जातो हुयो बारयी चेलावों ख एकान्त म लिजायो, अऊर रस्ता म उन्को सी कहन लग्यो, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />“देखो, हम यरूशलेम ख जाय रह्यो हंय; अऊर आदमी को बेटा मुख्य याजकों अऊर धर्मशास्त्रियों को हाथ म पकड़ायो जायेंन, अऊर हि ओख सजा को लायक ठहरायेंन। <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />अऊर ओख गैरयहूदियों को हाथ सौंपेंन कि हि ओख ठट्ठा करे, अऊर कोड़ा मारे, अऊर क्रूस पर चढ़ाये, अऊर ऊ तीसरो दिन जीन्दो करयो जायेंन।”<verse eid="MAT 20:19" /></para>
  <para style="s">एक माय की बिनती</para>
  <para style="r">(<ref loc="MRK 10:35-45">मरकुस १०:३५-४५</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />तब जब्दी को बेटा की माय न, अपनो बेटा को संग यीशु को जवर आय क नमस्कार करयो, अऊर ओको सी कुछ मांगन लगी।<verse eid="MAT 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 20:21" />यीशु न ओको सी कह्यो, “तय का चाहवय हय?”</para>
  <para style="p" vid="MAT 20:21">वा ओको सी बोली, “यो वचन दे कि मोरो यो दोयी बेटा तोरो राज्य म एक तोरो दायो अऊर एक तोरो बायो तरफ बैठे।”<verse eid="MAT 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 20:22" />यीशु न उत्तर दियो, “तुम नहीं जानय कि का मांगय हय। जो कटोरा मय पीवन पर हय, का तुम पी सकय हय?”</para>
  <para style="p" vid="MAT 20:22">उन्न ओको सी कह्यो, “पी सकय हंय।”<verse eid="MAT 20:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 20:23" />यीशु न ओको सी कह्यो, “तुम मोरो कटोरा त पीवो, पर अपनो दायो अऊर बायो कोयी ख बैठानो मोरो काम नहाय, पर जेको लायी मोरो बाप को तरफ सी तैयार करयो गयो, उन्कोच लायी हय।”<verse eid="MAT 20:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 20:24" />यो सुन्क दसो चेलावों उन दोयी भाऊवों पर गुस्सा भयो। <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" /><note caller="+" style="x"><char style="xo" closed="false">२०:२५ </char><char style="xt" closed="false"><ref loc="LUK 22:25">लूका २२:२५</ref>,<ref loc="LUK 22:26">२६</ref></char></note>यीशु न उन्ख जवर बुलाय क कह्यो, “तुम जानय हय कि गैरयहूदियों को अधिकारी उन पर प्रभुता करय हंय; अऊर जो बड़ो हंय, हि उन पर अधिकार जतावय हंय। <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" /><note caller="+" style="x"><char style="xo" closed="false">२०:२६ </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्ती २३:११</ref>; <ref loc="MRK 9:35">मरकुस ९:३५</ref>; <ref loc="LUK 22:26">लूका २२:२६</ref></char></note>पर तुम म असो नहीं होयेंन; पर जो कोयी तुम म बड़ो होनो चाहवय, ऊ तुम्हरो सेवक बने; <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />अऊर जो तुम म मुख्य होनो चाहवय, ऊ तुम्हरो सेवक बने; <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />जसो कि आदमी को बेटा; ऊ येकोलायी नहीं आयो कि ओकी सेवा टहल करी जाये, पर येकोलायी आयो कि खुद सेवा टहल करे, अऊर बहुत सो की छुड़ौती लायी अपनो जीव दे।”<verse eid="MAT 20:28" /></para>
  <para style="s">दोय अन्धा ख नजर दियो</para>
  <para style="r">(<ref loc="MRK 10:46-52">मरकुस १०:४६-५२</ref>; <ref loc="LUK 18:35-43">लूका १८:३५-४३</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />जब हि यरीहो नगर सी निकल रह्यो होतो, त एक बड़ी भीड़ यीशु को पीछू भय गयी। <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />अऊर दोय अन्धा, जो सड़क को किनार पर बैठ्यो होतो, यो सुन्क कि यीशु जाय रह्यो हय, पुकार क कहन लग्यो, “हे प्रभु, दाऊद की सन्तान, हमरो पर दया कर।”<verse eid="MAT 20:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 20:31" />लोगों न उन्ख डाट्यो कि चुप रहे; पर हि अऊर भी चिल्लाय क बोल्यो, “हे प्रभु, दाऊद की सन्तान, हमरो पर दया कर।”<verse eid="MAT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 20:32" />तब यीशु न खड़ो होय क, उन्ख बुलायो अऊर कह्यो, “तुम का चाहवय हय कि मय तुम्हरो लायी करूं?”<verse eid="MAT 20:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 20:33" />उन्न ओको सी कह्यो, “हे प्रभु, यो कि हमरी आंखी खुल जाये।”<verse eid="MAT 20:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 20:34" />यीशु न तरस खाय क उन्की आंखी छूयो, अऊर हि तुरतच देखन लग्यो; अऊर ओको पीछू भय गयो।<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">यरूशलेम म सिरनो</para>
  <para style="r">(<ref loc="MRK 11:1-11">मरकुस ११:१-११</ref>; <ref loc="LUK 19:28-40">लूका १९:२८-४०</ref>; <ref loc="JHN 12:12-19">यूहन्ना १२:१२-१९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />जब हि यरूशलेम नगर को जवर पहुंच्यो अऊर जैतून पहाड़ी पर बैतफगे गांव को जवर आयो, त यीशु न दोय चेलावों ख यो कह्य क भेज्यो, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />“आगु को गांव म जावो। उत पहुंचतोच एक गधी को बछड़ा ख खोल क मोरो जवर लावो। <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />यदि तुम सी कोयी कुछ कहेंन, त कहजो कि प्रभु ख येकी जरूरत हय, तब ऊ तुरतच उन्ख भेज देयेंन।”<verse eid="MAT 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 21:4" />यो येकोलायी भयो कि जो वचन भविष्यवक्ता सी कह्यो गयो होतो, ऊ पूरो होय:<verse eid="MAT 21:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="MAT 21:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२१:५ </char>
      <char style="xt" closed="false">
        <ref loc="EZK 9:9">यहेजकेल ९:९</ref>
      </char>
    </note>“सिय्योन की बेटी सी कहो,</para>
  <para style="q2" vid="MAT 21:5">‘देख, तोरो राजा तोरो जवर आवय हय;</para>
  <para style="q1" vid="MAT 21:5">ऊ नम्र हय, अऊर गधी को बच्चा पर बैठ्यो हय;</para>
  <para style="q2" vid="MAT 21:5">जो मेहनती गधी को बछड़ा पर।’”<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />चेलावों न जाय क, जसो यीशु न उन्को सी कह्यो होतो, वसोच करयो। <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />अऊर गधी अऊर बछड़ा दोयी ख लाय क, उन पर अपनो कपड़ा डाल्यो, अऊर ऊ ओको पर बैठ गयो। <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />तब बहुत सो लोगों न उन्को स्वागत की अपेक्षा सी अपनो कपड़ा रस्ता म बिछायो, अऊर दूसरों लोगों न झाड़ों सी डगाली काट क रस्ता म बिछायी। <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />जो भीड़ आगु-आगु जात होती अऊर पीछू-पीछू चली आवत होती, पुकार-पुकार क कहत होती, “दाऊद की सन्तान की जय होय, धन्य हय ऊ जो प्रभु को नाम सी आवय हय, दाऊद की सन्तान की महिमा हो।”<verse eid="MAT 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 21:10" />जब यीशु यरूशलेम म सिरन लग्यो, त सारो नगर म हलचल मच गयी, अऊर लोग कहन लग्यो, “यो कौन आय?”<verse eid="MAT 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 21:11" />लोगों न कह्यो, “यो त गलील को नासरत नगर को भविष्यवक्ता यीशु आय।”<verse eid="MAT 21:11" /></para>
  <para style="s">मन्दिर को शुद्धिकरन</para>
  <para style="r">(<ref loc="MRK 11:15-19">मरकुस ११:१५-१९</ref>; <ref loc="LUK 19:45-48">लूका १९:४५-४८</ref>; <ref loc="JHN 2:13-22">यूहन्ना २:१३-२२</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />यीशु न परमेश्वर को मन्दिर म जाय क उन सब ख, जो मन्दिर म सामान लेन-देन कर रह्यो होतो, उन्ख निकाल दियो, अऊर धन्दा करन वालो को पीढ़ा अऊर कबूत्तर बेचन वालो की पीढ़ा उलटाय दियो; <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" /><note caller="+" style="x"><char style="xo" closed="false">२१:१३ </char><char style="xt" closed="false"><ref loc="ISA 56:7">यशायाह ५६:७</ref>; <ref loc="ZEC 7:11">जकर्याह ७:११</ref> </char></note>अऊर उन्को सी कह्यो, “लिख्यो हय, ‘मोरो घर प्रार्थना को घर कहलायेंन;’ पर तुम ओख डाकुवों को अड्डा बनावय हय।”<verse eid="MAT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 21:14" />तब अन्धा अऊर लंगड़ा, मन्दिर म ओको जवर आयो, अऊर ओन उन्ख चंगो करयो। <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />पर जब मुख्य याजकों अऊर धर्मशास्त्रियों न इन आश्चर्य कामों ख, जो ओन करयो होतो, देख्यो अऊर बच्चां ख जो मन्दिर म यो पुकार रह्यो होतो, “दाऊद की सन्तान की महिमा हो,” पुकारतो हुयो देख्यो, त हि गुस्सा भयो!<verse eid="MAT 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 21:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२१:१६ </char>
      <char style="xt" closed="false">
        <ref loc="PSA 8:2">भजन ८:२</ref>
      </char>
    </note>अऊर ओको सी कहन लग्यो, “का तय सुनय हय कि यो का कह्य रह्यो हंय?” यीशु न उन्को सी कह्यो, “हव; का तुम्न यो शास्त्र म कभी नहीं पढ़्यो: ‘बच्चां अऊर दूध पीतो बच्चां को मुंह सी तय न स्तुति करायी?’”<verse eid="MAT 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 21:17" />तब ऊ उन्ख छोड़ क नगर को बाहेर बैतनिय्याह ख गयो अऊर उत रात बितायी।<verse eid="MAT 21:17" /></para>
  <para style="s">यीशु न अंजीर को झाड़ ख श्राप दियो</para>
  <para style="r">(<ref loc="MRK 11:12-14">मरकुस ११:१२-१४</ref>,<ref loc="MRK 11:20-24">२०-२४</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />भुन्सारो ख जब यीशु नगर ख लौटतो समय ओख भूख लगी। <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />त सड़क को किनार पर अंजीर को एक झाड़ देख क ऊ ओको जवर गयो, अऊर पाना ख छोड़ ओको म अऊर कुछ नहीं पा क ओको सी कह्यो। “अब सी तोरो म फिर कभी फर नहीं लगे।” अऊर अंजीर को झाड़ तुरतच सूख गयो।<verse eid="MAT 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 21:20" />यो देख क चेलावों ख अचम्भा भयो अऊर उन्न कह्यो, “यो अंजीर को झाड़ तुरतच कसो सूख गयो?”<verse eid="MAT 21:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 21:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२१:२१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 17:20">मत्ती १७:२०</ref>; <ref loc="1CO 13:2">१ कुरिन्थियों १३:२</ref></char>
    </note>यीशु न उन्ख उत्तर दियो, “मय तुम सी सच कहूं हय, यदि तुम विश्वास रखो अऊर शक मत करो, त नहीं केवल यो करजो जो यो अंजीर को झाड़ सी करयो गयो हय, पर यदि यो पहाड़ी सी भी कहो, ‘उखड़ जा अऊर समुन्दर म जाय गिर,’ त यो होय जायेंन। <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />अऊर जो कुछ तुम प्रार्थना म विश्वास सी मांगो ऊ सब तुम्ख मिल जायेंन।”<verse eid="MAT 21:22" /></para>
  <para style="s">यीशु को अधिकार पर प्रश्न</para>
  <para style="r">(<ref loc="MRK 11:27-33">मरकुस ११:२७-३३</ref>; <ref loc="LUK 20:1-8">लूका २०:१-८</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />ऊ मन्दिर म फिर सी जाय क उपदेश देत होतो, त मुख्य याजकों अऊर लोगों को बुजूर्गों न ओको जवर आय क पुच्छ्यो, “तय यो काम कौन्को अधिकार सी करय हय? अऊर तोख यो अधिकार कौन न दियो हय?”<verse eid="MAT 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 21:24" />यीशु न उन्ख उत्तर दियो, “मय भी तुम सी एक बात पूछू हय; यदि ऊ मोख बतावो, त मय भी तुम्ख बताऊं कि यो काम कौन्सो अधिकार सी करू हय। <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />यूहन्ना को बपतिस्मा कित सी होतो? स्वर्ग को तरफ सी यां आदमियों को तरफ सी?”</para>
  <para style="p" vid="MAT 21:25">तब हि आपस म विवाद करन लग्यो, “यदि हम कहबोंन ‘स्वर्ग को तरफ सी,’ त ऊ हम सी कहेंन, ‘फिर तुम न ओको विश्वास कहाली नहीं करयो?’ <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />अऊर यदि कहेंन ‘आदमियों को तरफ सी,’ त हम्ख भीड़ को डर हय, कहालीकि हि सब यूहन्ना ख भविष्यवक्ता मानय हंय।”<verse eid="MAT 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 21:27" />येकोलायी उन्न यीशु ख उत्तर दियो, “हम नहीं जानजे।” ओन भी उन्को सी कह्यो, “त मय भी तुम्ख नहीं बताऊ कि यो काम कौन्सो अधिकार सी करू हय।<verse eid="MAT 21:27" /></para>
  <para style="s">दोय बेटा को दृष्टान्त</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />“तुम का सोचय हय? कोयी आदमी को दोय बेटा होतो; ओन पहिलो बेटा को जवर जाय क कह्यो, ‘हे बेटा, अज अंगूर की बाड़ी म काम कर।’ <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />ओन उत्तर दियो, ‘मय नहीं जाऊं,’ पर बाद म पछताय गयो। <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />तब बाप न दूसरों बेटा को जवर जाय क असोच कह्यो, ओन उत्तर दियो, ‘जी हव मय जाऊं हय,’ पर नहीं गयो। <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />इन दोयी म सी कौन बाप की इच्छा पूरी करी?”</para>
  <para style="p" vid="MAT 21:31">उन्न कह्यो, “बड़ो न।”</para>
  <para style="p" vid="MAT 21:31">यीशु न उन्को सी कह्यो, “मय तुम सी सच कहू हय कि, कर लेनवालो अऊर वेश्यायें तुम सी पहिले परमेश्वर को राज्य म सिरय हंय। <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" /><note caller="+" style="x"><char style="xo" closed="false">२१:३२ </char><char style="xt" closed="false"><ref loc="LUK 3:12">लूका ३:१२</ref>; <ref loc="LUK 7:29">७:२९</ref>,<ref loc="LUK 7:30">३०</ref></char></note>कहालीकि यूहन्ना सच्चायी को रस्ता दिखातो हुयो तुम्हरो जवर आयो, अऊर तुम्न ओको विश्वास नहीं करयो; पर कर लेनवालो अऊर वेश्यावों न ओको विश्वास करयो: अऊर तुम यो देख क बाद म भी नहीं पछतायो कि ओको विश्वास कर लेतो।<verse eid="MAT 21:32" /></para>
  <para style="s">दुष्ट किसानों को दृष्टान्त</para>
  <para style="r">(<ref loc="MRK 12:1-12">मरकुस १२:१-१२</ref>; <ref loc="LUK 20:9-19">लूका २०:९-१९</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />“एक अऊर दृष्टान्त सुनो: एक जमीन को मालिक होतो, जेन अंगूर की बाड़ी लगायी, ओको चारयी तरफ बाड़ी रुन्द्यो, ओको म रस को गड्डा खोद्यो अऊर मचान बनायो, अऊर किसान ख ओको ठेका दे क परदेश चली गयो। <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />जब फर को समय जवर आयो, त ओन अपनो सेवकों ख ओको फर लेन को लायी किसानों को जवर भेज्यो। <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />पर किसानों न ओको सेवकों ख पकड़ क्, कोयी ख पिट्यो, अऊर कोयी ख मार डाल्यो, अऊर कोयी पर गोटा सी मारयो। <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />तब ओन पहिलो सी जादा अऊर सेवकों ख भेज्यो, अऊर उन्न उन्को सी भी वसोच करयो। <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />आखरी म ओन अपनो बेटा ख उन्को जवर यो सोच क भेज्यो कि हि मोरो बेटा को आदर करेंन। <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />पर किसानों न मालिक को बेटा ख देख क आपस म कह्यो, ‘यो त वारिस आय, आवो, येख मार डालो अऊर येकी जायजाद ले ले।’ <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />येकोलायी उन्न ओख पकड़्यो अऊर अंगूर की बाड़ी सी बाहेर निकाल क मार डाल्यो। <figure style="fig" alt="Watchtower in a vineyard" file="hk00105c.tif" size="col" copy="Horace Knowles ©" ref="२१:३३">अंगूर की बाड़ी म मचान</figure><verse eid="MAT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 21:40" />“येकोलायी, जब अंगूर की बाड़ी को मालिक आयेंन, त उन किसान को संग का करेंन?”<verse eid="MAT 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 21:41" />उन्न ओको सी कह्यो, “ऊ उन बुरो लोगों ख बुरी रीति सी नाश करेंन; अऊर अंगूर की बाड़ी को ठेका दूसरों किसानों ख देयेंन, जो समय पर ओख फसल दियो करेंन।”<verse eid="MAT 21:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 21:42" />यीशु न उन्को सी कह्यो, “का तुम न कभी पवित्र शास्त्र म यो नहीं पढ़्यो:”</para>
  <para style="q1" vid="MAT 21:42">“जो गोटा ख राजमिस्त्रियों न नकारयो होतो,</para>
  <para style="q2" vid="MAT 21:42">उच गोटा को कोना को सिरा मतलब महत्वपूर्ण भय गयो?</para>
  <para style="q1" vid="MAT 21:42">यो प्रभु को तरफ सी भयो,</para>
  <para style="q2" vid="MAT 21:42">अऊर हमरी नजर म अद्भुत हय।”<verse eid="MAT 21:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 21:43" />“येकोलायी मय तुम सी कहू हय कि परमेश्वर को राज्य तुम सी ले लियो जायेंन अऊर जो लोग परमेश्वर की आज्ञा मान क सच बाते करय हय, ओख फर दियो जायेंन। <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />जो यो गोटा पर गिरेंन, ऊ तुकड़ा-तुकड़ा होय जायेंन; अऊर जेक पर ऊ गिरेंन, ओख पीस डालेंन।”<verse eid="MAT 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 21:45" />मुख्य याजक अऊर फरीसी ओको दृष्टान्तों ख सुन क समझ गयो कि ऊ उन्को बारे म कह्य हय। <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />अऊर उन्न ओख पकड़नो चाह्यो, पर लोगों सी डर गयो कहालीकि हि ओख भविष्यवक्ता मानत होतो।<verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">बिहाव-भोज को दृष्टान्त</para>
  <para style="r">(<ref loc="LUK 14:15-24">लूका १४:१५-२४</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />यीशु तब उन्को सी दृष्टान्तों म कहन लग्यो, <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />“स्वर्ग को राज्य की तुलना एक राजा सी कर सकय हय, जेन अपनो बेटा को बिहाव को जेवन दियो। <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />अऊर ओन बिहाव को जेवन म नेवता वालो ख बुलावन लायी अपनो सेवक ख भेज्यो, पर उन लोगों न बिहाव म आनो नहीं चाह्यो। <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />तब ओन अऊर सेवकों ख यो कह्य क भेज्यो, ‘नेवता वालो सी कहो: देखो, मय जेवन तैयार कर दियो हय, मोरो जनावर अऊर पाल्यो पशु काट्यो गयो हंय; अऊर सब कुछ तैयार हय; बिहाव को जेवन म आवो।’ <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />पर हि अनसुनी कर क् चली गयो: कोयी अपनो खेत ख, कोयी अपनो धन्दा ख। <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />बाकी न ओको सेवकों ख पकड़ क उन्को अपमान करयो अऊर मार डाल्यो। <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />तब राजा ख गुस्सा आयो, अऊर ओन अपनी सेना भेज क उन हत्यारों को नाश करयो, अऊर उन्को नगर ख जलाय दियो। <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />तब ओन अपनो सेवकों सी कह्यो, ‘बिहाव को जेवन त तैयार हय पर नेवता वालो लोग लायक नहीं होतो। <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />येकोलायी सड़क पर जावो अऊर जितनो लोग तुम्ख मिले, सब ख बिहाव को जेवन म बुलाय लावो।’ <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />येकोलायी उन सेवकों न सड़क म जाय क जो भी बुरो यां भलो, जितनो मिल्यो, सब ख जमा करयो; अऊर बिहाव को घर मेहमानों सी भर गयो।”<verse eid="MAT 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 22:11" />“जब राजा मेहमानों ख देखन अन्दर आयो, त ओन उत एक आदमी ख देख्यो, जो बिहाव को कपड़ा पहिन्यो नहीं होतो। <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />ओन ओको सी कह्यो, ‘हे संगी; तय इत बिहाव को कपड़ा पहिन्यो बिना कसो आय गयो?’ अऊर ऊ कुछ नहीं कह्य सक्यो। <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" /><note caller="+" style="x"><char style="xo" closed="false">२२:१३ </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्ती ८:१२</ref>; <ref loc="MAT 25:30">२५:३०</ref>; <ref loc="LUK 13:28">लूका १३:२८</ref></char></note>तब राजा न सेवकों सी कह्यो, ‘येको हाथ-पाय बान्ध क ओख बाहेर अन्धारो म डाल देवो, उत रोवनो अऊर दात कटरनो होयेंन।’”<verse eid="MAT 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 22:14" />कहालीकि “बुलायो हुयो त बहुत हंय, पर चुन्यो हुयो थोड़ो हंय।”<verse eid="MAT 22:14" /></para>
  <para style="s">कर देन को बारे म प्रश्न</para>
  <para style="r">(<ref loc="MRK 12:13-17">मरकुस १२:१३-१७</ref>; <ref loc="LUK 20:20-26">लूका २०:२०-२६</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />तब फरीसियों न जाय क आपस म बिचार करयो कि ओख कसो तरह बातों म फसायबोंन। <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />येकोलायी उन्न अपनो चेलावों ख हेरोदियों को संग ओको जवर यो कहन ख भेज्यो, “हे गुरु, हम जानजे हंय कि तय सच्चो हय, अऊर परमेश्वर को रस्ता सच्चायी सी सिखावय हय, अऊर कोयी कि परवाह नहीं करय, कहालीकि तय आदमियों को चेहरा देख क बाते नहीं करय। <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />येकोलायी हम्ख बता कि तय का सोचय हय? कैसर ख कर देनो उचित हय कि नहाय।”<verse eid="MAT 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 22:18" />यीशु न उन्की दुष्ट हरकत जान क कह्यो, “हे कपटियों, मोख कहाली परखय हय? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />मोख ऊ सिक्का दिखाव।” जेकोसी कर चुकायो जावय हय।</para>
  <para style="p" vid="MAT 22:19">तब हि ओको जवर एक सिक्का ले क आयो। <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />ओन उन्को सी पुच्छ्यो, “यो चेहरा अऊर नाम कौन्को आय?”<verse eid="MAT 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 22:21" />उन्न ओको सी कह्यो, “कैसर को हय।”</para>
  <para style="p" vid="MAT 22:21">तब यीशु उन्को सी कह्यो, “जो कैसर को हय, ऊ कैसर ख देवो; अऊर जो परमेश्वर को हय, ऊ परमेश्वर ख देवो।”<verse eid="MAT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 22:22" />यो सुन क उन्न अचम्भित भयो, अऊर हि यीशु ख छोड़ क चली गयो।<verse eid="MAT 22:22" /></para>
  <para style="s">पुनरुत्थान को बारे म प्रश्न</para>
  <para style="r">(<ref loc="MRK 12:18-27">मरकुस १२:१८-२७</ref>; <ref loc="LUK 20:27-40">लूका २०:२७-४०</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२२:२३ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">प्रेरितों २३:८</ref>
      </char>
    </note>उच दिन सदूकी जो कह्य हंय कि मरयो हुयो को पुनरुत्थान हयच नहाय, यीशु को जवर आयो अऊर ओको सी पुच्छ्यो, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />“हे गुरु, मूसा न कह्यो होतो, कि यदि कोयी आदमी बिना सन्तान मर जाये, त ओको भाऊ ओकी पत्नी सी बिहाव कर क् अपनो भाऊ लायी सन्तान पैदा करे। <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />अब हमरो इत सात भाऊ होतो; पहिलो बिहाव कर क् मर गयो, अऊर सन्तान नहीं होन को वजह अपनी विधवा पत्नी ख अपनो भाऊ लायी छोड़ गयो। <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />यो तरह दूसरों अऊर तीसरो न भी करयो, अऊर सातों तक योच भयो। <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />सब को बाद आखरी म वा बाई भी मर गयी। <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />येकोलायी पुनरुत्थान को समय जीन्दो होन पर वा उन सातों म सी कौन्की पत्नी होयेंन? कहालीकि वा सब की पत्नी भय गयी होती।”<verse eid="MAT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 22:29" />यीशु न उन्ख उत्तर दियो, “तुम पवित्र शास्त्र अऊर परमेश्वर को सामर्थ नहीं जानय; यो वजह सी भूल म पड़्यो हय। <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />कहालीकि पुनरुत्थान को समय जीन्दो होनो पर हि नहीं बिहाव करेंन अऊर नहीं बिहाव म दियो जायेंन पर स्वर्ग म परमेश्वर को दूतों को जसो होयेंन। <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />पर मरयो हुयो को जीन्दो होन को बारे म का तुम न यो वचन नहीं पढ़्यो जो परमेश्वर न तुम सी कह्यो: <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" /><note caller="+" style="x"><char style="xo" closed="false">२२:३२ </char><char style="xt" closed="false"><ref loc="EXO 3:6">निर्गमन ३:६</ref>,<ref loc="EXO 3:15">१५</ref>,<ref loc="EXO 3:16">१६</ref></char></note>‘मय अब्राहम को परमेश्वर, अऊर इसहाक को परमेश्वर, अऊर याकूब को परमेश्वर आय?’ ऊ मरयो हुयो को नहाय, पर जीन्दो को परमेश्वर आय।”<verse eid="MAT 22:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 22:33" />यो सुन क लोग ओकी शिक्षा सी अचम्भित भयो।<verse eid="MAT 22:33" /></para>
  <para style="s">सब सी बड़ी आज्ञा</para>
  <para style="r">(<ref loc="MRK 12:28-34">मरकुस १२:२८-३४</ref>; <ref loc="LUK 10:25-28">लूका १०:२५-२८</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />जब फरीसियों न सुन्यो कि यीशु न सदूकियों को मुंह बन्द कर दियो, त हि जमा भयो। <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />उन्म सी एक व्यवस्था को शिक्षक न ओख परखन लायी ओको सी पुच्छ्यो, <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />“हे गुरु, व्यवस्था म कौन सी आज्ञा सब सी बड़ी हय?”<verse eid="MAT 22:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 22:37" />ओन ओको सी कह्यो, “तय परमेश्वर अपनो प्रभु सी अपनो पूरो दिल अऊर अपनो पूरो जीव अऊर अपनी पूरी मन को संग प्रेम रख। <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />बड़ी अऊर मुख्य आज्ञा त योच आय। <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />अऊर ओकोच जसो यो दूसरी भी हय कि तय अपनो पड़ोसी सी अपनो जसो प्रेम रख। <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" /><note caller="+" style="x"><char style="xo" closed="false">२२:४० </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लूका १०:२५-२८</ref></char></note>योच दोय आज्ञाये पूरी व्यवस्था अऊर भविष्यवक्तावों को आधार हंय।”<verse eid="MAT 22:40" /></para>
  <para style="s">मसीह को बारे म प्रश्न</para>
  <para style="r">(<ref loc="MRK 12:35-37">मरकुस १२:३५-३७</ref>; <ref loc="LUK 20:41-44">लूका २०:४१-४४</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />जब फरीसी जमा होतो, त यीशु न उन्को सी पुच्छ्यो, <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />“मसीह को बारे म तुम का सोचय हय? ऊ कौन्को बेटा आय?”</para>
  <para style="p" vid="MAT 22:42">उन्न ओको सी कह्यो, “दाऊद को।” <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />ओन उन्को सी पुच्छ्यो, “त दाऊद आत्मा म होय क ओख ‘प्रभु’ कहाली कह्य हय?”<verse eid="MAT 22:43" /></para>
  <para style="q1">
    <verse number="44" style="v" sid="MAT 22:44" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२२:४४ </char>
      <char style="xt" closed="false">
        <ref loc="PSA 110:1">भजन ११०:१</ref>
      </char>
    </note>“प्रभु न, मोरो प्रभु सी कह्यो,</para>
  <para style="q2" vid="MAT 22:44">मोरो दायो बैठ,</para>
  <para style="q2" vid="MAT 22:44">जब तक कि मय तोरो दुश्मनों ख</para>
  <para style="q2" vid="MAT 22:44">तोरो पाय को खल्लो नहीं कर देऊं।”<verse eid="MAT 22:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 22:45" />“जब दाऊद ओख ‘प्रभु’ कह्य हय, त ऊ ओको बेटा कसो भयो?” <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />कोयी भी ओख कुछ उत्तर नहीं दे सक्यो। अऊर ऊ दिन सी कोयी ख फिर ओको सी अऊर प्रश्न करन को साहस नहीं भयो।<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">धर्मशास्त्रियों अऊर फरीसियों सी चौकस</para>
  <para style="r">(<ref loc="MRK 12:38">मरकुस १२:३८</ref>,<ref loc="MRK 12:39">३९</ref>; <ref loc="LUK 11:43">लूका ११:४३</ref>,<ref loc="LUK 11:46">४६</ref>; <ref loc="LUK 20:45">२०:४५</ref>,<ref loc="LUK 20:46">४६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />तब यीशु न भीड़ सी अऊर अपनो चेलावों सी कह्यो, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />“धर्मशास्त्री अऊर फरीसी मूसा की गद्दी पर बैठ्यो हंय; <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />येकोलायी हि तुम सी जो कुछ कहेंन ऊ करजो अऊर मानजो, पर उन्को जसो काम मत करजो; कहालीकि हि कह्य त हंय पर करय नहाय। <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />हि भारी बोझ ख जिन्ख उठानो कठिन हय, बान्ध क आदमियों पर लाद देवय हंय; पर खुद ओख अपनी बोट सी भी सरकानो नहीं चाहवय। <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" /><note caller="+" style="x"><char style="xo" closed="false">२३:५ </char><char style="xt" closed="false"><ref loc="MAT 6:1">मत्ती ६:१</ref></char></note>हि अपनो पूरो काम लोगों ख दिखान लायी करय हंय: हि अपनो ताबीजो ख चौड़ी करय अऊर अपनो कपड़ा की झालर बढ़ावय हंय। <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />जेवन म सम्मानित जागा, अऊर सभा म मुख्य-मुख्य आसन, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />बजारों म आदर सत्कार पानो, अऊर आदमी म गुरु कहलानो उन्ख भावय हय। <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />पर तुम गुरु नहीं कहलावों, कहालीकि तुम्हरो एकच गुरु हय, अऊर तुम सब भाऊवों हो। <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />धरती पर कोयी ख अपनो स्वर्गीय पिता नहीं कहजो, कहालीकि तुम्हरो एकच स्वर्गीय पिता हय, जो स्वर्ग म हय। <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />अऊर स्वामी भी नहीं कहलावों, कहालीकि तुम्हरो एकच स्वामी हय, यानेकि मसीह। <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" /><note caller="+" style="x"><char style="xo" closed="false">२३:११ </char><char style="xt" closed="false"><ref loc="MAT 20:26">मत्ती २०:२६</ref>,<ref loc="MAT 20:27">२७</ref>; <ref loc="MRK 9:35">मरकुस ९:३५</ref>; <ref loc="MRK 10:43">१०:४३</ref>,<ref loc="MRK 10:44">४४</ref>; <ref loc="LUK 22:26">लूका २२:२६</ref></char></note>जो तुम म बड़ो हय, ऊ तुम्हरो सेवक बने। <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" /><note caller="+" style="x"><char style="xo" closed="false">२३:१२ </char><char style="xt" closed="false"><ref loc="LUK 14:11">लूका १४:११</ref>; <ref loc="LUK 18:14">१८:१४</ref></char></note>जो कोयी अपनो आप ख बड़ो बनायेंन, ऊ छोटो करयो जायेंन: अऊर जो कोयी अपनो आप ख नम्र बनायेंन, ऊ बड़ो करयो जायेंन।<verse eid="MAT 23:12" /></para>
  <para style="s">यीशु को द्वारा पाखण्डियों की निन्दा</para>
  <para style="r">(<ref loc="MRK 12:40">मरकुस १२:४०</ref>; <ref loc="LUK 11:39-42">लूका ११:३९-४२</ref>,<ref loc="LUK 11:44">४४</ref>,<ref loc="LUK 11:52">५२</ref>; <ref loc="LUK 20:47">२०:४७</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />“हे कपटी धर्मशास्त्रियों अऊर फरीसियों, तुम पर हाय! तुम आदमियों लायी स्वर्ग को राज्य को दरवाजा बन्द करय हय, नहीं त खुदच ओको म सिरय हय अऊर नहीं ओको म सिरन वालो ख सिरन देवय हय। <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" /><note caller="+" style="f"><char style="fr" closed="false">२३:१४ </char><char style="ft" closed="false">यो वचन पुरानो हस्तलेखों म नहीं पायो जावय</char></note>हे कपटी धर्मशास्त्रियों अऊर फरीसियों, तुम पर हाय! तुम विधवावों को घरो ख बर्बाद कर देवय हय, अऊर दिखावन लायी बहुत देर तक प्रार्थना करय हय: येकोलायी तुम्ख बहुत सजा मिलेंन।<verse eid="MAT 23:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 23:15" />“हे कपटी धर्मशास्त्रियों अऊर फरीसियों, तुम पर हाय! तुम एक आदमी ख अपनो मत म लान लायी पूरो जल अऊर थल म फिरय हय, अऊर जब ऊ मत म आय जावय हय त ओख अपनो सी दोय गुना खराब बनाय देवय हय।<verse eid="MAT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 23:16" />“हे अन्धो अगुवों, तुम पर हाय! जो कह्य हय कि यदि कोयी मन्दिर की कसम खाये त कुछ नहीं, पर यदि कोयी मन्दिर को सोनो की कसम खायेंन त ओको सी बन्ध जायेंन। <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />हे मूर्खो अऊर अन्धो, कौन बड़ो हय; सोनो यां ऊ मन्दिर जेकोसी सोनो पवित्र होवय हय? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />फिर कह्य हय कि यदि कोयी वेदी की कसम खाये त कुछ नहीं, पर जो भेंट ओको पर हय, यदि कोयी ओकी कसम खाये त बन्ध जायेंन। <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />हे अन्धो, कौन बड़ो हय; भेंट यां वेदी जेकोसी भेंट पवित्र होवय हय? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />येकोलायी जो वेदी की कसम खावय हय, ऊ ओकी अऊर जो कुछ ओको पर रखी हय, ओकी भी कसम खावय हय। <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />जो मन्दिर की कसम खावय हय, ऊ मन्दिर अऊर ओको म रहन वालो परमेश्वर की भी कसम खावय हय। <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" /><note caller="+" style="x"><char style="xo" closed="false">२३:२२ </char><char style="xt" closed="false"><ref loc="MAT 5:34">मत्ती ५:३४</ref></char></note>जो स्वर्ग की कसम खावय हय, ऊ परमेश्वर को सिंहासन को अऊर ओको पर बैठन वालो की भी कसम खावय हय।<verse eid="MAT 23:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 23:23" />“हे कपटी धर्मशास्त्रियों अऊर फरीसियों, तुम पर हाय! तुम पदीना, अऊर सौंफ, अऊर जीरा को दसवा अंश त देवय हय, पर तुम न व्यवस्था की गम्भीर बातों ख यानेकि न्याय, अऊर दया, अऊर विश्वास ख छोड़ दियो हय; पर असो होनो होतो कि इन्क भी करत रहतो अऊर उन्ख भी नहीं छोड़तो। <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />हे अन्धो अगुवों, तुम मच्छर ख त छान डालय हय, पर ऊंट ख गिटक लेवय हय।<verse eid="MAT 23:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 23:25" />“हे कपटी धर्मशास्त्रियों अऊर फरीसियों, तुम पर हाय! तुम कटोरा अऊर थारी ख बाहेर सी त मांजय हय पर हि अन्दर सी लालच अऊर खुद को भलो को बारे म सोचय हंय। <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />हे अन्धो फरीसी, पहिले कटोरा अऊर थारी ख अन्दर सी मांज कि ऊ बाहेर सी भी साफ होय जाये।<verse eid="MAT 23:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 23:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२३:२७ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:3">प्रेरितों २३:३</ref>
      </char>
    </note>“हे कपटी धर्मशास्त्रियों अऊर फरीसियों, तुम पर हाय! तुम चूना सी पोती हुयी कब्र को जसो हय जो बाहेर सी त सुन्दर दिखायी देवय हंय, पर अन्दर मुर्दों की हड्डियों अऊर सब तरह की गंदगी सी भरी हंय। <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />योच रीति सी तुम भी बाहेर सी आदमियों ख त अच्छो दिखायी देवय हय, पर अन्दर सी कपट अऊर बुरायी सी भरयो हुयो हय।<verse eid="MAT 23:28" /></para>
  <para style="s">फरीसियों की शिक्षा</para>
  <para style="r">(<ref loc="LUK 11:47-51">लूका ११:४७-५१</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />“हे कपटी धर्मशास्त्रियों अऊर फरीसियों, तुम पर हाय! तुम भविष्यवक्तावों की कब्र बनावय अऊर न्यायियों की स्मारक सजावय हय, <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />अऊर कह्य हय, ‘यदि हम अपनो बापदादों को दिनो म होतो त भविष्यवक्तावों की हत्या म सहभागी नहीं होतो।’ <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />येको सी त तुम अपनो खुद पर हि गवाही देवय हय कि तुम भविष्यवक्तावों को हत्यारों की सन्तान आय। <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />येकोलायी तुम अपनो बापदादों को पाप को घड़ा पूरो तरह सी भर देवो। <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" /><note caller="+" style="x"><char style="xo" closed="false">२३:३३ </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्ती ३:७</ref>; <ref loc="MAT 12:34">१२:३४</ref>; <ref loc="LUK 3:7">लूका ३:७</ref></char></note>हे सांपों, हे सांप को पिल्ला, तुम नरक की सजा सी कसो बचो? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />येकोलायी देखो, मय तुम्हरो जवर भविष्यवक्तावों अऊर बुद्धिमानों अऊर शिक्षकों ख भेजू हय; अऊर तुम उन्म सी कुछ ख मार डालेंन अऊर क्रूस पर चढ़ायेंन, अऊर कुछ ख अपनो आराधनालयों म कोड़े मारेंन अऊर एक नगर सी दूसरों नगर म खदेड़तो फिरेंन। <verse eid="MAT 23:34" /><verse number="35" style="v" sid="MAT 23:35" />जेकोसी सच्चो हाबील सी ले क बिरिक्याह को बेटा जकर्याह तक, जेक तुम न मन्दिर अऊर वेदी को बीच म मार डाल्यो होतो, जितनो न्यायियों को खून धरती पर बहायो गयो हय ऊ सब तुम्हरो मुंड पर पड़ेंन। <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />मय तुम सी सच कहू हय, यो सब बाते यो समय को लोगों पर आयेंन।<verse eid="MAT 23:36" /></para>
  <para style="s">यीशु को यरूशलेम सी प्रेम</para>
  <para style="r">(<ref loc="LUK 13:34">लूका १३:३४</ref>,<ref loc="LUK 13:35">३५</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“हे यरूशलेम, हे यरूशलेम! तय जो भविष्यवक्तावों ख मार डालय हय, अऊर जो तोरो जवर भेज्यो गयो, उन पर पथराव करय हय। कितनो बार मय न चाहयो कि जसो मुर्गी अपनो बच्चां ख अपनो पंखा को खल्लो जमा करय हय, वसोच मय भी तोरो बच्चा ख जमा कर लेऊ, पर तुम न नहीं चाह्यो, <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />देखो, तुम्हरो घर तुम्हरो लायी उजाड़ छोड़्यो जावय हय। <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />कहालीकि मय तुम सी सच कहू हय कि अभी सी जब तक तुम मोख तब तक नहीं देखो, जब तक यो नहीं कहो ‘धन्य हय ऊ, जो प्रभु को नाम सी आवय हय’ तब तक तुम मोख फिर कभी नहीं देखो।”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">मन्दिर को विनाश की भविष्यवानी</para>
  <para style="r">(<ref loc="MRK 13:1">मरकुस १३:१</ref>,<ref loc="MRK 13:2">२</ref>; <ref loc="LUK 21:5">लूका २१:५</ref>,<ref loc="LUK 21:6">६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />जब यीशु मन्दिर सी निकल क जाय रह्यो होतो, त ओको चेला ओख मन्दिर को भवन दिखावन लायी ओको जवर आयो। <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />ओन उन्को सी कह्यो, “तुम यो सब देख रह्यो हय न! मय तुम सी सच कहू हय, इत गोटा पर गोटा भी न छूटेंन जो ढायो नहीं जायेंन।”<verse eid="MAT 24:2" /></para>
  <para style="s">संकट अऊर कठिनायी</para>
  <para style="r">(<ref loc="MRK 13:3-13">मरकुस १३:३-१३</ref>; <ref loc="LUK 21:7-19">लूका २१:७-१९</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />जब ऊ जैतून पहाड़ी पर बैठ्यो होतो, त चेलावों न एकान्त म ओको जवर आय क कह्यो, “हम्ख बताव कि यो बाते कब होयेंन? तोरो आवन को अऊर जगत को अन्त को का चिन्ह होयेंन?”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />यीशु न उन्ख उत्तर दियो, “चौकस रहो!” कोयी तुम्ख धोका नहीं दे पाये, <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />कहालीकि बहुत सो असो होयेंन जो मोरो नाम सी आय क कहेंन, “मय मसीह आय,” अऊर बहुत सो ख भटकायेंन। <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />तुम लड़ाईयों अऊर लड़ाईयों की चर्चा सुनो, त घबराय नहीं जावो कहालीकि इन को होनो जरूरी हय, पर ऊ समय अन्त नहीं होयेंन। <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />कहालीकि राष्ट्र पर राष्ट्र अऊर राज्य पर राज्य चढ़ायी करेंन, अऊर जागा जागा म अकाल पड़ेंन, अऊर भूईडोल होयेंन। <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />यो सब बाते दु:ख की सुरूवात होयेंन।<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२४:९ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:22">मत्ती १०:२२</ref>
      </char>
    </note>“तब हि दु:ख देन लायी तुम्ख पकड़वायेंन, अऊर तुम्ख मार डालेंन, अऊर मोरो नाम को वजह सब गैरयहूदियों को लोग तुम सी दुश्मनी रखेंन। <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />तब बहुत सो ठोकर खायेंन, अऊर एक दूसरों ख पकड़वायेंन, अऊर एक दूसरों सी दुश्मनी रखेंन। <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />बहुत सो झूठो भविष्यवक्ता उठेंन, अऊर बहुत सो ख बहकायेंन। <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />अधर्म को बढ़नो सी बहुत सो को प्रेम कम होय जायेंन, <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" /><note caller="+" style="x"><char style="xo" closed="false">२४:१३ </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्ती १०:२२</ref></char></note>पर जो आखरी तक धीरज रखेंन, ओकोच उद्धार होयेंन। <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />अऊर परमेश्वर को राज्य को यो सुसमाचार पूरो जगत म प्रचार करयो जायेंन, कि सब लोगों पर गवाही होय, तब अन्त आय जायेंन।”<verse eid="MAT 24:14" /></para>
  <para style="s">महा मुसीबत की सुरूवात</para>
  <para style="r">(<ref loc="MRK 13:14-23">मरकुस १३:१४-२३</ref>; <ref loc="LUK 21:20-24">लूका २१:२०-२४</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“येकोलायी जब तुम लोग ‘भयानक विनाशकारी घृणित चिज ख,’ जेको उल्लेख दानिय्येल भविष्यवक्ता को द्वारा करयो गयो होतो, मन्दिर को पवित्र जागा पर खड़ो देखो।” पढ़ेंन वालो खुद समझ ले कि येको अर्थ का हय <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />तब ऊ समय जो यहूदिया म होना हि पहाड़ी पर भग जाये। <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" /><note caller="+" style="x"><char style="xo" closed="false">२४:१७ </char><char style="xt" closed="false"><ref loc="LUK 17:31">लूका १७:३१</ref></char></note>जो छत पर हय, ऊ अपनो घर म सी सामान लेन लायी मत उतरो; <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />अऊर जो खेत म हय, ऊ अपनो कपड़ा लेन लायी पीछू नहीं लौटे। <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />उन दिनो म जो गर्भवती अऊर दूध पिलावन वाली होना उन्को लायी प्रकोप को दिन कहलायो जायेंन उन्को लायी हाय, होयेंन। <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />प्रार्थना करतो रहो कि तुम्ख ठन्डी म यां आराम को दिन म भगनो नहीं पड़े। <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" /><note caller="+" style="x"><char style="xo" closed="false">२४:२१ </char><char style="xt" closed="false"><ref loc="DAN 12:1">दानिय्येल १२:१</ref>; <ref loc="REV 7:14">प्रकाशितवाक्य ७:१४</ref></char></note>कहालीकि ऊ समय असो भारी संकट होयेंन, जसो जगत की सुरूवात सी न अब तक भयो अऊर न कभी होयेंन। <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />यदि परमेश्वर ऊ दिन ख घटायो नहीं जातो त कोयी प्रानी नहीं बचतो, पर चुन्यो हुयो को वजह ऊ दिन घटायो जायेंन।<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />“ऊ समय यदि कोयी तुम सी कहे, ‘देखो, मसीह इत हय!’ यां ‘उत हय!’ त विश्वास मत करजो। <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />कहालीकि झूठो मसीह अऊर झूठो भविष्यवक्ता उठ खड़ो होयेंन, अऊर बड़ो चिन्ह चमत्कार, अऊर लोगों ख धोका देन लायी अद्भुत काम दिखायेंन कि यदि होय सकय त चुन्यो हुयो ख भी धोका देयेंन। <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />देखो, मय न पहिले सी तुम सी यो सब कुछ कह्य दियो हय।”<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२४:२६ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:23">लूका १७:२३</ref>,<ref loc="LUK 17:24">२४</ref></char>
    </note>“येकोलायी यदि हि तुम सी कहे, ‘देखो, ऊ जंगल म हय,’ त बाहेर नहीं निकल जाजो; यो ‘देखो, ऊ कोठरियों म हय,’ त विश्वास मत करजो। <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />कहालीकि जसो बिजली पूर्व सी निकल क पश्चिम तक चमकय हय, वसोच आदमी को बेटा को भी आनो होयेंन।”<verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२४:२८ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:37">लूका १७:३७</ref>
      </char>
    </note>“जित लाश हय, उत गिधाड़ जमा होयेंन।”<verse eid="MAT 24:28" /></para>
  <para style="s">आदमी को बेटा को पुनरागमन</para>
  <para style="r">(<ref loc="MRK 13:24-27">मरकुस १३:२४-२७</ref>; <ref loc="LUK 21:25-28">लूका २१:२५-२८</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२४:२९ </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:12">प्रकाशितवाक्य ६:१२</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:13">प्रकाशितवाक्य ६:१३</ref>
      </char>
    </note>“उन दिनो अचानक संकट को तुरतच सूरज कारो होय जायेंन, अऊर चन्दा को उजाड़ो कम होतो रहेंन, अऊर चांदनी आसमान सी गिर पड़ेंन अऊर आसमान की शक्तियां हिलायी जायेंन। <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" /><note caller="+" style="x"><char style="xo" closed="false">२४:३० </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानिय्येल ७:१३</ref>; <ref loc="ZEC 12:10-14">जकर्याह १२:१०-१४</ref>; <ref loc="REV 1:7">प्रकाशितवाक्य १:७</ref></char></note>तब आदमी को बेटा को चिन्ह आसमान म दिखायी देयेंन, अऊर तब धरती को सब गोत्र को लोग छाती पीटेंन; अऊर आदमी को बेटा ख बड़ी सामर्थ अऊर महिमा को संग आसमान को बादलो पर आवतो देखेंन। <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />ऊ तुरही की बड़ी आवाज को संग अपनो दूतों ख भेजेंन, अऊर हि आसमान को यो छोर सी ऊ छोर तक, चारयी दिशावों सी ओको चुन्यो हुयो ख जमा करेंन।”<verse eid="MAT 24:31" /></para>
  <para style="s">अंजीर को झाड़ को दृष्टान्त</para>
  <para style="r">(<ref loc="MRK 13:28-31">मरकुस १३:२८-३१</ref>; <ref loc="LUK 21:29-33">लूका २१:२९-३३</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“अंजीर को झाड़ सी यो दृष्टान्त सीखो: जब ओकी डगाली कवली होय जावय अऊर पाना निकलन लगय हंय, त तुम जान लेवय हय कि गरमी को मौसम जवर हय। <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />योच तरह सी जब तुम यो सब बातों ख देखो, त जान लेवो कि ऊ जवर हय, बल्की दरवाजाच पर हय। <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />मय तुम सी सच कहू हय कि जब तक यो सब बाते पूरी नहीं होयेंन, तब तक यो पीढ़ी को अन्त नहीं होयेंन। <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />आसमान अऊर धरती टल जायेंन, पर मोरी बाते कभी नहीं टलेंन।”<verse eid="MAT 24:35" /></para>
  <para style="s">अनजानो दिन अऊर समय</para>
  <para style="r">(<ref loc="MRK 13:32-37">मरकुस १३:३२-३७</ref>; <ref loc="LUK 17:26-30">लूका १७:२६-३०</ref>,<ref loc="LUK 17:34-36">३४-३६</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“पर ऊ दिन अऊर ऊ समय को बारे म कोयी नहीं जानय, नहीं स्वर्गदूत अऊर नहीं बेटा, पर केवल बाप।”<verse eid="MAT 24:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 24:37" />“जसो नूह को दिन म भयो होतो, वसोच आदमी को बेटा को आनो भी होयेंन।” <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />कहालीकि जसो जल-प्रलय सी पहिले को दिनो म, जो दिन तक कि नूह जहाज पर नहीं चढ़्यो, ऊ दिन तक लोग खातो-पीतो होतो, अऊर उन म बिहाव होत होतो। <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />अऊर जब तक जल-प्रलय आय क उन सब ख बहाय नहीं ले गयो, तब तक उन्ख कुछ भी मालूम नहीं पड़्यो; वसोच आदमी को बेटा को आवनो भी होयेंन। <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />ऊ समय दोय लोग खेत म होयेंन, एक उठाय लियो जायेंन अऊर दूसरों छोड़ दियो जायेंन। <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />दोय बाई गरहट पीसती रहेंन, एक उठाय ली जायेंन अऊर दूसरी छोड़ दी जायेंन। <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />“येकोलायी जागतो रहो, कहालीकि तुम नहीं जानय कि तुम्हरो प्रभु कौन्सो दिन आयेंन। <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" /><note caller="+" style="x"><char style="xo" closed="false">२४:४३ </char><char style="xt" closed="false"><ref loc="LUK 12:39">लूका १२:३९</ref>,<ref loc="LUK 12:40">४०</ref></char></note>पर यो जान लेवो कि यदि घर को मालिक जानतो कि चोर कौन्सो समय आयेंन त जागतो रहतो, अऊर अपनो घर म चोरी होन नहीं देतो। <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />येकोलायी तुम भी तैयार रहो, कहालीकि ओको आवन को बारे म तुम सोचय भी नहीं हय, उच समय आदमी को बेटा आय जायेंन।”<verse eid="MAT 24:44" /></para>
  <para style="s">विश्वास लायक सेवक अऊर शैतानी सेवक</para>
  <para style="r">(<ref loc="LUK 12:41-48">लूका १२:४१-४८</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />“येकोलायी ऊ विश्वास लायक अऊर बुद्धिमान सेवक कौन हय, जेक मालिक न अपनो नौकर-चाकर पर मुखिया ठहरायो कि समय पर उन्ख भोजन दे? <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />धन्य हय ऊ सेवक, जेक ओको मालिक आय क असोच करतो देखे। <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />मय तुम सी सच कहू हय, ऊ ओख अपनी सब जायजाद पर अधिकारी ठहरायेंन।” <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />पर यदि ऊ दुष्ट सेवक अपनो मन म सोचन लग्यो कि मोरो मालिक को आवनो म समय हय, <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />अऊर अपनो संगी सेवकों ख पीटन लग्यो, अऊर पीवन वालो को संग खान-पीवन लग्यो। <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />त ऊ सेवक को मालिक असो दिन आयेंन, जब ऊ ओकी रस्ता नहीं देखेंन, अऊर असो समय ख जेक ऊ नहीं जानय हय, <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" /><note caller="+" style="f"><char style="fr" closed="false">२४:५१ </char><char style="ft" closed="false">ओख कठोर दण्ड देयेंन यां तुकड़ातुकड़ा कर क् फेक देयेंन।</char></note>तब ऊ ओख भारी ताड़ना देयेंन अऊर ओको हिस्सा कपटियों को संग ठहरायेंन: उत रोवनो अऊर दात कटरनो होयेंन।<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">दस कुंवारियों को दृष्टान्त</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२५:१ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:35">लूका १२:३५</ref>
      </char>
    </note>“स्वर्ग को राज्य उन दस कुंवारियों को जसो होयेंन जो अपनी दीया पकड़ क दूल्हा सी मिलन लायी निकली। <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />उन्म पाच मूर्ख अऊर पाच समझदार होती। <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />मूर्खो न अपनी दीया त ली, पर अपनो संग तेल नहीं लियो; <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />पर समझदारों न अपनी दीया को संग अपनो कुप्पियों म तेल भी भर लियो। <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />जब दूल्हा को आनो म देर भयी, त हि सब नींद सी झुलन लगी अऊर सोय गयी।”<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />“अरधी रात ख धूम मची: ‘देखो, दूल्हा आय रह्यो हय! ओको सी मिलन लायी चलो।’ <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />तब हि सब कुंवारिया उठ क अपनी दीया ठीक करन लगी। <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />अऊर मूर्खो न समझदारों सी कह्यो, ‘अपनो तेल म सी कुछ हम्ख भी देवो, कहालीकि हमरो दीया बुझ रह्यो हंय।’ <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />पर समझदारों न उत्तर दियो, ‘यो हमरो अऊर तुम्हरो लायी पूरो नहीं होय; भलो त यो हय कि तुम तेल बेचन वालो को जवर जाय क अपनो लायी ले लेवो।’ <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />जब हि तेल लेन ख जाय रही होती त दूल्हा आय पहुंच्यो, अऊर जो तैयार होती, हि ओको संग बिहाव को भवन म चली गयी अऊर दरवाजा बन्द कर दियो गयो।”<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२५:११ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 13:25">लूका १३:२५</ref>
      </char>
    </note>“येको बाद हि दूसरी कुंवारिया भी आय क कहन लगी, ‘हे मालिक, हे मालिक, हमरो लायी दरवाजा खोल दे अऊर हम ख अन्दर आवन दे!’ <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />ओन उत्तर दियो, ‘मय तुम सी सच कहूं हय, मय तुम्ख नहीं जानु।’”<verse eid="MAT 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 25:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२५:१३ </char>
      <char style="xt" closed="false">
        <ref loc="MRK 13:35">मरकुस १३:३५</ref>; <ref loc="LUK 12:40">लूका १२:४०</ref></char>
    </note>येकोलायी “जागतो रहो,” कहालीकि तुम न ऊ दिन ख जानय हय, अऊर न ऊ समय ख।<verse eid="MAT 25:13" /></para>
  <para style="s">तीन सेवकों को दृष्टान्त</para>
  <para style="r">(<ref loc="LUK 19:11-27">लूका १९:११-२७</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२५:१४ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:11-27">लूका १९:११-२७</ref>
      </char>
    </note>“कहालीकि यो ऊ आदमी को जसो हय जेन परदेश जातो समय अपनो सेवकों ख बुलाय क अपनी जायजाद उन्ख सौंप दियो। <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />ओन एक ख पाच हजार सोनो को सिक्का दियो, दूसरों ख दोय हजार दियो, अऊर तीसरो ख एक हजार; यानेकि हर एक ख ओकी लायकता को अनुसार दियो, अऊर तब ऊ अपनी यात्रा पर चली गयो। <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />तब, जेक पाच हजार को सिक्का मिल्यो होतो, ओन तुरतच जाय क उन्को सी लेन-देन करयो, अऊर पाच हजार सिक्का अऊर कमायो। <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />योच रीति सी जेक दोय हजार सोनो को सिक्का मिल्यो होतो, ओन भी दोय अऊर कमायो। <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />पर जेक एक हजार सोनो को सिक्का मिल्यो होतो, ओन जाय क माटी खोदी, अऊर अपनो मालिक को धन लूकाय दियो।” <figure style="fig" alt="Talents" file="hk00168c.tif" size="col" copy="Horace Knowles ©" ref="२५:१५">सोनो को सिक्का</figure><verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“बहुत दिनो को बाद उन सेवकों को मालिक आय क उन्को सी हिसाब लेन लग्यो। <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />जो नौकर ख पाच हजार सिक्का मिल्यो होतो, ओन आय क दूसरों पाच हजार सिक्का अऊर लाय क कह्यो, ‘हे मालिक, तय न मोख पाच हजार सिक्का दियो, देख, मय न पाच हजार सिक्का अऊर कमायो हंय।’ <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />ओको मालिक न ओको सी कह्यो, ‘शाबाश, हे अच्छो अऊर विश्वास लायक सेवक, तय थोड़ो म विश्वास लायक रह्यो; मय तोख बहुत धन को अधिकारी बनाऊं। अपनो मालिक की खुशी म सहभागी हो।’”<verse eid="MAT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 25:22" />अऊर जेक दोय हजार सिक्का मिल्यो होतो, ओन भी आय क कह्यो, हे मालिक, “तय न मोख दोय हजार सिक्का दियो होतो, देख, मय न दोय हजार सिक्का अऊर कमायो।” <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />ओको मालिक न ओको सी कह्यो, “शाबाश, हे अच्छो अऊर विश्वास लायक सेवक, तय थोड़ो म विश्वास लायक रह्यो; मय तोख बहुत धन को अधिकारी बनाऊं। अपनो स्वामी को खुशी म सहभागी हो।”<verse eid="MAT 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 25:24" />“तब जेक एक हजार सिक्का मिल्यो होतो, ओन आय क कह्यो, ‘हे मालिक, मय तोख जानत होतो कि तय कठोर आदमी हय: तय जित कहीं नहीं बोवय उत काटय हय, अऊर जित नहीं बोवय उत सी जमा करय हय। <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />येकोलायी मय डर गयो अऊर जाय क तोरो धन माटी म लूकाय दियो। देख, जो तोरो हय, ऊ यो आय।’”<verse eid="MAT 25:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 25:26" />ओको मालिक न ओख उत्तर दियो, “हे दुष्ट अऊर आलसी सेवक, जब तय यो जानत होतो कि जित मय न फसल नहीं बोयो, उत सी फसल काटू हय, अऊर जित मय न बीज नहीं बोयो उत सी फसल जमा कर लेऊ हय; <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />त तोख समझनो होतो कि मोरो धन व्यापारी ख दे देतो, तब मय आय क अपनो धन ब्याज समेत ले लेतो। <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />अब, धन ख ओको सी ले लेवो, अऊर जेको जवर दस हजार को सिक्का हंय, ओख दे देवो। <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" /><note caller="+" style="x"><char style="xo" closed="false">२५:२९ </char><char style="xt" closed="false"><ref loc="MAT 13:12">मत्ती १३:१२</ref>; <ref loc="MRK 4:25">मरकुस ४:२५</ref>; <ref loc="LUK 8:18">लूका ८:१८</ref></char></note>हर एक आदमी लायी जेको जवर कुछ हय, ओख अऊर भी जादा दियो जायेंन; अऊर ओको जवर जादा सी जादा होयेंन: पर जो आदमी को जवर कुछ भी नहाय, यो तक कि ओको जवर जो कुछ भी हय, ऊ ओको सी ले लियो जायेंन। <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" /><note caller="+" style="x"><char style="xo" closed="false">२५:३० </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्ती ८:१२</ref>; <ref loc="MAT 22:13">२२:१३</ref>; <ref loc="LUK 13:28">लूका १३:२८</ref></char></note>अऊर यो बेकार सेवक ख बाहेर अन्धारो म डाल देवो, जित रोवनो अऊर दात कटरनो होयेंन।”<verse eid="MAT 25:30" /></para>
  <para style="s">आखरी न्याय</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२५:३१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:27">मत्ती १६:२७</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:28">मत्ती १९:२८</ref>
      </char>
    </note>“जब आदमी को बेटा अपनी महिमा म आयेंन अऊर सब स्वर्गदूत ओको संग आयेंन, त ऊ अपनी महिमा को सिंहासन पर विराजमान होयेंन। <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />अऊर सब राष्ट्रों को लोगों ख ओको आगु जमा करयो जायेंन; अऊर जसो चरावन वालो मेंढीं ख शेरी सी अलग कर देवय हय, वसोच ऊ उन्ख एक दूसरों सी अलग करेंन। <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />ऊ मेंढीं ख अपनो दायो तरफ अऊर शेरी ख बायो तरफ खड़ो करेंन।<note caller="+" style="f"><char style="fr" closed="false">२५:३३ </char><char style="ft" closed="false">सच्चो व्यक्ति ख बतायो जाय रह्यो हय</char></note> <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />तब राजा अपनो दायो तरफ वालो सी कहेंन, ‘हे मोरो बाप को धन्य लोगों, आवो, ऊ राज्य को अधिकारी होय जावो, जो जगत की सुरूवात सी तुम्हरो लायी तैयार करयो गयो हय। <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />कहालीकि मय भूखो होतो, अऊर तुम्न मोख खान ख दियो; मय प्यासो होतो, अऊर तुम्न मोख पानी पिलायो; मय अनजान होतो, अऊर तुम न मोख अपनो घर म रख्यो; <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />मय नंगा होतो, अऊर तुम्न मोख कपड़ा पहिनायो; मय बीमार होतो, अऊर तुम्न मोरी देखभाल करी, मय जेलखाना म होतो, अऊर तुम मोरो सी मिलन आयो।’<verse eid="MAT 25:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 25:37" />“तब सच्चो ओख उत्तर देयेंन, ‘हे प्रभु, हम न कब तोख भूखो देख्यो अऊर खिलायो? यां प्यासो देख्यो अऊर पानी पिलायो? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />हम न तोख कभी अनजानो देख्यो अऊर अपनो घर म ठहरायो? यां बिना कपड़ा को देख क मोख कपड़ा पहिनायो? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />हम्न कब तोख बीमार यां जेलखाना म देख्यो अऊर तोरो सी मिलन आयो?’ <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />तब राजा उन्ख उत्तर देयेंन, ‘मय तुम सी सच कहू हय कि तुम्न जो मोरो इन छोटो भाऊवों म सी कोयी एक को संग करयो, ऊ मोरोच संग करयो।’<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />“तब ऊ बायो तरफ वालो सी कहेंन, ‘हे श्रापित लोगों,<note caller="+" style="f"><char style="fr" closed="false">२५:४१ </char><char style="ft" closed="false">यो शैतान को पीछू चलन वालो ख कह्यो गयो हय</char></note> मोरो आगु सी ऊ अनन्त आगी म चली जावो, जो शैतान अऊर ओको दूतों लायी तैयार करी गयी हय। <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />कहालीकि मय भूखो होतो, अऊर तुम्न मोख खान ख नहीं दियो; मय प्यासो होतो, अऊर तुम्न मोख पानी नहीं पिलायो; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />मय अनजानो होतो, अऊर तुम्न मोख अपनो घर म नहीं रख्यो; मय नंगा होतो, अऊर तुम्न मोख कपड़ा नहीं पहिनायो; अऊर मय बीमार अऊर जेलखाना म होतो, अऊर तुम्न मोरी सुधि नहीं ली।’<verse eid="MAT 25:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 25:44" />“तब हि उत्तर देयेंन, ‘हे प्रभु, हम्न तोख कब भूखो, प्यासो, अनजान, नंगा, बीमार, यां जेलखाना म देख्यो, अऊर तोरी सेवा नहीं करी?’ <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />तब ऊ उन्ख उत्तर देयेंन, ‘मय तुम सी सच कहू हय कि तुम्न जो इन छोटो सी छोटो म सी कोयी एक को संग मदत नहीं करयो, ऊ मोरो संग भी नहीं करयो।’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />अऊर हि अनन्त सजा भोगन लायी लिजायेंन पर धर्मी न्याय को अनन्त जीवन म सिरेंन।”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">यीशु को विरुद्ध साजीश</para>
  <para style="r">(<ref loc="MRK 14:1">मरकुस १४:१</ref>,<ref loc="MRK 14:2">२</ref>; <ref loc="LUK 22:1">लूका २२:१</ref>,<ref loc="LUK 22:2">२</ref>; <ref loc="JHN 11:45-53">यूहन्ना ११:४५-५३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />जब यीशु यो सब बाते कह्य चुक्यो त अपनो चेलावों सी कहन लग्यो, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" /><note caller="+" style="x"><char style="xo" closed="false">२६:२ </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">निर्गमन १२:१-२७</ref></char></note>“तुम जानय हय कि दोय दिन को बाद फसह को पर्व हय, अऊर आदमी को बेटा क्रूस पर चढ़ायो जान लायी पकड़वायो जायेंन।”<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />तब मुख्य याजकों अऊर प्रजा को बुजूर्गों कैफा नाम को महायाजक को भवन म जमा भयो, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />अऊर आपस म बिचार करन लग्यो कि यीशु ख चुपचाप सी पकड़ क मार डालो। <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />पर हि कहत होतो, “पर्व को समय नहीं, कहीं असो नहीं होय कि लोगों म दंगा होय जाये।”<verse eid="MAT 26:5" /></para>
  <para style="s">बैतनिय्याह म यीशु को अभिषेक</para>
  <para style="r">(<ref loc="MRK 14:3-9">मरकुस १४:३-९</ref>; <ref loc="JHN 12:1-8">यूहन्ना १२:१-८</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />जब यीशु बैतनिय्याह म शिमोन कोढ़ी को घर म होतो, <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" /><note caller="+" style="x"><char style="xo" closed="false">२६:७ </char><char style="xt" closed="false"><ref loc="LUK 7:37">लूका ७:३७</ref>,<ref loc="LUK 7:38">३८</ref></char></note>त एक बाई संगमरमर को बर्तन म बहुमूल्य अत्तर ले क ओको जवर आयी, अऊर जब ऊ जेवन करन बैठ्यो होतो त ओकी मुंड पर कुड़ाय दियो। <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />यो देख क ओको चेला गुस्सा भयो अऊर कहन लग्यो, “येको कहाली नाश करयो गयो? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />येख त अच्छो दाम पर बेच क गरीबों ख बाट्यो जाय सकत होतो।”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />यो जान क यीशु न उन्को सी कह्यो, “या बाई ख कहाली सतावय हय? ओन मोरो संग भलायी को काम करयो हय। <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />गरीब त तुम्हरो संग हमेशा रह्य हंय, पर मय तुम्हरो संग हमेशा नहीं रहूं। <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />ओन मोरो शरीर पर जो यो अत्तर कुड़ायो हय, ऊ मोरो गाड़्यो जान की तैयारी लायी करयो हय। <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />मय तुम सी सच कहू हय, कि पूरो जगत म जित कहीं यो सुसमाचार प्रचार करयो जायेंन, उत ओको यो काम को वर्नन भी ओकी याद म करयो जायेंन।”<verse eid="MAT 26:13" /></para>
  <para style="s">यहूदा इस्करियोती को विश्वासघात</para>
  <para style="r">(<ref loc="MRK 14:10">मरकुस १४:१०</ref>,<ref loc="MRK 14:11">११</ref>; <ref loc="LUK 22:3-6">लूका २२:३-६</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />तब यहूदा इस्करियोती न, जो बारा चेलावों म सी एक होतो, मुख्य याजकों को जवर गयो, <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />अऊर ओन कह्यो, “यदि मय ओख तुम्हरो हाथ म सौंप देऊ त मोख का देवो?” उन्न ओख तीस चांदी को सिक्का गिन क दे दियो। <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />अऊर ऊ उच समय सी ओख सौंपन को अच्छो मौका ढूंढन लग्यो।<verse eid="MAT 26:16" /></para>
  <para style="s">चेलावों को संग फसह को आखरी भोज</para>
  <para style="r">(<ref loc="MRK 14:12-21">मरकुस १४:१२-२१</ref>; <ref loc="LUK 22:7-13">लूका २२:७-१३</ref>,<ref loc="LUK 22:21-23">२१-२३</ref>; <ref loc="JHN 13:21-30">यूहन्ना १३:२१-३०</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />अखमीरी रोटी को पर्व को पहिलो दिन, चेला यीशु को जवर आय क पूछन लग्यो, “तय कहां पर चाहवय हय कि हम तोरो लायी फसह खान की तैयारी करे?”<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />ओन कह्यो, “नगर म अनजान आदमी को जवर जाय क ओको सी कहो, ‘गुरु कह्य हय कि मोरो समय जवर हय। मय अपनो चेलावों को संग तोरो इत फसह को पर्व मनाऊं।’”<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />येकोलायी चेलावों न यीशु की आज्ञा मानी अऊर फसह तैयार करयो।<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />जब शाम भयी त ऊ बारयी चेलावों को संग जेवन करन लायी बैठ्यो। <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />जब हि खाय रह्यो होतो त ओन कह्यो, “मय तुम सी सच कहू हय कि तुम म सी एक मोख पकड़वायेंन।”<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />येको पर हि बहुत उदास भयो, अऊर हर एक चेला ओको सी पूछन लग्यो, “हे प्रभु, का ऊ मय आय?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />यीशु न उत्तर दियो, “जेन मोरो संग थारी म हाथ डाल्यो हय, उच मोख पकड़वायेंन। <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" /><note caller="+" style="x"><char style="xo" closed="false">२६:२४ </char><char style="xt" closed="false"><ref loc="PSA 22:7-8">भजन २२:७-८</ref>; <ref loc="ISA 53:9">यशायाह ५३:९</ref></char></note>आदमी को बेटा त जसो ओको बारे म लिख्यो हय, पर ऊ आदमी लायी शोक हय जेको द्वारा आदमी को बेटा पकड़वायो जावय हय: यदि ऊ आदमी को जनमच नहीं होतो, त ओको लायी भलो होतो।”<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />तब ओको सौंपन वालो यहूदा न कह्यो, “हे गुरु, का ऊ मय आय?”</para>
  <para style="p" vid="MAT 26:25">ओन ओको सी कह्यो, “तय कह्य चुक्यो।”<verse eid="MAT 26:25" /></para>
  <para style="s">प्रभु-भोज</para>
  <para style="r">(<ref loc="MRK 14:22-26">मरकुस १४:२२-२६</ref>; <ref loc="LUK 22:14-20">लूका २२:१४-२०</ref>; <ref loc="1CO 11:23-25">१ कुरिन्थियों ११:२३-२५</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />जब हि खाय रह्यो होतो त यीशु न रोटी ली, अऊर धन्यवाद कर क् तोड़ी, अऊर चेलावों ख दे क कह्यो, “लेवो, खावो; यो मोरो शरीर आय।”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />तब ओन कटोरा पकड़ क धन्यवाद करयो, अऊर उन्ख दे क कह्यो, “तुम सब येको म सी पीवो, <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />कहालीकि यो वाचा को मोरो ऊ खून आय, जो पूरो लोगों लायी पापों की माफी लायी बहायो जावय हय। <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />मय तुम सी कहू हय कि अंगूर को यो रस ऊ दिन तक कभी नहीं पीऊ, जब तक तुम्हरो संग अपनो बाप को राज्य म नयो रस नहीं पी लेऊ।”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />तब हि भजन गाय क जैतून पहाड़ी पर गयो।<verse eid="MAT 26:30" /></para>
  <para style="s">पतरस को इन्कार की भविष्यवानी</para>
  <para style="r">(<ref loc="MRK 14:27-31">मरकुस १४:२७-३१</ref>; <ref loc="LUK 22:31-34">लूका २२:३१-३४</ref>; <ref loc="JHN 13:36-38">यूहन्ना १३:३६-३८</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२६:३१ </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 13:7">जकर्याह १३:७</ref>
      </char>
    </note>तब यीशु न उन्को सी कह्यो, “तुम सब अजच रात ख मोरो बारे म ठोकर खावो, कहालीकि शास्त्र म लिख्यो हय: ‘मय चरवाहे ख मारू, अऊर झुण्ड की मेंढीं तितर-बितर होय जायेंन।’ <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" /><note caller="+" style="x"><char style="xo" closed="false">२६:३२ </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्ती २८:१६</ref></char></note>पर मय जीन्दो होन को बाद तुम सी पहिले गलील ख जाऊं।”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />येको पर पतरस न यीशु सी कह्यो, “यदि सब तोरो वजह सी ठोकर खावय त खावय, पर मय कभी भी ठोकर नहीं खाऊ।”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />यीशु न पतरस सी कह्यो, “मय तोरो सी सच कहू हय कि अजच रात ख मुर्गा को बाग देन सी पहिले, तय तीन बार मोरो इन्कार करजो।”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />पतरस न ओको सी कह्यो, “यदि मोख तोरो संग मरनो भी पड़ेंन, तब भी मय तोरो मय कभी इन्कार नहीं करूं।”</para>
  <para style="p" vid="MAT 26:35">अऊर असोच सब चेलावों न भी कह्यो।<verse eid="MAT 26:35" /></para>
  <para style="s">गतसमनी म प्रार्थना</para>
  <para style="r">(<ref loc="MRK 14:32-42">मरकुस १४:३२-४२</ref>; <ref loc="LUK 22:39-46">लूका २२:३९-४६</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />तब यीशु अपनो चेलावों को संग गतसमनी नाम को एक जागा म आयो अऊर अपनो चेलावों सी कहन लग्यो, “इतच बैठ्यो रहजो, जब तक मय उत जाय क प्रार्थना करूं।” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />ऊ पतरस अऊर जब्दी को दोयी टुरावों ख संग ले गयो, अऊर उदास अऊर व्याकुल होन लग्यो। <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />तब ओन उन्को सी कह्यो, “मोरो मन बहुत उदास हय, यहां तक कि मोरो जीव निकल्यो जाय रह्यो हय। तुम इतच ठहरो अऊर मोरो संग जागतो रहो।”<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />तब ऊ थोड़ो अऊर आगु बढ़ क मुंह को बल गिरयो, अऊर यो प्रार्थना करी, “हे मोरो बाप, यदि होय सकय त यो दु:ख को कटोरा मोरो सी टल जाये, तब भी जसो मय चाहऊ हय वसो नहीं, पर जसो तय चाहऊ हय वसोच हो।”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />तब ओन चेलावों को जवर आय क उन्ख सोतो देख्यो अऊर पतरस सी कह्यो, “का तुम मोरो संग एक घड़ी भी नहीं जाग सक्यो? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />जागतो रहो, अऊर प्रार्थना करतो रहो कि तुम परीक्षा म मत पड़ो: आत्मा त तैयार हय, पर शरीर कमजोर हय।”<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />तब ओन दूसरी बार जाय क यो प्रार्थना करी, “हे मोरो बाप, यदि यो कटोरा मोरो पीयो बिना नहीं हट सकय त तोरी इच्छा पूरी होय।” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />तब ओन आय क उन्ख फिर सोतो पायो, कहालीकि उन्की आंखी नींद सी भरी होती।<verse eid="MAT 26:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 26:44" />उन्ख छोड़ क ऊ फिर चली गयो, अऊर उन्कोच शब्दों म फिर तीसरी बार प्रार्थना करी। <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />तब ओन चेलावों को जवर आय क उन्को सी कह्यो, “का तुम अब तक सोय रह्यो हय, देखो! घड़ी आय पहुंची हय, अऊर आदमी को बेटा पापियों को हाथ सौंप्यो जायेंन। <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />उठो, चलो; देखो, मोरो सौंपन वालो जवर आय गयो हय।”<verse eid="MAT 26:46" /></para>
  <para style="s">यीशु को धोका सी पकड़ायो जानो</para>
  <para style="r">(<ref loc="MRK 14:43-50">मरकुस १४:४३-५०</ref>; <ref loc="LUK 22:47-53">लूका २२:४७-५३</ref>; <ref loc="JHN 18:3-12">यूहन्ना १८:३-१२</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />यीशु यो कह्यच रह्यो होतो कि यहूदा जो बारयी म सी एक होतो, आयो, अऊर ओको संग मुख्य याजकों अऊर बुजूर्ग लोगों को तरफ सी बड़ी भीड़, तलवारे अऊर लाठियां पकड़ क आयो। <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />ओको सौंपन वालो न उन्ख यो इशारा दियो होतो : “जेक मय चुम्मा लेऊ उच आय; ओख पकड़ लेजो।”<verse eid="MAT 26:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 26:49" />अऊर तुरतच यीशु को जवर आय क कह्यो, “हे गुरु, प्रनाम!” अऊर ओख बहुत चुम्मा लियो।<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />यीशु न ओको सी कह्यो, “हे संगी, जो काम लायी तय आयो हय, ओख कर ले।”</para>
  <para style="p" vid="MAT 26:50">तब उन्न जवर आय क यीशु पर हाथ डाल्यो अऊर ओख पकड़ लियो। <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />यीशु को संगियों म सी एक न हाथ बढ़ाय क अपनी तलवार खीच ली अऊर महायाजक को सेवक पर चलाय क ओको कान काट डाल्यो। <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />तब यीशु न ओको सी कह्यो, “अपनी तलवार म्यान म रख ले कहालीकि जो तलवार चलावय हंय हि सब तलवार सी नाश करयो जायेंन। <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />का तय नहीं जानय कि मय अपनो बाप सी बिनती कर सकू हय, अऊर ऊ स्वर्गदूतों की बारा पलटन सी जादा मोरो जवर अभी खड़ो कर देयेंन? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />पर पवित्र शास्त्र की हि बाते असोच होनो जरूरी हय, कसो पूरी होयेंन?”<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२६:५५ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:47">लूका १९:४७</ref>; <ref loc="LUK 21:37">२१:३७</ref></char>
    </note>ऊ समय यीशु न भीड़ सी कह्यो, “का तुम तलवारे अऊर लाठियां धर क मोख डाकू को जसो पकड़न लायी निकल्यो हय? मय हर दिन मन्दिर म बैठ क उपदेश करत होतो, अऊर तुम न मोख नहीं पकड़्यो।”<verse eid="MAT 26:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="MAT 26:56" />पर यो सब येकोलायी भयो हय कि भविष्यवक्तावों को वचन पूरो होय। तब सब चेला ओख छोड़ क भग गयो।<verse eid="MAT 26:56" /></para>
  <para style="s">महासभा को आगु यीशु</para>
  <para style="r">(<ref loc="MRK 14:53-65">मरकुस १४:५३-६५</ref>; <ref loc="LUK 22:54">लूका २२:५४</ref>,<ref loc="LUK 22:55">५५</ref>,<ref loc="LUK 22:63-71">६३-७१</ref>; <ref loc="JHN 18:13">यूहन्ना १८:१३</ref>,<ref loc="JHN 18:14">१४</ref>,<ref loc="JHN 18:19-24">१९-२४</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />तब यीशु को पकड़न वालो ओख कैफा नाम को महायाजक को जवर लिजायो, जहां धर्मशास्त्री अऊर बुजूर्गों जमा भयो होतो। <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />पतरस दूरच दूर ओको पीछू-पीछू महायाजक को आंगन तक गयो, अऊर अन्दर जाय क यीशु को का होयेंन देखन सेवकों को संग बैठ गयो। <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />मुख्य याजक अऊर पूरी महासभा यीशु ख मार डालन लायी ओको विरोध म झूठी गवाही की खोज म होतो, <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />पर बहुत सो झूठो गवाहों को आनो पर भी नहीं पायो आखरी म दोय लोग आयो, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" /><note caller="+" style="x"><char style="xo" closed="false">२६:६१ </char><char style="xt" closed="false"><ref loc="JHN 2:19">यूहन्ना २:१९</ref></char></note>अऊर कह्यो, “येन कह्यो हय कि मय परमेश्वर को मन्दिर ख गिराय सकू हय अऊर ओख तीन दिन म बनाय सकू हय।”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />तब महायाजक न खड़ो होय क यीशु सी कह्यो, “का तय कोयी उत्तर नहीं देवय? हि लोग तोरो विरोध म का गवाही देवय हंय?” <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />पर यीशु चुप रह्यो। तब महायाजक न ओको सी कह्यो, “मय तोख जीन्दो परमेश्वर की कसम देऊ हय कि यदि तय परमेश्वर को बेटा मसीह आय, त हम सी कह्य दे।”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />यीशु न ओको सी कह्यो, “तय न खुदच कह्य दियो; बल्की मय तुम सी यो भी कहू हय कि अब सी तुम केवल आदमी को बेटा ख सर्वशक्तिमान को दायो तरफ बैठ्यो, अऊर आसमान को बादलो पर आवतो देखो।”<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />येको पर महायाजक न अपनो कपड़ा फाड़्यो अऊर कह्यो, “येन परमेश्वर की निन्दा करी हय, अब हम्ख गवाहों की का जरूरत? देखो, तुम न अभी यो निन्दा सुनी हय! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />तुम का सोचय हय?”</para>
  <para style="p" vid="MAT 26:66">उन्न उत्तर दियो, “यो दोषी हय अऊर येख मरनो चाहिये।”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२६:६७ </char>
      <char style="xt" closed="false">
        <ref loc="ISA 50:6">यशायाह ५०:६</ref>
      </char>
    </note>तब उन्न ओको मुंह पर थूक्यो अऊर ओख घूसा मारयो, दूसरों न थापड़ मार क, <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />कह्यो, “हे मसीह, हम सी भविष्यवानी कर क् कह्य कि कौन न तोख मारयो?”<verse eid="MAT 26:68" /></para>
  <para style="s">पतरस द्वारा इन्कार</para>
  <para style="r">(<ref loc="MRK 14:66-72">मरकुस १४:६६-७२</ref>; <ref loc="LUK 22:56-62">लूका २२:५६-६२</ref>; <ref loc="JHN 18:15-18">यूहन्ना १८:१५-१८</ref>,<ref loc="JHN 18:25-27">२५-२७</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />पतरस बाहेर आंगन म बैठ्यो हुयो होतो कि एक दासी ओको जवर आयी अऊर कह्यो, “तय भी यीशु गलीली को संग होतो।”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />पतरस न सब को आगु यो कहतो हुयो इन्कार करयो, “मय नहीं जानु तय का कह्य रही हय।” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />जब ऊ बाहेर द्वार म गयो, त दूसरी सेविका न ओख देख क उन्को सी जो उत होतो कह्यो, “यो भी त यीशु नासरी को संग होतो।”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />पतरस न कसम खाय क फिर इन्कार करयो: “मय ऊ आदमी ख नहीं जानु।”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />थोड़ी देर बाद लोगों न जो उत खड़ो होतो, पतरस को जवर आय क ओको सी कह्यो, “सचमुच तय भी उन्म सी एक आय, कहालीकि तोरी बोली भाषा न तोरो भेद खोल दियो हय।”<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />तब ऊ धिक्कारन अऊर कसम खान लग्यो: “मय ऊ आदमी ख नहीं जानु।”</para>
  <para style="p" vid="MAT 26:74">अऊर तुरतच मुर्गा न बाग दियो। <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />तब पतरस ख यीशु की कहीं हुयी बात याद म आयी: “मुर्गा को बाग देन सी पहिले तय तीन बार मोरो इन्कार करजो।” अऊर ऊ बाहेर जाय क फूट फूट क रोयो।<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">पिलातुस को आगु यीशु</para>
  <para style="r">(<ref loc="MRK 15:1">मरकुस १५:१</ref>; <ref loc="LUK 23:1">लूका २३:१</ref>,<ref loc="LUK 23:2">२</ref>; <ref loc="JHN 18:28-32">यूहन्ना १८:२८-३२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />जब सबेरे भयी त सब मुख्य याजकों अऊर बुजूर्गों लोगों न यीशु ख मार डालन की योजना बनायी। <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />उन्न ओख बान्ध्यो अऊर ले जाय क पिलातुस शासक को हाथ म सौंप दियो।<verse eid="MAT 27:2" /></para>
  <para style="s">यहूदा की मृत्यु</para>
  <para style="r">(<ref loc="ACT 1:18">प्रेरितों १:१८</ref>,<ref loc="ACT 1:19">१९</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२७:३ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:18-19">प्रेरितों १:१८-१९</ref>
      </char>
    </note>जब ओको सौंपन वालो यहूदा न देख्यो कि ऊ दोषी ठहरायो गयो हय त ऊ पछतायो अऊर हि तीस चांदी को सिक्का मुख्य याजकों अऊर बुजूर्गों को जवर वापस देन गयो <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />अऊर कह्यो, “मय न निर्दोष ख मारन लायी सौंप क पाप करयो हय!”</para>
  <para style="p" vid="MAT 27:4">उन्न कह्यो, “हम्ख ओकी का परवाह हय? उन्न जवाब दियो। अपनो तयच देख ले।”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />तब ऊ उन सिक्का ख मन्दिर म फेक क चली गयो, अऊर जाय क अपनो आप ख फासी दे दियो।<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />मुख्य याजकों न उन सिक्का ले क कह्यो, “इन्क, भण्डार म रखनो ठीक नहाय, कहालीकि यो खून को दाम आय।” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />येकोलायी उन्न सलाह कर क् उन सिक्का सी परदेशियों को गाड़्यो जान लायी कुम्हार को खेत ले लियो। <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />यो वजह ऊ खेत अज तक खून को खेत कहलावय हय।<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />तब जो वचन यिर्मयाह भविष्यवक्ता सी कह्यो गयो होतो ऊ पूरो भयो: “उन्न हि तीस सिक्का यानेकि ऊ ठहरायो हुयो कीमत ख जेक इस्राएल की सन्तान म सी कितनो न सम्मति सी ठहरायो होतो ऊ ले लियो, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />अऊर जसो प्रभु न मोख आज्ञा दियो होतो वसोच उन्ख कुम्हार को खेत ख मोल म ले लियो।”<verse eid="MAT 27:10" /></para>
  <para style="s">पिलातुस को प्रश्न</para>
  <para style="r">(<ref loc="MRK 15:2-5">मरकुस १५:२-५</ref>; <ref loc="LUK 23:3-5">लूका २३:३-५</ref>; <ref loc="JHN 18:33-38">यूहन्ना १८:३३-३८</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />जब यीशु रोमन शासक को आगु खड़ो होतो त शासक न ओको सी पुच्छ्यो, “का तय यहूदियों को राजा आय?”</para>
  <para style="p" vid="MAT 27:11">यीशु न ओको सी कह्यो, “तय खुदच कह्य रह्यो हय।” <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />जब मुख्य याजक अऊर बुजूर्ग ओको पर दोष लगाय रह्यो होतो, त यीशु न कुछ उत्तर नहीं दियो।<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />येको पर पिलातुस न ओको सी कह्यो, “का तय नहीं सुनय कि यो तोरो विरोध म कितनी गवाही दे रह्यो हय?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />पर यीशु न ओख एक बात को भी उत्तर नहीं दियो, यहां तक कि शासक ख बड़ो आश्चर्य भयो।<verse eid="MAT 27:14" /></para>
  <para style="s">यीशु ख मृत्यु–दण्ड की आज्ञा</para>
  <para style="r">(<ref loc="MRK 15:6-15">मरकुस १५:६-१५</ref>; <ref loc="LUK 23:13-25">लूका २३:१३-२५</ref>; <ref loc="JHN 18:39-19:16">यूहन्ना १८:३९–१९:१६</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />शासक की यो रीति होती कि ऊ पर्व म लोगों लायी कोयी एक बन्दी ख जेक हि चाहत होतो, छोड़ देत होतो। <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />ऊ समय उन्को इत बरअब्बा नाम को एक बदनाम आदमी बन्दी होतो। <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />येकोलायी जब हि जमा भयो, त पिलातुस न उन्को सी कह्यो, “तुम कौन्क चाहवय हय कि मय तुम्हरो लायी छोड़ देऊ? बरअब्बा ख, यां यीशु ख जो मसीह कहलावय हय?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />कहालीकि ऊ जानत होतो कि उन्न ओख धोका सी पकड़वायो हय।<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />जब पिलातुस न्याय कि गद्दी पर बैठ्यो हुयो होतो त ओकी पत्नी न ओख कह्यो, “तय ऊ सच्चो को मामला म हाथ मत डालजो, कहालीकि मय न अज सपनो म ओको वजह बहुत दु:ख उठायो हय।”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />मुख्य याजकों अऊर बुजूर्गों लोगों न पिलातुस ख बहकायो कि हि बरअब्बा ख मांग ले, अऊर यीशु को नाश करायो। <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />लेकिन पिलातुस न भीड़ सी पुच्छ्यो, “तुम इन दोयी म सी कौन्सो चाहवय हय कि मय तुम्हरो लायी फुकट म छोड़ देऊ?”</para>
  <para style="p" vid="MAT 27:21">उन्न कह्यो, “बरअब्बा” ख।<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />पिलातुस न ओको सी पुच्छ्यो, “फिर यीशु ख, जो मसीह कहलावय हय, का करू?”</para>
  <para style="p" vid="MAT 27:22">सब न ओको सी कह्यो, “ऊ क्रूस पर चढ़ायो जाय!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />शासक न कह्यो, “कहाली, ओन का बुरायी करी हय?”</para>
  <para style="p" vid="MAT 27:23">पर हि अऊर भी चिल्लाय-चिल्लाय क कहन लग्यो, “ऊ क्रूस पर चढ़ायो जाये।”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />जब पिलातुस न देख्यो कि कुछ बन नहीं पड़य पर येको विरुद्ध हल्ला बढ़तो जावय हय, त ओन पानी ले क भीड़ को आगु अपनो हाथ धोयो अऊर कह्यो, “मय यो सच्चो को खून सी निर्दोष हय; तुमच जानो।”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />सब लोगों न उत्तर दियो, “येको खून हम पर अऊर हमरी सन्तान पर हो!”<verse eid="MAT 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 27:26" />येको पर ओन बरअब्बा ख उन्को लायी छोड़ दियो, अऊर यीशु ख कोड़ा मरवाय क सौंप दियो, कि क्रूस पर चढ़ायो जाये।<verse eid="MAT 27:26" /></para>
  <para style="s">सिपाहियों द्वारा यीशु को अपमान</para>
  <para style="r">(<ref loc="MAT 15:16-20">१५:१६-२०</ref>; <ref loc="JHN 19:2">यूहन्ना १९:२</ref>,<ref loc="JHN 19:3">३</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />तब शासक को सिपाहियों न यीशु ख राजभवन म ले जाय क पूरी पलटन ओको चारयी तरफ जमा करयो, <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />अऊर ओको कपड़ा उतार क ओख लाल रंग को चोंगा पहिनायो, <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />अऊर काटा को मुकुट गूथ क ओको मुंड पर रख्यो, अऊर ओको दायो हाथ म सरकण्डा दियो अऊर ओको आगु घुटना टेक क ओकी मजाक उड़ावन लग्यो अऊर कह्यो, “हे यहूदियों को राजा, प्रनाम!” <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />अऊर ओको पर थूक्यो; अऊर उच सरकण्डा ले क ओको मुंड पर मारन लग्यो। <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />जब हि ओकी मजाक उड़ाय लियो त ऊ चोंगा ओको पर सी उतार क फिर ओकोच कपड़ा ओख पहिनायो, अऊर क्रूस पर चढ़ान लायी ले गयो।<verse eid="MAT 27:31" /></para>
  <para style="s">यीशु को क्रूस पर चढ़ायो जानो</para>
  <para style="r">(<ref loc="MRK 15:21-32">मरकुस १५:२१-३२</ref>; <ref loc="LUK 23:26-43">लूका २३:२६-४३</ref>; <ref loc="JHN 19:17-27">यूहन्ना १९:१७-२७</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />बाहेर जातो हुयो उन्ख शिमोन नाम को एक कुरेनी आदमी मिल्यो। उन्न ओख बेकार म पकड़्यो कि ओको क्रूस ख उठाय क ले चल्यो। <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />ऊ जागा पर जो गुलगुता यानेकि खोपड़ी की जागा कहलावय हय, पहुंच क <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />उन्न पित्त मिलायो हुयो अंगूररस ओख पीवन ख दियो, पर ओन चख क पीनो नहीं चाह्यो।<verse eid="MAT 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 27:35" />तब उन्न ओख क्रूस पर चढ़ायो, अऊर चिट्ठियां डाल क ओको कपड़ा बाट लियो, <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />अऊर उत बैठ क ओकी पहरेदारी करन लग्यो। <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />अऊर ओकी दोष कि चिट्ठी ओकी मुंड को ऊपर लगायो, कि “यो यहूदियों को राजा यीशु आय।” <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />तब यीशु को संग दोय डाकू ख क्रूस पर चढ़ायो गयो एक ख दायो तरफ अऊर एक ख बायो तरफ।<verse eid="MAT 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 27:39" />आन–जान वालो मुंड हिला–हिलाय क ओकी निन्दा करत होतो, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" /><note caller="+" style="x"><char style="xo" closed="false">२७:४० </char><char style="xt" closed="false"><ref loc="MAT 26:61">मत्ती २६:६१</ref>; <ref loc="JHN 2:19">यूहन्ना २:१९</ref></char></note>अऊर यो कहत होतो, “हे मन्दिर ख गिरावन वालो अऊर तीन दिन म बनावन वालो, अपनो आप ख त बचाव! यदि तय परमेश्वर को बेटा आय, त क्रूस पर सी उतर आव।”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />योच रीति सी मुख्य याजक भी धर्मशास्त्रियों अऊर बुजूर्गों समेत मजाक कर क् कहत होतो, <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“येन बहुतों ख बचायो, अऊर अपनो आप ख नहीं बचाय सकय। यो त ‘इस्राएल को राजा’ आय। अब क्रूस पर सी उतर आयो त हम ओको पर विश्वास करबो। <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />ओन परमेश्वर पर भरोसा रख्यो हय; यदि ऊ येख चाहवय हय, त अब येख छुड़ाय ले, कहालीकि येन कह्यो होतो, ‘मय परमेश्वर को बेटा आय।’”<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />योच तरह डाकू भी जो ओको संग क्रूस पर चढ़ायो गयो होतो, ओकी निन्दा करत होतो।<verse eid="MAT 27:44" /></para>
  <para style="s">यीशु को जीव छोड़नो</para>
  <para style="r">(<ref loc="MRK 15:33-41">मरकुस १५:३३-४१</ref>; <ref loc="LUK 23:44-49">लूका २३:४४-४९</ref>; <ref loc="JHN 19:28-30">यूहन्ना १९:२८-३०</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />दोपहर सी ले क तीन बजे तक ऊ पूरो प्रदेश म अन्धारो छायो रह्यो। <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />तीन बजे को जवर यीशु न बड़ो आवाज सी पुकार क कह्यो, “एली, एली, लमा शबक्तनी?” यानेकि “हे मोरो परमेश्वर, हे मोरो परमेश्वर, तय न मोख कहाली छोड़ दियो?”<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />जो उत खड़ो होतो, उन्म सी कुछ न यो सुन क कह्यो, “ऊ त एलिय्याह ख पुकार रह्यो हय।” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />उन्म सी एक तुरतच दौड़्यो, अऊर स्पंज ले क सिरका म डुबायो, अऊर सरकण्डा पर रख क ओख चुसायो।<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />दूसरों न कह्यो, “रह्य जावो, देखो एलिय्याह ओख बचावन आवय हय कि नहीं।”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />तब यीशु न फिर ऊचो आवाज सी चिल्लाय क जीव छोड़ दियो।<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />अऊर देखो, मन्दिर को परदा ऊपर सी खल्लो तक फट क दोय टुकड़ा भय गयो: अऊर जमीन हल गयी अऊर चट्टान तड़क गयी, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />अऊर कब्रें खुल गयी, अऊर सोयो हुयो पवित्र लोगों को बहुत सो शरीर जीन्दो भयो, <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />अऊर ओको जीन्दो होन को बाद हि कब्रो म सी निकल क पवित्र नगर यरूशलेम म गयो अऊर बहुत लोगों ख दिखायी दियो।<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />तब सूबेदार अऊर जो ओको संग यीशु की पहरेदारी करत होतो, भूईडोल अऊर जो कुछ भयो होतो ओख देख क बहुतच डर गयो अऊर कह्यो, “सच म यो परमेश्वर को बेटा होतो!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२७:५५ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:2">लूका ८:२</ref>,<ref loc="LUK 8:3">३</ref></char>
    </note>उत बहुत सी बाईयां होती जो गलील सी यीशु की सेवा करती हुयी ओको संग आयी होती, दूर सी यो देख रही होती। <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />उन्म मरियम मगदलीनी, अऊर याकूब अऊर योसेस की माय मरियम, अऊर जब्दी की पत्नी भी होती।<verse eid="MAT 27:56" /></para>
  <para style="s">यीशु को गाड़्यो जानो</para>
  <para style="r">(<ref loc="MRK 15:42-47">मरकुस १५:४२-४७</ref>; <ref loc="LUK 23:50-56">लूका २३:५०-५६</ref>; <ref loc="JHN 19:38-42">यूहन्ना १९:३८-४२</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />जब शाम भयी त यूसुफ नाम को अरिमतिया को एक धनी आदमी जो खुदच यीशु को चेला होतो, ऊ आयो। <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />ओन पिलातुस को जवर जाय क यीशु की लाश मांग्यो। पिलातुस न शरीर ख यूसुफ ख दे देन की आज्ञा दियो। <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />त यूसुफ न लाश लियो, अऊर ओख उज्वल चादर म लपेट्यो, <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />अऊर ओन अपनी नयी कब्र म रख्यो, जो ओन चट्टान म खुदवायी होती, अऊर कब्र को द्वार पर बड़ो गोटा लुढ़काय क चली गयो। <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />मरियम मगदलीनी अऊर दूसरी मरियम उत कब्र को आगु बैठी होती।<verse eid="MAT 27:61" /></para>
  <para style="s">कब्र पर पहरेदारी</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />दूसरों दिन जो आराम दिन को बाद को दिन होतो, मुख्य याजकों अऊर फरीसियों न पिलातुस को जवर जमा होय क कह्यो, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" /><note caller="+" style="x"><char style="xo" closed="false">२७:६३ </char><char style="xt" closed="false"><ref loc="MAT 16:21">मत्ती १६:२१</ref>; <ref loc="MAT 17:23">१७:२३</ref>; <ref loc="MAT 20:19">२०:१९</ref>; <ref loc="MRK 8:31">मरकुस ८:३१</ref>; <ref loc="MRK 9:31">९:३१</ref>; <ref loc="MRK 10:33">१०:३३</ref>,<ref loc="MRK 10:34">३४</ref>; <ref loc="LUK 9:22">लूका ९:२२</ref>; <ref loc="LUK 18:31-33">१८:३१-३३</ref></char></note>“हे महाराज, हम्ख याद हय कि ऊ भरमावन वालो न जब ऊ जीन्दो होतो, त कह्यो होतो, ‘मय तीन दिन को बाद जीन्दो होऊं।’ <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />येकोलायी आज्ञा दे कि तीसरो दिन तक कब्र की पहरेदारी करी जाये, असो नहीं होय कि ओको चेला आय क ओख चोर क लिजाये अऊर लोगों सी कहन लग्यो, ‘ऊ मरयो हुयो म सी जीन्दो भयो हय।’ तब पिछलो धोका पहिलो सी भी बुरो होयेंन।”<verse eid="MAT 27:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 27:65" />पिलातुस न उन्को सी कह्यो, “तुम्हरो जवर पहरेदार त हंय। जावो, अपनी समझ सी कब्र ख रखवाली करो।”<verse eid="MAT 27:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="MAT 27:66" />येकोलायी हि पहरेदारों ख संग ले क गयो, अऊर गोटा पर मुहर लगाय क कब्र ख सुरक्षित कर दियो।<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">यीशु को पुनरुत्थान</para>
  <para style="r">(<ref loc="MRK 16:1-10">मरकुस १६:१-१०</ref>; <ref loc="LUK 24:1-12">लूका २४:१-१२</ref>; <ref loc="JHN 20:1-10">यूहन्ना २०:१-१०</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />आराम दिन को बाद हप्ता को पहिलो दिन भुन्सारे होतोच मरियम मगदलीनी अऊर दूसरी मरियम कब्र ख देखन आयी। <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />अऊर देखो, एक बड़ो भूईडोल भयो, कहालीकि प्रभु को एक दूत स्वर्ग सी उतरयो अऊर जवर आय क ओन गोटा ख लुढ़काय दियो, अऊर ओको पर बैठ गयो। <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />ओको रूप बिजली को जसो चमकत होतो अऊर ओको कपड़ा बर्फ को जसो उज्वल होतो। <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />ओको डर सी पहरेदार काप उठ्यो, अऊर मरयो जसो भय गयो।<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />स्वर्गदूत न बाईयों सी कह्यो, “मत डरो, मय जानु हय कि तुम यीशु ख ढूंढय हय, जो क्रूस पर चढ़ायो गयो होतो। <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />ऊ इत नहाय, पर अपनो वचन को अनुसार जीन्दो भय गयो हय। आवो, या जागा ख देखो, जहां प्रभु पड़्यो होतो, <verse eid="MAT 28:6" /><verse number="7" style="v" sid="MAT 28:7" />अऊर तुरतच जाय क ओको चेलावों सी कहो कि ऊ मरयो हुयो म सी जीन्दो भयो हय, अऊर ऊ तुम सी पहिले गलील ख जायेंन, उत ओको दर्शन पावों! देखो, मय न जो तुम्ख बतायो हय, ओख याद रखो।”<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />हि डर अऊर बड़ो खुशी को संग कब्र सी तुरतच लौट क ओको चेलावों ख समाचार देन लायी दवड़ गयी।<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />तब यीशु उन्ख मिल्यो। अऊर कह्यो, “नमस्कार।” उन्न जवर आय क अऊर ओको पाय पकड़ क ओख प्रनाम करयो। <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />तब यीशु न उन्को सी कह्यो, “मत डरो; मोरो भाऊवों सी जाय क कहो कि गलील ख चली जाये, उत हि मोख देखेंन।”<verse eid="MAT 28:10" /></para>
  <para style="s">पहरेदारों की खबर</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />हि जायच रही होती कि पहरेदारों म सी कुछ न नगर म आय क पूरो हाल मुख्य याजकों सी कह्यो जो कुछ भयो होतो। <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />तब उन्न बुजूर्गों को संग जमा होय क सलाह करी अऊर सिपाहियों ख बहुत धन दियो, <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />अऊर कह्यो “तुम यो कहनो चाहवय हय कि रात ख जब हम सोय रह्यो होतो, त ओको चेला आय क ओको शरीर चुराय ले गयो। <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />अऊर यदि यो बात शासक को कान तक पहुंचेंन, त हम ओख समझाय लेबो कि तुम निर्दोष हय, अऊर तुम्ख चिन्ता करनो सी बचाय लेबो।”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />सिपाहियों न धन लियो अऊर उच करयो जो उन्ख करन लायी कह्यो गयो होतो। अऊर येकोलायी यो बात अज तक यहूदियों द्वारा फैलायी गयी हय।<verse eid="MAT 28:15" /></para>
  <para style="s">यीशु को दिखायी देनो अऊर आखरी आज्ञा</para>
  <para style="r">(<ref loc="MRK 16:14-18">मरकुस १६:१४-१८</ref>; <ref loc="LUK 24:36-49">लूका २४:३६-४९</ref>; <ref loc="JHN 20:19-23">यूहन्ना २०:१९-२३</ref>; <ref loc="ACT 1:6-8">प्रेरितों १:६-८</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२८:१६ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:32">मत्ती २६:३२</ref>; <ref loc="MRK 14:28">मरकुस १४:२८</ref></char>
    </note>ग्यारा चेला गलील म ऊ पहाड़ी पर गयो, जेक यीशु न उन्ख बतायो होतो। <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />जब उन्न ओख देख्यो, त उन्न ओख प्रनाम करयो, तब भी उन्म सी कुछ ख शक भयो। <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />यीशु न उन्को जवर आय क कह्यो, “स्वर्ग अऊर धरती को पूरो अधिकार मोख दियो गयो हय। <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" /><note caller="+" style="x"><char style="xo" closed="false">२८:१९ </char><char style="xt" closed="false"><ref loc="ACT 1:8">प्रेरितों १:८</ref></char></note>येकोलायी तुम जावो, सब लोगों ख चेला बनावो; अऊर उन्ख बाप, अऊर बेटा, अऊर पवित्र आत्मा को नाम सी बपतिस्मा देवो, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />अऊर उन्ख सब बाते जो मय न तुम्ख आज्ञा दियो हय, माननो सिखावो: अऊर देखो, मय जगत को अन्त तक सदा तुम्हरो संग हय।”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>