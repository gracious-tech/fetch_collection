<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Lodhi New Testament</book>
  <para style="h">आमोस</para>
  <para style="toc3">आमोस</para>
  <para style="toc2">आमोस</para>
  <para style="toc1">आमोस</para>
  <para style="mt2">आमोस</para>
  <para style="mt1">आमोस</para>
  <para style="imt">परिचय</para>
  <para style="ip">या किताब म आमोस को भविष्य सूचक संदेश हय। आमोस एक जनावर चरावन वालो <char style="xt"><ref loc="AMO 1:1">१:१</ref></char> अऊर एक किसान <char style="xt"><ref loc="AMO 7:14">७:१४</ref></char> होतो। तब परमेश्वर न ओख अपनो भविष्यवक्ता बनन लायी बुलायो। आमोस तकोआ देश म होतो जो यहूदा को दक्षिनी राज्य म होतो, पर ओको बहुत सो संदेश उत्तर को इस्राएल राज्य को लायी होतो। आमोस न तब भविष्यवानियां करी जब उज्जियाह यहूदा को राजा होतो अऊर यारोबाम दूसरो इस्राएल को राजा होतो। यो लगभग ७५० ई. स. पहले की बात आय।</para>
  <para style="ip">आमोस न पहले दोय अध्यायों म कयी राष्ट्रों को खिलाफ न्याय की भविष्यवानी करी, पर ओको बहुत सो संदेश इस्राएल को लायी होतो। यो इस्राएल को लायी समृद्धि को समय होतो। ऊ समृद्धि को दौरान हि परमेश्वर ख भूल गयो अऊर गरीबों को संग बुरो व्यवहार करयो <char style="xt"><ref loc="AMO 2:6">२:६</ref></char>। येकोलायी परमेश्वर को न्याय उन्ख गुलाम बनाय क लिजानो होतो <char style="xt"><ref loc="AMO 7:17">७:१७</ref></char>। फिर भी परमेश्वर न वादा करयो की ऊ परमेश्वर को लोगों ख उन सब दूसरो देशों पर फिर सी जीत हासील करन म मदत करेंन जिन पर उन्न अतीत म शासन करयो होतो <char style="xt"><ref loc="AMO 9:12">९:१२</ref></char>।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">पहिलो वचन म आमोस अपनो परिचय देवय हय।</para>
  <para style="io1">फिर अध्याय १ अऊर २ को बाकी हिस्सा म ऊ कयी राष्ट्रों पर फैसला सुनावय हय। <char style="ior"><ref loc="AMO 1-2">१–२</ref></char></para>
  <para style="io1">अध्याय इस्राएल को न्याय अऊर गुलामी को बारे म बात करय हय। <char style="ior"><ref loc="AMO 3:9-11">३:९-११</ref></char></para>
  <para style="io1">आखरी म, अध्याय म, परमेश्वर बच्यो विश्वासियों ख इस्राएल म वापस लावन को वादा करय हय। <char style="ior"><ref loc="AMO 9:12-15">९:१२-१५</ref></char></para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />तकोआवासी आमोस जो जनावर चरावन वालों होतो, ओको यो वचन आय जो ओन यहूदा को राजा उजिय्याह को, अऊर योआश को टुरा इस्राएल को राजा यारोबाम को दिनों म, भूईडोल सी दोय साल पहिले, इस्राएल को बारे म दर्शन देख क कह्यो :<verse eid="AMO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 1:2" />“यहोवा सिय्योन सी गरजेंन , अऊर यरूशलेम सी अपनो शब्द सुनायेंन ; तब चरवाहों की चराइयाँ विलाप करेंन , अऊर कर्मेल पहाड़ की सेंडी झुलस जायेंन।”<verse eid="AMO 1:2" /></para>
  <para style="s">इस्राएल को पड़ोसी राज्यों को न्याय</para>
  <para style="s">अराम</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />यहोवा यो कह्य हय : दमिश्क को तीन का, बल्की चार अपराधों को वजह मय ओकी सजा नहीं छोड़ूं; कहालीकि उन्न गिलाद ख लोहा को दांवन वालो अवजारों सी रौंद डाल्यो हंय। <verse eid="AMO 1:3" /><verse number="4" style="v" sid="AMO 1:4" />येकोलायी मय हजाएल को किल्ला म आगी लगाऊं , अऊर ओकोसी बेन्हदद को किल्ला भी जर क भस्म होय जायेंन। <verse eid="AMO 1:4" /><verse number="5" style="v" sid="AMO 1:5" />मय दमिश्क को द्वारों ख तोड़ डालूं , अऊर आवेन नाम की तरायी को रहनवालों ख अऊर बेतएदेन को घर म रहनवालो राजदण्डधारी ख नाश करूं; अऊर अराम को लोग गुलाम होय क कीर ख जायेंन, यहोवा को योच वचन आय।<verse eid="AMO 1:5" /></para>
  <para style="s">पलिश्तिया</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />यहोवा यो कह्य हय : “गाजा को बार बार करयो हुयो अपराधों को वजह मय ओकी सजा नहीं छोड़ूं; कहालीकि हि सब लोगों ख बन्दी बनाय क ले गयो कि उन्ख एदोम राज्य को वश म कर दे। <verse eid="AMO 1:6" /><verse number="7" style="v" sid="AMO 1:7" />येकोलायी मय गाजा नगर की दीवाल म आगी लगाऊं अऊर ओको सी ओको किल्ला जर क भस्म होय जायेंन। <verse eid="AMO 1:7" /><verse number="8" style="v" sid="AMO 1:8" />मय अशदोद नगर को रहनवालों ख अऊर अश्कलोन नगर को राजा ख भी नाश करूं; मय अपनो हाथ एक्रोन को खिलाफ चलाऊं, अऊर बच्यो पलिश्ती लोग नाश होयेंन, परमेश्वर यहोवा को योच वचन आय।”<verse eid="AMO 1:8" /></para>
  <para style="s">सोर</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />यहोवा यो कह्य हय सोर को बार बार करयो हुयो अपराधों को वजह मय ओकी सजा नहीं छोड़ूं; कहालीकि ओन सब लोगों ख गुलाम बनाय क एदोम को वश म कर दियो अऊर भाऊ को संग को करी हुयी वाचा ख याद नहीं करयो। <verse eid="AMO 1:9" /><verse number="10" style="v" sid="AMO 1:10" />येकोलायी मय सोर को नगर को किल्ला ख आगी लगाऊं, अऊर ओकोसी ओको किल्ला भी भस्म हो जायेंन।<verse eid="AMO 1:10" /></para>
  <para style="s">एदोम</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />“यहोवा यो कह्य हय एदोम को बार बार करयो हुयो अपराधों को वजह मय ओकी सजा नहीं छोड़ूं ; कहालीकि ओन अपनो भाऊ ख तलवार पकड्यो हुयो भगायो अऊर कुछ भी दया नहीं करी, पर गुस्सा सी उन्ख लगातार फाड़तच रह्यो, अऊर अपनो गुस्सा ख हमेशा लायी बनाये रह्यो। <verse eid="AMO 1:11" /><verse number="12" style="v" sid="AMO 1:12" />येकोलायी मय तेमान शहर म आगी लगाऊं, अऊर ओको सी बोस्रा को किल्ला भस्म हो जायेंन।”<verse eid="AMO 1:12" /></para>
  <para style="s">अम्मोन</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />यहोवा यो कह्य हय : “अम्मोन को बार बार करयो हुयो अपराधों को वजह मय ओकी सजा नहीं छोडूं कहालीकि ओन अपनी सीमा ख बढ़ावन लायी गिलाद की गर्भवती बाइयों को पेट चीर डाल्यो। <verse eid="AMO 1:13" /><verse number="14" style="v" sid="AMO 1:14" />येकोलायी मय रब्बा नगर को किल्ला म आगी लगाऊं, अऊर ओको सी ओको भवन भी भस्म होय जायेंन। ऊ युद्ध को दिन म ललकार होयेंन, ऊ आन्धी बल्की माट्या को दिन होयेंन; <verse eid="AMO 1:14" /><verse number="15" style="v" sid="AMO 1:15" />अऊर उन्को राजा अपनो अधिकारी समेत गुलामी म जायेंन,” यहोवा को योच वचन आय।<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s">मोआब</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />यहोवा यो कह्य हय : “मोआब को बार बार करयो हुयो अपराधों को वजह, मय ओकी सजा नहीं छोड़ूं; कहालीकि ओन एदोम को राजा की हड्डियों ख जलाय क राख बनाय दियो। <verse eid="AMO 2:1" /><verse number="2" style="v" sid="AMO 2:2" />येकोलायी मय मोआब प्रदेश म आगी लगाऊं, अऊर ओको सी करिय्योत नगर को किल्ला जर क भस्म होय जायेंन; अऊर मोआब हल्ला अऊर ललकार, अऊर नरसिंगा को आवाज होतो-होतो मर जायेंन। <verse eid="AMO 2:2" /><verse number="3" style="v" sid="AMO 2:3" />मय ओको बीच म सी शासक को नाश करूं, अऊर संगच संग ओको सब अधिकारी ख भी मार डालूं,” यहोवा को योच वचन आय।<verse eid="AMO 2:3" /></para>
  <para style="s">यहूदा</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />यहोवा यो कह्य हय : “यहूदा प्रदेश को बार बार करयो हुयो अपराधों को वजह, मय ओकी सजा नहीं छोड़ूं; कहालीकि ओन यहोवा की व्यवस्था ख तुच्छ जान्यो, अऊर मोरो नियम ख नहीं मान्यो; अऊर अपनो झूठो देवतावों को वजह जेको पीछू उन्को पूर्वज चलत होतो, हि भी भटक गयो हंय। <verse eid="AMO 2:4" /><verse number="5" style="v" sid="AMO 2:5" />येकोलायी मय यहूदा म आगी लगाऊं , अऊर ओको सी यरूशलेम नगर को किल्ला जर क भस्म होय जायेंन।”<verse eid="AMO 2:5" /></para>
  <para style="s">इस्राएल को न्याय</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />यहोवा यो कह्य हय : “इस्राएल को तीन का, बल्की चार अपराधों को वजह, मय ओकी सजा नहीं छोड़ूं; कहालीकि ओन निर्दोष ख पैसा लायी अऊर गरीब ख एक जोड़ी जूतियों को दामों म बेच डाल्यो हंय। <verse eid="AMO 2:6" /><verse number="7" style="v" sid="AMO 2:7" />हि कमजोर अऊर कंगालों को मुंड जमीन की धूल को समान कुचल देवय हय, अऊर नम्र लोगों ख रस्ता सी हटाय देवय हंय; अऊर बाप-बेटा दोयी एकच कुमारी को जवर जावय हंय, जेकोसी मोरो पवित्र नाम ख अपवित्र ठहराये। <verse eid="AMO 2:7" /><verse number="8" style="v" sid="AMO 2:8" />हि हर एक वेदी को जवर गिरवी रख्यो कपड़ा पर सोवय हंय, अऊर जुर्माना को पैसा सी लियो हुयो अंगूरीरस अपनो देवता को मन्दिर म पी लेवय हय। <verse eid="AMO 2:8" /><verse number="9" style="v" sid="AMO 2:9" /><note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="DEU 3:8-11">व्यवस्थाविवरन ३:८-११</ref></char></note>मय न उन्को आगु सी एमोरियों ख नाश करयो होतो, जेकी लम्बाई देवदार को झाड़ को जसी, अऊर जिन्की ताकत बांज झाड़ों को जसो होतो; तब भी मय न ऊपर सी ओको फर, अऊर खल्लो सी ओकी जड़ी नाश करी। <verse eid="AMO 2:9" /><verse number="10" style="v" sid="AMO 2:10" />मय तुम्ख मिस्र देश सी निकाल लायो, अऊर निर्जन जागा म चालीस साल तक ले क फिरतो रह्यो, कि तुम एमोरियों को देश को अधिकारी होय जावो। <verse eid="AMO 2:10" /><verse number="11" style="v" sid="AMO 2:11" /><note caller="+" style="x"><char style="xo" closed="false">2:11 </char><char style="xt" closed="false"><ref loc="NUM 6:1-8">गिनती ६:१-८</ref></char></note>मय न तुम्हरो टुरावों म सी भविष्यवक्ता होन लायी अऊर तुम्हरो कुछ जवानों म सी नाज़ीर होन लायी ठहरायो। हे इस्राएलियों, का यो सब सच नहाय?” यहोवा की या वानी आय। <verse eid="AMO 2:11" /><verse number="12" style="v" sid="AMO 2:12" />पर तुम न नाज़ीरों<note caller="+" style="f"><char style="fr" closed="false">2:12 </char><char style="ft" closed="false">प्रथा को अनुसार परमेश्वर ख समर्पित करयो हुयो</char></note> ख अंगूरीरस पिलायो, अऊर भविष्यवक्तावों ख आज्ञा दी कि भविष्यवानी मत करो। <verse eid="AMO 2:12" /><verse number="13" style="v" sid="AMO 2:13" />देखो, मय तुम्ख असो दबाऊं, जसो अनाज गठ्ठावों सी भरी हुयी गाड़ी खल्लो दबायी जावय हय। <verse eid="AMO 2:13" /><verse number="14" style="v" sid="AMO 2:14" />येकोलायी तेज दौड़नवालो ख भग जान की जागा नहीं मिलेंन, अऊर सामर्थी को सामर्थ कुछ काम नहीं देयेंन; अऊर नहीं पराक्रमी अपनो जीव बचाय सकेंन; <verse eid="AMO 2:14" /><verse number="15" style="v" sid="AMO 2:15" />धनुर्धारी टिक नहीं सकेंन, अऊर फुर्ती सी दौड़नवालो नहीं बचेंन; सवार भी अपनो जीव नहीं बचाय सकेंन; <verse eid="AMO 2:15" /><verse number="16" style="v" sid="AMO 2:16" />अऊर शूरवीरों म जो जादा धीर होना, ऊ भी ऊ दिन नंगो भग जायेंन, यहोवा यो कह्य हय।<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />हे इस्राएलियों, यो वचन सुनो जो यहोवा न तुम्हरो बारे म मतलब ऊ पूरो कुल को बारे म कह्यो हय जेख मय न मिस्र देश सी लायो हय: <verse eid="AMO 3:1" /><verse number="2" style="v" sid="AMO 3:2" />“धरती को पूरो कुलों म सी मय न केवल तुम पर मन लगायो हय, यो वजह मय तुम्हरो पूरो अपराधों की सजा देऊं।<verse eid="AMO 3:2" /></para>
  <para style="s">भविष्यद्वक्ता को काम</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3" />“यदि दोय आदमी पहले सी सहमत नहीं होयेंन; त का हि एक संग चल सकेंन? <verse eid="AMO 3:3" /><verse number="4" style="v" sid="AMO 3:4" />का सिंह बिना शिकार पाये जंगल म गरजेंन? का जवान सिंह बिना कुछ पकड़े अपनो गुफा म सी गुर्रायेंन? <verse eid="AMO 3:4" /><verse number="5" style="v" sid="AMO 3:5" />का चिड़िया बिना फन्दा लगायो फसेंन? का बिना कुछ फंसे फन्दा जमीन पर सी उचकेंन? <verse eid="AMO 3:5" /><verse number="6" style="v" sid="AMO 3:6" />का कोयी नगर म नरसिंगा फूंकन पर लोग नहीं थरथरायेंन? का यहोवा को बिना भेज्यो कोयी नगर म कोयी विपत्ति पड़ेंन? <verse eid="AMO 3:6" /><verse number="7" style="v" sid="AMO 3:7" />योच तरह सी प्रभु यहोवा अपनो दास भविष्यक्ताओं पर अपनो भेद बिना प्रगट करयो कुछ भी नहीं करेंन। <verse eid="AMO 3:7" /><verse number="8" style="v" sid="AMO 3:8" />सिंह गरज्यो; कौन नहीं डरेंन? परमेश्वर यहोवा बोल्यो; कौन हय जो भविष्यवानी हय जो नहीं करेंन?”<verse eid="AMO 3:8" /></para>
  <para style="s">सामरिया को विनाश</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9" />अशदोद को किल्ला अऊर मिस्र देश को राजकिल्ला पर प्रचार कर क् कहो: “सामरिया को पहाड़ियों पर जमा होय क देखो कि ओको म का बड़ो हल्ला अऊर ओको बीच का अत्याचार को काम होय रह्यो हय!”<verse eid="AMO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 3:10" />यहोवा यो कह्य हय, “जो लोग अपनो किल्लावों म उपद्रव अऊर लुट को धन जमा रखय हय, हि सीधो काम करनो जानयच नहाय।” <verse eid="AMO 3:10" /><verse number="11" style="v" sid="AMO 3:11" />यो वजह परमेश्वर यहोवा यो कह्य हय: “देश ख घेरन वालो एक दुश्मन होयेंन, अऊर ऊ तोरी ताकत तोड़ेंन, अऊर तोरो किल्ला लूट्यो जायेंन।”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />यहोवा यो कह्य हय : “जो तरह चरवाहा सिंह को मुंह सी दोय टांग यां कान को एक टुकड़ा छुड़ावय हय, वसोच इस्राएली लोग, जो सामरिया म बिस्तर को एक कोना यां रेशमी गद्दी पर बैठ्यो करय हय, हि भी छुड़ायो जायेंन।” <verse eid="AMO 3:12" /><verse number="13" style="v" sid="AMO 3:13" />सेनावों को परमेश्वर, प्रभु यहोवा की या वानी आय, “देखो, अऊर याकूब को घराना को खिलाफ गवाही देवो: <verse eid="AMO 3:13" /><verse number="14" style="v" sid="AMO 3:14" /><note caller="+" style="x"><char style="xo" closed="false">३:१४ </char><char style="xt" closed="false"><ref loc="2KI 23:15">२ राजा २३:१५</ref></char></note>जो समय मय इस्राएल ख ओको अपराधों की सजा देऊं, उच समय मय बेतेल की वेदियों ख भी सजा देऊं, अऊर वेदी को सींग टूट क जमीन पर गिर जायेंन। <verse eid="AMO 3:14" /><verse number="15" style="v" sid="AMO 3:15" />मय जाड़ो को घर ख अऊर धूपकाल को घर, दोयी ख गिराऊं; अऊर हत्तीदांत को बन्यो घर भी नाश होयेंन, अऊर बड़ो बड़ो घर नाश होय जायेंन, यहोवा न यो कह्यो हय।<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="s">इस्राएल सुधरन म असफल</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1" />“ओ बाशान राज्य की धनवान गायों, ओ सामरिया पहाड़ी गायों, यो वचन सुनो, जो गरीबों पर अत्याचार करय, अऊर दरिद्रों ख कुचल डालय हय, अऊर अपनो अपनो पति सी कह्य हय, ‘लाव, दे हम पीबो!’ <verse eid="AMO 4:1" /><verse number="2" style="v" sid="AMO 4:2" />परमेश्वर यहोवा अपनो पवित्रता की कसम खाय क कह्य हंय, देखो, तुम पर असो दिन आवनवालो हंय, कि तुम काटावों सी, अऊर तुम्हरी सन्तान मच्छी पकड़न की गरी सी खींच लियो जायेंन। <verse eid="AMO 4:2" /><verse number="3" style="v" sid="AMO 4:3" />तुम म सी हर एक शहरपनाह की दीवाल की फट सी होय क सीधी निकल जावों अऊर हर्म्मोन पहाड़ी म डाली जावो, यहोवा की याच वानी आय।<verse eid="AMO 4:3" /></para>
  <para style="s">इस्राएल सुधरन म असफल</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4" />“बेतेल नगर म आय क अपराध करो, अऊर गिलगाल नगर म आय क बहुत सो अपराध करो; अपनो चढ़ावा पहेट ख, अऊर अपनो दशमांश हर तीसरो दिन ले आयो करो; <verse eid="AMO 4:4" /><verse number="5" style="v" sid="AMO 4:5" />धन्यवाद की भेंट खमीर मिलाय क चढ़ावो, अऊर अपनी इच्छाबलियों की चर्चा चलाय क उन्को प्रचार करो; कहालीकि हे इस्राएलियों, असो करनो तुम्ख भावय हय,” परमेश्वर यहोवा की याच वानी आय। <verse eid="AMO 4:5" /><verse number="6" style="v" sid="AMO 4:6" />“मय न त तुम्हरो सब नगरों म अकाल भेज्यो, अऊर तुम्हरो सब जागा म रोटी की कमी करी हय, तब भी तुम मोरो तरफ फिर क नहीं आयो,” यहोवा की याच वानी आय। <verse eid="AMO 4:6" /><verse number="7" style="v" sid="AMO 4:7" />“जब कटनी को तीन महीना रह्य गयो, तब मय न तुम्हरो लायी बरसात नहीं करी; मय न एक नगर म पानी बरसायो दूसरो म नहीं बरसायो; एक खेत म पानी बरस्यो, अऊर दूसरो खेत जेको म नहीं बरस्यो, ऊ सूख गयो। <verse eid="AMO 4:7" /><verse number="8" style="v" sid="AMO 4:8" />येकोलायी दोय तीन नगरों को लोग पानी पीवन ख मारे मारे फिरयो, पर तृप्त नहीं भयो; तब भी तुम मोरो तरफ नहीं फिरयो, यहोवा की याच वानी आय।<verse eid="AMO 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9" />“मय न तुम्ख गर्मी अऊर गेरुए किड़ा सी मारयो हय; अऊर जब तुम्हरो बगीचा अऊर अंगूर की बाड़ियों, अऊर अंजीर अऊर जैतून को झाड़ बहुत भय गयो, तब फाफा उन्ख खाय गयी; तब भी तुम मोरो तरफ फिर क नहीं आयो, यहोवा की याच वानी आय<verse eid="AMO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10" />“मय न तुम्हरो बीच म मिस्र देश को जसी महामारी फैलायी; मय न तुम्हरो घोड़ा ख छिन क तुम्हरो जवानों ख तलवार सी मरवाय दियो; अऊर तुम्हरी छावनी की दुर्गन्ध तुम्हरो जवर पहुंचायो; तब भी तुम मोरो तरफ फिर क नहीं आयो, यहोवा की याच वानी आय।<verse eid="AMO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 4:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:११ </char>
      <char style="xt" closed="false">
        <ref loc="GEN 19:24">उत्पत्ति १९:२४</ref>
      </char>
    </note>“मय न तुम म सी कुछ एक ख असो उलट दियो, जसो परमेश्वर न सदोम अऊर अमोरा ख नाश कर दियो होतो, अऊर तुम आगी सी निकाली हुयी लकड़ी को जसो ठहरयो; तब भी तुम मोरो तरफ फिर क नहीं आयो, यहोवा की याच वानी आय।<verse eid="AMO 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 4:12" />“यो वजह, हे इस्राएल, मय तोरो सी असोच करूं, अऊर येकोलायी कि मय तोरो म यो काम करन पर हय, हे इस्राएल, अपनो परमेश्वर को सामने आवन लायी तैयार होय जा!” <verse eid="AMO 4:12" /><verse number="13" style="v" sid="AMO 4:13" />देख, पहाड़ियों ख बनावन वालो अऊर हवा ख सिरजन वालो, अऊर मनुष्य ख ओको मन को बिचार बतावन वालो अऊर पहेट ख अन्धकार करन वालो, अऊर जो धरती को ऊंचो जागावों पर चलन वालो हय, ओकोच नाम सेनावों को परमेश्वर यहोवा आय!<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">पश्चाताप करन को आह्वाहन</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />हे इस्राएल को घराना, यो विलाप को गीत को वचन सुनो जो मय तुम्हरो बारे म कहू हय: <verse eid="AMO 5:1" /><verse number="2" style="v" sid="AMO 5:2" />“इस्राएल कुमारी कन्या हय जो गिर गयी, अऊर फिर उठ नहीं सकेंन; वा अपनीच जमीन पर पटक दी गयी हय, अऊर ओको उठान वालो कोयी नहाय।”<verse eid="AMO 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 5:3" />कहालीकि परमेश्वर यहोवा यो कह्य हय: “जो नगर सी हजार सैनिक निकल्यो होतो, ओको म इस्राएल को घराना को सौ सैनिक बच्यो रहेंन, अऊर जेकोसी सौ निकलत होतो, ओको म दसच बच्यो रहेंन।”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />यहोवा, इस्राएल को घराना सी यो कह्य हय: मोरी खोज करो, तब जिन्दो रहो। <verse eid="AMO 5:4" /><verse number="5" style="v" sid="AMO 5:5" />बेतेल की खोज म मत लगो, नहीं गिलगाल म सिरो, अऊर नहीं बेर्शेबा ख जावो; कहालीकि गिलगाल निश्चय गुलामी म जायेंन, अऊर बेतेल सूनो पड़ेंन।<verse eid="AMO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 5:6" />यहोवा की खोज करो, तब जिन्दो रहो, नहीं त ऊ यूसुफ को घराना पर आगी को जसो भड़केंन, अऊर वा ओख भस्म करेंन, अऊर बेतेल म कोयी ओको बुझावन वालो नहीं होयेंन। <verse eid="AMO 5:6" /><verse number="7" style="v" sid="AMO 5:7" />हे न्याय ख कड़वाहट म बदलन वालो अऊर न्यायीपन ख माटी म मिलावन वालो लोग आय! <verse eid="AMO 5:7" /><verse number="8" style="v" sid="AMO 5:8" />जो कृतिका अऊर मृगशिरा नक्षत्रों ख बनावन वालो आय, ऊ घनो अन्धकार ख पहेट को उजाड़ो बनावय हय,जो दिन ख अन्धारो कर क् रात बनाय देवय हय, अऊर समुन्दर को पानी जमीन को ऊपर बहाय देवय हय, ओको नाम यहोवा आय। <verse eid="AMO 5:8" /><verse number="9" style="v" sid="AMO 5:9" />ऊ तुरतच बलवान को विनाश कर देवय, अऊर किल्ला को भी सत्यानाश करय हय।<verse eid="AMO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 5:10" />ऊ न्याय-सभा म सच्चायी सी न्याय करय हय ओको सी हि नफरत रखय हंय, अऊर खरी बात बोलन वालो सी घृना करय हय। <verse eid="AMO 5:10" /><verse number="11" style="v" sid="AMO 5:11" />तुम जो गरीबों ख लताड़य हय, अऊर भेंट कह्य क उन्को सी अनाज पर कर लादय हय, येकोलायी जो घर तुम न गोटावों को बनायो हंय, उन म रहनो नहीं पावों; अऊर जो मनभावनी अंगूर की बाड़ियां तुम न लगायी हंय, उन्को अंगूरीरस पी नहीं पावों। <verse eid="AMO 5:11" /><verse number="12" style="v" sid="AMO 5:12" />कहालीकि मय जानु हय कि तुम्हरो अपराध भारी हय। तुम न्यायी ख सतावय अऊर घूस लेवय, अऊर न्याय-सभा म दरिद्रों को न्याय बिगाड़य हय। <verse eid="AMO 5:12" /><verse number="13" style="v" sid="AMO 5:13" />यो वजह जो बुद्धिमान होना, ऊ असो समय चुप रहे, कहालीकि समय बुरो हय। <verse eid="AMO 5:13" /><verse number="14" style="v" sid="AMO 5:14" />हे लोगों, बुरायी ख नहीं, भलायी ख ढूंढो, ताकि तुम जिन्दो रहो; सेनावों को प्रभु यहोवा सच म तुम्हरो संग हय, जसो तुम कह्य हय। <verse eid="AMO 5:14" /><verse number="15" style="v" sid="AMO 5:15" />बुरायी सी नफरत अऊर भलायी सी प्रेम रखो, अऊर न्याय-सभा म न्याय ख स्थिर करो; का जाने सेनावों को परमेश्वर यहोवा यूसुफ को बच्यो हुयो पर अनुग्रह करे।<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />यो वजह सेनावों को परमेश्वर, प्रभु यहोवा यो कह्य हय: “सब चौक म रोनो होयेंन; अऊर सब सड़कों म लोग हाय, हाय, करेंन! हि किसानों ख शोक करन लायी, अऊर जो लोग विलाप करन म परिपूर्न हय, उन्ख रोवन लायी बुलायेंन; <verse eid="AMO 5:16" /><verse number="17" style="v" sid="AMO 5:17" />अऊर सब अंगूर की बाड़ियों म रोनो होयेंन, कहालीकि यहोवा यो कह्य हय, मय तुम्हरो बीच म सी होय क जाऊं। <verse eid="AMO 5:17" /><verse number="18" style="v" sid="AMO 5:18" />हाय तुम पर, जो यहोवा को दिन की इच्छा करय हय! यहोवा को दिन सी तुम्हरो का फायदा होयेंन? ऊ त उजाड़ो को नहीं, अन्धारो को दिन होयेंन। <verse eid="AMO 5:18" /><verse number="19" style="v" sid="AMO 5:19" />जसो कोयी सिंह सी भगे अऊर ओख आसवल मिले; यां घर म आय क भीती पर हाथ टेके अऊर सांप ओख डसे। <verse eid="AMO 5:19" /><verse number="20" style="v" sid="AMO 5:20" />का यो सच नोहोय कि यहोवा को दिन उजाड़ो को नहीं, बल्की अन्धियारोच को होयेंन? हव, असो घनो अन्धारो को जेको म कुछ भी चमक नहीं होना।<verse eid="AMO 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21" />“मय तुम्हरो त्यौहारों सी नफरत रखू, अऊर उन्ख मय ठुकराऊ हय, अऊर तुम्हरी महासभावों सी मय खुश नहाय। <verse eid="AMO 5:21" /><verse number="22" style="v" sid="AMO 5:22" /><note caller="+" style="x"><char style="xo" closed="false">५:२२ </char><char style="xt" closed="false"><ref loc="ISA 1:11-14">यशायाह १:११-१४</ref></char></note>चाहे तुम मोरो लायी होमबलि अऊर अन्नबलि चढ़ावो, तब भी मय खुश नहीं होऊ, अऊर तुम्हरो पल्यो हुयो जनावरों को मेलबलियों को तरफ नजर नहीं डालूं। <verse eid="AMO 5:22" /><verse number="23" style="v" sid="AMO 5:23" />अपनो गीतों को आवाज मोरो सी दूर करो; तुम्हरी सारंगियों को सुर मय नहीं सुनूं। <verse eid="AMO 5:23" /><verse number="24" style="v" sid="AMO 5:24" />पर न्याय ख नदी को जसो, अऊर सच्चायी ख नदी की धारा को जसो बहन देवो।<verse eid="AMO 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />“हे इस्राएल को घराना, तुम सुनसान जागा म चालीस साल तक पशुबलि अऊर अन्नबलि का मोखच चढ़ातो रह्यो? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />तुम त अपनो राजा सक्कुत को तम्बू, अऊर अपनो मूर्तियों को चौरंग, अऊर अपनो केवान देवता को तारा लियो फिरत रह्यो। <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />यो वजह मय तुम्ख दमिश्क नगर को ओन पार गुलामी म कर देऊं, सेनावों को परमेश्वर यहोवा को योच वचन आय।<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">इस्राएल को विनाश</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1" />“हाय उन पर जो सिय्योन म सुख सी रह्य, अऊर उन पर जो सामरिया की पहाड़ी पर निश्चिन्त रह्य हय, हि जो श्रेष्ठ राज्य म प्रसिद्ध हंय, जेको जवर इस्राएल को घराना आवय हय! <verse eid="AMO 6:1" /><verse number="2" style="v" sid="AMO 6:2" />कलने नगर ख जाय क देखो, अऊर उत सी हमात नाम को बड़ो नगर ख जावो; फिर पलिश्तियों को गत नगर ख जावो. का हि इन राज्यों सी अच्छो हंय? का उन्की सीमा तुम्हरी सीमा सी कुछ बड़ी हय? <verse eid="AMO 6:2" /><verse number="3" style="v" sid="AMO 6:3" />तुम बुरो दिन ख दूर कर देवय, अऊर उपद्रव की गद्दी को जवर लावय हय।<verse eid="AMO 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 6:4" />“तुम हत्ती दांत को खटिया पर सोवय, अऊर अपनो अपनो बिस्तर पर पाय फैलाये सोवय हय, अऊर मेंढियों अऊर मोटो ताजो बछड़ा ख खावय हय। <verse eid="AMO 6:4" /><verse number="5" style="v" sid="AMO 6:5" />तय सारंगी को संग गीत गावय, अऊर दाऊद को जसो नयो नयो बाजा को आवाज निकालय हय; <verse eid="AMO 6:5" /><verse number="6" style="v" sid="AMO 6:6" />अऊर कटोरा म सी अंगूरीरस पीवय, अऊर अच्छो अच्छो तेल लगावय हय, पर यूसुफ पर आवन वाली विपत्ति को हाल सुन क शोकित नहीं होवय! <verse eid="AMO 6:6" /><verse number="7" style="v" sid="AMO 6:7" />यो वजह हि अब गुलामी म पहले जायेंन, येकोलायी हि अपनो देश सी निकाल्यो जायेंन, अऊर जो पाय फैलाये सोवत होतो, उन्की विलासिता खतम होय जायेंन।” <verse eid="AMO 6:7" /><verse number="8" style="v" sid="AMO 6:8" />परमेश्वर यहोवा न अपनीच कसम खाय क कह्यो हय: “जेको पर याकूब घमण्ड करय हय, ओको सी मय घृना, अऊर ओको राजगढ़ों सी दुश्मनी रखू हय; अऊर मय यो नगर ख ऊ सब समेत जो ओको म हय, दुश्मन को वश म कर देऊं।”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />यदि कोयी घर म दस आदमी बच्यो रहेंन, तब भी हि मर जायेंन। <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />जब कोयी को काका, जो ओको जलावन वालो हय, ओकी हड्डियों ख घर सी निकालन लायी उठायेंन, अऊर जो घर को कोना म लूक्यो होना ओको सी पूछेंन, का तोरो जवर कोयी अऊर हय? तब ऊ कहेंन, “कोयी नहीं;” तब ऊ कहेंन, “चुप रह! हम्ख यहोवा को नाम नहीं लेनो चाहिये।”<verse eid="AMO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 6:11" />कहालीकि यहोवा की आज्ञा सी बड़ो घर को तुकड़ा तुकड़ा होयेंन, अऊर छोटो घर म फट होयेंन। <verse eid="AMO 6:11" /><verse number="12" style="v" sid="AMO 6:12" />का घोड़ा चट्टान पर दौड़े? का कोयी असो जागा म बईलों सी नांगर जोते जहां तुम लोगों न न्याय ख जहेर म, अऊर न्यायीपन को फल ख कड़वो फल म बदल डाल्यो हंय? <verse eid="AMO 6:12" /><verse number="13" style="v" sid="AMO 6:13" />तुम असो चिज को वजह खुशी मनावय हय जो बेकार हय; अऊर कह्य हय, “हम अपनो बल सी करनईम नगर जीत्यो हय?” <verse eid="AMO 6:13" /><verse number="14" style="v" sid="AMO 6:14" />यो वजह सेनावों को परमेश्वर यहोवा को वचन आय, “हे इस्राएल को घराना, देख, मय तुम्हरो खिलाफ एक असी राज्य खड़ो करूं, जो हमात की घाटी सी ले क अराबा की नदी तक तुम्ख तंग करेंन।”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">विनाश को तीन दर्शन</para>
  <para style="s">फाफा</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />परमेश्वर यहोवा न मोख यो दिखायो अऊर मय का देखू हय कि ओन पिछलो घास को उगन को सुरूवात म फाफा पैदा करयो; अऊर ऊ राजा की फसल कटनी को बाद की घास होती। <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />जब हि जमीन को पूरो घास खाय चुक्यो, तब मय न कह्यो, “हे परमेश्वर यहोवा, माफ कर! नहीं त याकूब कसो स्थिर रह सकेंन? ऊ कितनो कमजोर हय!” <verse eid="AMO 7:2" /><verse number="3" style="v" sid="AMO 7:3" />येको बारे म यहोवा न अपनो मन बदल्यो, अऊर ओन कह्यो, “असी बात अब नहीं होयेंन।”<verse eid="AMO 7:3" /></para>
  <para style="s">आगी को दर्शन</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />परमेश्वर यहोवा न मोख यो दिखायो अऊर का देखू हय कि परमेश्वर यहोवा न आगी को द्वारा न्याय करन लायी पुकारयो, अऊर वा आगी सी महासागर सूख गयो, अऊर जमीन भी भस्म होन लगी होती। <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />तब मय न कह्यो, हे परमेश्वर यहोवा, सजा देनो रोक दे! नहीं त याकूब कसो स्थिर रह सकेंन? ऊ कसो कमजोर हय। <verse eid="AMO 7:5" /><verse number="6" style="v" sid="AMO 7:6" />येको बारे म भी यहोवा न अपनो मन बदल्यो; अऊर परमेश्वर यहोवा न कह्यो, “असी बात फिर नहीं होयेंन।”<verse eid="AMO 7:6" /></para>
  <para style="s">गोला</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />ओन मोख यो भी दिखायो मय न देख्यो कि प्रभु गोला लगाय क बनायी हुयी कोयी दीवाल पर खड़ो हय, अऊर ओको हाथ म गोला आय। <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />यहोवा न मोरो सी कह्यो, “हे आमोस, तोख का दिख पड़य हय?” मय न कह्यो, “एक गोला।” तब परमेश्वर न कह्यो, “देख, मय अपनी प्रजा इस्राएल को बीच म गोला लगाऊं, अब मय उन्ख नहीं छोड़ूं। <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" />इसहाक को ऊंची जागा उजाड़ देऊं, अऊर इस्राएल को पवित्र जागा खण्डर होय जायेंन, अऊर मय यारोबाम को घराना पर तलवार लियो हुयो चढ़ायी करूं।”<verse eid="AMO 7:9" /></para>
  <para style="s">आमोस अऊर अमस्याह</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />तब बेतेल को याजक अमस्याह न इस्राएल को राजा यारोबाम को जवर बुलावा भेज्यो, “आमोस न इस्राएल को घराना को बीच म तोरो सी षड़यन्त्र की योजना बनायी हय; ओको पूरो वचनों ख देश नहीं सह सकय। <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />कहालीकि आमोस यो कह्य हय, ‘यारोबाम तलवार सी मारयो जायेंन, अऊर इस्राएल को लोगों ख गुलामी बनाय क अपनो देश सी निकाल्यो जायेंन।’” <verse eid="AMO 7:11" /><verse number="12" style="v" sid="AMO 7:12" />तब अमस्याह न आमोस सी कह्यो, हे दर्शन देखन वालो, यहां सी निकल क यहूदा देश म भग जा, अऊर वहांच रोटी खायो कर, अऊर वहांच भविष्यवानी कर; <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />पर बेतेल म फिर कभी भविष्यवानी मत कर, कहालीकि यो राजा को पवित्र जागा अऊर राज-गढ़ आय। <verse eid="AMO 7:13" /><verse number="14" style="v" sid="AMO 7:14" />आमोस न उत्तर दे क अमस्याह सी कह्यो, मय नहीं त भविष्यवक्ता होतो, अऊर नहीं भविष्यवक्ता को टुरा; मय त जनावर चरावन वालो, अऊर उम्बर को झाड़ों को छांटन वालो होतो, <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />अऊर यहोवा न मोख मेंढी-शेरीयों को पीछू पीछु फिरन सी बुलाय क कह्यो, जा, मोरी प्रजा इस्राएल सी भविष्यवानी कर। <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />येकोलायी अब तय यहोवा को वचन सुन, तय कह्य हय, इस्राएल को खिलाफ भविष्यवानी मत कर; अऊर इसहाक को घराना को खिलाफ बार बार वचन मत सुनाव। <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />यो वजह यहोवा यो कह्य हय: “तोरी पत्नि नगर म वेश्या होय जायेंन, अऊर तोरो बेटा-बेटियां तलवार सी मारी जायेंन। अऊर तोरी जमीन दोरी सी माप क बांट लियो जायेंन, अऊर तय खुद अशुद्ध देश म मरजो। अऊर इस्राएल अपनो देश सी गुलाम बनाय क निकाल्यो जायेंन।”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">फरों सी भरी टोपली को दर्शन</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />परमेश्वर यहोवा न मोख यो दिखायो: कि धूपकाल को फरों सी भरी हुयी एक टोपली हय। <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />ओन कह्यो, “हे आमोस, तोख का दिखायी देवय हय?” मय न कह्यो, “धूपकाल को फरों सी भरी एक टोपली।” तब यहोवा न मोरो सी कह्यो, “मोरी प्रजा इस्राएल को अन्त आय गयो हय; मय अब ओख अऊर नहीं छोड़ूं।” <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />परमेश्वर यहोवा की वानी आय, “ऊ दिन मन्दिर को गीत हाहाकार म बदल जायेंन, अऊर लाशों को बड़ो ढेर लगेंन; अऊर सब जागावों म हि चुपचाप फेंक दियो जायेंन।”<verse eid="AMO 8:3" /></para>
  <para style="s">इस्राएल को पतन</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4" />यो सुनो, तुम जो पिड़ित ख रौंदनो अऊर देश को नम्र लोगों ख नाश करनो चाहवय हय, <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />जो कह्य हय, नयो चन्दा कब बीतेंन कि हम अनाज बेच सके? “आरामदिन कब बीतेंन, जेकोसी हम अपनो गेहूं बेचन ख लाय सकबो हम तराजू को बट ख असो बनाय देबो की लोगों ख ठगाय सके, <verse eid="AMO 8:5" /><verse number="6" style="v" sid="AMO 8:6" />कि हम गरीबों ख पैसा दे क, अऊर दरिद्रों ख एक जोड़ी जूतियां की किम्मत दे क खरीद लेवय हय, अऊर तुम घुन लग्यो हुयो गहूं बेचय हय?”<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />यहोवा, याकूब को घमण्ड, उच अपनी कसम खाय क कह्य हय, मय तुम्हरो कोयी काम ख कभी नहीं भूलूं। <verse eid="AMO 8:7" /><verse number="8" style="v" sid="AMO 8:8" />का यो वजह जमीन नहीं कापेंन? का उन पर को सब रहनवालो विलाप नहीं करेंन? यो देश सब को सब मिस्र की नील नदी को जसो होयेंन, जो उमड़य हय, अऊर घट जावय हय। <verse eid="AMO 8:8" /><verse number="9" style="v" sid="AMO 8:9" />परमेश्वर यहोवा की या वानी आय, “ऊ समय मय सूरज ख दुपहर को समय डूबाय देऊं, अऊर यो देश ख दिन दहाड़े अन्धकार कर देऊं। <verse eid="AMO 8:9" /><verse number="10" style="v" sid="AMO 8:10" />मय तुम्हरो त्यौहारों को उत्सव ख दूर कर क् विलाप कराऊं, अऊर तुम्हरो सब गीतों ख दूर कर क् विलाप को गीत गवाऊं; मय तुम सब की कमर म शोक को कपड़ा बान्धूं, अऊर तुम सब को मुन्ड ख मुंडाऊं, अऊर असो विलाप कराऊं जसो एकलौतो को लायी होवय हय, अऊर ओको अन्त कठिन दु:ख को दिन को जसो होयेंन।” <verse eid="AMO 8:10" /><verse number="11" style="v" sid="AMO 8:11" />परमेश्वर यहोवा यो कह्य हय, देखो, असो दिन आय रह्यो हंय, जब मय यो देश म अकाल भेजूं; ओको म नहीं त रोटी को भूखो नहीं अऊर पानी को प्यासो नहीं, पर यहोवा को वचनों को भूखो होयेंन। <verse eid="AMO 8:11" /><verse number="12" style="v" sid="AMO 8:12" />लोग यहोवा को वचन की खोज म समुन्दर सी दुसरो समुन्दर तक अऊर उत्तर सी पूर्व तक मारे मारे फिरेंन, पर ओख नहीं पायेंन।<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />“ऊ समय सुन्दर कुमारियां अऊर जवान आदमी दोयी प्यास को मारे मूर्झाय जायेंन। <verse eid="AMO 8:13" /><verse number="14" style="v" sid="AMO 8:14" />जो लोग सामरिया को देवता की कसम, अऊर ‘दान को देवता की कसम, अऊर बेर्शेबा को पन्थ की कसम खावय हय,’ हि सब गिर पड़ेंन, अऊर फिर नहीं उठेंन।”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">परमेश्वर को न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />मय न प्रभु ख वेदी को ऊपर खड़ो देख्यो, अऊर ओन कह्यो खम्भा को सिरा पर मार जेकोसी डेहरी हले, अऊर उन्ख सब लोगों को मुंड पर गिराय क तुकड़ा तुकड़ा कर; अऊर जो नाश होन सी बच्यो, उन्ख मय तलवार सी मार डालूं; उन म सी एक भी नहीं भग सकेंन, अऊर जो अपनो ख बचाये, ऊ बच नहीं पायेंन।<verse eid="AMO 9:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="AMO 9:2" />कहालीकि चाहे हि गड्डा खोद क अधोलोक म उतर जाये, त वहां सी मय हाथ बढ़ाय क उन्ख लाऊं; चाहे हि आसमान पर चढ़ जाये, त वहां सी मय उन्ख उतार लाऊं। <verse eid="AMO 9:2" /><verse number="3" style="v" sid="AMO 9:3" />चाहे हि कर्मेल पहाड़ी की सेंडी पर लूक जाये, पर वहां भी मय उन्ख ढूंढ-ढूंढ क पकड़ लेऊं, अऊर चाहे हि समुन्दर की गहरायी म मोरी नजर सी लूक जाये, वहां भी मय सांप ख उन्ख डसन की आज्ञा देऊं। <verse eid="AMO 9:3" /><verse number="4" style="v" sid="AMO 9:4" />चाहे दुश्मन उन्ख देश सी निकाल क अपनो देश म ले जाये, वहां भी मय आज्ञा दे क तलवार सी उन्ख मार डालूं; अऊर मय उन पर भलायी करन लायी नहीं, बुरायीच करन लायी नजर करूं। <verse eid="AMO 9:4" /><verse number="5" style="v" sid="AMO 9:5" />सेनावों को परमेश्वर यहोवा को छुवन सी धरती पिघलय हय, अऊर ओको पुरो रहनवालो विलाप करय हय; अऊर हि सब को सब मिस्र की नील नदी को जसो होय जावय हय, जो बढ़य हय, अऊर घट जावय हय। <verse eid="AMO 9:5" /><verse number="6" style="v" sid="AMO 9:6" />जो आसमान म अपनो घर बनावय, अऊर अपनो आकाशमण्डल की नीव धरती पर डालय, अऊर आज्ञा कर क् समुन्दर को पानी धरती पर बहाय देवय हय, ओकोच नाम यहोवा आय।<verse eid="AMO 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 9:7" />हे इस्राएलियों, यहोवा यो कह्य हय, “का तुम मोरो लायी कूशियों को जसो नहाय? का मय इस्राएल ख मिस्र देश सी अऊर पलिश्तियों ख कप्तोर क्षेत्र सी नहीं निकाल लायो? अऊर सीरिया वासियों ख कीर क्षेत्र सी नहीं लायो। <verse eid="AMO 9:7" /><verse number="8" style="v" sid="AMO 9:8" />देखो, प्रभु यहोवा की नजर यो पापमय राज्य पर लगी हय, अऊर मय येख धरती पर सी नाश करूं; तब भी मय पूरी रीति सी याकूब को घराना को नाश नहीं करूं,” यहोवा की याच वानी आय।<verse eid="AMO 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 9:9" />“मोरी आज्ञा सी इस्राएल को घराना सब राज्यों म असो चाल्यो जायेंन जसो अनाज चालनी म छान्यो जावय हय, पर ओको एक भी कंकड़ दाना जमीन पर नहीं गिरेंन। <verse eid="AMO 9:9" /><verse number="10" style="v" sid="AMO 9:10" />मोरी प्रजा म को सब पापी जो कह्य हंय, वा विपत्ति हम पर नहीं पड़ेंन, अऊर नहीं हम्ख घेरेंन, हि सब तलवार सी मारयो जायेंन।”<verse eid="AMO 9:10" /></para>
  <para style="s">इस्राएल को पुनर्निमाण</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />“ऊ समय मय दाऊद की गिरी हुयी झोपड़ी ख खड़ो करूं, अऊर ओकी दीवाल की फट ख सुधारूं, अऊर ओको खण्डरों ख फिर बनाऊं, अऊर जसो ऊ पुरानो समय म होतो, ओख वसोच बनाय देऊं; <verse eid="AMO 9:11" /><verse number="12" style="v" sid="AMO 9:12" />जेकोसी हि बच्यो हुयो एदोमियों ख बल्की सब राष्ट्रों ख जो मोरो कहलावय हंय, अपनो अधिकार म ले, यहोवा जो यो काम पूरो करय हय, ओकी याच वानी आय।” <verse eid="AMO 9:12" /><verse number="13" style="v" sid="AMO 9:13" />यहोवा यो कह्य हय, “देखो, असो दिन आवय हंय, कि नांगर जोतन वालो काटन वालो ख अऊर अंगूर रौंदन वालो बीज बोवन वालो सी आगु निकल जायेंन; अऊर पहाड़ियों सी नयो अंगूरीरस टपकन लगेंन, अऊर सब पहाड़ियों सी बह निकलेंन। <verse eid="AMO 9:13" /><verse number="14" style="v" sid="AMO 9:14" />मय अपनी प्रजा इस्राएल को बन्दियों ख लौटाय ले आऊं, अऊर हि उजड़्यो हुयो नगरों ख फिर सी बनाय क उन म बसेंन; हि अंगूर की बाड़ियां लगाय क अंगूरीरस पीयेंन, अऊर बगीचा लगाय क उन्को फर खायेंन। <verse eid="AMO 9:14" /><verse number="15" style="v" sid="AMO 9:15" />मय उन्ख, उन्कीच जमीन म बोऊं, अऊर हि अपनी जमीन म सी जो मय न उन्ख दी हय, फिर कभी उखाड़्यो नहीं जायेंन,” तुम्हरो परमेश्वर यहोवा को योच वचन आय।<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>