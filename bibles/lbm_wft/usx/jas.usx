<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Lodhi</book>
  <para style="h">याकूब</para>
  <para style="toc3">याकूब</para>
  <para style="toc2">याकूब</para>
  <para style="toc1">याकूब की चिट्ठी</para>
  <para style="mt2">याकूब की पत्री</para>
  <para style="mt1">याकूब की चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">याकूब की किताब याकूब नाम को कोयी लोग सी लिख्यो होतो। ऊ शायद यीशु को भाऊ याकूब होतो। जो उन आराधना मण्डली को मुखिया होतो अऊर यरूशलेम परिषद <char style="xt"><ref loc="ACT 15:13">प्रेरितों १५:१३</ref></char>, को हिस्सा होतो प्रेरित पौलुस न ओख <char style="xt"><ref loc="GAL 2:9">गलातियों २:९</ref></char> म आराधना मण्डली को खम्बा भी कह्यो विद्वानों को माननो हय कि याकूब की किताब मसीह को जनम को ५० साल बाद लिख्यो होतो, तब याकूब यरूशलेम म आराधना मण्डली को मुखिया होतो, येकोलायी ओन उत रहतो हुयो शायद किताब लिख्यो होतो।</para>
  <para style="ip">ओन अपनी किताब म राज्य को बीच बिखरी बारा जातियों ख सम्बोधित करयो <char style="xt"><ref loc="JAS 1:1">१:१</ref>।</char> याकूब को सबक सब मसीहियों पर लागु होवय हय पर बारा जाती शब्दों को उपयोग यो बतावय हय सम्भव हय की याकूब सीधो यहूदी मसीहियों ख लिख रह्यो हय बल्की या किताब पढ़न वालो को एक व्यापक झुण्ड तक केंद्रित करय हय। सच्चो विश्वास कार्यवाई म दिखायो हय। <char style="xt"><ref loc="JAS 2:17">२:१७</ref></char> ऊ धनवान लोगों ख <char style="xt"><ref loc="JAS 2:1-4">२:१-४</ref></char> पक्षपात दिखान को खिलाफ चेतावनी देवय हय अऊर हम्ख बतावय हय कि जो हम कहजे हय अऊर का कहजे हय ऊ बतावय हय। <char style="xt"><ref loc="JAS 3:1-12">३:१-१२</ref></char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. याकूब अपनो पढ़न वालो ख धन्यवाद देवय हय। <char style="ior"><ref loc="JAS 1:1">१:१</ref></char></para>
  <para style="io1">२. ऊ मसीहियों ख सहन करन लायी प्रोत्साहित करय हय जब हि दु:ख म रह्य हय। <char style="ior"><ref loc="JAS 1:2-27">१:२-२७</ref></char></para>
  <para style="io1">३. तब ऊ कह्य हय कि विश्वासियों को माध्यम सी विश्वास हय। <char style="ior"><ref loc="JAS 2:1-26">२:१-२६</ref></char></para>
  <para style="io1">४. शक्तिशाली शब्द कसो होय सकय हय। <char style="ior"><ref loc="JAS 3:1-12">३:१-१२</ref> </char></para>
  <para style="io1">५. याकूब बतावय हय परमेश्वर को ज्ञान जगत को ज्ञान अलग हय। <char style="ior"><ref loc="JAS 3:13-4:10">३:१३–४:१०</ref></char></para>
  <para style="io1">६. घमण्डी होन को खिलाफ चेतावनी। <char style="ior"><ref loc="JAS 4:11-5:6">४:११–५:६</ref></char></para>
  <para style="io1">७. सामान्य निर्देश दे क अपनी किताब लिखनो बन्द करय हय। <char style="ior"><ref loc="JAS 5:7-20">५:७-२०</ref></char></para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:55">मत्ती १३:५५</ref>; <ref loc="MRK 6:3">मरकुस ६:३</ref>; <ref loc="ACT 15:13">प्रेरितों १५:१३</ref>; <ref loc="GAL 1:19">गलातियों १:१९</ref></char>
    </note>परमेश्वर को अऊर प्रभु यीशु मसीह को सेवक याकूब को तरफ सी, उन बारा गोत्रों ख जो तितर-बितर हुयो हंय उन्ख नमस्कार।<verse eid="JAS 1:1" /></para>
  <para style="s">विश्वास अऊर बुद्धि</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />हे मोरो भाऊवों अऊर बहिनों, जब तुम नाना तरह की परीक्षावों म पड़ो, त येख अपनो आप म बहुत आनन्द कि बात समझो, <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />तुम जानय हय कि तुम्हरो विश्वास ख परख्यो जानो सी धीरज तैयार होवय हय। <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />पर धीरज ख अपनो पूरो काम करन देवो कि तुम पूरो अऊर सिद्ध होय जावो, अऊर तुम म कोयी बात की कमी नहीं रहे। <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />पर यदि तुम म सी कोयी ख बुद्धि की कमी हय त परमेश्वर सी मांगो, जो अनुग्रह अऊर उदारता सी देवय हय, अऊर ओख दियो जायेंन। <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />पर विश्वास सी मांगे, अऊर कुछ शक मत करो, कहालीकि शक करन वालो समुन्दर की लहर को जसो हय जो हवा सी बहय अऊर उछलय हय। <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />असो आदमी यो नहीं समझे कि मोख प्रभु सी कुछ मिलेंन, <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />ऊ आदमी शक्की हय अऊर अपनी बातों म अस्थिर हय।<verse eid="JAS 1:8" /></para>
  <para style="s">गरीबी अऊर अमीरी</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />गरीब विश्वासियों जब परमेश्वर तुम्ख ऊचो पद देवय हय तब खुशी मनाये, <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />अऊर धनवान आदमी घास को फूल को जसो हय जो नाश होय जावय हय। <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />कहालीकि सूरज निकलतो समय कड़ी धूप पड़य हय अऊर पौधा मुरझाय जावय हय, अऊर ओको फूल झड़ जावय हय अऊर ओकी शोभा कम होत जावय हय। योच तरह धनवान भी अपनो कार्य म चलतो चलतो नाश होय जायेंन।<verse eid="JAS 1:11" /></para>
  <para style="s">परख अऊर लुभावनो</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />धन्य हय ऊ आदमी जो परीक्षा म स्थिर रह्य हय, कहालीकि ऊ खरो निकल क जीवन को ऊ मुकुट पायेंन जेकी प्रतिज्ञा प्रभु न अपनो प्रेम करन वालो सी करी हय। <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />परीक्षा की घड़ी म कोयी ख यो नहीं कहनो चाहिये कि परमेश्वर मोरी परीक्षा ले रह्यो हय, कहालीकि बुरी बातों सी परमेश्वर ख कोयी लेनो देनो नहाय। ऊ कोयी की परीक्षा नहीं लेवय। <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />पर हर एक आदमी अपनी बुरी इच्छा सी खिच क अऊर फस क परीक्षा म पड़य हय। <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />तब बुरी इच्छा गर्भवती होय क पाप ख जनम देवय हय अऊर जब पाप पूरी रीति सी बढ़ जावय हय त मृत्यु ख पैदा करय हय।<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />हे मोरो प्रिय भाऊवों अऊर बहिनों, धोका मत खावो। <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />कहालीकि हर एक अच्छो दान अऊर हर एक अच्छो परिपूर्ण उपहार स्वर्ग सीच आवय हय, अऊर ऊ परमेश्वर को द्वारा जेन स्वर्गीय प्रकाश ख बनायो हय, ओख खल्लो लायो जावय हय, ऊ हमेशा बदलतो रहन वाली छाव को जसो नहीं बदलय। <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />ओन अपनीच इच्छा सी हम्ख सच को वचन को द्वारा पैदा करयो, ताकि हम ओकी सृष्टि करी हुयी चिजों म सी एक तरह को पहिलो फर हो।<verse eid="JAS 1:18" /></para>
  <para style="s">सुननो अऊर करनो</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />हे मोरो प्रिय भाऊवों अऊर बहिनों, या बात तुम जान लेवो: हर एक आदमी सुनन लायी तत्पर अऊर बोलन म धीमो अऊर गुस्सा म भी धीमो हो, <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />कहालीकि आदमी को गुस्सा परमेश्वर को सच्चो उद्देश्य हासिल नहीं कर सकय। <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />येकोलायी पूरी मलिनता अऊर कपट पन की बढ़ती ख दूर कर क्, ऊ वचन ख नम्रता सी स्वीकार कर लेवो जो दिल म बोयो गयो अऊर जो तुम्हरो उद्धार कर सकय हय।<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />केवल सुनन वालो नहीं जो अपनो आप ख धोका देवय हंय पर वचन पर चलन वालो बने। <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />कहालीकि जो कोयी वचन ख सुनन वालो हय अऊर ओको पर चलन वालो नहीं हो, त ऊ आदमी को जसो हय जो अपनो स्वाभाविक मुंह आरसा म देखय हय। <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />ऊ अपनो आप ख देख क चली जावय अऊर तुरतच भूल जावय हय कि मय कसो होतो। <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />पर जो आदमी स्वतंत्रता की सिद्ध व्यवस्था पर ध्यान करतो रह्य हय, ऊ सुन क भूलय नहीं पर वसोच काम करय हय, येकोलायी परमेश्वर ओको काम म आशीष देयेंन।<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />का कोयी अपनो आप ख सच्चो समझय हय? अऊर यदि खुद अपनी जीबली ख वश म नहीं कर सकतो त अपनो आप ख धोका दे रह्यो हय, त ओकी भक्ति बेकार हय। <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />हमरो परमेश्वर अऊर बाप को जवर शुद्ध अऊर निर्मल भक्ति यो हय कि अनाथों अऊर विधवावों को कठिनायी म ओकी सुधि ले, अऊर अपनो आप ख जगत सी निष्कलंक रखे।<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">पक्षपात को विरुद्ध चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />हे मोरो भाऊवों अऊर बहिनों, हमरो महिमायुक्त प्रभु यीशु मसीह पर तुम्हरो विश्वास पक्षपात को संग नहीं हो। <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />समझो यदि एक धनवान आदमी सोनो को छल्ला अऊर अच्छो कपड़ा पहिन्यो हुयो तुम्हरी सभा म आयेंन, अऊर एक गरीब भी गन्दो कपड़ा पहिन्यो हुयो आये, <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />अऊर तुम ऊ अच्छो कपड़ा वालो को मुंह देख क कहो, “तय उत अच्छी जागा म बैठ,” अऊर ऊ गरीब सी कहो, “तय इत खड़ो रह,” यां “मोरो पाय को जवर बैठ।” <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />त का तय न आपस म भेद-भाव नहीं करयो अऊर बुरो बिचार सी न्याय करन वालो नहीं ठहरयो?<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />हे मोरो प्रिय भाऊवों अऊर बहिनों, सुनो। का परमेश्वर न यो जगत को गरीबों ख नहीं चुन्यो कि विश्वास म धनी अऊर ऊ राज्य को अधिकारी हो, जेकी प्रतिज्ञा ओन उन्को सी करी हय जो ओको सी प्रेम रखय हंय? <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />पर तुम ऊ गरीब को अपमान करय हय। का धनी लोग तुम पर दबाव नहीं डालय अऊर का हिच तुम्ख कचहरी म घसीट क नहीं ले जावय? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />का हि यो नोहोय, जो ऊ अच्छो नाम की निन्दा नहीं करय जो तुम ख दियो गयो हय?<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />तब भी यदि तुम पवित्र शास्त्र को यो वचन को अनुसार कि “तय अपनो पड़ोसी सी अपनो जसो प्रेम रख” सचमुच ऊ राज व्यवस्था ख पूरी करय हय, त अच्छोच करय हय। <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />पर यदि तुम लोगों को बाहरी पहरावा देख क व्यवहार करय हय त तुम पाप करय हय; अऊर व्यवस्था तुम्ख नियम को उल्लंघन करन वालो ठहरावय हय। <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />कहालीकि जो कोयी पूरी व्यवस्था को पालन करय हय पर एकच बात म चूक जाये त ऊ सब बातों म दोषी ठहर चुक्यो हय। <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />येकोलायी कि जेन यो कह्यो, “तय व्यभिचार मत करजो” ओनच यो भी कह्यो, “तय हत्या मत करजो,” येकोलायी यदि तय न व्यभिचार त नहीं करयो पर हत्या करी तब भी तय व्यवस्था को उल्लंघन करन वालो ठहरयो। <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />तुम उन लोगों को जसो वचन बोलो अऊर काम भी करो, जिन्को न्याय ऊ व्यवस्था को अनुसार होयेंन जो हम्ख स्वतंत्र करय हय। <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />येकोलायी जो दयालु नहाय ओको लायी परमेश्वर को न्याय भी बिना दया कोच होयेंन पर दया न्याय पर विजय हय।<verse eid="JAS 2:13" /></para>
  <para style="s">विश्वास अऊर कर्म</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />हे मोरो भाऊवों अऊर बहिनों, यदि कोयी कहे कि मोख विश्वास हय पर ऊ कर्म नहीं करय हय, त येको सी का फायदा? का असो विश्वास कभी ओको उद्धार कर सकय हय? <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />यदि कोयी भाऊ यां बहिन को जवर कम कपड़ा होना अऊर उन्ख हर दिन भोजन की कमी होना, <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />अऊर तुम म सी कोयी उन्को सी कहे, “शान्ति सी जावो, अऊर तुम्ख कपड़ा की कमी नहीं होय तुम स्वस्थ रहो अऊर अच्छो सी खाय क तृप्त रहो,” पर जो चिजे शरीर लायी जरूरी हंय ऊ उन्ख नहीं दे त का फायदा? <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />वसोच विश्वास भी हय, यदि कर्म सहित नहीं होना त अपनो स्वभाव म मरयो हुयो हय।<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />बल्की कोयी कह्य सकय हय, “तोख विश्वास हय अऊर मय कर्म करू हय।” तय अपनो विश्वास मोख कर्म बिना त दिखाव; अऊर मय अपनो विश्वास अपनो कर्मों को द्वारा तोख दिखाऊं। <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />का तोख विश्वास हय कि एकच परमेश्वर हय? तय अच्छो करय हय। दुष्ट आत्मा भी विश्वास रखय, अऊर कापय हंय। <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />पर हे निकम्मो आदमी, का तय यो भी नहीं जानय कि कर्म बिना विश्वास बेकार हय? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />जब हमरो पुर्वज अब्राहम न अपनो बेटा इसहाक ख वेदी पर चढ़ायो, त का ऊ कर्मों सी सच्चो नहीं ठहरयो होतो? <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />यानेकि तय न देख लियो कि विश्वास न ओको कामों को संग मिल क प्रभाव डाल्यो हय, अऊर कर्मों सी विश्वास सिद्ध भयो, <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />अऊर पवित्र शास्त्र को यो वचन पूरो भयो: “अब्राहम न परमेश्वर को विश्वास करयो, अऊर यो ओको लायी सच्चो ठहरयो;” अऊर ऊ परमेश्वर को संगी कहलायो। <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />यो तरह तुम न देख लियो कि आदमी केवल विश्वास सीच नहीं, बल्की कर्मों सी भी सच्चो ठहरय हय।<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />वसीच राहब वेश्या भी, जब ओन दूतों ख अपनो घर म उतारयो अऊर दूसरों रस्ता सी बिदा करयो, त का कर्मों सी सच्चो नहीं ठहरी?<verse eid="JAS 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26" />यानेकि जसो शरीर आत्मा बिना मरी हुयी हय, वसोच विश्वास भी कर्म बिना मरयो हुयो हय।<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">जीबली ख वश म करनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />हे मोरो भाऊवों अऊर बहिनों, तुम म सी बहुत शिक्षक मत बनो, कहालीकि जानय हय कि हम शिक्षक को अधीन गम्भीरता सी न्याय करयो जायेंन। <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />येकोलायी कि हम सब बहुत बार चूक जाजे हंय। यदि कोयी ओको बोलन म नहीं चूकय हय त ऊ एक सिद्ध आदमी आय अऊर पूरो शरीर ख भी वश म कर सकय हय। <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />जब हम अपनी आज्ञा मनावन या ओख वश म करन लायी घोड़ा को मुंह म लगाम लगायजे हंय, त हम ओकी पूरो शरीर ख जित चाहे उत घुमाय सकजे हंय। <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />जहाज भी असो बड़ो होवय हंय अऊर बहुत बड़ी हवा सी चलायो जावय हंय, तब भी एक छोटी सी पतवार को द्वारा जहाज चलावन वालो की इच्छा को अनुसार घुमायो जावय हंय। <verse eid="JAS 3:4" /><verse number="5" style="v" sid="JAS 3:5" />वसीच जीबली भी एक छोटो सो अंग आय अऊर ऊ बड़ी-बड़ी डींग मारय हय।</para>
  <para style="p" vid="JAS 3:5">सोचो की, छोटी सी आगी सी कितनो बड़ो जंगल म आगी लग सकय हय। <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />जीबली भी एक आगी आय; जीबली हमरो अंगों म अधर्म को एक जगत आय, अऊर पूरो शरीर पर कलंक लगावय हय, अऊर जीवनगति म आगी लगाय देवय हय, अऊर नरक कुण्ड की आगी सी जरती रह्य हय। <verse eid="JAS 3:6" /><verse number="7" style="v" sid="JAS 3:7" />कहालीकि हर तरह को वन पशु, पक्षी, अऊर रेंगन वालो जन्तु, अऊर जलचर त आदमी जाति को वश म होय सकय हंय अऊर भय भी गयो हंय, <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />पर जीबली ख आदमियों म सी कोयी वश म नहीं कर सकय; ऊ एक असी बला हय जो कभी रुकय भी नहाय, ऊ जीव नाशक जहेर सी भरयो हुयो हय। <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />येको सी हम प्रभु अऊर बाप की स्तुति करजे हंय, अऊर येको सी आदमियों ख जो परमेश्वर को स्वरूप म पैदा भयो हंय श्राप देजे हंय। <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />एकच मुंह सी धन्यवाद अऊर श्राप दोयी निकलय हंय। हे मोरो विश्वासियों, असो नहीं होनो चाहिये। <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />का झरना को एकच स्रोता सी मीठो अऊर खारो पानी दोयी निकलय हय? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />हे मोरो संगियों, का अंजीर को झाड़ म जैतून, या अंगूर की डगाली म अंजीर लग सकय हंय? वसोच खारो झरना सी मीठो पानी नहीं निकल सकय। <figure style="fig" alt="Rider on a horse" file="lb00035c.tif" size="col" copy="Horace Knowles ©" ref="३:३">घोड़ा पर सवार </figure><verse eid="JAS 3:12" /></para>
  <para style="s">स्वर्गीय बुद्धि</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />तुम म बुद्धिमान अऊर समझदार कौन हय? जो असो हो ऊ अपनो कामों ख अच्छी चाल चलन सी ऊ नम्रता सहित प्रगट करे जो ज्ञान सी पैदा होवय हय। <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />पर यदि तुम अपनो अपनो मन म जलन, कड़वाहट, स्वार्थिपन अऊर विरोध रखय हय, त बुद्धी पर घमण्ड कर क् सच को विरुद्ध झूठ मत बोलो। <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />यो ज्ञान ऊ नहीं जो स्वर्ग सी उतरय हय, बल्की सांसारिक, अऊर सांसारिक, अऊर शारीरिक, अऊर शैतान को तरफ सी हय। <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />कहालीकि जित जलन अऊर स्वार्थिपन होवय हय, उत अव्यवस्था अऊर हर तरह की बुरी बाते होवय हय। <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />पर जो ज्ञान स्वर्ग सी आवय हय ऊ पहिले त पवित्र होवय हय फिर मिलनसार, नरम स्वभाव अऊर शान्तिमय अऊर दया अऊर अच्छो फरो सी लद्यो हुयो अऊर पक्षपात अऊर निष्कपट होवय हय। <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />शान्ति प्रस्थापित करन वालो शान्ति म बीज बोवय हय ताकि ओख सच्चायी की फसल प्राप्त होवय हय।<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">जगत सी दोस्ती</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />का तुम्हरो बीच म लड़ाईयां अऊर झगड़ा कित सी आवय हय? का यो इच्छावों सी नहीं होवय हय? जो तुम्हरो अन्दर झगड़ा करतो रह्य हंय। <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />तुम चाहवय हय पर तुम्ख मिलय नहाय; येकोलायी तुम हत्या करय हय; तुम पूरो रीति सी इच्छा रखय हय, अऊर कुछ हासिल नहीं कर पावय; येकोलायी तुम झगड़य अऊर लड़य हय। तुम जो चाहवय हय ऊ मिलय नहाय कहालीकि तुम परमेश्वर सी मांगय नहाय। <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />तुम मांगय हय अऊर पावय नहाय, येकोलायी कि बुरी इच्छा सी मांगय हय, ताकि अपनो सुखविलास म उड़ाय देवो। <verse eid="JAS 4:3" /><verse number="4" style="v" sid="JAS 4:4" />हे विश्वास हिन लोगों, का तुम नहीं जानय कि जगत सी दोस्ती करनो परमेश्वर सी दुस्मनी करनो हय जो कोयी जगत को संगी होनो चाहवय हय ऊ अपनो आप ख परमेश्वर को दुश्मन बनावय हय। <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />का तुम यो समझय हय कि पवित्र शास्त्र बेकार कह्य हय, “जो आत्मा ख ओन हमरो अन्दर बसायो हय, का ऊ असी लालसा करय हय जेको प्रतिफल ईर्ष्या हय?” <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />ऊ त अऊर भी अनुग्रह देवय हय; यो वजह यो लिख्यो हय, “परमेश्वर अभिमानियों को विरोध करय हय, पर दीनो पर अनुग्रह करय हय।”<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />येकोलायी परमेश्वर को अधीन होय जावो; अऊर शैतान को सामना करो, त ऊ तुम्हरो जवर सी भाग निकलेंन। <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />परमेश्वर को जवर आवो त ऊ भी तुम्हरो जवर आयेंन। हे पापियों, अपनो हाथ धोय लेवो; अऊर हे कपटियों, अपनो दिल ख पवित्र करो। <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />दु:खी हो, अऊर शोक करो, अऊर रोवो। तुम्हरी हसी शोक म अऊर तुम्हरी खुशी उदासी बदल जायेंन। <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />प्रभु को आगु नम्र बनो त ऊ तुम्ख ऊचो करेंन।<verse eid="JAS 4:10" /></para>
  <para style="s">भाऊवों पर दोष लगावनो</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />हे भाऊवों अऊर बहिनों, एक दूसरों को विरोध म मत बोलो, एक दूसरों को विरोध मत करो। तुम व्यवस्था को पालन करन वालो नहीं पर ओको न्याय करन वालो बन जावय हय। <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />व्यवस्था देन वालो अऊर न्याय करन वालो एकच परमेश्वर हय। ऊ अकेलोच बचाय सकय हय यां नाश कर सकय हय। तुम मसीह भाऊ को न्याय करन वालो कौन होवय हय?<verse eid="JAS 4:12" /></para>
  <para style="s">घमण्ड को विरुद्ध चेतावनी</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />सुनो तुम जो यो कह्य हय, “अज यां कल हम कोयी अऊर नगर म जाय क उत एक साल बितायबो, अऊर व्यापार कर क् फायदा कमायबो।” <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />अऊर यो नहीं जानय कि कल का होयेंन। सुन त लेवो, तुम्हरो जीवन हयच का? तुम त भाप को जसो हय, जो थोड़ी देर दिखायी देवय हय फिर गायब हो जावय हय। <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />येको उलट तुम्ख यो कहनो चाहिये, “यदि प्रभु चाहेंन त हम जीन्दो रहबोंन, अऊर यो यां ऊ काम भी करबोंन।” <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />पर अब तुम अपनी डींग मारय हय अऊर असो सब घमण्ड बुरो होवय हय। <figure style="fig" alt="Customer, merchant with his wares" file="hk00172c.tif" size="col" copy="Horace Knowles ©" ref="४:१३">लेनवालो अऊर व्यापारी अपनो सामान को संग</figure><verse eid="JAS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17" />येकोलायी जो कोयी भलायी करनो जानय हय अऊर नहीं करय, ओको लायी यो पाप को दोष आय।<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">धनवानों ख चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />हे धनवानों, सुनो, तुम अपनो आवन वाली विपत्तियों पर रोवो अऊर ऊचो आवाज सी विलाप करो। <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" /><note caller="+" style="x"><char style="xo" closed="false">५:२ </char><char style="xt" closed="false"><ref loc="MAT 6:19">मत्ती ६:१९</ref></char></note>तुम्हरो धन सड़ गयो हय अऊर तुम्हरो कपड़ा ख कीड़ा खाय गयो हंय। <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />तुम्हरो सोना-चांदी म जंग लग गयो हय; अऊर ऊ जंग तुम पर गवाही देयेंन, अऊर आगी को जसो तुम्हरो मांस खाय जायेंन। तुम न आखरी युग म धन जमा करयो हय। <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />देखो, जिन मजूरों न तुम्हरो खेत काट्यो, उनकी वा मजूरी जो तुम न धोका दे क रख लियो हय चिल्लाय रही हय, अऊर काटन वालो की दुवा सर्वशक्तिमान प्रभु को कानो तक पहुंच गयी हय। <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />तुम धरती पर सुखविलास म लग्यो रह्यो अऊर बड़ोच सुख भोग्यो; तुम न यो वध को दिन लायी अपनो दिल को पालन-पोषन कर क् ओख मोटो-ताजो करयो। <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />तुम न सच्चो ख दोषी ठहराय क मार डाल्यो, ऊ तुम्हरो सामना नहीं करय।<verse eid="JAS 5:6" /></para>
  <para style="s">धीरज अऊर प्रार्थना</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />येकोलायी हे भाऊवों अऊर बहिनों, प्रभु को आगमन तक धीरज रखो। देखो, किसान जमीन की किमती फसल की आशा रखतो हुयो पहिली अऊर आखरी बारीश होन तक धीरज सी बाट देखतो रह्य हय। <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />तुम भी धीरज रखो; अऊर अपनी आशा ख बनायो रखो, कहालीकि प्रभु को आगमन जवर हय।<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />हे भाऊवों अऊर बहिनों, एक दूसरों को प्रति शिकायत मत करो, ताकि परमेश्वर तुम्हरो न्याय नहीं करे। देखो, शासक प्रगट होन पर हय। <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />हे भाऊवों अऊर बहिनों, जिन भविष्यवक्तावों न प्रभु को नाम सी बाते करी, उन ख दु:ख उठावन को समय उन्को धीरज को आदर्श समझो। <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />देखो, हम धीरज धरन वालो उन भविष्यवक्तावों ख धन्य कहजे हंय। तुम न अय्युब को धीरज को बारे म त सुन्योच हय, अऊर प्रभु को तरफ सी जो ओको प्रतिफल भयो ओख भी जान लियो हय, जेकोसी प्रभु की अत्यन्त करुना अऊर दया प्रगट होवय हय।<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:१२ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:34-37">मत्ती ५:३४-३७</ref>
      </char>
    </note>पर हे मोरो भाऊवों अऊर बहिनों, सब सी अच्छी बात या हय कि कसम मत खाजो, नहीं स्वर्ग की, नहीं धरती की, नहीं कोयी अऊर चिज की; पर तुम्हरी बातचीत हव की हव, अऊर नहीं की नहीं हो, कि तुम परमेश्वर को न्याय को लायक नहीं ठहरो।<verse eid="JAS 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />तुम म कोयी विपत्ति म पड़्यो हय? त उन्न प्रार्थना करनो चाहिये। का तुम म कोयी खुश हय, त उन न स्तुति को भजन गानो चाहिये। <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" /><note caller="+" style="x"><char style="xo" closed="false">५:१४ </char><char style="xt" closed="false"><ref loc="MRK 6:13">मरकुस ६:१३</ref></char></note>का तुम म कोयी रोगी हय? त उन्ख चाहिये कि मण्डली को बुजूर्गों ख बुलाये कि हि प्रार्थना करे उन पर प्रभु को नाम सी तेल मले, <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />अऊर विश्वास की प्रार्थना को द्वारा रोगी बच जायेंन अऊर प्रभु ओख फिर सी स्वस्थ शरीर प्रदान करेंन; अऊर यदि ओन पाप भी करयो होना, त उन्की भी माफी होय जायेंन। <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />येकोलायी तुम आपस म एक दूसरों को आगु अपनो-अपनो पापों ख मान लेवो, अऊर एक दूसरों को लायी प्रार्थना करो, जेकोसी चंगो होय जावो: सच्चो लोग की प्रार्थना सामर्थीकारक अऊर प्रभावशाली होवय हय। <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />एलिय्याह भी त हमरो जसो दु:ख-सुख भोग्यो आदमी होतो; अऊर ओन गिड़गिड़ाय क प्रार्थना करी कि पानी नहीं बरसे; अऊर साढ़े तीन साल तक धरती पर पानी नहीं बरस्यो। <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />तब ओन प्रार्थना करी, त आसमान सी बरसात भयी, अऊर धरती फलवन्त भयी।<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />हे मोरो भाऊवों अऊर बहिनों, यदि तुम म कोयी सच को रस्ता सी भटक जाये अऊर कोयी ओख फिर सी लाये, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" /><note caller="+" style="x"><char style="xo" closed="false">५:२० </char><char style="xt" closed="false"><ref loc="1PE 4:8">१ पतरस ४:८</ref></char></note>त ऊ यो जान ले कि जो कोयी कोयी भटक्यो हुयो पापी ख ओको गलत रस्ता सी फिर सी लाये, ऊ पापी को जीव ख मरन सी बचायेंन अऊर ओको कुछ पापों ख माफी करयो जान को कारण बनेंन।<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>