<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Lodhi</book>
  <para style="h">३ यूहन्ना</para>
  <para style="toc3">३ यूहन्ना</para>
  <para style="toc2">३ यूहन्ना</para>
  <para style="toc1">यूहन्ना की तीसरी चिट्ठी</para>
  <para style="mt2">यूहन्ना की तीसरी पत्री</para>
  <para style="mt1">यूहन्ना की तीसरी चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">यूहन्ना की तीसरी चिट्ठी प्रेरित यूहन्ना द्वारा मसीह को जनम को ५० सी १०० साल को बीच लिख्यो गयो होतो यूहन्ना खुद लेखक को रूप म नहीं जान्यो जावय हय। बल्की ऊ खुद ख बुजूर्ग कह्य हय <char style="xt"><ref loc="3JN 1:1">१:१</ref></char>, <char style="xt"><ref loc="2JN 1:1">२ यूहन्ना १:१</ref></char> उच करय हय। असो मान्यो जावय हय कि यूहन्ना न यूहन्ना को अनुसार सुसमाचार लिख्यो होतो अऊर इफिसियों म रहतो हुयो तीन चिट्ठी १ यूहन्ना, २ यूहन्ना, ३ यूहन्ना, लिख्यो।</para>
  <para style="ip">यूहन्ना न या चिट्ठी गयुस नाम को एक विश्वासी ख लिख्यो होतो। ऊ गयुस ख एक संगी को रूप म सम्बोधित करत होतो, अऊर ओख ऊ क्षेत्र को माध्यम सी यात्रा कर रह्यो मसीह भाऊवों लायी अतिथि सत्कार को बारे म निर्देश देत होतो।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. यूहन्ना न अपनी चिट्ठी प्रस्तुत करयो। <char style="ior"><ref loc="3JN 1:1">१:१</ref></char></para>
  <para style="io1">२. गयुस ख प्रोत्साहित करय हय अऊर भाऊवों ख अतिथि सत्कार दिखावन लायी निर्देश देवय हय। <char style="ior"><ref loc="3JN 1:2-8">१:२-८</ref></char></para>
  <para style="io1">३. हर समय, ऊ दोय दूसरों आदमियों, दियुत्रिफेस अऊर दिमेत्रियुस की बाते करय हय। <char style="ior"><ref loc="3JN 1:9-12">१:९-१२</ref> </char></para>
  <para style="io1">४. आखरी म अपनी चिट्ठी लिखनो बन्द करय हय। <char style="ior"><ref loc="3JN 1:13-14">१:१३-१४</ref></char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">प्रेरितों १९:२९</ref>; <ref loc="ROM 16:23">रोमियों १६:२३</ref>; <ref loc="1CO 1:14">१ कुरिन्थियों १:१४</ref></char>
    </note>बुजूर्ग यूहन्ना को, तरफ सी प्रिय संगी गयुस को नाम, जेकोसी मय सच्चो प्रेम रखू हय।<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />हे प्रिय संगी, मोरी या प्रार्थना हय कि जसो तय आत्मिक उन्नति कर रह्यो हय, वसोच तय सब बातों म उन्नति करे अऊर भलो चंगो रहे। <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />कहालीकि जब विश्वासी भाऊवों न आय क तोरो ऊ सच कि गवाही दी, जो सच पर तय हमेशा चलय हय, त मय बहुतच खुश भयो। <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />मोख येको सी जादा अऊर कोयी खुशी नहाय कि मय सुनू, कि मोरो बच्चा सच को रस्ता पर चलय हंय।<verse eid="3JN 1:4" /></para>
  <para style="s">गयुस की बढ़ायी</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />हे प्रिय संगियों, जो कुछ तुम उन भाऊवों को संग करय हय, जो परदेशी हंय, ओख ईमानदारी को रूप म करय हय। <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />जो प्रेम तुम न उन पर दर्शायो हय उन्न मण्डली को आगु तोरो प्रेम की गवाही दियो हय। उन्की यात्रा बनायो रखन को लायी कृपया उन्की यो तरह सी मदत करनो जेकोसी परमेश्वर खुश हो। <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />कहालीकि हि मसीह की सेवा की यात्रा पर निकल पड़यो हंय तथा अविश्वासियों सी कुछ मदत नहीं लेवय। <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />येकोलायी हम मसीहियों ख असो लोगों की मदत करनो चाहिये, ताकी हम भी सच को काम म ओको सहकर्मी होय सके।<verse eid="3JN 1:8" /></para>
  <para style="s">दियुत्रिफेस अऊर दिमेत्रियुस</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />या चिट्ठी मय न मण्डली ख भी लिख्यो होतो, पर दियुत्रिफेस जो उन्म मुखिया बननो चाहवय हय, ऊ मोरी बातों पर ध्यान नहीं लगावय। <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />येकोलायी जब मय आऊं त ओको कामों की जो ऊ कर रह्यो हय, याद दिलाऊं, कि ऊ हमरो बारे म बुरी बाते बकय हय; अऊर हमरो बारे म झूठी बाते बतावय हय पर इतनोच ओको लायी काफी नहाय ऊ मसीही भाऊवों ख स्वीकार नहीं करय, जब हि आवय हय अऊर उन्ख भी रोकय हय जो स्वीकार करनो चाहवय हंय अऊर पूरी कोशिश करय हय कि उन्ख मण्डली सी बाहेर निकाले।<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />हे प्रिय संगी, बुरायी को नहीं पर भलायी को अनुयायी हो। जो भलायी करय हय, ऊ परमेश्वर को तरफ सी हय; पर जो बुरायी करय हय, ओन परमेश्वर ख नहीं देख्यो।<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />दिमेत्रियुस को बारे म सब लोगों न अच्छी गवाही दियो; अऊर हम भी गवाही देजे हंय, अऊर तय जानय हय कि हमरी गवाही सच्ची हय।<verse eid="3JN 1:12" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />मोख तोख बहुत कुछ लिखनो त होतो, पर स्याही अऊर कलम सी लिखनो नहीं चाहऊ। <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />पर मोख आशा हय कि तोरो सी जल्दी मिलूं, तब हम आमने सामने बातचीत करबो।<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />तोख शान्ति मिलती रहेंन।</para>
  <para style="p" vid="3JN 1:15">यहां को तोरो सब संगियों को तोख नमस्कार। उत को संगियों ख भी नमस्कार कह्य देजो।<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>