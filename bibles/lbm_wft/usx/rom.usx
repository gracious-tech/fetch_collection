<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Lodhi</book>
  <para style="h">रोमियों</para>
  <para style="toc3">रोमियों</para>
  <para style="toc2">रोमियों</para>
  <para style="toc1">रोमियों को नाम पौलुस प्रेरित की चिट्ठी</para>
  <para style="mt2">रोमियों के नाम पौलुस प्रेरित कि चिट्ठी</para>
  <para style="mt1">रोमियों को नाम पौलुस प्रेरित कि पत्री</para>
  <para style="imt">परिचय</para>
  <para style="ip">रोमियों की किताब लगभग प्रेरित पौलुस न ५४-५८ साल को बीच यीशु मसीह को जनम को बाद लिखी होती। पौलुस न अभी तक रोम को दौरा नहीं करयो होतो, येकोलायी उन्न या चिट्ठी रोम म मसीहियों ख निर्देश देन लायी भेज्यो, दोयी यहूदी अऊर गैरयहूदी उन्न कुरिन्थुस शहर सी चिट्ठी लिखी होती, जित हि ऊ समय रहत होतो। पौलुस न लिखी ताकि पूरो राष्ट्र यीशु मसीह <char style="xt"><ref loc="ROM 16:26">१६:२६</ref></char> पर विश्वास अऊर पालन कर सके।</para>
  <para style="ip">रोमियों कि किताब हर जागा अऊर हर समय मसीही लोगों लायी एक महत्वपूर्न किताब हय कहालीकि पौलुस स्पष्ट रूप सी अऊर अच्छो तरह सी समझावय हंय कि हम यीशु मसीह को उद्धार को बारे म बताय सकजे हय। पौलुस न यीशु मसीह को सुसमाचार ख पुरानो नियम सी भी जोड़्यो। कुछ विद्वानों को माननो हय कि किताब म सब सी महत्वपूर्न किताब <char style="xt"><ref loc="ROM 1:16">१:१६</ref></char> हय जो कह्य हय, “मोख सुसमाचार सी कोयी शरम नहाय, कहालीकि यो पूरो को उद्धार लायी परमेश्वर की शक्ति हय जो मानय हय: पहिले यहूदी लायी, तब ओको लायी गैरयहूदी।” <char style="xt"><ref loc="ROM 1-12">रोमियों १–१२</ref></char> को पहिलो भाग धर्मशास्त्री आय अऊर दूसरों भाग <char style="xt"><ref loc="ROM 13-15">१३–१५</ref></char> म मसीही जीवन लायी व्यावहारिक निर्देश आय।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पौलुस सामान्य रूप सी अपनो परिचय देतो हुयो अपनी चिट्ठी की सुरूवात करय हय अऊर कह्य हय कि ऊ कौन ख लिख रह्यो हय। <char style="ior"><ref loc="ROM 1:1-15">१:१-१५</ref></char></para>
  <para style="io1">२. येको बाद ऊ यीशु मसीह को द्वारा मानव जाति कि स्थिति अऊर उद्धार को बारे म लिखय हय। <char style="ior"><ref loc="ROM 1:16-11:36">१:१६–११:३६</ref></char></para>
  <para style="io1">३. येको बाद पौलुस मसीही जीवन जीन लायी कुछ व्यावहारिक निर्देश देवय हय। <char style="ior"><ref loc="ROM 12:1-15:13">१२:१–१५:१३</ref></char></para>
  <para style="io1">४. ऊ रोम की मण्डली म लोगों ख कुछ शुभकामनायें दे क रोमियों की किताब ख खतम करय हय। <char style="ior"><ref loc="ROM 16">१६</ref></char></para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />पौलुस को तरफ सी जो यीशु मसीह को सेवक हय, अऊर जेख परमेश्वर न प्रेरित होन लायी बुलायो गयो, अऊर परमेश्वर को ऊ सुसमाचार लायी अलग करयो गयो।<verse eid="ROM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2" />जेकी पहिलेच अपनो भविष्यवक्तावों को द्वारा पवित्र शास्त्र म घोषना कर दी गयी, <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />जेको सम्बन्ध बेटा सी हय; जो शरीर को भाव सी त दाऊद को वंश सी पैदा भयो; <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />अऊर पवित्रता की आत्मा को भाव सी मरयो हुयो म सी जीन्दो होन को वजह सामर्थ को संग परमेश्वर को बेटा ठहरयो हय, यो यीशु मसीह हमरो प्रभु आय। <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />परमेश्वर द्वारा हम्ख अनुग्रह अऊर प्रेरितायी मिली कि ओको नाम को वजह सब जातियों को लोग विश्वास करे अऊर आज्ञा को पालन करे, <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />येको म तुम भी सामिल हो जो रोम म रह्य हय जिन्ख परमेश्वर न यीशु मसीह को होन लायी बुलायो गयो हय।<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />उन सब लोगों लायी मय लिख रह्यो हय जो रोम म परमेश्वर को प्रिय हंय अऊर उन्ख परमेश्वर न अपनो लोग होन लायी बुलायो गयो हंय।</para>
  <para style="p" vid="ROM 1:7">हमरो पिता परमेश्वर अऊर प्रभु यीशु मसीह को तरफ सी तुम्ख अनुग्रह अऊर शान्ति मिलती रहे।<verse eid="ROM 1:7" /></para>
  <para style="s">धन्यवाद की प्रार्थना</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />पहिले मय तुम सब लायी यीशु मसीह को द्वारा अपनो परमेश्वर को धन्यवाद करू हय, कहालीकि तुम्हरो विश्वास की चर्चा पूरो जगत म होय रही हय। <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />परमेश्वर जेकी सेवा मय अपनी आत्मा सी ओको बेटा को सुसमाचार को बारे म करू हय, उच मोरो गवाह हय कि मय तुम्ख कसो तरह लगातार याद करतो रहू हय, <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />अऊर हर समय अपनी प्रार्थनावों म बिनती करू हय कि कोयी रीति सी अब तुम्हरो जवर आवन की मोरी यात्रा परमेश्वर की इच्छा सी पूरी हो। <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />कहालीकि मय तुम सी मिलन की बहुत इच्छा रखू हय ताकि मय तुम्ख आत्मिक वरदान बाट सकू जेकोसी तुम मजबूत होय जावो; <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />मतलब यो कि जब मय तुम्हरो बीच म रहू, त हम ऊ विश्वास को द्वारा जो मोरो म अऊर तुम म हय, एक दूसरों सी प्रोत्साहन पाये।<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१३ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:21">प्रेरितों १९:२१</ref>
      </char>
    </note>हे भाऊवों, अऊर बहिनों मय नहीं चाहऊं कि तुम येको सी अनजान रहो कि मय न बार बार तुम्हरो जवर आवनो चाह्यो, कि जसो मोख दूसरों गैरयहूदियों म फर मिल्यो, वसोच तुम म भी मिले, पर अब तक रोक्यो गयो। <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />मय यूनानियों अऊर गैरयूनानियों को अऊर बुद्धिमानों अऊर निर्बुद्धियों को कर्जदार आय। <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />येकोलायी मय तुम्ख भी जो रोम म रह्य हय, मय सुसमाचार सुनावन लायी बहुत उत्सुक हय।<verse eid="ROM 1:15" /></para>
  <para style="s">सुसमाचार की सामर्थ</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१६ </char>
      <char style="xt" closed="false">
        <ref loc="MRK 8:38">मरकुस ८:३८</ref>
      </char>
    </note>कहालीकि मय सुसमाचार सी नहीं लजाऊ, येकोलायी कि ऊ हर एक विश्वास करन वालो लायी, पहिले त यहूदी फिर गैरयहूदी लायी, सब लायी उद्धार को निमित्त परमेश्वर की सामर्थ हय। <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />कहालीकि सुसमाचार यो प्रगट करय हय कि परमेश्वर आदमियों ख अपनो प्रति सही कसो बनावय हय यो पहिले सी आखरी तक विश्वास को द्वाराच हय। जसो कि शास्त्र म लिख्यो हय, “जो आदमी परमेश्वर को संग सच्चो हय ऊ लोग विश्वास को द्वारा सी जीन्दो रहेंन।”<verse eid="ROM 1:17" /></para>
  <para style="s">आदम जाति को पाप</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />परमेश्वर को गुस्सा त उन लोगों को पाप अऊर दुष्टता स्वर्ग सी प्रगट होवय हय, जो सच ख बुरायी सी दबायो रखय हंय। <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />येकोलायी कि परमेश्वर को ज्ञान ओको मनो म प्रगट हय, कहालीकि परमेश्वर न उन पर प्रगट करयो हय। <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />जब सी परमेश्वर न जगत की रचना करी तब सी ओको अनदेख्यो गुन, मतलब ओकी सनातन काल की शक्ति अऊर ओको दैव्य स्वभाव यो दोयीच पूरी रीति सी साफ दिखायी देवय हय। ऊ उन चिजों ख जो परमेश्वर न रची हय हि ओख जान सकय हय, त येकोलायी उन लोगों को जवर कोयी बहाना नहाय। <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" /><note caller="+" style="x"><char style="xo" closed="false">१:२१ </char><char style="xt" closed="false"><ref loc="EPH 4:17">इफिसियों ४:१७</ref>,<ref loc="EPH 4:18">१८</ref></char></note>यो वजह कि परमेश्वर ख जानय हय पर हि परमेश्वर को रूप म सम्मान या धन्यवाद नहीं देवय। बल्की हि अपनो बिचार म पूरी रीति सी निरर्थक अऊर उन्को खाली दिमाक अन्धारो सी भर गयो हय। <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />हि अपनो आप ख बुद्धिमान समझय हय, पर हि मूर्ख बन गयो हय, <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />अऊर अविनाशी परमेश्वर की महिमा ख नाशवान आदमियों, अऊर पक्षिंयों, अऊर जनावरों, अऊर रेंगन वालो जन्तुवों की मूर्ति की समानता म बदल डाल्यो।<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />यो वजह परमेश्वर न उन्ख उन्को हर एक मन की इच्छावों को अनुसार अशुद्धता लायी छोड़ दियो कि हि आपस म अपनो शरीर को अनादर करे। <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />कहालीकि उन्न परमेश्वर की सच्चायी ख बदल क झूठ बनाय डाल्यो, अऊर सृष्टि की उपासना अऊर सेवा करी, जेक परमेश्वर न बनायो, न कि ऊ सृष्टिकर्ता की जो हमेशा धन्य हय! आमीन।<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />येकोलायी परमेश्वर न उन्ख नीच कामनावों को हाथों सौंप दियो; यहां तक कि उन्की बाईयों न भी स्वाभाविक योन सम्बन्ध को बजाय अस्वभाविक योन सम्बन्ध रखन लगी। <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />वसोच आदमी भी बाईयों को संग स्वाभाविक व्यवहार छोड़ क आपस म कामातुर होय क जलन लग्यो, अऊर आदमियों न आदमियों को संग निर्लज काम कर क् अपनो भ्रम को ठीक फर पायो।<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />जब उन्न परमेश्वर ख पहिचाननो नहीं चाह्यो, त परमेश्वर न भी उन्ख उन्को निकम्मो मन पर छोड़ दियो कि हि अनुचित काम करन लग्यो जो उन्ख नहीं करनो होतो। <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />येकोलायी हि सब तरह को अधर्म, अऊर दुष्टता, अऊर लोभ, अऊर अनैतिकता सी भर गयो; अऊर हि जलन, अऊर हत्या, अऊर झगड़ा, अऊर छल कपट, अऊर बुरायी सी भर गयो, अऊर चुगलखोर होय गयो, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />अऊर एक दूसरों की बुरायी करन वालो, परमेश्वर सी निन्दा करन वालो, अऊर अय्याशी करन वालो अऊर घमण्डी अऊर अहंकारी अऊर बुरायी करन लायी हर एक रस्ता ढूंढन वालो, अऊर माय बाप की आज्ञा नहीं मानन वालो, <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />हि विवेकहीन अऊर अपनो दियो गयो वाचा तोड़न वालो अऊर एक दूसरों को प्रति अऊर निर्दयी होय गयो। <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />हि त परमेश्वर की यो नियम जानय हंय कि असो काम करन वालो लोग भी मृत्यु दण्ड को लायक हंय, पर भी हि नहीं केवल उन काम करय हंय बल्की हि लोग उन्को कामों ख समर्थन करय हंय।<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">परमेश्वर को न्याय</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:1">मत्ती ७:१</ref>; <ref loc="LUK 6:37">लूका ६:३७</ref></char>
    </note>येकोलायी, हे दूसरों पर दोष लगावन वालो, तय चाहे कोयी भी आय, तोरो कोयी अधिकार नहीं हय; कहालीकि जो बात म तय दूसरों पर दोष लगावय हय उच बात म अपनो आप ख भी दोषी ठहरावय हय, येकोलायी कि तय जो दोष लगावय हय खुदच ऊ काम करय हय। <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />हम जानजे हंय कि असो काम करन वालो ख परमेश्वर सच्चायी को अनुसार न्याय करय हय। <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />पर हे आदमी, तय जो असो-असो काम करन वालो पर दोष लगावय हय अऊर खुद उच काम करय हय; का यो समझय हय कि तय परमेश्वर की सजा की आज्ञा सी बच जाजो? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />का तय ओकी महान दया, अऊर सहनशीलता, अऊर धीरजरूपी धन ख बेकार जानय हय? का निश्चित यो नहीं समझय कि परमेश्वर की कृपा तोख मन फिरावन को तरफ लिजावय हय? <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />पर तय अपनी कठोरता अऊर हटिलो मन को वजह ऊ दिन लायी जेको म परमेश्वर को गुस्सा अऊर सच्चो न्याय प्रगट होयेंन, अपनो आप लायी खुद गुस्सा लाय रह्यो हय। <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />परमेश्वर हम सब ख अपनो कर्मों को अनुसार फर देयेंन: <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />जो अच्छो कर्म म लग्यो रह्य क परमेश्वर को तरफ सी महिमा, अऊर आदर, अऊर अमरता की खोज म हंय, उन्ख परमेश्वर अनन्त जीवन देयेंन; <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />पर जो लोग स्वार्थी हंय अऊर सच्चायी ख नहीं मानय, ताकि बुरो काम कर सके, असो लोगों पर परमेश्वर को गुस्सा अऊर प्रकोप उन पर पड़ेंन। <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />अऊर कठिनायी अऊर संकट हर एक लोग पर जो बुरो करय हय आयेंन, पहिले यहूदी पर फिर गैरयहूदी पर; <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />पर परमेश्वर हर एक ख जो अच्छो कर्म करय हय, उन्ख महिमा अऊर आदर अऊर शान्ति, प्रदान करेंन, पहिले यहूदी ख फिर गैरयहूदी ख। <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />कहालीकि परमेश्वर बिना पक्षपात करयो सब को न्याय करय हय।<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />गैरयहूदियों को जवर मूसा को नियम नहाय अऊर उन्को पापों को न्याय भी बिना व्यवस्था को होयेंन। यहूदियों को जवर मूसा को नियम हय अऊर उन्को पापों को न्याय नियम को अनुसार होयेंन; <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />कहालीकि परमेश्वर को यहां व्यवस्था को सुनन वालो सच्चो नहीं, पर व्यवस्था पर चलन वालो सच्चो ठहराये जायेंन। <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />फिर जब गैरयहूदियों लोगों को जवर व्यवस्था नहाय, पर तब भी हि अपनो आप व्यवस्था पर चलय हंय, यो वजह सी अपनो आप म व्यवस्था हंय तब भी जब की उन्को जवर मूसा की व्यवस्था हंय। <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />उन्को चाल चलन दिखावय हय कि व्यवस्था उन्को दिल म लिख्यो हंय, अऊर उन्को अन्तरमन भी कह्य हंय कि सही हय, अऊर येख ले क उन्को मानसिक संघर्ष अपराधी या निर्दोष ठहरावय हंय; <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />ऊ दिन परमेश्वर, मोरो प्रचार करयो हुयो सुसमाचार को अनुसार यीशु मसीह को द्वारा लोगों की लूकी हुयी बिचार को न्याय करेंन।<verse eid="ROM 2:16" /></para>
  <para style="s">यहूदी अऊर व्यवस्था</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />यदि तय अपनो आप ख यहूदी कह्य हय, अऊर व्यवस्था पर निर्भर रह्य हय, अऊर अपनो परमेश्वर को बारे म तोख घमण्ड हय, <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />अऊर तोख पता हय परमेश्वर तोरो सी का करानो चाहवय हय अऊर अच्छी बातों ख चुननो तय न व्यवस्था सी सिख्यो हय; <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />अऊर अपनो आप पर भरोसा करय हय कि मय अन्धो को अगुवा, अऊर अन्धारो म पड़्यो हुयो की ज्योति, <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />अऊर बुद्धिहीनों को सिखावन वालो, अऊर भोलो लोगों को शिक्षक हय। अऊर तय निश्चित हय कि जो व्यवस्था तोरो जवर हय ओको म पूरो सच्चायी अऊर ज्ञान को समावेश हय। <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />तय जो दूसरों ख सिखावय हय, ऊ अपनो आप ख कहाली नहीं लागु करय? का तय जो चोरी नहीं करन की शिक्षा देवय हय, अऊर तय खुदच चोरी करय हय? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />तय जो कह्य हय, “व्यभिचार मत करजो,” का खुदच व्यभिचार करय हय? तय जो मूर्तियों सी चिड़ करय हय, का खुदच मन्दिरों ख लूटय हय? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />तय जो व्यवस्था को बारे म घमण्ड करय हय, का परमेश्वर की व्यवस्था नहीं मान क परमेश्वर को अपमान करय हय? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />“कहालीकि तुम्हरो वजह गैरयहूदियों म परमेश्वर को नाम की निन्दा करी जावय हय,” जसो शास्त्र म लिख्यो भी हय।<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />यदि तय व्यवस्था को पालन करय त खतना सी फायदा त हय, पर यदि तय व्यवस्था ख नहीं मानय त तोरो खतना बिन खतना की दशा ठहरयो। <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />येकोलायी यदि गैरयहूदी जेको खतना नहीं भयो हय तब भी ऊ व्यवस्था को पालन करय हय त का ओको खतनारहित होन ख भी खतना नहीं गिन्यो जाये? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />अऊर तुम यहूदियों ख गैरयहूदियों को द्वारा दोषी ठहरायो जायेंन जो भी तुम्हरो जवर लिखी हुयी व्यवस्था अऊर खतना भयो हय पर गैरयहूदी व्यवस्था को पालन करय हय जब की उन्को शारीरिक रूप सी खतना नहीं भयो हय। <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />एक सच्चो यहूदी कौन हय जेको हकिकत म खतना भयो हय? सच्चो यहूदी ऊ नहीं जो केवल बाहरी रूप यहूदी हय जेको खतना केवल शारीरिक हय। <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />पर सच्चो यहूदी उच आय; जो अन्दर सी यहूदी हय; जेको दिल सी खतना भयो हय अऊर यो परमेश्वर की आत्मा को कार्य हय, नहीं कि लिखी हुयी व्यवस्था को। असो आदमी परमेश्वर को तरफ सी प्रशंसा पायेंन नहीं कि आदमी को तरफ सी।<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />येकोलायी गैरयहूदी को आगु तुम्हरो यहूदी होन को का फायदा यां खतना को का फायदा? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />हर तरह सी बहुत फायदा हय। पहिले त यो कि परमेश्वर को वचन यहूदियों ख सौंप्यो गयो। <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />यदि कुछ अविश्वासी निकले भी त का भयो? का उन्को विश्वासघाती होनो सी परमेश्वर की सच्चायी ख बेकार कर देयेंन? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />बिल्कुल नहीं! बल्की परमेश्वर सच्चो हय अऊर हर एक आदमी झूठो ठहर सकय हय, जसो शास्त्र म लिख्यो हय,</para>
  <para style="q1" vid="ROM 3:4">“जब तय खुद को बचाव म बोलेंन तब तय सही ठहरेंन</para>
  <para style="q2" vid="ROM 3:4">अऊर न्याय करतो समय तय जीत पायेंन।”<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />येकोलायी यदि हमरो बुरो काम परमेश्वर को आगु सही ठहराय देवय हय, का हम कह्य सकजे हय जब परमेश्वर हम्ख सजा देवय हय त का ऊ गलत करय हय? यो त मय आदमी की रीति पर कहू हय। <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />बिल्कुल नहीं! नहीं त परमेश्वर कसो जगत को न्याय करेंन?<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />यदि मोरो झूठ को वजह परमेश्वर की सच्चायी ओकी महिमा लायी, ज्यादा कर क् प्रगट भयी त तब का पापी को जसो मय सजा को लायक ठहरायो जाऊ हय? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />“हम कहाली बुरायी करबो कि भलायी निकले?” जसो हम पर योच दोष लगायो भी जावय हय, अऊर कुछ कहजे हंय कि येको योच कहनो हय। पर असो ख दोषी ठहरानो ठीक हय।<verse eid="ROM 3:8" /></para>
  <para style="s">कोयी सच्चो नहाय</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />त फिर का भयो? का हम यहूदी गैरयहूदियों सी अच्छो हंय? कभी नहीं; कहालीकि हम यहूदियों अऊर गैरयहूदियों दोयी पर यो दोष लगाय चुक्यो हंय कि हि सब को सब पाप को अधिन म हंय। <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />जसो लिख्यो हंय:</para>
  <para style="q1" vid="ROM 3:10">कोयी सच्चो नहाय, एक भी नहीं।<verse eid="ROM 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11" />कोयी समझदार नहाय;</para>
  <para style="q2" vid="ROM 3:11">कोयी परमेश्वर ख ढूंढन वालो नहाय।<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />सब परमेश्वर सी भटक गयो हंय,</para>
  <para style="q2" vid="ROM 3:12">सब को सब निकम्मो बन गयो हंय;</para>
  <para style="q2" vid="ROM 3:12">कोयी भलायी करन वालो नहाय, एक भी नहाय।<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />उन्को शब्द दु:ख दायक खुल्यो हुयो कब्र जसो हय,</para>
  <para style="q2" vid="ROM 3:13">उन्न अपनी जीबली सी छल करयो हय,</para>
  <para style="q2" vid="ROM 3:13">उन्को होठों सांपो को जहेर जसो हय।<verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />उन्को मुंह श्राप अऊर कड़वाहट सी भरयो हय।<verse eid="ROM 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 3:15" />ओको पाय खून बहावन ख फुर्तीलो हंय,<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />ओको रस्ता म नाश अऊर कठिनायी हय।<verse eid="ROM 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 3:17" />उन्न शान्ति को रस्ता नहीं जान्यो।<verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />उन्की आंखी को आगु परमेश्वर को आदर नहाय।<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />हम जानजे हय कि व्यवस्था जो कुछ कह्य हय उन्को सीच कह्य हय, जो व्यवस्था को अधीन हंय; येकोलायी कि हर एक मुंह बन्द करयो जाये अऊर पूरो जगत परमेश्वर को न्याय को लायक हंय; <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" /><note caller="+" style="x"><char style="xo" closed="false">३:२० </char><char style="xt" closed="false"><ref loc="GAL 2:16">गलातियों २:१६</ref></char></note>कहालीकि व्यवस्था को कामों सी कोयी आदमी परमेश्वर को आगु सच्चो नहीं ठहरे, येकोलायी कि व्यवस्था को द्वारा पाप की पहिचान होवय हय।<verse eid="ROM 3:20" /></para>
  <para style="s">विश्वास द्वारा सच्चायी</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />पर अब व्यवस्था सी अलग परमेश्वर की ऊ सच्चायी प्रगट भयी हय, जेकी गवाही मूसा की व्यवस्था अऊर भविष्यवक्ता देवय हंय, <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" /><note caller="+" style="x"><char style="xo" closed="false">३:२२ </char><char style="xt" closed="false"><ref loc="GAL 2:16">गलातियों २:१६</ref></char></note>मतलब परमेश्वर की ऊ सच्चायी जो यीशु मसीह पर विश्वास करन सी मिलय हय ऊ सब लोगों लायी हय। कहालीकि येको म कुछ भेद भाव नहाय; <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />येकोलायी कि सब न पाप करयो हय अऊर परमेश्वर की महिमा सी दूर होय गयो हंय, <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />पर ओको अनुग्रह सी ऊ छुटकारा को द्वारा जो मसीह यीशु म हय, सब को सब सच्चो ठहरायो जावय हंय। <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />यीशु ख परमेश्वर न ओको खून म विश्वास को द्वारा असो जेको द्वारा लोगों की पापों की माफी होवय हय ऊ बली ठहरायो, जो विश्वास करन सी कार्यकारी होवय हय, कि जो पाप पहिले करयो गयो अऊर जिन पर परमेश्वर न अपनी सहनशीलता को वजह ध्यान नहीं दियो। उन्को बारे म ऊ अपनी सच्चायी प्रगट करे। <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />बल्की योच समय ओकी सच्चायी प्रगट हो कि जेकोसी ऊ खुदच सच्चो ठहरे, अऊर जो यीशु पर विश्वास करे ओको भी सच्चो ठहरान वालो हो।<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />त घमण्ड कित हय? घमण्ड करन को वजह का हय? ओको पालन करनो का ऊ यो आय? नहीं, पर ओको पर विश्वास करनो। <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />येकोलायी हम यो परिनाम पर पहुंचजे हंय कि आदमी व्यवस्था को कामों सी अलगच, विश्वास को द्वारा सच्चो ठहरय हय। <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />या परमेश्वर केवल यहूदियों कोच आय? का गैरयहूदियों को नहीं? हव, निश्चितच गैरयहूदियों को भी आय। <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" /><note caller="+" style="x"><char style="xo" closed="false">३:३० </char><char style="xt" closed="false"><ref loc="GAL 3:20">गलातियों ३:२०</ref></char></note>कहालीकि एकच परमेश्वर हय, यहूदियों ख विश्वास सी अऊर गैरयहूदियों ख भी विश्वास को द्वारा सच्चो ठहरायेंन। <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />त का हम व्यवस्था ख विश्वास को द्वारा बेकार ठहराजे हंय? बिल्कुल नहीं! बल्की व्यवस्था ख बनायो रहजे हंय।<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">अब्राहम को उदाहरन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />येकोलायी हम का कहबो हमरो बुजूर्ग अब्राहम ख का मिल्यो? <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />कहालीकि यदि अब्राहम कामों सी सच्चो ठहरायो जातो, त ओख घमण्ड करन कि जागा होती, पर परमेश्वर की नजर म नहीं। <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" /><note caller="+" style="x"><char style="xo" closed="false">४:३ </char><char style="xt" closed="false"><ref loc="GAL 3:6">गलातियों ३:६</ref></char></note>पवित्र शास्त्र का कह्य हय? यो कि “अब्राहम न परमेश्वर पर विश्वास करयो, अऊर ओको विश्वास को वजह परमेश्वर न सच्चो स्वीकार करयो।” <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />काम करन वालो की मजूरी देनो दान नहाय, पर हक्क समझ्यो जावय हय। <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />पर जो विश्वास पर निर्भर रह्य हय, नहीं कि कामों पर अऊर परमेश्वर पर विश्वास करय हय, जो परमेश्वर अभक्तिहीन ख भक्तिहीन बनावय हय अऊर ओको योच परमेश्वर पर को विश्वास सी परमेश्वर ओख सच्चो ठहरावय हय। <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />जेक परमेश्वर बिना कर्मों को सच्चो ठहरावय हय, ओख दाऊद भी धन्य कह्य हय:<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />“धन्य हंय हि जिन्को अपराध माफ भयो,</para>
  <para style="q2" vid="ROM 4:7">अऊर जिन्को पाप झाक्यो गयो।<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />धन्य हय ऊ आदमी जेक परमेश्वर पापी</para>
  <para style="q3" vid="ROM 4:8">नहीं ठहराये!”<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />जो धन्य होन की बात दाऊद कह्य रह्यो हय, का यहूदी लायी हय नहीं पर यो बिना गैरयहूदी लायी भी हय जसो हम वचन म सुनजे हय यो कहजे हंय, “अब्राहम न परमेश्वर पर विश्वास करयो अऊर ओको विश्वास को वजह परमेश्वर न ओख सच्चो स्वीकार करयो।” <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />त यो कब भयो? का जब ओको खतना होय गयो होतो यां जब ऊ बिना खतना को होतो? नहीं खतना होन को बाद नहीं पर खतना होन सी पहिले भयो। <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />अऊर ओको खतना बाद म भयो होतो अऊर खतना होनो ऊ एक चिन्ह बन्यो ताकि दर्शा सके कि परमेश्वर न ओको खतना होनो सी पहिलेच ओको विश्वास को द्वारा सच्चो स्वीकार करयो अऊर अब्राहम सब विश्वासियों आत्मिक बाप बन्यो यद्दपि ऊ बिना खतना को हय पर विश्वास हय येकोलायी ऊ भी सच्चो स्वीकार करयो जायेंन। <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />अऊर ऊ उन्को भी बाप हय जिन्को खतना भयो हय ताकी ऊ लोग केवल खतना भयो वालोच नहीं होतो, बल्की हमरो बाप अब्राहम को विश्वास को पद चिन्हों पर चलन वालो होतो ऊ अब्राहम जो खतना होनो सी पहिलो चल्यो।<verse eid="ROM 4:12" /></para>
  <para style="s">विश्वास को द्वारा प्रतिज्ञा को मिलनो</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 4:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१३ </char>
      <char style="xt" closed="false">
        <ref loc="GAL 3:29">गलातियों ३:२९</ref>
      </char>
    </note>जब परमेश्वर न अब्राहम सी अऊर ओको वंश सी प्रतिज्ञा की ऊ जगत को वारिस होयेंन, या प्रतिज्ञा अब्राहम ख व्यवस्था को पालन सीच नहीं मिल्यो पर ओन विश्वास करयो अऊर ऊ परमेश्वर को द्वारा सच्चो स्वीकार करयो गयो यो वजह मिल्यो। <verse eid="ROM 4:13" /><verse number="14" style="v" sid="ROM 4:14" /><note caller="+" style="x"><char style="xo" closed="false">४:१४ </char><char style="xt" closed="false"><ref loc="GAL 3:18">गलातियों ३:१८</ref></char></note>अऊर येकोलायी यदि आप मानय हो कि परमेश्वर न दियो भयो प्रतिज्ञा या व्यवस्था को पालन करन वालो को वजह मिल्यो त तुम्हरो विश्वास बेकार हय अऊर परमेश्वर की प्रतिज्ञा भी बेकार होय जावय हय। <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />व्यवस्था सी परमेश्वर को गुस्सा प्रगट होवय हय, पर, जित व्यवस्था नहाय उत ओको उल्लंघन नहाय।<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१६ </char>
      <char style="xt" closed="false">
        <ref loc="GAL 3:7">गलातियों ३:७</ref>
      </char>
    </note>योच वजह प्रतिज्ञा विश्वास पर आधारित हय अऊर या परमेश्वर की मुक्त भेंट आय, पूरो अब्राहम को वंशजों लायी, न केवल ओको लायी जो व्यवस्था वालो हय बल्की उन्को लायी भी जो अब्राहम को जसो विश्वास वालो हंय; कहालीकि अब्राहम हम सब को आत्मिक बाप आय, <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />जसो शास्त्र म लिख्यो हय, “मय न तोख बहुत सी राष्ट्रों को बाप ठहरायो हय” अऊर या प्रतिज्ञा परमेश्वर कि नजर म ठीक हय, यो ऊ परमेश्वर हय जेको पर अब्राहम न विश्वास करयो, अऊर जो मरयो हुयो ख जीन्दो करय हय, अऊर जो परमेश्वर अस्तित्व रहित बातों सी प्रगट करय हय। <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />जसो शास्त्र म लिख्यो हय ऊ तय बहुत सी राष्ट्रों को बाप होयेंन “तोरो वंश तारों को जसो होयेंन या बात पर आशा रखन को कोयी वजह नहीं होतो फिर भी अब्राहम न विश्वास अऊर आशा रखेंन। <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />कहालीकि ऊ लगभग सौ साल को होय गयो होतो, पर ओको विश्वास ओको शरीर को जसो कमजोर नहीं भयो होतो, जसो की ओको शरीर लगभग मरयो हुयो होय चुक्यो होतो, अऊर सच्चायी त यो भी हय, सारा को गर्भ भी बच्चां ख जनम नहीं दे सकत होती। <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />तब भी ओन अपनो विश्वास ख नहीं छोड़्यो अऊर न परमेश्वर की प्रतिज्ञा पर शक करयो, ओको विश्वास न सामर्थ सी भरयो अऊर ओन परमेश्वर की महिमा करी; <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />अऊर ओख पूरो भरोसा हय कि जो बात की परमेश्वर न प्रतिज्ञा करी हय, ऊ ओख पूरो करन म भी समर्थ हय। <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />यो वजह परमेश्वर न अब्राहम ख ओको विश्वास को द्वारा ओख सच्चो स्वीकार करयो। <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />अऊर यो वचन, विश्वास को द्वारा सच्चो स्वीकार करनो” केवल ऊ अकेलो लायी नहीं लिख्यो गयो, <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />यो बल्की हमरो लायी भी लिख्यो गयो, जो हम सच्चो ठहरायो गयो, जो हम यीशु पर विश्वास करय हंय जो हमरो प्रभु जो मृत्यु म सी जीन्दो भयो ओको पर विश्वास करजे हय। <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />कहालीकि ऊ हमरो पापों को वजह सौंप्यो गयो, अऊर हम्ख परमेश्वर को संग सच्चो ठहरान लायी मृत्यु म सी जीन्दो भयो।<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">परमेश्वर सी मेल-मिलाप</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />येकोलायी जब हम विश्वास को वजह परमेश्वर को आगु सच्चो भय गयो हय हमरो प्रभु यीशु मसीह को वजह परमेश्वर हमरो बीच शान्ति प्राप्त भयी हय, <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />अब ओको को द्वारा विश्वास को वजह हम परमेश्वर को अनुग्रह म जीवन जीवय हय। अऊर हम ओको आशा पर घमण्ड करय हय जो आशा परमेश्वर की महिमा को संग भागिदार भयो हय। <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />इतनोच नहीं हमरो मुसीबत पर भी केवल योच नहीं, बल्की हम कठिनायियों म भी घमण्ड करे, यो जान क कि कठिनायी सी धीरज, <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />अऊर धीरज सी परख्यो भयो चरित्र बनय हय, अऊर परख्यो हुयो चरित्र सी आशा निकलय हय; <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />अऊर या आशा हम्ख नाराज नहीं करय, कहालीकि परमेश्वर न ओको प्रेम हमरो दिल म डाल्यो गयो हय। बल्की पवित्र आत्मा को द्वारा जो परमेश्वर को प्रेम हमरो मन म डाल्यो गयो हय।<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />कहालीकि जब हम आशाहीन होतो, त ठीक समय पर हम भक्तिहीनों लायी मसीह न अपनो बलिदान दियो। <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />कोयी सच्चो जान को लायी कोयी मरे, यो त दुर्लभ हय; पर होय सकय हय कोयी भलो आदमी को लायी कोयी मरन को भी हिम्मत करे। <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />पर परमेश्वर हम पर अपनो प्रेम की अच्छायी यो रीति सी प्रगट करय हय कि जब हम पापीच होतो तब भी मसीह हमरो लायी मरयो। <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />येकोलायी जब कि हम अब ओको खून को वजह सच्चो ठहरेंन, त ओको द्वारा परमेश्वर को गुस्सा सी कहाली न बचायो जायेंन? <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />जब हम परमेश्वर को दुश्मन होतो पर परमेश्वर न अपनो बेटा को मृत्यु को द्वारा हमरो संग मेल-मिलाप करयो। अऊर जब हम परमेश्वर को संगी हय त मसीह को जीवन द्वारा बहुत जादा हमरो उद्धार करेंन <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />केवल योच नहीं, पर हम अपनो प्रभु यीशु मसीह सी, हमरो परमेश्वर को संग मेल-मिलाप हुयो हय, परमेश्वर म खुश होवय हंय।<verse eid="ROM 5:11" /></para>
  <para style="s">आदम द्वारा मरनो मसीह द्वारा जीवन</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />येकोलायी जसो एक आदमी को द्वारा पाप जगत म आयो, अऊर पाप को द्वारा मृत्यु आयी, अऊर यो रीति सी मृत्यु सब आदमियों म फैल गयी, कहालीकि सब न पाप करयो। <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />जब व्यवस्था को दियो जान पहिलो पाप जगत म होतो, पर जित व्यवस्था नहीं उत पाप गिन्यो नहीं जावय। <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />पर आदम सी ले क मूसा तक मृत्यु न उन लोगों पर भी राज्य करयो, जब की उन लोगों न आदम जसो को पाप नहीं करयो फिर भी मृत्यु न राज्य करयो, जो ऊ आवन वालो को नमुना आय, की अपराध को जसो पाप नहीं करयो। <verse eid="ROM 5:14" /><verse number="15" style="v" sid="ROM 5:15" />पर जसो अपराध की दशा हय, वसो अनुग्रह को वरदान की नहीं, कहालीकि जब एक आदमी को अपराध सी बहुत लोग मरयो, त परमेश्वर को अनुग्रह अऊर ओको जो दान एक आदमी को, मतलब यीशु मसीह को, अनुग्रह सी भयो बहुत सो लोगों की भलायी लायी कितनो कुछ अऊर बहुत हय। <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />अऊर परमेश्वर को भेंट अऊर एक आदमी को पाप इन दोयी म फरक हय। फिर एक पाप को वजह दोष को न्याय आयो, पर बहुत पूरो पापों को बाद अऊर अपराधी होन को जेको हम लायक नहीं होतो ऊ भेंट आयो। <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />कहालीकि जब एक आदमी को अपराध को वजह मृत्यु न ऊ एकच को द्वारा राज्य करयो, त जो लोग अनुग्रह अऊर धर्मरूपी वरदान बहुतायत सी पावय हंय ऊ एकच आदमी को, मतलब यीशु मसीह को द्वारा जरूरच अनन्त जीवन म राज्य करे।<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />येकोलायी जसो एक अपराध सब आदमियों लायी सजा की आज्ञा को वजह भयो, वसोच एक सच्च को काम भी सब लोगों ख मुक्त करय हय अऊर जीवन देवय हंय। <verse eid="ROM 5:18" /><verse number="19" style="v" sid="ROM 5:19" />कहालीकि जसो एक आदमी को आज्ञा न मानन सी बहुत लोग पापी ठहरयो वसोच एक आदमी को आज्ञा मानन को वजह सब लोग परमेश्वर आगु सच्चो ठहरायो जायेंन।<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />व्यवस्था को परिचय येकोलायी भयो कि अपराध बढ़ पाये, पर जित पाप बढ़्यो उत परमेश्वर को अनुग्रह अऊर भी जादा भयो, <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />कि जसो पाप न मृत्यु को द्वारा फैलातो हुयो राज्य करयो, वसोच हमरो प्रभु यीशु मसीह को द्वारा अनुग्रह भी अनन्त जीवन को लायी सच्च को द्वारा ठहरातो हुयो राज्य करे।<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">पाप को लायी मृतक: मसीह म जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />त का हम लगातार पाप करतो रहबो? का हम पाप करतो रहबो कि अनुग्रह बहुत हो? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />कभी नहीं! हम जब पाप लायी मर गयो त फिर येको आगु ओको म कसो जीवन बितायबो? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />का तुम नहीं जानय कि हम सब जिन्न मसीह यीशु म बपतिस्मा लियो, ओकी मरन की एकता म बपतिस्मा लियो। <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" /><note caller="+" style="x"><char style="xo" closed="false">६:४ </char><char style="xt" closed="false"><ref loc="COL 2:12">कुलुस्सियों २:१२</ref></char></note>यानेकि ऊ मृत्यु को बपतिस्मा पान सी हम ओको संग गाड़्यो गयो, ताकि जसो मसीह बाप की महिमा को द्वारा मरयो हुयो म सी जीन्दो करयो गयो, वसोच हम भी एक नयो जीवन पाये।<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />कहालीकि यदि हम ओकी मृत्यु की समानता म ओको संग जुट गयो हंय, त निश्चित ओको जीन्दो होन कि समानता म भी जुट जाबोंन। <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />हम जानजे हंय कि हमरो पुरानो मनुष्यत्व ओको संग क्रूस पर चढ़ायो गयो ताकि पाप को शरीर बेकार हो जाय, अऊर हम आगु पाप को सेवक मत बनो। <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />कहालीकि जो मर गयो, ऊ पाप को बन्धन सी मुक्त भय गयो। <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />येकोलायी यदि हम मसीह को संग मर गयो, त हमरो विश्वास यो हय कि ओको संग जाबोंन भी। <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />कहालीकि यो जानजे हंय कि मसीह मरयो हुयो म सी जीन्दो होय क फिर सी मरन को नहीं; ओको पर फिर मृत्यु को वश कभी नहीं चलेंन। <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />अऊर ऊ मर गयो ओको पर पाप को बन्धन नहीं हय अऊर अब ऊ परमेश्वर को संग ओको जीवन जीवय हय। <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />असोच तुम भी अपनो बारे म समझो की पाप लायी त मरयो हय, पर यीशु मसीह म परमेश्वर को संग जीन्दो हय।<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />येकोलायी पाप तुम्हरो नाशवान शरीर म राज्य नहीं करे, कि तुम ओकी इच्छावों को अधीन रहो; <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />अपनो शरीर को अंगों ख अधर्म की सेवा लायी पाप को हाथों म नहीं करो। पर मरयो हुयो म सी जीन्दो होन को जसो परमेश्वर को सौंप देवो, अऊर अपनो शरीर को अंगों ख सच्चायी की सेवा को साधन को रूप म परमेश्वर ख सौंप देवो। <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />तब तुम पर पाप की प्रभुता नहीं होयेंन, कहालीकि तुम व्यवस्था को अधीन नहीं बल्की परमेश्वर को अनुग्रह को अधीन हो।<verse eid="ROM 6:14" /></para>
  <para style="s">सच्चायी को सेवक</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />त हम का करबो? का हम पाप करबो कहालीकि हम व्यवस्था को अधीन नहाय बल्की परमेश्वर को अनुग्रह को अधीन जीवय हंय? कभीच नहीं! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />का तुम नहीं जानय कि जेकी आज्ञा मानन लायी तुम अपनो आप ख सेवकों को जसो सौंप देवय हय ओकोच सेवक हो: चाहे पाप को, जेको अन्त मृत्यु हय, चाहे आज्ञाकारिता को, जेको अन्त सच्चायी हय? <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />पर परमेश्वर को धन्यवाद हो कि एक समय पाप को सेवक होतो अब मन सी ऊ उपदेश को तुम न अपनो दिल म स्वीकार करयो, जेको साचा म ढाल्यो गयो होतो, <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />अऊर तुम पाप सी छुड़ायो जाय क सच्चायी को सेवक बन गयो। <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />मय तुम्हरी शारीरिक कमजोरी को वजह आदमियों की रीति पर कहू हय। जसो तुम न अपनो अंगों ख अपवित्रता अऊर व्यवस्था को दुष्ट पन को आगु सेवक कर क् सौंप्यो होतो, वसोच अब अपनो अंगों ख पवित्रता लायी सच्चायी को अधिन सेवक कर क् सौंप देवो।<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />जब तुम पाप को सेवक होतो, त सच्चायी को तरफ सी स्वतंत्र होतो। <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />येकोलायी जिन बातों सी अब तुम, लज्जित होवय हय, उन्को सी ऊ समय तुम का फर पात होतो? कहालीकि उन्को अन्त त मृत्यु हय। <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />पर अब पाप सी स्वतंत्र होय क अऊर परमेश्वर को सेवक बन क तुम ख फर मिल्यो जेकोसी पवित्रता प्राप्त होवय हय, अऊर ओको अन्त अनन्त जीवन हय। <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />कहालीकि पाप की मजूरी त मृत्यु हय, पर हमरो परमेश्वर की भेंट प्रभु मसीह यीशु म अनन्त जीवन हय।<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">बिहाव जीवन को उदाहरन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />हे भाऊवों-बहिनों, का तुम नहीं जानय मय व्यवस्था को जानन वालो सी कहू हय कि जब तक आदमी जीन्दो रह्य हय, तब तक ओको पर व्यवस्था की प्रभुता रह्य हय? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />उदाहरन लायी एक बिहाव वाली बाई व्यवस्था को अनुसार अपनो पति को संग व्यवस्था को अनुसार तब तक बन्धी हय, जब तक वा जीन्दी हय, पर यदि ओको पति मर जावय हय त बिहाव सम्बन्धी व्यवस्था सी मुक्त होय जावय हय। <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />येकोलायी यदि पति को जीतो-जी वा कोयी दूसरों आदमी की होय जाये, त व्यभिचारिनी कहलायेंन, यदि पति मर जाये, त वा ऊ व्यवस्था सी छूट गयी, यहां तक कि यदि कोयी दूसरों आदमी की होय जाये तब व्यभिचारिनी नहीं ठहरेंन। <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />वसोच हे मोरो भाऊवों-बहिनों, तुम भी मसीह को शरीर को द्वारा व्यवस्था को लायी मरयो हुयो बन गयो हय, कि ऊ दूसरों को होय जावो, जो मरयो हुयो म सी जीन्दो भयो: ताकि हम परमेश्वर को लायी फर लायबो। <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />कहालीकि जब हम शारीरिक स्वभाव को अधीन होतो, त पापों की अभिलासाये जो व्यवस्था को द्वारा होती, मृत्यु को फर पैदा करन को लायी हमरो अंगों म काम करत होती। <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />पर जेको बन्धन म हम होतो ओको लायी मर क, अब व्यवस्था सी असो छूट गयो, कि लेख की पुरानी रीति पर नहीं, बल्की आत्मा की नयी रीति पर सेवा करय हंय।<verse eid="ROM 7:6" /></para>
  <para style="s">व्यवस्था अऊर पाप</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />त हम का कहबो? का व्यवस्था पाप हय? कभीच नहीं! बल्की बिना व्यवस्था को मय पाप ख नहीं पहिचानू: व्यवस्था यदि नहीं कहती, कि लालच मत कर त मय लालच ख नहीं जानतो। <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />पर पाप न मौका मिल्तोच आज्ञा को द्वार मोरो म सब तरह को लालच पैदा करयो, कहालीकि बिना व्यवस्था पाप मरयो हुयो हय। <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />मय त व्यवस्था बिना पहिले जीन्दो होतो, पर जब आज्ञा आयी, त पाप जीन्दो भयो, अऊर मय मर गयो। <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />अऊर वाच आज्ञा जो जीवन लान लायी होती, मोरो लायी मरन को वजह बनी। <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />कहालीकि पाप न मौका मिल्तोच आज्ञा को द्वारा मोख बहकायो, अऊर ओकोच द्वारा मोख मार भी डाल्यो।<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />
    <note caller="+" style="f">
      <char style="fr" closed="false">७:१२ </char>
      <char style="ft" closed="false">कुछ पुरानो दस्तावेजों म यो वचन मिलय नहाय</char>
    </note>येकोलायी व्यवस्था पवित्र हय, अऊर आज्ञा भी उचित अऊर अच्छी हय। <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />त का ऊ जो अच्छी होती, मोरो लायी मृत्यु ठहरी? कभीच नहीं! पर पाप ऊ अच्छी चिज को द्वारा मोरो लायी मृत्यु ख पैदा करन वालो भयो कि ओको पाप दिख जाये, अऊर आज्ञा को द्वारा पाप बहुतच पापमय ठहरे।<verse eid="ROM 7:13" /></para>
  <para style="s">आदमी को अन्दर लड़ाई</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />हम जानजे हंय कि व्यवस्था त आत्मिक हय, पर मय शारीरिक अऊर पाप को हाथ म बिक्यो हुयो हय। <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" /><note caller="+" style="x"><char style="xo" closed="false">७:१५ </char><char style="xt" closed="false"><ref loc="GAL 5:17">गलातियों ५:१७</ref></char></note>जो मय कहू हय ओख नहीं जानु; कहालीकि जो मय चाहऊ हय ऊ नहीं करू, पर जेकोसी मोख घृना आवय हय उच करू हय। <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />यदि जो मय नहीं चाहऊ उच करू हय, त मय नाम लेऊ हय कि व्यवस्था ठीक हय। <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />त असी दशा म ओको करन वालो मय नहीं, बल्की पाप हय जो मोरो म बस्यो हुयो हय। <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />कहालीकि मय जानु हय कि मोरो म मतलब मोरो शरीर म कोयी अच्छी चिज वाश नहीं करय। इच्छा त मोरो म हय, पर भलो काम मोरो सी बन नहीं सकय। <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />कहालीकि जो अच्छो काम को मय इच्छा करू हय, ऊ त नहीं करय, पर जो बुरायी कि इच्छा नहीं करय, उच करू हय। <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />अब भी यदि मय उच करू हय जेकी इच्छा नहीं करू, त ओको करन वालो मय नहीं रहू, पर पाप जो मोरो म बस्यो हुयो हय।<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />यो तरह मय यो नियम पाऊ हय कि जब भलायी करन की इच्छा करू हय, त बुरायी खच पाऊ हय। <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />कहालीकि मय अन्दर की अन्तर आत्मा सी त परमेश्वर की व्यवस्था सी बहुत खुश रहू हय। <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />पर मोख अपनो शरीर म दूसरों तरह को नियम दिखायी देवय हय, जो मोरी बुद्धी की व्यवस्था सी लड़य हय अऊर मोख पाप को नियम को बन्धन म डालय हय जो मोरो शरीर म हय। <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />मय कसो दु:खी आदमी आय! मोख यो मृत्यु को शरीर सी कौन छुड़ायेंन? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />जो हम्ख छुटकारा देवय हय ओको प्रभु यीशु मसीह को द्वारा मय परमेश्वर को धन्यवाद हो।</para>
  <para style="p" vid="ROM 7:25">येको तरह बुद्धी सी परमेश्वर को नियम को, पर शरीर सी पाप को नियम को पालन करू हय।<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">पवित्र आत्मा को द्वारा जीवन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />अब भी जो मसीह यीशु म जीवन जीवय हंय, उन पर सजा की आज्ञा नहीं। <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />कहालीकि जीवन की आत्मा की व्यवस्था न मसीह यीशु म हम्ख पाप की अऊर मृत्यु की व्यवस्था सी स्वतंत्र कर दियो। <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />कहालीकि जो काम व्यवस्था शरीर को वजह दुर्बल होय क नहीं कर सकी, ओख परमेश्वर न करयो, मतलब अपनोच बेटा ख पापमय शरीर की समानता म अऊर पापबलि होन को लायी भेज क, शरीर म पाप पर सजा की आज्ञा दियो। <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />येकोलायी कि व्यवस्था को नियम हम म जो शरीर को अनुसार नहीं बल्की आत्मा को अनुसार चलय हंय, पूरी करी जाये। <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />कहालीकि जो शारीरिक लोग शरीर की बातों पर मन लगावय हंय, पर जो आत्मिक आत्मा की बातों पर मन लगावय हंय। <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />शरीर पर मन लगानो त मरन हय, पर आत्मा पर मन लगानो जीवन अऊर शान्ति हय; <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />कहालीकि शरीर पर मन लगानो त परमेश्वर सी दुस्मनी रखनो हय, कहालीकि नहीं त परमेश्वर की व्यवस्था को अधीन हय अऊर नहीं होय सकय हय; <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />कहालीकि जो पापपूर्न स्वभाव म जीवय हंय, हि परमेश्वर ख खुश नहीं कर सकय।<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />पर जब कि परमेश्वर को आत्मा तुम म बसय हय; त तुम शारीरिक दशा म नहीं, पर आत्मिक दशा म हो। यदि कोयी म मसीह को आत्मा नहीं त ऊ ओको लोग नहीं। <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />यदि मसीह तुम म हय, त शरीर पाप को वजह मरी हुयी हय; पर आत्मा सच्चायी को जीन्दी हय। <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" /><note caller="+" style="x"><char style="xo" closed="false">८:११ </char><char style="xt" closed="false"><ref loc="1CO 3:16">१ कुरिन्थियों ३:१६</ref></char></note>यदि ओकोच आत्मा जेन यीशु ख मरयो हुयो सी जीन्दो करयो, तुम म बस्यो हुयो हय, त जेन मसीह ख मरयो हुयो सी जीन्दो करयो, ऊ तुम्हरी मरयो हुयो शरीरों ख भी अपनो आत्मा को द्वारा जो तुम म बस्यो हुयो हय, जीन्दो करेंन।<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />येकोलायी हे भाऊवों-बहिनों, हम भौतिक शरीर को कर्जदार त हंय पर येको यो मतलब नहीं कि शरीर को अनुसार दिन काटे, <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />कहालीकि यदि तुम शरीर को अनुसार दिन काटो त मरो, यदि आत्मा सी शरीर की कामों ख मारो त जीन्दो रहो। <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />येकोलायी कि जितनो लोग परमेश्वर को आत्मा को चलायो चलय हंय, हिच परमेश्वर को सन्तान आय। <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" /><note caller="+" style="x"><char style="xo" closed="false">८:१५ </char><char style="xt" closed="false"><ref loc="MRK 14:36">मरकुस १४:३६</ref>; <ref loc="GAL 4:6">गलातियों ४:६</ref>; <ref loc="GAL 4:5-7">गलातियों ४:५-७</ref></char></note>कहालीकि तुम ख गुलाम बनावन वाली आत्मा नहीं मिली कि डरो, पर परमेश्वर की सन्तान की आत्मा मिली हय, जेकोसी हम हे अब्बा, हे पिता कह्य क पुकारजे हंय। <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />परमेश्वर कि आत्मा खुदच हमरी आत्मा को संग गवाही देवय हय, कि हम परमेश्वर की सन्तान आय; <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />अऊर यदि सन्तान हंय त वारिस भी, बल्की परमेश्वर को वारिस अऊर मसीह को संगी वारिस हंय, कि जब हम ओको संग दु:ख उठाये त ओको संग महिमा भी पाये।<verse eid="ROM 8:17" /></para>
  <para style="s">भविष्य म प्रगट होन वाली महिमा</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />कहालीकि मय समझू हय कि यो समय को दु:ख अऊर कठिनायी ऊ महिमा को आगु, जो हम पर प्रगट होन वाली हय, कुछ भी नहाय। <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />कहालीकि सृष्टि बड़ी आशाभरी नजर सी परमेश्वर को बेटों को प्रगट होन की बाट देख रही हय। <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />कहालीकि सृष्टि अपनी इच्छा सी नहीं, पर अधीन करन वालो को तरफ सी बेकार को अधीन या आशा सी करी गयी। <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />कि सृष्टि भी खुदच विनाश को गुलामी सी छुटकारा पा क, परमेश्वर की सन्तानों की महिमा की स्वतंत्रता प्राप्त करे। <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />कहालीकि हम जानजे हंय कि पूरी सृष्टि अब तक मिल क कराहती अऊर तकलिफों म पड़ी तड़पय हय; <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" /><note caller="+" style="x"><char style="xo" closed="false">८:२३ </char><char style="xt" closed="false"><ref loc="2CO 5:2-4">२ कुरिन्थियों ५:२-४</ref></char></note>अऊर केवल उच नहीं पर हम भी जिन्को जवर आत्मा को पहिलो फर हय, खुदच करहावय हंय; अऊर अपनायो हुयो बेटा होन को, मतलब अपनो शरीर को छुटकारा की बाट देखय हंय। <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />या आशा को द्वारा हमरो उद्धार भयो हय; पर जो चिज की आशा करी जावय हय, जब ऊ देखनो म आयो त फिर आशा कित रही? कहालीकि जो चिज ख कोयी देख रह्यो हय ओकी आशा का करेंन? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />पर जो चिज ख हम नहीं देखजे, यदि ओकी आशा रखजे हंय, त धीरज सी ओकी बाट देखजे भी हंय।<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />योच रीति सी आत्मा भी हमरी कमजोरी म मदत करय हय: कहालीकि हम नहीं जानजे कि प्रार्थना कौन्सो रीति सी करनो चाहिये, पर आत्मा खुदच असी आह भर क, जो बयान सी बाहेर हंय, हमरो लायी बिनती करय हय; <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />अऊर परमेश्वर हमरो दिल देखय हय? कहालीकि ऊ पवित्र लोगों लायी कहालीकि आत्मा परमेश्वर की इच्छा को अनुसार बिनती करय हय।<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />हम जानजे हंय कि जो लोग परमेश्वर सी प्रेम रखय हंय, उन्को लायी सब बाते मिल क भलायीच ख पैदा करय हंय; मतलब उन्कोच लायी जो ओकी इच्छा को अनुसार बुलायो हुयो हंय। <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />कहालीकि जिन्ख ओन पहिले सी जान लियो हय उन्ख पहिले सी ठहरायो भी हय कि ओको बेटा को समानता म हो, ताकि ऊ बहुत भाऊवों सी पहिलो ठहरे। <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />फिर जिन्ख ओन पहिले सी ठहरायो, उन्ख बुलायो भी; अऊर जिन्ख बुलायो, उन्ख सच्चो भी ठहरायो हय; अऊर जिन्ख सच्चो ठहरायो, उन्ख महिमा भी दियो हय।<verse eid="ROM 8:30" /></para>
  <para style="s">परमेश्वर को प्रेम</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />अब तक हम इन बातों को बारे म का कहबो? यदि परमेश्वर हमरो तरफ हय, त हमरो विरोध कौन होय सकय हय? <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />जेन अपनो बेटा ख नहीं छोड़्यो, पर ओख हम सब को लायी दे दियो, ऊ ओको संग हम्ख अऊर सब कुछ मुक्त कहाली नहीं देयेंन? <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />परमेश्वर को चुन्यो हुयो पर दोष कौन लगायेंन? परमेश्वरच हय जो उन्ख सच्चो ठहरान वालो हय। <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />फिर कौन हय जो सजा की आज्ञा देयेंन? मसीह यीशु हय जो मर गयो बल्की मुर्दों म सी जीन्दो भी भयो, अऊर परमेश्वर को दायो तरफ हय, अऊर हमरो लायी समझौता भी करय हय। <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />कौन हम ख मसीह को प्रेम सी अलग करेंन? का कठिनायी, यां संकट, यां उपद्रव, यां अकाल, यां नंगायी, यां जोखिम, यां तलवार? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />जसो शास्त्र म लिख्यो हय,</para>
  <para style="q1" vid="ROM 8:36">“तोरो लायी हम दिन भर मारयो जाजे हंय;</para>
  <para style="q2" vid="ROM 8:36">हम काट्यो जान वाली मेंढा को जसो समझ्यो जाजे हंय।”<verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />पर इन सब बातों म हम ओको द्वारा जेन हम सी प्रेम करयो हय, पुर्णता सी भी बढ़ क हंय। <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />कहालीकि मय निश्चय जानु हय कि कोयी हम्ख ओको प्रेम सी अलग कर सकय हय, मृत्यु, न जीवन, न स्वर्गदूत, न दुष्ट शासन, न वर्तमान, न भविष्य, न सामर्थ, न ऊचाई, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />न धरती की गहरायी, अऊर न कोयी धरती की ऊचाई अऊर न जगत की कोयी निर्मिती हम्ख परमेश्वर को प्रेम सी जो हमरो प्रभु मसीह यीशु म हय, अलग कर सकेंन।<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="s">परमेश्वर अऊर ओको चुन्यो हुयो लोग</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />मय मसीह म सच कहू हय, मय झूठ नहीं बोल रह्यो अऊर मोरो अन्तरमन भी पवित्र आत्मा म गवाही देवय हय <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />कि मोख बड़ो शोक हय, अऊर मोरो मन सदा दुखय हय, <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />कहालीकि मय यहां तक चाहत होतो कि अपनो भाऊवों को लायी जो शरीर को भाव सी मोरो कुटुम्बी आय, खुदच मसीह सी अलग अऊर परमेश्वर शापित होय जावय। <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />हि इस्राएली आय, अऊर परमेश्वर को सन्तान होन को अधिकार अऊर महिमा अऊर वाचाये अऊर व्यवस्था को उपहार अऊर परमेश्वर को उपासना अऊर प्रतिज्ञाये उन्कोच आय। <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />बुजूर्ग भी उन्कोच आय, अऊर मसीह भी शरीर को भाव सी उन म सी भयो। सब को ऊपर परम परमेश्वर राज्य करय हय, अऊर हमेशा-हमेशा धन्य हय! आमीन।<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />असो नहीं कि परमेश्वर कि अपनो वचन पूरो नहीं करयो हंय, कहालीकि जो इस्राएल को वंश हंय, ऊ सब इस्राएली नोहोय। <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />अऊर न अब्राहम को वंश होन को वजह सब ओकी सन्तान ठहरे, पर पवित्र शास्त्र म लिख्यो हय “इसहाक सीच तोरो वंश कहलायेंन।” <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />मतलब शरीर की सन्तान परमेश्वर की सन्तान नोहोय, पर प्रतिज्ञा की सन्तान वंश गिन्यो जावय हंय। <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />कहालीकि प्रतिज्ञा को वचन यो आय: “मय उच समय को अनुसार आऊं, अऊर सारा को एक बेटा होयेंन।”<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />अऊर केवल योच नहीं, पर जब हमरो बाप इसहाक सी रीबका ख दोय बेटा भयो। <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />पर ओको एक बच्चा ख चुन्यो यो पूरो तरह परमेश्वर को खुद को उद्देश को परिनाम होतो, परमेश्वर न उन्को सी कह्यो, “बड़ो छोटो की सेवा करेंन।” <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />या बात परमेश्वर न उन्को जनम सी पहिलो अऊर उन्को कुछ भलो बुरो करन को पहिलो कहीं; त परमेश्वर की पसंद ओको बुलाहट पर निर्भर हय, न कि उन्न का करयो ओको पर ओन कह्यो, “बड़ो छोटो को सेवक होयेंन।” <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />जसो शास्त्र म लिख्यो हय, “मय न याकूब सी प्रेम करयो, पर एसाव ख अप्रिय जान्यो।”<note caller="+" style="f"><char style="fr" closed="false">९:१३ </char><char style="ft" closed="false">मलाकी १:२-३</char></note><verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />येकोलायी हम का कहबो? का परमेश्वर को यहां अन्याय हय? कभीच नहीं। <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />कहालीकि ऊ मूसा सी कह्य हय, “मय जो कोयी पर दया करयो चाहऊं ओको पर दया करू, अऊर जेको पर तरस खानो चाहऊं, ओको पर तरस खाऊ।” <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />अब भी यो नहीं त चाहन वालो की, नहीं परिश्रम वालो की पर दया करन वालो परमेश्वर पर निर्भर रह्य हय। <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />कहालीकि पवित्र शास्त्र म फिरौन सी कह्यो गयो, “मय न तोख येकोलायी खड़ो करयो हय कि तोरो म अपनी सामर्थ दिखाऊं, अऊर मोरो नाम को प्रचार पूरी धरती पर हो।” निर्गमन <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />येकोलायी ऊ जेक चाहवय हय ओको पर दया करय हय, अऊर जेक चाहवय हय ओख कठोर बनाय देवय हय।<verse eid="ROM 9:18" /></para>
  <para style="s">परमेश्वर को गुस्सा अऊर दया</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />“त फिर तुम म सी कोयी मोख सी कहेंन यदि कोयी असो हय कि काम को नियंत्रन करन वालो परमेश्वर हय त फिर ऊ हम्ख दोष ठहरावय हय? कौन परमेश्वर की इच्छा को विरोध कर सकय हय?” <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />हे आदमी, तय कौन आय जो परमेश्वर को विरोध म बोलय हय? का गढ़ी हुयी चिज गढ़न वालो सी कह्य सकय हय, “तय न मोख असो कहाली बनायो हय?” <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />का कुम्हार ख माटी पर अधिकार नहाय कि एकच लोंदा म सी एक बर्तन आदर को लायी, अऊर दूसरों ख अनादर को लायी बनाये?<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />त येको म कौन सी नवल की बात हय कि परमेश्वर न अपनो गुस्सा दिखावन अऊर अपनी सामर्थ प्रगट करन की इच्छा सी गुस्सा को बर्तनों की, जो विनाश को लायी तैयार करयो गयो होतो, बड़ो धीरज सीच सही; <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />अऊर दया को बर्तनों पर, जिन्ख ओन महिमा को लायी पहिले सी तैयार करयो, अपनो महिमा को धन ख प्रगट करन की इच्छा करी <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />मतलब हम पर जिन्ख ओन नहीं केवल यहूदियों म सी, बल्की गैरयहूदियों म सी भी बुलायो। <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />जसो ऊ होशे की किताब म भी कह्य हय,</para>
  <para style="q1" vid="ROM 9:25">“जो मोरो लोग नहीं होतो,</para>
  <para style="q2" vid="ROM 9:25">उन्ख मय अपनो लोग कहूं;</para>
  <para style="q1" vid="ROM 9:25">अऊर जो प्रिय नहीं होती,</para>
  <para style="q2" vid="ROM 9:25">ओख प्रिय कहूं।<verse eid="ROM 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26" />अऊर असो होयेंन कि जो जागा म उन्को सी यो कह्यो गयो होतो कि तुम मोरो नोहोय,</para>
  <para style="q2" vid="ROM 9:26">उच जागा हि जीन्दो परमेश्वर की सन्तान कहलाबो।”<verse eid="ROM 9:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27" />अऊर यशायाह इस्राएल को बारे म पुकार क कह्य हय, “चाहे इस्राएल की सन्तानों की गिनती समुन्दर को रेतु को बराबर हय, तब भी उन्म सी थोड़ोच बचायो जायेंन। <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />कहालीकि प्रभु अपनो वचन धरती पर पूरो कर क्, जल्दीच ओख सिद्ध करेंन।” <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />जसो यशायाह न पहिले भी कह्यो होतो, “यदि सेनावों को प्रभु हमरो लायी कुछ वंश नहीं छोड़तो, त हम सदोम को जसो होय जातो, अऊर गमोरा को जसोच ठहरतो।”<verse eid="ROM 9:29" /></para>
  <para style="s">इस्राएल को लायी पौलुस की प्रार्थना</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />अब हम का कहबो? यो कि गैरयहूदियों न जो सच्चायी की खोज नहीं करत होतो, सच्चायी ख विश्वास सी प्राप्त मतलब ओन सच्चायी ख जो विश्वास सी हय; <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />पर इस्राएली, जो सच्चायी की व्यवस्था की खोज करत होतो ऊ व्यवस्था तक नहीं पहुंच्यो। <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />कोन्को लायी? येकोलायी कि हि विश्वास सी नहीं, पर मानो कर्मों सी ओकी खोज करत होतो। उन्न ऊ ठेस को गोटा पर ठोकर खायी, <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" /><note caller="+" style="f"><char style="fr" closed="false">९:३३ </char><char style="ft" closed="false">यशायाह ८:१४; २८:१६</char></note>जसो शास्त्र म लिख्यो हय,</para>
  <para style="q1" vid="ROM 9:33">“देखो, मय सिय्योन म एक ठेस लगन को गोटा,</para>
  <para style="q2" vid="ROM 9:33">अऊर ठोकर खान की</para>
  <para style="q2" vid="ROM 9:33">चट्टान रखू हय, अऊर जो ओको</para>
  <para style="q1" vid="ROM 9:33">पर विश्वास करे न ऊ लज्जित नहीं होयेंन।”<verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />हे भाऊवों-बहिनों, मोरो मन की अभिलाषा अऊर ओको लायी परमेश्वर सी मोरी प्रार्थना हय कि हि उद्धार पाये। <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />कहालीकि मय या बात सी निश्चित रह्य हय, कि परमेश्वर की पर उन्की भक्ति उन्को सच्चो ज्ञान पर आधारित नहीं। <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />कहालीकि हि परमेश्वर की सच्चायी सी अनजान होय क, अऊर अपनी सच्चायी स्थापित करन को कोशिश कर क्, परमेश्वर की सच्चायी को अधीन नहीं भयो। <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />मसीह न व्यवस्था को अन्त करयो ताकि हर कोयी जो विश्वास करय हय परमेश्वर को संग सही सम्बन्ध म आवय हंय।<verse eid="ROM 10:4" /></para>
  <para style="s">उद्धार हय सब को लायी</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />सच्चायी ख बारे म जो व्यवस्था सी मिल्यो हय, ओको वर्नन मूसा यो तरह करय हय। जो कोयी व्यवस्था की आज्ञा मानय हय ऊ जीन्दो रहेंन <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />पर जो सच्चायी विश्वास सी हय, ओको बारे शास्त्र यो कह्य हय, “तय अपनो मन म यो मत कहजो कि स्वर्ग पर कौन चढ़ेंन?” मतलब मसीह ख उतार लावन लायी! <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />यां “अधोलोक म कौन उतरेंन?” मतलब मसीह ख मरयो हुयो म सी जीन्दो कर क् ऊपर लावन को लायी! <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />पर यो का कह्य हय? “परमेश्वर को वचन तुम्हरो जवर हय, तोरो मुंह म अऊर तोरो मन म हय,” यो उच विश्वास को वचन आय, जो हम प्रचार करजे हंय, <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />कि यदि तय अपनो मुंह सी यीशु ख प्रभु जान क अंगीकार करे, अऊर अपनो मन सी विश्वास करे कि परमेश्वर न ओख मरयो हुयो म सी जीन्दो करयो, त तय पक्को उद्धार पायजो। <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />कहालीकि सच्चायी को लायी मन सी विश्वास करन सी हम परमेश्वर को संग सही सम्बन्ध म आवय हय; अऊर मुंह सी कबूल करन सी मुक्ति पावय हय। <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />कहालीकि पवित्र शास्त्र यो कह्य हय, “जो कोयी ओको पर विश्वास करेंन ऊ लज्जित नहीं होयेंन।” <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />यहूदियों अऊर गैरयहूदियों म कुछ अन्तर नहाय, येकोलायी कि अऊर ऊ परमेश्वर सब को प्रभु आय अऊर अपनो सब ख बहुतायत सी आशिषित करय हय जो ओको पुकारयो हय। <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />कहालीकि शास्त्र कह्य हय, “जो कोयी प्रभु को मदत को लायी पुकारयो हय ऊ बचायो जायेंन।”<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />फिर जेको पर उन्न विश्वास नहीं करयो, हि ओको कसो पुकारेंन? अऊर जेको बारे म सुन्यो नहीं ओको पर कसो विश्वास करे? अऊर प्रचारक को बिना कसो सुनेंन? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" /><note caller="+" style="f"><char style="fr" closed="false">१०:१५ </char><char style="ft" closed="false">यशायाह ५२:७</char></note>अऊर यदि सन्देश सुनन वालो न भेज्यो नहीं जाये, त कसो प्रचार करेंन? जसो शास्त्र म लिख्यो हय, “उन्को पाय का सुहावनो हंय, जो सुसमाचार ख लावय हय, जो अच्छी बातों को सुसमाचार सुनावय हंय!” <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" /><note caller="+" style="f"><char style="fr" closed="false">१०:१६ </char><char style="ft" closed="false">यशायाह ५३:१</char></note>पर सब न ऊ सुसमाचार पर कान नहीं लगायो: यशायाह कह्य हय, “हे प्रभु, कौन न हमरो सुसमाचार पर विश्वास करयो हय?” <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />अब भी सन्देश ख सुनन सी विश्वास उपजय हय अऊर सन्देश तब सुन्यो जावय हय जब कोयी मसीह को वचन सुन्यो होवय हय।<verse eid="ROM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18" />पर मय कहू हय, का उन्न नहीं सुन्यो? सुन्यो त जरूर हय; कहालीकि शास्त्र म लिख्यो हय,</para>
  <para style="q1" vid="ROM 10:18">“उन्को स्वर पूरी धरती पर,</para>
  <para style="q2" vid="ROM 10:18">अऊर उन्को वचन जगत की छोर तक पहुंच गयो हंय।”<verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />मय फिर कहू हय, का इस्राएली नहीं जानत होतो? पहिले त मूसा कह्य हय,</para>
  <para style="q1" vid="ROM 10:19">“मय उन्को द्वारा जो जाति नहाय,</para>
  <para style="q2" vid="ROM 10:19">तुम्हरो मन म जलन पैदा करू;</para>
  <para style="q1" vid="ROM 10:19">मय एक विश्वासहीन जाति को</para>
  <para style="q2" vid="ROM 10:19">द्वारा तुम्ख गुस्सा दिलाऊं।”<verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />
    <note caller="+" style="f">
      <char style="fr" closed="false">१०:२० </char>
      <char style="ft" closed="false">यशायाह ६५:१</char>
    </note>फिर यशायाह बड़ो हिम्मत को संग कह्य हय,</para>
  <para style="q1" vid="ROM 10:20">“जो मोख नहीं ढूंढत होतो, उन्न मोख पा लियो; अऊर जो मोख पूछत भी नहीं होतो,</para>
  <para style="q2" vid="ROM 10:20">उन पर मय प्रगट भय गयो।”<verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />
    <note caller="+" style="f">
      <char style="fr" closed="false">१०:२१ </char>
      <char style="ft" closed="false">यशायाह ६५:२</char>
    </note>पर मय इस्राएल को बारे म ऊ यो कह्य हय, “मय पूरो दिन अपनो हाथ एक आज्ञा नहीं मानन वाली अऊर विरोध करन वाली प्रजा को तरफ हाथ फैलायो रह्यो।”<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">इस्राएल पर परमेश्वर की दया</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">११:१ </char>
      <char style="xt" closed="false">
        <ref loc="PHP 3:5">फिलिप्पियों ३:५</ref>
      </char>
    </note>येकोलायी मय कहू हय, का परमेश्वर न अपनी प्रजा ख छोड़ दियो? कभीच नहीं! मय भी त इस्राएली आय; अब्राहम को वंश अऊर बिन्यामीन को गोत्र म सी आय। <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />परमेश्वर न अपनी ऊ प्रजा ख नहीं छोड़्यो, जेक ओन पहिले सीच जान्यो। का तुम नहीं जानय कि पवित्र शास्त्र एलिय्याह को बारे म का कह्य हय, जब ऊ इस्राएल को विरोध म परमेश्वर सी बिनती करय हय? <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />“हे प्रभु, उन्न तोरो भविष्यवक्तावों ख मार डाल्यो, अऊर तोरी अर्पन की वेदियों ख गिराय दियो हय; अऊर मयच अकेलो बच्यो हय, अऊर हि मोख मारन लायी ढूंढ रह्यो हंय।” <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />पर परमेश्वर सी ओख का उत्तर मिल्यो? “मय न अपनो लायी सात हजार आदमियों ख रख्यो हय, जिन्न झुटो बाल भगवान को आगु घुटना नहीं टेक्यो हंय।” <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />ठीक योच रीति सी यो समय भी, अनुग्रह सी चुन्यो हुयो कुछ लोग बाकी हंय। <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />यदि यो अनुग्रह सी भयो हय, त फिर कर्मों सी नहीं; नहीं त अनुग्रह फिर अनुग्रह नहीं रह्यो।<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />येकोलायी परिनाम का भयो? यो की इस्राएली जेकी खोज म होतो, ऊ उन्ख नहीं मिल्यो; पर चुन्यो हुयो ख मिल्यो, अऊर बच्यो लोग कठोर करयो गयो। <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />जसो शास्त्र म लिख्यो हय, “परमेश्वर न उन्ख मन अऊर दिल ख भारी नींद म कर दियो हय, अऊर असी आंखी दियो जो नहीं देखय अऊर असो कान जो नहीं सुन्यो।” <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />अऊर दाऊद कह्य हय,</para>
  <para style="q1" vid="ROM 11:9">“उन्को भोजनों म फस क बन्दी बन जाये,</para>
  <para style="q2" vid="ROM 11:9">अऊर ऊ गिरेंन अऊर उन्को पतन होय अऊर सजा मिले।<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />उन्की आंखी पर अन्धारो छाय जाये ताकि नहीं देखे,</para>
  <para style="q2" vid="ROM 11:10">अऊर तय हमेशा उन्की कमर ख झुकायो रख।”<verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />अब भी मय कहू हय का उन्न येकोलायी ठोकर खायी कि गिर जायेंन? कभीच नहीं! पर उन्को गिरन को वजह गैरयहूदियों ख उद्धार मिल्यो, कि उन्ख जलन हो। <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />येकोलायी यदि उन्को गिरनों जगत को लायी धन अऊर उन्की कमी गैरयहूदियों को लायी अच्छो हय, त उन्की भरपूरी सी बहुत बड़ो आशीर्वाद मिलेंन।<verse eid="ROM 11:12" /></para>
  <para style="s">गैरयहूदियों को उद्धार</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />यो अब मय तुम गैरयहूदियों सी कह्य हय। जब तक मय विशेष रूप सी गैरयहूदियों को लायी प्रेरित हय, त मय अपनी सेवा की बड़ायी करू हय, <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />जलन पैदा करवाय क उन्म सी कुछ एक को उद्धार कराऊं। <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />कहालीकि परमेश्वर को द्वारा उन्को अस्वीकार करयो जानो यो परमेश्वर को संग मिल क फिर उन्को अपनायो जानो सी का मरयो हुयो को जीन्दो जानो नहीं होयेंन?<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />जब भेंट को पहिलो पेड़ा पवित्र ठहरयो, त पूरो गूंथ्यो हुयो आटा भी पवित्र हय; अऊर जब झाड़ कि जड़ी पवित्र ठहरी, त ओकी डगाली भी पवित्र ठहरी हंय। <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />पर यदि कुछ डगाली तोड़ दियो गयो, अऊर तय जंगली जैतून होय क ओको म कलम करयो गयो, अऊर जैतून की जड़ी की शक्ति को सहभागी भयो, <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />त डगालियों पर घमण्ड मत करजो; अऊर यदि तय घमण्ड करेंन त याद रख कि तय जड़ी ख नहीं पर जड़ी तोख सम्भाल रही हय।<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />फिर तय कहजो, “डगालियां येकोलायी तोड़ी कि मोरी ओको म कलम करी जाये।” <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />ठीक हय, हि त अविश्वास को वजह तोड़ी गयी, पर तय विश्वास को बन्यो रह्य हय येकोलायी अभिमानी नहीं हो, पर डर मान, <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />कहालीकि जब परमेश्वर न स्वाभाविक डगालियों ख नहीं छोड़्यो त मोख भी नहीं छोड़ेंन। <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />कहालीकि परमेश्वर की कृपा अऊर कठोरता ख देख! जो गिर गयो उन पर कठोरता, पर तोरो पर कृपा, यदि तय ओको म बन्यो रह्यो त ठीक हय, नहीं त तय भी काट डाल्यो जायेंन। <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />यहूदी भी यदि अविश्वास म नहीं रह्य, त झाड़ कलम करयो जायेंन; कहालीकि परमेश्वर सामर्थ हय उन्ख फिर कलम कर सकय हय। <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />कहालीकि यदि गैरयहूदी ओको जैतून सी, जो स्वभाव सी जंगली हय, काट्यो गयो अऊर स्वभाव को विरुद्ध अच्छो जैतून म कलम करयो गयो, त यो जो यहूदी डगाली हंय, अपनोच जैतून म कहाली नहीं कलम करयो जायेंन।<verse eid="ROM 11:24" /></para>
  <para style="s">परमेश्वर सी सब को उद्धार</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />हे भाऊवों अऊर बहिनों, कहीं असो नहीं होय कि तुम अपनो आप ख बुद्धिमान समझ लेवो; येकोलायी मय नहीं चाहऊं कि तुम यो भेद सी अनजान रहो कि जब गैरयहूदियों पूरी रीति सी प्रवेश कर नहीं ले, तब तक हि इस्राएल को एक भाग असोच कठोर रहेंन। <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" /><note caller="+" style="f"><char style="fr" closed="false">११:२६ </char><char style="ft" closed="false">यशायाह ५९:२०-२१</char></note>अऊर यो रीति सी पूरो इस्राएल उद्धार पायेंन। जसो शास्त्र म लिख्यो हय,</para>
  <para style="q1" vid="ROM 11:26">“छुटकारा देनो वालो सिय्योन सी आयेंन,</para>
  <para style="q2" vid="ROM 11:26">अऊर अभक्ति ख याकूब को वंशज सी दूर करेंन;<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />अऊर उन्को संग मोरी योच वाचा बन्धी रहेंन,</para>
  <para style="q2" vid="ROM 11:27">जब कि मय उन्को पापों ख दूर कर देऊ।”<verse eid="ROM 11:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ROM 11:28" />कहालीकि उन्न सुसमाचार अस्वीकार करयो अऊर गैरयहूदियों को वजह यहूदी परमेश्वर को दुश्मन हंय, पर नियुक्त करयो जान को अऊर उन्को बापदादों को वजह परमेश्वर को प्रिय हंय। <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />कहालीकि परमेश्वर कभी नहीं बदलय अऊर ओको चुनाव अऊर आशीषें अटल हय। <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />कहालीकि जसो तुम न पहिले परमेश्वर की आज्ञा नहीं मानी, पर अभी यहूदियों की आज्ञा नहीं मानन सी तुम पर दया भयी; <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />तुम पर जो दया भयी ओको वजह यहूदी अब परमेश्वर की आज्ञा नहीं मान रह्यो हय, येकोलायी अब तुम्हरो जसो उन पर भी दया हो। <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />कहालीकि परमेश्वर न सब ख आज्ञा न मानन को वजह बन्दी बनाय क रख्यो, ताकि ऊ सब पर दया करेंन।<verse eid="ROM 11:32" /></para>
  <para style="s">परमेश्वर की स्तुति</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />आहा! परमेश्वर को धन अऊर बुद्धी अऊर ज्ञान कितनो महान हय! ओको बिचार ख कौन स्पष्ट कर सकय हय, अऊर ओको रस्ता ख कौन समझ सकय हंय!<verse eid="ROM 11:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34" />“शास्त्र कह्य हय की प्रभु को मन कौन जान सकय हय?</para>
  <para style="q2" vid="ROM 11:34">अऊर ओको सल्ला देन सकय हय?<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />का कोयी न परमेश्वर ख कुछ दियो हय जेको बदले म ऊ ओको फिर सी वापस दे?</para>
  <para style="q2" vid="ROM 11:35">जेको बदला म ओख दियो जाये?”<verse eid="ROM 11:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ROM 11:36" />
    <note caller="+" style="x">
      <char style="xo" closed="false">११:३६ </char>
      <char style="xt" closed="false">
        <ref loc="1CO 8:6">१ कुरिन्थियों ८:६</ref>
      </char>
    </note>कहालीकि ओको की तरफ सी, अऊर ओकोच द्वारा, अऊर ओकोच द्वारा अऊर ओकोच लायी सब कुछ हय। परमेश्वर की महिमा हमेशा हमेशा होवय रहे! आमीन।<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">जीवन सी परमेश्वर की सेवा</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />येकोलायी हे भाऊवों अऊर बहिनों, मय परमेश्वर की दया याद दिलाय क बिनती करू हय कि अपनो शरीरों ख जीन्दो, अऊर पवित्र, अऊर परमेश्वर ख भातो हुयो बलिदान कर क् चढ़ावो। योच तुम्हरी सच्चो उपासना हय। <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />यो जगत को जसो मत बनो; पर तुम्हरो मन को नयो पन होय जान सी तुम्हरो चाल-चलन भी बदलतो जाये, जेकोसी तुम परमेश्वर की अच्छी, अऊर भावती, अऊर सिद्ध इच्छा अनुभव सी मालूम करतो रहो।<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />कहालीकि मय ऊ अनुग्रह को वजह जो मोख मिल्यो हय, तुम सी हर एक सी कहू हय कि जसो समझनो चाहिये ओको सी बढ़ क कोयी भी अपनो आप ख मत समझो; पर जसो परमेश्वर न हर एक ख विश्वास परिनाम को अनुसार बाट दियो हय, वसोच सुबुद्धी को संग अपनो आप ख समझो। <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" /><note caller="+" style="x"><char style="xo" closed="false">१२:४ </char><char style="xt" closed="false"><ref loc="1CO 12:12">१ कुरिन्थियों १२:१२</ref></char></note>कहालीकि जसी हमरो एक शरीर म बहुत सो अंग हंय, सब अंगों को एक जसो काम नहाय; <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />वसोच हम जो बहुत अंग रह्य क भी मसीह म एक शरीर हंय, अऊर हम एक दूसरों म, मिल्यो हुयो हय जसो एक शरीर म हय। <verse eid="ROM 12:5" /><verse number="6" style="v" sid="ROM 12:6" /><note caller="+" style="x"><char style="xo" closed="false">१२:६ </char><char style="xt" closed="false"><ref loc="1CO 12:4-11">१ कुरिन्थियों १२:४-११</ref></char></note>येकोलायी ऊ अनुग्रह को अनुसार जो हम्ख दियो गयो हय, अलग अलग तरह को वरदान मिल्यो हंय, त जेक सन्देश देन को दान मिल्यो होना, त ऊ विश्वास को अनुसार सन्देश दे; <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />यदि सेवा करन को दान मिल्यो होना, त सेवा म लग्यो रहे; यदि कोयी सिखावन वालो होना, त सिखावन म लग्यो रहे; <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />जो प्रोत्साहन देन वालो हो ऊ प्रोत्साहित करे जो दान देन उदारता सी दे; जो अगुवायी करन वालो हो ऊ लगन को संग अगुवायी करे, अऊर जसो दया दिखानो को दान हो, ऊ प्रसन्नता सी करे।<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />तुम्हरो प्रेम निष्कपट होना; बुरायी सी घृना करो; अऊर भलायी म लग्यो रहो। <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />भाईचारा को प्रेम सी एक दूसरों सी प्रेम करनो अऊर एक दूसरों को लायी आदर दिखावन को लायी उत्सुक होनो चाहिये। <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />कोशिश करन म आलसी नहीं होना; आत्मिक उत्साह म भरयो रहो; प्रभु की सेवा करत रहो। <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />आशा म खुशी रहो; कठिनायी म धिरज रखो; अऊर हर समय प्रार्थना म लग्यो रहो। <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />मसीह लोगों ख जो कुछ जरूरत होना ओको म उन्की मदत करो; अऊर मेहमानी करनो म सहभागी लग्यो रहो।<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:१४ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:44">मत्ती ५:४४</ref>; <ref loc="LUK 6:28">लूका ६:२८</ref></char>
    </note>अपनो सतावन वालो ख आशीष देवो; आशीष हि देवो श्राप मत देवो। <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />खुशी मनावन वालो को संग खुशी मनावो, अऊर रोवन वालो को संग रोवो। <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />आपस म एक जसो मन रखो; अभिमानी नहीं हो, पर नम्रता सी संगति रखो; अपनो नजर म बुद्धिमान मत बनो।<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />बुरायी को बदला कोयी सी बुरायी मत करो; जो बाते सब लोगों को नजर म भली हंय, उनकी चिन्ता करतो रहो। <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />जहां तक बन सकय, सब आदमियों को संग मेल मिलाप रखो। <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />हे प्रियो, बदला मत लेवो, पर परमेश्वर को गुस्सा ख मौका देवो, कहालीकि शास्त्र म लिख्यो हय, “बदला लेनो मोरो काम आय, प्रभु कह्य हय मयच बदला देऊ।” <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />पर “यदि तोरो दुश्मन भूखो हय त ओख खाना खिलायजो, यदि प्यासो हय त ओख पानी पिलावो; कहालीकि असो करन सी खुद हि तोख शरमायेंन।” <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />बुरायी सी मत हारो, पर भलायी सी बुरायी ख जीत लेवो।<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">राज्य को अधिकारियों को प्रति कर्तव्यों</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />हर एक लोग शासक अधिकारियों को अधीन रहे, कहालीकि कोयी अधिकार असो नहीं जो परमेश्वर को तरफ सी नहाय; अऊर जो अधिकार हंय, हि परमेश्वर को ठहरायो हुयो हंय। <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />येकोलायी जो कोयी अधिकार को विरोध करय हय, ऊ परमेश्वर की विधि को सामना करय हय; अऊर जो कोयी ओको सामना करन ऊ सजा पायेंन। <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />कहालीकि शासक अच्छो काम को नहीं, पर बुरो काम लायी डर को वजह हय; यदि तय अधिकारियों सी निडर रहनो चाहवय हय, त अच्छो काम कर, अऊर ओको तरफ सी तोरी प्रशंसा होयेंन; <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />कहालीकि ऊ तोरी अच्छी को लायी परमेश्वर को सेवक हय। पर यदि तय बुरायी करजो, त डर, कहालीकि ऊ तलवार बेकार धरयो हुयो नहाय; अऊर परमेश्वर को सेवक हय कि ओको गुस्सा को अनुसार बुरो काम करन वालो ख सजा दे। <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />येकोलायी तुम अधिकारियों की आज्ञा मान्यो, न त केवल परमेश्वर को सजा को वजह सी नहीं पर हमरो अन्तरमन को वजह सी मान्यो हय।<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१३:६ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:21">मत्ती २२:२१</ref>; <ref loc="MRK 12:17">मरकुस १२:१७</ref>; <ref loc="LUK 20:25">लूका २०:२५</ref></char>
    </note>येकोलायी कर भी देवो कहालीकि शासन करन वालो परमेश्वर को सेवक आय अऊर हमेशा योच काम म लग्यो रह्य हंय। <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />येकोलायी हर एक को कर चुकायो करो; जेक कर होना, ओख कर देवो; जेकोसी डरनो चाहिये, ओको सी डरो; जेको आदर करनो चाहिये, ओको आदर करो।<verse eid="ROM 13:7" /></para>
  <para style="s">एक-दूसरों को प्रति कर्तव्य</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />आपस म प्रेम ख छोड़ अऊर कोयी बात म कोयी को कर्जदार मत बनो; कहालीकि जो दूसरों सी प्रेम रखय हय, ओनच व्यवस्था को पालन करयो हय। <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />कहालीकि यो कि “व्यभिचार नहीं करनो, हत्या नहीं करनो, चोरी नहीं करनो, लालच नहीं करनो,” अऊर इन ख छोड़ अऊर कोयी भी आज्ञा होय त सब को सारांश यो आज्ञा म पायो जावय हय, “अपनो पड़ोसी सी अपनो जसो प्रेम रख।” <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />प्रेम अपनो संगी बुरायी नहीं करय, येकोलायी प्रेम रखनो व्यवस्था को पालन करय हय।<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />समय ख पहिचान क असोच करो, येकोलायी कि अब तुम्हरो लायी नींद सी जाग जान की घड़ी आय पहुंची हय; कहालीकि जो समय हम न विश्वास करयो होतो, ऊ समय को बिचार सी अब हमरो उद्धार जवर हय। <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />रात बहुत बीत गयी हय, अऊर दिन निकलन पर हय; येकोलायी हम अन्धारो को कामों ख छोड़ क ज्योति को अवजार बान्ध लेवो। <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />जसो लोग दिन को प्रकाश म रह्य हय, वसोच हम सीधी चाल चले, नहीं कि काम-वासना अऊर पियक्कड़पन म, नहीं अनैतिकता अऊर लुचपन म, अऊर नहीं झगड़ा अऊर जलन म। <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />बल्की प्रभु यीशु मसीह ख पहिचान लेवो, अऊर अपनो मानव स्वभाव की इच्छा ख पूरो करन म मत लग्यो रहो।<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">एक दूसरों को न्याय मत करो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१४:१ </char>
      <char style="xt" closed="false">
        <ref loc="COL 2:16">कुलुस्सियों २:१६</ref>
      </char>
    </note>जो विश्वास म कमजोर हय, ओख अपनी संगति म लेवो, पर ओकी शंकावों बिचारों पर विवाद करन लायी नहीं। <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />कुछ लोगों ख विश्वास हय कि सब कुछ खानो ठीक हय, पर जो विश्वास म कमजोर हय ऊ केवल साकाहारी खावय हय। <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />खान वालो नहीं खान वालो ख तुच्छ मत जानो, अऊर नहीं खान वालो पर दोष नहीं लगाये; कहालीकि परमेश्वर न ओख स्वीकार करयो हय। <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />तय कौन आय जो दूसरों को सेवक पर दोष लगावय हय? ओको स्थिर रहनो यां गिर जानो ओको मालिक सीच सम्बन्ध रखय हय; बल्की ऊ स्थिरच कर दियो जायेंन, कहालीकि प्रभु ओख स्थिर रख सकय हय।<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />कोयी आदमी त एक दिन ख दूसरों दिन सी अच्छो मानय हय, अऊर कोयी सब दिनो ख एक जसो मानय हय। हर एक बुद्धी की बात अपनोच मन म निश्चय कर लेवो। <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />जो कोयी एक दिन ख महत्वपूर्न मानय हय, ऊ प्रभु को आदर लायी मानय हय। जो सब कुछ खावय हय, ऊ प्रभु ख आदर देनो को लायी खावय हय, कहालीकि ऊ अपनो परमेश्वर को धन्यवाद करय हय, अऊर जो कुछ नहीं खावय, ऊ प्रभु ख आदर देनो को लायी नहीं खावय अऊर परमेश्वर को धन्यवाद करय हय। <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />कहालीकि हम म सी नहीं त कोयी अपनो लायी जीवय हय अऊर नहीं कोयी अपनो लायी मरय हय। <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />यदि हम जीन्दो हंय, त प्रभु को लायी जीन्दो हंय; अऊर यदि मरजे हंय, त प्रभु को लायी मरजे हंय; अब भी हम जीबो यां मरबो, हम प्रभु कोच आय। <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />कहालीकि मसीह येकोच लायी मरयो अऊर जीन्दो भी भयो कि ऊ मरयो हुयो अऊर जीन्दो दोयी को प्रभु आय। <verse eid="ROM 14:9" /><verse number="10" style="v" sid="ROM 14:10" /><note caller="+" style="x"><char style="xo" closed="false">१४:१० </char><char style="xt" closed="false"><ref loc="2CO 5:10">२ कुरिन्थियों ५:१०</ref></char></note>तुम त, केवल सागभाजीच खावय हय, तुम दूसरों पर न्याय कहाली देवय हय? अऊर तुम जो भी खावय हय, तुम दूसरों विश्वासियों ख तुच्छ कहाली समझय हय? हम सब लोग ओको आगु न्याय करन लायी परमेश्वर को सामने खड़ो होबो। <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />शास्त्र म लिख्यो हय,</para>
  <para style="q1" vid="ROM 14:11">“प्रभु कह्य हय,</para>
  <para style="q2" vid="ROM 14:11">मोरो जीवन की कसम कि हर एक घुटना मोरो सामने टेकेंन,</para>
  <para style="q2" vid="ROM 14:11">अऊर हर एक जीबली मान लेयेंन कि मय परमेश्वर आय।”<verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />येकोलायी हम म सी हर एक परमेश्वर ख अपनो लेखा जोखा दे।<verse eid="ROM 14:12" /></para>
  <para style="s">एक अऊर पतन को कारन मत बनावो</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />येकोलायी हम एक दूसरों को न्याय करनो बन्द करो अऊर येको बदले म निश्चय करो कि, अपनो भाऊ को सामने ठोकर खाय कर पाप म पढ़नो को वजह मत बनो। <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />प्रभु यीशु म एक होनो को वजह म जानय हय, कोयी भोजन अपनो आप सी अशुद्ध नहीं, पर जो ओख अशुद्ध समझय हय ओको लायी अशुद्ध हय। <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />यदि तोरो भाऊ यां बहिन तोरो खान को वजह उदास होवय हय, त फिर तय प्रेम की रीति सी नहीं चलय; जेको लायी मसीह मरयो, ओको तय अपनो जेवन को द्वारा नाश मत कर। <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />जेक तुम अच्छो समझय हय ओको कोयी ख बुरो मत कहन देजो। <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />कहालीकि परमेश्वर को राज्य खानो-पीनो नहीं, पर सच्चायी शान्ति अऊर ऊ खुशी हय जो पवित्र आत्मा सी होवय हय। <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />जो कोयी यो रीति सी मसीह की सेवा करय हय, ऊ परमेश्वर ख भावय हय अऊर आदमियों म स्वीकारन लायक ठहरय हय।<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />येकोलायी हम उन बातों म लग्यो रहबोंन जिन्कोसी मेल-मिलाप अऊर एक दूसरों की उन्नति हो। <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />जेवन को लायी जो परमेश्वर न करयो ओको नाश मत करो। सब कुछ शुद्ध त हय, पर ऊ आदमी को लायी बुरो हय जेक ओको जेवन सी ठोकर लगय हय। <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />अच्छो त यो हय कि तय न मांस खाजो नहीं अंगूररस पीजो, नहीं अऊर कुछ असो करजो जेकोसी तोरो विश्वासी भाऊ ठोकर खाये। <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />तोरो जो विश्वास हय, ओख परमेश्वर को आगु अपनोच मन म रख धन्य हय ऊ जो या बात म, जेक ऊ ठीक समझय हय, अपनो आप ख दोषी नहीं ठहरावय। <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />पर जो लोग सन्देश कर क् खावय हय उन्ख परमेश्वर दोषी ठहरय हय, कहालीकि ओको कार्य विश्वास को आधार पर नहीं अऊर जो कुछ विश्वास को आधार पर नहीं हय, पाप हय।<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s">दूसरों की उन्नति करो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />हम बलवानो ख होना कि कमजोरों की कमजोरी ख सहे, नहीं कि अपनो आप ख खुश करे। <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />हम म सी हर एक ओकी अच्छायी को लायी खुश करे कि उन्की उन्नति होय। <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />कहालीकि मसीह न अपनो आप ख खुश नहीं करयो, पर जसो शास्त्र म लिख्यो हय: “तोरो निन्दा करन वालो की निन्दा मोरो पर आय गयी हय।” <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />जितनी बाते पहिले सी लिखी गयी, हि हमारीच शिक्षा लायी लिखी गयी हंय कि हम धीरज अऊर पवित्र शास्त्र को प्रोत्साहन द्वारा आशा रखबो। <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />धीरज अऊर शान्ति को दाता परमेश्वर तुम्ख यो वरदान दे कि मसीह यीशु को अनुसार आपस म एक मन रहो। <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />ताकि तुम एक मन अऊर एक स्वर म हमरो प्रभु यीशु मसीह को पिता परमेश्वर की महिमा करो।<verse eid="ROM 15:6" /></para>
  <para style="s">सब को लायी सुसमाचार</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />येकोलायी, जसो मसीह न परमेश्वर की महिमा लायी तुम्ख स्वीकार करयो हय, वसोच तुम भी एक दूसरों ख स्वीकार करो। <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />येकोलायी मय कहू हय कि जो प्रतिज्ञाये बापदादों ख दियो गयी होती उन्ख मजबूत करन लायी मसीह, परमेश्वर की सच्चायी को नमस्कार देन लायी, खतना करयो हुयो यहूदी लोगों को सेवक बन्यो; <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />अऊर गैरयहूदी भी दया को वजह परमेश्वर की महिमा करे; जसो शास्त्र म लिख्यो हय,</para>
  <para style="q1" vid="ROM 15:9">“येकोलायी मय गैरयहूदियों म तोरो नाम को धन्यवाद करू,</para>
  <para style="q2" vid="ROM 15:9">अऊर तोरो नाम को भजन गाऊं।”<verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />फिर कह्य हय,</para>
  <para style="q1" vid="ROM 15:10">“हे गैरयहूदियों को सब लोगों, परमेश्वर को लोगों को संग खुशी मनावो।”<verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />अऊर फिर, “हे गैरयहूदियों को सब लोगों,</para>
  <para style="q1" vid="ROM 15:11">प्रभु को लोगों को संग स्तुति करो; अऊर हे राज्य को सब लोगों,</para>
  <para style="q2" vid="ROM 15:11">ओकी स्तुति करो।”<verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />अऊर फिर यशायाह कह्य हय,</para>
  <para style="q1" vid="ROM 15:12">“यिशै की एक वंशज प्रगट होयेंन,</para>
  <para style="q2" vid="ROM 15:12">अऊर जो गैरयहूदियों पर शासक करेंन अऊर ऊ लोग</para>
  <para style="q2" vid="ROM 15:12">ओको पर गैरयहूदियों आशा रखेंन।”<verse eid="ROM 15:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="ROM 15:13" />परमेश्वर जो आशा को दाता हय तुम्ख विश्वास करन म सब तरह की खुशी अऊर शान्ति सी परिपूर्न करे, कि पवित्र आत्मा की सामर्थ सी तुम्हरी आशा बढ़ती जाये।<verse eid="ROM 15:13" /></para>
  <para style="s">साहसपूर्वक लिखन को वजह</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />हे मोरो भाऊवों अऊर बहिनों, मय खुद तुम्हरो बारे म निश्चित जानु हय कि तुम भी खुदच भलायी सी भरयो अऊर ईश्वरीय ज्ञान सी भरपूर हो, अऊर एक दूसरों ख चिताय सकय हय। <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />तब भी मय न या चिट्ठी म कहीं-कहीं याद दिलावन लायी तुम्ख जो बहुत हिम्मत कर क् लिख्यो। यो अनुग्रह को वजह भयो जो परमेश्वर न मोख दियो हय, <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />कि मय गैरयहूदियों को लायी मसीह यीशु को सेवक होय क परमेश्वर को सुसमाचार की सेवा याजक को जसो करू, जेकोसी गैरयहूदियों को मानो चढ़ायो जानो, पवित्र आत्मा सी पवित्र बन क स्वीकार करयो जाय। <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />येकोलायी उन बातों को बारे म जो परमेश्वर सी सम्बन्ध रखय हंय, मय मसीह यीशु म बड़ायी कर सकू हय। <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />कहालीकि उन बातों ख छोड़ मोख अऊर कोयी बात को बारे म कहन को हिम्मत नहाय, जो मसीह म गैरयहूदियों की अधीनता को लायी वचन, अऊर कर्म, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />अऊर चिन्हों, चमत्कारों को कामों की सामर्थ सी, अऊर पवित्र आत्मा की सामर्थ सी मोरोच द्वारा करयो; यहां तक कि मय न यरूशलेम सी ले क चारयी तरफ इल्लुरिकुम तक मसीह को सुसमाचार को पूरो प्रचार करयो। <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />पर मोरो मन की उमंग यो हय कि जित मसीह को नाम नहीं लियो गयो, वहांच सुसमाचार सुनाऊ असो नहीं होय कि दूसरों को पायवा पर घर बनाऊ। <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />पर जसो शास्त्र म लिख्यो हय वसोच हो,</para>
  <para style="q1" vid="ROM 15:21">“जिन्ख ओको सुसमाचार नहीं पहुंच्यो, हिच देखेंन</para>
  <para style="q2" vid="ROM 15:21">अऊर जिन्न नहीं सुन्यो हिच समझेंन।”<verse eid="ROM 15:21" /></para>
  <para style="s">रोम यात्रा की पौलुस की योजना</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१५:२२ </char>
      <char style="xt" closed="false">
        <ref loc="ROM 1:13">रोमियों १:१३</ref>
      </char>
    </note>येकोलायी मय तुम्हरो जवर आवन सी बार बार रुक्यो रह्यो। <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />पर अब इन देशों म मोरो काम लायी अऊर जागा नहीं होती, अऊर बहुत सालो सी मोख तुम्हरो जवर आवन की इच्छा हय। <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />येकोलायी जब मय इसपानिया जातो तब होतो हुयो तुम्हरो जवर आऊं, कहालीकि मोख आशा हय कि ऊ यात्रा म तुम सी भेंट करू, अऊर जब तुम्हरी संगति सी मोरो जी भर जाये त तुम मोख कुछ दूर आगु पहुंचाय देवो। <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" /><note caller="+" style="x"><char style="xo" closed="false">१५:२५ </char><char style="xt" closed="false"><ref loc="1CO 16:1-4">१ कुरिन्थियों १६:१-४</ref></char></note>पर अभी त मय परमेश्वर को लोगों की सेवा करन लायी यरूशलेम जाय रह्यो हय। <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />कहालीकि मकिदुनिया अऊर अखया को लोगों ख यो अच्छो लग्यो कि यरूशलेम को परमेश्वर को लोगों म गरीबों की मदत करन लायी कुछ भेंट जमा करे। <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" /><note caller="+" style="x"><char style="xo" closed="false">१५:२७ </char><char style="xt" closed="false"><ref loc="1CO 9:11">१ कुरिन्थियों ९:११</ref></char></note>उन्ख अच्छो त लग्यो, पर हि उन्को कर्जदार भी हंय, कहालीकि यदि गैरयहूदी उन्की आत्मिक बातों म सहभागी भयो, त उन्ख भी ठीक हय कि शारीरिक बातों म उन्की सेवा करे। <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />येकोलायी मय यो काम पूरो कर क् अऊर उन्ख भेंट सौंप क तुम्हरो जवर सी होतो हुयो स्पेन ख जाऊं। <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />अऊर मय जानु हय कि जब मय तुम्हरो जवर आऊं, त मसीह की पूरी आशीर्वाद को संग आऊं।<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />हे भाऊवों अऊर बहिनों, हमरो प्रभु यीशु मसीह को अऊर पवित्र आत्मा को प्रेम ख याद दिलाय क मय तुम सी बिनती करू हय, कि मोरो लायी परमेश्वर सी प्रार्थना करन म मोरो संग मिल क मगन रहो। <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />कि मय यहूदियों नाम को अविश्वासियों लोगों सी बच्यो रहूं, अऊर मोरी ऊ सेवा जो यरूशलेम को लायी हय, परमेश्वर को लोगों ख भाये; <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />अऊर मय परमेश्वर की इच्छा सी तुम्हरो जवर खुशी को संग आय क तुम्हरो संग भेंट करू। <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />शान्ति को परमेश्वर तुम सब को संग रहे। आमीन।<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">व्यक्तिगत अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />मय तुम सी फीबे को लायी जो हमरी बहिन अऊर किंख्रिया की मण्डली की सेविका आय, बिनती करू हय <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />कि तुम, जसो कि परमेश्वर को लोगों ख होना, ओख प्रभु म स्वीकार करो; अऊर जो कोयी बात म ओख तुम्हरी जरूरत हो, ओकी मदत करो, कहालीकि ऊ भी बहुतों की बल्की मोरी भी मदत करन वाली होती।<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:३ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">प्रेरितों १८:२</ref>
      </char>
    </note>प्रिस्का अऊर अक्विला ख जो मसीह यीशु म मोरो सहकर्मी हंय, प्रनाम। <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />उन्न मोरो जीव लायी अपनोच जीवन जोखिम म डाल दियो होतो; अऊर केवल मयच नहीं, बल्की गैरयहूदियों की पूरी मण्डली भी उन्को धन्यवाद करय हय।<verse eid="ROM 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 16:5" />ऊ मण्डली ख भी नमस्कार जो उन्को घर म हय। मोरो प्रिय इपैनितुस ख, जो मसीह को लायी आसिया प्रान्त को पहिलो फर आय, नमस्कार। <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />मरियम ख, जेन तुम्हरो लायी बहुत मेहनत करयो, नमस्कार। <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />अन्द्रुनीकुस अऊर यूनियास ख जो मोरो कुटुम्बी आय, अऊर मोरो संग बन्दी भयो होतो अऊर प्रेरितों म नामी हंय, अऊर मोरो सी पहिले मसीही भयो होतो, नमस्कार।<verse eid="ROM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8" />अम्पलियातुस ख, जो प्रभु म मोरो प्रिय हय, नमस्कार। <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />उरबानुस ख, जो मसीह म हमरो सहकर्मी हय, अऊर मोरो प्रिय इस्तखुस ख नमस्कार। <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />अपिल्लेस ख जो मसीह म सच्चो निकल्यो, नमस्कार। अरिस्तुबुलुस को घरानों ख नमस्कार। <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />मोरो कुटुम्बी हेरोदियोन ख नमस्कार। नरकिस्सुस को घराना को जो लोग प्रभु म हंय, उन्ख नमस्कार।<verse eid="ROM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12" />त्रूफेना अऊर त्रूफोसा ख जो प्रभु म मेहनत करय हंय, नमस्कार। प्रिय पिरसिस ख, जेन प्रभु म बहुत मेहनत करयो, नमस्कार। <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" /><note caller="+" style="x"><char style="xo" closed="false">१६:१३ </char><char style="xt" closed="false"><ref loc="MRK 15:21">मरकुस १५:२१</ref></char></note>रूफुस ख जो प्रभु म चुन्यो हुयो हय अऊर ओकी माय ख, जो मोरी होती माय हय, दोयी ख नमस्कार। <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />असुंक्रितुस अऊर फिलगोन अऊर हिरमेस अऊर पत्रुबास अऊर हिर्मास अऊर उन्को संग को भाऊवों ख नमस्कार। <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />फिलुलुगुस अऊर यूलिया अऊर नेर्युस अऊर ओकी बहिन, अऊर उलुम्पास अऊर उन्को संग को सब लोगों ख नमस्कार।<verse eid="ROM 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16" />आपस म पवित्र चुम्मा सी नमस्कार करो। तुम ख मसीह की पूरी मण्डलियों को तरफ सी नमस्कार।<verse eid="ROM 16:16" /></para>
  <para style="s">आखरी निर्देश</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />अब हे भाऊवों अऊर बहिनों, मय तुम सी बिनती करू हय, कि जो लोग ऊ शिक्षा को विरुद्ध, जो तुम न पायो हय, फूट डालन अऊर ठोकर खिलावन को वजह होवय हंय, पहिचान लियो करो अऊर उन्को सी दूर रहो। <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />कहालीकि असो लोग हमरो प्रभु मसीह की नहीं, पर अपनो पेट की सेवा करय हंय; अऊर चिकनी चुपड़ी बातों सी सीधो साधो मन को लोगों ख बहकाय देवय हंय। <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />तुम्हरी आज्ञा मानन की चर्चा सब लोगों म फैल गयी हय, येकोलायी मय तुम्हरो बारे म खुश हय, पर मय यो चाहऊ हय कि तुम भलायी को लायी बुद्धिमान पर बुरायी को लायी भोलो बन्यो रहो। <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />शान्ति को परमेश्वर शैतान ख तुम्हरो पाय सी जल्दीच कुचलाय दे। हमरो प्रभु यीशु मसीह को अनुग्रह तुम पर होतो रहे।</para>
  <para style="p" vid="ROM 16:20">हमरो प्रभु यीशु मसीह को अनुग्रह तुम पर होतो रहे।<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:२१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">प्रेरितों १६:१</ref>
      </char>
    </note>मोरो सहकर्मी तीमुथियुस को, अऊर मोरो कुटुम्बियों लूकियुस अऊर यासोन अऊर सोसिपत्रुस को तुम ख नमस्कार।<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />मोख चिट्ठी लिखन वालो तिरतियुस को, प्रभु म तुम ख नमस्कार।<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:२३ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">प्रेरितों १९:२९</ref>; <ref loc="1CO 1:14">१ कुरिन्थियों १:१४</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="2TI 4:20">२ तीमुथियुस ४:२०</ref>
      </char>
    </note>गयुस जो मोरी अऊर मण्डली की पाउनचार करन वालो हय, ओको तुम्ख प्रनाम। इरास्तुस जो नगर को व्यवस्थापक हय, अऊर भाऊ क्वारतुस को तुम ख नमस्कार। <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />हमरो प्रभु यीशु मसीह को अनुग्रह तुम पर होतो रहे। आमीन।<verse eid="ROM 16:24" /></para>
  <para style="s">परमेश्वर की स्तुति</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />अब जो तुम ख मोरो सुसमाचार मतलब यीशु मसीह को सन्देश को प्रचार को अनुसार स्थिर कर सकय हय, ऊ भेद को प्रकाश को अनुसार जो अनन्त काल सी लूक्यो रह्यो, <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />पर अब प्रगट होय क अनन्त काल को परमेश्वर की आज्ञा सी भविष्यवक्तावों की किताबों को द्वारा सब जातियों ख बतायो गयो हय कि हि विश्वास सी आज्ञा मानन वालो होय जाये।<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />उच एकच बुद्धिमान परमेश्वर की यीशु मसीह को द्वारा हमेशा हमेशा महिमा होती रहे। आमीन।<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>