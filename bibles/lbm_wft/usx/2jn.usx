<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Lodhi</book>
  <para style="h">२ यूहन्ना</para>
  <para style="toc3">२ यूहन्ना</para>
  <para style="toc2">२ यूहन्ना</para>
  <para style="toc1">यूहन्ना की दूसरी चिट्ठी</para>
  <para style="mt2">यूहन्ना की दूसरी पत्री</para>
  <para style="mt1">यूहन्ना की दूसरी चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">यूहन्ना की दूसरी चिट्ठी प्रेरित यूहन्ना द्वारा मसीह को जनम को ५० सी १०० साल को बीच लिख्यो गयो होतो यूहन्ना खुद लेखक को रूप म नहीं जान्यो जावय हय। बल्की ऊ खुद ख बुजूर्ग कह्य हय। यूहन्ना को अनुसार सुसमाचार म मिली विषय चिज की तुलना म २ यूहन्ना की विषय चिज उन्को सी मिलती झूलती हय यो विशेष रूप सी साफ हय कि जो तरह सी ऊ एक दूसरों सी प्रेम करन लायी यीशु को आदेश पर जोर देवय हय, अऊर जो तरह सी ऊ अपनो आदेशों को पालन को संग यीशु सी प्रेम करय हय <char style="xt"><ref loc="2JN 1:5-6">१:५-६</ref></char>, <char style="xt"><ref loc="JHN 15:9-10">यूहन्ना १५:९-१०</ref>।</char> असो मान्यो जावय हय कि यूहन्ना न यूहन्ना को अनुसार सुसमाचार लिख्यो होतो अऊर इफिसियों म रहतो हुयो तीन चिट्ठी १ यूहन्ना, २ यूहन्ना, ३ यूहन्ना, लिख्यो।</para>
  <para style="ip">यूहन्ना न या चिट्ठी सी कुछ चुनी हुयी बाई अऊर उन्को बच्चा ख सम्बोधित करयो। ऊ शायद कोयी एक मण्डली को जिक्र करत होतो। या चिट्ठी ख लिखन म यूहन्ना को उद्देश मण्डली ख प्रोत्साहित करनो होतो अऊर झूठो शिक्षकों ख चेतावनी देनो होतो।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. यूहन्ना प्रस्तुत करत होतो की या चिट्ठी कोन्को लायी आय अऊर प्राप्त करन वालो ख अभिवादन करनो। <char style="ior"><ref loc="2JN 1:1-3">१:१-३</ref></char></para>
  <para style="io1">२. मण्डली ख प्रोत्साहित करनो अऊर महान आदेश को याद दिलानो हय। <char style="ior"><ref loc="2JN 1:4-6">१:४-६</ref></char></para>
  <para style="io1">३. हर समय झूठो शिक्षकों की चेतावनी देवय हय। <char style="ior"><ref loc="2JN 1:7-11">१:७-११</ref></char></para>
  <para style="io1">४. यूहन्ना मण्डली म विश्वासियों सी बधायी दे क अपनी चिट्ठी पूरी करय हय जित ऊ रह्य हय। <char style="ior"><ref loc="2JN 1:12-13">१:१२-१३</ref></char></para>
  <chapter number="1" style="c" sid="2JN 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1"/>मय बुजूर्ग को तरफ सी वा चुनी हुयी, बाई अऊर ओको बच्चां को नाम, जिन्कोसी मय सच्चो प्रेम रखू हय, अऊर केवल मयच नहीं बल्की हि सब भी प्रेम रखय हंय जो सच ख जानय हंय। <verse eid="2JN 1:1"/><verse number="2" style="v" sid="2JN 1:2"/>ऊ सच जो हम म स्थिर रह्य हय, अऊर हमेशा हमरो संग रहेंन।<verse eid="2JN 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3"/>परमेश्वर पिता, अऊर बाप को बेटा यीशु मसीह को तरफ सी अनुग्रह अऊर दया अऊर शान्ति, सत्य अऊर प्रेम सहित हमरो संग रहेंन।<verse eid="2JN 1:3"/></para>
  <para style="s">सच अऊर प्रेम</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4"/>मय बहुत खुश भयो कि मय न तोरो कुछ बच्चां ख ऊ आज्ञा को अनुसार, जो हम्ख बाप को तरफ सी मिली होती, सच पर चलतो हुयो पायो। <verse eid="2JN 1:4"/><verse number="5" style="v" sid="2JN 1:5"/><note caller="+" style="x"><char style="xo" closed="false">१:५ </char><char style="xt" closed="false"><ref loc="JHN 13:34">यूहन्ना १३:३४</ref>; <ref loc="JHN 15:12">१५:१२</ref>,<ref loc="JHN 15:17">१७</ref></char></note>अब हे प्रिय बाई, मय तोख कोयी नयी आज्ञा नहीं, पर वाच जो सुरूवात सी मिली हय तुम्ख लिख रह्यो हय, अऊर तोरो सी बिनती करू हय कि हम एक दूसरों सी प्रेम रखे। <verse eid="2JN 1:5"/><verse number="6" style="v" sid="2JN 1:6"/>अऊर प्रेम यो हय कि हम परमेश्वर की आज्ञावों को अनुसार चले; यो वाच आज्ञा आय जो तुम न सुरूवात सी सुनी हय, अऊर तुम्ख येकोलायी प्रेम पुर्वक जीवन जीनो चाहिये।<verse eid="2JN 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7"/>कहालीकि बहुत सो असो भरमावन वालो जगत म निकल आयो हंय, कि हि यो नहीं मानय कि यीशु मसीह शरीर म होय क आयो। भरमावन वालो लोग अऊर मसीह को विरोधी हिच आय। <verse eid="2JN 1:7"/><verse number="8" style="v" sid="2JN 1:8"/>अपनो बारे म चौकस रहो, कि जो मेहनत हम न करयो हय ओख तुम गवा मत देवो, बल्की ओको पूरो प्रतिफल पावों।<verse eid="2JN 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9"/>जो कोयी मसीह कि शिक्षा सी आगु बड़ जावय हय अऊर ओको म बन्यो नहीं रह्य, ओको जवर परमेश्वर नहाय; जो कोयी ओकी शिक्षा म स्थिर रह्य हय, ओको जवर बाप भी हय अऊर बेटा भी। <verse eid="2JN 1:9"/><verse number="10" style="v" sid="2JN 1:10"/>यदि कोयी तुम्हरो जवर आये अऊर शिक्षा नहीं दे, ओख नहीं त घर म आवन देवो अऊर नहीं नमस्कार करो। <verse eid="2JN 1:10"/><verse number="11" style="v" sid="2JN 1:11"/>कहालीकि जो कोयी असो लोग ख अभिवादन करय हय, ऊ ओको बुरो कामों म सहभागी होवय हय।<verse eid="2JN 1:11"/></para>
  <para style="s">आखरी शब्द</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12"/>मोख बहुत सी बाते तुम्ख लिखनो हंय, पर कागज अऊर स्याही सी लिखनो नहीं चाहऊ, पर आशा हय कि मय तुम्हरो जवर आऊं अऊर आमने-सामने बातचीत करू, जेकोसी तुम पूरो तरह सी खुशी रहो।<verse eid="2JN 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13"/>तोरी बहिन<note caller="+" style="f"><char style="fr" closed="false">१:१३ </char><char style="ft" closed="false">ओकी मण्डली को विश्वासियों</char></note> को बच्चा को तरफ सी तोख नमस्कार करजे हंय।<verse eid="2JN 1:13"/></para>
  <chapter eid="2JN 1"/>
</usx>
