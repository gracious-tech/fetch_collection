<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JON" style="id">- Lodhi</book>
  <para style="toc3">योना</para>
  <para style="toc1">योना</para>
  <para style="toc2">योना</para>
  <para style="mt2">योना</para>
  <para style="mt1">योना</para>
  <para style="imt">परिचय</para>
  <para style="ip">योना की किताब भविष्यवक्ता योना को नीनवे शहर म सेवकायी को बारे म हय। दूसरी भविष्यवानियों की किताबों को अलावा, या किताब परमेश्वर को सन्देश की तुलना म भविष्यवक्ता अऊर ओको कार्यों पर जादा ध्यान लगावय हय। योना की सेवकायी लगभग उच समय भयो जब यारोबाम दूसरो इस्राएल को राजा होतो, लगभग ८००-७५० ई. स. पहिले, पर विद्वानों ख यो नहीं पता कि किताब खुद कब लिखी गयी होती।</para>
  <para style="ip">परमेश्वर न योना ख नीनवे को खिलाफ प्रचार करन लायी भेज्यो, पर योना न आज्ञा नहीं मानी अऊर नीनवे सी दूसरी दिशा म चली गयो। <char style="xt"><ref loc="JON 1:1-3">१:१-३</ref></char> ऊ एक जहाज पर सवार भयो जो तर्शीश शहर जाय रह्यो होतो। जब जहाज तर्शीश को तरफ जाय रह्यो होतो, त परमेश्वर न एक बड़ो तुफान भेज्यो। डोंगा चलावन वालो बहुत डर गयो, अऊर उन्न परमेश्वर को गुस्सा ख शान्त करन लायी योना ख समुन्दर म फेंक दियो। फिर परमेश्वर न योना ख गिटकन लायी एक बड़ी मच्छी भेजी। योना न पश्चाताप करयो अऊर परमेश्वर न ओख जीन्दो रहन दियो। आखरी म, योना येको विपरित प्रचार करन लायी नीनवे गयो, अऊर शहर को लोगों न पश्चाताप करयो। योना की किताब या बात पर जोर देवय हय कि परमेश्वर कितनो दयालु हय, भलोच योना नहीं चाहत होतो कि परमेश्वर दयालु हय। <char style="xt"><ref loc="JON 4:2">४:२</ref></char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">बतायो गयो हय कि योना कौन्सो तरह परमेश्वर सी दूर भग गयो अऊर मच्छी को पेट म समाय गयो। <char style="ior"><ref loc="JON 1">१</ref></char></para>
  <para style="io1">योना को द्वारा मच्छी को पेट म रहतो हुयो परमेश्वर सी करी गयी प्रार्थना को वर्णन हय। <char style="ior"><ref loc="JON 2">२</ref></char></para>
  <para style="io1">योना नीनवे म प्रचार करय हय अऊर शहर को लोग पश्चाताप करय हंय। परमेश्वर उन्ख बचावन को फैसला करय हय। <char style="ior"><ref loc="JON 3">३</ref></char></para>
  <para style="io1">आखरी म, योना या बात सी गुस्सा हय कि परमेश्वर न नीनवे को लोगों पर दया दिखायी, अऊर परमेश्वर योना सी कह्य हय कि ऊ सब लोगों सी प्रेम करय हय। <char style="ior"><ref loc="JON 4">४</ref></char></para>
  <chapter number="1" style="c" sid="JON 1" />
  <para style="s">परमेश्वर की आज्ञा को उल्लंघन</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 1:1" />परमेश्वर को वचन अमितै को टुरा योना सी कह्यो: <verse eid="JON 1:1" /><verse number="2" style="v" sid="JON 1:2" />“उठ क ऊ बड़ो नगर नीनवे ख जा, अऊर ओको खिलाफ प्रचार कर; कहालीकि ओकी बुरायी मोरो तक पहुंची हय।” <verse eid="JON 1:2" /><verse number="3" style="v" sid="JON 1:3" />पर योना परमेश्वर को जवर सी तर्शीश नगर ख भगन लायी उठ्यो, अऊर याफा बन्दरगाह ख जाय क तर्शीश जान वालो एक जहाज देख्यो; अऊर किराया दे क ओको अन्दर गयो की उन्को संग परमेश्वर को आगु सी तर्शीश ख चली जाये।<verse eid="JON 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JON 1:4" />तब परमेश्वर न समुन्दर म एक भयानक आन्धी चलायी, अऊर समुन्दर म बड़ो तुफान उठ्यो, असो लग रह्यो होतो कि जहाज टूट जायेंन। <verse eid="JON 1:4" /><verse number="5" style="v" sid="JON 1:5" />तब जहाज चलावन वालो लोग डर क अपनो अपनो परमेश्वर ख सुमरन लग्यो; अऊर जहाज म जो व्यापार को सामान होतो ओख समुन्दर म फेकन लग्यो कि जहाज हल्को होय जाये। पर योना जहाज को खल्लो को हिस्सा म उतर क सोय गयो होतो, अऊर गहरी नींद म पड़्यो होतो।<verse eid="JON 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JON 1:6" />तब जहाज को मुखिया ओको जवर आय क कहन लग्यो, “तय गहरी नींद म पड़्यो हुयो का कर रह्यो हय? उठ, अपनो देवता ख सुमर! सम्भव हय की परमेश्वर हमरी चिन्ता करेंन, अऊर हमरो नाश नहीं होयेंन।”<verse eid="JON 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JON 1:7" />तब उन्न आपस म कह्यो, “आवो, हम चिट्ठी डाल क जान लेबो की या विपत्ति हम पर कौन्को वजह सी आयी हय।” तब उन्न चिट्ठी डाली, अऊर चिट्ठी योना को नाम पर निकली। <verse eid="JON 1:7" /><verse number="8" style="v" sid="JON 1:8" />तब उन्न ओको सी कह्यो, “हम्ख बताव कि या विपत्ति हम पर कहाली आयी हय? तय का काम करय हय? तय कहां सी आयो हय? तय कौन्सो देश को अऊर कौन्सो लोगों म सी आयो हय?”<verse eid="JON 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 1:9" />योना न उन्को सी कह्यो, “मय इब्री आय; अऊर स्वर्ग को परमेश्वर यहोवा न समुन्दर अऊर जमीन दोयी ख बनायो हय, ओकोच डर मानु हय।” <verse eid="JON 1:9" /><verse number="10" style="v" sid="JON 1:10" />तब हि बहुत डर गयो, अऊर ओको सी कहन लग्यो, “तय न यो का करयो हय?” हि जान गयो कि ऊ परमेश्वर को आगु सी भग क आयो हय; कहालीकि की ओन खुदच उन्ख बताय दियो होतो।<verse eid="JON 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JON 1:11" />तब उन्न योना सी पुच्छ्यो, “हम तोरो संग का करबो जेकोसी समुन्दर शान्त होय जायेंन?” उच समय समुन्दर की लहर बढ़तच जात होती।<verse eid="JON 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JON 1:12" />ओन उन्को सी कह्यो, “मोख उठाय क समुन्दर म फेक देवो; तब समुन्दर शान्त होय जायेंन; कहालीकि की मय जानु हय, कि यो बड़ो तुफान तुम्हरो ऊपर मोरोच वजह सी आयो हय।”<verse eid="JON 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JON 1:13" />फिर भी हि बड़ो कोशिश सी चलावत रह्यो कि ओख किनारो पर लगाये, पर पहुंच नहीं सक्यो, कहालीकि की समुन्दर की लहर उन्को विरुद्ध बड़तच जात होती। <verse eid="JON 1:13" /><verse number="14" style="v" sid="JON 1:14" />तब उन्न परमेश्वर ख पुकार क कह्यो, “हे परमेश्वर, हम बिनती करजे हय, कि यो आदमी को जीव को बदला म हमरो नाश नहीं होय, अऊर नहीं हम्ख निर्दोष की हत्या को दोषी ठहराव; कहालीकि हे परमेश्वर, जो कुछ तोरी इच्छा होती उच तय न करयो हय।” <verse eid="JON 1:14" /><verse number="15" style="v" sid="JON 1:15" />तब उन्न योना ख उठाय क समुन्दर म फेक दियो; अऊर समुन्दर की भयानक लहर रुक गयी। <verse eid="JON 1:15" /><verse number="16" style="v" sid="JON 1:16" />तब उन आदमियों न परमेश्वर को बहुतच डर मान्यो, अऊर ओख बलि चड़ायो अऊर मन्नत मानी।<verse eid="JON 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JON 1:17" />परमेश्वर न एक बड़ी मच्छी ठहरायी होती की योना ख गिटक ले; अऊर योना वा बड़ी मच्छी को पेट म तीन दिन अऊर तीन रात पड़्यो रह्यो।<verse eid="JON 1:17" /></para>
  <chapter eid="JON 1" />
  <chapter number="2" style="c" sid="JON 2" />
  <para style="s">योना की प्रार्थना</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 2:1" />तब योना न बड़ी मच्छी को पेट म सी अपनो परमेश्वर यहोवा सी प्रार्थना कर क् कह्यो, <verse eid="JON 2:1" /><verse number="2" style="v" sid="JON 2:2" />“मय संकट म पड़्यो हुयो परमेश्वर ख पुकारयो,</para>
  <para style="q2" vid="JON 2:2">अऊर ओन मोरी सुन ली हय;</para>
  <para style="q1" vid="JON 2:2">मय न मदत लायी अधोलोक को अन्दर सी पुकारयो,</para>
  <para style="q2" vid="JON 2:2">अऊर तय न मोरी सुन ली।<verse eid="JON 2:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="JON 2:3" />तय न मोख गहरो</para>
  <para style="q2" vid="JON 2:3">समुन्दर की गहरायी तक डाल दियो;</para>
  <para style="q2" vid="JON 2:3">अऊर मय धारावों को बिचमच पड़्यो होतो,</para>
  <para style="q2" vid="JON 2:3">तोरी भड़कायी हुयी सब तरंगें अऊर लहर मोरो ऊपर सी बह गयी।<verse eid="JON 2:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="JON 2:4" />तब मय न कह्यो, ‘मय तोरो आगु सी निकाल दियो गयो हय,</para>
  <para style="q2" vid="JON 2:4">फिर भी मय तोरो पवित्र मन्दिर ख कसो देखूं?’<verse eid="JON 2:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="JON 2:5" />मय पानी सी यहां तक घिरयो हुयो होतो; की मोरो जीव निकल्यो जात होतो;</para>
  <para style="q1" vid="JON 2:5">गहरो समुन्दर मोरो चारयी तरफ होतो,</para>
  <para style="q2" vid="JON 2:5">अऊर मोरो मुंड म कायी लपट्यो हुयो होतो।<verse eid="JON 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="JON 2:6" />मय पहाड़ी की जड़ तक पहुंच गयो होतो;</para>
  <para style="q2" vid="JON 2:6">मय हमेशा को लायी जमीन म बन्द भय गयो होतो;</para>
  <para style="q1" vid="JON 2:6">फिर भी हे मोरो परमेश्वर यहोवा,</para>
  <para style="q2" vid="JON 2:6">तय न मोरो जीव ख गड्डा म सी निकाल्यो हय।<verse eid="JON 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="JON 2:7" />जब मोरो जीवन खतम होन वालो होतो, तब मय न परमेश्वर ख याद करयो;</para>
  <para style="q2" vid="JON 2:7">अऊर मोरी प्रार्थना तोरो जवर बल्की</para>
  <para style="q2" vid="JON 2:7">तोरो पवित्र मन्दिर म पहुंच गयी।<verse eid="JON 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="JON 2:8" />जो लोग बेकार कि चिजों पर मन लगावय हय,</para>
  <para style="q2" vid="JON 2:8">हि अपनो अनुग्रह करन वालो परमेश्वर ख छोड़ देवय हय।<verse eid="JON 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="JON 2:9" />पर मय धन्यवाद को गीत गाय क तोख बलिदान चढ़ाऊं;</para>
  <para style="q2" vid="JON 2:9">जो मन्नत मय न मानी,</para>
  <para style="q2" vid="JON 2:9">ओख पूरी करूं।</para>
  <para style="q1" vid="JON 2:9">उद्धार परमेश्वर सीच होवय हय!”<verse eid="JON 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 2:10" />तब परमेश्वर न बड़ी मच्छी ख आज्ञा दियो, अऊर ओन योना ख समुन्दर को किनार पर उगल दियो।<verse eid="JON 2:10" /></para>
  <chapter eid="JON 2" />
  <chapter number="3" style="c" sid="JON 3" />
  <para style="s">योना को आज्ञा माननो</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 3:1" />तब परमेश्वर न दूसरी बार योना सी कह्यो: <verse eid="JON 3:1" /><verse number="2" style="v" sid="JON 3:2" />“उठ क ऊ बड़ो नगर नीनवे ख जा, अऊर जो बात मय तोरो सी कहूं, ओको प्रचार कर।” <verse eid="JON 3:2" /><verse number="3" style="v" sid="JON 3:3" />तब योना यहोवा को वचन को अनुसार नीनवे ख गयो। नीनवे एक बहुत बड़ो नगर होतो, ऊ तीन दिन की यात्रा को होतो, <verse eid="JON 3:3" /><verse number="4" style="v" sid="JON 3:4" />योना नगर म सिरयो एक दिन की यात्रा पूरी कर ली, अऊर यो प्रचार करतच गयो, “अब सी चालीस दिन बीतन पर नीनवे ख नाश कर दियो जायेंन।”<verse eid="JON 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 3:5" />तब नीनवे को आदमियों न परमेश्वर को वचन पर विश्वास करयो; अऊर उपवास को प्रचार करयो गयो अऊर छोटो सी ले क बड़ो तक सब लोग न दु:ख को कपड़ा पहिन्यो। <verse eid="JON 3:5" /><verse number="6" style="v" sid="JON 3:6" />तब यो समाचार नीनवे को राजा को कान म पहुंच्यो; अऊर ओन सिंहासन पर सी उठ क, अपनो राजकीय कपड़ा उतार क दु:ख को कपड़ा ओढ़ लियो, अऊर लाखड़ पर बैठ गयो। <verse eid="JON 3:6" /><verse number="7" style="v" sid="JON 3:7" />राजा न मुखियावों सी सलाह ले क नीनवे म या आज्ञा को ढिंढोरा पिटवायो : “का आदमी, का गाय-बईल, का मेंढी-शेरी, यां अऊर कोयी पशु, कोयी कुछ भी नहीं खाये अऊर नहीं पानी पीये। <verse eid="JON 3:7" /><verse number="8" style="v" sid="JON 3:8" />मनुष्य अऊर पशु दोयी दु:ख को कपड़ा ओढ़ेंन, अऊर हि रोय रोय क परमेश्वर सी प्रार्थना करे; अऊर अपनो बुरो मार्ग सी फिरे; अऊर ऊ उपद्रव सी, जो हि करय हय, ओख छोड़ दे। <verse eid="JON 3:8" /><verse number="9" style="v" sid="JON 3:9" />सम्भव हय, परमेश्वर दया करे अऊर अपनी मर्जी बदल दे, अऊर ओको भड़क्यो हुयो क्रोध शान्त होय जायेंन अऊर हम नाश होन सी बच जाये।”<verse eid="JON 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JON 3:10" />जब परमेश्वर न उन्को आचरन ख देख्यो, कि हि बुरो रस्ता सी फिर रह्यो हय, तब परमेश्वर न अपनी इच्छा बदल दियो, अऊर उन्की जो हानि करन कि ठानी होती, ओख नहीं करयो।<verse eid="JON 3:10" /></para>
  <chapter eid="JON 3" />
  <chapter number="4" style="c" sid="JON 4" />
  <para style="s">योना को गुस्सा अऊर परमेश्वर की दया</para>
  <para style="p">
    <verse number="1" style="v" sid="JON 4:1" />या बात योना ख बहुतच बुरी लगी, अऊर ओको गुस्सा भड़क्यो। <verse eid="JON 4:1" /><verse number="2" style="v" sid="JON 4:2" /><note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="EXO 34:6">निर्गमन ३४:६</ref></char></note>अऊर योना न यहोवा सी यो कह्य क प्रार्थना करी, “हे परमेश्वर, जब मय अपनो देश म होतो, तब का मय याच बात नहीं कहत होतो? योच वजह सी मय न तोरी आज्ञा सुनतच तर्शीश ख भगन लायी फुर्ती करी; कहालीकि मय जानत होतो कि तय अनुग्रहकारी अऊर दयालु परमेश्वर आय, अऊर विलम्ब सी कोप करन वालो दयालु हय, अऊर दु:ख देन सी खुश नहीं होवय। <verse eid="JON 4:2" /><verse number="3" style="v" sid="JON 4:3" />येकोलायी अब हे यहोवा, मोरो जीव ले ले; कहालीकि मोरो लायी जीन्दो रहन सी मरनोच भलो हय।” <verse eid="JON 4:3" /><verse number="4" style="v" sid="JON 4:4" />यहोवा न कह्यो, “तोरो जो गुस्सा भड़क्यो हय, का यो उचित हय?”<verse eid="JON 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JON 4:5" />येको पर योना ऊ नगर सी निकल क, ओको पूर्व तरफ बैठ गयो; अऊर वहांच एक छप्पर बनाय क ओकी छाव म बैठ्यो हुयो यो देखन लग्यो कि यो नगर को का होयेंन? <verse eid="JON 4:5" /><verse number="6" style="v" sid="JON 4:6" />तब यहोवा परमेश्वर न एक एरंडी को झाड़ उगाय क असो बढ़ायो की योना को मुंड पर सांवली होय, जेको म ओको दु:ख दूर हो। योना ऊ एरंडी को झाड़ को वजह सी बहुतच खुश भयो। <verse eid="JON 4:6" /><verse number="7" style="v" sid="JON 4:7" />भुन्सारो जब उजाड़ो होन लग्यो, तब परमेश्वर न एक कीड़ा ख भेज्यो, जेन एरंडी को झाड़ असो काट्यो की ऊ सुख गयो। <verse eid="JON 4:7" /><verse number="8" style="v" sid="JON 4:8" />जब सूरज निकल्यो, तब परमेश्वर न पुरवायी बहाय क लू चलायी, अऊर तपन योना को मुंड पर असी लगी कि ऊ चकरावन लग्यो; अऊर ओन यो कह्य क मौत मांगी, “मोरो लायी जीन्दो रहन सी मरनोच अच्छो हय।”<verse eid="JON 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JON 4:9" />परमेश्वर न योना सी कह्यो, “तोरो गुस्सा, जो एरंडी को झाड़ को वजह सी भड़क्यो हय, का ऊ उचित हय?” ओन कह्यो, “हां, मोरो जो गुस्सा भड़क्यो हय, ओको सी मोरो जीव गयो त भी ऊ अच्छो हय।” <verse eid="JON 4:9" /><verse number="10" style="v" sid="JON 4:10" />तब परमेश्वर न कह्यो, “जो एरंडी को झाड़ को लायी तय न कुछ मेहनत नहीं करयो नहीं ओख बढ़ायो, जो एकच रात म भयो, अऊर एकच रात म नाश भी भयो; ओको लायी तय चिन्तित कहाली हय। <verse eid="JON 4:10" /><verse number="11" style="v" sid="JON 4:11" />फिर यो बड़ो नगर नीनवे, जेको म एक लाख बीस हजार सी जादा मनुष्य हय। जो अपनो दायो बायो हाथ को भेद नहीं पहिचानय, अऊर जादा घरेलू जनावर भी ओको म रह्य हय, त का मय ओको पर मय चिन्ता नहीं करू?”<verse eid="JON 4:11" /></para>
  <chapter eid="JON 4" />
</usx>