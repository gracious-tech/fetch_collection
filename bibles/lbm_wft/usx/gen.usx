<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Lodhi</book>
  <para style="h">उत्पत्ति</para>
  <para style="toc3">उत्पत्ति</para>
  <para style="toc2">उत्पत्ति</para>
  <para style="toc1">उत्पत्ति</para>
  <para style="mt2">उत्पत्ति की किताब</para>
  <para style="mt1">उत्पत्ति की किताब</para>
  <para style="imt">परिचय</para>
  <para style="ip">उत्पत्ति शब्द को अर्थ हय “सुरूवात” अऊर यो बाइबल को पुरानो नियम की पहली किताब आय। मूल हिब्रू भी “सुरूवात म” शब्द सी शुरू होवय हय। यो दिखावय हय कि सब कुछ कहां सी आयो अऊर विशेष रूप सी मनुष्यों को संग परमेश्वर को व्यवहार कसो शुरू भयो। अज ज्ञानी लोगों को जवर ऊ व्यक्ति यां व्यक्तियों को बारे म कयी सिद्धान्त हय कि येख ५-६ वी शताब्दी ईसा पहले को पुरानो दस्तावेजों सी तुलना करयो गयो होना। बेबीलोन म दूसरो लोग यो पारंपारिक मान्यता ख स्विकार करय हंय कि मूसा न लगभग १३०० यां १४०० साल ईसा पहले उत्पत्ति, संग म निर्गमन, लैव्यव्यवस्था, गिनती अऊर व्यवस्थाविवरण लिख्यो होतो।</para>
  <para style="ip">उत्पत्ति म बहुत महत्वपूर्न जानकारी हय जो मसीही लोगों ख बाइबल को बाकी हिस्सा, पुरानो अऊर नयो नियम दोयी ख समझन म मदत करय हय। यो हम्ख दिखावय हय कि पाप न संसार म कसो सिरयो अऊर लोगों ख एक उद्धारकर्ता की जरूरत हय। यो लोगों ख बचावन की परमेश्वर की योजना ख भी प्रगट करय हय। येख यीशु को बारे म पहिली भविष्यवानी <char style="xt"><ref loc="GEN 3:15">उत्पत्ति ३:१५</ref></char> अऊर अब्राहम सी धरती पर सब राज्यों ख आशीर्वाद देन को परमेश्वर को वादा <char style="xt"><ref loc="GEN 12:3">उत्पत्ति १२:३</ref> </char>सी देख्यो जाय सकय हय।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. परमेश्वर न संसार अऊर आदम अऊर हवा की रचना करी। <char style="ior"><ref loc="GEN 1-2">१–२</ref></char></para>
  <para style="io1">२. आदम अऊर हवा, उन्को पाप अऊर उन्को वंशजों को वर्णन हय। <char style="ior"><ref loc="GEN 3-5">३–५</ref></char></para>
  <para style="io1">३. नूह अऊर महान बाढ़ को बारे म बतायो हय। <char style="ior"><ref loc="GEN 6-9">६–९</ref></char></para>
  <para style="io1">४. नूह को समय अऊर अब्राहम को समय को बीच का भयो, जेको म बेबीलोन की मीनार भी शामिल हय। <char style="ior"><ref loc="GEN 10-11">१०–११</ref></char></para>
  <para style="io1">५. अब्राहम, ओको परिवार अऊर इस्राएल राज्य की सुरूवात को बारे म हंय। <char style="ior"><ref loc="GEN 12-50">१२–५०</ref></char></para>
  <para style="io1">६. अब्राहम अऊर ओकी पत्नि सारा को जीवन अध्याय १२ सी २५ म शामिल हय।</para>
  <para style="io1">७. इसहाक अऊर ओकी पत्नि रिबका को जीवन अध्याय २१ सी २८ म वर्णन हय, अऊर ओकी मृत्यु को वर्णन अध्याय ३५ म करयो गयो हय।</para>
  <para style="io1">८. याकूब, ओको टुरावों को जीवन अऊर कनान सी मिस्र देश तक उन्को स्थानांतरन अध्याय २५ सी ५० म शामिल हय।</para>
  <para style="io1">९. अध्याय ३७ सी ५० याकूब को पसंद को टुरा यूसुफ को जीवन पर आधारित हय अऊर ऊ मिस्र देश को कसो शासक बन्यो।</para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">जगत को वर्नन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 1:10">इब्रानियों 1:10</ref>; <ref loc="HEB 11:3">11:3</ref></char>
    </note>सुरूवात म परमेश्वर न स्वर्ग अऊर धरती ख बनायो। <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />अऊर धरती बिना आकार कि होती, अऊर धरती पर कुछ भी नहीं होतो, अऊर गहरो पानी को ऊपर अन्धियारो होतो; अऊर परमेश्वर की आत्मा पानी को ऊपर मण्डरावत होतो। <verse eid="GEN 1:2" /><verse number="3" style="v" sid="GEN 1:3" />जब परमेश्वर न आज्ञा दियो, “उजाड़ो हो” अऊर उजाड़ो भय गयो। <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />अऊर परमेश्वर न उजाड़ो ख देख्यो, अऊर ऊ जान गयो कि यो अच्छो हय। तब परमेश्वर न उजाड़ो ख अन्धारो सी अलग कर दियो। <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />तब परमेश्वर न उजाड़ो को नाम “दिन” अऊर अन्धारो को नाम “रात” रख्यो। तब शाम भयी अऊर तब सुबेरे भयी। तब यो पहिलो दिन भय गयो।<verse eid="GEN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />तब परमेश्वर न कह्यो, “पानी को बीच एक असो अन्तर हो कि पानी दोय भाग होय जाये।” <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />तब परमेश्वर न एक अन्तर कर क् ओको खल्लो को पानी अऊर ओको ऊपर को पानी ख अलग अलग करयो; अऊर वसोच भय गयो। <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />अऊर परमेश्वर न ऊ अन्तर ख “आसमान” कह्यो। फिर शाम भयी तब सुबेरे भयी। यो तरह दूसरों दिन भय गयो।<verse eid="GEN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />तब परमेश्वर न आज्ञा दियो, “आसमान को खल्लो को पानी एक जागा म जमा हो जाये अऊर सूखी जमीन दिखायी दे” अऊर वसोच भय गयो। <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />परमेश्वर न सूखी जमीन को नाम “धरती” रख्यो अऊर जो पानी जमा भयो होतो, ओख “समुन्दर” नाम दियो। अऊर परमेश्वर न देख्यो कि यो अच्छो हय। <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />तब परमेश्वर न कह्यो, “धरती सी हरी घास, अऊर बीज वालो छोटो छोटो झाड़, अऊर फर वालो झाड़ भी जिन्को बीज उन्कोच म एक एक की जाति को अनुसार हंय, अऊर धरती पर उगें,” अऊर वसोच भय गयो। <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />यो तरह धरती सी हरी घास, अऊर छोटो छोटो झाड़ जिन्म अपनी अपनी जाति को अनुसार बीज होवय हय, अऊर फर वालो झाड़ जिन्को बीज एक एक की जाति को अनुसार उन्कोच म होवय हंय ऊ उगें: अऊर परमेश्वर न देख्यो कि यो अच्छो हय। <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />फिर शाम भयी फिर सुबेरे भयी। यो तरह तीसरो दिन भय गयो।<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />तब परमेश्वर न आज्ञा दियो, “रात ख दिन सी अलग करन लायी आसमान को अन्तर म ज्योतियां हो; अऊर हि चिन्हों, अऊर ठहरायो हुयो समयों अऊर दिनों, अऊर सालों को चिन्ह हो; <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />अऊर हि धरती ख उजाड़ो देन लायी आसमान म चमकेंन” अऊर वसोच भयो। <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />तब परमेश्वर न दोय बड़ो उजाड़ो बनायो; सूरज न दिन पर शासन करन लायी अऊर चन्दा न रात पर शासन करन लायी; अऊर उन्न तारागन भी बनायो। <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />परमेश्वर न उन्ख आसमान को अन्तर म येकोलायी रख्यो कि हि धरती पर उजाड़ो दे, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />दिन अऊर रात पर शासन करन लायी, अऊर अन्धारो सी उजाड़ो ख अलग करन लायी। अऊर जो कुछ परमेश्वर न देख्यो कि हि अच्छो हंय। <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />तब शाम भयी अऊर सुबेरे भयी। यो तरह चौथो दिन भय गयो।<verse eid="GEN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />तब परमेश्वर न आज्ञा दियो, “पानी जीन्दो प्रानियों सी भरयो रहे, अऊर पक्षी धरती को ऊपर आसमान को ऊपर उड़े, हवा ख पक्षियों सी भरन दे।” <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />येकोलायी परमेश्वर न जाति जाति को बड़ो बड़ो पानी को जीव जन्तुवों, अऊर उन सब जीन्दो प्रानियों की भी रचना करी जो चलतो फिरतो हंय जिन सी पानी बहुतच भर गयो, अऊर एक एक जाति को उड़न वालो पक्षियों की भी रचना करी : अऊर परमेश्वर न देख्यो कि यो अच्छो हंय। <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />अऊर परमेश्वर न उन्ख यो कह्य क आशीर्वाद दियो, “फलो फूलो, अऊर समुन्दर को पानी म भर जावो, अऊर उन्न पक्षियों ख संख्या म बढ़न लायी कह्यो।” <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />तब शाम भयी अऊर सुबेरे भय गयी। यो तरह पाचवों दिन भय गयो।<verse eid="GEN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />तब परमेश्वर न आज्ञा दियो, “धरती म सी एक एक जाति को जीन्दो प्रानी, यानेकि घरेलू जनावर, अऊर रेंगन वालो जन्तु, अऊर धरती को जंगली जनावर, जाति जाति को अनुसार पैदा हो,” अऊर वसोच भय गयो। <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />यो तरह परमेश्वर न धरती को जाति जाति को जंगली जनावरों ख, अऊर जाति जाति को पालतु जनावरों ख, अऊर जाति जाति को जमीन पर सब रेंगन वालो जन्तुवों ख बनायो : अऊर परमेश्वर न देख्यो कि यो अच्छो हय।<verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />तब परमेश्वर न कह्यो, “हम आदमी ख अपनो स्वरूप को अनुसार अपनी समानता म बनायो; अऊर हि समुन्दर की मच्छी, अऊर पालतु जनावरों, अऊर पूरी धरती पर, अऊर सब रेंगन वालो जन्तुवों पर जो धरती पर रेंगय हंय, उन बड़ो छोटो पर अधिकार रखे।” <verse eid="GEN 1:26" /><verse number="27" style="v" sid="GEN 1:27" /><note caller="+" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 19:4">मत्ती 19:4</ref>; <ref loc="MRK 10:6">मरकुस 10:6</ref></char></note>तब परमेश्वर न आदमी ख अपनो स्वरूप को अनुसार पैदा करयो, अऊर अपनोच स्वरूप को अनुसार परमेश्वर न ओख पैदा करयो; अऊर नर अऊर नारी कर क् ओन आदमियों की रचना करी। <verse eid="GEN 1:27" /><verse number="28" style="v" sid="GEN 1:28" />अऊर परमेश्वर न उन्ख आशीर्वाद दियो, अऊर उन्को सी कह्यो, “फूलो फलो, अऊर धरती म भर जावो, अऊर ओख अपनो बस म कर लेवो; अऊर समुन्दर की मच्छी, तथा आसमान की पक्षियों, अऊर धरती पर रेंगन वालो सब जन्तुवों पर अधिकार रखो।” <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />तब परमेश्वर न उन्को सी कह्यो, “सुनो, जितनो बीज वालो छोटो छोटो झाड़ पूरी धरती को ऊपर हंय अऊर जितनो झाड़ म बीज वालो फर होवय हंय, हि सब मय न तुम ख दियो हंय; हि तुम्हरो खान लायी आय। <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />अऊर जितनो धरती को जनावर, अऊर आसमान को पक्षी, अऊर धरती पर रेंगन वालो जन्तु हंय, जिन्म जीवन को जीव हय, उन सब ख खान लायी मय न सब हरो हरो छोटो झाड़ दियो हंय,” अऊर वसोच भय गयो। <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />तब परमेश्वर न जो कुछ बनायो होतो सब ख देख्यो, त का देख्यो, कि ऊ बहुतच अच्छो हय। तथा शाम भयी फिर सुबेरे भयी। यो तरह छठवो दिन भय गयो।<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />यो तरह आसमान अऊर धरती अऊर जो कुछ उन्म हय, इन सब की रचना पूरी भयी। <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" /><note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="HEB 4:4">इब्रानियों 4:4</ref>,<ref loc="HEB 4:10">10</ref></char></note>अऊर परमेश्वर न अपनो काम जेक ऊ करत होतो सातवों दिन ओन खतम करयो, अऊर ओन अपनो करयो हुयो पूरो काम सी सातवों दिन आराम करयो। <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" /><note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="EXO 20:11">निर्गमन 20:11</ref></char></note>अऊर परमेश्वर न सातवों दिन ख आशीर्वाद दियो अऊर पवित्र ठहरायो; कहालीकि ओको म ओन जगत की रचना कर क् अपनो पूरो काम सी आराम करयो होतो।<verse eid="GEN 2:3" /></para>
  <para style="s">आदमी की उत्पत्ति</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />आसमान अऊर धरती की उत्पत्ति को वर्नन यो हय कि जब हि पैदा भयो मतलब जो दिन यहोवा परमेश्वर न धरती अऊर आसमान ख बनायो : <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />पर ऊ समय धरती पर कोयी पौधा नहीं होतो अऊर नहीं जमीन की कोयी बीज अंकुरित भयी होती; कहालीकि प्रभु परमेश्वर न धरती पर पानी नहीं बरसायो होतो, अऊर जमीन पर खेती करन लायी आदमी भी नहीं होतो। <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />ओस धरती सी ऊपर उठत होतो, जेको सी पूरी जमीन सिंची जात होती।<verse eid="GEN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 2:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:7 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 15:45-47">१ कुरिन्थियों 15:45-47</ref>
      </char>
    </note>तब प्रभु परमेश्वर न जमीन सी माटी निकाली अऊर ओको म सी आदमी<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">पहिलो आदमी</char></note> ख बनायो; अऊर ओन अपनी नासिका सी जीवन की श्वास फूक्यो अऊर आदमी एक जीन्दो प्रानी बन गयो।<verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />अऊर प्रभु परमेश्वर न पूर्व दिशा म अदन म एक बगीचा लगायो, अऊर उत ओन ऊ आदमी ख रख्यो जो ओन बनायो होतो। <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" /><note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 2:7">प्रकाशितवाक्य 2:7</ref>; <ref loc="REV 22:2">22:2</ref>; <ref loc="REV 14">14</ref></char></note>अऊर यहोवा परमेश्वर न जमीन सी सब तरह को झाड़, जो देखनो म सुन्दर अऊर जिन्को फर खानो म अच्छो हंय, जमीन सी जगायो, अऊर बगीचा को बीच म जीवन को झाड़ ख अऊर भलो या बुरो ज्ञान को झाड़ ख भी लगायो।<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:10 </char>
      <char style="xt" closed="false">
        <ref loc="EZK 47:11">यहेजकेल 47:11</ref>
      </char>
    </note>ऊ बगीचा ख सींचन लायी एक महा नदी अदन सी निकली अऊर उत सी बह क चार नदियों म बट गयी। <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />पहिली नदी को नाम पीशोन हय; या वाच नदी आय जो हवीला देश को चारों तरफ बह हय, जित सोनो मिलय हय। <verse eid="GEN 2:11" /><verse number="12" style="v" sid="GEN 2:12" />ऊ देश को सोनो शुद्ध होवय हय; उत मोती अऊर सुलैमानी गोटा भी मिलय हंय। <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />दूसरी नदी को नाम गीहोन हय; या वाच नदी आय जो कूश देश को चारों तरफ बह हय। <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />अऊर तीसरी नदी को नाम हिद्देकेल हय; या वाच आय जो अश्शूर देश की पूर्व दिशा म बहय हय। अऊर चौथी नदी को नाम फरात हय।<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />तब प्रभु परमेश्वर न आदमी ख ले क अदन को बगीचा म रख दियो, कि ऊ ओको म काम करे अऊर ओकी रक्षा करे। <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />अऊर प्रभु परमेश्वर न आदमी ख आज्ञा दी, “तुम बगीचा को सब झाड़ को फर बिना झीझक खाय सकय हय; <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />पर भलो या बुरो को ज्ञान को जो झाड़ हय, ओको फर तुम कभी मत खाजो : कहालीकि जो दिन तुम ओको फर खावो उच दिन जरूर मर जाजो।”<verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />तब प्रभु परमेश्वर न कह्यो, “आदमी को अकेलो रहनो अच्छो नहीं; मय ओकी मदद लायी एक असो संगी बनाऊं जो ओको सी मेल खाये।” <verse eid="GEN 2:18" /><verse number="19" style="v" sid="GEN 2:19" /><note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="PSA 8:6">भजन 8:6</ref></char></note>येकोलायी प्रभु परमेश्वर जमीन सी कुछ माटी ली अऊर पूरो जनावरों अऊर आसमान को सब पक्षियों ख रच क आदमी को जवर आयो कि ऊ उन्को का का नाम रखेंन; अऊर जो जो जीन्दो प्रानी को जो जो नाम आदम न रख्यो उच ओको नाम होयेंन। <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />त ऊ आदमी न सब जाति को पालतु जनावरों, अऊर आसमान को पक्षियों, अऊर सब जाति को जंगली जनावरों को नाम रख्यो; पर आदमी लायी कोयी असो मदद करन लायी नहीं मिल्यो जो ओको सी मेल खाय सके।<verse eid="GEN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 2:21" />तब प्रभु परमेश्वर न आदम ख गहरी नींद म डाल दियो, अऊर जब ऊ सोय गयो, ओन आदम की एक फसली निकाली अऊर मांस ख भर दियो। <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />अऊर प्रभु परमेश्वर न ऊ फसली ख जो ओन आदमी म सी निकाली होती, ओन एक बाई बनायी; अऊर ओख आदम को जवर लायो। <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" /><note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 29:14">उत्पत्ति 29:14</ref></char></note>तब ऊ आदम न कह्यो,</para>
  <para style="q1" vid="GEN 2:23">“अब यो मोरी हड्डियों म की हड्डी अऊर मोरो मांस म को मांस हय;</para>
  <para style="q1" vid="GEN 2:23">येकोलायी येको नाम ‘बाई’ होयेंन,</para>
  <para style="q1" vid="GEN 2:23">कहालीकि ओख आदम म सी बाहेर निकाली गयी हय।”<verse eid="GEN 2:23" /></para>
  <para style="m">
    <verse number="24" style="v" sid="GEN 2:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:5">मत्ती 19:5</ref>; <ref loc="MRK 10:7">मरकुस 10:7</ref>,<ref loc="MRK 10:8">8</ref>; <ref loc="1CO 6:16">१ कुरिन्थियों 6:16</ref>; <ref loc="EPH 5:31">इफिसियों 5:31</ref></char>
    </note>योच वजह हय कि आदमी अपनो माय बाप ख छोड़ क अपनी पत्नी सी मिल्यो रहेंन, अऊर हि एक जुट बन्यो रहेंन।<verse eid="GEN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 2:25" />आदम अऊर ओकी पत्नी दोयी नंगा होतो, पर हि लज्जित नहीं होतो।<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">आदमी न परमेश्वर की आज्ञा नहीं मानी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:1 </char>
      <char style="xt" closed="false">
        <ref loc="REV 12:9">प्रकाशितवाक्य 12:9</ref>; <ref loc="REV 20:2">20:2</ref></char>
    </note>उन सब जंगली प्रानियों म जिन्ख प्रभु परमेश्वर न बनायो होतो, उन सब म सांप चालाक होतो। ओन बाई सी कह्यो, “का सचमुच परमेश्वर न कह्यो हय, तुम यो बगीचा को कोयी झाड़ को फर नहीं खावो?”<verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />बाई न सांप ख उत्तर दियो, “हम यो बगीचा को झाड़ को फर खाय सकजे हंय;” <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />पर परमेश्वर न हमरो सी कह्यो, “बगीचा को बीच म लग्यो हुयो झाड़ को फर मत खावो, अऊर नहीं ओख छूवो, नहीं त तुम मर जावो।”<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />तब सांप न बाई सी कह्यो, “यो सच नोहोय; तुम कभी नहीं मरो! <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" /><note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="EZK 28:2">यहेजकेल 28:2</ref></char></note>बल्की परमेश्वर खुद जानय हय कि जो दिन तुम ओको फर खावो उच दिन तुम्हरी आंखी खुल जायेंन, अऊर तुम भलो बुरो को ज्ञान पा क परमेश्वर को जसो बन जावो।”<verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />जब बाई न देख्यो कि झाड़ कितनो सुन्दर होतो अऊर ओको फर खानो म कितनो अच्छो होयेंन, अऊर ओन सोच्यो कि बुद्धिमान बनन लायी यो कितनो लायक होयेंन। येकोलायी ओन कुछ फर ले लियो अऊर खाय लियो अऊर अपनो पति ख भी दियो, अऊर ओन ओख भी खायो। <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />तब उन दोयी की आंखी खुल गयी, अऊर उन्ख मालूम भयो कि हि नंगा हय; येकोलायी उन्न अंजीर को पत्ता ख एक संग सिल दियो अऊर खुद ख झाक लियो।<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />जब शाम ख उन्न प्रभु परमेश्वर ख बगीचा म घुमतो हुयो सुन्यो, तब आदमी अऊर ओकी पत्नी बगीचा को झाड़ को बीच म प्रभु परमेश्वर सी लूक गयो। <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />पर प्रभु परमेश्वर न आदम ख पुकारयो, “तुम कित हय?”<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />ओन उत्तर दियो, “मय न तुम ख बगीचा म घुमतो हुयो सुन्यो; मय डर गयो, अऊर तोरो सी लूक गयो, कहालीकि मय नंगा होतो।”<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />प्रभु परमेश्वर न पुच्छ्यो, “कौन न तोरो सी कह्यो कि तय नंगा हय? का तय न ऊ झाड़ को फर खायो हय, जेक मय न खान लायी नहीं कह्यो होतो?”<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />आदम न उत्तर दियो, “जो बाई तुम न मोरो संग रहन लायी दियो हय, ओन ऊ झाड़ को फर मोख दियो, अऊर मय न खाय लियो।”<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />प्रभु परमेश्वर न बाई सी पुच्छ्यो, “यो तुम न असो कहाली करयो?”</para>
  <para style="p" vid="GEN 3:13">बाई न उत्तर दियो, “सांप न मोख बहकाय दियो अऊर मय न फर खाय लियो।”<verse eid="GEN 3:13" /></para>
  <para style="s">परमेश्वर को न्याय</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />तब प्रभु परमेश्वर न सांप सी कह्यो, “तुम न जो यो करयो हय येकोलायी तुम सब पालतु जनावरों अऊर सब जंगली जनावरों सी जादा श्रापित हय; अब सी तुम पेट को बल चलजो, अऊर जब तक जीन्दो रहो तब तक तुम्ख धूल चाटनो पड़ेंन <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />अऊर मय तोरो अऊर बाई को बीच म, अऊर तोरो वंश अऊर येको वंश को बीच म घृना पैदा करूं; अऊर ओको वंश तुम्हरी मुंड ख कुचल देयेंन, अऊर तुम ओकी एड़ी ख डसो।”<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">प्रकाशितवाक्य 12:17</char></note><verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />प्रभु परमेश्वर न बाई सी कह्यो, “मय तोरी पीड़ा अऊर तोरो गर्भवती होन को दु:ख ख बहुत बढ़ाऊं; अऊर तय पीड़ित होय क बच्चा पैदा करजो; अऊर तोरी इच्छाये तोरो पति को तरफ होयेंन, अऊर ऊ तोरो पर शासन करेंन।”<verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />प्रभु परमेश्वर न आदम सी कह्यो, “तय न अपनी पत्नी की बात सुनी, अऊर ऊ झाड़ को फर खायो जेको बारे म मय न तोख आज्ञा दी होती कि तय ओको फर नहीं खाजो, ओख तय न खायो हय येकोलायी जमीन तोरो वजह श्रापित हय। तय ओकी फसल खान लायी तोख जीवन भर कठोर परिश्रम करनो पड़ेंन। <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />अऊर ऊ तोरो लायी काटा अऊर ऊंटकटारे उगायेंन, अऊर तोख जंगली पौधा ख खानो पड़ेंन।<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">इब्रानियों 6:8</char></note> <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />अऊर अपनो मस्तक को पसीना की रोटी खायो करजो, अऊर आखरी म माटी म मिल जाजो कहालीकि तय ओकोच म सी निकाल्यो गयो हय; तय माटी त आय अऊर माटी मच फिर मिल जाजो।”<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />आदम न अपनी पत्नी को नाम हवा रख्यो; कहालीकि वा पूरो आदमियों की माय बनी। <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />अऊर प्रभु परमेश्वर न आदम अऊर ओकी पत्नी लायी जनावरों की खाल सी कपड़ा बनायो, अऊर ओन ओख कपड़ा पहिनायो।<verse eid="GEN 3:21" /></para>
  <para style="s">आदम अऊर हवा ख बगीचा सी निकाल्यो जानो</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />तब प्रभु परमेश्वर न कह्यो, “अब हि आदमी भलो अऊर बुरो ख जान क हम म सी एक को जसो भय गयो हंय, अब कहीं असो नहीं होय कि ऊ हाथ बढ़ाय क जीवन को झाड़ को फर तोड़ ले, अऊर ओख खाय क अमर होय जाये।”<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="ft" closed="false">प्रकाशितवाक्य 22:14</char></note> <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />येकोलायी प्रभु परमेश्वर न आदमी ख अदन को बगीचा म सी निकाल दियो कि ऊ वा जमीन पर खेती करे, जेको म सी आदमी ख बनायो गयो होतो। <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />ओन आदम ख निकाल दियो, ओन जीवन को झाड़ को तरफ जान वालो रस्ता की देखभाल करन लायी अदन को बगीचा की पूर्व दिशा म करूबों<note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="ft" closed="false">पंख वालो स्वर्गदूत</char></note> अऊर जीन्दो प्रानियों अऊर एक धधकती तलवार ख नियुक्त करयो।<note caller="+" style="x"><char style="xo" closed="false">3:24 </char><char style="xt" closed="false"><ref loc="EZK 28:16">यहेजकेल 28:16</ref></char></note><verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">कैन अऊर हाबिल</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />जब आदम अपनी पत्नी हवा को जवर गयो तब वा गर्भवती भयी तब ओन कैन ख जनम दियो अऊर कह्यो, “प्रभु की मदत सी मय न एक बेटा पा लियो हय।” <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />तब बाद म हवा न अऊर एक बेटा, हाबिल ख जनम दियो। तब हाबिल मेंढावों को चरवाहा बन गयो, लेकिन कैन खेती करन वालो किसान होतो। <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />कुछ दिनों बाद कैन अपनी फसल ले क आयो अऊर ओख प्रभु ख भेंट को रूप म दियो। <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />तब हाबिल न अपनी शेरी अऊर मेंढी म सी कुछ एक ख जो पैदा हुयो पहिलो मेंढी को बच्चा चर्बी युक्त भेंट चढ़ायी; तब प्रभु न हाबिल अऊर ओकी भेंट सी प्रसन्न भयो,<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EXO 34:19">निर्गमन 34:19</ref>; <ref loc="HEB 11:4">इब्रानियों 11:4</ref></char></note> <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />लेकिन ओन कैन अऊर ओकी भेंट ख अस्वीकार कर दियो। येकोलायी कैन बहुत गुस्सा भयो, अऊर ओको मुंह पर उदासी छाय गयी। <verse eid="GEN 4:5" /><verse number="6" style="v" sid="GEN 4:6" />तब प्रभु न कैन सी कह्यो, “तय कहाली गुस्सा होय रह्यो हय? अऊर तोरो मुंह पर उदासी कहाली छायी हुयी हय?” <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />यदि तय न सही काम करयो रह्यतो, त का म तोख ग्रहन नहीं करतो; किन्तु यदि तय भलायी नहीं करजो त देख; तोरो दरवाजा पर पाप खड़ो हय, अऊर यो तोरो पर शासन करनो चाहवय हय, लेकिन तोख येख दूर करनो पड़ेंन।<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />तब कैन न हाबिल सी कह्यो, “आवो हम खेत ख निकलजे हंय।” जब हि खेत को बाहेर होतो, त कैन न अपनो भाऊ हाबिल पर चढ़ क ओख मार डाल्यो।<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="MAT 23:35">मत्ती 23:35</ref>; <ref loc="JOL 3:12">योएल 3:12</ref>; <ref loc="REV 10:3">प्रकाशितवाक्य 10:3</ref></char></note><verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />प्रभु न कैन सी कह्यो, “तोरो भाऊ हाबिल कित हय?”</para>
  <para style="p" vid="GEN 4:9">ओन उत्तर दियो, “मोख नहीं मालूम। त कैन न कह्यो का मय अपनो भाऊ को रखवाली करन वालो आय?”<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />तब प्रभु न कह्यो, “तय न यो भयानक काम कहाली करयो हय? तोरो भाऊ को खून जमीन सी मोख बुलाय रह्यो हय।<note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="HEB 12:24">इब्रानियों 12:24</ref></char></note> <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />अब तय वा जमीन को तरफ सी श्रापित हय, जेन तोरो भाऊ को खून तोरो हाथ सी स्वीकार करन लायी अपनो मुंह खोल्यो हंय। <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />जब तय जमीन पर खेती करन की कोशिश करजो, त माटी तोरो लायी कुछ पैदा नहीं करेंन; अऊर तय धरती पर बेघर होय जाजो अऊर भटकन वालो होयजो।”<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />अऊर कैन न परमेश्वर सी कह्यो, “यो सजा मोरो लायी सहन करनो बहुत कठिन हय। <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />देख, तय न अज मोख जमीन सी हटाय दियो हंय, अऊर मय तोरी नजर की आड़ म रहूं, अऊर धरती पर एक बेघर होय जाऊं अऊर भटकूं, अऊर जो कोयी मोख मिलेंन ऊ मोख मार डालेंन।”<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />परमेश्वर न कैन सी कह्यो, “असो नहीं होयेंन। जो कोयी कैन ख मार डालेंन ओको सी सात गुना बदला ले लियो जायेंन।” येकोलायी प्रभु न कैन पर एक चिन्ह डाल दियो कि ओख पान वालो कोयी भी ओकी हत्या नहीं करे। <verse eid="GEN 4:15" /><verse number="16" style="v" sid="GEN 4:16" />तब कैन प्रभु की उपस्थिति सी दूर चली गयो अऊर “नोद”<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="ft" closed="false">भगोड़ा</char></note> नाम को देश म रहन लग्यो, जो कि अदन की पूर्व दिशा म हय।<verse eid="GEN 4:16" /></para>
  <para style="s">कैन को वंशज</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />जब कैन अपनी पत्नी को जवर गयो तब वा गर्भवती भयी, अऊर ओन हनोक ख जनम दियो; तब कैन न एक नगर बसायो अऊर ऊ नगर को नाम अपनो बेटा को नाम पर हनोक रख्यो। <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />हनोक सी ईराद पैदा भयो, अऊर ईराद सी महूयाएल, अऊर महूयाएल सी मतूशाएल, अऊर मतूशाएल सी लेमेक पैदा भयो। <verse eid="GEN 4:18" /><verse number="19" style="v" sid="GEN 4:19" />लेमेक की दोय पत्नी होती। एक को नाम आदा अऊर दूसरी को नाम सिल्ला होतो। <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />आदा न याबाल ख जनम दियो। याबाल उन लोगों को बुजूर्ग बन्यो जो तम्बुवों म रहत होतो अऊर जनावर पालत होतो। <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />अऊर ओको भाऊ को नाम यूबाल होतो। ऊ वीणा अऊर बांसुरी बजावन वालो को पूर्वज होतो। <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />अऊर सिल्ला न तूबल अऊर कैन ख जनम दियो, ऊ पीतर अऊर लोहा को सब धार वालो हथियार बनान वालो पहिलो धातुकार होतो। तूबल कैन की बहिन नामा होती।<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />अऊर लेमेक न अपनी पत्नियों सी कह्यो,</para>
  <para style="q1" vid="GEN 4:23">“हे आदा अऊर हे सिल्ला मोरी बात सुनो; हे लेमेक की पत्नियों, मोरी बात पर ध्यान देवो :</para>
  <para style="q1" vid="GEN 4:23">जो आदमी न मोख घायल करयो, अऊर जो जवान न मोख चोट पहुंचायी, ओख मय न मार डाल्यो हय।<verse eid="GEN 4:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 4:24" />अगर कैन को बदला सात गुना लियो जायेंन,</para>
  <para style="q1" vid="GEN 4:24">त लेमेक को सतहत्तर गुना लियो जायेंन।”<note caller="+" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="MAT 18:22">मत्ती 18:22</ref></char></note><verse eid="GEN 4:24" /></para>
  <para style="s">शेत अऊर एनोश</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />अऊर आदम अपनी पत्नी को जवर फिर गयो; अऊर ओन एक बेटा ख जनम दियो अऊर ओको नाम यो कह्य क शेत रख्यो कि : “परमेश्वर न मोरो लायी हाबिल को बदला, जेक कैन न मार डाल्यो होतो, येकोलायी परमेश्वर न हाबिल की जागा पर यो दूसरो बच्चा प्रदान करयो हय।” <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />अऊर शेत ख भी एक टुरा पैदा भयो अऊर ओन ओको नाम एनोश रख्यो; ऊ समय सी लोग प्रभु को नाम सी आराधना करन लग्यो।<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">आदम की वंशावली</para>
  <para style="r">(<ref loc="1CH 1:1-4">१ इतिहास 1:1-4</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:1 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:27">उत्पत्ति 1:27</ref>
      </char>
    </note>आदम की वंशावली को विवरन यो तरह हय। जब परमेश्वर न आदम ख बनायो त ओन उन्ख अपनो जसो बनायो। <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />ओन उन्ख नर अऊर नारी बनायो, जब हि दोयी बनायो गयो, तब ओन ओको नाम आदम रख्यो अऊर उन्ख आशीर्वाद दियो। <verse eid="GEN 5:2" /><verse number="3" style="v" sid="GEN 5:3" />जब आदम एक सौ तीस साल को भयो, तब ओको सी ओको जसो एक टुरा पैदा भयो जो ओको समान होतो, अऊर ओन ओको नाम शेत रख्यो। <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />अऊर शेत को जनम को बाद आदम आठ सौ साल तक जीन्दो रह्यो, अऊर ओख अऊर भी टुरा टुरी पैदा भयो। <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />यो तरह आदम कुल नव सौ तीस साल जीन्दो रह्यो, तब बाद म ओकी मृत्यु भय गयी।<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />जब शेत एक सौ पाच साल को भयो, तब ओको सी एनोश पैदा भयो। <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />एनोश को जनम को बाद शेत आठ सौ सात साल तक जीन्दो रह्यो, अऊर ओख अऊर भी टुरा टुरी पैदा भयी। <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />यो तरह शेत कुल नव सौ बारा साल जीन्दो रह्यो; ओको बाद ओकी मृत्यु भय गयी।<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />जब एनोश नब्बे साल को भयो, तब ओन केनान ख पैदा करयो। <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />केनान को जनम को बाद एनोश आठ सौ पन्द्रा साल तक जीन्दो रह्यो, अऊर ओख अऊर भी टुरा टुरी पैदा भयी <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />यो तरह एनोश कुल नव सौ पाच साल जीन्दो रह्यो; ओको बाद ओकी मृत्यु भय गयी।<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />जब केनान सत्तर साल को भयो, तब ओन महल्लेल ख पैदा करयो। <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />महल्लेल को जनम को बाद केनान आठ सौ चालीस साल तक जीन्दो रह्यो, अऊर ओख अऊर भी टुरा टुरी पैदा भयी। <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />यो तरह केनान कुल नव सौ दस साल जीन्दो रह्यो; ओको बाद ओकी मृत्यु भय गयी।<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />जब महल्लेल पैसठ साल को भयो, तब ओन येरेद ख पैदा करयो। <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />येरेद को जनम को बाद महल्लेल आठ सौ तीस साल तक जीन्दो रह्यो, अऊर ओख अऊर भी टुरा टुरी भयी। <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />यो तरह महल्लेल कुल आठ सौ पंचानबे साल जीन्दो रह्यो; ओको बाद ओकी मृत्यु भय गयी।<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />जब येरेद एक सौ बाहसठ साल को भयो, तब ओन हनोक ख पैदा करयो। <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />हनोक को जनम को बाद येरेद आठ सौ साल तक जीन्दो रह्यो, अऊर ओख अऊर भी टुरा टुरी भयी। <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />यो तरह येरेद कुल नव सौ बाहसठ साल जीन्दो रह्यो; ओको बाद ओकी मृत्यु भय गयी।<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />जब हनोक पैसठ साल को भयो, तब ओन मतूशेलह ख पैदा करयो। <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />मतूशेलह को जनम को बाद हनोक तीन सौ साल तक परमेश्वर को संग संग चलतो रह्यो, अऊर ओख अऊर भी टुरा टुरी भयी। <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />यो तरह हनोक कुल तीन सौ पैसठ साल जीन्दो रह्यो। <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />हनोक परमेश्वर को संग संग चलत होतो; तब ऊ गायब भय गयो, कहालीकि परमेश्वर न ओख उठाय लियो।<note caller="+" style="x"><char style="xo" closed="false">5:24 </char><char style="xt" closed="false"><ref loc="HEB 11:5">इब्रानियों 11:5</ref>; <ref loc="JOS 14">यहोशू 14</ref>; <ref loc="JHN 14">यूहन्ना 14</ref></char></note><verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />जब मतूशेलह एक सौ सत्तासी साल को भयो, तब ओको सी लेमेक ख पैदा करयो। <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />लेमेक को जनम को बाद मतूशेलह सात सौ बयासी साल तक जीन्दो रह्यो, अऊर ओख अऊर भी टुरा टुरी भयी। <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />यो तरह मतूशेलह कुल नव सौ उनसत्तर साल जीन्दो रह्यो; ओको बाद ओकी मृत्यु भय गयी।<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />जब लेमेक एक सौ बयासी साल को भयो, तब ओन एक बच्चा पैदा करयो। <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />अऊर ओन ओको नाम नूह रख्यो, अऊर कह्यो, “जो जमीन ख प्रभु न श्राप दियो हय, ओको बारे म यो लड़का हमरो कार्य करतो समय हमरो कठिन कामों म जो हम करजे हंय, यो हम्ख आराम देयेंन।” <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />नूह को जनम को बाद लेमेक पाच सौ पंचानबे साल तक जीन्दो रह्यो, अऊर ओख अऊर भी टुरा टुरी भयी। <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />यो तरह लेमेक कुल सात सौ सतहत्तर साल जीन्दो रह्यो; ओको बाद ओकी मृत्यु भय गयी।<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />अऊर जब नूह पाच सौ साल को भयो, तब ओन शेम, हाम अऊर येपेत ख पैदा करयो।<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">आदमी जाति की दुष्टता</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />जब आदमी जमीन पर बहुत बढ़न लग्यो, तब उन्ख बेटियां पैदा होन लगी, <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />तब परमेश्वर को बेटावों न आदमी की बेटियों ख देख्यो, कि हि सुन्दर हंय, अऊर उन्न जेक जेक चाह्यो ओन बिहाव कर लियो। <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />तब परमेश्वर न कह्यो, “मोरी आत्मा आदमी म हमेशा निवास नहीं करेंन, कहालीकि आदमी भी शरीरच आय; ओकी उमर एक सौ बीस साल की होयेंन।” <verse eid="GEN 6:3" /><verse number="4" style="v" sid="GEN 6:4" /><note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="NUM 13:33">गिनती 13:33</ref></char></note> उन दिनो म धरती पर दानव<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">नपेली लोग</char></note> रहत होतो; अऊर येको बाद जब परमेश्वर को बेटा अऊर आदमी की बेटियों को जवर गयो तब उन्को द्वारा जो बेटा पैदा भयो हि प्राचीनकाल को शक्तिशाली अऊर प्रसिद्ध वीर होतो।<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />परमेश्वर न देख्यो कि आदमियों की बुरायी धरती पर बढ़ गयी हय, अऊर उन्को मन को बिचार म जो कुछ पैदा होवय हय ऊ हर समय बुरायी लायीच होवय हंय।<note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="MAT 24:37">मत्ती 24:37</ref>; <ref loc="LUK 17:26">लूका 17:26</ref></char></note> <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />यो बात सी प्रभु ख दु:ख भयो कि ओन धरती पर आदमी ख बनायो, अऊर ओको मन ख बहुत ठेस पहुंची। <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />तब परमेश्वर न कह्यो, “मय आदमी ख जेकी मय न सृष्टि करी हय धरती को ऊपर सी मिटाय देऊं; का आदमी, का, जनावर, का रेंगन वालो जन्तु, का आसमान को पक्षी, सब ख मिटाय देऊं, कहालीकि मोख यो बात को दु:ख हय कि मय न उन्ख बनायो।” <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />पर परमेश्वर को अनुग्रह की नजर नूह पर बनी रही।<verse eid="GEN 6:8" /></para>
  <para style="s">नूह</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />नूह की वंशावली यो हय। नूह सच्चो पुरुष अऊर अपनो समय को लोगों म खरो होतो; अऊर नूह परमेश्वर कोच संग संग चलतो रह्यो। <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />अऊर नूह सी शेम, हाम, अऊर येपेत नाम को तीन बेटा पैदा भयो। <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />ऊ समय परमेश्वर की नजर म धरती भ्रष्ट होय गयी होती, अऊर धरती हिंसा सी भर गयी होती <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />अऊर परमेश्वर न धरती ख देख्यो कि वा भ्रष्ट भय गयी हय; कहालीकि पूरो प्रानियों न धरती पर अपनो चाल चलन भ्रष्ट कर लियो होतो।<verse eid="GEN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 6:13" />तब परमेश्वर न नूह सी कह्यो, “मय न पूरो प्रानियों को अन्त करन को निश्चय करयो हय; उन्को वजह धरती हिंसा सी भर गयी हय, येकोलायी मय उन्ख धरती समेत नाश कर डालूं। <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />येकोलायी तय गोपेर झाड़ की लकड़ी को एक जहाज बनाय ले, ओको म कमरा बनायजो, अऊर अन्दर बाहेर ओको पर राल<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">चिपकावन वाली चिज</char></note> लगायजो। <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />यो रीति सी तय जहाज बनायजो: अऊर जहाज की लम्बाई चार सौ पचास फीट, पछात्तर फीट चौड़ो, अऊर ऊचो पैतालीस फीट रखजो। <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />जहाज म एक खिड़की बनायजो, अऊर ओको अठरा इंच ऊपर छत बनायजो, अऊर जहाज म एक तरफ दरवाजा रखजो; अऊर जहाज म पहिलो, दूसरो, तीसरो खण्ड बनायजो। <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />अऊर मय आसमान को खल्लो उन पूरी प्रानियों ख, जेको म जीवन की श्वास हय, नाश करन लायी धरती पर जल प्रलय करूं; अऊर धरती को पूरो प्रानी मर जायेंन। <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />पर मय तोरो संग एक वाचा बान्धू हय; येकोलायी तय अपनी पत्नी, अपनो बेटां, अऊर बहुवों समेत जहाज म प्रवेश करजो। <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />अऊर पूरी जाति को जीन्दो प्रानियों म सी दोय दोय, नर अऊर मादा, अपनो संग जहाज म ले जाजो जेको सी हि तोरो संग जीन्दो रहे। <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />हर एक जाति को पक्षियों, जनावरों, जमीन पर रेंगन वालो जन्तुवों म सी दोय दोय तोरो जवर आयेंन कि तय उन्ख जीन्दो रखजो। <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />हर एक तरह को भोजन जो खायो जायेंन, उन्ख तय ले क अपनो जवर जमा कर लेजो; जो तोरो अऊर उन्को भोजन लायी होयेंन।” <verse eid="GEN 6:21" /><verse number="22" style="v" sid="GEN 6:22" />नूह न असोच करयो, ओन परमेश्वर की आज्ञा को अनुसार सब कुछ करयो।<note caller="+" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="HEB 11:7">इब्रानियों 11:7</ref></char></note><verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">जल प्रलय</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />परमेश्वर न नूह सी कह्यो, “तय अपनो पूरो परिवार सहित जहाज म जावो; कहालीकि मय न यो समय को लोगों म सी केवल तोख अपनी नजर म सच्चो पायो हय। <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" /><note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="LEV 11">लैव्यव्यवस्था 11</ref></char></note>तय सब जाति को शुद्ध जनावरों म सी नर अऊर मादा को सात जोड़ा अऊर अशुद्ध जनावरों म सी नर मादा को एक एक जोड़ा लेजो। <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />अऊर आसमान को पक्षियों म सी नर अऊर मादा को सात सात जोड़ा लेजो, जेको सी पूरी धरती पर उन्की जाति जीन्दी रहे। <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />कहालीकि अब सी सात दिन को बाद चालीस दिन अऊर चालीस रात तक धरती पर पानी बरसातो रहूं; अऊर उन सब प्रानियों ख जमीन को ऊपर सी मिटाय देऊं, जिन्ख मय न बनायो होतो।” <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />नूह न परमेश्वर की आज्ञा को अनुसार सब कुछ करयो।<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />जब धरती पर जल प्रलय भयो, तब नूह की उमर छय सौ साल की होती।<note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="MAT 24:38-39">मत्ती 24:38-39</ref>; <ref loc="LUK 17:27">लूका 17:27</ref></char></note> <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />नूह जल प्रलय सी बचन लायी अपनी पत्नी, बेटां, अऊर बहुवों को संग जहाज म गयो। <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />शुद्ध अऊर अशुद्ध, दोयी तरह को जनावरों म सी, अऊर रेंगन वालो पूरो जन्तुवों म सी भी, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />दोय दोय, यानेकि नर अऊर मादा, नूह को संग जहाज म गयो, जसो परमेश्वर न नूह ख आज्ञा दी होती। <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />सात दिन को बाद धरती पर प्रलय को पानी बरसन लग्यो।<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />जो साल नूह छय सौ साल को भयो, ओको दूसरों महीना को सत्राहवों दिन आयो; उच दिन बड़ो गहरो समुन्दर को सब झरना फूट पड़्यो, अऊर आसमान को पूरो पानी की रस्ता खुल गयी।<note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="2PE 3:6">२ पतरस 3:6</ref></char></note> <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />चालीस दिन अऊर चालीस रात तक धरती पर बारीश होती रही। <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />ठीक उच दिन नूह न अपनी पत्नी अऊर बेटा शेम, हाम, अऊर येपेत नाम को बेटा, अऊर तीनो बहुवों को संग जहाज म सिरयो। <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />अऊर उन्को संग हर एक जाति को जंगली जनावर, पालतु जनावर, अऊर धरती पर रेंगन वालो जन्तु अऊर जाति जाति को उड़न वालो पक्षी, जहाज म गयो। <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />हर एक प्रानियों म सी दोय दोय प्रानी जिन्म जीवन की श्वास होती, हि नूह को संग जहाज म गयो। <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />हर एक प्रानियों को नर अऊर मादा जहाज म गयो, जसो परमेश्वर न आज्ञा दियो होतो। तब परमेश्वर न नूह को जहाज को दरवाजा बन्द कर दियो।<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />धरती पर चालीस दिन तक जल प्रलय होतो रह्यो; अऊर पानी बहुत बड़तो गयो, जेको सी जहाज ऊपर उठन लग्यो; अऊर ऊ धरती पर सी ऊचो उठ गयो। <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />पानी बढ़तो बढ़तो धरती पर बहुतच बढ़ गयो, अऊर जहाज पानी को ऊपर ऊपर तैरन लग्यो। <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />पानी बढ़ क धरती पर इतनो बढ़ गयो, कि आसमान को खल्लो की पूरी ऊची ऊची पहाड़ी भी ओको म डुब गयी। <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />पानी पच्चीस फीट अऊर ऊपर बढ़ गयो। अऊर पहाड़ी भी डुब गयी। <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />अऊर का पक्षी, का घरेलू जनावर, का जंगली जनावर, अऊर धरती पर सब चलन वालो प्रानी, अऊर जितनो जीव जन्तु, यानेकि धरती को हर एक आदमी मर गयो। <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />जो जो जमीन पर होतो, जितनो को शरीर म जीवन की श्वास होती, सब मर गयो। <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />परमेश्वर न जमीन पर रहन वालो हर एक जीन्दो प्रानी ख, आदमी अऊर जनावर ख, रेंगन वालो जन्तुवों ख, अऊर आसमान को पक्षियों ख मिटाय डाल्यो; केवल नूह अऊर जितनो ओको संग जहाज म होतो, हिच बच गयो। <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />अऊर पानी धरती पर एक सौ पचास दिन तक बन्यो रह्यो।<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">जल प्रलय को अन्त</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />पर परमेश्वर न नूह अऊर जितनो जंगली जनावर अऊर पालतु जनावरों की सुधि ली, जो जहाज म ओको संग होतो, अऊर परमेश्वर न धरती पर हवा चलायी, अऊर पानी घटन लग्यो; <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />अऊर गहरो समुन्दर को झरना अऊर आसमान को झरोका बन्द होय गयो; अऊर ओको सी जो बारीश होत होती, वा भी रुक गयी; <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />अऊर एक सौ पचास दिन को बाद पानी धरती पर सी लगातार घटन लग्यो। <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />अऊर जहाज सातवों महीना को सत्राहवों दिन अरारात नाम की पहाड़ी पर टिक गयो। <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />अऊर पानी दसवों महीना तक घटतो चली गयो, अऊर दसवों महीना को पहिलो दिन पहाड़ी की सेंडी दिखायी दी।<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />तब असो भयो कि चालीस दिन को बाद नूह न अपनो बनायो हुयो जहाज की खिड़की ख खोल क, <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />ओन एक कौवा उड़ाय दियो : अऊर जब तक पानी धरती पर सी सूख नहीं गयो, तब तक कौवा इत उत उड़तो रह्यो। <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />तब नूह न अपनो जवर सी एक कबूत्तरी ख भी उड़ाय दियो कि देखबो कि पानी धरती पर सी घट गयो कि नहीं। <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />ऊ कबूत्तरी ख अपनो पाय टेकन लायी आधार नहीं मिल्यो, त कबूत्तरी नूह को जवर जहाज म वापस चली गयो: कहालीकि पूरी धरती को ऊपर पानीच पानी छायो होतो तब नूह न हाथ बढ़ाय क ओख अपनो जवर जहाज म ले लियो। <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />तब ऊ अऊर सात दिन तक रुक्यो रह्यो, अऊर ओन उच कबूत्तरी ख जहाज म सी फिर सी उड़ाय दियो। <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />अऊर कबूत्तरी शाम को समय ओको जवर आय गयो, त ओन यो देख्यो कि ओकी चोच म जैतून को एक नयो पत्ता हय; येको सी नूह न जान लियो कि पानी धरती पर सी घट गयो हय। <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />तब नूह न सात दिन अऊर रुक क उच कबूत्तरी ख उड़ाय दियो; किन्तु ऊ ओको जवर फिर वापस नहीं आयी।<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />जो साल नूह छय सौ एक साल को भयो, ओको पहिलो महीना को पहिलो दिन धरती को पानी सूख गयो। तब नूह न जहाज की छत खोल क चारयी तरफ देख्यो कि जमीन सूख रही हय। <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />अऊर दूसरों महीना को सत्ताईसवों दिन देख्यो कि धरती पूरी तरह सूख गयी।<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />तब परमेश्वर न नूह सी कह्यो, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“तय अपनी पत्नी, बेटा अऊर बहुवों को संग जहाज म सी बाहेर निकल आव। <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />तोरो संग जो जीन्दो प्रानी, यानेकि जनावरों, पक्षियों, अऊर धरती पर रेंगन वालो जन्तु हंय, उन्ख भी तय जहाज सी बाहेर निकाल ले जेको सी हि धरती पर झुण्ड को झुण्ड पैदा करे; अऊर हि बहुत जादा ताकतवर हो, अऊर धरती पर फैल जाये।” <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />तब नूह अपनी पत्नी, बेटा, अऊर बहुवों को संग जहाज सी बाहेर निकल आयो : <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />अऊर सब जनावर, रेंगन वालो जन्तु, अऊर पक्षी अऊर धरती को पूरो जीवजन्तु अपनी जाति जाति को अनुसार जहाज म सी बाहेर निकल आयो।<verse eid="GEN 8:19" /></para>
  <para style="s">नूह द्वारा होमबलि को चढ़ायो जानो</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />तब नूह न प्रभु लायी एक वेदी बनायी; अऊर सब शुद्ध जनावरों अऊर सब शुद्ध पक्षियों म सी कुछ ख चुन्यो अऊर वेदी पर उन्की होमबलि चढ़ायो। <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />जब प्रभु ख होमबलि की सुखदायक सुगन्ध मिली तब प्रभु न अपनो दिल म कह्यो, “अब मय आदमी को वजह जमीन ख फिर कभी श्राप नहीं देऊं, बचपन सीच आदमी को मन को बिचार बुरायी लायी होवय हय; जसो मय न अभी करयो हय, वसो उन्ख फिर कभी नहीं मारूं। <verse eid="GEN 8:21" /><verse number="22" style="v" sid="GEN 8:22" />अब सी जब तक धरती बनी रहेंन, तब तक बोवन अऊर काटन को समय, ठंडी अऊर गर्मी, गर्मी अऊर ठंडी, दिन अऊर रात, को होनो खतम नहीं होयेंन।”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">परमेश्वर को नूह को संग वाचा बान्धनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:1 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:28">उत्पत्ति १:२८</ref>
      </char>
    </note>तब परमेश्वर न नूह अऊर ओको बेटा ख आशीष दी अऊर ओन कह्यो, “फूलो फलो, अऊर बढ़ो, अऊर धरती म भर जावो। <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />तुम्हरो डर अऊर अधिकार सी धरती को सब जनावरों, अऊर आसमान को सब पक्षियों, अऊर जमीन पर को सब रेंगन वालो जन्तुवों, अऊर समुन्दर की सब मच्छी पर बन्यो रहेंन हि सब तुम्हरो वश म कर दियो जावय हंय। <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />सब चलन वालो जीवजन्तु तुम्हरो जेवन होयेंन; जसो मय न तुम्ख हरो पौधा दियो होतो, वसोच अब सब कुछ देऊ हय। <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />पर, तुम मांस ख ओको जीव मतलब खून को संग मत खाजो।<note caller="+" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="LEV 19:26">लैव्यव्यवस्था 19:26</ref>; <ref loc="DEU 12:16">व्यवस्थाविवरन 12:16</ref>,<ref loc="DEU 12:23">23</ref>; <ref loc="DEU 15:23">15:23</ref>; <ref loc="GEN 17:10">उत्पत्ति 17:10</ref>; <ref loc="GEN 10">10</ref></char></note> <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />कहालीकि मय जरूर तुम्हरो खून अऊर जीव को बदला लेऊं: अऊर मय हर एक जनावर सी, अऊर हर एक आदमी सी ओको बदला लेऊं; अऊर मय हर एक आदमी सी ओको भाऊ बहिनों को खून को बदला लेऊं। <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />जो कोयी आदमी को खून बहायेंन ओको भी खून आदमी द्वारा बहायो जायेंन; कहालीकि परमेश्वर न आदमी ख अपनो जसो बनायो हय।<note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="GEN 1:26">उत्पत्ति 1:26</ref>; <ref loc="EXO 20:13">निर्गमन 20:13</ref></char></note><verse eid="GEN 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 9:7" />“अऊर तुम फलो फूलो अऊर धरती पर बहुतायत सी सन्तान पैदा कर क् ओको म भर जावो।”<note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="GEN 1:28">उत्पत्ति 1:28</ref></char></note><verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />तब परमेश्वर न नूह अऊर ओको बेटों सी कह्यो, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“सुनो, मय तुम्हरो संग अऊर तुम्हरो वंशजों को संग अपनी वाचा बान्ध रह्यो हय; <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />अऊर जब जीन्दो प्रानियों सी भी जो तुम्हरो संग हंय, का पक्षी का पालतु जनावर, का धरती को सब जंगली जनावर, धरती को जितनो जीवजन्तु जहाज सी निकल्यो हंय। <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />अऊर मय तुम्हरो संग अपनी यो वाचा बान्धू हय कि सब प्रानी फिर जल प्रलय सी नाश नहीं होयेंन अऊर धरती को नाश करन लायी फिर कभी जल प्रलय नहीं होयेंन।” <verse eid="GEN 9:11" /><verse number="12" style="v" sid="GEN 9:12" />तब परमेश्वर न कह्यो, “जो वाचा मय न तुम्हरो संग, अऊर जितनो जीन्दो प्रानी तुम्हरो संग हय उन सब को संग भी युग युग की पीढ़ियों लायी बान्धू हय; ओको यो चिन्ह हय : <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />कि मय न बादर म अपनो धनुष रख्यो हय, ऊ मोरो अऊर धरती को बीच म वाचा को चिन्ह होयेंन। <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />अऊर जब मय धरती पर बादर फैलाऊं तब बादर म धनुष दिखायी देयेंन। <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />तब मोरी जो वाचा तुम्हरो अऊर पूरो जीन्दो प्रानियों को संग बंधी हय; ओख मय याद करूं, तब असो जल प्रलय फिर नहीं होयेंन जेको सी सब प्रानी को नाश होय जाये। <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />बादर म जो धनुष होयेंन मय ओख देख क यो हमेशा की वाचा याद करूं, जो परमेश्वर को अऊर धरती पर को पूरो जीन्दो प्रानियों को बीच बंधी हय।” <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />तब परमेश्वर न नूह सी कह्यो, “जो वाचा मय न धरती भर को पूरो प्रानियों को संग बान्धी हय, ओको चिन्ह योच आय।”<verse eid="GEN 9:17" /></para>
  <para style="s">नूह अऊर ओको बेटा</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />नूह को जो बेटा जहाज म सी निकल्यो, ऊ शेम, हाम अऊर येपेत होतो; अऊर हाम कनान को बाप भयो। <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />नूह को तीन बेटा हिच हंय, अऊर इन्को वंश पूरी धरती पर फैल गयो।<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />नूह जो एक किसान होतो, जो अंगूर की बाड़ी लगावन वालो पहिलो आदमी भयो। <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />अऊर ऊ अंगूर को रस पी क मतवालो भयो; अऊर अपनो तम्बू को अन्दर नंगा भय गयो। <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />तब कनान को बाप हाम न, अपनो बाप ख नंगा देख्यो, अऊर बाहेर आय क अपनो दोयी भाऊ ख बताय दियो।<note caller="+" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="LEV 20:13">लैव्यव्यवस्था 20:13</ref></char></note> <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />तब शेम अऊर येपेत दोयी न एक चादर ली, अऊर ओख अपनो बख्खा पर रख्यो अऊर पीछु को तरफ उलटो चल क अन्दर गयो अऊर उन्न अपनो बाप को शरीर ख झाक दियो अऊर हि अपनो मुंह पीछु करयो हुयो होतो, येकोलायी उन्न अपनो बाप ख नंगा नहीं देख्यो। <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />जब नूह को नशा उतर गयो, तब ओन जान लियो कि ओको छोटो बेटा न ओको संग का करयो हय। <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />येकोलायी नूह न कह्यो,</para>
  <para style="q1" vid="GEN 9:25">“कनान श्रापित हो :</para>
  <para style="q1" vid="GEN 9:25">ऊ अपनो भाऊवों को दासों को दास हो।”<verse eid="GEN 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 9:26" />नूह न फिर कह्यो, “शेम को प्रभु परमेश्वर धन्य हय,</para>
  <para style="q1" vid="GEN 9:26">अऊर कनान शेम को दास हो।<verse eid="GEN 9:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="GEN 9:27" />परमेश्वर येपेत को वंश ख फैलाये;</para>
  <para style="q1" vid="GEN 9:27">अऊर ऊ शेम को तम्बूवों म निवास करे,</para>
  <para style="q1" vid="GEN 9:27">अऊर कनान येपेत को दास हो।”<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />जल प्रलय को बाद नूह तीन सौ पचास साल जीन्दो रह्यो। <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />यो तरह नूह की कुल उमर नव सौ पचास साल की भयी; ओको बाद ऊ मर गयो।<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">नूह को टुरा की वंशावली</para>
  <para style="r">(<ref loc="1CH 1:5-23">१ इतिहास 1:5-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />नूह को बेटां शेम, हाम अऊर येपेत होतो; उन्को बेटा जल प्रलय को बाद पैदा भयो: उन्की वंशावली या आय।<verse eid="GEN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 10:2" />येपेत को बेटां : गोमेर, मागोग, मादै, यावान, तूबल, मेशेक अऊर तीरास भयो। <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />अऊर गोमेर को बेटां : अश्कनज, रीपत अऊर तोगर्मा भयो। <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />अऊर यावान को वंश म एलीशा अऊर तर्शीश, कित्ती, अऊर दोदानी लोग भयो। <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />इन्को वंश दूसरी जातियों को द्वीपों को देशों म असो बट गयो कि हि दूसरी दूसरी भाषावों, कुलों, अऊर जातियों को अनुसार अलग अलग भय गयो।<verse eid="GEN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 10:6" />तब हाम को बेटां : कूश, मिस्र, पूत अऊर कनान भयो। <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />अऊर कूश को बेटां सबा, हवीला, सबता, रामा, अऊर सब्तका भयो। अऊर रामा को बेटा शबा अऊर ददान भयो। <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />कूश को वंश म निम्रोद भी भयो; जो धरती पर पहिलो महा शक्तिशाली विजेता होतो। <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />ऊ प्रभु की नजर म महान शिकारी होतो, येकोलायी ओको बारे म यो कहावत प्रसिद्ध हय; “प्रभु की नजर म निम्रोद को जसो महान शिकारी।” <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />ओको राज्य की सुरूवात शिनार देश म बेबीलोन, एरेख, अक्कद, अऊर कलने सी भयो। <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />निम्रोद ऊ देश सी निकल क अश्शूर ख गयो, अऊर नीनवे, रहोबोतीर अऊर कालह नाम को नगरों ख बसायो। <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />ओन रेसेन नगर ख भी बसायो जो नीनवे अऊर कालह को बीच म हय; ऊ महानगर हय।<verse eid="GEN 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 10:13" />मिस्र को वंश म लूदी, अनामी, लहाबी, नप्तूही, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />अऊर पत्रुसी, कसलूही, अऊर कप्तोरी लोग भयो, कसलूहियों म सी त पलिश्ती लोग निकल्यो।<verse eid="GEN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 10:15" />कनान को वंश म ओको बड़ो बेटा सीदोन, तब हित्त, <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />यबूसी, एमोरी, गिर्गाशी, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />हिव्वी, अर्की, शीनी, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />अर्वदी, समारी, अऊर हमाती लोग भी भयो; तब कनानियों को कुल भी फैल गयो। <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />अऊर कनानियों की सीमा सीदोन सी ले क गरार की रस्ता सी होय क अज्जा तक अऊर तब सदोम, अमोरा, अदमा अऊर सबोयीम की रस्ता सी होय क लाशा तक भयो। <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />हाम को वंश म हिच भयो; अऊर हि दूसरो दूसरो कुलों, भाषावों, देशों, अऊर जातियों को अनुसार अलग अलग भय गयो।<verse eid="GEN 10:20" /></para>
  <para style="s">शेम को वंशज</para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />तब शेम, जो सब एबेर वंशियों को मूल पुरुष भयो, अऊर जो येपेत को भाऊ होतो, ओको भी बेटा पैदा भयो। <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />शेम को बेटां : एलाम, अश्शूर, अर्पक्षद, लूद अऊर अराम भयो <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />अराम को बेटां : ऊस, हूल, गेतेर अऊर मश भयो। <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />अऊर अर्पक्षद न शेलह ख, अऊर शेलह न एबेर ख जनम दियो। <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />अऊर एबेर को दोय बेटां पैदा भयो, एक को नाम पेलेग यो वजह रख्यो गयो कि ओको दिनों म धरती बट गयी, अऊर ओको भाऊ को नाम योक्तान होतो। <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />अऊर योक्तान न अल्मोदाद, शेलेप, हसर्मावेत, येरह, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />हदोराम, ऊजाल, दिक्ला, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />ओबाल, अबीमाएल, शबा <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />ओपीर, हवीला, अऊर योबाब ख जनम दियो : हिच सब योक्तान को बेटां भयो। <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />इन्को रहन की जागा मेशा सी ले क सपारा, जो पूर्व दिशा म एक पहाड़ी प्रदेश हय, ओकी रस्ता तक भयो। <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />शेम को बेटां हिच भयो; अऊर हि दूसरो दूसरो कुलों, भाषावों देशों अऊर जातियों को अनुसार अलग अलग भय गयो।<verse eid="GEN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />नूह को बेटा को घरानों हिच आय : अऊर उन्की जातियों को अनुसार उन्की वंशावली हिच हंय; अऊर जल प्रलय को बाद धरती भर की जातियां इन्कोच म सी होय क बट गयी।<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">आदमी की भाषा म गड़बड़ी होन को वर्नन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />पूरी धरती पर एकच भाषा, अऊर सब जातियां एकच बोली बोलत होती। <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />ऊ समय लोग पूर्व दिशा को तरफ चलतो समय उन्ख शिनार देश म एक मैदान मिल्यो, अऊर हि ऊ मैदान म बस गयो। <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />तब उन्न आपस म कहन लग्यो, “आवो, हम ईटा बनाय बनाय क भली भाति आगी म पकायबो।” अऊर उन्न गोटा की जागा पर ईटा सी, अऊर चूना की जागा पर माटी को गारा सी काम लियो। <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />तब उन्न कह्यो, “आवो, हम एक नगर अऊर एक मीनार बनायबो, जेकी सेंडी आसमान ख छुय ले, यो तरह सी हम अपनो नाम करबो, असो नहीं होय कि हम्ख पूरी धरती पर फैलनो पड़े।”<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />जब लोग नगर अऊर गुम्मट बनाय रह्यो होतो; तब उन्ख देखन लायी परमेश्वर उतर आयो। <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />तब प्रभु न कह्यो, “मय का देखू हय, कि सब एकच जाती को लोग हंय, अऊर इन सब की भाषा भी एकच हय, अऊर उन्न असोच काम सुरूवात करयो; अऊर अब जो कुछ हि करन की कोशिश करेंन, ओको म सी कुछ भी उन्को लायी असम्भव नहीं होयेंन। <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />येकोलायी आवो, हम उतर क उन्की भाषा म बड़ी गड़बड़ी डालबो, कि हि एक दूसरो की बोली ख नहीं समझ सके।” <verse eid="GEN 11:7" /><verse number="8" style="v" sid="GEN 11:8" />यो तरह परमेश्वर न उन्ख उत सी पूरी धरती को ऊपर फैलाय दियो; अऊर उन्न ऊ नगर ख बनानो छोड़ दियो। <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />यो वजह ऊ नगर को नाम बेबीलोन<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="ft" closed="false">गड़बड़ </char></note> पड़्यो; कहालीकि पूरी धरती की भाषा म जो गड़बड़ी हय, प्रभु न उतच डाली, अऊर उतच सी प्रभु न आदमियों ख पूरी धरती को ऊपर फैलाय दियो।<verse eid="GEN 11:9" /></para>
  <para style="s">शेम की वंशावली</para>
  <para style="r">(<ref loc="1CH 1:24-27">१ इतिहास १:२४-२७</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />शेम की वंशावली यो आय। जल प्रलय को दोय साल बाद जब शेम एक सौ साल को भयो, तब ओन अर्पक्षद ख जनम दियो। <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />अऊर अर्पक्षद न जनम को बाद शेम पाच सौ साल जीन्दो रह्यो; अऊर ओको अऊर भी बेटा बेटियां पैदा भयो।<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />जब अर्पक्षद पैतीस साल को भयो, तब ओन शेलह ख जनम दियो। <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />अऊर शेलह को जनम को बाद अर्पक्षद चार सौ तीन साल अऊर जीन्दो रह्यो, अऊर ओको अऊर भी बेटा बेटियां पैदा भयो।<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />जब शेलह तीस साल को भयो, तब ओको द्वारा एबेर को जनम भयो। <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />अऊर एबेर को जनम को बाद शेलह चार सौ तीन साल अऊर जीन्दो रह्यो, अऊर ओको अऊर भी बेटा बेटियां पैदा भयो।<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />जब एबेर चौंतीस साल को भयो, तब ओको द्वारा पेलेग को जनम भयो। <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />अऊर पेलेग को जनम को बाद एबेर चार सौ तीस साल अऊर जीन्दो रह्यो, अऊर ओको अऊर भी बेटा बेटियां पैदा भयो।<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />जब पेलेग तीस साल को भयो, तब ओको द्वारा रऊ को जनम भयो। <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />अऊर रऊ को जनम को बाद पेलेग दोय सौ नव साल अऊर जीन्दो रह्यो, अऊर ओको अऊर भी बेटा बेटियां पैदा भयो।<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />जब रऊ बत्तीस साल को भयो, तब ओको द्वारा सरूग को जनम भयो। <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />अऊर सरूग को जनम को बाद रऊ दोय सौ सात साल अऊर जीन्दो रह्यो, अऊर ओको अऊर भी बेटा बेटियां पैदा भयो।<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />जब सरूग तीस साल को भयो, तब ओको द्वारा नाहोर को जनम भयो। <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />अऊर नाहोर को जनम को बाद सरूग दोय सौ साल अऊर जीन्दो रह्यो, अऊर ओको अऊर भी बेटा बेटियां पैदा भयो।<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />जब नाहोर उनतीस साल को भयो, तब ओको द्वारा तेरह को जनम भयो। <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />अऊर तेरह को जनम को बाद नाहोर एक सौ उन्नीस साल अऊर जीन्दो रह्यो, अऊर ओको अऊर भी बेटा बेटियां पैदा भयो।<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />जब तक तेरह सत्तर साल को भयो, तब तक ओको द्वारा अब्राम, नाहोर, अऊर हारान पैदा भयो।<verse eid="GEN 11:26" /></para>
  <para style="s">तेरह की वंशावली</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />तेरह की वंशावली यो आय : तेरह न अब्राम, नाहोर अऊर हारान ख जनम दियो; अऊर हारान न लूत ख जनम दियो। <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />अऊर हारान की मृत्यु ओको बाप तेरह को जीवन काल मच कसदी जाति को ऊर नाम को नगर म भयी, जो ओकी जन्मभूमि होती। <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />अब्राम अऊर नाहोर न बिहाव करयो। अब्राम की पत्नी को नाम सारै, अऊर नाहोर की पत्नी को नाम मिल्का होतो। मिल्का हारान की बेटी होती, अऊर हारान मिल्का अऊर यिस्का इन दोयी को बाप होतो। <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />सारै त बांझ होती; अऊर ओकी कोयी सन्तान नहीं होती।<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />अऊर तेरह न अपनो बेटा अब्राम, अऊर अपनो नाती लूत, जो हारान को बेटा होतो, अऊर अपनी बहू सारै, जो ओको बेटा अब्राम की पत्नी होती, इन पूरो ख ले क कसदी जाति को ऊर नगर सी निकल क कनान देश को तरफ चल पड़्यो; पर हारान नाम को देश म पहुंच क उतच रहन लग्यो। <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />जब तेरह दोय सौ पाच साल को भयो, तब ऊ हारान देश म मर गयो।<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">परमेश्वर को तरफ सी अब्राम को बुलायो जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 7:2">प्रेरितों ७:२</ref>,<ref loc="ACT 7:3">३</ref>; <ref loc="HEB 11:8">इब्रानियों ११:८</ref></char>
    </note>प्रभु न अब्राम सी कह्यो, “तय अपनो देश, अऊर अपनी जन्मभूमि, अऊर अपनो बाप को घर ख छोड़ क ऊ देश म चली जा, जो मय तोख दिखाऊं। <verse eid="GEN 12:1" /><verse number="2" style="v" sid="GEN 12:2" />अऊर मय तोरो सी एक बड़ो राष्ट्र पैदा करूं, अऊर मय तोख आशीष देऊं, अऊर तोरो नाम महान बनाऊं, ताकि तय आदमी की जाति लायी आशीष को वजह बन जाजो।<verse eid="GEN 12:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 12:3" />“जो तोख आशीर्वाद देन, उन्ख मय आशीष देऊं,</para>
  <para style="q1" vid="GEN 12:3">पर जो तोख श्राप देन, ओख मय श्राप देऊं;</para>
  <para style="q1" vid="GEN 12:3">अऊर धरती को पूरो कुटुम्ब तोरो द्वारा मोरो सी आशीष पायेंन।”<note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="GAL 3:8">गलातियों 3:8</ref></char></note><verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />परमेश्वर की आज्ञा को अनुसार अब्राम चली गयो; अऊर लूत भी ओको संग चली गयो; अऊर अब्राम हारान देश सी निकल्यो ऊ समय अब्राम पचहत्तर साल को होतो। <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />यो तरह अब्राम अपनी पत्नी सारै, अऊर अपनो भतीजा लूत ख, अऊर जो धन उन्न जमा करयो होतो, अऊर जो उन्न हारान देश म दास दासियों ख हासिल करयो होतो, इन सब ख ले क कनान देश म जान लायी निकल गयो,</para>
  <para style="p" vid="GEN 12:5">अऊर हि कनान देश म पहुंच्यो। <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />ऊ देश को बीच सी जातो हुयो अब्राम शेकेम नाम की जागा पर पहुंच्यो, जित मोरे को पवित्र झाड़ हय। ऊ समय कनानी जाति ऊ देश म रहत होती। <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" /><note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="ACT 7:5">प्रेरितों 7:5</ref>; <ref loc="GAL 3:16">गलातियों 3:16</ref></char></note>तब परमेश्वर न अब्राम ख दर्शन दे क कह्यो, “यो देश मय तोरो वंश ख देऊं।” अऊर अब्राम उत प्रभु लायी, जेन ओख दर्शन दियो होतो, उत ओको लायी ओन एक वेदी बनायी। <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />तब उत सी आगु बढ़ क, अब्राम ऊ पहाड़ी पर आयो, जो बेतेल नगर की पूर्व दिशा को तरफ हय; अऊर अपनो तम्बू ऊ जागा म खड़ो करयो जेको पश्चिम को तरफ बेतेल, अऊर पूर्व को तरफ ऐ नगर होतो, उत अब्राम न प्रभु लायी एक वेदी बनायी : अऊर प्रभु सी आराधना करी। <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />तब अब्राम कनान देश को दक्षिन भाग को तरफ, एक जागा सी दूसरी जागा पर चली गयो।<verse eid="GEN 12:9" /></para>
  <para style="s">मिस्र देश म अब्राम</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />लेकिन कनान म एक अकाल पड़्यो: येकोलायी अब्राम मिस्र देश ख चली गयो कि उत परदेशी जसो रहे, कहालीकि देश म भयानक अकाल पड़्यो होतो। <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />तब असो भयो कि हि मिस्र देश को जवर पहुंच क, अब्राम न अपनी पत्नी सारै सी कह्यो, “सुनो, मोख मालूम हय, कि तय एक सुन्दर बाई हय। <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />अऊर जब मिस्र को रहन वालो तोख देखेंन, तब कहेंन, ‘या ओकी पत्नी आय,’ येकोलायी हि मोख त मार डालेंन, पर तोख जीन्दो रहन देयेंन। <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" /><note caller="+" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="GEN 20:2">उत्पत्ति 20:2</ref>; <ref loc="GEN 26:7">26:7</ref></char></note>येकोलायी तय यो कह्यजो कि, ‘मय ओकी बहिन आय,’ जेको सी तोरो वजह मोरो कल्यान हो अऊर मोरो जीव तोरो वजह बचेंन।” <verse eid="GEN 12:13" /><verse number="14" style="v" sid="GEN 12:14" />तब असो भयो कि जब अब्राम मिस्र देश म आयो, तब उत को रहन वालो न ओकी पत्नी ख देख्यो कि या त बड़ी सुन्दर हय। <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />अऊर मिस्र को राजा फिरौन को अधिकारियों न ओख देख क फिरौन को आगु ओकी प्रशंसा करी : येकोलायी सारै ख फिरौन को महल म पहुंचायी गयी। <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />अऊर फिरौन न ओको वजह अब्राम को संग अच्छो बरताव करयो; अऊर अब्राम ख शेरी मेंढी, गाय-बईल, दास दासी, गधा गधी, अऊर ऊंट मिल्यो।<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />तब प्रभु न फिरौन अऊर ओको महल को लोगों पर, अब्राम की पत्नी सारै को वजह भयानक रोग तकलीफ लगायी। <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />तब फिरौन न अब्राम ख बुलाय क कह्यो, “तय न मोरो संग यो का करयो? तय न मोख कहाली नहीं बतायो कि वा तोरी पत्नी आय? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />तय न कहाली कह्यो कि वा तोरी बहिन आय? मय न येकोलायी ओख अपनी पत्नी बनाय लियो होतो; पर अब अपनी पत्नी ख ले क इत सी चली जा।” <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />अऊर फिरौन न अपनो अधिकारियों ख ओको बारे म आज्ञा दियो अऊर उन लोगों न अब्राम ख अऊर अब्राम की पत्नी ख, सब सम्पत्ति को संग जो ओको होतो, ओख बिदा कर दियो।<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">अब्राम अऊर लूत को अलग होन को वर्नन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />तब अब्राम अपनी पत्नी, अऊर अपनी पूरी सम्पत्ति ले क, अऊर लूत ख भी संग लियो, अऊर मिस्र देश ख छोड़ क कनान को दक्षिन देश म आयो। <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />अब्राम अपनी शेरी मेंढी, गाय-बईल, अऊर सोनो चांदी को वजह बहुत धनी होतो। <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />तब अब्राम दक्षिन देश सी चल क, बेतेल नगर को जवर उच जागा पर पहुंच्यो, जित पहिले ओन अपनो तम्बू खड़ो करयो होतो, जो बेतेल अऊर ऐ नगर को बीच म हय। <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />यो जागा ऊ वेदी को हय, जेक अब्राम पहिले सीच बनायो होतो, अऊर उत अब्राम न फिर प्रभु सी आराधना करी।<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />लूत को जवर भी, जो अब्राम को संग चलत होतो, ओको जवर भी शेरी मेंढी, गाय-बईल अऊर तम्बू होतो। <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />येकोलायी ऊ देश म उन दोयी लायी उचित जागा नहीं होती कि हि एक संग रह्य सके, कहालीकि उन्को जवर बहुत सारो जनावर होतो, कि हि एक संग नहीं रह्य सकत होतो। <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />तब अब्राम को जनावरों की देखभाल करन वालो अऊर लूत को जनावरों की देखभाल करन वालो को बीच म झगड़ा शुरू भय गयो। ऊ समय कनानी, अऊर परिज्जी लोग, ऊ देश म रहत होतो।<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />तब अब्राम लूत सी कहन लग्यो, “मोरो अऊर तोरो जनावरों की देखभाल करन वालो को बीच झगड़ा होनो नहीं पाये; कहालीकि हम लोग रिश्तेदार हंय। <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />का पूरो देश तोरो आगु नहीं? येकोलायी मोरो सी अलग होय जा; यदि तय बायो तरफ जाजो त मय दायो तरफ जाऊं; अऊर यदि तय दायो तरफ जाजो, त मय बायो तरफ जाऊं।”<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:10 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 2:10">उत्पत्ति 2:10</ref>
      </char>
    </note>तब लूत न अपनी आंखी ऊपर उठाय क आगु देख्यो, कि सोअर की दिशा म यरदन नदी को जवर वालो पूरो घाट अऊर प्रभु को बगीचा, अऊर मिस्र देश की जमीन को जसो पानी सी पूरी सिंची हुयी होती। यो प्रभु को द्वारा करयो गयो सदोम अऊर अमोरा को नाश को पहिले की बात आय। <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />येकोलायी लूत अपनो लायी यरदन की पूरो घाट ख चुन क पूर्व दिशा को तरफ चली गयो, यो तरह हि एक दूसरो सी अलग भय गयो। <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />अब्राम त कनान देश म रह्यो, पर लूत ऊ घाट को नगरों म रहन लग्यो; अऊर अपनो तम्बू सदोम नगर को जवर खड़ो करयो। <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />सदोम नगर को लोग प्रभु की नजर म बड़ो दुष्ट अऊर पापी होतो।<verse eid="GEN 13:13" /></para>
  <para style="s">अब्राम को हेब्रोन ख जानो</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />जब लूत अब्राम सी अलग भय गयो तब ओको बाद प्रभु न अब्राम सी कह्यो, “अपनी आंखी ऊपर उठाव अऊर जो जागा पर तय हय उत सी उत्तर दक्षिन, पूर्व पश्चिम, इन चारयी तरफ नजर कर। <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" /><note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ACT 7:5">प्रेरितों 7:5</ref></char></note>कहालीकि जितनी जमीन तोख दिखायी देवय हय, उन सब ख मय तोख अऊर तोरो वंश ख हमेशा हमेशा लायी देऊं। <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />अऊर मय तोरो वंश ख धरती की धूल को कन को जसो बहुत बढ़ाऊं, कि उन्की गिनती करनो बहुत मुश्किल होयेंन, यदि कोयी धरती की धूल को कन ख गिन सकेंन त उच तोरो वंश ख भी गिन सकेंन। <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />उठ, यो देश की लम्बाई अऊर चौड़ाई म चल फिर; कहालीकि मय यो सब तोख देन जाय रह्यो हय।” <verse eid="GEN 13:17" /><verse number="18" style="v" sid="GEN 13:18" />येको बाद अब्राम न अपनो तम्बू निकाल क, मम्रे को पवित्र झाड़ को जवर जो हेब्रोन म होतो, जाय क रहन लग्यो, अऊर उत भी ओन परमेश्वर की एक वेदी बनायी।<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">अब्राम को द्वारा लूत ख छुड़ायो जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />शिनार को राजा अम्रापेल, अऊर एल्लासार को राजा अर्योक, अऊर एलाम को राजा कदोर्लाओमेर, अऊर गोयीम को राजा तिदाल को दिनों म असो भयो, <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />कि उन्न सदोम को राजा बेरा, अऊर अमोरा को राजा बिर्शा, अऊर अदमा को राजा शिनाब, अऊर सबोयीम को राजा शेमेबेर, अऊर बेला जो सोअर भी कहलावय हय, इन राजावों को खिलाफ युद्ध करयो। <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />इन पाचों राजा न सिद्दीम नाम को घाट म, जो खारे नदी को जवर हय, हि सब जमा भयो। <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />अऊर हि बारा साल तक त कदोर्लाओमेर को अधिन रह्यो; पर तेरहवों साल म ओको खिलाफ विद्रोह कर दियो। <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />चौदावों साल म कदोर्लाओमेर, अऊर ओको संगी राजा चढ़ आयो, अऊर अशतरोत्कनम म रपाई जाति ख, अऊर हाम म जूजी जाति ख, अऊर शावे-किर्यातैम एमी जाती ख, <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />अऊर सेईर नाम की पहाड़ी म होरी जाति ख, हराय क ऊ एल्पारान तक जो जंगल को जवर हय, उत तक पहुंच गयो। <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />उत सी हि लौट क एन्मिशपात ख आयो, जो कादेश भी कहलावय हय, अऊर अमालेकी जाति को पूरो देश ख, अऊर हसासोन्तामार म रहन वाली एमोरी जाति ख भी हराय दियो।<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />तब सदोम, अमोरा, अदमा, सबोयीम, अऊर बेला, जो सोअर भी कहलावय हय, इन्को राजा निकल्यो, अऊर सिद्दीम नाम को घाट म, उन्को संग युद्ध लायी फैसला करयो : <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />यानेकि एलाम को राजा कदोर्लाओमेर, गोयीम को राजा तिदाल, शिनार को राजा अम्रापेल, अऊर एल्लासार को राजा अर्योक, इन चारयी को खिलाफ उन पाचों न युद्ध को बारे म फैसला करयो। <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />सिद्दीम नाम को घाट म डामर को बहुत सारो गड्डा होतो; जब सदोम अऊर अमोरा को राजा भग्यो तब उन्की सेना को बहुत सारो सिपाही उन्म गिर गयो, अऊर जो बच्यो हि पहाड़ी पर भग गयो। <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />तब उन्को दुश्मनों न सदोम अऊर अमोरा को पूरो सम्पत्ति अऊर भोजन की पूरी चीज ख लूट क चली गयो। <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />अऊर अब्राम को भतीजा लूत, जो सदोम म रहत होतो; अऊर ओकी सम्पत्ति सहित ले क हि चली गयो।<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />तब एक आदमी जो भग क बच निकल्यो होतो ओन जाय क इब्री अब्राम ख यो समाचार दियो; अब्राम त एमोरी मम्रे, जो एशकोल अऊर आनेर को भाऊ होतो, ओको पवित्र झाड़ को बीच म रहत होतो; अऊर हि लोग अब्राम को संग वाचा बान्ध्यो हुयो होतो। <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />जब अब्राम न यो सुन्यो कि ओको भतीजा बन्दी बनाय लियो गयो हय, तब अब्राम न अपनो तीन सौ अठरा युद्ध विद्या म अनुभवी, सेवकों ख ले क जो ओको कुटुम्ब म पैदा भयो होतो, अऊर हथियार ले क दान नगर तक उन्को पीछा करयो। <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />अऊर अब्राम न रात म अपनो सेवकों ख अलग अलग दलों म बाट दियो, अऊर अपनो सेवकों को संग दुश्मन पर हमला कर क् उन्ख मार डाल्यो अऊर होबा तक, जो दमिश्क नगर को उत्तर को तरफ हय, उत तक उन्को पीछा करयो। <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />ओको बाद ऊ पूरी सम्पत्ति अऊर अपनो भतीजा लूत, ख अऊर ओकी सम्पत्ति सहित अऊर बाईयों ख, अऊर सब बन्दियों ख, छुड़ाय क वापस ले आयो।<verse eid="GEN 14:16" /></para>
  <para style="s">मलिकिसिदक को अब्राम ख आशीष देनो</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />जब ऊ कदोर्लाओमेर अऊर ओको संगी राजावों ख जीत क लौट आवत होतो तब सदोम को राजा शावे नाम को घाट म, जो राजा को घाट भी कह्यो जावय हय, ओको सी भेंट करन लायी आयो। <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />तब शालेम को राजा मलिकिसिदक, जो परमप्रधान परमेश्वर को याजक होतो, ऊ रोटी अऊर अंगूर को रस ले आयो।<note caller="+" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="HEB 7:1-10">इब्रानियों ७:१-१०</ref>; <ref loc="PSA 110:4">भजन 110:4</ref></char></note> <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />अऊर ओन अब्राम ख यो आशीर्वाद दियो, “परमप्रधान परमेश्वर को तरफ सी, जो आसमान अऊर धरती को अधिकारी हय, तय धन्य हो। <verse eid="GEN 14:19" /><verse number="20" style="v" sid="GEN 14:20" />अऊर धन्य हय परमप्रधान परमेश्वर, जेन तोरो दुश्मनों ख तोरो वश म कर दियो।” तब अब्राम न ओख हर एक चिज को दसवा अंश भेंट करयो।<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />तब सदोम को राजा न अब्राम सी कह्यो, “आदमी ख त मोख दे, अऊर सम्पत्ति ख अपनो जवर रख।”<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />अब्राम न सदोम को राजा ख उत्तर दियो, “परमप्रधान प्रभु परमेश्वर, जो आसमान अऊर धरती को अधिकारी हय, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />ओकी मय यो कसम खाऊ हय, कि जो कुछ तोरो हय ओको म सी मय सूत नहीं लेऊं, अऊर नहीं जूती को बन्धन, अऊर कोयी चिज नहीं लेऊं; कि तय असो नहीं कहनो पाये, कि अब्राम मोरो वजह धनी भयो। <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />पर जो कुछ इन जवानों न खाय लियो हय अऊर उन्को भाग, जो मोरो संग गयो होतो मतलब आनेर, एशकोल, अऊर मम्रे, मय नहीं लौटाऊं, हि त अपनो अपनो भाग रख ले।”<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">अब्राम को संग परमेश्वर की वाचा बान्धन को वर्नन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />इन बातों को बाद प्रभु को यो वचन दर्शन म अब्राम को जवर पहुंच्यो : “हे अब्राम, मत डर; मय तोरी ढाल अऊर बड़ो प्रतिफल आय।”<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />अब्राम न कह्यो, “हे प्रभु यहोवा, मोरी त कोयी सन्तान नहाय, अऊर मोरो घर को वारिस यो दमिश्कवासी एलीएजेर होयेंन, बल्की तय मोख का देजो?” <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />अऊर अब्राम न कह्यो, “मोख त तय न सन्तान नहीं दियो, अऊर का देखू हय, कि मोरो घर म पैदा भयो एक जन मोरो वारिस होयेंन।”<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />तब प्रभु को यो वचन ओको जवर पहुंच्यो, “यो तोरो वारिस नहीं होयेंन, तोरो जो खुद को बेटा होयेंन, उच तोरो वारिस होयेंन।” <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />अऊर प्रभु न अब्राम ख बाहेर लिजाय क कह्यो, “आसमान को तरफ नजर कर क् तारा ख, तय गिन सकय हय?” तब प्रभु न अब्राम सी कह्यो, “तोरो वंश असोच होयेंन।”<note caller="+" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="ROM 4:18">रोमियों 4:18</ref>; <ref loc="HEB 11:12">इब्रानियों 11:12</ref></char></note><verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />अब्राम न परमेश्वर पर विश्वास करयो; अऊर परमेश्वर न अब्राम को यो विश्वास ख उन्की सच्चायी मान्यो।<verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />अऊर परमेश्वर न अब्राम सी कह्यो, “मय उच परमेश्वर आय, जो तोख कसदियों को ऊर नगर सी बाहेर ले आयो, कि तोख यो देश को अधिकार देऊं।”<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />अब्राम न कह्यो, “हे परमेश्वर यहोवा, मय कसो जानु कि यो देश पर मोरो अधिकार होयेंन?”<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />परमेश्वर न अब्राम सी कह्यो, “मोरो लायी तीन तीन साल की एक गाय, अऊर एक शेरी, अऊर एक मेंढा, अऊर एक पण्डुक, अऊर एक कबूत्तर को बच्चा भी लाजो।” <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />अऊर इन पूरो ख ले क, अब्राम न बीच सी दोय टुकड़ा कर दियो अऊर टुकड़ा ख आमने सामने रख्यो पर चिड़ियां को ओन टुकड़ा नहीं करयो। <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />जब शिकारी पक्षी उन टुकड़ा पर झपट्यो, तब अब्राम न उन्ख उड़ाय दियो।<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />जब सूरज डुबन लग्यो, तब अब्राम ख गहरी नींद आय गयी; अऊर देखो, बहुत जादा डर अऊर अन्धकार ओको ऊपर आय गयो।<note caller="+" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="JOB 4:13">अय्यूब 4:13</ref>,<ref loc="JOB 4:14">14</ref></char></note> <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />तब प्रभु न अब्राम सी कह्यो, “यो अच्छो सी जान ले कि तोरो वंश परायो देश म परदेशी होय क रहेंन, अऊर ऊ देश को लोगों को दास होय जायेंन; अऊर हि उन्ख चार सौ साल तक दु:ख देयेंन।<note caller="+" style="x"><char style="xo" closed="false">15:13 </char><char style="xt" closed="false"><ref loc="EXO 1:1-14">निर्गमन 1:1-14</ref>; <ref loc="ACT 7:6">प्रेरितों 7:6</ref></char></note> <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />तब जो देश को हि दास होयेंन ओख मय दण्ड देऊं : अऊर ओको बाद हि बड़ो धन उत सी ले क निकल आयेंन।<note caller="+" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="EXO 12:40">निर्गमन 12:40</ref>,<ref loc="EXO 12:41">41</ref>; <ref loc="ACT 7:7">प्रेरितों 7:7</ref></char></note> <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />तय त अपनो मरयो हुयो पूर्वजों को जवर जाजो; अऊर तोख पूरो बुढ़ापा म माटी दी जायेंन। <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />पर हि चौथी पीढ़ी म इत फिर आयेंन : कहालीकि अब तक एमोरी जाति को अधर्म पूरो नहीं भयो हंय।”<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />अऊर असो भयो कि जब सूरज डुब गयो अऊर घोर अन्धारो छाय गयो, तब एक आग भट्टी जेको म सी धुवा निकलत होतो अऊर एक जरती हुयी मशाल दिखायी दी जो उन टुकड़ा को बीच म सी होय क निकल गयी। <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />उच दिन परमेश्वर न अब्राम को संग यो वाचा बान्धी, “मिस्र की महा नदी सी ले क फरात नाम की बड़ी नदी तक जितनो देश हय,<note caller="+" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="ACT 7:5">प्रेरितों 7:5</ref></char></note> <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />मतलब केनियों, कनिज्जियों, कदमोनियों, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />हित्तियों, परिज्जियों, रपाइयों <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />एमोरियों, कनानियों, गिर्गाशियों अऊर यबूसियों को देश, मय न तोरो वंश ख दियो हय।”<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">हाजिरा अऊर ओको बेटा इश्माएल</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />अब्राम की पत्नी सारै की कोयी सन्तान नहीं होती : अऊर ओको जवर हागार नाम की एक मिस्री दासी होती। <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />सारै न अब्राहम सी कह्यो, “देख, प्रभु न त मोरी कोख बन्द कर रखी हय येकोलायी मय तोरो सी बिनती करू हय कि तय मोरी दासी को जवर जा; सम्भव हय कि मोरो घर ओको द्वारा बस जाये।” सारा की यो बात अब्राम न मान ली। <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />येकोलायी जब अब्राम ख कनान देश म रह्यतो हुयो दस साल बीत गयो तब ओकी पत्नी सारै न अपनी मिस्री दासी हागार ख ले क अपनो पति अब्राम ख दियो, कि वा ओकी पत्नी हो। <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />तब अब्राम हागार को जवर गयो, अऊर वा गर्भवती भयी; जब हागार न जान्यो कि मय गर्भवती हय, तब वा अपनी स्वामिनी ख अपनी नजर म तुच्छ समझन लगी।<verse eid="GEN 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 16:5" />तब सारै न अब्राम सी कह्यो, “जो चोट मोख लगी हय ओको वजह तुम हो। मय न त अपनी दासी ख तोरी पत्नी कर दियो; पर जब ओन जान्यो कि वा गर्भवती हय, तब वा मोख तुच्छ समझन लगी, येकोलायी परमेश्वर मोरो अऊर तोरो बीच म न्याय करे।”<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />अब्राम न सारै सी कह्यो, “देख तोरी दासी तोरो बस म हय; जसो तोख अच्छो लगे वसोच ओको संग कर।” तब सारै हागार ख दु:ख देन लगी अऊर वा ओको आगु सी भग गयी।<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />तब परमेश्वर को दूत न हागार ख जंगल म शूर की रस्ता पर पानी को एक झरना को जवर पा क कह्यो, <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />“हे सारै की दासी हागार, तय कित सी आवय अऊर कित ख जावय हय?”</para>
  <para style="p" vid="GEN 16:8">ओन कह्यो, “मय अपनी स्वामिनी सारै को आगु सी भग क आयी हय।”<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />परमेश्वर को दूत न ओको सी कह्यो, “अपनी स्वामिनी को जवर लौट जा अऊर ओको बस म रह्य।” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />अऊर परमेश्वर को दूत न ओको सी कह्यो, “मय तोरो वंश ख बहुत बढ़ाऊं, यहां तक कि बहुतायत को वजह ओकी गिनती नहीं होय सकेंन।” <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />अऊर परमेश्वर को दूत न ओको सी कह्यो, “देख तय गर्भवती हय, अऊर बेटा पैदा करजो; तय ओको नाम इश्माएल रखजो; कहालीकि परमेश्वर न तोरो दु:ख को हाल सुन लियो हय। <verse eid="GEN 16:11" /><verse number="12" style="v" sid="GEN 16:12" />अऊर तोरो बेटा जंगली गधा को आगु, होयेंन, ओको हाथ सब को विरोध म उठेंन, अऊर सब को हाथ ओको विरोध म उठेंन; अऊर ऊ अपनो सब भाऊ-बन्धुवों को विरोध म निवास करेंन।”<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />तब हागार न परमेश्वर को नाम जेन ओको सी बाते करी होती, “ओको नाम देखन वालो परमेश्वर रख्यो” कहालीकि वा कहत होती, “का मय न सचमुच परमेश्वर ख देख्यो अऊर ओख देखन को बाद भी जीन्दी रही?” <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />यो वजह ऊ कुंवा को नाम जीन्दो आदमी को कुंवा जो मोख देखय नाम पड़्यो; ऊ त कादेश अऊर बेरेद को बीच म हंय।<verse eid="GEN 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 16:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:15 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 4:22">गलातियों 4:22</ref>
      </char>
    </note>हागार ख अब्राम को द्वारा एक बेटा भयो; अऊर अब्राम न अपनो बेटा को नाम, जेक हागार न जनम दियो होतो, इश्माएल रख्यो। <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />जब हागार न अब्राम को द्वारा इश्माएल ख जनम दियो ऊ समय अब्राम छियासी साल को होतो।<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">खतना अऊर वाचा को चिन्ह,</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />जब अब्राम निन्यानवे साल को भय गयो, तब प्रभु न ओख दर्शन दे क कह्यो, “मय सर्वशक्तिमान परमेश्वर आय; मोरी उपस्थिति म रह्य क निर्दोष आचरन करन की कोशिश कर। <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />मय तोरो संग वाचा बान्धूं, अऊर तोरो वंश ख बहुत जादा बढ़ाऊं।” <verse eid="GEN 17:2" /><verse number="3" style="v" sid="GEN 17:3" />तब अब्राम मुंह को बल गिरयो : अऊर परमेश्वर ओको सी यो बाते करतो गयो, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />“देख, मोरी वाचा तोरो संग बंधी रहेंन, येकोलायी तय कुछ राष्ट्रों को बुजूर्ग बनजो। <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" /><note caller="+" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="ROM 4:17">रोमियों 4:17</ref></char></note>येकोलायी अब सी तोरो नाम अब्राम नहीं रहेंन पर तोरो नाम अब्राहम होयेंन; कहालीकि मय न तोख कुछ राष्ट्रों को बुजूर्ग बनायो हय। <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />मय तोख बहुत जादा वंशज देऊं, अऊर ओको म सी कुछ राजा होयेंन। अऊर तोरो जवर इतनो वंशज होयेंन कि हि राष्ट्र बन जायेंन।<verse eid="GEN 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 17:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">17:7 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:55">लूका 1:55</ref>; <ref loc="GAL 3:16">गलातियों 3:16</ref></char>
    </note>“अऊर मय तोरो संग, अऊर तोरो बाद तोरो वंश की पीढ़ी को संग हमेशा लायी अपनो विधान स्थापित करू हय कि मय तोरो अऊर तोरो बाद तोरो वंश को परमेश्वर रहूं। <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" /><note caller="+" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="ACT 7:5">प्रेरितों 7:5</ref></char></note>अऊर मय तोख, अऊर तोरो बाद तोरो वंश ख भी, यो पूरो कनान देश, जेको म तय परदेशी होय क रह्य हय, यो रीति सी देऊं कि वा हमेशा हमेशा उन्की अपनी जमीन रहेंन, अऊर मय उन्को परमेश्वर रहूं।”<verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />तब परमेश्वर न अब्राहम सी कह्यो, “तय भी मोरो संग बान्धी हुयी वाचा को पालन करजो; तय अऊर तोरो बाद तोरो वंश भी अपनी अपनी पीढ़ी म ओको पालन करे। <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" /><note caller="+" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="ROM 4:11">रोमियों 4:11</ref>; <ref loc="ACT 7:8">प्रेरितों 7:8</ref></char></note>मोरो संग बान्धी हुयी वाचा, जेको पालन तोख अऊर तोरो बाद तोरो वंश ख करनो पड़ेंन, ऊ यो आय : तुम म सी एक एक आदमी को खतना हो। <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />तुम अपनो अपनो बच्चा को खतना कराय लेवो : जो वाचा मोरो अऊर तुम्हरो बीच म हय, ओको योच चिन्ह होयेंन। <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />तुम्हरो हर एक बच्चा को खतना ओको जनम को आठवों दिन करयो जाये, हर एक पीढ़ी को आदमी को खतना होनो चाहिये, चाहे ऊ तुम्हरो घर म पैदा भयो दास हो, या विदेशियों सी धन दे क खरीद्यो गयो हो, जो तोरो वंश को नोहोय। <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />जो तोरो घर म पैदा भयो दास हय, अऊर जो धन दे क खरीद्यो गयो हय, इन दोयी को खतना करयो जाये। यो तरह मोरी वाचा जेको चिन्ह तुम्हरो शरीर पर होयेंन, अऊर यो वाचा हमेशा हमेशा बनी रहेंन। <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />जो आदमी खतनारहित रहे, मतलब जेको बच्चा को खतना नहीं करयो गयो हय, उच अपनो लोगों म सी नाश करयो जाये, कहालीकि ओन मोरो संग बान्धी हुयी वाचा ख तोड़ दियो।”<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />तब परमेश्वर न अब्राहम सी कह्यो, “तोरी जो पत्नी सारै हय, ओख तय अब सारै मत कहजो, ओको नाम सारा<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">राजमाता</char></note> होयेंन। <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />मय ओख आशीष देऊं, अऊर तोख ओको द्वारा एक बेटा देऊं; अऊर मय ओख असी आशीष देऊं, कि वा जाति जाति की माय बनेंन; अऊर ओको वंश म राज्य राज्य को राजा पैदा होयेंन।”<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />तब अब्राहम मुंह को बल गिर पड़्यो अऊर हस्यो, अऊर मन मच कहन लग्यो, “का सौ साल को होनो पर भी सन्तान होय सकय हय? अऊर का नब्बे साल की सारा गर्भवती होय सकय हय?” <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />अऊर अब्राहम न परमेश्वर सी कह्यो, “इश्माएल तोरी नजर म बन्यो रहे, योच बहुत हय।”<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />तब परमेश्वर न कह्यो, “निश्चय तोरी पत्नी सारा ख तोरो सी एक बेटा पैदा होयेंन; अऊर तय ओको नाम इसहाक<note caller="+" style="f"><char style="fr" closed="false">17:19 </char><char style="ft" closed="false">ऊ हस्यो</char></note> रखजो; अऊर मय ओको संग असी वाचा बान्धूं जो ओको बाद ओको वंश लायी हमेशा हमेशा की वाचा होयेंन। <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />इश्माएल को बारे म भी मय न तोरी सुनी हय; मय ओख भी आशीष देऊं, अऊर ओख कुछ बच्चा अऊर कुछ वंशज देऊं; अऊर ऊ बारा राजकुमारों को बाप होयेंन, अऊर मय ओको वंशजों को एक महान राष्ट्र बनाऊं। <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />पर मय अपनी वाचा इसहाक को संगच बान्धूं जो सारा सी अगलो साल को योच ठहरायो हुयो समय म पैदा होयेंन।” <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />तब परमेश्वर न अब्राहम सी बाते करनो बन्द करी अऊर ओको जवर सी ऊपर चढ़ गयो।<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />तब अब्राहम न अपनो बेटा इश्माएल ख लियो अऊर, अपनो घर म पैदा भयो दासों, अऊर जितनो ओको रुपया सी खरीद्यो गयो दासों सहित, मतलब ओको घर म जितनो आदमी होतो, उन पूरो ख ले क उच दिन परमेश्वर को वचन को अनुसार उन्को खतना करयो। <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />जब अब्राहम को खतना करयो गयो तब ऊ निन्यानवे साल को होतो <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />अऊर जब अब्राहम को बेटा इश्माएल को खतना करयो गयो तब ऊ तेरह साल को होतो। <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />अब्राहम अऊर ओको बेटा इश्माएल दोयी को खतना एकच दिन भयो। <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />अऊर अब्राहम को घर म जितनो आदमी अऊर दास होतो जो घर म पैदा भयो होतो, अऊर जो विदेशियों सी खरीद्यो गयो होतो, सब को खतना ओकोच हाथ सी भयो।<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">इसहाक को जनम की प्रतिज्ञा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />अब्राहम मम्रे को पवित्र झाड़ों को बीच कड़ी तपन को समय तम्बू को दरवाजा पर बैठ्यो हुयो होतो, तब परमेश्वर न ओख दर्शन दियो : <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" /><note caller="+" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="HEB 13:2">इब्रानियों 13:2</ref></char></note>अब्राहम न आंखी ऊपर उठाय क देख्यो कि ओको आगु तीन आदमी खड़ो हंय। जब अब्राहम न उन्ख देख्यो तब ऊ उन्को सी भेंट करन लायी तम्बू को दरवाजा सी दौड़ क आयो, अऊर जमीन पर झुक क उन्ख नमस्कार करयो, <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />अऊर अब्राहम न कह्यो, “हे प्रभु, यदि मोरो पर तोरी अनुग्रह की नजर हय त मय बिनती करू हय, कि अपनो दास को जवर सी चली मत जाजो। <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />मय थोड़ो सो पानी लाऊ हय अऊर तय अपनो पाय धोय क यो झाड़ को खल्लो आराम कर। <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />तब मय एक टुकड़ा रोटी ले आऊं, अऊर तय ओख खाय क अपनो जीव ख सन्तुष्ट कर; तब ओको बाद तय आगु चली जाजो, कहालीकि तय अपनो दास को जवर आयो हंय।”</para>
  <para style="p" vid="GEN 18:5">उन्न कह्यो, “जसो तय कह्य हय वसोच कर।”<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />तब अब्राहम जल्दी सी तम्बू म सारा को जवर गयो अऊर कह्यो, “जल्दीच दस किलो मैदा ले क ओख सान अऊर ओकी रोटी बनाय लेवो।” <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />तब अब्राहम गाय-बईल को झुण्ड म दौड़्यो, अऊर एक कवलो अऊर अच्छो बछड़ा ले क अपनो दास ख दियो, अऊर ओन जल्दी सी ओख पकायो। <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />तब अब्राहम न दूध, अऊर दही, अऊर बछड़ा को पकायो हुयो मांस, आदमियों को आगु परोस दियो; तब तक हि जेवन करतो रह्यो, अऊर अब्राहम उन्को जवर झाड़ को खल्लो खड़ो रह्यो।<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />उन्न अब्राहम सी पुच्छ्यो, “तोरी पत्नी सारा कित हय?”</para>
  <para style="p" vid="GEN 18:9">अब्राहम न उत्तर दियो, “वा त तम्बू म हंय।”<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">18:10 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 9:9">रोमियों 9:9</ref>
      </char>
    </note>उन्म सी एक न कह्यो, “मय अब सी नव महीना बाद वापस आऊं, अऊर तोरी पत्नी सारा ख एक बेटा पैदा होयेंन।”</para>
  <para style="p" vid="GEN 18:10">सारा जो अब्राहम को पीछू खड़ी होती, तम्बू को दरवाजा सी उन्की बातचीत सुन रही होती। <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />अब्राहम अऊर सारा बहुत बूढ्ढा भय गयो होतो, अऊर सारा को मासिक धर्म बन्द भय गयो होतो। <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" /><note caller="+" style="x"><char style="xo" closed="false">18:12 </char><char style="xt" closed="false"><ref loc="1PE 3:6">१ पतरस ३:६</ref></char></note>येकोलायी सारा अपनो मन म हस क बोली, “मय बूढ्ढी होय गयी हय, अऊर मोरो पति भी बूढ्ढा हय, का येको बाद भी मोख सहवास को आनन्द हासिल होयेंन?”<verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />जब यहोवा न अब्राहम सी कह्यो, “सारा यो कह्य क कहाली हसी, का मय बूढ्ढी होय जाऊं तब भी का एक बेटा ख जनम देऊं? <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" /><note caller="+" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="LUK 1:36">लूका 1:36</ref></char></note>का यहोवा लायी कोयी काम कठिन हय? जसो कि मय न कह्यो, अब सी नव महीना बाद फिर मय तोरो जवर आऊं, अऊर सारा ख एक बेटा होयेंन।”<verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />तब सारा डर को मारे यो कह्य क मुकर गयी, “मय नहीं हसी।” यहोवा न कह्यो,</para>
  <para style="p" vid="GEN 18:15">“नहीं, तय जरूर हसी होती।”<verse eid="GEN 18:15" /></para>
  <para style="s">अब्राहम को सदोम नगर लायी निवेदन</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />तब हि आदमी वहां सी चली गयो, उत सी हि सदोम को तरफ देख सकत होतो; अऊर अब्राहम उन्को संग उन्ख उन्की रस्ता पर भेजन लायी संग गयो। <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />अऊर यहोवा न अपनो आप सी कह्यो, “मय अब्राहम सी नहीं छुपाऊं कि मय का करन जाय रह्यो हय? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />अब्राहम सी त निश्चय एक महान अऊर शक्तिशाली राष्ट्र बनेंन, अऊर धरती को पूरो राष्ट्र ओको द्वारा मोरो सी आशीष पायेंन। <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />कहालीकि मय जानु हय, कि ऊ अपनो बेटां अऊर वंशजों ख जो ओको पीछू रह्य जायेंन, आज्ञा देयेंन कि हि परमेश्वर की रस्ता म चलतो रहे, अऊर जो सच्चो अऊर न्याय पूर्ण करतो रहे, ताकि जो कुछ परमेश्वर न अब्राहम को बारे म कह्यो हय ओख पूरो करे।”<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />तब परमेश्वर न कह्यो, “सदोम अऊर अमोरा नगर को खिलाफ भयानक आरोप हंय, अऊर उन्को पाप बहुत भारी होय गयो हय; <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />येकोलायी मय उतर क देखूं, कि ओको जसो भयानक आरोप मोरो कान तक पहुंच्यो हय, उन्न ठीक वसोच काम करयो हय कि नहीं; अऊर नहीं करयो होना त मय ओख जान लेऊं।”<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />तब हि आदमी उत सी मुड़ क सदोम को तरफ जान लग्यो; पर अब्राहम परमेश्वर को आगु खड़ो रह्य गयो। <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />तब अब्राहम न परमेश्वर को जवर आय क कह्यो, “का तय सचमुच दुष्ट को संग निर्दोष ख भी नाश करजो? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />अगर ऊ नगर म पचास निर्दोष लोग हंय, त का तय सचमुच पूरो नगर ख नाश कर देजो, अऊर पचास निर्दोष को वजह ओख माफ नहीं करजो, जो ओको म हंय? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />यो तरह को काम करनो तोरो सी दूर रहे कि दुष्ट को संग निर्दोष ख भी मार डाले अऊर निर्दोष अऊर दुष्ट दोयी की एकच दशा हो। यो तोरो सी दूर रहे। का पूरी धरती को न्यायी न्याय नहीं करेंन?”<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />परमेश्वर न कह्यो, “यदि मोख सदोम नगर म पचास निर्दोष लोग मिले, त उन्को वजह मय पूरो नगर ख छोड़ देऊं।”<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />तब अब्राहम न कह्यो, “हे परमेश्वर, सुन मय त माटी अऊर राख आय; तब भी मय न इतनी हिम्मत करी कि तोरो सी बाते करूं। <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />लेकिन शायद उन पचास निर्दोष म पाच कम होय जाये; त का तय पाच को कम होय जानो को वजह ऊ पूरो नगर को नाश कर देजो?”</para>
  <para style="p" vid="GEN 18:28">परमेश्वर न उत्तर दियो, “यदि मय पैतालीस निर्दोष लोग भी मिलेंन, तब मय नगर ख नाश नहीं करूं।”<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />अब्राहम न फिर कह्यो, “शायद उत चालीस मिले।”</para>
  <para style="p" vid="GEN 18:29">तब परमेश्वर न उत्तर दियो, “अगर चालीस हंय त मय ओख नाश नहीं करूं।”<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />अब्राहम न फिर सी कह्यो, “हे परमेश्वर गुस्सा मत हो, त मय फिर सी कहू हय, यदि केवल उत तीस हंय, त का होयेंन।”</para>
  <para style="p" vid="GEN 18:30">परमेश्वर न उत्तर दियो; “यदि मोख उत तीस भी मिलेंन, तब भी मय असो नहीं करूं।”<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />तब अब्राहम न कह्यो, “हे परमेश्वर, सुन, मय न इतनी हिम्मत त करी हय कि तोरो सी बात करूं : मान ले कि ओको म बीस निर्दोष मिले।”</para>
  <para style="p" vid="GEN 18:31">परमेश्वर न कह्यो, “अगर मय बीस ख पाऊ हय त मय नगर ख नाश नहीं करूं।”<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />अब्राहम न कह्यो, “हे परमेश्वर, गुस्सा मत हो, अऊर मय केवल एकच बार अऊर कहूं : यदि केवल दस मिले त का होयेंन।”</para>
  <para style="p" vid="GEN 18:32">परमेश्वर न उत्तर दियो, “अगर दस हंय त मय ओख नाश नहीं करूं।” <verse eid="GEN 18:32" /><verse number="33" style="v" sid="GEN 18:33" />अब्राहम को संग बोलन को बाद, परमेश्वर चली गयो अऊर अब्राहम अपनो घर ख लौट गयो।<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">सदोम लोगों की दुष्टता</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />शाम को समय जब दोय स्वर्गदूत सदोम नगर म आयो; त लूत सदोम नगर की फाटक को जवर बैठ्यो होतो। त लूत स्वर्गदूत ख देख क उन्को सी मुलाखात करन लायी उठ्यो, अऊर मुंह को बल झुक क नमस्कार कर क् कह्यो, <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />“हे मोरो प्रभुवों, मय तुम्हरो सी बिनती करू हय, तुम अपनो दास को घर म पधारो, अऊर अपनो पाय धोवो, अऊर रात इतच बिताबो, अऊर सुबेरे उठ क अपनी रस्ता पर जावो।”</para>
  <para style="p" vid="GEN 19:2">लेकिन उन्न उत्तर दियो, “नहीं, हम इतच नगर को चौक म रात बितायबो।”<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />अऊर लूत न स्वर्गदूतों सी बहुत बिनती कर क् उन्ख मनायो; येकोलायी हि ओको संग चल क ओको घर म आयो; अऊर ओन स्वर्गदूतों लायी अपनो दासों ख कुछ रोटी सेकन अऊर जेवन तैयार करन की आज्ञा दियो, जब पूरो जेवन तैयार भय गयो, त उन्न खाय लियो।<verse eid="GEN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 19:4" />उन्को सोय जान को पहिले, सदोम नगर को आदमियों न, जवानों सी ले क बूढ्ढा तक, बल्की चारयी तरफ को सब लोगों न आय क ऊ घर ख घेर लियो; <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" /><note caller="+" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="JDG 19:22-24">न्यायियों 19:22-24</ref></char></note>अऊर लूत ख पुकार क कहन लग्यो, “जो आदमी अज रात ख तोरो जवर आयो हंय हि कित हंय? उन्ख हमरो जवर बाहेर ले आव, कि हम उन्को संग संभोग करे।”<verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />तब लूत दरवाजा सी निकल क उन्को जवर आयो, अऊर दरवाजा ख अपनो पीछू बन्द कर क् उन्को सी कह्यो, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />“हे मोरो भाऊवों, मय तुम्हरो सी बिनती करू हय, असी बुरी बात मत करो। <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />देखो, मोरी दोय बेटियां हंय जो अब तक कुंवारी हंय, मोख उन्ख तुम्हरो जवर लावन देवो, अऊर तुम जसो चाहवय हय वसोच उन्को संग व्यवहार करो : लेकिन इन लोगों लायी कुछ भी मत करो; हि मोरो घर म मिजवान हय, अऊर मोख इन की मदत करनो हंय।”<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />उन्न कह्यो, “हट जा!” तब हि कहन लग्यो, “तय एक परदेशी होय क यहां रहन लायी आयो पर अब तय सच्चो भी बन बैठ्यो हय; येकोलायी अब हम उन्को सी भी जादा तोरो संग बुरो व्यवहार करबो।” अऊर उन्न लूत ख पीछू ढकल दियो अऊर दरवाजा तोड़न लायी जवर आयो। <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />तब उन दूतों न हाथ बढ़ाय क लूत ख अपनो जवर घर म खीच लियो, अऊर दरवाजा ख बन्द कर दियो। <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" /><note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="2KI 6:18">२ राजा ६:१८</ref></char></note>अऊर उन्न का छोटो, का बड़ो, सब आदमियों ख जो घर को दरवाजा पर होतो अन्धा कर दियो, तब हि दरवाजा ख ढूंढतो ढूंढतो थक गयो।<verse eid="GEN 19:11" /></para>
  <para style="s">लूत को सदोम सी बच निकलनो</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />तब दोय दूत न लूत सी कह्यो, “अगर तोरो यहां कोयी अऊर हय? बेटा, बेटियां, जवायी, या नगर म रहन वालो कोयी दूसरो रिश्तेदार, त उन पूरो ख ले क यो जागा सी निकल जा। <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />कहालीकि हम यो जागा ख नाश करन जाय रह्यो हंय। येकोलायी कि परमेश्वर न इन लोगों को खिलाफ भयानक आरोपों ख सुन्यो हय अऊर हम्ख सदोम ख नाश करन लायी भेज्यो हय।”<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />तब लूत घर सी निकल क अपनो जवायियों को जवर गयो, जो ओकी बेटियां सी बिहाव करन वालो होतो, त लूत न उन्को सी कह्यो, “उठो, अऊर यो जागा सी निकल चलो; कहालीकि परमेश्वर यो नगर ख नाश करन वालो हय।” पर लूत को जवायियों न समझ्यो कि ऊ उन्को सी मजाक कर रह्यो हय।<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />जब सुबेरे भयी तब स्वर्गदूतों न लूत सी जल्दी करन ख कह्यो अऊर बोल्यो, “उठो, अऊर अपनी पत्नी अऊर दोयी बेटियां ख जो यहां हंय इन्क ले क बाहेर निकल जावो : नहीं त तुम भी यो नगर को अधर्म को दण्ड म भस्म होय जावो।” <verse eid="GEN 19:15" /><verse number="16" style="v" sid="GEN 19:16" /><note caller="+" style="x"><char style="xo" closed="false">19:16 </char><char style="xt" closed="false"><ref loc="2PE 2:7">२ पतरस 2:7</ref></char></note>पर ऊ देर करतो रह्यो, तब स्वर्गदूत न ओको अऊर ओकी पत्नी, अऊर दोयी बेटियों को हाथ पकड़ क उन्ख नगर सी बाहेर लिजायो : कहालीकि परमेश्वर की दया लूत पर होती। <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />तब स्वर्गदूतों न उन्ख नगर को बाहेर निकाल क, उन्को सी कह्यो, “अपनो जीवन लायी भगो! अऊर पीछू मुड़ क मत देखो, अऊर घाटी म मत रुको। पहाड़ियों पर भगो, नहीं त तुम भी भस्म होय जावो।”<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />लूत न उन्को सी कह्यो, “हे प्रभु, कृपया असो मत कर! <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />देख, तोरो दास पर तोरी अनुग्रह की नजर भयी हय, अऊर तय न येको म बड़ी कृपा दिखायी, कि मोरो जीव ख बचायो हय; पर मय पहाड़ी पर भग नहीं सकू, कहीं असो नहीं होय, कि कोयी दुर्घटना मोरो संग होय जाये, अऊर मय मर जाऊं। <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />देख, ऊ नगर असो जवर हय कि मय उत भग सकू हय, अऊर ऊ छोटो भी हय। मोख उतच भग जान दे, का ऊ नगर छोटो नहाय? अऊर मोरो जीव बच जायेंन।”<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />स्वर्गदूत न लूत सी कह्यो, “देख, मय न यो बारे म भी तोरी बिनती स्वीकार करी हय, कि जो नगर की चर्चा तय न करी हय, ओख मय नाश नहीं करूं। <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />फुर्ती सी उत भग जा; कहालीकि जब तक तय उत नहीं पहुंच जाजो तब तक मय कुछ नहीं कर सकूं।”</para>
  <para style="p" vid="GEN 19:22">योच वजह ऊ नगर को नाम सोअर<note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="ft" closed="false">छोटो</char></note> पड़्यो।<verse eid="GEN 19:22" /></para>
  <para style="s">सदोम अऊर अमोरा को विनाश</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />जब लूत सोअर नगर को जवर पहुंच्यो, तब धरती पर सूरज उदय भयो। <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" /><note caller="+" style="x"><char style="xo" closed="false">19:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">मत्ती 10:15</ref>; <ref loc="LUK 10:12">लूका 10:12</ref>; <ref loc="2PE 2:6">२ पतरस २:६</ref></char></note>तब परमेश्वर न अपनो तरफ सी सदोम अऊर अमोरा पर आसमान सी गन्धक अऊर आगी बरसायी; <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />अऊर ओन उन नगरों अऊर पूरी घाटी ख, अऊर नगरों को सब निवासियों ख, अऊर जमीन की पूरी उपज समेत नाश कर दियो। <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" /><note caller="+" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="LUK 17:32">लूका 17:32</ref></char></note>लूत की पत्नी जो ओको पीछू होती, ओन पीछू मुड़ क देख्यो, अऊर वा नमक को खम्बा बन गयी।<verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />अब्राहम सुबेरे उठ क ऊ जागा पर गयो, जित ऊ पहिले परमेश्वर को जवर खड़ो होतो; <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />ओन सदोम, अमोरा, अऊर ऊ घाटी को पूरो देश को तरफ नजर करी अऊर देख्यो कि धधकती हुयी भट्टी को जसो धुवा जमीन सी निकल क ऊपर जाय रह्यो हय। <verse eid="GEN 19:28" /><verse number="29" style="v" sid="GEN 19:29" />अऊर असो भयो कि जब परमेश्वर न ऊ घाटी को नगरों ख नाश करयो, तब ओख अब्राहम की याद आयी, जब ओन उन नगरों ख उलट पुलट कर दियो, जित लूत रहत होतो, तब विनाश को बीच म सी लूत ख ऊ घटना सी बचाय लियो।<verse eid="GEN 19:29" /></para>
  <para style="s">मोआब अऊर अम्मोनी जातियों की उत्पत्ति</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />लूत न सोअर नगर ख छोड़ दियो, अऊर पहाड़ी पर अपनी दोयी बेटी को संग रहन लग्यो; कहालीकि ऊ सोअर म रहन सी डरत होतो; येकोलायी लूत अऊर ओकी दोयी बेटी पहाड़ी पर एक गुफा म रहन लग्यो। <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />तब बड़ी बेटी न अपनी छोटी बहिन सी कह्यो, “हमरो बाप बूढ्ढा हय, अऊर हमरो सी बिहाव करन लायी पूरी धरती भर म कोयी असो आदमी नहाय जो जगत की रीति रिवाज को अनुसार हमरो जवर आये अऊर हम सन्तान पैदा कर सके। <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />येकोलायी आव, हम अपनो बाप ख अंगूर रस पिलाय क, ओको संग सोयबो, जेको सी कि हम अपनो बाप को वंश ख बचायो रखबो।” <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />दोयी बेटी न ऊ रात अपनो बाप ख अंगूर रस पिलायो, अऊर तब बड़ी बेटी जाय क अपनो बाप को संग सोय गयी; पर ओको बाप ख पता नहीं चल्यो, कि वा कब आय क सोयी, अऊर कब उठ क चली गयी।<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />दूसरो दिन बड़ी बेटी न अपनी छोटी बहिन सी कह्यो, “देख, मय कल रात बाप को संग सोयी होती; येकोलायी अज भी रात ख अपनो बाप ख अंगूर रस पिलायबो; तब तय जाय क ओको संग सोय जाजो, कि हम अपनो बाप को द्वारा वंश पैदा करबो।” <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />येकोलायी ऊ रात उन्न अपनो बाप ख अंगूर रस पिलायो, अऊर छोटी बेटी जाय क ओको संग सोय गयी; पर ओको बाप ख पता नहीं चल्यो, कि वा कब आय क सोयी, अऊर कब उठ क चली गयी। <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />यो तरह लूत की दोयी बेटी अपनो बाप सी गर्भवती भयी। <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />बड़ी बेटी ख एक बेटा पैदा भयो, ओन ओको नाम मोआब<note caller="+" style="f"><char style="fr" closed="false">19:37 </char><char style="ft" closed="false">अपनो बाप सी</char></note> रख्यो; ऊ अज तक मोआबी जाति को पूर्वज मान्यो जावय हय। <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />अऊर छोटी बेटी ख भी एक बेटा पैदा भयो, ओन ओको नाम बेनम्मी<note caller="+" style="f"><char style="fr" closed="false">19:38 </char><char style="ft" closed="false">मोरो कुटुम्बी को टुरा</char></note> रख्यो; ऊ अज तक अम्मोनी जाति को पूर्वज मान्यो जावय हय।<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">अब्राहम अऊर अबीमेलेक</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />तब अब्राहम उत सी निकल क कनान को दक्षिन देश म आय क कादेश अऊर शूर को बीच म ठहरयो, अऊर गरार नगर म रहन लग्यो। <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" /><note caller="+" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="GEN 12:3">उत्पत्ति 12:3</ref>; <ref loc="GEN 26:7">26:7</ref></char></note>अऊर अब्राहम न अपनी पत्नी सारा को बारे म कहन लग्यो, “वा मोरी बहिन आय,” येकोलायी गरार नगर को राजा अबीमेलेक न दूत भेज क सारा ख अपनो पास बुलाय लियो। <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />पर रात ख परमेश्वर न सपनो म अबीमेलेक को जवर आय क कह्यो, “सुन, जो बाई ख तय न रख लियो हय, ओको वजह तय मर जाजो, कहालीकि वा सुहागिन हय।”<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />पर अबीमेलेक अब तक सारा को जवर नहीं गयो होतो; येकोलायी ओन कह्यो, “हे परमेश्वर, मय निर्दोष हय? का तय मोख अऊर मोरो लोगों ख भी नाश कर देजो? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />का अब्राहम न खुद मोरो सी नहीं कह्यो होतो, ‘वा मोरी बहिन आय?’ अऊर वा बाई न भी खुद कह्यो होतो, ‘कि यो मोरो भाऊ आय,’ मय न त अपनो मन की खराई अऊर अपनो व्यवहार की सच्चायी सी यो काम करयो हय।”<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />परमेश्वर न ओको सी सपनो म कह्यो, “हव, मय भी जानु हय कि तय न अपनो मन की खराई सी यो काम करयो हय अऊर मय न तोख रोक क भी रख्यो कि तय मोरो खिलाफ पाप मत करे; योच वजह मय न तोख ओख छूवन नहीं दियो। <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />येकोलायी तय वा बाई ख ओको पति ख वापस दे दे; कहालीकि ऊ एक भविष्यवक्ता आय, अऊर ऊ तोरो लायी प्रार्थना करेंन, ताकि तय जीन्दो रह्यजो, अगर तय ओख वापस नहीं देवय हंय, त मय तोख चेतावनी देऊ हय कि तय अऊर तोरो नगर को पूरो लोग मर जायेंन।”<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />दूसरो दिन अबीमेलेक न सुबेरे जल्दी उठ क अपनो सब अधिकारियों ख बुलाय क यो सब बाते बतायी; अऊर हि लोग बहुत डर गयो। <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />तब अबीमेलेक अब्राहम ख बुलाय क कह्यो, “तय न हमरो संग यो का करयो हय? अऊर मय न तोरो का बिगाड़्यो होतो कि तय न मोरो अऊर मोरो राज्य को ऊपर असो बड़ो पाप डाल दियो हय? तय न मोरो संग जो व्यवहार करयो हय ऊ तोख नहीं करनो होतो।” <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />तब अबीमेलेक न अब्राहम सी पुच्छ्यो, “तय न का समझ क असो काम करयो?”<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />अब्राहम न कह्यो, “मय न यो सोच्यो होतो कि यो जागा म परमेश्वर को कुछ भी डर नहीं होयेंन; येकोलायी हि लोग मोख मोरी पत्नी को वजह मार डालेंन। <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />वा वास्तव म सचमुच मोरी बहिन आय, वा मोरो बाप की बेटी त आय, लेकिन मोरी माय की नहीं, तब वा मोरी पत्नी होय गयी। <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />अऊर असो भयो कि जब परमेश्वर न मोख अपनो बाप को घर छोड़ क निकलन कि आज्ञा दी, तब मय न ओको सी कह्यो, ‘इतनी कृपा तोख मोरो पर करनो होना कि हम दोयी जित जित जाबो उत उत तय मोरो बारे म कह्यजो कि यो मोरो भाऊ आय।’”<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />अब अबीमेलेक न शेरी मेंढी, गाय बईल, अऊर दास दासी अब्राहम ख भेंट दे दियो, अऊर ओकी पत्नी सारा भी ओख वापस कर दियो। <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />अऊर अबीमेलेक न कह्यो, “देख, मोरो देश तोरो आगु हय; जो जागा तोरी नजर म अच्छी लगे, उत तय रह्य सकय हय।” <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />अऊर सारा सी अबीमेलेक न कह्यो, “देख, मय न तोरो भाऊ ख एक हजार चांदी को सिक्का दियो हंय। जो लोग तोरो संग हंय, उन सब लोगों की नजर म तय निर्दोष हंय; अऊर सब लोगों ख पता चल जायेंन कि तय न कोयी गलत काम नहीं करयो हय।”<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />तब अब्राहम न परमेश्वर सी प्रार्थना करी, अऊर परमेश्वर न अबीमेलेक, अऊर ओकी पत्नी अऊर दासियों ख चंगो करयो, अऊर हि फिर सी सन्तान पैदा करन लगी। <verse eid="GEN 20:17" /><verse number="18" style="v" sid="GEN 20:18" />कहालीकि परमेश्वर न अब्राहम की पत्नी सारा को वजह अबीमेलेक को घर की सब बाईयों की कोखों ख पूरी रीति सी बन्द कर दियो होतो।<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">इसहाक को जनम</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />परमेश्वर न सारा ख आशीर्वाद दियो, जसो ओन वादा करयो होतो। <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" /><note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="HEB 11:11">इब्रानियों 11:11</ref></char></note>अऊर सारा अब्राहम सी गर्भवती भयी; अऊर जब ऊ बूढ्ढा भय गयो त अब्राहम ख एक बेटा पैदा भयो। बेटा ठहरायो समय पर पैदा भयो होतो जब परमेश्वर न कह्यो होतो कि ऊ पैदा होयेंन। <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />अब्राहम न अपनो ऊ बेटा को नाम जो सारा सी पैदा भयो होतो इसहाक रख्यो। <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" /><note caller="+" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="GEN 17:12">उत्पत्ति 17:12</ref>; <ref loc="ACT 7:8">प्रेरितों 7:8</ref></char></note>अऊर जब इसहाक आठ दिन को भयो, तब अब्राहम न ओको खतना करयो, जसो परमेश्वर न आज्ञा दियो होतो। <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />अपनो बेटा इसहाक को जनम को समय अब्राहम सौ साल को होतो। <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />अऊर सारा न कह्यो, “परमेश्वर न मोख खुशी अऊर हसी दी हंय; येकोलायी जो कोयी येको बारे म सुनय हय ऊ मोरो संग हसेंन।” <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />तब ओन कह्यो, “अब्राहम सी कौन कह्यो होना, कि सारा बच्चां ख दूध पिलायेंन? तब भी मय न अब्राहम ख ओको बुढ़ापा म बेटा ख जनम दियो।”<verse eid="GEN 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />अऊर ऊ बच्चा बड़ो भयो, अऊर ओको दूध छुड़ायो गयो; जो दिन इसहाक को दूध छुड़ायो गयो, ऊ दिन अब्राहम न एक बहुत अच्छो जेवन दियो।<verse eid="GEN 21:8" /></para>
  <para style="s">हाजिरा अऊर इश्माएल को निकाल्यो जानो</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />एक दिन सारा न मिस्री हाजिरा को बेटा ख, जेक हाजिरा न अब्राहम सी पैदा करयो होतो, सारा न अपनो बेटा इसहाक को संग खेलतो देख्यो। <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" /><note caller="+" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="GAL 4:29">गलातियों 4:29</ref>,<ref loc="GAL 4:30">30</ref></char></note>यो वजह सारा न अब्राहम सी कह्यो, “या दासी ख बेटा सहित निकाल दे : कहालीकि या दासी को बेटा मोरो बेटा इसहाक को संग उत्तराधिकारी नहीं बनेंन।” <verse eid="GEN 21:10" /><verse number="11" style="v" sid="GEN 21:11" />अपनो बेटा इश्माएल को सम्बन्ध म असी बात अब्राहम ख बहुत बुरी लगी। <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" /><note caller="+" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="HEB 11:18">इब्रानियों 11:18</ref>; <ref loc="ROM 9:7">रोमियों 9:7</ref></char></note>तब परमेश्वर न अब्राहम सी कह्यो, “तय बच्चा अऊर अपनी दासी को वजह बुरो मत मान; जो बात सारा तोरो सी कह्य हय, ओख सुन, कहालीकि इसहाक द्वारा तोरो वंशजों म तोरो नाम बन्यो रहेंन। <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />मय दासी को बेटा सी एक राष्ट्र पैदा करूं; कहालीकि ऊ तोरी सन्तान हय।”<verse eid="GEN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 21:14" />येकोलायी अब्राहम न सुबेरे जल्दी उठ क रोटी अऊर पानी सी भरी चमड़ा की झोली भी हाजिरा ख दी, अऊर ओख हाजिरा को बख्खा पर रख दियो, अऊर बच्चा सहित ओख बिदा कर दियो, हाजिरा चली गयी, अऊर बेर्शेबा को जंगल म भटकन लगी। <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />जब झोली को पानी खतम होय गयो, तब ओन बच्चा ख एक झाड़ी को खल्लो छोड़ दियो। <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />अऊर लगभग सौ मीटर दूर<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false">तीर को टप्पा की दूरी तक</char></note> जाय क बैठ गयी; ओन खुद सी कह्यो, “मय अपनो बच्चा ख मरतो हुयो नहीं देख सकू।” जब वा ओको आगु दूर बैठी तब बच्चा जोर जोर सी रोवन लग्यो।<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />परमेश्वर न बच्चा की रोवन की आवाज सुनी; अऊर परमेश्वर को दूत न स्वर्ग सी हाजिरा ख पुकारयो अऊर ओको सी कह्यो, “हे हाजिरा, तोख का भयो हय? मत डर, कहालीकि जित तोरो बच्चा पड़्यो हय उत सी परमेश्वर न ओकी आवाज सुनी हय। <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />उठ, अऊर अपनो बच्चा ख उठाव अऊर ओख अपनो हाथों म सावधानी सी सम्भाल; कहालीकि मय ओको वंशजों म सी एक महान राष्ट्र बनाऊं।” <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />तब परमेश्वर न ओकी आंखी खोल दी, अऊर ओख एक कुंवा दिखायी दियो; तब वा ओको जवर गयी, अऊर झोली म पानी भर क बच्चा ख पिलायी। <verse eid="GEN 21:19" /><verse number="20" style="v" sid="GEN 21:20" />अऊर परमेश्वर बच्चा को जवर होतो; अऊर जब ऊ बड़ो होतो गयो, तब ऊ सुनसान जागा म रह्यतो रह्यतो धनुर्धारी बन गयो। <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />ऊ पारान नाम को जंगल म रहत होतो; अऊर ओकी माय न ओको लायी मिस्र देश सी एक लड़की मंगवायी।<verse eid="GEN 21:21" /></para>
  <para style="s">अब्राहम अऊर अबीमेलेक को बीच समझौता</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">21:22 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 26:26">उत्पत्ति 26:26</ref>
      </char>
    </note>उन दिनों म असो भयो कि अबीमेलेक अपनो सेनापति पीकोल ख संग ले क अब्राहम सी कहन लग्यो, “जो कुछ तय करय हय ऊ काम म परमेश्वर तोरो संग रह्य हय। <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />येकोलायी अब मोरो सी इत यो बारे म परमेश्वर की कसम खा कि तय न मोरो सी, अऊर न मोरी सन्तान सी अऊर न मोरो वंश सी छल कपट करजो, पर जसो मय न तोरो संग प्रेम को व्यवहार करयो हय, वसोच तय मोरो पर अऊर यो देश को संग जित तय रह्य हंय, वसोच व्यवहार करजो।”<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />अब्राहम न कह्यो, “मय कसम खाऊ हय।”<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />पर जब अब्राहम न अपनो एक कुंवा को बारे म अबीमेलेक सी शिकायत करी, जेको पर अबीमेलेक को दासों न कब्जा कर लियो होतो। <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />तब अबीमेलेक न कह्यो, “मय नहीं जानु कि कौन यो काम करयो हय; अऊर तय न भी मोख नहीं बतायो, अऊर मय न अज तक येको बारे म सुन्यो भी नहीं होतो।” <verse eid="GEN 21:26" /><verse number="27" style="v" sid="GEN 21:27" />तब अब्राहम न शेरी मेंढी, अऊर गाय बईल अबीमेलेक ख भेंट दियो; अऊर उन दिनों न आपस म वाचा बान्धी। <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />अब्राहम न मेंढी को सात बच्चा ख झुण्ड सी अलग रख्यो। <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />तब अबीमेलेक न अब्राहम सी पुच्छ्यो, “इन सात मेंढी को बच्चा ख, जिन्ख तय न अलग रख्यो हय, का मतलब हय?”<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />अब्राहम न उत्तर दियो, “तय मोरो हाथ सी इन सात मेंढी को बच्चा ख स्वीकार करजो कि तय मोरो गवाह बनजो कि मय नच यो कुंवा खुदवायो होतो।” <verse eid="GEN 21:30" /><verse number="31" style="v" sid="GEN 21:31" />उत उन दोयी न कसम खायी, येकोलायी ऊ जागा को नाम बेर्शेबा<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="ft" closed="false">कसम को कुंवा </char></note> पड़्यो।<verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />जब उन्न बेर्शेबा म यो वाचा बान्धी, तब अबीमेलेक अऊर ओको सेनापति पीकोल, उठ क पलिश्तियों को देश म लौट गयो। <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" /><note caller="+" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 40:28">यशायाह 40:28</ref>; <ref loc="1TI 1:17">१ तीमुथियुस १:१७</ref></char></note>तब अब्राहम न बेर्शेबा म झाऊ<note caller="+" style="f"><char style="fr" closed="false">21:33 </char><char style="ft" closed="false">इमली को जसो दिखन वालो</char></note> को एक झाड़ लगायो, अऊर परमेश्वर की आराधना करी। <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />अऊर अब्राहम लम्बो समय तक पलिश्तियों को देश म रह्यो।<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">अब्राहम को परीक्षा म पड़न को वर्नन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:1 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 11:17-19">इब्रानियों 11:17-19</ref>; <ref loc="GEN 21">उत्पत्ति 21</ref>; <ref loc="GEN 11">11</ref>; <ref loc="EXO 3:4">निर्गमन 3:4</ref></char>
    </note>इन बातों को बाद असो भयो कि परमेश्वर न अब्राहम सी यो कह्य क ओकी परीक्षा ली, “हे अब्राहम!” ओन कह्यो, “का आज्ञा हय।”<verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:2 </char>
      <char style="xt" closed="false">
        <ref loc="2CH 3:1">२ इतिहास 3:1</ref>
      </char>
    </note>परमेश्वर न कह्यो, “अपनो बेटा ख यानेकि अपनो एकलौतो बेटा इसहाक ख, जेको सी तय प्रेम रखय हय, तय ओख ले क मोरिय्याह देश म चली जा, अऊर उत ओख एक पहाड़ी को ऊपर जो मय तोख बताऊं, तय अपनो बेटा ख होमबलि<note caller="+" style="f"><char style="fr" closed="false">22:2 </char><char style="ft" closed="false">आगी म जलाय क</char></note> म चढ़ाजो।”<verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />अगलो दिन की सुबेरे अब्राहम न होमबलि लायी कुछ लकड़ी काटी, अऊर अपनो गधा पर कस दी, अऊर इसहाक अऊर दोय सेवकों ख अपनो संग ले गयो। तब उन्न ऊ जागा लायी सुरूवात करी, जेको बारे म परमेश्वर न उन्ख बतायो होतो। <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />तीसरो दिन अब्राहम न आंखी उठाय क ऊ जागा ख दूर सी देख्यो। <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />अऊर अब्राहम न अपनो सेवकों सी कह्यो, “तुम इतच गधा को जवर रुक्यो रहो; मय अऊर इसहाक आगु जाय क आराधना करबो, तब तुम्हरो जवर वापस आबो।”<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />तब अब्राहम न अपनो बेटा इसहाक ख होमबलि की लकड़ी चढ़ान लायी कह्यो, अऊर अपनो हाथ म आगी अऊर छुरी लियो; अऊर हि दोयी एक संग चल्यो। <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />इसहाक न अपनो बाप अब्राहम सी कह्यो, “हे मोरो बाप,”</para>
  <para style="p" vid="GEN 22:7">अब्राहम न कह्यो, “हे मोरो बेटा, का बात हय?”</para>
  <para style="p" vid="GEN 22:7">इसहाक न कह्यो, “देख, आगी अऊर लकड़ी त हंय; पर होमबलि लायी मेंढी को बच्चा कित हय?”<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />अब्राहम न उत्तर दियो, “हे मोरो बेटा, परमेश्वर खुद होमबलि लायी मेम्ना को इंतजाम करेंन।” अऊर हि दोयी संग संग आगु चलतो गयो।<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:9 </char>
      <char style="xt" closed="false">
        <ref loc="JAS 2:21">याकूब 2:21</ref>
      </char>
    </note>जब हि ऊ जागा पर पहुंच्यो, जेको बारे म परमेश्वर न अब्राहम सी कह्यो होतो; तब उत अब्राहम न वेदी बनाय क लकड़ी ख बिन बिन क रख्यो, अऊर अपनो बेटा इसहाक ख बान्ध क वेदी पर रखी लकड़ियों को ऊपर रख दियो। <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />तब अब्राहम न अपनो बेटा ख बलि करन लायी हाथ बढ़ाय क छुरी उठायो। <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />तब यहोवा को दूत न स्वर्ग सी ओख पुकार क कह्यो, “हे अब्राहम, हे अब्राहम!”</para>
  <para style="p" vid="GEN 22:11">ओन उत्तर दियो, “का आज्ञा हय।”<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />दूत न कह्यो, “ऊ बच्चा को तरफ अपनो हाथ मत बढ़ा अऊर ओख कुछ हानि मत पहुंचाव, अब मय जान गयो हय कि तय परमेश्वर को सम्मान करय हय अऊर ओको पालन करय हय, कहालीकि तय न अपनो एकलौतो बेटा ख नहीं रख छोड़्यो हय।”<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:13 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 11:17-19">इब्रानियों 11:17-19</ref>
      </char>
    </note>तब अब्राहम न अपनी आंखी ऊपर ऊठायी, तब देख्यो, कि ओको पीछू एक मेंढा हय, ऊ अपनो सींगो सी एक झाड़ी म फस्यो हुयो हय; तब अब्राहम गयो, अऊर ऊ मेंढा ख पकड़्यो अऊर अपनो बेटा की जागा पर ओकी होमबलि कर क् चढ़ायो। <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />अब्राहम न ऊ जागा को नाम “यहोवा इंतजाम करय हय, रख्यो।” येकोलायी अज तक लोग यो भी कह्य हंय, “यहोवा की पहाड़ी पर इंतजाम करयो जायेंन।”<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />तब यहोवा को दूत न दूसरी बार स्वर्ग सी अब्राहम ख पुकार क कह्यो, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />“यहोवा अपनीच कसम खाय क कह्य हय, कि तय न यो काम करयो हय; कहालीकि तय न मोरो लायी अपनो बेटा, यानेकि अपनो एकलौतो बेटा ख भी नहीं रख छोड़्यो; <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />यो वजह मय जरूर तोख आशीष देऊं, अऊर तोरो वंश ख आसमान को तारों, अऊर समुन्दर किनार को बहुत रेतु को जसो अनगिनत करूं, अऊर तोरो वंश अपनो दुश्मनों को नगरों को अधिकारी होयेंन; <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />अऊर धरती को पूरो राष्ट्र तोरो वंश को द्वारा मोरो सी आशीष हासिल करेंन : कहालीकि तय न मोरी आज्ञा सुन क ओको पालन करयो।” <verse eid="GEN 22:18" /><verse number="19" style="v" sid="GEN 22:19" />येको बाद अब्राहम अपनो सेवकों को जवर वापस आयो, अऊर हि सब उठ क ओको संग बेर्शेबा गयो, अऊर अब्राहम बेर्शेबा म रहन लग्यो।<verse eid="GEN 22:19" /></para>
  <para style="s">नाहोर को वंशज</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />कुछ समय को बाद, अब्राहम ख यो बतायो गयो, “मिल्का भी माय बन गयी हय; ओन तोरो भाऊ नाहोर लायी आठ बेटा ख जनम दियो हय।” <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />बड़ो बेटा ऊस, अऊर ऊस को भाऊ बूज, अऊर कमूएल, जो आराम को बाप भयो। <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />तब केसेद, हजो, पिल्दाश, यिद्लाप, अऊर बतूएल। <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />इन आठ बेटां ख मिल्का न अब्राहम को भाऊ नाहोर को द्वारा जनम दियो। अऊर बतूएल सी रिबका पैदा भयी। <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />तब नाहोर की रूमा नाम की एक रखैल भी होती; जेको सी तेबह, गहम, तहश, अऊर माका, पैदा भयो।<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">सारा की मृत्यु अऊर आखरी क्रिया को वर्नन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />सारा एक सौ सत्ताईस साल की भयी; <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />तब सारा की मृत्यु किर्यतर्बा यानेकि हेब्रोन नगर म भयी। जो कनान देश म हय। तब अब्राहम न सारा की मृत्यु लायी शोक मनायो।<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />तब अब्राहम न अपनी पत्नी को शव को जवर सी उठ क हित्तियों सी कह्यो; <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" /><note caller="+" style="x"><char style="xo" closed="false">23:4 </char><char style="xt" closed="false"><ref loc="HEB 11:9-13">इब्रानियों 11:9-13</ref>; <ref loc="ACT 7:16">प्रेरितों 7:16</ref></char></note>“मय त तुम्हरो बीच एक परदेशी अऊर अजनबी हय; मोख मरघट लायी अपनो इत जमीन देवो ताकि मय अपनी पत्नी को शव ख गाड़ सकूं।”<verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />हित्तियों को सन्तानों न अब्राहम सी कह्यो, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“श्रीमान, तय हमरी बात सुन। तय हमरो बीच म बड़ो प्रधान हंय। तय जित चाहवय अपनी पत्नी ख हमरो अच्छो कब्र म गाड़ सकय हंय। हम म सी कोयी भी तोख अपनी पत्नी ख गाड़न लायी अपनो कब्र देन सी मना नहीं करेंन।”<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />तब अब्राहम उठ्यो अऊर ऊ देश को लोगों ख यानेकि हित्तियों ख झुक क नमस्कार करयो, <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />अऊर अब्राहम न उन्को सी कह्यो, “यदि तुम चाहवय हंय कि मय अपनी पत्नी ख माटी देऊं, तब मोरी एक बात अऊर मान लेवो अऊर तुम सोहर को बेटा एप्रोन सी मोरो लायी बिनती करो, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />ताकि ऊ मकपेला की गुफा ख, जो ओकी जमीन की सीमा पर हय; ओको पूरो दाम ले क मोख बेच दे, ताकि ऊ तुम्हरो बीच म हमरो लायी एक मरघट की जागा हो।”<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />एप्रोन त हित्तियों को बीच उत बैठ्यो हुयो होतो, येकोलायी जितनो हित्ति ओको नगर को फाटक सी होय क अन्दर जात होतो, उन पूरो को आगु एप्रोन न अब्राहम सी कह्यो, <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />“हे मोरो स्वामी; मोरी बात सुनो; मय तोख ऊ गुफा जमीन सहित मोरो लोगों को आगु दे रह्यो हय; तय येको म अपनी पत्नी ख गाड़ दे।”<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />तब अब्राहम न फिर सी हित्तियों को आगु झुक क नमस्कार करयो। <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />अऊर ऊ उन्को सुनतो हुयो एप्रोन सी कह्यो, “यदि तय असो चाहे, त मोरी सुन ऊ जमीन को जो दाम हो, ऊ मय देनो चाहऊ हय; ओख मोरो सी ले ले, तब मय अपनी पत्नी को शव ख उत गाड़ सकूं।”<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />एप्रोन न अब्राहम ख यो उत्तर दियो, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“हे मोरो स्वामी, मोरी बात सुन; ऊ जमीन को दाम त चार सौ चांदी को सिक्का हय; पर ऊ मोरो अऊर तोरो बीच म का हय? तय अपनी पत्नी ख गाड़ दे।” <verse eid="GEN 23:15" /><verse number="16" style="v" sid="GEN 23:16" />अब्राहम न एप्रोन की बात मान क ओख उतनो रूप्या की चांदी तौल क दे दियो, जितनो ओन हित्तियों को सुनतो म कह्यो होतो : चार सौ चांदी को सिक्का जो ऊ समय व्यापारियों को बीच म चलत होतो।<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />येकोलायी एप्रोन को ऊ जमीन अऊर गुफा, जो मकपेला म मम्रे को जवर होतो, अऊर जमीन को पूरो झाड़ जो ओको म अऊर ओको चारयी तरफ सीमा को अन्दर होतो, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" /><note caller="+" style="x"><char style="xo" closed="false">23:18 </char><char style="xt" closed="false"><ref loc="ACT 7:16">प्रेरितों 7:16</ref></char></note>सब अब्राहम ख दे दियो, जितनो हित्तियों नगर की फाटक पर जमा भयो होतो, उन पूरो को आगु वा सम्पत्ति अब्राहम को अधिकार म पक्की रीति सी आय गयी।<verse eid="GEN 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 23:19" />ओको बाद अब्राहम न अपनी पत्नी सारा ख मकपेला को जमीन की गुफा म गाड़ दियो, जो कनान देश को मम्रे मतलब हेब्रोन नगर म होतो। <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />यो तरह हित्तियों को द्वारा ऊ जमीन अऊर ओको म की गुफा मरघट को रूप म अब्राहम को अधिकार म दे दी गयी।<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">इसहाक को बिहाव को वर्नन</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />अब्राहम अब बहुत बूढ्ढा भय गयो होतो, अऊर ओकी उमर बहुत होती अऊर यहोवा न ओख हर काम म आशीर्वाद दियो होतो। <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" /><note caller="+" style="x"><char style="xo" closed="false">24:2 </char><char style="xt" closed="false"><ref loc="GEN 37:29">उत्पत्ति 37:29</ref></char></note>एक दिन अब्राहम न अपनो घर को सब सी बूढ्ढा अऊर अपनी सम्पत्ति की देखभाल करन वालो सेवक सी कह्यो, “अपनो हाथ मोरी जांघ<note caller="+" style="f"><char style="fr" closed="false">24:2 </char><char style="ft" closed="false">दूसरी पीढ़ी ख बान्धन वाली अटल कसम को अनुसार </char><char style="fp" closed="false">तथा यो तरह सी कसम खायी </char></note> पर रख; <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />मय तोख स्वर्ग अऊर धरती को परमेश्वर यहोवा की कसम खिलाऊ हय कि तय मोरो बेटा लायी कनानी जाति की टुरियों म सी, जिन्को बीच हम रह्य रह्यो हय, मोरो बेटा को बिहाव नहीं करावो। <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />पर तय मोरो देश म मोरो रिश्तेदारों म सी मोरो बेटा इसहाक लायी पत्नी लावो।”<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />ऊ सेवक न अब्राहम सी कह्यो, “ऊ स्थिति म मय का करूं, जब वा बाई यो देश म आनोच नहीं चाहे; का मय तोरो बेटा ख ऊ देश म ले जाऊं, जित सी तय आयो हंय?”<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />तब अब्राहम न कह्यो, “सावधान, तय मोरो बेटा ख उत कभी नहीं ले जाजो।” <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />यहोवा, जो स्वर्ग को परमेश्वर हंय, जो मोख मोरो बाप को परिवार अऊर मोरी जन्मभूमि सी लायो हय अऊर जिन्न कसम खाय क मोरो सी यो वादा करयो, “मय यो देश तोरो वंश ख देऊं; उच स्वर्गदूत ख तोरो आगु आगु भेजेंन, अऊर तय मोरो बेटा लायी उत सी एक बाई ले आये। <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />अगर बाई तोरो संग आन लायी मना करे, तब तय मोरी यो कसम सी छूट जाजो; लेकिन ध्यान रखजो कि तय मोरो बेटा ख वापस उत मत ले जाजो।” <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />येकोलायी ऊ सेवक न अपनो स्वामी अब्राहम की जांघ पर अपनो हाथ रख क अब्राहम सी यो बारे म कसम खायी।<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />तब ऊ सेवक न अपनो स्वामी को ऊंट को झुण्ड म सी दस ऊंटों ख लियो अऊर उन पर अपनो स्वामी को तरफ सी अलग अलग उपहार पकड़्यो अऊर नाहोर को नगर ख चली गयो जो उत्तरी मेशोपोटामियां देश म होतो। <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />नगर को जवर पहुंच क ओन ऊंटों ख कुंवा को जवर बैठाय दियो; यो शाम को समय होतो। योच समय बाईयां पानी भरन बाहेर आयो करत होती। <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />तब सेवक न प्रार्थना करी, “यहोवा, मोरो स्वामी अब्राहम को परमेश्वर, अज मोरो काम ख सफल कर, अऊर मोरो स्वामी अब्राहम पर दया कर। <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />तय देख रह्यो हय कि मय यो पानी को कुंवा को जवर खड़ो हय, अऊर यो नगर को निवासियों की टुरियां पानी भरन लायी निकल क आय रही हंय। <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />तय कुछ असो कर कि जो टुरी सी मय यो कहूं, ‘अपनो घड़ा झुकाय क कृपया मोख पानी पिलाय दे,’ अऊर वा टुरी कहे, ‘तय पानी पी ले, अऊर फिर मय तोरो ऊंटों ख भी पानी पिलाय देऊं,’ या वाच टुरी हो जेक तय न अपनो सेवक इसहाक लायी चुन्यो हय; येको द्वारा मोख यो विश्वास होय जायेंन कि तय न मोरो स्वामी पर अपनी दया दिखायी हय।”<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />अऊर असो भयो कि जब प्रार्थना करच रह्यो होतो, तबच रिबका नगर को बाहेर अपनो बख्खा पर घड़ा ले क पानी भरन आयी। वा मिल्का को बेटा बतूएल की टुरी होती अऊर मिल्का अब्राहम को भाऊ नाहोर की पत्नी होती। <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />रिबका बहुत सुन्दर होती, वा कुंवारी होती; अब तक कोयी आदमी सी ओको बिहाव नहीं भयो होतो। वा खल्लो कुंवा म उतरी, अऊर अपनो घड़ा पानी सी भरी अऊर तब ऊपर आय गयी। <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />सेवक दौड़ क ओको जवर आयो, अऊर ओको सी कह्यो, “कृपया अपनो घड़ा सी मोख थोड़ो पानी पिलाय देवो।”<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />रिबका न कह्यो, “हे मोरो स्वामी लेवो, पी लेवो,” अऊर ओन तुरतच घड़ा ख खल्लो कर क् ओख पानी पिलायो। <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />जब रिबका न सेवक ख पानी दियो, तब ओन ओको सी कह्यो, “मय तोरो ऊंटों लायी भी पानी ले क आऊ हय, जब तक हि पूरो सन्तुष्ट नहीं होय जाये।” <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />ओन जल्दी सी घड़ा को पानी जनावरों की डोंगी म खाली कर दियो, फिर वापस कुंवा पर अऊर पानी भरन गयी; अऊर ओको पूरो ऊंटों लायी उन्को लायक पानी ले आयी। <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />जब यो सब होय रह्यो होतो, तब सेवक ध्यान सी रिबका ख देख रह्यो होतो अऊर सोच रह्यो होतो कि यहोवा न मोरी यात्रा ख सफल करयो हय या नहीं।<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />जब ऊंटों न पानी पी लियो, तब सेवक न अरधो तोला की सोनो कि एक नथ निकाल क ओख दियो, अऊर दस तोला सोनो को कंगन ओको हाथों म पहिनाय दियो; <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />अऊर रिबका ख दे क ओको सी पुच्छ्यो, “कृपया, मोख बता, तय कौन्की बेटी आय? का तोरो बाप को घर म हमरो रूकन लायी जागा हय?”<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />रिबका न उत्तर दियो, “मय त नाहोर तथा मिल्का को बेटा बतूएल की बेटी आय।” <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />अऊर ओन यो भी कह्यो, “हमरो इत घास अऊर चारा बहुत हय, अऊर रूकन लायी जागा भी हय।”<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />तब ऊ सेवक न झुक क अऊर यो कह्य क यहोवा की आराधना करी, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />“धन्य हय यहोवा, मोरो स्वामी अब्राहम को परमेश्वर, जिन्न मोरो स्वामी को प्रति अपनो प्रेम अऊर करुना ख नहीं हटायो : यहोवा मोख सही जागा पर लायो जो मोरो स्वामी को रिश्तेदारों कोच घर हय।”<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />तब रिबका दौड़ क घर गयी अऊर अपनी माय को घर को लोगों ख सब बाते बतायी। <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />रिबका को भाऊ लाबान दौड़ क कुंवा को जवर गयो, जित अब्राहम को सेवक होतो। <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />जब लाबान न नथ अऊर अपनी बहिन रिबका को हाथों म कंगन देख्यो अऊर जो बात सेवक न कही होती, ओख सुन्यो, तब लाबान ऊ सेवक को जवर गयो, अऊर देख्यो कि ऊ सेवक कुंवा को जवर ऊंटों को बाजू म खड़ो हय। <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />लाबान न सेवक सी कह्यो, “हे यहोवा को तरफ सी धन्य आदमी अन्दर आव तय कहाली बाहेर खड़ो हय? मय न तोरो लायी, घर अऊर तोरो ऊंटों लायी भी जागा तैयार करी हय।”<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />अब्राहम को सेवक लाबान को संग घर म गयो; तब लाबान न ऊंटों पर सी सामान उतारयो, अऊर ऊंटों लायी पैरा अऊर चारा लायो; तब ओन सेवक अऊर ओको लोगों को पाय धोवन लायी पानी दियो। <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />तब सेवक ख जेवन दियो, पर ओन कह्यो, “मय तब तक जेवन नहीं करूं, जब तक कि मय अपनी बात नहीं सुनाय देऊं।”</para>
  <para style="p" vid="GEN 24:33">लाबान न कह्यो, “ठीक हय, बताय दे।”<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />“तब ओन कह्यो, मय अब्राहम को सेवक आय।” <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />यहोवा न मोरो स्वामी ख बहुत आशीष दी हंय, जेको सी ऊ धनवान भय गयो हंय; यहोवा न उन्ख बहुत शेरी-मेंढी, गाय-बईल, सोनो-चांदी, सेवक-सेविका, तथा ऊंट अऊर गधा दियो हंय। <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />अऊर मोरो स्वामी की पत्नी सारा ख बुढ़ापा म एक बेटा पैदा भयो, अऊर ऊ बेटा ख अब्राहम न अपनो सब कुछ दे दियो हय। <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />अऊर मोरो स्वामी न मोख कसम खिलायी हय। कि तय मोरो बेटा लायी कनानियों की टुरियों म सी जिन्को देश म मय रहू हय, कोयी पत्नी नहीं ले आऊं। <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />पर तय मोरो बाप को परिवार, मोरो अपनो वंश म जाजो, अऊर मोरो बेटा लायी एक पत्नी लाजो। <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />तब मय न अपनो स्वामी सी पुच्छ्यो, यदि वा बाई मोरो संग आनो नहीं चाहेंन तब का? <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />“मोरो स्वामी न कह्यो, ‘यहोवा, जेकी मय न हमेशा आज्ञा मानी हय, ऊ अपनो स्वर्गदूत ख तोरो संग भेजेंन अऊर तोरी यात्रा ख सफल करेंन, ताकि तय मोरो बेटा लायी मोरो अपनो वंश अऊर मोरो बाप को परिवार सी एक पत्नी लाय सकजो। <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />तय मोरी या कसम सी तबच छूट पायजो, जब तय मोरो वंश को लोगों को जवर जाजो, अऊर यदि हि वा बाई ख तोरो संग भेजन लायी मना करे तब तय मोरी कसम सी छूट जाजो।’<verse eid="GEN 24:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 24:42" />“येकोलायी मय अज जब कुंवा को जवर पहुंच्यो, त मय न यो प्रार्थना करी, ‘यहोवा, मोरो स्वामी अब्राहम को परमेश्वर, मय जो लक्ष सी इत आयो हय, ऊ काम पूरो होय जाये; <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />त देख, मय यो कुंवा को किनारे खड़ो हय; यदि कोयी बाई निकल क पानी भरन आवय हय, अऊर मय ओको सी कहूं, “अपनो घड़ा म सी मोख थोड़ो पानी दे,” <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />अऊर यदि वा मोरो सी कहे, “पी ले, अऊर मय तोरो ऊंटों लायी भी पानी ले क आऊ हय,” त वा वाच बाई हो, जेक परमेश्वर न मोरो स्वामी को बेटा लायी चुन्यो हय।’ <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />येको पहिले कि मय अपनो मन म यो प्रार्थना खतम करतो, त रिबका अपनो कन्धा पर घड़ा धर क निकल आयी; तब वा खल्लो कुंवा को जवर जाय क पानी भरन लगी, अऊर मय न ओको सी कह्यो, ‘कृपया मोख पानी पिलाय दे।’ <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />तब ओन तुरतच अपनो कन्धा पर सी घड़ा ख झुकाय क कह्यो, ‘ले, पी ले, अऊर तब मय तोरो ऊंटों ख भी पानी पिलाय देऊं,’ तब मय न पानी पियो, अऊर ओन ऊंटों ख भी पानी पिलाय दियो। <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />तब मय न ओको सी पुच्छ्यो, ‘तय कौन्की टुरी आय?’ ओन कह्यो, ‘मय बतूएल की टुरी आय, जो नाहोर तथा मिल्का को बेटा आय,’ तब मय न ओकी नाक म नथ, अऊर ओको हाथों म कंगन पहिनाय दियो। <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />तब मय न झुक क यहोवा की आराधना करी, मय न अपनो स्वामी अब्राहम को परमेश्वर यहोवा की महिमा करी, कहालीकि ओन मोख सही रस्ता म अगुवायी करी, ताकि मय अपनो स्वामी को टुरा लायी रिश्तेदार की टुरी ख ले जाऊं। <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />येकोलायी अब, यदि तुम मोरो स्वामी को प्रति दया अऊर सच्चायी दिखानो चाहवय हय, त मोख बतावो; अऊर यदि नहीं चाहवय हय, तब भी मोरो सी कह्य देवो; ताकि मय जान सकूं कि मोख का करनो हय।”<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />यो सब सुन क लाबान अऊर बतूएल न उत्तर दियो, “यो बात यहोवा को तरफ सी भयी हय; येकोलायी हम लोग तोरो सी भलो या बुरो कुछ नहीं कह्य सकजे। <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />देख, रिबका तोरो आगु हय; येख अपनो संग ले जा, ताकि वा तोरो स्वामी को बेटा की पत्नी होय जाये, जसो की यहोवा न निर्देश दियो हय।” <verse eid="GEN 24:51" /><verse number="52" style="v" sid="GEN 24:52" />उन्की बात सुन क, अब्राहम को सेवक न जमीन पर झुक क यहोवा ख बड़ायी करी। <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />तब सेवक न सोनो अऊर चांदी को जेवर, अऊर कपड़ा निकाल क रिबका ख दियो; ओन रिबका को भाऊ अऊर ओकी माय ख भी बहुत अनमोल चिजे दी।<verse eid="GEN 24:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="GEN 24:54" />तब ओन अऊर ओको संग को लोगों न खायो पीयो अऊर उत रात बितायी। अगलो दिन सुबेरे जब हि सोय क उठ्यो त सेवक न कह्यो, “मोख अपनो स्वामी को जवर वापस जान लायी बिदा करो।”<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />पर रिबका को भाऊ अऊर ओकी माय न कह्यो, “टुरी ख हमरो संग कुछ दिन मतलब कम सी कम दस दिन रहन देवो; तब ओख ले जावो।”<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />पर सेवक न उन्को सी कह्यो, “मोख मत रोको; कहालीकि परमेश्वर न मोरी यो यात्रा ख सफल करयो हय; मोख अपनो स्वामी को जवर वापस जान लायी बिदा करो।”<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />तब उन्न कह्यो, “हम रिबका ख बुलाय क येको बारे म ओको सी पूछबो।” <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />तब उन्न रिबका ख बुलाय क ओको सी पुच्छ्यो, “का तय यो आदमी को संग जाजो?” ओन कह्यो,</para>
  <para style="p" vid="GEN 24:58">“हव, मय जाऊं।”<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />येकोलायी उन्न अपनी बहन रिबका ख ओकी दासी अऊर अब्राहम को सेवक अऊर ओको लोगों को संग बिदा करयो। <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />अऊर उन्न रिबका ख आशीर्वाद दे क कह्यो,</para>
  <para style="q1" vid="GEN 24:60">“हे हमरी बहिन, तय हजारों लाखों की आदिमाता हो,</para>
  <para style="q1" vid="GEN 24:60">अऊर तोरो वंश अपनो दुश्मनों को नगरों पर अधिकार हो।”<verse eid="GEN 24:60" /></para>
  <para style="m">
    <verse number="61" style="v" sid="GEN 24:61" />तब रिबका अपनी सहेलियों समेत चली; अऊर ऊंट पर चढ़ क ऊ आदमी को संग गयी। यो तरह ऊ सेवक रिबका ख संग ले क चल्यो गयो।<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />इसहाक जो कनान को दक्षिन देश म रहत होतो, लहैरोई नाम को कुंवा को जवर सी निर्जन प्रदेश म आवत होतो। <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />शाम को समय ऊ मैदान म ध्यान करन लायी निकल्यो होतो; अऊर ओन आंखी ऊपर उठायी त देख्यो, कि ऊंट चल क आय रह्यो हंय। <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />रिबका न भी आंखी उठाय क इसहाक ख देख्यो, अऊर अपनो ऊंट पर सी उतर पड़ी। <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />तब ओन सेवक सी पुच्छ्यो, “ऊ आदमी कौन आय जो हम सी मुलाखात करन लायी मैदान सी आय रह्यो हय?” सेवक न कह्यो,</para>
  <para style="p" vid="GEN 24:65">“ऊ त मोरो स्वामी आय।” तब रिबका न घूंघट सी अपनो मुंह ख झाक लियो।<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />सेवक न इसहाक सी अपनो संग हुयी घटना को वर्नन करयो। <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />तब इसहाक रिबका ख अपनी माय सारा को तम्बू म लायो, जेको म ओकी माय रहत होती, अऊर ओको संग बिहाव कर क् ओको सी प्रेम करयो। यो तरह इसहाक ख माय को मरन को बाद शान्ति मिली।<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">अब्राहम को दूसरो वंशज</para>
  <para style="r">(<ref loc="1CH 1:32">१ इतिहास 1:32</ref>,<ref loc="1CH 1:33">33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />तब अब्राहम न एक अऊर बाई सी बिहाव करयो जेको नाम कतूरा होतो। <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />ओन जिम्रान, योक्षान, मदना, मिद्यान, यिशबाक, अऊर शूह पैदा भयो। <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />योक्षान सी शबा अऊर ददान पैदा भयो; अऊर ददान को वंश म अश्शूरी, लतूशी, अऊर लुम्मी लोग भयो। <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />मिद्यान को बेटा एपा, एपेर, हनोक, अबीदा, अऊर एल्दा भयो, हि सब कतूरा की सन्तान भयो।<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />इसहाक ख त अब्राहम न अपनो सब कुछ दियो <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />पर अपनी रखेलियों<note caller="+" style="f"><char style="fr" closed="false">25:6 </char><char style="ft" closed="false">हाजिरा अऊर कतुरा</char></note> सी पैदा भयो बेटा ख केवल उपहार दे क अपनो जीतो जी अपनो बेटा इसहाक को जवर सी पूर्व देश म भेज दियो।<verse eid="GEN 25:6" /></para>
  <para style="s">अब्राहम की मृत्यु</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />तब अब्राहम की पूरी उमर एक सौ पचहत्तर साल की भयी <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />अब्राहम की लम्बी उमर म पूरो बुढ़ापा की स्थिति तक जीव छूट गयो; अऊर ऊ अपनो मरयो हुयो पूर्वजों म जाय क मिल्यो। <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />ओको बेटा इसहाक अऊर इश्माएल न, ओख मम्रे की पूर्व दिशा म मकपेला को गुफा म माटी दी, जो हित्ती सोहर को बेटा एप्रोन की जमीन म होती; <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" /><note caller="+" style="x"><char style="xo" closed="false">25:10 </char><char style="xt" closed="false"><ref loc="GEN 23:16">उत्पत्ति 23:16</ref></char></note>या वाच जमीन आय, जेक अब्राहम न हित्तियों सी मोल ले लियो होतो; ओको म अब्राहम, अऊर ओकी पत्नी सारा, दोयी ख माटी दी गयी। <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />अब्राहम को मरन को बाद परमेश्वर न ओको बेटा इसहाक ख आशीष दी, जो लहैरोई नाम को कुंवा को जवर रहत होतो।<verse eid="GEN 25:11" /></para>
  <para style="s">इश्माएल की वंशावली</para>
  <para style="r">(<ref loc="1CH 1:28-31">१ इतिहास १:२८-३१</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />अब्राहम को बेटा इश्माएल जो सारा की मिस्री दासी हाजिरा सी पैदा भयो होतो, ओकी वंशावली यो तरह हय। <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />इश्माएल को बेटावों को नाम यो तरह हय : इश्माएल को बड़ो बेटा नबायोत, फिर केदार, अद्बेल, मिबसाम, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />मिश्मा, दूमा, मस्सा, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />हदद, तेमा, यतूर, नापीश, अऊर केदमा। <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />इश्माएल को बेटा हिच भयो, अऊर इन्कोच नामो को अनुसार इन्को गांवो, अऊर छावनियों को नाम भी पड़्यो; अऊर हिच बारा अपनो अपनो कुल को प्रधान भयो। <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />इश्माएल की पूरी उमर एक सौ सैंतीस साल को हुयो; तब ऊ मर गयो, अऊर ऊ अपनो मरयो हुयो पूर्वजों म जाय क मिल्यो। <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />अऊर ओको वंश हवीला सी शूर तक, जो मिस्र देश को पूर्व म अश्शूर की रस्ता म हंय, बस गयो; अऊर उन्को भाग उन्को सब भाऊ-बन्धुवों को जवर पड़्यो।<verse eid="GEN 25:18" /></para>
  <para style="s">इसहाक को टुरावों की उत्पत्ति को वर्नन</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />अब्राहम को टुरा इसहाक की वंशावली यो आय : अब्राहम सी इसहाक पैदा भयो; <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />अऊर इसहाक न चालीस साल को होय क रिबका सी, जो पद्दनराम को वासी, बतूएल की टुरी अऊर अरामी लाबान की बहिन होती, बिहाव कर लियो। <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />इसहाक की पत्नी रिबका बांझ होती, येकोलायी ओन रिबका लायी परमेश्वर सी बिनती करी; अऊर परमेश्वर न ओकी प्रार्थना सुनी, यो तरह ओकी पत्नी गर्भवती भयी। <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />ओको गर्भ म बच्चा आपस म लिपट क एक दूसरो ख मारन लग्यो। तब रिबका न कह्यो, “मोरी जो असीच दशा रहेंन त मय कसी जीन्दी रहूं?” अऊर वा यहोवा की इच्छा पूछन ख गयी।<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">25:23 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 9:12">रोमियों 9:12</ref>
      </char>
    </note>तब परमेश्वर न रिबका सी कह्यो,</para>
  <para style="q1" vid="GEN 25:23">“तोरो गर्भ म दोय जातियां हंय,</para>
  <para style="q1" vid="GEN 25:23">अऊर तोरी कोख सी निकल क दोय राज्य को लोग अलग अलग होयेंन,</para>
  <para style="q1" vid="GEN 25:23">अऊर एक राज्य को लोग दूसरो सी शक्तिशाली होयेंन,</para>
  <para style="q1" vid="GEN 25:23">अऊर बड़ो बेटा छोटो की सेवा करेंन।”<verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />जब रिबका को जनम देन को समय आयो, तब मालूम भयो कि रिबका को गर्भ म जुड़वा बच्चा हंय। <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />पहिलो जो बच्चा पैदा भयो ऊ लाल निकल्यो, अऊर ओको पूरो शरीर बालों सी भरयो होतो; येकोलायी ओको नाम एसाव रख्यो गयो। <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />तब ओको पीछू ओको भाऊ अपनो हाथ सी एसाव की एड़ी पकड़्यो हुयो पैदा भयो; अऊर ओको नाम याकूब<note caller="+" style="f"><char style="fr" closed="false">25:26 </char><char style="ft" closed="false">अड़ंगा मारन वालो</char></note> रख्यो गयो। जब रिबका न उन्ख जनम दियो तब इसहाक साठ साल को होतो।<verse eid="GEN 25:26" /></para>
  <para style="s">एसाव द्वारा बड़ो टुरा होन को अधिकार बेचनो</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />तब हि टुरा बढ़न लग्यो, अऊर एसाव त जंगल म रहन वालो चतुर शिकारी होय गयो, पर याकूब सीधो आदमी होतो अऊर तम्बुवों म रहत होतो। <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />इसहाक एसाव द्वारा लायो शिकार को मांस खातो रहत होतो, येकोलायी ऊ ओको सी प्रेम रखत होतो; पर रिबका याकूब सी प्रेम रखत होती।<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />एक दिन याकूब जेवन लायी कुछ दार पकात होतो; अऊर एसाव जंगल सी थक्यो हुयो आयो। <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />तब एसाव न याकूब सी कह्यो, “ऊ जो लाल चीज हय, उच लाल चीज म सी मोख कुछ खिल्ला, कहालीकि मय थक्यो हय।” योच वजह ओको नाम एदोम भी पड़्यो।<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />याकूब न कह्यो, “अपनो बड़ो होन को अधिकार अज मोरो हाथ बेच दे।”<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />एसाव न कह्यो, “देख, मय त अभी मरन पर हय : येकोलायी यो अधिकार सी मोरो का भलो होयेंन?”<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />
    <note caller="+" style="x">
      <char style="xo" closed="false">25:33 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:16">इब्रानियों 12:16</ref>
      </char>
    </note>याकूब न कह्यो, “मोरो सी अभी कसम खा,” येकोलायी एसाव न ओको सी कसम खायी,</para>
  <para style="p" vid="GEN 25:33">अऊर अपनो बड़ो होन को अधिकार याकूब को हाथ बेच डाल्यो <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />तब याकूब न एसाव ख रोटी अऊर पकायी हुयी मसूर की दार दी; अऊर ओन खायो पियो, अऊर उठ क चली गयो। यो तरह एसाव न अपनो बड़ो होन को अधिकार ख बेकार जान्यो।<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">इसहाक को गरार नगर म निवास</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />ऊ देश म अकाल पड़्यो, यो ऊ पहिलो अकाल सी अलग होतो जो अब्राहम को दिनों म पड़्यो होतो। येकोलायी इसहाक पलिश्ती जाति को राजा अबीमेलेक को जवर गरार नगर गयो। <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />परमेश्वर न इसहाक ख दर्शन दे क कह्यो, “मिस्र देश मत जा; जो देश को बारे म मय तोरो सी कहूं, ओको म रह्य। <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" /><note caller="+" style="x"><char style="xo" closed="false">26:3 </char><char style="xt" closed="false"><ref loc="GEN 22:16-18">उत्पत्ति 22:16-18</ref></char></note>तय उच देश म रह्य, अऊर मय तोरो संग रहूं, अऊर तोख आशीष देऊं; मय तोख, अऊर तोरो वंश ख यो सब देश प्रदान करूं; जो कसम मय न तोरो बाप अब्राहम सी खायी होती, ओख मय पूरी करूं। <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />अऊर मय तोरो वंश ख आसमान को तारों को जसो करूं; अऊर मय तोरो वंश ख यो सब देश देऊं, अऊर धरती की पूरी जातियां तोरो वंश को वजह अपनो आप ख धन्य मानेंन। <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />कहालीकि अब्राहम न मोरी बात मानी, अऊर जो मय न ओख सौंप्यो होतो ओख अऊर मोरी आज्ञावों, विधियों अऊर व्यवस्था को पालन करयो।”<verse eid="GEN 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 26:6" />येकोलायी इसहाक गरार नगर म रह्य गयो। <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" /><note caller="+" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="GEN 12:13">उत्पत्ति 12:13</ref>; <ref loc="GEN 20:2">20:2</ref></char></note>जब ऊ जागा को लोगों न ओकी पत्नी रिबका को बारे म पुच्छ्यो, तब इसहाक न यो सोच क कि यदि मय ओख अपनी पत्नी कहूं, त इत को लोग रिबका को वजह जो बहुत सुन्दर हय, मोख मार डालेंन, इसहाक न उत्तर दियो, “वा त मोरी बहिन आय।” <verse eid="GEN 26:7" /><verse number="8" style="v" sid="GEN 26:8" />जब इसहाक ख उत रह्यतो हुयो बहुत समय बीत गयो, तब एक दिन पलिश्तियों को राजा अबीमेलेक न खिड़की म सी झांक क देख्यो कि इसहाक अपनी पत्नी रिबका को संग प्रेम कर रह्यो हय। <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />तब अबीमेलेक न इसहाक ख बुलाय क कह्यो, “वा बाई त निश्चय तोरी पत्नी हय; तब तय न कहाली ओख अपनी बहिन कह्यो?”</para>
  <para style="p" vid="GEN 26:9">तब इसहाक न उत्तर दियो, “मय न सोच्यो होतो, कि असो नहीं हो कि मोख ओको वजह अपनी जान खोनो पड़े।”<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />अबीमेलेक न कह्यो, “तय न हमरो सी यो का करयो? असो त मोरी प्रजा को कोयी भी आदमी तोरी पत्नी को संग सोय सकत होतो, अऊर तय हम्ख पाप म फसातो।” <verse eid="GEN 26:10" /><verse number="11" style="v" sid="GEN 26:11" />येकोलायी अबीमेलेक न अपनी पूरी प्रजा ख आज्ञा दी, “जो कोयी ऊ आदमी ख यां वा बाई ख छुयेंन, ऊ निश्चय मार दियो जायेंन।”<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />तब इसहाक न ऊ देश म जमीन पर अनाज बोयो, अऊर उच साल म सौ गुना फसल हासिल करी; अऊर परमेश्वर न ओख आशीष दी। <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />अऊर ऊ धनी भय गयो, ओकी उन्नति होती गयी, अऊर ऊ बहुत धनवान आदमी भय गयो। <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />जब ओको शेरी-मेंढी, गाय-बईल, अऊर दास-दासियां भयी, तब पलिश्ती ओको सी जलन करन लग्यो। <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />जिन कुंवा ख इसहाक को बाप अब्राहम को दासों न अब्राहम को जीतो जी खोद्यो होतो, उन्ख पलिश्ती जाति को लोग न माटी सी बुझाय क बन्द कर दियो।<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />तब अबीमेलेक न इसहाक सी कह्यो, “हमरो जवर सी चली जा; कहालीकि तय हमरो सी बहुत सामर्थी भय गयो हय।” <verse eid="GEN 26:16" /><verse number="17" style="v" sid="GEN 26:17" />येकोलायी इसहाक उत सी चली गयो, अऊर गरार नगर की घाटी म अपनो तम्बू खड़ो कर क् रहन लग्यो। <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />तब जो कुंवा ओको बाप अब्राहम को दिनों म खोद्यो गयो होतो, अऊर अब्राहम को मरन को बाद पलिश्तियों न कुंवा ख बुझाय दियो होतो, तब इसहाक न हि कुंवा ख फिर सी खुदवायो; अऊर उन्को उच नाम रख्यो, जो ओको बाप न रख्यो होतो।<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />तब इसहाक को दासों जो घाटी म कुंवा खोदतो खोदतो एक झरना मिल्यो। <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />तब गरार को चरवाहों न इसहाक को चरवाहों सी झगड़ा करयो, अऊर कह्यो, “यो पानी हमरो आय।” येकोलायी इसहाक न ऊ कुंवा को नाम एसेक रख्यो; कहालीकि हि इसहाक सी झगड़ा करत होतो।<verse eid="GEN 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 26:21" />तब इसहाक को दासों न दूसरो कुंवा खोद्यो; अऊर उन्न ओको लायी भी झगड़ा करयो, येकोलायी इसहाक न उन्ख सित्ना<note caller="+" style="f"><char style="fr" closed="false">26:21 </char><char style="ft" closed="false">विरोध</char></note> को नाम दियो। <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />तब इसहाक न उत सी निकल क एक अऊर कुंवा खुदवायो; अऊर ओको लायी उन्न झगड़ा नहीं करयो; येकोलायी इसहाक न ओको नाम यो कह्य क स्वतंत्रता<note caller="+" style="f"><char style="fr" closed="false">26:22 </char><char style="ft" closed="false">रहोबोत</char></note> रख्यो। इसहाक न कह्यो, “अब त परमेश्वर न हमरो लायी बहुत जागा दियो हय, अऊर हम यो देश म सफल होयबो।”<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />उत सी ऊ बेर्शेबा ख गयो। <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />अऊर उच दिन परमेश्वर न रात ख ओख दर्शन दे क कह्यो, “मय तोरो बाप अब्राहम को परमेश्वर आय; मत डर, कहालीकि मय तोरो संग हय, अऊर अपनो दास अब्राहम को वजह तोख आशीष देऊं, अऊर तोरो वंश बढ़ाऊं।” <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />तब इसहाक न वहां एक वेदी बनायी, अऊर परमेश्वर सी आराधना करी, अऊर अपनो तम्बू वहांच खड़ो करयो; अऊर वहां इसहाक को दासों न एक कुंवा खोद्यो।<verse eid="GEN 26:25" /></para>
  <para style="s">अबीमेलेक को संग वादा</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">26:26 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 21:22">उत्पत्ति 21:22</ref>
      </char>
    </note>तब अबीमेलेक अपनो सलाहकार अहुज्जत, अऊर सेनापति पीकोल ख संग ले क, गरार नगर सी इसहाक को जवर गयो। <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />इसहाक न उन्को सी कह्यो, “तुम न मोरो सी दुश्मनी कर क् अपनो बीच सी निकाल दियो होतो, अब मोरो जवर कहाली आयो हय?”<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />उन्न कह्यो, “हम्न त साफ देख्यो हय, कि यहोवा तोरो संग रह्य हय; येकोलायी हम्न सोच्यो, कि तय त यहोवा को तरफ सी धन्य हय, येकोलायी हमरो अऊर तोरो बीच म कसम खायी जाये, अऊर हम तोरो सी यो चाहजे हय कि तय वादा करे; <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />कि जसो हम्न तोख नहीं छूयो, अऊर तोरो संग केवल भलायीच करी हय, अऊर तोख शान्ति सी बिदा करयो, ओको अनुसार तय भी हम सी कोयी बुरो व्यवहार मत करजो अब तुम परमेश्वर की आशीष पायो हुयो आदमी हय।” <verse eid="GEN 26:29" /><verse number="30" style="v" sid="GEN 26:30" />तब इसहाक न उन्को लायी विशेष भोजन तैयार करयो, अऊर उन्न खायो पियो। <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />तब हि भुन्सारे जल्दी उठ क आपस म कसम खायी; तब इसहाक न उन्ख बिदा करयो, अऊर हि खुशी सी ओको जवर सी चली गयो।<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />उच दिन इसहाक को दासों न आय क अपनो ऊ खोद्यो हुयो कुंवा को बारे म इसहाक ख बतायो, “हम्ख पानी को एक सोता मिल गयो हय।” <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />तब इसहाक न कुंवा को नाम शिबा<note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="ft" closed="false">कसम</char></note> रख्यो; योच वजह अज तक ऊ नगर को नाम बेर्शेबा<note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="ft" closed="false">कसम को कुंवा</char></note> पड़्यो हय।<verse eid="GEN 26:33" /></para>
  <para style="s">एसाव की विदेशी पत्नियां</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />जब एसाव चालीस साल को भयो, तब ओन हित्ती जाति की दोय टुरियों सी बिहाव करयो, यहूदीत अऊर बासमत, यहूदीत को बाप को नाम बेरी अऊर बासमत को बाप को नाम एलोन होतो; <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />अऊर उन्को वजह इसहाक अऊर रिबका को मन ख ठेस पहुंची।<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">इसहाक द्वारा याकूब ख आशीर्वाद देनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />जब इसहाक बूढ्ढा भय गयो, अऊर ओकी आंखी असी धुंधली पड़ गयी कि ऊ देख नहीं सकत होतो, तब ओन अपनो बड़ो बेटा एसाव ख बुलाय क कह्यो, “हे मोरो बेटा!”</para>
  <para style="p" vid="GEN 27:1">“एसाव न उत्तर दियो, का बात हय।”<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />इसहाक न कह्यो, “सुन, मय त बूढ्ढा भय गयो हय, अऊर मय नहीं जानु हय कि मोरो मरन को दिन कब आयेंन <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />येकोलायी अब तय अपनो धनुष बान ले क जंगल म जा, अऊर मोरो लायी शिकार कर क् लाव <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />ओको बाद तय मोरी इच्छा को अनुसार स्वादिष्ट खाना बनाय क मोरो जवर ले आजो, कि मय ओख खाय क मरन सी पहिले तोख जी भर क आशीर्वाद देऊं।”<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />तब एसाव शिकार करन ख जंगल म गयो। जब इसहाक एसाव सी यो बात कह्य रह्यो होतो, तब रिबका भी सुन रही होती। <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />येकोलायी रिबका न अपनो बेटा याकूब सी कह्यो, “सुन, मय न तोरो बाप ख तोरो भाऊ एसाव सी यो कहतो सुन्यो हय, <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />‘तय मोरो लायी शिकार कर क् ओको स्वादिष्ट खाना बनाव, कि मय ओख खाय क तोख परमेश्वर को आगु मरन सी पहिले आशीर्वाद देऊं।’ <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />येकोलायी अब, रिबका न कह्यो हे मोरो बेटा, मोरी सुन, जसी मय तोरो सी कहू हय, वसोच कर, <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />तय शेरियों को जवर जाय क शेरी को दोय अच्छो अच्छो बच्चा ले आव; अऊर मय तोरो बाप लायी ओकी इच्छा को अनुसार उन्को मांस को स्वादिष्ट खाना बनाऊं। <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />तब तय ओख अपनो बाप को जवर ले जाजो, कि ऊ ओख खाय क मरन सी पहिले तोख आशीर्वाद दे।”<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />याकूब न अपनी माय रिबका सी कह्यो, “सुन, मोरो भाऊ एसाव को शरीर म बहुत बाल हय, लेकिन मोरो शरीर म नहाय। <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />कभी मोरो बाप मोख छुयेंन, तब मय ओकी नजर म धोका देन वालो ठहरूं; अऊर आशीष को बदला अपनो ऊपर श्राप लाऊं।”<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />ओकी माय न ओको सी कह्यो, “हे मोरो बेटा, श्राप तोरो पर नहीं मोरोच पर आयेंन, तय केवल मोरी सुन, अऊर जाय क शेरी को बच्चां मोरो जवर ले आव।” <verse eid="GEN 27:13" /><verse number="14" style="v" sid="GEN 27:14" />तब याकूब जाय क शेरी को बच्चां अपनी माय को जवर ले आयो, अऊर ओकी माय न ओको बाप की इच्छा को अनुसार स्वादिष्ट खाना बनाय दियो। <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />तब रिबका न अपनो बड़ो बेटा एसाव को सब सी अच्छो कपड़ा, जो ओको जवर घर म होतो, उन्ख ले क अपनो छोटो बेटा याकूब ख पहिनाय दियो; <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />अऊर ओन शेरियों को बच्चा को चमड़ा ख ओको हाथों पर अऊर गर्दन पर लपेट दियो। <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />अऊर ऊ स्वादिष्ट खाना अऊर अपनी बनायी हुयी रोटी भी अपनो बेटा याकूब को हाथ म दे दी।<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />तब याकूब अपनो बाप को जवर गयो, अऊर कह्यो, “हे मोरो बाप,”</para>
  <para style="p" vid="GEN 27:18">इसहाक न कह्यो, “का बात हय? मोरो बेटा, तय कौन आय?”<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />याकूब न अपनो बाप सी कह्यो, “मय तोरो बड़ो बेटा एसाव आय। मय न तोरी आज्ञा को अनुसार करयो हय; येकोलायी उठ अऊर बैठ क मोरो शिकार को मांस म सी खा ले, ताकि तय मोख दिल सी आशीर्वाद दे सके।”<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />इसहाक न अपनो बेटा सी कह्यो, “हे मोरो बेटा, का वजह हय कि शिकार तोख इतनो जल्दी मिल गयो?”</para>
  <para style="p" vid="GEN 27:20">याकूब न यो उत्तर दियो, “तोरो परमेश्वर यहोवा न ओख मोरो आगु कर दियो होतो।”<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />तब इसहाक न याकूब सी कह्यो, “हे मोरो बेटा, जवर आव, मय तोख छुय क जान सकू कि तय सचमुच मोरो बेटा एसाव आय का नहीं।” <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />तब याकूब अपनो बाप इसहाक को जवर गयो, अऊर इसहाक न ओख छुय क कह्यो, “तोरी आवाज त याकूब को जसी हय, पर तोरो हाथ त एसाव को हाथ जसो लगय हंय।” <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />यो तरह इसहाक न ओख नहीं पहिचान्यो, कहालीकि ओको हाथ ओको भाऊ एसाव को जसो बाल वालो होतो; येकोलायी इसहाक न ओख आशीर्वाद दियो। <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />अऊर इसहाक न पुच्छ्यो, “का तय सचमुच मोरो बेटा एसाव आय?” याकूब न कह्यो,</para>
  <para style="p" vid="GEN 27:24">“हव, मय आय।”<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />तब इसहाक न कह्यो, “खाना ख मोरो जवर ले आव, कि मय अपनो बेटा को शिकार को मांस म सी खाय क, तोख दिल सी आशीर्वाद देऊ।” तब याकूब न अपनो बाप को जवर खाना लायो, अऊर ओन खायो; अऊर ऊ अंगूरीरस रस भी लायो, अऊर ओन पियो। <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />तब ओको बाप इसहाक न ओको सी कह्यो, “हे मोरो बेटा, जवर आय क मोख चुम्मा दे।” <verse eid="GEN 27:26" /><verse number="27" style="v" sid="GEN 27:27" />ओन जवर जाय क इसहाक ख चुम्मा दियो; अऊर इसहाक न ओको कपड़ा की सुगन्ध सूंघ क ओख यो आशीर्वाद दियो, “देख, मोरो बेटा की सुगन्ध ऊ खेत को जसो हय जेक परमेश्वर न आशीर्वाद दियो हय; <verse eid="GEN 27:27" /><verse number="28" style="v" sid="GEN 27:28" />परमेश्वर तोख आसमान सी ओस, अऊर जमीन की अच्छी सी अच्छी उपज, अऊर बहुत सो अनाज अऊर नयो अंगूरीरस रस देन। <verse eid="GEN 27:28" /><verse number="29" style="v" sid="GEN 27:29" /><note caller="+" style="x"><char style="xo" closed="false">27:29 </char><char style="xt" closed="false"><ref loc="GEN 12:3">उत्पत्ति 12:3</ref></char></note>राज्य राज्य को लोग तोरी सेवा करेंन, अऊर हर एक जाती को लोग तोरो आगु झुकेंन। तय अपनो रिश्तेदारों को ऊपर शासन कर सकय हय, अऊर तोरी माय को बेटा तोरो आगु झुकेंन। जो तोख श्राप देन ऊ खुदच श्रापित होयेंन, अऊर जो तोख आशीर्वाद देन ऊ खुद आशीष पायेंन।”<verse eid="GEN 27:29" /></para>
  <para style="s">आशीर्वाद लायी एसाव को अनुरोध</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />जसोच इसहाक न याकूब ख आशीर्वाद देनो खतम करयो, अऊर जसोच याकूब अपनो बाप इसहाक को जवर सी बाहेर निकल्यो, कि ओको भाऊ एसाव शिकार ले क आयो। <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />तब एसाव भी स्वादिष्ट खाना बनाय क अपनो बाप को जवर ले आयो, अऊर ओन कह्यो, “हे मोरो बाप, उठ क अपनो बेटा को शिकार को मांस खा, ताकि तय मोख दिल सी आशीर्वाद दे।”<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />ओको बाप इसहाक न पुच्छ्यो, “तय कौन आय?”</para>
  <para style="p" vid="GEN 27:32">एसाव न कह्यो, “मय तोरो बड़ो बेटा एसाव आय।”<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />तब इसहाक पूरो तरह सी थरथर कांपन लग्यो, अऊर ओन पुच्छ्यो, “ऊ कौन होतो जो शिकार कर क् मोरो जवर ले आयो होतो, अऊर मय न तोरो आवन सी पहिले सब म सी कुछ कुछ खाय लियो अऊर ओख आशीर्वाद दियो? अब उच आशीर्वाद हमेशा ओको पर बन्यो रहेंन।”<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />जब एसाव न अपनो बाप इसहाक की यो बाते सुनी, तब ऊ जोर सी चिल्लायो अऊर फूट फूट क रोवन लग्यो अऊर अपनो बाप सी कह्यो, “हे मोरो बाप, मोख भी अपनो आशीर्वाद दे!”<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />इसहाक न उत्तर दियो, “तोरो भाऊ आयो अऊर मोख धोका दियो, अऊर ऊ तोरो आशीर्वाद छीन क चली गयो।”<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />एसाव न कह्यो, “ओको नाम याकूब ठीकच रख्यो गयो होतो। ओन मोख दोय बार धोका दियो हय। पहिले त ओन मोरो बड़ो बेटा होन को अधिकार ले लियो; अऊर अब मोरो आशीर्वाद भी छीन लियो हय।” तब एसाव न कह्यो, “का तय न मोरो लायी कोयी आशीर्वाद नहीं बचाय क रख्यो?”<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />इसहाक न एसाव ख उत्तर दे क कह्यो, “सुन, मय न ओख तोरो स्वामी बनाय दियो हय, अऊर ओको सब रिश्तेदारों ख ओको दास बनाय क ओख सौंप दियो हय, अऊर मय न अनाज अऊर अंगूर को रस दे क ओख भरपूर आशीष दियो हय। येकोलायी अब, हे मोरो बेटा, मय तोरो लायी का करूं?”<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />
    <note caller="+" style="x">
      <char style="xo" closed="false">27:38 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:17">इब्रानियों १२:१७</ref>
      </char>
    </note>एसाव न अपनो बाप सी कह्यो, “हे मोरो बाप, का तोरो मन म केवल एकच आशीर्वाद हय? हे मोरो बाप, मोख भी आशीर्वाद दे।” यो कह्य क एसाव फूट फूट क रोवन लग्यो।<verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />तब ओको बाप इसहाक न ओको सी कह्यो,</para>
  <para style="q1" vid="GEN 27:39">“सुन, तोरो निवास उपजाऊ जमीन सी दूर हो,</para>
  <para style="q1" vid="GEN 27:39">अऊर ऊपर सी आसमान की ओस ओको पर नहीं पड़े।<verse eid="GEN 27:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="GEN 27:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">27:40 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 36:8">उत्पत्ति 36:8</ref>; <ref loc="2KI 8:20">२ राजा 8:20</ref></char>
    </note>तय अपनी तलवार को दम सी जीन्दो रह्यजो,</para>
  <para style="q1" vid="GEN 27:40">अऊर तय अपनो भाऊ को दास त बनजो; पर जब तय आजादी लायी लड़जो,</para>
  <para style="q1" vid="GEN 27:40">तब तय अपनो ऊपर पड़्यो ओको</para>
  <para style="q1" vid="GEN 27:40">गुलामी को जूआ ख तोड़ फेकजो।”<verse eid="GEN 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />एसाव याकूब सी नफरत करत होतो, कहालीकि ओको बाप न याकूब ख आशीर्वाद दियो होतो; अऊर एसाव न सोच्यो, “मोरो बाप की मृत्यु को शोक मनान को दिन जवर हय, तब मय अपनो भाऊ याकूब ख मार डालूं।”<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />जब रिबका ख ओको बड़ो बेटा एसाव की यो बात बतायी गयी, तब ओन अपनो छोटो बेटा याकूब ख बुलाय क कह्यो, “सुन, तोरो भाऊ एसाव तोख मारन लायी अपनो मन म धीरज रख्यो हुयो हय। <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />येकोलायी अब, हे मोरो बेटा, मोरी सुन, अऊर हारान नगर ख मोरो भाऊ लाबान को जवर भग जा; <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />अऊर थोड़ो दिन तक, यानेकि जब तक तोरो भाऊ को गुस्सा शान्त नहीं होय जाय, तब तक ओकोच जवर रह्यजो। <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />फिर जब तोरो भाऊ को गुस्सा तोरो पर सी शान्त होय जायेंन, अऊर जो काम तय न ओको संग करयो हय ओख ऊ भूल जायेंन; तब मय दास भेज क तोख वहां सी बुलाय लेऊं। तब असो कहाली हो कि एकच दिन म मोख तुम दोयी बेटावों सी वंचित होनो पड़े?”<verse eid="GEN 27:45" /></para>
  <para style="s">याकूब को लाबान को जवर जानो</para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />तब रिबका न इसहाक सी कह्यो, “मय हित्ति जाति की बहुवों को वजह अपनो जीव सी ऊब गयी हय; यदि याकूब भी इन बहुवों को जसो यो देश की कोयी हित्ती जाति की टुरी सी बिहाव कर लेन, त मोख अपनो जीव सी का लाभ मय मर जाऊं?”<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />तब इसहाक न याकूब ख बुलाय क आशीर्वाद दियो, अऊर आज्ञा दी, “तय कोयी कनानी टुरी सी बिहाव मत कर लेजो। <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />उठ अऊर पद्दनराम<note caller="+" style="f"><char style="fr" closed="false">28:2 </char><char style="ft" closed="false">मेशोपोटामियां</char></note> म अपनो नाना बतूएल को घर जाय क, वहां अपनो मामा लाबान की एक टुरी सी बिहाव कर लेजो। <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />सर्वशक्तिमान परमेश्वर तोख आशीष दे, अऊर तोख कुछ बच्चा दे क बढ़ाये, ताकि तय कुछ राष्ट्रों को बाप बन जाये। <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" /><note caller="+" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="GEN 17:4-8">उत्पत्ति 17:4-8</ref></char></note>ऊ तोख अऊर तोरो वंश ख भी अब्राहम की जसी आशीष दे, कि तय यो देश जेको म तय परदेशी होय क रह्य हय, अऊर जेक परमेश्वर न अब्राहम ख दियो होतो, ओको अधिकार होय जाये।” <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />यो तरह इसहाक न याकूब ख बिदा करयो, अऊर ऊ पद्दनराम ख अरामी बतूएल को बेटा लाबान को जवर चली गयो, जो याकूब अऊर एसाव की माय रिबका को भाऊ होतो।<verse eid="GEN 28:5" /></para>
  <para style="s">एसाव को एक अऊर बिहाव करनो</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />जब एसाव ख पता चल्यो कि इसहाक न याकूब ख आशीर्वाद दे क पद्दनराम क्षेत्र भेज दियो, कि ऊ वहां सी पत्नी लाये, अऊर ओख आशीर्वाद देन को समय यो आज्ञा भी दी, “तय कोयी कनानी टुरी सी बिहाव मत कर लेजो,” <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />अऊर याकूब अपनो माय बाप की आज्ञा मान क पद्दनराम ख चली गयो। <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />तब एसाव यो सब देख क् अऊर यो भी सोच क कि कनानी टुरियां मोरो बाप इसहाक ख बुरी लगय हंय, <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />येकोलायी ऊ अब्राहम को बेटा इश्माएल को जवर गयो, अऊर एश्माएल की टुरी महलत ख, जो नबायोत की बहिन होती, ओको सी बिहाव कर क् अपनी पत्नियों म मिलाय लियो।<verse eid="GEN 28:9" /></para>
  <para style="s">बेतेल म याकूब को सपनो</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />याकूब बेर्शेबा सी निकल क हारान नगर को तरफ चल्यो। <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />अऊर ओन कोयी एक जागा म पहुंच क रात उतच बितावन को बिचार करयो, कहालीकि सूरज डुब गयो होतो; येकोलायी ओन ऊ जागा म गिरयो गोटा म सी एक गोटा ले क ओख अपनी मुंड को खल्लो रख्यो, अऊर ऊ उच जागा पर सोय गयो। <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" /><note caller="+" style="x"><char style="xo" closed="false">28:12 </char><char style="xt" closed="false"><ref loc="JHN 1:51">यूहन्ना 1:51</ref></char></note>तब याकूब न सपनो म देख्यो, कि एक सीढ़ी धरती पर खड़ी हय, अऊर ओको सिरा स्वर्ग तक पहुंच्यो हय; अऊर परमेश्वर को दूत ओको पर सी चढ़य अऊर उतरय हंय। <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" /><note caller="+" style="x"><char style="xo" closed="false">28:13 </char><char style="xt" closed="false"><ref loc="GEN 13:14">उत्पत्ति 13:14</ref>,<ref loc="GEN 13:15">15</ref></char></note>अऊर यहोवा ओको ऊपर खड़ो होय क कह्य हय, “मय यहोवा, तोरो दादा अब्राहम को परमेश्वर, अऊर इसहाक को भी परमेश्वर आय; जो जमीन पर तय सोयो हय, ओख मय तोख अऊर तोरो वंश ख देऊं। <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" /><note caller="+" style="x"><char style="xo" closed="false">28:14 </char><char style="xt" closed="false"><ref loc="GEN 12:3">उत्पत्ति 12:3</ref>; <ref loc="GEN 22:18">22:18</ref></char></note>अऊर तोरो वंश जमीन की धूल को कन को जसो बहुत सारो होयेंन, अऊर पश्चिम, पूर्व, उत्तर, दक्षिन, चारयी तरफ फैलतो जायेंन : अऊर तोरो अऊर तोरो वंश को द्वारा धरती को पूरो वंशज आशीष पायेंन। <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" /><note caller="+" style="x"><char style="xo" closed="false">28:15 </char><char style="xt" closed="false"><ref loc="ISA 31:9">यशायाह 31:9</ref></char></note>अऊर सुन, मय तोरो संग रहूं, अऊर जित कहीं तय जाजो उत तोरी रक्षा करूं, अऊर तोख यो देश म वापस ले आऊं: जो बात मय न तोरो सी कहीं हंय, जब तक उन्ख पूरी नहीं कर लेऊं तब तक तोख नहीं छोडूं।”<verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />तब याकूब नींद सी जग गयो, अऊर कहन लग्यो, “निश्चय यो जागा म यहोवा हय; अऊर मय यो बात ख नहीं जानत होतो।” <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />अऊर ओन डर को मारे कह्यो, “या जागा कितनी भयानक हय! यो त परमेश्वर को भवन को अलावा अऊर कुछ नहीं होय सकय; नहीं त यो स्वर्ग म खुलन वालो फाटकच होना।”<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />सुबेरे याकूब उठ्यो, अऊर ओन अपनो मुंड को खल्लो रख्यो हुयो गोटा ख उठायो, अऊर ओख खम्बा को जसो खड़ो करयो, अऊर ओको बाद ओकी मुंड पर तेल डाल दियो। <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />अऊर ओन ऊ जागा को नाम बेतेल<note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="ft" closed="false">परमेश्वर को भवन</char></note> रख्यो; पर ऊ नगर को नाम पहिले लूज होतो। <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />तब याकूब न परमेश्वर सी एक कसम मांगी, “यदि तय मोरो संग रह्य क यो यात्रा म मोरी रक्षा करजो, अऊर मोख खान लायी रोटी, अऊर पहिन न लायी कपड़ा दे, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />कि मय अपनो बाप को घर म अच्छी तरह सी लौट आऊं; त तय यहोवा च मोरो परमेश्वर होयजो। <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />खम्भा अऊर यो गोटा जेको मय न खम्बा खड़ो करयो हय, यो परमेश्वर को भवन बनेंन, अऊर जो कुछ तय मोख देजो ओकोच दसवा हिस्सा मय जरूरच तोख दियो करूं।”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">याकूब की लाबान सी भेंट</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />याकूब न अपनी रस्ता पकड़ी, अऊर पूर्व को निवासियों को देश म आयो। <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />ओन नजर कर क् देख्यो कि मैदान म एक कुंवा हय, अऊर ओको जवर शेरी मेंढियों को तीन झुण्ड बैठ्यो हुयो हंय; कहालीकि जो गोटा ऊ कुंवा को ऊपर रहत होतो, जेको म सी झुण्डों ख पानी पिलायो जात होतो, ऊ भारी होतो। <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />अऊर जब सब झुण्ड वहां जमा होय जावय तब चरावन वालो ऊ गोटा ख कुंवा को ऊपर सी गंडलाय क शेरी मेंढियों ख पानी पिलात होतो, अऊर फिर गोटा ख कुंवा को ऊपर जसो को वसो रख देत होतो।<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />तब याकूब न चरावन वालो सी पुच्छ्यो, “हे मोरो भाऊवों, तुम कित सी आयो हय?” उन्न कह्यो,</para>
  <para style="p" vid="GEN 29:4">“हम हारान नगर सी आयो हंय।”<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />तब याकूब न उन्को सी पुच्छ्यो, “का तुम नाहोर को नाती लाबान ख जानय हय?” उन्न कह्यो,</para>
  <para style="p" vid="GEN 29:5">“हव, हम ओख जानजे हंय।”<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />तब ओन उन्को सी पुच्छ्यो, “का ऊ खुश हय?” उन्न कह्यो,</para>
  <para style="p" vid="GEN 29:6">“हव, ऊ खुश हय अऊर तब, ओकी बेटी राहेल शेरी मेंढियों ख धर क चली आवय हय।”<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />याकूब न कह्यो, “देखो, अभी त दिन बहुत हय, जनावरों को जमा होन को समय नहीं आयो हय; येकोलायी शेरी मेंढियों ख पानी पिलाय क फिर सी लिजाय क चरावों।”<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />उन्न कह्यो, “हम अभी असो नहीं कर सकजे; जब सब झुण्ड जमा होवय हंय तब गोटा कुंवा को ऊपर सी गंडलायो जावय हय, अऊर तब हम शेरी मेंढियों ख पानी पिलाजे हंय।”<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />उन्की यो बात चीत होतच रह्य कि राहेल, जो जनावर चरायो करत होती, अपनो बाप की शेरी मेंढियों ख धर क आय गयी। <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />याकूब न अपनो मामा अऊर लाबान की बेटी राहेल ख, अऊर ओकी शेरी मेंढियों ख देख्यो त जवर जाय क कुंवा को ऊपर सी गोटा ख गंडलायो अऊर अपनो मामा लाबान की शेरी मेंढियों ख पानी पिलायो। <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />तब याकूब न राहेल को चुम्यो, अऊर जोर जोर सी रोयो। <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />अऊर याकूब न राहेल ख बताय दियो, कि मय तोरो फुफ भाऊ आय, मतलब रिबका को टुरा आय।</para>
  <para style="p" vid="GEN 29:12">तब राहेल दौड़ क अपनो बाप सी कह्य दियो। <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />अपनो भास्या याकूब को समाचार पातोच लाबान ओको सी मिलन ख दौड़्यो, अऊर ओख गलो लगाय क चुम्यो, तब अपनो घर ले आयो। याकूब न लाबान ख अपनो सब लेखा सुनायो। <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />तब लाबान न याकूब सी कह्यो, “तय त सचमुच मोरी हड्डी अऊर मांस हय।” अऊर याकूब एक महीना भर ओको संग रह्यो।<verse eid="GEN 29:14" /></para>
  <para style="s">याकूब को राहेल अऊर लिआ लायी सेवा करनो</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />तब लाबान न याकूब सी कह्यो, “कुटुम्बी होन को वजह तोरो सी फुकट म सेवा करवानो मोरो लायी उचित नहाय; येकोलायी मोख बताव कि मय तोख सेवा को बदला म का देऊं?” <verse eid="GEN 29:15" /><verse number="16" style="v" sid="GEN 29:16" />लाबान की दोय बेटियां होती, जिन्म सी बड़ी को नाम लिआ अऊर छोटी को राहेल होतो। <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />लिआ की आंखी धुन्धरी होती, पर राहेल बहुत अच्छी अऊर सुन्दर होती।<verse eid="GEN 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 29:18" />येकोलायी याकूब न, जो राहेल सी प्रेम करत होतो, ओन कह्यो, “मय तोरी छोटी बेटी राहेल लायी सात साल तोरी सेवा करूं।”<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />लाबान न कह्यो, “ओख परायो आदमी ख देन सी अच्छो तोख देनो अच्छो होयेंन; येकोलायी मोरो जवर रह्य।” <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />तब याकूब न राहेल लायी सात साल सेवा करी; अऊर हि ओख राहेल को प्रेम को वजह थोड़ोच दिनों को बराबर जान पड़्यो।<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />तब याकूब न लाबान सी कह्यो, “मोरी पत्नी मोख दे, अऊर मय ओको जवर जाऊं, कहालीकि मोरो समय पूरो भय गयो हय।” <verse eid="GEN 29:21" /><verse number="22" style="v" sid="GEN 29:22" />तब लाबान न ऊ जागा को सब आदमियों ख बुलाय क जमा करयो, अऊर बिहाव को खाना दियो। <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />शाम को समय ऊ अपनी बेटी लिआ ख याकूब को जवर ले गयो, अऊर याकूब ओको जवर गयो। <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />लाबान न अपनी बेटी लिआ ख अपनी दासी जिल्पा दी कि वा ओकी सेवा करे। <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />सुबेरे ख मालूम भयो कि या त लिआ आय, येकोलायी ओन लाबान सी कह्यो, “यो तय न मोरो संग का करयो हय? मय न तोरो संग रह्य क जो तोरी सेवा करी, त का राहेल लायी नहीं करी? फिर तय न मोरो सी असो कहाली धोखा करयो हय?”<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />लाबान न कह्यो, “हमरो यहां असी रीति नहाय कि बड़ी बेटी सी पहिले दूसरी को बिहाव कर दे। <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />येको हप्ता त पूरो कर; तब दूसरी भी तोख ऊ सेवा लायी मिलेंन जो तय मोरो संग रह्य क अऊर सात साल तक करजो।”<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />याकूब न असोच करयो, अऊर लिआ को हप्ता ख पूरो करयो; तब लाबान न ओख अपनी बेटी राहेल भी दी कि वा ओकी पत्नी हो। <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />लाबान न अपनी बेटी राहेल की दासी होन लायी अपनी दासी बिल्हा ख दियो। <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />तब याकूब राहेल को जवर भी गयो, पर ओन लिआ सी जादा राहेल सी प्रेम करयो; ओन सात साल अऊर लाबान की सेवा करी।<verse eid="GEN 29:30" /></para>
  <para style="s">याकूब की सन्तान</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />जब यहोवा न देख्यो, कि लिआ सी नफरत करी जावय हय, तब ओन ओख गर्भवती बनायो, पर राहेल बांझ रही। <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />तब लिआ गर्भवती भयी अऊर ओको एक टुरा पैदा भयो, अऊर ओन यो कह्य क ओको नाम रूबेन रख्यो, “यहोवा न मोरो दु:ख पर नजर करी हय, अब मोरो पति मोरो सी प्रेम रखेंन।” <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />तब वा गर्भवती भयी अऊर ओको एक टुरा पैदा भयो; तब ओन यो कह्यो, “यो सुन क कि मोरो सी नफरत करी गयी हय, यहोवा न मोख यो टुरा भी दियो।” येकोलायी ओन ओको नाम शिमोन<note caller="+" style="f"><char style="fr" closed="false">29:33 </char><char style="ft" closed="false">सुनन वालो</char></note> रख्यो। <verse eid="GEN 29:33" /><verse number="34" style="v" sid="GEN 29:34" />तब वा गर्भवती भयी अऊर ओको एक टुरा पैदा भयो; अऊर ओन कह्यो, “अब त मोरो पति मोरो सी मिल जायेंन, कहालीकि ओको सी मोरो तीन टुरा पैदा भयो।” येकोलायी ओको नाम लेवी रख्यो गयो। <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />अऊर तब वा गर्भवती भयी अऊर ओको एक अऊर टुरा पैदा भयो; अऊर ओन कह्यो, “अब त मय यहोवा को धन्यवाद करूं।” येकोलायी ओन ओको नाम यहूदा रख्यो; तब ओकी कोख बन्द होय गयी।<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />जब राहेल न देख्यो कि याकूब लायी मोरो सी कोयी सन्तान नहीं होवय, तब वा अपनी बहिन सी नफरत करन लगी अऊर याकूब सी कह्यो, “मोख भी सन्तान दे, नहीं त मर जाऊं।”<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />तब याकूब न राहेल सी जलन सी कह्यो, “का मय परमेश्वर आय? तोरी कोख त ओनच बन्द कर रखी हय।”<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />राहेल न कह्यो, “देखो, मोरी दासी बिल्हा हय; ओकोच जवर जा, ताकि वा मोरो लायी बच्चा पैदा कर सके, अऊर ओको द्वारा मोरो भी घर बसेंन।” <verse eid="GEN 30:3" /><verse number="4" style="v" sid="GEN 30:4" />तब राहेल न अपनी दासी याकूब ख दी कि वा ओकी पत्नी हो; अऊर याकूब ओको जवर गयो। <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />अऊर बिल्हा गर्भवती भयी अऊर याकूब सी ओको एक टुरा पैदा भयो। <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />तब राहेल न कह्यो, “परमेश्वर न मोरो न्याय चुकायो अऊर मोरी सुन क मोख एक बेटा दियो।” येकोलायी ओन ओको नाम दान<note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="ft" closed="false">न्यायी</char></note> रख्यो। <verse eid="GEN 30:6" /><verse number="7" style="v" sid="GEN 30:7" />राहेल की दासी बिल्हा फिर गर्भवती भयी अऊर याकूब सी एक टुरा अऊर पैदा भयो। <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />तब राहेल न कह्यो, “मय न अपनी बहिन को संग बड़ी ताकत सी लड़ाई लड़ी हय, लेकिन मय जीत गयी हय।” येकोलायी ओन ओको नाम नप्ताली<note caller="+" style="f"><char style="fr" closed="false">30:8 </char><char style="ft" closed="false">मोरो परिश्रम</char></note> रख्यो।<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />जब लिआ न देख्यो कि ओकी सन्तान होनो बन्द होय गयो हय, तब ओन अपनी दासी जिल्पा ख ले क याकूब की पत्नी होन लायी दे दी। <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />अऊर लिआ की दासी जिल्पा ख भी याकूब सी एक टुरा पैदा भयो। <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />तब लिआ न कह्यो, “अहो भाग्य!” येकोलायी ओन ओको नाम<note caller="+" style="f"><char style="fr" closed="false">30:11 </char><char style="ft" closed="false">कामयाबी</char></note> गाद रख्यो। <verse eid="GEN 30:11" /><verse number="12" style="v" sid="GEN 30:12" />तब लिआ की दासी जिल्पा ख याकूब सी अऊर एक टुरा पैदा भयो। <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />तब लिआ न कह्यो, “मय धन्य हय; निश्चय बाईयों मोख धन्य कहेंन।” येकोलायी ओन ओको नाम आशेर रख्यो।<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />गहूं काटन को दिनों म रूबेन ख मैदान म दूदा फर<note caller="+" style="f"><char style="fr" closed="false">30:14 </char><char style="ft" closed="false">गर्भवती होन को फर</char></note> मिल्यो, अऊर ऊ उन्ख अपनी माय लिआ को जवर ले गयो। तब राहेल न लिआ सी कह्यो, “अपनो बेटा को दूदा फर म सी कुछ मोख दे।”<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />लिआ न ओको सी कह्यो, “तय न जो मोरो पति ख ले लियो हय का या छोटी सी बात हय? अब का तय मोरो बेटा को दूदा फर भी लेनो चाहवय हय?”</para>
  <para style="p" vid="GEN 30:15">राहेल न कह्यो, “अच्छा, तोरो बेटा को दूदा फरों को बदला ऊ अज रात ख तोरो संग सोयेंन।”<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />शाम ख जब याकूब मैदान सी आय रह्यो होतो, तब लिआ ओको सी मिल न ख निकली, अऊर कह्यो, “तोख मोरोच जवर आनो होना, कहालीकि मय न अपनो बेटा को दूदा फर देख क तोख सचमुच ले लियो।” तब याकूब ऊ रात ख ओकोच संग सोयो।<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />तब परमेश्वर न लिआ की सुनी, अऊर वा गर्भवती भयी अऊर याकूब सी ओको पाचवों टुरा पैदा भयो। <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />तब लिआ न कह्यो, “मय न जो अपनो पति ख दासी दी, येकोलायी परमेश्वर न मोख मोरी मजूरी दी हय।” येकोलायी ओन ओको नाम इस्साकार रख्यो। <verse eid="GEN 30:18" /><verse number="19" style="v" sid="GEN 30:19" />लिआ : फिर गर्भवती भयी अऊर याकूब सी ओको छठवो टुरा पैदा भयो। <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />तब लिआ न कह्यो, “परमेश्वर न मोख अच्छो दान दियो हय; अब की बार मोरो पति मोरो संग बन्यो रहेंन, कहालीकि मोरो ओको सी छय टुरा पैदा भय गयो हंय।” येकोलायी ओन ओको नाम जबूलून रख्यो। <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />येको बाद ओकी एक टुरी भी भयी, अऊर ओन ओको नाम दीना रख्यो।<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />परमेश्वर न राहेल की भी सुधि ली, अऊर ओकी प्रार्थना सुन क ओकी कोख खोली। <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />येकोलायी वा गर्भवती भयी अऊर ओन एक टुरा ख जनम दियो, तब ओन कह्यो, “परमेश्वर न मोरी नामधरायी ख दूर कर दियो हय।” <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />येकोलायी ओन यो कह्य क ओको नाम यूसुफ रख्यो, “परमेश्वर मोख एक बेटा अऊर देयेंन<note caller="+" style="f"><char style="fr" closed="false">30:24 </char><char style="ft" closed="false">अऊर भी देयेंन</char></note>।”<verse eid="GEN 30:24" /></para>
  <para style="s">याकूब अऊर लाबान को बीच समझौता</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />जब राहेल सी यूसुफ पैदा भयो, तब याकूब न लाबान सी कह्यो, “मोख बिदा कर कि मय अपनो देश अऊर घर ख वापस जाऊं। <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />मोख मोरी पत्नियां अऊर मोरो बच्चा, दे जिन्को लायी मय न तोरी सेवा करी हय, कि मय उन्ख ले क चली जाऊं; तय जो जानय हय कि मय न तोरी कसी सेवा करी हय।”<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />लाबान न ओको सी कह्यो, “यदि तोरी नजर म मय न अनुग्रह पायो हय, त इतच रह्य जा; कहालीकि मय न अनुभव सी जान लियो हय कि परमेश्वर न तोरो वजह सी मोख आशीष दी हय।” <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />तब याकूब न कह्यो, “तय ठीक बता कि मय तोख का देऊं, अऊर मय जरूर ओख देऊं।”<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />याकूब न ओको सी कह्यो, “तय जानय हय कि मय न तोरी कसी सेवा करी, अऊर तोरो जनावर मोरो जवर कसो तरह सी रह्यो। <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />मोरो आन सी पहिले हि कितनो होतो, अऊर अब कितनो भय गयो हंय; अऊर यहोवा न मोरो आनो पर तोख आशीष दी हय। पर मय अपनो घर को काम अब कब करन पाऊं?”<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />लाबान न फिर कह्यो, “मय तोख का देऊं?”</para>
  <para style="p" vid="GEN 30:31">याकूब न कह्यो, “तय मोख कुछ मत दे; यदि तय मोरो लायी एक काम करजो, त मय फिर तोरी शेरी मेंढियों ख चराऊं, अऊर उन्की रक्षा करूं। <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />मय अज तोरी सब शेरी मेंढियों को बीच म सी होय क निकलूं, अऊर जो शेरी या मेंढी धब्बा वाली अऊर चितबहाड़ी हो, अऊर जो मेंढी कारी हो, अऊर जो शेरी धब्बा वाली अऊर चितबहाड़ी हो, उन्ख मय अलग कर क् रखूं; अऊर याच मोरी मजूरी ठहरेंन। <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />अऊर जब आगु ख मोरी मजूरी की चर्चा तोरो आगु चले, तब ऊ दिन सच्चायी मोरो बदला तोख उत्तर देयेंन; मतलब शेरियों म सी जो कोयी बिना धब्बा वाली अऊर न चितबहाड़ी हो, अऊर मेंढी म सी जो कोयी कारी नहीं हो, यदि मोरो जवर निकले त चोरी की ठहरेंन।”<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />तब लाबान न कह्यो, “तोरो कहन को अनुसार हो।” <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />तब लाबान न उच दिन सब धारी वालो अऊर धब्बा वालो बकरों, अऊर सब धब्बा वाली चितबहाड़ी शेरियों ख, मतलब जेको पर सफेद धब्बा होतो, उन्ख अऊर सब कारी मेंढियों ख भी अलग कर क् अपनो बेटावों को हाथ सौंप दियो; <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />अऊर ओन अपनो अऊर याकूब को बीच म तीन दिन की रस्ता को अन्तर ठहरायो; अऊर याकूब लाबान की शेरी मेंढियों ख चरान लग्यो।<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />तब याकूब न चिनार, अऊर बादाम, अऊर अर्मोन को झाड़ों की हरी हरी डगालियां ले क, उन्को छिलटा कहीं छील क, उन्ख धारीदार बनाय दियो, अऊर उन छड़ियों की सफेदी दिखायी देन लगी। <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />तब छीली हुयी छड़ियों ख शेरी मेंढियों को आगु उन्को पानी पीवन को डोंगी म खड़ी करयो; अऊर जब हि पानी पीवन लायी आयी तब हि गाभन भय गयी। <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />छड़ियों को आगु गाभन होय क, शेरी मेंढी धारी वालो, धब्बा वालो अऊर चितबहाड़ी बच्चा जनी।<verse eid="GEN 30:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 30:40" />तब याकूब न मेंढियों को बच्चा ख अलग अलग करयो, अऊर लाबान की शेरी मेंढियों को मुंह ख धब्बा वालो अऊर सब कारो बच्चा को तरफ कर दियो; अऊर अपनो झुण्डों ख उन्को सी अलग रख्यो, अऊर लाबान की शेरी मेंढियों सी मिलन नहीं दियो।<verse eid="GEN 30:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 30:41" />अऊर जब जब ताकतवर शेरी मेंढी गाभन होत रह्य, तब तब याकूब उन छड़ियों ख उन्को आगु घड़ा म रख देत रह्य; जेकोसी हि ऊ छड़ियों ख देखतो हुयो गाभन होत रह्य। <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />पर जब कमजोर शेरी मेंढी गाभन होत रही, तब ऊ छड़ियों ख उन्को आगु नहीं रखत रह्य। येको सी कमजोर कमजोर शेरी मेंढी लाबान की भयी, अऊर ताकतवर शेरी मेंढी याकूब की भयी। <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />यो तरह याकूब बहुत धनी भय गयो, अऊर ओको बहुत सो शेरी मेंढी, दासियां अऊर दास, अऊर ऊंट अऊर गधा भय गयो।<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">याकूब को लाबान को जवर सी भगनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />तब लाबान को टुरावों कि या बाते याकूब को सुननो म आयी, “याकूब न हमरो बाप को सब कुछ छीन लियो हय, अऊर हमरो बाप को धन को वजह ओकी या प्रतिष्ठा हय।” <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />अऊर याकूब न लाबान को मुंह पर नजर करी अऊर देख लियो कि ऊ ओको प्रति पहिले को जसो नहीं रह्यो। <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />तब यहोवा न याकूब सी कह्यो, “अपनो पूर्वजों को देश अऊर अपनी जन्मभूमि पर वापस चली जा, अऊर मय तोरो संग रहूं।”<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />तब याकूब न राहेल अऊर लिआ : ख मैदान म अपनी शेरी मेंढियों को जवर बुलाय क कह्यो, <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />“तुम्हरो बाप को मुंह सी मय जान लेऊ हय कि ऊ मोख पहिले को जसो अब नहीं देखय; पर मोरो बाप को परमेश्वर मोरो संग हय। <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />तुम भी जानय हय कि मय न तुम्हरो बाप की सेवा पूरी शक्ति सी करी हय। <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />तब भी तुम्हरो बाप न मोरो सी छल कर क् मोरी मजूरी ख दस बार बदल दियो; पर परमेश्वर न ओख मोरो कुछ बुरो करन नहीं दियो। <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />जब ओन कह्यो, ‘धब्बा वालो बच्चा तोरी मजूरी ठहरेंन,’ तब सब शेरी मेंढी धब्बा वालो बच्चाच जनन लगी; अऊर जब ओन कह्यो, ‘धारी वालो बच्चा तोरी मजूरी ठहरेंन,’ तब सब शेरी मेंढी धारी वालो बच्चा जनन लगी। <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />यो रीति सी परमेश्वर न तुम्हरो बाप को जनावर ले क मोख दे दियो।<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />“शेरी मेंढियों को गाभन होन को समय मय न सपनो म यो देख्यो कि जो बकरा शेरियों पर चढ़ रह्यो हंय, हि धारी वालो, धब्बा वालो, अऊर चितबहाड़्या। <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />तब परमेश्वर को दूत न सपनो म मोरो सी कह्यो, ‘हे याकूब,’ मय न कह्यो, ‘का आज्ञा हय।’ <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />ओन कह्यो, ‘आंखी उठाय क उन सब बकरा ख देख जो शेरियों पर चढ़ रह्यो हंय, कि हि धारी वालो, धब्बा वालो, अऊर चितबहाड़्या हंय; कहालीकि जो कुछ लाबान तोरो सी कह्य हय, ऊ मय न देख्यो हय। <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" /><note caller="+" style="x"><char style="xo" closed="false">31:13 </char><char style="xt" closed="false"><ref loc="GEN 28:18-22">उत्पत्ति 28:18-22</ref></char></note>मय ऊ बेतेल को परमेश्वर आय, जित तय न एक गोटा को खम्बा पर तेल डाल्यो होतो, अऊर मोरी मन्नत मानी होती। अब चल, यो देश सी निकल क अपनी जन्मभूमि पर वापस चली जा।’”<verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />तब राहेल अऊर लिआ : न याकूब सी कह्यो, “का हमरो बाप को घर म अब भी हमरो लायी कुछ हिस्सा या जायजाद बची हय? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />का हमरो बाप न हम्ख परायो नहीं समझ्यो? देख, ओन हम्ख त बेच डाल्यो, अऊर जो रुपया हम्ख हासिल भयो होतो ओख खुद खाय गयो हय। <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />येकोलायी परमेश्वर न हमरो बाप को जितनो धन ले लियो हय, ऊ हमरो अऊर हमरो टुरावों को आय; अब जो कुछ परमेश्वर न तोरो सी कह्यो हय, उच कर।”<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />तब याकूब न अपनो टुरावों अऊर पत्नियों ख ऊंटों पर बैठायो; <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />अऊर जितनो जनावरों ख ऊ पद्दनराम की सीमा म जमा कर क् धनवान भय गयो होतो, सब ख कनान देश म अपनो बाप इसहाक को जवर जान को बिचार सी, संग ले गयो। <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />लाबान अपनी मेंढियों को ऊन काटन गयो होतो, जब ऊ बाहेर गयो तब राहेल घर म घुसी अऊर अपनो बाप को गृहदेवतावों ख चुराय ख ले गयी। <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />तब याकूब लाबान अरामी वंशीय को जवर सी चोरी सी चली गयो, तब लाबान ख याकूब न नहीं बतायो कि मय भगन वालो हय। <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />याकूब न अपनो परिवार अऊर सब कुछ ले क भग्यो, अऊर फरात नदी को पार उतर क अपनो मुंह गिलाद को तरफ करयो अऊर पहाड़ी देश को तरफ चल पड़्यो।<verse eid="GEN 31:21" /></para>
  <para style="s">लाबान द्वारा याकूब को पीछा करनो</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />तीसरो दिन लाबान ख समाचार मिल्यो कि याकूब भग गयो हय। <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />येकोलायी लाबान न अपनो भाऊवों ख संग ले क ओको सात दिन तक पीछा करयो, अऊर गिलाद को पहाड़ी देश म याकूब को संग जाय क मिल गयो। <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />पर परमेश्वर न रात को सपनो म अरामी लाबान को जवर आय क कह्यो, “सावधान रह्य, तय याकूब सी भलो बुरो मत कह्यजो।” <verse eid="GEN 31:24" /><verse number="25" style="v" sid="GEN 31:25" />तब याकूब अपनो तम्बू गिलाद नाम की पहाड़ी देश म खड़ो कर क् होतो; अऊर लाबान न भी अपनो भाऊवों को संग अपनो तम्बू उच पहाड़ी देश म खड़ो करयो।<verse eid="GEN 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 31:26" />तब लाबान याकूब सी कहन लग्यो, “तय न यो का करयो कि मोरो जवर सी चोरी सी चल्यो आयो, अऊर मोरी टुरियों ख असो ले क आयो, मानो तलवार की ताकत सी बन्दी बनायी गयी हो? <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />तय कहाली चुपचाप सी भग क आयो, अऊर मोरो सी बिना कुछ कह्यो मोरो जवर सी चोरी सी चल्यो आयो; नहीं त मय तोख आनन्द को संग डफली अऊर वीणा बजवात, अऊर गीत गवातो बिदा करतो? <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />तय न त मोख अपनो टुरा अऊर टुरियों को भी चुम्मा तक नहीं लेन दियो? तय न मूर्खता को काम करयो हय। <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />तुम लोगों की हानि करन की शक्ति मोरो हाथ म त हय; पर तुम्हरो बाप को परमेश्वर न मोरो सी बीती हुयी रात म कह्यो, ‘सावधान रह्य, याकूब सी न त भलो कह्यजो न बुरो।’ <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />मोख पता हय कि, अब तय अपनो बाप को घर म बड़ो उत्सुक सी चल्यो आयो हय, पर तय न मोरो घर को देवतावों ख कहाली चोर ख लायो?”<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />याकूब न लाबान ख उत्तर दियो, “मय यो सोच क डर गयो होतो कि कही तय अपनी टुरियों ख मोरो सी छीन न ले। <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />जो कोयी जवर तोरो अपनो देवतावों की मूर्ति मिलेंन, ऊ जीन्दो नहीं बचेंन। मोरो जवर तोरो जो कुछ निकले, ओख भाऊ बन्धुवों को आगु पहिचान क ले ले।” कहालीकि याकूब नहीं जानत होतो कि राहेल घर को देवतावों की मूर्तियां चोर क आयी हय।<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />यो सुन क लाबान याकूब को तम्बू म गयो; ओको बाद ऊ लिआ को तम्बू म गयो, अऊर तब ऊ दोयी दासियों को तम्बूवों म गयो; पर ओख मूर्तियां नहीं मिली। ओको बाद ऊ लिआ को तम्बू सी बाहेर निकल्यो अऊर राहेल को तम्बू म आयो। <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />राहेल त घर को देवतावों की मूर्तियां ख ऊंट को ऊपर को कपड़ा म लूकाय क उन्को पर बैठी होती। लाबान न ओको पूरो तम्बू म ढूंढ्यो पर उन्ख नहीं पायो। <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />राहेल न अपनो बाप सी कह्यो, “हे मोरो प्रभु; येको सी गुस्सा मत हो कि मय तोरो आगु नहीं उठी; कहालीकि मय मासिक धर्म सी हय।” यो तरह लाबान न ढूंढ्यो पर ओख घर को देवतावों की मूर्तियां नहीं मिली।<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />तब याकूब गुस्सा म आय क लाबान सी झगड़ा करन लग्यो, अऊर कह्यो, “मोरो का अपराध हय? मोरो का पाप हय कि तय न इतनो गुस्सा म आय क मोरो पीछा करयो हय? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />तय न जो मोरो पूरो सामान की तलाशी ली, त तोख अपनो घर को पूरो सामान म सी का मिल्यो? कुछ मिल्यो होना त ओख इत अपनो अऊर मोरो भाऊवों को आगु रख दे, अऊर हि हम दोयी को बीच न्याय करे। <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />इन बीस सालों तक मय तोरो जवर रह्यो; इन म न त तोरी शेरी मेंढियों को गर्भ गिरयो, अऊर न तोरो मेंढा को मांस मय न कभी खायो। <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />जो मेंढियों ख जंगली जनावर मार डालत रह्य ओख मय तोरो जवर नहीं लात रह्य, अऊर मय खुद ऊ हानि को पूर्ति करत होतो; मेंढियों की चोरी चाहे रात ख हो, या दिन ख, तय मोरो सीच ओकी पूरी पूर्ति करवात होतो। <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />मोरी त असी दशा होती कि दिन की तपन अऊर रात की ठंडी सी मय मरयो जात होतो; अऊर मोरी नींद मोरी आंखी सी भग जात रह्य। <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />मय बीस साल तक तोरो घर म रह्यो; चौदा साल त मय न तोरी दोयी टुरियों लायी, अऊर छय साल तोरी शेरी मेंढियों लायी सेवा करी; अऊर तय न मोरी मजूरी ख दस बार बदल डाल्यो। <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />मोरो बाप को परमेश्वर, मतलब अब्राहम को परमेश्वर, जेको डर इसहाक भी मानय हय, यदि मोरो पक्ष म नहीं होतो त तय जरूरच मोख खाली हाथ बिदा कर देतो। मोरो दु:ख अऊर मोरो हाथों को परिश्रम ख देख क परमेश्वर न बीती हुयी रात म तोख डाट्यो।”<verse eid="GEN 31:42" /></para>
  <para style="s">याकूब अऊर लाबान को बीच समझौता</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />लाबान न याकूब सी कह्यो, “हि टुरियां त मोरोच आय, अऊर हि बच्चा भी मोरोच आय, अऊर हि शेरी मेंढियां भी मोरीच आय, अऊर जो कुछ तोख दिखय हय ऊ सब मोरोच आय। पर अब मय अपनी इन टुरियों, अऊर इन्की सन्तान सी का कर सकू हय? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />अब आव, मय अऊर तय हम दोयी आपस म वाचा करबो, अऊर ऊ वाचा मोरो अऊर तोरो बीच याद रहन लायी हम गोटा को एक खम्भा बनायबो।”<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />तब याकूब न एक गोटा ले क ओको खम्भा खड़ो करयो। <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />तब याकूब न अपनो भाऊ बन्धुवों सी कह्यो, “गोटा जमा करो,” यो सुन क उन्न गोटा जमा कर क् एक ढेर लगायो, अऊर उच ढेर को जवर उन्न जेवन करयो। <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />ऊ ढेर को नाम लाबान न त यज्रसहादुथा<note caller="+" style="f"><char style="fr" closed="false">31:47 </char><char style="ft" closed="false">साक्षी को ढेर</char></note> रख्यो, पर याकूब न गिलियाद रख्यो। <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />लाबान न कह्यो, “यो ढेर अज सी मोरो अऊर तोरो बीच साक्षी रहेंन।” यो वजह ओको नाम गिलियाद रख्यो गयो, <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />तब लाबान न कह्यो, “जब हम एक दूसरो सी अलग रह्यो तब यहोवा मोरी अऊर तोरी देखभाल करतो रह्यो, येकोलायी ऊ जागा को नाम मिज़पा<note caller="+" style="f"><char style="fr" closed="false">31:49 </char><char style="ft" closed="false">देख भाल की जागा</char></note> भी रहेंन।” <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />तब लाबान न कह्यो, “यदि तय मोरी टुरियों ख दु:ख दे, या उन्को अलावा अऊर दूसरी बाईयां सी बिहाव कर ले, त हमरो संग कोयी आदमी त नहीं रहेंन; पर देख, मोरो तोरो बीच म परमेश्वर साक्षी रहेंन।” <verse eid="GEN 31:50" /><verse number="51" style="v" sid="GEN 31:51" />तब लाबान न याकूब सी कह्यो, “यो ढेर ख देख अऊर यो खम्भा ख भी देख, जिन्ख मय न अपनो अऊर तोरो बीच म खड़ो करयो हय। <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />यो ढेर अऊर यो खम्भा दोयी या बात को गवाह रहे कि यो ढेर ख पार कर क् तोरो जवर हानि करन को बिचार सी मय नहीं आऊं, अऊर तय यो ढेर अऊर खम्भा ख पार कर क् मोरो जवर नहीं आजो। <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />अब्राहम अऊर नाहोर अऊर उन्को बाप; इन तीनो को जो परमेश्वर हय, उच हम दोयी को बीच न्याय करे।” तब याकूब न ओकी कसम खायी जेको डर ओको बाप इसहाक मानत होतो; <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />अऊर याकूब न ऊ पहाड़ी पर जनावर की बलि चढ़ायी, अऊर अपनो भाऊ बन्धुवों ख जेवन करन लायी बुलायो; तब उन्न जेवन कर क् पहाड़ी पर रात बितायी। <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />दूसरो दिन भुन्सारे ख लाबान उठ्यो, अऊर अपनो नातियों को चुम्मा ले क टुरियों ख अलबिदा बोल क उन्ख आशीर्वाद दियो, अऊर अपनो घर ख चली गयो।<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">एसाव सी मिलन कि तैयारी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />याकूब न भी अपनी रस्ता लियो अऊर परमेश्वर को दूत ओख आय मिल्यो <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />ओख देखतोच याकूब न कह्यो, “यो त परमेश्वर को दल हय।” येकोलायी ओन ऊ जागा को नाम महनैम<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="ft" closed="false">दोय दल</char></note> रख्यो।<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />तब याकूब न सेईर देश म, यानेकि एदोम देश म, अपनो भाऊ एसाव को जवर अपनो आगु खबरी ख भेज दियो, <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />अऊर याकूब न खबर भेजन वालो ख या आज्ञा दी, “मोरो प्रभु एसाव सी यो कह्यजो : तोरो दास याकूब तोरो सी यो कह्य हय कि मय लाबान को यहां परदेशी होय क अब तक रह्यो; <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />अऊर मोरो जवर गाय बईल, गधा, शेरी मेंढी, अऊर दास दासियां हंय : अऊर मय न अपनो प्रभु को जवर येकोलायी सन्देश भेज्यो हय कि तोरो अनुग्रह कि नजर मोरो पर हो।”<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />हि दूत याकूब को जवर वापस आय क कहन लग्यो, “हम तोरो भाऊ एसाव को जवर गयो होतो, अऊर ऊ भी तोरो सी मुलाखात करन ख चार सौ आदमी को संग चल्यो आय रह्यो हय।” <verse eid="GEN 32:6" /><verse number="7" style="v" sid="GEN 32:7" />तब याकूब बहुत डर गयो, अऊर मुसीबत म पड़्यो; अऊर यो सोच क अपनो संगियों को, अऊर शेरी मेंढियों को, गाय बईल को, अऊर ऊंटों ख भी अलग कर क दोय दल बनायो, <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />कि यदि एसाव आय क पहिलो दल ख मारन लगे, त दूसरो दल भग क बच जायेंन।<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />तब याकूब न परमेश्वर सी कह्यो, “हे मोरो दादा अब्राहम को परमेश्वर, हे मोरो बाप इसहाक को परमेश्वर, तय न त मोरो सी कह्यो होतो कि अपनो देश अऊर जन्मभूमि म लौट जा, अऊर मय तोरी भलायी करूं : <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />तय न जो जो काम अपनी करुना अऊर सच्चायी सी अपनो दास को संग करयो हंय, कि मय जो अपनी छड़ीच ले क या यरदन नदी को पार उतर आयो, अऊर अब मोरो दोय दल होय गयो हंय; तोरो असो असो कामों म सी मय एक को भी लायक त नहाय। <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />मोरी बिनती सुन क मोख मोरो भाऊ एसाव को हाथ सी बचा : मय त ओको सी डरू हय, कही असो नहीं होय कि ऊ आय क मोख अऊर माय को संग टुरावों ख भी मार डाले। <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" /><note caller="+" style="x"><char style="xo" closed="false">32:12 </char><char style="xt" closed="false"><ref loc="GEN 22:17">उत्पत्ति 22:17</ref></char></note>तय न त कह्यो हय कि मय निश्चय तोरी भलायी करूं, अऊर तोरो वंश ख समुन्दर की रेतु को कन को जसो बहुत करूं, जो बहुतायत को मारे गिन्यो नहीं जाय सकय।”<verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />याकूब न ऊ दिन रात उतच बितायी; अऊर जो कुछ ओको जवर होतो ओको म सी अपनो भाऊ एसाव की भेंट लायी छांट छांट क निकाल्यो; <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />यानेकि दोय सौ मादा शेरियां, अऊर बीस नर बकरा, अऊर दोय सौ मादा मेंढी, अऊर बीस नर मेंढा, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />अऊर बच्चा समेत दूध देन वाली तीस मादा ऊंट, अऊर चालीस गाय, दस बईल, अऊर बीस मादा गधी अऊर उन्को दस बच्चा। <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />इन्क याकूब न झुण्ड झुण्ड म कर क्, अपनो दासों ख सौंप क उन्को सी कह्यो, “मोरो आगु बढ़ जावो; अऊर झुण्डों को बीच बीच म दूरी रखो।” <verse eid="GEN 32:16" /><verse number="17" style="v" sid="GEN 32:17" />तब याकूब न अगलो झुण्ड को रख वालो ख या आज्ञा दी, “जब मोरो भाऊ एसाव तोख मिले, अऊर पूछन लगे, ‘तय कोन्को दास आय, अऊर कित जावय हय, अऊर हि जो तोरो आगु आगु हंय, हि कोन्को जनावर आय?’ <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />तब कह्यजो, ‘यो तोरो दास याकूब को जनावर हंय। हे मोरो प्रभु एसाव, हि भेंट देन लायी तोरो जवर भेज्यो गयो हंय, अऊर तोरो दास खुदच हमरो पीछू पीछू आय रह्यो हय।’” <verse eid="GEN 32:18" /><verse number="19" style="v" sid="GEN 32:19" />अऊर याकूब न दूसरो अऊर तीसरो रख वालो ख भी, बल्की उन पूरो ख जो झुण्डों को पीछू पीछू होतो असीच आज्ञा दी कि जब एसाव तुम ख मिले तब योच तरह ओको सी कहो। <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />अऊर यो भी कहो, “तोरो दास याकूब हमरो पीछू पीछू आय रह्यो हय।” कहालीकि ओन यो सोच्यो कि या भेंट जो मोरो आगु आगु जावय हय, येको द्वारा मय एसाव को गुस्सा ख शान्त कर क् तब ओको दर्शन करूं; होय सकय हय कि ऊ मोरो सी खुश होय जाये। <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />येकोलायी ओन झुण्ड कि भेंट याकूब सी पहिलेच भेज दी, अऊर ऊ खुद ऊ रात ख छावनी म रह्यो।<verse eid="GEN 32:21" /></para>
  <para style="s">याकूब की कुश्ती</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />उच रात ख याकूब उठ्यो अऊर अपनी दोयी पत्नियों, दोयी दासियों अऊर ग्यारा टुरावों ख संग ले क घाट सी यब्बोक नदी को ओन पार उतर गयो। <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />याकूब न उन्ख नदी को ऊ पार उतार दियो, अऊर जो कुछ याकूब को जवर होतो सब कुछ उतार दियो। <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />अऊर याकूब खुद अकेलो रह्य गयो;</para>
  <para style="p" vid="GEN 32:24">तब कोयी आदमी आय क भुन्सारो तक याकूब सी कुश्ती करतो रह्यो। <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />जब ऊ आदमी न देख्यो कि मय याकूब ख हराय नहीं सकू, तब ओन याकूब को जांघ की नस ख छूयो, तब ऊ समय याकूब को जांघ की नस अपनी जागा सी हट गयी। <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />तब ऊ आदमी न कह्यो, “मोख जान दे, कहालीकि सुबेरे होन वाली हय,” याकूब न कह्यो,</para>
  <para style="p" vid="GEN 32:26">“जब तक तय मोख आशीर्वाद नहीं देजो, तब तक मय तोख जान नहीं देऊं।”<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />अऊर ओन याकूब सी पुच्छ्यो, “तोरो नाम का हय?”</para>
  <para style="p" vid="GEN 32:27">ओन कह्यो, “याकूब।”<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">32:28 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 35:10">उत्पत्ति 35:10</ref>
      </char>
    </note>ओन कह्यो, “तोरो नाम अब याकूब नहाय, पर इस्राएल<note caller="+" style="f"><char style="fr" closed="false">32:28 </char><char style="ft" closed="false">परमेश्वर सी लड़न वालो</char></note> होयेंन, कहालीकि परमेश्वर सी अऊर आदमियों सी भी युद्ध कर क् तय न विजय हासिल करी हय।”<verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">32:29 </char>
      <char style="xt" closed="false">
        <ref loc="JDG 13:17">न्यायियों 13:17</ref>,<ref loc="JDG 13:18">18</ref></char>
    </note>याकूब न कह्यो, “मय बिनती करू हय, मोख अपनो नाम बता।” ओन कह्यो, “तय मोरो नाम कहाली पूछय हय?”</para>
  <para style="p" vid="GEN 32:29">तब ओन याकूब ख उतच आशीर्वाद दियो।<verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />तब याकूब न ऊ जागा को नाम पनीएल<note caller="+" style="f"><char style="fr" closed="false">32:30 </char><char style="ft" closed="false">परमेश्वर को मुख</char></note> रख्यो; कहालीकि ओन कह्यो, “मय न परमेश्वर ख आमने सामने देखनो पर भी मय जीन्दो रह्यो।” <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />जब याकूब पनीएल सी जान लग्यो त सूरज निकल गयो, अऊर याकूब की जांघ की नस सुजन को वजह लंगड़ावत होतो। <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />इस्राएली जाति को लोग अज तक जनावरों को जांघ की नस ख जो जांघ को जोड़ो पर होवय हय, ओख नहीं खावय; कहालीकि ऊ आदमी न याकूब की जांघ म जांघ की नस को छूयो होतो।<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">याकूब को एसाव सी मिलनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />याकूब न आंखी उठाय क यो देख्यो कि एसाव चार सौ आदमी ख संग लियो हुयो आय रह्यो हय। तब ओन बच्चा ख अलग अलग बाट क लिआ : राहेल अऊर दोयी दासियों ख उन्को बच्चा सौंप दियो। <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />अऊर ओन सब सी आगु दोयी दासियों अऊर उन्को बच्चा ख, उन्को पीछू लिआ ख ओको बच्चा को संग, अऊर सब सी पीछू राहेल अऊर यूसुफ ख खड़ो करयो, <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />अऊर याकूब खुद उन सब को आगु आगु गयो जब तक ऊ अपनो भाऊ को जवर नहीं पहुंच गयो, तब तक ऊ जमीन पर झुक क सात बात ओख दण्डवत करतो रह्यो। <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />तब एसाव ओको सी भेंट करन ख दौड़्यो, अऊर ओन याकूब ख दिल सी लगाय क, ओख गरो लगायो अऊर चुम्मा लियो; तब एसाव अऊर याकूब रोवन लग्यो। <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />तब एसाव न आंखी उठाय क बाईयों अऊर बच्चा ख देख्यो, अऊर याकूब सी पुच्छ्यो, “हि जो तोरो संग हंय हि कौन आय?”</para>
  <para style="p" vid="GEN 33:5">याकूब न कह्यो, “हि तोरो दास को बच्चा आय, जिन्ख परमेश्वर न अनुग्रह कर क् मोख दियो हय।” <verse eid="GEN 33:5" /><verse number="6" style="v" sid="GEN 33:6" />तब दासियां अऊर उन्को बच्चा जवर आय क झुक क एसाव ख दण्डवत करयो; <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />योच तरह लिआ अऊर ओको बच्चा जवर आयो अऊर उन्न झुक क एसाव ख दण्डवत करयो; आखरी म यूसुफ अऊर राहेल न भी जवर आय क दण्डवत करयो।<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />तब एसाव न पुच्छ्यो, “तोरो यो बड़ो झुण्ड मोख मिल्यो, येको का मतलब हय?”</para>
  <para style="p" vid="GEN 33:8">याकूब न कह्यो, “हि तुम्ख मोरी भेंट हंय जेको सी तुम मोख स्वीकार कर सको।”<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />एसाव न कह्यो, “हे मोरो भाऊ, मोरो जवर त बहुत हय; जो कुछ तोरो हय ऊ तोरोच रहे।”<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />याकूब न कह्यो, “नहीं नहीं, यदि तोरो अनुग्रह मोरो पर हो, त मोरी भेंट ग्रहन कर; कहालीकि मय न तोरो दर्शन पा क, मानो परमेश्वर को दर्शन पायो हय, अऊर तय मोरो सी प्रसन्न भयो हय। <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />येकोलायी यो भेंट जो तोख भेजी गयी हय, ओख ग्रहन कर; कहालीकि परमेश्वर न मोरो पर अनुग्रह करयो हय, अऊर मोरो जवर बहुत हय।” जब याकूब न ओको सी बहुत आग्रह करयो, तब एसाव न भेंट ख ग्रहन करयो।<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />तब एसाव न कह्यो, “आव, हम अपनी रस्ता पर आगु चलबो; अऊर मय तोरो आगु आगु चलूं।”<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />याकूब न कह्यो, “हे मोरो स्वामी, तय त जानय हय कि मोरो बच्चा कमजोर हंय, मोरो संग दूध देन वाली शेरी मेंढियां अऊर गाय हंय; जिन्की देखभाल मोख करनो पड़य हय, यदि मय इन्क एक दिन भी जादा दूर चलन लायी विवश करू हय, त सब को सब मर जायेंन। <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />येकोलायी मोरो स्वामी अपनो दास को आगु बढ़ जाये, अऊर मय इन जनावरों की गति को अनुसार जो मोरो आगु हंय, अऊर बच्चां की गति को अनुसार धीरू धीरू आगु चल क सेईर नगर म अपनो स्वामी को जवर पहुंचूं।”<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />एसाव न कह्यो, “त मय अपनो संगियों म सी कुछ ख तोरो संग छोड़ जाऊं।”</para>
  <para style="p" vid="GEN 33:15">तब याकूब न कह्यो, “येकी का जरूरत हय? इतनोच बहुत हय कि मोरो स्वामी की अनुग्रह की नजर मोरो पर बनी रहे।” <verse eid="GEN 33:15" /><verse number="16" style="v" sid="GEN 33:16" />तब एसाव उच दिन सेईर नगर चली गयो। <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />पर याकूब उत सी निकल क सुक्कोत<note caller="+" style="f"><char style="fr" closed="false">33:17 </char><char style="ft" closed="false">झोपड़ा को घर</char></note> नगर ख गयो, अऊर उत अपनो लायी एक घर, अऊर जनावरों लायी कोठा बनायो। योच वजह ऊ जागा को नाम सुक्कोत पड़्यो।<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />याकूब पद्दनराम प्रदेश सी निकल क, कनान देश को शकेम नगर को जवर अच्छो सी पहुंच क ओन नगर को जवर तम्बू खड़ो करयो। <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" /><note caller="+" style="x"><char style="xo" closed="false">33:19 </char><char style="xt" closed="false"><ref loc="JOS 24:32">यहोशू 24:32</ref>; <ref loc="JHN 4:5">यूहन्ना 4:5</ref></char></note>अऊर जो जमीन पर याकूब न तम्बू खड़ो करयो, ओख ओन शकेम को बाप हमोर को टुरावों को हाथ सी एक सौ चांदी को सिक्का म लेय लियो। <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />उत याकूब न एक वेदी बनाय क ओको नाम एल-एलोहे-इस्राएल<note caller="+" style="f"><char style="fr" closed="false">33:20 </char><char style="ft" closed="false">इस्राएल को परमेश्वर</char></note> रख्यो।<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">दिना को भ्रष्ट करयो जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />एक दिन लिआ की टुरी दीना, जो याकूब सी पैदा भयी होती, वा कनान देश की टुरियों सी भेंट करन ख गयी। <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />तब ऊ देश को प्रधान हमोर होतो हमोर को टुरा को नाम शकेम होतो ऊ हिव्वी जाति को होतो, शकेम न दीना ख पकड़ लियो अऊर अपनो संग शारीरिक सम्बन्ध बनाय क ओख भ्रष्ट कर डाल्यो। <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />तब शकेम को मन याकूब की टुरी दीना सी लग गयो, अऊर ओन दीना सी प्रेम की बाते करी, अऊर ओको सी प्रेम करन लग्यो। <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />तब शकेम न अपनो बाप हमोर सी कह्यो, “मोख या टुरी ख मोरी पत्नी को रूप म दिलाय दे।”<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />अऊर याकूब न सुन्यो कि शकेम न मोरी टुरी दीना ख अशुद्ध कर डाल्यो हय; पर याकूब को टुरा ऊ समय जनावरों को संग मैदान म होतो, येकोलायी याकूब उन्को आनो तक चुप रह्यो। <verse eid="GEN 34:5" /><verse number="6" style="v" sid="GEN 34:6" />तब शकेम को बाप हमोर निकल क याकूब सी बातचीत करन लायी ओको जवर गयो। <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />तब याकूब को टुरावों न दीना को बारे म असो सुन्यो त मैदान सी बहुत उदास अऊर गुस्सा सी आयो; कहालीकि शकेम न याकूब की टुरी को संग सोय क इस्राएली समाज म मुर्खतापूर्न काम करयो होतो, असो करनो बहुत गलत होतो <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />हमोर न उन सब सी कह्यो, “मोरो टुरा शकेम तुम्हरी टुरी सी बहुत प्रेम करन लग्यो हय, कृपया अपनी टुरी ख पत्नी को रूप म शकेम ख प्रदान कर देवो। <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />अऊर हम लोगों सी बिहाव को सम्बन्ध बान्धो; अपनी बेटियां हम्ख देवो, अऊर हमरी बेटियां तुम लेवो। <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />तब तुम हमरो संग यो देश म रह्य सको; यो देश को दरवाजा तुम्हरो लायी खुल जायेंन, यहां रहो अऊर व्यापार करो, अऊर धन सम्पत्ति कमाय लेवो।”<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />शकेम न भी दीना को बाप अऊर भाऊवों सी कह्यो, “यदि मोरो पर तुम लोगों की अनुग्रह की नजर हो, त जो कुछ तुम मोरो सी कहो, ऊ मय तुम्ख देऊं। <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />तुम मोरो सी कितनो भी जादा दाम अऊर भेंट मांगो, उतनो मय तुम्ख तुम्हरो वचन को अनुसार देऊं; पर तुम केवल मोख अपनी टुरी पत्नी को रूप म प्रदान कर देवो।”<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />तब यो सोच क कि शकेम न हमरी बहिन दीना ख अशुद्ध करयो हय, याकूब को टुरावों न शकेम अऊर ओको बाप हमोर ख छल को संग यो उत्तर दियो, <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />हि बोल्यो “हम असो काम नहीं कर सकजे कि कोयी बिना खतना वालो आदमी ख हम अपनी बहिन देबो, कहालीकि येको सी हमरो अपमान होयेंन। <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />हम केवल यो शर्त पर तुम्हरी बात मान सकजे हंय कि हमरो जसो तुम्हरी जाति को हर एक आदमी को खतना करयो जाये। <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />तब हम अपनी बेटियां तुम लोगों ख देबो, अऊर तुम्हरी बेटियां हम अपनाय लेबो, अऊर तुम्हरो संग बस्यो भी रह्यबोंन, अऊर हम दोयी एकच जाति को आदमी बन जाबो। <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />पर यदि तुम हमरी बात नहीं मानो अऊर खतना नहीं करो, त हम अपनी टुरी ख ले क इत सी चली जाबो।”<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />उन्की यो बात पर हमोर अऊर ओको टुरा शकेम खुश भयो। <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />अऊर युवक शकेम न ओकी मांग ख पूरो करनो म देर नहीं करयो, कहालीकि ऊ याकूब की टुरी ख बहुत चाहत होतो। ऊ अपनो बाप को पूरो परिवार म बहुत जादा महत्वपूर्न आदमी होतो।<verse eid="GEN 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 34:20" />येकोलायी हमोर अऊर ओको टुरा शकेम अपनो नगर को फाटक को जवर जाय क नगर म रहन वालो ख यो समझान लग्यो, <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />“हि आदमी हमरो संग मिलझुल क रहनो चाहवय हंय, येकोलायी उन्ख यो देश म रह्य क लेन देन करन देवो; देखो, यो देश की जमीन उन्को लायी भी बहुत हय; तब हम लोग उन्की टुरियों सी भी बिहाव कर लेबो, अऊर अपनी टुरियों ख भी उन्ख दियो करबो। <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />हि लोग केवल यो बात पर हमरो संग रहन लायी अऊर एकच जाति को लोग होय जान लायी राजी हंय कि उन्को जसो हमरो सब आदमियों को भी खतना करयो जाये। <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />तब उन्की शेरी मेंढियां, अऊर गाय बईल अऊर उन्को पूरो जनावर अऊर धन सम्पत्ति हमरी नहीं होय जायेंन? इतनोच करे कि हम लोग उन्की बात मान ले, त हि हमरो संग रहेंन।” <verse eid="GEN 34:23" /><verse number="24" style="v" sid="GEN 34:24" />येकोलायी जितनो ऊ नगर की फाटक सी निकलत होतो, उन पूरो न हमोर की अऊर ओको टुरा शकेम की बात मानी; अऊर हर एक आदमी को खतना करयो गयो, जितनो ऊ नगर की फाटक सी निकलत होतो।<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />तीसरो दिन, जब खतना करयो वालो लोग दु:ख म पड़्यो होतो, तब असो भयो कि शिमोन अऊर लेवी नाम को याकूब को दोय टुरावों न, जो दीना को भाऊ होतो, अपनी अपनी तलवार धर क ऊ नगर म बेधड़क घुस क सब आदमियों ख मार डाल्यो। <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />हमोर अऊर ओको टुरा शकेम ख उन्न तलवार सी मार डाल्यो, अऊर दीना ख शकेम को घर सी निकाल क लिजायो। <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />याकूब को दूसरो टुरावों न मार डालन पर भी उन्न नगर ख येकोलायी लूट लियो कि ऊ नगर म उन्की बहिन अशुद्ध करी गयी होती। <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />उन्न शेरी मेंढी गाय बईल, गधा, अऊर नगर अऊर मैदान म जितनो धन होतो लूट लियो। <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />उन सब ख, अऊर उन्को बाल बच्चा, अऊर उन्की बाईयों ख भी लिजायो, अऊर घर घर म जो कुछ होतो उन्ख भी उन्न लूट लियो।<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />तब याकूब न शिमोन अऊर लेवी सी कह्यो, “तुम न जो यो देश को निवासी म कनानियों अऊर परिज्जी जाति को मन म मोरो खिलाफ नफरत पैदा करायी हय, येको सी तुम न मोख संकट म डाल्यो हय, कहालीकि मोरो संग त थोड़ो सोच लोग हंय; येकोलायी अब हि जमा होय क मोरो पर हमला करेंन, अऊर मोख मार डालेंन, त मय अपनो घराना सहीत नाश होय जाऊं।”<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />उन्न कह्यो, “का ऊ हमरी बहिन को संग वेश्या को जसो बर्ताव करे?”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">बेतेल म याकूब ख आशीष मिलनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">35:1 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 28:11-17">उत्पत्ति 28:11-17</ref>
      </char>
    </note>तब परमेश्वर न याकूब सी कह्यो, “इत सी निकल क बेतेल नगर ख जा, अऊर उतच रह्यजो; अऊर उत परमेश्वर लायी वेदी बना, जेन तोख ऊ समय दर्शन दियो जब तय अपनो भाऊ एसाव को डर सी भगत होतो।”<verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />तब याकूब न अपनो घराना सी, अऊर उन सब सी भी कह्यो जो ओको संग होतो, “तुम्हरो बीच म जो परायो देवता हंय, उन्ख निकाल फेको; अऊर अपनो अपनो ख शुद्ध करो, अऊर अपनो कपड़ा बदल डालो; <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />अऊर आवो, हम इत सी निकल क बेतेल नगर ख जाबो; उत मय परमेश्वर लायी एक वेदी बनाऊं, जेन संकट को दिन म मोरी सुन ली, अऊर जो रस्ता सी मय चलत होतो, ओको म मोरो संग रह्यो।” <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />जितनो दूसरो देवतावों की मूर्तियां उन्को जवर होती, अऊर जितनो कुण्डल उन्को कानो म होतो, उन पूरो ख उन्न याकूब ख दे दियो; अऊर याकूब न उन्ख शकेम नगर को जवर बांझ झाड़ को खल्लो गाड़ दियो।<verse eid="GEN 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 35:5" />तब याकूब अऊर ओको टुरावों न प्रस्थान करयो; तब उन्को चारयी तरफ को नगर निवासियों को मन म परमेश्वर को असो डर समाय गयो कि उन्न याकूब को टुरावों को पीछा नहीं करयो। <verse eid="GEN 35:5" /><verse number="6" style="v" sid="GEN 35:6" />याकूब उन पूरो को संग जो ओको संग होतो, कनान देश को लूज नगर म आयो। ऊ नगर बेतेल भी कहलावय हय। <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />उत याकूब न एक वेदी बनायी, अऊर ऊ जागा को नाम एलबेतेल रख्यो; कहालीकि जब ऊ अपनो भाऊ को डर सी भग्यो जात होतो तब परमेश्वर न खुद ख ओको पर उतच प्रगट करयो होतो। <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />अऊर रिबका की दूध पिलान वाली दाई दबोरा मर गयी, अऊर बेतेल<note caller="+" style="f"><char style="fr" closed="false">35:8 </char><char style="ft" closed="false">बेतेल को परमेश्वर</char></note> नगर को बांझ झाड़ को खल्लो को भाग म ओख माटी दी गयी, अऊर ऊ बांझ झाड़ को नाम अल्लोनबक्कूत<note caller="+" style="f"><char style="fr" closed="false">35:8 </char><char style="ft" closed="false">रूलाई को बीज</char></note> रख्यो गयो।<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />तब याकूब को पद्दनराम सी आन को बाद परमेश्वर न दूसरी बार ओख दर्शन दे क आशीष दी। <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" /><note caller="+" style="x"><char style="xo" closed="false">35:10 </char><char style="xt" closed="false"><ref loc="GEN 32:28">उत्पत्ति 32:28</ref></char></note>अऊर परमेश्वर न ओको सी कह्यो, “अब तक तोरो नाम याकूब रह्यो हय, पर आगु ख तोरो नाम याकूब नहीं रहेंन, पर तय इस्राएल कहलायजो।” यो तरह परमेश्वर न याकूब को नाम इस्राएल रख्यो। <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" /><note caller="+" style="x"><char style="xo" closed="false">35:11 </char><char style="xt" closed="false"><ref loc="GEN 17:4-8">उत्पत्ति 17:4-8</ref></char></note>तब परमेश्वर न ओको सी कह्यो, “मय सर्वशक्तिमान ईश्वर आय। तय फूल फल अऊर बढ़े; अऊर तोरो सी एक जाति अऊर जातियों की मण्डली भी पैदा होयेंन, अऊर तोरो वंश म राजा पैदा होयेंन। <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />अऊर जो देश मय न अब्राहम अऊर इसहाक ख दियो हय, उच देश तोख देऊ हय, अऊर तोरो पीछू तोरो वंश ख भी देऊं।” <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />तब परमेश्वर ऊ जागा म, जित ओन याकूब सी बाते करी, ओको जवर सी ऊपर चढ़ गयो। <verse eid="GEN 35:13" /><verse number="14" style="v" sid="GEN 35:14" />अऊर जो जागा म परमेश्वर न याकूब सी बाते करी, उत याकूब न गोटा को एक खम्भा खड़ो करयो, अऊर ओको पर अंगूर रस अऊर जैतून को तेल डाल दियो। <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />जित परमेश्वर न याकूब सी बाते करी, ऊ जागा को नाम ओन बेतेल रख्यो।<verse eid="GEN 35:15" /></para>
  <para style="s">राहेल को मरनो</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />तब याकूब अऊर ओको परिवार बेतेल नगर सी जान लग्यो। अऊर एप्राता नगर थोड़ोच दूर रह्य गयो होतो कि राहेल ख बच्चा पैदा होन की बड़ी पीड़ा उठन लगी। <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />जब ओख बड़ी बड़ी पीड़ा उठत होती तब सुईन न ओको सी कह्यो, “मत डर; अब की भी बार तोख टुराच होयेंन।” <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />तब असो भयो कि वा मर गयी, अऊर जीव निकलतो निकलतो ओन ऊ टुरा को नाम बेनोनी रख्यो; पर ओको बाप न ओको नाम बिन्यामीन रख्यो।<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />राहेल त मर गयी, अऊर एप्राता मतलब बैतलहम की रस्ता म ओख माटी दी गयी। <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />याकूब न ओकी कब्र पर एक खम्भा खड़ो करयो : राहेल की कब्र को ऊ खम्भा अज तक खड़ो अऊर बन्यो हय। <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />तब इस्राएल आगु बड़तो गयो, अऊर एदेर नाम की मीनार को आगु बढ़ क अपनो तम्बू खड़ो करयो।<verse eid="GEN 35:21" /></para>
  <para style="s">याकूब को टुरा</para>
  <para style="r">(<ref loc="1CH 2:1">१ इतिहास 2:1</ref>; <ref loc="1CH 2">2</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />जब इस्राएल ऊ देश म बस्यो होतो, तब एक दिन असो भयो कि रूबेन न जाय क अपनो बाप की रखैल बिल्हा को संग कुकर्म करयो; अऊर या बात इस्राएल ख मालूम भय गयी।</para>
  <para style="p" vid="GEN 35:22">याकूब को बारा टुरा भयो। <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />उन म सी लिआ : को टुरा हि होतो; रूबेन याकूब को बड़ो टुरा शिमोन, लेवी, यहूदा, इस्साकार, अऊर जबूलून। <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />अऊर राहेल को टुरा हि होतो; मतलब यूसुफ अऊर बिन्यामीन। <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />अऊर राहेल की दासी बिल्हा को टुरा हि होतो; मतलब दान अऊर नप्ताली। <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />अऊर लिआ : की दासी जिल्पा को टुरा हि होतो : मतलब गाद, अऊर आशेर। याकूब को हिच टुरा भयो, जो ओको सी पद्दनराम क्षेत्र म पैदा भयो।<verse eid="GEN 35:26" /></para>
  <para style="s">इसहाक को मरनो</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">35:27 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 13:18">उत्पत्ति 13:18</ref>
      </char>
    </note>याकूब मम्रे म, जो किर्यतर्बा मतलब हेब्रोन हय, जित अब्राहम अऊर इसहाक परदेशी होय क रह्यो होतो, अपनो बाप इसहाक को जवर आयो। <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />इसहाक की उमर एक सौ अस्सी साल की भयी। <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />अऊर इसहाक को जीव छूट गयो अऊर ऊ मर गयो, अऊर ऊ बूढ्ढा अऊर पूरी उमर को होय क अपनो लोगों म जाय मिल्यो; अऊर ओको टुरा एसाव अऊर याकूब न ओख माटी दी।<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">एसाव की वंशावली</para>
  <para style="r">(<ref loc="1CH 1:34-37">१ इतिहास 1:34-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />एसाव जो एदोम भी कहलावय हय, ओकी यो वंशावली हय। <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" /><note caller="+" style="x"><char style="xo" closed="false">36:2 </char><char style="xt" closed="false"><ref loc="GEN 26:34">उत्पत्ति 26:34</ref></char></note>एसाव न त कनान देश की टुरियां सी बिहाव कर लियो; मतलब हित्ती एलोन की टुरी आदा ख, अऊर ओहोलीबामा ख जो अना की टुरी अऊर हिव्वी सिबोन की नातिन होती। <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" /><note caller="+" style="x"><char style="xo" closed="false">36:3 </char><char style="xt" closed="false"><ref loc="GEN 28:9">उत्पत्ति 28:9</ref></char></note>तब ओन इश्माएल की टुरी बासमत ख भी, जो नबायोत की बहिन होती, बिहाव कर लियो। <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />आदा न एसाव को द्वारा एलीपज ख, अऊर बासमत न रूएल ख जनम दियो। <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />अऊर ओहोलीबामा न यूश, अऊर यालाम, अऊर कोरह ख पैदा करयो। एसाव को हिच टुरा कनान देश म पैदा भयो।<verse eid="GEN 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />तब एसाव अपनी पत्नियों अऊर टुरा टुरियों, अऊर घर को सब प्रानियों, अपनी शेरी मेंढियों, गाय बईल अऊर सब जनावरों, निदान अपनी पूरी जायजाद ख, जो ओन कनान देश म हासिल करी होती, ले क अपनो भाऊ याकूब को जवर सी दूसरो देश ख चली गयो। <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />कहालीकि उन्की जायजाद इतनी भय गयी होती कि हि जमा नहीं रह्य सक्यो; अऊर जनावरों को बहुत होनो को वजह ऊ देश म, जित हि परदेशी होय क रहत होतो, हि उत समाय नहीं सक्यो। <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />एसाव जो एदोम भी कहलावय हय, सेईर नाम की पहाड़ी देश म रहन लग्यो।<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />सेईर नाम की पहाड़ी देश म रहन वालो एदोमियों को मूल आदमी एसाव की वंशावली या आय। <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />एसाव को टुरावों को नाम यो हंय; मतलब एसाव की पत्नी आदा को टुरा एलीपज,</para>
  <para style="p" vid="GEN 36:10">अऊर वाच एसाव की पत्नी बासमत को टुरा रूएल। <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />एलीपज को हि टुरा भयो; मतलब तेमान, ओमार, सपो, गाताम, अऊर कनज। <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />एसाव को टुरा एलीपज की तिम्रा नाम की एक रखैल होती, जेन एलीपज को द्वारा अमालेक ख जनम दियो : एसाव की पत्नी आदा को वंश म हिच भयो। <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />रूएल को हि टुरा भयो; मतलब नहत, जेरह, शम्मा, अऊर मिज्जा : एसाव की पत्नी बासमत को वंश म हिच भयो।<verse eid="GEN 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 36:14" />ओहोलीबामा जो एसाव की पत्नी अऊर सिबोन की नातिन अऊर अना की टुरी होती, ओको हि टुरा भयो : मतलब ओन एसाव को द्वारा यूश, यालाम अऊर कोरह ख जनम दियो।<verse eid="GEN 36:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />हि एसाव को वंशजों को मुखिया भयो : मतलब एसाव को बड़ो टुरा एलीपज को वंश म सी तेमान, ओमार, सपो, कनज मुखिया, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />कोरह, गाताम, अमालेक मुखिया : एलीपज को वंश म सी, एदोम देश म हिच मुखिया भयो : अऊर हिच आदा को वंश म भयो।<verse eid="GEN 36:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 36:17" />एसाव को टुरा रूएल को वंश म हि भयो; मतलब नहत, जेरह, शम्मा, मिज्जा : रूएल को वंश म सी, एदोम देश म सी हि मुखिया भयो; अऊर हिच एसाव की पत्नी बासमत को वंश म भयो।<verse eid="GEN 36:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 36:18" />एसाव की पत्नी ओहोलीबामा को वंश म हि भयो; मतलब यूश, यालाम, कोरह, अऊर अना की टुरी ओहोलीबामा जो एसाव की पत्नी होती ओको वंश म हिच मुखिया भयो। <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />एसाव जो एदोम भी कहलावय हय, ओको वंश हिच आय, अऊर उन्को मुखिया भी हिच भयो।<verse eid="GEN 36:19" /></para>
  <para style="s">सेईर की वंशावली</para>
  <para style="r">(<ref loc="1CH 1:38-42">१ इतिहास 1:38-42</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />सेईर जो होरी नाम की जाति को होतो, ओको हि टुरा एदोम देश म पहिले सी रहत होतो : लोतान, शोबाल, सिबोन, अना, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />दीशोन, एसेर, अऊर दीशोन : एदोम देश म सेईर को हिच होरी जाति को मुखिया भयो।<verse eid="GEN 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 36:22" />लोतान को टुरा, होरी अऊर हेमाम भयो; अऊर लोतान की बहिन तिम्रा होती।<verse eid="GEN 36:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 36:23" />शोबाल को हि टुरा भयो : आल्वान, मानहत, एबाल, शपो, अऊर ओनाम।<verse eid="GEN 36:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 36:24" />सिदोन को हि टुरा भयो : अय्या, अऊर अना; या वाच अना आय जेक जंगल म अपनो बाप सिबोन को गधा ख चरावत चरावत गरम पानी को झरना मिल्यो होतो। <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />अना को दीशोन नाम को टुरा भयो, अऊर वाच अना ख ओहोलीबामा नाम की टुरी भयी। <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />दीशोन को हि टुरा भयो : हेमदान, एश्बान, यित्रान, अऊर करान।<verse eid="GEN 36:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 36:27" />एसेर को हि टुरा भयो : बिल्हान, जाबान, अऊर अकान।<verse eid="GEN 36:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 36:28" />दीशोन को हि टुरा भयो : ऊस, अऊर अरान।<verse eid="GEN 36:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 36:29" />होरी जाति को मुखिया हि भयो : लोतान, शोबाल, सिबोन, अऊर अना मुखिया, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />दीशोन, एसेर, दीशोन; सेईर देश म होरी जाति को हिच मुखिया भयो।<verse eid="GEN 36:30" /></para>
  <para style="s">एदोम को राजा</para>
  <para style="r">(<ref loc="1CH 1:43-54">१ इतिहास 1:43-54</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />तब जब इस्राएलियों पर कोयी राजा न राज्य नहीं करयो होतो, तब भी एदोम को देश म हि राजा भयो;<verse eid="GEN 36:31" /></para>
  <para style="li1">
    <verse number="32" style="v" sid="GEN 36:32" />बोर को टुरा बेला न एदोम म राज्य करयो, अऊर ओकी राजधानी को नाम दिन्हाबा हय। <verse eid="GEN 36:32" /><verse number="33" style="v" sid="GEN 36:33" />बेला को मरनो पर, बोस्रा नगर को रहन वालो जेरह को टुरा योबाब ओकी जागा पर राजा भयो।<verse eid="GEN 36:33" /></para>
  <para style="li1">
    <verse number="34" style="v" sid="GEN 36:34" />योबाब को मरनो पर तेमानी जाति को देश को निवासी हूशाम ओकी जागा पर राजा भयो।<verse eid="GEN 36:34" /></para>
  <para style="li1">
    <verse number="35" style="v" sid="GEN 36:35" />तब हूशाम को मरनो पर बदद को टुरा हदद ओकी जागा पर राजा भयो : यो उच आय जेन मिद्दानी जाति ख मोआब को देश म मार लियो, अऊर ओकी राजधानी को नाम अबीत हय।<verse eid="GEN 36:35" /></para>
  <para style="li1">
    <verse number="36" style="v" sid="GEN 36:36" />हदद को मरनो पर मस्रेका नगर को निवासी सम्ला ओकी जागा पर राजा भयो।<verse eid="GEN 36:36" /></para>
  <para style="li1">
    <verse number="37" style="v" sid="GEN 36:37" />तब सम्ला को मरनो पर शाऊल जो महा नदी को तट वालो रहोबोत नगर को होतो ऊ ओकी जागा पर राजा भयो।<verse eid="GEN 36:37" /></para>
  <para style="li1">
    <verse number="38" style="v" sid="GEN 36:38" />शाऊल को मरनो पर अकबोर को टुरा बाल्हानान ओकी जागा पर राजा भयो।<verse eid="GEN 36:38" /></para>
  <para style="li1">
    <verse number="39" style="v" sid="GEN 36:39" />अकबोर को टुरा बाल्हानान को मरनो पर</para>
  <para style="li1" vid="GEN 36:39">हदर ओकी जागा पर राजा भयो : अऊर ओकी राजधानी को नाम पाऊ हय; अऊर ओकी पत्नी को नाम महेतबेल हय, जो मेजाहब की नातिन अऊर मत्रेद की टुरी होती।<verse eid="GEN 36:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />एसाव को वंशजों को मुखिया को कुलों अऊर जागा को अनुसार उन्को नाम हि आय : तिम्रा, अल्बा, यतेत मुखिया, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />ओहोलीबामा, एला, पीनोन मुखिया, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />कनज, तेमान, मिबसार मुखिया, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />मग्दीएल, ईराम : एदोम वंशियों न जो देश अपनो कर लियो होतो, ओकी निवास की जागा म उन्को हिच मुखिया भयो; एदोम जाति को मूल आदमी एसाव हय।<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">यूसुफ अऊर ओको भाऊ</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />याकूब त कनान देश म रहत होतो, जित ओको बाप परदेशी होय क रहत होतो। <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />याकूब को वंश को वृत्तान्त यो हय।</para>
  <para style="p" vid="GEN 37:2">यूसुफ सत्रा साल को होय क अपनो भाऊवों को संग शेरी मेंढी ख चरावत होतो; अऊर ऊ लड़का अपनो बाप की पत्नी बिल्हा अऊर जिल्पा को टुरावों को संग रह्यो करत होतो; अऊर उन्की बुरायियों को समाचार अपनो बाप को जवर बतायो करत होतो।<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />याकूब<note caller="+" style="f"><char style="fr" closed="false">37:3 </char><char style="ft" closed="false">इस्राएल</char></note> अपनो सब टुरावों सी बढ़ क् यूसुफ सी प्रेम रखत होतो, कहालीकि ऊ ओको बूढ़ापा को टुरा होतो : अऊर ओन ओको लायी एक रंगबिरंगी कपड़ा बनवायो। <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />पर जब ओको भाऊवों न देख्यो कि हमरो बाप हम सब भाऊवों सी जादा ओको सीच प्रेम रखय हय, तब हि ओको सी घृना करन लग्यो अऊर ओको संग ठीक सी बात भी नहीं करत होतो।<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />यूसुफ न एक सपनो देख्यो, अऊर अपनो भाऊवों सी ओको बारे म बतायो; तब हि ओको सी अऊर भी जादा घृना करन लग्यो। <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />यूसुफ न उन्को सी कह्यो, “जो सपनो मय न देख्यो हय, ओख सुनो : <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />हम लोग खेत म गहूं को बोझा बान्ध रह्यो हय, अऊर यो देख्यो कि अचानक मोरो बोझा उठ क सीधो खड़ो भय गयो; तब तुम्हरो बोझा न मोरो बोझा ख चारयी तरफ सी घेर लियो अऊर ओख दण्डवत करयो।”<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />तब यूसुफ को भाऊवों न यूसुफ सी कह्यो, “का सचमुच तय हमरो ऊपर राज्य करजो? या का सचमुच तय हम पर प्रभुता करजो?” येकोलायी हि ओको सपनो अऊर ओकी बातों को वजह ओको सी अऊर भी जादा घृना करन लग्यो।<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />तब यूसुफ न अऊर एक सपनो देख्यो, अऊर अपनो भाऊवों ख सपनो को बारे म बतायो, “सुनो, मय न एक अऊर सपनो देख्यो हय, कि सूरज अऊर चन्दा अऊर ग्यारा तारा मोख दण्डवत कर रह्यो हय।”<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />यो सपनो ओन अपनो बाप अऊर अपनो भाऊवों ख बतायो तब ओको बाप न ओख चिल्लाय क कह्यो, “यो कसो सपनो आय जो तय न देख्यो हय? का सचमुच मय अऊर तोरी माय अऊर तोरो भाऊ सब जाय क तोरो आगु जमीन पर गिर क दण्डवत करबो?” <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" /><note caller="+" style="x"><char style="xo" closed="false">37:11 </char><char style="xt" closed="false"><ref loc="ACT 7:9">प्रेरितों 7:9</ref></char></note>ओको भाऊ ओको सी घृना करत होतो; पर ओको बाप न ओको ऊ बातों ख याद रख्यो।<verse eid="GEN 37:11" /></para>
  <para style="s">यूसुफ को बेच्यो जानो अऊर ओख मिस्र म ले जानो</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />ओको भाऊ अपनो बाप की शेरी मेंढी ख चरान लायी शकेम नगर ख गयो। <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />तब याकूब न यूसुफ सी कह्यो, “तोरो भाऊ शकेम मच शेरी मेंढी चराय रह्यो होना। येकोलायी जा, मय तोख उन्को जवर भेजू हय।”</para>
  <para style="p" vid="GEN 37:13">ओन उन्को सी कह्यो, “जो आज्ञा मय हाजिर हय।”<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />ओन ओको सी कह्यो, “जा, अपनो भाऊवों अऊर शेरी मेंढियों को हाल देख क आव कि हि अच्छो सी त हय, तब मोरो जवर समाचार ले आव।” तब ओन ओख हेब्रोन की घाटी म बिदा कर दियो,</para>
  <para style="p" vid="GEN 37:14">अऊर यूसुफ शकेम म आयो। <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />अऊर एक आदमी न ओख मैदान म इत उत भटकतो हुयो देख क ओको सी पुच्छ्यो, “तय का ढूंढय हय?”<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />ओन कह्यो, “मय अपनो भाऊवों ख ढूंढु हय। कृपया मोख बता कि हि शेरी मेंढियों ख कित चराय रह्यो हंय?”<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />ऊ आदमी न कह्यो, “हि इत सी चली गयो हय; अऊर मय न उन्ख यो कहतो सुन्यो, ‘आवो, हम दोतान नगर ख चलबो’।” येकोलायी यूसुफ अपनो भाऊवों को पीछू चल्यो, अऊर उन्ख दोतान नगर म पायो।<verse eid="GEN 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 37:18" />ओको भाऊवों न ओख दूर सी आतो हुयो देख्यो, त ओको जवर आन कोच पहिले ओख मार डालन की साजीश रची। <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />अऊर हि आपस म कहन लग्यो, “देखो, ऊ सपनो देखन वालो आय रह्यो हय। <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />येकोलायी आवो, हम ओख मार क कोयी गड्डा म डाल देबो; अऊर यो कह्य देबो कि कोयी जंगली जनावर ओख खाय गयो। तब हम देखबोंन कि ओको सपनो भविष्य म कसो पूरो होवय हंय।”<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />यो सुन क रूबेन न यूसुफ ख उन्को हाथ सी बचान को बिचार सी कह्यो, “हम ओख जान सी त नहीं मारबो।” <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />तब रूबेन न उन्को सी कह्यो, “खून मत बहावों, ओख जंगल को यो गड्डा म डाल देवो, अऊर ओको पर हाथ मत उठावों।” रूबेन ओख उन्को हाथ सी छुड़ाय क बाप को जवर फिर पहुंचानो चाहत होतो। <verse eid="GEN 37:22" /><verse number="23" style="v" sid="GEN 37:23" />येकोलायी असो भयो कि जब यूसुफ अपनो भाऊवों को जवर पहुंच्यो तब उन्न ओको रंगबिरंगी को कपड़ा देख्यो, जेक ओन पहिन्यो होतो, उन्न उतार लियो; <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />अऊर यूसुफ ख उठाय क गड्डा म डाल दियो। ऊ गड्डा सुख्यो होतो अऊर ओको म कुछ भी पानी नहीं होतो।<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />तब हि रोटी खान ख बैठ गयो; अऊर आंखी उठाय क यो देख्यो कि इश्माएलियों को एक दल ऊंटों पर सुगन्ध की चिज, बलसान, अऊर गन्धरस टंगाय क, गिलाद सी मिस्र देश ख जाय रह्यो होतो। <verse eid="GEN 37:25" /><verse number="26" style="v" sid="GEN 37:26" />तब यहूदा न अपनो भाऊवों सी कह्यो, “अपनो भाऊ ख मार डालनो सी अऊर ओको खून लुकानो सी का फायदा होयेंन? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />आवो, हम ओख इश्माएलियों को हाथ बेच देबो, अऊर अपनो हाथ ओको पर नहीं उठाबो; कहालीकि ऊ हमरो भाऊ अऊर हमारीच हड्डी अऊर मास आय।” अऊर ओको भाऊवों न ओकी बात मान ली। <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />तब मिद्यानी व्यापारी उत सी होय क उन्को जवर पहुंच्यो। तब यूसुफ को भाऊवों न ओख ऊ गड्डा म सी खीच क् बाहेर निकाल्यो, अऊर इश्माएलियों को हाथ चांदी को बीस सिक्का म बेच दियो; अऊर हि यूसुफ ख मिस्र देश ले गयो।<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />जब रूबेन गड्डा को तरफ गयो अऊर यो देख्यो कि यूसुफ गड्डा म नहाय; येकोलायी ओन अपनो कपड़ा फाड़्यो, <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />अऊर अपनो भाऊवों को जवर जाय क कहन लग्यो, “लड़का त गड्डा म नहाय; अब मय कित जाऊं?”<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />तब उन्न यूसुफ को कपड़ा लियो, अऊर एक बकरा ख मार क् ओको खून म ओख डुबाय दियो। <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />अऊर उन्न ऊ रंगबिरंगी कपड़ा ख अपनो बाप को जवर यो कह्य क भेज दियो, “यो हम्ख मिल्यो हय, तय देख क पहिचान ले कि यो तोरो टुरा को कपड़ा आय या नोहोय।”<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />ओन ओख पहिचान लियो अऊर कह्यो, “हव, यो मोरोच टुरा को कपड़ा आय; कोयी दुष्ट जनावर न ओख खाय लियो हय; सही मच यूसुफ ख तुकड़ा तुकड़ा कर दियो गयो हय।” <verse eid="GEN 37:33" /><verse number="34" style="v" sid="GEN 37:34" />तब याकूब न अपनो कपड़ा फाड़्यो अऊर कमर म टाट को कपड़ा गुन्ड क, अऊर अपनो टुरा लायी बहुत दिनों तक दु:ख मनातो रह्यो। <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />ओको सब टुरा टुरियों न ओख शान्ति देन की बहुत कोशिश करी; पर ओख शान्ति नहीं मिली; अऊर ऊ योच कहतो रह्यो, “मय त दु:ख करतो हुयो अपनो टुरा को जवर मरयो हुयो कि दुनिया म उतर जाऊं।” यो तरह ओको बाप ओको लायी रोतोच रह्यो।<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />तब येको बाद मिद्यानियों न यूसुफ ख मिस्र म लिजाय क पोतीपर नाम को फिरौन को एक हाकिम अऊर अंगरक्षकों को प्रधान को बेच डाल्यो।<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">यहूदा अऊर ओकी बहू तामार</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />उन दिनों म असो भयो कि यहूदा अपनो भाऊवों को जवर सी चली गयो, अऊर हीरा नाम को एक अदुल्लाम नगर को एक निवासी को जवर रहन लग्यो। <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />उत यहूदा न शूआ नाम को एक कनानी आदमी की टुरी ख देख्यो; अऊर ओको सी बिहाव कर क् ओको जवर गयो। <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />वा गर्भवती भयी, अऊर ओको एक टुरा पैदा भयो; अऊर यहूदा न ओको नाम एर रख्यो। <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />वा फिर गर्भवती भयी, अऊर ओको एक टुरा अऊर पैदा भयो, अऊर ओको नाम ओनान रख्यो गयो। <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />तब ओख अऊर एक टुरा पैदा भयो, अऊर ओको नाम शेला रख्यो गयो; अऊर जो समय येको जनम भयो ऊ समय यहूदा कजीब नगर म रहत होतो।<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />अऊर यहूदा न तामार नाम की एक लड़की सी अपनो बड़ो टुरा एर को बिहाव कर दियो। <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />पर यहूदा को ऊ बड़ो टुरा एर यहोवा की नजर म बुरो होतो, येकोलायी यहोवा न ओख मार डाल्यो। <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />तब यहूदा न ओनान सी कह्यो, “तय अपनी भाभी को जवर जा, अऊर ओको संग देऊर को धर्म पूरो कर क् अपनो भाऊ लायी सन्तान पैदा कर।” <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />ओनान जानत होतो कि सन्तान मोरी नहीं होयेंन; येकोलायी असो भयो कि जब ऊ अपनी भाभी को जवर गयो, तब ओन जमीन पर वीर्य गिराय क नाश करयो, जेको सी असो नहीं होय कि ओको भाऊ को नाम सी वंश चले। <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />यो काम जो ओन करयो परमेश्वर की नजर म बुरो होतो; अऊर परमेश्वर न ओख मार डाल्यो। <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />तब यहूदा न यो डर को मारे कि कही असो नहीं होय कि अपनो भाऊवों को जसो शेला भी मरे, अपनी बहू तामार सी कह्यो, “जब तक मोरो टुरा शेला जवान नहीं होय जाये तब तक अपनो बाप को घर म विधवाच बैठी रह्य।” येकोलायी तामार अपनो बाप को घर म जाय क रहन लगी।<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />बहुत समय को बीतन पर यहूदा की पत्नी जो शूआ की टुरी होती, वा मर गयी; तब यहूदा दु:ख को दिन बितन पर अपनो संगी हीरा अदुल्लामवासी सहीत अपनी शेरी मेंढियों को ऊन कतरन वालो को जवर तिम्नाथ नगर ख गयो। <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />अऊर तामार ख यो समाचार मिल्यो, “तोरो ससरो अपनी शेरी मेंढियों को ऊन काटन लायी तिम्नाथ नगर ख जाय रह्यो हय।” <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />तब ओन यो सोच क कि शेला जवान त होय गयो पर मय ओकी पत्नी नहीं होय सकी; अपनो विधवापन को कपड़ा उतारयो अऊर घूंघट डाल क अपनो ख झाक लियो, अऊर एनैम नगर की फाटक को जवर, जो तिम्नाथ की रस्ता म हय, वहां जाय बैठी।<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />जब यहूदा न ओख देख्यो, त ओख ओन वेश्या समझ्यो; कहालीकि ओन अपनो मुंह झाक्यो हुयो होतो। <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />ऊ रस्ता सी ओको तरफ मुड़्यो, अऊर ओको सी कहन लग्यो, “मोख अपनो जवर आन दे,” कहालीकि ओख यो मालूम नहीं होतो कि वा ओकी बहू आय।</para>
  <para style="p" vid="GEN 38:16">ओन कह्यो, “यदि मय तोख अपनो जवर आन देऊ, त तय मोख का देजो?”<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />ओन कह्यो, “मय अपनी शेरियों म सी शेरी को बच्चा तोरो जवर भेज देऊं।”</para>
  <para style="p" vid="GEN 38:17">तब ओन कह्यो, “तब तक का तय मोरो जवर कुछ चीज रख दे?”<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />यहूदा न पुच्छ्यो, “मय तोरो जवर का चिज रख देऊ?”</para>
  <para style="p" vid="GEN 38:18">तामार न कह्यो, “अपनी मुहर, अऊर बाजूबन्द, अऊर अपनो हाथ को डन्डा।” तब यहूदा न ओख सब चीज दे दी, अऊर ओको जवर गयो, अऊर वा ओको सी गर्भवती भयी। <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />तब वा उठ क चली गयी, अऊर अपनो घूंघट उतार क् अपनो विधवापन को कपड़ा फिर पहिन्यो।<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />तब यहूदा न शेरी को एक बच्चा अपनो संगी ऊ अदुल्लामवासी को हाथ भेज दियो कि जो चिज रखी हुयी चिज वा बाई को हाथ सी छुड़ाय क ले आये; पर वा बाई ओख नहीं मिली। <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />तब हीरा न उत को लोगों सी पुच्छ्यो, “वा वेश्या जो एनैम म रस्ता को एक तरफ बैठी होती, कित हय?” उन्न कह्यो,</para>
  <para style="p" vid="GEN 38:21">“यहां त कोयी वेश्या नहीं होती।”<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />येकोलायी ओन यहूदा को जवर जाय क कह्यो, “मोख वा नहीं मिली; अऊर ऊ जागा को लोगों न कह्यो, यहां त कोयी वेश्या नहीं होती।”<verse eid="GEN 38:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 38:23" />तब यहूदा न कह्यो, “अच्छा, वा निशानी कि चिज ओकोच जवर रहन दे, नहीं त हम लोग बेकार गिन्यो जाबो; देख, मय न शेरी को यो बच्चा भेज दियो होतो, पर वा तोख नहीं मिली।”<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />लगभग तीन महिना को बाद यहूदा ख यो समाचार मिल्यो, “तोरी बहू तामार न व्यभिचार करयो हय; अऊर वा व्यभिचार सी गर्भवती भी भय गयी हय।”</para>
  <para style="p" vid="GEN 38:24">तब यहूदा न कह्यो, “ओख बाहेर ले क जावो कि ओख जलायो जाये।”<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />जब लोग ओख बाहेर निकाल रह्यो होतो तब ओन अपनो ससरो को जवर यो सन्देश भेज्यो, “जो आदमी की या चिजे हय, ओकोच सी मय गर्भवती भयी,” तब ओन यो कह्यो, “पहिचानो त सही कि यो मुहर, अऊर बाजूबन्द, अऊर डन्डा कोन्को आय।”<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />यहूदा न उन्ख पहिचान क कह्यो, “ऊ त मोरो सी कम दोषी हय; कहालीकि मय न ओको अपनो टुरा शेला सी बिहाव नहीं करयो।” अऊर ओन ओको सी फिर कभी सहवास नहीं करयो।<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />जब ओको बच्चा पैदा करन को समय आयो, तब यो जान पड़्यो कि ओको गर्भ म जुड़वा बच्चा हय। <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />अऊर जब वा बच्चा पैदा करन लगी तब एक बच्चा को हाथ बाहेर आयो, अऊर सुईन न लाल सूत ले क ओको हाथ म यो कहतो हुयो बान्ध दियो, “पहिले योच पैदा भयो।” <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />जब बच्चा न अपनो हाथ अन्दर कर लियो, तब ओको भाऊ पैदा भयो। तब वा सुईन न कह्यो, “तय कहाली खुदच निकलन की रस्ता बनाय लियो?” येकोलायी ओको नाम पेरेस<note caller="+" style="f"><char style="fr" closed="false">38:29 </char><char style="ft" closed="false">फूट पड़नो</char></note> रख्यो गयो। <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />पीछू ओको भाऊ जेको हाथ म लाल सूत बन्ध्यो होतो ऊ पैदा भयो, अऊर ओको नाम जेरह<note caller="+" style="f"><char style="fr" closed="false">38:30 </char><char style="ft" closed="false">चमक</char></note> रख्यो गयो।<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">यूसुफ अऊर पोतीपर की पत्नी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />जब यूसुफ मिस्र देश म पहुंचायो गयो, तब पोतीपर नाम को एक मिस्री न जो फिरौन को हाकिम अऊर अंगरक्षकों को प्रधान होतो, ओख इश्माएलियों को हाथ सी, जो ओख उत ले गयो होतो, लेय लियो। <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" /><note caller="+" style="x"><char style="xo" closed="false">39:2 </char><char style="xt" closed="false"><ref loc="ACT 7:9">प्रेरितों 7:9</ref></char></note>यूसुफ अपनो मिस्री स्वामी को घर म रहत होतो, अऊर यहोवा ओको संग होतो येकोलायी ऊ भाग्यवान आदमी भय गयो, <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />अऊर यूसुफ को स्वामी न देख्यो कि यहोवा ओको संग रह्य हय, अऊर जो काम ऊ करय हय ओख यहोवा ओको हाथ सी सफल कर देवय हय। <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />तब पोतीपर की अनुग्रह की नजर ओको पर भयी, अऊर यूसुफ ओकी सेवा म लगन लायी चुन्यो गयो; तब ओन ओख अपनो घर को अधिकारी बनान लायी अपनो सब कुछ यूसुफ को हाथ म सौंफ दियो। <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />सब सी ओन ओख अपनो घर को अऊर अपनी पूरी जायजाद को अधिकारी बनायो, तब सी यहोवा यूसुफ को वजह ऊ मिस्री को घर पर आशीष देन लग्यो; अऊर का घर म, का खेत म, ओको जो कुछ होतो सब पर यहोवा की आशीष होन लगी। <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />येकोलायी ओन अपनो सब कुछ यूसुफ को हाथ म यहां तक कि अपनो खान की रोटी ख छोड़, ऊ अपनी जायजाद को हाल कुछ नहीं जानत होतो।</para>
  <para style="p" vid="GEN 39:6">यूसुफ सुन्दर अऊर रूपवान होतो। <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />इन बातों को बाद असो भयो कि ओको स्वामी की पत्नी न यूसुफ को तरफ देख्यो अऊर कह्यो, “मोरो संग सो।” <verse eid="GEN 39:7" /><verse number="8" style="v" sid="GEN 39:8" />पर ओन मना करतो हुयो अपनो स्वामी की पत्नी सी कह्यो, “सुन, जो कुछ यो घर म हय मोरो हाथ म हय; ओख मोरो स्वामी कुछ नहीं जानय, अऊर ओन अपनो सब कुछ मोरो हाथ म सौंप दियो हय। <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />यो घर म मोरो सी बड़ो कोयी नहीं, अऊर ओन तोख छोड़, जो ओकी पत्नी आय, मोरो सी कुछ नहीं रख छोड़्यो, येकोलायी भला, मय असो बड़ो पाप कर क् परमेश्वर को अपराधी कहाली बनू?” <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />अऊर असो भयो कि वा हर दिन यूसुफ सी बात करती रही, पर ओन ओकी नहीं मानी कि ओको जवर सोये या ओको संग रहे।<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />एक दिन का भयो कि यूसुफ अपनो काम काज करन लायी घर म गयो, अऊर घर को सेवकों म सी कोयी भी घर को अन्दर नहीं होतो। <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />तब वा बाई न ओको कपड़ा पकड़ क कह्यो, “मोरो संग सो,” पर ऊ अपनो कपड़ा ओको हाथ म छोड़ क भग्यो अऊर बाहेर निकल गयो। <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />यो देख क कि यूसुफ अपनो कपड़ा मोरो हाथ म छोड़ क बाहेर भग गयो, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />तब वा बाई न अपनो घर को सेवकों ख बुलाय क कह्यो, “देखो, ऊ एक इब्री आदमी ख मोरो स्वामी मोरो अपमान करन लायी मोरो जवर लायो हय। ऊ त मोरो संग सोवन को मतलब सी मोरो जवर अन्दर आयो होतो, अऊर मय ऊची आवाज सी चिल्लाय उठी; <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />अऊर मोरो चिल्लावन को वजह सी ऊ अपनो कपड़ा मोरो जवर छोड़ क भग्यो, अऊर बाहेर निकल गयो।”<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />अऊर वा ओको कपड़ा अपनो स्वामी को घर आवत तक अपनो जवर रखी रही। <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />तब ओन अपनो स्वामी सी यो तरह की बाते कही, “ऊ इब्री दास जेक तय मोरो जवर ले आयो हय, ऊ मोरो अपमान करन लायी मोरो जवर आयो होतो; <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />अऊर जब मय ऊची आवाज सी चिल्लाय उठी, तब ऊ अपनो कपड़ा छोड़ क बाहेर भग गयो।”<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />अपनी पत्नी की हि बाते सुन क कि तोरो दास न मोरो संग असो असो काम करयो, यूसुफ को स्वामी को गुस्सा भड़क्यो। <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" /><note caller="+" style="x"><char style="xo" closed="false">39:20 </char><char style="xt" closed="false"><ref loc="PSA 105:18">भजन 105:18</ref></char></note>अऊर यूसुफ को स्वामी न ओख पकड़ क जेलखाना म, डलवाय दियो; जित राजा को कैदी बन्द होतो, तब यूसुफ भी ऊ जेलखाना म रह्यो। <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" /><note caller="+" style="x"><char style="xo" closed="false">39:21 </char><char style="xt" closed="false"><ref loc="ACT 7:9">प्रेरितों 7:9</ref></char></note>पर परमेश्वर यूसुफ को संग संग रह्यो अऊर ओको पर दया करी, अऊर जेलखाना को दरोगा की अनुग्रह की नजर ओको पर भयी। <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />येकोलायी जेलखाना को दरोगा न उन सब बन्दियों ख, जो जेलखाना म होतो, यूसुफ को हाथ म सौंप दियो; अऊर जो जो काम हि वहां करत होतो, ऊ काम ओकीच आज्ञा सी होत रह्य। <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />यूसुफ को वश म जो कुछ होतो ओको म सी जेलखाना को दरोगा ख कोयी भी चिज देखनी नहीं पड़त होती; कहालीकि यहोवा यूसुफ को संग होतो; अऊर जो कुछ ऊ करत होतो, यहोवा ओख ओको म सफल बनावत होतो।<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">बन्धियों को सपनो को अर्थ बतानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />इन बातों को बाद असो भयो, कि मिस्र देश को राजा को पिलान वालो अऊर जेवन बनान वालो न अपनो स्वामी को खिलाफ कुछ अपराध करयो। <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />तब फिरौन न अपनो उन दोयी हाकिमों, मतलब पिलान वालो को प्रधान अऊर जेवन बनान वालो को प्रधान, दोयी पर गुस्सा होय क <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />उन्ख कैद कराय क् अंगरक्षकों को प्रधान को घर को जेलखाना म, जित यूसुफ बन्दी होतो, उन्ख उत डलवाय दियो। <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />तब अंगरक्षकों को प्रधान न उन्ख यूसुफ को हाथ सौंप्यो, अऊर ऊ उन्की सेवा करन लग्यो; तब हि कुछ दिन तक जेलखाना म रह्यो।<verse eid="GEN 40:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 40:5" />मिस्र को राजा फिरौन को पिलान वालो अऊर जेवन बनान वालो, जेलखाना म बन्द होतो, उन दोयी न एकच रात म, अपनो सपनो देख्यो अऊर दोयी को सपनो को विशेष अर्थ अलग अलग होतो। <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />सुबेरे जब यूसुफ उन्को जवर अन्दर गयो, तब उन पर ओन नजर डाली त ओन देख्यो कि हि उदास हंय। <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />येकोलायी ओन फिरौन को उन हाकिमों सी, जो ओको संग ओको स्वामी को घर को जेलखाना म होतो, पुच्छ्यो, “अज तुम्हरो मुंह कहाली उदास हंय?”<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />उन्न यूसुफ सी कह्यो, “हम दोयी न सपनो देख्यो हय, अऊर उन्को सपनो को अर्थ बतावन वालो कोयी भी नहाय।” यूसुफ न उन्को सी कह्यो,</para>
  <para style="p" vid="GEN 40:8">“का सपनो को अर्थ बतानो केवल परमेश्वर को काम नहाय? मोख अपनो अपनो सपनो बतावो।”<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />तब पिलान वालो को प्रधान अपनो सपनो यूसुफ ख बतावन लग्यो: “सपनो म देख्यो कि मोरो आगु एक अंगूर को गुच्छा हय। <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />अऊर वा अंगूर की बेला म तीन डगालियां हय; अऊर असो लगय हय कि ओको म कलियां लगी हंय, अऊर हि फूलीं अऊर ओको गुच्छा म अंगूर लग क पक गयी हय। <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />फिरौन को कटोरा मोरो हाथ म होतो; अऊर मय न उन अंगूरो ख ले क फिरौन को कटोरा म पिरयो, अऊर कटोरा ख फिरौन को हाथ म दियो।”<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />तब यूसुफ न ओको सी कह्यो, “यो तोरो सपनो को अर्थ आय : तीन डगालियों को अर्थ तीन दिन हंय; <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />येकोलायी अब सी तीन दिन को अन्दर फिरौन तोरो सिर ऊचो करेंन, अऊर फिर सी तोरो पद पर तोख नियुक्त करेंन, अऊर तय पहिले को जसो फिरौन को पिलान वालो बन क ओको कटोरा ओको हाथ म फिर सी दियो करजो। <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />फिर जब तोरो भलो होय जाये तब मोख याद करजो, अऊर मोरो पर दया कर क् फिरौन सी मोरी चर्चा करजो, अऊर यो जेलखाना सी मोख छुड़ाय देजो। <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />कहालीकि सचमुच इब्रानियों को देश सी मोख चोर क लायो गयो हय; अऊर यहां भी मय न कोयी असो काम नहीं करयो, जेको वजह मय यो जेलखाना म डाल्यो जाऊं।”<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />यो देख क कि ओको सपनो को अर्थ अच्छो हय, तब जेवन बनान वालो को प्रधान न यूसुफ सी कह्यो, “मय न भी सपनो देख्यो हय, ऊ यो आय : मय न देख्यो कि मोरी मुंड पर सफेद रोटी की तीन टोपलियां हंय; <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />अऊर ऊपर की टोपली म फिरौन लायी सब तरह की पकी पकायी चिजे हंय; अऊर पक्षी मोरी मुंड पर की टोपली म सी उन चिजे ख खाय रही हंय।”<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />यूसुफ न कह्यो, “तोरो सपनो को अर्थ यो हय : हि तीन टोपलियों को अर्थ तीन दिन हय। <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />अब सी तीन दिन को अन्दर फिरौन तोरी मुंड कटवाय क तोख एक खम्भा पर टंगाय देयेंन, अऊर पक्षी तोरो मांस ख तिड़ तिड़ क खायेंन।”<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />तीसरो दिन फिरौन को जनम दिन होतो, ओन अपनो सब कर्मचारियों ख जेवन दियो, अऊर उन्म सी पिलान वालो को प्रधान अऊर जेवन बनान वालो को प्रधान हि दोयी ख जेलखाना म सी निकलवायो। <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />पिलान वालो को प्रधान ख त पिलान वालो को पद पर फिर सी नियुक्त करयो, अऊर ऊ फिरौन को हाथ म कटोरा देन लग्यो। <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />पर जेवन बनान वालो को प्रधान ख ओन टंगाय दियो, जसो कि यूसुफ न ओको सपनो को अर्थ ओन कह्यो होतो। <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />तब भी पिलान वालो को प्रधान न यूसुफ ख याद नहीं रख्यो; पर ओख भूल गयो।<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">यूसुफ न फिरौन राजा को सपनो को अर्थ बतायो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />पूरो दोय साल बीतन पर फिरौन न यो सपनो देख्यो कि ऊ नील नदी को किनारे खड़ो हय। <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />अऊर वा नील नदी म सी सात सुन्दर अऊर मोटी मोटी गाय निकल क नदी किनारे घास चरन लगी। <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />अऊर, ओन देख्यो कि उन्को पीछू अऊर सात गाय, जो बदसुरत अऊर कमजोर हंय, नील नदी सी निकली, अऊर दूसरी गायों को जवर नील नदी को किनार पर जाय क खड़ी भयी। <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />तब हि बदसूरत अऊर कमजोर गाये उन सात सुन्दर अऊर मोटी मोटी गायों ख खाय गयी। तब फिरौन जग गयो। <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />अऊर ऊ फिर सोय गयो अऊर दूसरो सपनो देख्यो कि <note caller="+" style="f"><char style="fr" closed="false">41:5 </char><char style="ft" closed="false">बाजरा को ढांडा</char></note>डंठल म सी सात मोटी अऊर अच्छी अच्छी <note caller="+" style="f"><char style="fr" closed="false">41:5 </char><char style="ft" closed="false">बाजरा की सात लोम्ब</char></note>बालें निकली। <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />अऊर, देख्यो कि पूर्व की हवा सी सात लोम्ब पतली अऊर मुरझायी हुयी निकली। <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />अऊर इन पतली लोम्ब न उन सातों मोटी अऊर अनाज सी भरी हुयी लोम्ब ख खाय लियो। तब फिरौन जाग्यो, अऊर ओख मालूम भयो कि यो सपनोच होतो। <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" /><note caller="+" style="x"><char style="xo" closed="false">41:8 </char><char style="xt" closed="false"><ref loc="DAN 2:2">दानिय्येल 2:2</ref></char></note>सुबेरे फिरौन को मन चिन्तित भयो अऊर ओन मिस्र को सब तान्त्रिकों अऊर जानकार लोगों ख बुलावा भेज्यो; अऊर उन्ख अपनो सपनो बतायो; पर उन्म सी कोयी भी ओको अर्थ नहीं बताय सक्यो।<verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />तब पिलान वालो को प्रधान न फिरौन सी कह्यो, “मोरो अपराध अज मोख याद आयो। <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />जब फिरौन अपनो दासों सी गुस्सा भयो होतो, तब मोख अऊर जेवन बनान वालो को प्रधान ख कैद कराय क् अंगरक्षकों को प्रधान को घर को जेलखाना म डाल दियो होतो; <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />तब हम दोयी न एकच रात म सपनो देख्यो अऊर ऊ सपनो को अर्थ अलग अलग होतो। <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />वहां हमरो संग एक इब्री जवान होतो, जो अंगरक्षकों को प्रधान को दास होतो; तब हम न ओख अपनो अपनो सपनो बतायो अऊर ओन हमरो सपनो को अर्थ हम्ख बतायो, हम म सी एक एक को सपनो को अर्थ ओन बताय दियो। <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />अऊर जसो जसो अर्थ ओन बतायो होतो, वसोच भयो भी, यानेकि मोख त मोरो पद फिर मिल्यो, पर ऊ फासी पर लटकायो गयो।”<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />तब फिरौन न यूसुफ ख बुलायो; अऊर ऊ तुरतच जेलखाना सी बाहेर निकाल्यो गयो, अऊर बाल बनाय क अऊर कपड़ा बदल क फिरौन को आगु आयो। <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />फिरौन न यूसुफ सी कह्यो, “मय न एक सपनो देख्यो हय, अऊर ओको अर्थ बतावन वालो कोयी भी नहाय; अऊर मय न तोरो बारे म सुन्यो हय कि तय सपनो सुनतोच ओको अर्थ बताय देवय हय।”<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />यूसुफ न फिरौन सी कह्यो, “मय त कुछ भी नहीं जानु हय, पर परमेश्वरच फिरौन लायी शुभ वचन देयेंन।”<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />तब फिरौन यूसुफ सी कहन लग्यो, “मय न अपनो सपनो म देख्यो कि मय नील नदी को किनारे खड़ो हय। <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />फिर देख्यो, कि नील नदी म सी सात मोटी अऊर सुन्दर सुन्दर गाय निकल क घास चरन लगी। <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />तब अऊर देख्यो, कि उन्को पीछू सात अऊर गाय निकली, जो पतली अऊर बहुत छोटी अऊर कमजोर हंय; मय न पूरो मिस्र देश म असी बदसूरत गाय कभी नहीं देख्यो। <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />इन कमजोर अऊर बदसूरत गायों न उन पहिली सातों मोटी मोटी गायों ख खाय लियो; <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />अऊर जब हि उन्ख खाय गयी तब यो मालूम नहीं होत रह्य कि हि उन्ख खाय गयी हंय, कहालीकि हि पहिले को जसो जसी की वसी बदसूरत रही। तब मय जग गयो। <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />तब मय न दूसरो सपनो देख्यो, कि एकच डंठल म सात अच्छी अच्छी अऊर अनाज सी भरी हुयी लोम्ब निकली। <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />तब देखू हय, कि उन्को पीछू अऊर सात मुरझायी, पतली, अऊर पूर्व की हवा सी सुखी हुयी लोम्ब निकली। <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />अऊर इन पतली लोम्ब न उन सात अच्छी अच्छी लोम्ब ख खाय लियो। येख मय न तान्त्रिकों ख बतायो, पर येको अर्थ बतावन वालो कोयी नहीं मिल्यो।”<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />तब यूसुफ न फिरौन सी कह्यो, “तोरो सपनो का एकच हय, परमेश्वर जो काम करनो चाहवय हय, ओख ओन फिरौन पर दरसायो हय। <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />हि सात अच्छी अच्छी गाय सात साल हंय; अऊर हि सात अच्छी अच्छी लोम्ब भी सात साल हंय; यो तरह सी सपनो एकच आय। <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />तब उन्को पीछू जो कमजोर अऊर गरीब गाय निकली, अऊर जो सात सुखी अऊर पूर्व की हवा सी मुरझायी हुयी लोम्ब निकाली, हि अकाल को सात साल होयेंन। <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />या वाच बात आय जो मय फिरौन सी कह्य चुक्यो हय कि परमेश्वर जो काम करनो चाहवय हय, ओख ओन फिरौन ख दिखायो हय। <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />सुन, असो सात साल आयेंन जब पूरो मिस्र देश म बहुत तरह सी अनाज पैदा होयेंन। <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />उन्को बाद सात साल अकाल को आयेंन, अऊर पूरो मिस्र देश म लोग हि पूरी उपज ख भूल जायेंन; अऊर अकाल सी देश को नाश होयेंन। <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />अऊर अकाल इतनो भयानक होयेंन कि अच्छी फसल अऊर उपज कोयी ख याद तक नहीं रहेंन। <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />अऊर फिरौन न जो यो सपनो दोय बार देख्यो हय येको भेद योच आय कि यो बात परमेश्वर को तरफ सी नियुक्त होय गयी हय, अऊर परमेश्वर येख जल्दीच पूरो करेंन।<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />“येकोलायी अब फिरौन कोयी समझदार अऊर बुद्धिमान आदमी ख ढूंढ क ओख मिस्र देश पर प्रधान मन्त्री ठहरायो। <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />अऊर फिरौन पूरो मिस्र देश म अधिकारियों ख ठहराये, अऊर सात साल जो अच्छी फसल अऊर उपज को हंय ऊ समय जमीन की उपज को पाचवों भाग लियो करे। <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />अऊर तब अच्छी फसल को सात सालों म सब तरह की खान की चिज जमा करे, अऊर नगर नगर म जेवन लायी अनाज को भण्डार घर खोले अऊर अनाज की रक्षा करे। <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />या जेवन की चिज अकाल को उन सात सालों लायी हंय, जो मिस्र देश म आयेंन, देश को जेवन लायी रखी हय, जेको सी देश को ऊ अकाल सी सत्यानाश नहीं हो जाये।”<verse eid="GEN 41:36" /></para>
  <para style="s">यूसुफ को प्रधान मन्त्री बनायो जानो</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />यो बात फिरौन अऊर ओको पूरो अधिकारियों ख अच्छी लगी। <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />येकोलायी फिरौन न अपनो अधिकारियों सी कह्यो, “का हम ख असो आदमी मिल सकय हय, जसो यो हय अऊर जेको म परमेश्वर की आत्मा रह्य हय।” <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />तब फिरौन न यूसुफ सी कह्यो, “परमेश्वर न जो तोख इतनो ज्ञान दियो हय कि तोरो जसो कोयी समझदार अऊर बुद्धिमान नहीं; <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" /><note caller="+" style="x"><char style="xo" closed="false">41:40 </char><char style="xt" closed="false"><ref loc="ACT 7:10">प्रेरितों 7:10</ref></char></note>यो वजह तय मोरो घर को अधिकारी होयजो, अऊर तोरी आज्ञा को अनुसार मोरी पूरी प्रजा चलेंन, केवल राजगद्दी को बारे म मय तोरो सी बड़ो रहूं।” <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" /><note caller="+" style="x"><char style="xo" closed="false">41:41 </char><char style="xt" closed="false"><ref loc="PSA 105:21">भजन 105:21</ref>; <ref loc="ACT 7:10">प्रेरितों 7:10</ref></char></note>तब फिरौन न यूसुफ सी कह्यो, “सुन, मय तोख मिस्र को पूरो देश को ऊपर अधिकारी ठहराय देऊ हय।” <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" /><note caller="+" style="x"><char style="xo" closed="false">41:42 </char><char style="xt" closed="false"><ref loc="DAN 5:29">दानिय्येल 5:29</ref></char></note>तब फिरौन न अपनो हाथ सी अंगूठी निकाल क यूसुफ को हाथ म पहिनाय दी; अऊर यूसुफ ख बढ़िया मलमल को कपड़ा पहिनाय दियो, अऊर ओको गलो म सोनो की चैन डाल दी; <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />अऊर ओख अपनो दूसरो रथ पर चढ़ायो; अऊर लोग ओको आगु आगु यो प्रचार करतो चल्यो कि घुटना टेक क दण्डवत करो, अऊर ओन यूसुफ ख मिस्र को पूरो देश को ऊपर प्रधान मन्त्री ठहराय दियो। <verse eid="GEN 41:43" /><verse number="44" style="v" sid="GEN 41:44" />तब फिरौन न यूसुफ सी कह्यो, “फिरौन त मय आय; पर मिस्र देश म कोयी भी तोरी आज्ञा को बिना हाथ पाय नहीं हिलायेंन।” <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />तब फिरौन न यूसुफ को नाम सापनत्पानेह<note caller="+" style="f"><char style="fr" closed="false">41:45 </char><char style="ft" closed="false">परमेश्वर बोलय हय, ऊ जीन्दो हय</char></note> रख्यो; अऊर ओन नगर को याजक पोतीपेरा की बेटी आसनत सी ओको बिहाव कराय दियो। अऊर यूसुफ पूरो मिस्र देश को अधिकारी भय गयो।<verse eid="GEN 41:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 41:46" />जब यूसुफ मिस्र को राजा फिरौन को जवर खड़ो भयो, तब ऊ तीस साल को होतो। ऊ फिरौन को जवर सी निकल क पूरो मिस्र देश म दौरा करन लग्यो। <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />पहिले को सात सालों म जमीन बहुत तरह सी अनाज पैदा करती रही, <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />अऊर यूसुफ उन सातों सालों म सब तरह की जेवन की चिजे, जो मिस्र देश म होत रह्य, उन्ख जमा कर क् नगरों म रखतो गयो; अऊर हर एक नगर को चारयी तरफ को खेतों की जेवन की चिजे ख ऊ उच नगर म जमा करतो गयो। <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />यो तरह यूसुफ न अनाज ख समुन्दर की रेतु को जसो बहुत अच्छो सी एक एक कर क् गिन क रख्यो, तब वहां इतनी फसल भय गयी कि यूसुफ न ओख गिननोच छोड़ दियो।<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />अकाल को पहिलो साल को आनो सी पहिले यूसुफ को दोय टुरा पैदा भयो, ओन नगर को याजक पोतीपेरा की बेटी आसनत न उन्ख जनम दियो। <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />यूसुफ न अपनो बड़ो टुरा को नाम यो कह्य क मनश्शे<note caller="+" style="f"><char style="fr" closed="false">41:51 </char><char style="ft" closed="false">भुलान वालो</char></note> रख्यो, कि “परमेश्वर न मोरो सी मोरी पूरी परेशानी, अऊर मोरो बाप को पूरो घराना भुलाय दियो हय।” <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />दूसरो को नाम ओन यो कह्य क एप्रैम<note caller="+" style="f"><char style="fr" closed="false">41:52 </char><char style="ft" closed="false">फलवन्त</char></note> रख्यो, कि “परमेश्वर न मोख ऊ देश म फलवन्त करयो जित मोख दु:ख भोगनो पड़्यो होतो।”<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />मिस्र देश को अच्छी फसल पकन को सात साल खतम होय गयो; <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" /><note caller="+" style="x"><char style="xo" closed="false">41:54 </char><char style="xt" closed="false"><ref loc="ACT 7:11">प्रेरितों 7:11</ref></char></note>अऊर यूसुफ को कहन को अनुसार सात सालों लायी अकाल शुरू भय गयो। सब देशों म अकाल पड़न लग्यो, पर मिस्र देश म अनाज होतो। <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" /><note caller="+" style="x"><char style="xo" closed="false">41:55 </char><char style="xt" closed="false"><ref loc="JHN 2:5">यूहन्ना 2:5</ref></char></note>जब मिस्र को पूरो देश भूखो मरन लग्यो; तब प्रजा फिरौन सी चिल्लाय चिल्लाय क खाना मांगन लग्यो; अऊर ऊ सब मिस्रियों सी कहत रह्य, “यूसुफ को जवर जावो; अऊर जो कुछ ऊ तुम सी कहेंन, उच करो।” <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />जब अकाल पूरी धरती पर फैल गयो, अऊर मिस्र देश म अकाल को रूप भयंकर भय गयो, तब यूसुफ सब भण्डार घर ख खोल क मिस्रियों ख अनाज बेचन लग्यो। <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />येकोलायी पूरी धरती को लोग मिस्र देश म अनाज लेन लायी यूसुफ को जवर आन लग्यो, कहालीकि पूरी धरती पर भयंकर अकाल होतो।<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">यूसुफ को भाऊवों को मिस्र म अनाज लेन लायी आनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />जब याकूब न सुन्यो कि मिस्र म अनाज हय, तब ओन अपनो बेटावों सी कह्यो, “तुम एक दूसरो को मुंह कहाली देख रह्यो हय।” <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" /><note caller="+" style="x"><char style="xo" closed="false">42:2 </char><char style="xt" closed="false"><ref loc="ACT 7:12">प्रेरितों 7:12</ref></char></note>तब ओन कह्यो, “मय न सुन्यो हय कि मिस्र म अनाज हय; येकोलायी तुम लोग वहां जाय क हमरो लायी अनाज ले क आवो, जेको सी हम मरबो नहीं, बल्की जीन्दो रह्यबोंन।” <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />तब यूसुफ को दस भाऊ अनाज लेन लायी मिस्र देश ख गयो। <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />पर यूसुफ को भाऊ बिन्यामीन ख याकूब न यो सोच क भाऊवों को संग नहीं भेज्यो कि कही असो नहीं होय कि ओको पर कोयी संकट आय पड़े।<verse eid="GEN 42:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 42:5" />यो तरह जो लोग अनाज लेन आयो उन्को संग याकूब को बेटा भी आयो; कहालीकि कनान देश म भी भारी अकाल होतो। <verse eid="GEN 42:5" /><verse number="6" style="v" sid="GEN 42:6" />यूसुफ त मिस्र देश को प्रधान मन्त्री होतो, अऊर ऊ देश को सब लोगों ख उच अनाज बेचत रह्य; येकोलायी जब यूसुफ को भाऊ आयो तब जमीन को तरफ मुंड झुकाय क ओख दण्डवत करयो। <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />उन्ख देख क यूसुफ न पहिचान त लियो, पर उन्को आगु भोलो बन क् मजबूती को संग उन्को सी पुच्छ्यो, “तुम कित सी आयो हय?”</para>
  <para style="p" vid="GEN 42:7">उन्न कह्यो, “हम कनान देश सी अनाज लेन लायी आयो हंय।”<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />यूसुफ न अपनो भाऊवों ख पहिचान लियो, पर उन्न ओख नहीं पहिचान्यो। <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" /><note caller="+" style="x"><char style="xo" closed="false">42:9 </char><char style="xt" closed="false"><ref loc="GEN 37:5-10">उत्पत्ति 37:5-10</ref></char></note>तब यूसुफ अपनो उन सपनो ख याद कर क् जो ओन ओको बारे म देख्यो होतो, उन्को सी कहन लग्यो, “तुम लोग भेद जानन लायी आयो हय; यो मिस्र देश की दुर्दशा को।”<verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />उन्न ओको सी कह्यो, “नहीं, नहीं, स्वामी, तोरो दास जेवन की चिज ख लेन लायी आयो हंय। <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />हम सब एकच बाप को बेटा आय, हम सीधो आदमी हंय; तोरो दास भेद जानन वालो नोहोय।”<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />यूसुफ न उन्को सी कह्यो, “नहीं, नहीं, तुम यो देश की दुर्दशा देखन लायीच आयो हय।”<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />उन्न कह्यो, “हम तोरो दास बारा भाऊ हंय, अऊर कनान देश को हम एकच आदमी को बेटा आय, अऊर छोटो भाऊ यो समय हमरो बाप को जवर हय, अऊर एक भाऊ मर गयो हय।”<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />तब यूसुफ न उन्को सी कह्यो, “मय न तुम सी कह्य दियो कि तुम भेद जानन वालो आय; <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />तब योच रीति सी तुम्हरी जांच करी जायेंन, फिरौन की जीवन की कसम, जब तक तुम्हरो छोटो भाऊ इत नहीं आय जाये तब तक तुम इत सी नहीं निकल पावों। <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />येकोलायी अपनो म सी एक ख भेज देवो कि ऊ तुम्हरो भाऊ ख ले आये, अऊर तुम लोग हमरी देख भाल म रहो; यो तरह तुम्हरी बाते जाची जायेंन कि तुम म सच्चायी हय का नहाय। यदि सच्चो नहीं निकल्यो तब त फिरौन को जीवन की कसम तुम सही मच भेद जानन वालो समझ्यो जावो।” <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />तब यूसुफ न उन्ख तीन दिन तक जेलखाना म रख्यो।<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />तीसरो दिन यूसुफ न उन्को सी कह्यो, “एक काम करो तब जीन्दो रहो; कहालीकि मय परमेश्वर को डर मानु हय; <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />यदि तुम सीधो आदमी हय, त तुम सब भाऊवों म सी एक जन यो जेलखाना म बन्दी रहे; अऊर तुम अपनो घर वालो की भूख मिटान लायी अनाज ले जावो, <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />अऊर अपनो छोटो भाऊ ख मोरो जवर ले आवो; यो तरह तुम्हरी बाते सच्ची ठहरेंन, अऊर तुम मार डाल्यो नहीं जावो।”</para>
  <para style="p" vid="GEN 42:20">तब उन्न वसोच करयो। <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />उन्न आपस म कह्यो, “कोयी सक नहाय कि हम अपनो भाऊ को बारे म दोषी हंय, कहालीकि जब ओन हम सी गिड़गिड़ाय क बिनती करी, तब भी हम न यो देख क कि ओको जीवन कसो संकट म पड़्यो हय, तब भी हम न ओकी नहीं सुनी; योच वजह हम भी अब यो संकट म पड़्यो हंय।”<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">42:22 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 37:21">उत्पत्ति 37:21</ref>,<ref loc="GEN 37:22">22</ref></char>
    </note>रूबेन न ओको सी कह्यो, “का मय न तुम सी नहीं कह्यो होतो कि टुरा को अपराधी मत बनो? पर तुम न नहीं सुन्यो। देखो, अब ओको खून को बदला लियो जाय रह्यो हय।” <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />यूसुफ की अऊर उन्की बातचीत एक दोय भाषियों को द्वारा होत रह्य; येको सी उन्ख मालूम नहीं भयो कि ऊ उन्की बोली समझय हय। <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />तब यूसुफ उन्को जवर सी हट क रोवन लग्यो; तब अऊर उन्को जवर लौट क उन्को सी बातचीत कर क् उन्म सी शिमोन ख निकाल्यो अऊर उन्को आगु ओख बन्दी बनाय लियो।<verse eid="GEN 42:24" /></para>
  <para style="s">यूसुफ को भाऊवों को कनान लौटनो</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />तब यूसुफ न आज्ञा दी कि उन्को बोरा अनाज सी भरो अऊर एक एक जन को बोरा म ओको रुपया ख भी रख देवो, तब उन्ख रस्ता लायी भी जेवन की चिजे भी देवो। तब उन्को संग असोच करयो गयो। <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />तब हि अपनो अनाज को बोरा अपनो गधा पर लाद क उत सी चली गयो। <verse eid="GEN 42:26" /><verse number="27" style="v" sid="GEN 42:27" />सराय म जब एक न अपनो गधा ख चारा देन लायी अपनो बोरा खोल्यो, तब ओको रुपया बोरा को ऊपर रख्यो हुयो देख्यो। <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />तब ओन अपनो भाऊवों सी कह्यो, “मोरो रुपया त लौटाय दियो गयो हय; देखो, ऊ मोरो बोरा म हय,” तब उन्को जीव म जीव नहीं रह्यो, अऊर हि एक दूसरो को तरफ डर सी देखन लग्यो, अऊर बोल्यो, “परमेश्वर न यो हम सी का करयो हय।”<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />तब हि कनान देश म अपनो बाप याकूब को जवर आयो, अऊर अपनी पूरी बात ओख यो तरह सुनायो : <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />“जो आदमी मिस्र देश को स्वामी हय, ओन हम सी मजबूती को संग बाते करी, अऊर हम ख ओन ऊ देश को भेद जानन वालो कह्यो। <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />तब हम न ओको सी कह्यो, ‘हम सीधो लोग हंय, भेद जानन वालो नहीं। <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />हम बारा भाऊ एकच बाप को बेटा आय; एक त मर गयो, पर छोटो भाऊ कनान देश म बाप को जवर हय।’ <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />तब ऊ आदमी न, जो ऊ देश को स्वामी हय, हम सी कह्यो, ‘येको सी मालूम होय जायेंन कि तुम सीधो आदमी हय; तुम अपनो म सी एक ख मोरो जवर छोड़ क अपनो घर वालो की भूख मिटान लायी कुछ ले क जावो, <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />अऊर अपनो छोटो भाऊ ख मोरो जवर ले क आवो। तब मोख विश्वास होय जायेंन कि तुम भेद जानन वालो नोहोय, पर सीधो लोग आय। तब मय तुम्हरो भाऊ ख तुम्ख सौंप देऊं, अऊर तुम यो देश म लेन देन भी कर सको’।”<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />यो बताय क हि अपनो अपनो बोरा सी अनाज निकालन लग्यो, तब देख्यो कि एक एक जन को रुपया की झोली ओकोच बोरा म रखी हय। तब रुपया की झोलियों ख देख क हि अऊर उन्को बाप बहुत डर गयो। <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />तब उन्को बाप याकूब न उन्को सी कह्यो, “मोख तुम न बिना सन्तान को कर दियो, देखो, यूसुफ नहीं रह्यो, अऊर शिमोन भी नहीं आयो, अऊर तुम बिन्यामीन ख भी लि जानो चाहवय हय। यो सब विपत्तियां मोरो ऊपर आय पड़ी हंय।”<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />रूबेन न अपनो बाप सी कह्यो, “यदि मय ओख तोरो जवर नहीं लाऊ, त मोरो दोयी टुरावों ख मार डालजो; तय ओख मोरो हाथ म सौंप दे, मय ओख तोरो जवर फिर लाय देऊं।”<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />याकूब न कह्यो, “मोरो बेटा तुम्हरो संग नहीं जायेंन; कहालीकि ओको भाऊ मर गयो हय अऊर ऊ अब अकेलो रह्य गयो हय : येकोलायी जो रस्ता सी तुम जावो, ओको म यदि ओको पर कोयी विपत्ति आय गयी, तब त तुम्हरो वजह मय यो बुढ़ापा को दिन म दु:ख को संग अधोलोक म उतर जाऊं।”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">बिन्यामीन को संग मिस्र देश जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />कनान देश म अकाल अऊर भी भयंकर होतो गयो। <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />जब हि अनाज मिस्र सी ले आयो होतो, खतम होय गयो तब उन्को बाप याकूब न उन्को सी कह्यो, “मिस्र देश ख फिर जावो, अऊर हमरो लायी कुछ अऊर जेवन की चिज ले क लावो।”<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />तब यहूदा न अपनो बाप याकूब सी कह्यो, “ऊ आदमी न हम ख चेतावनी दे क कह्यो, ‘यदि तुम्हरो भाऊ तुम्हरो संग नहीं आयेंन, त तुम मोरो जवर मत आवो।’ <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />येकोलायी यदि तय हमरो भाऊ ख हमरो संग भेजय, तब हम जाय क तोरो लायी जेवन की चिज ख ले क आबो, <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />पर यदि तय ओख नहीं भेजय, त हम नहीं जाबो, कहालीकि ऊ आदमी न हम सी कह्यो, ‘यदि तुम्हरो भाऊ तुम्हरो संग नहीं आयेंन, त तुम मोरो जवर मत आवो’।”<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />तब याकूब न कह्यो, “तुम न ऊ आदमी ख यो कहाली बतायो कि हमरो एक अऊर भाऊ हय, कहाली मोरो सी बुरो बर्ताव करयो?”<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />उन्न कह्यो, “जब ऊ आदमी न हमरी अऊर हमरो रिश्तेदारों की हालत को बारे म यो रीति सी पुच्छ्यो, ‘कि का तुम्हरो बाप अभी तक जीन्दो हय? का तुम्हरो कोयी अऊर भाऊ भी हय?’ तब हम न हि सवाल को अनुसार ओको सी बात करयो। तब हम का जानत होतो कि ऊ हम सी कहेंन, कि अपनो भाऊ ख इत ले आवो।”<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />तब यहूदा न अपनो बाप याकूब सी कह्यो, “ऊ लड़का ख मोरो संग भेज दे कि हम चले जाये; येको सी हम अऊर तय, अऊर हमरो बाल बच्चा मरनो नहीं पायेंन, अऊर जीन्दो रहेंन। <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />मय ओकी सुरक्षा की जवाब दारी लेऊ हय; मोरोच हाथ सी तय ओख वापस लेजो। यदि मय ओख तोरो जवर पहुंचाय क आगु खड़ो नहीं कर देऊ, तब त मय हमेशा लायी तोरो अपराधी ठहरूं। <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />यदि हम लोग वहां इंतजार नहीं करतो, त अब तक दूसरी बार वापस आतो।”<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />तब उन्को बाप याकूब न उन्को सी कह्यो, “यदि सचमुच असीच बात हय त यो करो, यो देश की अच्छी अच्छी चिज म सी कुछ कुछ अपनो बोरा म ऊ आदमी लायी भेंट ले जावो : जसो थोड़ो सो बलसान<note caller="+" style="f"><char style="fr" closed="false">43:11 </char><char style="ft" closed="false">गाध</char></note>, शहेद, मसाला, गन्धरस, पिस्ता, अऊर बदाम। <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />तब अपनो अपनो संग दोय गुना रुपया ले जावो; अऊर जो रुपया तुम्हरो बोरा को ऊपर रख क लौटाय दियो गयो होतो, ओख भी धर क जावो; शायद यो भूल सी भयो हो। <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />अपनो भाऊ ख भी संग ले क ऊ आदमी को जवर फिर जावो, <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />अऊर सर्वशक्तिमान परमेश्वर ऊ आदमी ख तुम पर दयालु करेंन, जेको सी ऊ तुम्हरो दूसरो भाऊ ख अऊर बिन्यामीन ख भी आन देन; अऊर यदि बिन सन्तान ख बिछड़नोच हय, त असोच होन दे।”<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />तब उन भाऊवों न ऊ भेंट, अऊर दोय गुना रुपया, अऊर बिन्यामीन ख भी संग म धरयो, अऊर चलन लग्यो, अऊर मिस्र देश म पहुंच क यूसुफ को आगु खड़ो भयो। <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />उन्को संग बिन्यामीन ख देख क यूसुफ न अपनो घर को अधिकारी सी कह्यो, “हि आदमियों ख घर म पहुंचाय देवो, अऊर जनावर मार क जेवन तैयार करो; कहालीकि हि लोग दोपहर ख मोरो संग जेवन करेंन।” <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />तब ऊ अधिकारी आदमी यूसुफ को कहन को अनुसार उन आदमियों ख यूसुफ को घर म ले गयो।<verse eid="GEN 43:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 43:18" />जब हि यूसुफ को घर ख पहुंचायो गयो तब हि आपस म डर क कहन लग्यो, “जो रुपया पहिली बार हमरो बोरा म वापस कर दियो गयो होतो, ओकोच वजह हम अन्दर पहुंचायो गयो हंय; जेको सी कि ऊ आदमी हम पर टूट पड़्यो, अऊर हम्ख वश म कर क् अपनो दास बनायो, अऊर हमरो गधा ख भी छीन ले।” <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />तब हि यूसुफ को घर को अधिकारी को जवर जाय क घर को दरवाजा पर ओको सी कहन लग्यो, <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />“हे हमरो स्वामी, जब हम पहिली बार अनाज मोल लेन ख आयो होतो, <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />तब हम घर ख जातो समय सराय म पहुंच क अपनो बोरा ख खोल्यो, त देख्यो कि एक एक जन को पूरो पूरो रुपया ओको बोरा म ऊपर रख्यो हय; येकोलायी हम ऊ रुपया ख फिर अपनो संग लायो हंय, <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />अऊर दूसरो रुपया भी खान की चिज लेन लायी लायो हंय; हम नहीं जानजे कि हमरो रुपया हमरो बोरा म कौन रख दियो होतो।”<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />ओन कह्यो, “चिन्ता मत करो, मत डरो! तुम्हरो परमेश्वर, जो तुम्हरो बाप को भी परमेश्वर हय, ओनच तुम ख तुम्हरो बोरा म धन दियो होना, तुम्हरो रुपया त मोख मिल गयो होतो।” तब ओन शिमोन ख निकाल क ओको संग कर दियो।<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />तब ऊ अधिकारी न उन भाऊवों ख यूसुफ को घर म लिजाय क पानी दियो, तब उन्न अपनो पाय ख धोयो; तब ओन उन्को गधा लायी चारा भी दियो। <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />तब यो सुन क कि अज हम्ख इतच जेवन करनो पड़ेंन, तब उन्न यूसुफ को आन को समय तक मतलब दोपहर तक, ऊ भेंट ख तैयार कर क् रख्यो। <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />जब यूसुफ घर आयो तब हि ऊ भेंट ख, जो ओको हाथ म होती, ओको आगु घर म लिजायो अऊर जमीन पर गिर क ओख दण्डवत करयो। <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />यूसुफ न उन्ख सब ठीक ठाक त हय असो पुच्छ्यो अऊर कह्यो, “का तुम्हरो ऊ बूढ्ढा बाप, जेकी तुम न चर्चा करी होती, ऊ ठीक हय? का ऊ अभी तक जीन्दो हय?”<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />उन्न कह्यो, “हव, तोरो दास अऊर हमरो बाप ठीक हय अऊर अब तक जीन्दो भी हय।” तब उन्न मुंड झुकाय क फिर दण्डवत करयो।<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />तब यूसुफ न आंखी ऊपर उठाय क अऊर अपनो सगो भाऊ बिन्यामीन ख देख क पुच्छ्यो, “का तुम्हरो ऊ छोटो भाऊ, जेकी चर्चा तुम न मोरो सी करी होती योच आय?” तब ओन कह्यो, “हे मोरो बेटा, परमेश्वर तोरो पर अनुग्रह करे।” <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />यूसुफ जल्दी सी उठ्यो; कहालीकि अपनो छोटो भाऊ को वजह ओको मन भर आयो होतो, ओन अकेलो म आसू बहान लायी जागा ढूंढ़ी अऊर ऊ अपनी कोठरी म आयो, अऊर वहां रोय पड़्यो। <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />तब अपनो मुंह धोय क निकल्यो, अऊर अपनो ख चुपचाप कर क् कह्यो, “जेवन परोसो।” <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />तब उन्न ओको लायी अलग अऊर भाऊवों लायी भी अलग, अऊर जो मिस्री ओको संग खात रह्य उन्को लायी भी अलग जेवन परोस्यो; येकोलायी कि मिस्री इब्रियों को संग जेवन नहीं कर सकय, नहीं त मिस्री लोग असो करनो बुरो समझत होतो। <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />अऊर यूसुफ को भाऊ ओको आगु बड़ो बड़ो पहिले अऊर छोटो छोटो पीछू, उन्ख अपनी अपनी उमर को अनुसार, कर्म सी बैठायो गयो; यो देख क हि हैरान होय क एक दूसरो को तरफ देखन लग्यो। <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />तब यूसुफ अपनो आगु सी जेवन की चिजे उठाय उठाय क उन्को जवर भेजन लग्यो, अऊर बिन्यामीन ख अपनो भाऊवों सी पाच गुना जादा जेवन की चिजे मिली। यो तरह उन्न यूसुफ को संग खुशी मनायो।<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">खोयो हुयो चांदी को कटोरा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />तब यूसुफ न अपनो घर को अधिकारी ख आज्ञा दी, “इन आदमियों को बोरा म जितनी जेवन की चिजे समाय सकेंन उतनी भर दे, अऊर एक एक जन को रुपया ख ओको बोरा को मुंह पर रख दे। <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />अऊर मोरो चांदी को कटोरा सब सी छोटो भाऊ को बोरा को मुंह पर ओको अनाज को रुपया को संग रख दे।” यूसुफ की यो आज्ञा को अनुसार ओन वसोच करयो। <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />सुबेरे होतोच हि आदमी अपनो गधा सहित बिदा करयो गयो <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />हि नगर सी निकल्योच होतो अऊर दूर नहीं गयो होतो कि यूसुफ न अपनो घर को अधिकारी सी कह्यो, “उन आदमियों को पीछा कर, अऊर उन्ख मिल क उन्को सी कह्य, ‘तुम न भलायी को बदला बुरायी कहाली करी? तुम न मोरो स्वामी को चांदी को कटोरा कहाली चुरायो? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />का यो ऊ चांदी को कटोरा नोहोय जेको म मोरो स्वामी पीवय हय, अऊर जेको सी ऊ लूकी बातों ख भी करय हय? तुम न यो जो करयो ऊ बुरो करयो’।”<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />तब अधिकारी न उन्ख जाय क पकड़्यो, अऊर असीच बाते उन्को सी कही। <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />उन्न अधिकारी सी कह्यो, “हे हमरो स्वामी, तय असी बाते कहाली कह्य रह्यो हय? हम कसम खाजे हय कि हम न असो काम करयो हय कि तोरो दासों सी दूर रहे। <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />देख, जो रुपया हमरो बोरा को मुंह को ऊपर निकल्यो होतो, जब हम न ओख कनान देश सी लाय क तोख वापस कर दियो, तब कहाली, हम तोरो स्वामी को घर म सी कोयी चांदी या सोनो की चिज कसो चुराय सकजे हंय? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />हे स्वामी, तोरो दासों म सी जो कोयी को जवर ऊ निकले, त ऊ मार डाल्यो जाये, अऊर हम भी ऊ स्वामी को दास होय जाबो।”<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />घर को अधिकारी न कह्यो, “तुम्हरोच कहनो सही हय, जेको जवर कटोरा निकले ऊ मोरो दास होयेंन, अऊर तुम लोग निर्दोष ठहरो।” <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />यो बात पर हर एक आदमी अपनो अपनो बोरा ख जमीन पर जल्दी रख क उन्ख खोलन लग्यो। <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />तब यूसुफ को घर को अधिकारी ढूंढन लग्यो, अऊर बड़ो भाऊ को बोरा सी ले क छोटो भाऊ को बोरा तक ढूंढ्यो; अऊर कटोरा बिन्यामीन को बोरा म मिल्यो। <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />तब भाऊवों न अपनो अपनो दु:ख म कपड़ा फाड़्यो, अऊर अपनो अपनो गधा पर सामान रख क नगर ख लौट गयो।<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />जब यहूदा अऊर ओको भाऊ यूसुफ को घर पर पहुंच्यो, त यूसुफ वहांच होतो, तब हि ओको आगु जमीन पर गिरयो। <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />यूसुफ न उन्को सी कह्यो, “तुम लोगों न यो कसो काम करयो हय? का तुम नहीं जानत होतो, कि मोरो जसो आदमी लूकी हुयी बातों ख भी कर सकय हय?”<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />यहूदा न कह्यो, “हम लोग अपनो स्वामी सी का कह्यबो? हम का कह्य क अपनो ख निर्दोष ठहराबो? परमेश्वर न तोरो दासों को अधर्म ख पकड़ लियो हय। हम, अऊर जेको जवर कटोरा निकल्यो ऊ भी, हम सब को सब अपनो स्वामी को दासच हंय।”<verse eid="GEN 44:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 44:17" />“यूसुफ न कह्यो असो काम मोरो सी दूरच रहे, जेको जवर कटोरा निकल्यो हय उच मोरो दास होयेंन; अऊर तुम लोग अपनो बाप को जवर अच्छो सी चली जावो।”<verse eid="GEN 44:17" /></para>
  <para style="s">बिन्यामीन लायी यहूदा को निवेदन</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />तब यहूदा ओको जवर जाय क कहन लग्यो, “हे मोरो स्वामी, तोरो दास ख अपनो स्वामी सी एक बात कहन की आज्ञा हय, अऊर तोरो गुस्सा तोरो दास पर नहीं हो; कहालीकि तय त फिरौन राजा को जसो हय। <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />मोरो स्वामी न अपनो दासों सी पुच्छ्यो होतो, ‘का तुम्हरो बाप अऊर कोयी दूसरो भी भाऊ हय?’ <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />अऊर हम न अपनो स्वामी सी कह्यो, ‘हव, हमरो बूढ्ढा बाप हय, अऊर ओको बुढ़ापा को सहारा एक छोटो सो बच्चा भी हय, पर ओको भाऊ मर गयो हय, येकोलायी ऊ अब अपनी माय को अकेलोच बच्चा रह्य गयो हय, अऊर ओको बाप ओको सी प्रेम रखय हय।’ <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />तब तय न अपनो दासों सी कह्यो होतो, ‘ओख मोरो जवर ले आवो, जेको सी मय ओख देख सकू।’ <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />तब हम न अपनो स्वामी सी कह्यो होतो, ‘ऊ टुरा अपनो बाप ख नहीं छोड़ सकय; नहीं त ओको बाप मर जायेंन।’ <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />अऊर तय न अपनो दासों सी कह्यो, ‘यदि तुम्हरो छोटो भाऊ तुम्हरो संग नहीं आये, त तुम मोरो जवर कभी नहीं आनो पावों।’<verse eid="GEN 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 44:24" />“येकोलायी जब हम अपनो बाप अऊर तोरो दास को जवर गयो, तब हम न ओको सी अपनो स्वामी की बाते कही। <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />तब हमरो बाप न कह्यो, ‘फिर जाय क हमरो लायी थोड़ी सी खान की चिज लेय क लावो।’ <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />हम न कह्यो, ‘हम नहीं जाय सकजे, हव, यदि हमरो छोटो भाऊ हमरो संग रहे, तब हम जाबो; यदि हमरो छोटो भाऊ हमरो संग नहीं रहेंन, त हम ऊ आदमी को जवर नहीं जाय सकजे।’ <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />तब तोरो दास अऊर हमरो बाप न हम सी कह्यो, ‘तुम त जानय हय कि मोरी बाई राहेल सी दोय टुरा पैदा भयो। <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />अऊर उन म सी एक त मोख छोड़ क चली गयो, अऊर मय न निश्चय कर लियो कि ऊ कोयी जनावर को वजह टुकड़ा टुकड़ा कर दियो गयो होना, अऊर तब सी मय ओको मुंह भी नहीं देख सक्यो। <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />यदि तुम येख भी मोरी आंखी को आगु सी ले जावो, अऊर कोयी संकट येको पर पड़े, त तुम्हरो वजह म यो बुढ़ापा को समय म दु:ख को संग अधोलोक म उतर जाऊं।’<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />“येकोलायी जब मय अपनो बाप अऊर तोरो दास को जवर पहुंचू अऊर यो लड़का संग म नहीं रहेंन, त ओको जीव त येकोच पर अटक्यो रहेंन, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />तब ऊ देखेंन कि लड़का नहाय त ऊ तुरतच मर जायेंन। तब तोरो दासों को वजह तोरो दास अऊर हमरो बाप, जो बुढ़ापा को समय म, दु:ख को संग अधोलोक म उतर जायेंन। <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />मय तोरो दास अपनो बाप को इत यो कह्य क् लड़का लायी अपनो जीवन गिरवी रख्यो हय, यदि मय येख तोरो जवर नहीं पहुंचाय देऊ, त मय हमेशा लायी तोरो अपराधी ठहरूं। <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />येकोलायी अब तोरो दास यो लड़का को बदला अपनो स्वामी को दास होय क रहन की आज्ञा पाये, अऊर यो लड़का ख अपनो भाऊवों को संग जान दियो जाये। <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />यदि लड़का मोरो संग नहीं हो त मय कसो अपनो बाप को जवर जाय सकूं; कही असो नहीं होय कि मोरो बाप पर जो दु:ख पड़ेंन ओख मोख देखनो पड़े।”<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">यूसुफ को खुद ख प्रगट करनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">45:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 7:13">प्रेरितों 7:13</ref>
      </char>
    </note>तब यूसुफ उन सब को आगु जो ओको जवर जवर खड़ो होतो, अपनो ख अऊर रोख नहीं सक्यो; अऊर पुकार क कह्यो, “मोरो जवर जवर सी सब लोगों ख बाहेर क देवो।” भाऊवों को आगु अपनो ख प्रगट करन को समय यूसुफ को संग अऊर कोयी नहीं रह्यो। <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />तब ऊ ऊची आवाज सी रोवन लग्यो; अऊर मिस्रियों न सुन्यो, अऊर फिरौन को घर को लोगों ख भी येको समाचार मिल्यो। <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />तब यूसुफ अपनो भाऊवों सी कहन लग्यो, “मय यूसुफ आय, का मोरो बाप अभी तक जीन्दो हय?” येको उत्तर ओको भाऊ नहीं दे सक्यो; कहालीकि हि ओको आगु घबराय गयो होतो। <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />तब यूसुफ न अपनो भाऊवों सी कह्यो, “मोरो जवर आवो।” यो सुन क हि जवर गयो। तब ओन कह्यो, “मय तुम्हरो भाऊ यूसुफ आय, जेक तुम न मिस्र देश सी आन वालो व्यापारी को हाथ बेच डाल्यो होतो। <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />अब तुम लोग मत पछतावो, अऊर तुम न जो मोख इत बेच डाल्यो, येको सी उदास मत होवो; कहालीकि परमेश्वर न तुम्हरो जीवो ख बचान लायी मोख तुम्हरो आगु भेज दियो हय। <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />कहालीकि अब दोय साल सी यो देश म अकाल हय; अऊर अब पाच साल अऊर असोच होयेंन कि उन्म त नहीं नांगर चलेंन अऊर नहीं अनाज काट्यो जायेंन। <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />येकोलायी परमेश्वर न मोख तुम्हरो आगु येकोच लायी भेज्यो कि तुम धरती पर जीन्दो रहो, अऊर तुम्हरो जीवो को बचनो सी तुम्हरो वंश बढ़े। <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />यो रीति सी अब मोख यहां पर भेजन वालो तुम नहीं, परमेश्वरच ठहरयो; अऊर ओनच मोख फिरौन को बाप, अऊर ओको पूरो घर को स्वामी, अऊर पूरो मिस्र देश को अधिकारी भी ठहराय दियो हय।<verse eid="GEN 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">45:9 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 7:14">प्रेरितों 7:14</ref>
      </char>
    </note>“तब जल्दी मोरो बाप को जवर जाय क कहो, ‘तोरो बेटा यूसुफ यो कह्य हय कि परमेश्वर न मोख पूरो मिस्र को स्वामी ठहरायो हय; येकोलायी तय मोरो जवर बिना रुक्यो चल्यो आव। <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />तोरो निवास गोशेन देश म होयेंन, अऊर तय अपनो बेटा, नाती, शेरी मेंढी, गाय बईल, अऊर अपनो सब कुछ धर क मोरो जवर रह्यजो। <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />अऊर अकाल को जो पाच साल अऊर होयेंन, उन्म मय उतच तोरो पालन पोषन करूं; असो नहीं होय कि तय अऊर तोरो घराना, बल्की जितनो तोरो जनावर हंय, हि भूखो मरे।’”<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />अऊर तुम अपनी आंखी सी देखय हय, “अऊर मोरो भाऊ बिन्यामीन भी अपनी आंखी सी देखय हय कि जो हम सी बाते कर रह्यो हय ऊ यूसुफ आय। <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />तुम मोरो सब वैभव को, जो मिस्र म हय अऊर जो कुछ तुम न देख्यो हय, ऊ बात को मोरो बाप सी वर्नन करजो; अऊर तुरतच मोरो बाप ख इत ले आजो।”<verse eid="GEN 45:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 45:14" />तब ऊ अपनो भाऊ बिन्यामीन को गरो सी लिपट क रोयो; अऊर बिन्यामीन भी ओको गरो सी लिपट क रोयो। <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />ऊ अपनो सब भाऊवों ख चुम्मा ले क रोयो, अऊर येको बाद ओको भाऊ ओको सी बाते करन लग्यो।<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />यो बात को समाचार, कि यूसुफ को भाऊ आयो हंय, फिरौन को भवन तक पहुंच गयो, अऊर येको सी फिरौन अऊर ओको कर्मचारी प्रसन्न भयो। <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />येकोलायी फिरौन न यूसुफ सी कह्यो, “अपनो भाऊवों सी कह्य कि एक काम करो : अपनो जनावरों पर अनाज रख क कनान देश म चली जावो। <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />अऊर अपनो बाप अऊर अपनो अपनो घर को लोगों ख ले क मोरो जवर आवो; अऊर मिस्र देश म जो कुछ अच्छो सो अच्छो हय ऊ मय तुम्ख देऊं, अऊर तुम्ख देश को अच्छो सी अच्छो चिज खान ख मिलेंन। <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />अऊर तोख आज्ञा मिली हय, ‘तुम एक काम करो कि मिस्र देश सी अपनो बाल बच्चां अऊर बाईयों लायी गाड़ियां ले जावो, अऊर अपनो बाप ख ले आवो। <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />अऊर अपनो सामान की चिन्ता नहीं करे कहालीकि पूरो मिस्र देश म जो कुछ अच्छो सी अच्छो हय ऊ तुम्हरो हय’।”<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />याकूब को टुरावों न वसोच करयो; अऊर यूसुफ न फिरौन की आज्ञा को अनुसार उन्ख गाड़ियां दी, अऊर रस्ता लायी जेवन को सामान भी दियो। <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />उन्म सी एक एक जन ख ओन एक एक जोड़ा कपड़ा भी दियो; अऊर बिन्यामीन ख तीन सौ चांदी को सिक्का को संग पाच जोड़ी कपड़ा भी दियो। <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />अपनो बाप को जवर ओन जो भेज्यो ऊ यो आय, मिस्र की अच्छी चिजों सी भरयो हुयो दस गधा, अऊर अनाज रोटी अऊर ओको बाप की रस्ता लायी जेवन की चिज सी भरी हुयी दस गधी। <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />तब ओन अपनो भाऊवों ख बिदा करयो, अऊर हि चली गयो; अऊर ओन उन्को सी कह्यो, “रस्ता म कही झगड़ा मत करो।”<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />मिस्र सी आय क हि कनान देश म अपनो बाप याकूब को जवर पहुंच्यो। <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />अऊर ओको सी यो कह्यो, “यूसुफ अब तक जीन्दो हय, अऊर पूरो मिस्र देश पर शासन उच करय हय।” पर ओन उन्की बातों पर विश्वास नहीं करयो अऊर दंग भय गयो।<verse eid="GEN 45:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 45:27" />तब उन्न अपनो बाप याकूब सी यूसुफ की पूरी बाते, जो ओन उन्को सी कही होती उन्न ओको सी कह्य दी। जब ओन उन गाड़ियों ख देख्यो, जो यूसुफ न ओख लेन लायी भेजी होती, तब ओको जीव म जीव आयो। <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />अऊर याकूब न कह्यो, “बस, मोरो बेटा यूसुफ अभी तक जीन्दो हय; मय अपनो जीव निकलन को पहिले जाय क ओख देखूं।”<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">याकूब ख पूरो परिवार सहीत मिस्र ख जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />तब याकूब अपनो सब कुछ ले क बेर्शेबा ख गयो, अऊर उत अपनो बाप इसहाक को परमेश्वर ख बलिदान चढ़ायो। <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />तब परमेश्वर न याकूब सी रात ख दर्शन म कह्यो, “हे याकूब, हे याकूब।”</para>
  <para style="p" vid="GEN 46:2">ओन कह्यो, “का आज्ञा हय।”<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />परमेश्वर न कह्यो, “मय परमेश्वर आय, तोरो बाप को परमेश्वर; तय मिस्र म जान सी मत डर; कहालीकि मय तोरो सी उत एक बड़ी जाति बनाऊं। <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />मय तोरो संग संग मिस्र ख चलू हय, अऊर मय तोख उत सी फिर सी वापस ले आऊं; अऊर यूसुफ अपनो हाथ सी तोरी आंखी ख बन्द करेंन।”<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />तब याकूब बेर्शेबा सी चल्यो; अऊर याकूब को टुरा अपनो बाप याकूब अऊर अपनो टुरावों न, अऊर बाईयों ख उन गाड़ियों पर बैठायो, जो फिरौन न उन्ख लिजान लायी भेजी होती। <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" /><note caller="+" style="x"><char style="xo" closed="false">46:6 </char><char style="xt" closed="false"><ref loc="ACT 7:15">प्रेरितों 7:15</ref></char></note>हि अपनी शेरी मेंढी गाय-बईल, अऊर कनान देश म अपनो जमा करयो हुयो पूरो धन ख ले क मिस्र म आयो; <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />अऊर याकूब अपनो टुरा टुरियां, नाती नातिन, यानेकि अपनो पूरो वंश ख अपनो संग मिस्र देश म ले आयो।<verse eid="GEN 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />याकूब को संग जो इस्राएली, यानेकि याकूब को टुरा, नाती पहिले, मिस्र देश म आयो, उन्को नाम यो हंय : याकूब को बड़ो टुरा रूबेन होतो; <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />अऊर रूबेन को टुरा हनोक, पल्लू, हेस्रोन अऊर कर्म्मी होतो। <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />शिमोन को टुरा यमूएल यामीन, ओहद, याकीन, सोहर, अऊर एक कनानी बाई सी जनम्यो हुयो शाऊल भी होतो। <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />लेवी को टुरा गेर्शोन, कहात, अऊर मरारी होतो। <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />यहूदा को टुरा एर, ओनान, शेला, पेरेस, अऊर जेरह नाम को टुरा भयो त होतो पर एर अऊर ओनान कनान देश म मर गयो होतो; अऊर पेरेस को टुरा हेस्रोन अऊर हामूल होतो। <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />इस्साकार को टुरा तोला, पुब्बा, योब, अऊर शिम्रोन होतो। <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />जबूलून को टुरा सेरेद एलोन, अऊर यहलेल होतो। <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />लिआ : को टुरा जो याकूब सी पद्दनराम म पैदा भयो होतो, उन्को बेटा अऊर नाती हिच होतो, अऊर इन्को सी जादा ओन ओको संग एक बेटी दीना ख भी जनम दियो। यहां तक त याकूब को सब वंश वालो तैंतीस लोग भयो।<verse eid="GEN 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 46:16" />तब गाद को टुरा सिय्योन, हाग्गी, शूनी, एसबोन, एरी, अरोदी, अऊर अरेली होतो। <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />आशेर को टुरा यिम्ना, यिश्वा, यिस्वी, अऊर उन्की बहिन सेरह होती; अऊर बरीआ को टुरा हेबेर अऊर मल्कीएल होतो। <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />जिल्पा, जेक लाबान न अपनी बेटी लिआ : ख दी होती, ओको बेटा अऊर नाती पहिले हिच होतो; अऊर ओको द्वारा याकूब को सोला लोग पैदा भयो।<verse eid="GEN 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19" />तब याकूब की पत्नी राहेल को टुरा यूसुफ अऊर बिन्यामीन होतो। <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" /><note caller="+" style="x"><char style="xo" closed="false">46:20 </char><char style="xt" closed="false"><ref loc="GEN 41:50-52">उत्पत्ति 41:50-52</ref></char></note>अऊर मिस्र देश म ओन को याजक पोतीपेरा की बेटी आसनत सी यूसुफ को यो बेटा पैदा भयो, यानेकि मनश्शे अऊर एप्रैम। <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />अऊर बिन्यामीन को टुरा बेला, बेकेर, अश्बेल, गेरा, नामान, एही, रोश, मुप्पीम, हुप्पीम अऊर आर्द होतो। <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />राहेल को टुरा जो याकूब सी पैदा भयो ओको योच टुरा होतो; ओको यो सब बेटा अऊर नाती चौदा लोग भयो।<verse eid="GEN 46:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 46:23" />तब दान को टुरा हूशीम होतो। <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />नप्ताली को टुरा यहसेल, गूनी, सेसेर, अऊर शिल्लेम होतो। <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />बिल्हा दासी, जेक लाबान न अपनी बेटी राहेल ख दियो, ओको बेटा अऊर नाती हिच आय; ओको द्वारा याकूब को वंश म सात लोग भयो।<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />याकूब को वंश को पूरो लोग जो उन्को संग मिस्र म आयो होतो, याकूब की बहुवों ख छोड़ क सब मिल क छियासठ लोग होतो। <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" /><note caller="+" style="x"><char style="xo" closed="false">46:27 </char><char style="xt" closed="false"><ref loc="ACT 7:14">प्रेरितों 7:14</ref></char></note>अऊर यूसुफ को बेटा, जो मिस्र म ओको सी पैदा भयो, हि दोय लोग होतो; यो तरह याकूब को घरानो को जो लोग मिस्र म आयो हि सब मिल क सत्तर भयो।<verse eid="GEN 46:27" /></para>
  <para style="s">याकूब अऊर ओको परिवार मिस्र पहुंच्यो</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />तब याकूब न यहूदा ख अपनो आगु यूसुफ को जवर भेज दियो कि ऊ ओख गोशेन की रस्ता दिखाये; अऊर हि गोशेन देश म आयो। <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />तब यूसुफ अपनो रथ जुतवाय क अपनो बाप याकूब सी भेंट करन लायी गोशेन देश ख गयो, अऊर याकूब सी भेंट कर क् ओको गलो सी लपट्यो, अऊर बहुत देर तक याकूब को गलो सी लपट्यो हुयो रोतो रह्यो। <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />तब याकूब न यूसुफ सी कह्यो, “मय अब मरनो सी भी प्रसन्न हय, कहालीकि तोख जीन्दो पायो अऊर तोरो मुंह देख लियो।”<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />तब यूसुफ न अपनो भाऊवों सी अऊर अपनो बाप को घरानो सी कह्यो, “मय जाय क फिरौन ख यो कह्य क समाचार देऊं, ‘मोरो भाऊ अऊर मोरो बाप को पूरो घरानो को लोग, जो कनान देश म रहत होतो, हि मोरो जवर आय गयो हंय; <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />अऊर हि लोग चरवाहे हंय, कहालीकि हि जनावरों ख पालतो आयो हंय; येकोलायी हि अपनी शेरी मेंढी, गाय बईल, अऊर जो कुछ उन्को हय, सब ले आयो हंय।’ <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />जब फिरौन तुम ख बुलाय क पूछे, ‘तुम्हरो धन्दा का हय?’ <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />तब यो कह्यजो, ‘तोरो दास बचपन सी ले क अज तक जनावरों ख पालतो आयो हंय, बल्की हमरो पूर्वज भी असोच करत होतो।’ येको सी तुम गोशेन देश म रहनो पावों; कहालीकि सब चरवाहों सी मिस्री लोग घृना करय हंय।”<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />तब यूसुफ न फिरौन को जवर जाय क यो समाचार दियो, “मोरो बाप अऊर मोरो भाऊ, अऊर उन्की शेरी मेंढियां, गाय बईल अऊर जो कुछ उन्को हय, सब कनान देश सी आय गयो हय; अऊर अभी त हि गोशेन देश म हंय।” <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />तब यूसुफ अपनो भाऊवों म सी पाच जन ख ले क फिरौन को आगु खड़ो कर दियो। <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />फिरौन न यूसुफ को भाऊवों सी पुच्छ्यो, “तुम्हरो काम का हय?”</para>
  <para style="p" vid="GEN 47:3">उन्न फिरौन सी कह्यो, “तोरो दास चरवाहे हंय, अऊर हमरो पूर्वजों भी असोच रह्यो।” <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />तब उन्न फिरौन सी कह्यो, “हम यो देश म परदेशी को भाति रहन लायी आयो हंय; कहालीकि कनान देश म भारी अकाल होन को वजह तोरो दासों की शेरी मेंढियों लायी चारा नहीं रह्यो; येकोलायी अपनो दासों ख गोशेन देश म रहन की आज्ञा दे।” <verse eid="GEN 47:4" /><verse number="5" style="v" sid="GEN 47:5" />तब फिरौन न यूसुफ सी कह्यो, “तोरो बाप अऊर तोरो भाऊ तोरो जवर आय गयो हंय, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />अऊर मिस्र देश तोरो आगु पड़्यो हय; यो देश को जो सब सी अच्छो भाग हो, ओको म अपनो बाप अऊर भाऊवों ख बसाय दे, मतलब हि गोशेन देश मच रहे; अऊर यदि तय जानय हय, कि उन्म कोयी मेहनती आदमी हंय, त उन्ख मोरो जनावरों को अधिकारी ठहराय दे।”<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />तब यूसुफ न अपनो बाप याकूब ख लाय क फिरौन को जवर खड़ो करयो; अऊर याकूब न फिरौन ख आशीर्वाद दियो। <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />तब फिरौन न याकूब सी पुच्छ्यो, “तोरी उमर कितनो साल की भयी हय?”<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />याकूब न फिरौन सी कह्यो, “मय एक सौ तीस साल परदेशी होय क अपनो जीवन बिताय चुक्यो हय; मोरो जीवन को दिन थोड़ो अऊर दु:ख सी भरयो हुयो भी होतो, अऊर मोरो पूर्वजों परदेशी होय क जितनो दिन तक जीन्दो रह्यो उतनो दिन को मय अभी नहीं भयो।” <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />अऊर याकूब फिरौन ख आशीर्वाद दे क ओको जवर सी चली गयो। <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />तब यूसुफ न अपनो बाप अऊर भाऊवों ख बसाय दियो, अऊर फिरौन कि आज्ञा को अनुसार मिस्र देश को अच्छो सी अच्छो भाग म, मतलब रामसेस नाम को प्रदेश म, जमीन दे क उन्ख सौंप दियो। <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />अऊर यूसुफ अपनो बाप को, अऊर अपनो भाऊवों को, अऊर बाप को पूरो घराना को, एक एक को बाल बच्चां की गिनती को अनुसार, भोजन दिलाय दिलाय क उन्को पालन पोषन करन लग्यो।<verse eid="GEN 47:12" /></para>
  <para style="s">अकाल अऊर यूसुफ को इन्तजाम</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />ऊ पूरो देश म खान लायी कुछ नहीं रह्यो; कहालीकि अकाल बहुत भारी होतो, अऊर अकाल को वजह मिस्र अऊर कनान दोयी देश भूख को वजह तरस गयो <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />अऊर जितनो रुपया मिस्र अऊर कनान देश म होतो, सब ख यूसुफ ऊ अनाज को बदला, जो उन्को निवासी लेत होतो, उन्ख जमा कर क् फिरौन को भवन म पहुंचाय दियो। <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />जब मिस्र अऊर कनान देश को रुपया खतम भय गयो, तब सब मिस्री यूसुफ को जवर आय क कहन लग्यो, “हम ख खान की चिज दे; का हम रुपया को नहीं रहनो सी तोरो रहतो हुयो मर जाये?”<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />यूसुफ न कह्यो, “यदि रुपया नहाय त अपनो जनावर दे दो, अऊर मय उन्को बदला म तुम्ख खान ख देऊं।” <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />तब हि अपनो जनावर यूसुफ को जवर ले आयो; अऊर यूसुफ उन्ख घोड़ा, शेरी मेंढियां, गाय बईलों अऊर गधा को बदला खान ख देन लग्यो : ऊ साल म ऊ सब जाति को जनावरों को बदला जेवन दे क उन्को पालन पोषन करतो रह्यो।<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />ऊ साल त असोच कट गयो; तब अगले साल म उन्न यूसुफ को जवर आय क कह्यो, “हम अपनो प्रभु सी यो बात छुपाय क नहीं रखबोंन कि हमरो रुपया खतम होय गयो हय, अऊर हमरो हर तरह को जनावर हमरो प्रभु को भय गयो हंय; येकोलायी अब हमरो प्रभु को आगु हमरो शरीर अऊर जमीन छोड़ क कुछ भी नहीं रह्यो। <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />हम तोरो देखतो म कहाली मरबो, अऊर हमरी जमीन कहाली उजड़ जायेंन? हम्ख अऊर हमरी जमीन ख जेवन की चिज को बदला लेय ले, कि हम अपनी जमीन सहीत फिरौन को दास हो : अऊर हम्ख बीज दे कि हम मरनो नहीं पाये, अऊर जीन्दो रहे, अऊर जमीन नहीं उजड़े।”<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />तब यूसुफ न मिस्र की पूरी जमीन ख फिरौन लायी लेय लियो; कहालीकि ऊ भयंकर अकाल को पड़नो सी मिस्रियों ख अपनो अपनो खेत बेच डालनो पड़्यो। यो तरह पूरी जमीन फिरौन की भय गयी; <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />अऊर एक कोना सी ले क दूसरो कोना तक पूरो मिस्र देश म जो प्रजा रहत होती, ओख यूसुफ न नगरों म लाय क बसाय दियो। <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />पर याजकों की जमीन ओन लेय नहीं ली; कहालीकि याजकों लायी फिरौन को तरफ सी लगातार भोजन को बन्दोबस्त होतो, अऊर लगातार जो भोजन फिरौन उन्ख देत होतो उच हि खात होतो, यो वजह उन्ख अपनी जमीन बेचनी नहीं पड़ी। <verse eid="GEN 47:22" /><verse number="23" style="v" sid="GEN 47:23" />तब यूसुफ न प्रजा को लोगों सी कह्यो, “सुनो, मय न अज को दिन तुम ख अऊर तुम्हरी जमीन ख भी फिरौन लायी लेय लियो हय; देखो, तुम्हरो लायी इत बीज हय, येख जमीन म बोवो। <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />अऊर जो कुछ जमीन सी होयेंन ओको पाचवों अंश फिरौन ख देवो, बाकी चार अंश तुम्हरो रहेंन कि तुम ओख अपनो खेतो म बोवो, अऊर अपनो अपनो बाल बच्चां अऊर घर को दूसरो लोगों सहित खायो करो।”<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />उन्न कह्यो, “तय न हम्ख बचाय लियो हय; हमरो प्रभु की अनुग्रह की नजर हम पर बनी रहे, अऊर हम फिरौन को दास होय क रहबोंन।” <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />यो तरह यूसुफ न मिस्र की जमीन को बारे म असो नियम ठहरायो हय, जो अज को दिन तक चल्यो आवय हय कि पाचवों अंश फिरौन ख मिल्यो करे; केवल याजकों कीच जमीन फिरौन की नहीं भयी।<verse eid="GEN 47:26" /></para>
  <para style="s">याकूब की आखरी इच्छा</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />इस्राएली मिस्र को गोशेन प्रदेश म रहन लग्यो; अऊर उत की जमीन उन्को बस म होती; अऊर हि बहुतायत सी बढ़्यो अऊर उन्को कुछ बच्चा भयो। <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />मिस्र देश म याकूब सत्रा साल जीन्दो रह्यो : यो तरह याकूब की पूरी उमर एक सौ सैंतालीस साल की भयी। <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" /><note caller="+" style="x"><char style="xo" closed="false">47:29 </char><char style="xt" closed="false"><ref loc="GEN 49:29-32">उत्पत्ति 49:29-32</ref>; <ref loc="GEN 50:6">50:6</ref></char></note>जब इस्राएल को मरन को दिन जवर आयो, तब ओन अपनो टुरा यूसुफ ख बुलाय क कह्यो, “यदि तोरो अनुग्रह मोरो पर हो, त अपनो हाथ मोरी जांघ पर रख क कसम खा कि तय मोरो संग कृपा अऊर सच्चायी को यो काम करजो कि मोख मिस्र देश म माटी नहीं देजो। <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />जब मय अपनो बापदादों को संग सोय जाऊं, तब तय मोख मिस्र देश सी लिजाय क उन्कोच कब्रस्थान म रखजो।”</para>
  <para style="p" vid="GEN 47:30">तब यूसुफ न कह्यो, “मय तोरो वचन को अनुसार करूं।”<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />तब याकूब न कह्यो, “मोरो सी कसम खा।” तब यूसुफ न ओको सी कसम खायी। तब याकूब न खटिया को मुन्डेसो को तरफ मुंड झुकाय क प्रार्थना करी।<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">याकूब को एप्रैम अऊर आदमी ख आशीर्वाद देनो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />इन बातों को बाद कोयी न यूसुफ सी कह्यो, “सुन तोरो बाप बीमार हय।” तब यूसुफ मनश्शे अऊर एप्रैम नाम को दोयी टुरावों ख संग ले क याकूब को जवर गयो। <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />कोयी न याकूब ख बताय दियो, “तोरो टुरा यूसुफ तोरो जवर आय रह्यो हय,” तब याकूब अपनो ख सम्भाल क खटिया पर बैठ गयो <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" /><note caller="+" style="x"><char style="xo" closed="false">48:3 </char><char style="xt" closed="false"><ref loc="GEN 28:13-14">उत्पत्ति 28:13-14</ref></char></note>अऊर याकूब न यूसुफ सी कह्यो, “सर्वशक्तिमान परमेश्वर न कनान देश को लूज नगर को जवर मोख दर्शन दे क आशीष दी, <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />अऊर कह्यो, ‘सुन, मय तोख फलवन्त कर क् बढ़ाऊं, अऊर तोख राज्य राज्य की मण्डली को मूल बनाऊं, अऊर तोरो बाद तोरो वंश ख यो देश देऊं, जेको सी कि ऊ हमेशा तक उन्की निजी जमीन बनी रहे।’”<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />अऊर अब तोरो दोयी टुरा, “जो मिस्र म मोरो आन को पहिले पैदा भयो हंय, हि मोरोच ठहरेंन; मतलब जो रीति सी रूबेन अऊर शिमोन मोरो हंय, उच रीति सी एप्रैम अऊर मनश्शे भी मोरो ठहरेंन। <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />अऊर उन्को बाद तोरी जो सन्तान पैदा होयेंन ऊ तोरी त ठहरेंन; पर बंटवारा को समय हि अपनो भाऊवों कोच वंश म गिन्यो जायेंन। <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" /><note caller="+" style="x"><char style="xo" closed="false">48:7 </char><char style="xt" closed="false"><ref loc="GEN 35:16-19">उत्पत्ति 35:16-19</ref></char></note>जब मय पद्दान सी आय रह्यो होतो, तब एप्राता नगर पहुंचन सी थोड़ोच दूर पहिले राहेल कनान देश म, रस्ता म, मोरो आगु मर गयी; अऊर मय न ओख उतच, मतलब एप्राता नगर जो बैतलहम भी कहलावय हय, उच रस्ता म माटी दी।”<verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />तब याकूब न यूसुफ को टुरावों ख देख्यो, तब पुच्छ्यो, “हि टुरा कौन आय?”<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />यूसुफ न अपनो बाप सी कह्यो, “हि मोरो टुरा आय, जो परमेश्वर न मोख इत दियो हंय।”</para>
  <para style="p" vid="GEN 48:9">याकूब न कह्यो, “उन्ख मोरो जवर ले आव कि मय उन्ख आशीर्वाद देऊं।” <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />याकूब की आंखी बुढ़ापा को वजह धुन्धरी भय गयी होती, यहां तक कि ओख कम दिखायी देत होतो। तब यूसुफ अपनो टुरावों ख याकूब को जवर लिजायो; अऊर ओन उन्ख चुम क गरो लगाय लियो। <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />तब याकूब न यूसुफ सी कह्यो, “मय न सोच्यो तो नहीं कि मय तोरो मुख फिर सी देखनो पाऊं : पर देख, परमेश्वर न मोख तोरो वंश भी दिखायो हय।” <verse eid="GEN 48:11" /><verse number="12" style="v" sid="GEN 48:12" />यूसुफ न उन्ख अपनो बाप को घुटना को बीच सी हटायो अऊर जमीन को तरफ मुंड झुकाय क दण्डवत करयो।<verse eid="GEN 48:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 48:13" />तब यूसुफ न उन दिनों ख ले क, मतलब एप्रैम ख अपनो दायो हाथ सी कि ऊ याकूब को बायो हाथ पड़े, अऊर मनश्शे ख अपनो बायो हाथ सी कि ऊ याकूब को दायो हाथ पड़े, उन्ख ओको जवर लिजायो। <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />तब याकूब न अपनो दायो हाथ बढ़ाय क एप्रैम की मुंड पर जो छोटो होतो, अऊर अपनो बायो हाथ बढ़ाय क मनश्शे की मुंड पर रख दियो; ओन जान बुझ क असो करयो नहीं त बड़ो मनश्शेच होतो। <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />तब ओन यूसुफ ख आशीर्वाद दे क कह्यो,</para>
  <para style="q1" vid="GEN 48:15">“परमेश्वर जेकी उपस्थिति म रह्य क मोरो बापदादा अब्राहम अऊर इसहाक चल्यो,</para>
  <para style="q1" vid="GEN 48:15">उच परमेश्वर मोरो जनम सी ले क अज को दिन तक मोरो देखभाल करन वालो बन्यो हय;<verse eid="GEN 48:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 48:16" />अऊर उच स्वर्गदूत मोख पूरी बुरायी सी छुड़ातो आयो हय, उच अब इन टुरावों ख आशीष दे;</para>
  <para style="q1" vid="GEN 48:16">अऊर हि मोरो अऊर मोरो बापदादा अब्राहम अऊर इसहाक को कहलाये;</para>
  <para style="q1" vid="GEN 48:16">अऊर धरती म बहुतायत सी बढ़े।”<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />जब यूसुफ न देख्यो कि मोरो बाप न अपनो दायो हाथ एप्रैम की मुंड पर रख्यो हय, तब या बात यूसुफ ख बुरी लगी; येकोलायी ओन अपनो बाप को हाथ यो बिचार सी पकड़ लियो कि एप्रैम की मुंड पर सी उठाय क मनश्शे की मुंड पर रख दे। <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />अऊर यूसुफ न अपनो बाप सी कह्यो, “हे बाप, असो नहीं; कहालीकि बड़ो योच आय; अपनो दायो हाथ येकी मुंड पर रख।”<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />ओको बाप न कह्यो, “नहीं; सुन, हे मोरो टुरा, मय या बात ख अच्छो सी जानु हय : अऊर येको सी भी आदमियों की एक मण्डली पैदा होयेंन, अऊर ऊ भी महान होय जायेंन, तब भी येको छोटो भाऊ येको सी बहुत जादा महान होय जायेंन, अऊर ओको वंश सी बहुत सी जातियां निकलेंन।”<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />तब ओको बाप न उच दिन यो कह्य क उन्ख आशीर्वाद दियो, “इस्राएली लोग तोरो नाम ले ले क असो आशीर्वाद दियो करेंन, ‘परमेश्वर तोख एप्रैम अऊर मनश्शे को जसो बना दे,’” अऊर ओन मनश्शे सी पहिले एप्रैम को नाम लियो।<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />तब याकूब न यूसुफ सी कह्यो, “देख, मय त मरन पर हय : पर परमेश्वर तुम लोगों को संग रहेंन, अऊर तुम ख तुम्हरो पूर्वजों को देश म फिर पहुंचाय देयेंन। <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />अऊर मय तोख तोरो भाऊवों सी जादा जमीन को एक भाग देऊ हय, जेक मय न एमोरी जाति को हाथ सी अपनी तलवार अऊर धनुष की ताकत सी ले लियो हय।”<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">याकूब को आखरी शब्द</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />तब याकूब न अपनो टुरावों ख यो कह्य क बुलायो, “जमा होय जावो, मय तुम ख बताऊं कि आखरी को दिनों म तुम पर का का बीतेंन।<verse eid="GEN 49:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />“हे याकूब को टुरावों, जमा होय क सुनो,</para>
  <para style="q1" vid="GEN 49:2">अपनो बाप याकूब<note caller="+" style="f"><char style="fr" closed="false">49:2 </char><char style="ft" closed="false">इस्राएल</char></note> को तरफ कान लगावो।<verse eid="GEN 49:2" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />“हे रूबेन, तय मोरो पहिलो अऊर बड़ो टुरा आय,</para>
  <para style="q1" vid="GEN 49:3">अऊर मोरो आदमी होन को नाते पहिलो सबूत तयच आय;</para>
  <para style="q1" vid="GEN 49:3">तय मोरो पूरो टुरावों सी बड़ो अभिमानी अऊर ताकतवर तयच हय।<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />तय एक भयंकर बाढ़ की लहर को जसो प्रचण्ड हय,</para>
  <para style="q1" vid="GEN 49:4">येकोलायी तय मोरो पूरो टुरावों सी जादा महत्व को नहीं होय सकजो;</para>
  <para style="q1" vid="GEN 49:4">कहालीकि तय मोरी पत्नी को संग सोयो,</para>
  <para style="q1" vid="GEN 49:4">अऊर तय न अपनो बाप को बिस्तर ख अशुद्ध करयो।<verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />“शिमोन अऊर लेवी भाऊ हंय,</para>
  <para style="q1" vid="GEN 49:5">हि अपनी तलवार हिंसा करन लायी इस्तेमाल करय हंय।<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />हे मोरो जीव, उन्की गुप्त बैठक म मत पड़,</para>
  <para style="q1" vid="GEN 49:6">हे मोरी महिमा, उन्की सभा म मत मिल;</para>
  <para style="q1" vid="GEN 49:6">कहालीकि उन्न गुस्सा म आदमियों ख मार डाल्यो हय,</para>
  <para style="q1" vid="GEN 49:6">अऊर अपनीच इच्छा पर चल क बईलों ख लंगड़ा बनावय हंय।<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />धिक्कार हय उन्को गुस्सा पर, कहालीकि ऊ भयंकर हय;</para>
  <para style="q1" vid="GEN 49:7">अऊर उन्को गुस्सा ख,</para>
  <para style="q1" vid="GEN 49:7">जो निर्दयी होतो;</para>
  <para style="q1" vid="GEN 49:7">मय उन्ख याकूब को देश म अलग अलग अऊर इस्राएल म तितर बितर कर देऊं।<verse eid="GEN 49:7" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />“हे यहूदा, तोरो भाऊ तोरो धन्यवाद करेंन,</para>
  <para style="q1" vid="GEN 49:8">तोरो हाथ तोरो दुश्मनों की गर्दन पर पड़ेंन;</para>
  <para style="q1" vid="GEN 49:8">तोरो बाप को टुरा तोख दण्डवत करेंन।<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">49:9 </char>
      <char style="xt" closed="false">
        <ref loc="REV 5:5">प्रकाशितवाक्य 5:5</ref>; <ref loc="NUM 24:9">गिनती 24:9</ref></char>
    </note>यहूदा सिंह को बच्चा हय। हे मोरो टुरा,</para>
  <para style="q1" vid="GEN 49:9">तय शिकार कर क् गुफा म गयो हय; ऊ सिंह जसो,</para>
  <para style="q1" vid="GEN 49:9">सिंहनी को जसो झुक क बैठ्यो हय;</para>
  <para style="q1" vid="GEN 49:9">तब कौन ओख छेड़ क उठाय सकय हय।<verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />जब तक शीलो नहीं आये तब</para>
  <para style="q1" vid="GEN 49:10">तक राजदण्ड यहूदा सी नहीं छूटेंन,</para>
  <para style="q1" vid="GEN 49:10">अऊर न ओको वंश सी व्यवस्था देन वालो अलग होयेंन;</para>
  <para style="q1" vid="GEN 49:10">अऊर राज्य राज्य को लोग ओकी आज्ञा को पालन करेंन।<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />ऊ अपनो जवान गधा ख अंगूर की बेला म,</para>
  <para style="q1" vid="GEN 49:11">अऊर अपनी गधी को बच्चा ख सब सी अच्छी अंगूर की बेला म बान्ध्यो करेंन; ओन अपनो कपड़ा अंगूर को रस म,</para>
  <para style="q1" vid="GEN 49:11">अऊर अपनो पहिनन वालो कपड़ा अंगूरीरस रस<note caller="+" style="f"><char style="fr" closed="false">49:11 </char><char style="ft" closed="false">अंगूर को खून</char></note> म धोवय हय।<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />ओकी आंखी अंगूर को रस पीवन सी लाल होती,</para>
  <para style="q1" vid="GEN 49:12">अऊर ओको दात दूध सी जादा सफेद हय।<verse eid="GEN 49:12" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />“जबूलून समुन्दर को किनार पर निवास करेंन,</para>
  <para style="q1" vid="GEN 49:13">ऊ जहाजों लायी बन्दरगाह को काम देयेंन,</para>
  <para style="q1" vid="GEN 49:13">अऊर ओको राज्य की सीमा सीदोन देश तक पहुंचेंन।<verse eid="GEN 49:13" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />“इस्साकार एक ताकतवर गधा हय,</para>
  <para style="q1" vid="GEN 49:14">जो जनावरों को झुण्ड को बीच म सोयो रह्य हय।<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />ओन एक आराम की जागा देख क,</para>
  <para style="q1" vid="GEN 49:15">कि अच्छी हय, अऊर एक देश, कि मनोहर हय,</para>
  <para style="q1" vid="GEN 49:15">अपनो बख्खा ख बोझ उठावन लायी झुकायो,</para>
  <para style="q1" vid="GEN 49:15">अऊर बेगारी म दास को जसो काम करन लग्यो।<verse eid="GEN 49:15" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />“दान इस्राएल को एक गोत्र होय क</para>
  <para style="q1" vid="GEN 49:16">अपनो जाति भाऊवों को न्याय करेंन।<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />दान रस्ता म को एक सांप,</para>
  <para style="q1" vid="GEN 49:17">अऊर सड़क को किनार को एक नाग होयेंन,</para>
  <para style="q1" vid="GEN 49:17">जो घोड़ा की एड़ी ख डंसय हय,</para>
  <para style="q1" vid="GEN 49:17">जेको सी ओको सवार पछाड़ खाय क पीछू को तरफ गिर जावय हय।<verse eid="GEN 49:17" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />“हे परमेश्वर, मय तोरो सीच उद्धार पावन की बाट देखत आयो हय।<verse eid="GEN 49:18" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />“गाद पर एक डाकुवों को दल आक्रमन त करेंन;</para>
  <para style="q1" vid="GEN 49:19">पर ऊ पीछू सी उन पर आक्रमन करेंन।<verse eid="GEN 49:19" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />“आशेर सी जो अनाज पैदा होयेंन ऊ उत्तम होयेंन,</para>
  <para style="q1" vid="GEN 49:20">अऊर ऊ राजा को लायक स्वादिष्ट जेवन दियो करेंन।<verse eid="GEN 49:20" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />“नप्ताली एक छूटी हुयी</para>
  <para style="q1" vid="GEN 49:21">हरिन की जसी हय वा सुन्दर बाते बोलय हय।<verse eid="GEN 49:21" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />“यूसुफ फलवन्त डगाली की एक बेला आय, वा झरना को जवर लगी हुयी फलवन्त डगाली की एक बेला आय;</para>
  <para style="q1" vid="GEN 49:22">ओकी डगालियां दीवार पर सी चढ़ क फैल जावय हंय।<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />धनुर्धारियों न ओको पर भयंकर आक्रमन करयो,</para>
  <para style="q1" vid="GEN 49:23">अऊर ओको पर बान छोड्यो, अऊर ओख बहुत जादा सतायो।<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />तब भी ओको धनुष स्थिर रह्यो,</para>
  <para style="q1" vid="GEN 49:24">अऊर ओकी भुजा अऊर हाथ याकूब को उच शक्तिमान परमेश्वर को हाथों को द्वारा फुर्तीलो भयो,</para>
  <para style="q1" vid="GEN 49:24">जेको जवर ऊ चरवाहा आयेंन,</para>
  <para style="q1" vid="GEN 49:24">जो इस्राएल नगर की चट्टान भी ठहरेंन।<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />यो तोरो बाप को ऊ परमेश्वर को नाम आय,</para>
  <para style="q1" vid="GEN 49:25">जो तोरी मदत करेंन,</para>
  <para style="q1" vid="GEN 49:25">ऊ सर्वशक्तिमान को जो तोख ऊपर सी आसमान म की आशीषें,</para>
  <para style="q1" vid="GEN 49:25">अऊर खल्लो सी गहिरो पानी म की आशीषें,</para>
  <para style="q1" vid="GEN 49:25">अऊर स्तनों अऊर गर्भ की आशीषें देयेंन।<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />तोरो बाप को आशीर्वाद,</para>
  <para style="q1" vid="GEN 49:26">मोरो पूर्वजों को आशीर्वादों सी जादा बढ़ गयो हंय अऊर सनातन पहाड़ियों की मनचाही चिजों को जसो बन्यो रहेंन :</para>
  <para style="q1" vid="GEN 49:26">हि यूसुफ की मुंड पर,</para>
  <para style="q1" vid="GEN 49:26">जो अपनो भाऊवों सी अलग करयो गयो होतो,</para>
  <para style="q1" vid="GEN 49:26">ओकोच मुंड को मुकुट पर फूले फलेंन।<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />“बिन्यामीन बहुत खूंखार भेड़िया हय,</para>
  <para style="q1" vid="GEN 49:27">सुबेरे त ऊ शिकार ख फाड़य, अऊर शाम ख लूट को माल बाटय हय।”<verse eid="GEN 49:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />इस्राएल को बारा गोत्र हिच आय : अऊर उन्को बाप न जो जो वचन सी उन्ख आशीर्वाद दियो, ऊ हिच आय; एक एक ख ओको लायक आशीर्वाद को अनुसार ओन आशीर्वाद दियो।<verse eid="GEN 49:28" /></para>
  <para style="s">याकूब को मरनो अऊर गाड़्यो जानो</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />तब ओन यो कह्य क उन्ख आज्ञा दी, “मय अपनो लोगों को संग मिलन पर हय : येकोलायी मोख हित्ती जाति एप्रोन की जमीन वाली गुफा म मोरो बापदादों को संग माटी देजो <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" /><note caller="+" style="x"><char style="xo" closed="false">49:30 </char><char style="xt" closed="false"><ref loc="GEN 23:3-20">उत्पत्ति 23:3-20</ref></char></note>अऊर उच गुफा म जो कनान देश म मम्रे को आगु वाली मकपेला की जमीन म हय; ऊ जमीन ख अब्राहम न हित्ती जाति एप्रोन को हाथ सी येकोच लायी लेय लियो होतो कि ऊ कब्रस्थान लायी ओकी निजी जमीन हो। <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" /><note caller="+" style="x"><char style="xo" closed="false">49:31 </char><char style="xt" closed="false"><ref loc="GEN 35:29">उत्पत्ति 35:29</ref></char></note>उत अब्राहम अऊर ओकी पत्नी सारा ख माटी दी गयी होती, अऊर उतच इसहाक अऊर ओकी पत्नी रिबका ख भी माटी दी गयी होती; अऊर उतच मय न लिआ : ख भी माटी दी। <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />ऊ जमीन अऊर ओको म की गुफा हित्तियों को हाथ सी ले ली होती।” <verse eid="GEN 49:32" /><verse number="33" style="v" sid="GEN 49:33" /><note caller="+" style="x"><char style="xo" closed="false">49:33 </char><char style="xt" closed="false"><ref loc="ACT 7:15">प्रेरितों 7:15</ref></char></note>याकूब जब अपनो टुरावों ख यो आज्ञा दे चुक्यो, तब अपनो पाय खटिया पर जमा कर क् जीव छोड़्यो, अऊर अपनो लोगों म जाय मिल्यो।<verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />तब यूसुफ अपनो बाप को मुंह पर गिर क रोयो अऊर अपनो बाप ख चुम्यो। <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />अऊर यूसुफ न उन बैद्यों ख, जो ओको सेवक होतो, आज्ञा दी कि ओको बाप को शव म सुगन्ध की चिज भरे। तब बैद्यों न याकूब को शव म सुगन्ध की चिज भर दियो। <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />अऊर ओको चालीस दिन पूरो भयो, कहालीकि जिन्को शव म सुगन्ध की चिज भरी जावय हंय, उन्ख इतनोच दिन पूरो लगय हंय : अऊर मिस्री लोग ओको लायी सत्तर दिन तक शोक मनातो रह्यो।<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />जब ओको शोक को दिन बीत गयो, तब यूसुफ फिरौन को घराना सी कहन लग्यो, “यदि तुम्हरी अनुग्रह की नजर मोरो पर हो त मोरो सन्देश फिरौन ख सुनावो, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" /><note caller="+" style="x"><char style="xo" closed="false">50:5 </char><char style="xt" closed="false"><ref loc="GEN 37:29-31">उत्पत्ति 37:29-31</ref></char></note>मोरो बाप न यो कह्य क, मोख यो कसम खिलायी, ‘देख मय मरन पर हय,’ ‘जो कब्र मय न अपनो लायी कनान देश म खुदवायी हय ओकोच म मोख तय माटी देजो।’ येकोलायी अब मोख उत जाय क अपनो बाप ख माटी देन की आज्ञा दे, ओको बादच म लौट आऊं।”<verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />तब फिरौन न कह्यो, “जाय क अपनो बाप की खिलायी हुयी कसम को अनुसार ओख माटी दे।”<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />येकोलायी यूसुफ अपनो बाप ख माटी देन लायी चली गयो, अऊर फिरौन को सब काम करन वालो अऊर ओको भवन को मुखिया अऊर मिस्र देश को सब मुखिया ओको संग चल्यो, <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />अऊर यूसुफ को घर को सब लोग अऊर ओको भाऊ अऊर ओको बाप को घर को सब लोग भी संग गयो; पर हि अपनो बाल बच्चां, शेरी मेंढियों, अऊर गाय बईल ख गोशेन प्रदेश म छोड़ गयो। <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />अऊर यूसुफ को संग रथ अऊर घुड़सवार भी गयो, यो तरह शव यात्रा म भीड़ बहुत भारी भय गयी।<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />जब हि आताद को खरियान तक, जो यरदन नदी को पार हय, उत पहुंच्यो, तब उत बहुत शोक मनायो; अऊर यूसुफ न अपनो बाप लायी सात दिन तक शोक करयो। <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />आताद को खरियान म को शोक ख देख क ऊ नगर को निवासी कनानियों न कह्यो, “यो त मिस्रियों को कोयी भारी शोक होना।” योच वजह ऊ जागा को नाम आबेलमिस्रैम<note caller="+" style="f"><char style="fr" closed="false">50:11 </char><char style="ft" closed="false">मिस्री लोगों को विलाप</char></note> पड़्यो, अऊर ऊ यरदन को पार हय।<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />याकूब को टुरावों न ठीक उच काम करयो, जसो ओन उन्ख आज्ञा दी होती <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" /><note caller="+" style="x"><char style="xo" closed="false">50:13 </char><char style="xt" closed="false"><ref loc="ACT 7:16">प्रेरितों 7:16</ref></char></note>अऊर उन्न याकूब ख कनान देश म ले जाय क मकपेला की ऊ जमीन वाली गुफा म, जो मम्रे को आगु हय, उत माटी दी; जेक अब्राहम न हित्ती एप्रोन को हाथ सी येकोलायी लेय लियो होतो कि ऊ कब्रस्थान लायी ओकी निजी जमीन हो।<verse eid="GEN 50:13" /></para>
  <para style="s">यूसुफ को अपनो भाऊवों ख दिलासा देनो</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 50:14" />अपनो बाप ख माटी दे क यूसुफ अपनो भाऊवों अऊर उन सब को संग, जो ओको बाप ख माटी देन लायी ओको संग गयो होतो, उन सब को संग मिस्र लौट आयो। <verse eid="GEN 50:14" /><verse number="15" style="v" sid="GEN 50:15" />जब यूसुफ को भाऊवों न देख्यो कि हमरो बाप मर गयो हय, तब कहन लग्यो, “अब शायद यूसुफ हमरो सी नफरत करे, अऊर जितनी बुरायी हम न ओको सी करी होती सब को बदला हम सी लेयेंन?” <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />येकोलायी उन्न यूसुफ को जवर एक सन्देश भेज्यो, “तोरो बाप न मरनो सी पहिले हम्ख यो आज्ञा दी होती <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />‘तुम लोग यूसुफ सी यो तरह कहो, कि हम बिनती करजे हंय कि तय अपनो भाऊवों को अपराध अऊर पाप ख माफ कर; हम न तोरो सी बुरायी करी होती, पर अब अपनो बाप को परमेश्वर को दासों को अपराध माफ कर’।” उन्की या बाते सुन क यूसुफ रोय पड़्यो।<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />अऊर ओको भाऊ खुद भी जाय क ओको आगु गिर पड़्यो, अऊर कह्यो, “देख, हम तोरो दास हंय।”<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />यूसुफ न उन्को सी कह्यो, “मत डरो, का मय परमेश्वर की जागा पर हय? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />हालांकि तुम लोगों न मोरो लायी बुरायी को बिचार करयो होतो; पर परमेश्वर न उच बात म भलायी को बिचार करयो, जेको सी ऊ असो करे, जसो अज को दिन प्रगट हय, कि बहुत सो लोगों को जीव बच्यो हंय। <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />येकोलायी अब मत डरो; मय तुम्हरो अऊर तुम्हरो बाल बच्चां को पालन पोषन करतो रहूं।” यो तरह यूसुफ न उन्ख समझाय-बुझाय क शान्ति दी।<verse eid="GEN 50:21" /></para>
  <para style="s">यूसुफ को मरनो</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />यूसुफ अपनो बाप को घराना सहीत मिस्र देश म निवास करतो रह्यो, अऊर यूसुफ एक सौ दस साल जीन्दो रह्यो। <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />अऊर यूसुफ न एप्रैम की सन्तान ख तीसरी पीढ़ी तक देख्यो; अऊर मनश्शे को नाती, जो माकीर को टुरा होतो, हि पैदा भयो अऊर यूसुफ न उन्ख गोदी म लियो। <verse eid="GEN 50:23" /><verse number="24" style="v" sid="GEN 50:24" />यूसुफ न अपनो भाऊवों सी कह्यो, “मय त मरन पर हय; पर परमेश्वर जरूरच तुम्हरी चिन्ता करेंन, अऊर तुम्ख यो देश सी निकाल क ऊ देश म पहुंचाय देयेंन, जेक देन की ओन अब्राहम, इसहाक, अऊर याकूब सी कसम खायी होती।” <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" /><note caller="+" style="x"><char style="xo" closed="false">50:25 </char><char style="xt" closed="false"><ref loc="HEB 11:22">इब्रानियों 11:22</ref>; <ref loc="EXO 13:19">निर्गमन 13:19</ref>; <ref loc="JOS 24:32">यहोशू 24:32</ref></char></note>तब यूसुफ न अपनो लोगों सी एक प्रतिज्ञा करन ख कह्यो। यूसुफ न कह्यो, “मोरो सी प्रतिज्ञा करो कि जब परमेश्वर तुम लोगों ख नयो देश म लिजायेंन तब तुम भी मोरी अस्थियां अपनो संग लिजावों।” <verse eid="GEN 50:25" /><verse number="26" style="v" sid="GEN 50:26" />यो तरह यूसुफ एक सौ दस साल को होय क मर गयो; अऊर ओको शव म सुगन्ध की चिज भरी गयी, अऊर ऊ शव मिस्र देश म एक सन्दूक म रख्यो गयो।<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>