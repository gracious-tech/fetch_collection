<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LEV" style="id">- Lodhi</book>
  <para style="h">लैव्यव्यवस्था</para>
  <para style="toc3">लैव्यव्यवस्था</para>
  <para style="toc2">लैव्यव्यवस्था</para>
  <para style="toc1">लैव्यव्यवस्था</para>
  <para style="mt2">लैव्यव्यवस्था</para>
  <para style="mt1">लैव्यव्यवस्था</para>
  <para style="imt">परिचय</para>
  <para style="ip">लैव्यव्यवस्था की किताब उन नियमों सी बनी हय जिन्ख परमेश्वर न मूसा को द्वारा इस्राएलियों ख दियो होतो। यो नियम बलिदानों अऊर भेंट ख चढ़ावन अऊर मिलाप वालो तम्बू म आराधना को नियम ख नियमित करन सी सम्बन्धित हय। “लैव्यव्यवस्था” शब्द को अर्थ हय “लेवियों सी सम्बन्धित,” जो इस्राएल को ऊ कुल होतो जेख परमेश्वर न याजक बनन अऊर आराधनालय की देखभाल करन लायी चुन्यो होतो। परंपरागत रूप सी विद्वानों को माननो हय कि लैव्यव्यवस्था की किताब, अऊर संग म पंचग्रंथ की दूसरी किताबे उत्पत्ति, निर्गमन, गिनती, अऊर व्यवस्थाविवरण भविष्यवक्ता को द्वारा लिखी गयी होती। असो मान्यो जावय हय कि खुद ग्रंथ भी येको तरफ इसारा करय हय, कहालीकि <char style="xt"><ref loc="LEV 1:1">लैव्यव्यवस्था १:१</ref></char> म लिख्यो हय कि परमेश्वर न हि बाते मूसा सी कहीं होती। कुछ विद्वानों को यो भी माननो हय कि या किताब प्राचीन चिट्ठियों सी एकजुट होय क ५ वी यां ६ वी शताब्दी ई. पहले म बेबीलोन म तैयार करी गयी होती।</para>
  <para style="ip">लैव्यव्यवस्था की सुरूवात म हम पढ़जे हय कि परमेश्वर न याजकों ख अलग अलग तरह को बलिदान चढ़ावन को आदेश दियो। इन्म सी कुछ बलिदान लोगों को पापों को लायी चढ़ायो जावय हय। दूसरो बलिदान खुद की इच्छा सी, कोयी व्यक्ति को परमेश्वर को प्रति प्रेम को वजह चढ़ायो जाय सकत होतो। हर स्तिथि म यो जरूरी होतो कि बलिदान शुद्ध अऊर दोषरहित होय, मतलब व्यक्ति को तरफ सी बहुत अच्छो होय। यो साफ रूप सी परमेश्वर की पवित्रता ख दर्शावत होतो। किताब को आखरी भाग म यो समझायो गयो हय कि इस्राएली अऊर याजक कसो शुद्ध रह्य सकय हंय यां फिर कसो अशुद्धता सी शुद्ध होय सकय हंय। या किताब को मुख्य विषय यो हय कि परमेश्वर पवित्र हय, अऊर या किताब म दियो गयो नियमों को पालन कर क् इस्राएली परमेश्वर की मौजूदगी म रह्य सकत होतो।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. अलग अलग तरह को बलिदान चढ़ावन को आदेश दियो गयो हंय। <char style="ior"><ref loc="LEV 1:1-7:38">१:१–७:३८</ref></char></para>
  <para style="io1">२. हारून अऊर ओको टुरावों ख याजक चुन्यो जान को बारे म वर्नन हय। <char style="ior"><ref loc="LEV 8:1-10:20">८:१–१०:२०</ref></char></para>
  <para style="io1">३. शुद्ध अऊर अशुद्ध भोजन यां बिमारियों को बारे म विधियां दी गयी हंय। <char style="ior"><ref loc="LEV 11:1-16:34">११:१–१६:३४</ref></char></para>
  <para style="io1">४. भोजन, त्यौहार, नैतिक व्यवहार अऊर आराम सालों जसो विषयों पर अलग अलग कयी आदेश बतायो गयो हंय। <char style="ior"><ref loc="LEV 17:1-27:34">१७:१–२७:३४</ref></char></para>
  <chapter number="1" style="c" sid="LEV 1" />
  <para style="s">होमबलि की विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 1:1" />परमेश्वर न मूसा ख बुलाय क मिलाप वालो तम्बू म सी ओको सी कह्यो, <verse eid="LEV 1:1" /><verse number="2" style="v" sid="LEV 1:2" />इस्राएलियों सी कह्य कि तुम म सी यदि कोयी आदमी परमेश्वर को लायी पशु को चढ़ावा चढ़ाये,</para>
  <para style="p" vid="LEV 1:2">त ओको बलिपशु पालतु जनावर यां मेंढा-शेरियों को झुण्ड म सी एक को हो। <verse eid="LEV 1:2" /><verse number="3" style="v" sid="LEV 1:3" />“यदि ऊ गाय-बईलों म सी होमबलि करे, त निर्दोष नर मिलाप वालो तम्बू को द्वार पर चढ़ाये कि परमेश्वर ओख स्विकार करे। <verse eid="LEV 1:3" /><verse number="4" style="v" sid="LEV 1:4" />ऊ अपनो हाथ होमबलिपशु को मुंड पर रखे, अऊर ऊ ओको लायी प्रायश्चित कर क् स्विकार करे। <verse eid="LEV 1:4" /><verse number="5" style="v" sid="LEV 1:5" />तब ऊ बछड़ा ख परमेश्वर को आगु बलि करे; अऊर हारून को टुरा जो याजक हंय हि खून ख वेदी को जवर लिजाय क ऊ वेदी को चारयी तरफ छिड़के जो मिलाप वालो तम्बू को फाटक पर हय।” <verse eid="LEV 1:5" /><verse number="6" style="v" sid="LEV 1:6" />फिर ऊ होमबलिपशु की खाल निकाल क ऊ पशु ख तुकड़ा-तुकड़ा करे; <verse eid="LEV 1:6" /><verse number="7" style="v" sid="LEV 1:7" />तब हारून याजक को टुरा वेदी पर आगी रखे, अऊर आगी पर लकड़ी सजाय क रखे; <verse eid="LEV 1:7" /><verse number="8" style="v" sid="LEV 1:8" />अऊर हारून को टुरा जो याजक हय हि मुंड अऊर चरबी समेत पशु को टुकड़ा ख ऊ लकड़ी पर जो वेदी की आगी पर होना सजाय क रखे; <verse eid="LEV 1:8" /><verse number="9" style="v" sid="LEV 1:9" />अऊर ऊ ओकी आंतड़ियों अऊर पाय ख पानी सी धोये। तब याजक सब ख वेदी पर जलाये कि ऊ होमबलि परमेश्वर को लायी सुखदायक सुगन्ध वालो बलिदान ठहरे।<verse eid="LEV 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 1:10" />यदि ऊ झुण्ड म सी मेंढी यां शेरियों की होमबलि चढ़ाये त पूरो तरह सी स्वस्थ नर जनावर ख चढ़ाये; <verse eid="LEV 1:10" /><verse number="11" style="v" sid="LEV 1:11" />अऊर ऊ ओख परमेश्वर को आगु वेदी को उत्तर को तरफ बलि करे; अऊर हारून को टुरा जो याजक हंय हि ओको खून ख वेदी को चारयी तरफ छिड़के। <verse eid="LEV 1:11" /><verse number="12" style="v" sid="LEV 1:12" />अऊर ऊ ओख तुकड़ा-तुकड़ा करे, अऊर मुंड अऊर चरबी ख अलग करे, अऊर याजक इन सब ख ऊ लकड़ी पर सजाय क रखे जो वेदी की आगी पर होना; <verse eid="LEV 1:12" /><verse number="13" style="v" sid="LEV 1:13" />अऊर ऊ ओकी आंतड़ियों अऊर पाय ख पानी सी धोये। अऊर याजक सब ख जवर लिजाय क वेदी पर जलाये कि ऊ होमबलि अऊर यहोवा को लायी सुखदायक सुगन्ध वालो बलिदान ठहरे।<verse eid="LEV 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 1:14" />यदि ऊ परमेश्वर को लायी पक्षियों की होमबलि चढ़ाये, त पण्डुकों यां कबूतरों को चढ़ावा चढ़ाये। <verse eid="LEV 1:14" /><verse number="15" style="v" sid="LEV 1:15" />याजक ओख वेदी को जवर लिजाय क ओको गलो मुरकट क मुंड ख धड़ सी अलग करे, अऊर वेदी पर जलाये; अऊर ओको पूरो खून ऊ वेदी को बाजू म गिरायो जाये; <verse eid="LEV 1:15" /><verse number="16" style="v" sid="LEV 1:16" />अऊर ऊ ओकी गल-थैली ख पंखों क वेदी को पूर्व को तरफ राख डालन को जागा पर फेंक दे; <verse eid="LEV 1:16" /><verse number="17" style="v" sid="LEV 1:17" />अऊर ऊ ओख पंखा को बीच सी फाड़े, पर अलग-अलग नहीं करे। तब याजक ओख वेदी पर ऊ लकड़ी को ऊपर रख क जो आगी पर होना जलाये कि ऊ होमबलि अऊर परमेश्वर को लायी सुखदायक सुगन्ध वालो बलिदान ठहरे।<verse eid="LEV 1:17" /></para>
  <chapter eid="LEV 1" />
  <chapter number="2" style="c" sid="LEV 2" />
  <para style="s">अनाज भेंट करन की विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 2:1" />अब कोयी परमेश्वर लायी अनाज की भेंट को चढ़ावा चढ़ानो चाहे, त ऊ मैदा‍ चढ़ाये; अऊर ओको ऊपर तेल डाल क ओको ऊपर लुभान रखे; <verse eid="LEV 2:1" /><verse number="2" style="v" sid="LEV 2:2" />अऊर ऊ ओख हारून को टुरा को जवर जो याजक हंय लाये। अऊर अनाज की भेंट को तेल मिल्यो हुयो मैदा म सी यो तरह अपनी मुट्ठी भर क निकाले कि लुभान ओको म आय जाये; अऊर याजक उन्ख याद दिलावन वालो हिस्सा लायी वेदी पर जलाये कि यो परमेश्वर लायी सुखदायक सुगन्धित भेंट ठहरे। <verse eid="LEV 2:2" /><verse number="3" style="v" sid="LEV 2:3" />अऊर अनाज की भेंट म सी जो बच्यो रहे ऊ हारून अऊर ओको टुरावों को ठहरे; यो परमेश्वर की भेंटों म सी परमपवित्र हिस्सा होयेंन।<verse eid="LEV 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 2:4" />“जब तय अनाज की भेंट लायी चुलो म पकायो हुयो चढ़ावा चढ़ाये, त ऊ तेल सी सान्यो हुयो अखमीरी मैदा कि रोटियां यां तेल लगायी हुयी रोटियों को होना।”<verse eid="LEV 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 2:5" />अऊर यदि तोरो चढ़ावा तवा पर पकायो हुयो अनाज की भेंट होना, त ऊ तेल सी सान्यो हुयो अखमीरी मैदा को होना; <verse eid="LEV 2:5" /><verse number="6" style="v" sid="LEV 2:6" />ओख तुकड़ा तुकड़ा कर क् ओको पर तेल डालजो, तब ऊ अनाज की भेंट होय जायेंन।<verse eid="LEV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 2:7" />अऊर यदि तोरो चढ़ावा कढ़ाही म तल्यो हुयो अनाज की भेंट होना, त ऊ मैदा सी तेल म बनायो जाय। <verse eid="LEV 2:7" /><verse number="8" style="v" sid="LEV 2:8" />अऊर जो अनाज की भेंट इन चिजों म सी कोयी को बन्यो होना ओख परमेश्वर को जवर लि जावो; अऊर जब ऊ याजक को जवर लायो जाय, तब याजक ओख वेदी को जवर लि जाये। <verse eid="LEV 2:8" /><verse number="9" style="v" sid="LEV 2:9" />अऊर याजक अनाज की भेंट म सी याद दिलावन वालो हिस्सा निकाल क वेदी पर जलाये कि ऊ परमेश्वर को लायी सुखदायक सुगन्ध वालो अग्नि भेंट ठहरे; <verse eid="LEV 2:9" /><verse number="10" style="v" sid="LEV 2:10" />अऊर अनाज की भेंट म सी जो बच्यो रहे ऊ हारून अऊर ओको टुरावों को ठहरे; ऊ परमेश्वर को अग्नि भेंटों म परमपवित्र हिस्सा होयेंन।<verse eid="LEV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 2:11" />“कोयी अनाज की भेंट जेक तुम परमेश्वर को लायी चढ़ावो, खमीर मिलाय क बनायो नहीं जाय; तुम कभी वेदी म परमेश्वर लायी खमीर अऊर शहेद मत जलावो।” <verse eid="LEV 2:11" /><verse number="12" style="v" sid="LEV 2:12" />तुम इन ख पहली फसल को चढ़ावा कर क् परमेश्वर लायी चढ़ावो, पर हि सुखदायक सुगन्ध लायी वेदी पर चढ़ायो नहीं जाय। <verse eid="LEV 2:12" /><verse number="13" style="v" sid="LEV 2:13" />फिर अपनो सब अनाज की भेंटों ख नमकीन बनावो; अऊर अपनो कोयी अनाज की भेंट अपनो परमेश्वर को संग बन्धी हुयी वाचा को नमक सी रहित होनो नहीं देजो; अपनो सब चढ़ावा को संग नमक भी चढ़ावो। <verse eid="LEV 2:13" /><verse number="14" style="v" sid="LEV 2:14" />“यदि तय परमेश्वर को लायी पहली फसल को अनाज की भेंट चढ़ाये, त अपनी पहली फसल को अनाज की भेंट को लायी आगी म भुजी हुयी हरी-हरी लोम्ब, मतलब हरी-हरी लोम्बा को दाना ख कुस कर क् निकाल लेजो, तब अनाज ख चढ़ावो। <verse eid="LEV 2:14" /><verse number="15" style="v" sid="LEV 2:15" />अऊर ओको म तेल डालजो, अऊर ओको पर लुभान रखजो; तब ऊ अनाज की भेंट होय जायेंन। <verse eid="LEV 2:15" /><verse number="16" style="v" sid="LEV 2:16" />अऊर याजक छिलका निकाल्यो हुयो अनाज ख, अऊर तेल ख, अऊर पूरो लुभान ख याद दिलावन वालो हिस्सा कर क् ख जलाय दे; ऊ परमेश्वर लायी वेदी की अग्नि ठहरे।<verse eid="LEV 2:16" /></para>
  <chapter eid="LEV 2" />
  <chapter number="3" style="c" sid="LEV 3" />
  <para style="s">मेल-मिलाप बलिदान की विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 3:1" />“यदि ओको चढ़ावा मेल-मिलाप बलिदान को होना, अऊर यदि पालतु जनावर म सी कोयी ख चढ़ाये, चाहे ऊ पशु नर यां मादा, जो पूर्ण स्वस्थ होना ओखच ऊ परमेश्वर को आगु चढ़ाये। <verse eid="LEV 3:1" /><verse number="2" style="v" sid="LEV 3:2" />अऊर ऊ अपनो हाथ अपनो चढ़ावा को पशु को मुंड पर रखे अऊर ओख मिलाप वालो तम्बू को फाटक पर बलि करे; अऊर हारून को टुरा जो याजक हंय हि ओको खून ख वेदी को चारयी तरफ छिड़के। <verse eid="LEV 3:2" /><verse number="3" style="v" sid="LEV 3:3" />अऊर ऊ मेल-मिलाप बलिदान म सी परमेश्वर लायी वेदी की आगी अर्पन करे, मतलब जो चर्बी सी अतड़ियां झकी रह्य हय, अऊर जो चरबी ओको म लिपटी रह्य हय वा भी, <verse eid="LEV 3:3" /><verse number="4" style="v" sid="LEV 3:4" />अऊर दोयी गुड़दा अऊर उन्को ऊपर की चरबी जो कमर को जवर रह्य हय, अऊर गुड़दा समेत कलेजा को ऊपर की झिल्ली, इन सब ख ऊ अलग करे। <verse eid="LEV 3:4" /><verse number="5" style="v" sid="LEV 3:5" />तब हारून को टुरा इन ख वेदी पर ऊ होमबलि को ऊपर जलाये, जो उन लकड़ियों पर होना जो आगी को ऊपर हय कि यो परमेश्वर लायी सुखदायक सुगन्ध वालो भेंट ठहरे।<verse eid="LEV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 3:6" />“यदि परमेश्वर को मेल-मिलाप बलिदान लायी ओको चढ़ावा पालतु मेंढी-शेरियों को झुण्ड म सी होना, त चाहे ऊ नर होना यां मादा, पर जो पूर्ण स्वस्थ होना ओखच ऊ चढ़ाये। <verse eid="LEV 3:6" /><verse number="7" style="v" sid="LEV 3:7" />यदि ऊ मेंढी को बच्चा चढ़ावय हय, त ओख परमेश्वर को सामने चढ़ाये, <verse eid="LEV 3:7" /><verse number="8" style="v" sid="LEV 3:8" />अऊर ऊ अपनो चढ़ावा को पशु को मुंड पर हाथ रखे अऊर ओख मिलाप वालो तम्बू को सामने बलि करे; अऊर हारून को टुरा ओको खून ख वेदी को चारयी छिड़के। <verse eid="LEV 3:8" /><verse number="9" style="v" sid="LEV 3:9" />तब मेल-मिलाप बलिदान म सी चरबी ख परमेश्वर लायी भेंट करे, मतलब ओकी चरबी भरी पूछ ख ऊ रीढ़ को जवर सी अलग करे, अऊर जो चरबी सी अतड़ियां झकी रह्य हंय, अऊर जो चरबी उन म लिपटी रह्य हय, <verse eid="LEV 3:9" /><verse number="10" style="v" sid="LEV 3:10" />अऊर दोयी गुड़दा, अऊर जो चरबी ओको ऊपर कमर को जवर रह्य हय, अऊर गुड़दावो समेत कलेजा को ऊपर की झिल्ली, इन सब ख अलग करे। <verse eid="LEV 3:10" /><verse number="11" style="v" sid="LEV 3:11" />अऊर याजक उन्ख वेदी पर जलाये; यो परमेश्वर लायी हव्यरूपी भोजन ठहरे।<verse eid="LEV 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 3:12" />“यदि ऊ शेरी चढ़ाये, त ओख परमेश्वर को सामने चढ़ाये। <verse eid="LEV 3:12" /><verse number="13" style="v" sid="LEV 3:13" />अऊर ऊ अपनो हाथ ओको मुंड पर रखे, अऊर ओख मिलाप वालो तम्बू को आगु बलि करे; अऊर हारून को टुरा ओको खून ख वेदी को चारयी तरफ छिड़के। <verse eid="LEV 3:13" /><verse number="14" style="v" sid="LEV 3:14" />तब ऊ ओको म सी अपनो चढ़ावा परमेश्वर लायी भेंट कर क् चढ़ाये, मतलब जो चरबी सी अतड़ियां झकी रह्य हय, अऊर जो चरबी उन म लिपटी रह्य हय ऊ भी, <verse eid="LEV 3:14" /><verse number="15" style="v" sid="LEV 3:15" />अऊर दोयी गुड़दा अऊर जो चरबी ओको ऊपर कमर को जवर रह्य हय, अऊर गुड़दावो समेत कलेजा को ऊपर की झिल्ली, इन सब ख अलग करे। <verse eid="LEV 3:15" /><verse number="16" style="v" sid="LEV 3:16" />अऊर याजक इन ख वेदी पर जलाये; यो हव्यरूपी भोजन हय जो सुखदायक सुगन्ध लायी होवय हय; कहालीकि पूरी चरबी परमेश्वर की आय। <verse eid="LEV 3:16" /><verse number="17" style="v" sid="LEV 3:17" />यो तुम्हरो निवासों म तुम्हरी पीढ़ी सी पीढ़ी तक लायी हमेशा की विधि ठहरेंन कि तुम चरबी अऊर खून कभी नहीं खावो।”<verse eid="LEV 3:17" /></para>
  <chapter eid="LEV 3" />
  <chapter number="4" style="c" sid="LEV 4" />
  <para style="s">पापबलि की विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 4:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 4:1" /><verse number="2" style="v" sid="LEV 4:2" />इस्राएलियों सी यो कह्य कि यदि कोयी आदमी उन कामों म सी जिन्ख परमेश्वर न मना करयो हय, उन म सी एक कोयी काम ख भूल सी कर क् पापी होय जाये;<verse eid="LEV 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 4:3" />अऊर यदि अभिषिक्त याजक असो पाप करय हय, त प्रजा दोषी ठहरय हय, त अपनो पाप को वजह एक जवान बईल परमेश्वर ख पापबलि कर क् चढ़ाये। <verse eid="LEV 4:3" /><verse number="4" style="v" sid="LEV 4:4" />ऊ बईल ख मिलाप वालो तम्बू को फाटक पर परमेश्वर को सामने लिजाय क ओको मुंड पर हाथ रख क परमेश्वर को सामने बलि करे। <verse eid="LEV 4:4" /><verse number="5" style="v" sid="LEV 4:5" />अऊर अभिषिक्त याजक बईल को खून म सी कुछ ले क मिलाप वालो तम्बू म लिजाये; <verse eid="LEV 4:5" /><verse number="6" style="v" sid="LEV 4:6" />अऊर याजक अपनो बोट खून म डुबाय क अऊर ओको म सी कुछ अंश ले क पवित्र जागा को बीच वालो परदा को सामने परमेश्वर को सामने सात बार छिड़के। <verse eid="LEV 4:6" /><verse number="7" style="v" sid="LEV 4:7" />अऊर याजक ऊ खून म सी कुछ अंश सुगन्धित धूप की वेदी को सींगो पर जो मिलाप वालो तम्बू म हय परमेश्वर को सामने लाये; फिर बईल को सब खून ख होमबलि की वेदी जो मिलाप वालो तम्बू को फाटक हय कुड़ाय दे। <verse eid="LEV 4:7" /><verse number="8" style="v" sid="LEV 4:8" />फिर ऊ पापबलि को बईल की सब चरबी ख ओको सी अलग करे, मतलब जो चरबी सी अतड़ियां झकी रह्य हय, अऊर जितनी चरबी ओको म लिपटी रह्य हय, <verse eid="LEV 4:8" /><verse number="9" style="v" sid="LEV 4:9" />अऊर दोयी गुड़दा अऊर उन्को ऊपर की चरबी जो कमर को जवर रह्य हय, अऊर गुड़दा समेत कलेजा को ऊपर झिल्ली, इन सब ख ऊ असो अलग करे, <verse eid="LEV 4:9" /><verse number="10" style="v" sid="LEV 4:10" />अऊर मेल-मिलाप बलिदान वालो चढ़ावा को जनावर सी अलग करयो जावय हय, अऊर याजक उन्ख होमबलि की वेदी पर जलायेंन। <verse eid="LEV 4:10" /><verse number="11" style="v" sid="LEV 4:11" />पर ऊ बईल की खाल, पाय, मुंड, अतड़ियां, गोबर, <verse eid="LEV 4:11" /><verse number="12" style="v" sid="LEV 4:12" />बईल को पूरो बच्यो हिस्सा ख छावनी सी बाहेर शुद्ध जागा म, जहां राख डाली जावय हय, अऊर ओख लकड़ी पर रख क जलाय दे; जहां राख डाली जावय हय वहांच ओख जलायो जाय।<verse eid="LEV 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 4:13" />यदि इस्राएल की पूरी मण्डली अज्ञानता को वजह पाप करे अऊर वा बात मण्डली की आंखी सी लूकी होना, अऊर परमेश्वर न पाप नहीं करन को आदेश दियो हय, यदि असो होवय हय त ऊ दोषी ठहरेंन; <verse eid="LEV 4:13" /><verse number="14" style="v" sid="LEV 4:14" />त जब ओको करयो हुयो पाप प्रगट होय जाये तब मण्डली एक बईल ख पापबलि कर क् चढ़ाये। ऊ ओख मिलाप वालो तम्बू को सामने लि जाय, <verse eid="LEV 4:14" /><verse number="15" style="v" sid="LEV 4:15" />अऊर मण्डली को बुजूर्ग लोग अपनो अपनो हाथों ख परमेश्वर को सामने बईल को मुंड पर रखे, अऊर ऊ बईल परमेश्वर को सामने बलि करयो जाय। <verse eid="LEV 4:15" /><verse number="16" style="v" sid="LEV 4:16" />तब अभिषिक्त याजक बईल को खून म सी कुछ मिलाप वालो तम्बू म लि जाय; <verse eid="LEV 4:16" /><verse number="17" style="v" sid="LEV 4:17" />अऊर याजक अपनो बोट खून म डुबाय क ओख बीच वालो परदा को सामने सात बार परमेश्वर को सामने छिड़के। <verse eid="LEV 4:17" /><verse number="18" style="v" sid="LEV 4:18" />अऊर उच खून म सी वेदी को सींगो पर जो परमेश्वर को सामने मिलाप वालो तम्बू म हय लगाये; अऊर बच्यो हुयो सब खून होमबलि की वेदी की पाया पर जो मिलाप वालो तम्बू को फाटक पर हय कुड़ाय दे। <verse eid="LEV 4:18" /><verse number="19" style="v" sid="LEV 4:19" />अऊर ऊ बईल की सब चरबी निकाल क वेदी पर जलाये। <verse eid="LEV 4:19" /><verse number="20" style="v" sid="LEV 4:20" />जसो पापबलि को बईल सी करयो होतो वसोच येको सी भी करे; यो तरह याजक इस्राएलियों को पापों ख झाके, तब ओको ऊ पाप माफ करयो जायेंन। <verse eid="LEV 4:20" /><verse number="21" style="v" sid="LEV 4:21" />अऊर ऊ बईल ख छावनी सी बाहेर लिजाय क उच तरह जलाये जसो पहिलो बईल ख जलायो होतो; वसोच यो मण्डली लायी पापबलि ठहरेंन।<verse eid="LEV 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 4:22" />जब कोयी मुखिया पाप कर क्, मतलब अपनो परमेश्वर यहोवा की कोयी आज्ञा को खिलाफ भूल सी कुछ कर क् दोषी होय जाये, <verse eid="LEV 4:22" /><verse number="23" style="v" sid="LEV 4:23" />अऊर ओको पाप ओको पर प्रगट होय जाये। त ऊ एक निर्दोष बकरा बलिदान करन लायी ले जाय; <verse eid="LEV 4:23" /><verse number="24" style="v" sid="LEV 4:24" />अऊर बकरा को मुंड पर अपनो हाथ रखे, अऊर बकरा ख वा जागा पर बलि करे जहां होमबलिपशु परमेश्वर को सामने बलि करयो जावय हय; यो पापबलि ठहरेंन। <verse eid="LEV 4:24" /><verse number="25" style="v" sid="LEV 4:25" />तब याजक अपनो बोट सी पापबलिपशु को खून म सी कुछ ले क होमबलि की वेदी को सींगो पर लगाये, अऊर ओको खून होमबलि की वेदी की पाया पर कुड़ाय दे। <verse eid="LEV 4:25" /><verse number="26" style="v" sid="LEV 4:26" />अऊर ऊ ओकी पूरी चरबी ख मेल-मिलाप बलिदान पशु की चरबी को जसो वेदी पर जलाये; अऊर याजक ओको पाप ख झाके, तब ऊ माफ करयो जायेंन।<verse eid="LEV 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 4:27" />यदि साधारन लोगों म सी कोयी अज्ञानता सी पाप करे, उन कामों म सी कोयी काम ख करय हय जिन्ख परमेश्वर न मना करयो हय, त ऊ दोषी ठहरेंन, <verse eid="LEV 4:27" /><verse number="28" style="v" sid="LEV 4:28" />त ऊ पाप को वजह एक निर्दोष शेरी को बच्चा बलिदान लायी ले जाय। <verse eid="LEV 4:28" /><verse number="29" style="v" sid="LEV 4:29" />अऊर ऊ अपनो हाथ पापबलिपशु को मुंड पर रखे, अऊर होमबलि को जागा पर पापबलिपशु को बलिदान करे। <verse eid="LEV 4:29" /><verse number="30" style="v" sid="LEV 4:30" />अऊर याजक ओको खून म सी अपनो बोट सी कुछ ले क होमबलि की वेदी को सींगो पर लगाये, अऊर ओको सब खून ख उच वेदी की पाया पर कुड़ाय दे। <verse eid="LEV 4:30" /><verse number="31" style="v" sid="LEV 4:31" />अऊर ऊ ओकी सब चरबी ख मेल-मिलाप बलिदान पशु की चरबी को जसो अलग करे, तब याजक ओख वेदी पर परमेश्वर लायी सुखदायक सुगन्ध लायी जलाये; अऊर यो तरह याजक ओको पाप झाके, तब ओख माफी मिलेंन।<verse eid="LEV 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 4:32" />यदि ऊ पापबलि लायी एक मेंढी को बच्चा लावय, त ऊ निर्दोष मादा होनो चाहिये, <verse eid="LEV 4:32" /><verse number="33" style="v" sid="LEV 4:33" />अऊर ऊ अपनो हाथ पापबलिपशु को मुंड पर रखे, अऊर ओख पापबलि लायी उतच बलिदान करे जहां होमबलिपशु बलि करयो जावय हय। <verse eid="LEV 4:33" /><verse number="34" style="v" sid="LEV 4:34" />तब याजक अपनो बोट सी पापबलि को खून म सी कुछ ले क होमबलि की वेदी को सींगो पर लगाये, अऊर ओको सब खून ख वेदी की पाया पर कुड़ाय दे। <verse eid="LEV 4:34" /><verse number="35" style="v" sid="LEV 4:35" />अऊर ऊ ओकी सब चरबी ख मेल-मिलाप बलिदान वालो मेंढी को बच्चा की चरबी को जसो अलग करे, अऊर याजक ओख वेदी पर परमेश्वर को हवनों को ऊपर जलाये; अऊर यो तरह याजक ओको पाप ख झाके, तब ऊ माफ करयो जायेंन।<verse eid="LEV 4:35" /></para>
  <chapter eid="LEV 4" />
  <chapter number="5" style="c" sid="LEV 5" />
  <para style="s">पापबलि की विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 5:1" />यदि कोयी गवाह होय क असो पाप करे की कसम खिलाय क पूछन पर भी कि का तय न यो सुन्यो यां जानय हय, अऊर वा बात प्रगट नहीं करय,</para>
  <para style="p" vid="LEV 5:1">त ओख अपनो दोष को बोझ उठानो पड़ेंन।<verse eid="LEV 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="LEV 5:2" />यां यदि कोयी दूसरी चिज ख अज्ञानता सी छुय लेवय, त चाहे ऊ अशुद्ध जंगली पशु की, यां अशुद्ध घरेलू पशु की, यां अशुद्ध रेंगन वालो जीव-जन्तु की लोथ होना, त ऊ अशुद्ध होय क दोषी ठहरेंन।<verse eid="LEV 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 5:3" />यां कोयी आदमी कोयी अशुद्ध चिज ख अज्ञानता सी छुय लेवय, चाहे ऊ अशुद्ध चिज कोयी भी तरह की होना जेको सी लोग अशुद्ध होय जावय हय, त जब ऊ वा बात ख जान लेयेंन तब ऊ दोषी ठहरेंन।<verse eid="LEV 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 5:4" />यदि कोयी बुरो यां भलो करन ख बिना सोचे समझे कसम खाये, यां कोयी तरह की बात ऊ बिना सोच-बिचार कसम खाय क कहे, त असी बात म ऊ दोषी ऊ समय ठहरेंन जब ओख मालूम होय जायेंन।<verse eid="LEV 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 5:5" />अऊर जब ऊ इन बातों म सी कोयी भी बात म दोषी हो, तब जो बारे म ओन पाप करयो होना ऊ ओख मान ले, <verse eid="LEV 5:5" /><verse number="6" style="v" sid="LEV 5:6" />अऊर ऊ परमेश्वर को सामने अपनो दोषबलि लाये, मतलब ऊ पापबलि को लायी ऊ झुण्ड म सी एक मेंढा यां शेरी पापबलि करन लायी लाये; तब याजक ऊ पाप को बारे म ओको लायी पश्चाताप करे।<verse eid="LEV 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 5:7" />“पर यदि ओख मेंढा यां शेरी देन की सामर्थ नहीं होना, त अपनो पाप को वजह दोय पण्डुक यां कबूत्तर को दोय बच्चा दोषबलि चढ़ावन लायी परमेश्वर को जवर लाये, उन म सी एक त पापबलि लायी अऊर दूसरो होमबलि लायी। <verse eid="LEV 5:7" /><verse number="8" style="v" sid="LEV 5:8" />ऊ उन्ख याजक को जवर लाये, अऊर याजक पापबलि वालो ख पहिले चढ़ाये, अऊर ओको मुंड गलो सी मुरकट डाले, पर अलग नहीं करे, <verse eid="LEV 5:8" /><verse number="9" style="v" sid="LEV 5:9" />अऊर ऊ पापबलिपशु को खून म सी कुछ वेदी को बाजू म छिड़के, अऊर जो खून बच्यो रहे ऊ वेदी को आधार पर गिरायो जाय; ऊ पापबलि ठहरेंन। <verse eid="LEV 5:9" /><verse number="10" style="v" sid="LEV 5:10" />तब दूसरो पक्षी ख वा विधि को अनुसार होमबलि करे, अऊर याजक ओको पाप ख झाके, तब ऊ माफ करयो जायेंन।<verse eid="LEV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 5:11" />“तब यदि ऊ दोय पण्डुक यां कबूत्तर को दोय बच्चा भी नहीं दे सके, त ऊ अपनो पाप को वजह अपनो चढ़ावा एपा को दशवों हिस्सा मैदा पापबलि कर क् लाये; ओको पर नहीं त ऊ जैतून को तेल डाले, अऊर नहीं लुभान रखे, कहालीकि ऊ पापबलि होयेंन। <verse eid="LEV 5:11" /><verse number="12" style="v" sid="LEV 5:12" />ऊ ओख याजक को जवर ले जाय, अऊर याजक ओको म सी अपनी मुट्ठी भर याद दिलावन वालो हिस्सा जान क वेदी पर परमेश्वर को वेदी को ऊपर जलाये; ऊ पापबलि ठहरेंन। <verse eid="LEV 5:12" /><verse number="13" style="v" sid="LEV 5:13" />अऊर इन बातों म सी कोयी भी बात को बारे म जो कोयी पाप करे, याजक ओको पाप ख झाके, तब ओको ऊ पाप माफ करयो जायेंन। तब अन्नबलि को जसो बच्यो हिस्सा याजक को होयेंन।”<verse eid="LEV 5:13" /></para>
  <para style="s">दोषबलि की विधि</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 5:14" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 5:14" /><verse number="15" style="v" sid="LEV 5:15" />“यदि कोयी परमेश्वर की पवित्र करी हुयी चिजों को बारे म भूल सी विश्वासघात करे अऊर पापी ठहरे, त ऊ परमेश्वर को जवर एक निर्दोष मेंढा दोषबलि लायी लाये; ओको दाम पवित्र जागा को शेकेल को अनुसार उतनोच शेकेल<note caller="+" style="f"><char style="fr" closed="false">5:15 </char><char style="ft" closed="false">लगभग १२ ग्राम</char></note> चांदी को हो जितनो याजक ठहरायेंन। <verse eid="LEV 5:15" /><verse number="16" style="v" sid="LEV 5:16" />अऊर जो पवित्र चिज को बारे म ओन पाप करयो होना, ओको म ऊ पाचवों हिस्सा अऊर बढ़ाय क याजक ख दे; अऊर याजक दोषबलि को मेंढा चढ़ाय क ओको पाप ख झाके, तब ओको पाप माफ करयो जायेंन।<verse eid="LEV 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 5:17" />“यदि कोयी असो पाप करे, कि उन कामों म सी जिन्ख परमेश्वर न मना करयो हय कोयी काम ख करे, त चाहे ऊ ओको अनजानो म भयो होना, त भी ऊ दोषी ठहरेंन, अऊर ओख अपनो बुरायी को बोझ उठानो पड़ेंन। <verse eid="LEV 5:17" /><verse number="18" style="v" sid="LEV 5:18" />येकोलायी ऊ एक निर्दोष मेंढा दोषबलि कर क् याजक को जवर लाये, ऊ उतनो दाम को होना जितनो याजक ठहराये, अऊर याजक ओको लायी ओकी वा भूल को जो ओन अनजानो म करयो हुयो पाप ख झाके, अऊर ऊ माफ करयो जायेंन। <verse eid="LEV 5:18" /><verse number="19" style="v" sid="LEV 5:19" />यो दोषबलि ठहरे; कहालीकि बिना शक परमेश्वर को सामने दोषी ठहरेंन।”<verse eid="LEV 5:19" /></para>
  <chapter eid="LEV 5" />
  <chapter number="6" style="c" sid="LEV 6" />
  <para style="p">
    <verse number="1" style="v" sid="LEV 6:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 6:1" /><verse number="2" style="v" sid="LEV 6:2" />“यदि कोयी परमेश्वर को विश्वासघात कर क् पापी ठहरे, जसो कि जायजाद, यां लेन देन यां लूट को बारे म अपनो भाऊ सी छल करे, यां ओको पर अत्याचार करे, <verse eid="LEV 6:2" /><verse number="3" style="v" sid="LEV 6:3" />यां पड़ी हुयी चिज ख पा क ओको बारे म झूठ बोले अऊर झूठी कसम भी खाये; असी कोयी भी बात कहाली नहीं हो जेक कर क् आदमी पापी ठहरय हय, <verse eid="LEV 6:3" /><verse number="4" style="v" sid="LEV 6:4" />त जब ऊ असो काम कर क् दोषी होय जाये, तब जो भी चिज ओन लूट, यां अत्याचार कर क्, यां जायजाद, यां पड़ी हुयी पायी होना; <verse eid="LEV 6:4" /><verse number="5" style="v" sid="LEV 6:5" />चाहे कोयी चिज कहाली नहीं हो जेको बारे म ओन झूठी कसम खायी होना; त ऊ ओख पूरो-पूरो लौटाय दे, अऊर पाचवों हिस्सा भी बढ़ाय क भर दे, जो दिन यो मालूम होय कि ऊ दोषी हय, उच दिन ऊ चिज ख ओको लौटाय दे। <verse eid="LEV 6:5" /><verse number="6" style="v" sid="LEV 6:6" />अऊर ऊ परमेश्वर को सामने अपनो दोषबलि भी लाये, मतलब एक निर्दोष मेंढा दोषबलि लायी याजक को जवर लाये, ऊ उतनोच दाम को होना जितनो याजक ठहराये। <verse eid="LEV 6:6" /><verse number="7" style="v" sid="LEV 6:7" />यो तरह याजक ओको लायी परमेश्वर को सामने पाप ख झाके, अऊर जो काम ख कर क् ऊ दोषी भय गयो हय ओकी माफी ओख मिलेंन।”<verse eid="LEV 6:7" /></para>
  <para style="s">अलग-अलग तरह को बलिदानों की विधि</para>
  <para style="s">होमबलि</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 6:8" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 6:8" /><verse number="9" style="v" sid="LEV 6:9" />“हारून अऊर ओको टुरावों ख आज्ञा दे क यो कह्य कि होमबलि की व्यवस्था या हय: होमबलि अग्निकुन्ड को ऊपर रात भर रख क सुबेरे तक वेदी पर पड़ी रहे, अऊर वेदी की आगी वेदी पर जरती रहे। <verse eid="LEV 6:9" /><verse number="10" style="v" sid="LEV 6:10" />अऊर याजक अपनो सन को कपड़ा अऊर अपनो तन पर सन की जांघियां पहिन क होमबलि की राख, जो आगी को भस्म करन सी वेदी पर रह्य जाये, ओख उठाय क ओख वेदी को बाजू म रखे। <verse eid="LEV 6:10" /><verse number="11" style="v" sid="LEV 6:11" />तब ऊ अपनो यो कपड़ा उतार क दूसरो कपड़ा पहिन क राख ख छावनी सी बाहेर कोयी शुद्ध जागा पर लिजाये। <verse eid="LEV 6:11" /><verse number="12" style="v" sid="LEV 6:12" />वेदी पर आगी जरती रहे, अऊर कभी बुझन मत देवो; अऊर याजक हर दिन सुबेरे ओको पर लकड़ियां जलाय क होमबलि को टुकड़ा ख ओको पर सजाय क रख दे, अऊर ओको ऊपर मेल-मिलाप बलिदान पशु की चरबी ख जलायो करे। <verse eid="LEV 6:12" /><verse number="13" style="v" sid="LEV 6:13" />वेदी पर आगी लगातार जरती रहे; अऊर वा कभी बुझनो नहीं पाये।<verse eid="LEV 6:13" /></para>
  <para style="s">अनाज की भेंट</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 6:14" />“अनाज भेंट चढ़ावन की व्यवस्था यो तरह हय: हारून को टुरा ओख वेदी को आगु परमेश्वर को सामने लाये। <verse eid="LEV 6:14" /><verse number="15" style="v" sid="LEV 6:15" />अऊर ऊ अनाज भेंट चढ़ावन को तेल मिल्यो हुयो मैदा म सी मुट्ठी भर अऊर ओको पर को सब लुभान उठाय क अनाज भेंट की याद म यो हिस्सा ख परमेश्वर को सामने सुखदायक सुगन्ध लायी वेदी पर जलाये। <verse eid="LEV 6:15" /><verse number="16" style="v" sid="LEV 6:16" />अऊर ओको म सी जो बच्यो रह्य जाये ओख हारून अऊर ओको टुरा खाये; ऊ बिना खमीर पवित्र जागा म खायो जाये, मतलब हि मिलाप वालो तम्बू को आंगन म ओख खाये। <verse eid="LEV 6:16" /><verse number="17" style="v" sid="LEV 6:17" />ऊ खमीर को संग पकायो नहीं जाये; कहालीकि मय न अपनो अन्नबलि म सी ओख दियो हय; येकोलायी जसो पापबलि अऊर दोषबलि अती पवित्र हय वसोच ऊ भी हय। <verse eid="LEV 6:17" /><verse number="18" style="v" sid="LEV 6:18" />तुम्हरी पीढ़ी-पीढ़ी म हारून को वंश को सब आदमी ओको म सी खाय सकय हंय, परमेश्वर को भेंटों म सी यो ओको हिस्सा हमेशा बन्यो रहेंन; जो कोयी उन भेंटों ख छुवय ऊ पवित्र ठहरेंन।”<verse eid="LEV 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 6:19" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 6:19" /><verse number="20" style="v" sid="LEV 6:20" />“ जो दिन हारून को अभिषेक होयेंन ऊ दिन ऊ अपनो टुरा को संग परमेश्वर ख यो चढ़ावा चढ़ाये; मतलब एपा को दसवों हिस्सा मैदा रोज अन्नबलि म चढ़ाये, ओको म सी अरधो सुबेरे अऊर अरधो शाम को समय चढ़ाये। <verse eid="LEV 6:20" /><verse number="21" style="v" sid="LEV 6:21" />ऊ तवा पर तेल को संग पकायो जाय; जब ऊ तेल सी तल क होय जाये तब ओख लायजो, यो अन्नबलि को पक्यो हुयो तुकड़ा परमेश्वर को सुखदायक सुगन्ध लायी चढ़ायजो। <verse eid="LEV 6:21" /><verse number="22" style="v" sid="LEV 6:22" />हारून को टुरावों म सी जो ऊ याजकपद पर अभिषिक्त होयेंन, ऊ भी उच तरह को चढ़ावा चढ़ायो करे; या विधि हमेशा लायी हय, कि परमेश्वर को सामने ऊ पूरो चढ़ावा जलायो जाये। <verse eid="LEV 6:22" /><verse number="23" style="v" sid="LEV 6:23" />याजक को पूरो अन्नबलि भी जलायो जाये; ऊ कभी नहीं खायो जाय।”<verse eid="LEV 6:23" /></para>
  <para style="s">पापबलि</para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 6:24" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 6:24" /><verse number="25" style="v" sid="LEV 6:25" />“हारून अऊर ओको टुरावों सी यो कह्य कि पापबलि की व्यवस्था या हय: जो जागा म होमबलिपशु मारयो जावय हय ओकोच म पापबलिपशु भी परमेश्वर को सामने बलि करयो जाय; ऊ परमपवित्र हय।” <verse eid="LEV 6:25" /><verse number="26" style="v" sid="LEV 6:26" />जो याजक पापबलि चढ़ाये ऊ ओख खाये; ऊ पवित्र जागा म, मतलब मिलाप वालो तम्बू को आंगन म खायो जाय। <verse eid="LEV 6:26" /><verse number="27" style="v" sid="LEV 6:27" />जो कोयी ओको मांस ख छुयेंन, ऊ पवित्र होय जायेंन। यदि ओको खून को छीटा कपड़ा पर पड़ेंन त ऊ कपड़ा ख जेक पर छीटा पड़ गयो हय, ओख पवित्र जागा म धोय लेजो। <verse eid="LEV 6:27" /><verse number="28" style="v" sid="LEV 6:28" />जो माटी को बर्तन म ऊ पकायो जायेंन, त ऊ बर्तन ख तोड़ देजो, पर यदि ऊ पीतल को बर्तन म पकायो गयो हय, त ऊ मांज्यो अऊर पानी सी धोयो जाय। <verse eid="LEV 6:28" /><verse number="29" style="v" sid="LEV 6:29" />याजक म सी सब आदमी ओख खाय सकय हंय; ऊ परमपवित्र चिज आय। <verse eid="LEV 6:29" /><verse number="30" style="v" sid="LEV 6:30" />पर जो पापबलिपशु को खून म सी कुछ भी खून मिलाप वालो तम्बू को अन्दर पवित्र जागा म पश्चाताप करन लायी पहुंचायो जाय ओको मांस कभी नहीं खायो जाय; ऊ आगी म जलाय दियो जाये।<verse eid="LEV 6:30" /></para>
  <chapter eid="LEV 6" />
  <chapter number="7" style="c" sid="LEV 7" />
  <para style="s">दोषबलि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 7:1" />फिर दोषबलि की व्यवस्था या हय, ऊ अती पवित्र हय। <verse eid="LEV 7:1" /><verse number="2" style="v" sid="LEV 7:2" />जो जागा पर होमबलिपशु की बलि करय हय उच जागा पर दोषबलिपशु भी बलि करे, अऊर ओको खून ख याजक वेदी पर चारयी तरफ छिड़के। <verse eid="LEV 7:2" /><verse number="3" style="v" sid="LEV 7:3" />ओकी पूरी चरबी ख चढ़ाये, मतलब ओकी मोटी पूछ ख, अऊर जो चरबी सी अतड़ियां झकी रह्य हय, <verse eid="LEV 7:3" /><verse number="4" style="v" sid="LEV 7:4" />अऊर दोयी गुड़दा अऊर जो चरबी ओको ऊपर अऊर कमर को जवर रह्य हय, अऊर गुड़दावों समेत कलेजा को ऊपर की झिल्ली; इन सब ख ऊ अलग करे; <verse eid="LEV 7:4" /><verse number="5" style="v" sid="LEV 7:5" />अऊर याजक इन ख वेदी पर परमेश्वर लायी आगी म जलाये; तब ऊ दोषबलि होयेंन। <verse eid="LEV 7:5" /><verse number="6" style="v" sid="LEV 7:6" />याजकों म को सब आदमी ओको म सी खाय सकय हय; ऊ कोयी पवित्र जागा म खायो जाये; कहालीकि ऊ परमपवित्र हय।<verse eid="LEV 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="LEV 7:7" />जसो पापबलि हय वसोच दोषबलि भी हय, उन दोयी की एकच व्यवस्था हय; जो याजक उन बलियों ख चढ़ाय क पाप ख झाके उच उन चिजों ख ले ले। <verse eid="LEV 7:7" /><verse number="8" style="v" sid="LEV 7:8" />अऊर जो याजक कोयी लायी होमबलि ख चढ़ाये ऊ होमबलिपशु की खाल ख उच याजक ले ले। <verse eid="LEV 7:8" /><verse number="9" style="v" sid="LEV 7:9" />अऊर भट्टी म, यां कढ़ाई म, यां तवा पर पक्यो हुयो सब अनाज की भेंट उच याजक को होयेंन जो उन्ख चढ़ावय हय। <verse eid="LEV 7:9" /><verse number="10" style="v" sid="LEV 7:10" />अऊर सब अनाज की भेंट, जो चाहे तेल सी सान्यो हुयो होना यां सुख्यो होना, हि हारून को सब टुरावों ख एक जसो मिले।<verse eid="LEV 7:10" /></para>
  <para style="s">मेलबलि</para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 7:11" />मेल-मिलाप बलि की, जेख कोयी परमेश्वर लायी चढ़ाये त व्यवस्था या आय। <verse eid="LEV 7:11" /><verse number="12" style="v" sid="LEV 7:12" />यदि ऊ ओख धन्यवाद लायी चढ़ाये, त धन्यवाद बलि को संग तेल सी सान्यो हुयो अखमीरी पतली रोटी, अऊर तेल लगायी हुयी मोटी रोटियां, अऊर तेल सी सान्यो हुयो मैदा की सुवारी तेल सी तल क चढ़ाये। <verse eid="LEV 7:12" /><verse number="13" style="v" sid="LEV 7:13" />अऊर ऊ अपनो धन्यवाद वालो मेल-मिलाप बलि को संग खमीरी रोटियां, भी चढ़ाये। <verse eid="LEV 7:13" /><verse number="14" style="v" sid="LEV 7:14" />अऊर एक एक चढ़ावा म सी ऊ एक एक रोटी परमेश्वर ख भेंट कर क् चढ़ाये; ऊ मेल-मिलाप बलि को खून को छिड़कन वालो याजक को होयेंन। <verse eid="LEV 7:14" /><verse number="15" style="v" sid="LEV 7:15" />अऊर ऊ धन्यवाद वालो मेल-मिलाप बलि को मांस बलिदान चढ़ावन को दिनच खायो जाय; ओको म सी कुछ भी सुबेरे तक बच्यो नहीं रह जाये।<verse eid="LEV 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 7:16" />पर यदि ओको बलिदान को चढ़ावा मन्नत यां खुद की इच्छा को हो, त ऊ बलिदान ख जो दिन ऊ चढ़ायो जाय उच दिन ऊ खायो जाय, अऊर ओको म सी जो बच्यो रह जाये ऊ दूसरो दिन भी खायो जाय। <verse eid="LEV 7:16" /><verse number="17" style="v" sid="LEV 7:17" />पर जो कुछ बलिदान को मांस म सी तीसरो दिन तक बच जाये त ओख आगी म जलाय दियो जाय। <verse eid="LEV 7:17" /><verse number="18" style="v" sid="LEV 7:18" />अऊर ऊ मेल-मिलाप बलि को मांस म सी यदि कुछ भी तीसरो दिन खायो जाय, त ऊ स्विकार नहीं करयो जायेंन, अऊर नहीं ओको हित म गिन्यो जायेंन; लेकिन येख अशुद्ध मान्यो जायेंन, अऊर जो येख खायेंन, ओको परिनाम ओख भुगतनो पड़ेंन। <verse eid="LEV 7:18" /><verse number="19" style="v" sid="LEV 7:19" />“फिर जो मांस अशुद्ध चिज सी छुय जाये ऊ नहीं खायो जाय; ओख आगी म जलाय दियो जायेंन।”</para>
  <para style="p" vid="LEV 7:19">फिर जितनो मांस शुद्ध होना ओख खाये, <verse eid="LEV 7:19" /><verse number="20" style="v" sid="LEV 7:20" />पर जो अशुद्ध होय क परमेश्वर को मेलबलि को मांस म सी कुछ खाये ऊ अपनो लोगों म सी नाश करयो जायेंन। <verse eid="LEV 7:20" /><verse number="21" style="v" sid="LEV 7:21" />“अऊर यदि कोयी अशुद्ध चिज ख छुय क परमेश्वर को मेल-मिलाप बलि पशु को मांस म सी खाये, त ऊ भी अपनो लोगों म सी नाश करयो जायेंन, चाहे ऊ आदमी की कोयी अशुद्ध चिज यां अशुद्ध पशु यां कोयी भी अशुद्ध अऊर घृणित चिज हो।”<verse eid="LEV 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 7:22" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 7:22" /><verse number="23" style="v" sid="LEV 7:23" />“इस्राएलियों सी यो तरह कह्य: तुम लोग नहीं त बईल की कुछ चरबी खावो अऊर नहीं मेंढा यां शेरी की। <verse eid="LEV 7:23" /><verse number="24" style="v" sid="LEV 7:24" />अऊर जो पशु खुद मर जाये, अऊर जो दूसरो पशु सी फाड़्यो जाये, ओकी चरबी दूसरो काम म लावो, पर ओख खावो मत। <verse eid="LEV 7:24" /><verse number="25" style="v" sid="LEV 7:25" />जो कोयी असो पशु की चरबी खायेंन जेको म सी लोग कुछ परमेश्वर लायी बलिदान कर क् चढ़ायो करय हय ओख खान वालो ख अपनो लोगों म सी नाश करयो जायेंन। <verse eid="LEV 7:25" /><verse number="26" style="v" sid="LEV 7:26" />तुम अपनो घर म कोयी अलग को खून, चाहे पक्षी को चाहे पशु को खून हो, मत खावो। <verse eid="LEV 7:26" /><verse number="27" style="v" sid="LEV 7:27" />हर एक प्रानी जो कोयी को खून खायेंन ऊ अपनो लोगों म सी बाहेर करयो जायेंन।”<verse eid="LEV 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 7:28" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 7:28" /><verse number="29" style="v" sid="LEV 7:29" />“इस्राएलियों सी यो तरह कह्य: जो परमेश्वर लायी मेल-मिलाप बलि चढ़ाये ऊ उच मेल-मिलाप बलि म सी परमेश्वर को जवर भेंट लाये; <verse eid="LEV 7:29" /><verse number="30" style="v" sid="LEV 7:30" />ऊ अपनोच हाथों सी परमेश्वर को बलि ख, मतलब छाती समेत चरबी ख लाये कि छाती हिलावन की भेंट कर क् परमेश्वर को सामने हिलायी जाये।” <verse eid="LEV 7:30" /><verse number="31" style="v" sid="LEV 7:31" />अऊर याजक चरबी ख त वेदी पर जलायेंन, पर छाती हारून अऊर ओको टुरावों की होयेंन। <verse eid="LEV 7:31" /><verse number="32" style="v" sid="LEV 7:32" />फिर तुम अपनो मेल-मिलाप बलियों म सी दायो जांघ ख भी चढ़ावा को रूप म याजक ख देजो। <verse eid="LEV 7:32" /><verse number="33" style="v" sid="LEV 7:33" />हारून को टुरावों म सी मेल-मिलाप बलि को खून अऊर चरबी ख चढ़ाये दायो जांघ ओकोच हिस्सा होयेंन। <verse eid="LEV 7:33" /><verse number="34" style="v" sid="LEV 7:34" />कहालीकि इस्राएलियों को मेल-मिलाप बलियों म सी हिलावन की भेंट की छाती अऊर उठावन की भेंट की जांघ ख ले क मय न याजक हारून अऊर ओको टुरावों ख दियो हय, कि यो हमेशा इस्राएलियों की तरफ सी उन्को हक बन्यो रहे। <verse eid="LEV 7:34" /><verse number="35" style="v" sid="LEV 7:35" />“जो दिन हारून अऊर ओको टुरा परमेश्वर को सामने याजक पद लायी लायो गयो, उच दिन परमेश्वर को बलिदानों म सी उन्को योच अभिषिक्त हिस्सा ठहरायो गयो; <verse eid="LEV 7:35" /><verse number="36" style="v" sid="LEV 7:36" />मतलब जो दिन परमेश्वर न उन्को अभिषेक करयो उच दिन ओन आज्ञा दी कि उन्ख इस्राएलियों को तरफ सी यो हिस्सा हमेशा मिलतो रहे; उन्की पीढ़ी-पीढ़ी लायी उन्को योच हक ठहरायो गयो।”<verse eid="LEV 7:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="LEV 7:37" />होमबलि, अन्नबलि, पापबलि, दोषबलि, याजकों को संस्कार बलि, अऊर मेल-मिलाप बलि की व्यवस्था याच आय; <verse eid="LEV 7:37" /><verse number="38" style="v" sid="LEV 7:38" />जब परमेश्वर न सीनै पहाड़ी को जवर को बंजर जागा म मूसा ख आज्ञा दी कि इस्राएली मोरो लायी का-का चढ़ावा चढ़ाये, तब ओन उन्ख याच व्यवस्था दी होती।<verse eid="LEV 7:38" /></para>
  <chapter eid="LEV 7" />
  <chapter number="8" style="c" sid="LEV 8" />
  <para style="s">हारून अऊर ओको टुरावों को अभिषेक</para>
  <para style="r">(<ref loc="EXO 29:1-37">निर्गमन २९:१-३७</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 8:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 8:1" /><verse number="2" style="v" sid="LEV 8:2" />“तय हारून अऊर ओको टुरावों को कपड़ावों, अऊर अभिषेक को तेल, अऊर पापबलि को बईल, अऊर दोयी मेंढावों, अऊर अखमीरी रोटी की टोकनी ख, <verse eid="LEV 8:2" /><verse number="3" style="v" sid="LEV 8:3" />मिलाप वालो तम्बू को फाटक पर ले आव, अऊर वहांच पूरी मण्डली ख जमा कर।”<verse eid="LEV 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 8:4" />परमेश्वर की या आज्ञा को अनुसार मूसा न करयो; अऊर मण्डली मिलाप वालो तम्बू को फाटक पर जमा भयी। <verse eid="LEV 8:4" /><verse number="5" style="v" sid="LEV 8:5" />तब मूसा न मण्डली सी कह्यो, “जो काम करन की आज्ञा परमेश्वर न दी हय वा या आय।”<verse eid="LEV 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 8:6" />फिर मूसा न हारून अऊर ओको टुरावों ख जवर लाय क पानी सी नहलायो। <verse eid="LEV 8:6" /><verse number="7" style="v" sid="LEV 8:7" />तब ओन हारून ख कुरता पहिनायो, अऊर कुरता ख कमर पट्टा सी कस दियो। ओख अंगरखा पहिनायो। अऊर एपोद<note caller="+" style="f"><char style="fr" closed="false">8:7 </char><char style="ft" closed="false">याजक को कपड़ा</char></note> डाल्यो, अऊर कलात्मक ढंग सी बुन्यो हुयो एपोद को पट्टा सी ओख बान्ध क कस दियो। <verse eid="LEV 8:7" /><verse number="8" style="v" sid="LEV 8:8" />अऊर ओन चपरास लगाय क सिनाबन्ध म ऊरीम अऊर तुम्मीम रख दियो। <verse eid="LEV 8:8" /><verse number="9" style="v" sid="LEV 8:9" />तब ओन ओको मुंड पर फेटा बान्ध क फेटा को आगु सोना की पट्टी ख मतलब पवित्र मुकुट ख लगायो, जो तरह परमेश्वर न मूसा ख आज्ञा दी होती।<verse eid="LEV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 8:10" />तब मूसा न अभिषेक को तेल ले क निवास को अऊर जो कुछ ओको म होतो उन सब को भी अभिषेक कर क् उन्ख पवित्र करयो। <verse eid="LEV 8:10" /><verse number="11" style="v" sid="LEV 8:11" />अऊर ऊ तेल म सी कुछ ओन वेदी पर सात बार छिड़क्यो, अऊर पूरो सामान सहित वेदी को अऊर पाया समेत गंगार को अभिषेक कर क् उन्ख पवित्र करयो। <verse eid="LEV 8:11" /><verse number="12" style="v" sid="LEV 8:12" />अऊर ओन अभिषेक को तेल म सी कुछ हारून को मुंड पर डाल क ओको अभिषेक कर क् ओख पवित्र करयो। <verse eid="LEV 8:12" /><verse number="13" style="v" sid="LEV 8:13" />तब मूसा न हारून को टुरावों ख जवर लाय क, अंगरखा पहिनाय क, अऊर कमर पट्टा बान्ध क उन्को मुंड पर टोपी रख दियो, जो तरह परमेश्वर न मूसा ख आज्ञा दी होती।<verse eid="LEV 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 8:14" />तब ऊ पापबलि को बईल ख जवर लाय क; अऊर हारून अऊर ओको टुरावों न अपनो अपनो हाथ पापबलि को बईल को मुंड पर रखे। <verse eid="LEV 8:14" /><verse number="15" style="v" sid="LEV 8:15" />तब मूसा न ओख बलि करयो, अऊर मूसा न खून ले क बोट सी वेदी को चारयी सींगो पर लगाय क पवित्र करयो, अऊर खून ख वेदी को पाया पर कुड़ाय दियो, अऊर ओको पाप झाके अऊर ओख पवित्र करयो। <verse eid="LEV 8:15" /><verse number="16" style="v" sid="LEV 8:16" />अऊर मूसा न अतड़ियां पर की चरबी, अऊर कलेजा पर की झिल्ली, अऊर चरबी समेत दोयी गुड़दावो ख ले क वेदी पर जलायो। <verse eid="LEV 8:16" /><verse number="17" style="v" sid="LEV 8:17" />पर बईल म सी जो कुछ बच्यो रह्य गयो ओख, मतलब गोबर समेत ओकी खाल, मांस अऊर मांस ख छावनी सी बाहेर आगी म जलायो, जो तरह परमेश्वर न मूसा ख आज्ञा दी होती।<verse eid="LEV 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 8:18" />तब मूसा न होमबलि लायी मेंढा ख लायो, हारून अऊर ओको टुरावों न ऊ मेंढा को मुंड पर अपनो हाथ रखे। <verse eid="LEV 8:18" /><verse number="19" style="v" sid="LEV 8:19" />मूसा न ओख बलि करयो, अऊर येको खून ख वेदी को चारयी तरफ छिड़क दियो। <verse eid="LEV 8:19" /><verse number="20" style="v" sid="LEV 8:20" />उन्न यो मेंढा को तुकड़ा तुकड़ा करयो अऊर मूसा न ओको मुंड, ओको टुकड़ावों अऊर चरबी ख जलाय दियो। <verse eid="LEV 8:20" /><verse number="21" style="v" sid="LEV 8:21" />मूसा न अतड़ियां अऊर पाय ख पानी सी धोय क पूरो मेंढा ख वेदी पर जलायो; अऊर ऊ सुखदायक सुगन्ध देन लायी होमबलि अऊर परमेश्वर लायी बलिदान भय गयो, जो तरह परमेश्वर न मूसा ख आज्ञा दी होती।<verse eid="LEV 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 8:22" />तब मूसा न दूसरो मेंढा ख जो अभिषेक को मेंढा होतो जवर लायो, अऊर हारून अऊर ओको टुरावों न अपनो अपनो हाथ मेंढा को मुंड पर रख्यो। <verse eid="LEV 8:22" /><verse number="23" style="v" sid="LEV 8:23" />तब ऊ बलि करयो गयो, अऊर मूसा न ओको खून म सी कुछ ले क हारून को दायो कान को कोना पर अऊर ओको दायो हाथ अऊर दायो पाय को अंगूठा पर लगायो। <verse eid="LEV 8:23" /><verse number="24" style="v" sid="LEV 8:24" />अऊर ऊ हारून को टुरावों ख जवर ले गयो, अऊर खून म सी एक-एक को दायो कान को कोना पर अऊर दायो हाथ अऊर दायो पाय को अंगूठा पर लगायो; अऊर मूसा न खून ख वेदी पर चारयी तरफ छिड़क्यो। <verse eid="LEV 8:24" /><verse number="25" style="v" sid="LEV 8:25" />अऊर ओन चरबी, अऊर चरबीदार पूछ, अऊर अतड़ियों पर की सब चरबी, अऊर कलेजा पर की झिल्ली समेत दोयी गुड़दा, अऊर दियो जांघ, हि सब ले क अलग रखे। <verse eid="LEV 8:25" /><verse number="26" style="v" sid="LEV 8:26" />अऊर अखमीरी रोटी की टोकनी जो परमेश्वर को आगु रखी गयी होती ओको म सी एक अखमीरी रोटी, अऊर तेल सी सान्यो हुयो मैदा को एक सुवारी, अऊर एक सुवारी ले क अऊर चरबी दायो जांघ पर रख दियो। <verse eid="LEV 8:26" /><verse number="27" style="v" sid="LEV 8:27" />अऊर या सब चिजे हारून अऊर ओको टुरावों को हाथों पर रख दी गयी, इन्ख परमेश्वर ख चढ़ावन की भेंट मान क परमेश्वर को आगु हिलायी गयी। <verse eid="LEV 8:27" /><verse number="28" style="v" sid="LEV 8:28" />तब मूसा न उन्ख फिर उन्को हाथों पर सी ले क उन्ख वेदी पर जलायो, यो सुखदायक सुगन्ध देन लायी अभिषेक की भेंट अऊर परमेश्वर लायी अग्निबलि होती। <verse eid="LEV 8:28" /><verse number="29" style="v" sid="LEV 8:29" />तब मूसा न छाती ख ले क हिलावन की भेंट को रूप म परमेश्वर को सामने हिलायो। अभिषेक को मेंढा म सी मूसा को हिस्सा होतो; जसो परमेश्वर न मूसा ख आज्ञा दी होती।<verse eid="LEV 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 8:30" />तब मूसा न अभिषेक को तेल अऊर वेदी पर को खून, दोयी म सी कुछ ले क हारून अऊर ओको कपड़ा पर, अऊर ओको टुरावों अऊर उन्को कपड़ा पर भी छिड़क्यो; अऊर ओन कपड़ा समेत हारून ख भी पवित्र करयो।<verse eid="LEV 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 8:31" />तब मूसा न हारून अऊर ओको टुरावों सी कह्यो, “मांस ख मिलाप वालो तम्बू को फाटक पर पकावों, अऊर वा रोटी ख जो अभिषेक की टोकनी म हय उतच खावो, जसो मय न आज्ञा दी हय कि हारून अऊर ओको टुरा ओख खाये। <verse eid="LEV 8:31" /><verse number="32" style="v" sid="LEV 8:32" />अऊर मांस अऊर रोटी म सी जो बच्यो हुयो ख आगी म जलाय देवो। <verse eid="LEV 8:32" /><verse number="33" style="v" sid="LEV 8:33" />अऊर जब तक तुम्हरो अभिषेक को दिन पूरो नहीं होय जाये तब तक, मतलब सात दिन तक मिलाप वालो तम्बू को फाटक को बाहेर मत जाजो, कहालीकि ऊ सात दिन तक तुम्हरो अभिषेक करतो रहेंन। <verse eid="LEV 8:33" /><verse number="34" style="v" sid="LEV 8:34" />जो तरह अज करयो गयो हय वसोच करन की आज्ञा परमेश्वर न दी हय, जेको सी तुम्हरो पाप झाक्यो जायेंन। <verse eid="LEV 8:34" /><verse number="35" style="v" sid="LEV 8:35" />येकोलायी तुम मिलाप वालो तम्बू को फाटक पर सात दिन अऊर सात रात ठहरे रहजो, ताकि तुम मर नहीं जावो; कहालीकि असीच आज्ञा मोख दी गयी हय।” <verse eid="LEV 8:35" /><verse number="36" style="v" sid="LEV 8:36" />तब परमेश्वर की याच सब निर्देश आज्ञावों को अनुसार जो ओन मूसा सी दी होती हारून अऊर ओको टुरावों न करयो।<verse eid="LEV 8:36" /></para>
  <chapter eid="LEV 8" />
  <chapter number="9" style="c" sid="LEV 9" />
  <para style="s">हारून द्वारा बलिदान</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 9:1" />आठवों दिन मूसा न हारून अऊर ओको टुरावों ख अऊर इस्राएली बुजूर्गों ख बुलाय क कह्यो। <verse eid="LEV 9:1" /><verse number="2" style="v" sid="LEV 9:2" />“पापबलि लायी एक निर्दोष बछड़ा, अऊर होमबलि लायी एक निर्दोष मेंढा लाय क परमेश्वर को सामने भेंट चढ़ाव। <verse eid="LEV 9:2" /><verse number="3" style="v" sid="LEV 9:3" />अऊर इस्राएलियों सी यो कह्य, ‘तुम पापबलि लायी एक बकरा, अऊर होमबलि लायी एक बछड़ा अऊर एक मेंढी को बच्चा लावो, जो एक साल को हो अऊर पूर्ण स्वस्थ हो,’ <verse eid="LEV 9:3" /><verse number="4" style="v" sid="LEV 9:4" />अऊर मेल-मिलाप बलि लायी परमेश्वर को सामने चढ़ावन लायी एक बईल अऊर एक मेंढा, अऊर तेल सी सान्यो हुयो मैदा को एक अनाज भेंट भी लावो; कहालीकि अज परमेश्वर तुम्ख दर्शन देयेंन।”<verse eid="LEV 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 9:5" />अऊर जो-जो चिज की आज्ञा मूसा न दी उन सब ख हि मिलाप वालो तम्बू को आगु लाये; अऊर पूरी मण्डली जवर जाय क परमेश्वर को सामने खड़ी भयी। <verse eid="LEV 9:5" /><verse number="6" style="v" sid="LEV 9:6" />तब मूसा न कह्यो, “यो ऊ काम आय जेक करन लायी परमेश्वर न आज्ञा दी हय कि तुम ओख करो; अऊर परमेश्वर की महिमा तुम ख दिखायी पड़ेंन।” <verse eid="LEV 9:6" /><verse number="7" style="v" sid="LEV 9:7" />तब मूसा न हारून सी कह्यो, “परमेश्वर की आज्ञा को अनुसार वेदी को जवर जाय क अपनो पापबलि अऊर होमबलि ख चढ़ाय क अपनो अऊर सब जनता को पाप ख झाके करो अऊर जनता को चढ़ावा ख भी चढ़ाय क ओको पाप ख झाके।”<verse eid="LEV 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 9:8" />येकोलायी हारून न वेदी को जवर जाय क अपनो पापबलि को बछड़ा ख बलिदान करयो। <verse eid="LEV 9:8" /><verse number="9" style="v" sid="LEV 9:9" />अऊर हारून को टुरा खून ख ओको जवर ले गयो, तब ओन अपनो बोट ख खून म डुबाय क वेदी को सींगो पर खून ख लगायो, अऊर बच्यो खून ख वेदी को पाया पर कुड़ाय दियो; <verse eid="LEV 9:9" /><verse number="10" style="v" sid="LEV 9:10" />अऊर पापबलि म की चरबी अऊर गुड़दा अऊर कलेजा पर की झिल्ली ख ओन वेदी पर जलायो, जसो परमेश्वर न मूसा ख आज्ञा दी होती। <verse eid="LEV 9:10" /><verse number="11" style="v" sid="LEV 9:11" />अऊर मांस अऊर खाल ख ओन छावनी सी बाहेर आगी म जलायो।<verse eid="LEV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 9:12" />तब होमबलिपशु ख भेंट चढ़ायो; अऊर हारून को टुरावों न खून ख ओको हाथ म दियो, अऊर ओन ओख वेदी पर चारयी तरफ छिड़क दियो। <verse eid="LEV 9:12" /><verse number="13" style="v" sid="LEV 9:13" />तब उन्न होमबलिपशु को तुकड़ा अऊर मुंड सहित ओको हाथ म दियो अऊर ओन ओख वेदी पर जलाय दियो। <verse eid="LEV 9:13" /><verse number="14" style="v" sid="LEV 9:14" />अऊर ओन अतड़ियों अऊर पाय ख धोय क वेदी पर होमबलि को ऊपर जलायो।<verse eid="LEV 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 9:15" />तब हारून न लोगों को चढ़ावा ख आगु लाय क अऊर ऊ पापबलि को बकरा जो लोगों लायी होतो ले क ओकी बलि चढ़ायो, अऊर पहिले को जसो ओख भी पापबलि कर क् चढ़ायो। <verse eid="LEV 9:15" /><verse number="16" style="v" sid="LEV 9:16" />अऊर ओन होमबलि ख भी जवर लिजाय क विधि को अनुसार चढ़ायो। <verse eid="LEV 9:16" /><verse number="17" style="v" sid="LEV 9:17" />अऊर अनाज भेंट ख भी जवर लिजाय क ओको म सी मुट्ठी भर वेदी पर जलायो, यो सुबेरे को होमबलि को सहित चढ़ायो गयो। <verse eid="LEV 9:17" /><verse number="18" style="v" sid="LEV 9:18" />बईल अऊर मेंढा, मतलब जो मेल-मिलाप बलि पशु, जनता लायी होतो हि भी बलि करयो गयो; अऊर हारून को टुरावों न खून ख उन्को हाथ म दियो,अऊर ओन ओख वेदी पर चारयी तरफ छिड़क दियो; <verse eid="LEV 9:18" /><verse number="19" style="v" sid="LEV 9:19" />अऊर उन्न बईल की चरबी ख, अऊर मेंढा म सी चरबीदार पूछ ख, अऊर जो चरबी सी अंतड़ियां झकी रह्य हय ओख, अऊर गुड़दावो सहित कलेजा पर की झिल्ली ख भी ओको हाथ म दियो; <verse eid="LEV 9:19" /><verse number="20" style="v" sid="LEV 9:20" />अऊर उन्न चरबी ख जनावरों की छातियों पर रख्यो; अऊर ओन वा चरबी वेदी पर जलायी, <verse eid="LEV 9:20" /><verse number="21" style="v" sid="LEV 9:21" />पर छातियों अऊर दायो जांघ ख हारून न मूसा की आज्ञा को अनुसार हिलावन की भेंट लायी परमेश्वर को सामने हिलायो।<verse eid="LEV 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 9:22" />तब हारून न लोगों को तरफ हाथ बढ़ाय क उन्ख आशीर्वाद दियो; अऊर पापबलि, होमबलि, अऊर मेल-मिलाप बलियों ख चढ़ाय क ऊ खल्लो उतर गयो। <verse eid="LEV 9:22" /><verse number="23" style="v" sid="LEV 9:23" />तब मूसा अऊर हारून मिलाप वालो तम्बू म गयो, अऊर बाहेर निकल क लोगों ख आशीर्वाद दियो; तब परमेश्वर को महिमा पूरी जनता ख दिखायी दियो। <verse eid="LEV 9:23" /><verse number="24" style="v" sid="LEV 9:24" />अऊर परमेश्वर को सामने सी आगी निकली अऊर चरबी सहित होमबलि ख वेदी पर भस्म कर दियो; येख देख क जनता न जय जयकार को नारा लगायो अऊर अपनो अपनो मुंह को बल गिर क दण्डवत प्रनाम करयो।<verse eid="LEV 9:24" /></para>
  <chapter eid="LEV 9" />
  <chapter number="10" style="c" sid="LEV 10" />
  <para style="s">नादाब अऊर अबीहू को पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 10:1" />तब नादाब अऊर अबीहू नाम को हारून को दोय टुरावों न अपनो अपनो धूपदान लियो, अऊर उन म आगी भरी, अऊर ओको म धूप डाल क वा ऊपरी आगी ख जेकी आज्ञा परमेश्वर न नहीं दी होती परमेश्वर को सामने चढ़ायो। <verse eid="LEV 10:1" /><verse number="2" style="v" sid="LEV 10:2" />तब परमेश्वर को सामने सी आगी निकली, अऊर उन दोयी ख भस्म कर दियो, अऊर हि परमेश्वर को सामने मर गयो। <verse eid="LEV 10:2" /><verse number="3" style="v" sid="LEV 10:3" />तब मूसा न हारून सी कह्यो, “या वाच बात आय जेक परमेश्वर न कह्यो होतो कि जो मोरो जवर आयेंन, जरूरी हय कि ऊ मोख पवित्र जाने, अऊर पूरी जनता को सामने मोरी महिमा करे।” पर हारून चुप रह्यो।<verse eid="LEV 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 10:4" />तब मूसा न मीशाएल अऊर एलसाफान ख जो हारून को काका उज्जीएल को टुरा होतो बुलाय क कह्यो, “जवर आवो, अऊर अपनो भतीजों ख पवित्र जागा को सामने सी उठ क छावनी को बाहेर ले जावो।” <verse eid="LEV 10:4" /><verse number="5" style="v" sid="LEV 10:5" />मूसा की या आज्ञा को अनुसार हि जवर जाय क उन्ख अंगरखा सहित उठाय क छावनी को बाहेर गयो।<verse eid="LEV 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 10:6" />तब मूसा न हारून सी अऊर ओको टुरा एलीआजार अऊर ईतामार सी कह्यो, “तुम लोग अपनो मुंड को बाल मत बिखरावो, अऊर नहीं अपनो कपड़ावों ख फाड़ो, असो नहीं होय कि तुम भी मर जावो, अऊर पूरी मण्डली पर ओको गुस्सा भड़क उठेंन; पर ऊ इस्राएल को पूरो घराना को लोग जो तुम्हरो भाऊबन्धु हंय परमेश्वर की आगी सी जर गयो ओको पर विलाप करे। <verse eid="LEV 10:6" /><verse number="7" style="v" sid="LEV 10:7" />अऊर तुम लोग मिलाप वालो तम्बू को फाटक को बाहेर मत जाजो, असो नहीं होय कि तुम मर जावो; कहालीकि परमेश्वर को अभिषेक को तेल तुम पर लग्यो हुयो हय।” मूसा को यो वचन को अनुसार उन्न करयो।<verse eid="LEV 10:7" /></para>
  <para style="s">याजकों लायी नियम</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 10:8" />तब परमेश्वर न हारून सी कह्यो, <verse eid="LEV 10:8" /><verse number="9" style="v" sid="LEV 10:9" />“जब जब तय यां तोरो टुरा मिलाप वालो तम्बू म आये तब तब तुम म सी कोयी अंगूरीरस यां दारू मत पीवो; कहीं असो नहीं हो कि तुम मर जावो; तुम्हरी पीढ़ी पीढ़ी म या विधि चलती रहे, <verse eid="LEV 10:9" /><verse number="10" style="v" sid="LEV 10:10" />जेकोसी तुम पवित्र अऊर अपवित्र म, अऊर शुद्ध अऊर अशुद्ध म अन्तर कर सको, <verse eid="LEV 10:10" /><verse number="11" style="v" sid="LEV 10:11" />अऊर इस्राएलियों ख उन सब विधियों ख सिखाय सको जेक परमेश्वर न मूसा को द्वारा उन्ख बताय दियो हय।”<verse eid="LEV 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="LEV 10:12" />फिर मूसा न हारून सी अऊर ओको टुरा भयो दोयी टुरा ईतामार अऊर एलीआजार सी भी कह्यो, “परमेश्वर को भेंट म सी जो अनाज बलि बच्यो हय ओख ले क वेदी को जवर बिना खमीर को खावो, कहालीकि ऊ परमपवित्र हय; <verse eid="LEV 10:12" /><verse number="13" style="v" sid="LEV 10:13" />अऊर तुम ओख कोयी पवित्र जागा म खावो, ऊ परमेश्वर को भेंट म सी तोरो अऊर तोरो टुरावों को हक हय; कहालीकि मय न असीच आज्ञा पायी हय। <verse eid="LEV 10:13" /><verse number="14" style="v" sid="LEV 10:14" />पर हिलायी हुयी भेंट की छाती अऊर उठायी हुयी भेंट की जांघ ख तुम लोग, मतलब तय अऊर तोरो बेटा-बेटियां सब कोयी शुद्ध जागा म खावो; कहालीकि हि इस्राएलियों को मेल-मिलाप बलियों म सी तोख अऊर तोरो टुरावों को हक ठहराय दियो गयो हय। <verse eid="LEV 10:14" /><verse number="15" style="v" sid="LEV 10:15" />चर्बी को अग्निबलियों समेत जो उठायी हुयी जांघ अऊर हिलायी हुयी छाती परमेश्वर को सामने हिलावन लायी आयो करेंन, यो हिस्सा परमेश्वर की आज्ञा को अनुसार हमेशा की विधि की व्यवस्था सी तोरो अऊर तोरो बच्चां लायी हय।”<verse eid="LEV 10:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 10:16" />फिर मूसा न पापबलि को बकरा की जांच-पड़ताल करी, त का पायो कि ऊ जलायो गयो हय, येकोलायी एलीआजार अऊर ईतामार जो हारून को टुरा बच्यो होतो उन्को सी ऊ गुस्सा म आय क कहन लग्यो, <verse eid="LEV 10:16" /><verse number="17" style="v" sid="LEV 10:17" />“पापबलि जो परमपवित्र हय अऊर जेक परमेश्वर न तुम्ख येकोलायी दियो हय कि तुम मण्डली को पाप को बोझ अपनो ऊपर उठाय क ओको लायी परमेश्वर को सामने पश्चाताप करो, तुम न ओको मांस पवित्र जागा म कहाली नहीं खायो? <verse eid="LEV 10:17" /><verse number="18" style="v" sid="LEV 10:18" />देखो, ओको खून भी पवित्र जागा को अन्दर म नहीं लायो गयो होतो, तुम्ख ओख पवित्र जागा म खानो होतो; जसो मय न आज्ञा दियो होतो।”<verse eid="LEV 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 10:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:19 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 10:1-2">लैव्यव्यवस्था १०:१-२</ref>,<ref loc="LEV 10:17">१७</ref></char>
    </note>येको उत्तर हारून न मूसा ख यो तरह सी दियो, “देख, अजच उन्न अपनो पापबलि अऊर होमबलि ख परमेश्वर को सामने चढ़ायो; फिर भी मोरो पर असी विपत्तियां आय पड़ी हय! येकोलायी यदि मय अज पापबलि को मांस खातो त का या बात परमेश्वर को सामने अच्छी होती?” <verse eid="LEV 10:19" /><verse number="20" style="v" sid="LEV 10:20" />जब मूसा न यो सुन्यो तब ओख अच्छो लग्यो।<verse eid="LEV 10:20" /></para>
  <chapter eid="LEV 10" />
  <chapter number="11" style="c" sid="LEV 11" />
  <para style="s">शुद्ध अऊर अशुद्ध पशु</para>
  <para style="r">(<ref loc="DEU 14:3-21">व्यवस्थाविवरन 14:3-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 11:1" />फिर परमेश्वर न मूसा अऊर हारून सी कह्यो, <verse eid="LEV 11:1" /><verse number="2" style="v" sid="LEV 11:2" />“इस्राएलियों सी कहो: जितनो पशु धरती पर हय उन सब म सी तुम इन जीवधारियों को मांस खाय सकय हय।” <verse eid="LEV 11:2" /><verse number="3" style="v" sid="LEV 11:3" />पशुवों म सी जितनो चिरयो यां फट्यो खुरी को होवय हय अऊर कवरी करय हय, उन्ख खाय सकय हय। <verse eid="LEV 11:3" /><verse number="4" style="v" sid="LEV 11:4" />पर कवरी करन वालो यां फटी खुरी वालो को अलावा इन जनावरों ख मत खावो, मतलब ऊंट, जो कवरी त करय हय पर चिरयो खुरी को नहीं होवय हय, येकोलायी ऊ तुम्हरो लायी अशुद्ध ठहरयो हय। <verse eid="LEV 11:4" /><verse number="5" style="v" sid="LEV 11:5" />अऊर चट्टानी बिज्जू, जो कवरी त करय हय पर चिरयो खुरी को नहीं होवय, ऊ भी तुम्हरो लायी अशुद्ध होवय हय। <verse eid="LEV 11:5" /><verse number="6" style="v" sid="LEV 11:6" />अऊर ससा, जो कवरी त करय हय पर चिरयो खुरी को नहीं होवय, येकोलायी ऊ भी तुम्हरो लायी अशुद्ध हय। <verse eid="LEV 11:6" /><verse number="7" style="v" sid="LEV 11:7" />अऊर डुक्कर, जो चिरयो मतलब फटी खुरी को होवय त हय पर कवरी नहीं करय, येकोलायी ऊ भी तुम्हरो लायी अशुद्ध हय। <verse eid="LEV 11:7" /><verse number="8" style="v" sid="LEV 11:8" />इन को मांस म सी कुछ मत खावो, अऊर इन्को लोथ ख छूवो भी मत; यो त तुम्हरो लायी अशुद्ध हय।<verse eid="LEV 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 11:9" />“फिर जितनो जलजन्तु हय उन म सी तुम इन ख खाय सकय हय, मतलब समुन्दर यां नदियों को जलजन्तुवों म सी जितनो को पंखा अऊर खिपला होवय हय उन्ख खाय सकय हय।” <verse eid="LEV 11:9" /><verse number="10" style="v" sid="LEV 11:10" />अऊर जलचरी प्रानियों म सी जितनो जीवधारी बिना पंखा अऊर खिपला वालो जीव-जन्तु समुन्दर यां नदियों म रह्य हय हि सब तुम्हरो लायी अशुद्ध हय। <verse eid="LEV 11:10" /><verse number="11" style="v" sid="LEV 11:11" />हि तुम्हरो लायी घृणित ठहरे; तुम उन्को मांस म सी कुछ मत खावो, अऊर उन की लोथों ख अशुद्ध जानो। <verse eid="LEV 11:11" /><verse number="12" style="v" sid="LEV 11:12" />पानी म जो कोयी जन्तु को पंखा अऊर खिपला नहीं होवय ऊ तुम्हरो लायी अशुद्ध हय।<verse eid="LEV 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 11:13" />फिर पक्षियों म सी इन ख अशुद्ध जानो, हि अशुद्ध होन को वजह नहीं खानो चाहिये, गरूड़, दाढ़ी वालो गिधाड़, कारो चमगादड़, <verse eid="LEV 11:13" /><verse number="14" style="v" sid="LEV 11:14" />लाल घार, अऊर कारी गिधाड़, <verse eid="LEV 11:14" /><verse number="15" style="v" sid="LEV 11:15" />अऊर अलग अलग तरह को कौवा, <verse eid="LEV 11:15" /><verse number="16" style="v" sid="LEV 11:16" />शुतुरमुर्ग, रात शिकरा, पानकोबंड़ी, अऊर अलग अलग तरह को शिकारी पक्षी, <verse eid="LEV 11:16" /><verse number="17" style="v" sid="LEV 11:17" />पिंजल्ला, बगला, बड़ो घुबड़, <verse eid="LEV 11:17" /><verse number="18" style="v" sid="LEV 11:18" />राजहंस, पानकोंबड़ी, गिधाड़, <verse eid="LEV 11:18" /><verse number="19" style="v" sid="LEV 11:19" />सारस, सब तरह को बगला, टिटिहरी अऊर चमगादड़।<verse eid="LEV 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 11:20" />“जितनो पंखा वालो कीड़ा चार पाय को बल चलय हय हि सब तुम्हरो लायी अशुद्ध हय।” <verse eid="LEV 11:20" /><verse number="21" style="v" sid="LEV 11:21" />पर रेंगन वालो अऊर पंखा वालो कीड़ा जो चार पाय को बल चलय हय, अऊर जिन्को पाय को ऊपर एक मुड़ी हुयी टांग होवय हय, जेको बल पर हि जमीन पर कूदय हय, उन्ख तुम खाय सकय हय। <verse eid="LEV 11:21" /><verse number="22" style="v" sid="LEV 11:22" />तुम इन म सी खाय सकय हय सब तरह की टिड्डियां, भौरा, झींगुर अऊर सब तरह को टिड्डे। <verse eid="LEV 11:22" /><verse number="23" style="v" sid="LEV 11:23" />पर अऊर सब रेंगन वालो पंखा वालो कीड़ा जो चार पाय वालो होवय हय हि तुम्हरो लायी अशुद्ध हय।<verse eid="LEV 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 11:24" />इन्को वजह तुम अशुद्ध ठहरो; जो कोयी सी इन की लोथ छुय जाये ऊ शाम तक अशुद्ध ठहरे। <verse eid="LEV 11:24" /><verse number="25" style="v" sid="LEV 11:25" />अऊर जो कोयी इन्की लोथ म सी कुछ भी उठायेंन ऊ अपनो कपड़ा धोयेंन अऊर शाम तक अशुद्ध रहेंन। <verse eid="LEV 11:25" /><verse number="26" style="v" sid="LEV 11:26" />फिर जितनो पशु चिरयो खुरी को होवय त हय पर पूरो तरह सी दोय हिस्सा म नहाय अऊर कवरी भी नहीं करय, हि तुम्हरो लायी अशुद्ध हंय; जो कोयी इन ख छुय लेयेंन ऊ अशुद्ध होय जायेंन। <verse eid="LEV 11:26" /><verse number="27" style="v" sid="LEV 11:27" />अऊर चार पाय को बल चलन वालो पशु म सी जितनो पंजा को बल चलय हय हि सब तुम्हरो लायी अशुद्ध हय; जो कोयी उन्की लोथ छुय लेयेंन ऊ शाम तक अशुद्ध रहेंन। <verse eid="LEV 11:27" /><verse number="28" style="v" sid="LEV 11:28" />अऊर जो कोयी उन्की लोथ उठायेंन ऊ अपनो कपड़ा धोये अऊर शाम तक अशुद्ध रहे; कहालीकि हि तुम्हरो लायी अशुद्ध हय।<verse eid="LEV 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 11:29" />जो धरती पर रेंगय हय उन म सी हि रेंगन वालो जन्तुवों तुम्हरो लायी अशुद्ध हय, मतलब मुंगुश, मुसा, अऊर अलग अलग तरह की बड़ी इजगुर, <verse eid="LEV 11:29" /><verse number="30" style="v" sid="LEV 11:30" />अऊर इजगुर, मगर, सांपसिरोली, घोरपड़ अऊर डोकेला। <verse eid="LEV 11:30" /><verse number="31" style="v" sid="LEV 11:31" />सब रेंगन वालो जन्तुवों म सीच तुम्हरो लायी अशुद्ध हय; जो कोयी इन्की लोथ ख छुयेंन त ऊ शाम तक अशुद्ध रहेंन। <verse eid="LEV 11:31" /><verse number="32" style="v" sid="LEV 11:32" />अऊर इन म सी कोयी की लोथ जो कोयी चिज पर गिर जाये ऊ भी अशुद्ध ठहरे, चाहे ऊ लकड़ी को बर्तन होना, चाहे कपड़ा, चाहे खाल, चाहे बोरा, यां कोयी काम को कैसो भी बर्तन कहाली नहीं होना; ऊ पानी म डाल्यो जाये, अऊर शाम तक अशुद्ध रहेंन, येको बाद यो चिज शुद्ध मानी जायेंन। <verse eid="LEV 11:32" /><verse number="33" style="v" sid="LEV 11:33" />यदि कोयी माटी को बर्तन म जन्तुवों को लोथ म सी कुछ गिर जाये, त ऊ बर्तन म जो कुछ भी होना ऊ अशुद्ध मान्यो जायेंन, तुम ऊ बर्तन ख तोड़ देवो। <verse eid="LEV 11:33" /><verse number="34" style="v" sid="LEV 11:34" />यदि यो बर्तन को पानी कोयी भी खान की चिज पर गिर जाये, ऊ अशुद्ध होय जायेंन अऊर यदि असो बर्तन म पिवन लायी कुछ होना त ऊ भी अशुद्ध होय जायेंन। <verse eid="LEV 11:34" /><verse number="35" style="v" sid="LEV 11:35" />अऊर यदि इन की लोथ म सी कुछ हिस्सा भट्टी यां चुलो पर गिर जाये त ऊ भी अशुद्ध होयेंन, अऊर ओख तोड़ दियो जाये; कहालीकि ऊ अशुद्ध हय, ऊ तुम्हरो लायी भी अशुद्ध होयेंन। <verse eid="LEV 11:35" /><verse number="36" style="v" sid="LEV 11:36" />पर सोता यां तलाव जेको म पानी जमा होवय हय ऊ त शुद्धच रहे; पर जो कोयी इन की लोथ ख छुयेंन ऊ अशुद्ध ठहरेंन। <verse eid="LEV 11:36" /><verse number="37" style="v" sid="LEV 11:37" />अऊर यदि इन की लोथ को कुछ हिस्सा बोयो जान वालो बीज पर गिर जाये, त ऊ बीज शुद्ध मान्यो जायेंन। <verse eid="LEV 11:37" /><verse number="38" style="v" sid="LEV 11:38" />पर यदि बीज पर पानी डाल्यो गयो होना अऊर ऊ लोथ म सी कुछ हिस्सा ओको पर गिर जाये, त ऊ तुम्हरो लायी अशुद्ध ठहरेंन।<verse eid="LEV 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 11:39" />“फिर जिन पशुवों ख खान की आज्ञा तुम ख दी गयी हय यदि उन म सी कोयी पशु मर जाये, त जो कोयी उन्की लोथ ख छुयेंन ऊ शाम तक अशुद्ध रहेंन।” <verse eid="LEV 11:39" /><verse number="40" style="v" sid="LEV 11:40" />अऊर ओकी लोथ म सी जो कोयी कुछ खाये ऊ अपनो कपड़ा धोये अऊर शाम तक अशुद्ध रहे; अऊर जो कोयी ओकी लोथ ख उठाये ऊ भी अपनो कपड़ा धोये अऊर शाम तक अशुद्ध रहे।<verse eid="LEV 11:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="LEV 11:41" />सब तरह को धरती पर रेंगन वालो जीव-जन्तु अशुद्ध हय; हि खायो नहीं जाये। <verse eid="LEV 11:41" /><verse number="42" style="v" sid="LEV 11:42" />धरती पर सब रेंगन वालो जन्तुवों म सी जितनो पेट यां चार पाय को बल चलय हय, यां बहुत जादा पाय वालो होवय हय, उन्ख तुम मत खावो; कहालीकि हि अशुद्ध हय। <verse eid="LEV 11:42" /><verse number="43" style="v" sid="LEV 11:43" />तुम अपनो आप ख रेंगन वालो जन्तुवों को द्वारा घृणित मत बनावो; अऊर नहीं उन्को द्वारा अपनो आप ख अशुद्ध कर क् अपवित्र होय जावो। <verse eid="LEV 11:43" /><verse number="44" style="v" sid="LEV 11:44" />कहालीकि मय तुम्हरो परमेश्वर यहोवा आय; येकोलायी अपनो आप ख शुद्ध कर क् पवित्र बन्यो रहो, कहालीकि मय पवित्र हय। येकोलायी तुम कोयी तरह को रेंगन वालो जन्तुवों को द्वारा जो धरती पर चलय हय अपनो आप ख अशुद्ध मत करो। <verse eid="LEV 11:44" /><verse number="45" style="v" sid="LEV 11:45" />“कहालीकि मय ऊ परमेश्वर आय जो तुम्ख मिस्र देश सी येकोलायी निकाल लायो हय कि तुम्हरो परमेश्वर ठहरू; येकोलायी तुम पवित्र बनो, कहालीकि मय पवित्र हय।”<verse eid="LEV 11:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 11:46" />पशुवों, पक्षियों, अऊर हर एक जनावरों, जो पानी म अऊर जमीन पर रेंगय हय उन्को लायी याच व्यवस्था हय, <verse eid="LEV 11:46" /><verse number="47" style="v" sid="LEV 11:47" />जेकोसी शुद्ध अऊर अशुद्ध अऊर खान की यां नहीं खान की चिजों म भेद करयो जाय सके।<verse eid="LEV 11:47" /></para>
  <chapter eid="LEV 11" />
  <chapter number="12" style="c" sid="LEV 12" />
  <para style="s">प्रसूता को शुद्धिकरन की विधि</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 12:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 12:1" /><verse number="2" style="v" sid="LEV 12:2" />इस्राएलियों सी कहो: जो बाई गर्भवती होय क बच्चा ख जनम देवय हय त वा सात दिन तक अशुद्ध रहेंन; जसी वा मासिक धर्म को समय अशुद्ध रह्य हय। <verse eid="LEV 12:2" /><verse number="3" style="v" sid="LEV 12:3" />अऊर आठवों दिन बच्चा को खतना करयो जाय। <verse eid="LEV 12:3" /><verse number="4" style="v" sid="LEV 12:4" />फिर वा बाई अपनो शुद्ध करन वालो रक्तस्राव म तैतीस दिन रहे; अऊर जब तक ओको शुद्ध होय जान को दिन पूरो नहीं होय जाये तब तक वा नहीं त कोयी पवित्र चिज ख छुयेंन, अऊर नहीं पवित्र जागा म जाय।<verse eid="LEV 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 12:5" />यदि वा टुरी ख जनम देवय हय, त वा चौदा दिन तक अशुद्ध रहेंन, जसी वा मासिक धर्म म रह्य हय, वा अपनो शुद्धिकरन को रक्तस्राव म छैसठ दिन तक रहेंन।<verse eid="LEV 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 12:6" />जब ओको शुद्ध होय जान को दिन पूरो होय जाये, तब ओख टुरा होय यां टुरी होय, वा होमबलि को लायी एक साल को मेंढा को बच्चा, अऊर पापबलि को लायी कबूत्तर को एक बच्चा यां पण्डुक मिलाप वालो तम्बू को फाटक पर याजक को जवर लाये। <verse eid="LEV 12:6" /><verse number="7" style="v" sid="LEV 12:7" />तब याजक ओख परमेश्वर को सामने भेंट चढ़ाय क ओको लायी पश्चाताप करे; अऊर वा अपनो रक्तस्राव सी शुद्ध होय जायेंन। जो बाई ख टुरा यां टुरी पैदा होय ओको लायी याच व्यवस्था हय।<verse eid="LEV 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 12:8" />“अऊर यदि ओको जवर मेंढा यां शेरी देन लायी धन नहीं होना, त दोय पण्डुक यां कबूत्तर को दोय बच्चा, एक होमबलि को लायी अऊर दूसरो पापबलि को लायी दे; अऊर याजक ओको लायी पश्चाताप करेंन, तब वा शुद्ध ठहरेंन।”<verse eid="LEV 12:8" /></para>
  <chapter eid="LEV 12" />
  <chapter number="13" style="c" sid="LEV 13" />
  <para style="s">कोढ़ को रोग को बारे म नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 13:1" />फिर परमेश्वर न मूसा अऊर हारून सी कह्यो, <verse eid="LEV 13:1" /><verse number="2" style="v" sid="LEV 13:2" />जब कोयी आदमी को शरीर को चमड़ी म सूजन यां चट्ठा यां चमक दार दाग होना, अऊर येकोसी ओको चमड़ी म कोढ़ को लक्षन दिखायी दे, त ओख हारून याजक को जवर यां ओको टुरा जो याजक हय उन म सी कोयी को जवर ले जाय। <verse eid="LEV 13:2" /><verse number="3" style="v" sid="LEV 13:3" />जब याजक ओको चमड़ी को चट्ठा ख देखे, अऊर यदि ऊ दाग को जागा को बाल सफेद होय गयो होना अऊर दाग चमड़ी सी गहरो दिखायी दे, त ऊ जान ले कि कोढ़ को रोग हय; अऊर याजक ऊ आदमी ख देख क ओख अशुद्ध ठहराये। <verse eid="LEV 13:3" /><verse number="4" style="v" sid="LEV 13:4" />पर यदि ऊ दाग चमड़ी म सफेद त होना, पर चमड़ी सी गहरो नहीं दिखायी दे, अऊर वहां को बाल सफेद नहीं भयो होना, त याजक ओख सात दिन तक अलग कर क् रखे; <verse eid="LEV 13:4" /><verse number="5" style="v" sid="LEV 13:5" />अऊर सातवों दिन तक याजक ओख देखे, अऊर यदि ऊ रोग वसो को वसो हय, अऊर ओको चमड़ी म नहीं फैल्यो हय, त याजक ओख अऊर भी सात दिन तक अलग कर क् रखे; <verse eid="LEV 13:5" /><verse number="6" style="v" sid="LEV 13:6" />अऊर सातवों दिन याजक ओख फिर सी देखे, की रोग की चमक कम हय अऊर रोग चमड़ी पर नहीं फैल रह्यो हय, त याजक ओख शुद्ध ठहराये; यो केवल चट्ठा आय अऊर अपनो कपड़ा धोय क शुद्ध होय जाय। <verse eid="LEV 13:6" /><verse number="7" style="v" sid="LEV 13:7" />पर यदि याजक की वा जांच करन को बाद जेको म ऊ शुद्ध ठहरायो गयो होतो, ऊ दाग ओकी चमड़ी पर बहुत फैल जाये, त ओख फिर सी याजक ख दिखायो जाय; <verse eid="LEV 13:7" /><verse number="8" style="v" sid="LEV 13:8" />अऊर यदि याजक ख दिखायी दे कि दाग चमड़ी म फैल गयो हय, त ऊ ओख अशुद्ध ठहराये; कहालीकि ऊ कोढ़च आय।<verse eid="LEV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 13:9" />यदि कोढ़ को रोग को जसो कोयी आदमी म हय, त ओख याजक को जवर लायो जाय। <verse eid="LEV 13:9" /><verse number="10" style="v" sid="LEV 13:10" />अऊर याजक ओख जांचे, अऊर ओकी चमड़ी पर सफेद रंग की सूजन हय, अऊर ओको वजह बाल भी सफेद भय गयो हय, अऊर ऊ सूजन म बिना चमड़ी को मांस हय, <verse eid="LEV 13:10" /><verse number="11" style="v" sid="LEV 13:11" />त याजक जानेंन कि ओको चमड़ी म पुरानो कोढ़ हय, येकोलायी ऊ ओख अशुद्ध ठहराये; अऊर ओख अलग नहीं रखेंन, कहालीकि ऊ अशुद्ध हय। <verse eid="LEV 13:11" /><verse number="12" style="v" sid="LEV 13:12" />अऊर यदि कोढ़ चमड़ी म बहुत जादा फूट क, जहां तक याजक देखे रोगी को मुंड सी पाय तक पूरो शरीर म फैल्यो होना, <verse eid="LEV 13:12" /><verse number="13" style="v" sid="LEV 13:13" />त याजक फिर सी जांचे, अऊर यदि कोढ़ ओको पूरो शरीर म फैल गयो हय, त याजक ओख शुद्ध ठहराये; अऊर ओको पूरो शरीर सफेद भय गयो हय त ऊ शुद्धच ठहरेंन। <verse eid="LEV 13:13" /><verse number="14" style="v" sid="LEV 13:14" />पर ओको म बिना चमड़ी को मांस दिखायी दे, तब ऊ अशुद्ध हय। <verse eid="LEV 13:14" /><verse number="15" style="v" sid="LEV 13:15" />अऊर याजक बिना चमड़ी को मांस देख क ओख अशुद्ध ठहराये; कहालीकि वसो बिना चमड़ी को मांस अशुद्धच होवय हय; अऊर ऊ कोढ़ को रोग आय। <verse eid="LEV 13:15" /><verse number="16" style="v" sid="LEV 13:16" />पर यदि ऊ बिना चमड़ी को मांस फिर सी सफेद होय जाये, त ऊ आदमी याजक को जवर जाये, <verse eid="LEV 13:16" /><verse number="17" style="v" sid="LEV 13:17" />अऊर याजक ओख जांचे, अऊर यदि ऊ दाग फिर सी सफेद भय गयो हय, त याजक रोगी ख शुद्ध ठहराये; ऊ शुद्ध हय।<verse eid="LEV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 13:18" />फिर यदि कोयी की चमड़ी म फोड़ा हय जो अच्छो भय गयो हय, <verse eid="LEV 13:18" /><verse number="19" style="v" sid="LEV 13:19" />अऊर फोड़ा को जागा म सफेद सूजन यां लाल जसो सफेद दाग होना, त ऊ याजक ख दिखाये; <verse eid="LEV 13:19" /><verse number="20" style="v" sid="LEV 13:20" />अऊर याजक ऊ फोड़ा ख जांचे, यदि ओख लगे कि चमड़ी म फैल रह्यो हय अऊर ओको बाल भी सफेद भय गयो हय, तब याजक ऊ आदमी ख अशुद्ध ठहराये; यो कोढ़ को रोग आय जेकी सुरूवात फोड़ा सी भयी हय। <verse eid="LEV 13:20" /><verse number="21" style="v" sid="LEV 13:21" />पर यदि याजक ओख जांचे कि ओको म सफेद बाल नहाय, अऊर चमड़ी म नहीं फैल रह्यो हय, अऊर ओकी चमक कम भय गयी हय, त याजक ऊ आदमी ख सात दिन तक अलग रखे। <verse eid="LEV 13:21" /><verse number="22" style="v" sid="LEV 13:22" />अऊर यदि ऊ रोग ऊ समय तक चमड़ी म सचमुच फैल जाये, त याजक ऊ आदमी ख अशुद्ध ठहराये; कहालीकि ऊ कोढ़ को रोग आय। <verse eid="LEV 13:22" /><verse number="23" style="v" sid="LEV 13:23" />पर यदि ऊ दाग नहीं फैलय अऊर अपनो जागा परच रह्य, त ऊ फोड़ा को दाग आय; तब याजक ऊ आदमी ख शुद्ध ठहराये।<verse eid="LEV 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 13:24" />फिर यदि कोयी की चमड़ी म जरयो हुयो घाव होना, अऊर ऊ जरयो हुयो घाव म बिना चमड़ी को लाल जसो दाग सफेद यां सफेदच होय जाये, <verse eid="LEV 13:24" /><verse number="25" style="v" sid="LEV 13:25" />त याजक ओख जांचे, अऊर ऊ दाग म को बाल सफेद भय गयो होना अऊर ऊ चमड़ी सी गहरो दिखायी दे, त ऊ कोढ़ आय; जो ऊ जरयो हुयो घाव को दाग म सी फूट निकल्यो हय; त याजक ऊ आदमी ख अशुद्ध ठहराये; कहालीकि ओको म कोढ़ को रोग आय। <verse eid="LEV 13:25" /><verse number="26" style="v" sid="LEV 13:26" />पर यदि याजक ओकी जांच करे कि दाग म सफेद बाल नहाय अऊर चमड़ी सी गहरो नहाय, अऊर ओकी चमक कम भय गयी हय, त ऊ ओख सात दिन तक अलग रखे, <verse eid="LEV 13:26" /><verse number="27" style="v" sid="LEV 13:27" />अऊर याजक सातवों दिन ओख जांचे, अऊर यदि ऊ चमड़ी म फैल गयो हय, त याजक ऊ आदमी ख अशुद्ध ठहराये; कहालीकि ओख कोढ़ को रोग हय। <verse eid="LEV 13:27" /><verse number="28" style="v" sid="LEV 13:28" />पर यदि ऊ दाग चमड़ी म नहीं फैल्यो हय अऊर अपनो जागा पर जसो को वसोच बन्यो हय, त ऊ जरन को वजह सूजयो हुयो हय, याजक ऊ आदमी ख शुद्ध ठहराये; कहालीकि ऊ दाग जरन को वजह हय।<verse eid="LEV 13:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 13:29" />“फिर यदि कोयी आदमी यां बाई को मुंड पर, यां आदमी को दाढ़ी म दाग होना, <verse eid="LEV 13:29" /><verse number="30" style="v" sid="LEV 13:30" />त याजक ऊ रोग की जांच करे, अऊर यदि ऊ चमड़ी को अन्दर गहरो दिखायी दे, अऊर ओको म भूरो भूरो पतलो बाल होना, त याजक ऊ आदमी ख अशुद्ध ठहराये; यो मुंड यां दाढ़ी को कोढ़ यां खुजली आय।” <verse eid="LEV 13:30" /><verse number="31" style="v" sid="LEV 13:31" />अऊर यदि याजक चर्मरोग को रोग ख जांचय कर क् देखय हय अऊर ओको म कारो बाल भी नहाय, त याजक चर्मरोग को रोगी ख सात दिन तक अलग रखे, <verse eid="LEV 13:31" /><verse number="32" style="v" sid="LEV 13:32" />अऊर याजक सातवों दिन रोग की जांच करे, यदि चर्मरोग फैल्यो नहीं होना, अऊर ओको म भूरो भूरो बाल नहीं होना, अऊर चर्मरोग चमड़ी को अन्दर गहरी नहीं दिखायी देवय हय, <verse eid="LEV 13:32" /><verse number="33" style="v" sid="LEV 13:33" />त ऊ आदमी दाढ़ी बनायेंन; पर ऊ चर्मरोग की जागा ख छोड़ देयेंन; अऊर याजक चर्मरोग वालो रोगी ख सात दिन तक अलग रखे। <verse eid="LEV 13:33" /><verse number="34" style="v" sid="LEV 13:34" />याजक सातवों दिन चर्मरोग की जांच करे, यदि चर्मरोग चमड़ी पर फैली नहाय अऊर वा चमड़ी को अन्दर गहरी दिखायी नहीं देवय हय, त याजक ऊ आदमी ख शुद्ध ठहराये; अऊर ऊ अपनो कपड़ा धोय क शुद्ध ठहरे। <verse eid="LEV 13:34" /><verse number="35" style="v" sid="LEV 13:35" />पर यदि ओको शुद्ध होन को बाद भी चर्मरोग चमड़ी म कुछ फैलय हय, <verse eid="LEV 13:35" /><verse number="36" style="v" sid="LEV 13:36" />त याजक ओख जांचे अऊर यदि वा चर्मरोग चमड़ी म फैल गयी हय, त याजक भूरो बाल ख नहीं ढूंढे; कहालीकि ऊ आदमी अशुद्ध हय। <verse eid="LEV 13:36" /><verse number="37" style="v" sid="LEV 13:37" />पर यदि ओकी नजर म चर्मरोग जसो को वसोच हय, अऊर ऊ जागा पर कारो बाल उग्यो हय, त चर्मरोग अच्छी भय गयी हय, अऊर ऊ आदमी शुद्ध हय; याजक ओख शुद्धच ठहराये।<verse eid="LEV 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="LEV 13:38" />फिर यदि कोयी आदमी यां बाई को चमड़ी म चमकदार सफेद दाग होना, <verse eid="LEV 13:38" /><verse number="39" style="v" sid="LEV 13:39" />त याजक जांचे, यदि चमड़ी म हि दाग थोड़ो सफेद होना, त ऊ समझे कि यो दागच आय; त ऊ आदमी शुद्ध हय।<verse eid="LEV 13:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 13:40" />“फिर जेको मुंड को बाल झड़ गयो होना, त समझनो कि ऊ टक्कल हय पर शुद्ध हय।” <verse eid="LEV 13:40" /><verse number="41" style="v" sid="LEV 13:41" />अऊर यदि कोयी आदमी को मुंड को सामने को अऊर कनपटी को बाल झड़ गयो हय, त ओको मस्तक टक्कल हय पर ऊ शुद्ध हय। <verse eid="LEV 13:41" /><verse number="42" style="v" sid="LEV 13:42" />पर यदि टक्कल मुंड पर यां मस्तक पर लाल जसो सफेद दाग होना, त समझनो कि ऊ ओको टक्कल मुंड यां मस्तक पर निकल्यो हुयो कोढ़ आय। <verse eid="LEV 13:42" /><verse number="43" style="v" sid="LEV 13:43" />येकोलायी याजक ओख जांचे, यदि ओको टक्कल मुंड यां टक्कल मस्तक पर चमड़ी को कोढ़ को समान लाल जसो सफेद हय,जसो चमड़ी को कोढ़ म होवय हय, <verse eid="LEV 13:43" /><verse number="44" style="v" sid="LEV 13:44" />त ऊ आदमी कोढ़ को रोगी हय अऊर अशुद्ध हय; अऊर याजक ओख निश्चितच अशुद्ध ठहराये; कहालीकि ऊ रोग ओको मुंड पर भयो हय।<verse eid="LEV 13:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="LEV 13:45" />कोढ़ जसो रोग को रोगी फट्यो कपड़ा पहिने अऊर ओको मुंड को बाल बिखरयो रहे, अऊर खल्लो को ओंठ ख झाक क पुकारे, “अशुद्ध, अशुद्ध!” <verse eid="LEV 13:45" /><verse number="46" style="v" sid="LEV 13:46" />जितनो दिन तक ओको म रोग रहेंन उतनो दिन तक ऊ अशुद्ध रहेंन; अऊर ऊ अशुद्धच हय येकोलायी ऊ अकेलो रहे, ओकी रहन की जागा छावनी को बाहेरच रहे।<verse eid="LEV 13:46" /></para>
  <para style="s">फफूंदी सी सम्बन्धित नियम</para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 13:47" />फिर जो कपड़ा म कोढ़ को रोग जसो दाग होना, चाहे ऊ कपड़ा ऊन को हो यां सन को हो, <verse eid="LEV 13:47" /><verse number="48" style="v" sid="LEV 13:48" />अऊर सन को सियो हुयो यां ऊन को बुन्यो हुयो कपड़ा को कोयी तुकड़ा पर यां चमड़ा यां चमड़ा सी बनी कोयी भी चिज म हो, <verse eid="LEV 13:48" /><verse number="49" style="v" sid="LEV 13:49" />यदि दाग सियो हुयो कपड़ा म, यां उन को बुन्यो हुयो कपड़ा, यां चमड़ा म यां चमड़ा को तुकड़ा म बनी कोयी चिज म हरी यां लाल दिखायी दे, त समझनो की ऊ कोढ़ को रोग आय अऊर ओख याजक ख दिखायो जाये। <verse eid="LEV 13:49" /><verse number="50" style="v" sid="LEV 13:50" />अऊर याजक दाग की जांच करे, अऊर दाग वाली चिज ख सात दिन अलग रखे। <verse eid="LEV 13:50" /><verse number="51" style="v" sid="LEV 13:51" />त ओख सातवों दिन दाग की फिर सी जांच करे, यदि कपड़ा म, यां कपड़ा को बुन्यो हुयो हिस्सा म, यां चमड़ा कि बनी कोयी चिज म दाग फैल गयो हय, चाहे ऊ चमड़ा कोयी भी काम म आवत होना, ऊ हानी कर क् कोढ़ को लक्षन आय, ऊ अशुद्ध हय। <verse eid="LEV 13:51" /><verse number="52" style="v" sid="LEV 13:52" />ऊ कपड़ा को बन्यो हुयो हिस्सा म रोग होना, चाहे ऊ ऊन को यां सन को, यां चमड़ा की चिज होना, ओख जलाय देयेंन, ऊ रोग हानी कर क् कोढ़ आय; ऊ चिज ख आगी म जलाय दियो जाय।<verse eid="LEV 13:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="LEV 13:53" />यदि याजक जांच कर क् देखे कि रोग कपड़ा को बन्यो हुयो हिस्सा म, यां चमड़ा की कोयी चिज म नहीं फैल्यो हय, <verse eid="LEV 13:53" /><verse number="54" style="v" sid="LEV 13:54" />अऊर याजक वा दाग वालो चिज ख धोवन की आज्ञा दे, अऊर भी ओख सात दिन लायी अलग रखे। <verse eid="LEV 13:54" /><verse number="55" style="v" sid="LEV 13:55" />अऊर धोवन को बाद याजक ऊ चिज की जांच करे, यदि दाग को रंग बदल्यो नहाय, अऊर दाग फैल्यो नहाय, त समझनो की वा चिज अशुद्ध हय; तुम ओख आगी म जलावो, चाहे दाग आगु को भाग म हो यां पीछु को भाग म। <verse eid="LEV 13:55" /><verse number="56" style="v" sid="LEV 13:56" />पर यदि याजक जांच कर क् देखे कि धोवन को बाद दाग की चमक कम भय गयी हय, त याजक ऊ कपड़ा यां चमड़ा म सी फाड़ क निकाले; <verse eid="LEV 13:56" /><verse number="57" style="v" sid="LEV 13:57" />अऊर यदि दाग कपड़ा म, यां कपड़ा को बन्यो हुयो हिस्सा म, यां चमड़ा की कोयी भी चिज म दिखायी देवय हय, त ऊ फिर सी फैल रह्यो हय; त तुम वा चिज ख आगी म जलाय देवो। <verse eid="LEV 13:57" /><verse number="58" style="v" sid="LEV 13:58" />यदि ऊ उन को कपड़ा म होना, या चमड़ा की जो चिज होना ओको सी जब धोयी जायेंन अऊर दाग निकलती रहेंन, त वा दूसरी बार धोय क शुद्ध ठहरेंन।<verse eid="LEV 13:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="LEV 13:59" />त ऊन यां सन को कपड़ा म यां चमड़ा की बनी कोयी चिज म कोढ़ जसो दाग हय त ओख शुद्ध यां अशुद्ध ठहरान की याच व्यवस्था आय।<verse eid="LEV 13:59" /></para>
  <chapter eid="LEV 13" />
  <chapter number="14" style="c" sid="LEV 14" />
  <para style="s">कोढ़ सी शुद्ध ठहरायो जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 14:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 14:1" /><verse number="2" style="v" sid="LEV 14:2" />कोढ़ को रोगी ख शुद्ध ठहरान को नियम यो आय। कि ओख याजक को जवर लायो जाय; <verse eid="LEV 14:2" /><verse number="3" style="v" sid="LEV 14:3" />अऊर याजक छावनी को बाहेर जाये, अऊर याजक ऊ कोढ़ी ख जांचे, अऊर यदि ओको कोढ़ को रोग ठीक भय गयो होना, <verse eid="LEV 14:3" /><verse number="4" style="v" sid="LEV 14:4" />त याजक आज्ञा दे कि शुद्ध ठहरायो जान वालो लायी दोय जीन्दो शुद्ध पक्षी, देवदार की लकड़ी, जूफा को पौधा अऊर लाल रंग की दोरी लायो जाये; <verse eid="LEV 14:4" /><verse number="5" style="v" sid="LEV 14:5" />अऊर याजक आज्ञा दे कि बहतो हुयो पानी को ऊपर माटी को बर्तन म एक पक्षी ख बलि करयो जाय। <verse eid="LEV 14:5" /><verse number="6" style="v" sid="LEV 14:6" />तब ऊ दूसरो जीन्दो पक्षी ख देवदार की लकड़ी अऊर लाल रंग की दोरी अऊर जूफा को पौधा इन सब ख ले क एक संग ऊ पक्षी को खून म जो बहतो हुयो पानी को ऊपर बलि करयो गयो होतो डुबाय दे; <verse eid="LEV 14:6" /><verse number="7" style="v" sid="LEV 14:7" />अऊर कोढ़ सी शुद्ध होन वालो आदमी को ऊपर सात बार छिड़क क ओख शुद्ध ठहराये, तब ऊ जीन्दो पक्षी ख खुलो मैदान म छोड़ दे। <verse eid="LEV 14:7" /><verse number="8" style="v" sid="LEV 14:8" />अऊर शुद्ध होन वालो अपनो कपड़ा ख धोये, अऊर अपनो सब बाल मुंडवाय क पानी सी नहाय क शुद्ध होय जाय, अऊर ओको बाद छावनी म आय सकेंन, पर सात दिन तक अपनो तम्बू सी बाहेरच रहे। <verse eid="LEV 14:8" /><verse number="9" style="v" sid="LEV 14:9" />अऊर सातवों दिन ऊ अपनो मुंड को बाल, दाढ़ी, भौंहों अऊर अपनो पूरो शरीर को बाल मुंडवाय ले; अऊर अपनो कपड़ा धोय ले, अऊर पानी सी नहाये, तब ऊ शुद्ध ठहरेंन।<verse eid="LEV 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 14:10" />“आठवों दिन ऊ दोय निर्दोष मेंढा को बच्चा, अऊर एक निर्दोष मेंढी, अऊर अन्नबलि लायी तेल मिल्यो हुयो पाच किलो मैदा अऊर अरधो लिटर तेल लाये।” <verse eid="LEV 14:10" /><verse number="11" style="v" sid="LEV 14:11" />शुद्ध करन वालो याजक इन चिजों को संग शुद्ध होन वालो आदमी ख परमेश्वर को सामने मिलाप वालो तम्बू को द्वार पर खड़ो करे। <verse eid="LEV 14:11" /><verse number="12" style="v" sid="LEV 14:12" />तब याजक एक मेंढा अऊर अरधो लिटर तेल अऊर दोषबलि ख ले क हिलावन की भेंट को रूप म परमेश्वर को जवर लाये। <verse eid="LEV 14:12" /><verse number="13" style="v" sid="LEV 14:13" />अऊर ऊ मेंढा को बच्चा ख उच जागा म जहां ऊ पापबलि अऊर होमबलि पशुवों को बलिदान करयो जावय हय, उच पवित्र जागा म बलिदान करे; कहालीकि जसो पापबलि याजक को निजी हिस्सा हय वसोच दोषबलि भी ओकोच निजी हिस्सा ठहरेंन; ऊ परमपवित्र हय। <verse eid="LEV 14:13" /><verse number="14" style="v" sid="LEV 14:14" />तब याजक दोषबलि को खून म सी कुछ अंश ले क शुद्ध होन वालो को दायो कान को टोक पर, अऊर ओको दायो हाथ अऊर दायो पाय को अंगूठा पर लगाये। <verse eid="LEV 14:14" /><verse number="15" style="v" sid="LEV 14:15" />तब याजक जैतून को अरधो लिटर तेल म सी कुछ ले क अपनो बायो हाथ कि हतेली पर डाले, <verse eid="LEV 14:15" /><verse number="16" style="v" sid="LEV 14:16" />अऊर अपनो बायो हाथ को हतेली को तेल म दायो हाथ को बोट डुबाय क परमेश्वर को सामने सात बार छिड़के। <verse eid="LEV 14:16" /><verse number="17" style="v" sid="LEV 14:17" />अऊर जो ओकी हतेली पर तेल बच जाये याजक ओख शुद्ध होन वालो को दायो कान को टोक पर अऊर दायो हाथ अऊर दायो पाय को अंगूठा पर दोषबलि को लग्यो हुयो खून को ऊपर लगाये; <verse eid="LEV 14:17" /><verse number="18" style="v" sid="LEV 14:18" />अऊर याजक अपनी हतेली पर को तेल ऊ शुद्ध होन वालो को मुंड पर डाले। अऊर याजक ओको लायी परमेश्वर को सामने प्रायश्चित करे।<verse eid="LEV 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 14:19" />याजक पापबलि ख भी चढ़ाय क ओको लायी जो अपनी अशुद्धता सी शुद्ध होन वालो होना प्रायश्चित करे; अऊर ओको बाद होमबलि पशु को बलिदान चढ़ाये : <verse eid="LEV 14:19" /><verse number="20" style="v" sid="LEV 14:20" />अन्नबलि समेत वेदी पर भेंट चढ़ाये : अऊर याजक ओको लायी प्रायश्चित करे, तब ऊ शुद्ध ठहरेंन।<verse eid="LEV 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 14:21" />“पर यदि ऊ आदमी गरीब होना अऊर भेंट देन लायी ओको जवर धन नहाय, त अपनो प्रायश्चित लायी हिलावन की भेंट को रूप म दोषबलि लायी एक मेंढा को बच्चा, अऊर अन्नबलि लायी जैतून को तेल सी सन्यो हुयो लगभग पाच किलो मैदा, अऊर लगभग अरधो लिटर जैतून को तेल आये; <verse eid="LEV 14:21" /><verse number="22" style="v" sid="LEV 14:22" />अऊर दोय पंडुक, यां कबूत्तर को दोय बच्चा लाये, जो ऊ लाय सकय हय लाये; एक पापबलि लायी अऊर दूसरो होमबलि लायी होय। <verse eid="LEV 14:22" /><verse number="23" style="v" sid="LEV 14:23" />अऊर आठवों दिन ऊ आदमी शुद्ध होन लायी उन सब ख मिलाप वालो तम्बू को फाटक पर, परमेश्वर को आगु, याजक को जवर लाये; <verse eid="LEV 14:23" /><verse number="24" style="v" sid="LEV 14:24" />तब याजक लगभग अरधो लिटर जैतून को तेल अऊर दोषबलि को मेंढा को बच्चा ख ले क हिलावन की भेंट लायी परमेश्वर को सामने लाये। <verse eid="LEV 14:24" /><verse number="25" style="v" sid="LEV 14:25" />फिर दोषबलि मेंढा को बच्चा ख बलिदान करे; अऊर याजक ओको खून म सी कुछ ले क शुद्ध होन वालो आदमी को दायो कान को टोक पर, अऊर ओको दायो हाथ अऊर दायो पाय को अंगूठा पर लगाये। <verse eid="LEV 14:25" /><verse number="26" style="v" sid="LEV 14:26" />अऊर याजक ऊ तेल म सी कुछ अपनो बायो हाथ की हतेली पर डाले, <verse eid="LEV 14:26" /><verse number="27" style="v" sid="LEV 14:27" />अऊर दायो हाथ को बोट सी बायो हाथ को हतेली पर को तेल परमेश्वर को सामने सात बार छिड़के; <verse eid="LEV 14:27" /><verse number="28" style="v" sid="LEV 14:28" />फिर याजक अपनो दायो हाथ पर को कुछ तेल शुद्ध होन वालो को दायो कान टोक पर, अऊर ओको दायो हाथ अऊर दायो पाय को अंगूठा पर, जहां दोषबलि को खून लगायो गयो होतो वहां लगाये। <verse eid="LEV 14:28" /><verse number="29" style="v" sid="LEV 14:29" />याजक अपनी हतेली पर को बच्यो हुयो तेल ख शुद्ध होन वालो आदमी को मुंड पर लगाय दे अऊर याजक ऊ आदमी लायी परमेश्वर को सामने प्रायश्चित करे। <verse eid="LEV 14:29" /><verse number="30" style="v" sid="LEV 14:30" />तब ऊ पण्डुकों यां कबूत्तरी को बच्चां म सी जो ऊ लाय सक्यो होना एक ख चढ़ाये, <verse eid="LEV 14:30" /><verse number="31" style="v" sid="LEV 14:31" />ऊ पक्षी म सी एक पापबलि लायी अऊर दूसरो अन्नबलि समेत होमबलि लायी चढ़ाये; यो तरह याजक शुद्ध होन वालो लायी परमेश्वर को सामने प्रायश्चित करे। <verse eid="LEV 14:31" /><verse number="32" style="v" sid="LEV 14:32" />जेख कोढ़ को रोग भयो होना, अऊर ओको जवर इतनो धन नहीं होना कि ऊ अपनो शुद्धिकरन लायी ऊ जरूरतों को सामान नहीं लाय सकय, त ओको लायी याच व्यवस्था आय।”<verse eid="LEV 14:32" /></para>
  <para style="s">भवन को कोढ़</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 14:33" />फिर परमेश्वर न मूसा अऊर हारून सी कह्यो, <verse eid="LEV 14:33" /><verse number="34" style="v" sid="LEV 14:34" />“जब तुम लोग कनान देश म पहुंचो, जेक मय तुम्हरो अधिकार म दे रह्यो हय, ऊ समय यदि मय कोढ़ को रोगी ख तुम्हरो अधिकार को कोयी घर म दिखाऊं, <verse eid="LEV 14:34" /><verse number="35" style="v" sid="LEV 14:35" />त ऊ घर को मालिक आय क याजक ख बताये, मोख असो दिखायी दे रह्यो हय कि मोरो घर म कोयी रोग हय। <verse eid="LEV 14:35" /><verse number="36" style="v" sid="LEV 14:36" />तब याजक आज्ञा देयेंन कि जो घर म जांच करन ख मोरो जान सी पहिले ऊ घर ख खाली करो, कहीं असो नहीं होय कि जो कुछ ऊ घर म हय हि सब अशुद्ध ठहरे; अऊर तब ओको बाद याजक घर कि जांच करन अन्दर जाय। <verse eid="LEV 14:36" /><verse number="37" style="v" sid="LEV 14:37" />तब याजक ऊ रोग की जांच करे; अऊर यदि ऊ रोग घर की दीवालों पर हरी हरी यां लाल लाल खोदी हुयी लकीरों को रूप म हय, अऊर हि लकीरें दीवाल म गहरी दिखय हय, <verse eid="LEV 14:37" /><verse number="38" style="v" sid="LEV 14:38" />त याजक घर सी बाहेर फाटक पर जाय क ऊ घर ख सात दिन तक बन्द कर क् रखेंन। <verse eid="LEV 14:38" /><verse number="39" style="v" sid="LEV 14:39" />अऊर सातवों दिन याजक फिर सी आय क देखेंन; अऊर यदि ऊ रोग घर की दीवालों पर फैल गयो हय, <verse eid="LEV 14:39" /><verse number="40" style="v" sid="LEV 14:40" />त याजक आज्ञा दे की जिन गोटावों ख रोग हय उन्ख निकाल क नगर सी बाहेर अशुद्ध जागा म फेक दे; <verse eid="LEV 14:40" /><verse number="41" style="v" sid="LEV 14:41" />अऊर ऊ घर को अन्दर चारयी तरफ खुरचवायेंन, अऊर ऊ खुरची हुयी माटी ख नगर सी बाहेर अशुद्ध जागा म डाल दे; <verse eid="LEV 14:41" /><verse number="42" style="v" sid="LEV 14:42" />अऊर उन निकाल्यो गयो गोटावों को जागा म दूसरो गोटा लाय क लगाये, अऊर ऊ ताजो गारा सी जुड़ायी करे।<verse eid="LEV 14:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="LEV 14:43" />“यदि गोटावों ख निकलवानो, घर ख खुरचनो अऊर जुड़ायी अऊर लीपायी करन को बाद ऊ रोग फिर सी घर म फूट क निकलय हय, <verse eid="LEV 14:43" /><verse number="44" style="v" sid="LEV 14:44" />त याजक आय क जांच करे; अऊर यदि ऊ रोग घर म फैल गयो हय, त ऊ जान ले कि घर म हानी कर क् कोढ़ आय; त ऊ घर अशुद्ध हय। <verse eid="LEV 14:44" /><verse number="45" style="v" sid="LEV 14:45" />येकोलायी ऊ घर ख गिराय क गोटा, लकड़ी अऊर गारा समेत सब चिजों ख उठवाय क नगर सी बाहेर अशुद्ध जागा म फिंकवाय दे। <verse eid="LEV 14:45" /><verse number="46" style="v" sid="LEV 14:46" />अगर येको अलावा यदि कोयी ऊ समय म ऊ घर म जाये, जो बन्द होतो, त ऊ आदमी शाम तक अशुद्ध रहेंन; <verse eid="LEV 14:46" /><verse number="47" style="v" sid="LEV 14:47" />अऊर जो कोयी ऊ घर म सोयेंन ऊ अपनो कपड़ा धोयेंन; अऊर जो कोयी ऊ घर म जेवन करेंन ऊ भी अपनो कपड़ा ख धोयेंन।<verse eid="LEV 14:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="LEV 14:48" />“पर यदि याजक आय क देखे, कि घर कि लीपायी को बाद रोग घर म नहीं फैल्यो हय, त ऊ घर ख शुद्ध ठहराये; कहालीकि ऊ रोग दूर भय गयो हय। <verse eid="LEV 14:48" /><verse number="49" style="v" sid="LEV 14:49" />तब याजक ऊ घर ख शुद्ध करन लायी दोय पक्षी, देवदार की लकड़ी, लाल रंग को कपड़ा अऊर जूफा लाये, <verse eid="LEV 14:49" /><verse number="50" style="v" sid="LEV 14:50" />तब एक पक्षी बहतो हुयो पानी को ऊपर माटी को बर्तन म बलिदान करे, <verse eid="LEV 14:50" /><verse number="51" style="v" sid="LEV 14:51" />फिर ऊ जीन्दो पक्षी को संग देवदार की लकड़ी, जूफा अऊर लाल रंग को कपड़ा ऊ बलिदान करयो हुयो पक्षी को खून, अऊर बहतो हुयो पानी म डुबाय क ऊ घर पर सात बार छिड़के। <verse eid="LEV 14:51" /><verse number="52" style="v" sid="LEV 14:52" />यो तरह ऊ पक्षी को खून, बहतो हुयो पानी, जीन्दो पक्षी, देवदार की लकड़ी, जूफा अऊर लाल रंग को कपड़ा को संग ऊ घर ख शुद्ध करे। <verse eid="LEV 14:52" /><verse number="53" style="v" sid="LEV 14:53" />तब ऊ जीन्दो पक्षी ख नगर सी बाहेर खुलो मैदान म छोड़ दे; योच रीति सी ऊ घर लायी प्रायश्चित करे, तब ऊ शुद्ध ठहरेंन।”<verse eid="LEV 14:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="LEV 14:54" />कोयी भी तरह को कोढ़ को रोग, अऊर दाग, <verse eid="LEV 14:54" /><verse number="55" style="v" sid="LEV 14:55" />अऊर कपड़ा, अऊर घर को कोढ़, <verse eid="LEV 14:55" /><verse number="56" style="v" sid="LEV 14:56" />सूजन, फोड़ा अऊर दाग को बारे म, <verse eid="LEV 14:56" /><verse number="57" style="v" sid="LEV 14:57" />शुद्ध अऊर अशुद्ध ठहरान की शिक्षा देन की व्यवस्था याच आय। अऊर सब तरह को कोढ़ की याच व्यवस्था आय।<verse eid="LEV 14:57" /></para>
  <chapter eid="LEV 14" />
  <chapter number="15" style="c" sid="LEV 15" />
  <para style="s">शरीर सी बहन वालो अशुद्ध स्राव</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 15:1" />फिर परमेश्वर न मूसा अऊर हारून सी कह्यो, <verse eid="LEV 15:1" /><verse number="2" style="v" sid="LEV 15:2" />“इस्राएली लोगों सी कहो, कि जो कोयी आदमी को शरीर सी धात बहय हय, त ओको धात अशुद्ध हय। <verse eid="LEV 15:2" /><verse number="3" style="v" sid="LEV 15:3" />ऊ धात चाहे बहतो रहे, यां बहनो बन्द भी होय जाये, तब भी ओकी अशुद्धता बनी रहेंन। <verse eid="LEV 15:3" /><verse number="4" style="v" sid="LEV 15:4" />धात बहन वालो आदमी जो बिस्तर पर आराम करय हय ऊ बिस्तर अशुद्ध होय जावय हय, अऊर हर एक चिज जेको पर ऊ बैठय हय ऊ भी अशुद्ध होय जावय हय। <verse eid="LEV 15:4" /><verse number="5" style="v" sid="LEV 15:5" />अऊर जो कोयी ओको बिस्तर ख छुवय ऊ भी अपनो कपड़ा ख धोय क पानी सी नहाय ले, अऊर ऊ शाम तक अशुद्ध रहेंन। <verse eid="LEV 15:5" /><verse number="6" style="v" sid="LEV 15:6" />अऊर जो चिज पर ऊ धात बहन वालो आदमी बैठय हय, ऊ चिज पर दूसरो कोयी आदमी बैठय हय त ऊ भी अपनो कपड़ा धोय क पानी सी नहाये, अऊर शाम तक अशुद्ध रहे। <verse eid="LEV 15:6" /><verse number="7" style="v" sid="LEV 15:7" />अऊर धात बहन वालो आदमी को शरीर ख कोयी छुय ले त ऊ भी अपनो कपड़ा धोय क पानी सी नहाय क अऊर शाम तक अशुद्ध रहे। <verse eid="LEV 15:7" /><verse number="8" style="v" sid="LEV 15:8" />यदि धात बहन वालो आदमी कोयी शुद्ध आदमी पर थूक देवय हय, त ऊ अपनो कपड़ा धोय क पानी सी नहाय क शाम तक अशुद्ध रहे। <verse eid="LEV 15:8" /><verse number="9" style="v" sid="LEV 15:9" />अऊर जो वाहन पर ऊ बैठय हय त ऊ चिज अशुद्ध ठहरे। <verse eid="LEV 15:9" /><verse number="10" style="v" sid="LEV 15:10" />यदि कोयी आदमी उन चिजों म सी कोयी ख भी छुय लेवय हय, जो धात बहन वालो आदमी को खल्लो की हय त ऊ शाम तक अशुद्ध रहेंन। अऊर जो कोयी आदमी ऊ चिज ख उठावय हय त ऊ अपनो कपड़ा ख धोय क पानी सी नहाय ले, अऊर शाम तक अशुद्ध रहे। <verse eid="LEV 15:10" /><verse number="11" style="v" sid="LEV 15:11" />यदि धात बहन वालो आदमी बिना हाथ धोयो कोयी ख छुय लेवय त ऊ अपनो कपड़ा धोय क पानी सी नहाय क शाम तक अशुद्ध रहे। <verse eid="LEV 15:11" /><verse number="12" style="v" sid="LEV 15:12" />अऊर धात बहन वालो आदमी कोयी माटी को बर्तन ख छुय लेवय हय त ओख तोड़ दियो जाये, अऊर यदि लकड़ी को बर्तन हय त उन सब बर्तन ख पानी सी धोयो जाय।<verse eid="LEV 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 15:13" />“जब धात बहन वालो आदमी अपनो धात सी शुद्ध होय जाये, तब ऊ अपनो शुद्ध होन लायी सात दिन गिन ले, अऊर ऊ दिन बीतन पर अपनो कपड़ा ख धोय क बहतो हुयो पानी सी नहाय ले; तब ऊ शुद्ध ठहरेंन। <verse eid="LEV 15:13" /><verse number="14" style="v" sid="LEV 15:14" />अऊर आठवों दिन ऊ दोय पंडुक यां कबूत्तरी को दोय बच्चा लाय क मिलाप वालो तम्बू को फाटक पर परमेश्वर को सामने याजक ख दे। <verse eid="LEV 15:14" /><verse number="15" style="v" sid="LEV 15:15" />तब याजक उन म सी एक पापबलि लायी, अऊर दूसरो होमबलि लायी भेंट चढ़ाये; अऊर याजक ओको लायी धात को वजह परमेश्वर को सामने प्रायश्चित करे।<verse eid="LEV 15:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 15:16" />“फिर यदि कोयी आदमी को वीर्यपात होय जावय हय, त ऊ अपनो पूरो शरीर ख पानी सी धोये, अऊर ऊ शाम तक अशुद्ध रहेंन। <verse eid="LEV 15:16" /><verse number="17" style="v" sid="LEV 15:17" />अऊर जो कोयी कपड़ा पर यां चमड़ा पर ऊ वीर्य गिरय हय त ओख पानी सी धोयो जाये, अऊर शाम तक अशुद्ध रहेंन। <verse eid="LEV 15:17" /><verse number="18" style="v" sid="LEV 15:18" />यदि कोयी आदमी कोयी बाई सी सहवास करय अऊर यो प्रक्रिया म ओको वीर्यपात भयो होना, त हि दोयी पानी सी नहाये, अऊर शाम तक अशुद्ध रहे।<verse eid="LEV 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 15:19" />“फिर जब कोयी बाई मासिक धर्म म रहे, त वा सात दिन तक अशुद्ध ठहरी रहे, अऊर जो कोयी ओख छुयेंन ऊ शाम तक अशुद्ध रहेंन। <verse eid="LEV 15:19" /><verse number="20" style="v" sid="LEV 15:20" />अऊर वा अपनो मासिक धर्म म जो चिज पर वा सोवय हय यां बैठय हय, त ऊ सब चिज अशुद्ध ठहरेंन। <verse eid="LEV 15:20" /><verse number="21" style="v" sid="LEV 15:21" />अऊर जो कोयी ओको बिस्तर ख छुयेंन ऊ अपनो कपड़ा धोय क पानी सी नहाये, अऊर शाम तक अशुद्ध रहे। <verse eid="LEV 15:21" /><verse number="22" style="v" sid="LEV 15:22" />अऊर जो कोयी ऊ चिज ख छुय लेवय हय जेको पर वा बैठय हय त ऊ अपनो कपड़ा धोय क पानी सी नहाये, अऊर शाम तक अशुद्ध रहेंन। <verse eid="LEV 15:22" /><verse number="23" style="v" sid="LEV 15:23" />चाहे यो ओको बिस्तर यां कोयी भी चिज होना जेको पर वा बैठय हय, यदि कोयी ओख छुय लेवय हय, त ऊ शाम तक अशुद्ध रहेंन। <verse eid="LEV 15:23" /><verse number="24" style="v" sid="LEV 15:24" />यदि कोयी आदमी ओको संग हकिकत म सहवास कर लेवय हय अऊर वा बाई की मासिक धर्म अशुद्धता ओको पर आय जावय हय, त ऊ सात दिन तक अशुद्ध रहेंन, अऊर हर एक बिस्तर पर ऊ सोवय हय अशुद्ध ठहरेंन।<verse eid="LEV 15:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 15:25" />“यदि कोयी बाई ख खून बहनो ओको मासिक धर्म अशुद्धता को समय मच नहीं बल्की ओको अलावा भी जादा दिनों तक खून बहतो रहे, त वा मासिक धर्म अशुद्धता को जसी अशुद्ध रहेंन। <verse eid="LEV 15:25" /><verse number="26" style="v" sid="LEV 15:26" />जो जो बिस्तर पर वा अपनो खून बहन को दिनों म सोवय हय, त वा मासिक धर्म को जसी अशुद्ध ठहरेंन; अऊर जो बिस्तर पर वा बैठेंन, हि भी ओको मासिक धर्म रहन को दिनों को जसो अशुद्ध ठहरेंन। <verse eid="LEV 15:26" /><verse number="27" style="v" sid="LEV 15:27" />अऊर जो कोयी उन चिजों ख छुयेंन ऊ अशुद्ध ठहरेंन, येकोलायी ऊ अपनो कपड़ा धोय क पानी सी नहाये, अऊर शाम तक अशुद्ध रहेंन। <verse eid="LEV 15:27" /><verse number="28" style="v" sid="LEV 15:28" />पर जब वा बाई अपनो मासिक धर्म सी शुद्ध होय जाये, तब सी वा सात दिन गिन ले, उन दिनों को बितन को बाद वा शुद्ध ठहरेंन। <verse eid="LEV 15:28" /><verse number="29" style="v" sid="LEV 15:29" />फिर वा आठवों दिन दोय पंडुक यां कबूत्तर को दोय बच्चा लाय क मिलाप वालो तम्बू को फाटक पर याजक को जवर लाये। <verse eid="LEV 15:29" /><verse number="30" style="v" sid="LEV 15:30" />तब याजक एक ख पापबलि अऊर दूसरों ख होमबलि लायी चढ़ाये; अऊर याजक ओको मासिक धर्म अशुद्धता को लायी परमेश्वर को सामने प्रायश्चित करे।<verse eid="LEV 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 15:31" />“यो तरह तुम इस्राएली समाज ख उन्की अशुद्धता सी अलग रखो, कहीं असो नहीं होय कि हि मोरो तम्बू ख जो उन्को बीच म हय, अशुद्ध करे अऊर अपनी अशुद्धता को वजह मर जाय।”<verse eid="LEV 15:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 15:32" />जेको धात बह रह्यो हय अऊर जो आदमी को वीर्यपात होन को वजह ऊ अशुद्ध होय जावय हय, <verse eid="LEV 15:32" /><verse number="33" style="v" sid="LEV 15:33" />अऊर जो बाई मासिक धर्म अशुद्धता को वजह अस्वस्थ होना; पर चाहे आदमी होना यां बाई होना, जो कोयी ख धात रोग होना, अऊर जो आदमी अशुद्ध बाई सी सहवास करय हय, त इन सब लायी याच व्यवस्था आय।<verse eid="LEV 15:33" /></para>
  <chapter eid="LEV 15" />
  <chapter number="16" style="c" sid="LEV 16" />
  <para style="s">प्रायश्चित को दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 16:1" />जब हारून को दोय टुरा परमेश्वर को सामने जान को वजह मर गयो, ओको बाद परमेश्वर न मूसा सी बाते करी। <verse eid="LEV 16:1" /><verse number="2" style="v" sid="LEV 16:2" />अऊर परमेश्वर न मूसा सी कह्यो, “अपनो भाऊ हारून सी कहो कि ऊ परदा को अन्दर परमपवित्र जागा म वाचा को सन्दूक को ऊपर को प्रायश्चित वालो ढक्कन को सामने, बीचवालो परदा को अन्दर, पवित्र जागा म हर समय सिरे, नहीं त मर जायेंन; कहालीकि मय प्रायश्चित वालो ढक्कन को ऊपर बादर म दिखायी देऊं।” <verse eid="LEV 16:2" /><verse number="3" style="v" sid="LEV 16:3" />जब हारून पवित्र जागा म सिरे तब यो रीति सी सिरे, ऊ पापबलि लायी एक गोरा अऊर होमबलि लायी एक मेंढा ले क आये।<verse eid="LEV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 16:4" />तब हारून सन को पवित्र कपड़ा पहिने, अऊर अपनो शरीर पर सन की जांघिया पहिने, अऊर सन को पट्टा बान्धे, अऊर सन को फेटा बान्धे, यो पवित्र कपड़ा आय, ऊ पानी सी नहान को बादच पहिने।<verse eid="LEV 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 16:5" />फिर ऊ इस्राएलियों की मण्डली को जवर सी पापबलि लायी दोय बकरा अऊर होमबलि लायी एक मेंढा लाये। <verse eid="LEV 16:5" /><verse number="6" style="v" sid="LEV 16:6" />अऊर हारून ऊ पापबलि को गोरा ख चढ़ाय क अपनो अऊर अपनो परिवार लायी प्रायश्चित करे। <verse eid="LEV 16:6" /><verse number="7" style="v" sid="LEV 16:7" />येको बाद ऊ दोयी बकरा ख ले क मिलाप वालो तम्बू को फाटक पर परमेश्वर को सामने खड़ो करे; <verse eid="LEV 16:7" /><verse number="8" style="v" sid="LEV 16:8" />अऊर हारून दोयी बकरा पर चिट्ठियां डाले, एक चिट्ठी परमेश्वर लायी अऊर दूसरी अजाजेल<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">जंगल म छोड़न लायी</char></note> लायी होयेंन। <verse eid="LEV 16:8" /><verse number="9" style="v" sid="LEV 16:9" />अऊर जो बकरा पर परमेश्वर को नाम की चिट्ठी निकलेंन ओख हारून पापबलि लायी चढ़ाये; <verse eid="LEV 16:9" /><verse number="10" style="v" sid="LEV 16:10" />पर जो बकरा पर अजाजेल लायी चिट्ठी निकलेंन ओख परमेश्वर को सामने जीन्दो खड़ो करयो जाये कि ओको पर प्रायश्चित करयो जाये, अऊर ओख अजाजेल लायी जंगल म छोड़ दियो जाये।<verse eid="LEV 16:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 16:11" />“हारून ऊ पापबलि को गोरा ख जो ओको लायी हय लाये, अऊर ओख बलिदान कर क् अपनो अऊर अपनो परिवार को पाप ख झाके।” <verse eid="LEV 16:11" /><verse number="12" style="v" sid="LEV 16:12" />ऊ परमेश्वर को सामने वेदी पर जलतो हुयो कोयला सी भरयो हुयो धूपदान अऊर अपनी दोय मुट्ठी भर बारीक कूटी हुयी सुगन्धित धूप बीच वालो परदा को अन्दर लाये। <verse eid="LEV 16:12" /><verse number="13" style="v" sid="LEV 16:13" />ऊ धूप ख परमेश्वर को आगु आगी म डाले, जेकोसी धूप को धुवा वाचा को सन्दूक पर गवाह चिट्ठी को ऊपर को प्रायश्चित को ढक्कन को ऊपर छाय जायेंन, नहीं त ऊ मर जायेंन; <verse eid="LEV 16:13" /><verse number="14" style="v" sid="LEV 16:14" />तब ऊ बछड़ा खून म सी कुछ ले क पूर्व दिशा को तरफ प्रायश्चित को ढक्कन को ऊपर अपनो बोट सी छिड़क दे, अऊर फिर ऊ खून म सी कुछ बोट को द्वारा ऊ ढक्कन को सामने भी सात बार छिड़क दे।<verse eid="LEV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 16:15" />फिर हारून ऊ पापबलि को बकरा ख जो साधारन लोगों लायी होयेंन बलिदान कर क् अऊर ओको खून ख बीच वालो परदा को अन्दर ले आये, अऊर जो तरह गोरा को खून सी ओन करयो होतो ठीक वसोच ऊ बकरा खून सी भी करे, मतलब ओख प्रायश्चित को ढक्कन को ऊपर अऊर ओको सामने छिड़क दे। <verse eid="LEV 16:15" /><verse number="16" style="v" sid="LEV 16:16" />फिर ऊ पवित्र जागा लायी इस्राएली लोगों की अशुद्धता यां उन्को सब पापों को सम्बन्ध म करयो गयो अपराध को लायी प्रायश्चित पूरो करे अऊर यो तरह ऊ मिलाप वालो तम्बू को लायी भी करे, जो उन्की अशुद्धतावों को बीच उन्को संग रह्य हय। <verse eid="LEV 16:16" /><verse number="17" style="v" sid="LEV 16:17" />जब हारून प्रायश्चित करन लायी पवित्र जागा म जाये, तब सी अपनो लायी अऊर घराना लायी अऊर इस्राएल की पूरी मण्डली लायी प्रायश्चित कर क् बाहेर निकलय तब तक कोयी भी मिलाप वालो तम्बू म नहीं रहे। <verse eid="LEV 16:17" /><verse number="18" style="v" sid="LEV 16:18" />फिर ऊ निकल क ऊ वेदी को जवर जो परमेश्वर को सामने हय जाये अऊर ओको लायी प्रायश्चित करे, मतलब बछड़ा को अऊर बकरा को कुछ खून दोयी म सी कुछ ले क वा वेदी को चारयी कोना को सींगो पर लगाये। <verse eid="LEV 16:18" /><verse number="19" style="v" sid="LEV 16:19" />अऊर ऊ खून म सी कुछ अपनो बोट सी सात बार ओको पर छिड़के। अऊर इस्राएली लोगों की अशुद्धता सी पवित्र करे।<verse eid="LEV 16:19" /></para>
  <para style="s">बलि को बकरा</para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 16:20" />“जब हारून पवित्र जागा, मिलाप वालो तम्बू अऊर वेदी लायी पाप झाकन को बाद, एक जीन्दो बकरा ख लाये। <verse eid="LEV 16:20" /><verse number="21" style="v" sid="LEV 16:21" />अऊर हारून अपनो जीन्दो बकरा को मुंड पर अपनो दोयी हाथ रख क इस्राएली लोगों को पूरो बुरो कामों, अऊर उन्को सब अपराधों, मतलब ओको पूरो पापों ख स्वीकार करे, अऊर उन्ख बकरा को मुंड पर रख क ओख कोयी आदमी को हाथ जो यो काम लायी तैयार रहे निर्जन जमीन म भेज क छोड़ दे। <verse eid="LEV 16:21" /><verse number="22" style="v" sid="LEV 16:22" />यो बकरा इन्को सब बुरो कामों को बोझ अपनो ऊपर उठाय क निर्जन जमीन म लिजायेंन; येकोलायी ऊ आदमी ऊ बकरा ख जंगल म छोड़ दे।<verse eid="LEV 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 16:23" />“तब हारून मिलाप वालो तम्बू म आयेंन, अऊर जो सन को कपड़ा ख पहिन्यो हुयो ओन पवित्र जागा म सिरतो समय पहिन्यो होतो ओख उतार क वहांच पर रख दे। <verse eid="LEV 16:23" /><verse number="24" style="v" sid="LEV 16:24" />फिर ऊ कोयी पवित्र जागा म पानी सी नहाय क अपनो कपड़ा पहिन ले, अऊर बाहेर आय क अपनी अऊर अपनो लोगों की होमबलि ख चढ़ाय क अपनो लायी अऊर लोगों को पापों ख झाकेंन। <verse eid="LEV 16:24" /><verse number="25" style="v" sid="LEV 16:25" />फिर ऊ पापबलि की चरबी ख वेदी पर आगी म जलाये। <verse eid="LEV 16:25" /><verse number="26" style="v" sid="LEV 16:26" />अऊर जो आदमी अजाजेल लायी बकरा ख छोड़ क आयेंन, अऊर ऊ अपनो कपड़ा धोयेंन, अऊर पानी सी नहायेंन तब ऊ छावनी म सिरेंन। <verse eid="LEV 16:26" /><verse number="27" style="v" sid="LEV 16:27" />अऊर पापबलि को गोरा अऊर बकरा भी जिन्को खून पवित्र जागा म पाप ख झाकन लायी लायो गयो होतो, उन्ख छावनी को बाहेर लायो जायेंन अऊर वहां उन्की खाल, मांस अऊर गोबर आगी म जलाय दियो जायेंन। <verse eid="LEV 16:27" /><verse number="28" style="v" sid="LEV 16:28" />अऊर जो उन्ख जलायेंन ऊ अपनो कपड़ा धोये, अऊर पानी सी नहान को बाद ऊ छावनी म सिर सकेंन।<verse eid="LEV 16:28" /></para>
  <para style="s">प्रायश्चित को दिन माननो</para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 16:29" />“तुम लोगों लायी या विधि हमेशा लायी होयेंन कि सातवों महिना को दसवों दिन तुम अपनो अपनो जीव ख दु:ख देवो, अऊर ऊ दिन कोयी, चाहे ऊ तुम्हरो निजी देश को होना यां विदेश को होना तुम्हरो बीच म रह्य हय, कोयी भी तरह को काम काज नहीं करेंन; <verse eid="LEV 16:29" /><verse number="30" style="v" sid="LEV 16:30" />कहालीकि योच ऊ दिन आय जो दिन तुम्ख शुद्ध करन लायी पापों ख झाक्यो जायेंन; अऊर तुम परमेश्वर को सामने अपनो पूरो पापों सी शुद्ध ठहरो। <verse eid="LEV 16:30" /><verse number="31" style="v" sid="LEV 16:31" />यो तुम्हरो लायी परम आराम को दिन ठहरे, अऊर तुम ऊ दिन उपवास करो अऊर कोयी तरह को काम-काज मत करो; याच हमेशा की विधि आय। <verse eid="LEV 16:31" /><verse number="32" style="v" sid="LEV 16:32" />अऊर अपनो बाप की जागा पर याजक पद लायी जेको अभिषेक करयो जाये, ऊ याजक सन को पवित्र कपड़ा पहिन क पाप ख झाके, <verse eid="LEV 16:32" /><verse number="33" style="v" sid="LEV 16:33" />उच याजक पवित्र जागा, मिलाप वालो तम्बू अऊर वेदी लायी प्रायश्चित करे; अऊर सब याजकों अऊर मण्डली को सब लोगों लायी भी प्रायश्चित करे। <verse eid="LEV 16:33" /><verse number="34" style="v" sid="LEV 16:34" />अऊर तुम्हरो लायी हमेशा की या विधि होयेंन कि इस्राएली लोगों लायी ओको सब पापों को वजह हर साल एक बार प्रायश्चित करयो जाय।”</para>
  <para style="p" vid="LEV 16:34">मूसा न ठीक वसोच करयो, जसो परमेश्वर न आज्ञा दी होती हारून न करयो।<verse eid="LEV 16:34" /></para>
  <chapter eid="LEV 16" />
  <chapter number="17" style="c" sid="LEV 17" />
  <para style="s">खून की पवित्रता</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 17:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 17:1" /><verse number="2" style="v" sid="LEV 17:2" />“हारून अऊर ओको टुरावों सी अऊर सब इस्राएलियों सी कहो कि परमेश्वर न या आज्ञा दी हय।” <verse eid="LEV 17:2" /><verse number="3" style="v" sid="LEV 17:3" />यदि इस्राएल को घराना म सी कोयी भी आदमी जो कोयी मेंढा को बच्चा यां शेरी को बच्चा की हत्या, छावनी म यां छावनी को बाहेर करे, <verse eid="LEV 17:3" /><verse number="4" style="v" sid="LEV 17:4" />अऊर ऊ येख मिलापवालो तम्बू को फाटक पर परमेश्वर को निवास को सामने भेंट चढ़ावन लायी नहीं ले जाय, त ऊ आदमी ख हत्या को दोष लगेन; अऊर ऊ आदमी न खून बहायो हय, त असो आदमी ख अपनो लोगों को बीच सी बाहेर निकाल्यो जायेंन। <verse eid="LEV 17:4" /><verse number="5" style="v" sid="LEV 17:5" />या विधि को यो उद्देश हय कि इस्राएली लोग अपनी बलियों को बलिदान हि खुलो मैदान म करय हय, हि बलियों ख मिलापवालो तम्बू को फाटक पर याजक को जवर लाये, अऊर परमेश्वर को लायी मेल-मिलाप बलि को रूप म भेंट चढ़ाये; <verse eid="LEV 17:5" /><verse number="6" style="v" sid="LEV 17:6" />अऊर याजक खून ख मिलापवालो तम्बू को द्वार पर परमेश्वर की वेदी को ऊपर छिड़के, अऊर चरबी ख ओको सुखदायक सुगन्ध लायी जलाये। <verse eid="LEV 17:6" /><verse number="7" style="v" sid="LEV 17:7" />हि जो बकरा देवता को पूजक होय क व्यभिचार करय हय, हि फिर अपनो बलिपशुवों ख उन्को लायी बलिदान नहीं करे। तुम्हरी पीढ़ियों को लायी या हमेशा की विधि होयेंन।<verse eid="LEV 17:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 17:8" />“तय उन्को सी यो कहजो कि इस्राएल को घरानो को लोगों म सी यां परदेशियों म सी कोयी आदमी जो उन्को बीच म रह्य हय, होमबलि यां मेल-मिलाप बलि चढ़ाये, <verse eid="LEV 17:8" /><verse number="9" style="v" sid="LEV 17:9" />अऊर ओख मिलापवालो तम्बू को द्वार पर परमेश्वर को लायी भेंट चढ़ावन लायी नहीं लाये; त ऊ आदमी ख अपनो लोगों म सी मार डाल्यो जायेंन।”<verse eid="LEV 17:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 17:10" />“फिर इस्राएल को घराना म सी यां उन्को बीच म रहन वालो परदेशियों म सी कोयी आदमी कोयी तरह को खून खाये, मय ऊ खून खान वालो को विरुद्ध होय क ओख ओको लोगों को बीच म सी नाश कर डालूं।” <verse eid="LEV 17:10" /><verse number="11" style="v" sid="LEV 17:11" />कहालीकि शरीर को जीव खून म रह्य हय; अऊर ओख मय न तुम लोगों ख वेदी पर चढ़ावन लायी दियो हय कि तुम्हरो जीवों को लायी पापों ख झाक्यो जाये; कहालीकि खून म जीव होन को वजह ओको सी पश्चाताप होवय हय। <verse eid="LEV 17:11" /><verse number="12" style="v" sid="LEV 17:12" />येकोलायी मय इस्राएली लोगों सी कहू हय कि तुम म सी कोयी यां कोयी परदेशी जो तुम्हरो बीच म रह्य हय ऊ भी कभी खून नहीं खाये।,<verse eid="LEV 17:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 17:13" />“इस्राएलियों म सी यां उन्को बीच म रहन वालो परदेशियों म सी कोयी आदमी शिकार कर क् खान को लायक पशु यां पक्षी ख पकड़ेंन; त ऊ ओको खून ख जमीन म कुड़ाय क माटी सी झाक दे।” <verse eid="LEV 17:13" /><verse number="14" style="v" sid="LEV 17:14" />कहालीकि सब प्रानियों को शरीर को जीवन खून म रह्य हय जो ओको जीव को संग एक हय; येकोलायी मय इस्राएलियों सी कहू हय कि कोयी प्रानी को खून ख तुम मत खावो, कहालीकि सब प्रानियों को जीव ओको खूनच आय; जो कोयी ओख खायेंन ओख नाश करयो जायेंन।<verse eid="LEV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 17:15" />यदि कोयी आदमी, चाहे ऊ देशी यां परदेशी होना, हिंसक पशु द्वारा फाड़्यो गयो पशु यां स्वाभाविक मृत्यु सी मरयो हुयो पशु को मांस खायेंन त ऊ अपनो कपड़ा ख धोय क पानी सी नहाये, ऊ शाम तक अशुद्ध रहेंन; अऊर तब ऊ शुद्ध होयेंन। <verse eid="LEV 17:15" /><verse number="16" style="v" sid="LEV 17:16" />“पर यदि ऊ कपड़ा ख नहीं धोवय अऊर पानी सी नहीं नहावय, त ओख अपनो पाप को बोझ खुद ख उठानो पड़ेंन।”<verse eid="LEV 17:16" /></para>
  <chapter eid="LEV 17" />
  <chapter number="18" style="c" sid="LEV 18" />
  <para style="s">अनैतिक यौन सम्बन्ध को बारे म नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 18:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 18:1" /><verse number="2" style="v" sid="LEV 18:2" />“इस्राएली लोगों सी कहो कि मय तुम्हरो परमेश्वर आय।” <verse eid="LEV 18:2" /><verse number="3" style="v" sid="LEV 18:3" />तुम मिस्र देश को कामों को अनुसार व्यवहार मत करो, जहां तुम रहत होतो; अऊर नहीं कनान देश को कामों को, जहां मय तुम्ख लिजाय रह्यो हय; तुम उन्की विधियों को पालन भी मत करो। <verse eid="LEV 18:3" /><verse number="4" style="v" sid="LEV 18:4" />तुम मोरो नियमों को पालन करो, अऊर मोरीच विधियों ख मानतो हुयो उन पर चलो। मय तुम्हरो परमेश्वर यहोवा आय। <verse eid="LEV 18:4" /><verse number="5" style="v" sid="LEV 18:5" />येकोलायी तुम मोरो नियमों अऊर मोरी विधियों ख हमेशा मानो; जो आदमी या विधियों ख मानेंन ऊ इन्को वजह जीन्दो रहेंन। मय यहोवा आय।<verse eid="LEV 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 18:6" />“तुम म सी कोयी अपनी कुटुम्ब की बाई को तन उघाड़न लायी ओको जवर मत जावो। मय यहोवा आय।” <verse eid="LEV 18:6" /><verse number="7" style="v" sid="LEV 18:7" />तय अपनी माय को तन उघाड़ क अपनो बाप को अपमान मत करो; वा तुम्हरी जनम देन वाली माय आय, येकोलायी तुम ओको तन मत उघाड़जो। <verse eid="LEV 18:7" /><verse number="8" style="v" sid="LEV 18:8" /><note caller="+" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="1CO 5:1">१ कुरिन्थियों ५:१</ref></char></note>तय अपनी सौतेली माय सी सहवास मत करजो; यो तुम्हरो बाप को अपमान होयेंन। <verse eid="LEV 18:8" /><verse number="9" style="v" sid="LEV 18:9" />तुम अपनी बहिन चाहे सगी होना चाहे सौतेली होना, चाहे ओको जनम घर म भयो होना यां दूसरों जागा म, ओको तन मत उघाड़जो। <verse eid="LEV 18:9" /><verse number="10" style="v" sid="LEV 18:10" />अपनी नातिन, जो वा बेटा की बेटी होना यां बेटी की बेटी होना ओको तन मत उघाड़जो; कहालीकि ओको अपमान तुम्हरो अपमान हय। <verse eid="LEV 18:10" /><verse number="11" style="v" sid="LEV 18:11" />तुम्हरी सौतेली बहिन जो तुम्हरो बाप सी पैदा भयी हय, वा तुम्हरी बहिनच आय, ओको तन मत उघाड़जो। <verse eid="LEV 18:11" /><verse number="12" style="v" sid="LEV 18:12" />तुम अपनी फूफू को तन मत उघाड़जो; वा त तुम्हरो बाप को जवर की बहिन आय। <verse eid="LEV 18:12" /><verse number="13" style="v" sid="LEV 18:13" />तुम अपनी मावसी को तन मत उघाड़ो; कहालीकि वा तुम्हरी माय की जवर की बहिन आय। <verse eid="LEV 18:13" /><verse number="14" style="v" sid="LEV 18:14" />तय अपनो काका तन मत उघाड़जो, मतलब ओकी पत्नी को जवर मत जावो; वा त तुम्हरी काकी आय। <verse eid="LEV 18:14" /><verse number="15" style="v" sid="LEV 18:15" />तय अपनी बहू को तन मत उघाड़जो; वा त तुम्हरो टुरा की पत्नी आय, ओको तन मत उघाड़जो। <verse eid="LEV 18:15" /><verse number="16" style="v" sid="LEV 18:16" />तय अपनी भाभी को तन मत उघाड़जो; वा त तुम्हरो भाऊ कोच तन आय। <verse eid="LEV 18:16" /><verse number="17" style="v" sid="LEV 18:17" />तय कोयी बाई अऊर ओकी बेटी दोयी को तन मत उघाड़जो, अऊर नहीं ओकी बेटा की बेटी को अऊर नहीं ओकी बेटी की बेटी को तन मत उघाड़जो, हि त जवर की कुटुम्बिनी आय; असो करनो महापाप हय। <verse eid="LEV 18:17" /><verse number="18" style="v" sid="LEV 18:18" />तय अपनी पत्नी की बहिन ख अपनाय क सौतन मत बनायजो, अऊर ओकी बहिन को जीन्दी रहतो हुयो ओको तन मत उघाड़जो।<verse eid="LEV 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 18:19" />जब कोयी बाई मासिक धर्म को वजह अशुद्ध हय, तब तक ओको जवर ओको तन उघाड़न मत जाजो। <verse eid="LEV 18:19" /><verse number="20" style="v" sid="LEV 18:20" />फिर अपनो पड़ोसी की पत्नी सी कुकर्म कर क् अपनो ख अशुद्ध मत करजो। <verse eid="LEV 18:20" /><verse number="21" style="v" sid="LEV 18:21" />तय अपनी कोयी भी सन्तान ख मोलेक देवता ख होमबलि कर क् मत चढ़ायजो, अऊर अपनो परमेश्वर को नाम ख अपवित्र मत करजो; मय यहोवा आय। <verse eid="LEV 18:21" /><verse number="22" style="v" sid="LEV 18:22" /><note caller="+" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="ROM 1:27">रोमियों 1:27</ref></char></note>तय बाई को संग सहवास को रीति सी आदमी को संग सहवास मत करजो; ऊ त घिनौना काम आय। <verse eid="LEV 18:22" /><verse number="23" style="v" sid="LEV 18:23" />तुम कोयी पशु सी कुकर्म कर क् खुद ख अशुद्ध मत करो, अऊर नहीं कोयी बाई कुकर्म करन को उद्देश सी कोयी पशु को सामने जाये; यो त अनर्थ हय।<verse eid="LEV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 18:24" />यो तरह को काम म सी कोयी भी काम कर क् अशुद्ध मत होय जाजो, कहालीकि जिन राज्य को लोगों ख मय तुम्हरो सामने सी निकालन पर हय हि यो तरह को काम कर क् अशुद्ध भय गयो हय। <verse eid="LEV 18:24" /><verse number="25" style="v" sid="LEV 18:25" />अऊर ओको देश भी अशुद्ध भय गयो हय, यो वजह मय ओको पर ओको बुरो कामों की सजा देऊ हय, अऊर ऊ देश अपनो निवासियों ख निकाल देवय हय। <verse eid="LEV 18:25" /><verse number="26" style="v" sid="LEV 18:26" />यो वजह तुम लोग मोरी विधियों अऊर नियमों ख हमेशा मानो, अऊर चाहे देशी होना यां तुम्हरो बीच म रहन वालो परदेशी होना, तुम म सी कोयी भी असो घृणित काम नहीं करेंन। <verse eid="LEV 18:26" /><verse number="27" style="v" sid="LEV 18:27" />कहालीकि असो सब घृणित कामों ख ऊ देश को लोग जो तुम सी पहिले वहां रहत होतो हि करतो आयो हय, येकोसीच ऊ देश अशुद्ध भय गयो हय। <verse eid="LEV 18:27" /><verse number="28" style="v" sid="LEV 18:28" />अब असो नहीं होय कि जो रीति सी जो राज्य को लोग तुम सी पहिले ऊ देश म रहत होतो ओख ओन निकाल दियो, उच रीति सी जब तुम ओख अशुद्ध करो, त ऊ तुम्ख भी निकाल देयेंन। <verse eid="LEV 18:28" /><verse number="29" style="v" sid="LEV 18:29" />जितनो असो कोयी घृणित काम करेंन हि सब अपनो लोगों म सी नाश करयो जायेंन।<verse eid="LEV 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 18:30" />या आज्ञा जो मय न तुम्ख मानन लायी दी हय ओख तुम मानो, अऊर जो घृणित रीतियां तुम सी पहिले मानी जात होती उन्म सी कोयी रीति पर नहीं चलनो, अऊर नहीं उन को वजह अशुद्ध होय जावो। मय तुम्हरो परमेश्वर यहोवा आय।<verse eid="LEV 18:30" /></para>
  <chapter eid="LEV 18" />
  <chapter number="19" style="c" sid="LEV 19" />
  <para style="s">पवित्रता अऊर आचरन को नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 19:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 19:1" /><verse number="2" style="v" sid="LEV 19:2" />इस्राएलियों की पूरी मण्डली सी कहो कि तुम पवित्र बन्यो रहो; कहालीकि मय तुम्हरो परमेश्वर यहोवा पवित्र हय। <verse eid="LEV 19:2" /><verse number="3" style="v" sid="LEV 19:3" />तुम अपनी माय अऊर अपनो बाप को आदर करनो, अऊर मोरो आराम दिनों ख माननो : मय तुम्हरो परमेश्वर यहोवा आय।<verse eid="LEV 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 19:4" />तुम मूर्तियों को तरफ मत फिरो, अऊर धातु को देवतावों की मूर्तियां ढाल क मत बनावो; मय तुम्हरो परमेश्वर यहोवा आय।<verse eid="LEV 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 19:5" />जब तुम परमेश्वर लायी मेल-मिलाप बलि करो, तब असो बलिदान करो जेकोसी मय तुम सी खुश होय जाऊं। <verse eid="LEV 19:5" /><verse number="6" style="v" sid="LEV 19:6" />जो दिन ओको मांस बलिदान करो उच दिन यां ओको दूसरो दिन ओख खायो जाये, पर तीसरो दिन तक बच जाये ओख आगी म जलाय दियो जाये। <verse eid="LEV 19:6" /><verse number="7" style="v" sid="LEV 19:7" />यदि ओको म सी कुछ भी तीसरो दिन खायो जाये, त यो अशुद्ध ठहरेंन, अऊर स्वीकार नहीं करयो जायेंन, <verse eid="LEV 19:7" /><verse number="8" style="v" sid="LEV 19:8" />अऊर ओख खानवालो परमेश्वर को पवित्र चिज ख अपवित्र ठहरावय हय, येकोलायी ओख अपनो बुरो काम को बोझ खुद ख उठानो पड़ेंन; अऊर ऊ व्यक्ति अपनो लोगों म सी नाश करयो जायेंन।<verse eid="LEV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 19:9" />फिर जब तुम अपनी जमीन की फसल काटो तब अपनो खेत को कोना कोना तक मत काटो, अऊर काट्यो हुयो फसल की गिरी पड़ी लोम्बा ख मत चुनो। <verse eid="LEV 19:9" /><verse number="10" style="v" sid="LEV 19:10" />अऊर अपनी अंगूर की बाड़ी को पूरो अंगूर मत तोड़जो, अऊर अपनी अंगूर की बाड़ी को झड़्यो हुयो अंगूरों ख जमा मत करजो; उन्ख गरीब अऊर परदेशी लोगों लायी छोड़ देजो; मय तुम्हरो परमेश्वर यहोवा आय।<verse eid="LEV 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="LEV 19:11" />“तुम चोरी नहीं करनो, अऊर नहीं एक दूसरो सी कपट करनो, अऊर नहीं झूठ बोलनो। <verse eid="LEV 19:11" /><verse number="12" style="v" sid="LEV 19:12" /><note caller="+" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="MAT 5:33">मत्ती ५:३३</ref></char></note>तुम मोरो नाम की झूठी कसम खाय क अपनो परमेश्वर को नाम कलंकित मत करो; मय परमेश्वर यहोवा आय।<verse eid="LEV 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 19:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:13 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 20:8">मत्ती २०:८</ref>; <ref loc="1TI 5:18">१ तीमुथियुस ५:१८</ref>; <ref loc="JAS 5:4">याकूब ५:४</ref></char>
    </note>“एक दूसरो पर अन्धेर नहीं करनो, अऊर नहीं एक दूसरो ख लूटनो। मजूर की मजूरी तोरो जवर पूरी रात सबेरे तक नहीं रहनो चाहिये। <verse eid="LEV 19:13" /><verse number="14" style="v" sid="LEV 19:14" />बहिरा ख श्राप नहीं देनो, अऊर अन्धा को आगु ठेस की चिज नहीं रखनो; अऊर अपनो परमेश्वर की भय रखो; मय परमेश्वर यहोवा आय।<verse eid="LEV 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 19:15" />“न्याय करतो समय अन्याय नहीं करनो; अऊर नहीं गरीब को पक्ष लेनो अऊर नहीं बड़ो आदमी को मुंह देख क बिचार करनो; एक दूसरो को न्यायीपन सी न्याय करनो। <verse eid="LEV 19:15" /><verse number="16" style="v" sid="LEV 19:16" />तुम अपनो लोगों को बीच म निन्दा करतो नहीं फिरनो, अऊर एक दूसरो को खून बहावन की युक्ति नहीं बनावो; मय परमेश्वर आय।<verse eid="LEV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 19:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:17 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 18:15">मत्ती १८:१५</ref>
      </char>
    </note>“अपनो मन म एक दूसरो को खिलाफ घृणा नहीं रखो; अपनो पड़ोसी ख जरूर डाटनो, नहीं त ओको पाप को बोझ तोख उठानो पड़ेंन। <verse eid="LEV 19:17" /><verse number="18" style="v" sid="LEV 19:18" /><note caller="+" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="MAT 5:43">मत्ती ५:४३</ref>; <ref loc="MAT 19:19">मत्ती १९:१९</ref>; <ref loc="MAT 22:39">मत्ती २२:३९</ref>; <ref loc="MRK 12:31-33">मरकुस १२:३१-३३</ref>; <ref loc="LUK 10:27">लूका १०:२७</ref>; <ref loc="ROM 12:19">रोमियों १२:१९</ref>; <ref loc="ROM 13:9">रोमियों १३:९</ref>; <ref loc="GAL 5:14">गलातियों ५:१४</ref>; <ref loc="JAS 2:8">याकूब २:८</ref></char></note>बदला नहीं लेनो, अऊर अपनो लोगों सी दुस्मनी नहीं रखनो, पर एक दूसरो सी अपनो जसो प्रेम रखो; मय परमेश्वर आय।<verse eid="LEV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 19:19" />“तुम मोरी विधियों ख हमेशा मानो। अपनो जनावरों ख दूसरो जाति को जनावरों सी गर्भधारन मत होन देवो; अपनो खेत म दोय तरह को बीज मत बोवो; अऊर दोय तरह सी बन्यो हुयो कपड़ा मत पहिनो।<verse eid="LEV 19:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 19:20" />“यदि कोयी आदमी असी बाई को संग जो दासी हय, जेकी मंगनी दूसरो आदमी सी भयी होना, अऊर जेक दाम दे क मुक्त नहीं करयो गयो होना; यदि ओको सी कोयी कुकर्म करे, त उन दोयी ख सजा त मिलेंन, पर हि दोयी मार डाल्यो नहीं जाये। <verse eid="LEV 19:20" /><verse number="21" style="v" sid="LEV 19:21" />पर ऊ आदमी मिलापवालो तम्बू को फाटक पर एक मेंढा दोषबलि लायी लाये। <verse eid="LEV 19:21" /><verse number="22" style="v" sid="LEV 19:22" />अऊर याजक ओको करयो हुयो पाप को वजह दोषबलि को मेंढा को द्वारा ओको लायी परमेश्वर को सामने प्रायश्चित करे; तब ओको करयो हुयो पाप माफ करयो जायेंन।<verse eid="LEV 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 19:23" />“फिर जब तुम कनान देश म पहुंच क कोयी तरह को खान लायी सब तरह को फर को झाड़ लगावो, त उन्को फर तुम्हरो लायी तीन साल तक खतनारहित रहेंन; येकोलायी उन म सी कुछ नहीं खायो जाये। <verse eid="LEV 19:23" /><verse number="24" style="v" sid="LEV 19:24" />अऊर चौथो साल म उन्को सब फर परमेश्वर की स्तुति भेंट को रूप म पवित्र ठहरे। <verse eid="LEV 19:24" /><verse number="25" style="v" sid="LEV 19:25" />तब पाचवों साल म तुम उन्को फर खाय सकय हय, येकोलायी कि हि तुम्ख बहुत फर दे सके; मय तुम्हरो परमेश्वर यहोवा आय।<verse eid="LEV 19:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 19:26" />“तुम खून लग्यो हुयो कुछ मांस मत खावो। अऊर जादू-टोना मत करो, अऊर शुभ यां अशुभ मुहुर्तों ख मत मानो। <verse eid="LEV 19:26" /><verse number="27" style="v" sid="LEV 19:27" />तुम अपनो मुंड को बाल घेरा रख क मत काटो, अऊर नहीं अपनी दाढ़ी ख किनारा सी काटो। <verse eid="LEV 19:27" /><verse number="28" style="v" sid="LEV 19:28" />कोयी की मृत्यु को वजह अपनो शरीर पर चिरा मत लगावो, अऊर नहीं गुदना गुदवानो; मय परमेश्वर आय।<verse eid="LEV 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 19:29" />“अपनी टुरी ख वेश्या बनाय क अपवित्र नहीं करनो, असो नहीं होय कि देश वेश्यागमन को वजह दुष्टता सी भर जाये। <verse eid="LEV 19:29" /><verse number="30" style="v" sid="LEV 19:30" />मोरो आराम दिन ख मानो, अऊर मोरो पवित्र जागा को डर मानो; मय परमेश्वर आय।”<verse eid="LEV 19:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 19:31" />“सलाह देन वालो अऊर भूत-प्रेत साधन वालो को तरफ मत फिरो, असो की खोज कर क् उन्को वजह अशुद्ध मत होय जावो; मय तुम्हरो परमेश्वर यहोवा आय।<verse eid="LEV 19:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="LEV 19:32" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:32 </char>
      <char style="xt" closed="false">
        <ref loc="1TI 5:1">१ तीमुथियुस ५:१</ref>
      </char>
    </note>“बुजूर्ग आदमी को सामने उठ क खड़ो होनो, अऊर बुजूर्ग आदमी को आदर करो, अऊर अपनो परमेश्वर सी हमेशा डरो; मय परमेश्वर आय।<verse eid="LEV 19:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 19:33" />“यदि कोयी परदेशी तुम्हरो देश म तुम्हरो संग रहेंन, त ओको संग बुरो व्यवहार मत करो। <verse eid="LEV 19:33" /><verse number="34" style="v" sid="LEV 19:34" />जो परदेशी तुम्हरो संग रह्य हय ऊ तुम्हरो लायी स्वदेशी को जसो हो, अऊर ओको सी अपनो जसो प्रेम रखो; कहालीकि तुम भी मिस्र देश म परदेशी होतो; मय तुम्हरो परमेश्वर यहोवा आय।<verse eid="LEV 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 19:35" />“तुम न्याय म, अऊर पाप म, अऊर तौल म, अऊर नाप म अन्याय मत करो। <verse eid="LEV 19:35" /><verse number="36" style="v" sid="LEV 19:36" />अऊर सच्चो तराजू, न्याय को बट, सच्चो नाप, सच्चो लिटर तुम्हरो जवर ठीक ठीक रहे; मय तुम्हरो ऊ परमेश्वर यहोवा आय जो तुम ख मिस्र देश सी निकाल लायो हय। <verse eid="LEV 19:36" /><verse number="37" style="v" sid="LEV 19:37" />येकोलायी तुम मोरी सब विधियों अऊर सब नियमों ख मानतो हुयो हमेशा पालन करो; मय परमेश्वर आय।”<verse eid="LEV 19:37" /></para>
  <chapter eid="LEV 19" />
  <chapter number="20" style="c" sid="LEV 20" />
  <para style="s">आज्ञा उल्लंघन की सजा</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 20:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 20:1" /><verse number="2" style="v" sid="LEV 20:2" />“इस्राएलियों सी कहो कि इस्राएलियों म सी यां इस्राएलियों को बीच रहन वालो परदेशियों म सी, कोयी भी होना जो अपनी कोयी सन्तान मोलेक देवता ख बलिदान करेंन, ऊ जरूर मार डाल्यो जायेंन; अऊर ऊ देश को लोग ओको पर पथराव करेंन। <verse eid="LEV 20:2" /><verse number="3" style="v" sid="LEV 20:3" />मय भी ऊ आदमी को खिलाफ होय क ओख ओको लोगों म सी यो वजह नाश करूं कि ओन अपनी सन्तान मोलेक देवता ख दे क मोरो पवित्र जागा ख अशुद्ध करयो हय, अऊर मोरो पवित्र नाम ख अपवित्र ठहरायो हय। <verse eid="LEV 20:3" /><verse number="4" style="v" sid="LEV 20:4" />अऊर यदि कोयी अपनी सन्तान मोलेक देवता ख बलिदान करे, अऊर ऊ देश को लोग ओको बारे म अनदेखा करे अऊर ओख मार नहीं डालय, <verse eid="LEV 20:4" /><verse number="5" style="v" sid="LEV 20:5" />तब मय खुद ऊ आदमी अऊर ओको घराना को खिलाफ होय क ओख अऊर जितनो मोलेक देवता को पीछू होय क मोरो संग व्यभिचार करेंन उन सब ख भी उन्को लोगों को बीच म सी नाश करूं।<verse eid="LEV 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 20:6" />“फिर जो आदमी तंत्र-मंत्र यां भूत-प्रेत साधन वालो को तरफ फिर क, अऊर उन्को पीछू होय क व्यभिचारी बनेंन, त मय ऊ आदमी को खिलाफ होय क ओख ओको लोगों को बीच म सी नाश कर देऊं। <verse eid="LEV 20:6" /><verse number="7" style="v" sid="LEV 20:7" />येकोलायी तुम अपनो आप ख पवित्र करो; अऊर पवित्र बन्यो रहो; कहालीकि मय तुम्हरो परमेश्वर यहोवा आय। <verse eid="LEV 20:7" /><verse number="8" style="v" sid="LEV 20:8" />अऊर तुम मोरी विधियों ख मानो, अऊर उन्को पालन भी करो; कहालीकि मय तुम्ख पवित्र करन वालो परमेश्वर यहोवा आय।”<verse eid="LEV 20:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 20:9" />जो कोयी भी अपनो बाप यां माय ख श्राप देयेंन ओख जरूर मार डाल्यो जाये; ओन अपनो बाप यां माय ख श्राप दियो हय, ओको खून ओकोच मुंड पर पड़ेंन।<verse eid="LEV 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 20:10" />यदि आदमी परायी बाई को संग व्यभिचार करय हय, जेन कोयी दूसरो की पत्नी सी व्यभिचार करयो हय, त ऊ व्यभिचारी अऊर व्यभिचारिनी दोयी ख जरूर मार डाल्यो जाये। <verse eid="LEV 20:10" /><verse number="11" style="v" sid="LEV 20:11" />यदि कोयी अपनी सौतेली माय को संग सोवय हय, ऊ अपनो बाप कोच तन उघाड़न वालो ठहरेंन; येकोलायी हि दोयी ख जरूर मार डाल्यो जाये, उन दोयी को खून उन्कोच मुंड पर पड़ेंन। <verse eid="LEV 20:11" /><verse number="12" style="v" sid="LEV 20:12" />यदि कोयी आदमी अपनी बहू को संग सोवय, त हि दोयी ख जरूर मार डाल्यो जाये; कहालीकि उन्न गलत काम करयो हय, उन दोयी को खून उन्कोच मुंड पर पड़ेंन। <verse eid="LEV 20:12" /><verse number="13" style="v" sid="LEV 20:13" />यदि कोयी आदमी कोयी दूसरो आदमी को संग घिनौनो काम करय हय जसो कोयी बाई को संग, त उन्न घृणित काम करयो हय; यो वजह जरूर उन्ख मार डाल्यो जाये, उन्को खून उन्कोच मुंड पर पड़ेंन। <verse eid="LEV 20:13" /><verse number="14" style="v" sid="LEV 20:14" />यदि कोयी आदमी अपनी पत्नी अऊर सासु दोयी को संग बिहाव करय हय, त यो महापाप हय; येकोलायी ऊ आदमी ख अऊर दोयी बाई ख आगी म जलाय दियो जायेंन, जेको सी तुम्हरो बीच म महापाप नहीं रहे। <verse eid="LEV 20:14" /><verse number="15" style="v" sid="LEV 20:15" />फिर यदि कोयी आदमी पशु सी शारिरीक सम्बन्ध बनावय, त आदमी अऊर पशु दोयी ख जरूर मार डाल्यो जाये। <verse eid="LEV 20:15" /><verse number="16" style="v" sid="LEV 20:16" />यदि कोयी बाई जनावर को जवर जाय क ओको संग शारिरीक सम्बन्ध बनायेंन, त तय वा बाई अऊर जनावर दोयी ख मार डालजो; हि जरूर मार डाल्यो जाये, उन्को खून उन्कोच मुंड पर पड़ेंन।<verse eid="LEV 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 20:17" />“यदि कोयी आदमी अपनी बहिन चाहे सगी हो यां सौतेली, ओको संग बिहाव कर क् बिना कपड़ा की देखे, अऊर ओकी बहिन भी ओख बिना कपड़ा को देखे, त या लज्जा की बात आय, हि दोयी ख अपनो लोगों को बीच म सी नाश करयो जाये; कहालीकि जेन अपनी बहिन की लज्जा ख उघाड़्यो हय ओख अपनो पाप को बोझ खुद ख उठानो पड़ेंन।” <verse eid="LEV 20:17" /><verse number="18" style="v" sid="LEV 20:18" />फिर यदि कोयी आदमी कोयी मासिक धर्म बाई को संग सोय क ओकी लज्जा ख उघाड़य हय, त ऊ आदमी ओको मासिक धर्म को सोता ख उघाड़न वालो ठहरेंन, अऊर वा बाई अपनो मासिक धर्म को सोता ख उघाड़न वाली ठहरेंन; यो वजह हि दोयी ख अपनो लोगों को बीच म सी नाश करयो जाये।<verse eid="LEV 20:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 20:19" />अपनी मावसी यां फूफू की लज्जा नहीं उघाड़नो, कहालीकि जो ओख उघाड़ेंन ऊ अपनी जवर की कुटुम्बिनी ख नंगो करय हय; येकोलायी हि दोयी ख अपनो पाप को बोझ खुद ख उठानो पड़ेंन। <verse eid="LEV 20:19" /><verse number="20" style="v" sid="LEV 20:20" />यदि कोयी आदमी अपनी काकी को संग सोयेंन, त ऊ अपनो काका की लज्जा उघाड़य हय; येकोलायी हि दोयी अपनो पाप को बोझ ख उठातो हुयो बिन सन्तान को मर जायेंन। <verse eid="LEV 20:20" /><verse number="21" style="v" sid="LEV 20:21" />यदि कोयी अपनी भाभी को संग बिहाव करय हय, त यो घिनौनो काम आय; अऊर ऊ अपनो भाऊ की लज्जा उघाड़न वालो ठहरेंन, यो वजह हि दोयी बिना सन्तान को रह्य जायेंन।<verse eid="LEV 20:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 20:22" />“तुम मोरी सब विधियों अऊर सब नियमों को पालन करो; असो नहीं होय की ऊ देश जहां मय तुम्ख लिजाय रह्यो हय ऊ तुम्ख निकाल दे। <verse eid="LEV 20:22" /><verse number="23" style="v" sid="LEV 20:23" />अऊर जो राज्य को लोगों ख मय तुम्हरो आगु सी निकालू हय उन्की रीति-रिवाज पर मत चलो; कहालीकि उन लोगों न जो यो सब कुकर्म करयो हय यो वजह मोख उन सी घृना भय गयी हय। <verse eid="LEV 20:23" /><verse number="24" style="v" sid="LEV 20:24" />पर मय तुम लोगों सी कहू हय कि तुम उन्की जमीन को अधिकारी होय जावो, अऊर मय यो देश ख जेको म दूध अऊर शहेद की धारा बहय हय तुम्हरो अधिकार म कर देऊं; मय तुम्हरो परमेश्वर यहोवा आय जेन तुम ख दूसरों देश को लोगों सी अलग करयो हय। <verse eid="LEV 20:24" /><verse number="25" style="v" sid="LEV 20:25" />येकोलायी तुम शुद्ध अऊर अशुद्ध पशुवों म, शुद्ध अऊर अशुद्ध पक्षियों म भेद करो; मय न जो पशु, पक्षी यां जमीन पर रेंगन वालो जीवजन्तु ख तुम्हरो लायी अशुद्ध ठहरायो हय, ओको द्वारा अपनो आप ख अशुद्ध मत बनावो। <verse eid="LEV 20:25" /><verse number="26" style="v" sid="LEV 20:26" />तुम मोरो लायी पवित्र बन्यो रहो; कहालीकि मय परमेश्वर खुद पवित्र हय, अऊर मय न तुम ख अऊर संसार को लोगों सी येकोलायी अलग करयो हय कि तुम हमेशा मोरोच बन्यो रहो।<verse eid="LEV 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 20:27" />“यदि कोयी आदमी यां बाई सलाह देन वालो यां भूत-प्रेत की साधना करेंन, त ऊ जरूर मार डाल्यो जाये; असो पर पथराव करयो जाये, उन्को खून उन्कोच मुंड पर पड़ेंन।”<verse eid="LEV 20:27" /></para>
  <chapter eid="LEV 20" />
  <chapter number="21" style="c" sid="LEV 21" />
  <para style="s">याजकों की पवित्रता</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 21:1" />फिर परमेश्वर न मूसा सी कह्यो, “हारून को टुरा जो याजक हय उन्को सी कहजो कि तुम्हरो लोगों म सी कोयी भी मरेंन, त ओको वजह तुम म सी कोयी अपनो ख अशुद्ध नहीं करे; <verse eid="LEV 21:1" /><verse number="2" style="v" sid="LEV 21:2" />अपनो जवर को कुटुम्बियों, मतलब माय, बाप, टुरा, टुरी, यां भाऊ को लायी, <verse eid="LEV 21:2" /><verse number="3" style="v" sid="LEV 21:3" />या अपनी कुंवारी बहिन जेको बिहाव नहीं भयो होना, जिन्को जवर को सम्बन्ध हय; जेको कोयी पति नहाय उन्को लायी अपनो ख अशुद्ध कर सकय हय। <verse eid="LEV 21:3" /><verse number="4" style="v" sid="LEV 21:4" />पर याजक होन को वजह अपनो लोगों म मुखिया हय, येकोलायी ऊ अपनो आप ख असो अशुद्ध नहीं करे कि अपवित्र होय जाय।<verse eid="LEV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 21:5" />“याजक अपनो मुंड को बाल नहीं मुंडाये, अऊर नहीं अपनी दाढ़ी मुंडाये, अऊर नहीं अपनो शरीर पर चिरा लगवाये। <verse eid="LEV 21:5" /><verse number="6" style="v" sid="LEV 21:6" />हि अपनो परमेश्वर लायी पवित्र बन्यो रहे, अऊर अपनो परमेश्वर को नाम अपवित्र नहीं करे; कहालीकि हि प्रभु की भेंट ख जो उन्को परमेश्वर को भोजन आय, चढ़ायो करय हय; यो वजह हि पवित्र बन्यो रहेंन। <verse eid="LEV 21:6" /><verse number="7" style="v" sid="LEV 21:7" />हि वेश्या यां भ्रष्ट बाई सी बिहाव नहीं करे, अऊर नहीं छोड़ी हुयी बाई सी बिहाव करे; कहालीकि याजक अपनो परमेश्वर लायी पवित्र होवय हय। <verse eid="LEV 21:7" /><verse number="8" style="v" sid="LEV 21:8" />येकोलायी तय याजक ख पवित्र मानो, कहालीकि ऊ तुम्हरो परमेश्वर को भोजन चढ़ायो करय हय; येकोलायी ऊ तोरी नजर म पवित्र ठहरे; कहालीकि मय यहोवा, जो तुम्ख पवित्र करू हय, मय पवित्र हय। <verse eid="LEV 21:8" /><verse number="9" style="v" sid="LEV 21:9" /><note caller="+" style="x"><char style="xo" closed="false">21:9 </char><char style="xt" closed="false"><ref loc="REV 17:16">प्रकाशितवाक्य 17:16</ref></char></note>अऊर याजक की टुरी वेश्या बन क अपनो आप ख अपवित्र करेंन, त वा अपनो बाप ख अपवित्र ठहरावय हय; ओख आगी म जलायो जाय।<verse eid="LEV 21:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 21:10" />“जो अपनो भाऊवों म महायाजक होना, जेको मुंड पर अभिषेक को तेल डाल्यो गयो होना, अऊर जेको पवित्र कपड़ा पहिनन लायी संस्कार करयो गयो होना ऊ अपनो मुंड को बाल बिखरन नहीं देयेंन, अऊर नहीं अपनो कपड़ा फाड़े; <verse eid="LEV 21:10" /><verse number="11" style="v" sid="LEV 21:11" />अऊर नहीं कोयी लाश को जवर जाय, अऊर नहीं अपनो बाप यां माय को वजह अपनो ख अशुद्ध करे; <verse eid="LEV 21:11" /><verse number="12" style="v" sid="LEV 21:12" />अऊर ऊ पवित्र जागा सी बाहेर नहीं जाये, अऊर नहीं अपनो परमेश्वर को पवित्र जागा ख अपवित्र ठहराये; कहालीकि ओको पर अपनो परमेश्वर को अभिषेक को तेल डाल्यो गयो हय; मय परमेश्वर आय। <verse eid="LEV 21:12" /><verse number="13" style="v" sid="LEV 21:13" />अऊर ऊ कुंवारी बाई सीच बिहाव करे। <verse eid="LEV 21:13" /><verse number="14" style="v" sid="LEV 21:14" />जो विधवा, यां छोड़ी हुयी, यां भ्रष्ट, यां वेश्या होना, असी बाई सी ऊ बिहाव नहीं करे, ऊ अपनोच लोगों को बीच म की कोयी कुंवारी टुरी सी बिहाव करे। <verse eid="LEV 21:14" /><verse number="15" style="v" sid="LEV 21:15" />अऊर ऊ अपनी सन्तान ख अपनो लोगों म अपवित्र नहीं करे; कहालीकि मय ओको पवित्र करन वालो परमेश्वर आय।”<verse eid="LEV 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 21:16" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 21:16" /><verse number="17" style="v" sid="LEV 21:17" />“हारून सी यो कहजो तोरो वंश म पीढ़ी सी पीढ़ी तक यदि कोयी म कोयी शारीरिक दोष होना, त ऊ अपनो परमेश्वर को भोजन चढ़ावन लायी जवर नहीं आयेंन। <verse eid="LEV 21:17" /><verse number="18" style="v" sid="LEV 21:18" />कोयी आदमी जेको म शारीरिक दोष होना ऊ जवर नहीं आये, चाहे ऊ अन्धा होना, चाहे लंगड़ा, चाहे चपटी नाक वालो होना, चाहे ओख कुछ जादा अंग होना, <verse eid="LEV 21:18" /><verse number="19" style="v" sid="LEV 21:19" />यां ओको पाय, यां हाथ विकलांग होना, <verse eid="LEV 21:19" /><verse number="20" style="v" sid="LEV 21:20" />यां कुबड़ो, यां ठिंगनो होना, यां ऊ आदमी ख खुजली होना, यां ऊ नपुसक होना; <verse eid="LEV 21:20" /><verse number="21" style="v" sid="LEV 21:21" />हारून याजक को वंश म सी जेको म शारीरिक दोष हय ऊ प्रभु लायी होमबलि चढ़ावन लायी जवर नहीं आये; जो दोषयुक्त हय ऊ कभी भी अपनो परमेश्वर को भोजन चढ़ावन लायी जवर नहीं आये। <verse eid="LEV 21:21" /><verse number="22" style="v" sid="LEV 21:22" />ऊ अपनो परमेश्वर को पवित्र अऊर परमपवित्र दोयी तरह को भोजन खाये, <verse eid="LEV 21:22" /><verse number="23" style="v" sid="LEV 21:23" />पर ओको दोष को वजह ऊ नहीं बीचवालो परदा को अन्दर आये अऊर नहीं वेदी को जवर, जेकोसी असो नहीं होय कि ऊ मोरो पवित्र जागा ख अपवित्र करे; कहालीकि मय उन्को पवित्र करन वालो परमेश्वर आय।”<verse eid="LEV 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 21:24" />येकोलायी मूसा न हारून अऊर ओको टुरावों ख अऊर सब इस्राएलियों ख या बाते कहीं।<verse eid="LEV 21:24" /></para>
  <chapter eid="LEV 21" />
  <chapter number="22" style="c" sid="LEV 22" />
  <para style="s">भेंट की पवित्रता</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 22:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 22:1" /><verse number="2" style="v" sid="LEV 22:2" />“हारून अऊर ओको टुरावों ख कहो की इस्राएलियों की पवित्र करी हुयी चिजों सी जिन्ख हि मोरो लायी चढ़ावय हय अलग रहे, अऊर मोरो पवित्र नाम ख अपवित्र नहीं करे; मय परमेश्वर आय। <verse eid="LEV 22:2" /><verse number="3" style="v" sid="LEV 22:3" />अऊर उन्को सी कहो की तुम्हरी पूरी पीढ़ी म तुम्हरो पूरो वंश म सी जो कोयी अपनी अशुद्ध दशा म उन पवित्र चिजों को जवर जाये, जिन्ख इस्राएली लोग मोख चढ़ावय हय, त ऊ व्यक्ति ख मोरो सामने सी नाश करयो जायेंन; मय परमेश्वर आय।<verse eid="LEV 22:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 22:4" />“हारून को वंश को कोयी आदमी जो कोढ़ को रोग सी तकलीफ म हय, यां धात सी तकलीफ हय, ऊ आदमी जब तक शुद्ध नहीं होय जाये तब तक पवित्र करी हुयी चिजों म सी कुछ नहीं खाये। जो लाश को वजह अशुद्ध भयो होना, यां जेको वीर्यपात भयो होना, असो आदमी ख जो कोयी छुयेंन, <verse eid="LEV 22:4" /><verse number="5" style="v" sid="LEV 22:5" />अऊर जो कोयी असो रेंगन वालो जीव-जन्तु ख छुयेंन जेकोसी लोग अशुद्ध होय सकय हय, यां कोयी असो आदमी ख छुयेंन जेको म कोयी तरह की अशुद्धता होना जो ओख भी लग सकय हय। <verse eid="LEV 22:5" /><verse number="6" style="v" sid="LEV 22:6" />त ऊ व्यक्ति जो इन म सी कोयी ख छुयेंन त शाम तक अशुद्ध रहेंन, अऊर जब तक पानी सी नहाय नहीं लेवय तब तक पवित्र चिजों म सी कुछ नहीं खाये। <verse eid="LEV 22:6" /><verse number="7" style="v" sid="LEV 22:7" />तब ऊ सूरज डुबन को बाद शुद्ध ठहरेंन; अऊर तब ऊ पवित्र चिजों म सी खाय सकेंन, कहालीकि ओको भोजन उच आय। <verse eid="LEV 22:7" /><verse number="8" style="v" sid="LEV 22:8" />जो जनावर अपनो सी मरयो होना यां कोयी हिंसक जनावर सी फाड़्यो गयो होना ओख खाय क ऊ अपनो आप ख अशुद्ध नहीं करे; मय परमेश्वर आय।<verse eid="LEV 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 22:9" />“येकोलायी याजक लोग मोरो नियमों को पालन करे, असो नहीं होय कि हि उन्ख अपवित्र कर क् पाप को बोझ खुद उठाये, अऊर मर भी जाये; मय उन्को पवित्र करन वालो परमेश्वर आय।<verse eid="LEV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 22:10" />“परायो कुल को व्यक्ति कोयी भी पवित्र चिज ख नहीं खानो चाहिये, चाहे ऊ याजक को परदेशी होना यां मजूर होना, तब भी ऊ कोयी पवित्र चिज ख नहीं खाये।” <verse eid="LEV 22:10" /><verse number="11" style="v" sid="LEV 22:11" />यदि याजक कोयी व्यक्ति ख रुपया दे क खरीद लेवय, त ऊ व्यक्ति ओको म सी खाय सकय हय; अऊर जेको जनम याजक को घर म भयो होना हि भी ओको भोजन म सी खाय सकय हय। <verse eid="LEV 22:11" /><verse number="12" style="v" sid="LEV 22:12" />यदि याजक की टुरी परायो कुल को कोयी आदमी सी बिहाव भयो होना, त वा भेंट करी हुयी पवित्र चिजों म सी नहीं खाये। <verse eid="LEV 22:12" /><verse number="13" style="v" sid="LEV 22:13" />यदि याजक की टुरी विधवा या छोड़चिट्ठी भयो होना, अऊर वा जवानी म बिना सन्तान की अपनो बाप को घर आय जाये, त वा अपनो बाप को घर को भोजन म सी खाय सकय हय; पर परायो कुल को कोयी भी ओको म सी नहीं खाये।<verse eid="LEV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 22:14" />“अऊर यदि कोयी आदमी कोयी पवित्र चिज म सी भूल सी खाय जाये, त ऊ ओको पाचवों हिस्सा ओको म बढ़ाय क पवित्र चिज याजक ख दे। <verse eid="LEV 22:14" /><verse number="15" style="v" sid="LEV 22:15" />हि इस्राएलियों की पवित्र करी हुयी चिजों ख, जिन्ख हि परमेश्वर लायी चढ़ायो करय हय, उन्ख अपवित्र नहीं करे। <verse eid="LEV 22:15" /><verse number="16" style="v" sid="LEV 22:16" />हि इस्राएली लोगों की पवित्र चिजों म सी खिलाय क उन्को सी अपराध को दोष नहीं उठवाये; मय उन्को पवित्र करन वालो परमेश्वर आय।”<verse eid="LEV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 22:17" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 22:17" /><verse number="18" style="v" sid="LEV 22:18" />हारून अऊर ओको टुरावों सी अऊर इस्राएलियों सी यो कहो कि इस्राएल को घराना यां इस्राएलियों म रहन वालो परदेशियों म सी कोयी व्यक्ति मन्नत यां खुद की इच्छा सी बलि करन लायी परमेश्वर ख होमबलि चढ़ाये, <verse eid="LEV 22:18" /><verse number="19" style="v" sid="LEV 22:19" />त अपनो स्विकार करन लायक ठहरन लायी पालतु जनावर यां मेंढा यां शेरियों म सी पूर्ण स्वस्थ नर चढ़ायो जाये। <verse eid="LEV 22:19" /><verse number="20" style="v" sid="LEV 22:20" />जिन पशुवों म शारीरिक दोष होना ओख मत चढ़ावो; कहालीकि ऊ तुम्हरो लायी स्विकारयो नहीं जायेंन। <verse eid="LEV 22:20" /><verse number="21" style="v" sid="LEV 22:21" />अऊर जो कोयी पालतु जनावर यां मेंढा यां शेरियों म सी खास चिज मन्नत करन लायी यां खुद की इच्छा सी परमेश्वर ख मेल-मिलाप बलि चढ़ाये, त स्विकार होन लायी जरूरी हय कि ऊ पूर्ण स्वस्थ होना, ओको म कोयी भी दोष नहीं होना। <verse eid="LEV 22:21" /><verse number="22" style="v" sid="LEV 22:22" />जो अन्धो यां टूट्यो अंग वालो यां लुलो होना, यां ओको म फोड़ा-फुन्सी यां खुजली होना, असो ख परमेश्वर को लायी मत चढ़ावो, उन्ख परमेश्वर को लायी वेदी पर हवन लायी मत चढ़ावो। <verse eid="LEV 22:22" /><verse number="23" style="v" sid="LEV 22:23" />जो कोयी पालतु जनावर यां मेंढा यां बकरा को कोयी अंग बड़ो या छोटो होना ओख खुद की इच्छा सी बलि लायी चढ़ाय सकय हय, पर मन्नत पूरी करन लायी ओख स्विकार नहीं करयो जायेंन। <verse eid="LEV 22:23" /><verse number="24" style="v" sid="LEV 22:24" />जो जनावर को अण्डकोष दब्यो, कुचल्यो, टूट्यो यां कट गयो होना ओख परमेश्वर ख बलि लायी मत चढ़ावो, अऊर अपनो देश म भी असो काम मत करो।<verse eid="LEV 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 22:25" />विदेशी व्यक्ति सी ले क असो कोयी जनावर अपनो परमेश्वर को भोजन को रूप म मत चढ़ावो, ओको शरीर पर दोष हय, अऊर विकृत हय, येकोलायी हि तुम्हरो लायी स्विकारयो नहीं जायेंन।<verse eid="LEV 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 22:26" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 22:26" /><verse number="27" style="v" sid="LEV 22:27" />“जब गोरा यां मेंढा या शेरी को बच्चा पैदा होयेंन, त ऊ सात दिन तक अपनी माय को संग रहेंन; फिर आठवों दिन को बाद ऊ परमेश्वर को भेंट लायी स्विकारन लायक ठहरेंन। <verse eid="LEV 22:27" /><verse number="28" style="v" sid="LEV 22:28" />चाहे पालतु जनावर, चाहे मेंढी यां शेरी होना, ओख अऊर ओको बच्चा ख एकच दिन बलि मत करो। <verse eid="LEV 22:28" /><verse number="29" style="v" sid="LEV 22:29" />अऊर जब तुम परमेश्वर लायी धन्यवाद को मेल-मिलाप बलि चढ़ावो, त ओख योच रीति सी करो जेकोसी ऊ स्विकार लायक ठहरेंन। <verse eid="LEV 22:29" /><verse number="30" style="v" sid="LEV 22:30" />ऊ उच दिन खायो जाय, ओको म सी कुछ भी सबेरे तक नहीं रहनो चाहिये; मय परमेश्वर आय।<verse eid="LEV 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="LEV 22:31" />“येकोलायी तुम मोरी आज्ञावों ख मानो अऊर ओको पालन करो; मय परमेश्वर आय।” <verse eid="LEV 22:31" /><verse number="32" style="v" sid="LEV 22:32" />अऊर मोरो पवित्र नाम ख अपवित्र मत करो, कहालीकि मय इस्राएलियों को बीच म जरूरच पवित्र मान्यो जाऊं; मय तुम्हरो पवित्र करन वालो परमेश्वर आय, <verse eid="LEV 22:32" /><verse number="33" style="v" sid="LEV 22:33" />जो तुम्ख मिस्र देश सी निकाल लायो, जेकोसी तुम्हरो परमेश्वर बन्यो रहूं; मय परमेश्वर आय।<verse eid="LEV 22:33" /></para>
  <chapter eid="LEV 22" />
  <chapter number="23" style="c" sid="LEV 23" />
  <para style="s">त्यौहारों की विधियां</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 23:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 23:1" /><verse number="2" style="v" sid="LEV 23:2" />इस्राएलियों सी कहो कि परमेश्वर को त्यौहार तुम पवित्र सभा ख एकजुट करन लायी ठहरायो समय पर प्रचार करनो पड़ेंन, हि मोरो त्यौहार यो आय। <verse eid="LEV 23:2" /><verse number="3" style="v" sid="LEV 23:3" />छय दिन काम-काज करयो जायेंन, पर सातवों दिन परमविश्राम को अऊर पवित्र सभा को दिन आय; ओको म कोयी तरह को काम-काज नहीं करयो जायेंन; ऊ तुम्हरो घरों म परमेश्वर को आराम दिन ठहरेंन।<verse eid="LEV 23:3" /></para>
  <para style="s">फसह अऊर अखमीरी रोटी को त्यौहार</para>
  <para style="r">(<ref loc="NUM 28:16-25">गिनती २८:१६-२५</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="LEV 23:4" />“फिर परमेश्वर को त्यौहार जेको म सी एक एक को ठहरायो हुयो समय म तुम्ख पवित्र सभा करन लायी प्रचार करनो पड़ेंन हि यो आय। <verse eid="LEV 23:4" /><verse number="5" style="v" sid="LEV 23:5" />पहिलो महिना को चौदावों दिन शाम को समय परमेश्वर को फसह को त्यौहार मनायो जाय। <verse eid="LEV 23:5" /><verse number="6" style="v" sid="LEV 23:6" />अऊर उच महिना को पन्द्रावों दिन ख परमेश्वर को लायी अखमीरी रोटी को त्यौहार मनायो जाय; ओको म तुम सात दिन तक अखमीरी रोटी खायो करो। <verse eid="LEV 23:6" /><verse number="7" style="v" sid="LEV 23:7" />ओको म पहिलो दिन तुम्हरी पवित्र सभा होयेंन; अऊर ऊ दिन मेहनत को कोयी काम मत करो। <verse eid="LEV 23:7" /><verse number="8" style="v" sid="LEV 23:8" />पर सात दिन तक तुम परमेश्वर ख अग्निबलि चढ़ायो करो; अऊर सातवों दिन पवित्र सभा होयेंन; ऊ दिन कोयी मेहनत को काम मत करो।”<verse eid="LEV 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 23:9" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 23:9" /><verse number="10" style="v" sid="LEV 23:10" />“इस्राएलियों सी कहो कि जब तुम ऊ देश म सिरो जेक परमेश्वर तुम्ख देवय हय अऊर ओको म की फसल काटो, तब अपनो अपनो पक्यो खेत की पहली फसल की एक पेंढी याजक को जवर लायो करो; <verse eid="LEV 23:10" /><verse number="11" style="v" sid="LEV 23:11" />अऊर याजक ऊ पेंढी ख परमेश्वर को सामने हिलायेंन, कि ऊ तुम्हरो लायी स्विकारयो जायेंन; ऊ ओख आराम दिन को दूसरों दिन हिलायेंन। <verse eid="LEV 23:11" /><verse number="12" style="v" sid="LEV 23:12" />अऊर जो दिन तुम पेंढी हिलावो उच दिन एक साल को निर्दोष मेंढी को बच्चा परमेश्वर लायी होमबलि चढ़ावो। <verse eid="LEV 23:12" /><verse number="13" style="v" sid="LEV 23:13" />अऊर ओको संग अनाज भेंट एपा को दसवों अंश जैतून को तेल सी सान्यो हुयो मैदा होय, सुखदायक सुगन्ध लायी परमेश्वर को हवन को रूप म चढ़ायो जाय; अऊर ओको संग पेयबलि लायी दोय लिटर अंगूरीरस भी चढ़ायो जाय। <verse eid="LEV 23:13" /><verse number="14" style="v" sid="LEV 23:14" />जब तक तुम नयी फसल को चढ़ावा अपनो परमेश्वर को जवर नहीं लावो, तब तक नयी फसल की रोटी यां भूज्यो दाना यां कच्चो दाना मत खावो; यो तुम्हरी पीढ़ी सी पीढ़ी म तुम्हरो घराना म हमेशा की विधि ठहरेंन।<verse eid="LEV 23:14" /></para>
  <para style="s">कटनी को त्यौहार</para>
  <para style="r">(<ref loc="NUM 28:26-31">गिनती २८:२६-३१</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="LEV 23:15" />“फिर ऊ आराम दिन को दूसरो दिन सी, मतलब जो दिन सी तुम हिलायी जान वाली भेंट की पेंढी ख लावो, ऊ दिन सी पूरो सात आराम दिन गिन लेवो; <verse eid="LEV 23:15" /><verse number="16" style="v" sid="LEV 23:16" />सातवों आराम दिन को दूसरो दिन को बाद सी पचास दिन गिनो, अऊर पचासवों दिन परमेश्वर लायी नयो अन्नबलि चढ़ावो। <verse eid="LEV 23:16" /><verse number="17" style="v" sid="LEV 23:17" />तुम अपनो घरों सी हिलावन की भेंट बलि को रूप म चढ़ावन लायी दोय किलो मैदा की दोय रोटियां लावो; जो परमेश्वर ख पहली फसल को रूप म चढ़ावन लायी खमीर को संग पकायी जाय। <verse eid="LEV 23:17" /><verse number="18" style="v" sid="LEV 23:18" />अऊर वा रोटी को संग एक एक साल को सात पूर्ण स्वस्थ मेंढी को बच्चा, अऊर एक बछड़ा अऊर दोय मेढ़े चढ़ावो; हि अपनो अपनो अनाज भेंट अऊर पेयबलि समेत परमेश्वर लायी अग्निबलि को जसो चढ़ायो जाये, मतलब हि परमेश्वर लायी सुखदायक सुगन्ध देन वालो हवन ठहरे। <verse eid="LEV 23:18" /><verse number="19" style="v" sid="LEV 23:19" />फिर पापबलि लायी एक बकरा, अऊर मेल-मिलाप बलि लायी एक एक साल को दोय मेंढी को बच्चा चढ़ावो। <verse eid="LEV 23:19" /><verse number="20" style="v" sid="LEV 23:20" />तब याजक उन्ख पहली फसल की रोटी समेत परमेश्वर को सामने हिलावन की भेंट लायी हिलाये, अऊर इन रोटियों को संग हि दोयी मेंढी को बच्चा भी हिलायो जाये; हि परमेश्वर लायी पवित्र, अऊर याजक को भाग ठहरेंन। <verse eid="LEV 23:20" /><verse number="21" style="v" sid="LEV 23:21" />अऊर उच दिन यो प्रचार करो कि अज हमरी एक पवित्र सभा होयेंन; अऊर मेहनत को कोयी काम मत करो; यो तुम्हरो पूरो घराना म तुम्हरी पीढ़ी पीढ़ी म हमेशा की विधि ठहरेंन।<verse eid="LEV 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 23:22" />“जब तुम अपनी जमीन की फसल काटो तब खेतों ख पूरो को पूरो मत काटो, अऊर नहीं फसल की कटायी को बाद गिरी हुयी लोम्बा जमा करो; ओख गरीब अऊर परदेशियों लायी छोड़ देवो; मय तुम्हरो परमेश्वर यहोवा आय।”<verse eid="LEV 23:22" /></para>
  <para style="s">नयो साल को त्यौहार</para>
  <para style="r">(<ref loc="NUM 29:1-6">गिनती २९:१-६</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 23:23" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 23:23" /><verse number="24" style="v" sid="LEV 23:24" />“इस्राएलियों सी कहो कि सातवों महिना को पहिलो दिन ख तुम्हरो लायी खास आराम को होना; ओको म याद दिलावन लायी नरसिंगा फूक्यो जाय, अऊर एक पवित्र सभा जमा हो। <verse eid="LEV 23:24" /><verse number="25" style="v" sid="LEV 23:25" />ऊ दिन तुम मेहनत को कोयी काम मत करो, अऊर परमेश्वर लायी एक अग्निबलि चढ़ावो।”<verse eid="LEV 23:25" /></para>
  <para style="s">प्रायश्चित को दिन</para>
  <para style="r">(<ref loc="NUM 29:7-11">गिनती २९:७-११</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 23:26" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 23:26" /><verse number="27" style="v" sid="LEV 23:27" />उच सातवों महिना को दसवों दिन पश्चाताप को दिन मान्यो जाये; ऊ तुम्हरो पवित्र सभा को दिन होयेंन, अऊर ओको म तुम उपवास करो अऊर परमेश्वर लायी अग्निबलि चढ़ावो। <verse eid="LEV 23:27" /><verse number="28" style="v" sid="LEV 23:28" />ऊ दिन तुम कोयी तरह को काम-काज मत करो; कहालीकि ऊ पश्चाताप को दिन चुन्यो गयो हय जेको म तुम्हरो परमेश्वर यहोवा को सामने तुम्हरो लायी पश्चाताप करयो जायेंन। <verse eid="LEV 23:28" /><verse number="29" style="v" sid="LEV 23:29" />येकोलायी जो आदमी ऊ दिन खुद दु:ख नहीं सहेंन ऊ अपनो लोगों म सी नाश करयो जायेंन। <verse eid="LEV 23:29" /><verse number="30" style="v" sid="LEV 23:30" />अऊर जो आदमी ऊ दिन कोयी तरह को काम-काज करेंन ऊ आदमी ख मय ओको लोगों को बीच म सी नाश कर डालूं। <verse eid="LEV 23:30" /><verse number="31" style="v" sid="LEV 23:31" />तुम कोयी तरह को काम-काज मत करो; यो तुम्हरी पीढ़ी पीढ़ी म तुम्हरो घराना म हमेशा की विधि होयेंन। <verse eid="LEV 23:31" /><verse number="32" style="v" sid="LEV 23:32" />ऊ दिन तुम्हरो लायी परमविश्राम को होयेंन, ओको म तुम खुद दु:ख देवो; अऊर ऊ महिना को नववों दिन की शाम सी ले क दूसरो दिन की शाम तक अपनो खास आराम दिन मान्यो करो।<verse eid="LEV 23:32" /></para>
  <para style="s">खोपड़ियों को त्यौहार</para>
  <para style="r">(<ref loc="NUM 29:12-40">गिनती २९:१२-४०</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="LEV 23:33" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 23:33" /><verse number="34" style="v" sid="LEV 23:34" />“इस्राएलियों सी कहो कि उच सातवों महिना को पन्द्रावों दिन सी सात दिन तक परमेश्वर लायी खोपड़ियों को त्यौहार मनायो जाये। <verse eid="LEV 23:34" /><verse number="35" style="v" sid="LEV 23:35" />पहिलो दिन पवित्र सभा होयेंन; ओको म मेहनत को कोयी काम मत करो।<verse eid="LEV 23:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LEV 23:36" />“सातवों दिन परमेश्वर लायी अग्निबलि चढ़ायो करो, फिर आठवों दिन तुम्हरी पवित्र सभा होयेंन, अऊर परमेश्वर लायी हवन चढ़ावो; ऊ महासभा को दिन आय, अऊर ओको म मेहनत को कोयी काम मत करो। <verse eid="LEV 23:36" /><verse number="37" style="v" sid="LEV 23:37" />परमेश्वर को ठहरायो त्यौहार योच आय, इन म तुम परमेश्वर ख बलिदान चढ़ावो, मतलब अग्निबलि, अन्नबलि, मेल-मिलाप बलि अऊर अंगूरीरस, हर एक अपनो अपनो नियुक्त समय पर चढ़ायो जाय अऊर पवित्र सभा को प्रचार करो। <verse eid="LEV 23:37" /><verse number="38" style="v" sid="LEV 23:38" />इन सब सी जादा परमेश्वर को आराम दिनों ख मानो, अऊर अपनी भेंटों, अऊर मन्नतों, अऊर खुद की इच्छा सी बलियों ख परमेश्वर ख चढ़ायो करो।<verse eid="LEV 23:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 23:39" />“फिर सातवों महिना को पन्द्रावों दिन ख, जब तुम जमीन की फसल ख जमा कर लेवो, तब सात दिन तक परमेश्वर को त्यौहार मनावो; पहिलो अऊर आठवों दिन खास आराम को दिन होयेंन। <verse eid="LEV 23:39" /><verse number="40" style="v" sid="LEV 23:40" />अऊर पहिलो दिन तुम अच्छो अच्छो झाड़ को फर, अऊर खजूर को डगालियां, अऊर घनो झाड़ो की डगालियां, अऊर नदी को किनार को मजनूं झाड़ की डगाली ले क अपनो परमेश्वर यहोवा को सामने सात दिन तक खुशी मनावो। <verse eid="LEV 23:40" /><verse number="41" style="v" sid="LEV 23:41" />हर साल सात दिन तक परमेश्वर लायी यो त्यौहार मनावो; यो तुम्हरी पीढ़ी सी पीढ़ी म हमेशा की विधि ठहरेंन कि सातवों महिना म यो त्यौहार मनायो जाय। <verse eid="LEV 23:41" /><verse number="42" style="v" sid="LEV 23:42" />सात दिन तक तुम खोपड़ियों म रह्यो करो, मतलब जितनो जनम सी इस्राएली हय हि सब को सब खोपड़ियों म रहेंन, <verse eid="LEV 23:42" /><verse number="43" style="v" sid="LEV 23:43" />येकोलायी कि तुम्हरी पीढ़ी सी पीढ़ी को लोगों ख एहसास होय जाये, कि परमेश्वर न हम इस्राएलियों ख मिस्र देश सी निकाल लायो होतो; तब हम्ख खोपड़ियों म निवास करायो होतो; मय तुम्हरो परमेश्वर यहोवा आय।”<verse eid="LEV 23:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="LEV 23:44" />अऊर मूसा न इस्राएलियों ख परमेश्वर को त्यौहार को ठहरायो समय बतायो।<verse eid="LEV 23:44" /></para>
  <chapter eid="LEV 23" />
  <chapter number="24" style="c" sid="LEV 24" />
  <para style="s">पवित्र दीयावों ख सजानो</para>
  <para style="r">(<ref loc="EXO 27:20">निर्गमन 27:20</ref>,<ref loc="EXO 27:21">21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 24:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 24:1" /><verse number="2" style="v" sid="LEV 24:2" />“इस्राएलियों ख या आज्ञा देवो कि मोरो जवर उजाड़ो देन लायी कुट क निकाल्यो हुयो जैतून को शुद्ध तेल लावो कि एक दीया हमेशा जलतो रहे। <verse eid="LEV 24:2" /><verse number="3" style="v" sid="LEV 24:3" />हारून ओख, मिलापवालो तम्बू म, वाचा को सन्दूक को बीच वालो परदा को बाहेर, शाम सी ले क सबेरे तक परमेश्वर को सामने सजाय क रखे; यो तुम्हरी पीढ़ी सी पीढ़ी लायी हमेशा की विधि ठहरेंन। <verse eid="LEV 24:3" /><verse number="4" style="v" sid="LEV 24:4" />हारून ऊ दीयावों ख शुद्ध सोनो को दीवट पर परमेश्वर को सामने हमेशा सजायो करे।<verse eid="LEV 24:4" /></para>
  <para style="s">भेंट की रोटियां</para>
  <para style="p">
    <verse number="5" style="v" sid="LEV 24:5" />“तय मैदा ले क बारा रोटियां बनावो, हर एक रोटी दोय किलो मैदा की बनायी जाय। <verse eid="LEV 24:5" /><verse number="6" style="v" sid="LEV 24:6" />तब उन्की दोय पंगत कर क्, एक एक पंगत म छय छय रोटियां, शुद्ध सोनो को मेज पर परमेश्वर को सामने रखो। <verse eid="LEV 24:6" /><verse number="7" style="v" sid="LEV 24:7" />अऊर एक एक पंगत पर शुद्ध लुभान रखो कि वा रोटी याद दिलावन वाली चिज अऊर परमेश्वर लायी भेंट हो। <verse eid="LEV 24:7" /><verse number="8" style="v" sid="LEV 24:8" />हर आराम दिन ख ऊ ओख हमेशा परमेश्वर को सामने एक को बाद एक रख्यो जाये, या हमेशा वाचा की रीति इस्राएलियों को तरफ सी होयेंन। <verse eid="LEV 24:8" /><verse number="9" style="v" sid="LEV 24:9" />अऊर हि रोटियां हारून अऊर ओको टुरावों की होयेंन, अऊर हि ओख कोयी पवित्र जागा म खायेंन, कहालीकि वा परमेश्वर को भेंटों म सी हमेशा की विधि को अनुसार हारून लायी परमपवित्र हिस्सा ठहरी हय।”<verse eid="LEV 24:9" /></para>
  <para style="s">परमेश्वर की निन्दा की सजा</para>
  <para style="p">
    <verse number="10" style="v" sid="LEV 24:10" />उन दिनों म इस्राएली बाई को टुरा, जेको बाप मिस्री होतो, अऊर ऊ टुरा इस्राएलियों को बीच म चली गयो; अऊर ऊ इस्राएली बाई को टुरा अऊर एक इस्राएली आदमी छावनी को बीच म आपस म झगड़न लग्यो, <verse eid="LEV 24:10" /><verse number="11" style="v" sid="LEV 24:11" />अऊर वा इस्राएली बाई को टुरा परमेश्वर को नाम की निन्दा कर क् श्राप देन लग्यो। यो सुन क ओख मूसा को जवर ले गयो। ओकी माय को नाम शलोमीत होतो, जो दान वंशीय दिब्री की टुरी होती। <verse eid="LEV 24:11" /><verse number="12" style="v" sid="LEV 24:12" />उन्न ओख देखभाल म रख्यो, जेकोसी परमेश्वर को मन उन पर प्रगट होय सके ।<verse eid="LEV 24:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 24:13" />तब परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 24:13" /><verse number="14" style="v" sid="LEV 24:14" />तुम लोग ऊ श्राप देन वालो ख छावनी सी बाहेर लि जावो; अऊर जितनो लोगों न वा निन्दा सुनी होना हि सब अपनो अपनो हाथ ओको मुंड पर रखे, तब पूरी मण्डली को लोग ओको पर पथराव करेंन। <verse eid="LEV 24:14" /><verse number="15" style="v" sid="LEV 24:15" />अऊर तय इस्राएलियों सी कहजो कि कोयी भी व्यक्ति अपनो परमेश्वर ख श्राप देयेंन ओख अपनो पाप को बोझ उठानो पड़ेंन। <verse eid="LEV 24:15" /><verse number="16" style="v" sid="LEV 24:16" />परमेश्वर को नाम की निन्दा करन वालो निश्चितच मार डाल्यो जाय; पूरी मण्डली को लोग निश्चित ओको पर पथराव करे; चाहे देशी होना यां परदेशी होना, यदि कोयी परमेश्वर को नाम की निन्दा करेंन त ऊ मार डाल्यो जायेंन।<verse eid="LEV 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="LEV 24:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">24:17 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:21">मत्ती 5:21</ref>
      </char>
    </note>“फिर कोयी आदमी कोयी व्यक्ति ख जान सी मार डालेंन त ओख निश्चित मार डाल्यो जायेंन। <verse eid="LEV 24:17" /><verse number="18" style="v" sid="LEV 24:18" />यदि कोयी व्यक्ति कोयी जनावर ख जान सी मार दे त ऊ येको नुकसान की भरपाई कर दे, जनावर को बदला जनावर दे।<verse eid="LEV 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="LEV 24:19" />“फिर यदि कोयी दूसरो ख घाव पहुंचायो हय, त जसो ओन करयो हय वसोच ओको संग भी करयो जाय, <verse eid="LEV 24:19" /><verse number="20" style="v" sid="LEV 24:20" /><note caller="+" style="x"><char style="xo" closed="false">24:20 </char><char style="xt" closed="false"><ref loc="MAT 5:38">मत्ती 5:38</ref></char></note>मतलब तोड़-फोड़ करन को बदला तोड़-फोड़ करयो जाय, आंखी को बदला आंखी, दात को बदला दात, जसो दु:ख जेन कोयी ख दियो होना वसोच दु:ख ओख भी दियो जाय। <verse eid="LEV 24:20" /><verse number="21" style="v" sid="LEV 24:21" />जनावर ख मार डालन वालो ओको बदला भर दे, पर आदमी ख मार डालन वालो ख जरूर मार डाल्यो जाय। <verse eid="LEV 24:21" /><verse number="22" style="v" sid="LEV 24:22" />तुम्हरो नियम एकच हो, जसो देशी लायी वसोच परदेशी लायी भी हो; मय तुम्हरो परमेश्वर यहोवा आय।”<verse eid="LEV 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 24:23" />येको बाद मूसा न इस्राएलियों ख यो समझायो; तब उन्न ऊ श्राप देन वालो आदमी ख छावनी सी बाहेर लाय क ओको पर पथराव करयो। अऊर इस्राएलियों न वसोच करयो जसो परमेश्वर न मूसा ख आज्ञा दी होती।<verse eid="LEV 24:23" /></para>
  <chapter eid="LEV 24" />
  <chapter number="25" style="c" sid="LEV 25" />
  <para style="s">सातवों साल आराम दिन को साल</para>
  <para style="r">(<ref loc="DEU 15:1-11">व्यवस्थाविवरन 15:1-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 25:1" />फिर परमेश्वर न सीनै पहाड़ी पर मूसा सी कह्यो, <verse eid="LEV 25:1" /><verse number="2" style="v" sid="LEV 25:2" />“इस्राएलियों सी कहो कि जब तुम ऊ देश म सिरो जो मय तुम्ख दे रह्यो हय, तब ऊ देश की जमीन भी परमेश्वर लायी आराम करेंन। <verse eid="LEV 25:2" /><verse number="3" style="v" sid="LEV 25:3" />छय साल तक अपनो अपनो खेत म बीज बोयो करो, अऊर अंगूर की बाड़ी कटायी-छटायी कर क् ओकी फसल जमा करो; <verse eid="LEV 25:3" /><verse number="4" style="v" sid="LEV 25:4" />पर सातवों साल जमीन ख परमेश्वर लायी आराम मिलेंन; तुम ऊ साल म अपनो खेत मत बोवो अऊर नहीं अपनो अंगूर की बाड़ी छाटो। <verse eid="LEV 25:4" /><verse number="5" style="v" sid="LEV 25:5" />जो कुछ काट्यो हुयो खेत म अपनो आप सी उग्यो ओख मत काटो, अऊर बिना छाटी हुयी बेलावों को अंगूर मत तोड़ो; कहालीकि यो जमीन लायी परमविश्राम को साल होयेंन। <verse eid="LEV 25:5" /><verse number="6" style="v" sid="LEV 25:6" />जमीन को आराम साल की फसल सी तुम्ख, अऊर तुम्हरो सेवक-सेविका ख, अऊर तुम्हरो संग रहन वालो मजूरों परदेशियों ख भी भोजन मिलेंन। <verse eid="LEV 25:6" /><verse number="7" style="v" sid="LEV 25:7" />अऊर तुम्हरो पालतू जनावरों ख अऊर तुम्हरो देश को जंगली जनावरों ख भी जमीन की फसल सी भोजन मिलेंन।<verse eid="LEV 25:7" /></para>
  <para style="s">जुबली को साल</para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 25:8" />“सात आराम साल मतलब सातगुना सात साल गिनो, सातों साल को समय उनपचास साल होयेंन। <verse eid="LEV 25:8" /><verse number="9" style="v" sid="LEV 25:9" />तब सातवों महिना को दसवों दिन ख, मतलब पश्चाताप को दिन ख, जय जयकार को महाशब्द को नरसिंगा अपनो पूरो देश म सब जागावों पर फूको। <verse eid="LEV 25:9" /><verse number="10" style="v" sid="LEV 25:10" />अऊर पचासवो साल ख पवित्र मानो, अऊर देश को पूरो निवासियों लायी छुटकारा<note caller="+" style="f"><char style="fr" closed="false">25:10 </char><char style="ft" closed="false">यो छुटकारा गुलामगिरी को, अऊर जमीन को भी आय</char></note> को प्रचार करो; ऊ तुम्हरो लायी जुबली को साल कहलायेंन; अऊर तुम अपनो देश अऊर अपनो परिवार म लौट पावों। <verse eid="LEV 25:10" /><verse number="11" style="v" sid="LEV 25:11" />तुम्हरो यहां ऊ पचासवो साल जुबली को साल कहलायेंन; ओको म तुम मत बोवो, अऊर जो अपनो आप उगेंन ओख भी मत काटो, अऊर बिन छाटी हुयी अंगूर को बेला को अंगूर भी मत तोड़ो। <verse eid="LEV 25:11" /><verse number="12" style="v" sid="LEV 25:12" />कहालीकि ऊ जुबली को साल होयेंन; ऊ तुम्हरो लायी पवित्र साल होयेंन; जो खेतों की फसल होयेंन तुम ओखच खावो।<verse eid="LEV 25:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="LEV 25:13" />“यो जुबली को साल म हर आदमी ख अपनी अपनी निजी जमीन फिर सी हासिल होयेंन। <verse eid="LEV 25:13" /><verse number="14" style="v" sid="LEV 25:14" />अऊर यदि तुम अपनो भाऊबन्धु ख कुछ बेचो यां अपनो भाऊबन्धु सी कुछ लेय लेवो, त तुम एक दूसरो ख ठगानो नहीं। <verse eid="LEV 25:14" /><verse number="15" style="v" sid="LEV 25:15" />जुबली साल को बाद जितनो साल बित्यो हय उन्की गिनती को अनुसार दाम ठहराय क एक दूसरो सी लेय लेवो, अऊर बच्यो साल फसल को अनुसार ऊ तुम्ख बेचेंन। <verse eid="LEV 25:15" /><verse number="16" style="v" sid="LEV 25:16" />यदि जादा साल बच्यो हय त दाम बढ़ावो, पर यदि कम साल बच्यो हय त दाम घटावो, कहालीकि साल फसल की संख्या जितनी होना उतनीच ऊ बेचेंन। <verse eid="LEV 25:16" /><verse number="17" style="v" sid="LEV 25:17" />तुम एक दूसरो ख धोका मत देवो; अपनो परमेश्वर सी डरो; मय तुम्हरो परमेश्वर यहोवा आय।<verse eid="LEV 25:17" /></para>
  <para style="s">सातवों साल की समस्या</para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 25:18" />“येकोलायी तुम मोरी विधियों ख मानो, मोरो नियमों को पालन करो; कहालीकि असो करनो सी तुम ऊ देश म निश्चिन्त निवास कर सको। <verse eid="LEV 25:18" /><verse number="19" style="v" sid="LEV 25:19" />जमीन तुम्ख अपनी फसल देयेंन, अऊर तुम पेट-भर खाय क ऊ देश म निश्चिन्त बस्यो रहो।<verse eid="LEV 25:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="LEV 25:20" />“अऊर यदि तुम कहो कि सातवों साल म हम बीज नहीं बोयबो, अऊर फसल जमा नहीं करबो, तब हम का खाबो? <verse eid="LEV 25:20" /><verse number="21" style="v" sid="LEV 25:21" />पर मय तुम्ख छठवो साल असी आशीष देऊं, कि जमीन की पुरानी फसल तीन साल तक पूरेंन। <verse eid="LEV 25:21" /><verse number="22" style="v" sid="LEV 25:22" />जब तुम आठवों साल म बीज बोवो, तब पुरानी फसल म सीच खावो, अऊर नववों साल की फसल आवन तक पुरानी फसल ख खावो।<verse eid="LEV 25:22" /></para>
  <para style="s">जमीन-जायजाद छुड़ावन की विधि</para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 25:23" />“जमीन हमेशा लायी बेची नहीं जाय, कहालीकि जमीन मोरी आय; अऊर ओको म तुम परदेशी अऊर बाहरी हय।”<verse eid="LEV 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="LEV 25:24" />पर तुम्ख अपनो हिस्सा को पूरो देश म की जमीन ख छुड़ावन को अधिकार हय। <verse eid="LEV 25:24" /><verse number="25" style="v" sid="LEV 25:25" />“यदि तोरो कोयी जाति-भाऊ गरीब होना अऊर ऊ अपनी निजी जमीन म सी कुछ बेच डालय, त ओको कुटुम्बियों म सी जो जवर को होना ऊ आय क अपनो जाति-भाऊ को बेच्यो हुयो हिस्सा ख छुड़ाय ले। <verse eid="LEV 25:25" /><verse number="26" style="v" sid="LEV 25:26" />यदि कोयी आदमी लायी कोयी छुड़ावन वालो नहीं होना, अऊर ओको जवर इतनो धन होना कि खुदच अपनो हिस्सा ख छुड़ाय सकेंन, <verse eid="LEV 25:26" /><verse number="27" style="v" sid="LEV 25:27" />त ऊ ओको बिकन को समय सी गिनती करेंन जो साल ओन ओख बेच्यो होतो, ओख बच्यो साल को दाम चुकाय दे, तब ऊ अपनी निजी जमीन पर अधिकार होयेंन। <verse eid="LEV 25:27" /><verse number="28" style="v" sid="LEV 25:28" />पर यदि ओको हाथ म अपनी जमीन फिर सी हासिल करन लायी धन नहीं होना, त वा जमीन लेन वालो को हाथ म जुबली को साल तक रहेंन; अऊर जुबली को साल म जमीन खुद मुक्त होय जायेंन अऊर बेचन वालो ख फिर सी हासिल होय जायेंन।<verse eid="LEV 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="LEV 25:29" />“फिर यदि कोयी आदमी शहरपनाह वालो नगर म अपनो घर बेचेंन, त ऊ बेचन को बाद एक साल को अन्दर छुड़ाय सकेंन, मतलब पूरो साल भर ऊ आदमी ख छुड़ावन को अधिकार रहेंन।” <verse eid="LEV 25:29" /><verse number="30" style="v" sid="LEV 25:30" />पर यदि घर पूरो एक साल म छुड़ायो नहीं गयो, त शहरपनाह नगर को घर पीढ़ी सी पीढ़ी तक ऊ आदमी को अधिकार म होय जायेंन; जेन ओख लियो होतो ऊ जुबली को साल म भी नहीं छूटेंन। <verse eid="LEV 25:30" /><verse number="31" style="v" sid="LEV 25:31" />पर बिना शहरपनाह को घर त देश को खेतों को जसो गिन्यो जायेंन; उन्को छुड़ानो भी होय सकेंन, अऊर हि जुबली को साल म भी छूट सकेंन। <verse eid="LEV 25:31" /><verse number="32" style="v" sid="LEV 25:32" />फिर भी जिन नगरों म बन्यो घरों पर लेवियों को अधिकार हय, उन घरों ख लेवियों कोयी भी समय छुड़ाय सकय हय। <verse eid="LEV 25:32" /><verse number="33" style="v" sid="LEV 25:33" />अऊर यदि कोयी लेवीय अपनो घर नहीं छुड़ाये, त ऊ बेच्यो हुयो घर जो ओको हिस्सा को नगर म होना जुबली को साल म छूट जायेंन; कहालीकि इस्राएलियों को बीच म लेवियों नगरों को घरों पर उन्कोच अधिकार हय। <verse eid="LEV 25:33" /><verse number="34" style="v" sid="LEV 25:34" />पर उन्को नगरों को चारयी तरफ की चरायी की जमीन बेची नहीं जायेंन; कहालीकि उन पर लेवियों को अधिकार हय।<verse eid="LEV 25:34" /></para>
  <para style="s">गरीबों ख उधार देनो</para>
  <para style="p">
    <verse number="35" style="v" sid="LEV 25:35" />फिर यदि तोरो कोयी भाऊबन्धु गरीब होय जाये, अऊर ओकी दशा तोरो सामने तरस खान लायक होय जाये, त तय ओख सम्भाल लेजो; ऊ परदेशी यात्री को जसो तोरो संग रह्य सकेंन। <verse eid="LEV 25:35" /><verse number="36" style="v" sid="LEV 25:36" /><note caller="+" style="x"><char style="xo" closed="false">25:36 </char><char style="xt" closed="false"><ref loc="LUK 6:35">लूका 6:35</ref></char></note>ओको सी ब्याज यां जादा फायदा मत लेजो; बल्की अपनो परमेश्वर को प्रति श्रद्धा-भाव रखजो; जेकोसी तोरो भाऊबन्धु तोरो संग जीवन बिताय सकेंन। <verse eid="LEV 25:36" /><verse number="37" style="v" sid="LEV 25:37" />तय ओख ब्याज पर रुपया मत देजो, अऊर नहीं ओख भोजन चिज को फायदा कमावन को उद्देश सी देजो। <verse eid="LEV 25:37" /><verse number="38" style="v" sid="LEV 25:38" />मय तुम्हरो परमेश्वर यहोवा आय; मय तुम्ख मिस्र देश सी येकोलायी निकाल लायो कि तुम्ख कनान देश देऊ अऊर तुम्हरो परमेश्वर होय जाऊ।<verse eid="LEV 25:38" /></para>
  <para style="s">सेवकों को छुटकारा</para>
  <para style="p">
    <verse number="39" style="v" sid="LEV 25:39" />फिर यदि कोयी तोरो भाऊबन्धु तोरो सामने गरीब होय क अपनो आप ख तोरो हाथ म बेच डाले, त ओको सी सेवक को जसो काम मत कराजो। <verse eid="LEV 25:39" /><verse number="40" style="v" sid="LEV 25:40" />ऊ तोरो संग मजूर यां यात्री को समान रहेंन, अऊर जुबली को साल तक तोरो संग रह्य क सेवा करतो रहे; <verse eid="LEV 25:40" /><verse number="41" style="v" sid="LEV 25:41" />फिर ऊ अपनो बच्चावों को संग तोरो जवर सी निकल जाय, अऊर अपनो कुटुम्ब म अऊर अपनो पूर्वजों की सम्पत्ति फिर सी हासिल करेंन। <verse eid="LEV 25:41" /><verse number="42" style="v" sid="LEV 25:42" />कहालीकि हि मोरोच सेवक आय, जिन्ख मय न मिस्र देश सी निकाल लायो हय; येकोलायी हि गुलाम को समान नहीं बेच्यो जाय। <verse eid="LEV 25:42" /><verse number="43" style="v" sid="LEV 25:43" />उन पर कठोरता सी अधिकार मत करजो; अपनो परमेश्वर को भय मानजो। <verse eid="LEV 25:43" /><verse number="44" style="v" sid="LEV 25:44" />यदि तुम्ख दास-दासियों की जरूरत हय त अपनो आस-पास की राज्यों म सी दास अऊर दासियों ख लेय लेजो। <verse eid="LEV 25:44" /><verse number="45" style="v" sid="LEV 25:45" />जो यात्री लोग तुम्हरो बीच म रहेंन, उन म सी अऊर उन्को घराना म सी भी जो तुम्हरो आस-पास होना, अऊर जिन्को जनम तुम्हरो देश म भयो हय, उन म सी तुम दास-दासियों ख लेय लेवो; अऊर हि तुम्हरी जायजाद होयेंन। <verse eid="LEV 25:45" /><verse number="46" style="v" sid="LEV 25:46" />तुम अपनो टुरावों ख भी जो तुम्हरो बाद होयेंन उन्को अधिकार म कर सको, अऊर हि उन्को हिस्सा ठहरेंन; उन म सी तुम हमेशा अपनो लायी दास लियो करो, पर तुम्हरो भाऊबन्धु जो इस्राएली होना उन पर अपनो अधिकार कठोरता सी मत जताजो।<verse eid="LEV 25:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="LEV 25:47" />“फिर यदि तोरो सामने परदेशी यां यात्री धनी होय जाये, अऊर ओको सामने तोरो भाऊ गरीब होय क अपनो आप ख तोरो सामने ऊ परदेशी यां यात्री को कुटुम्ब को कोयी सदस्य को हाथ म बेच डाले, <verse eid="LEV 25:47" /><verse number="48" style="v" sid="LEV 25:48" />त ओको बेच्यो जान को बाद ऊ फिर छुड़ायो जाय सकय हय; ओको भाऊवों म सी कोयी ओख छुड़ाय सकय हय, <verse eid="LEV 25:48" /><verse number="49" style="v" sid="LEV 25:49" />यां ओको काका, यां काका भाऊ, यां ओको कुल को कोयी भी जवर को कुटुम्बी ओख छुड़ाय सकय हय; यां यदि ऊ धनी होय जाये, त ऊ खुदच अपनो ख छुड़ाय सकय हय।” <verse eid="LEV 25:49" /><verse number="50" style="v" sid="LEV 25:50" />ऊ अपनो लेन वालो को संग अपनो बेच्यो जान को साल सी जुबली को साल तक गिनती करे, अऊर ओको बेचन को दाम साल की गिनती को अनुसार होयेंन, मतलब ऊ दाम मजूरों को समय को समान ओको संग होयेंन। <verse eid="LEV 25:50" /><verse number="51" style="v" sid="LEV 25:51" />यदि जुबली को साल को बहुत साल बाकी रह्य जाये, त जितनो रुपयों सी ऊ लियो गयो होना उन म सी ऊ अपनो छुड़ावन को दाम उतनो साल को अनुसार लौटाय देयेंन। <verse eid="LEV 25:51" /><verse number="52" style="v" sid="LEV 25:52" />यदि जुबली को साल को थोड़ो साल बाकी रह्य गयो होना, तब भी ऊ अपनो मालिक को संग हिसाब कर क् अपनो छुड़ावन को दाम उतनोच साल को अनुसार लौटाय देयेंन। <verse eid="LEV 25:52" /><verse number="53" style="v" sid="LEV 25:53" /><note caller="+" style="x"><char style="xo" closed="false">25:53 </char><char style="xt" closed="false"><ref loc="COL 4:1">कुलुस्सियों 4:1</ref></char></note>ऊ अपनो मालिक को संग ऊ मजूर को समान रहे जेकी वार्षिक मजूरी ठहरायी जावय हय; अऊर ओको मालिक ओको पर तोरो सामने कठोरता सी अधिकार नहीं जतानो पाये। <verse eid="LEV 25:53" /><verse number="54" style="v" sid="LEV 25:54" />अऊर यदि ऊ इन रीतियों सी छुड़ायो नहीं जाये, त ऊ जुबली को साल म अपनो बाल-बच्चां समेत छूट जायेंन। <verse eid="LEV 25:54" /><verse number="55" style="v" sid="LEV 25:55" />कहालीकि इस्राएली मोरोच सेवक आय; हि मिस्र देश सी मोरोच निकाल्यो हुयो सेवक आय; मय तुम्हरो परमेश्वर यहोवा आय।<verse eid="LEV 25:55" /></para>
  <chapter eid="LEV 25" />
  <chapter number="26" style="c" sid="LEV 26" />
  <para style="s">आज्ञा पालन की आशीष</para>
  <para style="r">(<ref loc="DEU 7:12-24">व्यवस्थाविवरन 7:12-24</ref>; <ref loc="DEU 28:1-14">28:1-14</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 26:1" />“तुम अपनो लायी मूर्ती मत बनावो, अऊर नहीं कोयी खोदी हुयी मूर्ती यां खम्बा अपनो लायी खड़ो मत करो, अऊर नहीं अपनो देश म दण्डवत करन लायी नक्काशीदार गोटा स्थापित करो; कहालीकि मय तुम्हरो परमेश्वर यहोवा आय।” <verse eid="LEV 26:1" /><verse number="2" style="v" sid="LEV 26:2" />तुम मोरो आराम दिनों को पालन करो अऊर मोरो पवित्र जागा को आदर करो; मय परमेश्वर आय।<verse eid="LEV 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="LEV 26:3" />“यदि तुम मोरी विधियों पर चलो अऊर मोरी आज्ञावों ख मान क ओको पालन करो, <verse eid="LEV 26:3" /><verse number="4" style="v" sid="LEV 26:4" />त मय तुम्हरो लायी समय समय पर बारीश बरसाऊं, जेकोसी खेत अपनी उपज उपजायेंन, अऊर जमीन को झाड़ अपनो अपनो फर दियो करेंन; <verse eid="LEV 26:4" /><verse number="5" style="v" sid="LEV 26:5" />यहां तक कि तुम अंगूर तोड़न को समय भी दावनी करतो रहो, अऊर बोवन को समय भी अंगूर तोड़तो रहो, अऊर तुम भरपेट रोटी खावो, अऊर अपनो देश म निश्चिन्त होय क बस्यो रहो।<verse eid="LEV 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="LEV 26:6" />“अऊर मय तुम्हरो देश ख सुख चैन देऊं, अऊर तुम्ख कोयी नहीं डरायेंन; अऊर मय ऊ देश म हिंसक जनावरों ख नहीं रहन देऊं, अऊर नहीं तुम्हरो देश पर तलवार चलेंन। <verse eid="LEV 26:6" /><verse number="7" style="v" sid="LEV 26:7" />अऊर तुम अपनो दुश्मनों ख मार भगावों। अऊर हि तुम्हरो सामने तलवार सी मारयो जायेंन। <verse eid="LEV 26:7" /><verse number="8" style="v" sid="LEV 26:8" />तुम म सी पाच आदमी सौ ख अऊर सौ आदमी दस हजार ख खदेड़ेंन; अऊर तुम्हरो दुश्मन तलवार सी तुम्हरो सामने मारयो जायेंन; <verse eid="LEV 26:8" /><verse number="9" style="v" sid="LEV 26:9" />अऊर मय तुम्हरो तरफ कृपादृष्टि रखूं अऊर तुम ख फलवन्त करूं अऊर बढ़ाऊं, अऊर तुम्हरो संग अपनी वाचा ख पूरी करूं। <verse eid="LEV 26:9" /><verse number="10" style="v" sid="LEV 26:10" />अऊर तुम रख्यो हुयो अनाज ख खावो, अऊर नयो रहतो हुयो भी पुरानो ख निकालो। <verse eid="LEV 26:10" /><verse number="11" style="v" sid="LEV 26:11" />अऊर मय तुम्हरो बीच म अपनो निवास-स्थान बनाऊं, अऊर मोरो जीव तुम सी घृना नहीं करेंन। <verse eid="LEV 26:11" /><verse number="12" style="v" sid="LEV 26:12" />अऊर मय तुम्हरो बीच म चल्यो फिरयो करूं, अऊर तुम्हरो परमेश्वर बन्यो रहूं, अऊर तुम मोरो लोग बन्यो रहो। <verse eid="LEV 26:12" /><verse number="13" style="v" sid="LEV 26:13" />मय त तुम्हरो ऊ परमेश्वर यहोवा आय, जो तुम ख मिस्र देश सी येकोलायी निकाल लायो कि तुम मिस्रियों को गुलाम नहीं बन्यो रहो; अऊर मय न तुम्हरो जूवा ख तोड़ डाल्यो हय, अऊर तुम्ख सीधो खड़ो कर क् चलायो हय।”<verse eid="LEV 26:13" /></para>
  <para style="s">आज्ञा उल्लंघन की सजा</para>
  <para style="r">(<ref loc="DEU 28:15-68">व्यवस्थाविवरन 28:15-68</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 26:14" />“यदि तुम मोरी नहीं सुनो, अऊर इन सब आज्ञावों ख नहीं मानो, <verse eid="LEV 26:14" /><verse number="15" style="v" sid="LEV 26:15" />अऊर मोरी विधियों ख निकम्मा जानो, अऊर तुम्हरी आत्मा मोरो फैसला सी घृना करेंन, अऊर तुम मोरी सब आज्ञावों को पालन नहीं करो, बल्की मोरी वाचा ख तोड़ो, <verse eid="LEV 26:15" /><verse number="16" style="v" sid="LEV 26:16" />त मय तुम सी यो व्यवहार करूं; मतलब मय तुम्ख बेचैन करूं, अऊर क्षयरोग अऊर बुखार सी पीड़ित करूं, अऊर इन्को वजह तुम्हरी आंखी धुंधली होय जायेंन, अऊर तुम्हरो मन जादा उदास होयेंन। अऊर तुम्हरो बीज बोवनो बेकार होयेंन, कहालीकि तुम्हरो दुस्मन उन्की उपज खाय जायेंन; <verse eid="LEV 26:16" /><verse number="17" style="v" sid="LEV 26:17" />अऊर मय भी तुम्हरो खिलाफ होय जाऊं, अऊर तुम अपनो दुस्मन सी हार जावो; अऊर तुम्हरो दुस्मन तुम्हरो ऊपर अधिकार करेंन, अऊर जब कोयी तुम्हरो पीछा भी नहीं कर रह्यो होना तब भी तुम भगो।”<verse eid="LEV 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="LEV 26:18" />“अऊर यदि तुम इन बातों को होन पर भी मोरी नहीं सुनो, त मय तुम्हरो पापों को वजह तुम्ख सातगुना सजा देऊं, <verse eid="LEV 26:18" /><verse number="19" style="v" sid="LEV 26:19" />अऊर मय तुम्हरो बल को घमण्ड तोड़ डालूं, अऊर तुम्हरो लायी आसमान ख लोहा को जसो अऊर जमीन ख पीतल को जसो कठोर बनाय देऊं, <verse eid="LEV 26:19" /><verse number="20" style="v" sid="LEV 26:20" />अऊर तुम्हरी मेहनत बेकार जायेंन, कहालीकि तुम्हरी खेत उपज नहीं उपजायेंन, अऊर जमीन को झाड़ अपनो फर नहीं देयेंन।”<verse eid="LEV 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="LEV 26:21" />“यदि तुम मोरो खिलाफ चलतोच रहो, अऊर मोरो कहनो नहीं मानो, त मय तुम्हरो पापों को अनुसार तुम पर सातगुना अऊर भी संकट डालूं।” <verse eid="LEV 26:21" /><verse number="22" style="v" sid="LEV 26:22" />अऊर मय तुम्हरो बीच म जंगली जनावर भेजूं, जो तुम्हरो बच्चां ख अऊर तुम्हरो घरेलू जनावरों ख नाश कर डालेंन, अऊर तुम्हरी गिनती घटायेंन, जेकोसी तुम्हरी सड़के सुनी पड़ जायेंन।<verse eid="LEV 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="LEV 26:23" />“फिर यदि तुम इन बातों पर भी मोरी ताड़ना सी नहीं सुधरो, अऊर मोरो खिलाफ चलतोच रहो, <verse eid="LEV 26:23" /><verse number="24" style="v" sid="LEV 26:24" />त मय तुम्हरो खिलाफ चलू, अऊर तुम्हरो पापों को वजह मय खुदच तुम्ख सातगुना सजा देऊं।” <verse eid="LEV 26:24" /><verse number="25" style="v" sid="LEV 26:25" />अऊर मय तुम पर एक असी तलवार चलाऊं, जो वाचा तोड़न को पूरो पूरो बदला लेयेंन; अऊर जब तुम नगरों म जाय क जमा होवो तब मय तुम्हरो बीच म मरी फैलाऊं, अऊर तुम अपनो दुस्मनो को हाथ म सौप दियो जावो। <verse eid="LEV 26:25" /><verse number="26" style="v" sid="LEV 26:26" />जब मय तुम्हरो लायी अनाज को आधार ख दूर कर डालूं, तब दस बाईयां एकच तंदूर म पकाय क तौल तौल क देयेंन; तुम रोटियां त खावो पर तृप्त नहीं होवो।<verse eid="LEV 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="LEV 26:27" />“फिर यदि तुम येको बाद भी मोरी नहीं सुनो, अऊर मोरो खिलाफ चलतोच रहो, <verse eid="LEV 26:27" /><verse number="28" style="v" sid="LEV 26:28" />त मय गुस्सा म भर क तुम्हरो खिलाफ चलू, अऊर तुम्हरो पापों को वजह तुम ख सातगुना सजा अऊर भी देऊं।” <verse eid="LEV 26:28" /><verse number="29" style="v" sid="LEV 26:29" />अऊर तुम ख अपनो बेटावों अऊर बेटियां को मांस खानो पड़ेंन। <verse eid="LEV 26:29" /><verse number="30" style="v" sid="LEV 26:30" />अऊर मय तुम्हरो पूजा की वेदियों ख गिराय देऊं, अऊर तुम्हरी सूर्य की मूर्तियों ख तोड़ डालूं, अऊर तुम्हरो लाशों ख तुम्हरी तोड़ी हुयी मूर्तियों पर फेक देऊं; अऊर मय तुम सी घृना करूं। <verse eid="LEV 26:30" /><verse number="31" style="v" sid="LEV 26:31" />अऊर मय तुम्हरो नगरों ख उजाड़ देऊं, अऊर तुम्हरो पवित्र जागावों ख भी उजाड़ देऊं, अऊर तुम्हरो सुखदायक सुगन्ध स्विकार नहीं करूं। <verse eid="LEV 26:31" /><verse number="32" style="v" sid="LEV 26:32" />अऊर मय तुम्हरो देश ख सुनो कर देऊं, अऊर तुम्हरो दुस्मन जो ओको म रह्य हय हि इन बातों वजह चकित होय जायेंन। <verse eid="LEV 26:32" /><verse number="33" style="v" sid="LEV 26:33" />अऊर मय तुम्ख राज्य-राज्य को बीच तितर-बितर कर देऊं, अऊर तुम्हरो पीछू पीछू तलवार निकाल्यो रहूं; अऊर तुम्हरो देश सुनो अऊर तुम्हरो नगर उजाड़ होय जायेंन। <verse eid="LEV 26:33" /><verse number="34" style="v" sid="LEV 26:34" />“तब जितनो दिन ऊ देश सुनो पड़्यो रहेंन अऊर तुम अपनो दुस्मनो को देश म रहो उतनो दिन ऊ अपनो आराम कालों ख मानतो रहेंन, तबच ऊ देश आराम पायेंन, मतलब अपनो आराम कालों ख मानतो रहेंन। <verse eid="LEV 26:34" /><verse number="35" style="v" sid="LEV 26:35" />जितनो दिन ऊ देश सूनो पड़्यो रहेंन उतनो दिन ओख आराम मिलेंन, मतलब जो आराम ओख तुम्हरो वहां बस्यो रहन को समय तुम्हरो आराम कालों म नहीं मिल्यो होना ऊ ओख तब मिलेंन।<verse eid="LEV 26:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="LEV 26:36" />“अऊर तुम म सी जो बच्यो हुयो को दिल म जो तुम्हरो दुस्मनो को देश म होना उन्को दिलो म कायरता पैदा करूं; अऊर हि सुख्यो पत्ता को खड़कन को आवाज सीच भग जायेंन, अऊर हि असो भगेंन जसो कोयी तलवार सी बचन लायी भगय हय, उन्को पीछा करन वालो नहीं होनो पर भी हि गिर पड़ेंन। <verse eid="LEV 26:36" /><verse number="37" style="v" sid="LEV 26:37" />जब कोयी पीछा करन वालो नहीं होना तब भी तलवार को डर सी लड़खड़ाय क एक दूसरो पर गिरतो जायेंन, अऊर तुम्ख अपनो दुस्मनो को सामने खड़ो रहन की तुम म कुछ भी शक्ति नहीं रहेंन। <verse eid="LEV 26:37" /><verse number="38" style="v" sid="LEV 26:38" />तब तुम राज्य-राज्य को बीच पहुंच क नाश होय जावो, अऊर तुम्हरो दुस्मनो की जमीन तुम्ख खाय जायेंन। <verse eid="LEV 26:38" /><verse number="39" style="v" sid="LEV 26:39" />अऊर तुम सी जो बच्यो रहेंन हि अपनो दुस्मनो को देश म अपनो पाप को वजह गल जायेंन; अऊर अपनो पुरखावों को बुरो कामों को वजह भी हि उन्कोच जसो गल जायेंन।<verse eid="LEV 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="LEV 26:40" />“पर यदि हि अपनो पितरों को बुरो काम ख मान लेयेंन, मतलब ऊ जो मोरो विश्वासघात करेंन, अऊर यो भी मान लेयेंन कि हम परमेश्वर को खिलाफ चल्यो होतो, <verse eid="LEV 26:40" /><verse number="41" style="v" sid="LEV 26:41" /><note caller="+" style="x"><char style="xo" closed="false">26:41 </char><char style="xt" closed="false"><ref loc="ACT 7:51">प्रेरितों 7:51</ref></char></note>यो वजह ऊ हमरो खिलाफ होय क हम्ख दुस्मनो को देश म लायो हय। यदि ऊ समय उन्को खतनारहित दिल दब जायेंन अऊर हि ऊ समय अपनो बुरो काम की सजा ख स्विकार करेंन; <verse eid="LEV 26:41" /><verse number="42" style="v" sid="LEV 26:42" />तब जो वाचा मय न याकूब को संग बान्धी होती ओख मय याद करूं, अऊर जो वाचा मय न इसहाक अऊर अब्राहम सी बान्धी होती ओख भी याद करूं, अऊर यो देश ख भी मय याद करूं। <verse eid="LEV 26:42" /><verse number="43" style="v" sid="LEV 26:43" />पर ऊ देश उन्को निकल जानो सी सुनो पड़्यो रहेंन, अऊर उन्को बिना सुनो रह्य क भी आराम कालों ख मानतो रहेंन; अऊर हि लोग अपनो बुरो काम की सजा ख स्विकार करेंन, योच वजह सी उन्न मोरी आज्ञावों को उल्लंघन करयो होतो, अऊर उन्की आत्मावों ख मोरी विधियों सी घृना होती। <verse eid="LEV 26:43" /><verse number="44" style="v" sid="LEV 26:44" />इतनो होनो पर भी हि अपनो दुस्मनो को देश म रहेंन तब मय उन्ख यो तरह नहीं छोड़ूं, अऊर नहीं उन्को सी असी घृना करूं कि उन्को सत्यानाश कर डालूं अऊर अपनी वा वाचा ख तोड़ देऊ जो मय न उन्को सी बान्धी होती; कहालीकि मय उन्को परमेश्वर यहोवा आय; <verse eid="LEV 26:44" /><verse number="45" style="v" sid="LEV 26:45" />पर मय उन्की भलायी लायी उन्को पितरों सी बान्धी हुयी वाचा ख याद करूं; जिन्ख मय न दूसरो राज्यों को लोगों की आंखी को सामने मिस्र देश सी निकाल क लायो कि मय उन्को परमेश्वर ठहरू मय परमेश्वर आय।”<verse eid="LEV 26:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="LEV 26:46" />जो जो विधियां अऊर नियम अऊर व्यवस्था परमेश्वर न अपनो तरफ सी इस्राएलियों लायी सीनै पहाड़ी पर मूसा को द्वारा ठहरायी होती हि याच आय।<verse eid="LEV 26:46" /></para>
  <chapter eid="LEV 26" />
  <chapter number="27" style="c" sid="LEV 27" />
  <para style="s">प्रभु की भेंट को बारे म नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="LEV 27:1" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="LEV 27:1" /><verse number="2" style="v" sid="LEV 27:2" />“इस्राएलियों सी यो कहो कि जब कोयी विशेष मन्नत मानेंन, त मन्नत करयो हुयो व्यक्ति तोरो ठहरायो जान को अनुसार परमेश्वर को होयेंन; <verse eid="LEV 27:2" /><verse number="3" style="v" sid="LEV 27:3" />येकोलायी यदि ऊ बीस साल यां ओको सी जादा</para>
  <para style="li1" vid="LEV 27:3">अऊर साठ साल सी कम को आदमी होना, त ओको लायी पवित्र जागा को शेकेल<note caller="+" style="f"><char style="fr" closed="false">27:3 </char><char style="ft" closed="false">११.५ ग्राम चांदी को तुकड़ा</char></note> को अनुसार चांदी को पचास शेकेल को सिक्का ठहरेंन। <verse eid="LEV 27:3" /><verse number="4" style="v" sid="LEV 27:4" />अऊर यदि वा बाई होना,</para>
  <para style="li1" vid="LEV 27:4">त ओको लायी चांदी को तीस शेकेल ठहरेंन। <verse eid="LEV 27:4" /><verse number="5" style="v" sid="LEV 27:5" />फिर यदि</para>
  <para style="li1" vid="LEV 27:5">ओकी उमर पाच साल यां ओको सी जादा हय अऊर बीस साल सी कम की होना, त टुरा लायी बीस शेकेल,</para>
  <para style="li1" vid="LEV 27:5">अऊर टुरी लायी दस शेकेल ठहरेंन। <verse eid="LEV 27:5" /><verse number="6" style="v" sid="LEV 27:6" />यदि ओकी उमर एक महिना यां ओको सी जादा हय</para>
  <para style="li1" vid="LEV 27:6">अऊर पाच साल सी कम की होना, त टुरा लायी पाच शेकेल,</para>
  <para style="li1" vid="LEV 27:6">अऊर टुरी लायी तीन शेकेल ठहरेंन। <verse eid="LEV 27:6" /><verse number="7" style="v" sid="LEV 27:7" />फिर यदि ओकी उमर साठ साल की यां ओको सी जादा होना,</para>
  <para style="li1" vid="LEV 27:7">अऊर ऊ आदमी होना त ओको लायी पन्द्रा शेकेल,</para>
  <para style="li1" vid="LEV 27:7">अऊर बाई होना त दस शेकेल ठहरे।<verse eid="LEV 27:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="LEV 27:8" />“पर यदि कोयी इतनो गरीब होना कि याजक को ठहरायो हुयो दाम नहीं दे सकय, त ओख याजक को सामने खड़ो करयो जाय, अऊर याजक ओकी धन ठहरायेंन, मतलब जितनो मन्नत मानन वालो सी होय सकय, याजक ओकोच अनुसार ठहरायेंन।”<verse eid="LEV 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="LEV 27:9" />“फिर जिन जनावरों म सी लोग परमेश्वर ख चढ़ावा चढ़ावय हंय, यदि असो म सी कोयी मन्नत करयो गयो होना, त जो जनावर कोयी परमेश्वर ख दे ऊ पवित्र ठहरेंन। <verse eid="LEV 27:9" /><verse number="10" style="v" sid="LEV 27:10" />ऊ ओख कोयी तरह सी नहीं बदले, नहीं त बुरो को बदला अच्छो, अऊर नहीं अच्छो को बदला बुरो दे; अऊर यदि ऊ ऊ जनावर को बदला दूसरो जनावर दे, त ऊ अऊर ओको दूसरो जनावर दोयी पवित्र ठहरेंन। <verse eid="LEV 27:10" /><verse number="11" style="v" sid="LEV 27:11" />अऊर जिन अशुद्ध जनावरों म लोग परमेश्वर लायी चढ़ावा नहीं चढ़ावय ओको म सी होना, त ऊ व्यक्ति ऊ जनावर ख याजक को सामने खड़ो कर दे, <verse eid="LEV 27:11" /><verse number="12" style="v" sid="LEV 27:12" />तब याजक ओको दाम ठहरायेंन कि ऊ अच्छो हय यां बुरो; अऊर जितनो याजक ठहरायेंन ओको दाम उतनोच ठहरेंन। <verse eid="LEV 27:12" /><verse number="13" style="v" sid="LEV 27:13" />पर यदि मन्नत मानन वालो ओख कोयी तरह सी छुड़ानो चाहेंन, त जो दाम याजक न ठहरायो होना ओको म ओको पाचवों हिस्सा अऊर बढ़ाय क दे।<verse eid="LEV 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="LEV 27:14" />“फिर यदि कोयी अपनो घर परमेश्वर लायी पवित्र ठहराय क मन्नत मानय, त याजक ओको दाम ठहरायेंन कि ऊ अच्छो घर हय यां बुरो; अऊर जितनो याजक ठहरायेंन ओको दाम उतनोच ठहरेंन। <verse eid="LEV 27:14" /><verse number="15" style="v" sid="LEV 27:15" />अऊर यदि घर को पवित्र करन वालो ओख छुड़ानो चाहेंन, त जितनो रुपया याजक न ठहरायो होना ओको म ऊ व्यक्ति पाचवों हिस्सा अऊर बढ़ाय क दे, तब ऊ घर ओकोच रहेंन।<verse eid="LEV 27:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="LEV 27:16" />“फिर यदि कोयी अपनी निजी जमीन को कोयी हिस्सा परमेश्वर लायी पवित्र ठहरानो चाहेंन, त ओको दाम येकोच अनुसार ठहरेंन कि ओको म कितनो बीज लगेन; जितनो जमीन म होमेर<note caller="+" style="f"><char style="fr" closed="false">27:16 </char><char style="ft" closed="false">लगभग ५० शेकेल </char></note> भर जौ बोयो जायेंन उतनो को दाम पचास शेकेल ठहरेंन। <verse eid="LEV 27:16" /><verse number="17" style="v" sid="LEV 27:17" />यदि ऊ अपनो खेत जुबली को साल म पवित्र ठहरायेंन, त ओको दाम तोरो ठहरान को अनुसार ठहरेंन; <verse eid="LEV 27:17" /><verse number="18" style="v" sid="LEV 27:18" />अऊर यदि ऊ अपनो खेत जुबली को साल को बाद पवित्र ठहरायेंन, त जितनो साल दूसरो जुबली को साल को बाकी रहेंन उन्कोच अनुसार याजक ओको लायी रुपया को हिसाब करेंन, तब जितनो हिसाब म आयेंन उतनो याजक को ठहरायो हुयो सी कम कर दे। <verse eid="LEV 27:18" /><verse number="19" style="v" sid="LEV 27:19" />अऊर यदि खेत को पवित्र ठहरान वालो ओख छुड़ानो चाहेंन, त जो दाम याजक न ठहरायो होना ओख म सी ऊ पाचवों हिस्सा अऊर बढ़ाय क देयेंन, तब खेत ओकोच होयेंन। <verse eid="LEV 27:19" /><verse number="20" style="v" sid="LEV 27:20" />पर यदि ऊ खेत ख छुड़ानो नहीं चाहेंन, यां ओन ऊ खेत दूसरो ख बेच्यो होना, त खेत कभी नहीं छुड़ायो जायेंन; <verse eid="LEV 27:20" /><verse number="21" style="v" sid="LEV 27:21" />पर जब ऊ खेत जुबली को साल म छुड़ायो जायेंन, तब पूरी रीति सी अर्पन करयो हुयो खेत को समान परमेश्वर लायी पवित्र ठहरेंन, मतलब ऊ याजक की निजी जमीन होय जायेंन।<verse eid="LEV 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="LEV 27:22" />“फिर यदि कोयी अपनो लियो हुयो खेत, जो ओकी निजी जमीन को हिस्सा नोहोय, ओख परमेश्वर लायी पवित्र ठहराये, <verse eid="LEV 27:22" /><verse number="23" style="v" sid="LEV 27:23" />त याजक जुबली को साल तक को हिसाब कर क् ऊ आदमी लायी जितनो ठहरायो गयो हय उतनोच ऊ परमेश्वर लायी पवित्र जान क उच दिन दे दे।” <verse eid="LEV 27:23" /><verse number="24" style="v" sid="LEV 27:24" />जुबली को साल म खेत ऊ व्यक्ति ख फिर सी ओख हासिल होय जायेंन, जेकोसी ओन लियो होतो, जेकी वा निजी जमीन होती ओकीच होय जायेंन।<verse eid="LEV 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="LEV 27:25" />जो जो चिज को दाम याजक ठहरायेंन ओको दाम पवित्र जागा को शेकेल को हिसाब सी ठहरेंन, शेकेल बीस गेरा<note caller="+" style="f"><char style="fr" closed="false">27:25 </char><char style="ft" closed="false">लगभग १२ ग्राम</char></note> को होयेंन।<verse eid="LEV 27:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="LEV 27:26" />“पर घरेलू जनावरों को पहिलौटा पर सिर्फ परमेश्वर को अधिकार हय, कोयी भी ओख पवित्र नहीं ठहराये; चाहे ऊ गोरा होना, चाहे ऊ मेंढा होना यां पालतु जनावर होना ओको पर परमेश्वर को अधिकार हय। <verse eid="LEV 27:26" /><verse number="27" style="v" sid="LEV 27:27" />पर यदि ऊ अशुद्ध जनावर को हय, त ओख पवित्र ठहरान वालो ओख याजक को ठहरायो हुयो दाम को अनुसार ओको पाचवों हिस्सा अऊर बढ़ाय क छुड़ाय सकय हय; अऊर यदि ऊ जनावर छुड़ायो नहीं जाये, त याजक को ठहरायो हुयो दाम पर बेच दियो जायेंन।<verse eid="LEV 27:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="LEV 27:28" />“पर अपनी पूरी चिजों म सी जो कुछ कोयी परमेश्वर लायी भेंट करे, चाहे ऊ आदमी होना चाहे जनावर, चाहे ओकी निजी जमीन को खेत होना, असी कोयी भेंट करी हुयी चिज नहीं बेची जाये अऊर नहीं छुड़ायी जाये; जो कुछ भेंट करयो जाये ऊ परमेश्वर लायी परमपवित्र ठहरे। <verse eid="LEV 27:28" /><verse number="29" style="v" sid="LEV 27:29" />आदमियों म सी जो कोयी मृत्य-दण्ड लायी भेंट करयो जाये, ऊ छुड़ायो नहीं जाये; जरूर ऊ मार डाल्यो जाये।<verse eid="LEV 27:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="LEV 27:30" />“फिर जमीन की फसल को पूरो दशमांश, चाहे ऊ जमीन को बीज होना चाहे झाड़ को फर, ऊ परमेश्वर कोच आय; ऊ परमेश्वर लायी पवित्र ठहरे। <verse eid="LEV 27:30" /><verse number="31" style="v" sid="LEV 27:31" />यदि कोयी अपनो दशमांश म सी कुछ वापस लेनो चाहेंन, त पाचवों हिस्सा बढ़ाय क ओख छुड़ाये। <verse eid="LEV 27:31" /><verse number="32" style="v" sid="LEV 27:32" />अऊर पालतु जनावर मेंढी-शेरियों को हर एक दसवों जनावर, जो चरवाहा की लाठी को खल्लो सी निकल जावय हय ऊ परमेश्वर लायी पवित्र ठहरे। <verse eid="LEV 27:32" /><verse number="33" style="v" sid="LEV 27:33" />कोयी उन म अच्छो अऊर बुरो जनावर म भेद नहीं करे, अऊर नहीं उन्ख बदले; अऊर यदि कोयी ओख बदल भी लेवय हय, त ऊ अऊर ओको दूसरो जनावर दोयी पवित्र ठहरेंन; अऊर ऊ कभी छुड़ायो नहीं जाये।”<verse eid="LEV 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="LEV 27:34" />जो आज्ञाये परमेश्वर न इस्राएलियों लायी सीनै पहाड़ी पर मूसा ख दी होती हि याच आय।<verse eid="LEV 27:34" /></para>
  <chapter eid="LEV 27" />
</usx>