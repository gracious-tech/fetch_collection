<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Lodhi</book>
  <para style="h">१ यूहन्ना</para>
  <para style="toc3">१ यूहन्ना</para>
  <para style="toc2">१ यूहन्ना</para>
  <para style="toc1">यूहन्ना की पहली चिट्ठी</para>
  <para style="mt2">यूहन्ना की पहली पत्री</para>
  <para style="mt1">यूहन्ना की पहिली चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">यूहन्ना की पहिली चिट्ठी प्रेरित यूहन्ना द्वारा मसीह को जनम को ५० सी १०० साल को बीच लिख्यो गयो होतो यूहन्ना खुद लेखक को रूप म नहीं जान्यो जावय पर पहिलो अध्याय दिखावय हय कि ऊ यीशु को जीवन अऊर पुनरुत्थान को लायी एक प्रत्यक्षदर्शी को रूप म हय <char style="xt"><ref loc="1JN 1:1-3">१:१-३</ref>।</char> १ यूहन्ना की लिखन की शैली यूहन्ना रचित सुसमाचार को अनुसार लेखन शैली जसी दिखय हय। असो माननो हय कि यूहन्ना न यूहन्ना रचित सुसमाचार को अनुसार इफिसियों म रहतो हुयो तीन चिट्ठी १ यूहन्ना, २ यूहन्ना, ३ यूहन्ना, लिखी गयी होती।</para>
  <para style="ip">यूहन्ना न या चिट्ठी ख सब मसीहियों ख लिखी होती जब मण्डली ख “ज्ञानवादी” नामक लोगों को झुण्ड सी परेशानी होय रही होती इन लोगों को माननो होतो कि यीशु पूरो तरह सी प्रभु होतो पर ऊ वास्तव म मांस अऊर खून को शरीर को संग धरती पर आदमी होतो। योच तरह सी यूहन्ना न यीशु को जीवन को प्रति प्रत्यक्षदर्शी होन को बारे म लिख्यो अऊर कह्यो कि मोरो हाथों न यीशु ख छूयो<char style="xt"><ref loc="1JN 1:1-3">१:१-३</ref>।</char> या चिट्ठी ख लिखन म यूहन्ना को उद्देश उन लोगों की खुशी ख पूरो करनो होतो <char style="xt"><ref loc="1JN 1:4">१ यूहन्ना १:४</ref>, </char>विश्वासियों ख पाप करन सी रोकन लायी <char style="xt"><ref loc="1JN 2:1">१ यूहन्ना २:१</ref></char> झूठी शिक्षा सी विश्वासियों की रक्षा करन लायी <char style="xt"><ref loc="1JN 2:26">१ यूहन्ना २:२६</ref>, </char>अऊर मजबूत करनो सी विश्वासियों ख बचायो गयो हय <char style="xt"><ref loc="1JN 5:13">५:१३</ref>।</char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. यूहन्ना न अपनी चिट्ठी म प्रस्तुत करयो अऊर येख लिखन लायी एक उद्देश दियो। <char style="ior"><ref loc="1JN 1:1-4">१:१-४</ref></char></para>
  <para style="io1">२. तब ऊ बतावय हय कि परमेश्वर प्रकाश हय अऊर हम्ख मसीह म कसो जीवन जीनो होना। <char style="ior"><ref loc="1JN 1:5-3:10">१:५–३:१०</ref> </char></para>
  <para style="io1">३. हर समय हम्ख एक दूसरों सी प्रेम रखनो चाहिये येख याद दिलावत होतो। <char style="ior"><ref loc="1JN 3:11-5:12">३:११–५:१२</ref> </char></para>
  <para style="io1">४. तब उन्न अपनी चिट्ठी लिखनो बन्द कर दियो। <char style="ior"><ref loc="1JN 5:13-21">५:१३-२१</ref> </char></para>
  <chapter number="1" style="c" sid="1JN 1"/>
  <para style="s">जीवन को वचन</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:1">यूहन्ना १:१</ref>
      </char>
    </note>ऊ जीवन को वचन को बारे म हम लिखजे हय जो सुरू सी होतो, जेक हम न सुन्यो, अऊर जेक अपनी आंखी सी देख्यो, बल्की जेक हम न ध्यान सी देख्यो अऊर हाथों सी छूयो। <verse eid="1JN 1:1"/><verse number="2" style="v" sid="1JN 1:2"/><note caller="+" style="x"><char style="xo" closed="false">१:२ </char><char style="xt" closed="false"><ref loc="JHN 1:14">यूहन्ना १:१४</ref></char></note>यो जीवन प्रगट भयो, अऊर हम न ओख देख्यो, अऊर ओकी गवाही देजे हंय, अऊर तुम्ख ऊ अनन्त जीवन को समाचार देजे हंय जो बाप को संग होतो अऊर हम पर प्रगट भयो <verse eid="1JN 1:2"/><verse number="3" style="v" sid="1JN 1:3"/>जो कुछ हम न देख्यो अऊर सुन्यो हय ओको समाचार तुम्ख भी देजे हंय, येकोलायी कि तुम भी हमरो संग सामिल हो; अऊर हमरी या सहभागिता बाप को संग अऊर ओको बेटा यीशु मसीह को संग हय। <verse eid="1JN 1:3"/><verse number="4" style="v" sid="1JN 1:4"/>अऊर या बाते हम येकोलायी लिखजे हंय कि हमरी खुशी पूरी हो जाय।<verse eid="1JN 1:4"/></para>
  <para style="s">ज्योति म चलनो</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5"/>जो समाचार हम न ओको सी सुन्यो अऊर तुम्ख सुनाजे हंय, ऊ यो आय कि परमेश्वर प्रकाश आय अऊर ओको म कुछ भी अन्धारो नहाय। <verse eid="1JN 1:5"/><verse number="6" style="v" sid="1JN 1:6"/>यदि हम कहबो कि ओको संग हमरी सहभागिता हय अऊर फिर अन्धारो म चले, त हम झूठो हंय अऊर सच पर नहीं चलजे; <verse eid="1JN 1:6"/><verse number="7" style="v" sid="1JN 1:7"/>पर यदि जसो ऊ प्रकाश म हय, वसोच हम भी प्रकाश म चले, त एक दूसरों सी सहभागिता रखजे हंय, अऊर ओको बेटा यीशु को खून हम्ख सब पापों सी शुद्ध करय हय।<verse eid="1JN 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8"/>यदि हम कहबो कि हम म कुछ भी पाप नहाय, त अपनो आप ख धोका देजे हंय, अऊर हम म सच नहाय। <verse eid="1JN 1:8"/><verse number="9" style="v" sid="1JN 1:9"/>यदि हम अपनो पापों ख मान ले, त परमेश्वर हमरो पापों ख माफ करन अऊर हम्ख सब पापों सी शुद्ध करन म विश्वास लायक अऊर सच्चो हय। <verse eid="1JN 1:9"/><verse number="10" style="v" sid="1JN 1:10"/>यदि हम कहबो कि हम न पाप नहीं करयो, त हम परमेश्वर ख झूठो ठहरायजे हंय, अऊर ओको वचन हम म नहाय।<verse eid="1JN 1:10"/></para>
  <chapter eid="1JN 1"/>
  <chapter number="2" style="c" sid="1JN 2"/>
  <para style="s">मसीह हमरो सहायक</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1"/>हे मोरो बच्चां, मय या बाते तुम्ख येकोलायी सिखाऊं हय कि तुम पाप मत करो; अऊर यदि कोयी पाप करेंन, त बाप को जवर हमरो एक सहायक हय, यानेकि सच्चो यीशु मसीह; <verse eid="1JN 2:1"/><verse number="2" style="v" sid="1JN 2:2"/>अऊर उच हमरो पापों को पश्चाताप करय हय अऊर केवल हमरोच नहीं बल्की पूरो जगत को पापों को भी माफ करय हय।<verse eid="1JN 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3"/>यदि हम ओकी आज्ञावों ख मानबो, त येको सी हम जान लेबो कि हम ओख जान गयो हंय। <verse eid="1JN 2:3"/><verse number="4" style="v" sid="1JN 2:4"/>जो कोयी यो कह्य हय, “मय ओख जान गयो हय,” अऊर ओकी आज्ञावों ख नहीं मानु, ऊ झूठो हय अऊर ओको म सच नहाय; <verse eid="1JN 2:4"/><verse number="5" style="v" sid="1JN 2:5"/>पर जो कोयी यीशु को वचन पर चलेंन, ओको म सचमुच परमेश्वर को प्रेम सिद्ध भयो हय। येको सी हम जानजे हंय कि हम परमेश्वर की संगति म एक हंय: <verse eid="1JN 2:5"/><verse number="6" style="v" sid="1JN 2:6"/>जो कोयी यो कह्य हय कि मय ओको म बन्यो रहू हय, ओख होना कि खुद भी वसोच चलेंन जसो यीशु मसीह चल्यो होतो।<verse eid="1JN 2:6"/></para>
  <para style="s">नयी आज्ञा</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">२:७ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:34">यूहन्ना १३:३४</ref>
      </char>
    </note>हे प्रिय संगियों, मय तुम्ख कोयी नयी आज्ञा नहीं लिखूं, पर वाच पुरानी आज्ञा जो सुरूवात सी तुम्ख मिली हय; या पुरानी आज्ञा ऊ वचन आय जेक तुम न सुन्यो हय। <verse eid="1JN 2:7"/><verse number="8" style="v" sid="1JN 2:8"/>फिर भी मय तुम्ख नयी आज्ञा लिखू हय, अऊर यो मसीह म अऊर तुम म सच्ची ठहरय हय; कहालीकि अन्धारो मिटत जावय हय अऊर सच की ज्योति अब चमकन लगी हय।<verse eid="1JN 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9"/>जो कोयी यो कह्य हय कि मय ज्योति म हय अऊर अपनो भाऊ सी दुस्मनी रखय हय, ऊ अब तक अन्धारो मच हय। <verse eid="1JN 2:9"/><verse number="10" style="v" sid="1JN 2:10"/>जो कोयी अपनो भाऊ सी प्रेम रखय हय ऊ ज्योति म रह्य हय, अऊर कोयी को ठोकर को वजह नहीं बनय। <verse eid="1JN 2:10"/><verse number="11" style="v" sid="1JN 2:11"/>पर जो अपनो भाऊ सी दुस्मनी रखय हय ऊ अन्धारो म हय अऊर अन्धारो म चलय हय, अऊर नहीं जानय कि कित जावय हय, कहालीकि अन्धारो न ओकी आंखी अन्धी कर दियो हंय।<verse eid="1JN 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12"/>हे बच्चां, मय तुम्ख येकोलायी लिखू हय कि ओको नाम सी तुम्हरो पाप माफ भयो हंय। <verse eid="1JN 2:12"/><verse number="13" style="v" sid="1JN 2:13"/>हे सब बाप , मय तुम्ख येकोलायी लिखू हय कि जो पहिले सी हय तुम ओख जानय हय। हे जवानों, मय तुम्ख येकोलायी लिखू हय कि तुम न ऊ दुष्ट पर जय पायी हय।<verse eid="1JN 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14"/>हे लड़को, मय न तुम्ख येकोलायी लिख्यो हय कि तुम बाप ख जान गयो हय। हे सब बाप, मय न तुम्ख येकोलायी लिख्यो हय कि जो पहिले सी हय तुम ओख जान गयो हय। हे जवानों, मय न तुम्ख येकोलायी लिख्यो हय की तुम बलवान हो, अऊर परमेश्वर को वचन तुम म बन्यो रह्य हय, अऊर तुम न ऊ दुष्ट पर जय पायी हय।<verse eid="1JN 2:14"/></para>
  <para style="s">जगत सी प्रेम मत करो</para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15"/>तुम नहीं त जगत सी अऊर नहीं जगत म की चिजों सी प्रेम रखो। यदि कोयी जगत सी प्रेम रखय हय, त ओको म बाप को प्रेम नहाय। <verse eid="1JN 2:15"/><verse number="16" style="v" sid="1JN 2:16"/>कहालीकि जो कुछ जगत म हय, मतलब शरीर की अभिलाषा अऊर आंखी की अभिलाषा अऊर जीविका को घमण्ड, ऊ बाप को तरफ सी नहीं पर जगत कोच तरफ सी हय। <verse eid="1JN 2:16"/><verse number="17" style="v" sid="1JN 2:17"/>जगत अऊर ओकी अभिलासाये दोयी मिटत जावय हंय, पर जो परमेश्वर की इच्छा पर चलय हय ऊ हमेशा जीन्दो रहेंन।<verse eid="1JN 2:17"/></para>
  <para style="s">मसीह को विरोधी</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18"/>हे लड़को, यो आखरी समय आय; अऊर जसो तुम न सुन्यो हय कि मसीह को विरोधी आवन वालो हय, ओको अनुसार अब भी बहुत सो मसीह-विरोधी उठ खड़ो भयो हंय; येको सी हम जानजे हय कि यो आखरी समय आय। <verse eid="1JN 2:18"/><verse number="19" style="v" sid="1JN 2:19"/>हि निकल्यो त हमच म सी, पर हम म सी नहीं होतो; कहालीकि यदि हि हम म सी होतो, त हमरो संग रहतो; पर निकल येकोलायी गयो कि यो प्रगट हो कि हि सब हम म सी नहाय।<verse eid="1JN 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20"/>पर तुम्हरो त ऊ पवित्र आत्मा सी अभिषेक भयो हय, अऊर तुम सब कुछ जानय हय। <verse eid="1JN 2:20"/><verse number="21" style="v" sid="1JN 2:21"/>मय न तुम्ख येकोलायी नहीं लिख्यो कि तुम सच ख नहीं जानय, पर येकोलायी कि ओख जानय हय, अऊर येकोलायी कि कोयी झूठ, सच को तरफ सी नहाय।<verse eid="1JN 2:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22"/>झूठो कौन आय? केवल ऊ जो कह्य हय यीशु मसीहा नहीं; अऊर मसीह को विरोधी उच आय, जो बाप को अऊर बेटा को इन्कार करय हय। <verse eid="1JN 2:22"/><verse number="23" style="v" sid="1JN 2:23"/>जो कोयी बेटा को इन्कार करय हय ओको जवर बाप भी नहाय: जो बेटा ख मान लेवय हय, ओको जवर बाप भी हय।<verse eid="1JN 2:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24"/>जो सन्देश तुम न सुरूवात सी सुन्यो हय, उच तुम म बन्यो रहे; जो तुम न सुरूवात सी सुन्यो हय, यदि ऊ तुम म बन्यो रहेंन त तुम भी बेटा म अऊर बाप म बन्यो रहो। <verse eid="1JN 2:24"/><verse number="25" style="v" sid="1JN 2:25"/>अऊर जेकी ओन हम सी प्रतिज्ञा करी ऊ अनन्त जीवन आय।<verse eid="1JN 2:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26"/>मय न या बाते तुम्ख लोगों को बारे म लिखी हंय, जो तुम्ख भरमावय हंय; <verse eid="1JN 2:26"/><verse number="27" style="v" sid="1JN 2:27"/>पर तुम्हरो ऊ अभिषेक जो पवित्र आत्मा को तरफ सी करयो गयो, तुम म बन्यो रह्य हय; अऊर तुम्ख येकी जरूरत नहाय कि कोयी तुम्ख सिखाये, बल्की जसो ऊ अभिषेक जो ओको तरफ सी करयो गयो तुम्ख सब बाते सिखावय हय, अऊर यो सच्चो हय अऊर झूठो नहाय; अऊर जसो ओन तुम्ख सिखायो हय वसोच तुम ओको म बन्यो रह्य हय।<verse eid="1JN 2:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28"/>अब हे बच्चां, ओको म बन्यो रहो कि जब ऊ प्रगट हो त हम्ख हिम्मत हो, अऊर हम ओको आनो पर ओको सामने लज्जित नहीं हो। <verse eid="1JN 2:28"/><verse number="29" style="v" sid="1JN 2:29"/>यदि तुम जानय हय, कि ऊ सच्चो हय, त यो भी जानय हय कि जो कोयी सही काम करय हय ऊ परमेश्वर सी जनम्यो हय।<verse eid="1JN 2:29"/></para>
  <chapter eid="1JN 2"/>
  <chapter number="3" style="c" sid="1JN 3"/>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:12">यूहन्ना १:१२</ref>
      </char>
    </note>देखो, बाप न हम सी कसो प्रेम करयो हय कि हम परमेश्वर की सन्तान कहलाये; अऊर हम भी हंय। यो वजह जगत हम्ख नहीं जानय, कहालीकि ओन ओख भी नहीं जान्यो। <verse eid="1JN 3:1"/><verse number="2" style="v" sid="1JN 3:2"/>हे प्रिय संगियों, अब हम परमेश्वर की सन्तान हय, अऊर अभी तक यो प्रगट नहीं भयो कि हम का कुछ होयेंन। इतनो जानजे हय कि जब ऊ प्रगट होयेंन त हम ओको जसो होबो, कहालीकि ओख वसोच देखबोंन जसो ऊ हय। <verse eid="1JN 3:2"/><verse number="3" style="v" sid="1JN 3:3"/>अऊर जो ओको पर या आशा रखय हय, ऊ अपनो आप ख वसोच शुद्ध करय हय जसो मसीह शुद्ध हय।<verse eid="1JN 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4"/>जो कोयी पाप करय हय, ऊ व्यवस्था को विरोध करय हय; अऊर पाप त व्यवस्था को विरोध हय। <verse eid="1JN 3:4"/><verse number="5" style="v" sid="1JN 3:5"/><note caller="+" style="x"><char style="xo" closed="false">३:५ </char><char style="xt" closed="false"><ref loc="JHN 1:29">यूहन्ना १:२९</ref></char></note>तुम जानय हय कि ऊ येकोलायी प्रगट भयो पापों ख निकाल ले जाये; अऊर ओको स्वभाव म पाप नहाय। <verse eid="1JN 3:5"/><verse number="6" style="v" sid="1JN 3:6"/>जो कोयी ओको एकता म बन्यो रह्य हय, ऊ पाप नहीं करय: जो कोयी पाप करय हय, ओन नहीं त ओख देख्यो हय अऊर नहीं ओख जान्यो हय।<verse eid="1JN 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7"/>हे बच्चां, कोयी को बहकाव म मत आजो। जो लोग सही काम करय हय, उच मसीह को जसो सच्चो हय। <verse eid="1JN 3:7"/><verse number="8" style="v" sid="1JN 3:8"/>जो कोयी पाप करय हय ऊ शैतान को तरफ सी हय, कहालीकि शैतान सुरूवात सीच पाप करतो आयो हय। परमेश्वर को बेटा येकोलायी प्रगट भयो कि शैतान को कामों को नाश करे।<verse eid="1JN 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9"/>जो कोयी परमेश्वर सी जनम्यो हय ऊ पाप नहीं करय; कहालीकि ओको स्वभाव ओको म बन्यो रह्य हय, अऊर ऊ पाप करच नहीं सकय कहालीकि परमेश्वर सी जनम्यो हय। <verse eid="1JN 3:9"/><verse number="10" style="v" sid="1JN 3:10"/>येको सीच परमेश्वर की सन्तान अऊर शैतान की सन्तान जान्यो जावय हंय; जो कोयी सच्चायी को काम नहीं करय ऊ परमेश्वर सी नहाय, अऊर नहीं ऊ जो अपनो भाऊ सी प्रेम नहीं रखय।<verse eid="1JN 3:10"/></para>
  <para style="s">एक दूसरों सी प्रेम रखो</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11"/>
    <note caller="+" style="x">
      <char style="xo" closed="false">३:११ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:34">यूहन्ना १३:३४</ref>
      </char>
    </note>कहालीकि जो समाचार तय न सुरूवात सी सुन्यो, ऊ यो आय कि हम एक दूसरों सी प्रेम रखो; <verse eid="1JN 3:11"/><verse number="12" style="v" sid="1JN 3:12"/>अऊर कैन को जसो मत बनो जो ऊ दुष्ट सी होतो, अऊर जेन अपनो भाऊ को खून करयो। अऊर ओख कौन्सो वजह खून करयो? यो वजह कि ओको काम बुरो होतो, अऊर ओको भाऊ को काम सही होतो।<verse eid="1JN 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13"/>हे भाऊवों अऊर बहिनों, यदि जगत तुम सी दुस्मनी करय हय त अचम्भा मत करजो। <verse eid="1JN 3:13"/><verse number="14" style="v" sid="1JN 3:14"/><note caller="+" style="x"><char style="xo" closed="false">३:१४ </char><char style="xt" closed="false"><ref loc="JHN 5:24">यूहन्ना ५:२४</ref></char></note>हम जानजे हंय कि हम मृत्यु सी पार होय क जीवन म पहुंच्यो हंय; कहालीकि हम भाऊवों सी प्रेम रखजे हंय। जो प्रेम नहीं रखय ऊ मरन की दशा म रह्य हय। <verse eid="1JN 3:14"/><verse number="15" style="v" sid="1JN 3:15"/>जो कोयी अपनो भाऊ-बहिन सी दुस्मनी रखय हय, ऊ हत्यारों हय; अऊर तुम जानय हय कि कोयी हत्यारों म अनन्त जीवन नहीं रह्य। <verse eid="1JN 3:15"/><verse number="16" style="v" sid="1JN 3:16"/>हम न प्रेम येको सीच जान्यो कि ओन हमरो लायी अपनो जीव दे दियो; अऊर हम्ख भी भाऊवों-बहिनों को लायी जीव देनो चाहिये। <verse eid="1JN 3:16"/><verse number="17" style="v" sid="1JN 3:17"/>पर जो कोयी को जवर जगत की जायजाद होना अऊर ऊ अपनो भाऊ ख गरीब देख क ओको पर तरस खानो नहीं चाहवय, त ओको म परमेश्वर को प्रेम कसो बन्यो रह्य सकय हय? <verse eid="1JN 3:17"/><verse number="18" style="v" sid="1JN 3:18"/>हे बच्चां, हम शब्द अऊर जीबली सीच नहीं, पर काम अऊर सच को द्वारा भी प्रेम करबो।<verse eid="1JN 3:18"/></para>
  <para style="s">परमेश्वर को आगु हिम्मत</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19"/>यो असो हय हम जानजे हय कि हम सच को हंय; यो तरह हम परमेश्वर की उपस्थिति म भरोसा करबो; <verse eid="1JN 3:19"/><verse number="20" style="v" sid="1JN 3:20"/>गलत कामों को लायी हमरो मन जब भी हम्ख बाहेर करय हय त यो येकोलायी होवय हय कि परमेश्वर हमरो मनों सी बड़ो हय अऊर ऊ कुछ जानय हय। <verse eid="1JN 3:20"/><verse number="21" style="v" sid="1JN 3:21"/>हे प्रियो, यदि हमरो मन हम्ख दोष नहीं दे, त हम्ख परमेश्वर को आगु हिम्मत होवय हय; <verse eid="1JN 3:21"/><verse number="22" style="v" sid="1JN 3:22"/>अऊर जो कुछ हम मांगजे हंय, ऊ हम्ख ओको सी मिलय हय, कहालीकि हम ओकी आज्ञावों ख मानजे हंय अऊर जो ओख भावय हय उच करजे हंय। <verse eid="1JN 3:22"/><verse number="23" style="v" sid="1JN 3:23"/><note caller="+" style="x"><char style="xo" closed="false">३:२३ </char><char style="xt" closed="false"><ref loc="JHN 13:34">यूहन्ना १३:३४</ref>; <ref loc="JHN 15:12">१५:१२</ref>,<ref loc="JHN 15:17">१७</ref></char></note>ओकी आज्ञा यो हय कि ओको बेटा यीशु मसीह को नाम पर विश्वास करे, अऊर जसो मसीह न हम्ख आज्ञा दियो हय ओकोच अनुसार आपस म प्रेम रखे। <verse eid="1JN 3:23"/><verse number="24" style="v" sid="1JN 3:24"/>जो ओकी आज्ञावों ख मानय हय, ऊ परमेश्वर म एक बन्यो रह्य हय: अऊर येको सीच, मतलब ऊ आत्मा सी जो ओन हम्ख दियो हय, हम जानजे हंय कि ऊ हम म एक बन्यो रह्य हय।<verse eid="1JN 3:24"/></para>
  <chapter eid="1JN 3"/>
  <chapter number="4" style="c" sid="1JN 4"/>
  <para style="s">बुरी आत्मावों ख परखो</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1"/>हे प्रियो, हर एक आत्मा को विश्वास मत करो, बल्की आत्मावों ख परखो कि हि परमेश्वर को तरफ सी हंय कि नहाय; कहालीकि बहुत सो झूठो भविष्यवक्ता पर जय प्राप्त कर लियो हय। <verse eid="1JN 4:1"/><verse number="2" style="v" sid="1JN 4:2"/>परमेश्वर को आत्मा तुम यो रीति सी पहिचान सकय हय: जो आत्मा मान लेवय हय कि यीशु मसीह शरीर म होय क आयो हय ऊ परमेश्वर को तरफ सी हय, <verse eid="1JN 4:2"/><verse number="3" style="v" sid="1JN 4:3"/>अऊर जो आत्मा यीशु ख नहीं मानय, वा परमेश्वर को तरफ सी नहाय; अऊर वाच त मसीह को विरोधी की आत्मा आय, जेकी चर्चा तुम सुन चुक्यो हय कि ऊ आवन वालो हय, अऊर अभी जगत म हय।<verse eid="1JN 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4"/>हे बच्चां, तुम परमेश्वर को आय, अऊर तुम न उन पर जय पायो हय; कहालीकि जो तुम म हय ऊ ओको सी जो जगत म हय, महान हय। <verse eid="1JN 4:4"/><verse number="5" style="v" sid="1JN 4:5"/>हि जगत को आय, यो वजह हि जगत की बाते बोलय हंय, अऊर जगत उनकी सुनय हय। <verse eid="1JN 4:5"/><verse number="6" style="v" sid="1JN 4:6"/>हम परमेश्वर को आय। जो परमेश्वर ख जानय हय, ऊ हमरी सुनय हय; जो परमेश्वर ख नहीं जानय ऊ हमरी नहीं सुनय। यो तरह हम सच की आत्मा अऊर भ्रम की आत्मा ख पहिचान लेजे हंय।<verse eid="1JN 4:6"/></para>
  <para style="s">परमेश्वर प्रेम आय</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7"/>हे प्रियो, हम आपस म प्रेम रखबो; कहालीकि प्रेम परमेश्वर सी हय। जो कोयी प्रेम करय हय, ऊ परमेश्वर सी जनम्यो हय अऊर परमेश्वर ख जानय हय। <verse eid="1JN 4:7"/><verse number="8" style="v" sid="1JN 4:8"/>जो प्रेम नहीं रखय ऊ परमेश्वर ख नहीं जानय, कहालीकि परमेश्वर प्रेम हय।<note caller="+" style="f"><char style="fr" closed="false">४:८ </char><char style="ft" closed="false">निर्गमन ३४:६</char></note> <verse eid="1JN 4:8"/><verse number="9" style="v" sid="1JN 4:9"/>जो प्रेम परमेश्वर हम सी रखय हय, ऊ येको सी प्रगट भयो कि परमेश्वर न अपनो एकलौतो बेटा ख जगत म भेज्यो हय कि हम ओको द्वारा जीवन पाये। <verse eid="1JN 4:9"/><verse number="10" style="v" sid="1JN 4:10"/>प्रेम येको म नहाय कि हम न परमेश्वर सी प्रेम करयो, पर येको म हय कि ओन हम सी प्रेम करयो अऊर हमरो पापों को पश्चाताप को बलिदान होन को लायी अपनो बेटा ख भेज्यो।<verse eid="1JN 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11"/>हे प्रियो, जब परमेश्वर न हम सी असो प्रेम करयो, त हम ख भी आपस म प्रेम रखनो चाहिये। <verse eid="1JN 4:11"/><verse number="12" style="v" sid="1JN 4:12"/><note caller="+" style="x"><char style="xo" closed="false">४:१२ </char><char style="xt" closed="false"><ref loc="JHN 1:18">यूहन्ना १:१८</ref></char></note>परमेश्वर ख कभी कोयी न नहीं देख्यो; यदि हम आपस म प्रेम रखबो, त परमेश्वर हम म बन्यो रह्य हय अऊर ओको प्रेम हम म पूरो भय गयो हय।<verse eid="1JN 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13"/>येको सीच हम जानजे हंय कि हम ओको म बन्यो रहजे हंय, अऊर ऊ हम म; कहालीकि ओन अपनी आत्मा दी हय। <verse eid="1JN 4:13"/><verse number="14" style="v" sid="1JN 4:14"/>हम न देख भी लियो अऊर गवाही देजे हंय कि बाप न बेटा ख जगत को उद्धारकर्ता कर क् भेज्यो हय। <verse eid="1JN 4:14"/><verse number="15" style="v" sid="1JN 4:15"/>जो कोयी यो मान लेवय हय कि यीशु परमेश्वर को बेटा आय, परमेश्वर ओको म बन्यो रह्य हय, अऊर ऊ परमेश्वर म।<verse eid="1JN 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 4:16"/>जो प्रेम परमेश्वर हम सी रखय हय, ओख हम जान गयो अऊर हम्ख ओको विश्वास हय। परमेश्वर प्रेम हय, अऊर जो प्रेम म बन्यो रह्य हय ऊ परमेश्वर म बन्यो रह्य हय, अऊर परमेश्वर ओको म बन्यो रह्य हय। <verse eid="1JN 4:16"/><verse number="17" style="v" sid="1JN 4:17"/>येको सीच प्रेम हम म पूरो भयो कि हम्ख न्याय को दिन हिम्मत हो; कहालीकि जसो मसीह हय वसोच जगत म हम भी हंय। <verse eid="1JN 4:17"/><verse number="18" style="v" sid="1JN 4:18"/>पूरो प्रेम म डर नहीं होवय, बल्की सिद्ध प्रेम डर ख दूर कर देवय हय; कहालीकि डर को सम्बन्ध सजा सी होवय हय, अऊर जो डर करय हय ऊ प्रेम म पूरो नहीं भयो।<verse eid="1JN 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19"/>हम येकोलायी प्रेम करजे हंय, कि पहिले ओन हम सी प्रेम करयो। <verse eid="1JN 4:19"/><verse number="20" style="v" sid="1JN 4:20"/>यदि कोयी कहेंन, “मय परमेश्वर सी प्रेम रखू हय,” अऊर अपनो भाऊ सी दुश्मनी रखे त ऊ झूठो हय; कहालीकि जो अपनो भाऊ सी जेन ओख देख्यो हय प्रेम नहीं रखय, त ऊ परमेश्वर सी भी जेक ओन नहीं देख्यो प्रेम नहीं रख सकय। <verse eid="1JN 4:20"/><verse number="21" style="v" sid="1JN 4:21"/>ओको सी हम्ख या आज्ञा मिली हय, कि जो कोयी परमेश्वर सी प्रेम रखय हय ऊ अपनो भाऊ अऊर बहिन सी भी प्रेम रखे।<verse eid="1JN 4:21"/></para>
  <chapter eid="1JN 4"/>
  <chapter number="5" style="c" sid="1JN 5"/>
  <para style="s">जगत पर जय पानो</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1"/>जेको यो विश्वास हय कि यीशुच मसीह आय, ऊ परमेश्वर को बेटा हय; अऊर जो कोयी ओको बेटा सी प्रेम रखय हय, ऊ ओको सी भी प्रेम रखय हंय जो ओको सी पैदा भयो हय। <verse eid="1JN 5:1"/><verse number="2" style="v" sid="1JN 5:2"/>जब हम परमेश्वर सी प्रेम रखजे हंय अऊर ओकी आज्ञावों ख मानजे हंय, त येको म हम जानजे हंय कि हम परमेश्वर की सन्तानों सी प्रेम रखजे हंय। <verse eid="1JN 5:2"/><verse number="3" style="v" sid="1JN 5:3"/><note caller="+" style="x"><char style="xo" closed="false">५:३ </char><char style="xt" closed="false"><ref loc="JHN 14:15">यूहन्ना १४:१५</ref></char></note>कहालीकि परमेश्वर को बच्चा सी प्रेम रखनो यो हय कि हम ओकी आज्ञावों ख माने; अऊर ओकी आज्ञाये कठिन नहाय। <verse eid="1JN 5:3"/><verse number="4" style="v" sid="1JN 5:4"/>कहालीकि जो कुछ परमेश्वर सी पैदा भयो हय, ऊ जगत पर जय प्राप्त करय हय, अऊर ऊ विजय जेकोसी जगत पर जय प्राप्त होवय हय हमरो विश्वास हय। <verse eid="1JN 5:4"/><verse number="5" style="v" sid="1JN 5:5"/>जगत पर जय पान वालो कौन आय? केवल ऊ जेको यो विश्वास हय कि यीशु, परमेश्वर को बेटा आय।<verse eid="1JN 5:5"/></para>
  <para style="s">यीशु मसीह को बारे म गवाही</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6"/>ऊ यीशु मसीहच आय जो हमरो जवर पानी अऊर खून को संग आयो। केवल पानी को संग नहीं, बल्की पानी अऊर खून को संग। अऊर वा आत्मा आय जो ओकी गवाही देवय हय कहालीकि आत्मा सत्य हय। <verse eid="1JN 5:6"/><verse number="7" style="v" sid="1JN 5:7"/>अऊर जो गवाही देवय हय, ऊ आत्मा आय; कहालीकि आत्मा सत्य हय। <verse eid="1JN 5:7"/><verse number="8" style="v" sid="1JN 5:8"/>गवाही देन वालो तीन हय, आत्मा, अऊर पानी, अऊर खून; अऊर तीनयी एकच बात पर सहमत हंय। <verse eid="1JN 5:8"/><verse number="9" style="v" sid="1JN 5:9"/>जब हम आदमियों की गवाही मान लेजे हंय, त परमेश्वर की गवाही त ओको सी बढ़ क हय; अऊर परमेश्वर की गवाही या हय कि जो ओन अपनो बेटा को बारे म गवाही दियो हय। <verse eid="1JN 5:9"/><verse number="10" style="v" sid="1JN 5:10"/>जो परमेश्वर को बेटा पर विश्वास करय हय ऊ अपनोच गवाही म रखय हय। जेन परमेश्वर पर विश्वास नहीं करयो ओन ओख झूठो ठहरायो, कहालीकि ओन ऊ गवाही पर विश्वास नहीं करयो जो परमेश्वर न अपनो बेटा को बारे म दियो हय। <verse eid="1JN 5:10"/><verse number="11" style="v" sid="1JN 5:11"/><note caller="+" style="x"><char style="xo" closed="false">५:११ </char><char style="xt" closed="false"><ref loc="JHN 3:36">यूहन्ना ३:३६</ref></char></note>अऊर वा गवाही या हय कि परमेश्वर न हम्ख अनन्त जीवन दियो हय, अऊर यो जीवन ओको बेटा म हय। <verse eid="1JN 5:11"/><verse number="12" style="v" sid="1JN 5:12"/>जेको जवर बेटा हय, ओको जवर जीवन हय; अऊर जेको जवर परमेश्वर को बेटा नहाय, ओको जवर जीवन भी नहाय।<verse eid="1JN 5:12"/></para>
  <para style="s">अनन्त जीवन</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13"/>मय न तुम्ख, जो परमेश्वर को बेटा को नाम पर विश्वास करय हय, येकोलायी लिख्यो हय कि तुम जानो कि अनन्त जीवन तुम्हरो हय। <verse eid="1JN 5:13"/><verse number="14" style="v" sid="1JN 5:14"/>अऊर हम्ख ओको आगु जो हिम्मत होवय हय, ऊ यो आय; कि यदि हम ओकी इच्छा को अनुसार कुछ मांगजे हंय, त ऊ हमरी सुनय हय। <verse eid="1JN 5:14"/><verse number="15" style="v" sid="1JN 5:15"/>जब हम ओख मांगजे हंय तब ऊ हमरी सुनय हय; अऊर या बात सच हय, त यो भी जानजे हंय कि जो कुछ हम मांगजे हय, ऊ देवय हय।<verse eid="1JN 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16"/>यदि कोयी अपनो भाऊवों-बहिनों ख असो पाप करतो देखे जेको फर मृत्यु नहीं हय, त बिनती करे, अऊर परमेश्वर ओख उन्को लायी, जिन्न असो पाप करयो हय जेको फर मृत्यु नहीं हो, जीवन देयेंन। पाप असो भी होवय हय जेको फर मृत्यु हय; येको बारे म मय बिनती करन को लायी नहीं कहूं। <verse eid="1JN 5:16"/><verse number="17" style="v" sid="1JN 5:17"/>सब तरह को अधर्म त पाप हय, पर असो पाप भी हय जेको परिनाम मृत्यु नहाय।<verse eid="1JN 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18"/>हम जानजे हंय, कि जो कोयी परमेश्वर को बच्चा हय, ऊ पाप नहीं करय; पर जो परमेश्वर सी पैदा भयो, ऊ ओख बचायो रखय हय, अऊर ऊ दुष्ट ओख नहीं पावय।<verse eid="1JN 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19"/>हम जानजे हंय कि हम परमेश्वर सी हंय, अऊर पूरो जगत ऊ दुष्ट को वश म पड़्यो हय।<verse eid="1JN 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20"/>हम यो भी जानजे हंय कि परमेश्वर को बेटा आय गयो हय अऊर ओन हम्ख समझ दियो हय कि हम ऊ सच्चो परमेश्वर ख पहिचानबो; अऊर हम ओको म जो सच हय, मतलब ओको बेटा यीशु मसीह म एकता म होय क रहजे हंय। सच्चो परमेश्वर अऊर अनन्त जीवन योच आय।<verse eid="1JN 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21"/>हे बच्चां, अपनो आप ख मूर्तियों सी बचायो रखो।<verse eid="1JN 5:21"/></para>
  <chapter eid="1JN 5"/>
</usx>
