<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EXO" style="id">- Lodhi</book>
  <para style="h">निर्गमन</para>
  <para style="toc3">निर्गमन</para>
  <para style="toc2">निर्गमन</para>
  <para style="toc1">निर्गमन</para>
  <para style="mt2">निर्गमन की पुस्तक</para>
  <para style="mt1">निर्गमन की किताब</para>
  <para style="imt">परिचय</para>
  <para style="ip">निर्गमन की किताब अब्राहम को वंश की कहानी ख आगु बढ़ावय हय, जो उत्पत्ति म शुरू हुयी होती। निर्गमन शब्द को अर्थ हय “निकास,” जेको तात्पर्य इस्राएल राष्ट्र को मिस्र सी निकल क ऊ देश म लौटनो सी हय जेको वादा परमेश्वर न अब्राहम सी करयो होतो। परंपरागत रूप सी, विद्वानों को माननो हय कि निर्गमन की किताब को अधिकांश भाग पैगंबर मूसा द्वारा लिख्यो गयो होतो, अऊर असो लगय हय कि यो पाठ सीच पता चलय हय। <char style="xt"><ref loc="EXO 24:4">निर्गमन २४:४</ref></char> बतावय हय कि मूसा न किताब को कुछ हिस्सों ख कसो लिख्यो। <char style="xt"><ref loc="JOS 8:31">यहोशू ८:३१</ref></char> म यो <char style="xt"><ref loc="EXO 20:25">निर्गमन २०:२५</ref></char> म दियो गयो आदेश को संदर्भ देवय हय अऊर कह्य हय कि यो “मूसा की व्यवस्था की किताब म लिख्यो गयो होतो।” नयो नियम मूसा द्वारा लिखी गयी किताबों को कयी बार उल्लेख करय हय, उदाहरन लायी जब जरती हुयी झाड़ी म जो भयो ओको बारे म बात करय हुयो अऊर यो कह्यतो हुयो कि यो “मूसा की किताब” <char style="xt"><ref loc="MRK 12:26">मरकुस १२:२६</ref></char> म लिख्यो गयो होतो। मिस्र सी इस्राएलियों को निकलनो संभवत: लगभग १३०० या १४०० साल ईसा पूर्व भयो होतो। <char style="xt"><ref loc="1KI 6:1">१ राजा ६:१</ref></char> म कह्यो गयो हय कि यो पलायन इस्राएल पर राजा सुलैमानी को शासन को चौथो साल सी ४८० साल पहिले भयो होतो।</para>
  <para style="ip">निर्गमन यो बात पर जोर देवय हय कि परमेश्वर अब्राहम, इसहाक अऊर याकूब सी करयो अपनो वादा ख कसो पूरो कर रह्यो होतो। यो अब्राहम को वंशजों, इस्राएल राष्ट्र ख मिस्र की जमीन सी परमेश्वर को शक्तिशाली उद्धार को बारे म बतावय हय <char style="xt"><ref loc="EXO 1:12">निर्गमन १:१२</ref></char> उत सी परमेश्वर अपनो लोगों ख सीनाई पहाड़ को तलहटी तक ले गयो जित ओन मूसा ख इस्राएलियों को पालन लायी कयी नियम दियो। <char style="xt"><ref loc="EXO 12-19">निर्गमन १२–१९</ref></char> यो नियम बतावय हंय कि उन्ख कसो कार्य करनो चाहिये, उन्ख कसो बलिदान करनो चाहिये, अऊर तम्बू जो उन्को बीच परमेश्वर को निवास की जागा होनो होतो, तम्बू म पूजा लायी सन्दूक अऊर दूसरो उपकरन, अऊर पूजारियों को विशेष कपड़ा <char style="xt"><ref loc="EXO 20-31">निर्गमन २०–३१</ref></char> को निर्मान लायी विस्तृत नियम दियो गयो हंय। फिर एक भयानक विद्रोह को बाद जित इस्राएल न बछड़ा को रूप म एक सोनो की मूर्ति बनायी होती, मूसा फिर सी परमेश्वर सी मिल्यो। <char style="xt"><ref loc="EXO 32-33">निर्गमन ३२–३३</ref></char> किताब को आखरी भाग म, हम पढ़जे हंय कि पहिले बतायी गयी चिजों को निर्मान कसो करयो गयो। <char style="xt"><ref loc="EXO 33-40">निर्गमन ३३–४०</ref></char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. इस्राएलियों ख मिस्र देश म गुलाम बनायो गयो होतो। <char style="ior"><ref loc="EXO 1">१</ref></char></para>
  <para style="io1">२. मूसा को परिचय दियो गयो हय तथा ओको जीवन को बारे म बतायो गयो जब तक कि ओख परमेश्वर को लोगों ख छुड़ान लायी नहीं बुलायो गयो। <char style="ior"><ref loc="EXO 2-4">२–४</ref></char></para>
  <para style="io1">३. तब लेखक बतावय हय कि कसो परमेश्वर न अपनो लोगों ख ऊ देश सी अऊर फिरौन की सेना सी बचान लायी मिस्र म बड़ो बड़ो चमत्कार अऊर विपत्तियां पैदा करी। <char style="ior"><ref loc="EXO 5:15-21">५:१५-२१</ref> </char></para>
  <para style="io1">४. यहां सी इस्राएल राष्ट्र सीनै पहाड़ तक गयो। <char style="ior"><ref loc="EXO 15:22-27">१५:२२-२७</ref> </char></para>
  <para style="io1">५. कसो परमेश्वर न मूसा ख व्यवस्था दी, जेको म परमेश्वर को लोगों, मतलब इस्राएलियों ख कसो तरह जीवन जीनो अऊर आराधना करनो होतो, येको बारे म विस्तृत निर्देश होतो। <char style="ior"><ref loc="EXO 20-31">२०–३१</ref> </char></para>
  <para style="io1">६. कसो इस्राएलियों न मूसा को भाऊ हारून ख सोनो को बछड़ा को आकार की मूर्ति बनान लायी राजी कर क् परमेश्वर को विरुद्ध विद्रोह करयो,<char style="ior"><ref loc="EXO 32">३२</ref></char></para>
  <para style="io1">७. कसो मूसा न परमेश्वर की महिमा देखी अऊर फिर इस्राएलियों ख परमेश्वर की व्यवस्था को बारे म निर्देश दियो अऊर बतायो कि रहन की जागा, सन्दूक अऊर रहन की जागा म उपासना लायी दूसरो उपकरन, तथा याजकों को विशेष कपड़ा कसो बनायो। <char style="ior"><ref loc="EXO 33-40">३३–४०</ref></char></para>
  <chapter number="1" style="c" sid="EXO 1" />
  <para style="s">मिस्र देश म इस्राएलियों को दु:ख</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 1:1" />इस्राएल मतलब याकूब को टुरावों को नाम, जो अपनो बाप को संग अपनो घरानो समेत मिस्र देश म आयो होतो, यो आय : <verse eid="EXO 1:1" /><verse number="2" style="v" sid="EXO 1:2" />रूबेन, शिमोन, लेवी, यहूदा, <verse eid="EXO 1:2" /><verse number="3" style="v" sid="EXO 1:3" />इस्साकार, जबूलून, बिन्यामीन, <verse eid="EXO 1:3" /><verse number="4" style="v" sid="EXO 1:4" />दान, नप्ताली, गाद अऊर आशेर। <verse eid="EXO 1:4" /><verse number="5" style="v" sid="EXO 1:5" /><note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="GEN 46:8-27">उत्पत्ति ४६:८-२७</ref></char></note>अऊर यूसुफ त मिस्र देश म पहिलेच आयो होतो। याकूब को अपनो वंश म जो पैदा हुयो हि सब सत्तर लोग होतो।<note caller="+" style="f"><char style="fr" closed="false">1:5 </char><char style="ft" closed="false">कुछ शास्त्र लेखों म पचहत्तर लिख्यो गयो हय</char></note> <verse eid="EXO 1:5" /><verse number="6" style="v" sid="EXO 1:6" />ओको बाद यूसुफ अऊर ओको सब भाऊ अऊर ओकी पीढ़ी को सब लोग मर गयो। <verse eid="EXO 1:6" /><verse number="7" style="v" sid="EXO 1:7" /><note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="ACT 7:17">प्रेरितों ७:१७</ref></char></note>पर इस्राएल लोगों की सन्तान फूलन-फलन लगी; अऊर हि लोग बहुतच सामर्थी बनतो गयो, अऊर उन्की संख्या बढ़ती गयी कि पूरो देश उन्को सी भर गयो।<verse eid="EXO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 1:8" />मिस्र देश म एक नयो राजा बन्यो जो यूसुफ ख नहीं जानत होतो। <verse eid="EXO 1:8" /><verse number="9" style="v" sid="EXO 1:9" />ओन अपनी प्रजा सी कह्यो, “देखो, इस्राएली लोग हम सी गिनती अऊर ताकत म बहुत बढ़ गयो हंय। <verse eid="EXO 1:9" /><verse number="10" style="v" sid="EXO 1:10" /><note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="ACT 7:19">प्रेरितों ७:१९</ref></char></note>येकोलायी आवो, हम उन्को संग चालाकी सी व्यवहार करबोंन, कहीं असो नहीं होय कि जब हि बहुत बढ़ जायेंन अऊर यदि लड़ाई को समय आय पड़्यो, त हमरो दुश्मनों सी मिल क हमरो विरोध म लड़ क देश सी भग जायें।” <verse eid="EXO 1:10" /><verse number="11" style="v" sid="EXO 1:11" />येकोलायी उन्न इस्राएलियों पर कठिन काम करन वालो अधिकारियों ख नियुक्त करयो कि हि उन पर भारी बोझा डाल क उन्ख दु:ख दियो करे; अऊर उन्न फिरौन लायी पितोम अऊर रामसेस नाम को भण्डार घर वालो नगरों ख बनायो। <verse eid="EXO 1:11" /><verse number="12" style="v" sid="EXO 1:12" />पर जितनो अधिक उन्ख दु:ख देतो गयो, उतनोच अधिक बढ़तो अऊर फैलतो गयो; येकोलायी मिस्र को लोग इस्राएलियों सी बहुतच डर गयो अऊर घृना करन लग्यो। <verse eid="EXO 1:12" /><verse number="13" style="v" sid="EXO 1:13" />तब भी मिस्रियों न इस्राएलियों लोगों सी कठोर मेहनत करवायो, <verse eid="EXO 1:13" /><verse number="14" style="v" sid="EXO 1:14" />अऊर उन्को जीवन ख गारा, ईटा अऊर खेती को अलग अलग को काम की कठिन सेवा सी जीनो मुश्किल कर डाल्यो; जो कोयी काम म हि उन्को सी सेवा करावत होतो ओको म हि कठोरता को व्यवहार करत होतो।<verse eid="EXO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 1:15" />इस्राएली बाईयों ख मदत करन वाली शिप्रा अऊर पूआ नाम की दोय इब्री मतलब इस्राएली सुईन ख मिस्र देश को राजा न आज्ञा दियो, <verse eid="EXO 1:15" /><verse number="16" style="v" sid="EXO 1:16" />“जब तुम इब्री बाईयों को बारतपन<note caller="+" style="f"><char style="fr" closed="false">1:16 </char><char style="ft" closed="false">प्रसव</char></note> करवातो समय ध्यान सी देखो कि टुरा आय, त ओख मार डालजो, अऊर टुरी हय त ओख जीन्दी रहन देजो।” <verse eid="EXO 1:16" /><verse number="17" style="v" sid="EXO 1:17" />पर हि सुईन परमेश्वर को डर मानत होती, येकोलायी मिस्र को राजा की आज्ञा नहीं मान क टुरावों ख भी जीन्दो छोड़ देत होती। <verse eid="EXO 1:17" /><verse number="18" style="v" sid="EXO 1:18" />तब मिस्र देश को राजा न सुईन ख बुलाय क पुच्छ्यो, “तुम जो टुरावों ख जीन्दो छोड़ देवय हय, त असो कहाली करय हय?” <verse eid="EXO 1:18" /><verse number="19" style="v" sid="EXO 1:19" />सुईन न फिरौन ख उत्तर दियो, “इब्री बाईयां मिस्र देश की बाईयों की जसी नहाय; हि असी फुरतीली हंय कि सुईन को पहुंचन को पहिलेच उन्ख बच्चा पैदा होय जावय हय।” <verse eid="EXO 1:19" /><verse number="20" style="v" sid="EXO 1:20" />येकोलायी परमेश्वर न सुईन को संग भलायी करी; अऊर हि इस्राएली बढ़ कर बहुत शक्तिशाली भय गयो। <verse eid="EXO 1:20" /><verse number="21" style="v" sid="EXO 1:21" />सुईन परमेश्वर को डर मानत होती, येकोलायी परमेश्वर न उन्ख अपनो परिवार दियो। अऊर इस्राएली लगातार बढ़तो अऊर ताकवर बनतो गयो। <verse eid="EXO 1:21" /><verse number="22" style="v" sid="EXO 1:22" />तब फिरौन न अपनो पूरी प्रजा ख यो आज्ञा दी, “जब इब्रियों को जितनो टुरा पैदा होयेंन उन्ख तुम नील नदी म फेंक देजो, अऊर सब टुरियों ख जीन्दो रहन देजो।”<verse eid="EXO 1:22" /></para>
  <chapter eid="EXO 1" />
  <chapter number="2" style="c" sid="EXO 2" />
  <para style="s">मूसा को जनम</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 2:1" />लेवी को घरानो को एक आदमी न एक लेवी वंश की बाई सी बिहाव कर लियो। <verse eid="EXO 2:1" /><verse number="2" style="v" sid="EXO 2:2" /><note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="ACT 7:20">प्रेरितों ७:२०</ref>; <ref loc="HEB 11:23">इब्रानियों ११:२३</ref> </char></note>वा बाई गर्भवती भयी अऊर ओको एक बेटा पैदा भयो; अऊर यो देख क कि यो बच्चा सुन्दर हय, ओन ओख तीन महीना तक लूकाय क रख्यो। <verse eid="EXO 2:2" /><verse number="3" style="v" sid="EXO 2:3" />जब वा ओख अऊर लूकाय नहीं सकी तब ओको लायी सरकंडों की एक टोकनी ले क ओको पर डामर को लेप लगायी, अऊर ओको म बच्चा ख रख क नील नदी को किनार पर लम्बी घास को बीच म रख दी। <verse eid="EXO 2:3" /><verse number="4" style="v" sid="EXO 2:4" />ऊ बच्चा की बहिन यो देखन लायी कुछ दूर खड़ी होती कि ओको संग का होवय हय।<verse eid="EXO 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 2:5" />तब फिरौन की बेटी आंग धोवन लायी नदी को किनार पर आयी। ओकी दासियां नील नदी को किनार पर घुमत होती। अचानक फिरौन की बेटी न ऊचो घास म टोकनी ख देख क अपनी सेविका ख ओख लावन लायी भेज्यो। <verse eid="EXO 2:5" /><verse number="6" style="v" sid="EXO 2:6" />जब ओन ओख खोल्यो त देख्यो कि एक बच्चा हय, जो रोय रह्य हय, तब ओको पर दया आयी अऊर ओन कह्यो, “यो त कोयी इब्रियों को बच्चा आय।” <verse eid="EXO 2:6" /><verse number="7" style="v" sid="EXO 2:7" />तब बच्चा की बहिन न फिरौन की बेटी सी कह्यो, “का मय जा क इब्री बाईयों म सी कोयी बाई ख बुलाय क ले आऊं, जो तोरो लायी बच्चा ख दूध पिलायो करेंन?” <verse eid="EXO 2:7" /><verse number="8" style="v" sid="EXO 2:8" />फिरौन की बेटी न कह्यो, “जावो।” तब टुरी जाय क बच्चा की माय ख बुलाय क आयी। <verse eid="EXO 2:8" /><verse number="9" style="v" sid="EXO 2:9" />फिरौन की बेटी न ओको सी कह्यो, “तय यो बच्चा ख लिजाय क मोरो लायी दूध पिलायो कर, अऊर मय तोख मजूरी देऊं।” तब वा बाई बच्चा ख लिजाय क दूध पिलान लगी। <verse eid="EXO 2:9" /><verse number="10" style="v" sid="EXO 2:10" /><note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="ACT 7:21">प्रेरितों ७:२१</ref></char></note>जब बच्चा थोड़ो बड़ो भयो तब कुछ समय को बाद ओख फिरौन राजा की बेटी को जवर ले गयी, अऊर ओन बच्चा ख अपनो टुरा मान लियो; अऊर ओन यो कह्य क ओको नाम मूसा रख्यो, “मय न येख पानी सी निकाल्यो होतो।”<verse eid="EXO 2:10" /></para>
  <para style="s">मूसा मिद्यान देश ख भग जानो</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 2:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:11 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 11:24">इब्रानियों ११:२४</ref>; <ref loc="ACT 7:23-28">प्रेरितों ७:२३-२८</ref></char>
    </note>जब मूसा बड़ो भयो, तब उन दिनों म ऊ बाहेर अपनो भाऊ-बन्धुवों को जवर जाय क उन्को दु:खों पर नजर रखन लग्यो; तब ओन देख्यो कि एक मिस्री आदमी ओको एक इब्री भाऊ ख मार रह्यो हय। <verse eid="EXO 2:11" /><verse number="12" style="v" sid="EXO 2:12" />ओन इत उत देख्यो कि कोयी नहाय, त ऊ मिस्री आदमी ख मार डाल्यो अऊर रेतु म लूकाय दियो।<verse eid="EXO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 2:13" />दूसरो दिन बाहेर दोय इब्री आदमी आपस म लड़ाई कर रह्यो हंय। मूसा न देख्यो कि ओको म एक गलत हय, त मूसा न ओख बोल्यो “तय अपनो संगी ख कहाली मारय हय?” <verse eid="EXO 2:13" /><verse number="14" style="v" sid="EXO 2:14" />ओन कह्यो, “कौन न तोख हम लोगों पर शासक अऊर न्याय करन वालो ठहरायो? का तुम मोख मारन आयो हंय, जसो तुम न मिस्री आदमी ख मार डाल्यो होतो?” तब मूसा यो सोच क डर गयो, कि “निश्चय ऊ बात खुल गयी हय जो मय न करयो होतो।” <verse eid="EXO 2:14" /><verse number="15" style="v" sid="EXO 2:15" /><note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ACT 7:29">प्रेरितों ७:२९</ref>; <ref loc="HEB 11:27">इब्रानियों ११:२७</ref></char></note>जब फिरौन न यो बात सुन्यो कि मूसा न यो का करयो तब ओख मारन लायी देखन लग्यो। पर मूसा फिरौन सी दूर भग गयो, अऊर मिद्यान देश म जाय क रहन लग्यो; अऊर ऊ उत एक कुंवा को जवर बैठ गयो। <verse eid="EXO 2:15" /><verse number="16" style="v" sid="EXO 2:16" />मिद्यान देश को याजक की सात बेटियां होती; अऊर हि कुंवा पर अपनो बाप की शेरी-मेंढी लायी डोगी म पानी भरन आयी होती। <verse eid="EXO 2:16" /><verse number="17" style="v" sid="EXO 2:17" />तब कुछ चरवाहे आय क उन्ख हटान लग्यो; तब मूसा उठ्यो उन्न याजक की टुरियों की मदत करी अऊर शेरी-मेंढी ख पानी पिलायो। <verse eid="EXO 2:17" /><verse number="18" style="v" sid="EXO 2:18" />जब वा अपनो बाप रूएल को जवर वापस गयी, तब ओको बाप न उन्ख पुच्छ्यो, “का वजह हय कि अज तुम इतनो जल्दी वापस आय गयी।” <verse eid="EXO 2:18" /><verse number="19" style="v" sid="EXO 2:19" />उन्न कह्यो, “एक मिस्री आदमी न हम ख चरवाहों सी बचायो, अऊर हमरो लायी बहुत पानी भर क् शेरी-मेंढी ख पानी पिलायो।” <verse eid="EXO 2:19" /><verse number="20" style="v" sid="EXO 2:20" />तब ओन अपनी बेटियों सी कह्यो, “ऊ आदमी कित हय? तुम ओख कहाली छोड़ आयी हय? ओख बुलाय क लावो कि ऊ हमरो संग जेवन करेंन।” <verse eid="EXO 2:20" /><verse number="21" style="v" sid="EXO 2:21" />अऊर मूसा उन्को संग रहन लायी तैयार भय गयो। ओन अपनी बेटी सिप्पोरा को बिहाव मूसा को संग कर दियो। <verse eid="EXO 2:21" /><verse number="22" style="v" sid="EXO 2:22" />ओन एक टुरा ख जनम दियो, तब मूसा न यो कह्यो, “मय यो देश म परदेशी हय,” येकोलायी ओको नाम गेर्शोम रख्यो।<verse eid="EXO 2:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 2:23" />बहुत साल को बाद मिस्र देश को राजा मर गयो। इस्राएली लोगों ख गुलामी म कठिन काम करनो पड़त होतो। अऊर हि मदत लायी चिल्लावत होतो, अऊर उन्की दोहायी जो कठिन काम को वजह हुयी ऊ परमेश्वर तक पहुंची। <verse eid="EXO 2:23" /><verse number="24" style="v" sid="EXO 2:24" /><note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="GEN 15:13">उत्पत्ति १५:१३</ref>,<ref loc="GEN 15:14">१४</ref></char></note>परमेश्वर न उन्को दु:ख ख सुन्यो अऊर अपनो वाचा ख, जो ओन अब्राहम, इसहाक, अऊर याकूब को संग बान्धी होती, याद करयो। <verse eid="EXO 2:24" /><verse number="25" style="v" sid="EXO 2:25" />अऊर परमेश्वर न इस्राएलियों की दुर्दशा पर नजर कर क् उन पर मन लगायो।<verse eid="EXO 2:25" /></para>
  <chapter eid="EXO 2" />
  <chapter number="3" style="c" sid="EXO 3" />
  <para style="s">जलतो हुयो झुड़ूप</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 3:1" />एक दिन मूसा अपनो ससरो यित्रो, मिद्यान देश को याजक, की मेंढी-शेरी ख चरावत होतो; अऊर ऊ उन्ख सुनसान जागा की पश्चिम दिशा म अऊर परमेश्वर को होरेब पहाड़ी को जवर ले गयो। <verse eid="EXO 3:1" /><verse number="2" style="v" sid="EXO 3:2" />अऊर परमेश्वर को दूत न एक काटा की झाड़ी को बीच आगी की लौ म ओख दर्शन दियो; अऊर मूसा न नजर उठाय क देख्यो कि झाड़ी जल त रही हय, पर जल क भस्म नहीं होय रही हय। <verse eid="EXO 3:2" /><verse number="3" style="v" sid="EXO 3:3" />तब मूसा न सोच्यो, “मय उत जाय क यो बड़ो आश्चर्य ख देखूं कि वा झाड़ी कहाली नहीं जल रही हय।” <verse eid="EXO 3:3" /><verse number="4" style="v" sid="EXO 3:4" />जब परमेश्वर न देख्यो कि मूसा झाड़ी ख देखन लायी जवर आय रह्य हय, तब परमेश्वर न झाड़ी को बीच सी ओख बुलायो, अऊर कह्यो, “हे मूसा, हे मूसा!” मूसा न उत्तर दियो, “हव मय इत हय।” <verse eid="EXO 3:4" /><verse number="5" style="v" sid="EXO 3:5" />परमेश्वर न कह्यो, “जवर मत आव; अऊर अपनो पाय सी चप्पल ख उतार दे, कहालीकि जो जागा पर तय खड़ो हय ऊ पवित्र जमीन हय।” <verse eid="EXO 3:5" /><verse number="6" style="v" sid="EXO 3:6" />“मय तुम्हरो पूर्वजों अब्राहम, इसहाक, अऊर याकूब को परमेश्वर आय।” तब मूसा न अपनो मुंह झाक लियो; कहालीकि ऊ परमेश्वर की तरफ देखन सी डर गयो।<verse eid="EXO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 3:7" />तब परमेश्वर न कह्यो, “मय न अपनी प्रजा को लोग जो मिस्र देश म हय, उन्को दु:ख देख्यो हय; अऊर उन्की जो चिल्लाहट कठिन मेहनत करावन वालो को वजह होवय हय। उन्ख भी सुन्यो हय, अऊर मय उन्को दु:ख ख जानु हय। <verse eid="EXO 3:7" /><verse number="8" style="v" sid="EXO 3:8" /><note caller="+" style="f"><char style="fr" closed="false">3:8 </char><char style="ft" closed="false">उत्पत्ति 15:19-20;21 म भी नाम दियो हय।</char></note>येकोलायी अब मय उतर आयो हय कि उन्ख मिस्रियों को वश सी छुड़ाऊं, अऊर ऊ देश सी निकाल क एक अच्छो अऊर बड़ो देश म, जित दूध अऊर शहेद की धाराये बहय हंय, मतलब कनानी, हित्ती, एमोरी, परिज्जी, हिब्बी, अऊर यबूसी जाति को लोगों को जागा म पहुंचाऊं। <verse eid="EXO 3:8" /><verse number="9" style="v" sid="EXO 3:9" />येकोलायी अब सुन, इस्राएलियों की चिल्लाहट मोख सुनायी पड़ी हय, मय न ओको अत्याचार ख भी देख्यो हय, जो मिस्र देश को निवासी उन पर कर रह्यो हंय। <verse eid="EXO 3:9" /><verse number="10" style="v" sid="EXO 3:10" />अब तय जा, मय तोख फिरौन राजा को जवर भेज रह्यो हय कि तय मोरी इस्राएली प्रजा ख मिस्र देश सी निकाल लाये।” <verse eid="EXO 3:10" /><verse number="11" style="v" sid="EXO 3:11" />पर मूसा न परमेश्वर सी कह्यो, “मय कौन आय जो फिरौन राजा को जवर जाऊ, अऊर इस्राएलियों ख मिस्र देश सी बाहेर निकाल लाऊं?” <verse eid="EXO 3:11" /><verse number="12" style="v" sid="EXO 3:12" />परमेश्वर न कह्यो, “निश्चय मय तोरो संग रहूं; अऊर यो बात को कि तोरो भेजन वालो मय आय, तोरो लायी यो चिन्ह होयेंन कि जब तय उन लोगों ख मिस्र देश सी निकाल लावो, तब तुम योच पहाड़ी पर मोरी आराधना करो।”<verse eid="EXO 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 3:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:13 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 6:2">निर्गमन ६:२</ref>,<ref loc="EXO 6:3">३</ref></char>
    </note>मूसा न परमेश्वर सी कह्यो, “जब मय इस्राएलियों को जवर जाय क उन्को सी कहू, ‘तुम्हरो पूर्वजों को परमेश्वर न मोख तुम्हरो जवर भेज्यो हय,’ अऊर हि मोरो सी पुछेंन, ‘ओको का नाम हय?’ तब मय उन्ख का बताऊं?” <verse eid="EXO 3:13" /><verse number="14" style="v" sid="EXO 3:14" /><note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="REV 1:4">प्रकाशितवाक्य १:४</ref>,<ref loc="REV 1:8">८</ref></char></note>परमेश्वर न मूसा सी कह्यो, “मय जो आय सो आय।” तब ओन कह्यो, “तय इस्राएलियों सी यो कह्यजो, ‘जेको नाम मय आय हय ओन मोख तुम्हरो जवर भेज्यो हय’।” <verse eid="EXO 3:14" /><verse number="15" style="v" sid="EXO 3:15" />तब परमेश्वर न मूसा सी यो भी कह्यो, “तय इस्राएलियों सी यो कह्यजो, ‘तुम्हरो पूर्वजों को परमेश्वर, अब्राहम को, इसहाक को अऊर, याकूब को परमेश्वर, यहोवा, ओन मोख ख तुम्हरो जवर भेज्यो हय। देख, हमेशा मोरो नाम योच रहेंन, अऊर योच नाम सी मोख पीढ़ी सी पीढ़ी तक याद करयो जायेंन।’ <verse eid="EXO 3:15" /><verse number="16" style="v" sid="EXO 3:16" />येकोलायी अब जा इस्राएली बुजूर्गों ख जमा कर, अऊर उन्को सी बोल, ‘तुम्हरो पूर्वजों को परमेश्वर, अब्राहम, इसहाक, अऊर याकूब को परमेश्वर, यहोवा न मोख दर्शन दे क यो कह्यो हय। मय न तुम्हरी सुधि ली हय। जो बर्ताव मिस्र देश म तुम्हरो संग करयो जाय रह्यो हय ओको पर भी चित्त लगायो हय। <verse eid="EXO 3:16" /><verse number="17" style="v" sid="EXO 3:17" />अऊर मय न ठान लियो हय कि तुम ख मिस्र देश को दु:खों सी बाहेर निकालूं अऊर कनानी, हित्ती, एमोरी, परिज्जी, हिब्बी, अऊर यबूसी लोगों को देश म पहुंचाऊं, जो असो देश आय कि जेको म दूध अऊर शहेद की धारायें बहय हंय।’ <verse eid="EXO 3:17" /><verse number="18" style="v" sid="EXO 3:18" />तब हि तोरी सुनेंन; अऊर तय इस्राएली बुजूर्गों ख संग ले क मिस्र देश को राजा को जवर जा अऊर ओको सी कह्यजो, ‘इब्रियों को परमेश्वर, यहोवा हम पर प्रगट भयो हय; येकोलायी अब हम ख तीन दिन की यात्रा पर सुनसान जागा म जान दे कि अपनो परमेश्वर लायी बलि दान चढ़ाये।’ <verse eid="EXO 3:18" /><verse number="19" style="v" sid="EXO 3:19" />मय जानु हय कि मिस्र देश को राजा तुम्ख तब तक जान नहीं देयेंन, जब तक कि एक ताकतवर हाथ ओख मजबूर नहीं करय। <verse eid="EXO 3:19" /><verse number="20" style="v" sid="EXO 3:20" />तब मय अपनो हाथ बढ़ाय क सामर्थ को काम मिस्र देश को बीच करूं अऊर चमत्कार को कामों सी ऊ देश पर मुसीबत डालूं; तब ऊ तुम ख जान देयेंन। <verse eid="EXO 3:20" /><verse number="21" style="v" sid="EXO 3:21" /><note caller="+" style="x"><char style="xo" closed="false">3:21 </char><char style="xt" closed="false"><ref loc="EXO 12:35">निर्गमन १२:३५</ref>,<ref loc="EXO 12:36">३६</ref></char></note>तब मय मिस्रियों सी अपनी यो प्रजा पर अनुग्रह कराऊं; अऊर जब तुम निकलो तब हि तुम्ख खाली हाथ नहीं जान देयेंन। <verse eid="EXO 3:21" /><verse number="22" style="v" sid="EXO 3:22" />बल्की हर एक बाई अपनी पड़ोसिन, अऊर उन्को घर म रहन वाली सी सोनो-चांदी को जेवर अऊर कपड़ा मांग क टुरावों अऊर टुरियों ख पहिनाजो; या तरह तुम मिस्रियों ख लूटो।”<verse eid="EXO 3:22" /></para>
  <chapter eid="EXO 3" />
  <chapter number="4" style="c" sid="EXO 4" />
  <para style="s">परमेश्वर मूसा ख अद्भुत सामर्थ देवय हय</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 4:1" />तब मूसा न उत्तर दियो, “अगर हि मोरो विश्वास नहीं करेंन अऊर नहीं मोरी सुनेंन, बल्की कहेंन, ‘परमेश्वर न तोख ख दर्शन नहीं दियो’।” <verse eid="EXO 4:1" /><verse number="2" style="v" sid="EXO 4:2" />परमेश्वर न ओको सी कह्यो, “तोरो हाथ म का हय?” ऊ बोल्यो, “लाठी।” <verse eid="EXO 4:2" /><verse number="3" style="v" sid="EXO 4:3" />परमेश्वर न कह्यो, “ओख जमीन पर डाल दे।” जब ओन ओख जमीन पर डाल्यो तब वा सांप बन गयी, अऊर मूसा ओको आगु सी भग्यो। <verse eid="EXO 4:3" /><verse number="4" style="v" sid="EXO 4:4" />तब परमेश्वर न मूसा सी कह्यो, “हाथ बढ़ाय क ओकी पूछ पकड़ ले, जब ओन हाथ बढ़ाय क ओख पकड़्यो तब वा ओको हाथ म फिर लाठी बन गयी। <verse eid="EXO 4:4" /><verse number="5" style="v" sid="EXO 4:5" />ताकी हि लोग विश्वास करे कि तुम्हरो पूर्वजों को परमेश्वर मतलब अब्राहम को परमेश्वर, इसहाक को परमेश्वर, अऊर याकूब को परमेश्वर, परमेश्वर न तोख दर्शन दियो हय।”<verse eid="EXO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 4:6" />परमेश्वर न मूसा ख फिर सी कह्यो, “अपनो हाथ पहिन्यो कपड़ा को अन्दर छाती पर रख।” मूसा न आज्ञा मानी अऊर कपड़ा को अन्दर छाती पर अपनो हाथ रख क झाक लियो; फिर जब ओन हाथ बाहेर निकाल्यो तब ओको हाथ बरफ को समान कोढ़ जसो सफेद भय गयो। <verse eid="EXO 4:6" /><verse number="7" style="v" sid="EXO 4:7" />तब परमेश्वर न कह्यो, “अब फिर सी अपनो हाथ छाती पर रख।” ओन अपनो हाथ छाती पर रख क झाक लियो; अऊर जब ओन ओख छाती पर सी निकाल्यो तब का देखय हय कि ऊ फिर पूरो शरीर को जसो अच्छो भय गयो। <verse eid="EXO 4:7" /><verse number="8" style="v" sid="EXO 4:8" />तब परमेश्वर न कह्यो, “यदि हि तोरी बात पर विश्वास नहीं करेंन, अऊर पहिले चिन्ह ख नहीं मानेंन, त दूसरो चिन्ह पर विश्वास करेंन। <verse eid="EXO 4:8" /><verse number="9" style="v" sid="EXO 4:9" />अऊर यदि हि इन दोयी चिन्हों पर विश्वास नहीं करेंन अऊर तोरी बात ख नहीं मानेंन, तब तय नील नदी सी कुछ पानी ले क सूखी जमीन पर डालजो; अऊर जो पानी तय नदी सी निकालजो ऊ सूखी जमीन पर खून बन जायेंन।”<verse eid="EXO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 4:10" />मूसा न परमेश्वर सी कह्यो, “हे मोरो प्रभु, मय बोलनो म अच्छो बोलकार नहाय, नहीं पहिले होतो, अऊर नहीं जब सी तय अपनो दास सी बाते करन लग्यो; मय त मुंह अऊर जीबली सी लड़खड़ाऊ हय।” <verse eid="EXO 4:10" /><verse number="11" style="v" sid="EXO 4:11" />परमेश्वर न ओको सी कह्यो, “आदमी को मुंह कौन न बनायो हय? अऊर आदमी ख मुक्का, यां बहिरा, यां देखन वालो, यां अन्धा, मोख छोड़ क कौन बनावय हय? का मय ऊ यहोवा नहीं। <verse eid="EXO 4:11" /><verse number="12" style="v" sid="EXO 4:12" />अब जा, तोरो बोलतो समय मय तोरी मदत करूं, अऊर तोख का कहनो हय सिखातो जाऊं।” <verse eid="EXO 4:12" /><verse number="13" style="v" sid="EXO 4:13" />पर मूसा न कह्यो, “हे मोरो परमेश्वर, कृपया तय कोयी दूसरो ख भेज।” <verse eid="EXO 4:13" /><verse number="14" style="v" sid="EXO 4:14" />तब परमेश्वर को गुस्सा मूसा पर भड़क्यो अऊर ओन कह्यो, “का तोरो भाऊ ख नहीं जानय, जो लेवीय वंश को हारून आय? मय जानु हय कि ऊ अच्छो सी बोल सकय हय, देख, ऊ तोरो सी मिलन आय रह्यो हय; अऊर तोख देख क खुश होयेंन। <verse eid="EXO 4:14" /><verse number="15" style="v" sid="EXO 4:15" />येकोलायी तय ओको सी बाते करजो; अऊर ओख बतावो कि का करनो हय मय ओख अऊर ओख बोलन म मदत करूं, अऊर तुम दोयी ख का करनो हय यो सिखाऊं। <verse eid="EXO 4:15" /><verse number="16" style="v" sid="EXO 4:16" />हारून तोरो तरफ सी लोगों सी बाते करेंन; ऊ तोरो लायी मुंह की वानी अऊर तय ओको लायी परमेश्वर जसो ठहरेंन। <verse eid="EXO 4:16" /><verse number="17" style="v" sid="EXO 4:17" />अऊर तय यो लाठी ख अपनो संग म लिजाव, अऊर येको सी इन चिन्ह चमत्कार ख दिखाजो।”<verse eid="EXO 4:17" /></para>
  <para style="s">मूसा को मिस्र देश लौटनो</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 4:18" />तब मूसा अपनो ससरो यित्रो को जवर वापस गयो अऊर ओको सी कह्यो, “मोख बिदा कर कि मय मिस्र देश म रहन वालो अपनो भाऊवों को जवर जाय क देखू कि अब तक जीन्दो हय का नहाय।” यित्रो न मूसा सी कह्यो, “तय शान्ति सी जा।” <verse eid="EXO 4:18" /><verse number="19" style="v" sid="EXO 4:19" /><note caller="+" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="ACT 7:34">प्रेरितों ७:३४</ref>; <ref loc="MAT 2:20">मत्ती २:२०</ref></char></note>अऊर परमेश्वर न मिद्यान देश म मूसा सी कह्यो, “मिस्र देश वापस जा; कहालीकि जो आदमी तोरो जीव को प्यासो होतो, हि सब मर गयो हंय।” <verse eid="EXO 4:19" /><verse number="20" style="v" sid="EXO 4:20" />तब मूसा न अपनी पत्नी अऊर अपनो बेटों ख गधा पर बैठाय क मिस्र देश को तरफ परमेश्वर न दी हुयी लाठी ख हाथ म लियो हुयो वापस लौट्यो।<verse eid="EXO 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 4:21" />तब परमेश्वर न मूसा सी कह्यो, “जब तय मिस्र देश म पहुंचो तब ध्यान रखजो कि जो चमत्कार मय न तोरो वश म करयो हंय उन सब ख फिरौन ख दिखाजो; पर मय ओको मन ख कठोर करूं, अऊर ऊ मोरो लोगों ख नहीं जान देयेंन। <verse eid="EXO 4:21" /><verse number="22" style="v" sid="EXO 4:22" /><note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="DEU 1:31">व्यवस्थाविवरन १:३१</ref>; <ref loc="JER 31:9">यिर्मयाह ३१:९</ref></char></note>अऊर तय फिरौन सी कह्यजो, परमेश्वर यो कह्य हय, कि इस्राएल मोरो पहिलो टुरा आय, <verse eid="EXO 4:22" /><verse number="23" style="v" sid="EXO 4:23" /><note caller="+" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="EXO 12:29">निर्गमन १२:२९</ref></char></note>अऊर मय तोरो सी कहूं हय कि मोरो टुरा ख जान दे। मोरी आराधना कर सके; अऊर तय न अब तक ओको नहीं जान दियो, त मय तोरो पहिलो टुरा ख मारूं।”<verse eid="EXO 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 4:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:24 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 17:14">उत्पत्ति १७:१४</ref>; <ref loc="GEN 32:25">३२:२५</ref></char>
    </note>मिस्र को रस्ता पर एक जागा म परमेश्वर मूसा को जवर आयो कि ओख मार डालनो चाहयो। <verse eid="EXO 4:24" /><verse number="25" style="v" sid="EXO 4:25" />तब सिप्पोरा न एक धार वालो गोटा ले क अपनो टुरा को खतना करयो अऊर चमड़ी ख काट क, मूसा को पाय पर डाल दियो अऊर कह्यो, “निश्चय तय मोरो लायी खून बहान वालो मोरो पति आय।” <verse eid="EXO 4:25" /><verse number="26" style="v" sid="EXO 4:26" />येकोलायी परमेश्वर न मूसा ख छोड़ दियो। जब सिप्पोरा न खतना को समय कह्यो होतो, “तय खून बहानो वालो मोरो पति आय।”<verse eid="EXO 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 4:27" />तब परमेश्वर न हारून सी कह्यो, “मूसा सी मिलन लायी जंगल म जा।” ऊ गयो। अऊर पवित्र पहाड़ी पर मूसा सी मिल्यो अऊर हारून न मूसा ख चुम्बन लियो। <verse eid="EXO 4:27" /><verse number="28" style="v" sid="EXO 4:28" />तब मूसा न हारून ख ऊ सब बतायो जो परमेश्वर न ओख मिस्र सी लौटतो समय कह्यो होतो; अऊर उन चिन्ह को बारे म भी बतायो जेक परमेश्वर न मूसा ख करन की आज्ञा दी होती। <verse eid="EXO 4:28" /><verse number="29" style="v" sid="EXO 4:29" />तब मूसा अऊर हारून मिस्र ख गयो अऊर इस्राएलियों को सब बुजूर्गों ख जमा करयो। <verse eid="EXO 4:29" /><verse number="30" style="v" sid="EXO 4:30" />जो बाते परमेश्वर न मूसा सी कह्यो होतो, ऊ सब हारून न उन्ख सुनायी, अऊर लोगों को आखी को आगु सब चिन्ह भी दिखाये। <verse eid="EXO 4:30" /><verse number="31" style="v" sid="EXO 4:31" /><note caller="+" style="x"><char style="xo" closed="false">4:31 </char><char style="xt" closed="false"><ref loc="EXO 14:31">निर्गमन १४:३१</ref>; <ref loc="JHN 2:11">यूहन्ना २:११</ref></char></note>अऊर उन्न न उन्को विश्वास करयो; अऊर यो सुन क कि परमेश्वर न इस्राएलियों की सुधि ली अऊर उन्को दु:खो पर नजर करी हय, उन्न अपनो मुंड झुकाय क आराधना करयो।<verse eid="EXO 4:31" /></para>
  <chapter eid="EXO 4" />
  <chapter number="5" style="c" sid="EXO 5" />
  <para style="s">फिरौन को जवर मूसा अऊर हारून</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 5:1" />तब मूसा अऊर हारून फिरौन को जवर गयो अऊर कह्यो, “इस्राएलियों को परमेश्वर यहोवा यो कह्य हय : ‘मोरी प्रजा ख जान दे, कि हि जंगल म मोरो सम्मान म त्यौहार मनाय सके’।” <verse eid="EXO 5:1" /><verse number="2" style="v" sid="EXO 5:2" />फिरौन न कह्यो, “परमेश्वर कौन आय कि मय ओको बात सुन क इस्राएलियों ख जान देऊं? मय परमेश्वर ख नहीं जानु हय, अऊर मय इस्राएलियों ख नहीं जान देऊं।” <verse eid="EXO 5:2" /><verse number="3" style="v" sid="EXO 5:3" />मूसा अऊर हारून न कह्यो, “इब्रियों को परमेश्वर न खुद हम सी मिल्यो हय; येकोलायी हम्ख जंगल म तीन दिन को रस्ता पर जान दे, कि अपनो परमेश्वर यहोवा लायी बलिदान चढ़ाबों, असो न हो कि ऊ हम्ख महामारी यां तलवार सी नाश करे।” <verse eid="EXO 5:3" /><verse number="4" style="v" sid="EXO 5:4" />मिस्र देश को राजा न मूसा अऊर हारून सी कह्यो, तुम लोगों ख उन्को काम सी दूर कहाली करनो चाहवय हय? तुम सब जावो अपनो-अपनो मेहनत को काम करो। <verse eid="EXO 5:4" /><verse number="5" style="v" sid="EXO 5:5" />अऊर फिरौन न कह्यो, “सुनो, यो देश म हि लोग मिस्र की जनता सी बहुत बढ़ गयो हंय, अब तुम उन्ख भारी काम सी आराम दिलानो चाहवय हय!” <verse eid="EXO 5:5" /><verse number="6" style="v" sid="EXO 5:6" />फिरौन राजा न उच दिन उन इस्राएली लोगों पर कठिन काम करावन वालो ख अऊर उन्को मुखिया ख यो आदेश दियो, <verse eid="EXO 5:6" /><verse number="7" style="v" sid="EXO 5:7" />“तुम जो अब तक ईटा बनान लायी लोगों ख भूसा दियो करत होतो, ऊ आगु ख मत देजो; हि खुदच जाय क अपनो लायी भूसा जमा करेंन। <verse eid="EXO 5:7" /><verse number="8" style="v" sid="EXO 5:8" />जितनी ईटा अब तक उन्ख बनानो पड़त होती उतनोच आगु ख भी उन्को सी बनवाजो, ईटा की गिनती कुछ भी कम मत करजो; कहालीकि हि आलसी भय गयो हंय, योच वजह सी हि मोख चिल्लाय क कहतो रह्य हय। हम्ख जान दे परमेश्वर को जवर बलिदान चढ़ान लायी। <verse eid="EXO 5:8" /><verse number="9" style="v" sid="EXO 5:9" />उन लोगों सी अऊर भी कठिन काम करवाजो जेको सी हि ओको म झुटो रहेंन अऊर मूसा अऊर हारून की झूठी बातों पर ध्यान नहीं देयेंन।”<verse eid="EXO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 5:10" />तब लोगों सी मेहनत करवावन वालो न अऊर इस्राएली मतलब इब्री मुखिया न बाहेर जाय क इस्राएलियों सी कह्यो, “फिरौन राजा असो कह्य हय, अब मय तुम्ख ईटा बनान लायी अऊर भूसा नहीं देऊं। <verse eid="EXO 5:10" /><verse number="11" style="v" sid="EXO 5:11" />तुम खुदच जावो, अऊर जित कहीं तुम्ख भूसा मिलेंन, उत सी जमा कर क् लावो; पर तुम्हरो काम म कुछ भी कमी नहीं आनो होना।” <verse eid="EXO 5:11" /><verse number="12" style="v" sid="EXO 5:12" />येकोलायी हि लोग भूसा को बदला खूटी ख ढ़ूंढ़न म पूरो मिस्र देश म फैल गयो। <verse eid="EXO 5:12" /><verse number="13" style="v" sid="EXO 5:13" />मेहनत करावन वालो उन्को सी जल्दी काम करन लायी कहत होतो, जसो तुम भूसा रहन पर करत होतो उच तरह अपनो हर दिन को काम अब भी पूरो करो। <verse eid="EXO 5:13" /><verse number="14" style="v" sid="EXO 5:14" />अऊर इस्राएलियों म सी जिन मुखियावों ख फिरौन को मेहनत करावन वालो न उन्को अधिकारी ठहरायो होतो, उन्न मार खायी अऊर उन्को सी पुच्छ्यो गयो, “जसो तुम अब तक करत होतो, वसो निश्चित गिनती म ईटा बनावन लायी कल अऊर अज तुम न अपनो काम कहाली नहीं करयो?”<verse eid="EXO 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 5:15" />तब इस्राएलियों को मुखिया न फिरौन राजा को जवर जाय क दोहायी दी, “तय अपनो दासों सी असो बर्ताव कहाली करय हय? <verse eid="EXO 5:15" /><verse number="16" style="v" sid="EXO 5:16" />तुम हम्ख कोयी भूसा देवय नहाय, तब भी हम सी कहतो रह्य हंय, ‘ईटा बनावो,’ अऊर अब हम्ख मार रह्यो हय; पर दोष तोरोच लोगों को हय।” <verse eid="EXO 5:16" /><verse number="17" style="v" sid="EXO 5:17" />फिरौन राजा न उत्तर दियो, “तुम आलसी हो, आलसी; योच वजह कह्य हय कि हम्ख परमेश्वर लायी बलिदान करन ख जान दे। <verse eid="EXO 5:17" /><verse number="18" style="v" sid="EXO 5:18" />अब जावो अऊर अपनो काम करो; अऊर तुम्ख भूसा नहीं दियो जायेंन, तब भी तुम्ख ईटा की गिनती पूरी करनो पड़ेंन।” <verse eid="EXO 5:18" /><verse number="19" style="v" sid="EXO 5:19" />जब इस्राएलियों को मुखिया न यो बात सुन्यो कि उन्की ईटों की गिनती कम नहीं होयेंन, अऊर हर दिन उतनोच काम पूरो करनो पड़ेंन जितनो पहिले करत होतो, तब हि जान गयो कि उन्को संकट को दिन आय गयो हंय। <verse eid="EXO 5:19" /><verse number="20" style="v" sid="EXO 5:20" />जब हि फिरौन राजा को जवर सी बाहेर निकल रह्यो होतो, तब मूसा अऊर हारून उन्को सी मिल्यो जो उत उन्को लायी रूक्यो होतो, <verse eid="EXO 5:20" /><verse number="21" style="v" sid="EXO 5:21" />अऊर उन्न मूसा अऊर हारून सी कह्यो, “परमेश्वर तुम पर नजर कर क् न्याय करे, कहालीकि तुम न हम ख फिरौन राजा अऊर ओको कर्मचारियों की नजर म दोषी ठहराय क हम्ख मार डालन लायी उन्को हाथ म तलवार दे दियो हय।”<verse eid="EXO 5:21" /></para>
  <para style="s">मूसा की परमेश्वर सी शिकायत</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 5:22" />तब मूसा न परमेश्वर को जवर वापस आय क कह्यो, “हे प्रभु, तय न यो प्रजा को संग बुरो व्यवहार कहाली करयो? तय न मोख इत कहाली भेज्यो? <verse eid="EXO 5:22" /><verse number="23" style="v" sid="EXO 5:23" />जब सी मय तोरो नाम सी फिरौन को जवर बाते करन लायी गयो, तब सी ओन यो प्रजा को संग बुरो व्यवहार करयो, अऊर तय न अपनो लोगों की कुछ भी मदत नहीं करयो।”<verse eid="EXO 5:23" /></para>
  <chapter eid="EXO 5" />
  <chapter number="6" style="c" sid="EXO 6" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 6:1" />तब परमेश्वर न मूसा सी कह्यो, “अब तय देखजो कि मय फिरौन राजा सी का करूं, अब तय ओख देखजो, ऊ मोरी महान शक्ति को वजह, अपनो देश सी निकाल देयेंन।”<verse eid="EXO 6:1" /></para>
  <para style="s">परमेश्वर को द्वारा मूसा ख बुलायो जानो</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 6:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:2 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 17:1">उत्पत्ति १७:१</ref>; <ref loc="GEN 28:3">२८:३</ref>; <ref loc="GEN 35:11">३५:११</ref>; <ref loc="EXO 3:13-15">निर्गमन ३:१३-१५</ref></char>
    </note>परमेश्वर न मूसा सी कह्यो, “मय यहोवा आय। <verse eid="EXO 6:2" /><verse number="3" style="v" sid="EXO 6:3" /><note caller="+" style="x"><char style="xo" closed="false">६:३ </char><char style="xt" closed="false"><ref loc="EXO 3:6">निर्गमन ३:६</ref>; <ref loc="GEN 3:14">उत्पत्ति ३:१४</ref>; <ref loc="GEN 4:26">४:२६</ref></char></note>मय सर्वशक्तिमान परमेश्वर को नाम सी अब्राहम, इसहाक, अऊर याकूब ख दर्शन देत होतो, पर परमेश्वर को नाम सी कभी अपनो आप ख उन पर प्रगट नहीं करयो। <verse eid="EXO 6:3" /><verse number="4" style="v" sid="EXO 6:4" /><note caller="+" style="x"><char style="xo" closed="false">६:४ </char><char style="xt" closed="false"><ref loc="GEN 15:18">उत्पत्ति १५:१८</ref>; <ref loc="GEN 17:7">१७:७</ref> </char></note>अऊर मय न उन्को संग अपनी वाचा करयो, कि मय उन्ख कनान देश देऊं, जेको म हि परदेशी होय क रहत होतो, ओख उन्ख दे देऊ। <verse eid="EXO 6:4" /><verse number="5" style="v" sid="EXO 6:5" />इस्राएलियों जिन्ख मिस्री लोग गुलाम बनाय क रख्यो होतो, उन्को चिल्लानो भी सुन क मय न अपनी वाचा ख याद करयो हय। <verse eid="EXO 6:5" /><verse number="6" style="v" sid="EXO 6:6" />येकोलायी तय इस्राएलियों सी कह्यजो, ‘मय परमेश्वर आय, अऊर तुम ख मिस्रियों को बोझां सी निकालू, अऊर उन्की गुलामी सी छुड़ाऊं, अऊर अपनो हाथ बढ़ाय क तुम्हरी रक्षा करूं, <verse eid="EXO 6:6" /><verse number="7" style="v" sid="EXO 6:7" />अऊर मय तुम ख अपनी प्रजा बनान लायी अपनाय लेऊं, अऊर मय तुम्हरो परमेश्वर ठहरूं; अऊर तुम जान लेवो कि मय तुम्हरो परमेश्वर यहोवा आय जो तुम्ख मिस्रियों को दबाव अऊर बोझ सी निकाल ले आयो, <verse eid="EXO 6:7" /><verse number="8" style="v" sid="EXO 6:8" />अऊर जो देश ख हाथ उठाय क देन की कसम मय न अब्राहम, इसहाक, अऊर याकूब सी खायी होती। ओको म मय तुम्ख पहुंचाय क ओख तुम्हरो अधिकार म कर देऊं। मय परमेश्वर आय’।” <verse eid="EXO 6:8" /><verse number="9" style="v" sid="EXO 6:9" />मूसा न इस्राएलियों ख यो बाते सुनायी, पर उन्न मन की बेचैनी अऊर गुलामी को वजह उन्की बाते नहीं सुन्यो।<verse eid="EXO 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 6:10" />तब परमेश्वर न मूसा सी कह्यो, <verse eid="EXO 6:10" /><verse number="11" style="v" sid="EXO 6:11" />“जावो अऊर मिस्र देश को राजा फिरौन सी कहजो इस्राएलियों ख ओको देश सी बाहेर जान दे।” <verse eid="EXO 6:11" /><verse number="12" style="v" sid="EXO 6:12" />पर मूसा न परमेश्वर सी कह्यो, “देख, इस्राएलियों न मोरी बात नहीं सुन्यो; तब फिरौन मोरी कसी बात सुनेंन? मय त बोलनो म लड़खड़ाऊ हय।” <verse eid="EXO 6:12" /><verse number="13" style="v" sid="EXO 6:13" />तब परमेश्वर न मूसा अऊर हारून ख आदेश दियो कि इस्राएलियों अऊर मिस्र देश को फिरौन राजा सी कहो, हि इस्राएली लोग मिस्र देश सी बाहेर निकाल ले जाये।<verse eid="EXO 6:13" /></para>
  <para style="s">मूसा अऊर हारून की वंशावली</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 6:14" />उन्को पूर्वजों को घराना को मुख्य आदमियों को नाम यो आय : इस्राएल को बड़ो बेटा रूबेन को टुरा: हनोक, पल्लू, हेस्रोन अऊर कर्मी; इन्को म सी रूबेन को वंश निकल्यो। <verse eid="EXO 6:14" /><verse number="15" style="v" sid="EXO 6:15" /><note caller="+" style="x"><char style="xo" closed="false">६:१५ </char><char style="xt" closed="false"><ref loc="GEN 46:10">उत्पत्ति ४६:१०</ref></char></note>शिमोन को छय टुरा होतो : यमूएल, यामीन, ओहद याकीन अऊर सोहर अऊर एक कनानी बाई को टुरा शाऊल होतो; इन्को सी शिमोन को वंश निकल्यो। <verse eid="EXO 6:15" /><verse number="16" style="v" sid="EXO 6:16" /><note caller="+" style="x"><char style="xo" closed="false">६:१६ </char><char style="xt" closed="false"><ref loc="NUM 3:17">गिनती ३:१७</ref>; <ref loc="GEN 46:8-11">उत्पत्ति ४६:८-११</ref></char></note>लेवी को तीन टुरा होतो : उन्की वंशावली को नाम यो आय : गेर्शोन, कहात अऊर मरारी; अऊर लेवी की पूरी उमर एक सौ सैतीस साल की हुयी। <verse eid="EXO 6:16" /><verse number="17" style="v" sid="EXO 6:17" />गेर्शोन को वंश अनुसार गेर्शोन को दोय टुरा होतो : लिबनी अऊर शिमी। <verse eid="EXO 6:17" /><verse number="18" style="v" sid="EXO 6:18" /><note caller="+" style="x"><char style="xo" closed="false">६:१८ </char><char style="xt" closed="false"><ref loc="NUM 26:57">गिनती २६:५७</ref>; <ref loc="1CH 6:18">१ इतिहास ६:१८</ref></char></note>कहात को चार टुरा होतो : अम्राम, यिसहार, हेब्रोन अऊर उज्जीएल। कहात की उमर एक सौ तैतीस साल की भयी। <verse eid="EXO 6:18" /><verse number="19" style="v" sid="EXO 6:19" />मरारी को दोय टुरा होतो : महली अऊर मूशी। लेवियों पीढ़ी जिन्कोसी उन्की वंशावली चली यो आय। <verse eid="EXO 6:19" /><verse number="20" style="v" sid="EXO 6:20" />अम्राम न अपनी फूफू योकेबेद सी बिहाव करयो अऊर ओको सी हारून अऊर मूसा पैदा भयो; अऊर अम्राम की पूरी उमर एक सौ सैतीस साल की भयी। <verse eid="EXO 6:20" /><verse number="21" style="v" sid="EXO 6:21" />यिसहार को तीन टुरा होतो : कोरह, नेपेग अऊर जिक्री। <verse eid="EXO 6:21" /><verse number="22" style="v" sid="EXO 6:22" />उज्जीएल को तीन टुरा होतो : मीशाएल, एलसाफन अऊर सित्री। <verse eid="EXO 6:22" /><verse number="23" style="v" sid="EXO 6:23" />हारून न अम्मीनादाब की टुरी अऊर नहशोन कि बहिन एलीशेबा सी बिहाव करयो; अऊर ओको सी नादाब, अबीहू, एलाजार अऊर ईतामार पैदा भयो। <verse eid="EXO 6:23" /><verse number="24" style="v" sid="EXO 6:24" />कोरह को तीन टुरा होतो : अस्सीर, एलकाना अऊर अबीआसाप; अऊर इन्को सी कोरह को वंश निकल्यो। <verse eid="EXO 6:24" /><verse number="25" style="v" sid="EXO 6:25" />हारून को टुरा एलाजार न पूतीएल की टुरी सी बिहाव करयो; अऊर ओको सी पीनहास पैदा भयो। इन्को सी उन्को वंश चल्यो। लेवियों को पूर्वजों को घरानों को मुख्य आदमी हिच आय।<verse eid="EXO 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 6:26" />हारून अऊर मूसा योच आय जिन्ख परमेश्वर न आज्ञा दी: “इस्राएलियों ख दल बनाय क मिस्र देश सी बाहेर निकाल लावो।” <verse eid="EXO 6:26" /><verse number="27" style="v" sid="EXO 6:27" />यो उच मूसा अऊर हारून हंय जिन्न मिस्र देश को राजा फिरौन सी कह्यो कि हम इस्राएलियों ख मिस्र देश सी निकाल ले जाबो।<verse eid="EXO 6:27" /></para>
  <para style="s">मूसा अऊर हारून ख परमेश्वर को आदेश</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 6:28" />जो दिन परमेश्वर न मूसा सी मिस्र देश म बाते करी,<verse eid="EXO 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 6:29" />ओन मूसा ख बतायो, “मय यहोवा आय; जो कुछ मय तोरो सी कहूं ऊ सब बात मिस्र देश को फिरौन राजा सी कह्यजो।” <verse eid="EXO 6:29" /><verse number="30" style="v" sid="EXO 6:30" />पर मूसा न परमेश्वर ख उत्तर दियो, “मय अच्छो तरह बोल नहीं सकू; अऊर फिरौन राजा मोरी बात कसी सुनेंन?”<verse eid="EXO 6:30" /></para>
  <chapter eid="EXO 6" />
  <chapter number="7" style="c" sid="EXO 7" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 7:1" />परमेश्वर न मूसा सी कह्यो, “अब देख, मय तोख फिरौन राजा को जसो परमेश्वर ठहराऊ हय; अऊर तोरो भाऊ हारून तोरो भविष्यवक्ता ठहरेंन। <verse eid="EXO 7:1" /><verse number="2" style="v" sid="EXO 7:2" />जो जो बात मय तुम्ख बताऊं, ऊ सब बात तुम हारून सी कह्यजो, अऊर हारून ऊ सब फिरौन राजा सी कहेंन, तब फिरौन राजा इस्राएलियों ख अपनो देश सी जान देयेंन। <verse eid="EXO 7:2" /><verse number="3" style="v" sid="EXO 7:3" /><note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="ACT 7:36">प्रेरितों ७:३६</ref></char></note>पर मय फिरौन राजा को मन ख कठोर कर देऊं, अऊर अपनो बहुत सी चिन्ह चमत्कार मिस्र देश म दिखाऊं। <verse eid="EXO 7:3" /><verse number="4" style="v" sid="EXO 7:4" />फिरौन राजा तुम्हरी नहीं सुनेंन; अऊर मय मिस्र देश पर अपनो हाथ उठाय क मिस्रियों ख भारी सजा दे क अपनी सेना मतलब अपनी इस्राएली प्रजा ख मिस्र देश सी निकालूं। <verse eid="EXO 7:4" /><verse number="5" style="v" sid="EXO 7:5" />अऊर जब मय मिस्र देश पर हाथ बढ़ाय क इस्राएलियों ख उन्को बीच सी निकालूं, तब मिस्री जान लेयेंन कि मय यहोवा आय।” <verse eid="EXO 7:5" /><verse number="6" style="v" sid="EXO 7:6" />मूसा अऊर हारून न परमेश्वर की आज्ञा को अनुसार करयो। <verse eid="EXO 7:6" /><verse number="7" style="v" sid="EXO 7:7" />जब हि फिरौन राजा सी बात करन लग्यो तब मूसा अस्सी साल, अऊर हारून तिरासी साल को होतो।<verse eid="EXO 7:7" /></para>
  <para style="s">हारून की लाठी</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 7:8" />तब परमेश्वर न मूसा अऊर हारून सी असो कह्यो,<verse eid="EXO 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 7:9" />“जब फिरौन राजा तुम सी कह्यो, ‘अपनो प्रमान को कोयी चमत्कार दिखान ख कहेंन,’ तब तय हारून सी कह्यजो, ‘अपनो लाठी ले क फिरौन राजा को आगु डाल दे कि हि सांप बन जायेंन’।” <verse eid="EXO 7:9" /><verse number="10" style="v" sid="EXO 7:10" />तब मूसा अऊर हारून न फिरौन राजा को जवर जाय क परमेश्वर की आज्ञा को अनुसार करयो; अऊर जब हारून न अपनी लाठी फिरौन अऊर ओको कर्मचारियों को आगु डाल दी, तब ऊ सांप बन गयो। <verse eid="EXO 7:10" /><verse number="11" style="v" sid="EXO 7:11" />तब फिरौन राजा न पण्डितों अऊर जादू टोना करन वालो ख बुलायो; अऊर मिस्र देश को जादूगरों न आय क अपनो तंत्र-मंत्र सी वसोच काम करयो। <verse eid="EXO 7:11" /><verse number="12" style="v" sid="EXO 7:12" />उन्न अपनी अपनी लाठी जमीन पर फेंक्यो त, वा भी सांप बन गयी। पर हारून की लाठी न उन सब की लाठीयों ख गिटक लियो। <verse eid="EXO 7:12" /><verse number="13" style="v" sid="EXO 7:13" />पर फिरौन राजा को मन अऊर हठीलो भय गयो, अऊर जसो परमेश्वर को वचन को अनुसार ओन मूसा अऊर हारून की बातों ख नहीं मान्यो।<verse eid="EXO 7:13" /></para>
  <para style="s">मिस्र पर विपत्तियां</para>
  <para style="s">खून बननो</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 7:14" />तब परमेश्वर न मूसा सी कह्यो, “फिरौन राजा को मन बहुत कठोर होय गयो हय अऊर ऊ मोरो लोगों ख जान नहीं देयेंन। <verse eid="EXO 7:14" /><verse number="15" style="v" sid="EXO 7:15" />येकोलायी सुबेरे फिरौन जब नदी को जवर आयेंन, तब तय ओको जवर जावो, तय नील नदी को किनार पर रस्ता देखजो जो लाठी सांप बन गयी होती, ओख अपनो हाथ म लेजो। <verse eid="EXO 7:15" /><verse number="16" style="v" sid="EXO 7:16" />अऊर राजा सी यो तरह कह्यजो, ‘इब्रियों मतलब इस्राएल को परमेश्वर यहोवा न मोख यो कहन लायी तोरो जवर भेज्यो हय कि मोरी प्रजा को लोगों ख जान देवो, जेकोसी हि सुनसान जागा म मोरी आराधना करेंन; अऊर अब तक तय न परमेश्वर की बातों ख नहीं मान्यो। <verse eid="EXO 7:16" /><verse number="17" style="v" sid="EXO 7:17" /><note caller="+" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="REV 16:4">प्रकाशितवाक्य १६:४</ref></char></note>परमेश्वर यो कह्य हय, येकोसी तय जान लेजो कि मयच परमेश्वर आय; मय अपनो हाथ की लाठी सी नील नदी को पानी पर मारूं, अऊर नील नदी को पानी खून म बन जायेंन, <verse eid="EXO 7:17" /><verse number="18" style="v" sid="EXO 7:18" />नील नदी की मच्छियां मर जायेंन, अऊर नदी म सी बास आन लगेन, अऊर मिस्री को लोग नील नदी सी पानी नहीं पी सकेंन’।” <verse eid="EXO 7:18" /><verse number="19" style="v" sid="EXO 7:19" />तब परमेश्वर न मूसा सी कह्यो, “हारून सी कह्यजो कि हि अपनी लाठी ले क मिस्र देश म जितनो पानी हय, मतलब ओकी नदियां, नहर झील, अऊर तलाव, सब को ऊपर अपनो हाथ बढ़ा कि उन्को पानी खून बन जाये; अऊर पूरो मिस्र देश म लकड़ी, गोटा अऊर कटोरा को पानी खून म बन जायेंन।”<verse eid="EXO 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 7:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:20 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:44">भजन ७८:४४</ref>; <ref loc="PSA 105:29">१०५:२९</ref></char>
    </note>तब मूसा अऊर हारून न परमेश्वर की आदेश को अनुसार करयो, मतलब ओन लाठी ख उठाय क फिरौन राजा अऊर ओको कर्मचारियों को देखतो हुयो, नील नदी को पानी पर मारयो, अऊर नदी को सब पानी खून बन गयो। <verse eid="EXO 7:20" /><verse number="21" style="v" sid="EXO 7:21" />नील नदी की मच्छियां मर गयी; अऊर नदी सी बास आन लग्यो, अऊर मिस्र देश को लोग नदी को पानी नहीं पी सक्यो; अऊर पूरो मिस्र देश म खूनच खून भय गयो। <verse eid="EXO 7:21" /><verse number="22" style="v" sid="EXO 7:22" />तब मिस्र देश को जादूगरों न भी अपनो तंत्र-मंत्रों सी वसोच करयो; तब भी फिरौन राजा को मन कठोर भय गयो, अऊर परमेश्वर को कहन को अनुसार ओन मूसा अऊर हारून की बात नहीं मानी। <verse eid="EXO 7:22" /><verse number="23" style="v" sid="EXO 7:23" />फिरौन राजा न यो पर भी ध्यान नहीं दियो, अऊर घर म चल्यो गयो। <verse eid="EXO 7:23" /><verse number="24" style="v" sid="EXO 7:24" />मिस्री लोग पानी पीवन लायी नील नदी को इत उत गड्डा खोदन लग्यो, कहालीकि हि नदी को पानी नहीं पी सकत होतो।<verse eid="EXO 7:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 7:25" />जब परमेश्वर न नील नदी ख मार क् पानी को खून बनाये सात दिन बीत चुक्यो होतो।<verse eid="EXO 7:25" /></para>
  <chapter eid="EXO 7" />
  <chapter number="8" style="c" sid="EXO 8" />
  <para style="s">दूसरी विपत्ति</para>
  <para style="s">मेंढ़कों को आक्रमन</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 8:1" />तब परमेश्वर न मूसा सी कह्यो, “फिरौन राजा को जवर जावो अऊर बोल, ‘परमेश्वर तोरो सी असो कह्य हय : मोरो लोगों ख जान दे कि हि मोरी आराधना कर सकय। <verse eid="EXO 8:1" /><verse number="2" style="v" sid="EXO 8:2" />पर यदि उन्ख जान नहीं देजो त सुन, मय मेंढकों ख भेज क तोरो पूरो देश ख हानि पहुंचान वालो हय। <verse eid="EXO 8:2" /><verse number="3" style="v" sid="EXO 8:3" />अऊर नील नदी मेंढकों सी भर जायेंन, मेंढका नदी म सी निकल क तुम्हरो घरों म, तुम्हरो बिस्तर पर, तुम्हरो सेवकों को घरों म अऊर पूरी प्रजा को घरों म भी भर जायेंन यहां तक कि तुम्हरो तन्दूरों म यां तुम्हरो आटा गूथन को बर्तन म भी भर जायेंन; <verse eid="EXO 8:3" /><verse number="4" style="v" sid="EXO 8:4" />तोरो अऊर तोरी प्रजा अऊर तोरो कर्मचारियों, सब को शरीर पर मेंढका चढ़ जायेंन’।”<verse eid="EXO 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 8:5" />तब परमेश्वर न मूसा सी कह्यो, “हारून सी कह्यजो कि नदियों, नहरों, अऊर झीलों को ऊपर लाठी को संग अपनो हाथ बढ़ा कि मेंढकों पूरो मिस्र देश पर चढ़ जाये।” <verse eid="EXO 8:5" /><verse number="6" style="v" sid="EXO 8:6" /><note caller="+" style="x"><char style="xo" closed="false">8:6 </char><char style="xt" closed="false"><ref loc="PSA 78:45">भजन ७८:४५</ref>; <ref loc="PSA 105:3">१०५:३</ref></char></note>तब हारून न मिस्र देश को झीलों पर हाथ बढ़ायो; अऊर मेंढकों न बाहेर निकल क पूरो मिस्र देश ख झाक दियो। <verse eid="EXO 8:6" /><verse number="7" style="v" sid="EXO 8:7" />अब जादूगर न भी अपनो तंत्र-मंत्रों सी वसोच मिस्र देश पर मेंढकों ख ले आये।<verse eid="EXO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 8:8" />फिरौन न मूसा अऊर हारून ख बुलाय क कह्यो, “अपनो परमेश्वर सी बिनती कर कि इन मेंढकों ख मोरो सी अऊर मोरी प्रजा सी दूर कर दे; अऊर मय इस्राएली लोगों ख जान देऊं। जेको सी हि परमेश्वर लायी बलिदान कर सकय।” <verse eid="EXO 8:8" /><verse number="9" style="v" sid="EXO 8:9" />मूसा न फिरौन राजा ख उत्तर दियो, “तय मोख आदेश दे कि अब मय तोरो, अऊर तोरो कर्मचारियों, अऊर तोरो लोगों लायी, कब बिनती करूं, कि परमेश्वर तोरो जवर सी अऊर तोरो घरों सी मेंढकों ख दूर करे, अऊर हि केवल नील नदी मच रहे।” <verse eid="EXO 8:9" /><verse number="10" style="v" sid="EXO 8:10" />फिरौन राजा न उत्तर दियो, “कल मोरो लायी प्रार्थना करो।” मूसा न कह्यो, “जसो तय कह्य हंय, वसोच होयेंन, जेकोसी तोख समझ आय जायेंन कि हमरो परमेश्वर को समान कोयी दूसरो नहाय। <verse eid="EXO 8:10" /><verse number="11" style="v" sid="EXO 8:11" />अऊर मेंढका तोरो जवर सी तोरो घरों म सी अऊर तोरो कर्मचारियों अऊर तुम्हरी प्रजा को जवर सी दूर कर दियो जायेंन अऊर केवल नील नदी म रहेंन।” <verse eid="EXO 8:11" /><verse number="12" style="v" sid="EXO 8:12" />तब मूसा अऊर हारून फिरौन राजा को जवर सी बाहेर चल्यो गयो; मूसा न मेंढकों को जान को बारे म परमेश्वर सी बिनती करी। जो राजा पर लायो होतो, <verse eid="EXO 8:12" /><verse number="13" style="v" sid="EXO 8:13" />परमेश्वर न मूसा को कहन को अनुसार करयो; अऊर मेंढका घरों, आंगनों, गावों अऊर खेतों को सब मेंढका मर गयो। <verse eid="EXO 8:13" /><verse number="14" style="v" sid="EXO 8:14" />तब लोगों न मरयो हुयो मेंढका ख एक तरफ जमा करयो, अऊर पूरो देश दुर्गन्ध सी भर गयो। <verse eid="EXO 8:14" /><verse number="15" style="v" sid="EXO 8:15" />जब फिरौन राजा न देख्यो कि मेंढका सब मर गयो अऊर परेशानी सब दूर भय गयी, ओन अपनो मन फिर सी कठोर कर क् मूसा अऊर हारून की बात नहीं सुनी, जसो परमेश्वर न कह्यो होतो।<verse eid="EXO 8:15" /></para>
  <para style="s">तिसरी विपत्ति</para>
  <para style="s">पिसवां को झुण्ड</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 8:16" />तब परमेश्वर न मूसा सी कह्यो, “हारून ख आज्ञा दे, ‘तय अपनो लाठी उठाय क जमीन की धूल पर मार, जेकोसी पूरो मिस्र देश म धूल मच्छर बन जाये’।” <verse eid="EXO 8:16" /><verse number="17" style="v" sid="EXO 8:17" />अऊर उन्न वसोच करयो; मतलब हारून न अपनो हाथ बढ़ाय क् लाठी ले क जमीन की धूल पर मारयो, तब मच्छरो न आदमी अऊर पशु दोयी ख पिसवा भय गयो, पूरो मिस्र देश म जमीन की धूल पिसवा बन गयो। <verse eid="EXO 8:17" /><verse number="18" style="v" sid="EXO 8:18" />जादूगरों न अपनो तंत्र-मंत्रों को द्वारा पिसवा ख लावन की कोशिश करी; पर नहीं कर पायो। यो तरह आदमी अऊर जनावरों दोयी पर मच्छर बन्यो रह्यो। <verse eid="EXO 8:18" /><verse number="19" style="v" sid="EXO 8:19" /><note caller="+" style="x"><char style="xo" closed="false">8:19 </char><char style="xt" closed="false"><ref loc="LUK 11:20">लूका ११:२०</ref></char></note>तब जादूगरों न फिरौन राजा सी कह्यो, “यो परमेश्वर को काम आय।”<note caller="+" style="f"><char style="fr" closed="false">8:19 </char><char style="ft" closed="false">उंगली हय</char></note> पर फिरौन राजा को मन कठोर भय गयो, ओन मूसा अऊर हारून की बात नहीं सुनी। जसो परमेश्वर न कह्यो होतो।<verse eid="EXO 8:19" /></para>
  <para style="s">चौथी विपत्ति</para>
  <para style="s">माखियों को झुण्ड</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 8:20" />तब परमेश्वर न मूसा सी कह्यो, “कल सुबेरे जल्दी उठ कर फिरौन राजा को जवर जावो जब ऊ नील नदी की तरफ जाये, तब ओको सी कह्यजो, ‘परमेश्वर तोरो सी यो कह्य हय : मोरो लोगों ख जान दे कि हि मोरी आराधना करेंन। <verse eid="EXO 8:20" /><verse number="21" style="v" sid="EXO 8:21" />यदि तय मोरो लोगों ख नहीं जान देजो त सुन, मय तोरो पर अऊर तोरो कर्मचारियों अऊर तोरो प्रजा पर, अऊर तोरो घरों म झुण्ड को झुण्ड माखी भेजूं, अऊर मिस्रियों को घर अऊर उन्को रहन को जागा भी माखियों सी भर जायेंन। <verse eid="EXO 8:21" /><verse number="22" style="v" sid="EXO 8:22" />पर ऊ दिन मय गोशेन देश ख जेको म मोरी प्रजा रह्य हय अलग करूं, अऊर ओख म माखियों को झुण्ड नहीं होयेंन; जेकोसी तय जान ले कि पूरी धरती पर मयच परमेश्वर आय। <verse eid="EXO 8:22" /><verse number="23" style="v" sid="EXO 8:23" />मय अपनो लोगों अऊर तोरी प्रजा को बीच अन्तर करूं। यो चिन्ह चमत्कार कल प्रगट होयेंन’।” <verse eid="EXO 8:23" /><verse number="24" style="v" sid="EXO 8:24" /><note caller="+" style="x"><char style="xo" closed="false">8:24 </char><char style="xt" closed="false"><ref loc="PSA 78:45">भजन ७८:४५</ref></char></note>अऊर परमेश्वर न वसोच करयो, फिरौन राजा को महल अऊर ओको कर्मचारियों को घरों म, अऊर पूरो मिस्र देश म माखियों सी झुण्ड को झुण्ड भर गयो, पूरो मिस्र देश माखियों को वजह नुकसान भय गयो।<verse eid="EXO 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 8:25" />तब फिरौन राजा न मूसा हारून ख बुलाय क कह्यो, “तुम जावो अऊर अपनो परमेश्वर लायी योच देश म बलिदान चढ़ावो।” <verse eid="EXO 8:25" /><verse number="26" style="v" sid="EXO 8:26" />मूसा न कह्यो, “असो करनो उचित नहीं होयेंन; कहालीकि हम अपनो परमेश्वर यहोवा लायी असी मिस्रियों को जनावर बलिदान करबोंन; जेक मिस्र को लोग घृणित समझय हय। मिस्रियों को देखतो असी बलिदान करबोंन त का हि हम पर गोटा नहीं मारेंन? <verse eid="EXO 8:26" /><verse number="27" style="v" sid="EXO 8:27" />हम सुनसान जागा म तीन दिन को रस्ता पर जाय क अपनो परमेश्वर यहोवा लायी जसो ऊ हम सी कहेंन वसोच बलिदान चढ़ाबों।” <verse eid="EXO 8:27" /><verse number="28" style="v" sid="EXO 8:28" />फिरौन न कह्यो, “मय तुम ख जान देऊं कि तुम अपनो परमेश्वर यहोवा लायी सुनसान जागा म बलिदान चढ़ावो; पर बहुत दूर मत जावो, अऊर तुम मोरो लायी प्रार्थना करो।” <verse eid="EXO 8:28" /><verse number="29" style="v" sid="EXO 8:29" />मूसा न उत्तर दियो, “सुन, मय तोरो जवर सी बाहेर जाय रह्यो हय। मय परमेश्वर सी प्रार्थना करूं कि माखियों को झुण्ड तोरो, कर्मचारियों, अऊर प्रजा को जवर सी कल दूर हो; पर फिरौन फिर कपट सी हम्ख परमेश्वर लायी बलिदान करन ख जान देन लायी मना नहीं करे।” <verse eid="EXO 8:29" /><verse number="30" style="v" sid="EXO 8:30" />मूसा फिरौन राजा को जवर सी निकल्यो अऊर परमेश्वर सी प्रार्थना करी। <verse eid="EXO 8:30" /><verse number="31" style="v" sid="EXO 8:31" />अऊर परमेश्वर न मूसा को कहन को अनुसार माखियों को झुण्डों ख फिरौन, अऊर ओको कर्मचारियों, अऊर ओकी प्रजा सी दूर करयो; अऊर एक भी मक्खी नहीं रही। <verse eid="EXO 8:31" /><verse number="32" style="v" sid="EXO 8:32" />पर फिरौन राजा न यो बार भी अपनो मन कठोर कर लियो, अऊर फिर ओन लोगों ख जान नहीं दियो।<verse eid="EXO 8:32" /></para>
  <chapter eid="EXO 8" />
  <chapter number="9" style="c" sid="EXO 9" />
  <para style="s">पाचवी विपत्ति</para>
  <para style="s">जनावर की मृत्यु</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 9:1" />तब परमेश्वर न मूसा सी कह्यो, “फिरौन राजा को जवर जाय क कह्य, ‘इब्रियों को परमेश्वर यहोवा न यो कह्य हय कि, मोरी प्रजा ख यहां सी जान देवो कि हि मोरी आराधना करेंन। <verse eid="EXO 9:1" /><verse number="2" style="v" sid="EXO 9:2" />यदि तय उन्ख नहीं जान देजो अऊर उन्ख अब भी पकड़्यो रखजो, <verse eid="EXO 9:2" /><verse number="3" style="v" sid="EXO 9:3" />त देख, तोरो जो घोड़ा, गधा, ऊंट, गाय-बईल, मेंढी-शेरी, अऊर जो जनावर मैदान म हंय, उन पर परमेश्वर को हाथ असो पड़ेंन कि एक भयानक महामारी फैलेंन। <verse eid="EXO 9:3" /><verse number="4" style="v" sid="EXO 9:4" />पर परमेश्वर इस्राएलियों को जनावर अऊर मिस्रियों को जनावर को बीच असो अन्तर कर देयेंन अऊर कोयी भी जनावर इस्राएलियों को नहीं मरेंन’।” <verse eid="EXO 9:4" /><verse number="5" style="v" sid="EXO 9:5" />तब परमेश्वर न एक समय ठहरायो, अऊर कह्यो, “मय यो काम कल मिस्र देश म करूं।” <verse eid="EXO 9:5" /><verse number="6" style="v" sid="EXO 9:6" /><note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="PSA 78:50">भजन ७८:५०</ref></char></note>दूसरो दिन परमेश्वर न असोच करयो; अऊर मिस्र देश को पूरो जनावर मर गयो, पर इस्राएलियों को एक भी जनावर नहीं मरयो। <verse eid="EXO 9:6" /><verse number="7" style="v" sid="EXO 9:7" />अऊर फिरौन राजा न लोगों ख देखन भेज्यो, पर इस्राएलियों को एक भी जनावर नहीं मरयो होतो। तब भी फिरौन राजा को मन कठोर भय गयो, अऊर ओन इस्राएलियों ख जान नहीं दियो।<verse eid="EXO 9:7" /></para>
  <para style="s">छटवी विपत्ति</para>
  <para style="s">फफोलों अऊर फोड़ा को निकलनो</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 9:8" />फिर परमेश्वर न मूसा अऊर हारून सी कह्यो, “तुम भट्ठी सी मुट्टी भर राख लेवो, अऊर मूसा ओख फिरौन राजा को आगु राखड़ ख आसमान को तरफ उड़ाय देयेंन। <verse eid="EXO 9:8" /><verse number="9" style="v" sid="EXO 9:9" /><note caller="+" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="REV 16:2">प्रकाशितवाक्य १६:२</ref></char></note>तब राख धूल बन क पूरो मिस्र देश म आदमियों अऊर जनावर पर फोड़ा बन जायेंन।” <verse eid="EXO 9:9" /><verse number="10" style="v" sid="EXO 9:10" /><note caller="+" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="REV 16:2">प्रकाशितवाक्य १६:२</ref></char></note>येकोलायी उन्न भट्ठी म की मुट्ठी भर राख उठायी, अऊर हि फिरौन को आगु खड़ो भयो, अऊर मूसा न हवा म आसमान को तरफ राखड़ उड़ाय दियो, अऊर वहां आदमियों अऊर जनावर पर फफोंला अऊर फोड़ा बन गयो। <verse eid="EXO 9:10" /><verse number="11" style="v" sid="EXO 9:11" />येकोलायी उन जादूगर फोड़ा को वजह मूसा को आगु खड़ो नहीं भय सक्यो। कहालीकि पूरो मिस्रियों अऊर जादूगरों को शरीर पर भी फोड़ा भय गयो होतो। <verse eid="EXO 9:11" /><verse number="12" style="v" sid="EXO 9:12" />पर परमेश्वर न फिरौन को मन ख कठोर कर दियो, जसो परमेश्वर न मूसा सी कह्यो होतो, ओन उन्की नहीं सुनी।<verse eid="EXO 9:12" /></para>
  <para style="s">सातवी विपत्ति</para>
  <para style="s">गारगोटी की बारीश</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 9:13" />तब परमेश्वर न मूसा सी कह्यो, “कल सुबेरे उठ क फिरौन राजा को जवर जाय क यो कह्यजो की, ‘इब्रियों को परमेश्वर यहोवा यो कह्य हय : मोरो लोगों ख जान देवो कि हि मोरी आराधना कर सके। <verse eid="EXO 9:13" /><verse number="14" style="v" sid="EXO 9:14" />कहालीकि अब की बार मय तोरो पर<note caller="+" style="f"><char style="fr" closed="false">9:14 </char><char style="ft" closed="false">तोरो दिल पर</char></note>, अऊर तोरो कर्मचारियों पर अऊर तोरी प्रजा पर विपत्तियां डालूं, जेकोसी तय जान लेजो की पूरो धरती पर मोरो जसो दूसरो कोयी भी नहाय। <verse eid="EXO 9:14" /><verse number="15" style="v" sid="EXO 9:15" />मय न त अभी हाथ बढ़ाय क तोख अऊर तोरी प्रजा ख महामारियों सी मारयो होतो, अऊर धरती पर सी तोरो सत्यानाश भय गयो होतो। <verse eid="EXO 9:15" /><verse number="16" style="v" sid="EXO 9:16" /><note caller="+" style="x"><char style="xo" closed="false">9:16 </char><char style="xt" closed="false"><ref loc="ROM 9:17">रोमियों ९:१७</ref></char></note>पर मय न सचमुच तोख योच उद्देश सी येकोलायी जीन्दो रख्यो हय कि मय तोख अपनी सामर्थ दिखाऊं, अऊर मोरो नाम पूरी धरती म प्रसिद्ध हो जाये। <verse eid="EXO 9:16" /><verse number="17" style="v" sid="EXO 9:17" />फिर तुम अब भी मोरी प्रजा को सामने अपनो आप ख बड़ो समझय हय, अऊर उन्ख जान नहीं देवय हय? <verse eid="EXO 9:17" /><verse number="18" style="v" sid="EXO 9:18" />सुन, कल मय योच समय असो भारी गारगोटियों की भयंकर बारीश बरसाऊं; जसो मिस्र देश की स्थापना को दिन सी अब तक नहीं भयी हय। <verse eid="EXO 9:18" /><verse number="19" style="v" sid="EXO 9:19" />येकोलायी अब लोगों ख भेज क अपनो सब जनावर ख अऊर तोरो जवर खुलो मैदानी क्षेत्र म हय, सब ख सुरक्षित जागा पर लिजाय क रख्यो जाये; नहीं त जितनो आदमी यां जनावर मैदान म असुरक्षित रह्य गयो हय, उन्ख घरों म नहीं जमा करयो जाये, नहीं त उन पर गारगोटी गिरेंन, अऊर हि मर जायेंन’।” <verse eid="EXO 9:19" /><verse number="20" style="v" sid="EXO 9:20" />येकोलायी फिरौन को कुछ कर्मचारियों म सी जो लोग परमेश्वर को वचन को डर मानत होतो, उन्न अपनो अपनो सेवकों अऊर जनावर ख आसरा लेन लायी घरों को अन्दर ले आये। <verse eid="EXO 9:20" /><verse number="21" style="v" sid="EXO 9:21" />पर जिन्न परमेश्वर को वचन पर ध्यान नहीं लगायो उन्न अपनो सेवक अऊर जनावर ख मैदान मच रहन दियो। <verse eid="EXO 9:21" /><verse number="22" style="v" sid="EXO 9:22" />तब परमेश्वर न मूसा सी कह्यो, “अपनो हाथ आसमान की तरफ बढ़ा कि पूरो मिस्र देश को आदमियों, जनावरों, अऊर खेतो की पूरी हरियाली फसल पर गारगोटी गिरें।” <verse eid="EXO 9:22" /><verse number="23" style="v" sid="EXO 9:23" /><note caller="+" style="x"><char style="xo" closed="false">9:23 </char><char style="xt" closed="false"><ref loc="PSA 78:47">भजन ७८:४७</ref>; <ref loc="REV 8:7">प्रकाशितवाक्य ८:७</ref>; <ref loc="REV 16:21">१६:२१</ref></char></note>तब मूसा न अपनी लाठी आसमान को तरफ उठायो, अऊर परमेश्वर की सामर्थ सी बादर गर्जन लग्यो अऊर गारगोटी गिरन लगी अऊर बीजली भी धरती पर चमकन लगी। यो तरह परमेश्वर न मिस्र देश पर गारगोटी की बारीश करी। <verse eid="EXO 9:23" /><verse number="24" style="v" sid="EXO 9:24" />जो गारगोटी को संग बीजली भी गिरत होती, मिस्र देश म असी गारगोटी की बारीश पहिले कभी नहीं गीरी होती। <verse eid="EXO 9:24" /><verse number="25" style="v" sid="EXO 9:25" />गारगोटी न पूरो मिस्र देश को आदमियों अऊर जनावरों ख जो मैदान म होतो, नाश कर दियो। गारगोटी सी खेत की पूरी फसल नाश भय गयी, अऊर मैदान को सब झाड़ भी टूट गयो। <verse eid="EXO 9:25" /><verse number="26" style="v" sid="EXO 9:26" />केवल गोशेन प्रदेश म, जित इस्राएली रहत होतो गारगोटी की बारीश नहीं भयी। <verse eid="EXO 9:26" /><verse number="27" style="v" sid="EXO 9:27" />तब फिरौन राजा न मूसा अऊर हारून ख बुलायो, अऊर फिरौन न उन्को सी कह्यो, “मय न यो बार पाप करयो हय; परमेश्वर सच्चो हय, मय अऊर मोरी प्रजा झूठी हय। <verse eid="EXO 9:27" /><verse number="28" style="v" sid="EXO 9:28" />परमेश्वर सी प्रार्थना करो। बादर को गर्जनों अऊर गारगोटी को बरसनो त बहुत भय गयो; अब तुम परमेश्वर सी बिनती करो; तब मय तुम लोगों ख जान देऊं, तुम लोगों ख यहां नहीं रोकूं।” <verse eid="EXO 9:28" /><verse number="29" style="v" sid="EXO 9:29" />मूसा न फिरौन सी कह्यो, “जसोच मय नगर सी बाहेर जाऊं परमेश्वर की तरफ अपनो हाथ फैलाऊं, तब बादर को गर्जनों बन्द होय जायेंन अऊर गारगोटी फिर नहीं गिरेंन, जेको सी तय जान जाजो कि धरती परमेश्वर कीच आय। <verse eid="EXO 9:29" /><verse number="30" style="v" sid="EXO 9:30" />तब भी मय जानु हय कि नहीं त तय अऊर नहीं तोरो कर्मचारी यहोवा परमेश्वर को डर नहीं मानय।” <verse eid="EXO 9:30" /><verse number="31" style="v" sid="EXO 9:31" />सन अऊर अलसी की फसल बरबाद भय गयी, कहालीकि जौ की लोंब निकल गयी होती अऊर सन म कली अऊर फूल लग्यो होतो। <verse eid="EXO 9:31" /><verse number="32" style="v" sid="EXO 9:32" />पर कोयी भी गहूं अऊर कठिया गहूं नाश नहीं भयो, कहालीकि ऊ बाद म पकय हय। <verse eid="EXO 9:32" /><verse number="33" style="v" sid="EXO 9:33" />जब मूसा फिरौन राजा को जवर सी नगर को बाहेर निकल गयो अऊर परमेश्वर की तरफ अपनो हाथ फैलाय क प्रार्थना करयो, अऊर तुरतच बादर को गर्जनों अऊर गारगोटी को गिरनो बन्द भयो, फिर धरती पर बारीश नहीं भयी। <verse eid="EXO 9:33" /><verse number="34" style="v" sid="EXO 9:34" />जब फिरौन राजा न देख्यो कि बारीश अऊर गारगोटी अऊर बादर को गर्जनों बन्द होय गयो, तब ओन फिर सी पाप करयो। ओन अऊर ओको सेवकों न अपनो मन कठोर कर लियो। <verse eid="EXO 9:34" /><verse number="35" style="v" sid="EXO 9:35" />फिरौन राजा को मन कठोर होतो गयो, अऊर ओन इस्राएलियों ख जान नहीं दियो, जसो कि परमेश्वर न मूसा को द्वारा कह्यो होतो।<verse eid="EXO 9:35" /></para>
  <chapter eid="EXO 9" />
  <chapter number="10" style="c" sid="EXO 10" />
  <para style="s">आठवी विपत्ति</para>
  <para style="s">फाफावों को आक्रमन</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 10:1" />तब परमेश्वर न मूसा सी कह्यो, “फिरौन राजा को जवर जावो; कहालीकि मय नच ओको अऊर ओको कर्मचारियों को मन कठोर कर दियो हय कि उन्को बीच म अपनो चिन्ह चमत्कार ख दिखाऊं; <verse eid="EXO 10:1" /><verse number="2" style="v" sid="EXO 10:2" /><note caller="+" style="x"><char style="xo" closed="false">10:2 </char><char style="xt" closed="false"><ref loc="DEU 4:9">व्यवस्थाविवरन ४:९</ref>; <ref loc="PSA 44:1">भजन ४४:१</ref></char></note>अऊर तुम अपनो बेटों अऊर नातियों सी येको वर्णन करो कि परमेश्वर न मिस्रवासियों ख कसो ठट्ठा म उड़ायो अपनो का का चिन्ह चमत्कार उन्को बीच म प्रगट करयो हय; जेकोसी तुम यो जान लेवो कि मय परमेश्वर आय।” <verse eid="EXO 10:2" /><verse number="3" style="v" sid="EXO 10:3" />मूसा अऊर हारून फिरौन को जवर जाय क कह्यो, “इब्रियों को परमेश्वर यहोवा तोरो सी असो कह्य हय, ‘तय कब तक मोरो आगु नम्र होन सी संकोच करतो रहजो? मोरो लोगों ख जान नहीं दे, कि हि मोरी आराधना कर सके। <verse eid="EXO 10:3" /><verse number="4" style="v" sid="EXO 10:4" />यदि तय मोरी लोगों ख जान नहीं देजो त, कल मय तोरो देश पर फाफावों<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft" closed="false">टिड्डियां </char></note> ख ले आऊं, <verse eid="EXO 10:4" /><verse number="5" style="v" sid="EXO 10:5" />अऊर फाफावों पूरो जमीन ख असो झाक लेयेंन कि वा कोयी ख दिखायी नहीं पड़ेंन; अऊर जो कुछ गारगोटी सी बच गयो हय ओख हि खाय जायेंन, अऊर तुम्हरो जितनो मैदान म लग्यो हय उन्को भी हि चट कर देयेंन, <verse eid="EXO 10:5" /><verse number="6" style="v" sid="EXO 10:6" />अऊर हि तोरो अऊर तोरो पूरो कर्मचारियों, यहां तक कि पूरो मिस्रियों को घरों म भर जायेंन; इतनो फाफावों ख तोरो बाप दादों न यां उन्को पूर्वजों न जब सी धरती पर जनम्यो तब सी अज तक कभी नहीं देख्यो।’” तब मूसा मुड़ क फिरौन को जवर सी बाहेर चली गयो।<verse eid="EXO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 10:7" />तब फिरौन राजा को कर्मचारियों न फिरौन सी कह्यो, “ऊ आदमी कब तक हमरो लायी मुसीबत बन्यो रहेंन? इस्राएलियों ख जान दे कि हि अपनो परमेश्वर यहोवा की आराधना कर सकय। का तय अब भी नहीं जानय कि पूरो मिस्र देश नाश भय गयो हय?” <verse eid="EXO 10:7" /><verse number="8" style="v" sid="EXO 10:8" />मूसा अऊर हारून फिरौन राजा को जवर वापस लायो गयो। अऊर फिरौन राजा न उन्को सी कह्यो, “चली जावो, अपनो परमेश्वर यहोवा की आराधना करो; पर जो जान वालो हय, हि लोग कौन-कौन आय?” <verse eid="EXO 10:8" /><verse number="9" style="v" sid="EXO 10:9" />मूसा न उत्तर दियो, “हम त पूरो बेटा-बेटियां, मेंढी-शेरियां, गाय-बईलों समेत बल्कि बच्चा सी बूढ्ढा तक सब जाबोन, कहालीकि हम्ख परमेश्वर लायी त्यौहार मनानो हय।” <verse eid="EXO 10:9" /><verse number="10" style="v" sid="EXO 10:10" />फिरौन राजा न यो तरह उन्को सी कह्यो, “परमेश्वर तुम्हरो संग रहे यदि मय तुम्ख बच्चां समेत जान देऊ हय; त देखो, तुम्हरो मन म बुरायी हय। <verse eid="EXO 10:10" /><verse number="11" style="v" sid="EXO 10:11" />नहीं! असो नहीं होय सकेंन; तुम आदमीच जावो अऊर परमेश्वर की आराधना करो। तुम असोच त चाहत होतो।” मूसा अऊर हारून ख फिरौन को आगु सी निकाल दियो गयो।<verse eid="EXO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 10:12" />तब परमेश्वर न मूसा सी कह्यो, “मिस्र देश को तरफ अपनो हाथ उठाय क कि फाफावों को झुण्ड मिस्र देश पर चढ़ क् जमीन को जितनो अनाज आदि गारगोटी सी बच्यो हय सब खाय जाये।” <verse eid="EXO 10:12" /><verse number="13" style="v" sid="EXO 10:13" />जब मूसा न मिस्र देश की तरफ अपनी लाठी उठायी, तब परमेश्वर न पूरो मिस्र देश पर पूरो दिन अऊर रात पूर्व दिशा की हवा चलायी; अऊर जब भुन्सारे भयी तब ऊ हवा को संग फाफावों को झुण्ड भी आयो। <verse eid="EXO 10:13" /><verse number="14" style="v" sid="EXO 10:14" /><note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="PSA 78:40">भजन ७८:४०</ref>; <ref loc="PSA 105:34">१०५:३४</ref>; <ref loc="REV 9:2">प्रकाशितवाक्य ९:२</ref></char></note>अऊर फाफावों न चढ़ क पूरो मिस्र देश म फैल गयो। उन्को झुण्ड बहुत बड़ो होतो, उन सी पहले असो फाफा नहीं आयो होतो, अऊर नहीं उन्को बाद असी कभी आयेंन। <verse eid="EXO 10:14" /><verse number="15" style="v" sid="EXO 10:15" />हि त फाफावों न जमीन ख असो झाक दियो, कि पूरो देश म अन्धारो छाय गयो। उन्न देश को पूरो पौधों ख, अऊर झाड़ को फरों ख, उन्को पूरो अनाज जो कुछ गारगोटी की बारीश सी बच्यो होतो, सब ख खाय लियो; पूरो मिस्र देश म कोयी भी हरी चिज नहीं बची, अऊर मैदान को पौधा अऊर झाड़ नहीं। <verse eid="EXO 10:15" /><verse number="16" style="v" sid="EXO 10:16" />तब फिरौन न तुरतच मूसा अऊर हारून ख बुलाय क अऊर उन्को सी कह्यो, “मय न तुम्हरो परमेश्वर यहोवा को अऊर तुम्हरो भी खिलाफ पाप करयो हय। <verse eid="EXO 10:16" /><verse number="17" style="v" sid="EXO 10:17" />अब मोरो पाप ख एक बार अऊर माफ करो, अऊर अपनो परमेश्वर यहोवा सी बिनती करो कि ऊ मोरो ऊपर सी मृत्यु दण्ड ख दूर करे।” <verse eid="EXO 10:17" /><verse number="18" style="v" sid="EXO 10:18" />मूसा फिरौन राजा को जवर सी बाहेर चल्यो गयो अऊर परमेश्वर सी प्रार्थना करी। <verse eid="EXO 10:18" /><verse number="19" style="v" sid="EXO 10:19" />तब परमेश्वर न पूर्व को हवा ख बदल क बहुत भयानक पश्चिम हवा बहायो अऊर फाफावों ख उड़ाय क लाल समुन्दर म डाल दियो, अऊर मिस्र देश को कोयी जागा म एक भी फाफा नहीं रह्यो। <verse eid="EXO 10:19" /><verse number="20" style="v" sid="EXO 10:20" />पर परमेश्वर न फिरौन राजा ख कठोर बनाय दियो, अऊर ओन इस्राएलियों ख जान नहीं दियो।<verse eid="EXO 10:20" /></para>
  <para style="s">नववी विपत्ति</para>
  <para style="s">अन्धकार</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 10:21" />तब परमेश्वर न मूसा सी कह्यो, “अपनो हाथ आसमान की तरफ उठा कि मिस्र देश पर असो अन्धारो छाय जाये, कि टटोल्यो जाय सके।” <verse eid="EXO 10:21" /><verse number="22" style="v" sid="EXO 10:22" /><note caller="+" style="x"><char style="xo" closed="false">10:22 </char><char style="xt" closed="false"><ref loc="PSA 105:28">भजन १०५:२८</ref>; <ref loc="REV 16:10">प्रकाशितवाक्य १६:१०</ref></char></note>तब मूसा न अपनो हाथ आसमान की तरफ बढ़ायो, अऊर पूरो मिस्र देश पर तीन दिन तक घोर अन्धारो छायो रह्यो। <verse eid="EXO 10:22" /><verse number="23" style="v" sid="EXO 10:23" />मिस्र निवासी तीन दिन तक कोयी ख नहीं देख सक्यो, अऊर नहीं कोयी अपनी जागा सी उठ्यो; पर पूरो इस्राएलियों को घरों म उजाड़ो होतो। <verse eid="EXO 10:23" /><verse number="24" style="v" sid="EXO 10:24" />तब फिरौन राजा न मूसा ख बुलाय क कह्यो, “तुम जावो, अऊर परमेश्वर की आराधना करो; अपनो संग बच्चा ख भी ले जावो; केवल अपनी शेरी-मेंढियों अऊर गाय-बईल ख छोड़ जावो।” <verse eid="EXO 10:24" /><verse number="25" style="v" sid="EXO 10:25" />मूसा न कह्यो, “तोख हमरो हाथ म मेलबलि अऊर होमबलि को जनावर भी देनो पड़ेंन, जिन्ख हम अपनो परमेश्वर यहोवा लायी बलिदान चढ़ायबो। <verse eid="EXO 10:25" /><verse number="26" style="v" sid="EXO 10:26" />येकोलायी हमरो जनावर भी हमरो संग जायेंन, उन्की एक खुरी भी नहीं रह्य जायेंन, हम अपनो परमेश्वर की आराधना लायी उन्ख अपनो संग ले जाबोंन, जब तक हम उत नहीं पहुंच जाय, तब तक नहीं जानजे कि हम अपनो परमेश्वर की आराधना कसो करबोंन।” <verse eid="EXO 10:26" /><verse number="27" style="v" sid="EXO 10:27" />पर परमेश्वर न फिरौन राजा को मन कठोर कर दियो, अऊर ऊ उन्ख जान नहीं दियो। <verse eid="EXO 10:27" /><verse number="28" style="v" sid="EXO 10:28" />तब फिरौन राजा न मूसा सी कह्यो, “मोरो आगु सी निकल जा; अऊर सावधान रह्य; मोख अपनो मुंह फिर मत दिखाजो; कहालीकि जो दिन तय मोख मुंह दिखाजो, ओन दिन तय मारयो जाजो।” <verse eid="EXO 10:28" /><verse number="29" style="v" sid="EXO 10:29" />तब मूसा न फिरौन राजा सी कह्यो, “तय न ठीक कह्यो हय; मय तोरो मुंह ख फिर कभी नहीं देखूं।”<verse eid="EXO 10:29" /></para>
  <chapter eid="EXO 10" />
  <chapter number="11" style="c" sid="EXO 11" />
  <para style="s">दसवी विपत्ति</para>
  <para style="s">आखरी विपत्ति की चेतावनी</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 11:1" />तब परमेश्वर न मूसा सी कह्यो, “मय एक अऊर विपत्ति फिरौन राजा अऊर मिस्र पर लाऊं, ओको बाद तुम लोगों ख इत सी जान देयेंन; अऊर जब ऊ जान देयेंन तब तुम सब ख जरूरच निकाल देयेंन। <verse eid="EXO 11:1" /><verse number="2" style="v" sid="EXO 11:2" />अब तय मोरो इस्राएली लोगों मोरी या आज्ञा सुनाव कि हर एक आदमी अऊर बाई अपनो पड़ोसिन सी सोनो-चांदी को जेवर मांग ले।” <verse eid="EXO 11:2" /><verse number="3" style="v" sid="EXO 11:3" /><note caller="+" style="x"><char style="xo" closed="false">11:3 </char><char style="xt" closed="false"><ref loc="EXO 3:21">निर्गमन ३:२१</ref></char></note>तब परमेश्वर न मिस्रियों पर दया करी। येको अलावा मूसा मिस्र देश म फिरौन राजा को कर्मचारियों अऊर साधारन लोगों की नजर म अति महान होतो। <verse eid="EXO 11:3" /><verse number="4" style="v" sid="EXO 11:4" />तब मूसा न फिरौन सी कह्यो, “परमेश्वर यो कह्य हय, मय अरधी रात को लगभग मय मिस्र देश को बीच म सी होय क चलूं। <verse eid="EXO 11:4" /><verse number="5" style="v" sid="EXO 11:5" />तब मिस्र म सिंहासन पर विराजन वालो फिरौन सी ले क चक्की पीसन वाली दासी तक को बड़ो टुरा; अऊर जनावर तक को सब पहिलौठा मर जायेंन। <verse eid="EXO 11:5" /><verse number="6" style="v" sid="EXO 11:6" />अऊर पूरो मिस्र देश म बड़ो हाहाकार मचेंन, यहां तक कि ओको जसो नहीं त कभी भयो अऊर नहीं होयेंन। <verse eid="EXO 11:6" /><verse number="7" style="v" sid="EXO 11:7" />पर इस्राएलियों को खिलाफ, का आदमी का जनावर, कोयी पर कोयी कुत्ता भी नहीं भूकेंन; जेकोसी तुम जान लेवो कि मिस्रियों अऊर इस्राएलियों म मय परमेश्वर भेद करू हय। <verse eid="EXO 11:7" /><verse number="8" style="v" sid="EXO 11:8" />तब तोरो यो सब कर्मचारी मोरो जवर आय क प्रणाम कर क् यो कहेंन, ‘अपनो सब लोगों समेत निकल जावो।’ अऊर ओको बाद मय भी निकल जाऊं।” यो कह्य क मूसा बड़ो गुस्सा सी फिरौन को जवर सी निकल गयो।<verse eid="EXO 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 11:9" />परमेश्वर न मूसा सी कह्य दियो होतो, “फिरौन तुम्हरी बाते नहीं सुनेंन; कहालीकि मय मिस्र देश म बहुत सो चमत्कार करूं।” <verse eid="EXO 11:9" /><verse number="10" style="v" sid="EXO 11:10" />मूसा अऊर हारून न फिरौन राजा को आगु यो सब चमत्कार करयो; पर परमेश्वर न फिरौन को दिल ख अऊर कठोर कर दियो, येकोलायी ओन इस्राएलियों ख अपनो देश सी जान नहीं दियो।<verse eid="EXO 11:10" /></para>
  <chapter eid="EXO 11" />
  <chapter number="12" style="c" sid="EXO 12" />
  <para style="s">फसह को त्यौहार</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 12:1" />तब परमेश्वर न मिस्र देश म मूसा अऊर हारून सी कह्यो, <verse eid="EXO 12:1" /><verse number="2" style="v" sid="EXO 12:2" />“यो महीना तुम लोगों लायी सुरूवात को साल को पहिलो महीना ठहरे। <verse eid="EXO 12:2" /><verse number="3" style="v" sid="EXO 12:3" />इस्राएल की पूरी मण्डली सी यो कहो की; यो महीना को दसवों दिन ख तुम अपनो पूर्वजों को घराना को अनुसार, एक एक मेम्ना ले रखो; <verse eid="EXO 12:3" /><verse number="4" style="v" sid="EXO 12:4" />अऊर यदि कोयी को घराना म एक मेम्ना ख खान लायी आदमी कम हो, त ऊ अपनो सब सी जवर रहन वालो पड़ोसी को संग प्रानियों की गिनती को अनुसार एक मेम्ना ले रखो; अऊर तुम हर एक को खान को अनुसार मेम्नों को हिसाब करजो। <verse eid="EXO 12:4" /><verse number="5" style="v" sid="EXO 12:5" /><note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="LEV 22:19">लैव्यव्यवस्था २२:१९</ref>; <ref loc="1PE 1:19">१ पतरस १:१९</ref></char></note>तुम्हरो मेम्ना निर्दोष अऊर एक साल को नर हो, अऊर ओख चाहे मेंढी म सी लेना चाहे शेरी म सी। <verse eid="EXO 12:5" /><verse number="6" style="v" sid="EXO 12:6" />अऊर यो महीना को चौदा दिन तक ओको ध्यान रखजो, अऊर ओख शाम ख इस्राएल की पूरी मण्डली को लोग ओख बलिदान करे। <verse eid="EXO 12:6" /><verse number="7" style="v" sid="EXO 12:7" />तब हि ओको खून म सी कुछ ले क जिन घरों म मेम्ना ख खाबोंन उन्को द्वार को दोयी बाजू अऊर चौखट को ऊपर लगाये। <verse eid="EXO 12:7" /><verse number="8" style="v" sid="EXO 12:8" /><note caller="+" style="x"><char style="xo" closed="false">12:8 </char><char style="xt" closed="false"><ref loc="1CO 5:7">१ कुरिन्थियों ५:७</ref></char></note>अऊर हि ओको मांस ख उच रात आगी म भूज क अखमीरी रोटी अऊर कड़ू साग भाजी को संग म खाये। <verse eid="EXO 12:8" /><verse number="9" style="v" sid="EXO 12:9" />मेम्ना को मांस ख कच्चो यां पानी म उबाल क मत खाना, बल्की मुंड, पाय, अऊर अतड़िया सहित ओख आगी म भूज क खाजो। <verse eid="EXO 12:9" /><verse number="10" style="v" sid="EXO 12:10" />अऊर ओको म सी कुछ भी सुबेरे तक मत रहन देजो अऊर यदि कुछ सुबेरे तक रह्य भी जाये, त ओख आगी म जलाय देजो। <verse eid="EXO 12:10" /><verse number="11" style="v" sid="EXO 12:11" /><note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="LEV 23:5">लैव्यव्यवस्था २३:५</ref>; <ref loc="NUM 9:5">गिनती ९:५</ref>; <ref loc="NUM 9:1-5">९:१-५</ref></char></note>अऊर ओकी खान की या विधि आय, अपनी कमर बान्ध क, पाय म जूता पहिन्यो, अऊर हाथ म लाठी पकड़्यो हुयो ओख फुर्ती सी खाना; ऊ त परमेश्वर को त्यौहार आय। <verse eid="EXO 12:11" /><verse number="12" style="v" sid="EXO 12:12" /><note caller="+" style="x"><char style="xo" closed="false">12:12 </char><char style="xt" closed="false"><ref loc="NUM 33:4">गिनती ३३:४</ref></char></note>कहालीकि मय यो रात ख मिस्र देश को बीच म होय क जाऊं, अऊर उत का आदमी अऊर का जनावरों को हरेक नर पहिलौठा ख मारूं; अऊर मिस्र को पूरो देवतावों ख भी सजा देऊं; मय परमेश्वर आय। <verse eid="EXO 12:12" /><verse number="13" style="v" sid="EXO 12:13" /><note caller="+" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="HEB 11:28">इब्रानियों ११:२८</ref></char></note>अऊर जिन घरों म तुम रह्य हय, उन पर लगायो खून तुम्हरो लायी एक चिन्ह ठहरेंन; मतलब मय ऊ खून को चिन्ह ख देख क तुम ख छोड़ देऊं, अऊर जब मय मिस्र देश को लोगों ख मारूं, तब ऊ महामारी तुम पर नहीं आयेंन अऊर तुम नाश नहीं होयेंन। <verse eid="EXO 12:13" /><verse number="14" style="v" sid="EXO 12:14" />अऊर ऊ दिन तुम ख याद दिलान वालो ठहरेंन, अऊर तुम ओख परमेश्वर लायी त्यौहार कर क् मनाना; ऊ दिन तुम्हरो पीढ़ियों म हमेशा की विधि जान क मान्यो जाये।”<verse eid="EXO 12:14" /></para>
  <para style="s">अखमीरी रोटी</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 12:15" />परमेश्वर न कह्यो, “सात दिन तक अखमीरी रोटी खायो जाये, तुम पहिलो च दिन अपनो-अपनो घर सी खमीर दूर करजो, कहालीकि जो आदमी पहिले दिन सी ले क सातवों दिन तक कोयी खमीर को चीज खाये, ऊ इस्राएलियों को बीच सी बाहेर निकाल दियो जायेंन। <verse eid="EXO 12:15" /><verse number="16" style="v" sid="EXO 12:16" />तुम पवित्र सभा पहिले दिन अऊर सातवों दिन करजो; उन दोयी दिनों म कोयी भी काम नहीं करयो जाये; पर जेवन लायी खाना पकाय सकय हय। <verse eid="EXO 12:16" /><verse number="17" style="v" sid="EXO 12:17" /><note caller="+" style="x"><char style="xo" closed="false">12:17 </char><char style="xt" closed="false"><ref loc="LEV 23:6-8">लैव्यव्यवस्था २३:६-८</ref>; <ref loc="NUM 28:17-25">गिनती २८:१७-२५</ref>; <ref loc="MAT 2:17">मत्ती २:१७</ref></char></note>येकोलायी तुम बिना खमीर की रोटी को त्यौहार मानना, कहालीकि उच दिन मानो मय न तुम ख मिस्र देश सी बाहेर निकाल्यो हय; यो वजह ऊ दिन तुम्हरो पीढ़ियों म हमेशा की विधि जान क मान्यो जाये। <verse eid="EXO 12:17" /><verse number="18" style="v" sid="EXO 12:18" />पहिलो महिना को चौदावों दिन की शाम सी ले क इक्कीसवो दिन की शाम तक तुम अखमीरी रोटी खायो करजो। <verse eid="EXO 12:18" /><verse number="19" style="v" sid="EXO 12:19" />सात दिन तक तुम्हरो घरों म कुछ भी खमीर नहीं रहनो पाये; बल्की जो कोयी कोयी खमीरी चिज ख खाये, चाहे ऊ देशी हो यां परदेशी, ऊ प्रानी इस्राएलियों की सभा सी निकाल दियो जायेंन। <verse eid="EXO 12:19" /><verse number="20" style="v" sid="EXO 12:20" />तुम कोयी भी खमीर को चीज मत खाजो; तुम अपनो घर म बिना खमीर की रोटी खायो करजो।”<verse eid="EXO 12:20" /></para>
  <para style="s">पहिलो फसह को त्यौहार</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 12:21" />तब मूसा न इस्राएलियों को सब बुजूर्गों ख बुलाय क कह्यो, “तुम अपनो अपनो परिवार को अनुसार एक एक मेम्ना अलग कर रखो, अऊर फसह त्यौहार पशु बलि करजो। <verse eid="EXO 12:21" /><verse number="22" style="v" sid="EXO 12:22" />अऊर ओको खून जो कोहपर म होयेंन ओको म जूफा नाम की झाड़ी सी बन्यो एक गुच्छा डुबाय क उच कोहपर म को खून सी दरवाजा को चौखट पर दोयी बाजुवों पर लगावो; अऊर सबेरे होनो तक तुम म सी कोयी भी घर सी बाहेर नहीं निकले। <verse eid="EXO 12:22" /><verse number="23" style="v" sid="EXO 12:23" /><note caller="+" style="x"><char style="xo" closed="false">12:23 </char><char style="xt" closed="false"><ref loc="HEB 11:28">इब्रानियों ११:२८</ref>; <ref loc="EZK 9:6">यहेजकेल ९:६</ref></char></note>जब परमेश्वर मिस्रियों ख मारन लायी मिस्र देश सी होय क जायेंन; येकोलायी जित जित ऊ चौखट को ऊपर अऊर दोयी बाजू ऊ खून देखेंन, ऊ दरवाजा ख छोड़ देयेंन, अऊर नाश करन वालो ख तुम्हरो घरों म मारन लायी नहीं जान देयेंन। <verse eid="EXO 12:23" /><verse number="24" style="v" sid="EXO 12:24" />फिर तुम या विधि ख अपनो अऊर अपनो वंश को लायी हमेशा को नियम जान क मानतो जावो। <verse eid="EXO 12:24" /><verse number="25" style="v" sid="EXO 12:25" />जब तुम ऊ देश म पहुंचो जेक परमेश्वर न तुम्ख देन को वादा करयो होतो, तुम उत सिरजो, त तुम यो विधि ख मानजो। <verse eid="EXO 12:25" /><verse number="26" style="v" sid="EXO 12:26" /><note caller="+" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="DEU 32:7">व्यवस्थाविवरन ३२:७</ref>; <ref loc="JOS 4:6">यहोशू ४:६</ref></char></note>अऊर जब तुम्हरो बच्चां तुम सी पूछेंन, ‘या विधि को का मतलब हय?’ <verse eid="EXO 12:26" /><verse number="27" style="v" sid="EXO 12:27" />तब तुम उन्को यो उत्तर देजो, ‘परमेश्वर को यो फसह को बलिदान आय, जो मिस्रियों को मारन को समय मिस्र म रहन वालो हम इस्राएलियों को घरों ख बचायो, योच वजह ओको फसह को यो बलिदान करयो जावय हय।’” तब लोगों न मुंड झुकाय क आराधना करी।<verse eid="EXO 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 12:28" />तब इस्राएलियों न जाय क असोच करयो, जो आज्ञा परमेश्वर न मूसा अऊर हारून ख दी होती, ओको अनुसार उन्न करयो।<verse eid="EXO 12:28" /></para>
  <para style="s">आखरी दसवी विपत्ति</para>
  <para style="s">पहिलौठा की मौत</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 12:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:29 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 78:51">भजन ७८:५१</ref>; <ref loc="PSA 105:36">१०५:३६</ref>; <ref loc="PSA 135:8">१३५:८</ref>; <ref loc="PSA 136:10">१३६:१०</ref></char>
    </note>आधी रात ख परमेश्वर न मिस्र देश म राजगद्दी पर बैठन वालो फिरौन सी ले क बन्दी गृह म पड़्यो हुयो कैदी को बच्चा तक, अऊर सब को पहिलौठा को बल्की जनावर को सब पहिलौठों ख, मार डाल्यो। <verse eid="EXO 12:29" /><verse number="30" style="v" sid="EXO 12:30" />अऊर फिरौन राजा अऊर ओको सब कर्मचारी, अऊर सब मिस्र निवासी ऊ रात म उठ्यो; अऊर पूरो देश म बड़ो रोवनो अऊर चिल्लानो मच्यो, कहालीकि एक भी घर असो नहीं होतो जेको म कोयी मरयो नहीं होतो। <verse eid="EXO 12:30" /><verse number="31" style="v" sid="EXO 12:31" />तब फिरौन न रात खच मूसा अऊर हारून ख बुलायो अऊर उन्को सी कह्यो। “तुम उठो, अऊर इस्राएलियों संग मोरो लोगों को बीच सी निकल जावो; जसो तुम न कह्यो होतो अऊर अपनो परमेश्वर की आराधना करो। <verse eid="EXO 12:31" /><verse number="32" style="v" sid="EXO 12:32" />जसो तुम न कह्यो होतो, अपनी मेंढी-शेरियों, गाय-बईलों ख संग ले जावो; अऊर मोख आशीर्वाद दे जावो।”<verse eid="EXO 12:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 12:33" />मिस्री जो कहत होतो, हम त सब मर मिट्यो हय, उन्न इस्राएली लोगों पर दबाव डाल क कह्यो, “देश सी जल्दी नकल जावो, नहीं त हम सब मर जाबोन।” <verse eid="EXO 12:33" /><verse number="34" style="v" sid="EXO 12:34" />तब उन्न अपनो सन्यो हुयो आटा ख बिना खमीर मिलाये, बर्तन सहित कपड़ा म बान्ध क अपनो कन्धों पर उठाय क जान लग्यो। <verse eid="EXO 12:34" /><verse number="35" style="v" sid="EXO 12:35" /><note caller="+" style="x"><char style="xo" closed="false">12:35 </char><char style="xt" closed="false"><ref loc="EXO 3:22">निर्गमन ३:२२</ref></char></note>इस्राएलियों न जसो मूसा न कह्यो होतो वसोच कह्यो, अऊर मिस्रियों सी सोना-चांदी को जेवर अऊर कपड़ा मांग लियो; <verse eid="EXO 12:35" /><verse number="36" style="v" sid="EXO 12:36" /><note caller="+" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="EXO 3:21-22">निर्गमन ३:२१-२२</ref></char></note>परमेश्वर न मिस्रियों लोगों पर दया करयो उन्न जो जो मांग्यो ऊ सब उन्ख दियो। यो तरह इस्राएलियों न पूरो मिस्रियों ख लूट लियो।<verse eid="EXO 12:36" /></para>
  <para style="s">इस्राएलियों को मिस्र देश छोड़नो</para>
  <para style="p">
    <verse number="37" style="v" sid="EXO 12:37" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:37 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 33:5">गिनती ३३:५</ref>; <ref loc="NUM 1:46">१:४६</ref></char>
    </note>तब इस्राएलियों लोग रामसेस नगर सी सुक्कोत नगर की तरफ चले, बाईयों अऊर बाल बच्चां ख छोड़ क् हि लगभग छय लाख पैदल चलन वालो आदमी होतो। <verse eid="EXO 12:37" /><verse number="38" style="v" sid="EXO 12:38" />उन्को संग एक दूसरो गैर-इस्राएली लोग भी गयो, अऊर मेंढी-शेरी, गाय-बईल, अऊर भी बड़ो झुण्ड उन्को संग गयो। <verse eid="EXO 12:38" /><verse number="39" style="v" sid="EXO 12:39" />अऊर जो सान्यो आटा हि मिस्र देश सी संग ले गयो होतो ओकी उन्न बिना खमीर कीच रोटियां बनायी; कहालीकि हि मिस्र देश सी निकाल्यो गयो होतो। हि नहीं त कुछ समय लायी उत ठहर सक्यो अऊर नहीं अपनी यात्रा लायी जेवन बना सके।<verse eid="EXO 12:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 12:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:40 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 15:13">उत्पत्ति १५:१३</ref>; <ref loc="ACT 7:6">प्रेरितों ७:६</ref>; <ref loc="GAL 3:7">गलातियों ३:७</ref></char>
    </note>मिस्र देश म रह्यतो इस्राएलियों लोगों ख चार सौ तीस साल तक रह्यो होतो। <verse eid="EXO 12:40" /><verse number="41" style="v" sid="EXO 12:41" />अऊर उन चार सौ तीस साल को बीतन पर, ठीक उच दिन, परमेश्वर की लोगों की पूरी सेना मिस्र देश सी निकल गयी। <verse eid="EXO 12:41" /><verse number="42" style="v" sid="EXO 12:42" />परमेश्वर इस्राएलियों ख मिस्र देश सी निकाल लायो, यो तरह वा रात ओको निमित्त मानन को लायक हय; या परमेश्वर की वाच रात आय जेको पीढ़ी सी पीढ़ी म माननो इस्राएलियों को लायी जरूरी हय।<verse eid="EXO 12:42" /></para>
  <para style="s">फसह को त्यौहार की विधि</para>
  <para style="p">
    <verse number="43" style="v" sid="EXO 12:43" />तब परमेश्वर न मूसा अऊर हारून सी कह्यो, “त्यौहार की विधि या आय : कोयी परदेशी ओको म सी नहीं खाये; <verse eid="EXO 12:43" /><verse number="44" style="v" sid="EXO 12:44" />पर जो कोयी ख रुपया दे क लियो हुयो दास होना, अऊर ओको खतना करयो होना, त ऊ ओको म सी खाय सकेंन। <verse eid="EXO 12:44" /><verse number="45" style="v" sid="EXO 12:45" />पर परदेशी अऊर मजूर ओको म सी मत खावो। <verse eid="EXO 12:45" /><verse number="46" style="v" sid="EXO 12:46" /><note caller="+" style="x"><char style="xo" closed="false">12:46 </char><char style="xt" closed="false"><ref loc="NUM 9:12">गिनती ९:१२</ref>; <ref loc="JHN 19:36">यूहन्ना १९:३६</ref></char></note>ओको जेवन एकच घर म हो; मतलब तुम ओको मांस म सी कुछ घर सी बाहेर मत ले जावो; अऊर बलि प्रानी की कोयी हड्डी नहीं तोड़ो। <verse eid="EXO 12:46" /><verse number="47" style="v" sid="EXO 12:47" />पूरी इस्राएल मण्डली यो त्यौहार ख मनायेंन। <verse eid="EXO 12:47" /><verse number="48" style="v" sid="EXO 12:48" />अऊर यदि कोयी परदेशी तुम लोगों को संग रह्य क परमेश्वर लायी त्यौहार मनानो चाहेंन, त ऊ अपनो परिवार को सब आदमी को खतना करायो जाय, तब हि धार्मिक विधि म भाग ले क त्यौहार ख मना सकेंन; अऊर हि ऊ देश को निवासी ठहरेंन। पर कोयी खतनारहित आदमी ओको म सी नहीं खाय सकेंन। <verse eid="EXO 12:48" /><verse number="49" style="v" sid="EXO 12:49" /><note caller="+" style="x"><char style="xo" closed="false">12:49 </char><char style="xt" closed="false"><ref loc="LEV 24:22">लैव्यव्यवस्था २४:२२</ref>; <ref loc="NUM 9:14">गिनती 9:१४</ref>; <ref loc="NUM 15:15">१५:१५</ref>; <ref loc="NUM 16:29">१६:२९</ref></char></note>ओको नियम देशी अऊर तुम्हरो बीच म रहन वालो परदेशी दोयी लायी एकच आय।” <verse eid="EXO 12:49" /><verse number="50" style="v" sid="EXO 12:50" />यो आज्ञा जो परमेश्वर न मूसा अऊर हारून ख दी ओको अनुसार पूरो इस्राएलियों न करयो। <verse eid="EXO 12:50" /><verse number="51" style="v" sid="EXO 12:51" />अऊर ठीक उच दिन परमेश्वर न इस्राएलियों ख मिस्र देश सी पूरो इस्राएलियों ख निकाल लायो।<verse eid="EXO 12:51" /></para>
  <chapter eid="EXO 12" />
  <chapter number="13" style="c" sid="EXO 13" />
  <para style="s">पहिलौठों को अर्पन</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 13:1" />तब परमेश्वर न मूसा सी कह्यो,<verse eid="EXO 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 13:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:2 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 3:13">गिनती ३:१३</ref>; <ref loc="LUK 2:23">लूका २:२३</ref></char>
    </note>“का आदमी को का जनावर को, हर एक नर इस्राएलियों म जितनो अपनी माय सी पहिलो जनम्यो हय, उन्ख मोरो लायी पवित्र माननो; ऊ मोरोच आय।”<verse eid="EXO 13:2" /></para>
  <para style="s">अखमीरी रोटी को त्यौहार</para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 13:3" />तब मूसा न लोगों सी कह्यो, “यो दिन ख याद रखो, जेको म तुम लोग मिस्र देश की गुलामी सी निकल आये हो; परमेश्वर न तुम ख उत सी अपनो हाथ को बल सी निकाल लायो हय; येकोलायी यो दिन खमीर सी बनी रोटी नहीं खायी जाये। <verse eid="EXO 13:3" /><verse number="4" style="v" sid="EXO 13:4" />आबीब को महीना म अज कोच दिन तुम निकल्यो हय। <verse eid="EXO 13:4" /><verse number="5" style="v" sid="EXO 13:5" />येकोलायी जब परमेश्वर तुम ख कनानी, हित्ती, एमोरी, हिब्बी, अऊर यबूसी लोगों को देश म पहुंचायेंन, जेक देन की ओन तुम्हरो पूर्वजों सी कसम खायी होती, अऊर जेक म दूध अऊर शहेद को धारा बहय हंय, तब तुम योच महीना म त्यौहार मनावो। <verse eid="EXO 13:5" /><verse number="6" style="v" sid="EXO 13:6" />सात दिन तक बिना खमीर की रोटी खायो करजो, अऊर सातवों दिन परमेश्वर लायी त्यौहार मनावो। <verse eid="EXO 13:6" /><verse number="7" style="v" sid="EXO 13:7" />इन सातों दिनों म बिना खमीर की रोटीच खायी जाये, अखमीरी रोटी तुम्हरो बीच नहीं दिखायी दे अऊर नहीं तुम्हरो पूरो देश म कहीं तुम्हरो जवर खमीर दिखायी दे। <verse eid="EXO 13:7" /><verse number="8" style="v" sid="EXO 13:8" />अऊर उच दिन तुम अपनो अपनो टुरावों ख यो कह्य क् समझाय देना कि यो हम उच काम को वजह करय हंय, जो परमेश्वर न हम्ख मिस्र देश सी निकाल आवन को समय हमरो लायी करयो होतो। <verse eid="EXO 13:8" /><verse number="9" style="v" sid="EXO 13:9" /><note caller="+" style="x"><char style="xo" closed="false">13:9 </char><char style="xt" closed="false"><ref loc="NUM 15:39">गिनती १५:३९</ref>; <ref loc="MAT 23:5">मत्ती २३:५</ref></char></note>तब यो तोरो लायी तोरो हाथ म एक चिन्ह होयेंन, अऊर तोरी आंखी को आगु याद करन वाली चीज ठहरे; जेको सी परमेश्वर की व्यवस्था तोरो मुंह पर रहे, कहालीकि परमेश्वर न तुम्ख अपनो ताकतवर हाथ सी मिस्र देश सी निकाल्यो हय। <verse eid="EXO 13:9" /><verse number="10" style="v" sid="EXO 13:10" />यो वजह तुम या विधि ख हर साल सही समय पर करत रह्यजो।<verse eid="EXO 13:10" /></para>
  <para style="s">पहिलो जनम्यो बच्चा</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 13:11" />“फिर जब परमेश्वर वा कसम को अनुसार, जो ओन तुम्हरो पूर्वजों सी अऊर तुम सी भी खायी हय, तुम्ख कनानियों को देश म पहुंचाय क ओख तुम्ख दे देयेंन, <verse eid="EXO 13:11" /><verse number="12" style="v" sid="EXO 13:12" /><note caller="+" style="x"><char style="xo" closed="false">13:12 </char><char style="xt" closed="false"><ref loc="EXO 34:19">निर्गमन ३४:१९</ref>; <ref loc="LEV 27:16">लैव्यव्यवस्था २७:१६</ref>; <ref loc="NUM 18:15">गिनती १८:१५</ref>; <ref loc="EZK 44:30">यहेजकेल ४४:३०</ref></char></note>तब तुम म सी जितनो नर अपनी अपनी माय को पहिलो जनम्यो आय उन्को, अऊर तुम्हरो जनावरों म जो असो आय उन्ख भी परमेश्वर लायी अर्पन करजो; सब नर बच्चां त परमेश्वर को आय। <verse eid="EXO 13:12" /><verse number="13" style="v" sid="EXO 13:13" />अऊर गधा को हर एक पहिलौठा को बदले मेम्ना दे क ओख छुड़ाय लेना, अऊर यदि तुम ओख छुड़ानो नहीं चाहवय त ओको गर्दन तोड़ देना। पर अपनो सब पहिलौठा टुरावों ख बदला दे क छुड़ाय लेना। <verse eid="EXO 13:13" /><verse number="14" style="v" sid="EXO 13:14" />अऊर आगु को दिनों म जब तुम्हरो टुरा तुम सी पूछेंन, ‘यो का हय?’ त उन सी कह्यजो, ‘परमेश्वर न हम लोगों ख मिस्र की गुलामी सी बाहेर अपनो ताकतवर हाथ को बल सी निकाल लायो हय। <verse eid="EXO 13:14" /><verse number="15" style="v" sid="EXO 13:15" />उच समय जब फिरौन राजा न कठोर होय क हम्ख निकलन नहीं दे रह्यो होतो, तब परमेश्वर न मिस्र देश म आदमी सी ले कर जनावर तक सब को पहिलौठा ख मार डाल्यो। येकोलायी हम हर एक जनावर नर पहिलौठा परमेश्वर ख चढ़ाजे हय, पर अपनो सब पहिलौठे टुरावों ख हम बदला दे क छुड़ाय लेजे हय।’ <verse eid="EXO 13:15" /><verse number="16" style="v" sid="EXO 13:16" /><note caller="+" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="DEU 6:8">व्यवस्थाविवरन ६:८</ref></char></note>यो तुम्हरो याद लायी हाथ पर बन्ध्यो एक चिन्ह जसो अऊर तोरी दोयी आंखी को बीच टिका जसो ठहरे; कहालीकि परमेश्वर न हम लोगों ख मिस्र देश सी अपनो ताकतवर हाथों को बल सी निकाल लायो हय।”<verse eid="EXO 13:16" /></para>
  <para style="s">बादर को खम्बा अऊर आगी को खम्बा</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 13:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:17 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:1">गिनती १४:१</ref>
      </char>
    </note>जब फिरौन राजा न लोगों ख जान की आज्ञा दे दी, परमेश्वर उन्ख पलिश्ती देश म होय क जो रस्ता जावय हय ऊ छोटो होतो; तब भी परमेश्वर न यो सोच्यो कि उन्ख ऊ रस्ता सी नहीं ले गयो कि कहीं असो नहीं होय कि जब हि लोग लड़ाई देखे तब पछताय क मिस्र देश वापस लौट जाय। <verse eid="EXO 13:17" /><verse number="18" style="v" sid="EXO 13:18" />येकोलायी परमेश्वर उन्ख घुमाय-फिराय क लाल समुन्दर को सुनसान रस्ता सी ले गयो। अऊर इस्राएली लोग अस्त्र-शस्त्र बान्ध्यो हुयो मिस्र सी निकल गयो। <verse eid="EXO 13:18" /><verse number="19" style="v" sid="EXO 13:19" /><note caller="+" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="GEN 50:25">उत्पत्ति ५०:२५</ref>; <ref loc="JOS 24:32">यहोशू २४:३२</ref></char></note>अऊर मूसा यूसुफ की हड्डियों ख संग म ले गयो; कहालीकि यूसुफ न इस्राएलियों सी यो कह्य क् कसम ली होती, “जब परमेश्वर तोरी सुधि ले, तब अपनो संग मोरी हड्डियों ख इत सी जरूर ले जाजो।” <verse eid="EXO 13:19" /><verse number="20" style="v" sid="EXO 13:20" />फिर उन्न सुक्कोत नगर सी आगु बढ़ क् सुनसान जागा पर एताम म डेरा डाल्यो। <verse eid="EXO 13:20" /><verse number="21" style="v" sid="EXO 13:21" />अऊर परमेश्वर उन्ख दिन म रस्ता दिखान लायी बादर को खम्बा म, अऊर रात ख उजाड़ो देन लायी आगी को खम्बा म होय क उन्को आगु आगु चलत होतो, जेकोसी हि रात-दिन चल सके। <verse eid="EXO 13:21" /><verse number="22" style="v" sid="EXO 13:22" />ओन नहीं त बादर को खम्बा ख दिन म अऊर नहीं आगी को खम्बा ख रात म लोगों को आगु सी हटायो।<verse eid="EXO 13:22" /></para>
  <chapter eid="EXO 13" />
  <chapter number="14" style="c" sid="EXO 14" />
  <para style="s">लाल समुन्दर पार करनो</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 14:1" />तब परमेश्वर न मूसा सी कह्यो,<verse eid="EXO 14:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 14:2" />“इस्राएलियों ख कहो कि हि पीछू लौट क मिगदोल नगर अऊर समुन्दर को बीच, पीहाहीरोत नगर को आगु, बालसपोन को सामने अपनो डेरा डाल, अऊर तुम लाल समुन्दर को किनार पर पड़ाव डालनो। <verse eid="EXO 14:2" /><verse number="3" style="v" sid="EXO 14:3" />तब फिरौन राजा इस्राएलियों को बारे म सोचेंन, ‘हि अनजान देश म भटक क घबराय गयो हय। सुनसान जागा न उन्ख बन्दी बनाय लियो हय।’ <verse eid="EXO 14:3" /><verse number="4" style="v" sid="EXO 14:4" />तब मय फिरौन राजा को मन ख कठोर कर देऊं, अऊर ऊ उन्को पीछा करेंन। तब फिरौन राजा अऊर ओकी पूरी सेना को द्वारा मोरी महिमा होयेंन; अऊर मिस्र लोग जान लेयेंन कि मयच परमेश्वर आय।” अऊर उन्न वसोच करयो।<verse eid="EXO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 14:5" />जब मिस्र देश को फिरौन राजा ख यो समाचार मिल्यो कि हि लोग भग गयो, तब फिरौन राजा अऊर ओको कर्मचारियों को मन उन्को खिलाफ बदल गयो, अऊर हि कहन लग्यो, “हम न यो का का करयो कि इस्राएलियों को गुलामी सी मुक्त कर क् जान दियो!” <verse eid="EXO 14:5" /><verse number="6" style="v" sid="EXO 14:6" />तब राजा न अपनो रथ तैयार करयो अऊर अपनी सेना ख संग लियो। <verse eid="EXO 14:6" /><verse number="7" style="v" sid="EXO 14:7" />ओन छय सौ अच्छो सी अच्छो रथ बल्की मिस्र को सब रथ उन्को अधिकारियों संग रख्यो। <verse eid="EXO 14:7" /><verse number="8" style="v" sid="EXO 14:8" /><note caller="+" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="ACT 13:17">प्रेरितों १३:१७</ref></char></note>अऊर परमेश्वर न मिस्र देश को राजा फिरौन को मन ख कठोर कर दियो। येकोलायी ओन इस्राएलियों को पीछा करयो; पर इस्राएली जो हिम्मत को संग बढ़तो जाय रह्यो होतो। <verse eid="EXO 14:8" /><verse number="9" style="v" sid="EXO 14:9" />पर फिरौन राजा को सब घोड़ा, रथों, अऊर घुड़सवारों संग मिस्र की सेना उन्को पीछा करतो हुयो उन्को जवर लाल समुन्दर को किनार पर जित डेरा डाल्यो होतो जाय पहुंची, जो पीहाहीरोत को जवर, बालसपोन को आगु होती। <verse eid="EXO 14:9" /><verse number="10" style="v" sid="EXO 14:10" />जब फिरौन राजा जवर आयो, तब इस्राएलियों न आंखी उठाय क का देख्यो कि मिस्री हमरो पीछा करतो आय रह्यो हय; तब इस्राएली बहुत डर गयो, अऊर चिल्लाय क परमेश्वर सी मदत की दोहायी मांगी; <verse eid="EXO 14:10" /><verse number="11" style="v" sid="EXO 14:11" />अऊर हि मूसा सी कहन लग्यो, “का मिस्र देश म कब्र नहीं होती जो तय हम ख मरन लायी जंगल म ले आयो हय? तय न हम्ख मिस्र देश सी निकाल क हमरो संग यो का करयो? <verse eid="EXO 14:11" /><verse number="12" style="v" sid="EXO 14:12" /><note caller="+" style="x"><char style="xo" closed="false">14:12 </char><char style="xt" closed="false"><ref loc="EXO 16:3">निर्गमन १६:३</ref>; <ref loc="EXO 17:3">१७:३</ref></char></note>का हम तोरो सी मिस्र देश म योच बात नहीं कहत रह्यो कि हम्ख रहन देवो कि हम मिस्रियों की गुलामी करतो? हमरो लायी जंगल म मरन को बदला मिस्रियों की गुलामी करनो अच्छो होतो।”<verse eid="EXO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 14:13" />मूसा न लोगों सी कह्यो, “डरो मत, खड़ो खड़ो ऊ उद्धार को काम देखो, जो परमेश्वर अज तुम्हरो लायी करेंन; कहालीकि जिन मिस्रियों ख तुम अज देखय हय, उन्ख फिर कभी नहीं देख सकोंन। <verse eid="EXO 14:13" /><verse number="14" style="v" sid="EXO 14:14" /><note caller="+" style="x"><char style="xo" closed="false">14:14 </char><char style="xt" closed="false"><ref loc="DEU 20:4">व्यवस्थाविवरन २०:४</ref>; <ref loc="JOS 10:14">यहोशू १०:१४</ref>; <ref loc="ISA 30:15">यशायाह ३०:१५</ref></char></note>परमेश्वर तुम्हरो लायी लड़ेंन, येकोलायी तुम चुप रहो।”<verse eid="EXO 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 14:15" />तब परमेश्वर न मूसा सी कह्यो, “तय कहाली पुकार रह्यो हय मदत लायी? इस्राएलियों ख कहो हि आगु बढ़े। <verse eid="EXO 14:15" /><verse number="16" style="v" sid="EXO 14:16" />अऊर तय अपनी लाठी उठाय क अपनो हाथ समुन्दर को ऊपर बढ़ा, अऊर पानी दोय हिस्सा म होय जायेंन; जेकोसी इस्राएली समुन्दर को बीच सी सूखी जागा पर जा सकेंन। <verse eid="EXO 14:16" /><verse number="17" style="v" sid="EXO 14:17" />अऊर सुन, मय खुद मिस्रियों को मन ख कठोर कर देऊं, जेकोसी हि इस्राएलियों को पीछा करतो हुयो समुन्दर को बीच म जायेंन। तब फिरौन राजा अऊर ओकी पूरी सेना, अऊर रथों अऊर घुड़सवारों को विनाश सी मोरी महिमा दिखेंन। <verse eid="EXO 14:17" /><verse number="18" style="v" sid="EXO 14:18" />जब फिरौन राजा, अऊर ओको रथों, अऊर घुड़सवारों ख हराऊं तब मोरी महिमा होयेंन, अऊर मिस्री जान लेयेंन कि मय परमेश्वर आय।”<verse eid="EXO 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 14:19" />तब परमेश्वर को दूत जो इस्राएली सेना को आगु चलत होतो उन्को पीछु भय गयो; अऊर बादर को खम्बा भी आगु सी हट क उन्को पीछू भय गयो। <verse eid="EXO 14:19" /><verse number="20" style="v" sid="EXO 14:20" />असो तरह ऊ मिस्रियों की सेना अऊर इस्राएलियों की सेना को बीच म आय गयो; अऊर बादर अऊर अन्धारो त होतो, तब भी रात ख उन्ख उजाड़ो मिलतो रह्यो पर मिस्रियों ख अन्धारो; पर ऊ रात मिस्री उन्ख पकड़न लायी जवर नहीं आय सक्यो। <verse eid="EXO 14:20" /><verse number="21" style="v" sid="EXO 14:21" /><note caller="+" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="PSA 16:9">भजन १६:9</ref>; <ref loc="PSA 114:3">११४:३</ref></char></note>तब मूसा न अपनो हाथ लाल समुन्दर को ऊपर बढ़ायो; अऊर परमेश्वर न रात भर भारी पूर्व सी हवा चलायी, अऊर समुन्दर को पानी दोय हिस्सा म बट गयो, जेकोसी ओको बीच सूखी जमीन भय गयी। <verse eid="EXO 14:21" /><verse number="22" style="v" sid="EXO 14:22" /><note caller="+" style="x"><char style="xo" closed="false">14:22 </char><char style="xt" closed="false"><ref loc="1CO 10:1">१ कुरिन्थियों १०:१</ref>,<ref loc="1CO 10:2">२</ref>; <ref loc="HEB 11:29">इब्रानियों ११:२९</ref></char></note>तब इस्राएली समुन्दर को बीच सूखी जमीन पर सी चल क गयो, अऊर पानी उन्की दायो अऊर बायो तरफ पानी की दीवार बन क खड़ो होतो। <verse eid="EXO 14:22" /><verse number="23" style="v" sid="EXO 14:23" />तब मिस्रियों न उन्को पीछा करयो। फिरौन राजा को सब रथ, घोड़ा, अऊर सवार उन्को पीछा करतो हुयो समुन्दर को बीच म चली गयो। <verse eid="EXO 14:23" /><verse number="24" style="v" sid="EXO 14:24" />अऊर रात को आखरी पहर म परमेश्वर न बादर अऊर आगी को खम्बा म सी मिस्रियों की सेना पर नजर रख क उन्ख घबराय दियो। <verse eid="EXO 14:24" /><verse number="25" style="v" sid="EXO 14:25" />अऊर ओन उन्को रथों को चक्का ख निकाल डाल्यो, जेकोसी उन्को चलनो मुश्किल भय गयो। तब मिस्री आपस म कहन लग्यो, “आवो, हम इस्राएलियों को जवर सी भाग जाये; कहालीकि परमेश्वर उन्की तरफ सी मिस्रियों को खिलाफ युद्ध कर रह्यो हय।” <verse eid="EXO 14:25" /><verse number="26" style="v" sid="EXO 14:26" />फिर परमेश्वर न मूसा सी कह्यो, “अपनो हाथ समुन्दर को ऊपर बढ़ा कि पानी मिस्रियों, अऊर उन्को रथों, अऊर सवारों पर फिर बहन लग्यो।” <verse eid="EXO 14:26" /><verse number="27" style="v" sid="EXO 14:27" />तब मूसा न अपनो हाथ समुन्दर को ऊपर बढ़ायो, अऊर सुबेरे होतोच का भयो कि समुन्दर फिर पहिलो को जसो होन लग्यो; अऊर मिस्री भगन लग्यो, पर परमेश्वर न उन्ख समुन्दर को बीच म डुबाय दियो। <verse eid="EXO 14:27" /><verse number="28" style="v" sid="EXO 14:28" />अऊर पानी को पलटनो सी, जितनो रथ अऊर घुड़सवार इस्राएलियों को पीछु समुन्दर म आयो होतो, हि सब बल्की फिरौन राजा की पूरी सेना ओको म डुब गयी, अऊर ओको म सी एक भी नहीं बच्यो। <verse eid="EXO 14:28" /><verse number="29" style="v" sid="EXO 14:29" />पर इस्राएली समुन्दर को बीच सूखी जमीन पर चल क समुन्दर पार होय गयो, अऊर पानी उन्को दायो अऊर बायो तरफ दीवार बन क खड़ो होतो। <verse eid="EXO 14:29" /><verse number="30" style="v" sid="EXO 14:30" />असो तरह परमेश्वर न ऊ दिन इस्राएलियों ख मिस्रियों सी बचायो; अऊर इस्राएलियों न मिस्रियों ख समुन्दर को किनार पर मरयो पड़्यो हुयो देख्यो। <verse eid="EXO 14:30" /><verse number="31" style="v" sid="EXO 14:31" />जब इस्राएलियों न मिस्र को निवासियों को खिलाफ करयो गयो परमेश्वर महान भुजबल को कार्य ख दिखायो, तब हि परमेश्वर को डरन लग्यो। उन्न परमेश्वर अऊर ओको दास मूसा पर विश्वास करयो।<verse eid="EXO 14:31" /></para>
  <chapter eid="EXO 14" />
  <chapter number="15" style="c" sid="EXO 15" />
  <para style="s">मूसा को गीत</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 15:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:1 </char>
      <char style="xt" closed="false">
        <ref loc="REV 15:3">प्रकाशितवाक्य १५:३</ref>
      </char>
    </note>तब मूसा अऊर इस्राएलियों न परमेश्वर को या गाना गायो। उन्न कह्यो, “मय परमेश्वर को गाना गाऊं, कहालीकि ओन महान काम करयो हय;”</para>
  <para style="p" vid="EXO 15:1">घोड़ा समेत सवारों ख ओन समुन्दर म फेंक दियो हय। <verse eid="EXO 15:1" /><verse number="2" style="v" sid="EXO 15:2" /><note caller="+" style="x"><char style="xo" closed="false">15:2 </char><char style="xt" closed="false"><ref loc="PSA 118:14">भजन ११८:१४</ref>; <ref loc="ISA 12:2">यशायाह १२:२</ref></char></note>परमेश्वर मोरी शक्ति अऊर सामर्थ हय अऊर भजन को विषय हय, अऊर उच मोरो उद्धार भी ठहरयो हय;</para>
  <para style="p" vid="EXO 15:2">मोरो परमेश्वर उच आय, मय ओकीच स्तुति करूं,</para>
  <para style="p" vid="EXO 15:2">मोरो पूर्वजों को परमेश्वर उच आय, मय ओको गुन गान करूं। <verse eid="EXO 15:2" /><verse number="3" style="v" sid="EXO 15:3" />परमेश्वर महान योद्धा हय; ओको नाम परमेश्वर आय। <verse eid="EXO 15:3" /><verse number="4" style="v" sid="EXO 15:4" />ओन फिरौन राजा को रथों अऊर सेना ख ओन समुन्दर म फेंक दियो;</para>
  <para style="p" vid="EXO 15:4">अऊर ओको अच्छो सी अच्छो रथों अऊर अधिकारियों ख लाल समुन्दर म डुबाय दियो। <verse eid="EXO 15:4" /><verse number="5" style="v" sid="EXO 15:5" />गहरो पानी न उन्ख झाक लियो; हि गोटा को जसो गहरो जागावों म डुब गयो। <verse eid="EXO 15:5" /><verse number="6" style="v" sid="EXO 15:6" />हे परमेश्वर, तोरो दायो हाथ महाप्रतापी भयो;</para>
  <para style="p" vid="EXO 15:6">हे परमेश्वर, तोरो दायो हाथ दुश्मन ख चकनाचूर कर देवय हय। <verse eid="EXO 15:6" /><verse number="7" style="v" sid="EXO 15:7" />तय अपनो विरोधियों ख अपनो महा प्रताप सी गिराय देवय हंय;</para>
  <para style="p" vid="EXO 15:7">तय अपनो गुस्सा भड़कावय, अऊर हि भूसा को समान राखड़ होय जावय हंय; <verse eid="EXO 15:7" /><verse number="8" style="v" sid="EXO 15:8" />तोरो नथनों की श्वास सी समुन्दर को पानी जमा भय गयो, पानी ढेर बन क दिवार जसो ऊचो खड़ो भय गयो;</para>
  <para style="p" vid="EXO 15:8">समुन्दर को बीच म गहरो पानी जम गयो। <verse eid="EXO 15:8" /><verse number="9" style="v" sid="EXO 15:9" />दुश्मन न कह्यो, मय पीछा करूं अऊर पकड़ूं,</para>
  <para style="p" vid="EXO 15:9">अऊर लूट को माल ख बाट लेऊं, उन सी मोरो जी भर जायेंन।</para>
  <para style="p" vid="EXO 15:9">मय अपनी तलवार निकालूं अऊर अपनो हाथ सी उन्ख नाश कर डालूं। <verse eid="EXO 15:9" /><verse number="10" style="v" sid="EXO 15:10" />तय न अपनो श्वास सी हवा चलायो, तब समुन्दर न मिस्रियों ख झाक लियो;</para>
  <para style="p" vid="EXO 15:10">हि लोहा को जसो गहरो भयानक पानी म डुब गयो। <verse eid="EXO 15:10" /><verse number="11" style="v" sid="EXO 15:11" />हे परमेश्वर, देवतावों म तोरो बराबर कौन हय? तय त पवित्रता को वजह महान सामर्थी,</para>
  <para style="p" vid="EXO 15:11">अऊर अपनी स्तुति करन वालो को डर को योग्य, अऊर आश्चर्यकर्म को करन वालो हय। <verse eid="EXO 15:11" /><verse number="12" style="v" sid="EXO 15:12" />तय न अपनो दायो हाथ बढ़ायो, अऊर धरती न उन दुस्मन ख गिटक लियो हय। <verse eid="EXO 15:12" /><verse number="13" style="v" sid="EXO 15:13" />अपनी सामर्थ सी तय न करुना अपनो छुड़ायो हुयो लोगों ख चलायो हय,</para>
  <para style="p" vid="EXO 15:13">अपनो सामर्थ सी उन्ख अपनो पवित्र निवास म लिजाय रह्यो हय। <verse eid="EXO 15:13" /><verse number="14" style="v" sid="EXO 15:14" />देश देश को लोग सुन क काप उठेंन; पलिश्ती देश को निवासियों को डर को जसो होन लग्यो। <verse eid="EXO 15:14" /><verse number="15" style="v" sid="EXO 15:15" />तब एदोम को मुखिया डर जायेंन; मोआब को पहलवान थरथरायेंन;</para>
  <para style="p" vid="EXO 15:15">सब कनान निवासियों को हिम्मत हार जायेंन। <verse eid="EXO 15:15" /><verse number="16" style="v" sid="EXO 15:16" />तोरो सामर्थ ख देख क हि लोग घबराय जायेंन;</para>
  <para style="p" vid="EXO 15:16">जब तक, हे परमेश्वर तोरी प्रजा को लोग जिन्ख तय न मोल लियो हय पार नहीं निकल जाये। तुम्हरो लोगों ख कुछ नहीं करतो हुयो हि एकच जागा गोटा को समान खड़ो रह जायेंन। <verse eid="EXO 15:16" /><verse number="17" style="v" sid="EXO 15:17" />हे परमेश्वर, तय अपनो ऊ पहाड़ी पर, अपनो ऊ जागा पर, जेक तय न अपनो निवास जागा लायी बनायो हय, उन्ख पहुंचायेंन।</para>
  <para style="p" vid="EXO 15:17">उच पवित्र जागा पर, हे प्रभु, जेक तय न अपनो हाथों सी बनायो हय। <verse eid="EXO 15:17" /><verse number="18" style="v" sid="EXO 15:18" />परमेश्वर हमेशा हमेशा राज्य करेंन।<verse eid="EXO 15:18" /></para>
  <para style="s">मरियम को गीत</para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 15:19" />यो गाना गान को वजह या हय, कि फिरौन राजा को घोड़ा, रथों अऊर सवारों सहित समुन्दर को बीच म चल्यो गयो, अऊर परमेश्वर उन्को ऊपर समुन्दर को पानी वापस ले आयो; पर इस्राएली समुन्दर को बीच सूखी जमीन पर चल क पार भय गयो। <verse eid="EXO 15:19" /><verse number="20" style="v" sid="EXO 15:20" /><note caller="+" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="1SA 18:6">१ शमूएल १८:६</ref></char></note>तब हारून की बहिन मरियम न जो भविष्यवक्ता होती, डफली लियो; अऊर सब बाई डफली लियो नाचतो अऊर गातो हुयो ओको पीछु भय गयी। <verse eid="EXO 15:20" /><verse number="21" style="v" sid="EXO 15:21" />अऊर मरियम उन्को संग या गाना गात होती,</para>
  <para style="p" vid="EXO 15:21">“परमेश्वर को गाना गावो, कहालीकि ऊ महान काम करयो हय;”</para>
  <para style="p" vid="EXO 15:21">घोड़ा सहित सवारों ख ओन समुन्दर म फेंक दियो हय।<verse eid="EXO 15:21" /></para>
  <para style="s">कड़ू पानी</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 15:22" />तब मूसा इस्राएलियों ख लाल समुन्दर सी आगु ले गयो, अऊर हि शूर नाम सुनसान जंगल म गयो; अऊर सुनसान जागा म तीन दिन तक जातो रह्यो, पर उन्ख पानी नहीं मिल्यो। <verse eid="EXO 15:22" /><verse number="23" style="v" sid="EXO 15:23" />जब हि मारा नाम को एक जागा पर पहुंच्यो, उत को पानी कड़ु होतो, ओख हि नहीं पी सक्यो; या वजह ऊ जागा को नाम मारा पड़्यो। <verse eid="EXO 15:23" /><verse number="24" style="v" sid="EXO 15:24" />तब हि यो कह्य क मूसा को खिलाफ बड़ बड़ान लग्यो, “हम का पीबों?” <verse eid="EXO 15:24" /><verse number="25" style="v" sid="EXO 15:25" />तब मूसा न परमेश्वर ख पुकारयो, अऊर परमेश्वर न ओख एक पौधा बतायो, जेक ओन पानी म डाल्यो, त ऊ पानी मीठो भय गयो।</para>
  <para style="p" vid="EXO 15:25">परमेश्वर न उन्को लायी एक विधि अऊर नियम बनायो, अऊर उन्की विश्वास की परीक्षा करी,<verse eid="EXO 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 15:26" />अऊर कह्यो, “यदि तय अपनो परमेश्वर यहोवा को वचन तन मन सी सुनो, अऊर जो ओकी नजर म ठीक हय उच करो, अऊर ओकी आज्ञावों पर कान लगावो, अऊर ओकी सब विधियों ख मानो, त जितनो रोग मय न मिस्रियों पर भेज्यो हंय उन्म सी एक भी तोरो पर नहीं भेजूं; कहालीकि मय तुम्हरो चंगो करन वालो परमेश्वर आय।” <verse eid="EXO 15:26" /><verse number="27" style="v" sid="EXO 15:27" />तब इस्राएली एलीम नाम जागा म आये, जित पानी को बारा झरना अऊर सत्तर खजूर को झाड़ होतो; उत उन्न पानी को जवर डेरा डाल्यो।<verse eid="EXO 15:27" /></para>
  <chapter eid="EXO 15" />
  <chapter number="16" style="c" sid="EXO 16" />
  <para style="s">मन्ना अऊर लावा</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 16:1" />तब इस्राएलियों की पूरी मण्डली एलीम सी निकल क, सीन नाम को जंगल म पहुंच्यो, जो एलीम अऊर सीनै पहाड़ी को बीच म हय, मिस्र देश सी निकल्यो हुयो दोय महीना पन्द्रह दिन हो चुक्यो। <verse eid="EXO 16:1" /><verse number="2" style="v" sid="EXO 16:2" />सुनसान जागा म इस्राएलियों की पूरी मण्डली मूसा अऊर हारून को विरोध म बड़ बड़ान लग्यो। <verse eid="EXO 16:2" /><verse number="3" style="v" sid="EXO 16:3" /><note caller="+" style="x"><char style="xo" closed="false">16:3 </char><char style="xt" closed="false"><ref loc="EXO 14:12">निर्गमन १४:१२</ref>; <ref loc="NUM 11:4">गिनती ११:४</ref></char></note>अऊर इस्राएली उन्को सी कहन लग्यो, “जब हम मिस्र देश म मांस अऊर बहुत सी हान्डियों को जवर बैठ क पेट भर जेवन करत होतो, तब हम परमेश्वर को हाथ सी मार डाल्यो भी जातो त सही होतो; पर तुम हम ख या जागा म पूरो लोगों ख भूख सी मार डालन लायी मिस्र देश सी हम्ख निकाल लायो हय।” <verse eid="EXO 16:3" /><verse number="4" style="v" sid="EXO 16:4" /><note caller="+" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="PSA 78:24">भजन ७८:२४</ref>; <ref loc="PSA 105:40">१०५:४०</ref>; <ref loc="DEU 8:2">व्यवस्थाविवरन ८:२</ref></char></note>तब परमेश्वर न मूसा सी कह्यो, “देखो, मय तुम लोगों लायी स्वर्ग सी जेवन लायी भोजन बरसाऊं; अऊर यो लोग दिन भर पूरेंन इतनोच बाहेर जाय क हर दिन को भोजन जमा करेंन, मय इन्क जाचूं कि यो मोरो बतायो अनुसार वसोच करय का नहीं। <verse eid="EXO 16:4" /><verse number="5" style="v" sid="EXO 16:5" />अऊर असो होयेंन कि छठवो दिन ऊ भोजन पहिलो दिनों सी दोय गुना होयेंन, छठवो दिन ख दोय दिन पूरेंन इतनो तैयार करो।” <verse eid="EXO 16:5" /><verse number="6" style="v" sid="EXO 16:6" />येकोलायी मूसा अऊर हारून न पूरो इस्राएलियों सी कह्यो, “शाम ख तुम जान लेवो कि जो तुम ख मिस्र देश सी निकाल लायो हय ऊ योच परमेश्वर आय, <verse eid="EXO 16:6" /><verse number="7" style="v" sid="EXO 16:7" />अऊर सुबेरे तुम्ख ओको महिमा को तेज दिखेंन, कहालीकि तुम जो परमेश्वर पर बुड़बुड़ावय हय ओख ऊ सुनय हय। अऊर हम का हंय कि तुम हम पर बुड़बुड़ावय हय।” <verse eid="EXO 16:7" /><verse number="8" style="v" sid="EXO 16:8" /><note caller="+" style="x"><char style="xo" closed="false">16:8 </char><char style="xt" closed="false"><ref loc="LUK 10:16">लूका १०:१६</ref></char></note>फिर मूसा न कह्यो, “या तब होयेंन जब परमेश्वर शाम ख तुम्ख खान लायी मांस अऊर सुबेरे पेट भर रोटी देयेंन; कहालीकि तुम जो ओको पर बुड़बुड़ावय हय ओख ऊ सुनय हय। अऊर हम का हंय? तुम्हरो बुड़बुड़ानो हम पर नहीं परमेश्वरच पर होवय हय।” <verse eid="EXO 16:8" /><verse number="9" style="v" sid="EXO 16:9" />फिर मूसा न हारून सी कह्यो, “इस्राएलियों की पूरी मण्डली ख आज्ञा दे कि परमेश्वर को जवर आये, कहालीकि ओन उन्को बुड़बुड़ानो सुन्यो हय।” <verse eid="EXO 16:9" /><verse number="10" style="v" sid="EXO 16:10" />जब हारून इस्राएलियों की पूरी मण्डली सी बात कर रह्यो होतो, कि अचानक उन्न सुनसान जागा की तरफ नजर कर क् देख्यो, अऊर उन्ख परमेश्वर को तेज बादर म दिखायी दियो। <verse eid="EXO 16:10" /><verse number="11" style="v" sid="EXO 16:11" />तब परमेश्वर न मूसा सी कह्यो,<verse eid="EXO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 16:12" />“इस्राएलियों को बुड़बुड़ानो मय न सुन्यो हय; उन्को सी कह्य दे कि हर शाम ख तुम्ख मांस अऊर सुबेरे पेट भर रोटी सी तृप्त होय जावो; अऊर तुम जान जाजो कि मयच तुम्हरो परमेश्वर आय।” <verse eid="EXO 16:12" /><verse number="13" style="v" sid="EXO 16:13" /><note caller="+" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="NUM 11:31">गिनती ११:३१</ref></char></note>तब असो भयो कि शाम ख लावा पक्षी आय क पूरी छावनी पर बैठ गयी; अऊर सुबेरे छावनी को चारयी तरफ ओस गिरी। <verse eid="EXO 16:13" /><verse number="14" style="v" sid="EXO 16:14" />अऊर जब ओस सूख गयी त हि का देखय हंय कि सुनसान जागा पर छोटो छोटो जमी ओस को जसो छोटो कन दिखायी दियो। <verse eid="EXO 16:14" /><verse number="15" style="v" sid="EXO 16:15" /><note caller="+" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="1CO 10:3">१ कुरिन्थियों १०:३</ref></char></note>यो देख क इस्राएली लोग, जो न जानत होतो कि या का चीज आय, कहालीकि हि नहीं जानत होतो कि ऊ का आय। तब मूसा न उन्को सी कह्यो, “या उच जेवन आय जेक परमेश्वर तुम्ख खान लायी देवय हय। <verse eid="EXO 16:15" /><verse number="16" style="v" sid="EXO 16:16" />जो आज्ञा परमेश्वर न दियो हय वा या आय : तुम ओको म सी अपनी जरूरत को अनुसार खान लायी जमा करजो, मतलब तम्बू म रहन वालो अपनो अपनो लोगों की गिनती को अनुसार, हर एक आदमी को पीछु एक एक ओमेर<note caller="+" style="f"><char style="fr" closed="false">16:16 </char><char style="ft" closed="false">लगभग एक किलोग्राम, एक विशेष नाप</char></note> जमा करजो; जेको तम्बू म जितनो हो ऊ उन्कोच लायी जमा करे।” <verse eid="EXO 16:16" /><verse number="17" style="v" sid="EXO 16:17" />अऊर इस्राएलियों न वसोच करयो; अऊर कोयी न अधिक, अऊर कोयी न थोड़ो जमा करयो। <verse eid="EXO 16:17" /><verse number="18" style="v" sid="EXO 16:18" /><note caller="+" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="2CO 8:15">२ कुरिन्थियों ८:१५</ref></char></note>जब उन्न ओको पायली सी नाप्यो, तब जिन्को जवर जरूरत सी जादा होतो ओको जवर अधिक नहीं, अऊर जिन्को जवर थोड़ो होतो उन्को जवर कुछ कम नहीं निकल्यो; कहालीकि हर एक न अपनो जेवन अनुसार जमा करयो होतो। <verse eid="EXO 16:18" /><verse number="19" style="v" sid="EXO 16:19" />फिर मूसा न उन्को सी कह्यो, “कोयी भी येको म सी कल सबेरे लायी बचाय क मत रखो।” <verse eid="EXO 16:19" /><verse number="20" style="v" sid="EXO 16:20" />पर कुछ लोगों न मूसा की बात नहीं मानी; अऊर ओको म सी कुछ बाकी सुबेरे लायी बचायो, त ओख म कीड़ा पड़ गयो अऊर ऊ बास करन लग्यो; तब मूसा उन लोगों पर गुस्सा भयो <verse eid="EXO 16:20" /><verse number="21" style="v" sid="EXO 16:21" />हि हर दिन सुबेरे अपनी जरूरत को अनुसार जेवन लायी मन्ना जमा करत होतो, अऊर जब सूर्य की कड़ी तपन होनो पर ऊ पिघल जात होती। <verse eid="EXO 16:21" /><verse number="22" style="v" sid="EXO 16:22" />फिर असो भयो कि छठवो दिन उन्न दोय गुना, मतलब हर आदमी को पीछु दोय दोय पायली मन्ना जमा कर लियो, तब इस्राएली मण्डली को सब मुखिया न आय क मूसा ख बतायो। <verse eid="EXO 16:22" /><verse number="23" style="v" sid="EXO 16:23" /><note caller="+" style="x"><char style="xo" closed="false">16:23 </char><char style="xt" closed="false"><ref loc="EXO 20:8">निर्गमन २०:८</ref></char></note>तब मूसा न उन्को सी कह्यो, “या वा बात आय जो परमेश्वर न असो कह्यो कि, कहालीकि कल परम आराम, मतलब परमेश्वर लायी पवित्रता को आराम दिन हय, अज तुम्ख जितनो पकानो हय, उतनो पकावों, जितनो उबालनो हय उतनो उबालो, अऊर येको म सी जितनो बचेंन ओख सबेरे लायी रखो।” <verse eid="EXO 16:23" /><verse number="24" style="v" sid="EXO 16:24" />जब उन्न मूसा की आज्ञा को अनुसार सुबेरे तक रख्यो, तब नहीं त ऊ बासो भयो, अऊर नहीं ओको म कीड़ा भयो। <verse eid="EXO 16:24" /><verse number="25" style="v" sid="EXO 16:25" />तब मूसा न कह्यो, “अज परमेश्वर को आराम दिन हय; येकोलायी तुम उच खावो, अज मन्ना मैदान म नहीं मिलेंन। <verse eid="EXO 16:25" /><verse number="26" style="v" sid="EXO 16:26" />छय दिन त तुम ओख जमा करजो; पर सातवों दिन आराम को दिन हय, ओको म ऊ नहीं मिलेंन।” <verse eid="EXO 16:26" /><verse number="27" style="v" sid="EXO 16:27" />तब भी लोगों म सी कोयी कोयी सातवों दिन भी जमा करन बाहेर गयो, पर उन्को कुछ नहीं मिल्यो। <verse eid="EXO 16:27" /><verse number="28" style="v" sid="EXO 16:28" />तब परमेश्वर न मूसा सी कह्यो, “तुम लोग मोरी आज्ञावों अऊर नियमों ख कब तक नहीं मानो? <verse eid="EXO 16:28" /><verse number="29" style="v" sid="EXO 16:29" />परमेश्वर न जो तुम ख आराम को दिन दियो हय, योच वजह ऊ छठवो दिन ख दोय दिन को जेवन तुम्ख देवय हय; येकोलायी तुम अपनो अपनो जागा पर बैठे रहना, सातवों दिन कोयी अपनो जागा सी बाहेर नहीं जावो।” <verse eid="EXO 16:29" /><verse number="30" style="v" sid="EXO 16:30" />येकोलायी लोगों न सातवों दिन आराम करयो। <verse eid="EXO 16:30" /><verse number="31" style="v" sid="EXO 16:31" /><note caller="+" style="x"><char style="xo" closed="false">16:31 </char><char style="xt" closed="false"><ref loc="NUM 11:7">गिनती ११:७</ref></char></note>इस्राएल लोगों न उच चीज को नाम मन्ना रख्यो, समार को दाना जसो सफेद होतो। अऊर ओको स्वाद शहेद सी बन्यो पुवा को जसो होतो। <verse eid="EXO 16:31" /><verse number="32" style="v" sid="EXO 16:32" />फिर मूसा न कह्यो, “परमेश्वर न आज्ञा दियो कि ऊ यो आय कि येख म सी ओमेर भर ‘मन्ना’ अपनो वंश की पीढ़ी पीढ़ी लायी रख छोड़ो, जेकोसी हि जान कि परमेश्वर हम्ख मिस्र देश सी निकाल क सुनसान जागा म कसी रोटी खिलावत होतो।” <verse eid="EXO 16:32" /><verse number="33" style="v" sid="EXO 16:33" /><note caller="+" style="x"><char style="xo" closed="false">16:33 </char><char style="xt" closed="false"><ref loc="HEB 9:4">इब्रानियों ९:४</ref></char></note>तब मूसा न हारून सी कह्यो, “एक बर्तन ले क ओख म ओमेर भर मन्ना ले क ओख परमेश्वर को आगु रख देवो कि ऊ तुम्हरो पीढ़ियों लायी रख्यो रहें।” <verse eid="EXO 16:33" /><verse number="34" style="v" sid="EXO 16:34" />जसो आज्ञा परमेश्वर न मूसा ख दियो होती, ओको को अनुसार हारून न बर्तन ख साक्षी को सन्दूक को आगु रख दियो कि ऊ उत रख्यो रहो। <verse eid="EXO 16:34" /><verse number="35" style="v" sid="EXO 16:35" /><note caller="+" style="x"><char style="xo" closed="false">16:35 </char><char style="xt" closed="false"><ref loc="JOS 5:12">यहोशू ५:१२</ref></char></note> इस्राएलियों लोग जब ऊ देश म नहीं पहुंच्यो तब तक, मतलब लोगों न चालीस साल तक मन्ना खातो रह्यो; हि जब तक कनान देश की सीमा पर नहीं पहुंच्यो तब तक मन्ना खात रह्यो। <verse eid="EXO 16:35" /><verse number="36" style="v" sid="EXO 16:36" />एक ओमेर मतलब पायली त एपा<note caller="+" style="f"><char style="fr" closed="false">16:36 </char><char style="ft" closed="false">एक विशेष नाप, दस किलोग्राम</char></note> को दसवा हिस्सा आय।<verse eid="EXO 16:36" /></para>
  <chapter eid="EXO 16" />
  <chapter number="17" style="c" sid="EXO 17" />
  <para style="s">चट्टान सी पानी</para>
  <para style="r">(<ref loc="NUM 20:1-13">गिनती २०:१-१३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 17:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">17:1 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 33:12">गिनती ३३:१२</ref>,<ref loc="NUM 33:14">१४</ref></char>
    </note>फिर इस्राएलियों की पूरी मण्डली सीन नाम को सुनसान जागा सी निकली, अऊर जागा जागा म डेरा डालतो हुयो आगु बढ़ी अऊर परमेश्वर को आज्ञा सी सब रपीदीम की जागा म अपनो डेरा डाल्यो; उत उन लोगों लायी पीवन को पानी नहीं होतो। <verse eid="EXO 17:1" /><verse number="2" style="v" sid="EXO 17:2" /><note caller="+" style="x"><char style="xo" closed="false">17:2 </char><char style="xt" closed="false"><ref loc="NUM 20:3">गिनती २०:३</ref>; <ref loc="DEU 3:16">व्यवस्थाविवरन ३:१६</ref></char></note>येकोलायी हि मूसा सी वाद विवाद करन लग्यो, “हम्ख पीवन लायी पानी देवो।” मूसा न उन्को सी कह्यो, “तुम लोग मोरो सी कहाली वाद विवाद करय हय? अऊर परमेश्वर की परीक्षा कहाली करय हय?” <verse eid="EXO 17:2" /><verse number="3" style="v" sid="EXO 17:3" />फिर उत लोगों ख पानी कि बहुत प्यास लगी, तब हि या कह्य क मूसा पर कुड़कुड़ान लग्यो, “तय हम्ख बाल-बच्चां अऊर जनावरों समेत प्यासो मार डालन लायी मिस्र देश सी कहाली लायो हय?” <verse eid="EXO 17:3" /><verse number="4" style="v" sid="EXO 17:4" />तब मूसा न परमेश्वर सी बिनती करी, अऊर कह्यो, “इन लोगों को संग का करूं? हि सब मोर पर गोटा सी मारन लायी तैयार हंय।” <verse eid="EXO 17:4" /><verse number="5" style="v" sid="EXO 17:5" />परमेश्वर न मूसा सी कह्यो, “इस्राएलियों को बुजूर्ग मुखिया म सी कुछ ख अपनो संग ले क लोगों को आगु आगु बढ़, तय अपनो हाथ म उच लाठी ख ले क जाजो जेकोसी तय न नील नदी पर मारयो होतो। <verse eid="EXO 17:5" /><verse number="6" style="v" sid="EXO 17:6" />मय तोरो आगु चल क होरेब पहाड़ी की एक चट्टान पर खड़ो रहूं; अऊर तय उच चट्टान पर लाठी मारजो, तब ओको म सी पानी निकलेंन, जेकोसी लोग पानी पी सकेंन।” तब मूसा न इस्राएल को मुखिया लोगों को आगु वसोच करयो। <verse eid="EXO 17:6" /><verse number="7" style="v" sid="EXO 17:7" />अऊर मूसा न ऊ जागा को नाम मस्सा<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="ft" closed="false">परीक्षा</char></note> अऊर मरीबा<note caller="+" style="f"><char style="fr" closed="false">17:7 </char><char style="ft" closed="false">झगड़ा</char></note> रख्यो, कहालीकि इस्राएलियों न उत मूसा सी वाद विवाद करयो होतो, अऊर परमेश्वर की परीक्षा करी कि “का परमेश्वर हमरो बिच हय यां नहीं?”<verse eid="EXO 17:7" /></para>
  <para style="s">अमालेकियों पर युद्ध</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 17:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">17:8 </char>
      <char style="xt" closed="false">
        <ref loc="1SA 15:2">१ शमूएल १५:२</ref>
      </char>
    </note>तब अमालेकी जाति को लोग आय क रपीदीम जागा म इस्राएलियों सी लड़न लग्यो। <verse eid="EXO 17:8" /><verse number="9" style="v" sid="EXO 17:9" />तब मूसा न यहोशू सी कह्यो, “हमरो लायी कुछ आदमियों ख चुन ले कि बाहेर जाय क अमालेकियों सी लड़े; अऊर मय कल परमेश्वर की लाठी हाथ म पकड़ क पहाड़ी की सेंडी पर खड़ो रहूं।” <verse eid="EXO 17:9" /><verse number="10" style="v" sid="EXO 17:10" />मूसा की या आज्ञा को अनुसार यहोशू अमालेकियों सी लड़न गयो; अऊर मूसा, हारून, अऊर हूर पहाड़ी की सेंडी पर चढ़ गयो। <verse eid="EXO 17:10" /><verse number="11" style="v" sid="EXO 17:11" /><note caller="+" style="x"><char style="xo" closed="false">17:11 </char><char style="xt" closed="false"><ref loc="PSA 44:6">भजन ४४:६</ref>; <ref loc="JAS 5:16">याकूब ५:१६</ref></char></note>जब तक मूसा अपनो हाथ उठायो रहत होतो तब तक त इस्राएल को लोग लड़ाई जीतत होतो; पर जब जब ऊ ओख नीचो करतो तब तब अमालेक जीतत होतो। <verse eid="EXO 17:11" /><verse number="12" style="v" sid="EXO 17:12" />पर जब मूसा को हाथ थक गयो, तब उन्न एक गोटा ले क मूसा को नीचे रख दियो, अऊर ऊ ओख पर बैठ गयो, अऊर हारून अऊर हूर उन्को हाथ सम्भालतो रह्यो; एक दायो बाजू अऊर दूसरो बायो बाजू अऊर ओको हाथ सूरज डुबन तक उठ्यो रह्यो। <verse eid="EXO 17:12" /><verse number="13" style="v" sid="EXO 17:13" />अऊर यहोशू न अपनो तलवार को दम सी अमालेकी जाति ख हराय दियो।<verse eid="EXO 17:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 17:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">17:14 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 25:17-19">व्यवस्थाविवरन २५:१७-१९</ref>; <ref loc="1SA 15:2-9">१ शमूएल १५:२-9</ref></char>
    </note>तब परमेश्वर न मूसा सी कह्यो, “लड़ाई म जीत की बात यादगार लायी किताब म लिख लेवो अऊर यहोशू ख बताय देवो कि मय आसमान को नीचो सी अमालेक को यादगार चिन्ह पूरो रीति सी मिटाय डालूं।” <verse eid="EXO 17:14" /><verse number="15" style="v" sid="EXO 17:15" />तब मूसा न एक वेदी बनाय क ओको नाम “यहोवा निस्सी<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="ft" closed="false">परमेश्वर मोरो झन्डा</char></note> रख्यो;” <verse eid="EXO 17:15" /><verse number="16" style="v" sid="EXO 17:16" />मूसा न कह्यो, “परमेश्वर न कसम खायी हय, कि परमेश्वर अमालेकियों सी पीढ़ियों तक लड़ाई करतो रहेंन।”<verse eid="EXO 17:16" /></para>
  <chapter eid="EXO 17" />
  <chapter number="18" style="c" sid="EXO 18" />
  <para style="s">ससरो को मूसा सी मिलनो</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 18:1" />जब मूसा को ससरो यित्रो जो मिद्यान देश को याजक न उन कामों को बारे म सुन्यो जो परमेश्वर न मूसा अऊर अपनो इस्राएल को लोगों लायी कसो इस्राएलियों ख मिस्र देश सी बाहेर निकाल्यो, <verse eid="EXO 18:1" /><verse number="2" style="v" sid="EXO 18:2" />तब मूसा को ससरो यित्रो अऊर मूसा की पत्नी सिप्पोरा ख, पहिलेच ओको मायको भेज दियो होतो, <verse eid="EXO 18:2" /><verse number="3" style="v" sid="EXO 18:3" /><note caller="+" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="EXO 21:22">निर्गमन २१:२२</ref>; <ref loc="ACT 7:29">प्रेरितों ७:२९</ref></char></note>अऊर ओको दोयी टुरा ख भी संग लायो; इन म सी एक टुरा को नाम यो कह्य क गेर्शोम रख्यो होतो, “मय दूसरो देश म परदेशी हय।” <verse eid="EXO 18:3" /><verse number="4" style="v" sid="EXO 18:4" />अऊर दूसरो को नाम एलीएजेर<note caller="+" style="f"><char style="fr" closed="false">18:4 </char><char style="ft" closed="false">मोरो परमेश्वर सहायक हय</char></note> रख्यो, “मोरो बाप को परमेश्वर न मोरी मदत कर क् मोख मिस्र को फिरौन राजा की तलवार सी बचायो।” <verse eid="EXO 18:4" /><verse number="5" style="v" sid="EXO 18:5" />मूसा को ससरो यित्रो, मूसा की पत्नी अऊर ओको दोय टुरा ख, संग ले क मूसा को जवर सुनसान जागा म गयो, जित परमेश्वर को पहाड़ी को जवर ओको डेरा होतो। <verse eid="EXO 18:5" /><verse number="6" style="v" sid="EXO 18:6" />अऊर ओन मूसा को जवर अपनी बात भेजी, “मय तोरो ससरो यित्रो आय, अऊर दोयी टुरावों सहित तोरी पत्नी ख तोरो जवर लाय रह्यो हय।” <verse eid="EXO 18:6" /><verse number="7" style="v" sid="EXO 18:7" />येकोलायी तब मूसा अपनो ससरो सी मुलाखात करन लायी निकल्यो, अऊर ओख झुक क सत्कार करयो अऊर चुम्यो; अऊर हि एक दूसरो को कुशल मंगल पूछतो हुयो डेरा पर आय गयो। <verse eid="EXO 18:7" /><verse number="8" style="v" sid="EXO 18:8" />मूसा न अपनो ससरो यित्रो ख हर उन सब कार्य को वर्णन सुनायो जो परमेश्वर न इस्राएलियों की मदत लायी फिरौन अऊर मिस्रियों को संग जो करयो होतो, अऊर इस्राएलियों न यात्रा म जो कष्ट उठायो ओको सी परमेश्वर उन्ख कसो छुड़ायो हय। <verse eid="EXO 18:8" /><verse number="9" style="v" sid="EXO 18:9" />तब यित्रो न वा पूरी भलायी को वजह जो परमेश्वर न इस्राएलियों को संग करी होतो, की उन्ख मिस्रियों को हाथ सी छुड़ायो होतो, खुश होय क कह्यो, <verse eid="EXO 18:9" /><verse number="10" style="v" sid="EXO 18:10" />यित्रो न कह्यो “धन्य हय परमेश्वर, जेन तुम ख फिरौन अऊर मिस्रियों को वश सी छुड़ायो, जेन तुम लोगों ख गुलामी सी मिस्रियों को हाथ सी छुड़ायो हय। <verse eid="EXO 18:10" /><verse number="11" style="v" sid="EXO 18:11" />अब मय न जान लियो हय कि यहोवा सब देवतावों सी बड़ो हय; बल्की ओको बारे म भी जेकोसी उन्न इस्राएलियों को संग अहंकारपूर्न व्यवहार करयो होतो।” <verse eid="EXO 18:11" /><verse number="12" style="v" sid="EXO 18:12" />तब मूसा को ससरो यित्रो न परमेश्वर लायी होमबलि अऊर मेलबलि चढ़ाये, अऊर हारून इस्राएलियों को सब बुजूर्ग समेत मूसा को ससरो यित्रो को संग परमेश्वर को आगु जेवन करन ख आयो।<verse eid="EXO 18:12" /></para>
  <para style="s">न्यायधिसों ख चुननो</para>
  <para style="r">(<ref loc="DEU 1:9-18">व्यवस्थाविवरन १:९-१८</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 18:13" />दूसरो दिन मूसा लोगों को न्याय करन ख बैठ्यो, अऊर सबेरे सी शाम तक लोग मूसा को आस पास खड़े रह्यो। <verse eid="EXO 18:13" /><verse number="14" style="v" sid="EXO 18:14" />जब मूसा को ससरो न उन लोगों को न्याय करतो देख्यो तब उन्को सी पुच्छ्यो “यो का काम हय जो तुम लोगों लायी करय हय? का वजह हय कि तुम अकेलो बैठ्यो रह्य हय, अऊर लोग सबेरे सी शाम तक तोरो आस पास खड़ो रह्य हंय?” <verse eid="EXO 18:14" /><verse number="15" style="v" sid="EXO 18:15" />मूसा न अपनो ससरो सी कह्यो, “येको वजह यो हय कि लोग मोरो जवर परमेश्वर की इच्छा सिखन आवय हंय। <verse eid="EXO 18:15" /><verse number="16" style="v" sid="EXO 18:16" />जब जब उन्को कोयी वाद विवाद होवय हय तब तब हि मोरो जवर आवय हंय, अऊर मय उन्को बिच न्याय करू हय, अऊर परमेश्वर की विधि अऊर व्यवस्था उन्ख समझाऊ हय।” <verse eid="EXO 18:16" /><verse number="17" style="v" sid="EXO 18:17" />मूसा को ससरो न ओको सी कह्यो, “जो काम तय करय हय, ऊ ठीक नहाय। <verse eid="EXO 18:17" /><verse number="18" style="v" sid="EXO 18:18" /><note caller="+" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="NUM 11:14">गिनती ११:१४</ref>; <ref loc="DEU 1:9">व्यवस्थाविवरन १:९</ref></char></note>येकोसी तय का, बल्की हि लोग भी जो तोरो संग हंय निश्चय थक जायेंन, कहालीकि यो काम तोरो लायी बहुत भारी हय; तय येख अकेलो नहीं कर सकय। <verse eid="EXO 18:18" /><verse number="19" style="v" sid="EXO 18:19" />येकोलायी अब मोरी सुन ले, मय तोख सम्मति देऊ हय, परमेश्वर तोरो संग रहेंन! तय इन लोगों लायी परमेश्वर को सामने जायो कर, अऊर इन्को मुकद्दमा ख परमेश्वर को जवर तय पहुंचाय दियो कर। <verse eid="EXO 18:19" /><verse number="20" style="v" sid="EXO 18:20" />इन्क विधि अऊर व्यवस्था प्रगट कर क्, जो रस्ता पर इन्क चलनो, अऊर जो जो काम इन ख करनो हय, ऊ इन ख बता दियो कर। <verse eid="EXO 18:20" /><verse number="21" style="v" sid="EXO 18:21" />फिर तय इन सब इस्राएली लोगों म सी असो आदमियों ख चुन ले, जो गुनी अऊर परमेश्वर को डर मानन वालो, सच्चो, अऊर अन्याय को लाभ सी घृना करन वालो होना; अऊर इन ख हजार-हजार, सौ-सौ, पचास-पचास, अऊर दस-दस लोगों पर मुखिया बनाय दे। <verse eid="EXO 18:21" /><verse number="22" style="v" sid="EXO 18:22" />अऊर हि सब समय इन लोगों को न्याय करतो रहे; अऊर सब बड़ो बड़ो मुकद्दमा ख त तोरो जवर लायो करे; तब तोरो बोझ हल्को होयेंन, कहालीकि यो बोझ ख हि भी तोरो संग उठायेंन। <verse eid="EXO 18:22" /><verse number="23" style="v" sid="EXO 18:23" />यदि तय यो उपाय करजो, अऊर परमेश्वर तोख असी आज्ञा दे, त तय ठहर सकजो, अऊर हि सब लोग अपनो जागा म शान्ति सी पहुंच सकेंन।”<verse eid="EXO 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 18:24" />अपनो ससरो की या बात मान क मूसा न ओको सब वचनों को अनुसार करयो। <verse eid="EXO 18:24" /><verse number="25" style="v" sid="EXO 18:25" />मूसा न सब इस्राएल म सी बुद्धि मान आदमियों ख चुन क उन्ख हजार-हजार, सौ-सौ, पचास-पचास, दस-दस लोगों को ऊपर मुखिया ठहरायो। <verse eid="EXO 18:25" /><verse number="26" style="v" sid="EXO 18:26" />अऊर हि सब लोगों को न्याय करन लग्यो; जो विवाद कठिन होतो ओख हि मूसा को जवर लावत होतो, अऊर सब छोटो विवाद को न्याय हि खुदच करत होतो। <verse eid="EXO 18:26" /><verse number="27" style="v" sid="EXO 18:27" />तब मूसा न अपनो ससरो ख बिदा करयो, अऊर ऊ अपनो देश वापस जान लग्यो।<verse eid="EXO 18:27" /></para>
  <chapter eid="EXO 18" />
  <chapter number="19" style="c" sid="EXO 19" />
  <para style="s">इस्राएली सीनै पहाड़ी को जवर</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 19:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:1 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 33:15">गिनती ३३:१५</ref>
      </char>
    </note>इस्राएली लोग मिस्र देश सी निकलनो को तीन महीना को बाद सीनै को सुनसान जागा म आयो। <verse eid="EXO 19:1" /><verse number="2" style="v" sid="EXO 19:2" />अऊर जब हि रपीदीम सी निकल क सीनै को सुनसान जागा म आये, तब उतच होरेब मतलब सीनै पहाड़ी को तरफ इस्राएलियों न डेरा डाल्यो। <verse eid="EXO 19:2" /><verse number="3" style="v" sid="EXO 19:3" /><note caller="+" style="x"><char style="xo" closed="false">19:3 </char><char style="xt" closed="false"><ref loc="DEU 32:11">व्यवस्थाविवरन ३२:११</ref>; <ref loc="ISA 63:9">यशायाह ६३:९</ref></char></note>अऊर तब मूसा पहाड़ी पर परमेश्वर सी मिलन चढ़ गयो, अऊर उत सी परमेश्वर न ओख बोल्यो, “याकूब को घरानों सी असो कहो, अऊर इस्राएलियों लोगों ख मोरो यो वचन सुना, <verse eid="EXO 19:3" /><verse number="4" style="v" sid="EXO 19:4" />‘तुम लोगों न देख्यो हय कि मय न मिस्रियों सी का का करयो; जसो गरूड़ पक्षी को पंखा पर चढ़ाय क अपनो जवर लायो। <verse eid="EXO 19:4" /><verse number="5" style="v" sid="EXO 19:5" /><note caller="+" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="DEU 4:20">व्यवस्थाविवरन ४:२०</ref>; <ref loc="DEU 7:6">७:६</ref>; <ref loc="DEU 10:15">१०:१५</ref>; <ref loc="TIT 2:14">तीतुस २:१४</ref> </char></note>येकोलायी अब यदि तुम मोरी आज्ञा मानजो, अऊर मोरी वाचा को पालन करजो, त सब लोगों म सी तुमच मोरो निजी धन ठहरेंन; पूरो धरती त मोरीच आय। <verse eid="EXO 19:5" /><verse number="6" style="v" sid="EXO 19:6" /><note caller="+" style="x"><char style="xo" closed="false">19:6 </char><char style="xt" closed="false"><ref loc="REV 1:6">प्रकाशितवाक्य १:६</ref>; <ref loc="REV 5:10">५:१०</ref></char></note>अऊर तुम मोरी नजर म याजकों को राज्य अऊर पवित्र राष्ट्र ठहरेंन।’ मूसा जो बात तोख इस्राएलियों सी कहनो हंय हि योच आय।”<verse eid="EXO 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 19:7" />तब मूसा न आय क इस्राएली लोगों को बुजूर्गों ख बुलायो, अऊर या सब बात, जेक कहन की आज्ञा परमेश्वर न ओख दियो होतो, उन्को समझाय दियो। <verse eid="EXO 19:7" /><verse number="8" style="v" sid="EXO 19:8" /><note caller="+" style="x"><char style="xo" closed="false">19:8 </char><char style="xt" closed="false"><ref loc="JOS 24:14">यहोशू २४:१४</ref></char></note>अऊर सब लोग एक संग उत्तर दियो, “जो कुछ परमेश्वर न कह्यो हय ऊ सब हम करबोंन।” लोगों की या बात मूसा न परमेश्वर ख सुनायी। <verse eid="EXO 19:8" /><verse number="9" style="v" sid="EXO 19:9" />तब परमेश्वर न मूसा सी कह्यो, “सुन, मय कारो बादर अन्धारो म सी होय क तोरो जवर आऊ हय, येकोलायी कि जब मय तोरो सी बात करूं तब हि लोग सुने, अऊर हमेशा तोरो पर विश्वास करे।” अऊर मूसा न परमेश्वर सी लोगों की बात बतायी। <verse eid="EXO 19:9" /><verse number="10" style="v" sid="EXO 19:10" />तब परमेश्वर न मूसा सी कह्यो, “लोगों को जवर जावो अऊर उन्ख अज अऊर कल पवित्र करजो, अऊर हि अपनो कपड़ा धोय ले, <verse eid="EXO 19:10" /><verse number="11" style="v" sid="EXO 19:11" />अऊर हि तीसरो दिन तक तैयार होय जाये; कहालीकि तीसरो दिन परमेश्वर सब लोगों को आखी को देखतो सीनै पहाड़ी पर उतरेंन। <verse eid="EXO 19:11" /><verse number="12" style="v" sid="EXO 19:12" /><note caller="+" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="HEB 12:20">इब्रानियों १२:२०</ref></char></note>अऊर तय लोगों लायी चारयी तरफ एक सीमा रेसा खीच देजो, अऊर उन्को सी कह्यजो, ‘तुम सावधान रहजो कि पहाड़ी पर न चढ़जो अऊर ओकी सीमा ख भी नहीं छूयजो; अऊर जो कोयी पहाड़ी ख छूयेंन ऊ निश्चय मार डाल्यो जायेंन। <verse eid="EXO 19:12" /><verse number="13" style="v" sid="EXO 19:13" />ओख कोयी हाथ सी नहीं छुये; जो छूयेंन ओख गोटा सी मारयो जायेंन, या ओख तीरों सी छेद्यो जायेंन; चाहे जनावर होय चाहे आदमी, ऊ जीन्दो नहीं बचेंन।’ जब मेंढा को सींग को नरसिंगा वालो शब्द तक सुनायी दे, तब लोग पहाड़ी पर चढ़ेंन।”<verse eid="EXO 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 19:14" />तब मूसा पहाड़ी सी उतर क लोगों को जवर आय क उन्ख पवित्र करयो, अऊर लोगों न अपनो कपड़ा धोयो। <verse eid="EXO 19:14" /><verse number="15" style="v" sid="EXO 19:15" />अऊर मूसा न लोगों सी कह्यो, “तीसरो दिन तक तैयार होय जावो, आदमियों न बाईयों सी सहवास नहीं करे।”<verse eid="EXO 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 19:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:16 </char>
      <char style="xt" closed="false">
        <ref loc="REV 4:5">प्रकाशितवाक्य ४:५</ref>
      </char>
    </note>जब तीसरो दिन आयो तब सुबेरे होतोच बादर गर्जन अऊर बिजली चमकन लग्यो, अऊर पहाड़ी पर कारो ढ़ग छाय गयो, फिर तुरही को बड़ो भारी आवाज भयो, अऊर डेरा म जितनो लोग होतो सब डर गयो। <verse eid="EXO 19:16" /><verse number="17" style="v" sid="EXO 19:17" /><note caller="+" style="x"><char style="xo" closed="false">19:17 </char><char style="xt" closed="false"><ref loc="DEU 4:10">व्यवस्थाविवरन ४:१०</ref></char></note>तब मूसा लोगों ख परमेश्वर सी मिलान लायी डेरा सी निकाल लायो, अऊर हि पहाड़ी को नीचे खड़ो भय गयो। <verse eid="EXO 19:17" /><verse number="18" style="v" sid="EXO 19:18" /><note caller="+" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="PSA 18:8">भजन १८:८</ref></char></note>अऊर परमेश्वर जो आगी म होय क सीनै पहाड़ी पर उतरो होतो, या वजह पूरो पहाड़ी धुवा सी भर गयो; अऊर ओको धुवा भट्टा जसो उठ रह्यो होतो, अऊर पूरो पहाड़ी बहुत काप रह्यो होतो। <verse eid="EXO 19:18" /><verse number="19" style="v" sid="EXO 19:19" />फिर जब नरसिंगा को आवाज तेज बढ़तो, गयो, तब मूसा बोल्यो, अऊर परमेश्वर न बादर गर्जन की आवाज जसो ओको उत्तर दियो। <verse eid="EXO 19:19" /><verse number="20" style="v" sid="EXO 19:20" />अऊर परमेश्वर सीनै पहाड़ी की सेंडी पर सी खल्लो उतरयो; अऊर मूसा ख पहाड़ी की सेंडी पर बुलायो, अऊर मूसा ऊपर गयो। <verse eid="EXO 19:20" /><verse number="21" style="v" sid="EXO 19:21" />तब परमेश्वर न मूसा सी कह्यो, “नीचे उतर क् लोगों ख चेतावनी दे, कहीं असो नहीं हय कि हि बाड़ा तोड़ क परमेश्वर को जवर देखन ख घुसयो, अऊर उन्म सी बहुत सो नाश होय जायेंन। <verse eid="EXO 19:21" /><verse number="22" style="v" sid="EXO 19:22" />अऊर याजक जो परमेश्वर को जवर आन वालो हंय हि भी अपनो आप ख पवित्र करेंन, कहीं असो नहीं होय कि मय उन ख सजा दे देऊ।” <verse eid="EXO 19:22" /><verse number="23" style="v" sid="EXO 19:23" />मूसा न परमेश्वर सी कह्यो, “हि लोग सीनै पहाड़ी पर नहीं चढ़ सकय; तुम न त खुद हम ख यो कह्य क चितायो कि पहाड़ी को चारयी तरफ बाड़ा बान्ध क ओख पवित्र रखो।” <verse eid="EXO 19:23" /><verse number="24" style="v" sid="EXO 19:24" />परमेश्वर न मूसा सी कह्यो, “तय जा, अऊर हारून ख ले आव। पर याजक अऊर साधारन लोग परमेश्वर को बाड़ा तोड़न चढ़ क आये, असो नहीं होय कि मय उन ख सजा देऊं।” <verse eid="EXO 19:24" /><verse number="25" style="v" sid="EXO 19:25" />या बात मूसा पहाड़ी सी उतर क् लोगों ख सुनायी।<verse eid="EXO 19:25" /></para>
  <chapter eid="EXO 19" />
  <chapter number="20" style="c" sid="EXO 20" />
  <para style="s">दस आज्ञाये</para>
  <para style="r">(<ref loc="DEU 5:1-21">व्यवस्थाविवरन ५:१-२१</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 20:1" />तब परमेश्वर न यो सब वचन कह्यो : <verse eid="EXO 20:1" /><verse number="2" style="v" sid="EXO 20:2" />“मय तोरो परमेश्वर यहोवा आय, जो तोख मिस्र देश की, गुलामी सी बाहेर निकाल्यो हय।<verse eid="EXO 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 20:3" />“तुम मोख छोड़ क कोयी दूसरो ख ईश्वर कर क् नहीं मानजो।<verse eid="EXO 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 20:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">20:4 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 34:17">निर्गमन ३४:१७</ref>; <ref loc="LEV 19:4">लैव्यव्यवस्था १९:४</ref></char>
    </note>“तय अपनो लायी कोयी मूर्ति नहीं बनावो, न कोयी की मूर्ती बनावो, जो आसमान म, यां धरती पर, या धरती को खल्लो पानी म हय। <verse eid="EXO 20:4" /><verse number="5" style="v" sid="EXO 20:5" /><note caller="+" style="x"><char style="xo" closed="false">20:5 </char><char style="xt" closed="false"><ref loc="DEU 7:9">व्यवस्थाविवरन ७:९</ref></char></note>तय उन्को दण्डवत नहीं करजो, अऊर नहीं उन्की उपासना करजो; कहालीकि मय तोरो परमेश्वर यहोवा जलन रखन वालो परमेश्वर आय, अऊर जो मोरो सी दुश्मनी रखय हंय, उन्को टुरा, नाती, अऊर पन्ती ख भी पीढ़ी को अधर्म को दण्ड देऊ हय, <verse eid="EXO 20:5" /><verse number="6" style="v" sid="EXO 20:6" />अऊर जो मोरो सी प्रेम रखय अऊर मोरी आज्ञावों ख मानय हंय, उन हजार पीढ़ियों पर दया करू हय।<verse eid="EXO 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 20:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">20:7 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 19:12">लैव्यव्यवस्था १९:१२</ref>
      </char>
    </note>“तय अपनो परमेश्वर को नाम व्यर्थ नहीं लेजो; कहालीकि जो परमेश्वर को नाम बिन काम को लेवय ऊ ओख निर्दोष नहीं ठहरायेंन।<verse eid="EXO 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 20:8" />“तुम आराम दिन ख पवित्र मानन लायी याद रखजो। <verse eid="EXO 20:8" /><verse number="9" style="v" sid="EXO 20:9" /><note caller="+" style="x"><char style="xo" closed="false">20:9 </char><char style="xt" closed="false"><ref loc="EXO 23:12">निर्गमन २३:१२</ref>; <ref loc="EXO 34:12">३४:१२</ref>; <ref loc="EXO 35:2">३५:२</ref>; <ref loc="EXO 31:15">३१:१५</ref>; <ref loc="LEV 23:5">लैव्यव्यवस्था २३:५</ref></char></note>छय दिन त तुम मेहनत करजो, अपनो सब काम-काज करजो, <verse eid="EXO 20:9" /><verse number="10" style="v" sid="EXO 20:10" />पर सातवों दिन तोरो परमेश्वर लायी आराम दिन हय। उन्म नहीं त तुम कोयी भी काम-काज करजो, अऊर नहीं तोरो टुरा-टुरी, सेवक-सेविका, जनावर, अऊर कोयी परदेशी जो तोरो फाटकों को अन्दर रहन वालो हो। <verse eid="EXO 20:10" /><verse number="11" style="v" sid="EXO 20:11" /><note caller="+" style="x"><char style="xo" closed="false">20:11 </char><char style="xt" closed="false"><ref loc="GEN 2:1-3">उत्पत्ति २:१-३</ref>; <ref loc="EXO 31:17">निर्गमन ३१:१७</ref></char></note>कहालीकि छय, दिन म परमेश्वर न आसमान, अऊर धरती, अऊर समुन्दर, अऊर जो कुछ उन्म हंय, सब ख बनायो, अऊर सातवों दिन आराम करयो; या वजह परमेश्वर न आराम दिन ख आशीष दियो अऊर पवित्र ठहरायो।<verse eid="EXO 20:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 20:12" />“तुम अपनो माय-बाप को आदर करजो, जेकोसी जो देश तोरो परमेश्वर तोख देवय हय ओख म तुम बहुत दिन तक रहनो पाये।<verse eid="EXO 20:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 20:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">20:13 </char>
      <char style="xt" closed="false">
        <ref loc="GEN 6:9">उत्पत्ति ६:९</ref>; <ref loc="LEV 24:17">लैव्यव्यवस्था २४:१७</ref>; <ref loc="MAT 5:21">मत्ती ५:२१</ref>; <ref loc="MAT 19:18">१९:१८</ref>; <ref loc="MRK 10:19">मरकुस १०:१९</ref>; <ref loc="LUK 18:20">लूका १८:२०</ref>; <ref loc="ROM 13:9">रोमियों १३:९</ref>; <ref loc="JAS 2:11">याकूब २:११</ref></char>
    </note>“तय खून नहीं करजो।<verse eid="EXO 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 20:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">20:14 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 20:10">लैव्यव्यवस्था २०:१०</ref>; <ref loc="MAT 5:27">मत्ती ५:२७</ref>; <ref loc="MAT 19:18">१९:१८</ref>; <ref loc="MRK 10:19">मरकुस १०:१९</ref>; <ref loc="LUK 18:20">लूका १८:२०</ref>; <ref loc="ROM 13:9">रोमियों १३:९</ref>; <ref loc="JAS 2:11">याकूब २:११</ref></char>
    </note>“तुम व्यभिचार नहीं करजो।<verse eid="EXO 20:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 20:15" />“तुम चोरी नहीं करजो।<verse eid="EXO 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 20:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">20:16 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 23:1">निर्गमन २३:१</ref>; <ref loc="MAT 19:18">मत्ती १९:१८</ref>; <ref loc="MRK 10:19">मरकुस १०:१९</ref>; <ref loc="LUK 18:20">लूका १८:२०</ref></char>
    </note>“तुम कोयी को खिलाफ झूठी गवाही नहीं देजो।<verse eid="EXO 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 20:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">20:17 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 7:7">रोमियों ७:७</ref>; <ref loc="ROM 13:9">१३:९</ref></char>
    </note>“तुम कोयी को घर को लालच नहीं करजो; नहीं त कोयी की बाई को लालच करजो, अऊर नहीं कोयी को दास-दासी यां बईल-गधा को, नहीं कोयी की कोयी चीज को लालच करजो।”<verse eid="EXO 20:17" /></para>
  <para style="s">लोगों को डर</para>
  <para style="r">(<ref loc="DEU 5:22-33">व्यवस्थाविवरन ५:२२-३३</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 20:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">20:18 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 12:18">इब्रानियों १२:१८</ref>
      </char>
    </note>सब लोग गर्जन अऊर बिजली अऊर तुरही को आवाज सुनय, अऊर धुवा उठतो हुयो पहाड़ी ख देखतो रह्यो, तब डर क कापतो हुयो दूर खड़ो होय गयो; <verse eid="EXO 20:18" /><verse number="19" style="v" sid="EXO 20:19" /><note caller="+" style="x"><char style="xo" closed="false">20:19 </char><char style="xt" closed="false"><ref loc="HEB 12:18-19">इब्रानियों १२:१८-१९</ref></char></note>अऊर हि मूसा सी कहन लग्यो, “तयच हम सी बात कर, हम तोरो सी सुनबों; पर परमेश्वर ख हम सी बात मत करन दे, असो नहीं हो कि हम मर जाबोंन।” <verse eid="EXO 20:19" /><verse number="20" style="v" sid="EXO 20:20" />मूसा न लोगों सी कह्यो, “डरो मत; कहालीकि परमेश्वर येकोलायी आयो हय कि तुम्हरी परीक्षा करे, अऊर ओको डर तुम्हरो मन म बन्यो रहें कि तुम पाप नहीं करो।” <verse eid="EXO 20:20" /><verse number="21" style="v" sid="EXO 20:21" />पर हि लोग दूरच खड़ो रह्यो पर मूसा घोर अन्धकार को जवर गयो जित परमेश्वर होतो।<verse eid="EXO 20:21" /></para>
  <para style="s">वेदी को बारे म नियम</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 20:22" />तब परमेश्वर न मूसा सी कह्यो, “तुम इस्राएलियों ख यो वचन सुनाव, तुम न खुदच देख्यो हय कि मय न स्वर्ग सी तुम सी बाते करी हंय। <verse eid="EXO 20:22" /><verse number="23" style="v" sid="EXO 20:23" />तुम मोरो अलावा कोयी ख सामिल मत करजो, मतलब अपनो लायी चांदी अऊर सोना सी देवतावों की मूर्तियां ख मत बनाजो। <verse eid="EXO 20:23" /><verse number="24" style="v" sid="EXO 20:24" />मोरो लायी माटी की एक वेदी बनाजो, अऊर अपनी मेंढी-शेरी अऊर गाय-बईलों को होमबलि अऊर मेलबलि ख ओको पर चढ़ाजो; जहां जहां मय अपनो नाम को याद कराऊं वहां वहां मय आय क तुम्ख आशीष देऊं। <verse eid="EXO 20:24" /><verse number="25" style="v" sid="EXO 20:25" /><note caller="+" style="x"><char style="xo" closed="false">20:25 </char><char style="xt" closed="false"><ref loc="DEU 27:5">व्यवस्थाविवरन २७:५</ref>; <ref loc="JOS 8:31">यहोशू ८:३१</ref></char></note>अऊर यदि तुम मोरो लायी गोटा सी वेदी बनाजो, गोटा म अवजार सी छेदायी कर क् नहीं बनावो; कहालीकि तुम न ओख पर हथियार लगानो सी अशुद्ध होय जायेंन। <verse eid="EXO 20:25" /><verse number="26" style="v" sid="EXO 20:26" />अऊर मोरी वेदी पर सीढ़ी लगाय क मत चढ़जो, कुछ असो नहीं हो कि तोरो शरीर को नंगोपन ओको पर दिख पड़ेंन।”<verse eid="EXO 20:26" /></para>
  <chapter eid="EXO 20" />
  <chapter number="21" style="c" sid="EXO 21" />
  <para style="s">दासों को संग बर्ताव</para>
  <para style="r">(<ref loc="DEU 15:12-18">व्यवस्थाविवरन १५:१२-१८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 21:1" />“फिर जो नियम तोख उन्को समझानो हंय हि यो आय, <verse eid="EXO 21:1" /><verse number="2" style="v" sid="EXO 21:2" />जब तुम कोयी इब्री दास लेय ले, तब ऊ छय साल तक सेवा करतो रहेंन, पर सातवों साल बिना कीमत चुकाये स्वतंत्र होय क जाय सकेंन। <verse eid="EXO 21:2" /><verse number="3" style="v" sid="EXO 21:3" />यदि ऊ बिना शादी को आयो हय, त ऊ बिना शादी कोच चली जाये; अऊर पत्नी संग आयो हय, त पत्नी को संग चली जाये। <verse eid="EXO 21:3" /><verse number="4" style="v" sid="EXO 21:4" /><note caller="+" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="LEV 25:44">लैव्यव्यवस्था २५:४४</ref></char></note>यदि ओको मालिक न ओको लायी पत्नी बनाय दियो हय, अऊर ओको सी ओको संतान भयी हय, त ओकी पत्नी अऊर बच्चा ओको स्वामी कोच रहेंन, अऊर ऊ अकेलो जाय सकेंन। <verse eid="EXO 21:4" /><verse number="5" style="v" sid="EXO 21:5" />पर यदि ऊ दास दृढ़ता सी कहेंन, ‘मय अपनो स्वामी, अऊर अपनी पत्नी, अऊर बच्चा सी प्रेम रखू हय, येकोलायी मय स्वतंत्र होय क नहीं जाऊं;’ <verse eid="EXO 21:5" /><verse number="6" style="v" sid="EXO 21:6" />त ओको मालिक ओख न्याय करन वालो को आगु लिजाय क; फिर ओख दरवाजा को चौखट जवर लिजाय क बारीक सुजा सी ओको कान छेदेंन; तब ऊ अपनो मालिक की हमेशा सेवा करेंन।”<verse eid="EXO 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 21:7" />“यदि कोयी अपनी टुरी ख दासी होन लायी बेच डाले, त ऊ दासी होन को वजह आदमी-दासों को जसो स्वतंत्र होय क बाहेर नहीं जाय सकेंन। <verse eid="EXO 21:7" /><verse number="8" style="v" sid="EXO 21:8" />यदि वा अपनो मालिक ओख अपनी पत्नी बनाये, अऊर फिर ओख सी खुश नहीं रह्य, त वापस ओको बाप ख दाम सी छुड़ायी जान दे; पर ओको विश्वास घात करन को बाद ओख विदेशी लोगों को हाथ बेचन को ओको अधिकार नहीं रहेंन। <verse eid="EXO 21:8" /><verse number="9" style="v" sid="EXO 21:9" />यदि ओन अपनो बेटा लायी चुन्यो हय, त बेटी जसो व्यवहार करो। <verse eid="EXO 21:9" /><verse number="10" style="v" sid="EXO 21:10" />यदि ऊ दूसरी सी बिहाव कर ले, तब ऊ पहिली पत्नी ख खाना, कपड़ा, की कमी नहीं होन दे, अऊर कोयी सुख सी दूर नहीं रखे। <verse eid="EXO 21:10" /><verse number="11" style="v" sid="EXO 21:11" />अऊर यदि ऊ इन तीन बातों म कमी करेंन, त वा बाई बिना दाम चुकायो स्वतंत्र होय जायेंन।”<verse eid="EXO 21:11" /></para>
  <para style="s">हिंसक कार्यो सी सम्बन्धित नियम</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 21:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">21:12 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 24:17">लैव्यव्यवस्था २४:१७</ref>
      </char>
    </note>“जो कोयी आदमी ख असो मारयो कि ऊ मर जाये, त ऊ भी निश्चय ओख मार डाल्यो जाये। <verse eid="EXO 21:12" /><verse number="13" style="v" sid="EXO 21:13" /><note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="DEU 4:5">व्यवस्थाविवरन ४:५</ref></char></note>यदि ओकी मारन की मंसा नहीं होती पर अचानक सी परमेश्वर की इच्छा सी ऊ ओको हाथ सी मर गयो, त असो मारन वालो को भगन लायी मय एक जागा ठहराऊं जित ऊ भग जाये। <verse eid="EXO 21:13" /><verse number="14" style="v" sid="EXO 21:14" /><note caller="+" style="x"><char style="xo" closed="false">21:14 </char><char style="xt" closed="false"><ref loc="1KI 2:28">१ राजा २:२८</ref></char></note>पर यदि कोयी जान बूझ क कोयी ख छल सी मार डाले, त ओको मार डालन लायी मोरी वेदी को जवर सी भी अलग ले जाजो।”<verse eid="EXO 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 21:15" />“जो अपनो माय-बाप ख मारय हय, ओख निश्चय मार डाल्यो जायेंन।”<verse eid="EXO 21:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 21:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">21:16 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 24:7">व्यवस्थाविवरन २४:७</ref>
      </char>
    </note>“जो कोयी आदमी ख अपहरन करय, ओख बिकय यां ओको जवर मिलय त ऊ भी निश्चय मार डाल्यो जाये।”<verse eid="EXO 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 21:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">21:17 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 20:9">लैव्यव्यवस्था २०:9</ref>; <ref loc="MAT 15:4">मत्ती १५:४</ref></char>
    </note>“जो कोयी अपनो माय-बाप ख श्राप दे ऊ भी निश्चय मार डाल्यो जायेंन।”<verse eid="EXO 21:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 21:18" />“यदि आदमी झगड़य हय, अऊर एक दूसरो ख गोटा या घूसा सी असो मारे कि ऊ मरयो नहीं पर बीस्तर पर पड़्यो रहो, <verse eid="EXO 21:18" /><verse number="19" style="v" sid="EXO 21:19" />त जब उठ क फिर लाठी को सहारा चलन फिरन लगेंन, तब ऊ मारन वालो निर्दोष ठहरेंन; उच दशा म ऊ ओको पड़्यो रहन को समय की हानि भर दे, अऊर ओख ठीक भी कराय देंन।”<verse eid="EXO 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 21:20" />“यदि कोयी अपनो दास यां दासी ख लाठी सी असो मारयो कि ऊ ओको मारन सी मर जाये, तब ओख निश्चय सजा दियो जाये। <verse eid="EXO 21:20" /><verse number="21" style="v" sid="EXO 21:21" />पर यदि ऊ एक दोय दिन जीन्दो रहेंन, त ओको स्वामी ख सजा नहीं दियो जाये; कहालीकि ऊ दास ओको धन हय।<verse eid="EXO 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 21:22" />“यदि कोयी आदमी मार पीट करतो समय ओको धक्का कोयी गर्भवती बाई ख लगन सी ओको गर्भ गिर जाये, पर अऊर कुछ नुकसान नहीं होय, त मारन वालो सी ऊ बाई को पति जो भी मांग करय उतनो दण्ड की रकम दियो जाये जितनो पन्च निश्चित करेंन। <verse eid="EXO 21:22" /><verse number="23" style="v" sid="EXO 21:23" />पर यदि मार-पीट म कुछ हानि पहुंच्यो, त जीव को बदला जीव देनो पड़ेंन, <verse eid="EXO 21:23" /><verse number="24" style="v" sid="EXO 21:24" /><note caller="+" style="x"><char style="xo" closed="false">21:24 </char><char style="xt" closed="false"><ref loc="LEV 24:19">लैव्यव्यवस्था २४:१९</ref>,<ref loc="LEV 24:20">२०</ref>; <ref loc="DEU 19:21">व्यवस्थाविवरन १९:२१</ref>; <ref loc="MAT 5:38">मत्ती ५:३८</ref></char></note>अऊर तुम आंखी को बदला आंखी को, अऊर दात को बदला दात को, अऊर हाथ को बदला हाथ, अऊर पाय को बदला पाय लेवो, <verse eid="EXO 21:24" /><verse number="25" style="v" sid="EXO 21:25" />अऊर दाग को बदला दाग, अऊर घाव को बदला घाव, अऊर मार को बदला मार की सजा आय।”<verse eid="EXO 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 21:26" />“जब कोयी अपनो दास यां दासी की आंखी पर असो मारयो कि फूट जाये, त ऊ ओकी आंखी को बदला ओख स्वतंत्र कर क् जान देजो। <verse eid="EXO 21:26" /><verse number="27" style="v" sid="EXO 21:27" />अऊर यदि ऊ अपनो दास या दासी ख मार क् ओको दात तोड़ डालेंन, त ऊ ओको दात को बदला ओख स्वतंत्र कर क् जान देयेंन।”<verse eid="EXO 21:27" /></para>
  <para style="s">मालिक की जवाबदारी</para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 21:28" />“यदि बईल कोयी आदमी यां बाई ख असो सींग मारे कि ऊ मर जाये, त ऊ बईल निश्चय गोटा सी मार डाल्यो जाये, अऊर ओको मांस खायो नहीं जाये; पर बईल को मालिक निर्दोष ठहरेंन। <verse eid="EXO 21:28" /><verse number="29" style="v" sid="EXO 21:29" />पर यदि बईल कि पहिलो सीच सींग मारन की आदत पड़्यो हय, अऊर ओको मालिक न पहिलो सी बतावन को बाद भी ओख नहीं बान्ध्यो हय, अऊर ऊ कोयी आदमी यां बाई ख मार डालय, तब त बईल ख गोटा सी मार डाल्यो जाये, अऊर ओको मालिक भी मारयो डाल्यो जाये।” <verse eid="EXO 21:29" /><verse number="30" style="v" sid="EXO 21:30" />पर बदला म धन दे क बईल को मालिक ख छोड़ सकय हय। ओख उतनोच धन देनो पड़ेंन। जितनो जान की छुड़ौती लायी ठहरायो जायेंन। <verse eid="EXO 21:30" /><verse number="31" style="v" sid="EXO 21:31" />यदि चाहे बईल न कोयी टुरा यां टुरी ख मारयो हय, तब भी येको नियम को अनुसार ओको मालिक को संग व्यवहार करयो जाये। <verse eid="EXO 21:31" /><verse number="32" style="v" sid="EXO 21:32" />यदि बईल न कोयी दास यां दासी ख सींग मारयो हय, त बईल को मालिक ऊ दास को मालिक ख चांदी को तीस सिक्का दे, अऊर बईल ख गोटा मार कर मार डालो।<verse eid="EXO 21:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 21:33" />“यदि कोयी आदमी न गड्डा खोल क या खोद क ओख नहीं झाक्यो, अऊर ओख म कोयी को बईल यां गधा गिर जाये, <verse eid="EXO 21:33" /><verse number="34" style="v" sid="EXO 21:34" />त जेको ऊ गड्डा आय ऊ ओको नुकसान ख भर दे; ऊ जनावर को मालिक ख ओको कीमत भर देंन, अऊर मरयो हुयो जनावर गड्डा वालो को होयेंन।”<verse eid="EXO 21:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 21:35" />यदि कोयी को बईल कोयी दूसरों को बईल ख असो मारे कि ऊ मर जाये, त हि दोयी आदमी जीन्दो बईल ख बेच क ओकी कीमत आपस म अरधो अरधो बाट ले; अऊर मरयो हुयो पशु को शव ख भी वसोच बाट ले। <verse eid="EXO 21:35" /><verse number="36" style="v" sid="EXO 21:36" />यदि यो मालूम पड़े कि ऊ बईल की पहिलो सी सींग मारन की आदत होती, पर ओको मालिक न ओख बान्ध क् नहीं रख्यो, त निश्चय ऊ बईल को बदला बईल भर दे, पर मरयो शव ओकोच ठहरेंन।<verse eid="EXO 21:36" /></para>
  <chapter eid="EXO 21" />
  <chapter number="22" style="c" sid="EXO 22" />
  <para style="s">नियम अऊर सजा</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 22:1" />“यदि कोयी आदमी गाय-बईल, यां मेंढी-शेरी चुराय क काटय यां बिकय, त ऊ गाय-बईल को बदला पाच गाय-बईल, अऊर मेंढी-शेरी को बदला चार मेंढी-शेरी भरनो पड़ेंन। <verse eid="EXO 22:1" /><verse number="2" style="v" sid="EXO 22:2" />यदि चोर चोरी करतो पकड़ायो, अऊर ओख पर असी मार पड़ी कि ऊ मर जाये, त ओको खून को दोष नहीं लगे। <verse eid="EXO 22:2" /><verse number="3" style="v" sid="EXO 22:3" />यदि सूरज निकल्यो, त ओको खून को दोष लगेन; जरूर हय कि ऊ नुकसान ख भर दे, अऊर यदि ओको जवर कुछ नहाय हय, त ऊ यो चोरी को वजह बेच दियो जाये। <verse eid="EXO 22:3" /><verse number="4" style="v" sid="EXO 22:4" />यदि चोरयो हुयो बईल, यां गधा, यां मेंढी, यां शेरी ओको हाथ म जीन्दो मिल्यो, त ऊ ओको दोय गुना भर दे।”<verse eid="EXO 22:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EXO 22:5" />“यदि कोयी अपनो पशु सी कोयी को खेत यां अंगूर की बाड़ी चराये, मतलब अपनो पशु ख असो छोड़ दे कि ऊ दूसरो को खेत ख चराय ले, त ऊ अपनो खेत की अऊर अपनी अंगूर की बाड़ी की अच्छी सी अच्छी फसल म सी ओको नुकसान ख भर दे।”<verse eid="EXO 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 22:6" />“यदि कोयी आगी जलाये, अऊर वहां काटा म लग जायेंन, अऊर फूलों को ढेर यां अनाज यां खड़ो खेत जर जायेंन, त जेन आगी जलायी होना ऊ नुकसान ख जरूर भर दे।”<verse eid="EXO 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 22:7" />“यदि कोयी दूसरो को जवर रुपया यां सामान की धरोहर रख दे, अऊर ऊ ओको घर सी चोरी जायेंन, त यदि चोर पकड़्यो जाये त दो गुना भर देनो पड़ेंन। <verse eid="EXO 22:7" /><verse number="8" style="v" sid="EXO 22:8" />यदि चोर नहीं पकड़्यो जाये, त घर को मालिक ख परमेश्वर को जवर लायो जाये कि निश्चय होय जाये कि ओन अपनो भाऊ-बन्धु की सम्पत्ति पर हाथ लगायो हय यां नहीं।”<verse eid="EXO 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 22:9" />“चाहे बईल, चाहे गधा, चाहे मेंढी यां शेरी, चाहे कपड़ा, कोयी तरह की असी घुमी हुयी चीज को बारे म दोष कहाली नहीं लगायो जाये, जेख दोय जन अपनी अपनी कह्य हय, त दोयी को मुकद्दमा परमेश्वर को जवर आये; अऊर जेख परमेश्वर दोषी ठहराये ऊ दूसरो ख दोय गुना भर दे।”<verse eid="EXO 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 22:10" />“यदि कोयी पड़ोसी ख गधा, यां बईल यां मेंढी-शेरी यां कोयी अऊर पशु रखन लायी सौंपेंन, अऊर कोयी को बिना देखेंन ऊ मर जायेंन, यां चोट खाये, यां भगाय दियो जायेंन,”<verse eid="EXO 22:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 22:11" />त उन दोयी को बिच परमेश्वर की कसम खिलायी जाय, मय न येकी सम्पत्ति पर हाथ नहीं लगायो; तब सम्पत्ति को मालिक येख सच मानेंन, अऊर दूसरो ख कुछ भी भर देनो नहीं पड़ेंन। <verse eid="EXO 22:11" /><verse number="12" style="v" sid="EXO 22:12" />यदि ऊ सचमुच ओको यहां सी चोरयो गयो होना, त ऊ ओको मालिक ख भर दे। <verse eid="EXO 22:12" /><verse number="13" style="v" sid="EXO 22:13" />अऊर यदि ऊ जनावर ख जंगली जनावर न चिर डाल्यो, त ऊ चिरयो हुयो ख सबूत लानो पड़ेंन, तब ओख कुछ भी भर नहीं देनो पड़ेंन।<verse eid="EXO 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 22:14" />“फिर यदि कोयी अपनो काम निकालन लायी दूसरो सी जनावर मांग लाये, अऊर ओको मालिक को गैरहाजिर म जनावर घायल होय यां मर जाये, त ऊ निश्चय ओको नुकसान भर दे। <verse eid="EXO 22:14" /><verse number="15" style="v" sid="EXO 22:15" />यदि ऊ समय ओको मालिक संग म हय, त दूसरो ख ओको नुकसान भरनो नहीं पड़ेंन; अऊर यदि किरायो को हय त ओको नुकसान ओको किरायो म आय गयी।”<verse eid="EXO 22:15" /></para>
  <para style="s">नैतिक अऊर धार्मिक नियम</para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 22:16" />“यदि कोयी आदमी कोयी कुंवारी टुरी ख, जेको बिहाव की बात नहीं लगी हय, फुसलाय क ओको संग कुकर्म करेंन, त ऊ निश्चय ओकी मोल दे क ओको सी बिहाव कर ले। <verse eid="EXO 22:16" /><verse number="17" style="v" sid="EXO 22:17" /><note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="DEU 22:28">व्यवस्थाविवरन २२:२८</ref>,<ref loc="DEU 22:29">२९</ref></char></note>पर यदि ओको बाप ओख देनो सी मना करेंन, त कुकर्म करन वालो टुरियों को कीमत रीति को अनुसार रुपया भर दे।<verse eid="EXO 22:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 22:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:18 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 20:27">लैव्यव्यवस्था २०:२७</ref>; <ref loc="DEU 18:10">व्यवस्थाविवरन १८:१०</ref>,<ref loc="DEU 18:11">११</ref></char>
    </note>“तय जादू-टोना करन वाली बाई ख जीन्दो मत रहन देजो।<verse eid="EXO 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 22:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:19 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 18:23">लैव्यव्यवस्था १८:२३</ref>; <ref loc="LEV 20:15">२०:१५</ref>,<ref loc="LEV 20:16">१६</ref>; <ref loc="DEU 27:21">व्यवस्थाविवरन २७:२१</ref></char>
    </note>“जो कोयी जनावर सी कुकर्म करे ऊ निश्चय मार डाल्यो जाय।<verse eid="EXO 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 22:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:20 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 17:2-7">व्यवस्थाविवरन १७:२-७</ref>
      </char>
    </note>“जो कोयी परमेश्वर ख छोड़ क अऊर कोयी अऊर देवता लायी बलि चढ़ाये ओको सत्यानाश करयो जाये।<verse eid="EXO 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 22:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:21 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 23:9">निर्गमन २३:९</ref>; <ref loc="LEV 19:33">लैव्यव्यवस्था १९:३३</ref>,<ref loc="LEV 19:34">३४</ref>; <ref loc="DEU 24:17">व्यवस्थाविवरन २४:१७</ref>,<ref loc="DEU 24:18">१८</ref>; <ref loc="DEU 17:19">१७:१९</ref></char>
    </note>“तुम कोयी परदेशी ख मत सताजो अऊर नहीं ओको पर अन्याय करजो, कहालीकि मिस्र देश म तुम भी परदेशी होतो। <verse eid="EXO 22:21" /><verse number="22" style="v" sid="EXO 22:22" />कोयी विधवा यां अनाथ बच्चा ख दु:ख मत देजो। <verse eid="EXO 22:22" /><verse number="23" style="v" sid="EXO 22:23" />यदि तुम असो ख कोयी तरह को दु:ख देवो अऊर हि मोरो सी मदत लायी रोवय, त मय निश्चय उन्की दोहाई सुनूं; <verse eid="EXO 22:23" /><verse number="24" style="v" sid="EXO 22:24" />तब मोरो गुस्सा भड़केंन, त मय तुम ख तलवार सी मार डालूं, अऊर तुम्हरी पत्नी विधवा अऊर तुम्हरो बच्चा अनाथ होय जायेंन।<verse eid="EXO 22:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 22:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:25 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 25:35-38">लैव्यव्यवस्था २५:३५-३८</ref>; <ref loc="DEU 15:7-11">व्यवस्थाविवरन १५:७-११</ref>; <ref loc="DEU 23:19">२३:१९</ref>,<ref loc="DEU 23:20">२०</ref></char>
    </note>“यदि तय मोरो लोगों म सी कोयी गरीब आदमी ख जो तोरो संग रह्य हय पैसा उधार देजो त ओको सी साहुकार को जसो ब्याज नहीं लेजो। <verse eid="EXO 22:25" /><verse number="26" style="v" sid="EXO 22:26" /><note caller="+" style="x"><char style="xo" closed="false">22:26 </char><char style="xt" closed="false"><ref loc="DEU 24:10-13">व्यवस्थाविवरन २४:१०-१३</ref></char></note>यदि तय कभी अपनो भाऊ-बन्धु को कपड़ा ख गिरवी रख क रख भी ले, त सूरज को डुबन तक ओख लौटाय देजो; <verse eid="EXO 22:26" /><verse number="27" style="v" sid="EXO 22:27" />कहालीकि ऊ ओको एकच चादर हय, ओको शरीर को उच एकच कपड़ा होयेंन, फिर ऊ कसो ओढ़ क सोयेंन? अऊर जब ऊ मोरी दोहाई देयेंन तब मय ओकी सुनूं, कहालीकि मय करुनामय आय।<verse eid="EXO 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EXO 22:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:28 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:5">प्रेरितों २३:५</ref>
      </char>
    </note>“परमेश्वर ख दोष मत देजो, अऊर नहीं अपनो लोगों को मुखिया ख श्राप मत देजो।<verse eid="EXO 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 22:29" />“अपनो खेती की फसल अऊर फर को रस म सी मोख देन म देर मत करजो। अपनो टुरावों म सी पहिलौठा ख मोख देजो। <verse eid="EXO 22:29" /><verse number="30" style="v" sid="EXO 22:30" />वसोच अपनी गाय अऊर मेंढी-शेरी को पहिलौठा भी देजो; सात दिन तक त बच्चा अपनी माय को संग रहेंन, अऊर आठवों दिन तय ओख मोख ख दे देजो।<verse eid="EXO 22:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 22:31" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:31 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 17:15">लैव्यव्यवस्था १७:१५</ref>
      </char>
    </note>“तुम मोरो लायी पवित्र लोग बनजो; यो वजह जो पशु मैदान म चिरयो हुयो पड़्यो मिलेंन ओको मांस मत खाजो, ओख कुत्ता को आगु फेंक देजो।<verse eid="EXO 22:31" /></para>
  <chapter eid="EXO 22" />
  <chapter number="23" style="c" sid="EXO 23" />
  <para style="s">न्याय अऊर निष्पक्षता</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 23:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">23:1 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:16">निर्गमन २०:१६</ref>; <ref loc="LEV 19:11">लैव्यव्यवस्था १९:११</ref>,<ref loc="LEV 19:12">१२</ref></char>
    </note>“झूठी बात मत फैलावो। अऊर झूठी गवाही दे क अन्यायी लोगों को साथ मत देजो। <verse eid="EXO 23:1" /><verse number="2" style="v" sid="EXO 23:2" />बुरायी करन लायी बहुतों को पीछू मत पड़जो; अऊर न उन्को पीछू फिर क् मुकद्दमा म न्याय बिगाड़न लायी गवाही देजो; <verse eid="EXO 23:2" /><verse number="3" style="v" sid="EXO 23:3" /><note caller="+" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="LEV 19:15">लैव्यव्यवस्था १९:१५</ref></char></note>अऊर गरीब को मुकद्दमा म ओको भी पक्ष मत लेजो।<verse eid="EXO 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 23:4" />“फिर यदि तोरो दुश्मन को बईल यां गधा भटकतो हुयो तोख मिलेंन, त ओख ओको जवर जरूर वापस ले आजो। <verse eid="EXO 23:4" /><verse number="5" style="v" sid="EXO 23:5" /><note caller="+" style="x"><char style="xo" closed="false">23:5 </char><char style="xt" closed="false"><ref loc="DEU 22:1-4">व्यवस्थाविवरन २२:१-४</ref></char></note>फिर यदि तय अपनो दुश्मन को गधा ख बोझ को मारे दब्यो हुयो देखो, तब भी जरूर मालिक की मदत कर क् ओख छुड़ाय लेजो करजो।<verse eid="EXO 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 23:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">23:6 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:19">व्यवस्थाविवरन ६:१९</ref>
      </char>
    </note>“तोरो लोगों म सी जो गरीब हय ओको मुकद्दमा म न्याय मत बिगाड़जो <verse eid="EXO 23:6" /><verse number="7" style="v" sid="EXO 23:7" />झूठो मुकद्दमा सी दूर रहजो, अऊर निर्दोष अऊर सच्चो ख घात मत करजो, कहालीकि मय बुरो ख निर्दोष नहीं ठहराऊं, <verse eid="EXO 23:7" /><verse number="8" style="v" sid="EXO 23:8" />तय घुस नहीं लेजो, कहालीकि घुस आदमी ख सच सी अन्धो कर देवय अऊर सच्चो की न्याय बिगाड़ देवय हय।<verse eid="EXO 23:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 23:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">23:9 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 22:21">निर्गमन २२:२१</ref>; <ref loc="LEV 19:33">लैव्यव्यवस्था १९:३३</ref>,<ref loc="LEV 19:34">३४</ref></char>
    </note>“परदेशी पर जुलूम मत करजो; तुम त परदेशी को मन की बात जानय हय, कहालीकि तुम भी मिस्र देश म परदेशी होतो।<verse eid="EXO 23:9" /></para>
  <para style="s">सातवों साल अऊर सातवों दिन</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 23:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">23:10 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 25:3">लैव्यव्यवस्था २५:३</ref>
      </char>
    </note>“छय साल तक अपनी जमीन म बीज बोवो अऊर ओकी फसल जमा करजो; <verse eid="EXO 23:10" /><verse number="11" style="v" sid="EXO 23:11" /><note caller="+" style="x"><char style="xo" closed="false">23:11 </char><char style="xt" closed="false"><ref loc="LEV 25:1-7">लैव्यव्यवस्था २५:१-७</ref></char></note>पर सातवों साल म ओख खाली रहन देजो अऊर वसोच छोड़ देजो, त गरीब लोग अऊर जो कुछ उन्को सी भी बच जायेंन त जंगली जनावर ख खान को काम म आये। अपनी अंगूर अऊर जैतून की बाड़ी सी भी असोच करजो। <verse eid="EXO 23:11" /><verse number="12" style="v" sid="EXO 23:12" /><note caller="+" style="x"><char style="xo" closed="false">23:12 </char><char style="xt" closed="false"><ref loc="LEV 23:3">लैव्यव्यवस्था २३:३</ref>; <ref loc="DEU 5:13">व्यवस्थाविवरन ५:१३</ref>,<ref loc="DEU 5:14">१४</ref></char></note>छय दिन तक अपनो काम काज करजो, अऊर सातवों दिन आराम करजो ताकि तोरो बईल अऊर गधा सुस्तायेंन, अऊर तोरी सेविका को टुरा अऊर परदेशी ख भी आराम मिल सकेंन। <verse eid="EXO 23:12" /><verse number="13" style="v" sid="EXO 23:13" />जो कुछ मय न तुम सी कह्यो हय ओको पालन करजो; अऊर अन्य देवतावों की नाम की चर्चा भी मत करजो, बल्की हि तुम्हरो मुंह सी सुनायी भी नहीं दे।<verse eid="EXO 23:13" /></para>
  <para style="s">तीन मुख्य त्यौहार</para>
  <para style="r">(<ref loc="EXO 34:18-26">निर्गमन ३४:१८-२६</ref>; <ref loc="DEU 16:1-17">व्यवस्थाविवरन १६:१-१७</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 23:14" />“हर साल तीन बार मोरो लायी त्यौहार मानजो। <verse eid="EXO 23:14" /><verse number="15" style="v" sid="EXO 23:15" /><note caller="+" style="x"><char style="xo" closed="false">23:15 </char><char style="xt" closed="false"><ref loc="LEV 23:6-8">लैव्यव्यवस्था २३:६-८</ref>; <ref loc="NUM 28:17-25">गिनती २८:१७-२५</ref></char></note>पहिलो पवित्र त्यौहार अखमीरी रोटी को त्यौहार मनायजो; ओको म मोरी आज्ञा को अनुसार अबीब महीना को नियत समय पर सात दिन तक अखमीरी रोटी खायो करनो, कहालीकि ओको महीना म तुम लोग मिस्र देश सी निकल आये होतो। मोख कोयी खाली हाथ अपनो मुंह नहीं दिखाये। <verse eid="EXO 23:15" /><verse number="16" style="v" sid="EXO 23:16" /><note caller="+" style="x"><char style="xo" closed="false">23:16 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">लैव्यव्यवस्था २३:१५-२१</ref>,<ref loc="LEV 23:39-43">३९-४३</ref>; <ref loc="NUM 28:26-31">गिनती २८:२६-३१</ref></char></note>जब तोरी बोयी हुयी खेत की पहिली फसल तैयार होना, तब कटनी को त्यौहार मनायजो। साल को आखरी म जब तय मेहनत की फसल जमा कर क् ढेर लगायजो, तब जमा करन को त्यौहार मनायजो। <verse eid="EXO 23:16" /><verse number="17" style="v" sid="EXO 23:17" />हर साल तीनों बार तोरो सब लोग प्रभु परमेश्वर ख अपनो मुंह दिखाये।<verse eid="EXO 23:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 23:18" />“मोरो जनावर को बलिदान<note caller="+" style="f"><char style="fr" closed="false">23:18 </char><char style="ft" closed="false">कुछ हस्त लेखों म चर्बी लिख्यो गयो हय</char></note> को खून खमीरी रोटी को संग नहीं चढ़ाजो, अऊर नहीं मोरो त्यौहार को उत्तम बलिदान म सी कुछ सुबेरे तक रहन देजो। <verse eid="EXO 23:18" /><verse number="19" style="v" sid="EXO 23:19" /><note caller="+" style="x"><char style="xo" closed="false">23:19 </char><char style="xt" closed="false"><ref loc="DEU 14:21">व्यवस्थाविवरन १४:२१</ref>; <ref loc="DEU 26:2">२६:२</ref>; <ref loc="EXO 34:26">निर्गमन ३४:२६</ref></char></note>अपनो जमीन की पहिली फसल को पहिलो हिस्सा अपनो परमेश्वर यहोवा को भवन म ले आजो। शेरी को बच्चा ओकी माय को दूध म नहीं पकाजो।<verse eid="EXO 23:19" /></para>
  <para style="s">वादा अऊर चेतावनी</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 23:20" />“सुन, मय एक दूत तोरो आगु आगु भेजूं जो रस्ता म तोरी रक्षा करेंन, अऊर जो जागा ख मय न तैयार करयो हय उत तोख पहुंचायेंन। <verse eid="EXO 23:20" /><verse number="21" style="v" sid="EXO 23:21" />ओको आगु सावधान रहजो, अऊर ओकी मानजो, ओको विरोध मत करजो, कहालीकि ऊ तोरो अपराध माफ नहीं करेंन; येकोलायी कि मोरो नाम ओको म हय। <verse eid="EXO 23:21" /><verse number="22" style="v" sid="EXO 23:22" />यदि तय सचमुच मोरी आज्ञा मानेंन अऊर जो कुछ मय कहूं ऊ करय, त मय तोरो दुश्मनों को दुश्मन अऊर तोरो बैरियों को बैरी बनूं। <verse eid="EXO 23:22" /><verse number="23" style="v" sid="EXO 23:23" />जब मोरो दूत आगु चल क तोख एमोरी, हित्ती, परिज्जी, कनानी, हिब्बी, अऊर यबूसी लोगों को यहां पहुंचायेंन, अऊर मय उन्ख सत्यानाश कर डालूं। <verse eid="EXO 23:23" /><verse number="24" style="v" sid="EXO 23:24" />उन्को देवतावों ख दण्डवत मत करजो, अऊर नहीं उन्की आराधना करजो, अऊर नहीं उन्को सी काम करजो, बल्की उन मूर्तियों को पूरी रीति सी सत्यानाश कर डालजो, अऊर उन लोगों को खम्बा को तुकड़ा तुकड़ा कर देजो। <verse eid="EXO 23:24" /><verse number="25" style="v" sid="EXO 23:25" />तय अपनो परमेश्वर यहोवा की आराधना करजो, तब ऊ तोरो भोजन अऊर पानी पर आशीष देयेंन, अऊर तोरो बीच म सी रोग दूर करेंन। <verse eid="EXO 23:25" /><verse number="26" style="v" sid="EXO 23:26" />तोरो देश म नहीं त कोयी को गर्भ गिरेंन अऊर नहीं कोयी बांझ रहेंन; अऊर तोरी उमर को दिन मय पूरो करूं। <verse eid="EXO 23:26" /><verse number="27" style="v" sid="EXO 23:27" />जितनो लोगों को बीच तय जाजो उन सब को मन म मय अपनो डर पहिले सी असो समाय देऊं कि उन्ख परेशान कर देऊं, अऊर मय तोख सब दुश्मन ख वापस जान लायी विवश कर देऊं। <verse eid="EXO 23:27" /><verse number="28" style="v" sid="EXO 23:28" />अऊर मय तोरो सी पहिले गंदनल ख भेजूं जो हिब्बी, कनानी, अऊर हित्ती लोगों ख तोरो आगु सी भगाय क दूर कर देयेंन। <verse eid="EXO 23:28" /><verse number="29" style="v" sid="EXO 23:29" />मय उन्ख तोरो आगु सी एकच साल म नहीं निकालूं, असो नहीं होय कि देश उजाड़ होय जाये, अऊर जंगली जनावर बढ़ क तोरी हानि करेंन। <verse eid="EXO 23:29" /><verse number="30" style="v" sid="EXO 23:30" />जब तक तय बढ़ क देश पर अपनो अधिकार नहीं कर ले तब तक मय उन्ख तोरो आगु सी थोड़ो थोड़ो कर क् निकालतो रहूं। <verse eid="EXO 23:30" /><verse number="31" style="v" sid="EXO 23:31" />मय तोरी सीमा लाल समुन्दर सी ले क पलिश्तियों को समुन्दर तक अऊर जंगल सी ले क फरात नदी तक को देश ख तोरो वश म कर देऊं; मय ऊ देश को निवासियों ख भी तोरो वश म कर देऊं, अऊर तय उन्ख अपनो जवर सी निकाल देयेंन। <verse eid="EXO 23:31" /><verse number="32" style="v" sid="EXO 23:32" />तय नहीं त उन्को सी वाचा बान्धजो अऊर नहीं उन्को देवतावों सी। <verse eid="EXO 23:32" /><verse number="33" style="v" sid="EXO 23:33" />हि तोरो देश म नहीं रहनो पाये, असो नहीं होय कि हि तोरो सी मोरो खिलाफ पाप करायेंन; यदि तय उन्को देवतावों की आराधना करे त यो तोरो लायी फन्दा बनेंन।”<verse eid="EXO 23:33" /></para>
  <chapter eid="EXO 23" />
  <chapter number="24" style="c" sid="EXO 24" />
  <para style="s">परमेश्वर अऊर इस्राएलियों को बीच वाचा</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 24:1" />परमेश्वर न मूसा सी कह्यो, “तय हारून, नादाब, अबीहू, अऊर इस्राएलियों को सत्तर बुजूर्गों को संग परमेश्वर को जवर ऊपर आय क दूर सी आराधना करजो। <verse eid="EXO 24:1" /><verse number="2" style="v" sid="EXO 24:2" />केवल मूसा परमेश्वर को जवर आयेंन, पर हि जवर नहीं आये, अऊर दूसरो लोग तोरो संग ऊपर नहीं आये।”<verse eid="EXO 24:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EXO 24:3" />मूसा न लोगों को जवर जाय क परमेश्वर की पूरी बात अऊर नियम सुना दियो। तब सब लोग एक आवाज म बोल्यो, “जितनो बात परमेश्वर न कह्यो हंय उन सब बात ख हम मानबों।” <verse eid="EXO 24:3" /><verse number="4" style="v" sid="EXO 24:4" /><note caller="+" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="JOS 4:3">यहोशू ४:३</ref></char></note>तब मूसा न परमेश्वर को सब वचन लिख दियो; अऊर बहुत सुबेरे उठ क पहाड़ी को खल्लो एक वेदी अऊर इस्राएल को बारा कुल को अनुसार बारा खम्बा भी बनायो। <verse eid="EXO 24:4" /><verse number="5" style="v" sid="EXO 24:5" />तब ओन इस्राएली जवानों ख भेज्यो, जिन्न परमेश्वर लायी होमबलि अऊर <note caller="+" style="f"><char style="fr" closed="false">24:5 </char><char style="ft" closed="false">बईल</char></note>जनावर की मेलबलि चढ़ायी। <verse eid="EXO 24:5" /><verse number="6" style="v" sid="EXO 24:6" />अऊर मूसा न अरधो खून ले क कटोरा म रख्यो, अऊर अरधो वेदी पर छिड़क दियो। <verse eid="EXO 24:6" /><verse number="7" style="v" sid="EXO 24:7" />तब वाचा की किताब ख ले क लोगों ख पढ़ क सुनायो; ओख सुन क उन्न कह्यो, “जो कुछ परमेश्वर न कह्यो हय ऊ सब ख हम करबो, अऊर ओकी आज्ञा मानबो।” <verse eid="EXO 24:7" /><verse number="8" style="v" sid="EXO 24:8" /><note caller="+" style="x"><char style="xo" closed="false">24:8 </char><char style="xt" closed="false"><ref loc="MAT 26:28">मत्ती २६:२८</ref>; <ref loc="1CO 11:25">१ कुरिन्थियों ११:२५</ref></char></note>तब मूसा न खून ले क लोगों पर छिड़क्यो, अऊर उन सी कह्यो, “देखो, यो ऊ वाचा को खून आय, जेख परमेश्वर न इन सब वचनों पर तुम्हरो संग बान्धी हय।”<verse eid="EXO 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 24:9" />तब मूसा, हारून, नादाब, अबीहू अऊर इस्राएलियों को सत्तर बुजूर्ग लोग ऊपर पहाड़ी पर चढ़ गयो, <verse eid="EXO 24:9" /><verse number="10" style="v" sid="EXO 24:10" />अऊर इस्राएल को परमेश्वर को दर्शन करयो; अऊर ओको पाय को खल्लो नीलमनि को चौरंग को जसो कुछ होतो, जो आसमान को समान साफ होतो। <verse eid="EXO 24:10" /><verse number="11" style="v" sid="EXO 24:11" />अऊर ओन इस्राएलियों को मुखियावों पर हाथ नहीं बढ़ायो; तब उन्न परमेश्वर को दर्शन करयो, अऊर खायो पीयो।<verse eid="EXO 24:11" /></para>
  <para style="s">सीनै पहाड़ी पर मूसा</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 24:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">24:12 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 3:3">२ कुरिन्थियों ३:३</ref>
      </char>
    </note>तब परमेश्वर न मूसा सी कह्यो, “पहाड़ी पर मोरो जवर चढ़ आव, अऊर वहां मोरी बाट देखजो; अऊर मय तोख गोटा की पट्टियां, अऊर अपनी लिखी हुयी व्यवस्था अऊर आज्ञा देऊं कि तय उन्ख सिखाजो।” <verse eid="EXO 24:12" /><verse number="13" style="v" sid="EXO 24:13" />तब मूसा यहोशू नाम को अपनो सेवक को संग परमेश्वर की पहाड़ी पर चढ़ गयो। <verse eid="EXO 24:13" /><verse number="14" style="v" sid="EXO 24:14" />अऊर बुजूर्गों सी यो कह्यो गयो, “जब तक हम तुम्हरो जवर फिर नहीं आबो तब तक तुम यहांच हमरी बाट देखत रहो; अऊर सुनो, हारून अऊर हूर तुम्हरो संग हंय; यदि कोयी को मुकद्दमा हय त उन्कोच जवर जाये।”<verse eid="EXO 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 24:15" />तब मूसा पहाड़ी पर चढ़ गयो, अऊर बादर न पहाड़ी ख छाय लियो। <verse eid="EXO 24:15" /><verse number="16" style="v" sid="EXO 24:16" />तब परमेश्वर को तेज न सीनै पहाड़ी पर निवास करयो, अऊर ऊ बादर ओको पर छय दिन तक पहाड़ी पर छायो रह्यो; अऊर सातवों दिन ओन मूसा ख बादर को बीच म सी बुलायो। <verse eid="EXO 24:16" /><verse number="17" style="v" sid="EXO 24:17" />इस्राएलियों की नजर म परमेश्वर को तेज पहाड़ी की सेंडी पर भस्म करनवाली आगी को समान दिखायी देत होतो। <verse eid="EXO 24:17" /><verse number="18" style="v" sid="EXO 24:18" /><note caller="+" style="x"><char style="xo" closed="false">24:18 </char><char style="xt" closed="false"><ref loc="DEU 9:9">व्यवस्थाविवरन ९:९</ref>; <ref loc="MAT 4:2">मत्ती ४:२</ref>; <ref loc="1KI 19:8">१ राजा १९:८</ref></char></note>तब मूसा बादर को बीच जाय क पहाड़ी पर चढ़ गयो। अऊर पहाड़ी पर चालीस दिन अऊर चालीस रात रह्यो।<verse eid="EXO 24:18" /></para>
  <chapter eid="EXO 24" />
  <chapter number="25" style="c" sid="EXO 25" />
  <para style="s">पवित्र जागा लायी भेंट</para>
  <para style="r">(<ref loc="EXO 35:4-9">निर्गमन ३५:४-९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 25:1" />परमेश्वर न मूसा सी कह्यो, <verse eid="EXO 25:1" /><verse number="2" style="v" sid="EXO 25:2" />“इस्राएलियों सी यो कहजो कि मोरो लायी भेंट लाये; जितनो अपनी इच्छा सी देनो चाहेंन उन सभी सी मोरी भेंट लेजो। <verse eid="EXO 25:2" /><verse number="3" style="v" sid="EXO 25:3" />अऊर जिन चिजों की भेंट उन्को सी लेनो हय हि यो आय; मतलब सोना, चांदी अऊर पीतल, <verse eid="EXO 25:3" /><verse number="4" style="v" sid="EXO 25:4" />नीलो, जामुनी अऊर लाल रंग को कपड़ा, पतलो सूत सी बुन्यो कपड़ा, शेरी को बाल, <verse eid="EXO 25:4" /><verse number="5" style="v" sid="EXO 25:5" />लाल रंग सी रंगी हुयो मेंढी की खाल, सुईसों<note caller="+" style="f"><char style="fr" closed="false">25:5 </char><char style="ft" closed="false">सूंस नाम की पानी म रहन वाली बड़ी मच्छी</char></note> की खाल, बबूल की लकड़ी, <verse eid="EXO 25:5" /><verse number="6" style="v" sid="EXO 25:6" />दीया लायी तेल, अभिषेक को तेल लायी अऊर सुगन्धित धूप लायी सुगन्ध मसाला, <verse eid="EXO 25:6" /><verse number="7" style="v" sid="EXO 25:7" />एपोद<note caller="+" style="f"><char style="fr" closed="false">25:7 </char><char style="ft" closed="false">विशेष तरह को याजक लोगों को पहिनन को कपड़ा</char></note> पोशाक अऊर ओको ऊपर पहिनन वालो चपरास<note caller="+" style="f"><char style="fr" closed="false">25:7 </char><char style="ft" closed="false">कवच</char></note> लायी सुलैमानी गोटा, अऊर जड़न लायी मनि। <verse eid="EXO 25:7" /><verse number="8" style="v" sid="EXO 25:8" />अऊर हि मोरो लायी एक पवित्र जागा बनाये कि मय उन्को बीच निवास करूं। <verse eid="EXO 25:8" /><verse number="9" style="v" sid="EXO 25:9" />जो कुछ मय तोख दिखाऊ हय, मतलब रहन की जागा अऊर ओको सब सामान को नमुना, ओकोच अनुसार तुम लोग ओख बनावो।”<verse eid="EXO 25:9" /></para>
  <para style="s">वाचा को सन्दूक</para>
  <para style="r">(<ref loc="EXO 37:1-9">निर्गमन ३७:१-९</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 25:10" />बबूल की लकड़ी को एक सन्दूक बनायो जाये; ओकी लम्बायी ढायी हाथ, अऊर चौड़ायी अऊर ऊंचायी देड़ देड़ हाथ की होना। <verse eid="EXO 25:10" /><verse number="11" style="v" sid="EXO 25:11" />अऊर ओख शुद्ध सोनो सी अन्दर अऊर बाहेर मढ़वाजो, अऊर सन्दूक को ऊपर चारयी तरफ सोनो की किनार बनायजो। <verse eid="EXO 25:11" /><verse number="12" style="v" sid="EXO 25:12" />अऊर सोनो को चार कड़ा साचा सी ढाल क बनायजो ओको चारयी पाय पर, एक तरफ दोय कड़ा अऊर दूसरो तरफ दोय कड़ा लगाजो। <verse eid="EXO 25:12" /><verse number="13" style="v" sid="EXO 25:13" />फिर बबूल की लकड़ी को डन्डा बनवाजो, अऊर उन्ख भी सोनो सी मढ़ो। <verse eid="EXO 25:13" /><verse number="14" style="v" sid="EXO 25:14" />अऊर डन्डा ख सन्दूक को दोयी तरफ को कड़ा म डालजो, जेकोसी उन्को सहारा सी सन्दूक ख उठायो जाये सके। <verse eid="EXO 25:14" /><verse number="15" style="v" sid="EXO 25:15" />हि डन्डा सन्दूक को कड़ा म लग्यो रहेंन; अऊर ओको सी अलग नहीं करयो जाये। <verse eid="EXO 25:15" /><verse number="16" style="v" sid="EXO 25:16" />अऊर जो गवाही चिट्ठी मय तोख देऊं ओख उच सन्दूक म रखजो।<verse eid="EXO 25:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 25:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">25:17 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 9:5">इब्रानियों ९:५</ref>
      </char>
    </note>“फिर शुद्ध सोनो को एक पश्चाताप को ढक्कन बनवाजो; ओकी लम्बायी ढायी हाथ, अऊर चौड़ायी देड़ हाथ की होना। <verse eid="EXO 25:17" /><verse number="18" style="v" sid="EXO 25:18" />अऊर सोना ढाल क दोय करूब<note caller="+" style="f"><char style="fr" closed="false">25:18 </char><char style="ft" closed="false">पंख वालो स्वर्गदूत</char></note> बनाय क पश्चाताप को ढक्कन को दोयी कोना पर लगवाजो। <verse eid="EXO 25:18" /><verse number="19" style="v" sid="EXO 25:19" />एक करूब एक कोना पर अऊर दूसरो करूब दूसरो कोना पर लगवाजो; करूबों ख दया आसन को ढक्कन ख एकच तुकड़ा सी बनाय क ओको दोयी कोना पर लगवायजो। <verse eid="EXO 25:19" /><verse number="20" style="v" sid="EXO 25:20" />उन करूबों को पंखा ऊपर सी असो फैल्यो हुयो बने कि पश्चाताप को ढक्कन उन सी ढक्यो रहे, अऊर उन्को मुख आमने-सामने अऊर दया आसन को ढक्कन को तरफ रहे। <verse eid="EXO 25:20" /><verse number="21" style="v" sid="EXO 25:21" />अऊर पश्चाताप को ढक्कन ख सन्दूक को ऊपर लगवाजो; अऊर जो गवाही चिट्ठी मय तोख देऊं ओख सन्दूक को अन्दर रखजो। <verse eid="EXO 25:21" /><verse number="22" style="v" sid="EXO 25:22" />मय वहां रह्य क तोरो सी मिलतो रहूं; अऊर इस्राएलियों लायी जितनी आज्ञाये मोख ख तोख देनो होय, उन सभी को बारे म पश्चाताप को ढक्कन को ऊपर सी अऊर उन करूबों को बीच म सी, जो गवाही चिट्ठी को सन्दूक पर होना, तोरो सी बात-चित करतो रहूं।”<verse eid="EXO 25:22" /></para>
  <para style="s">पवित्र मेज</para>
  <para style="r">(<ref loc="EXO 37:10-16">निर्गमन ३७:१०-१६</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="EXO 25:23" />“फिर बबूल की लकड़ी की एक टेबल बनायजो; ओकी लम्बायी दोय हाथ, चौड़ायी एक हाथ, अऊर ऊंचायी देड़ हाथ की होना। <verse eid="EXO 25:23" /><verse number="24" style="v" sid="EXO 25:24" />ओख शुद्ध सोनो सी मढ़ायजो, अऊर ओको चारयी तरफ सोनो की एक किनार बनायजो <verse eid="EXO 25:24" /><verse number="25" style="v" sid="EXO 25:25" />अऊर ओको चारयी तरफ चार बोट चौड़ी चौखट बनायजो, अऊर यो चौखट को चारयी तरफ सोनो की एक किनार बनायजो। <verse eid="EXO 25:25" /><verse number="26" style="v" sid="EXO 25:26" />अऊर सोनो को चार कड़ा बनवाय क टेबल को उन चारयी कोना म लगायजो जो ओको चारयी पाय म होयेंन। <verse eid="EXO 25:26" /><verse number="27" style="v" sid="EXO 25:27" />हि कड़ा चौखट को जवरच होना, अऊर जेकोसी टेबल डन्डा को सहारा सी उठायो जाय सके। <verse eid="EXO 25:27" /><verse number="28" style="v" sid="EXO 25:28" />बबूल की लकड़ी को डन्डा बनाय क सोनो सी मढ़वाजो, टेबल उन्को सीच उठायो जाये। <verse eid="EXO 25:28" /><verse number="29" style="v" sid="EXO 25:29" />अऊर ओको परात अऊर धूपदान, अऊर मग्गा अऊर कुड़ावन को कटोरा, सब शुद्ध सोनो को बनायजो। <verse eid="EXO 25:29" /><verse number="30" style="v" sid="EXO 25:30" /><note caller="+" style="x"><char style="xo" closed="false">25:30 </char><char style="xt" closed="false"><ref loc="LEV 24:5-8">लैव्यव्यवस्था २४:५-८</ref></char></note>अऊर टेबल पर मोरो आगु भेंट की रोटी हमेशा रखजो।”<verse eid="EXO 25:30" /></para>
  <para style="s">सोनो की दीवट</para>
  <para style="r">(<ref loc="EXO 37:17-24">निर्गमन ३७:१७-२४</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 25:31" />“फिर शुद्ध सोना को एक दीया बनायजो। सोनो ढाल क ऊ दीया पाया अऊर डन्डी सहित बनायो जाये; ओकी पंखुड़ी, गाठ, अऊर फूल, एकच तुकड़ा की बनी होना; <verse eid="EXO 25:31" /><verse number="32" style="v" sid="EXO 25:32" />अऊर ओको किनार सी छय डन्डी निकली हो, तीन त दीवट को एक तरफ सी अऊर तीन ओको दूसरी तरफ सी निकली हुयी हो; <verse eid="EXO 25:32" /><verse number="33" style="v" sid="EXO 25:33" />हर एक डगाली म बादाम को फूल को जसो तीन तीन पुष्पकोष, एक एक गांठ, अऊर एक एक फूल हो; दीया सी निकली हुयी छय डगालियों को योच आकार अऊर रूप हो; <verse eid="EXO 25:33" /><verse number="34" style="v" sid="EXO 25:34" />अऊर खड़ो दीवट की डन्डी म बादाम को फूल को समान चार कटोरी अपनी पंकुड़ी फूल समेत हो; <verse eid="EXO 25:34" /><verse number="35" style="v" sid="EXO 25:35" />अऊर दीया सी निकली हुयी छय डगालियों म सी एक बाजू तीन अऊर दूसरो बाजू तीन असो डन्डी हो, हि दीवट समेत एकच तुकड़ों को बन्यो हुयो हो। <verse eid="EXO 25:35" /><verse number="36" style="v" sid="EXO 25:36" />उन्की पंकुड़ी अऊर डगाली सब दीया समेत एकच तुकड़ों की शुद्ध सोनो सी बनी हो। <verse eid="EXO 25:36" /><verse number="37" style="v" sid="EXO 25:37" />अऊर सात दीया बनवाजो, अऊर दीया जलाय क दीवट पर रखजो कि उजाड़ो आगु दिखेंन। <verse eid="EXO 25:37" /><verse number="38" style="v" sid="EXO 25:38" />अऊर ओको चिमटा अऊर गुलदान सब शुद्ध सोनो को हो। <verse eid="EXO 25:38" /><verse number="39" style="v" sid="EXO 25:39" />ऊ सब पूरो सामान लगभग पैतीस किलो शुद्ध सोनो सी बनें। <verse eid="EXO 25:39" /><verse number="40" style="v" sid="EXO 25:40" /><note caller="+" style="x"><char style="xo" closed="false">25:40 </char><char style="xt" closed="false"><ref loc="ACT 7:44">प्रेरितों ७:४४</ref>; <ref loc="HEB 8:5">इब्रानियों ८:५</ref></char></note>अऊर ध्यान सी इन सब चीजो ख जसो बतायो हय वसोच बनायजो, जो तोख या पहाड़ी पर दिखायो होतो।”<verse eid="EXO 25:40" /></para>
  <chapter eid="EXO 25" />
  <chapter number="26" style="c" sid="EXO 26" />
  <para style="s">परमेश्वर को उपस्थिति को तम्बू</para>
  <para style="r">(<ref loc="EXO 36:8-38">निर्गमन ३६:८-३८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 26:1" />परमेश्वर न मूसा सी कह्यो, फिर निवास जागा लायी दस परदा बनायजो; इन्को पतलो धागा को बिन्यो हुयो नीलो, जामुनी अऊर लाल रंग को कपड़ा को बुन्यो हुयो करूबों को चित्र संग बनायजो। <verse eid="EXO 26:1" /><verse number="2" style="v" sid="EXO 26:2" />हर एक परदा की लम्बायी अट्ठावीस फीट अऊर चौड़ायी चार फीट की हो, सब परदा एकच नाप को हो। <verse eid="EXO 26:2" /><verse number="3" style="v" sid="EXO 26:3" />पाच परदा एक दूसरो सी जोड़्यो हुयो हो; अऊर फिर जो पाच परदा रहेंन हि भी एक दूसरो सी जुड़्यो हुयो हो। <verse eid="EXO 26:3" /><verse number="4" style="v" sid="EXO 26:4" />अऊर जित या दोयी परदा जोड़्यो जाये उत को दोयी कोना पर नीलो नीलो फन्दा लगायजो। <verse eid="EXO 26:4" /><verse number="5" style="v" sid="EXO 26:5" />दोयी कोना म पचास पचास फन्दा असो लगवायजो कि हि आमने-सामने हो। <verse eid="EXO 26:5" /><verse number="6" style="v" sid="EXO 26:6" />अऊर सोनो को पचास गोल कड़ी बनायजो; अऊर जोड़्यो हुयो परदा ख इन कड़ी सी जोड़ देजो जेकोसी पूरो निवास जागा एक बन जाये।<verse eid="EXO 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 26:7" />“फिर निवास को ऊपर तम्बू लायी बकरा को बाल को ग्यारा परदा बनवाजो। <verse eid="EXO 26:7" /><verse number="8" style="v" sid="EXO 26:8" />हर एक परदा की लम्बायी तीस हाथ अऊर चौड़ायी चार हाथ हो, असो ग्यारा परदा एकच नाप को हो। <verse eid="EXO 26:8" /><verse number="9" style="v" sid="EXO 26:9" />अऊर पाच परदा को एक जोड़ अऊर फिर छय परदा को दूसरो जोड़ अलग जोड़जो, अऊर छठवो परदा ख तम्बू को आगु मोड़ क डबल कर क् लटकाय देजो। <verse eid="EXO 26:9" /><verse number="10" style="v" sid="EXO 26:10" />अऊर तय पचास कड़ी उच परदा को कोना म अऊर पचास कड़ी दूसरी तरफ को परदा को कोना म जो बाहेर सी मिलाय क बनवायजो। <verse eid="EXO 26:10" /><verse number="11" style="v" sid="EXO 26:11" />अऊर पीतल को पचास कड़ा बनाजो, अऊर कड़ा ख फन्दा म लगाय क तम्बू ख असो जोड़जो कि ऊ मिल क एक होय जाये। <verse eid="EXO 26:11" /><verse number="12" style="v" sid="EXO 26:12" />अऊर तम्बू को परदा को लटक्यो हुयो हिस्सा, यानेकि जो अरधो बच्यो रहेंन, ऊ निवास-जागा की पिछली तरफ लटक्यो रहेंन। <verse eid="EXO 26:12" /><verse number="13" style="v" sid="EXO 26:13" />अऊर तम्बू को परदा की लम्बायी म सी हाथ भर इत, अऊर हाथ भर उत निवास-जागा को ढकन लायी ओको दोयी तरफ लटक्यो हुयो रहो। <verse eid="EXO 26:13" /><verse number="14" style="v" sid="EXO 26:14" />फिर तम्बू लायी लाल रंग सी रंगी हुयो मेंढी की खाल को एक ओढ़नो अऊर ओको ऊपर सुइसों की खाल को भी एक ओढ़नो बनायजो।”<verse eid="EXO 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 26:15" />“फिर निवास-जागा ख खड़ो करन लायी बबूल की लकड़ी को चौखट बनायजो। <verse eid="EXO 26:15" /><verse number="16" style="v" sid="EXO 26:16" />हर एक तक्ता की लम्बायी दस हाथ अऊर चौड़ायी देढ़ हाथ की हो। <verse eid="EXO 26:16" /><verse number="17" style="v" sid="EXO 26:17" />हर एक तक्ता म एक दूसरो सी जोड़ी हुयी दोय दोय खाचा हो; निवास-जागा को सब तक्ता ख येको भाति सी बनवायजो। <verse eid="EXO 26:17" /><verse number="18" style="v" sid="EXO 26:18" />निवास-जागा लायी जो तक्ता तय बनवायजो उन्म सी बीस तक्ता त दक्षिन की तरफ लायी हो; <verse eid="EXO 26:18" /><verse number="19" style="v" sid="EXO 26:19" />अऊर बीस तक्तां को नीचो चांदी की चालीस आधार-तक्ता बनाजो, मतलब एक एक तक्तां को नीचो ओको खाचा लायी दोय दोय आधार-तक्ता बनवाजो। <verse eid="EXO 26:19" /><verse number="20" style="v" sid="EXO 26:20" />निवास को दूसरी तरफ, मतलब उत्तर की तरफ लायी बीस तक्तां बनवायजो; <verse eid="EXO 26:20" /><verse number="21" style="v" sid="EXO 26:21" />अऊर उन्को लायी चांदी की चालीस आधार-तक्ता बनवायजो, मतलब एक एक तक्तां को नीचो दोय दोय हो।” <verse eid="EXO 26:21" /><verse number="22" style="v" sid="EXO 26:22" />निवास को पीछू तरफ, मतलब पश्चिम की तरफ लायी छय तक्तां बनवायजो। <verse eid="EXO 26:22" /><verse number="23" style="v" sid="EXO 26:23" />अऊर पिछलो हिस्सा म निवास को कोना लायी दोय तक्तां बनवायजो; <verse eid="EXO 26:23" /><verse number="24" style="v" sid="EXO 26:24" />अऊर या नीचो सी दोय दोय हिस्सा को हो, अऊर दोयी हिस्सा ऊपर को कोना तक एक एक कड़ा म मिलाये जाये; दोयी तक्तां को योच रूप हो; या दोयी कोनो लायी आय। <verse eid="EXO 26:24" /><verse number="25" style="v" sid="EXO 26:25" />अऊर आठ तक्ता हो, अऊर उन्की चांदी की आधार-तक्ता हो, मतलब एक एक तक्ता को नीचो दोय दोय हो। <verse eid="EXO 26:25" /><verse number="26" style="v" sid="EXO 26:26" />“तब बबूल की लकड़ी को डन्डा बनायजो, मतलब निवास को एक तरफ को तक्तां लायी पाच, <verse eid="EXO 26:26" /><verse number="27" style="v" sid="EXO 26:27" />अऊर निवास को दूसरी तरफ को तक्तां लायी पाच डन्डा अऊर निवास को जो भाग पश्चिम की तरफ पीछू भाग म होयेंन, ओको लायी पाच बेंड़े बनायजो।” <verse eid="EXO 26:27" /><verse number="28" style="v" sid="EXO 26:28" />बीच वालो डन्डा जो तक्तां को बीच म होयेंन ऊ तम्बू को एक कोना सी दूसरो कोना तक जायेंन। <verse eid="EXO 26:28" /><verse number="29" style="v" sid="EXO 26:29" />तक्तां ख सोनो सी मढ़वाजो, अऊर उन्को कड़ां जो डन्डा को सहारा को काम देयेंन उन्ख भी सोनो सी बनवाजो, अऊर बेंड़ा ख भी सोनो सी मढ़वायजो। <verse eid="EXO 26:29" /><verse number="30" style="v" sid="EXO 26:30" />अऊर निवास की जागा ख असो रीति सी खड़ो करजो जसो पहाड़ी पर तोख दिखायो गयो हय।<verse eid="EXO 26:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 26:31" />“तब नीलो, जामुनी अऊर लाल रंग को पतलो धागा सी बुन्यो हुयो कपड़ा को एक बीच वालो परदा बनायजो; ओको पर करूबों को चित्र बुन क बनायजो।” <verse eid="EXO 26:31" /><verse number="32" style="v" sid="EXO 26:32" />अऊर ओख सोनो सी मढ़यो हुयो बबूल को चार खम्बां पर लटकायजो, इन्की खूटी सोनो की हो, अऊर या चांदी की चार आधार-तक्ता पर लगी हुयो, सोनो को छल्ला म फस्यो होन ख होना। <verse eid="EXO 26:32" /><verse number="33" style="v" sid="EXO 26:33" /><note caller="+" style="x"><char style="xo" closed="false">26:33 </char><char style="xt" closed="false"><ref loc="HEB 6:19">इब्रानियों ६:१९</ref>; <ref loc="HEB 9:3-5">९:३-५</ref></char></note>अऊर बीच वालो परदा ख खूटी को नीचो लटकाय क, ओकी आड़ म साक्षी पत्र को सन्दूक अन्दर ले जानो, यो तरह ऊ बीच वालो परदा तुम्हरो लायी पवित्र जागा ख परम पवित्र जागा सी अलग करयो रहेंन। <verse eid="EXO 26:33" /><verse number="34" style="v" sid="EXO 26:34" />फिर परम पवित्र जागा म गवाही चिट्ठी को सन्दूक को ऊपर पश्चाताप को ढक्कन ख रखजो। <verse eid="EXO 26:34" /><verse number="35" style="v" sid="EXO 26:35" />अऊर ऊ परदा को बाहेर निवास को उत्तर को तरफ मेज रखजो; अऊर ओको दक्षिन तरफ मेज को आगु दीवट ख रखजो। <verse eid="EXO 26:35" /><verse number="36" style="v" sid="EXO 26:36" />फिर तम्बू को द्वार लायी नीलो, जामुनी अऊर लाल रंग को अऊर पतलो धागा सी बुन्यो हुयो एक परदा बनवायजो। <verse eid="EXO 26:36" /><verse number="37" style="v" sid="EXO 26:37" />अऊर यो परदा लायी बबूल को पाच खम्बा बनायजो, अऊर उन्ख सोनो सी मढ़वाना; उन्को कड़ां सोनो की हो, अऊर उन्को लायी पीतल की पाच तक्ता ढलवाय क बनायजो।<verse eid="EXO 26:37" /></para>
  <chapter eid="EXO 26" />
  <chapter number="27" style="c" sid="EXO 27" />
  <para style="s">होमबलि की वेदी</para>
  <para style="r">(<ref loc="EXO 38:1-7">निर्गमन ३८:१-७</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 27:1" />परमेश्वर न मूसा सी कह्यो, “तब वेदी ख बबूल की लकड़ी सी, पाच हाथ लम्बी अऊर पाच हाथ चौड़ी बनायजो; वेदी चौकोन हो, अऊर ओकी ऊंचायी तीन हाथ की हो। <verse eid="EXO 27:1" /><verse number="2" style="v" sid="EXO 27:2" />अऊर ओको चारयी कोनो पर चार सींग बनायजो; हि ओको सहित एकच तुकड़ा को हो, अऊर ओख पीतल सी मढ़वायजो। <verse eid="EXO 27:2" /><verse number="3" style="v" sid="EXO 27:3" />अऊर ओकी राख उठान को सुपड़ी, अऊर पावड़ा, अऊर कटोरा, अऊर दोय दाती पावड़ा, अऊर आगी सामान बनायजो; ओको सब सामान पीतल को होना। <verse eid="EXO 27:3" /><verse number="4" style="v" sid="EXO 27:4" />ओको लायी पीतल की एक जाली बनायजो; अऊर ओको चारयी कोनो पर पीतल को चार कड़ा लगवायजो। <verse eid="EXO 27:4" /><verse number="5" style="v" sid="EXO 27:5" />अऊर वा जाली ख वेदी को चारयी तरफ की मेज को नीचो असो लगवायजो कि ऊ वेदी की ऊचायी को बीच तक पहुंच्यो। <verse eid="EXO 27:5" /><verse number="6" style="v" sid="EXO 27:6" />अऊर वेदी लायी बबूल की लकड़ी को डन्डा बनायजो, अऊर उन्ख पीतल सी मढ़वाजो। <verse eid="EXO 27:6" /><verse number="7" style="v" sid="EXO 27:7" />अऊर डन्डा ख कड़ों म असो डाले कि जब वेदी उठायी जाये तब हि ओको दोयी किनार पर रह्य सके। <verse eid="EXO 27:7" /><verse number="8" style="v" sid="EXO 27:8" />वेदी ख तक्तों सी खोखली बनवायजो; जसी ऊ पहाड़ी पर तोख दिखायो होतो वसोच बनवाजो।”<verse eid="EXO 27:8" /></para>
  <para style="s">पवित्र तम्बू को आंगन</para>
  <para style="r">(<ref loc="EXO 38:9-20">निर्गमन ३८:९-२०</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 27:9" />“फिर निवास को आंगन ख बनायजो। ओको दक्षिन की तरफ लायी पतलो धागा बिन्यो हुयो कपड़ा को परदा हो, ओकी लम्बायी सौव हाथ की होय; एक किनार पर इतनोच हो। <verse eid="EXO 27:9" /><verse number="10" style="v" sid="EXO 27:10" />अऊर उन्को लायी बीस खम्बा बनेंन, अऊर इन्को लायी पीतल की बीस तक्ता होना, अऊर खम्बा को कुन्दा अऊर उन्की पट्टियां चांदी की होना। <verse eid="EXO 27:10" /><verse number="11" style="v" sid="EXO 27:11" />अऊर उच तरह आंगन को उत्तर की तरफ की लम्बायी म भी सौ हाथ लम्बो परदा होना, अऊर उन्को लायी भी बीस खम्बा अऊर इन्को लायी भी पीतल को बीस खाना होना; अऊर उन खम्बों को कुन्दा अऊर पट्टियां चांदी की होना। <verse eid="EXO 27:11" /><verse number="12" style="v" sid="EXO 27:12" />फिर आंगन की चौड़ायी म पश्चिम की तरफ पचास हाथ को परदा हो, उन्को लायी खम्बा दस अऊर खानो भी दस हय। <verse eid="EXO 27:12" /><verse number="13" style="v" sid="EXO 27:13" />पूर्व की तरफ आंगन की चौड़ायी पचास हाथ की होना। <verse eid="EXO 27:13" /><verse number="14" style="v" sid="EXO 27:14" />आंगन को फाटक की एक तरफ पन्द्रा हाथ को परदा हय, अऊर उन्को लायी खम्बा तीन अऊर खाना तीन होना; <verse eid="EXO 27:14" /><verse number="15" style="v" sid="EXO 27:15" />अऊर दूसरी तरफ भी पन्द्रा हाथ को परदा हो, उन्को लायी भी खम्बा तीन अऊर खाना तीन होना। <verse eid="EXO 27:15" /><verse number="16" style="v" sid="EXO 27:16" />आंगन को फाटक लायी एक परदा बनायजो, जो नीलो, जामुनी अऊर लाल रंग को कपड़ा अऊर पतलो बुन्यो हुयो सूती कपड़ा सी बन्यो होयेंन, ओको लायी खम्बा चार अऊर खाना भी चार होना। <verse eid="EXO 27:16" /><verse number="17" style="v" sid="EXO 27:17" />आंगन को चारयी तरफ को सब खम्बां चांदी की पट्टियां सी जुड़्यो हुयो हो, उन्को कुन्दा चांदी को अऊर खाना पीतल को हो। <verse eid="EXO 27:17" /><verse number="18" style="v" sid="EXO 27:18" />आंगन की लम्बायी सौ हाथ की अऊर ओकी चौड़ायी सब जागा पचास हाथ की हो, ओको परदा की ऊचायी पाच हाथ की हो, तब ऊ पतलो बुन्यो हुयो सूती कपड़ा सी बन्यो हो, खम्बों को खाना पीतल को होना। <verse eid="EXO 27:18" /><verse number="19" style="v" sid="EXO 27:19" />निवास जागा को अलग अलग तरह को बर्तन अऊर सब सामान अऊर ओको सब खूटा अऊर आंगन को भी सब खूटा पीतल को हो।<verse eid="EXO 27:19" /></para>
  <para style="s">दीया लायी देख-भाल</para>
  <para style="r">(<ref loc="LEV 24:1-4">लैव्यव्यवस्था २४:१-४</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 27:20" />“तब तय इस्राएलियों ख आज्ञा देजो, कि मोरो जवर दीया लायी पीस क निकाल्यो हुयो जैतून को शुद्ध तेल ले आजो, जेकोसी दीया हमेशा जलतो रहेंन। <verse eid="EXO 27:20" /><verse number="21" style="v" sid="EXO 27:21" />परमेश्वर को उपस्थिति को तम्बू म, उच बीच वालो परदा सी बाहेर जो साक्षी चिट्ठी को आगु होयेंन, हारून अऊर ओको टुरा दीया शाम सी सुबेरे तक परमेश्वर को आगु सजाय क रखो। या विधि इस्राएलियों की पीढ़ियों लायी हमेशा बन्यो रहेंन।”<verse eid="EXO 27:21" /></para>
  <chapter eid="EXO 27" />
  <chapter number="28" style="c" sid="EXO 28" />
  <para style="s">याजकों को पवित्र कपड़ा</para>
  <para style="r">(<ref loc="EXO 39:1-7">निर्गमन ३९:१-७</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 28:1" />“तब तय इस्राएलियों म सी अपनो भाऊ हारून, अऊर नादाब, अबीहू, एलीआजार अऊर ईतामार नाम को ओको टुरावों ख अपनो जवर ले आजो कि हि मोरो लायी याजक को काम करेंन। <verse eid="EXO 28:1" /><verse number="2" style="v" sid="EXO 28:2" />अऊर तय अपनो भाऊ हारून लायी वैभव अऊर शोभा को लायी पवित्र कपड़ा बनाजो। <verse eid="EXO 28:2" /><verse number="3" style="v" sid="EXO 28:3" />अऊर जितनो बुद्धि वालो कारागिर हय, जिन्ख मय न बुद्धि देन वाली आत्मा सी परिपूर्न करयो हय, उन्को तय हारून को कपड़ा बनान की आज्ञा दे कि ऊ मोरो लायी याजक को काम करन लायी पवित्र बनो। <verse eid="EXO 28:3" /><verse number="4" style="v" sid="EXO 28:4" />जो कपड़ा उन्ख बनानो होयेंन हि यो हंय, मतलब सीनाबन्द, अऊर एपोद पोशाक, अऊर बागा, चारखाने को अंगरखा, फेटा अऊर कमर पट्टा; योच पवित्र कपड़ा तोरो भाऊ हारून अऊर ओको टुरावों लायी बनाये जाये कि हि मोरो लायी याजक को काम करेंन। <verse eid="EXO 28:4" /><verse number="5" style="v" sid="EXO 28:5" />अऊर हि सोनो अऊर नीलो अऊर जामुनी अऊर लाल रंग को अऊर पतलो धागा सी बुन्यो हुयो कपड़ा ले।<verse eid="EXO 28:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 28:6" />“हि एपोद ख सोनो अऊर नीलो, जामुनी अऊर लाल रंग को कपड़ा को अऊर पतलो धागा सी बिन्यो हुयो कपड़ा बनाये, जो कि निपुनता सी बुनायी को काम करन वालो को हाथ को काम हो। <verse eid="EXO 28:6" /><verse number="7" style="v" sid="EXO 28:7" />ऊ यो तरह सी जोड़्यो जाये कि ओको दोयी कन्धों को कोना आपस म मिल्यो रहेंन। <verse eid="EXO 28:7" /><verse number="8" style="v" sid="EXO 28:8" />अऊर एपोद पर जो ओख पर निपुनता सी बुन्यो हुयो कमर पट्टा होयेंन, ओकी बनावट ओकोच समान हो, अऊर हि दोयी बिना जोड़ को हो, अऊर सोनो अऊर नीलो, जामुनी अऊर लाल रंग वालो अऊर पतलो धागा सी बुन्यो हुयो कपड़ा को हो। <verse eid="EXO 28:8" /><verse number="9" style="v" sid="EXO 28:9" />फिर दोय सुलैमानी मनि ले क उन पर इस्राएल लोगों को टुरावों को नाम खुदवायजो। <verse eid="EXO 28:9" /><verse number="10" style="v" sid="EXO 28:10" />उन्को नामों म सी छय एक मनि पर अऊर शेष छय नाम दूसरो मनि पर, इस्राएल को टुरावों की जनम को अनुसार खुदवायजो। <verse eid="EXO 28:10" /><verse number="11" style="v" sid="EXO 28:11" />मनि खोदन वालो को काम को समान जसो छापा खोद्यो जावय हय, वसोच उन दोय मनियों पर इस्राएल लोगों को टुरावों को नाम मनि पर खुदवायजो; अऊर उन्को सोनो को खाना म जड़वाय देजो। <verse eid="EXO 28:11" /><verse number="12" style="v" sid="EXO 28:12" />अऊर दोयी मनियों ख एपोद को कन्धों पर लगायजो, हि इस्राएलियों को याद दिलावन वाली मनि ठहरेंन; मतलब हारून उन्को नाम परमेश्वर को आगु अपनो दोयी कन्धों पर याद लायी लगायो रखेंन।<verse eid="EXO 28:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EXO 28:13" />“तब सोनो को खाना बनायजो, <verse eid="EXO 28:13" /><verse number="14" style="v" sid="EXO 28:14" />अऊर डोरियों को समान गूथ्यो हुयो दोय संकली शुद्ध सोनो को बनायजो; अऊर गूथ्यो हुयो संकलियों ख उन खाना म फसाय देजो।<verse eid="EXO 28:14" /></para>
  <para style="s">सीनाबन्द या चपरास</para>
  <para style="r">(<ref loc="EXO 39:8-21">निर्गमन ३९:८-२१</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 28:15" />“तब न्याय की चपरास ख भी बुनायी को काम को बनायजो, एपोद को समान सोनो, अऊर नीलो, जामुनी अऊर लाल रंग को अऊर पतलो धागा सी बिन्यो हुयो कपड़ा की ओख बनायजो। <verse eid="EXO 28:15" /><verse number="16" style="v" sid="EXO 28:16" />ऊ चौकोन अऊर डबल हो, अऊर ओकी लम्बायी अऊर चौड़ायी एक एक बिल्लस की हो। <verse eid="EXO 28:16" /><verse number="17" style="v" sid="EXO 28:17" />अऊर ओको म चार लायीन मनि जोड़जो। पहिली लायीन म त माणिक्य, पुखराज अऊर लालड़ी हो; <verse eid="EXO 28:17" /><verse number="18" style="v" sid="EXO 28:18" />दूसरी लायीन म मरकत, नीलमनि अऊर हीरा : <verse eid="EXO 28:18" /><verse number="19" style="v" sid="EXO 28:19" />तीसरी लायीन म लशम, सूर्यकान्त अऊर नीलम; <verse eid="EXO 28:19" /><verse number="20" style="v" sid="EXO 28:20" />अऊर चौथी लायीन म फीरोज़ा, सुलैमानी मनि अऊर यशब हो; यो सब सोनो को खाना म जड़्यो जाये। <verse eid="EXO 28:20" /><verse number="21" style="v" sid="EXO 28:21" />अऊर इस्राएल लोग को टुरावों को जितनो नाम हंय उतनो मनि हो, मतलब ओको नामों की गिनती को अनुसार बारा नाम खुदें, बारा वंशों म सी एक एक को नाम एक एक मनि पर असो खुद्यो जसो छाप खोद्यो जावय हय। <verse eid="EXO 28:21" /><verse number="22" style="v" sid="EXO 28:22" />तब चपरास पर डोरियों को समान गूंथ्यो हुयो शुद्ध सोनो की संकली लगायजो; <verse eid="EXO 28:22" /><verse number="23" style="v" sid="EXO 28:23" />अऊर चपरास म सोनो की दोय कड़ियां लगवायजो, अऊर दोयी कड़ियों ख चपरास को दोयी कोनो पर लगवायजो। <verse eid="EXO 28:23" /><verse number="24" style="v" sid="EXO 28:24" />अऊर सोनो को दोयी गूंथ्यो संकली ख उन दोयी कड़ियों म जो चपरास<note caller="+" style="f"><char style="fr" closed="false">28:24 </char><char style="ft" closed="false">सिनाबन्ध</char></note> को कोनो पर होयेंन लगवायजो; <verse eid="EXO 28:24" /><verse number="25" style="v" sid="EXO 28:25" />अऊर गूंथ्यो हुयो दोयी संकली को दोयी बाकी कोनो ख दोयी खानों म जड़वाय क एपोद को दोयी कन्धों को बन्धनों पर ओको आगु लगवायजो। <verse eid="EXO 28:25" /><verse number="26" style="v" sid="EXO 28:26" />तब सोनो की दोय अऊर कड़ियां बनाय क चपरास को दोयी कोनो पर, ओकी उच कोना पर जो एपोद को अन्दर की तरफ होयेंन लगायजो। <verse eid="EXO 28:26" /><verse number="27" style="v" sid="EXO 28:27" />तब उन्को सिवाय सोनो की दोय अऊर कड़ियां बनाय क एपोद को दोयी कन्धों को बन्धनों पर, नीचो सी ओको आगु अऊर ओको जोड़ को जवर एपोद को अच्छो सी बन्यो हुयो पट्टे को ऊपर लगवायजो। <verse eid="EXO 28:27" /><verse number="28" style="v" sid="EXO 28:28" />अऊर चपरास अपनी कड़ियों को द्वारा एपोद की कड़ियों म नीलो फीते सी बान्धी जाये या रीति ऊ एपोद को काढ़यो हुयो अच्छो सी बिन्यो हुयो पट्टे झूलतो रहेंन, अऊर चपरास एपोद पर सी अलग नहीं होन पाये। <verse eid="EXO 28:28" /><verse number="29" style="v" sid="EXO 28:29" />जब जब हारून पवित्र जागा म सिरयो करेंन, तब तब ऊ न्याय की चपरास पर अपनो दिल को ऊपर इस्राएलियों को नामों ख लगाये रहेंन, जेकोसी परमेश्वर को आगु उन्को याद हमेशा रहेंन। <verse eid="EXO 28:29" /><verse number="30" style="v" sid="EXO 28:30" /><note caller="+" style="x"><char style="xo" closed="false">28:30 </char><char style="xt" closed="false"><ref loc="NUM 27:21">गिनती २७:२१</ref>; <ref loc="DEU 33:8">व्यवस्थाविवरन ३३:८</ref>; <ref loc="EZR 2:63">एज्रा २:६३</ref>; <ref loc="NEH 7:65">नहेम्याह ७:६५</ref></char></note>अऊर तय न्याय की चपरास म ऊरीम अऊर तुम्मीम<note caller="+" style="f"><char style="fr" closed="false">28:30 </char><char style="ft" closed="false">दोय चिजे, जिन्को द्वारा परमेश्वर की ज्ञात करी जात होती; पर या टीक-ठीक ज्ञात नहाय कि इन्को उपयोग कसो तरह करयो जात होतो</char></note> ख रखजो, अऊर जब जब हारून परमेश्वर को आगु आये, तब तब हि ओको दिल को ऊपर हो, यो तरह हारून इस्राएलियों लोगों लायी परमेश्वर को न्याय ख अपनो दिल को ऊपर हमेशा लगाये रहेंन।<verse eid="EXO 28:30" /></para>
  <para style="s">दूसरो याजकीय कपड़ा</para>
  <para style="r">(<ref loc="EXO 39:22-31">निर्गमन ३९:२२-३१</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 28:31" />“तब एपोद को पोशाक ख पूरो नीलो रंग को बनायजो। <verse eid="EXO 28:31" /><verse number="32" style="v" sid="EXO 28:32" />ओकी बनावट असी हो कि ओको बीच म मुंड डालन लायी छेद हो अऊर ओको चारयी तरफ कपड़ा की कालर को जसी गोट बनायजो मतलब पोशाक को ऊ भाग फटनो नहीं पाये। <verse eid="EXO 28:32" /><verse number="33" style="v" sid="EXO 28:33" />ओको खल्लो को घेरा म चारयी तरफ नीलो, जामुनी अऊर लाल रंग को कपड़ा को अनार जसो गोल बनायजो, अऊर ओको बीच चारयी तरफ सोनो को घन्टी लगवाना, <verse eid="EXO 28:33" /><verse number="34" style="v" sid="EXO 28:34" />मतलब एक सोनो को घन्टी अऊर एक अनार, लगातार योच रीति सी पोशाक को खल्लो वालो घेरा म चारयी तरफ असोच होना। <verse eid="EXO 28:34" /><verse number="35" style="v" sid="EXO 28:35" />अऊर हारून उच पोशाक ख याजक को काम करतो समय पहिने, कि जब जब ऊ पवित्र जागा को अन्दर परमेश्वर को आगु जायेंन यां बाहेर निकलेंन, तब तब ओको आवाज सुनायी दे, नहीं त ऊ मर जायेंन।<verse eid="EXO 28:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EXO 28:36" />“शुद्ध सोनो की एक पट्टी बनाना, अऊर जसो मुहर म अक्षर खोद्यो जावय हय वसोच ओको पर ‘परमेश्वर लायी पवित्र अक्षर खोद्यो जाये।’ <verse eid="EXO 28:36" /><verse number="37" style="v" sid="EXO 28:37" />अऊर ओख नीलो फीते सी बान्धजो; अऊर ऊ फेटा को आगु को भाग पर रहेंन। <verse eid="EXO 28:37" /><verse number="38" style="v" sid="EXO 28:38" />ऊ हारून को मस्तक पर रहेंन, येकोलायी कि इस्राएली जो कुछ पवित्र ठहराये, मतलब जितनो पवित्र चीजो भेंट म चढ़ायो उन पवित्र चीजो को दोष हारून उठाये रहेंन, अऊर ऊ हमेशा ओको मस्तक पर रहेंन, जेकोसी परमेश्वर उन्को सी खुश रहेंन।<verse eid="EXO 28:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="EXO 28:39" />“अंगरखा ख महीन सूती को कपड़ा चारखाना वालो बनायजो, अऊर एक फेटा भी महीन सूती कपड़ा को बनायजो, अऊर रस्सी जसो बन्यो हुयो एक कमर बन्द भी बनायजो।<verse eid="EXO 28:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EXO 28:40" />“तय हारून को टुरावों लायी भी कपड़ा अऊर कमर बन्द अऊर टोपियां बनायजो; यो कपड़ा भी वैभव अऊर शोभा लायी बनेंन। <verse eid="EXO 28:40" /><verse number="41" style="v" sid="EXO 28:41" />अपनो भाऊ हारून अऊर ओको टुरावों ख योच सब कपड़ा पहिनाय क उन्को अभिषेक अऊर संस्कार करजो, अऊर उन्ख पवित्र करजो कि हि मोरो लायी याजक को काम करेंन। <verse eid="EXO 28:41" /><verse number="42" style="v" sid="EXO 28:42" />अऊर उन्को लायी सन को कपड़ा की चड्डी बनाजो जिन्कोसी उन्को शरीर झक्यो रहेंन, हि कमर सी जांघ तक लम्बी हो; <verse eid="EXO 28:42" /><verse number="43" style="v" sid="EXO 28:43" />अऊर जब जब हारून यां ओको टुरा मिलाप वालो तम्बू म सिरेंन, यां पवित्र जागा म याजक को काम करन को वेदी को जवर जाये, तब तब हि चड्डी ख पहिने रहेंन, नहीं त हि दोषी ठहरेंन अऊर मर जाये। यो हारून लायी अऊर ओको बाद ओको वंश लायी भी हमेशा कि विधि ठहरे।<verse eid="EXO 28:43" /></para>
  <chapter eid="EXO 28" />
  <chapter number="29" style="c" sid="EXO 29" />
  <para style="s">हारून अऊर ओको टुरावों को याजक पद</para>
  <para style="r">(<ref loc="LEV 8:1-36">लैव्यव्यवस्था ८:१-३६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 29:1" />“उन्ख पवित्र करन ख जो काम तोख उन को संग करनो हय कि हि मोरो लायी याजक को काम करेंन, ऊ यो हय: एक निर्दोष बछड़ा अऊर दोय निर्दोष मेंढी लेजो, <verse eid="EXO 29:1" /><verse number="2" style="v" sid="EXO 29:2" />अऊर अखमीरी रोटी, अऊर तेल सी सन्यो हुयो मैदा को अखमीरी सुवारी, अऊर तेल सी चुपड़ी हुयी अखमीरी पपड़ियां भी लेजो। यो सब गहूं को मैदा को बनायजो। <verse eid="EXO 29:2" /><verse number="3" style="v" sid="EXO 29:3" />इन्को एक टोकनी म रख क उच टोकनी ख ओको बछड़ा अऊर उन दोयी मेंढी सहित जवर लायजो। <verse eid="EXO 29:3" /><verse number="4" style="v" sid="EXO 29:4" />तब हारून अऊर ओको टुरावों ख मिलाप वालो तम्बू को फाटक को जवर सी लिजाय क पानी सी धुलायजो। <verse eid="EXO 29:4" /><verse number="5" style="v" sid="EXO 29:5" />तब उन कपड़ा ख ले क हारून ख अंगरखा अऊर एपोद को पोशाक पहिनाजो, अऊर एपोद अऊर चपरास बान्धनो, अऊर एपोद को बनायो हुयो पट्टा भी बांधजो; <verse eid="EXO 29:5" /><verse number="6" style="v" sid="EXO 29:6" />अऊर ओको मुंड पर फेटा रखजो, अऊर फेटा पर पवित्र मुकुट ख रखजो। <verse eid="EXO 29:6" /><verse number="7" style="v" sid="EXO 29:7" />तब पवित्र तेल ले क ओको मुंड पर डाल क ओको अभिषेक करजो। <verse eid="EXO 29:7" /><verse number="8" style="v" sid="EXO 29:8" />तब ओको टुरावों ख जवर लिजाय क उन्को अंगरखा पहिनाजो, <verse eid="EXO 29:8" /><verse number="9" style="v" sid="EXO 29:9" />अऊर उन्को मतलब हारून अऊर ओको टुरावों को कमर बान्धजो अऊर उन्को मुंड पर टोपियां रखजो; जेकोसी याजक को पद पर हमेशा उन्को अधिकार रहेंन। यो तरह हारून अऊर ओको टुरावों को संस्कार करजो।<verse eid="EXO 29:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 29:10" />“तब बछड़ा ख परमेश्वर की उपस्थिति को तम्बू को आगु ले आजो। हारून अऊर ओको टुरा, बछड़ा की मुंड पर अपनो अपनो हाथ रखे, <verse eid="EXO 29:10" /><verse number="11" style="v" sid="EXO 29:11" />तब ऊ बछड़ा ख परमेश्वर को आगु मिलाप वालो तम्बू की फाटक पर बलिदान करजो, <verse eid="EXO 29:11" /><verse number="12" style="v" sid="EXO 29:12" />अऊर बछड़ा को खून म सी कुछ ले क अपनो बोट सी वेदी को सींगो पर लगाजो, अऊर शेष सब खून ख वेदी को पाये पर कुड़ाय देजो, <verse eid="EXO 29:12" /><verse number="13" style="v" sid="EXO 29:13" />अऊर जेको चरबी सी अंतड़ियां झकी रह्य हंय, अऊर जो झिल्ली कलेजे को ऊपर होवय हय, उन्को अऊर दोयी गुर्दो ख उन्को ऊपर चरबी सहित लेकर सब ख वेदी पर जलाजो। <verse eid="EXO 29:13" /><verse number="14" style="v" sid="EXO 29:14" />पर बछड़ा को मांस, अऊर खाल, अऊर गोबर, छावनी सी बाहेर आगी म जलाय देजो; कहालीकि यो पापबलि होयेंन।<verse eid="EXO 29:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 29:15" />“फिर एक मेंढा लेजो, अऊर हारून अऊर ओको टुरा ओकी मुंड पर अपनो अपनो हाथ रखे, <verse eid="EXO 29:15" /><verse number="16" style="v" sid="EXO 29:16" />तब उच मेंढी ख बलि करजो, अऊर ओको खून ले क वेदी पर चारयी तरफ छिड़क देजो। <verse eid="EXO 29:16" /><verse number="17" style="v" sid="EXO 29:17" />तब ऊ मेंढा ख तुकड़ा तुकड़ा काटजो, अऊर ओकी अंतड़ियां अऊर पाय ख धोय क ओको तुकड़ा मुंड को संग म रखजो, <verse eid="EXO 29:17" /><verse number="18" style="v" sid="EXO 29:18" /><note caller="+" style="x"><char style="xo" closed="false">29:18 </char><char style="xt" closed="false"><ref loc="EPH 5:2">इफिसियों ५:२</ref>; <ref loc="PHP 4:18">फिलिप्पियों ४:१८</ref></char></note>अऊर पूरो मेंढा ख वेदी पर जलाजो; ऊ त परमेश्वर लायी होमबलि होयेंन; ऊ सुखदायक सुगन्ध अऊर परमेश्वर लायी हवन होयेंन।<verse eid="EXO 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 29:19" />“फिर दूसरो मेंढा ख लेजो; अऊर हारून अऊर ओको टुरा ओकी मुंड पर अपनो अपनो हाथ रखे, <verse eid="EXO 29:19" /><verse number="20" style="v" sid="EXO 29:20" />तब ऊ मेंढा ख बलि करजो, अऊर ओको खून म सी कुछ ले क हारून अऊर ओको टुरावों को दायो कान को कोना पर, अऊर उन्को दायो हाथ अऊर दायो पाय को अंगुठा पर लगाजो, अऊर खून ख वेदी पर चारयी तरफ छिड़क देजो। <verse eid="EXO 29:20" /><verse number="21" style="v" sid="EXO 29:21" />फिर वेदी पर को खून अऊर अभिषेक को तेल, इन्को दोयी म सी थोड़ो थोड़ो ले क हारून अऊर ओको कपड़ा पर, अऊर ओको टुरावों अऊर उन्को कपड़ा पर भी छिड़क देजो; तब ऊ अपनो कपड़ा सहित, अऊर ओको टुरा भी अपनो अपनो कपड़ा सहित पवित्र होय जायेंन। <verse eid="EXO 29:21" /><verse number="22" style="v" sid="EXO 29:22" />तय उच मेंढी को चरबी लेजो, अऊर मोटी पूछ को अऊर जेको चरबी सी अतड़ियां झकी रह्य हंय ओको, अऊर कलेजा पर की झिल्ली ख, अऊर चरबी सहित दोयी गुर्दां ख, अऊर दायो जांघ लेजो, कहालीकि यो पुरोहित को अभिषेक बलि को मेंढा हय। <verse eid="EXO 29:22" /><verse number="23" style="v" sid="EXO 29:23" />अऊर अखमीरी रोटी की टोकनी जो परमेश्वर को आगु रखी होना ओख म सी भी एक रोटी, अऊर तेल सी सान्यो हुयो मैदा को एक सुवारी, अऊर एक पपड़ी लेजो, <verse eid="EXO 29:23" /><verse number="24" style="v" sid="EXO 29:24" />इन सब ख हारून अऊर ओको टुरावों को हाथों म रख क हिलाये जान की भेंट ठहराय क् परमेश्वर को आगु हिलायो जाये। <verse eid="EXO 29:24" /><verse number="25" style="v" sid="EXO 29:25" />तब उन चीजो ख उन्को हाथों सी ले क होमबलि की वेदी पर जलाय देजो, जेकोसी ऊ परमेश्वर को आगु सुखदायक सुगन्ध ठहरे; ऊ परमेश्वर लायी हवन होयेंन।<verse eid="EXO 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EXO 29:26" />“फिर हारून को संस्कार को जो मेंढा होना ओकी छाती ख ले क हिलायी जान की भेंट लायी परमेश्वर को आगु लहराजो; अऊर ऊ तोरो भाग ठहरेंन। <verse eid="EXO 29:26" /><verse number="27" style="v" sid="EXO 29:27" />हारून अऊर ओको टुरावों को संस्कार को मेंढा होना ओको म सी हिलाये जान वाली भेंट वाली छाती जो हिलायी जायेंन, अऊर उठायी जान की भेंट वाली जांघ जो उठायी जायेंन, इन दोयी ख पवित्र ठहराजो। <verse eid="EXO 29:27" /><verse number="28" style="v" sid="EXO 29:28" />अऊर यो हमेशा की विधि की रीति पर इस्राएलियों को तरफ सी हारून अऊर ओको टुरावों को भाग रहेंन, कहालीकि यो उठाये जान की भेंट ठहरी हंय; अऊर यो इस्राएलियों को तरफ सी उन्को मेलबलि म सी परमेश्वर लायी उठाये जान की भेंट होयेंन।<verse eid="EXO 29:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 29:29" />“हारून को जो पवित्र कपड़ा रहेंन ऊ ओको बाद ओको टुरा अऊर नाती ख मिलतो रहे, जेको सी उन्खच दे क उन्को अभिषेक अऊर नियुक्त करयो जायेंन। <verse eid="EXO 29:29" /><verse number="30" style="v" sid="EXO 29:30" />ओको टुरावों म सी जो ओको जागा पर याजक होयेंन, ऊ जब पवित्र जागा म सेवा काम करन लायी मिलाप वालो तम्बू म पहले आये, तब उन कपड़ा ख सात दिन तक पहिने रहेंन।<verse eid="EXO 29:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 29:31" />“फिर याजक को अभिषेक-बलि को जो मेंढी होयेंन ओख लेकर ओको मांस कोयी पवित्र जागा म पकाजो; <verse eid="EXO 29:31" /><verse number="32" style="v" sid="EXO 29:32" />तब हारून अपनो टुरावों सहित उच मेंढी को मांस अऊर टोकनी की रोटी, दोयी ख मिलाप वालो तम्बू को फाटक पर खाये। <verse eid="EXO 29:32" /><verse number="33" style="v" sid="EXO 29:33" />जिन चिजों सी उन्को अभिषेक अऊर उन्ख पवित्र करन लायी प्रायश्चित करयो जायेंन उन्को त हि खाये, पर दूसरो वंश को कोयी उन्ख नहीं खान पाये, कहालीकि हि पवित्र होयेंन। <verse eid="EXO 29:33" /><verse number="34" style="v" sid="EXO 29:34" />यदि अभिषेक वालो मांस यां रोटी म सी कुछ सुबेरे तक बच्यो रहेंन, त उच बच्यो हुयो ख आगी म जलाजो, ऊ खायो नहीं जाये; कहालीकि ऊ पवित्र होयेंन।<verse eid="EXO 29:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 29:35" />“मय न तोख जो जो आज्ञा दियो हय; उन सब को अनुसार तय हारून अऊर ओको टुरावों सी करनो; अऊर सात दिन तक उन्को संस्कार विधि करतो रहजो, <verse eid="EXO 29:35" /><verse number="36" style="v" sid="EXO 29:36" />मतलब पापबलि को एक बछड़ा प्रायश्चित लायी हर दिन चढ़ाजो। वेदी ख भी प्रायश्चित करन को समय‍ शुद्ध करजो, अऊर ओख पवित्र करन लायी ओको संस्कार करजो। <verse eid="EXO 29:36" /><verse number="37" style="v" sid="EXO 29:37" />सात दिन तक वेदी लायी प्रायश्चित कर क् ओख शुद्ध अऊर पवित्र करजो, अऊर वेदी परम पवित्र ठहरेंन; अऊर जो कुछ ओको सी छूय जायेंन ऊ भी पवित्र होय जायेंन।<verse eid="EXO 29:37" /></para>
  <para style="s">रोज की भेंट</para>
  <para style="r">(<ref loc="NUM 28:1-8">गिनती २८:१-८</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="EXO 29:38" />“जो तोख वेदी पर हमेशा चढ़ानो होयेंन ऊ यो आय : हर दिन एक एक साल को दोय मेंढी को बच्चा चढ़ाजो। <verse eid="EXO 29:38" /><verse number="39" style="v" sid="EXO 29:39" />एक मेंढी को बच्चां ख त सुबेरे को समय, अऊर दूसरो मेंढी को बच्चां ख शाम को समय चढ़ाजो; <verse eid="EXO 29:39" /><verse number="40" style="v" sid="EXO 29:40" />अऊर पहिलो मेंढी को बच्चां को संग दोय लिटर को तेल सी उसन्यो हुयो एक किलो मैदा, अऊर बली लायी अंगूर को रस चढ़ाजो। <verse eid="EXO 29:40" /><verse number="41" style="v" sid="EXO 29:41" />अऊर दूसरो मेंढी को बच्चां ख शाम को समय चढ़ाजो, अऊर ओको संग सुबेरे की रीति अनुसार अनाज बलि अऊर अर्घ दोयी देजो, जेको सी ऊ सुखदायक सुगन्ध अऊर परमेश्वर लायी हवन ठहरे। <verse eid="EXO 29:41" /><verse number="42" style="v" sid="EXO 29:42" />तुम्हरो पीढ़ी सी पीढ़ी म परमेश्वर को आगु मिलाप वालो तम्बू को फाटक पर हमेशा असोच होमबलि होतो रहे; यो ऊ जागा आय जेको म मय तुम लोगों सी येकोलायी मिल्यो करूं कि तोरो सी बाते करू। <verse eid="EXO 29:42" /><verse number="43" style="v" sid="EXO 29:43" />मय इस्राएली लोगों सी उतच मिल्यो करूं अऊर ऊ तम्बू मोरो तेज सी पवित्र करयो जायेंन; <verse eid="EXO 29:43" /><verse number="44" style="v" sid="EXO 29:44" />अऊर मय मिलाप वालो तम्बू अऊर वेदी ख पवित्र करूं, अऊर हारून अऊर ओको टुरावों ख भी पवित्र करूं कि हि मोरो लायी याजक को काम करेंन। <verse eid="EXO 29:44" /><verse number="45" style="v" sid="EXO 29:45" />अऊर मय इस्राएलियों लोगों को बीच निवास करूं, अऊर उन्को परमेश्वर ठहरूं। <verse eid="EXO 29:45" /><verse number="46" style="v" sid="EXO 29:46" />तब हि जान लेयेंन कि मय यहोवा उन्को परमेश्वर आय, जो उन्को मिस्र देश सी येकोलायी निकाल ले आयो कि उन्को बीच निवास करूं; मयच उन्को परमेश्वर यहोवा आय।<verse eid="EXO 29:46" /></para>
  <chapter eid="EXO 29" />
  <chapter number="30" style="c" sid="EXO 30" />
  <para style="s">धूप जलान की वेदी</para>
  <para style="r">(<ref loc="EXO 37:25-28">निर्गमन ३७:२५-२८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 30:1" />“फिर धूप जलान लायी बबूल की लकड़ी की वेदी बनाजो। <verse eid="EXO 30:1" /><verse number="2" style="v" sid="EXO 30:2" />ओकी लम्बायी एक हाथ अऊर चौड़ायी एक हाथ की हय, ऊ चौकोन हो, अऊर ओकी ऊंचायी दोय हाथ की हो, अऊर ओको सींग ओको तुकड़ा सी बनायो जाये। <verse eid="EXO 30:2" /><verse number="3" style="v" sid="EXO 30:3" />अऊर वेदी को ऊपर वालो पल्ला अऊर चारयी तरफ को बाजुवों ख अऊर सींग ख शुद्ध सोनो सी मढ़वाजो, अऊर इन्को चारयी तरफ सोनो की एक किनार बनाजो। <verse eid="EXO 30:3" /><verse number="4" style="v" sid="EXO 30:4" />अऊर येको किनार को नीचो येको आमने-सामने को दोयी पल्ला पर सोनो को दोय दोय कड़ा बनाय क येको दोयी तरफ लगाजो, हि कड़ा डन्डो को सहारा उठान को काम देयेंन। <verse eid="EXO 30:4" /><verse number="5" style="v" sid="EXO 30:5" />डन्डो ख बबूल की लकड़ी को बनाय क उन्ख सोनो सी मढ़वाजो। <verse eid="EXO 30:5" /><verse number="6" style="v" sid="EXO 30:6" />अऊर तय ओको उच परदा को आगु रखजो जो गवाही चिट्ठी को सन्दूक को आगु हय, मतलब पश्चाताप वालो ढकन को आगु जो गवाही चिट्ठी को ऊपर हय, वहांच मय तोरो सी मिल्यो करूं। <verse eid="EXO 30:6" /><verse number="7" style="v" sid="EXO 30:7" />अऊर ओको वेदी पर हारून सुगन्धित धूप जलायो करेंन; हर दिन सुबेरे ख जब ऊ दीया ख ठीक करेंन तब ऊ धूप जलाये, <verse eid="EXO 30:7" /><verse number="8" style="v" sid="EXO 30:8" />अऊर शाम को समय जब हारून दीयां ख जलाये तब धूप जलायो करेंन, या धूप परमेश्वर को आगु तुम्हरो पीढ़ी पीढ़ी म हमेशा जलायो जाये। <verse eid="EXO 30:8" /><verse number="9" style="v" sid="EXO 30:9" />वा वेदी पर तुम कोयी दूसरो तरह को धूप नहीं जलाजो, अऊर नहीं ओको पर होमबलि अऊर नहीं अन्नबलि चढ़ाजो; अऊर नहीं उच पर अर्घ देजो। <verse eid="EXO 30:9" /><verse number="10" style="v" sid="EXO 30:10" />हारून साल म एक बार येको सींगो पर प्रायश्चित करेंन; अऊर तुम्हरी पीढ़ी पीढ़ी म साल म एक बार प्रायश्चित को पापबलि को खून सी येको पर प्रायश्चित करयो जाये; यो परमेश्वर लायी परम पवित्र हय।”<verse eid="EXO 30:10" /></para>
  <para style="s">प्रानों को प्रायश्चित को शुल्क</para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 30:11" />तब परमेश्वर न मूसा सी कह्यो, <verse eid="EXO 30:11" /><verse number="12" style="v" sid="EXO 30:12" />“जब तय इस्राएलियों लोगों की गिनती लेन लग्यो, तब गिनती को समय जेकी गिनती हुयी हो हि अपनो अपनो जीव लायी परमेश्वर ख प्रायश्चित को शुल्क दे, जेकोसी जब तय उन्की गिनती कर रह्यो हय उच समय कोयी भयानक विपत्ति उन पर नहीं आय पड़ेंन। <verse eid="EXO 30:12" /><verse number="13" style="v" sid="EXO 30:13" /><note caller="+" style="x"><char style="xo" closed="false">30:13 </char><char style="xt" closed="false"><ref loc="EXO 38:25">निर्गमन ३८:२५</ref>,<ref loc="EXO 38:26">26</ref>; <ref loc="MAT 17:24">मत्ती १७:२४</ref></char></note>जितनो लोग गिन्यो जाये हि पवित्र जागा को शेकेल को अनुसार चांदी अरधो शेकेल<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="ft" closed="false">अरधो शेकेल लगभग ६ ग्राम</char></note> दे यो शेकेल बीस गेरा<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="ft" closed="false">बीस गेरा लगभग १२ ग्राम</char></note> को होवय हय, परमेश्वर की भेंट अरधो शेकेल हो। <verse eid="EXO 30:13" /><verse number="14" style="v" sid="EXO 30:14" />बीस साल को यां ओको सी अधिक अवस्था को जितनो गिन्यो जाये उन्म सी हर एक जन परमेश्वर ख भेंट दे। <verse eid="EXO 30:14" /><verse number="15" style="v" sid="EXO 30:15" />जब तुम्हरो जीव को पश्चाताप को निमित्त परमेश्वर कि भेंट अर्पित की जाये, तब धनी लोग अरधो शेकेल सी अधिक नहीं देयेंन; अऊर नहीं गरीब लोग ओख सी कम देयेंन। <verse eid="EXO 30:15" /><verse number="16" style="v" sid="EXO 30:16" />अऊर तय इस्राएलियों सी प्रायश्चित को हिस्सा ले क मिलाप वालो तम्बू को काम म लगाजो; जेकोसी ऊ परमेश्वर को आगु इस्राएलियों को याद गार चिन्ह ठहरे, अऊर उन्को जीव को प्रायश्चित भी हो।”<verse eid="EXO 30:16" /></para>
  <para style="s">पीतल की गंगार</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 30:17" />परमेश्वर न मूसा सी कह्यो, <verse eid="EXO 30:17" /><verse number="18" style="v" sid="EXO 30:18" /><note caller="+" style="x"><char style="xo" closed="false">30:18 </char><char style="xt" closed="false"><ref loc="EXO 38:8">निर्गमन ३८:८</ref></char></note>“धोन लायी पीतल को एक गंगार बनाजो, अऊर ओको पाया भी पीतल को बनाजो। ओको मिलाप वालो तम्बू अऊर वेदी को बीच म रख क उन्म म पानी भर देजो; <verse eid="EXO 30:18" /><verse number="19" style="v" sid="EXO 30:19" />अऊर ओको म हारून अऊर ओको टुरा अपनो अपनो हाथ पाय धोयो करेंन। <verse eid="EXO 30:19" /><verse number="20" style="v" sid="EXO 30:20" />जब जब हि मिलाप वालो तम्बू म सिरेंन तब तब हि हाथ पाय पानी सी धोये, नहीं त मर जायेंन; अऊर जब जब हि वेदी को जवर सेवा करन वेदी को जवर आये, मतलब परमेश्वर लायी हवन जलावन ख आये तब तब हि हाथ पाय धोये, असो नहीं होय कि मर जाये। <verse eid="EXO 30:20" /><verse number="21" style="v" sid="EXO 30:21" />यो हारून अऊर ओको पीढ़ी पीढ़ी को वंश लायी हमेशा की विधि ठहरे।”<verse eid="EXO 30:21" /></para>
  <para style="s">अभिषेक को तेल</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 30:22" />तब परमेश्वर न मूसा सी कह्यो, <verse eid="EXO 30:22" /><verse number="23" style="v" sid="EXO 30:23" />“तय उत्तम सी उत्तम सुगन्धित मसाला लावो, मतलब पवित्र जागा को शेकेल को अनुसार पाच सौ शेकेल<note caller="+" style="f"><char style="fr" closed="false">30:23 </char><char style="ft" closed="false">पाच सौ शेकेल लगभग ६ किलोग्राम</char></note> अपनो आप निकल्यो हुयो गन्धरस, अऊर ओको अरधो, मतलब ढायी सौ शेकेल<note caller="+" style="f"><char style="fr" closed="false">30:23 </char><char style="ft" closed="false">ढायी सौ शेकेल लगभग तीन किलोग्राम</char></note> सुगन्धित कलमी, अऊर ढायी सौ शेकेल सुगन्धित लुभान, <verse eid="EXO 30:23" /><verse number="24" style="v" sid="EXO 30:24" />पवित्र जागा को अनुसार छय किलो तेजपान, अऊर चार लिटर<note caller="+" style="f"><char style="fr" closed="false">30:24 </char><char style="ft" closed="false">एक हीन लगभग चार लिटर</char></note> जैतून को तेल लेजो <verse eid="EXO 30:24" /><verse number="25" style="v" sid="EXO 30:25" />उन्को सी अभिषेक को पवित्र तेल, मतलब सुगन्ध की रीति सी तैयार करयो हुयो सुगन्धित तेल बनायजो; यो अभिषेक को पवित्र तेल ठहरे। <verse eid="EXO 30:25" /><verse number="26" style="v" sid="EXO 30:26" />अऊर ओको सी मिलाप वालो तम्बू को, अऊर गवाही चिट्ठी को सन्दूक पर यो तेल ख डालेंन, <verse eid="EXO 30:26" /><verse number="27" style="v" sid="EXO 30:27" />अऊर पूरो सामान सहित मेज को, अऊर सामान सहित दीया को, अऊर धूप वेदी को <verse eid="EXO 30:27" /><verse number="28" style="v" sid="EXO 30:28" />अऊर पूरो सामान सहित होमबलि वेदी को, अऊर पाये सहित गंगार को सजायजो, <verse eid="EXO 30:28" /><verse number="29" style="v" sid="EXO 30:29" />अऊर उन्ख पवित्र करजो, जेकोसी हि परम पवित्र ठहरेंन; अऊर जो कुछ उन्को सी छुय जायेंन ऊ पवित्र होय जायेंन। <verse eid="EXO 30:29" /><verse number="30" style="v" sid="EXO 30:30" />तय हारून को ओको टुरावों को संग नियुक्त करजो, अऊर यो तरह उन्ख मोरो लायी याजक को काम करन लायी पवित्र करजो। <verse eid="EXO 30:30" /><verse number="31" style="v" sid="EXO 30:31" />अऊर इस्राएलियों लोगों ख मोरी यो आज्ञा सुनाजो, ‘यो तेल तुम्हरो पीढ़ी पीढ़ी म मोरो लायी पवित्र करयो हुयो तेल होयेंन। <verse eid="EXO 30:31" /><verse number="32" style="v" sid="EXO 30:32" />यो कोयी आदमी को शरीर पर नहीं डालो जाये, अऊर मिलावट म ओको समान अऊर कुछ नहीं बनाजो; यो पवित्र हय, यो तुम्हरो लायी भी पवित्र होयेंन। <verse eid="EXO 30:32" /><verse number="33" style="v" sid="EXO 30:33" />जो कोयी येको समान कुछ बनाये, यां जो कोयी येको म सी कुछ पराये कुल वालो पर लगाये, ऊ अपनो लोगों म नहीं गिन्यो जाये’।”<verse eid="EXO 30:33" /></para>
  <para style="s">पवित्र सुगन्धित सामग्री</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 30:34" />फिर परमेश्वर न मूसा सी कह्यो, “बोल, नखी अऊर कुन्दरू, यो सुगन्ध द्रव्य शुद्ध लुभान सहित ले लेजो, हि सब बराबर तौल की मात्रा हो, <verse eid="EXO 30:34" /><verse number="35" style="v" sid="EXO 30:35" />अऊर इन्को धूप मतलब नमक मिलाय क सुगन्ध की रीति को अनुसार शुद्ध अऊर पवित्र सुगन्धित मसाला सी बनायजो। <verse eid="EXO 30:35" /><verse number="36" style="v" sid="EXO 30:36" />फिर ओको म सी कुछ पीस क बारीक क डालजो, तब ओको म सी कुछ मिलाप वालो तम्बू म साक्षी पत्र को आगु, जित पर मय तोरो सी मिल्यो करूं, रखजो; ऊ तुम्हरो लायी परम पवित्र होयेंन। <verse eid="EXO 30:36" /><verse number="37" style="v" sid="EXO 30:37" />जो धूप तय बनायजो, मिलावट म ओको समान तुम लोग अपनो लायी अऊर कुछ नहीं बनायजो; ऊ तुम्हरो आगु परमेश्वर लायी पवित्र होयेंन। <verse eid="EXO 30:37" /><verse number="38" style="v" sid="EXO 30:38" /><note caller="+" style="x"><char style="xo" closed="false">30:38 </char><char style="xt" closed="false"><ref loc="EXO 37:29">निर्गमन ३७:२९</ref></char></note>जो कोयी सूंघन लायी ओको समान कुछ बनाये ऊ अपनो लोगों म न गिन्यो जाये।”<verse eid="EXO 30:38" /></para>
  <chapter eid="EXO 30" />
  <chapter number="31" style="c" sid="EXO 31" />
  <para style="s">तम्बू को लायी कारीगर</para>
  <para style="r">(<ref loc="EXO 35:30">निर्गमन ३५:३०</ref>; <ref loc="EXO 36:1">३६:१</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 31:1" />तब परमेश्वर न मूसा सी कह्यो, <verse eid="EXO 31:1" /><verse number="2" style="v" sid="EXO 31:2" />“सुन, मय ऊरी को टुरा बसलेल को, जो हूर को पोता अऊर यहूदा को वंश को हय, नाम ले कर बुलावय हय। <verse eid="EXO 31:2" /><verse number="3" style="v" sid="EXO 31:3" />अऊर मय ओको परमेश्वर की आत्मा सी जो बुद्धि, हुनर, ज्ञान, अऊर सब तरह को काम की समझ देनो वालो आत्मा हय, परिपूर्ण करय हय, <verse eid="EXO 31:3" /><verse number="4" style="v" sid="EXO 31:4" />जेकोसी ऊ कारीगरी को काम बुद्धि सी निकाल क जिन्ख ऊ सोनो, चांदी, अऊर पीतल को बर्तन पर बनाय सकेंन, <verse eid="EXO 31:4" /><verse number="5" style="v" sid="EXO 31:5" />अऊर जड़न लायी मनि काट सके, अऊर लकड़ी पर नकाशी काम भी कर सकेंन। <verse eid="EXO 31:5" /><verse number="6" style="v" sid="EXO 31:6" />अऊर सुन, मय दान को वंश वालो अहीसामाक को टुरा ओहोलीआब ख ओको संग कर देवय हय; बल्की जितनो बुद्धि मान हय उन सब को दिल म मय बुद्धि देवय हय, जेकोसी जितनो चीजो की आज्ञा मय न तोख दियो हय उन सब ख हि बनाये; <verse eid="EXO 31:6" /><verse number="7" style="v" sid="EXO 31:7" />मतलब मिलाप वालो तम्बू, अऊर साक्षी पत्र को सन्दूक अऊर उच पर को प्रायश्चित वालो ढकन अऊर तम्बू को पूरो सामान, <verse eid="EXO 31:7" /><verse number="8" style="v" sid="EXO 31:8" />अऊर सामान सहित मेज, अऊर पूरो सामान सहित शुद्ध सोनो को दीया, अऊर धूप जलान की वेदी, <verse eid="EXO 31:8" /><verse number="9" style="v" sid="EXO 31:9" />अऊर पूरो सामान सहित होमबलि वेदी, अऊर पाये सहित गंगार, <verse eid="EXO 31:9" /><verse number="10" style="v" sid="EXO 31:10" />अऊर बुन्यो हुयो धागा को कपड़ा, अऊर याजक हारून को याजक वालो काम को पवित्र कपड़ा, अऊर ओको टुरावों को कपड़ा, जिन्ख हि याजक को कार्य करतो समय पहिनेंन, <verse eid="EXO 31:10" /><verse number="11" style="v" sid="EXO 31:11" />अऊर अभिषेक को तेल, अऊर पवित्र जागा लायी सुगन्धित धूप, इन सब ख हि उन सब आज्ञावों को अनुसार बनाये जो मय न तोरो दियो हंय।”<verse eid="EXO 31:11" /></para>
  <para style="s">सब्त मतलब आराम दिन</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 31:12" />फिर परमेश्वर न मूसा सी कह्यो, <verse eid="EXO 31:12" /><verse number="13" style="v" sid="EXO 31:13" />“तय इस्राएलियों लोग सी यो भी कहजो, ‘निश्चय तुम मोरो आराम दिनों ख मनाजो, कहालीकि तुम्हरो पीढ़ी पीढ़ी म मोरो अऊर तुम लोगों को बीच यो एक चिन्ह ठहरो हय, जेकोसी तय यो बात जान रख्यो कि परमेश्वर हमरो पवित्र कर्ता हय। <verse eid="EXO 31:13" /><verse number="14" style="v" sid="EXO 31:14" />यो तरह तय आराम दिन ख मनाजो, कहालीकि ऊ तुम्हरो लायी पवित्र ठहरो हय; जो ओको अपवित्र करेंन ऊ निश्चय मार डाल्यो जाये : जो कोयी उच दिन म कुछ काम काज करेंन ऊ अपनो लोगों को बीच सी निकाल दियो जायेंन। <verse eid="EXO 31:14" /><verse number="15" style="v" sid="EXO 31:15" /><note caller="+" style="x"><char style="xo" closed="false">31:15 </char><char style="xt" closed="false"><ref loc="EXO 20:8-11">निर्गमन २०:८-११</ref>; <ref loc="EXO 23:12">२३:१२</ref>; <ref loc="EXO 34:21">३४:२१</ref>; <ref loc="LEV 23:3">लैव्यव्यवस्था २३:३</ref>; <ref loc="DEU 5:12-14">व्यवस्थाविवरन ५:१२-१४</ref></char></note>छय दिन त काम-काज करयो जाये, पर सातवों दिन परम पवित्र को दिन अऊर परमेश्वर लायी पवित्र हय; येकोलायी जो कोयी आराम को दिन म कुछ काम-काज करेंन ऊ निश्चय मार डाल्यो जाये। <verse eid="EXO 31:15" /><verse number="16" style="v" sid="EXO 31:16" />येकोलायी इस्राएली आराम दिन ख मानो करेंन, बल्की पीढ़ी पीढ़ी म ओको हमेशा की वाचा को बारे जान क मानो करेंन। <verse eid="EXO 31:16" /><verse number="17" style="v" sid="EXO 31:17" /><note caller="+" style="x"><char style="xo" closed="false">31:17 </char><char style="xt" closed="false"><ref loc="EXO 20:11">निर्गमन २०:११</ref></char></note>ऊ मोरो अऊर इस्राएलियों को बीच हमेशा एक चिन्ह रहेंन, कहालीकि छय दिन म परमेश्वर न आसमान अऊर धरती ख बनायो, अऊर सातवों दिन आराम कर क् अपनो जीव ख शान्त करयो’।” <verse eid="EXO 31:17" /><verse number="18" style="v" sid="EXO 31:18" />जब परमेश्वर मूसा सी सीनै पहाड़ी पर असी बात कर चुक्यो, तब ओन ओको अपनी बोट सी लिखी हुयो गवाही चिट्ठी देन वालो गोटा की दोयी पट्टियां दियो।<verse eid="EXO 31:18" /></para>
  <chapter eid="EXO 31" />
  <chapter number="32" style="c" sid="EXO 32" />
  <para style="s">सोनो को बछड़ा</para>
  <para style="r">(<ref loc="DEU 9:6-29">व्यवस्थाविवरन ९:६-२९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 32:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">32:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 7:40">प्रेरितों ७:४०</ref>
      </char>
    </note>जब लोगों न देख्यो कि मूसा ख पहाड़ी सी उतरन म बहुत देर होय रह्यो हय, तब हि हारून को जवर जमा होय क कहन लग्यो, “अब हमरो लायी भगवान बनो, जो हमरो आगु आगु चलेंन; कहालीकि उच आदमी मूसा ख जो हम्ख मिस्र देश सी निकाल ले आयो हय, हम नहीं जानय कि का भयो?” <verse eid="EXO 32:1" /><verse number="2" style="v" sid="EXO 32:2" />हारून न उन्को सी कह्यो, “तुम्हरो पत्नियों अऊर टुरा टुरियों को कानों म सोनो की जो बालियां हंय उन्ख उतारो, अऊर मोरो जवर ले आवो।” <verse eid="EXO 32:2" /><verse number="3" style="v" sid="EXO 32:3" />तब तब लोगों न उन्को कानों सी सोनो की बालियां ख उतारयो, अऊर हारून को जवर ले आये। <verse eid="EXO 32:3" /><verse number="4" style="v" sid="EXO 32:4" /><note caller="+" style="x"><char style="xo" closed="false">32:4 </char><char style="xt" closed="false"><ref loc="1KI 12:28">१ राजा १२:२८</ref>; <ref loc="ACT 7:41">प्रेरितों ७:४१</ref></char></note>हारून न उन्को हाथ सी लियो, अऊर एक बछड़ा की मूर्ति ढाल क बनायो, ओन ओको साचा म ढाल्यो। तब लोग कहन लग्यो, “हे इस्राएल समाज, यो हय तोरो ईश्वर जो तोख मिस्र देश सी निकाल लायो हय, ऊ योच आय।” <verse eid="EXO 32:4" /><verse number="5" style="v" sid="EXO 32:5" />यो देख क् हारून न ओको आगु एक वेदी बनायी; अऊर या प्रचार करयो, “कल परमेश्वर लायी त्यौहार होयेंन।” <verse eid="EXO 32:5" /><verse number="6" style="v" sid="EXO 32:6" /><note caller="+" style="x"><char style="xo" closed="false">32:6 </char><char style="xt" closed="false"><ref loc="1CO 10:7">१ कुरिन्थियों १०:७</ref></char></note>अऊर दूसरो दिन लोगों न सुबेरे ख उठ क होमबलि चढ़ाये, अऊर मेलबलि ले आये; तब बैठ क खाये पीये, अऊर उठ क मौज मस्ती करन लग्यो।<verse eid="EXO 32:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 32:7" />तब परमेश्वर न मूसा सी कह्यो, “नीचो उतर जा, कहालीकि तोरी प्रजा को लोग, जिन्ख तय मिस्र देश सी निकाल लायो हय, हि भ्रष्ट होय गयो हंय; <verse eid="EXO 32:7" /><verse number="8" style="v" sid="EXO 32:8" />अऊर जेको रस्ता पर चलन की आज्ञा मय न उन्को दियो होती ओको तुरतच छोड़ क उन्न एक बछड़ा की मूर्ती बनाय लियो, तब ओख दण्डवत करयो, अऊर ओको लायी बलिदान भी चढ़ायो, अऊर यो कह्यो, ‘हे इस्राएलियों समाज, तुम्हरो ईश्वर जो तुम्ख मिस्र देश सी छुड़ाय ले आयो हय ऊ योच आय’।” <verse eid="EXO 32:8" /><verse number="9" style="v" sid="EXO 32:9" />तब परमेश्वर न मूसा सी कह्यो, “मय न इन लोगों ख देख्यो हय, अऊर सुन, हि हठीलो हंय। <verse eid="EXO 32:9" /><verse number="10" style="v" sid="EXO 32:10" />अब मोख मत रोख, मोरो कोप उन पर भड़क उठ्यो हय जेकोसी मय उन्ख भस्म करूं; पर तोरो सी एक बड़ो राष्ट्र बनाऊं।”<verse eid="EXO 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EXO 32:11" />तब मूसा अपनो परमेश्वर यहोवा ख यो कह्य क् बिनती करन लग्यो, “हे परमेश्वर, तोरो कोप अपनी प्रजा पर कहाली भड़क्यो हय जेख तय बड़ी सामर्थ अऊर बलवन्त हाथ को द्वारा मिस्र देश सी निकाल लायो हय? <verse eid="EXO 32:11" /><verse number="12" style="v" sid="EXO 32:12" />मिस्र देश को लोग यो कहाली कहनो पाये, ‘ऊ उन्को बुरो अभिप्राय सी मतलब पहाड़ी म घात कर क् जमीन पर सी मिटाय डालन की मनसा सी निकाल ले गयो?’ तय भड़क्यो हुयो गुस्सा ख शान्त कर, अऊर अपनो लोगों की हानि को बिचार ख छोड़ दे। <verse eid="EXO 32:12" /><verse number="13" style="v" sid="EXO 32:13" /><note caller="+" style="x"><char style="xo" closed="false">32:13 </char><char style="xt" closed="false"><ref loc="GEN 22:16">उत्पत्ति २२:१६</ref>,<ref loc="GEN 22:17">१७</ref>; <ref loc="GEN 17:8">१७:८</ref></char></note>अपनो सेवक अब्राहम, इसहाक, अऊर याकूब ख याद कर जिन्कोसी तय न अपनीच कसम खाय क कह्यो होतो, ‘मय तुम्हरो वंश ख आसमान को तारा को समान बहुत करूं, अऊर यो पूरो देश जिन्की मय न बात की हय तुम्हरो वंश ख देऊं कि हि ओको अधिकारी हमेशा बन्यो रहेंन’।” <verse eid="EXO 32:13" /><verse number="14" style="v" sid="EXO 32:14" />तब अपनो लोगों की जो हानि परमेश्वर करन वालो होतो ओको बिचार ओन छोड़ दियो।<verse eid="EXO 32:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 32:15" />तब मूसा मुड क साक्षी की दोयी तक्तां ख हाथ म लियो हुयो पहाड़ी सी उतर गयो। उन तक्तां को इत अऊर उत दोयी तरफ लिख्यो हुयो होतो, <verse eid="EXO 32:15" /><verse number="16" style="v" sid="EXO 32:16" />अऊर हि पट्टियां परमेश्वर कि बनायी हुयी होती, अऊर उन पर जो खोद क लिख्यो हुयो होतो ऊ परमेश्वर को लिख्यो हुयो होतो।<verse eid="EXO 32:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 32:17" />जब यहोशू ख लोगों क् शोर को आवाज सुनायी पड़्यो, तब ओन मूसा सी कह्यो, “छावनी म युद्ध को आवाज सुनायी दे रह्यो हय।” <verse eid="EXO 32:17" /><verse number="18" style="v" sid="EXO 32:18" />मूसा न कह्यो, “यो जो आवाज हय ऊ नहीं त जितन वालो को आय, अऊर नहीं हारन वालो को आय; मोख त गीत को आवाज सुनायी पड़य हय।” <verse eid="EXO 32:18" /><verse number="19" style="v" sid="EXO 32:19" />छावनी को जवर आतोच मूसा ख ऊ बछड़ा अऊर नाचनो दिखायी पड़्यो, तब मूसा को गुस्सा भड़क उठ्यो, अऊर ओन पट्टियों ख अपनो हाथ सी पहाड़ी को खल्लो पटक क तुकड़ा तुकड़ा कर दियो। <verse eid="EXO 32:19" /><verse number="20" style="v" sid="EXO 32:20" />तब ओन उन्को बनाये हुयो बछड़ा ख ले कर आगी म डाल क् जलाय दियो। अऊर पीस क चूर चूर क डाल्यो हय, अऊर पानी म डाल दियो, अऊर इस्राएली लोग ख पिलायो।<verse eid="EXO 32:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 32:21" />तब मूसा हारून सी कहन लग्यो, “इन लोगों न तोरो संग का करयो कि तय न उन्ख इतनो बड़ो घोर पाप म फसायो?” <verse eid="EXO 32:21" /><verse number="22" style="v" sid="EXO 32:22" />हारून न उत्तर दियो, “हे स्वामी तोरो गुस्सा नहीं भड़के; तय त इन लोगों ख जानयच हय कि हि बुरायी म मन लगाये रह्य हंय।” <verse eid="EXO 32:22" /><verse number="23" style="v" sid="EXO 32:23" /><note caller="+" style="x"><char style="xo" closed="false">32:23 </char><char style="xt" closed="false"><ref loc="ACT 7:40">प्रेरितों ७:४०</ref></char></note>अऊर उन्न मोरो सी कह्यो, हमरो लायी देवता बनाव जो हमरो आगु आगु चले; कहालीकि ऊ आदमी मूसा ख, जो हम्ख मिस्र देश सी छुड़ाय लायो हय, हम नहीं जानजे कि का भयो? <verse eid="EXO 32:23" /><verse number="24" style="v" sid="EXO 32:24" />तब मय न उन्को सी कह्यो, “जेको जेको जवर सोनो को जेवर होना, हि उन ख उतार लाये; अऊर जब उन्न मोरो ख ऊ दियो, मय न उन्ख आगी म डाल दियो, तब यो बछड़ा बन गयो।”<verse eid="EXO 32:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 32:25" />जब मूसा देख्यो कि लोग हारून न लोगों ख नियंत्रन सी बाहेर कर दियो अऊर अपनो दुश्मनों को आगु खुद ख हसी मजाक को पात्र बन गयो। <verse eid="EXO 32:25" /><verse number="26" style="v" sid="EXO 32:26" />उन्ख अनियंत्रित देख क मूसा न छावनी की फाटक पर खड़ो होय क कह्यो, “जो कोयी परमेश्वर को तरफ को हय ऊ मोरो जवर आये;” तब पूरो लेवीय वंश को ओको जवर जमा भय गयो। <verse eid="EXO 32:26" /><verse number="27" style="v" sid="EXO 32:27" />मूसा न उन्को सी कह्यो, “इस्राएल को परमेश्वर यहोवा यो कह्य हय कि अपनी अपनी कमर म तलवार बान्ध क छावनी को एक तम्बू सी दूसरो तम्बू पर जाय क भाऊवों, संगियों, अऊर पड़ोसियों ख मार डालो।” <verse eid="EXO 32:27" /><verse number="28" style="v" sid="EXO 32:28" />मूसा को या वचन को अनुसार लेवियों न करयो; अऊर ऊ दिन तीन हजार को लगभग लोग मारयो गयो। <verse eid="EXO 32:28" /><verse number="29" style="v" sid="EXO 32:29" />तब मूसा न कह्यो, “अज को दिन परमेश्वर लायी अपनो याजक पद को अभिषेक करो, बल्की अपनो अपनो टुरावों अऊर भाऊवों को खिलाफ होय क असो करयो जेको सी ऊ अज तुम्ख आशीष दे।”<verse eid="EXO 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 32:30" />दूसरो दिन मूसा न लोगों सी कह्यो, “तय न बड़ोच पाप करयो हय। अब मय परमेश्वर को जवर ऊपर जाऊं; सम्भव हय कि मय तुम्हरो पाप को प्रायश्चित कर सकू।” <verse eid="EXO 32:30" /><verse number="31" style="v" sid="EXO 32:31" />तब मूसा परमेश्वर को जवर जाय क कहन लग्यो, “हाय, हाय, उन लोगों न सोनो को देवता बनाय क बड़ोच घोर पाप करयो हय। <verse eid="EXO 32:31" /><verse number="32" style="v" sid="EXO 32:32" /><note caller="+" style="x"><char style="xo" closed="false">32:32 </char><char style="xt" closed="false"><ref loc="PSA 69:28">भजन ६९:२८</ref>; <ref loc="REV 3:5">प्रकाशितवाक्य ३:५</ref></char></note>अब तय उन्को पाप माफ कर नहीं त अपनी लिख्यो हुयी किताब म सी मोरो नाम ख काट दे।” <verse eid="EXO 32:32" /><verse number="33" style="v" sid="EXO 32:33" />परमेश्वर न मूसा सी कह्यो, “जिन्कोसी मोरो खिलाफ पाप करयो हय उच नाम को मय अपनी किताब म सी काट देऊं। <verse eid="EXO 32:33" /><verse number="34" style="v" sid="EXO 32:34" />अब तुम जाय क उन लोगों ख ऊ जागा म ले चल जेकी चर्चा मय न तोरो सी करी होती; देख, मोरो स्वर्गदूत तोरो आगु आगु चलेंन। पर जो दिन मय सजा देन लगूं ऊ दिन उन्ख यो पाप को भी सजा देऊं।”<verse eid="EXO 32:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 32:35" />परमेश्वर न उन लोगों पर विपत्ति डाली, कहालीकि हारून को बनायो हुयो बछड़ा ख उन्नच बनायो होतो।<verse eid="EXO 32:35" /></para>
  <chapter eid="EXO 32" />
  <chapter number="33" style="c" sid="EXO 33" />
  <para style="s">सीनै पहाड़ी सी जान की आज्ञा</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 33:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३३:१ </char>
      <char style="xt" closed="false">
        <ref loc="GEN 12:7">उत्पत्ति १२:७</ref>; <ref loc="GEN 26:3">२६:३</ref>; <ref loc="GEN 28:13">२८:१३</ref></char>
    </note>तब परमेश्वर न मूसा सी कह्यो, “तय उन लोगों ख जिन्ख मिस्र देश सी छुड़ाय क लायो हय संग ले क ऊ देश ख जा, जेको बारे मय न अब्राहम, इसहाक, अऊर याकूब सी कसम खाय क कह्यो होतो कि मय ओख तोरो वंश ख देऊं। <verse eid="EXO 33:1" /><verse number="2" style="v" sid="EXO 33:2" />अऊर मय तोरो आगु आगु एक दूत ख भेजूं, अऊर कनानी, एमोरी, हित्ती, परिज्जी, हिब्बी अऊर यबूसी ख निकाल देऊं। <verse eid="EXO 33:2" /><verse number="3" style="v" sid="EXO 33:3" />तुम लोग ऊ देश ख जावो जेको म दूध अऊर शहेद की धारा बहय हय; पर तुम जिद्दी हो, यो वजह मय तुम्हरो बीच म होय क नहीं चलूं, असो नहीं हो कि मय रस्ता म तुम्हरो अन्त कर डालूं।”<verse eid="EXO 33:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 33:4" />यो बुरो समाचार सुन क हि लोग विलाप करन लगे; अऊर कोयी अपनो जेवर पहिने हुयो नहीं रह्यो। <verse eid="EXO 33:4" /><verse number="5" style="v" sid="EXO 33:5" />कहालीकि परमेश्वर न मूसा सी कह्यो दियो होतो, “इस्राएली लोगों ख मोरो यो वचन सुना, ‘तुम लोग त जिद्दी हय; यदि मय पल भर लायी तुम्हरो बीच होय क चलू, त तुम्हरो अन्त कर डालूं। येकोलायी अब अपनो अपनो जेवर अपनो आंग सी उतार देवो कि मय जान सकू कि तुम्हरो संग का करनो चाहिये’।” <verse eid="EXO 33:5" /><verse number="6" style="v" sid="EXO 33:6" />येकोलायी इस्राएली <note caller="+" style="f"><char style="fr" closed="false">३३:६ </char><char style="ft" closed="false">होरेब </char></note>होरेब पहाड़ी सी ले क आगु तक अपनो जेवर उतारयो रह्यो।<verse eid="EXO 33:6" /></para>
  <para style="s">परमेश्वर को उपस्थिति को तम्बू</para>
  <para style="p">
    <verse number="7" style="v" sid="EXO 33:7" />मूसा तम्बू ख डेरा सी बाहेर, ओको सी कुछ दूरी पर खड़ो करत होतो। ऊ ओख मिलाप वालो तम्बू कहत होतो। प्रभु को खोजी मिलाप वालो तम्बू ख जो डेरा को बाहेर होतो, जात होतो। <verse eid="EXO 33:7" /><verse number="8" style="v" sid="EXO 33:8" />जब जब मूसा तम्बू को जवर जावय हय, तब तब सब लोग उठ क अपनो अपनो डेरा को फाटक पर खड़ो होय जावय, अऊर जब तक मूसा ऊ तम्बू म सिरत नहीं होतो तब तक ओकी तरफ ताकतो रहत होतो। <verse eid="EXO 33:8" /><verse number="9" style="v" sid="EXO 33:9" />जब मूसा ऊ तम्बू म सिरयो करत होतो, जब बादर को खम्बा उतर क तम्बू को फाटक पर ठहर जावय होतो, अऊर परमेश्वर मूसा सी बाते करत होतो। <verse eid="EXO 33:9" /><verse number="10" style="v" sid="EXO 33:10" />अऊर सब लोग जब बादर को खम्बा ख तम्बू को फाटक पर खड़ो देखतो होतो, तब उठ क अपनो अपनो डेरा को फाटक पर सी दण्डवत करत होतो। <verse eid="EXO 33:10" /><verse number="11" style="v" sid="EXO 33:11" />अऊर परमेश्वर मूसा सी यो तरह आमने-सामने बाते करत होतो, जेको तरह कोयी अपनो भाऊ बहिन सी बाते करो। अऊर मूसा त डेरा म लौट आवत होतो, पर यहोशू नाम को एक जवान, जो नून को टुरा अऊर मूसा को सेवक होतो, ऊ तम्बू म सी नहीं निकलत होतो।<verse eid="EXO 33:11" /></para>
  <para style="s">परमेश्वर को अपनो लोगों सी प्रतिज्ञा</para>
  <para style="p">
    <verse number="12" style="v" sid="EXO 33:12" />मूसा न परमेश्वर सी कह्यो, “देख, तय मोरो सी कह्य हय, इन लोगों ख ले जा; पर तय न मोख नहीं बतायो कि तय मोरो संग कौन ख भेजजो। तय न कह्यो, मय तोख नाम सी जानु हय। अऊर तोरो पर मोरी अनुग्रह की नजर हय। <verse eid="EXO 33:12" /><verse number="13" style="v" sid="EXO 33:13" />अऊर अब यदि मोरो पर तोरो अनुग्रह की नजर होना, त मोख अपनो मार्ग समझाय दे, जेकोसी जब मय तोरो ज्ञान पाऊं तब तोरो अनुग्रह की नजर मोरो पर बनी रहेंन। फिर यो भी ध्यान रख कि या लोग तोरी प्रजा आय।”<verse eid="EXO 33:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 33:14" />परमेश्वर न कह्यो, “मय खुद तोरो संग चलूं अऊर तोरो ख आराम देऊं।”<verse eid="EXO 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EXO 33:15" />मूसा न ओको सी कह्यो, “यदि तय खुद नहीं चलजो, त हम्ख यहां सी आगु मत ले जा। <verse eid="EXO 33:15" /><verse number="16" style="v" sid="EXO 33:16" />यो कसो जान्यो जायेंन कि तोरी अनुग्रह की नजर मोरो पर अऊर अपनी प्रजा पर हय? का येकोसी नहीं कि तय हमरो संग संग चले, जेकोसी मय अऊर तोरी प्रजा को लोग धरती पर को सब लोगों सी अलग ठहरेंन?”<verse eid="EXO 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 33:17" />परमेश्वर न मूसा सी कह्यो, “मय यो काम भी, जेकी चर्चा तय न करी हय, मय करूं; कहालीकि मोरो अनुग्रह की नजर तोरो पर हय, अऊर तोरो नाम मोरो मन म बस्यो हय।”<verse eid="EXO 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 33:18" />मूसा न कह्यो, “मोख अपनो महिमा को तेज दिखाय दे।”<verse eid="EXO 33:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EXO 33:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३३:१९ </char>
      <char style="xt" closed="false">
        <ref loc="ROM 9:15">रोमियों ९:१५</ref>
      </char>
    </note>ओन कह्यो, “मय तोरो जवर होय क चलतो हुयो तोख अपनी पूरी भलायी दिखाऊं, अऊर तोरो जवर परमेश्वर को नाम को प्रचार करूं; अऊर जेको पर मय अनुग्रह करनो चाहूं ओकोच पर दया करूं।” <verse eid="EXO 33:19" /><verse number="20" style="v" sid="EXO 33:20" />तब ओन कह्यो, “तय मोरो मुख को दर्शन नहीं कर सकय; कहालीकि आदमी मोरो मुख को दर्शन कर क् जीन्दो नहीं रह्य सकय।” <verse eid="EXO 33:20" /><verse number="21" style="v" sid="EXO 33:21" />तब परमेश्वर न कह्यो, “सुन, मोरो जवर एक जागा हय, यहां तय ऊ चट्टान पर खड़ो हो; <verse eid="EXO 33:21" /><verse number="22" style="v" sid="EXO 33:22" />अऊर जब तक मोरी महिमा को तेज तोरो आगु चलतो रहेंन, तब तक मय तोख चट्टान की फट म रखूं अऊर जब तक मय तोरो आगु सी होय क नहीं निकल जाऊं तब तक अपनो हाथ सी तोख झाक्यो रहूं; <verse eid="EXO 33:22" /><verse number="23" style="v" sid="EXO 33:23" />फिर मय अपनो हाथ उठाय लेऊं, तब तय मोरी पीठ ख देखजो; पर मोरो मुख नहीं दिखायी देयेंन।”<verse eid="EXO 33:23" /></para>
  <chapter eid="EXO 33" />
  <chapter number="34" style="c" sid="EXO 34" />
  <para style="s">गोटा की दोय नयी पट्टियां</para>
  <para style="r">(<ref loc="DEU 10:1-5">व्यवस्थाविवरन १०:१-५</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 34:1" />फिर परमेश्वर न मूसा सी कह्यो, “पहिली पट्टियों को जसो गोटा की दोय अऊर पट्टियों खोद ख ले; तब जो वचन उन पहिली पट्टियों पर लिख्यो होतो, जिन्ख तय न तोड़ डाल्यो, हिच वचन मय उन पट्टियों पर भी लिखूं। <verse eid="EXO 34:1" /><verse number="2" style="v" sid="EXO 34:2" />सुबेरे तैयार रहजो, अऊर सुबेरे ख सीनै पहाड़ी पर चढ़ क ओकी सेंडी पर मोरो आगु खड़ो होनो। <verse eid="EXO 34:2" /><verse number="3" style="v" sid="EXO 34:3" />तोरो संग कोयी नहीं चढ़ पाये, बल्की पहाड़ी भर कोयी आदमी कहीं दिखायी नहीं दे; अऊर नहीं शेरी मेंढी अऊर गाय बईल भी पहाड़ी को आगु चरन पायेंन।” <verse eid="EXO 34:3" /><verse number="4" style="v" sid="EXO 34:4" />तब मूसा न पहली पट्टियों को समान दोय अऊर पट्टियों खोदी; अऊर सुबेरे उठ क अपनो हाथ म गोटा की हि दोयी पट्टियों ले क परमेश्वर की आज्ञा को अनुसार सीनै पहाड़ी पर चढ़ गयो। <verse eid="EXO 34:4" /><verse number="5" style="v" sid="EXO 34:5" />तब परमेश्वर न बादर म उतर क ओको संग उत खड़ो होय क परमेश्वर न अपनो नाम को बल्की यहोवा को नाम को प्रचार करयो। <verse eid="EXO 34:5" /><verse number="6" style="v" sid="EXO 34:6" />परमेश्वर ओको आगु सी निकल्यो अऊर ओन प्रचार करयो, “परमेश्वर! परमेश्वर! ऊ दयालु अऊर अनुग्रहकारी, विलम्ब-क्रोधी, अऊर धीरजवन्त, सच्चो परमेश्वर हय। <verse eid="EXO 34:6" /><verse number="7" style="v" sid="EXO 34:7" />हजारों पीढ़ियों पर करुना करन वालो, अधर्म, अपराध अऊर पाप ख माफ करन वालो हय, पर ऊ दोषी ख कोयी तरह निर्दोष नहीं ठहरायेंन; ऊ पूर्वजों को अधर्म की सजा तीसरी अऊर चौथी पीढ़ी तक सन्तान अऊर आवन वाली सन्तान ख देतो रहू हय।”<verse eid="EXO 34:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 34:8" />तब मूसा न तुरतच धरती को तरफ झुक क प्रभु ख दण्डवत करयो। <verse eid="EXO 34:8" /><verse number="9" style="v" sid="EXO 34:9" />अऊर मूसा न कह्यो, “हे स्वामी, यदि मय न तोरी अनुग्रह की नजर हासिल करी हय, त मय बिनती करू हय, स्वामी, यदि हठीलो लोग हय, त भी तय हमरो बीच म होय क चल। हमरो अधर्म ख, हमरो पाप ख माफ कर अऊर हम्ख अपनी निज सम्पत्ति बनाव।”<verse eid="EXO 34:9" /></para>
  <para style="s">वाचा को दोहरायो जानो</para>
  <para style="r">(<ref loc="EXO 23:14-19">निर्गमन २३:१४-१९</ref>; <ref loc="DEU 7:1-5">व्यवस्थाविवरन ७:१-५</ref>; <ref loc="DEU 16:1-17">१६:१-१७</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 34:10" />ओन कह्यो, “देख, मय एक वाचा बान्धू हय। मय तोरो सब लोगों को आगु मय असो आश्चर्यपूर्ण कर्म करूं, जो पूरी धरती पर, पूरो राष्ट्रों म कभी नहीं करयो गयो। जिन लोगों को बीच म तय हय, हि सब परमेश्वर को कार्य ख देखेंन; ऊ आतंकमय कार्य हय, जेख मय तोरो लायी करूं। <verse eid="EXO 34:10" /><verse number="11" style="v" sid="EXO 34:11" />जो आज्ञा मय तुम्ख देऊ हय, ओको पालन करजो। देख, मय तोरो आगु सी एमोरी, कनानी, हित्ती, परिज्जी, हिव्वी, अऊर यबूसी जातियों ख निकाल देऊं। <verse eid="EXO 34:11" /><verse number="12" style="v" sid="EXO 34:12" />येकोलायी सावधान रहजो कि जो देश म तय जान वालो हय ओको निवासियों सी वाचा मत बान्धजो; कहीं असो नहीं होय कि ऊ तोरो लायी फन्दा बन जाये। <verse eid="EXO 34:12" /><verse number="13" style="v" sid="EXO 34:13" />बल्की उन्की वेदियों ख गिराय देजो, उन्की खम्भा ख तोड़ डालजो, अऊर उन्की अशेरा नाम की मूर्तियों ख तोड़ डालजो; <verse eid="EXO 34:13" /><verse number="14" style="v" sid="EXO 34:14" />कहालीकि तुम्ख कोयी दूसरो ख ईश्वर कर क् दण्डवत करन की आज्ञा नहाय, कहालीकि परमेश्वर जिन्को नाम जलनशील हय, जर क उठन वालो परमेश्वर आय, <verse eid="EXO 34:14" /><verse number="15" style="v" sid="EXO 34:15" />असो न होय कि तय ऊ देश को निवासियों सी बातचीत करे। असो नहीं हो कि जब हि अपनो देवतावों को व्यभिचार करेंन, अऊर वेश्या को जसो बर्ताव करेंन, अपनो देवतावों ख बलि चढ़ाये अऊर कोयी तोख नेवता देवय तब तय ओकी बली को मांस खाये। <verse eid="EXO 34:15" /><verse number="16" style="v" sid="EXO 34:16" />अऊर तय उन्की टुरियों ख अपनो टुरावों लायी लाये, जो मोरो टुरा को प्रति विश्वासघात होयेंन अऊर उन्को मूर्ती पूजक देवतावों की पूजा करन लायी प्रेरित करेंन।<verse eid="EXO 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 34:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">34:17 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 20:4">निर्गमन २०:४</ref>; <ref loc="LEV 19:4">लैव्यव्यवस्था १९:४</ref>; <ref loc="DEU 5:8">व्यवस्थाविवरन ५:८</ref>; <ref loc="DEU 27:15">२७:१५</ref></char>
    </note>“तय देवतावों की मूर्तियां ढाल क मत बनायजो।<verse eid="EXO 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EXO 34:18" />“अखमीरी रोटी को त्यौहार मनाजो। ओको म मोरी आज्ञा को अनुसार आबीब को महीना को उचित समय पर सात दिन तक अखमीरी रोटी खायो करजो; कहालीकि तय मिस्र देश सी आबीब को महीने म निकल क आयो।<note caller="+" style="x"><char style="xo" closed="false">34:18 </char><char style="xt" closed="false"><ref loc="EXO 12:14-20">निर्गमन १२:१४-२०</ref>; <ref loc="LEV 23:6-8">लैव्यव्यवस्था २३:६-८</ref>; <ref loc="NUM 28:16-25">गिनती २८:१६-२५</ref></char></note>” <verse eid="EXO 34:18" /><verse number="19" style="v" sid="EXO 34:19" /><note caller="+" style="x"><char style="xo" closed="false">34:19 </char><char style="xt" closed="false"><ref loc="EXO 13:2">निर्गमन १३:२</ref></char></note>हर एक पहिलौठा मोरो आय; अऊर का बछड़ा, का मेम्ना, तोरो जनावरों म सी जो नर पहिलौठा होना हि सब मोरोच आय। <verse eid="EXO 34:19" /><verse number="20" style="v" sid="EXO 34:20" />गधी को पहिलौठा को बदला मेम्ना दे क ओख छुड़ायजो, यदि तय ओख छुड़ावनो नहीं चाहवय त ओकी गर्दन तोड़ देजो। पर अपनो सब पहिलौठा टुरावों ख बदला दे क छुड़ायजो। मोख कोयी खाली हाथ अपनो मुंह मत दिखाये।<verse eid="EXO 34:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 34:21" />“छय दिन त मेहनत करजो, पर सातवों दिन आराम करजो; बल्की नांगर जोतन अऊर फसल काटतो समय म भी आराम करजो।<note caller="+" style="x"><char style="xo" closed="false">34:21 </char><char style="xt" closed="false"><ref loc="LEV 23:3">लैव्यव्यवस्था २३:३</ref>; <ref loc="DEU 5:13">व्यवस्थाविवरन ५:१३</ref>,<ref loc="DEU 5:14">१४</ref></char></note> <verse eid="EXO 34:21" /><verse number="22" style="v" sid="EXO 34:22" />अऊर हप्ता को त्यौहार मनायजो जो पहिली गहूं की फसल को त्यौहार कहलावय हय, अऊर साल को आखरी म जमा करन को भी त्यौहार मनायजो।<note caller="+" style="x"><char style="xo" closed="false">34:22 </char><char style="xt" closed="false"><ref loc="LEV 23:15-21">लैव्यव्यवस्था २३:१५-२१</ref>,<ref loc="LEV 23:39-43">३९-४३</ref>; <ref loc="NUM 28:26-31">गिनती २८:२६-३१</ref></char></note> <verse eid="EXO 34:22" /><verse number="23" style="v" sid="EXO 34:23" />साल म तीन बार तोरो सब आदमी इस्राएल को परमेश्वर प्रभु यहोवा ख अपनो मुंह दिखाये। <verse eid="EXO 34:23" /><verse number="24" style="v" sid="EXO 34:24" />कहालीकि मय दूसरो राष्ट्रों ख तोरो आगु सी निकाल क तोरी सीमावों ख बढ़ाऊं; अऊर जब तय अपनो परमेश्वर यहोवा ख अपनो मुंह दिखावन लायी साल म तीन बार आयो करजो, तब कोयी तोरी जमीन को लालच नहीं करेंन।<verse eid="EXO 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 34:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">34:25 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:10">निर्गमन १२:१०</ref>; <ref loc="EXO 23:18">२३:१८</ref>; <ref loc="LEV 2:11">लैव्यव्यवस्था २:११</ref></char>
    </note>“मोरो बलिदान को खून ख खमीर सहित मत चढ़ायजो, अऊर नहीं फसह को त्यौहार को बलिदान म सी कुछ सुबेरे तक रहन देजो। <verse eid="EXO 34:25" /><verse number="26" style="v" sid="EXO 34:26" /><note caller="+" style="x"><char style="xo" closed="false">34:26 </char><char style="xt" closed="false"><ref loc="EXO 23:19">निर्गमन २३:१९</ref>; <ref loc="DEU 24:21">व्यवस्थाविवरन २४:२१</ref>; <ref loc="DEU 26:2">२६:२</ref></char></note>अपनी जमीन की पहिली फसल को पहिलो हिस्सा अपनो परमेश्वर यहोवा को भवन म ले आजो। शेरी को बच्चा ख ओकी माय को दूध म मत पकायजो।” <verse eid="EXO 34:26" /><verse number="27" style="v" sid="EXO 34:27" />तब परमेश्वर न मूसा सी कह्यो, “यो वचन लिख ले; कहालीकि योच वचनों को अनुसार मय न तोरो अऊर इस्राएल को संग वाचा बान्धी हय।” <verse eid="EXO 34:27" /><verse number="28" style="v" sid="EXO 34:28" />मूसा वहां परमेश्वर को संग चालीस दिन अऊर रात; अऊर तब तक नहीं त ओन रोटी खायी अऊर नहीं पानी पीयो। अऊर ओन उन पट्टियों पर वाचा को वचन मतलब दस आज्ञाये लिख दियो।<verse eid="EXO 34:28" /></para>
  <para style="s">मूसा को पहाड़ी सी उतरनो</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 34:29" />जब मूसा गवाही की दोयी पट्टियां हाथ म लियो हुयो सीनै पहाड़ी सी उतर रह्यो होतो तब परमेश्वर को संग बाते करन को वजह ओको चेहरा चमकत होतो, पर ऊ यो नहीं जानत होतो कि ओको चेहरा चमक रह्यो हंय। <verse eid="EXO 34:29" /><verse number="30" style="v" sid="EXO 34:30" />जब हारून अऊर सब इस्राएली लोगों न मूसा ख देख्यो कि ओको चेहरा चमक रह्यो होतो, तब हि ओको जवर जान सी डर गयो। <verse eid="EXO 34:30" /><verse number="31" style="v" sid="EXO 34:31" />तब मूसा न उन्ख बुलायो; अऊर हारून मण्डली को पूरो मुखियावों सहित ओको जवर आयो, अऊर मूसा उन्को सी बाते करन लग्यो। <verse eid="EXO 34:31" /><verse number="32" style="v" sid="EXO 34:32" />येको बाद सब इस्राएली लोग जवर आयो, अऊर जितनी आज्ञाये परमेश्वर न सीनै पहाड़ी पर ओको संग बात करतो समय दी होती, हि सब ओन उन्ख बतायी। <verse eid="EXO 34:32" /><verse number="33" style="v" sid="EXO 34:33" />जब तक मूसा उन्को सी बात नहीं कर चुक्यो तब तक अपनो मुंह पर गमछा झाक्यो रह्यो; <verse eid="EXO 34:33" /><verse number="34" style="v" sid="EXO 34:34" />पर जब जब मूसा अन्दर परमेश्वर सी बात करन ख ओको आगु जात होतो, तब तब ऊ ऊ गमछा ख उतारयो हुयो रहत होतो; फिर बाहेर आय क जो जो आज्ञा ओख मिलत होती ओख इस्राएलियों ख कह्य देत होतो। <verse eid="EXO 34:34" /><verse number="35" style="v" sid="EXO 34:35" /><note caller="+" style="x"><char style="xo" closed="false">34:35 </char><char style="xt" closed="false"><ref loc="2CO 3:7-16">२ कुरिन्थियों ३:७-१६</ref></char></note>इस्राएली लोग मूसा को चेहरा देखत होतो कि ओको सी चमक निकलत होती; अऊर जब तक ऊ परमेश्वर सी बात करन ख अन्दर नहीं जात होतो तब तक ऊ ऊ गमछा ख डाल्यो रहत होतो।<verse eid="EXO 34:35" /></para>
  <chapter eid="EXO 34" />
  <chapter number="35" style="c" sid="EXO 35" />
  <para style="s">आराम दिन को नियम</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 35:1" />मूसा न इस्राएलियों की पूरी मण्डली ख जमा कर क् उन्को सी कह्यो, “जिन कामों ख करन की आज्ञा परमेश्वर न दियो हय हि या हंय। <verse eid="EXO 35:1" /><verse number="2" style="v" sid="EXO 35:2" />छय दिन त काम-काज करयो जाये, पर सातवों दिन तुम्हरो लायी पवित्र अऊर परमेश्वर लायी परम आराम को दिन ठहरे; ओको म जो कोयी काम काज करेंन ऊ मार डाल्यो जाये; <verse eid="EXO 35:2" /><verse number="3" style="v" sid="EXO 35:3" />बल्की आराम को दिन तुम अपनो अपनो घरों म आगी तक मत जलाजो।”<verse eid="EXO 35:3" /></para>
  <para style="s">पवित्र तम्बू लायी भेंट</para>
  <para style="r">(<ref loc="EXO 25:1-9">निर्गमन २५:१-९</ref>)</para>
  <para style="p">
    <verse number="4" style="v" sid="EXO 35:4" />फिर मूसा न इस्राएलियों की सारी मण्डली सी कह्यो, “जो बात की आज्ञा परमेश्वर न दी हय वा या आय। <verse eid="EXO 35:4" /><verse number="5" style="v" sid="EXO 35:5" />तुम्हरो जवर सी परमेश्वर लायी भेंट लियो जाये, मतलब जितनो अपनी इच्छा सी देजो चाहेंन हि परमेश्वर की भेंट कर क् या चिजे ले आये; मतलब सोनो, चांदी, पीतल; <verse eid="EXO 35:5" /><verse number="6" style="v" sid="EXO 35:6" />नीलो, जामुनी अऊर लाल रंग को कपड़ा, पतलो सूत सी बुन्यो हुयो कपड़ा;‍ शेरी को बाल, <verse eid="EXO 35:6" /><verse number="7" style="v" sid="EXO 35:7" />लाल रंग सी रंगी हुयी मेंढा की खाल, सुइसों की खाल; बबूल की लकड़ी, <verse eid="EXO 35:7" /><verse number="8" style="v" sid="EXO 35:8" />उजाड़ो देन लायी तेल, अभिषेक को तेल अऊर धूप लायी सुगन्धित मसाले, <verse eid="EXO 35:8" /><verse number="9" style="v" sid="EXO 35:9" />तब एपोद अऊर चपरास लायी सुलैमानी गोटा अऊर जड़न लायी मनि।<verse eid="EXO 35:9" /></para>
  <para style="s">निवास जागा की विभिन्न चिजों</para>
  <para style="r">(<ref loc="EXO 39:32-43">निर्गमन ३९:३२-४३</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 35:10" />“जो बुद्धिमान कारागिर व्यक्ति तुम्हरो बीच म हंय, हि आये अऊर प्रभु की आज्ञा अनुसार या चिजें बनाये, रहन की जागा। <verse eid="EXO 35:10" /><verse number="11" style="v" sid="EXO 35:11" />यानेकि तम्बू, अऊर झाकन समेत निवास, अऊर ओकी आकड़ा, छड़, बेंड़ा, खम्बा अऊर तक्ता; <verse eid="EXO 35:11" /><verse number="12" style="v" sid="EXO 35:12" />तब डन्डो सहित सन्दूक, अऊर प्रायश्चित को ढक्कन, अऊर बीच वालो परदा; <verse eid="EXO 35:12" /><verse number="13" style="v" sid="EXO 35:13" />डन्डो अऊर सब सामान समेत मेज, अऊर भेंट की रोटियां; <verse eid="EXO 35:13" /><verse number="14" style="v" sid="EXO 35:14" />सामान अऊर दीपकों समेत उजाड़ो देन वालो दीया, अऊर उजाड़ो देन लायी तेल; <verse eid="EXO 35:14" /><verse number="15" style="v" sid="EXO 35:15" />डन्डों समेत धूपवेदी, अभिषेक को तेल, सुगन्धित धूप, अऊर निवास को फाटक को परदा; <verse eid="EXO 35:15" /><verse number="16" style="v" sid="EXO 35:16" />पीतल की जाली, डन्डो आदि पूरो सामान सहित होमबलि वेदी, पाय सहित गंगार; <verse eid="EXO 35:16" /><verse number="17" style="v" sid="EXO 35:17" />खम्बा अऊर उन्को तक्ता सहित आंगन को परदा, अऊर आंगन को फाटक को परदा; <verse eid="EXO 35:17" /><verse number="18" style="v" sid="EXO 35:18" />निवास अऊर आंगन दोयी को खूटा, अऊर रस्सियां; <verse eid="EXO 35:18" /><verse number="19" style="v" sid="EXO 35:19" />पवित्र जागा म सेवा काम करतो समय पहिनन को बुन्यो हुयो कपड़ा, अऊर याजक को काम करन लायी हारून याजक को पवित्र कपड़ा, अऊर ओको टुरावों को कपड़ा।”<verse eid="EXO 35:19" /></para>
  <para style="s">लोगों द्वारा भेंट लानो</para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 35:20" />तब इस्राएलियों की पूरी मण्डली मूसा को आगु सी लौट गयी। <verse eid="EXO 35:20" /><verse number="21" style="v" sid="EXO 35:21" />अऊर जितनो ख उत्साह भयो अऊर जितनो को मन म असी इच्छा पैदा भयी होती, हि मिलाप वालो तम्बू को काम करन अऊर ओकी पूरी सेवा अऊर पवित्र कपड़ा ख बनावन लायी परमेश्वर की भेंट लावन लग्यो, <verse eid="EXO 35:21" /><verse number="22" style="v" sid="EXO 35:22" />का बाई, का आदमी, जितनो को मन म असी इच्छा पैदा भयी होती हि सब नथनी, अंगुठी, कान की बाली अऊर गरो को हार अऊर सब तरह को सोनो को जेवर लावन लग्यो, जो जो आदमी परमेश्वर ख भेंट चढ़ानो चाहत होतो ओन सोनो लायो। <verse eid="EXO 35:22" /><verse number="23" style="v" sid="EXO 35:23" />अऊर जो जो आदमी को जवर नीलो, जामुनी यां लाल रंग को कपड़ा, यां पतलो सूत सी बुन्यो हुयो कपड़ा, यां शेरी को बाल, यां लाल रंग सी रंगी हुयी मेंढा की खाल, यां सुइसों की खाल होती हि उन्ख ले आयो। <verse eid="EXO 35:23" /><verse number="24" style="v" sid="EXO 35:24" />फिर जितनो चांदी, यां पीतल की भेंट को देन वालो होतो हि परमेश्वर लायी वसीच भेंट ले आये; अऊर जेको जेको जवर उपयोग म आवन वालो बबूल की लकड़ी होती हि ओख ले आये। <verse eid="EXO 35:24" /><verse number="25" style="v" sid="EXO 35:25" />अऊर जितनी बाईयों को दिल म बुद्धि की कला होती हि अपनो हाथ सी सूत कात कात क नीलो, जामुनी अऊर लाल रंग को, पतलो सूत कात क ले आयी। <verse eid="EXO 35:25" /><verse number="26" style="v" sid="EXO 35:26" />जितनी बाईयों को मन म असी बुद्धि की कला होती उन्न शेरी को बाल भी बुन्यो। <verse eid="EXO 35:26" /><verse number="27" style="v" sid="EXO 35:27" />अऊर मुखिया लोग एपोद अऊर चपरास लायी सुलैमानी मनि, अऊर जड़न लायी मनि, <verse eid="EXO 35:27" /><verse number="28" style="v" sid="EXO 35:28" />अऊर प्रकाश देन अऊर अभिषेक अऊर धूप को लायी सुगन्धित मसाले अऊर तेल लायो। <verse eid="EXO 35:28" /><verse number="29" style="v" sid="EXO 35:29" />जो जो चिज ख बनावन की आज्ञा परमेश्वर न मूसा को द्वारा दी होती ओको लायी जो कुछ जरूरी होतो, ओख हि सब आदमी अऊर बाईयों ले आयी, जिन्को दिल म असी इच्छा पैदा भयी होती। यो तरह इस्राएली परमेश्वर लायी अपनीच इच्छा सी भेंट ले आयो।<verse eid="EXO 35:29" /></para>
  <para style="s">परमेश्वर को उपस्थिति को तम्बू को लायी कारीगर</para>
  <para style="r">(<ref loc="EXO 31:1-11">निर्गमन ३१:१-११</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 35:30" />तब मूसा न इस्राएली लोगों सी कह्यो, “सुनो, परमेश्वर न यहूदा को वंश वालो बसलेल ख, जो ऊरी को टुरा अऊर हूर को नाती हय, नाम ले क बुलायो हय; <verse eid="EXO 35:30" /><verse number="31" style="v" sid="EXO 35:31" />अऊर ओन ओख परमेश्वर को आत्मा सी असो परिपूर्न करयो हय कि सब तरह की कला लायी ओख असी बुद्धि, समझ, अऊर ज्ञान मिल्यो हय <verse eid="EXO 35:31" /><verse number="32" style="v" sid="EXO 35:32" />कि ऊ कला की योजना निकाल क सोनो, चांदी अऊर पीतल म, <verse eid="EXO 35:32" /><verse number="33" style="v" sid="EXO 35:33" />अऊर जड़न लायी मनि काटन म अऊर लकड़ी पर नक्कासी करन म, बल्की बुद्धी सी सब तरह की निकाली हुयी कला म काम कर सके। <verse eid="EXO 35:33" /><verse number="34" style="v" sid="EXO 35:34" />फिर परमेश्वर न ओको मन म अऊर दान वंश को अहीसामाक को टुरा ओहोलीआब को मन म भी शिक्षा देन की शक्ति दी हय। <verse eid="EXO 35:34" /><verse number="35" style="v" sid="EXO 35:35" />इन दोयी को दिल ख परमेश्वर न असी बुद्धि सी परिपूर्न करयो हय कि हि कुशल कला अऊर गढ़न वालो अऊर नीलो, जामुनी अऊर लाल रंग को कपड़ा, अऊर पतलो सूत को कपड़ा म काढ़न अऊर बुनन वालो होना, बल्की सब तरह की बनावट म, अऊर बुद्धि सी काम निकालन म सब तरह को काम करे।<verse eid="EXO 35:35" /></para>
  <chapter eid="EXO 35" />
  <chapter number="36" style="c" sid="EXO 36" />
  <para style="p">
    <verse number="1" style="v" sid="EXO 36:1" />“बसलेल अऊर ओहोलीआब अऊर सब बुद्धिमान जिन्ख परमेश्वर न असी बुद्धि अऊर समझ दियो हो कि हि परमेश्वर की पूरी आज्ञावों को अनुसार पवित्र जागा की सेवा लायी सब तरह को काम करनो जानय हय, हि सब यो काम करेंन।”<verse eid="EXO 36:1" /></para>
  <para style="s">लोगों द्वारा बहुत सी भेंट</para>
  <para style="p">
    <verse number="2" style="v" sid="EXO 36:2" />तब मूसा न बसलेल अऊर ओहोलीआब अऊर सब बुद्धिमानों ख जिन्को दिल म परमेश्वर न बुद्धि को प्रकाश दियो होतो, मतलब जेख जेख जवर आय क काम करन को उत्साह भयो होतो उन सब ख बुलायो; <verse eid="EXO 36:2" /><verse number="3" style="v" sid="EXO 36:3" />अऊर इस्राएली जो जो भेंट पवित्र जागा की सेवा को काम अऊर ओख बनावन लायी ले आयो होतो, उन्ख उन आदमियों न मूसा को हाथ सी ले लियो। तब भी लोग हर सुबेरे ओको जवर भेंट अपनी इच्छा सी लावतो रहो; <verse eid="EXO 36:3" /><verse number="4" style="v" sid="EXO 36:4" />अऊर जितनो बुद्धिमान पवित्र जागा को काम करत होतो हि सब अपनो अपनो काम छोड़ क मूसा को जवर आये, <verse eid="EXO 36:4" /><verse number="5" style="v" sid="EXO 36:5" />अऊर मूसा सी कहन लग्यो, “जो काम ख करन की आज्ञा परमेश्वर न दियो हय ओको लायी जितनो होनो ओको सी जादा हि ले आयो हंय।” <verse eid="EXO 36:5" /><verse number="6" style="v" sid="EXO 36:6" />तब मूसा न पूरी छावनी म या आज्ञा को प्रचार करवायो, “का आदमी, का बाई, कोयी पवित्र जागा लायी अऊर भेंट नहीं लाये।” यो तरह लोग अऊर भेंट लावन सी रोक्यो गयो; <verse eid="EXO 36:6" /><verse number="7" style="v" sid="EXO 36:7" />कहालीकि सब काम बनावन लायी जितनो सामान जरूरत होतो, ओको सी जादा बनावन वालो को जवर आय चुक्यो होतो।<verse eid="EXO 36:7" /></para>
  <para style="s">निवास जागा को निर्मान</para>
  <para style="r">(<ref loc="EXO 26:1-37">निर्गमन २६:१-३७</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 36:8" />काम करन वालो जितनो कुशल कारीगर होतो उन्न निवास लायी यां परदा पतलो सूत सी बुन्यो हुयो नीलो, जामुनी अऊर लाल रंग को कपड़ा को दस परदा ख बुनायी करयो हुयो करूबों सहित बनायो। <verse eid="EXO 36:8" /><verse number="9" style="v" sid="EXO 36:9" />हर एक परदा की लम्बायी <note caller="+" style="f"><char style="fr" closed="false">36:9 </char><char style="ft" closed="false">बारा मीटर लम्बायी</char></note>अट्ठावीस हाथ अऊर <note caller="+" style="f"><char style="fr" closed="false">36:9 </char><char style="ft" closed="false">दोय मीटर चौड़ायी</char></note>चौड़ायी चार हाथ की होना; सब परदा एकच नाप को बने। <verse eid="EXO 36:9" /><verse number="10" style="v" sid="EXO 36:10" />ओन पाच परदा एक दूसरो सी जोड़ दियो, अऊर फिर दूसरो पाच परदा भी एक दूसरो सी जोड़ दियो। <verse eid="EXO 36:10" /><verse number="11" style="v" sid="EXO 36:11" />अऊर जहां यो परदा जोड़्यो गयो वहां की दोयी कोनो पर ओन नीलो नीलो फन्दा लगाये। <verse eid="EXO 36:11" /><verse number="12" style="v" sid="EXO 36:12" />ओन दोयी कोना म पचास पचास फन्दा यो तरह लगाये कि हि एक दूसरो को आगु रहे। <verse eid="EXO 36:12" /><verse number="13" style="v" sid="EXO 36:13" />अऊर ओन सोनो को पचास आकड़ा बनाये, अऊर उन्को द्वारा परदा ख एक दूसरो सी असो जोड़्यो कि निवास मिल क एकच भय गयो।<verse eid="EXO 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EXO 36:14" />तब निवास जागा को ऊपर को तम्बू लायी ओन शेरी को बाल को ग्यारा परदा बनाये। <verse eid="EXO 36:14" /><verse number="15" style="v" sid="EXO 36:15" />एक एक परदा की लम्बाई तीस हाथ अऊर चौड़ाई चार हाथ की भयी; अऊर ग्यारा परदा भी एकच नाप को होतो। <verse eid="EXO 36:15" /><verse number="16" style="v" sid="EXO 36:16" />इन म सी ओन पाच परदा अलग अऊर छय परदा अलग जोड़ दियो। <verse eid="EXO 36:16" /><verse number="17" style="v" sid="EXO 36:17" />अऊर जहां दोयी जोड़्यो गयो वहां को कोना म ओन पचास पचास फन्दा लगाये। <verse eid="EXO 36:17" /><verse number="18" style="v" sid="EXO 36:18" />अऊर ओन तम्बू को जोड़न लायी पीतल को पचास आकड़ा भी बनाये जेकोसी ऊ एक होय जाये। <verse eid="EXO 36:18" /><verse number="19" style="v" sid="EXO 36:19" />अऊर ओन तम्बू लायी लाल रंग सी रंगी हुयी मेंढा की खालों को एक ओढ़ना अऊर ओको ऊपर लायी सुइसों की खालों को भी एक ओढ़ना बनायो।<verse eid="EXO 36:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EXO 36:20" />तब ओन निवास लायी बबूल की लकड़ी को तक्ता ख खड़ो रहन लायी बनायो। <verse eid="EXO 36:20" /><verse number="21" style="v" sid="EXO 36:21" />हर एक तक्ता की लम्बायी दस हाथ अऊर चौड़ायी देड़ हाथ की भयी। <verse eid="EXO 36:21" /><verse number="22" style="v" sid="EXO 36:22" />हर एक तक्ता म एक दूसरो सी जोड़ी हुयी दोय दोय खाचा बन्यो, निवास को सब तक्ता ख ओन एक जसो बनायो। <verse eid="EXO 36:22" /><verse number="23" style="v" sid="EXO 36:23" />ओन निवास लायी तक्ता ख बनायो कि दक्षिन को तरफ बीस तक्ता; <verse eid="EXO 36:23" /><verse number="24" style="v" sid="EXO 36:24" />अऊर इन बीसों तक्ता को खल्लो चांदी की चालीस पाया, मतलब एक एक तक्ता को खल्लो ओकी दोय खाचा लायी ओन दोय कुर्चियां बनायी। <verse eid="EXO 36:24" /><verse number="25" style="v" sid="EXO 36:25" />अऊर निवास की दूसरो तरफ, मतलब उत्तर को तरफ लायी भी ओन बीस तक्ता बनाये; <verse eid="EXO 36:25" /><verse number="26" style="v" sid="EXO 36:26" />अऊर इन्को लायी भी ओन चांदी की चालीस पाया, मतलब एक एक तक्ता को खल्लो दोय दोय पाया बनायी। <verse eid="EXO 36:26" /><verse number="27" style="v" sid="EXO 36:27" />अऊर निवास को पीछु को तरफ, मतलब पश्चिम को तरफ को लायी ओन छय तक्ता बनायो; <verse eid="EXO 36:27" /><verse number="28" style="v" sid="EXO 36:28" />अऊर पिछलो हिस्सा म निवास को कोना लायी ओन दोय तक्ता बनायो। <verse eid="EXO 36:28" /><verse number="29" style="v" sid="EXO 36:29" />हि खल्लो सी दोय दोय हिस्सा को बने, अऊर दोयी हिस्सा ऊपर को कोना तक एक एक कड़ा म मिलाये गयो; ओन उन दोयी तक्ता को आकार असोच बनायो <verse eid="EXO 36:29" /><verse number="30" style="v" sid="EXO 36:30" />यो तरह आठ तक्ता भयो, अऊर उन्की चांदी की सोला पाया भयी; मतलब हर एक तक्ता को खल्लो दोय दोय पाया भयी।<verse eid="EXO 36:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EXO 36:31" />तब ओन बबूल की लकड़ी की बेंड़े बनायो, मतलब निवास को एक तरफ को तक्ता लायी पाच बेंड़ा, <verse eid="EXO 36:31" /><verse number="32" style="v" sid="EXO 36:32" />अऊर निवास को दूसरो तरफ को तक्ता लायी पाच बेंड़ा, अऊर निवास को जो किनार पश्चिम को तरफ पिछलो हिस्सा म होतो ओको लायी भी पाच बेंड़ा बनायो। <verse eid="EXO 36:32" /><verse number="33" style="v" sid="EXO 36:33" />अऊर ओन बीच वालो बेंड़ा ख तक्ता को बीच म तम्बू को एक कोना सी दूसरो कोना तक पहुंचन लायी बनायो। <verse eid="EXO 36:33" /><verse number="34" style="v" sid="EXO 36:34" />अऊर तक्ता ख ओन सोनो सी मढ़यो, अऊर बेंड़ों ख जो घर को काम देन वालो कड़ा ख सोनो को बनायो, अऊर बेंड़ा ख भी सोनो सी मढ़यो।<verse eid="EXO 36:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EXO 36:35" />फिर ओन नीलो, जामुनी अऊर लाल रंग को कपड़ा को, अऊर पतलो सूत सी बुन्यो हुयो कपड़ा को बीच वालो परदा बनायो; ऊ बुनायी को काम करयो हुयो करूबों को संग बनायो। <verse eid="EXO 36:35" /><verse number="36" style="v" sid="EXO 36:36" />ओन ओको लायी बबूल को चार खम्बा बनायो, अऊर उन्को सोनो सी मढ़यो; उन्की घुंड़ियां सोनो की बनायी, अऊर ओन उन्को लायी चांदी को चार पाया बनायो। <verse eid="EXO 36:36" /><verse number="37" style="v" sid="EXO 36:37" />ओन तम्बू को दरवाजा लायी भी नीलो, जामुनी अऊर लाल रंग को कपड़ा को, अऊर पतलो सूत बुन्यो हुयो कपड़ा सी बुनायी को काम करयो हुयो परदा बनायो; <verse eid="EXO 36:37" /><verse number="38" style="v" sid="EXO 36:38" />अऊर ओन घुंड़ियों सहित ओको पाच खम्बा भी बनाये, अऊर उन्को कोनो अऊर जोड़न की पट्टियों ख सोनो सी मढ़यो, अऊर उन्को पाच पाया पीतल को बनायो।<verse eid="EXO 36:38" /></para>
  <chapter eid="EXO 36" />
  <chapter number="37" style="c" sid="EXO 37" />
  <para style="s">वाचा को सन्दूक बनायो जानो</para>
  <para style="r">(<ref loc="EXO 25:10-22">निर्गमन २५:१०-२२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 37:1" />तब बसलेल न बबूल की लकड़ी को सन्दूक बनायो; ओकी लम्बायी ढायी हाथ, चौड़ायी डेढ़ हाथ, अऊर ऊंचायी डेढ़ हाथ की होती, <verse eid="EXO 37:1" /><verse number="2" style="v" sid="EXO 37:2" />ओन ओख अन्दर बाहेर शुद्ध सोनो सी मढ़यो, अऊर ओको चारयी तरफ सोनो की किनार बनायी। <verse eid="EXO 37:2" /><verse number="3" style="v" sid="EXO 37:3" />अऊर ओको चारयी पाय पर लगान लायी ओन सोनो को चार कड़ा डाल्यो, दोय कड़ा एक तरफ अऊर दोय कड़ा दूसरो तरफ लग्यो। <verse eid="EXO 37:3" /><verse number="4" style="v" sid="EXO 37:4" />तब ओन बबूल को डन्डा बनाये, अऊर उन्ख सोनो सी मढ़यो, <verse eid="EXO 37:4" /><verse number="5" style="v" sid="EXO 37:5" />अऊर उन्को सन्दूक को दोयी तरफ को कड़ों म डाल्यो कि उन्को बल सन्दूक उठायो जाये। <verse eid="EXO 37:5" /><verse number="6" style="v" sid="EXO 37:6" />तब ओन शुद्ध सोनो को प्रायश्चित वालो ढक्कन ख बनायो; ओकी लम्बायी ढायी हाथ अऊर चौड़ायी देढ़ हाथ की होती। <verse eid="EXO 37:6" /><verse number="7" style="v" sid="EXO 37:7" />अऊर ओन सोनो ढाल क दोय करूब प्रायश्चित को ढक्कन को दोयी कोनो को ऊपर बनाये; <verse eid="EXO 37:7" /><verse number="8" style="v" sid="EXO 37:8" />एक करूब एक कोना पर, अऊर दूसरो करूब दूसरो कोना पर बनाव; ओन उन्ख प्रायश्चित को ढक्कन को संग एकच तुकड़ा को दोयी कोनो पर बनायो। <verse eid="EXO 37:8" /><verse number="9" style="v" sid="EXO 37:9" />अऊर करूबों को पंख ऊपर सी फैलायो हुयो बनाव, अऊर उन पंखा सी प्रायश्चित को ढकना झक्यो हुयो बनाव, अऊर उन्को मुख आमने-सामने अऊर प्रायश्चित को ढक्कन को तरफ करयो हुयो बनाव।<verse eid="EXO 37:9" /></para>
  <para style="s">पवित्र रोटी को मेज</para>
  <para style="r">(<ref loc="EXO 25:23-30">निर्गमन २५:२३-३०</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="EXO 37:10" />तब ओन बबूल की लकड़ी की मेज ख बनायो; ओकी लम्बायी दोय हाथ, चौड़ायी एक हाथ, अऊर ऊचायी देढ़ हाथ की होती; <verse eid="EXO 37:10" /><verse number="11" style="v" sid="EXO 37:11" />अऊर ओन ओख शुद्ध सोनो सी मढ़यो, अऊर ओको म चारयी तरफ सोनो की एक किनार बनायी; <verse eid="EXO 37:11" /><verse number="12" style="v" sid="EXO 37:12" />अऊर ओन ओको लायी चार बोट चौड़ी एक चौखट बनायी, अऊर या चौखट लायी चारयी तरफ सोनो की एक किनार बनायी। <verse eid="EXO 37:12" /><verse number="13" style="v" sid="EXO 37:13" />ओन मेज लायी सोनो को चार कड़ा ढाल क उन चारयी कोनो म लगायो, जो ओको चारयी पाय पर होतो। <verse eid="EXO 37:13" /><verse number="14" style="v" sid="EXO 37:14" />हि कड़ां चौखट को जवर मेज ख उठावन लायी डन्डो ख सहारा देन लायी बनायो। <verse eid="EXO 37:14" /><verse number="15" style="v" sid="EXO 37:15" />ओन मेज ख उठावन लायी डन्डा ख बबूल की लकड़ी को बनायो अऊर सोनो सी मढ़यो। <verse eid="EXO 37:15" /><verse number="16" style="v" sid="EXO 37:16" />अऊर ओन मेज पर को सामान मतलब परात, धूपदान, कटोरा, अऊर पीवन को बर्तन सब शुद्ध सोनो को बनाये।<verse eid="EXO 37:16" /></para>
  <para style="s">सोनो को दीया को बनायो जानो</para>
  <para style="r">(<ref loc="EXO 25:31-40">निर्गमन २५:३१-४०</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="EXO 37:17" />तब ओन शुद्ध सोनो को एक दीया बनायो; ओको डगाली, गाठ, पंकुड़ी अऊर फूल सब एकच तुकड़ा को बन्यो। <verse eid="EXO 37:17" /><verse number="18" style="v" sid="EXO 37:18" />अऊर दीया सी निकली हुयी छय डगालियां बनी; तीन डगालियां ओको एक तरफ सी अऊर तीन डगालियां ओको दूसरी तरफ सी निकली हुयी बन्यो। <verse eid="EXO 37:18" /><verse number="19" style="v" sid="EXO 37:19" />छय डगाली म सी हर एक सजावटी फूल होत होतो, जो कलियां अऊर पंकुड़ियां को संग बादाम को फूलों को तरह होत होतो। <verse eid="EXO 37:19" /><verse number="20" style="v" sid="EXO 37:20" />अऊर दीया की डन्डी म बादाम को फूल को जसो अपनी अपनी कलियां अऊर फूल सहित चार पंकुड़ी बनाये। <verse eid="EXO 37:20" /><verse number="21" style="v" sid="EXO 37:21" />अऊर दीया सी निकली हुयी छय डगालियां म सी दोय दोय डगालियां को नीचो एक एक कलियां दीया को संग एकच तुकड़ा की बनाये। <verse eid="EXO 37:21" /><verse number="22" style="v" sid="EXO 37:22" />कली अऊर डगालियां सब दीया को संग एकच तुकड़ा की बने; शुद्ध सोनो ढाल क पूरो दीया एकच तुकड़ा को बन्यो। <verse eid="EXO 37:22" /><verse number="23" style="v" sid="EXO 37:23" />अऊर ओन दीया को सातों दीया बनाये, अऊर चिमटे अऊर थारी सब शुद्ध सोनो को बनाये। <verse eid="EXO 37:23" /><verse number="24" style="v" sid="EXO 37:24" />ओन पूरो सामान सहित दीवट अऊर ओको सब कटोरा लगभग चौतीस किलो शुद्ध सोनो को बनायो।<verse eid="EXO 37:24" /></para>
  <para style="s">धूप वेदी को बनायो जानो</para>
  <para style="r">(<ref loc="EXO 30:1-5">निर्गमन ३०:१-५</ref>)</para>
  <para style="p">
    <verse number="25" style="v" sid="EXO 37:25" />तब ओन बबूल की लकड़ी की धूप वेदी भी बनायी; ओकी लम्बायी एक हाथ अऊर चौड़ायी एक हाथ की होती; वा चौकोन बने, अऊर ओकी ऊचायी दोय हाथ की होती; अऊर ओको सींग ओको संग एकच तुकड़ा को बन्यो होतो। <verse eid="EXO 37:25" /><verse number="26" style="v" sid="EXO 37:26" />ऊपर वालो पल्लां, अऊर चारयी तरफ को बाजुवों अऊर सींगो सहित ओन उच वेदी ख शुद्ध सोनो सी मढ़यो; अऊर ओको चारयी तरफ सोनो की एक किनार बनायी, <verse eid="EXO 37:26" /><verse number="27" style="v" sid="EXO 37:27" />अऊर ऊ किनार को खल्लो ओको दोयी पल्लां पर ओन सोनो को दोय कड़ा बनायो, जो ओख उठावन को डन्डा ख सहारा को काम दे। <verse eid="EXO 37:27" /><verse number="28" style="v" sid="EXO 37:28" />अऊर डन्डा ख ओन बबूल की लकड़ी को बनायो अऊर सोनो सी मढ़यो।<verse eid="EXO 37:28" /></para>
  <para style="s">धूप अऊर अभिषेक को तेल को बनायो जानो</para>
  <para style="r">(<ref loc="EXO 30:22-38">निर्गमन ३०:२२-३८</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="EXO 37:29" />ओन अभिषेक को पवित्र तेल अऊर सुगन्धित द्रव्य को धूप सुगन्ध को रीति को अनुसार बनायो।<verse eid="EXO 37:29" /></para>
  <chapter eid="EXO 37" />
  <chapter number="38" style="c" sid="EXO 38" />
  <para style="s">होमबलि वेदी ख बनायो जानो</para>
  <para style="r">(<ref loc="EXO 27:1-8">निर्गमन २७:१-८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 38:1" />तब ओन बबूल की लकड़ी की होमबलि वेदी भी बनायी; ओकी लम्बायी पाच हाथ अऊर चौड़ायी पाच हाथ की होती; यो तरह सी ऊ चौकोन बनी, अऊर ऊचायी तीन हाथ की होती। <verse eid="EXO 38:1" /><verse number="2" style="v" sid="EXO 38:2" />ओन ओको चारयी कोनो पर ओको चार सींग बनाये, हि ओको संग बिना जोड़ क् बन्यो; अऊर ओन ओख ख पीतल सी मढ़यो। <verse eid="EXO 38:2" /><verse number="3" style="v" sid="EXO 38:3" />अऊर ओन वेदी को पूरो सामान, यानेकि ओकी हान्डियों, फावडां, कटोरा, काटे अऊर आगी कटोराच सब पीतल सी बनाये। <verse eid="EXO 38:3" /><verse number="4" style="v" sid="EXO 38:4" />ओन वेदी लायी पेटी को नीचो, एक पीतल की जाली एक असी एक जाली बनायी, ऊ नीचो सी वेदी की ऊचायी को बीच तक पहुंची। <verse eid="EXO 38:4" /><verse number="5" style="v" sid="EXO 38:5" />ओन पीतल की जाली को चारयी कोनो लायी चार कड़ा ढाल्यो, जो डन्डों को खाना को काम दे। <verse eid="EXO 38:5" /><verse number="6" style="v" sid="EXO 38:6" />तब ओन डन्डों ख बबूल की लकड़ी को बनायो अऊर पीतल सी मढ़यो। <verse eid="EXO 38:6" /><verse number="7" style="v" sid="EXO 38:7" />तब ओन डन्डों ख वेदी को किनारो को कड़ों म वेदी क् उठान लायी डाल दियो। वेदी ख ओन तक्ता सी खोखली बनायो।<verse eid="EXO 38:7" /></para>
  <para style="s">पीतल को गंगार बनायो जानो</para>
  <para style="r">(<ref loc="EXO 30:18">निर्गमन ३०:१८</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 38:8" />ओन गंगार अऊर ओको पाया दोयी पीतल को बनाये, यो मिलाप वालो तम्बू को फाटक पर सेवा करन वालो बाईयों को आरसा को पीतल सी बनाये गयो।<verse eid="EXO 38:8" /></para>
  <para style="s">निवास-जागा को आंगन बनायो जानो</para>
  <para style="r">(<ref loc="EXO 27:9-19">निर्गमन २७:९-१९</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="EXO 38:9" />तब ओन आंगन बनायो; अऊर दक्षिन की तरफ लायी आंगन को परदा पतलो सूत सी बुन्यो हुयो कपड़ा को होतो, अऊर सब मिलाय क सौ हाथ लम्बो होतो; <verse eid="EXO 38:9" /><verse number="10" style="v" sid="EXO 38:10" />उन्को लायी बीस खम्बा, अऊर पीतल को बीस पाया बन्यो; अऊर खम्बा की घुंड़ियां अऊर जोड़न की पट्टियां चांदी की बनी। <verse eid="EXO 38:10" /><verse number="11" style="v" sid="EXO 38:11" />अऊर उत्तर की तरफ लायी भी सौ हाथ लम्बो परदा बन्यो; अऊर उन्को लायी बीस खम्बा अऊर पीतल को बीस पाया बन्यो, अऊर खम्बां की घुंड़ियां अऊर जोड़न की पट्टियां चांदी को बनी होती। <verse eid="EXO 38:11" /><verse number="12" style="v" sid="EXO 38:12" />अऊर पश्चिम की तरफ परदा साढ़े बावीस मीटर लम्बो होतो; उन्को लायी दस खम्बा अऊर दस उन्को पाया होतो, अऊर खम्बां की घुन्डियां अऊर जोड़न वाली पट्टियां चांदी की होती। <verse eid="EXO 38:12" /><verse number="13" style="v" sid="EXO 38:13" />अऊर पूर्व हिस्सा म आगु को तरफ को परदा पचास लम्बो होतो। <verse eid="EXO 38:13" /><verse number="14" style="v" sid="EXO 38:14" />आंगन को फाटक को एक तरफ लायी पन्द्रा हाथ को परदा बन्यो; अऊर उन्को लायी तीन खम्बा अऊर तीन पाया होतो। <verse eid="EXO 38:14" /><verse number="15" style="v" sid="EXO 38:15" />अऊर आंगन को फाटक को दूसरी तरफ भी वसोच बन्यो होतो; अऊर आंगन को दरवाजा को इत अऊर उत पन्द्रा पन्द्रा हाथ को परदा बन्यो होतो; अऊर उन्को लायी तीन तीन खम्बा, अऊर तीन तीन पाया भी होतो। <verse eid="EXO 38:15" /><verse number="16" style="v" sid="EXO 38:16" />आंगन को चारयी तरफ सब परदा पतलो बुन्यो हुयो सूती कपड़ा को होतो। <verse eid="EXO 38:16" /><verse number="17" style="v" sid="EXO 38:17" />अऊर खम्बां को पाया पीतल को अऊर घुन्डियां अऊर पट्टियां चांदी को बन्यो होतो, अऊर उन्को ऊपर को कोना चांदी सी मढ़यो हुयो होतो, अऊर आंगन को सब खम्बां चांदी की पट्टियां सी जुड़ गयो। <verse eid="EXO 38:17" /><verse number="18" style="v" sid="EXO 38:18" />आंगन को फाटक को परदा पर बुनायी करी गयी होती, अऊर ऊ नीलो, जामुनी तब लाल रंग को कपड़ा को; पतलो बुन्यो हुयो सूती कपड़ा को होतो; अऊर ओकी ऊचायी आंगन को बराबर को चौड़ायी को समान पाच हाथ की बन्यो। <verse eid="EXO 38:18" /><verse number="19" style="v" sid="EXO 38:19" />अऊर उन्को लायी चार खम्बां, अऊर खम्बों की चारयी पाया पीतल को बन्यो, उन्की घुन्डियां चांदी की बन्यो, अऊर उन्को कोना चांदी सी मढ़यो गयो होतो, अऊर उन्की पट्टियां चांदी को बन्यो होती। <verse eid="EXO 38:19" /><verse number="20" style="v" sid="EXO 38:20" />निवास जागा तब आंगन को चारयी तरफ को सब खूटा पीतल को बन्यो होतो।<verse eid="EXO 38:20" /></para>
  <para style="s">निवास जागा म प्रयुक्त धातुवों को विवरन</para>
  <para style="p">
    <verse number="21" style="v" sid="EXO 38:21" />निवास जागा मतलब गवाही चिट्ठी को तम्बू को सामान जो लेवियों को सेवा लायी बन्यो होतो, अऊर जेकी गिनती मूसा को आज्ञा को अनुसार हारून याजक को टुरा ईतामार को द्वारा हुयी होती, ओको वर्नन यो हय। <verse eid="EXO 38:21" /><verse number="22" style="v" sid="EXO 38:22" />जेको जेको चिज को बनान की आज्ञा परमेश्वर न मूसा ख दियो होती ओख ख बसलेल न बनायो, ऊ ऊरी को टुरा, हूर को नाती अऊर यहूदा को वंश को होतो। <verse eid="EXO 38:22" /><verse number="23" style="v" sid="EXO 38:23" />अऊर ओको संग दान वंश वालो, अहीसामाक को टुरा, ओहोलीआब होतो, जो नक्कासी करन अऊर गढ़न वालो अऊर नीलो, जामुनी अऊर लाल रंग को पतलो धागा सी बुन्यो हुयो कपड़ा म बुनायी करन वालो निपुन कारीगर होतो।<verse eid="EXO 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EXO 38:24" />पवित्र जागा को पूरो काम म जो भेंट को सोनो लग्यो ऊ पवित्र जागा को शेकेल को हिसाब सी एक हजार दोय किलो होतो। <verse eid="EXO 38:24" /><verse number="25" style="v" sid="EXO 38:25" />अऊर मण्डली को गिन्यो हुयो लोगों की भेंट की चांदी पवित्र जागा को शेकेल को हिसाब सी सौ किक्कार अऊर सतरा सौ पचहत्तर शेकेल<note caller="+" style="f"><char style="fr" closed="false">38:25 </char><char style="ft" closed="false">लगभग तीन हजार चार सौ तीस किलोग्राम</char></note> होती। <verse eid="EXO 38:25" /><verse number="26" style="v" sid="EXO 38:26" /><note caller="+" style="x"><char style="xo" closed="false">38:26 </char><char style="xt" closed="false"><ref loc="MAT 17:24">मत्ती १७:२४</ref>; <ref loc="EXO 30:11-16">निर्गमन ३०:११-१६</ref></char></note>मतलब जितनो बीस साल अऊर ओख सी जादा उमर को होतो, जो गिनती म छय लाख तीन हजार पाच सौ पचास आदमी होतो, उन सी एक बेका<note caller="+" style="f"><char style="fr" closed="false">38:26 </char><char style="ft" closed="false">लगभग ६ ग्राम</char></note> हर आदमी ख मतलब पवित्र जागा को शेकेल को अनुसार अरधो शेकेल मिल्यो। <verse eid="EXO 38:26" /><verse number="27" style="v" sid="EXO 38:27" />अऊर ऊ सौ किक्कार<note caller="+" style="f"><char style="fr" closed="false">38:27 </char><char style="ft" closed="false">लगभग ३४०० किलोग्राम</char></note> चांदी पवित्र जागा अऊर बीच वालो परदा दोयी को पाया को ढालन म लग गयो; सौ किक्कार सी सौ पाया बन्यो, हर एक पाया एक किक्कार को बन्यो। <verse eid="EXO 38:27" /><verse number="28" style="v" sid="EXO 38:28" />अऊर शेष एक हजार सात सौ पछत्तर शेकेल<note caller="+" style="f"><char style="fr" closed="false">38:28 </char><char style="ft" closed="false">लगभग ३० किलोग्राम</char></note> सी ओन खम्बों की घुन्डियां बनायी अऊर खम्बों को ऊपर को भाग मढ़यो, अऊर उन्की पट्टियां भी बनायी। <verse eid="EXO 38:28" /><verse number="29" style="v" sid="EXO 38:29" />अऊर भेंट को पीतल सत्तर किक्कार अऊर दोय हजार चार सौ शेकेल<note caller="+" style="f"><char style="fr" closed="false">38:29 </char><char style="ft" closed="false">२४२५ किलोग्राम</char></note> होतो <verse eid="EXO 38:29" /><verse number="30" style="v" sid="EXO 38:30" />ओको सी मिलाप वालो तम्बू को फाटक को पाया अऊर पीतल की वेदी, ओकी पीतल की जाली, अऊर वेदी को पूरो सामान; <verse eid="EXO 38:30" /><verse number="31" style="v" sid="EXO 38:31" />अऊर आंगन को चारयी तरफ को पाया, अऊर ओको फाटक को पाया, अऊर निवास, अऊर आंगन को चारयी तरफ को खूटा भी बनाये गयो।<verse eid="EXO 38:31" /></para>
  <chapter eid="EXO 38" />
  <chapter number="39" style="c" sid="EXO 39" />
  <para style="s">याजकीय कपड़ा तैयार करनो</para>
  <para style="r">(<ref loc="EXO 28:1-14">निर्गमन २८:१-१४</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 39:1" />तब उन्न नीलो, जामुनी अऊर लाल रंग को सूत सी पवित्र वेदी की सेवा करन वालों याजकों लायी पहिनन लायी कपड़ा बनाये, अऊर हारून लायी भी पवित्र कपड़ा बनाये; जो तरह परमेश्वर न मूसा ख आज्ञा दी होतो। <verse eid="EXO 39:1" /><verse number="2" style="v" sid="EXO 39:2" />ओन एपोद पोशाक ख सोनो सी, पतलो सूत सी बुन्यो हुयो नीलो, जामुनी अऊर लाल रंग को कपड़ा सी बनायो। <verse eid="EXO 39:2" /><verse number="3" style="v" sid="EXO 39:3" />अऊर उन्न सोनो ख पीट क पतली पत्तियां बनायी अऊर उन्म सी तार काट्यो। बाद म उन तार बनायो अऊर कुशल कारीगरों को द्वारा पतलो सूत सी बुन्यो हुयो नीलो, जामुनी अऊर लाल रंग को कपड़ा पर बनावट सी मिलाय दियो। <verse eid="EXO 39:3" /><verse number="4" style="v" sid="EXO 39:4" />उन्न एपोद लायी ओको दोयी कोनो पर जुड़्यो हुयो दोय कन्धा बनाये। <verse eid="EXO 39:4" /><verse number="5" style="v" sid="EXO 39:5" />अऊर ओख कसन लायी जो बारीक बुन्यो हुयो पट्टा ओको पर बन्यो, ऊ ओको संग बिना जोड़ को होतो, अऊर ओकीच बनावट को अनुसार, मतलब सोनो अऊर नीलो, जामुनी अऊर लाल रंग को कपड़ा को, अऊर स्वर्ण को कपड़ा को बन्यो; जसो परमेश्वर न मूसा ख आज्ञा दी होती।<verse eid="EXO 39:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EXO 39:6" />अऊर उन्न सुलैमानी गोटा काट क सोनो की खांचों म जोड़्यो गयो, यो गोटा इस्राएल को बारा टुरावों को नामों को अनुसार मुहर को समान खोद्यो गयो होतो। <verse eid="EXO 39:6" /><verse number="7" style="v" sid="EXO 39:7" />अऊर ओन उन्ख एपोद पोशाक को कन्धावों पर लगाय दियो, जेकोसी इस्राएलियों लायी याद करान वालो मनि ठहरे; जो तरह परमेश्वर न मूसा ख आज्ञा दी होती।<verse eid="EXO 39:7" /></para>
  <para style="s">सीनाबन्द यां सीनाबन्द बनानो</para>
  <para style="r">(<ref loc="EXO 28:15-30">निर्गमन २८:१५-३०</ref>)</para>
  <para style="p">
    <verse number="8" style="v" sid="EXO 39:8" />ओन सीनाबन्द ख एपोद को समान सोनो की, अऊर नीलो, जामुनी रंग को कपड़ा सी बनायो, अऊर बन्यो हुयो सन को कपड़ा म कलात्मक ढंग सी सीनाबन्द बनायो। <verse eid="EXO 39:8" /><verse number="9" style="v" sid="EXO 39:9" />सीनाबन्द चार च कोना बराबर बन्यो होतो; डबल मोड़्यो हुयो, अऊर ऊ डबल होय क नव इंच अऊर नव इंच चौड़ो बन्यो। <verse eid="EXO 39:9" /><verse number="10" style="v" sid="EXO 39:10" />अऊर उन्न ओको पर चार लायीन म मनि लगायो। पहली लायीन म एक माणिक्य; एक पुखराज, अऊर लालड़ी लगायो गयो; <verse eid="EXO 39:10" /><verse number="11" style="v" sid="EXO 39:11" />अऊर दूसरी लायीन म मरकत, नीलमनि, अऊर हीरा की होती; <verse eid="EXO 39:11" /><verse number="12" style="v" sid="EXO 39:12" />अऊर तीसरी लायीन म लशम, सूर्यकान्त, अऊर नीलम; <verse eid="EXO 39:12" /><verse number="13" style="v" sid="EXO 39:13" />अऊर चौथी लायीन म लशम, सुलैमानी मनि, अऊर यशब जड़े; यो सब अलग अलग सोनो को जड़्यो गयो। <verse eid="EXO 39:13" /><verse number="14" style="v" sid="EXO 39:14" />अऊर यो मनि इस्राएल को टुरावों को नामो को अनुसार बारा होतो; एक एक मनि पर एक एक कुल को नाम छाप को समान खोद्यो हुयो होतो। <verse eid="EXO 39:14" /><verse number="15" style="v" sid="EXO 39:15" />अऊर उन्न सीनाबन्द कवच पर डोरियां को समान गूथ्यो हुयो शुद्ध सोनो की संकली बनाय क लगायी; <verse eid="EXO 39:15" /><verse number="16" style="v" sid="EXO 39:16" />तब उन्न सोनो को दोय खाना, अऊर सोनो की दोय कड़ियां बनाय क दोयी कड़ियों ख सीनाबन्द कवच को दोयी कोनो पर जोड़ दियो; <verse eid="EXO 39:16" /><verse number="17" style="v" sid="EXO 39:17" />तब उन्न सोनो की दोयी गूथी हुयी संकली ख सीनाबन्द कवच को कोनो पर की दोयी कड़ियों म लगायो। <verse eid="EXO 39:17" /><verse number="18" style="v" sid="EXO 39:18" />अऊर गूथी हुयी दोयी संकलीयों को दोयी बाकी कोनो ख उन्न दोयी खांचों म लगायो, एपोद को आगु दोयी कन्धों को बन्धनो पर लगायो। <verse eid="EXO 39:18" /><verse number="19" style="v" sid="EXO 39:19" />तब उन्न सोनो की अऊर दोय कड़ियां बनायो अऊर उन्ख एपोद पोशाक को बाजू को अन्दर किनार पर, एपोद को खल्लो कोनो पर जोड़ दियो। <verse eid="EXO 39:19" /><verse number="20" style="v" sid="EXO 39:20" />अऊर उन्न सोनो की दोय अऊर कड़ियां भी बनाय क एपोद को दोयी कन्धों को खल्लो भाग को जोड़ पर, एपोद पोशाक को पतलो बुन्यो हुयो पट्टा को ऊपर जोड़ दियो। <verse eid="EXO 39:20" /><verse number="21" style="v" sid="EXO 39:21" />तब उन्न सीनाबन्द कवच ख ओकी कड़ियों को द्वारा एपोद की कड़ियों म नीलो पट्टा सी असो बान्ध्यो कि ऊ एपोद को लगायो हुयो पट्टा को ऊपर रहेंन, अऊर चपरास एपोद सी अलग नहीं हो सकेंन; जसो परमेश्वर न मूसा ख आज्ञा दी होती।<verse eid="EXO 39:21" /></para>
  <para style="s">दूसरो याजकीय कपड़ा बनानो</para>
  <para style="r">(<ref loc="EXO 28:31-43">निर्गमन २८:३१-४३</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="EXO 39:22" />ओन एपोद लायी सम्पूर्न नीलो रंग को एक अंगरखा बुन क बनायो। <verse eid="EXO 39:22" /><verse number="23" style="v" sid="EXO 39:23" />अंगरखा को बीचो बीच एक छेद होतो, यो छेद को चारयी तरफ कपड़ा की गोट लग्यो होतो जेकोसी ऊ फट नहीं सकेंन। <verse eid="EXO 39:23" /><verse number="24" style="v" sid="EXO 39:24" />उन्न अंगरखा को खल्लो वालो घेरा म पतलो सूत सी बुन्यो हुयो नीलो, जामुनी अऊर लाल रंग को कपड़ा को अनार जसो गोल बनाये। <verse eid="EXO 39:24" /><verse number="25" style="v" sid="EXO 39:25" />उन्न शुद्ध सोनो की घुंगरू भी बनाय क अंगरखा को नीचो वालो घेरा को चारयी तरफ अनारों को बीचो बीच लगायी; <verse eid="EXO 39:25" /><verse number="26" style="v" sid="EXO 39:26" />मतलब झगली को खल्लो वालो घेरा को चारयी तरफ एक सोनो की घन्टी, अऊर एक अनार, फिर एक सोनो की घन्टी, अऊर एक अनार लगायो गयो कि उन्ख पहिन्यो हुयो सेवा कार्य करे; जसो परमेश्वर न मूसा ख आज्ञा दी होती।<verse eid="EXO 39:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EXO 39:27" />उन्न हारून अऊर ओको टुरावों लायी यो पोशाकें बनायी: महीन सूती कपड़ा को कुरता, फेटा अऊर टोपियां पतलो सूत सी बुन्यो हुयो कपड़ा को जांघियां, <verse eid="EXO 39:27" /><verse number="28" style="v" sid="EXO 39:28" />पतलो बुन्यो हुयो कपड़ा को फेटा, सुन्दर टोपियां, अऊर जांघियां बनायी, <verse eid="EXO 39:28" /><verse number="29" style="v" sid="EXO 39:29" />अऊर पतलो सूत सी बुन्यो हुयो नीलो, जामुनी फिर लाल रंग को कपड़ा को कमर पट्टा, जो पर सूई सी बुनायी करयो गयो होतो, जसी परमेश्वर न मूसा ख आज्ञा दी होती।<verse eid="EXO 39:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EXO 39:30" />तब उन्न पवित्र मुकुट की पट्टी शुद्ध सोनो की बनायी; अऊर जसो मुहर म वसोच उन्म यो अक्षर खोद्यो गयो, मतलब “परमेश्वर लायी पवित्र।” <verse eid="EXO 39:30" /><verse number="31" style="v" sid="EXO 39:31" />उन्न ओको फेटा को आगु नीलो रंग की रस्सी संग बान्ध दियो, ठीक जसो “परमेश्वर न मूसा ख आज्ञा दी होती।”<verse eid="EXO 39:31" /></para>
  <para style="s">मिलाप वालो तम्बू को तैयार होनो</para>
  <para style="r">(<ref loc="EXO 35:10-19">निर्गमन ३५:१०-१९</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="EXO 39:32" />यो तरह मिलाप वालो तम्बू को निवास को सब काम पूरो भयो, अऊर जो काम की आज्ञा परमेश्वर न मूसा ख दी होती, इस्राएलियों न ओको अनुसार करयो।<verse eid="EXO 39:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EXO 39:33" />अऊर हि निवास को तम्बू अऊर ओकी सब चिजों सहित मूसा को जवर ले आये : मतलब हंसिया, चौखट, सलाखें, खम्बा अऊर तम्बू तक ले आये; <verse eid="EXO 39:33" /><verse number="34" style="v" sid="EXO 39:34" />अऊर लाल रंग सी रंगी हुयी मेंढा की खाल को ओढ़ना, अऊर सूइसों की खाल को ओढ़ना, अऊर बीच को परदा; <verse eid="EXO 39:34" /><verse number="35" style="v" sid="EXO 39:35" />गवाही-चिट्ठी को सन्दूक अऊर ओको खम्बा, अऊर पश्चाताप को ढक्कन; <verse eid="EXO 39:35" /><verse number="36" style="v" sid="EXO 39:36" />मेज अऊर ओकी सब चिजे अऊर भेंट की रोटी; <verse eid="EXO 39:36" /><verse number="37" style="v" sid="EXO 39:37" />शुद्ध सोनो की दीवट, अऊर ओको संग ओकी सजावट को दीया, अऊर ओकी सब चिजे फिर दीया जलावन लायी तेल; <verse eid="EXO 39:37" /><verse number="38" style="v" sid="EXO 39:38" />सोनो की वेदी, अऊर अभिषेक को तेल; सुगन्धित धूप अऊर तम्बू को दरवाजा को परदा; <verse eid="EXO 39:38" /><verse number="39" style="v" sid="EXO 39:39" />पीतल की वेदी अऊर ओकी पीतल की जाली, ओकी सब चिजों सहित खम्बा; गंगार अऊर ओको पाये; <verse eid="EXO 39:39" /><verse number="40" style="v" sid="EXO 39:40" />खम्बों अऊर पाया समेत आंगन को परदा, अऊर आंगन को फाटक को परदा, अऊर डोरियां, अऊर खूटा, अऊर मिलाप वालो तम्बू को निवास को सेवा को पूरो सामान; <verse eid="EXO 39:40" /><verse number="41" style="v" sid="EXO 39:41" />पवित्र जागा म सेवा करतो समय पहिन्यो हुयो कपड़ा, अऊर याजकीय सेवा काम करन लायी हारून याजक को पवित्र कपड़ा अऊर ओको टुरावों को कपड़ा। <verse eid="EXO 39:41" /><verse number="42" style="v" sid="EXO 39:42" />जसी परमेश्वर न मूसा ख आज्ञा दी होती ओको अनुसार इस्राएलियों न सब काम करयो। <verse eid="EXO 39:42" /><verse number="43" style="v" sid="EXO 39:43" />तब मूसा न पूरो काम ख जांच क देख्यो कि उन्न वसोच करयो होतो जसो परमेश्वर न आज्ञा दी होती। अऊर मूसा न उन्ख आशीर्वाद दियो।<verse eid="EXO 39:43" /></para>
  <chapter eid="EXO 39" />
  <chapter number="40" style="c" sid="EXO 40" />
  <para style="s">मिलाप वालो तम्बू खड़ो करयो जावय हय</para>
  <para style="p">
    <verse number="1" style="v" sid="EXO 40:1" />तब परमेश्वर न मूसा सी कह्यो, <verse eid="EXO 40:1" /><verse number="2" style="v" sid="EXO 40:2" />“पहिलो महीना को पहिलो दिन ख तय मिलाप वालो तम्बू को निवास ख खड़ो कर देजो। <verse eid="EXO 40:2" /><verse number="3" style="v" sid="EXO 40:3" />अऊर ओको म गवाही चिट्ठी को सन्दूक ख रख क बीच वालो परदा की आड़ म कर देजो। <verse eid="EXO 40:3" /><verse number="4" style="v" sid="EXO 40:4" />अऊर मेज ख अन्दर लिजाय क जो कुछ ओको पर सजानो हय ओख सजाय देजो; तब दीवट ख अन्दर लिजाय क ओको दीयावों ख जलाय देजो। <verse eid="EXO 40:4" /><verse number="5" style="v" sid="EXO 40:5" />अऊर गवाही चिट्ठी को सन्दूक को आगु सोनो की वेदी ख, जो धूप लायी हय ओख रखजो, अऊर निवास को दरवाजा को परदा ख लगाय देजो। <verse eid="EXO 40:5" /><verse number="6" style="v" sid="EXO 40:6" />अऊर तय मिलाप वालो तम्बू को निवास को फाटक को आगु होमबलि वेदी ख रखजो। <verse eid="EXO 40:6" /><verse number="7" style="v" sid="EXO 40:7" />अऊर मिलाप वालो तम्बू फिर वेदी को बीच गंगार ख रख क् उन्म पानी भर देजो। <verse eid="EXO 40:7" /><verse number="8" style="v" sid="EXO 40:8" />अऊर तय चारयी तरफ आंगन बाड़ा बान्ध क आंगन को फाटक पर परदा लटकाय देजो। <verse eid="EXO 40:8" /><verse number="9" style="v" sid="EXO 40:9" />तब तय अभिषेक को तेल ले क निवास जागा अऊर जो कुछ ओको म हय, सब को अभिषेक करजो अऊर ओख अऊर ओकी पूरी चिजे ख पवित्र करजो; तब वा पवित्र होय जायेंन। <verse eid="EXO 40:9" /><verse number="10" style="v" sid="EXO 40:10" />अऊर तय होमबलि वेदी अऊर ओकी सब चिजे ख अभिषेक कर क् वेदी ख अर्पन करजो; तब वेदी परम पवित्र होय जायेंन। <verse eid="EXO 40:10" /><verse number="11" style="v" sid="EXO 40:11" />अऊर तय पाय समेत गंगार ख भी अभिषेक कर क् ओख पवित्र करजो। <verse eid="EXO 40:11" /><verse number="12" style="v" sid="EXO 40:12" />तब तय हारून अऊर ओको टुरावों ख मिलाप वालो तम्बू को फाटक पर लिजाय क पानी सी नहलाजो, <verse eid="EXO 40:12" /><verse number="13" style="v" sid="EXO 40:13" />अऊर तय हारून ख पवित्र कपड़ा पहिनाजो, अऊर ओको अभिषेक कर क् ओख अर्पन करजो, ताकि ऊ मोरो लायी याजक होय क मोरी सेवा काम करेंन। <verse eid="EXO 40:13" /><verse number="14" style="v" sid="EXO 40:14" />अऊर तय ओको टुरावों ख भी लायजो अऊर उन्ख कुरता पहिनाजो। <verse eid="EXO 40:14" /><verse number="15" style="v" sid="EXO 40:15" />अऊर तय उन्को वसोच संस्कार करजो जसो उन्को बाप को संस्कार करयो होतो, कि हि मोरो लायी याजकीय सेवा काम कर सके; अऊर उन्को अभिषेक उन्की पीढ़ी सी पीढ़ी लायी हमेशा लायी याजक बन्यो रहेंन।”<verse eid="EXO 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EXO 40:16" />मूसा न असोच करयो, जो आज्ञा परमेश्वर न उन्ख दी होती, ओको अनुसार उन्न सब काम करयो। <verse eid="EXO 40:16" /><verse number="17" style="v" sid="EXO 40:17" />अऊर दूसरो साल को पहिलो महीना को पहिलो दिन को निवास ख खड़ो करयो गयो। <verse eid="EXO 40:17" /><verse number="18" style="v" sid="EXO 40:18" />मूसा न निवास ख खड़ो करयो, तब पाया पर तक्ता रख क उन्म बेंड़ा डाल्यो, अऊर ओको खम्बों ख खड़ो करयो; <verse eid="EXO 40:18" /><verse number="19" style="v" sid="EXO 40:19" />अऊर ओन निवास को ऊपर तम्बू ख फैलायो, अऊर तम्बू को ऊपर ओन ओढ़ना ख लगायो; जो तरह परमेश्वर न मूसा ख आज्ञा दी होतो। <verse eid="EXO 40:19" /><verse number="20" style="v" sid="EXO 40:20" />अऊर ओन गवाही चिट्ठी ख ले क सन्दूक म रख्यो, अऊर सन्दूक म डन्डा ख लगाय क ओको ऊपर प्रायश्चित को ढक्कन ख सन्दूक को ऊपर रख दियो; <verse eid="EXO 40:20" /><verse number="21" style="v" sid="EXO 40:21" />अऊर मूसा न सन्दूक ख पवित्र जागा म रखवायो, अऊर बीच वालो परदा ख लटकाय दियो अऊर गवाही चिट्ठी ख सन्दूक ख अन्दर परदा की आड़ म करयो; जसो परमेश्वर न मूसा ख आज्ञा दी होतो। <verse eid="EXO 40:21" /><verse number="22" style="v" sid="EXO 40:22" />तब मूसा न मिलाप वालो तम्बू म निवास को उत्तर दिशा म बीच को परदा को बाहेर मेज लगवायो, <verse eid="EXO 40:22" /><verse number="23" style="v" sid="EXO 40:23" />उन्न ओको पर परमेश्वर को जवर रोटी सजाय क रखी; जसी परमेश्वर न मूसा ख आज्ञा दी होतो। <verse eid="EXO 40:23" /><verse number="24" style="v" sid="EXO 40:24" />अऊर मूसा न मिलाप वालो तम्बू म मेज को आगु निवास को दक्षिन दिशा म दीवट ख रख दियो, <verse eid="EXO 40:24" /><verse number="25" style="v" sid="EXO 40:25" />अऊर ओन दीयावों ख परमेश्वर को आगु जलाय दियो; जो तरह परमेश्वर न मूसा ख आज्ञा दी होतो। <verse eid="EXO 40:25" /><verse number="26" style="v" sid="EXO 40:26" />तब मूसा न मिलाप वालो तम्बू को अन्दर बीच को परदा को आगु सोनो की वेदी ख रख्यो, <verse eid="EXO 40:26" /><verse number="27" style="v" sid="EXO 40:27" />अऊर ओन ओको पर सुगन्धित धूप जलायो; जो तरह परमेश्वर न मूसा ख आज्ञा दी होती। <verse eid="EXO 40:27" /><verse number="28" style="v" sid="EXO 40:28" />अऊर ओन निवास को दरवाजा पर परदा ख लगायो। <verse eid="EXO 40:28" /><verse number="29" style="v" sid="EXO 40:29" />अऊर मिलाप वालो तम्बू को निवास को दरवाजा पर होमबलि वेदी ख रख क ओको पर होमबलि अऊर अन्नबलि ख चढ़ायो; जो तरह परमेश्वर न मूसा ख आज्ञा दी होती। <verse eid="EXO 40:29" /><verse number="30" style="v" sid="EXO 40:30" />अऊर मूसा न मिलाप वालो तम्बू अऊर वेदी को बीच म गंगार ख रख क ओको म धोवन लायी पानी भर दियो, <verse eid="EXO 40:30" /><verse number="31" style="v" sid="EXO 40:31" />अऊर मूसा अऊर हारून अऊर ओको टुरावों न ओको म अपनो अपनो हाथ पाय धोवत होतो; <verse eid="EXO 40:31" /><verse number="32" style="v" sid="EXO 40:32" />अऊर जब जब हि मिलाप वालो तम्बू म यां वेदी को जवर जात होतो तब तब हि हाथ पाय धोय क जात होतो; जो तरह परमेश्वर न मूसा ख आज्ञा दी होती। <verse eid="EXO 40:32" /><verse number="33" style="v" sid="EXO 40:33" />अऊर मूसा न मिलाप वालो तम्बू अऊर वेदी को चारयी तरफ आंगन ख घेरा लगाय क अऊर आंगन को फाटक पर परदा लटकाय दियो। येकोलायी ओन पूरो काम खतम कर दियो।<verse eid="EXO 40:33" /></para>
  <para style="s">मिलाप वालो तम्बू पर बादर</para>
  <para style="r">(<ref loc="NUM 9:15-23">गिनती ९:१५-२३</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="EXO 40:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">40:34 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 8:10">१ राजा ८:१०</ref>,<ref loc="1KI 8:11">११</ref>; <ref loc="ISA 6:4">यशायाह ६:४</ref>; <ref loc="EZK 43:4">यहेजकेल ४३:४</ref>,<ref loc="EZK 43:5">५</ref>; <ref loc="REV 15:8">प्रकाशितवाक्य १५:८</ref></char>
    </note>तब बादर मिलाप वालो तम्बू पर छाय गयो, अऊर परमेश्वर को तेज निवास-जागा म भर गयो। <verse eid="EXO 40:34" /><verse number="35" style="v" sid="EXO 40:35" />अऊर बादर मिलाप वालो तम्बू पर रूक गयो, अऊर परमेश्वर को तेज निवास-जागा म भर गयो, यो वजह मूसा ओको म सिर नहीं सक्यो। <verse eid="EXO 40:35" /><verse number="36" style="v" sid="EXO 40:36" />अऊर उन्की पूरी यात्रा म जब जब ऊ बादर मिलाप वालो तम्बू को ऊपर सी उठ जात होतो, तब तब इस्राएली आगु सी निकल जात होतो; <verse eid="EXO 40:36" /><verse number="37" style="v" sid="EXO 40:37" />पर यदि बादर नहीं उठत होतो, त हि ऊ दिन तक निकलत नहीं होतो जब तक बादर वहां सी उठत नहीं होतो। <verse eid="EXO 40:37" /><verse number="38" style="v" sid="EXO 40:38" />कहालीकि उन्की पूरी यात्रा म परमेश्वर दिन म मिलाप वालो तम्बू पर रूक्यो रहत होतो, अऊर रात म इस्राएली लोगों ख ओको म आगी दिखायी देत होती।<verse eid="EXO 40:38" /></para>
  <chapter eid="EXO 40" />
</usx>