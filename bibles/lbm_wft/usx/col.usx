<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Lodhi</book>
  <para style="h">कुलुस्सियों</para>
  <para style="toc3">कुलुस्सियों</para>
  <para style="toc2">कुलुस्सियों</para>
  <para style="toc1">कुलुस्सियों को नाम पौलुस प्रेरित की चिट्ठी</para>
  <para style="mt2">कुलुस्सियों के नाम पौलुस प्रेरित की पत्री</para>
  <para style="mt1">कुलुस्सियों को नाम पौलुस प्रेरित की चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">कुलुस्सियों की चिट्ठी प्रेरित को <char style="xt"><ref loc="COL 1:1">१:१</ref></char> द्वारा मण्डली ख लिखी गयी होती। ओन या चिट्ठी तब लिख्यो होतो जब ऊ जेल म होतो, शायद रोम म, मसीह को जनम को लगभग ६० साल को बाद। कुलुस्सियों, इफिसियों अऊर फिलेमोन या चिट्ठी पौलुस न जेल म रहतो हुयो लिखी होती येकोलायी येख जेल चिट्ठी कह्यो जावय हय।</para>
  <para style="ip">ओन या चिट्ठी कुलुस्से शहर म मण्डली ख लिख्यो होतो। पौलुस न कुलुस्से म मण्डली सुरू नहीं करी; कहालीकि उन्न <char style="xt"><ref loc="COL 2:1">२:१</ref></char> म उल्लेख करयो हय, पर येकोलायी कुछ जिम्मेदारी महसुस करी होती। यो सम्भव हय कि इपफ्रासन मण्डली की स्थापना करी कहालीकि हि कुलुस्से सी होतो। पौलुस कुलुस्से की मण्डली म कुछ गलत शिक्षावों सी सम्बन्धित होतो। उन्न ओको बारे म चिट्ठी लिखन म बहुत खर्च करयो, होय सकय हय कि यहूदी मसीहियों को एक झुण्ड रह्यो होना, जो पूरानो नियम सी यहूदी नियमों को पालन करन लायी दूसरों मसीही भाऊवों ख मजबूर करन कि कोशिश कर रह्यो होतो, विशेष रूप सी खतना। पौलुस विशेष रूप सी लिखय हय कि मसीह ख परमेश्वर <char style="xt"><ref loc="COL 1:15-20">१:१५-२०</ref></char> को द्वारा स्वीकार करयो जान को अलावा मसीह को अलावा कुछ नहीं यां कोयी दूसरों की जरूरत हय अऊर मानव तर्क पर आधारित शिक्षाये बेकार हय। <char style="xt"><ref loc="COL 2:8">२:८</ref></char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पौलुस न कुलुस्सियों म मण्डली ख नमस्कार कर क् चिट्ठी सुरू करी। <char style="ior"><ref loc="COL 1:1-2">१:१-२</ref> </char></para>
  <para style="io1">२. फिर ऊ मसीह की महानता को बारे म लिखय हय विशेष रूप सी कुलुस्सियों म झूठी शिक्षा को जवाब म। <char style="ior"><ref loc="COL 1:3-3:4">१:३–३:४</ref></char></para>
  <para style="io1">३. पौलुस को कुछ चिट्ठी म, ऊ चिट्ठी को उत्तरार्ध ख व्यक्त करय हय, जो अच्छो मसीही जीवन जीन लायी कुछ विशिष्ट निर्देश देवय हय। <char style="ior"><ref loc="COL 3:5-4:6">३:५–४:६</ref></char></para>
  <para style="io1">४. पौलुस दूसरी मण्डलियों म जोर सी पड़्यो जान वाली चिट्ठी को लायी शुभकामनायें अऊर निर्देश देवय हय। <char style="ior"><ref loc="COL 4:7-18">४:७-१८</ref></char></para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />पौलुस को तरफ सी जो परमेश्वर की इच्छा सी मसीह यीशु को प्रेरित हय, अऊर भाऊ तीमुथियुस की तरफ सी, <verse eid="COL 1:1" /><verse number="2" style="v" sid="COL 1:2" />कुलुस्सियों म रहन वालो विश्वास लायक भाऊवों ख जो मसीह म एक हय।</para>
  <para style="p" vid="COL 1:2">हमरो बाप परमेश्वर को तरफ सी तुम्ख अनुग्रह अऊर शान्ति प्राप्त होती रहे।<verse eid="COL 1:2" /></para>
  <para style="s">धन्यवाद की प्रार्थना</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />जब हम तुम्हरो लायी हमेशा प्रार्थना करजे हय, अपनो प्रभु यीशु मसीह को बाप यानेकि परमेश्वर को धन्यवाद करजे हंय। <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />कहालीकि हम न मसीह यीशु पर तुम्हरो विश्वास तथा सब परमेश्वर को लोगों को प्रती तुम्हरो प्रेम को बारे म सुन्यो हय। <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />जब सच्चो सन्देश, सुसमाचार, पहिलो बार तुम्हरो जवर आयो, त तुम न या आशा को बारे म सुन्यो कि यो प्रदान करय हय। येकोलायी तुम्हरो विश्वास अऊर प्रेम ऊ चिज पर आधारित हय, जेकी तुम उम्मीद करय हय, जो तुम्हरो लायी स्वर्ग म सुरक्षित रखी हुयी हय। <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />सुसमाचार आशीर्वाद लाय रह्यो हय अऊर पूरो जगत म फैलतो जाय रह्यो हय, ठीक वसोच जसो तुम्हरो बीच म ऊ दिन सी हय जब तुम न पहिलो बार परमेश्वर कि कृपा को बारे म सुन्यो, अऊर ओख यो मालूम भयो कि यो वास्तव म हय। <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" /><note caller="+" style="x"><char style="xo" closed="false">१:७ </char><char style="xt" closed="false"><ref loc="COL 4:12">कुलुस्सियों ४:१२</ref>; <ref loc="PHM 1:23">फिलेमोन १:२३</ref></char></note>परमेश्वर को अनुग्रह ख तुम न हमरो प्रिय सहकर्मी सेवक इपफ्रास सी सिख्यो, जो हमरो तरफ सी मसीह को विश्वास लायक सेवक आय। <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />ओनच हम्ख ऊ प्रेम को बारे म बतायो हय जो आत्मा न तुम्ख दियो हय।<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />यो वजह जब सी हम न तुम्हरो बारे म सुन्यो हय तब सी हम न तुम्हरो लायी हमेशा प्रार्थना करी हय। परमेश्वर सी हम न प्रार्थना करी कि ऊ पूरी बुद्धी अऊर समझ जो ओकी आत्मा देवय हय ओको संग ओकी इच्छा को ज्ञान सी तुम्ख भर दे। <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />ताकि तुम्हरो चाल–चलन प्रभु को लायक हो, अऊर ऊ सब तरह सी प्रसन्न हो, अऊर तुम्हरो जीवन को द्वारा हर तरह को अच्छो कार्य ख प्रगट कर सको, अऊर तुम परमेश्वर को ज्ञान म बढ़तो जावो, <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />ओकी महिमामय शक्ति सी जो सामर्थ हासिल होवय हय ओको म बलवन्त होतो जावो, ताकि तुम धीरज को संग सब कुछ सहन को लायक बनो। अऊर खुशी को संग बाप को धन्यवाद करो। <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />अऊर जेन तुम्ख यो लायक बनायो कि परमेश्वर पिता को उन लोगों को संग जो ओन उन्को लायी पहिले सीच सुरक्षित करयो गयो प्रकाश को राज्य म तुम उत्तराधिकार पावन म सहभागी बन सको। <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />अऊर ओन हम्ख अन्धारो कि शक्ति सी छुड़ायो अऊर ओको प्रिय बेटा को राज्य म हम्ख सुरक्षित लायो। <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" /><note caller="+" style="x"><char style="xo" closed="false">१:१४ </char><char style="xt" closed="false"><ref loc="EPH 1:7">इफिसियों १:७</ref></char></note>अऊर ओको द्वारा हमरो छुटकारा करयो गयो मतलब हम्ख हमरो पापों की माफी मिली।<verse eid="COL 1:14" /></para>
  <para style="s">मसीह कार्य अऊर व्यक्तित्व</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />मसीह अदृश्य परमेश्वर की दृश्य वाली समानता आय। अऊर वा सब बनायी हुयी निर्मिती म पैदा भयो पहिलो बेटा आय। <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />परमेश्वर न अपनो द्वारा स्वर्ग अऊर धरती पर सब कुछ बनायो, आध्यात्मिक शक्तियों, प्रभुवों, शासकों, अऊर अधिकारियों सहित देख्यो अऊर दिखायी देन वाली अऊर नहीं दिखायी देन वाली चिजे। परमेश्वर न ओको द्वारा अऊर ओको लायी पूरो ब्रम्हांड ख निर्मान करयो। <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />पूरी चिजों को पहिले मसीह अस्तित्व म होतो, अऊर ओकी एकता म पूरी चिजे अपनी सही जागा पर स्थिर रह्य हंय। <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" /><note caller="+" style="x"><char style="xo" closed="false">१:१८ </char><char style="xt" closed="false"><ref loc="EPH 1:22">इफिसियों १:२२</ref>,<ref loc="EPH 1:23">२३</ref></char></note>उच शरीर, मतलब मण्डली को मुंड आय; उच आदि आय, अऊर मरयो हुयो म सी जीन्दो होन वालो म पहिलो आय कि सब बातों म पहिली जागा ओखच मिले। <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />कहालीकि यो परमेश्वर को खुद को फैसला सी होतो कि पूरी परिपूर्णता ओको म वाश करे। <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" /><note caller="+" style="x"><char style="xo" closed="false">१:२० </char><char style="xt" closed="false"><ref loc="EPH 2:16">इफिसियों २:१६</ref></char></note>टुरा को माध्यम सी, परमेश्वर न पूरो ब्रम्हांड ख अपनो आप वापस लावन को फैसला करयो। परमेश्वर न क्रूस पर अपनो टुरा को खून को माध्यम सी शान्ति बनायी अऊर येकोलायी धरती पर अऊर स्वर्ग म, पूरी चिजों ख वापस लायो।<verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />एक समय होतो जब तुम परमेश्वर सी दूर होतो अऊर बुरो कामों अऊर बिचार सी परमेश्वर को दुश्मन होतो <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />पर अब ओन अपनो बेटा की शारीरिक शरीर म मृत्यु को द्वारा तुम्ख अपनो संगी बनायो हय, ताकि तुम्ख अपनो सम्मुख पवित्र अऊर शुद्ध, अऊर निर्दोष बनाय क उपस्थित करे। <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />यदि तुम विश्वास को पायवा पर मजबूत बन्यो रहो अऊर ऊ सुसमाचार की आशा ख जेक तुम न सुन्यो हय मत छोड़ो, जेको प्रचार आसमान को खल्लो की पूरी सृष्टि म करयो गयो, अऊर जेको मय, पौलुस, सेवक बन्यो।<verse eid="COL 1:23" /></para>
  <para style="s">पौलुस को मण्डली म सेवक को कार्य</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />अब मय उन दु:खों को वजह खुशी करू हय, जो तुम्हरो लायी उठाऊ हय अऊर मसीह की कठिनायी की कमी ओको शरीर लायी, मतलब मण्डली लायी, अपनो शरीर म पूरी करू हय; <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />अऊर मय परमेश्वर को द्वारा मण्डली को सेवक बनायो गयो हय, जेन मोख तुम्हरी भलायी करन लायी यो काम दियो। अऊर यो कार्यभार पूरी रीति सी ओको सन्देशो की घोषना करय हय। <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />यो सन्देश रहस्यपुर्न सच हय जो आदि काल सी पूरो आदमी सी गुप्त रख्यो गयो, पर ओको उन पवित्र लोगों पर प्रगट करयो गयो हय। <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />परमेश्वर की या योजना होती कि गैरयहूदी लोगों पर यो रहस्य न प्रगट करे, यो रहस्य कितनो महिमामय बहुमूल्य हय जो अपनो लोगों लायी हय। अऊर यो रहस्य हय कि मसीह तुम म हय, मतलब परमेश्वर की महिमा की आशा होय सकय हय। <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />येकोलायी हम मसीह को प्रचार सब ख करजे हय। अऊर जो हम्ख बुद्धी हासिल हय ऊ पूरी बुद्धी को उपयोग करतो हुयो हम हर कोयी ख निर्देश अऊर शिक्षा प्रदान करजे हय ताकी हम उन्ख मसीह म एक व्यक्तिगत परिपूर्ण व्यक्ति बनाय क परमेश्वर को सामने मौजूद कर सके। <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />अऊर पूरो करन लायी मसीह की वा सामर्थ जो मोख मिलती रह्य हय अऊर जो मोरो म काम करय हय, ओको इस्तेमाल करतो हुयो मय कठोर मेहनत अऊर संघर्ष करू हय।<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />मय चाहऊ हय कि तुम्ख या बात को पता चल जाये कि मय तुम्हरो लायी अऊर लौदीकिया म रहन वालो लोगों को लायी अऊर उन सब लायी जो व्यक्तिगत तौर पर मोख कभी नहीं मिल्यो मय कितनो कठोर मेहनत करू हय। <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />उन्को मनों म प्रोत्साहन मिले अऊर परस्पर प्रेम म एकजुट होय जाये, तथा ऊ पूरो विश्वास को धन जो सच्चो समझ सी प्राप्त होवय हय उन्ख मिल जाये। यो तरह उन्ख परमेश्वर को रहस्य पता चल जायेंन, जो मसीह खुद हय। <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />जेको म परमेश्वर की बुद्धि को भण्डार अऊर ज्ञान लूक्यो हुयो हंय।<verse eid="COL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4" />यो मय येकोलायी कहू हय कि कोयी आदमी तुम्ख झूठो तरीका सी धोका नहीं दे फिर चाहे हि कितनो भी अच्छो कहाली नहीं लगय। <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />भलोच मय शरीर को भाव सी तुम सी दूर हय, तब भी आत्मा भाव सी तुम्हरो जवर हय, अऊर तुम्हरो खुशी को जीवन ख अऊर तुम्हरो विश्वास की, जो मसीह म हय, दृढ़ता देख क खुश होऊ हय।<verse eid="COL 2:5" /></para>
  <para style="s">मसीह म जीवन की पूर्णता</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />येकोलायी जसो तुम न मसीह यीशु ख प्रभु कर क् स्वीकार कर लियो हय, वसोच ओकोच म एक बन्यो रहो। <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />अऊर ओकोच म जड़ी पकड़तो अऊर बढ़तो जावो; अऊर जसो तुम सिखायो गयो वसोच विश्वास म मजबूत होतो जावो, अऊर जादा सी जादा धन्यवादी बन्यो रहो।<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />सावधान रहो कि कोयी तुम्ख ऊ आदमी की बुद्धी ख धोका सी तुम्ख गुलाम नहीं बनाय ले, जो मानविय परम्परागत शिक्षा सी प्राप्त होत आयी हय अऊर ब्रम्हांड ख शासन करन वाली आत्मावों कि देन आय नहीं की मसीह की। <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />कहालीकि ओको म दैविक स्वभाव की पूरी परिपूर्णता हमेशा मसीह को शरीर म वाश करय हय, <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />अऊर तुम्ख ओकी एकता म पूरो जीवन दियो गयो हय। ऊ हर आध्यात्मिक शासकों अऊर अधिकारियों को मुखिया आय।<verse eid="COL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11" />मसीह कि एकता म तुम्हरो खतना करयो गयो होतो नहीं कि आदमियों को द्वारा करयो जान वालो खतना को संग, पर मसीह द्वारा करयो गयो खतना को संग, जेको म तुम्हरो पापों को सामर्थ सी मुक्त करयो जावय हय। <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" /><note caller="+" style="x"><char style="xo" closed="false">२:१२ </char><char style="xt" closed="false"><ref loc="ROM 6:4">रोमियों ६:४</ref></char></note>जब तुम न बपतिस्मा लियो होतो त तुम्ख मसीह को संग दफनायो गयो होतो, अऊर बपतिस्मा म तुम्हरो परमेश्वर की सक्रिय शक्ति म विश्वास को माध्यम सी मसीह को संग भी उठायो गयो होतो, जेन ओख मरयो हुयो म सी जीन्दो करयो। <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" /><note caller="+" style="x"><char style="xo" closed="false">२:१३ </char><char style="xt" closed="false"><ref loc="EPH 2:1-5">इफिसियों २:१-५</ref></char></note>एक समय तुम भी आत्मिकता म मरयो हुयो होतो कहालीकि तुम पापी अऊर गैरयहूदी अऊर बिना व्यवस्था को होतो। पर अब परमेश्वर न तुम्ख मसीह को संग जीवन म लायो हय। परमेश्वर न हमरो पूरो पापों ख माफ करयो हय; <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" /><note caller="+" style="x"><char style="xo" closed="false">२:१४ </char><char style="xt" closed="false"><ref loc="EPH 2:15">इफिसियों २:१५</ref></char></note>परमेश्वर न हमरो बुरो कामों को लेखा जोखा ख हमरो बीच म सी मिटाय दियो, जेको म उन विधियों को उल्लेख करयो होतो जो हमरो प्रतिकुल अऊर हमरो विरोध होतो, ओन ओख क्रूस पर खिल्ला सी ठोक क मिटाय दियो हय। <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />मसीह न क्रूस को द्वारा आध्यात्मिक शासकों को सामर्थ ख अऊर अधिकारियों ख शासन विहिन कर दियो अऊर अपनो विजय अभियान म बन्दियों को रूप म उन्ख लोगों को सामने खुलेआम तमाशा बनायो।<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१६ </char>
      <char style="xt" closed="false">
        <ref loc="ROM 14:1-6">रोमियों १४:१-६</ref>
      </char>
    </note>येकोलायी कोयी भी व्यक्ति अपनो खानो पीनो यां पवित्र दिनो यां नयो चन्दा को त्यौहार, यां आराम को दिन को बारे म तुम्हरो कोयी न्याय नहीं करेंन। <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />कहालीकि यो सब आवन वाली बातों की छाव हंय, वास्तविकता मसीह हंय। <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />कोयी भी आदमी द्वारा अपनी निन्दा करी जान की अनुमति नहीं दे जो विशेष दर्शन को वजह श्रेष्ठ होन को दावा करय हय अऊर जो झूठी विनम्रता अऊर स्वर्गदूतों की पूजा पर जोर देवय हय। कोयी भी वजह सी, असो लोग अपनी मानविय सोच सी सब ख प्रभावित करय हंय, <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" /><note caller="+" style="x"><char style="xo" closed="false">२:१९ </char><char style="xt" closed="false"><ref loc="EPH 4:16">इफिसियों ४:१६</ref></char></note>अऊर मसीह ख पकड़्यो रहनो छोड़ दियो हय, ऊ मसीह जो शरीर को मुंड आय। मसीह को अधिनता म पूरो शरीर हय जो जोड़ो अऊर नशो सी एक संग जुड़्यो हुयो हय, अऊर परमेश्वर जसो बढ़ानो चाहवय हंय वसो बढ़तो जावय हय।<verse eid="COL 2:19" /></para>
  <para style="s">मसीह को संग मरनो अऊर जीनो</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />कहालीकि तुम मसीह को संग मर चुक्यो हय, अऊर ब्रम्हांड कि शासन करन वाली आत्मावों सी मुक्त करयो गयो हय। त फिर कहाली उन्को जसो जो जगत को हंय जीवन बितावय हय? तुम असी विधियों को वश म कहाली रह्य हय <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />कि “येख मत छूयजो,” येको स्वाद मत ले, “अऊर ओख हाथ मत लगायजो?” <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />या सब बाते इन सब चिजों ख सन्दर्भित करय हंय जो उपयोग करयो जानो को बाद बेकार होय जावय हंय; कहालीकि यो आदमियों की नियम अऊर शिक्षावों को अनुसार हंय। <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />निश्चितच यो तरह को पूरो नियम स्वर्गदूतों की मजबूती को संग आराधना की बुद्धी अऊर झूठी विनम्रता, अऊर शरीर को गंभीर उपचारों पर आधारित हय, पर शारीरिक लालसावों ख रोकन म येको सी कुछ भी फायदा नहीं होवय।<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />येकोलायी जब तुम मसीह को संग जीन्दो करयो गयो हंय, त येकोलायी अपनो दिल ख स्वर्ग की बातों पर लगावो, जित मसीह परमेश्वर को दायो तरफ अपनो सिंहासन पर विराजमान हय। <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />धरती पर की नहीं, पर स्वर्गीय चिजों पर अपनो मन लगावो। <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />कहालीकि तुम त मर गयो अऊर तुम्हरो जीवन मसीह को संग परमेश्वर म लूक्यो हुयो हय। <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />अपनो सच्चो जीवन मसीह हय, जब मसीह प्रगट होयेंन, तब तुम भी ओकी महिमा को संग प्रगट करयो जावो।<verse eid="COL 3:4" /></para>
  <para style="s">पुरानो अऊर नयो जीवन</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />येकोलायी अपनो सांसारिक इच्छावों ख मार डालो जो तुम म कार्य करय हंय, मतलब व्यभिचार, अशुद्धता, दुष्कामना, लालसा अऊर लोभ ख जो मूर्तिपूजा को रूप हय। <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />कहालीकि इन बातों को वजह जो ओकी आज्ञा नहीं मानय उन पर परमेश्वर को गुस्सा प्रगट होन जाय रह्यो हय। <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />अऊर एक समय होतो जब तुम भी, असी इच्छावों म जीवन बितावत होतो, अऊर तुम्हरो जीवन ओकोच प्रभुत्व म होतो।<verse eid="COL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8" />पर अब तुम भी इन सब बातों ख, मतलब गुस्सा, उत्तेजना, बैरभाव, निन्दा अऊर मुंह सी गालिया देनो यो सब बाते छोड़ देवो। <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" /><note caller="+" style="x"><char style="xo" closed="false">३:९ </char><char style="xt" closed="false"><ref loc="EPH 4:22">इफिसियों ४:२२</ref></char></note>कभी एक दूसरों सी झूठ मत बोलो, कहालीकि तुम लोगों न अपनो पुरानो स्वभाव ख ओको आदतो सहित छोड़ दियो हय <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" /><note caller="+" style="x"><char style="xo" closed="false">३:१० </char><char style="xt" closed="false"><ref loc="EPH 4:24">इफिसियों ४:२४</ref></char></note>अऊर एक नयो व्यक्तित्व ख धारन करयो हय। यो स्वभाव अपनो परमेश्वर सृजनहार को स्वरूप को अनुसार पूरो ज्ञान हासिल करन लायी हमेशा नयो बनतो जावय हय। <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />अऊर येको परिनाम यो हय कि उत यहूदी अऊर गैरयहूदी म कोयी अन्तर नहीं रह्य जावय हय, अऊर नहीं त कोयी खतना करयो हुयो अऊर खतनारहित म, अऊर नहीं कोयी सभ्य, नहीं स्कूती म, नहीं सेवक अऊर नहीं स्वतंत्र व्यक्ति म, पर मसीह सब कुछ अऊर सब विश्वासियों म ओको निवास हंय।<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१२ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:2">इफिसियों ४:२</ref>
      </char>
    </note>तुम परमेश्वर को पवित्र लोग आय; ओन तुम सी प्रेम करयो अऊर तुम्ख अपनो होन लायी तुम्ख चुन्यो गयो हय। त फिर सहानुभूति, दया, नम्रता, कोमलता अऊर धीरज धारन करो। <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" /><note caller="+" style="x"><char style="xo" closed="false">३:१३ </char><char style="xt" closed="false"><ref loc="EPH 4:32">इफिसियों ४:३२</ref></char></note>तुम लोग एक दूसरों ख सहन करो अऊर यदि कोयी ख कोयी सी शिकायत हय, त एक दूसरों को अपराध माफ करो। प्रभु न तुम लोगों को अपराध माफ करयो; वसोच तुम भी करो। <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />अऊर इन सब को अलावा प्रेम ख धारन करो, प्रेमच एक दूसरों ख आपस म बान्धय अऊर परिपूर्ण करय हय। <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />तुम्हरो लायी जान वालो निर्नयो पर मसीह सी हासिल होन वाली शान्ति को मार्गदर्शन रहे, येकोलायी परमेश्वर न तुम्ख एक संग शान्ति म एक शरीर होन लायी बुलायो हय, अऊर हमेशा धन्यवाद करतो रहो। <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" /><note caller="+" style="x"><char style="xo" closed="false">३:१६ </char><char style="xt" closed="false"><ref loc="EPH 5:19">इफिसियों ५:१९</ref>,<ref loc="EPH 5:20">२०</ref></char></note>अपनी पूरी सम्पनता को संग मसीह को सन्देश तुम्हरो दिल म वाश करे। अऊर अपनी पूरी बुद्धी सी एक दूसरों ख शिक्षा अऊर निर्देश देतो रहो। भजनों, स्तुति अऊर आत्मिक गीतो ख गातो हुयो अपनो आत्मा म परमेश्वर ख धन्यवाद देतो रहो। <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />जो कुछ तुम करो यां कहो सब प्रभु यीशु को नाम होना चाहिये, अऊर ओको द्वारा परमेश्वर पिता को धन्यवाद करो।<verse eid="COL 3:17" /></para>
  <para style="s">नयो जीवन म व्यक्तिगत नियम</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१८ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">इफिसियों ५:२२</ref>; <ref loc="1PE 3:1">१ पतरस ३:१</ref></char>
    </note>हे पत्नियों, जसो प्रभु म उचित हय, वसोच अपनो अपनो पति को अधीन रहो।<verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१९ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:25">इफिसियों ५:२५</ref>; <ref loc="1PE 3:7">१ पतरस ३:७</ref></char>
    </note>हे पतियों, अपनी अपनी पत्नी सी प्रेम रखो, अऊर उन्को सी कठोर व्यवहार मत करो।<verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:२० </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:1">इफिसियों ६:१</ref>
      </char>
    </note>हे बच्चां, सब बातों म अपनो अपनो माय–बाप की आज्ञा को हमेशा पालन करो, कहालीकि मसीहच अनुयायी को यो व्यवहार सी परमेश्वर खुश होवय हय।<verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:२१ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:4">इफिसियों ६:४</ref>
      </char>
    </note>हे माय बाप, अपनो बच्चावो ख तंग मत करो, कहीं असो नहीं होय कि उन्को साहस टूट जाये।<verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:२२ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:5-8">इफिसियों ६:५-८</ref>
      </char>
    </note>सेवकों सी मोरो अनुरोध यो हय कि जो शरीर को अनुसार तुम्हरो स्वामी हंय, सब बातों म उनकी आज्ञा को पालन करो, केवल आदमियों ख खुश करन लायी उच समय नहीं जब ऊ देख रह्यो होना, बल्की सच्चो मन सी उन्की मानो कहालीकि तुम प्रभु को आदर करय हय। <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />तुम लोग जो कुछ करय हय, अपनो पूरो दिल को संग करो, यो समझ क कि आदमियों लायी नहीं पर प्रभु लायी करय हय। <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />याद रखो कि तुम्ख प्रभु येको प्रतिफल देयेंन जो ओन अपनो लोगों लायी रख्यो हय। कहालीकि मसीह सच्चो स्वामी हय जेकी तुम सेवा करय हय। <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" /><note caller="+" style="x"><char style="xo" closed="false">३:२५ </char><char style="xt" closed="false"><ref loc="EPH 6:9">इफिसियों ६:९</ref></char></note>कहालीकि जो बुरो करय हय ऊ अपनी बुरायी को फर पायेंन, अऊर कहालीकि परमेश्वर कोयी को संग पक्षपात नहीं करय।<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:9">इफिसियों ६:९</ref>
      </char>
    </note>हे मालिकों, तुम अपनो सेवकों ख उन्को कामों को अनुसार उचित मोबदला उन्ख देवो। याद रखो कि स्वर्ग म तुम्हरो भी कोयी एक मालिक हय।<verse eid="COL 4:1" /></para>
  <para style="s">व्यावहारिक निर्देश</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />प्रार्थना म लग्यो रहो, अऊर परमेश्वर ख धन्यवाद देतो हुयो ओको म जागृत रहो। <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />अऊर येको संगच संग हमरो लायी भी प्रार्थना करतो रहो, परमेश्वर हमरो लायी मसीह को ऊ भेदो को सुसमाचार सुनावन लायी अच्छो मौका प्रदान करे जेको वजह मय कैद म हय। <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />प्रार्थना करो कि मय येख स्पष्टता को संग बताय सकू जसो मोख बतानो चाहिये।<verse eid="COL 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:५ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:16">इफिसियों ५:१६</ref>
      </char>
    </note>अवसर ख पूरो-पूरो उपयोग करो अऊर अविश्वासियों को संग बुद्धिमानी सी व्यवहार करो। <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />तुम्हरी बोली हमेशा पूरो अनुग्रह सी भरी अऊर लोगों ख पसंद आवन वाली हो ताकी तुम जान लेवो कि हर आदमी ख कसो उत्तर दे सकू।<verse eid="COL 4:6" /></para>
  <para style="s">आखरी अभिवादन</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:७ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">प्रेरितों २०:४</ref>; <ref loc="2TI 4:12">२ तीमुथियुस ४:१२</ref></char>
    </note>
    <note caller="+" style="x">
      <char style="xo" closed="false">४:७ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:21">इफिसियों ६:२१</ref>,<ref loc="EPH 6:22">२२</ref></char>
    </note>हमरो प्रिय भाऊ बहिन अऊर विश्वास लायक सेवक, तुखिकुस, जो प्रभु म मोरो सहकर्मी हय, मोरो पूरो समाचार तुम्ख बताय देयेंन। <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />ओख मय न येकोलायी तुम्हरो जवर भेज्यो हय कि तुम्ख हमरी दशा मालूम होय जाये अऊर ऊ तुम्हरो दिलो ख प्रोत्साहन दे। <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" /><note caller="+" style="x"><char style="xo" closed="false">४:९ </char><char style="xt" closed="false"><ref loc="PHM 1:10-12">फिलेमोन १:१०-१२</ref></char></note>ओको संग मय न उनेसिमुस ख भी भेज्यो हय जो विश्वास लायक अऊर प्रिय भाऊ अऊर तुम म सी एक हय। यो तुम्ख यहां की पूरी बाते बताय देयेंन।<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१० </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">प्रेरितों १९:२९</ref>; <ref loc="ACT 27:2">२७:२</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ACT 12:12">प्रेरितों १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref></char>
    </note>अरिस्तर्खुस, जो जेलखाना म मोरो संग कैदी हय, तथा बरनबास को भाऊ मरकुस को तुम्ख नमस्कार, मरकुस को बारे म तुम आज्ञा पा चुक्यो हय कि यदि ऊ तुम्हरो जवर आये त ओको स्वागत करजो। <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />यूस्तुस कहलावन वालो यीशु को भी तुम्ख नमस्कार पहुंचे। केवल तीनयी यहूदी विश्वासियों म परमेश्वर को राज्य लायी मोरो संग काम कर रह्यो हय। अऊर इन्की मोख बहुत मदत मिली हय।<verse eid="COL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१२ </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">कुलुस्सियों १:७</ref>; <ref loc="PHM 1:23">फिलेमोन १:२३</ref></char>
    </note>इपफ्रास, जो तुम म सी एक हय अऊर मसीह यीशु को सेवक हय, तुम्ख नमस्कार कह्य हय। अऊर हमेशा तुम्हरो लायी प्रार्थनावों म कोशिश करय हय, ताकि तुम सिद्ध होय क पूरो विश्वास को संग परमेश्वर की इच्छा पर स्थिर रहो। <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />मय व्यक्तिगत रूप सी ओको गवाह आय कि ऊ तुम्हरो लायी अऊर लौदीकिया अऊर हियरापुलिस वालो लायी कठिन मेहनत करतो रह्य हय। <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" /><note caller="+" style="x"><char style="xo" closed="false">४:१४ </char><char style="xt" closed="false"><ref loc="2TI 4:11">२ तीमुथियुस ४:११</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref>; </char><char style="xt" closed="false"><ref loc="2TI 4:10">२ तीमुथियुस ४:१०</ref>; <ref loc="PHM 1:24">फिलेमोन १:२४</ref></char></note>हमरो प्रिय डाक्टर लूका अऊर देमास तुम्ख नमस्कार भेजय हय।<verse eid="COL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15" />लौदीकिया को विश्वासियों ख, अऊर नुमफास अऊर उन्को घर की मण्डली ख नमस्कार कहजो। <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />जब या चिट्ठी तुम्हरो इत पढ़ लियो जायेंन त असो करजो कि लौदीकिया की मण्डली म भी पढ़्यो जाये। अऊर उच समय वा चिट्ठी जो लौदीकिया को विश्वासियों तुम्ख भेजेंन ओख तुम भी पढ़ो। <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" /><note caller="+" style="x"><char style="xo" closed="false">४:१७ </char><char style="xt" closed="false"><ref loc="PHM 1:2">फिलेमोन १:२</ref></char></note>अऊर अर्खिप्पुस सी कहो कि “जो सेवा प्रभु म तोख सौंपी गयी हय, ऊ ओख निश्चय को संग पूरो करे।”<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />मय पौलुस खुद अपनो हाथ सी तुम्ख प्रनाम लिख रह्यो हय। याद रहे कि मय जेलखाना म हय।</para>
  <para style="p" vid="COL 4:18">तुम पर परमेश्वर को अनुग्रह बन्यो रहे।<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>