<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Lodhi New Testament</book>
  <para style="h">मीका</para>
  <para style="toc3">मीका</para>
  <para style="toc2">मीका</para>
  <para style="toc1">मीका</para>
  <para style="mt2">मीका की किताब</para>
  <para style="mt1">मीका की किताब</para>
  <para style="imt">परिचय</para>
  <para style="ip">नीचे दी गयी किताब म मीका की भविष्यवानियां हय। मीका यहूदा को मोरेशेत नाम को नगर को निवासी होतो <char style="xt"><ref loc="MIC 1:1">१:१</ref></char> अऊर <char style="xt"><ref loc="JER 26:18">यिर्मयाह २६:१८</ref>।</char> ओन यहूदा को राजा योताम, आहाज अऊर हिजकिय्याह को शासनकाल म भविष्यवानी करी। येको मतलब हय कि ओको मंत्रालय लगभग ७५० ईसा पूर्व अऊर ७०० ईसा पूर्व को बीच होतो, जो लगभग उच समय होतो जब यशायाह अऊर होशे न भविष्यवानी करी होती। यो अज्ञात हय कि मीका न या भविष्यवानियां लिखी या ओको कोयी चेला न उन्को लायी लिखी। जो भी हो, यो मुमकिन हय कि या किताब ७०० ईसा पूर्व अऊर ६०८ ईसा पूर्व को बीच लिखी गयी हो कहालीकि येको उल्लेख यिर्मयाह की किताब म मिलय हय।</para>
  <para style="ip">मीका की भविष्यवानियां परमेश्वर को न्याय अऊर ओको उद्धार को बीच हर बार उलझती रह्य हंय। वा इस्राएल अऊर यहूदा पर गरीबों को संग बुरो बर्ताव अऊर लालच को आरोप लगावय हय <char style="xt"><ref loc="MIC 2:2">२:२</ref> ।</char> ऊ उन्को भविष्यवक्तावों पर भी भ्रष्ट होन को आरोप लगावय हय <char style="xt"><ref loc="MIC 2:6">२:६</ref> ।</char> येकोलायी, परमेश्वर उन्को नगरों ख नाश कर देयेंन <char style="xt"><ref loc="MIC 1:6">१:६</ref></char> अऊर <char style="xt"><ref loc="MIC 3:12">३:१२</ref> </char>अऊर उन्ख इस्राएल सी अऊर बाद म यहूदा सी भी बंदी बनाय क भेज देयेंन। लेकिन परमेश्वर अपनो वादा ख याद रखेंन अऊर कुछ विश्वासियों ख वापस लायेंन <char style="xt"><ref loc="MIC 4:6">४:६</ref> ।</char> मीका कि किताब अब्राहम अऊर याकूब सी करयो गयो परमेश्वर की वाचा को वादा की याद दिलातो हुयो खतम होवय हय। परमेश्वर को प्रेम अऊर दया ओको गुस्सा सी कहीं जादा शक्तिशाली हय।</para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. न्याय अऊर उद्धार को पहिलो भाग हय। <char style="ior"><ref loc="MIC 1:2">१:२</ref></char></para>
  <para style="io1">२. न्याय अऊर उद्धार को दूसरो भाग हय। <char style="ior"><ref loc="MIC 3:5">३:५</ref> </char></para>
  <para style="io1">३. न्याय अऊर उद्धार को तीसरो अऊर आखरी भाग हय। <char style="ior"><ref loc="MIC 6:7">६:७</ref> </char></para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="2KI 15:32">२ राजा १५:३२</ref>; <ref loc="2KI 16:20">१६:२०</ref> </char>
    </note>परमेश्वर को वचन, जो यहूदा को राजा योताम, आहाज अऊर हिजकिय्याह को शासन काल म मोरेशेतवासी मीका ख पहुंच्यो, जेख ओन सामरिया नगर अऊर यरूशलेम को बारे म पायो।<verse eid="MIC 1:1" /></para>
  <para style="s">सामरिया अऊर यरूशलेम लायी विलाप</para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 1:2" />हे राज्य राज्य को सब लोगो, सुनो! ओ धरती को जो कुछ तोरो म हय, ध्यान दे! प्रभु परमेश्वर तुम्हरो खिलाफ हय, पर परमेश्वर अपनो पवित्र मन्दिर म सी तुम्हरो पर गवाही दे। <verse eid="MIC 1:2" /><verse number="3" style="v" sid="MIC 1:3" />कहालीकि देख, परमेश्वर अपनो पवित्र जागा सी बाहेर निकल रह्यो हय, अऊर ऊ उतर क धरती की ऊंची जागा पर चलेंन। <verse eid="MIC 1:3" /><verse number="4" style="v" sid="MIC 1:4" />पहाड़ी ओको खल्लो सी गल जायेंन, अऊर घाटी असी फटेंन, जसो मोम आगी की आच सी, अऊर पानी जो घाट सी खल्लो बहय हय। <verse eid="MIC 1:4" /><verse number="5" style="v" sid="MIC 1:5" />यो सब याकूब को अपराध अऊर इस्राएल को घराना को पाप को कारण भयो हय। याकूब को अपराध का आय? का सामरिया नहीं? अऊर यहूदा की ऊंची जागा का आय? का यरूशलेम नहीं? <verse eid="MIC 1:5" /><verse number="6" style="v" sid="MIC 1:6" />योच वजह मय सामरिया ख मैदान म को ढेर बनाय देऊं, अऊर अंगूर को बगीचा बनाऊं; अऊर मय ओको गोटावों ख खायी म लुढ़काय देऊं, अऊर ओकी नींव उखाड़ देऊं। <verse eid="MIC 1:6" /><verse number="7" style="v" sid="MIC 1:7" />ओकी सब खोदी हुयी मूर्ती टुकड़ा टुकड़ा होय जायेंन; अऊर जो कुछ ओन व्यभिचार सी कमायो हय ऊ आगी सी भस्म करयो जायेंन, अऊर ओकी सब प्रतिमा ख मय चकनाचूर करूं; कहालीकि व्यभिचार कीच कमायी सी ओन ओख जमा करयो हय, अऊर फिर व्यभिचार कीच कमायी होय जायेंन। <verse eid="MIC 1:7" /><verse number="8" style="v" sid="MIC 1:8" />योच कारन मय छाती पीट क हाय, हाय, करूं; मय नंगा पाय अऊर बिना कपड़ा को चल्यो फिरयो करूं; मय गिधाड़ को जसो चिल्लाऊ, अऊर शुतुरमुर्ग को जसो रोऊं। <verse eid="MIC 1:8" /><verse number="9" style="v" sid="MIC 1:9" />कहालीकि ओको घाव कभी नहीं भर सकय, अऊर समस्या यहूदा पर भी आय पड़ी हय, पर ऊ मोरी जात भाऊवों क पकड़ क यरूशलेम को फाटक तक पहुंच गयो हय।<verse eid="MIC 1:9" /></para>
  <para style="s">दुश्मन को यरूशलेम को तरफ बढ़नो</para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 1:10" />गत नगर म येकी चर्चा मत करो, अऊर मत रोवो; पर <note caller="+" style="f"><char style="fr" closed="false">१:१० </char><char style="ft" closed="false">धूल को घर</char></note>बेतआप्रा की धूल म गरबड़्या मारो। <verse eid="MIC 1:10" /><verse number="11" style="v" sid="MIC 1:11" />हे शापीर नगर की रहन वाली नंगी अऊर बेसरम होय क चली जा; सानान नगर की रहन वाली नहीं निकल सकय; बेतेसेल को रोनो पीटनो को वजह ओकी रहन की जागा तुम सी ले लियो जायेंन। <verse eid="MIC 1:11" /><verse number="12" style="v" sid="MIC 1:12" />कहालीकि सारोत की रहन वाली त अच्छो समय की रस्ता देखत-देखत थक गयी हय, कहालीकि यहोवा को तरफ यरूशलेम की फाटक तक समस्या आय गयी हय। <verse eid="MIC 1:12" /><verse number="13" style="v" sid="MIC 1:13" />हे लाकीश की रहन वाली अपनो रथों म तेज चलन वालो घोड़ा जोत; तोरो सीच <note caller="+" style="f"><char style="fr" closed="false">१:१३ </char><char style="ft" closed="false">सिय्योन की टुरियां</char></note>सिय्योन की प्रजा को पाप की सुरूवात भयी, कहालीकि इस्राएल को अपराध तोरो मच पायो गयो। <verse eid="MIC 1:13" /><verse number="14" style="v" sid="MIC 1:14" />योच कारण तय गत मोरेशेत ख दान दे क दूर कर देजो; <note caller="+" style="f"><char style="fr" closed="false">१:१४ </char><char style="ft" closed="false">धोका</char></note>अकजीब को घर सी इस्राएल को राजा धोखाच खायेंन। <verse eid="MIC 1:14" /><verse number="15" style="v" sid="MIC 1:15" />हे मारेशा की रहन वाली मय तब तोरो पर एक अधिकारी ठहराऊं, अऊर इस्राएल को मुख्य लोगों ख अदुल्लाम की गुफा म आनो पड़ेंन। <verse eid="MIC 1:15" /><verse number="16" style="v" sid="MIC 1:16" />अपनो प्रिय टुरावों लायी दु:ख म अपनी मुंड को बाल मुंड़ा, अऊर गिधाड़ को जसो अपनी मुंड टकला कर ले, कहालीकि तुम्हरो बच्चा तुम्हरो जवर सी गुलाम होय क चली जायेंन।<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s">गरीबों पर अत्याचार करन वालो पर हाय</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 2:1" />हाय उन पर, जो बिस्तर पर पड़्यो हुयो बुरायी को बारे म सोचय अऊर बुरो कर्म की इच्छा करय हय, अऊर ताकतवर होनो को वजह भुन्सारो ख दिन निकलतोच हि ओख पूरो करय हय। <verse eid="MIC 2:1" /><verse number="2" style="v" sid="MIC 2:2" />हि खेत को लालच कर ख उन्ख छीन लेवय हय, अऊर घरों को लालच कर ख उन्ख भी ले लेवय हय, अऊर ओको घरानो सहित आदमी पर , अऊर ओको निज भाग समेत कोयी आदमी पर धोका अऊर अत्याचार करय हय। <verse eid="MIC 2:2" /><verse number="3" style="v" sid="MIC 2:3" />योच वजह, यहोवा यो कह्य हय : मय यो कुल पर असो संकट डालूं, जेको खल्लो सी तुम अपनी गर्दन हटाय नहीं सको, अऊर अपनी मुंडी ऊची कर ख नहीं चल सको; कहालीकि ऊ संकट को समय होयेंन। <verse eid="MIC 2:3" /><verse number="4" style="v" sid="MIC 2:4" />ऊ समय यो बहुत जादा शोक को गीत दृष्टान्त की रीति पर गायो जायेंन : “हमरो त सर्वनाश भय गयो; ऊ मोरो लोगों को भाग ख बिगाड़य हय, हाय, ऊ ओख मोरो सी कितनो दूर कर देवय हय! ऊ हमरो खेत धोका देन वालो को हाथ म दे देवय हय।” <verse eid="MIC 2:4" /><verse number="5" style="v" sid="MIC 2:5" />यहोवा की मण्डली म चिट्ठी डाल क अऊर रस्सी सी नाप क जमीन को बाटन वालो कोयी नहीं होयेंन, अऊर तुम्ख जमीन को तुकड़ा भी नहीं मिलेंन। <verse eid="MIC 2:5" /><verse number="6" style="v" sid="MIC 2:6" />उन्को भविष्यवक्ता कह्य हय, “भविष्यवानी मत करो! इन बातों को बारे म भविष्यवानी मत करो!” ताकि हम्ख कोयी अपमान सहनो नहीं पड़ेंन। <verse eid="MIC 2:6" /><verse number="7" style="v" sid="MIC 2:7" />हे याकूब को घरानो, का यो कह्यो जायेंन कि यहोवा की आत्मा म शान्ति नहाय? का यो काम ओकोच करयो हुयो आय? का मोरो वचनों सी ओको भला नहीं होतो जो सच्चायी सी चलय हय? <verse eid="MIC 2:7" /><verse number="8" style="v" sid="MIC 2:8" />पर कल की बात आय कि मोरी प्रजा दुश्मन बन क मोरो खिलाफ खड़ी हय : तुम शान्त अऊर भोलो-भालो रस्ता पर चलन वालो को शरीर पर सी चादर छीन लेवय हय जो लड़ायी को बिचार नहीं करतो हुयो बेधड़क चली जावय हय। <verse eid="MIC 2:8" /><verse number="9" style="v" sid="MIC 2:9" />मोरी प्रजा की बाईयों ख तुम उन्को सूख को घरों सी निकाल देवय हय; अऊर उन्को छोटो बच्चा सी तुम मोरी दी हुयी अच्छी चिजे हमेशा लायी छीन लेवय हय। <verse eid="MIC 2:9" /><verse number="10" style="v" sid="MIC 2:10" />उठो, चली जावो! कहालीकि यो तुम्हरो आराम करन की जागा नोहोय; येको वजह वा अशुद्धता आय जो कठिन दु:ख को संग तुम्हरो नाश करेंन। <verse eid="MIC 2:10" /><verse number="11" style="v" sid="MIC 2:11" />यदि कोयी झूठी आत्मा म चलतो हुयो झूठी अऊर व्यर्थ बातें कह्य हय अऊर कह्य कि मय तुम्ख हमेशा अंगूररस अऊर अंगूरीरस लायी प्रचार सुनातो रहूं, त उच इन लोगो को भविष्य बतान वालो ठहरेंन। <verse eid="MIC 2:11" /><verse number="12" style="v" sid="MIC 2:12" />हे याकूब, मय निश्चय तुम पूरो ख जमा करूं; मय इस्राएल को बच्यो हुयो ख निश्चय जमा करूं; अऊर बाड़ा की शेरी मेंढी को जसो एक संग रखूं। ऊ झुण्ड को जसो जो अच्छी चरायी म हय, हि बहुत सो आदमियों को मारे हल्ला मचायेंन। <verse eid="MIC 2:12" /><verse number="13" style="v" sid="MIC 2:13" />उन्को आगु आगु बाड़ा को तोड़न वालो गयो हय, येकोलायी हि भी ओख तोड़ रह्यो हंय, अऊर फाटक सी निकल क जाय रह्यो हय; उन्को राजा उन्को आगु आगु गयो मतलब यहोवा उन्ख रस्ता दिखान वालो आय।<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />मय न कह्यो; ओ याकूब को मुखिया, ओ इस्राएल को घरानो को न्याय करन वालो, सुनो! का न्याय को भेद जाननो तुम्हरो काम नोहोय? <verse eid="MIC 3:1" /><verse number="2" style="v" sid="MIC 3:2" />तुम त भलायी सी नफरत, अऊर बुरायी सी प्रेम रखय हय, मानो, तुम लोगो पर सी उन्की खाल उधड़ लेवय, अऊर उन्की हड्डियों पर सी उन्को मांस नोच लेवय हय; <verse eid="MIC 3:2" /><verse number="3" style="v" sid="MIC 3:3" />पर तुम मोरो लोगों को मांस खाय भी लेवय, अऊर उन्की खाल उधड़ भी डालय; तुम उन्की हड्डियों ख हांडी म पकान लायी तोड़ डालय अऊर उन्को मास हन्डा म पकान लायी टुकड़ा टुकड़ा करय हय। <verse eid="MIC 3:3" /><verse number="4" style="v" sid="MIC 3:4" />हि ऊ समय परमेश्वर की दोहायी देयेंन, पर ऊ उन्की नहीं सुनेंन, पर ऊ समय ऊ उन्को बुरो कामों को वजह उन सी मुंह मोड़ लेयेंन। <verse eid="MIC 3:4" /><verse number="5" style="v" sid="MIC 3:5" />यहोवा को यो वचन आय कि जो भविष्यवक्ता मोरी प्रजा ख भटकाय देवय हंय, अऊर जब उन्ख खान ख मिलय हय तब “शान्ति, शान्ति” कह्य हंय, अऊर यदि कोयी उन्को मुंह म कुछ नहीं देवय, त ओको खिलाफ लड़ायी करन ख तैयार होय जावय हय। <verse eid="MIC 3:5" /><verse number="6" style="v" sid="MIC 3:6" />योच वजह तुम पर असी रात आयेंन, कि तुम्ख दर्शन नहीं मिलेंन, अऊर तुम असो अन्धकार म पड़ो कि तुम भविष्य भी नहीं बताय सको। भविष्यवक्तावों लायी सूरज डूब जायेंन, अऊर दिन रहतो उन पर अन्धारो छाय जायेंन। <verse eid="MIC 3:6" /><verse number="7" style="v" sid="MIC 3:7" />दर्शन देखन वालो अपमानित होयेंन, अऊर भविष्य बतावन वालो को मुंह कारो होयेंन; अऊर हि सब को सब अपनो मुंह ख येकोलायी लूकाय देयेंन कि परमेश्वर को तरफ सी उत्तर नहीं मिलय। <verse eid="MIC 3:7" /><verse number="8" style="v" sid="MIC 3:8" />पर मय त यहोवा की आत्मा सी शक्ति, न्याय अऊर ताकत पा क परिपूर्ण हय कि मय याकूब ख ओको अपराध अऊर इस्राएल ख ओको पाप बताय सकूं। <verse eid="MIC 3:8" /><verse number="9" style="v" sid="MIC 3:9" />ओ याकूब को घरानो को मुखिया, ओ इस्राएल को घरानो को न्याय करन वालो, ओ न्याय सी नफरत करन वालो अऊर सब सीधी बातों को टेढ़ी–मेढ़ी करन वालो, या बात सुनो। <verse eid="MIC 3:9" /><verse number="10" style="v" sid="MIC 3:10" />तुम सिय्योन ख हत्या कर क् अऊर यरूशलेम ख अन्याय सी मजबूत करय हय। <verse eid="MIC 3:10" /><verse number="11" style="v" sid="MIC 3:11" />ओको मुखिया घूस ले क सोचय, अऊर याजक दाम ले क व्यवस्था देवय हंय, भविष्यवक्ता पैसा ले क भविष्य बतावय हंय; तब भी हि यो कह्य क यहोवा पर भरोसा रखय हय, “यहोवा हमरो बीच म हय, येकोलायी कोयी समस्या हम पर नहीं आयेंन।” <verse eid="MIC 3:11" /><verse number="12" style="v" sid="MIC 3:12" /><note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="JER 26:18">यिर्मयाह 26:18</ref></char></note>येकोलायी तुम्हरो वजह सिय्योन जोत क खेत बनायो जायेंन, अऊर यरूशलेम खण्डर को ढेर होय जायेंन, अऊर जो पहाड़ी पर भवन बन्यो हय, ऊ जंगल की ऊंची जागा को जसो होय जायेंन।<verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s">शान्ति को राज्य</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 2:2-4">यशायाह 2:2-4</ref>
      </char>
    </note>आखरी को दिनों म असो होयेंन कि यहोवा को भवन की पहाड़ी सब पहाड़ी पर मजबूत करी जायेंन, अऊर सब पहाड़ियों सी जादा ऊंचो करयो जायेंन; अऊर हर राज्य को लोग नदी को जसो ओको तरफ चलेंन, <verse eid="MIC 4:1" /><verse number="2" style="v" sid="MIC 4:2" />अऊर बहुत सो राज्यों को लोग जायेंन, अऊर आपस म कहेंन, “आवो, हम यहोवा की पहाड़ी पर चढ़ क, याकूब को परमेश्वर को भवन म जाबो; तब ऊ हम्ख अपनी रस्ता सिखायेंन, अऊर हम ओकी रस्ता पर चलबोंन।” कहालीकि परमेश्वर की व्यवस्था सिय्योन सी, अऊर ओको वचन यरूशलेम सी निकलेंन। <verse eid="MIC 4:2" /><verse number="3" style="v" sid="MIC 4:3" />ऊ बहुत सो देश को लोगों को न्याय करेंन, अऊर दूर दूर तक की शक्तिशाली राज्यों को झगड़ा ख मिटाय डालेंन; येकोलायी हि अपनी तलवार पीट क नांगर की फार अऊर अपनो भाला सी हसिया बनायेंन; तब एक राज्य दूसरो राज्य को खिलाफ तलवार दुबारा नहीं चलेंन; <verse eid="MIC 4:3" /><verse number="4" style="v" sid="MIC 4:4" /><note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="ZEC 3:10">जकर्याह 3:10</ref></char></note>अऊर लोग आगु ख लड़ायी की विद्या नहीं सीखेंन। पर हि अपनो अपनो अंगूर को बगीचा अऊर अंजीर को झाड़ को खल्लो बैठेंन, अऊर कोयी उन्ख नहीं डरायेंन; सेनावों को यहोवा न योच वचन दियो हय। <verse eid="MIC 4:4" /><verse number="5" style="v" sid="MIC 4:5" />सब राज्यों को लोग त अपनो अपनो देवता को नाम ले क चलय हय, पर हम लोग अपनो परमेश्वर यहोवा को नाम ले क हमेशा चलतो रह्यबो।<verse eid="MIC 4:5" /></para>
  <para style="s">गुलामी सी इस्राएल को छुटकारा</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 4:6" />यहोवा की याच वाणी आय, ऊ समय मय प्रजा को लंगड़ा ख, अऊर जबरदस्ती निकाल्यो हुयो क, अऊर जेक मय न दु:ख दियो उन्ख भी जमा करूं; <verse eid="MIC 4:6" /><verse number="7" style="v" sid="MIC 4:7" />अऊर लंगड़ा ख मय बचायो रखूं, अऊर दूर करयो हुयो ख एक सामर्थी राज्य कर देऊं; अऊर परमेश्वर उन पर सिय्योन पहाड़ी को ऊपर सी हमेशा राज्य करतो रहेंन। <verse eid="MIC 4:7" /><verse number="8" style="v" sid="MIC 4:8" />ओ एदेर को गुम्मट, ओ सिय्योन की पहाड़ी, तोख पहिले जसो शासन मिलतो रहेंन, तोख यरूशलेम को राज्य मिलेंन। <verse eid="MIC 4:8" /><verse number="9" style="v" sid="MIC 4:9" />अब तय कहाली चिल्लाय रही हय? का तोरो म कोयी राजा नहाय? का तोरो सलाहकार मर गयो, जेको वजह तय गर्भवती बाई को जसी पीड़ा सी तड़प रही हय? <verse eid="MIC 4:9" /><verse number="10" style="v" sid="MIC 4:10" />ओ सिय्योन की बेटी, गर्भवती बाई को जसी पीड़ा उठाय क पैदा कर; कहालीकि अब तय नगर म सी निकल क मैदान म बसजो, पर बेबीलोन तक जाजो; उतच तय छुड़ायी जाजो, मतलब उतच यहोवा तोख तोरो दुश्मनों को वश म सी छुड़ाय लेन। <verse eid="MIC 4:10" /><verse number="11" style="v" sid="MIC 4:11" />अब बहुत सो राज्य राज्य को लोग तोरो खिलाफ जमा होय क तोरो बारे म कहेंन, “सिय्योन अपवित्र करी जाये, अऊर हम अपनी आंखी सी ओको नाश होतो हुयो देखबो।” <verse eid="MIC 4:11" /><verse number="12" style="v" sid="MIC 4:12" />पर हि यहोवा की योजना नहीं जानय, न ओकी योजना समझय हंय, कि ऊ उन्ख असो जमा कर लेन जसो खरियान म बोझा जमा करय हय। <verse eid="MIC 4:12" /><verse number="13" style="v" sid="MIC 4:13" />ओ सिय्योन, उठ अऊर चुरना कर, मय तोरो सींगो ख लोहा को, अऊर तोरी खुरी ख पीतल की बनाय देऊं; अऊर तय बहुत सो राज्यों ख चकनाचूर करजो, अऊर उन्की कमायी यहोवा ख अऊर उन्की जायजाद धरती को प्रभु लायी दे देजों।<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 5:1" />हे यरूशलेम को लोगों, दल बांध-बांध क जमा हो, कहालीकि ओन हम लोगों ख घेर लियो हय; हि इस्राएल को न्यायी को गाल पर मारेंन।<verse eid="MIC 5:1" /></para>
  <para style="s">बैतलहम सी एक राजा को आन की वाचा</para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 5:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:2 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 2:6">मत्ती २:६</ref> </char>
    </note>ओ एप्राता को बैतलहम, यदि तय असो छोटो हय कि यहूदा को हजारों म गिन्यो नहीं जावय, तब भी तोरो म सी एक आदमी निकलेंन, जो इस्राएलियों म शासन करन वालो होयेंन; अऊर ओको निकलनो प्राचीन काल सी, पर पुरानो जमाना सी होतो आयो हय। <verse eid="MIC 5:2" /><verse number="3" style="v" sid="MIC 5:3" />योच वजह ऊ उन्ख ऊ समय तक ठुकरायो रहेंन, जब तक गर्भवती बच्चा पैदा नहीं करेंन; तब इस्राएलियों को जवर ओको बच्यो हुयो भाऊ लौट क उन्को सी मिल जायेंन। <verse eid="MIC 5:3" /><verse number="4" style="v" sid="MIC 5:4" />अऊर ऊ खड़ो होय क यहोवा की दी हुयी शक्ति सी, अऊर अपनो परमेश्वर यहोवा को नाम को प्रताप सी, उन्ख चरायेंन। हि सुरक्षित रहेंन, कहालीकि अब ऊ धरती को कोना तक महान ठहरेंन।<verse eid="MIC 5:4" /></para>
  <para style="s">छुटकारा अऊर दण्ड</para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 5:5" />ऊ शान्ति को मूल होयेंन। छुटकारा अऊर दण्ड जब अश्शूरी सेना हमरो देश पर चढ़ायी करेंन, अऊर हमरो राज भवन म पाय रखेंन, तब हम उन्को खिलाफ साथ चरवाहा बल्की आठ मुखिया आदमी खड़ो करबोंन; <verse eid="MIC 5:5" /><verse number="6" style="v" sid="MIC 5:6" /><note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="GEN 10:8-11">उत्पत्ति 10:8-11</ref></char></note>अऊर हि अश्शूर को देश पर सिरन की जागा तक निम्रोद को देश ख तलवार चलाय क मार डालेंन; अऊर जब अश्शूरी लोग हमरो देश म आयेंन, अऊर ओकी सरहद को अन्दर पाय रखेंन, तब उच आदमी हम्ख उन्को सी बचायेंन। <verse eid="MIC 5:6" /><verse number="7" style="v" sid="MIC 5:7" />तब याकूब को बच्यो हुयो लोग बहुत राज्य को बीच असो काम करायेंन, जसो यहोवा को तरफ सी पड़न वाली ओस, अऊर घास पर की बरसात, जो कोयी लायी नहीं रुकय अऊर आदमियों की बाट नहीं देखय। <verse eid="MIC 5:7" /><verse number="8" style="v" sid="MIC 5:8" />याकूब को बच्यो हुयो लोग राज्यों म अऊर देश देश को लोगों को बीच असो होयेंन जसो जंगली जनावर म शेर, या शेरी मेंढी को झुण्ड म जवान शेर होवय हय, कहालीकि जब ऊ उन्को बीच म सी जायेंन, त खूंदतो अऊर फाड़तो जायेंन, अऊर कोयी नहीं बच पायेंन। <verse eid="MIC 5:8" /><verse number="9" style="v" sid="MIC 5:9" />तोरो हाथ तोरो विरोधी पर पड़े अऊर तोरो सब दुश्मन नाश होय जाये। <verse eid="MIC 5:9" /><verse number="10" style="v" sid="MIC 5:10" />यहोवा की याच वाणी आय, ऊ समय मय तोरो घोड़ा ख तोरो बिच म सी नाश कर देऊं; अऊर तोरो रथों को सत्यानाश कर देऊं। <verse eid="MIC 5:10" /><verse number="11" style="v" sid="MIC 5:11" />मय तोरो देश को नगर ख भी नाश करूं, अऊर तोरो सब किला ख गिराय देऊं। <verse eid="MIC 5:11" /><verse number="12" style="v" sid="MIC 5:12" />मय तोरो तंत्र-मंत्र ख नाश करूं, अऊर तोरो यहां भविष्य की बात बतान वालो फिर जीन्दो नहीं रहेंन। <verse eid="MIC 5:12" /><verse number="13" style="v" sid="MIC 5:13" />मय तुम्हरी मूर्ती अऊर तुम्हरो बीच सी पूजा को गोटा ख नाश कर देऊं; अऊर तुम फिर कभी अपनो हाथ सी बनायी हुयी चिजों को आगु फिर कभी नहीं झुको। <verse eid="MIC 5:13" /><verse number="14" style="v" sid="MIC 5:14" />मय तोरो अशेरा नाम की मूर्ती ख तोरी जमीन म सी उखाड़ डालूं, अऊर तोरो नगर को विनाश करूं। <verse eid="MIC 5:14" /><verse number="15" style="v" sid="MIC 5:15" />अऊर जो राज्य आदेश को पालन नहीं करय हंय, उन्को सी मय भयंकर गुस्सा म बदला लेऊं।<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s">परमेश्वर को द्वारा इस्राएल को खिलाफ शिकायत</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />जो बात परमेश्वर कह्य हय, ओख सुनो : उठ क, पहाड़ी को आगु बातचीत कर, अऊर पहाड़ी भी तोरी बात सुनेंन। <verse eid="MIC 6:1" /><verse number="2" style="v" sid="MIC 6:2" />ओ पहाड़ो, अऊर हे धरती की अटल नींव, यहोवा की बहस सुनो, कहालीकि यहोवा ख अपनी प्रजा सी शिकायत हय, अऊर ऊ इस्राएल सी बात करय हय। <verse eid="MIC 6:2" /><verse number="3" style="v" sid="MIC 6:3" />“ओ मोरी प्रजा, मय न तोरो का बिगाड़्यो हय? मोख बता की कौन्सी बात म मय न तोख दु:ख दियो हय? <verse eid="MIC 6:3" /><verse number="4" style="v" sid="MIC 6:4" /><note caller="+" style="x"><char style="xo" closed="false">६:४ </char><char style="xt" closed="false"><ref loc="EXO 4:10-15">निर्गमन ४:१०-१५</ref>; <ref loc="EXO 12:50">१२:५०</ref>; <ref loc="EXO 15:20">१५:२०</ref></char></note> मय त तोख मिस्र देश सी निकाल क लायो हय, अऊर गुलामी को घर म सी तोख छुड़ाय क लायो; अऊर तोरी अगुवायी कर क मूसा, हारून अऊर मिर्याम ख भेज दियो। <verse eid="MIC 6:4" /><verse number="5" style="v" sid="MIC 6:5" /><note caller="+" style="x"><char style="xo" closed="false">६:५ </char><char style="xt" closed="false"><ref loc="NUM 22:2">गिनती २२:२</ref>; <ref loc="NUM 24:25">२४:२५</ref>; <ref loc="JOS 3:1">यहोशू ३:१</ref>; <ref loc="JOS 4:19">४:१९</ref></char></note>ओ मरी प्रजा, याद कर, कि मोआब को राजा बालाक न तोरो खिलाफ कौन्सी योजना बनायी, अऊर बोर को टुरा बिलाम न ओख का बतायो, अऊर शित्तीम सी गिलगाल तक की बातों ख याद कर, जेको सी तय यहोवा को अच्छो काम समझ सके।”<verse eid="MIC 6:5" /></para>
  <para style="s">परमेश्वर का चाहवय हय</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 6:6" />मय का ले क यहोवा को जवर आऊं, अऊर ऊपर रहन वालों परमेश्वर को आगु झुकूं? का मय होमबलि लायी एक साल को बछड़ा ले क ओको जवर आऊ? <verse eid="MIC 6:6" /><verse number="7" style="v" sid="MIC 6:7" />का यहोवा हजारों मेंढी सी, या जैतून तेल की लाखों नदियों सी खुश होयेंन? का मय अपनो अपराध को प्रायश्चित म अपनो पहिलौठा ख या अपनो पाप को बदला म अपनो पैदा करयो हुयो कोयी ख दे देऊं। <verse eid="MIC 6:7" /><verse number="8" style="v" sid="MIC 6:8" />ओ आदमी, ऊ तोख बताय चुक्यो हय कि अच्छो का हय; अऊर यहोवा तोख येख छोड़ अऊर का चाहवय हय, कि तय न्याय सी काम करे, अऊर कृपा सी प्रेम रखे, अऊर अपनो परमेश्वर को साथ नम्रता सी चले? <verse eid="MIC 6:8" /><verse number="9" style="v" sid="MIC 6:9" />यहोवा की वानी यरूशलेम नगर ख बुलाय रही हय, बुद्धिमान आदमी यहोवा को नाम को डर मानय हय : येकोलायी सजा की बातों पर ध्यान दे, जेको जवर दण्ड देन को अधिकार हय। <verse eid="MIC 6:9" /><verse number="10" style="v" sid="MIC 6:10" />का अब तक दुष्ट को घर म दुष्टता सी पायो हुयो धन अऊर छोटो नाप गलत नहाय? <verse eid="MIC 6:10" /><verse number="11" style="v" sid="MIC 6:11" />का मय कपट को तराजू अऊर अपनो झोला म झूठो बट रखन वालों ख बिना दण्ड दियो छोड़ देऊं? <verse eid="MIC 6:11" /><verse number="12" style="v" sid="MIC 6:12" />तोरो धनवान लोग अत्याचार करय हय, अऊर तोरो रहन वालो झूठ बोलय हय अऊर उन्की जीबली धोका देन वाली बात करय हय। <verse eid="MIC 6:12" /><verse number="13" style="v" sid="MIC 6:13" />योच वजह मय तोख मारतो मारतो बहुतच घायल करू हय, अऊर तोरो पापों को वजह तोख उजाड़ देऊं। <verse eid="MIC 6:13" /><verse number="14" style="v" sid="MIC 6:14" />तय खाजो, पर सन्तुष्ट नहीं होजो, तोरो पेट कभीच नहीं भरेंन; अऊर तय अपनी जायजाद ले क चलजो, पर बचाय नहीं सकजो, अऊर जो कुछ तय बचाय भी लेजो, ओख मय तलवार चलाय क लुटवाय देऊं। <verse eid="MIC 6:14" /><verse number="15" style="v" sid="MIC 6:15" />तय बोयजो, पर फसल नहीं काट सकजो; तय जैतून को तेल निकालजो, पर लगाय नहीं सकजो; अऊर अंगूर सी रस निकालजो, पर ओख पी नहीं सकजो। <verse eid="MIC 6:15" /><verse number="16" style="v" sid="MIC 6:16" /><note caller="+" style="x"><char style="xo" closed="false">६:१६ </char><char style="xt" closed="false"><ref loc="1KI 16:23-34">१ राजा १६:२३-३४</ref>; <ref loc="1KI 21:25-26">२१:२५-२६</ref></char></note>कहालीकि हि ओम्री की विधियों पर अऊर अहाब को घरानो को सब कामों पर चलय हय; अऊर तुम उन्की युक्तियों को अनुसार चलय हय; येकोलायी मय तोख उजाड़ देऊं, अऊर यो नगर को रहन वालो लोग तुम्हरी हसी उड़ायेंन, अऊर तुम मोरी प्रजा की निन्दा सहजो।<verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s">इस्राएल को आचरन को नाश</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 7:1" />हाय मोरो पर! कहालीकि मय ऊ आदमी को जसो भय गयो हय जो गरमी को समय को फर तोड़न पर, या रही हुयी अंगूर बिनन को समय को आखरी म आय गयो, मोख त पक्की अंजीरों की लालच होती, पर खान लायी कोयी गुच्छा नहीं बच्यो। <verse eid="MIC 7:1" /><verse number="2" style="v" sid="MIC 7:2" />भक्त लोग धरती पर सी नाश भय गयो हंय। अऊर आदमियों म एक भी जन सीधो नहीं रह्यो; हि सब को सब मारन लायी बाट देखय हय, अऊर जार लगाय क अपनो अपनो भाऊ ख मार डालय हय। <verse eid="MIC 7:2" /><verse number="3" style="v" sid="MIC 7:3" />हि अपनो दोयी हाथों सी मन लगाय क घूस मांगय, अऊर न्यायी घूस लेन ख तैयार रह्य हय, अऊर अमीर अपनो मन की दुष्टता की बातें करय हय; योच तरह सी सब मिल क योजना बनावय हय। <verse eid="MIC 7:3" /><verse number="4" style="v" sid="MIC 7:4" />उन्म सी जो उत्तम हय, ऊ काटा वाली झाड़ी को जसो दु:ख हय, जो सब सी सीधो हय, ऊ काटा वालो सी भी बुरो हय। तोरो बतान वालो को दिन मतलब तोरो सजा को दिन आय गयो हय। अब हि जल्दी घबराय जायेंन। <verse eid="MIC 7:4" /><verse number="5" style="v" sid="MIC 7:5" />संगी पर विश्वास मत करो, सच्चो संगी पर भी भरोसा मत रखो; पर अपनी प्यारी पत्नी सी भी सोच समझ क बोलो। <verse eid="MIC 7:5" /><verse number="6" style="v" sid="MIC 7:6" /><note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="MAT 10:35-36">मत्ती 10:35-36</ref>; <ref loc="LUK 12:55">लूका 12:55</ref></char></note>कहालीकि बेटा बाप को अपमान करय, अऊर बेटी माय को, अऊर बहू सासु को खिलाफ रह्य हय; आदमी को दुश्मन ओको घर कोच लोग रह्य हय। <verse eid="MIC 7:6" /><verse number="7" style="v" sid="MIC 7:7" />पर मय परमेश्वर को तरफ ताकतो रहूं, मय अपनो उद्धारकर्ता परमेश्वर की बाट देखतो रहूं; मोरो परमेश्वर मोरी सुनेंन।<verse eid="MIC 7:7" /></para>
  <para style="s">उद्धार परमेश्वर सी च</para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 7:8" />ओ मोरो दुश्मनों, मोरो पर खुश मत हो; कहालीकि जब च मय गिर जाऊं तबच मय उठ जाऊं; अऊर जसो मय अन्धकार म पड़ जाऊं वसोच यहोवा मोरो लायी ज्योति को काम करेंन; <verse eid="MIC 7:8" /><verse number="9" style="v" sid="MIC 7:9" />मय न यहोवा को खिलाफ पाप करयो हय, योच कारन मय ऊ समय तक ओको गुस्सा ख सहतो रहूं जब तक कि ऊ मोरो मुकद्दमा लड़ क मोरो न्याय नहीं चुकायेंन। ऊ समय मोख उजाड़ो म सी निकाल क लायेंन, अऊर मय ओको न्याय देखूं। <verse eid="MIC 7:9" /><verse number="10" style="v" sid="MIC 7:10" />तब मोरो दुश्मन जो मोरो सी यो कह्य हय कि तोरो परमेश्वर यहोवा कित रह्यो, ऊ भी ओख देखेंन अऊर शरम सी मुंह लूकाय देयेंन। मय अपनी आंखी सी ओख देखूं; तब ऊ रस्ता को कीचड़ को जसो रौंद्यो जायेंन। <verse eid="MIC 7:10" /><verse number="11" style="v" sid="MIC 7:11" />ओ यरूशलेम, तोरी शहर की दीवार बांधन को दिन आयेंन ऊ दिन तोरी सीमा बढ़ायी जायेंन। <verse eid="MIC 7:11" /><verse number="12" style="v" sid="MIC 7:12" />ऊ दिन अश्शूर सी, अऊर मिस्र को नगरों सी, मिस्र अऊर फरात नदी को बीच को, अऊर समुन्दर-समुन्दर अऊर पहाड़ी-पहाड़ी को बीच को देशों म सी लोग तोरो जवर आयेंन। <verse eid="MIC 7:12" /><verse number="13" style="v" sid="MIC 7:13" />तब भी धरती पर रहन वालो को वजह अऊर उन्को बुरो काम को फलो को वजह उजाड़च रहेंन।<verse eid="MIC 7:13" /></para>
  <para style="s">इस्राएल पर परमेश्वर की दया</para>
  <para style="p">
    <verse number="14" style="v" sid="MIC 7:14" />अपनो लोगों की रखवाली अऊर अपनो हिस्सा म पायो हुयो झुण्ड की रखवाली डन्डा सी करजो, जो बंजर जमीन म अऊर उपजाऊ जमीन को बिच अकेलो रह्य हय, उन्ख बहुत पहिले को समय को जसो बाशान अऊर गिलाद को क्षेत्र म चरन देवो। <verse eid="MIC 7:14" /><verse number="15" style="v" sid="MIC 7:15" />जसो कि मिस्र देश सी तोरो निकलनो को दिन म, वसोच अब मय ओको अद्भुत काम दिखाऊं। <verse eid="MIC 7:15" /><verse number="16" style="v" sid="MIC 7:16" />दूसरो राज्य राज्य को लोग देख क अपनो पूरो पराक्रम को बारे म शरमायेंन; हि अपनो मुंह ख हाथ सी लूकाय देयेंन, अऊर उन्को कान बहेरा होय जायेंन। <verse eid="MIC 7:16" /><verse number="17" style="v" sid="MIC 7:17" />हि सांप को समान माटी चाटेंन, अऊर जमीन पर रेंगन वालो जीव जन्तु को जसो अपनो दर म सी कांपतो हुयो निकलेंन; हि हमरो परमेश्वर यहोवा को जवर कांपतो हुयो आयेंन, अऊर तोरो सी डरेंन। <verse eid="MIC 7:17" /><verse number="18" style="v" sid="MIC 7:18" />तोरो समान असो परमेश्वर कित हय जो बुरो काम ख माफ करय अऊर अपनो निज भाग को बच्यो हुयो अपराध छुपाय दे? ऊ अपनो गुस्सा ख हमेशा बनायो नहीं रखय, कहालीकि ऊ करुना सी प्रेम रखय हय। <verse eid="MIC 7:18" /><verse number="19" style="v" sid="MIC 7:19" />ऊ फिर हम पर दया करेंन, अऊर हमरो बुरो कामों ख पाय को खल्लो रौंद देयेंन। तय उन्को सब पापों ख गहिरो समुन्दर म डाल देजो। <verse eid="MIC 7:19" /><verse number="20" style="v" sid="MIC 7:20" />तय याकूब को बारे म वा सच्चायी, अऊर अब्राहम को बारे म वा करुना पूरी करजो, जेकी कसम तय पुरानो काल को दिन सी ले क अब तक हमरो बापदादों सी खातो आयो हय।<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>