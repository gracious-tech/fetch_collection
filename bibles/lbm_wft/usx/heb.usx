<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Lodhi</book>
  <para style="h">इब्रानियों</para>
  <para style="toc3">इब्रानियों</para>
  <para style="toc2">इब्रानियों</para>
  <para style="toc1">इब्रानियों को नाम चिट्ठी</para>
  <para style="mt2">इब्रानियों के नाम पत्री</para>
  <para style="mt1">इब्रानियों को नाम चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">यीशु पूरानो नियम को बहुत सो भविष्यवानियों ख पूरो कसो करय हय येख दिखावन वालो “इब्रानियों कि चिट्ठी” या एक धिरज देन वाली किताब आय। एक उपदेश सी येकी रचना करी गयी हय। पूरी भविष्यवानी अऊर मुख्य याजकों की जिम्मेदारियों ख यीशु मसीह न कसो पूरो करयो यो स्पष्टता सी दिखावन वालो ६० सी ज्यादा पूरानो नियम को सन्दर्भ या किताब म हय। योच वजह या किताब यहूदी मसीह लोगों को लायी प्रोत्साहन देन वाली मानी गयी। येको आगु याजकों न यज्ञ करन की जरूरत नहाय या व्यवस्था यीशु न कसो पूरो करयो यो या किताब म स्पष्ट करयो गयो हय। सब पापों को लायी एकच बार अऊर हमेशा हमेशा को यज्ञ असो यीशु भयो। या किताब सी हम्ख असो समझ म आवय हय कि, यीशु मसीह, हम्ख परमेश्वर पर विश्वास करन लायी तैयार करय हय <char style="xt"><ref loc="HEB 12:2">१२:२</ref></char> योच रीति सी यो युग को हम मसीही विश्वासियों लायी या किताब म बड़ो प्रोत्साहन हय। हम्ख ओको पर निर्भर रहनो चाहिये।</para>
  <para style="ip">इब्रानियों की चिट्ठी कौन न लिखी यो हम्ख मालूम नहाय त भी कुछ विद्वानों को माननो हय कि, यो प्रेरित पौलुस, लूका, यां बरनबास इन परमेश्वर को सेवकों न लिख्यो होना। वसोच या किताब कब लिखी गयी यो भी हम्ख मालूम नहाय। त भी बहुत सो विद्वान असो मानय हय कि, यो मसीह को जनम को बाद ७० साल को पहिले लिखी गयी होना। यो वजह असो कि, जब यरूशलेम शहर ७० साल म नाश करयो गयो त भी या किताब म यरूशलेम को वर्नन यो तरह करयो गयो कि, जसो कि ऊ नाश करयो गयो नहीं होतो या किताब बहुत सो मण्डलियों म जाय क पड़्यो गयो होना। ऊ रोम शहर म लिख्यो गयो होतो। <char style="xt"><ref loc="HEB 13:24">१३:२४</ref></char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. लिखन वालो असो दिखावय हय कि, यीशु यो परमेश्वर को पूरो भविष्यवक्ता अऊर स्वर्गदूत इन सी भी महान हय। <char style="ior"><ref loc="HEB 1:1-4:13">१:१–४:१३</ref></char></para>
  <para style="io1">२. येको बाद ऊ यो दिखावय हय कि जो याजक यरूशलेम को मन्दिर म सेवा करय हय उन सी भी यीशु महान हय। <char style="ior"><ref loc="HEB 4:14-7:28">४:१४–७:२८</ref></char></para>
  <para style="io1">३. मूसा ख दियो गयो आज्ञावों को द्वारा जो पुरानी व्यवस्था परमेश्वर न अपनो लोगों सी करयो ओको सी भी यीशु की सेवा महान हय। <char style="ior"><ref loc="HEB 8:1-10:31">८:१–१०:३१</ref></char></para>
  <para style="io1">४. यीशु हर बात म श्रेष्ठ हय यो स्पष्ट करन को बाद लेखक बहुत सो दिनचर्या को व्यवहारों को बारे म सुचना करय हय। <char style="ior"><ref loc="HEB 10:32-13:17">१०:३२–१३:१७</ref></char></para>
  <para style="io1">५. आखरी म कुछ सीख अऊर शुभेच्छा दे क लेखक या चिट्ठी ख खतम करय हय। <char style="ior"><ref loc="HEB 13:18-25">१३:१८-२५</ref></char></para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">परमेश्वर को वचन, बेटा को द्वारा</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />पहिले को युग म परमेश्वर न बापदादों सी थोड़ो थोड़ो कर क् अऊर तरह तरह सी भविष्यवक्तावों को द्वारा बाते करी, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />यो आखरी दिनो म ओन हम सी बेटा को द्वारा बाते करी। जेक ओन पूरी चिजों को उत्तराधिकारी ठहरायो अऊर ओकोच द्वारा परमेश्वर न पूरी सृष्टि की रचना करी हय। <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />ऊ बेटा परमेश्वर की महिमा को उजाड़ो अऊर ओको स्वरूप की पक्की छाप आय, अऊर सब चिजों ख अपनी सामर्थ को वचन सी सम्भालय हय। ऊ आदमी जाती को पापों ख माफी कर क् स्वर्ग म जाय क महामहिम को दायो तरफ जाय क बैठ गयो।<verse eid="HEB 1:3" /></para>
  <para style="s">परमेश्वर को टुरा की महानता</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />यो तरह बेटा ख स्वर्गदूतों सी महान बनायो गयो उच तरह जसो परमेश्वर न ओख स्वर्गदूतों सी उत्तम नाम दियो। <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />कहालीकि परमेश्वर न कोयी भी स्वर्गदूतों सी असो नहीं कह्यो,</para>
  <para style="q1" vid="HEB 1:5">“तय मोरो बेटा आय,</para>
  <para style="q2" vid="HEB 1:5">अज तय मोरो बाप बन्यो हय”</para>
  <para style="m" vid="HEB 1:5">अऊर नहीं कोयी स्वर्गदूत सी कह्यो हय</para>
  <para style="q1" vid="HEB 1:5">“मय तोरो बाप बनू</para>
  <para style="q2" vid="HEB 1:5">अऊर तय मोरो बेटा होजो?”<verse eid="HEB 1:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />पर जब परमेश्वर ओको पहिले जनम्यो सन्तान ख जगत म भेजय हय, त ऊ कह्य हय,</para>
  <para style="q1" vid="HEB 1:6">“परमेश्वर को सब स्वर्गदूत ओकी आराधना करे।”<verse eid="HEB 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7" />पर परमेश्वर स्वर्गदूतों को बारे म यो कह्य हय,</para>
  <para style="q1" vid="HEB 1:7">“ऊ अपनो दूतों ख हवा,</para>
  <para style="q2" vid="HEB 1:7">अऊर अपनो सेवकों ख धधकती आगी बनावय हय।”<verse eid="HEB 1:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />पर परमेश्वर बेटा को बारे म असो कह्य हय, “हे परमेश्वर, तोरो सिंहासन, हमेशा हमेशा रहेंन: अऊर तोरो राज्यदण्ड न्याय सी चलेंन अऊर तुम्हरो अपनो लोगों पर अधिकारदण्ड रहेंन। <verse eid="HEB 1:8" /><verse number="9" style="v" sid="HEB 1:9" />तय न जो सच्चायी हय ओको सी प्रेम करयो हय अऊर दुष्टता सी घृना करय हय; यो वजह परमेश्वर, तोरो परमेश्वर न खुशी को तेल सी तोरो अभिषेक करन को द्वारा संगियों सी बढ़ क चुन्यो।”<note caller="+" style="f"><char style="fr" closed="false">१:९ </char><char style="ft" closed="false">भजन ४५:६,७</char></note> <verse eid="HEB 1:9" /><verse number="10" style="v" sid="HEB 1:10" />वचन यो भी कह्य हय,</para>
  <para style="q1" vid="HEB 1:10">“हे प्रभु, सुरूवात सी तय न धरती की नींव डाली,</para>
  <para style="q2" vid="HEB 1:10">अऊर स्वर्ग तोरो हाथों की कारीगरी आय।<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />हि त नाश होय जायेंन, पर तय बन्यो रहजो;</para>
  <para style="q2" vid="HEB 1:11">अऊर हि सब कपड़ा को जसो जिर्न होय जायेंन,<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />अऊर तय उन्ख कोट को जसो लपेटजो,</para>
  <para style="q2" vid="HEB 1:12">अऊर हि कपड़ा को जसो बदल जायेंन।</para>
  <para style="q1" vid="HEB 1:12">पर तय वसोच रहजो</para>
  <para style="q2" vid="HEB 1:12">अऊर तोरो जीवन को अन्त नहीं होयेंन।”<verse eid="HEB 1:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />अऊर स्वर्गदूतों म सी परमेश्वर न कोन्को सी कब कह्यो,</para>
  <para style="q1" vid="HEB 1:13">“तय मोरो दायो तरफ बैठ,</para>
  <para style="q2" vid="HEB 1:13">जब तक कि मय तोरो दुश्मनों ख</para>
  <para style="q2" vid="HEB 1:13">तोरो पाय को खल्लो की चौकी नहीं बनाय देऊ?”<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />का यो स्वर्गदूत वा आत्मायें नोहोय? जो आत्मायें परमेश्वर की सेवा अऊर ओको द्वारा उद्धार पान वालो ख मदत करन लायी भेजी जावय हंय?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">महान उद्धार</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />येकोलायी हम्ख अऊर जादा सावधानी को संग, जो सत्य कि बाते जो हम न सुनी, अऊर भी मन लगायो, असो नहीं होय कि बहक क उन्को सी दूर चली जाये। <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />कहालीकि जो सन्देश स्वर्गदूतों सी हमरो बापदादों ख कह्यो गयो होतो, जिन्न ओको उल्लंघन करयो ओख दण्ड मिल्यो जेको हि उचित होतो, <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />त हम असो बच सकजे हय यदि हम यो महान उद्धार पर हमरो ध्यान नहीं दे? जेको बारे म प्रभु न पहिले हम्ख बतायो, अऊर जिन्न ओख सुन्यो ऊ हमरो लायी निश्चय भयो कि ऊ उद्धार सत्य हय। <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />अऊर संगच परमेश्वर भी अपनी इच्छा को अनुसार चिन्हों, अऊर अचम्भा को कामों, अऊर अलग अलग तरह को सामर्थ को कामों, अऊर पवित्र आत्मा को वरदानों को बाटन को द्वारा येकी गवाही देतो रह्यो।<verse eid="HEB 2:4" /></para>
  <para style="s">हमरो उद्धारकर्ता को मार्गदर्शन</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />परमेश्वर न ऊ आवन वालो जगत ख जेकी चर्चा हम कर रह्यो हंय, स्वर्गदूतों को अधीन नहीं करयो। <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />बल्की कोयी न पवित्र शास्त्र म यो गवाही दी हय,</para>
  <para style="q1" vid="HEB 2:6">“त आदमी का हय कि तय ओकी चिन्ता करे?</para>
  <para style="q2" vid="HEB 2:6">यो आदमी को बेटा का हय कि तय ओकी चिन्ता करे?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />तय न ओख स्वर्गदूतों सी कुछच कम करयो;</para>
  <para style="q2" vid="HEB 2:7">तय न ओको पर महिमा अऊर आदर को मुकुट रख्यो,<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />अऊर उन्ख पूरी चिजों पर शासक बनाय दियो।”</para>
  <para style="m" vid="HEB 2:8">येकोलायी यो कह्य हय कि परमेश्वर न उन्ख, पूरी चिजों पर शासक बनायो हय, येको म स्पष्ट रूप सी सब कुछ शामिल हय। पर हम सब चिजों पर शासन करन वालो आदमियों ख नहीं देखजे हंय। <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />पर हम यीशु ख जो स्वर्गदूतों सी कुछच कम करयो गयो होतो, मृत्यु को दु:ख उठावन को वजह महिमा अऊर आदर को मुकुट पहिन्यो हुयो देखजे हंय, ताकि परमेश्वर को अनुग्रह सी ऊ हर एक आदमी लायी मरे। <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />यो परमेश्वर को लायी सही होतो, जेन सब बातों ख बनायो अऊर सम्भाल्यो रख्यो, यीशु ख भी यातनावों को द्वारा परिपूर्ण बनानो चाहिये ताकी बहुत सो सन्तान ओकी महिमा म सामिल होय सके। कहालीकि यीशुच एक हय जो उन्ख उद्धार को तरफ ले जावय हय।<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />ऊ लोगों ख उन्को पापों सी पवित्र करय हय अऊर हि दोयी ऊ पवित्र करयो हुयो, सब एकच परिवार को आय। येकोलायी यीशु उन्ख अपनो भाऊ कहनो सी नहीं लजावय। <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />ऊ परमेश्वर सी कह्य हय,</para>
  <para style="q1" vid="HEB 2:12">“मय तोरो नाम अपनो भाऊवों अऊर बहिनों ख सुनाऊ;</para>
  <para style="q2" vid="HEB 2:12">अऊर सभा को बीच म मय तोरी प्रशंसा करू।”<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />अऊर ऊ यो भी कह्य हय “मय अपनो भरोसा परमेश्वर पर रखू।” अऊर कह्य हय, “मय यहां परमेश्वर न दी हुयी सन्तान को संग हय।”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />येकोलायी जब कि लड़का मांस अऊर खून को भागी हंय, त यीशु खुदच उन्को जसो उन्को सहभागी भय गयो, ताकि मृत्यु को द्वारा ओख जो मृत्यु पर शक्ति मिली भी, मतलब शैतान ख नाश कर दे; <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />योच रीति सी जितनो मृत्यु को डर को वजह जीवन भर गुलामी म फस्यो होतो, उन्ख छुड़ाय लेजो। <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />कहालीकि यो निश्चित हय कि ऊ स्वर्गदूतों की नहीं बल्की अब्राहम को वंश ख मदत करय हय। <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />यो वजह ओख चाहिये होतो, कि सब बातों म अपनो भाऊवों को जसो बने; जेकोसी ऊ उन बातों म जो परमेश्वर सी सम्बन्ध रखय हंय, एक दयालु अऊर विश्वास लायक महायाजक बने ताकि लोगों को पापों की माफी लायी प्रायश्चित करे। <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />कहालीकि जब ओन परीक्षा की दशा म दु:ख उठायो, त ऊ उन्की भी मदत कर सकय हय जेकी परीक्षा होवय हय।<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">यीशु मूसा सी महान</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />येकोलायी हे मसीही भाऊवों अऊर बहिनों, तुम जो परमेश्वर को द्वारा बुलायो गयो हय खुद अपनो ध्यान यीशु पर लगायो रखो, जेक परमेश्वर न मुख्य याजक बनन लायी भेज्यो गयो होतो ओख जेक पर हम हमरी कबूली देजे हय। <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />ऊ जेन ओख चुन्यो ऊ परमेश्वर को प्रती विश्वास लायक होतो, ठीक वसोच जसो मूसा अपनो काम को प्रती परमेश्वर को घरानों म विश्वास लायक होतो। <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />जसो घर बनावन वालो एक आदमी घर सी जादा खुद आदर को पात्र होवय हय, उच रीति सी यीशु भी मूसा सी जादा आदर को पात्र मान्यो गयो। <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />कहालीकि हर एक घर ख कोयी न कोयी बनावन वालो होवय हय, पर परमेश्वर त हर चिज ख बनावन वालो आय। <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />मूसा त परमेश्वर को पूरो घर म सेवक को जसो विश्वास लायक होतो, ओन वा बाते करी जो भविष्य म परमेश्वर को द्वारा कह्यो जानो होतो। <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />पर मसीह बेटा को रूप म परमेश्वर को घर म विश्वास लायक हय। अऊर ओको घर हम आय, यदि हम हमरो साहस अऊर जेको पर हम घमण्ड करजे हय ऊ आशा पर मजबुतायी सी स्थिर रहे।<verse eid="HEB 3:6" /></para>
  <para style="s">परमेश्वर को लोगों ख आराम</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />येकोलायी जसो पवित्र आत्मा कह्य हय, “यदि अज तुम परमेश्वर की आवाज सुनो, <verse eid="HEB 3:7" /><verse number="8" style="v" sid="HEB 3:8" />त अपनो मन ख कठोर मत करो, जसो कि तुम्हरो पूर्वजों जब उनकी मरूस्थल म परीक्षा होय रही होती परमेश्वर को खिलाफ बगावत करी होती। <verse eid="HEB 3:8" /><verse number="9" style="v" sid="HEB 3:9" />परमेश्वर कह्य हय उत उन्न परीक्षा करी अऊर परख्यो तब भी मोरो कार्यो ख देख जेक मय अऊर चालीस साल तक जो मय न उन्को लायी करयो ओख देख्यो। <verse eid="HEB 3:9" /><verse number="10" style="v" sid="HEB 3:10" />यो वजह मय ऊ पीढ़ी को लोगों सी गुस्सा रह्यो, अऊर कहतो रह्यो, ‘इन्को मन हमेशा सीच अप्रमानित अऊर हि मोरी रस्ता जानय नहाय।’ <verse eid="HEB 3:10" /><verse number="11" style="v" sid="HEB 3:11" />तब मय न गुस्सा म आय क कसम खायी, ‘येकोलायी जित मय उन्ख आराम देऊ उत हि कभी आराम नहीं कर पायेंन।’”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />हे भाऊवों अऊर बहिनों, सावधान रहो कि तुम म असो कोयी को असो बुरो अऊर अविश्वासी मन नहीं हो, जो तुम्ख जीन्दो परमेश्वर सी दूर हटाय ले जाये। <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />पर येको बदला जब तक यो “अज को दिन” कहलावय हय, तुम हर दिन एक दूसरों ख प्रोत्साहन देतो रहो, ताकी तुम म सी कोयी भी पाप म भरमायो नहीं जाये अऊर नहीं कठोर होय जाये। <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />यदि हम आखरी तक मजबुतायी को संग अपनो सुरूवात को आत्मविश्वास ख पकड़्यो रह्य हय त हम मसीह को भागीदार बन जाजे हय।<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />जसो शास्त्र कह्य हय,</para>
  <para style="q1" vid="HEB 3:15">“यदि अज तुम परमेश्वर को आवाज सुनो,</para>
  <para style="q2" vid="HEB 3:15">त अपनो मनों ख कठोर मत करो,</para>
  <para style="q2" vid="HEB 3:15">जसो बगावत को दिनो म तुम्हरो पूर्वजों न करयो होतो।”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />भलो हि कौन लोग होतो जिन्न परमेश्वर की आवाज सुनी अऊर ओको खिलाफ बगावत करयो? का हि लोग नहीं होतो, जिन्ख मूसा न मिस्र सी बचाय क निकाल्यो होतो? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />अऊर परमेश्वर चालीस साल तक कौन लोगों सी गुस्सा रह्यो? का उन्कोच पर नहीं जिन्न पाप करयो होतो, अऊर उन्को लाश मरूस्थल म पड़्यो होतो? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />अऊर परमेश्वर न कौन्सो लोगों लायी कसम खायी होती कि हि तुम मोरो आराम जागा म सिर पावों? का हि यो नहीं जिन्न ओकी आज्ञा नहीं मानी? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />यो तरह हम देखजे हंय कि हि अविश्वास को वजह आराम जागा पर सिर नहीं सक्यो।<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />येकोलायी जब कि परमेश्वर ओको आराम जागा म सिरन की प्रतिज्ञा अब तक हय, त हम्ख डरनो चाहिये असो नहीं होय कि तुम म सी कोयी लोग वंचित रह्य जाये। <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />कहालीकि हम न भी सुसमाचार सुन्यो जसो उन्न सुन्यो होतो, पर जो सन्देश उन्न सुन्यो होतो उन्को लायी ओकी किम्मत नहीं होती, कहालीकि जब उन्न सुन्यो उन्न ओख विश्वास को संग स्वीकार नहीं करयो। <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />हम जो विश्वासी हय ऊ आराम ख परमेश्वर न प्रतिज्ञा करी होती ओख हम हासिल करजे हय, “जसो की परमेश्वर न कह्यो हय, मय न गुस्सा म येको पर कसम ले क कह्यो होतो हि कभी मोरो आराम म सामिल नहीं होय पायेंन।” ओन यो कह्यो होतो जब की जगत की सृष्टि करन को बाद ओको काम पूरो भय गयो होतो। <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />कहालीकि सातवों दिन को बारे म कहीं त शास्त्र म कह्यो हय, “अऊर फिर सातवों दिन सब कामों सी परमेश्वर न आराम करयो।” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />अऊर यो सन्दर्भ म फिर सी कह्य हय, “हि मोरो आराम जागा म कभी सिर नहीं पायेंन।” <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />जिन्न पहिले सुसमाचार ख सुन्यो हि ऊ आराम ख हासिल नहीं कर सक्यो कहालीकि उन्न विश्वास नहीं करयो होतो। किन्तु दूसरों लायी आराम को द्वार अभी भी खुल्यो हय। <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />येकोलायी परमेश्वर न फिर एक विशेष दिन ठहरायो अऊर ओख कह्यो गयो “अज को दिन” कुछ साल को बाद दाऊद को द्वारा परमेश्वर न ऊ दिन को बारे म शास्त्र म बतायो गयो होतो जेको उल्लेख शास्त्र पहिलेच सी करय हय यदि अज तुम परमेश्वर की आवाज सुनो त अपनो मन ख कठोर मत करो।<note caller="+" style="f"><char style="fr" closed="false">४:७ </char><char style="ft" closed="false">भजन ९५: ७-८</char></note><verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />यदि यहोशू उन्ख आराम म ले गयो होतो, जेन परमेश्वर की प्रतिज्ञा करी होती त परमेश्वर बाद म कोयी दूसरों दिन को बारे म नहीं कहतो। <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />त जो भी हो, यो परमेश्वर सातवों दिन म आराम करय हय वसोच परमेश्वर को लोगों को लायी उत एक आराम बाकी हय। <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />कहालीकि जो कोयी भी परमेश्वर म प्रतिज्ञा करयो हुयो आराम म सिरय हय, ऊ ओको कामों को अनुसार आराम पायेंन वसोच परमेश्वर न अपनो कामों सी आराम पायो हय। <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />येकोलायी आवो हम भी ऊ आराम म हासिल करन लायी अपनी पूरी रीति सी कोशिश करे, ताकी असो नहीं होय कि हमरो बीच म सी कोयी भी ओख पावन म अऊर यशस्वी नहीं हो जसो हि अपनो विश्वास की कमी को द्वारा भयो होतो।<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />कहालीकि परमेश्वर को वचन जीन्दो, अऊर क्रियाशिल, अऊर कोयी भी दोधारी तलवार सी भी बहुत तेज हय। अऊर जीव अऊर आत्मा ख, अऊर जोड़-जोड़ अलग कर क् आर-पार छेदय हय अऊर इच्छाये अऊर बिचार ख जांचय हय। <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />अऊर सृष्टि की कोयी चिज परमेश्वर की नजर सी लूकी नहाय, ओकी आंखी को आगु जेक हम्ख लेखा जोखा देना हय हर चिज बिना कोयी आवरन कि खुली हुयी हय। अऊर कुछ भी लूकी नहाय।<verse eid="HEB 4:13" /></para>
  <para style="s">यीशु महान महायाजक</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />येकोलायी जब हमरो असो बड़ो महायाजक हय, जो स्वर्ग सी होय क गयो हय, मतलब परमेश्वर को बेटा यीशु, त आवो, हम अपनो विश्वास जो हम न हासिल करयो हय दृढ़ता सी थाम्यो रहे। <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />कहालीकि हमरो जवर असो महायाजक नहाय कि जो हमरी कमजोरियों को संग सहानुभूति नहीं रख सके। वसोच परख्यो गयो जसो हम्ख, पर ऊ हमेशा पाप रहित रह्यो। <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />येकोलायी आवो, हम आत्मविश्वास को संग अनुग्रह पावन परमेश्वर को सिंहासन को तरफ बढ़े ताकी जरूरत पड़न पर हमरी मदत को लायी हम दया अऊर अनुग्रह ख हासिल कर सके।<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />हर एक महायाजक आदमियों म सीच चुन्यो जावय हय, अऊर लोगों को प्रतिनिधित्व करन को लायी परमेश्वर की सेवा को लायी चुन्यो जावय हय ताकी ऊ पापों को लायी दान अऊर बलिदान चढ़ाये। <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />कहालीकि ऊ खुद भी बहुत रीति सी कमजोरियों को अधिन हय येकोलायी ऊ अज्ञानियों अऊर भूल्यो भटक्यो को संग कोमलता सी व्यवहार कर सकय हय। <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />येकोलायी ओख चाहिये कि जसो लोगों को लायी वसोच अपनो लायी भी पाप-बलि चढ़ायो करे। <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />यो मुख्य याजक को आदर को पद कोयी अपनो आप ख चुन क नहीं लेवय हय, जब तक कि हारून को जसो परमेश्वर को तरफ सी ठहरायो नहीं जाये।<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />वसोच मसीह न भी महायाजक बनन को आदर खुद नहीं लियो, बल्की परमेश्वर ओख कह्य हय:</para>
  <para style="q1" vid="HEB 5:5">“तय मोरो बेटा आय</para>
  <para style="q2" vid="HEB 5:5">अऊर अज मय तोरो बाप बन्यो हय।”<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />योच तरह ऊ दूसरी जागा म भी कह्य हय,</para>
  <para style="q1" vid="HEB 5:6">“तय मलिकिसिदक की रीति</para>
  <para style="q2" vid="HEB 5:6">पर हमेशा लायी याजक हय।” <figure style="fig" alt="High priest with his priestly clothes and censer" file="hk00267c.tif" size="col" copy="Horace Knowles ©" ref="५:५">महायाजक याजक को कपड़ा अऊर धुपदानी को संग </figure><verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:७ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:36-46">मत्ती २६:३६-४६</ref>; <ref loc="MRK 14:32-42">मरकुस १४:३२-४२</ref>; <ref loc="LUK 22:39-46">लूका २२:३९-४६</ref></char>
    </note>यीशु न अपनो शरीर म रहन को दिनो म ऊचो आवाज म रोय-रोय क अऊर आसु बहाय-बहाय क ओको सी जो मरन सी बचाय सकत होतो, प्रार्थनाये अऊर बिनती करी, अऊर भक्ति अऊर नम्रता को वजह परमेश्वर न ओख सुन्यो। <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />पर यद्दपि ऊ परमेश्वर को बेटा होतो फिर भी यातनायें झेलतो हुयो ओन आज्ञा को पालन करनो सिख्यो। <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />अऊर सिद्ध बन जानो पर, अपनो सब आज्ञा मानन वालो लायी अनन्त काल को उद्धार को स्त्रोत बन गयो, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />अऊर ओख परमेश्वर को तरफ सी मलिकिसिदक की रीति पर महायाजक बनायो गयो।<verse eid="HEB 5:10" /></para>
  <para style="s">विश्वास सी भटक जान को खिलाफ चेतावनी</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />येको बारे म हम्ख बहुत सी बाते कहनो हंय, पर जिन्को वर्नन करनो कठिन हय, कहालीकि तुम समझन म बहुत धीमो हय। <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" /><note caller="+" style="x"><char style="xo" closed="false">५:१२ </char><char style="xt" closed="false"><ref loc="1CO 3:2">१ कुरिन्थियों ३:२</ref></char></note>वास्तव म यो समय तक त तुम्ख गुरु बनानो चाहिये होतो, तब भी या जरूरत भय गयी हय कि कोयी तुम्ख परमेश्वर को वचन की सुरूवात की शिक्षा सिखाये। तुम त असो भय गयो हय कि तुम्ख ठोस जेवन खान को बजाय, तुम ख अभी भी दूध पीनो पड़य हय। <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />कहालीकि जो दूध पीवय हय ऊ अभी भी बच्चाच हय अऊर ओख सच्च गलत को कोयी अनुभव नहीं होवय। <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />पर ठोस जेवन समझदारों को लायी हय, उन्न अपनो अनुभव सी अच्छो-बुरो को ज्ञान करनो सीख लियो हय।<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />येकोलायी आवो मसीह की शिक्षा की सुरूवाती स्तर की शिक्षा ख छोड़ क हम सिद्धता को तरफ आगु बढ़तो जाये, अऊर मृत्यु को तरफ अगुवायी करन वालो कामों सी प्रायश्चित की नीव फिर सी नहीं डाले, अऊर परमेश्वर पर को विश्वास, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />अऊर बपतिस्मा की शिक्षा अऊर ऊपर हाथों ख रखनो, अऊर मृत्यु सी जीन्दो होनो अऊर अनन्त न्याय। <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />यदि परमेश्वर चाहेंन त हम योच करबोंन।<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />जो लोग अपनो विश्वास ख त्याग देवय हय उन्ख फिर सी पश्चाताप करन लायी कसो लायो जाय सकय हय? हि एक बार परमेश्वर को प्रकाश म होतो, उन्न स्वर्ग को उपहार चख्यो अऊर पवित्र आत्मा को अपनो हिस्सा हासिल करयो हंय, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />अऊर आवन वालो युग कि सामर्थ को काम अनुभव लियो हय कि परमेश्वर को वचन कितनो अच्छो हय, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />यदि हि विश्वास सी भटक जाये त उन्ख फिर सी मन फिराव को लायी वापस लावनो मुस्किल हय; कहालीकि हि परमेश्वर को टुरा ख फिर सी क्रूस पर चढ़ावय हंय तथा ओख सब को सामने अपमान को विषय बनावय हंय।<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />कहालीकि जो जमीन प्राय होन वाली बरसात को पानी ख सोख लेवय हय, अऊर जोतन यां बोवन वालो को उपयोगी फसल प्रदान करय हय वा माटी परमेश्वर सी आशीष पावय हय, <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />पर यदि वा जमीन काटा अऊर घासफूंस उगावय हय, त वा बेकार हय अऊर ओख परमेश्वर को श्राप अऊर आगी सी नाश करन को डर रह्य हय।<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />पर हे प्रिय संगियों, चाहे हम यो तरह की बाते कहजे हंय पर तुम्हरो बारे म हम्ख येको सी भी अच्छी बातों को आत्मविश्वास हय, हि बाते जो तुम्हरो उद्धार सी सम्बन्धित हंय। <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />तुम न परमेश्वर को लोगों की हमेशा मदत करतो हुयो जो प्रेम दर्शायो हय, ओख अऊर तुम्हरी दूसरी सेवा ख परमेश्वर कभी नहीं भूलायेंन। ऊ अधर्मी नहाय। <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />हम बहुतायत सी चाहजे हंय कि तुम म सी हर कोयी जीवन भर असोच कठिन मेहनत करय हय, ताकी तुम निश्चय ओख पा लेवो जेकी तुम आशा करय हय। <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />हम नहीं चाहजे की तुम आलसी होय जावो, बल्की उन्को अनुकरन करो जो विश्वास अऊर धीरज को द्वारा उन चिजों ख पा रह्यो हय जिन्की परमेश्वर न प्रतिज्ञा करी होती।<verse eid="HEB 6:12" /></para>
  <para style="s">परमेश्वर की अटल प्रतिज्ञा</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />परमेश्वर न अब्राहम सी प्रतिज्ञा करतो समय जब कसम खान लायी कोयी ख अपनो सी बड़ो नहीं पायो, त अपनीच कसम खायी, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />अऊर कह्यो “मय सचमुच तोख बहुत आशीष देऊ, अऊर तोख कुछ वंशज देऊ।” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />अऊर यो रीति सी अब्राहम न धीरज धर क परमेश्वर न करी हुयी प्रतिज्ञावों ख हासिल करी। <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />आदमी त अपनो सी कोयी बड़ो की कसम खायो करय हंय, अऊर वा कसम सब तर्क-वितर्क को अन्त कर क् जो कुछ कह्यो जावय हय, ओख पक्को कर देवय हय। <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />परमेश्वर न करी हुयी प्रतिज्ञा ख पान वालो ख परमेश्वर स्पष्ट कर देनो चाहवय हय कि ऊ अपनो उद्देश ख कभी नहीं बदलय येकोलायी ओन अपनी प्रतिज्ञा को संग अपनी कसम ख जोड़ दियो। <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />यहां दोय बाते हय ओकी प्रतिज्ञा अऊर ओकी कसम जो कभी नहीं बदल सकय अऊर जिन्को बारे म परमेश्वर कभी झूठ नहीं कह्य सकय। येकोलायी हम जो परमेश्वर को जवर सुरक्षा पान ख आयो हय अऊर जो आशा हम्ख दी हय, ओख पकड़्यो हुयो हय अत्याधिक उत्साहित हय। <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />वा आशा हमरो जीव को लायी असो लंगर<note caller="+" style="f"><char style="fr" closed="false">६:१९ </char><char style="ft" closed="false">फुकट म दियो गयो आत्मिक भोजन</char></note> हय जो स्थिर अऊर मजबूत हय, अऊर परदा को अन्दर को पवित्र जागा तक पहुंचय हय, <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />जित यीशु न हमरो तरफ सी हम सी पहिले सिरयो। ऊ मलिकिसिदक की परम्परा म सदा हमेशा को लायी मुख्य याजक बन गयो।<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">मलिकिसिदक याजक</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />यो मलिकिसिदक शालेम को राजा होतो, अऊर परमप्रधान परमेश्वर को याजक होतो। जब अब्राहम चार राजावों ख युद्ध सी हराय क लौट रह्यो होतो तब मलिकिसिदक अब्राहम सी मिल्यो अऊर ओख आशीर्वाद दियो। <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />अऊर अब्राहम न ओख ऊ सब कुछ म सी जो ओन युद्ध म जीत्यो होतो ओको दसवों भाग दियो। मलिकिसिदक को नाम को पहिलो अर्थ हय “सच्चायी को राजा” अऊर फिर ओको यो भी अर्थ हय, “शालेम को राजा” मतलब “शान्ति को राजा।” <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />ओको बाप, माय, अऊर पूर्वजों को कोयी इतिहास नहीं मिलय हय, ओको जीवन या मृत्यु को भी कोयी उल्लेख नहाय; पर परमेश्वर को बेटा को जसोच हमेशा को लायी याजक बन्यो रह्य हय।<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />अब येको पर ध्यान करो कि ऊ कसो महान होतो जेक कुलपति अब्राहम न जो कुछ ओन हासिल करयो ओको दसवों भाग दियो। <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />अऊर लेवी को वंशजों म सी जो याजक को पद पावय हंय, उन्ख व्यवस्था को अनुसार आज्ञा मिली हय कि इस्राएली को लोगों सी मतलब अपनो खुद को भाऊवों सी, दशवों भाग ले फिर चाहे हि अब्राहम को वंशज कहाली नहीं होना। <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />पर मलिकिसिदक न, जो लेवी को वंश को भी नहीं होतो, अब्राहम सी दसवों भाग लियो, अऊर ऊ अब्राहम ख आशीर्वाद दियो जेको जवर परमेश्वर की प्रतिज्ञाये होती। <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />येको म कोयी सक नहाय कि जो आशीर्वाद देवय हय ऊ आशीर्वाद लेनवालो सी बड़ो होवय हय। <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />जित तक लेवियों को सवाल हय उन म दसवों भाग उन आदमी को द्वारा जमा करयो हय, जो आदमी मरय हय किन्तु मलिकिसिदक को जित तक सवाल हय दसवों भाग ओको द्वारा जमा करयो जावय हय जो शास्त्र को द्वारा अभी भी जीन्दो हय। <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />त हम यो भी कह्य सकजे हंय कि लेवी न भी, जो दसवों भाग लेवय हय, अब्राहम को द्वारा दसवों भाग दियो। <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />कहालीकि जब मलिकिसिदक अब्राहम सी मिल्यो होतो, तब त लेवी को जनम भी नहीं भयो होतो ऊ अपनो पूर्वजों को शरीर म होतो।<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />यदि लेवी याजकता को परम्परा को द्वारा सम्पुर्नता हासिल करयो जाय सकत होतो कहालीकि कोयी दूसरों याजक ख आवन की का जरूरत होती? कहालीकि येकोच आधार पर लोगों ख व्यवस्था भी दी गयी होती, एक असो याजक की का जरूरत होती जो की मलिकिसिदक की परम्परा को होना, नहीं की हारून कि परम्परा को। <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />कहालीकि जब याजक को पद बदल जावय हय, त व्यवस्था ख भी बदलनो जरूरी हय। <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />कहालीकि जो हमरो प्रभु को बारे म या बाते कहीं जावय हंय जेको गोत्र म सी याजक को रूप म होतो, जेको म सी कोयी न वेदी की सेवा नहीं करी, <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />त प्रगट हय कि हमरो प्रभु यहूदा को गोत्र म सी जनम लियो हय, अऊर यो गोत्र को बारे म मूसा न याजक पद की कुछ चर्चा नहीं करी।<verse eid="HEB 7:14" /></para>
  <para style="s">मलिकिसिदक को तरह एक अऊर याजक</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />हमरो दावा अऊर भी पूरो साफ तरह सी प्रगट होय जावय हय, जब मलिकिसिदक को जसो एक अऊर याजक प्रगट होय जावय हय, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />जो शारीरिक आज्ञावों सी अऊर व्यवस्था को अनुसार, पर अविनाशी जीवन को सामर्थ को अनुसार याजक बन्यो हय। <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />कहालीकि शास्त्र कह्य हय, ओको बारे म यो गवाही दी गयी हय, “तय मलिकिसिदक की रीति पर हमेशा हमेशा याजक हय।” <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />पहिली आज्ञा येकोलायी रद्द कर दियो गयो कहालीकि ऊ कमजोर अऊर बेकार होतो। <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />येकोलायी कहालीकि मूसा की व्यवस्था न कोयी ख सम्पुर्न सिद्ध नहीं कर सक्यो। अऊर अब ओको जागा पर एक असी उत्तम आशा रखी गयी हय जेको द्वारा हम परमेश्वर को जवर जाय सकजे हंय।<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />मसीह की नियुक्ति परमेश्वर को कसम को द्वारा भयी, बल्की दूसरों को बिना कसम कोच याजक बनायो गयो होतो। <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />पर यीशु एक कसम सी बन्यो होतो, जब ओन कह्यो होतो,</para>
  <para style="q1" vid="HEB 7:21">“प्रभु न कसम खायी हय,</para>
  <para style="q2" vid="HEB 7:21">अऊर ऊ अपनो मन कभी नहीं बदलेंन</para>
  <para style="q1" vid="HEB 7:21">तय हमेशा को लायी एक याजक ठहरजो।”<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />यो कसम को वजह यीशु एक अच्छो वाचा को आश्वासन बन गयो।<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />असो बहुत सो याजक होत होतो, पर उन्की मृत्यु न उन्ख अपनो पदो पर कायम नहीं रहन दियो; <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />पर यीशु अमर हय अऊर ओको याजक को काम भी हमेशा हमेशा लायी जीन्दो रहन वालो हय। <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />येकोलायी जो ओको द्वारा परमेश्वर को जवर आवय हंय, ऊ उन्को पूरो रीति सी उद्धार करन म लायक हय, कहालीकि ऊ उन्को लायी परमेश्वर सी बिनती करन लायी हमेशा जीन्दो हय।<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />असोच महायाजक हमरी जरूरतों ख पूरो कर सकय हय। ऊ पवित्र हय, ऊ निर्दोष हय, अऊर ओको म कोयी पाप नहाय, जो पापियों सी अलग रह्य हय, अऊर ओख स्वर्गों सी भी ओख ऊचो उठायो गयो हय। <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />उन महायाजकों को जसो ओख जरूरत नहाय कि हर दिन पहिले अपनो पापों अऊर फिर लोगों को पापों को लायी बलिदान चढ़ाये कहालीकि ओन अपनो आप ख बलिदान चढ़ाय क एकच बार म सब को लायी पूरो कर दियो। <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />मूसा की व्यवस्था आदमियों ख जो अपुर्न हय महायाजक चुनय हय, पर परमेश्वर की प्रतिज्ञा ओकी कसम को संग बनायी गयी हय या प्रतिज्ञा व्यवस्था को बाद आयी हय, अऊर या प्रतिज्ञा न प्रमुख याजक को रूप म टुरा ख चुन्यो, जो हमेशा हमेशा लायी परिपूर्ण बन्यो रह्य हय।<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">यीशु हमरो महायाजक</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />जो कुछ कह्य रह्यो हंय ओकी मुख्य बाते या हय: निश्चय हमरो जवर असो महायाजक हय, जो स्वर्ग म महान परमेश्वर को सिंहासन को दायो तरफ विराजमान हय, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />अऊर पवित्र जागा मतलब सच्चो तम्बू म परमेश्वर न स्थापित करयो होतो नहीं की आदमी न, ऊ जागा ऊ महायाजक को नाते सेवा करय हय।<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />कहालीकि हर एक महायाजक दान अऊर बलिदान परमेश्वर ख चढ़ावन लायी ठहरायो जावय हय, यो वजह जरूरी हय कि यो याजक को जवर भी कुछ चढ़ावन लायी होना। <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />यदि ऊ धरती पर होतो त कभी याजक नहीं होतो, कहालीकि उत पहिले सीच असो याजक हय जो यहूदी व्यवस्था को अनुसार दान चढ़ावन वालो हंय। <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />जो याजकपन को काम करय हय ऊ स्वर्ग म जो हय ओकी एक छाया अऊर प्रतिकृती आय। योच तरह हय जब मूसा पवित्र तम्बू ख बनावन वालो होतो तब परमेश्वर न ओको सी कह्यो होतो। “ध्यान रहे कि तय हर चिज ठीक उच प्रतिरूप को अनुसार बनाये जो तोख पहाड़ी पर दिखायो गयो होतो।” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />पर अब जो याजकपन की सेवा यीशु ख प्राप्त भयी हय, ऊ उन्को सेवा काम सी श्रेष्ठ हय। कहालीकि ऊ जो वाचा को मध्यस्थ हय ऊ पूरानो वाचा सी अच्छो हय कहालीकि या अच्छी चिजों को प्रतिज्ञावों पर आधारित हय।<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />कहालीकि यदि वा पहिली वाचा म गलती नहीं होती, त दूसरी वाचा को लायी कोयी जरूरत नहीं होती। <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />पर परमेश्वर ख उन लोगों म दोष मिल्यो अऊर ऊ कह्य हय,</para>
  <para style="q1" vid="HEB 8:8">“प्रभु कह्य हय, देखो, ऊ दिन आवय हंय कि मय इस्राएल को घराना को संग,</para>
  <para style="q2" vid="HEB 8:8">अऊर यहूदा को घराना को संग नयी वाचा बान्धू।<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />यो ऊ वाचा को जसो नहीं होयेंन,</para>
  <para style="q2" vid="HEB 8:9">जो मय न उन्को बापदादों को संग ऊ समय बान्धी होती,</para>
  <para style="q1" vid="HEB 8:9">जब मय ओको हाथ पकड़ क उन्ख मिस्र देश सी निकाल लायो; कहालीकि हि मोरी वाचा सी विश्वास लायक नहीं रह्यो जसो मय न उन्को संग बान्धी होती,</para>
  <para style="q2" vid="HEB 8:9">येकोलायी मय न उन पर ध्यान नहीं लगायो।<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />फिर प्रभु कह्य हय, कि जो वाचा</para>
  <para style="q2" vid="HEB 8:10">मय उन दिनो को बाद इस्राएल को घराना को संग बान्धू,</para>
  <para style="q1" vid="HEB 8:10">ऊ यो आय कि मय अपनी व्यवस्था ख उन्को मनों म डालू,</para>
  <para style="q2" vid="HEB 8:10">अऊर मय उन्को दिलो पर लिखूं,</para>
  <para style="q1" vid="HEB 8:10">अऊर मय उन्को परमेश्वर ठहरू</para>
  <para style="q2" vid="HEB 8:10">अऊर हि मोरो लोग ठहरेंन।<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />अऊर हर एक अपनो संगियों ख</para>
  <para style="q2" vid="HEB 8:11">अऊर अपनो पड़ोसी ख यो शिक्षा मत देजो,</para>
  <para style="q2" vid="HEB 8:11">कि तय प्रभु ख पहिचान,</para>
  <para style="q1" vid="HEB 8:11">कहालीकि छोटो सी बड़ो तक</para>
  <para style="q2" vid="HEB 8:11">सब मोख जान लेयेंन।<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />मय उन्को पापों ख माफ करू</para>
  <para style="q2" vid="HEB 8:12">अऊर कभी उन्को पाप याद नहीं रखू।”<verse eid="HEB 8:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 8:13" />या वाचा ख नयी वाचा कह्य क ओन पहिली वाचा ख पुरानी कर दियो अऊर जो पुरानी अऊर जीर्न होय जावय हय वा फिर जल्दीच मिट जावय हय।<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">धरती की अऊर स्वर्गीय उपासना</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />वा पहिली वाचा म भी सेवा करन को नियम होतो, तथा आदमियों को हाथों सी बनायो गयो पवित्र जागा होतो। <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />एक तम्बू बनायो गयो होतो, जेको पहिलो कमरा म दीवट होतो, अऊर मेज, अऊर जेको पर भेंट की रोटी होती; जेक पवित्र जागा कह्यो जात होतो। <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />दूसरों परदा को पीछू अऊर एक कमरा होतो, जेक परम पवित्र जागा कह्यो जात होतो। <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />ओको म सुगन्धित धूपदानी को लायी सोनो की वेदी अऊर सोनो सी मढ़्यो हुयो वाचा को सन्दूक होतो यो सन्दूक म सोनो को बन्यो मन्ना को एक बर्तन होतो, अऊर हारून की वा छड़ी जेको म अंकुर उग्यो होतो तथा दोय गोटा की पाटियों जेको पर आज्ञाये लिखी हुयी होती हि होतो। <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />सन्दूक को ऊपर परमेश्वर को उपस्थिति को महिमामय याने करूब बन्यो होतो, जो अपनो पंखा ख फैलाय क पश्चाताप को जागा पर छाया करत होतो। पर यो समय हम या बातों को विस्तार को संग चर्चा नहीं कर सकय। <figure style="fig" alt="Interior of tabernacle" file="bk00278c.tif" size="col" copy="Horace Knowles ©" ref="९:२">आराधनालय को तम्बू को अन्दर को भाग </figure><verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />सब कुछ यो तरह व्यवस्थित होय जान को बाद याजक पहिलो कमरा म हर दिन सिर कर क् अपनो सेवा को काम पूरो करत होतो, <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />पर परदा को अन्दर दूसरों कमरा म केवल मुख्य याजक साल म एकच बार जात होतो, बिना खून लियो कभी जात नहीं होतो; जेक ऊ अपनो अऊर अपनो लोगों द्वारा अनजानो म करयो गयो पापों को लायी परमेश्वर ख भेंट चढ़ावय हय। <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />येको द्वारा पवित्र आत्मा स्पष्ट रीति सी यो सिखावय हय कि जब तक अभी बाहरी तम्बू खड़ो भयो हय, तब तक परम पवित्र जागा को रस्ता अब तक खोल्यो नहीं गयो होतो। <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />यो तम्बू वर्तमान समय को लायी एक प्रतिक हय; मतलब जेको म असो दान अऊर बलिदान चढ़ायो जावय हंय, जिन्कोसी आराधना करन वालो को मनों ख शुद्ध नहीं कर सकय। <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />यो त बस खान पीवन अऊर अलग–अलग तरह की सुद्धिकरन कि प्रक्रिया यो सब बाहरी नियम आय, अऊर परमेश्वर को द्वारा नयी व्यवस्था बनावन को समय तक लायी लागु होवय हंय।<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />पर जो बाते पहिले सीच यहां असी अच्छी चिजों को मसीह पहिले सीच महायाजक बन क आय गयो हय। ऊ तम्बू जेको म ऊ सेवा करय हय, ऊ जादा अच्छो परिपूर्ण तम्बू हय ऊ आदमी को हाथों द्वारा बनायो गयो तम्बू नहाय अऊर ऊ यो जगत की निर्मिती को भाग नहाय। <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />अऊर बकरा अऊर बछड़ा को खून को द्वारा नहीं पर अपनोच खून को द्वारा, एकच बार तम्बू सी होय क महापवित्र जागा म सिरयो अऊर ओन हमरो लायी पापों सी अनन्त छुटकारा ख हासिल करयो। <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />कहालीकि जब बकरा अऊर बईलो को खून अऊर बछड़ा की राख विधि अनुसार अपवित्र लोगों पर छिड़क्यो जानो सी हि शुद्ध होय जावय हय अऊर विधि अनुसार उन्की अशुद्धता बाहरी रूप सी चली जावय हय, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />जब यो सच हय त मसीह को खून कितनो प्रभावशाली होयेंन, ओन अनन्त आत्मा अपनो आप ख एक सम्पुर्न बली को रूप म परमेश्वर ख चढ़ाय दियो हय। त ओको खून हमरी चेतना ख उन कर्मों सी शुद्ध करेंन जो मृत्यु को तरफ ले जावय हय ताकि हम जीन्दो परमेश्वर की सेवा कर सके।<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />योच वजह मसीह एक नयी वाचा को मध्यस्थ बन्यो, ताकि जिन्ख परमेश्वर द्वारा बुलायो हय, हि परमेश्वर न प्रतिज्ञा करयो हुयो अनन्त आशिषों को वारिस हो सके। अब देखो पहिली वाचा को अधीन करयो गयो पापों सी उन्ख मुक्त करावन लायी फिरोतियों को रूप म ऊ अपनो जीव दे चुक्यो हय।<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />जित तक वसीहतनामा को प्रश्न हय जेको लायी ओन ओख बनायो हय, ओकी मृत्यु ख प्रमाणित करयो जानो जरूरी हय। <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />कहालीकि कोयी वसीहतनामा केवल तब भी प्रभावित होवय हय, जब ओको करन वालो की मृत्यु होय जावय हय जब तक ओको लिखन वालो जीन्दो रह्य हय ऊ कभी प्रभावित नहीं होवय। <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />येकोलायी पहिली वाचा भी खून को इस्तेमाल को द्वाराच प्रभावी ठहरी <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />पहिले मूसा जब व्यवस्था को विधान को सब आज्ञावों ख सब लोगों ख घोषना कर चुक्यो त ओन पानी को संग बकरा अऊर बछड़ा को खून ख ले क, लाल उन अऊर हिस्सप कि टहनियों सी व्यवस्था की किताब अऊर सब लोगों पर छिड़क दियो होतो। <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />ओन कह्यो होतो, “यो ऊ वाचा को खून आय, जेक परमेश्वर न तुम्ख आज्ञा पालन करन को आदेश दियो हय।” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />अऊर योच रीति सी ओन तम्बू अऊर आराधना को पूरो सामान पर खून छिड़क्यो। <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />वास्तव म व्यवस्था को अनुसार खून सी लगभग हर चिज शुद्ध होवय हंय, अऊर बिना खून बहायो पाप की माफी नहाय।<verse eid="HEB 9:22" /></para>
  <para style="s">मसीह को बलिदान द्वारा पाप माफी</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />त फिर यो जरूरी हय कि हि चिजे जो स्वर्ग की प्रतिकृती आय, उन्ख पशुवों को बलिदानों सी शुद्ध करयो जाये पर स्वर्ग की चिजे इन सी भी उत्तम बलिदानों सी शुद्ध करयो जान की अपेक्षा करय हय। <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />कहालीकि मसीह न आदमी को हाथ को बनायो हुयो पवित्र जागा म, जो सच्चो पवित्र जागा को नमुना हय, सिरयो नहीं पर स्वर्ग म खुद सिरयो, ताकि हमरो लायी अब परमेश्वर को सामने प्रगट हो। <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />यो नहीं कि ऊ अपनो आप ख बार–बार चढ़ाये, जसो कि मुख्य याजक हर साल पशुवों को खून ले क पवित्र जागा म सिरय हय, <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />नहीं त जगत की उत्पत्ति सी ले क मसीह ख बार–बार दु:ख उठानो पड़तो; पर अब युग को आखरी म ऊ एकच बार सब को लायी प्रगट भयो हय, ताकि अपनोच बलिदान को द्वारा पाप ख दूर कर दे। <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />अऊर जसो आदमियों को लायी एक बार मरनो अऊर परमेश्वर को द्वारा न्याय को होनो जरूरी हय, <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />वसोच मसीह भी बहुतों को पापों ख उठाय लेन को लायी एक बार बलिदान भयो। अऊर जो लोग ओकी बाट देखय हंय उन्को उद्धार को लायी दूसरी बार प्रगट होयेंन त पापों ख दूर करन लायी नहीं बल्की जो ओकी बाट देख रह्यो हय उन्ख उद्धार देन लायी।<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />व्यवस्था त आवन वालो अच्छी बातों की मात्र छाव हय, पर ऊ वा वास्तविक बातों को अपनो आप म हि बुरो अऊर विश्वास लायक आदर नहाय उनच बलियों को द्वारा जिन्ख निरन्तर हर साल अनन्त रूप सी चढ़ायो जावय हंय, आराधना को जवर आवन वालो ख हमेशा को लायी सम्पुर्न सिद्ध नहीं करयो जाय सकय। <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />यदि असो होय पातो त का उन्को चढ़ायो जानो बन्द नहीं होय जातो? कहालीकि फिर त उपासना करन वालो एकच बार म हमेशा हमेशा लायी पवित्र होय जातो अऊर अपनो पापों को लायी फिर कभी खुद ख अपराधी नहीं समझय। <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />किन्तु हर साल चढ़ायो जान वाली बली आदमी ख उन्को पाप याद करावय हय। <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />कहालीकि बईलो अऊर बकरा को खून पापों ख दूर कर दे, असो सम्भव नहाय।<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />येकोलायी जब मसीह यो जगत म आयो होतो त ओन कह्य होतो,</para>
  <para style="q1" vid="HEB 10:5">“तय बलिदान अऊर भेंट नहीं चाहवय,</para>
  <para style="q2" vid="HEB 10:5">पर तय न मोरो लायी एक शरीर तैयार करयो।<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />होमबली अऊर पाप–बली सी</para>
  <para style="q2" vid="HEB 10:6">तय खुश नहीं भयो।<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />तब फिर मय न कह्यो होतो,</para>
  <para style="q2" vid="HEB 10:7">अऊर जसो व्यवस्था कि किताब म लिख्यो हय, मय यहां हय, हे परमेश्वर,</para>
  <para style="q2" vid="HEB 10:7">तोरी इच्छा पूरी करन ख आयो हय।”<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />पहिले ओन कह्यो होतो, “बलिदान अऊर भेंट अऊर होमबली अऊर पाप–बलियों ख तय नहीं चाहवय, अऊर नहीं तय उन्को सी खुश भयो होतो,” यद्दपि व्यवस्था यो चाहवय हय की हि चढ़ायो जाये। <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />फिर यो भी कह्य हय, “मय यहां हय, ताकि हे परमेश्वर तोरी इच्छा पूरी करू,” त दूसरी व्यवस्था ख स्थापित करन लायी पहिली ख रद्द कर देवय हय। <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />परमेश्वर की इच्छा सी हम यीशु मसीह को शरीर ख एकच बार बलिदान चढ़ायो जान को द्वारा पवित्र करयो गयो हंय। <figure style="fig" alt="Burnt offering on an altar" file="hk00256c.tif" size="col" copy="Horace Knowles ©" ref="१०:१०">वेदी म बलिदान </figure><verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />हर एक याजक हर दिन खड़ो होय क अपनो धार्मिक कर्तव्यों ख पूरो करय हय, अऊर एकच तरह को बलिदान ख जो पापों ख कभी भी दूर नहीं कर सकय, बार–बार चढ़ावय हय। <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />पर मसीह त याजक को रूप म पापों को लायी हमेशा को लायी बलिदान चढ़ाय क परमेश्वर को दायो हाथ जाय बैठ्यो, <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />अऊर उच समय सी अपनो दुश्मनों ख परमेश्वर को द्वारा ओको पाय को खल्लो की चौकी बनाय दियो जान की बाट देख रह्यो हय। <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />कहालीकि ओन एकच चढ़ावा को द्वारा उन्ख जो पवित्र करयो जावय हंय, हमेशा को लायी सिद्ध कर दियो हय।<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />अऊर पवित्र आत्मा भी हम्ख योच गवाही देवय हय; कहालीकि ओन पहिले कह्यो होतो,<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“प्रभु कह्य हय कि जो वाचा</para>
  <para style="q2" vid="HEB 10:16">मय उन दिनो को बाद उन्को सी बान्धू</para>
  <para style="q1" vid="HEB 10:16">ऊ यो आय कि मय अपनो व्यवस्था ख उन्को दिलो म बसाऊं</para>
  <para style="q2" vid="HEB 10:16">अऊर ओख मय उन्को मनों म लिखूं।”<note caller="+" style="f"><char style="fr" closed="false">१०:१६ </char><char style="ft" closed="false">यिर्मयाह ३१:३३</char></note><verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />फिर ऊ यो कह्य हय, “मय उन्को पापों ख अऊर उन्को अधर्म को कामों ख फिर कभी याद नहीं करू।” <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />अऊर फिर जब पाप माफ कर दियो गयो, त पापों को लायी कोयी बली की कोयी जरूरत नहीं रह जावय।<verse eid="HEB 10:18" /></para>
  <para style="s">आवो हम परमेश्वर को जवर जाये</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />येकोलायी हे भाऊवों अऊर बहिनों, कहालीकि यीशु को खून को द्वारा हम्ख ऊ परम पवित्र जागा म सिरन को निडर आत्मविश्वास हय, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />जेक ओन परदा को द्वारा मतलब जो ओको खुद को शरीर को द्वारा एक नयो अऊर जीन्दो रस्ता को माध्यम सी हमरो लायी खोल दियो हय, <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />अऊर हमरो जवर असो महान याजक हय, जो परमेश्वर को मन्दिर को अधिकारी हय, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />त आवो, हम सच्चो मन अऊर निश्चय पूरो विश्वास को संग, अऊर दिल को दोष को भावना दूर करन लायी दिल पर खून छिड़क क, अऊर शरीर ख शुद्ध पानी सी धुलाय क परमेश्वर को जवर जाये। <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />आवो हम अपनो आशा को अंगीकार ख मजबुतायी सी पकड़्यो रहे, कहालीकि जेन प्रतिज्ञा करी हय, ऊ विश्वास लायक हय; <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />तथा आवो हम ध्यान रखबो कि हम प्रेम, अऊर अच्छो कामों को लायी हम एक दूसरों की कसी मदद कर सकजे हय, <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />अऊर एक स्वभाव म आवन की अपनी आदते मत छोड़ो, जसो कि कुछ लोगों ख उत नहीं आवन की आदतच पड़ गयी हय, पर एक दूसरों ख अऊर जादा प्रोत्साहित करतो रहो; जसो कि तुम देख रह्यो हय प्रभु को दिन जवर आय रह्यो हय।<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />कहालीकि सच्चायी की पहिचान हासिल करन को बाद यदि हम जान बूझ क पाप करतो रहे, त पापों को लायी फिर कोयी बलिदान बाकी नहाय। <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />बल्की फिर त आवन वालो न्याय अऊर भीषन आगी को डर को संग बाट देखनोंच बाकी रह जावय हय जो परमेश्वर को विरोधियों ख भस्म कर देयेंन। <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />जो कोयी जब मूसा की व्यवस्था को पालन नहीं करय, ओख बिना दया दिखाये दोय यां तीन गवाहों की गवाही ख मान क, मार डाल्यो जावय हय, <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />त सोच लेवो कि ऊ कितनो अऊर भी भारी दण्ड को लायक ठहरेंन, जितनो परमेश्वर को टुरा ख पाय सी खुंद्यो अऊर वाचा को खून ख, जेको द्वारा ऊ पवित्र ठहरायो गयो होतो, अपवित्र जान्यो हय, अऊर अनुग्रह की आत्मा को अपमान करयो। <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />कहालीकि हम ओख जानजे हंय, जेन कह्यो होतो, “बदला लेनो मोरो काम आय, मयच बदला लेऊ।” अऊर फिर ऊ यो भी कह्य हय, “प्रभु अपनो लोगों को न्याय करेंन।” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />जीन्दो परमेश्वर को हाथों म पड़नो भयानक बात हय।<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />पर उन पिछलो दिनो ख याद करो, जिन म तुम परमेश्वर की ज्योति पा क, ओको बाद जब तुम दु:खों को सामना करतो हुयो कठोर संघर्ष म मजबुतायी को संग डट्यो रहे। <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />अऊर तब कभी त सब लोगों को सामने अपमानित अऊर सतायो गयो अऊर कभी जिन्को संग असो बर्ताव करयो जाय रह्यो होतो, तुम न उन्को साथ दियो। <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />कहालीकि तुम कैदियों को दु:ख म सहानुभूति रखी, अऊर अपनी जायजाद भी खुशी सी लुटन दी; यो जान क कि तुम्हरो जवर एक अऊर भी अच्छी अऊर हमेशा ठहरन वाली जायजाद हय। जो हमेशा लायी बनी रह्य हय। <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />येकोलायी अपनी हिम्मत मत छोड़ो कहालीकि ओको प्रतिफल बड़ो हय। <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />कहालीकि तुम्ख धीरज धरनो जरूरी हय, ताकि परमेश्वर की इच्छा ख पूरी कर क् अऊर जो प्रतिज्ञा करी गयी हय ओख हासिल करो। <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />“कहालीकि जसो वचन कह्य हय: बहुतच जल्दी समय म जो आवन वालो हय ऊ आयेंन, ऊ देर नहीं लगायेंन। <verse eid="HEB 10:37" /><verse number="38" style="v" sid="HEB 10:38" />पर मोरी सच्चायी सी चलन वालो लोग को विश्वास सी जीन्दो रहेंन, अऊर यदि उन्म सी कोयी पीछू हटेंन त मय ओको सी खुश नहीं रहूं।” <verse eid="HEB 10:38" /><verse number="39" style="v" sid="HEB 10:39" />पर हम पीछू हटन वालो नहाय कि नाश होय जाये बल्की उन म सी जो हय विश्वास करय हय अऊर बचायो जावय हय।<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">विश्वास</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />विश्वास को अर्थ हय, जेकी हम आशा करजे हय ओको लायी निश्चित होनो, अऊर कोयी चिज ख हम चाहे देख नहीं रह्यो होना ओको अस्तित्व को बारे म निश्चित होनोच आत्मविश्वास हय। <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />योच तरह प्राचिन काल को बुजूर्गों ख उन्को विश्वास को द्वारा परमेश्वर की सहमती हासिल भयी होती।<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">११:३ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:3">यूहन्ना १:३</ref>
      </char>
    </note>विश्वास सीच हम जान जाजे हय कि पूरो जगत की रचना परमेश्वर को शब्द को द्वारा भयी, येकोलायी जो बनायी गयी बाते दृश्य हय, ऊ दृश्य सीच नहीं बन्यो हय।<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />विश्वास को द्वारा हाबील न परमेश्वर ख कैन सी उचित बलिदान चढ़ायो होतो, अऊर ओको विश्वास को द्वाराच सच्चायी सी चलन वालो आदमी होन की परमेश्वर सी सहमती हासिल करी कहालीकि परमेश्वर खुदच ओको दाना ख स्वीकार करयो। येको मतलब हाबील विश्वास को वजह ऊ अज भी बोलय हय जब की ऊ मर चुक्यो हय।<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />विश्वास सीच हनोक उठाय लियो गयो कि मृत्यु ख बिना देखे अऊर ओख कोयी नहीं ढूंढ सक्यो कहालीकि परमेश्वर न ओख ऊपर उठाय लियो होतो शास्त्र कह्य हय की हनोक ऊपर उठायो जान सी पहिले ओन परमेश्वर ख खुश करयो होतो। <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />विश्वास को बिना परमेश्वर ख खुश करनो असम्भव हय; कहालीकि जो परमेश्वर को जवर आवय हय ओख विश्वास करनो चाहिये कि परमेश्वर को अस्तित्व हय, अऊर उन्ख प्रतिफल देवय हय जो ओख ढूंढय हय।<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />विश्वास को वजह नूह ख जब परमेश्वर न भविष्य की बातों की चेतावनी दी गयी होती, जो ओन देखी भी नहीं होती, त ओन पवित्र भयपुर्वक अपनो परिवार ख बचावन लायी एक जहाज ख बनायो होतो। परिनाम स्वरूप ओको विश्वास को द्वाराच ओन जगत ख दोषी ठहरायो अऊर विश्वास को द्वारा परमेश्वर सी आवन वाली सच्चायी ख हासिल करयो।<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />विश्वास सीच परमेश्वर न अब्राहम ख बुलायो त आज्ञा मान क असी जागा निकल गयो जेकी परमेश्वर न प्रतिज्ञा करी होती; अऊर यो नहीं जानत होतो कि ऊ कित जाय रह्यो हय, फिर भी अपनो देश छोड़ दियो। <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />विश्वास को वजह जो प्रतिज्ञा करयो हुयो धरती म ओन अनजान परदेशी को जसो अपनो मण्डप बनाय क निवास करयो। ऊ तम्बूवों म वसोच रह्यो जसो इसहाक अऊर याकूब रह्यो होतो जो ओको संग परमेश्वर की उच प्रतिज्ञा को उत्तराधिकारी होतो। <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />अब्राहम ऊ नगर की बाट देख रह्यो होतो जेक परमेश्वर न आकार दे क बनायो अऊर हमेशा मजबूत रहन वाली नीव डाली।<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />विश्वास को वजह अब्राहम जो बहुत बूढ्ढा भय गयो होतो अऊर सारा जो खुद बांझ होती परमेश्वर पर भरोसा करयो कि ऊ ओकी प्रतिज्ञा पूरी करय हय, अऊर अब्राहम बाप बन गयो। <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />यो वजह अब्राहम सीच जो मरयो हुयो जसो होतो आसमान को तारों अऊर समुन्दर की रेतु को जसो अनगिनत वंश पैदा भयो।<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />विश्वास ख अपनो मन म लियो हुयो हि पूरो लोग मर गयो जिन चिजे की परमेश्वर न प्रतिज्ञा करी होती उन्न या चिजे नहीं पायी उन्न बस दूर सीच देख्यो अऊर उन्को स्वागत करयो या उन्न यो खुलो तौर सी मान लियो कि हि यो धरती पर परदेशी अऊर अनजानो हय। <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />हि लोग असी बाते कह्य हय कि हि यो दिखावय हय कि हि एक असो देश कि खोज म हय जो उन्को अपनो आय। <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />जो देश उन्न छोड्यो हय उन्ख सोचतो रहतो त फिर सी लौटन को अवसर रहतो। <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />पर हि एक अच्छो मतलब स्वर्गीय देश को अभिलाषा हंय; येकोलायी परमेश्वर उन्को परमेश्वर कहलावन म नहीं लजावय, कहालीकि ओन उन्को लायी एक नगर तैयार करयो हय।<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />विश्वास कोच वजह अब्राहम न, जब परमेश्वर ओकी परीक्षा ले रह्यो होतो, अपनो बेटा इसहाक ख बलिदान को रूप म भेंट दियो; अब्राहम ऊ होतो जेक परमेश्वर न प्रतिज्ञा दी होती फिर भी ऊ अपनो एकलौतो बेटा ख बली चढ़ावन लायी तैयार होतो। <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />त ओख यद्दपि परमेश्वर न कह्यो होतो, “इसहाक सीच तोरो वंश बढ़ेंन,” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />अब्राहम न सोच्यो होतो परमेश्वर इसहाक ख मरयो हुयो म सी भी जीन्दो कर सकय हय, अऊर वसो देख्यो जाय त एक तरह सी अब्राहम न इसहाक ख मरयो हुयो म सी फिर वापस पा लियो।<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />विश्वास को वजह इसहाक न याकूब अऊर एसाव ख ओको भविष्य को बारे म आशीर्वाद दियो।<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />विश्वास सीच याकूब न मरतो समय यूसुफ को दोयी बेटावों म सी एक एक ख आशीष दियो, अऊर अपनी लाठी को कोना को सहारा ले क परमेश्वर की आराधना करी।<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />विश्वास सीच यूसुफ न, जब ऊ मरन पर होतो, त इस्राएलों ख निकल जान को बारे म ओन बोल्यो होतो, अऊर अपनी अस्थियों को संग का करनो चाहिये ओको आज्ञा दियो।<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />विश्वास सीच मूसा को माय बाप न ओख, पैदा होन को बाद तीन महीना तक लूकाय रख्यो, कहालीकि उन्न देख्यो कि बच्चा सुन्दर हय, अऊर हि राजा की आज्ञा तोड़न सी नहीं डरयो।<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />विश्वास सीच मूसा न बड़ो होय क फिरौन की बेटी को टुरा कहलावन सी इन्कार करयो। <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />येकोलायी कि ओख पाप म थोड़ो दिन को सुख भोगन सी परमेश्वर को लोगों को संग दु:ख भोगनो जादा उत्तम लग्यो। <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />ओन मसीह को वजह निन्दित होन को मिस्र को भण्डार सी बड़ो धन समझ्यो, कहालीकि ओकी आंखी भविष्य को प्रतिफल पान को तरफ लगी होती।<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />विश्वास सीच राजा को गुस्सा सी नहीं डर क ओन मिस्र ख छोड़ दियो, कहालीकि ऊ अनदेखा ख मानो ओख अदृश्य परमेश्वर दिख रह्यो हय। <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />विश्वास सीच ओन फसह को त्यौहार अऊर दरवाजा पर खून छिड़कन को पालन करयो, ताकि मृत्यु को दूत इस्राएलियों की पहिली सन्तान ख नहीं मार सके।<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />विश्वास सीच हि इस्राएली लाल समुन्दर को पार असो उतर गयो, जसो सूखी जमीन पर सी; अऊर जब मिस्रियों न वसोच करनो चाह्यो त सब पानी म डुब मरयो।<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />विश्वास सीच यरीहो की भीती, जब हि सात दिन तक ओको इस्राएलियों न चारयी तरफ चक्कर लगाय चुक्यो, त वा गिर पड़ी। <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />विश्वास सीच राहब वेश्या परमेश्वर की आज्ञा नहीं मानन वालो को संग मारी नहीं गयी होती, कहालीकि ओन इस्राएली जासूसों को मित्रता पुर्वक स्वागत करयो होतो।<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />अब मय अऊर जादा का कहूं? कहालीकि समय नहीं रह्यो कि गिदोन, बाराक, शिमशोन, इफतह, दाऊद, शमूएल, अऊर भविष्यवक्तावों को वर्नन करू। <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />इन्न विश्वास सीच राज्य जीत लियो; जो सच्च हय उच काम करयो; तथा जो परमेश्वर की प्रतिज्ञाये दी ओख हासिल करयो; उन्न सिंहों को मुंह बन्द करयो; <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />धधकती आगी की लपटो ख शान्त करयो; तलवार की धार सी बच निकल्यो; कमजोरियों म बलवन्त भयो; लड़ाई म वीर निकल्यो; विदेशियों की फौजों ख हरायो।<verse eid="HEB 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 11:35" />विश्वास को द्वारा बाईयों न अपनो मरयो हुयो रिश्तेदारों ख फिर जीन्दो पायो; कितनो त सतातो हुयो मारयो गयो अऊर छुटकारा नहीं चाह्यो, ताकी हि अच्छो जीवन को पुनरुत्थान पा सकेंन। <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />कुछ त ठट्ठा उड़ायो जानो म; कोड़ा को सामना करनो पड़्यो जब कुछ ख जंजीरो सी जकड़ क जेलखाना म डाल दियो गयो। <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />उन पर पथराव करयो गयो; उन्ख चीर क दोय भाग कर दियो गयो; उन्ख तलवार सी मारयो गयो; हि गरीब होतो, उन्ख यातनायें दी गयी, अऊर उन्को संग बुरो व्यवहार करयो गयो हि मेंढा अऊर शेरीयों की खाल ओढ़ क इत उत भटकत होतो; <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />अऊर मरूस्थलों, पहाड़ियों, गुफावों, अऊर धरती की फूटो म भटकतो फिरयो। जगत उन्को लायक नहीं होतो।<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />विश्वास सीच उन्को लेखा जोखा रख्यो गयो। फिर भी परमेश्वर न करी हुयी बाते अऊर प्रतिज्ञा करी हुयी चिजे नहीं मिली। <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />कहालीकि परमेश्वर न हमरो लायी पहिले सीच एक उत्तम योजना ठहरायी होती, ओको यो होतो कि हि भी हमरो संगच सम्पुर्न सिद्ध करयो जाय।<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">परमेश्वर हमरो बाप</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />जित तक हम गवाहों को इतनो बड़ो बादर सी घेरयो हुयो हय, त फिर आवो बाधाये डालन वाली हर एक चिज ख अऊर ऊ पाप ख जो सहजता सी हम्ख उलझाय देवय हय ओख फेक दे, अऊर आवो वा दौड़ जो हम्ख दौड़नो हय, ओख धीरज को संग दौड़े, <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />अऊर हमरो विश्वास को कर्ता अऊर सिद्ध करन वालो यीशु को तरफ अपनी आंखी लगायी। जेन अपनो सामने उपस्थित खुशी लायी क्रूस की यातनायें झेली, ओकी लज्जा की कोयी चिन्ता नहाय की अऊर परमेश्वर को सिंहासन को दायो तरफ विराजमान भय गयो।<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />येकोलायी ओको पर ध्यान करो, जेन अपनो विरोध म पापियों को इतनो विरोध सह लियो कि तुम निराश होय क हिम्मत मत छोड़ देवो। <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />तुम न पाप को विरुद्ध म संघर्ष करतो हुयो, तुम्ख इतनो नहीं सहनो पड़ेंन कि तुम्ख अपनो खून बहानो पड़ेंन; <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />का तुम ऊ प्रोत्साहन को शब्द ख जो परमेश्वर न ओको टुरा जान क तुम सी कह्यो का तुम भूल गयो हय:</para>
  <para style="q1" vid="HEB 12:5">“हे मोरो टुरा, जब परमेश्वर तोख सुधारय त ध्यान लगाव,</para>
  <para style="q2" vid="HEB 12:5">अऊर जब ऊ तोख ताड़ना करेंन त निराश मत हो।<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />कहालीकि प्रभु जेकोसी प्रेम करय हय,</para>
  <para style="q2" vid="HEB 12:6">अऊर जेक टुरा बनाय लेवय हय, ओख सजा भी देवय हय।”<verse eid="HEB 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 12:7" />तुम दु:ख ख ताड़ना समझ क सह लेवो; परमेश्वर तुम ख बेटा जान क तुम्हरो संग बर्ताव करय हय। ऊ कौन सो बेटा आय जेकी ताड़ना बाप नहीं करय? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />यदि तुम्ख ताड़ना नहीं दी गयी हय जसो सब ताड़ना को भागी होवय हय, त तुम अपनो बाप सी पैदा हुयो टुरा नोहोय त तुम सच्ची सन्तान नोहोय। <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />फिर जब कि हमरो शारीरिक बाप भी हमरी ताड़ना करत होतो अऊर हम न उन्को आदर करयो। त का आत्मिक बाप को अधीन रह्य क जीवन नहीं जीबो। <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />हमरो शारीरिक बापदादों न जसो उन्न उत्तम समझ्यो हम्ख ताड़ना करी पर परमेश्वर हमरी भलायी लायी ताड़ना करय हय जेकोसी हम ओकी पवित्रता को सहभागी होय सके। <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />वर्तमान म हर एक तरह की ताड़ना खुशी की नहीं, पर दु:ख की बात लगय हय; तब भी जो ओख सहतो सहतो पक्को भय गयो हय, तब उन्ख सच्चायी, जीवन अऊर शान्ति को प्रतिफल मिलय हय।<verse eid="HEB 12:11" /></para>
  <para style="s">उपदेश अऊर चेतावनी</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />येकोलायी थक्यो हाथों ख उठावों अऊर कमजोर घुटना ख मजबूत करो, <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />अऊर अपनो पाय लायी सीधो रस्ता बनावो कि लंगड़ा भटक नहीं जाये पर भलो चंगो होय जाये।<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />सब को संग शान्ति को संग रहन अऊर पवित्र जीवन जीन लायी हर तरह सी कोशिश म रहो कहालीकि येको बिना कोयी भी प्रभु ख देख नहीं सकेंन। <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />अपनो आप की चौकसी करो ताकी कोयी परमेश्वर को अनुग्रह सी पीछू कड़वो रोप की जड़ी को जसो मत बड़ो ताकी ओको जहेर सी बहुत समस्या पैदा मत होय जाये। <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />कोयी भी अनैतिक अऊर अधार्मिक एसाव को जसो नहीं हो जेन एक बार को जेवन को बदला अपनो बड़ो बेटा होन को अधिकार बेच डाल्यो। <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />तुम जानय हय कि बाद म जब ओन अपनो बाप सी आशीर्वाद पानो चाह्यो त असफल गिन्यो गयो, अऊर रोय रोय क ओन आशीर्वाद पानो चाह्यो त पश्चाताप नहीं मिल्यो।<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />तुम आगी सी जलतो हुयो सिय्योन पहाड़ी को जवर नहीं आयो, जेक महसुस करयो जाय सकत होतो अऊर नहीं अन्धारो अऊर नहीं उदासिनता अऊर नहीं बवंडर को जवर आयो हय। जसो इस्राएली लोग आयो होतो। <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />अऊर तुरही की आवाज, अऊर बोलन वालो को असो शब्द को जवर नहीं आयो, जेको सुनन वालो न बिनती करी की अब हम सी अऊर बाते नहीं करी जाये। <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />कहालीकि हि ऊ आज्ञा ख नहीं सह सक्यो: “यदि कोयी भी प्रानी पहाड़ी ख छूवय त ओको पर पथराव करयो जाये।” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />अऊर ऊ दृश्य असो डरावनो होतो कि मूसा न कह्यो, “मय बहुत भयभित अऊर थर थर काप रह्यो हय।”<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />पर तुम सिय्योन पहाड़ी, जीन्दो परमेश्वर को नगर, स्वर्गीय यरूशलेम अऊर हजारों स्वर्गदूतों की सभा म आय पहुंच्यो हय। <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />तुम परमेश्वर सी पहिले जनम्यो हुयो जिन्को नाम स्वर्ग म लिख्यो हुयो हंय, उन्की सभा म पहुंच चुक्यो हय। तुम ऊ परमेश्वर को जवर आयो हुयो हय जो सब लोगों को न्याय करय हय ताकी सच्चो लोगों की आत्मावों सिद्ध करे, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />अऊर एक नयी वाचा को मध्यस्थ को यीशु अऊर छिड़काव को ऊ खून को जवर आयो चुक्यो हय, जो हाबील को खून की उम्मीद उत्तम चिजों की प्रतिज्ञा करय हय।<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />सावधान रहो, अऊर ऊ कहन वालो सी मुंह मत फिरावो, कहालीकि हि लोग जब धरती पर को चेतावनी देन वालो सी मुंह फेर क नहीं बच सके, त हम स्वर्ग पर सी चेतावनी देन वालो सी नकार क् कसो बच सकेंन? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />ऊ समय त ओको शब्द न धरती ख हिलाय दियो, पर अब ओन या प्रतिज्ञा करी हय, “एक बार फिर मय केवल धरती ख बल्की आसमान ख भी हिलाय देऊ।” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />अऊर यो शब्द “एक बार फिर” ऊ हर चिज को तरफ अंकित करय हय जो बाते निर्मित करी गयी हय वा हिलायी जायेंन अऊर अस्थिर रहेंन ताकी जो बाते हिलायी नहीं जाय सकय वा बनी रहेंन।<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />फिर जब हम्ख एक असो राज्य मिल रह्यो हय, जेक हिलायो नहीं जाय सकय, त आवो हम धन्यवादी बने अऊर आदर मिश्रित डर को संग परमेश्वर की उपासना करे, ताकी परमेश्वर ओख स्वीकार करे। <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />कहालीकि हमरो परमेश्वर भस्म करन वाली आगी आय।<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">परमेश्वर ख खुश करनो</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />एक दूसरों म भाईचारा की प्रेम बन्यो रहे। <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />अनजानो लोगों को सत्कार करनो मत भूलो। कहालीकि स्वर्गदूतों को आदर सत्कार करयो हय। <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />कैदियों की असी सुधि लेवो कि मानो उन्को संग तुम भी कैद हय, अऊर जिन्को संग बुरो बर्ताव करयो जावय हय, उनकी यो तरह सुधि लेवो जसो मानो तुम खुद पिड़ित हय।<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />बिहाव को सब ख आदर करनो चाहिये अऊर पति अऊर पत्नी विश्वास लायक रहे कहालीकि परमेश्वर व्यभिचारियों को न्याय करेंन।<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />तुम्हरो स्वभाव धन सी प्रेम करन वालो नहीं हो, अऊर जो तुम्हरो जवर जो हय ओको म सन्तुष्ट करो; कहालीकि परमेश्वर न खुदच कह्यो हय, “मय तोख कभी नहीं छोड़ूं, अऊर नहीं कभी तोख त्यागूं।”<note caller="+" style="f"><char style="fr" closed="false">१३:५ </char><char style="ft" closed="false">व्यवस्थाविवरन ३१:६</char></note> <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />येकोलायी हम निडर होय क कहजे हंय,</para>
  <para style="q1" vid="HEB 13:6">“प्रभु मोरो सहायक आय,</para>
  <para style="q2" vid="HEB 13:6">मय नहीं डरू।</para>
  <para style="q1" vid="HEB 13:6">आदमी मोरो का कर सकय हय।”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />जो तुम्हरो अगुवा होतो, अऊर जिन्न तुम्ख परमेश्वर को वचन सुनायो हय, उन्ख याद रखो; अऊर ध्यान सी उन्को चाल चालन को अन्त देख क उन्को विश्वास को अनुकरन करो। <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />यीशु मसीह कल अऊर अज अऊर हमेशा हमेशा एक जसो हय। <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />हर तरह की विचित्र शिक्षावों सी भरमायो मत जावो, हमरो दिलो को लायी यो अच्छो हय हि अनुग्रह को द्वारा मजबूत बने नहीं की खान पीवन सम्बन्धित नियमों ख माननो सी, जिन्कोसी उन्को कभी कोयी फायदा नहीं भयो जिन्न उन्ख मान्यो।<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />हमरी एक असी वेदी हय जेको पर खान को अधिकार ऊ याजकों ख नहाय, जो तम्बू म सेवा करय हंय। <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />कहालीकि जिन जनावरों को खून महायाजक पाप-बलि लायी महापवित्र जागा म लिजावय हय, अऊर उन जनावरों को शरीर तम्बूवों को छावनी को बाहेर जलायो जावय हंय। <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />योच वजह, यीशु न भी शहर को द्वार को बाहेर मरयो ताकि लोग पापों सी ओको खून को द्वारा शुद्ध होय सके। <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />त फिर आवो, ओको जवर छावनी को बाहेर चले अऊर ओको अपमान म सहभागी हो। <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />कहालीकि यहां धरती पर हमरो कोयी स्थायी नगर नहाय, बल्की हम आवन वालो एक नगर की खोज म हंय। <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />चलो आवो हम यीशु को द्वारा परमेश्वर की स्तुतिरूपी बलिदान अर्पन करे, जो उन होठों को फर हय जिन्न कबूल करयो। <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />भलायी करनो अऊर एक दूसरों की मदत करनो मत भूलो, कहालीकि परमेश्वर असोच बलिदान सी खुश होवय हय।<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />अपनो अगुवों की आज्ञा मानो अऊर उन्को आदेशों पर चलो। कहालीकि हि तुम पर बिना आराम करे असी चौकसी रखय हय, जसो मानो उन्ख अपनो कामों को लेखा जोखा परमेश्वर ख देना हय। यदि तुम उन्की आज्ञा मानो त हि खुशी को संग अपनो काम करे; यदि तुम नहीं मानो त दु:ख को संग मददगार साबित नहीं होयेंन।<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />हमरो लायी प्रार्थना करतो रहो, कहालीकि हम्ख भरोसा हय कि हमरो अन्तरमन शुद्ध हय: हम सब बातों म अच्छी चाल चलनो चाहजे हंय। <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />मय तुम सी आग्रह करू हय की तुम प्रार्थना करतो रहो ताकी मय जल्दीच तुम्हरो जवर आय सकू हय।<verse eid="HEB 13:19" /></para>
  <para style="s">आखरी प्रार्थना</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />जेन मेंढियों को ऊ महान चरवाहा हमरो प्रभु यीशु को खून द्वारा ऊ अनन्त काल की वाचा पर मुहर लगाय क मरयो हुयो म सी जीन्दो करयो, ऊ शान्ति दाता परमेश्वर। <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />तुम्ख सब अच्छी साधनो सी सम्पन्न करे, जेकोसी तुम ओकी इच्छा पूरी कर सको, अऊर यीशु मसीह को द्वारा ऊ हमरो अन्दर ऊ सब कुछ सक्रिय करे जो ओख भावय हय। ओकी महिमा हमेशा हमेशा होती रहे। आमीन।<verse eid="HEB 13:21" /></para>
  <para style="s">आखरी शब्द</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />हे भाऊवों अऊर बहिनों, मय तुम सी आग्रह करू हय कि यो प्रोत्साहन को सन्देश ख धीरज को संग सुनो, कहालीकि या चिट्ठी जो मय न तुम्हरो लायी लिखी गयी हय जादा लम्बी नहाय। <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />मय चाहऊ हय कि तुम्ख यो ज्ञात हो कि हमरो भाऊ तीमुथियुस, जेल सी छूट गयो हय। अऊर यदि ऊ जल्दीच आय गयो त मय ओको संग तुम सी भेंट करू।<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />अपनो सब अगुवों अऊर सब परमेश्वर को लोगों ख हमरो नमस्कार कहजो। इटली वालो विश्वासी लोग तुम्ख नमस्कार कह्य हंय।<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />तुम सब पर परमेश्वर को अनुग्रह होतो रहे। आमीन।<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>