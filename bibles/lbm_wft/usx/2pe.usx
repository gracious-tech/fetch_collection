<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Lodhi</book>
  <para style="h">२ पतरस</para>
  <para style="toc3">२ पतरस</para>
  <para style="toc2">२ पतरस</para>
  <para style="toc1">पतरस की दूसरी चिट्ठी</para>
  <para style="mt2">पतरस की दूसरी पत्री</para>
  <para style="mt1">पतरस की दूसरी चिट्ठी</para>
  <para style="imt">परिचय</para>
  <para style="ip">दूसरों पतरस की चिट्ठी म कह्यो गयो हय कि यो प्रेरित पतरस द्वारा लिख्यो गयो होतो, पर अज को कुछ विद्वानों ख यो नहीं लगय कि यो सच आय। यो सम्भव हय कि कोयी अऊर न येख पतरस को तरफ सी लिखी हो। लेखक कह्य हय कि ऊ यीशु को जीवन अऊर पूरो रूप सी बदलाव <char style="xt"><ref loc="2PE 1:17-18">१:१७-१८</ref> </char>को लायी एक गवाह होतो। अगर पतरस न चिट्ठी म लिख्यो होतो त सम्भव हय कि ओन रोम म ६५-६९ साल बाद मसीह को जनम को बाद लिख्यो होतो। पतरस न १ पतरस की चिट्ठी को बाद लिखन की तारिख रख क अपनी दूसरी चिट्ठी <char style="xt"><ref loc="2PE 3:1">३:१</ref></char> म भी कह्यो। उन्न सब मसीहियों ख चिट्ठी सी सम्बोधित करयो।</para>
  <para style="ip">पतरस न या चिट्ठी को अच्छो जीवन जीन लायी प्रोत्साहित करन अऊर झूठो शिक्षकों को पालन नहीं करन लायी चेतावनी देन लायी लिख्यो होतो <char style="xt"><ref loc="2PE 2">२</ref></char>। उन्न उन्ख उन लोगों ख अनदेखो करन लायी प्रोत्साहित करयो जो कर रह्यो हय कि यीशु फिर सी आवन म बहुत लम्बो समय ले रह्यो हय। येको बजाय उन्न निर्देश करयो कि परमेश्वर धीमो नहाय बल्की सब ख बचानो चाहवय हय <char style="xt"><ref loc="2PE 3:8-9">२ पतरस ३:८-९</ref>।</char> या एक अच्छी जीवन जीन को एक वजह आय <char style="xt"><ref loc="2PE 3:14">३:१४</ref>।</char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. पतरस खुद ख पेश करय हय अऊर अपनो पढ़न वालो ख सम्बोधित करय हय। <char style="ior"><ref loc="2PE 1:1-2">१:१-२</ref> </char></para>
  <para style="io1">२. तब ऊ उन्ख अच्छो जीवन जीन कि याद दिलावय हय कहालीकि परमेश्वर न हम्ख मजबूत करयो हय। <char style="ior"><ref loc="2PE 1:3-21">१:३-२१</ref></char></para>
  <para style="io1">३. बाद म ऊ झूठो शिक्षकों को खिलाफ चेतावनी देवय हय अऊर कह्य हय कि आखरी म झूठो शिक्षकों को संग का होयेंन। <char style="ior"><ref loc="2PE 2:1-22">२:१-२२</ref> </char></para>
  <para style="io1">४. ओको जवर पतरस यीशु को दूसरों बार आवन लायी तैयार रहन लायी विश्वासियों ख प्रोत्साहित करयो। <char style="ior"><ref loc="2PE 3:1-17">३:१-१७</ref></char></para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="s">अभिवादन</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />शिमोन पतरस को तरफ सी, जो यीशु मसीह को सेवक अऊर प्रेरित हय, उन लोगों को नाम जिन्न हमरो परमेश्वर अऊर उद्धारकर्ता यीशु मसीह को सच्चायी द्वारा हमरो जसो बहुमूल्य विश्वास प्राप्त करयो हय।<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />परमेश्वर को तरफ हमरो प्रभु यीशु को पहिचान को द्वारा अनुग्रह अऊर शान्ति तुम म बहुतायत सी बढ़ती जाये।<verse eid="2PE 1:2" /></para>
  <para style="s">ईश्वरीय बुलाहट अऊर चुनाव</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />कहालीकि परमेश्वर ईश्वरीय सामर्थ न सब कुछ जो जीवन अऊर भक्तिमय जीवन बितावन लायी हय, हम्ख ओकीच पहिचान को द्वारा दियो हय, जेन हम्ख अपनीच महिमा अऊर सद्गुनों को अनुसार बुलायो हय। <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />जिन्को द्वारा ओन हम्ख बहुमूल्य अऊर बहुतच बड़ी प्रतिज्ञा दी हंय: ताकि इन्को द्वारा तुम ऊ भ्रष्टता सी छूट क, जो जगत म बुरी अभिलाषावों सी होवय हय, ईश्वरीय स्वभाव को सहभागी होय जावो। <verse eid="2PE 1:4" /><verse number="5" style="v" sid="2PE 1:5" />येकोलायी तुम सब तरह को यत्न कर क् अपनो विश्वास म सद्गुनों ख जोड़ो, अऊर सद्गुनों म ज्ञान ख, <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />अऊर अपनो ज्ञान म आत्म संय्यम ख जोड़ो, अऊर आत्म संय्यम म धीरज ख, अऊर धीरज म परमेश्वर की भक्ति ख जोड़ो, <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />अऊर तुम्हरो परमेश्वर की भक्ति म मसीह भाईचारा ख; अऊर मसीह भाईचारा म प्रेम ख जोड़ो। <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />यो पूरो गुनो की तुम्ख जरूरत हय अऊर यदि यो गुन तुम म यदि बहुतायत सी हय त यो तुम्ख हमरो प्रभु यीशु मसीह को ज्ञान क्रियाशिल अऊर प्रभावशिल बनायेंन। <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />पर यदि तुम म या बाते नहाय, त तुम्ख दूर नजर नहाय तुम अन्धा हय, मतलब तुम भूल गयो हय की अपनो पूर्व पापों ख धोयो जाय चुक्यो हय।<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />येकोलायी हे भाऊवों अऊर बहिनों, अपनो बुलायो जानो, अऊर चुन लियो जानो ख सिद्ध करन को भली भाति यत्न करतो जावो, कहालीकि यदि असो करो त कभी भी ठोकर नहीं खावो; <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />बल्की यो रीति सी तुम हमरो प्रभु अऊर उद्धारकर्ता यीशु मसीह को अनन्त राज्य म बड़ो आदर को संग सिरनो पावों।<verse eid="2PE 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />येकोलायी तुम या बाते जानय हय, अऊर जो सत्य वचन तुम्ख मिल्यो हय ओको म बन्यो रह्य हय, तब भी मय तुम्ख इन बातों की याद दिलावन ख हमेशा तैयार रहूं। <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />मय यो अपनो लायी उचित समझू हय कि जब तक मय यो शरीर म जीन्दो हय, तब तक मय तुम्ख या बात म याद दिलातो रहूं। <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />कहालीकि यो जानु हय कि बहुत जल्दी मय अपनो नाशवन्त शरीर छोड़न वालो हय। जसो कि हमरो प्रभु यीशु मसीह न मोख बतायो होतो। <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />येकोलायी मय अपनो जोर लगाऊं कि मोरो मर जान को बाद भी तुम इन सब बातों ख हमेशा याद कर सको।<verse eid="2PE 1:15" /></para>
  <para style="s">मसीह की महिमा को आंखी देख्यो गवाह</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />कहालीकि जब हम न तुम्ख अपनो प्रभु यीशु मसीह की सामर्थ को अऊर आगमन को समाचार दियो होतो, त ऊ चालाकी सी गढ़ी हुयी कहानियों को अनुकरन नहीं होतो बल्की हम न खुदच ओकी महानता ख देख्यो होतो। <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" /><note caller="+" style="x"><char style="xo" closed="false">१:१७ </char><char style="xt" closed="false"><ref loc="MAT 17:1-5">मत्ती १७:१-५</ref>; <ref loc="MRK 9:2-7">मरकुस ९:२-७</ref>; <ref loc="LUK 9:28-35">लूका ९:२८-३५</ref></char></note>कहालीकि जब ओन परमेश्वर पिता सी आदर अऊर महिमा पायी अऊर ऊ प्रतापमय महिमा म सी यो शब्द आयो, “यो मोरो प्रिय बेटा आय, जेकोसी मय खुश हय।” <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />तब हम ओको संग पवित्र पहाड़ी पर होतो अऊर आसमान सी आयी या वानी सुनी।<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />हमरो जवर जो भविष्यवक्तावों को वचन हय, ऊ यो घटना सी ठहरयो। तुम यो अच्छो करय हय जो यो समझ क ओको पर ध्यान करय हय कि ऊ एक दीया आय, जो अन्धारो जागा म ऊ समय तक उजाड़ो देतो रह्य हय जब तक कि पौ नहीं फटे अऊर भुन्सारे को तारा तुम्हरो दिल म चमक नहीं उठय। <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />सब सी बड़ी बात या हय कि तुम्ख यो जान लेनो चाहिये कि पवित्र शास्त्र कि कोयी भी बड़ी भविष्यवानी कोयी भविष्यवक्ता को खुद को बिचार सी दियो गयो स्पष्टिकरन नोहोय, <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />कहालीकि कोयी भी भविष्यवानी आदमी की इच्छा सी कभी नहीं भयी, पर भक्त लोग पवित्र आत्मा को द्वारा प्रभावित होय क परमेश्वर को तरफ सी बोलत होतो।<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">झूठो शिक्षक</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />जसो भूतकाल को लोगों को बीच म झूठो भविष्यवक्ता होतो, ऊ भटकावन वालो असत्य सिद्धता ख लायेंन, अऊर ऊ मालिक को जेन उन्ख छुड़ायो अऊर असो कर क् अपनो विनाश ख जल्दी नेवता देयेंन। <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />फिर भी बहुत सारो लोग उन्को रस्ता पर चलेंन; अऊर कहालीकि जो हि करय हय, उन्को वजह सी दूसरी बुरी बातों ख सच्चायी को जागा बोलेंन। <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />हि लोभ को लायी बाते बनाय क तुम्ख अपनो फायदा को वजह बनायेंन, अऊर जो सजा की आज्ञा उन पर पहिले सी भय गयी हय, ओको आनो म कुछ भी देर नहाय, अऊर उन्को विनाश सक्रिय हय।<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />कहालीकि जब परमेश्वर न उन स्वर्गदूतों ख जिन्न पाप करयो, उन्ख भी नहीं छोड़्यो, पर नरक म भेज क अन्धारो कुण्ड म जंजीरो सी जकड़ दियो ताकि न्याय को दिन तक बन्दी रहे; <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />अऊर बुजूर्ग युग को जगत ख भी नहीं छोड़्यो बल्की भक्तिहीन जगत पर महा जल-प्रलय भेज्यो, पर सच्चायी को प्रचार करन वालो नूह अऊर सात आदमियों ख बचाय लियो; <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />अऊर सदोम अऊर अमोरा को नगरो ख आगी सी सजा दे क आगी सी भस्म कर दियो ताकि हि आवन वालो भक्तिहीन लोगों की शिक्षा को लायी एक दृष्टान्त बने, <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />अऊर सच्चो लूत ख जो गैरयहूदियों को अनैतिक चाल चलन सी बहुत दु:खी होतो छुटकारा दियो। <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />कहालीकि ऊ सच्चो उन्को बीच म रहतो हुयो अऊर उन्को अधर्म को कामों ख देख देख क अऊर सुन क, हर दिन अपनो सच्चो मन ख पीड़ित करत होतो। <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />त प्रभु भक्तो ख परीक्षा म सी छुड़ाय लेयेंन अऊर अधर्मियों ख न्याय को दिन तक सजा की दशा म रखनो भी जानय हय, <verse eid="2PE 2:9" /><verse number="10" style="v" sid="2PE 2:10" />विशेष कर क् उन्ख जो अशुद्ध अभिलाषावों को पीछू शरीर को अनुसार चलतो अऊर प्रभुता ख तुच्छ जानय हंय।</para>
  <para style="p" vid="2PE 2:10">हि ढीठ अऊर हठी हंय, अऊर ऊचो पद वालो ख बुरो भलो कहनो सी नहीं डरय, अऊर उनकी निन्दा करय हय। <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />तब भी स्वर्गदूत जो शक्ति अऊर सामर्थ म झूठो शिक्षकों सी बड़ो हंय, प्रभु को आगु उन्ख बुरो भलो कह्य क दोष नहीं लगावय। <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />पर हि लोग निर्बुद्धि जनावर को जसो हंय, जो पकड़्यो जानो अऊर नाश होन को लायी पैदा भयो हंय; अऊर जिन बातों ख जानयच नहाय उन्को बारे म दूसरों ख बुरो भलो कह्य हंय, हि जंगली जनावर को जसो नाश कर दियो जायेंन। <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />दूसरों को अन्याय करन को बदला उन्कोच अन्याय होयेंन। उन्ख दिन दोपहर भोग-विलाश करनो भलो लगय हय। हि लोग कलंकित अऊर अपराधी हंय; जब हि तुम्हरो संग खावय-पीवय हंय, त हि धोकाधड़ी सी अपनो तरफ सी प्रेम भोज कर क् भोग-विलाश करय हंय। <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />उन्की आंखी म व्यभिचार बस्यो हुयो हय, अऊर हि पाप करयो बिना रुक नहीं सकय। हि कमजोर लोगों ख जार म फसाय लेवय हंय। उन्को मन ख लोभ करन को अभ्यास होय गयो हय; हि परमेश्वर को श्राप म हंय। <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />हि सीधी रस्ता ख छोड़ क भटक गयो हंय, अऊर बओर को बेटा बिलाम की रस्ता पर होय गयो हंय, जेन अधर्म की मजूरी ख प्रिय जान्यो; <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />अऊर ओको पाप को बारे म ओख फटकार पड़ी, यहां तक कि अबोल गधी न आदमी की बोली सी ऊ भविष्यवक्ता ख ओको बावलोपन सी रोक्यो।<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />हि लोग सूखो कुंवा, अऊर तूफान को उड़ायो हुयो बादर आय; परमेश्वर न उन्को लायी अनन्त गहरो अन्धकार ठहरायो गयो हय। <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />हि बेकार घमण्ड की बाते कर कर क् अनैतिक को कामों को द्वारा, उन लोगों ख जो भटक्यो हुयो म सी निकलन को सुरूवातच कर रह्यो होतो उन्ख शारीरिक अभिलाषावों म फसाय लेवय हंय। <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />हि उन्ख स्वतंत्र करन की प्रतिज्ञा त करय हंय, पर खुदच भ्रष्टता को सेवक हंय; कहालीकि जो आदमी जेकोसी हार गयो हय, ऊ ओको सेवक बन जावय हय। <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />जब हि प्रभु अऊर उद्धारकर्ता यीशु मसीह की पहिचान को द्वारा जगत की नाना तरह की अशुद्धता सी बच निकल्यो, अऊर फिर उन्म फस क हार गयो, त उन्की पिछली दशा पहिली सी भी बुरी भय गयी हय। <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />कहालीकि सच्चायी को रस्ता ख नहीं जाननोच ओको लायी येको सी भलो होतो कि ओख जान क, ऊ पवित्र आज्ञा सी फिर जातो जो उन्ख सौंपी गयी होती। <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />उन पर यो कहावत सही बैठय हय, कि कुत्ता अपनी उल्टी को तरफ अऊर धुलायी हुयी डुक्करनी चीखल म सोवन लायी फिर चली जावय हय।<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">प्रभु को दुबारा आवन की वाचा</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />हे प्रिय संगियों, अब मय तुम्ख यो दूसरी चिट्ठी लिखूं हय, अऊर दोयी म याद दिलाय क तुम्हरो शुद्ध मन ख जागृत करू हय; <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />कि तुम उन बातों ख जो पवित्र भविष्यवक्तावों न पहिले सी कहीं हय, अऊर प्रभु अऊर उद्धारकर्ता की ऊ आज्ञा ख याद करो जो तुम्हरो प्रेरितों को द्वारा दी गयी होती। <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" /><note caller="+" style="x"><char style="xo" closed="false">३:३ </char><char style="xt" closed="false"><ref loc="JUD 1:18">यहूदा १:१८</ref></char></note>सब सी पहिले यो जान लेवो कि आखरी दिनो म हसी उड़ावन वालो आयेंन जो अपनीच अभिलाषावों को अनुसार चलेंन <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />अऊर पुछेंन कि, “ओन आवन की वाचा करी होती, का ओन नहीं करी होती? कित हय ऊ? हमरो बापदादा पहिले सी मर चुक्यो हंय, पर जब सी सृष्टि बनी हय सब बाते वसी कि वसी चली आय रही हय।” <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />हि त जान बूझ क यो भूल गयो कि परमेश्वर को वचन को द्वारा आसमान पुरानो समय सी बनायी गयी हय अऊर धरती पानी म सी बनी अऊर पानी को द्वारा बनी, <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />येकोच वजह ऊ युग को जगत पानी म डुब क नाश भय गयो। <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />पर आसमान अऊर धरती जो अज अस्तित्व म हय ओकोच आदेश को द्वारा आगी को द्वारा नाश होन को लायी सुरक्षित हय इन ख ऊ दिन को लायी रख्यो जाय रह्यो हय जब अन्यायी लोगों को न्याय होयेंन अऊर हि नाश कर दियो जायेंन।<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />हे प्रिय संगियों, या एक बात ख मत भूलो की प्रभु की नजर म एक दिन अऊर एक हजार साल म कोयी फरक नहाय; ओको लायी हि दोयी भी समान हय। <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />प्रभु अपनी वाचा को बारे म देर नहीं करय, जसी देर कुछ लोग समझय हंय; पर तुम्हरो बारे म धीरज धरय हय, अऊर नहीं चाहवय कि कोयी नाश होय, बल्की यो कि सब ख मन फिराव को अवसर मिले।<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१० </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:43">मत्ती २४:४३</ref>; <ref loc="LUK 12:39">लूका १२:३९</ref>; <ref loc="1TH 5:2">१ थिस्सलुनीकियों ५:२</ref>; <ref loc="REV 16:15">प्रकाशितवाक्य १६:१५</ref></char>
    </note>पर प्रभु को दिन चोर को जसो आय जायेंन, ऊ दिन आसमान की बड़ी गर्जना को संग अदृश्य होय जायेंन ओको बाद आसमान की पूरी चिजे जर क नाश होय जायेंन अऊर धरती अऊर ओको पर की बाते नाश होय जायेंन। <verse eid="2PE 3:10" /><verse number="11" style="v" sid="2PE 3:11" />जब कि या सब चिजे या रीति सी नाश होन वाली हंय, त तुम्ख कौन्सो तरह को लोग होनो चाहिये? तुम्हरो जीवन पवित्र अऊर परमेश्वर को तरफ समर्पित होनो चाहिये। <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />अऊर परमेश्वर को ऊ दिन की रस्ता कौन्सी रीति सी देखनो चाहिये अऊर ओको जल्दी आवन को लायी कसो यत्न करनो चाहिये, जेको वजह आसमान आगी सी नाश करयो जायेंन, अऊर आसमान की पूरी चिजे बहुतच गर्मी सी तप्त होय क गल जायेंन। <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" /><note caller="+" style="x"><char style="xo" closed="false">३:१३ </char><char style="xt" closed="false"><ref loc="REV 21:1">प्रकाशितवाक्य २१:१</ref></char></note>पर ओकी प्रतिज्ञा को अनुसार हम एक नयो आसमान अऊर नयी धरती की आस देखजे हंय जिन्म सच्चायी वाश करेंन।<verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />येकोलायी, हे प्रिय संगियों, जब कि तुम ऊ दिन को इंतजार कर रह्यो हय, त अपनो तरफ सी पूरी कोशिश करो कि तुम शान्ति सी परमेश्वर की नजर म निष्कलंक अऊर निर्दोष ठहरो, <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />हमरो प्रभु को धीरज ख ओन उद्धार देन लायी दी गयी सन्धी समझो, जसो की हमरो प्रिय भाऊ पौलुस न ज्ञान सी जो परमेश्वर न ओख दियो होतो ओको उपयोग कर क् लिख्यो होतो। <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />वसोच ओन अपनी सब चिट्ठियों म भी इन बातों ख लिख्यो हय। जिन्म कुछ बाते असी हंय जिन्को समझनो कठिन हय, अऊर अनजान अऊर अस्थिर लोग ओको गलत व्याख्यान करय हय जसो की ऊ वचन को दूसरों शास्त्र लेखों को भी करय हय। यो तरह अपनोच नाश को वजह बनय हंय।<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />येकोलायी हे प्रिय संगियों, तुम लोग पहिलेच सी इन बातों ख जान क चौकस रहो, ताकि अनैतिक लोगों को गलातियों को द्वारा भ्रम म फस क अपनी स्थिरता ख कहीं हाथ सी खोय नहीं देवो। <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />पर हमरो प्रभु अऊर उद्धारकर्ता यीशु मसीह को अनुसार अऊर ज्ञान म बढ़तो जावो। ओकीच महिमा अब भी होय, अऊर हमेशा हमेशा होती रहे। आमीन।<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>