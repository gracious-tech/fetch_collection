<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOS" style="id">- Lodhi</book>
  <para style="h">यहोशू</para>
  <para style="toc3">यहोशू</para>
  <para style="toc2">यहोशू</para>
  <para style="toc1">यहोशू</para>
  <para style="mt2">यहोशू की किताब</para>
  <para style="mt1">यहोशू की किताब</para>
  <para style="imt">परिचय</para>
  <para style="ip">यहोशू की किताब इस्राएल राष्ट्र की कहानी ख आगु बढ़ावय हय जहां व्यवस्थाविवरन खतम होवय हय। इस्राएल को लोग यरदन नदी को पूर्वी किनारे सी शुरू होवय हंय। यहोशू की किताब बतावय हय कि कसो उन्न यरदन नदी ख पार करयो अऊर मूसा को उत्तराधिकारी, यहोशू को अगुवायी म कनान की जमीन पर विजय हासिल करी। उन्न असो येकोलायी करयो कहालीकि परमेश्वर न उन्ख आज्ञा दी होती। यो तरह, परमेश्वर अब्राहम को वंशजों ख कनान जमीन देन को अपनो वादा पूरो कर रह्यो होतो। <char style="xt"><ref loc="GEN 12:7">उत्पत्ति १२:७</ref>। </char></para>
  <para style="ip">यो मालूम नहाय कि यहोशू कि किताब कौन न लिखी या संकलित करी। कयी बार, लेखक असो बोलय हय जसो की ऊ उन घटनावों को बीच म मौजूद होतो जो होय रही होती उदाहरन लायी, <char style="xt"><ref loc="JOS 5:1">यहोशू ५:१</ref>,<ref loc="JOS 5:6">६</ref></char> यो वजह सी, कयी विद्वानों को माननो हय कि यहोशू न किताब को अधिकांश भाग खुद लिख्यो हय। हालांकि, यो स्पष्ट हय कि यहोशू को अलावा कोयी अऊर न कुछ खंड लिख्यो हय, जसो को यहोशू को अंतिम संस्कार को विवरन <char style="xt"><ref loc="JOS 24:29">यहोशू २४:२९</ref></char> दूसरो विद्वानों को माननो हंय। कि घटनावों को घटित होन को लगभग ८०० साल बाद किताब लिखी गयी होती। यहोशू कि किताब म घटनाये संभवत: १२५० ईसा पूर्व को आस पास घटित भयी होती, जो मिस्र म रामेसेस को शासन को ४० साल बाद की रही होना। रामेसेस ऊ राजा आय जेको बारे म मान्यो जावय हय कि ओन मिस्र सी इस्राएल को पलायन को समय शासन करयो होतो। <char style="xt"><ref loc="EXO 1:11">निर्गमन १:११</ref> </char></para>
  <para style="iot">रूप-रेखा</para>
  <para style="io1">१. कसो इस्राएलियों न यरदन नदी पार करी अऊर कनान देश म प्रवेश करयो। <char style="ior"><ref loc="JOS 1:5">१:५</ref>; <ref loc="JOS 12">१२</ref></char></para>
  <para style="io1">२. फिर, इस्राएल द्वारा कनान पर विजय को बारे म बतायो गयो हय। <char style="ior"><ref loc="JOS 5:13">५:१३</ref>; <ref loc="JOS 12">१२</ref> </char></para>
  <para style="io1">३. येको बाद, कनान देश ख इस्राएल को गोत्रों म कसो बाट्यो गयो। <char style="ior"><ref loc="JOS 13-21">१३–२१</ref></char></para>
  <para style="io1">४. आखरी म, कसो कुछ जनजातियां यरदन नदी को पूर्वी किनारे पर लौट आयी, यहोशू की बिदायी अऊर अंतिम संस्कार, अऊर कसो परमेश्वर को संग इस्राएल की वाचा को नवीनीकरन भयो। <char style="ior"><ref loc="JOS 22-24">२२–२४</ref></char></para>
  <chapter number="1" style="c" sid="JOS 1" />
  <para style="s">यहोशू ख परमेश्वर की आज्ञा</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 1:1" />परमेश्वर को सेवक मूसा को मरन को बाद परमेश्वर न ओको सेवक यहोशू सी कह्यो जो नून को टुरा होतो, <verse eid="JOS 1:1" /><verse number="2" style="v" sid="JOS 1:2" />“मोरो सेवक मूसा मर गयो हय; येकोलायी अब तय उठ, तैयार हो, अऊर पूरी इस्राएली प्रजा समेत यरदन नदी को पार होय क ऊ देश म जा जेक मय इस्राएली लोगों ख दे रह्यो हय। <verse eid="JOS 1:2" /><verse number="3" style="v" sid="JOS 1:3" /><note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="DEU 11:24">व्यवस्थाविवरन ११:२४</ref></char></note>ऊ वचन को अनुसार जो मय न मूसा सी कह्यो, मतलब जो जो जागा पर तुम पाय रखो ऊ सब मय तुम्ख देऊं। <verse eid="JOS 1:3" /><verse number="4" style="v" sid="JOS 1:4" />दक्षिन म जंगल सी उत्तर म लबानोन की पहाड़ियों तक, पूर्व म फरात महानदी अऊर हित्ती जाती को सब लोग देश सी पश्चिम म महासमुन्दर तक ठहरेंन। <verse eid="JOS 1:4" /><verse number="5" style="v" sid="JOS 1:5" /><note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="DEU 31:6">व्यवस्थाविवरन ३१:६</ref>,<ref loc="DEU 31:8">८</ref>; <ref loc="HEB 13:5">इब्रानियों १३:५</ref></char></note>तोरो जीवन भर कोयी तोरो सामने ठहर नहीं सकेंन; जसो मय मूसा को संग रह्यो वसोच तोरो संग भी रहूं; अऊर नहीं मय तोख धोखा देऊं, अऊर नहीं तोख छोड़ूं। <verse eid="JOS 1:5" /><verse number="6" style="v" sid="JOS 1:6" /><note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 31:6">व्यवस्थाविवरन ३१:६</ref>,<ref loc="DEU 31:7">७</ref>,<ref loc="DEU 31:23">२३</ref></char></note>येकोलायी हिम्मत बान्ध क मजबूत होय जा; कहालीकि जो देश ख देन की कसम मय न इन लोगों को पूर्वजों सी खायी होती ओको अधिकारी तय इन ख करजो। <verse eid="JOS 1:6" /><verse number="7" style="v" sid="JOS 1:7" />इतनो हो कि तय हिम्मत बान्ध अऊर बहुत मजबूत होय क जो व्यवस्था मोरो सेवक मूसा न तोख दियो हय उन सब को अनुसार करन म चौकसी करजो; अऊर ओको सी नहीं तय दायो मुड़जो अऊर नहीं बायो, तब जहां जहां तय जाजो वहां वहां तोरो काम सफल होयेंन। <verse eid="JOS 1:7" /><verse number="8" style="v" sid="JOS 1:8" />व्यवस्था की या किताब को शब्द मोरो मुंह सी कभी नहीं अलग होनो पाये, येकोच म रात दिन ध्यान लगायो रहजो, येकोलायी कि जो कुछ ओको म लिख्यो हय ओको अनुसार करन की तय चौकसी करजो; कहालीकि असोच करन सी तोरो सब काम सफल होयेंन, अऊर तय प्रभावशाली होयजो। <verse eid="JOS 1:8" /><verse number="9" style="v" sid="JOS 1:9" />का मय न तोख आज्ञा नहीं दी? हिम्मत बान्ध क मजबूत होय जा; डर मत, अऊर तोरो मन निराश नहीं हो; कहालीकि जहां जहां तय जाजो वहां वहां तोरो परमेश्वर यहोवा तोरो संग रहेंन।”<verse eid="JOS 1:9" /></para>
  <para style="s">यहोशू को लोगों ख आदेश देनो</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 1:10" />तब यहोशू न प्रजा को मुख्य लोगों ख या आज्ञा दी, <verse eid="JOS 1:10" /><verse number="11" style="v" sid="JOS 1:11" />“छावनी म इत उत जाय क प्रजा को लोगों ख या आज्ञा देवो, कि अपनो अपनो लायी भोजन तैयार कर क् रखो; कहालीकि तीन दिन को अन्दर तुम ख यो यरदन नदी को पार उतर क ऊ देश ख अपनो अधिकार म लेन लायी जानो हय जेक तुम्हरो परमेश्वर यहोवा तुम्हरो अधिकार म दे रह्यो हय।”<verse eid="JOS 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 1:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:12 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 32:28-32">गिनती ३२:२८-३२</ref>; <ref loc="DEU 3:18-20">व्यवस्थाविवरन ३:१८-२०</ref></char>
    </note>फिर यहोशू न रूबेनियों, गादियों, अऊर मनश्शे को अरधो वंश को लोगों सी कह्यो, <verse eid="JOS 1:12" /><verse number="13" style="v" sid="JOS 1:13" />“जो बात परमेश्वर को सेवक मूसा न तुम सी कही होती कि तुम्हरो परमेश्वर यहोवा तुम्ख आराम देवय हय, अऊर योच देश तुम्ख देयेंन, ओकी सुधि लेवो। <verse eid="JOS 1:13" /><verse number="14" style="v" sid="JOS 1:14" />तुम्हरी पत्नियां, बाल-बच्चा, अऊर जनावर त यो देश म रहेंन जो मूसा न तुम्ख यरदन को येन पारच दियो, पर तुम जो योद्धा शस्त्र उठाय क अपनो भाऊवों को आगु आगु ओन पार उतर क चलो, अऊर उन्की मदत करो; <verse eid="JOS 1:14" /><verse number="15" style="v" sid="JOS 1:15" /><note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="NUM 32:28">गिनती ३२:२८</ref>; <ref loc="DEU 3:18-20">व्यवस्थाविवरन ३:१८-२०</ref>; <ref loc="JOS 22:1-6">यहोशू २२:१-६</ref></char></note>अऊर जब परमेश्वर उन्ख असो आराम देयेंन जसो ऊ तुम्ख दे चुक्यो हय, अऊर हि भी तुम्हरो परमेश्वर यहोवा को दियो हुयो देश को अधिकारी होय जायेंन; तब तुम अपनो अधिकार को देश म, जो परमेश्वर को सेवक मूसा न यरदन को येन पार पूर्व को तरफ तुम्ख दियो हय, लौट क येको अधिकारी होयेंन।”<verse eid="JOS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 1:16" />तब उन्न यहोशू ख उत्तर दियो, “जो कुछ तय न हम्ख करन की आज्ञा दी हय ऊ हम करबोंन, अऊर जहां कहीं तय हम्ख भेजो वहां हम जाबोन। <verse eid="JOS 1:16" /><verse number="17" style="v" sid="JOS 1:17" />जसो हम सब बातों म मूसा की मानत होतो वसोच तोरी भी मानबो, इतनो होय कि तोरो परमेश्वर यहोवा जसो मूसा को संग रहत होतो वसोच तोरो संग भी रहे। <verse eid="JOS 1:17" /><verse number="18" style="v" sid="JOS 1:18" />कोयी भी कहाली नहीं होय जो तोरो खिलाफ विद्रोह करे, अऊर जितनी आज्ञाये तय देजो उन्ख नहीं मानय, त ऊ मार डाल्यो जायेंन। पर तय मजबूत अऊर हिम्मत बान्ध्यो रहे।”<verse eid="JOS 1:18" /></para>
  <chapter eid="JOS 1" />
  <chapter number="2" style="c" sid="JOS 2" />
  <para style="s">यरीहो नगर को भेद लियो जानो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 11:31">इब्रानियों ११:३१</ref>; <ref loc="JAS 2:25">याकूब २:२५</ref></char>
    </note>तब नून को टुरा यहोशू न दोय भेदियों ख शित्तीम सी चुपचाप सी भेज दियो, अऊर ओन कह्यो, “जाय क ऊ देश अऊर यरीहो ख देखो।” तुरतच हि चली गयो, अऊर राहब नाम की कोयी वेश्या को घर म जाय क ठहर गयो। <verse eid="JOS 2:1" /><verse number="2" style="v" sid="JOS 2:2" />तब कोयी न यरीहो नगर को राजा सी कह्यो, “अज की रात कुछ इस्राएली लोग हमरो देश को भेद लेन लायी यहां आयो हुयो हय।” <verse eid="JOS 2:2" /><verse number="3" style="v" sid="JOS 2:3" />तब यरीहो नगर को राजा न राहब को जवर यो सन्देश भेज्यो, “जो आदमी तोरो यहां आयो हय उन्ख बाहेर लाव; कहालीकि हि पूरो देश को भेद लेन लायी आयो हंय।”<verse eid="JOS 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 2:4" />वा बाई न दोयी आदमियों ख लूकाय रख्यो; अऊर यो तरह कह्यो, “मोरो जवर कुछ आदमी आयो त होतो, पर मय नहीं जानु कि हि कहां को होतो; <verse eid="JOS 2:4" /><verse number="5" style="v" sid="JOS 2:5" />अऊर जब अन्धारो भयो, अऊर नगर को फाटक बन्द होन लग्यो, तब हि निकल गयो; मोख मालूम नहीं कि हि कहां गयो; तुम फुर्ती कर क् उन्को पीछा करो त उन्ख जाय क पकड़ो।” <verse eid="JOS 2:5" /><verse number="6" style="v" sid="JOS 2:6" />राहब न भेदियों ख घर की छत पर चढ़ाय क सन की लकड़ियों को खल्लो लूकाय दियो होतो जो ओन लकड़ी छत पर जमाय क रखी होती। <verse eid="JOS 2:6" /><verse number="7" style="v" sid="JOS 2:7" />राजा को कर्मचारी यरदन को रस्ता सी उन्की खोज म घाट तक चली गयो; अऊर उन्ख खोजन वालो नगर को फाटक सी बाहेर निकलतोच फाटक बन्द कर दियो गयो।<verse eid="JOS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 2:8" />भेदियों को सोवन सी पहले राहब छत पर उन्को जवर आयी <verse eid="JOS 2:8" /><verse number="9" style="v" sid="JOS 2:9" />अऊर इन आदमियों सी कहन लगी, “मोख त निश्चय हय कि परमेश्वर न तुम लोगों ख यो देश दियो हय, अऊर तुम्हरो डर हम लोगों को मन म समायो हय, अऊर यो देश को सब निवासी तुम्हरो वजह घबराय रह्यो हय। <verse eid="JOS 2:9" /><verse number="10" style="v" sid="JOS 2:10" /><note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="EXO 14:21">निर्गमन १४:२१</ref>; <ref loc="NUM 21:21-35">गिनती २१:२१-३५</ref></char></note>कहालीकि हम न सुन्यो हय कि परमेश्वर न तुम्हरो मिस्र देश सी निकलन को समय तुम्हरो सामने लाल समुन्दर को पानी सुखाय दियो। अऊर तुम लोगों न सीहोन अऊर ओग नाम को यरदन को पार रहन वालो एमोरियों को दोयी राजावों को नाश कर डाल्यो हय। <verse eid="JOS 2:10" /><verse number="11" style="v" sid="JOS 2:11" />अऊर यो सुनतोच हमरो मन पिघल गयो, अऊर तुम्हरो वजह कोयी को जीव म जीव नहीं रह्यो; कहालीकि तुम्हरो परमेश्वर यहोवा ऊपर को आसमान को अऊर खल्लो की धरती को परमेश्वर आय। <verse eid="JOS 2:11" /><verse number="12" style="v" sid="JOS 2:12" />अब मय न तुम पर दयापूर्ण व्यवहार करयो हय, येकोलायी मोरो सी परमेश्वर की कसम खावो कि तुम भी मोरो बाप को परिवार को संग दयापूर्ण व्यवहार करो, अऊर येको सच्चो चिन्ह मोख देवो। <verse eid="JOS 2:12" /><verse number="13" style="v" sid="JOS 2:13" />तुम मोख वचन देवो कि तुम मोरो माय बाप, भाऊवों अऊर बहिनों ख, अऊर जो कुछ उन्को हय उन सब ख भी जीन्दो रहन देवो, अऊर हम सब को जीव मरन सी बचावो।”<verse eid="JOS 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 2:14" />तब उन आदमियों न ओको सी कह्यो, “यदि तय हमरी या बात कोयी पर प्रगट नहीं करे, त तुम्हरो जीव को बदला हमरो जीव जाये; अऊर परमेश्वर हम्ख यो देश देयेंन, तब हम तोरो संग कृपा अऊर सच्चायी सी बर्ताव करबो।”<verse eid="JOS 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 2:15" />तब राहब जेको घर नगर की दीवाल सी लग क बन्यो होतो, अऊर वा वहांच रहत होती, ओन भेदियों ख खिड़की सी रस्सा को सहारा सी उतार क नगर को बाहेर कर दियो। <verse eid="JOS 2:15" /><verse number="16" style="v" sid="JOS 2:16" />अऊर ओन कह्यो, “पहाड़ी को तरफ चली जावो, असो नहीं होय कि खोजन वालो राजा को दूत तुम्ख पकड़ ले; येकोलायी जब तक तुम्हरो खोजन वालो वापस लौट क नहीं आवय तब तक, तीन दिन वहांच लूक्यो रहो, ओको बाद अपनो रस्ता लेवो।”<verse eid="JOS 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 2:17" />उन्न ओको सी कह्यो, “जो कसम तय न हम्ख खिलायी हय ओको बारे म हम त निर्दोष रहबोंन। <verse eid="JOS 2:17" /><verse number="18" style="v" sid="JOS 2:18" />सुन, जब हम लोग यो देश म आयबो, तब जो खिड़की सी तय न हम्ख उतारयो हय ओको म योच लाल रंग की सूत की दोरी बान्ध देजो; अऊर अपनो माय बाप, भाऊवों, बल्की अपनो बाप को पूरो घराना ख योच घर म अपनो जवर जमा कर क् रखजो। <verse eid="JOS 2:18" /><verse number="19" style="v" sid="JOS 2:19" />तब जो कोयी तोरो घर को दरवाजा सी बाहेर निकलेंन, ओको खून को दोष ओकोच मुंड पर पड़ेंन, अऊर हम निर्दोष ठहरबो : पर यदि तोरो संग घर म रहतो हुयो कोयी को हाथ कोयी पर पड़ेंन, त ओको खून को दोष हमरो मुंड पर पड़ेंन। <verse eid="JOS 2:19" /><verse number="20" style="v" sid="JOS 2:20" />फिर यदि तय हमरी या बात कोयी पर प्रगट करे, त जो कसम तय न हम्ख खिलायी हय ओको सी हम निर्दोष ठहरबो।” <verse eid="JOS 2:20" /><verse number="21" style="v" sid="JOS 2:21" />ओन कह्यो, “जसो तुम न कह्यो वसोच हो।” तब ओन उन्ख बिदा करयो, अऊर हि चली गयो; अऊर ओन लाल रंग की दोरी ख खिड़की म बान्ध दियो।<verse eid="JOS 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 2:22" />भेदी जाय क पहाड़ी पर पहुंच्यो, अऊर वहां खोजन वालो को लौटन तक, मतलब तीन दिन तक रह्यो; अऊर खोजन वालो उन्ख पूरो रस्ता म ढूंढतो रह्यो पर हि कहीं नहीं मिल्यो। <verse eid="JOS 2:22" /><verse number="23" style="v" sid="JOS 2:23" />तब हि दोयी भेदी पहाड़ी सी उतरयो, अऊर नदी पार कर क् नून को टुरा यहोशू को जवर पहुंच्यो अऊर जो कुछ उन पर बीत्यो होतो ऊ बताय दियो। <verse eid="JOS 2:23" /><verse number="24" style="v" sid="JOS 2:24" />अऊर उन्न यहोशू सी कह्यो, “परमेश्वर न ऊ पूरो देश हमरो हाथ म कर दियो हय; येको सिवाय ओको पूरो निवासी हमरो वजह घबराय रह्यो हय।”<verse eid="JOS 2:24" /></para>
  <chapter eid="JOS 2" />
  <chapter number="3" style="c" sid="JOS 3" />
  <para style="s">इस्राएली लोग को यरदन पार करनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 3:1" />यहोशू सुबेरे उठ्यो, अऊर सब इस्राएली लोगों ख ले क शित्तीम सी निकल क यरदन नदी को किनारे आयो; अऊर हि ओन पार जान सी पहले वहांच मुक्काम करयो। <verse eid="JOS 3:1" /><verse number="2" style="v" sid="JOS 3:2" />अऊर तीन दिन को बाद सरदारों न छावनी को बीच जाय क <verse eid="JOS 3:2" /><verse number="3" style="v" sid="JOS 3:3" />प्रजा को लोगों ख या आज्ञा दी, “जब तुम्ख अपनो परमेश्वर यहोवा को वाचा को सन्दूक<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="ft" closed="false">पट्टियों पर लिखी दस आज्ञायों सी भरयो सन्दूक</char></note> अऊर ओख उठायो हुयो लेवी याजक ख भी देख लेवो, तब अपनी जागा सी निकल क ओको पीछू चलो, <verse eid="JOS 3:3" /><verse number="4" style="v" sid="JOS 3:4" />पर ओको अऊर तुम्हरो बीच म दोय हजार हाथ को अन्तर रहे; तुम सन्दूक को जवर मत जाओ। ताकी तुम देख सको कि कौन्सो रस्ता सी तुम्ख चलनो हय, कहालीकि अब तक तुम यो रस्ता पर नहीं आयो होतो।”<verse eid="JOS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 3:5" />फिर यहोशू न लोगों सी कह्यो, “तुम अपनो आप ख पवित्र करो; कहालीकि कल को दिन परमेश्वर तुम्हरो बीच म अद्भूत काम करेंन।” <verse eid="JOS 3:5" /><verse number="6" style="v" sid="JOS 3:6" />तब यहोशू न याजकों सी कह्यो, “वाचा को सन्दूक उठाय क प्रजा को आगु आगु चलो।” तब हि वाचा को सन्दूक उठाय क आगु आगु चलन लग्यो।<verse eid="JOS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 3:7" />तब परमेश्वर न यहोशू सी कह्यो, “अज को दिन सी मय इस्राएलियों को जवर तोरी प्रशंसा करनो सुरू करूं, तब हि जान लेयेंन कि जसो मय मूसा को संग रहत होतो वसोच मय तोरो संग भी हय। <verse eid="JOS 3:7" /><verse number="8" style="v" sid="JOS 3:8" />अऊर तय वाचा को सन्दूक उठावन वालो याजकों ख या आज्ञा दे, ‘जब तुम यरदन नदी को किनार पहुंचो, तब यरदन नदी म खड़ो होय जावो।’”<verse eid="JOS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 3:9" />तब यहोशू न इस्राएली लोगों सी कह्यो, “जवर आय क अपनो परमेश्वर यहोवा को वचन सुनो।” <verse eid="JOS 3:9" /><verse number="10" style="v" sid="JOS 3:10" />अऊर यहोशू कहन लग्यो, “येकोसी तुम जान लेवो कि जीन्दो परमेश्वर तुम्हरो बीच म हय, अऊर ऊ तुम्हरो सामने सी कनानियों, हित्तियों, हिब्बियों परिज्जियों, गिर्गाशियों, एमोरियों, अऊर यबूसियों ख उन्को देश सी निकाल देयेंन। <verse eid="JOS 3:10" /><verse number="11" style="v" sid="JOS 3:11" />देखो, पूरी धरती पर की परमेश्वर को वाचा को सन्दूक तुम्हरो आगु आगु यरदन म जानो परच हय। <verse eid="JOS 3:11" /><verse number="12" style="v" sid="JOS 3:12" />येकोलायी अब तुम इस्राएल को गोत्रों म सी बारा आदमियों ख चुन लेवो, हि एक गोत्र म सी एक आदमी हो। <verse eid="JOS 3:12" /><verse number="13" style="v" sid="JOS 3:13" />अऊर जो समय पूरी धरती को प्रभु यहोवा की वाचा को सन्दूक उठावन वालो याजक यरदन नदी को पानी म पाय रखेंन, ऊ समय यरदन नदी को बहतो हुयो पानी रूक जायेंन, अऊर ढेर होय क ठहर जायेंन।”<verse eid="JOS 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 3:14" />फसल को समय होतो नदी म बहुत बाढ़ होतो येकोलायी जब प्रजा को लोगों न अपनो तम्बुवों सी यरदन नदी पार जान लायी निकल्यो, अऊर याजक वाचा को सन्दूक उठायो हुयो प्रजा को आगु आगु चल्यो, <verse eid="JOS 3:14" /><verse number="15" style="v" sid="JOS 3:15" />अऊर सन्दूक ख उठावन वालो यरदन नदी पर पहुंच्यो, अऊर सन्दूक को उठावन वालो याजकों को पाय यरदन नदी को पानी म डुब गयो यरदन नदी को पानी त कटनी को समय को सब दिन अपनो तट को ऊपर ऊपर बह्यो करय हय, <verse eid="JOS 3:15" /><verse number="16" style="v" sid="JOS 3:16" />तब जो पानी ऊपर को तरफ सी बहत आवय हय ऊ बहुत दूर, मतलब आदाम नगर को जवर जो सारतान नगर को जवर रूक क एक ढेर भय गयो, अऊर दीवार जसो उठ्यो रह्यो, अऊर जो पानी अराबा को सागर जो मृत सागर भी कह्यो जावय हय, ओको तरफ बहत जात होतो, ऊ पूरो रीति सी सूख गयो; अऊर प्रजा को लोग यरीहो को सामने पार उतर गयो। <verse eid="JOS 3:16" /><verse number="17" style="v" sid="JOS 3:17" />अऊर याजक यहोवा की वाचा को सन्दूक उठायो हुयो यरदन को बीचों बीच पहुंच क जागा पर स्थिर खड़ो रह्यो, अऊर सब इस्राएली जागाच जागा पार उतरतो रह्यो, आखरी म ऊ पूरी जाति को लोग यरदन नदी पार भय गयो।<verse eid="JOS 3:17" /></para>
  <chapter eid="JOS 3" />
  <chapter number="4" style="c" sid="JOS 4" />
  <para style="s">स्मृति को बारा गोटा</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 4:1" />जब हि पूरी जाति को लोग यरदन नदी को पार उतर गयो, तब परमेश्वर न यहोशू सी कह्यो, <verse eid="JOS 4:1" /><verse number="2" style="v" sid="JOS 4:2" />“प्रजा म सी बारा आदमी, मतलब हर एक कुल सी एक आदमियों ख चुन क या आज्ञा दे, <verse eid="JOS 4:2" /><verse number="3" style="v" sid="JOS 4:3" />‘अऊर तुम यरदन को बीच म, जहां याजकों न पाय रख्यो होतो वहां सी बारा गोटा उठाय क अपनो संग ओन पार ले चलो, अऊर जहां अज की रात मुक्काम करो वहांच रख देवो।’”<verse eid="JOS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 4:4" />तब यहोशू न उन बारा आदमियों ख, जिन्ख ओन इस्राएलियों को हर एक कुल म सी छांट क रख्यो होतो, <verse eid="JOS 4:4" /><verse number="5" style="v" sid="JOS 4:5" />बुलाय क कह्यो, “तुम अपनो परमेश्वर यहोवा को सन्दूक को आगु यरदन को बीच म जाय क इस्राएलियों को कुलों की गिनती को अनुसार एक एक गोटा उठाय क अपनो अपनो कन्धा पर रखो, <verse eid="JOS 4:5" /><verse number="6" style="v" sid="JOS 4:6" />जेकोसी यो उन लोगों को बीच चिन्ह ठहरे, अऊर आगु जब तुम्हरो टुरा यो पूछेंन, ‘इन गोटावों को का मतलब हय?’ <verse eid="JOS 4:6" /><verse number="7" style="v" sid="JOS 4:7" />तब तुम उन्ख यो उत्तर देवो, कि यरदन नदी को पानी परमेश्वर को वाचा को सन्दूक को सामने दोय भाग भय गयो होतो; कहालीकि जब ऊ यरदन नदी पार कर क् आय रह्यो होतो, तब यरदन नदी को पानी दोय भाग भय गयो होतो। येकोलायी हि गोटा इस्राएल ख हमेशा लायी याद दिलावन वालो ठहरेंन।”<verse eid="JOS 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 4:8" />यहोशू की या आज्ञा को अनुसार इस्राएली लोगों न करयो, जसो परमेश्वर न यहोशू सी कह्यो होतो वसोच उन्न इस्राएली कुलों की गिनती को अनुसार बारा गोटा यरदन नदी को बीच म सी उठाय क; ऊ जागा पर ले गयो जहां उन्न मुक्काम करयो होतो रख दियो। <verse eid="JOS 4:8" /><verse number="9" style="v" sid="JOS 4:9" />अऊर यरदन नदी को बीच म, जहां याजक वाचा को सन्दूक ख उठायो हुयो अपनो पाय रख्यो होतो वहां यहोशू न बारा गोटा खड़ो करायो; हि अज भी वहां हय।<verse eid="JOS 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 4:10" />जिन कामों ख करन की आज्ञा परमेश्वर न यहोशू को द्वारा इस्राएली लोगों ख दी होती, जब तक हि पूरी नहीं होय जाय तब तक वाचा को सन्दूक उठाय क लिजान वालो याजक यरदन नदी को बीच म खड़ो रह्यो, असीच आज्ञा मूसा न यहोशू ख दियो होतो। तब लोगों न फुर्ती सी नदी पार कर लियो। <verse eid="JOS 4:10" /><verse number="11" style="v" sid="JOS 4:11" />अऊर जब सब लोग ओन पार उतर चुक्यो, तब याजक अऊर परमेश्वर को सन्दूक भी उन्को देखतो पार भय गयो। <verse eid="JOS 4:11" /><verse number="12" style="v" sid="JOS 4:12" />अऊर रूबेनी, गादी, अऊर मनश्शे को अरधो कुल को लोग मूसा को कहन को अनुसार बच्यो इस्राएली लोगों को आगु हथियार बान्ध्यो हुयो पार गयो; <verse eid="JOS 4:12" /><verse number="13" style="v" sid="JOS 4:13" />हि चालीस हजार आदमी युद्ध को हथियार बान्ध्यो हुयो युद्ध करन लायी परमेश्वर को सामने पार उतर क यरीहो को मैदान म पहुंच्यो। <verse eid="JOS 4:13" /><verse number="14" style="v" sid="JOS 4:14" />ऊ दिन परमेश्वर न सब इस्राएलियों को सामने यहोशू की महिमा बढ़ायी; अऊर जसो हि मूसा को भय मानत होतो वसोच यहोशू को भी भय ओको जीवन भर मानतो रहे।<verse eid="JOS 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 4:15" />तब परमेश्वर न यहोशू सी कह्यो, <verse eid="JOS 4:15" /><verse number="16" style="v" sid="JOS 4:16" />“वाचा को सन्दूक उठावन वालो याजकों ख आज्ञा दे कि यरदन म सी निकल आये।” <verse eid="JOS 4:16" /><verse number="17" style="v" sid="JOS 4:17" />त यहोशू न याजकों ख आज्ञा दियो, “यरदन म सी निकल आवो।” <verse eid="JOS 4:17" /><verse number="18" style="v" sid="JOS 4:18" />अऊर जसोच परमेश्वर की वाचा को सन्दूक उठावन वालो याजक यरदन नदी को बीच म सी निकल आयो, अऊर उन्को पाय सूखी जमीन पर पड़्यो, वसोच यरदन नदी को पानी अपनो जागा पर लौट आयो, अऊर पहले को जसो किनारा को ऊपर फिर बहन लग्यो।<verse eid="JOS 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 4:19" />पहिलो महिना को दसवों दिन ख प्रजा को लोगों न यरदन म सी निकल क यरीहो की पूर्व सीमा पर गिलगाल म अपनो डेरा डाल्यो। <verse eid="JOS 4:19" /><verse number="20" style="v" sid="JOS 4:20" />अऊर जो बारा गोटा यरदन नदी म सी निकाल्यो होतो, उन्ख यहोशू न गिलगाल म खड़ो करयो। <verse eid="JOS 4:20" /><verse number="21" style="v" sid="JOS 4:21" />तब ओन इस्राएली लोगों सी कह्यो, “जब भविष्य म तुम्हरो बाल-बच्चा अपनो-अपनो बाप सी यो पूछेंन, ‘हि गोटावों को का मतलब हय?’ <verse eid="JOS 4:21" /><verse number="22" style="v" sid="JOS 4:22" />तब तुम उन्ख यो बतावो, ‘यो यरदन ख हम इस्राएलियों न सूखी जमीन पर चल क पार करयो होतो।’ <verse eid="JOS 4:22" /><verse number="23" style="v" sid="JOS 4:23" />कहालीकि जसो तुम्हरो परमेश्वर यहोवा न लाल समुन्दर ख हमरो पार होय जान तक हमरो सामने सी हटाय क सुखाय दियो होतो, वसोच ओन यरदन नदी को भी पानी तुम्हरो पार होय जान तक तुम्हरो सामने सी हटाय क सुखाय दियो; <verse eid="JOS 4:23" /><verse number="24" style="v" sid="JOS 4:24" />येकोलायी धरती को सब देशों को लोग जान ले कि परमेश्वर को हाथ सामर्थवान हय; अऊर तुम हमेशा परमेश्वर यहोवा को भय मानतो रहो।”<verse eid="JOS 4:24" /></para>
  <chapter eid="JOS 4" />
  <chapter number="5" style="c" sid="JOS 5" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 5:1" />जब यरदन को पश्चिम को तरफ रहन वालो एमोरियों को सब राजावों न, अऊर समुन्दर को जवर रहन वालो कनानियों को सब राजावों न यो सुन्यो, कि परमेश्वर न इस्राएलियों ख पार होन तक उन्को सामने सी यरदन को पानी हटाय क सुखाय दियो हय, तब इस्राएलियों को डर को मारे उन राजावों को मन घबराय गयो, अऊर उन म हिम्मत नहीं रही।<verse eid="JOS 5:1" /></para>
  <para style="s">गिलगाल म इस्राएलियों को खतना करयो जानो अऊर फसह माननो</para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 5:2" />ऊ समय परमेश्वर न यहोशू सी कह्यो, “चकमक गोटा की छुरियां बनाय क दूसरी बार इस्राएली लोगों को खतना कराय दे।” <verse eid="JOS 5:2" /><verse number="3" style="v" sid="JOS 5:3" />तब यहोशू न चकमक गोटा की छुरियां बनाय क खतना नाम की पहाड़ी पर इस्राएली लोगों को खतना करायो। <verse eid="JOS 5:3" /><verse number="4" style="v" sid="JOS 5:4" />अऊर यहोशू न जो खतना करायो, येको कारण यो हय, कि जितनो लड़ाई को लायक आदमी मिस्र सी निकल्यो होतो हि सब मिस्र सी निकलन पर जंगल को रस्ता म मर गयो होतो। <verse eid="JOS 5:4" /><verse number="5" style="v" sid="JOS 5:5" />जो आदमी मिस्र देश सी निकल्यो होतो उन सब को त खतना भय गयो होतो, पर जितनो उन्को मिस्र देश सी निकलन को बाद जंगल को रस्ता म पैदा भयो होतो उन म सी कोयी को खतना नहीं भयो होतो। <verse eid="JOS 5:5" /><verse number="6" style="v" sid="JOS 5:6" /><note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="NUM 14:28-35">गिनती १४:२८-३५</ref></char></note>कहालीकि जब तक इस्राएली जाति को लोग, मतलब जितनो लोग लड़ाई को लायक मिस्र देश सी निकल्यो होतो उन्की मृत्यु नहीं भयी, तब तक हि चालीस साल तक जंगल म फिरतो रह्यो, कहालीकि उन्न परमेश्वर की नहीं मानी होती; येकोलायी परमेश्वर न कसम खाय क उन्को सी कह्यो होतो, कि जो देश मय न तुम्हरो पूर्वजों सी कसम खाय क तुम्ख देन ख कह्यो होतो, अऊर उन म दूध अऊर शहेद की धाराये बहय हय, ऊ देश मय तुम्ख नहीं दिखाऊं। <verse eid="JOS 5:6" /><verse number="7" style="v" sid="JOS 5:7" />त उन लोगों को टुरा जिन्ख परमेश्वर न उन्को जागा पर पैदा करयो होतो, उन्को खतना यहोशू न करयो, कहालीकि रस्ता म उन्को खतना नहीं होन को वजह हि खतनारहित होतो।<verse eid="JOS 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 5:8" />अऊर जब हि पूरी जाति को लोगों को खतना भय गयो, तब हि चंगो होय जान तक अपनो अपनो जागा पर डेरा म रह्यो। <verse eid="JOS 5:8" /><verse number="9" style="v" sid="JOS 5:9" />तब परमेश्वर न यहोशू सी कह्यो, “तुम्हरी निन्दा जो मिस्रियों म भयी हय ओख मय न अज दूर करी हय।” यो वजह ऊ जागा को नाम अज को दिन तक गिलगाल<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">लुढ़कनो यां दूर करनो</char></note> पड़्यो हय।<verse eid="JOS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 5:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:10 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:1-13">निर्गमन १२:१-१३</ref>
      </char>
    </note>येकोलायी इस्राएली गिलगाल म डेरा डाल्यो हुयो होतो, अऊर उन्न यरीहो को जवर को मैदान म महिना को चौदावों दिन शाम को समय फसह त्यौहार मनायो। <verse eid="JOS 5:10" /><verse number="11" style="v" sid="JOS 5:11" />अऊर फसह को दूसरो दिन हि ऊ देश को फसल म सी अखमीरी रोटी अऊर उच दिन सी भूज्यो हुयो दाना भी खान लग्यो। <verse eid="JOS 5:11" /><verse number="12" style="v" sid="JOS 5:12" /><note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="EXO 16:35">निर्गमन १६:३५</ref></char></note>अऊर ऊ देश की फसल खान को बाद मन्ना गिरनो बन्द भय गयो; ऊ दिन को बाद इस्राएली लोगों ख फिर कभी मन्ना नहीं मिल्यो, पर ऊ साल उन्न कनान देश की फसल म सी खायो।<verse eid="JOS 5:12" /></para>
  <para style="s">यहोशू अऊर तलवार लियो हुयो एक आदमी</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 5:13" />जब यहोशू यरीहो को जवर होतो तब ओन आंखी ऊपर उठायी, अऊर का देख्यो, कि हाथ म नंगी तलवार लियो हुयो एक आदमी सामने खड़ो हय; अऊर यहोशू न ओको जवर जाय क पुच्छ्यो, “का तय हमरो पक्ष को आय, यां हमरो बैरियों को पक्ष को?”<verse eid="JOS 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 5:14" />तब ओन उत्तर दियो, “नहीं; बल्की मय परमेश्वर की सेना को प्रधान होय क अभी आयो हय।”</para>
  <para style="p" vid="JOS 5:14">तब यहोशू न जमीन पर झुक क दण्डवत करयो, अऊर ओको सी कह्यो, “अपनो दास लायी मोरो प्रभु की का आज्ञा हय?”<verse eid="JOS 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 5:15" />परमेश्वर की सेना को प्रधान न यहोशू सी कह्यो, “अपनी चप्पल पाय सी उतार डाल, कहालीकि जो जागा पर तय खड़ो हय ऊ पवित्र हय।” तब यहोशू न वसोच करयो।<verse eid="JOS 5:15" /></para>
  <chapter eid="JOS 5" />
  <chapter number="6" style="c" sid="JOS 6" />
  <para style="s">यरीहो नगर को विनाश</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 6:1" />इस्राएली लोगों को वजह यरीहो नगर को फाटक बन्द कर दियो गयो होतो, कोयी भी नगर को अन्दर नहीं आय सकत होतो अऊर नहीं कोयी बाहेर जाय सकत होतो। <verse eid="JOS 6:1" /><verse number="2" style="v" sid="JOS 6:2" />फिर परमेश्वर न यहोशू सी कह्यो, “देख मय यरीहो नगर ख ओको राजा अऊर योद्धावों समेत तोरो वश म कर देऊ हय। <verse eid="JOS 6:2" /><verse number="3" style="v" sid="JOS 6:3" />येकोलायी तुम म जितनो योद्धा हय नगर ख घेर ले, अऊर ऊ नगर को चारयी तरफ दिन म एक बार चक्कर लगाये। अऊर छय दिन तक असोच करतो रहो। <verse eid="JOS 6:3" /><verse number="4" style="v" sid="JOS 6:4" />अऊर सात याजक मेंढा को सींगो सी बन्यो सात नरसिंगा ले क सन्दूक को आगु आगु चलेंन; फिर सातवों दिन तुम नगर को चारयी तरफ सात बार घूमो, अऊर याजक भी नरसिंगा फूकतो चलेंन। <verse eid="JOS 6:4" /><verse number="5" style="v" sid="JOS 6:5" />अऊर जब हि मेंढा को सींगो को नरसिंगा देर तक फूकतो रहेंन, तब सब लोग नरसिंगा को आवाज सुनतोच बड़ो आवाज सी जय जयकार करेंन; तब नगर की दीवाल नीव गिर जायेंन, अऊर सब लोग अपनी आंखी को सामने सीधो चलतो जाये।”<verse eid="JOS 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 6:6" />येकोलायी नून को टुरा यहोशू न याजकों ख बुलाय क कह्यो, “वाचा को सन्दूक ख उठाय लेवो, अऊर सात याजक परमेश्वर को सन्दूक को आगु आगु मेंढा को सींगो को सात नरसिंगा ले क चलेंन।” <verse eid="JOS 6:6" /><verse number="7" style="v" sid="JOS 6:7" />फिर ओन इस्राएली लोगों सी कह्यो, “आगु बढ़ क नगर को चारयी तरफ घुम क आवो; अऊर हथियार लियो हुयो आदमी परमेश्वर को सन्दूक को आगु आगु चले।”<verse eid="JOS 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 6:8" />अऊर जब यहोशू या बाते लोगों सी कह्य चुक्यो, त हि सात याजक जो परमेश्वर को सामने सात नरसिंगा लियो हुयो होतो नरसिंगा फूकतो हुयो चले, अऊर याजक परमेश्वर की वाचा को सन्दूक ख ले क उन्को पीछु पीछु चल्यो। <verse eid="JOS 6:8" /><verse number="9" style="v" sid="JOS 6:9" />अऊर हथियार लियो हुयो आदमी नरसिंगा फूकन वालो याजकों को आगु आगु चले, अऊर पीछु वालो सन्दूक को पीछु पीछु चले, अऊर याजक नरसिंगा फूकतो हुयो चले। <verse eid="JOS 6:9" /><verse number="10" style="v" sid="JOS 6:10" />अऊर यहोशू न लोगों ख आज्ञा दी, “जब तक मय तुम्ख जय जयकार करन की आज्ञा नहीं देऊ, तब तक जय जयकार मत करो, अऊर नहीं तुम्हरो कोयी आवाज सुनन म आये, अऊर नहीं कोयी बात तुम्हरो मुंह सी निकलनो चाहिये; जब मय तुम्ख आज्ञा देऊ तब जय जयकार करो।” <verse eid="JOS 6:10" /><verse number="11" style="v" sid="JOS 6:11" />ओन परमेश्वर को सन्दूक ख एक बार नगर को चारयी तरफ घुमवायो; तब हि छावनी म आयो, अऊर रात वहां बितायी।<verse eid="JOS 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 6:12" />यहोशू सुबेरे उठ्यो, अऊर याजकों न परमेश्वर को सन्दूक उठाय लियो। <verse eid="JOS 6:12" /><verse number="13" style="v" sid="JOS 6:13" />अऊर उन सात याजकों न मेंढा को सींगो को सात नरसिंगा ले क परमेश्वर को सन्दूक को आगु आगु लगातार फूकतो हुयो चल रह्यो होतो; अऊर उन को आगु हथियार लियो हुयो आदमी चल रह्यो होतो, अऊर पीछु वालो परमेश्वर को सन्दूक को पीछु चल रह्यो होतो, अऊर याजक नरसिंगा फूकतो चली गयो। <verse eid="JOS 6:13" /><verse number="14" style="v" sid="JOS 6:14" />यो तरह हि दूसरो दिन भी एक बार नगर को चारयी तरफ घुम क छावनी म लौट आयो। अऊर योच तरह उन्न छय दिन तक करयो।<verse eid="JOS 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 6:15" />फिर सातवों दिन भुन्सारो ख उठ क उच रीति सी नगर ख चारयी तरफ सात बार घुम्यो; केवल उच दिन हि सात बार घुम्यो। <verse eid="JOS 6:15" /><verse number="16" style="v" sid="JOS 6:16" />तब सातवों बार याजक नरसिंगा फूक रह्यो होतो, तब यहोशू न लोगों सी कह्यो, “जय जयकार करो; कहालीकि परमेश्वर न यो नगर तुम्ख दे दियो हय। <verse eid="JOS 6:16" /><verse number="17" style="v" sid="JOS 6:17" />अऊर नगर अऊर जो कुछ चिज ओको म हय परमेश्वर ख बलि को रूप म अर्पन कर क् पूरो तरह सी नाश कर दियो जायेंन; केवल राहब वेश्या अऊर जितनो ओको घर म होतो हि जीन्दो छोड़्यो जायेंन, कहालीकि ओन हमरो भेज्यो हुयो दूतों ख लूकाय क रख्यो होतो। <verse eid="JOS 6:17" /><verse number="18" style="v" sid="JOS 6:18" />अऊर तुम नाशवान चिजों सी सावधानी सी अपनो आप ख अलग रखो, असो नहीं होय की नाश होन वाली की चिज ठहराय क बाद म वाच नाश होन वाली चिज म सी कुछ ले लेवो, अऊर यो तरह इस्राएली छावनी ख भ्रष्ट कर क् ओख संकट म डाल देवो। <verse eid="JOS 6:18" /><verse number="19" style="v" sid="JOS 6:19" />सब चांदी, सोना, अऊर जो बर्तन पीतल अऊर लोहा को हय, हि परमेश्वर लायी पवित्र हय, अऊर ओकोच भण्डार म रख्यो जाय।”<verse eid="JOS 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 6:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:20 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 11:30">इब्रानियों ११:३०</ref>
      </char>
    </note>तब लोगों न जय जयकार करयो, अऊर याजक नरसिंगा फूकतो रह्यो। अऊर जब लोगों न नरसिंगा को आवाज सुन्यो त फिर बड़ी आवाज सी उन्न जय जयकार करयो, तब नगर की दीवाल गिर गयी, अऊर लोग सीधो ऊ नगर म घुस गयो, अऊर नगर पर अधिकार कर लियो। <verse eid="JOS 6:20" /><verse number="21" style="v" sid="JOS 6:21" />ओको बाद उन्न नगर को सब बाई, आदमी, जवान, बुजूर्ग, बईल, मेंढी अऊर गधा ख अर्पन की चिज जान क तलवार सी मार डाल्यो।<verse eid="JOS 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 6:22" />तब यहोशू न उन दोयी आदमियों सी जो ऊ देश म भेद लेन गयो होतो कह्यो, “अपनी कसम को अनुसार वा वेश्या को घर म जाय क ओख अऊर जो ओको घर म होना उन्ख भी निकाल लावो।” <verse eid="JOS 6:22" /><verse number="23" style="v" sid="JOS 6:23" />तब हि दोयी जवान भेदी अन्दर जाय क राहब ख, अऊर ओको माय-बाप, भाऊवों, अऊर सब ख जो ओको घर म रहत होतो, बल्की ओको सब कुटुम्बियों ख निकाल लायो, अऊर इस्राएल की छावनी को बाहेर बैठाय दियो। <verse eid="JOS 6:23" /><verse number="24" style="v" sid="JOS 6:24" />तब उन्न नगर ख अऊर जो कुछ ओको म होतो, सब ख आगी लगाय क जलाय दियो; केवल चांदी, सोना, अऊर जो बर्तन पीतल अऊर लोहा को होतो, उन्ख उन्न परमेश्वर को भवन को भण्डार म रख दियो।<verse eid="JOS 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 6:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:25 </char>
      <char style="xt" closed="false">
        <ref loc="HEB 11:31">इब्रानियों ११:३१</ref>
      </char>
    </note>अऊर यहोशू न राहब वेश्या अऊर ओको बाप को घराना ख, बल्की ओको सब लोगों ख जीन्दो छोड़ दियो; अऊर अज तक ओको वंश इस्राएलियों को बीच म रह्य हय, कहालीकि जो दूत यहोशू न यरीहो नगर को भेद लेन भेज्यो होतो उन्ख ओन लूकाय क रख्यो होतो।<verse eid="JOS 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 6:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:26 </char>
      <char style="xt" closed="false">
        <ref loc="1KI 16:34">१ राजा १६:३४</ref>
      </char>
    </note>फिर उच समय यहोशू न इस्राएलियों को सामने कसम दी, अऊर कह्यो, “जो आदमी उठ क यो नगर यरीहो ख फिर सी बनायेंन ऊ परमेश्वर को तरफ सी श्रापित होयेंन।</para>
  <para style="q1" vid="JOS 6:26">“जब ऊ ओको पायवा डालेंन तब ओको बड़ो टुरा मरेंन;</para>
  <para style="q1" vid="JOS 6:26">अऊर जब ऊ ओको फाटक लगायेंन तब ओको छोटो टुरा मर जायेंन।”<verse eid="JOS 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 6:27" />अऊर परमेश्वर यहोशू को संग रह्यो; अऊर यहोशू की कीर्ति ऊ पूरो देश म फैल गयी।<verse eid="JOS 6:27" /></para>
  <chapter eid="JOS 6" />
  <chapter number="7" style="c" sid="JOS 7" />
  <para style="s">आकान को पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 7:1" />पर इस्राएलियों न भेंट की चिज को बारे म विश्वासघात करयो; मतलब यहूदा वंश को आकान, जो जेरहवंशी जब्दी को नाती अऊर कर्मी को टुरा होतो, ओन भेंट की चिजों म सी कुछ ले लियो; यो कारन परमेश्वर को कोप इस्राएलियों पर भड़क उठ्यो।<verse eid="JOS 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 7:2" />यहोशू न यरीहो सी ऐ नाम को नगर को जवर, जो बेतावेन सी लग्यो हुयो बेतेल को पूर्व को तरफ हय, कुछ आदमियों ख यो कह्य क भेज्यो, “जाय क ऊ देश को भेद ले क आवो।” अऊर उन आदमियों न जाय क ऐ नगर को भेद लियो। <verse eid="JOS 7:2" /><verse number="3" style="v" sid="JOS 7:3" />अऊर उन्न यहोशू को जवर लौट क कह्यो, “सब लोगों ख वहां जान की जरूरत नहाय, केवल दोय यां तीन हजार लोग जाय क ऐ नगर ख जीत सकय हय; सब लोगों ख वहां जान लायी तकलीफ देन की जरूरत नहाय, कहालीकि हि लोग थोड़ोच हंय।” <verse eid="JOS 7:3" /><verse number="4" style="v" sid="JOS 7:4" />येकोलायी इस्राएलियों को लगभग तीन हजार आदमी वहां गयो; पर उन्ख ऐ नगर को निवासियों को सामने सी भगनो पड़्यो, <verse eid="JOS 7:4" /><verse number="5" style="v" sid="JOS 7:5" />तब ऐ नगर को रहन वालो न उन म सी छत्तीस आदमी ख मार डाल्यो, अऊर अपनी फाटक सी शबारीम तक उन्को पीछा कर क् खदानों<note caller="+" style="f"><char style="fr" closed="false">7:5 </char><char style="ft" closed="false">शबारीम</char></note> तक उन्ख मारतो गयो। तब लोगों को मन पिघल क थंडो पड़ गयो।<verse eid="JOS 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 7:6" />तब यहोशू न पराजय को दु:ख प्रगट करन लायी अपनो कपड़ा फाड़्यो, ऊ शाम होन तक परमेश्वर की सन्दूक को सामने जमीन पर मुंह को बल गिर क पड़्यो रह्यो; असोच इस्राएली बुजूर्गों न भी करयो अऊर उन्न दु:ख प्रगट करन लायी अपनो मुंड पर धूल डाली। <verse eid="JOS 7:6" /><verse number="7" style="v" sid="JOS 7:7" />अऊर यहोशू न कह्यो, “हाय, प्रभु परमेश्वर, तय अपनी या प्रजा ख यरदन नदी को येन पार कहाली लायो? का हम्ख एमोरियों को वश म कर क् नाश करन लायी लायो हय? भलो होतो कि हम सन्तुष्ट कर क् यरदन नदी को ओन पार रह्य जातो! <verse eid="JOS 7:7" /><verse number="8" style="v" sid="JOS 7:8" />हाय, प्रभु मय का कहूं, जब इस्राएलियों न अपनो दुस्मनों ख पीठ दिखायी हय! <verse eid="JOS 7:8" /><verse number="9" style="v" sid="JOS 7:9" />कहालीकि कनानी जाति बल्की यो देश को सब रहन वालो यो सुन क हम्ख घेर लेयेंन, अऊर हमरो नाम निशान कर क् धरती पर सी मिटाय डालेंन; फिर तय अपनो बड़ो नाम को लायी का करजो?”<verse eid="JOS 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 7:10" />परमेश्वर न यहोशू सी कह्यो, “उठ, खड़ो होय जा, तय कहाली यो तरह मुंह को बल जमीन पर पड़्यो हय? <verse eid="JOS 7:10" /><verse number="11" style="v" sid="JOS 7:11" />इस्राएलियों न पाप करयो हय; अऊर जो वाचा मय न उन सी अपनो संग बान्धी होती ओख उन्न तोड़ दियो हय, उन्न भेंट की चिजों म सी ले लियो, बल्की चोरी भी करी अऊर छल कर क् ओख अपनो सामान म रख दियो हय।” <verse eid="JOS 7:11" /><verse number="12" style="v" sid="JOS 7:12" />येकोलायी इस्राएली अपनो दुस्मनों को सामने खड़ो नहीं रह्य सकय; हि अपनो दुस्मनों ख पीठ दिखावय हय, येकोलायी हि खुद भेंट की चिज बन गयो हय। अऊर यदि तुम अपनो बीच म सी भेंट की चिज को सत्यानाश नहीं कर डालो, तब तक मय तोरो संग नहीं रहूं। <verse eid="JOS 7:12" /><verse number="13" style="v" sid="JOS 7:13" />उठ, प्रजा को लोगों ख पवित्र कर, उन्को सी कह्य, सुबेरे तक अपनो आप ख पवित्र कर क् रखो; कहालीकि इस्राएल को परमेश्वर यहोवा यो कह्य हय, “हे इस्राएल, तोरो बीच म भेंट की चिज हय; येकोलायी जब तक तय भेंट की चिज ख अपनो बीच म सी दूर नहीं करय तब तक तय अपनो दुस्मनों को सामने खड़ो नहीं रह सकजो।” <verse eid="JOS 7:13" /><verse number="14" style="v" sid="JOS 7:14" />येकोलायी सुबेरे तुम हर एक कुल को अनुसार जवर खड़ो करयो जावो; अऊर जो कुल ख परमेश्वर पकड़ेंन हि एक एक कुल कर क् जवर आये; अऊर जो कुल ख परमेश्वर पकड़ेंन ऊ परिवार एक एक परिवार कर क् जवर आये; फिर जो परिवार ख परमेश्वर पकड़ेंन हि एक एक आदमी कर क् जवर आये। <verse eid="JOS 7:14" /><verse number="15" style="v" sid="JOS 7:15" />तब जो आदमी भेंट की चिज रख्यो हुयो पकड़्यो जायेंन, ऊ अऊर जो कुछ ओको होना सब आगी म डाल क जलाय दियो जायेंन; कहालीकि ओन परमेश्वर की वाचा ख तोड़्यो हय, अऊर इस्राएल म अनुचित काम करयो हय।<verse eid="JOS 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 7:16" />यहोशू सुबेरे उठ क इस्राएलियों ख कुल कुल कर क् जवर लायो, अऊर यहूदा को कुल पकड़्यो गयो; <verse eid="JOS 7:16" /><verse number="17" style="v" sid="JOS 7:17" />तब ओन यहूदा को परिवार ख जवर लायो, अऊर जेरहवंशियों को कुल पकड़्यो गयो; फिर जेरहवंशियों को परिवारों को एक एक आदमी ख जवर लायो, अऊर जब्दी पकड़्यो गयो; <verse eid="JOS 7:17" /><verse number="18" style="v" sid="JOS 7:18" />तब ओन ओको परिवारों को एक एक आदमी ख जवर खड़ो करयो, अऊर यहूदा कुल को आकान, जो जेरहवंशी जब्दी को नाती अऊर कर्मी को टुरा होतो, पकड़्यो गयो। <verse eid="JOS 7:18" /><verse number="19" style="v" sid="JOS 7:19" />तब यहोशू आकान सी कहन लग्यो, “हे मोरो बेटा, इस्राएल को परमेश्वर यहोवा को आदर कर, अऊर ओको आगु कबूल कर; अऊर जो कुछ तय न करयो हय ऊ मोख बताय दे, अऊर मोरो सी कुछ मत छुपाय।”<verse eid="JOS 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 7:20" />आकान न यहोशू ख उत्तर दियो, “सचमुच मय न इस्राएल को परमेश्वर यहोवा को खिलाफ पाप करयो हय, अऊर यो तरह मय न करयो हय, <verse eid="JOS 7:20" /><verse number="21" style="v" sid="JOS 7:21" />कि जब मोख लूट म शिनार देश को एक सुन्दर अंगरखा, अऊर दोय किलो चांदी, अऊर अरधो किलो सोनो को एक ईटा देख्यो होतो, तब मय न उन्को लालच कर क् उन्ख रख लियो; हि मोरो डेरा को अन्दर जमीन म गड़्यो हय, अऊर सब को खल्लो चांदी हय।”<verse eid="JOS 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 7:22" />तब यहोशू न कुछ दूत भेज्यो, अऊर हि ऊ डेरा म दौड़ क गयो; अऊर का देख्यो कि हि चिजे ओको डेरा म गड़्यो हय, अऊर सब को खल्लो चांदी हय। <verse eid="JOS 7:22" /><verse number="23" style="v" sid="JOS 7:23" />उन्ख उन्न डेरा म सी निकाल क यहोशू अऊर सब इस्राएलियों को जवर लाय क परमेश्वर को सामने रख दियो। <verse eid="JOS 7:23" /><verse number="24" style="v" sid="JOS 7:24" />तब सब इस्राएलियों समेत यहोशू जेरहवंशी आकान ख, अऊर वा चांदी अऊर अंगरखा अऊर सोनो की ईटा ख, अऊर ओको बेटा बेटियां ख, अऊर ओको बईलों, गधा अऊर मेंढियों को झुण्ड ख, अऊर ओको डेरा ख, मतलब जो कुछ ओको होतो उन सब ख आकोर नाम की घाटी म ले गयो। <verse eid="JOS 7:24" /><verse number="25" style="v" sid="JOS 7:25" />तब यहोशू न आकान सी कह्यो, “तय न हम्ख कहाली तकलीफ दियो हय? अज को दिन परमेश्वर तोखच तकलीफ देयेंन।” तब सब इस्राएलियों न ओको पर पथराव कर क् मार डाल्यो; अऊर उन्ख आगी म डाल क जलायो, अऊर उन्को ऊपर गोटा डाल दियो। <verse eid="JOS 7:25" /><verse number="26" style="v" sid="JOS 7:26" />अऊर उन्न ओको ऊपर गोटा को बड़ो ढेर लगाय दियो जो अज भी वहां हय; तब परमेश्वर को भड़क्यो हुयो कोप शान्त भय गयो।</para>
  <para style="p" vid="JOS 7:26">यो तरह ऊ जागा को नाम अज तक आकोर<note caller="+" style="f"><char style="fr" closed="false">7:26 </char><char style="ft" closed="false">तकलीफ देनो</char></note> की घाटी पड़्यो हय।<verse eid="JOS 7:26" /></para>
  <chapter eid="JOS 7" />
  <chapter number="8" style="c" sid="JOS 8" />
  <para style="s">ऐ नगर पर कब्जा अऊर विनाश</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 8:1" />तब परमेश्वर न यहोशू सी कह्यो, “मत डर, निराश मत हो; उठ कमर बान्ध क सब योद्धावों ख संग म ले, अऊर ऐ नगर पर चढ़ायी कर; सुन, मय न ऐ नगर को राजा ख ओकी प्रजा अऊर ओको नगर अऊर जमीन समेत तोरो अधिकार म सौंप दियो हय। <verse eid="JOS 8:1" /><verse number="2" style="v" sid="JOS 8:2" />अऊर जसो तय न यरीहो अऊर ओको राजा को संग करयो वसोच ऐ नगर को राजा को संग भी करजो; केवल ऐ नगर को जनावरों अऊर सब सामान ख अपनो लायी लूट सको; येकोलायी ऐ नगर को पीछु को तरफ अपनो लोग आक्रमन करन लायी बिठाय देजो।”<verse eid="JOS 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 8:3" />यहोशू न सब सैनिकों समेत ऐ नगर पर चढ़ायी करन की तैयारी करी; अऊर यहोशू न तीस हजार शूरवीर सैनिक चुन क रात मच भेज दियो। <verse eid="JOS 8:3" /><verse number="4" style="v" sid="JOS 8:4" />अऊर उन्ख या आज्ञा दी, “सुनो, तुम ऊ नगर को पीछु को तरफ आक्रमन करन लायी बैठ्यो रहो; नगर सी बहुत दूर मत जावो, अऊर सब को सब तैयार रहो; <verse eid="JOS 8:4" /><verse number="5" style="v" sid="JOS 8:5" />अऊर मय अपनो सब संगियों समेत ऊ नगर को जवर जाऊं। अऊर जब हि पहले जसो हमरो सामना करन लायी निकलेंन, तब हम उन्को आगु सी भगबोंन; <verse eid="JOS 8:5" /><verse number="6" style="v" sid="JOS 8:6" />तब हि यो सोच क, कि हि पहले को जसो हमरो सामने सी भाग रह्यो हय, हमरो पीछा करेंन; यो तरह हम उन्को सामने सी भाग क उन्ख नगर सी दूर निकाल ले जायबो; <verse eid="JOS 8:6" /><verse number="7" style="v" sid="JOS 8:7" />तब तुम अपनो लूकन की जागा सी निकलजो अऊर नगर पर अधिकार कर लेजो; कहालीकि तुम्हरो परमेश्वर यहोवा ऊ नगर ख तुम्हरो अधिकार म कर देयेंन। <verse eid="JOS 8:7" /><verse number="8" style="v" sid="JOS 8:8" />अऊर जब तुम नगर ख अपनो अधिकार म कर लेवो तब ओको म आगी लगाय क फूक देजो, परमेश्वर की आज्ञा को अनुसारच काम करो; सुनो, मय न तुम्ख आज्ञा दी हय।” <verse eid="JOS 8:8" /><verse number="9" style="v" sid="JOS 8:9" />तब यहोशू न उन्ख भेज दियो; हि लूकन की जागा पर चली गयो, हि ऐ नगर को पश्चिम दिशा म अऊर बेतेल को बीच म लूक क बैठ गयो; पर यहोशू वा रात ख अपनो लोगों को बीच टिक्यो रह्यो।<verse eid="JOS 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 8:10" />यहोशू सुबेरे उठ्यो, अऊर लोगों की गिनती ले क इस्राएली बुजूर्ग लोगों समेत सैनिकों को आगु आगु ऐ नगर को तरफ गयो। <verse eid="JOS 8:10" /><verse number="11" style="v" sid="JOS 8:11" />अऊर ओको संग को सब सैनिक आगु बड़्यो, अऊर ऐ नगर को जवर पहुंच क ओको सामने उत्तर को तरफ डेरा डाल दियो, अऊर उन्को अऊर ऐ नगर को बीच म एक घाटी होती। <verse eid="JOS 8:11" /><verse number="12" style="v" sid="JOS 8:12" />तब यहोशू न लगभग पाच हजार आदमी चुन क बेतेल अऊर ऐ नगर को बीच म नगर को पश्चिम को तरफ लूकाय क बैठाय दियो। <verse eid="JOS 8:12" /><verse number="13" style="v" sid="JOS 8:13" />अऊर सब लोगों न नगर को उत्तर दिशा को तरफ की पूरी सेना ख अऊर पश्चिम दिशा को तरफ घात म लूक क बैठ्यो हुयो ख भी अपनो अपनो डेरा म कर दियो, तब यहोशू वाच रात घाटी म रह्यो। <verse eid="JOS 8:13" /><verse number="14" style="v" sid="JOS 8:14" />जब ऐ नगर को राजा न यो देख्यो, तब हि फुर्ती कर क् सुबेरे उठ्यो, अऊर राजा अपनी पूरी प्रजा ख ले क इस्राएलियों को सामने उन्को सी लड़न लायी यरदन की घाटी को तरफ गयो; अऊर ऊ नहीं जानत होतो कि नगर को पीछु को भाग म लोग घात लगायो बैठ्यो हय। <verse eid="JOS 8:14" /><verse number="15" style="v" sid="JOS 8:15" />तब यहोशू अऊर सब इस्राएली लोग उन्को सी हार मान क जंगल को रस्ता ले क भाग निकल्यो। <verse eid="JOS 8:15" /><verse number="16" style="v" sid="JOS 8:16" />तब नगर को सब लोग इस्राएलियों को पीछा करन लायी बुलायो गयो; अऊर हि यहोशू को पीछा करतो हुयो नगर सी दूर निकल गयो। <verse eid="JOS 8:16" /><verse number="17" style="v" sid="JOS 8:17" />अऊर नहीं ऐ नगर म अऊर नहीं बेतेल म एक भी आदमी नहीं रह्यो, जो इस्राएलियों को पीछा करन लायी नहीं गयो होना; अऊर उन्न नगर ख खुलो छोड़ क इस्राएलियों को पीछा करयो।<verse eid="JOS 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 8:18" />तब परमेश्वर न यहोशू सी कह्यो, “अपनो हाथ को भाला सी ऐ नगर को तरफ इशारा कर; कहालीकि मय ओख तोरो हाथ म दे देऊं।” अऊर यहोशू न अपनो हाथ को भाला सी ऐ नगर को तरफ इशारा करयो। <verse eid="JOS 8:18" /><verse number="19" style="v" sid="JOS 8:19" />जसोच यहोशू न अपनो हाथ ऊपर उठायो लूक क बैठ्यो हुयो सैनिक तुरतच अपनो जागा सी उठ्यो, अऊर दौड़ क नगर म सिरयो अऊर ओख अपनो अधिकार म कर लियो; अऊर तुरतच ओको म आगी लगाय दियो। <verse eid="JOS 8:19" /><verse number="20" style="v" sid="JOS 8:20" />जब ऐ नगर को लोगों न पीछु पलट क देख्यो, कि नगर को धूगां आसमान को तरफ उठ रह्यो हय; उन्ख आगु-पीछु भगन को मौका भी नहीं मिल्यो, कहालीकि जंगल को तरफ भगन वालो इस्राएलियों न लौट क अपनो पीछा करन वालो पर आक्रमन कर दियो। <verse eid="JOS 8:20" /><verse number="21" style="v" sid="JOS 8:21" />जब यहोशू अऊर सब इस्राएलियों न देख्यो कि घातियों न नगर पर अधिकार कर लियो हय, अऊर ओको धूगां उठ रह्यो हय, तब घुम क ऐ नगर को आदमियों ख मारन लग्यो। <verse eid="JOS 8:21" /><verse number="22" style="v" sid="JOS 8:22" />अऊर उन्को सामना करन लायी दूसरो नगर सी भी लोग निकल आयो; येकोलायी हि इस्राएलियों को बीच म पड़ गयो, कुछ इस्राएली त उन्को आगु, अऊर कुछ उन्को पीछु होतो; उन्न उन्ख यहां तक मारयो कि उन म सी नहीं त कोयी बच्यो अऊर नहीं भग सक्यो। <verse eid="JOS 8:22" /><verse number="23" style="v" sid="JOS 8:23" />अऊर ऐ नगर को राजा ख हि जीन्दो पकड़ क यहोशू को जवर लायो।<verse eid="JOS 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 8:24" />जब इस्राएली ऐ नगर को सब निवासियों ख मैदान म, मतलब ऊ जंगल म जहां उन्न उन्को पीछा करयो होतो मार डाल्यो, जब ऐ नगर को हर एक निवासी तलवार सी मारयो गयो, तब सब इस्राएलियों न ऐ नगर ख लौट क बच्यो हुयो निवासियों ख तलवार सी मार डाल्यो। <verse eid="JOS 8:24" /><verse number="25" style="v" sid="JOS 8:25" />ऊ ऐ नगर कि जनसंख्या बारा हजार होती, ऊ दिन बाई अऊर आदमी सब मारयो गयो। <verse eid="JOS 8:25" /><verse number="26" style="v" sid="JOS 8:26" />जो हाथ सी यहोशू भाला उठायो हुयो होतो, ओख तब तक ओन खल्लो नहीं करयो जब तक ऐ नगर को निवासियों ख पूरी तरह नाश नहीं कर दियो गयो। <verse eid="JOS 8:26" /><verse number="27" style="v" sid="JOS 8:27" />परमेश्वर की वा आज्ञा को अनुसार जो ओन यहोशू ख दी होती इस्राएलियों न पशु अऊर नगर को सब सामान अपनो लायी लूट लियो। <verse eid="JOS 8:27" /><verse number="28" style="v" sid="JOS 8:28" />तब यहोशू न ऐ नगर म आगी लगाय दियो, अऊर ओख हमेशा लायी खंडहर बनाय दियो : ऊ अज तक उजाड़ पड़्यो हय। <verse eid="JOS 8:28" /><verse number="29" style="v" sid="JOS 8:29" />अऊर ऐ नगर को राजा ख ओन शाम तक झाड़ पर लटकाय दियो; अऊर सूर्य डुबतो समय यहोशू की आज्ञा सी ओको शव झाड़ पर सी उतार क नगर की फाटक को सामने डाल दियो गयो, अऊर ओको पर गोटावों को बड़ो ढेर लगाय दियो, जो अज तक बन्यो हय।<verse eid="JOS 8:29" /></para>
  <para style="s">एबाल पहाड़ी पर व्यवस्था को पाठ</para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 8:30" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:30 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 27:2-8">व्यवस्थाविवरन २७:२-८</ref>
      </char>
    </note>तब यहोशू न इस्राएल को परमेश्वर यहोवा को लायी एबाल पहाड़ी पर एक वेदी बनवायी, <verse eid="JOS 8:30" /><verse number="31" style="v" sid="JOS 8:31" /><note caller="+" style="x"><char style="xo" closed="false">8:31 </char><char style="xt" closed="false"><ref loc="EXO 20:25">निर्गमन २०:२५</ref></char></note>जसो परमेश्वर को सेवक मूसा न इस्राएलियों ख आज्ञा दी होती, अऊर जसी मूसा की व्यवस्था की किताब म लिख्यो हय, ओन असो गोटावों ख ले क एक वेदी बनायी जेको पर कोयी भी तरह को अवजार को उपयोग नहीं करयो गयो होतो। अऊर ओको पर उन्न परमेश्वर लायी होमबलि अऊर मेलबलि चढ़ायो। <verse eid="JOS 8:31" /><verse number="32" style="v" sid="JOS 8:32" />उच जागा पर यहोशू न इस्राएलियों को सामने उन गोटावों को ऊपर मूसा की व्यवस्था, जो ओन लिखी होती, ओकी नकल करायी। <verse eid="JOS 8:32" /><verse number="33" style="v" sid="JOS 8:33" />अऊर हि देशी परदेशी, पूरो इस्राएली अपनो बुजूर्ग लोगों, सरदारों, अऊर न्यायियों समेत परमेश्वर को वाचा को सन्दूक उठावन वालो लेवी याजकों को सामने इत उत खड़ो भयो, मतलब अरधो लोग गिरिज्जीम पहाड़ी को, अऊर अरधो लोग एबाल पहाड़ी को सामने खड़ो भयो, जसो कि परमेश्वर को दास मूसा न पहले सी आज्ञा दी होती कि इस्राएली प्रजा ख आशीर्वाद दियो जाये। <verse eid="JOS 8:33" /><verse number="34" style="v" sid="JOS 8:34" />ओको बाद यहोशू न आशीष अऊर श्राप की व्यवस्था को पूरो वचन, जसो व्यवस्था की किताब म लिख्यो हय वसोच पढ़ क सुनाय दियो। <verse eid="JOS 8:34" /><verse number="35" style="v" sid="JOS 8:35" /><note caller="+" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="DEU 11:29">व्यवस्थाविवरन ११:२९</ref>; <ref loc="DEU 27:11-14">२७:११-१४</ref></char></note>जितनी बातों की मूसा न आज्ञा दी होती, उन म सी कोयी असी बात नहीं रही जो यहोशू न इस्राएल की पूरी सभा, अऊर बाईयों, अऊर बाल-बच्चां, अऊर उन्को संग रहन वालो परदेशी लोगों को सामने भी पढ़ क नहीं सुनायी गयी होना।<verse eid="JOS 8:35" /></para>
  <chapter eid="JOS 8" />
  <chapter number="9" style="c" sid="JOS 9" />
  <para style="s">गिबोनियों न यहोशू ख धोका देनो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 9:1" />यो सुन क हित्ती, एमोरी, कनानी, परिज्जी, हिब्बी, अऊर यबूसी, जितनो राजा यरदन को येन पार पहाड़ी देश म अऊर खल्लो को देश म, अऊर लबानोन को सामने महासागर को किनार पर रहत होतो, <verse eid="JOS 9:1" /><verse number="2" style="v" sid="JOS 9:2" />हि एक मन होय क यहोशू अऊर इस्राएलियों सी लड़न लायी जमा भयो।<verse eid="JOS 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 9:3" />जब गिबोन को निवासियों न ऊ सब सुन्यो कि जो यहोशू न यरीहो अऊर ऐ नगर को संग का का करयो हय, <verse eid="JOS 9:3" /><verse number="4" style="v" sid="JOS 9:4" />उन्न भी चालाकी करी, अपनी यात्रा राजदूतों को रूप म शुरू करी, उन्न अपनो गधा पर फट्यो पुरानो बोरा, अऊर पुरानी फटी जोड़ लगी हुयी अंगूरीरस की कुप्पी बान्ध लियो <verse eid="JOS 9:4" /><verse number="5" style="v" sid="JOS 9:5" />अऊर अपनो पाय म पुरानी चप्पल, अऊर पुरानो कपड़ा पहिन्यो, अऊर अपनो जेवन लायी बुर्सी लगी हुयी सूखी रोटी ले ली। <verse eid="JOS 9:5" /><verse number="6" style="v" sid="JOS 9:6" />तब हि गिलगाल की छावनी म यहोशू को जवर जाय क ओको सी अऊर इस्राएली लोगों सी कहन लग्यो, “हम दूर देश सी आयो हय; येकोलायी अब तुम हम सी वाचा बान्धो।”<verse eid="JOS 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 9:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:7 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 23:32">निर्गमन २३:३२</ref>; <ref loc="EXO 34:12">३४:१२</ref>; <ref loc="DEU 7:2">व्यवस्थाविवरन ७:२</ref></char>
    </note>इस्राएली लोगों न उन हिब्बियों सी कह्यो, “होय सकय हय कि तुम हमरो बीच म रहत होना; फिर हम तुम सी वाचा कसो बान्धबो?”<verse eid="JOS 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 9:8" />उन्न यहोशू सी कह्यो, “हम तोरो दास आय।”</para>
  <para style="p" vid="JOS 9:8">तब यहोशू न उन्को सी कह्यो, “तुम कौन आय? अऊर कहां सी आयो हय?”<verse eid="JOS 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 9:9" />तब उन्न ओको सी कह्यो, “हम तोरो दास तोरो परमेश्वर यहोवा को नाम सुन क बहुत दूर देश सी आयो हय; जो कार्य ओन मिस्र देश म करयो हय, ओको बारे म हम न सुन्यो हय, <verse eid="JOS 9:9" /><verse number="10" style="v" sid="JOS 9:10" /><note caller="+" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">गिनती २१:२१-३५</ref></char></note>अऊर जो कुछ ओन एमोरियों को दोयी राजावों को संग करयो जो यरदन को ओन पार पूर्व दिशा म रहत होतो, हेशबोन को राजा सीहोन, अऊर बाशान को राजा ओग जो अश्तारोत म होतो। <verse eid="JOS 9:10" /><verse number="11" style="v" sid="JOS 9:11" />येकोलायी हमरो यहां को बुजूर्ग लोगों न अऊर हमरो देश को निवासियों न हम सी कह्यो, कि रस्ता लायी अपनो संग भोजन को सामान ले क उन्को सी मिलन जावो, अऊर उन्को सी कहो, कि हम तुम्हरो दास आय; येकोलायी अब तुम हम सी वादा करो। <verse eid="JOS 9:11" /><verse number="12" style="v" sid="JOS 9:12" />जो दिन हम तुम्हरो जवर आवन लायी निकल्यो ऊ दिन त हम न अपनो अपनो घर सी या रोटी गरम अऊर ताजी धरी होती; पर अब देखो, या रोटी सुख गयी हय अऊर येको म बुर्सी लग गयी हय। <verse eid="JOS 9:12" /><verse number="13" style="v" sid="JOS 9:13" />फिर या जो अंगूरीरस कि कुप्पी हम न भर लियो होतो, तब त नयी होती, पर देखो अब हि फट गयी हय; अऊर हमरो यो कपड़ा अऊर चप्पल बड़ी लम्बी यात्रा को वजह पुरानी भय गयी हय।”<verse eid="JOS 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 9:14" />तब उन इस्राएल को लोगों न परमेश्वर सी बिना पुच्छ्यो उन्को जेवन म सी कुछ स्विकार करयो। <verse eid="JOS 9:14" /><verse number="15" style="v" sid="JOS 9:15" />तब यहोशू न उन्को संग मेल कर क् उन्को सी वाचा बान्धी कि तुम्ख जीन्दो छोड़बो; अऊर मण्डली को मुखियावों न उन सी कसम खायी।<verse eid="JOS 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 9:16" />उन्को संग वाचा बान्धन को तीन दिन बाद उन्ख यो सन्देश मिल्यो, कि हि हमरो पड़ोस को रहन वालो लोग आय, अऊर हमरोच बीच म बस्यो हंय। <verse eid="JOS 9:16" /><verse number="17" style="v" sid="JOS 9:17" />तब इस्राएली लोग निकल क तीसरो दिन उन्को नगरों ख गिबोन, कपीरा, बेरोत, अऊर किर्यत्यारीम म पहुंच गयो, <verse eid="JOS 9:17" /><verse number="18" style="v" sid="JOS 9:18" />पर इस्राएलियों न उन्ख नहीं मारयो, कहालीकि मण्डली को मुखियावों न उन्को संग इस्राएल को परमेश्वर यहोवा की कसम खायी होती। तब पूरी मण्डली को लोग मुखियावों को खिलाफ कुड़कुड़ावन लग्यो। <verse eid="JOS 9:18" /><verse number="19" style="v" sid="JOS 9:19" />तब सब मुखियावों न पूरी मण्डली को लोगों सी कह्यो, “हम न उन सी इस्राएल को परमेश्वर यहोवा की कसम खायी हय, येकोलायी अब हम उन्ख छुय नहीं सकजे। <verse eid="JOS 9:19" /><verse number="20" style="v" sid="JOS 9:20" />हम उन सी योच काम करबो कि वा कसम को अनुसार हम उन्ख जीन्दो छोड़ देबो, नहीं त हमरी खायी हुयी कसम को वजह हम पर परमेश्वर को गुस्सा भड़क उठेंन।” <verse eid="JOS 9:20" /><verse number="21" style="v" sid="JOS 9:21" />फिर मुखियावों न उन्को सी कह्यो, “हि जीन्दो छोड़्यो जाय।” पर मुखियावों को यो वचन को अनुसार हि पूरी मण्डली लायी लकड़ी काटेंन अऊर पानी भरेंन।<verse eid="JOS 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 9:22" />फिर यहोशू न गिबोन नगर को निवासियों ख बुलाय क कह्यो, “तुम त हमरो बीच म रह्य हय, फिर तुम न हम्ख धोखा कहाली दियो हय, कि हम तुम सी बहुत दूर रहजे हय? <verse eid="JOS 9:22" /><verse number="23" style="v" sid="JOS 9:23" />येकोलायी अब तुम श्रापित हय, अऊर तुम म सी हर कोयी परमेश्वर को दास, अऊर मोरो परमेश्वर को भवन लायी लकड़ी काटन वालो अऊर पानी भरन वालो बनेंन।”<verse eid="JOS 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 9:24" />उन्न यहोशू ख उत्तर दियो, “तोरो दासों ख यो जरूरच बतायो गयो होतो, कि तोरो परमेश्वर यहोवा न अपनो दास मूसा ख आज्ञा दी होती कि तुम्ख ऊ पूरो देश दे, अऊर ओको पूरो निवासियों को तुम्हरो सामने सी सर्वनाश करे; येकोलायी हम लोगों ख तुम्हरो वजह हम्ख अपनो जीव को डर लग्यो, येकोलायी हम न असो काम करयो। <verse eid="JOS 9:24" /><verse number="25" style="v" sid="JOS 9:25" />अऊर अब हम तोरो अधिकार म हय, जसो काम तोख अच्छो लगय हय, वसोच व्यवहार हमरो संग कर।” <verse eid="JOS 9:25" /><verse number="26" style="v" sid="JOS 9:26" />तब यहोशू न उन्को सी वसोच करयो, अऊर उन्ख इस्राएलियों को हाथ सी असो बचायो, कि हि उन्ख मार नहीं सके। <verse eid="JOS 9:26" /><verse number="27" style="v" sid="JOS 9:27" />पर यहोशू न उच दिन गिबोन को लोगों ख इस्राएल की मण्डली लायी, अऊर जो जागा परमेश्वर चुन लेयेंन ओको म ओकी वेदी लायी, लकड़ी काटन वालो अऊर पानी भरन वालो चुन लियो, वहां हि अज तक हय।<verse eid="JOS 9:27" /></para>
  <chapter eid="JOS 9" />
  <chapter number="10" style="c" sid="JOS 10" />
  <para style="s">एमोरियों पर विजय</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 10:1" />जब यरूशलेम को राजा अदोनीसेदक न सुन्यो कि यहोशू न ऐ नगर ख जीत लियो, अऊर ओको सत्यानाश कर डाल्यो हय, अऊर जसो ओन यरीहो नगर अऊर ओको राजा को संग करयो वसोच ऐ नगर अऊर ओको राजा को संग भी करयो हय, अऊर यो भी सुन्यो कि गिबोन को निवासियों न इस्राएलियों सी मेल करयो, अऊर उन्को बीच म रहन लग्यो हंय, <verse eid="JOS 10:1" /><verse number="2" style="v" sid="JOS 10:2" />तब हि बहुत डर गयो, कहालीकि गिबोन बड़ो नगर बल्की राजधानी को समान अऊर ऐ नगर सी बड़ो होतो, अऊर ओको सब निवासी शूरवीर होतो। <verse eid="JOS 10:2" /><verse number="3" style="v" sid="JOS 10:3" />येकोलायी यरूशलेम को राजा अदोनीसेदक न हेब्रोन को राजा होहाम, यर्मूत को राजा पिराम, लाकीश को राजा यापी, अऊर एग्लोन को राजा दबीर को जवर यो सन्देश भेज्यो : <verse eid="JOS 10:3" /><verse number="4" style="v" sid="JOS 10:4" />“मोरो जवर आय क गिबोन नगर ख हरावन म मोरी मदत करो; कहालीकि ओन यहोशू अऊर इस्राएलियों सी मेल कर लियो हय।” <verse eid="JOS 10:4" /><verse number="5" style="v" sid="JOS 10:5" />येकोलायी यरूशलेम, हेब्रोन, यर्मूत, लाकीश, अऊर एग्लोन को पाचयी एमोरी राजावों न अपनी अपनी पूरी सेना जमा कर क् चढ़ायी कर दी, अऊर गिबोन नगर को सामने डेरा डाल क ओको सी युद्ध छेड़ दियो।<verse eid="JOS 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 10:6" />तब गिबोन नगर को निवासियों न गिलगाल की छावनी म यहोशू को जवर यो सन्देश भेज्यो, “अपनो दासों को मुंड पर सी अपनो हाथ मत हटावों; तुरतच हमरो जवर आय क हम्ख बचाय ले, अऊर हमरी मदत कर; कहालीकि पहाड़ी पर रहन वालो एमोरी जाति को राजा हमरो खिलाफ जमा भयो हय।”<verse eid="JOS 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 10:7" />तब यहोशू पूरी सेना अऊर शक्तिशाली योद्धावों ख संग ले क गिलगाल सी निकल गयो। <verse eid="JOS 10:7" /><verse number="8" style="v" sid="JOS 10:8" />अऊर परमेश्वर न यहोशू सी कह्यो, “उन्को सी मत डर, कहालीकि मय न उन्ख तोरो हाथ म सौप दियो हय; उन म सी एक भी आदमी तोरो सामने खड़ो नहीं रह्य सकेंन।” <verse eid="JOS 10:8" /><verse number="9" style="v" sid="JOS 10:9" />तब यहोशू रातोंरात गिलगाल सी जाय क एकाएक उन पर हमला कर दियो। <verse eid="JOS 10:9" /><verse number="10" style="v" sid="JOS 10:10" />तब परमेश्वर न असो करयो कि हि इस्राएलियों सी घबराय गयो, अऊर इस्राएलियों न गिबोन नगर म उन्ख बुरी तरह मारयो, अऊर बेथोरोन को चढ़ाव पर उन्को पीछा कर क् अजेका अऊर मक्केदा नगर तक उन्ख मारतो गयो। <verse eid="JOS 10:10" /><verse number="11" style="v" sid="JOS 10:11" />फिर जब एमोरी इस्राएलियों को सामने सी भग क बेथोरोन को उतार पर आयो, तब अजेका पहुंचन तक परमेश्वर न आसमान सी बड़ी बड़ी गारगोटी उन पर बरसायी, अऊर हि मर गयो; जो गारगोटी सी मर गयो होतो उन्की गिनती इस्राएलियों की तलवार सी मारयो हुयो सी जादा होती।<verse eid="JOS 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 10:12" />ऊ समय, मतलब जो दिन परमेश्वर न एमोरियों ख इस्राएलियों को हाथ म सौंप दियो, ऊ दिन यहोशू न परमेश्वर सी इस्राएलियों को देखतो यो तरह कह्यो,</para>
  <para style="q1" vid="JOS 10:12">“हे सूर्य, तय गिबोन पर,</para>
  <para style="q1" vid="JOS 10:12">अऊर हे चन्दा, तय अय्यालोन की घाटी को ऊपर रुक्यो रह्य।”<verse eid="JOS 10:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="JOS 10:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:13 </char>
      <char style="xt" closed="false">
        <ref loc="2SA 1:18">२ शमूएल १:१८</ref>
      </char>
    </note>अऊर सूर्य ऊ समय तक रुक्यो रह्यो, अऊर चन्दा ऊ समय तक हट्यो नहीं, जब तक ऊ जाति को लोगों न अपनो दुस्मनो सी बदला नहीं लियो। का या बात याशार की किताब म नहीं लिखी हय कि सूर्य आसमान को बीचोंबीच रुक्यो रह्यो, अऊर लगभग पूरो दिन नहीं डुब्यो? <verse eid="JOS 10:13" /><verse number="14" style="v" sid="JOS 10:14" />नहीं त ओको सी पहले असो दिन भयो अऊर नहीं ओको बाद, जेको म परमेश्वर न कोयी आदमी की सुनी होना; कहालीकि परमेश्वर त इस्राएल को तरफ सी लड़त होतो।<verse eid="JOS 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 10:15" />तब यहोशू पूरो इस्राएलियों समेत गिलगाल की छावनी ख लौट गयो।<verse eid="JOS 10:15" /></para>
  <para style="s">एमोरियों को पाचयी राजावों ख यहोशू को द्वारा बन्दी बनायो जानो</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 10:16" />हि पाचयी राजा भग क मक्केदा को जवर की गुफा म लूक गयो। <verse eid="JOS 10:16" /><verse number="17" style="v" sid="JOS 10:17" />तब यहोशू ख यो सन्देश मिल्यो, “पाचयी राजा मक्केदा को जवर की गुफा म लूक्यो हुयो हम्ख मिल्यो हय।” <verse eid="JOS 10:17" /><verse number="18" style="v" sid="JOS 10:18" />यहोशू न कह्यो, “गुफा को दरवाजा पर बड़ो बड़ो गोटा लुढ़काय क उन पर पहरा देन लायी कुछ आदमियों ख बैठाय देवो; <verse eid="JOS 10:18" /><verse number="19" style="v" sid="JOS 10:19" />पर तुम मत ठहरो, अपनो दुस्मनों को पीछा कर क् उन म सी जो जो पीछु रह्य गयो हय उन्ख मार डालो, उन्ख अपनो अपनो नगर म सिरन को अवसर मत देवो; कहालीकि तुम्हरो परमेश्वर यहोवा न उन्ख तुम्हरो हाथ म सौप दियो हय।” <verse eid="JOS 10:19" /><verse number="20" style="v" sid="JOS 10:20" />जब यहोशू अऊर इस्राएली सैनिकों न दुस्मनों ख मार डाल्यो, अऊर उन म सी जो बच गयो हि गढ़ वालो नगर म घुस गयो,<verse eid="JOS 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 10:21" />तब सब लोग मक्केदा की छावनी म यहोशू को जवर सुरक्षित लौट आयो; अऊर इस्राएलियों को खिलाफ कोयी न मुंह सी एक शब्द भी नहीं निकाल्यो।<verse eid="JOS 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 10:22" />तब यहोशू न आज्ञा दी, “गुफा को दरवाजा खोल क उन पाचयी राजावों ख निकाल क मोरो जवर लावो।” <verse eid="JOS 10:22" /><verse number="23" style="v" sid="JOS 10:23" />उन्न असोच करयो, अऊर यरूशलेम, हेब्रोन, यर्मूत, लाकीश, अऊर एग्लोन को उन पाचयी राजावों ख गुफा म सी निकाल क ओको जवर ले गयो। <verse eid="JOS 10:23" /><verse number="24" style="v" sid="JOS 10:24" />जब हि उन राजावों ख यहोशू को जवर लायो, तब यहोशू न इस्राएल को सब लोगों ख बुलाय क अपनी सेना को अधिकारियों सी कह्यो, “जवर आय क अपनो अपनो पाय इन राजावों की गर्दन पर रखो।” अऊर उन्न जवर जाय क अपनो अपनो पाय उन्की गर्दनों पर रख्यो। <verse eid="JOS 10:24" /><verse number="25" style="v" sid="JOS 10:25" />तब यहोशू न अधिकारी सी कह्यो, “मत डरो, तुम्हरो मन कच्चो नहीं होय; हिम्मत बान्ध क मजबूत हो; कहालीकि परमेश्वर तुम्हरो सब दुस्मनों सी जिन्कोसी तुम लड़ाई करो असोच व्यवहार करेंन।” <verse eid="JOS 10:25" /><verse number="26" style="v" sid="JOS 10:26" />येको बाद यहोशू न उन पाच राजावों ख मार डाल्यो, अऊर पाच झाड़ो पर लटकाय दियो। अऊर हि शाम तक उन झाड़ो पर लटक्यो रह्यो। <verse eid="JOS 10:26" /><verse number="27" style="v" sid="JOS 10:27" />सूरज डुबतो समय यहोशू सी आज्ञा पा क लोगों न उन शवों ख उन झाड़ो पर सी उतार क उच गुफा म रख्यो जहां हि लूक्यो होतो डाल दियो, अऊर ऊ गुफा को द्वार पर बड़ो बड़ो गोटा रख दियो, हि अज तक वहांच रख्यो हय।<verse eid="JOS 10:27" /></para>
  <para style="s">अऊर जादा एमोरी राज्य पर विजय</para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 10:28" />उच दिन यहोशू न मक्केदा नगर ख हराय दियो, अऊर नगर को राजा अऊर ऊ नगर को लोगों ख तलवार सी मार डाल्यो; अऊर जितनो प्रानी ऊ नगर म होतो उन म सी कोयी ख भी जीन्दो नहीं छोड़्यो; अऊर जसो यहोशू न यरीहो को राजा को संग करयो होतो वसोच मक्केदा को राजा को संग भी करयो।<verse eid="JOS 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 10:29" />तब यहोशू सब इस्राएलियों को संग मक्केदा सी जाय क लिब्ना नगर ख पहुंच्यो, अऊर लिब्ना नगर सी लड़्यो; <verse eid="JOS 10:29" /><verse number="30" style="v" sid="JOS 10:30" />अऊर परमेश्वर न लिब्ना नगर अऊर ओको राजा ख भी इस्राएलियों को हाथ म सौप दियो; अऊर यहोशू न नगर ख अऊर ओको म को सब प्रानियों ख तलवार सी मार डाल्यो; अऊर ओको म सी कोयी ख भी जीन्दो नहीं छोड़्यो; अऊर ओको राजा सी वसोच करयो जसो ओन यरीहो को राजा को संग करयो होतो।<verse eid="JOS 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 10:31" />फिर यहोशू सब इस्राएलियों को संग लिब्ना नगर सी चल क लाकीश नगर ख गयो, अऊर डेरा डाल क ओको खिलाफ युद्ध करयो; <verse eid="JOS 10:31" /><verse number="32" style="v" sid="JOS 10:32" />अऊर परमेश्वर न लाकीश नगर ख इस्राएल को हाथ म सौंप दियो, अऊर दूसरो दिन ओन ओख जीत लियो; अऊर जसो ओन लिब्ना को सब प्रानियों ख तलवार सी मारयो होतो वसोच ओन लाकीश नगर सी भी करयो। <verse eid="JOS 10:32" /><verse number="33" style="v" sid="JOS 10:33" />तब गेजेर नगर को राजा होराम लाकीश नगर की मदत करन आयो; अऊर यहोशू न सेना समेत ओख भी मारयो ओन ओको एक भी व्यक्ति जीन्दो नहीं छोड़्यो।<verse eid="JOS 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 10:34" />फिर यहोशू सब इस्राएलियों समेत लाकीश नगर सी चल क एग्लोन नगर ख गयो; अऊर डेरा डाल क ओको खिलाफ युद्ध करन लग्यो; <verse eid="JOS 10:34" /><verse number="35" style="v" sid="JOS 10:35" />अऊर उच दिन उन्न ओको पर अधिकार कर लियो, अऊर ओको म रहन वालो सब प्रानियों ख तलवार सी मार डाल्यो; अऊर उच दिन जसो ओन लाकीश नगर को सब प्रानियों को सत्यानाश कर डाल्यो होतो वसोच ओन एग्लोन नगर सी भी करयो।<verse eid="JOS 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JOS 10:36" />फिर यहोशू सब इस्राएलियों समेत एग्लोन नगर सी चल क हेब्रोन नगर ख गयो, अऊर ओको सी भी युद्ध करयो; <verse eid="JOS 10:36" /><verse number="37" style="v" sid="JOS 10:37" />अऊर उन्न ओको पर भी अधिकार कर लियो, ओन ओको राजा अऊर ओको म रहन वालो सब प्रानियों ख तलवार सी मार डाल्यो, जसो यहोशू न एग्लोन नगर सी करयो होतो वसोच ओन हेब्रोन म भी कोयी ख जीन्दो नहीं छोड़्यो; ओन नगर ख अऊर ओको म को सब प्रानियों ख नाश कर डाल्यो।<verse eid="JOS 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JOS 10:38" />तब यहोशू सब इस्राएलियों को संग दबीर नगर ख गयो, अऊर ओको सी युद्ध करन लग्यो; <verse eid="JOS 10:38" /><verse number="39" style="v" sid="JOS 10:39" />अऊर ओको राजा अऊर ओको सब गांवो पर अधिकार कर लियो; अऊर उन्न उन्ख तलवार सी मार डाल्यो, अऊर जितनो प्रानी उन म होतो सब को सत्यानाश कर डाल्यो; कोयी ख जीन्दो नहीं छोड़्यो, जसो यहोशू न हेब्रोन अऊर लिब्ना अऊर ओको राजा को संग करयो होतो वसोच ओन दबीर अऊर ओको राजा को संग भी करयो।<verse eid="JOS 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 10:40" />यो तरह यहोशू न ऊ पूरो देश ख, मतलब पहाड़ी देश, दक्षिन देश, खल्लो को देश, अऊर ढलान को देश ख, ओको सब राजावों समेत मार डाल्यो; अऊर इस्राएल को परमेश्वर यहोवा की आज्ञा को अनुसार कोयी ख जीन्दो नहीं छोड़्यो, बल्की जितनो प्रानी होतो सब को सत्यानाश कर डाल्यो। <verse eid="JOS 10:40" /><verse number="41" style="v" sid="JOS 10:41" />अऊर यहोशू न दक्षिन को कादेशबर्ने नगर सी अज्जा नगर तक, अऊर गोशेन देश सी उत्तर को गिबोन नगर तक को लोगों ख मार डाल्यो। <verse eid="JOS 10:41" /><verse number="42" style="v" sid="JOS 10:42" />इन सब राजावों ख ओको देशों समेत यहोशू न एकच समय म अधिकार कर लियो, कहालीकि इस्राएल को परमेश्वर यहोवा इस्राएलियों को तरफ सी लड़त होतो। <verse eid="JOS 10:42" /><verse number="43" style="v" sid="JOS 10:43" />तब यहोशू सब इस्राएलियों को संग गिलगाल की छावनी म लौट आयो।<verse eid="JOS 10:43" /></para>
  <chapter eid="JOS 10" />
  <chapter number="11" style="c" sid="JOS 11" />
  <para style="s">राजा याबीन अऊर ओको संगियों की यहोशू द्वारा हार</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 11:1" />यो सुन क हासोर को राजा याबीन न मादोन नगर को राजा योबाब, अऊर शिम्रोन नगर अऊर अक्षाप नगर को राजा ख, <verse eid="JOS 11:1" /><verse number="2" style="v" sid="JOS 11:2" />अऊर जो जो राजा उत्तर को तरफ पहाड़ी देश म, अऊर किन्नेरेत को दक्षिन को अराबा म, अऊर खल्लो को देश म, अऊर पश्चिम को तरफ दोर नगर को ऊंचो देश म रहत होतो, उन्ख, <verse eid="JOS 11:2" /><verse number="3" style="v" sid="JOS 11:3" />अऊर पूर्व अऊर पश्चिम दोयी तरफ को रहन वालो कनानियों, अऊर एमोरियों, हित्तियों, परिज्जियों, अऊर पहाड़ी यबूसियों, अऊर मिस्पा देश म हेर्मोन पहाड़ी को खल्लो रहन वालो हिब्बियों ख सन्देश भेज्यो। <verse eid="JOS 11:3" /><verse number="4" style="v" sid="JOS 11:4" />अऊर हि अपनी अपनी सेना समेत, जो समुन्दर को किनार की रेतु को कन को समान बहुत होतो, मिल क नगरों सी निकल आयो, अऊर उन्को संग बहुत सो घोड़ा अऊर रथ भी होतो। <verse eid="JOS 11:4" /><verse number="5" style="v" sid="JOS 11:5" />तब हि सब राजा सम्मति कर क् जमा भयो, अऊर इस्राएलियों सी लड़न ख मेरोम नाम को तलाव को जवर आय क एक संग डेरा डाल्यो।<verse eid="JOS 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 11:6" />तब परमेश्वर न यहोशू सी कह्यो, “उन सी मत डरो, कहालीकि कल योच समय मय उन सब ख इस्राएलियों को हाथ म सौप क मरवाय डालूं; तब तय उन्को घोड़ा को घुटना की नस कटवायजो, अऊर उन्को रथ जलाय क भस्म कर देजो।” <verse eid="JOS 11:6" /><verse number="7" style="v" sid="JOS 11:7" />अऊर यहोशू सब सैनिकों को संग मेरोम नाम को तलाव को जवर पहुंच क अचानक उन पर टूट पड़्यो। <verse eid="JOS 11:7" /><verse number="8" style="v" sid="JOS 11:8" />अऊर परमेश्वर न उन्ख इस्राएलियों को हाथ म सौंप दियो, येकोलायी उन्न उन्ख मार डाल्यो, अऊर बड़ो नगर सीदोन अऊर मिस्रपोतमैम तक, अऊर पूर्व को तरफ मिस्पा को मैदान तक उन्को पीछा करयो; अऊर उन्ख मारयो, अऊर उन म सी कोयी ख जीन्दो नहीं छोड़्यो। <verse eid="JOS 11:8" /><verse number="9" style="v" sid="JOS 11:9" />तब यहोशू न परमेश्वर की आज्ञा को अनुसार उन्को संग वसोच करयो, मतलब उन्को घोड़ा की घुटना की नस कटवायी, अऊर उन्को रथ आगी म जलाय क भस्म कर दियो।<verse eid="JOS 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 11:10" />ऊ समय यहोशू न हासोर नगर ख जो पहले उन सब राज्यो म मुख्य नगर होतो अधिकार कर लियो, अऊर ओको राजा ख तलवार सी मार डाल्यो। <verse eid="JOS 11:10" /><verse number="11" style="v" sid="JOS 11:11" />अऊर जितनो प्रानी ओको म होतो उन सब ख उन्न तलवार सी मार क नाश कर दियो; अऊर कोयी प्रानी ख जीन्दो नहीं छोड़्यो, अऊर हासोर ख यहोशू न आगी लगाय क फुंकवाय दियो।<verse eid="JOS 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 11:12" />अऊर उन सब नगरों ख अऊर ओको सब राजावों समेत यहोशू न अधिकार कर लियो, अऊर परमेश्वर को सेवक मूसा की आज्ञा को अनुसार उन्ख तलवार सी मार क नाश कर दियो। <verse eid="JOS 11:12" /><verse number="13" style="v" sid="JOS 11:13" />पर हासोर नगर ख छोड़ क, जेक यहोशू न जलाय दियो होतो, इस्राएलियों न अऊर कोयी नगर ख जो पहाड़ी पर बस्यो होतो नहीं जलायो। <verse eid="JOS 11:13" /><verse number="14" style="v" sid="JOS 11:14" />अऊर उन नगरों को जनावर अऊर उन्की पूरी लूट की सम्पत्ति ख इस्राएलियों न अपनो जवर रख लियो; पर आदमियों ख उन्न तलवार सी मार डाल्यो, यहां तक उन्को सत्यानाश कर दियो कि एक भी प्रानी जीन्दो नहीं छोड़्यो गयो। <verse eid="JOS 11:14" /><verse number="15" style="v" sid="JOS 11:15" />जो आज्ञा परमेश्वर न अपनो दास मूसा ख दी होती ओकोच अनुसार मूसा न यहोशू ख आज्ञा दी, अऊर ठीक वसोच यहोशू न भी करयो; जो जो आज्ञा परमेश्वर न मूसा ख दी होती उन म सी यहोशू न कोयी भी आज्ञा पूरी करयो बिना नहीं छोड़्यो।<verse eid="JOS 11:15" /></para>
  <para style="s">यहोशू द्वारा जीतयो गयो देश</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 11:16" />तब यहोशू न ऊ पूरो देश ख, मतलब पहाड़ी देश, अऊर पूरो दक्षिन देश, अऊर गोशेन देश, अऊर खल्लो को जमीन देश, यरदन घाटी, अऊर इस्राएल को पहाड़ी देश, अऊर उन्को खल्लो वालो देश ख, <verse eid="JOS 11:16" /><verse number="17" style="v" sid="JOS 11:17" />हालाक नाम की पहाड़ी सी ले क, जो सेईर की चढ़ायी पर हय, बालगाद नगर तक, जो लबानोन को मैदान म हेर्मोन पहाड़ी को खल्लो, जितनो देश हय जीत लियो अऊर उन देशों को पूरो राजावों ख पकड़ क मार डाल्यो। <verse eid="JOS 11:17" /><verse number="18" style="v" sid="JOS 11:18" />उन सब राजावों सी लड़ाई करत करत यहोशू ख बहुत दिन लग गयो। <verse eid="JOS 11:18" /><verse number="19" style="v" sid="JOS 11:19" />गिबोन को निवासी हिब्बियों ख छोड़ क अऊर कोयी नगर को लोगों न इस्राएलियों सी मेल-मिलाप नहीं करयो; अऊर सब नगरों ख उन्न युद्ध कर क् जीत लियो। <verse eid="JOS 11:19" /><verse number="20" style="v" sid="JOS 11:20" /><note caller="+" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="DEU 7:16">व्यवस्थाविवरन ७:१६</ref></char></note>कहालीकि परमेश्वर की जो मनसा होती, कि अपनी वा आज्ञा को अनुसार जो ओन मूसा ख दी होती उन पर कुछ भी दया नहीं करे, बल्की सत्यानाश कर डाले, यो वजह ओन उन्को मन असो कठोर कर दियो, कि उन्न इस्राएलियों को सामना कर क् उन सी युद्ध करयो।<verse eid="JOS 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 11:21" />ऊ समय यहोशू न पहाड़ी देश म आय क हेब्रोन, दबीर, अनाब, यहूदा अऊर इस्राएल दोयी को पूरो पहाड़ी देश म रहन वालो अनाकियों ख नाश कर दियो; यहोशू न नगरों समेत उन्को सत्यानाश कर डाल्यो। <verse eid="JOS 11:21" /><verse number="22" style="v" sid="JOS 11:22" />इस्राएलियों को देश म कोयी अनाकी व्यक्ति नहीं रह्य गयो; केवल अज्जा, गत, अऊर अशदोद नगर म कोयी कोयी रह्य गयो।<verse eid="JOS 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JOS 11:23" />जसो परमेश्वर न मूसा सी कह्यो होतो, वसोच यहोशू न ऊ पूरो देश पर अधिकार कर लियो; अऊर ओख इस्राएल को गोत्रों अऊर कुलों को अनुसार बाट क उन्ख दे दियो।</para>
  <para style="p" vid="JOS 11:23">अऊर तब युद्ध को बाद देश ख शान्ति मिली।<verse eid="JOS 11:23" /></para>
  <chapter eid="JOS 11" />
  <chapter number="12" style="c" sid="JOS 12" />
  <para style="s">मूसा द्वारा राजावों पर विजय</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 12:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:1 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 21:21-35">गिनती २१:२१-३५</ref>; <ref loc="DEU 2:26">व्यवस्थाविवरन २:२६</ref>; <ref loc="DEU 3:11">३:११</ref></char>
    </note>यरदन नदी को ओन पार पूर्व दिशा को तरफ, मतलब अर्नोन घाटी सी ले क हेर्मोन पहाड़ी तक को देश, अऊर पूरो पूर्व अराबा को जिन राजावों ख इस्राएलियों न मार क उन्को देश ख अपनो अधिकार म कर लियो होतो हि यो आय : <verse eid="JOS 12:1" /><verse number="2" style="v" sid="JOS 12:2" />एमोरियों को हेशबोन नगर को राजा सीहोन, जो अर्नोन घाटी को किनार को अरोएर नगर सी ले क, अऊर उच घाटी को बीच को नगर ख छोड़ क यब्बोक नदी तक, जो अम्मोनियों कि सीमा हय, अरधो गिलाद को बराबर होतो, <verse eid="JOS 12:2" /><verse number="3" style="v" sid="JOS 12:3" />अऊर किन्नेरेत नाम को तलाव सी ले क बेत्यशीमोत सी होय क अराबा को तलाव तक; जो खारो तलाव भी कहलावय हय, पूर्व को तरफ को अराबा, अऊर दक्षिन को तरफ पिसगा को ढलान को खल्लो को देश पर शासन करत होतो।<verse eid="JOS 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 12:4" />फिर बच्यो हुयो रपाई जाती म सी बाशान देश को राजा ओग को देश होतो, जो अश्तारोत अऊर एद्रेई नगर म रह्यो करत होतो, <verse eid="JOS 12:4" /><verse number="5" style="v" sid="JOS 12:5" /><note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">गिनती २१:२१-३५</ref>; <ref loc="DEU 2:26">व्यवस्थाविवरन २:२६</ref>; <ref loc="DEU 3:11">३:११</ref></char></note>अऊर हेर्मोन पहाड़ी, सल्का, अऊर गशूरियों, अऊर माकियों की सीमा तक कुल बाशान देश म, अऊर हेशबोन को राजा सीहोन की सीमा तक अरधो गिलाद देश म भी शासन करत होतो।<verse eid="JOS 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 12:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:6 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 32:33">गिनती ३२:३३</ref>; <ref loc="DEU 3:12">व्यवस्थाविवरन ३:१२</ref></char>
    </note>इस्राएलियों अऊर परमेश्वर को दास मूसा न इन ख मार डाल्यो; अऊर परमेश्वर को सेवक मूसा न इन्को देश रूबेनियों अऊर गादियों अऊर मनश्शे को अरधो गोत्र को लोगों ख दे दियो।<verse eid="JOS 12:6" /></para>
  <para style="s">यहोशू द्वारा राजावों पर विजय</para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 12:7" />यरदन नदी को पश्चिम को तरफ, लबानोन को मैदान म को बालगाद नगर सी ले क सेईर की चढ़ायी को हालाक पहाड़ी तक को देश को जिन राजावों ख यहोशू अऊर इस्राएलियों न मार क उन्को देश इस्राएलियों ख गोत्रों अऊर कुलों को अनुसार भाग कर क् दे दियो होतो हि यो आय : <verse eid="JOS 12:7" /><verse number="8" style="v" sid="JOS 12:8" />हित्ती, एमोरी, कनानी, परिज्जी, हिब्बी, यबूसी जाती, जो पहाड़ी देश म, खल्लो को देश म, अराबा म, ढलान देश म, जंगल म, अऊर दक्षिन देश म रहत होती। <verse eid="JOS 12:8" /><verse number="9" style="v" sid="JOS 12:9" />एक, यरीहो को राजा; एक, बेतेल को जवर ऐ नगर को राजा; <verse eid="JOS 12:9" /><verse number="10" style="v" sid="JOS 12:10" />एक, यरूशलेम को राजा; एक, हेब्रोन को राजा; <verse eid="JOS 12:10" /><verse number="11" style="v" sid="JOS 12:11" />एक, यर्मूत को राजा; एक, लाकीश को राजा; <verse eid="JOS 12:11" /><verse number="12" style="v" sid="JOS 12:12" />एक, एग्लोन को राजा; एक, मेजेर को राजा; <verse eid="JOS 12:12" /><verse number="13" style="v" sid="JOS 12:13" />एक, दबीर को राजा; एक, गेदेर को राजा; <verse eid="JOS 12:13" /><verse number="14" style="v" sid="JOS 12:14" />एक, होर्मा को राजा; एक, अराद को राजा; <verse eid="JOS 12:14" /><verse number="15" style="v" sid="JOS 12:15" />एक, लिब्ना को राजा; एक, अदुल्लाम को राजा; <verse eid="JOS 12:15" /><verse number="16" style="v" sid="JOS 12:16" />एक, मक्केदा को राजा; एक, बेतेल को राजा; <verse eid="JOS 12:16" /><verse number="17" style="v" sid="JOS 12:17" />एक, तप्पूह को राजा; एक, हेपेर को राजा; <verse eid="JOS 12:17" /><verse number="18" style="v" sid="JOS 12:18" />एक, अपेक को राजा; एक, लश्शारोन को राजा; <verse eid="JOS 12:18" /><verse number="19" style="v" sid="JOS 12:19" />एक, मादोन को राजा; एक, हासोर को राजा; <verse eid="JOS 12:19" /><verse number="20" style="v" sid="JOS 12:20" />एक, शिम्रोन्मरोन को राजा; एक, अक्षाप को राजा; <verse eid="JOS 12:20" /><verse number="21" style="v" sid="JOS 12:21" />एक, तानाक को राजा; एक, मगिद्दो को राजा; <verse eid="JOS 12:21" /><verse number="22" style="v" sid="JOS 12:22" />एक, केदेश को राजा; एक, कर्मेल म को योकनाम को राजा; <verse eid="JOS 12:22" /><verse number="23" style="v" sid="JOS 12:23" />एक, दोर नाम को ऊंचो देश म को दोर को राजा; एक, गिलगाल म को गोयीम को राजा; <verse eid="JOS 12:23" /><verse number="24" style="v" sid="JOS 12:24" />अऊर एक, तिर्सा को राजा हय; यो तरह सब राजा येकतीस भयो।<verse eid="JOS 12:24" /></para>
  <chapter eid="JOS 12" />
  <chapter number="13" style="c" sid="JOS 13" />
  <para style="s">अऊर भी राज्य ख जितनो हय</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 13:1" />यहोशू बूढ्ढा अऊर बहुत उमर को भय गयो होतो; अऊर परमेश्वर न ओको सी कह्यो, “तय बूढ्ढा अऊर बहुत उमर को भय गयो हय, अऊर बहुत देश रह्य गयो हंय, जो इस्राएल को अधिकार म अभी तक नहीं आयो। <verse eid="JOS 13:1" /><verse number="2" style="v" sid="JOS 13:2" />यो देश रह्य गयो हय, पलिश्तियों को पूरो प्रान्त, अऊर पूरो गशूरी देश <verse eid="JOS 13:2" /><verse number="3" style="v" sid="JOS 13:3" />मिस्र देश को आगु शीहोर नदी सी ले क उत्तर को तरफ एक्रोन नगर की सीमा तक जो कनानियों को भाग गिन्यो जावय हय; अऊर पलिश्तियों को पाचों सरदार, मतलब अज्जा, अशदोद, अशकलोन, गत, अऊर एक्रोन को लोग, अऊर दक्षिन को तरफ अव्वी जाती भी, <verse eid="JOS 13:3" /><verse number="4" style="v" sid="JOS 13:4" />फिर अपेक नगर अऊर एमोरियों की सीमा तक कनानियों को पूरो देश, अऊर सीदोनियों को मारा नाम को देश, <verse eid="JOS 13:4" /><verse number="5" style="v" sid="JOS 13:5" />फिर गवालियों को देश, अऊर पूर्व को तरफ हेर्मोन पहाड़ी को खल्लो को बालगाद नगर सी ले क हमात की घाटी तक पूरो लबानोन प्रदेश, <verse eid="JOS 13:5" /><verse number="6" style="v" sid="JOS 13:6" /><note caller="+" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="NUM 33:54">गिनती ३३:५४</ref></char></note>फिर लबानोन प्रदेश सी ले क मिस्रपोतमैम तक सीदोनियों को पहाड़ी देश को निवासी। इन ख मय इस्राएलियों को सामने सी निकाल देऊं; इतनो होय कि तय मोरी आज्ञा को अनुसार उन्को अधिकार इस्राएलियों को बीच म बाट दे। <verse eid="JOS 13:6" /><verse number="7" style="v" sid="JOS 13:7" />येकोलायी तय अब यो देश ख नव गोत्रों अऊर मनश्शे को अरधो गोत्र ख उन्को हिस्सा होन लायी बाट दे।”<verse eid="JOS 13:7" /></para>
  <para style="s">यरदन को पूर्व भाग को बंटवारा</para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 13:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:8 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 32:33">गिनती ३२:३३</ref>; <ref loc="DEU 3:12">व्यवस्थाविवरन ३:१२</ref></char>
    </note>रूबेनियों अऊर गादियों ख त ऊ हिस्सा मिल चुक्यो होतो, जेक मूसा न उन्ख यरदन नदी को पूर्व को तरफ दियो होतो, कहालीकि परमेश्वर को सेवक न यो उन्खच दियो होतो, <verse eid="JOS 13:8" /><verse number="9" style="v" sid="JOS 13:9" />मतलब अर्नोन नाम की घाटी को किनार को अरोएर नगर सी ले क, अऊर उच घाटी को बीच को नगर ख छोड़ क दीबोन नगर तक मेदबा को जवर को पूरो चौरस देश; <verse eid="JOS 13:9" /><verse number="10" style="v" sid="JOS 13:10" />अऊर अम्मोनियों की सीमा तक हेशबोन म रहन वालो एमोरियों को राजा सीहोन को पूरो नगर; <verse eid="JOS 13:10" /><verse number="11" style="v" sid="JOS 13:11" />अऊर गिलाद देश, अऊर गशूरियों अऊर माकावासियों की सीमा, अऊर पूरो हेर्मोन पहाड़ी, अऊर सल्का नगर तक पूरो बाशान प्रदेश, <verse eid="JOS 13:11" /><verse number="12" style="v" sid="JOS 13:12" />फिर अश्तारोत अऊर एद्रेई नगर म रहन वालो ऊ ओग को पूरो राज्य जो रपाई जाती म सी अकेलो बच गयो होतो; कहालीकि इन ख मूसा न मार क उन्की प्रजा ख ऊ देश सी निकाल दियो होतो। <verse eid="JOS 13:12" /><verse number="13" style="v" sid="JOS 13:13" />पर इस्राएलियों न गशूरियों अऊर माकियों ख उन्को देश सी नहीं निकाल्यो; येकोलायी गशूरी अऊर माकी जाती इस्राएलियों को बीच म अज तक रह्य हय।<verse eid="JOS 13:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 13:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:14 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 18:1">व्यवस्थाविवरन १८:१</ref>
      </char>
    </note>अऊर लेवी को कुल ख मूसा न कोयी हिस्सा नहीं दियो; कहालीकि इस्राएल को परमेश्वर यहोवा को वचन को अनुसार ओकीच चढ़ायी हुयी होमबलि बलि की भेंट उन्को लायी हिस्सा ठहरी हय।<verse eid="JOS 13:14" /></para>
  <para style="s">रूबेन को वंश ख दियो गयो हिस्सा</para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 13:15" />मूसा न जमीन को हिस्सा रूबेन को वंश ख उन्को परिवार ख बाट दियो होतो, <verse eid="JOS 13:15" /><verse number="16" style="v" sid="JOS 13:16" />मतलब अर्नोन नाम की घाटी को किनार को अरोएर नगर सी ले क अऊर उच घाटी को बीच को नगर ख छोड़ क मेदबा को जवर को पूरो चौरस देश; <verse eid="JOS 13:16" /><verse number="17" style="v" sid="JOS 13:17" />फिर चौरस देश म को हेशबोन अऊर ओको सब गांव; फिर दीबोन, बामोतबाल, बेतबाल्मोन, <verse eid="JOS 13:17" /><verse number="18" style="v" sid="JOS 13:18" />यहसा, कदेमोत, मेपात, <verse eid="JOS 13:18" /><verse number="19" style="v" sid="JOS 13:19" />किर्यातैम, सिबमा, अऊर घाटी म की पहाड़ी पर बस्यो हुयो सेरेथश्शहर, <verse eid="JOS 13:19" /><verse number="20" style="v" sid="JOS 13:20" />बेतपोर, पिसगा पहाड़ी की ढलान अऊर बेत्यशीमोत, <verse eid="JOS 13:20" /><verse number="21" style="v" sid="JOS 13:21" />मतलब चौरस देश म बस्यो हुयो हेशबोन म रहन वालो एमोरियों को ऊ राजा सीहोन को राज्य को पूरो नगर जिन्ख मूसा न मार लियो होतो। मूसा न एवी, रेकेम, सूर, हूर, अऊर रेबा नाम को मिद्दानी जाती को मुखियावों ख भी मार डाल्यो होतो जो सीहोन को ठहरायो हुयो शासक अऊर उच देश को निवासी होतो। <verse eid="JOS 13:21" /><verse number="22" style="v" sid="JOS 13:22" />अऊर इस्राएलियों न उन्को अऊर मारयो हुयो व्यक्तियों को संग बोर को टुरा भविष्य बतावन वालो बिलाम ख भी तलवार सी मार डाल्यो। <verse eid="JOS 13:22" /><verse number="23" style="v" sid="JOS 13:23" />अऊर रूबेनियों की सीमा यरदन नदी को किनार होतो। रूबेनियों को हिस्सा उन्को वंशों अऊर कुलों को अनुसार योच नगर अऊर गांव उन्को हिस्सा होतो।<verse eid="JOS 13:23" /></para>
  <para style="s">गाद को कुल ख दियो गयो हिस्सा</para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 13:24" />फिर मूसा न गाद को वंशों ख भी कुलों को अनुसार उन्को हिस्सा कर क् बाट दियो। <verse eid="JOS 13:24" /><verse number="25" style="v" sid="JOS 13:25" />तब यो ठहरयो, मतलब याजेर या गिलाद प्रदेश को पूरो नगर, अऊर रब्बा नगर को सामने को अरोएर नगर तक अम्मोनियों को अरधो देश, <verse eid="JOS 13:25" /><verse number="26" style="v" sid="JOS 13:26" />अऊर हेशबोन नगर सी रामतमिस्पे अऊर बतोनीम् तक, अऊर महनैम सी दबीर की सीमा तक, <verse eid="JOS 13:26" /><verse number="27" style="v" sid="JOS 13:27" />अऊर घाटी म बेथारम, बेतनिम्रा, सुक्कोत, अऊर सापोन अऊर हेशबोन नगर को राजा सीहोन को राज्य को बच्यो हुयो हिस्सा, अऊर किन्नेरेत नाम को तलाव को किनार तक, यरदन नदी को पूर्व को तरफ को ऊ देश जेकी सीमा यरदन हय। <verse eid="JOS 13:27" /><verse number="28" style="v" sid="JOS 13:28" />गादी लोगों को हिस्सा उन्को कुलों को अनुसार नगरों अऊर गांवो समेत यहांच रूक गयो।<verse eid="JOS 13:28" /></para>
  <para style="s">पूर्व की मनश्शे को अरधो गोत्र ख दियो गयो हिस्सा</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 13:29" />फिर मूसा न मनश्शे को अरधो कुलों ख भी उन्को निजी हिस्सा कर क् दियो; ऊ मनश्शे को अरधो कुल को निजी हिस्सा उन्को कुलों को अनुसार ठहरयो। <verse eid="JOS 13:29" /><verse number="30" style="v" sid="JOS 13:30" />ऊ यो आय, मतलब महनैम सी ले क बाशान प्रदेश को राजा ओग को राज्य को पूरो देश, अऊर बाशान प्रदेश म बसी हुयी याईर की साठ बस्तियां, <verse eid="JOS 13:30" /><verse number="31" style="v" sid="JOS 13:31" />अऊर गिलाद को अरधो हिस्सा, अऊर अश्तारोत, अऊर एद्रेई, जो बाशान म ओग को राज्य को नगर होतो, हि मनश्शे को टुरा माकीर को वंश को, मतलब माकीर को अरधो वंश को निजी हिस्सा कुलों को अनुसार बाट दियो गयो।<verse eid="JOS 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 13:32" />जो हिस्सा मूसा न मोआब को मैदान म यरीहो को जवर को यरदन नदी को पूर्व को तरफ बाट दियो हि योच आय। <verse eid="JOS 13:32" /><verse number="33" style="v" sid="JOS 13:33" /><note caller="+" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="NUM 18:20">गिनती १८:२०</ref>; <ref loc="DEU 18:2">व्यवस्थाविवरन १८:२</ref></char></note>पर लेवी को गोत्र ख मूसा न कोयी हिस्सा नहीं दियो; इस्राएल को परमेश्वर यहोवाच अपनो वचन को अनुसार उन्को हिस्सा ठहरयो।<verse eid="JOS 13:33" /></para>
  <chapter eid="JOS 13" />
  <chapter number="14" style="c" sid="JOS 14" />
  <para style="s">यरदन को पश्चिमी भाग को बंटवारा</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 14:1" />जो जो हिस्सा इस्राएलियों ख कनान देश म मिल्यो, जिन्ख एलीआजार याजक, अऊर नून को टुरा यहोशू, अऊर इस्राएली गोत्र को पूर्वजों को घराना को मुख्य मुख्य आदमियों न उन्ख दियो हि यो आय। <verse eid="JOS 14:1" /><verse number="2" style="v" sid="JOS 14:2" /><note caller="+" style="x"><char style="xo" closed="false">14:2 </char><char style="xt" closed="false"><ref loc="NUM 26:52-56">गिनती २६:५२-५६</ref>; <ref loc="NUM 34:13">३४:१३</ref></char></note>जो आज्ञा परमेश्वर न मूसा को द्वारा साढ़े नव गोत्रों लायी दी होती, उन्को अनुसार उन्को हिस्सा चिट्ठी डाल क दियो गयो। <verse eid="JOS 14:2" /><verse number="3" style="v" sid="JOS 14:3" /><note caller="+" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="NUM 32:33">गिनती ३२:३३</ref>; <ref loc="NUM 34:14">३४:१४</ref>,<ref loc="NUM 34:15">१५</ref>; <ref loc="DEU 3:12-17">व्यवस्थाविवरन ३:१२-१७</ref></char></note>मूसा न त ढायी गोत्रों को हिस्सा यरदन को पार दियो होतो; पर लेवियों ख ओन उन्को संग कोयी हिस्सा नहीं दियो होतो। <verse eid="JOS 14:3" /><verse number="4" style="v" sid="JOS 14:4" />यूसुफ को वंश को दोय गोत्र होतो, मतलब मनश्शे अऊर एप्रैम; अऊर ऊ देश म लेवियों ख कुछ हिस्सा नहीं दियो गयो, केवल रहन लायी नगर, अऊर जनावर अऊर धन रखन लायी चराइयां उन्ख दी गयी। <verse eid="JOS 14:4" /><verse number="5" style="v" sid="JOS 14:5" />जो आज्ञा परमेश्वर न मूसा ख दी होती ओको अनुसार इस्राएलियों न करयो; अऊर उन्न देश ख बाट लियो।<verse eid="JOS 14:5" /></para>
  <para style="s">हेब्रोन नगर कालेब ख दियो जानो</para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 14:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:6 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 14:30">गिनती १४:३०</ref>
      </char>
    </note>तब यहूदी लोग यहोशू को जवर गिलगाल म आयो; अऊर कनजी यपुन्ने को टुरा कालेब न ओको सी कह्यो, “तय जानत होना कि परमेश्वर न कादेशबर्ने म परमेश्वर को सेवक मूसा सी मोरो अऊर तोरो बारे म का कह्यो होतो। <verse eid="JOS 14:6" /><verse number="7" style="v" sid="JOS 14:7" /><note caller="+" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="NUM 13:1-30">गिनती १३:१-३०</ref></char></note>जब परमेश्वर को दास मूसा न मोख यो देश को भेद लेन लायी कादेशबर्ने सी भेज्यो होतो तब मय चालीस साल को होतो; अऊर मय सच्चो मन सी ओको जवर सन्देश ले क आयो। <verse eid="JOS 14:7" /><verse number="8" style="v" sid="JOS 14:8" />अऊर मोरो संगी जो मोरो संग गयो होतो उन्न त प्रजा को लोगों को मन निराश कर दियो, पर मय न अपनो परमेश्वर यहोवा की पूरी रीति सी बात मानी। <verse eid="JOS 14:8" /><verse number="9" style="v" sid="JOS 14:9" /><note caller="+" style="x"><char style="xo" closed="false">14:9 </char><char style="xt" closed="false"><ref loc="NUM 14:24">गिनती १४:२४</ref></char></note>तब ऊ दिन मूसा न कसम खाय क मोरो सी कह्यो, ‘तय न पूरी रीति सी मोरो परमेश्वर यहोवा की बातों को अनुसरन करयो हय, यो तरह बिना सक जो जमीन पर तय पाय रख्यो हय ऊ हमेशा लायी तोरो अऊर तोरो वंश को हिस्सा होयेंन।’ <verse eid="JOS 14:9" /><verse number="10" style="v" sid="JOS 14:10" />अऊर अब देख, जब परमेश्वर न मूसा सी यो वचन कह्यो होतो तब सी पैतालीस साल भय गयो हय, जिन म इस्राएली लोग जंगल म भटकतो रह्यो; उन म परमेश्वर न अपनो वादा को अनुसार मोख जीन्दो रख्यो हय; अऊर अब मय पच्यासी साल को हय। <verse eid="JOS 14:10" /><verse number="11" style="v" sid="JOS 14:11" />जितनी शक्ति मूसा को भेजन को दिन मोरो म होती उतनी शक्ति अभी भी मोरो म हय; युद्ध करन, यां बाहेर आन-जान लायी जितनी शक्ति ऊ समय होती उतनीच शक्ति अभी भी मोरो म हय। <verse eid="JOS 14:11" /><verse number="12" style="v" sid="JOS 14:12" />येकोलायी अब ऊ पहाड़ी देश मोख दे जेकी चर्चा परमेश्वर न ऊ दिन करी होती; तय न त ऊ दिन सुन्यो होना कि ओको म अनक वंशी रह्य हंय, अऊर बड़ो बड़ो गढ़ वालो नगर भी हय; यदि परमेश्वर मोरो संग रहे, त ओकी प्रतिज्ञा को अनुसार मय उन्ख उन्को देश सी निकाल देऊं।”<verse eid="JOS 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 14:13" />तब यहोशू न ओख आशीर्वाद दियो; अऊर हेब्रोन नगर यपुन्ने को टुरा कालेब ख हिस्सा दे दियो। <verse eid="JOS 14:13" /><verse number="14" style="v" sid="JOS 14:14" />यो वजह हेब्रोन नगर कनजी यपुन्ने को टुरा कालेब को हिस्सा अज तक बन्यो हय, कहालीकि इस्राएल को परमेश्वर यहोवा को पूरी रीति सी अनुसरन करयो होतो।<verse eid="JOS 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 14:15" />पहले हेब्रोन नगर को नाम किर्यतर्बा होतो; ऊ अर्बा नाम को व्यक्ति अनाकियों म सब सी बड़ो आदमी होतो। अऊर युद्ध खतम होन को बाद ऊ देश ख शान्ति मिली।<verse eid="JOS 14:15" /></para>
  <chapter eid="JOS 14" />
  <chapter number="15" style="c" sid="JOS 15" />
  <para style="s">यहूदा को गोत्र ख दियो गयो हिस्सा</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 15:1" />यहूदा कुल को लोगों ख उन्को परिवारों की संख्या को अनुसार चिट्ठी डालन पर एदोम की सीमा मिली,</para>
  <para style="p" vid="JOS 15:1">जो दक्षिन को तरफ सीन को जंगल तक दक्षिन सीमा पर हय। <verse eid="JOS 15:1" /><verse number="2" style="v" sid="JOS 15:2" />उन्को भाग की दक्षिनी सीमा मृत सागर को छोर सी सुरूवात भयी जो दक्षिन को तरफ बढ़य हय; <verse eid="JOS 15:2" /><verse number="3" style="v" sid="JOS 15:3" />अऊर अक्रबीम नाम की चढ़ायी को दक्षिन को तरफ सी निकल क सीन होतो हुयो कादेशबर्ने को दक्षिन को तरफ पहुंच गयी, फिर हेस्रोन को जवर सी अद्दार ख पहुंच क कर्का को तरफ मुड़ गयी, <verse eid="JOS 15:3" /><verse number="4" style="v" sid="JOS 15:4" />वहां सी अम्मोन होतो हुयो वा मिस्र को नाला पर निकली, अऊर वा सीमा को अन्त भूमध्यसागर भयो। यो यहूदा कुल की दक्षिनी सीमा होती।<verse eid="JOS 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 15:5" />फिर पूर्व दिशा की सीमा को किनार तक खारो तलाव हय,</para>
  <para style="p" vid="JOS 15:5">अऊर उत्तर दिशा की सीमा यरदन को किनार को जवर को तलाव की खाड़ी सी शुरू कर क्, <verse eid="JOS 15:5" /><verse number="6" style="v" sid="JOS 15:6" />बेथोग्ला ख चढ़तो हुयो बेतराबा की उत्तर को तरफ होय क रूबेन को टुरा बोहन नाम की चट्टान तक चली गयी; <verse eid="JOS 15:6" /><verse number="7" style="v" sid="JOS 15:7" />अऊर वाच सीमा आकोर नाम की घाटी सी दबीर को तरफ पहुंची, अऊर उत्तर दिशा होतो हुयो गिलगाल को तरफ मुड़ी जो घाटी को दक्षिन को तरफ को अदुम्मीम की चढ़ायी को सामने हय; वहां सी वा एनशेमेश नाम को झरना को जवर पहुंच क एनरोगेल घाटी पर निकली; <verse eid="JOS 15:7" /><verse number="8" style="v" sid="JOS 15:8" />फिर वाच सीमा बेन-हिन्नोम घाटी सी होय क यबूस जो यरूशलेम कहलावय हय अऊर दक्षिन को तरफ सी चढ़ती हुयी वा पहाड़ी की ऊचायी पर पहुंची, जो पश्चिम को तरफ हिन्नोम की घाटी को सामने अऊर रपाईम की घाटी को उत्तर वालो आखरी छोर पर हय; <verse eid="JOS 15:8" /><verse number="9" style="v" sid="JOS 15:9" />फिर वाच सीमा ऊ पहाड़ी की ऊचायी सी नेप्तोह नाम को झरना पर पहुंची, अऊर एप्रोन पहाड़ी को नगरों पर निकली; फिर वहां सी बाला ख जो किर्यत्यारीम भी कहलावय हय पहुंची; <verse eid="JOS 15:9" /><verse number="10" style="v" sid="JOS 15:10" />फिर सीमा बाला सी पश्चिम को तरफ मुड़ क सेईर पहाड़ी तक पहुंची अऊर यारीम पहाड़ी जो कसालोन भी कहलावय हय ओको उत्तर दिशा को तरफ सी होय क बेतशेमेश पर उतर गयी, अऊर वहां सी तिम्ना पर निकली; <verse eid="JOS 15:10" /><verse number="11" style="v" sid="JOS 15:11" />वहां सी वा सीमा एक्रोन को उत्तर दिशा को जवर सी होतो हुयो शिक्करोन गयी, अऊर बाला पहाड़ी होय क यब्नेल पर गयी; अऊर वा सीमा को अन्त महासमुन्दर पर भयो।<verse eid="JOS 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 15:12" />अऊर पश्चिम की सीमा महासमुन्दर को किनार ठहरी। यहूदा ख जो हिस्सा उन्को कुलों को अनुसार मिल्यो ओको चारयी तरफ की सीमा याच भयी।<verse eid="JOS 15:12" /></para>
  <para style="s">कालेब की हेब्रोन अऊर दबीर पर जीत</para>
  <para style="r">(<ref loc="JDG 1:11-15">न्यायियों 1:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 15:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:13 </char>
      <char style="xt" closed="false">
        <ref loc="JDG 1:20">न्यायियों १:२०</ref>
      </char>
    </note>अऊर यपुन्ने को टुरा कालेब ख यहोशू न परमेश्वर की आज्ञा को अनुसार यहूदियों को बीच म हिस्सा दियो, मतलब किर्यतर्बा जो हेब्रोन भी कहलावय हय ऊ अर्बा अनाक को बाप होतो। <verse eid="JOS 15:13" /><verse number="14" style="v" sid="JOS 15:14" />अऊर कालेब न वहां सी शेशै, अहीमन, अऊर तल्मै नाम को, अनाक को तीनयी टुरावों ख निकाल दियो। <verse eid="JOS 15:14" /><verse number="15" style="v" sid="JOS 15:15" />फिर कालेब न दबीर को निवासियों पर हमला करयो; दबीर को पुरानो नाम किर्यत्सेपेर होतो। <verse eid="JOS 15:15" /><verse number="16" style="v" sid="JOS 15:16" />अऊर कालेब न कह्यो, “जो किर्यत्सेपेर ख हराय क ओख अपनो अधिन कर लेयेंन ओको सी मय अपनी टुरी अकसा को बिहाव कर देऊं।” <verse eid="JOS 15:16" /><verse number="17" style="v" sid="JOS 15:17" />तब कालेब को भाऊ कनजी को टुरा ओत्नीएल न ऊ नगर पर अधिकार कर लियो; अऊर ओन ओको सी अपनी टुरी अकसा को बिहाव कर दियो। <verse eid="JOS 15:17" /><verse number="18" style="v" sid="JOS 15:18" />जब वा ओत्नीएल को जवर आयी, तब ओन अकसा ख बाप सी कुछ जमीन मांगन ख कह्यो, वा कालेब को जवर गयी जब वा गधा पर सी खल्लो उतरी, तब कालेब न ओको सी पुच्छ्यो, “तय का चाहवय हय?” <verse eid="JOS 15:18" /><verse number="19" style="v" sid="JOS 15:19" />वा बोली, “मोख आशीर्वाद दे; तय न मोख दक्षिन देश म की कुछ जमीन त दे दी हय, मोख पानी को सोता भी दे।” तब ओन ऊपर अऊर खल्लो को सोता दोयी ओख दे दियो।<verse eid="JOS 15:19" /></para>
  <para style="s">यहूदा कुल को नगर</para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 15:20" />यहूदियों को कुल को हिस्सा त उन्को कुलों को अनुसार योच ठहरयो। <verse eid="JOS 15:20" /><verse number="21" style="v" sid="JOS 15:21" />यहूदा कुल को नगर दक्षिन देश म एदोम की सीमा को तरफ हि आय, कबसेल, एदेर, यागूर, <verse eid="JOS 15:21" /><verse number="22" style="v" sid="JOS 15:22" />कीना, दीमोना, अदादा, <verse eid="JOS 15:22" /><verse number="23" style="v" sid="JOS 15:23" />केदेश, हासोर, यित्नान, <verse eid="JOS 15:23" /><verse number="24" style="v" sid="JOS 15:24" />जीप, तेलेम, बालोत, <verse eid="JOS 15:24" /><verse number="25" style="v" sid="JOS 15:25" />हासोर्हदत्ता, करिय्योथेस्रोन, जो हासोर भी कहलावय हय, <verse eid="JOS 15:25" /><verse number="26" style="v" sid="JOS 15:26" />अऊर अमाम, शमा, मोलादा, <verse eid="JOS 15:26" /><verse number="27" style="v" sid="JOS 15:27" />हसर्गद्दा, हेशमोन, बेत्पालेत, <verse eid="JOS 15:27" /><verse number="28" style="v" sid="JOS 15:28" />हसर्शूआल, बेर्शेबा, बिज्योत्या, <verse eid="JOS 15:28" /><verse number="29" style="v" sid="JOS 15:29" />बाला, इय्यीम, एसेम, <verse eid="JOS 15:29" /><verse number="30" style="v" sid="JOS 15:30" />एलतोलद, कसील, होर्मा, <verse eid="JOS 15:30" /><verse number="31" style="v" sid="JOS 15:31" />सिकलग, मदमन्ना, सनसन्ना, <verse eid="JOS 15:31" /><verse number="32" style="v" sid="JOS 15:32" />लबाओत, शिल्हीम, ऐन, अऊर रिम्मोन; गावों सहित सब नगरों की संख्या उनतीस हय।<verse eid="JOS 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 15:33" />खल्लो को देश म स्थित नगर : एशताओल, सोरा, अशना, <verse eid="JOS 15:33" /><verse number="34" style="v" sid="JOS 15:34" />जानोह, एनगन्नीम, तप्पूह, एनाम, <verse eid="JOS 15:34" /><verse number="35" style="v" sid="JOS 15:35" />यर्मूत, अदुल्लाम, सोको, अजेका, <verse eid="JOS 15:35" /><verse number="36" style="v" sid="JOS 15:36" />शारैम, अदीतैम, गदेरा, अऊर गदेरोतैम; हि सब गांव सहित सब नगरों की संख्या चौदा हंय।<verse eid="JOS 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JOS 15:37" />फिर सनान, हदाशा, मिगदलगाद, <verse eid="JOS 15:37" /><verse number="38" style="v" sid="JOS 15:38" />दिलान, मिस्पे, योक्तेल, <verse eid="JOS 15:38" /><verse number="39" style="v" sid="JOS 15:39" />लाकीश, बोस्कत, एग्लोन, <verse eid="JOS 15:39" /><verse number="40" style="v" sid="JOS 15:40" />कब्बोन, लहमास, कितलीश, <verse eid="JOS 15:40" /><verse number="41" style="v" sid="JOS 15:41" />गदेरोत, बेतदागोन, नामा, अऊर मक्केदा; हि गांव सहित सब नगरों की संख्या सोला हंय।<verse eid="JOS 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JOS 15:42" />फिर लिब्ना, ऐतेर, आशान, <verse eid="JOS 15:42" /><verse number="43" style="v" sid="JOS 15:43" />यिप्तह, अशाना, नसीब, <verse eid="JOS 15:43" /><verse number="44" style="v" sid="JOS 15:44" />कीला, अकजीब, अऊर मारेशा; हि गांव सहित सब नगरों की संख्या नव हंय।<verse eid="JOS 15:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JOS 15:45" />फिर नगरों अऊर गांवो सहित एक्रोन, <verse eid="JOS 15:45" /><verse number="46" style="v" sid="JOS 15:46" />अऊर एक्रोन सी ले क महासमुन्दर तक, अपनो अपनो गांवो समेत जितनो नगर अशदोद को तरफ हंय।<verse eid="JOS 15:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JOS 15:47" />फिर अपनो अपनो नगरों अऊर गांवो समेत अशदोद, अऊर अज्जा, बल्की मिस्र को नाला तक अऊर महासमुन्दर को किनार तक जितनो नगर हंय।<verse eid="JOS 15:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JOS 15:48" />पहाड़ी देश म हि हय : शामीर, यत्तीर, सोको, <verse eid="JOS 15:48" /><verse number="49" style="v" sid="JOS 15:49" />दन्ना, किर्यत्सन्ना जो दबीर भी कहलावय हय, <verse eid="JOS 15:49" /><verse number="50" style="v" sid="JOS 15:50" />अनाब, एशतमो, आनीम, <verse eid="JOS 15:50" /><verse number="51" style="v" sid="JOS 15:51" />गोशेन, होलोन, अऊर गीलो; हि गांवो सहित सब नगरों की संख्या ग्यारा हंय।<verse eid="JOS 15:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JOS 15:52" />फिर अराब, दूमा, एशान, <verse eid="JOS 15:52" /><verse number="53" style="v" sid="JOS 15:53" />यानीम, बेत्तप्पूह, अपेका, <verse eid="JOS 15:53" /><verse number="54" style="v" sid="JOS 15:54" />हुमता, किर्यतर्बा जो हेब्रोन भी कहलावय हय, अऊर सीओर गांवो सहित सब नगरों की संख्या नव हंय।<verse eid="JOS 15:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JOS 15:55" />फिर माओन, कर्मेल, जीप, यूता, <verse eid="JOS 15:55" /><verse number="56" style="v" sid="JOS 15:56" />यिज्रेल, योकदाम, जानोह, <verse eid="JOS 15:56" /><verse number="57" style="v" sid="JOS 15:57" />कैन, गिबा, अऊर तिम्ना; गांवो समेत सब नगरों की संख्या दस हंय।<verse eid="JOS 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JOS 15:58" />फिर हलहूल, बेतसूर, गदोर, <verse eid="JOS 15:58" /><verse number="59" style="v" sid="JOS 15:59" />मरात, बेतनोत, अऊर एलतकोन; हि गांवो समेत सब नगरों की संख्या छय हंय।<verse eid="JOS 15:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="JOS 15:60" />फिर किर्यतबाल जो किर्यत्यारीम भी कहलावय हय, अऊर रब्बा; हि गांव समेत दोय नगर हंय।<verse eid="JOS 15:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JOS 15:61" />जंगल म हि नगर हंय : बेतराबा, मिद्दीन, सकाका; <verse eid="JOS 15:61" /><verse number="62" style="v" sid="JOS 15:62" />निबशान, लवन नगर, अऊर एनगदी, हि गांवो समेत छय नगर हंय।<verse eid="JOS 15:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="JOS 15:63" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:63 </char>
      <char style="xt" closed="false">
        <ref loc="JDG 1:21">न्यायियों १:२१</ref>; <ref loc="2SA 5:6">२ शमूएल ५:६</ref>; <ref loc="1CH 11:4">१ इतिहास ११:४</ref></char>
    </note>यरूशलेम को निवासी यबूसियों ख नहीं निकाल सक्यो; येकोलायी अज भी यबूसी यहूदियों को संग यरूशलेम म रह्य हंय।<verse eid="JOS 15:63" /></para>
  <chapter eid="JOS 15" />
  <chapter number="16" style="c" sid="JOS 16" />
  <para style="s">एप्रैम अऊर मनश्शे गोत्रों ख दियो गयो हिस्सा</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 16:1" />फिर यूसुफ को वंशजों ख यरीहो नगर को जवर, यरदन नदी सी यरीहो को झरना को पूर्व म जंगल तक की सीमा दी गयी, ओकी सीमा यरीहो सी शुरू होय क ऊ पहाड़ी देश सी होतो हुयो, बेतेल नगर ख पहुंची; <verse eid="JOS 16:1" /><verse number="2" style="v" sid="JOS 16:2" />वहां सी वा लूज सीमा तक पहुंची, अऊर अर्की जाति की सीमा सी होतो हुयो अतारोत सीमा पर जाय निकली; <verse eid="JOS 16:2" /><verse number="3" style="v" sid="JOS 16:3" />अऊर पश्चिम को तरफ यपलेतियों जाति की सीमा सी उतर क फिर खल्लो की बेथोरोन की सीमा सी होय क गेजेर नाम की जागा पर पहुंची, अऊर महासमुन्दर पर खतम भयी।<verse eid="JOS 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 16:4" />तब मनश्शे अऊर एप्रैम नाम को यूसुफ को दोयी टुरावों की सन्तान न अपनो अपनो हिस्सा लियो।<verse eid="JOS 16:4" /></para>
  <para style="s">एप्रैम को हिस्सा</para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 16:5" />एप्रैमियों की सीमा उन्को कुलों को अनुसार या होती; उन्को हिस्सा की सीमा पूर्व सी शुरू होय क अत्रोतद्दार सी होतो हुयो ऊपर वालो बेथोरोन तक पहुंची; <verse eid="JOS 16:5" /><verse number="6" style="v" sid="JOS 16:6" />अऊर उत्तरी सीमा पश्चिम को तरफ को मिकमतात सी शुरू होय क पूर्व को तरफ मुड़ क तानतशीलो ख पहुंची, अऊर ओको जवर सी होतो हुयो यानोह तक गयी; <verse eid="JOS 16:6" /><verse number="7" style="v" sid="JOS 16:7" />फिर यानोह सी वा अतारोत अऊर नारा ख उतरती हुयी यरीहो को जवर सी होय क यरदन नदी पर खतम भयी। <verse eid="JOS 16:7" /><verse number="8" style="v" sid="JOS 16:8" />फिर वाच सीमा तप्पूह सी निकल क, अऊर पश्चिम को तरफ जाय क, काना को नाला सी होय क महासमुन्दर पर निकली। एप्रैमियों को कुल को हिस्सा उन्को कुलों को अनुसार योच ठहरयो। <verse eid="JOS 16:8" /><verse number="9" style="v" sid="JOS 16:9" />अऊर मनश्शे कुल को हिस्सा को बीच म भी कुछ नगर अपनो अपनो गांवो समेत एप्रैमियों को लायी अलग करयो गयो। <verse eid="JOS 16:9" /><verse number="10" style="v" sid="JOS 16:10" /><note caller="+" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="JDG 1:29">न्यायियों १:२९</ref></char></note>पर जो कनानी गेजेर नगर म बस्यो होतो उन्ख एप्रैमियों न वहां सी नहीं निकाल्यो; येकोलायी हि कनानी जाति उन्को बीच म अज भी बस्यो हंय, अऊर बेकार म दास को जसो करय हंय।<verse eid="JOS 16:10" /></para>
  <chapter eid="JOS 16" />
  <chapter number="17" style="c" sid="JOS 17" />
  <para style="s">पश्चिम म मनश्शे को हिस्सा</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 17:1" />फिर यूसुफ को बड़ो टुरा मनश्शे को कुल को हिस्सा चिट्ठी डाल क दियो गयो। मनश्शे को बड़ो टुरा, माकीर गिलाद को बाप योद्धा होतो, यो वजह ओको वंश ख गिलाद अऊर बाशान प्रदेश दियो गयो। <verse eid="JOS 17:1" /><verse number="2" style="v" sid="JOS 17:2" />येकोलायी यो हिस्सा मनश्शे को दूसरो टुरावों लायी उन्को कुल अनुसार दियो गयो, अबीएजेर, हेलेक, अस्रीएल, शेकेम, हेपेर, अऊर शमीदा; जो अपनो अपनो कुलों को अनुसार यूसुफ को टुरा मनश्शे को परिवार को मुखिया होतो, उन्को अलग अलग वंशों लायी ठहरयो। <verse eid="JOS 17:2" /><verse number="3" style="v" sid="JOS 17:3" />पर हेपेर जो गिलाद को टुरा, माकीर को नाती, अऊर मनश्शे को पन्ती होतो, ओको टुरा सलोफाद ख टुरा नहीं बल्की टुरीच भयी; अऊर उन्को नाम महला, नोआ, होग्ला, मिल्का, अऊर तिर्सा हंय। <verse eid="JOS 17:3" /><verse number="4" style="v" sid="JOS 17:4" /><note caller="+" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="NUM 27:1-7">गिनती २७:१-७</ref></char></note>तब हि टुरी एलीआजार याजक, नून को टुरा यहोशू, अऊर मुखियावों को जवर जाय क कहन लगी, “परमेश्वर न मूसा ख आज्ञा दी होती, कि ऊ हम्ख हमरो भाऊवों को बीच म हिस्सा दे।” त यहोशू न परमेश्वर की आज्ञा को अनुसार उन्ख उन्को काकावों को अधिकार को बीच म हिस्सा दियो। <verse eid="JOS 17:4" /><verse number="5" style="v" sid="JOS 17:5" />तब मनश्शे ख, यरदन नदी को ओन पार गिलाद अऊर बाशान प्रदेश ख छोड़ क, दस हिस्सा अऊर मिल्यो : <verse eid="JOS 17:5" /><verse number="6" style="v" sid="JOS 17:6" />कहालीकि मनश्शे को टुरावों को बीच म मनश्शे की टुरियों ख भी हिस्सा दियो गयो। अऊर गिलाद प्रदेश मनश्शे को बच्यो परिवार ख दियो गयो।<verse eid="JOS 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 17:7" />मनश्शे की सीमा आशेर सी ले क मिकमतात तक होती, जो शकेम को सामने हय; फिर वा सीमा दक्षिन को तरफ बढ़ क एनतप्पूह को निवासियों तक चली गयी। <verse eid="JOS 17:7" /><verse number="8" style="v" sid="JOS 17:8" />तप्पूह की जमीन त मनश्शे ख मिली, पर तप्पूह नगर जो मनश्शे की सीमा पर बस्यो हय ऊ एप्रैमियों को ठहरयो। <verse eid="JOS 17:8" /><verse number="9" style="v" sid="JOS 17:9" />फिर वहां सी वा सीमा काना को नाला तक उतर क ओको दक्षिन को तरफ तक पहुंच गयी; हि एप्रैम को नगर मनश्शे को नगरों को बीच म होतो; अऊर मनश्शे की सीमा ऊ नाला को उत्तर को तरफ सी जाय क महासमुन्दर पर निकली; <verse eid="JOS 17:9" /><verse number="10" style="v" sid="JOS 17:10" />दक्षिन को तरफ को देश एप्रैम ख अऊर उत्तर को तरफ को देश मनश्शे ख मिल्यो, अऊर ओकी सीमा महासमुन्दर होती; अऊर उत्तर म आशेर ख अऊर पूर्व म इस्साकार ख जाय क मिली। <verse eid="JOS 17:10" /><verse number="11" style="v" sid="JOS 17:11" />अऊर मनश्शे ख, इस्साकार अऊर आशेर अपनो नगर समेत बेतशान, यिबलाम, अऊर अपनो नगर समेत दोर को निवासी, अऊर अपनो नगर समेत एनदोर को निवासी, अऊर अपनो नगर समेत तानाक को निवासी, अऊर अपनो नगर समेत मगिद्दो को निवासी, हि तीनयी जो ऊंचो जागा पर बस्यो हंय मिल्यो। <verse eid="JOS 17:11" /><verse number="12" style="v" sid="JOS 17:12" /><note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="JDG 1:27-28">न्यायियों १:२७-२८</ref></char></note>पर मनश्शे को वंशज ऊ नगर को निवासियों ख नहीं निकाल सक्यो; येकोलायी हि कनानी ऊ देश म जबरदस्ती बस्योच रह्यो। <verse eid="JOS 17:12" /><verse number="13" style="v" sid="JOS 17:13" />सब इस्राएली शक्तिशाली भय गयो, तब भी उन्न कनानियों ख नहीं निकाल्यो, पर हि उन्को सी काम करावन लग्यो।<verse eid="JOS 17:13" /></para>
  <para style="s">एप्रैम अऊर मनश्शे कुल को द्वारा जादा जमीन की मांग</para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 17:14" />यूसुफ की सन्तान यहोशू सी कहन लगी, “हम त गिनती म बहुत हंय, कहालीकि अब तक परमेश्वर हम्ख आशीषच देतो आयो हय, फिर तय न हमरो हिस्सा लायी चिट्ठी डाल क कहाली एकच हिस्सा दियो हय?”<verse eid="JOS 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 17:15" />यहोशू न उन सी कह्यो, “यदि तुम गिनती म बहुत हय, अऊर एप्रैम को पहाड़ी देश तुम्हरो लायी छोटो होना, जो परिज्जियों अऊर रपाइयों को देश जो जंगल हय ओको म जाय क झाड़ो ख काट डालो।”<verse eid="JOS 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 17:16" />यूसुफ की सन्तान न कह्यो, “ऊ पहाड़ी देश हमरो लायी छोटो हय; अऊर बेतशान अऊर ओको नगरों म रहन वालो अऊर यिज्रेल की घाटी म रहन वालो, जितनो कनानी लोग खल्लो को देश म रह्य हंय, उन सब को जवर लोहा को रथ हंय।”<verse eid="JOS 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 17:17" />फिर यहोशू न एप्रैम अऊर मनश्शे, मतलब यूसुफ पूरो घराना सी कह्यो, “हां, तुम लोग त गिनती म बहुत हय, अऊर तुम्हरी शक्ति भी बड़ी हय, येकोलायी तुम्ख केवल एकच हिस्सा नहीं मिलेंन; <verse eid="JOS 17:17" /><verse number="18" style="v" sid="JOS 17:18" />पहाड़ी देश भी तुम्हरो होय जायेंन; कहालीकि ऊ जंगल त हय, पर ओको झाड़ काट डालो, तब ओको आजु-बाजू को देश भी तुम्हरो होय जायेंन; कहालीकि चाहे कनानी शक्तिशाली होना, अऊर उन्को जवर लोहा को रथ भी होना, तब भी तुम उन्ख वहां सी निकाल सको।”<verse eid="JOS 17:18" /></para>
  <chapter eid="JOS 17" />
  <chapter number="18" style="c" sid="JOS 18" />
  <para style="s">बची हुयी जमीन को बंटवारा</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 18:1" />फिर इस्राएलियों की पूरी मण्डली न शीलो नगर म जमा होय क वहां मिलाप वालो तम्बू<note caller="+" style="f"><char style="fr" closed="false">18:1 </char><char style="ft" closed="false">परमेश्वर को मौजूदी को तम्बू</char></note> ख खड़ो करयो; कहालीकि उन्को देश अधिकार म आय गयो होतो। <verse eid="JOS 18:1" /><verse number="2" style="v" sid="JOS 18:2" />अऊर इस्राएल को सात कुल अब भी असो होतो, जिन्ख उन्को हिस्सा नहीं मिल्यो होतो। <verse eid="JOS 18:2" /><verse number="3" style="v" sid="JOS 18:3" />तब यहोशू न इस्राएलियों सी कह्यो, “जो देश तुम्हरो पूर्वजों को परमेश्वर यहोवा न तुम्ख दियो हय, ओख अपनो अधिकार म करन म कब तक ढिलायी करतो रहो? <verse eid="JOS 18:3" /><verse number="4" style="v" sid="JOS 18:4" />अब हर एक कुल म सी तीन आदमी चुन लेवो, मय उन्ख ऊ देश म भेजूं कि हि वहां जाय क ओकी जांच करे, अऊर जो जमीन हिस्सा उन्ख अपनो कुल को लायी होना, ओको बारे म लिख ले अऊर मोरो जवर वापस लौट आये। <verse eid="JOS 18:4" /><verse number="5" style="v" sid="JOS 18:5" />अऊर हि देश ख सात हिस्सा म बाट ले, यहूदा कुल दक्षिन को तरफ अपनो हिस्सा म, अऊर यूसुफ को घराना को लोग उत्तर को तरफ अपनो हिस्सा म रहे। <verse eid="JOS 18:5" /><verse number="6" style="v" sid="JOS 18:6" />अऊर तुम देश की पूरी जानकारी मोरो जवर लावो; अऊर मय यहां तुम्हरो लायी अपनो परमेश्वर यहोवा को सामने चिट्ठी डालूं। <verse eid="JOS 18:6" /><verse number="7" style="v" sid="JOS 18:7" />अऊर लेवियों को तुम्हरो बीच म कोयी हिस्सा नहीं मिलेंन, कहालीकि परमेश्वर को दियो हुयो याजकपदच उन्को हिस्सा हय; अऊर गाद, रूबेन, अऊर मनश्शे को अरधो कुल को लोग यरदन को पूर्व दिशा को तरफ परमेश्वर को दास मूसा को दियो हुयो अपनो हिस्सा पा चुक्यो हय।”<verse eid="JOS 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 18:8" />तब हि चुन्यो गयो आदमी उठ क जान लायी तैयार भयो; अऊर जो ऊ देश को हाल लिखन जाय रह्यो होतो उन्ख यहोशू न या आज्ञा दी, “जाय क देश म घूमो फिरो, अऊर ओको हाल लिख क मोरो जवर लौट आवो; अऊर मय यहां शीलो म परमेश्वर को सामने तुम्हरो लायी चिट्ठी डालूं।” <verse eid="JOS 18:8" /><verse number="9" style="v" sid="JOS 18:9" />तब हि आदमी चल दियो, अऊर ऊ पूरो देश म घूम्यो, अऊर ओको नगर को सात हिस्सा कर क् उन्को हाल किताब म लिख क शीलो की छावनी म यहोशू को जवर आयो। <verse eid="JOS 18:9" /><verse number="10" style="v" sid="JOS 18:10" />तब यहोशू न शीलो म परमेश्वर को सामने उन्को लायी चिट्ठी डाली; अऊर वहां यहोशू न इस्राएलियों ख उन्को हिस्सा को अनुसार देश बाट दियो।<verse eid="JOS 18:10" /></para>
  <para style="s">बिन्यामीन को कुल ख दियो गयो हिस्सा</para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 18:11" />बिन्यामीन को कुल की चिट्ठी उन्को परिवार को अनुसार निकली, अऊर उन्को हिस्सा यहूदा कुल अऊर यूसुफ को कुलों को बीच म होतो। <verse eid="JOS 18:11" /><verse number="12" style="v" sid="JOS 18:12" />अऊर उन्की उत्तर दिशा की सीमा यरदन नदी सी शुरू भयी, यरीहो की उत्तर को तरफ सी चढ़ती हुयी पश्चिम को तरफ पहाड़ी देश सी होय क बेतावेन को जंगल म निकली; <verse eid="JOS 18:12" /><verse number="13" style="v" sid="JOS 18:13" />वहां सी सीमा लूज ख पहुंची जो बेतेल भी कहलावय हय, अऊर लूज को दक्षिन दिशा सी होतो हुयो खल्लो को बेथोरोन को दक्षिन तरफ की पहाड़ी को जवर अत्रोतद्दार पर उतर गयी। <verse eid="JOS 18:13" /><verse number="14" style="v" sid="JOS 18:14" />फिर पश्चिमी सीमा मुड़ क बेथोरोन को सामने अऊर ओको दक्षिन को तरफ को पहाड़ी सी होतो हुयो किर्यतबाल नाम को यहूदा को एक नगर पर निकली जो किर्यत्यारीम भी कहलावय हय; पश्चिम की सीमा याच होती। <verse eid="JOS 18:14" /><verse number="15" style="v" sid="JOS 18:15" />फिर दक्षिन को तरफ की सीमा पश्चिम सी शुरू होय क किर्यत्यारीम को छोर सी निकल क नेप्तोह को झरना पर पहुंची; <verse eid="JOS 18:15" /><verse number="16" style="v" sid="JOS 18:16" />अऊर वा पहाड़ी को छोर पर उतरी, जो हिन्नोम को टुरा की घाटी को सामने अऊर रपाईम नाम की घाटी को उत्तर दिशा को तरफ हय; वहां सी सीमा हिन्नोम की घाटी म, मतलब यबूस को दक्षिन को तरफ सी होय क एनरोगेल झरना पर उतरी; <verse eid="JOS 18:16" /><verse number="17" style="v" sid="JOS 18:17" />वहां सी वा सीमा उत्तर को तरफ मुड़ क एनशेमेश ख निकल क गलीलोत को तरफ गयी, जो अदुम्मीम की चढ़ायी को सामने हय, फिर वहां सी या रूबेन को टुरा बोहन को गोटा तक उतर गयी; <verse eid="JOS 18:17" /><verse number="18" style="v" sid="JOS 18:18" />वहां सी वा सीमा उत्तर को तरफ जाय क अराबा को सामने की पहाड़ी को तरफ सी होतो हुयो यरदन नदी की घाटी म उतरी; <verse eid="JOS 18:18" /><verse number="19" style="v" sid="JOS 18:19" />वहां सी वा सीमा बेथोग्ला को उत्तर को तरफ सी जाय क खारो समुन्दर को उत्तर तरफ को घाटी म यरदन को मुख पर निकली; या दक्षिन की सीमा होती। <verse eid="JOS 18:19" /><verse number="20" style="v" sid="JOS 18:20" />अऊर पूर्व दिशा को तरफ की सीमा यरदन नदी होती। बिन्यामीनियों को हिस्सा, चारयी तरफ की सीमावों सहित, उन्को कुलों को अनुसार, याच होती।<verse eid="JOS 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 18:21" />बिन्यामीन कुल को परिवारों ख हि नगर मिल्यो, यरीहो, बेथोग्ला, एमेक्कसीस, <verse eid="JOS 18:21" /><verse number="22" style="v" sid="JOS 18:22" />बेतराबा, समारैम, बेतेल, <verse eid="JOS 18:22" /><verse number="23" style="v" sid="JOS 18:23" />अव्वीम, पारा, ओप्रा, <verse eid="JOS 18:23" /><verse number="24" style="v" sid="JOS 18:24" />कपरम्मोनी, ओफनी अऊर गेबा; हि बारा नगर अऊर इन्को गांव मिल्यो। <verse eid="JOS 18:24" /><verse number="25" style="v" sid="JOS 18:25" />फिर गिबोन, रामा, बेरोत, <verse eid="JOS 18:25" /><verse number="26" style="v" sid="JOS 18:26" />मिस्पे, कपीरा, मोसा, <verse eid="JOS 18:26" /><verse number="27" style="v" sid="JOS 18:27" />रेकेम, यिर्पेल, तरला, <verse eid="JOS 18:27" /><verse number="28" style="v" sid="JOS 18:28" />सेला, एलेप, यबूस जो यरूशलेम भी कहलावय हय, गिबत अऊर किर्यत; हि चौदा नगर अऊर इन्को गांव मिल्यो। बिन्यामीनियों को हिस्सा उन्को कुलों को अनुसार योच होतो।<verse eid="JOS 18:28" /></para>
  <chapter eid="JOS 18" />
  <chapter number="19" style="c" sid="JOS 19" />
  <para style="s">शिमोन को वंश ख दियो गयो हिस्सा</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 19:1" />दूसरी चिट्ठी शिमोन को नाम पर, मतलब शिमोनियों को कुलों को अनुसार उन्को कुल को नाम पर निकली; अऊर उन्को हिस्सा यहूदा को अधिकार को बीच म होतो। <verse eid="JOS 19:1" /><verse number="2" style="v" sid="JOS 19:2" /><note caller="+" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="1CH 4:28-33">१ इतिहास ४:२८-३३</ref></char></note>उन्को हिस्सा म हि नगर हय, बेर्शेबा, शेबा, मोलादा, <verse eid="JOS 19:2" /><verse number="3" style="v" sid="JOS 19:3" />हसर्शआल, बाला, एसेम, <verse eid="JOS 19:3" /><verse number="4" style="v" sid="JOS 19:4" />एलतोलद, बतूल होर्मा, <verse eid="JOS 19:4" /><verse number="5" style="v" sid="JOS 19:5" />सिकलग, बेत्मर्काबोत, हसर्शूसा, <verse eid="JOS 19:5" /><verse number="6" style="v" sid="JOS 19:6" />बेतलबाओत, शारूहेन; हि तेरा नगर अऊर इन्को गांव उन्ख मिल्यो।<verse eid="JOS 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 19:7" />फिर ऐन, रिम्मोन, ऐतेर, अऊर आशान, हि चार नगर गांव समेत; <verse eid="JOS 19:7" /><verse number="8" style="v" sid="JOS 19:8" /><note caller="+" style="x"><char style="xo" closed="false">19:8 </char><char style="xt" closed="false"><ref loc="1CH 4:28-33">१ इतिहास ४:२८-३३</ref></char></note>अऊर बालत्बेर जो दक्षिन देश को रामा नगर भी कहलावय हय, वहां तक इन नगरों को चारयी तरफ को सब गांव भी उन्ख मिल्यो। शिमोनियों को कुल को हिस्सा उन्को कुलों को अनुसार यहांच ठहरयो। <verse eid="JOS 19:8" /><verse number="9" style="v" sid="JOS 19:9" />शिमोनियों को हिस्सा त यहूदा को हिस्सा म सी दियो गयो; कहालीकि यहूदा कुल को हिस्सा उन्को लायी बहुत होतो, यो वजह शिमोनियों को हिस्सा यहूदा को हिस्सा को बीच म मिल्यो।<verse eid="JOS 19:9" /></para>
  <para style="s">जबूलून को वंश ख दियो गयो हिस्सा</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 19:10" />तीसरी चिट्ठी जबूलून को कुलों को अनुसार उन्को परिवारों को नाम पर निकली। अऊर उन्को हिस्सा की सीमा सारीद तक पहुंची; <verse eid="JOS 19:10" /><verse number="11" style="v" sid="JOS 19:11" />अऊर उन्की सीमा पश्चिम म मरला सी होतो हुयो दब्बेशेत ख पहुंची, अऊर योकनाम को सामने को नाला तक पहुंच गयी; <verse eid="JOS 19:11" /><verse number="12" style="v" sid="JOS 19:12" />फिर सारीद सी सीमा पूर्व को तरफ मुड़ क किसलोत्ताबोर की सीमा तक पहुंची, अऊर वहां सी बढ़त बढ़त दाबरत अऊर यापी तक चली गयी होती; <verse eid="JOS 19:12" /><verse number="13" style="v" sid="JOS 19:13" />वहां सी सीमा पूर्व को तरफ आगु बढ़ क गथेपेर अऊर इत्कासीन ख गयी, अऊर वा रिम्मोन को तरफ बढ़ गयी जो नेआ दिशा तक फैल्यो हुयो हय; <verse eid="JOS 19:13" /><verse number="14" style="v" sid="JOS 19:14" />वहां सी वा सीमा ओको उत्तर को तरफ सी मुड़ क हन्नातोन पर पहुंची; अऊर यिप्तहेल की घाटी म जाय क खतम भयी; <verse eid="JOS 19:14" /><verse number="15" style="v" sid="JOS 19:15" />कत्तात, नहलाल, शिम्रोन, यिदला, अऊर बैतलहम; हि गांवो सहित नगरों की संख्या बारा होती। <verse eid="JOS 19:15" /><verse number="16" style="v" sid="JOS 19:16" />जबूलून वंश को लोगों ख उन्को परिवारों को अनुसार अधिकार मिल्यो; अऊर ओको म अपनो अपनो गांवो समेत योच नगर आय।<verse eid="JOS 19:16" /></para>
  <para style="s">इस्साकार को वंश ख दियो गयो हिस्सा</para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 19:17" />चौथी चिट्ठी इस्साकारियों को कुलों को अनुसार उन्को परिवारों को नाम पर निकली। <verse eid="JOS 19:17" /><verse number="18" style="v" sid="JOS 19:18" />अऊर उन्की सीमा यिज्रेल, कसुल्लोत, शूनेम, <verse eid="JOS 19:18" /><verse number="19" style="v" sid="JOS 19:19" />हपारैम, शीओन, अनाहरत, <verse eid="JOS 19:19" /><verse number="20" style="v" sid="JOS 19:20" />रब्बीत, किश्योन, एबेस, <verse eid="JOS 19:20" /><verse number="21" style="v" sid="JOS 19:21" />रेमेत, एनगन्नीम, एनहद्दा, अऊर बेत्पस्सेस तक पहुंची। <verse eid="JOS 19:21" /><verse number="22" style="v" sid="JOS 19:22" />फिर वा सीमा ताबोर, शहसूमा अऊर बेतशेमेश तक पहुंची, अऊर उन्की सीमा यरदन नदी पर खतम भयी; यो तरह गांवो समेत सोला नगर होतो। <verse eid="JOS 19:22" /><verse number="23" style="v" sid="JOS 19:23" />कुलों को अनुसार इस्साकारियों वंश को हिस्सा नगरों अऊर गांवो समेत दियो गयो।<verse eid="JOS 19:23" /></para>
  <para style="s">आशेर को वंश ख दियो गयो हिस्सा</para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 19:24" />पाचवी चिट्ठी आशेर को वंश को परिवारों को नाम पर निकली। <verse eid="JOS 19:24" /><verse number="25" style="v" sid="JOS 19:25" />उन्की सीमा म हेल्कत, हली, बेतेन, अक्षाप, <verse eid="JOS 19:25" /><verse number="26" style="v" sid="JOS 19:26" />अल्लाम्मेलेक, अमाद, अऊर मिशाल होतो; अऊर ऊ पश्चिम को तरफ कर्मेल तक अऊर शीहोर्लिब्नात तक पहुंची; <verse eid="JOS 19:26" /><verse number="27" style="v" sid="JOS 19:27" />फिर वा सीमा पूर्व दिशा को तरफ मुड़ क बेतदागोन ख गयी, अऊर जबूलून को हिस्सा तक, अऊर यिप्तहेल की घाटी सी उत्तर दिशा को तरफ सी होय क बेतेमेक अऊर नीएल तक पहुंची; अऊर उत्तर को तरफ जाय क काबूल पर निकली, <verse eid="JOS 19:27" /><verse number="28" style="v" sid="JOS 19:28" />अऊर वा एब्रोन, रहोब, हम्मोन, अऊर काना सी होय क बड़ो सीदोन ख गयी; <verse eid="JOS 19:28" /><verse number="29" style="v" sid="JOS 19:29" />वहां सी वा सीमा मुड़ क रामा सी होतो हुयो सोर नाम को गढ़ वालो नगर तक चली गयी; फिर सीमा होसा को तरफ मुड़ क अऊर अकजीब को जवर को देश सी होय क समुन्दर पर खतम भयी, <verse eid="JOS 19:29" /><verse number="30" style="v" sid="JOS 19:30" />उम्मा, अपेक, अऊर रहोब भी होतो; यो तरह बावीस नगर अपनो गांवो समेत ओख मिल्यो। <verse eid="JOS 19:30" /><verse number="31" style="v" sid="JOS 19:31" />कुलों को अनुसार आशेरियों को वंश को हिस्सा नगरों अऊर गांवो समेत यहांच मिल्यो।<verse eid="JOS 19:31" /></para>
  <para style="s">नप्ताली को वंश ख दियो गयो हिस्सा</para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 19:32" />छठवी चिट्ठी नप्ताली वंशों को अनुसार उन्को परिवारों को नाम पर निकली। <verse eid="JOS 19:32" /><verse number="33" style="v" sid="JOS 19:33" />अऊर उन्की सीमा हेलेप सी, अऊर सानन्नीम को बांझ झाड़ सी, अदामीनेकेब अऊर यब्नेल सी होय क, अऊर लक्कूम ख जाय क यरदन पर खतम भयी; <verse eid="JOS 19:33" /><verse number="34" style="v" sid="JOS 19:34" />वहां सी वा सीमा पश्चिम को तरफ मुड़ क अजनोत्ताबोर ख गयी, अऊर वहां सी हुक्कोक ख गयी, अऊर दक्षिन, अऊर जबूलून को हिस्सा तक, अऊर पश्चिम को तरफ आशेर को हिस्सा तक, अऊर पूर्व को तरफ यहूदा को हिस्सा को जवर की यरदन नदी पर निकली। <verse eid="JOS 19:34" /><verse number="35" style="v" sid="JOS 19:35" />अऊर उन्को गढ़ वालो नगर यो आय, मतलब सिद्दीम, शेर, हम्मत, रक्कत, किन्नेरेत, <verse eid="JOS 19:35" /><verse number="36" style="v" sid="JOS 19:36" />अदामा, रामा, हासोर, <verse eid="JOS 19:36" /><verse number="37" style="v" sid="JOS 19:37" />केदेश, एद्रेई, एन्हासोर, <verse eid="JOS 19:37" /><verse number="38" style="v" sid="JOS 19:38" />यिरोन, मिगदलेल, होरेम, बेतनात, अऊर बेतशेमेश; हि उन्नीस नगर गांवो समेत ओख मिल्यो। <verse eid="JOS 19:38" /><verse number="39" style="v" sid="JOS 19:39" />कुलों को अनुसार नप्तालियों को वंश को हिस्सा नगरों अऊर गांवो समेत यहांच मिल्यो।<verse eid="JOS 19:39" /></para>
  <para style="s">दान को वंश ख दियो गयो हिस्सा</para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 19:40" />सातवी चिट्ठी कुलों को अनुसार दान को वंश को नाम पर निकली। <verse eid="JOS 19:40" /><verse number="41" style="v" sid="JOS 19:41" />अऊर उन्को हिस्सा को सीमा म सोरा, एशताओल, ईरशेमेश, <verse eid="JOS 19:41" /><verse number="42" style="v" sid="JOS 19:42" />शालब्बीन, अय्यालोन, यितला, <verse eid="JOS 19:42" /><verse number="43" style="v" sid="JOS 19:43" />एलोन, तिम्ना, एक्रोन, <verse eid="JOS 19:43" /><verse number="44" style="v" sid="JOS 19:44" />एलतके, गिब्बतोन, बालात <verse eid="JOS 19:44" /><verse number="45" style="v" sid="JOS 19:45" />यहूद, बनेबराक, गत्रिम्मोन, <verse eid="JOS 19:45" /><verse number="46" style="v" sid="JOS 19:46" />मेयर्कोन, अऊर रक्कोन, अऊर याफा को सामने की सीमा भी उन्की होती। <verse eid="JOS 19:46" /><verse number="47" style="v" sid="JOS 19:47" /><note caller="+" style="x"><char style="xo" closed="false">19:47 </char><char style="xt" closed="false"><ref loc="JDG 18:27-29">न्यायियों १८:२७-२९</ref></char></note>अऊर दानियों को हिस्सा येको सी जादा भय गयो, मतलब दान को लोगों न लेशेम पर चढ़ायी करी, अऊर उन्ख तलवार सी मार डाल्यो, अऊर ओख अपनो अधिकार म कर क् ओको म बस गयो, अऊर अपनो मुख्य आदमी को नाम पर लेशेम को नाम दान रख्यो। <verse eid="JOS 19:47" /><verse number="48" style="v" sid="JOS 19:48" />कुलों को अनुसार दानियों को वंश को हिस्सा नगरों अऊर गांवो समेत यहांच मिल्यो।<verse eid="JOS 19:48" /></para>
  <para style="s">यहोशू ख भी जमीन हिस्सा मिलनो</para>
  <para style="p">
    <verse number="49" style="v" sid="JOS 19:49" />जब देश को बाट्यो जानो सीमावों को अनुसार पूरो भय गयो, तब इस्राएलियों न नून को टुरा यहोशू ख भी अपनो बीच म एक हिस्सा दियो। <verse eid="JOS 19:49" /><verse number="50" style="v" sid="JOS 19:50" />परमेश्वर को कहन को अनुसार उन्न ओख ओको मांग्यो हुयो नगर दियो, यो एप्रैम को पहाड़ी देश म को तिम्नत्सेरह हय; अऊर ऊ ऊ नगर ख फिर सी बसाय क ओको म रहन लग्यो।<verse eid="JOS 19:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JOS 19:51" />जो जो हिस्सा एलीआजार याजक, अऊर नून को टुरा यहोशू, अऊर इस्राएलियों को वंश को घराना को पूर्वजों को मुख्य मुख्य आदमियों न शीलो म, मिलापवालो तम्बू को फाटक पर, परमेश्वर को सामने चिट्ठी डाल क बाट दियो हि योच आय। यो तरह उन्न देश बाटन को काम पूरो करयो।<verse eid="JOS 19:51" /></para>
  <chapter eid="JOS 19" />
  <chapter number="20" style="c" sid="JOS 20" />
  <para style="s">शरन को नगर</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 20:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">20:1 </char>
      <char style="xt" closed="false">
        <ref loc="NUM 35:9-34">गिनती ३५:९-३४</ref>; <ref loc="DEU 4:41-43">व्यवस्थाविवरन ४:४१-४३</ref>; <ref loc="DEU 19:1-13">१९:१-१३</ref></char>
    </note>फिर परमेश्वर न यहोशू सी कह्यो, <verse eid="JOS 20:1" /><verse number="2" style="v" sid="JOS 20:2" />“इस्राएलियों सी यो कहो, ‘मय न मूसा को द्वारा तुम सी शरन नगर की जो चर्चा करी होती ओको अनुसार उन्ख ठहराय लेवो, <verse eid="JOS 20:2" /><verse number="3" style="v" sid="JOS 20:3" />जेको सी जो कोयी भूल सी यां अनजानो म कोयी ख मार डाले, ऊ वहां सी भग क शरन ले सके; येकोलायी यो नगर खून को बदला लेन वालो सी बचन लायी तुम्हरो शरन नगर ठहरेंन। <verse eid="JOS 20:3" /><verse number="4" style="v" sid="JOS 20:4" />ऊ कोयी भी शरन नगर म भग क जाये, अऊर ऊ नगर की फाटक पर खड़ो होय क उन बुजूर्गों ख अपनी हकिकत बताये; बुजूर्गों ओख अपनो नगर म ले जाये, अऊर ओख रहन लायी जागा दे, जेको म ऊ उन्को संग रहे। <verse eid="JOS 20:4" /><verse number="5" style="v" sid="JOS 20:5" />अऊर खून को बदला लेन वालो ओको पीछा करतो हुयो आये, त बुजूर्गों यो जान क कि ओन अपनो पड़ोसी ख अनजानो म, ओन ओको सी बिना दुस्मनी रख्यो ओख मारयो, येकोलायी ऊ खूनी ख ओको हाथ म नहीं देयेंन। <verse eid="JOS 20:5" /><verse number="6" style="v" sid="JOS 20:6" />अऊर जब तक ऊ मण्डली को सामने न्याय को लायी खड़ो नहीं होयेंन, अऊर जब तक उन दिनों को महायाजक नहीं मर जाये, तब तक ऊ उच नगर म रहेंन; ओको बाद ऊ खूनी अपनो नगर ख जहां सी ऊ भग क आयो होना अपनो घर म लौट जाये।’”<verse eid="JOS 20:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 20:7" />येकोलायी उन्न नप्ताली को पहाड़ी देश म गलील को केदेश नगर ख, अऊर एप्रैम को पहाड़ी देश म शकेम नगर ख, अऊर यहूदा को पहाड़ी देश म किर्यतर्बा नगर ख, जो हेब्रोन भी कहलावय हय शरन नगर ठहरायो। <verse eid="JOS 20:7" /><verse number="8" style="v" sid="JOS 20:8" />अऊर यरीहो को जवर को यरदन को पूर्व दिशा को तरफ उन्न रूबेन को वंश को हिस्सा म बेसेर नगर ख, जो जंगल म चौरस जमीन पर बस्यो हुयो हय, अऊर गाद को वंश को हिस्सा म गिलाद को रामोत ख, अऊर मनश्शे को वंश को हिस्सा म बाशान को गोलान नगर ख ठहरायो। <verse eid="JOS 20:8" /><verse number="9" style="v" sid="JOS 20:9" />पूरो इस्राएलियों लायी, अऊर उन्को बीच म रहन वालो परदेशियों लायी भी, जो नगर यो मनसा सी ठहरायो गयो कि जो कोयी कोयी प्रानी ख भूल सी मार डाले ऊ उन म सी कोयी भी नगर म भग जाये, अऊर जब तक न्याय लायी मण्डली को सामने खड़ो नहीं होयेंन, तब तक खून को बदला लेन वालो ओख मार नहीं पाये, हि हिच नगर आय।<verse eid="JOS 20:9" /></para>
  <chapter eid="JOS 20" />
  <chapter number="21" style="c" sid="JOS 21" />
  <para style="s">लेवियों को नगर</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 21:1" />तब लेवियों को पूर्वजों को परिवारों को मुख्य आदमी एलीआजार याजक, अऊर नून को टुरा यहोशू, अऊर इस्राएली वंश को पूर्वजों को परिवारों को मुख्य आदमियों को जवर आय क <verse eid="JOS 21:1" /><verse number="2" style="v" sid="JOS 21:2" /><note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="NUM 35:1-8">गिनती ३५:१-८</ref> </char></note>कनान देश को शीलो नगर म कहन लग्यो, “परमेश्वर न मूसा को द्वारा हम्ख बसन लायी नगर, अऊर हमरो जनावरों ख चरावन लायी मैदान भी देन की आज्ञा दी होती।” <verse eid="JOS 21:2" /><verse number="3" style="v" sid="JOS 21:3" />तब इस्राएलियों न परमेश्वर को कहन को अनुसार अपनो अपनो हिस्सा म सी लेवियों ख चराइयों समेत हि नगर दियो।<verse eid="JOS 21:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JOS 21:4" />तब कहात जाति को कुलों को नाम पर चिट्ठी निकली। येकोलायी लेवियों म सी हारून याजक को वंश को यहूदा, शिमोन, अऊर बिन्यामीन को वंशों को हिस्सा म सी तेरा नगर मिल्यो। <verse eid="JOS 21:4" /><verse number="5" style="v" sid="JOS 21:5" />बाकी कहात जातियों ख एप्रैम को वंश, दान को वंश, अऊर मनश्शे को अरधो वंश को हिस्सा म सी चिट्ठी डाल क दस नगर दियो गयो।<verse eid="JOS 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 21:6" />फिर गेर्शोनियों ख इस्साकार को वंश को परिवार, अऊर आशेर, अऊर नप्ताली को वंशों को हिस्सा म सी, अऊर मनश्शे को ऊ अरधो वंश को हिस्सा म सी भी जो बाशान प्रदेश म होतो चिट्ठी डाल क तेरा नगर दियो गयो।<verse eid="JOS 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 21:7" />वंशों को अनुसार मरारी वंश ख रूबेन, गाद, अऊर जबूलून को वंशों को हिस्सा म सी बारा नगर दियो गयो।<verse eid="JOS 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 21:8" />जो आज्ञा परमेश्वर न मूसा को द्वारा दी होती ओको अनुसार इस्राएलियों न लेवियों ख चारागाह जमीन समेत यो नगर चिट्ठी डाल क दियो।<verse eid="JOS 21:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 21:9" />उन्न यहूदियों अऊर शिमोनियों को वंशों को हिस्सा म सी यो नगर जिन को नाम लिख्यो हंय दियो; <verse eid="JOS 21:9" /><verse number="10" style="v" sid="JOS 21:10" />हि नगर लेवीय कहाती वंशों म सी हारून को वंश लायी होतो; कहालीकि पहिली चिट्ठी उन्कोच नाम पर निकली होती। <verse eid="JOS 21:10" /><verse number="11" style="v" sid="JOS 21:11" />मतलब उन्न उन्ख यहूदा को पहाड़ी देश म चारयी तरफ की चराइयों समेत किर्यतर्बा नगर दे दियो, जो अर्बा अनाक को बाप होतो जो हेब्रोन भी कहलावय हय। <verse eid="JOS 21:11" /><verse number="12" style="v" sid="JOS 21:12" />पर ऊ नगर को खेत अऊर ओको गांव उन्न यपुन्ने को टुरा कालेब ख ओकी निजी जमीन कर क् दे दियो।<verse eid="JOS 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 21:13" />तब उन्न हारून याजक को वंश ख चराइयों समेत खूनी को शरन नगर हेब्रोन, अऊर अपनी अपनी चराइयों समेत लिब्ना, <verse eid="JOS 21:13" /><verse number="14" style="v" sid="JOS 21:14" />यत्तीर, एश्तमो, <verse eid="JOS 21:14" /><verse number="15" style="v" sid="JOS 21:15" />होलोन, दबीर, <verse eid="JOS 21:15" /><verse number="16" style="v" sid="JOS 21:16" />ऐन, युत्ता अऊर बेतशेमेश दियो; यो तरह उन दिनों वंशों को हिस्सा म सी नव नगर दियो गयो। <verse eid="JOS 21:16" /><verse number="17" style="v" sid="JOS 21:17" />अऊर बिन्यामीन को वंश को हिस्सा म सी अपनी अपनी चराइयों समेत हि चार नगर दियो गयो, मतलब गिबोन, गेबा, <verse eid="JOS 21:17" /><verse number="18" style="v" sid="JOS 21:18" />अनातोत अऊर अल्मोन। <verse eid="JOS 21:18" /><verse number="19" style="v" sid="JOS 21:19" />यो तरह हारूनवंशी याजकों ख तेरा नगर अऊर चराइयां मिली।<verse eid="JOS 21:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 21:20" />फिर बाकी कहाती को लेवी वंश को परिवारों ख एप्रैम को हिस्सा म सी कुछ नगर दियो गयो। <verse eid="JOS 21:20" /><verse number="21" style="v" sid="JOS 21:21" />मतलब उन्ख चराइयों समेत एप्रैम को पहाड़ी देश म खूनी ख शरन लेन ख शकेम नगर दियो गयो, फिर अपनी चराइयों समेत गेजेर, <verse eid="JOS 21:21" /><verse number="22" style="v" sid="JOS 21:22" />किबसैम, अऊर बेथोरोन; हि चार नगर दियो गयो। <verse eid="JOS 21:22" /><verse number="23" style="v" sid="JOS 21:23" />अऊर दान को वंश को हिस्सा म सी अपनी अपनी चराइयों समेत, एलतके, गिब्बतोन, <verse eid="JOS 21:23" /><verse number="24" style="v" sid="JOS 21:24" />अय्यालोन, अऊर गत्रिम्मोन; हि चार नगर दियो गयो। <verse eid="JOS 21:24" /><verse number="25" style="v" sid="JOS 21:25" />अऊर मनश्शे को अरधो वंश को हिस्सा म सी अपनी अपनी चराइयों समेत तानाक अऊर गत्रिम्मोन; हि दोय नगर दियो गयो। <verse eid="JOS 21:25" /><verse number="26" style="v" sid="JOS 21:26" />यो तरह बाकी कहातियों को वंश को सब नगर चराइयों समेत दस नगर होतो।<verse eid="JOS 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 21:27" />फिर लेवियों को वंशों म सी गेर्शोनियों ख मनश्शे को अरधो वंश को हिस्सा म सी अपनी अपनी चराइयों समेत खूनी को शरन नगर बाशान प्रदेश को गोलान अऊर बेशतरा; हि दोय नगर दियो गयो। <verse eid="JOS 21:27" /><verse number="28" style="v" sid="JOS 21:28" />अऊर इस्साकार को वंश को हिस्सा म सी अपनी अपनी चराइयों समेत किश्योन, दाबरत, <verse eid="JOS 21:28" /><verse number="29" style="v" sid="JOS 21:29" />यर्मूत, अऊर एनगन्नीम; हि चार नगर दियो गयो। <verse eid="JOS 21:29" /><verse number="30" style="v" sid="JOS 21:30" />अऊर आशेर को वंश को हिस्सा म सी अपनी अपनी चराइयों समेत मिशाल, अब्दोन, <verse eid="JOS 21:30" /><verse number="31" style="v" sid="JOS 21:31" />हेल्कात, अऊर रहोब; हि चार नगर दियो गयो। <verse eid="JOS 21:31" /><verse number="32" style="v" sid="JOS 21:32" />अऊर नप्ताली को वंश को हिस्सा म सी अपनी अपनी चराइयों समेत खूनी को शरन नगर गलील प्रदेश को केदेश नगर, हम्मोतदोर, अऊर कर्तान; हि तीन नगर दियो गयो। <verse eid="JOS 21:32" /><verse number="33" style="v" sid="JOS 21:33" />गेर्शोनियों को वंशों को अनुसार उन्को सब नगर अपनी अपनी चराइयों समेत तेरा होतो।<verse eid="JOS 21:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 21:34" />फिर बाकी लेवियों, मतलब मरारियों को वंशों ख जबूलून को वंश को हिस्सा म सी अपनी चराइयों समेत योकनाम, कर्ता, <verse eid="JOS 21:34" /><verse number="35" style="v" sid="JOS 21:35" />दिम्ना, अऊर नहलाल; हि चार नगर दियो गयो। <verse eid="JOS 21:35" /><verse number="36" style="v" sid="JOS 21:36" />अऊर रूबेन को वंश को हिस्सा म सी अपनी चराइयों समेत बेसेर, यहसा, <verse eid="JOS 21:36" /><verse number="37" style="v" sid="JOS 21:37" />कदेमोत, अऊर मेपात; हि चार नगर दियो गयो। <verse eid="JOS 21:37" /><verse number="38" style="v" sid="JOS 21:38" />अऊर गाद को वंश को हिस्सा म सी अपनी चराइयों समेत खूनी को शरन नगर गिलाद प्रदेश म को रामोत, महनैम, <verse eid="JOS 21:38" /><verse number="39" style="v" sid="JOS 21:39" />हेशबोन, अऊर याजेर, यो सब मिलाय क चार नगर हंय, दियो गयो। <verse eid="JOS 21:39" /><verse number="40" style="v" sid="JOS 21:40" />लेवियों को बाकी वंशों मतलब मरारियों को वंशों को अनुसार उन्ख बारा नगर चिट्ठी डाल क दियो गयो।<verse eid="JOS 21:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JOS 21:41" />इस्राएलियों की निजी जमीन को बीच लेवियों को सब नगर अपनी चराइयों समेत अड़तालीस हय। <verse eid="JOS 21:41" /><verse number="42" style="v" sid="JOS 21:42" />हि सब नगर अपनो चारयी तरफ की चराइयों को संग होती; इन सब नगरों की याच दशा होती।<verse eid="JOS 21:42" /></para>
  <para style="s">इस्राएलियों को कनान देश पर पूरो अधिकार</para>
  <para style="p">
    <verse number="43" style="v" sid="JOS 21:43" />यो तरह परमेश्वर न इस्राएलियों ख ऊ पूरो देश दियो, जेक ओन उन्को पूर्वजों सी कसम खाय क देन ख कह्यो होतो; अऊर हि ओको अधिकारी होय क ओको म बस गयो। <verse eid="JOS 21:43" /><verse number="44" style="v" sid="JOS 21:44" />अऊर परमेश्वर न उन सब बातों को अनुसार, जो ओन उन्को पूर्वजों सी कसम खाय क कही होती, उन्ख चारयी तरफ सी आराम दियो; अऊर उन्को दुस्मनों म सी कोयी भी उन्को सामने टिक नहीं सक्यो; परमेश्वर न उन सब ख उन्को वश म कर दियो। <verse eid="JOS 21:44" /><verse number="45" style="v" sid="JOS 21:45" />जितनी भलायी की बाते परमेश्वर न इस्राएल को घराना सी कही होती ओको म सी कोयी बात भी नहीं छूटी; सब की सब पूरी भयी।<verse eid="JOS 21:45" /></para>
  <chapter eid="JOS 21" />
  <chapter number="22" style="c" sid="JOS 22" />
  <para style="s">यहोशू पूर्व म बस्यो वंशों ख घर वापस जान की अनुमती देवय हय</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 22:1" />ऊ समय यहोशू न रूबेनियों, गादियों, अऊर मनश्शे को अरधो वंश को लोगों ख बुलाय क कह्यो, <verse eid="JOS 22:1" /><verse number="2" style="v" sid="JOS 22:2" /><note caller="+" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="NUM 32:20-32">गिनती ३२:२०-३२</ref>; <ref loc="JOS 1:12-15">यहोशू १:१२-१५</ref></char></note>जो जो आज्ञा परमेश्वर को दास मूसा न तुम्ख दी होती हि सब तुम न मानी हय, अऊर जो जो आज्ञा मय न तुम्ख दी हंय उन सब ख भी तुम न मान्यो हय; <verse eid="JOS 22:2" /><verse number="3" style="v" sid="JOS 22:3" />तुम न अपनो भाऊवों ख इतनो दिनों म अज तक नहीं छोड़्यो, पर अपनो परमेश्वर यहोवा की आज्ञा तुम न अच्छो सी पालन करयो। <verse eid="JOS 22:3" /><verse number="4" style="v" sid="JOS 22:4" />अऊर अब तुम्हरो परमेश्वर यहोवा न तुम्हरो भाऊवों ख अपनो वचन को अनुसार आराम दियो हय; येकोलायी अब तुम लौट क अपनो डेरा ख, अऊर अपनी निजी भूमि म, जेक परमेश्वर को सेवक मूसा न यरदन को ओन पार तुम्ख दियो हय, चली जावो। <verse eid="JOS 22:4" /><verse number="5" style="v" sid="JOS 22:5" />केवल या बात की पूरी चौकसी करो कि जो जो आज्ञा अऊर व्यवस्था परमेश्वर को सेवक मूसा न तुम्ख दी हय ओख मान क अपनो परमेश्वर यहोवा सी प्रेम रखो, ओको पूरो रस्ता पर चलो, ओकी आज्ञाये मानो, ओकी भक्ति म लवलीन रहो, अऊर अपनो पूरो मन अऊर पूरो जीव सी ओकी सेवा करो। <verse eid="JOS 22:5" /><verse number="6" style="v" sid="JOS 22:6" />तब यहोशू न उन्ख आशीर्वाद दे क बिदा करयो अऊर हि अपनो अपनो डेरा ख चली गयो। <verse eid="JOS 22:6" /><verse number="7" style="v" sid="JOS 22:7" />मनश्शे को अरधो वंश को लोगों ख मूसा न बाशान प्रदेश म हिस्सा दियो होतो; पर दूसरो अरधो वंश ख यहोशू न उन्को भाऊवों को बीच म यरदन को पश्चिम दिशा को तरफ हिस्सा दियो।</para>
  <para style="p" vid="JOS 22:7">उन्ख जब यहोशू न बिदा करयो कि हि अपनो डेरा ख चली जाये, <verse eid="JOS 22:7" /><verse number="8" style="v" sid="JOS 22:8" />तब उन्ख भी आशीर्वाद दे क कह्यो, “बहुत सो जनावर, अऊर चांदी, सोनो, पीतल, लोहा, अऊर बहुत सो कपड़ा, अऊर बहुत धन सम्पत्ति ले क अपनो डेरा ख चली जावो; अऊर अपनो दुस्मनों की लूटी हुयी सम्पत्ति अपनो भाऊवों को संग बाट लेवो।”<verse eid="JOS 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 22:9" />तब रूबेनी, गादी, अऊर मनश्शे को अरधो वंश को लोग इस्राएलियों को जवर सी, मतलब कनान देश को शीलो नगर सी, अपनी गिलाद नाम की निजी जमीन म, जो मूसा को द्वारा दी गयी परमेश्वर की आज्ञा को अनुसार उन्की निजी जमीन भय गयी होती, लौट गयो।<verse eid="JOS 22:9" /></para>
  <para style="s">यरदन को किनार पर वेदी की स्थापना</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 22:10" />जब रूबेनी, गादी, अऊर मनश्शे को अरधो वंश को लोग यरदन नदी को किनार पर स्थित गलीलोत नगर म पहुंच्यो जो कनान देश म हय, उन्न वहां एक बड़ी अऊर प्रभावशाली वेदी बनायी। <verse eid="JOS 22:10" /><verse number="11" style="v" sid="JOS 22:11" />अऊर इस्राएलियों न सुन्यो कि, रूबेनियों, गादियों, अऊर मनश्शे को अरधो वंश को लोगों न कनान देश की सीमा पर यरदन नदी को ओन पार हमरो क्षेत्र को सामने गलीलोत म एक वेदी बनायी हय। <verse eid="JOS 22:11" /><verse number="12" style="v" sid="JOS 22:12" />जब इस्राएल को लोगों न यो सुन्यो, तब इस्राएल की पूरी मण्डली उन सी लड़न लायी शीलो म जमा भयी।<verse eid="JOS 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 22:13" />तब इस्राएलियों न रूबेनियों, गादियों, अऊर मनश्शे को अरधो वंश को लोगों को जवर गिलाद देश म एलीआजार याजक को टुरा पीनहास ख, <verse eid="JOS 22:13" /><verse number="14" style="v" sid="JOS 22:14" />अऊर ओको संग दस मुखियावों ख, मतलब इस्राएल को एक एक वंश म सी पूर्वजों को घराना म को एक एक मुखिया ख भेज्यो, अऊर हि इस्राएल को हजारों म अपनो अपनो पूर्वजों को घराना को मुख्य आदमी होतो। <verse eid="JOS 22:14" /><verse number="15" style="v" sid="JOS 22:15" />हि गिलाद देश म रूबेनियों, गादियों, अऊर मनश्शे को अरधो वंश को लोगों जवर जाय क कहन लग्यो, <verse eid="JOS 22:15" /><verse number="16" style="v" sid="JOS 22:16" /><note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="DEU 12:13">व्यवस्थाविवरन १२:१३</ref>,<ref loc="DEU 12:14">१४</ref></char></note>“परमेश्वर की पूरी मण्डली यो कह्य हय, ‘तुम न इस्राएल को परमेश्वर यहोवा को यो कसो विश्वासघात करयो; अज त तुम न एक वेदी बनाय लियो हय, येको म तुम न ओको पीछू चलनो छोड़ क ओको खिलाफ अज विद्रोह करयो हय? <verse eid="JOS 22:16" /><verse number="17" style="v" sid="JOS 22:17" /><note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="NUM 25:1-9">गिनती २५:१-९</ref></char></note>सुनो, जो पोर नगर को अधर्म हमरो लायी कुछ कम होतो? ऊ अधर्म को वजह प्रभु की मण्डली को ऊपर महामारी आयी होती, हम अज भी ऊ अधर्म सी शुद्ध नहीं भयो हय; का वा तुम्हरी नजर म छोटी सी बात आय <verse eid="JOS 22:17" /><verse number="18" style="v" sid="JOS 22:18" />कि अज तुम परमेश्वर ख त्याग क ओको पीछू चलनो छोड़ देवय हय? यदि तुम परमेश्वर सी फिर जावय हय, त कल ऊ इस्राएल की पूरी मण्डली सी गुस्सा होयेंन। <verse eid="JOS 22:18" /><verse number="19" style="v" sid="JOS 22:19" />पर यदि तुम्हरी निजी भूमि अशुद्ध होना, त परमेश्वर की निजी भूमि म आय जावो जहां परमेश्वर को निवास रह्य हय, हम लोगों को बीच म अपनी अपनी निजी भूमि कर लेवो; पर हमरो परमेश्वर यहोवा की वेदी ख छोड़ क अऊर नहीं कोयी वेदी बनाय क परमेश्वर सी विद्रोह करो, अऊर नहीं हम सी। <verse eid="JOS 22:19" /><verse number="20" style="v" sid="JOS 22:20" /><note caller="+" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="JOS 7:1-26">यहोशू ७:१-२६</ref></char></note>देखो, जब जेरह को टुरा आकान न भेंट करी हुयी चिज को बारे म विश्वासघात करयो, तब परमेश्वर को कोप इस्राएल की पूरी मण्डली पर भड़क्यो? अऊर ऊ आदमी को अधर्म की सजा अकेलो ओखच नहीं मिली।’”<verse eid="JOS 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 22:21" />तब रूबेनियों, गादियों, अऊर मनश्शे को अरधो वंश को लोगों न इस्राएली मुखियावों ख यो उत्तर दियो, <verse eid="JOS 22:21" /><verse number="22" style="v" sid="JOS 22:22" />“परमेश्वर जो एक ईश्वरों को परमेश्वर आय! ऊ परमेश्वर यहोवा ओख जानय हय, अऊर इस्राएली भी येख जान लेयेंन कि यदि परमेश्वर सी फिर क यां ओको विश्वासघात कर क् हम न यो काम करयो होना, त तय हम्ख जीन्दो मत छोड़, <verse eid="JOS 22:22" /><verse number="23" style="v" sid="JOS 22:23" />यदि हम न वेदी ख येकोलायी बनायो होना कि परमेश्वर को पीछू चलनो छोड़ दे, यां येकोलायी कि ओको पर होमबलि, अन्नबलि, यां मेलबलि चढ़ाये, त परमेश्वर खुद येको हिसाब लेयेंन; <verse eid="JOS 22:23" /><verse number="24" style="v" sid="JOS 22:24" />पर हम न योच बिचार अऊर मनसा सी यो करयो हय कि कहीं भविष्य म तुम्हरी सन्तान हमरी सन्तान सी यो नहीं कहन लगे, ‘तुम्ख इस्राएल को परमेश्वर यहोवा सी का काम? <verse eid="JOS 22:24" /><verse number="25" style="v" sid="JOS 22:25" />कहालीकि हे रूबेनियों, हे गादियों, परमेश्वर न तुम्हरो अऊर हमरो बीच म यरदन ख सीमा बनाय दियो हय, येकोलायी परमेश्वर को संग तुम्हरो कोयी साझा नहाय।’ यो तरह तुम्हरी सन्तान अऊर हमरी सन्तान म सी परमेश्वर को डर खतम कर देयेंन। <verse eid="JOS 22:25" /><verse number="26" style="v" sid="JOS 22:26" />येकोलायी हम न कह्यो, ‘आवो, हम अपनो लायी एक वेदी बनाय लेबो, वा होमबलि यां मेलबलि को लायी नहीं, <verse eid="JOS 22:26" /><verse number="27" style="v" sid="JOS 22:27" />पर येकोलायी कि हमरो अऊर तुम्हरो, अऊर हमरो बाद हमरो अऊर तुम्हरो वंश को बीच म एक संकेत को रूप म काम दे; येकोलायी कि हम होमबलि, मेलबलि, अऊर बलिदान चढ़ाय क परमेश्वर को सामने ओकी उपासना करे; अऊर भविष्य म तुम्हरी सन्तान हमरी सन्तान सी यो नहीं कहनो पाये, कि परमेश्वर को संग तुम्हरो कोयी साझा नहाय।’ <verse eid="JOS 22:27" /><verse number="28" style="v" sid="JOS 22:28" />येकोलायी हम न कह्यो, ‘जब हि लोग भविष्य म हम सी यां हमरो वंश सी कभी कहन लगेंन, तब हम उन सी कहबोंन, कि परमेश्वर कि वेदी को नमुना पर बनी हुयी या वेदी ख देखो, जेक हमरो पूर्वजों न होमबलि यां मेलबलि को लायी नहीं बनायो; पर येकोलायी बनायो होतो कि हमरो अऊर तुम्हरो बीच म एक गवाह बनन लायी काम दे।’ <verse eid="JOS 22:28" /><verse number="29" style="v" sid="JOS 22:29" />या हम सी दूर रहे कि परमेश्वर सी फिर क अज ओको पीछू चलनो छोड़ देबो, अऊर अपनो परमेश्वर यहोवा की वा वेदी ख छोड़ क जो ओको निवास को सामने हय होमबलि, अऊर अन्नबलि यां मेलबलि, लायी दूसरी वेदी बनायबो।”<verse eid="JOS 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 22:30" />रूबेनियों, गादियों, अऊर मनश्शे को अरधो वंश को लोगों की इन बातों ख सुन्क पीनहास याजक अऊर ओको संग मण्डली को मुखिया, जो इस्राएल को मुख्य आदमी होतो, हि बहुत खुश भयो। <verse eid="JOS 22:30" /><verse number="31" style="v" sid="JOS 22:31" />अऊर एलीआजार याजक को टुरा पीनहास न रूबेन, गाद, अऊर मनश्शे को लोगों सी कह्यो, “तुम न परमेश्वर को विश्वासघात नहीं करयो, येकोसी हम न यो जान लियो कि परमेश्वर हमरो बीच म हय : अऊर तुम लोगों न इस्राएलियों ख परमेश्वर को हाथों सी सजा होन सी बचाय लियो हय।”<verse eid="JOS 22:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 22:32" />तब एलीआजार को टुरा पीनहास मुखियावों समेत रूबेनियों अऊर गादियों को जवर सी गिलाद होतो हुयो कनान देश म इस्राएलियों को जवर लौट गयो : अऊर यो समाचार उन्ख सुनायो। <verse eid="JOS 22:32" /><verse number="33" style="v" sid="JOS 22:33" />तब इस्राएल को लोग खुश भयो; अऊर परमेश्वर ख धन्य कह्यो, अऊर रूबेनियों अऊर गादियों सी लड़न अऊर उन्को रहन को देश उजाड़न लायी चढ़ायी करन की चर्चा फिर नहीं करी।<verse eid="JOS 22:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 22:34" />अऊर रूबेन अऊर गाद को लोगों न यो कह्य क, “या वेदी हमरो अऊर उन्को बीच म गवाह हय, कि यहोवाच परमेश्वर आय;” ऊ वेदी को नाम एद<note caller="+" style="f"><char style="fr" closed="false">22:34 </char><char style="ft" closed="false">गवाह</char></note> रख्यो।<verse eid="JOS 22:34" /></para>
  <chapter eid="JOS 22" />
  <chapter number="23" style="c" sid="JOS 23" />
  <para style="s">यहोशू को आखरी उपदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 23:1" />बहुत दिन को बाद, जब परमेश्वर न इस्राएलियों ख उन्को आजु-बाजू को दुस्मनो सी आराम दियो, अऊर यहोशू बूढ्ढा अऊर बहुत उमर को भय गयो होतो, <verse eid="JOS 23:1" /><verse number="2" style="v" sid="JOS 23:2" />तब यहोशू सब इस्राएलियों ख, अऊर बुजूर्गों, मुख्य आदमियों, न्यायियों, अऊर सरदारों ख बुलाय क कहन लग्यो, “मय त अब बूढ्ढा अऊर बहुत उमर को भय गयो हय; <verse eid="JOS 23:2" /><verse number="3" style="v" sid="JOS 23:3" />अऊर जो तुम न देख्यो हय कि तुम्हरो परमेश्वर यहोवा न तुम्हरो वजह इन सब जातियों को संग का का करयो हय, कहालीकि जो तुम्हरो तरफ सी लड़तो आयो हय ऊ तुम्हरो परमेश्वर यहोवा आय। <verse eid="JOS 23:3" /><verse number="4" style="v" sid="JOS 23:4" />देखो, मय न बची हुयी जातियों ख तुम्हरो वंश को हिस्सा बाट दियो हय; अऊर यरदन नदी सी ले क पश्चिम को तरफ को बड़ो समुन्दर तक रहन वाली उन सब जातियों ख भी असोच दियो हय, जिन्को मय न नाश कर डाल्यो हय। <verse eid="JOS 23:4" /><verse number="5" style="v" sid="JOS 23:5" />अऊर तुम्हरो परमेश्वर यहोवा उन्ख तुम्हरो सामने सी उन्को देश सी निकाल देयेंन; अऊर तुम अपनो परमेश्वर यहोवा को वचन को अनुसार उन्को देश को अधिकारी होय जावो। <verse eid="JOS 23:5" /><verse number="6" style="v" sid="JOS 23:6" />येकोलायी बहुत हिम्मत बान्ध क, जो कुछ मूसा की व्यवस्था की किताब म लिख्यो हय ओको पूरो करन म सावधान रहो, ओको सी नहीं त दायो मुड़ो अऊर नहीं बायो तरफ। <verse eid="JOS 23:6" /><verse number="7" style="v" sid="JOS 23:7" />हि जो जातियां तुम्हरो बीच म रह्य गयी हंय इन्को बीच म मत जावो, अऊर नहीं इन्को देवतावों को नाम की चर्चा करो, अऊर नहीं इन्की कसम खिलावो, अऊर नहीं उन्ख दण्डवत करो, <verse eid="JOS 23:7" /><verse number="8" style="v" sid="JOS 23:8" />पर जसो अज भी तुम अपनो परमेश्वर यहोवा की भक्ति म लवलीन रह्य हय, वसोच रह्यो करो। <verse eid="JOS 23:8" /><verse number="9" style="v" sid="JOS 23:9" /><note caller="+" style="x"><char style="xo" closed="false">23:9 </char><char style="xt" closed="false"><ref loc="ACT 7:45">प्रेरितों 7:45</ref></char></note>परमेश्वर न तुम्हरो सामने सी बड़ी अऊर शक्तिशाली जातियों ख निकाल्यो हय; अऊर तुम्हरो सामने अज तक कोयी ठहर नहीं सक्यो। <verse eid="JOS 23:9" /><verse number="10" style="v" sid="JOS 23:10" /><note caller="+" style="x"><char style="xo" closed="false">23:10 </char><char style="xt" closed="false"><ref loc="DEU 3:22">व्यवस्थाविवरन ३:२२</ref>; <ref loc="DEU 32:30">३२:३०</ref></char></note>तुम म सी एक आदमी हजार आदमियों भगाय सकय हय, कहालीकि तुम्हरो परमेश्वर यहोवा अपनो वचन को अनुसार तुम्हरो तरफ सी लड़य हय। <verse eid="JOS 23:10" /><verse number="11" style="v" sid="JOS 23:11" />येकोलायी अपनो परमेश्वर यहोवा सी प्रेम रखन लायी सदा चौकस रहो। <verse eid="JOS 23:11" /><verse number="12" style="v" sid="JOS 23:12" />कहालीकि यदि तुम कोयी रीति सी परमेश्वर सी फिर क इन जातियों को बाकी लोगों सी घुल-मिल जावो जो तुम्हरो बीच म बच्यो हुयो रह्य हंय, अऊर इन सी शादी बिहाव कर क् इन्को संग समधियाना रिस्ता जोड़ो, <verse eid="JOS 23:12" /><verse number="13" style="v" sid="JOS 23:13" />त जरूर जान लेवो कि तुम्हरो परमेश्वर यहोवा इन जातियों ख तुम्हरो सामने सी नहीं निकालेंन; अऊर हि तुम्हरो लायी जाल अऊर फन्दा, अऊर तुम्हरो पीठ पर कोड़ा, अऊर तुम्हरी आंखी म काटा को जसो खतरनाक ठहरेंन, अऊर आखरी म तुम या अच्छी जमीन पर सी जो तुम्हरो परमेश्वर यहोवा न तुम्ख दियो हय नाश होय जावो।<verse eid="JOS 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 23:14" />“सुनो, मय त अब मृत्यु की गति पर जान वालो हय, अऊर तुम सब अपनो अपनो दिल अऊर मन म जानय हय, कि जितनी भलायी की बाते हमरो परमेश्वर यहोवा न हमरो बारे म कही हय उन्म सी एक भी पूरी हुयी बिना नहीं रही; हि सब की सब तुम पर घट गयी हंय, उन्म सी एक भी पूरी हुयी बिना नहीं रही। <verse eid="JOS 23:14" /><verse number="15" style="v" sid="JOS 23:15" />त जसो तुम्हरो परमेश्वर यहोवा की कही हुयी सब भलायी की बाते तुम पर घटी हय; वसो परमेश्वर यहोवा विपत्ति की सब बाते भी तुम पर लगायेंन अऊर तुम्ख या अच्छी जमीन को ऊपर सी, जेक तुम्हरो परमेश्वर यहोवा न तुम्ख दियो हय, नाश कर डालेंन। <verse eid="JOS 23:15" /><verse number="16" style="v" sid="JOS 23:16" />जब तुम ऊ वाचा की, जेक तुम्हरो परमेश्वर यहोवा न तुम्ख आज्ञा दी हय, उल्लंघन कर क् परायो देवतावों की उपासना अऊर उन्ख दण्डवत करन लगो, तब परमेश्वर को कोप तुम पर भड़केंन, अऊर तुम यो अच्छो देश म सी जेक ओन तुम्ख दियो हय तुरतच नाश होय जावो।”<verse eid="JOS 23:16" /></para>
  <chapter eid="JOS 23" />
  <chapter number="24" style="c" sid="JOS 24" />
  <para style="s">शकेम नगर म यहोशू को आखरी आदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 24:1" />यहोशू न इस्राएलियों को सब वंश को लोगों ख शकेम नगर म जमा करयो, अऊर इस्राएल को बुजूर्ग लोगों ख अऊर मुख्य आदमियों, अऊर न्यायियों, अऊर सरदारों ख बुलायो; अऊर हि परमेश्वर को सामने मौजूद भयो। <verse eid="JOS 24:1" /><verse number="2" style="v" sid="JOS 24:2" /><note caller="+" style="x"><char style="xo" closed="false">24:2 </char><char style="xt" closed="false"><ref loc="GEN 11:27">उत्पत्ति ११:२७</ref></char></note>तब यहोशू न उन सब लोगों सी कह्यो, “इस्राएल को परमेश्वर यहोवा यो तरह कह्य हय, ‘प्राचिन काल म अब्राहम अऊर नाहोर को बाप तेरह पहले, तुम्हरो पूर्वज फरात नदी को ओन पार रहत होतो, हि दूसरो देवतावों की पूजा करत होतो। <verse eid="JOS 24:2" /><verse number="3" style="v" sid="JOS 24:3" /><note caller="+" style="x"><char style="xo" closed="false">24:3 </char><char style="xt" closed="false"><ref loc="GEN 12:1-9">उत्पत्ति 12:1-9</ref>; <ref loc="GEN 21:1-3">21:1-3</ref></char></note>अऊर मय न तुम्हरो पूर्वज अब्राहम ख फरात नदी को ओन पार सी लियो अऊर ओख पूरो कनान देश घुमायो, अऊर मय न ओको वंश बढ़ायो। अऊर ओख इसहाक ख दियो; <verse eid="JOS 24:3" /><verse number="4" style="v" sid="JOS 24:4" /><note caller="+" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="GEN 25:24-26">उत्पत्ति २५:२४-२६</ref>; <ref loc="GEN 36:8">३६:८</ref>; <ref loc="GEN 46:1-7">४६:१-७</ref>; <ref loc="DEU 2:5">व्यवस्थाविवरन २:५</ref></char></note>फिर मय न इसहाक ख याकूब अऊर एसाव दियो। अऊर एसाव ख मय न सेईर नाम की पहाड़ी देश दियो कि ऊ ओको अधिकारी होय सके, पर याकूब अऊर ओको टुरा मिस्र देश ख चली गयो। <verse eid="JOS 24:4" /><verse number="5" style="v" sid="JOS 24:5" />फिर मय न मूसा अऊर हारून ख भेज क उन सब कामों को द्वारा जो मय न मिस्र देश म करयो, ऊ देश ख नाश कर दियो; अऊर ओको बाद वहां सी तुम्ख बाहेर निकाल लायो। <verse eid="JOS 24:5" /><verse number="6" style="v" sid="JOS 24:6" />अऊर मय न तुम्हरो पूर्वजों ख मिस्र देश म सी निकाल लायो, अऊर तुम लाल समुन्दर पर पहुंच्यो; अऊर मिस्रियों न रथों अऊर घुड़सवारों ख ले क लाल समुन्दर तक तुम्हरो पीछा करयो। <verse eid="JOS 24:6" /><verse number="7" style="v" sid="JOS 24:7" /><note caller="+" style="x"><char style="xo" closed="false">24:7 </char><char style="xt" closed="false"><ref loc="EXO 14:1-31">निर्गमन 14:1-31</ref></char></note>अऊर जब तुम न यहोवा की दोहायी दी, अऊर मय न उन्को अऊर मिस्रियों को बीच अन्धियारो कर दियो, अऊर मय न उन पर समुन्दर ख बहाय क उन्ख डुबाय दियो; अऊर जो कुछ मय न मिस्र म करयो ओख तुम लोगों न अपनी आंखी सी देख्यो;’”</para>
  <para style="p" vid="JOS 24:7">“फिर तुम बहुत समय तक जंगल म रह्यो।” <verse eid="JOS 24:7" /><verse number="8" style="v" sid="JOS 24:8" /><note caller="+" style="x"><char style="xo" closed="false">24:8 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">गिनती २१:२१-३५</ref></char></note>तब मय तुम्ख उन एमोरी जाति को देश म लायो, जो यरदन नदी को पूर्व दिशा म बस्यो होतो; अऊर हि तुम सी युद्ध करयो, अऊर मय न उन्ख तुम्हरो हाथ म सौंप दियो, अऊर तुम उन्को देश को अधिकारी भय गयो, अऊर मय न एमोरी जाति ख तुम्हरो सामने नाश कर दियो। <verse eid="JOS 24:8" /><verse number="9" style="v" sid="JOS 24:9" />फिर मोआब को राजा सिप्पोर को टुरा बालाक इस्राएल सी लड़न तैयार भयो; अऊर तुम्ख श्राप देन लायी बोर को टुरा बिलाम ख बुलावा भेज्यो, <verse eid="JOS 24:9" /><verse number="10" style="v" sid="JOS 24:10" /><note caller="+" style="x"><char style="xo" closed="false">24:10 </char><char style="xt" closed="false"><ref loc="NUM 22:1">गिनती २२:१</ref>; <ref loc="NUM 24:25">२४:२५</ref></char></note>पर मय न बिलाम की नहीं सुनी; ऊ तुम्ख आशीषच आशीष देतो गयो; यो तरह मय न तुम्ख ओको हाथ सी बचायो। <verse eid="JOS 24:10" /><verse number="11" style="v" sid="JOS 24:11" /><note caller="+" style="x"><char style="xo" closed="false">24:11 </char><char style="xt" closed="false"><ref loc="JOS 3:14-17">यहोशू ३:१४-१७</ref>; <ref loc="JOS 6:1-21">६:१-२१</ref></char></note>तब तुम यरदन नदी पार होय क यरीहो को जवर आयो, अऊर जब यरीहो को लोग, अऊर एमोरी, परिज्जी, कनानी, हित्ती, गिर्गाशी, हिब्बी, अऊर यबूसी तुम सी लड़्यो, तब मय न उन्ख तुम्हरो वश म कर दियो। <verse eid="JOS 24:11" /><verse number="12" style="v" sid="JOS 24:12" /><note caller="+" style="x"><char style="xo" closed="false">24:12 </char><char style="xt" closed="false"><ref loc="EXO 23:28">निर्गमन २३:२८</ref>; <ref loc="DEU 7:20">व्यवस्थाविवरन ७:२०</ref></char></note>अऊर मय न तुम्हरो आगु बर्रों को आतंक भेज्यो, अऊर उन्न एमोरियों को दोयी राजावों ख तुम्हरो सामने सी निकाल दियो; देखो, या तुम्हरी तलवार यां धनुष को बल पर नहीं भयो। <verse eid="JOS 24:12" /><verse number="13" style="v" sid="JOS 24:13" /><note caller="+" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="DEU 6:10">व्यवस्थाविवरन ६:१०</ref>,<ref loc="DEU 6:11">११</ref></char></note>फिर मय न तुम्ख असो देश दियो होतो, अऊर असो नगर भी दियो हय जिन्ख तुम न नहीं बसायो होतो, अऊर तुम ओको म निवास करय हय; अऊर जो अंगूर अऊर जैतून को बगीचा को फर तुम खावय हय उन्ख तुम न नहीं लगायो होतो।<verse eid="JOS 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 24:14" />यहोशू न कह्यो, “परमेश्वर को भय मान क ओकी सेवा खरायी अऊर सच्चायी सी करो; अऊर जिन देवतावों की सेवा तुम्हरो पूर्वज मेशोपोटामियां अऊर मिस्र म करत होतो, उन्ख दूर कर क् परमेश्वर की सेवा करो। <verse eid="JOS 24:14" /><verse number="15" style="v" sid="JOS 24:15" />अऊर यदि परमेश्वर की सेवा करनो तुम्ख बुरो लगय हय, त अज चुन लेवो कि तुम कौन की सेवा करो, चाहे उन देवतावों की उन्की सेवा तुम्हरो पूर्वज मेशोपोटामियां<note caller="+" style="f"><char style="fr" closed="false">24:15 </char><char style="ft" closed="false">महा नदी</char></note> म करत होतो, अऊर चाहे एमोरियों को देवतावों की सेवा करो जिन्को देश म तुम रह्य हय; पर मय त अपनो परिवार समेत परमेश्वरच की सेवा हमेशा करूं।”<verse eid="JOS 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 24:16" />तब लोगों न उत्तर दियो, “परमेश्वर ख त्याग क दूसरो देवतावों की सेवा करन को बिचार हम कभी नहीं करबो; <verse eid="JOS 24:16" /><verse number="17" style="v" sid="JOS 24:17" />कहालीकि हमरो परमेश्वर यहोवा उच आय जो हम्ख अऊर हमरो पूर्वजों ख मिस्र देश सी निकाल लायो, अऊर हमरो देखतो देखतो बड़ो बड़ो आश्चर्यकर्म करयो, अऊर जो रस्ता पर अऊर जितनी जातियों को बीच म सी हम चलत आवत होतो ओन हमरी रक्षा करी; <verse eid="JOS 24:17" /><verse number="18" style="v" sid="JOS 24:18" /><note caller="+" style="x"><char style="xo" closed="false">24:18 </char><char style="xt" closed="false"><ref loc="ACT 7:45">प्रेरितों ७:४५</ref></char></note>अऊर हमरो सामने सी यो देश म रहन वाली एमोरी अऊर सब जातियों ख निकाल दियो हय; येकोलायी हम भी परमेश्वर की सेवा करबो, कहालीकि हमरो परमेश्वर उच आय।”<verse eid="JOS 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 24:19" />यहोशू न लोगों सी कह्यो, “तुम सी परमेश्वर की सेवा नहीं होय सकय; कहालीकि ऊ पवित्र परमेश्वर आय; ऊ जलन रखन वालो परमेश्वर आय; ऊ तुम्हरो अपराध अऊर पाप माफ नहीं करेंन। <verse eid="JOS 24:19" /><verse number="20" style="v" sid="JOS 24:20" />यदि तुम परमेश्वर ख त्याग क परायो देवतावों की सेवा करन लगो, त ऊ तुम्हरो भलो करतो आयो हय तब भी ऊ मुड़ क तुम्हरी हानि करेंन, अऊर तुम्हरो अन्त भी कर डालेंन।”<verse eid="JOS 24:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 24:21" />लोगों न यहोशू सी कह्यो, “नहीं; हम परमेश्वरच की सेवा करबो।”<verse eid="JOS 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 24:22" />यहोशू न लोगों सी कह्यो, “तुम खुदच अपनो गवाह हय कि तुम न परमेश्वर की सेवा करन को निर्नय लियो हय।” उन्न कह्यो,</para>
  <para style="p" vid="JOS 24:22">“हां, हम गवाह हय।”<verse eid="JOS 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JOS 24:23" />यहोशू न कह्यो, “अपनो बीच म सी परायो देवतावों ख दूर कर क् अपनो अपनो मन इस्राएल को परमेश्वर यहोवा को तरफ लगावो।”<verse eid="JOS 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 24:24" />लोगों न यहोशू सी कह्यो, “हम त अपनो परमेश्वर यहोवाच की सेवा करबो, अऊर ओकीच बात मानबो।”<verse eid="JOS 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 24:25" />तब यहोशू न उच दिन लोगों सी वाचा बन्धायी, अऊर शकेम म उन्को लायी विधि अऊर नियम ठहरायो। <verse eid="JOS 24:25" /><verse number="26" style="v" sid="JOS 24:26" />या पूरी बाते यहोशू न परमेश्वर की व्यवस्था की किताब म लिख दियो; अऊर एक बड़ो गोटा चुन क वहां ऊ बांझ झाड़ को खल्लो खड़ो करयो, जो परमेश्वर को पवित्र जागा म होतो। <verse eid="JOS 24:26" /><verse number="27" style="v" sid="JOS 24:27" />तब यहोशू न लोगों सी कह्यो, “सुनो, यो गोटा हम लोगों को गवाह रहेंन, कहालीकि जितनो वचन परमेश्वर न हम सी कह्यो हय उन्ख येन सुन्यो हय; येकोलायी यो तुम्हरो गवाह रहेंन, असो नहीं होय कि तुम अपनो परमेश्वर सी मुकर जावो।” <verse eid="JOS 24:27" /><verse number="28" style="v" sid="JOS 24:28" />तब यहोशू न लोगों ख अपनो अपनो निजी हिस्सा म जान लायी बिदा करयो।<verse eid="JOS 24:28" /></para>
  <para style="s">यहोशू अऊर एलीआजार की मृत्यु</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 24:29" />इन बातों को बाद परमेश्वर को सेवक, नून को टुरा यहोशू, एक सौ दस साल को होय क मर गयो। <verse eid="JOS 24:29" /><verse number="30" style="v" sid="JOS 24:30" /><note caller="+" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="JOS 19:49-50">यहोशू १९:४९-५०</ref></char></note>अऊर ओको शव ख ओको जमीन हिस्सा तिम्नत्सेरह नगर म माटी दी गयी, जो एप्रैम को पहाड़ी देश म गाश नाम की पहाड़ी को उत्तर म हय।<verse eid="JOS 24:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 24:31" />यहोशू जब तक जीन्दो रह्यो, तब तक इस्राएली लोग परमेश्वर की उपासना करतो रह्यो, अऊर ओको मरन को बाद भी हि अगुवा को जीन्दो रहतो, जिन्न ऊ सब कुछ जो परमेश्वर न इस्राएलियों को लायी करयो होतो, देख क इस्राएल को लोग परमेश्वर की उपासना करतो रह्यो।<verse eid="JOS 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 24:32" />फिर यूसुफ की हड्डी जिन्ख इस्राएली लोग मिस्र सी लायो होतो हि शकेम नगर की जमीन को ऊ हिस्सा म गाड़ी गयी, जेक याकूब न शकेम नगर को पिता हमोर को टुरावों सी एक सौ चांदी को सिक्का म ले लियो होतो; येकोलायी ऊ यूसुफ की सन्तान को निजी हिस्सा भय गयो।<verse eid="JOS 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 24:33" />हारून को टुरा एलीआजार भी मर गयो; अऊर ओख एप्रैम को पहाड़ी देश को गिबा नगर म माटी दी गयी, जो ओको टुरा पीनहास ख दियो गयो होतो।<verse eid="JOS 24:33" /></para>
  <chapter eid="JOS 24" />
</usx>