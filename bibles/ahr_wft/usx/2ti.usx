<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Ahirani</book>
  <para style="h">२ तिमथ्य</para>
  <para style="toc3">२ तिमथ्य</para>
  <para style="toc2">२ तिमथ्य</para>
  <para style="toc1">पौलनी लिखेल तिमथ्यले दुसरं पत्र</para>
  <para style="mt2">पौलाने लिहिलेले तिमथ्यले दुसरे पत्र</para>
  <para style="mt1">पौलनी लिखेल तिमथ्यले दुसरं पत्र</para>
  <para style="imt">वळख</para>
  <para style="ip">दुसरं तिमथ्यनं पुस्तक हाई एक पत्र शे जे प्रेषित पौलनी त्याना शिष्य तिमथ्यीले लिखेल शे, २ तिमथ्य हाई पौलना जिवनना अंत जोडे येल व्हता तवय लिखेल व्हतं. ते तवय लिखाई गय जवय पौल रोम सरकारना कैदमा व्हता<char style="xt"><ref loc="2TI 1:16">१:१६</ref></char>. पौलना तिमथ्यना संगे जोडेना संबंध व्हतात अनी त्यानी त्याले ह्यामा आपला पोऱ्या म्हणीसन हाई पत्र लिखेल शे. <char style="xt"><ref loc="PHP 2:22">फिलप्पै २:२२</ref>; <ref loc="1TI 1:2">१ तिमथ्य १:२</ref>; <ref loc="1TI 1:18">१:१८</ref></char></para>
  <para style="ip">हाई त्या चार पत्रसमाधला शे ज्यामा पौलनी एक मंडळीनाबद्दल नही तर व्यक्तीबद्दल लिखेल शे. दुसरा तीन पुस्तके ह्या १ तिमथ्यी, तितस, अनी फिलेमोन. २ तिमथ्यी तवय लिखाई गयतं जवय रोमी सरकारना येळले ख्रिस्ती लोकसना छळ व्हई राहींता. यानं हाई बी कारण शे की पौल कैदखानामा व्हता अनी तिमथ्यीले संकटसना सामना करना पडी राहींता, १ तिमथ्यना पत्रमा पौलनी खोटा शिक्षकसपाईन सावध ऱ्हावानी तिमथ्यीले चेतावणी देयल शे <char style="xt"><ref loc="1TI 1:16-18">१ तिमथ्य १:१६-१८</ref></char> आखो तो तिमथ्यीले अस बी सांगस की, पुढे येणारा काळ भलताच कठीण शे. <char style="xt"><ref loc="2TI 3:1">२ तिमथ्य ३:१</ref></char></para>
  <para style="iot">रूपरेषा</para>
  <para style="io1">१. पौल तिमथ्यीले नमस्कार करीसन सुरवात करस अनी त्याले प्रोत्साहन बी देस. <char style="ior"><ref loc="2TI 1:1-18">१:१-१८</ref></char></para>
  <para style="io1">२. मंग पौल तिमथ्यीले पुढे जावाकरता आव्हान करस. <char style="ior"><ref loc="2TI 2:1-13">२:१-१३</ref></char></para>
  <para style="io1">३. पुढे पौलनी तिमथ्यीले काही सामान्य सुचना देस. <char style="ior"><ref loc="2TI 2:14-26">२:१४-२६</ref> </char></para>
  <para style="io1">४. मंग तो त्याले भविष्यमातील घटना अनी योग्य रिततीन प्रतिक्रिया देवाबद्दल चेतावणी देस. <char style="ior"><ref loc="2TI 3:1-4:8">३:१–४:८</ref></char></para>
  <para style="io1">५. पौल तिमथ्यीले काही वयक्तीक सुचना दिसन पत्रनी समाप्ती करस. <char style="ior"><ref loc="2TI 4:9-22">४:९-२२</ref></char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />ख्रिस्त येशुमा जे जिवन शे त्यानाबद्दल देयल वचनना प्रचार कराकरता, देवनी ईच्छातीन धाडेल, ख्रिस्त येशुना प्रेषित पौल ह्याना कडतीन, <verse eid="2TI 1:1" /><verse number="2" style="v" sid="2TI 1:2" /><note caller="+" style="x"><char style="xo" closed="false">१:२ </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेषित १६:१</ref></char></note>प्रिय पोऱ्या तीमथ्य याले, देवपिता अनं ख्रिस्त येशु आपला प्रभु यासना पाईन कृपा, दया, अनं शांती राहो.<verse eid="2TI 1:2" /></para>
  <para style="s">धन्यवाद अनी प्रोत्साहन</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />ज्या देवनी मना पुर्वजसंपाईन चालत येल सेवा, मी शुध्द विवेक भावतिन करस त्याना मी उपकार मानस, मी मनी प्रार्थनामा रातदिन तुनी आठवण करस. <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />अनी तुना अश्रु मनमा लईसन तुले भेटानी भलतीच ईच्छा बाळगस, तुनामा जे निष्कपट ईश्वासनी माले आठवण व्हईसन तुले भेटिसन आनंदीत व्हवाले पाहिजे. <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" /><note caller="+" style="x"><char style="xo" closed="false">१:५ </char><char style="xt" closed="false"><ref loc="ACT 16:1">प्रेषित १६:१</ref></char></note>तो ईश्वास पहिलींदाव तुनी आजी लुईस इनामा व्हता, तुनी माय युनीके इनामा व्हता, अनी तोच ईश्वास तुनामा शे अशी माले खात्री शे. <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />यानामुये मी तुले आठवण करी देस की, देवनं जे कृपादान मना हात तुनावर ठेवामुये देवनी तुले दिधं. <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />कारण देवनी आपलाले भित्रापणना नही, तर सामर्थ्याना, प्रितीना अनं स्वतःवर ताबा ठेवाना आत्मा देयल शे.<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />यामुये आपला प्रभुबद्दलन्या साक्षनी अनी मी जो त्याना बंदिवान, मनी बी लाज धरू नको तर देवना सामर्थ्यना परिणामतीन सुवार्ताकरता मनासंगे तु बी दुःख भोग. <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />त्यानी आमना कामसप्रमाणे नही तर स्वतःना संकल्पानामायक अनी कृपानामायक आमले तारेल अनं पवित्र पाचारणतीन पाचारण करेल शे, हाई कृपा युगानुयुगना काळना पहिले ख्रिस्त येशु कडतीन आपलावर करामा येल शे; <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />ती आते आपला तारणारा ख्रिस्त येशु ह्याना प्रकट व्हवामुये प्रकाशमान व्हयेल शे, त्यानी मरणले मिटाडी टाकं अनी सुवार्ताना द्वारा सार्वकालिक जिवन अनी अविनाशिता प्रकाशित करेल शे.<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:११ </char>
      <char style="xt" closed="false">
        <ref loc="1TI 2:7">१ तिमथ्य २:७</ref>
      </char>
    </note>माले देवना सुवार्तानी घोषणा देणारा प्रेषित अनी शिक्षक अस नेमेल शे. <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />ह्या कारणमुये मी ह्या दुःख भोगी ऱ्हाइनु तरी मी लाज धरस नही कारण मी ज्यानावर ईश्वास ठेयेल शे, त्याले मी वळखस, तो मनी ठेव<note caller="+" style="f"><char style="fr" closed="false">1:12 </char><char style="fq" closed="false">ठेव </char><char style="ft" closed="false">शुभवर्तमाननं ज्ञान</char></note> त्या दिनकरता राखाले शक्तिमान शे, असा मना भरवसा शे, <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />ज्या सुवचनसना नमुना तु मनाकडतीन ऐकी लिधा तो ख्रिस्त येशुमा, सुशिक्षण, तुना ईश्वास अनी प्रिती यासमा दृढपणतीन राख. <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />आपलामा राहणारा पवित्र आत्माना योगतीन चांगल्या गोष्टी संभाळीसन ठेव.<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />ज्या आशिया प्रांतमा शेतस त्या मनापाईन फुटेल शेतस, हाई तुले माहितच शे, त्यासमा फुगल अनी हर्मजनेस शे. <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />अनेसिफराना घरवर प्रभु दया करो, कारण त्यानी कायम मनं समाधान करेल शे, अनी मना बेडिनी लाज त्याले वाटनी नही. <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />तर तो रोम शहरमा व्हता तवय त्यानी मेहनत करीसन मी सापडस तोपावत मना शोध करा. <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />प्रभु करो अनी त्या दिनले त्याले प्रभुनी दया मिळो अनी इफिसमा कितलातरी प्रकारमा त्यानी सेवा करी हाई तर तुले चांगलच माहित शे.<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">येशु ख्रिस्तना खरा सैनिक</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />मना पोऱ्या, प्रभु येशु ख्रिस्तमा जी कृपाद्वारा जी एकता आपलामा शे, त्यामा बलवान व्हत जा. <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />जी शिकवण मना साक्षीदारस समोर मनापाईन ऐकी ती त्या असा ईश्वासु माणससले सोपी दे ज्या दुसरासले शिकाडाकरता योग्य शे.<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />ख्रिस्त येशुना चांगला शिपाई ह्या नातातीन मनासंगे दुःख भोग. <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />जो माणुस शिपाई ऱ्हास, तो संसारना कामसमा अडकस नही ह्यानाकरता की ज्यानी त्याले सैन्यमा भरती करी लियेल शे. त्याले त्यानी संतुष्ट करानं. <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />जर कोणी शर्यतमा पळस तर तो नियमप्रमाणे करस नही तर त्याले बक्षिस भेटस नही. <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />श्रम करनारा शेतकरीनी पहिले पिकना वाटा लेवानं योग्य शे. <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />जे मी बोलस ते समजिले, कारण प्रभु तुले सर्व गोष्टी समजाडी दी.<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />हाई मनी सुवार्तानामायक मरेल मातीन ऊठाडेल येशु ख्रिस्त, जो दावीदना वंशमातील शे ह्यानी आठवण ठेव. <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />ह्या सुवार्तामुये मी दुष्कर्म करनारासना मायक बेड्यासनं बी दुःख भोगी ऱ्हायनु तरी देवना वचनले बेडी पडेल नही. <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />ह्यामुये मी निवडेल लोकसले बी ख्रिस्त येशुमातील तारण युगानुयुग गौरव प्राप्त व्हवाले पाहिजे म्हणीसन मी त्यानाकरता सर्वकाही धीरतीन सहन करस. <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />हाई वचन ईश्वसनीय शे की, आपण त्यानासंगे मरणुत तर त्यानासंगे जिवत बी ऱ्हासुत. <verse eid="2TI 2:11" /><verse number="12" style="v" sid="2TI 2:12" /><note caller="+" style="x"><char style="xo" closed="false">२:१२ </char><char style="xt" closed="false"><ref loc="MAT 10:33">मत्तय १०:३३</ref>; <ref loc="LUK 12:9">लूक १२:९</ref></char></note>जर आपण धीरतीन सहन करसु तर त्यानासंगे राज्य बी करसुत. आपण त्याले नकारसुत तर तो बी आपले नाकारी. <verse eid="2TI 2:12" /><verse number="13" style="v" sid="2TI 2:13" />जरी आपण अईश्वासी व्हयनुत, तरी तो ईश्वासनीय ऱ्हास कारण त्याले स्वतःविरुध्द वागता येस नही.<verse eid="2TI 2:13" /></para>
  <para style="s">उत्तम कामगार</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />तु ह्या गोष्टीसनी त्याले याद करी दे, त्यासले प्रभुसमोर ताकिद दिसन सांग की, शब्द युध्द करानं नही. ते कसाना बी उपयोगमा नही पडतस ऐकनारासना नाशना कारण व्हतस. <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />तु सत्यनं वचन निट सांगनारा, लाज वाटेल अस कोणतं बी काम न करनारा, देवना पसंतिले उतरेल कामकरी, असा स्वतःले सादर कराकरता व्हई तितलं कर. <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />अनितीना रिकामी कटकट पाईन दुर ऱ्हाय असा कटकट करनारा अभक्तिमा जास्त वढाई जातीन. <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />अनी ज्यानं शिक्षण उघडी जखमंना मायक व्हई, त्याना मायक हुमनाय अनी फिलेत ह्या शेतस. <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />त्या सत्यना विषयी चुकी जायेल शेतस, पुनरूत्थान व्हई जायेल शे अस त्या म्हणतस अनी कित्येकसना ईश्वासना त्या नाश करतस. <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />तर देवनी घालेल स्थिर पाया टिकिसन ऱ्हास त्यावर हाऊ शिक्का मारेल शे, प्रभु आपला ज्या शेतस त्यासले वळखस, अनी जो कोणी प्रभुन नाव लेस तो अनितीपाईन वाची ऱ्हास. <verse eid="2TI 2:19" /><verse number="20" style="v" sid="2TI 2:20" />मोठा घरसमा फक्त सोनाना अनी चांदिना भांडा राहतस अस नही, तर लाकुडना अनी मातिना बी ऱ्हातस, तर त्यासना माधलं कित्येक चांगला कार्यसमा उपयोग करतस, तर काही फक्त कार्यकरता व्हस. <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />म्हणीसन जर कोणी त्यानापाईन दुर ऱ्हाइसन स्वतःले शुध्द करस तर तो पवित्र करेल स्वामीले उपयोगमा पडनारा, प्रत्येक चांगला कामले उपयोगमा पडनारा मानपाननं भांडं व्हई. <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />तरूणपणना वासनासपाईन दुर पय, अनी शुध्द मनतिन प्रभुना नाव लेनाराससंगे नितिमत्व, ईश्वास, प्रिती, शांती, ह्यासना मांगे लाग. <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />मुर्खपणन्या अनी अज्ञानसना वादन्या गोष्टीसपाईन दुर ऱ्हाय, कारण त्यासपाईन भांडणं तयार व्हतस हाई तुले माहित शे. <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />प्रभुना दासनी भांडण नही, तर त्यानी सर्वासनासंगे नम्रमा, सहनशीलतामा अनं शिकाडाकरता तयार रावाले पाहिजे. <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />विरोध करनारासले नम्रतातीन शिकाडनारा असा ऱ्हावाले पाहिजे. कदाचित देव त्यासले सत्यनं ज्ञान व्हवाले पश्चतापनी बुध्दी दी <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />अनी सैताननी त्यासले धरीन ठेवानंतर त्या त्यानापाईन सुटीसन देवनी ईच्छा पुरी कराले शुध्दीमा येतीन.<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">शेवटला दिन</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />हाई समजी ले, शेवटला काळमा कठीण दिन येतीन, <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />कारण माणुस स्वार्थी, पैसासना लोभ धरनारा, बडाईखोर, गर्विष्ट, निंदा करनारा, माय बापले नही माननारा, उपकारसले नही जाणनारा, अपवित्र, <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />ममताहिन, क्षमा नही करनारा, चुगलखोर, असंयमी, क्रुर, चांगलास बद्दल प्रेम नही करनारा <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />ईश्वासघात करनारा, गर्वतिन फुगेल, देववर प्रेम करापेक्षा सुखविलासनी आवड करनारा <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />सुभक्तीनं बाहेरनं रूप दखाडीसन तिना स्वतःवर संस्कार नही असा लोकसपाईन बी दुर रहा. <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />त्यानामातिन असा काही लोके शेतस की ज्या घरमा बागेच घुशीसन पापदोषतीन भरेल अनेक प्रकारना वासनानी बहकेल, <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />असा भोळ्या बायासले कायम शिकतस पण सत्यना ज्ञानले कधीच समजु शकस नही. <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />यान्नेस अनी याब्रेस यासनी जसं मोशेले आडावं तसा ह्या माणसे सत्यले आडावतस, ह्या लोके भ्रष्ट बुध्दी व्हयेल अनी ईश्वासबद्दल अपयशी व्हयेल असा त्या शेतस. <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />तरी बी त्या यानापुढे जावु शकावुत नही. कारण जसं त्यासनं मुर्खपण उघड व्हयेल शे. तसं यान्नेस अनी याब्रेस यासनासंगे बी व्हयनं.<verse eid="2TI 3:9" /></para>
  <para style="s">शेवटनी सुचना</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />तु मना शिक्षणना आचरण, संकल्प, ईश्वास, सहनशीलता, प्रिती, धीर, मना व्हयेल छळ, मनावर येल संकट हाई वळखीन शे. <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" /><note caller="+" style="x"><char style="xo" closed="false">३:११ </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">प्रेषित १३:१४-५२</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:1-7">प्रेषित १४:१-७</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:8-20">प्रेषित १४:८-२०</ref></char></note>माले अंत्युखियामा, इकुनियोमा, अनी लुस्त्रात, जे काही व्हयनं अनी मी जो छळ सहन करा ते तु वळखीन शे, त्या सर्वासमातिन माले प्रभुनी सोडायेल शे. <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />ख्रिस्त येशुमा सु-भक्तीतीन आयुष्यक्रम कराले ज्या दखतस, त्या सर्वासना छळ व्हई; <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />अनी दुष्ट, भोंदु मनुष्य, ह्या दुसरासले फसाडिसन अनी स्वतः फशीसन दुष्टपणमा जास्तीच बिघडी जातीन. <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />तु तर ज्या सत्य गोष्टी शिकनास अनी ज्याबद्दल तुनी खात्री व्हयेल शे. ते धरीन ऱ्हाय अनी ते कोणापाईन शिकना <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />अनी धाकलपण पाईन तुले पवित्र शास्त्रनी माहीती शे, हाई माले माहित शे. ते ख्रिस्त येशु मातला ईश्वासनाद्वारा तुले तारणकरता ज्ञानी कराकरता समर्थ शे. <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />प्रत्येक ईश्वरप्रेरित शास्त्रलेख सदबोध, दोष दखडानं, सुधारनुक, नितीशिक्षण, ह्यानाकरता उपयोगी शे. <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />ह्यानाकरता की देवना भक्त पुरा व्हईसन प्रत्येक चांगला कामकरता तयार व्हवा.<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />देव अनी ख्रिस्त येशुना समोर जो जिवतसना, अनी मरेलसना न्याय करी अनी राजा बनीसन राज्य कराले ई त्याले साक्षी मानीसन मी ईनंती करस. <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />तु वचनसनी घोषणा कर, सुवेळी, अवेळी तयार ऱ्हाय सर्व प्रकारना सहनशीलतातीन अनी शिक्षणना दोष दखाडीन निषेध कर अनी बोध कर. <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />कारण अशी येळ येवावं शे की, जवय लोके उपदेश ऐकी लेनार नही, तर आपला कानसले जे आवडस ते पाहिजे म्हणीसन त्या स्वतःना ईच्छातीन आपलाकरता बराच शिक्षकसले गोया करतीन. <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />अनी त्या आपला कान सत्यपाईन फिरावतीन अनी काल्पनिक गोष्टीसकडे लावतीन. <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />तु तर सर्व गोष्टीसबद्दल आत्मनियंत्रण ठेव. दुःख सहन कर, सुर्वार्तीकनं काम कर, अनी तुले सोपेल सेवा पुरी कर.<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />कारण आते मनं अर्पण कराना अनी जावाना काळ जोडे येल शे. <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />जे सुयुध्द मी करेल शे, पळनं संपाडेल शे, ईश्वास राखी ठेयल शे, <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />आते राहेल हाईच शे की, मनाकरता नितिमत्वना मुकुट ठेयेल शे, प्रभु जो नितिमान न्यायाधीश शे. तो त्या दिन माले तो मुकुट दी. अनी तो मालेच नही तर, त्यानं प्रकट व्हवानं ज्याले प्रिय व्हयेल शे, त्या सर्वासले बी दी.<verse eid="2TI 4:8" /></para>
  <para style="s">व्यक्तीगत सुचना</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />तु व्हई तितलं करीसन मनाकडे लवकर ये. <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" /><note caller="+" style="x"><char style="xo" closed="false">४:१० </char><char style="xt" closed="false"><ref loc="COL 4:14">कलस्सै ४:१४</ref>; <ref loc="PHM 1:24">फिलेमोनले पत्र १:२४</ref>; </char><char style="xt" closed="false"><ref loc="2CO 8:23">२ करिंथ ८:२३</ref>; <ref loc="GAL 2:3">गलती २:३</ref>; <ref loc="TIT 1:4">तिताले पत्र १:४</ref></char></note>कारण देमासले एहिक सुखप्रिय ऱ्हावामुये तो माले सोडिसन थेस्सलनीकरासले गया त्रेस्केस गलतीयास अनी तिता दालमतियाले गया. <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" /><note caller="+" style="x"><char style="xo" closed="false">४:११ </char><char style="xt" closed="false"><ref loc="COL 4:14">कलस्सै ४:१४</ref>; <ref loc="PHM 1:24">फिलेमोनले पत्र १:२४</ref>; </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेषित १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref>; <ref loc="COL 4:10">कलस्सै ४:१०</ref>; <ref loc="PHM 1:24">फिलेमोनले पत्र १:२४</ref></char></note>पण लूक मनाजोडे शे, मार्कले आपलासंगे लई ये, कारण तो सेवा कराले माले उपयोगी शे. <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" /><note caller="+" style="x"><char style="xo" closed="false">४:१२ </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेषित २०:४</ref>; <ref loc="EPH 6:21">इफिस ६:२१</ref>,<ref loc="EPH 6:22">२२</ref>; <ref loc="COL 4:7">कलस्सै ४:७</ref>,<ref loc="COL 4:8">८</ref></char></note>तुखिकाले मी इफिससले धाडेल शे. <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" /><note caller="+" style="x"><char style="xo" closed="false">४:१३ </char><char style="xt" closed="false"><ref loc="ACT 20:6">प्रेषित २०:६</ref></char></note>मना झगा त्रोवासामा कार्पाजोडे ऱ्हायेल शे, तो येवाना येळले लई ये. अनी पुस्तकं, विशेष करीसन चर्मपत्र बी लई ये. <figure style="fig" alt="Scrolls standing by ink well" file="hk००१५३c.tif" size="col" copy="Horace Knowles ©" ref="४:१३">चांगली शाईघाई लिखेल उभ्या गुंडाळ्या</figure><verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१४ </char>
      <char style="xt" closed="false">
        <ref loc="1TI 1:20">१ तिमथ्य १:२०</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ROM 2:6">रोम २:६</ref>
      </char>
    </note>आलेक्सांद्र लोहारनी मनं बरच वाईट करेल शे, त्यानी फेड त्याना कामप्रमानेच प्रभु करी. <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />त्यानाबद्दलमा तु बी जपीन ऱ्हाय, कारण तो आमना बोलनाले बराच आड येल व्हता.<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />मना पहिला जबाबना येळले मना बाजुले कोणीच नव्हतं, सर्वासनी माले सोडी देयल व्हतं, यानाबद्दल त्यासना हिशोब लेवामा नही येवो. <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />तरी प्रभु मनाजोडे उभा ऱ्हायना, मनाकडतीन घोषणा पुरी व्हवाले पाहिजे, अनी सर्व गैरयहूदीसनी ऐकाले पाहिजे म्हणीसन त्यानी माले शक्ती दिधी, अनी त्यानी माले सिंहना जबडामातीन<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="fq" closed="false">सिंहना जबडामातीन </char><char style="ft" closed="false">मरणदंडनी शिक्षातीन</char></note> सोडावं, <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />प्रभु माले सर्व दुष्ट योजनामातीन माले सोडाई, अनी आपला स्वर्गना राज्यमा सुखरूप लई ई, त्याले युगानुयुग गौरव असो, आमेन.<verse eid="2TI 4:18" /></para>
  <para style="s">अंतिम निवेदन</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१९ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">प्रेषित १८:२</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="2TI 1:16">२ तिमथ्य १:१६</ref>,<ref loc="2TI 1:17">१७</ref></char>
    </note>प्रिस्किल्ला, अक्विला अनी अनेसिफना घरना लोकसले सलाम सांग, <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" /><note caller="+" style="x"><char style="xo" closed="false">४:२० </char><char style="xt" closed="false"><ref loc="ACT 19:22">प्रेषित १९:२२</ref>; <ref loc="ROM 16:23">रोम १६:२३</ref>; </char><char style="xt" closed="false"><ref loc="ACT 20:4">प्रेषित २०:४</ref>; <ref loc="ACT 21:29">२१:२९</ref></char></note>एरास्त करिंथमा ऱ्हायना, त्रफिम आजारी पडना, त्याले मिलेतामा ठी वनु. <verse eid="2TI 4:20" /><verse number="21" style="v" sid="2TI 4:21" />व्हई तितलं करीसन हिवाळाना पहिले ये, युबु अनी पुदेस, लिन, अनी क्लौदिया अनी सर्व भाऊ तुले सलाम सांगतस. <verse eid="2TI 4:21" /><verse number="22" style="v" sid="2TI 4:22" />प्रभु तुना आत्मासंगे ऱ्हाई, देवनी कृपा तुमनासंगे ऱ्हावो.<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>