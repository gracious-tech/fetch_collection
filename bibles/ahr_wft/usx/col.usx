<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Ahirani</book>
  <para style="h">कलस्सै</para>
  <para style="toc3">कलस्सै</para>
  <para style="toc2">कलस्सै</para>
  <para style="toc1">पौलनी लिखेल कलस्सैकरसले पत्र</para>
  <para style="mt2">पौलाने लिहलेले कलस्सैकरास पत्र</para>
  <para style="mt1">पौलनी लिखेल कलस्सैकरसले पत्र</para>
  <para style="imt">वळख</para>
  <para style="ip">कलस्सैकरास पत्र प्रेषित<char style="xt"><ref loc="COL 1:1">1:1</ref></char> पौलनाद्वारा मंडळीले लिखामा येल व्हतं. त्यानी हाई पत्र त्या येळले लिखं जवय तो कैदमा व्हता, कदाचित रोममा ख्रिस्तना जन्मना लगभग ६० वरीस नंतर कलस्सैकरास, इफिसकरास, अनी फिलेमोन ह्या पत्र पौलनी कैदमा व्हता त्या येळले लिखं व्हतं त्यामुये त्यासले कैदी पत्र म्हणतस.</para>
  <para style="ip">त्यानी हाई पत्र कोलोसे शहरमा मंडळीले लिखेल व्हतं. पौलनी कलस्सैमा मंडळी सुरू करी नही, कारण<char style="xt"><ref loc="COL 2:1">२:१</ref></char> मा उल्लेख करेल शे, पण याकरता जिम्मेदारी ठरायेल व्हती की, हाई आवश्यक शे की, एपाफ्रासनी मंडळीनी स्थापना करी कारण त्या कोलोसेमाधला व्हतात. पौलनी कोलोसेना मंडळीमा काही वाईट शिक्षणाबद्ल आधारीत व्हता. त्यानी यानाबद्ल पत्र लिखाकरता बराच खर्चा करा, अस बी राहु शकस की, ख्रिस्ती यहूदीसना एक समुदाय व्हई, जो जुना नियमसले यहूदी कायदाना पालन कराकरता अनं ख्रिस्ती यहूदी भाऊसले जबरदस्ती कराना प्रयत्न करी ऱ्हाईंतात, विशेष रूपतीन सुंता. पौलनी विशेष रूपतीन लिखस की, ख्रिस्तले देवनाद्वारा<char style="xt"><ref loc="COL 1:15-20">१:१५-२०</ref></char> स्विकार कराशिवाय ख्रिस्तनाशिवाय काहीच नही तर कोणी तरी गरज शे अनी मनुष्य तर्कवर आधारीन शिक्षण बेकार शे. <char style="xt"><ref loc="COL 2:8">२:८</ref></char></para>
  <para style="iot">रूपरेषा</para>
  <para style="io">१. पौल कलस्सैमा मंडळीले नमस्कार करीसन पत्रले सुरवात करस. <char style="ior"><ref loc="COL 1:1-2">१:१-२</ref></char></para>
  <para style="io">२. परत तो ख्रिस्तना महानताबद्दल लिखस, विशेष रूपतीन कलस्सैमा देयल खोटा शिक्षणना विरूध्द लिखस. <char style="ior"><ref loc="COL 1:3-3:4">१:३–३:४</ref></char></para>
  <para style="io">३. पौल त्याना बराच पत्रसना मध्यभागमा, चांगलं ख्रिस्ती जिवन कसं जगानं यानी तो सुचना देस. <char style="ior"><ref loc="COL 3:5-4:6">३:५–४:६</ref></char></para>
  <para style="io">४. पौलनी बाकीना मंडळीसमा मोठा आवाजमा वाचामा येणारा पत्रकरता शुभेच्छा अनी सुचना देस. <char style="ior"><ref loc="COL 4:7-18">४:७-१८</ref></char></para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />देवना ईच्छातीन ख्रिस्त येशुना प्रेषित मी पौल अनं आपला बंधु तीमथ्य याना कडतीन;<verse eid="COL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2" />कलस्सै माधला देवना जणसले अनं ईश्वास ठेवराना बंधुजनसले ज्या ख्रिस्तमा एक शेतस;</para>
  <para style="p" vid="COL 1:2">देव आपला पिता यानापाईन तुमले कृपा अनं शांती भेटत राहो.<verse eid="COL 1:2" /></para>
  <para style="s">धन्यवादनी प्रार्थना</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />आम्हीन जवय तुमनाकरता प्रार्थना करतस, तवय आम्हीन जो आपला प्रभु येशु ख्रिस्तना पिता शे, त्याना कायम उपकार मानतस. <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />कारण आम्हीन येशु ख्रिस्तवर तुमना ईश्वासबद्दल अनी देवना सर्व लोकसविषयी तुमले वाटस त्या प्रितीबद्दल ऐकेल शे. <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />हाई आशाबद्दल तुम्हीन सुवार्ताना सत्यवचनमा सुरवातले ऐकेल शे. म्हणीसन तुमना ईश्वास अनी प्रेम त्या गोष्टीसवर आधारीत शे, ज्याकरता तुमले आशा शे, ती आशा स्वर्गमा तुमनाकरता सुरक्षित ठेयेल शे. <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />जी सुवार्ता तुमना जोडे येल शे, सर्व जगमाईन त्या सुवार्ताना आशिर्वाद भेटी राहिना शे अनं तो वाढी राहीना शे, जसं ती तुमनामा त्या दिनपाईन शे, जवय तुम्हीन पहिलादावं देवना कृपाबद्दल ऐका अनं तिनाबद्दल खरच समजी लिधं तवयपाईन ती कार्य करी राहिनी शे. <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" /><note caller="+" style="x"><char style="xo" closed="false">१:७ </char><char style="xt" closed="false"><ref loc="COL 4:12">कलस्सै ४:१२</ref>; <ref loc="PHM 1:23">फिलेमोनले पत्र १:२३</ref></char></note>एपफ्रास आमना सोबतना प्रिय दास, तुमना कडतीन ख्रिस्तना ईश्वासु सेवक, त्यानापाईन तुम्हीन ती कृपा असच शिकनात. <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />त्यानी आमले तुमनी प्रिती आत्मानापाईन शे त्यानाविषयी सांगं.<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />यावरीन आम्हीन बी तुमना विषयी ज्या दिनपाईन ऐकं, तवयपाईन तुमनाकरता कायम प्रार्थना करेल शे. आम्हीन प्रार्थना करी राहिनुत की, तुम्हीन देवना ईच्छातीन सर्व प्रकारना ज्ञानतीन भराले पाहिजे जो त्याना आत्मा तुमले देस, अनी त्याना ईच्छातीन आध्यात्मिक समजपणतीन तुम्हीन भराले पाहिजे. <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />यानाकरता की, तुम्हीन सर्व प्रकारे प्रभुले संतुष्ट कराकरता त्याले शोभी अस वागाले पाहिजे, म्हणजे प्रत्येक प्रकारना सत्कर्मना फळ दिसन अनी देवना ज्ञानमा तुमनी वाढ व्हवाले पाहिजे. <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />सर्व प्रकारनी सहनशीलता अनं धीर हाई तुमले प्राप्त व्हवाले पाहिजे म्हणीन त्याना गौरवी सामर्थ्यमा तुम्हीन सर्व प्रकारना सामर्थ्यतीन मजबुत व्हवाले पाहिजे; <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />अनी आनंदमा परमपिताले धन्यवाद देवानं, ज्यानी तुमले प्रकाशमा राहनारा देवना लोकसना जे वतन शे, त्यामा वाटा भेटाकरता पात्र करेल शे. <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />देवनी आपलाले आंधरनी शक्तीपाईन सुटका करीसन अनी त्याना प्रिय पोऱ्याना राज्यमा सुरक्षित आणेल शे. <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" /><note caller="+" style="x"><char style="xo" closed="false">१:१४ </char><char style="xt" closed="false"><ref loc="EPH 1:7">इफिस १:७</ref></char></note>त्या पोऱ्याना ठायी आपलाले मुक्ती म्हणजे आपला पापनी क्षमा व्हयेल शे.<verse eid="COL 1:14" /></para>
  <para style="s">ख्रिस्तनं कामं</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />ख्रिस्त दृश्य रूपमा अदुश्य देवनी प्रतिमा शे; अनी निर्माण करेल सर्व गोष्टीसमा तो पहिला जन्मेल पोऱ्या शे. <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />कारण स्वर्गामा अनी पृथ्वीमा सर्वकाही त्याना सामर्थ्यमा निर्माण कराई गयं. जे काही दृश्य, अदुश्य शे, सिंहासन राहोत, किंवा सामर्थ्य राहो, सत्ताधीश राहोत किंवा अधिपती राहोत सर्वकाही त्यानामा अनं त्यानाकरता निर्माण कराई गयं. <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />ख्रिस्त सर्व गोष्टी निर्माण होवाना पहिलाना तो अस्तित्वमा व्हता अनं त्यानी एकतामा सर्व गोष्टी आपला जागी स्थिर शेतस. <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" /><note caller="+" style="x"><char style="xo" closed="false">१:१८ </char><char style="xt" closed="false"><ref loc="EPH 1:22">इफिस १:२२</ref>,<ref loc="EPH 1:23">२३</ref></char></note>अनी तोच शरिरना म्हणजे मंडळीना मस्तक शे; तो प्रारंभ शे, मरेलमाईन पुनरूत्थान व्हयेलसमा पहिले जन्मेल तोच शे, यानाकरता की, प्रत्येक गोष्टमा त्याले प्रथम स्थान भेटाले पाहिजे. <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />देव प्रसन्न व्हता कारण देवनी सर्व परिपुर्णता त्यानामा ऱ्हावाले पाहिजे. <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" /><note caller="+" style="x"><char style="xo" closed="false">१:२० </char><char style="xt" closed="false"><ref loc="EPH 2:16">इफिस २:१६</ref></char></note>अनी पोऱ्याद्वारा सर्व गोष्टीसना स्वतःकरता म्हणजे त्या पृथ्वीवरन्या गोष्टी राहोत, किंवा स्वर्गमाधल्या गोष्टी राहोत समेट कराना देवले बरं वाटनं, ख्रिस्तनी जे रक्त क्रुसखांबवर ओतं त्यानाद्वारा देवनी शांती करी. <verse eid="COL 1:20" /><verse number="21" style="v" sid="COL 1:21" />एक काळ व्हता जवय तुम्हीन दुष्कर्म करीसन मनतीन परका अनं वैरी असा देवकरता व्हतात. <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />पण आते, आपला पोऱ्याना शारीरिक देहना त्याना मरणघाई देवनी तुमना त्यानासंगे समेट घडाई देयल शे, यानाकरता की, त्याना समोर पवित्र, निष्कलंक अनी निर्दोष अस उभा ऱ्हावाले पाहिजे. <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />जर तुम्हीन ईश्वासमा दृढ अनं स्थिर रावाले पाहिजे अनी जी सुवार्ता तुम्हीन ऐकी, आकाशखालना सर्व सृष्टीमा जिनी घोषणा व्हयनी अनं जिना मी पौल सेवक व्हयनु शे, ती आशापाईन तुम्हीन ढळशात नही तर हाई व्हई.<verse eid="COL 1:23" /></para>
  <para style="s">मंडळीमा पौलनं सेवकप्रमाणे काम</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />आते तुमनाकरता जे दुःख माले व्हयनात त्यामा माले आनंद वाटस, अनी ख्रिस्तना दुःख माईन जे उरेल शे ते मी आपला शारीरतिन, त्यानं शरीर जी मंडळी तिनाकरता भरी काढस. <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />देवनं वचननी पुर्ण घोषणा करनारा जो कारभार माले तुमना चांगलाकरता सोपी देयल शे, त्यानाप्रमानतीन मी त्या मंडळीना सेवक व्हयनु शे. <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />हाऊ संदेश रहस्यपुर्ण शे जो युगानुयुग पिढ्यानपाईन गुप्त ठेयेल व्हता, पण आते देवनी त्याना लोकसले प्रकट करी देयेल शे. <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />गैरयहूदीसमा त्या रहस्यना गौरवनी संपत्ती काय शे हाई त्या लोकसले माहिती करी देवानं देवले चांगलं वाटनं; गौरवनी आशा असा जो ख्रिस्त तुमनामा शे तोच रहस्य शे. <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />आम्हीन ख्रिस्तनी घोषणा करस. प्रत्येक मनुष्यले सुचना देतस, अनं प्रत्येक मनुष्यले शक्य तेवढं ज्ञानतीन शिकाडाना प्रयत्न करतस यानाकरता की, आमले प्रत्येक मनुष्य ख्रिस्तमा एक असा परिपुर्ण देवले सादर करता येवाले पाहिजे. <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />हाई पुरा कराकरता ख्रिस्तनी जी महान शक्ती मनाठायी जोरमा कार्य करस तिना योगे मी झटीसन श्रम करी ऱ्हायनु.<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />तुमनाकरता, लावदिकीया माधला लोकेसकरता, अनं ज्या इतरासंगे मनी प्रत्यक्ष भेट व्हयनी नही त्या सर्वासना करता, मी कितलं परीश्रम करी राहीनु हाई तुम्हीन समजी लेवाले पाहिजे अशी मनी ईच्छा शे. <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />यानाकरता की, त्यासनं मन प्रोत्साहनघाई भराले पाहिजे, अनी त्या प्रितीमा एकमेकसंगे बांधाई जावाले पाहिजे, अनी खात्रीनी ईश्वासनी सगळी संपत्ती जी समजबुध्दीतीन येस ती भेटाले पाहिजे, तसच देवनं रहस्य जो ख्रिस्त शे त्यानाविषयी पुर्णज्ञान भेटाले पाहिजे. <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />त्यामा देवना ज्ञान अनं बुध्दीनी सर्वी संपत्ती लपेल शे.<verse eid="COL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4" />फसडणारा भाषण दिसन कोणी तुमले फसाडाले नको तर त्या कितला चांगला का ऱ्हायेना म्हणीन हाई सांगस; <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />कारण मी जरी शरीरतिन तुमनापाईन दुर राहिनु, तरी बी आत्मामा मी तुमनासोबत शे, अनी तुमना जिवनमाधलं नीटनेटकपणा अनी ख्रिस्तवरला तुमना ईश्वासना खंबीरता दखीसन मी आनंदमा शे.<verse eid="COL 2:5" /></para>
  <para style="s">ख्रिस्तमा जिवननी पुर्णता</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />म्हणीन ख्रिस्त येशु जो प्रभु, याले जसं तुम्हीन स्विकारं तसं त्यानामा एक व्हईसन ऱ्हावा. <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />ख्रिस्तमा मुळाई जायेल, त्यानावर उभा कराई जायेल, तुमले शिकाडेल प्रमाने ईश्वासमा दृढ व्हयेल असं देवनी स्तुती करनारा व्हा. <verse eid="COL 2:7" /><verse number="8" style="v" sid="COL 2:8" />ख्रिस्तप्रमाने नही, तर मनुष्यसना संप्रदायप्रमाणे, जगना प्राथमिक शिक्षणा प्रमाने ऱ्हायेल ज्ञान अनं पोकळ भुलथापा यासनाघाई फसाडीन कोणी तुमले दास बनाडाले नको म्हणीन सावध ऱ्हावा; <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />कारण दैवीपननी सर्व पुर्णता शरिरधारी व्हईन ख्रिस्तमा वसस. <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />अनी जो सर्व प्रत्येक सत्ताना अनं अधिकारीसना मस्तक शे, ख्रिस्तमा एक व्हईसन तुमले पुर्ण जिवन भेटेल शे. <verse eid="COL 2:10" /><verse number="11" style="v" sid="COL 2:11" />त्यानामा तुमनं देहस्वभावरूप शरीर काढी टाकावर जे ख्रिस्तनं सुंता, म्हणजे हातघाई नही व्हयेल सुंता, ती व्हयनी शे. <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" /><note caller="+" style="x"><char style="xo" closed="false">२:१२ </char><char style="xt" closed="false"><ref loc="ROM 6:4">रोम ६:४</ref></char></note>तुमना बाप्तिस्मा व्हयनं तवय तुम्हीन त्यानासोबत पुराई गयात, अनी ज्यानी त्याले मरेलमाईन ऊठाडं त्या देवनं कृत्यवरीन ईश्वासनाद्वारा त्यानासोबत ऊठाडामा वनात. <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" /><note caller="+" style="x"><char style="xo" closed="false">२:१३ </char><char style="xt" closed="false"><ref loc="EPH 2:1-5">इफिस २:१-५</ref></char></note>जवय तुम्हीन आपला पापसघाई, गैरयहूदी अनी नियमशास्त्र नसेल असा मरेल व्हतात, पण देवनी ख्रिस्तनासोबत तुमले जिवन दिधं अनी आपला सर्व पापसनी क्षमा करी. <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" /><note caller="+" style="x"><char style="xo" closed="false">२:१४ </char><char style="xt" closed="false"><ref loc="EPH 2:15">इफिस २:१५</ref></char></note>त्यानी आमनाविरुध्द् ऱ्हायेल विधीना आरोपपत्रमा ज्यामा आमले विरोध व्हता, तो त्यानी आमनातीन काढी टाकं, अनी क्रुसखांबवर खियासघाई ठोकीसन रद्द करा. <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />त्यानी स्वतः क्रुसखांबनाद्वारा अध्यात्मिक शासकसले अनं अधिकारीसले पाडीसन त्यासनावर जय मियाडेल शे, त्यानी त्यासना विजयना मोर्चामा त्यासले कैदी बनाडीन त्यासना तमाशा करा. <verse eid="COL 2:15" /><verse number="16" style="v" sid="COL 2:16" /><note caller="+" style="x"><char style="xo" closed="false">२:१६ </char><char style="xt" closed="false"><ref loc="ROM 14:1-6">रोम १४:१-६</ref></char></note>म्हणीन कोणी बी तुमनावर खावानं अनं पेवानं बाबत, तसच सण, आमावस्या, किंवा शब्बाथ दिननाबाबत तुमना कोणी न्याय कराले नको. <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />कारण त्या फक्त येनारा भावी गोष्टीसनी सावली शेतस; पण सत्यता ख्रिस्तमा शे. <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />नम्र म्हणीसन देवदूतसनी उपासना करनारा, अनं स्वतःला दखास त्या गोष्टीसवर भरवसा ठेवनारा अनं दैहिक बुध्दीतीन उगाच गर्वमा फुगनारा कोणी मनुष्य तुमले फसाडीसन तुमनं बक्षीससले गमाडु नका. <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" /><note caller="+" style="x"><char style="xo" closed="false">२:१९ </char><char style="xt" closed="false"><ref loc="EPH 4:16">इफिस ४:१६</ref></char></note>अस मनुष्य ख्रिस्त जो मस्तक शे त्याले धरीसन राहस नही; त्या ख्रिस्तपाईन सर्व शरिरले स्नायु अनं बंधन यासना एकमेकसना आधारवर पुरवठा व्हस अनं त्यानी देवले योग्य वाटस ईतलं वाढत जास.<verse eid="COL 2:19" /></para>
  <para style="s">ख्रिस्तमा जगणं अनी मरणं</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />तुम्हीन जगना प्राथमिक शिक्षणमा ख्रिस्तनासोबत मरेल शेतस तर मंग तुम्हीन हाई जगना राहनारासनामायक त्यासना नियमासना स्वाधीन का व्हतस? <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />म्हणजे “त्याले हात लावानं नही!” अनं “त्यानी चव चाखानं नही?” <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />अस प्रकारना उपभोगतीन नाश व्हनारा वस्तुविषयी मनुष्यसनं नियमासनं अनं शिक्षणंन ज्या विधी शेतस त्यासना स्वाधीन का व्हतस. <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />याले स्वतःनं ईच्छातीन योजल स्वर्गदूतसनी उपासना, लिनता अनं देहदंड यावरीन ज्ञान नाव खरं शे, तरी देहस्वभावना लालच विरूध्द लढाकरता त्यासनी योग्यता नही.<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="s">ख्रिस्तमा नवं जिवन</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />म्हणीन जसं तुम्हीन ख्रिस्तनासोबत मरेलमाईन ऊठाडामा वनात, तर ख्रिस्त देवना उजवीकडे जठे बसना शे तठला स्वर्गन्या गोष्टी मियाडानं प्रयत्न करा. <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />स्वर्गन्या गोष्टीसकडे मन लावा, पृथ्वीवरन्या गोष्टीसकडे ध्यान देऊ नका. <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />कारण तुम्हीन मरेल शेतस अनी तुमनं नवं जिवन ख्रिस्तनासंगे देवमा गुप्त ठेयेल शे. <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />ख्रिस्त जो आमनं खरा जिवन शे, जवय त्यानं दुसरं येवाना येळले प्रकट व्हई, तवय तुम्हीन बी त्यानाबरोबर गौरवमा प्रकट व्हशात.<verse eid="COL 3:4" /></para>
  <para style="s">जुनं अनी नवं जिवन</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />म्हणीन तुमनामाधलं पृथ्वीवरना जे काही शे त्यासले जिवे मारा, जारकर्म, अशुध्दता, दुष्ट ईच्छा, अमंगळपणा, वासना अनं लोभ ज्या मुर्तिपुजा मायक शेतस. <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />कारण ह्याच पापसमुये देवना कोप आज्ञाभंग करनारासवर व्हई. <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />अशी येळ व्हती, तुम्हीन बी असा ईच्छासमा जिवन जगी राहींतात जवय तुम्हीन त्याना प्रभुत्वमा असा गोष्टी करी राहींतात. <verse eid="COL 3:7" /><verse number="8" style="v" sid="COL 3:8" />पण आते तुम्हीन या गोष्टी क्रोध, संताप, दुष्टपण, तोंडघाई निंदा, अनं शिवीगाळ करानं, हाई सर्व आपलापाईन दुर करा. <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" /><note caller="+" style="x"><char style="xo" closed="false">३:९ </char><char style="xt" closed="false"><ref loc="EPH 4:22">इफिस ४:२२</ref></char></note>एकमेकसनासंगे लबाडी करू नका, कारण तुम्हीन जुना मनुष्यले त्याना सवयपाईन काढी टाकेल शेतस. <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" /><note caller="+" style="x"><char style="xo" closed="false">३:१० </char><char style="xt" closed="false"><ref loc="EPH 4:24">इफिस ४:२४</ref></char></note>अनी जो नवा मनुष्य त्याले निर्माण करनारा प्रतिरूपाप्रमाणे पुर्ण ज्ञानमा नवा करामा ई राहिनं त्याले तुम्हीन धारण करेल शेतस. <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />यामा परीणाम हाऊच शे की, गैरयहूदी अनं यहूदी, सुंता अनं बेसुंता, सभ्य अनं असभ्य, दास, अनं स्वतंत्र असं कोणताच फरक नही; तर ख्रिस्त हाऊच सर्वकाही शे, अनी ख्रिस्तच सर्व ईश्वासनारासमा शे. <verse eid="COL 3:11" /><verse number="12" style="v" sid="COL 3:12" /><note caller="+" style="x"><char style="xo" closed="false">३:१२ </char><char style="xt" closed="false"><ref loc="EPH 4:2">इफिस ४:२</ref></char></note>तुम्हीन देवना स्वतःकरता प्रिय अस निवडेल लोके शेतस, म्हणीन करूणायुक्त हृदय, ममता, नम्रभाव, लीनता, सहनशीलता हाई परीधान करानं. <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" /><note caller="+" style="x"><char style="xo" closed="false">३:१३ </char><char style="xt" closed="false"><ref loc="EPH 4:32">इफिस ४:३२</ref></char></note>एकमेकसनं सहन करानं जसं प्रभुनी तुमले क्षमा करी, तसं कोणाविरूध्द तक्रार व्हई तर तुम्हीनबी एकमेकसले क्षमा करानं. <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />या सर्वासवर प्रितीले परीधान करा, जी सर्वासले बंधनमा ठेवस अनी त्यासले परीपुर्ण करस. <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />ख्रिस्तनी शांती तुमनं निर्णयावर राज्य करो; तिनाकरता देवनी शांतीमा तुमले सोबत एक शरीर असं पाचारण करामा येल शे; अनी तुम्हीन कायम उपकार मानणारा व्हा. <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" /><note caller="+" style="x"><char style="xo" closed="false">३:१६ </char><char style="xt" closed="false"><ref loc="EPH 5:19">इफिस ५:१९</ref>,<ref loc="EPH 5:20">२०</ref></char></note>ख्रिस्तनं वचन पुरा संपन्नतातीन तुमना मनमा भरपुर ऱ्हावो, एकमेकसले सर्व ज्ञानतीन शिकाडा अनं बोध करा; स्तोत्र, गीत अनं अध्यात्मिक गीत कृपाना प्रेरनामा म्हणीसन उपकारस्तुतीसह आपला अंतःकरणमा देवले गीत म्हणा. <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />अनी बोलणं किंवा करनं जे काही तुम्हीन करशात, ते सर्व प्रभु येशुनं नावमा करा; यामुये तुम्हीन त्यानाद्वारा देवपितानं आभार मानतस.<verse eid="COL 3:17" /></para>
  <para style="s">ख्रिस्ती मनुष्यनं जिवन</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१८ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">इफिस ५:२२</ref>; <ref loc="1PE 3:1">१ पेत्र ३:१</ref></char>
    </note>बायकासवनं, जसं ख्रिस्ती म्हणीसन शोभी तसं तुम्हीन आपपला नवराले धरीन ऱ्हावानं. <verse eid="COL 3:18" /><verse number="19" style="v" sid="COL 3:19" /><note caller="+" style="x"><char style="xo" closed="false">३:१९ </char><char style="xt" closed="false"><ref loc="EPH 5:25">इफिस ५:२५</ref>; <ref loc="1PE 3:7">१ पेत्र ३:७</ref></char></note>नवरासवनं, आपपली बायकोवर प्रिती करानी अनं तिनासंगे कठोरतातीन वागानं नही. <verse eid="COL 3:19" /><verse number="20" style="v" sid="COL 3:20" /><note caller="+" style="x"><char style="xo" closed="false">३:२० </char><char style="xt" closed="false"><ref loc="EPH 6:1">इफिस ६:१</ref></char></note>पोऱ्यासवनं, तुम्हीन सर्व गोष्टीसमा कायम आपला मायबापना आज्ञा पाळत जा, कारण प्रभुले हाई आनंद देणारं शे. <verse eid="COL 3:20" /><verse number="21" style="v" sid="COL 3:21" /><note caller="+" style="x"><char style="xo" closed="false">३:२१ </char><char style="xt" closed="false"><ref loc="EPH 6:4">इफिस ६:४</ref></char></note>पालकसवनं, तुम्हीन आपला पोऱ्यासले चिड भरू नका, म्हणजे त्या निराश व्हवावुत नही. <verse eid="COL 3:21" /><verse number="22" style="v" sid="COL 3:22" /><note caller="+" style="x"><char style="xo" closed="false">३:२२ </char><char style="xt" closed="false"><ref loc="EPH 6:5-8">इफिस ६:५-८</ref></char></note>नोकरसवनं, तुम्हीन सर्व गोष्टीसमा जठे काम करतस त्या मालकना आज्ञा पाळत जा, माणसंसले संतोषवनारा नोकरसनामायक तोंड दखीसन नही, तर पुर्ण मनतीन प्रभुनं भय धरीसन त्याले मान द्या. <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />अनी जे काही तुम्हीन कामकरता ते मनुष्यकरता नही तर प्रभुकरता कामकरी राहीना शेतस म्हणीन आपला अंतःकरणपाईन काम करानं. <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />प्रभुपाईन वतनरूप प्रतीफळ तुमले भेटी हाई तुमले माहीत शे जे त्यानी आपला लोकसकरता ठेयेल शे; ख्रिस्त जो तुमना खरा धनी शे त्यानीच सेवा करत राहा. <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" /><note caller="+" style="x"><char style="xo" closed="false">३:२५ </char><char style="xt" closed="false"><ref loc="EPH 6:9">इफिस ६:९</ref></char></note>अन्याय करनाराना अन्याय त्यानाकडे परत ई; कारण देवना न्याय सर्वसकरता मायक शे.<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:9">इफिस ६:९</ref>
      </char>
    </note>मालकसवनं, स्वर्गमा तुमना बी मालक शे, हाई ध्यानमा ठेईसन तुम्हीन आपला नोकरससंगे न्यायतीन अनं समतेमा वागा.<verse eid="COL 4:1" /></para>
  <para style="s">निर्देष</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />प्रार्थनामा कायम सावध राहा अनं तिनामा उपकारस्तुती करीसन जागृत ऱ्हावा; <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />आमनाकरता बी प्रार्थना करा, यानाकरता की, ख्रिस्तनाविषयी जे रहस्य देवनी आमले सांगं, त्यानाबद्दल अनं त्याना संदेश सांगाकरता देवनी आमनाकरता चांगली संधी भेटाले पाहिजे, कारण त्याना उपदेश कराकरता मी कैदमा शे. <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />प्रार्थना करा की, जसं माले बोलाले पाहिजे तसं मी ते स्पष्ट रितीतीन बोलाले पाहिजे. <verse eid="COL 4:4" /><verse number="5" style="v" sid="COL 4:5" /><note caller="+" style="x"><char style="xo" closed="false">४:५ </char><char style="xt" closed="false"><ref loc="EPH 5:16">इफिस ५:१६</ref></char></note>ईश्वासी लोकसनासंगे सुज्ञतेमा वागा; अनी येळना सदुपयोग करा. <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />तुमनं बोलनं नेहमी कृपायुक्त अनी लोकसले आवडणार असं ऱ्हावाले पाहिजे, म्हणजे प्रत्येक मनुष्यले कसं उत्तर देवानं हाई समजी.<verse eid="COL 4:6" /></para>
  <para style="s">सलाम</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:७ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">प्रेषित २०:४</ref>; <ref loc="2TI 4:12">२ तिमथ्य ४:१२</ref></char>
    </note>
    <note caller="+" style="x">
      <char style="xo" closed="false">४:७ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:21">इफिस ६:२१</ref>,<ref loc="EPH 6:22">२२</ref></char>
    </note>प्रिय बंधु, तुखिक, प्रभुमा ईश्वासु सेवक अनं मना सोबतीना दास, हाऊ मनाविषयी सर्व बातमी तुमले सांगी. <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />मी त्याले हाईच कारणतीन तुमनाकडे धाडेल शे की, आमना विषयी बातमी तुमले समजाले पाहिजे अनी त्यामुये तुमनं अंतःकरणले समाधान वाटाले पाहिजे. <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" /><note caller="+" style="x"><char style="xo" closed="false">४:९ </char><char style="xt" closed="false"><ref loc="PHM 1:10-12">फिलेमोनले पत्र १:१०-१२</ref></char></note>मी त्याले आमना ईश्वासु अनं प्रिय बंधु अनेसिम, जो तुमनामाईन एक शे, त्याले बी धाडी ऱ्हायनु शे, त्या तुमले अठली सगयी बातमी सांगतीन. <verse eid="COL 4:9" /><verse number="10" style="v" sid="COL 4:10" /><note caller="+" style="x"><char style="xo" closed="false">४:१० </char><char style="xt" closed="false"><ref loc="ACT 19:29">प्रेषित १९:२९</ref>; <ref loc="ACT 27:2">२७:२</ref>; <ref loc="PHM 1:24">फिलेमोनले पत्र १:२४</ref>; </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेषित १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref></char></note>अरिस्तार्ख, मना सोबतीना कैदी, तुमले सलाम सांगस, अनी बर्णबाना चुलत भाऊ मार्क हाऊ बी तुमले सलाम सांगस, त्यानाविषयी तुमले अगोदरच माहिती भेटेल शे, तो जर तुमनाकडे वना तर त्यानं स्वागत करा. <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />ज्याले युस्त म्हणतस तो येशु बी तुमले सलाम सांगस; यहूदी ईश्वासणारास माईन ह्याच तिन्ही देवना राज्यकरता मनासंगे सहकारी व्हयेल शेतस अनं त्यासनी माले भलतीच मदत भेटेल शे. <verse eid="COL 4:11" /><verse number="12" style="v" sid="COL 4:12" /><note caller="+" style="x"><char style="xo" closed="false">४:१२ </char><char style="xt" closed="false"><ref loc="COL 1:7">कलस्सै १:७</ref>; <ref loc="PHM 1:23">फिलेमोनले पत्र १:२३</ref></char></note>ख्रिस्त येशुना दास, एफफ्रास जो तुमनामाधला एक शे, तो तुमले सलाम सांगस, तो आपला प्रार्थनामा कायम तुमनाकरता जीव तोडीसन ईनंती करी राहीना शे की, देवना ईच्छातीन कराले तुम्हीन कायम परीपुर्ण ऱ्हावाले पाहिजे. <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />ज्या लावदिकीयामा अनं हेरापलीत शेतस त्यासनाकरता तो बराच श्रम करी राहीना शे. यानाविषयी मी साक्षी शे. <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" /><note caller="+" style="x"><char style="xo" closed="false">४:१४ </char><char style="xt" closed="false"><ref loc="2TI 4:11">२ तिमथ्य ४:११</ref>; <ref loc="PHM 1:24">फिलेमोनले पत्र १:२४</ref>; </char><char style="xt" closed="false"><ref loc="2TI 4:10">२ तिमथ्य ४:१०</ref>; <ref loc="PHM 1:24">फिलेमोनले पत्र १:२४</ref></char></note>आमना प्रिय वैद्य लूक अनं देमास ह्या तुमले सलाम सांगतस. <verse eid="COL 4:14" /><verse number="15" style="v" sid="COL 4:15" />लावदिकीया माधला राहनारा ईश्वासनारा बंधुसवन, अनं नुफा अनी तिना घर जमणारी मंडळी यासले सलाम सांगा. <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />हाई पत्र तुमनामा वाची दखाडावर लावदिकीया माधली मंडळीमा बी वाचानं, अनं लावदिकीमा जायेल पत्र लईसन तुम्हीन बी वाचाले पाहिजे असं व्यवस्था करा. <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" /><note caller="+" style="x"><char style="xo" closed="false">४:१७ </char><char style="xt" closed="false"><ref loc="PHM 1:2">फिलेमोनले पत्र १:२</ref></char></note>अर्खिप्पाले पण सांगा की, “जी सेवा तुले प्रभुमा मिळेल शे, ती पुर्ण कराकरता तिनाकडे ध्यान दिसन ती पुरी कर.” <verse eid="COL 4:17" /><verse number="18" style="v" sid="COL 4:18" />मी पौल, मना स्वतःना हातघाई सलाम लिखस. मी कैदमा शे यानी आठवण ठेवा!</para>
  <para style="p" vid="COL 4:18">देवनी कृपा तुमनासंगे ऱ्हावो.<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>