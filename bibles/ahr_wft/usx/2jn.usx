<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Ahirani</book>
  <para style="h">२ योहान</para>
  <para style="toc3">२ योहान</para>
  <para style="toc2">२ योहान</para>
  <para style="toc1">योहाननी लिखेल दुसरं पत्र</para>
  <para style="mt2">योहानाने लिहिलेले दुसरे पत्र</para>
  <para style="mt1">योहाननी लिखेल दुसरं पत्र</para>
  <para style="imt">वळख</para>
  <para style="ip">योहाननं दुसरं पत्र प्रेषित योहान कडतीन येशु ख्रिस्तना जन्मनंतर ५०-१०० वरीसना मझार लिखाई गयतं. योहान स्वतःले लेखकना रूपमा वळखस नही. तो स्वतःले वडील म्हणस. या पत्रमातील जे लिखाण शे ते योहानकृत शुभवर्तमानमा लिखेल गोष्टीसना तुलनामा २ योहान मातील गोष्टीसना जवळना संबंध वाटस. या पुस्तकमा हाई विशेष रूपतीन स्पष्ट व्हस की, जसं तो एकमेकसवर प्रिती कराकरता येशुना आदेशसवर जोर देस अनी जसं तो आपला आदेशसनं पालन करतांना येशुवर प्रेम करस. <char style="xt"><ref loc="2JN 1:5-6">१:५-६</ref></char>, <char style="xt"><ref loc="JHN 15:9-10">योहान १५:९-१०</ref></char> अस म्हणतस की योहानकृत शुभवर्तमान अनी १ योहान, २ योहान, अनी ३ योहान या पुस्तकं बी योहाननी इफिसमा राही राहींता तवय लिखात.</para>
  <para style="ip">योहानानी या पत्रमा निवाडेल बाई अनी तिना पोऱ्यासले संबोधीत करस. पण तो कदाचित एखादी मंडळीबद्दल बोली राहींता. हाई पत्र लिखाना उद्देश हाऊ व्हता की, मंडळीले प्रोत्साहन देवानं अनी खोटा शिक्षकसले ताकिद देवानी.</para>
  <para style="iot">रूपरेषा</para>
  <para style="io1">१. योहान हाई सांगीसन पुस्तक सादर करस की, हाई पत्र कोणाकरता लिखेल शे अनी आपला वाचकसले शुभेच्छा देस. <char style="ior"><ref loc="2JN 1:1-3">१:१-३</ref></char></para>
  <para style="io1">२. मंग तो मंडळीले प्रोत्साहीत करस अनी त्यासले महान आदेश देस. <char style="ior"><ref loc="2JN 1:4-6">१:४-६</ref></char></para>
  <para style="io1">३. पुढे, तो खोटा शिक्षकसले ताकिद देस. <char style="ior"><ref loc="2JN 1:7-11">१:७-११</ref></char></para>
  <para style="io1">४. योहान जठे ऱ्हास तठली मंडळीना ईश्वासी लोकसले शुभेच्छा संदेश दिसन आपलं पत्र पुरं करस. <char style="ior"><ref loc="2JN 1:12-13">१:१२-१३</ref></char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />निवडेल बाई अनं तिना पोऱ्यासले, पिता यानाकडीन; जे सत्य आपलामा शे अनं आपलासंगे सर्वकाळ राही, त्या सत्यामुये मी तुमनावर खरी प्रिती करस; <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />फक्त मीच नही तर ज्यासले सत्यना ज्ञान व्हयेल शे त्या सर्वाच करतस. <verse eid="2JN 1:2" /><verse number="3" style="v" sid="2JN 1:3" />देव पितापाईन अनं पिताना पोऱ्या येशु ख्रिस्त यानापाईन कृपा, दया अनं शांती हाई सत्यमा अनं प्रितीमा आपलासोबत राहतीन.<verse eid="2JN 1:3" /></para>
  <para style="s">सत्य अनी प्रेम</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />आपलाले पितापाईन आज्ञा भेटण्यात त्यानामायक तुना काही पोऱ्या सत्यमा चालतस अस माले दखाई राहिनं, ह्यानावरतीन माले भलताच आनंद व्हयना. <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" /><note caller="+" style="x"><char style="xo" closed="false">१:५ </char><char style="xt" closed="false"><ref loc="JHN 13:34">योहान १३:३४</ref>; <ref loc="JHN 15:12">१५:१२</ref>,<ref loc="JHN 15:17">१७</ref></char></note>बाई, आते मी तुले ईनंती करस की, आपण एकमेकसवर प्रिती कराले पाहिजे; हाई मी नविन आज्ञा तुले लिखी ऱ्हायनु शे, अस नही, तर जी आपलाले सुरवात पाईन देवामा येल शे तिच लिखी ऱ्हायनु शे. <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />प्रिती हाईच शे की, आपण त्याना आज्ञाप्रमाणे चालाले पाहिजे. ती आज्ञा हाईच शे की, जसं तुम्हीन सुरवात पाईन ऐकेल शे तसं तुम्हीन प्रेमपुर्वक जिवन जगाले पाहिजे. <verse eid="2JN 1:6" /><verse number="7" style="v" sid="2JN 1:7" />कारण फसवनुक करनारा, म्हणजे शरिरमा येनारा येशु ख्रिस्त ह्याले कबुल नही करनारा पुष्कळ माणसं जगमा ऊठेल शेतस. फसवनुक करनारा अनं ख्रिस्तविरोधक असाच शेतस. <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />आम्हीन करेल कामे तुम्हीन निष्फळ व्हवु देऊ नका तर त्याना पुर्ण प्रतिफळ तुमले भेटाले पाहिजे, म्हणीसन खबरदारी ल्या. <verse eid="2JN 1:8" /><verse number="9" style="v" sid="2JN 1:9" />ख्रिस्तना शिक्षणमा स्थिर नही राहता जो पुढेपुढेच जास त्याले देव प्राप्त व्हस नही; जो त्याना शिक्षणले धरीन ऱ्हास त्याले पिता अनं पोऱ्या ह्या दोन्ही प्राप्त व्हयेल शेतस. <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />हाई शिक्षण नही देणारा कोणी तुमना जोडे वना तर त्याले घरमा लेवु नका अनं त्याले सलाम बी करू नका; <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />कारण जो त्याना स्वागत करस तो त्याना दुष्कर्मासना भागीदार व्हस.<verse eid="2JN 1:11" /></para>
  <para style="s">शेवटला शब्द</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />माले तुमले बरच काही लिखानं व्हतं, पण ते कागद अनी शाईघाई लिखाले वाटस नही; तर तुमनाकडे ईसन माले समक्ष बोलता ई हाई मी आशा धरस; म्हणजे आपला आनंद परिपुर्ण व्हई.<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />
    <note caller="+" style="f">
      <char style="fr" closed="false">1:13 </char>
      <char style="ft" closed="false">निवडेल बहिण म्हणजे निवडेल मंडळी, ह्या ज्या पोऱ्या शेत त्या मंडळीना पोऱ्या शेतस. </char>
    </note>तुना निवडेल बहिणीसना पोऱ्या तुले सलाम सांगतस.<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>