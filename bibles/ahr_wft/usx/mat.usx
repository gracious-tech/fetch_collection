<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAT" style="id">- Ahirani</book>
  <para style="h">मत्तय</para>
  <para style="toc3">मत्तय</para>
  <para style="toc2">मत्तय</para>
  <para style="toc1">मत्तयनी लिखेल येशु ख्रिस्तनं शुभवर्तमान</para>
  <para style="mt2">मत्तयने लिहिलेले येशु ख्रिस्ताचे शुभवर्तमान</para>
  <para style="mt1">मत्तयनी लिखेल येशु ख्रिस्तनं शुभवर्तमान</para>
  <para style="imt">वळख</para>
  <para style="ip">मत्तयनी लिखेल शुभवर्तमान हाई जे पुस्तक शे, ते नवा नियमसना चार पुस्तकसपैकी एक शे जे येशु ख्रिस्तनं वर्णन करस, या चारी पुस्तकसमाईन प्रत्येक पुस्तकले सुसमाचार म्हणेल शे, याना अर्थ व्हस शुभवर्तमान. येशुनं स्वर्गरोहण व्हवावर या शुभवर्तमानना पुस्तके मत्तय, मार्क, लूक, अनी योहाननी लिखात. मत्तयनं शुभवर्तमान हाई कोणती येळले अनी कवय लिखाई गय यानी माहिती विद्वानासले बी नही शे, पण मात्र आम्हीन अस सांगु शकतस की, येशुना जन्मना जवळपास ६० वरीस नंतर हाई लिखाई गयं. यामुये हाई पुस्तक कोठे लिखाई गयं हाई पण आम्हले माहित नही तरी पण बराच जणसनं म्हणनं शे की, हाई पुस्तक पॅलेस्ताईन किंवा यरूशलेम नगरीमा लिखायनं व्हई.</para>
  <para style="ip">ह्या पुस्तकना लेखक मत्तय शे जो येशुना शिष्य व्हवाना पहिले जकातदार व्हता. त्याले लेवी हाई नावतीन बी वळखेत. मत्तय हाऊ बारा शिष्यसमाधला एक व्हता अनी त्यानी यहूदी वाचकसकरता हाई लिखं. यावरतीन आम्हीन दखतस की, हाई पुस्तकमा ६० पेक्षा जास्त संदर्भ जुना नियमना शेतस. ज्यानाबद्दल भविष्यवाणी व्हयनी तो मुक्तीदाता येशु ख्रिस्त शे, हाई सांगाना त्यानी प्रयत्न करेल शे.</para>
  <para style="ip">मत्तयनी परमेश्वरना राज्यबद्ल खुप काही लिखेल शे, यहूदीसनी आशा व्हती की, ख्रिस्त राजनैतिक राज्यना राजा व्हई. मत्तयनी ह्या विचारासले आव्हान दिसन परमेश्वरना आत्मीक राज्यना वर्णन करस.</para>
  <para style="ip">मत्तय शुभवर्तमान हाई एक योग्य पुस्तक शे, ज्यामुये नवा नियमसना सुरवातले हाई पुस्तक जुना नियमसना जोडे बरास येळा आम्हनं ध्यान आकर्षित करस. त्या दोनी नियमसना पुस्तकसले जोडी देस. विद्वानसनं अस म्हणनं शे की, हाई पुस्तकनी मोशेनी लिखेल पंचग्रंथ जे जुना नियमासना पहिले पाच पुस्तके शेतस. या पुस्तकनी रचना जे त्या पुस्तकसनं अनुकरण करस. येशुनी जे डोंगरवर प्रवचन दिधं <char style="xt"><ref loc="MAT 5-7">५–७</ref></char> यानी तुलना, ज्या नियम परमेश्वरनी मोशेले दिधात त्यानाशी व्हवु शकस. <char style="xt"><ref loc="DEU 19:3-23:25">अनुवाद १९:३–२३:२५</ref></char></para>
  <para style="iot">रूपरेषा</para>
  <para style="io1">१. येशुना जन्म अनं त्यानी सेवा कार्यनी सुरवात मत्तय आपला शुभवर्तमानना सुरवातमा करस. <char style="ior"><ref loc="MAT 1-4">मत्तय १–४</ref> </char></para>
  <para style="io1">२. यानानंतर मत्तय येशुना कार्यबद्दल अनी ज्या अनेक विषयनाबद्ल त्यानी जे शिक्षण दिधं. त्याना विषयमा सांगस. <char style="ior"><ref loc="MAT 5-25">मत्तय ५–२५</ref> </char></para>
  <para style="io1">३. मत्तय शुभवर्तमानना शेवटना भाग हाऊ शे की, येशुना सेवा कार्यनी उंची ज्यामा त्याना मृत्युना अनी पुनरुस्थानना बी वर्णन शे. <char style="ior"><ref loc="MAT 26-28">मत्तय २६–२८</ref> </char></para>
  <chapter number="1" style="c" sid="MAT 1" />
  <para style="s">येशु ख्रिस्तनी वंशावळी</para>
  <para style="r">(<ref loc="LUK 3:23-28">लूक ३:२३-२८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 1:1" />येशु ख्रिस्त जो दावीद राजाना पोऱ्या, जो अब्राहामना पोऱ्या ह्याना वंशावळीनं पुस्तक.<verse eid="MAT 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MAT 1:2" />अब्राहामले इसहाक नावना पोऱ्या व्हयना; इसहाकले याकोब; याकोबले यहुदा; अनं त्याना भाऊ व्हयनात; <verse eid="MAT 1:2" /><verse number="3" style="v" sid="MAT 1:3" />यहुदाले तामारेपाईन पेरेस अनं जेरह व्हयनात; पेरेसले हेस्रोन व्हयना; हेस्रोनले अराम व्हयना; <verse eid="MAT 1:3" /><verse number="4" style="v" sid="MAT 1:4" />अरामले अम्मीनादाब; अम्मीनादाबले नहशोन; नहशोनले सल्मोन; <verse eid="MAT 1:4" /><verse number="5" style="v" sid="MAT 1:5" />सल्मोनले रहाबेपाईन बवाज; बवाजाले रूथपाईन ओबेद; ओबेदाले इशाय;<verse eid="MAT 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 1:6" />अनं इशायले; दावीद राजा व्हयना; जी पहिले उरीयानी बायको व्हती; तिनापाईन दावीदले शलमोन व्हयना; <verse eid="MAT 1:6" /><verse number="7" style="v" sid="MAT 1:7" />शलमोनले रहाबाम; रहबामले अबीया; अबीयाले आसा; <verse eid="MAT 1:7" /><verse number="8" style="v" sid="MAT 1:8" />आसाले यहोशाफाट; यहोशाफाटले योराम; योरामले उज्जीया; <verse eid="MAT 1:8" /><verse number="9" style="v" sid="MAT 1:9" />उज्जीयाले योथाम; योथामले आहाज; आहाजले हिज्कीया; <verse eid="MAT 1:9" /><verse number="10" style="v" sid="MAT 1:10" />हिज्कीयाले मन्नशे; मन्नशेला आमोन; आमोनले योशीया; <verse eid="MAT 1:10" /><verse number="11" style="v" sid="MAT 1:11" />अनी बाबेलले देशांतर व्हयनं तवय योशीयाले यखन्या अनं त्याना भाऊ व्हयनात.<verse eid="MAT 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 1:12" />बाबेलले देशांतर व्हयनं तवय यखन्याले शल्तीएल व्हयना; शल्तीएलले जरूब्बाबेल; <verse eid="MAT 1:12" /><verse number="13" style="v" sid="MAT 1:13" />जरूब्बाबेलले अबीहूद; अबीहूदले एल्याकीम; एल्याकीमले अज्जुर; <verse eid="MAT 1:13" /><verse number="14" style="v" sid="MAT 1:14" />अज्जुरले सादोक; सादोकले याखीम; याखीमले एलीहुद; <verse eid="MAT 1:14" /><verse number="15" style="v" sid="MAT 1:15" />एलीहुदले एलाजार; एलाजारले मत्तान; मत्तानले याकोब; <verse eid="MAT 1:15" /><verse number="16" style="v" sid="MAT 1:16" />अनी याकोबले योसेफ व्हयना. जो मरीयाना नवरा व्हता, अनी मरीयाले येशु व्हयना ज्याले ख्रिस्त म्हणतस.<verse eid="MAT 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 1:17" />याप्रमाणे अब्राहामपाईन दावीदपावत सर्व मिळीसन चौदा पिढ्या; दावीदपाईन बाबेलले देशांतर करं तोपावत चौदा पिढ्या; अनी बाबेलले देशांतर व्हवनं तवयपाईन ख्रिस्तपावत चौदा पिढ्या.<verse eid="MAT 1:17" /></para>
  <para style="s">येशुना जन्म</para>
  <para style="r">(<ref loc="LUK 2:1-7">लूक २:१-७</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 1:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१८ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:27">लूक १:२७</ref>
      </char>
    </note>येशुना जन्म असा व्हयना की, त्यानी माय मरीया हिनी योसेफसंगे मांगनी व्हयेल व्हती, त्यासनं लगीन व्हवाना पहिले पवित्र आत्माकडतीन तिले दिवस राही गयात. अस दखायी वनं <verse eid="MAT 1:18" /><verse number="19" style="v" sid="MAT 1:19" />तिना नवरा योसेफ हाऊ एक धार्मीक माणुस व्हता अनं तिनी बदनामी व्हवाले नको म्हणीसन तिले चुपचाप सोडी देवानी त्यानी ईच्छा व्हती. <verse eid="MAT 1:19" /><verse number="20" style="v" sid="MAT 1:20" />जवय तो हाऊ ईचार करीच राहींता ईतलामा एक प्रभुना स्वर्गदूतनी त्याले सपनमा दर्शन दिसन सांगं, हे, “योसेफ दावीदना पोऱ्या, तु मरीयाले बायको बनाडाले घाबरू नको, कारण तिना पोटमा जो गर्भ शे, तो पवित्र आत्माकडतीन शे. <verse eid="MAT 1:20" /><verse number="21" style="v" sid="MAT 1:21" /><note caller="+" style="x"><char style="xo" closed="false">१:२१ </char><char style="xt" closed="false"><ref loc="LUK 1:31">लूक १:३१</ref></char></note>ती पोऱ्याले जन्म दि त्यानं नाव तु येशु ठेव, कारण तोच आपला लोकसले पापपाईन वाचाडी.”<verse eid="MAT 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 1:22" />हाई सर्व यानाकरता व्हयनं, की, प्रभुनी संदेष्टासनाद्वारा जे सांगेल व्हतं ते पुर्ण व्हवाले पाहिजे ते अस. <verse eid="MAT 1:22" /><verse number="23" style="v" sid="MAT 1:23" />दखा, “कुमारी गर्भवती व्हई अनं तिले पोऱ्या व्हई, अनी त्याले इम्मानुएल हाई नाव देतीन.” ह्या नावना अर्थ “आमनासंगे देव असा शे.”<verse eid="MAT 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 1:24" />तवय झोपमाईन ऊठानंतर प्रभुना दूतनी जशी आज्ञा करी, तसं योसेफनी करं त्यानी आपली बायकोना स्विकार करा. <verse eid="MAT 1:24" /><verse number="25" style="v" sid="MAT 1:25" /><note caller="+" style="x"><char style="xo" closed="false">१:२५ </char><char style="xt" closed="false"><ref loc="LUK 2:21">लूक २:२१</ref></char></note>जोपावत तिनी पोऱ्याले जन्म दिधा नही, तोपावत मरीयाना जोडे तो निजना नही, जवय पोऱ्या व्हयना तवय त्यानी त्यानं नाव येशु ठेवं.<verse eid="MAT 1:25" /></para>
  <chapter eid="MAT 1" />
  <chapter number="2" style="c" sid="MAT 2" />
  <para style="s">ज्योतिषी लोके येशु बाळना दर्शनले येतस</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 2:1" />जवय हेरोद राजा व्हता. तवय यहूदीयातील प्रांतमा बेथलहेम गावमा येशुना जन्मनंतर, दखा पुर्व दिशाकडतीन ज्योतिषी<note caller="+" style="f"><char style="fr" closed="false">२:१ </char><char style="ft" closed="false">ज्योतिषी; आकाशमातील तारासना अभ्यास करनारा लोके</char></note> येरूशलेमले ईसन ईचार-पुस करू लागनात. <verse eid="MAT 2:1" /><verse number="2" style="v" sid="MAT 2:2" />“यहूदीसना राजा जन्मना तो कोठे शे? कारण आम्हीन पुर्व दिशाले तारा दखीसन त्याले नमन कराले येल शेतस.” <verse eid="MAT 2:2" /><verse number="3" style="v" sid="MAT 2:3" />हेरोद राजानी जवय हाई ऐकं तवय तो अनं पुरं यरूशलेम घाबरी गयं. <verse eid="MAT 2:3" /><verse number="4" style="v" sid="MAT 2:4" />तवय त्यानी लोकसना मुख्य याजक, अनी शास्त्रीसले बलाईसन ईचारं की, ख्रिस्तना जन्म कोठे व्हणार शे? <verse eid="MAT 2:4" /><verse number="5" style="v" sid="MAT 2:5" />त्यासनी त्याले सांगं, “यहूदीयाना बेथलहेम गावमा” कारण संदेष्टासनाद्वारा असच लिखेल शे, की. <verse eid="MAT 2:5" /><verse number="6" style="v" sid="MAT 2:6" />“हे यहूदाना प्रदेश बेथलहेम? तु यहुदाना सर्व सरदारसमा कनिष्ठ शे; अस अजिबात नही? कारण मना इस्त्राएल लोकसले संभाळी असा सरदार तुनामातीन निंघी.”<verse eid="MAT 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 2:7" />तवय ज्योतिषीसले हेरोद राजानी गुपचुप बलाईसन तारा दखावानी येळ नीट ईचारी लिधी. <verse eid="MAT 2:7" /><verse number="8" style="v" sid="MAT 2:8" />त्यासले बेथलहेमले धाडतांना सांगं, “तुम्हीन जाईसन त्या बाळबद्दल नीट ईचारपुस करा, शोध लागी तवय माले बी निरोप द्या, म्हणजे मी पण ईसन त्याले नमन करसु.” <verse eid="MAT 2:8" /><verse number="9" style="v" sid="MAT 2:9" />राजानं बोलनं ऐकीसन त्या तठेन निंघनात त्यासनी जो तारा पुर्व दिशाले दखेल व्हता, जठे ते बाळ व्हतं. त्या जागावर जाईसन पोहचत नही तोपावत त्यासनापुढे चालना. <verse eid="MAT 2:9" /><verse number="10" style="v" sid="MAT 2:10" />त्या ताराले दखीसन त्या भलताच खूश व्हयनात. <verse eid="MAT 2:10" /><verse number="11" style="v" sid="MAT 2:11" />जवय त्या घरमा गयात, तवय बाळले त्यानी माय मरीया जोडे त्यासनी दखं. अनं त्यासनी त्याना पाया पडीसन त्याले नमन करं, त्यासनी त्यासन्या थैल्या सोडीसन त्यानामाईन सोनं, ऊद, गंधरस, हाई त्याले अर्पण करं. <verse eid="MAT 2:11" /><verse number="12" style="v" sid="MAT 2:12" />मंग सपनमा परमेश्वर कडतीन त्यासले सूचना भेटनी की, हेरोद राजाकडे परत जावानं नही, म्हणीसन त्या दूसरी वाटतीन त्यासना देशमा निंघी गयात. <figure style="fig" alt="Frankincense branch, censer and incense altar" file="bk00116c.tif" size="col" copy="Horace Knowles ©" ref="२:११">ऊद, धुडदानी अनी धुपवेदी</figure><verse eid="MAT 2:12" /></para>
  <para style="s">मिसर देशमा जाणं</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 2:13" />ज्योतिषी लोके जावानंतर प्रभुना दूतनी योसेफले सपनमा दर्शन दिसन सांगं, “ऊठ, बाळले अनी त्यानी मायले लिसन मिसर देशमा पळी जाय, मी तुले सांगस नही तोपावत तु तठेच ऱ्हाय.” कारण बाळले मारासाठे हेरोद त्याना शोध कराव शे? <verse eid="MAT 2:13" /><verse number="14" style="v" sid="MAT 2:14" />मंग तो ऊठना अनं रातमाच बाळले अनी त्यानी मायले लिसन मिसर देशमा पळी गया. <verse eid="MAT 2:14" /><verse number="15" style="v" sid="MAT 2:15" />अनी हेरोद मरस पावत त्या तठेच ऱ्हायनात, “मी मना पोऱ्याले मिसर देशमातीन बलायेल शे.” जे प्रभुने संदेष्टासनाद्वारा सांगेल व्हतं, ते पुरं व्हवाले पाहिजे म्हणीसन अस व्हयनं<note caller="+" style="x"><char style="xo" closed="false">२:१५ </char><char style="xt" closed="false"><ref loc="HOS 11:1">होशेय ११:१</ref></char></note>.<verse eid="MAT 2:15" /></para>
  <para style="s">धाकला पोऱ्यासनी हत्या</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 2:16" />ज्योतिषीसनी आपले फसाडं म्हणीसन हेरोद भलता संतापना अनं जी माहिती ज्योतिषीसपाईन नीट ईचारी लेयल व्हती, तिना प्रमाणे बेथलहेम अनी आस-पासना सर्व गावसमा ज्या दोन वरीसना अनी त्यानापेक्षा कमी वयना पोऱ्या व्हतात, त्या सर्वासले त्यानी शिपाई धाडीसन मारी टाकं. <verse eid="MAT 2:16" /><verse number="17" style="v" sid="MAT 2:17" />यिर्मया संदेष्टानाद्वारे जे सांगेल व्हतं; त्या येळले ते पुर्ण व्हयनं ते अस; <verse eid="MAT 2:17" /><verse number="18" style="v" sid="MAT 2:18" />रामा गावमा रडानं अनं आक्रोशसना शब्द ऐकाले वनात. राहेल तिना पोऱ्यास करता भलती रडी ऱ्हायनी शे, त्या ऱ्हायनात नहीत म्हणीसन तिनं समाधान व्हई नही ऱ्हायनं<note caller="+" style="x"><char style="xo" closed="false">२:१८ </char><char style="xt" closed="false"><ref loc="JER 1:15">यिर्मया १:१५</ref></char></note>.<verse eid="MAT 2:18" /></para>
  <para style="s">मिसर देशतीन परत येणं</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 2:19" />मंग हेरोद राजा मरानंतर, प्रभुना दूत मिसर देशमा योसेफले सपनमा दर्शन दिसन बोलना. <verse eid="MAT 2:19" /><verse number="20" style="v" sid="MAT 2:20" />ऊठ, बाळले अनी त्याना मायले लिसन इस्त्राएल देशमा निंघी जाय, कारण ज्या बाळले माराले दखी राहींता, त्या मरी जायेल शेतस. <verse eid="MAT 2:20" /><verse number="21" style="v" sid="MAT 2:21" />तवय तो झोपमाईन ऊठना बाळले अनी त्यानी मायले लिसन इस्त्राएल देशमा वना; <verse eid="MAT 2:21" /><verse number="22" style="v" sid="MAT 2:22" />पण अर्खेलाव हाऊ त्याना बाप हेरोदना जागावर यहूदीयामा राज्य करी, ऱ्हाईंता हाई ऐकीसन योसेफ तठे जावाले भ्यायना अनं सपनमा सुचना भेटनी त्याना प्रमाणे तो गालील प्रांतमा निंघी गया. <verse eid="MAT 2:22" /><verse number="23" style="v" sid="MAT 2:23" /><note caller="+" style="x"><char style="xo" closed="false">२:२३ </char><char style="xt" closed="false"><ref loc="MRK 1:24">मार्क १:२४</ref>; <ref loc="LUK 2:39">लूक २:३९</ref>; <ref loc="JHN 1:45">योहान १:४५</ref></char></note>अनं नासरेथ नावना गावले जाईसन ऱ्हाईना, ते यानाकरता की त्याले नासोरी म्हणतीन; हाई जे संदेष्टासद्वारे सांगेल व्हतं, ते पुरं व्हई.<note caller="+" style="x"><char style="xo" closed="false">२:२३ </char><char style="xt" closed="false"><ref loc="LUK 18:7">लूक १८:७</ref></char></note><verse eid="MAT 2:23" /></para>
  <chapter eid="MAT 2" />
  <chapter number="3" style="c" sid="MAT 3" />
  <para style="s">बाप्तिस्मा करनारा योहानना संदेश</para>
  <para style="r">(<ref loc="MRK 1:1-8">मार्क १:१-८</ref>; <ref loc="LUK 3:1-18">लूक ३:१-१८</ref>; <ref loc="JHN 1:19-28">योहान १:१९-२८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 3:1" />त्या दिनमा बाप्तिस्मा करनारा योहान हाऊ, यहूदीयाना जंगलमा ईसन अशी घोषणा देवाले लागना की, <verse eid="MAT 3:1" /><verse number="2" style="v" sid="MAT 3:2" /><note caller="+" style="x"><char style="xo" closed="false">३:२ </char><char style="xt" closed="false"><ref loc="MAT 4:17">मत्तय ४:१७</ref>; <ref loc="MRK 1:15">मार्क १:१५</ref></char></note>“पापसपाईन फिरा कारण स्वर्गनं राज्य जोडे येल शे!” <verse eid="MAT 3:2" /><verse number="3" style="v" sid="MAT 3:3" />त्यानाबद्दल यशया संदेष्टानी सांगेल व्हतं की, “जंगलमा घोषणा करनारानी वाणी व्हयनी की, परमेश्वरनी येवानी वाट तयार करा, अनी परमेश्वर जी वाट वरतीन जावाव शे, ती वाट नीट करा.”<note caller="+" style="x"><char style="xo" closed="false">३:३ </char><char style="xt" closed="false"><ref loc="ISA 40:3">यशया ४०:३</ref></char></note> <verse eid="MAT 3:3" /><verse number="4" style="v" sid="MAT 3:4" />योहानना कपडा ह्या उंटसना केससपाईन बनाडेल व्हतात. त्याना कंबरले कातडाना पट्टा व्हता, त्यानं जेवण रानमध अनं टोळ व्हतं<note caller="+" style="x"><char style="xo" closed="false">३:४ </char><char style="xt" closed="false"><ref loc="2KI 1:8">२ राजे १:८</ref></char></note>. <verse eid="MAT 3:4" /><verse number="5" style="v" sid="MAT 3:5" />तवय त्याना संदेश ऐकाकरता यरूशलेम, सर्वा यहूदीयाना प्रदेश अनी यार्देन नदी, त्याना जवळपासना सर्व प्रदेशना सर्वा लोके त्यानाजोडे वनात. <verse eid="MAT 3:5" /><verse number="6" style="v" sid="MAT 3:6" />त्या लोकसनी पाप कबुल करं, म्हणजे तो त्यासले यार्देन नदीमा बाप्तिस्मा दे. <verse eid="MAT 3:6" /><verse number="7" style="v" sid="MAT 3:7" /><note caller="+" style="x"><char style="xo" closed="false">३:७ </char><char style="xt" closed="false"><ref loc="MAT 12:34">मत्तय १२:३४</ref>; <ref loc="MAT 23:33">२३:३३</ref></char></note>पण परूशी अनी सदुकी पंथना लोकसपैकी बराच जणसले आपलाकडे बाप्तिस्मा लेवाकरता येतांना दखीन, त्यानी त्यासले सांगं, “अरे सापसना पिल्लासवन!” देवना येनारा क्रोधपाईन पळी जावाले तुमले कोणी सावध करं. <verse eid="MAT 3:7" /><verse number="8" style="v" sid="MAT 3:8" />बाप्तिस्मा लेवाना पहिले पापसपाईन फिरा शोभी असा सत्कर्म करा, <verse eid="MAT 3:8" /><verse number="9" style="v" sid="MAT 3:9" /><note caller="+" style="x"><char style="xo" closed="false">३:९ </char><char style="xt" closed="false"><ref loc="JHN 8:33">योहान ८:३३</ref></char></note>अनं अब्राहाम आमना बाप शे, अस मनमा आणु नका; कारण मी तुमले सांगस की, देव अब्राहाम करता दगडसपाईन संतती उत्पन्न कराले समर्थ शे! <verse eid="MAT 3:9" /><verse number="10" style="v" sid="MAT 3:10" /><note caller="+" style="x"><char style="xo" closed="false">३:१० </char><char style="xt" closed="false"><ref loc="MAT 7:19">मत्तय ७:१९</ref></char></note>आत्तेच झाडना मुळजोडे कुऱ्हाड ठेयेल शे, जे जे झाड चांगलं फळ देस नही, ते ते झाड तोडीसन अग्नीमा टाकामा येस. <verse eid="MAT 3:10" /><verse number="11" style="v" sid="MAT 3:11" />मी पाणीघाई तुमना बाप्तिस्मा पापसपाईन फिराकरता करस हाई खरं शे; पण जो मना मांगतीन ई ऱ्हायना तो मनापेक्षा इतला समर्थ शे की, मी त्याना जोडा उचलीन चालानी पण मनी लायकी नही शे, तो पवित्र आत्माघाई अनी अग्नीघाई तुमना बाप्तिस्मा कराव शे. <verse eid="MAT 3:11" /><verse number="12" style="v" sid="MAT 3:12" />त्याना हातमा त्यानं सुपडं शे, तो त्यानं खळं पुर्ण स्वच्छ करी, अनी आपला कोठारमा गहु गोया करीसन ठेई. पण जो भुस्सा राही त्याले नही वलावनारी अग्नीमा जाळी टाकी.<verse eid="MAT 3:12" /></para>
  <para style="s">येशुना बाप्तिस्मा</para>
  <para style="r">(<ref loc="MRK 1:9-11">मार्क १:९-११</ref>; <ref loc="LUK 3:21-22">लूक ३:२१-२२</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 3:13" />तवय येशु योहान कडतीन बाप्तिस्मा करी लेवाकरता गालील प्रदेशमा यार्देन नदीवर त्यानाकडे वना; <verse eid="MAT 3:13" /><verse number="14" style="v" sid="MAT 3:14" />पण योहान त्याले मना करीसन बोलना, मी तुमना हाततीन बाप्तिस्मा लेवाले पाहिजे, पण तुम्हीन मनाकडे कशा काय ई राहीनात? <verse eid="MAT 3:14" /><verse number="15" style="v" sid="MAT 3:15" />तवय येशु त्याले बोलना, आते हाई व्हऊ दे; कारण सर्व रिती प्रमाणे धार्मीक काम पुर्ण करनं हाई आपलाकरता चांगलं शे, तवय योहाननी तस व्हवु दिधं. <verse eid="MAT 3:15" /><verse number="16" style="v" sid="MAT 3:16" />मंग बाप्तिस्मा लेवावर येशु पाणीमाईन वर वना. अनी दखा, स्वर्ग उघडनं तवय परमेश्वरना आत्मा कबुतरना रूपमा उतरीन स्वतःवर ई राहिना अस त्याले दखायनं. <verse eid="MAT 3:16" /><verse number="17" style="v" sid="MAT 3:17" /><note caller="+" style="x"><char style="xo" closed="false">३:१७ </char><char style="xt" closed="false"><ref loc="MAT 12:18">मत्तय १२:१८</ref>; <ref loc="MAT 17:5">१७:५</ref>; <ref loc="MRK 1:11">मार्क १:११</ref>; <ref loc="LUK 9:35">लूक ९:३५</ref></char></note>अनी लगेच स्वर्गमाईन अशी वाणी व्हयनी की, हाऊ मना पोऱ्या माले परमप्रिय शे. मी त्यानावर संतुष्ट शे.<verse eid="MAT 3:17" /></para>
  <chapter eid="MAT 3" />
  <chapter number="4" style="c" sid="MAT 4" />
  <para style="s">येशुनी परिक्षा</para>
  <para style="r">(<ref loc="MRK 1:12">मार्क १:१२</ref>,<ref loc="MRK 1:13">१३</ref>; <ref loc="LUK 4:1-13">लूक ४:१-१३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 4:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१ </char>
      <char style="xt" closed="false">
        <ref loc="HEB 2:18">इब्री २:१८</ref>; <ref loc="HEB 4:15">४:१५</ref></char>
    </note>तवय सैतानकडतीन येशुनी परिक्षा व्हवाले पाहिजे म्हणीसन आत्मा त्याले जंगलमा लई गया. <verse eid="MAT 4:1" /><verse number="2" style="v" sid="MAT 4:2" />मंग त्यानी चाळीस दिन चाळीस रात उपवास करा, त्यानंतर त्याले भलती भूक लागनी. <verse eid="MAT 4:2" /><verse number="3" style="v" sid="MAT 4:3" />मंग सैतान येशुना जोडे ईसन त्याले बोलना; “तु देवना पोऱ्या शे, तर ह्या दगडले आज्ञा कर की, भाकर व्हई जा. <verse eid="MAT 4:3" /><verse number="4" style="v" sid="MAT 4:4" />पण येशुनी त्याले उत्तर दिधं, ‘माणुस फक्त भाकर खाईसन नही तर देवना मूख माईन निंघणारा प्रत्येक वचनघाई जगी, असा शास्त्रलेख शे.’” <verse eid="MAT 4:4" /><verse number="5" style="v" sid="MAT 4:5" />मंग सैतान येशुले पवित्र नगर यरूशलेममा लई गया अनी मंदिरना शेंडावर त्याले उभं करं; <verse eid="MAT 4:5" /><verse number="6" style="v" sid="MAT 4:6" />मंग त्यानी त्याले सांगं, “तु देवना पोऱ्या व्हशी तर आठेन खाल उडी मार,” कारण शास्त्रलेखमा अस लिखेल शे की, “तुनं रक्षण कराकरता देव आपला स्वर्गदूतसले तुनाबद्दल आज्ञा दि.” तुना पायसले दगडनी ठेच लागाले नको म्हणीन त्या तुले हातवर झेली लेतीन. <verse eid="MAT 4:6" /><verse number="7" style="v" sid="MAT 4:7" />मंग येशुनी त्याले उत्तर दिधं, आखो असा शास्त्रलेख शे की, परमेश्वर जो तुना देव त्यानी परिक्षा दखु नको. <verse eid="MAT 4:7" /><verse number="8" style="v" sid="MAT 4:8" />मंग सैतान त्याले एक भलता उचा डोंगरवर लई गया अनी त्याले जगमाधला सर्वा राज्य अनी त्यासनं वैभव फटकामा दखाडं, <verse eid="MAT 4:8" /><verse number="9" style="v" sid="MAT 4:9" />अनी त्याले सांगं, “जर तु पाया पडीन माले नमन करशी तर हाई सर्व तुनं व्हई जाई.” <verse eid="MAT 4:9" /><verse number="10" style="v" sid="MAT 4:10" />तवय येशुनी त्याले उत्तर दिधं, “अरे सैतान, आठेन चालता व्हय,” कारण अस शास्त्रमा लिखेल शे की, “परमेश्वर तुना देव यानी भक्ती कर, अनी फक्त त्यानीच सेवा कर!” <verse eid="MAT 4:10" /><verse number="11" style="v" sid="MAT 4:11" />मंग सैतान तठेन निंघी गया, अनी दखा, देवदूत ईसन त्यानी सेवा कराले लागनात.<verse eid="MAT 4:11" /></para>
  <para style="s">येशु प्रवचनले सुरवात करस.</para>
  <para style="r">(<ref loc="MRK 1:14-15">मार्क १:१४-१५</ref>; <ref loc="LUK 4:14-15">लूक ४:१४-१५</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 4:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१२ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 14:3">मत्तय १४:३</ref>; <ref loc="MRK 6:17">मार्क ६:१७</ref>; <ref loc="LUK 3:19">लूक ३:१९</ref>,<ref loc="LUK 3:20">२०</ref></char>
    </note>मंग योहानले कैदखानामा टाकं हाई ऐकीसन येशु गालीलमा गया; <verse eid="MAT 4:12" /><verse number="13" style="v" sid="MAT 4:13" /><note caller="+" style="x"><char style="xo" closed="false">४:१३ </char><char style="xt" closed="false"><ref loc="JHN 2:12">योहान २:१२</ref></char></note>अनी नासरेथ सोडीन जबूलून अनं नफताली यासना हद्दीमातला समुद्रना किनारावरला कफर्णहुम गावले जाईसन राहीना; <verse eid="MAT 4:13" /><verse number="14" style="v" sid="MAT 4:14" />हाई यानाकरता की, यशया संदेष्टानाद्वारा जे सांगेल व्हतं ते पुर्ण व्हयनं, ते अस की, <verse eid="MAT 4:14" /><verse number="15" style="v" sid="MAT 4:15" />जबूलून अनं नफताली प्रांत, समुद्र किनारावरला, यार्देनना पलीकडला देश, गैरयहूदी लोकसना गालील प्रांत. <verse eid="MAT 4:15" /><verse number="16" style="v" sid="MAT 4:16" />आठला अंधारामा बशेल लोकसनी मोठा उजेड दखा अनी ज्या मृत्युना प्रदेशमा, अनी छायामा बठेल व्हतात, त्यासनासाठे एक मोठी ज्योती उगम पावनी शे. <verse eid="MAT 4:16" /><verse number="17" style="v" sid="MAT 4:17" /><note caller="+" style="x"><char style="xo" closed="false">४:१७ </char><char style="xt" closed="false"><ref loc="MAT 3:2">मत्तय ३:२</ref></char></note>तवयपाईन येशु उपदेश करीसन सांगु लागना की, “पापसपाईन फिरा कारण स्वर्गनं राज्य जोडे येल शे!”<verse eid="MAT 4:17" /></para>
  <para style="s">येशु मासा धरणारासले बलावस</para>
  <para style="r">(<ref loc="MRK 1:16-20">मार्क १:१६-२०</ref>; <ref loc="LUK 5:1-11">लूक ५:१-११</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 4:18" />मंग येशु गालील समुद्रना जोडेतीन चाली राहिंता. तवय त्यानी शिमोन पेत्र अनी त्याना भाऊ आंद्रिया या दोन्ही भाऊसले समुद्रमा जाळं टाकतांना दखं; कारण त्या मासा धरणारा व्हतात. <verse eid="MAT 4:18" /><verse number="19" style="v" sid="MAT 4:19" />येशुनी त्यासले सांगं, “मनामांगे या, लोकसले देवना राज्यमा कसं लयतस, हाई मी तुमले शिकाडसु.” <verse eid="MAT 4:19" /><verse number="20" style="v" sid="MAT 4:20" />त्यासनी लगेच जाळं तठेच सोडं अनी त्या त्याना मांगे निंघनात. <verse eid="MAT 4:20" /><verse number="21" style="v" sid="MAT 4:21" />तठेन पुढे जावानंतर त्यानी दूसरा दोन्ही भाऊ म्हणजे, जब्दीना पोऱ्या याकोब, अनं योहान यासले आपला बाप जब्दीनासंगे नावमा जाळं सवारतांना दखं, अनी येशुनी त्यासले बलायं. <verse eid="MAT 4:21" /><verse number="22" style="v" sid="MAT 4:22" />मंग त्यासनी लगेच त्यासना बाप अनं नावले सोडीसन त्यानामांगे चालु लागनात.<verse eid="MAT 4:22" /></para>
  <para style="s">येशुनी सेवा</para>
  <para style="r">(<ref loc="LUK 6:17-19">लूक ६:१७-१९</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 4:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:२३ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:35">मत्तय ९:३५</ref>; <ref loc="MRK 1:39">मार्क १:३९</ref></char>
    </note>मंग येशु यहूदी लोकसना सभास्थानमा, प्रवचन करत अनं देवराज्यनी सुवार्ता गाजाडत सर्वा कमजोर अनं रोगीसले बरं करत गालीलभर फिरना; <verse eid="MAT 4:23" /><verse number="24" style="v" sid="MAT 4:24" />अनी त्यानी बातमी सिरिया देशभर पसरनी; तवय ज्या येग-येगळा प्रकारना रोगग्रस्त व्हतात, ज्या भूत लागेल, मिरगिवाला अनं लखवा व्हयेल व्हतात असा सर्वासले त्यानाकडे लयनात, अनी त्यानी त्यासले बरं करं. <verse eid="MAT 4:24" /><verse number="25" style="v" sid="MAT 4:25" />मंग गालील, दकापलीस<note caller="+" style="f"><char style="fr" closed="false">४:२५ </char><char style="fq" closed="false">दकापलीस </char><char style="ft" closed="false">दकापलीस म्हणजे दहा गावसनं शहर</char></note>, यरूशलेम, यहूदीया, अनं यार्देन नदीना पलीकडला प्रदेशमातीन लोकसनी गर्दी त्यानामांगे चालाले लागनी.<verse eid="MAT 4:25" /></para>
  <chapter eid="MAT 4" />
  <chapter number="5" style="c" sid="MAT 5" />
  <para style="s">डोंगरवरला उपदेश</para>
  <para style="r">(<ref loc="LUK 5:1-7:29">लूक ५:१–७:२९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 5:1" />तवय त्या लोकसमुदायले दखीन येशु डोंगरवर चढी गया, अनं तो बसना तवय त्याना शिष्य त्यानाजोडे वनात. <verse eid="MAT 5:1" /><verse number="2" style="v" sid="MAT 5:2" />मंग तो त्यासले शिकाडु लागना.<verse eid="MAT 5:2" /></para>
  <para style="s">खरा आनंद</para>
  <para style="r">(<ref loc="LUK 6:20-23">लूक ६:२०-२३</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 5:3" />“ज्या मनतीन गरीब त्या धन्य; कारण स्वर्गना राज्य त्यासनं शे!” <verse eid="MAT 5:3" /><verse number="4" style="v" sid="MAT 5:4" />ज्या शोक करतस त्या धन्य; कारण त्यासले सांत्वन भेटी. <verse eid="MAT 5:4" /><verse number="5" style="v" sid="MAT 5:5" />ज्या नम्र त्या धन्य, कारण त्या पृथ्वीना वारसदार व्हतीन. <verse eid="MAT 5:5" /><verse number="6" style="v" sid="MAT 5:6" />ज्या धार्मीकतेना भूक्या-तिशा त्या धन्य, कारण त्या तृप्त व्हतीन. <verse eid="MAT 5:6" /><verse number="7" style="v" sid="MAT 5:7" />ज्या दयाळु त्या धन्य, कारण त्यासनावर दया व्हई. <verse eid="MAT 5:7" /><verse number="8" style="v" sid="MAT 5:8" />ज्या मनना शुध्द त्या धन्य कारण त्या देवले दखतीन. <verse eid="MAT 5:8" /><verse number="9" style="v" sid="MAT 5:9" />ज्या शांती निर्माण करनारा त्या धन्य, कारण त्यासले देवना पोऱ्या म्हणतीन. <verse eid="MAT 5:9" /><verse number="10" style="v" sid="MAT 5:10" /><note caller="+" style="x"><char style="xo" closed="false">५:१० </char><char style="xt" closed="false"><ref loc="1PE 3:14">१ पेत्र ३:१४</ref></char></note>धार्मीकतामुये ज्यासना छळ व्हयेल शे, त्या धन्य, कारण स्वर्गनं राज्य त्यासनं शे. <verse eid="MAT 5:10" /><verse number="11" style="v" sid="MAT 5:11" /><note caller="+" style="x"><char style="xo" closed="false">५:११ </char><char style="xt" closed="false"><ref loc="1PE 4:14">१ पेत्र ४:१४</ref></char></note>मनामुये जवय लोक तुमनी निंदा अनं छळ करतीन, अनी तुमना विरूध्द सर्वा प्रकारन्या वाईट लबाडीमा बोलतीन तवय तुम्हीन धन्य. <verse eid="MAT 5:11" /><verse number="12" style="v" sid="MAT 5:12" /><note caller="+" style="x"><char style="xo" closed="false">५:१२ </char><char style="xt" closed="false"><ref loc="ACT 7:52">प्रेषित ७:५२</ref></char></note>आनंद करा, उल्लास करा, कारण स्वर्गमा तुमनं प्रतिफळ मोठं शे; कारण तुमना पहिले ज्या संदेष्टा व्हई गयात त्यासना त्यासनी तसाच छळ करा.<verse eid="MAT 5:12" /></para>
  <para style="s">मिठ अनं दिवावरतीन धडा</para>
  <para style="r">(<ref loc="MRK 9:50">मार्क ९:५०</ref>; <ref loc="LUK 14:34-35">लूक १४:३४-३५</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 5:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:१३ </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:50">मार्क ९:५०</ref>; <ref loc="LUK 14:34">लूक १४:३४</ref>,<ref loc="LUK 14:35">३५</ref></char>
    </note>तुम्हीन पृथ्वीना मीठ शेतस; पण जर मीठना खारटपणाच निंघी गया तर तो खारटपणा त्याले कशाघाई आणता ई? ते काय कामनं ऱ्हावाव नही, तर ते फेकाई जाई अनी लोकसना पायखाल चेंदाई जाई. <verse eid="MAT 5:13" /><verse number="14" style="v" sid="MAT 5:14" /><note caller="+" style="x"><char style="xo" closed="false">५:१४ </char><char style="xt" closed="false"><ref loc="JHN 8:12">योहान ८:१२</ref>; <ref loc="JHN 9:5">९:५</ref></char></note>तुम्हीन जगना प्रकाश शेतस; डोंगरवरलं शहर लपु शकस नही. <verse eid="MAT 5:14" /><verse number="15" style="v" sid="MAT 5:15" /><note caller="+" style="x"><char style="xo" closed="false">५:१५ </char><char style="xt" closed="false"><ref loc="MRK 4:21">मार्क ४:२१</ref>; <ref loc="LUK 8:16">लूक ८:१६</ref>; <ref loc="LUK 11:33">११:३३</ref></char></note>दिवा लाईसन चंपानाखाल ठेवतस नही, दिवठणीवर ठेवतस म्हणजे तो घरमधला सर्वासले प्रकाश देस. <verse eid="MAT 5:15" /><verse number="16" style="v" sid="MAT 5:16" /><note caller="+" style="x"><char style="xo" closed="false">५:१६ </char><char style="xt" closed="false"><ref loc="1PE 2:12">१ पेत्र २:१२</ref></char></note>तसच तुमना प्रकाश लोकससमोर असा पडू द्या की, त्यासनी तुमना सत्कर्म दखीसन तुमना स्वर्गमधला बापनं गौरव कराले पाहिजे.<verse eid="MAT 5:16" /></para>
  <para style="s">जुना नियमशास्त्र अनं येशुनी शिकवन</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 5:17" />अस नका समजा की, मी नियमशास्त्र अनं संदेष्टासना ग्रंथ नष्ट कराले येल शे; मी तर ते पुरं कराले येल शे. <verse eid="MAT 5:17" /><verse number="18" style="v" sid="MAT 5:18" /><note caller="+" style="x"><char style="xo" closed="false">५:१८ </char><char style="xt" closed="false"><ref loc="LUK 16:17">लूक १६:१७</ref></char></note>कारण मी तुमले सत्य सांगस की, जोपावत आकाश अनं पृथ्वी नष्ट व्हस नही तोपावत सर्वकाही पुरं व्हवाशिवाय नियमशास्त्रमधला एक बी कानामात्रा नष्ट व्हवावू नही. <verse eid="MAT 5:18" /><verse number="19" style="v" sid="MAT 5:19" />यामुये जो कोणी यामधली धाकलीत-धाकली एखादी आज्ञा नष्ट करीसन लोकसले शिकाडी त्याले स्वर्गना राज्यमा सर्वात धाकला म्हणतीन, पण तो जर सर्वा आज्ञा पाळी अनं लोकसले शिकाडी त्याले स्वर्गना राज्यमा सर्वात मोठा म्हणतीन. <verse eid="MAT 5:19" /><verse number="20" style="v" sid="MAT 5:20" />मी तुमले सांगस, शास्त्री अनं परूशी ह्यासपेक्षा तुमना नम्रपणा अधिक व्हवाशिवाय स्वर्गना राज्यमा तुमना प्रवेश व्हनारच नही.<verse eid="MAT 5:20" /></para>
  <para style="s">खून</para>
  <para style="r">(<ref loc="LUK 12:57-59">लूक १२:५७-५९</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 5:21" />खून करू नको अनं जो कोणी खून करी तो न्यायालयमा दंडकरता पात्र व्हई, हाई पुर्वजसनी सांगेल व्हतं, हाई तुम्हीन ऐकेल शे. <verse eid="MAT 5:21" /><verse number="22" style="v" sid="MAT 5:22" />मी तर तुमले सांगस, जो आपला भाऊवर बिनकामना संताप करी तो न्यायालयना शिक्षाना पात्र व्हई, जो कोणी आपला भाऊले, अरे येडा असं म्हनी तो उच्च न्यायालयना शिक्षाले पात्र व्हई; अनी जो कोणी त्याले, “अरे मुर्खा” असं म्हनी तो अग्नीनरकना शिक्षाले पात्र व्हई. <verse eid="MAT 5:22" /><verse number="23" style="v" sid="MAT 5:23" />यामुये जर तु देवले अर्पण कराले वेदीवर काही भेट लयना अनी तवय तुले आठवण व्हयनी की, मना भाऊले मनाबद्दल काही राग शे. <verse eid="MAT 5:23" /><verse number="24" style="v" sid="MAT 5:24" />तर आपली भेट वेदीना समोर सोडीसन पहिले आपला भाऊसंगे तडजोड कर, अनी मंग ईसन आपलं दान अर्पण कर. <verse eid="MAT 5:24" /><verse number="25" style="v" sid="MAT 5:25" />वाटवर तुना शत्रु तुनाबरोबर शे, तवय त्यानासंगे तडजोड कर, नही तर तो तुले न्यायाधिशना हातमा दि, न्यायाधिश तुले शिपाईसना हातमा दि, अनी शिपाई तुले कैदखानामा टाकतीन. <verse eid="MAT 5:25" /><verse number="26" style="v" sid="MAT 5:26" />मी तुले खरंखरं सांगस, जोपावत दमडीन दमडी फेडापावत तठेन तुनी सुटका व्हवाव नही.<verse eid="MAT 5:26" /></para>
  <para style="s">अशुध्दता</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 5:27" />व्यभिचार करू नको, हाई जे सांगेल व्हतं, ते तुम्हीन ऐकेल शे. <verse eid="MAT 5:27" /><verse number="28" style="v" sid="MAT 5:28" />मी तुमले सांगस, जो कोणी बाईकडे वाईट ईचारतीन दखस तवय त्यानी आपला मनमा तिनाबद्दल व्यभिचार करेलच शे. <verse eid="MAT 5:28" /><verse number="29" style="v" sid="MAT 5:29" /><note caller="+" style="x"><char style="xo" closed="false">५:२९ </char><char style="xt" closed="false"><ref loc="MAT 18:9">मत्तय १८:९</ref>; <ref loc="MRK 9:47">मार्क ९:४७</ref></char></note>जर तुना उजवा डोया तुले पाप कराले लावस, तर तु त्याले काढीसन फेकी दे! कारण तुनं पुरं शरीर नरकमा जावापेक्षा एक अवयवना नाश व्हवाले पाहिजे, हाई तुनाकरता जास्त चांगलं शे. <verse eid="MAT 5:29" /><verse number="30" style="v" sid="MAT 5:30" /><note caller="+" style="x"><char style="xo" closed="false">५:३० </char><char style="xt" closed="false"><ref loc="MAT 18:8">मत्तय १८:८</ref>; <ref loc="MRK 9:43">मार्क ९:४३</ref></char></note>तुना उजवा हात तुले पाप कराले लावस तर, तु त्याले कापी टाक! कारण तुनं पुरं शरीर नरकमा जावापेक्षा, तुना एक अवयवना नाश व्हई, हाई तुनाकरता जास्त चांगलं शे.<verse eid="MAT 5:30" /></para>
  <para style="s">सुटपत्रबद्दल शिक्षण</para>
  <para style="r">(<ref loc="MAT 19:9">मत्तय १९:९</ref>; <ref loc="MRK 10:11">मार्क १०:११</ref>,<ref loc="MRK 10:12">१२</ref>; <ref loc="LUK 16:18">लूक १६:१८</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 5:31" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:३१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:7">मत्तय १९:७</ref>; <ref loc="MRK 10:4">मार्क १०:४</ref></char>
    </note>जो कोणी बायकोले सुटपत्र देवाले दखसं त्यानी तिले सुटपत्र देवाले पाहिजे, हाई बी सांगेल व्हतं.<note caller="+" style="x"><char style="xo" closed="false">५:३१ </char><char style="xt" closed="false"><ref loc="MAT 24:1-14">२४:१-१४</ref></char></note> <verse eid="MAT 5:31" /><verse number="32" style="v" sid="MAT 5:32" /><note caller="+" style="x"><char style="xo" closed="false">५:३२ </char><char style="xt" closed="false"><ref loc="MAT 19:9">मत्तय १९:९</ref>; <ref loc="MRK 10:11">मार्क १०:११</ref>,<ref loc="MRK 10:12">१२</ref>; <ref loc="LUK 16:18">लूक १६:१८</ref>; <ref loc="1CO 7:10">१ करिंथ ७:१०</ref>,<ref loc="1CO 7:11">११</ref></char></note>मी तर तुमले सांगस, जो कोणी आपली बायकोले व्यभिचारना कारणतीन सोडस तर तो तीले व्यभिचारीनी बनाडस; अनी जो कोणी अशी सोडेल बाईसंगे लगीन करस तो बी व्यभिचार करस.<verse eid="MAT 5:32" /></para>
  <para style="s">शपथ अनं खरंपण</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 5:33" />“खोटी शपथ लेवु नको” तर “आपली शपथ देवनापुढे खरी कर” असं पुर्वजसले सांगेल व्हत, हाई तुम्हीन ऐकेल शे. <verse eid="MAT 5:33" /><verse number="34" style="v" sid="MAT 5:34" /><note caller="+" style="x"><char style="xo" closed="false">५:३४ </char><char style="xt" closed="false"><ref loc="JAS 5:12">याकोब ५:१२</ref>; </char><char style="xt" closed="false"><ref loc="MAT 23:22">मत्तय २३:२२</ref></char></note>मी तुमले सागंस, शप्पथ वाहू नका; अनी स्वर्गनी पण शप्पथ वाहू नका. कारण ते देवना राजासन शे. <verse eid="MAT 5:34" /><verse number="35" style="v" sid="MAT 5:35" />पृथ्वीनी पण शप्पथ वाहू नका, कारण ती देवनी पाय ठेवानी जागा शे अनी यरूशलेमनी पण शप्पथ वाहू नका, कारण ती “थोर राजानी नगरी शे.” <verse eid="MAT 5:35" /><verse number="36" style="v" sid="MAT 5:36" />आपला डोकानी पण शपथ वाहू नको, कारण तु डोकाना एक बी केस पांढरा अनं काया करू शकस नही. <verse eid="MAT 5:36" /><verse number="37" style="v" sid="MAT 5:37" />तुमले “हो” म्हणनं व्हई “हो” म्हणा, “नही” म्हणनं व्हई तर “नही” ऐवढच ऱ्हावाले पाहिजे; यातीन जे काही जास्त ते वाईट पाईन शे.<verse eid="MAT 5:37" /></para>
  <para style="s">सुड</para>
  <para style="r">(<ref loc="LUK 6:29-30">लूक ६:२९-३०</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 5:38" />“तुम्हीन हाई ऐकेल शे की, ‘डोयना बदलामा डोया’ अनं दातना बदलामा दात.” <verse eid="MAT 5:38" /><verse number="39" style="v" sid="MAT 5:39" />मी तर तुमले सांगस वाईट माणुसले अडावुच नका, कारण जो कोणी तुमना एक गालवर मारस, तर दुसरा गाल बी त्यानाकडे करा. <verse eid="MAT 5:39" /><verse number="40" style="v" sid="MAT 5:40" />जो कोणी जबरदस्तीतीन तुना गंजीफराक लेवाले दखस, त्याले तुना बाहेरना कपडा बी लेऊ दे; <verse eid="MAT 5:40" /><verse number="41" style="v" sid="MAT 5:41" />जो कोणी तुले जबरदस्तीतीन एक कोस लई जाई, त्यानासंगे तु दोन कोस जाय. <verse eid="MAT 5:41" /><verse number="42" style="v" sid="MAT 5:42" />जो तुनाकडे काही मांगस त्याले दे, अनी जो तुनाकडे उसनं मांगाले दखस त्यानापाईन पाठ फिरावु नको.<verse eid="MAT 5:42" /></para>
  <para style="s">शत्रुवर दया</para>
  <para style="r">(<ref loc="LUK 6:27-28">लूक ६:२७-२८</ref>,<ref loc="LUK 6:32-36">३२-३६</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 5:43" />आपला शेजारीसवर प्रिती कर, अनं शत्रुसना व्देष कर, अस सांगेल व्हतं, ते तुम्हीन ऐकेल शे. <verse eid="MAT 5:43" /><verse number="44" style="v" sid="MAT 5:44" />मी तर तुमले सांगस आपला शत्रुवर प्रिती करा, अनं ज्या तुमना छळ करतस त्यासनासाठे प्रार्थना करा. <verse eid="MAT 5:44" /><verse number="45" style="v" sid="MAT 5:45" />ते यानाकरता की तुम्हीन स्वर्गना पिताना पुत्र व्हवाले पाहिजे, कारण तो चांगलासवर अनं वाईटसवर पन आपला सुर्य उगाडस अनी धार्मीक अनं अधार्मिक मानससवर बी पाऊस पाडस. <verse eid="MAT 5:45" /><verse number="46" style="v" sid="MAT 5:46" />ज्या तुमनावर प्रिती करतस, त्यासनावर तुम्हीन प्रिती करी तर तुमले काय प्रतीफळ मिळी, कारण जकातदार बी तसच करतस ना? <verse eid="MAT 5:46" /><verse number="47" style="v" sid="MAT 5:47" />जवय तुम्हीन आपला बंधुसले नमस्कार करतस पण त्यामा काय विशेष? कारण गैरयहूदी पण तसच करतस ना? <verse eid="MAT 5:47" /><verse number="48" style="v" sid="MAT 5:48" />जशा तुमना स्वर्गीय पिता परीपुर्ण शे, “तस तुम्हीन पण पुर्ण व्हा.”<verse eid="MAT 5:48" /></para>
  <chapter eid="MAT 5" />
  <chapter number="6" style="c" sid="MAT 6" />
  <para style="s">गुप्त दान</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 6:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">६:१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 23:5">मत्तय २३:५</ref>
      </char>
    </note>तुम्हीन आपला धार्मीक कामे लोकसले दखाडाकरता करू नका, तसं करावर तुमना स्वर्गना पितापाईन तुमले प्रतिफळ मिळाव नही. <verse eid="MAT 6:1" /><verse number="2" style="v" sid="MAT 6:2" />यामुये तु जवय दानधर्म करस तवय लोकसनी आपला गौरव कराले पाहिजे म्हणीसन ढोंगी जसा सभास्थानमा अनी रस्तावर आपलापुढे शंख वाजाडतस तसं करू नको, मी तुमले सत्य सांगस की, त्यासले त्यानं प्रतिफळ मिळी जायेल शे. <verse eid="MAT 6:2" /><verse number="3" style="v" sid="MAT 6:3" />तु जवय दानधर्म करस, तवय तूना उजवा हात काय करस, हाई तुना डावा हातले समजाले नको. <verse eid="MAT 6:3" /><verse number="4" style="v" sid="MAT 6:4" />जवय तु दानधर्म करस, ते गुप्तपणे व्हवाले पाहिजे, म्हणजे तुले दखणारा, गुप्त पिता परमेश्वर तुले तूनं फळ दि.<verse eid="MAT 6:4" /></para>
  <para style="s">प्रभुनी प्रार्थना</para>
  <para style="r">(<ref loc="LUK 11:2-4">लूक ११:२-४</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 6:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">६:५ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 18:10-14">लूक १८:१०-१४</ref>
      </char>
    </note>तसच जवय तुम्हीन प्रार्थना करतस, तवय ढोंगीसनामायक करू नका; कारण लोकसनी आपले दखाले पाहिजे म्हणीसन सभास्थानमा अनं चवाटावर ऊभा राहिन प्रार्थना कराले त्यासले आवडस, मी तूमले सत्य सांगस की, त्यासले त्यासनं प्रतीफळ मिळी जायेल शे. <verse eid="MAT 6:5" /><verse number="6" style="v" sid="MAT 6:6" />तु जवय प्रार्थना करस, तवय तू आपला खोलीमा जाईसन दार लाव, अनी आपला गुप्तवासी पितानी प्रार्थना कर, म्हणजे तूना गुप्तवासी पिता तुले फळ दि. <verse eid="MAT 6:6" /><verse number="7" style="v" sid="MAT 6:7" />तुम्हीन जवय प्रार्थना करतस तवय गैरयहूदीस मायक बिनकामनं बडबड करू नका, आपण बराच बोलनुत म्हणीसन आपली मागणी मान्य व्हई अस त्यासले वाटस. <verse eid="MAT 6:7" /><verse number="8" style="v" sid="MAT 6:8" />तुम्हीन त्यासनामायक व्हवु नका, कारण तुमन्या ज्या गरजा शेतस हाई तुमना स्वर्गना पिताले, तुम्हीन त्यानाकडे मांगाना पहिले त्याले सर्व माहीत शे.<verse eid="MAT 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 6:9" />मंग तुम्हीन अशी प्रार्थना करा; हे आमना स्वर्ग माधला देवबाप, तुनं नाव पवित्र मानोत; <verse eid="MAT 6:9" /><verse number="10" style="v" sid="MAT 6:10" />तुनं राज्य येवो, जस स्वर्गमा तसं पृथ्वीवर बी तुना ईच्छाप्रमाणे व्हवो. <verse eid="MAT 6:10" /><verse number="11" style="v" sid="MAT 6:11" />आमनी रोजनी भाकर आज आमले दे; <verse eid="MAT 6:11" /><verse number="12" style="v" sid="MAT 6:12" />अनी जसं आम्हीन दुसरासना अपराध माफ करात, तसं तु पण आमना अपराध क्षमा कर; <verse eid="MAT 6:12" /><verse number="13" style="v" sid="MAT 6:13" />अनी आमले परिक्षामा पाडू नको; तर आमले पापमातीन सोडाव. कारण की, राज्य, सामर्थ्य, अनी गौरव, हाई सदासर्वकाळ तुनंच शे; आमेन. <verse eid="MAT 6:13" /><verse number="14" style="v" sid="MAT 6:14" /><note caller="+" style="x"><char style="xo" closed="false">६:१४ </char><char style="xt" closed="false"><ref loc="MRK 11:25">मार्क ११:२५</ref>,<ref loc="MRK 11:26">२६</ref></char></note>जर तुम्हीन लोकसना अपराधनी क्षमा करतस, तर तुमना स्वर्गीय पिता बी तुमले क्षमा करी. <verse eid="MAT 6:14" /><verse number="15" style="v" sid="MAT 6:15" />पण जर तुम्हीन लोकसले क्षमा कर नही, तर तुमना स्वर्गीय पिता बी तुमले क्षमा करावु नही.<verse eid="MAT 6:15" /></para>
  <para style="s">उपास</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 6:16" />तुम्हीन जवय उपास धरतस तवय ढोंगीसनामायक तोंड उतारीसन बठु नका. कारण आपला उपास शे अस लोकसनी दखावं म्हणीन त्या आपलं तोंड उतारतस, मी तुमले सत्य सांगस की, त्यासले त्यासनं प्रतीफळ भेटी जायेल शे. <verse eid="MAT 6:16" /><verse number="17" style="v" sid="MAT 6:17" />तु उपवास करस तवय आपला डोकाले तेल लाव. अनं तोंड धोय; <verse eid="MAT 6:17" /><verse number="18" style="v" sid="MAT 6:18" />हाई यानाकरता की, तु उपवास करस, हाई लोकसले नही तर तुना स्वर्गीय पिता याले दखावाले पाहिजे, म्हणजे तो तुले फळ दि.<verse eid="MAT 6:18" /></para>
  <para style="s">स्वर्गीय धन</para>
  <para style="r">(<ref loc="LUK 12:33-34">लूक १२:३३-३४</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 6:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">६:१९ </char>
      <char style="xt" closed="false">
        <ref loc="JAS 5:2">याकोब ५:२</ref>,<ref loc="JAS 5:3">३</ref></char>
    </note>स्वतःकरता पृथ्वीवर धन गोया करू नका; कारण त्याले उधी लागस अनं गंजीसन त्याना नाश व्हस, अनी चोर बी घर फोडीसन चोरी करतस; <verse eid="MAT 6:19" /><verse number="20" style="v" sid="MAT 6:20" />तर आपलाकरता स्वर्गमाधलं धन गोया करा; कारण तठे उधी अनं गंज लागीसन त्याना नाश व्हवावू नही, अनं चोर बी घर फोडीसन चोरी करस नही; <verse eid="MAT 6:20" /><verse number="21" style="v" sid="MAT 6:21" />कारण जठे तुमनं धन शे, तठे तुमनं मन बी लागी राही.<verse eid="MAT 6:21" /></para>
  <para style="s">प्रकाश अनी अंधार</para>
  <para style="r">(<ref loc="LUK 11:34-36">लूक ११:३४-३६</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 6:22" />डोया हाऊ शरिरना दिवा शे; जर तुना डोया निष्पाप व्हई तर तुनं सगळं शरीर प्रकाशमय व्हई; <verse eid="MAT 6:22" /><verse number="23" style="v" sid="MAT 6:23" />जर तुना डोया दोषी ऱ्हायना तर तुनं सगळं शरीर अंधकारमय व्हई; म्हणजे तुनामातील प्रकाश-अंधार ऱ्हायना तर तो अंधार कितला भयंकर व्हई!<verse eid="MAT 6:23" /></para>
  <para style="s">चिंता अनं देववर ईश्वास</para>
  <para style="r">(<ref loc="LUK 16:13">लूक १६:१३</ref>; <ref loc="LUK 12:22-31">१२:२२-३१</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 6:24" />तर कोणी दोन मालकसनी सेवा करू शकस नही, कारण तो एकना व्देष करी, तर दुसरानी सेवा करी; नही तर एकनासंगे चांगला वागी, तर दुसरानासंगे वाईट वागी; मंग तुम्हीन देवनी अनी धननी सेवा करू शकतस नही. <verse eid="MAT 6:24" /><verse number="25" style="v" sid="MAT 6:25" />यामुये मी तुमले सांगस की, आपला जिवबद्दल, म्हणजे आपण काय खावाले अनं काय पेवाले पाहिजे; अनी आपला शरिरबद्दल म्हणजे आपण काय पांघरानं, यानी चिंता करीसन बठु नका. कारण अन्नपेक्षा जिव, अनं कपडासपेक्षा शरीर जास्त महत्वनं शे की, नही? <verse eid="MAT 6:25" /><verse number="26" style="v" sid="MAT 6:26" />आकाशमधला पक्षीसकडे ध्यान दिसन दखा; त्या पेरतस बी नही, कापणी बी करतस नही, अनं कोठारसमा साठाडतस बी नही; तरी तुमना स्वर्गना देवबाप त्यासले खावाले देस. तुम्हीन तर त्यासनापेक्षा श्रेष्ठ शेतस की नही? <verse eid="MAT 6:26" /><verse number="27" style="v" sid="MAT 6:27" />तुमनामा, असा कोण समर्थ शे की, चिंता करीसन आयुष्यनी येळ तासभर वाढावू शकस? <verse eid="MAT 6:27" /><verse number="28" style="v" sid="MAT 6:28" />तसच कपडासकरता कशाले चिंता करतस? जंगलमधला फुलं दखा, त्या कशा वाढतस? त्या कष्ट नही करतस अनी सुत बी नही ईनतस. <verse eid="MAT 6:28" /><verse number="29" style="v" sid="MAT 6:29" />तरी मी तुमले सांगस, शलमोन राजासुध्दा त्याना वैभवमा त्या फुलसपैकी एकनामायक सुध्दा सजेल नव्हता. <verse eid="MAT 6:29" /><verse number="30" style="v" sid="MAT 6:30" />जे जंगलमाधलं गवत आज शे, अनी सकाय जाळाय जास, त्याले जर देव असा कपडा घालत व्हई, तर अहो अईश्वासीहो, तो तुमनी काळजी करीसन तुमले कपडा घालावू नही का? <verse eid="MAT 6:30" /><verse number="31" style="v" sid="MAT 6:31" />यामुये काय खावानं, काय पेवानं, अनी काय पांघरानं, असा म्हणीसन चिंता करत बठु नका. <verse eid="MAT 6:31" /><verse number="32" style="v" sid="MAT 6:32" />कारण हाई सर्व मिळाले पाहिजे म्हणीसन गैरयहूदी लोकेपण खटपट करत राहतस, तुमले ह्या सगळासनी गरज शे. हाई तुमना स्वर्गना देवबापले माहीत शे. <verse eid="MAT 6:32" /><verse number="33" style="v" sid="MAT 6:33" />तर तुम्हीन पहिले देवना राज्य अनी त्यानी धार्मीकता मिळाकरता त्याना शोध करा. म्हणजे त्यानासंगे ह्या सर्वा गोष्टी बी तुमले मिळतीन. <verse eid="MAT 6:33" /><verse number="34" style="v" sid="MAT 6:34" />यामुये सकायनी चिंता करीसन बसु नका, कारण सकायनी चिंता सकायले; अनी ज्या दिननं दुःख ते त्याच दिनकरता पुरं शे.<verse eid="MAT 6:34" /></para>
  <chapter eid="MAT 6" />
  <chapter number="7" style="c" sid="MAT 7" />
  <para style="s">इतरासना दोष काढाना बाबत</para>
  <para style="r">(<ref loc="LUK 6:37-38">लूक ६:३७-३८</ref>,<ref loc="LUK 6:41-42">४१-४२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 7:1" />कोणलेच दोषी ठरावु नका, म्हणजे देव तुमले दोषी ठरावनार नही. <verse eid="MAT 7:1" /><verse number="2" style="v" sid="MAT 7:2" /><note caller="+" style="x"><char style="xo" closed="false">७:२ </char><char style="xt" closed="false"><ref loc="MRK 4:24">मार्क ४:२४</ref></char></note>ज्याप्रकारमा तुम्हीन न्याय करशात, त्याच प्रकारमा देव तुमना न्याय करी, अनी ज्या मापघाई तुम्हीन मोजीन दिशात. त्याच मापघाई तुमले मोजीन देवामा ई. <verse eid="MAT 7:2" /><verse number="3" style="v" sid="MAT 7:3" />तुना डोयामाधलं मुसळ न दखता आपला भाऊना डोयामाधलं कुसळ कशाले दखस? <verse eid="MAT 7:3" /><verse number="4" style="v" sid="MAT 7:4" />किंवा तुना डोयामाधलं कुसळ माले काढु दे हाई आपला भाऊले तु कसं सांगस? दख, तुना डोयामा तर मुसळ शे. <verse eid="MAT 7:4" /><verse number="5" style="v" sid="MAT 7:5" />अरे ढोंगी, पहिले तुना डोयामाधलं मुसळ काढी टाक म्हणजे तुना भाऊना डोयामाधलं कुसळ काढाकरता तुले स्पष्ट दखाई. <verse eid="MAT 7:5" /><verse number="6" style="v" sid="MAT 7:6" />जे पवित्र शे ते कुत्रासले देऊ नका, अनी मोती डुकरसनासमोर टाकू नका, टाकशात तर त्या आपला पायखाल चेंदतीन अनी पल्टीसन तुमले फाडतीन.<verse eid="MAT 7:6" /></para>
  <para style="s">प्रार्थनानं महत्व</para>
  <para style="r">(<ref loc="LUK 11:9-13">लूक ११:९-१३</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 7:7" />मांगा म्हणजे तुमले भेटी, शोधा म्हणजे तुमले सापडी, ठोका म्हणजे तुमनाकरता उघडाई जाई; <verse eid="MAT 7:7" /><verse number="8" style="v" sid="MAT 7:8" />कारण जो कोणी मांगस त्याले भेटस, जो शोधस, त्याले सापडस अनी जो कोणी दार ठोकस त्यानाकरता उघडाई जास. <verse eid="MAT 7:8" /><verse number="9" style="v" sid="MAT 7:9" />आपला पोऱ्यानी जर भाकर मांगी तर तो त्याले दगड दि? <verse eid="MAT 7:9" /><verse number="10" style="v" sid="MAT 7:10" />अनी मासा मांगा तर त्याले साप दि, तुमनामा असा कोणता बाप शे? <verse eid="MAT 7:10" /><verse number="11" style="v" sid="MAT 7:11" />जर तुम्हीन वाईट राहीसन बी आपला पोऱ्यासले चांगलं काय ते देवाणं तुमले समजस, तर ज्या तुमना स्वर्गना देवबाप जोडे मांगतस, त्यासले तो कितल्या चांगल्या वस्तु अनं देणग्या दि? <verse eid="MAT 7:11" /><verse number="12" style="v" sid="MAT 7:12" /><note caller="+" style="x"><char style="xo" closed="false">७:१२ </char><char style="xt" closed="false"><ref loc="LUK 6:31">लूक ६:३१</ref></char></note>यामुये लोकसनी तुमनासंगे जसं वागाले पाहिजे अशी तुमनी ईच्छा शे. तसं तुम्हीन बी त्यासनासंगे वागा, कारण मोशेना नियमशास्त्र अनी संदेष्टा, हाईच शिकाडतस.<verse eid="MAT 7:12" /></para>
  <para style="s">दोन रस्ता</para>
  <para style="r">(<ref loc="LUK 13:24">लूक १३:२४</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 7:13" />धाकला दरवाजातीन मजारमा जा; कारण नाशकडे जावाना दरवाजा मोठा शे, अनं रस्ता पसरट शे, अनी त्यानामातीन जाणारा बराच शेतस; <verse eid="MAT 7:13" /><verse number="14" style="v" sid="MAT 7:14" />पण जिवनकडे जावाना दरवाजा, अनी रस्ता छोटा शे. अनं ज्यासले तो सापडस त्या थोडाच शेतस.<verse eid="MAT 7:14" /></para>
  <para style="s">खरा अनी खोटा शिक्षक</para>
  <para style="r">(<ref loc="LUK 6:43-44">लूक ६:४३-४४</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 7:15" />खोटा संदेष्टासपाईन संभाळीन राहा, कारण त्या मेंढरसना रूपमा येतीन, पण त्या मझारतीन क्रुर लांडगा शेतस. <verse eid="MAT 7:15" /><verse number="16" style="v" sid="MAT 7:16" />तुम्हीन त्यासले त्यासना फळवरतीन वळखशात, कारण काटासना झाडवरतीन द्राक्ष अनं रिंगनीना झाडवरतीन अंजिर काढतस का? <verse eid="MAT 7:16" /><verse number="17" style="v" sid="MAT 7:17" />त्याचप्रमाणे चांगला झाडले चांगलं फळ येस अनं वाईट झाडले वाईट फळ येस. <verse eid="MAT 7:17" /><verse number="18" style="v" sid="MAT 7:18" />चांगला झाडले वाईट फळ येस नही, अनं वाईट झाडले चांगलं फळ येस नही. <verse eid="MAT 7:18" /><verse number="19" style="v" sid="MAT 7:19" /><note caller="+" style="x"><char style="xo" closed="false">७:१९ </char><char style="xt" closed="false"><ref loc="MAT 3:10">मत्तय ३:१०</ref>; <ref loc="LUK 3:9">लूक ३:९</ref></char></note>ज्या-ज्या झाडले चांगलं फळ येस नही ते प्रत्येक झाड तोडीसन अग्नीमा टाकामा येस. <verse eid="MAT 7:19" /><verse number="20" style="v" sid="MAT 7:20" /><note caller="+" style="x"><char style="xo" closed="false">७:२० </char><char style="xt" closed="false"><ref loc="MAT 12:33">मत्तय १२:३३</ref></char></note>यामुये तुम्हीन त्यासले त्यासना फळवरतीन वळखशात.<verse eid="MAT 7:20" /></para>
  <para style="s">मि तुमले वळखस नही</para>
  <para style="r">(<ref loc="LUK 13:25-27">लूक १३:२५-२७</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 7:21" />माले प्रभुजी, प्रभुजी म्हणनारा सर्वासना स्वर्गना राज्यमा प्रवेश व्हई अस नही; तर जो मना स्वर्गना पिताना ईच्छाप्रमाणे वागस त्याना प्रवेश व्हई. <verse eid="MAT 7:21" /><verse number="22" style="v" sid="MAT 7:22" />न्यायना दिनले बराचजन माले सांगतीन, प्रभुजी-प्रभुजी आम्हीन तुना नावतीन संदेश दिधा, तुना नावतीन भूतं काढात, अनी तुना नावतीन मोठमोठला चमत्कार करात नही का? <verse eid="MAT 7:22" /><verse number="23" style="v" sid="MAT 7:23" />तवय मी त्यासले स्पष्ट सांगसु की, मनी अनी तुमनी कधीच ओळख नव्हती; अहो पापीसवन मनापाईन दूर व्हा.<verse eid="MAT 7:23" /></para>
  <para style="s">दोन घरसना पाया</para>
  <para style="r">(<ref loc="LUK 6:47-49">लूक ६:४७-४९</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 7:24" />जो कोणी मनं हाई वचन ऐकीसन त्यानाप्रमाणे वागस तो एक शहाणा माणुसना मायक ठरी; त्यानी आपलं घर खडकवर बांध; <verse eid="MAT 7:24" /><verse number="25" style="v" sid="MAT 7:25" />मंग पाऊस पडना, पूर वना, वारा बी सुटना, अनी त्या घरले लागना; तरी ते घर पडनं नही, कारण त्याना पाया खडकवर बांधेल व्हता. <verse eid="MAT 7:25" /><verse number="26" style="v" sid="MAT 7:26" />त्याचप्रमाणे जो कोणी मनं वचन ऐकीसन त्यानाप्रमाणे वागस नही तो एक मुर्ख माणुसना मायक ठरी; त्यानी आपलं घर वाळूवर बांधं, <verse eid="MAT 7:26" /><verse number="27" style="v" sid="MAT 7:27" />मंग पाऊस पडना, पुर वना, वारा बी सुटना, अनं त्या घरले लागना तवय ते लगेच पडीसन त्याना नाश व्हयना.<verse eid="MAT 7:27" /></para>
  <para style="s">येशुना अधिकार</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 7:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">७:२८ </char>
      <char style="xt" closed="false">
        <ref loc="MRK 1:22">मार्क १:२२</ref>; <ref loc="LUK 4:32">लूक ४:३२</ref></char>
    </note>येशुनी आपलं बोलनं बंद करावर अस व्हयनं की, त्या लोके त्यानं शिक्षण ऐकीन थक्क व्हई गयात; <verse eid="MAT 7:28" /><verse number="29" style="v" sid="MAT 7:29" />कारण तो शास्त्री लोकेसनामायक नही तर पुरा अधिकार त्यालेच शे, असा शिकाडी राहींता.<verse eid="MAT 7:29" /></para>
  <chapter eid="MAT 7" />
  <chapter number="8" style="c" sid="MAT 8" />
  <para style="s">येशु कुष्टरोगीले बरं करस</para>
  <para style="r">(<ref loc="MRK 1:40-45">मार्क १:४०-४५</ref>; <ref loc="LUK 5:12-16">लूक ५:१२-१६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 8:1" />मंग येशु डोंगरवरतीन उतरना तवय लोकसनी गर्दी त्यानामांगे चाली राहींती. <verse eid="MAT 8:1" /><verse number="2" style="v" sid="MAT 8:2" />तवय दखा, एक कुष्टरोगी येशुकडे ईसन त्याना पाया पडीन त्याले बोलना, प्रभुजी, तुमनी ईच्छा व्हई तर माले शुध्द करासाठे तुम्हीन समर्थ शेतस. <verse eid="MAT 8:2" /><verse number="3" style="v" sid="MAT 8:3" />तवय येशुनी हात पुढे करीसन त्याले स्पर्श करा अनं बोलना, मनी ईच्छा शे, तु शुध्द व्हय; अनं लगेच त्याना कुष्टरोग जाईसन तो बरा व्हयना. <verse eid="MAT 8:3" /><verse number="4" style="v" sid="MAT 8:4" />मंग येशुनी त्याले सांगं, संभाळ, हाई कोणलेच काही सांगु नको; तर तु जाईसन “याजकले दखाड अनी त्यासले खरं वाटाले पाहिजे म्हणीसन तुना शुध्दीकरण व्हवाकरता, जे अर्पण मोशेनी कराले लाई देयल शे ते कर.”<verse eid="MAT 8:4" /></para>
  <para style="s">येशु सुबेदारना सेवकले बरं करस</para>
  <para style="r">(<ref loc="LUK 7:1-10">लूक ७:१-१०</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 8:5" />मंग येशु कफर्णहुम गावले वना, तवय एक रोमी अधिकारी त्यानाकडे ईसन त्याले ईनंती करीसन बोलना, <verse eid="MAT 8:5" /><verse number="6" style="v" sid="MAT 8:6" />प्रभुजी, मना सेवक लखवामा भलताच पिडीसन घरमा पडेल शे. <verse eid="MAT 8:6" /><verse number="7" style="v" sid="MAT 8:7" />येशु त्याले बोलना, “मी ईसन त्याले बरं करसु.” <verse eid="MAT 8:7" /><verse number="8" style="v" sid="MAT 8:8" />तवय अधिकारीनी उत्तर दिधं, प्रभुजी तुम्हीन मना घर यावं, ईतली मनी लायकी नही; पण एक शब्द बोला म्हणजे मना सेवक बरा व्हई जाई. <verse eid="MAT 8:8" /><verse number="9" style="v" sid="MAT 8:9" />मी एक जबाबदार अधिकारी शे, अनी मना हातखाल शिपाई शेतस; मी एकले सांगस, जा! तर तो जास, एकले सांगं ये! तर तो येस, अनी सेवकले सांगं, हाई कर तर तो ते करस. <verse eid="MAT 8:9" /><verse number="10" style="v" sid="MAT 8:10" />हाई ऐकीसन येशुले आश्चर्य वाटनं, अनं आपलामांगे येणारा लोकसले तो बोलना, मी तुमले सत्य सांगस, एवढा ईश्वास माले इस्त्राएलमा बी दिसना नही. <verse eid="MAT 8:10" /><verse number="11" style="v" sid="MAT 8:11" /><note caller="+" style="x"><char style="xo" closed="false">८:११ </char><char style="xt" closed="false"><ref loc="LUK 13:29">लूक १३:२९</ref></char></note>मी तुमले सांगस की, “पुर्व अनं पश्चिमकडतीन” बराच लोके येतीन अनं स्वर्गना राज्यमा अब्राहाम, इसहाक, अनं याकोब, यासना पंगतमा बसतीन; <verse eid="MAT 8:11" /><verse number="12" style="v" sid="MAT 8:12" /><note caller="+" style="x"><char style="xo" closed="false">८:१२ </char><char style="xt" closed="false"><ref loc="MAT 22:13">मत्तय २२:१३</ref>; <ref loc="MAT 25:30">२५:३०</ref>; <ref loc="LUK 13:28">लूक १३:२८</ref></char></note>पण राज्यना पोऱ्या बाहेरना अंधारमा टाकाई जातीन, अनं तठे रडनं अनं दात खानं राही. <verse eid="MAT 8:12" /><verse number="13" style="v" sid="MAT 8:13" />मंग येशु रोमी अधिकारीले बोलना, जाय तु ईश्वास ठेयेल प्रमाणे तुले भेटी अनी त्याच येळले तो सेवक बरा व्हयना.<verse eid="MAT 8:13" /></para>
  <para style="s">येशु बराच रोगीसले बरं करस</para>
  <para style="r">(<ref loc="MRK 1:29-34">मार्क १:२९-३४</ref>; <ref loc="LUK 4:38-41">लूक ४:३८-४१</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 8:14" />जवय येशु पेत्रना घरमा गया, तवय शिमोननी सासु तापमा पडेल शे, अस त्यानी दखं. <verse eid="MAT 8:14" /><verse number="15" style="v" sid="MAT 8:15" />मंग येशुनी तिना हातले स्पर्श करा; अनं तिना ताप निंघी गया; अनी ती ऊठीसन त्यानी सेवा कराले लागनी. <verse eid="MAT 8:15" /><verse number="16" style="v" sid="MAT 8:16" />मंग संध्याकाय व्हयनी तवय लोकसनी बराच भूतं लागेलसले येशुकडे आणं; तवय त्यानी बोलीसन भूतं काढात अनं सर्वा रोगीसले बरं करं. <verse eid="MAT 8:16" /><verse number="17" style="v" sid="MAT 8:17" />“त्यानी आमना आजार स्वतःवर लिधात अनी आमना रोग सहन करात,” हाई जे यशया संदेष्टासनी सांगेल व्हतं ते पुर्ण व्हयनं.<verse eid="MAT 8:17" /></para>
  <para style="s">येशुना होणारा शिष्य</para>
  <para style="r">(<ref loc="LUK 9:57-62">लूक ९:५७-६२</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 8:18" />मंग येशुनी आपला आजुबाजूले लोकसनी गर्दी शे, अस दखीसन शिष्यसले तलावना पलीकडे जावानी आज्ञा करी. <verse eid="MAT 8:18" /><verse number="19" style="v" sid="MAT 8:19" />तवय शास्त्री ईसन त्याले बोलना, “गुरजी, आपण जठे, कोठे जाशात तठे मी तुमना मांगे ईसु.” <verse eid="MAT 8:19" /><verse number="20" style="v" sid="MAT 8:20" />येशु त्याले बोलना, कोल्हासकरता बिळा अनं आकाशमाधला पक्षीसले घरटा शेतस, पण मनुष्यना पोऱ्याले डोकं टेकाले जागा नही शे. <verse eid="MAT 8:20" /><verse number="21" style="v" sid="MAT 8:21" />तवय शिष्यसपैकी एकजण त्याले बोलना, प्रभुजी माले पहीले मना बापले पुराले जावु द्या. <verse eid="MAT 8:21" /><verse number="22" style="v" sid="MAT 8:22" />येशुनी उत्तर दिधं, तु मनामांगे ये ज्या मरेल शेतस त्यासले त्या मरेलसले पुरू दे.<verse eid="MAT 8:22" /></para>
  <para style="s">येशु वादयले शांत करस</para>
  <para style="r">(<ref loc="MRK 4:35-41">मार्क ४:३५-४१</ref>; <ref loc="LUK 8:22-25">लूक ८:२२-२५</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 8:23" />मंग येशु नावमा चढना तवय त्याना शिष्य त्यानासंगे गयात. <verse eid="MAT 8:23" /><verse number="24" style="v" sid="MAT 8:24" />तवय दखा, समुद्रमा मोठं वादय ऊठणं, ते इतलं मोठं व्हतं की, लाटासनी नावले झाकी टाकं, तवय येशु झोपेल व्हता. <verse eid="MAT 8:24" /><verse number="25" style="v" sid="MAT 8:25" />तवय त्या त्यानाजोडे ईसन त्याले ऊठाडीसन बोलु लागनात. “प्रभुजी, वाचाडा आम्ही बुडी ऱ्हायनुत.” <verse eid="MAT 8:25" /><verse number="26" style="v" sid="MAT 8:26" />अनं तो त्यासले बोलना, “अरे अईश्वासी, तुम्हीन इतला का बरं घाबरणात?” मंग त्यानी ऊठीसन समुद्र अनं वारा यासले धमकाडं अनी त्या लगेच शांत व्हयनात. <verse eid="MAT 8:26" /><verse number="27" style="v" sid="MAT 8:27" />त्या नावमधला माणसंसले आश्चर्य वाटनं अनं त्या बोलु लागनात, “हावु कोणता प्रकारना माणुस शे की, वारा, अनं समुद्र बी यानं ऐकतस.”<verse eid="MAT 8:27" /></para>
  <para style="s">येशु दोन भूत लागेल माणुससले बरं करस</para>
  <para style="r">(<ref loc="MRK 5:1-20">मार्क ५:१-२०</ref>; <ref loc="LUK 8:26-39">लूक ८:२६-३९</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 8:28" />मंग येशु पलीकडला गरसेकरसना प्रदेशमा गया, तवय दोन भूत लागेल माणसं कब्रस्तान माईन ईसन त्याले भेटनात; त्या ईतला भयानक अनं भितीदायक व्हतात की, त्या वाटवर कोणलेच जाणं शक्य नव्हतं. <verse eid="MAT 8:28" /><verse number="29" style="v" sid="MAT 8:29" />तवय दखा, त्या वरडीन बोलनात, “हे देवना पोऱ्या; तु आमनामा का बरं पडस? ठरायेल येळना अगोदर तु आमले आठे छळाले येल शे का?” <verse eid="MAT 8:29" /><verse number="30" style="v" sid="MAT 8:30" />तठेच त्यासनापाईन थोडा अंतरवर डुकरंसना मोठा कळप चरी राहींता. <verse eid="MAT 8:30" /><verse number="31" style="v" sid="MAT 8:31" />मंग त्या भूते त्याले ईनंती कराले लागनात की, जर तु आमले काढी ऱ्हायना तर आमले त्या डुकरंसना कळपमा धाड.<verse eid="MAT 8:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 8:32" />मंग येशुनी त्यासले सांगं, “जा,” अनी त्या जाईसन त्या डुकरंसमा घुसनात; अनं दखा, तो डुकरंसना कळप कडावरतीन पळत जाईसन समुद्रमा पडना अनी तठेच त्या बुडिसन मरनात. <verse eid="MAT 8:32" /><verse number="33" style="v" sid="MAT 8:33" />मंग डुकरं चारनारा पळनात अनं नगरमा जाईसन भूत लागेल माणुसबद्दल अनी तठे घडेल सर्व घटनाबद्दल त्यासनी लोकसले सांगं. <verse eid="MAT 8:33" /><verse number="34" style="v" sid="MAT 8:34" />तवय दखा, सर्व नगरना लोके येशुले भेटाले निंघनात अनी त्याले दखीसन, त्यासनी त्याले आमना गावमाईन निंघी जा अशी ईनंती करी.<verse eid="MAT 8:34" /></para>
  <chapter eid="MAT 8" />
  <chapter number="9" style="c" sid="MAT 9" />
  <para style="s">येशु लखवा व्हयेल माणुसले बरा करस</para>
  <para style="r">(<ref loc="MRK 2:1-12">मार्क २:१-१२</ref>; <ref loc="LUK 5:17-26">लूक ५:१७-२६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 9:1" />तवय येशु नावमा बशीसन आपला पलीकडला शहरमा जाईसन पोहचना. <verse eid="MAT 9:1" /><verse number="2" style="v" sid="MAT 9:2" />मंग दखा, खाटवर पडेल एक लखवा व्हयेल माणुसले त्यानाकडे आणं, तवय येशु त्यासना ईश्वास दखीसन लखवा व्हयेल माणुसले बोलना, पोऱ्या धीर धर; तुना पापसनी क्षमा व्हयेल शे. <verse eid="MAT 9:2" /><verse number="3" style="v" sid="MAT 9:3" />मंग दखा, काही शास्त्री आपला आपलामा बोलनात, “हाऊ चुकीनं बोलस!”<verse eid="MAT 9:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 9:4" />येशु त्यासना ईचार वळखीसन बोलना, “तुम्हीन आपला मनमा वाईट ईचार का बरं आणतस? <verse eid="MAT 9:4" /><verse number="5" style="v" sid="MAT 9:5" />कारण ‘तुना पापनी क्षमा व्हयेल शे’ अस बोलनं, किंवा ‘ऊठीसन चाल’ अस बोलनं, ह्या मातीन कोणतं सोपं शे? <verse eid="MAT 9:5" /><verse number="6" style="v" sid="MAT 9:6" />कारण मनुष्यना पोऱ्याले पृथ्वीवर पापसनी क्षमा कराना अधिकार शे हाई तुमले समजाले पाहिजे.” म्हणीसन मंग तो लखवा व्हयेल माणुसले बोलना, “ऊठ, तुनी खाट उचलीन घर जाय!”<verse eid="MAT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 9:7" />मंग तो ऊठीसन आपला घर गया. <verse eid="MAT 9:7" /><verse number="8" style="v" sid="MAT 9:8" />हाई दखीसन लोके घाबरी गयात, अनी ज्या देवनी माणुसले एवढा अधिकार दिधा त्यासनी देवना गौरव करा.<verse eid="MAT 9:8" /></para>
  <para style="s">मत्तय नावना माणुसले पाचारण</para>
  <para style="r">(<ref loc="MRK 2:13-17">मार्क २:१३-१७</ref>; <ref loc="LUK 5:27-32">लूक ५:२७-३२</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 9:9" />मंग तठेन जातांना येशुनी मत्तय नावना माणुसले जकात नाकावर बशेल दखं अनी त्याले बोलना, मनामांगे ये; तवय तो ऊठीसन त्यानामांगे गया. <verse eid="MAT 9:9" /><verse number="10" style="v" sid="MAT 9:10" /><note caller="+" style="x"><char style="xo" closed="false">९:१० </char><char style="xt" closed="false"><ref loc="LUK 15:1">लूक १५:१</ref>,<ref loc="LUK 15:2">२</ref></char></note>नंतर अस व्हयनं की, तो घरमा जेवाले बशेल व्हता, दखा, तवय बराच जकातदार अनं पापी लोके ईसन येशु अनं त्याना शिष्य यासनासंगे पंगतमा जेवाले बठनात. <verse eid="MAT 9:10" /><verse number="11" style="v" sid="MAT 9:11" />हाई दखीसन परूशी त्याना शिष्यसले बोलनात, तुमना गुरू जकातदार अनं पापी लोकससंगे का बरं जेवस? <verse eid="MAT 9:11" /><verse number="12" style="v" sid="MAT 9:12" />हाई ऐकीन येशु त्यासले बोलना, निरोगीसले वैद्यनी गरज नही, तर रोगीसले शे. <verse eid="MAT 9:12" /><verse number="13" style="v" sid="MAT 9:13" /><note caller="+" style="x"><char style="xo" closed="false">९:१३ </char><char style="xt" closed="false"><ref loc="MAT 12:7">मत्तय १२:७</ref></char></note>“माले दया पाहिजे, यज्ञ नको” याना अर्थ काय, हाई जाईन शिका; कारण मी न्यायीसले नही तर पापी लोकसले बलावाकरता येल शे.<verse eid="MAT 9:13" /></para>
  <para style="s">उपासना प्रश्न</para>
  <para style="r">(<ref loc="MRK 2:18-22">मार्क २:१८-२२</ref>; <ref loc="LUK 5:33-39">लूक ५:३३-३९</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 9:14" />त्या येळले योहानना शिष्य येशुकडे ईसन त्याले बोलनात, आम्हीन अनं परूशी लोके पुष्कळ उपास करतस पण तुमना शिष्य उपास करतस नही, ह्यानं कारण काय? <verse eid="MAT 9:14" /><verse number="15" style="v" sid="MAT 9:15" />मंग येशु त्यासले बोलना, जोपावत वऱ्हाडीसनासंगे नवरदेव शे तोपावत त्यासले भूक्या राहावाई का? तरी असा दिन येतीन की, नवरदेवले त्यासनापाईन लई जातीन, तवय त्या उपास करतीन. <verse eid="MAT 9:15" /><verse number="16" style="v" sid="MAT 9:16" />कोणी नवा कपडानं ठिगळं जुना कपडाले लावतस नही; कारण चांगलाकरता लायेल ठिगळं त्या जुना कपडाले फाडी टाकस अनं छिद्र मोठं करी टाकस. <verse eid="MAT 9:16" /><verse number="17" style="v" sid="MAT 9:17" />कोणी नवा द्राक्षरस जुना कापडाघाई बनाडेल थैलीमा ठेवतस नही; ठेवा तर थैली फाटीन द्राक्षरस सांडाई जाई अनी थैलीना नाश व्हस; म्हणीसन नवा द्राक्षरस नवा थैलीमा ठेवतस म्हणजे त्या दोन्ही नीट राहतस.<verse eid="MAT 9:17" /></para>
  <para style="s">याईरनी पोर अनं रक्तस्रावी बाई</para>
  <para style="r">(<ref loc="MRK 5:21-43">मार्क ५:२१-४३</ref>; <ref loc="LUK 8:40-56">लूक ८:४०-५६</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 9:18" />येशु त्यानासंगे बोली राहींता तवय दखा, एक अधिकारी ईसन त्याना पाया पडीसन बोलना, “मनी पोर इतलामा मरनी, तरी तुम्हीन ईसन तिना डोकावर आपला हात ठेवा म्हणजे ती जिवत व्हई.” <verse eid="MAT 9:18" /><verse number="19" style="v" sid="MAT 9:19" />तवय येशु ऊठना अनं त्याना शिष्यससंगे त्या अधिकारीना मांगे जावाले लागना. <verse eid="MAT 9:19" /><verse number="20" style="v" sid="MAT 9:20" />मंग, दखा बारा वरीस पाईन रक्तस्रावना आजार व्हयेल एक बाईनी येशुना मांगेन ईसन त्याना कपडाना गोंडाले स्पर्श करा. <verse eid="MAT 9:20" /><verse number="21" style="v" sid="MAT 9:21" />कारण ती आपला मनमा बोलनी, की मी त्याना कपडासले जरी हात लावसु तरी बरी व्हसू. <verse eid="MAT 9:21" /><verse number="22" style="v" sid="MAT 9:22" />तवय येशु मांगे वळीसन तिले दखीन बोलना, “बाई, धीर धर! तुना ईश्वासनी तुले बरं करेल शे,” अनं ती बाई त्याच घटकाले बरी व्हयनी. <verse eid="MAT 9:22" /><verse number="23" style="v" sid="MAT 9:23" />मंग येशु अधिकारीना घरमा जाईन पावा वाजणारासले अनं शोक करनारा लोकसनी गर्दीले दखीसन बोलना, <verse eid="MAT 9:23" /><verse number="24" style="v" sid="MAT 9:24" />“वाट सोडा, कारण पोर मरेल नही; ती झोपेल शे!” तवय त्या त्यानी टिंगल करू लागनात. <verse eid="MAT 9:24" /><verse number="25" style="v" sid="MAT 9:25" />मंग लोकसले बाहेर काढानंतर त्यानी मझार जाईसन त्या पोरना हातले धरं अनी ती लगेच ऊठनी. <verse eid="MAT 9:25" /><verse number="26" style="v" sid="MAT 9:26" />हाई बातमी देशना त्या प्रांतमा पसरी गयी.<verse eid="MAT 9:26" /></para>
  <para style="s">येशु दोन आंधयासले बरं करस</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 9:27" />मंग येशु तठेन जाई राहींता, तवय, दोन आंधया त्यानामांगे जाईसन जोरमा वरडीसन बोलनात, अहो दावीदना पोऱ्या, आमनावर दया कर. <verse eid="MAT 9:27" /><verse number="28" style="v" sid="MAT 9:28" />तो घरमा गया तवय त्या आंधया त्याना जवय वनात; मंग येशु त्यासले बोलना, मी तुमले बरा करू शकस असा तुमना ईश्वास शे का? त्या त्याले बोलनात, हा प्रभु. <verse eid="MAT 9:28" /><verse number="29" style="v" sid="MAT 9:29" />तवय तो त्यासना डोयाले स्पर्श करीसन बोलना, तुमना ईश्वास प्रमाणे तुमले भेटो. <verse eid="MAT 9:29" /><verse number="30" style="v" sid="MAT 9:30" />तवय त्यासले दखावाले लागनं; मंग येशुनी त्यासले बजाडीन सांगं, की, दखा, कोणलेच समजाले नको म्हणीन संभाळा. <verse eid="MAT 9:30" /><verse number="31" style="v" sid="MAT 9:31" />तवय त्यासनी तठेन जाईसन सर्वा देशभर त्यानी किर्ती गाजाडी.<verse eid="MAT 9:31" /></para>
  <para style="s">येशु मुका भूत लागेल माणुसले बरा करस</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 9:32" />मंग त्या तठेन जाई राहींतात, दखा, लोके एक मुका भूत लागेल माणुसले त्यानाकडे लई वनात. <verse eid="MAT 9:32" /><verse number="33" style="v" sid="MAT 9:33" />येशुनी ते भूत काढावर तो मुका बोलु लागना; तवय लोकसमुदाय नवल करीसन बोलनात, इस्त्राएलमा अस कधीच दखामा येल नव्हतं; <verse eid="MAT 9:33" /><verse number="34" style="v" sid="MAT 9:34" /><note caller="+" style="x"><char style="xo" closed="false">९:३४ </char><char style="xt" closed="false"><ref loc="MAT 10:25">मत्तय १०:२५</ref>; <ref loc="MAT 12:24">१२:२४</ref>; <ref loc="MRK 3:22">मार्क ३:२२</ref>; <ref loc="LUK 11:15">लूक ११:१५</ref></char></note>पण परूशी बोलनात, हाऊ भूतसना राजानी मदत लिसन भूत काढस.<verse eid="MAT 9:34" /></para>
  <para style="s">कामगार थोडाच शेतस</para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 9:35" />
    <note caller="+" style="x">
      <char style="xo" closed="false">९:३५ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:23">मत्तय ४:२३</ref>; <ref loc="MRK 1:39">मार्क १:३९</ref>; <ref loc="LUK 4:44">लूक ४:४४</ref></char>
    </note>मंग येशु त्यासना सभास्थानमा देवराज्यनी सुवार्ता प्रचार गाजाडत, सर्वा कमजोर अनं रोगीसले बरं करत गावेगाव अनं शहरसमा फिरी राहींता. <verse eid="MAT 9:35" /><verse number="36" style="v" sid="MAT 9:36" /><note caller="+" style="x"><char style="xo" closed="false">९:३६ </char><char style="xt" closed="false"><ref loc="MRK 6:34">मार्क ६:३४</ref></char></note>तवय लोक समुदायले दखीसन त्याले त्यासनी किव वनी, कारण त्या बिन मेंढपाळना मेंढरंसना मायक किदरेल अनी भटकेल व्हतात. <verse eid="MAT 9:36" /><verse number="37" style="v" sid="MAT 9:37" /><note caller="+" style="x"><char style="xo" closed="false">९:३७ </char><char style="xt" closed="false"><ref loc="LUK 10:2">लूक १०:२</ref></char></note>मंग तो त्याना शिष्यसले बोलना, पिक बराच शे, पण काम करनारा थोडाच शेतस; <verse eid="MAT 9:37" /><verse number="38" style="v" sid="MAT 9:38" />यामुये पिकना मालकनी कापणी कराले काम करनारासले धाडाले पाहिजे म्हणीसन तुम्हीन प्रार्थना करा.<verse eid="MAT 9:38" /></para>
  <chapter eid="MAT 9" />
  <chapter number="10" style="c" sid="MAT 10" />
  <para style="s">बारा शिष्य</para>
  <para style="r">(<ref loc="MRK 3:13-19">मार्क ३:१३-१९</ref>; <ref loc="LUK 6:12-16">लूक ६:१२-१६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 10:1" />तवय येशुनी आपला बारा शिष्यसले जोडे बलाईसन भूते काढाना अनी सर्वा रोग अनं सर्वा दुर्बलसले बरं कराना अधिकार दिधा. <verse eid="MAT 10:1" /><verse number="2" style="v" sid="MAT 10:2" />त्या बारा शिष्यसना नावे असा शेतस पहिला, पेत्र ज्याले शिमोन म्हणतस अनं त्याना भाऊ अंद्रिया; जब्दीना पोऱ्या याकोब, अनं त्याना भाऊ योहान, <verse eid="MAT 10:2" /><verse number="3" style="v" sid="MAT 10:3" />फिलीप्प अनं बर्थलमय; थोमा, अनं मत्तय जकातदार; अल्फीना पोऱ्या याकोब अनं तद्दय; <verse eid="MAT 10:3" /><verse number="4" style="v" sid="MAT 10:4" />शिमोन कनानी अनं येशुले धरीसन देणारा यहुदा इस्कर्योत.<verse eid="MAT 10:4" /></para>
  <para style="s">बारा शिष्यनं काम</para>
  <para style="r">(<ref loc="MRK 6:7-13">मार्क ६:७-१३</ref>; <ref loc="LUK 9:1-6">लूक ९:१-६</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 10:5" />ह्या बारा जणसले येशुनी अशी आज्ञा करीसन धाडं, की, गैरयहूदीसकडे जावानी वाट वरतीन जाऊ नका, अनं शोमरोनी लोकसना कोणताच शहरमा जावू नका; <verse eid="MAT 10:5" /><verse number="6" style="v" sid="MAT 10:6" />तर इस्त्राएलसना घरमधला दवडेल मेंढरसकडे जा. <verse eid="MAT 10:6" /><verse number="7" style="v" sid="MAT 10:7" />अनी जावाना येळले अशी घोषणा करा की, स्वर्गना राज्य जोडे येल शे. <verse eid="MAT 10:7" /><verse number="8" style="v" sid="MAT 10:8" />अनं रोगीसले बरं करा, मरेलसले ऊठाडा, कोड लागलेसले शुध्द करा, अनं भूते काढा कारण जे तुमले मोफत मिळनं ते तुम्हीन मोफत द्या. <verse eid="MAT 10:8" /><verse number="9" style="v" sid="MAT 10:9" />सोनं, चांदी अनं तांबाना पैसा आपला कंबरबंधमा लेवु नका; <verse eid="MAT 10:9" /><verse number="10" style="v" sid="MAT 10:10" /><note caller="+" style="x"><char style="xo" closed="false">१०:१० </char><char style="xt" closed="false"><ref loc="1CO 9:14">१ करिंथ ९:१४</ref>; <ref loc="1TI 5:18">१ तिमथ्य ५:१८</ref></char></note>प्रवासकरता झोळी, दुसरा कपडा, जोडा लेवु नका, कारण काम करनारासनं पोषण व्हवाकरता हाई योग्य शे.<verse eid="MAT 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 10:11" />ज्या ज्या शहरमा गावसमा तुम्हीन जाशात तठे कोण योग्य शे हाई शोधी काढा अनं तुम्हीन तठेन निंघतस तोपावत त्यासना आठेच राहा; <verse eid="MAT 10:11" /><verse number="12" style="v" sid="MAT 10:12" />जवय तुम्हीन त्या घरमा जाशात तवय तठे तुमले शांती मिळो असं म्हणा; <verse eid="MAT 10:12" /><verse number="13" style="v" sid="MAT 10:13" />ते घर चांगलं ऱ्हायनं तर तुम्हीन देयल शांतीना आशिर्वाद त्यासले लागो; अनं जर त्या चांगला नही राहीनात तर तो आशिर्वाद तुमनाकडे परत येवो. <verse eid="MAT 10:13" /><verse number="14" style="v" sid="MAT 10:14" /><note caller="+" style="x"><char style="xo" closed="false">१०:१४ </char><char style="xt" closed="false"><ref loc="ACT 13:51">प्रेषित १३:५१</ref></char></note>जो कोणी तुमनं स्वागत करावं नही, अनं तुमनं वचन ऐकावु नही, त्या घरमातीन किंवा शहरमातीन निंघतांना आपला पायनी धुळ झटकी टाका. <verse eid="MAT 10:14" /><verse number="15" style="v" sid="MAT 10:15" /><note caller="+" style="x"><char style="xo" closed="false">१०:१५ </char><char style="xt" closed="false"><ref loc="MAT 11:24">मत्तय ११:२४</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">१०:१५ </char><char style="xt" closed="false"><ref loc="LUK 10:4-12">लूक १०:४-१२</ref></char></note>मी तुमले सत्य सांगस, न्यायना दिनले त्या शहरनापेक्षा सदोम अनं गमोरा ह्या प्रदेशले सोपं जाई.<verse eid="MAT 10:15" /></para>
  <para style="s">दुःख अनी तरास</para>
  <para style="r">(<ref loc="MRK 6:9-13">मार्क ६:९-१३</ref>; <ref loc="LUK 21:12-17">लूक २१:१२-१७</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 10:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१०:१६ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:3">लूक १०:३</ref>
      </char>
    </note>लांडगासमा जसं मेंढरूले धाडतस तसं मी तुमले धाडी ऱ्हायनु म्हणीसन तुम्हीन सापनामायक चपळ अनं कबुतरना मायक भोळा बना. <verse eid="MAT 10:16" /><verse number="17" style="v" sid="MAT 10:17" /><note caller="+" style="x"><char style="xo" closed="false">१०:१७ </char><char style="xt" closed="false"><ref loc="MRK 13:9-11">मार्क १३:९-११</ref>; <ref loc="LUK 12:11">लूक १२:११</ref>,<ref loc="LUK 12:12">१२</ref>; <ref loc="LUK 21:12-15">२१:१२-१५</ref></char></note>लोकसपाईन सावध राहा; कारण त्या तुमले न्यायलयना स्वाधीन करतीन, अनी त्यासना सभास्थानमा तुमले फटका मारतीन, <verse eid="MAT 10:17" /><verse number="18" style="v" sid="MAT 10:18" />अनी देशना अधिकारीसले, राजासले अनं गैरयहूदीसले समजाले पाहिजे की तुम्हीन मना साक्षीदार शेतस, म्हणीसन तुमले त्यासनासमोर नेतीन. <verse eid="MAT 10:18" /><verse number="19" style="v" sid="MAT 10:19" />जवय तुमले त्यासना स्वाधीन करतीन तवय कसं काय बोलानं यानी चिंता करू नका, कारण तुमले जे काही बोलना शे हाई त्याच येळले तुमले सुचाडाई जाई. <verse eid="MAT 10:19" /><verse number="20" style="v" sid="MAT 10:20" />कारण बोलणारा तुम्हीन नही, तर तुमना स्वर्गना बापना आत्मा हाऊच तुमनामा बोलणारा शे,<verse eid="MAT 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 10:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१०:२१ </char>
      <char style="xt" closed="false">
        <ref loc="MRK 13:12">मार्क १३:१२</ref>; <ref loc="LUK 21:16">लूक २१:१६</ref></char>
    </note>भाऊ भाऊले अनी बाप आपला पोऱ्याले मारा करता धरी दि; पोऱ्या मायबापसं विरूध्द ऊठतीन, त्यासले मारी टाकतीन; <verse eid="MAT 10:21" /><verse number="22" style="v" sid="MAT 10:22" /><note caller="+" style="x"><char style="xo" closed="false">१०:२२ </char><char style="xt" closed="false"><ref loc="MAT 24:9">मत्तय २४:९</ref>; <ref loc="MRK 13:13">मार्क १३:१३</ref>; <ref loc="LUK 21:17">लूक २१:१७</ref>; </char><char style="xt" closed="false"><ref loc="MAT 24:13">मत्तय २४:१३</ref>; <ref loc="MRK 13:13">मार्क १३:१३</ref></char></note>मना नावमुये सर्वा लोके तुमनी निंदा करतीन; पण जो शेवटपावत टिकी राही त्यानंच तारण व्हई. <verse eid="MAT 10:22" /><verse number="23" style="v" sid="MAT 10:23" />जवय एक गावमा तुमना छळ व्हई तवय दुसरा गावमा पळी जा; मी तुमले खरंखरं सांगस की, याना पहिले तुमनं इस्त्राएलना सर्वा नगरसमा फिरीनं व्हस नही, तोपावत मनुष्यना पोऱ्या ई जाई. <verse eid="MAT 10:23" /><verse number="24" style="v" sid="MAT 10:24" /><note caller="+" style="x"><char style="xo" closed="false">१०:२४ </char><char style="xt" closed="false"><ref loc="LUK 6:40">लूक ६:४०</ref>; </char><char style="xt" closed="false"><ref loc="JHN 13:16">योहान १३:१६</ref>; <ref loc="JHN 15:20">१५:२०</ref></char></note>गुरूपेक्षा शिष्य थोर नही अनी मालकपेक्षा नोकर थोर नही. <verse eid="MAT 10:24" /><verse number="25" style="v" sid="MAT 10:25" /><note caller="+" style="x"><char style="xo" closed="false">१०:२५ </char><char style="xt" closed="false"><ref loc="MAT 9:34">मत्तय ९:३४</ref>; <ref loc="MAT 12:24">१२:२४</ref>; <ref loc="MRK 3:22">मार्क ३:२२</ref>; <ref loc="LUK 11:15">लूक ११:१५</ref></char></note>शिष्यसनी गुरूनामायक अनी नोकरनी मालकनामायक व्हावं, इतलंच त्यासले पुरं, घर धनीले सैतान म्हणतस, तर घरना लोकसले का बरं नही म्हणतीन<note caller="+" style="x"><char style="xo" closed="false">१०:२५ </char><char style="xt" closed="false"><ref loc="LUK 11:15">लूक ११:१५</ref></char></note>?<verse eid="MAT 10:25" /></para>
  <para style="s">कोणले घाबरानं</para>
  <para style="r">(<ref loc="LUK 12:2-7">लूक १२:२-७</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 10:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१०:२६ </char>
      <char style="xt" closed="false">
        <ref loc="MRK 4:22">मार्क ४:२२</ref>; <ref loc="LUK 8:17">लूक ८:१७</ref></char>
    </note>यामुये त्यासले घाबरू नका; कारण उघडामा ई अस काहीच झाकायल नही अनी कळाव नही अस काहीच गुप्त नही. <verse eid="MAT 10:26" /><verse number="27" style="v" sid="MAT 10:27" />जे मी तुमले अंधारमा सांगस, ते उजेडमा बोला, अनी जे काही तुम्हीन कानतीन ऐकतस ते धाबावर जाईन प्रचार करा. <verse eid="MAT 10:27" /><verse number="28" style="v" sid="MAT 10:28" />ज्या शरिरना नाश करतस पण आत्माना नाश कराले समर्थ नही त्यासले घाबरू नका, तर आत्मा अनं शरीर ह्या दोन्हीसले नरकमा नाश कराले जो परमेश्वर समर्थ शे त्याले घाबरा. <verse eid="MAT 10:28" /><verse number="29" style="v" sid="MAT 10:29" />एक नाणामा दोन चिमण्या ईकतस की, नही? तरी पण तुमना स्वर्गना बापशिवाय त्यापाईन एक बी जमीनवर पडस नही. <verse eid="MAT 10:29" /><verse number="30" style="v" sid="MAT 10:30" />तुमना डोकावरना सर्वा केस बी मोजेल शेतस. <verse eid="MAT 10:30" /><verse number="31" style="v" sid="MAT 10:31" />म्हणीन घाबरू नका, कारण बराच चिमण्यासपेक्षा तुमनं मोल अधिक शे. <figure style="fig" alt="Flat-roofed, olden house in Israel" file="lb00234c.tif" size="col" copy="Horace Knowles ©" ref="१०:२७">जुना काळना इस्त्राएलमाधला सपाट धाबाना घर </figure><verse eid="MAT 10:31" /></para>
  <para style="s">येशुना स्विकार अनी नकार</para>
  <para style="r">(<ref loc="LUK 12:8-9">लूक १२:८-९</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 10:32" />जो कोणी लोकसना समोर मना स्विकार करी, त्याना स्विकार मी मना स्वर्गना बापसमोर करसु; <verse eid="MAT 10:32" /><verse number="33" style="v" sid="MAT 10:33" /><note caller="+" style="x"><char style="xo" closed="false">१०:३३ </char><char style="xt" closed="false"><ref loc="2TI 2:12">२ तिमथ्य २:१२</ref></char></note>पण जो कोणी लोकसना समोर माले नाकारी, त्याना नाकार मी मना स्वर्गना बापसमोर करसु;<verse eid="MAT 10:33" /></para>
  <para style="s">शांती नही, पण एक तलवार</para>
  <para style="r">(<ref loc="LUK 12:51-53">लूक १२:५१-५३</ref>; <ref loc="LUK 14:26">१४:२६</ref>,<ref loc="LUK 14:27">२७</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 10:34" />अस नका समजा; की मी पृथ्वीवर शांतता कराले येल शे; मी शांतता कराले नही तर तलवार चालाडाले येल शे. <verse eid="MAT 10:34" /><verse number="35" style="v" sid="MAT 10:35" />कारण पोऱ्या अनं बाप, पोर अनं माय, सुन अनं सासु, यासमा फुट पाडाकरता मी येल शे<note caller="+" style="x"><char style="xo" closed="false">१०:३५ </char><char style="xt" closed="false"><ref loc="MIC 7:6">मीखा ७:६</ref></char></note>; <verse eid="MAT 10:35" /><verse number="36" style="v" sid="MAT 10:36" />अनी माणुसनाच घरना लोके त्याना वैरी व्हतीन. <verse eid="MAT 10:36" /><verse number="37" style="v" sid="MAT 10:37" />जो कोणी मनापेक्षा बाप अनं मायवर जास्त प्रेम करस तो माले योग्य नही; जो मनापेक्षा पोऱ्यावर किंवा पोरवर जास्त प्रेम करस तो माले योग्य नही; <verse eid="MAT 10:37" /><verse number="38" style="v" sid="MAT 10:38" /><note caller="+" style="x"><char style="xo" closed="false">१०:३८ </char><char style="xt" closed="false"><ref loc="MAT 16:24">मत्तय १६:२४</ref>; <ref loc="MRK 8:34">मार्क ८:३४</ref>; <ref loc="LUK 9:23">लूक ९:२३</ref></char></note>अनी जो कोणी स्वतःना क्रुसखांब उचलीन मनामांगे येस नही तो माले योग्य नही. <verse eid="MAT 10:38" /><verse number="39" style="v" sid="MAT 10:39" /><note caller="+" style="x"><char style="xo" closed="false">१०:३९ </char><char style="xt" closed="false"><ref loc="MAT 16:25">मत्तय १६:२५</ref>; <ref loc="MRK 8:35">मार्क ८:३५</ref>; <ref loc="LUK 9:24">लूक ९:२४</ref>; <ref loc="LUK 17:33">१७:३३</ref>; <ref loc="JHN 12:25">योहान १२:२५</ref></char></note>जो स्वतःना जिवले वाचाडी तो त्याले गमाडी, अनी जो मनाकरता स्वतःना जिव गमाडी, तो त्याना जिवले वाचाडी.<verse eid="MAT 10:39" /></para>
  <para style="s">ईनाम</para>
  <para style="r">(<ref loc="MRK 9:41">मार्क ९:४१</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 10:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१०:४० </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:16">लूक १०:१६</ref>; <ref loc="JHN 13:20">योहान १३:२०</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:37">मार्क ९:३७</ref>; <ref loc="LUK 9:48">लूक ९:४८</ref></char>
    </note>जो तुमना स्विकार करस, तो मना स्विकार करस अनी जो माले स्वीकारस, तो ज्यानी माले धाडेल शे त्याले स्वीकारस. <verse eid="MAT 10:40" /><verse number="41" style="v" sid="MAT 10:41" />जो संदेष्टाले म्हणीन स्वीकारस त्याले संदेष्टानं प्रतिफळ मिळी; अनी न्यायी माणुसले न्यायी म्हणीसन जो त्याना स्विकार करी, त्याले न्यायीजणसना प्रतिफळ मिळी; <verse eid="MAT 10:41" /><verse number="42" style="v" sid="MAT 10:42" />मी तुमले खरंखरं सांगस, जो कोणी ह्या धाकलासपैकी एकले मना शिष्य समजीन गल्लासभर थंड पाणी पाजी, तर त्याले त्यानं प्रतिफळ मिळाशिवाय रावावू नही.<verse eid="MAT 10:42" /></para>
  <chapter eid="MAT 10" />
  <chapter number="11" style="c" sid="MAT 11" />
  <para style="s">बाप्तिस्मा करनारा योहान कडतीन संदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 11:1" />मंग अस व्हयनं की, येशु आपला बारा शिष्यसले बोध करानंतर, तो तठेन नगरमा शिकाडाले अनं उपदेश कराले गया. <verse eid="MAT 11:1" /><verse number="2" style="v" sid="MAT 11:2" />जवय कैदखानामा योहाननी ख्रिस्तनी चमत्कारबद्दल माहीती ऐकी, तवय आपला शिष्यसले त्यानाजोडे हाई ईचाराले धाडं, <verse eid="MAT 11:2" /><verse number="3" style="v" sid="MAT 11:3" />जो येणारा व्हता तो तु शे, की आम्हीन दुसरानी वाट दखुत? <verse eid="MAT 11:3" /><verse number="4" style="v" sid="MAT 11:4" />येशुनी त्यासले सांगं, जे तुम्हीन ऐकतस अनी दखतस ते योहानले जाईसन सांगा; <verse eid="MAT 11:4" /><verse number="5" style="v" sid="MAT 11:5" />आंधया दखतस, पांगया चालतस कोडी बरा व्हतस, बहिरा ऐकतस, मरेल जिवत व्हतस अनं गरीबसले संदेश सांगामा येस; <verse eid="MAT 11:5" /><verse number="6" style="v" sid="MAT 11:6" />धन्य शे, तो जो मनाबद्दल शंका धरस नही. <verse eid="MAT 11:6" /><verse number="7" style="v" sid="MAT 11:7" />योहानना शिष्य जावावर येशु लोकसनी गर्दीले त्यानाबद्दल सांगु लागना, तुम्हीन जंगलमा योहानले दखाले जायेल व्हतात? तवय तो तुमले वाराना झोतघाई हालणारा गवतनामायक वाटी राहींता काय? <verse eid="MAT 11:7" /><verse number="8" style="v" sid="MAT 11:8" />तर मंग तुम्हीन काय दखाले जायेल व्हतात? मऊ कपडा घालेल माणुसले का? दखा, मऊ कपडा वापरणारा तर राजवाडामाच राहतस. <verse eid="MAT 11:8" /><verse number="9" style="v" sid="MAT 11:9" />तर मंग तुम्हीन कसाले जायल व्हतात? एखादा संदेष्टाले दखाले का? तर मी तुमले खरंखरं सांगस, संदेष्टापेक्षा जो मोठा माणुस त्याले दखाले तुम्हीन जायल व्हतात. <verse eid="MAT 11:9" /><verse number="10" style="v" sid="MAT 11:10" />हाऊ तोच योहान शे ज्यानाबद्दल लिखेल शे, दखा, मी मना दूतले तुनापुढे धाडसं, तो तुनापुढे तुनी वाट तयार करी<note caller="+" style="x"><char style="xo" closed="false">११:१० </char><char style="xt" closed="false"><ref loc="MAL 3:1">मलाखी ३:१</ref></char></note>. <verse eid="MAT 11:10" /><verse number="11" style="v" sid="MAT 11:11" />मी तुमले सत्य सांगस की, बाईपाईन जन्मले माणसंसमा कोणी बाप्तिस्मा करनारा योहानपेक्षा श्रेष्ठ व्हयना नही; तरी स्वर्गना राज्यमा धाकला जो शे तो योहानपेक्षा बी श्रेष्ठ शे. <verse eid="MAT 11:11" /><verse number="12" style="v" sid="MAT 11:12" /><note caller="+" style="x"><char style="xo" closed="false">११:१२ </char><char style="xt" closed="false"><ref loc="LUK 16:16">लूक १६:१६</ref></char></note>बाप्तिस्मा करनारा योहान ह्याना दिनपाईन आत्तेपावत स्वर्गना राज्यवर हल्ला चाली राहीनात, अनी हल्ला करणारा लोके ते लेवाकरता प्रयत्न करी राहिनात. <verse eid="MAT 11:12" /><verse number="13" style="v" sid="MAT 11:13" />कारण मोशेना नियमशास्त्र अनी सर्वा संदेष्टा ह्या योहान पर्यंत संदेश देत वनात. <verse eid="MAT 11:13" /><verse number="14" style="v" sid="MAT 11:14" /><note caller="+" style="x"><char style="xo" closed="false">११:१४ </char><char style="xt" closed="false"><ref loc="MAT 17:10-13">मत्तय १७:१०-१३</ref>; <ref loc="MRK 9:11-13">मार्क ९:११-१३</ref></char></note>मी सांगस, ते तुमनी मान्य करानी तयारी व्हई तर जो एलिया येणार शे, तो हाऊच शे. <verse eid="MAT 11:14" /><verse number="15" style="v" sid="MAT 11:15" />ज्यासले ऐकाले कान शेतस त्या ऐकोत. <verse eid="MAT 11:15" /><verse number="16" style="v" sid="MAT 11:16" />हाई पिढीले मी कसानी उपमा देऊ? ह्या लोके बजारमा बसेल पोऱ्यासना मायक शेतस ज्या आपला मित्रसले हाक मारीन सांगतस, <verse eid="MAT 11:16" /><verse number="17" style="v" sid="MAT 11:17" />अनी म्हणतस आम्हीन तुमनाकरता पावा वाजाडा, तरी पण तुम्हीन नाचनात नही, अनी आम्हीन मरणना शोकगीत म्हणं तरी तुम्हीन शोक करा नही, त्या पोऱ्यासना मायक हाई पिढी शे. <verse eid="MAT 11:17" /><verse number="18" style="v" sid="MAT 11:18" />कारण बाप्तिस्मा करनारा योहान हाऊ खातपित वना नही, तरी लोक त्याले भूत लागेल शे अस म्हणतस. <verse eid="MAT 11:18" /><verse number="19" style="v" sid="MAT 11:19" />मनुष्यना पोऱ्या वना, तो खासपेस; तरी त्यानाबद्दल बोलतस, दखा, हाऊ खादाड अनी दारूबाज माणुस, जकातदारसना अनी पापी लोकसना मित्र! पण देवनं ज्ञान आपला कार्यवरतीन न्यायी ठरस.<verse eid="MAT 11:19" /></para>
  <para style="s">बिनईश्वासी गावसबद्दल दुःख</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 11:20" />मंग ज्या शहरसमा त्यानी बराच चमत्कार करेल व्हतात, तरी पण तठला लोके देवकडे वळनात नहीत म्हणीन तो त्यासले दोष देऊ लागना. <verse eid="MAT 11:20" /><verse number="21" style="v" sid="MAT 11:21" />हे खोराजिना, तुनी अवस्था कशी व्हई! हे बेथसैदा, तुनी कितली खराब अवस्था व्हई! कारण ज्या चमत्कार मी तुमनामा करात त्या जर सोर अनं सिदोन ह्या शहरसमा करतु तर त्या त्याच येळले गोणताट लाईन अनं राखमा बशीन पापसपाईन मांगे फिरतात. <verse eid="MAT 11:21" /><verse number="22" style="v" sid="MAT 11:22" />पण मी तुमले सांगस की, न्यायना दिनले सोर अनं सिदोन यासले मिळणारी शिक्षा तुमले मिळणारी शिक्षापेक्षा सोपी राही. <verse eid="MAT 11:22" /><verse number="23" style="v" sid="MAT 11:23" />हे कफर्णहुम, तु आकाशपावत चढी जाशी का? तु नरकमा खालपावत उतरशी; कारण ज्या चमत्कार तुमनामा घडनात त्या जर सदोममा घडतात तर आज त्या ईश्वासमा ऱ्हातात. <verse eid="MAT 11:23" /><verse number="24" style="v" sid="MAT 11:24" /><note caller="+" style="x"><char style="xo" closed="false">११:२४ </char><char style="xt" closed="false"><ref loc="MAT 10:15">मत्तय १०:१५</ref>; <ref loc="LUK 10:12">लूक १०:१२</ref></char></note>मी तुमले सांगस की, न्यायना दिनले तुमले मिळणारी शिक्षा सदोमले मिळणारी शिक्षापेक्षा जास्त राही.<verse eid="MAT 11:24" /></para>
  <para style="s">येशुनी कामगीरी</para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 11:25" />त्या येळले येशु सांगु लागना, हे बापा, स्वर्गना अनं पृथ्वीना प्रभु, मी तुनी स्तुती करस कारण की, ज्ञानी अनी ईचारवंत लोकसपाईन ह्या गोष्टी गुप्त ठेईन त्या तु धाकला पोऱ्यासले प्रकट करेल शे. <verse eid="MAT 11:25" /><verse number="26" style="v" sid="MAT 11:26" />खरच हे बापा, कारण हाईच तुले योग्य दखायनं.<verse eid="MAT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 11:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">११:२७ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 3:35">योहान ३:३५</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:18">योहान १:१८</ref>; <ref loc="JHN 10:15">१०:१५</ref></char>
    </note>मना बापनी सर्वकाही मना हातमा सोपेल शे, अनी बापशिवाय पोऱ्याले कोणी वळखत नही अनी पोऱ्याशिवाय अनं पोऱ्यानी ज्या कोणले बापनी वळख करी देवानी ईच्छा व्हई त्यानाशिवाय बापले कोणीच वळखत नही. <verse eid="MAT 11:27" /><verse number="28" style="v" sid="MAT 11:28" />अहो सर्वा कष्टी अनी वझामा दाबायेल लोकसहो, मनाजोडे या, म्हणजे मी तुमले विसावा दिसु. <verse eid="MAT 11:28" /><verse number="29" style="v" sid="MAT 11:29" />मी जशा मनना लीन अनं नम्र शे तो मना जू तुम्हीन तुमनावर ल्या, अनं मनापाईन शिका म्हणजे तुमना जिवले विसावा मिळी; <verse eid="MAT 11:29" /><verse number="30" style="v" sid="MAT 11:30" />कारण मना जू सोयना अनं मना वझा हलका शे.<verse eid="MAT 11:30" /></para>
  <chapter eid="MAT 11" />
  <chapter number="12" style="c" sid="MAT 12" />
  <para style="s">शब्बाथना धनी</para>
  <para style="r">(<ref loc="MRK 2:23-28">मार्क २:२३-२८</ref>; <ref loc="LUK 6:1-5">लूक ६:१-५</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 12:1" />त्या येळले येशु शब्बाथ<note caller="+" style="f"><char style="fr" closed="false">१२:१ </char><char style="ft" closed="false">शब्बाथ दिन</char></note> दिनले शेतमाईन गया; तवय त्याना शिष्यसले भूक लागेल व्हती म्हणीन त्या ओंब्या तोडीन खाऊ लागनात. <verse eid="MAT 12:1" /><verse number="2" style="v" sid="MAT 12:2" />हाई दखीसन परूशी त्यासले बोलनात, दखा, शब्बाथ दिनले जे योग्य नही ते तुना शिष्य करी राहिनात. <verse eid="MAT 12:2" /><verse number="3" style="v" sid="MAT 12:3" />त्यावर येशुनी त्यासले उत्तर दिधं, दावीद अनं त्यानाबरोबरना यासले जवय भूक लागनी तवय त्यानी काय करं? हाई तुम्हीन वाचं नही का. <verse eid="MAT 12:3" /><verse number="4" style="v" sid="MAT 12:4" />तो देवना मंदिरमा कसा गया अनी नियमाप्रमाणं फक्त याजकनी खावानी समर्पित भाकर, त्यानी अनं त्याना सोबतीसनी कश खादं; <verse eid="MAT 12:4" /><verse number="5" style="v" sid="MAT 12:5" />तसच शब्बाथ दिनले याजक मंदिरमा शब्बाथना नियम तोडतस तरी पण निर्दोष राहतस हाई तुम्हीन मोशेना नियमशास्त्रमा वाचात नही का? <verse eid="MAT 12:5" /><verse number="6" style="v" sid="MAT 12:6" />पण मी तुमले सांगस, की, मंदिरपेक्षा बी मोठा असा कोणतरी तुमनामा आठे शे. <verse eid="MAT 12:6" /><verse number="7" style="v" sid="MAT 12:7" /><note caller="+" style="x"><char style="xo" closed="false">१२:७ </char><char style="xt" closed="false"><ref loc="MAT 9:13">मत्तय ९:१३</ref></char></note>जर तुमले याना अर्थ समजता, की, माले दया पाहिजे अर्पण नही, तर तुम्हीन निर्दोषीसले दोषी नही ठरावतात. <verse eid="MAT 12:7" /><verse number="8" style="v" sid="MAT 12:8" />कारण मनुष्यना पोऱ्या शब्बाथ दिनना धनी शे.<verse eid="MAT 12:8" /></para>
  <para style="s">वाळेल हातना माणुस</para>
  <para style="r">(<ref loc="MRK 3:1-6">मार्क ३:१-६</ref>; <ref loc="LUK 6:6-11">लूक ६:६-११</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 12:9" />मंग येशु तठेन निंघीसन त्यासना सभास्थानमा गया; <verse eid="MAT 12:9" /><verse number="10" style="v" sid="MAT 12:10" />अनी दखा, तठे वाळेल हातना एक माणुस व्हता; तवय त्यासनी त्याले दोष लागाले पाहिजे म्हणीसन परूशीसनी त्याले ईचारं, शब्बाथ दिनले रोग बरं करनं योग्य शे का? <verse eid="MAT 12:10" /><verse number="11" style="v" sid="MAT 12:11" /><note caller="+" style="x"><char style="xo" closed="false">१२:११ </char><char style="xt" closed="false"><ref loc="LUK 14:5">लूक १४:५</ref></char></note>येशुनी त्यासले सांगं, तुमनामा असा कोण माणुस शे की, ज्यानं एकच मेंढरू राहिसन ते शब्बाथ दिनले खड्डामा पडनं तर त्याले उचलीन बाहेर काढावु नही का? <verse eid="MAT 12:11" /><verse number="12" style="v" sid="MAT 12:12" />तर मेंढरसपेक्षा माणुसनं मोल कितलं तरी बरच मोठं शे! यामुये शब्बाथ <note caller="+" style="f"><char style="fr" closed="false">12:12 </char><char style="fq" closed="false">शब्बाथ </char><char style="ft" closed="false">यहुदी लोकसना आरामना दिन</char></note>दिनले एखादाले मदत करनं योग्य शे. <verse eid="MAT 12:12" /><verse number="13" style="v" sid="MAT 12:13" />मंग त्यानी त्या वाळेल हातना माणुसले सांगं, तुना हात सरळ कर, तवय त्यानी हात सरळ करा अनी तो बरा व्हईन दुसरा हातना मायक व्हयना. <verse eid="MAT 12:13" /><verse number="14" style="v" sid="MAT 12:14" />त्यानंतर परूशीसनी बाहेर जाईसन त्याना विरोधमा योजना आखी की, त्याना घात कशा कराना.<verse eid="MAT 12:14" /></para>
  <para style="s">परमेश्वरना निवडेल सेवक</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 12:15" />पण हाई वळखीन येशु तठेन निंघी गया, तवय बराच लोके त्यानामांगे गयात अनं त्यानी त्या सर्वासले बरं करं; <verse eid="MAT 12:15" /><verse number="16" style="v" sid="MAT 12:16" />अनी त्यासले बजाईन सांगं, की, माले प्रकट करू नका; <verse eid="MAT 12:16" /><verse number="17" style="v" sid="MAT 12:17" />याकरता की, यशया संदेष्टानाद्वारा जे सांगामा येल व्हतं ते पुरं व्हई; ते असं की, <verse eid="MAT 12:17" /><verse number="18" style="v" sid="MAT 12:18" />दखा, हाऊ मना सेवक याले मी निवाडेल शे, तो माले परमप्रिय शे; त्यानावर मी संतुष्ट शे; त्यानावर मी आपला आत्मा घालसु, अनं तो गैरयहूदीसना न्याय करी<note caller="+" style="x"><char style="xo" closed="false">१२:१८ </char><char style="xt" closed="false"><ref loc="ISA 42:1-4">यशया ४२:१-४</ref></char></note>. <verse eid="MAT 12:18" /><verse number="19" style="v" sid="MAT 12:19" />तो भांडावु नही अनं वरडावु नही, अनी कोणलेच त्याना आवाज रस्तामा ऐकु येवाव नही. <verse eid="MAT 12:19" /><verse number="20" style="v" sid="MAT 12:20" />तो अशक्तसले मोडावु नही, अनं धाकला मधला दिवाले तो वलाडावु नही, जोपावत तो न्यायले विजयी करस नही. <verse eid="MAT 12:20" /><verse number="21" style="v" sid="MAT 12:21" />अनी गैरयहूदीमाधला सर्वा लोके त्याना नावनी आशा धरतीन<verse eid="MAT 12:21" /></para>
  <para style="s">येशु अनी सैतान</para>
  <para style="r">(<ref loc="MRK 3:20-30">मार्क ३:२०-३०</ref>; <ref loc="LUK 11:14-23">लूक ११:१४-२३</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 12:22" />मंग त्यासनी एक भूत लागेल माणुसले येशुकडे आनं, हाऊ माणुस आंधया अनं मुका व्हता अनी त्यानी त्याले बरं करं, अनी तो मुका बोलाले अनी दखाले लागना. <verse eid="MAT 12:22" /><verse number="23" style="v" sid="MAT 12:23" />तवय सर्वा लोके नवल करीसन सांगु लागनात, की, हाऊ दावीदना पोऱ्या व्हई का? <verse eid="MAT 12:23" /><verse number="24" style="v" sid="MAT 12:24" /><note caller="+" style="x"><char style="xo" closed="false">१२:२४ </char><char style="xt" closed="false"><ref loc="MAT 9:34">मत्तय ९:३४</ref>; <ref loc="MAT 10:25">१०:२५</ref></char></note>पण परूशी हाई ऐकीसन सांगु लागनात, हाऊ ते भूतसना राजा बालजबूल यानी मदत लिसन भूत काढस. <verse eid="MAT 12:24" /><verse number="25" style="v" sid="MAT 12:25" />येशुनी त्यासना मनमधला ईचार वळखीन त्यासले सांगं, आपसमा फुट पडेल प्रत्येक राज्य नष्ट व्हई जास, अनी ज्या शहरमा अनी घरना लोकसमा आपसमा फुट पडनी तर ते शहर अनी घर टिकु शकस नही. <verse eid="MAT 12:25" /><verse number="26" style="v" sid="MAT 12:26" />सैतानच जर सैतानले काढाले लागना तर त्यासनामा फुट पडी जाई मंग त्यानं राज्य कसं टिकी. <verse eid="MAT 12:26" /><verse number="27" style="v" sid="MAT 12:27" />जर मी भूतसना राजा बालजबूल यानी मदत लिसन भूत काढत व्हसू तर तुमना लोके कोणी मदत लिसन काढतस? म्हणीन त्याच तुमना न्याय करतीन; <verse eid="MAT 12:27" /><verse number="28" style="v" sid="MAT 12:28" />पण, मी जर देवना आत्माघाई, भूत काढी ऱ्हायनु तर देवनं राज्य तुमनावर येल शे. <verse eid="MAT 12:28" /><verse number="29" style="v" sid="MAT 12:29" />तसच पहीलवान माणुसले अगोदर बांधाशिवाय त्याना घरमा घुशीसन त्याना वस्तु लुटीसन कोणले नेता ई का? त्याले बांध तरच तो त्यानं घर लुटू शकस.<verse eid="MAT 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 12:30" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:३० </char>
      <char style="xt" closed="false">
        <ref loc="MRK 9:40">मार्क ९:४०</ref>
      </char>
    </note>जो मनासंगे नही तो मनाविरूध्द शे, अनी जो मनाबरोबर गोया करस नही तर तो उधळी टाकस. <verse eid="MAT 12:30" /><verse number="31" style="v" sid="MAT 12:31" />यामूये मी तूमले सांगस, की माणुसना प्रत्येक पाप अनी निंदानी क्षमा व्हई. पण जो कोणी पवित्र आत्मानी निंदा करी त्यानी क्षमा व्हवाव नही. <verse eid="MAT 12:31" /><verse number="32" style="v" sid="MAT 12:32" /><note caller="+" style="x"><char style="xo" closed="false">१२:३२ </char><char style="xt" closed="false"><ref loc="LUK 12:10">लूक १२:१०</ref></char></note>अनी जो कोणी मनुष्यना पोऱ्याविरूध्द काही बोली तर त्याना अपराधनी क्षमा व्हई जाई, पण जो कोणी पवित्र आत्माना विरोधमा बोली त्याले त्याना अपराधसनी क्षमा ह्या युगमा बी नही. अनी येनारा युगमा बी व्हवाव नही.<verse eid="MAT 12:32" /></para>
  <para style="s">जश झाड तस फळ</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 12:33" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:३३ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:20">मत्तय ७:२०</ref>; <ref loc="LUK 6:44">लूक ६:४४</ref></char>
    </note>यामुये झाड बी चांगलं अनी त्यानं फळ बी चांगलं शे असा म्हणा; नहीतर झाड वाईट शे अनी त्याना फळ बी वाईट; कारण झाड आपले फळवरतीन वळखाई जास. <verse eid="MAT 12:33" /><verse number="34" style="v" sid="MAT 12:34" /><note caller="+" style="x"><char style="xo" closed="false">१२:३४ </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्तय ३:७</ref>; <ref loc="MAT 23:33">२३:३३</ref>; <ref loc="LUK 3:7">लूक ३:७</ref>; </char><char style="xt" closed="false"><ref loc="MAT 15:18">मत्तय १५:१८</ref>; <ref loc="LUK 6:45">लूक ६:४५</ref></char></note>अहो सापना पिल्लासवन, तुम्हीन वाईट ऱ्हाईसन तुमले चांगल्या गोष्टी कशा बोलता येतीन? कारण जे मनमा भरेल शे तेच तोंडमाईन निंघी. <verse eid="MAT 12:34" /><verse number="35" style="v" sid="MAT 12:35" />चांगला माणुस आपला भांडामाईन चांगल्या गोष्टी काढस, अनी वाईट माणुस आपले भांडामाईन वाईट गोष्टी काढस. <verse eid="MAT 12:35" /><verse number="36" style="v" sid="MAT 12:36" />मी तुमले सांगस की, ज्या बी व्यर्थ गोष्टी माणुस सांगी न्यायना दिनले त्याले त्याना हिशोब देनाच पडी. <verse eid="MAT 12:36" /><verse number="37" style="v" sid="MAT 12:37" />कारण आपला बोलनावर तु निर्दोष ठरशी अनी आपलाच बोलनावर तु दोषी ठरशी.<verse eid="MAT 12:37" /></para>
  <para style="s">स्वर्गना चिन्ह दखाडाकरता येशुले करेल ईनंती</para>
  <para style="r">(<ref loc="MRK 8:11-12">मार्क ८:११-१२</ref>; <ref loc="LUK 11:29-32">लूक ११:२९-३२</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MAT 12:38" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:३८ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:1">मत्तय १६:१</ref>; <ref loc="MRK 8:11">मार्क ८:११</ref>; <ref loc="LUK 11:16">लूक ११:१६</ref></char>
    </note>तवय शास्त्री अनं परूशी यासनापाईन काहीजण त्याले बोलनात, गुरजी, तुमना हातघाई काही चिन्ह दखानी आमनी ईच्छा शे. <verse eid="MAT 12:38" /><verse number="39" style="v" sid="MAT 12:39" /><note caller="+" style="x"><char style="xo" closed="false">१२:३९ </char><char style="xt" closed="false"><ref loc="MAT 16:4">मत्तय १६:४</ref>; <ref loc="MRK 8:12">मार्क ८:१२</ref></char></note>पण त्यानी त्यासले उत्तर दिधं, हाई दुष्ट अनी व्यभिचारी पिढी चिन्ह मांगस, पण योना संदेष्टाना चिन्हशिवाय तिले दुसरं कोणतच चिन्ह देवामा येवाव नही. <verse eid="MAT 12:39" /><verse number="40" style="v" sid="MAT 12:40" />कारण जस योना तीन दिन अनं तीन रात मासाना पोटमा व्हता, तसाच मनुष्यना पोऱ्या बी तीन दिन तीन रात पृथ्वीना पोटमा ऱ्हाई. <verse eid="MAT 12:40" /><verse number="41" style="v" sid="MAT 12:41" />न्यायना दिनले निनवेना लोके हाई पिढीना लोकससंगे उभा ऱ्हाईसन हिले दोषी ठरावतीन, कारण त्यासनी योनाना संदेश ऐकीसन पश्चाताप करा; अनी दखा, आठे जो शे तो योनापेक्षा श्रेष्ठ शे. <verse eid="MAT 12:41" /><verse number="42" style="v" sid="MAT 12:42" />न्यायना दिनले दक्षिणकडनी राणी, हाई पिढीना लोकेसंगे उभी ऱ्हाईन हिले दोषी ठराई, कारण ती शलमोन राजानं ज्ञान ऐकाकरता पृथ्वीना सीमापाईन वनी; अनी दखा, शलमोनपेक्षा श्रेष्ठ आठे शे.<verse eid="MAT 12:42" /></para>
  <para style="s">दुष्ट आत्मानं परत येणं</para>
  <para style="r">(<ref loc="LUK 11:24-26">लूक ११:२४-२६</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MAT 12:43" />जवय दुष्ट आत्मा कोणा माणुस माईन निंघस, तवय तो आराम कराकरता ओसाड जागामा भटकत फिरस, पण त्याले जागा मिळस नही, <verse eid="MAT 12:43" /><verse number="44" style="v" sid="MAT 12:44" />तवय तो सांगस, ज्या घरमाईन मी येल व्हतु त्यामा परत जासु; अनी जवय तो तठे वापस जास, तवय त्याले ते घर रिकामं साफसफाई करेल, सजाडेल अस दखास. <verse eid="MAT 12:44" /><verse number="45" style="v" sid="MAT 12:45" />मंग तो जाईसन आपलापेक्षा दुष्ट, असा दुसरा सात आत्मा आपलासंगे लई येस, अनी त्या मजार जाईन तठे ऱ्हातस; मंग त्या माणुसनी शेवटनी अवस्था पहिलापेक्षा जास्त वाईट व्हस; तसच हाई पिढीनं बी व्हई.<verse eid="MAT 12:45" /></para>
  <para style="s">येशुना नातेवाईक</para>
  <para style="r">(<ref loc="MRK 3:31-35">मार्क ३:३१-३५</ref>; <ref loc="LUK 8:19-21">लूक ८:१९-२१</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MAT 12:46" />मंग येशु लोकसनी गर्दीसंगे बोली ऱ्हाईंता, दखा, त्यानी माय अनं त्याना भाऊ त्यानासंगे बोलाकरता बाहेर उभा ऱ्हायेल व्हतात. <verse eid="MAT 12:46" /><verse number="47" style="v" sid="MAT 12:47" />तवय कोणी तरी येशुले सांगं, दख, तुनी माय अनं तुना भाऊ तुनासंगे बोलाकरता बाहेर उभा ऱ्हायेल शेतस. <verse eid="MAT 12:47" /><verse number="48" style="v" sid="MAT 12:48" />पण येशुनी त्या सांगणाराले उत्तर दिधं, कोण मनी माय अनं कोण मना भाऊ? <verse eid="MAT 12:48" /><verse number="49" style="v" sid="MAT 12:49" />अनी येशु आपला शिष्यसकडे हात दखाडीन बोलना, “दखा, मनी माय अनं मना भाऊ! <verse eid="MAT 12:49" /><verse number="50" style="v" sid="MAT 12:50" />कारण जो कोणी मना स्वर्गना बापना ईच्छाप्रमाणे करस तोच मना भाऊ, बहिण, अनं माय शे.”<verse eid="MAT 12:50" /></para>
  <chapter eid="MAT 12" />
  <chapter number="13" style="c" sid="MAT 13" />
  <para style="s">पेरणी करनाराना दृष्टांत</para>
  <para style="r">(<ref loc="MRK 4:1-9">मार्क ४:१-९</ref>; <ref loc="LUK 8:4-8">लूक ८:४-८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 13:1" />त्या दिन येशु घरमाईन निंघीसन समुद्र किनारले जाईन बसना. <verse eid="MAT 13:1" /><verse number="2" style="v" sid="MAT 13:2" /><note caller="+" style="x"><char style="xo" closed="false">१३:२ </char><char style="xt" closed="false"><ref loc="LUK 5:1-3">लूक ५:१-३</ref></char></note>तवय लोकेसनी ईतली मोठी गर्दी त्यानाजोडे जमनी; म्हणीन तो नावमा जाईन बसना अनं सर्वा लोके किनारवर उभा राहिनात. <verse eid="MAT 13:2" /><verse number="3" style="v" sid="MAT 13:3" />मंग त्यानी त्यासले दृष्टांत दिसन बऱ्याच गोष्टी सांगात तवय तो बोलना, “दखा, एक पेरणारा पेरणी कराले निंघना.” <verse eid="MAT 13:3" /><verse number="4" style="v" sid="MAT 13:4" />अनी तो पेरी राहिंता तवय काही बीया वाटवर पडनात अनं पक्षीसनी ईसन ते खाई टाकं. <verse eid="MAT 13:4" /><verse number="5" style="v" sid="MAT 13:5" />काही खडकाळ जमीनवर पडनात, तठे त्यासले पुरेशी जास्त माती मिळनी नही, अनी माती जास्त खोलपावत नव्हती म्हणीन त्या लवकर उगनात. <verse eid="MAT 13:5" /><verse number="6" style="v" sid="MAT 13:6" />अनी जवय सुर्य वर निंघना तवय त्यासले उन लागनं अनं त्या लगेच वाळाई गयात कारण त्यासले मुयाच नव्हतात. <verse eid="MAT 13:6" /><verse number="7" style="v" sid="MAT 13:7" />काही काटेरी झुडपसमा पडनात; पण काटासना झुडपासनी वाढीसन त्यासनी वाढले दाबी टाकं. <verse eid="MAT 13:7" /><verse number="8" style="v" sid="MAT 13:8" />काही बीया चांगली जमीनवर पडनात, मंग त्यासनं कोठे शंभरपट, कोठे साठपट तर कोठे तीसपट, अस पीक वनं. <verse eid="MAT 13:8" /><verse number="9" style="v" sid="MAT 13:9" />अनी येशु त्यासले बोलना, ज्यासले कान शेतस त्या ऐकोत. <figure style="fig" alt="Jesus teaching the crowd by the sea" file="lb00299c.tif" size="col" copy="Horace Knowles ©" ref="१३:२">समुद्रमा नाववर चढीसन येशु लोकसनी गर्दीले उपदेश करस</figure><verse eid="MAT 13:9" /></para>
  <para style="s">दृष्टांतना उपयोग</para>
  <para style="r">(<ref loc="MRK 4:10-12">मार्क ४:१०-१२</ref>; <ref loc="LUK 8:9-10">लूक ८:९-१०</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 13:10" />मंग शिष्यसनी जोडे जाईसन त्याले ईचारं, तु त्यासनासंगे दृष्टांत दिसन का बरं बोलस? <verse eid="MAT 13:10" /><verse number="11" style="v" sid="MAT 13:11" />येशुनी त्यासले उत्तर दिधं, “स्वर्गना राज्यना रहस्य ओळखाना दान तुमले देयल शे, पण त्यासले देयल नही.” <verse eid="MAT 13:11" /><verse number="12" style="v" sid="MAT 13:12" /><note caller="+" style="x"><char style="xo" closed="false">१३:१२ </char><char style="xt" closed="false"><ref loc="MAT 25:29">मत्तय २५:२९</ref>; <ref loc="MRK 4:25">मार्क ४:२५</ref>; <ref loc="LUK 8:18">लूक ८:१८</ref>; <ref loc="LUK 19:26">१९:२६</ref></char></note>कारण ज्यानाजोडे शे त्याले अजुन भेटी अनं त्याले भरपुर व्हई, पण ज्यानाजोडे काहीच नही त्यानाकडे त्यानं जे काही व्हई ते पण त्यानाकडतीन काढी लेतीन. <verse eid="MAT 13:12" /><verse number="13" style="v" sid="MAT 13:13" />यामुये मी त्यासनासंगे दृष्टांत दिसन बोलस; कारण त्यासले दखाले मिळस, पण दखतस नही, ऐकाले मिळस पण ऐकतस नही, अनं समजी बी लेतस नही. <verse eid="MAT 13:13" /><verse number="14" style="v" sid="MAT 13:14" />यशयाना संदेश त्यासना विषयी पुर्ण व्हई ऱ्हाईना शे; तो असा की, तुम्हीन ऐकशात खरं, पण तुमले समजावुच नही, अनं दखशात खरं, पण तुमले दिसावुच नही<note caller="+" style="x"><char style="xo" closed="false">१३:१४ </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यशया ६:९-१०</ref></char></note>; <verse eid="MAT 13:14" /><verse number="15" style="v" sid="MAT 13:15" />कारण ह्या लोकसना मन कठीण व्हई जायेल शे, त्या बधीर कानघाई ऐकतस, अनी त्यासनी आपला डोया झाकी लियेल शेतस; यानाकरता की, त्यासनी डोयासघाई दखाले नको, कानसघाई ऐकाले नको, मनमातीन समजाले नको, त्यासनी वळाले नको, अनी मी त्यासले बरा कराले नको. <verse eid="MAT 13:15" /><verse number="16" style="v" sid="MAT 13:16" /><note caller="+" style="x"><char style="xo" closed="false">१३:१६ </char><char style="xt" closed="false"><ref loc="LUK 10:23">लूक १०:२३</ref>,<ref loc="LUK 10:24">२४</ref></char></note>पण धन्य शेतस, तुमना डोया, कारण त्या दखी ऱ्हाईनात; अनी धन्य शेतस, तुमना कान कारण त्या ऐकी ऱ्हाईनात. <verse eid="MAT 13:16" /><verse number="17" style="v" sid="MAT 13:17" />मी तुमले खरंखरं सांगस की, तुम्हीन ज्या दखतस तेच दखाकरता बराच संदेष्टा अनं धार्मीकजण उत्साही व्हतात, तरी त्यासले दखाले मिळनं नही; अनी तुम्हीन ज्या ऐकतस तेच ऐकासाठे त्या उत्साही व्हतात, तरी त्यासले ऐकाले मिळनं नही.<verse eid="MAT 13:17" /></para>
  <para style="s">पेरणी करनाराना दृष्टांताना अर्थ</para>
  <para style="r">(<ref loc="MRK 4:13-20">मार्क ४:१३-२०</ref>; <ref loc="LUK 8:11-15">लूक ८:११-१५</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 13:18" />आता पेरणाराना दृष्टांत ऐकी ल्या. <verse eid="MAT 13:18" /><verse number="19" style="v" sid="MAT 13:19" />कोणी राज्यनं वचन ऐकस पण ते त्याले समजस नही; तवय तो दुष्ट ईसन त्याना मनमधला पेरेल वचन काढी लेस; वाटवर पेरेल तो हाऊ शे. <verse eid="MAT 13:19" /><verse number="20" style="v" sid="MAT 13:20" />खडकाळ जमीनवर पेरेल तो हाऊ शे की, वचन ऐकस, अनं तवळच आनंद करस; <verse eid="MAT 13:20" /><verse number="21" style="v" sid="MAT 13:21" />पण त्यासले मुया रास नही त्यामुये त्या थोडाच काळ टिकाव धरतस; अनी वचनमुये संकट वना किंवा छळ व्हयना म्हणजेच तो अडखळाले लागस. <verse eid="MAT 13:21" /><verse number="22" style="v" sid="MAT 13:22" />काटेरी झुडपसमा पेरेल तो हाऊ शे की, वचन ऐकस; पण संसारनी चिंता मोह या त्यानी वचननी वाढले दाबी टाकस, अनी तो निष्फळ व्हस. <verse eid="MAT 13:22" /><verse number="23" style="v" sid="MAT 13:23" />चांगली जमीनवर पेरेल या शेतस की, त्या वचन ऐकीन समजतस; तर त्या फळ देतस; कोणी शंभरपट, कोणी साठपट, कोणी तीसपट, असा फळ देतस.<verse eid="MAT 13:23" /></para>
  <para style="s">निदाणना दृष्टांत</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 13:24" />त्यानी त्यासले दुसरा दृष्टांत दिधा की, स्वर्गनं राज्य त्या माणुसना मायक शे, ज्यानी आपला शेतमा चांगलं बी पेरं. <verse eid="MAT 13:24" /><verse number="25" style="v" sid="MAT 13:25" />लोके झोपमा व्हतात तवयच त्याना वैरी ईसन गहुमा निदण<note caller="+" style="f"><char style="fr" closed="false">13:25 </char><char style="fq" closed="false">निदण </char><char style="ft" closed="false">वावरमा बिनकामनं उगनारं गवत</char></note> पेरीसन गया; <verse eid="MAT 13:25" /><verse number="26" style="v" sid="MAT 13:26" />पण जवय शेतमा पिकले पानटा फुटीन अनं कणीसमा दाणा वनात तवय निदण बी दखायनात. <verse eid="MAT 13:26" /><verse number="27" style="v" sid="MAT 13:27" />तवय घरमालकना नोकरसनी ईसन त्याले सांगं, महाराज, आपन आपला शेतमा चांगलं बी पैरा ना? मंग त्यामा निदाण कोठेन वनं? <verse eid="MAT 13:27" /><verse number="28" style="v" sid="MAT 13:28" />तवय मालक त्यासले बोलना, हाई काम कोणी वैरीनं शे. नोकरसनी त्याले सांगं, आम्हीन जाईसन त्यासले गोया करूत अशी तुमनी ईच्छा शे का? <verse eid="MAT 13:28" /><verse number="29" style="v" sid="MAT 13:29" />तो त्यासले बोलना, नही, तुम्हीन निदाणले गोया करशात त्यानाबरोबर कदाचित गहुले पण उपटी टाकशात <verse eid="MAT 13:29" /><verse number="30" style="v" sid="MAT 13:30" />कापणीनी येळपावत दोन्हीसले बराबर वाढू द्या, मंग कापणीना येळले मी मजुरसले सांगसू की, पहिले निदाण गोया करा, अनं जाळाकरता त्याना पेंढ्या बांधा; अनी गहु मना कोठारसमा साठाडा.<verse eid="MAT 13:30" /></para>
  <para style="s">मोहरीना दाना अनं खमीरनं उदाहरण</para>
  <para style="r">(<ref loc="MRK 4:30-32">मार्क ४:३०-३२</ref>; <ref loc="LUK 13:18-19">लूक १३:१८-१९</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 13:31" />येशुनी त्यासले अजुन एक उदाहरण दिसन सांगं, की, स्वर्गनं राज्य मोहरीना दानासारखं शे; ते कोणी एक माणुसनी लिसन आपला वावरमा जाईन लाई दिधं; <verse eid="MAT 13:31" /><verse number="32" style="v" sid="MAT 13:32" />तो तर सर्वा दानासमा बारीक शे, तरी तो वाढावर पालाभाज्याच पेक्षा मोठा व्हईन त्याना असं झाड व्हस की, आकाशमधला पक्षी ईसन त्याना फांद्यासमा घरटा बांधीसन राहतस.<verse eid="MAT 13:32" /></para>
  <para style="s">दृष्टांतना प्रयोग</para>
  <para style="r">(<ref loc="LUK 13:20-21">लूक 13:20-21</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 13:33" />त्यानी त्यासले अजुन एक दृष्टांत सांगा, की, स्वर्गना राज्य खमीरना सारखं शे; ते एक बाईनी लिसन तीन माप पिठमा लपाईन ठेवं, म्हणीन ते खमीर शेवट सर्व फुगी गयं. <verse eid="MAT 13:33" /><verse number="34" style="v" sid="MAT 13:34" />या सर्वा गोष्टी येशुनी दृष्टांत दिसन लोकसनी गर्दीले सांग्यात; अनी उदाहरणशिवाय तो त्यासनासंगे काहीच बोलना नही; <verse eid="MAT 13:34" /><verse number="35" style="v" sid="MAT 13:35" /><note caller="+" style="x"><char style="xo" closed="false">१३:३५ </char><char style="xt" closed="false"><ref loc="EXO 1">निर्गम</ref>; <ref loc="PSA 78:2">स्तोत्रसंहिता ७८:२</ref></char></note>हाई असाकरता की, संदेष्टासनाद्वारा जे सांगामा येल व्हतं ते पुर्ण व्हावं; ते असं की, मी मनं तोंड उघाडीसन उदाहरण दिसु; जगना सुरवातपाईन जे गुप्त ते मी प्रकट करसु.<verse eid="MAT 13:35" /></para>
  <para style="s">निदाणना उदाहरणना अर्थ</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 13:36" />नंतर येशु लोकसनी गर्दीले निरोप दिसन घरमा गया. अनी त्याना शिष्य त्यानाकडे ईसन बोलनात, वावरमधला निदणना उदाहरणना आमले फोड करीसन सांगा. <verse eid="MAT 13:36" /><verse number="37" style="v" sid="MAT 13:37" />त्यानी उत्तर दिधं की, चांगलं बी पेरणारा हाऊ मनुष्यना पोऱ्या शे; <verse eid="MAT 13:37" /><verse number="38" style="v" sid="MAT 13:38" />शेत हाई जग शे; चांगलं बी हाई राज्याना पोऱ्या शेतस; निदण हाई त्या दुष्टना पोऱ्या शेतस; <verse eid="MAT 13:38" /><verse number="39" style="v" sid="MAT 13:39" />ते पेरणारा वैरी हाऊ सैतान शे; कापणी हाई या काळनी समाप्ती शे; अनी कापणी करनारा या देवदूत शेतस. <verse eid="MAT 13:39" /><verse number="40" style="v" sid="MAT 13:40" />यामुये जश निदाण गोया करीसन अग्नीमा जाळतस, तसच काळना समाप्तीना येळले व्हई. <verse eid="MAT 13:40" /><verse number="41" style="v" sid="MAT 13:41" />मनुष्यना पोऱ्या आपला देवदूतसले धाडी, अनी त्या सर्वा अडखळा आणनारासले अनं अधर्म करनारासले त्याना राज्यमाईन गोया करतीन. <verse eid="MAT 13:41" /><verse number="42" style="v" sid="MAT 13:42" />अनं त्यासले नरक अग्नीना भट्टीमा टाकतीन; तठे त्यासनं रडानं अनं दात खाणं राही. <verse eid="MAT 13:42" /><verse number="43" style="v" sid="MAT 13:43" />तवय “धार्मीकजण आपला बापना राज्यमा सूर्याना मायक ‘चमकतीन’ ज्याले कान शे तो ऐको.”<verse eid="MAT 13:43" /></para>
  <para style="s">मोती, ठेव अनं जाळं यासना दृष्टांत</para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 13:44" />स्वर्गनं राज्य शेतमा लपाईन ठेयल धनसारखं शे; ते एखादा माणुसले सापडावर त्यानी ते लपाईन ठेवं, अनी आनंद व्हवामुये त्यानी जाईसन आपला सर्व काही ईकी टाकं, अनी मंग ते शेत ईकत लिधं.<verse eid="MAT 13:44" /></para>
  <para style="s">चांगला मोतीना दृष्टांत</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 13:45" />अजुन स्वर्गनं राज्य चांगला मोतीना शोध करनारा एखादा व्यापारीना सारखं शे; <verse eid="MAT 13:45" /><verse number="46" style="v" sid="MAT 13:46" />त्याले एक अति मोलवान मोती आढळना तवय जाईसन त्यानी आपलं सर्वा काही ईकी टाकं अनी ते ईकत लिधं.<verse eid="MAT 13:46" /></para>
  <para style="s">मासा धरनाराना जाळना दृष्टांत</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 13:47" />अजुन स्वर्गनं राज्य समुद्रमा टाकेल जाळानामायक शे; ज्यामा सर्वा प्रकारना जीव एकत्र सापडतस. <verse eid="MAT 13:47" /><verse number="48" style="v" sid="MAT 13:48" />ते भरावर माणसंसनी काठवर ओढी आणं अनी त्यासनी बशीसन ज्या चांगला त्या भांडामा गोया करात, अनं वाईट त्या फेकी दिधात. <verse eid="MAT 13:48" /><verse number="49" style="v" sid="MAT 13:49" />तसच हाई युगना समाप्तीमा व्हई; देवदूत ईसन धार्मीकसपाईन दुष्टासले वेगळा करतीन; <verse eid="MAT 13:49" /><verse number="50" style="v" sid="MAT 13:50" />अनी त्यासले अग्नीना भट्टीमा टाकतीन, तठे रडानं अनं दातखाणं राही.<verse eid="MAT 13:50" /></para>
  <para style="s">जुना अनी नवाना दृष्टांत</para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 13:51" />तुमले या गोष्टी समजन्यात का? त्या त्याले बोलनात, हा. <verse eid="MAT 13:51" /><verse number="52" style="v" sid="MAT 13:52" />तवय त्यानी त्यासले सांगं, जो प्रत्येक शास्त्री स्वर्गना राज्यना शिष्य व्हयेल शे तो आपला भांडामाईन नवा जुना पदार्थ काढनारा माणुसना मायक शे.<verse eid="MAT 13:52" /></para>
  <para style="s">येशुना नासरेथमा स्वीकार करतस नही</para>
  <para style="r">(<ref loc="MRK 6:1-6">मार्क ६:१-६</ref>; <ref loc="LUK 4:16-30">लूक ४:१६-३०</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MAT 13:53" />मंग असं व्हयनं की, या दृष्टांत समाप्त करावर येशु तठेन निंघी गया; <verse eid="MAT 13:53" /><verse number="54" style="v" sid="MAT 13:54" />अनी आपला गाववर येवावर त्यानी त्यासना सभास्थानमा त्यासले असं शिकाडं की, त्या थक्क व्हईसन बोलनात की, हाई ज्ञान अनं हाई सामर्थ्य याले कोठेन प्रकट व्हयनं? <verse eid="MAT 13:54" /><verse number="55" style="v" sid="MAT 13:55" />काय हाऊ सुतारना पोऱ्या नही शे का? यानी मायले मरीया म्हणतस ना? याकोब, योसेफ, शिमोन अनं यहूदा, या त्याना भाऊ शेतस ना? <verse eid="MAT 13:55" /><verse number="56" style="v" sid="MAT 13:56" />अनी याना सर्व बहिणी या आपलाबरोबर राहतस नही का? तर हाई सर्वा याले कोठेन मिळनं? <verse eid="MAT 13:56" /><verse number="57" style="v" sid="MAT 13:57" /><note caller="+" style="x"><char style="xo" closed="false">१३:५७ </char><char style="xt" closed="false"><ref loc="JHN 4:44">योहान ४:४४</ref></char></note>अस ऐकीन त्यासले ठोकर लागनी. पण येशुनी त्यासले सांगं, संदेष्टाले आपला देश अनं आपला घर, नातेवाईक यासमा सन्मान मिळस नही<note caller="+" style="x"><char style="xo" closed="false">१३:५७ </char><char style="xt" closed="false"><ref loc="JHN 4:44">योहान ४:४४</ref></char></note>. <verse eid="MAT 13:57" /><verse number="58" style="v" sid="MAT 13:58" />त्यासना अईश्वासमुये त्यानी तठे जास्त चमत्कार करात नही.<verse eid="MAT 13:58" /></para>
  <chapter eid="MAT 13" />
  <chapter number="14" style="c" sid="MAT 14" />
  <para style="s">बाप्तिस्मा करनारा योहानना वध</para>
  <para style="r">(<ref loc="MRK 6:14-29">मार्क ६:१४-२९</ref>; <ref loc="LUK 9:7-9">लूक ९:७-९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 14:1" />त्या दिनसमा हेरोद राजानी येशुबद्दल ऐकं; <verse eid="MAT 14:1" /><verse number="2" style="v" sid="MAT 14:2" />अनी आपला सेवकसले सांगं, हाऊ बाप्तिस्मा करनारा योहान शे; हाऊ मरेल मातीन ऊठेल शे म्हणीन या चमत्कार त्यानामा व्हई राहिनात. <verse eid="MAT 14:2" /><verse number="3" style="v" sid="MAT 14:3" /><note caller="+" style="x"><char style="xo" closed="false">१४:३ </char><char style="xt" closed="false"><ref loc="LUK 3:19">लूक ३:१९</ref>,<ref loc="LUK 3:20">२०</ref></char></note>कारण हेरोदनी आपला भाऊ फिलीप्प यानी बायको हेरोदीया हिनामुये बाप्तिस्मा करनारा योहानले धरीसन अनं बांधीन कैदखानामा टाकेल व्हतं; <verse eid="MAT 14:3" /><verse number="4" style="v" sid="MAT 14:4" />कारण योहान त्याले सांगे, की, तु तिले ठेवावं हाई तुनाकरता योग्य नही; <verse eid="MAT 14:4" /><verse number="5" style="v" sid="MAT 14:5" />अनी हेरोद राजा त्याले मारा करता दखे पण लोकसनी त्याले भिती वाटे कारण लोके योहानले संदेष्टा समजेत. <verse eid="MAT 14:5" /><verse number="6" style="v" sid="MAT 14:6" />नंतर हेरोदना जन्मदिन वना तवय हेरोदियानी पोरनी दरबारमा नाचगाणा करीसन हेरोदले खूश करं. <verse eid="MAT 14:6" /><verse number="7" style="v" sid="MAT 14:7" />म्हणीन त्यानी तिले शपथ वाहिसन वचन दिधं की, जे काही तु मनापाशी मांगशी ते मी तुले दिसु. <verse eid="MAT 14:7" /><verse number="8" style="v" sid="MAT 14:8" />मंग तिले मायनी शिकाडेल प्रमाणे तिनी सांगं, बाप्तिस्मा करनारा योहाननं मुंडकं ताटमा ठेईसन माले आठे आणी द्या. <verse eid="MAT 14:8" /><verse number="9" style="v" sid="MAT 14:9" />तवय राजाले खुप वाईट वाटनं; तरी आपली देयल शपथमुये अनी ज्या पंक्तिस्मा बठेल व्हतात त्यासनामुये त्यानी ते देवानी आज्ञा करी. <verse eid="MAT 14:9" /><verse number="10" style="v" sid="MAT 14:10" />तवय त्यानी माणसं धाडीसन कैदखानामा योहानना वध करा. <verse eid="MAT 14:10" /><verse number="11" style="v" sid="MAT 14:11" />मंग त्याना मुंडकं ताटमा ठेईसन पोरले आणी दिधं अनी तिनी ते आपली मायनाजोडे आणं. <verse eid="MAT 14:11" /><verse number="12" style="v" sid="MAT 14:12" />मंग त्याना शिष्यसनी ईसन त्यानं प्रेत उचलीन आणं अनं त्याले पुरी टाकं; अनी जाईसन येशुले हाई बातमी दिधी.<verse eid="MAT 14:12" /></para>
  <para style="s">पाच हजारसले जेवण</para>
  <para style="r">(<ref loc="MRK 6:30-44">मार्क ६:३०-४४</ref>; <ref loc="LUK 9:10-17">लूक ९:१०-१७</ref>; <ref loc="JHN 6:1-14">योहान ६:१-१४</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 14:13" />हाई ऐकीसन येशु तठेन नावमा बशीन निंघना अनी एकांतमा गया; हाई ऐकीसन लोकसनी गर्दी नगरमातीन त्यानामांगे पायीपायी गयी. <verse eid="MAT 14:13" /><verse number="14" style="v" sid="MAT 14:14" />मंग त्यानी बाहेर ईसन लोकसनी गर्दी दखी; तवय त्याले त्यासनी किव वनी अनं त्यासनामा बराच रोगीसले त्यानी बरं करं. <verse eid="MAT 14:14" /><verse number="15" style="v" sid="MAT 14:15" />मंग संध्याकाय व्हवावर त्याना शिष्य त्यानाकडे ईसन बोलनात, हाई एकांतनी जागा शे अनं येळ व्हई जायेल शे; तर लोकसनी गावमा जाईसन स्वतःकरता खावाले अन्न ईकत लई येवाले पाहिजे म्हणीसन त्यासले निरोप द्या. <verse eid="MAT 14:15" /><verse number="16" style="v" sid="MAT 14:16" />येशु त्यासले बोलना, लोकसले जावानी गरज नही; तुम्हीनच त्यासले खावाले द्या. <verse eid="MAT 14:16" /><verse number="17" style="v" sid="MAT 14:17" />त्या त्याले बोलनात, आमनाजोडे फक्त पाच भाकरी अनं दोन मासा शेतस. <verse eid="MAT 14:17" /><verse number="18" style="v" sid="MAT 14:18" />येशुनी सांगं, ते ईकडं मनाजोडे आणा. <verse eid="MAT 14:18" /><verse number="19" style="v" sid="MAT 14:19" />मंग येशुनी लोकसनी गर्दीले गवतमा बसानी आज्ञा करी अनी त्या पाच भाकरी अनं दोन मासा लिसन त्यानी वर आकाशमा दखीन आशिर्वाद मांगा अनी भाकरी मोडीसन शिष्यसकडे दिध्यात अनं शिष्यसनी त्या लोकसले वाढी दिध्यात. <verse eid="MAT 14:19" /><verse number="20" style="v" sid="MAT 14:20" />मंग त्या सर्वा खाईसन तृप्त व्हईनात; अनी उरेल तुकडासना बारा टोपला त्यासनी भरी लिध्यात. <verse eid="MAT 14:20" /><verse number="21" style="v" sid="MAT 14:21" />खाणारा सर्वा पाच हजार माणसं व्हतात; अनी बाया अनं पोऱ्या या अजुन निराळाच व्हतात.<verse eid="MAT 14:21" /></para>
  <para style="s">येशु समुद्रवरतीन चालस</para>
  <para style="r">(<ref loc="MRK 6:45-52">मार्क ६:४५-५२</ref>; <ref loc="JHN 6:15-21">योहान ६:१५-२१</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 14:22" />नंतर, मी लोकसनी गर्दीले निरोप दिसन येस तोपावत तुम्हीन नावमा बशीन मनापुढे दुसरी बाजुले जा, अस म्हणीसन येशुनी शिष्यसले लगेच धाडी दिधं. <verse eid="MAT 14:22" /><verse number="23" style="v" sid="MAT 14:23" />मंग लोकसले निरोप देवावर तो प्रार्थना कराले डोंगरवर एकलाच गया अनी रात व्हवावर पण येशु तठे एकलाच व्हता. <verse eid="MAT 14:23" /><verse number="24" style="v" sid="MAT 14:24" />ईकडं वारा तोंडना दिशातीन ऱ्हावामुये किनारापाईन बराच अंतरमा नाव समुद्रना मधला भागमा लाटासघाई हैराण व्हई जायेल व्हती. <verse eid="MAT 14:24" /><verse number="25" style="v" sid="MAT 14:25" />तवय पहाटले तीन ते सव वाजाना दरम्यान येशु समुद्रवरतीन चालत त्यासनाजोडे वना. <verse eid="MAT 14:25" /><verse number="26" style="v" sid="MAT 14:26" />शिष्य त्याले समुद्रवरतीन चालतांना दखीसन घाबरी गयात अनं त्या भ्याईसन वरडनात; हाई भूत शे. <verse eid="MAT 14:26" /><verse number="27" style="v" sid="MAT 14:27" />पण येशु त्यासले लगेच बोलना, धीर धरा मी शे; घाबरू नका. <verse eid="MAT 14:27" /><verse number="28" style="v" sid="MAT 14:28" />तवय पेत्रनी उत्तर दिधं, प्रभुजी, जर तुम्हीन शेतस तर पाणीवरतीन तुमना जोडे येवाले माले सांगा.<verse eid="MAT 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 14:29" />त्यानी सांगं, ये; तवय पेत्र येशुकडे जावाकरता नावमाईन उतरीसन चालाले लागना; <verse eid="MAT 14:29" /><verse number="30" style="v" sid="MAT 14:30" />पण वारा दखीसन तो भ्याईना अनी बुडाले लागना तवय तो वरडना, प्रभुजी, माले वाचाडा.<verse eid="MAT 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 14:31" />येशुनी लगेच हात पुढं करीसन त्याले धरं अनं बोलना, अरे अल्पईश्वासी तु शंका कशाले धरी?<verse eid="MAT 14:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 14:32" />मंग त्या नावमा चढनात तवय वारा बंद पडना. <verse eid="MAT 14:32" /><verse number="33" style="v" sid="MAT 14:33" />तवय ज्या नावमा व्हतात त्या सर्वा त्याना पाया पडीसन बोलनात, तुम्हीन खरोखर देवना पोऱ्या शेतस.<verse eid="MAT 14:33" /></para>
  <para style="s">येशु गनेसरेत गावमा रोगीसले बरं करस</para>
  <para style="r">(<ref loc="MRK 6:53-56">मार्क ६:५३-५६</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 14:34" />नंतर त्या दुसरा बाजुले जाईसन गनेसरेत प्रांतमा गयात; <verse eid="MAT 14:34" /><verse number="35" style="v" sid="MAT 14:35" />अनी तठला लोकसनी त्याले वळखीन आपला आसपासना सर्वा नगरमा माणसं धाडीसन आजारी लोकसले त्यानाकडे आणं. <verse eid="MAT 14:35" /><verse number="36" style="v" sid="MAT 14:36" />अनी फक्त तुमना कपडासले आमले हात लावु द्या, अशी त्यासनी त्याले ईनंती करी; तवय जितलासनी त्याले हात लावा तितला सर्वा बरा व्हईनात.<verse eid="MAT 14:36" /></para>
  <chapter eid="MAT 14" />
  <chapter number="15" style="c" sid="MAT 15" />
  <para style="s">परंपराना प्रश्न</para>
  <para style="r">(<ref loc="MRK 7:1-13">मार्क ७:१-१३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 15:1" />मंग यरूशलेमतीन परूशी अनं शास्त्री येशुकडे ईसन बोलणात, <verse eid="MAT 15:1" /><verse number="2" style="v" sid="MAT 15:2" />तुमना शिष्य पुर्वजसना रितीरिवाज का बर मोडतस? कारण जेवणना पहिले त्या हात धोतस नही. <verse eid="MAT 15:2" /><verse number="3" style="v" sid="MAT 15:3" />त्यानी त्यासले उत्तर दिधं, तुमना रितीरिवाजकरता तुम्हीन बी देवनी आज्ञा का बर मोडतस? <verse eid="MAT 15:3" /><verse number="4" style="v" sid="MAT 15:4" />कारण देवनी सांगेल शे की, तु “तुना बाप अनी तुनी माय यासना मान ठेव,” अनी जो कोणी बापनी किंवा मायनी निंदा करस त्याले मरणदंडनी शिक्षा व्हई; <verse eid="MAT 15:4" /><verse number="5" style="v" sid="MAT 15:5" />पण तुम्हीन सांगतस की, जो कोणी स्वतःना माय बापले अस सांगी, मी जे तुमले देणार व्हतु, ते मी देवले अर्पण करी टाकं. <verse eid="MAT 15:5" /><verse number="6" style="v" sid="MAT 15:6" />त्यानी स्वतःना मायबापना मान नही ठेवा तरी चाली, हाई सांगीन तुम्हीन तुमना रितीरिवाजकरता देवनं वचन मोडी टाकेल शे. <verse eid="MAT 15:6" /><verse number="7" style="v" sid="MAT 15:7" />अरे ढोंगीसवन, यशया संदेष्टानी तुमनाबद्दल बरोबर भविष्य करेल शे की, <verse eid="MAT 15:7" /><verse number="8" style="v" sid="MAT 15:8" />ह्या लोके तोंडघाई मना सन्मान करतस पण त्यासनं मन मनापाईन दुर शे. <verse eid="MAT 15:8" /><verse number="9" style="v" sid="MAT 15:9" />त्या माणुसनी बनाडेल विधीसले मनं शास्त्र मानिसन शिकाडतस अनं बिनकामनी मनी भक्ती करतस. <figure style="fig" alt="Ceremonial washing" file="lb00280c.tif" size="col" copy="Horace Knowles ©" ref="१५:२">यहूदीसनी हात धोवानी परंपरा</figure><verse eid="MAT 15:9" /></para>
  <para style="s">अशुध्द करनारी गोष्ट</para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 15:10" />तवय त्यानी लोकसनी गर्दीले जवळ बलाईन सांगं, ऐका अनं समजी ल्या. <verse eid="MAT 15:10" /><verse number="11" style="v" sid="MAT 15:11" />जे तोंडमा जास ते माणुसले अशुध्द करस नही, तर जे तोंडमाईन निंघस ते माणुसले अशुध्द करस. <verse eid="MAT 15:11" /><verse number="12" style="v" sid="MAT 15:12" />नंतर शिष्य ईसन त्याले बोलणात, हाई वचन ऐकीन परूशी नाराज व्हयनात, हाई तुमले समजनं का? <verse eid="MAT 15:12" /><verse number="13" style="v" sid="MAT 15:13" />त्यानी उत्तर दिधं की, ज्या ज्या रोपटा मना स्वर्ग माधला बापनी लायेल नही, त्या त्या उपटाई जातीन. <verse eid="MAT 15:13" /><verse number="14" style="v" sid="MAT 15:14" /><note caller="+" style="x"><char style="xo" closed="false">१५:१४ </char><char style="xt" closed="false"><ref loc="LUK 6:39">लूक ६:३९</ref></char></note>त्यासले राहु द्या; त्या आंधया मार्गदर्शक शेतस, अनी आंधया आंधयाले ली जाई तर दोन्ही बी खड्डामा पडतीन. <verse eid="MAT 15:14" /><verse number="15" style="v" sid="MAT 15:15" />पेत्र त्याले बोलना, हाऊ दृष्टांत आमले फोडीन सांगा, <verse eid="MAT 15:15" /><verse number="16" style="v" sid="MAT 15:16" />तो बोलना, तुमले बी अजुन समजनं नही का? <verse eid="MAT 15:16" /><verse number="17" style="v" sid="MAT 15:17" />जे तोंडमा जास ते पोटमा उतरस अनं नंतर शरिरबाहेर टाकाय जास, हाई तुमले समजत नही का? <verse eid="MAT 15:17" /><verse number="18" style="v" sid="MAT 15:18" /><note caller="+" style="x"><char style="xo" closed="false">१५:१८ </char><char style="xt" closed="false"><ref loc="MAT 12:34">मत्तय १२:३४</ref></char></note>जे तोंडमाईन निंघस ते मनमातीन येस अनं माणुसले अशुध्द करस. <verse eid="MAT 15:18" /><verse number="19" style="v" sid="MAT 15:19" />मनमातीन दुष्ट ईचार, खुन, व्यभिचार, जारकर्मे, चोऱ्या, खोट्या साक्षी, गाळ्या, निंदा, ह्या निंघतस. <verse eid="MAT 15:19" /><verse number="20" style="v" sid="MAT 15:20" />ह्या गोष्टी माणुसले अशुध्द करतस; हात न धोता जेवण करानं हाई माणुसले अशुध्द करस नही.<verse eid="MAT 15:20" /></para>
  <para style="s">कनानी बाईना ईश्वास</para>
  <para style="r">(<ref loc="MRK 7:24-30">मार्क ७:२४-३०</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 15:21" />नंतर येशु तठेन निंघीन सोर अनं सिदोन प्रांतमा गया; <verse eid="MAT 15:21" /><verse number="22" style="v" sid="MAT 15:22" />अनी दखा, त्या प्रांतमातीन एक कनानी बाई ईसन वरडीन बोलनी, प्रभु, दावीदना पोऱ्या, मनावर दया कर, मनी पोरले दुष्ट आत्मा भलताच तरास दि ऱ्हाईना शे. <verse eid="MAT 15:22" /><verse number="23" style="v" sid="MAT 15:23" />तरी तो तिले काहीच नही बोलना; तवय त्याना शिष्यसनी जोडे ईसन त्याले ईनंती करी की, तिले परत धाडी द्या; कारण ती आमनामांगे वरडत ई राहिनी. <verse eid="MAT 15:23" /><verse number="24" style="v" sid="MAT 15:24" />त्यानी उत्तर दिधं, माले इस्त्राएलना खानदानमधला दवडायेल मेंढरसशिवाय दुसरा कोणाचकरता धाडेल नही शे. <verse eid="MAT 15:24" /><verse number="25" style="v" sid="MAT 15:25" />तवय ती ईसन त्याना पाया पडीन बोलनी, प्रभुजी, माले मदत करा. <verse eid="MAT 15:25" /><verse number="26" style="v" sid="MAT 15:26" />येशुनी उत्तर दिधं, पोऱ्यासनी भाकर लिसन कुत्राले टाकानी हाई बराबर नही शे. <verse eid="MAT 15:26" /><verse number="27" style="v" sid="MAT 15:27" />ती बोलनी, बराबर शे, प्रभु; पण कुत्रा बी आपला मालकना ताटमातीन पडेल उष्ट खातस. <verse eid="MAT 15:27" /><verse number="28" style="v" sid="MAT 15:28" />तवय येशुनी तिले उत्तर दिधं, बाई, “तुना ईश्वास मोठा शे, जशी तुनी ईच्छा शे तस तुनाकरता होवो; अनी त्याच येळले तिनी पोर बरी व्हयनी.”<verse eid="MAT 15:28" /></para>
  <para style="s">बराच रोगी बरा व्हतस</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 15:29" />नंतर येशु तठेन निंघीन गालील समुद्रजोडे वना, अनं डोंगरवर जाईन बठना <verse eid="MAT 15:29" /><verse number="30" style="v" sid="MAT 15:30" />मंग लोकसनी गर्दी त्यानाकडे वनी; त्यासनासंगे लंगडा, पांगया, आंधया, मुक्का अनं दुसरा बराच जण व्हतात; त्यासले त्यासनी त्याना पायजोडे ठेई दिधं अनी त्यानी त्यासले बरं करं. <verse eid="MAT 15:30" /><verse number="31" style="v" sid="MAT 15:31" />लोकसनी गर्दीनी हाई दखं की मुक्का बोलतस, पांगया बरा व्हतस, लंगडा चालतस अनं आंधया दखतस तवय लोके आश्चर्यचकीत व्हयनात अनी त्यासनी इस्त्राएलना देवना गौरव करा.<verse eid="MAT 15:31" /></para>
  <para style="s">चार हजार लोकसले जेवण</para>
  <para style="r">(<ref loc="MRK 8:1-10">मार्क ८:१-१०</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 15:32" />मंग येशुनी आपला शिष्यसले बलाईन सांगं, माले लोकसनी किव ई राहीनी, कारण तिन दिनपाईन त्या मनासंगे शेतस अनी त्यासनाजोडे खावाले काहीच नही; कदाचित त्या वाटमा मरगळेलना मायक पडतीन; म्हणीन त्यासले भूक्या धाडानी मनी ईच्छा नही शे. <verse eid="MAT 15:32" /><verse number="33" style="v" sid="MAT 15:33" />शिष्यसनी त्याले सांगं, असा जंगलमा इतला लोकसनी भूक मिटी इतल्या भाकरी आमनाजोडे कोठेन येतीन? <verse eid="MAT 15:33" /><verse number="34" style="v" sid="MAT 15:34" />येशुनी त्यासले ईचारं, तुमना जोडे कितल्या भाकरी शेतस? त्या बोलणात सात भाकरी अनं काही धाकला मासा. <verse eid="MAT 15:34" /><verse number="35" style="v" sid="MAT 15:35" />मंग त्यानी लोकसनी गर्दीले जमीनवर बठाले सांगं. <verse eid="MAT 15:35" /><verse number="36" style="v" sid="MAT 15:36" />नंतर त्यानी त्या सात भाकरी अनं धाकला मासा लिसन देवना उपकार मनीन; त्या मोडीसन शिष्यसले दिध्यात अनी शिष्यसनी ते लोकसले वाटी दिध्यात. <verse eid="MAT 15:36" /><verse number="37" style="v" sid="MAT 15:37" />मंग त्या सर्वा खाईसन तृप्त व्हयनात अनी उरेल तुकडसना सात टोपला भरी लिधात. <verse eid="MAT 15:37" /><verse number="38" style="v" sid="MAT 15:38" />जेवढासनी खादं त्यानामा बाया अनं पोऱ्या सोडीसन चार हजार माणसे व्हतात. <verse eid="MAT 15:38" /><verse number="39" style="v" sid="MAT 15:39" />मंग लोकसनी गर्दीले घर धाडावर तो नावमा बशीन मगदानना प्रांतमा वना.<verse eid="MAT 15:39" /></para>
  <chapter eid="MAT 15" />
  <chapter number="16" style="c" sid="MAT 16" />
  <para style="s">चिन्ह दखाड अशी मागणी</para>
  <para style="r">(<ref loc="MRK 8:11-13">मार्क ८:११-१३</ref>; <ref loc="LUK 12:54-56">लूक १२:५४-५६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 16:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">मत्तय १२:३८</ref>; <ref loc="LUK 11:16">लूक ११:१६</ref></char>
    </note>तवय परूशी अनी सदुकी यासनी ईसन येशुनी परिक्षा दखाकरता, त्याले सांगं आमले आकाशमातील काहीतरी चिन्ह दखाड. <verse eid="MAT 16:1" /><verse number="2" style="v" sid="MAT 16:2" />त्यानी त्यासले उत्तर दिधं, जवय संध्याकाय व्हस तवय तुम्हीन सांगतस, थंडावा राही कारण आकाश लाल शे; <verse eid="MAT 16:2" /><verse number="3" style="v" sid="MAT 16:3" />अनी तुम्हीन पहाटले म्हणतस, आज वादळी वारा सूटी, कारण आकाश लाल भयानक शे, आकाशना लक्षणं तुमले वळखाणं जमस पण काळना लक्षणं तुमले वळखता येतस नही! <verse eid="MAT 16:3" /><verse number="4" style="v" sid="MAT 16:4" /><note caller="+" style="x"><char style="xo" closed="false">१६:४ </char><char style="xt" closed="false"><ref loc="MAT 12:39">मत्तय १२:३९</ref>; <ref loc="LUK 11:29">लूक ११:२९</ref></char></note>हाई दुष्ट अनं व्यभिचारी पिढी चिन्ह मांगस, पण ईले योना संदेष्टाना चिन्हशिवाय दुसरा चिन्ह मिळाव नही. मंग येशु त्यासले सोडीसन निंघी गया.<verse eid="MAT 16:4" /></para>
  <para style="s">परूशी अनं सदुकी यासना खमीर</para>
  <para style="r">(<ref loc="MRK 8:14-21">मार्क ८:१४-२१</ref>)</para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 16:5" />नंतर शिष्य दुसरी बाजुले गयात पण त्या भाकरी लेवाले ईसरी गयात. <verse eid="MAT 16:5" /><verse number="6" style="v" sid="MAT 16:6" /><note caller="+" style="x"><char style="xo" closed="false">१६:६ </char><char style="xt" closed="false"><ref loc="LUK 12:1">लूक १२:१</ref></char></note>तवय येशु त्यासले बोलना, परूशी अनं सदुकी यासना खमीरपाईन सावधान राहा. <verse eid="MAT 16:6" /><verse number="7" style="v" sid="MAT 16:7" />तवय त्या चर्चा करीसन एकमेकसले बोलणात, आपण भाकरी लयनुत नही म्हणीन हाऊ असा बोली राहीना. <verse eid="MAT 16:7" /><verse number="8" style="v" sid="MAT 16:8" />पण येशु हाई वळखीन बोलना, अरे ओ अईश्वासीहो, तुम्हीन मनमा अस का बर आणतस की, आपलाजोडे भाकरी नही शेतस म्हणीन हाऊ अस बोली राहीना. <verse eid="MAT 16:8" /><verse number="9" style="v" sid="MAT 16:9" /><note caller="+" style="x"><char style="xo" closed="false">१६:९ </char><char style="xt" closed="false"><ref loc="MAT 14:17-21">मत्तय १४:१७-२१</ref></char></note>तुमले अजुन नही समजनं का, पाच हजार लोकसकरता पाच भाकरी व्हत्यात तवय तुम्हीन कितला टोपला उचलात? <verse eid="MAT 16:9" /><verse number="10" style="v" sid="MAT 16:10" /><note caller="+" style="x"><char style="xo" closed="false">१६:१० </char><char style="xt" closed="false"><ref loc="MAT 15:34-38">मत्तय १५:३४-३८</ref></char></note>तसाच चार हजार लोकसले सात भाकरी वाटावर कितला टोपला उचलात; यानी तुमले आठवण नही काय? <verse eid="MAT 16:10" /><verse number="11" style="v" sid="MAT 16:11" />मी भाकरीसनाबद्दल बोलनु नही, हाई तुम्हीन समजी का बर लेतस नही? पण मी तुमले हाई सांगस की, तुम्हीन परूशी अनं सदुकी यासना खमीरपाईन सावधान राहा. <verse eid="MAT 16:11" /><verse number="12" style="v" sid="MAT 16:12" />तवय त्यासले समजनं की, त्यानी भाकरना खमीरबद्दल नही, तर परूशी अनं सदुकी यासना शिक्षणबद्दल सावध ऱ्हावाले सांगं.<verse eid="MAT 16:12" /></para>
  <para style="s">पेत्र येशुले ख्रिस्त मानस</para>
  <para style="r">(<ref loc="MRK 8:27-30">मार्क ८:२७-३०</ref>; <ref loc="LUK 9:18-21">लूक ९:१८-२१</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 16:13" />नंतर फिलीप्पना कैसरियाना गावसमा येवावर, येशुनी त्याना शिष्यसले ईचारं, मनुष्यना पोऱ्याले लोक काय म्हणतस? <verse eid="MAT 16:13" /><verse number="14" style="v" sid="MAT 16:14" /><note caller="+" style="x"><char style="xo" closed="false">१६:१४ </char><char style="xt" closed="false"><ref loc="MAT 14:1">मत्तय १४:१</ref>,<ref loc="MAT 14:2">२</ref>; <ref loc="MRK 6:14">मार्क ६:१४</ref>,<ref loc="MRK 6:15">१५</ref>; <ref loc="LUK 9:7">लूक ९:७</ref>,<ref loc="LUK 9:8">८</ref></char></note>त्यासनी उत्तर दिधं, काही म्हणतस बाप्तिस्मा करनारा योहान, काही म्हणतस एलिया, अनी बाकीना यिर्मया किंवा संदेष्टामधला एक, असा म्हणतस. <verse eid="MAT 16:14" /><verse number="15" style="v" sid="MAT 16:15" />त्यानी त्यासले ईचारं, पण “तुम्हीन काय म्हणतस, मी कोण शे?” <verse eid="MAT 16:15" /><verse number="16" style="v" sid="MAT 16:16" /><note caller="+" style="x"><char style="xo" closed="false">१६:१६ </char><char style="xt" closed="false"><ref loc="JHN 6:68">योहान ६:६८</ref>,<ref loc="JHN 6:69">६९</ref></char></note>शिमोन पेत्रनी उत्तर दिधं, तुम्हीन जिवत देवना पोऱ्या ख्रिस्त शेतस. <verse eid="MAT 16:16" /><verse number="17" style="v" sid="MAT 16:17" />येशु त्याले बोलना, योनाना पोऱ्या शिमोन तु धन्य शे, कारण हाई रक्त मांसना माणुसपाईन नही, तर मना स्वर्गमधला बापनी हाई तुले प्रकट करेल शे. <verse eid="MAT 16:17" /><verse number="18" style="v" sid="MAT 16:18" />आखो मी तुले हाई बी सांगस, पेत्र खडक शे अनी हाऊ खडकवरच मी मनी मंडळी बनाडसु, अनी नरकनी कोणतीच शक्तीना त्यावर प्रभाव पडाव नही. <verse eid="MAT 16:18" /><verse number="19" style="v" sid="MAT 16:19" /><note caller="+" style="x"><char style="xo" closed="false">१६:१९ </char><char style="xt" closed="false"><ref loc="MAT 18:18">मत्तय १८:१८</ref>; <ref loc="JHN 20:23">योहान २०:२३</ref></char></note>मी तुले स्वर्गना राज्यना किल्ल्या दिसु, अनी पृथ्वीवर जे काही तु बंद करशी ते स्वर्गमा बंद कराई जाई, अनी पृथ्वीवर जे काही तु उघडशी ते स्वर्गमा उघडाई जाई. <verse eid="MAT 16:19" /><verse number="20" style="v" sid="MAT 16:20" />तवय त्यानी शिष्यसले बजाईन आज्ञा करी की, मी ख्रिस्त शे हाई कोणले सांगु नका.<verse eid="MAT 16:20" /></para>
  <para style="s">स्वतःना मृत्यु अनं पुनरूत्थानबद्दल येशुनी करेल भविष्य</para>
  <para style="r">(<ref loc="MRK 8:31-9:1">मार्क ८:३१–९:१</ref>; <ref loc="LUK 9:22-27">लूक ९:२२-२७</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 16:21" />त्या येळपाईन येशु त्याना शिष्यसले सांगु लागना, हाई व्हवानं आवश्यक शे की, “मी यरूशलेमले जासु वडील लोके, मुख्य याजक अनं शास्त्री यासनाकडतीन मना भलता छळ व्हई, माले मारी टाकतीन अनं तिसरा दिनले मी परत जिवत व्हसू.” <verse eid="MAT 16:21" /><verse number="22" style="v" sid="MAT 16:22" />तवय पेत्र त्याले बाजुले लई गया अनं विरोध करी बोलना, प्रभुजी, तुमनावर दया होवो, अस तुमनासंगे व्हणारच नही. <verse eid="MAT 16:22" /><verse number="23" style="v" sid="MAT 16:23" />पण तो वळीसन पेत्रले बोलना, अरे सैतान, मनासमोरतीन निंघी जाय; तु माले आडफाटा शे; कारण देवना गोष्टीसकडे तुनं ध्यान नही, माणससना गोष्टीसकडे शे.<verse eid="MAT 16:23" /></para>
  <para style="s">येशुना मांगे चालाना अर्थ</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 16:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:२४ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">मत्तय १०:३८</ref>; <ref loc="LUK 14:27">लूक १४:२७</ref></char>
    </note>मंग येशुनी त्याना शिष्यसले सांगं, मनामांगे येवानी ज्यानी ईच्छा शे त्यानी स्वतःना त्याग कराना अनी स्वतःना क्रुसखांब उचलीसन मनामांगे चालानं. <verse eid="MAT 16:24" /><verse number="25" style="v" sid="MAT 16:25" /><note caller="+" style="x"><char style="xo" closed="false">१६:२५ </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्तय १०:३९</ref>; <ref loc="LUK 17:33">लूक १७:३३</ref>; <ref loc="JHN 12:25">योहान १२:२५</ref></char></note>कारण जो कोणी स्वतःना जिव वाचाडाले दखी तो त्याले गमाडी; अनी जो कोणी मनाकरता स्वतःना जिव गमाडी त्याले तो परत मिळी. <verse eid="MAT 16:25" /><verse number="26" style="v" sid="MAT 16:26" />माणुसले जगमाधलं सर्व सुख भेटणं अनी स्वतःना जिव गमाडा तर त्याले काय फायदा व्हई? किंवा माणुस स्वतःना जिवना बदलामा काय दि? <verse eid="MAT 16:26" /><verse number="27" style="v" sid="MAT 16:27" /><note caller="+" style="x"><char style="xo" closed="false">१६:२७ </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्तय २५:३१</ref>; </char><char style="xt" closed="false"><ref loc="ROM 2:6">रोम २:६</ref></char></note>कारण मनुष्यना पोऱ्या स्वर्गदूतससंगे आपला बापना गौरवमा ई, तवय तो प्रत्येकले ज्याना त्याना कामप्रमाणे प्रतिफळ दि. <verse eid="MAT 16:27" /><verse number="28" style="v" sid="MAT 16:28" />मी तुमले सत्य सांगस की, काहीजण आठे असा उभा शेतस की, त्या मनुष्यना पोऱ्याले त्याना राज्यमा त्याले दखाशिवाय त्यासले मरणना अनुभव येवावुच नही;<verse eid="MAT 16:28" /></para>
  <chapter eid="MAT 16" />
  <chapter number="17" style="c" sid="MAT 17" />
  <para style="s">येशुनं दिव्य रूप</para>
  <para style="r">(<ref loc="MRK 9:2-13">मार्क ९:२-१३</ref>; <ref loc="LUK 9:28-36">लूक ९:२८-३६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 17:1" />मंग येशु सव दिन नंतर पेत्र, याकोब अनं त्याना भाऊ योहान यासले एक उंच डोंगरवर एकांतमा लई गया. <verse eid="MAT 17:1" /><verse number="2" style="v" sid="MAT 17:2" />तवय त्याना रूप त्यासनासमोर बदलनं; त्याना चेहरा सूर्यनामायक तेजस्वी व्हयना, त्याना कपडा धवळा शुभ्र व्हयनात. <verse eid="MAT 17:2" /><verse number="3" style="v" sid="MAT 17:3" />तवय दखा, मोशे अनं एलिया ह्या त्यानासंगे बोलतांना त्यासले दखायनात. <verse eid="MAT 17:3" /><verse number="4" style="v" sid="MAT 17:4" />मंग पेत्र येशुले बोलना, प्रभुजी आपण आठे राहसुत तर कितलं भारी व्हई; तुमनी ईच्छा व्हई तर मी आठे तिन मंडप बनाडस; तुमनासाठे एक, मोशेकरता एक, अनं एलियाकरता एक. <verse eid="MAT 17:4" /><verse number="5" style="v" sid="MAT 17:5" /><note caller="+" style="x"><char style="xo" closed="false">१७:५ </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्तय ३:१७</ref>; <ref loc="MAT 12:18">१२:१८</ref>; <ref loc="MRK 1:11">मार्क १:११</ref>; <ref loc="LUK 3:22">लूक ३:२२</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">१७:५ </char><char style="xt" closed="false"><ref loc="2PE 1:17">२ पेत्र १:१७</ref>,<ref loc="2PE 1:18">१८</ref></char></note>तो बोली राहिंता तेवढामा, दखा, तेजस्वी ढगनी त्यासले झाकी दिधं अनी दखा, ढगमातीन अशी वाणी व्हईनी; हाऊ मना पोऱ्या, माले परमप्रिय शे, ह्यानावर मी खूश शे; तुम्हीन यानं ऐका. <verse eid="MAT 17:5" /><verse number="6" style="v" sid="MAT 17:6" />हाई ऐकीन येशुना शिष्य भलता घाबरणात अनं पालथा पडी गयात. <verse eid="MAT 17:6" /><verse number="7" style="v" sid="MAT 17:7" />तवय येशु त्यासनाजोडे ईसन हात लाईन बोलना, ऊठा, घाबरू नका. <verse eid="MAT 17:7" /><verse number="8" style="v" sid="MAT 17:8" />मंग त्यासनी वर दखं तवय त्यासले येशुशिवाय कोणीच दखायनं नही. <verse eid="MAT 17:8" /><verse number="9" style="v" sid="MAT 17:9" />नंतर त्या डोंगरवरतीन खाल उतरी राहींतात तवय येशुनी त्यासले आज्ञा करी की, मनुष्यना पोऱ्या मरेल मातीन परत जिवत व्हई तोपावत हाई गोष्ट कोणलेच सांगु नका. <verse eid="MAT 17:9" /><verse number="10" style="v" sid="MAT 17:10" />त्यावर त्याना शिष्यसनी त्याले ईचारं की, एलिया पहिले येवाले पाहिजे अस शास्त्री का बर म्हणतस? <verse eid="MAT 17:10" /><verse number="11" style="v" sid="MAT 17:11" />येशुनी उत्तर दिधं, “एलिया” ईसन सर्वकाही सुधारी हाई खरं शे. <verse eid="MAT 17:11" /><verse number="12" style="v" sid="MAT 17:12" /><note caller="+" style="x"><char style="xo" closed="false">१७:१२ </char><char style="xt" closed="false"><ref loc="MAT 11:14">मत्तय ११:१४</ref></char></note>पण मी तुमले सांगस की, एलिया येल शे अनी त्यासनी त्याले न वळखता त्यासना मनले पटनं तसं त्यानासंगे करं; तसच मनुष्यना पोऱ्याले बी त्यासनाकडतीन छळ सहन करना पडी. <verse eid="MAT 17:12" /><verse number="13" style="v" sid="MAT 17:13" />तवय शिष्यसले समजनं, हाऊ बाप्तिस्मा करनारा योहानबद्दल बोली राहीना.<verse eid="MAT 17:13" /></para>
  <para style="s">दुष्ट आत्मा लागेल पोऱ्या बरा व्हस</para>
  <para style="r">(<ref loc="MRK 9:14-29">मार्क ९:१४-२९</ref>; <ref loc="LUK 9:37-43">लूक ९:३७-४३</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 17:14" />नंतर त्या लोकसजोडे वनात तवय एक माणुस येशु समोर ईसन गुडघा टेकीन बोलना, <verse eid="MAT 17:14" /><verse number="15" style="v" sid="MAT 17:15" />प्रभुजी मना पोऱ्यावर दया करा, कारण त्याले मिर्गी येस, त्याले भलता तरास व्हस; तो घडीघडी आगमा अनं पाणीमा पडस. <verse eid="MAT 17:15" /><verse number="16" style="v" sid="MAT 17:16" />म्हणीन मी त्याले तुमना शिष्यसकडे आणं, पण त्यासनाघाई तो बरा व्हयना नही. <verse eid="MAT 17:16" /><verse number="17" style="v" sid="MAT 17:17" />तवय येशुनी उत्तर दिधं, अरे ओ भ्रष्ट पिढी, कोठपावत मी तुमनासंगे ऱ्हासु? कोठपावत तुमनं सहन करसु? त्या पोऱ्याले मनाकडे लई या. <verse eid="MAT 17:17" /><verse number="18" style="v" sid="MAT 17:18" />मंग येशुनी दुष्ट आत्माले आज्ञा दिधी, तवय त्या पोऱ्यामातीन तो निंघी गया अनी त्याच येळले पोऱ्या बरा व्हयना. <verse eid="MAT 17:18" /><verse number="19" style="v" sid="MAT 17:19" />नंतर शिष्य एकांतमा येशुजोडे ईसन बोलणात, आमनाघाई तो दुष्ट आत्मा का बर नही निंघना? <verse eid="MAT 17:19" /><verse number="20" style="v" sid="MAT 17:20" /><note caller="+" style="x"><char style="xo" closed="false">१७:२० </char><char style="xt" closed="false"><ref loc="MAT 21:21">मत्तय २१:२१</ref>; <ref loc="MRK 11:23">मार्क ११:२३</ref>; <ref loc="1CO 13:2">१ करिंथ १३:२</ref></char></note>त्यानी त्यासले सांगं, तुमना बिनईश्वासमूये; कारण मी तुमले सत्य सांगस की, जर तुमनामा राईना दाणा एवढा जरी ईश्वास व्हई तर हाऊ डोंगरले आठेन तिकडे सरक अस तुम्हीन सांगं तर तो सरकी; अनं तुमले काहीच अशक्य ऱ्हावाव नही. <verse eid="MAT 17:20" /><verse number="21" style="v" sid="MAT 17:21" />तरी बी हाई भूतनी जात प्रार्थना अनं उपासशिवाय निंघस नही.<verse eid="MAT 17:21" /></para>
  <para style="s">दुसरांदाव येशुनी स्वतःना मृत्युबद्दल करेल भविष्य</para>
  <para style="r">(<ref loc="MRK 9:30-32">मार्क ९:३०-३२</ref>; <ref loc="LUK 9:43-45">लूक ९:४३-४५</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 17:22" />त्या गालील नगरमा गोया व्हयनात तवय येशु त्यासले बोलना, मनुष्यना पोऱ्याले लोकसना हातमा धरीन देतीन. <verse eid="MAT 17:22" /><verse number="23" style="v" sid="MAT 17:23" />त्या माले मारी टाकतीन अनी तिसरा दिनले तो परत जिवत व्हई, तवय त्या भलताच नाराज व्हयनात.<verse eid="MAT 17:23" /></para>
  <para style="s">मंदिरना कर</para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 17:24" />जवय त्या कफर्णहुम गावमा वनात तवय मंदिरना कर गोया करनारानी पेत्रले ईचारं, तुमना गुरू मंदिरना कर नही देस का? <verse eid="MAT 17:24" /><verse number="25" style="v" sid="MAT 17:25" />तो बोलना, हा देस, मंग तो घरमा येवावर काही बोलाना पहिलेच येशुनी त्याले ईचारं, शिमोन, तुले काय वाटस? पृथ्वीवरला राजा कोणाकडतीन कर लेतस? आपला पोऱ्यासकडतीन की परकासकडतीन? <verse eid="MAT 17:25" /><verse number="26" style="v" sid="MAT 17:26" />तो बोलना, परकासकडतीन मंग येशु त्याले बोलना, म्हणीन पोऱ्या कर भरापाईन मुक्त शेतस. <verse eid="MAT 17:26" /><verse number="27" style="v" sid="MAT 17:27" />पण त्यासनाकरता आपण अडथळा बनाले नको, म्हणीन तु समुद्रमा जाईसन गळ टाक; अनी जो मासा पहिले वर ई, तो मासा धरीन त्यानं तोंड उघाड; म्हणजे तुले दोन रूपया सापडतीन त्या लिसन मनाबद्दल अनं तुनाबद्दल त्यासले दे.<verse eid="MAT 17:27" /></para>
  <chapter eid="MAT 17" />
  <chapter number="18" style="c" sid="MAT 18" />
  <para style="s">स्वर्गना राज्यमा मोठा कोण?</para>
  <para style="r">(<ref loc="MRK 9:33-37">मार्क ९:३३-३७</ref>; <ref loc="LUK 9:46-48">लूक ९:४६-४८</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 18:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१८:१ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">लूक २२:२४</ref>
      </char>
    </note>त्या येळले शिष्य येशुकडे ईसन बोलणात, स्वर्गना राज्यमा मोठा कोण? <verse eid="MAT 18:1" /><verse number="2" style="v" sid="MAT 18:2" />तवय त्यानी एक धाकला पोऱ्याले बलाईन त्याले त्यासना मझार उभं करं अनी बोलना; <verse eid="MAT 18:2" /><verse number="3" style="v" sid="MAT 18:3" /><note caller="+" style="x"><char style="xo" closed="false">१८:३ </char><char style="xt" closed="false"><ref loc="MRK 10:15">मार्क १०:१५</ref>; <ref loc="LUK 18:17">लूक १८:१७</ref></char></note>मी तुमले सत्य सांगस, की, तुमनं मन बदलाशिवाय अनं तुम्हीन धाकला पोऱ्यासना मायक व्हवाशिवाय स्वर्गना राज्यमा तुमना प्रवेश व्हवावुच नही. <verse eid="MAT 18:3" /><verse number="4" style="v" sid="MAT 18:4" />यामुये जो कोणी स्वतःले ह्या धाकला पोऱ्यासना मायक नम्र करी, तोच स्वर्गना राज्यमा मोठा व्हई; <verse eid="MAT 18:4" /><verse number="5" style="v" sid="MAT 18:5" />अनी जो कोणी मना नावतीन असा धाकला पोऱ्याले जवळ करी त्यानी माले जोडे करं अस व्हई<verse eid="MAT 18:5" /></para>
  <para style="s">आडफाटा आणनारासले इशारा</para>
  <para style="r">(<ref loc="MRK 9:42-48">मार्क ९:४२-४८</ref>; <ref loc="LUK 17:1">लूक १७:१</ref>,<ref loc="LUK 17:2">२</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 18:6" />अनी जो कोणी मनावर ईश्वास ठेवणारा या धाकलासपैकी एखादाले जरी पाप कराले प्रवृत्त करस, त्याना गळामा जातानी मोठी तळी बांधीन समुद्रमा खोल पाणीमा बुडाई देवाणं यामा त्यानं हित शे. <verse eid="MAT 18:6" /><verse number="7" style="v" sid="MAT 18:7" />आडफाटासमुये जगना धिक्कार असो! आडफाटा तर येतीनच, पण जो माणुस आडफाटा लई, त्याना धिक्कार असो! <verse eid="MAT 18:7" /><verse number="8" style="v" sid="MAT 18:8" /><note caller="+" style="x"><char style="xo" closed="false">१८:८ </char><char style="xt" closed="false"><ref loc="MAT 5:30">मत्तय ५:३०</ref></char></note>तुना हात किंवा तुना पाय तुले आडफाटा करी तर त्या तोडीन फेकी दे; दोन हात किंवा दोन पाय राहिसन सार्वकालिक अग्नीमा पडापेक्षा लंगडा व्हईसन सार्वकालिक जिवनमा जावानं हाई तुनाकरता चांगल शे. <verse eid="MAT 18:8" /><verse number="9" style="v" sid="MAT 18:9" /><note caller="+" style="x"><char style="xo" closed="false">१८:९ </char><char style="xt" closed="false"><ref loc="MAT 5:29">मत्तय ५:२९</ref></char></note>तुना डोयानी आडफाटा करा, तर तो उपटी टाक; दोन डोया राहिसन अग्नीनरकमा पडापेक्षा एक डोया राहीसन सार्वकालिक जिवनमा जावानं हाई तुनाकरता चांगल शे. <verse eid="MAT 18:9" /><verse number="10" style="v" sid="MAT 18:10" /><note caller="+" style="x"><char style="xo" closed="false">१८:१० </char><char style="xt" closed="false"><ref loc="LUK 19:10">लूक १९:१०</ref></char></note>“दखा, तुम्हीन ह्या धाकला लेकरंसपैकी एकले बी तुच्छ मानु नका; कारण, मी तुमले सांगस की, स्वर्गमा त्यासना देवदूत मना स्वर्ग माधला बापनं तोंड कायम दखतस.” <verse eid="MAT 18:10" /><verse number="11" style="v" sid="MAT 18:11" />आखो ज्या दवडायेल शेतस त्यासनं तारण कराले मनुष्यना पोऱ्या येल शे.<note caller="+" style="f"><char style="fr" closed="false">१८:११ </char><char style="fq" closed="false">आखो ज्या दवडायेल शेतस त्यासनं तारण कराले मनुष्यना पोऱ्या येल शे. </char><char style="ft" closed="false">काही जुना शास्त्रभागमा हाई वचन वाचाले भेटस नही</char></note><verse eid="MAT 18:11" /></para>
  <para style="s">दवडायेल मेंढरूना दृष्टांत</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 18:12" />तुमले काय वाटस; जर एक माणुसजोडे शंभर मेंढरं शेतस अनी त्यामातीन एक मेंढरू दवडी गयं, तर तो माणुस त्या नव्यान्नव मेंढरसले डोंगरवर सोडीन त्या दवडेल मेंढरूले दखाले जावाव नही का? <verse eid="MAT 18:12" /><verse number="13" style="v" sid="MAT 18:13" />कदाचित ते त्याले सापडनं तर, त्यानाकडे ज्या नव्यान्नव मेंढरं सुरक्षित व्हतात त्यासनापेक्षा जास्त आनंद त्याले ते मेंढरू सापडावर व्हई, हाई मी तुमले सत्य सांगस. <verse eid="MAT 18:13" /><verse number="14" style="v" sid="MAT 18:14" />तसच ह्या धाकलासनामाधला कोणाच नाश व्हवाले नको अशी तुमना स्वर्ग माधला बापनी ईच्छा शे.<verse eid="MAT 18:14" /></para>
  <para style="s">भाऊ बहिणीसना पाप</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 18:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१८:१५ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:3">लूक १७:३</ref>
      </char>
    </note>जर तुना भाऊ पाप करी, तर जा अनी त्याले एकांतमा लई जाईन समजाड, जर त्यानी तुनं ऐकं तर तुना भाऊ तुले परत भेटी गया. <verse eid="MAT 18:15" /><verse number="16" style="v" sid="MAT 18:16" />पण त्यानी जर तुनं नही ऐकं तर तु आखो दोन एक जणसले तुनासंगे लई जा; यानाकरता की, तुम्हीन दोन्ही जे बोलशात त्या प्रत्येक शब्दना ज्या दोन किंवा तीन शेतस त्या साक्षीदार राहतीन अनी त्या बी समजाडतीन. <verse eid="MAT 18:16" /><verse number="17" style="v" sid="MAT 18:17" />अनी जर त्यानी त्यासनं बी ऐकं नही तर मंडळीले सांग; अनी त्यानी मंडळीनं बी नही ऐकं तर, तो तुनासाठे एक जकातदार किंवा परकानामायक व्हवो.<verse eid="MAT 18:17" /></para>
  <para style="s">विरोध करानं अनी परवानंगी देवानं</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 18:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१८:१८ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:19">मत्तय १६:१९</ref>; <ref loc="JHN 20:23">योहान २०:२३</ref></char>
    </note>मी तुमले सत्य सांगस की, जे काही तुम्हीन पृथ्वीवर बंद करशात ते स्वर्गमा बंद व्हई; अनी जे काही तुम्हीन पृथ्वीवर खोलशात, ते स्वर्गमा खोलाई जाई.<verse eid="MAT 18:18" /></para>
  <para style="s">एकत्र प्रार्थना</para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 18:19" />आखो मी तुमले सत्य सांगस, पृथ्वीवर तुमना मातीन दोनजण कोणतीही एक गोष्टकरता एकचित्त व्हईन ईनंती करतीन तर ती ईनंती मना स्वर्ग माधला बापकडतीन पुरी कराई जाई; <verse eid="MAT 18:19" /><verse number="20" style="v" sid="MAT 18:20" />कारण जठे दोन किंवा तिन जण मना नावतीन एकत्र जमतस, तठे त्यासनामा मी शे.<verse eid="MAT 18:20" /></para>
  <para style="s">निर्दय सेवकना दृष्टांत</para>
  <para style="p">
    <verse number="21" style="v" sid="MAT 18:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१८:२१ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:3">लूक १७:३</ref>,<ref loc="LUK 17:4">४</ref></char>
    </note>तवय पेत्र येशुकडे ईसन बोलना, प्रभुजी मना भाऊनी मनाविरूध्द अपराध करा, तर मी त्याले कितला दाव माफ करू? सात दाव का? <verse eid="MAT 18:21" /><verse number="22" style="v" sid="MAT 18:22" />येशुनी त्याले सांगं, मी तुले अस नही म्हणस की, सात दाव, तर सातना सत्तरदाव कर. <verse eid="MAT 18:22" /><verse number="23" style="v" sid="MAT 18:23" />यामुये स्वर्गनं राज्य एक राजाना मायक शे; त्या राजाले आपला सेवकसकडतीन हिशोब ल्यावा अस वाटनं; <verse eid="MAT 18:23" /><verse number="24" style="v" sid="MAT 18:24" />अनी जवय तो हिशोब ली राहिंता तवय ज्यानावर कोटी रूपया कर्ज व्हतं त्याले त्यानाकडे आणं. <verse eid="MAT 18:24" /><verse number="25" style="v" sid="MAT 18:25" />पण त्यान्याकडे कर्ज फेडाले काहीच नव्हतं म्हणीन त्याना मालकनी हुकूम करा की, त्यानी बायको, पोऱ्या अनं त्यानं जे काही व्हई ते ईकीसन त्यानी कर्ज फेडानं. <verse eid="MAT 18:25" /><verse number="26" style="v" sid="MAT 18:26" />तवय त्या दासनी त्याना पाया पडीसन सांगं, माले वागाडी ल्या, म्हणजे मी सर्वकाही फेडी दिसु <verse eid="MAT 18:26" /><verse number="27" style="v" sid="MAT 18:27" />तवय त्या धनीले त्यानी दया वनी अनी त्यानी त्याले अनं त्यानं कर्ज बी माफ करी दिधं. <verse eid="MAT 18:27" /><verse number="28" style="v" sid="MAT 18:28" /><note caller="+" style="f"><char style="fr" closed="false">१८:२८ </char><char style="ft" closed="false">(एक चांदीना शिक्का) (एकदिनार) एक दिननी मजुरी.</char></note>तो सेवक बाहेर गया अनी ज्यानाकडे त्याना शंभर दिनार रूपया बाकी व्हतात असा त्याना जोडीना सेवक त्याले दखायना, तवय त्यानी त्या सेवकनी गचांडी धरीन बोलना, तुनाकडे मनं जे लेणं शे ते दे. <verse eid="MAT 18:28" /><verse number="29" style="v" sid="MAT 18:29" />त्या सेवकनी पाया पडीन रावण्या करात, माले वागाडी ले, म्हणजे तुनं देणं मी फेडी दिसु; <verse eid="MAT 18:29" /><verse number="30" style="v" sid="MAT 18:30" />पण त्यानी त्यानं अजिबात ऐक नही तो कर्ज फेडत नही तोपावत त्यानी त्याले बंदिगृहमा टाकी दिधं. <verse eid="MAT 18:30" /><verse number="31" style="v" sid="MAT 18:31" />तवय हाऊ घडेल प्रकार दखीसन त्यानासंगेना सेवकसले दुःख व्हयनं अनी त्यासनी ईसन सर्वा प्रकार आपला मालकले सांगा. <verse eid="MAT 18:31" /><verse number="32" style="v" sid="MAT 18:32" />तवय त्याना मालकनी त्याले बलाईन सांगं, अरे दुष्ट सेवका, तु माले ईनंती करी अनी मी तुनं सर्व कर्ज माफ करं; <verse eid="MAT 18:32" /><verse number="33" style="v" sid="MAT 18:33" />जशी दया मी तुनावर करी, तशी तुले तुना जोडीदार सेवकवर करता नही वनी का? <verse eid="MAT 18:33" /><verse number="34" style="v" sid="MAT 18:34" />मंग त्याना मालकनी संतापमा त्याले सर्व कर्ज फेडस तोपावत शिक्षा भोगाकरता बंदीगृहाना ताबामा दिधं. <verse eid="MAT 18:34" /><verse number="35" style="v" sid="MAT 18:35" />जर तुम्हीन प्रत्येक आपापला बंधुजणसले मनपाईन माफ कराव नही, तर मना स्वर्ग माधला बाप बी तुमनासंगे तसच करी.<verse eid="MAT 18:35" /></para>
  <chapter eid="MAT 18" />
  <chapter number="19" style="c" sid="MAT 19" />
  <para style="s">सुटपत्रना प्रश्न</para>
  <para style="r">(<ref loc="MRK 10:1-12">मार्क १०:१-१२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 19:1" />नंतर अस व्हयनं की, हाई बोलनं समाप्त करावर येशु गालीलमाईन निंघीन यार्देन नदीना पलीकडला यहूदीया प्रदेशमा गया. <verse eid="MAT 19:1" /><verse number="2" style="v" sid="MAT 19:2" />तवय लोकसनी गर्दी त्यानामांगे गयी; तठे त्यानी त्यासले बरं करं. <verse eid="MAT 19:2" /><verse number="3" style="v" sid="MAT 19:3" />नंतर परूशी त्यानाकडे ईसन त्यानी परिक्षा दखाकरता बोलणात, बायकोले कोणतं बी कारण वरतीन सोडी देवाणं हाई योग्य शे का? <verse eid="MAT 19:3" /><verse number="4" style="v" sid="MAT 19:4" />येशुनी त्यासले उत्तर दिधं, हाई तुमना वाचामा वनं नही का, की ज्यानी त्यासले निर्माण करं, “त्यानी सुरवातलेच पुरूष अनी स्त्रीले बनाडं.” <verse eid="MAT 19:4" /><verse number="5" style="v" sid="MAT 19:5" /><note caller="+" style="x"><char style="xo" closed="false">१९:५ </char><char style="xt" closed="false"><ref loc="GEN 2:24">उत्पती २:२४</ref></char></note>अनं सांगं, “यामुये पोऱ्या माय बापले सोडीसन बायकोसंगे कायम राही अनी त्या एकदेह व्हतीन” <verse eid="MAT 19:5" /><verse number="6" style="v" sid="MAT 19:6" />यामुये पुढे त्या दोन नहीत एकदेह असा शेतस म्हणीन “देवनी जे जोडेल शे ते मनुष्यनी तोडाना प्रयत्न करानं नही” <verse eid="MAT 19:6" /><verse number="7" style="v" sid="MAT 19:7" /><note caller="+" style="x"><char style="xo" closed="false">१९:७ </char><char style="xt" closed="false"><ref loc="MAT 5:31">मत्तय ५:३१</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">१९:७ </char><char style="xt" closed="false"><ref loc="EXO 24:1-4">निर्गम २४:१-४</ref></char></note>त्या त्याले बोलणात, तर “बायकोले सुटपत्र दिसन तिले सोडानं” अशी आज्ञा मोशेनी का बर दिधी? <verse eid="MAT 19:7" /><verse number="8" style="v" sid="MAT 19:8" />येशुनी त्यासले सांगं, तुमना निर्दय मनमुये मोशेनी तुमले तुमन्या बायका सोडु दिध्यात पण सुरवात पाईन अस नव्हतं. <verse eid="MAT 19:8" /><verse number="9" style="v" sid="MAT 19:9" /><note caller="+" style="x"><char style="xo" closed="false">१९:९ </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्तय ५:३२</ref>; <ref loc="1CO 7:10">१ करिंथ ७:१०</ref>,<ref loc="1CO 7:11">११</ref></char></note>मी तुमले सत्य सांगस की, जो कोणी आपली बायकोले व्यभिचारना कारणतीन सोडीन दुसरी करस तो व्यभिचार करस; अनी जो कोणी अशी सोडेल बाईसंगे लगीन करस तो बी व्यभिचार करस. <verse eid="MAT 19:9" /><verse number="10" style="v" sid="MAT 19:10" />शिष्य त्याले बोलणात, जर माणुसना आपली बायकोसंगे असाच संबंध ऱ्हास तर लगीन न करेलच बरं. <verse eid="MAT 19:10" /><verse number="11" style="v" sid="MAT 19:11" />त्यानी त्यासले सांगं, हाई वचन सर्वासघाई पाळाई जास नही; ज्यासले हाई दान देयल शे, त्यासनाघाईच हाई पाळाई जास. <verse eid="MAT 19:11" /><verse number="12" style="v" sid="MAT 19:12" />कारण काहीजण मायना कोखपाईन नपुंसक जन्मले येल शेतस, माणससनी बनाडेल असा बी नपुंसक शेतस, अनी स्वर्गना राज्यकरता स्वतःले नपुंसक करी लिधं असा बी शेतस. ज्याले हाई स्विकारता येस तोच स्विकारस.<verse eid="MAT 19:12" /></para>
  <para style="s">येशु धाकला पोऱ्यासले आशिर्वाद देस</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 19:13" />नंतर येशुनी लेकरसवर हात ठिसन प्रार्थना कराले पाहिजे म्हणीन त्यानाजोडे त्यासले आणं; पण शिष्यसनी आणनारासले धमकाडं. <verse eid="MAT 19:13" /><verse number="14" style="v" sid="MAT 19:14" />येशु बोलणा, बालकसले मनाकडे येऊ द्या त्यासले मना करू नका, कारण स्वर्गनं राज्य यासना मायकसनंच शे. <verse eid="MAT 19:14" /><verse number="15" style="v" sid="MAT 19:15" />मंग त्यासनावर हात ठेईन आशिर्वाद दिसन तो तठेन निंघी गया,<verse eid="MAT 19:15" /></para>
  <para style="s">श्रीमंत तरूण</para>
  <para style="r">(<ref loc="MRK 10:17-31">मार्क १०:१७-३१</ref>; <ref loc="LUK 18:18-30">लूक १८:१८-३०</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 19:16" />नंतर दखा, एकजण ईसन येशुले बोलना, गुरजी, माले सार्वकालिक जिवन मिळावं म्हणीन मी कोणतं चांगलं काम करू? <verse eid="MAT 19:16" /><verse number="17" style="v" sid="MAT 19:17" />त्यानी त्याले सांगं, माले चांगलंपणबद्दल का बर ईचारस? चांगलं अस एकच शे, जर तु सार्वकालिक जिवनमा प्रवेश कराले दखस तर देवनी आज्ञा पाळ. <verse eid="MAT 19:17" /><verse number="18" style="v" sid="MAT 19:18" />त्यानी त्याले ईचारं, कोणत्या? येशुनी सांगं, “मनुष्यहत्या करू नको, चोरी करू नको, खोटी साक्ष देऊ नको. <verse eid="MAT 19:18" /><verse number="19" style="v" sid="MAT 19:19" />आपला बाप अनी आपली माय यासना मान राख” अनी जशी स्वतःवर तशी आपला शेजारीसवर प्रिती कर. <verse eid="MAT 19:19" /><verse number="20" style="v" sid="MAT 19:20" />तो तरूण त्याले बोलना, मी हाई सर्व पाळेल शे; मनामा अजुन काय कमी शे? <verse eid="MAT 19:20" /><verse number="21" style="v" sid="MAT 19:21" />येशुनी त्याले सांगं, तुले परीपुर्ण होणं शे, तर जाय, तुनी धनदौलत इकीसन गरीबसले दे म्हणजे तुले स्वर्गमा धन भेटी; अनी चल, मनामांगे ये. <verse eid="MAT 19:21" /><verse number="22" style="v" sid="MAT 19:22" />पण हाई ऐकीसन तो दुःखी व्हईन निंघी गया, कारण त्यानाकडे भरपुर धनदौलत व्हती. <verse eid="MAT 19:22" /><verse number="23" style="v" sid="MAT 19:23" />तवय येशुनी आपला शिष्यसले सांगं, मी तुमले सत्य सांगस की, स्वर्गना राज्यमा धनवानसना प्रवेश व्हणं कठीण शे. <verse eid="MAT 19:23" /><verse number="24" style="v" sid="MAT 19:24" />आखो तुमले सांगस, देवना राज्यमा धनवानसना प्रवेश व्हणं यानापेक्षा उंटले सुईना नाकमातीन जाणं सोपं शे. <verse eid="MAT 19:24" /><verse number="25" style="v" sid="MAT 19:25" />हाई ऐकीन शिष्य भलताच थक्क व्हईसन बोलणात, तर मंग कोणं तारण व्हई? <verse eid="MAT 19:25" /><verse number="26" style="v" sid="MAT 19:26" />येशुनी त्यासनाकडे दखीन सांगं, हाई मनुष्यले अशक्य शे, “देवले तर सर्व शक्य शे” <verse eid="MAT 19:26" /><verse number="27" style="v" sid="MAT 19:27" />तवय पेत्र त्याले बोलना, आम्हीन सर्व सोडीसन तुमना मांगे येल शेतस, तर आमले काय भेटी? <verse eid="MAT 19:27" /><verse number="28" style="v" sid="MAT 19:28" /><note caller="+" style="x"><char style="xo" closed="false">१९:२८ </char><char style="xt" closed="false"><ref loc="MAT 25:31">मत्तय २५:३१</ref>; </char><char style="xt" closed="false"><ref loc="LUK 22:30">लूक २२:३०</ref></char></note>येशुनी त्यासले सांगं, मी तुमले सत्य सांगस की, जवय सर्वकाही परत नवं व्हई जाई, तवय मनुष्यना पोऱ्या आपला गौरवी राजासनवर बठी, तवय मनामांगे चालणारा तुम्हीन बारा राजासनसवर बठीन इस्त्राएलसना बारा वंशसना न्यायनिवाडा करशात. <verse eid="MAT 19:28" /><verse number="29" style="v" sid="MAT 19:29" />आखो ज्यानी कोणी मना नावतीन घरदार, भाऊ, बहिणी, माय, बाप, पोऱ्या किंवा वावर सोडेल शेतस, त्याले हाई शंभरपट भेटीन सार्वकालिक जिवन हाई वतन भेटी. <verse eid="MAT 19:29" /><verse number="30" style="v" sid="MAT 19:30" /><note caller="+" style="x"><char style="xo" closed="false">१९:३० </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्तय २०:१६</ref>; <ref loc="LUK 13:30">लूक १३:३०</ref></char></note>तरी बराच जणससंगे अस व्हई की, ज्या पहिला शेतस त्या शेवटला व्हतीन अनं ज्या शेवटला शेतस त्या पहिला व्हतीन.<verse eid="MAT 19:30" /></para>
  <chapter eid="MAT 19" />
  <chapter number="20" style="c" sid="MAT 20" />
  <para style="s">द्राक्षमयामधला मजुरसना दृष्टांत</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 20:1" />“स्वर्गना राज्य त्या घरमालकना मायक शे; जो आपला द्राक्षमयामा रोजी मजुर लावाकरता सकायमा बाहेर निंघना.” <verse eid="MAT 20:1" /><verse number="2" style="v" sid="MAT 20:2" />अनी त्यानी रोजनी मजुरी एक चांदिना शिक्का ठराईन मजुरसले द्राक्षमयामा धाडी दिधं. <verse eid="MAT 20:2" /><verse number="3" style="v" sid="MAT 20:3" />मंग तो जवळपास नऊ वाजाले घरना बाहेर गया, तवय त्यानी काही जणसले बजारमा रिकामं उभं दखं. <verse eid="MAT 20:3" /><verse number="4" style="v" sid="MAT 20:4" />तो त्यासले बोलना, तुम्हीन बी द्राक्षमयामा जा, जी मजुरी व्हई ती मी तुमले दिसु; अनी त्या गयात. <verse eid="MAT 20:4" /><verse number="5" style="v" sid="MAT 20:5" />मंग जवळपास बारा वाजता अनं तिन वाजता तो बाहेर गया तवय पण त्यानी तसच करं. <verse eid="MAT 20:5" /><verse number="6" style="v" sid="MAT 20:6" />जवळपास पाच वाजाले तो बाहेर गया, तवय आखो कित्येक जणसले रिकाम उभं दखं. तवय त्यानी त्यासले ईचारं, तुम्हीन पुरा दिन का बर आठे रिकामा उभा राहेल शेतस? <verse eid="MAT 20:6" /><verse number="7" style="v" sid="MAT 20:7" />त्या त्याले बोलणात, आमले कोणी कामवर लाय नही म्हणीन त्यानी त्यासले सांगं, तुम्हीन बी मना द्राक्षमयामा जा. <verse eid="MAT 20:7" /><verse number="8" style="v" sid="MAT 20:8" />मंग संध्याकायले द्राक्षमयाना मालकनी त्याना कारभारीले सांगं, मजुरसले बलाई आनं अनी शेवटला मजुरसपाईन सुरवात करीसन पहिला मजुरपावत त्यासले मजुरी दे. <verse eid="MAT 20:8" /><verse number="9" style="v" sid="MAT 20:9" />तवय जवळपास संध्याकायना पाच वाजता ज्यासले कामवर लायल व्हतं त्यासले पुरा रोज एक चांदीना शिक्का भेटना. <verse eid="MAT 20:9" /><verse number="10" style="v" sid="MAT 20:10" />मंग पहिला मजुर वनात अनी आपले त्यासनापेक्षा जास्त मजुरी भेटी अस त्यासले वाटणं, पण त्यासले बी तेवढाच रोज भेटना. <verse eid="MAT 20:10" /><verse number="11" style="v" sid="MAT 20:11" />तो त्यासनी लेवानंतर त्या मालकबद्दल कुरकुर करीसन बोलणात, <verse eid="MAT 20:11" /><verse number="12" style="v" sid="MAT 20:12" />ह्या शेवटलासनी एकच तास काम करा अनी आम्हीन दिनभर ऊनतान्हमा कष्ट करात तरी तुम्हीन आमले अनी त्यासले मायकच रोज दिधा. <verse eid="MAT 20:12" /><verse number="13" style="v" sid="MAT 20:13" />तवय त्यानी मजुरसमधला एकले उत्तर दिधं, अरे दोस्त, मी तुनावर अन्याय नही करा. हाईच मजुरीमा दिनभर काम करानं, हाई आपलं ठरेल व्हतं ना. <verse eid="MAT 20:13" /><verse number="14" style="v" sid="MAT 20:14" />जे तुले भेटेल शे ते लिसन निंघी जाय; जेवढं तुले तेवढं शेवटनासले पण देवानं अशी मनी ईच्छा शे. <verse eid="MAT 20:14" /><verse number="15" style="v" sid="MAT 20:15" />जे मनं शे त्यानं मी मना मर्जीप्रमाणे करसु, मी कोणा बांधायेल शे का? मनं उदार वागनं तुना डोयामा येस का? <verse eid="MAT 20:15" /><verse number="16" style="v" sid="MAT 20:16" /><note caller="+" style="x"><char style="xo" closed="false">२०:१६ </char><char style="xt" closed="false"><ref loc="MAT 19:30">मत्तय १९:३०</ref>; <ref loc="MRK 10:31">मार्क १०:३१</ref>; <ref loc="LUK 13:30">लूक १३:३०</ref></char></note>याप्रमाणेच शेवटला त्या पहिला अनी पहिला त्या शेवटला व्हतीन.<verse eid="MAT 20:16" /></para>
  <para style="s">तिसरांदाव येशुनी स्वतःना मृत्युबद्दल करेल भविष्य</para>
  <para style="r">(<ref loc="MRK 10:32-34">मार्क १०:३२-३४</ref>; <ref loc="LUK 18:31-34">लूक १८:३१-३४</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 20:17" />यरूशलेमले जातांना येशुनी वाटमा त्याना बारा शिष्यसले एकांतमा लई जाईन सांगं, <verse eid="MAT 20:17" /><verse number="18" style="v" sid="MAT 20:18" />दखा, आपण यरूशलेमले जाई राहिनुत; मनुष्यना पोऱ्याले मुख्य याजक <note caller="+" style="f"><char style="fr" closed="false">२०:१८ </char><char style="fq" closed="false">याजक </char><char style="ft" closed="false">धर्मगुरू</char></note>अनं शास्त्री यासना हवाले करतीन, त्या त्याले मरणदंडसाठे दोषी ठरावतीन. <verse eid="MAT 20:18" /><verse number="19" style="v" sid="MAT 20:19" />त्या त्यानी थट्टा कराले, फटका माराले अनं क्रुसखांबवर खियाले त्याले गैरयहूदीसना हवाले करतीन अनी तिन दिनमा तो परत जिवत व्हई.<verse eid="MAT 20:19" /></para>
  <para style="s">एक मायनी ईनंती</para>
  <para style="r">(<ref loc="MRK 10:35-45">मार्क १०:३५-४५</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 20:20" />तवय जब्दीना पोऱ्यासनी माय तिना पोऱ्याससंगे येशुकडे गई अनी त्याना पाया पडीसन त्याले एक ईनंती करी <verse eid="MAT 20:20" /><verse number="21" style="v" sid="MAT 20:21" />येशुनी तिले ईचारं, तुले काय पाहिजे? ती त्याले बोलनी, तुना राज्यमा मना ह्या दोन्ही पोऱ्यासमाधला एकले उजवीकडे अनी दुसराले तुना डावीकडे बसाडं, अशी मनी ईच्छा शे. <verse eid="MAT 20:21" /><verse number="22" style="v" sid="MAT 20:22" />येशुनी तिले उत्तर दिधं की, तुम्हीन काय मांगी राहीनात तुमले समजत नही. जो प्याला मी पेवाव शे तो तुमले पिता ई का त्या त्याले बोलनात, पिता ई. <verse eid="MAT 20:22" /><verse number="23" style="v" sid="MAT 20:23" />त्यानी त्यासले सांगं, मना प्याला तुम्हीन पिशात हाई खरं, पण मना उजवीकडे अनं डावीकडे बसाना अधिकार देनं मनाकडे नही शे, तर ज्यासनाकरता मना बापनी हाई जागा तयार करेल शे, हाई त्यासनाकरता शे. <verse eid="MAT 20:23" /><verse number="24" style="v" sid="MAT 20:24" />हाई गोष्ट ऐकीन दहा शिष्यसले त्या दोन्ही भाऊसना राग वना. <verse eid="MAT 20:24" /><verse number="25" style="v" sid="MAT 20:25" /><note caller="+" style="x"><char style="xo" closed="false">२०:२५ </char><char style="xt" closed="false"><ref loc="LUK 22:25">लूक २२:२५</ref>,<ref loc="LUK 22:26">२६</ref></char></note>येशुनी त्यासले बलाईसन सांगं, गैरयहूदीसमा अधिकारी प्रभुत्व चालाडतस अनं मोठा लोके बी अधिकार गाजाडतस हाई तुमले माहीत शे. <verse eid="MAT 20:25" /><verse number="26" style="v" sid="MAT 20:26" /><note caller="+" style="x"><char style="xo" closed="false">२०:२६ </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्तय २३:११</ref>; <ref loc="MRK 9:35">मार्क ९:३५</ref>; <ref loc="LUK 22:26">लूक २२:२६</ref></char></note>पण तुमनामा तसं व्हवाले नको; म्हणीन तुमनामा ज्याले कोणले श्रेष्ठ होणं शे, त्यानी पहिले तुमना सेवक व्हवाले पाहिजे. <verse eid="MAT 20:26" /><verse number="27" style="v" sid="MAT 20:27" />अनी तुमनामा ज्याले पहिला व्हवानी ईच्छा शे, त्यानी तुमना दास व्हवाले पाहिजे. <verse eid="MAT 20:27" /><verse number="28" style="v" sid="MAT 20:28" />यामुये मनुष्यना पोऱ्या सेवा करी लेवाले नही तर सेवा कराले अनी बराच लोकसना पापनं मोल म्हणीन आपला जीव देवाले येल शे.<verse eid="MAT 20:28" /></para>
  <para style="s">दोन आंधयासले दृष्टीदान</para>
  <para style="r">(<ref loc="MRK 10:46-52">मार्क १०:४६-५२</ref>; <ref loc="LUK 18:35-43">लूक १८:३५-४३</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 20:29" />मंग त्या यरीहो शहरतीन जाई राहींतात तवय लोकसनी मोठी गर्दी त्यासना मांगे चाली राहींती. <verse eid="MAT 20:29" /><verse number="30" style="v" sid="MAT 20:30" />तवय दखा, वाटवर बशेल दोन आंधयासनी येशु जवळतीन जाई राहीना, हाई ऐकीन, त्या वरडीसन बोलणात, “प्रभु, अहो दावीदना पोऱ्या, आमनावर दया करा.” <verse eid="MAT 20:30" /><verse number="31" style="v" sid="MAT 20:31" />तवय त्यासले लोकसनी वरडू नका अस धमकाडं, पण त्या जास्तच वरडीन बोलु लागणात, “प्रभु, अहो दावीदना पोऱ्या! आमनावर दया करा.” <verse eid="MAT 20:31" /><verse number="32" style="v" sid="MAT 20:32" />येशुनी ऊभं राहीसन त्यासले बलाईन सांगं, “मी तुमनाकरता काय करू अशी तुमनी ईच्छा शे?” <verse eid="MAT 20:32" /><verse number="33" style="v" sid="MAT 20:33" />त्या बोलणात, “प्रभुजी, आमनी ईच्छा शे की, आमना डोया उघडी जावोत.” <verse eid="MAT 20:33" /><verse number="34" style="v" sid="MAT 20:34" />तवय येशुले त्यासनी किव वनी त्यानी त्यासना डोयाले स्पर्श करा; तवय त्यासले लगेच दखावु लागनं, अनी त्या त्याना मांगे चालु लागणात.<verse eid="MAT 20:34" /></para>
  <chapter eid="MAT 20" />
  <chapter number="21" style="c" sid="MAT 21" />
  <para style="s">यरूशलेममा येशुना जयोत्सवमा प्रवेश</para>
  <para style="r">(<ref loc="MRK 11:1-11">मार्क ११:१-११</ref>; <ref loc="LUK 19:28-40">लूक १९:२८-४०</ref>; <ref loc="JHN 12:12-19">योहान १२:१२-१९</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 21:1" />त्या यरूशलेमले ई राहींतात तवय जैतुनना डोंगरजोडे बेथफगे गावले पोहचनात; तवय येशुनी दोन शिष्यसले अस सांगीन धाडं की, <verse eid="MAT 21:1" /><verse number="2" style="v" sid="MAT 21:2" />तुम्हीन समोरना गावमा जा, अनी तठे जाताच एक बांधेल गधडी अनं तिनाजोडे एक शिंगरू तुमले दखाई; त्यासले सोडीसन मनाकडे आणा; <verse eid="MAT 21:2" /><verse number="3" style="v" sid="MAT 21:3" />अनी जर कोणी तुमले काही ईचारं, तर प्रभुले यानी गरज शे, अस सांगा म्हणजे त्या तुमले ते आणु देतीन. <verse eid="MAT 21:3" /><verse number="4" style="v" sid="MAT 21:4" />संदेष्टासद्वारे जी भविष्यवाणी व्हयेल व्हती ती पुरी व्हवाकरता हाई व्हयनं; ते अस की, <verse eid="MAT 21:4" /><verse number="5" style="v" sid="MAT 21:5" /><note caller="+" style="x"><char style="xo" closed="false">२१:५ </char><char style="xt" closed="false"><ref loc="ZEC 9:9">जखर्या ९:९</ref></char></note>सियोनना कन्याले सांगा, दखा, तुना राजा तुनाकडे ई राहीना; तो नम्र शे म्हणीन तो गधडावर, म्हणजे शिंगरूवर बशेल शे.<verse eid="MAT 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 21:6" />तवय शिष्यसनी येशुना आज्ञाप्रमाणे करं; <verse eid="MAT 21:6" /><verse number="7" style="v" sid="MAT 21:7" />गधडी अनं शिंगरू यासले आणीन त्यासवर आपला कपडा टाकात अनं तो त्यावर बसना. <verse eid="MAT 21:7" /><verse number="8" style="v" sid="MAT 21:8" />मंग लोकसनी गर्दीमातीन बराच लोकसनी त्यासना कपडा वाटवर पसारात; बाकीनासनी झाडसन्या बारीक फांद्या तोडीन वाटवर पसाऱ्यात; <verse eid="MAT 21:8" /><verse number="9" style="v" sid="MAT 21:9" />अनी त्यानापुढे अनं मांगे चालणारा लोके गजर करीसन बोलणात, दावीदना पोऱ्याले होसान्ना<note caller="+" style="f"><char style="fr" closed="false">२१:९ </char><char style="fq" closed="false">होसान्ना </char><char style="ft" closed="false">देवनी स्तुती व्हवो, आमनं तारण कर.</char></note>; प्रभुना नामतीन येणारा धन्यवादित असो स्वर्गलोकी “होसान्ना.” <verse eid="MAT 21:9" /><verse number="10" style="v" sid="MAT 21:10" />तो यरूशलेममा येवावर पुरा शहरमा च्यावच्याव व्हईनी अनी त्या बोलणात हाऊ कोण? <verse eid="MAT 21:10" /><verse number="11" style="v" sid="MAT 21:11" />लोकसनी गर्दी बोलणी, गालील प्रांतना नासरेथ गावतीन येल, हाऊ “येशु” संदेष्टा शे.<verse eid="MAT 21:11" /></para>
  <para style="s">येशु मंदिरनं शुध्दीकरण करस</para>
  <para style="r">(<ref loc="MRK 11:15-19">मार्क ११:१५-१९</ref>; <ref loc="LUK 19:45-48">लूक १९:४५-४८</ref>; <ref loc="JHN 2:13-22">योहान २:१३-२२</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MAT 21:12" />नंतर येशु मंदिरमा गया; मंदिरमा ज्या खरेदी-विक्री करी राहींतात त्या सर्वासले त्यानी बाहेर हाकली दिधं. सोनारसना चौरंग अनी कबुतर ईकनारासना बैठकी त्यानी पालथ्या कऱ्यात. <verse eid="MAT 21:12" /><verse number="13" style="v" sid="MAT 21:13" /><note caller="+" style="x"><char style="xo" closed="false">२१:१३ </char><char style="xt" closed="false"><ref loc="ISA 56:7">यशया ५६:७</ref>; <ref loc="JER 7:11">यिर्मया ७:११</ref></char></note>अनी त्यासले सांगं, “मना घरले प्रार्थना मंदिर म्हणतीन,” अस शास्त्रमा लिखेल शे; पण तुम्हीन त्याले “लुटारूसनी गुहा” करी राहीनात. <verse eid="MAT 21:13" /><verse number="14" style="v" sid="MAT 21:14" />मंग आंधया अनी लंगडा मंदिरमा त्यानाकडे वनात, त्यानी त्यासले बरं करं. <verse eid="MAT 21:14" /><verse number="15" style="v" sid="MAT 21:15" />तवय त्यानी करेल चमत्कार अनी दावीदना पोऱ्याले “होसान्ना” असा मंदिरमा गजर करनारा धाकला पोऱ्यासले दखीन मुख्य याजक अनं शास्त्री संतापनात, <verse eid="MAT 21:15" /><verse number="16" style="v" sid="MAT 21:16" />अनं त्याले बोलणात, ह्या काय म्हणी राहिनात हाई तुम्हीन ऐकं का? येशुनी त्यासले सांगं, हो; “धाकला अनं दुधपेता लेकरंसना तोंडघाई तु स्तुती करी लेयल शे; हाई तुम्हीन शास्त्रमा वाचं नही का?” <verse eid="MAT 21:16" /><verse number="17" style="v" sid="MAT 21:17" />नंतर तो त्यासले सोडीन शहरना बाहेर बेथानीले गया, अनं तठेच रातले मुक्काम राहिना.<verse eid="MAT 21:17" /></para>
  <para style="s">निष्फळ अंजिरनं झाड</para>
  <para style="r">(<ref loc="MRK 11:12-14">मार्क ११:१२-१४</ref>,<ref loc="MRK 11:20-24">२०-२४</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 21:18" />मंग सकायमा येशु परत नगरमा ई राहिंता तवय येशुले भूक लागणी. <verse eid="MAT 21:18" /><verse number="19" style="v" sid="MAT 21:19" />अनी वाटवर एक अंजिरनं झाड दखीसन तो त्यानाकडे गया; पण पानटासशिवाय त्यानावर त्याले काहीच भेटनं नही; मंग तो झाडले बोलना, यानापुढे तुले कधी फळ न येवो; अनी ते अंजिरनं झाड लगेच वाळी गयं. <verse eid="MAT 21:19" /><verse number="20" style="v" sid="MAT 21:20" />हाई दखीन शिष्यसले आश्चर्य वाटनं, अनं त्या बोलणात, अंजिरनं झाड लगेच कश काय वाळी गयं? <verse eid="MAT 21:20" /><verse number="21" style="v" sid="MAT 21:21" /><note caller="+" style="x"><char style="xo" closed="false">२१:२१ </char><char style="xt" closed="false"><ref loc="MAT 17:20">मत्तय १७:२०</ref>; <ref loc="1CO 13:2">१ करिंथ १३:२</ref></char></note>येशुनी त्यासले उत्तर दिधं, मी तुमले सत्य सांगस, जर तुमनामा ईश्वास व्हई अनं मनमा तुम्हीन शंका धरी नही, तर अंजिरना झाडले जस करं, तसं तुम्हीन करशात, इतलंच नही, तर हाऊ डोंगरले तु उपटीसन समुद्रमा टाकाई जा, अस जर म्हणशात तर ते व्हई जाई. <verse eid="MAT 21:21" /><verse number="22" style="v" sid="MAT 21:22" />तुम्हीन प्रार्थनामा जे काही ईश्वास धरीन मांगशात ते सर्व तुमले भेटी.<verse eid="MAT 21:22" /></para>
  <para style="s">येशुना अधिकारबद्दल प्रश्न</para>
  <para style="r">(<ref loc="MRK 11:27-33">मार्क ११:२७-३३</ref>; <ref loc="LUK 20:1-8">लूक २०:१-८</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 21:23" />मंग तो मंदिरमा परत जाईसन शिकाडी राहिंता तवय मुख्य याजक अनी वडील लोके त्यानाजोडे ईसन बोलणात, तुम्हीन हाई कोणता अधिकारतीन करतस अनी तुमले हाऊ अधिकार कोणी दिधा? <verse eid="MAT 21:23" /><verse number="24" style="v" sid="MAT 21:24" />येशुनी त्यासले उत्तर दिधं, मी बी तुमले एक गोष्ट ईचारस, ती माले सांगशात तर कोणता अधिकारतीन मी हाई करस ते मी तुमले सांगसु. <verse eid="MAT 21:24" /><verse number="25" style="v" sid="MAT 21:25" />योहानना बाप्तिस्मा कोठेन व्हईना? स्वर्गकडतीन की माणुसकडतीन? तवय त्या आपसमा ईचार करू लागणात की, स्वर्गकडतीन अस म्हणं, तर हाऊ आपले म्हणी मंग तुम्हीन त्यानावर ईश्वास का ठेवतस नही? <verse eid="MAT 21:25" /><verse number="26" style="v" sid="MAT 21:26" />अनी जर माणुसकडतीन म्हणं तर आपले लोकसनी भिती वाटस कारण सर्वा लोके योहानले संदेष्टा मानतस. <verse eid="MAT 21:26" /><verse number="27" style="v" sid="MAT 21:27" />मंग त्यासनी येशुले उत्तर दिधं, आमले माहित नही, तो त्यासले बोलना, तर कोणता अधिकारतीन मी हाई करस, हाई पण मी तुमले सांगत नही.<verse eid="MAT 21:27" /></para>
  <para style="s">दोन पोऱ्यासना दृष्टांत</para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 21:28" />बरं तुमले काय वाटस ते सांगा? एक माणुसले दोन पोऱ्या व्हतात; तो पहिलाकडे जाईन बोलना, बेटा, आज द्राक्षमयामा जाईन काम कर; <verse eid="MAT 21:28" /><verse number="29" style="v" sid="MAT 21:29" />त्यानी उत्तर दिधं, मी नही जात; तरी त्याले थोडा येळमा पस्तावा वना अनी तो गया. <verse eid="MAT 21:29" /><verse number="30" style="v" sid="MAT 21:30" />मंग दुसराकडे जाईन त्यानी तसच सांगं; त्यानी उत्तर दिधं, हा मी जास; पण तो गया नही. <verse eid="MAT 21:30" /><verse number="31" style="v" sid="MAT 21:31" />ह्या दोन्हीसपैकी कोणी बापना ईच्छाप्रमाणे करा? त्या बोलणात, पहिलानी, येशुनी त्यासले सांगं, मी तुमले सत्य सांगस की, जकातदार अनं वेश्या तुमनापुढे देवना राज्यमा जातस. <verse eid="MAT 21:31" /><verse number="32" style="v" sid="MAT 21:32" /><note caller="+" style="x"><char style="xo" closed="false">२१:३२ </char><char style="xt" closed="false"><ref loc="LUK 3:12">लूक ३:१२</ref>; <ref loc="LUK 7:29">७:२९</ref>,<ref loc="LUK 7:30">३०</ref></char></note>कारण योहाननी तुमले देवराज्यना मार्ग दखाडा अनं तुम्हीन त्याना ईश्वास करा नही; पण जकातदार अनं वेश्या यासनी त्यानावर ईश्वास करा; हाई दखीसन सुध्दा तुम्हीन त्याना ईश्वास करा नही अनी पश्चाताप बी करा नही.<verse eid="MAT 21:32" /></para>
  <para style="s">द्राक्षमयाना दृष्टांत</para>
  <para style="r">(<ref loc="MRK 12:1-12">मार्क १२:१-१२</ref>; <ref loc="LUK 20:9-19">लूक २०:९-१९</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 21:33" />आखो एक दृष्टांत ऐकी ल्या, एक माणुस व्हता, त्यानी द्राक्षमया बनाडा, त्याना आजुबाजू वडांग करी, त्यामा द्राक्षरसकरता कुंडी बनाडी अनं माळा बांधा अनी दुसरा शेतकरीले बटाईवर सोपीन परदेशले निंघी गया. <verse eid="MAT 21:33" /><verse number="34" style="v" sid="MAT 21:34" />नंतर फळसना हंगाम वना तवय त्यानी आपला उत्पन्नना वाटा लेवाकरता आपला दाससले त्या शेतकरीकडे धाडं. <verse eid="MAT 21:34" /><verse number="35" style="v" sid="MAT 21:35" />तवय शेतकरीनी त्याना काही दाससले धरीन मारं, काही जणसले दगडमार करा अनं काही जणसले मारी टाका. <verse eid="MAT 21:35" /><verse number="36" style="v" sid="MAT 21:36" />परत त्यानी पहिलापेक्षा जास्त दाससले धाडं; त्यासनासंगे बी त्यासनी तसच करं. <verse eid="MAT 21:36" /><verse number="37" style="v" sid="MAT 21:37" />शेवट त्या आपला पोऱ्याना तरी मान ठेवतीन म्हणीन त्यानी स्वतःना पोऱ्याले त्यासनाकडे धाडं; <verse eid="MAT 21:37" /><verse number="38" style="v" sid="MAT 21:38" />पण त्या शेतकरीसनी त्याले दखं अनं त्या एकमेकसले बोलणात, हाऊ वारीस शे; चला आपण याले मारी टाकुत म्हणजे मळाना मालक आपण व्हसुत. <verse eid="MAT 21:38" /><verse number="39" style="v" sid="MAT 21:39" />तवय त्यासनी त्याले धरीन द्राक्षमयाना बाहेर काढीन मारी टाकं. <verse eid="MAT 21:39" /><verse number="40" style="v" sid="MAT 21:40" />येशुनी त्यासले ईचारं, तर मंग द्राक्षमयाना मालक ई तवय तो त्या शेतकरीसनं काय करी? <verse eid="MAT 21:40" /><verse number="41" style="v" sid="MAT 21:41" />त्या त्याले बोलणात, तो त्या दुष्टसना हालहाल करीसन त्यासना नाश करी अनी ज्या शेतकरी हंगाममा त्याले ईमानदारीमा उत्पन्न देतीन असासले तो द्राक्षमया सोपी दि. <verse eid="MAT 21:41" /><verse number="42" style="v" sid="MAT 21:42" />येशु त्यासले बोलणा, ज्या दगडले बांधणारासनी नापसंत करा तोच कोणशीला व्हयना; हाई प्रभुकडतीन व्हयनं, अनं हाई आमना दृष्टीमा आश्चर्यकारक कृत्य शे; अस पवित्र शास्त्रमा तुमना वाचामा वनं नही का? <verse eid="MAT 21:42" /><verse number="43" style="v" sid="MAT 21:43" />यामुये मी तुमले सत्य सांगस की, देवनं राज्य तुमनापाईन हिसकाई लेतीन; अनं जी प्रजा त्यानं फळ दि, त्याच प्रजाले देवनं राज्य भेटी. <verse eid="MAT 21:43" /><verse number="44" style="v" sid="MAT 21:44" />जो ह्या दगडवर पडी त्याना चुराडा व्हई, पण ज्यानावर हाऊ दगड पडी त्याना भुगा-भूगा करी टाकी.<note caller="+" style="f"><char style="fr" closed="false">२१:४४ </char><char style="fq" closed="false">जो ह्या दगडवर पडी त्याना चुराडा व्हई, पण ज्यानावर हाऊ दगड पडी त्याना भुगा-भूगा करी टाकी. </char><char style="ft" closed="false">हाई वचन जुना शास्त्रसमा वाचाले मिळस नही.</char></note> <verse eid="MAT 21:44" /><verse number="45" style="v" sid="MAT 21:45" />येशु हाऊ दृष्टांत आपले लाईनं बोलना हाई मुख्य याजक अनं परूशीसना ध्यानमा वनं. <verse eid="MAT 21:45" /><verse number="46" style="v" sid="MAT 21:46" />त्या त्याले धराले दखी राहींतात पण लोकसनी गर्दीनी त्यासले भिती वाटणी; कारण त्या त्याले संदेष्टा मानेत. <figure style="fig" alt="Watchtower in a vineyard" file="hk00105c.tif" size="col" copy="Horace Knowles ©" ref="२१:३३">द्राक्षमयामाधला माळा</figure><verse eid="MAT 21:46" /></para>
  <chapter eid="MAT 21" />
  <chapter number="22" style="c" sid="MAT 22" />
  <para style="s">लगीनना जेवणना दृष्टांत</para>
  <para style="r">(<ref loc="LUK 14:15-24">लूक १४:१५-२४</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 22:1" />येशु परत त्यासले दृष्टांत दिसन बोलना; <verse eid="MAT 22:1" /><verse number="2" style="v" sid="MAT 22:2" />स्वर्गनं राज्य एक राजाना मायक शे, त्यानी त्याना पोऱ्याना लगीननं जेवण दिधं; <verse eid="MAT 22:2" /><verse number="3" style="v" sid="MAT 22:3" />अनी लगीनना जेवणकरता ज्यासले निवतं देयल व्हतं त्यासले बलावाकरता त्यानी त्याना सेवकसले धाडं, पण त्या ई नही राहींतात. <verse eid="MAT 22:3" /><verse number="4" style="v" sid="MAT 22:4" />परत त्यानी दुसरा सेवकसले धाडीन सांगं, की, निमंत्रीत लोकसले सांगा, दखा, मी जेवण तयार करेल शे, मना बोकड्या अनं कोंबड्या कापाई जायेल शेतस, सर्व तयार शे, लगीनना जेवणले चला. <verse eid="MAT 22:4" /><verse number="5" style="v" sid="MAT 22:5" />तरी हाई त्यासनी मनवर नही लिधं अनी त्या काहीजण वावरमा, काहीजण व्यापारले निंघी गयात. <verse eid="MAT 22:5" /><verse number="6" style="v" sid="MAT 22:6" />बाकीना निवतं मिळेल लोकसनी राजाना दाससले धरीन, त्यासना छळ करीसन मारी टाकात. <verse eid="MAT 22:6" /><verse number="7" style="v" sid="MAT 22:7" />तवय राजाले राग वना; अनी त्यानी आपला सैन्यले धाडीसन त्या घातकीसना नाश करा अनी त्यासना शहर जाळी टाकं. <verse eid="MAT 22:7" /><verse number="8" style="v" sid="MAT 22:8" />मंग तो आपला दाससले बोलना, लगीननी तयारी व्हई जायेल शे, हाई खरं, पण आमंत्रित योग्य नव्हतात. <verse eid="MAT 22:8" /><verse number="9" style="v" sid="MAT 22:9" />म्हणीन तुम्हीन बाहेर रस्तासवर जा अनी जितला तुमले दखायतीन तितलासले लगीनना जेवणकरता बलाई आणा. <verse eid="MAT 22:9" /><verse number="10" style="v" sid="MAT 22:10" />मंग त्या दाससनी रस्तावर जाईन ज्या बी त्यासले बरा वाईट भेटणात, त्या सर्वासले एकत्र करा अनी जेवाकरता येल आमंत्रितसघाई लगीनघर भरी गयं. <verse eid="MAT 22:10" /><verse number="11" style="v" sid="MAT 22:11" />राजा जेवणारासले दखाले वना, तवय तठे लगीनना कपडा घालीन येल नही असा एक माणुस त्याले दखायना. <verse eid="MAT 22:11" /><verse number="12" style="v" sid="MAT 22:12" />तवय तो त्याले बोलना, दोस्त, तु लगीनना कपडा न घालता आठे कशा काय वना? त्यानी काहीच उत्तर दिधं नही. <verse eid="MAT 22:12" /><verse number="13" style="v" sid="MAT 22:13" /><note caller="+" style="x"><char style="xo" closed="false">२२:१३ </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्तय ८:१२</ref>; <ref loc="MAT 25:30">२५:३०</ref>; <ref loc="LUK 13:28">लूक १३:२८</ref></char></note>मंग राजानी सेवकसले सांगं, याना हात पाय बांधीन याले अंधारमा टाका, तठे रडणं अनी दातखाणं चालस. <verse eid="MAT 22:13" /><verse number="14" style="v" sid="MAT 22:14" />बलायेल बराच शेतस, पण निवडेल थोडाच शेतस.<verse eid="MAT 22:14" /></para>
  <para style="s">कैसर राजाले कर देवाबद्दल प्रश्न</para>
  <para style="r">(<ref loc="MRK 12:13-17">मार्क १२:१३-१७</ref>; <ref loc="LUK 20:20-26">लूक २०:२०-२६</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 22:15" />मंग परूशीसनी जाईन आपसमा चर्चा करी की, येशुले त्यानाच बोलानामा कश फसाडानं <verse eid="MAT 22:15" /><verse number="16" style="v" sid="MAT 22:16" />याकरता त्यासनी आपला शिष्यसले हेरोदी पक्षना लोकससंगे त्यानाकडे धाडीन सांगं, गुरजी, आमले माहित शे की, तुम्हीन खरा शेतस, देवना मार्ग खरापणतीन सांगतस, तुम्हीन मनुष्यसनं मत अनी ईच्छासघाई प्रभावित होतस नही, कारण तुम्हीन लोकसनं तोंड दखीन बोलतस नही. <verse eid="MAT 22:16" /><verse number="17" style="v" sid="MAT 22:17" />तुमले काय वाटस हाई आमले सांगा, कैसरले कर देवाणा हाई योग्य शे की नही? <verse eid="MAT 22:17" /><verse number="18" style="v" sid="MAT 22:18" />येशु त्यासना मनमाधलं कपट वळखीन बोलना, अरे ढोंगीसवन का बर मनी परिक्षा दखतस? <verse eid="MAT 22:18" /><verse number="19" style="v" sid="MAT 22:19" />कर देतस ते नाणं दखाडा; तवय त्यासनी त्यानाजोडे एक नाणं अनी दिधं. <verse eid="MAT 22:19" /><verse number="20" style="v" sid="MAT 22:20" />त्यानी त्यासले ईचारं, यावर कोणं चित्र अनं लेख शे? <verse eid="MAT 22:20" /><verse number="21" style="v" sid="MAT 22:21" />त्या बोलनात, रोमना राजानं; येशुनी त्यासले सांगं, तर मंग राजानं शे, ते राजाले अनी देवना शे, ते देवले भरी द्या. <verse eid="MAT 22:21" /><verse number="22" style="v" sid="MAT 22:22" />हाई ऐकीन त्यासले आश्चर्य वाटणं अनी त्या त्याले सोडीन गयात.<verse eid="MAT 22:22" /></para>
  <para style="s">पुनरूत्थानना प्रश्न</para>
  <para style="r">(<ref loc="MRK 12:18-27">मार्क १२:१८-२७</ref>; <ref loc="LUK 20:27-40">लूक २०:२७-४०</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 22:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२२:२३ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">प्रेषित २३:८</ref>
      </char>
    </note>त्याच दिनले, पुनरूत्थान व्हस नही, असा म्हणनारा सदुकी पंथना लोकसनी त्यानाकडे ईसन ईचारं, <verse eid="MAT 22:23" /><verse number="24" style="v" sid="MAT 22:24" />गुरजी, मोशेनी सांगेल शे की, जर एखादा माणुस लेकरं-बाळ न व्हताच मरी गया तर त्याना भाऊनी त्याना बायकोसंगे लगीन करीसन आपला भाऊना वंश चालावाना; <verse eid="MAT 22:24" /><verse number="25" style="v" sid="MAT 22:25" />आमनामा सात भाऊ व्हतात; त्यामधला पहिला लगीन करीसन मरी गया अनी त्याले लेकरं नव्हतात म्हणीन त्यानी बायकोसंगे त्याना भाऊनी लगीन करं <verse eid="MAT 22:25" /><verse number="26" style="v" sid="MAT 22:26" />तसाच दुसरा, तिसरा, असा सातही जण तिनासंगे लगीन करीसन मरी गयात; <verse eid="MAT 22:26" /><verse number="27" style="v" sid="MAT 22:27" />अनी सर्वासनंतर ती बाई पण मरी गयी. <verse eid="MAT 22:27" /><verse number="28" style="v" sid="MAT 22:28" />मंग जवय पुनरूत्थान व्हई तवय ती त्या सात जणसपैकी कोणी बायको व्हई? कारण ती त्या सर्वासनी बायको व्हयेल व्हती. <verse eid="MAT 22:28" /><verse number="29" style="v" sid="MAT 22:29" />येशुनी त्यासले उत्तर दिधं; तुम्हीन शास्त्र अनी देवना सामर्थ्यले समजनात नही म्हणीन तुम्हीन भ्रममा पडेल शेतस. <verse eid="MAT 22:29" /><verse number="30" style="v" sid="MAT 22:30" />कारण पुनरूत्थान व्हवानंतर त्या लोके लगीन करतस नही अनं करी बी देतस नही, तर त्या स्वर्गमधला देवदूतसना मायक राहतस. <verse eid="MAT 22:30" /><verse number="31" style="v" sid="MAT 22:31" />मरेलसना पुनरूत्थानबद्दल देवनी तुमले सांगं, ते तुमना वाचामा वना नही का? <verse eid="MAT 22:31" /><verse number="32" style="v" sid="MAT 22:32" /><note caller="+" style="x"><char style="xo" closed="false">२२:३२ </char><char style="xt" closed="false"><ref loc="EXO 3:6">निर्गम ३:६</ref>,<ref loc="EXO 3:15-16">१५-१६</ref></char></note>ते अस की, “मी अब्राहामना देव, इसहाकना देव अनं याकोबना देव शे.” देव मरेलसना नही तर जिवतसना देव शे. <verse eid="MAT 22:32" /><verse number="33" style="v" sid="MAT 22:33" />हाई ऐकीन लोकसनी गर्दीले त्याना शिक्षणनं आश्चर्य वाटणं.<verse eid="MAT 22:33" /></para>
  <para style="s">सर्वात मोठी आज्ञाना प्रश्न</para>
  <para style="r">(<ref loc="MRK 12:28-34">मार्क १२:२८-३४</ref>; <ref loc="LUK 10:25-28">लूक १०:२५-२८</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 22:34" />त्यानी सदुकी लोकसनं तोंड बंद करी टाकं हाई ऐकीन परूशी लोके जमनात; <verse eid="MAT 22:34" /><verse number="35" style="v" sid="MAT 22:35" />अनी त्यामातीन शास्त्रीसनी त्यानी परिक्षा दखाकरता एक प्रश्न ईचारा; <verse eid="MAT 22:35" /><verse number="36" style="v" sid="MAT 22:36" />गुरजी, नियमशास्त्रमा सर्वसमा मोठी आज्ञा कोणती शे? <verse eid="MAT 22:36" /><verse number="37" style="v" sid="MAT 22:37" />येशु त्याले बोलना, तु आपला देव परमेश्वर यानावर पुर्ण हृदयतीन, पुर्ण जिवतीन अनं पुर्ण मनतीन प्रिती कर. <verse eid="MAT 22:37" /><verse number="38" style="v" sid="MAT 22:38" />हाईच पहिली अनं मोठी आज्ञा शे. <verse eid="MAT 22:38" /><verse number="39" style="v" sid="MAT 22:39" />ईनामायकच आखो एक दुसरी आज्ञा अशी शे की, तु स्वतःवर करस तशी आपला शेजारीसवर प्रिती कर. <verse eid="MAT 22:39" /><verse number="40" style="v" sid="MAT 22:40" /><note caller="+" style="x"><char style="xo" closed="false">२२:४० </char><char style="xt" closed="false"><ref loc="LUK 10:25-28">लूक १०:२५-२८</ref></char></note>ह्या दोन आज्ञासवरच सर्व नियमशास्त्र अनी संदेष्टासनं शास्त्र ह्या अवलंबीन शेतस.<verse eid="MAT 22:40" /></para>
  <para style="s">ख्रिस्त कोणा पोऱ्या शे?</para>
  <para style="r">(<ref loc="MRK 12:35-37">मार्क १२:३५-३७</ref>; <ref loc="LUK 20:41-44">लूक २०:४१-४४</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 22:41" />परूशी लोके एकत्र जमनात तवय येशुनी त्यासले ईचारं; <verse eid="MAT 22:41" /><verse number="42" style="v" sid="MAT 22:42" />ख्रिस्तबद्दल तुमले काय वाटस? तो कोणा पोऱ्या शे? त्यासनी त्याले उत्तर दिधं, दावीदना पोऱ्या शे. <verse eid="MAT 22:42" /><verse number="43" style="v" sid="MAT 22:43" />येशुनी त्यासले सांगं, तर मंग दावीदनी पवित्र आत्माना प्रेरणातीन त्याले “प्रभु” अस कसं म्हणं? तो म्हणस, <verse eid="MAT 22:43" /><verse number="44" style="v" sid="MAT 22:44" /><note caller="+" style="x"><char style="xo" closed="false">२२:४४ </char><char style="xt" closed="false"><ref loc="PSA 110:1">स्तोत्रसंहिता ११०:१</ref></char></note>परमेश्वरनी मना प्रभुले सांगं, मी तुना शत्रुले तुना पायसनं आसन करस तोपावत तु मना उजवीकडे बस. <verse eid="MAT 22:44" /><verse number="45" style="v" sid="MAT 22:45" />दावीद जर त्याले प्रभु म्हणस तर तो दावीदना पोऱ्या कशा काय व्हई? <verse eid="MAT 22:45" /><verse number="46" style="v" sid="MAT 22:46" />तवय कोणलेच त्याले उत्तर देता वनं नही; अनी त्या दिनपाईन त्याले आखो काही ईचारानी कोणीच हिम्मत व्हईनी नही.<verse eid="MAT 22:46" /></para>
  <chapter eid="MAT 22" />
  <chapter number="23" style="c" sid="MAT 23" />
  <para style="s">येशु शास्त्री अनं परूशीसना जाहीरपणे निषेध करस</para>
  <para style="r">(<ref loc="MRK 12:38">मार्क १२:३८</ref>,<ref loc="MRK 12:39">३९</ref>; <ref loc="LUK 11:43">लूक ११:४३</ref>,<ref loc="LUK 11:46">४६</ref>; <ref loc="LUK 20:45">२०:४५</ref>,<ref loc="LUK 20:46">४६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 23:1" />तवय येशु, लोकसनी गर्दीले अनी त्याना शिष्यसले बोलना, <verse eid="MAT 23:1" /><verse number="2" style="v" sid="MAT 23:2" />शास्त्री अनं परूशी या मोशेना आसनवर बठेल शेतस. <verse eid="MAT 23:2" /><verse number="3" style="v" sid="MAT 23:3" />यामुये त्या जे काही तुमले सांगतीन ते पाळा अनं तस वागा, पण त्या जश करतस तस करू नका; कारण त्या जे सांगतस ते करतस नही, <verse eid="MAT 23:3" /><verse number="4" style="v" sid="MAT 23:4" />त्या जड ओझं बांधीन लोकसना खांदावर टाकतस, पण त्या स्वतः त्याले बोट बी लावतस नही; <verse eid="MAT 23:4" /><verse number="5" style="v" sid="MAT 23:5" /><note caller="+" style="x"><char style="xo" closed="false">२३:५ </char><char style="xt" closed="false"><ref loc="MAT 6:1">मत्तय ६:१</ref></char></note>अनी त्या आपला सर्वा कामे लोकसले दखाडाकरता करतस, त्या आपला ताईत मोठा बनाडतस अनं आपला कपडासना किनारले गोंडा लाईन आम्हीन भलता पवित्र शेतस असा दखाडतस. <verse eid="MAT 23:5" /><verse number="6" style="v" sid="MAT 23:6" />पंगतमा मुख्य स्थान अनं सभास्थानमा मुख्य आसन, <verse eid="MAT 23:6" /><verse number="7" style="v" sid="MAT 23:7" />बजारमा लोकसकडतीन आदर करी लेवाणं अनं स्वतःले गुरजी, अस म्हणी लेवाणं हाई त्यासले आवडस <verse eid="MAT 23:7" /><verse number="8" style="v" sid="MAT 23:8" />तुम्हीन स्वतःले लोकसकडतीन गुरजी म्हणी लेवु नका; कारण तुमना गुरू एक शे अनं तुम्हीन सर्व भाऊ-भाऊ शेतस. <verse eid="MAT 23:8" /><verse number="9" style="v" sid="MAT 23:9" />जगमा कोनले बी पिता म्हनान नही, कारण तुमना पिता एकच शे अनं तो स्वर्गामा शे. <verse eid="MAT 23:9" /><verse number="10" style="v" sid="MAT 23:10" />तसच तुम्हीन स्वतःले स्वामी म्हणी लेवु नका कारण तुमना एकच स्वामी शे, तो म्हणजे ख्रिस्त शे. <verse eid="MAT 23:10" /><verse number="11" style="v" sid="MAT 23:11" /><note caller="+" style="x"><char style="xo" closed="false">२३:११ </char><char style="xt" closed="false"><ref loc="MAT 20:26">मत्तय २०:२६</ref>,<ref loc="MAT 20:27">२७</ref>; <ref loc="MRK 9:35">मार्क ९:३५</ref>; <ref loc="MRK 10:43">१०:४३</ref>,<ref loc="MRK 10:44">४४</ref>; <ref loc="LUK 22:26">लूक २२:२६</ref></char></note>तुमनामा जो मोठा शे त्यानी तुमना सेवक व्हवाले पाहिजे. <verse eid="MAT 23:11" /><verse number="12" style="v" sid="MAT 23:12" /><note caller="+" style="x"><char style="xo" closed="false">२३:१२ </char><char style="xt" closed="false"><ref loc="LUK 14:11">लूक १४:११</ref>; <ref loc="LUK 18:14">१८:१४</ref></char></note>जो कोणी स्वतःले मोठा माणुस समजी, त्याले सर्वात खालना माणुस म्हणतीन, अनी जो कोणी स्वतःले लिन नम्र बनाडी त्या माणुसले मोठा म्हणतीन.<verse eid="MAT 23:12" /></para>
  <para style="s">येशु ढोंगीपननी निंदा करस</para>
  <para style="r">(<ref loc="MRK 12:40">मार्क १२:४०</ref>; <ref loc="LUK 11:39-42">लूक ११:३९-४२</ref>,<ref loc="LUK 11:44">४४</ref>,<ref loc="LUK 11:52">५२</ref>; <ref loc="LUK 20:47">२०:४७</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 23:13" />अरे शास्त्री अनं परूशीसवन, अरे ढोंगीसवन, तुमना धिक्कार असो! कारण लोकसनी मझार जावाले नको म्हणीन तुम्हीन स्वर्गना राज्यनं दार बंद करतस; तुम्हीन स्वतःबी मझार जातस नही अनी मझार जाणारासले बी जाऊ देतस नही. <verse eid="MAT 23:13" /><verse number="14" style="v" sid="MAT 23:14" /><note caller="+" style="f"><char style="fr" closed="false">२३:१४ </char><char style="ft" closed="false">हाई वचन काही शास्त्रमा नही मिळस</char></note>अरे शास्त्री अनी परूशीसवन, अरे ढोंगीसवन, तुमना धिक्कार असो! कारण तुम्हीन विधवासना घरसना नुकसान करी टाकतस अनं दिखावाकरता मोठी प्रार्थना करतस, यामुये तुमले सर्वात जास्त भोग भोगना पडी. <verse eid="MAT 23:14" /><verse number="15" style="v" sid="MAT 23:15" />अरे शास्त्रीसवन अनं परूशीसवन, अरे ढोंगीसवन, तुमना धिक्कार असो! कारण तुम्हीन एक शिष्य बनाडाकरता जमीन अनं समुद्र पालथा घालतस अनी तो भेटना तर तुम्हीन त्याले स्वतःपेक्षा दुप्पट नरकना भागीदार बनाडतस. <verse eid="MAT 23:15" /><verse number="16" style="v" sid="MAT 23:16" />अरे वाट दखाडणारा आंधयासवन, तुमना धिक्कार असो! कारण तुम्हीन म्हणतस, कोणी मंदिरनी शप्पथ लिधी तरी काही हरकत नही पण मंदिरमा जे सोनं शे, त्यानी शप्पथ लिधी तर ती मोडता येवाव नही. <verse eid="MAT 23:16" /><verse number="17" style="v" sid="MAT 23:17" />अरे मुर्ख अनं आंधया लोकसवन, मोठं काय शे, ते सोनं की ज्यामुये ते सोनं पवित्र व्हयेल शे ते मंदिर? <verse eid="MAT 23:17" /><verse number="18" style="v" sid="MAT 23:18" />तुम्हीन म्हणतस कोणी वेदीनी <note caller="+" style="f"><char style="fr" closed="false">२३:१८ </char><char style="fq" closed="false">वेदी </char><char style="ft" closed="false">होमकुंड</char></note>शप्पथ लिधी तर काहीच हरकत नही, पण जर कोणी तिनावर अर्पण करतस त्या अर्पणनी शप्पथ लिधी तर ती मोडता येवाव नही. <verse eid="MAT 23:18" /><verse number="19" style="v" sid="MAT 23:19" />अरे आंधयासवन, मोठं काय शे; अर्पण की, अर्पणले पवित्र करस ती वेदी? <verse eid="MAT 23:19" /><verse number="20" style="v" sid="MAT 23:20" />पण जो कोणी वेदीनी शप्पथ लेस तो तिनी अनी तिनावर जे काही ठेयल शे त्यानी शप्पथ लेस; <verse eid="MAT 23:20" /><verse number="21" style="v" sid="MAT 23:21" />अनी जो कोणी मंदिरनी अनं त्यामा राहणारा देवनी शप्पथ लेस; <verse eid="MAT 23:21" /><verse number="22" style="v" sid="MAT 23:22" /><note caller="+" style="x"><char style="xo" closed="false">२३:२२ </char><char style="xt" closed="false"><ref loc="MAT 5:34">मत्तय ५:३४</ref></char></note>अनी जो स्वर्गनी शप्पथ लेस तो देवना सिंहासन नी अनी त्यावर जो बठस त्यानी बी शप्पथ लेस. <verse eid="MAT 23:22" /><verse number="23" style="v" sid="MAT 23:23" />अरे शास्त्री अनं परूशीसवन, अरे ढोंगीसवन, तुमना धिक्कार असो! कारण पुदिना, सौफ अनी जिरा याना दशांश तुम्हीन देतस अनी नियमशास्त्रमाधल्या मुख्य गोष्टी म्हणजे न्याय, दया अनं ईश्वास यासले तुम्हीन धाकल्या गोष्टी समजीन सोडी दिध्यात; ह्या गोष्टी कराले पाहिजे व्हत्यात, तसच आखो महत्वन्या गोष्टी शेतस त्यासले पण तुम्हीन सोडी देऊ नका. <verse eid="MAT 23:23" /><verse number="24" style="v" sid="MAT 23:24" />अरे आंधळी वाट दखाडनारासवन, तुम्हीन मच्छरले निवडीन काढतस अनं उंटले गिळी टाकतस. <verse eid="MAT 23:24" /><verse number="25" style="v" sid="MAT 23:25" />अरे शास्त्री अनं परूशीसवन, अरे ढोंगीसवन तुमना धिक्कार असो! तुम्हीन बी आपली ताटवाटी बाहेरतीन घाशीन पुशीन स्वच्छ करतस पण मझारमा हावरटपणा अनं जुलूम यासनी घाण भरी ठेयल शे. <verse eid="MAT 23:25" /><verse number="26" style="v" sid="MAT 23:26" />अरे आंधळ्या परूशी, पहिले वाटी मझारतीन साफ करा, म्हणजे ती बाहेरतीन साफ व्हई. <verse eid="MAT 23:26" /><verse number="27" style="v" sid="MAT 23:27" /><note caller="+" style="x"><char style="xo" closed="false">२३:२७ </char><char style="xt" closed="false"><ref loc="ACT 23:3">प्रेषित २३:३</ref></char></note>अरे शास्त्रीसवन अनं परूशीसवन, अरे ढोंगीसवन, तुमना धिक्कार असो! कारण तुम्हीन चुना लायेल कबरसनामायक शेतस, त्या बाहेरतीन सुंदर दखातस, पण मझारतीन मरेलसना हाडसनी अनं सर्व प्रकारना घाणनी भरेल शेतस; <verse eid="MAT 23:27" /><verse number="28" style="v" sid="MAT 23:28" />तस तुम्हीन बाहेरतीन लोकसले न्यायी दिसतस, पण मझारतीन ढोंग अनं अधर्मनी भरेल शेतस.<verse eid="MAT 23:28" /></para>
  <para style="s">येशुनाद्वारा त्यासनी शिक्षा</para>
  <para style="r">(<ref loc="LUK 11:47-51">लूक ११:४७-५१</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 23:29" />अरे शास्त्री अनं परूशीसवन, अरे ढोंगीसवन, तुमना धिक्कार असो! कारण तुम्हीन संदेष्टासना कबरी बांधतस अनं साधु संतना कबरसले तुम्हीन सजाडतस. <verse eid="MAT 23:29" /><verse number="30" style="v" sid="MAT 23:30" />अनी म्हणतस आम्हीन आमना वाडवडीलसना काळमा त्यासनासंगे राहतुत तर संदेष्टासनी हत्या करामा आम्हीन त्यासले साथ नही देतुत. <verse eid="MAT 23:30" /><verse number="31" style="v" sid="MAT 23:31" />यावरतीन तुम्हीन स्वतःच सांगतस की, तुम्हीन संदेष्टासनी हत्या करनारासना पोऱ्या शेतस; <verse eid="MAT 23:31" /><verse number="32" style="v" sid="MAT 23:32" />तुम्हीन, तुमना पुर्वजसनी जी वाईट करणी करीसन आर्ध माप भरेल शे, ते तुम्हीन दुष्टाई करीसन पुरं भरी टाका. <verse eid="MAT 23:32" /><verse number="33" style="v" sid="MAT 23:33" /><note caller="+" style="x"><char style="xo" closed="false">२३:३३ </char><char style="xt" closed="false"><ref loc="MAT 3:7">मत्तय ३:७</ref>; <ref loc="MAT 12:34">१२:३४</ref>; <ref loc="LUK 3:7">लूक ३:७</ref></char></note>अरे सापसवन, सापसना पिल्लसवन नरकमा जावानी शिक्षा तुम्हीन कशी चुकाडशात? <verse eid="MAT 23:33" /><verse number="34" style="v" sid="MAT 23:34" />म्हणीन दखा, मी तुमनाकडे संदेष्टासले, ज्ञानी लोकसले अनं शास्त्री यासले धाडसु; तुम्हीन त्यामाधला कित्येक जणसले मारी टाकशात अनं काहीसले क्रुसखांबवर खियासघाई ठोकीन मारशात अनी बाकीनासले तुमना सभास्थानमा फटका मारशात अनं प्रत्येक शहरमा त्यासले त्रास देत फिरशात.<verse eid="MAT 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 23:35" />अनी जितला न्यायी लोकसनं रंगत पृथ्वीवर व्हावाडेल शे ते तुमना माथे पडी, याना अर्थ न्यायी हाबेल पाईन तर बरख्याना पोऱ्या जखऱ्या पावत, ज्यासले तुम्हीन मंदिर अनी वेदीना मझार मारी टाकेल शे. <verse eid="MAT 23:35" /><verse number="36" style="v" sid="MAT 23:36" />मी तुमले सत्य सांगस, की ह्या सर्वा गोष्टी हाई पिढीना माथे पडीतीन.<verse eid="MAT 23:36" /></para>
  <para style="s">यरूशलेम शहरबद्दल येशुनी कळकळ</para>
  <para style="r">(<ref loc="LUK 13:34">लूक १३:३४</ref>,<ref loc="LUK 13:35">३५</ref>)</para>
  <para style="p">
    <verse number="37" style="v" sid="MAT 23:37" />“यरूशलेमा, यरूशलेमा, तु संदेष्टासले मारी टाकस अनी ज्यासले तुनाकडे धाडतस त्यासले तु दगडमार करस, मनी कितलींदाव ईच्छा व्हती की, जशी कोंबडी तिना पिल्लासले आपला पंखखाल गोळा करस तसच मी बी तुना पोऱ्यासले गोळा करसु,” पण तुनी ईच्छा नव्हती! <verse eid="MAT 23:37" /><verse number="38" style="v" sid="MAT 23:38" />म्हणीन आते तुमनं घर ओसाड अवस्थामा तुमलेच सोपी देयल शे. <verse eid="MAT 23:38" /><verse number="39" style="v" sid="MAT 23:39" />मी तुमले सांगस की, आत्तेपाईन “प्रभुना नावतीन येणारा तो आशिर्वादित शे, अस म्हणशात तोपावत मी तुमना नजरमा पडावु नही.”<verse eid="MAT 23:39" /></para>
  <chapter eid="MAT 23" />
  <chapter number="24" style="c" sid="MAT 24" />
  <para style="s">येशु मंदिरना विनाशबद्दल भविष्य करस</para>
  <para style="r">(<ref loc="MRK 13:1">मार्क १३:१</ref>,<ref loc="MRK 13:2">२</ref>; <ref loc="LUK 21:5">लूक २१:५</ref>,<ref loc="LUK 21:6">६</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 24:1" />मंग येशु मंदिरमातीन बाहेर निंघी राहींता तवय त्याना शिष्य त्याले मंदिरनी माडी दखाडासाठे त्यानाजोडे वनात. <verse eid="MAT 24:1" /><verse number="2" style="v" sid="MAT 24:2" />तवय येशु त्यासले बोलना, “हाई सर्व तुम्हीन दखी राहीनात ना. मी तुमले खरं सांगस की; असा आठे दगडवर दगड ऱ्हावाव नही; जो पाडता येवाव नही.”<verse eid="MAT 24:2" /></para>
  <para style="s">दुःख अनी तरास</para>
  <para style="r">(<ref loc="MRK 13:3-13">मार्क १३:३-१३</ref>; <ref loc="LUK 21:1-19">लूक २१:१-१९</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 24:3" />येशु जैतुनना डोंगरवर बशेल व्हता तवय त्याना शिष्यसनी त्यानाकडे ईसन ईचारं, “ह्या गोष्टी कवय व्हतीन अनी तुमनं येवानं अनी ह्या युगना समाप्तीनं चिन्ह काय शे, हाई आमले सांगा.”<verse eid="MAT 24:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MAT 24:4" />येशुनी त्यासले उत्तर दिधं, तुमले कोणी फसाडाले नको म्हणीन जपी ऱ्हा. <verse eid="MAT 24:4" /><verse number="5" style="v" sid="MAT 24:5" />कारण बराच लोके मनं नाव लिसन येतीन अनी मी ख्रिस्त शे अस म्हणतीन अनी बराच जणसले फसाडतीन. <verse eid="MAT 24:5" /><verse number="6" style="v" sid="MAT 24:6" />जवय तुम्हीन लढायासबद्दल ऐकशात अनी लढायासन्या अफवा ऐकशात तवय संभाळा घाबरू नका कारण अस व्हवानं आवश्यकच शे, पण तेवढामा शेवट व्हवाव नही. <verse eid="MAT 24:6" /><verse number="7" style="v" sid="MAT 24:7" />कारण राष्ट्रसवर राष्ट्र अनं राज्यसवर राज्य ऊठतीन अनी जागोजागी दुष्काळ पडी अनं भूकंप व्हतीन. <verse eid="MAT 24:7" /><verse number="8" style="v" sid="MAT 24:8" />पण हाई सर्व म्हणजे दुःखनी सुरवात शे.<verse eid="MAT 24:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 24:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२४:९ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:22">मत्तय १०:२२</ref>
      </char>
    </note>तुमना हाल कराकरता त्या तुमले धरी देतीन अनं तुमले मारी टाकतीन अनी मना नावमुये सर्वा लोके तुमना तिरस्कार करतीन. <verse eid="MAT 24:9" /><verse number="10" style="v" sid="MAT 24:10" />त्या येळले बराचजन अडखळतीन; त्या एकमेकसले धरी देतीन, अनं एकमेकसना व्देष करतीन; <verse eid="MAT 24:10" /><verse number="11" style="v" sid="MAT 24:11" />बराच खोटा संदेष्टा व्हतीन अनी बराच जणसले फसाडतीन. <verse eid="MAT 24:11" /><verse number="12" style="v" sid="MAT 24:12" />अनी अधर्म वाढामुये बराच लोकसनी प्रिती थंडी व्हई जाई. <verse eid="MAT 24:12" /><verse number="13" style="v" sid="MAT 24:13" /><note caller="+" style="x"><char style="xo" closed="false">२४:१३ </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्तय १०:२२</ref></char></note>पण ह्यामा शेवटपावत जो टिकी राही त्यानच तारण व्हई. <verse eid="MAT 24:13" /><verse number="14" style="v" sid="MAT 24:14" />जगमाधला सर्व लोकसकरता साक्ष व्हवाले पाहिजे म्हणीन देवराज्यनी हाई सुवार्ता सर्व जगमा गाजाडतीन; तवय शेवट व्हई.<verse eid="MAT 24:14" /></para>
  <para style="s">महासंकटना काळ</para>
  <para style="r">(<ref loc="MRK 13:14-23">मार्क १३:१४-२३</ref>; <ref loc="LUK 21:21-24">लूक २१:२१-२४</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 24:15" />“दानीएल संदेष्टाद्वारा सांगेल,<note caller="+" style="f"><char style="fr" closed="false">२४:१५ </char><char style="ft" closed="false">वाचनारानी हाई ध्यानमा लेवानं की, ह्याना अर्थ काय शे!</char></note> बठं काही उध्वस्त करणारी अमंगळताले पवित्रस्थानमा उभा राहेल तुम्हीन दखशात.” <verse eid="MAT 24:15" /><verse number="16" style="v" sid="MAT 24:16" />“तवय ज्या यहूदीया प्रांतमा व्हतीन त्यासनी डोंगरकडे पळी जावानं. <verse eid="MAT 24:16" /><verse number="17" style="v" sid="MAT 24:17" /><note caller="+" style="x"><char style="xo" closed="false">२४:१७ </char><char style="xt" closed="false"><ref loc="LUK 17:31">लूक १७:३१</ref></char></note>जो धाबावर व्हई त्यानी आपला घरमातील काही बी बाहेर काढाकरता खाल उतरानं नही. <verse eid="MAT 24:17" /><verse number="18" style="v" sid="MAT 24:18" />अनी जो वावरमा राही त्यानी आपला कपडा लेवाकरता मांगे फिरीन येवानं नही. <verse eid="MAT 24:18" /><verse number="19" style="v" sid="MAT 24:19" />त्या दिनसमा ज्यासले दिन राहतीन अनी ज्या लेकरंसले पाजणाऱ्या राहतीन त्यासना भयंकर हाल व्हतीन! <verse eid="MAT 24:19" /><verse number="20" style="v" sid="MAT 24:20" />तरी हिवाळामा किंवा शब्बाथ दिनले तुमले पळनं पडाव नही म्हणीन प्रार्थना करा! <verse eid="MAT 24:20" /><verse number="21" style="v" sid="MAT 24:21" /><note caller="+" style="x"><char style="xo" closed="false">२४:२१ </char><char style="xt" closed="false"><ref loc="REV 7:14">प्रकटीकरण ७:१४</ref></char></note>कारण जगना उत्पत्तिपाईन ते आजपावत वनं नही अनं येवाव नही, अस मोठं संकट त्या काळमा ई. <verse eid="MAT 24:21" /><verse number="22" style="v" sid="MAT 24:22" />अनी देव त्या दिनसले थोडा नही करता तर; कोणताच माणुसना निभाव लागता नही, पण ज्यासले निवडेल शे त्यासनाकरता त्या दिन थोडा कराई जातीन.”<verse eid="MAT 24:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 24:23" />त्या येळले कोणी तुमले म्हणी, “दखा, ख्रिस्त आठे शे! किंवा तठे शे!” तर खरं मानु नका. <verse eid="MAT 24:23" /><verse number="24" style="v" sid="MAT 24:24" />कारण खोटा ख्रिस्त अनी खोटा संदेष्टा व्हतीन; त्या असा मोठा चिन्ह अनं चमत्कार दखाडतीन की ज्यासले देवनी निवडेल शे त्यासले सुध्दा फसाडतीन. <verse eid="MAT 24:24" /><verse number="25" style="v" sid="MAT 24:25" />दखा! मी हाई पहिलेच तुमले सांगीन ठेयेल शे.<verse eid="MAT 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 24:26" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२४:२६ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:23">लूक १७:२३</ref>,<ref loc="LUK 17:24">२४</ref></char>
    </note>“किंवा, जर कोणी तुमले म्हणी, ‘दखा, तो जंगलमा शे!’ तर तठे जावु नका; अनी कोणी म्हणी, ‘दखा, तो मझारनी खोलीमा शे!’ तर खरं मानु नका. <verse eid="MAT 24:26" /><verse number="27" style="v" sid="MAT 24:27" />कारण जशी ईज पुर्व दिशाकडतीन निंघीन पश्चिम दिशापावत चमकस तसं मनुष्यना पोऱ्यानं येणं व्हई.”<verse eid="MAT 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MAT 24:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२४:२८ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 17:37">लूक १७:३७</ref>
      </char>
    </note>जठे प्रेत शे, तठे गिधाड जमतीन.<verse eid="MAT 24:28" /></para>
  <para style="s">मनुष्यना पोऱ्या येशु यानं परत येणं</para>
  <para style="r">(<ref loc="MRK 13:24-27">मार्क १३:२४-२७</ref>; <ref loc="LUK 21:25-28">लूक २१:२५-२८</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MAT 24:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२४:२९ </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:12">प्रकटीकरण ६:१२</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:13">प्रकटीकरण ६:१३</ref>
      </char>
    </note>“त्या दिनसमाधला संकटना मांगतीन लगेच सुर्य अंधकारमय व्हई, चंद्र प्रकाश देवाव नही, तारा आकाशमातीन नष्ट व्हतीन अनी आकाशमाधली शक्ती हाली जाई. <verse eid="MAT 24:29" /><verse number="30" style="v" sid="MAT 24:30" /><note caller="+" style="x"><char style="xo" closed="false">२४:३० </char><char style="xt" closed="false"><ref loc="REV 1:7">प्रकटीकरण १:७</ref></char></note>तवय मनुष्यना पोऱ्यानं चिन्ह आकाशमा दखाई; अनी पृथ्वीवरला सर्व जातना लोके शोक करतीन त्या मनुष्यना पोऱ्याले आकाशना ढगसवर बशीसन, पराक्रमतीन अनी मोठा वैभवतीन येतांना दखतीन. <verse eid="MAT 24:30" /><verse number="31" style="v" sid="MAT 24:31" />तुतारीसना महानादनासंगे, मी मना दूतसले धाडसु, अनी त्या पृथ्वीना एक टोकपाईन दुसरा टोकपावत मना निवडेल लोकसले चाऱ्ही दिशाकडतीन गोया करसु.”<verse eid="MAT 24:31" /></para>
  <para style="s">अंजिरनं झाडना दृष्टांत</para>
  <para style="r">(<ref loc="MRK 13:28-31">मार्क १३:२८-३१</ref>; <ref loc="LUK 21:29-33">लूक २१:२९-३३</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 24:32" />“आते अंजिरना झाडना दृष्टांत ल्या, त्याले कवळी फांदी ईसन पानटा फुटू लागणात म्हणजे उन्हाळा जोडे येल शे अस तुमले समजस. <verse eid="MAT 24:32" /><verse number="33" style="v" sid="MAT 24:33" />जवय तुम्हीन ह्या सर्व गोष्टी दखशात, तवय मी दारजोडे शे, अस समजा. <verse eid="MAT 24:33" /><verse number="34" style="v" sid="MAT 24:34" />मी तुमले सत्य सांगस, जोपावत हाई सर्व पुरं व्हत नही तोपावत हाई पिढीना अंत व्हवाव नही. <verse eid="MAT 24:34" /><verse number="35" style="v" sid="MAT 24:35" />आकाश अनी पृथ्वी पुसाई जाई, पण मनं वचन पुसावणारच नही.”<verse eid="MAT 24:35" /></para>
  <para style="s">कोणलेच तो दिन अनी येळ माहीत नही</para>
  <para style="r">(<ref loc="MRK 13:32-37">मार्क १३:३२-३७</ref>; <ref loc="LUK 17:26-30">लूक १७:२६-३०</ref>,<ref loc="LUK 17:34-36">३४-३६</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 24:36" />“त्या दिनबद्दल अनी त्या येळबद्दल कोणलेच माहीत नही, स्वर्ग माधला देवदूतसले नही, देवना पोऱ्यालेसुध्दा नही; फक्त देवबापलेच माहीत शे. <verse eid="MAT 24:36" /><verse number="37" style="v" sid="MAT 24:37" />नोहाना दिनसनामायक मनुष्यना पोऱ्यानं येणं व्हई. <verse eid="MAT 24:37" /><verse number="38" style="v" sid="MAT 24:38" />तवय जस जलप्रलय येवाना पहीलेना दिनसमा नोहा जहाजमा जास नही तोपावत लोके खाई पी राहींतात, लगीन करी ली राहींतात, लगीन करी दी राहींतात; <verse eid="MAT 24:38" /><verse number="39" style="v" sid="MAT 24:39" />तवय जलप्रलय ईसन त्यासले वाहीन लई गया तोपावत त्यासले समजनं नही, तसच मनुष्यना पोऱ्यानं येणं व्हई. <verse eid="MAT 24:39" /><verse number="40" style="v" sid="MAT 24:40" />त्या येळले वावरमा काम करनारा दोन जणसमातीन; एक उचलाई जाई अनी एक तठेच ठेवाई जाई. <verse eid="MAT 24:40" /><verse number="41" style="v" sid="MAT 24:41" />जातावर दळनाऱ्या दोन बायासपैकी एक उचलाई जाई अनं एक तठेच ठेवाई जाई. <verse eid="MAT 24:41" /><verse number="42" style="v" sid="MAT 24:42" />यामुये, जागृत ऱ्हा, कारण कोणता दिनले तुमना प्रभु ई हाई तुमले माहीत नही. <verse eid="MAT 24:42" /><verse number="43" style="v" sid="MAT 24:43" /><note caller="+" style="x"><char style="xo" closed="false">२४:४३ </char><char style="xt" closed="false"><ref loc="LUK 12:39">लूक १२:३९</ref>,<ref loc="LUK 12:40">४०</ref></char></note>आखो, हाई समजी ल्या की, कोणता येळले चोर येवाव शे हाई जर घरमालकले माहीत ऱ्हातं, तर तो जागा ऱ्हाता अनी आपलं घर चोरले फोडु नही देता. <verse eid="MAT 24:43" /><verse number="44" style="v" sid="MAT 24:44" />यामुये तुम्हीन तयार ऱ्हा, तुमले वाटाव नही त्या येळले मनुष्यना पोऱ्या ई.”<verse eid="MAT 24:44" /></para>
  <para style="s">ईश्वासु किंवा अईश्वासु दास</para>
  <para style="r">(<ref loc="LUK 12:41-48">लूक १२:४१-४८</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 24:45" />असा ईश्वासु अनं ईचारशील कारभारी कोण शे? ज्याले त्याना मालक आपला सेवकसवर अधिकारी नेमी यानाकरता की, तो त्यासले येळवर जेवण दी. <verse eid="MAT 24:45" /><verse number="46" style="v" sid="MAT 24:46" />मालक ई तवय जो दास तसं करतांना त्याले दखाई, तो दास धन्य! <verse eid="MAT 24:46" /><verse number="47" style="v" sid="MAT 24:47" />मी तुमले सत्य सांगस की, मालक त्या दासले आपली सर्व मालमत्तावर अधिकारी नेमी. <verse eid="MAT 24:47" /><verse number="48" style="v" sid="MAT 24:48" />पण जर तो दुष्ट दास व्हई तर तो आपला मनमा म्हणी, मना मालकले येवाले आखो बराच येळ लागी. <verse eid="MAT 24:48" /><verse number="49" style="v" sid="MAT 24:49" />अनी तो आपला सोबतना दाससले मारू लागना अनं दारूड्याससंगे खाऊ पिऊ लागना, <verse eid="MAT 24:49" /><verse number="50" style="v" sid="MAT 24:50" />तवय दास मालकनी वाट दखत नही त्या दिनले अनी त्याले माहीत नही त्या येळले त्याना मालक ईसन, <verse eid="MAT 24:50" /><verse number="51" style="v" sid="MAT 24:51" />त्या दासले कापी टाकी अनी ढोंगीसनासंगे त्याले टाकी दी. तठे रडनं अनी दात खानं चाली<verse eid="MAT 24:51" /></para>
  <chapter eid="MAT 24" />
  <chapter number="25" style="c" sid="MAT 25" />
  <para style="s">दहा कुवारीसना दृष्टांत</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 25:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२५:१ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:35">लूक १२:३५</ref>
      </char>
    </note>तवय “स्वर्गनं राज्य” त्या दहा कुवारीसनामायक राही, ज्या दिवा लिसन नवरदेवले भेटाले निंघनात. <verse eid="MAT 25:1" /><verse number="2" style="v" sid="MAT 25:2" />त्यामा पाच हुशार अनी पाच मूर्ख व्हत्यात. <verse eid="MAT 25:2" /><verse number="3" style="v" sid="MAT 25:3" />मुर्ख कुवारीसनी दिवा लिधात पण संगे तेल लिधं नही, <verse eid="MAT 25:3" /><verse number="4" style="v" sid="MAT 25:4" />हुशार कुवारीसनी दिवा लिधात अनी संगे भांडामा तेल पण लिधं. <verse eid="MAT 25:4" /><verse number="5" style="v" sid="MAT 25:5" />मंग नवरदेवले येवाले उशीर व्हवामुये सर्वासले डुलक्या वन्यात अनं झोप लागनी.<verse eid="MAT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 25:6" />तवय मध्य रातले आवाज वना की, “दखा नवरदेव वना! चला त्याले भेटाले जाऊ!” <verse eid="MAT 25:6" /><verse number="7" style="v" sid="MAT 25:7" />मंग दहा कुवाऱ्या ऊठन्यात अनी आपला दिवा निट कराले लागण्यात. <verse eid="MAT 25:7" /><verse number="8" style="v" sid="MAT 25:8" />तवय मुर्खसनी हुशारसले सांगं, “आमले बी तुमना तेलमातीन थोडं द्या, कारण आमना दिवा विझी राहिनात.” <verse eid="MAT 25:8" /><verse number="9" style="v" sid="MAT 25:9" />पण हुशार कुवारीसनी उत्तर दिधं, “हाई आमले बी पुराव नही अनी तुमले बी पुराव नही. म्हणीन तुम्हीन दुकानमा जाईसन तुमनाकरता ईकत लई या.” <verse eid="MAT 25:9" /><verse number="10" style="v" sid="MAT 25:10" />मंग त्या तेल ईकत लेवाले गयात इतलामा नवरदेव वना; अनी ज्या पाच तयार व्हत्यात त्या त्यानासंगे लगीनना जेवणकरता मझार निंघी गयात अनी दरवाजा बंद व्हई गया.<verse eid="MAT 25:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 25:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२५:११ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 13:25">लूक १३:२५</ref>
      </char>
    </note>“नंतर त्या बाकीन्या कुवाऱ्या ईसन सांगाले लागण्यात. ‘गुरजी, गुरजी!’ आमनाकरता दार उघडा.” <verse eid="MAT 25:11" /><verse number="12" style="v" sid="MAT 25:12" />नवरदेवनी उत्तर दिधं, मी तुमले सत्य सांगस मी तुमले वळखस नही, <verse eid="MAT 25:12" /><verse number="13" style="v" sid="MAT 25:13" />यामुये, “तुम्हीन जागा ऱ्हा, कारण तुमले माहित नही तो दिन अनं ति येळ कवय ई.”<verse eid="MAT 25:13" /></para>
  <para style="s">रूपयासना दृष्टांत</para>
  <para style="r">(<ref loc="LUK 19:11-27">लूक १९:११-२७</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 25:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२५:१४ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:11-27">लूक १९:११-२७</ref>
      </char>
    </note>“ज्याप्रमाणे प्रवासले जाणारा एक माणुस स्वतःनी संपत्तीनी जबाबदारी आपला सेवकसले बलाईन त्यासले सोपी देस,” त्याप्रमाणे हाई शे. <verse eid="MAT 25:14" /><verse number="15" style="v" sid="MAT 25:15" />एकले त्यानी पाच हजार रूपया, एकले दोन हजार अनं एकले एक हजार अस ज्याना त्याना योग्यतानुसार दिधात; अनी तो प्रवासले निंघी गया. <verse eid="MAT 25:15" /><verse number="16" style="v" sid="MAT 25:16" />ज्याले पाच हजार मिळेल व्हतात त्यानी लगेच जाईन त्याना धंदामा टाकीन अजुन पाच हजार कमाडात. <verse eid="MAT 25:16" /><verse number="17" style="v" sid="MAT 25:17" />याचप्रमाणे ज्याले दोन हजार भेटेल व्हतात, त्यानी बी दोन हजार कमाडात. <verse eid="MAT 25:17" /><verse number="18" style="v" sid="MAT 25:18" />पण ज्याले एक हजार रूपया भेटेल व्हतात, त्यानी जमीन खंदि अनी आपला मालकना पैसा तठे दपाडी दिधात. <figure style="fig" alt="Talents" file="hk00168c.tif" size="col" copy="Horace Knowles ©" ref="२५:१५">पैसा</figure><verse eid="MAT 25:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 25:19" />“मंग बराच दिन नंतर सेवकसना मालक परत वना अनी त्यासना हिशोब लेवाले लागना. <verse eid="MAT 25:19" /><verse number="20" style="v" sid="MAT 25:20" />तवय ज्याले पाच हजार भेटेल व्हतात तो आखो पाच हजार लईन बोलना, मालक, तुम्हीन माले पाच हजार देयल व्हतात, दखा! त्यानावर मी आखो पाच हजार कमाडात. <verse eid="MAT 25:20" /><verse number="21" style="v" sid="MAT 25:21" />त्याना मालक त्याले बोलना, शाब्बास ईश्वासु सेवक! तुले थोडं दिधं त्यानामा तु ईश्वासु राहिना. मी तुले बऱ्याच गोष्टीसनी जबाबदारी दिसु, आपला मालकनी खूशीमा सामील हो! <verse eid="MAT 25:21" /><verse number="22" style="v" sid="MAT 25:22" />मंग ज्याले दोन हजार भेटेल व्हतात तो बी ईसन बोलना, मालक, तुम्हीन माले दोन हजार देयल व्हतात, दखा! त्यानावर मी आखो दोन हजार कमाडात.” <verse eid="MAT 25:22" /><verse number="23" style="v" sid="MAT 25:23" />त्याना मालक त्याले बोलना, शाब्बास, ईश्वासु सेवक! तुले थोडं दिधं त्यानामा तु ईश्वासु राहिना. मी तुले बऱ्याच गोष्टीसनी जबाबदारी दिसु, आपला मालकनी खूशीमा सामील हो! <verse eid="MAT 25:23" /><verse number="24" style="v" sid="MAT 25:24" />मंग ज्याले एक हजार भेटेल व्हतात तो बी ईसन बोलना, मालक, माले माहित व्हतं तुम्हीन कठोर शेतस; जठे तुम्हीन पेरेल नही तठे कापणी करतस; अनी जठे पसारेल नही तठेन गोळा करतस. <verse eid="MAT 25:24" /><verse number="25" style="v" sid="MAT 25:25" />म्हणीन मी भ्याईसन तुमना हजार रूपया जमीनमा दपाडी ठेयेल व्हतात; दखा! त्या तुमना तुमले भेटी गयात. <verse eid="MAT 25:25" /><verse number="26" style="v" sid="MAT 25:26" />त्याना मालक त्याले बोलना, अरे दुष्ट अनं आळशी सेवक, जठे मी पेरेल नही तठे कापणी करस अनं जठे पसारेल नही तठेन गोळा करस, हाई जर तुले माहित व्हतं? <verse eid="MAT 25:26" /><verse number="27" style="v" sid="MAT 25:27" />तर मंग, तु मना पैसा सावकारकडे ठेई देता म्हणजे मी ईसन मना पैसा त्यासनाकडतीन व्याजसहित परत लेतु. <verse eid="MAT 25:27" /><verse number="28" style="v" sid="MAT 25:28" />यामुये याना कडतीन त्या हजार रूपया ल्या, अनी ज्यानाजोडे दहा हजार शेतस त्याले द्या. <verse eid="MAT 25:28" /><verse number="29" style="v" sid="MAT 25:29" /><note caller="+" style="x"><char style="xo" closed="false">२५:२९ </char><char style="xt" closed="false"><ref loc="MAT 13:12">मत्तय १३:१२</ref>; <ref loc="MRK 4:25">मार्क ४:२५</ref>; <ref loc="LUK 8:18">लूक ८:१८</ref></char></note>कारण ज्यानाजोडे शे त्याले देवामा ई अनी त्यानाजोडे भरपुर व्हई जाई; अनी ज्यानाकडे नही शे त्यानाजवळ जे बी व्हई, ते पण काढी लेतीन. <verse eid="MAT 25:29" /><verse number="30" style="v" sid="MAT 25:30" /><note caller="+" style="x"><char style="xo" closed="false">२५:३० </char><char style="xt" closed="false"><ref loc="MAT 8:12">मत्तय ८:१२</ref>; <ref loc="MAT 22:13">२२:१३</ref>; <ref loc="LUK 13:28">लूक १३:२८</ref></char></note>ह्या बिनकामना सेवकले अंधारमा टाका, तठे रडणं अनं दातखाणं चाली.<verse eid="MAT 25:30" /></para>
  <para style="s">न्यायना दिन</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 25:31" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२५:३१ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:27">मत्तय १६:२७</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 19:28">मत्तय १९:२८</ref>
      </char>
    </note>जवय मनुष्यना पोऱ्या आपला वैभवमा सर्वा देवदूतसंगे ई, तवय मी आपला वैभवी राजासनवर बठसु. <verse eid="MAT 25:31" /><verse number="32" style="v" sid="MAT 25:32" />मनापुढे सर्वा राष्ट्रे गोळा व्हतीन अनी जशा मेंढपाय बकरीसमातीन मेंढरसले येगळे करस तस तो त्यासले एकमेकसपाईन येगळे करी. <verse eid="MAT 25:32" /><verse number="33" style="v" sid="MAT 25:33" />तो मेंढरासले आपला उजवी बाजुले अनी बकरीसले डावीबाजुले करी. <verse eid="MAT 25:33" /><verse number="34" style="v" sid="MAT 25:34" />तवय राजा आपला उजवीबाजुनासले सांगी, हे मना बापनी! आशिर्वादित करेल लोकसवन या, जे राज्य सृष्टीना उत्पत्तिपाईन तुमनाकरता तयार करी ठेयल शे त्याना अधिकारी बना. <verse eid="MAT 25:34" /><verse number="35" style="v" sid="MAT 25:35" />कारण माले भूक लागेल व्हती तवय तुम्हीन माले खावाले दिधं, तिश लागेल व्हती तवय पाणी पेवाले दिधं; अनोळखी व्हतु तवय माले घरमा लिधं, <verse eid="MAT 25:35" /><verse number="36" style="v" sid="MAT 25:36" />उघडा व्हतु तवय माले कपडा दिधात; आजारी व्हतु तवय माले दखाले वनात, बंदिगृहमा व्हतु तवय माले भेटाले वनात. <verse eid="MAT 25:36" /><verse number="37" style="v" sid="MAT 25:37" />त्या येळले धार्मीक लोक त्याले उत्तर देतीन की, प्रभुजी, आम्हीन तुमले कवय भूक लागेल दखीन खावाले दिधं? कवय तिश लागेल दखीन पाणी पेवाले दिधं? <verse eid="MAT 25:37" /><verse number="38" style="v" sid="MAT 25:38" />तुमले कवय अनोळखी समजीसन घरमा लिधं? उघडा दखीसन कवय तुमले कपडा दिधात? <verse eid="MAT 25:38" /><verse number="39" style="v" sid="MAT 25:39" />अनी तुम्हीन आजारी शेतस किंवा बंदिगृहमा शेतस हाई दखीन कवय आम्हीन तुमले दखाले वनु? <verse eid="MAT 25:39" /><verse number="40" style="v" sid="MAT 25:40" />तवय राजा त्यासले उत्तर दि, मी तुमले सत्य सांगस की, जवय तुम्हीन मनामांगे येणारासपैकी एकसाठे बी हाई करतस म्हणजे ते मनासाठेच करेल शे!<verse eid="MAT 25:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 25:41" />मंग डावीकडलासले तो सांगी, “अरे शाप लागेलसवन, सैतान अनी त्याना दूतसकरता जो सार्वकालिक अग्नी तयार करी ठेयल शे त्यामा मनासमोरतीन निंघी जा! <verse eid="MAT 25:41" /><verse number="42" style="v" sid="MAT 25:42" />कारण जवय माले भूक लागेल व्हती तवय तुम्हीन माले खावाले दिधं नही, तिश लागेल व्हती तवय तुम्हीन माले पेवाले पाणी दिधं नही; <verse eid="MAT 25:42" /><verse number="43" style="v" sid="MAT 25:43" />अनोळखी व्हतु तवय माले घरमा लिधं नही, उघडा व्हतु तवय माले कपडा दिधात नही; मी आजारी अनं बंदिगृहमा व्हतु तवय तुम्हीन माले भेटाले वनात नही. <verse eid="MAT 25:43" /><verse number="44" style="v" sid="MAT 25:44" />त्या येळले ह्या पण त्याले उत्तर देतीन, प्रभुजी, आम्हीन कवय तुमले भूका, तिशा, अनओळखी, उघडं, आजारी अनी बंदिगृहमा दखीन कवय तुम्हीन सेवा करी नही? <verse eid="MAT 25:44" /><verse number="45" style="v" sid="MAT 25:45" />तवय तो त्यासले उत्तर दि, ‘मी तुमले सत्य सांगस की, तुम्हीन ज्याप्रमाणे ह्या सर्वात धाकलासमातीन एकले बी करात नहीत म्हणजेच माले करात नही.’ <verse eid="MAT 25:45" /><verse number="46" style="v" sid="MAT 25:46" />त्या तर, सार्वकालिक शिक्षा भोगाले जातीन अनी न्यायी लोक सार्वकालिक जिवनमा जातीन.”<verse eid="MAT 25:46" /></para>
  <chapter eid="MAT 25" />
  <chapter number="26" style="c" sid="MAT 26" />
  <para style="s">येशुले माराना कट</para>
  <para style="r">(<ref loc="MRK 14:1">मार्क १४:१</ref>,<ref loc="MRK 14:2">२</ref>; <ref loc="LUK 22:1">लूक २२:१</ref>,<ref loc="LUK 22:2">२</ref>; <ref loc="JHN 11:45-53">योहान ११:४५-५३</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 26:1" />मंग येशुनी ह्या सर्वा गोष्टी शिकाडानं संपाडानंतर आपला शिष्यसले सांगं, <verse eid="MAT 26:1" /><verse number="2" style="v" sid="MAT 26:2" />तुमले माहित शे की, दोन दिन नंतर वल्हांडण सण शे अनी मनुष्यना पोऱ्याले क्रुसखांबवर खियाकरता धरी देतीन.<verse eid="MAT 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 26:3" />तवय कैफा नावना प्रमुख याजकना वाडामा मुख्य याजक अनं वडील लोके गोया व्हयनात, <verse eid="MAT 26:3" /><verse number="4" style="v" sid="MAT 26:4" />अनी येशुले गुपचुप धरीन मारी टाकानी योजना त्यासनी बनाडी. <verse eid="MAT 26:4" /><verse number="5" style="v" sid="MAT 26:5" />“लोकसमा दंगल व्हवाले नको म्हणीन हाई सणना दिनमा नही करानं, अस त्यासनी सांगं.”<verse eid="MAT 26:5" /></para>
  <para style="s">येशुना तेल अभिषेक</para>
  <para style="r">(<ref loc="MRK 14:3-9">मार्क १४:३-९</ref>; <ref loc="JHN 12:1-8">योहान १२:१-८</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 26:6" />जवय येशु बेथानी गावले जो पहिले कोडरोगी व्हता त्या शिमोनना घर व्हता. <verse eid="MAT 26:6" /><verse number="7" style="v" sid="MAT 26:7" /><note caller="+" style="x"><char style="xo" closed="false">२६:७ </char><char style="xt" closed="false"><ref loc="LUK 7:37">लूक ७:३७</ref>,<ref loc="LUK 7:38">३८</ref></char></note>मंग तो जेवाले बठेल व्हता तवय एक बाई महागडं सुगंधी तेल संगमरवरना भांडामा लई वनी अनी तिनी ते भांडं फोडीन तेल त्याना डोकावर वती दिधं. <verse eid="MAT 26:7" /><verse number="8" style="v" sid="MAT 26:8" />हाई दखीन त्याना शिष्य संतापिन बोलनात, हाई का बर नासाडं? <verse eid="MAT 26:8" /><verse number="9" style="v" sid="MAT 26:9" />हाई “ईकीन बराच पैसा भेटतात अनी त्या गरीबसले देता येतात!”<verse eid="MAT 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MAT 26:10" />येशुने हाई दखीन त्यासले सांगं, हाई बाईले का बर त्रास देतस? तिनी तर मनाकरता चांगल कार्य करेल शे. <verse eid="MAT 26:10" /><verse number="11" style="v" sid="MAT 26:11" />गरीब कायमना तुमना जोडे शेतस, पण मी कायमना तुमना जोडे शे अस नही. <verse eid="MAT 26:11" /><verse number="12" style="v" sid="MAT 26:12" />तिनी मना शरिरवर सुगंधी तेल वतीन मना उत्तरकार्यनी तयारी पहिलेच करी दिधी. <verse eid="MAT 26:12" /><verse number="13" style="v" sid="MAT 26:13" />मी तुमले सत्य सांगस की, सर्व जगमा जठे जठे सुवार्ता सांगतीन, तठे तठे तिनी जे सत्कर्म करेल शे त्यानी आठवण करतीन.<verse eid="MAT 26:13" /></para>
  <para style="s">यहुदा ईश्वासघात करस</para>
  <para style="r">(<ref loc="MRK 14:10-11">मार्क १४:१०-११</ref>; <ref loc="LUK 22:3-6">लूक २२:३-६</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 26:14" />मंग बारा शिष्यसमधला एक यहूदा इस्कर्योत मुख्य याजकसकडे गया. <verse eid="MAT 26:14" /><verse number="15" style="v" sid="MAT 26:15" />अनी त्यानी सांगं, मी येशुले धरीन तुमले सोपी दिसु तर माले काय दिशात? मंग त्यासनी त्याले तिस रूपया दिधात. <verse eid="MAT 26:15" /><verse number="16" style="v" sid="MAT 26:16" />तवयपाईन यहूदा त्याले कसं धरी देवाणी यानी संधी दखु लागना.<verse eid="MAT 26:16" /></para>
  <para style="s">शेवटलं जेवण</para>
  <para style="r">(<ref loc="MRK 14:12-21">मार्क १४:१२-२१</ref>; <ref loc="LUK 22:7-13">लूक २२:७-१३</ref>,<ref loc="LUK 22:21-23">२१-२३</ref>; <ref loc="JHN 13:21-30">योहान १३:२१-३०</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MAT 26:17" />नंतर बेखमीर भाकरीना सणना पहिला दिन शिष्य येशुकडे ईसन बोलणात, आपलाकरता वल्हांडण सणना जेवणनी तयारी आम्हीन कोठे करानी अशी तुमनी ईच्छा शे?<verse eid="MAT 26:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MAT 26:18" />त्यानी सांगं, नगरमा एक माणुसकडे जाईन त्याले सांगा की, गुरू म्हणस, मनी येळ जोडे येल शे; माले मना शिष्यसनासंगे तुना आठे वल्हांडण सण कराना शे.<verse eid="MAT 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 26:19" />मंग येशुनी सांगेल प्रमाणे शिष्यसनी जाईन वल्हांडणना जेवणनी तयारी करी.<verse eid="MAT 26:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 26:20" />संध्याकाय व्हयनी तवय तो बारा शिष्यससंगे जेवणले बठना. <verse eid="MAT 26:20" /><verse number="21" style="v" sid="MAT 26:21" />जवय त्या जेवण करी राहींतात तवय येशुनी सांगं, मी तुमले सत्य सांगस, तुमनामधला एकजण माले धरी दि.<verse eid="MAT 26:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 26:22" />तवय त्या भलताच नाराज व्हयनात अनी त्या एक एक करीसन त्याले ईचारू लागनात, “प्रभुजी, मी शे, का तो?”<verse eid="MAT 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 26:23" />येशुनी उत्तर दिधं, ज्यानी मनासंगे ताटमा हात टाकेल शे, तोच माले धरी दि. <verse eid="MAT 26:23" /><verse number="24" style="v" sid="MAT 26:24" />मनुष्यना पोऱ्याबद्दल जस लिखेल शे तसा तो जाई खरा, पण जो मनुष्यना पोऱ्याले धरी दि, त्या माणुसना धिक्कार असो, तो माणुस जन्मले नही येता तर ते त्याले चांगलं व्हतं!<verse eid="MAT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 26:25" />तवय त्याले धरी देणारा यहुदानी त्याले ईचारं, “गुरजी” मी शे का तो? येशुनी त्याले उत्तर दिधं, तु म्हणस तसच.<verse eid="MAT 26:25" /></para>
  <para style="s">प्रभुभोजन</para>
  <para style="r">(<ref loc="MRK 14:22-26">मार्क १४:२२-२६</ref>; <ref loc="LUK 22:14-20">लूक २२:१४-२०</ref>; <ref loc="1CO 11:23-25">१ करिंथ ११:२३-२५</ref>)</para>
  <para style="p">
    <verse number="26" style="v" sid="MAT 26:26" />मंग त्या जेवण करी राहींतात तवय येशुनी भाकर लिधी अनं उपकार मानीन तोडी अनी शिष्यसले दिसन सांगं, “हाई ल्या अनी खा, हाई मनं शरीर शे,”<verse eid="MAT 26:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 26:27" />अनी त्यानी प्याला लिधा अनी उपकार मानीन त्यासले दिसन सांगं, “तुम्हीन सर्वा यानामातीन प्या,” <verse eid="MAT 26:27" /><verse number="28" style="v" sid="MAT 26:28" />हाई मना “करारनं रक्त, शे. पापसनी क्षमा व्हवाकरता सर्वासना करता वताई जाई राहिना शे. <verse eid="MAT 26:28" /><verse number="29" style="v" sid="MAT 26:29" />मी तुमले सत्य सांगस की, मी तोपावत द्राक्षवेलना रस पेवाव नही जोपावत मना पित्याना राज्यमा नवा द्राक्षरस पितस नही.”<verse eid="MAT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MAT 26:30" />मंग देवनं गानं म्हणीसन त्या जैतुनना डोंगरकडे निंघी गया.<verse eid="MAT 26:30" /></para>
  <para style="s">पेत्रकरता भविष्यवाणी</para>
  <para style="r">(<ref loc="MRK 14:27-31">मार्क १४:२७-३१</ref>; <ref loc="LUK 22:31-34">लूक २२:३१-३४</ref>; <ref loc="JHN 13:36-38">योहान १३:३६-३८</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MAT 26:31" />मंग येशु त्यासले बोलना, “तुम्हीन रातले सर्वा माले सोडीन पळी जाशात, कारण शास्त्र अस सांगस की, ‘देव मेंढपायले मारी टाकी अनी कळपमाधला मेंढरसनी दाणादाण व्हई जाई.’ <verse eid="MAT 26:31" /><verse number="32" style="v" sid="MAT 26:32" /><note caller="+" style="x"><char style="xo" closed="false">२६:३२ </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्तय २८:१६</ref></char></note>पण मी जिवत व्हवानंतर तुमना पहिले गालीलमा जासु.”<verse eid="MAT 26:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MAT 26:33" />पेत्र येशुले बोलना, “सर्वा तुले सोडीन पळतीन पण मी तुले सोडीन पळाव नही!”<verse eid="MAT 26:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MAT 26:34" />येशु बोलना, “मी तुले सत्य सांगस की, आज रातले कोंबडा कोकावाना पहिले तु माले तिनदाव नाकारशी.”<verse eid="MAT 26:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MAT 26:35" />पेत्र त्याले बोलना, “तुनासंगे माले मरणं पडनं तरी मी तुमले नाकारावुच नही!” अनी बाकीना शिष्यसनी पण तसच सांगं.<verse eid="MAT 26:35" /></para>
  <para style="s">गेथशेमाने बागमा येशुनी प्रार्थना</para>
  <para style="r">(<ref loc="MRK 14:32-42">मार्क १४:३२-४२</ref>; <ref loc="LUK 22:39-46">लूक २२:३९-४६</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="MAT 26:36" />नंतर येशु त्याना शिष्यससंगे गेथशेमाने नावना बगीच्यामा वना, “मी पुढे जाईन प्रार्थना करस तोपावत तुम्हीन आठे बठा.” <verse eid="MAT 26:36" /><verse number="37" style="v" sid="MAT 26:37" />मंग त्यानी पेत्र अनं जब्दीना दोन्ही पोऱ्या यासले संगे लिधं अनं तो खुपच खिन्न अनं कष्टी व्हवाले लागना. <verse eid="MAT 26:37" /><verse number="38" style="v" sid="MAT 26:38" />तवय तो त्यासले बोलना, “मना जीव” मरणप्राय, खुपच खिन्न व्हई जायेल शे, तुम्हीन आठेच थांबा अनी मनासंगे जागा ऱ्हा.<verse eid="MAT 26:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MAT 26:39" />मंग तो थोडा पुढे जावानंतर पालथा पडिन अशी प्रार्थना कराले लागना की, “हे मना पिता व्हई तर हाऊ दुःखनां प्याला मनावरतीन टळी जावो! तरी मना ईच्छाप्रमाणे नको तर तुनी ईच्छाप्रमाणे व्हऊ दे.”<verse eid="MAT 26:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MAT 26:40" />मंग तो शिष्यसना जोडे वना अनी त्या झोपेल शेतस हाई दखीन पेत्रले बोलना, काय! एक तास बी तुमनाघाई जागं ऱ्हावायनं नही का? <verse eid="MAT 26:40" /><verse number="41" style="v" sid="MAT 26:41" />तुम्हीन परिक्षामा पडाले नको म्हणीन जागा ऱ्हा अनी प्रार्थना करा; आत्मा तयार शे खरं पण शरीर अशक्त शे.<verse eid="MAT 26:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MAT 26:42" />परत दुसरी दाव जाईसन येशुनी हाई प्रार्थना करी की, “हे मना पिता, जर हाऊ प्याला मी पेवाशिवाय टळाव नही तर तुनी ईच्छाप्रमाणे व्हऊ दे.” <verse eid="MAT 26:42" /><verse number="43" style="v" sid="MAT 26:43" />मंग त्यानी परत ईसन त्यासले झोपेल दखं; कारण झोपमुये त्यासना डोया जड व्हयेल व्हतात. <verse eid="MAT 26:43" /><verse number="44" style="v" sid="MAT 26:44" />परत तो त्यासले सोडीन गया अनी परत त्यानी तिसरांदाव त्याच शब्दसमा प्रार्थना करी. <verse eid="MAT 26:44" /><verse number="45" style="v" sid="MAT 26:45" />परत तो शिष्यसकडे ईसन बोलना, काय तुम्हीन अजुन आरामशीर झोपी राहिनात? दखा! येळ जवळ येल शे, मनुष्यना पोऱ्या पापी लोकसना हातमा देवाई जाई राहिना. <verse eid="MAT 26:45" /><verse number="46" style="v" sid="MAT 26:46" />ऊठा, चला. दखा, माले धरी देणारा जोडे येल शे.<verse eid="MAT 26:46" /></para>
  <para style="s">येशुले अटक करतस</para>
  <para style="r">(<ref loc="MRK 14:43-50">मार्क १४:४३-५०</ref>; <ref loc="LUK 22:47-53">लूक २२:४७-५३</ref>; <ref loc="JHN 18:3-12">योहान १८:३-१२</ref>)</para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 26:47" />येशु बोली राहींता इतलामा बारा शिष्यसपैकी एक म्हणजे यहूदा तठे वना, त्यानाबरोबर मुख्य याजक, शास्त्री अनी वडील लोकसना माणसे तलवारी अनी टिपरा लई वनात. <verse eid="MAT 26:47" /><verse number="48" style="v" sid="MAT 26:48" />त्याले धरी देणारानी एक इशारा देयल व्हता तो असा की; “मी ज्यानं चुंबन लिसु तोच तो शे. त्याले धरा!” <verse eid="MAT 26:48" /><verse number="49" style="v" sid="MAT 26:49" />मंग त्यानी लगेच येशुजोडे ईसन, गुरजी, नमस्कार बोलीन त्याना चुंबन लिधात.<verse eid="MAT 26:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 26:50" />येशु त्याले बोलना, “दोस्त! ज्या कामकरता तु येल शे ते कर” तवय त्यासनी जोडे ईसन येशुले धरं अनी अटक करी. <verse eid="MAT 26:50" /><verse number="51" style="v" sid="MAT 26:51" />मंग दखा, येशुनासंगे ज्या व्हतात त्यासनामातीन एकनी तलवार काढी अनी महायाजकना दासवर चालाडी अनं त्याना कान कापी टाका. <verse eid="MAT 26:51" /><verse number="52" style="v" sid="MAT 26:52" />तवय येशु त्याले बोलना “तुनी तलवार परत जागावर ठेव,” कारण “तलवार चालाडणारा सर्वजण तलवारघाईच नाश पावतीन.” <verse eid="MAT 26:52" /><verse number="53" style="v" sid="MAT 26:53" />तुले अस वाटस का की, माले मना पिताजोडे मांगता येस नही, आत्तेना आत्तेच तो मनाकरता देवदूतसना बारा सैन्यपेक्षा जास्त धाडु नही शकस? <verse eid="MAT 26:53" /><verse number="54" style="v" sid="MAT 26:54" />मंग शास्त्रना शास्त्रलेख कशा पुर्ण व्हई की, हाई व्हणं आवश्यकच शे?<verse eid="MAT 26:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 26:55" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२६:५५ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:47">लूक १९:४७</ref>; <ref loc="LUK 21:37">२१:३७</ref></char>
    </note>
    <note caller="+" style="x">
      <char style="xo" closed="false">२६:५५ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 19:47">लूक १९:४७</ref>
      </char>
    </note>तवय येशु लोकसनी गर्दीले बोलना, “जस एखादा नियम तोडणाराले धराकरता तलवार अनी टिपरा लई जातस तसा तुम्हीन माले धराले येल शेतस का? मी रोज मंदिरमा बशीन शिकाडी राहिंतु तरी तुम्हीन माले धरं नही. <verse eid="MAT 26:55" /><verse number="56" style="v" sid="MAT 26:56" />पण संदेष्टासना लेख पुर्ण व्हवाले पाहिजे म्हणीन हाई व्हयनं.” इतलामा सर्व शिष्य त्याले सोडीन पळी गयात.<verse eid="MAT 26:56" /></para>
  <para style="s">मुख्य याजकससमोर येशुनी चौकशी</para>
  <para style="r">(<ref loc="MRK 14:53-65">मार्क १४:५३-६५</ref>; <ref loc="LUK 22:54">लूक २२:५४</ref>,<ref loc="LUK 22:55">५५</ref>,<ref loc="LUK 22:63-71">६३-७१</ref>; <ref loc="JHN 18:13">योहान १८:१३</ref>,<ref loc="JHN 18:14">१४</ref>,<ref loc="JHN 18:19-24">१९-२४</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 26:57" />मंग येशुले धरणारासनी त्याले कैफा नावना मुख्य याजक याना घर लई गयात, तठे शास्त्री अनं वडील लोक जमेल व्हतात. <verse eid="MAT 26:57" /><verse number="58" style="v" sid="MAT 26:58" />पेत्र दुरतीन त्याना मांगेमांगे मुख्य याजकना वाडापावत गया अनं मझार जाईन त्याना शेवट काय व्हस हाई दखासाठे पहारेकरीसमा बसना. <verse eid="MAT 26:58" /><verse number="59" style="v" sid="MAT 26:59" />मुख्य याजक अनं सर्व न्यायसभा यासनी येशुले मारी टाकना उद्देशतीन त्यानविरूध्द खोटा आरोप शोधी राहींतात; <verse eid="MAT 26:59" /><verse number="60" style="v" sid="MAT 26:60" />अनी बराच खोटा आरोप करनारा वनात पण त्यामा त्यासले काहीच भेटनं नही, तरी शेवट दोनजण ईसन बोलणात की, <verse eid="MAT 26:60" /><verse number="61" style="v" sid="MAT 26:61" /><note caller="+" style="x"><char style="xo" closed="false">२६:६१ </char><char style="xt" closed="false"><ref loc="JHN 2:19">योहान २:१९</ref></char></note>“देवनं मंदिर तोडीन ते तिन दिनमा बांधाले मी समर्थ शे अस हाऊ बोलना.”<verse eid="MAT 26:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 26:62" />तवय मुख्य याजक ऊठीसन येशुले बोलना, “तु काहीच उत्तर देत नही का?” या तुनाविरूध्द कितला आरोप करी राहिनात, <verse eid="MAT 26:62" /><verse number="63" style="v" sid="MAT 26:63" />पण येशु गप्पच राहिना. यावरतीन मुख्य याजकनी त्याले सांगं, “मी तुले जिवत देवनी शप्पथ घालिन विचारस की; जर तु देवना पोऱ्या ख्रिस्त शे तर तसं आमले सांगं.”<verse eid="MAT 26:63" /></para>
  <para style="p">
    <verse number="64" style="v" sid="MAT 26:64" />येशु त्याले बोलना, “तु सांगस तसच आखो. मी तुमले सांगस; यापुढे तुम्हीन फक्त मनुष्यना पोऱ्याले सर्व समर्थना उजवीकडे बठेल अनं स्वर्गना ढगसवर येतांना दखशात!”<verse eid="MAT 26:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MAT 26:65" />तवय मुख्य याजकनी आपला कपडा फाडिसन सांगं, हाऊ देवनी निंदा करी राहिना, आते आमले आखो साक्षीदारसनी काय गरज! तुम्हीन हाई निंदा ऐकेल शे! <verse eid="MAT 26:65" /><verse number="66" style="v" sid="MAT 26:66" />तुमले काय वाटस? त्यासनी उत्तर दिधं, “हाऊ मृत्यूदंडना योग्य शे.”<verse eid="MAT 26:66" /></para>
  <para style="p">
    <verse number="67" style="v" sid="MAT 26:67" />तवय त्या त्याना तोंडवर थुंकनात; अनं त्यासनी त्याले बुक्क्या माऱ्यात अनी बाकिनासनी त्याले थापड्या मारीन सांगं <verse eid="MAT 26:67" /><verse number="68" style="v" sid="MAT 26:68" />अरे ख्रिस्त! “भविष्यवाणी करीसन सांगं तुले कोणी मारं!”<verse eid="MAT 26:68" /></para>
  <para style="s">पेत्र येशुले नकारस</para>
  <para style="r">(<ref loc="MRK 14:66-72">मार्क १४:६६-७२</ref>; <ref loc="LUK 22:56-65">लूक २२:५६-६५</ref>; <ref loc="JHN 18:15-18">योहान १८:१५-१८</ref>,<ref loc="JHN 18:25-27">२५-२७</ref>)</para>
  <para style="p">
    <verse number="69" style="v" sid="MAT 26:69" />इकडे पेत्र वाडामा बाहेर बठेल व्हता; तवय मुख्य याजकनी एक दासी त्यानाकडे ईसन बोलनी, “तु पण गालीलकर येशुसंगे व्हता.”<verse eid="MAT 26:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="MAT 26:70" />तो सर्वासना समोर नकारीन बोलना. “तु काय सांगी राहीनी, माले माहीत नही” <verse eid="MAT 26:70" /><verse number="71" style="v" sid="MAT 26:71" />मंग तो बाहेर वट्टावर गया तवय आखो एक दासी त्याले दखीन तठे ज्या उभा व्हतात त्यासले बोलनी, “हाऊ पण नासरी येशु बरोबर व्हता.”<verse eid="MAT 26:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MAT 26:72" />परत “तो शपथ लिसन बोलना मी त्या माणुसले वळखत नही!”<verse eid="MAT 26:72" /></para>
  <para style="p">
    <verse number="73" style="v" sid="MAT 26:73" />नंतर थोडा येळतीन तठे उभा राहणारासनी जोडे ईसन पेत्रले सांगं, खरच तु पण त्यानामाधलाच शे, कारण तुना बोलावरतीन तु कोण शे हाई समजी राहिनं.<verse eid="MAT 26:73" /></para>
  <para style="p">
    <verse number="74" style="v" sid="MAT 26:74" />मंग पेत्र बोलणा, “जर मी खोटं बोली ऱ्हायनु तर, देव माले मारी टाको! अशा शपथा वाहीन बोलु लागणा, हाऊ ज्या माणुसबद्दल तुम्हीन बोली राहिनात त्याले मी वळखत नही!” इतलामा कोंबडा कोकायना, <verse eid="MAT 26:74" /><verse number="75" style="v" sid="MAT 26:75" />तवय “कोंबडा कोकावाना पहीले तु माले तीनदाव नाकारशी” असा ज्या शब्द येशुनी पेत्रले सांगेल व्हतात त्या त्याले आठवणात अनी तो बाहेर जाईसन हंबरडा फोडीन रडाले लागना.<verse eid="MAT 26:75" /></para>
  <chapter eid="MAT 26" />
  <chapter number="27" style="c" sid="MAT 27" />
  <para style="s">येशुले पिलातकडे लई जातस</para>
  <para style="r">(<ref loc="MRK 15:1">मार्क १५:१</ref>; <ref loc="LUK 23:1">लूक २३:१</ref>,<ref loc="LUK 23:2">२</ref>; <ref loc="JHN 18:28-32">योहान १८:२८-३२</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 27:1" />सकायमा सर्व मुख्य याजक अनं वडील लोकसनी येशुले मारी टाकाकरता त्यानाविरूध्द योजना करी. <verse eid="MAT 27:1" /><verse number="2" style="v" sid="MAT 27:2" />अनी त्यासनी त्याले धरीन पिलात सुभेदारले सोपी दिधं.<verse eid="MAT 27:2" /></para>
  <para style="s">यहूदाना मृत्यू</para>
  <para style="r">(<ref loc="ACT 1:18">प्रेषित १:१८</ref>,<ref loc="ACT 1:19">१९</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MAT 27:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२७:३ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:18">प्रेषित १:१८</ref>,<ref loc="ACT 1:19">१९</ref></char>
    </note>येशुले शिक्षापात्र ठरायं हाई दखीन, त्याले धरी देणारा यहूदा याले पस्तावा वना अनी तो त्या तिस रूपया मुख्य याजक अनी वडील लोकं यासले दिसन बोलना, <verse eid="MAT 27:3" /><verse number="4" style="v" sid="MAT 27:4" />“मी निर्दोष माणुसले पकडाई दिसन पाप करेल शे!” त्या बोलणात, त्यानं आमले काय “तुनं तु दख!”<verse eid="MAT 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 27:5" />तवय तो त्या रूपया मंदिरमा फेकीन निंघी गया; अनी त्यानी जाईन फाशी लिधी.<verse eid="MAT 27:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MAT 27:6" />मुख्य याजकसनी त्या पैसा लिसन सांगं, “हाई दानपेटिमा टाकाना योग्य नही शेतस कारण हाई रंगतन मोल शे.” <verse eid="MAT 27:6" /><verse number="7" style="v" sid="MAT 27:7" />मंग त्यासनी ईचार करीसन त्या रूपयासतीन, परदेशीसले पुराकरता कुंभारनं शेत लिधं. <verse eid="MAT 27:7" /><verse number="8" style="v" sid="MAT 27:8" />यामुये आज बी त्या शेतले “रक्तनं शेत” अस म्हणतस.<verse eid="MAT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 27:9" />तवय जे वचन यिर्मया संदेष्टाद्वारे सांगेल व्हतं ते पुर्ण व्हयनं; ते अस की, “ज्यानं मोल इस्त्राएलना वंशसपैकी काही जणसनी ठरायेल व्हतं, ते त्यानं मोल म्हणजे त्या तिस रूपया त्यासनी लिधात, <verse eid="MAT 27:9" /><verse number="10" style="v" sid="MAT 27:10" />अनी प्रभुनी माले आज्ञा करेलप्रमाणे कुंभारनं शेत ईकत लेवासाठे त्यासनी दिधात.”<verse eid="MAT 27:10" /></para>
  <para style="s">पिलात समोर येशु</para>
  <para style="r">(<ref loc="MRK 15:2-5">मार्क १५:२-५</ref>; <ref loc="LUK 23:3-5">लूक २३:३-५</ref>; <ref loc="JHN 18:33-38">योहान १८:३३-३८</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 27:11" />मंग येशु सुभेदार पुढे उभा व्हता तवय सुभेदारनी त्याले ईचारं, “तु यहूद्यासना राजा शे का?” येशुनी उत्तर दिधं तु सांगस तसच. <verse eid="MAT 27:11" /><verse number="12" style="v" sid="MAT 27:12" />मुख्य याजक अनी शास्त्री त्यानावर आरोप करी राहींतात तवय त्यानी काहीच उत्तर दिधं नही.<verse eid="MAT 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MAT 27:13" />तवय पिलात बोलना, “ह्या लोक तुनाविरूध्द कितल्या गोष्टीसनी साक्ष दि राहिनात, हाई तु ऐकी नही राहिना का?”<verse eid="MAT 27:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MAT 27:14" />पण येशु काहीच बोलना नही, एक शब्द पण नही यावरतीन सुभेदारले आश्चर्य वाटणं.<verse eid="MAT 27:14" /></para>
  <para style="s">मृत्यूदंडनी आज्ञा</para>
  <para style="r">(<ref loc="MRK 16:6-15">मार्क १६:६-१५</ref>; <ref loc="LUK 23:13-25">लूक २३:१३-२५</ref>; <ref loc="JHN 18:39-19:16">योहान १८:३९–१९:१६</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 27:15" />वल्हांडण सणमा लोके ज्याले सांगेत त्या कैदीले सोडानी सुभेदारनी सवय व्हती. <verse eid="MAT 27:15" /><verse number="16" style="v" sid="MAT 27:16" />तवय तठे बरब्बा नावना कुप्रसिध्द कैदी व्हता. <verse eid="MAT 27:16" /><verse number="17" style="v" sid="MAT 27:17" />जवय लोके जमनात तवय पिलातनी त्यासले ईचारं, “मी तुमनाकरता कोणले सोडु अशी तुमनी ईच्छा शे? बरब्बाले की, ज्याले ख्रिस्त म्हणतस त्या येशुले?” <verse eid="MAT 27:17" /><verse number="18" style="v" sid="MAT 27:18" />कारण त्यासले त्याना हेवा वाटी राहींता म्हणीन त्याले धरी देयल व्हतं, हाई पिलातले समजनं व्हतं.<verse eid="MAT 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MAT 27:19" />मंग तो न्यायासनवर बठेल व्हता तवय त्याना बायकोनी त्याले निरोप धाडा की; “त्या न्यायी माणुसना काममा तुम्हीन पडु नका, कारण रातले स्वप्नमा भलता दुःख भोगात.”<verse eid="MAT 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MAT 27:20" />पण मुख्य याजक अनं वडील लोकसनी लोकसले चिंगाडीन हाई मागणी कराले लाई की, बरब्बाले सोडा अनं येशुले मारी टाका. <verse eid="MAT 27:20" /><verse number="21" style="v" sid="MAT 27:21" />सुभेदारनी त्यासले ईचारं की, “या दोन्हीसमातीन कोणले तुमनाकरता सोडु अशी तुमनी ईच्छा शे?” त्या बोलणात, “बरब्बाले!”<verse eid="MAT 27:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MAT 27:22" />“पिलातनी त्यासले ईचारं, मंग ज्याले ख्रिस्त म्हणतस, त्या येशुनं मी काय करू?” सर्वा बोलणात, “त्याले क्रुसखांबवर खिया!”<verse eid="MAT 27:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MAT 27:23" />पिलात बोलणा, “का बर? त्यानी काय वाईट करेल शे?”</para>
  <para style="p" vid="MAT 27:23">तवय त्या आखो वरडीन बोलणात; “त्याले क्रुसखांबवर खिया!”<verse eid="MAT 27:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MAT 27:24" />जवय पिलातनी दखं आपल काहीच नही चाली राहिनं, उलट जास्तच गडबड व्हई राहिनी तवय त्यानी पाणी लिधं अनं लोकससमोर हात धोईसन सांगं, “मी ह्या न्यायी माणुसना रक्तबद्दल निर्दोष शे, तुमनं तुम्हीन दखी ल्या!”<verse eid="MAT 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MAT 27:25" />यानावर लोकसनी उत्तर दिधं “यानं रक्त आमनावर अनी आमना पोऱ्यासवर राहो!” <verse eid="MAT 27:25" /><verse number="26" style="v" sid="MAT 27:26" />तवय पिलातनी त्यासनाकरता बरब्बाले सोडं; अनं येशुले फटका मारीन क्रुसखांबवर खियाकरता सोपी दिधं.<verse eid="MAT 27:26" /></para>
  <para style="s">शिपाई येशुनी थट्टा करतस</para>
  <para style="r">(<ref loc="MRK 15:16-20">मार्क १५:१६-२०</ref>; <ref loc="JHN 19:2">योहान १९:२</ref>,<ref loc="JHN 19:3">३</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MAT 27:27" />नंतर सुभेदारना सैनिक येशुले वाडामा लई गयात अनी त्याना चारीबाजुले सैन्य गोळा करी लिधं. <verse eid="MAT 27:27" /><verse number="28" style="v" sid="MAT 27:28" />मंग त्याना कपडा काढिन त्याले गडद लाल रंगना झगा घाली दिधा. <verse eid="MAT 27:28" /><verse number="29" style="v" sid="MAT 27:29" />अनी त्यासनी काटेरी झुडूपना मुकूट गुंफीण त्याना डोकावर ठेवा, त्याना उजवा हातमा वेत दिधा अनी त्यानापुढे गुढघा टेकीन, “हे यहूद्यासना राजा तुना जयजयकार होवो!” अस बोलीन त्यानी थट्टा करी. <verse eid="MAT 27:29" /><verse number="30" style="v" sid="MAT 27:30" />त्या त्यानावर थुंकनात अनं वेत लिसन त्याना डोकावर माराले लागनात. <verse eid="MAT 27:30" /><verse number="31" style="v" sid="MAT 27:31" />मंग त्यासनी थट्टा करानंतर त्यासनी त्याना आंगमातीन तो झगा काढीन त्याना कपडा त्याले घाली दिधात अनी त्याले क्रुसखांबवर खियाकरता लई गयात.<verse eid="MAT 27:31" /></para>
  <para style="s">येशुले क्रुसखांबवर खियतस</para>
  <para style="r">(<ref loc="MRK 15:21-32">मार्क १५:२१-३२</ref>; <ref loc="LUK 23:26-43">लूक २३:२६-४३</ref>; <ref loc="JHN 19:17-27">योहान १९:१७-२७</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MAT 27:32" />त्या बाहेर जाई राहींतात तवय शिमोन नावना एक कुरेनेकर माणुस त्यासले दखायना, त्यासनी त्याले येशुना क्रुसखांब उचलीन लई जावाकरता जबरदस्ती करी. <verse eid="MAT 27:32" /><verse number="33" style="v" sid="MAT 27:33" />मंग गुलगुथा नावनी जागा, म्हणजे, “कवटीनी जागा” आठे ईसन पोहचावर <verse eid="MAT 27:33" /><verse number="34" style="v" sid="MAT 27:34" />त्यासनी त्याले कडु मसाला मिसाळेल द्राक्षरस पेवाले दिधा; पण तो चाखीन दखावर, त्यानी तो पिधा नही. <verse eid="MAT 27:34" /><verse number="35" style="v" sid="MAT 27:35" />त्याले क्रुसखांबवर खियावर त्यासनी चिठ्या टाकीन त्याना कपडा वाटी लिधात. <verse eid="MAT 27:35" /><verse number="36" style="v" sid="MAT 27:36" />नंतर त्यासनी तठे बशीन त्यानी राखन करी. <verse eid="MAT 27:36" /><verse number="37" style="v" sid="MAT 27:37" />त्यासनी त्याना दोषपत्रना लेख त्याना डोकावर क्रुसखांबवर लाया, तो असा की, हाऊ यहूदीसना राजा येशु शे. <verse eid="MAT 27:37" /><verse number="38" style="v" sid="MAT 27:38" />नंतर त्यासनी येशुनासंगे दोन लुटारूसले, एकले उजवीकडे अनी एकले डावीकडे असा क्रुसखांबवर खियात. <verse eid="MAT 27:38" /><verse number="39" style="v" sid="MAT 27:39" />अनी जवळतीन जाणारासनी डोकं हालाईन त्यानी अशी निंदा करी की, <verse eid="MAT 27:39" /><verse number="40" style="v" sid="MAT 27:40" /><note caller="+" style="x"><char style="xo" closed="false">२७:४० </char><char style="xt" closed="false"><ref loc="MAT 26:61">मत्तय २६:६१</ref>; <ref loc="JHN 2:19">योहान २:१९</ref></char></note>“अरे मंदिर तोडीन तिन दिनमा बांधणारा! स्वतःले वाचाड तु देवना पोऱ्या व्हई तर क्रुसखांबवरतीन खाल ये!”<verse eid="MAT 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MAT 27:41" />तसच मुख्य याजक, शास्त्री अनं वडील लोके या पण थट्टा करीसन बोलणात की; <verse eid="MAT 27:41" /><verse number="42" style="v" sid="MAT 27:42" />“त्यानी दुसरासनं तारण करं; त्याले स्वतःले वाचाडता येत नही! तो इस्त्राएलसना राजा शे; त्यानी आते क्रुसखांबवरतीन खाल यावं, म्हणजे आम्हीन त्याना ईश्वास करू! <verse eid="MAT 27:42" /><verse number="43" style="v" sid="MAT 27:43" />तो देववर ईश्वास ठेवस तो देवना पोऱ्या शे; त्याले तो प्रिय व्हई तर त्यानी त्याले आते सोडवाव!”<verse eid="MAT 27:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="MAT 27:44" />ज्या चोर त्यानासंगे क्रुसखांबवर व्हतात त्यासनी पण त्यानी तशीच थट्टा करी.<verse eid="MAT 27:44" /></para>
  <para style="s">येशुना मृत्यू</para>
  <para style="r">(<ref loc="MRK 15:33-41">मार्क १५:३३-४१</ref>; <ref loc="LUK 23:44-49">लूक २३:४४-४९</ref>; <ref loc="JHN 19:28-30">योहान १९:२८-३०</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MAT 27:45" />दुपारना बारा वाजापाईन ते तीन वाजापावत सर्वा देशवर अंधार पडेल व्हता. <verse eid="MAT 27:45" /><verse number="46" style="v" sid="MAT 27:46" />दुपारना तीन वाजनात तवय येशु जोरमा आरोळी मारीन बोलना, “एलोई, एलोई, लमा सबकतनी?” म्हणजे “मना देव, मना देव, तु मना त्याग का बरं करा?”<verse eid="MAT 27:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="MAT 27:47" />तवय ज्या तठे उभा व्हतात त्यासनामातीन बराच जण हाई ऐकीन बोलणात, “दखा, तो एलियाले बलाई राहिना!” <verse eid="MAT 27:47" /><verse number="48" style="v" sid="MAT 27:48" />तवय एकजणनी लगेच पयत जाईसन तुरट पदार्थमा स्पंज बुडाईन तो वेत नावना वनस्पतीना काठीवर ठिसन त्याले पेवाले दिधा.<verse eid="MAT 27:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MAT 27:49" />पण बाकिना बोलणात, “राहु द्या, एलिया त्याले वाचाडाले येस का नही हाई दखुत!”<verse eid="MAT 27:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MAT 27:50" />मंग परत येशुनी मोठी आरोळी मारीन प्राण सोडा.<verse eid="MAT 27:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MAT 27:51" />तवय मंदिरमधला पडदा वरपाईन खालपावत फाटीन दोन तुकडा व्हयनात, जमीन कांपनी, खडक फुटनात, <verse eid="MAT 27:51" /><verse number="52" style="v" sid="MAT 27:52" />तवय कबरी उघडनात अनी झोपेल बराच पवित्र लोकसना मृतदेह जिवत व्हयनात. <verse eid="MAT 27:52" /><verse number="53" style="v" sid="MAT 27:53" />त्या त्यासना पुनरूत्थाननंतर कबरसमातीन निंघीसन पवित्र नगर यरुशलेमा गयात अनी बराच लोकसले दिसनात.<verse eid="MAT 27:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="MAT 27:54" />जमादार अनं त्यानाबरोबर येशुवर लक्ष ठेवनारा भूकंप अनं घडेल गोष्टी दखीन भलता घाबरनात अनं बोलणात “खरंच हाऊ देवना पोऱ्या व्हता!”<verse eid="MAT 27:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="MAT 27:55" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२७:५५ </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:2">लूक ८:२</ref>,<ref loc="LUK 8:3">३</ref></char>
    </note>तठे बऱ्याच बाया, हाई दुरतीन दखी राहिंत्यात, त्या गालीलतीन येशुनी सेवा करत त्याना मांगे येल व्हत्यात. <verse eid="MAT 27:55" /><verse number="56" style="v" sid="MAT 27:56" />त्यामा मग्दालीया मरीया, याकोब अनं योसे यासनी आई मरीया अनं जब्दीनी बायको ह्या व्हत्यात.<verse eid="MAT 27:56" /></para>
  <para style="s">येशुले कबरमा ठेवतस</para>
  <para style="r">(<ref loc="MRK 15:42-47">मार्क १५:४२-४७</ref>; <ref loc="LUK 23:50-56">लूक २३:५०-५६</ref>; <ref loc="JHN 19:38-42">योहान १९:३८-४२</ref>)</para>
  <para style="p">
    <verse number="57" style="v" sid="MAT 27:57" />मंग संध्याकाय व्हवावर अरिमथाई गावना योसेफ नावना एक श्रीमंत माणुस वना, हाऊ पण येशुना शिष्य व्हता. <verse eid="MAT 27:57" /><verse number="58" style="v" sid="MAT 27:58" />त्यानी पिलातजोडे जाईसन येशुनं शरीर मांगं तवय पिलातनी ते देवानी आज्ञा दिधी. <verse eid="MAT 27:58" /><verse number="59" style="v" sid="MAT 27:59" />योसेफनी ते शरीर लिसन तागना स्वच्छ कापडमा गुंढाळं. <verse eid="MAT 27:59" /><verse number="60" style="v" sid="MAT 27:60" />त्यानी ते खडकमा बनाडेल आपली नविन कबरमा ठेवं अनी कबरना तोंडवर भली मोठी धोंड लाई दिधी अनं तो निंघी गया. <verse eid="MAT 27:60" /><verse number="61" style="v" sid="MAT 27:61" />तठे कबरसमोर मग्दालीया मरीया अनं दुसरी मरीया ह्या बठेल व्हत्यात.<verse eid="MAT 27:61" /></para>
  <para style="s">कबरवर पहारा</para>
  <para style="p">
    <verse number="62" style="v" sid="MAT 27:62" />दुसरा दिन म्हणजे शब्बाथ दिननंतरना दिनले मुख्य याजक अनं परूशी पिलातकडे गोळा व्हईन बोलनात, <verse eid="MAT 27:62" /><verse number="63" style="v" sid="MAT 27:63" /><note caller="+" style="x"><char style="xo" closed="false">२७:६३ </char><char style="xt" closed="false"><ref loc="MAT 16:21">मत्तय १६:२१</ref>; <ref loc="MAT 17:23">१७:२३</ref>; <ref loc="MAT 20:19">२०:१९</ref>; <ref loc="MRK 8:31">मार्क ८:३१</ref>; <ref loc="MRK 9:31">९:३१</ref>; <ref loc="MRK 10:33">१०:३३</ref>,<ref loc="MRK 10:34">३४</ref>; <ref loc="LUK 9:22">लूक ९:२२</ref>; <ref loc="LUK 18:31-33">१८:३१-३३</ref></char></note>“महाराज, आमले आठवण शे तो फसाडणारा जिवत व्हता तवय बोलणा व्हता, ‘मी तीन दिन नंतर मी परत जिवत व्हसु.” <verse eid="MAT 27:63" /><verse number="64" style="v" sid="MAT 27:64" />म्हणीन तिन दिनपावत कबरवर पहारा ठेवानी आज्ञा द्या, कदाचित त्याना शिष्य रातले ईसन त्याले चोरी ली जातीन अनं तो मरेल मातीन ऊठेल शे, अस लोकसले सांगतीन; शेवटली लबाडी पहिल्या पेक्षा वाईट व्हई. <verse eid="MAT 27:64" /><verse number="65" style="v" sid="MAT 27:65" />पिलातनी त्यासले सांगं; “तुमना जोडे पहारेकरी शेतस जा तुमले जशा पहारा ठेवता ई तस करा.” <verse eid="MAT 27:65" /><verse number="66" style="v" sid="MAT 27:66" />मंग त्या गयात अनं धोंडवर शिक्का मारीन कबरवर पहाराकरी ठेवात अनं कबर सुरक्षित करी.<verse eid="MAT 27:66" /></para>
  <chapter eid="MAT 27" />
  <chapter number="28" style="c" sid="MAT 28" />
  <para style="s">येशुनं पुनरूत्थान</para>
  <para style="r">(<ref loc="MRK 16:1-10">मार्क १६:१-१०</ref>; <ref loc="LUK 24:1-12">लूक २४:१-१२</ref>; <ref loc="JHN 20:1-10">योहान २०:१-१०</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MAT 28:1" />
    <note caller="+" style="f">
      <char style="fr" closed="false">२८:१ </char>
      <char style="ft" closed="false">शब्बाथ दिन</char>
    </note>शब्बाथना शेवट रविवारना दिन उजाडताच मग्दालीया मरीया अनं दुसरी मरीया ह्या कबर दखाले वनात. <verse eid="MAT 28:1" /><verse number="2" style="v" sid="MAT 28:2" />तवय दखा, मोठा भूकंप व्हयना; कारण प्रभुना दूतनी स्वर्गमातीन उतरीसन धोंड एकबाजुले लोटी अनं तिनावर तो बठना. <verse eid="MAT 28:2" /><verse number="3" style="v" sid="MAT 28:3" />त्यानं रूप विजनामायक व्हतं अनं त्याना कपडा बर्फनामायक व्हतात. <verse eid="MAT 28:3" /><verse number="4" style="v" sid="MAT 28:4" />पहारेकरी त्याले घाबरी थरथर कापाले लागनात अनं मरेलना मायक व्हई गयात.<verse eid="MAT 28:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MAT 28:5" />देवदूत त्यासले बोलणा, “तुम्हीन घाबरू नका,” क्रुसखांबवर खियेल येशुले तुम्हीन शोधी राहिनात, हाई माले माहित शे. <verse eid="MAT 28:5" /><verse number="6" style="v" sid="MAT 28:6" />तो आठे नही शे, कारण त्यानी सांगेल प्रमाणे तो जिवत व्हयेल शे, या, प्रभु झोपेल व्हता ती हाई जागा दखा.<verse eid="MAT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MAT 28:7" />अनी लवकर जाईसन त्याना शिष्यसले सांगा की तो मरेल मातीन उठेल शे, दखा तुमना पहिले गालीलमा जाई राहिना, तठे तुम्हीन त्याले दखशात, दखा, मी तुमले हाई सांगेल शे.<verse eid="MAT 28:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MAT 28:8" />तवय त्या बाया घाबरीन अनं भलताच खूश व्हईसन लगेच कबरपाईन निंघीन त्याना शिष्यसले हाई गोष्ट सांगाले पळण्यात.<verse eid="MAT 28:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MAT 28:9" />मंग दखा येशु त्यासले भेटीन बोलणा, “शांती असो,” त्यासनी जोडे जाईसन त्याना पाय धरीन त्याले नमन करं. <verse eid="MAT 28:9" /><verse number="10" style="v" sid="MAT 28:10" />तवय येशु त्यासले बोलणा, “घाबरू नका, जा अनी हाई मना भाऊसले सांगा, यानाकरता की त्यासनी गालीलमा जावाले पाहिजे, तठे त्या माले दखतीन.”<verse eid="MAT 28:10" /></para>
  <para style="s">पहारेकरीसना निरोप</para>
  <para style="p">
    <verse number="11" style="v" sid="MAT 28:11" />जवय त्या जाई राहिंत्यात, तवय दखा, पहारेकरीसमातीन बराच जणसनी नगरमा जाईन घडेल सर्व गोष्ट मुख्य याजकसले सांगी. <verse eid="MAT 28:11" /><verse number="12" style="v" sid="MAT 28:12" />तवय त्यासनी अनं वडील लोकसनी मिळीन योजना बनाडी अनी पहारेकरीसले बराच चांदीनां शिक्का दिधात <verse eid="MAT 28:12" /><verse number="13" style="v" sid="MAT 28:13" />अनी सांगं की, “आम्हीन झोपेल व्हतुत तवय त्याना शिष्यसनी रातले ईसन त्याले चोरी लई गयात, अस सांगा <verse eid="MAT 28:13" /><verse number="14" style="v" sid="MAT 28:14" />अनी सुबेदारना कानवर हाई गोष्ट गई तर आम्हीन त्याले समजाडीन तुमले चितांमुक्त करसुत.”<verse eid="MAT 28:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MAT 28:15" />मंग त्यासनी चांदीना शिक्का लिसन त्यासले जश सांगेल व्हतं तसच करं, अनी हाई गोष्ट यहूदी लोकसमा पसरनी, अनी आजपावत तशीच चालु शे.<verse eid="MAT 28:15" /></para>
  <para style="s">येशु शिष्यसले दखायना</para>
  <para style="r">(<ref loc="MRK 16:14-18">मार्क १६:१४-१८</ref>; <ref loc="LUK 24:36-49">लूक २४:३६-४९</ref>; <ref loc="JHN 20:19-23">योहान २०:१९-२३</ref>; <ref loc="ACT 1:6-8">प्रेषित १:६-८</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MAT 28:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२८:१६ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:32">मत्तय २६:३२</ref>; <ref loc="MRK 14:28">मार्क १४:२८</ref></char>
    </note>इकडे अकरा शिष्य गालीलमा जो डोंगर येशुनी सांगी ठेयल व्हता त्यानावर गयात. <verse eid="MAT 28:16" /><verse number="17" style="v" sid="MAT 28:17" />अनी त्यासनी त्याले दखीन नमन करं तरी बराच जणसले शंका वाटनी. <verse eid="MAT 28:17" /><verse number="18" style="v" sid="MAT 28:18" />तवय येशु जोडे ईसन त्यासले बोलणा, “स्वर्गमा अनी पृथ्वीवर सर्वा अधिकार माले देयल शे. <verse eid="MAT 28:18" /><verse number="19" style="v" sid="MAT 28:19" /><note caller="+" style="x"><char style="xo" closed="false">२८:१९ </char><char style="xt" closed="false"><ref loc="ACT 1:8">प्रेषित १:८</ref></char></note>यामुये तुम्हीन जाईसन सर्वा राष्ट्रमाधला लोकसले शिष्य करा; त्यासले पिता, पुत्र अनं पवित्र आत्माना नावतीन बाप्तिस्मा द्या, <verse eid="MAT 28:19" /><verse number="20" style="v" sid="MAT 28:20" />अनं ज्या आज्ञा मी तुमले देयल शेतस त्या त्यासले पाळाले शिकाडा अनी दखा युगना अंतपावत मी सदासर्वकाळ तुमनासंगे शे.”<verse eid="MAT 28:20" /></para>
  <chapter eid="MAT 28" />
</usx>