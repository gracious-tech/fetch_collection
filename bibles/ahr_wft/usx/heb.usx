<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Ahirani</book>
  <para style="h">इब्री</para>
  <para style="toc3">इब्री</para>
  <para style="toc2">इब्री</para>
  <para style="toc1">इब्री लोकसले पत्र</para>
  <para style="mt2">इब्री लोकांस पत्र</para>
  <para style="mt1">इब्री लोकसले पत्र</para>
  <para style="imt">वळख</para>
  <para style="ip">येशु जुना करारमाधलं बराच भविष्यवाणीसना परीपुर्ती कश करस हाई दखाडणारा इब्री लोकसले पत्र हाई एक प्रोत्साहन देणारा पुस्तक शे. एक उपदेशनाप्रमाणे यानी मांडनी करामा वनी. भविष्यवाणी अनं यहूदी मुख्य याजकासनी कर्तव्य येशु ख्रिस्तनी कश पुर्ण करात हाई स्पष्टपणतीन दखाडणारा साठापेक्षा जास्त जुना करारनं संदर्भ ह्या पुस्तकमा शे. ह्या कारणतीन हाई पुस्तक यहूदी ईश्वासु लोकसकरता प्रोत्साहन देणारा अस मानाई जायेल शे. याजकसनी आठेन पुढं यज्ञ करानी गरज नही हाई येशुनी नियमशास्त्र कश पुर्ण करा यावरीन ह्या पुस्तकमा स्पष्ट कराई जायेल शे. सर्वा पापसनाकरता एकदाच अनी सर्वकाळना यज्ञ अस येशु व्हयना. ह्या पुस्तकवरीन आमले अस समजस की, येशु ख्रिस्त, देववर ईश्वास ठेवाले आमनाकरता शक्य करस. <char style="xt"><ref loc="HEB 12:2">१२:२</ref></char> अस रितीतीन ह्या काळना आम्हीन ईश्वासनाराकरता हाई पुस्तकमा मोठा प्रोत्साहन शे. आम्हीन त्यानावर विसंबुन रावाले पाहिजे.</para>
  <para style="ip">इब्री लोकसले पत्र कोणी लिखं हाई आमले ठाऊक नही. तरी काही अभ्यासु विद्वानांसन म्हणनं अस शे की, ते प्रेषित पौल, लूक किंवा बार्णबस असं देवना सेवकसनी लिखं व्हई. तसच हाई पुस्तक कवय लिखाई गयं हाई पण आमले समजत नही. तरी बराच अभ्यासक अस मानतस की, ते ख्रिस्त जन्मानानंतर ७० व्या वरीसना अगोदर लिखं व्हई. यानं कारण अस की, जरी येरूशलेम शहर ७० व्या वरीसले नष्ट करामा वना तरी या पुस्तकामा येरूशलेमना वर्णन अशी पध्दतमा करामा येल शे की जशे काय ते नष्ट व्हयेलच नव्हतं. हाई पुस्तक बराच मंडळीसमा फिराईसन वाचाई जाईल व्हई. ते रोम शहरमा लिखेल व्हतं. <char style="xt"><ref loc="HEB 13:24">१३:२४</ref></char></para>
  <para style="iot">रूपरेषा</para>
  <para style="io1">१. लेखक अस सांगस की, येशु हाऊ देवना सगया संदेष्टा अनी देवदूत यासनापेक्षा मोठा शे. <char style="ior"><ref loc="HEB 1:1-4:13">१:१–४:१३</ref></char></para>
  <para style="io1">२. यानानंतर तो अस सांगस की, ज्या याजक यरूशलेमना मंदिरमा सेवा करतस त्यासनापेक्षा बी येशु मोठा शे. <char style="ior"><ref loc="HEB 4:14-7:28">४:१४–७:२८</ref></char></para>
  <para style="io1">३. मोशेला देयल आज्ञानाद्वारा जो जुना करार देवनी त्याना लोकनासंगे करा त्यानापेक्षा बी येशुनी सेवा श्रेष्ठ शे. <char style="ior"><ref loc="HEB 8:1">८:१</ref>; <ref loc="HEB 10:31">१०:३१</ref></char></para>
  <para style="io1">४. येशु हाऊ प्रत्येक बाबतमा मोठा शे हाई स्पष्ट करावर लेखक बराच दैनदिन व्यवहारना बाबतमा सुचना देस. <char style="ior"><ref loc="HEB 10:32">१०:३२</ref>; <ref loc="HEB 13:17">१३:१७</ref></char></para>
  <para style="io1">५. शेवट काही बोध अनं शुभेच्छा दिसन लेखक हाई पत्रना शेवट करस. <char style="ior"><ref loc="HEB 13:18-25">१३:१८-२५</ref></char></para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">देवना शब्द त्याना पोऱ्याकडतीन</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />देव भुतकाळमा बराचदावं अनं येगयेगळा प्रकारतीन आपला पुर्वजससंगे <note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">संदेष्टा </char><char style="ft" closed="false">देवना संदेश सांगणारा</char></note>संदेष्टासनाद्वारा बोलना, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />तो या शेवटला दिनसमा आपलासंगे आपला पोऱ्याद्वारा बोलेल शे, देवनी त्याले सर्व वस्तुसना वारीस करेल शे अनी त्यानाद्वारा त्यानी सर्व सृष्टी उत्पन्न करेल शे. <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />हाई त्यानं गौरवनं तेज अनं त्याना स्वरूपना प्रतिरूप शे, अनी आपला सामर्थ्यना वचनतीन सर्व वस्तुसले संभाळस. लोकसना पापसनी क्षमा करावर तो स्वर्गमा राजाधिराज जो ईश्वर त्याना उजवीकडे बठना.<verse eid="HEB 1:3" /></para>
  <para style="s">देवना पोऱ्यानं श्रेष्ठपण</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />जेवढ पोऱ्याले देवदूतसपेक्षा वारस हक्कतीन श्रेष्ठ नाव भेटेल शे, तेवढाघाई तो त्यासनापेक्षा जास्त श्रेष्ठ व्हयना. <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />देवनी कोणता देवदूतले कधी अस सांगं;</para>
  <para style="q1" vid="HEB 1:5">“तु मना पोऱ्या शे,</para>
  <para style="q2" vid="HEB 1:5">आज मी तुले जन्म देयल शे”</para>
  <para style="q1" vid="HEB 1:5">अस तो कोणताच देवदूतबद्दल बोलना नही</para>
  <para style="q1" vid="HEB 1:5">अनी परत हाई, “मी त्याना पिता असा व्हसु,</para>
  <para style="q2" vid="HEB 1:5">अनी तो मना पोऱ्या असा व्हई.”<verse eid="HEB 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 1:6" />पण जवय देव आपला जेष्ठ पोऱ्याले जगमा धाडी त्या येळबद्दल तो असं म्हणस;</para>
  <para style="p" vid="HEB 1:6">“देवना सर्व दूत त्यानी आराधना करोत.” <verse eid="HEB 1:6" /><verse number="7" style="v" sid="HEB 1:7" />पण देवदूतसबद्दल देव अस सांगस,</para>
  <para style="q1" vid="HEB 1:7">“तो आपला देवदूतसले हवा</para>
  <para style="q2" vid="HEB 1:7">अनी आपला सेवकसले अग्नीज्वाला अस बनाडस.”<verse eid="HEB 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 1:8" />परमेश्वर, पोऱ्याबद्दल तो अस म्हणस;</para>
  <para style="q1" vid="HEB 1:8">“हे परमेश्वर तुना राज्य सदासर्वकाळ टिकी,</para>
  <para style="q2" vid="HEB 1:8">तु लोकसवर न्यायीपणतीन राज्य करशी.”<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />
    <note caller="+" style="f">
      <char style="fr" closed="false">1:9 </char>
      <char style="ft" closed="false">स्त्रोत्र 45:6-7</char>
    </note>तु, जे चांगलं शे त्यावर प्रेम अनी जे वाईट शे,</para>
  <para style="q1" vid="HEB 1:9">त्यानासंगे वैरी करेल शे,</para>
  <para style="q1" vid="HEB 1:9">यामुये हे परमेश्वर, तुना परमेश्वरनी, तुना सोबतीसपेक्षा श्रेष्ठ असा हर्षरूपी तेलना अभिषेक तुले करेल शे,<verse eid="HEB 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 1:10" />तो आखो म्हणस;</para>
  <para style="q1" vid="HEB 1:10">“हे परमेश्वर, तु सुरवातले पृथ्वीना पाया घाला,</para>
  <para style="q2" vid="HEB 1:10">अनी आकाश तुना हातनघाई बनाडेल शे.<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />ते नष्ट व्हई जाई, पण तु कायम राहशी,</para>
  <para style="q2" vid="HEB 1:11">ते सर्व कपडानामायक झिजाई जाई,<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />तु त्यासले सदरानामायक गुंडाळी टाकशी,</para>
  <para style="q2" vid="HEB 1:12">अनी ते कपडानामायक बदली बी जातीन,</para>
  <para style="q1" vid="HEB 1:12">पण तु तसाच राहशी, तु सर्वकाळ जिवतच ऱ्हाशी.”<verse eid="HEB 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 1:13" />देवनी कोणता देवदूतबद्दल अस कधी म्हणं;</para>
  <para style="q1" vid="HEB 1:13">“मी तुना शत्रुसले तुना पायखाल तुना पदासन करापावत तु मना उजवीकडे बैस.”<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />तर देवदूत कोण शेतस? देवदूत देवनी सेवा करनारा आत्मा शेतस अनी तारण भेटणारा लोकसनी मदत कराकरता ते देवनी धाडेल शेतस.<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">महान तारण</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />यामुये ऐकेल सत्यना गोष्टीसकडे आपण विशेष ध्यान देवाले पाहिजे, नहीतर आपण त्यापाईन भटकी जासुत. <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />जो संदेश आमना पुर्वजसले देवदूतसकडतीन भेटना तो खरा ठरना, अनी ज्यासनी तो पाळा नही त्यासले योग्य ती शिक्षा भेटनी. <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />तर आपण एवढा मोठा तारणनाकडे दुर्लक्ष करीसन कसा वाचु शकसुत. यानं वर्णन सर्वात पहिले प्रभुकडतीन कराई गयं अनी ते ऐकणारासनी त्याबद्दल आपले सत्य प्रमाण पटाडी दिधं. <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />त्यानासंगे देवनी बी चमत्कार, अद्भुत कार्य अनं येगयेगळा प्रकारना पराक्रम करीसन अनी आपली ईच्छाप्रमाणे पवित्र आत्माना दानं वाटीसन साक्ष दिधी.<verse eid="HEB 2:4" /></para>
  <para style="s">तारणना मार्गदर्शक</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />देवनी त्या येणारा नवं जगले ज्यानं वर्णन आम्हीन करतस त्यावर देवदूतसले अधिकारी करं नही. <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />कोणतरी अस शास्त्रमा सांगेल शे की;</para>
  <para style="q1" vid="HEB 2:6">“मनुष्य तो काय की तु त्यानी आठवण करानी;</para>
  <para style="q2" vid="HEB 2:6">मनुष्य तो काय की, तु त्यानी काळजी करानी?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />तु त्याले देवदूतस पेक्षा किंचीतच कमी करेल शे;</para>
  <para style="q2" vid="HEB 2:7">तु त्याले गौरव अनं आदरना मुकुट घालेल शे;<verse eid="HEB 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="HEB 2:8" />
    <note caller="+" style="f">
      <char style="fr" closed="false">2:8 </char>
      <char style="ft" closed="false">स्तोत्र 8:4-6</char>
    </note>अनी तु आपला हातघाई करेल सर्व वस्तुसवर त्याले अधिकारी नेमेल शे, त्याना पायखाल ठेयल शे.”</para>
  <para style="p" vid="HEB 2:8">“सर्वकाही त्याना स्वाधीन ठेयल शे” म्हणजे त्याना स्वाधीन ठेयल नही अस काहीच राहू दिधं नही; पण सर्वकाही त्याना स्वाधीन ठेयल शे, पण आजपावत सर्वकाही त्याना स्वाधीन आपले दखायनं नही हाई खरं. <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />पण आम्हीन त्याले म्हणजे येशुले, ज्याले थोडा येळकरता देवदूतस पेक्षा थोडं कमी करामा येल व्हतं, तो मरण सहन करामुये गौरव अनं आदर यासना मुकुट घालेल असा आपलाले दखास, देवनी आपलावरली कृपामुये येशुनी सर्वासकरता मराले पाहिजे म्हणीसन अस व्हयनं. <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />ज्यानाकरता सर्वकाही शे अनी ज्यानाकडतीन सर्वकाही शे, त्यानी बराच पोरसले गौरवमा लयतांना, त्यासनं तारण करनारा जो येशु त्याले दुःख सहन करामुये परिपुर्ण करानं, हाई योग्य व्हतं. <verse eid="HEB 2:10" /><verse number="11" style="v" sid="HEB 2:11" />पवित्र करनारा पुरूष अनी पवित्र करेल लोके ह्या सर्वा एकच पितापाईन शेतस, यामुये तो त्यासले भाऊ अनी बहिणी म्हणाले लाजस नही. <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />तो म्हणस;</para>
  <para style="q1" vid="HEB 2:12">“मी मना भाऊ अनी बहिणीसकडे तुना नावनी किर्ती करसु,</para>
  <para style="q2" vid="HEB 2:12">लोकसभामा तुनी स्तुती करसु.”<verse eid="HEB 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 2:13" />अनी परत तो म्हणस; “मी त्यानावर भरवसा ठेवसु. तसच ‘दखा, मी अनी देवनी माले देयल लेकरं.” <verse eid="HEB 2:13" /><verse number="14" style="v" sid="HEB 2:14" />जसा “लेकरं” एकच रक्तमासना व्हतात तसाच तो पण त्यासनामायक रक्तमासना व्हयना. यानाकरता की मरणवर धनीपण करनारा म्हणजे सैतान, याले आपला मरणतीन नष्ट करी देवानं. <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />अनी ज्या लोके मरणना भितीघाई आयुष्यभर दासपणतीन बांधायेल त्या सर्वासले मोकळ करी लेवानं. <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />सर्वासले माहीत शे की, तो देवदूतसना मदतले नही तर “अब्राहामना संतानसना मदतले येस.” <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />यामुये त्याले सर्व प्रकारमा भाऊ बहिणीसना मायक व्हणं आवश्यक व्हतं, यानाकरता की लोकसना पापसनं प्रायश्चीत कराकरता आपण देवनी सेवा करता दयाळु अनी ईश्वासु मुख्य याजक व्हवाले पाहिजे. <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />कारण जस त्यानी स्वतः परिक्षा अनी दुःख सहन करेल शे, तसच ज्यासनी परिक्षा व्हस त्यासले मदत कराले तो समर्थ व्हयेल शे.<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">येशु हाऊ मोशेपेक्षा श्रेष्ठ शे</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />यामुये मना ईश्वासी भाऊ अनी बहिणीसवन, देवनी पाचारण करेलसवन, येशुवर ध्यान द्या! तो देवना प्रेषित अनी आमना ईश्वासना महायाजक शे. <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />तो आपला नेमेलससंगे ईश्वासु व्हता “जसा मोशे बी देवना सर्व घराणाबद्दल ईश्वासु व्हता.” <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />जस घर बांधणाराले घरपेक्षा जास्त सन्मान शे, तसं येशु बी मोशेपेक्षा जास्त सन्मानना योग्य मोजाई जायेल शे. <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />प्रत्येक घर कोणतरी बांधेल ऱ्हास, पण सर्व वस्तु बनाडणारा देव शे. <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />मोशे देवना घरमा सेवक या नातातीन ईश्वासु राहीना, अनी तो ज्या गोष्टी देव भविष्यमा सांगणार व्हता त्या गोष्टीसबद्दल त्यानी साक्ष दिधी. <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />ख्रिस्त हाऊ ईश्वासु पुत्रना नातातीन परमेश्वरना घरना अधिकारी शे, जर आपण आपली आशाबद्दलना भरवसा अनं आपला अभिमान शेवटपावत भक्कम ठेवा तर त्यानं ते घर आपणच शेतस.<verse eid="HEB 3:6" /></para>
  <para style="s">देवना लोकसले आराम</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />यावरतीन, पवित्र आत्मा अस सांगस की, जर तुम्हीन त्यानी वाणी ऐकशात, <verse eid="HEB 3:7" /><verse number="8" style="v" sid="HEB 3:8" />तुमना पुर्वजसनी रानमा बंड करीसन देवनी परिक्षा दखीन स्वतःनं मन कठीण करं तसं तुम्हीन आपला मनं कठीण करू नका. <verse eid="HEB 3:8" /><verse number="9" style="v" sid="HEB 3:9" />परमेश्वर म्हणस, जरी चाळीस वरीस मी काय करं हाई दखं, तरी तुमना पुर्वजसनी मनी परिक्षा दखी अनी माले पारखं. <verse eid="HEB 3:9" /><verse number="10" style="v" sid="HEB 3:10" />त्यामुये त्या पिढीले संतापिन मी बोलनु, “यासना मनं कायम मनापाईन भटकत राहतस, अनी यासनी मन्या आज्ञासले मानं नही.” <verse eid="HEB 3:10" /><verse number="11" style="v" sid="HEB 3:11" />तवय मी रागमा शपथ वाहीसन बोलनु, या मना विसावाना जागावर प्रवेश करू शकावुत नही. <verse eid="HEB 3:11" /><verse number="12" style="v" sid="HEB 3:12" />भाऊ अनी बहिणीसवन, जिवत देवले सोडी देवानं ईतलं अईश्वासनं दुष्ट मन तुमनामा कोणच व्हवाले नको म्हणीसन जपीन ऱ्हा. <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />जस शास्त्रमा सांगेल “आजना” दिन आपलाले लागु शे तसं एकमेकसले तुम्हीन प्रत्येक दिन धीर देवाना, याकरता की पापना फसवणुकघाई तुमनामातील कोणी कठोर व्हवाले नको. <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />कारण जर आपण आपला सुरवातना आत्मईश्वास शेवटपावत भक्कम धरी ठेवा तर ख्रिस्तना भागीदार बनी जायेल शेतस. <verse eid="HEB 3:14" /><verse number="15" style="v" sid="HEB 3:15" />शास्त्रमा अस सांगेल शे; “आज जर तुम्हीन देवनी वाणी ऐकशात, तर आपला मनसले अस कठीण करू नका, जस की त्यासनी क्रोध देवाना येळले करं व्हतं. <verse eid="HEB 3:15" /><verse number="16" style="v" sid="HEB 3:16" />यामा सांगेल त्या देवनी वाणी ऐकीसन देवविरूध्द ‘बंड करनारा’ त्या कोण व्हतात? तर त्या मोशेद्वारा मिसरमातीन निंघेल सर्वाच नव्हतात का? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />‘देव कोणता लोकसवर चाळीस वरीसपावत संतापमा राहिना? काय त्यासनावर नही ज्यासनी पाप करं, ज्यासना प्रेतं रानमा पडी राहीनात. <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />देवनी शप्पथ वाहीसन कोणले बोलना की, “तुम्हीन मना विश्रामस्थानमा प्रवेश करू शकावुत नही,” ज्यासनी आज्ञा मानी नही त्यासले की नही? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />तर अईश्वासमुये त्यासले वचननी भुमीमा प्रवेश करता वना नही अस आपले दखाई येस.<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />यामुये देवना विसावा यानाबद्दलनं वचन अजुन पावत ठेयल शे, तर आम्हीन सावध ऱ्हावाले पाहिजे, कारण अस व्हवाले नको की तुमनापैकी कोणी त्या विसावापाईन वंचित व्हवा. <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />त्यासनामायक आपले बी सुवार्ता सांगामा वनी, पण ऐकेल वचन त्यासले लाभदायक व्हयनं नही, कारण ऐकणारासनी त्यानावर ईश्वास ठेईन स्विकार करा नही. <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />आम्हीन ज्यासनी ईश्वास ठेवा त्यासनी विश्रामस्थानमा प्रवेश करा जस देवनी वचन लिसन सांगेल शे;</para>
  <para style="q1" vid="HEB 4:3">
    <note caller="+" style="f">
      <char style="fr" closed="false">4:3 </char>
      <char style="ft" closed="false">स्तोत्र 95:11 </char>
    </note>“जस की मी आपला क्रोधमुये शप्पथ लिधी,</para>
  <para style="q2" vid="HEB 4:3">‘त्या मना विश्रामस्थानमा प्रवेश करू शकावुतच नही. जठे मी त्यासले विश्रांती देतु त्या भुमीमा त्या प्रवेश करू शकावुतच नही!’”</para>
  <para style="p" vid="HEB 4:3">तरी त्यानं काम जगना स्थापनापाईन पुर्ण व्हयनात तरी तो बोलना. <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />कारण सातवा दिनबद्दल एक ठिकाने शास्त्रमा त्यानी अस सांगेल शे की, “सातवा दिन देवनी आपला सर्व कामे सराईन विश्रांती लिधी.” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />अनी ह्यानाबद्दल त्यानी असं बी सांगेल शे; “त्या मना विश्रामस्थानमा प्रवेश करावच नही.” <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />ज्यासनी त्यानाबद्दल पहिले सुवार्ता ऐकेल व्हती, त्यासनी आज्ञा न मानामुये अनी अईश्वासमुये प्रवेश भेटना नही. तरी बी काही लोकसले यामा प्रवेश भेटेल शे. <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />म्हणीसन इतला काळनंतर दावीदनाकडतीन सांगेल वरला लेखप्रमाणे त्यानी “आज” असा एक दिन बी ठरायेल, तो लेख असा शे;</para>
  <para style="q1" vid="HEB 4:7">
    <note caller="+" style="f">
      <char style="fr" closed="false">4:7 </char>
      <char style="ft" closed="false">स्तोत्र 95:7-8</char>
    </note>“आज जर तुम्हीन त्यानी वाणी ऐकशात,</para>
  <para style="q2" vid="HEB 4:7">तर आपला मनंसले कठीण करू नका.”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />कारण जर यहोशवा त्यासले देवनी वचन देयल विश्रांती देता तर त्यानानंतर देव दुसरा दिनबद्दल बोलता नही. <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />यामुये जसा देवनी सातवा दिन विसावा लिधा तसा विसावा देवना लोकसकरता बाकी शे. <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />ज्या कोणी देवना विश्रामस्थानमा येल शे त्यासनी, जस देवनी आपला कामे सराईन विसावा लेयल शे तसं त्यासनी आपला बी कामे सराईन विसावा लेतीन. <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />यामुये, या आपण, त्या विश्रामस्थानमा येवाना व्हई तितला प्रयत्न कराले पाहिजे, याकरता की देवनी आज्ञा न मानामुये कोणा नाश व्हवाले नको. <verse eid="HEB 4:11" /><verse number="12" style="v" sid="HEB 4:12" />देवनं वचन सजीव, सक्रीय अनी कोणती बी दुधारी तलवार पेक्षा तीक्ष्ण, जीव अनं आत्मा, सांधा अनं मज्जा दोन्हीसले भेदीसन आरपार जाणारी अनी मनमातील भावना अनं कल्पना यासनी पारख करस. <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />अनी देवनी नजरले दिसाव नही अशी कोणती बी निर्मिती वस्तु नही; तर ज्या निर्मिती वस्तुनासंगे आपला संबंध शे त्याना नजरमा सर्व उघडं शे अनी त्याले आपले प्रत्येकले हिशोब देना शे.<verse eid="HEB 4:13" /></para>
  <para style="s">येशु सर्वश्रेष्ठ प्रमुख याजक</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />तर मंग, स्वर्गतीन पार जायेल देवना पोऱ्या येशु हाऊ थोर प्रमुख याजक आपले शे, आपण जो स्विकार करेल शे त्याले भक्कम धरी राहूत. <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />आपला प्रमुख याजक असा नही ज्याले आपला अशक्तपणानं दुःख व्हस नही, तो तर सर्व गोष्टीसमा आपलामायकच पारखाई गया, तरी बी त्यानी पाप करं नही. <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />आपलावर दया व्हवाले पाहिजे अनी गरजना येळले मदत व्हवाकरता कृपा मिळाले पाहिजे, म्हणीसन आपण ध्यैर्य करीसन कृपाना देवना राजासननाजोडे जाऊत.<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />प्रत्येक प्रमुख याजक मनुष्यसपैकी लेयल शे म्हणीसन देवन्या गोष्टीबद्दल तो मनुष्यसकरता नेमेल ऱ्हास, यानाकरता की त्यानी पापसबद्दल दानं अनं यज्ञपशुनं अर्पण करानं. <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />अज्ञानी अनी भटकेल लोकससंगे तो सौम्यतातीन वागणारा ऱ्हास, कारण तो बी स्वतः बराच गोष्टीसमा अशक्त ऱ्हास. <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />अनी या अशक्तपणमुये त्यानी जस लोकसकरता तसं स्वतःकरता बी पापसबद्दल अर्पण कराले पाहिजे. <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />हाई पदवी कोणी स्वतःव्हईसन निवडी लेस नही, तर अहरोनना मायक देवनी ज्याले पाचारण करेल शे त्याले भेटस. <verse eid="HEB 5:4" /><verse number="5" style="v" sid="HEB 5:5" />असच ख्रिस्तनी बी प्रमुख याजक व्हवाकरता स्वतःना गौरव करी लिधा नही, तर देवनी त्याले सांगं की;</para>
  <para style="q1" vid="HEB 5:5">“तु मना पोऱ्या शे;</para>
  <para style="q2" vid="HEB 5:5">आज मी तुना पिता व्हयेल शे.”<verse eid="HEB 5:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 5:6" />तसच दुसरी ठिकाने बी तो म्हणस,</para>
  <para style="q1" vid="HEB 5:6">“मलकीसदेकना संप्रदायप्रमाणे तु युगानुयुग याजक शे.” <figure style="fig" alt="High priest with his priestly clothes and censer" file="hk00267c.tif" size="col" copy="Horace Knowles ©" ref="५:५">महायाजकना कपडा अनी धुपदानी</figure><verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:७ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:36-46">मत्तय २६:३६-४६</ref>; <ref loc="MRK 14:32-42">मार्क १४:३२-४२</ref>; <ref loc="LUK 22:39-46">लूक २२:३९-४६</ref></char>
    </note>तो पृथ्वीवर जिवत व्हता तवय, स्वतःले मरणपाईन वाचाडाकरता, जो समर्थ शे त्यानाकडे मोठा आक्रोश करीसन अनं आश्रु गाळीसन प्रार्थना अनं ईनंती करी, अनी ती त्याना भक्तीमुये अनं नम्रतेमुये ऐकामा वनी. <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />तरी तो देवना पोऱ्या असतांना बी दुःख सहन करीसन आज्ञापालन करानं शिकना. <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />अनी स्वतःले परिपुर्ण करीसन तो, आपली आज्ञामा राहणारा सर्वासना युगानुयुगना उध्दारना कर्ता व्हयना. <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />त्याले “मलकीसदेकना संप्रदायनामायक” प्रमुख याजक अस नाव देवकडतीन देवामा वनं.<verse eid="HEB 5:10" /></para>
  <para style="s">ईश्वासपाईन भटकी जावाविषयी चेतावणी</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />याबद्दल आमले बरच काही सांगानं शे, ते तुमले सांगनं कठीण शे, कारण तुम्हीन ऐकाकरता मंद व्हयेल शेतस. <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" /><note caller="+" style="x"><char style="xo" closed="false">५:१२ </char><char style="xt" closed="false"><ref loc="1CO 3:2">१ करिंथ ३:२</ref></char></note>जे तुम्हीन ईतला काळमा शिक्षक व्हवाले पाहिजे व्हतात त्या तुमले देवना वचनसना मुळाक्षरं परत कोणतरी शिकाडाले पाहिजे यानी गरज शे, अनी ज्यासले जड अन्न सहन व्हत नही, दुधच पाहिजे, असा तुम्हीन व्हयेल शेतस. <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />जो कोणी दुध पेस, त्याले बरं अनी वाईट काय शे याना काहीच अनुभव नही ऱ्हास, असा धाकला बाळनामायक तो शे. <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />ज्यासना ज्ञान इंद्रियसले अभ्यासमुये चांगलं अनी वाईट यासना चांगलाच अभ्यास व्हयेल शे, असा प्रौढ माणससले जड अन्न शे.<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />यामुये आपण ख्रिस्तबद्दलन्या सुरवातन्या गोष्टी सोडीसन सिध्दांतसकडे जावाना प्रयत्न करूत. मरेलकडे लई जाणारा कामसपाईन मनले फिरावानं, देववर ईश्वास ठेवानं, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />अनी बाप्तिस्मानी शिक्षा देनं, हात ठेवानं, मरेलसनं पुनरूत्थाननं अनी सार्वकालिक न्यायनं शिक्षण हाऊ पाया आपण परत घालाले नको. <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />देव व्हवु दि, तर हाई आपण करूत. <verse eid="HEB 6:3" /><verse number="4" style="v" sid="HEB 6:4" />ज्या लोकं आपला ईश्वासमा भटकी गयात त्यासले परत पश्चताप कराकरता कशं लयता ई? कारण ज्या लोकसले एकदाव प्रकाश भेटी गया, ज्यासनी स्वर्गीय दाननी चव लिधी, ज्या पवित्र आत्माना भागीदार व्हयनात, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />अनी ज्यासनी देवना सुवचनसनी अनं येणारा युगना सामर्थ्यना अनुभव लेयल शे, <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />त्या जर ईश्वासमा भटकी गयात, तर त्यासले पश्चाताप करता परत नवं बनाडानं हाई अशक्य शे, कारण हाई त्यासनं भटकनं म्हणजे त्यासनी देवना पोऱ्याले परत क्रुसखांबवर खियानं अनी त्याना उघड अपमान करनं अस शे.<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />कारण जी “भुमी” आपलावर घडीघडी पडेल पाऊस पिसन आपली लागवड करणारसकरता उपयोगी अशी “भाजीपाला” उगाडस, तिले देवना आशिर्वाद भेटस. <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />अनी जी भुमि काटेरी झाडं अनं झुडपं उगाडस, ती टाकाऊ अनी शापीत व्हवानी वाटवर लागेल शे. तिना शेवट जळनं हाई शे.<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />जरी आम्हीन अस बोलतस तरी, प्रिय भाऊ अनी बहिणीसवन, तुमनी स्थिती यानापेक्षा चांगली अनी तारणकडे लई जाणारी शे असा आमले तुमनाबद्दल भरवसा शे <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />कारण तुमना कार्य अनी तुम्हीन देवना लोकसनी करेल अनी करी राहिनात ती सेवा, यावरतीन जी प्रिती तुम्हीन त्याना नाववर दखाडेल शे, ती बी देवनी ईसरी जावं इतला तो अन्यायी नही. <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />आमनी अशी आशा शे की, तुमनापैकी प्रत्येकनी आशानी पुरी खात्री करी लेवाकरता तशीच उत्सुकता शेवटपावत धरी ठेवानी. <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />म्हणजे तुम्हीन आळशी व्हणार नहीत, पण त्यासनंमायक व्हवानं ज्या ईश्वासतीन अनं धीरतीन देवना वचनसले स्विकारतस, त्यासनामायक व्हा.<verse eid="HEB 6:12" /></para>
  <para style="s">देवना ईश्वासयोग्य वचन</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />जवय देवनी अब्राहामले वचन दिधं, तवय त्याले शपथ लेवाकरता स्वतःपेक्षा कोणी मोठा नव्हता म्हणीसन त्यानी स्वतःनी शपथ वाहिसन. <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />सांगं की, “मी तुले आशिर्वादित करसु अनी तुले बरीचशी संतती दिसु.” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />त्यानी धीर धरीसन वाट दखी, म्हणीसन त्याले यानामायक वचननं फळ प्राप्त व्हयनं. <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />माणुस आपलापेक्षा मोठानी शपथ लेस अनी आपले निश्चित कराकरता शपथ हाई त्यासनामा सर्व वादसना शेवट शे. <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />ज्यासले देवनं अभिवचन मिळाणं व्हतं त्यासले हाई स्पष्ट व्हावं की तो आपला उद्देश बदलावुच नही म्हणीसन त्यानी आपला वचनले शपथनी जोड दिधी. <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />असा दोन गोष्टी त्यानं वचन अनी शपथ ज्या बदलतस नही, अनी या गोष्टीसबद्दल देव खोटं बोलू शकस नही. तर ज्या आमले त्यानामा संरक्षण भेटेल शे त्या आम्हीन जी आशा आमनासमोर ठेयल शे तिले दृढ धरीसन ऱ्हावाकरता भलताच उत्साहीत व्हयेल शेतस. <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />ती आशा आपलाकरता जिवननं नांगर शे, अशी आशा जी निश्चित अनी भक्कम शे अनी स्वर्गना मंदिरना परदामातीन मझारना पवित्र स्थानपावत आरपार जास. <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />तठे मलकीसदेकना संप्रदायनामायक, युगानुयुगना प्रमुख याजक व्हयेल येशु आपलाकरता पुढे जायेल शे.<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">मलकीसदेक याजक</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />हाऊ “मलकीसदेक, शालेमना राजा” अनं सर्वोच्च देवना याजक व्हता, अब्राहाम हाऊ जवय चार राजासले हराईसन परत वना तवय मलकीसदेकनीच समोर जाईसन त्याले आशिर्वाद देयल व्हता. <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />अनं त्याले अब्राहामनी जे युध्दमा लुटी आनेल व्हतं त्या सर्वासमाईन दहावा हिस्सा<note caller="+" style="f"><char style="fr" closed="false">7:2 </char><char style="ft" closed="false">दशमांश आपली कमाईना दहावा भाग (दहा टक्का)</char></note> दिधा. मलकीसदेक आपला नावना अर्थप्रमाणे एक “नितीमान राजा” अनी दुसरं हाई की शालेमना राजा, म्हणजे “शांतीना राजा” व्हता. <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />मलकीसदेकना मायबाप, अनं पुर्वज कोण, त्याना जन्म कवय व्हयना, मरना कवय यानी काहीच लिखेल माहीती नही शे, तो देवना पोऱ्यानामायक कायमना याजक असा शे. <verse eid="HEB 7:3" /><verse number="4" style="v" sid="HEB 7:4" />तुम्हीनच ईचार करा की, हाऊ माणुस म्हणजे मलकीसदेक कितला महान व्हता ज्याले कुलाधिपती अब्राहामनी आपला लुटेल वस्तुमाईन सर्वात चांगल्या वस्तुसना दशमांश दिधा. <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />लेवीना संतानसपैकी ज्याले याजकपण मिळस त्याले बंधुसपाईन, म्हणजे अब्राहामना घरानामा जन्मेल आपला लोकसपाईन नियमशास्त्रप्रमाणे दहावा हिस्सा लेवानी आज्ञा शे. <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />पण मलकीसदेक ज्याना वंश त्या लोकसपाईन नव्हता त्यानी अब्राहामकडतीन दहावा हिस्सा लिधा अनी ज्याले देवना वचनं भेटेल व्हतात त्याले आशिर्वाद दिधा. <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />यामा शंका नही की धाकलाले मोठापाईन आशिर्वाद भेटस. <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />इकडे दखं तर मरेल माणससले दहावा हिस्सा भेटस, पण मलकीसदेककडे दखं तर जो जिवत राहणारा शे अशी ज्यानाबद्दल साक्ष शे, त्याले मिळस. <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />अस म्हणता ईकी जवय अब्राहामनी दहावा हिस्सा दिधा त्या अर्थतीन ज्यानं वंशच दहावा हिस्सा लेतस तो लेवी त्यानी बी तो दिधा अस म्हणता ई. <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />कारण तवय लेवीना जन्म व्हयेल नव्हता जवय त्याना पुर्वज अब्राहाम मलकीसदेकले भेटना.<verse eid="HEB 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />लेवीय याजकपणना आधारवर इस्त्राएल लोकसले नियमशास्त्र देवामा वनं. आते जर लेवीय याजकसनं काम परीपुर्ण ऱ्हातं तर दुसरा प्रकारना याजकनं म्हणजे अहरोनना नही पण मलकीसदेकना परंपराना शे त्यानी येवानी गरज व्हती. <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />याजकपण बदलनं म्हणजे नियमशास्त्र बी अवश्य बदलस. <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />ज्यानाबद्दल हाई वचन सांगं तो, ज्या वंशमाधला कोणीच याजक म्हणीसन वेदीजोडे काम करेल नव्हतं, असा दुसरा वंशमाधला शे. <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />कारण आपला प्रभु यहुदाना वंशमातीन व्हता हाई उघड शे, जवय मोशे याजकपणबद्दल बोलस तवय या वंशना त्यानी उल्लेख करा नही.<verse eid="HEB 7:14" /></para>
  <para style="s">मलकीसदेकनामायक दुसरा याजक</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />हाई गोष्ट तवय बी स्पष्ट व्हई जास जवय मलकीसदेकनामयक कोणी दुसरा याजक उभा व्हई जास. <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />जो शारिरीक व्यवस्थाना नियमनूसार नही, पण अविनाशी जिवनना सामर्थ्यघाई बनेल असा व्हता. <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />त्यानाबद्दल शास्त्र अस सांगस की; “तु मलकीसदेकना संप्रदायनामायक युगानुयुगना याजक शे.” <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />जुननी आज्ञा कमजोर अनं निरूपयोगी असामुये ती बाजुले करामा वनी. <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />कारण मोशेना नियमशास्त्रघाई काहीच व्यवस्थित व्हयनं नही. अनी अधिक चांगली आशा देवामा येल शे, त्या आशाना द्वारा आपण देवजोडे जातस. <verse eid="HEB 7:19" /><verse number="20" style="v" sid="HEB 7:20" />अनी देवनी शपथसुध्दा शे. जवय दुसरा याजक व्हयनात तवय त्या शपथशिवाय व्हयनात. <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />अनी “‘तु युगानुयुग याजक शे’ अशी शपथ देवनी लिधी, अनी ती तो बदलाव नही,” अस ज्यानी त्यानाबद्दल सांगं त्याना त्या शपथघाई येशु हाऊ याजक व्हयना. <verse eid="HEB 7:21" /><verse number="22" style="v" sid="HEB 7:22" />त्यामुये येशु त्यानापेक्षा चांगला करारना हामी बनेल शे.<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />त्यासले कायम टिकी राहता येस नही कारण मरणना त्यासले अडथळा असामुये बराच याजक व्हईसन गयात. <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />पण येशु युगानुयुग ऱ्हावामुये त्यानं याजकपण कायमनं शे. <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />यामुये त्यानाद्वारा देवकडे जाणारासले हाऊ पुर्णपणे तारण कराले समर्थ शे, कारण त्यासनाकरता मध्यस्थी कराले हाऊ सर्वदा जिवत शे.<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />असाच प्रमुख याजक आपले ऱ्हावाले पाहिजे हाई योग्य व्हतं, येशु पवित्र, सात्विक, निर्मळ, पापी जणसपाईन येगळा अनं आकाशतीन उच्च करामा येल असा शे. <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />त्याले त्या दुसरा प्रमुख याजकसनामायक पहिलींदाव स्वतःना पापसकरता, मंग लोकसना पापसकरता, प्रत्येक दिनले यज्ञ करानं आवश्यक नही. तवय एकदावच सर्वासकरता त्यानी स्वतःनं अर्पण करं. <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />नियमशास्त्र दुर्बळ असा माणुसले प्रमुख याजक नेमस, पण नियमशास्त्रना नंतर देवनी शपथ लिसन देयल वचन “युगानुयुग” परिपुर्ण करेल “पुत्रले” नेमस.<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">येशु आमना प्रमुख याजक</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />आमना सांगाना उद्देश हाऊ शे की, स्वर्गमा राजाधिराज जो ईश्वर शे त्याना राजासनना उजवीकडे बठेल असा प्रमुख याजक आपले शे. <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />तो त्या परम पवित्रस्थानना अनी ज्याले माणुसनी नही तर देवनी बनाडेल खरा मंडपना प्रमुख याजक शे.<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />प्रत्येक प्रमुख याजक दानं अनी यज्ञपशु हाई अर्पण कराकरता नेमेल ऱ्हास, अनी त्यानाजोडे बी अर्पण कराकरता काहीतरी असाले पाहिजे हाई आवश्यक शे. <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />तो जर पृथ्वीवर असता तर याजक नही राहता, कारण यहूदी नियमशास्त्रप्रमाणे दानं अर्पण करनारा याजक शेतस. <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />त्या याजक स्वर्गीय वस्तुसनी प्रतिमा अनं सावली यासनी सेवा करतस, तसच मोशे बी मंडप करणार व्हता, तवय देव त्याले म्हणस, “पर्वतवर तुले दखाडेल नमुनाप्रमाणे सर्व वस्तु बनाडानी सावधगिरी ठेव.” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />पण आते येशुले आखो श्रेष्ठ याजकपण मिळेल शे, कारण तो एक चांगला वचनावर स्थापेल अधिक चांगला करारना मध्यस्थी शे.<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />कारण तो पहिला करार निर्दोष राहता, तर दुसरानी गरज नही ऱ्हाती. <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />देव त्यानाच लोकसना दोष शोधीसन म्हणस,</para>
  <para style="q1" vid="HEB 8:8">“परमेश्वर म्हणस, असा दिन ई राहिनात की,</para>
  <para style="q2" vid="HEB 8:8">त्यामा इस्त्राएलना घराना अनं यहुदाना घराना यासनासंगे मी नवा करार करसु,<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />मी त्यासना पुर्वजसना हात धरीसन त्यासले मिसर देशमाईन बाहेर आनं,</para>
  <para style="q2" vid="HEB 8:9">तवयना करारनामायक हाऊ करार व्हवावु नही,</para>
  <para style="q1" vid="HEB 8:9">कारण मना करारप्रमाणे त्या ईश्वासु राहिनात नही,</para>
  <para style="q2" vid="HEB 8:9">अनी मी त्यासनाकडे लक्ष दिधं नही,<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />तर परमेश्वर म्हणस, त्या दिन नंतर इस्त्राएलना घरानासंगे जो करार</para>
  <para style="q2" vid="HEB 8:10">मी करसु तो हाऊ;</para>
  <para style="q1" vid="HEB 8:10">मी आपला नियम त्यासना ईचारमा ठेवसु,</para>
  <para style="q2" vid="HEB 8:10">अनी ते त्यासना मनवर लिखसु</para>
  <para style="q1" vid="HEB 8:10">अनी मी त्यासना देव असा व्हसु,</para>
  <para style="q2" vid="HEB 8:10">अनी त्या मना लोके असा व्हतीन,<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />तवय प्रत्येकजन आपला गावबंधुले,</para>
  <para style="q2" vid="HEB 8:11">प्रत्येक आपला भाऊ अनं बहिणीसले,</para>
  <para style="q2" vid="HEB 8:11">परमेश्वरले वळखा असा बोध करावु नही,</para>
  <para style="q1" vid="HEB 8:11">कारण त्यासनामातीन धाकलापाईन मोठापावत,</para>
  <para style="q1" vid="HEB 8:11">त्या सर्वा माले वळखतीन,<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />कारण मी त्यासना पापसनी क्षमा करसु,</para>
  <para style="q2" vid="HEB 8:12">अनी त्यासना पापसनी यापुढे कधीच आठवण करावु नही.”<verse eid="HEB 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 8:13" />त्यानी नवं अस म्हणामुये पहिले जे व्हतं ते जुनं व्हई गयं, अनी जे जुनं अनं कुजी राहीनं ते लवकर नाहीसं व्हई.<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">पृथ्वीवरली अनं स्वर्गमाधली आराधना</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />पहिला करारमा बी उपासनाना विधी व्हतात अनं एक पवित्रस्थान व्हतात, ज्या पृथ्वीवर व्हतात. <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />पहिला मंडप तयार करेल व्हता त्यामा दिवासनी समई, मेज अनी समर्पित भाकरी व्हत्यात, त्याले पवित्रस्थान म्हणेल शे. <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />अनी दुसरा पडदाना पलिकडे परमपवित्र स्थान म्हणेत तो मंडप व्हता. <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />त्यामा धुप जाळाकरता सोनानी एक वेदी अनी करारना कोश व्हता. या कोशमा मान्ना ठेयल सुवर्णपात्र, कळ्या येल अहरोननी काठी, अनं करारना आज्ञासन्या दगडी पाट्या या व्हत्यात. <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />अनी त्यानावर गौरवशाली करूबीम<note caller="+" style="f"><char style="fr" closed="false">9:5 </char><char style="fq" closed="false">करूबीम </char><char style="ft" closed="false">पंख व्हतात असा प्राणी</char></note> आपला पंखासघाई दयासनवर छाया करी राहिंतात, पण आम्हीन या सर्व गोष्टीसनं आठे सविस्तर वर्णन करू नही शकावुत. <figure style="fig" alt="Interior of tabernacle" file="bk00278c.tif" size="col" copy="Horace Knowles ©" ref="९:२">सभास्थानमाधला मंडप मधला भाग</figure><verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />या वस्तुसनी अशी व्यवस्था करेल व्हती तरी याजक त्यासनी सेवा कराकरता पहिला मंडपमा कायम जात राहतस. <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />दुसरामा प्रमुख याजक मात्र वरीसमातीन एकदावं स्वतःबद्दल अनं लोकसना अज्ञानमुये व्हयेल पापसबद्दल जे रक्त देवले अर्पण करानं ते लिसन जास, त्यानाशिवाय जास नही. <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />पवित्र आत्मा स्पष्टपनतीन दखाडस की, जोपावत पहिला मंडप उभा शे, तोपावत परम पवित्रस्थाननी वाट प्रकट व्हस नही. <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />तो मंडप वर्तमान काळमा प्रतिकाना रूपमा शे, त्यानी व्यवस्थाप्रमाणे उपासकना विवेकभाव शुध्द कराकरता समर्थ नहीत असा दानं अनं यज्ञपशु अर्पण करामा येस. <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />कारण हाई फक्त खावानं पेवानं अनी शुध्दीकरणना येगयेगळा विधीसले जोडेल शारिरीक नियम शेतस, देवनी जे सुधारनुकना नवा काळपावत लाई देयल व्हतं.<verse eid="HEB 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />पण जवय ख्रिस्त येणाऱ्या चांगल्या गोष्टीसना पहिलाच प्रमुख याजक व्हईसन प्रकट व्हयना तर त्यानी आखो मोठा अनं परीपुर्ण मंडप मातीन व्हईसन प्रवेश करा जो मनुष्यना हाततीन बनाडेल मंडप नव्हता, म्हणजे हाई सृष्टीना नव्हता. <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />अनी बोकड अनी वासरू यासनं रक्त नही तर स्वतःनं रक्त लिसन एकदाच परमपवित्र स्थानमा गया अनी त्यानी सार्वकालिक मुक्ती मिळाई लिधी. <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />कारण विधीनानुसार जर अशुध्द लोकसवर बोकडसनं अनी बैलसनं रक्त तसच वासरूना राखना शितडा पडनात म्हणजे शरिरना शुध्दताकरता पवित्र करस. <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />तर सार्वकालिक आत्मानाद्वारा ज्यानी निष्कलंक अस स्वतःनं देवले अर्पण करं त्या ख्रिस्तनं रक्त तुमना विवेकभाव जिवत देवना सेवा करता निर्जीव कामसपाईन कितलं तरी विशेषतातीन शुध्द करी.<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />अनी ख्रिस्त यानाकरताच नवा करारना मध्यस्थी शे, कारण पहिला करारमा त्यासनी ज्या पापं करात त्यानापाईन खंडणी भरीसन मुक्ती कराकरता तो मरणा, यानाकरता की पाचारण व्हयेलसले वचन देयल सार्वकालिक आशिर्वाद भेटाले पाहिजे.<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />कारण जठे मृत्युपत्र शे तठे कर्ताना मृत्यु व्हनं आवश्यक शे. <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />मृत्यु व्हवानंतर मृत्युपत्र अमलमा येस, कारण मृत्युपत्र कर्ता जिवत शे तोपावत ते कधीच चालावु नही. <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />यामुये पहिला करारनी बी स्थापना रक्तशिवाय व्हयनी नही. <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />मोशेनी नियमशास्त्रप्रमाणे सर्व आज्ञा सर्व लोकसले सांगावर, तवय त्यानी पाणी, किरमीजी लोकर अनं एजोबनं वनस्पतीन्या फांद्या यासनासंगे वासरू अनी बोकडनं रक्त लिसन नियमशास्त्रना पुस्तकवर अनं सर्व लोकसवर शिंपडं. <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />अनी तो बोलना, “जो करार देवनी आज्ञा करीसन तुमनाकरता दिधा त्यानं हाई रक्त शे.” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />अनी तसच मोशेनी मंडप अनं आराधनामा वापरेल सर्व पात्रसवर रक्त शिंपडं. <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />नियमशास्त्रप्रमाणे रक्तघाई जवळपास सर्व शुध्द व्हतस अनी रक्त वाहत नही तोपावत पापसनी क्षमा व्हस नही.<verse eid="HEB 9:22" /></para>
  <para style="s">ख्रिस्तना बलीदानद्वारा पापासनी क्षमा</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />यामुये शे की, स्वर्गीय वस्तुना प्रतिमासनं या पशुसना अर्पणस द्वारा शुध्द कराई जास, पण स्वर्गीय वस्तु स्वतःबी यानापेक्षा उत्तम बलिदानद्वारा शुध्द व्हणं आवश्यक व्हतं. <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />खऱ्या गोष्टीसना नमुनाना मायक हातसनी करेल पवित्रस्थान यामा ख्रिस्त गया नही, तर आपलाकरता देवनापुढे उभा ऱ्हावाकरता स्वर्गमा गया. <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />अनी जसा प्रमुख याजक प्रत्येक वरीसले दुसरासनी देयल पशुसना रक्त लिसन परमपवित्र स्थानमा जास, तसा ख्रिस्त स्वतःले परत परत अर्पण कराले गया नही. <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />तो जर जाता तर जगनी स्थापनापाईन ख्रिस्तले परत परत दुःख सोसनं पडतं, पण तो युगना समाप्तीले स्वतःना अर्पणघाई पापं नष्ट कराकरता एकदावंच प्रकट व्हयेल शे. <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />जस मनुष्यले एकदावनं मरणं अनी त्यानानंतर देवकडतीन न्याय व्हणं नेमी ठेयल शे. <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />तसा ख्रिस्त बराच जणसना पापं स्वतःवर लेवाकरता एकदावच अर्पण व्हयना अनी तो दुसरींदाव प्रकट व्हई तवय तो पाप लेवाकरता नही, पण त्यासना उध्दारकरता ज्या उत्सुकतातीन त्याना येवानी वाट दखी राहीनात.<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />यहूदी नियमशास्त्रमा तर भावी चांगल्या वस्तुसना वास्तविक प्रतिमा नही, पण सावली शे, लोकसकडतीन देवले कायम वरीस दर वरीस चढाई जाणारा अर्पणसघाई जोडे येणाराले नियमशास्त्र कधीच योग्य ठरावु शकस नही? <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />ते जर योग्य ठरावतं तर, एकदाव शुध्द व्हयेल लोके देवनी आराधना करनारासनं यानापुढे जर पाप सरी जातं तर त्यासनं अर्पण करानं बंद व्हतं नही का. <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />पण ते यज्ञ वरीसनंवरीस पापसनी आठवण करी देतस. <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />कारण बैलसनं अनी बोकड्यासनं रक्त यासनामुये पापं दुर व्हतीन हाई अशक्य शे.<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />यामुये ख्रिस्त जगमा येतांना देव बोलना,</para>
  <para style="q1" vid="HEB 10:5">“यज्ञपशु अनी अन्न यासनं अर्पण ह्या तुले पाहिजे नव्हतात,</para>
  <para style="q2" vid="HEB 10:5">तु मनाकरता शरीर तयार करेल शे;<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />तु होमबली अनी पापसकरता करेल</para>
  <para style="q2" vid="HEB 10:6">अर्पणंसनी तुले आनंद व्हयना नही,<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />तवय मी बोलनु, ‘हे परमेश्वर, हा मी शे, मी तुनी ईच्छा पुरी कराकरता येल शे, नियमशास्त्रमा मनाबद्दल हाईच लिखेल शे.’ ”<verse eid="HEB 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 10:8" />वर उल्लेख करेलप्रमाणे सुरवातले तो बोलना, “अर्पण, अन्नार्पणं, होम अनं पापसबद्दल अर्पण, यासनी तुले ईच्छा नही अनं त्यामा तुले काहीच आनंद नही.” जरी ह्या सर्व अर्पण नियमशास्त्रप्रमाणे करामा ई राहिंतात तरी तो अस बोलना, <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />अनी मंग तो बोलना, “मी तुनी ईच्छाप्रमाणे कराले येल शे,” तो पहिला यज्ञसले काढी टाकस अनी ख्रिस्तना यज्ञनी स्थापना करस. <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />देवना “ईच्छातीन” आपण येशु ख्रिस्तना शरिरनं एकदाच व्हयेल अर्पणद्वारा पवित्र करेल शेतस. <figure style="fig" alt="Burnt offering on an altar" file="hk00256c.tif" size="col" copy="Horace Knowles ©" ref="१०:१०">वेदीवर बलिदान</figure><verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />प्रत्येक यहूदी याजक दररोज सेवा करत अनी ज्या यज्ञ पापं दूर कराकरता कधीच समर्थ नहीत तेच तो घडीघडी करत उभा ऱ्हास. <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />पण ख्रिस्त तर याजकना बनीसन पापसबद्दल सार्वकालिक असा एकच यज्ञ अर्पण करीसन देवना उजवीकडे बठेल शे. <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />अनी देव त्याना वैरीसनं त्यानं पादासन करस नही तोपावत तो वाट दखी राहीना. <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />पापसपाईन शुध्द व्हणारासले त्यानी एक अर्पणघाई सर्वकाळकरता पवित्र करेल शे.<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />पवित्र आत्मा बी आपले साक्ष देस ती अशी, पहिले परमेश्वर बोलस;<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />
    <note caller="+" style="f">
      <char style="fr" closed="false">10:16 </char>
      <char style="ft" closed="false">यिर्मया 31:33</char>
    </note>“त्या दिनस नंतर जो करार मी त्यासनासंगे करसु</para>
  <para style="q2" vid="HEB 10:16">अस परमेश्वर म्हणस ते हाई शे;</para>
  <para style="q1" vid="HEB 10:16">मी आपला नियम त्यासना हृदयसमा ठेवसु,</para>
  <para style="q2" vid="HEB 10:16">अनी ते त्यासना मनवर लिखसु,”<verse eid="HEB 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 10:17" />अस म्हणावर तो म्हणस, “त्यासना पापं अनी त्यासना दुष्ट कामेसनी यापुढे मी आठवण करावु नही.” <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />तर मंग जठे त्यासनी क्षमा व्हयनी तठे पापसबद्दल अर्पण ऱ्हावाले नको.<verse eid="HEB 10:18" /></para>
  <para style="s">चला आपण देवजोडे जाऊत</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />यामुये हे भाऊ अनी बहिणीसवन, आपले येशुना मरणना द्वारा परमपवित्र स्थानमा जावाकरता पुरी सुट भेटनी, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />त्यानी पडदातीन म्हणजे आपला स्वतःना शरिरनाद्वारा आपलाकरता एक नवी अनी जिवत वाट उघडी. <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />अनी आपलाकरता एक असा प्रमुख याजक शे जो देवना घरवर अधिकारी शे. <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />तर चला, आपण खरा मनतीन अनी पुरा ईश्वासतीन अनी विवेकना दोष दूर कराकरता शिंपडेल हृदय लिसन, अनी शरिरले शुध्द पाणीघाई धोईसन, देवनाजोडे जाऊत. <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />या, आपण आशा धरी ठेयल शे तिले भक्कम धरी ठेवुत, कारण ज्यानी वचन देयल शे तो देव ईश्वासयोग्य शे. <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />प्रिती अनी चांगला कामे कराकरता उत्तेजन भेटी अस एकमेकसकडे ध्यान द्या. <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />आपण काही लोकसना चालीरितीसना मायक आपलं एकत्र राहनं सोडू नका, तर एकमेकसले प्रोत्साहन देवानं अनी देव येणार शे तो दिन जोडे ई राहीना हाई तुम्हीन दखतस, म्हणीसन विशेषकरीन हाई करा.<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />कारण सत्यनं ज्ञान भेटानंतर आपण जाणीबुजीसन पाप करं तर पापसबद्दल यानापुढे यज्ञ व्हनार नही. <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />न्याय व्हवानी भयंकर अशी मार्गप्रतीक्षा अनी विरोधकसले नष्ट करी टाकी असा अग्नीप्रकोप राखीन ठेयल शे. <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />मोशेनं नियमशास्त्र जर कोणी तुच्छ मानं तर त्यानावर दया व्हस नही, त्याले दोन्हीसना किंवा तिन्हीसना साक्षमुये मरणदंड व्हस. <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />तर ज्यानी देवना पोऱ्याले पायखाल तुडावं, देवना पोऱ्या स्वतः पवित्र व्हयेल व्हता त्यानं ते करारनं रक्त अपवित्र मानं अनी कृपाना आत्माना अपमान करा असा तो कितला कठीण दंडकरता पात्र ठरी, ईचार करा! <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />“सुड लेनं मनाकडे शे, मी फेड करसु” हाई ज्यानी सांगं तो आपले माहीत शे अनी आखो बोलना, “प्रभु आपला लोकसना न्याय करी.” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />सदाजिवत देवना हातमा सापडनं हाई भयंकर शे!<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />तुम्हीन पहिला दिनसनी आठवण करा. त्यामा तुमले देवना प्रकाश भेटावर, तुम्हीन दुःखसना सामना बराच धीर धरीसन करा. <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />तवय निंदा अनं संकट सोसामुये तुम्हीन लोकसले तमाशा व्हयनात, तर कधी अशी दशा व्हयेल लोकसना भागीदार व्हयनात. <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />कारण तुम्हीन कैदीसले सहानुभुती दखाडी अनी तुमनी संपत्तीनं नुकसान व्हयनं तरी त्याना तुम्हीन हाई समजीसन आनंद करा की तुमना जोडे आखो चांगली अनी टिकावु संपत्ती शे. <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />यामुये आपली हिम्मत सोडू नका, त्यापाईन मोठं प्रतिफळ शे. <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />तुमले हिम्मतनी गरज शे, यानाकरता की तुम्हीन देवनी ईच्छाप्रमाणे वागीसन वचननं फळ प्राप्त करी लेवाले पाहिजे. <verse eid="HEB 10:36" /><verse number="37" style="v" sid="HEB 10:37" />कारण शास्त्र सांगस;</para>
  <para style="q1" vid="HEB 10:37">“थोडाच येळ राहेल शे, जो येवाव शे तो ई,</para>
  <para style="q2" vid="HEB 10:37">तो उशीर करावु नही.<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />मना नितीमान लोकं ईश्वासतीन वाचतीन;</para>
  <para style="q2" vid="HEB 10:38">तो जर माघार ली,</para>
  <para style="q2" vid="HEB 10:38">तर त्यानाबद्दल माले चांगलं वाटावु नही.”<verse eid="HEB 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 10:39" />नाश व्हई अशी माघार लेणारसपैकी आपण नही, तर जिवना उध्दारकरता ईश्वास धरणारा लोकासपैकी शेतस.<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">ईश्वास</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />आते ईश्वास हाऊ आशा करेल गोष्टीसना भरवसा अनी न दखावणाऱ्या गोष्टीसबद्दलनी खात्री अशी शे. <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />ईश्वासबद्दलनं आपला पुर्वजसनं नाव व्हतं.<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">११:३ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:3">योहान १:३</ref>
      </char>
    </note>ईश्वासमुये आपले समजस की देवना शब्दतीन सृष्टीनी रचना व्हयनी, अस की ज्या गोष्टी दखास ते दखावणाऱ्या वस्तुसपाईन व्हयेल नही.<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />हाबेलनी काईनपेक्षा चांगला यज्ञ ईश्वासतीन देवले अर्पण करा, त्यामुये तो नितीमान शे अशी त्यानाबद्दल साक्ष व्हयनी. अनी ती साक्ष दान देवाना येळले देवनी दिधी अनी तो मरणा तरी बी त्या ईश्वासनाद्वारा आत्ते बी बोलस.<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />मरणना अनुभव येवाले नको म्हणीसन ईश्वासतीन मरण न दखताच हनोखले देवनी वर उचली लिधं, तो सापडना नही कारण त्याले देवनी उचली लिधं, त्याना पहिले त्यानाबद्दल शास्त्र अस सांगस की, तो देवले खूश करे. <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />अनी ईश्वासशिवाय देवले खूश करनं अशक्य शे, कारण देवजोडे जाणारानी असा ईश्वास धराले पाहिजे, तो अस्तित्वमा शे अनी त्यानाकडे धाव लेणारासले तो प्रतिफळ देणारा शे.<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />जे आजपावत दखामा येल नव्हतं त्यानाबद्दल देवना सुचना नोहानी ऐकं अनी आदरतीन भय धरीसन आपला कुटुबंना उध्दारकरता ईश्वासतीन तारू तयार करं, त्या ईश्वासनाद्वारा त्यानी जगले दोषी ठरावं अनी ईश्वासनाद्वारा जी नितिमत्वना शे त्याना तो वारसदार व्हयना.<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />अब्राहामले पाचारण व्हवानंतर जे ठिकाण त्याले वतन म्हणीन मिळणार व्हतं तठे जावाकरता तो ईश्वासतीन तयार व्हयना अनी आपण कोणता देशमा जाई राहीनु हाई त्याले माहीत नव्हतं तरी तो निंघी गया. <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />ईश्वासतीन तो देवनी वचन देयल देशमा परकानामायक जाईसन राहीना, त्याच वचनना सोबती वारसदार इसहाक अनं याकोब यासनामायक तो तंबुमा राहीना. <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />कारण ज्याले पाया शे, ज्यानी आखनी अनी बांधनी करनारा देव शे, असा शहरनी अब्राहाम वाट दखी राहिंता.<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />ईश्वासतीन अब्राहाम जरी तो धल्ला व्हता अनी सारा वांज व्हती तरी त्या मायबाप व्हयनात, कारण देवनी त्याले वचन देयल व्हतं त्याले त्यानी ईश्वासयोग्य मानं. <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />त्यामुये एकपाईन अनी तो बी निर्जीव व्हयेल असापाईन, संख्यामा आकाशना तारासनामायक अनं समुद्रना काठवरली वाळूनामायक मोजता येवाव नही इतली संतती निर्माण व्हयनी. <verse eid="HEB 11:12" /><verse number="13" style="v" sid="HEB 11:13" />या सर्वा ईश्वास धरीसन मरणात, त्यासले वचनफळ मिळनं नव्हतं, तर त्यासनी ती दुरतीनच दखी अनं त्याले वंदन करं अनी आपण पृथ्वीवर परका अनं प्रवाशी शेतस अस सांगी दखाडं. <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />अस बोलनारा आपण स्वतःना देशना शोध करी राहीनुत अस दखाडतस. <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />जर त्यासनी ज्या देशले सोडं अनी त्या देशबद्दल त्या ईचार करत राहिनात नही जर ईचार करतस तर त्यासले परत जावाले संधी व्हती. <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />पण त्या अधिक चांगला देशनी म्हणजे स्वर्गीय देशनी आशा धरतस, यामुये देवले त्यासनी लाज वाटस नही, त्यासना देव म्हणाले तो लाजस नही, त्यानी त्यासनाकरता एक शहर तयार करी ठेयल शे.<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />अब्राहामनी आपली परिक्षामा ईश्वासतीन इसहाकनं अर्पण करं ते आपले माहीत शे. ज्यानी वचनं स्विकारेल व्हतात तो आपला एकुलता एक पोऱ्यानं अर्पण कराकरता तयार व्हयना. <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />देवनी त्याले अस सांगं व्हतं की, “इसहाकपाईन तुना नावना वंश चाली.” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />तवय इसहाकले मरेल मातीन बी जिवत कराले देव समर्थ शे, अस अब्राहामानी ध्यानमा लिधं अनी त्या परीस्थितीमा देव त्याले दृष्टांतना रूपमा परत भेटना.<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />इसहाकनी याकोबले अनं एसावले भावी गोष्टीसबद्दल ईश्वासतीन आशिर्वाद दिधात.<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />याकोबनी मराना येळले योसेफना प्रत्येक पोऱ्याले ईश्वासतीन आशिर्वाद दिधा अनी जी काठी धरीन तो चाले तीना टोकवर टेकीसन त्यानी देवनी उपासना करी.<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />योसेफनी मराना येळले इस्त्राएलना लोके मिसरमातीन बाहेर येतीन असं ईश्वासतीन सांगं अनं आपला अस्थीबद्दल काय करानं हाई आज्ञा करी.<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />मोशेना जन्म व्हयना तवय त्याना मायबापनी ईश्वासतीन त्याले तीन महिना दपाडी ठेवं. कारण ते बाळ सुंदर शे अस त्यासनी दखं, अनं त्यासले राजानी देयल आज्ञानं भय वाटनं नही.<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />मोशेनी प्रौढ व्हवानंतर स्वतःले फारोनी पोरना पोऱ्या म्हणनं हाई ईश्वासतीन नाकारी दिधं. <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />पापनं क्षणभरनं सुख भोगापेक्षा त्यानी देवना लोकससंगे दुःख भोगनं पसंद करं. <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />ख्रिस्तमुये अपमान सोसनं हाई मिसर देशना धनपेक्षा उत्तम संपत्ती शे अस त्यानी मानं, कारण त्यानी नजर भावी प्रतीफळवर व्हती.<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />मोशे राजाना क्रोधले भ्यायना नही अनी ईश्वासतीन मिसर देश सोडा, कारण जो अदुश्य शे त्याले जस तो दखी राहीना असा त्यानी धीर धरा. <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />त्यानी वल्हांडण सण अनं दरवाजासवर रक्त शिंपडनं या विधी ईश्वासतीन पाळ्यात, यानाकरता की मरणंना देवदूतनी इस्त्राएलसना पहिला जन्मलेलसले मारं नही.<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />जस कोरडी जमीनवर तसा इस्त्राएलना लोके ईश्वासतीन तांबडा समुद्रमातीन पार गयात, मिसरी लोकसनी तसच कराना प्रयत्न करा पण त्या बुडी गयात.<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />ईश्वासतीन यरीहोना गावकुसना आजुबाजू सात दिनपावत इस्त्राएल लोकसनी फेऱ्या माऱ्यात तवय ती भिंत पडनी. <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />ईश्वासतीन राहाब वेश्यानीं जासुसना स्विकार चांगला भावतीन करामुये तिना देवनी आज्ञा मोडणारासंगे नाश व्हयना नही.<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />आत्ते आखो काय सांगु? गिदोन, बाराक, शमशोन, इफताह, दावीद, शमुवेल अनं संदेष्टा यासनं वर्णन करू लागनु तर येळ पुराव नही. <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />त्यासनी ईश्वासतीन राज्य जिंकात, नितीमत्वनुसार वागनात, वचनसना स्विकार करा, सिंहसना तोंड बंद करात, <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />अग्नीनी शक्तीले शांत करी दिधं, त्या तलवारना धारपाईन वाचनात, त्या दुर्बळ व्हतात पण बलवान कराई गयात, लढाईमा पराक्रमी व्हयनात, त्यानी परकासना सैन्यसले पळाई लिधं. <verse eid="HEB 11:34" /><verse number="35" style="v" sid="HEB 11:35" />ईश्वासतीन बायासले त्यासना मरेल माणसे अनी नातेवाईक पुनरूत्थानघाई जिवत व्हयेल असा भेटनात, कितलातरी जणसनी आपले जास्तीनं चांगलं पुनरूत्थान मिळाले पाहिजे म्हणीसन सुटका न करी लेता मरणनामायक यातना सहन कऱ्यात. <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />अनी बाकीनासले टवाळकी, मारहाण यासना अनी बंधनं अनं कैद यासना बी अनुभव वना.<verse eid="HEB 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="HEB 11:37" />त्यासले दगडमार करा, करवतघाई चिरं, त्या तलवारना धारतीन मरणात, त्या मेंढरंसनी अनं बकरीसनी कातडी पांघरीन फिरी राहिनतात, त्या लाचार, पीडीत, त्रासेल अस व्हतात. <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />जग त्यासले योग्य नव्हतं, ते ओसाड प्रदेशमाईन, डोंगरसमाईन, गुहामातीन अनं भुमीना कपारीसमाईन भटकी राहिंतात.<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />या सर्वासबद्दल त्यासना ईश्वासतीन चांगली साक्ष देयल व्हती तरी बी त्यासले वचनफळ प्राप्त व्हयना नही. <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />देवनी जे उत्तम ते आपलाकरता पुर्वीच नेमीन ठेयल व्हतं. अनी त्याना उद्देश असा व्हता की आपलासंगेच त्यासनी पुर्ण व्हवाले पाहिजे.<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">देव आपला पिता</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />तर मंग आपण येवढा मोठला साक्षरूपी ढगसघाई इतला घेरायेल शेतस म्हणीसन आपण बी सर्व दडपण अनी सहज आपले गुंताई लेणारं पाप टाकीसन, तर या आपले नेमी देयल धावमा धीरतीन पळाले पाहिजे. <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />आपण आपला ईश्वासना उत्पन्नकर्ता अनी तो ईश्वास पुरा करणार येशु यानाकडे दखत ऱ्हावानं. त्यानापुढे जो आनंद ठेयल व्हता त्याले तुच्छ मानीसन क्रुसखांब सहन करा अनी तो देवना राजासनना उजवीकडे बठेल शे.<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />ज्यानी, आपला विरोधमा पाप करनारासनी करेल इतला विरोध सहन करा त्यानापाईन शिका, म्हणजे तुमना मने खचीसन धीर सुटाव नही. <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />तुम्हीन पापनासंगे संघर्ष करतांना मरापावत इतला प्रतिकार आजुनपावत करा नही. <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />जो बोध लेकरंसले कराले पाहिजे तसा तुमले करा तो तुम्हीन ईसरी गयात का,</para>
  <para style="q1" vid="HEB 12:5">“मना पोऱ्या, प्रभुनी शिस्तना अनादर करू नको,</para>
  <para style="q2" vid="HEB 12:5">अनी त्यानाकडतीन दोष पदरमा पडना तर तु खचु नको,<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />कारण ज्यानावर प्रभु प्रिती करस त्याले तो शिक्षा करस,</para>
  <para style="q2" vid="HEB 12:6">अनी ज्या पोऱ्यासले तो स्विकारस त्या प्रत्येकले फटका मारस.”<verse eid="HEB 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 12:7" />बापना शिस्तकरता तुम्हीन सहन करी राहिनात, देव पोऱ्यासंगे तसा तुमनासंगे वागस, ज्याले बाप शिक्षा करस नही असा कोण पोऱ्या शे? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />जर तुमले इतर पुत्रसनामायक शिक्षा व्हयनी नही तर त्याना अर्थ असा की तुम्हीन त्याना खरा पोऱ्या नहीत तर तुम्हीन दासीपुत्र मायक शेतस. <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />शिवाय शिक्षा करनारा असा शारिरीक बाप आपले व्हतात अनी आपण त्यासनी आस धरी, तर मंग आपण विशेष करीसन जो जिवत अनी आत्मिक पिता त्याना अधीन राहीसन जिवत ऱ्हावाले नको का! <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />कारण आपला शारिरीक बाप त्यासना मनले पटनं तशी थोडा दिन शिक्षा करी, पण देव जे करस ते आपला हितकरता, म्हणजे आपण त्याना पवित्रपणना भागीदार व्हवाले पाहिजे म्हणीसन करस. <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />कोणती बी शिक्षा लगेच आनंद देणारी वाटस नही, खेदनी वाटस, तरी ज्यासले तिना अभ्यास व्हयेल शे त्यासले ती पुढे न्यायीपणं हाई शांतीकारक फळ देस.<verse eid="HEB 12:11" /></para>
  <para style="s">बोध अनी इशारा</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />यामुये कमजोर हात उंच करा अनी लटपटणारा गुडघा बळकट करा, <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />अनी आपला पापसकरता सरळ वाटा करा यानाकरता की लंगडासना पाय निकामी व्हवाले नको तर उलटा त्या बरा व्हवाले पाहिजे. <verse eid="HEB 12:13" /><verse number="14" style="v" sid="HEB 12:14" />सर्वासंगे शांतीमा ऱ्हावानं अनी ज्यानाशिवाय प्रभुनं दर्शन व्हस नही त्यासनी पवित्रकरण मिळाडाना मांगे लागा. <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />देवनी कृपापाईन कोणीच दुर जावाले नको, कोणी कडूपणना मुळतीन उगीसन चुकीन्या गोष्टी कराले नको, अनं त्यामुये बराच जणसले विटाळ व्हई ते व्हवाले नको, <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />कोणी व्यभिचारी असाले नको, ज्यानी जेवणकरता आपलं जेष्ठपण ईकं त्या एसावनामायक कोणी ऐहीक बुध्दीना ऱ्हावाले नको, याकडे ध्यान द्या. <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />तुमले माहीत शे त्यानानंतर तो वारस हक्कतीन आशिर्वाद मियाडा करता ईच्छा करी राहींता पण त्याले परत रिकामा हात धाडामा वनं, त्यानी जरी अश्रु काढीसन बराच प्रयत्न करात तरी बापनं मन फिरावनं त्याले जमनं नही.<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />जसा इस्त्राएल लोकसनामायक तुम्हीन सिनाय पर्वतपावत वनात नही स्पर्शज्ञान अनं पेटेल अग्नी, गाड अंधार, घोर नैराष्य, वादय, <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />कर्णासना नाद अनं शब्दसना आवाज, यासनाजोडे तुम्हीन अजुन पावत वनात नही; ती वाणी ऐकणारासनी ईनंती करी की, तिनासंगे आमनं जास्त बोलनं व्हवाले नको, <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />कारण “जनावर बी डोंगरले शिवना म्हणजे त्यासले दगडसघाई मारानं” अशी जी आज्ञा ती त्यासनाघाई सहन व्हयनी नही. <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />अनी जे दिसनं ते ईतलं भयानक व्हतं की, मोशे बोलना, “मना भलताच घाबरीसन थरकाप व्हयेल शे!”<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />पण तुम्हीन सियोन डोंगर, सदाजिवत देवनं स्वर्गीय शहर यरूशलेम, लाखो देवदूत, <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />स्वर्ग माधला यादीमधला पहिला जन्मलेलसनी आनंदी मंडळी, सर्वासना न्यायाधीश देव, पुरा करेल न्यायी लोकसना आत्मा, <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />नवा करारना मध्यस्थी येशु, अनी शिंपडानं रक्त यानाजोडे येल शेतस, त्या रक्तनं बोलनं हाबेलना रक्तपेक्षा उत्तम गोष्टीसनं अभिवचन देस.<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />जो बोली राहीना त्याना अपमान व्हवाले नको म्हणीसन जपा, कारण पृथ्वीवर आज्ञा सांगणारासना अपमान करनारा जर टिकनात नहीत, तर स्वर्गमातीन आज्ञा सांगणारासना अपमान करनारा तुम्हीन अजिबातच टिकावुत नही. <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />त्या येळले त्यानी वाणीघाई पृथ्वी हालनी अनी आते त्यानाबद्दल त्यानी अस वचन देयल शे की, “आखो एकदाव मी नुसती पृथ्वी नही तर आकाश बी कंपनमाय करसु.” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />“आखो एकदाव” या शब्दसघाई असा बोध व्हस की, बनाडेल वस्तुसनामायक हालायेल वस्तु नष्ट व्हतीन अनी ज्या हालाई जावावुत नही त्या ऱ्हातीन.<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />आपण त्या देवना उपकार मानुत, कारण न हालणारं राज्य आमले भेटेल शे अनी देवले आवडी अशी जी सेवा सुभक्तीघाई अनी भय धरीसन करूत, <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />कारण आपला “देव भस्म करनारा अग्नी बी शे.”<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">देवले कसं आनंदीत करानं</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />ईश्वासु भाऊ अनी बहिणीसवन एकमेकसवर प्रिती करत राहा. <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />प्रेमतीन अनोळखीसना पाहूणचार करानं ध्यानमा ठेवा, कारण त्यामुये कितलातरी जणसनी देवदूतसना पाहूणचार न समजता करेल शे. <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />तुम्हीन कैदीसंगे कैदमा शेतस अस समजीन त्यासनी आठवण करा, आपण बी संकटमा शेतस अस समजीन ज्या पिडामा शेतस त्यासनी आठवण ठेवा.<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />लगीन सर्वासले मान्य असाले पाहिजे अनी नवरा अनी बायको यासनी एकमेकससंगे ईश्वासु ऱ्हावाले पाहिजे, जारकर्मी अनं व्यभिचारी यासले देव दंड करी.<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१३:५ </char>
      <char style="xt" closed="false">
        <ref loc="DEU 31:6">अनुवाद ३१:६</ref>
      </char>
    </note>तुमनी वागणुक पैसासना लोभवीना असाले पाहिजे, जोडे शे तितलामा तुम्हीन तृप्त असाले पाहिजे, कारण देवनी स्वतः म्हणेल शे, “मी तुले सोडाव नही अनं तुले टाकावं बी नही.” <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />यामुये आम्हीन हिम्मत धरीसन म्हणतस;</para>
  <para style="q1" vid="HEB 13:6">“परमेश्वर मना साहाय्यकर्ता शे, मी भिणार नही,</para>
  <para style="q1" vid="HEB 13:6">माणुस मनं काय करी?”<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />ज्या तुमना अधिकारी शेतस, ज्यासनी तुमले देवनं वचन सांगं, त्यानी आठवण करा, त्यासनी वागणुकना परिणाम ध्यानमा लिसन त्यासना ईश्वासनं अनुकरण करा. <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />येशु ख्रिस्त कालदिन, आज अनं युगानुयुग मायकच शे. <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />विचित्र अनं चुकीना शिक्षणघाई खरी वाटपाईन भटकी जावु नका, कारण जी विधी पाळणारासले लाभ व्हयना नही असा खावाना विधीसघाई नही, तर कृपाघाई मनले स्थिर करनं हाई चांगलं शे.<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />ज्या याजक यहूदी सभामंडपनी सेवा करतस त्यासले वेदीवरनं खावाणा काहीच अधिकार नही <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />ज्या जनावरनं रक्त पाप बद्दल यहूदी मुख्य याजकसना द्वारा परमपवित्र स्थानमा लई जातस त्यासना शरीर तळबाहेर जाळतस. <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />यामुये येशुनी बी आपला रक्तघाई लोकसले पवित्र करावं म्हणीसन शहरना बाहेर मरण सहन करा. <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />तर आते आपण त्याना अपमानमा सहभागी व्हवाकरता त्यानाजोडे तटना बाहेर जाऊत. <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />कारण आपले आठे कायमनं शहर नही, तर जे शहर व्हवाव शे त्यानी वाट आपण दखतस. <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />यावरतीन आपण येशु द्वारा देवले उपकार स्मरणरूपी यज्ञ निरंतर अर्पण करानं, हाऊ यज्ञ त्याना नावना स्विकार करनारासना ओठनं फळना मायक शे. <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />इतरसले दानधर्म करानं ईसरू नका, कारण असा यज्ञ देवले आवडतस.<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />तुम्हीन आपला अधिकारीसना आज्ञामा ऱ्हावा अनी त्यासनासंगे ईमानदारीमा ऱ्हा, कारण आपले हिशोब देना शे अस समजीसन त्या तुमना जीवकरता जागृत राहतस, तुम्हीन त्यासन्या आज्ञा पाळ्यात तर त्या त्यासनं काम खूशीतीन करतीन जर नही पाळ्यात तर त्या आपले काम दुःखतीन करतीन, अनी त्याना तुमले काहीच फायदा व्हवावु नही. <verse eid="HEB 13:17" /><verse number="18" style="v" sid="HEB 13:18" />आमनाकरता प्रार्थना करत रहा. आमले खात्री शे की, शुध्द मनतीन चांगलं ते आम्हीन कायम करत राहसुत. <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />मी तुमले परत लवकरच भेटाले पाहिजे म्हणीसन कळकळीनी प्रार्थना करानी मी तुमले विशेष ईनंती करस.<verse eid="HEB 13:19" /></para>
  <para style="s">शेवटनी प्रार्थना</para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />आते ज्या शांतीना देवनी सर्वकाळना करारना रक्तघाई मेंढरसना महान मेंढपाळ आपला प्रभु येशु, याले मरेलस मातीन माघारे परत आणं. <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />तो देव आपली नजरतीन जे आवडस ते आपलामा येशु ख्रिस्तनाद्वारा करो अनी आपली ईच्छानुसार वागाकरता तुमले प्रत्येक काममा सिध्द करो, ख्रिस्तना युगानुयुग गौरव असो. आमेन.<verse eid="HEB 13:21" /></para>
  <para style="s">शेवटला शब्द</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />भाऊ अनी बहिणीसवन, तुमले ईनंती करस की, हाई बोधवचन शांततातीन सहन करा, कारण मी थोडासा लिखेल शे. <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />आपला ईश्वासु बंधु तीमथ्य यानी सुटका व्हयेल शे हाई तुमले कळाले पाहिजे, तो लवकर वना तर त्याले संगे लिसन मी तुमले भेटाले येस.<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />तुम्हीन आपला सर्व अधिकारीसले अनं सर्व पवित्र जणसले आमना सलाम सांगा, इटलीना भाऊ अनं बहिणी त्यासना सलाम तुमले सांगतस,<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />देवनी कृपा तुमनासंगे राहो, आमेन.<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>