<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Ahirani</book>
  <para style="h">प्रकटीकरण</para>
  <para style="toc3">प्रकटीकरण</para>
  <para style="toc2">प्रकटीकरण</para>
  <para style="toc1">योहानले व्हयेल प्रकटीकरण</para>
  <para style="mt2">योहानाला झालेले प्रकटीकरण</para>
  <para style="mt1">योहानले व्हयेल प्रकटीकरण</para>
  <para style="imt">वळख</para>
  <para style="ip">प्रकटीकरण हाई पुस्तक नवं करारमधलं शेवटलं पुस्तक शे. तसच हाई शेवट लिखामं वनं प्रेषित योहाननी येशु ख्रिस्तना जन्मानानंतर इसवी. ९५ ना जोडेजोडे ते लिखामा वनं. <char style="xt"><ref loc="JHN 1:1">योहान १:१</ref></char> अनी त्यानीच योहानकृत शुभवर्तमान अनी योहाननी पहिलं, दुसरं अनी तीसरं पत्र लिखं. हाऊच योहानाले लोकं “ज्यानावर येशुनी प्रिती व्हती” अस म्हणीसन वळखी राहिंतात. <char style="xt"><ref loc="JHN 13:23">योहान १३:२३</ref> </char> येशु ख्रिस्तना सुवार्तामुये पात्म नावना बेटवर जवय शिक्षा भोगी राहिंता त्या येळले त्यानी हाई पुस्तक लिखं. <char style="xt"><ref loc="REV 1:9">प्रकटीकरण १:९</ref></char></para>
  <para style="ip">हाई पुस्तक लिखाणामांगे योहानना हाऊ उद्देश व्हता की, मना वाचनारासले येशुनासंगे ईश्वासु रावाकरता प्रोत्साहन देवाणं अनी येशुना परत येवानं जोडे ऱ्हावामुये त्यासनामा आशा निर्माण करानी <char style="xt"><ref loc="JHN 1:3">योहान १:३</ref></char>;<char style="xt"><ref loc="REV 22:7">२२:७</ref></char> त्यानी सर्वा ईश्वासनारासले हाई पत्र लिखं पन विशेष करीसन त्या सात मंडळीसले लिखं ज्यासना उल्लेख अध्याय <char style="xt"><ref loc="REV 2-3">२–३</ref></char> मा दखास. योहान स्वतःना लिखाणले देवना जोडेतीन येल संदेश, भविष्यवाणी म्हणीसन सांगस अनी ज्या गोष्टी त्यानी स्वतः दख्यात त्या गोष्टीसन वर्णन तो अलंकारी भाषामा मांडस. हाई जे पुस्तक शे हाई जुना करारमातीन काही शास्त्रभागसले मिळतं जुळतं शे, विशेष करीसन. <char style="xt"><ref loc="ZEC 6:1-8">जखर्या ६:१-८</ref> </char> हाई वचनासंगे त्यानं साम्य शे, तसच सात तुताऱ्या अनी सात वाट्या ह्या देवनी मिसर देशमा आणेल पिढा यानासारख्या शेतस, <char style="xt"><ref loc="EXO 7-9">निर्गम ७–९</ref></char> प्रकटीकरण हाई शेवटना दिनना वर्णन करस. शेवटमा येशु विजयी कशा व्हई अनी त्यानावर ईश्वास ठेवनारा त्यानासोबत सर्वाकाळ कशा जिवत राहतीन अस ते सांगस. हाई पुस्तकनाद्वारा तुमले ताकिद मिळो अनी येशुना परत येवाविषयी तुमले आशा मिळो.</para>
  <para style="iot">रूपरेषा</para>
  <para style="io1">१. योहान सुरवातले स्वतःनी वळख करीसन त्याले भविष्यवाणी कशी प्राप्त व्हयनी हाई सांगीसन तो सुरवात करस. <char style="ior"><ref loc="REV 1:1-20">प्रकटीकरण १:१-२०</ref> </char></para>
  <para style="io1">२. येशुपाईन सात मंडळीसले प्रत्यक्ष मिळेल संदेश योहान देस. प्रकटीकरण <char style="ior"><ref loc="REV 2:1-3:22">२:१–३:२२</ref></char></para>
  <para style="io1">३. नंतर तो सात शिक्कासना उल्लेख करस. <char style="ior"><ref loc="REV 4:1-8:5">प्रकटीकरण ४:१–८:५</ref></char> अनी सात तुतारीसना वर्णन करस. <char style="ior"><ref loc="REV 8:6-11:19">प्रकटीकरण ८:६–११:१९</ref></char></para>
  <para style="io1">४. यानानंतर योहान एक धाकला पोऱ्या सात डोकासना श्वापदनासंगे कसं लढाई करस हाई सांगस. <char style="ior"><ref loc="REV 12:1-14:20">प्रकटीकरण १२:१–१४:२०</ref> </char></para>
  <para style="io1">५. यानानंतर योहान सात क्रोधना वाट्यासबद्दल लिखस <char style="ior"><ref loc="REV 15:1-16:18">प्रकटीकरण १५:१–१६:१८</ref> </char></para>
  <para style="io1">६. यानानंतर देव त्याना आकाशमाधला शत्रुवर कश विजय मियाडस हाई सांगस. <char style="ior"><ref loc="REV 17:1-20:15">प्रकटीकरण १७:१–२०:१५</ref> </char></para>
  <para style="io1">७. जो नवा स्वर्ग अनी जी नवी पृथ्वी शेवट ई तिनं वर्णन करस <char style="ior"><ref loc="REV 21:1-22:21">प्रकटीकरण २१:१–२२:२१</ref> </char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="s">नमस्कार</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />येशु ख्रिस्तनं प्रकटीकरण जे त्याले देवनी दिधं. अनी ज्या गोष्टी लवकर घडाले पाहिजेत त्या आपला दाससले दखाडाकरता हाई व्हयनं, अनी ख्रिस्तनी दूत धाडीसन आपला दास योहान याले हाई माहिती दिधी. <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />योहाननी देवना वचनबद्दल अनं येशु ख्रिस्तनी साक्षबद्दल म्हणजे त्यानी जे जे दखं त्यानाबद्दल साक्ष दिधी. <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />ह्या संदेशना शब्द वाचीन दखाडणारा, अनं भविष्यवाणी त्या ऐकणारा अनं त्यामा लिखेल गोष्टी पाळणारा ह्या धन्य; कारण ह्या गोष्टी घडी येवानी येळ जोडे येल शे.<verse eid="REV 1:3" /></para>
  <para style="s">सात मंडळीसले नमस्कार</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:४ </char>
      <char style="xt" closed="false">
        <ref loc="REV 4:5">प्रकटीकरण ४:५</ref>
      </char>
    </note>आशिया प्रांतमाधल्या सात मंडळीसले योहान कडतीन;</para>
  <para style="p" vid="REV 1:4">त्या देवकडतीन जो शे, जो व्हता अनं जो ई त्यानापाईन त्याना राजासन समोर ज्या सात आत्मा शेतस त्यासनापाईन, <verse eid="REV 1:4" /><verse number="5" style="v" sid="REV 1:5" />अनी ईश्वसनीय साक्षी, मरेलस मातीन पहिला जन्मेल अनं पृथ्वीवरला राजासना अधिपती. येशु ख्रिस्त यानापाईन, तुमले कृपा अनं शांती असो.</para>
  <para style="p" vid="REV 1:5">जो आपलावर प्रेम करस, ज्यानी आपला रक्तघाई तुमले आमले पापसपाईन मुक्त करं <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" /><note caller="+" style="x"><char style="xo" closed="false">१:६ </char><char style="xt" closed="false"><ref loc="REV 5:10">प्रकटीकरण ५:१०</ref></char></note>अनी आपलाले राज्य अनी आपला देव अनं पिता याना सेवा करता याजकं अस करं. त्या येशु ख्रिस्तले गौरव अनं पराक्रम ह्या युगानुयुग शेतस! आमेन.<verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:७ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">मत्तय २४:३०</ref>; <ref loc="MRK 13:26">मार्क १३:२६</ref>; <ref loc="LUK 21:27">लूक २१:२७</ref>; <ref loc="1TH 4:17">१ थेस्सलनी ४:१७</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:34">योहान १९:३४</ref>,<ref loc="JHN 19:37">३७</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">मत्तय २४:३०</ref>
      </char>
    </note>दखा, तो ढगससंगे ई! प्रत्येक डोया त्याले दखी, ज्यासनी त्याले भोसकं त्या बी दखतीन अनी पृथ्वीवरला सर्वा लोके त्यानामुये छाती ठोकीसन शोक करतीन, असंच व्हई. <verse eid="REV 1:7" /><verse number="8" style="v" sid="REV 1:8" /><note caller="+" style="x"><char style="xo" closed="false">१:८ </char><char style="xt" closed="false"><ref loc="REV 22:13">प्रकटीकरण २२:१३</ref></char></note>प्रभु जो देव शे, जो व्हता अनं जो ई, जो सर्वसमर्थ, तो म्हणस, “मी पहिला अनं शेवटला शे.”<verse eid="REV 1:8" /></para>
  <para style="s">ख्रिस्तनं साक्षात्कार</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />मी योहान, जो तुमना भाऊ अनी येशुमाधला क्लेश, राज्य अनं धीर यासना तुमनासंगे भागीदार शे, तो मी देवनं वचन अनं येशुबद्दलनी साक्ष यानामुये पात्म नावना बेटमा व्हतु. <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />प्रभुना दिनले मी आत्मातीन संचरीत व्हयनु, तवय मी आपलामांगे कर्णाना आवाजमायक मोठा आवाज ऐका. <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />तो बोलना, “तुले जे दखास ते पुस्तकमा लिख अनी ते इफिस, स्मुर्णा, पर्गम, थुवतीरा, सार्दीस, फिलादेलफिया अनं लावदिकीया या शहरसमाधल्या सात मंडळीसकडे धाड.” <figure style="fig" alt="Map of seven churches in Asia" file="hk00378c.tif" size="col" copy="Horace Knowles ©" ref="१:११">आशियामाधल्या सात मंडळ्यासना नकाशा</figure><verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />मनासंगे बोलणारा आवाज कोणा शे हाई दखाले मी मांगे वळनु, मांगे वळीन दखस तर सोनाना सात समई <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />अनी त्या समईसना मध्यभागले मनुष्यना पोऱ्यानामायक, पायघोळ कपडा घालेल, अनी छातीवरतीन सोनाना पट्टा बांधेल, असा कोणी एक माले दखायना. <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />त्यानं डोकं अनं केस बरफनामायक किंवा कापुसनामायक धवळं व्हतं; त्याना डोया आगना ज्वालानामायक चमकदार व्हतात; <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />त्याना पाय जशा काय भट्टीमातीन काढेल जळजळीत सोनपितळनामायक व्हतात अनी त्याना आवाज अनेक जलप्रवाहना ध्वनीनामायक व्हता. <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />त्याना उजवा हातमा सात तारा व्हतात; त्याना तोंडमातीन तीक्ष्ण दुधारी तलवार निंघनी अनी त्याना चेहरा भर दुपारमा चमकणारा सूर्यनामायक व्हता. <verse eid="REV 1:16" /><verse number="17" style="v" sid="REV 1:17" /><note caller="+" style="x"><char style="xo" closed="false">१:१७ </char><char style="xt" closed="false"><ref loc="REV 2:8">प्रकटीकरण २:८</ref>; <ref loc="REV 22:13">२२:१३</ref></char></note>मी त्याले दखं तवय मी मरेलना मायक त्याना पायजोडे पडनु. मंग त्यानी आपला उजवा हात मनावर ठेईन माले सांगं, भिऊ नको; मी पहिला अनं शेवटला शे, <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />अनी जो जिवत तो मी शे! मी मरेल व्हतु तरी दखा मी युगानुयुग जिवत शे, अनी मरणन्या अनं अधोलोकन्या किल्ल्या मनाजोडे शेतस. <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />म्हणीन जे तु दखं, जे शे अनं यानानंतर जे व्हई ते लिखी ठेव; <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />ज्या सात तारा तु मना उजवा हातमा दखात त्यासनं, अनी सोनाना त्या सात समईसना रहस्य हाई शे; त्या सात तारा ह्या सात मंडळ्यासना दूत शेतस; अनी सात समई या सात मंडळ्या शेतस.<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">इफिसना मंडळीला संदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />इफिस माधली मंडळीना देवदूतले लिख; जो आपला हातमा सात तारा धरस, जो सोनाना समईसमातीन चालस, त्यानाकडतीन हाऊ संदेश. <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />तुना कृत्य, कष्ट अनं तुना धीर ह्या माले माहित शेतस; तुले दुर्जन सहन व्हतस नही, ज्या प्रेषित नव्हतात तरी आम्हीन प्रेषित शेतस अस म्हणतस त्यासनी परिक्षा तु करी; अनी त्या लबाड शेतस अस तुले दखायनं. <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />तुनामा धीर शे मनामुये तु दुःख सहन करेल शे अनी तु खचना नही. <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" />तरी तु मनावरली आपली पहिली प्रिती सोडी यानाबद्दल तुले दोष देणं माले प्राप्त व्हयनं. <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />तु कोठेन पडेल शे यानी आठवण कर अनं पश्चाताप करीसन आपला पहिला कृत्य कर; नही तर मी तुनाकडे येसु, अनी तु पश्चाताप नही करा तर तुनी समई तिना ठिकाणवरतीन काढी. <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />तरी पण तुनामा विशेष हाई शे की, निकलाइता<note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="fq" closed="false">निकलाइता </char><char style="ft" closed="false">निकलाइत नावना माणुसना अनुयायी, मनुष्यना अनैतीक वागणुक त्याना आत्माले प्रभावीत करस नही अस या लोकसनं म्हणनं शे. </char></note>सना कृत्यसना व्देष तु करस; त्यासना मी बी व्देष करस. <verse eid="REV 2:6" /><verse number="7" style="v" sid="REV 2:7" /><note caller="+" style="x"><char style="xo" closed="false">२:७ </char><char style="xt" closed="false"><ref loc="REV 22:2">प्रकटीकरण २२:२</ref></char></note>आत्मा मंडळीले काय म्हणस हाई ज्याले कान शे तो ऐको, जो विजय मिळवस, देवना बागमा जे जिवननं झाड शे, त्यावरनं फळ खावाना अधिकार मी दिसु.<verse eid="REV 2:7" /></para>
  <para style="s">स्मुर्णाना मंडळीले संदेश</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२:८ </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:17">प्रकटीकरण १:१७</ref>; <ref loc="REV 22:13">२२:१३</ref></char>
    </note>स्मुर्णा माधली मंडळीना देवदूतले लिख; जो पहिला अनं शेवटला, जो मरेल व्हता अनं परत जिवत व्हयना, तो अस म्हणस. <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />तुनं संकट अनं तुनं दारीद्र्य माले माहित शे, तरी तू धनवान शे; अनी ज्या यहूदी नहीत पण स्वतःले यहूदी म्हणतस अनं असा लोकसनं निंदायुक्त भाषण बी माले माहित शे, फक्त सैताननी सभा शे. <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />तुले सहन करानी ज्या संकट शेतस त्यासनं भय धरू नको; दख, तुम्हीन “मोहमा पडानं” म्हणीन सैतान तुमनापैकी कित्येकसले कैदखानामा टाकणार शे; अनी तुम्हीन “दहा दिन” संकटमा राहशात. तुले मरणं पडणं तरी ईश्वासु रहा, म्हणजे मी तुले बक्षिस म्हणीसन जिवन दिसु. <verse eid="REV 2:10" /><verse number="11" style="v" sid="REV 2:11" /><note caller="+" style="x"><char style="xo" closed="false">२:११ </char><char style="xt" closed="false"><ref loc="REV 20:14">प्रकटीकरण २०:१४</ref>; <ref loc="REV 21:8">२१:८</ref></char></note>“जर तुमले कान शेतस तर आत्मा मंडळीसले काय म्हणस हाई ऐका; जो विजय मिळावस त्याले दुसरा मरणनी बाधा व्हवाव नही.”<verse eid="REV 2:11" /></para>
  <para style="s">पर्गमना मंडळीले संदेश</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />पर्गम माधली मंडळीना देवदूतले लिख; ज्यानाजोडे तीक्ष्ण दुधारी तलवार शे तो अस म्हणस; <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />तु कोठे ऱ्हास हाई माले माहित शे, सैताननं आसन तठे शे; तु मनं नाव दृढ धरी राहेल शे, अनी मना साक्षी, मना ईश्वासु अंतिपाले, तुमनामा म्हणजे सैतान ऱ्हास तठे मारी टाकं, त्याना दिनसमा बी तु मनावरला ईश्वास सोडा नही. <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" />तथापि माले तुले थोड्या गोष्टीसबद्दल दोष देणं शे; ते हाई की तठे तुमनामा बलाम<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="fq" closed="false">बलाम </char><char style="ft" closed="false">बलाम हाऊ संदेष्टा व्हता (गणना 22:23:24)</char></note>नं शिक्षण खरं मानीन राहणारा लोकं शेतस; त्यानी बालाका<note caller="+" style="f"><char style="fr" closed="false">2:14 </char><char style="fq" closed="false">बालाका </char><char style="ft" closed="false">बलाक मवाबना राजा व्हता (गणना 22:4)</char></note>ले इस्त्राएलना संतानपुढे, मुर्तिले अर्पण करेल खावाले अनं व्यभिचार करनं, हाई आडफाटा ठेवाले शिकाडं. <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />त्याप्रमाणे तुनाजोडे निकलाइतासनं तसच प्रकारनं शिक्षण खरं मानीन राहणारा बी लोक शेतस. <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />यामुये पश्चाताप कर, नही तर मी तुनाकडे लवकरच ईसन आपला तोंडमाधली तलवारतीन त्यासनासंगे भांडसु. <verse eid="REV 2:16" /><verse number="17" style="v" sid="REV 2:17" /><note caller="+" style="x"><char style="xo" closed="false">२:१७ </char><char style="xt" closed="false"><ref loc="JHN 6:48-50">योहान ६:४८-५०</ref></char></note>आत्मा मंडळीले काय म्हणस हाई ज्याले कान शे तो ऐको. जो विजय मिळावस त्याले गुप्त “ठेयल मान्नामातीन मी दिसु.” अनी त्याले मी पांढरा खडा दिसु; त्या खडावर “नवं नाव” लिखेल शे, ते तो खडा लेणाराशिवाय कोणलेच माहित नही.<verse eid="REV 2:17" /></para>
  <para style="s">थुवतीराना ख्रिस्ती मंडळीले संदेश</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />थुवतीरा माधली मंडळीना देवदूतले लिख; ज्याना डोया आगना ज्वालानामायक शेतस अनी ज्याना पाय सोनपितळनामायक चमकदार शेतस, असा देवना पोऱ्या म्हणस; <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />तुना कृत्य, प्रिती, ईश्वास, सेवा अनं तुना धीर हाई माले माहित शेतस; अनी तुना आत्तेना कृत्य पहिला कृत्यसपेक्षा जास्त शेतस, हाई बी माले माहित शे. <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" />तरी माले तुले दोष देणं शे, तो असा की जी ईजबेल नावनी बाई स्वतःले देवनी संदेष्टी म्हणस, अनी जारकर्म कराले अनं मुर्तिले अर्पण करेल खावाले मना दाससले शिकाडीन फसाडस, तिले तू तसं करू देस. <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />तिनी पश्चाताप कराले पाहिजे, म्हणून मी येळ दिधा, तरी आपला जारकर्मसबद्दल पश्चात्ताप करानी तिले ईच्छा नही. <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />दखा, मी तिले अंथरूणवर पडेल अशी करसु, अनी त्यासनी तिनासंगे करेल दुष्ट कृत्यसबद्दल पश्चाताप करा नही तर त्यासले मोठा संकटमा पाडसु. <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />मी तीना मांगे चालणारासले मारी टाकसु, म्हणजे सर्व मंडळीसले कळी की, “ईचार अनं ईच्छा यासनी पारख करनारा” मी शे; अनी तुमले “प्रत्येकले तुमना कृत्यसनामायक” प्रतिफळ दिसु. <verse eid="REV 2:23" /><verse number="24" style="v" sid="REV 2:24" />पण थुवतीरा आठला बाकीना ज्या तुम्हीन त्या शिक्षणप्रमाणे चालणारा नहीत, ज्यासले सैतानना खोल म्हणेल गोष्टी शिक्यात नहीत त्या तुमले मी सांगस की, मी तुमनावर दुसरा भार घालाव नही; <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />पण जे तुमनं शे ते मी येवापावत दृढ धरी रहा. <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" />जो विजय मिळावस अनं शेवटपावत मनी कृत्य करत ऱ्हास त्यासले, जसा अधिकार माले पितापाईन मिळना तसं मी राष्ट्रसवर देईन. <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />अनी जसा मातीना भांडासना चुराडा करतस तसा तो लोहदंडतीन त्यासनावर अधिकार करी. <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />मी त्याले पहाटना तारा दिसु. <verse eid="REV 2:28" /><verse number="29" style="v" sid="REV 2:29" />“आत्मा मंडळीसले काय म्हणस हाई तुले कान शे, तर ऐक.”<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">सार्दीसना मंडळीले संदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />सार्दीस माधली मंडळीना देवदूतले लिख,</para>
  <para style="p" vid="REV 3:1">“ज्यानाजोडे देवना सात आत्मा शेतस अनं सात तारा शेतस तो अस म्हणस.” तुनी कृत्य माले माहित शेतस; तू जिवत शे अस तुले नाव शे, तरी तु मरेल शे हाई माले माहित शे! <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />जागृत हो, अनी ज्या गोष्टी मरननी वाटवर शेतस त्यासले स्थिर कर; कारण तुनी कृत्य मना देवना दृष्टीतीन पूर्ण अशी माले दिसनी नहीत. <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" /><note caller="+" style="x"><char style="xo" closed="false">३:३ </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्तय २४:४३</ref>,<ref loc="MAT 24:44">४४</ref>; <ref loc="LUK 12:39">लूक १२:३९</ref>,<ref loc="LUK 12:40">४०</ref>; <ref loc="REV 16:15">प्रकटीकरण १६:१५</ref></char></note>यामुये तू कसं लिधं अनं ऐकं यानी आठवण कर; ते राखी ठेव अनं पापसपाईन फिर; कारण तू जागृत नही व्हयना तर, जसा चोर येस तसा मी येसु; मी कोणता येळले तुनावर येसु हाई तुले कळाव नही. <verse eid="REV 3:3" /><verse number="4" style="v" sid="REV 3:4" />तरी ज्यासनी आपला कपडा विटाळात नही, असा थोडाच नावं सार्दीस आठे तुनाजोडे शेतस; तुम्हीन शुभ्र कपडा परीधान करीसन मनासंगे फिरतीन, कारण तुम्हीन लायक शेतस. <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" /><note caller="+" style="x"><char style="xo" closed="false">३:५ </char><char style="xt" closed="false"><ref loc="REV 20:12">प्रकटीकरण २०:१२</ref>; </char><char style="xt" closed="false"><ref loc="MAT 10:32">मत्तय १०:३२</ref>; <ref loc="LUK 12:8">लूक १२:८</ref></char></note>ज्या विजय मिळावतस त्या असा पध्दततीन शुभ्र कपडा घालेल व्हतीन; मी जिवनी पुस्तकमाधलं त्यासनं नाव खोडावुच नही, अनी मना पितासमोर अनं त्याना दूतसमोर मी त्यासनं नाव उघडपणतीन जाहीर करसु. <verse eid="REV 3:5" /><verse number="6" style="v" sid="REV 3:6" />आत्मा मंडळीसले काय म्हणस हाई ज्याले कान शे तो ऐको.<verse eid="REV 3:6" /></para>
  <para style="s">फिलादेलफियाना मंडळीले संदेश</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />फिलादेलफिया माधली मंडळीना देवदूतले लिख; जो पवित्र अनं सत्य शे ज्यानाजोडे दावीदनी किल्ली शे, जो दरवाजा तो उघडस अनी कोणी बंद कराव नही, अनी जो दरवाजा तो बंद करस अनी कोणी उघडस नही, तो अस म्हणस. <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />तुना कृत्य माले माहित शेतस दख, मी तुनापुढे दार उघडी देयल शे, ते कोणकडतीन बंद व्हस नही; तुले थोडी ताकद शे, तरी तू ईश्वासतीन मना वचनले पाळात अनं मना नावले नाकारा नही, हाई माले माहित शे. <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />दखा, ज्या सैतानना सभाना राहिन आपलाले यहूदी म्हणतस, पण त्या यहूदी नहीत, त्या खोटं बोलतस; त्यासनापैकी काही तुले दिसु; दखा, त्या ईसन तुना पायसजोडे नमन करतीन अनं मी तुनावर प्रिती करेल शे हाई समजी लेतीन, अस मी करसु. <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />कारण तु मनं धीरनं वचन राखेल शे म्हणीन पृथ्वीवर राहणारा लोकसनी परिक्षा व्हवाणा जो सर्व जगवर परिक्षा प्रसंग येणार शे त्या परिक्षा प्रसंगपाईन मी बी तुले सांभाळसु. <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />मी लवकर येस; कोणी तुना विजयना बक्षिस लेवाले नको म्हणीन जे तुनं शे पक्क धरी ठेव. <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" /><note caller="+" style="x"><char style="xo" closed="false">३:१२ </char><char style="xt" closed="false"><ref loc="REV 21:2">प्रकटीकरण २१:२</ref></char></note>ज्या विजय मिळावतस त्यासले मी आपला देवना मंदिर माधला स्तंभ करसु; त्या तठेन कधीच बाहेर जावावु नही; त्यासनावर मना देवनं नाव, स्वर्गमातीन मना देवपाईन उतरनारं नवं यरूशलेम, मना देवनं नगर, यानं नाव; अनी मनं नवं नाव त्यासनावर लिखसु. <verse eid="REV 3:12" /><verse number="13" style="v" sid="REV 3:13" />जर तुमले कान शेतस तर आत्मा मंडळीसले काय म्हणस हाई ऐका.<verse eid="REV 3:13" /></para>
  <para style="s">लावदिकीयाना मंडळीले संदेश</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />लावदिकीया माधली मंडळीना देवदूतले लिख;</para>
  <para style="p" vid="REV 3:14">जो आमेन, जो ईश्वसनीय अनं खरा साक्षी, जो देवना सृष्टीना शासक तो अस म्हणस. <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />तुना कृत्य माले माहित शेतस; तु थंड नही अनं गरम नही. तू थंड किंवा गरम राहता तर बरा व्हतं; <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />पण तू तसा नही, कोमट शे; म्हणजे गरम नही, थंड नही, म्हणीन मी तुले मना तोंडमातीन वकी टाकणार शे. <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />मी श्रीमंत शे, मी धन मिळायेल शे, अनं माले काही कमी नही अस तु म्हणस; पण तू कष्टी, दीन, दरीद्री, आंधया अनं उघडावाघडा शे, हाई तुले कळस नही. <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />म्हणीन मी तुले सल्ला देस की, श्रीमंत व्हवाकरता तू आगघाई शुध्द करेल सोनं मनापाईन ईकत ले; तुनी लज्जास्पद नग्नता दिसाले नको म्हणीन घालाले शुभ्र कपडा ईकत ले; अनी तुले दृष्टी येवाले पाहिजे म्हणीन डोयामा टाकाले अंजन ईकत ले. <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" /><note caller="+" style="x"><char style="xo" closed="false">३:१९ </char><char style="xt" closed="false"><ref loc="HEB 12:6">इब्री १२:६</ref></char></note>जितलासवर मी प्रेम करस तितलासना निषेध करीसन त्यासले शिक्षा करस; म्हणीन आस्था बाळग अनी पश्चाताप कर. <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />दखा, मी दारमा उभा शे अनं दार ठोकी राहिनु; जर कोणी मना आवाज ऐकीन दार उघडी, तर मी त्यानाजोडे मझार जासु अनं त्यानासंगे जेवसु, अनी तो मनासंगे जेवण करी. <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" />मी जसा विजय मिळाईन आपला पितासंगे त्याना राजासनवर बसनु, तसा जो विजय मिळावस त्याले मी आपला राजासनवर आपलासंगे बसु दिसु.<verse eid="REV 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22" />जर तुमले कान शेतस तर आत्मा मंडळीसले काय म्हणस हाई ऐका.<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">स्वर्गमा आराधना</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />यानंतर मी दखं, स्वर्गमा एक दार उघडेल माले दखायनं अनी जो आवाज मी पहिले ऐकेल व्हता तो मनासंगे बोलणारा कर्णाना आवाजमायक व्हता; तो बोलणा, “इकडे वर ये, म्हणजे ज्या गोष्टी यानंतर घडी येवाले पाहिजे त्या मी तुले दखाडसु” <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />लगेच आत्मानी मना ताबा लिधा. मी दखं, स्वर्गमा राजासन ठेयल व्हतं, अनी त्या राजासनवर कोणतरी बशेल व्हतं. <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />जो बशेल व्हता तो दिसाले यास्फे अनं सार्दि ह्या रत्नसनामायक व्हता. राजासनना आजुबाजूले दिसाले पाचे<note caller="+" style="f"><char style="fr" closed="false">4:3 </char><char style="fq" closed="false">पाचे </char><char style="ft" closed="false">पाचे हाई एक रत्ननं नाव शे.</char></note>ना मायक इंद्रधनुष्य व्हतात; <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />राजासनना आजुबाजूले चोवीस आसन व्हतात; अनी त्या आसनसवर शुभ्र कपडा घालेल अनं डोकावर सोनाना मुकुट घालेल चोवीस वडील लोक बशेल व्हतात; <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" /><note caller="+" style="x"><char style="xo" closed="false">४:५ </char><char style="xt" closed="false"><ref loc="REV 8:5">प्रकटीकरण ८:५</ref>; <ref loc="REV 11:19">११:१९</ref>; <ref loc="REV 16:18">१६:१८</ref>; </char><char style="xt" closed="false"><ref loc="REV 1:4">प्रकटीकरण १:४</ref></char></note>राजासनमातीन ईजा, आवाज अनं मेघगर्जना निंघी राहिंतात; पेटेल सात मशाली राजासनपुढे जळी राहिंत्यात; त्या देवना सात आत्मा शेतस. <verse eid="REV 4:5" /><verse number="6" style="v" sid="REV 4:6" />राजासनपुढे स्फटिकनामायक जशा काय काचना समुद्र व्हता; अनी राजासनना मध्यभागले अनं राजासनना चार बाजुले, पुढे अनं मांगे डोयासनी भरेल चार जिवत प्राणी व्हतात. <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />पहिला प्राणी सिंहनामायक, दुसरा बैलनामायक, तिसरा माणुसना तोंडनामायक, अनं चौथा प्राणी उडणारा गरूडनामायक व्हता. <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />त्या चारी बी प्राणीसले प्रत्येकी सहा, सहा, पंख व्हतात त्या प्राणी मांगतीन अनं पुढतीन पुरा डोयासनी भरेल व्हतात, अनी, “पवित्र, पवित्र, पवित्र, जो व्हता, जो शे, अनं जो येणार शे तो सर्वसमर्थ प्रभु देव” असा त्या रातदिन म्हणतस, त्या कधीच थांबतस नही. <verse eid="REV 4:8" /><verse number="9" style="v" sid="REV 4:9" />राजासनवर बशेल जो युगानुयुग जिवत शे त्याना जवय जवय त्या प्राणी गौरव, सन्मान अनं उपकारस्तुती करतस, <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />तवय त्या चोवीस वडील लोक राजासनवर जो बशेल त्यानापुढं गुडघा टेकतस; जो युगानुयुग जिवत त्यानी आराधना करतस; अनी आपलं मुकुट राजासनपुढे ठिसन म्हणतस,<verse eid="REV 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 4:11" />“हे प्रभु, आमना देव, गौरव, सन्मान अनं सामर्थ्य यासना स्विकार कराले तु योग्य शे; कारण तु सर्वकाही निर्माण करं, तुना ईच्छातीन त्यासले जिवन अनं अस्तित्व वनं.”<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">कोकरा अनी गुंडाळी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />जो राजासनवर बशेल व्हता त्याना उजवा हातमा पाठपोट लिखेल अनं सात शिक्का मारीन बंद करेल पुस्तकनी एक गुंडाळी मी दखी; <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />अनी “गुंडाळी वरना शिक्का फोडीन ती उघडाले कोण योग्य शे?” अस जोरमा पुकारणारा एक ताकदवान देवदूत मी दखा. <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />तवय स्वर्गमा, पृथ्वीवर अनी पृथ्वीना खाल कोणी बी ती गुंडाळी उघडाले किंवा तिनामा दखाले समर्थ नव्हता. <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />हाई गुंडाळी उघडाले किंवा तिनामा काय शे हाई दखाले योग्य अस कोणीच सापडनं नही म्हणीन माले खुप रडु वना. <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />तवय वडील मंडळीसपैकी एकजण माले बोलना, “रडु नको; दख, यहुदा वंशना सिंह, दावीदना वंशज यानी विजय मियाडा; म्हणीन तो तिना सात शिक्का तोडीन ती गुंडाळी उघडाले योग्य ठरेल शे.”<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />तवय ज्याना जसा काय वध करामा येल व्हता असा कोकराले राजासनना मझार दखं अनं त्याना आजुबाजू चार जिवत प्राणी अनी वडीलमंडळी यासले मी दखं, त्याले सात शिंगं अनं सात डोया व्हतात; त्या सर्वा पृथ्वीवर धाडेल देवना सात आत्मा शेतस. <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />कोकरानी जाईन राजासनवर जो बशेल व्हता त्याना उजवा हातमातीन ती गुंडाळी लिधी. <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />त्यानी गुंडाळी लिधी तवय त्या चार प्राणी अनं चोवीस वडील लोकं कोकरानापुढं गुडघा टेकनात. त्या प्रत्येकजोडे वीणा अनं धुपतीन भरेल सोनान्या वाट्या व्हत्यात; त्या वाट्या म्हणजे देवना लोकसन्या प्रार्थना. <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />त्या नवं गाणं म्हणतस;</para>
  <para style="q1" vid="REV 5:9">“तू गुंडाळी लेवाले अनं तिना शिक्का तोडाले योग्य शे;</para>
  <para style="q2" vid="REV 5:9">कारण तुले मारामा येल व्हतं अनी तू आपला रक्तघाई सर्व वंश, जमात, येगयेगळ्या भाषा बोलणारा लोक अनं राष्ट्र यासनामातीन आमना देवकरता ईकत लेयल शेतस.<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:१० </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:6">प्रकटीकरण १:६</ref>
      </char>
    </note>अनी आमना देवनी सेवा कराकरता त्यासले याजकीय राज्य अस करेल शे</para>
  <para style="q2" vid="REV 5:10">अनी त्या पृथ्वीवर राज्य करतीन.”<verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />तवय मी परत दखं राजासन, चार जिवत प्राणी अनं वडील लोकं यासना आजुबाजू बराच देवदूत उभा राहीनात अनी माले त्यासना आवाज वना; त्यासनी संख्या हजारसमा अनं लाखमा व्हती! <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />त्यासनी मोठा आवाजमा गाणं म्हणं;</para>
  <para style="q1" vid="REV 5:12">वध करामा येल व्हता कोकरा सामर्थ्य, धन, ज्ञान, बल,</para>
  <para style="q2" vid="REV 5:12">सन्मान, गौरव अनं स्तुती ह्या लेवाले योग्य शे!<verse eid="REV 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 5:13" />अनी स्वर्गमा, पृथ्वीवर, पृथ्वीना खाल अनं समुद्रवर जो प्रत्येक सजीव प्राणी शे तो, अनी त्यामाधली सर्व वस्तु यासले मी अस गातांना ऐकं;</para>
  <para style="q1" vid="REV 5:13">“राजासनवर बशेल या कोकराले,</para>
  <para style="q2" vid="REV 5:13">स्तुती, सन्मान, गौरव अनं सामर्थ्य हाई युगानुयुग शेतस.”<verse eid="REV 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 5:14" />तवय त्या चार जिवत प्राणी बोलणात, आमेन; अनी वडील मंडळीनी गुडघा टेकीन उपासना करी.<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">शिक्का</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />मंग कोकरानी त्या सात शिक्कासपैकी एक शिक्का फोडा ते मी दखं, तवय चार प्राणीसपैकी एक मेघगर्जनासनामायक आवाजतीन, “ये!” असं बोलणा, ते मी ऐकं, <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />मंग मी दखं तो पांढरा घोडा, अनी त्यानावर बशेल स्वार माले दिसना; त्यानाजोडे धनुष्य व्हता, मंग त्याले मुकुट देवामा वना; तो विजेतानामायक विजयवर विजय मिळावत निंघना.<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />कोकरानी दुसरा शिक्का फोडा, तवय दुसरा प्राणी, “ये!” असं बोलणा, ते मी ऐकं. <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />तवय दुसरा घोडा निंघना; तो अग्नीनामायक लाल व्हता अनी त्यानावर बशेल स्वारकडे पृथ्वीवरली शांतता हरण करानं अनी लोकसकडतीन एकमेकसले मारी टाकानं काम सोपेल व्हतं; त्याले मोठी तलवार देवामा येल व्हती.<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />कोकरानी तिसरा शिक्का फोडा, तवय तिसरा प्राणी, “ये!” असं बोलणा, ते मी ऐकं मंग मी दखं तो एक काळा घोडा, अनी त्यानावर बशेल कोणी एक माले दखायना; त्याना हातमा तराजु व्हता; <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />अनी जश काही चार प्राणीसमातीन निंघेल आवाज मी ऐका, तो असा “एक दिननी मजुरी किलोभर गहु, अनी तीनशेर जव; जैतुनना झाडे अनं द्राक्षमया यासनी खराबी करू नको.”<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />कोकरानी चौथा शिक्का फोडा, तवय चौथा प्राणी, “ये!” अस बोलणा, ते मी ऐकं. <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />मंग मी दखं, तो एक फिक्कट रंगना घोडा, अनी त्यानावर बशेल माणुस माले दखायना, त्यानं नाव मृत्यु; अनी मृत्युलोक त्याना मांगेमांगे जाई राहिंता. त्यासले युध्दघाई, दुष्काळघाई, रोगसघाई अनी पृथ्वीवरला श्वापदसकडतीन माणससले मारी टाकाना अधिकार पृथ्वीना चौथा भागवर देवामा वना. <verse eid="REV 6:8" /><verse number="9" style="v" sid="REV 6:9" />कोकरानी पाचवा शिक्का फोडा तवय मी वेदीखाल आत्मा दखात; त्या आत्मा देवना वचनमुये अनं त्यासनी जी साक्ष देयल व्हती तिनामुये मारी टाकेल लोकसना व्हतात. <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />त्या जोरमा वरडिन बोलणात, “हे सामर्थ्यशाली प्रभु, तू पवित्र अनं सत्य शे. तू कोठपावत न्यायनिवाडा करावु नही अनी पृथ्वीवर राहणारा लोकसले शिक्षा कराव नही?” <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />तवय त्या प्रत्येकले एक एक शुभ्र झगा देवामा वना अनी त्यासले असे सांगाम वनं की, “तुमना संगेना दासासले अनं ईश्वासणारासले तुमनामायक मारी टाकतीन, त्यासनी संख्या पुरी व्हवापावत तुम्हीन आखो थोडा येळ आराम करा.”<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">६:१२ </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:13">प्रकटीकरण ११:१३</ref>; <ref loc="REV 16:18">१६:१८</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:29">मत्तय २४:२९</ref>; <ref loc="MRK 13:24">मार्क १३:२४</ref>,<ref loc="MRK 13:25">२५</ref>; <ref loc="LUK 21:25">लूक २१:२५</ref></char>
    </note>कोकरानी सहावा शिक्का फोडा, ते मी दखं; तवय मोठा भूकंप व्हयना; सुर्य केससनी बनाडेल खडबडीत कपडानामायक काळा व्हयना अनं पुरा चंद्र रंगतनामायक लाल व्हयना. <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />अंजिरनं झाड मोठा वाराघाई हालावर त्याना कच्चा फयं जशा खाल पडतस तसा आकाशमाधला तारा पृथ्वीवर पडनात. <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" /><note caller="+" style="x"><char style="xo" closed="false">६:१४ </char><char style="xt" closed="false"><ref loc="REV 16:20">प्रकटीकरण १६:२०</ref></char></note>एखादं पुस्तकं गुंडाळतस तसं आकाश गुंडाळाईन निंघी गयं अनी सर्व डोंगर अनं बेट आपआपला जागावरतीन सरकणात. <verse eid="REV 6:14" /><verse number="15" style="v" sid="REV 6:15" />पृथ्वीवरला राजा अनं मोठा अधिकारी, सरदार, श्रीमंत अनं ताकदवान लोक, अनी बाकीना सर्व लोके, सर्व दास अनं सर्व स्वतंत्र लोकं, गुहासमा अनं डोंगरामाधला खडकसमा दपनात; <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" /><note caller="+" style="x"><char style="xo" closed="false">६:१६ </char><char style="xt" closed="false"><ref loc="LUK 23:30">लूक २३:३०</ref></char></note>अनी त्या डोंगरसले अनं खडकसले बोलणात, “आमनावर पडीन राजासनावर जो बशेल शे, त्याना दृष्टीपुढतीन अनं कोकराना क्रोधपाईन आमले दपाडा! <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />कारण त्यासना क्रोधना मोठा दिन येल शे, अनी कोण त्याना विरूध्द ऊभा राहु शकस?”<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">इस्त्राएलना एक लाख चौरेचाळीस हजार लोक</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />यानानंतर मी चार देवदूत पृथ्वीना चार कोपरावर ऊभा राहेल दखात, त्या पृथ्वीवरतीन अनं समुद्रवरतीन वारा वाहाले नको अनं कोणता बी झाडले लागाले नको म्हणीन पृथ्वीना चार वारासले आडाई राहिंतात. <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />मी आखो एक देवदूतले सूर्योदयना दिशातीन वर चढतांना दखं, त्यानाजोडे जिवत देवना शिक्का व्हता; ज्या चार देवदूतसकडे पृथ्वीले अनं समुद्रले उपद्रव करानं काम सोपेल व्हतं त्यासले तो मोठा आवाजतीन बोलणा, <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />“आमना देवना ज्या दास शेतस त्यासना कपाळवर आम्हीन शिक्का मारापावत पृथ्वीले, समुद्रले अनं झाडसले उपद्रव करू नका.” <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />ज्यासनावर शिक्का मारामा वना त्यासनी संख्या मी ऐकी; इस्त्राएल लोकसना सर्व बारा वंशसपैकी एक लाख चौरेचाळीस हजारसवर शिक्का मारामा वना. <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />प्रत्येक वंशपैकी बारा हजारसवर; यहुदा वंशपैकी बारा हजारसवर, रऊबेन वंशपैकी बारा हजारसवर; गाद वंशपैकी बारा हजारसवर; <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />आशेर वंशपैकी बारा हजारसवर; नफताली वंशपैकी बारा हजारसवर; मनश्शे वंशपैकी बारा हजारसवर; <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />शिमोन वंशपैकी बारा हजारसवर; लेवी वंशपैकी बारा हजारसवर; इस्साखार वंशपैकी बारा हजारसवर; <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />जबूलून वंशपैकी बारा हजारसवर; योसेफ वंशपैकी बारा वंशपैकी बारा हजारसवर; बन्यामीन वंशपैकी बारा हजारसवर शिक्का मारामा वना.<verse eid="REV 7:8" /></para>
  <para style="s">मोठा समुदाय शुभ्र झगामा</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />यानानंतर मी दखं तो सर्व वंश, जमात, राष्ट्रे अनं येगयेगळा भाषा बोलणारा यासनापैकी कोणले मोजता वना नही असा, शुभ्र झगा घालेल अनं हातमा खजुरना झाडन्या फांद्या लेयल, मोठी लोकसनी गर्दी राजासनसमोर अनं कोकरासमोर ऊभा राहेल माले दखायनी. <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />त्या मोठा आवाजमा सांगी राहिंतात; “राजासनसमोर बशेल आमना देवकडतीन अनं कोकराकडतीन, तारण शे!” <verse eid="REV 7:10" /><verse number="11" style="v" sid="REV 7:11" />तवय राजासन, वडीलमंडळी अनं चार प्राणी यासना आजुबाजू सर्वा देवदूत ऊभा व्हतात, त्या राजासनसमोर उपडा पडी देवनी आराधना करीसन, <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />बोलणात, “आमेन! उपकारस्तुती, गौरव, ज्ञान, धन्यवाद, सन्मान, सामर्थ्य अनं ताकद ह्या युगानुयुग आमना देवना शेतस! आमेन!”<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />तवय वडील मंडळीपैकी एकनी माले ईचारं, “शुभ्र झगा घालेल ह्या कोण शेतस अनं कोठेन वनात?”<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">७:१४ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:21">मत्तय २४:२१</ref>; <ref loc="MRK 13:19">मार्क १३:१९</ref></char>
    </note>मी उत्तर दिधं, “माले नही माहित, गुरजी. तुमले माहित,” तो माले बोलणा, “मोठ्या संकटमातीन येतस त्या ह्या शेतस; यासनी आपला झगा कोकराना रंगतमा धोईसन शुभ्र करेल शे. <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />यामुये त्या देवना राजासनसमोर शेतस; त्या अहोरात्र त्याना मंदिरमा त्यानी सेवा करतस अनी राजासनवर बशेल त्याना उपस्थितीमा त्यासनं संरक्षण करी. <verse eid="REV 7:15" /><verse number="16" style="v" sid="REV 7:16" />यानामुये त्या परत भूकेला असा व्हणार नहीत, अनं तहानेल व्हणार नहीत, त्यासले सूर्य किंवा कोणती बी कडक उष्णता जाळाऊ नही, <verse eid="REV 7:16" /><verse number="17" style="v" sid="REV 7:17" />कारण राजासनपुढे मध्यभागले राहणारा जो कोकरा त्यासना मेंढपाळ व्हई अनं तो त्यासले वाट दखाडीन जिवनना पाणीना झराजोडे लई जाई; अनी देव त्यासना डोयाना सर्व अश्रु पुसी टाकी.”<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">सातवा शिक्का</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />जवय कोकरानी सातवा शिक्का फोडा, तवय स्वर्गमा जवळपास अर्धा तास शांतता व्हती. <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />तवय देवसमोर उभा राहेल सात देवदूत मी दखात. त्यासले सात कर्णा देवामा वनात.<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />मंग आखो एक देवदूत ईसन वेदीपुढे उभा राहिना. त्यानाजोडे धुपनी पेटी व्हती; अनी राजासनना समोरना सोनाना वेदीवर सर्व देवना लोकसना प्रार्थनाससंगे धुप ठेवाकरता त्यासनाजोडे भरपुर धुप देयल व्हता. <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />देवदूतना हाततीन धुपना धुर देवना लोकसना प्रार्थनाससंगे देवसमोर वर गया. <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" /><note caller="+" style="x"><char style="xo" closed="false">८:५ </char><char style="xt" closed="false"><ref loc="REV 11:19">प्रकटीकरण ११:१९</ref>; <ref loc="REV 16:18">१६:१८</ref></char></note>तवय देवदूतनी धुपनी पेटी लिसन त्यामा वेदीवरनी आग भरीन पृथ्वीवर टाकी अनी ढगसना गडगडाट अनं गर्जना व्हयन्यात, ईजा चमकन्यात अनं भूकंप व्हयना.<verse eid="REV 8:5" /></para>
  <para style="s">कर्णा</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />मंग ज्या सात देवदूतसजोडे सात कर्णा व्हतात त्या आपआपला कर्णा वाजवाले तयार व्हयनात.<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />पहिला देवदूतनी कर्णा वाजाडा तवय रंगत मिसाळेल गारा अनं आग उत्पन्न व्हईन त्यासनी पृथ्वीवर वृष्टी व्हयनी. पृथ्वीना एक तृतीयांश भाग जळी गया, एक तृतीयांश झाडं जळी गयात, अनं सर्व हिरवं गवत राख व्हयनं.<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />मंग दुसरा देवदूतनी त्याना कर्णा वाजाडा, तवय आगघाई पेटेल मोठा डोंगरनामायक काहीतरी समुद्रमा टाकाई गयं; समुद्रना एक तृतीयांश पाणीनं रंगत व्हयनं, <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />अनी समुद्रमाधला प्राणीसपैकी एक तृतीयांश मरणात तसच एक तृतीयांश जहाजसना नाश व्हयना.<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />मंग तिसरा देवदूतनी त्याना कर्णा वाजाडा तवय मशालनामायक पेटेल मोठा तारा आकाशमातीन खाल पडना. तो नदीसना अनं झरासना एक तृतीयांश पाणीवर पडना. <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />त्या तारानं नाव “कडूदवणा” व्हतं अनी पाणीना एक तृतीयांश भाग कडू व्हयना अनी त्या पाणीघाई माणससपैकी बराच माणसं मरणात; कारण ते कडू व्हयेल व्हतं.<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />मंग चौथा देवदूतनी त्याना कर्णा वाजाडा, तवय सूर्यना एक तृतीयांश, चंद्रना एक तृतीयांश अनं तारासना एक तृतीयांश भाग यासनावर प्रहार व्हयना. त्यासना तृतीयांश भाग अंधकारमय व्हयना अनी दिनना तस रातना बी तृतीयांश भागवर प्रकाश दिसाले नको म्हणीन अस व्हयनं.<verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />मंग मी दखं तवय एक गरूड अंतराळना मध्यभागमा उडतांना दखायना, त्याले मोठा आवाजमा असं बोलताना मी ऐकं, “ज्या तीन देवदूत कर्णा वाजाडणार शेतस त्यासना कर्णाना होणाऱ्या आवाजघाई पृथ्वीवर राहणारा लोकसवर अनर्थ! अनर्थ! अनर्थ येवाव शे!”<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />मंग पाचवा देवदूतनी त्याना कर्णा वाजाडा, तवय एक तारा आकाशमातीन पृथ्वीवर पडेल माले दखायना; त्यानाजोडे अथांग डोह<note caller="+" style="f"><char style="fr" closed="false">9:1 </char><char style="fq" closed="false">अथांग डोह </char><char style="ft" closed="false">पृथ्वीमाधली खोल जागा </char></note>नी किल्ली दिधी. <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />त्या तारानी त्या किल्लीगाई अथांग डोह उघाडं, तो त्यानामातीन मोठी भट्टीना धुरनामायक धूर बाहेर ईसन वर गया; अनी डोहना धूरघाई सूर्यप्रकाश अनं हवा ह्या अंधकारमय व्हयनात. <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />त्या धुरमातीन टोळ निंघींसन पृथ्वीवर उतरनात; त्यासले पृथ्वीवर ईच्चुनामायक शक्ती देयल व्हती. <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />त्यासले अस सांगेल व्हतं की, पृथ्वीवरला गवतले, कोणता बी हिरवळले अनं कोणतं बी झाडले उपद्रव करानं नही; तर ज्या माणससना कपाळवर देवना शिक्का नही त्यासले मात्र उपद्रव कराना. <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />त्या माणससले मारी टाकाना टोळसकडे सोपेल नव्हतं तर फक्त पाच महिना पीडा देवानं सोपेल व्हतं; त्यासनापाईन व्हणारी पीडा, ईच्चु माणुसले डंक मारस तवय व्हणारा पीडानामायक व्हती. <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />त्या पाच महिनासमा त्या मराना प्रसंग दखतीन, पण त्यासले तो मिळाव नही; मरानी ईच्छा धरतीन, तरी मरण त्यासनापाईन दूर पळी.<verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />त्या टोळसना आकार लढाईकरता तयार करेल घोडासना आकारना मायक व्हता त्यासना डोकावर सोनानामायक दिसणारा मुकुट व्हतात अनी त्यासना चेहरा माणससना चेहरानामायक व्हता. <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />त्यासना केस बाईसना केससनामायक अनी दात सिंहसना दातसनामायक व्हतात. <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />त्यासनी छाती ज्याघाई झाकेल व्हती ती लोखंडी उरस्त्राणा<note caller="+" style="f"><char style="fr" closed="false">9:9 </char><char style="fq" closed="false">उरस्त्राणा </char><char style="ft" closed="false">छातीना रक्षाकरता कवच</char></note>मायक दखाई राहिंतात; अनी त्यासना पंखसना आवाज लढाईमा पयणारा बराच घोडासना रथसना आवाजनामायक व्हता. <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />त्यासले ईच्चुसनामायक शेपुट अनं नांगा व्हतात अनी माणससले पाच महिना पिडा देवानी शक्ती त्यासना शेपुटमा शे. <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />अथांग डोहना दूत हाऊ त्यासनावर राजा शे अनी; इब्री भाषामाधला त्यानं नाव अबद्दोन, अनी ग्रीक भाषामा त्यानं नाव अपल्लूओन शे. त्याना अर्थ म्हणजे “नाश करनारा.”<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />पहिला मोठा अनर्थ व्हई गया; दखा, यानानंतर आखो दोन मोठा अनर्थ येणार शेतस.<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />मंग सहावा देवदूतनी त्याचा कर्णा वाजाडा, तवय देवनासमोरना सोनानी वेदीना शिंगमातीन व्हयेल एक आवाज मी ऐका; <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />ज्यानाजोडे कर्णा व्हता त्या देवदूतले तो आवाज बोलना, “फरात महानदीवर बांधीन ठेयल चार देवदूतसले मोकळ कर!” <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />तवय मानव जातीपैकी एक तृतीयांश माणससले मारा करता नेमेल येळ, दिन, महिना अनं वरीस यासनाकरता तयार करेल ह्या चार देवदूत मोकळा व्हयनात. <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />स्वारसना सैन्यनी संख्या वीस कोटी व्हती; हाई त्यासनी संख्या मी ऐकी. <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />त्या दृष्टांतमा घोडा अनं त्यानावर घोडास्वार मी दखात; त्यासना उरस्त्राणे आगनामायक लाल, नीळनामायक निळा, गंधकनामायक पिवळा रंगना व्हतात. त्या घोडासना डोका सिंहना डोकानामायक व्हतात; अनी त्यासना तोंडमातीन, आग, धूर अनं गंधक ह्या निंघी राहिंतात. <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />त्यासना तोंडमातीन निघणारी आग, धूर अनं गंधक या तीन पीडासमुये एक तृतीयांश मानव जातीले मारी टाकात. <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />त्या घोडासनी शक्ती त्यासना तोंडमा अनं त्यासना शेपुटमा शे; त्यासनी शेपुट सापसनामायक राहिसन त्यासले डोका शेतस, अनी त्यानाघाई त्या लोकसले पिडा दि राहिंतात.<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />त्या पीडासघाई ज्या मरणात नही असा बाकीना मनुष्यनी आपला हातसघाई करेल कामसपाईन परत फिरनात नही; म्हणजे भूतं अनं ज्यासले दखता, ऐकता अनं चालता येस नही असा सोनाना, चांदीना, पितळना, दगडना अनं लाकुडना मुर्ति यासनी पुजा करनं त्यासनी सोडं नही; <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />अनी त्यासनी करेल, हत्या, जादू, व्यभिचार अनं चोऱ्या यासना पाईन त्या परत फिरनात नही.<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">देवदूत अनं धाकली गुंडाळी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />मी आखो एक सामर्थ्यशाली देवदूत स्वर्गमातीन खाली उतरतांना दखा; तो ढगसले पांघरेल अनं त्याना डोकावर मेघधनुष्य व्हता, त्याना चेहरा सूर्यनामायक, अनं त्याना पाय आगना खांब मायक व्हतात; <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />त्याना हातमा उघडेल एक धाकलं गुंडाळी व्हती; त्यानी आपला उजवा पाय समुद्रवर अनं डावा पाय जमीनवर ठेवा, <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />तो सिंहसना गर्जननामायक जोरमा वरडना; तवय सात मेघगर्जनासनी उत्तर दिधं. <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />त्या सात मेघगर्जनासनी उत्तर दिधं तवय मी लिखणार व्हतु; इतलामा स्वर्गमातीन व्हयेल आवाज मी ऐका, तो बोलना; सात गर्जनासनी जे सांगं ते गुप्त ठेव, ते लिखु नको.<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />ज्या देवदूतले समुद्रवर अनं जमीनवर उभं राहेल मी दखं, त्यानी आपला उजवा हात स्वर्गकडे वर करीसन, <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />जो युगानुयुग जिवत शे, ज्यानी आकाश अनं त्यामा जे शे, पृथ्वी अनं तिनावर जे शे ते, अनी समुद्र अनं त्यामा जे शे ते उत्पन्न करं, त्याना नावनी शपथ वाहीन सांगं, “आखो येळ लागाव नही! <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />जवय सातवा देवदूत कर्णा वाजाडी, तवय देव त्यानी गुप्त योजना आपला दास, संदेष्टा यासले सांगेल व्हतं ते पुर्ण व्हई.”<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />स्वर्गमातीन व्हयेल जो आवाज परत मी ऐकेल व्हता तो मनासंगे परत बोलतांना मी ऐका; तो बोलना, “जा अनं समुद्रवर अनं जमीनवर उभा राहेल देवदूतना हातमाधलं गुंडाळी जाईन ले.”<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />तवय मी त्या देवदूतकडे जाईन, ती धाकली गुंडाळी माले दे अस सांगं, तो माले बोलना, “हाई ले अनी खाई टाक; हाई तुनं पोट कडू करी टाकी पण तुना तोंडमा ते मधनामायक गोड लागी.”<verse eid="REV 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10" />तवय मी देवदूतना हातमातीन ती धाकली गुंडाळी लिधं अनं खाई टाकं; ती मना तोंडमा मधनामायक गोड लागनं, तरी ते खावानंतर मनं पोट कडू व्हयनं. <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />तवय त्या माले बोलनात, “बराच राष्ट्र, लोके, भाषा अनं राजा यासनाबद्दल तू परत संदेश देवालेच पाहिजे.”<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">दोन साक्षीदार</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />नंतर मोजानी पट्टीनामायक एक बोरू कोणी तरी माले दिधा, अनी सांगं, “जा, देवनं मंदिर अनं वेदी यासनं माप ले अनी मंदिरमा आराधना करनारा कितला शेतस ते मोज.” <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" /><note caller="+" style="x"><char style="xo" closed="false">११:२ </char><char style="xt" closed="false"><ref loc="LUK 21:24">लूक २१:२४</ref></char></note>पण मंदिरना बाहेरनं माप लेवु नको, कारण ते गैरयहूदीसले देयल शे अनी त्या शेचाळीस महिना पवित्र शहर पायखाल तुडावतीन. <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />मना दोन्ही साक्षीदार ज्या गोणपाट घालेल व्हतीन त्यासले मी धाडसु अनी त्या एक हजार दोनशे साठ दिन देवना संदेश सांगतीन.<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />पृथ्वीना प्रभुसमोर उभा राहणारा जैतुनना दोन झाडं अनं दोन समई ह्या त्या दोन साक्षीदार शेतस. <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />त्यासले कोणी उपद्रव कराले दखस तर त्यासना तोंडमातीन आग निंघीन त्यासना शत्रुसले खाई टाकस, कोणी त्यासले नुकसान पोहचाडाना प्रयत्न करा तर त्यासले त्यानाप्रमाणेच मारी टाकामा येवो. <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />त्यासना संदेश सांगाना दिनसमा पाऊस पडाले नको म्हणीन आकाश बंद कराना त्यासले अधिकार देयल शे; झरासना पाणीनं रक्त कराना अधिकार त्यासले शे, अनी वाटी तवय पृथ्वीले सर्व पीडासनी पीडित कराना बी त्यासले अधिकार शे.<verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">११:७ </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:5-7">प्रकटीकरण १३:५-७</ref>; <ref loc="REV 17:8">१७:८</ref></char>
    </note>त्यासनी आपली साक्ष देणं समाप्त करावर अथांग डोहमातीन श्वापदवर ईसन त्यासनासंगे लढाई करी अनी त्यासले जिंकीन मारी टाकी. <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />अनी ज्या शहरमा प्रभुले क्रुसखांबवर खियामा येल व्हतं त्याना रस्तावर त्यासना प्रेतं पडी राहतीन त्या शहरसले प्रतिकात्मक रितघाई त्यासले सदोम अनं मिसर अस नाव सांगेल असा त्या मोठा शहर शेतस. <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />सर्वा लोकं, वंश, येगयेगळा भाषा बोलणारा अनं राष्ट्र यामाधला लोकं त्यासना प्रेतं साडेतीन दिन दखतीन अनी त्या त्यासना प्रेतले कबरमा ठेवू देवावत नही. <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />अनी त्या दोन्हीसना मरणमुये पृथ्वीवरला लोकं आनंद करतीन. त्या उल्लास करतीन अनं एकमेकसले बक्षीस धाडतीन, कारण त्या दोन्ही संदेष्टासनी पृथ्वीवर राहणारासले पीडा देयल व्हती. <verse eid="REV 11:10" /><verse number="11" style="v" sid="REV 11:11" />पुढे साडेतीन दिनस नंतर जिवनना आत्मा देवपाईन ईसन त्यासनामा घुसना, तवय त्या आपला पायवर उभा राहिनात, अनी ज्यासनी त्यासले दखं त्यासले खुप भिती वाटनी. <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />तवय त्या दोन संदेष्टासनी स्वर्गमातीन निंघेल मोठा आवाज ऐका, तो बोलना, “इकडे वर या!” मंग त्या मेघारूढ व्हईसन स्वर्गमा निंघी गयात अनं त्या वर जाई राहींतात तवय त्यासले त्यासना शत्रुसनी दखं. <verse eid="REV 11:12" /><verse number="13" style="v" sid="REV 11:13" /><note caller="+" style="x"><char style="xo" closed="false">११:१३ </char><char style="xt" closed="false"><ref loc="REV 6:12">प्रकटीकरण ६:१२</ref>; <ref loc="REV 16:18">१६:१८</ref></char></note>त्याच येळले मोठा भूकंप व्हयना. तवय त्या शहरना दहावा भाग नाश व्हयना, अनी सात हजार लोकं मरी गयात अनी बाकीना घाबरीन त्यासनी स्वर्गीना देवनं गौरव करं.<verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />दुसरा अनर्थ व्हई गया पण तिसरा अनर्थ लवकरच यवावं शे.<verse eid="REV 11:14" /></para>
  <para style="s">सातवा कर्णा</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />नंतर सातवा देवदूतनी कर्णा वाजाडा, तवय स्वर्गमातीन मोठा आवाज वनात त्या बोलनात, “जगनं राज्य आमना प्रभुनं अनं त्याना ख्रिस्तनं व्हयेल शे, अनी तो युगानुयुग राज्य करी!” <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />तवय देवना समोर आपला आसनवर बशेल चोवीस वडील लोकं उपडा पडिन देवले नमन करीसन आराधना करीसन बोलनात,<verse eid="REV 11:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="REV 11:17" />“हे प्रभु देवा, हे सर्वसमर्था, जो तु शे अनं व्हता!</para>
  <para style="q2" vid="REV 11:17">तो तु आपलं महान सामर्थ्य धारण करेल शे</para>
  <para style="q1" vid="REV 11:17">अनी राज्य अधिकार आपला हातमा लिधात म्हणीन आम्हीन तुनां आभार मानतस.<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />राष्ट्र क्रोधित व्हईनात, तुना क्रोधनी येळ वनी;</para>
  <para style="q2" vid="REV 11:18">मरेलसना न्याय करानी येळ,</para>
  <para style="q1" vid="REV 11:18">अनी तुना दास, संदेष्टा अनं तुना पवित्र लोकं अनं तुना नावनी भिती धरणार धाकलामोठा असा तुना सर्वा लोके,</para>
  <para style="q2" vid="REV 11:18">यासले वेतन देवानी येळ अनी पृथ्वीना नाश करनारासनी नाश करानी येळ येल शे.”<verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">११:१९ </char>
      <char style="xt" closed="false">
        <ref loc="REV 8:5">प्रकटीकरण ८:५</ref>; <ref loc="REV 16:18">१६:१८</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="REV 16:21">प्रकटीकरण १६:२१</ref>
      </char>
    </note>तवय देवना स्वर्गमाधलं मंदिर उघडामा वनं, त्याना मंदिरमा त्याना करारना कोश दखायना अनी ईजा चमकन्यात, गर्जना अनं ढगसना गडगडाट व्हयना, भूकंप व्हयना अनं मोठं गारासनी वृष्टी बी व्हयनी.<verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s">बाई अनी अजगर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />नंतर आकाशमा एक महान रहस्यमय चिन्ह दखायनं; एक बाई दखायनी, ती सूर्य पांघरेल व्हती अनी तिना पायखाल चंद्र अनं तिना डोकावर बारा तारासना मुकुट व्हता. <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />तिले दिन व्हतात अनी प्रसुतीसना वेदनासतीन वरडी राहिंती.<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />आकाशमा दुसरं एक रहस्यमय चिन्ह दखायनं; दखा, एक मोठा लाल अजगर दखायना, त्याले सात डोका अनं दहा शिंगं व्हतात, अनी त्याना डोकवर सात मुकुट व्हतात. <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />त्याना शेपटीघाई आकाशमाधला तारासना एक तृतीयांश तारा वढी लिधात अनं त्या पृथ्वीवर फेकात. अनी ती बाई बाळले जन्म दि तवय तिनं बाळ खाई टाकाले पाहिजे म्हणीन तो अजगर त्या बाईपुढे उभा राहीना. <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />मंग ती बाईनी एक पोऱ्याले जन्म दिधा, जो सर्व राष्ट्रसवर लोखंडी दंडाघाई राज्य करी. पण त्या बाळले उचलीन देवकडे अनं त्याना राजासनकडे वर लेवामा वनं. <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />ती बाई वाळवंटमा पळी गयी, तठे तिनं एक हजार दोनशे साठ दिन पोषण व्हवाले पाहिजे, म्हणीसन देवनी तयार करेल तिनी जागा व्हती. <verse eid="REV 12:6" /><verse number="7" style="v" sid="REV 12:7" /><note caller="+" style="x"><char style="xo" closed="false">१२:७ </char><char style="xt" closed="false"><ref loc="JUD 1:9">यहुदानं पत्र १:९</ref></char></note>तवय स्वर्गमा युध्द व्हयनं; मिखाएल अनं त्याना दूतसनी अजगरसंगे युध्द करं; अनी त्यासनासंगे अजगर अनं त्याना दूतसनी बी प्रतीहल्ला करा; <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />पण अजगर हारी गया, अनी त्याले अनं त्याना दूतसले स्वर्गमा ऱ्हावानी परवानगी राहीनी नही. <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" /><note caller="+" style="x"><char style="xo" closed="false">१२:९ </char><char style="xt" closed="false"><ref loc="LUK 10:18">लूक १०:१८</ref></char></note>मंग मोठा अजगरले खाल फेकामा वनं, सर्व जगले फसाडणारा दुष्ट अनं सैतान म्हणेल जुना साप याले अनी सगळा त्याना दूतसले बी खाल पृथ्वीवर फेकामा वनं.<verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />तवय मी स्वर्गमा मोठा आवाज ऐका; तो बोलना, “आते तारण, सामर्थ्य अनं राज्य आमना देवनं व्हयेल शे अनं अधिकार त्याना ख्रिस्तना व्हयेल शे; कारण जो आमना भाऊसले अनी बहीणींसले दोष देणारा, आमना देवसमोर रातदिन त्यासनावर दोष आरोप करनारा, तो स्वर्गमाईन खाल टाकामा येल शे. <verse eid="REV 12:10" /><verse number="11" style="v" sid="REV 12:11" />त्यासले त्यानी कोकराना रंगतमुये अनं आपला साक्षना वचनमुये जिंकं अनी त्यासनावर मरणनी येळ वनी तरी त्यासनी आपला जिववर प्रेम करं नही. <verse eid="REV 12:11" /><verse number="12" style="v" sid="REV 12:12" />यामुये स्वर्गसवन अनं त्यामा राहणारासवन, उत्साह करा; पृथ्वी अनं समुद्र, यानावर, अनर्थ ओढायेल शे. कारण आपला काळ थोडा शे अस समजीन भलताच संतापेल सैतान उतरीन तुमनाकडे येल शे.”<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />आपलाले पृथ्वीवर फेकामा येल शे हाई जवय अजगरले समजनं, तवय ज्या बाईनी पोऱ्याले जन्म देयल व्हता तीना पाठलाग करानी सुरवात त्यानी करी. <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />त्या बाईनी आपला जागावर वाळवंटमा उडी जावानं म्हणीन तिले मोठा गरूडना दोन पंख देवामा येल व्हतात; तठे साडेतीन वरीस अजगरपाईन सुरक्षित राहिन तिनं पोषण व्हवाणं व्हतं, <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />मंग त्या बाईनी वाही जावाले पाहिजे म्हणीन त्या अजगरनी तिनामांगतीन नदीनामायक पाणीना प्रवाह आपला तोंडमातीन सोडा. <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />पण बाईले पृथ्वीनी मदत करी; तिनी आपलं तोंड उघडीन अजगरनी आपला तोंडमातीन सोडेल नदी गिळी टाकी. <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />त्यानामुये अजगर बाईवर संतापना अनी देवनी आज्ञा पाळणारा अनं येशुबद्दलनी साक्ष देणारा असा तिना संतानसपैकी बाकीनासनासंगे लढाई कराले तो निंघी गया; <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />अनी तो अजगर समुद्रना किनारवर जाईसन उभा राहिना.<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">दोन श्वापद</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१३:१ </char>
      <char style="xt" closed="false">
        <ref loc="REV 17:3">प्रकटीकरण १७:३</ref>,<ref loc="REV 17:7-12">७-१२</ref></char>
    </note>नंतर मी एक श्वापदले समुद्रमातीन वर येतांना दखं; त्याले सात डोका अनं दहा शिंगं व्हतात त्याना प्रत्येक शिंगवर एक एक असा दहा मुकुट अनी त्याना डोकावर देवनिंदात्मक नावं व्हतात. <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />जे श्वापद मी दखेल व्हतं ते चित्तानामायक व्हतं, त्याना पाय अस्वलना पायसनामायक व्हतात त्यानं तोंड सिंहना तोंडनामायक व्हतं; त्याले अजगरनी आपली शक्ती, आपलं आसन अनं मोठा अधिकार दिधा. <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />त्याना डोकापैकी एक डोकाले मरण ई अशी जखम व्हयेल माले दखायनी; तरी पण त्यानी ती जखम बरी व्हयनी; तवय सर्व पृथ्वी आश्चर्य करत त्या श्वापदना मांगतीन गयी. <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />अजगरनी श्वापदले आपला अधिकार देयल व्हता म्हणीन त्यासनी अजगरले नमस्कार करा; अनी त्या श्वापदले नमस्कार करतांना बोलनात, “या श्वापदना मायक कोण शे? यानासंगे कोणले लढता ई?”<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />त्याले मोठमोठ्या अनं देवनिंदक गोष्टी बोलणारं तोंड देयल व्हतं, अनं बेचाळीस महिना त्याले आपला अधिकार चालाडानं काम देयल व्हतं. <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />त्यानी देवविरूध्द, म्हणजे त्यानं नाव, त्याना मंडप अनं स्वर्गनिवासी लोक यासनी निंदा कराले सुरवात करी. <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />देवना लोकससंगे भांडाणं अनं त्यासले जिंकानं काम त्यानाकडे सोपेल व्हतं; अनी सर्व जमात, लोक, भाषा अनं राष्ट्र यासनावर अधिकार देयल व्हता. <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />ज्यानं कोणं नावं जगना स्थापनाना पहिले, “मारी टाकेल कोकराना जिवनी पुस्तकमा लिखेल” शे, त्यासनाशिवाय ज्या पृथ्वीवर राहणारा बाकिना सर्व लोक त्या श्वापदनी आराधना करतीन.<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />“ज्या कोणले कान शेतस तो ऐको! <verse eid="REV 13:9" /><verse number="10" style="v" sid="REV 13:10" />कैदमा जाणारा तो कैदमा जास; कोणी कोणले तलवारघाई मारस तर त्याले तलवारघाई मरणं भाग शे. यानंवरतीन पवित्र लोकसना धीर अनं ईश्वास दखास.”<verse eid="REV 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />नंतर मी दुसरा एक श्वापदले जमीनमातीन वर येतांना दखं; त्याले कोकरानामायक दोन शिंगं व्हतात; ते अजगरनामायक बोली राहिंता. <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />तो पहिला श्वापदना सर्व अधिकार त्याना समोर चालाडस अनी ज्या पहिल्या श्वापदनी प्राणघातक जखम बरी व्हयेल व्हती, त्याले पृथ्वीनी अनं तिनावर राहणारा लोकसनी नमन कराले पाहिजे अस करस. <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />दुसरा श्वापद मोठा चमत्कार करस; मनुष्यससमोर आकाशमातीन पृथ्वीवर आग पडाले पाहिजे अस बी करस. <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />ज्या चमत्कार पहिला श्वापदसमोर करानं त्यानाकडे सोपेल व्हतं, चमत्काराघाई तो पृथ्वीवर राहणारा लोकसले फसाडस; अनी जे श्वापद तलवारघाई जख्मी व्हईन वाचना त्याना सन्मानमा मुर्ति बनाडाले पृथ्वीवरला लोकसले सांगस. <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />दुसरा श्वापदना हातमा पहिला श्वापदना मुर्तिमा प्राण घालानी परवानगी देयल व्हतं, यानाकरता की श्वापदना मुर्तिनी बोलाले पाहिजे अनी ज्या कोणी त्या श्वापदना मुर्तिले नमन कराव नही त्यासले मारी टाकाले पाहिजे अशी ती मुर्ति घडाई लई. <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />दुसरा श्वापदनी धाकलामोठा, श्रीमंत अनं गरीब, स्वतंत्र अनं दास, या सर्वा लोकसले आपला उजवा हातवर किंवा आपला कपाळवर त्यानी खुण करी लेवाले भाग पाडं. <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />अनी ज्यासनावर ती खुण म्हणजे त्या श्वापदनं नाव किंवा नावघाई दखाडेल संख्या शे, त्याशिवाय कोणले ईकत लेता येवाले नको किंवा ईकत देता येवाले नको.<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />हाई अक्कलनं काम शे; ज्याले बुध्दी शे त्यानी संख्याना अर्थ काढाणा; त्या संख्यावरतीन मनुष्यना नावना बोध व्हस; अनी ती संख्या सहाशे साहसष्ट शे.<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">कोकरा अनी त्याना लोकं</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१४:१ </char>
      <char style="xt" closed="false">
        <ref loc="REV 7:3">प्रकटीकरण ७:३</ref>
      </char>
    </note>नंतर मी दखं, कोकरा सियोन डोंगरवर उभा व्हता; त्यानासंगे त्यानं नाव अनं त्याना पितानं नाव कपाळवर लिखेल असा एक लाख चौरेचाळीस हजार लोक व्हतात, <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />अनी बराच जलप्रवाहना शब्दसनामायक अनं मोठा गर्जनना शब्दनामायक स्वर्गमातीन येल आवाज मी ऐका; अनी जो आवाज मी ऐका तो, जस काय वीणा वाजडणारा आपली वीणा वाजाडी राहिना, असा होता. <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />एक लाख चौरेचाळीस हजार लोक राजासनसमोर अनी चार प्राणी अनं वडील लोक यासना समोर उभा व्हतात. ते एक नविन गाणं म्हणी राहिंतात; ते गाणं, त्यासनाशिवाय कोणलेच शिकता ई नही राहिंत. <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />बाईनासंगे संबंध नही ठेयल अनं स्वतःले शुध्द ठेयल ह्याच त्या लोकं शेतस. जठे कोठे कोकरा जास तठे त्यासनामांगे जाणार त्या ह्या शेतस. त्यासले माणुस मातीन ईकत लिसन देवले अनं कोकराले पहिलं फळ म्हणीन अर्पण करेल शे. <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />त्यासना तोंडमा लबाडी सापडस नही; त्या निष्कलंक शेतस.<verse eid="REV 14:5" /></para>
  <para style="s">तीन देवदूत</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />नंतर मी दुसरा एक देवदूत वर हवामा उंच उडतांना दखा, त्यानाजोडे पृथ्वीवर राहणारा लोक म्हणजे प्रत्येक लोक, जमात, भाषा अनं राष्ट्र यासले सांगाले सार्वकालिक सुवार्ता व्हती. <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />तो मोठातीन बोलना, “देवले मान द्या अनं त्यानं गौरव करा! कारण त्यानी न्यायनिवाडा करानी येळ येल शे; ज्यानी आकाश, पृथ्वी, समुद्र अनं पाणीना झरा उत्पन्न करात, त्यानी आराधना करा!”<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१४:८ </char>
      <char style="xt" closed="false">
        <ref loc="REV 18:2">प्रकटीकरण १८:२</ref>
      </char>
    </note>त्या देवदूतमांगतीन दुसरा देवदूत ईसन बोलना, “पडनी! मोठी बाबेल पडनी तिनी आपला जारकर्मना क्रोधरूपी द्राक्षरस सर्व राष्ट्रसले पाजा.”<verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />त्यासना मांगतीन तिसरा देवदूत ईसन मोठातीन बोलना “जो कोणी श्वापदले अनं त्याना मुर्तिनी आराधना करस, अनी आपला कपाळवर किंवा आपला हातवर अशी खुण करी लेस. <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />तो बी देवना क्रोधना प्यालामा शक्तीनी बनायेल क्रोधरूपी द्राक्षरस पि अनी पवित्र देवदूतससमोर अनं कोकरासमोर त्याले अग्नी अनं गंधक यासना पाईन पीडा व्हई. <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />त्यासना पीडाना धूर युगानुयुग वर येस अनी ज्या श्वापदले अनं त्याना मुर्तिले नमन करतस त्यासले अनी जो कोणी त्याना नावनी खुण करी लेस त्यासले रातदिन आराम मिळस नही.”<verse eid="REV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12" />देवना आज्ञा पाळणारा अनं येशुवरना ईश्वास धरीन राहणारा पवित्र लोक यासना धीर यावरतीन दखाई येस.<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />तवय स्वर्गमातीन व्हयेल आवाज मी ऐका, “हाई लिख; प्रभुमा मरणारा आत्तेपाईन धन्य शेतस!”</para>
  <para style="p" vid="REV 14:13">“आत्मा म्हणस खरच! आपला कष्टसपाईन सुटीन त्यासले विसावा मिळी, कारण त्यासना सेवाना फळ त्यासनासंगे जास.”<verse eid="REV 14:13" /></para>
  <para style="s">पृथ्वीनी कापणी</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />नंतर मी दखं, तो पांढरा ढग अनं त्या ढगवर बशेल मनुष्यना पोऱ्यानामायक एकजण दखायना, त्याना डोकावर सोनाना मुकुट अनं त्याना हातमा टोकदार धारना ईळा व्हता. <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />तवय दुसरा एक देवदूत मंदिरमातीन निंघीन ढगवर बशेल माणुसले मोठा आवाजमा बोलना, “तु आपला ईळा चालाडीन कापणी कर, कारण कापणीनी येळ येल शे; पृथ्वीनं पीक पिकी जायेल शे!” <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />तवय ढगवर बशेल माणुसनी आपला ईळा पृथ्वीवर चालाडा; अनी पृथ्वीनी कापणी व्हयनी.<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />मंग दूसरा एक देवदूत स्वर्ग माधला मंदिरमातीन निंघना, त्यानाजोडे बी टोकदार धारना ईळा व्हता.<verse eid="REV 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18" />ज्याले आगवर अधिकार शे असा दुसरा एक देवदूत वेदीजवळतीन बाहेर निंघना, त्यानी ज्यानाजोडे टोकदार धारना ईळा व्हता त्याले मोठा आवाजतीन सांगं, “तू आपला टोकदार ईळा चालाडीन पृथ्वीना द्राक्षना घडं तोडी ले, तिना द्राक्ष पिकी जायेल शेतस!” <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />तवय त्या देवदूतनी आपला ईळा पृथ्वीवर चालाडा अनी पृथ्वीना द्राक्षवेलवरला द्राक्ष तोडीन देवना क्रोधना मोठा द्राक्षकुंडमा टाकं. <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" /><note caller="+" style="x"><char style="xo" closed="false">१४:२० </char><char style="xt" closed="false"><ref loc="REV 19:15">प्रकटीकरण १९:१५</ref></char></note>ते द्राक्षकुंड शहर बाहेर चेंदामा वनं, त्यामातीन रंगत निंघनं, त्याना प्रवाह तिनशे किलोमीटर पर्यंत वाहत गया अनं तो जवळपास पाच फुट खोल व्हतं.<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">पीडा लेयल देवदूत</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />नंतर मी मोठं अनं खुप आश्चर्यकारक अस दुसरं एक चिन्ह आकाशमा दखं, शेवटना सात पीडा लेयल सात देवदूत दखायनात, या पीडा शेवटन्या शेतस कारण त्यासनाद्वारे देवना क्रोध पुर्ण व्हयना.<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />मंग आग मिसाळेल काचना समुद्रनामायक काहीतरी माले दखायनं, श्वापदवर, त्याना मुर्तिवर अनं त्याना नावना संख्यावर विजय मिळायेल लोक हातमा देवनी वीणा लिसन त्या काचना समुद्रवर उभा राहेल माले दखायनात. <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />त्या देवना दास मोशे अनं कोकरानं गाणं गातांना म्हणतस;</para>
  <para style="q1" vid="REV 15:3">“हे प्रभु देवा, सर्वसमर्थ,</para>
  <para style="q2" vid="REV 15:3">तुनी कृत्ये थोर अनं आश्चर्यकारक शेतस;</para>
  <para style="q1" vid="REV 15:3">हे राष्ट्रसना राजा, तुना मार्ग नितीना अनं सत्य शेतस!<verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />हे प्रभु, तुले कोण घाबराऊ नही?</para>
  <para style="q2" vid="REV 15:4">तुना नावले कोण महिमा देवाव नही?</para>
  <para style="q2" vid="REV 15:4">कारण तुच मात्र पवित्र शे. अनी तुनी न्यायकृत्य सर्वासवर प्रगट व्हयेल शेतस,</para>
  <para style="q1" vid="REV 15:4">म्हणीन सर्व राष्ट्र तुनासमोर ईसन तुनी आराधना करतीन.”<verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />
    <note caller="+" style="f">
      <char style="fr" closed="false">15:5 </char>
      <char style="ft" closed="false">निर्गम 38:21</char>
    </note>नंतर मी दखं, तवय साक्षीना मंडपनं स्वर्गमाधलं मंदिर उघडनं. <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />अनी स्वच्छ अनं तेजस्वी तागना कपडा घालेल अनं छातीवरतीन सोनाना पट्टा बांधेल सात देवदूत सात पीडा लिसन त्या मंदिरमातीन निंघनात. <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />त्या चार प्राणीसपैकी एकनी युगानुयुग जिवत राहणारा देवना क्रोधतीन भरेल सोनान्या सात वाट्या त्या सात देवदूतसले दिध्यात. <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />तवय देवनं तेज अनं पराक्रम यासना पाईन निंघेल धुरघाई मंदिर भरी गयं, अनी त्या सात देवदूतसन्या सात पीडा संपापावत कोणले बी मंदिरमा जाता वनं नही.<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">देवना क्रोधन्या वाट्या</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />नंतर मी मंदिरमातीन बोलणारा मोठा आवाज ऐका, तो त्या सात देवदूतसले बोलना; “जा देवना क्रोधन्या सात वाट्या पृथ्वीवर वता!”<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />तवय पहिला देवदूतनी जाईन आपली वाटी पृथ्वीवर ओती तवय त्या श्वापदनी खुण करी लेयल अनी त्याना मुर्तिनी आराधना करनारा लोकसले खराब अनं त्रास देणारा फोड वनात.<verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />मंग दुसरा देवदूतनी आपली वाटी समुद्रमा ओती, तवय समुद्र मरेलसना रंगतनामायक रंगतमय व्हयना अनी त्यामाधला सर्व प्राणी मरी गयात.<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />मंग तिसरा देवदूतनी आपली वाटी नद्या अनं पाणीना झरा यासमा ओती अनी त्यानं रंगत व्हयनं. <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />तवय मी पाणीना अधिकारी देवदूतले अस बोलतांना ऐकं, “जो तु शे अनं व्हता, जो तु पवित्र शे तु असा न्यायनिवाडा करा तो न्याय योग्य शे! <verse eid="REV 16:5" /><verse number="6" style="v" sid="REV 16:6" />कारण त्यासनी पवित्र लोकसनं अनं संदेष्टासनं रंगत पाडं अनी तू त्यासले रंगत पेवाले भाग पाडेल शे, यानाकरता त्या पात्र शेतस!” <verse eid="REV 16:6" /><verse number="7" style="v" sid="REV 16:7" />नंतर वेदीमातीन येणारा आवाज मी ऐका, “हे, प्रभु देवा, हे सर्वसमर्थ! तुना न्याय सत्य अनं योग्य शेतस!”<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />मंग चौथा देवदूतनी आपली वाटी सूर्यवर ओती, अनं सूर्यले आगनामायक उष्णताघाई लोकसले जाळी टाकानी सुट देवामा वनी. <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />माणसं त्या कडक उष्णताघाई जळी गयात; तवय त्या पीडावर ज्याले अधिकार शे तवय देवना नावनी निंदा त्यासनी करी अनी त्यासना पापसपाईन फिरीन देवना वैभवनी स्तुती त्यासनी करी नही.<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />मंग पाचवा देवदूतनी आपली वाटी श्वापदना आसनवर ओती तवय त्यानं राज्य अंधकारमय व्हयनं, अनी लोकसनी वेदनासमुये आपली जिभ चाई. <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />आपला वेदनासमुये अनं आपला फोडसमुये त्यासनी स्वर्गना देवनी निंदा करी पण आपला कृत्यसबद्दल पापसपाईन फिरनात नही.<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />मंग सहावा देवदूतनी आपली वाटी फरात महानदीवर ओती अनी नदी सुकी गयी कारण पुर्वेकडतीन येणारा राजासकरता वाट तयार व्हवाले पाहिजे. <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />नंतर मी बेडकसनामायक तीन अशुध्द आत्मा अजगरना तोंडमातीन, श्वापदना तोंडमातीन अनं खोटा संदेष्टासना तोंडमातीन निंघतांना दखात. <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />त्या चमत्कार करनारा भूतसना आत्मा शेतस. त्या तीन आत्मा पुरा जगमाधला राजासले सर्वसत्ताधारी देवना त्या मोठ्या दिनना लढाईकरता एकत्र कराले त्यासनाकडे बाहेर जातस.<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:१५ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:43">मत्तय २४:४३</ref>,<ref loc="MAT 24:44">४४</ref>; <ref loc="LUK 12:39">लूक १२:३९</ref>,<ref loc="LUK 12:40">४०</ref>; <ref loc="REV 3:3">प्रकटीकरण ३:३</ref></char>
    </note>“ऐका! मी चोरनामायक ईसु! आपण नग्न अस चालाले नको अनं आपली लाज लोकसले दिसाले नको म्हणीन जो जागृत ऱ्हास अनं आपला कपडा संभाळी ठेवस तो धन्य!”<verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />नंतर दुष्ट आत्मासनी राजासले इब्री भाषामा अर्मगिदोन म्हणेल ठिकाणवर एकत्र करं.<verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />मंग सातवा देवदूतनी आपली वाटी हवामा ओती. मोठा आवाज मंदिरमातीन राजासनपाईन निंघणा तो बोलना, “व्हयनं!” <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" /><note caller="+" style="x"><char style="xo" closed="false">१६:१८ </char><char style="xt" closed="false"><ref loc="REV 8:5">प्रकटीकरण ८:५</ref>; <ref loc="REV 11:13">११:१३</ref>,<ref loc="REV 11:19">१९</ref></char></note>तवय ईजा, ध्वनी अनं मेघगर्जना व्हयनात, शिवाय मोठा भूकंप व्हयना, तो भूकंप ईतला भयंकर व्हता की, पृथ्वीवर माणुस व्हवापाईन ईतला भयंकर कधीच व्हयना नव्हता. <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />मोठा शहरना तीन भाग व्हयनात, सर्व राष्ट्रासना शहर कोसळनात. अनी देवनी मोठ्या बाबेल शहरनं आठवण दंड देवाकरता करी अनी तीले आपला तीव्र क्रोधना द्राक्षरसना प्याला पेवाले लावा. <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" /><note caller="+" style="x"><char style="xo" closed="false">१६:२० </char><char style="xt" closed="false"><ref loc="REV 6:14">प्रकटीकरण ६:१४</ref></char></note>सर्वा बेटं नष्ट व्हयनात, अनी डोंगरसना ठावठिकान राहिना नही. <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" /><note caller="+" style="x"><char style="xo" closed="false">१६:२१ </char><char style="xt" closed="false"><ref loc="REV 11:19">प्रकटीकरण ११:१९</ref></char></note>जवळपास चाळीस किलो वजनन्या मोठ्या गारा आकाशमातीन माणुसवर पडण्यात, तवय गारासना पीडामुये लोकसनी देवनी निंदा करी कारण ती पीडा भयानक व्हती.<verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">प्रसिध्द वेश्या</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />नंतर सात वाट्या पकडेल सात देवदूतसपैकी एकजण ईसन मनासंगे बोलाले लागणा, तो बोलणा, “ईकडे ये, म्हणजे बऱ्याच नदीसना जोडे बनाडेल मोठा शहरमा प्रसिध्द वेश्याले शिक्षा कशी व्हई हाई मी तुले दखाडस. <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />तिनासंगे पृथ्वीवरला राजासनी जारकर्म करात अनी तिना जारकर्मरूपी द्राक्षरसघाई पृथ्वीवर राहणारा मस्त व्हयनात.”<verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१७:३ </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:1">प्रकटीकरण १३:१</ref>
      </char>
    </note>मंग आत्मानी मना ताबा लिधा तवय देवदूत माले ओसाड प्रदेशमा लई गया, तठे देवनी निंदा करनारा नावसतीन लिखीन भरेल अनी सात डोका अनं दहा शिंगसना लाल रंगना श्वापदवर बशेल एक बाई माले दखायनी. <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />ती बाई जांभळा अनं सेंदूरना रंगना कपडा घालेल व्हती. अनं सोनं, मुल्यवान रत्न अनं मोती यासनी सजेल व्हती. तिना हातमा अमंगळ अनी गंध्यापटक वस्तुसघाई भरेल सोनाना प्याला व्हता. <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />तिना कपाळवर “मोठी बाबेल, सर्व वेश्यासनी अनं पृथ्वीवरली अमंगळपणानी आई,” हाई गुप्त अर्थनं नाव लिखेल व्हतं. <verse eid="REV 17:5" /><verse number="6" style="v" sid="REV 17:6" />ती बाई देवना लोकसना रंगततीन अनं येशुना साक्षीदारसना रंगततीन मस्त व्हयेल माले दखायनी. तिले दखीन माले फार आश्चर्य वाटनं. <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />देवदूत माले बोलना, “तुले आश्चर्य का बर वाटनं?” “ती बाई अनी सात डोका अनं दहा शिंगवाला तिले लई जाणारा श्वापद यासनं रहस्य मी तुले सांगस. <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" /><note caller="+" style="x"><char style="xo" closed="false">१७:८ </char><char style="xt" closed="false"><ref loc="REV 11:7">प्रकटीकरण ११:७</ref></char></note>जो श्वापद एकदाव जिवत व्हतं पण आते नही ते अथांग डोहमाईन बाहेर ई अनी नष्ट व्हतीन. जवय पृथ्वीवरला राहणारा लोके ज्यासना नाव जिवनी पुस्तकमा जगना उत्पत्तिपाईन त्यासनं नाव लिखेल नही त्या जवय श्वापदले दखतीन तवय त्या आश्चर्यचकीत व्हतीन, त्या एकदाव जिवत व्हतात, आते नही तरी पण त्या परत दखाई.” <verse eid="REV 17:8" /><verse number="9" style="v" sid="REV 17:9" />आठे समजाले बुद्धी अनं ज्ञान पाहिजे. त्या सात डोका म्हणजे सात डोंगर शेतस त्यानावर ती बाई बशेल शे, अनी त्या डोका म्हणजे सात राजा बी शेतस, <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />त्यासनापैकी पाच राजे पडेल शेतस, एक आता राज्य करी राहीना अनी एक अजुन येल नही शे तो येवावर त्याले राज्य कराले थोडाच येळ भेटी. <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />जे श्वापद पहिले जिवत व्हतं पण आते नही, तोच आठवा राजा शे, तो त्या सातस माईनच एक शे अनी त्याना बी नाश व्हई.<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />“ज्या दहा शिंगं तु दखात त्या दहा राजा शेतस, त्यासले अजुन राज्य मिळेल नही तरी त्यासले श्वापदसंगे थोडा येळ राजासनामायक अधिकार मिळस. <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />त्या सर्वा दहाजन एक उद्देशना शेतस अनी ते आपलं सामर्थ्य अनं अधिकार श्वापदले देतस. <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />त्या कोकरासंगे लढतीन, पण कोकरा त्यानी बलायेल, निवडेल अनी ईश्वासु अनुयायी यासनासंगे त्यासले हाराई कारण तो प्रभुसना प्रभु अनी राजासना राजा शे.”<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />आखो देवदूत माले बोलना, “जठे वेश्या बठेल शे, तठे जे जलप्रवाह तु दखात त्या जलप्रवाह म्हणजे राष्ट्र, लोक, वंश अनं येगयेगळा भाषा बोलणारा लोके शेतस. <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />ज्या दहा शिंगं अनं ज्या श्वापद तू दखं, त्या वेश्याना व्देष करी अनं तिले ओसाड अनं नग्न करतीन, तिनं मांस खातीन अनं तीले आगमा टाकीन नष्ट करतीन. <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />त्यासनी एक ईचारतीन वागीसन देवना वचनं पुर्ण व्हस तोपावत आपला राज्यना अधिकार श्वापदले देवानं असा उद्देशतीन कृती करानं अस देवनी त्यासना मनमा घालं.<verse eid="REV 17:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 17:18" />“जी बाई तू पहिले दखी ती पृथ्वीवरना राजासवर राज्य करणारं मोठं शहर शे.”<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">बाबेलोननं पतन</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />त्यानानंतर मी आखो एक देवदूतले स्वर्गमातीन उतरतांना दखं, त्याले मोठा अधिकार होता; अनी त्याना तेजघाई पृथ्वी प्रकाशीत व्हयनी. <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" /><note caller="+" style="x"><char style="xo" closed="false">१८:२ </char><char style="xt" closed="false"><ref loc="REV 14:8">प्रकटीकरण १४:८</ref></char></note>तो जोरमा वरडीन बोलना; “ती पडनी! मोठी बाबेल पडनी! ती भूतसघाई अनं अशुध्द आत्मासघाई झपाटेल शे; सर्व प्रकारना गंधा अनी किळस येणारा पक्षी तठे राहतस.” <verse eid="REV 18:2" /><verse number="3" style="v" sid="REV 18:3" />कारण तिना जारकर्मसकरता क्रोधरूपी द्राक्षरस सर्व राष्ट्र पियेल शेतस, पृथ्वीवरला राजासनी तिनासंगे जारकर्म करात अनं पृथ्वीवरला व्यापारी तिना अनैतीक वासनामुये श्रीमंत व्हयनात.<verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />मंग स्वर्गमातीन येल दुसरा आवाज मी ऐका, तो बोलना,</para>
  <para style="q1" vid="REV 18:4">मना लोकसवन, तुम्हीन तिना पापसना भागीदार व्हवु नका!</para>
  <para style="q2" vid="REV 18:4">अनी तुमले तिना शिक्षाना भागीदार व्हवाले नको;</para>
  <para style="q2" vid="REV 18:4">म्हणीसन तिनामातीन निंघा!<verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />कारण तीना पापसनी रांग स्वर्गपावत पोहचेल शे,</para>
  <para style="q2" vid="REV 18:5">अनी तिनी अनिती देवनी ध्यानमा लेयल शे.<verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />जस तिनी दिधं तसं तिले द्या,</para>
  <para style="q2" vid="REV 18:6">तिना कर्मप्रमाणी तिले दुप्पट द्या;</para>
  <para style="q2" vid="REV 18:6">तिनी प्याला माधलं जितलं वतं त्याना दुप्पट तुम्हीन त्यानामा वता.<verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />ज्या मानतीन तिनी आपला गौरव करा अनं सुख भोगात, त्या मानतीन तिले पीडा अनं दुःख द्या;</para>
  <para style="q1" vid="REV 18:7">कारण ती आपला मनमा म्हणस, “मी राणी व्हई बशेल शे! मी काही विधवा नही; मी दुःख दखाऊच नही!”<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />यामुये तिना पीडा म्हणजे मरण, दुःख अनं दुष्काळ एकच दिनले येतीन,</para>
  <para style="q2" vid="REV 18:8">अनी तीले आगमा जाळामा ई; कारण तिना न्यायनिवाडा करनारा प्रभु सामर्थ्यवान शे.<verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />पृथ्वीवरला ज्या राजासनी तिनासंगे जारकर्म करा अनं वासना करी त्या तीना पीडाना भितीमुये दूर उभा राहिसन तिना जळाना धूर दखतीन तवय तिनाकरता रडतीन अनी छाती ठोकतीन. <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />त्या म्हणतीन “कितलं भयंकर अनं कितलं वाईट! बाबेल मोठं अनी शक्तीशाली शहर व्हतं! थोडा येळमाच तुले शिक्षा व्हयेल शे!” <verse eid="REV 18:10" /><verse number="11" style="v" sid="REV 18:11" />पृथ्वीवरला व्यापारी तिनाकरता रडतस अनी शोक करतस कारण त्यासना माल लेवाले कोणीच तयार नही. <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />सोनं, रूपं, मुल्यवान रत्न, मोती, तागनं कापड, जाभंया रंगनं कपडा, रेशमी कापड, किरमीजी कपडा सर्व प्रकारन्या हत्तीना दातसन्या वस्तु, महाग लाकडंसपाईन बनाडेल, तांबं, पितळ, लोखंड, संगमरवरघाई बनाडेल सर्व वस्तु, <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />दालचिनी, सुगंधी उटणं, धुपद्रव्ये, सुगंधी तेल, ऊद, द्राक्षरस, जैतुननं तेल, पीठ, गहु, गुरं, मेंढरं, घोडा, रथ, गुलाम अनी माणुससना शरीर अनी जीव, हाऊ त्यासना माल कोणी ईकत लेस नही. <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />व्यापारी तिले म्हणतस, “त्या सर्व चांगल्या गोष्टी तुले मिळाडानी ईच्छा व्हती, त्या तुनापाईन नाहीसा व्हयेल शेतस, तुनी संपत्ती अनं तुनं वैभव तुनापाईन गयं, अनी ते तुले परत सापडावु नही!” <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />तिनामुये श्रीमंत व्हयेल त्या वस्तुसना व्यापारी रडत अनं शोक करत तीना पीडाना भितीमुये दूर उभा राहतीन. <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />अनं बोलतीन, “अरेरे, दखा, कितलं भयंकर कितलं वाईट व्हयनं हाई मोठं शहरनं, जे एक काळ सोनाना दागीना, तागना जाभंळा अनी किरमीजी कपडा ती नेसे अनी स्वतःले सोनं, मोतीना अनी रत्नंसना दागीनासघाई स्वतःले सजाडे. <verse eid="REV 18:16" /><verse number="17" style="v" sid="REV 18:17" />अनी एक क्षणमा या सर्व संपत्तीना नाश व्हयना!”</para>
  <para style="p" vid="REV 18:17">जहाजना सर्व प्रमुख अनी प्रवाशी, खलाशी अनी ज्या समुद्रवर व्यापार करीसन जगतस त्या सर्वा दुर उभा राहिनात. <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />अनं तीना जळाना धुर दखीन त्या आक्रोश करीसन बोलणात, “ह्या मोठा शहरनामायक कोणतं शहर कधीच व्हयनं नही!” <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />त्यासनी आपला डोकावर धुळ टाकी अनी रडत, शोक करत बोलणात, “अरेरे! कितलं भयंकर, कितलं वाईट, जिना धनसंपत्तीमुये समुद्रमाधला जहाजना मालक श्रीमंत व्हयनात ते मोठं शहर! तिनी थोडा येळमा सर्व गमाडं!”<verse eid="REV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20" />हे स्वर्गा, अहो देवना लोकसवन, प्रेषितसवन अनं संदेष्टासवन! तिनाबद्दल आनंद करा, कारण जस तीनी तुमनासंगे करं तसा देवनी तिना न्याय करेल शे!<verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />नंतर एक ताकदवान देवदूतनी जाताना मोठी तळीनामायक धोंडा उचला अनी तो समुद्रमा भिरकाई बोलना; “असच ते मोठं शहर बाबेल फटकामा टाकाई जाई अनं यानापुढे कधीच सापडावु नही.” <verse eid="REV 18:21" /><verse number="22" style="v" sid="REV 18:22" />वीणा वाजडणारा, गवई, पावा वाजडणारा अनं कर्णा वाजडणारा यासना नाद तुनामा यानापुढे ऐकु येवाव नही! कोणतं बी काम करनारा कारागीर यानापुढे तुनामा सापडावुच नही अनी जाताना आवाज यानापुढे तुनामा ऐकुच येवाव नही! <verse eid="REV 18:22" /><verse number="23" style="v" sid="REV 18:23" />दिवाना उजेड यानापुढे तुनामा परत कधी दिसावुच नही अनी नवरदेव नवरीना शब्द यानापुढे तुनामा ऐकु येवावुच नही, तुना व्यापारी पृथ्वीवरला सामर्थ्यशाली लोक व्हतात; अनी तुनी सर्व राष्ट्रना लोकसले खोटा जादूघाई फसाड! <verse eid="REV 18:23" /><verse number="24" style="v" sid="REV 18:24" />बाबेलले शिक्षा व्हयनी कारण संदेष्टासना, देवना लोकसनं अनं पृथ्वीवर मारामा येल, सर्वा लोकसनं रंगत ह्या बाबेल शहरमा सापडनं.<verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />यानानंतर स्वर्ग माधला लोकसनी मोठी गर्दीना जशा काय एक मोठा आवाज मी ऐका; तो बोलना, “देवनी स्तुती असो! तारण, गौरव अनं सामर्थ्य ह्या आमना देवना शेतस! <verse eid="REV 19:1" /><verse number="2" style="v" sid="REV 19:2" />कारण त्याना न्याय सत्यना अनं नीतिना शेतस, ज्या वेश्यानी आपला जारकर्मतीन पृथ्वी भ्रष्ट करी तिना न्यायनिवाडा त्यानी करेल शे अनी आपला दाससना रंगतबद्दल तिले शिक्षा करेल शे.” <verse eid="REV 19:2" /><verse number="3" style="v" sid="REV 19:3" />त्या दुसऱ्यांदाव बोलणात, “देवनी स्तुती असो! तिना धूर युगानुयुग वर चढी राहिना!” <verse eid="REV 19:3" /><verse number="4" style="v" sid="REV 19:4" />तवय त्या चोवीस वडील लोक अनं त्या चार प्राणी उपडा पडीन राजासनवर बशेल देवनी आराधना करीसन. बोलणात, “आमेन! देवनी स्तुती असो!”<verse eid="REV 19:4" /></para>
  <para style="s">कोकराना लगीननं जेवण</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />इतलामा राजासनपाईन आवाज व्हयना, तो बोलना, “अहो आमना देवनी भिती धरणारा सर्व धाकलामोठा दाससवन, त्यानी स्तुती करा!” <verse eid="REV 19:5" /><verse number="6" style="v" sid="REV 19:6" />तवय जशा काय मोठी लोकसनी गर्दीना आवाज, बराज जलप्रवाहसना आवाज अनं मोठा मेघगर्जनाना आवाज मी ऐका, तो बोलना, “देवनी स्तुती असो! कारण सर्वसमर्थ प्रभु देव हाऊ आमना राजा शे! <verse eid="REV 19:6" /><verse number="7" style="v" sid="REV 19:7" />आपण आनंद अनं उल्लास करूत अनं त्याना गौरव करू, कारण कोकरानं लगीननी येळ येल शे अनी त्याना नवरीनी स्वतःले सजाडेल शे. <verse eid="REV 19:7" /><verse number="8" style="v" sid="REV 19:8" />तिले तेजस्वी अनं शुध्द असा तागना कपडा नेसाले देयल शेतस, त्या तागना कपडा म्हणजे देवना लोकसना चांगला कृत्य शेतस.”<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१९:९ </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:2">मत्तय २२:२</ref>,<ref loc="MAT 22:3">३</ref></char>
    </note>तवय देवदूत माले बोलना, “हाई बी लिख की, कोकराना लगीनना मेजवानीले बलायेल त्या धन्य.” देवदूत माले अस बी बोलना “ह्या देवना सत्यवचनं शेतस.”<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />तवय मी त्यानापुढं गुडघा टेकीसन त्याले नमन करणार व्हतु, पण तो माले बोलना, “अस करू नको! मी तुना संगेना अनी ज्या येशुबद्दल साक्ष देतस त्या तुना भाऊना संगेना दास शे, नमन देवले कर, कारण येशुनी जी सत्यता प्रकट करी, ती संदेष्टाला प्रेरणा देस.”<verse eid="REV 19:10" /></para>
  <para style="s">पांढरा घोडावरला घोडेस्वार</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />नंतर मी स्वर्ग उघडेल अनी तठे एक पांढरा घोडा व्हता. घोडस्वारले ईश्वासु अनी सत्य अस म्हणेत; तो न्यायातीन न्यायनिवाडा करस अनं त्याना युध्द लढस. <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />त्याना डोया आगना ज्वालानामायक शेतस अनं त्याना डोकावर बराच मुकुट शेतस, त्यानावर एक नाव लिखेल शे, ते नाव काय व्हतं त्यानाशिवाय कोणलेच माहीत नही. <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />रंगतमा बुडायेल कपडा त्यानी आंगवर ओढेल व्हतात, अनी “देवना शब्द” हाई त्यानं नाव शे. <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />स्वर्गमाधलं सैन्य पांढरा घोडावर बठीन पांढरा अनं शुध्द असा तागना कपडा घालीन त्यानामांगे चाली राहिंती. <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" /><note caller="+" style="x"><char style="xo" closed="false">१९:१५ </char><char style="xt" closed="false"><ref loc="REV 14:20">प्रकटीकरण १४:२०</ref></char></note>त्यानी राष्ट्रासना पराभव कराले पाहिजे म्हणीसन त्याना तोंडमातीन तीक्ष्ण धारनी तलवार निंघस, तो त्यानावर लोखंडी दंडाघाई अधिकार गाजाडी, अनी सर्वसमर्थ देव याना क्रोधरूपी द्राक्षरसनं कुंड तो तोडस. <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />त्याना कपडासवर अनं त्याना मांडीसवर “राजासना राजा अनी प्रभुसना प्रभु” हाई नाव लिखेल शे.<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />नंतर मी एक देवदूतले सूर्यवर उभं राहेल दखं. तो अंतराळना मध्यभागमा उडणारा सर्व पक्षीसले मोठा आवाजतीन बोलना, “या, देवना महान जेवणनी मेजवणीकरता एकत्र व्हा! <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />राजासनं मांस, सरदारसनं मांस, घोडासनं त्यावर बठेल स्वारासनं मांस, स्वतंत्र अनं दास, धाकला अनं मोठा असा सर्व लोकसनं मांस खावाले या.”<verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />तवय ते श्वापद, पृथ्वीवरला राजा अनं त्यासनं सैन्य हाई घोडावर बठेल स्वारससंगे अनी त्याना सैन्यसंगे लढाई कराले एकत्र व्हयेल मी दखात. <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" /><note caller="+" style="x"><char style="xo" closed="false">१९:२० </char><char style="xt" closed="false"><ref loc="REV 13:1-18">प्रकटीकरण १३:१-१८</ref></char></note>मंग श्वापद धराई गयं अनी त्यानासंगे खोटा संटेष्टा बी धराई गया, त्यानी श्वापदसना समोर चमत्कार करात. या चमत्कारसनामुये ज्यासनावर श्वापदसनं चिन्ह व्हतं अनी ज्यासनी श्वापदसले नमन करं त्यासले बहकायेल व्हतं, श्वापद अनी खोटा संदेष्टा दोन्ही बी जिवतच भडकता गंधरसना अग्नीना सरोवरमा त्यासले टाकामा वनं. <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />घोडावर बठेल स्वारना तोंडमातीन निंघेल तलवारतीन त्यासना सैन्य माराई गयात अनी त्यासनं सर्व पक्षीसनी मांस खाईसन तृप्त व्हयनात.<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">एक हजार वरीस</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />नंतर मी एक देवदूतले स्वर्गमातीन उतरतांना दखं. त्यानाजोडे अथांग डोहनी किल्ली अनी साखळदंड व्हता. <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />त्यानी तो अजगर म्हणजे जुना साप ज्याले दियाबल अनं सैतान म्हणतस त्याले साखळदंडसघाई हजार वरीस बांधी ठेवं. <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />अनी ती हजार वरीस पुरा व्हवापर्यंत त्यानी राष्ट्रसले आखो फसाडाले नको म्हणीन त्याले देवदूतनी अथांग डोहमा टाकी दिधं अनी वरतीन बंद करीसन त्यानावर शिक्का मारा, त्यानानंतर त्याले थोडा येळ सोडाले पाहिजे.<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />नंतर मी राजासनं दखात, जे त्यानावर बठेल व्हतं, त्यासले न्यायनिवाडा कराना अधिकार देयल व्हता; अनी येशु बद्दलन्या साक्षमुये अनं देवना वचनमुये ज्यासना शिरच्छेद व्हयेल व्हता, अनी ज्यासनी श्वापदले अनं त्याना मुर्तिले नमन करेल नव्हतं अनी आपला कपाळवर अनं आपला हातवर त्यानी खुण धारण करेल नव्हती, त्यासना आत्मा बी दखात, त्या जिवत व्हयनात अनी त्यासनी ख्रिस्तसंगे एक हजार वरीस राज्य करं. <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />मरेलसपैकी बाकीना लोक, त्या हजार वरीस पुरा व्हवापावत जिवत व्हयनात नही, हाईच पहिलं पुनरूत्थान <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />पहिला पुनरूत्थानना ज्या भागीदार शेतस त्या पवित्र अनं धन्य शेतस; असा लोकवर दुसरा मरणनी सत्ता नही, तर त्या देवना ख्रिस्तना याजक व्हतीन; अनी त्यानासंगे एक हजार वरीस राज्य करतीन.<verse eid="REV 20:6" /></para>
  <para style="s">सैतानना पराभव</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />त्या हजार वरीस संपानंतर सैतानले कैदमातीन बंधमुक्त करामा ई, <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />अनी सैतान पृथ्वीना चार कोपरामाधला गोग अनं मागोग राष्ट्रसले फसाडाले अनी त्यासले लढाईकरता एकत्र कराकरता बाहेर ई, त्यासनी संख्या समुद्र किनारनी वाळू इतली शे. <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />त्यासनी पृथ्वीना विस्तारवर फिरीन पवित्र लोकसनी छावणी अनं आवडतं शहर यासले वेढा घाला, तवय स्वर्गमातीन अग्नी उतरना अनी त्यानी त्यासले नष्ट करं. <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />त्यासले फसाडणारा सैतानले अग्नीना अनं गंधकना सरोवरमा टाकामा वनं, त्यानामा श्वापद अनं तो खोटा संदेष्टा यासले पहिलेच टाकामा येल व्हतं, तठे त्यासले रातदिन युगानुयुग पीडा भोगनी पडी.<verse eid="REV 20:10" /></para>
  <para style="s">शेवटना न्याय</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />नंतर मोठं पांढरं राजासन अनं त्यानावर बठेल एकजण माले दखायना, त्याना तोंडसमोरतीन पृथ्वी अनं आकाश ह्या पळनात, त्यासनाकरता जागा उरनी नही. <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />मंग मरी जायेल धाकलामोठासले राजासनपुढे उभं राहेल मी दखं, त्या येळले पुस्तकं उघडाई गयात, तवय दुसरं एक पुस्तक उघडाई गयं ते जिवननं व्हतं अनी त्या पुस्तकमा लिखेलप्रमाणे मरेलसना न्याय ज्यासना त्यासना कृत्यसप्रमाणे करामा वना. <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />तवय समुद्रनी आपलामाधला मरेलसले बाहेर सोडं, मृत्यु अनं अधोलोक यासनी आपलामाधला मरेल माणससले बाहेर सोडं अनी ज्यासना त्यासना सर्वासना कृत्यसप्रमाणे त्यासना न्याय करामा वना. <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />तवय मरण अनं अधोलोक यासले अग्नीना सरोवरमा टाकामा वनं, अग्नीनं सरोवर हाई दुसरं मरण. <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />ज्यानं कोण नाव जिवनना पुस्तकमा लिखेल सापडनं नही, त्याले अग्नीना सरोवरमा टाकामा वनं.<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">नवं आकाश अनी पृथ्वी</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२१:१ </char>
      <char style="xt" closed="false">
        <ref loc="2PE 3:13">२ पेत्र ३:१३</ref>
      </char>
    </note>नंतर मी नवं स्वर्ग अनं नवं पृथ्वी दखी. पहिलं स्वर्ग अनी पहिली पृथ्वी ह्या नष्ट व्हयेल व्हतात अनी समुद्र बी राहिना नही. <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" /><note caller="+" style="x"><char style="xo" closed="false">२१:२ </char><char style="xt" closed="false"><ref loc="REV 3:12">प्रकटीकरण ३:१२</ref></char></note>तवय मी पवित्र शहर, नवं यरूशलेम, देवपाईन स्वर्गमातीन उतरतांना दखं. ते नवराकरता सजाडेल नवरीनामायक व्हतं. <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />अनी मी राजासनपाईन येल मोठा आवाज ऐका, तो असा दखा, “देवनं घर लोकससंगे शे, त्यासनासंगे देव राही, त्या त्याना लोक व्हतीन, अनी देव स्वतः त्यासनासंगे राही अनी तो त्यासना देव व्हई. <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />तो त्यासना डोयासना अश्रु पुशी टाकी; यानापुढे मरण नही; शोक, रडणं, अनं कष्ट ह्या नही ऱ्हावाव कारण जुन्या गोष्टी व्हई गयात.”<verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />तवय जो राजासनवर बठेल व्हता तो बोलना, “आते मी सर्वा गोष्टी नविन करस!” तो बोलना लिख, कारण ह्या वचनं ईश्वसनीय अनं सत्य शेतस. <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />तो बोलना, व्हयनं! मी पहिला अनं शेवटला, सुरवात अनं शेवट शे. मी तीस लागेलसले जिवनना झरानं पाणी पेवाना अधिकार दिसु अनं ते पाणी फुकट दिसु. <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />जो कोणी विजय मिळवस त्याले ह्या गोष्टी मनापाईन मिळतीन, मी त्यासना देव व्हसु अनी त्या मना पोऱ्या व्हतीन. <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />पण अईश्वासु, अमंगळ, खुन करनारा, व्यभिचारी, चेटकी, मुर्तिपुजक, अनं सर्वा लबाड माणसं यासना वाटामा अग्नीनं अनं गंधकनं सरोवर ई, हाईच ते दुसरं मरण शे.<verse eid="REV 21:8" /></para>
  <para style="s">नवं यरूशलेम</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />नंतर शेवटला सात पीडासघाई भरेल सात वाट्या ज्यासनी हातमा लेयल व्हत्यात असा सात देवदूतसपैकी एक देवदूत मनाकडे ईसन बोलना, “ये, मी तुले नवरी म्हणजे कोकरानी बायको दखाडस.” <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />तवय आत्मानी मना ताबा लिधा, अनं देवदूत माले उंच डोंगरना टोकवर लई गया, अनी त्यानी माले पवित्र शहर यरूशलेम देवपाईन स्वर्गमातीन उतरतांना दखाडं. <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />त्यानाठायी देवनं महिमानं तेज व्हतं, त्यानी कांती अति मुल्यवान रत्ननामायक व्हती, ते स्फटिकनामायक चमकणारा यास्फे खडानामायक व्हतं. <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />ते महान व्हतं, त्याले बारा उंच वेशी व्हत्यात, अनी वेशीसजोडे बारा देवदूत व्हतात. त्या वेशीसवर नावं लिखेल व्हतात; ती इस्त्राएलना संतानसना बारा वंशसनी व्हती. <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />प्रत्येक दिशाले तीन-तीन वेशी व्हत्यात. पुर्वकडे तीन, उत्तरकडे तीन, दक्षिणकडे तीन अनं पश्चिमकडे तीन वेशी व्हत्यात. <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />शहरनी भिंत बारा पायावर व्हती, त्यानावर कोकराना बारा प्रेषितसना नावं व्हतात. <verse eid="REV 21:14" /><verse number="15" style="v" sid="REV 21:15" />जो देवदूत मनासंगे बोली राहिंता त्यानाजोडे, त्याना वेशीनं अनं त्याना भिंतीसनं मोजमाप लेवाकरता सोनाना बोरू व्हता. <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />शहर चौकोन आकारनं व्हतं, त्यानी लांबी जितली व्हती तितलीच त्यानी रूंदी व्हती, त्यानी शहरनं माप बोरूघाई लिधं ते दोन हजार चारशे किलोमीटर भरनं त्यानी लांबी, रूंदी अनं उंची समान व्हती. <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />मंग देवदूतनी भिंतनं बी माप लिधं, ते दोनशे सोळा फुट अनी माणुसना हातघाई एक शे चौरेचाळीस हात भरनं, माणुसना हात म्हणजे देवदूतना हात. <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />ती भिंत यास्फे रत्ननी व्हती, अनी शहर शुध्द काचनामायक शुध्द सोनानं व्हतं. <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />शहरना पायाना खांब येगयेगळा मुल्यवान रत्नसघाई सजाडेल व्हतं. पहिला पायाना खांब यास्फे, दुसरा निळमणी, तिसरा शिवधातु, चौथा हिरवा पाचु. <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />पाचवा गोमेद, सहावा सार्दि, सातवा लसणा, आठवा वैडूर्य, नववा पुष्कराज, दहावा सोनलसणी, अकरावा याकींथ, बारावा पद्मराग असा बारा रत्नसना त्या व्हतात. <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />बारा वेशी बारा मोत्यासन्या व्हत्यात, एक एक वेस एक एक मोतीनी व्हती, शहरमाधला रस्ता पारदर्शक काचनामायक शुध्द सोनाना व्हता.<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />त्यानामा मंदिर मनं दखामा वनं नही, कारण सर्वसमर्थ प्रभु देव अनं कोकरा ह्याच त्या शहरना मंदिर व्हतात. <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />शहरले सूर्यचंद्रना प्रकाशनी गरज नही, कारण देवना तेजघाई ते प्रकाशीत करेल शे, अनी हाऊच कोकरा त्याना दिवा. <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />जग त्याना प्रकाशघाई चाली अनी पृथ्वीवरला राजा आपलं वैभव त्यामा लयतस. <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />तिना वेशी दिनभर उघड्या राहतीन त्या बंद व्हवाऊतच नही; रात तर तठे नहीच. <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />राष्ट्रसनं वैभव अनं प्रतिष्ठा शहरमा लयतीन. <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />त्यानामा कोणतीच निषिध्द गोष्ट अनी अमंगळपणा अनं लबाड बोलणारा माणुस याना प्रवेश व्हवाऊच नही, तर कोकराना जिवनना पुस्तकमा लिखेल लोकसना मात्र प्रवेश व्हई.<verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />नंतर देवदूतनी माले देवना अनं कोकराना राजासनमातीन निंघेल, शहरना रस्तावरतीन वाहणारी जिवनना पाणींनी, स्फटिकनामायक चमकणारी नदी दखाडी. <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />नदीना दोन्ही बाजुले बारा जातीसना फळ देणारा जिवनना झाड व्हतात. त्यानावर वरीसले बारा दाव फळ लागेत, त्या दर महिनाले एक फळ देत अनी त्या झाडना पानटा राष्ट्रसना आरोग्यकरता उपयोगी पडतस. <verse eid="REV 22:2" /><verse number="3" style="v" sid="REV 22:3" />पुढे शहरमा काय बी शापीत सापडावु नही.</para>
  <para style="p" vid="REV 22:3">तर शहरमा देवनं अनं कोकरानं राजासन राही अनी त्याना दास त्यानी सेवा करतीन. <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />त्या त्याना चेहरा दखतीन, अनं त्यानं नाव त्यासना कपाळवर राही. <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />पुढे रात ऱ्हावाव नही अनी त्यासले दिवानी किंवा सूर्यना उजेडनी गरज नही. कारण प्रभु देव त्यासनावर प्रकाश पाडी, अनी त्या युगानुयुग राज्य करतीन.<verse eid="REV 22:5" /></para>
  <para style="s">येशुनं येणं</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />नंतर देवदूत माले बोलणा, “ह्या वचनं ईश्वसनीय अनं सत्य शेतस. अनी संदेष्टासना आत्माना देव जो प्रभु त्यानी ज्या गोष्टी लवकर घडी येवाले पाहिजे, त्या गोष्टी आपला दाससले सांगाकरता आपला दूतले धाडं.”<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />येशु म्हणस, “ऐका! मी लवकर येवाव शे! ह्या भविष्यवाणीना पुस्तकमाधला संदेशवचनं पाळणारा तो धन्य!”<verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />हाई ऐकणारा अनं दखणारा मी योहान शे. जवय मी ऐकं अनं दखं तवय हाई माले दखाडणारा देवदूतले नमन कराकरता मी त्याना पाया पडनु; <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />पण तो माले बोलना, अस करू नको; मी तुना संगेना तुना भाऊ अनं संदेष्टा अनं ह्या पुस्तकमाधला वचनं पाळणारा लोक ह्याना संगेना दास शे; देवले नमन कर.<verse eid="REV 22:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 22:10" />परत तो बोलना, या पुस्तकमाधला, संदेशवचनं शिक्का मारीन बंद करू नको; कारण येळ जोडे येल शे. <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />जो चुकीना शे तो चुकीना काम करत राही अनी जो पापी शे तो पाप करत राही, जो चांगला शे तो चांगला कामे करत राही अनी जो पवित्र शे तो पवित्र कामे करत राही.<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />दखा, मी लवकर येस; अनी प्रत्येकले ज्याना त्याना कृत्यसप्रमाणे देवाले मनाजोडे वेतन शे. <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" /><note caller="+" style="x"><char style="xo" closed="false">२२:१३ </char><char style="xt" closed="false"><ref loc="REV 1:8">प्रकटीकरण १:८</ref>; </char><char style="xt" closed="false"><ref loc="REV 1:17">प्रकटीकरण १:१७</ref>; <ref loc="REV 2:8">२:८</ref></char></note>मी अल्फा अनं ओमेगा म्हणजे पहिला अनं शेवटला, आदि अनं अंत असा शे. <verse eid="REV 22:13" /><verse number="14" style="v" sid="REV 22:14" />आपलाले जिवनना झाडवर अधिकार मिळाले पाहिजे अनं वेशीमातीन शहरमा आपलं जाणं व्हवाले पाहिजे म्हणीन ज्या आपला झगा धोतस त्या धन्य. <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />पण कुत्रा, चेटकी, जारकर्मी, खुन करनारा, मुर्तिपुजक, लबाडीनी आवड धरणारा, अनं लबाडी करनारा सर्व लोक बाहेर राहतीन.<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />ह्या गोष्टीसले मंडळीसमा जाहीर कराकरता मी येशुनी, आपला दूतले मंडळीसमा धाडेल शे. मी दावीदना घरानाना वंशज शे; मी पहाटना तेजस्वी तारा शे.<verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />आत्मा अनं नवरी ह्या म्हणतस, “ये!” ऐकणाराही म्हणो, “ये!”</para>
  <para style="p" vid="REV 22:17">अनी तान्हेला येवो; ज्याले पाहिजे तो जिवनना पाणीनं बक्षिस फुकट लेवो.<verse eid="REV 22:17" /></para>
  <para style="s">शेवट</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />मी योहान, निश्चयपुर्वक सांगस की ह्या पुस्तकमाधला संदेशवचनं ऐकणारा प्रत्येकले, जो कोणी यानामा भर टाकी त्यानावर ह्या पुस्तकमा लिखेल पीडा देव आणी,<verse eid="REV 22:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 22:19" />अनी जो कोणी ह्या संदेशना पुस्तकमाधला वचनमाईन काढी टाकीन, त्याना वाटा ह्या पुस्तकमा सांगेल जिवनना झाडमातीन अनं पवित्र नगरमातीन देव काढी टाकी. <verse eid="REV 22:19" /><verse number="20" style="v" sid="REV 22:20" />ह्या गोष्दीसबद्दल साक्ष देणारा येशु म्हणस, “हो! मी लवकर येस!” आमेन.</para>
  <para style="p" vid="REV 22:20">ये, प्रभु येशु, ये.<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />प्रभु येशुनी कृपा सर्व लोकससंगे राहो.<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>