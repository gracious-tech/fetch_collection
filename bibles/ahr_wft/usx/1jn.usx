<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Ahirani</book>
  <para style="h">१ योहान</para>
  <para style="toc3">१ योहान</para>
  <para style="toc2">१ योहान</para>
  <para style="toc1">योहाननी लिखेल पहिलं पत्र</para>
  <para style="mt2">योहानाने लिहिलेले पहिले पत्र</para>
  <para style="mt1">योहाननी लिखेल पहिलं पत्र</para>
  <para style="imt">वळख</para>
  <para style="ip">योहाननं पहिलं पत्र प्रेषित योहान कडतीन येशु ख्रिस्तना जन्मनंतर ५०-१०० वरीसना मझार लिखाई गयतं. योहान स्वतःले लेखकना रूपमा वळखस नही पण पहिला अध्यायपाईन आपले दखास की, तो येशुनं जिवन अनी पुनरूत्थान याना साक्षीदार शे. <char style="xt"><ref loc="1JN 1:1-3">१:१-३</ref></char> योहानना १ पत्र मातील लिखाणशैली हाई योहानना शुभवर्तमान मातील लिखाणशैलीना मायकच शे अस म्हणतस. योहाननी त्यानं शुभवर्तमान अनी तीन पत्र या इफिस आठे राहतांना लिखात.</para>
  <para style="ip">योहाननी हाई पत्र ईश्वासनारासले लिखेल व्हतं. त्या येळले ज्ञानवादी<note caller="+" style="f"><char style="fr" closed="false">१:० </char><char style="ft" closed="false">ज्ञानवादी; ज्ञानबद्दलना तत्त्वसले माणनारा लोके</char></note> म्हणतस असा एक गट कडतीन त्यासले तरास व्हता. या लोके म्हणतस की, येशु ख्रिस्त पुर्णपणे देव व्हता पण तो असा मासघाई अनी रक्तघाई पृथ्वीवर मनुष्य नही व्हता. यामुये योहाननी येशुना जिवनकडे प्रत्येक्ष दखामुये अनी स्वतःना हातघाई येशुले स्पर्श करा <char style="xt"><ref loc="1JN 1:1-3">१:१-३</ref></char> म्हणीसन तो लिखस. हाई लिखाना योहानना हेतु त्याना आनंदले पुर्ण कराकरता व्हता. <char style="xt"><ref loc="1JN 1:4">१ योहान १:४</ref></char> ईश्वासणारासले पापसपाईन अनं खोटा शिक्षण <char style="xt"><ref loc="1JN 2:1">१ योहान २:१</ref></char> पाईन संरक्षण करीसन <char style="xt"><ref loc="1JN 2:26">१ योहान २:२६</ref></char> ईश्वासनारासनं तारण व्हवाले पाहिजे. <char style="xt"><ref loc="1JN 5:13">५:१३</ref></char></para>
  <para style="iot">रूपरेषा</para>
  <para style="io1">१. योहाननी आपलं पत्र लिखं अनी एकच उपदेश दिधा. <char style="ior"><ref loc="1JN 1:1-4">१:१-४</ref></char></para>
  <para style="io1">२. मंग तो देव प्रकाश शे अस स्पष्टीकरण करस अनी आपण येशुनामायक जिवन जगाले पाहिजे अशी सुचना तो देस. <char style="ior"><ref loc="1JN 1:5-3:10">१:५–३:१०</ref></char></para>
  <para style="io1">३. नंतर तो आपले एकमेकससंगे प्रिती करणारी आज्ञानी आठवण करी देस. <char style="ior"><ref loc="1JN 3:11-5:12">३:११–५:१२</ref></char></para>
  <para style="io1">४. त्यानी आपला पत्रनी समाप्ती करी. <char style="ior"><ref loc="1JN 5:13-21">५:१३-२१</ref></char></para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">जिवनना शब्द</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:1">योहान १:१</ref>
      </char>
    </note>आम्हीन जिवनना शब्दना बद्दल लिखं जे सुरवात पाईन व्हतं, जे आम्हीन ऐकेल शे, आम्हीन आमना डोयासघाई दखेल शे, अनी जे आम्हीन आमना हातसघाई तपाशी लिधं. <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" /><note caller="+" style="x"><char style="xo" closed="false">१:२ </char><char style="xt" closed="false"><ref loc="JHN 1:14">योहान १:१४</ref></char></note>ते जिवन प्रकट व्हयनं, ते आम्हीन दखेल शे, अनं त्यानी साक्ष आम्हीन देतस; ते सार्वकालिक जिवन पितानाजोडे व्हतं अनं आमले प्रकट व्हयनं ते तुमले बी सांगी राहीनुत;<verse eid="1JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 1:3" />जे आम्हीन दखेल शे अनं ऐकेल शे ते तुमले बी यानाकरता सांगतस की, तुम्हीन बी आमनामा एकत्र ऱ्हावाले पाहिजे; आपली सहभागीता तर पितानासंगे अनी त्याना पोऱ्या येशु ख्रिस्त यानासंगे शे; <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />आमना आनंद पुरा व्हवाले पाहिजे म्हणीसन आम्हीन हाई लिखी राहिनुत.<verse eid="1JN 1:4" /></para>
  <para style="s">देव प्रकाश शे</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />जो संदेश आम्हीन त्याना पोऱ्याकडतीन ऐकेल शे तो तुमले ऐकाडतस; तो संदेश हाऊ शे की, देव प्रकाश शे अनी त्यानामा कसानाच अंधार नही शे.<verse eid="1JN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 1:6" />जर आपण अस म्हणतस की, त्यानासंगे आमनी सहभागीता शे; पण अंधारमाच चालत राहिनुत, तर आपण खोटं बोली राहिनुत, सत्यतीन वागी नही राहीनुत; <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />जसं तो प्रकाशमा शे तसा जर आपण प्रकाशमा चालत राहिनुत तर आपली एकमेकससंगे सहभागिता शे, अनी त्याना पोऱ्या येशु यानं रक्त आपले सर्व पापसपाईन शुध्द करस. <verse eid="1JN 1:7" /><verse number="8" style="v" sid="1JN 1:8" />आमना मा पाप नही शे अस जर आम्हीन सांगत व्हसुत तर आम्हीन स्वतःले फसाडी राहीनुत, अनं आपलामा सत्य राहत नही. <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />जर आपण आपला पाप कबुल करात, तर तो ईश्वसनीय अनं न्यायी शे म्हणीसन आपला पापसनी क्षमा करी, अनं आपले सर्व वाईटसपाईन शुध्द करी. <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />आम्हीन पाप करं नही, अस जर आम्हीन सांगं, तर आपण परमेश्वरले खोटं ठरावतस अनी त्याना वचन आपलामा राहत नही.<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">ख्रिस्त आमना मदतगार</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />अहो मना पोऱ्यासवन, तुम्हीन पाप कराले नको म्हणीसन हाई पत्र तुमले लिखी राहिनु. जर कोणी पाप करं, तर नितीसंपन्न असा जो येशु ख्रिस्त तो पितानाजोडे आपला मदतगार शे, <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />अनी तोच आपला पापसनी क्षमा करस; फक्त आपलाच पापसबद्दल नही तर सर्व जगना बी पापबद्ल शे.<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />आपण जर त्याना आज्ञा पाळसुत तर त्यावरतीन आपले समजी जाई की, आपण त्याले समजी लिधं. <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />मी त्याले वळखस अस म्हणीसन जो त्याना आज्ञा पाळस नही तो लबाड शे, अनी सत्य त्यानामा नही शे. <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />जो कोणी त्याना वचनप्रमाणे चालस, त्यानामा देवनी प्रिती खरच पुर्ण व्हयेल शे. यानावरतीन आपले समजी जाई की, आपण त्यानामा एक शेतस. <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />मी त्यानामा ऱ्हास, अस जो सांगस त्यानी येशु ख्रिस्त जसं चालना तसा स्वतः बी चालाले पाहिजे.<verse eid="1JN 2:6" /></para>
  <para style="s">नवी आज्ञा</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२:७ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:34">योहान १३:३४</ref>
      </char>
    </note>मना प्रिय लोकसवन, मी तुमनाकरता नवी आज्ञा लिखस नही; तर जी आज्ञा सुरवात पाईन तुमले देवामा येल शे तिच जुनी आज्ञा लिखस; जे वचन तुम्हीन ऐकं तीच ती जुनी आज्ञा शे. <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />मी तुमले एक प्रकारे नवी आज्ञा लिखस. ती ख्रिस्तमा अनं तुमनाबाबतमा खरच तसच शे; कारण अंधार आते नष्ट व्हई ऱ्हायना, अनं खरा प्रकाश आते चमकाले लागेल शे. <verse eid="1JN 2:8" /><verse number="9" style="v" sid="1JN 2:9" />मी प्रकाशमान शे अस म्हणीसन जो आपला भाऊ अनी बहिणीसना व्देष करस तो अजुन अंधारमाच शे. <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />आपला बंधुवर प्रिती करनारा प्रकाशमा ऱ्हास, अनी तो दुसरासकरता अडखळण व्हस नही; <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />पण जो आपला बंधुना व्देष करनारा शे तो अंधारमा शे अनं अंधारमाच चालस; तो कोठे चाली राहिना हाई त्यानं त्यालेच समजस नही, कारण अंधारनी त्याना डोया आंधया करेल शेतस.<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />पोऱ्यासवन, मी तुमले लिखस, कारण त्याना नावमुये तुमना पापसनी तुमले क्षमा व्हयेल शे. <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />बापसवन, मी तुमले लिखस, कारण जो सुरवात पाईन शे त्याले तुम्हीन वळखतस तरूणसवन, मी तुमले लिखस, कारण जो दुष्ट शे त्याले तुम्हीन हरायेल शे. <verse eid="1JN 2:13" /><verse number="14" style="v" sid="1JN 2:14" />पोऱ्यासवन, मी तुमले लिखी ऱ्हायनु शे, कारण तुम्हीन बापले वळखतस. बापसवन, मी तुमले लिखी ऱ्हायनु शे, कारण जो सुरवात पाईन शे त्याले तुम्हीन वळखतस, तरूणसवन, मी तुमले लिखी ऱ्हायनु शे, कारण तुम्हीन बलवान शेतस. कारण देवनं वचन तुम्हानामा ऱ्हास अनी त्या दुष्टले तुम्हीन जिंकेल शेतस.<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />जगन्या अनं जगमाधल्या गोष्टीसवर प्रिती करू नका, जर कोणी जगवर प्रिती करत व्हई तर त्यानामा पितानी प्रिती नही शे. <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />कारण जगमा सर्वकाही शे ते म्हणजे शरिरनी वासना, डोयासनी वासना, अनं संसारनाबद्दल फुशारकी, हाई पितापाईन नहीत, तर जगपाईन शेतस; <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />जग अनी त्यानी वासना हाई नष्ट व्हई ऱ्हायनं शे; पण पिताना ईच्छाप्रमाणे करनारा सर्वकाळ ऱ्हास.<verse eid="1JN 2:17" /></para>
  <para style="s">ख्रिस्तविरोधी</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />पोऱ्यासवनं, हाई शेवटली येळ शे, अनी ख्रिस्तविरोधक ई अस तुम्हीन ऐकेल शे त्यानाप्रमाणे आत्तेच बराच ख्रिस्तविरोधक ऊठेल शेतस; ह्यानावरतीन आपले दखाई जाई की, हाई शेवटली येळ शे. <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />आपलामाईनच जर त्या निंघनात तर त्या आपला नव्हतात; त्या आपला जर ऱ्हातात तर आपलासंगेच ऱ्हातात; त्यासनामाईन कोणी बी आपला नही हाई दिसाले पाहिजे म्हणीन त्या निंघनात. <verse eid="1JN 2:19" /><verse number="20" style="v" sid="1JN 2:20" />जो पवित्र आत्मा त्यानाकडीन तुमना अभिषेक व्हयेल शे, म्हणीन तुमले सर्वासले ज्ञान शे.<verse eid="1JN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 2:21" />तुमले सत्य समजस नही म्हणीसन मी अस लिखी नही ऱ्हायनु; तुमले ते समजस अनी कोणतं बी लबाडी सत्यपाईन नही, म्हणीसन हाई मी लिखं. <verse eid="1JN 2:21" /><verse number="22" style="v" sid="1JN 2:22" />येशु हाऊ ख्रिस्त शे अस जो नाकारस त्यानाशिवाय कोणी लबाड नही? जो पिताले अनं पुत्रले नाकारस तोच खरा ख्रिस्तविरोधी शे. <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />जो कोणी पोऱ्याले नाकारस त्याले पिता लाभस नही; तर जो पोऱ्याना स्विकार करस त्याले पिता लाभेल शे. <verse eid="1JN 2:23" /><verse number="24" style="v" sid="1JN 2:24" />तुमनाबद्दल सांगस, जो संदेश तुम्हीन सुरवात पाईन ऐकेल शे तो तुम्हानामा राहो. जे तुम्हीन सुरवात पाईन ऐकं ते जर तुम्हानामा राहिनं तर तुम्हीन बी पुत्रमा अनं पितामा ऱ्हाशात. <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />हाई अभिवचन त्यानी स्वतः आपले देयल शे, तेच सार्वकालिक जिवन शे.<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />तुमले भयकाडणारा लोकसबद्ल मी हाई तुमले लिखी ऱ्हायनु शे. <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />तुमनाबद्दल सांगानं तर त्यानाकडना पवित्र आत्मा जो तुम्हानामा ऱ्हास, तवय तुमले कोणी शिकाडानं यानी गरज नही, त्याना पवित्र आत्मा सत्य शे, खोटा नही शे, तुमले सर्व गोष्टीसबद्दल शिकाडं तसच तुम्हीन त्यानामा एक राहतस.<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />तर आते पोऱ्यासवनं, त्यानामा एक ऱ्हा, यानाकरता की, तो जवय प्रकट व्हई तवय आपलामा हिम्मत ऱ्हावाले पाहिजे, अनी त्याना येवाना येळले त्यानापाईन लाजीसन माघार लेवानी गरज पडाले नको. <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />तो न्यायसंपन्न शे हाई जर तुमले माहित शे तर जो कोणी नीतितीन चालस तो देवपाईन जन्मेल शे हाई बी तुमले माहित शे;<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="s">देवना संतान</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:12">योहान १:१२</ref>
      </char>
    </note>आपले देवना पोऱ्या हाई नाव मिळेल शे ह्यामा पिता आपलावर कितलं प्रेम करस हाई दखा; अनी आपण तसाच शेतस. यामुये जग आपले वळखत नही, कारण त्यासनी देवले वळखच नही. <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />मना प्रिय लोकसवन, आते आपण देवना पोऱ्या शेतस; अनी पुढं आपण काय व्हसुत हाई अजुन प्रकट व्हयेल नही; तरी तो प्रकट व्हई तवय आपण त्यानामायक व्हसुत हाई आपले माहित शे, कारण जसं ख्रिस्त शे तसाच तो आपले दखाई.<verse eid="1JN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 3:3" />जो कोणी त्यानाबद्ल हाई आशा धरस तो, जसं ख्रिस्त शुध्द शे, तस आपले शुध्द करस.<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />जो कोणी पाप करस तो देवना नियमविरूध्द करस; कारण पाप नियमविरोधी शे. <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" /><note caller="+" style="x"><char style="xo" closed="false">३:५ </char><char style="xt" closed="false"><ref loc="JHN 1:29">योहान १:२९</ref></char></note>तुमले माहित शे की, पापले काढी टाकाकरता ख्रिस्त प्रकट व्हयना; त्यानामा पाप नही. <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />जो कोणी ख्रिस्तमा एक व्हईसन ऱ्हास तो पाप करस नही; जो पाप करस तो त्याले दखास नही अनं त्याले वळखस बी नही.<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />पोऱ्यासवनं, कोणी तुमले बहकावाले नको; जसं ख्रिस्त नितीमान शे तसच नितीमा चालनारा बी न्यायसंपन्न शे. <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />पाप करनारा सैतानंना शे; कारण सैतान सुरवात पाईन पाप करी ऱ्हायना शे. सैतानंना कृत्य नष्ट कराकरताच देवना पोऱ्या प्रकट व्हयेल शे. <verse eid="1JN 3:8" /><verse number="9" style="v" sid="1JN 3:9" />जो कोणी देवपाईन जन्मेल शे तो पाप करस नही; कारण त्याना स्वभाव त्यानामा ऱ्हास; त्यानाघाई पाप व्हस नही, कारण तो देवपाईन जन्मेल शे.<verse eid="1JN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1JN 3:10" />यावरीन देवना पोऱ्या अनं सैतानंना पोऱ्या उघड दखातस. जो कोणी नितीमा वागस नही तो देवना नही शे, अनं जो आपला बंधुवर प्रिती करस नही तो बी नही.<verse eid="1JN 3:10" /></para>
  <para style="s">एकमेकसवर प्रेम करा</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:११ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:34">योहान १३:३४</ref>
      </char>
    </note>जो संदेश तुम्हीन सुरवात पाईन ऐका तो हाऊच शे की, आपण एकमेकसवर प्रिती करानी; <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />काईन तर त्या दुष्टना व्हता अनं त्यानी आपला भाऊले मारी टाकं, त्यानामायक आपण ऱ्हावाले नको. त्यानी त्याले कसाकरता मारी टाकं? कारण काईनना कृत्य दुष्ट व्हतात अनी त्याना भाऊना कामे नितीना व्हतात.<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />मना भाऊ अनी बहिणीसवन, जग तुमना व्देष करस यानं नवल करू नका. <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" /><note caller="+" style="x"><char style="xo" closed="false">३:१४ </char><char style="xt" closed="false"><ref loc="JHN 5:24">योहान ५:२४</ref></char></note>आपण बंधुजनसवर प्रिती करतस यावरूतीन आपले समजस की, आपण मरणमातीन निंघीसन जिवनमा येल शेतस. जो प्रिती करतस नही तो मरणमाच ऱ्हास. <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />जो कोण आपला बंधुना व्देष करस तो खुनी शे; अनी कोणता बी खुनीमा सार्वकालिकना जिवन ऱ्हास नही, हाई तुमले माहित शे. <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />ख्रिस्तनी आपलाकरता स्वतःना प्राण दिधा ह्यानावरतीन आपले देवनी खरी प्रितीनी जाणीव व्हयेल शे; तवय आपणबी आपला भाऊ अनी बहिणीसकरता स्वतःना प्राण देवाले पाहिजे. <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />मंग जोडे संसारनी वस्तु ऱ्हाईसन अनं आपला बंधुले यानी गरज शे अस दखीसन बी जो स्वतःले त्यानी दया येऊ देस नही त्यानामा देवनी प्रिती कशी ऱ्हाई?<verse eid="1JN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 3:18" />मना पोऱ्यासवनं, आपला शब्दसघाई किंवा जिभघाई नही, तर काम करीसन अनं सत्यमा ऱ्हाईन आपण प्रिती करानी.<verse eid="1JN 3:18" /></para>
  <para style="s">देवना समोर उभं ऱ्हावानी हिम्मत</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />आपण सत्यना शेतस हाई आपले यानावरीन समजी जाई; अनी परमेश्वरना सहवासमा आम्हीन आत्मा ईश्वासतीन राहसुत. <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />कारण आपला मनपेक्षा देव श्रेष्ठ शे; त्याले सर्वकाही समजस.<verse eid="1JN 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 3:21" />प्रियजनहो, आपलं मन जर आपले दोषी नही ठरावत व्हई, तर देवना समोर येवाले आपले हिम्मत शे. <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />अनी आपण जे काही मांगतस ते आपले त्यानापाईन मिळस, कारण आपण त्याना आज्ञा पाळतस अनं त्याले जे आवडस त्यानाप्रमाणेच करतस. <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" /><note caller="+" style="x"><char style="xo" closed="false">३:२३ </char><char style="xt" closed="false"><ref loc="JHN 13:34">योहान १३:३४</ref>; <ref loc="JHN 15:12">१५:१२</ref>,<ref loc="JHN 15:17">१७</ref></char></note>परमेश्वरनी आज्ञा हाईच शे की, त्याना पोऱ्या येशु ख्रिस्त ह्याना नाववर आपण ईश्वास ठेवाले पाहिजे; अनी त्यानी आपले देयल आज्ञाप्रमाणे आपण एकमेकसवर प्रिती कराले पाहिजे. <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />परमेश्वरनी आज्ञा पाळनारा माणुस त्यानामा ऱ्हास अनं तो त्या माणुसमा ऱ्हास. त्यानी जो आत्मा आपले देयल शे, त्यानावरीन आपले समजस की, तो आपलामा ऱ्हास.<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">देवना आत्मा अनी दुष्ट आत्मा</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />मना प्रिय लोकसवन, प्रत्येक आत्माना ईश्वास धरू नका, तर त्या आत्मा देवपाईन शेतस की नही ह्यानाबद्दल त्यासनी परिक्षा करा; कारण बराच खोटा संदेष्टा जगमा ऊठेल शेतस.<verse eid="1JN 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1JN 4:2" />देवना आत्माले तर यानावरतीन वळखा; शरीर धारण करीसन येल येशु ख्रिस्तले जो आत्मा कबुल करस तो देवनापाईन शे; <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />जो आत्मा येशुले कबुल करस नही, तो देवनापाईन नही शे. हाऊच ख्रिस्तविरोधकना आत्मा शे; तो येवावं शे हाई तुम्हीन ऐकेल शे अनी तो जगमा आते बी शे. <verse eid="1JN 4:3" /><verse number="4" style="v" sid="1JN 4:4" />पोऱ्यासवनं, तुम्हीन देवना शेतस अनी त्यासनावर तुम्हीन जय मियाडेल शे; कारण जगमा जो शे त्यानापेक्षा तुम्हानामा जो शे तो महान शे.<verse eid="1JN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 4:5" />त्या तर जगना शेतस म्हणीसन त्यासना बोलनं जगना गोष्टीविषयी ऱ्हास, अनी जग त्यासनं ऐकी लेस. <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />आपण देवना शेतस; जो देवले वळखस तोच आपलं ऐकस; जो देवना नही तो आपलं ऐकस नही. ह्यानावरीन सत्यना आत्मा कोणता अनं भ्रांतीना आत्मा कोणता हाई आपण वळखतस.<verse eid="1JN 4:6" /></para>
  <para style="s">देव प्रिती शे</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />प्रियजनहो, आपण एकमेकसवर प्रिती करानी, कारण प्रिती देवपाईन शे; जो कोणी प्रिती करस तो देवपाईन जन्मेल शे, अनं देवले वळखस. <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />जो प्रिती करस नही तो देवले वळखस नही; कारण <note caller="+" style="x"><char style="xo" closed="false">४:८ </char><char style="xt" closed="false"><ref loc="EXO 34:6">निर्गम ३४:६</ref></char></note>देव प्रिती शे. <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />देवनी आपला एकुलता एक पोऱ्याले जगमा धाडेल शे, यानाकरता की, त्यानाद्वारे आपले जिवन प्राप्त व्हई; ह्यानावरीन देवनी आपलावरनी प्रिती प्रकट व्हयनी. <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />प्रिती हिलेच म्हणतस की, आम्हीन देववर प्रिती करी म्हणीसन नही तर देवनी तुमना आमनावर प्रिती करी अनी ज्यानामुये आमना पापसनी क्षमा व्हई अस बलिदान म्हणीसन देवनी स्वतःना पोऱ्याले धाडं. <verse eid="1JN 4:10" /><verse number="11" style="v" sid="1JN 4:11" />प्रियजनहो, देवनी जर आपलावर अशी प्रिती करी तर आपणबी एकमेकसवर प्रिती कराले पाहिजे.<verse eid="1JN 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 4:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१२ </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:18">योहान १:१८</ref>
      </char>
    </note>देवले कोणीच कधीच दखेल नही; आपण एकमेकसवर प्रिती करत ऱ्हायनु तर देव आपलामा ऱ्हास, अनी त्यानी प्रिती आपलामा पुर्ण व्हस.<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />आपण त्यानामा अनं तो आपलामा ऱ्हास, हाई आपण ह्यानावरीन वळखस की, त्यानी स्वतःना आत्मा आपले देयल शे. <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />आम्हीन दखेल शे अनं आम्हीन साक्ष देतस की, पितानी पोऱ्याले जगना तारणहार म्हणीसन धाडेल शे. <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />येशु हाऊ देवना पोऱ्या शे, अस जो कबुल करस त्यानाठायी देव ऱ्हास अनं तो देवना ठायी ऱ्हास. <verse eid="1JN 4:15" /><verse number="16" style="v" sid="1JN 4:16" />देवनी आपलावर जी प्रिती शे ती आपले समजी जायेल शे अनं आपण तिनावर ईश्वास ठेयल शे. देव प्रिती शे; जो प्रितीमा ऱ्हास तो देवमा ऱ्हास अनं देव त्यानामा ऱ्हास.<verse eid="1JN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1JN 4:17" />न्यायना दिनना बाबत आपलामा हिम्मत ऱ्हावाले पाहिजे म्हणीसन त्यानी प्रिती आपलामा असा प्रकारमा पुर्ण व्हस; कारण जसं ख्रिस्त शे तसाच आपण बी हाई जगमा शेतस.<verse eid="1JN 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 4:18" />प्रितीनाठायी भय ऱ्हास नही; एवढंच नही तर पुर्ण प्रिती भयले काढी टाकस; भयमा शिक्षा ऱ्हास अनी भय धरणारा प्रितीमा पुर्ण व्हयेल नही. <verse eid="1JN 4:18" /><verse number="19" style="v" sid="1JN 4:19" />सुरवातले त्यानी आपलावर प्रिती करी, म्हणीसन आपण प्रिती करतस. <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />मी देववर प्रिती करस, अस म्हणीसन जो आपला बंधुना व्देष करस तो लबाड शे; कारण आपला भाऊले दखीसन बी त्यानावर जो प्रिती करस नही त्यानाघाई नही दखेल देववर प्रिती करणं शक्य नही. <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />जो देववर प्रिती करस त्यानी आपला भाऊ अनी बहिणीसवर बी प्रिती कराले पाहिजे, हाई त्यानी आपले आज्ञा शे.<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">जगवर विजय मिळाडानं</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />येशु हाऊ ख्रिस्त, असा जो कोणी ईश्वास धरस तो देवपाईन जन्मेल शे, अनी जो कोणी जन्मदातावर प्रिती करस, तो त्यानापाईन जन्मेल वर बी प्रिती करस. <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />आपण देववर प्रिती करतस अनं त्याना आज्ञा पाळतस तवय त्यानावरिन आपले समजस की, आपण देवना लेकरसवर प्रिती करतस. <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" /><note caller="+" style="x"><char style="xo" closed="false">५:३ </char><char style="xt" closed="false"><ref loc="JHN 14:15">योहान १४:१५</ref></char></note>देववर प्रिती करानं म्हणजे त्याना आज्ञा पाळनं शे; अनी त्याना आज्ञा कठीण नही शेतस. <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />कारण जे काही देवपाईन जन्मेल शेतस त्या जगवर जय मियाडतस; अनी ज्यानी जय मियाडेल शे तो म्हणजे आपला ईश्वास.<verse eid="1JN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 5:5" />येशु देवना पोऱ्या शे असा ईश्वास जो धरस त्यानाशिवाय जगवर जय मियाडनारा कोणी नही?<verse eid="1JN 5:5" /></para>
  <para style="s">येशु ख्रिस्तबद्दल साक्ष</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />जो पाणीनाद्वारा अनं रक्त द्वारा वना तो हाऊच येशु ख्रिस्त; फक्त पाणीनाद्वारा नही, तर पाणीघाई अनं रक्तघाई बी वना. आत्मा हाऊ साक्ष देणारा शे, कारण आत्मा सत्य शे. <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />साक्ष देणारा तिनच शेतस; <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />आत्मा, पाणी अनं रंगत; ह्या तिन्हीसनी साक्ष एकच शे. <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />आपण माणसंसनी साक्ष स्विकारतस पण तिनापेक्षा देवनी साक्ष मोठी शे, जी साक्ष देवनी त्याना पोऱ्याबद्ल दिधी; तिच हाई त्यानी साक्ष शे. <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />जो देवना पोऱ्यावर ईश्वास ठेवस त्याना मनमा साक्ष ऱ्हास; जो देववर ईश्वास ठेवस नही तो त्याले लबाड ठरावस, कारण जी साक्ष देवनी आपला पोऱ्याबद्ल देयल शे तिनावर त्यानी ईश्वास ठेवा नही. <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" /><note caller="+" style="x"><char style="xo" closed="false">५:११ </char><char style="xt" closed="false"><ref loc="JHN 3:36">योहान ३:३६</ref></char></note>ती साक्ष हाईच शे की, देवनी आपले सार्वकालिक जिवन देयल शे अनी हाई जिवन त्याना पोऱ्यामा शे. <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />ज्याले देवना पोऱ्या लाभेल शे त्याले जिवन लाभेल शे; ज्याले देवना पोऱ्या लाभना नही त्याले जिवन लाभना नही.<verse eid="1JN 5:12" /></para>
  <para style="s">अनंत जिवन</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />देवना पोऱ्याना नाववर ईश्वास ठेवनारा तुमले अनंत जिवन लाभेल शे हाई तुमले समजाले पाहिजे म्हणीसन मी हाई तुमले लिखी ऱ्हायनु शे.<verse eid="1JN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 5:14" />देवना समोर येवाकरता आपले जी हिम्मत शे ते यानावरीन की, आपण त्याना ईच्छाप्रमाणे काही मांग तवय तो आपलं ऐकी. <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />जवय बी आम्हीन त्यानाकडे मांगतस तवय तो आमनं ऐकस अनी आमले माहीत शे की, हाई खरं शे, अनी हाई माहीत शे की, जवय बी आम्हीन त्यानाकडे मांगतस तो आमले देस.<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />ज्याना परिणाम मरण नही असा पाप करतांना आपला भाऊले किंवा बहिणले कोणी दखं तर त्यानी त्यानाकरता देवनाजोडे मांगानं म्हणजे तो त्याले जिवन देई; अर्थात ज्याना परिणाम मरण नही असा पाप करनारासले ते दी, ज्याना परिणाम मरण शे असा बी पाप शे; अनी यानाविषयी मांगानं अस मी म्हणस नही. <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />सर्व प्रकारना अनिती पापच शे; तरी पण ज्याना परिणाम मरण नही. अस बी पाप शे.<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />जो कोणी देवपाईन जन्मेल शे तो पाप करस नही, हाई आपले माहित शे; जो देवपाईन जन्मेलसले तो त्याले सुरक्षित ठेवस अनी त्या दुष्टना संपर्क त्याले व्हस नही. <verse eid="1JN 5:18" /><verse number="19" style="v" sid="1JN 5:19" />आपण देवपाईन शेतस हाई आपले माहित शे; सर्व जग त्या दुष्टले वश व्हयेल शे. <verse eid="1JN 5:19" /><verse number="20" style="v" sid="1JN 5:20" />आपले माहित व्हयेल शे की, देवना पोऱ्या येल शे, अनी जो सत्य देवले वळखानी बुध्दी आपले देयल शे. जो सत्य शे त्यानाठायी, म्हणजे त्याना पोऱ्या येशु ख्रिस्तमा आपण एकत्र राहतस. हाऊच खरा देव अनी सार्वकालिक जिवन शे. <verse eid="1JN 5:20" /><verse number="21" style="v" sid="1JN 5:21" />पोऱ्यासवनं, तुम्हीन स्वतःले खोटा देवसपाईन दूर ठेवा.<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>