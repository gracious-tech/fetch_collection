<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Ahirani</book>
  <para style="h">२ करिंथ</para>
  <para style="toc3">२ करिंथ</para>
  <para style="toc2">२ करिंथ</para>
  <para style="toc1">पौलनी लिखेल करिंथकरसले दुसरं पत्र</para>
  <para style="mt2">पौलाने लिहलेले करिंथकरास दुसरे पत्र</para>
  <para style="mt1">पौलनी लिखेल करिंथकरसले दुसरं पत्र</para>
  <para style="imt">वळख</para>
  <para style="ip">करिंथकरसले हाई दुसरं पत्र प्रेषित पौल यानी येशु ख्रिस्तना ५५-५६ वरीस नंतर लिखं<char style="xt"><ref loc="2CO 1:1">१:१</ref> </char>आठे करिंथकरासले ज्या दोन पत्र पौलनी लिखात त्यानामाधलं हाई दुसरं पत्र शे. बराच विद्वान अस समजतस की, या पत्रसना पहिले करिंथकरसले एक मोठं कडक पत्र लिखेल व्हतं. यानाबद्दल तो<char style="xt"><ref loc="2CO 2:3-4">२:३-४</ref></char> या वचनसमा उल्लेख करस, पण या पत्रसन्या प्रती आपलाकडे नही शेतस. हाई पत्र पौलनी मासेदोनियामातीन लिखेल व्हई अशी संभावना शे. <char style="xt"><ref loc="2CO 2:13">२:१३</ref></char></para>
  <para style="ip">दुसरं करिंथ हाई एक अस पत्र शे की, ज्यामा वैयक्तिक अनी भावनात्मक गोष्टीसनी चर्चा शे. या पत्रमा पौलनी चांगलाच अहवाल करिंथकरसबद्दल तिता कडतीन मिळाडा अनी त्यानाबद्दल तो आनंद व्यक्त करस. या पत्रमा दान देवाबद्दलनं नविन करारना दृष्टीकोणतीन हाई शिक्षण देयल शे, अस दखास. हाई शिक्षण त्या भागमा दखास ज्या भागमा पौल दानना उल्लेख करस की, जो यरूशलेमना ईश्वास ठेवणारासले मदत करता गोया करेल व्हती. <char style="xt"><ref loc="2CO 8-9">८–९</ref></char></para>
  <para style="ip">मंडळीमा काही लोके पौलना विरोधमा व्हतात अनी काही बाहेरतीन येल लबाड प्रेषित हाई विरोधना फायदा लिसन पौलले दाबीन स्वतःनी उन्नती करी राहींतात. त्यासनी पौलना अधिकारवर प्रश्न उपस्थित करात. यामुये येशु ख्रिस्तना प्रेषित या नातातीन जो अधिकार त्याले भेटेल शे, त्या अधिकारले शेवटला भागमा तो दखाडस.</para>
  <para style="iot">रूपरेषा</para>
  <para style="io1">१. पौलना करिंथ मंडळीले नमस्कार. <char style="ior"><ref loc="2CO 1:1-7">१:१-७</ref></char></para>
  <para style="io1">२. पौल आपला प्रवास योजनामा बदल करस, करिंथना लोकसना अहवाल अनी त्यावर प्रतिक्रीया. <char style="ior"><ref loc="2CO 1:8-7:16">१:८–७:१६</ref></char></para>
  <para style="io1">३. यरूशलेममा राहणारा ईश्वास ठेवणारासकरता वर्गणी गोळा कराबद्दल पौलनी सुचना. <char style="ior"><ref loc="2CO 8:1-9:15">८:१–९:१५</ref></char></para>
  <para style="io1">४. शेवट पौल आपला प्रेषितपणना बचाव करस अनी आपली येणारी भेटबद्दल इशारा करस. <char style="ior"><ref loc="2CO 10:1-13:10">१०:१–१३:१०</ref></char></para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:1">प्रेषित १८:१</ref>
      </char>
    </note>करिंथ आठली देवनी मंडळीले अनी तिनासंगे अखया प्रदेशमातील सर्व पवित्र लोकसले देवनी ईच्छातीन प्रभु येशुना शिष्य बनेल पौल अनी आपला बंधु तिमथ्य यासनाकडतीन;<verse eid="2CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2" />देव आपला पिता अनं प्रभु येशु ख्रिस्त यासनाकडतीन तुमले कृपा अनी शांती असो.<verse eid="2CO 1:2" /></para>
  <para style="s">पौल देवना उपकार मानस</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />आपला परमेश्वर अनी प्रभु येशु ख्रिस्तना बाप जो देव, दया करनारा देवबाप अनी सर्वासले सांत्वना देणारा देव, तो धन्यवादित असो.<verse eid="2CO 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 1:4" />तो आमनावरला सर्व संकटमा आमले दिलासा देस, त्या मदतमुयेच आमले स्वतः देवकडतीन दिलासा मिळस, त्या मदतमुये ज्या कोणी, कोणता बी संकटमा शेतस त्यासले मदत कराले आम्हीन समर्थ व्हवाले पाहिजे, <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />कारण ख्रिस्तनं दुःख जसं आमनाकरता भरपुर व्हस तसं ख्रिस्तनी मदत बी आमले भरपुर व्हस, <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />आमनावर संकट येस, ते तुमले मदत अनी तुमना उध्दार व्हवाले पाहिजे म्हणीन येस; आमले दिलासा मिळस ती यानाकरता की तुमले मदत मिळाले पाहिजे अनी ज्या दुःख आम्हीन सोसतस ती तुम्हीन धीरतीन सहन करानी. <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />तुमनाबद्दल आमनी आशा भक्कम अशी शे, कारण आमले माहीत शे की जशा तुम्हीन आमना दुःखमा भागीदार शेतस, तसच तुम्हीन मदतना बी भागीदार शेतस.<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:८ </char>
      <char style="xt" closed="false">
        <ref loc="1CO 15:32">१ करिंथ १५:३२</ref>
      </char>
    </note>भाऊसवन, आशिया प्रांतमा आमनावर येल संकटबद्दल तुम्हीन अजाण ऱ्हावाले पाहिजे अशी आमनी ईच्छा नही; ते अस की, आम्हीन आमना सहनशक्ती पेक्षा जास्ती गोष्टीसमा दडपाई गवुत; ईतलं की, आम्हीन जगसुत किंवा जगावुत नही अस आमले व्हई गयतं. <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />आम्हीन मरणारच शेतस अस आमनं मन आमले सांगी राहींत; पण आम्हीन स्वतःवर नही तर जो मरेलसले ऊठाडणारा देव शे फक्त त्यानावरच आशा ठेवाले पाहिजे, यानाकरता हाई व्हयनं, <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />त्यानी आमले ईतला मोठा प्राणसंकट माईन वाचाडं, अनी तो आते वाचाडी राहीना, तो आमले यानापुढे बी वाचाडी, अशी त्यानावर आमनी आशा शे. <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />तुम्हीन बी आमनाकरता प्रार्थना करीसन आमले मदत करा; म्हणजे आमले देवकडतीन आशिर्वाद भेटी अनं त्यानाबद्दल बराच लोके देवना उपकार मानतीन.<verse eid="2CO 1:11" /></para>
  <para style="s">पौलनी योजनामा बदल</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />आमले अभिमान वाटानं कारण म्हणजे आमना मननी साक्ष हाई शे की, मानवी ज्ञानतीन नही, तर देवनी कृपा, देवनी देयल पवित्रतातीन अनी सात्विकपणतीन आम्हीन जगमा अनी विशेष करीसन तुमनासंगे वागनुत. <verse eid="2CO 1:12" /><verse number="13-14" style="v" sid="2CO 1:13-14" />आम्हीन तेच लिखतस जे तुम्हीन वाचतस अनी समजतस, तरी बी तुम्हीन आमले थोडं समजतस, मी आशा करस की शेवटी तुम्हीन आमले पुरं समजी लेशात, यामुये जवय येशु ख्रिस्त परत ई जसं आते तुम्हीन आमनावर गर्व करतस तसं आम्हीन तुमनावर गर्व करसुत.<verse eid="2CO 1:13-14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />असा ईश्वास करीसन तुमले दुप्पट आशिर्वाद मिळाले पहिजे म्हणीसन, मी पहिले तुमनाकडे येवाले पाहिजे, <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" /><note caller="+" style="x"><char style="xo" closed="false">१:१६ </char><char style="xt" closed="false"><ref loc="ACT 19:21">प्रेषित १९:२१</ref></char></note>तुमना कडतीन मासेदोनिया जावं अनी नंतर मासेदोनियातीन परत तुमनाकडे यावं, अनी तुम्हीन माले यहूदीयाकडे धाडी देवानं. <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />तर असा मना बेत व्हता, तवय मी चंचलपणा करा का? किंवा माले, “हा, हा” म्हणता यावं अनी “नही, नही” बी म्हणता यावं म्हणीसन जे मी ठरावस ते स्वार्थीपणतीन ठरावस का? <verse eid="2CO 1:17" /><verse number="18" style="v" sid="2CO 1:18" />देव ईश्वासु शे, आमनं तुमनासंगे बोलनं, हा, नही, अस नही शे. <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" /><note caller="+" style="x"><char style="xo" closed="false">१:१९ </char><char style="xt" closed="false"><ref loc="ACT 18:5">प्रेषित १८:५</ref></char></note>कारण देवना पोऱ्या येशु ख्रिस्त ह्याना घोषणा आमनाकडतीन, म्हणजे मी, सिल्वान अनी तिमथ्य यासनाकडतीन तुमनामा व्हयनी ती “हा” अनं “नही” अशी व्हयनी नही, तर त्यामा देवनं “हा” हाईच व्हयनं. <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />देवना वचनं कितला बी राहोत, त्यानामा “हा” हाईच शे; यामुये देवनं गौरव व्हवाले पाहिजे म्हणीसन त्यानाकडतीन “आमेन” हाई बी शे. <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />जो आमना अभिषेक करीसन तुमले ख्रिस्तमा पक्क करस; तो देव शे. <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />आम्ही त्याना शेतस अनी आमनावर त्याना शिक्का शे, त्यानी त्याना पवित्र आत्मा आमले देयल शे.<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />देवले साक्षी ठिसन मी मना जिवनी शप्पथ लेस की! मी करिंथ आठे येवानं राहू दिधं कारण माले तुमनावर संताप कराना नव्हता. <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />आम्हीन तुमना ईश्वासवर सत्ता करतस अस नही, तर आम्हीन तुमना आनंदना सोबती शेतस, तुमनी परिस्थिती शे, ती तुमना ईश्वासतीन शे.<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />मी स्वतः हाऊ निश्चय करेल व्हता की, तुमले दुःख देवाले परत फिरीन येवानं नही. <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />कारण की जर मी तुमले दुःख देस, तर ज्याले मनापाईन दुःख व्हस, तर त्यानाशिवाय माले आनंद देणारा कोण शे? <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />मी हाईच तुमले लिखेल व्हतं, हाई यानाकरता की मी येवावर, ज्यासनाकडतीन माले आनंद व्हणार शे त्यासकडतीन माले दुःख व्हवाले नको, माले तुमना सर्वासबद्दल असा भरवसा शे की, मना आनंद तो तुमना सर्वासना आनंद शे. <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />मी भलताच संकटमा अनी मनस्तापमा व्हतु तवय अश्रु ढाळीसन तुमले लिखेल व्हत; तुम्हीन दुःखी व्हवाले पाहिजे म्हणीसन नही, तर तुमनावर जे मनं विशेष प्रेम शे, ते तुम्हीन वळखाले पाहिजे म्हणीसन मी लिखं.<verse eid="2CO 2:4" /></para>
  <para style="s">चुका करनारासले क्षमा</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />कोणी दुःख देयल व्हई तर त्यानी ते मालेच नही, तर थोडफार तुमले सर्वासले बी देयल शे. मी हाई बोलानं कारण माले त्यानाबद्दल कडक व्हवानी ईच्छा नही शे. <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />असा माणुसले बहुमततीन जी शिक्षा दिधी तीच त्याले पुरी शे. <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />त्या माणुसनी आपला दुःखमा बुडीन ऱ्हावाले नको म्हणीसन, उलट तुम्हीन त्याले माफ करीसन त्याले दिलासा देवाना, हाई चांगलं शे. <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />यामुये मी तुमले ईनंती करस की, तुम्हीन त्यानावर प्रिती करतस हाई त्याले दखाडा. <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />हाई मी यानाकरता लिखेल व्हतं की, तुम्हीन सर्व प्रकारतीन आज्ञा पाळणारा शेतस का नही यानं माले प्रमाण पटाले पाहिजे. <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />तुम्हीन एखादाले कसाबद्दल तरी माफ करतस त्यानाबद्दल त्याले मी बी माफ करस. कारण मी कसाबद्दल तरी माफ करेल व्हई तर ज्या कसाबद्दल माफ करं ते तुमनाकरता ख्रिस्तनासमोर करेल शे, <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />यानाकरता की सैताननं आपलावर डावपेच चालाले नको; त्याना ईचार आपले समजस नही अस नही.<verse eid="2CO 2:11" /></para>
  <para style="s">त्रोवासामा पौलले तरास</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">२:१२ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:1">प्रेषित २०:१</ref>
      </char>
    </note>जवय मी ख्रिस्तनी सुवार्ता सांगाकरता त्रोवासा शहरले वनु, तवय तठे माले काम कराकरता देवना ठायी दार उघडनं. <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />पण तीत नावना मना भाऊ माले भेटना नही, म्हणीसन मना जिवले चैन पडनं नही, मंग तठला लोकसना निरोप लिसन मी मासेदोनिया प्रांतमा निंघी गऊ.<verse eid="2CO 2:13" /></para>
  <para style="s">ख्रिस्त कडतीन जयोत्सव</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />जो देव आमले कायम ख्रिस्तमा जयोत्सवतीन लई जास, अनी सर्व ठिकाणे आमनाकडतीन ख्रिस्तबद्दलना ज्ञानना सुंगध प्रकट करस. त्यानी स्तुती असो. <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />तारण भेटी राहीनात असा अनी नाश व्हई राहीनात असा लोकसकरता आम्हीन देवले ख्रिस्तना सुंगध असा शेतस. <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />ज्या हारी जायेल शेतस त्यासले मृत्युना वास अनी ज्यासनं तारण व्हई राहीनं जिवनदाई गंध शे. हाई काम कराले कोण लायक शे. <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />बराच लोके आपला फायदाकरता देवना वचनमा भेसळ करीसन ते बिघाडी टाकतस तसा आम्हीन नही, तर जसं आमले देवनी धाडं. आम्हीन शुध्द मनतीन ख्रिस्तना सेवक या नातातीन बोलणारा शेतस.<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="s">नवा करारना सेवक</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />दखा आम्हीन परत आमनीच वाहवाह कराले लागनुत का? जशी दुसरासले तशी आमले तुमनाकडे किंवा तुमना कडतीन शिफारस पत्र लेवानी गरज शे का? <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />तुम्हीनच आमनं पत्र, आमना मनमा लिखेल, सर्व लोकसले समजेल अनी त्यासनी वाचेल असा शेतस. <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />शाईघाई नही, तर सदा जिवत देवना आत्माघाई लिखेल, दगडी पाटीवर नही, तर मानवी अंतःकरणरूपी पाटीवर लिखेल आमनी सेवामुये व्हयेल तुम्हीन ख्रिस्तनं पत्र शेतस.<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />त्यामुये आम्हीन अस बोलतस कारण ख्रिस्त कडतीन देववर आमले भरोसा शे. <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />आम्हीन कोणती बी गोष्ट स्वतःव्हईसन ठरावा पुरता समर्थ शेतस असा दावा आम्हीन करतस नही, कारण आमनं सामर्थ्य देवकडतीन शे. <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />त्यानीच आमले नवा करारना सेवक व्हवाकरता समर्थ करं; तो लेखी नियम नही शे, तर पवित्र आत्माकडतीन शे; कारण नियम मारी टाकस, आत्मा जिवत करस.<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />मोशेना त्या नियम ज्याना अक्षर दगडसवर कोरेल व्हतात, त्या एवढा तेजस्वी व्हतात की, त्यामुये मोशेना चेहरावरलं तेज संपी गय, तरी बी इस्त्राएल लोकसले त्याना तोंडाकडे नजर लावता ये नही, <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />तर पवित्र आत्मानी सेवा विशेष करीसन तेजस्वी व्हवाव नही का? <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />कारण जी सेवाना परिणाम दंड आज्ञा ती तेजोमय व्हस, तर जीना परीणाम तारण शे ती विशेष करीसन जास्तच तेजस्वी व्हई, <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />इतलंच नही तर, अति तेजस्वी नविन तेजना तुलनामा जुनं ते संपी राहिनं. <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />नष्ट व्हत जाई राहीनं अस जर तेजमय शे, तर जे टिकावु ते विशेष करीसन तेजस्वी राव्हावं शे.<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />तर मंग आमले अशी आशा शे म्हणीसन आम्हीन बिनधास्त बोलतस. <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />इस्त्राएल लोकसनी संपनारा गोष्टिसना अंतवर दृष्टी लावाले नको म्हणीसन मोशे आपला तोंडले झाकी ले तसं आम्हीन करतस नही; <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />पण त्यासना मने कठीण व्हयनात, कारण जुना करार वाचामा येस तवय त्यासनं मन झाकेल ऱ्हास आजपावत तसच शे, पण जवय एखादा व्यक्ती ख्रिस्तले जोडाई जास तवय तो पडदा उघडाई जास. <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />आजपावत मोशेना ग्रंथ वाचामा येस तवय त्यासनं अंतःकरण झाकेल ऱ्हास; <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />पण त्या प्रभुकडे वळनात म्हणजे झाकेल उघडाई जास. <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />प्रभु आत्मा शे; अनी जठे प्रभुना आत्मा शे तठे मोकळीक शे. <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />पण आपला तोंडवर झाकेल नही, आपण सर्वाजन आरसाना मायक प्रभुना वैभवनं प्रतिबिंब पाडी ऱ्हाइनुत अनी प्रभु जो आत्मा त्यानाकडतीन, महान तेजतीन, आपलं रूपांतर व्हत ऱ्हास तवय आपण त्यानामायक व्हत जातस.<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">मातीना भांडामा धन</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />देवनी दयामुये, हाई सेवा आमले देवामा येल शे, म्हणीसन आम्हीन हिम्मत सोडतस नही; <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />आम्हीन लाज वाटी असा गुप्त गोष्टी सोडी देयल शेतस, आम्हीन कपटतीन चालतस नही, अनी देवना वचनबद्दल कपट करतस नही, तर सत्य प्रकट करीसन देवसमक्ष आम्हीन स्वतःले प्रत्येक मनुष्यना मनमा चांगला ठरावतस, <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />जर आम्हीन जी सुवार्ता सांगतस ती झाकेल शे तर हाई झाकेल त्यासनाकरता शे ज्यासना नाश व्हई राहीना. <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />त्यासनाबद्दल या युगना राजा सैतान हाऊ ईश्वास नही ठेवनारा लोकसनं मनसले आंधय करेल शे, यानाकरता की देवनी प्रतिमा जो ख्रिस्त त्याना तेजोमय सुवार्ताना प्रकाश त्यासले दिसाले नको. <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />आम्हीन आमनं नही, तर ख्रिस्त येशु हाऊ देव अशी त्यानी घोषणा करतस, अनी येशुमुये आम्हीन तुमना दास अशी स्वतः घोषणा करतस. <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />अंधारमाईन उजेड चमकी, अस जो देव बोलना ते, येशु ख्रिस्तना तोंडवरलं देवनं जे तेज शे त्यानं ज्ञान दखावाले पाहिजे म्हणीसन त्यानी आमनं अंतःकरण प्रकाशीत करेल शे.<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />हाई आत्मिक संपत्ती आमनामा शे ज्या आम्हीन मातीना भांडानामायक शेतस, हाई यानाकरता शे की महान सामर्थ्य देवकडतीन व्हस, आमनाकडतीन व्हस नही हाई समजाले पाहिजे. <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />आमनावर चारीमेरतीन संकट वनात, तरी आम्हीन संपनुत नही; घोटाळामा पडनुत तरी निराश व्हयनुत नही; <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />आमना पाठलाग व्हयना तरी बी त्यासनी आमना स्विकार करा; आम्हीन खाल पडनु तरी आमना नाश व्हयना नही. <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />आम्हीन येशुनं मरण कायम आमना शरिरमा लिसन फिरतस कारण येशुनं जिवन आमना शरिरमा प्रकट व्हवाले पाहिजे. <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />कारण आम्हीन जिवन जगी राहिनुत, ते येशुमुये मरणकरता कायमना सोपाई जाई राहीनुत, यानाकरता की येशुनं जिवन बी आमना मरेल शरिरमा प्रकट व्हवाले पाहिजे. <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />आमनामा तर मरणनं कार्य पण तुमनामा तर जिवन आपलं कार्य चालाडस. <verse eid="2CO 4:12" /><verse number="13" style="v" sid="2CO 4:13" />“मी ईश्वास धरा म्हणीसन बोलनु;” जश शास्त्रलेख म्हणस जो ईश्वासना आत्मा तोच आत्मा आमनामा शे, म्हणीसन आम्हीन ईश्वास धरतस अनी बोलतस बी. <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />हाई आमले माहित शे की ज्यानी प्रभु येशुले ऊठाडं तो येशुसंगे आमले बी ऊठाडी, अनी तुमनासंगे उभं करी. <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />सर्वकाही तुमनाकरता शे, यानाकरता की जी कृपा बराच जणसवर व्हईसन विपुल व्हयनी. ती देवना गौरवकरता धन्यवादमा वाढानं कारण बनाले पाहिजे.<verse eid="2CO 4:15" /></para>
  <para style="s">ईश्वासतीन जगनं</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />यामुये आम्हीन हिम्मत सोडतस नही; आमनं बाहेरनं शरीर मरी जाई राहीनं, तरी अंतर आत्मा दिनदिनमा नवा व्हई राहीना. <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />कारण आमनावर थोडा येळकरता येनारं अनी धाकलं संकट हाई आमनाकरता मोठा प्रमाणमा सार्वकालिक गौरव लई येस; <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />आम्हीन दखावणारी वस्तुकडे नही, तर नही दखावणारी वस्तुकडे ध्यान देतस; कारण दखावणारी वस्तु थोडा येळकरता शे, पण नही दखावणारी वस्तु सार्वकालिक शे.<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="s">आमना स्वर्गीय शरीर</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />कारण आमले माहीत शे की, आमनं पृथ्वीवरलं मंडपनासारखं घर मोडं तरी, स्वर्गमा देवकडतीन भेटेल एक घर शे; ते हाततीन नही बांधेल, सार्वकालिक अस शे. <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />ह्या घरमा असतांना आम्हीन स्वर्गरूपी कपडा घालानी ईच्छातीन कन्ही राहीनुत. <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />अनी आम्हीन ह्या कपडा घालसुत तवय उघडा सापडावुत नही, <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />जोपावत आम्हीन ह्या संसारना मंडपमा शेतस, तोपावत आम्हीन वझाखाल दाबाईसन कन्ही राहीनुत, कारण आमले जगीक शरीर नही तर स्वर्गीय शरीर पाहिजे याकरता की जे काही मरणनं शे ते जिवनना द्वारा गिळाई जाई, <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />ज्यानी आमले यानाकरता तयार करं तो देव शे, त्यानी आमले बदलामा पवित्र आत्मा देयल शे.<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />यामुये आम्हीन कायम हिम्मत ठेवतस, अनी हाई बी ध्यानमा ठेवतस की जोपावत आम्हीन शरिरमा राहतस जे आमनं जगीक घर शे, तोपावत प्रभुनापाईन दुर शेतस. <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />आम्हीन ईश्वासतीन चालतस जे आम्हीन दखतस त्यानामायक चालतस नही. <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />आम्हीन धैर्य धरतस, अनी शरिरना बाहेरना प्रवासी राहिसन बी प्रभुनासंगे स्वर्गीय घरमा ऱ्हावाले आमले अधिक चांगलं वाटस. <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />यामुये आम्हीन पृथ्वीवर राहीनुत किंवा त्यानासंगे राहिनुत तरी त्याले खूश करानी आमनी हौस शे. <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" /><note caller="+" style="x"><char style="xo" closed="false">५:१० </char><char style="xt" closed="false"><ref loc="ROM 14:10">रोम १४:१०</ref></char></note>कारण आपले सर्वासले ख्रिस्तना न्यायासनना पुढे खरा अर्थतीन प्रकट व्हवाले पाहिजे, यानाकरता की त्यानी प्रत्येकले, त्यानी शरीरतिन करेल गोष्टीसनं फळ मिळाले पाहिजे; मंग त्या चांगल्या राहोत नही तर वाईट राहोत.<verse eid="2CO 5:10" /></para>
  <para style="s">ख्रिस्तद्वारा देवसंगे मैत्री</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />आम्हीन प्रभुनं मानीसन लोकसले समजुत घालतस; देवले तर आम्हीन प्रकट शेतस; अनी तुमना मनमा बी प्रकट शेतस, अशी आशा आम्हीन धरतस. <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />आम्हीन तुमना जोडे परत आमनी वाहवाह करतस नही, तर तुमले आमनाबद्दल अभिमान करानी येळ येवाले पाहिजेल म्हणीसन अस बोलतस; यानाकरता की जो मनमा नही तर तोंडवर अभिमान बाळगस त्याले तुमले उत्तर देता येवाले पाहिजे. <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />आम्हीन येडा व्हयनुत तर ते देवनाकरता, अनी आम्हीन शुध्दीवर राहीनुत तर ते तुमनाकरता शेतस. <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />ख्रिस्तनं प्रेम आमले आवरी धरस, आम्हीन अस समजतस की एक सर्वाकरता मरना, तर सर्व मरनात. <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />अनी तो सर्वाकरता याकरता मरणा की ज्या जगतस त्यासनी यानापुढे स्वतःकरता नहीतर त्यानाकरता जो मरना अनी परत ऊठना त्यानाकरता जगानं.<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />आत्तेपाईन आम्हीन कोणले मनुष्यना समजनुसार वळखतस नही; अनी जरी आम्हीन ख्रिस्तले मनुष्यना समजनुसार वळखेल व्हतं तरी आते त्याले यानापुढे तसं वळखतस नही. <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />जर कोणी ख्रिस्तमा शे तर तो नवी उत्पत्ति शे; जुनं ते व्हई गयं; दखा, ते नवं व्हयेल शे. <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />हाई सर्व देवपाईन शे; त्यानी तुमले आमले जोडानं काम ख्रिस्तनाद्वारा करं, अनी एकमेकसले जोडानी सेवा आमले दिधी. <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />म्हणजे जगमातील लोकसना पापे त्यासनाकडे नही मोजता, देव ख्रिस्तमा आपलासंगे जगले जोडी राहिंता; अनी त्यानी आमनाकडे लोकसले जोडानं वचन सोपी दिधं.<verse eid="2CO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20" />यामुये देव आमना कडतीन बोध करी लेवानामायक आम्हीन ख्रिस्तना बाजुतीन वकिली करतस; देवनासंगे जोडेल तुम्हीन व्हवाले पाहिजे, अशी मनी ख्रिस्तना कडतीन ईनंती करस. <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />ज्याले पाप माहित नव्हतं, त्याले त्यानी तुमना आमनाकरता पाप अस कर; यानाकरता की आपण देवना नितीमान व्हवाले पाहिजेल.<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />आम्हीन देवसंगे सर्व कामं करी राहिनुत; म्हणीसन ईनंती करस की तुम्हीन देवनी कृपाना स्विकार व्यर्थ व्हवु देवाले नको; <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />कारण देव म्हणस; आनंदना येळले मी तुनं ऐकं, अनी उध्दारना दिनले मी तुले मदत करी; दख, आत्तेच “प्रसादनी येळ” दख, आत्तेच “तारणना दिन शे;” <verse eid="2CO 6:2" /><verse number="3" style="v" sid="2CO 6:3" />आमनी सेवाले दोष लागु नही म्हणीसन आम्हीन कोणताच प्रकारना अडखळणन कारण व्हतस नही; <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />तर सर्व गोष्टीसमा देवना सेवकसनामायक आम्हीन स्वतःले सादर करतस; बरीच सहनशीलतातीन, संकटसमातीन, विपत्तीतीन अनी अडचणीसमातीन; <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" /><note caller="+" style="x"><char style="xo" closed="false">६:५ </char><char style="xt" closed="false"><ref loc="ACT 16:23">प्रेषित १६:२३</ref></char></note>फटकातीन, कैदमातीन, दंगा, कष्ट, जागरन, उपासतीन; <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />शुध्दतातीन, ज्ञानतीन, धीरतीन, ममतातीन, पवित्र आत्माना सामर्थ्यतीन, निष्कपट प्रितीतीन, <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />सत्यना वचनतीन, देवना सामर्थ्यतीन, उजवीडावीकडना न्यायतत्वना हत्यारसनी, <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />गौरवरतीनन अनी अपमानतीन तसच यश अनी अपयशतीन आम्हीन आपली लायकी दखाडतस; आमले फसाडनारा शेतस, अस समजतस तरी बी आम्हीन खरा शेतस. <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />अप्रसिध्द मानेल तरी सुप्रसिध्द; मरेलसनामायक अस मानेल तरी दखा, आम्हीन जिवत शेतस, शिक्षा भोगणारा अस मानेल तरी, मारी टाकेल नही. <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />दुःखमा शेतस तरी सर्वदा आनंद करनारा; गरीब मानेल तरी बराच लोकसले खुला हाततीन देणारा, ज्यानाजोडे काही नही असा मानेल तरी सर्व वस्तुंसंपन्न अशी आम्हीन आमनी लायकी दखाडतस.<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />अहो करिंथकरसवन, तुमनासंगे बोलाकरता आमनं तोंड मोकळ व्हयेल शे. आमनं मन मोठं शे. <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />तुमनाबद्दल आम्हीन आमनं हृदय बंद करं नही, पण तुम्हीनच आमनाकरता आपलं हृदय बंद करेल शे. <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />तुम्हीन माले मना पोऱ्या म्हणीसन सांगस, आमनावर बी प्रेम करा जसं आम्हीन तुमनावर करतस, अनी तुम्हीन आमनाकरता आपलं हृदय मोठं करा.<verse eid="2CO 6:13" /></para>
  <para style="s">जिवत परमेश्वनं मंदिर</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />तुम्हीन अईश्वासीससंगे जाईन त्यासनामा मिसळी जावु नका, कारण धर्म अनी अधर्म यासनी भागीदारी कशी व्हई? उजेड अनी अंधार या कशा एकत्र व्हतीन? <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />ख्रिस्तनं सैतानसंगे कसं एकमत व्हई? ईश्वास ठेवणार अनी ईश्वास नही ठेवणार ह्या कशा काय जोडीदार व्हतीन. <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" /><note caller="+" style="x"><char style="xo" closed="false">६:१६ </char><char style="xt" closed="false"><ref loc="1CO 3:16">१ करिंथ ३:१६</ref>; <ref loc="1CO 6:19">६:१९</ref></char></note>देवना मंदिरना मुर्तिसंगे मेळ कसा बशी? आपण सदाजिवत देवना मंदिर शेतस; देवनी अस सांगेल शे की,</para>
  <para style="q1" vid="2CO 6:16">“मी त्यानामा ऱ्हासु</para>
  <para style="q2" vid="2CO 6:16">अनी चालसु;</para>
  <para style="q1" vid="2CO 6:16">मी त्यासना देव व्हसु</para>
  <para style="q2" vid="2CO 6:16">अनी त्या मना लोके व्हतीन.”<verse eid="2CO 6:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="2CO 6:17" />यामुये त्यामातीन निंघा</para>
  <para style="q2" vid="2CO 6:17">अनी येगळा व्हा, अस प्रभु म्हणस,</para>
  <para style="q1" vid="2CO 6:17">अनी अशुध्द वस्तुले हात लावु नका;</para>
  <para style="q2" vid="2CO 6:17">म्हणजे मी तुमले स्विकारसु;<verse eid="2CO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18" />अनी मी तुमले बाप असा व्हसु</para>
  <para style="q2" vid="2CO 6:18">अनी तुम्हीन माले पोर अनी पोऱ्या असा व्हशात,</para>
  <para style="q2" vid="2CO 6:18">अस सर्वसत्ताधारी प्रभु म्हणस.<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />मना प्रिय लोकसवन, आमले हाई वचन मिळेल शेतस. म्हणीसन शरिरले अनी आत्माले अशुध्द करनारा सर्वासपाईन आपन स्वतःले शुध्द करानं अनी देवले भ्याईसन पवित्रपनानी परिपुर्णता करानी.<verse eid="2CO 7:1" /></para>
  <para style="s">पौलना आनंद</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />तुम्हीन आपला मनमा आमले जागा द्या, आम्हीन कोनावर अन्याय करेल नही, कोणले बिगाडं नही, कोणले फसाडेल नही. <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />तुमले दोषी ठरावाकरता मी हाई सांगस नही; कारण मी पहिले सांगेल शे की, तुमनासंगे मरानं अनी तुमनासंगे जगानं. <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />माले तुमना मोठा भरवसा शे; माले तुमना भलताच अभिमान शे; मी दिलासाघाई भरेल शे; आमना सर्व संकटसमा माले आनंदना भरती येल शे.<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">७:५ </char>
      <char style="xt" closed="false">
        <ref loc="2CO 2:13">२ करिंथ २:१३</ref>
      </char>
    </note>आम्हीन मासेदोनियामा वनुत तवय बी आमना शरिरले स्वस्तपणा नव्हता. तर आम्हीन चारीमेरतीन संकटमा व्हतुत; बाहेर भांडनतंटा, मजारमा भितीन्या गोष्टी व्हत्यात. <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />तवय दुःखी लोकसनं समाधान करनारा देवनी, तिताना येवामुये आमनं समाधान करं. <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />अनी फक्त त्याना येवामुये नही, तर तुमनी ईच्छा, तुमना शोक, तुमनी मना बद्दलना ईश्वास, ह्यानाबद्दल आमले सांगतस तवय, तुमना बद्दलना त्यासनं जे समाधान व्हयनं त्यानं योगतीन आमनं समाधान व्हईसन माले विशेष आनंद मिळेल शे. <verse eid="2CO 7:7" /><verse number="8" style="v" sid="2CO 7:8" />मी तुमले मना पत्रमुये दुःख दिधं, याना माले वाईट वाटी नही राहीनं, माले वाईट वाटनं व्हतं खरं; कारण त्या पत्रमुये तुमले थोडा येळ तरी दुःख व्हयन व्हई अस माले समजस. <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />तरी मी आते आनंद करस; तुमले दुःख व्हयनं यानामुये नही तर तुमनं पश्चताप व्हवाकरता दुःख व्हयनं; कारण देवना योजना प्रमानेच तुमना दुःखना हाऊ प्रकार व्हता; आमना हाततीन कोनत्या बी गोष्टीसमा तुमनं नुकसान व्हवाले नको, म्हणीसन अस व्हयनं. <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />जे दुःख देव आनस, तारण देनारा पश्चताप तयार करस; त्यानापाईन पस्तावा व्हस नही; पण संसारिक व्हनार दुःख मरण तयार करस. <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />कारण दखा, देवना योजनाप्रमाने तुमना दुःखना प्रकार व्हता; याच प्रकारना गोष्टिसनी तुमले केवढी कळकळ, स्वतःले वाचाडानी ईच्छा, संताप, भय, उत्कंठा, आस्था, शिक्षा करानी बुध्दी हाई तयार व्हयेल शे! या काममा तुम्हीन सर्व प्रकारे निर्दोष शेतस, ह्यानं प्रमाण तुम्हीन पटाडी देयल शे.<verse eid="2CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12" />मी तुमले लिखेल शे की, ज्यानी अन्याय करा त्यानाकरता नही अनी ज्याना अन्याय व्हयना त्यानाकरता बी नही, तर आमना विषयी तुम्हीन दखाडी राहीनात. त्या कळकळनी जाणीव देवना समोर तुमले व्हवाले पाहिजे म्हणीसन पत्र लिखेल शे. <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />यामुये आमले दिलासा मिळेल शे; तर आमले समाधान मिळनं इतलंच नही तर; विशेष करीसन तिताना आनंदमुये आमले भलता आनंद व्हयना; तुमना सर्वासकडतिन त्याना आत्माले आनंद व्हयेल शे. <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />मी त्यानाजोडे तुमना विषयमा कोणता बी अभिमान करा तरी त्यामुये माले लाज वाटनी असं काही व्हयनं नही; तर आम्हीन तुमनासंगे सर्व गोष्टी खरा पनतिन बोलनुत. तरी त्याना सारखंच तिताजोडे आम्हीन अभिमानतीन करेल भाषण खरं ठरनं; <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />तुम्हीन त्यानं स्वागत भ्यात भ्यात अनी थरथर करीसन करं, तुम्हीन त्यान्या सर्व आज्ञा पाळाकरता तयार व्हयनात तर त्यानं प्रेम तुमनाकरता जास्त वाढी. <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />मी आनंदीत शे की, मी तुमनावर सर्व गोष्टीसवर भरोसा करू शकस.<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">मंडळीना लोकंसले दान</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">८:१ </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:26">रोम १५:२६</ref>
      </char>
    </note>भाऊसवन अनी बहिणीसवन, मासेदोनिया मातील मंडळीसवर देवनी व्हयेल कृपा तुमले माहीत पडाले पाहिजे अशी आमनी ईच्छा शे; <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />ती अशी की, संकटना कठीण परिक्षामा बराच आनंद अनी भलतीच गरिबी यासना फळरुपमा त्यासना उदार पना दिसना. <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />कारण त्यासनी आपला शक्तीप्रमाने अनी शक्तीना पलिकडे बी त्यानी स्वतःव्हईसन दान देयल शे, अशी मी साक्ष देस. <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />त्यासनी बरीच ईनंती करीसन आमनाकडे मांग की, यहूदीयामाधला देवना लोकसनी सेवा कराकरता आमले बी सहभागीतामा लेवानी कृपा करानी. <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />आमले अपेक्षा व्हती तितलच नही, तर त्यासनी पहिले स्वतःले प्रभुले देयल शे, अनी देवना ईच्छातीन त्यासनी आमले देयल शेतस, <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />ह्यावरतीन आम्हीन तिताजोडे ईनंती करी की, जश त्यानी पहिले सुरवात करी व्हती, त्यानी हाई सेवा करत ऱ्हावाले पाहिजे अनी तुमले मदत करीसन दान देवानं हाई कृपाना कामले पुरं कराले पाहिजे. <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />तर ईश्वास भाषनं ज्ञान, प्रत्येक गोष्टनी कयकय, अनी आमना वरनी तुमनी प्रिती ह्या सर्वासमा जश तुम्हीन आमनामा मोठा शेतस, तसच ह्या दान देवाना कृपाना काममा बी ऱ्हावाले पाहिजे.<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />हाई मी आज्ञा म्हणीसन सांगस नही, तर दुसरासनी दखाडेल उत्कंठावरतीन तुमना प्रेमनी परिक्षा मी दखस. <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />आपला प्रभु येशु ख्रिस्तनी कृपा तुमले माहीतच शे, तो श्रीमंती व्हता तो गरीब व्हयना, यानाकरता की त्याना गरीब व्हवामुये तुम्हीन श्रीमंत व्हयनात.<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />याना विषयमा मी तुमले मन मत सांगस; ह्याना तुमले उपयोग व्हवासारखं शे; कारण तुम्हीन एक वरीस पहिले दुसरसना पहिले तुम्हीन अस कराले सुरवात करी इतलंच नही, तर अशी करानी ईच्छा बी धरी. <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />तर आते हाई काम पुर करा; यानाकरता की जशी दान देवानी उत्सुकता तुमले व्हती, तसच तुमनाकडे जे शे त्यानुसार काम पुर करा. <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />जर तुमनी देवानी ईच्छा व्हई म्हणजे तुमना जोडे जे व्हई ते देवले मान्य व्हई, जर नही व्हई तर काही हरकत नही. <verse eid="2CO 8:12" /><verse number="13" style="v" sid="2CO 8:13" />दुसरासले सुख अनी तुमले दुःख व्हई अस नही. <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />तर हाई समानता व्हवाले पाहिजे म्हणजे चालु काळमा तुमना जोडे जे शे त्यानातीन त्यासनी गरज पुरी करानी अनी नंतर त्यासनाजोडे जे बरच व्हई त्याना माईन तुमनी गरज पुरी करानी अशी हाई समानता ऱ्हावाले पाहिजे; <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />अस शास्त्रमा लिखेल शे. “ज्यानी बरच गोया करं त्यानं जास्तीनं भरनं नही; तसच ज्यानी थोडं गोया करं व्हतं त्यानं काही कमी भरनं नही.”<verse eid="2CO 8:15" /></para>
  <para style="s">तितसले करिंथमा धाडनं</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />तिताना मनमा तुमना विषयी तशीच कयकय उत्पन्न करनारा देवना आम्हीन उपकार मानतस. <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />कारण त्यानी आमनी सुचना मान्य करी, तो बराच उतावळा व्हता. म्हणीसन तो स्वतःव्हईनच तुमनाकडे निंघी येवानी ईच्छा दखाडी. <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />त्यानासंगे आम्हीन एक भाऊले धाडेल शे; सुवार्ता सांगामुये त्यानी वाहवाह सर्व मंडळीसमा पसरेल शे. <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />इतलंच नही तर आमनाकडतीन प्रभुना गौरवकरता अनी आमना उतावळापणा दखाडाकरता चालाडेल ह्या कृपाना काममा मंडळीसनी आमना प्रवासमा त्याले सोबती म्हणीसन नेम; <verse eid="2CO 8:19" /><verse number="20" style="v" sid="2CO 8:20" />आमनाकडतीन चालायेल ह्या उदार पणना काममा कोणी आमले दोष लावाले नको म्हणीसन आम्हीन सावध शेतस; <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />कारण प्रभुना नजरतीन जे मान्य, इतलंच नही तर मनुष्यना नजरतिनबी जे मान्य त्यानी आम्हीन काळजी लेत राहतस. <verse eid="2CO 8:21" /><verse number="22" style="v" sid="2CO 8:22" />त्यासनासंगे आम्हीन आमना एक भाऊले धाडेल शे, त्यानी मदत कराकरता उतावळा पनानी परिक्षा आम्हीन बराच येळले करेल शे; त्याना आते तुमनावर बराच ईश्वास ऱ्हावामुये तो बराच उतावळा शे अस आमले पटेल शे. <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />तिताना विषयमा कोणी ईचारी, तर तो मना साथी अनी तुमना सहकारी राही; आमना भाऊसविषयी बोलनात तर त्या मंडळीसना प्रेषित अनी, ख्रिस्तना गौरव शेतस. <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />यामुये त्यासले तुम्हीन आपला प्रितीनं अनी तुमना विषयमा आमना अभिमाननं प्रमाण मंडळीसना समोर दखाडा.<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="s">ईश्वासीकरता मदत</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />यहूदीयामाधला पवित्र लोकसनी सेवा कराना विषयमा मी तुमले लिखाले पाहिजे यानी गरज नही; <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />कारण माले तुमनं उतावळपण माहीत शे; त्याना वरतीनच मासेदोनीयामातील लोकसना जोडे मी तुमना विषयमा अभिमानतिन सांगस की अखया एक वरिस पहिलेच तयार व्हयेल शे, अनी या तुमना आस्थामुयेच त्या माधलासले उत्तेजन मिळनं. <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />तरी याना बाबतमा तुमना विषयमा आमना अभिमान व्यर्थ व्हवाले नको. म्हणीसन मी ह्या भाऊसले धाडेल शे. यानाकरता की मी सांग तसच तुम्हीन तयार ऱ्हावान; <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />नही तर कदाचित कोणी मासेदोनियाकर मनासंगे वनात अनी तुम्हीन, आम्हीन तयार नहीत अस त्यासनी दख, तर या भरवसा विषयी आपली फजिती व्हई. <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />यानामुये मी भाऊसकडे आग्रह करानं आवश्यक समजिन पहिला पाईन तुमना जोडे ईसन तुम्हीन त्या मनपुर्वक दाननी व्यवस्था करा ज्यानी तुम्हीन अगोदरच प्रतिज्ञा करी व्हता की, हाई दान मनपाईन देवानं, दबावमा नही.<verse eid="2CO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />हाई ध्यानमा ठेवा जो कमी पेरी, तो तितलच कापी, अनी जो जास्तीनं पेरी तर, तो जास्तीनं कापणी करी. <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />प्रत्येकनी आपला मनमा कोणा दबावमा अनी कुरकुर नही करता देवानं; दुःखमा मनना नहीतर गरज शे म्हणीसन देवान नही; कारण खूशीतीन देनारा देवले आवडस. <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />सर्व प्रकारनी कृपा तुमनावर भरपुर व्हवाकरता देव शक्तिमान शे; हाई यानाकरता की तुमले सर्व गोष्टीसमा सगळा पुरवठा कायम व्हईसन प्रत्येक चांगला कामकरता तुमनाकडे सर्वकाही भरपूर शे. <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />त्यानी चारीमेर देयल शे; गरिबसले उदारतातीन दानधर्म करेल शे; त्यानं चांगुलपण युगानुयुग राहस अस शास्त्रमा लिखेल शे.<verse eid="2CO 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10" />जो पेरणाराले बी पुरावस, अनी, खावाकरता अन्न पुरावस तो तुमले बी दी अनी ते भरपुर करी, अनी तुमनं उदारतानं फळ वाढाई. <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />म्हणजे तुम्हीन सर्व प्रकारणा उदारपणकरता सर्व गोष्टीसघाई श्रीमंत व्हशात; त्या सर्व लोके तुमना दानकरता देवले धन्यवाद देतीन जे तुमले आमनाकडतीन भेटनं. <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />हाई सेवा करामुये देवना लोकसना गरजा पुऱ्या कराई जातस; इतलंच नही तर बराच लोकसनी देवना खुप उपकार मानावर ते जास्त व्हस. <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />या सेवाले प्रमाण मानीसन त्या परमेश्वरनी आराधना करतीन, कारण तुम्हीन देवना वचनले आज्ञाना मायक मानतस अनी त्या त्यासनाकरता अनी सर्वाकरता मनपुर्वक दानधर्म करतस. <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />अनी तुमनावर देवनी बरीच कृपा ऱ्हावामुये त्या तुमनाकरता प्रेमतीन प्रार्थना करतस. <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />ज्यानाबद्दल सांगता येवाव नही अस देवना दान त्यासकरता त्यानी स्तुती असो.<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">पौलना अधिकार</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />मी पौल, जो तुमनासमोर ऱ्हास अनी तुमनामा नम्र ऱ्हास, तर मी दुर ऱ्हायनु तर तुमना बराबर कडकपणतीन वागस; तर मी ख्रिस्तनी शांतीघाई अनी नम्रपणतीन तुमले ईनंती करस. <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />मन मांगनं अस शे; कित्येक लोके आम्हीन जगीक ईचारनुसार चालतस अस समजतस, असा लोके मना पुडे येवावर त्यासले कडकपणतीन बोलानं अस माले वाटस. जवय मी येसु तवय अस बोलाले माले भाग पाडु नका. <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />हाई खरं शे की आम्हीन जगमा राहतस पण जगना लोकेसनामायक लढाई करतस नही. <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />आमना युध्दना हत्यार जगना नही तर देवना हत्यार शेतस ज्याघाई आम्हीन शत्रुसना गढ पाडाले समर्थ शे. <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />आम्हीन परमेश्वरना ज्ञानना विरोधमा ऊठनारा, प्रत्येक कल्पना ना आम्हीन विरोध करतस अनी प्रत्येक ईचारले बंदी बनाडिसन त्याले ख्रिस्तना आज्ञाकारी बनडतस. <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />अनी तुमनं आज्ञापालन पुर्न व्हयनं का आम्हीन सर्व आज्ञातोडाबद्दल दंड कराले पात्र शेतस. <verse eid="2CO 10:6" /><verse number="7" style="v" sid="2CO 10:7" />डोयासले जे दिसस तेच तुम्हीन दखतस, मी ख्रिस्तना शे असा जर कोनले स्वतःबद्दल ईश्वास व्हई तर त्यानी परत; आमना विषयमा तुमनासंगे ईचार कराना; तो असा की जशा मी ख्रिस्तना शे तसा त्या बी शेतस. <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />तो आमना अधिकार प्रभुनी तुमना नाशकरता नही तर प्रगती करता दिधा, त्यानाबद्दल जरी मी थोडाफार विशेष गर्व करा तर मी लाजाऊ नही; <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />अस की, मी तुमले फक्त मना पत्रसघाई घाबरवणारा शे अस भास व्हवाले नको. <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />त्या म्हणतस, त्याना पत्र वजनदार अनं जोरदार शेतस; पण त्यानं व्यक्तीमत्व प्रभावहीन अनं त्यानं भाषण व्यर्थ शे. <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />अस सांगणारासनी हाई ध्यानमा ठेवाणं की, आम्हीन दुर व्हतुत तवय जश पत्रसमा आमना शब्द व्हतात तसच आम्हीन जोडे व्हतुत तवय कृतीघाई बी तसच वागेल शेतस.<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />ज्या कित्येक आपली वाहवाह करतस त्यासनासंगे आमनी तुलना करानी हिम्मत आम्हीन करतस नही; त्या तर स्वतःच मोजमाप करतस अनी स्वतःनी स्वतः संगेच तुलना करतस; त्या मुर्ख शेतस. <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />आम्हीन मर्यादा सोडिसन प्रतिष्ठा दखाडाव नही, तर देवनी देयल मर्यादा प्रमाणेच प्रतिष्ठा दखाडतस; जर तसं नही व्हतं तर आम्हीन येशु ख्रिस्तनं शुभवर्तमान तुमनाकडे लिसन नही येतुत. <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />तुमना जोडे पोहचाले नको म्हणीसन आम्हीन ओढातान करतस नही; कारण ख्रिस्तनी सुवार्ता लिसन सुरूवातले आम्हीन तुमना जोडे पोहचनुत; <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />आम्हीन मर्यादा सोडिसन दुसरासना कष्टमुये अभिमान करतस नही; तर आमले अशी आशा शे की, तुमना ईश्वास वाढत जाई तसतसा आमनी मर्यादाना क्षेत्र तुम्हामा जास्तीत जास्त मोठं व्हत जाई. <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />अस की तुमना पलिकडला प्रांतमा आम्हीन सुवार्ता सांगानी, दुसराना मर्यादाना सिमामाधला पहिलेच व्हयेल गोष्टिसनी प्रतिष्ठा दखाडातस नही. <verse eid="2CO 10:16" /><verse number="17" style="v" sid="2CO 10:17" />जसं शास्त्र सांगस, “प्रतिष्ठा मिरावनारानी प्रभुमा प्रतिष्ठा मिरावाले पाहिजे.” <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />स्वतःनी बढाई करनारा पसंत ठरस नही, तर ज्यानी बढाई प्रभु करस तोच खरा ठरस.<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">पौल अनी खोटा प्रेषित</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />मना थोडासा येडापणा तुम्हीन सहन कराले पाहिजे; अनी ते तुम्हीन करीच राहिनात. <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />माले ईश्वरी आस्थाप्रमाणे तुमनाबद्दल आस्था वाटस; कारण मी एक माणुससंगे म्हणजे ख्रिस्तसंगे तुमनी योजना करेल शे, यानाकरता की तुमले शुध्द कुवारी अस ख्रिस्तले सादर करीसन देवानं. <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />पण माले भिती शे की, जसं सापनी कपटतीन हवाले फसाडं तसच तुमनं मन ख्रिस्तनी भक्तीना सरळपणा अनं शुध्दपणा यासना पाईन भटकाले नको, <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />कारण कोणी ईसन दुसऱ्या येशुना प्रचार करतस ज्याना प्रचार आम्हीन करा नही, किंवा तुमले दुसरा आत्मा मिळना, जो पहिले नही भेटेल व्हता, किंवा अशी दुसरी सुवार्ता तुम्हीन स्विकारी जी तुम्हीन पहिले नही स्विकारी, म्हणजे तुम्हीन कितला सरळपणतीन त्यान्या गोष्टी मानी लेतस.<verse eid="2CO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5" />मी स्वतःले महाप्रेषितस पेक्षा कोणताच प्रकारमा कमी समजस नही, <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />जरी बोलामा मी अनपड शे, पण ज्ञानमा तसा नही; हाई आम्हीन तुमनाबद्दल सर्व लोकसमा अनं सर्व प्रकारे प्रकट करेल शे.<verse eid="2CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7" />तुम्हीन उंच व्हवाले पाहिजे म्हणीन स्वतःले नम्र करीसन देवनी सुवार्ता सांगी, मी हाई पाप करं का? <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />मी तुमनी सेवा कराले पाहिजे म्हणीन दुसऱ्या मंडळीसपाईन पगार लिसन त्यासले लुबाडं; <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" /><note caller="+" style="x"><char style="xo" closed="false">११:९ </char><char style="xt" closed="false"><ref loc="PHP 4:15-18">फिलप्पै ४:१५-१८</ref></char></note>जवय मी तुमनासंगे व्हतु तवय माले कमी पडणं तरी बी कोणवरच भार नही टाका; कारण मासेदोनियामातीन येल भाऊसनी मनी गरज पुर्ण करी; अनी कोणताच प्रकारमा मना तुमनावर भार पडाले नको म्हणीन मी सांभाळं अनी सांभाळसु. <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />ख्रिस्तनं सत्य मनामा शे, यावरतीन सांगस की मना या अभिमानले अखया प्रांतमा प्रतिबंध व्हणार नही. <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />का बर? यामुये की, मी तुमनावर प्रेम नही करस, म्हणीसन का? देवले तर माहित शे मी करस.<verse eid="2CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12" />जे मी करस ते करतस ऱ्हासु; यानाकरता की ज्यानामा आम्हीन गर्व करतस त्यानामा गर्व करानी संधी ज्यासले महाप्रेषीत म्हणतस त्यासले मी भेटू देवावु नही. <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />असा लोके खोटा प्रेषित, कपटी, कामदार, ख्रिस्तना प्रेषितसना रूप धारण करनारा असा शेतस. <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />यानामा आश्चर्य वाटासारखं काही नही शे, सैतानबी स्वतः तेजस्वी देवदूतनं रूप धारण करस. <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />यामुये त्याना सेवकसनी बी धार्मीकताना सेवकसनं रूप धारण करं त्यानामा मोठी गोष्ट नही; त्यासना शेवट कामप्रमाणे व्हई.<verse eid="2CO 11:15" /></para>
  <para style="s">पौल अनं त्याना विरोधक यासनामा तुलना</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />मी परत सांगस, कोणी माले मूर्ख समजु नका; जर तुम्हीन तसं समजतस तर जशा मुर्खना तसा मना स्विकार करा, म्हणजे मी बी थोडासा गर्व करसु. <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />गर्वतीन मी हाई बोलस, पण ते प्रभुले धरीन नही तर मुर्खसारख बोलस. <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />बराच लोक शरिरप्रमाणे गर्व करतस म्हणीन मी बी करसु. <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />तुम्हीन शहाणा शेतस म्हणीन खूशीतीन मुर्खनं सहन करतस. <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />कोणी तुमले दास बनाडी टाकं, तुमना फायदा उचला, तुमले फसाडी लिधं अनी स्वतःले उंच करी लिधं, कोणी तुमना तोंडमा मारी, ते सर्व तुम्हीन सहन करतस. <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />माले हाई सांगाले लाज वाटस की मनाकरता कमजोरी शे, हाई मी सहन करू शकस नही, तरी ज्या कसामा कोणी धीट व्हई, त्यामा मी पण धीट शे, हाई मनं बोलनं मुर्खपणनं शे. <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />त्या इब्री शेतस का? मी बी शे. त्या इस्त्राएली शेतस का? मी बी शे. त्या अब्राहामना संतान शेतस का? मी बी शे. <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" /><note caller="+" style="x"><char style="xo" closed="false">११:२३ </char><char style="xt" closed="false"><ref loc="ACT 16:23">प्रेषित १६:२३</ref></char></note>त्या ख्रिस्तना सेवक शेतस का? मी जास्त शे हाई मी येडानामायक बोलस; कष्ट करामा, बंदिवास सोसामा; बेसुमार फटका खावामुये अनं बराच येळ मरणसंकट सोसामुये; मी जास्त शे. <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />पाच दाव मी यहूद्यासना हाततीन एकोणचाळीस फटका खादात. <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" /><note caller="+" style="x"><char style="xo" closed="false">११:२५ </char><char style="xt" closed="false"><ref loc="ACT 16:22">प्रेषित १६:२२</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:19">प्रेषित १४:१९</ref></char></note>तीनदाव काठीन मारा खादा; एकदाव माले दगडमार व्हयना; तीनदाव मनं जहाज अपघातमा फसनं, समुद्रमा मी रातनंरात राहिनु. <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" /><note caller="+" style="x"><char style="xo" closed="false">११:२६ </char><char style="xt" closed="false"><ref loc="ACT 9:23">प्रेषित ९:२३</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:5">प्रेषित १४:५</ref></char></note>मी कितलातरी प्रवास करा त्यामा; नदीवरना संकट, लुटारूसना संकट, स्वतःना जातना लोकसनं संकट, गैरयहूदी लोकसनं संकट, नगरमाधला संकट, जंगलमाधला संकट, समुद्रमाधला संकट, खोट्या बंधुसना संकट. यासनामा मी राहिनु. <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />श्रम अनं कष्टमा, कितलातरी दाव करेल जागरणमा, भूक तहानमा, कितला दाव उपाशी, <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />शिवाय ह्या अनी असा बऱ्याच गोष्टीस शिवाय मना रोजना मी रगडाई राहिनु, म्हणजे सर्व मंडळीसनी चिंता हाई शे. <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />एखादा अशक्त व्हयना तर मी अशक्त व्हस नही का? एखादा अडखळणा तर माले राग येवावु नही का?<verse eid="2CO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30" />माले अभिमान करानं भाग पडनं तर मी आपला अशक्तपणाना गोष्टीसना अभिमान करसु. <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />देव आपला प्रभु येशुना पिता जो युगानुयुग धन्यवादित शे, त्याले माहित शे की मी खोटं बोलावं नही. <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" /><note caller="+" style="x"><char style="xo" closed="false">११:३२ </char><char style="xt" closed="false"><ref loc="ACT 9:23-25">प्रेषित ९:२३-२५</ref></char></note>दिमिष्क शहरमा अरीतास राजाना पदाधिकारी यानी माले धराकरता दिमिष्क शहर दारवर शिपाई ठेयल व्हता. <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />तरी माले टोपलीमा बसाडीसन गावकुसवरतीन खिडकीमाईन खाल सोडं अनी त्यासना हातमा येवापाईन वाचनु. <figure style="fig" alt="Entrance to the city gate and wall" file="hk00238c.tif" size="col" copy="Horace Knowles ©" ref="११:३२">शहरना बाहेरनी भिंत अनी दार</figure><verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">पौलनं ध्येय अनी प्रकटीकरण</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />आते तर माले गर्व करनाच पडी जरी त्यापाईन काहीच फायदा नही, तरी प्रभुकडतीन देवाई जायेल दृष्टांत अनी प्रकटीकरणसवर मी गर्व करसु. <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />ख्रिस्तमधला एक माणुस माले माहीत शे त्याले चौदा वरीस पहिले तिसरा स्वर्गपावत उचलीन लई जावामा वनं, त्याले शरिरसंगे लई गयात की बिना शरिरना लई गयात हाई माले माहीत नही; देवले माहीत शे. <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />त्याच माणुसबद्दल माले माहीत शे की त्या माणुसले; शरिरसंगे लई गयात की बिना शरिरना लई गयात हाई माले माहीत नही; देवले माहीत शे. <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />सुखलोकमा उचलीन लई जावामा वनं अनी माणुसनी बोलाना योग्य नही अनी ज्यानं वर्णन बी करता येवाव नही असा गोष्टी त्यानी ऐक्यात. <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />असा माणुसबद्दल मी गर्व करसु, मी स्वतःबद्दल नही, तर फक्त आपली नाजुकताना गर्व करसु. <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />मी गर्व करानी ईच्छा धरसु तरी मी मुर्ख ठरावु नही, मी खरच बोलसु; तरी बी मी अस करानं राहू देस; कारण मी जो म्हणीसन लोकसले दखास किंवा मनाकडतीन जे लोकसना कानवर पडस त्याना पलीकडे कोणी माले जास्त मानु नये.<verse eid="2CO 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7" />प्रकटीकरणना अधिकतामुये मी गर्व कराले नको म्हणीसन मना शरिरमा एक काटा, माले बुक्की मारा करता एक सैतानना दूत ठेवामा येल शे; मी गर्व कराले नको म्हणीसन तो ठेवामा येल शे. <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />हाऊ मनापाईन दुर व्हवाले पाहिजे अशी मी प्रभुजोडे तीनदाव ईनंती करी. <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />पण त्यानी माले सांगेल शे, मनी कृपा तुले पुरी शे, कारण मनी शक्ती अशक्तपणमा सिध्द व्हस, तर ख्रिस्तनी शक्तीना मनामा वास व्हवाले पाहिजे म्हणीसन मी विशेषकरीन मना अशक्तपणना गर्व भलताच खूशीतीन करस. <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />ख्रिस्तनाकरता अशक्तपण, अपमान, अडचण, तरास, संकट भोगनं यामा मी खूश शे; कारण मी अशक्त शे तवय मी सशक्त शे.<verse eid="2CO 12:10" /></para>
  <para style="s">पौल करिंथकरसबद्दल चिंता करस</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />मी मुर्ख बननु, अस बनाकरता तुम्हीन माले भाग पाडं; तुम्हीन तर मनी वाहवाह कराले पाहिजे व्हती जरी मी आज काहीच नही तरी ह्या अतिश्रेष्ठ प्रेषितसपेक्षा किंचीत बी कमी नव्हतु. <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />चिन्ह, आश्चर्यकर्म अनी चमत्कार यासनाघाई प्रेषितसनी तुमनामा करेल चिन्ह पुर्ण धैर्यतीन मी करी दखाडेल व्हतात. <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />मी स्वतः तुमले बोझ व्हयनु नही, याना व्यतिरीक्त कोणत्या गोष्टीसमा बाकीन्या मंडळीसपेक्षा तुमले कमी करं का? या, मना अपराधसनी क्षमा करा!<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />तिसरींदाव मी तुमनाकडे येवाले तयार शे अनी मी तुमले बोझ व्हवावु नही, मी तुमना कडतीन काहीच मांगस नही तर तुम्हीन स्वतःच माले पाहिजे; पोरसनी मायबापसकरता नही तर मायबापसनी पोऱ्यासकरता धन गोया कराले पाहिजे. <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />मी तुमना जिवकरता भलताच आनंदतीन खर्च करसु अनी मी स्वतः खर्च व्हई जासु; मी तुमनावर भलतच प्रेम करस म्हणीसन तुम्हीन मनावर कमी प्रेम करतस का?<verse eid="2CO 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 12:16" />असो, मी तुमनावर वझ टाकं नही; तरी मी धुर्त व्हतु म्हणीसन तुमले कपटतीन पकडं. <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />ज्यासले मी तुमनाकडे धाडं त्यामातील एक कडतीन तरी मी तुमना कडतीन स्वार्थ साधी लिधा का? <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />मी तिताले ईनंती करी, अनी त्यानासंगे एक भाऊले धाडं; तवय तितानी तुमना कडतीन स्वार्थ साधी लिधा का? आम्हीन एकच आत्मातीन मायकच उद्देशतीन चालनु नही का?<verse eid="2CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19" />आम्हीन स्वतःले वाचाडी राहीनुत अस ईतला येळ तुमले वाटनं व्हई, तर नही आम्हीन देवसमक्ष ख्रिस्तमा बोली राहीनुत; प्रिय भाऊसवन, तुमनी प्रगती करता हाई सर्व शे. <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />माले भिती वाटी राहीनी की, मी येवावर, जशी मनी ईच्छा शे तसा तुम्हीन माले दखावणार नही अनी तुमनी अपेक्षा नही तसा मी तुमले दखावसु; कदाचित भांडणं, हेवा, राग, फुट, चुगल्या, निंदा, रूसवा, अव्यवस्था या माले दखायतीन. <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />मी परत येवावर मना देव माले तुमनापुढे खाल दखाले लाई अनी ज्यानी पुर्वी पाप करीसन स्वतः आचरण करेल अशुध्दपणा, जारकर्म अनी व्यभिचारपणना पश्चाताप करा नही असा बराच लोकसबद्दल माले शोक करना पडी.<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s">अंतिम चेतावणी अनी शुभेच्छा</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />हाई मनी तुमनाकडे येवानी तिसरी खेप; दोन किंवा तीन साक्षीदारसना तोंडतीन प्रत्येक गोष्ट ठरस. <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />ज्यासनी पुर्वी पाप करं त्यासले अनी दुसरा सर्वासले मी पहिलेच सांगेल व्हतं अनी दुसरांदाव तुमना जोडे असतांना सांगं तेच आते दुर असतांना बी पहिलेच सांगस की, मी फिरीसन वनु तर कोणी किव करावु नही; <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />ख्रिस्त मनाद्वारे बोलस यानं सबुत तुमले पाहिजे ते हाईच शे; तो तुमनाबद्दल शक्तीहीन नही, तर तुमनामा शक्तीमान शे; <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />त्याले अशक्तपणमा क्रुसखांबवर खियामा वनं तरी तो देवना सामर्थ्यतीन जिवत व्हयेल शे; तसं आम्हीन बी त्यानामा शक्तीहीन शेतस, तरी देवना सामर्थ्यतीन आम्हीन तुमनी सेवा कराकरता जिवत शेतस. <verse eid="2CO 13:4" /><verse number="5" style="v" sid="2CO 13:5" />तुम्हीन ईश्वासमा शेतस किंवा नही यानाबद्दल आपली परिक्षा करा; स्वतःले तपाशी दखा; येशु ख्रिस्त तुमनामा शे अस तुम्हीन स्वतःबद्दल समजतस ना? नही तर तुम्हीन कसोटीमा खरा उतरेल नही शेतस. <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />पण मना ईश्वास शे की, तुम्हीन वळखी लेशात, आम्हीन स्वतः तपासनुत अपयस्वी नही निंघनुत. <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />आम्हीन देवकडे अशी प्रार्थना करी राहीनुत की तुम्हीन काही वाईट कराले नको, यानाकरता नही की आम्हीन स्वतः खरा दिसाले पाहिजे, पण यानाकरता की तुम्हीन तेच करा की जे चांगलं शे, जरी आम्हीन अपयस्वी ठरनुत तरी चाली. <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />कारण सत्यना विरोधमा आमले काहीच करता येस नही, पण सत्यकरता करता येस. <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />जवय आम्हीन अशक्त शेतस अनी तुम्हीन शक्तीमान शेतस तवय आम्हीन आनंद करतस, अनी याबद्दल प्रार्थना बी करतस अशी की तुम्हीन परीपुर्ण व्हई जावं. <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />यामुये जोडे नसतांना हाई लिखस, याकरता की प्रभुनी जो अधिकार उभा कराकरता माले दिधा, तो पाडाकरता नही; त्या अधिकारतीन जोडे येवावर मी कडकपणा चालवाले नको.<verse eid="2CO 13:10" /></para>
  <para style="s">शेवटलं अभिवादन</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />भाऊ अनी बहिणीसवन, इतलंच आते म्हणस, तुमनं कल्याण असो; तुम्हीन पुर्ण व्हा; समाधान मिळाडा; एकचित्त व्हा; शांतीतीन ऱ्हा; म्हणजे प्रेमना अनी शांतीना देव तुमनासंगे राही.<verse eid="2CO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12" />पवित्र प्रेमतीन एकमेकसले सलाम करा.<verse eid="2CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 13:13" />देवना सर्व पवित्रजन तुमले सलाम सांगतस. <verse eid="2CO 13:13" /><verse number="14" style="v" sid="2CO 13:14" />प्रभु येशु ख्रिस्तनी कृपा, देवनी प्रिती, अनी पवित्र आत्मानी संगती तुमना सर्वासंगे असो.<verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>