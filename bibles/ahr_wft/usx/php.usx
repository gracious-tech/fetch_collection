<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Ahirani</book>
  <para style="h">फिलप्पै</para>
  <para style="toc3">फिलप्पै</para>
  <para style="toc2">फिलप्पै</para>
  <para style="toc1">पौलनी लिखेल फिलप्पैकरसले पत्र</para>
  <para style="mt2">पौलाने लिहिलेले फिलप्पैकरास पत्र</para>
  <para style="mt1">पौलनी लिखेल फिलप्पैकरसले पत्र</para>
  <para style="imt">वळख</para>
  <para style="ip">ख्रिस्तना जन्मना ६१ वरिसनंतर पौलनी हाई पत्र ईश्वासु फिलप्पैकरसले लिखं. जवय त्यानी हाई पत्र लिखं तवय तो रोम शहरमा कैदखानामा व्हता<char style="xt"><ref loc="PHP 1:13">१:१३</ref>.</char> हाई पत्र पौलनी फिलप्पै आठे जी मंडळी व्हती त्यासले लिखं. फिलप्पैना बद्दल आमले प्रेषितना पुस्तकमातीन थोडफार माहीती भेटस. मकिदुनिया प्रांतनी फिलप्पै राजधानी शहर व्हतं, हाई मंडळी माकिदुनिया प्रांतनी पहिली मंडळी व्हती. पौल अनी सिला ह्यासनी दोन्हीसनी संगेच हाई मंडळीनी सुरवात करी जवय त्या फिलप्पैमा व्हतात तवय त्यासले रातभर कैदखानामा राहनं पडनं<char style="xt"><ref loc="ACT 16">प्रेषित १६</ref></char>.</para>
  <para style="ip">पौलनं हाई पत्र बराच उद्देशतीन लिखं. जवय तो कैदमा व्हता तवय त्यासनी त्याले जे दान दिधं त्यानाकरता त्यासनं आभार मानाले त्यानी हाई पत्र लिखं<char style="xt"><ref loc="PHP 4:10-19">४:१०-१९</ref></char> कैदखानामा त्यानी हाल कशी व्हती यानं त्यानी वर्णन करेल शे. <char style="xt"><ref loc="PHP 2:19-30">२:१९-३०</ref></char></para>
  <para style="iot">रूपरेषा</para>
  <para style="io1">१. फिलप्पैनी मंडळीले शुभेच्छा दिसन पौल पत्रनी सुरवात करस. <char style="ior"><ref loc="PHP 1:1-2">१:१-२</ref></char></para>
  <para style="io1">२. नंतर तो परिस्थितीबद्दल अनी काही अडचणीसबद्दल सांगस. <char style="ior"><ref loc="PHP 1:3">१:३</ref>; <ref loc="PHP 2:30">२:३०</ref></char></para>
  <para style="io1">३. नंतर पौल ख्रिस्ती जिवनकरता व्यवहारीक बोध करस. <char style="ior"><ref loc="PHP 3:1">३:१</ref>; <ref loc="PHP 4:9">४:९</ref></char></para>
  <para style="io1">४. त्यासनी देयल भेटकरता त्यासना आभार मानीसन अनी शुभेच्छा दिसन पौल पत्रना शेवट करस. <char style="ior"><ref loc="PHP 4:10-23">४:१०-२३</ref></char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:12">प्रेषित १६:१२</ref>
      </char>
    </note>ख्रिस्त येशुना सेवक, मी पौल अनं तिमथ्य यासनाकडतीन;</para>
  <para style="p" vid="PHP 1:1">फिलप्पै माधला ख्रिस्त येशुना सहवासमा राहनारा देवना सर्व लोकससंगे मंडळीना सर्व अध्यक्ष अनं सर्व सेवकसले;<verse eid="PHP 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 1:2" />देव आपला पिता अनं प्रभु येशु ख्रिस्त यासना पाईन तुमले कृपा अनं शांती असो. <figure style="fig" alt="City of Philippi" file="hk00363c.tif" size="col" copy="Horace Knowles ©" ref="१:१">फिलीप्पै शहर</figure><verse eid="PHP 1:2" /></para>
  <para style="s">त्याना वाचणारासकरता पौलनी प्रार्थना</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />माले तुमनी जी एकंदर आठवण शे तिनावरतीन मी आपला देवना आभार मानस. <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />तुमना सर्वासकरता कायम प्रत्येक प्रार्थनाना येळले आनंदतीन ईनंती करस. <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />पहिला दिनपाईन आजपावत सुवार्ताना प्रसारमा जी तुम्हीन मनी मदत करी तिनामुये मी तसं करस. <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />ज्या देवनी तुमनामा चांगलं कामनी सुरवात करी तो, ते काम येशु ख्रिस्तना परत येवाना दिनपावत पुरा करी हाऊ माले ईश्वास शे. <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />तुमना सर्वासबद्दल माले असं वाटानं योग्य शे, कारण मना बंधनमा अनी सुवार्तासंबधना प्रत्युत्तरमा अनं समर्थनमा तुम्हीन सर्व मनासंगे कृपाना भागीदार असामुये मी आपला अंतःकरणमा तुमले धरीसन शे. <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />मनामा असणारा ख्रिस्त येशुना कळवळाघाई मी तुमना सर्वासकरता कितला उत्कंठीत शे यानाविषयी देव मना साक्षी शे. <verse eid="PHP 1:8" /><verse number="9" style="v" sid="PHP 1:9" />मनी हाई प्रार्थना शे की तुमनी प्रिती, सत्यना ज्ञानघाई अनं सर्व प्रकारना विवेकघाई अधिक अनं अधिक भलतीच वाढाले पाहिजे. <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />अस की जे उत्तम ते तुम्हीन पसंत करानं अनी तुम्हीन ख्रिस्तना परत येवाना दिनकरता निर्मळ अनं निर्दोष ऱ्हावाले पाहिजे. <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />अनी देवना गौरव अनं स्तुती व्हवाले पाहिजे म्हणीसन येशु ख्रिस्तनाद्वारा ज्या नितीमत्वाना फळ त्याघाई तुम्हीन भरी जावाले पाहिजे.<verse eid="PHP 1:11" /></para>
  <para style="s">ख्रिस्त हाई जिवन शे</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />भाऊसवन अनं बहिणीसवन माले ज्या गोष्टी घडण्यात त्यासनापाईन सुवार्ताले अडथळा नही व्हता त्या तीना वृध्दीले कारण व्हयन्यात हाई तुम्हीन समजी ल्या अशी मनी ईच्छा शे. <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" /><note caller="+" style="x"><char style="xo" closed="false">१:१३ </char><char style="xt" closed="false"><ref loc="ACT 28:30">प्रेषित २८:३०</ref></char></note>म्हणीन राजभवनना सर्व सैनिकसमा अनं बाकीना सर्व जणसमा, मनी बंधनं ख्रिस्तना सेवक संबधना शेतस अशी त्यासनी प्रसिध्दी व्हयनी. <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />अनी त्यासनी खात्री पटीन प्रभुमाधला बराचसा भाऊ, मना बंधननामुये उत्तेजीत व्हईन देवना वचन नही घाबरता सांगाकरता अधिक धीट व्हयेल शेतस. <verse eid="PHP 1:14" /><verse number="15" style="v" sid="PHP 1:15" />कितलातरी जन हेवातीन अनं वैरभावतीन ख्रिस्तनी घोषणा करतस, अनी कितलातरी जन खरापणतीन करतस. <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />माले देवनी सुवार्तानासंबधमा प्रत्युत्तर देवाले निमेल शे हाई वळखीसन त्या घोषणा प्रितीतीन मुये असा करतस. <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />पण दुसरा शेतस त्या मना बंधनं जास्त संकटना व्हवाले पाहिजे असा ईच्छातीन तड पाडाकरता दुजाभावतीन ख्रिस्तनी घोषणा करतस. <verse eid="PHP 1:17" /><verse number="18" style="v" sid="PHP 1:18" />ह्यापाईन माले काहीच फरक नही पडस? निमित्ततीन असो किंवा खरापणतीन असो, सर्व प्रकारमा ख्रिस्तनी घोषणा व्हस, अनी ह्यानामा मी आनंद करस अनं करसुच. <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />कारण त्या तुमना प्रार्थनाघाई अनं येशु ख्रिस्तना आत्माना पुरवठाघाई मना उध्दारले कारण व्हई, हाई माले माहीत शे. <verse eid="PHP 1:19" /><verse number="20" style="v" sid="PHP 1:20" />जी मनी अपेक्षा अनी आशा तीनाप्रमानतीन, मी कसाघाई बी लाजावु नही, तर पुरा धैर्यतीन कायम प्रमानतीन आते बी, मना जिवन अनी मरणघाई, मना शरिरनाद्वारा ख्रिस्तना महिमा व्हई, <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />कारण जिवन हाई काय शे? मनाकरता तर ख्रिस्त शे. अनी मरण हाऊ लाभ शे. <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />पण जर शरिरमा जगणं हाई मना कामना फळ शे तर कोणतं निवडानं हाई माले सांगता येवाव नही. <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />मी दोन्ही बाजु कडतीन खेचाई राहीनु शे. अनी आठेन सुटीसन ख्रिस्तना जोडे ऱ्हावानी माले आतुरता शे; कारण शरिरमा ऱ्हावापेक्षा हाई भलतच चांगलं शे. <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />तरी तुमनाकरता माले शरिरमा ऱ्हावानं हाई अधिक गरजनं शे. <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />माले अशी खात्री वाटामुये मी ऱ्हासु; अनी ईश्वासमा तुमले वृध्दी अनं आनंद व्हावा म्हणीन मी तुमना सर्वसजोडे ऱ्हासु हाई माले ठाऊक शे. <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />हाई असाकरता की तुमनाकडे मनं परत येणं व्हवामुये, मनामुये ख्रिस्त येशुमा एक व्हवामुये अभिमान बाळगानं तुमले जास्त कारण व्हवाले पाहिजे. <verse eid="PHP 1:26" /><verse number="27" style="v" sid="PHP 1:27" />सांगानं ते इतलंच की ख्रिस्तना सुवार्ताले शोभी असं आचारण ठेवा, मी ईसन तुमले भेटनु किंवा तुमना जोडे वनू नही तरी तुमना संबधतीन मना ऐकामा अस येवाले पाहिजे की, तुम्हीन एकजिवतीन सुवार्ताना ईश्वासकरता एकत्र लढाई करत एकचित्ततीन स्थिर ऱ्हातस. <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />अनी विरोध करनारा लोकसकडतीन कोणता बी विषयमा घाबरानं नही; हाई त्यासले त्यासना नाशना पण तुमना तारणना प्रमाण शे अनी ते देवकडतीन शे. <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />कारण त्यावर ईश्वास ठेवाना इतलंच नही, तर ख्रिस्त कडतीन त्यानाकरता दुःख बी सोसानं अशी कृपा तुमनावर व्हयेल शे. <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" /><note caller="+" style="x"><char style="xo" closed="false">१:३० </char><char style="xt" closed="false"><ref loc="ACT 16:19-40">प्रेषित १६:१९-४०</ref></char></note>मी जे युध्द करेल शे तुम्हीन दखं अनं आत्ते मी जे करी ऱ्हायनु म्हणीसन तुम्हीन ऐकतस, तेच तुम्हीन बी करी राहिनात.<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">ख्रिस्तना नम्रतानं अनुकरण</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />यावरतीन ख्रिस्तमा तुमनं जिवन मजबुत करस, त्यानं प्रेम सांत्वना देस. अनी आत्मामा तुमनी सहभागीता शे, करूणा अनी एकमेकसकरता कळवळा शे, <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />तर तुम्हीन एक ईचारना व्हवानं, म्हणीसन एकमेकसवर सारखी प्रिती करानी अनी एकजीव व्हईसन एकचित्त व्हवानं; असा प्रकारतीन मना आनंद पुर्ण करा. <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />तुमनामा, चित्तवृत्तीमा तट पाडानं किंवा पोकळ अभिमान धरानं अस काही नही पाहिजे, तर नम्रतातीन एकमेकसले आपलापेक्षा श्रेष्ठ मानाले पाहिजे. <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />तुमनामा कोणी आपलाच हित दखाना नही तर दुसरासना बी दखाना. <verse eid="PHP 2:4" /><verse number="5" style="v" sid="PHP 2:5" />असा जो एक ईचार ख्रिस्त येशुमा व्हता तो तुमनामा बी असाले पाहिजे.<verse eid="PHP 2:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="PHP 2:6" />तो देवनामायक राहीसन सुध्दा</para>
  <para style="q2" vid="PHP 2:6">देवना बराबरीमा ऱ्हावानं ह्यामा फायदा शे, अस त्यानी ईचार करा नही.<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />त्यापेक्षा त्यानी स्वतःले देयेल सर्व गोष्टी सोड्यात अनी एक सेवकना रूप धारण करा.</para>
  <para style="q2" vid="PHP 2:7">तो मनुष्यना मायक बनना अनी मनुष्यना रूपमा दिसना.<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />तो नम्र व्हता अनी आज्ञाधारक ऱ्हावाना मार्गवर चाली गया,</para>
  <para style="q2" vid="PHP 2:8">अनी क्रुसखांबवर मरना.<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />यामुये देवनी त्याले भलतं उंच कर, अनी सर्व नावापेक्षा जे श्रेष्ठ नाव ते त्याले दिधं; <note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">यामुये देवनी त्याले भलतं उंच कर, अनी सर्व नावापेक्षा जे श्रेष्ठ नाव ते त्याले दिधं;</char></note><verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />
    <note caller="+" style="f">
      <char style="fr" closed="false">2:10 </char>
      <char style="ft" closed="false">यशया 45:23</char>
    </note>यानाकरता की स्वर्गमा अनी पृथ्वीमा अनं पृथ्वीना खाल जे काही बी शे त्यानी येशुना नावमा आदरतीन गुडघा टेकाले पाहिजे.<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />अनी देवपिताना गौरव व्हवाकरता सगळा उघडपणतीन “येशु ख्रिस्त प्रभु शे” अस जाहीर करतीन.<verse eid="PHP 2:11" /></para>
  <para style="s">जगमा प्रकाश म्हणीन चमकनं</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />म्हणीन मना प्रिय भाऊ अनी बहिणीसवन, तुम्हीन जसं मी प्रत्यक्ष हजर व्हतु तवयच नही, तर आते मी दुर राहीसन सुध्दा जसं आज्ञा पाळतस तसा घाबरीसन थरथर कापीसन तुमना तारण पुर्ण व्हवाकरता कार्य करत राहा. <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />कारण देवच असा एक शे जो तुमनामा कार्य करानी ईच्छा करस अनं तो संतुष्ट व्हई अस रीतीतीन कार्य करानी शक्ती देस. <verse eid="PHP 2:13" /><verse number="14" style="v" sid="PHP 2:14" />जे काही तुम्हीन करशात ते तक्रार अनं वादविवाद नही करता करा, <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />यानाकरता की, तुम्हीन निर्दोष अनं शुध्द् असा भ्रष्ट अनं पापी लोकसमा देवना पोऱ्या असा ऱ्हावाले पाहिजे, अनी त्यासनामा अंधाराना जगमा आकाशना तारासनामायक चमकाले पाहिजे. <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />तुम्हीन त्यासले जिवनना वचन सांगतस तवय मना परिश्रम अनी मना काम व्यर्थ व्हयनात नही अस माले दखास, यानाकरता की ख्रिस्तना परत येवाना दिनले माले तुमना अभिमान वाटाले पाहिजे. <verse eid="PHP 2:16" /><verse number="17" style="v" sid="PHP 2:17" />तुमना यज्ञर्पण सेवामा तसच तुमना ईश्वासना सेवामा जर मी अर्पण व्हई गवु तरी मी त्यानाबद्दल आनंद मानस अनी तुमना सर्वाससंगे आनंद करस; <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />त्याच प्रकारे तुम्हीन बी आनंदी ऱ्हावानं, अनी तुमना आनंदमा माले सहभागी करानं.<verse eid="PHP 2:18" /></para>
  <para style="s">तीमथ्य अनी एपफ्रदीस</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />तीमथ्याले तुमनाकडे लवकर धाडसु, अस माले प्रभु येशुमा आशा शे, यानाकरता की, तुमन्या गोष्टी ऐकीसन माले बी प्रोत्साहन येवाले पाहिजे. <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />मना मायकच भावना असणारा दुसरा कोणी मनाजोडे नही अनी त्याले तुमना कल्याण करानी मनपाईन कळकळ शे. <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />कारण सर्वाजण स्वतःनाच गोष्टीकडे ध्यान देतस, ख्रिस्त येशुना गोष्टीकडे ध्यान देतस नही. <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />अनी तुमले त्याना स्वभाव माहीत शे, सुवार्ता वाढवाकरता जसं पोऱ्या बापनी सेवा करस तसाच त्यानी त्याना योग्यतामा मनासोबत सेवा करेल शे. <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />त्याले तुमनाकडे धाडाबाबत मी आशा करी ऱ्हायनु शे, मनाबाबत काय व्हस ते समजताच त्याले तुमनाकडे धाडसु. <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />अनी मना असा ईश्वास शे की, देवना कृपातीन माले स्वतःले तुमनाकडे येवानं लवकरच शक्य व्हई. <verse eid="PHP 2:24" /><verse number="25" style="v" sid="PHP 2:25" />तसच एपफ्रदीस, जो मना भाऊ शे, सहकारी अनी सहशिपाई शे, तो तुमना संदेशवाहक अनी मनी गरज भागाडीसन सेवा करनारा शे. त्याले तुमना जोडे धाडानं आवश्यक शे, अस माले वाटस; <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />कारण तो आजारी शे हाई तुमना कानवर पडनं अस त्याले समजावर त्याले तुमना सर्वाबद्दल काळजी वाटी राहिंती. <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />तो भलताच आजारी व्हता, पक्का मरण येण्याजागे पडेल व्हता. पण देवनी त्यानावर कृपा करी, त्यानावरच करी अस नही, तर मनावर बी करी; यानाकरता की, माले आखो दुःख व्हवाले नको. <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />यामुये मी त्याले धाडानी खुपच घाई करी; तुम्हीन त्याले दखीसन परत आनंद करशात, अनी मना दुःख कमी व्हवाले पाहिजे म्हणीसन हाई करं. <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />यावरतीन प्रभुमा त्यासनं स्वागत पुर्ण आनंदतीन करा; अनी असा लोकसना मान ठेवा, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />येशुकरता त्यानी त्याना जिवन धोकामा घाला, अनी मरता मरता वाचना, यानाकरता की, मनी सेवा करामा तुमनामा जी कमी व्हती ती भरी काढानी.<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">खरा सत्य</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />मना भाऊ अनी बहिणीसवन, आते इतलंच सांगानं शे की प्रभुमा एक व्हईन आनंद करा. असा गोष्टी तुमले लिखाले मी कटाळा करस नही, त्या तुमले दृढ करणाऱ्या शेतस. <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />ज्या कुत्रा वाईट गोष्टी करतस अनं ज्या सुंता कराकरता दोष देतसं असा लोकसपाईन सावध रहा. <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />ज्या आपन देवना आत्माघाई सेवा करनारा, ख्रिस्त येशुबद्दल अभिमान बाळगणारा अनी शरिरवर भरवसा नही ठेवणारा त्या आपन खरा सुंता व्हयेल शेतस; <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />तरी शरिरवर बी भरवसा शे, जर दुसरा कोनले शरिरवर भरवसा ठेवाना अस वाटनं तर जास्त वाटी. <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" /><note caller="+" style="x"><char style="xo" closed="false">३:५ </char><char style="xt" closed="false"><ref loc="ROM 11:1">रोम ११:१</ref>; </char><char style="xt" closed="false"><ref loc="ACT 23:6">प्रेषित २३:६</ref>; <ref loc="ACT 26:5">२६:५</ref></char></note>मी तर आठवा दिनले सुंता व्हयेल, इस्त्राएल जातीना, बन्यामीन वंशना, इब्रीसना खरा रंगतना इब्री; नियमशास्त्रना नजरतीन मी परूशी व्हतू, <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" /><note caller="+" style="x"><char style="xo" closed="false">३:६ </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेषित ८:३</ref>; <ref loc="ACT 22:4">२२:४</ref>; <ref loc="ACT 26:9-11">२६:९-११</ref></char></note>मना आस्थाबद्दल सांगानं तर मी मंडळीना छळ करेल शे, नियमशास्त्रनी ठरायेल नितीमत्वाबद्दल मी निर्दोष शे. <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />तरी ज्या गोष्टीसना माले लाभ व्हता त्या आते मी ख्रिस्तकरता नुकसान अस समजस. <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />इतलंच नही, तर ख्रिस्त येशु मना प्रभु, त्यानाबद्दलना सर्वश्रेष्ठ ज्ञानमुये मी बाकी सर्वकाही नुकसान समजस, त्यानाकरता सर्वकाही मी गमाडेल शे. ख्रिस्त मिळाकरता मी सर्वकाही कचरा समजस. <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />अनी मी त्यानाठायी ऱ्हायेल असा सापडाले पाहिजे, मनं नितीमत्व नियमशास्त्रना योगे मिळेल नही, तर त्या ख्रिस्तवरला ईश्वासतीन, म्हणीसन देवपाईन ईश्वासतीन मिळणारं नितीमत्व अस शे. <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />हाई असाकरता की तो त्याना पुनरूत्थानना सामर्थ्य अनी त्याना दुःखना भागीपण हाई मी त्याना मरणले अनुरूप व्हईसन समजी लेवानं. <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />म्हणीसन माले कसं बी प्रकारे मरण माईन पुनरूत्थान मिळाले पाहिजे.<verse eid="PHP 3:11" /></para>
  <para style="s">ध्येयाना दिशाकडे धावानं</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />हाई अस नही की मी पहिलेच बक्षीस मिळाडेल शे किंवा पहिलेच परिपुर्ण व्हयेल शे. ज्या बक्षीसकरता ख्रिस्त येशुनी माले ताबामा लिधं ते बक्षीस मिळाडाकरता मी प्रयत्न करस. <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />मना भाऊ अनी बहिणीसवन, ते मी मिळाडं अस समजस नही, पण एक गोष्ट शे की, ती कराना मी निश्चय करस, जे भुतकाळमा शे ते मी ईसरस, अनी जे मनासमोर शे ते मिळाडाना प्रयत्न करस. <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />ख्रिस्त येशुमा जे वरनं पाचारन, जे देवनं बक्षीस ते जिंकाकरता मर्यादावरनी खुनकडे मी धावस. <verse eid="PHP 3:14" /><verse number="15" style="v" sid="PHP 3:15" />तर जितला आपण प्रौढ शेतस तितलासनी हाऊ भाव धराले पाहिजे, अनी तुम्हीन एखादी गोष्टबद्दल दुसरा भाव धरा, तरी देव ते बी तुमले प्रकट करी. <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />इतलंच की, आपन ज्या नियमतीन आतेपावत चालनुत त्याच नियमतीन पुढे बी चालाले पाहिजे. <verse eid="PHP 3:16" /><verse number="17" style="v" sid="PHP 3:17" /><note caller="+" style="x"><char style="xo" closed="false">३:१७ </char><char style="xt" closed="false"><ref loc="1CO 4:16">१ करिंथ ४:१६</ref>; <ref loc="1CO 11:1">११:१</ref></char></note>मना भाऊ अनी बहिणीसवन, तुम्हीन सर्वाजनं मना अनुकरण करनारा असा व्हा, अनी आम्हीन जसं तुमनासमोर दृष्टांत शेतस, त्याप्रमाणतीन ज्या चालतस त्यासनाकडे बी ध्यान ठेवा. <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />कारण याना पहिले मी तुमले जसं बराच वेळा सांगं अनी आते बी परत रडीसन सांगस, बराचजनं असा शेतस की, ज्या ख्रिस्तना क्रुसखांबना वैऱ्यासनामायक वागतस. <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />नाश हाऊ त्यासना शेवट, शरिरनी ईच्छा हाई त्यासना देव, अनी लाज हाई त्यासनं गौरव शे, त्यासनं चित्त पृथ्वीवरला गोष्टीसवर ऱ्हास. <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />आपलं नागरिकत्व तर स्वर्गीय शे तठेईन प्रभु येशु ख्रिस्त हाऊ तारणारा असा ई, यानी आपन वाट दखतस. <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />त्याना ज्या सामर्थ्यघाई तो सर्वकाही आपला स्वाधीन कराले समर्थ्य शे त्यानाघाई तो आपलं शरीर बदली टाकी, अनी त्याना वैभवी शरिरनामायक करी.<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">बोध</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />म्हणीसन मना भाऊ अनी बहिणीसवन, तुमनाकडे मना ध्यान लागेल शे, तुम्हीन मना आनंद अनी अभिमान शेतस, प्रिय भाऊ अनी बहिणीसवन, मी तुमले सांगाप्रमाणे तुम्हीन प्रभुमा तसाच स्थिर ऱ्हावाले पाहिजे.<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />मी युवदीयीले अनी संतुखीले ईनंती करस की, तुम्हीन बहिणी प्रभुना ठायी एकचित्त राहा; <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />मना ईश्वासु सहकारीसवन, मी तुमले सांगस की, ज्या बाईसनी मनासंगे सुवार्ताना प्रचार कराकरता कष्ट लिधं अनी ज्यासनी नावे देवनं जिवनना पुस्तकमा लिखेल शेतस त्यासले कृपा करीसन मदत करा. <verse eid="PHP 4:3" /><verse number="4" style="v" sid="PHP 4:4" />प्रभुमा एक व्हईसन सर्वदा आनंद करा; परत सांगस, आनंद करा. <verse eid="PHP 4:4" /><verse number="5" style="v" sid="PHP 4:5" />तुमनी सौम्यता सर्वासले समजाले पाहिजे, प्रभुनं येणं जोडे येल शे. <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />कसानी बी काळजी करानी नही तर सर्व गोष्टीसबद्दल प्रार्थना अनी ईनंती करीसन आभार प्रदर्शनासंगे आपली मागणी देवले सांगा. <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />म्हणीसन सर्व बुध्दी सामर्थ्यना पलीकडे असेल देवनी शांती तुमना अंतःकरण अनी तुमना ईचार ख्रिस्त येशुमा राखी. <verse eid="PHP 4:7" /><verse number="8" style="v" sid="PHP 4:8" />मना भाऊ अनी बहिणीसवन, शेवट ईतलच सांगस की, जे काही सत्य, सन्मान, न्याय, शुध्द, प्रिय, सुश्राव्य, जो काही सद्गुण, जी काही स्तुती त्यासनं मनन करा. <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />जे तुम्हीन शिकणात, जे स्विकारणात, अनी मनं ऐकं अनं दखं ते करा; म्हणीसनं शांतीना देव तुमनासंगे राही.<verse eid="PHP 4:9" /></para>
  <para style="s">दान भेटाबददल धन्यवाद</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />माले प्रभुमा मोठा आनंद व्हयना की आते तरी तुमनी मना बद्दलनी काळजी परत जागी व्हयनी; हाई काळजी तुम्हीन करी राहींतात, पण ती दखाडाले तुमले संधी भेटनी नव्हती. <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />मी हाई गरजपोटी बोलस अस नही, कारण शे त्या स्थितीमा मी समाधानी ऱ्हावाले शिकनु शे. <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />अडचणमा ऱ्हावानं माले समजस, संपन्नतामाही ऱ्हावानं समजस; प्रत्येक प्रसंगले अनी सर्व प्रसंगले अन्नतृप्त ऱ्हावानं, अनी उपाशी बी ऱ्हावानं, संपन्न ऱ्हावानं अनी गरीब बी ऱ्हावानं, ह्यानं शिक्षण माले भेटेल शे. <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />जो ख्रिस्त माले सामर्थ्य देस त्यानाद्वारा मी सर्व परिस्थीतीना सामना करू शकस.<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />त्यामुये मना संकटमा तुम्हीन मना सहभागी व्हयनात हाई चांगलं करं. <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />फिलीप्पैकरसवन, तुमले बी माहीत शे की, सुवार्ताना सुरवातना दिनमा, मी मासेदोनियातीन निंघनु, तवय फक्त तुमना शिवाय कोणती बी मंडळीनी मनासंगे देवान घेवानना व्यवहार करा नही. <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" /><note caller="+" style="x"><char style="xo" closed="false">४:१६ </char><char style="xt" closed="false"><ref loc="ACT 17:1">प्रेषित १७:१</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">४:१६ </char><char style="xt" closed="false"><ref loc="2CO 11:9">२ करिंथ ११:९</ref></char></note>मी थेस्सलनीकामा व्हतु तवयच मना गरजकरता तुम्हीन एकपेक्षा जास्त दाव माले मदत धाडी. <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />मी तुमना कडतीन बक्षिसनी ईच्छा धरस अस नही, तर तुमना हिसाबनी जास्त वाढ व्हवाले पाहिजे अशी ईच्छा धरस. <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />माले पाहिजे ते सर्व मनाजोडे शे अनी जास्त बी शे, तुमनापाईन येल बक्षिस एपफ्रदीसना हाततीन भेटामुये माले भरपुर व्हयनं, ते मधुर सुगंधी अर्पण स्विकाराले योग्य अस यज्ञ जो देवले संतोष दि अस शे. <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />मना देव आपला संपत्यनुरूप तुमनी सर्व गरज ख्रिस्त येशुना गौरवमा पुराई. <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />आपला देवपिता याले युगानुयुग गौरव राहो. आमेन.<verse eid="PHP 4:20" /></para>
  <para style="s">सलाम</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />ख्रिस्त येशुमा प्रत्येक पवित्र जणसले सलाम सांगा. मनासंगेना भाऊ तुमले सलाम सांगतस. <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />सर्व पवित्रजन अनी विशेषकरतीन कैसरना घरना तुमले सलाम सांगतस.<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />प्रभु येशु ख्रिस्तनी कृपा तुमना सर्वाससंगे राहो.<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>