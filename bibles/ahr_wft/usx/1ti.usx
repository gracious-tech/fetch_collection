<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Ahirani</book>
  <para style="h">१ तिमथ्य</para>
  <para style="toc3">१ तिमथ्य</para>
  <para style="toc2">१ तिमथ्य</para>
  <para style="toc1">पौलनी लिखेल तिमथ्यले पहिलं पत्र</para>
  <para style="mt2">पौलाने लिहिलेले तिमथ्याला पहिले पत्र</para>
  <para style="mt1">पौलनी लिखेल तिमथ्यले पहिलं पत्र</para>
  <para style="imt">वळख</para>
  <para style="ip">पहिला तिमथ्यनं पुस्तक हाई एक पत्र शे, जे प्रेषित पौलनी त्याना शिष्य तिमथ्यीले लिखेल शे, हाई पुस्तक खिस्तना जन्मनंतर ६२-६४ सालना दरम्यान लिखाई जायेल शे. हाई ती येळ व्हती जवय पौलना जिवनना अंत जोडे येल व्हता पौल अनी तिमथ्य यासनामा संबध खोलवर व्हता अनी तो तिमथ्यीले घडीघडी पोऱ्या म्हणस. <char style="xt"><ref loc="PHP 2:22">फिलप्पै २:२२</ref></char>, <char style="xt"><ref loc="1TI 1:2">१ तिमथ्य १:२</ref></char>, <char style="xt"><ref loc="1TI 1:18">१:१८</ref></char></para>
  <para style="ip">हाई त्या चार पत्रसमाधला शे ज्या पौलनी एक मंडळीले नही तर व्यक्तीले लिखेल शे. दुसरा तीन पुस्तके ह्या शेतस, २ तिमथ्यी, तितस, अनी फिलेमोन १ तिमथ्यीना या पत्रमा मंडळीनी आराधना, <char style="xt"><ref loc="1TI 2:1-15">२:१-१५</ref></char> मंडळीना अधिकारीसना गुणलक्षण <char style="xt"><ref loc="1TI 3:1-13">३:१-१३</ref> </char> अनी खोटा शिक्षकसना विरूध्द चेतावणी <char style="xt"><ref loc="1TI 1:3-11">१:३-११</ref></char>, <char style="xt"><ref loc="1TI 4:1-5">४:१-५</ref></char>, <char style="xt"><ref loc="1TI 6:2-5">६:२-५</ref></char> या विषयसनाबद्दल बराच बोध करेल दखास. असंच १ तिमथ्यीमा असा तत्त्वसना उल्लेख शे की, ज्या आमना आजनी मंडळीसना पुढारीसले स्थानीक मंडळीनी सेवानी व्यवस्थापण कराले मदत करू शकस.</para>
  <para style="iot">रूपरेषा</para>
  <para style="io1">१. पौल तिमथ्यीले नमस्कार करीसन हाई पत्रनी सुरवात करस. <char style="ior"><ref loc="1TI 1:1-2">१:१-२</ref></char></para>
  <para style="io1">२. पौल तिमथ्यीले खोट्या शिक्षकसना विरूध्दमा चेतावणी देस <char style="ior"><ref loc="1TI 1:3-11">१:३-११</ref></char></para>
  <para style="io1">३. पुढे पौल हाई स्पष्ट करस की, तो येशु ख्रिस्तनाकरता देवना कितला आभारी शे. <char style="ior"><ref loc="1TI 1:12-19">१:१२-१९</ref></char></para>
  <para style="io1">४. पौल तिमथ्यीले आराधना अनी मंडळीसना पुढारी याबद्दल शिक्षण देस. <char style="ior"><ref loc="1TI 2-3">२–३</ref></char></para>
  <para style="io1">५. काही अंतिम सुचना दिसन पौल त्यानं हाई पत्रना शेवट करस<char style="ior"><ref loc="1TI 4-6">४–६</ref></char></para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />देव आपला तारणारा अनं ख्रिस्त येशु आपली आशा यानी आज्ञातीन ख्रिस्त येशुना प्रेषित पौल याना कडतीन;<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:२ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">प्रेषित १६:१</ref>
      </char>
    </note>मना ईश्वासमा खरा पुत्र तिमथ्य याले, देवबाप अनी ख्रिस्त येशु आपला प्रभु यानापाईन कृपा, दया अनी शांती राहो.<verse eid="1TI 1:2" /></para>
  <para style="s">खोटा शिक्षणबद्दल इशारा</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />मी मासेदोनिया जाई राहींतु तवय तुले इफिसमा ऱ्हावानी ईनंती करी, त्या येळले तु काही लोकसले ताकिद देवाले पाहिजे की, खोटं शिक्षण देवानं बंद करा, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />अनी त्यासले अस सांग, जी देवनी व्यवस्था ईश्वासनाद्वारा शे, तिना उपयोगमा नही पडणारा, पण वाद उत्पन्न करनारा गोष्टिसकडे अनी अनंत वंशावळसकडे ध्यान देऊ नका. <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />शुध्द मनतीन, चांगला भावनातीन, अनी निष्कपट ईश्वासमातील प्रिती ऱ्हावाले पाहिजे, हाऊ आज्ञाना हेतु शे. <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />या गोष्टीसले सोडिसन कितलातरी लोके मुर्खपणना गोष्टीसकडे वळेल शेतस. <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />त्या नियमशास्त्रना शिक्षक व्हवाले दखतस, पण त्या काय बोलतस, अनं ज्या गोष्टीसबद्दल त्या खात्रीतिन सांगतस ते त्यासले समजस नही.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />नियमशास्त्रना जर कोणी बराबर उपयोग करी तर ते चांगलं शे, हाई आपलाले कळस. <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />आपण बी हाई समजतस की, मोशेना नियमशास्त्र धार्मीकसकरता नही, तर अधर्मी, भक्तीहिन, पापी, अपवित्र, आई बापले मारनारा, माणससनी हत्या करनारा, <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />जारकर्मी, समलींगी संबंध ठेवणारा, गुलामसना व्यापार करनारा, लबाड, खोटी साक्ष देणारा यासनाकरता अनी ज्या कोणी सुशिक्षण विरोधी शेतस. त्यानासकरता करेल शे. <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />धन्यवादित देवना गौरवनी जी सुवार्ता जाहीर कराकरता माले सोपेल शे, निश्चित तिले धरीन हाई शे.<verse eid="1TI 1:11" /></para>
  <para style="s">देवना कृपाकरता धन्यवाद</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />ज्यानी माले शक्ती दिधी अनी त्याना कामकरता ठेयल शे, त्या आपला प्रभु येशु ख्रिस्तना मी उपकार मानस; <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" /><note caller="+" style="x"><char style="xo" closed="false">१:१३ </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेषित ८:३</ref>; <ref loc="ACT 9:4">९:४</ref>,<ref loc="ACT 9:5">५</ref></char></note>कारण मी जो पहिले त्यानी निंदा करनारा, छळ अनी त्रास देनारा व्हतु, मी जे करं ते ईश्वास नव्हता म्हणीसन अनी अज्ञानमुये करं, म्हणीसन मनावर दया व्हयनी; <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />ख्रिस्त येशुवरला ईश्वास अनी प्रेम यानामुये आपला प्रभुनी कृपा मोठी व्हयनी. <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />ख्रिस्त येशु पापी लोकसनं तारण कराले ह्या जगमा वना, हाई वचन ईश्वसनीय अनी कायम स्विकाराले योग्य शे; त्या पापी लोकसमा मी मुख्य शे. <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />तरी ज्या युगानुयुगना जिवनकरता त्यानावर ईश्वास ठेवतीन, त्यासले दृष्टांत मिळाले पाहिजे म्हणीसन येशु ख्रिस्तनी मी जो मुख्य पापी, त्या मनाबद्दल आपली सर्व सहनशक्ती दखाडाले पाहिजे, तर मनावर दया व्हई. <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />जो सनातन राजा, अविनाशी, अदुश्य, असा एकच देव त्याले, सन्मान अनी गौरव युगानुयुग राहो, आमेन.<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />मना पोऱ्या तीमथ्य, तुनाबद्दल पहिलेच व्हयेल भविष्यवाणीना मायक हाई आज्ञा मी तुले सांगी ठेवस की, तु त्या आज्ञाना वापर करीसन सुयुध्द कर. <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />ईश्वास अनी चांगला विवेकभाव धर; कित्येकसनी हाई सोडी देवामुये त्यासनं ईश्वास रूपी जहाज फुटनं. <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />त्यासमा हुमनाय अनी अलेक्सांद्रा ह्या शेतस, त्यासले मी सैतानना हातमा देयल शे, याकरता की त्यासनी दुसरासनी निंदा करानी नही हाई शिकाले पाहिजे.<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">प्रार्थनाबद्दल सल्ला</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />तर सर्वात पहिले हाऊ बोध मी करस की सर्व मनुष्यसकरता विनंत्या, मध्यस्थी, एकमेकसकरता प्रार्थना अनी देवना उपकार मानानं. <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />राजाकरता अनी सर्व मोठा अधिकरीसकरता करानं यानाकरता की आपण सर्व सुभक्तीतीन अनी पवित्रतातीन शांतीनं अनं स्वस्थपणनं अस आपलं आयुष्यक्रम कराले पाहिजे. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />हाई आपला तारणारा देव याना दृष्टीतीन चांगलं अनी स्विकाराकरता योग्य शे. <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />त्यानी ईच्छा शे की सर्व मनुष्यसनं तारण व्हवाले पाहिजे, अनी त्यासनी पुर्णपणे सत्यले वळखाले पाहिजे. <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />कारण एकच देव शे, अनी देव अनं मनुष्य यामाधला ख्रिस्त येशु हाऊ एकच मनुष्य मध्यस्ती शे. <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />त्यानी सर्वासना करता, मुक्तीनं मोल म्हणीसन त्यानी स्वतःले दिधं, यानी साक्ष योग्य येळवर देवामा वनी. <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" /><note caller="+" style="x"><char style="xo" closed="false">२:७ </char><char style="xt" closed="false"><ref loc="2TI 1:11">२ तिमथ्य १:११</ref></char></note>ह्या साक्षकरता माले घोषणा करनारा अनी मी प्रेषित सत्य बोलस लबाडी करस नही, ईश्वास अनी सत्य ह्याना संबधमा गैरयहूदी लोकसना शिक्षक असा नेमेल शे.<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />मनी ईच्छा अशी शे की, प्रत्येक आराधनाना जागावर माणससनी राग अनी भांडण हाई व्हवु देवानं नही तर ज्या देवले समर्पित शेतस, त्यासनी हात वर करीसन प्रार्थना करानी. <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" /><note caller="+" style="x"><char style="xo" closed="false">२:९ </char><char style="xt" closed="false"><ref loc="1PE 3:3">१ पेत्र ३:३</ref></char></note>तशी मनी ईच्छा शे की बायासनी शोभी असा कपडा घालीन स्वतःले सभ्यताना मर्यादामा सजाडानं. विविध प्रकारनं केस इनानं, अनी सोनं, मोती, मोल्यवान कपडा यासनी नही, <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />तर चांगला कामसतीनं सजाडानं, जे देव भक्ती स्विकारेल बाईसले हाई शोभस. <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />बायासनी पुर्ण नम्रतातीन अनी शांततामा शिकानं. <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />बाईले शिकाडानी अनी माणुसवर मालकपण चालाडानी परवानगी मी देस नही, तिनी शांत ऱ्हावाले पाहिजेल. <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />कारण पहिले आदाम बनना नंतर हवा. <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />आदाम फसना नही, पण बाई फशीसन अपराधमा पडनी अनी तिनी नियम तोडा. <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />ती सभ्यतातीन ईश्वास, प्रेम, पवित्रता यानामा राहिनी तर पोऱ्यासले जन्म देवावर तीनं तारण व्हई.<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">मंडळीना प्रमुख</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />जर एखादा अध्यक्ष व्हवाले दखस, तर तो चांगला कामनी ईच्छा करस, हाई वचन ईश्वसनीय शे. <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" /><note caller="+" style="x"><char style="xo" closed="false">३:२ </char><char style="xt" closed="false"><ref loc="TIT 1:6-9">तिताले पत्र १:६-९</ref></char></note>अध्यक्ष हाऊ दोष रहीत, एक बाईना नवरा, नियमसले धरीसन चालनारा, शिस्तप्रिय अनी अतिथीप्रिय<note caller="+" style="f"><char style="fr" closed="false">३:२ </char><char style="fq" closed="false">अतिथीप्रिय </char><char style="ft" closed="false">ज्याले पाहुणचार कराले आवडस</char></note> अनी सुशिक्षक असा ऱ्हावाले पाहिजे. <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />तो दारुडा अनी भांडणारा असा नही पाहिजे, अनी भांडण करनारा नही, शांत राहणारा अनी पैसासना लोभ नही करनारा. <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />आपला घरनी व्यवस्था चांगली ठेवनारा आपला पोऱ्यासले चांगलं वळन लावणारा, अनी नियमसमा ठेवनारा ऱ्हावाले पाहिजे. <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />ज्याले आपला घरनी व्यवस्था चांगली संभाळता येस नही, तो देवनी मंडळीले कसा सांभाळी? <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />त्यानी गर्व करीसन सैतानना जाळामा अडकाले नको म्हणीसन, तो ईश्वासमा परिपक्व ऱ्हावाले पाहिजे. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />त्यानी निंदा व्हवाले नको, अनी तो सैतानना हातमा सापडाले नको म्हणीसन, त्यानी मंडळीना बाहेरना लोकसमा चांगलं नाव कमाडेल पाहिजे.<verse eid="1TI 3:7" /></para>
  <para style="s">मंडळीना सेवक</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />तसच मंडळीना सेवकनं बी चांगलं चरीत्र ऱ्हावाले पाहिजे, चांगला स्वभावना, दारू पिणारा अनी पैसा खाणारा नको पाहिजे. <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />ईश्वासनं सत्यले चांगलं, निर्मलतातीन ठेवनारा ऱ्हावाले पाहिजे. <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />त्यानी बी पहिले परिक्षा व्हवाले पाहिजे, अनी परिक्षा पास व्हवानंतरच त्यानी सेवकपण करानं. <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />तसच <note caller="+" style="f"><char style="fr" closed="false">3:11 </char><char style="ft" closed="false">मदत करणाऱ्या बाया</char></note>बायासनी बी सन्मानतीन ऱ्हावानं, चुगल्या करणाऱ्या नही तर नियमसले धरीसन चालनाऱ्या अनी सर्व गोष्टिसबद्दल ईश्वासी ऱ्हावाले पाहिजे. <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />मंडळीना सेवक हाऊ एक बाईना नवरा ऱ्हावाले पाहिजे, तो आपला घरनी अनी पोऱ्यासनी व्यवस्था चांगली ठेवनारा पाहिजे. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />कारण ज्यासनी सेवकनं काम चांगला प्रकारे पुरं करं, त्या आपलाकरता मोठा सन्मान मिळाडतीन, अनी ईश्वासमा ज्या ख्रिस्त येशुमा शेतस त्या धैर्य मिळावतस.<verse eid="1TI 3:13" /></para>
  <para style="s">महान रहस्य</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />तुनाकडे लवकर येवानी आशा धरीसन मी हाई तुले पत्र लिखेल शे. <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />तरी बी जर माले येवाले येळ लागना तर सदाजिवित अशी देवनी मंडळी, जी सत्यना खांब अनी पाया असा शेतस त्यासनी देवना घरमा कसं वागाले पाहिजे ते हाई पत्रमुये तुले समजी. <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />कोणीच नाकारू शकस नही की, भक्तीनं रहस्य मोठं शे, जसं की;</para>
  <para style="q1" vid="1TI 3:16">तो जो शरिरमा ऱ्हाईसन प्रकट व्हयना,</para>
  <para style="q2" vid="1TI 3:16">आत्माघाई नितीमान ठरना,</para>
  <para style="q2" vid="1TI 3:16">अनी देवदूतसले दखायना.</para>
  <para style="q1" vid="1TI 3:16">त्यानी राष्ट्रसमा घोषणा व्हयनी,</para>
  <para style="q2" vid="1TI 3:16">जगमा त्यानावर ईश्वास ठेवामा वना,</para>
  <para style="q2" vid="1TI 3:16">अनी तो गौरवमा वर लेवाई गया.<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">खोटा शिक्षक</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />पण पवित्र आत्मा स्पष्ट सांगस की, येणारा काळमा काही लोके फसाडणारा आत्मासना अनी दुष्ट आत्मासना शिक्षणकडे लक्ष लावामुये ईश्वासपाईन दुर व्हतीन. <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />अस त्या ढोंगी लोकसना खोटापणमुये व्हई, ज्यासनं मन मरी जायेल शे. जसं की जळणारा लोखंड <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />त्या लगीन कराले मनाई करतीन, अनी त्या काही प्रकारनं अन्न खावाले मनाई करतस, पण देवनी हाई जेवण ईश्वासी लोकसकरता बनाडेल शे, कारण त्यासनी उपकारस्तुतीनी प्रार्थना करीसन ते अन्न खावाले पाहिजे, असा ईश्वासी लोके खरं शिक्षणले वळखतस. <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />देवनी तयार करेल प्रत्येक वस्तु चांगली शे. अनी जे देवनं नाव लिसन लेयल शे ते नकारता येस नही. <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />कारण देवनं वचन अनी प्रार्थना ह्यापाईन ते शुध्द व्हस.<verse eid="1TI 4:5" /></para>
  <para style="s">येशु ख्रिस्तना चांगला सेवक</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />ह्या गोष्टीसनी भाऊसले आठवण करी दे. म्हणजेच ईश्वासना वचनतीन अनी ज्या सुशिक्षणले तु धरीसन गया, त्या वचनसनं पोषण करनारा असा तु ख्रिस्त येशुना चांगला सेवक व्हशी. <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />अधर्म अनी आयाबायासन्या गोष्टीसपाईन दुर ऱ्हावानं, अनी सुभक्तीबद्दल कसरत करा. <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />कारण शारिरीक कसरत थोडीच उपयोगी शे, सुभक्ती तर सर्व कामसमा उपयोगी शे, तिले आत्तेनं अनी पुढला जिवननं अभिवचन मिळेल शे <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />हाई वचन सत्य शे, ईश्वसनीय अनी कायम स्विकाराले योग्य शे. <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />यानाकरता आम्हीन श्रम अनी खटपट करतस, कारण जो सर्व लोकेसना अनी विशेष करीसन ईश्वास ठेवणारासना तारणारा, त्या सदाजिवत असा देववर आम्हीन आशा ठेयेल शे.<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />या गोष्टी आज्ञा रूपतीन सांगीसन शिकाड. <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />कोणी बी तुना तरूणपणले तुच्छ मानाले नको. तर तुनं भाषण, प्रेम, तुनं वागणं, अनी शुध्दता यानाबद्दल ईश्वास ठेवणारा लोकसना आदर्श व्हय. <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />मी येस तोपावत वचन वाचामा, प्रचार करामा, अनी शिक्षण देवानं, यासनाकडे ध्यान दे. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />तुनावर वडील लोकेसनी हात ठिसन संदेशना द्वारा तुले देयल अस कृपादान तुनामा शे त्यानाकडे दुर्लक्ष करानं नही. <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />तुनी प्रगती सर्वासले दखावाले पाहिजे म्हणीसन तु या गोष्टिसनं ज्ञान ठेव अनी यानामा मग्न व्हई जाय. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />आपलाकडे अनी आपला शिक्षणकडे निट ध्यान दे, त्यानामाच टिकिसन ऱ्हाय, कारण अस करावर तुनं अनी तुनं ऐकी लेणारसनं बी तारण व्हई.<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">ईश्वासी लोकसबद्दल जबाबदारी</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />वडील लोकसले वरडीन बोलानं नही, तर त्यासले बाप मानीसन, तरूणसले भाऊ मानीसन बोध कर; <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />वयस्कर बायासले माय मानीसन, तरूणीसले बहिण मनीसन, पुर्ण शुध्दतातीन बोध कर.<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />ज्या खरच विधवा शेतस त्यासना योग्य मान राख. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />एखादी विधवाले पोऱ्या किंवा नातु व्हतीन तर त्यासनी पहिले आपला घरनाससंगे धर्मनिष्ठ वृत्तीतिन वागीन आपला वडीलसना उपकार फेडाले शिकानं, कारण हाई देवले मान्य शे. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />जी विधवा शे, अनी एकटीच पडेल शे, तिनी आपली आशा देववर ठेवस, अनी ती रातनं-दिन ईनंती अनी प्रार्थना करस. <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />पण जी विधवा शारिरीक ईच्छा पुरी कराकरता लागेल शे, ती जिवत राहीसन बी मरेल शे. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />त्यासनी दोष रहीत ऱ्हावाले पाहिजे म्हणीसन त्यासले यानामायक वागानी आज्ञा कर <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />जर कोणी आपलासनी अनी विशेष करीसन आपला घरनासनी तरतुद करस नही, तर तो अईश्वासु शे अस व्हस, तो माणुस ईश्वास ठेवनारा माणुसपेक्षा वाईट शे.<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />जी साठ वरीसना आतमा नही व्हई, अनं ती एकच नवरानी बायको व्हयेल व्हई. <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />जीनं चांगला कामसमुये नाव व्हयेल व्हई, म्हणजे जिनी पोऱ्यासले सांभाळेल व्हई, पाहुणचार करा व्हई, पवित्र लोकसना पाय धोयेल व्हतीन, संकटमा पडेल लोकसले मदत करी व्हई, सर्व प्रकारना चांगला कामे करेल व्हतीन, अस नाव कमाडेल विधवानं नाव यादीमा लिखी लेवाले पाहिजे.<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />तरूण विधवासले यादीमा लेवानं नही, कारण त्या शारिरीक ईच्छा पुरी कराकरता ख्रिस्तले सोडीसन त्या लगीन कराले दखतीन. <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />असासले दंड आज्ञा शे, कारण त्यासनी आपली पहिली प्रतिज्ञा मोडी. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />अनी त्या घर-घर फिरिसन आळशी व्हतस, इतलंच नही तर त्या कटकट करनाऱ्या अनी लुडबुड्या करनाऱ्या व्हतस, जे बोलानं नही ते बोलतस. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />यामुये मनी ईच्छा अशी शे की, तरूण विधवासनी लगीन करानं, पोऱ्यासले जन्म देवाना, घर चालाडानं अनी विरोधीसले नाव ठेवाकरता जागा देवानी नही. <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />कितल्या तर भटकिसन सैतानना मांगे निंघी जायेल शेतस. <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />जर कोणी ईश्वास ठेवणारी बाईना आठे विधवा व्हतीन, तर तिनी त्यासनी तरतुद करानी, त्यासना मंडळीवर भार पडु देवाना नही; म्हणजे ज्या खरच विधवा शेतस त्यासले मंडळीले मदत करता ई.<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />ज्या वडील लोके, अध्यक्षतानं मंडळीन काम चांगलं चालाडतस, विशेष करीसन ज्या उपदेश अनी शिक्षण याबद्दल श्रम लेतस त्यासले दुप्पट मजुरी मिळाले पाहिजे. <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" /><note caller="+" style="x"><char style="xo" closed="false">५:१८ </char><char style="xt" closed="false"><ref loc="MAT 10:10">मत्तय १०:१०</ref>; <ref loc="LUK 10:7">लूक १०:७</ref></char></note>कारण शास्त्र म्हणस, “बैल मळनी करस तवय त्याले मुसकं बांधु नको” अनी “काम करनारा आपला मजुरीकरता योग्य शे.” <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />दोन नही तर तिन साक्षीदार ऱ्हावाशिवाय वडील लोकसवरला आरोपसना खटला लेवाना नही. <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />बाकिनासले भिती वाटाले पाहिजे म्हणीसन पाप करनारासले सर्वासना समोर दोष लावा.<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />देव, ख्रिस्त येशु, अनी निवडेल देवदूत, यासना समोर मी तुले समजाडीसन सांगस, की मनमा हट्ट नही धरता या आज्ञा पाळ, पक्षपात करीसन काही करू नको. <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />उतावळा पणतीन कोणवर बी हात ठेवु नको<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="fq" closed="false">हात ठेवु नको </char><char style="ft" closed="false">म्हणजे दिक्षा देवु नको</char></note>, अनी दुसरासना पापना भागीदार व्हवु नको; स्वतःले शुध्द ठेव.<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />अनी यानापुढे नुसतं पाणीच पेत ऱ्हाऊ नको, तर आपला पोटकरता अनी आपला कायमना दुःखनाकरता थोडा द्राक्षना रस ले.<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />कित्येकसना पाप उघडा ऱ्हाईसन बी त्या त्यासना पुढे न्यायनिवाडाले जातस. अनी कित्येकसना त्यासना मांगतीन जातस. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />त्यानामायक उघडा असा काही चांगला कृत्य शेतस अनी ज्या दुसरा प्रकारना शेतस त्या पण गुप्त राहु शकस नही.<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />ज्या दास म्हणीन शेतस, त्या सर्वासनी आपआपला मालकले सर्व प्रकारना सन्मानकरता योग्य शेतस अस मानानं, हाई याकरता की देवना नावनी अनं शिक्षणनी निंदा व्हवाले नको; <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />अनी ज्यासना मालक ईश्वास ठेवणारा शेतस, त्यासनी ह्या भाऊ शेतस म्हणीसन त्यासना अपमान कराना नही, तर त्यासनी जास्त सेवा करानी, ज्यासले सेवाना लाभ व्हस त्या ईश्वास ठेवनारा अनी प्रिय शेतस.</para>
  <para style="s" vid="1TI 6:2">खोट शिक्षण अनं खरं-खुरं धन</para>
  <para style="p" vid="1TI 6:2">या गोष्टी शिकाड अनी त्याबद्दल बोध कर. <verse eid="1TI 6:2" /><verse number="3" style="v" sid="1TI 6:3" />जर कोणी दुसरं प्रकारनं शिक्षण देस, अनी आपला प्रभु येशु ख्रिस्तना ज्या वचनं अनी दैवी शिक्षण मानस नही, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />तर तो घमेंडी शे, त्याले काहीच समजस नही तो वादविवाद, अनी भांडण यासनामुये येडा बनेल शे, यापाईन हेवा, आपसमाधला, अपशब्द, दुसरासबद्दल कुकल्पना उत्पन्न व्हतस. <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />मंग बिघडेल, अनी सत्यपाईन दुर जायेल ह्यासले धर्म हाई एक कमाईनं साधन शे. अशी कल्पना करनारा माणससमा कायम भांडणं व्हतस.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />संतोषमा करेल सुभक्ती तर मोठाच लाभ शे. <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />आपण जगमा काहीच आणं नही, तर आपलाले त्यासनामातीन काही लई जाता येवाव नही, <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />जरी आमले जेवण अनी कपडा राहिनात तरी आमले पुरं शे. <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />पण ज्या श्रीमंत व्हवाले दखतस त्या परिक्षामा अनी मनुष्यले नाशमा अनं विध्वंसमा बुडावनारा असा मुर्खपणना अनं नाशवंत वासनासमा सापडतस. <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />कारण पैसासना लोभ सर्व प्रकारना वाईटनं मुळ शे. त्याना मांगे लागीसन कितलातरी ईश्वासपाईन दुर जायेल शेतस, अनी त्यासना मनं बराच दुःखतीन तुटेल शे.<verse eid="1TI 6:10" /></para>
  <para style="s">वयक्तीक सुचना</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />हे देवभक्त, तु यानापाईन पय अनी नितिमत्व, सुभक्ती, ईश्वास, प्रिती, धीर अनी नम्रता यासना मांगे लाग. <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />ईश्वासबद्दल जी शर्यत ती कर, युगानुयुगनं जिवन मिळाव, त्यानाकरताच तुले निवडेल शे अनी बराच साक्षीदारस समोर तु ते स्विकारीन मान्य करेल शे. <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" /><note caller="+" style="x"><char style="xo" closed="false">६:१३ </char><char style="xt" closed="false"><ref loc="JHN 18:37">योहान १८:३७</ref></char></note>सर्वासले जिवन देणारा जो देव त्याना समोर अनी ज्या ख्रिस्त येशुनी पंतय पिलात समोर तो स्विकार करा त्याना समोर मी तुले समजाडीन सांगस. <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />आपला प्रभु येशु ख्रिस्त प्रकट व्हस तोपावत तु त्यानी आज्ञा निष्कलंक, अनी दोष रहीत ठेव. <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />जो धन्य अनी एकच अधिपती राजासना राजा अनी प्रभुसना प्रभु अनी ज्या एकलेच अमरत्व शे, अनी जो प्रकाशमा ऱ्हास अनी ज्याले कोणताच मनुष्यनी दखेल नही. <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />अनी कोणकडतीन दखास नही, तो ते त्यानं प्रकट व्हवानं अनी पुढला काळमा दखमा ई; त्याले सन्मान अनं युगानुयुगनं सामर्थ्य असो. आमेन.<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />चालु युगमाधला धनवानसले सांग की, तु अभिमानी व्हवानं नही, चंचल धनवर आशा ठेवानी नही, तर जो सदाजिवी देव आपलाले उपभोगाकरता सर्वकाही भरपुर देस त्यानावर आशा ठेवानी. <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />त्यासले आज्ञा दे की, चांगलं ते करानं, चांगला कामबद्दल धनवान ऱ्हावानं, दानशील, मदत कराले नेहमी तयार ऱ्हावानं. <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />जे खरं जिवन ते भेटाकरता पुढला काळमा चांगला आधार व्हई अशी साठवण आपण करानी.<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />हे तीमथ्य, तुले स्वाधीन करेल ठेव सांभाळ; अधर्मन्या रिकाम्या वटवटी अनी जीले विद्या हाई नाव चुकीसन देयल शे, अनी विरोध करणाऱ्या गोष्टीसपाईन दुर ऱ्हाय. <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />काही लोकसनी असा दावा करेल शे की त्यासले हाई ज्ञान शे, पण त्या ईश्वासतीन भटकी जायेल शेतस.</para>
  <para style="p" vid="1TI 6:21">देवनी कृपा तुमनासंगे राहो.<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>