<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">ahiraani</book>
  <para style="h">१ थेस्सलनी</para>
  <para style="toc3">१ थेस्सलनी</para>
  <para style="toc2">१ थेस्सलनी</para>
  <para style="toc1">पौलनी लिखेल थेस्सलनीकरसले पहिलं पत्र</para>
  <para style="mt2">पौलाने लिहिलेले थेस्सलनीकरास पहिले पत्र</para>
  <para style="mt1">पौलनी लिखेल थेस्सलनीकरसले पहिलं पत्र</para>
  <para style="imt">वळख</para>
  <para style="ip">हाई पत्र जे पौलनी लिखेल व्हतं<char style="xt"><ref loc="1TH 1:1">१:१</ref></char>पहिले पवित्र शास्त्रना भाग व्हयना. अनी ख्रिस्तना जन्मना ५१ वरीस नंतर लिखाई गयं. जवय पौलनी हाई पत्र लिखं तवय तो करिंथ शहरमा व्हता. थेस्सलनीकानी मंडळी जिले त्यानी हाई पत्र लिखेल शे, तीले त्यानी आपली दुसरी मिशनरी फेरीना येळले स्थापन करेल व्हतं<char style="xt"><ref loc="ACT 17:1-10">प्रेषित १७:१-१०</ref></char> प्रेषितसन काम या पुस्तकमा अस लिखेल शे की, हाई मंडळी यहूदी अनी गैरयहूदीसनी बनेल व्हती.</para>
  <para style="ip">हाई मंडळीनी स्थापना करानंतर पौल थेस्सलनीकामा जास्त दिन राहू नही शकना. यामुये त्यानी हाई पत्र त्यासले प्रोत्साहण देवाकरता लिखं. हाई पत्रमा बराच गोष्टीसनी चर्चा करेल शे, जसं की, ख्रिस्ती लोकसनं जिवन कसं ऱ्हावाले पाहिजे. पौल ख्रिस्तना दुसरा आगमनबद्दल बी लिखस, यामुये की थेस्सलनीकामा राहणारी मंडळीले याबद्दल ऐकानी बरीच ईच्छा व्हती. पौल येशुना दुसरादांव येवाबद्दल लिखीसन अस जिवन जगाकरता प्रोत्साहीत करस की ज्यामुये परमेश्वर खूश व्हई. <char style="xt"><ref loc="1TH 5:6-8">५:६-८</ref></char></para>
  <para style="iot">रूपरेषा</para>
  <para style="io1">१. पौलना मंडळीले नमस्कार अनी परमेश्वरले धन्यवाद. <char style="ior"><ref loc="1TH 1">१</ref></char></para>
  <para style="io1">२. पौल आपला कार्यबद्दल अनी तिमथ्थीनी जी बातमी आनेल व्हती त्यावर चर्चा. <char style="ior"><ref loc="1TH 2-3">२–३</ref></char></para>
  <para style="io1">३. येशुनं दुसरींदाव येवानी तयारी कराकरता ख्रिस्ती लोकसनी कसं जिवन जगाले पाहिजे. <char style="ior"><ref loc="1TH 4:1">४:१</ref>; <ref loc="1TH 5:15">५:१५</ref></char></para>
  <para style="io1">४. पौलना मंडळीले नमस्कार अनी मंडळीना प्रत्येकनी त्यानं पत्र वाचाले पाहिजे यानी सुचना. <char style="ior"><ref loc="1TH 5:16-28">५:१६-२८</ref></char></para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:1">प्रेषित १७:१</ref>
      </char>
    </note>मी पौल, सिल्वान अनं तीमथ्य यानासंगे हाई पत्र लिखस, देव आपला पिता अनं प्रभु येशु ख्रिस्तना लोकसले ज्या थेस्सलनीकरसनी मंडळीमा शेतस, तुमले कृपा अनं शांती मिळो.<verse eid="1TH 1:1" /></para>
  <para style="s">थेस्सलनीकरसनं जिवन अनी ईश्वास</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />आम्हीन आमनी प्रार्थनामा तुमले याद करीसन कायम तुमना सर्वासकरता देवना उपकार मानतस. <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />आपला देवबापसमोर तुमनं ईश्वासतीन करेल काम, प्रितीतीन करेल कष्ट, अनं आपला प्रभु येशु ख्रिस्तना आशामुये धरेल धीर यानं आम्हीन कायम स्मरण करतस. <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />देवना प्रितीमाधला आमना भाऊ अनी बहिणीसवन, तुमनी व्हयेल निवड आमले माहितच शे. <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />कारण आमनी सुवार्ता फक्त शब्दसतीन नही, तर सामर्थ्यतीन, पवित्र आत्मातीन अनं पूर्ण खरापणना निर्धारतीन तुमले सांगामा वनी. तसच आम्हीन तुमनासंगे कसा वागनुत, हाई तुमले माहित शे, हाई तुमना चांगला करता व्हतं. <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" /><note caller="+" style="x"><char style="xo" closed="false">१:६ </char><char style="xt" closed="false"><ref loc="ACT 17:5-9">प्रेषित १७:५-९</ref></char></note>तुम्हीन फार संकटमा व्हतात तरी बी पवित्र आत्माना आनंदतीन वचन स्विकारीन आमनं अनं प्रभुनं अनुकरण करनारा व्हयनात; <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />अस करीसन तुम्हीन मासेदोनिया अनं अखया प्रांतमा राहनारा सर्व ईश्वासणारासले आदर्श व्हयनात. <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />मासेदोनिया अनं अखयामा तुमना कडतीन प्रभुना वचननी घोषणा व्हयेल शे; फक्त इतलंच नही तर देववरील तुमना ईश्वासनी बातमी सगळीकडे पसरेल शे; यामुये त्यानाबद्दल आमले काही सांगानी आवश्यकता नही. <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />त्या लोके तुमनाबद्दल आमले सांगतस की, आम्हीन तुमनाकडे वनुत तवय तुम्हीन आमनं कसं स्वागत करं, तुम्हीन मुर्तिपाईन देवकडे कशा वळणात, अनी जिवत अनं खरा देवनी सेवा कराले लागनात, <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />अनी त्याना पोऱ्या येशु ह्यानी स्वर्गमातीन येवानी वाट दखत ऱ्हा, त्या पोऱ्याले म्हणजे येशुले देवनी मरेल मातीन ऊठाडं अनं तो आपले परमेश्वर कडतीन येणारा क्रोधपाईन सोडवणारा शे.<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">पौलनं थेस्सलनीकामाधलं काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />भाऊसवन अनी बहिणीसवन, तुमनामा आमनं येणं व्यर्थ व्हयनं नही, हाई तुमले स्वतःले पण माहित शे. <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" /><note caller="+" style="x"><char style="xo" closed="false">२:२ </char><char style="xt" closed="false"><ref loc="ACT 16:19-24">प्रेषित १६:१९-२४</ref>; </char><char style="xt" closed="false"><ref loc="ACT 17:1-9">प्रेषित १७:१-९</ref></char></note>हाई बी तुमले माहितच शे की, तुमनाकडे येवाना पहिले फिलप्पैमा आम्हीन दुःख भोगीन अनं अपमान सोसीन, मोठा तरासमा राहिसन बी देवनी सुवार्ता तुमले सांगानं धैर्य आपला देवकडतीन आमले मिळनं. <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />कारण आमना उपदेश भ्रममा टाकणारा किंवा अशुध्दपणा यातीन निर्माण व्हयेल किंवा कपटना नव्हता. <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />तर सुवार्ता आमानावर सोपी देवाकरता देवनी आमले पारखीन पसंत करामुये आम्हीन ती सांगतस; आम्हीन माणससले खूश करासारखं नही बोलता आम्हीन अंतःकरण पारखणारा देव हाऊ ज्यामुये खूश व्हई तसं आम्हीन बोलतस. <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />आम्हीन हाजीहाजी करतांना कधीच दखायनुत नही, हाई तुमले माहीत शे, पैसाकरता ढोंगीपण करतांना आम्हीन कधी दखानुत का, देव आमना साक्षी शे! <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />तरी माणससपाईन म्हणजे तुमनापाईन किंवा दुसरासपाईन गौरव मिळावाकरता खटपट आम्हीन करी नही राहिंतुत; <verse eid="1TH 2:6" /><verse number="7" style="v" sid="1TH 2:7" />आम्हीन ख्रिस्तना प्रेषित ऱ्हावामुये आम्हीन तुमनावर वझ टाकतुत. तरी बी आपला पोऱ्यासोऱ्यासनं लालनपालन करणारी मायना मायक आम्हीन तुमनामा सौम्य वृत्तीना व्हतुत. <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />आमले तुमनाबद्दल कळकळ वाटस म्हणीन आम्हीन तुमले फक्त देवना सुवार्तानं दानच देवाले नही, तर तुमनावरली जास्त प्रितीमुये तुमनाकरता आमनं जिवन बी देवाले तयार व्हतुत. <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />भाऊसवन अनी बहिणीसवन, आमनं श्रम अनी कष्ट यानी आठवण तुमले नक्कीच शे; तुमना मातीन कोणले आमनं वझं व्हवाले नको, म्हणीसन आम्हीन रातनं-दिन कामधंदा करीसन तुमनापुढे देवना सुवार्तानी घोषणा करी.<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />तुमनामा ईश्वास ठेवनारासमा आम्हीन पवित्रतातीन, योग्य अनी निर्दोषतातीन कसं वागनुत यानाबद्दल तुम्हीन साक्षीदार शेतस, अनी देव बी शे. <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />तुमले माहितच शे की, बाप आपला पोऱ्यासले करस तसा आम्हीन तुमनापैकी प्रत्येकले वागाडतस. <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />धीर देत अनं आग्रहपुर्वक ईनंती करीसन सांगी ऱ्हाईंतुत की, जो देव आपला राज्यमा अनी गौरवमा तुमले भागीदार व्हवाकरता बलावस.<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />ह्या कारणमुये आम्हीन बी देवनी निरंतर उपकारस्तुती ह्यामुये करतस की, तुम्हीन आमनापाईन ऐकेल देवनं वचन स्विकारं ते माणससनं नही तर देवनं म्हणीन स्विकार, अनी वास्तविक हाई सत्य शे; ते तुमनामा ईश्वास ठेवणारासमा कार्य करी राहिनं. <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" /><note caller="+" style="x"><char style="xo" closed="false">२:१४ </char><char style="xt" closed="false"><ref loc="ACT 17:5">प्रेषित १७:५</ref></char></note>भाऊसवन अनी बहिणीसवन, यहूदीयामाधल्या देवन्या ज्या मंडळ्या ख्रिस्त येशुमा शेतस त्यासनं तुम्हीनं अनुकरण करनारा व्हयनात, म्हणजे त्यासनी यहुद्यासना हाततीन ज्या छळ भोगात त्याच छळ तुम्हीन पण आपला स्वतःना लोकसकडतीन भोगात; <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" /><note caller="+" style="x"><char style="xo" closed="false">२:१५ </char><char style="xt" closed="false"><ref loc="ACT 9:23">प्रेषित ९:२३</ref>,<ref loc="ACT 9:29">२९</ref>; <ref loc="ACT 13:45">१३:४५</ref>,<ref loc="ACT 13:50">५०</ref>; <ref loc="ACT 14:2">१४:२</ref>,<ref loc="ACT 14:5">५</ref>,<ref loc="ACT 14:19">१९</ref>; <ref loc="ACT 17:5">१७:५</ref>,<ref loc="ACT 17:13">१३</ref>; <ref loc="ACT 18:12">१८:१२</ref></char></note>त्या यहूद्यासनी प्रभु येशुले अनं संदेष्टासले बी मारी टाकं अनी आमना छळ करा; देवले जे आवडस ते त्या करतस नही अनं त्या सर्व माणससना विरोधी व्हयेल शेतस. <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />गैरयहूदीसनं तारण व्हवाले पाहिजे म्हणीन आम्ही त्यासले देवनी सुवार्ता सांगतस; ती सांगाकरता त्या मनाई करतस; हाई यानाकरता की, त्यासनी आपला पापसनं माप कायम भरत ऱ्हावानं; त्यासनावरला क्रोधनी मर्यादा संपेल शे.<verse eid="1TH 2:16" /></para>
  <para style="s">पौलनी मंडळीले परत भेटानी ईच्छा</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />भाऊसवन अनी बहिणीसवन, आम्ही हृदयतीन नही तर शारीरतिन तुमनापाईन थोडा येळ येगळा व्हवामुये आमले वाईट वाटी; आम्हीन तुमनी खुप आठवण करी अनी तुमले परत भेटाकरता भलताच प्रयत्न करात; <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />यामुये आम्हीन तुमनाकडे येवानी ईच्छा धरी; विशेष म्हणजे मी पौलनी एकदाव नही तर बराचदाव येवानी ईच्छा करी; पण सैताननी आमले आडावं. <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />कारण आमनी आशा, आमना आनंद अनी आमना अभिमानना मुकूट काय शे? आपला प्रभु येशु ह्याना येवाना येळले त्याना समोर तुम्हीनच राहशात ना? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />कारण तुम्हीन आमना अभिमान अनी आमना आनंद शेतस.<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="s">तीमथ्यनं भेटनं</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:15">प्रेषित १७:१५</ref>
      </char>
    </note>आमनाकडतीन आखो धीर धराई नही राहिंता, तवय आम्हीन अथेनै शहरमा एकटा ऱ्हावानं हाई आमले बरं वाटनं <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />अनी आम्हीन आपला भाऊ तीमथ्य, ख्रिस्तना सुवार्तामा देवना सेवक, याले यानाकरता धाडं की, त्यानी तुमले स्थिर कराले पाहिजे, अनी तुमना ईश्वास वाढाकरता बोध कराले पाहिजे; <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />तो असा की, ह्या संकटमा कोणी घाबराले नको; कारण हाई संकट देवनी ईच्छातीनच नेमेल शे. हाई तुमले माहित शे. <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />कारण आम्हीन तुमनाजवळ व्हतुत तवय आम्हीन तुमले सांगीन ठेवं की, आपलाले संकट भोगना शेतस; अनी त्यानामायक घडनं बी, हाई तुमले चांगलच माहीत शे. <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />ह्यामुये माले आखो धीर धराई नही राहिंता, म्हणीन मी तुमना ईश्वासबद्दल ईचारपुस कराले तिमथ्यले धाडं; कोणले माहित, सैताननी तुमले फसाडामुये आमना श्रम व्यर्थ व्हयना व्हतीन.<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:६ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:5">प्रेषित १८:५</ref>
      </char>
    </note>आते तीमथ्यनी तुमना कडतीन आमनाकडे ईसन, तुमना ईश्वास अनं प्रिती यासनाबद्दल अनी जश आम्हीन तुमले भेटाले उत्साहीत शेतस तस तुम्हीन पण आमले भेटाले उत्साहीत राहिण आमनी प्रेमतीन नेहमी आठवण करतस यानाबद्दल चांगली बातमी आमले सांगी. <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />यामुये भाऊसवन अनी बहिणीसवन, आमले आपला सर्व अडचणीसमा अनं संकटसमा तुमना ईश्वासवरतीन तुमनाबद्दल प्रोत्साहन मिळणं <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />कारण जर तुम्हीन प्रभुमा स्थिरचित्त राहिनात तर आमना जिवमा जिव येवासारख व्हई. <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />कारण तुमनामुये आम्हीन आपला देवसमोर जो आनंद करी राहिनुत, त्याकरता तुमनाबद्दल त्याना उपकार कसा मानुत? <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />आम्हीन रातनदिन भरपुर प्रार्थना करतस की, आम्हीन तुमले समोरा समोर दखावं अनी तुमना ईश्वासमाधला कमीपणा पुरा कराले पाहिजे.<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />देव, आपला पिता हाऊ स्वतः, अनं आपला प्रभु येशु हाऊ, आमनी तुमनाकडे येवानी वाट मोकळी करो; <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />अनी जशी आमनी प्रिती तुमनावर शे, तशी प्रभु तुमनी प्रिती एकमेकसवर अनं सर्वासवर वाढाईन भरपूर करो; <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />यानाकरता की, आपला प्रभु येशु आपला सर्व पवित्र लोकससंगे ई, त्या येळले त्यानी तुमनं अंतःकरण स्थिर करं म्हणजे देव आपला पिता यासना समोर पवित्रतामा निर्दोष ठराले पाहिजे.<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">परमेश्वरले प्रसन्न करणारं जिवन</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />भाऊसवन अनी बहिणीसवन, शेवट आम्हीन तुमले ईनंती करतस अनं प्रभु येशुमा बोध करतस की, तुम्हीन कसं वागीन देवले खूश करानं, हाई आमनापाईन ऐकी लेयल शे अनी तुम्हीन त्यानामायक वागी राहिनात त्यामा तुमनी वाढ व्हतंच रावाले पाहिजे. <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />कारण प्रभु येशुना अधिकारतीन कोणतं शिक्षण तुमले दिधं ते तुमले माहीतच शे. <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />कारण देवनी ईच्छा हाई शे की, तुमनं पवित्रकरण व्हवाले पाहिजे अनी व्यभिचारपाईन स्वतःले दुर ठेवशात <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />हे माणससवन, तुम्हीन प्रत्येकनी हाई समजीन लेवाले पाहिजे की, आपली पत्नीसंगे कसा पवित्र अनी आदरणीय व्यवहार कराले पाहिजे. <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />अनी हाई काम अभिलाषाघाई नही अनी ज्या देवले वळखतस नही त्यासनामायक बी नही. <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />कोणी ह्या गोष्टी मोडीसन आपला ख्रिस्ती भाऊसना गैरफायदा उचलाना नही; कारण प्रभु ह्या सर्व गोष्टीसबद्दल शासन करनारा शे, हाई आम्हीन तुमले पहिलेच सांगेल व्हतं अनं बजाडेल व्हतं. <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />कारण देवनी आपलाले अनैतीकतामा जगाले नही तर पवित्रताकरता पाचारण करेल शे. <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />म्हणीन जो कोणी हाई शिक्षणले नकारस तो माणुसना नही, तर तुमले आपला पवित्र आत्मा देणारा देवना नकार करस.<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />भाऊसना प्रेमबद्दल आम्हीन तुमले लिखाणं ह्यानी तुमले गरज नही; कारण एकमेकसवर प्रिती करानी, अस तुमले देवनीच शिकाडेल शे; <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />अनी पुरा मासेदोनियामाधला सर्व ईश्वासणारासवर तुम्हीन ती करीच राहिनात, तरी भाऊसवन, आम्हीन तुमले बोध करतस की, ती आखो करा. <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />शांतीतिन जिवन जगा आपलाच कामवर लक्ष राहु द्या अनी आपला उदर निर्वाहकरता काम कर. <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />अईश्वासी लोकससंगे सभ्यतातीन वागानं म्हणजे तुमले सन्मान भेटी, अनी आपला हातसघाई काम करानं, म्हणजे तुमनी जी गरज शे त्याकरता तुमले कोणवर अवलंबीन राव्हानी गरज नही.<verse eid="1TH 4:12" /></para>
  <para style="s">प्रभुनं येनं</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />भाऊसवन, मरेल लोकसबद्दल तुम्हीन अजाण ऱ्हावाले नको अशी आमनी ईच्छा शे, ह्यानाकरता की, ज्यासले आशाच नही असा बाकीना लोकसमायक तुम्हीन दुःखी व्हवाले नको. <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />कारण येशु मरणा अनं परत ऊठना असा जर आपला ईश्वास शे तर तसच येशुमा ईश्वास करनारा ज्या मरेल शेतस त्यासले देव येशुनासंगे लई ई.<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">४:१५ </char>
      <char style="xt" closed="false">
        <ref loc="1CO 15:51">१ करिंथ १५:५१</ref>,<ref loc="1CO 15:52">५२</ref></char>
    </note>जे प्रभुनी शिकाडं तेच आम्हीन तुमले शिकाडतस, प्रभुनं येनं व्हवापर्यंत ज्या आपण जिवत राहसुत त्या आपण मरेलसना पहिले जावावुच नहीत. <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />कारण, आज्ञाध्वनी आद्यदिव्यदूतसनी वाणी अनं देवना तुतारीना नाद व्हत असतांना प्रभु स्वतः स्वर्गामातीन उतरी; अनी ख्रिस्तमा ज्या मरेल शेतस त्या पहिले ऊठतीन; <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />नंतर जिवत उरेल आपण त्यासनासंगे मेघारूढ व्हईन अंतराळमा लेवाई जासुत, अनी आम्हीन कायम परमेश्वरनासंगे राहसुत. <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />म्हणीन ह्या वचनसघाई एकमेकसनं प्रोत्साहन करा.<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">प्रभुना आगमन करता तयार रहा</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />भाऊसवन अनी बहिणीसवन, काळ अनं येळ यानाबद्दल तुमले काही लिखाणी गरज नही. <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" /><note caller="+" style="x"><char style="xo" closed="false">५:२ </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्तय २४:४३</ref>; <ref loc="LUK 12:39">लूक १२:३९</ref>; <ref loc="2PE 3:10">२ पेत्र ३:१०</ref></char></note>कारण तुमले स्वतःले पक्क माहित शे की, जशा रातले चोर येस, तसाच प्रभुना दिन ई. <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />शांती शे, निर्भय शे अस त्या म्हणतस तवय गरोदर बाईले ज्याप्रमाणे अचानक वेदना व्हतस त्याप्रमाणे त्यासना अचानक नाश ई अनी त्या टिकावुच नहीत. <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />भाऊसवन अनी बहिणीसवन, त्या दिननी जसं चोर येस तसं तुमले धराले पाहिजे असा तुम्हीन अंधारमा नही शेतस. <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />कारण तुम्हीन सगळा उजेडनी प्रजा अनी दिनसनी प्रजा शेतस, आपण रातना अनं अंधारना नहीत; <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />यावरतीन आपण दुसरासनामायक झोपाले नको, तर जागं अनी सावध ऱ्हावाले पाहिजे. <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />झोपणारा रातले झोपतस अनी पिणारा रातले पितस; <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" /><note caller="+" style="x"><char style="xo" closed="false">५:८ </char><char style="xt" closed="false"><ref loc="EPH 6:13-17">इफिस ६:१३-१७</ref></char></note>पण ज्या आपण दिनना शेतस त्या आपण सावध ऱ्हावाले पाहिजे. ईश्वास अनी प्रितीनं चिलखत अनी तारणनी आशा, हाऊ टोप घाला. <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />कारण आपलावर देवना क्रोध व्हवाले पाहिजे म्हणीसन नही, तर आपला प्रभु येशु ख्रिस्त ह्यानाद्वारा आपलं तारण व्हवाले पाहिजे म्हणीन आपले नेमेल शे. <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />येशु आपलाकरता मरणा, यानाकरता की, तो ई तवय आपण जिवत राहिनुत किंवा मरेल राहिनुत तरी आपण त्यासनासंगे जिवत ऱ्हावाले पाहिजे. <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />म्हणीन तुम्हीन एकमेकसनं सांत्वन करा अनं एकमेकसनी मदत करा; अस तुम्हीन करीच राहिनात.<verse eid="1TH 5:11" /></para>
  <para style="s">शेवटली सुचना अनी नमस्कार</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />भाऊसवन अनी बहिणीसवन, आम्हीन तुमले ईनंती करतस की, तुमनामा ज्या श्रम करतस, ख्रिस्ती जिवनमा तुमले सुचना देतस अनं तुमले बोध करतस त्यासना तुम्हीन सन्मान कराले पाहिजे. <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />अनी त्यासना काममुये त्यासले प्रेमतीन भरपुर मान देवाना. तुम्हीन आपसमा शांतीतीन रहा.<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />भाऊसवन, तुमले बोध करस की, आळशी लोकसले ताकिद द्या, ज्या कमीधीरना शेतस त्यासले धीर द्या, अशक्तसले आधार द्या, सर्वाससंगे सहनशीलतातीन वागा. <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />हाई ध्यानमा ठेवा की, कोणी कोण वाईटबद्दल वाईट करानं नही म्हणीन जपीन रहा, अनी कायम एकमेकसनं अनं सर्वासनं चांगलं करत रहा<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />कायम आनंदमा रहा;<verse eid="1TH 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 5:17" />कायम प्रार्थना करा;<verse eid="1TH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TH 5:18" />सर्व स्थितीमा उपकारस्मरण करा; कारण तुमना जिवनबद्दल ख्रिस्त येशुमा देवनी ईच्छा हाईच शे.<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />पवित्र आत्माले विझाडु नका; <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />परमेश्वर कडतीन येणारा संदेशना धिक्कार करू नका; <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />सर्व गोष्टीसनी पारख करा; चांगलं ते धरा;<verse eid="1TH 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1TH 5:22" />वाईटना प्रत्येक प्रकारपाईन दुर रहा.<verse eid="1TH 5:22" /></para>
  <para style="s">आशिर्वाद</para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />शांतीना देव स्वतः तुमले परिपूर्णतातीन पवित्र करो; अनी आपला प्रभु येशु ख्रिस्त ह्याना येवाना येळले तुमना आत्मा, जीव अनं शरीर ह्या निर्दोष असा राखाले पाहिजे <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />तुमले पाचारण करनारा ईश्वसनीय शे; तो हाई करीच.<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />भाऊसवनं अनी बहिणीसवन आमनाकरता प्रार्थना करा.<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />सर्व ईश्वासणारासले परमेश्वरना प्रेममा शांतीतीन नमस्कार करा<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />मी तुमले प्रभुना अधिकारतीन ईनंती करीसन सांगस की, हाई पत्र सर्व ईश्वासु भाऊसले वाचीन दखाडामा येवो.<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />आपला प्रभु येशु ख्रिस्त यानी कृपा तुमनासंगे ऱ्हावो.<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>