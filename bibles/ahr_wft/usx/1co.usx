<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Ahirani</book>
  <para style="h">१ करिंथ</para>
  <para style="toc3">१ करिंथ</para>
  <para style="toc2">१ करिंथ</para>
  <para style="toc1">पौलनी लिखेल करिंथकरसले पहिलं पत्र</para>
  <para style="mt2">पौलाने लिहलेले करिंथकरास पहिले पत्र</para>
  <para style="mt1">पौलनी लिखेल करिंथकरसले पहिलं पत्र</para>
  <para style="imt">वळख</para>
  <para style="ip">हाई पत्र प्रेषित पौल यानी येशु ख्रिस्तना जन्मनंतर ५५ सालमा लिखं<char style="xt"><ref loc="1CO 1:1">१:१</ref></char> पौलनी करिंथकर मंडळीले ज्या दोन पत्र लिखात त्यानापैकी हाई पहिलं पुस्तक. मासेदोनिया प्रांतकडे जातांना अनं परत येतांना जी भेट त्यानी ठरायेल व्हती त्याना पहिले इफिस शहरमा असतांना त्यानी हाई पत्र लिखेल व्हई<char style="xt"><ref loc="1CO 16:5-9">१६:५-९</ref></char>पौलले करिंथ मंडळीमा चालणारा चुकीन्या चालीरीतीसबद्दल, गटबाजी, व्यभिचार, जारकर्म याबद्दलना अहवाल भेटेल व्हता त्याले उत्तर म्हणीसन त्यानी हाई पत्र लिखं. हाई शहर व्यभिचारकरता प्रसिध्द व्हतं म्हणीसन हाई स्वभावीक व्हतं की हाई समस्या तठला मंडळीमा बी घुसन्यात, करिंथकरसले पहिला पत्रमा एक प्रसिध्द अध्याय जो प्रितीवर आधारीत शे. <char style="xt"><ref loc="1CO 13">१३</ref></char></para>
  <para style="iot">रूपरेषा</para>
  <para style="io1">१. पौलनी करिंथकरसले शुभेच्छा अनी त्यानाकरता देवना आभार. <char style="ior"><ref loc="1CO 1:1-9">१:१-९</ref></char></para>
  <para style="io1">२. पौलनी जो अहवाल करिंथना मंडळीसबद्दल ऐका, त्यानं उत्तर. <char style="ior"><ref loc="1CO 1:10">१:१०</ref>; <ref loc="1CO 4:21">४:२१</ref></char></para>
  <para style="io1">३. लैंगिक अनैतीकतानी अडचण अनी एकमेकसले न्यायालयमा खेचनं याबद्दल तो चर्चा करतो. <char style="ior"><ref loc="1CO 5-6">५–६</ref></char></para>
  <para style="io1">४. लगीननी अडचण अनी मुर्तिना नैवेद्य, एकत्र आराधना, आत्माना दानं, पुनरूत्थान यानाद्दल सुचना. <char style="ior"><ref loc="1CO 7-15">७–१५</ref></char></para>
  <para style="io1">५. काही व्यवहारीक अनी वैयक्तीक गोष्टीसले पौलनं उत्तर अनी पत्रना शेवट. <char style="ior"><ref loc="1CO 16">१६</ref></char></para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />देवनी ईच्छातीन येशु ख्रिस्तना प्रेषित व्हवाकरता बलायेल मी पौल अनं आपला भाऊ सोस्थनेस यांच्याकडून,<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:२ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:1">प्रेषित १८:१</ref>
      </char>
    </note>करिंथ गावमाधला देवनी मंडळीले, म्हणजे ख्रिस्त येशुमा पवित्र करेल अनं पवित्र व्हवाकरता बलायेल एकत्र लोकसले अनी आपला प्रभु येशु ख्रिस्त, म्हणजे त्यासना अनं आपला बी प्रभु, यानं नाव सर्व जागावर लेणारा सर्वासले;<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />देव आपला अनं त्यासना पिता प्रभु येशु यापाईन तुमले कृपा अनं शांती असो.<verse eid="1CO 1:3" /></para>
  <para style="s">येशुमा एकत्र व्हवामुये आशिर्वाद</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />ख्रिस्त येशुमा तुमनावर व्हयेल देवना अनुग्रहमूये मी कायम तुमनाबद्दल आपला देवनं उपकारस्मरण करस. <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />यामुये की तुम्हीन येशु ख्रिस्तमा एकत्र व्हवामुये प्रत्येक गोष्टीसमा म्हणजे सर्वकाही बोलामा अनी सर्व ज्ञानमा संपन्न व्हयनात; <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />जसं की ख्रिस्तबद्दलना संदेश तुमनामा भक्कम व्हयना. <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />अस की, आपला प्रभु येशु ख्रिस्त यानी प्रकट व्हवानी वाट दखणारा तुम्हीन कोणता बी कृपादानमा कमी पडवुत नही. <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />तो तुमले शेवटपावत भक्कम करी ठी; यामुये की आपला प्रभु येशुना परत येवाना दिनले तुम्हीन निर्दोष ठरशात. <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />तो देव ईश्वसनीय शे. ज्यानी तुमले त्याना पुत्र म्हणजे आमना प्रभु येशु ख्रिस्तना सहभागीतामा बलावं.<verse eid="1CO 1:9" /></para>
  <para style="s">ख्रिस्ती मंडळीसमा फुट</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />भाऊ बहिणीसवन, आपला प्रभु येशु ख्रिस्त याना नावतीन मी तुमले ईनंती करस की, तुम्हीन सर्वासनी सारखंच बोलाले पाहिजे, म्हणजे तुमनामा फुट पडाले नको, पण तुम्हीन एक मन अनी एकच ईचारतीन ऱ्हावाले पाहिजे. <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />भाऊ बहिणीसवन, तुमनामा भांडणं शेतस अस माले खिया परिवार कडतीन माहीत पडेल शे. <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" /><note caller="+" style="x"><char style="xo" closed="false">१:१२ </char><char style="xt" closed="false"><ref loc="ACT 18:24">प्रेषित १८:२४</ref></char></note>मनं सांगनं अस शे की; तुमनामाधला प्रत्येकजण म्हणस, “मी पौलना, मी अपुल्लोसना, मी केफाना अनी मी ख्रिस्तना शिष्य शे.” <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />ख्रिस्तना असा भाग पडेल शेतस का? पौलले तुमनाकरता क्रुसखांबवर खिळेल व्हतं का? पौलना नावतीन तुमना बाप्तिस्मा व्हयना का?<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१:१४ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:8">प्रेषित १८:८</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">प्रेषित १९:२९</ref>; <ref loc="ROM 16:23">रोम १६:२३</ref></char>
    </note>क्रिस्प अनं गायस यासना शिवाय मी तुमना मातीन कोणाच बाप्तिस्मा करा नही, <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />हाई यानाकरता व्हयनं की तुमना बाप्तिस्मा मना नावमा व्हयना अस कोणी म्हणाले नको. <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" /><note caller="+" style="x"><char style="xo" closed="false">१:१६ </char><char style="xt" closed="false"><ref loc="1CO 16:15">१ करिंथ १६:१५</ref></char></note>अनी हो, मी स्तेफनना घरनासना बी बाप्तिस्मा करा; त्यासनाशिवाय मी दुसरासना बाप्तिस्मा करा की नही हाई मना ध्यानमा नही. <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />ख्रिस्तनी माले बाप्तिस्मा कराले नही, तर सुवार्ता सांगाले धाडेल शे, पण ख्रिस्तना क्रुसखांबवरलं मरण अनी त्यानं सामर्थ्य वाया जावाले नको म्हणीसन ती मनुष्यनी बुध्दीनी भाषामा सांगाले नही धाडं.<verse eid="1CO 1:17" /></para>
  <para style="s">ख्रिस्तनं ज्ञान अनी सामर्थ्य</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />कारण ज्यासना नाश व्हणार शे त्यासनं क्रुसखांबबद्दल शिक्षण मुर्खपण शे; पण ज्यासले तारण प्राप्त व्हई राहीना असा आपलासले ते देवनं सामर्थ्य शे. <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />“मी ज्ञानीसनं ज्ञान नष्ट करसु अनं बुध्दिवानसनी बुध्दी व्यर्थ करसु, असा शास्त्रलेख शे.” <verse eid="1CO 1:19" /><verse number="20" style="v" sid="1CO 1:20" />या युगना, ज्ञानी, शास्त्री, वाद करनारा कोठे शेतस? देवनी जगनं ज्ञान मुर्खपणनं ठरायं की नही?<verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />कारण जग देवना ज्ञानतीन वेढायेल शे तरी या जगनी आपला ज्ञानतीन देवले वळखं नही, तवय देवले हाई चांगलं वाटनं की हाई वार्ताना प्रचारना मुर्खपणतीन ईश्वास ठेवणारा लोकसना उध्दार कराना. <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />कारण यहूदी चिन्ह चमत्कार मांगतस अनी हेल्लेणी ज्ञानना शोध करतस. <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />आम्हीन क्रुसखांबवर खियेल ख्रिस्तले गाजाडतस; हाऊ यहूदी लोकसले अडखळण अनी गैरयहूदी लोकसकरता मुर्खपण शे. <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />पण ज्यासले देवनी बलायेल शे, त्या दोन्ही यहूदी अनं गैरयहूदी ख्रिस्त प्रभुनं सामर्थ्य अनं परमेश्वरनं ज्ञान शे. <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />कारण देवना मुर्खपणा मनुष्यसना ज्ञानपेक्षा जास्त ज्ञानवान शे, अनी देवना अशक्तपणा मनुष्यसना शक्तीतीन जास्त शक्तीशाली शे.<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />हे बंधुसवन, तुमले बलायेल शे यानावर ईचार करा, मनुष्यना दृष्टीतीन तुमनामातिन कोणी जास्त बुध्दिमान नही, कोणी जास्त शक्तीशाली नही अनी कोणी मोठा खानदानना नही. <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />तरी ज्ञानीसले लाजाडाकरता ज्यासले जगनी मुर्ख समजा देवनी त्यासले निवाडं अनी शक्तीशालीसले लाजाडाकरता देवनी दुबळासले निवाडं; <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />अनी देवनी असा गोष्टीसले निवड्यात ज्या संसारनी दृष्टीमा काहीच कामना नहीत, धिक्कारेल असासले देवनी यानाकरता निवाडं की ज्या गोष्टी संसारनी दृष्टीमा महत्त्वन्या गोष्टी शेतस त्यासले नष्ट करानं. <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />म्हणीसन देवनी अस करं की, कोणताच प्राणी देवना समोर गर्व कराले नको. <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />पण देवनी आमले येशुमा एकत्र करेल शे, देवनी येशु ख्रिस्तले आमनं ज्ञान बनाडं, आम्हीन त्यानाद्वारा देवसमोर न्यायी ठरनुत, पवित्र, स्वतंत्र बनाडं, <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />यानाकरता की, “जो गर्व करस त्यानी तो प्रभुबद्दल कराले पाहिजे असा शास्त्रलेख शे.”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">क्रुसखांबवर मरेल येशुना संदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />भाऊ बहिणीसवन, मी तुमनाकडे वनु तो बोलानं चातुर्य अनी ज्ञानतीन श्रेष्ठ शे म्हणीसन देवनं रहस्यमय सत्य तुमले सांगत वनु अस नही. <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />कारण मी हाई ठरायेल व्हतं की, तुमना क्रुसखांबवर खिळेल येशु ख्रिस्त अनी त्याना मृत्युशिवाय दुसरी कोणतीच गोष्ट करानी नही. <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" /><note caller="+" style="x"><char style="xo" closed="false">२:३ </char><char style="xt" closed="false"><ref loc="ACT 18:9">प्रेषित १८:९</ref></char></note>जवय मी तुमनाकडे वनु तवय अशक्त अनी घाबरेल व्हतु, <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />मना संदेश अनं मना प्रचार ज्ञानतीन भरेल शब्दसना नव्हता तर देवआत्माना सामर्थ्यनं पुरावा व्हता. <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />याकरता की, तुमना ईश्वास मनुष्यना ज्ञानवर नही परमेश्वरना सामर्थ्यवर ऱ्हावाले पाहिजे.<verse eid="1CO 2:5" /></para>
  <para style="s">देवनं राज्य</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />ज्या आत्मामा समजदार शेतस त्यासनामा आम्हीन ज्ञान सांगतस; पण ते ज्ञान हाई युगनं नही शे अनी त्या अधिकारीसना सामर्थ्य बी ह्या युगमा संपतीन. <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />पण आम्हीन देवना त्या राज्यनं गुप्तज्ञान सांगतस, जे गुप्त व्हतं, ते देवनी जग निर्माण व्हवाना पहिले आपला गौरवकरता निवाडं. <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />ते हाई युगना अधिकारीसमा कोणलेच समजस नही; त्यासले समजत तर त्या गौरवना प्रभुले क्रुसखांबवर नही खिळतात. <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />हाई तर या शास्त्रलेखप्रमाणे शे; “डोळसघाई दखं नही, कानतीन ऐकं नही, अनं माणससना मनमा वनं नही, त्यासले देवनी आपलावर प्रेमसकरता तयार करेल शे.” <verse eid="1CO 2:9" /><verse number="10" style="v" sid="1CO 2:10" />पण देवनी त्यासले स्वतःना आत्मातीन आपलावर प्रकट करं, कारण आत्मा हाऊ सर्व गोष्टीसना अनी देवना मनुष्यसमा रहस्यना शोधक शे. <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />मनुष्यना आत्मा जो मनुष्यमा ऱ्हास, त्यानाशिवाय मनुष्यमाधल्या गोष्टी कोण वळखस? तसच देवन्या गोष्टी देवना आत्माशिवाय कोणीच वळखत नही. <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />आपलाले जगना आत्मा नही, तर देवपाईन जो आत्मा शे, तो मिळना याकरता की, जे देवनी आपलाले कृपातीन देयल शे ते आपण वळखाले पाहिजे.<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />तर आम्हीन मनुष्यना ज्ञानतीन शिकाडेल शब्दसनी नही तर देवना आत्मातीन शिकाडेल शब्दसनी, आत्माना गोष्टी ज्यासले आत्मा शे त्यासले सांगतस. <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />जो माणुस देवना आत्मान्या गोष्टी स्विकारस नही, कारण त्या त्याले मुर्खपणन्या वाटतस; अनी त्यासले त्या वळखता येतस नही कारण त्यासनी पारख आत्माघाई व्हस. <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />जो आत्मिक शे तो सर्व गोष्टी पारखस, तरी त्यानी स्वतःनी पारख कोणाकडतीनच व्हत नही. <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />जसं शास्त्रलेख सांगस, “प्रभुनं मन अस कोणी वळखेल शे की त्यानी त्याले शिकाडावं?” आपलाले ख्रिस्तनं मन शे.<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">देवना सेवक</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />भाऊ बहिणीसवन, ज्यासले परमेश्वरना आत्मा शे त्या लोकससंगे बोलानं तसं तुमनासंगे मनाघाई बोलायनं नही, तर जसं जगीक लोकससंगे अनी त्यासनासंगे ज्या ख्रिस्तमा बालक शेतस. <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" /><note caller="+" style="x"><char style="xo" closed="false">३:२ </char><char style="xt" closed="false"><ref loc="HEB 5:12">इब्री ५:१२</ref>,<ref loc="HEB 5:13">१३</ref></char></note>मी तुमले दुध पाजं, जेवण दिधं नही; कारण त्या येळले तुमनामा शक्ती नव्हती, अनी अजुन बी नही; <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />कारण तुम्हीन अजुन जगीक लोकसमायक शेतस; तुमनामा हेवा अनं भांडणं शेतस, यावरतीन तुम्हीन जगीक लोकसमायक शेतस का नही? अनी तुम्हीन मनुष्यसना पध्दतघाई चालतस की नही? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" /><note caller="+" style="x"><char style="xo" closed="false">३:४ </char><char style="xt" closed="false"><ref loc="1CO 1:12">१ करिंथ १:१२</ref></char></note>कारण एक सांगस मी पौलना शे; अनी दुसरा सांगस, मी अपुल्लोसना शे; मंग तुम्हीन अस करीसन जगीक लोकसमायक जगी नही राहिनात का?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />अपुल्लोस कोण शे? अनी पौल कोण शे? ज्यासनाद्वारे तुम्हीन ईश्वास ठेवा. असा सेवक शेतस; जसं प्रत्येकले प्रभुनी कराले काम देयल शे तस प्रत्येकनी काम कराले पाहिजे; <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" /><note caller="+" style="x"><char style="xo" closed="false">३:६ </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">प्रेषित १८:४-११</ref>; </char><char style="xt" closed="false"><ref loc="ACT 18:24-28">प्रेषित १८:२४-२८</ref></char></note>मी लायं, अपुल्लोसनी पाणी टाकं, पण देवनी वाढायं. <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />यामुये लावणारा काही नही अनी पाणी टाकणारा पण काही नही; पण वाढवणारा देवच सर्वकाही शे. <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />लावणारा अनी पाणी टाकणारा एकच शे, तरी प्रत्येकले देव आपआपला कष्टप्रमाणे मजुरी दि. <verse eid="1CO 3:8" /><verse number="9" style="v" sid="1CO 3:9" />कारण आम्हीन देवना सोबती शेतस. तुम्हीन देवनं वावर, देवनी इमारत शेतस. <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />मनावर व्हयेल देवनं अनुग्रहना मानतीन मी चतुर कारागीरनामायक पाया घाला अनी दुसरा त्यानावर बांधस; तर प्रत्येकनी आपण त्यानावर कसं बांधी राहीनुत यानाबद्दल जपानं. <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />बांधेल पाया येशु ख्रिस्त शे तठे कोणी दुसरा पाया नही घालु शकस. <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />काहीजण हाऊ पाया सोनं, चांदि, महागडा दगड, लाकुड, गवत, पेंढा यासनी बांधतस. <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />तर बांधणारा प्रत्येकनं काम न्यायना दिनले उघड व्हई; तो आगसंगे प्रकट व्हई अनी प्रत्येकनं काम कसं शे यानी परिक्षा आगच करी. <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />ज्यानं कोणं त्यानावर बांधेल काम टिकी त्याले मजुरी मिळी. <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />ज्यानं कोणं काम जळी जाई त्याना तोटा व्हई, पण तो वाची जाई जसं काय आगमातीन बाहेर पडेल मायक.<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१६ </char>
      <char style="xt" closed="false">
        <ref loc="1CO 6:19">१ करिंथ ६:१९</ref>; <ref loc="2CO 6:16">२ करिंथ ६:१६</ref></char>
    </note>तुम्हीन देवनं मंदिर शेतस, अनी तुमनामा देवना आत्मा ऱ्हास हाई तुमले माहीत नही का? <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />जर कोणी देवना मंदिरना नाश करी तर देव त्याना नाश करी. कारण देवनं मंदिर पवित्र ऱ्हास तसा तुम्हीन पवित्र शेतस.<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />कोणी स्वतःले फसाडाले नको, जर तुमना मातीन कोणी ह्या युगमा स्वतःले हुशार समजस तर त्यानी हुशार बनाकरता मुर्ख बनाणं. <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />कारण या जगनं ज्ञान देवसमोर मुर्खपण शे; “देव ज्ञानीसले त्यासनाच धुर्तपणमा धरस” असा शास्त्रलेख शे; <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />अनी “प्रभु ज्ञानीसना ईचारसले असा वळखस की, त्या व्यर्थ शेतस,” आखो शास्त्रलेखमा अस बी म्हणस. <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />यामुये मनुष्यसवर कोणी गर्व कराले नको, सर्वकाही तुमनं शे; <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />पौल, अपुल्लोस, केफा, जग, जिवन, मरण, वर्तमान, भविष्य, हाई सर्व तुमनं शे. <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />तुम्हीन ख्रिस्तना; अनी ख्रिस्त देवना.<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">ख्रिस्तना प्रेषित</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />आम्हीन ख्रिस्तना सेवक अनी देवना रहस्यना कारभारी शेतस अस तुम्हीन आमले मानानं. <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />आखो एक गोष्टनी गरज शे ती म्हणजे कारभारी म्हणं तर तो ईश्वासु राहवाले पाहिजे. <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />तर तुमना कडतीन किंवा मानवी न्यायालयकडतीन मना न्यायनिवाडा व्हस, तरी यानं बी माले काही वाटस नही, मी स्वतःना बी न्यायनिवाडा करस नही. <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />कारण मनं मन जरी मना विरोधमा साक्ष देस नही, पण त्यावरतीन मी निर्दोष ठरस अस नही; मना न्यायनिवाडा करनारा प्रभु शे. <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />याकरता त्या येळना पहिले म्हणजे प्रभुना येवाना पहिले तुम्हीन न्यायनवाडा करूच नका; तो अंधारमाधल्या गुप्त गोष्टी प्रकाशमा लई, अनी अंतःकरणमाधला ईचार बी उघड करी; तवय प्रत्येक माणुसनी वाहवाह प्रभुकडतीन व्हई.<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />भाऊसवन, मीनी या गोष्टीसनं वर्णन तुमनाकरता दृष्टांतना रूपमा माले अनी अपुल्लोसले लाई लेयल शेतस; यानाकरता की शास्त्रलेखपलीकडे कोणी जावाले नको हाऊ नियम आमनावरतीन तुम्हीन शिकाले पाहिजे; म्हणजे तुमनापैकी कोणीच एकमेकवर फुगावु नही. <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />तुले कोण दुसरासपेक्षा श्रेष्ठ समजस? अनी जे तुले देयल नही अस तुनाजोडे काय शे? तुले देयल शे तरी देयल नही अस गर्व करीसन का बरं सांगत फिरस. <verse eid="1CO 4:7" /><verse number="8" style="v" sid="1CO 4:8" />इतलामा तुम्हीन तृप्त व्हई जायेल शेतस, इतलामा तुम्हीन धनवान व्हई जायेल शेतस, आमले सोडीन तुम्हीन तर राजा बनी जायेल शेतस; तुम्हीन राजा बनी जातात तर बरं व्हतं कारण आमले बी तुमनासंगे राजपद भेटी जातं. <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />कारण माले वाटस, देवनी आम्हीन प्रेषितसले शेवटली जागाना अनी मरणकरता नेमेल अस पुढे करी ठेयल शे, कारण आम्हीन जगले म्हणजे देवदूतसले अनी मनुष्यसले खेळ असा व्हयेल शेतस. <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />आम्हीन ख्रिस्तमुये मुर्ख, तुम्हीन ख्रिस्तमा हुशार; आम्हीन अशक्त शेतस अनी तुम्हीन ताकदवान; तुम्हीन प्रतिष्ठीत शेतस, अनी आमले मानपान भेटत नही. <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />ह्या येळपावत आम्हीन अशक्त, भूका तिशा अनं उघडा शेतस; आम्हीन मार खातस अनी आमले घरदार नही; <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" /><note caller="+" style="x"><char style="xo" closed="false">४:१२ </char><char style="xt" closed="false"><ref loc="ACT 18:3">प्रेषित १८:३</ref></char></note>आम्हीन आमना हातघाई कष्ट करतस, जवय आमनी निंदा व्हस तवय आम्हीन आशिर्वाद देतस, जवय आमले त्रास देतस तवय आम्हीन सहन करतस. <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />जवय आमनी बदनामी व्हस तवय आम्हीन समजाडाना प्रयत्न करतस. आम्हीन जगना गाळ, सर्व प्रकारना कचरा बनेल शेतस.<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />तुमले लाज वाटाले पाहिजे म्हणीन मी हाई नही लिखी राहीनु तर मना प्रिय पोऱ्यासप्रमाणे तुमले सुचना देवाकरता लिखी राहीनु. <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />तरी तुमले ख्रिस्तमा दहा हजार गुरू राहीनात पण जास्त बाप नही; <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" /><note caller="+" style="x"><char style="xo" closed="false">४:१६ </char><char style="xt" closed="false"><ref loc="1CO 11:1">१ करिंथ ११:१</ref>; <ref loc="PHP 3:17">फिलप्पै ३:१७</ref></char></note>यामुये मी तुमले ईनंती करस की, मनं अनुकरण करनारा बना. <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />या कारणमुये प्रभुमा मना प्रिय अनं ईश्वासु पोऱ्या तीमथ्य याले मी तुमनाकडे धाडेल शे; तो तुमले मना शिक्षणपध्दतीनी आठवण करी दि, जसं मी सर्व ठिकाणवर, प्रत्येक मंडळीमा शिकाडस.<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />मी तुमनाकडे येस नही म्हणीन बराच जण फुगेल शेतस. <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />तरी प्रभुनी ईच्छा व्हई तर मी तुमनाकडे लवकरच येसु; तवय फुगेल काय बोलतस त्यानाकडे नही तर त्यासना सामर्थ्यकडे दखसु. <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />कारण देवनं राज्य बोलामा नही, तर सामर्थ्यमा शे. <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />तुम्हले काय पाहिजे? मी तुमनाकडे काठी लिसन येऊ का प्रेमतीन अनं नम्रताना आत्मातीन येऊ?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">मंडळीमा अनैतीकता</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />अस ऐकामा येल शे की, प्रत्येक्ष तुमनामा व्यभिचार चालु शे अनी असा व्यभिचार जो गैरयहूदी लोकसमा बी नही ऱ्हास म्हणजे तुमनापैकी एक माणुसनी आपला बापनी बायकोले ठेयल शे. <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />तरी तुम्हीन फुगीसन बठेल शेतस; त्यानापेक्षा हाई कर्म करनारा माणुस आपलामातीन कायमना निंघी गया अस म्हणीसन शोक करत बठाले पाहिजे. <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />मी शरीरतिन नही पण आत्मातीन तुमनामा उपस्थित शे. अनी अस समजा मी उपस्थित राहीन अस घाण काम करनारा व्यक्ती विरूध्द निर्णय दि टाकेल शे. <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />जवय तुम्हीन आपला प्रभु येशुना नावतीन एकत्र व्हशात अनी आत्मामा बी मी तुमनासंगे राहसु, तर आपला प्रभु येशुना सामर्थ्यतीन <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />असा मनुष्यले शरिरना नाशकरता सैतानले सोपी देवाले पाहिजे, याकरता की, त्याना आत्मा प्रभु येशुना दिनसमा उध्दार पावाले पाहिजे.<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:६ </char>
      <char style="xt" closed="false">
        <ref loc="GAL 5:9">गलती ५:९</ref>
      </char>
    </note>हाई तुमनं बढाई करनं शोभस नही, थोडसं खमीर पुरा गोळाले फुगाडस, हाई तुमले माहीत नही का? <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />म्हणीसन जुनं खमीर काढी टाका, यानाकरता की तुम्हीन जसं बेखमीर लोके शेतस तसं तुम्हीन नवा गोळा व्हई जावानं, कारण आपला वल्हांडणना यज्ञपशु जो ख्रिस्त त्यानं अर्पण व्हई जायेल शे. <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />यामुये जुना खमीरपाईन तसच वाईटपणा अनं दुष्तपणा यासना खमीरतीन नही तर सात्विकपणा अनं खरंपण हया भाकरीसघाई आपण सण साजरा कराले पाहिजे.<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />तुम्हीन व्यभिचारीसनी संगत धरू नका अस मी तुमले आपला पत्रमा लिखेल व्हतं. <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />या जगना व्यभिचारी, लोभी, लुटारू अनं मुर्तिपुजक यासनी संगत धरू नका अस मी नही सांगस; कारण ती संगत धरी नही तर तुमले जगमातीन जानं पडी. <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />तर तुमले जे लिखेल व्हतं त्याना अर्थ असा की, भाऊ मानेल असा कोणी व्यभिचारी, लोभी, मुर्तिपुजक, गाळ्या देणारा, दारूड्या, किंवा लुटारू व्हई तर असासनी संगत धरानी; त्यासना पंगतमा बसानं नही.<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />कारण बाहेरनासना न्याय कराशी मना संबंध? काय तुमले त्यासना न्याय नही कराना का ज्या मझार शेतस. <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />बाहेरसना न्याय तर परमेश्वर करस, पण तुम्हीन असा दुष्टसले आपलामातीन बाहेर काढा.<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">ख्रिस्ती लोकसना न्यायालयमा जायेल भांडणं</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />जर तुमनामा भांडणं व्हतस तर तुमनामा कोणी असा शे का? जो आपलं भांडण अधार्मिकसकडे सोडावनी हिम्मत करस. <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />पवित्र लोक जगना न्यायनिवाडा करतीन हाई तुमले माहीत नही का? अनी जर तुमना कडतीन जगना न्याय व्हई तर काय तुम्हीन ह्या धाकला धाकला भांडणं सोडावाना योग्य नही शेतस का? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />आपण देवदूतसना न्यायनिवाडा करू हाई तुमले माहीत नही का? तर मंग आपण या जगना न्याय कराले योग्य नही का? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />तुमले व्यवहारीक खटलासना न्यायनिवाडा करना शे, तर मंडळीमा ज्यासनी किमंत्तच नही त्यासले कसाले नेमतस. <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />तुमले लाज वाटाले पाहिजे म्हणीन सांगी राहीनु, काय तुमनामा एक पण शहाणा माणुस नही, जो आपला भाऊसंगे भांडण सोडाऊ शकस. <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />भाऊ भाऊवर खटला चालाडस अनं तो बी अईश्वासी लोकससमोर.<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />तुम्हीन एकमेकसवर खटला चालडतस यानामा तुमनं नुकसानच शे; त्यानापेक्षा तुम्हीन अन्याय का बर सहन करतस नही? त्यानापेक्षा तुम्हीन लुबाडणूक का बर सहन करतस? <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />उलट तुम्हीन अन्याय अनी लुबाडणूक करतस, ती बी आपला भाऊससंगे. <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />अनितीघाई चालणारा माणुसले देवनं राज्यमा जागा मिळावं नही शे, हाई तुमले माहीत नही का? फसु नका; जारकर्मी, मुर्तिपुजक, व्यभिचारी, चैनबाज, समलींगी संबध ठेवणारा, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />चोर, लोभी, दारूड्या, चुगलीचहाडी करनारा अनं व्यवहारमा घोटाया करनारा, यासले देवना राज्यमा जागा मिळावं नही. <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />अनी तुमनापैकी कितला तसाच व्हतात; तरी तुम्हीन प्रभु येशु ख्रिस्तना नावमा अनं आपला देवना आत्मामा धोयेल, पवित्र करेल, अनं नीतिमान ठरायेल, असा व्हयेल शेतस.<verse eid="1CO 6:11" /></para>
  <para style="s">देवना गौरवकरता शरिरना वापर करा</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">६:१२ </char>
      <char style="xt" closed="false">
        <ref loc="1CO 10:23">१ करिंथ १०:२३</ref>
      </char>
    </note>सर्व गोष्टीसनी माले सुट शे, तरी सर्वा गोष्टी कामना नहीत; सर्व गोष्टीसनी माले सुट शे, तरी मी कोणतीच गोष्टना अधीन ऱ्हावाव नही. <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />अन्न पोटकरता अनं पोट अन्नकरता शे; त्या दोन्हीसना देव अंत करी, शरीर व्यभिचारकरता नही, तर प्रभुसाठी शे; अनी शरीरकरता प्रभु शे. <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />देवनी प्रभुले ऊठाडेल शे, अनी तो त्याना सामर्थ्यतीन आपले ऊठाडी.<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />तुमना शरीर ख्रिस्तना अवयव शेतस, हे तुमले माहीत नही का? मी ख्रिस्तना अवयव लिसन वेश्यानं शरीर बनाडु? कधीच नही. <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />ज्याना वेश्यासंगे संबध वना तो अनी ती ह्या एक शरीर शेतस, हाई तुमले माहीत नही का? कारण त्या “दोन्ही एकदेह व्हतीन” अस तो म्हणस. <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />जो प्रभुना संगतमा येस तो अनं प्रभु एक आत्मा शेतस.<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />व्यभिचारपाईन दुर रहा, ज्या दुसरा पापे मनुष्य करस, त्या शरीर बाहेरतीन व्हतस; पण जो व्यभिचार करस तो आपला शरिरबद्दल पाप करस. <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" /><note caller="+" style="x"><char style="xo" closed="false">६:१९ </char><char style="xt" closed="false"><ref loc="1CO 3:16">१ करिंथ ३:१६</ref>; <ref loc="2CO 6:16">२ करिंथ ६:१६</ref></char></note>काय तुमले माहीत नही का, तुमना मातीन प्रत्येकनं शरीर पवित्र आत्मानं मंदिर शे, जो तुमनामा शे अनी जो तुमले परमेश्वर कडतीन भेटेल शे, अनं तुम्हीन स्वतःना नही शेतस का? <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />कारण तुमले किंमत दिसन ईकत लेयल शे; यामुये तुम्हीन आपला शरीरतिन देवनं गौरव करा.<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">लगीनबद्दल प्रश्न</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />आते त्या गोष्टीसबद्दल ज्या तुम्हीन माले लिखेल शेतस. माणुसनी बाईले हात लावाले नको हाई त्यानाकरता चांगलं शे. <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />व्यभिचार व्हई राहीनात म्हणीन प्रत्येक माणुसले स्वतःनी बायको अनी प्रत्येक बाईले स्वतःना नवरा ऱ्हावाले पाहिजे. <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />नवरानी बायकोले तिना हक्क देवाले पाहिजे; अनी त्याप्रमाणे बायकोने बी नवराले हक्क देवाले पाहिजे. <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />बायकोले स्वतःना शरिरवर अधिकार नही तर नवराले शे; अनी त्याप्रमाणे नवराले बी स्वतःना शरिरवर अधिकार नही तर बायकोले शे. <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />एकमेकससंगे दगाबाजी करू नका, तरी प्रार्थनाकरता येळ मिळाले पाहिजे म्हणीसन ती येळ एकमतघाई ठरावा, मंग फिरीसन एकत्र व्हा, यानाकरता की सैतान तुमना असंयममुये तुमले परिक्षामा पाडाले नको. <verse eid="1CO 7:5" /><verse number="6" style="v" sid="1CO 7:6" />तरी मी हाई परवानगी दिसन सांगी राहीनु आज्ञा दिसन नही. <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />मी जसं शे तस सर्वासनी ऱ्हावाले पाहिजे अशी मनी ईच्छा शे; तरी प्रत्येकले ज्यानं त्यानं कृपादान देवपाईन मिळेल शे, एकले एक प्रकारनं अनं दुसराले दुसरा प्रकारनं. <verse eid="1CO 7:7" /><verse number="8" style="v" sid="1CO 7:8" />ज्या बिन लगीन व्हयेल शेतस अनं ज्या विधवा शेतस त्यासले मी सांगस, की, तुम्हीन मनामायक राहीनात तर ते तुमनासाठे चांगलं शे; <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />पण ज्यासले धीर नही त्यासनी लगीन कराले पाहिजे, कारण जळापेक्षा लगीन करेल बरं.<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">७:१० </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:32">मत्तय ५:३२</ref>; <ref loc="MAT 19:9">१९:९</ref>; <ref loc="MRK 10:11">मार्क १०:११</ref>,<ref loc="MRK 10:12">१२</ref>; <ref loc="LUK 16:18">लूक १६:१८</ref></char>
    </note>लगीन व्हयेलसले मी आज्ञा करस, मी नही तर प्रभु करस, की बायकोने नवराले सोडाले नको. <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />सोडा तर मंग तिनी बिन लगीन करानं ऱ्हावाले पाहिजे, किंवा नवरासंगे तडजोड कराले पाहिजे; अनी नवरानी बायकोले सोडाले नको.<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />बाकिनासले प्रभु नही मी सांगस, जर एखादा भाऊले ईश्वासहिन बायको शे, अनी ती त्यानासंगे नांदाले तयार शे, तर त्यानी तिले सोडानं नही. <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />ज्या बाईले अईश्वासु नवरा शे तो जर तिनासंगे ऱ्हावाले तयार शे, तर तिनी त्याले सोडानं नही. <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />कारण बायकोकडतीन अईश्वासु नवरा पवित्र व्हयेल शे, अनी नवराकडतीन बिनईश्वासु बायको पवित्र व्हयेल शे; अस नसतं तर तुमना पोऱ्यासोऱ्या अशुध्द राहतात; पण आते त्या पवित्र शेतस. <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />जर अईश्वासु व्यक्तीनी वेगळी व्हवानी ईच्छा शे त्यानी वेगळं होऊ द्या, असा परिस्थीतिमा भाऊ किंवा बहिण बांधेल नही शेतस, पण देवनी आपलाले शांतीमा ऱ्हावाले बलायेल शे. <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />हे पत्नी, तु तुना नवराले तारशी किंवा नही, यानी तुले खात्री शे का? हे पती, तु तुनी पत्नीले तारशी किंवा नही, यानी तुले खात्री शे का?<verse eid="1CO 7:16" /></para>
  <para style="s">देवनी सांगेल प्रमाणे जगानं</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />तर जश प्रत्येकले प्रभुनी वाटी देयल शे, जश प्रत्येकले देवनी बलायेल शे, तस त्यानी चालाले पाहिजे अनी सर्व मंडळीसले मी हाईच आज्ञा देस. <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />सुंता व्हयेल माणुसले जर पाचारण व्हयनं तर त्यानी बेसुंतीसनामायक वागाले नको; एखादा बेसुंती माणुसले पाचारण व्हयनं तर त्यानी सुंता करी लेवाले नको. <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />सुंता काहीच नही अनं बेसुंता बी काही नही, तर देवन्या आज्ञा पाळा हाईच काय ते सर्व शे. <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />तुमले ज्या परिस्थीतीमा देवनी बलायेल शे, त्याच स्थितीमा ऱ्हा. <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />जर तु सेवक व्हता तवय तुले बलायेल शे का? त्यानी चिंता करू नको; पण तुले जर स्वतंत्र व्हता ई, तर व्हई जा. <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />कारण दास राहीसन बी ज्याले प्रभुमा पाचारण व्हयनं, तो गुलामगिरीमातीन मोकळा व्हयेल देवना माणुस शे; तसच मोकळ असतांना ज्याले पाचारण व्हयनं; तो ख्रिस्तना दास शे. <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />तुम्हीन किंमत दिसन विकत लेयल शे, तुम्हीन मनुष्यना सेवक होऊ नका. <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />बंधुसवन, ज्या परिस्थीतिमा तुमले प्रत्येकले बलायेल शे, त्याच परिस्थीतिमा तुम्हीन देवजवळ ऱ्हा.<verse eid="1CO 7:24" /></para>
  <para style="s">बिन लगीन व्हयेल अनी विधवा</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />आते कुवारीसबद्दल माले प्रभुकडतीन माले आज्ञा भेटनी नही, पण प्रभुना दयातीन ईश्वासु ऱ्हावामुये मी मनं मत सांगस. <verse eid="1CO 7:25" /><verse number="26" style="v" sid="1CO 7:26" />ते अस की, आतेनी परिस्थीतिमा माणुसकरता हाई चांगले शे की, जो ज्या स्थितीमा शे, त्यानी त्याच स्थितीमा ऱ्हावाले पाहिजे. <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />तु बायकोले बांधेल शे का? बांधेल शे तर मोकळा व्हवाले दखु नको; बायकोपाईन मोकळा शे का? मोकळा शे तर बायको कराले दखु नको. <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />पण तु जर लगीन करस तर पाप नही करस; अनी जर कुवारी लगीन करस तर पाप नही करस. तरी बी असासले ह्या जिवनमा कष्ट व्हई अनी तुमनं रक्षण व्हवाले पाहिजे अशी मनी ईच्छा शे.<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />भाऊसवन, मी हाईच म्हणस; येळ कमी करामा येल शे, याकरता की आतेपाईन ज्यासले बायका शेतस, त्यासनी अस ऱ्हावाले पाहिजे जश त्यासले बायको नही; <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />ज्या रडतस त्यासनी रडतस नही, ज्या आनंद करतस त्यासनी आनंद नही करतस; ज्या विकत लेतस त्यासनी आपलाजोडे काहीच नही; <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />अनं ज्या जगना उपयोग करतस त्यासनी आपण त्याना उपयोग नही करतस अस ऱ्हावाले पाहिजे; कारण या जगनं रूपांतर व्हई राहीनं.<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />तुम्हीन निश्चित ऱ्हावाले पाहिजे अशी मनी ईच्छा शे, बिन लगीन व्हयेल माणुस, प्रभुले कश खूश करानं, अशी प्रभुना गोष्टीसबद्दल चिंता करस. <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />पण लगीन व्हयेल माणुस, आपली बायकोले कश खूश करानं असा जगन्या गोष्टीसबद्दल चिंता करस; <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />लगीन व्हयेल अनं बिन लगीन व्हयेल बाई यासनामा बी फरक शे. बिन लगीन व्हयेल ऱ्हास ती शरीरतिन अनं आत्मातीन बी कश पवित्र व्हवाणं, अशी प्रभुना गोष्टीसबद्दल चिंता करस; पण लगीन व्हयेल ऱ्हास ती आपण आपला नवराले कश खूश करानं असा जगन्या गोष्टीसबद्दल चिंता करतस.<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />हाई मी तुमना चांगला करता सांगस; तुमनावर फास टाकाकरता नही, तर तुमना हातघाई उत्तम तेच व्हवाले पाहिजे अनं प्रभुनी सेवा एकचित्ततीन व्हवाले पाहिजे.<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />जर कोणले अस वाटस की, तो त्याना कुवारी पोरना अपमाननं कारण व्हई राहीना, ती उपवर व्हयेल शे अनी तसा अगत्यच शे, तर जशी ईच्छा व्हई तसं त्यानी करानं, तो पाप करस नही, त्यानी लगीन करी लेवानं. <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />पण ज्यानी कुवारीसंगे लगीन नही कराना निर्णय लियेल शे, ज्याले कसानी बळजबरी नही अनं ज्यानी ईच्छावर सत्ता शे अनी अस ज्यानी मनमा ठरायेल शे तो चांगलं करस. <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />म्हणीसन जो कुवारी पोरंन लगीन करी देस तो चांगला करस, पण लगीन करी देस नही तो अधिक चांगला करस. <verse eid="1CO 7:38" /><verse number="39" style="v" sid="1CO 7:39" />नवरा जिवत शे तोपर्यंत बायको बांधेल शे; नवरा मरानंतर तिनी ईच्छा शे त्यानाबरोबर, पण फक्त प्रभुमा लगीन कराले मोकळी शे; <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />जर ती लगीन न करता तशीच ऱ्हायनी तर मना ईचारतीन ती जास्त सुखी राही; अनी माले वाटस, देवना आत्मा मनामा बी शे.<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">मुर्तिले चढायेल नैवेद्य</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />मुर्तिनं नैवद्यबद्दल, “आपला सर्वासले ज्ञान शे,” हाई आपले माहीत शे. ज्ञान फुगाडस; पण प्रेमतीन प्रगती व्हस. <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />जर कोणी समजस की, माले एखादी गोष्ट कळस, तर जसं त्याले कळाले पाहिजे त्याप्रमाणे त्याले अजुन कळेल नही शे. <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />जर कोणी देववर प्रेम करस तर, देवले त्यानी वळख व्हयेल ऱ्हास.<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />आपले मुर्तिनं नैवद्य खावाबद्दले माहीत शे की, जगमा ज्या मुर्त्या शेतस त्यासमा देवसनं अस्तित्व नही शे, अनी एकशिवाय दुसरा देव नही. <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />जर आकाश अनं पृथ्वीवर सांगेल बराच देव शेतस, जश की, बराच देव अनी प्रभु शेतस बी, <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />पण आमनाकरता तर एकच देव शे, म्हणजे बाप, ज्यानी सर्वकाही बनाडेल शे अनी ज्यानाकरता आपण बी शेतस, एकच प्रभु येशु ख्रिस्त शे, ज्यानाद्वारे सर्वकाही व्हयनं अनी ज्यानाद्वारे आम्हीन बी शेतस.<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />हाई ज्ञान सर्वासकडे ऱ्हास अस नही तर कितलासवर मुर्तिना सवयीसना संस्कार अजुन बी असामुये त्या लोके मुर्तिनं नैवद्य म्हणीसन खातस, त्यामुये त्यासना मन दुर्बळ असामुये ते विटाळस. <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />पण जेवण आपलाले देवनाजोडे नही लई जास, जर आम्हीन नही खातस तर आपलं काही कमी नही व्हस, अनी आपण जर खातस तर आपलं काही वाढस नही. <verse eid="1CO 8:8" /><verse number="9" style="v" sid="1CO 8:9" />तुमना हाऊ मोकळेपणा दुसरासले आडफाटानं कारण व्हवाले नको म्हणीन संभाळा. <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />कारण ज्ञानवान असा जो तु, त्या तुले मुर्तिना मंदिरमा जेवाले बशेल अस कोणी दखं तर, तो मनतीन दुर्बळ असावर, त्याना मनमा मुर्तिनं नैवद्य खावानं धाडस ईच ना? <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />त्याप्रमानतीन जो मनतीन दुर्बळ, ज्यानाकरता ख्रिस्त मरना असा बंधु, त्याना तुना हाई ज्ञान मिळता नाश व्हस. <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />भाऊविरूध्द अस पाप करीसन अनं त्याना अशक्त मनले धक्का दिसन तुम्हीन ख्रिस्तविरूध्द पाप करतस. <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />जर या जेवणमुये मना भाऊले आडफाटा व्हस, तर मी त्याले आडफाटा व्हवाले नको, म्हणीन मी कधीच मांस खावाव नही.<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">प्रेषितसना अधिकार अनी काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />मी मोकळा नही शे का? मी प्रेषित नही शे का? आपला प्रभु येशु याले मी दखं नही का? प्रभुमा मना कामनं प्रतिफळ तुम्हीन नही शेतस का? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />जर मी दुसरासकरता प्रेषित नही पण तुमनाकरता तर शे; कारण तुमनी प्रभुमा एकता हाईच मना प्रेषितपणानं प्रमाण शे. <verse eid="1CO 9:2" /><verse number="3" style="v" sid="1CO 9:3" />मनी चौकशी करनारासले मनं हाईच उत्तर शे. <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />आमले कष्ट करीसन खावापेवाणा अधिकार नही का? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />दुसरा प्रेषित, प्रभुना भाऊ अनं केफा यानाप्रमाणतीन आमले बी ईश्वासु बहिणले पत्नी करीसन सोबत लई जावाना हक्क नही काय? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />मी अनं बर्णबाचं आम्हीनच कामधंदा करीसन खावानं का? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />आपला पैसा खर्च करीसन सैन्यमा सेवा करस, असा कोण शे? द्राक्षमया लाईन त्यानं फळ खास नही अस कोण शे? असा कोण शे, जो मेंढरं पाळस अनं त्यासनं दुध पेस नही?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />मी माणुसना रितप्रमाणे हाई बोलस का? नियमशास्त्र बी अस नही सांगस का? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" /><note caller="+" style="x"><char style="xo" closed="false">९:९ </char><char style="xt" closed="false"><ref loc="1TI 5:18">१ तिमथ्य ५:१८</ref></char></note>मोशेना नियमशास्त्रमा अस लिखेल शे की, “बैल मळणी करस तवय त्याले त्यानं तोंड नही बांधाणं” काय देवले फक्त बैलसनीच चिंता शे का? <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />का तो सर्वकाही आपलाकरताच सांगस; हा, आमनाकरताच लिखेल व्हतं; असा अर्थतीन की जो नांगरस त्यानी आशा धरीन नांगराणं, अनी जो कापणी करस त्यानी ती, त्यामातीन वाटा भेटी ह्या आशातीन कराले पाहिजे. <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" /><note caller="+" style="x"><char style="xo" closed="false">९:११ </char><char style="xt" closed="false"><ref loc="ROM 15:27">रोम १५:२७</ref></char></note>आम्हीन तुमनाकरता अध्यात्मिक वस्तुसनी पेरणी करेल शे, तर आम्हीन तुमना जगीक वस्तुसनी कापणी करी तर त्यानामा काय मोठी गोष्ट शे? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />जर तुमनावर दुसरा लोक अधिकार गाजाडतस तर काय तुमनावर आमना अजुन अधिकार नही? तरी बी आम्हीन ह्या अधिकारना वापर नही करा, पण ख्रिस्तना सुवार्ताले काही अडचण येवाले नको म्हणीन आम्हीन सर्वकाही सहन करतस. <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />मंदिरमा सेवा करनारा मंदिरमाधल खातस अनी वेदीजोडे सेवा करनारा वेदीवर जे अर्पण करेल शे त्याना भागीदार व्हतस हाई तुमले माहीत नही का? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" /><note caller="+" style="x"><char style="xo" closed="false">९:१४ </char><char style="xt" closed="false"><ref loc="MAT 10:10">मत्तय १०:१०</ref>; <ref loc="LUK 10:7">लूक १०:७</ref></char></note>याप्रमाणे देवनी आज्ञा करेल शे की, ज्या सुवार्ता सांगतस त्यासनी सुवार्तावर आपलं जिवन जगानं.<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />मी यातीन कोणताच अधिकारना वापर करेल नही अनं यानाप्रमानं माले भेटाले पाहिजे म्हणीसन मी हाई लिखं नही कारण हाऊ स्वाभिमान कोणी व्यर्थ करी यानांपेक्षा मी मरी जायेल हाई बरं. <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />जर मी सुवार्ता सांगस तर माले गर्व करानं कारण नही; ती सांगानं माले आज्ञा प्राप्त शे, मी सुवार्ता सांगस नही तर मना धिक्कार असो. <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />मी हाई मना ईच्छातीन करस तर माले वेतन मिळी, अनी मी कर्तव्य म्हणीसन करस, कारण माले देवनी कारभार सोपेल शे. <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />तर मंग मनं वेतन काय? हाईच की मी सुवार्ता फुकट सांगाले पाहिजे अनी सुवार्ताबद्दल जो मना अधिकार शे तो मी पुरा वापराले नको.<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />मी सर्वासपाईन मोकळा व्हतु तरी जास्त लोकसले देवना राज्यमा आनाकरता मी स्वतःले दुसरासना दास बनाडी लेयल शे. <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />यहूदी लोक मिळावाकरता मी यहूदी लोकसले यहूदी लोकसमायक व्हयनु; मोशेना नियमशास्त्रले अधीन नव्हतु तरी नियमशास्त्र अधीन असा व्हयनु. <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />ज्यासले नियमशास्त्र नही असा गैरयहूदीसले मिळाडाकरता असासले मी नियमशास्त्र नही असा व्हयेल शे तरी देवना नियमशास्त्र बाहेर व्हतु असा व्हयनु नही, मी ख्रिस्तना नियममा व्हतु <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />दुर्बळ लोकसले मिळावाकरता मी दुर्बळसले दुर्बळ व्हयनु. मी सर्वासकरता सर्वकाही व्हयनु, याकरता की, कश तरी बराच लोकसनं तारण कराले पाहिजे.<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />मी सर्वकाही सुवार्ताकरता करस, याकरता की मी दुसराससंगे तिना भाग व्हवाले पाहिजे. <verse eid="1CO 9:23" /><verse number="24" style="v" sid="1CO 9:24" />शर्यतमा पयणारा सर्वाच पयतस, पण एकलेच बक्षीस मिळस हाई तुमले माहीत नही का? तुमले ते मिळी अस पळा. <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />स्पर्धाकरता मेहनत करनारा प्रत्येक माणुस सर्वा गोष्टीसमा संयमन करस. त्या नाशवंत बक्षीस मिळाडाकरता करतस, पण आपण अविनाशी बक्षीस मिळडाकरता करतस. <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />मी पण तसाच पयस, म्हणजे अनिश्चीतपणातीन मी धावत नही. तशी कुस्तीपण करस, म्हणजे वारावर मी बुक्क्या मारस नही. <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />तवय मी आपला शरिरले पकडीसन दास करसु, अनं मी असं कर नही मी दुसऱ्यासना घोषणा करेल वर मी अपात्र ठरसु.<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">मुर्तिसबद्दल इशारा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />भाऊसवन, आपला सर्वाच पुर्वज ढगखाल व्हतात, अनी समुद्रमातीन त्या पार गयात; हाई गोष्टबद्दल तुम्हीन अजाण ऱ्हावाले पाहिजे अशी मनी ईच्छा नही <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />ढग अनी समुद्र यासनाघाई मोशेमा त्या सर्वासना बाप्तिस्मा व्हईना. <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />सर्वासनी, एकच अध्यात्मिक जेवण करं; <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />अनी सर्वासनी एकच अध्यात्मिक पाणी पिधं, कारण त्या आपलासंगे चालणारा खडकमातीन पि राहींतात; तो खडक ख्रिस्त व्हता. <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />तरी त्यासनातीन बराच लोकसबद्दल देव प्रसन्न नव्हता; यामुये त्यासना शरिरना जंगलमा नाश व्हयना.<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />ह्या गोष्टी आमनाकरता दृष्टांत असा व्हयनात, की आम्हीन बी वाईट गोष्टीसना लोभ धराले नको, जशा त्यासनी धरेल व्हता. <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />त्यासनापैकी कितला मुर्तिपुजक व्हतात तस होऊ नका; “लोके खावाले पेवाले बसनात, नंतर खेळाले ऊठनात,” अस शास्त्रमा लिखेल शे. <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />अनी आपण व्यभिचार कराले नको; जशा त्यासनापैकी बराच जणसनी करा अनं एक दिनमा त्या तेवीस हजार मरी पडनात. <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />अनी आपण प्रभुनी परिक्षा कराले नको, जशी त्यासनापैकी बराच जणसनी करी अनी त्यासना सापसकडतीन नाश व्हयना. <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />तुम्हीन कुरकुर करू नका, जशी त्यासनापैकी बराच जणसनी करी अनी नाश करनारासकडतीन त्यासना नाश व्हयना.<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />ह्या गोष्टी त्यासनाकरता दृष्टांत मायक व्हयन्यात; अनी ह्या आपले चेतावणी करता लिखाई गयात ज्यानावर या युगना शेवट येल शे.<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />यामुये आपण उभा शेतस अस ज्यासले वाटस त्यासनी पडाले नको म्हणीन संभाळा. <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />तुम्हीन असा परिक्षामा नही पडनात जी मनुष्यना शक्तीना बाहेर; अनी देव ईश्वासपात्र शे, तो तुमनी परिक्षा तुमना शक्तीना पलीकडे व्हवु देवाव नही, तर परिक्षासंगे तिनामातीन निंघाना उपाय बी करी, अस की, तुम्हीन ती सहन कराले समर्थ व्हवाले पाहिजे.<verse eid="1CO 10:13" /></para>
  <para style="s">मुर्तिपुजा अनं प्रभुभोजन</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />यामुये मना प्रिय भाऊसवन तुम्हीन मुर्तिपुजापाईन दुर रहा. <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />तुमले समजदार समजीसन मी तुमनासंगे बोलस; मी काय बोलस त्याना तुम्हीनच ईचार करा. <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" /><note caller="+" style="x"><char style="xo" closed="false">१०:१६ </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">मत्तय २६:२६-२८</ref>; <ref loc="MRK 14:22-24">मार्क १४:२२-२४</ref>; <ref loc="LUK 22:19">लूक २२:१९</ref>,<ref loc="LUK 22:20">२०</ref></char></note>जो ख्रिस्तना रक्ताना प्याला आपण प्रभुभोजनमा वापरतस अनी ज्यानाबद्दल परमेश्वरले धन्यवाद करतस अनी जवय आम्हीन तो पितस तवय त्याना रक्तमा सहभागीता करतस अनं जवय आपण भाकर मोडीन खातस तवय ख्रिस्तना शरिरमा सहभागीता करतस. <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />आपण बराच राहीन एक भाकर, एक शरीर असा शेतस; आपण सर्व त्या एक भाकरना भाग शेतस. <verse eid="1CO 10:17" /><verse number="18" style="v" sid="1CO 10:18" />इस्त्राएली लोकसकडे दखा; बळी खाणारा परमेश्वरना अर्पणसना भागीदार नही शेतस का? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />मनं सांगानं तात्पर्य काय शे? मुर्तिसमोर बली चढायेल वस्तु काहीतरी शे? की, मुर्ति काहीतरी शे? <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />नही! पण मी हाई सांगस की, ज्या लोकसले देव माहित नही त्या लोके जी बळी चढावतस, ती देवले नही तर भुतसले चढावतस; अनी तुम्हीन भूतसना सहभागी व्हवाले पाहिजे अशी मनी ईच्छा नही. <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />तुम्हीन प्रभुना प्याला अनं अनी भूतसना प्याला दोन्हीसमातीन नही पिऊ शकतस; तुम्हीन प्रभुना मेज अनी भूतसना मेज दोन्हीसना सहभागी नही बनु शकतस. <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />काय आम्हीन देवले राग आनी देवाना प्रयत्न करी राहिनुत का? काय आपण त्यानापेक्षा बलवान शेतस?<verse eid="1CO 10:22" /></para>
  <para style="s">सर्वकाही देवना महिमा करता</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१०:२३ </char>
      <char style="xt" closed="false">
        <ref loc="1CO 6:12">१ करिंथ ६:१२</ref>
      </char>
    </note>काही लोके म्हणतस, “सर्व गोष्टी करानी सुट शे,” तरी सर्व गोष्टी हितकारक शे अस नही. अनं दुसरा म्हणतस, “सर्व गोष्टी करानी सुट शे,” तरी सर्व गोष्टी उन्नती करतस अस नही. <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />कोणी आपलच हित दखु नका तर दुसरासना हितनी बी चिंता करा. <verse eid="1CO 10:24" /><verse number="25" style="v" sid="1CO 10:25" />जे खाटिक बजारमा विकामा येस ते मनमा शंका नही धरता मनोवृत्तीतिन प्रश्न नही ईचारता खा. <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />कारण शास्त्रलेख म्हणस, “पृथ्वी अनं तिनावर जे काही भरेल शे ते प्रभुनं शे.” <verse eid="1CO 10:26" /><verse number="27" style="v" sid="1CO 10:27" />ईश्वास ठेवतस नही असा कोणी तुमले जेवाले बलावं अनी तुमनी जावानी ईच्छा नही तर जे काही तुमले वाढतीन त्यानी ईचारपुस नही करता खाई लेवानं म्हणजे तुमनं मन तुमले खावाव नही. <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />पण जर कोणी तुमले सांगं, “हाई तर मुर्तिले चढायेल वस्तु शे” तर त्या सांगनारामुये अनी तुनी शंकामुये ते खाऊ नका म्हणजे तुनं मन तुले खावाऊ नही. <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />शंका हाई तुना मनमा नही, तर त्यासना मनमा शे. “काही लोक म्हणतीन, मना स्वतंत्रना न्यायनिवाड दुसराना मनतीन का बरं व्हवाले पाहिजे?” <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />मी जर धन्यवाद दिसन खास तर ज्याबद्दल मी देवले धन्यवाद देस त्यानाबद्दल मनी निंदा का बर व्हवाले पाहिजे. <verse eid="1CO 10:30" /><verse number="31" style="v" sid="1CO 10:31" />यामुये तुम्हीन जे खातस पितस किंवा जे काही करतस ते सर्व देवना गौरवकरता करा. <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />यहूदी अनी गैरयहूदी लोकसले किंवा देवनी मंडळीले तुम्हीन आडफाटा लयनारा व्हवु नका; <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />ज्याप्रकारे मी बी सर्वा गोष्टीसमा सर्व मनुष्यसले प्रसन्न करस अनी आपला हितनी नही पण बराच जणसना हितनी चिंता करस की त्यासनं तारण व्हवाले पाहिजे.<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">११:१ </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:16">१ करिंथ ४:१६</ref>; <ref loc="PHP 3:17">फिलप्पै ३:१७</ref></char>
    </note>जश मी ख्रिस्तनं अनुकरण करस तस तुम्हीन ख्रिस्तनं अनुकरण करा.<verse eid="1CO 11:1" /></para>
  <para style="s">आराधनामा डोकं झाकाणं</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />तुम्हीन सर्व गोष्टीसमा मनी आठवण करतस, अनी जे शिक्षण मी तुमले देयल शे, ते तुम्हीन जशना तस दृढपणे पाळतस. म्हणीन मी तुमनी वाहवाह करस. <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />प्रत्येक माणुसनं डोकं ख्रिस्त शे, अनी ख्रिस्तनं डोकं देव शे, हाई तुमले समजाले पाहिजे अशी मनी ईच्छा शे. <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />जो माणुस आपलं डोकं झाकिण प्रार्थना करस किंवा देवकडतीन संदेश देस तो आपला डोकाना अपमान करस; <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />तसच जी बाई डोकं नही झाकता प्रार्थना करस किंवा देवकडतीन संदेश देस ती आपला डोकाना अपमान करस; कारण ती टकली करेल बाई सारखीच शे. <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />बाई जर आपलं डोकं झाकत नही तर स्वतःना केस कापाले पाहिजेत, पण जर केस कापणं की टकली करानं बाईले लाजडणारी गोष्ट शे तर तिनी आपलं डोकं झाकलं पाहिजे. <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />माणुस देवनी प्रतिमा अनं वैभव शे, म्हणीन त्यानी डोकं झाकाणं योग्य नही; बाई तर माणुसनं गौरव शे; <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />माणुस बाईपाईन व्हयेल नही तर बाई माणुसपाईन व्हयेल शे; <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />अनी बाई माणुसकरता बनाडेल नही माणुस बाईकरता बनाडेल शे; <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />यामुये अनी देवदूतसमुये बाईनी आपला अधिकारना चिन्ह आपला मस्तकवर ठेवानं हाई योग्य शे. <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />तरी देवमा माणुस बाईपाईन येगळा नही, बाई माणुसपाईन येगळा नही. <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />कारण जशी बाई माणुसपाईन, तसं माणुस बाईपाईन जन्म लेस; अनी सर्वकाही देवापाईन शे. <verse eid="1CO 11:12" /><verse number="13" style="v" sid="1CO 11:13" />तुम्हीन एकमेकसमा ईचार करीसन दखा; डोकं नही झाकता देवनी प्रार्थना करनं बाईले शोभस का? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />लांब केस ठेवणं माणुसकरता लाज वाटानी गोष्ट शे अस निसर्ग पण तुमले सांगस नही का? <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />बाईना लांब केस तिनी शोभा शे; कारण केस तिले झाकाकरता देयल शेतस. <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />पण जर कोणी वाद करनारा दिसना, तर आपलामा अनी देवनी मंडळ्यासमा तशी रित नही.<verse eid="1CO 11:16" /></para>
  <para style="s">प्रभुभोजननं भ्रष्टीकरण</para>
  <para style="r">(<ref loc="MAT 26:26-29">मत्तय २६:२६-२९</ref>; <ref loc="MRK 14:22-25">मार्क १४:२२-२५</ref>; <ref loc="LUK 22:14-20">लूक २२:१४-२०</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />अशी आज्ञा दिधी की, तुम्हीन देवनी भक्ती कराले एकत्र व्हतस तवय तुमनं चांगलं नही व्हस तर वाईट व्हस, म्हणीन मी तुमनी वाहवाह करस नही. <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />पहिले हाई की, तुमनी मंडळी एकत्र जमस तवय तुमनामा फुट ऱ्हास, अस मी ऐकस; अनं ते काही प्रमाणमा खरं मानस. <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />तुमना पक्षभेद व्हईच, ज्यामुये की तुमनामा ज्या खरा शेतस त्या प्रकट व्हतीन. <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />यामुये जवय तुम्हीन एकत्र जमतस तवय प्रभुभोजन करनं शक्य नही व्हस. <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />कारण भोजन करानी येळले प्रत्येकजन आपलं घरनं जेवण दुसराना पहिले खाई लेस, एक भूक्या ऱ्हास तर, एक पीसन मस्त व्हस. <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />तुमले खावाले पेवाले घर नही शेतस का? किंवा तुम्हीन देवना मंडळीले धिक्कारीसन ज्यासनाजोडे काही नही त्यासले लाजडतस का? मी तुमले काय सांगु? यानाबद्दल मी तुमनी वाहवाह कराले पाहिजे का? मी तुमनी वाहवाह करत नही. <verse eid="1CO 11:22" /><verse number="23" style="v" sid="1CO 11:23" />कारण जे माले प्रभुपाईन मिळेल शे, तेच मी तुमले सांगेल शे, ज्या रातले प्रभु येशुले धरी दिधं, त्या रातले त्यानी भाकर लिधी. <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />देवना उपकार मानीन ती मोडीसन सांगं, तुमनाकरता जे मनं शरीर ते हाई शे, मना आठवणकरता हाई करा. <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />मंग जेवण व्हवानंतर प्याला लिसन त्यानी तसच करं, अनी सांगं, हाऊ प्याला मना रंगतमा नवा करार शे; जितलांदाव तुम्हीन हाऊ पितस तितलांदाव मना आठवणकरता हाई करा. <figure style="fig" alt="Jesus eating the Passover meal with his disciples" file="lb00320c.tif" size="col" copy="Horace Knowles ©" ref="११:२३">येशुना आपला शिष्यससंगे शेवटला भोजन</figure><verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />कारण जितलांदाव तुम्हीन हाई भाकर खातस, अनं हाऊ प्याला पितस तितलांदाव तुम्हीन प्रभुना मरणनी तो येईपर्यंत घोषणा करतस. <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />जो कोणी अयोग्य प्रकारतीन ती भाकर खास, अनं हाऊ प्याला पि, तो प्रभुनं शरीर अनं रक्त यानाबद्दल दोषी व्हई <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />यामुये मनुष्यनी स्वतःनी परिक्षा कराले पाहिजे अनी मंग त्या भाकरमातीन खावाणं अनं त्या प्यालामातीन पेवाणं. <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />त्या प्रभुना शरिरले न वळखता जो खास अनं पेस तो खावापुरता अनं पेवापुरता स्वतःवर दंड आणस. <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />यामुये तुमना जोडे बराच जण दुर्बळ अनं आजारी शेतस, अनी बराच झोपेल शेतस. <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />जर आपण आपला न्यायनिवाडा करतस तर आपलावर दंड येता नही. <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />न्यायामुये आपलावर दंड येल शे त्यामुये आपलाले प्रभुकडतीन शिक्षा व्हई राहिनी शे, यानाकरता की जगनासंगे आपलाले दंडाज्ञा व्हवाले नको. <verse eid="1CO 11:32" /><verse number="33" style="v" sid="1CO 11:33" />यामुये भाऊसवन, तुम्हीन खावाले पेवाले एकत्र मिळतस तवय एकमेकसनी वाट दखा. <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />कोणी भूका राही तर त्यानी घर खावाणं, यानाकरता की तुमनं एकत्र मिळणं शिक्षाकरता व्हवाले नको. बाकीना गोष्टीसनी व्यवस्था मी येवावर दखसु.<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">पवित्र आत्मानं दान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />भाऊसवन, तुम्हीन पवित्र दानसबद्दल अजाण ऱ्हावाले पाहिजे अशी मनी ईच्छा नही. <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />तुम्हीन गैरयहूदी व्हतात तवय जश जश वळण तुमले भेटणं तसतस तुम्हीन त्या मुक्या मुर्तिकडे बहकत गयात हाई तुमले माहीत शे. <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />यामुये मी तुमले सांगस की, देवना आत्मातीन बोलणारा कोणाताबी माणुस येशु शापित शे अस म्हणस नही; अनी पवित्र आत्मातीन बोलाशिवाय कोणले बी येशु हाऊ प्रभु शे अस म्हणता येस नही.<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:४ </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:6-8">रोम १२:६-८</ref>
      </char>
    </note>कृपादानना येगयेगळा प्रकार शेतस, तरी दान देणारा पवित्र आत्मा एकच शे; <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />सेवा कराणा येगयेगळा प्रकार शेतस तरी प्रभु एकच; <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />अनी काम कराना येगयेगळा प्रकार शेतस, तरी परमेश्वर एकच शे; तो प्रत्येकले प्रभावशाली बनाडस. <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />तरी पवित्र आत्मानं प्रकटीकरण प्रत्येकले उपयोग व्हवाकरता मिळस. <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />एकले आत्मातीन बुध्दीनं वचन अनी दुसराले त्याच आत्मातीन ज्ञाननं देवामा येस. <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />एकले त्याच आत्मामा ईश्वास; एकले त्याच आत्मामा बरं करानं कृपादान देवामा येस. <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />एकले सेवकडतीन अद्भुत कार्य करानी शक्ती; एकले देवना संदेश देवानी शक्ती; एकले देवना पवित्र आत्माना दानसले वळखाणी शक्ती; एकले अनोळखी भाषा बोलानी शक्ती; अनं एकले अनोळखी भाषासना अर्थ सांगानी शक्ती मिळस; <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />तरी हाई सर्व कामे तोच एक देवना आत्मा करस, तो त्याना ईच्छाप्रमाणे एकएकले ती वाटी देस.<verse eid="1CO 12:11" /></para>
  <para style="s">एक शरिरना बराच भाग</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१२:१२ </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:4">रोम १२:४</ref>,<ref loc="ROM 12:5">५</ref></char>
    </note>जश शरीर एक राहीन त्याले अवयव बराच राहतस अनी त्या शरिरना अवयव बराच राहीन सर्व मिळीन एक शरीर बनस, तसा ख्रिस्तनं शरीर बी शे. <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />कारण आपण यहूदी राहुत किंवा गैरयहूदी राहुत, दास राहुत किंवा स्वतंत्र राहुत, आपले सर्वासले एक आत्म्यामा, एक शरीर व्हवाकरता बाप्तिस्मा मिळेल शे, अनी आपण सर्व एकच आत्माघाई एकत्र व्हयेल शेतस. <verse eid="1CO 12:13" /><verse number="14" style="v" sid="1CO 12:14" />कारण शरीर एक अवयव नही तर बराच अवयवनं शे. <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />जर पाय सांगी, मी हात नही, तर त्यावरतीन तो शरिरना भाग नही अस व्हस नही. <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />जर कान सांगी, मी डोया नही म्हणीन मी शरिरना भाग नही, तर त्यावरतीन तो शरिरना नही अस व्हस नही. <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />जर पुरं शरीर डोयाच राहत, तर ऐकणं कोठे राहत? अनी जर पुरा शारीरतिन ऐकणंच राहत तर वास लेवानं कोठे राहत. <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />पण देवनी त्याना ईच्छाप्रमाणे सर्व भागसले एक एक करीसन शरिरमा ठेव. <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />त्या सर्व अवयव मिळीन एक राहतात तर शरीर कोठे राहतं. <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />तर मंग अवयव बराच राहीन शरीर एक शे. <verse eid="1CO 12:20" /><verse number="21" style="v" sid="1CO 12:21" />डोयाले हातले म्हणता येस नही की, माले तुनी गरज नही, मस्तकले पायले म्हणता येस नही की माले तुनी गरज नही. <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />इतलंच नही तर शरिरना ज्या अवयव विशेष कमजोर वाटतस, त्यासनी गरज शे; <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />शरिरना ज्या भाग आपण कमी दखाडु नही शेकतस त्यासनावर आपण चांगलच पांघरून टाकीसन विशेष मान देतस, अनी कुरूप आंगले सुंदरता मिळस; <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />आपला सुंदर आंगले अशी गरज नही; ज्या कमी शेतस त्यासे विशेष मान भेटाले पाहिजे असा पध्दततीन देवनी शरीर जोडले शे. <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />यानाकरता की शरिरमा फुट ऱ्हावाले नको, तर अवयवसनी एकमेकसनी सारखी काळजी लेवाले पाहिजे. <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />एक अवयव दुःखी व्हयना तर त्यानासंगे सर्व अवयव दुःखी व्हतस; एक अवयवनी वाहवा व्हयनी तर त्यानाबरोबर सर्व अवयव आनंदीत व्हतस. <verse eid="1CO 12:26" /><verse number="27" style="v" sid="1CO 12:27" />तुम्हीन ख्रिस्तनं शरीर शेतस, प्रत्येकजण आपआपला कामप्रमाणे त्याना अवयव शेतस. <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" /><note caller="+" style="x"><char style="xo" closed="false">१२:२८ </char><char style="xt" closed="false"><ref loc="EPH 4:11">इफिस ४:११</ref></char></note>तसे देवनी मंडळीत कितलातरी जणसले नेमले शे; पहिला प्रेषित, दुसरा संदेष्टे, तिसरा शिक्षक शिवाय अद्भुत कार्य करनारा, आरोग्य देवाकरता कृपादान मिळेल, मदत करनारा, व्यवस्था करनारा, अनोळखी भाषा बोलणारा. <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />सर्वाच प्रेषित शेतस का? सर्वाच संदेष्टा शेतस का? सर्वाच अद्भुत कार्य करनारा शेतस का? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />सर्वासले बरा कराना कृपादान शेतस का? सर्वाच भिन्नभिन्न भाषा बोलतस का? भाषासना अर्थ सर्वच सांगतस का? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />श्रेष्ठ कृपादानसनी प्रबळ ईच्छा धरा; पण त्यानाशिवाय एक सर्वोकृष्ट रस्ता मी तुमले दखाडसु.<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">प्रेम हाई सर्वश्रेष्ठ दान शे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />जर मी मनुष्यना अनं देवदूतसना भाषा बोलनु, पण मना आंगी प्रेम नही राहीनं तर मी वाजणारी थाळी अनं झणझणारी झांज असा शे. <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" /><note caller="+" style="x"><char style="xo" closed="false">१३:२ </char><char style="xt" closed="false"><ref loc="MAT 17:20">मत्तय १७:२०</ref>; <ref loc="MAT 21:21">२१:२१</ref>; <ref loc="MRK 11:23">मार्क ११:२३</ref></char></note>माले संदेश देवानं दान राहिनं अनी सर्व गुप्त गोष्टी अनं सर्व ज्ञान मनाकडे राहिनं अनी कदाचित मनाकडे डोंगर सरकावाना ईश्वास राहिना, पण मनामा प्रेम नही राहिनं तर मी काहीच नही शे. <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />मी मनं सर्व संपत्ती गरीबसमा दान कराकरता दिधी, मनं शरीर जाळाकरता दिधं, अनी मना आंगे प्रेम नही राहीनं तर माले काहीच फायदा.<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />प्रेम सहनशील शे, दयाळु शे; प्रेम हेवा करस नही; प्रेम फुशारकी मारस, फुगत नही. <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />चुकीना व्यवहार करस नही, स्वार्थ दखस नही, चिडत नही, वाईट गोष्टीसना माहीती ठेवत नही.<verse eid="1CO 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 13:6" />अनितीमा आनंद मानतस नही, तर सत्यमा आनंद मानतस, सर्व गोष्टीसमा धीर ठेवतस. <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />सर्वकाही सहन करस, सर्व गोष्टीसवर ईश्वास ठेवस, सर्वासनी आशा करस.<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />प्रेम कधीच संपस नही; संदेश राहतीन तर ते समाप्त व्हतीन, अनोळखी भाषा राहिन्यात तरी त्या समाप्त व्हतीन; अनी विद्या राहीनी तरी ती संपी. <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />आपलाले थोडसच कळस, अनी देवकडतीन संदेश थोडासाच देता येस. <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />पण पुर्णपणा ई तवय अपुर्णपणा नष्ट व्हई जाई.<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />मी पोऱ्या व्हतु तवय पोऱ्यानामायक बोलु, पोऱ्यासारखी मनी बुध्दी व्हती, अनी पोऱ्यानामायक मना ईचार व्हतात; आते मोठं व्हवानंतर मी धाकलपणन्या गोष्टी सोडी देयल शेतस. <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />आते आमले आरसामा अस्पष्ट दिसस; पण नंतर समोरा समोर दखुत; हाई येळले मनं ज्ञान अपुर्ण शे, पण नंतर पुर्णपणे मी वळखसु, जश देवकडतीन पुर्णपणे माले वळखमा येल शे.<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />आपलाकडे ईश्वास, आशा, प्रेम ह्या तिन्ही शेतस; पण त्यामा प्रेम श्रेष्ठ शे.<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">पवित्र आत्माना दानबद्दल जास्त शिक्षण</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />प्रेमनं अनुकरण कराना प्रयत्न करा; तरी अध्यात्मिक दानसनी अनी देवकडतीन येणारा संदेश देता येवाले पाहिजे यानी मनपाईन ईच्छा धरा. <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />कारण भाषा बोलणारा माणससंगे नही तर देवसंगे बोलस, ते माणुसले समजस नही; तो आत्माघाई गुप्त गोष्टी बोलस, <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />देवकडतीन येणारा संदेश देणारा संदेष्टा हाऊ माणुसले प्रगती, बोध अनं सांत्वन व्हवासारख बोलस. <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />अनोळखी भाषा बोलणारा स्वतःनी प्रगती करस; संदेष्टा मंडळीनी प्रगती करस.<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />तुम्हीन अनोळखी भाषा बोलाले पाहिजे हाई माले बर वाटस, तरी विशेषकरीन; तुमले देवकडतीन येणारा संदेश देता येवाला पाहिजे अशी मनी ईच्छा शे; कारण; मंडळीना वाढकरता अर्थ नही सांगता जो अनोळखी भाषा बोलस त्यानापेक्षा देवकडतीन येणारा संदेश देणारा संदेष्ठा श्रेष्ठ शे. <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />म्हणीन भाऊ अनं बहिणीसवन, मी तुमनाकडे ईसन अनोळखी भाषा बोलसु, तर मनाकडतीन तुमले काय फायदा? अनी प्रकटीकरणतीन, विद्यातीन, संदेशतीन किंवा शिक्षणतीन तुमनासंगे बोलावं नही, <verse eid="1CO 14:6" /><verse number="7" style="v" sid="1CO 14:7" />पावा, विणा, असा आवाज करनारा <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />तसच तुतारी स्पष्ट आवाज काढाव नही तर लढाईले जावानी तयारी कोण करी? <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />त्याप्रमाणे तुम्हीन बी एक आवाजतीन स्पष्ट भाषण नही कर तर जे बोलतस ते कश समजी? तुम्हीन वारासंगे बोलणारा असा व्हशात. <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />जगमा भाषामा बराच प्रकार असतीन, तरी एक बी बिना अर्थनी नही. <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />जर माले कोणतीच भाषाना अर्थ नही माहीत तर मी बोलणारासकरता अनोळखी शे अनी बोलणारा मनाकरता अनोळखी शे. <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />तर ज्या तुम्हीन पवित्र आत्माना दानसबद्दल उतावळा शेतस त्या तुम्हीन, मंडळीना प्रगती करता त्या दान जास्त प्रमाणमा भेटाले पाहिजे म्हणीन प्रयत्न करा. <figure style="fig" alt="musical instruments" file="hk00188c.tif" size="col" copy="Horace Knowles ©" ref="१४:७">संगीतवाद्य</figure><verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />अनोळखी बोलणाराले त्याले अर्थ सांगता येवाले पाहिजे म्हणीन पवित्र आत्माकडे प्रार्थना करा. <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />कारण जर मी अनोळखीमा प्रार्थना करस, तर मना आत्मा प्रार्थना करस, पण मनी बुध्दीना कोणले उपयोग व्हत नही. <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />तर मंग काय? मी प्रार्थना आत्माना सामर्थ्यतीन करसु अनं बुध्दीना सामर्थ्यतीन बी करसु; मी स्तोत्रगान आत्माना सामर्थ्यतीन म्हणसु, अनं बुध्दीना सामर्थ्यतीन बी म्हणसु. <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />तु फक्त आत्मातीन धन्यवाद करा, तर जो अनपड लोकसपैकी शे तो देवना आभारले, आमेन, बोलीन तुमनासंगे सहमत कसा काय राहतीन? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />तुनं देवनं आभार चांगलं व्हई तरी त्यानाघाई दुसरानी वाढ व्हस नही.<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />तुमना सर्वासपेक्षा मी जास्त अनोळखी भाषा बोलस, म्हणीन मी देवना आभार मानस. <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />तरी बी अनोळखी भाषामा दहा हजार शब्द बोलापेक्षा मी दुसरासले शिकाडाकरता पाच शब्द स्वतः समजीउमजी बोलानं हाई माले आवडस.<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />भाऊसवन अनी बहिणीसवन, दुष्टपणमा बालबुध्दीना मायक व्हा; अनी समजुतदारपणबद्दल मोठं अस व्हा. <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />नियमशास्त्रमा लिखेल शे की, दुसऱ्या भाषा बोलणारा लोकसकडतीन अनं परका माणससना ओठतीन मी या लोकससंगे बोलसु; तरी बी त्या मनं नही ऐकावुत, अस परमेश्वर म्हणस. <verse eid="1CO 14:21" /><verse number="22" style="v" sid="1CO 14:22" />यामुये ईश्वास ठेवणारासपैकी नही तर ईश्वास नही ठेवणारासपैकी अनोळखी भाषा ह्या चिन्हसकरता शेतस; संदेश हाऊ ईश्वास नही ठेवणारासकरता नही तर ईश्वास ठेवणारासकरता शे.<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />जर सर्वा मंडळ्या एकत्र जमण्यात, अनी सर्व येगळ्या भाषासमा बोलाले लागणात, अनी अनपड किंवा ईश्वास नही ठेवणारा लोके मझार वनात, तर तुम्हीन येडा शेतस, अस त्या सांगाऊ नहीत का? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />पण जर सर्वाच जण देवकडतीन संदेश देवाले लागणात तर, कोणी ईश्वास नही ठेवणारा किंवा बाहेरना माणुस मझार वना तर तुम्हीन जे काही बोलशात त्यामुये त्याना पाप बद्दल त्याले खात्री व्हई, अनी त्याले समजी की त्याले पक्षतापनी गरज शे. <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />त्याना अंतःकरणमाधल्या गुप्त गोष्टी प्रकट व्हतीन, तवय तो उपडा पडीन देवनी आराधना करी अनी मानी ली की, “खरच देव तुमनामा शे!”<verse eid="1CO 14:25" /></para>
  <para style="s">भक्तीमा शिस्त</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />भाऊसवन अनी बहिणीसवन, तर मंग काय? तुम्हीन एकत्र जमतस, तवय तुमनामा कोणाजोडे भक्तीगीत, कोणाजोडे शिक्षण, कोणाजोडे देवकडतीन प्रकटीकरण, कोणाजोडे भाषा, कोणाजोडे तिनी व्याख्या अस ऱ्हावाले पाहिजे; हाई सर्वकाही मंडळीना प्रगती करता ऱ्हावाले पाहिजे. <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />जर कोणी अनोळखी भाषामा पवित्र आत्मातीन बोलस तर दोन किंवा जास्तीत जास्त तिन जणसनी क्रमतीन बोलाले पाहिजे, अनी एकनी अर्थ सांगाले पाहिजे; <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />पण अर्थ सांगणारा नही राहीना तर त्यानी मंडळीमा गप्प ऱ्हावाले पाहिजे; स्वतःसंगे अनं देवसंगे बोलाले पाहिजे. <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />देवना संदेश दोन किंवा तिन जणसनीच संदेश देवाले पाहिजे, अनी दुसरासनी निर्णय कराले पाहिजे. <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />तरी बठेल बाकीनासपैकी कोणले जर देवना संदेश प्रकट व्हयना, तर बोलनारासनी गप्पच ऱ्हावानं. <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />सर्वासले शिक्षण मिळी अनं सर्वासले बोध व्हई अस तुमले सर्वासले एकमांगीन एक संदेश देता ई. <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />परमेश्वर कडतीन संदेश देनारा संदेष्टासना आत्मा त्याना स्वतःना स्वाधीन राहतस. <verse eid="1CO 14:32" /><verse number="33" style="v" sid="1CO 14:33" />कारण देव अव्यवस्थाना नही, तर शांतीना शे; तसच तो पवित्र लोकसना सर्व मंडळीसमा शे. <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />बाईसनी मंडळीना सभामा शांतच ऱ्हावाले पाहिजे; त्यासले बोलनी परवानगी नही; नियमशास्त्र बी सांगस त्यानाप्रमाणे त्यासनी नियममा ऱ्हावानं. <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />त्यासले काही माहीती करी लेवानी ईच्छा राहीनी तर त्यासनी आपला नवरासले घर ईचारानं; बाईनी मंडळीमा बोलणं हाई योग्य नही.<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />देवनं वचन तुमनापाईन चालु व्हयनं का? का ते फक्त तुमनाकडे वनं? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />जर कोणी स्वतःले संदेष्टा किंवा अध्यात्मिक दान प्राप्त व्हयेल असा मानस, तर जे मी तुमले लिखेल ती प्रभुनी आज्ञा शे अस त्यानी समजाले पाहिजे; <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />पण कोणी याले नही मानस तर त्याले बी कोणी मानाले नको. <verse eid="1CO 14:38" /><verse number="39" style="v" sid="1CO 14:39" />यामुये भाऊसवन अनी बहिणीसवन, भाऊसवन तुम्हीन देवनाकडतीन संदेश देवानी मनपाईन ईच्छा धरा अनं अनोळखी भाषा बोलानं मना करू नका. <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />सर्वकाही शोभी अस अनं व्यवस्थीत व्हऊ द्या.<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">मरेल मातीन परत जिवत व्हनं</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />भाऊसवन अनी बहिणीसवन, मी तुमले आठवण करी देस की, जी सुवार्ता मी तुमले सांगी, जिना तुम्हीन स्विकार करा, जिनामा तुम्हीन स्थिर शेतस, <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />जिनाघाई तुमले तारण मिळेल शे तीच सुवार्ता मी तुमले सांगस, ज्या वचननी तुमले हाई सुवार्ता सांगी त्या वचननुसार ती तुम्हीन पक्की धरी ठेवतस; नही तर तुमना ईश्वास व्यर्थ शे. <verse eid="1CO 15:2" /><verse number="3" style="v" sid="1CO 15:3" />माले जे सांगता वनं ते मी तुमले सांगी दिधं, धर्मशास्त्राप्रमाणे हाई भलतीच महत्वपुर्ण गोष्ट शे की, येशु ख्रिस्त तुमना आमना पापसकरता मरणा. <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" /><note caller="+" style="x"><char style="xo" closed="false">१५:४ </char><char style="xt" closed="false"><ref loc="MAT 12:40">मत्तय १२:४०</ref>; <ref loc="ACT 2:24-32">प्रेषित २:२४-३२</ref></char></note>अनं त्याले पुरामा वनं धर्मशास्त्रप्रमाणे तिसरा दिन ऊठना. <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" /><note caller="+" style="x"><char style="xo" closed="false">१५:५ </char><char style="xt" closed="false"><ref loc="LUK 24:34">लूक २४:३४</ref>; </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्तय २८:१६</ref>,<ref loc="MAT 28:17">१७</ref>; <ref loc="MRK 16:14">मार्क १६:१४</ref>; <ref loc="LUK 24:36">लूक २४:३६</ref>; <ref loc="JHN 20:19">योहान २०:१९</ref></char></note>अनी तो पेत्रले अनं बारा जणसले दिसना; <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />मंग तो पाचशेसपेक्षा जास्त ईश्वासु दिसनात; त्यानामातीन बराच आजपावत जिवत शे, पण काहीजण मरी गयात. <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />त्यानानंतर तो याकोबले, मंग सर्व प्रेषितसले दिसना; <verse eid="1CO 15:7" /><verse number="8" style="v" sid="1CO 15:8" /><note caller="+" style="x"><char style="xo" closed="false">१५:८ </char><char style="xt" closed="false"><ref loc="ACT 9:3-6">प्रेषित ९:३-६</ref></char></note>अनी जणु काय दिन भराना पहिलेच जन्मलेला जो मी त्या मला सर्वासना शेवट दिसना. <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" /><note caller="+" style="x"><char style="xo" closed="false">१५:९ </char><char style="xt" closed="false"><ref loc="ACT 8:3">प्रेषित ८:३</ref></char></note>कारण प्रेषितसमा मी धाकला शे; मी प्रेषित म्हणी लेवाना बी लायक नही, कारण मी देवनी मंडळीना छळ करा. <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />तरी जो काही मी शे. तो देवना कृपातीन शे; अनी मनावर त्यानी जी कृपा ती व्यर्थ व्हयनी नही; कारण त्या सर्वासपेक्षा मी खुप कष्ट करात. त्या मी करात अस नही, तर मनासंगे राहणारी देवनी कृपानी करात. <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />म्हणीन, जर मी राहो, का त्या राहोत, आम्हीन अशी च घोषणा करतस, अनी यानावरच तुम्हीन ईश्वास ठेवा.<verse eid="1CO 15:11" /></para>
  <para style="s">आमनं जिवत व्हनं</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />आते येशु ख्रिस्त मरेल मातीन ऊठेल शे अशी त्यानाबद्दल घोषणा व्हई राहीनी, तर मरेलसनं पुनरूत्थान व्हस नही, अस तुमनातीन कित्येक जण कसं म्हणतस? <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />जर मरेलसनं पुनरूत्थान व्हस नही, तर ख्रिस्त बी ऊठना नही; <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />अनी ख्रिस्त ऊठना नही तर आमनी घोषणा बी व्यर्थ अनं तुमना ईश्वास बी व्यर्थ <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />अनी आम्हीन देवबद्दल खोटी साक्ष अस व्हयनुत; कारण देवबद्दल आम्हीन अशी साक्ष दिधी की त्यानी ख्रिस्तले ऊठाडं; पण जर मरेलसले ऊठाडामा नही येस तर त्यानी त्याले ऊठाडं नही. <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />मरेलसले ऊठाडामा नही येस तर ख्रिस्तले बी ऊठाडामा नही वनं <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />ख्रिस्त ऊठना नही तर तुमना ईश्वास निष्फळ शे; तुम्हीन अजुन तुमना पापमा शेतस; <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />मंग तर त्या बी ज्या ख्रिस्तमा मरणात त्यासना नाश व्हयना. <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />जर आम्हीन फक्त ह्याच जिवनमा ख्रिस्तमा आशा धरेल शे तर मंग सर्व माणससपेक्षा आपण लाचार शेतस.<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />तरी बी ख्रिस्त तर मरेलस मातीन ऊठाडेल शे, अनं ज्या झोपेल शेतस त्यासनामातीन तो पहिलं फळ शे. <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />एक माणुसकडतीन मरण वनं, म्हणीसन एकच माणुसकडतीन मरेलसनं पुनरूत्थान बी शे. <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />जसं आदामनी सर्वासवर मरण आनं, तसं ख्रिस्तमा सर्वासले जिवत करामा ई. <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />पण प्रत्येक आपआपला कामप्रमाणे; पहिले ख्रिस्त मरेल मातीन ऊठना; मंग ख्रिस्तना येवाना येळले ज्या त्यानावर ईश्वास करतीन त्या लोके जिवत व्हतीन. <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />यानानंतर शेवट व्हई, तवय शासन करनारा सर्व दुष्ट आत्मा, त्यासना सर्व अधिकार, अनं सामर्थ्य याना नाश ख्रिस्त करी अनी त्यानानंतर तो देवबापले राज्य सोपी दि. <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />कारण जोपावत ख्रिस्त सर्व शत्रुसले त्याना पायखाल आनावु नही, तोपावत त्याले राज्य करनंच शे. <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />शेवटना शत्रु जो मृत्यु तो नष्ट करामा ई. <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />कारण शास्त्र म्हणस “देवनी सर्व वश करीसन येशुना पायखाल ठेयं;” पण सर्व वश करेल शे अस जवय सांगं तवय, ज्यानी त्याले सर्व वश करी दिधं, पण त्या सर्वमा तो स्वतः नव्हता. <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />त्याले सर्वकाही वश व्हयना अस जवय व्हई तवय ज्यानी त्याले सर्व वश करी दिधं त्याले पोऱ्या बी स्वतः परमेश्वरले वश व्हई; याकरता की परमेश्वर सर्वासवर राज्य करी. <verse eid="1CO 15:28" /><verse number="29" style="v" sid="1CO 15:29" />अस नही तर मरेलसकरता ज्या बाप्तिस्मा लेतस त्या काय करतीन? जर मरेलसले ऊठाडामा नही येस तर त्यासनाबद्दल त्या बाप्तिस्मा का बर लेतस? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />आम्हीन प्रत्येक येळले संकटमा का बर पडतस? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />भाऊसवन अनी बहिणीसवन, तुमनाबद्दल जो गर्व माले ख्रिस्त येशु आपला प्रभुमा शे, त्यावरून मी म्हणस की, मी रोज रोज मरस; <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />इफिस गावमा मी जंगली जनावरसना मायक लोकससंगे मी लढाई करनु, ती मनुष्यना साधारण हेतुतीन करतु तर माले काय फायदा? मरेलसले ऊठाडामा येस नही, तर चला आपण खाऊत, पिऊत, कारण सकाय मरनच शे.<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />फसु नका, खराब संगतमा नीति बिघडस. <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />धार्मीकताबद्दल शुध्दीवर या, अनी पापले सोडा; कारण बराच जणसले देवबद्दल ज्ञान नही; तुमले लाज वाटाले पाहिजे म्हणीन मी हाई बोलस.<verse eid="1CO 15:34" /></para>
  <para style="s">परत जिवत व्हनारासनं शरीर</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />आते कोणी सांगी, मरेल कशा ऊठाडाई जातस, अनं त्या कोणता प्रकारना शरीरतिन येतस? <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />अरे बिनबुध्दीना माणुस, जे तु पेरस ते मरस नही तोपावत जिवत नही व्हस. <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />अनी तु जे पेरस तर त्याना फक्त दाणा पेरस, पुरं रोपटं नही, मंग तो गहुना राहो का दुसरा कसाना बी राहो; <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />देव त्याना ईच्छानुसार त्याले त्यानं शरीर देस; म्हणजे प्रत्येक बीले स्वतःनं योग्य शरीर देस. <verse eid="1CO 15:38" /><verse number="39" style="v" sid="1CO 15:39" />सर्व शरीर मायकच नहीत; तर माणुसनं शरीर हाऊ एक प्रकार, प्राणीसनं शरीर हाऊ एक प्रकार अनं मासासनं शरीर हाऊ एक प्रकार.<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />तसच स्वर्गना शरीर अनं जगना शरीर शेतस; पण स्वर्गवालासनं तेज एक, अनं जगवालासनं तेज एक. <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />सूर्यनं तेज येगळं; चंद्रनं तेज येगळं; तारासनं तेज येगळं; तारातारासना तेजमा फरक शे.<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />तसं मरेलसन पुनरूत्थान शे, ते विनाशीपणमा पेराई जास; अविनाशीपणमा ऊठाडाई जास; <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />अपमानसंगे पुराई जास; गौरवमा ऊठाडाई जास; अशक्तपणमा पुराई जास, सामर्थ्यमा ऊठाडाई जास; <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />प्राणमय शरिरले असे पुराई जास; अध्यात्मिक शरिरले अस ऊठाडाई जास, जर प्राणमय शरीर शे, तर आध्यात्मिक शरीर शे. <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />तसाच शास्त्रलेख शे की, पहिला माणुस आदामले जिवत प्राणी अस बनाडं, शेवटला आदाम जिवन देणारा आत्मा शे. <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />तरी ज्या अध्यात्मिक त्या पहिला नहीत; शारिरीक त्या पहिला शेतस, त्यानानंतर ज्या अध्यात्मिक त्या शेतस. <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />पहिला माणुस आदाम मातीना शे, दुसरा माणुस स्वर्गपाईन शे. <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />तो जशा मातीना व्हता तसा ज्या मातीना त्या बी शेतस; अनी तो स्वर्ग माधला जशा शे तसच ज्या स्वर्ग माधला त्या बी शेतस; <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />अनी जो माटिना त्यानं शरीर जसं आपण धारण करं, तस जो स्वर्ग माधला त्यानं बी रूप धारण करसुत. <verse eid="1CO 15:49" /><verse number="50" style="v" sid="1CO 15:50" />भाऊ अनं बहिणीसवन मी अस म्हणस की, मांस अनं रंगत ह्यासले देवना राज्यमा प्रवेश मिळु शकस नही; अनी विनाशीपणले अविनाशीपणमा प्रवेश मिळु शकस नही <verse eid="1CO 15:50" /><verse number="51" style="v" sid="1CO 15:51" /><note caller="+" style="x"><char style="xo" closed="false">१५:५१ </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">१ थेस्सलनी ४:१५-१७</ref></char></note>मी तुमले एक गुप्त गोष्ट सांगस; आपण सर्वाच मराऊत नही, पण आपण सर्व बदली जासुत, <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />क्षणमा, शेवटला कर्णाना येळले कर्णा वाजी, मरेल त्या अविनाशी शरिरमा असा ऊठतीन, अनी आपण बदली जाऊत, कारण हाई जे विनाशी त्यानी अविनाशीपण परिधान करानं. <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />अनी हाऊ जो मृत शरीर शे त्यानी अमरत्व परिधान कराले पाहिजे हाई आवश्यक शे. <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />अस जो शास्त्रलेख पुर्ण व्हई, हाई जो विनाशी त्यानी अविनाशीपण परिधान करा, अनी हाई जो मर्त्य त्यानी अमरत्व परिधान करा, अस जवय व्हई, “तवय मरणना नाश व्हईसन; विजय हाऊ पुर्ण व्हयना!” <verse eid="1CO 15:54" /><verse number="55" style="v" sid="1CO 15:55" />“अरे मरण, तुना जिंकणं कोठे शे? अरे मरण, तुना नांगा कोठे शेतस?” <verse eid="1CO 15:55" /><verse number="56" style="v" sid="1CO 15:56" />मरणना नांगा पाप; अनी पापनं बळ मोशेना नियम शेतस, <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />तरी जो देव आपला प्रभु येशु ख्रिस्त कडतीन आपलाले जिंकाडस त्यानी स्तुती असो. <verse eid="1CO 15:57" /><verse number="58" style="v" sid="1CO 15:58" />यामुये मना प्रिय भाऊ अनी बहिणीसवन, प्रभुमा तुमनं कष्ट व्यर्थ नही, हाई तुमले माहीत शे, म्हणीसन तुम्हीन स्थिर रहा, टिकी रहा, अनी प्रभुना काममा कायम वाढत जा.<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">यरूशलेम आठला गोरगरीबसकरता जमाडेल दान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:१ </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:25">रोम १५:२५</ref>,<ref loc="ROM 15:26">२६</ref></char>
    </note>देवना लोकसकरता दान गोया कराबद्दल ज्या आज्ञा मी गलतीया गावमाधल्या मंडळीसले देयल शेतस, त्यासले तुम्हीन बी माना. <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />आठवडाना पहिला दिन तुम्हीन प्रत्येकनी जशा तुमले पैसा भेटणात तसा तुम्हीन काही पैसा गोया करीसन ठेवा म्हणजे मी येवावर तुमले गोया नही करनं पडाव. <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />अनं जवय मी येसु तवय ज्यासले तुम्हीन सांगशात त्यासले पत्र दिसन तुमनं दान यरूशलेमले देवाले धाडी दिसु. <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />जर माले वाटनं माले जावाले पाहिजे, तर त्या मनासंगे येतीन.<verse eid="1CO 16:4" /></para>
  <para style="s">पौलनी योजना</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:५ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:21">प्रेषित १९:२१</ref>
      </char>
    </note>पण मी मासेदोनियातीन तुमनाकडे ईसु, कारण मी मासेदोनीयामातीन जाणार शे, <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />पण कदाचित तुमनाकडे मी ऱ्हासु अनं कदाचित पुरा हिवाळाभर बी ऱ्हासु, ज्यामुये की जठे माले जाणं राही तठे तुम्हीन माले धाडी देशात. <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />कारण आते फक्त तुमले भेटी जावानं अशी मनी ईच्छा नही; तर प्रभुनी ईच्छा राहीनी तर मी काही दिन तुमना जोडे ऱ्हासु अशी आशा शे.<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:८ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:8-10">प्रेषित १९:८-१०</ref>
      </char>
    </note>तरी पन्नासावा दिनना सणपावत मी इफिस गावमा ऱ्हासु. <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />कारण मनाकरता तठे प्रभावशाली काम कराना एक मोठा दरवाजा उघडेल शे, अनी विरोध करनारा बराच शेतस.<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:१० </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:17">१ करिंथ ४:१७</ref>
      </char>
    </note>जर तीमथ्य वना तर लक्ष राहु द्या की, तो तुमनासंगे नही घाबरता ऱ्हावाले पाहिजे, कारण तो बी मनामायक देवनं कामकरी राहीना. <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />यामुये कोणी त्याले तुच्छ मानाले नको, तर त्यानी मनाकडे येवाले पाहिजे म्हणीन त्याले सुखरूप धाडी द्या; कारण मी त्यानी भाऊससंगे येवानी वाट दखी राहीनु. <verse eid="1CO 16:11" /><verse number="12" style="v" sid="1CO 16:12" />आपला भाऊ अपुल्लोस ह्यानी भाऊससंगे तुमनाकडे येवाले पाहिजे म्हणीन मी त्याले प्रोत्साहन दिधं, पण हाई येळले त्यानी ईच्छा नव्हती; तरी बी येळ भेटावर तो ई.<verse eid="1CO 16:12" /></para>
  <para style="s">शेवटला शब्द</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />सावध रहा, ईश्वासमा स्थिर रहा, मर्दमायक वागा; खंबीर रहा. <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />तुमना सर्व कामे प्रेमतीन व्हवाले पाहिजे.<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:१५ </char>
      <char style="xt" closed="false">
        <ref loc="1CO 1:16">१ करिंथ १:१६</ref>
      </char>
    </note>भाऊ अनी बहिणीसवन, तुमले स्तेफनना घराणानी माहीती शे, ते अखयानं पहिलं फळ शे अनी त्यासनी आपलामा पवित्र लोकसनी सेवाले वाही देयल शे. <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />मनी तुमले ईनंती शे की, तुम्हीन असा लोकसले धरी रहा, अनी असा प्रत्येकले जो कोणी ह्या सेवामा मदत अनं कष्ट करस.<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />स्तेफना, फर्तूनात अनं अखायिक ह्या येवावर माले आनंद व्हयना; कारण तुम्हीन नव्हतात त्यानी कमी त्यासनी पुर्ण करी. <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />त्यासनी मना अनं तुमना आत्माले शांतता देयल शे; असासले तुम्हीन मान देवाले पाहिजे.<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">१६:१९ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">प्रेषित १८:२</ref>
      </char>
    </note>आशियान्या मंडळ्या तुमले नमस्कार सांगतस, अक्विला अनं प्रिस्किल्ला अनं त्यासना घरमा ज्या मंडळ्या गोया व्हतस त्या बी तुमले प्रभुमा मनपाईन नमस्कार सांगतस. <verse eid="1CO 16:19" /><verse number="20" style="v" sid="1CO 16:20" />सर्व ईश्वासु भाऊसना तुमले नमस्कार सांगतस, पवित्र अलींगन दिसन एकमेकसले नमस्कार करा.<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />मी पौलनी स्वतःना हाततीन लिखेल नमस्कार.<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />जर कोणी प्रभुवर प्रिती नही करस तर त्याले हाय लागो. मारानाथा म्हणजे आमना प्रभु ये!<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />प्रभु येशुनी कृपा तुमनासंगे राहो.<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />ख्रिस्त येशुमा मनं प्रेम तुमना सर्वाससंगे राहो. आमेन.<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>