<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Ahirani</book>
  <para style="h">१ पेत्र</para>
  <para style="toc3">१ पेत्र</para>
  <para style="toc2">१ पेत्र</para>
  <para style="toc1">पेत्रनी लिखेल पहिलं पत्र</para>
  <para style="mt2">पेत्राने लिहिलेले पहिले पत्र</para>
  <para style="mt1">पेत्रनी लिखेल पहिलं पत्र</para>
  <para style="imt">वळख</para>
  <para style="ip">१ पेत्र, हाई पुस्तक प्रेषित पेत्र यानी लिखेल व्हतं. पेत्रनी हाई सांगीसन आपला पत्रनी सुरवात करी की, तो कोण शे अनी कोणाकरता लिखी राहीना. त्यानी गैरयहूदी म्हणेल सर्व ख्रिस्ती लोकसले पत्र धाडीसन सुचना कऱ्यात. <char style="xt"><ref loc="1PE 1:1">१:१</ref>; <ref loc="1PE 1:17">१:१७</ref></char> अनी <char style="xt"><ref loc="1PE 2:11">२:११</ref></char> त्यानी आपला वाचकसले असा बराचदाव संदर्भ दिधा, कारण त्या येगयेगळा दिशामा पसरेल व्हतात. कारण हाई पत्र थोडफार इफिसकरसले पौलनी लिखेल पत्रसनामायक शे. बराच लोकसना असा ईश्वास शे की, १ पेत्र हाई पुस्तक ख्रिस्तना जन्मनंतर जवळपास ६५ वरीस नंतर इफिसना लोकसले लिखामा वनं. पेत्रनी रोमले पत्र लिखं त्याले तो बाबेल म्हणे. <char style="xt"><ref loc="1PE 5:13">५:१३</ref></char></para>
  <para style="ip">पेत्र सांगस की, त्यानी तुमले प्रोत्साहन देणारं अनी हाईच देवनं खरं तारण शे हाई सिध्द कराकरता हाई पत्र लिखेल शे. <char style="xt"><ref loc="1PE 5:12">५:१२</ref></char> <char style="xt"><ref loc="1PE 2:11">१ पेत्र २:११</ref>; <ref loc="1PE 3:7">३:७</ref></char>; अनं <char style="xt"><ref loc="EPH 5:18-6:9">इफिस ५:१८–६:९</ref>; <ref loc="COL 3:18">कलस्सै ३:१८</ref>; <ref loc="COL 4:6">४:६</ref>;</char> यासनामा बरीच समानता शे. या सर्व तीन भागसमा कौटुंबिक नातेसंबध अनी अधिकाऱ्यासनी आज्ञा पाळानी सुचना देवानी अस तो सांगस. तो ईश्वासनारासले दुःखना काळमा त्यासले प्रोत्साहन दिधं की शेवटना काळ जवळ येल शे. <char style="xt"><ref loc="1PE 4:1">४:१</ref></char></para>
  <para style="iot">रूपरेषा</para>
  <para style="io1">१. पेत्र स्वतःनी वळखं करी देस, अनी त्याना वाचणारासले संबोधित करस. <char style="ior"><ref loc="1PE 1:1-2">१:१-२</ref></char></para>
  <para style="io1">२. मंग तो देवना तारणकरता आभार मानस अनी त्याना त्यासना जिवनकरता काय अर्थ शे, हाई सर्वासले सांगस. <char style="ior"><ref loc="1PE 1:3-2:10">१:३–२:१०</ref></char></para>
  <para style="io1">३. पुढे तो ईश्वास ठेवस की, जगमा चांगलं कसं ऱ्हावानं अनी नवरा अनं बायको अनी दास अनं मालक यासना येगयेगळा संबधले संबधीत करस. <char style="ior"><ref loc="1PE 4:12-5:11">४:१२–५:११</ref></char></para>
  <para style="io1">४. नंतर जवय पीडीत लोकेसले त्रास देवामा वना, तवय त्यासले धीर दिसन प्रोत्साहन करस. <char style="ior"><ref loc="1PE 4:12-5:11">४:१२–५:११</ref></char></para>
  <para style="io1">५. त्यानानंतर त्यानी आपला पत्रनी समाप्ती करी. <char style="ior"><ref loc="1PE 5:12-14">५:१२-१४</ref></char></para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />येशु ख्रिस्तना प्रेषित पेत्र याना कडतीन; देवबापनी निवडेल पंत, गलतीया, कप्पदुकिया, आशिया अनं बिथुनिया या गावसमा पांगेल यहूदी लोकेसमा राहणारा, <verse eid="1PE 1:1" /><verse number="2" style="v" sid="1PE 1:2" />देवपिताना पुर्वज्ञानतीन, आत्मानाद्वारा व्हयेल पवित्रतामा टिकीन ऱ्हावाकरता अनं त्यावर येशु ख्रिस्तना रक्तनं सिंचन व्हवाकरता निवाडेल प्रवाशी, यासले तुमले कृपा अनी शांती भरभरीन मिळो.<verse eid="1PE 1:2" /></para>
  <para style="s">जिवननी आशा</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />आमना प्रभु येशु ख्रिस्तना देव अनी पिताना गौरव व्हवो, ज्यानी येशु ख्रिस्तले मरेलस मातीन जिवत करीसन अनी आपली मोठी दयातीन आमले जिवत आशाकरता नवा जन्म दिधा. <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />की, तो वारसा प्राप्त कराले पाहिजे जो अविनाशी, निष्कलंक अनी निर्मळ शे अनी तुमनाकरता स्वर्गमा ठेयल शे. <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />तुमनी रक्षा परमेश्वरना सामर्थ्यना द्वारा ईश्वासतीन त्या तारणकरता कराई जास, जे शेवटना काळले प्रकट व्हनार शे. <verse eid="1PE 1:5" /><verse number="6" style="v" sid="1PE 1:6" />तुम्हीन तारणबद्दल आते आनंद करतस जरी थोडा येळपावत, बराच परिक्षासमा पडीन तुम्हीन दुःख भोगात. <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />तुम्हीन यानाकरता भोगं की, तुमना ईश्वास खरा शे हाई पारखाई जावं, जश नाशवंत सोनं पारखाई जास त्या सोनापेक्षा तुमना ईश्वास मुल्यवान शे यामुये तो बी पारखाई जाईन तो शुध्द असा निंघो ज्यामुये प्रशंसा, गौरव अनं मान ह्या फळं येशु ख्रिस्तना प्रकट व्हवाणा येळेले तुमले मिळतीन. <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />त्याले तुम्हीन दखं नही तरी तुम्हीन त्यानावर प्रेम करतस; आते तो दखास नही, तरी त्यानावर ईश्वास ठेवतस; म्हणजे तुम्हीन गौरवतीन मोठा आनंद करतस जो शब्दसमा नही सांगता येस. <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />अनी त्यानामा तुमनं ईश्वास कराना उद्देश म्हणजे तुमले तुमना जिवनं तारण मिळेल शे, <verse eid="1PE 1:9" /><verse number="10" style="v" sid="1PE 1:10" />ज्या संदेष्टासनी तुमनावर होणारी कृपाबद्दल भविष्य करं, त्यासनी त्या तारणबद्दल बारकाईतीन शोध करा; <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />त्या भविष्यवक्तासनी ख्रिस्तवर येणारा दुःखनी येळ अनी तो गौरव जो या दुःखनंतर प्रकट व्हई याना शोध ख्रिस्तना आत्माघाई करा जो त्यासनामा व्हता. <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />त्यासले अस प्रकट करामा येल व्हतं की स्वर्गामातीन धाडेल पवित्र आत्माघाई तुमले सुवार्ता सांगणारासनी ज्या गोष्टी तुमले आते सांगेल शेतस त्याच गोष्टी सांगानी सेवा त्या करी राहींतात; ती सेवा स्वतःकरता नही, तर तुमनाकरता करी राहींतात; या गोष्टी लक्ष लाईन दखानी तीव्र ईच्छा देवदूतसले शे.<verse eid="1PE 1:12" /></para>
  <para style="s">पवित्र जिवन जगाकरता बलवणं</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />यामुये तुमनं मन कृतीकरता तयार करा, अनी सावध राहिन येशु ख्रिस्तनं प्रकटीकरण व्हवाना येळले तुमले मिळणारी कृपावर पुर्ण आशा ठेवा. <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />तुम्हीन आज्ञाधारक पोऱ्या व्हा अनी अज्ञान व्यवस्थामातील आपला पूर्वीना वासनाना मायक वागु नका; <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />तर ज्यानी तुमले पाचारण करं तो जशा पवित्र शे तस तुम्हीन पण सर्व प्रकारनी वागणुकमा पवित्र रहा. <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />कारण, “मी पवित्र शे यामुये तुम्हीन पवित्र व्हा” असा शास्त्रलेख शे. <verse eid="1PE 1:16" /><verse number="17" style="v" sid="1PE 1:17" />जो तोंड नही दखता प्रत्येकना कामप्रमाणे त्याना न्याय करस, त्याले जर तुम्हीन पिता म्हणीन हाक मारतस, जवय तुम्हीन प्रार्थना करतस तर आपला प्रवासना काळमा घाबरीन वागा. <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />तुमना पुर्वजसंना परंपरातीन चालत येल आपला व्यर्थ वागणुकपाईन सोनं, रूपं असा नाश होणारा वस्तुसपाईन नही, <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />तर निष्कलंक अनं निर्दोष कोकरा, असा जो ख्रिस्त, त्याना मुल्यवान रक्तघाई तुम्हीन मुक्त व्हयेल शेतस ह्या ध्यानमा ठेवा, <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />जगनी स्थापना व्हवाना पहिले त्याले देवनी निवडेल व्हतं अनी तोच काळना शेवट तुमनाकरता प्रकट व्हयना. <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />तुम्हीन त्यानाघाई देववर ईश्वास ठेवणारा व्हयेल शेतस; त्या देवनीच त्याले मृतअवस्थामातीन ऊठाडीन त्यानं गौरव करं, यामुये तुमना ईश्वास अनं आशा देववर शे. <verse eid="1PE 1:21" /><verse number="22" style="v" sid="1PE 1:22" />सत्यनं पालन करत खरं बंधुप्रेम दखाडाकरता तुम्हीन आपला आत्माले शुध्द करी लेयल शे, म्हणीन आते एकमेकसवर मनपाईन प्रेम करा. <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />कारण तुम्हीन नाश व्हणारा बीयापाईन नही, तर अविनाशी बीयापाईन म्हणजे देवना कायम जिवत राहणारं अनं टिकणारं वचनघाई परत जन्म लियेल शे. <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" /><note caller="+" style="f"><char style="fr" closed="false">1:24 </char><char style="ft" closed="false">या वचनबद्दल यशया 40:6 मा लिखेल शे</char></note>कारण, सर्व मानवजात गवतसारखी शे; अनी तिनं सर्व गौरव गवतना फुलमायक शे. गवत सुकस अनं त्यानं फुल गळस; <verse eid="1PE 1:24" /><verse number="25" style="v" sid="1PE 1:25" />पण प्रभुनं वचन सर्वकाळ टिकस. जी सुवार्ता तुमले घोषीत करेल व्हती ती सुवार्ता म्हणजे हाईच ते वचन.<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="s">जिवत दगड अनी पवित्र राष्ट्र</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />यामुये सर्व दुष्टभावना, सर्व कपट, ढोंग, हेवा अनं सर्व वाईट भाषण सोडी द्या, <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />नविन जन्मेल पोऱ्यासना मायक, कायम शुध्द आध्यात्मिक दुधबद्दल तहान लागेल असा रहा म्हणजे तुम्हीन वाढशात अनं तुमनं तारण व्हई. <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" /><note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">स्तोत्र. 34:8 </char></note>“प्रभु कृपाळु शे याना तुम्हीन अनुभव लेयल शे” अस शास्त्रलेख म्हणस.<verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />माणससनी नाकारेल तरी देवना दृष्टीतीन निवडेल अनं मुल्यवान असा जो जिवत दगड त्यानाजोडे येवामुये, <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />तुम्हीन बी अध्यात्मिक मंदिर, जिवत दगड, देवले आवडणारा असा आध्यात्मिक स्वरूपना यज्ञ येशुख्रिस्तघाई अर्पण कराकरता पवित्र याजकगण असा रचाई जाई राहिनात. <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" /><note caller="+" style="f"><char style="fr" closed="false">2:6 </char><char style="ft" closed="false">यशया. 28:16 </char></note>कारण असा शास्त्रलेख शे; “दखा, निवडेल, मूल्यवान अशी कोनशीला मी सियोनमा बसाडस; तिनावर ईश्वास ठेवणारा कवय बी फजित व्हवाऊ नही.” <verse eid="1PE 2:6" /><verse number="7" style="v" sid="1PE 2:7" />यामुये तुमले ईश्वास ठेवणारासले मान भेटी; ज्या ईश्वासले अमान्य शेतस त्यासले, “बांधणारासनी नापसंत करेल दगड तोच मुख्य कोणशीला व्हयना.” <verse eid="1PE 2:7" /><verse number="8" style="v" sid="1PE 2:8" />“अनी ठेच लागणारा दगड अनं आडफाटा व्हवाणा खडक असा व्हयना; त्या लोके वचनले नही मानतस म्हणीन ठेच खातस,” त्यानाकरता त्यासले नेमेल पण व्हतं. <verse eid="1PE 2:8" /><verse number="9" style="v" sid="1PE 2:9" /><note caller="+" style="x"><char style="xo" closed="false">२:९ </char><char style="xt" closed="false"><ref loc="TIT 2:14">तिताले पत्र २:१४</ref></char></note><note caller="+" style="f"><char style="fr" closed="false">२:९ </char><char style="ft" closed="false">निर्गम. १९:५-६</char></note>तुम्हीन तर निवडेल वंश, राजकीय याजकगण, पवित्र राष्ट्र, देवना स्वतःना लोक असा शेतस; यानाकरता की ज्यानी तुमले अंधारमातीन काढीन आपला अद्भुत प्रकाशमा पाचारन करं त्याना गुण तुम्हीन प्रसिध्द कराले पाहिजे. <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />त्या तुम्हीन पहिले लोक नव्हतात<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="fq" closed="false">लोक नव्हतात </char><char style="ft" closed="false">म्हणजे त्या लोकसले कोणतीच वळख नव्हती</char></note>, आते तर देवना लोक शेतस; तुमले दया मिळेल नव्हती, आते तर दया मिळेल शे. <verse eid="1PE 2:10" /><verse number="11" style="v" sid="1PE 2:11" />प्रिय भाऊ अनं बहिणीसवन, ज्या तुम्हीन परका अनं अनोळखी शेतस त्या तुमले मी ईनंती करस की, जिवसंगे लढाई करनारा शारिरीक वासनांपाईन दुर रहा; <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />गैरयहूदी लोकसमा आपली वागणुक चांगली ठेवा, यानाकरता की, ज्यानाबद्दल त्या तुमले वाईट कामं करनारा समजीन तुमना विरूध्द वाईट बोलतस त्याबद्दल त्यासनी तुमना चांगला कामे दखीन बातमीना दिनले देवनं गौरव कराले पाहिजे.<verse eid="1PE 2:12" /></para>
  <para style="s">देवना सेवक</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />मनुष्यनी स्थापन करेल प्रत्येक व्यवस्थाले प्रभुकरता अधीन ऱ्हावा; राजा श्रेष्ठ शे म्हणीन त्याना अधीन ऱ्हावा; <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />अनी अधिकारी वाईट करनारासले शिक्षा देवाकरता अनं चांगलं करनारासनी स्तुती कराकरता देवनी धाडेल शे, म्हणीसन त्यासना अधीन रहा. <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />देवनी ईच्छा अशी शे की, तुम्हीन चांगलं करशात त्याघाई निर्बुध्द माणससना अज्ञानले कोंडी ठेवानं. <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />आपला स्वतंत्रपणा हाई दुष्टपणानं झाकीन नही ठेवता तुम्हीन स्वतंत्र, तरी देवना दास, अस रहा. <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />सर्वासले मान द्या, ईश्वासु लोकसवर प्रेम करा, देवना भय धरा. राजाले मान द्या.<verse eid="1PE 2:17" /></para>
  <para style="s">ख्रिस्तनं दुःखनं उदाहरण</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />घरना नोकरसवन, तुम्हीन आपला मालकना अधीन रहा; ज्या चांगला अनं नम्र फक्त त्यासनाच नही, तर ज्या कठोर त्यासले बी पुरं घाबरीन रहा. <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />कोणी देवनं नाव लिसन अन्यायतीन येल दुःखं सहन करतस तर हाऊ प्रशंसा करासारखं शे. <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />चुकीनं करामुये मिळेल बुक्क्या शांततातीन सहन करात त्यामा काय मोठी किर्ती? चांगलं करी राहिनात तरी दुःख भोगणं अनं ते शांतीतिन सहन करनं हाई देवले योग्य अस वाटी. <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />यानाकरताच तुमले पाचारण करेल शे; तुम्हीन त्याना पायासनं अनुकरण कराले पाहिजे म्हणीन ख्रिस्तनी दुःख सहन करीसन तुमनाकरता कित्ता घाली ठेल शे; <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />त्यानी पाप करं नही, अनी त्याना चेहरावर कपट दिसनं नही; <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />त्यानी निंदा व्हई राहिंती तवय त्यानी उलट निंदा करी नही; दुःख सहन करी राहिंता तवय त्यानी धमकी दिधी नही; तर सर्व न्याय करनारा परमेश्वरवर आपली आशा ठेवा. <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />तो स्वतः तुमना आमना पापं स्वतःना शरिरवर वाहिन क्रुसखांबवर लई गया, यानाकरता की आपण पाप बद्दल मृत व्हईन न्यायीपणकरता जिवत ऱ्हावानं; त्याले बशेल मारना फटकामुये तुम्हीन निरोगी व्हयेल शेतस. <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />तुम्हीन मेंढरसनामायक भटकी राहींतात; पण आते तुमना जिवना मेंढपाळ अनं राखणारा यानाकडे मागे फिरेल शेतस.<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">नवरा अनं बायको</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">३:१ </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">इफिस ५:२२</ref>; <ref loc="COL 3:18">कलस्सै ३:१८</ref></char>
    </note>बायासवनं, तुम्हीन तसच आपआपला नवरासना अधीन रहा; यानाकरता की कोणी वचनले अमान्य राही, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />कारण त्या दखतीन तुमनी वागणुक कशी शुध्द अनी भक्तीपूर्ण शे. <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" /><note caller="+" style="x"><char style="xo" closed="false">३:३ </char><char style="xt" closed="false"><ref loc="1TI 2:9">१ तिमथ्य २:९</ref></char></note>तुमनी शोभा केससनं गुंफणं, सोनाना दागीना घालणं, किंवा कपडा घालणं यासनाघाई बाहेरतीन आणेल नही ऱ्हावाले पाहिजे; <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />तर जो नम्र अनं शांत आत्मा देवना दृष्टीतीन बहुमूल्य शे त्यानी, म्हणजे अंतःकरणमाधली जी अविनाशी शोभा ती ऱ्हावाले पाहिजे. <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />याप्रमाणे पुर्वी, देववर आशा ठेवणाऱ्या भक्तीमान बायासनी बी आपापल्या नवरासना अधीन राहिसन स्वतःले सुंदर दखाडं <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />जशी सारा आपला नवरा अब्राहामले धनी म्हणीन त्याना आज्ञामा राहिनी; तस तुम्हीन चांगलं करशात अनं कोणती बी भयप्रद गोष्टले नही घाबरशात, तर तुम्हीन सारान्या पोरी बनशात <verse eid="1PE 3:6" /><verse number="7" style="v" sid="1PE 3:7" /><note caller="+" style="x"><char style="xo" closed="false">३:७ </char><char style="xt" closed="false"><ref loc="EPH 5:25">इफिस ५:२५</ref>; <ref loc="COL 3:19">कलस्सै ३:१९</ref></char></note>तसच, माणससवनं तुम्हीन आपला बायकाससंगे, योग्य समजदारपणातीन वागा कारण त्या तुमनापेक्षा जास्त नाजुक शेतस. त्यासले मान दया म्हणजे त्यासले बी तुमनासंगे देवनं जिवनरूपी कृपादान मिळी अनं तुमना प्रार्थनासले आडफाटा येवाऊ नही.<verse eid="1PE 3:7" /></para>
  <para style="s">चांगलं करतांना भेटणारा त्रास</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />सारांश, तुम्हीन सर्व एकचित्त, अनं समान भावना; एकमेकसवर प्रेम करनारा, दयाळु, नम्र मनना असा व्हा. <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />वाईटबद्दल वाईट, शापनाबद्दल शाप देवु नका; तर उलट आशिर्वाद द्या; आशिर्वाद हाई वतन मिळावाकरता तुमले पाचारण करामा येल शे. <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />कारण शास्त्र म्हणस;</para>
  <para style="q1" vid="1PE 3:10">“जर तुमले जिवनमा आनंद कराना शे</para>
  <para style="q2" vid="1PE 3:10">अनं चांगली येळ दखानी ईच्छा शे,</para>
  <para style="q2" vid="1PE 3:10">तर तुम्हीन वाईट बोलानापाईन</para>
  <para style="q2" vid="1PE 3:10">अनं खोट बोलानापाईन आपली जिभ सांभाळा.<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />त्यानी वाईटना त्याग करीसन चांगलं ते करानं;</para>
  <para style="q2" vid="1PE 3:11">त्यानी पुर्ण मनतीन शांती प्राप्त कराना प्रयत्न कराना.<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />कारण परमेश्वरना डोया धार्मीकसवर राहतस,</para>
  <para style="q2" vid="1PE 3:12">अनं त्याना कान त्याना प्रार्थनाकडे राहतस;</para>
  <para style="q2" vid="1PE 3:12">तरी वाईट करनारासकडे देव पाठ करी लेस.”<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />जर तुम्हीन चांगला गोष्टीस कराकरता तयार शेतस तर तुमनं वाईट करनारा कोण? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" /><note caller="+" style="x"><char style="xo" closed="false">३:१४ </char><char style="xt" closed="false"><ref loc="MAT 5:10">मत्तय ५:१०</ref></char></note>अनी जर तुमले धार्मीकपणाबद्दल दुःख सहन करना पडनात, तरी तुम्हीन धन्य; त्यासना भयतीन भिऊ नका अनं घाबरू नका; <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />तर ख्रिस्त प्रभु यानं भय धरीसन मनमा आदर ठेवा; अनी तुमनामा जी आशा शे तिनी ईचारपुस करनारा प्रत्येक माणुसले उत्तर देवाले कायम तयार रहा; तरी ते नम्रतातीन अनं नही घाबरता द्या. <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />ते सदभावतीन द्या; यानाकरता की ज्याबद्दल निंदा व्हस, त्याबद्दल ख्रिस्तमाधली तुमनी चांगली वर्तणुकवर आळ लेणारासनी लज्जित व्हवाले पाहिजे. <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />चांगलं करीसन बी दुःख सहन करानं हाई जर देवनी ईच्छा व्हई तर, वाईट करीसन दुःख सहन करापेक्षा ते बर शे. <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />कारण आपलाले परमेश्वरजोडे लई जावाकरता ख्रिस्तनी बी पापसकरता, म्हणजे नितीमान माणुसनी अनितीमान लोकसकरता एकदाव मरना; तो शरिरना रूपतीन माराई गया अनी अध्यात्मिकपणतीन जिवत कराई गया; <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />त्या आत्माना रूपतीन त्यानी जाईन बंदिशाळामाधला आत्माजोडे घोषणा करी. <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />ह्याच त्या आत्मा व्हतात ज्यासनी नोहाना दिनसमा देवना अपमान करा, ते तारू तयार व्हई राहींत तवय देवनी सहनशीलता वाट दखी राहिंती; तारूमा थोडाच म्हणजे आठ प्राणी पाणीमाईन वाचाडामा वनतात. <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />ते चिन्ह बाप्तिस्माना मायक शे, त्यानाघाई शरिरना मळ दुर कराना नही, तर चांगलं मन ठेवाकरता देवसंगे करार करनं हाई व्हतं; ते तो आते येशु ख्रिस्तना पुनरूत्थानघाई तुमले वाचाडी राहिना. <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />येशु स्वर्गमा जाईसन देवना उजवीकडे बसेल शे; अनी स्वर्गदूत अनी स्वर्गीय अधिकारी अनी सत्ताधीश<note caller="+" style="f"><char style="fr" closed="false">3:22 </char><char style="fq" closed="false">सत्ताधीश </char><char style="ft" closed="false">आकाशमातील दुष्ट आत्मा</char></note><note caller="+" style="x"><char style="xo" closed="false">३:२२ </char><char style="xq" closed="false">सत्ताधीश </char><char style="xt" closed="false"><ref loc="EPH 6:12">इफिस ६:१२</ref>; <ref loc="DAN 10:12">दानीएल १०:१२</ref>,<ref loc="DAN 10:13">१३</ref> </char></note> या त्याना अधीन शेतस.<verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">बदलेल जिवन</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />ख्रिस्तनी शरिरना रूपमा दुःख सहन करात तसच तुम्हीन बी त्याच मनोवृत्तीतीन भक्कम व्हा; कारण ज्यानी शरिरना रूपमा सहन करेल शे तो पापपाईन निवृत्त व्हयेल शे. <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />यानाकरता की तुम्हीन उरेल शारिरीक जिवन मनुष्यना वासनांप्रमाणे नही तर देवना ईच्छाप्रमाणे जगानं. <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />कारण गैरयहूदीसनी ईच्छातीन काम करनं अनी असभ्यता, वासनासनी अभिलाषा, रंगेलपणा, दारूड्या अनं अमंगळ मुर्तिपुजा यामा ऱ्हावामा जो काळ गया तितला पुरा शे; <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />तुम्हीन त्यासना ह्या जंगलीपणमा सहभागी व्हतस नही यानं त्यासले नवल वाटस अनी त्या तुमनी निंदा करतस. <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />जो जिवतसना अनी मरेलसना न्यायनिवाडा कराले तयार शे त्या देवले त्या हिशोब देतीन. <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />सुवार्ता मरेलसले बी सांगेल व्हती, यानंकरता की, मनुष्यनमायक त्यासना शरिरसंबंधतीन न्यायनीवाडा व्हवाले पाहिजे, पण त्यासनी आत्माप्रमाणे देवसंगे जगाले पाहिजे.<verse eid="1PE 4:6" /></para>
  <para style="s">देवना दानसना चांगला कारभारी</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />आते सर्वासना शेवट येल शे; यामुये मर्यादामा रहा, अनं प्रार्थना कराकरता तयार रहा; <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />एकमेकसवर एकनिष्ठातीन प्रेम करा; कारण प्रिती पापसले झाकी टाकस. <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />कुरकुर नही करता एकमेकसना पाहुणचार करा; <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />प्रत्येकले जसं कृपादान मिळेल शे तसं देवना येगयेगळ्या दानसना चांगला कारभारीनामायक ते एकमेकसनं चांगलं कराकरता वापरा. <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />भाषण देणारासनी आपण देवनं वचन सांगी राहिनुत अस बोलानं; सेवा करनारासनी, ती आपण देवनी पुरायेल शक्तीतीन करी राहिनुत, अशी करानी; यानाकरता सर्व गोष्टीसमा येशु ख्रिस्तद्वारा देवनं गौरव व्हवाले पाहिजे; गौरव अनं पराक्रम हाई युगानुयुग त्यानीच शेतस. आमेन.<verse eid="1PE 4:11" /></para>
  <para style="s">ख्रिस्तकरता दुःख सहन कराना हक्क</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />प्रिय भाऊ अनं बहिणीसवन, तुमना अग्नीपरिक्षाकरता संकट तुमनावर येल शे त्यानावरतीन आपलासंगे काही येगळं घडनं तर त्यानं नवल वाटू देऊ नका; <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />जसं जसं तुम्हीन ख्रिस्तना दुःखना वाटेकरी व्हयेल शेतस तवय आनंद करा; म्हणजे त्यानं गौरव प्रकट व्हवाना येळले तुम्हीन उल्लासतीन आनंद करशात. <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />ख्रिस्तना नावमुये तुमनी निंदा व्हवामुये तुम्हीन धन्य शेतस; कारण गौरवना आत्मा म्हणजे देवना आत्मा तुमनावर ई राहिना शे. <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />तरी खुण करनारा, चोर, दुष्कर्मी किंवा दुसरासना कामसमा ढवळाढवळ करनारा अस व्हईन दुःख भोगाले नको. <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />ख्रिस्ती म्हणीन कोणी दुःख सहन करस तर त्यानी लाजानं नही; त्या नावमुये देवनं गौरव करानं. <verse eid="1PE 4:16" /><verse number="17" style="v" sid="1PE 4:17" />देवना घरपाईन न्यायनिवाडानी सुरवात करानी येळ शे; अनी ती सुरवात पहिले आपलापाईन व्हयनी, तर देवना सुवार्ताना अपमान करनारासना परिणाम काय व्हई? <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />पवित्रशास्त्र हाई सांगस, “नितीमान माणुस जर कष्टतीन वाचस तर अनितीमान अनं पापी माणुसनं काय व्हई?” <verse eid="1PE 4:18" /><verse number="19" style="v" sid="1PE 4:19" />यामुयेच देवना ईच्छाप्रमाणे दुःख सहन करनारासनी चांगली कृती करत, आपण स्वतःले ईश्वासु उत्पन्नकर्ताले सोपी देवाना.<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">वडील लोके अनी तरूणसले संदेश</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />तुमनामाधला वडील लोके शेतस, मी त्यासनामायक वडील अनी ख्रिस्तना दुःखसना साक्षीदार अनी प्रकट व्हनारं गौरवमा सहभागी व्हईसन त्यासले हाई समजाडी राहीनु; <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" /><note caller="+" style="x"><char style="xo" closed="false">५:२ </char><char style="xt" closed="false"><ref loc="JHN 21:15-17">योहान २१:१५-१७</ref></char></note>तुमनामाधला देवना कळपनं पालन करा; करनं पडस म्हणीन नही, तर देवना ईच्छाप्रमाणे आनंदतीन त्यानी देखरेख कर; द्रव्यलोभतीन नही तर उत्सुकतातीन करा; <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />ज्या लोके तुमले सोपेल शेतस, त्यासनावर अधिकार चालाडू नका, पण तुमना गटकरता आदर्श बना. <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />मंग मुख्य मेंढपाय प्रकट व्हई तवय तुमले गौरवना मुकूट भेटी ज्यानी चमक कधीच जास नही. <verse eid="1PE 5:4" /><verse number="5" style="v" sid="1PE 5:5" />तसच तरूणसवनं, वडीलसना अधीन रहा, अनी एकमेकसनी सेवा कराकरता तुम्हीन सर्वजण नम्रपणाना कमरबंद बांधा; कारण “देव गर्विष्ठसना विरोध करस, अनी नम्र लोकसवर कृपा करस.” <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" /><note caller="+" style="x"><char style="xo" closed="false">५:६ </char><char style="xt" closed="false"><ref loc="MAT 23:12">मत्तय २३:१२</ref>; <ref loc="LUK 14:11">लूक १४:११</ref>; <ref loc="LUK 18:14">१८:१४</ref></char></note>यामुये देवना पराक्रमी हातसखाल नम्र व्हा यानाकरता की त्यानी योग्य येळले तुमले उंच कराले पाहिजे. <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />त्यानावर तुम्हीन आपली सर्व चिंता टाका कारण तो तुमनी काळजी लेस. <verse eid="1PE 5:7" /><verse number="8" style="v" sid="1PE 5:8" />सावध रहा, जागे रहा; तुमना शत्रु सैतान हाऊ गर्जना करनारा सिंहनामायक कोणले खावानं हाई शोधस फिरस; <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />त्याना विरूध्द ईश्वासमा भक्कम ऱ्हा अनी त्याना सामना करा; जगमाधला बाकीना ईश्वासणारासले ह्याच दुःख ठरायेलप्रमाणे व्हई राहिनात हाई ध्यानमा राहु द्या. <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />तुम्हीन थोडा येळ दुःख सहन करानंतर, आपला सार्वकालिक गौरवमा येवाले पाहिजे म्हणीसन ज्यानी ख्रिस्तमा तुमले पाचारण करं तो सर्व कृपाना देव स्वतः तुमले पुर्ण, भक्कम अनं प्रबळ करी. <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />त्यानं साम्राज्य युगानुयुग राहो. आमेन.<verse eid="1PE 5:11" /></para>
  <para style="s">शेवटना नमस्कार</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">५:१२ </char>
      <char style="xt" closed="false">
        <ref loc="ACT 15:22">प्रेषित १५:२२</ref>,<ref loc="ACT 15:40">४०</ref></char>
    </note>मना मतघाई ईश्वासु असा आपला भाऊ सिल्वान याना हातमा मी थोडकामा हाई लिखीन धाडीन यानामा बोध करेल शे अनं साक्ष देयल शे की हाई देवनी खरी कृपा शे, यानामा भक्कम रहा. <verse eid="1PE 5:12" /><verse number="13" style="v" sid="1PE 5:13" /><note caller="+" style="x"><char style="xo" closed="false">५:१३ </char><char style="xt" closed="false"><ref loc="ACT 12:12">प्रेषित १२:१२</ref>,<ref loc="ACT 12:25">२५</ref>; <ref loc="ACT 13:13">१३:१३</ref>; <ref loc="ACT 15:37-39">१५:३७-३९</ref>; <ref loc="COL 4:10">कलस्सै ४:१०</ref>; <ref loc="PHM 1:24">फिलेमोनले पत्र १:२४</ref></char></note>बाबेल देशमा तुमनामायक निवाडेल मंडळी तुमले सलाम सांगस; अनी ख्रिस्तमा मना पुत्र मार्क हाऊ बी सांगस. <verse eid="1PE 5:13" /><verse number="14" style="v" sid="1PE 5:14" />प्रेमतीन एकमेकसले सलाम करा. ख्रिस्तमाधला तुमले सर्वासले शांती राहो.<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>