<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Plautdietsch</book>
  <para style="h">Paulus sien ieeschta Breef aun Timotäus</para>
  <para style="toc3">1Tim</para>
  <para style="toc2">1Tim</para>
  <para style="toc1">Paulus sien ieeschta Breef aun Timotäus</para>
  <para style="mt1">Paulus sien ieeschta Breef aun Timotäus</para>
  <para style="cl">1. Timotäus</para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="s">Gruss</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />Paulus, Jesus Christus sien Apostel, no däm Befäl von Gott, ons Heilant, un Har Jesus Christus, onse Hopninj, <char style="rq"><ref loc="COL 1:27">Kol 1:27</ref></char> <verse eid="1TI 1:1" /><verse number="2" style="v" sid="1TI 1:2" />aun Timotäus, mien ajchta Sän em Gloowen: Jnod, Erboarmunk un Fräd von Gott onsem Voda, un onsem Harn Jesus Christus! <char style="rq"><ref loc="ACT 16:1-2">Apj 16:1-2</ref>; <ref loc="TIT 1:4">Tit 1:4</ref></char><verse eid="1TI 1:2" /></para>
  <para style="s">Woarnunk Jäajen faulsche Lierasch</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />Soo aus ekj die ermond, en Efesus to bliewen, aus ekj no Mazedonien reisd, daut du eenje befoolst, daut see nich aundre Lieren lieren, <char style="rq"><ref loc="ACT 20:1">Apj 20:1</ref></char> <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />un nich achten opp de Foblen un enjloose Jeschlajchts-Rejista, waut Froagen oppbrinjen, mea aus jettliche Oppbuunk em Gloowen. <char style="rq"><ref loc="1TI 4:7">1Tim 4:7</ref></char> <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />Daut Ziel vom Jeboot es Leew ut een reinet Hoat un von een goodet Jewessen un eenem onjeforwnen Gloowen; <char style="rq"><ref loc="MAT 22:32-40">Mat 22:32-40</ref>; <ref loc="ROM 13:10">Ree 13:10</ref>; <ref loc="GAL 5:6">Gal 5:6</ref></char> <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />wuavon eenje aufjeert sent un haben sikj omjedreit no onneedjet Jeräd; <char style="rq"><ref loc="1TI 6:4">1Tim 6:4</ref>,<ref loc="1TI 6:20">20</ref></char> <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />see wellen Jesaz-Lierasch sennen un vestonen nich, waut see sajen ooda waut see bestädjen.<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />Wie weeten oba, daut daut Jesaz goot es, wan jeemaunt daut rajcht brukt, <char style="rq"><ref loc="ROM 7:12">Ree 7:12</ref></char> <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />un weet dit, daut fa dän Jerajchten kjeen Jesaz jejäft es; oba fa de Jesazloose un Onjehuarsome, de Gottloose un Sinda, de Onheilje un Onjeistliche, de Vodamerda un Muttamerda, de Menschen-Merda, <char style="rq"><ref loc="1CO 6:9-11">1Kor 6:9-11</ref></char> <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />de Huara, de Homoseksuelle, de Menschenstäla, de Läajna, de Eitbräakja un wan waut mea de heelsome Lia entjäajen es, <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />no daut harliche Evangelium von däm seeljen Gott, waut mie aunvetrut es.<verse eid="1TI 1:11" /></para>
  <para style="s">Christus Jesus kjeem, de Sinda to raden</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />Ekj dank Christus Jesus, onsem Harn, dee mie stoakj jemoakt haft, wäarent hee mie tru acht, endäm Hee mie en daut Aumt sad, <char style="rq"><ref loc="ACT 9:15">Apj 9:15</ref>; <ref loc="1CO 15:9-10">1Kor 15:9-10</ref>; <ref loc="GAL 1:13-16">Gal 1:13-16</ref></char> <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" />dee ekj verhäa een Lastra un een Vefolja wia un een Verekjta; oba mie es Boarmherzichkjeit toodeel jeworden, wiels ekj hab daut onweetent jedonen em Ongloowen. <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />Oba de Jnod von ons Har wia äwa de Moten groot, met Gloowen un Leew, dee en Christus Jesus es.<verse eid="1TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TI 1:15" />Dit es eene woare Saj un gaunz wieet aun to nämen, daut Christus Jesus en de Welt jekomen es, de Sinda to raden, mank woone ekj de Väanämsta sie. <char style="rq"><ref loc="LUK 19:10">Luk 19:10</ref></char> <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />Oba doawäajen es mie Boarmherzichkjeit toodeel jeworden, om daut aun mie ieeschtens Jesus Christus aule Jedult bewees, toom Väabilt fa dee, dee aun Am jleewen sullen toom eewje Läwen.<verse eid="1TI 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 1:17" />Däm eewjen Kjennich, däm Onvejenkjlichen un Onsechtboaren un auleen Weisen Gott, traft Iea un Harlichkjeit, von Eewichkjeit to Eewichkjeit! Amen. <verse eid="1TI 1:17" /><verse number="18" style="v" sid="1TI 1:18" />Dit Jeboot befäl ekj die, mien Sän Timotäus, no de verhäaje Profezeiungen äwa die, daut du en dee eenen gooden Kjriejes-Kaumf kjamfst, <char style="rq"><ref loc="1TI 4:14">1Tim 4:14</ref>; <ref loc="1TI 6:12">6:12</ref>; <ref loc="JUD 1:3">Jud 1:3</ref></char> <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />wäarent du dän Gloowen un goodet Jewessen helst, waut eenje von sikj jestat un aum Gloowen Scheppbruch jeläden haben; <char style="rq"><ref loc="1TI 3:9">1Tim 3:9</ref>; <ref loc="1TI 6:10">6:10</ref></char> <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />mank woone es Hiemenäus un Alexanda, woone ekj däm Soton äwajäft hab, daut see belieet woaren, nich to lastren. <char style="rq"><ref loc="1CO 5:5">1Kor 5:5</ref>; <ref loc="2TI 2:17">2Tim 2:17</ref></char><verse eid="1TI 1:20" /></para>
  <para style="cl">1. Timotäus</para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">Bät fa aule Menschen</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />Soo ermon ekj junt nu, ver aules, daut Bedden, Jebäda, Enstonen un Danksajen jedonen woaren fa aule Menschen, <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />fa Kjennichs un aule huach Aunjestalde, om daut wie een rujet un stellet Läwen fieren kjennen en aule Jettlichkjeit un Ieaboakjeit. <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />Wiels soont es goot un aunjenäm ver Gott, onsem Heilant, <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />woona well, daut aule Menschen jerat woaren un to de Erkjantnis von de Woarheit komen. <char style="rq"><ref loc="EZK 18:23">Hes 18:23</ref>; <ref loc="ROM 11:32">Ree 11:32</ref>; <ref loc="2PE 3:9">2Pe 3:9</ref></char> <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />Wiels doa es een Gott un een Vemedla tweschen Gott un de Menschen, de Mensch Christus Jesus, <char style="rq"><ref loc="HEB 9:15">Heb 9:15</ref></char> <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />dee sikj selfst jejäft haft fa aule aus Leesjelt, daut soont to siene Tiet jeprädicht wort; <char style="rq"><ref loc="GAL 1:4">Gal 1:4</ref>; <ref loc="GAL 2:20">2:20</ref>; <ref loc="TIT 2:14">Tit 2:14</ref></char> <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" />doatoo ekj jesat sie aus Prädja un Apostel (ekj saj de Woarheit en Christus un lieej nich), aus Liera fa de Heiden em Gloowen un enne Woarheit. <char style="rq"><ref loc="GAL 2:7-8">Gal 2:7-8</ref>; <ref loc="2TI 1:11">2Tim 1:11</ref></char><verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />Soo well ekj nu, daut de Mana opp aule Städen bäden un heilje Henj opphäwen onen Oaja un Twiewel. <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" />Uk daut de Frues en aunstendje Kjleedie met Schomp un Selfstbeharschunk sikj utstraumen, nich met Hoa-Flajchten ooda Golt ooda Parlen ooda diere Kjleedunk, <char style="rq"><ref loc="1PE 3:3-5">1Pe 3:3-5</ref></char> <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />oba, woo sikj daut de Frues ziemt, dee de Gottseelichkjeit<note caller="+" style="f"><char style="fr" closed="false">2:10 </char><char style="ft" closed="false">Gottseelichkjeit: Een frommet un opprechtjet benämen aus eene Frucht von een Waundel met Gott.</char></note> behaupten, derch goode Woakjen. <char style="rq"><ref loc="1TI 5:10">1Tim 5:10</ref></char> <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />Lot eene Fru em Stellen lieren met aule Unjadonkjeit. <char style="rq"><ref loc="EPH 5:22">Efs 5:22</ref></char> <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />Oba ekj erlaub eene Fru nich, to lieren, uk nich, daut see äwa dän Maun harscht, oba stell es. <char style="rq"><ref loc="GEN 3:16">1Mo 3:16</ref>; <ref loc="1CO 14:34">1Kor 14:34</ref></char> <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />Wiels Adam es aum ieeschten jeformt, doahinja Eva. <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />Un Adam wort nich vefieet; de Fru oba wort vefieet un haft de Äwaträdunk enjefieet. <char style="rq"><ref loc="GEN 3:6">1Mo 3:6</ref></char> <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />See woat oba jerat woaren derch Kjinja haben, wan see em Gloowen bliewen un en de Leew un en de Heiljunk met de Selfstbeharschunk. <char style="rq"><ref loc="1TI 5:14">1Tim 5:14</ref>; <ref loc="TIT 2:4-5">Tit 2:4-5</ref></char><verse eid="1TI 2:15" /></para>
  <para style="cl">1. Timotäus</para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">Ieejenschoften fa Äwaseena</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />Dit es eene woare Saj: Wan jeemaunt een Bischofs-Aumt jankat, däm jankat een wieetvollet Woakj. <char style="rq"><ref loc="ACT 20:28">Apj 20:28</ref>; <ref loc="TIT 1:5-9">Tit 1:5-9</ref></char> <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" />Doa saul oba een Bischof onstrof-falich sennen, eene eensje Fru äa Maun, nichta, besonnen<note caller="+" style="f"><char style="fr" closed="false">3:2 </char><char style="ft" closed="false">Ooda: derchjedocht.</char></note>, aunstendich, gaustfrie, fäich toom lieren, <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />nich een Wiensupa, nich een Schlona, nich onierliche Hendlarie driewen, oba jelind, nich zenkjisch, nich habsichtich, <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />dee sien ieejnet Hus goot väasteit, dee jehuarsome Kjinja haft met aule Ieaboakjeit; <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />(wan oba jeemaunt sien ieejnet Hus nich weet väa to stonen, woo woat hee Gott siene Jemeent vesorjen?) <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />nich een Nielinkj, om daut hee nich oppjepust woat un en daut Uadeel vom Diewel felt. <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />Hee mott oba uk een goodet Zeichnis haben von jane, dee buten sent, om daut hee nich enne Schaund felt un enne Schlenj von däm Diewel.<verse eid="1TI 3:7" /></para>
  <para style="s">Ieejenschoften fa Diakonen</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />Krakjt soo sellen de Diakonen ieeboa sennen, nich tweetungich, nich äwajäft aun väl Wien, nich onierliche Hendlarie driewen; <char style="rq"><ref loc="ACT 6:3">Apj 6:3</ref>; <ref loc="PHP 1:1">Flp 1:1</ref></char> <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />dee daut Jeheemnis von däm Gloowen en een reinet Jewessen haben. <char style="rq"><ref loc="1TI 1:19">1Tim 1:19</ref></char> <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />Un dise lot maun ieescht proowen; dan lot äant deenen, wan see schultloos sent. <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />Uk äare Frues sellen ieeboa sennen, nich Lastarinen, nichta, tru en aules. <char style="rq"><ref loc="TIT 2:3">Tit 2:3</ref></char> <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />De Diakonen lot sennen eene Fru äa Maun, dee äare Kjinja un äare ieejne Hiesa goot väastonen. <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />Woone oba goot jedeent haben, jewennen fa sikj eene ieren Stalunk<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">Ooda: goode Stoop.</char></note> un eene groote Freidichkjeit em Gloowen, dee en Christus Jesus es.<verse eid="1TI 3:13" /></para>
  <para style="s">Daut Jeheemnis von Jettlichkjeit</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />Soont schriew ekj die un hop, boolt no die to komen; <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />wan ekj oba vetrakj, daut du weetst, woo du waundlen saust en Gott sien Hus, woont de Jemeent von däm läwendjen Gott es, de Stenda un Gruntfoot von de Woarheit. <char style="rq"><ref loc="EPH 2:19-22">Efs 2:19-22</ref></char> <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />Un aunerkjanlich groot es daut jettliche Jeheemnis: Gott wort jeopenboat em Fleesch, jerajchtfoadicht em Jeist, erschienen to de Enjel, jeprädicht to de Heiden, jejleeft von de Welt, oppjenomen en de Harlichkjeit. <char style="rq"><ref loc="MAT 16:19">Mat 16:19</ref>; <ref loc="JHN 1:14">Joh 1:14</ref>; <ref loc="ACT 28:28">Apj 28:28</ref>; <ref loc="ROM 1:4">Ree 1:4</ref>; <ref loc="EPH 1:20-21">Efs 1:20-21</ref></char><verse eid="1TI 3:16" /></para>
  <para style="cl">1. Timotäus</para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">Eenje woaren dän Gloowen veloten</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />De Jeist oba sajcht dietlich, daut en de latste Tieden woaren eenje von däm Gloowen aufträden, endäm see de vefierarische Jeista un Lieren von de Diewels aunhenjen, <char style="rq"><ref loc="MAT 14:24">Mat 14:24</ref>; <ref loc="2TH 2:3">2Tess 2:3</ref>; <ref loc="2TI 3:1">2Tim 3:1</ref>; <ref loc="2PE 3:3">2Pe 3:3</ref>; <ref loc="1JN 2:8">1Joh 2:8</ref>; <ref loc="JUD 1:18">Jud 1:18</ref></char> <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />derch dee, dee en Heichlarie Läajes räden un een Brenntieekjen en äa Jewessen haben, <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />vebeeden to befrieen un jebeeden, sikj von Äten to enthoolen, daut Gott erschaufen haft to nämen met Danksajunk fa de Jleewende un fa dee, waut de Woarheit erkjanen. <char style="rq"><ref loc="GEN 9:3">1Mo 9:3</ref>; <ref loc="1CO 10:30-31">1Kor 10:30-31</ref>; <ref loc="COL 2:23">Kol 2:23</ref></char> <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />Wiels aule Kjreatua von Gott es goot un nuscht toom veschmieten, waut met Danksajunk jenomen woat; <char style="rq"><ref loc="GEN 1:31">1Mo 1:31</ref>; <ref loc="MAT 5:11">Mat 5:11</ref>; <ref loc="ACT 10:15">Apj 10:15</ref></char> <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />wiels daut woat jeheilicht derch Gott sien Wuat un Jebäd.<verse eid="1TI 4:5" /></para>
  <para style="s">Christus sien gooda Deena</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />Wan du de Breeda soont väahelst, woascht du Jesus Christus sien gooda Deena sennen, oppjetrocken en de Wieed von däm Gloowen un de goode Lia, woone du jeneiw nojegonen best. <char style="rq"><ref loc="2TI 2:15">2Tim 2:15</ref></char> <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />Oba de onjeistliche<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">Ooda: onheilje.</char></note> Ooltwiewa-Foblen doo wajch von die; eew die selfst oba en de Jettlichkjeit. <char style="rq"><ref loc="1TI 6:20">1Tim 6:20</ref>; <ref loc="2TI 2:16">2Tim 2:16</ref>,<ref loc="2TI 2:23">23</ref>; <ref loc="2TI 4:4">4:4</ref>; <ref loc="TIT 1:14">Tit 1:14</ref>; <ref loc="TIT 3:9">3:9</ref></char> <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />Wiels de kjarpaliche Eewunk es weinich toom Nutzen; oba de Jettlichkjeit es bie aules nutzboa un haft de Veheetunk fa dit un daut tookjinftje Läwen. <char style="rq"><ref loc="1TI 6:6">1Tim 6:6</ref></char> <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />Dit es eene woare Saj un gaunz wieet aun to nämen. <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />Wiels doahan oabeid wie uk un woaren vespott, daut wie opp dän läwendjen Gott hopen, wäa de Heilant es fa aule Menschen, besondasch fa de Jleewende. <verse eid="1TI 4:10" /><verse number="11" style="v" sid="1TI 4:11" />Dit befäl un lia.<verse eid="1TI 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 4:12" />Lot Kjeenem diene Jugent ve-achten; oba sie een Väabilt von<note caller="+" style="f"><char style="fr" closed="false">4:12 </char><char style="ft" closed="false">Ooda: fa.</char></note> de Jleewende em Wuat, em Waundel, en de Leew, em Jeist, em Gloowen, en de Reinheit. <char style="rq"><ref loc="2TI 2:22">2Tim 2:22</ref>; <ref loc="TIT 2:15">Tit 2:15</ref></char> <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />Hool aun met Läsen, met Ermonen, met Lieren, bat ekj kom. <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />Lot nich ut de Acht de Gow en die, waut die derch de Profezeiunk jejäft es met Henj-Opplajen von de Eltestaschoft. <char style="rq"><ref loc="ACT 6:6">Apj 6:6</ref>; <ref loc="ACT 8:17">8:17</ref>; <ref loc="1TI 1:18">1Tim 1:18</ref>; <ref loc="1TI 5:22">5:22</ref>; <ref loc="2TI 1:6">2Tim 1:6</ref></char> <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />Denkj dise Dinja no, go doamet om, om daut dien Toonämen ver aulem openboa woat. <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />Hab acht opp die selfst un opp de Lia; hool aun en dise. Wiels wan du soont deist, woascht du die selfst raden un dee, waut die hieren. <char style="rq"><ref loc="ROM 11:14">Ree 11:14</ref></char><verse eid="1TI 4:16" /></para>
  <para style="cl">1. Timotäus</para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">Aunwiesungen fa de Kjoakj</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />Eenen elren Maun schell nich, oba ermon am aus eenen Voda, de Jinjre aus Breeda, <char style="rq"><ref loc="LEV 19:32">3Mo 19:32</ref>; <ref loc="TIT 2:2">Tit 2:2</ref></char> <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />de elre Frues aus Mitta, de jinjre aus Sestren met aule Reinheit. <verse eid="1TI 5:2" /><verse number="3" style="v" sid="1TI 5:3" />Iea de Wätfrues, woone rajchte Wätfrues sent. <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />Wan oba eene Wätfru Kjinja ooda Grootkjinja haft, lot soone ieescht lieren, aun äa ieejnet Hus Fromheit to bewiesen un de Elren Äwareenet to vejelten; wiels daut es goot un aunjenäm ver Gott. <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />Daut es oba eene rajchte Wätfru, dee eensom es, dee opp Gott hopt un blift em Bedden un Jebäda Dach un Nacht. <char style="rq"><ref loc="LUK 2:37">Luk 2:37</ref></char> <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />Woone oba vollbrestich<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">vollbrestich: met volle Brost; huachhäa un schomploos läwen. </char></note> läft, es läwendich doot. <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />Soont befäl, om daut see onstrofboa sent. <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />Wan oba jeemaunt de Sienje, besondasch dee en sien ieejnet Hus, nich vesorcht, dee haft dän Gloowen veloagen un es oaja aus een Onjleewenda. <char style="rq"><ref loc="MAT 15:4-6">Mat 15:4-6</ref></char><verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />Lot kjeene Wätfru enjeschräwen woaren unja zastich Joa, un dee doa een Maun siene Fru jewast es, <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />dee een Zeichnis von goode Woakjen haft, wan see Kjinja oppjebrocht haft, wan see gaustfrie jewast es, wan see de Heilje äare Feet jewoschen haft, wan see de unjajedrekjte Hauntrieekjunk jejäft haft, wan see jieda goodet Woakj nojekomen es. <char style="rq"><ref loc="JHN 13:14">Joh 13:14</ref>; <ref loc="HEB 13:2">Heb 13:2</ref></char> <verse eid="1TI 5:10" /><verse number="11" style="v" sid="1TI 5:11" />De jinjre Wätfrues oba nemm nich aun; wiels wan see lostich jeworden sent jäajen Christus, wellen see frieen <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />un haben äa Uadeel, wiels see dän ieeschten Gloowen veschmäten haben. <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />Biesied daut sent see ful un lieren romranen derch de Hiesa; nich auleen sent see ful, oba uk Schwauza<note caller="+" style="f"><char style="fr" closed="false">5:13 </char><char style="ft" closed="false">Ooda: Pludra.</char></note> un schneppanäsich un räden, waut sikj nich jeziemt. <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />Soo well ekj nu, daut de jinjre Wätfrues frieen, Kjinja haben, hushoolen, däm Jäajna kjeene Uasoak jäwen to schellen. <char style="rq"><ref loc="1CO 7:9">1Kor 7:9</ref>; <ref loc="1TI 2:15">1Tim 2:15</ref></char> <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />Wiels doa sent aul eenje omjedreit däm Soton no.<verse eid="1TI 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TI 5:16" />Wan oba een Jleewenda ooda eene Jleewende Wätfrues haft, dee vesorj äant un lot de Jemeent nich schwoa jemoakt woaren, om daut dee kaun Hauntrieekjunk doonen to dee, waut rajchte Wätfrues sent. <char style="rq"><ref loc="ACT 6:1">Apj 6:1</ref></char><verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />De Eltestasch, dee goot väastonen, sellen dobbelde Iea wieet jehoolen, besondasch, dee doa oabeiden em Wuat un en de Lia. <char style="rq"><ref loc="ACT 14:23">Apj 14:23</ref>; <ref loc="ROM 12:8">Ree 12:8</ref></char> <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" />Wiels de Schreft sajcht: “Du saust däm Oss, dee doa drascht, nich de Frät vebinjen;” un “De Oabeida es sien Loon wieet.” <char style="rq"><ref loc="DEU 25:4">5Mo 25:4</ref>; <ref loc="LUK 10:7">Luk 10:7</ref>; <ref loc="1CO 9:9">1Kor 9:9</ref></char><verse eid="1TI 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TI 5:19" />Jäajen eenen Eltesta nemm kjeene Kloag aun onen twee ooda dree Zeijen. <char style="rq"><ref loc="DEU 19:15">5Mo 19:15</ref>; <ref loc="MAT 18:16">Mat 18:16</ref></char> <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />Dee doa sindjen, dee strof ver aulem, om daut sikj uk de aundre ferchten. <verse eid="1TI 5:20" /><verse number="21" style="v" sid="1TI 5:21" />Ekj bewies ver Gott un däm Harn Jesus Christus un de uterwälde Enjel, daut du dise Dinja onparteiisch helst un nuscht deist no Gonst. <char style="rq"><ref loc="MAT 18:15-17">Mat 18:15-17</ref>; <ref loc="GAL 2:14">Gal 2:14</ref></char><verse eid="1TI 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1TI 5:22" />De Henj laj kjeenem to schwind opp; moak die uk nich aun däm Framden siene Sinden deelhauftich. Hool die selfst rein. <char style="rq"><ref loc="1TI 4:14">1Tim 4:14</ref></char> <verse eid="1TI 5:22" /><verse number="23" style="v" sid="1TI 5:23" />Drinkj nich mea Wota, oba bruck een beskje Wien om diene Moag haulwen un wiels du foaken krank best. <verse eid="1TI 5:23" /><verse number="24" style="v" sid="1TI 5:24" />Eenje Menschen äare Sinden sent openboa, dee gonen verhäa nom Jerecht; bie eenje oba woaren dee nohäa komen. <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />Jrodsoo uk eenje äare goode Woakjen sent verhäa openboa, un de aundre bliewen uk nich vestoaken.<verse eid="1TI 5:25" /></para>
  <para style="cl">1. Timotäus</para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />Aule Kjnajchts, waut unja daut Joch sent, sellen äare Haren aule Iea wieet hoolen, om daut nich Gott sien Nomen un de Lia velastat woat. <char style="rq"><ref loc="EPH 6:5-8">Efs 6:5-8</ref>; <ref loc="TIT 2:9-10">Tit 2:9-10</ref></char><verse eid="1TI 6:1" /></para>
  <para style="s">Faulsche Lierasch un Woare Tofrädenheit</para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 6:2" />Woone oba jleewende Haren haben, sellen dee nich ve-achten, wiels see Breeda sent, oba sellen väl mea deenstboa sennen, wiels see True un Jeleewde sent un aun de Wooldot deelhauftich. Soont lia un ermon. <char style="rq"><ref loc="PHP 1:16">Flp 1:16</ref></char><verse eid="1TI 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />Wan jeemaunt aundasch lieet un blift nich bie de heelsome Wieed von ons Har Jesus Christus un bie de Lia, waut no<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">Ooda: soo aus.</char></note> de Jettlichkjeit es, <char style="rq"><ref loc="2TI 1:13">2Tim 1:13</ref></char> <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />dee es oppjeblost un weet nuscht, oba haft de Ploag von Froagen un Wuatkjriej, ut woone entsteit Aufgonst, Striet, Lastrunk, beeset Mestruen<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">Ooda: Vedajchtjet.</char></note>, <char style="rq"><ref loc="2TI 2:14">2Tim 2:14</ref>; <ref loc="TIT 3:10-11">Tit 3:10-11</ref></char> <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />Zenkjarieen von Menschen, dee eenen vedorwnen Senn haben un de Woarheit aufjelaupst, dee doa meenen, Jettlichkjeit es toom Jewenst. Velot von soone.<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />Oba Jettlichkjeit met Tofrädenheit es een groota Jewenst. <char style="rq"><ref loc="MAT 6:25-34">Mat 6:25-34</ref>; <ref loc="PHP 4:11-12">Flp 4:11-12</ref>; <ref loc="1TI 4:8">1Tim 4:8</ref>; <ref loc="HEB 13:5">Heb 13:5</ref></char> <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />Wiels wie haben nuscht en de Welt nenjebrocht; doawäajen es daut openboa, daut wie woaren uk nuscht rutbrinjen. <char style="rq"><ref loc="JOB 1:21">Hiob 1:21</ref>; <ref loc="PSA 49:18">Ps 49:18</ref>; <ref loc="ECC 5:14">Prä 5:14</ref></char> <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />Wan wie oba Noarunk un Kjleeda haben, lot ons daut jenuach sennen. <char style="rq"><ref loc="PRO 30:8">Spr 30:8</ref></char> <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />Wiels dee doa rikj woaren wellen, faulen en Vesieekjunk un Schlenj un väl tierichte un schätliche Losten, woone de Menschen en daut Vedoawen un Vedaumnis vesinkjen. <char style="rq"><ref loc="PRO 28:22">Spr 28:22</ref>; <ref loc="MAT 13:22">Mat 13:22</ref></char> <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />Wiels de Jeltjia es de Wartel von aulet Beese, wäarent eenje sikj haben dee jelesten loten, sent see vom Gloowen err-jegonen un haben sikj selfst met väl Wee derchjestoaken. <char style="rq"><ref loc="EPH 5:5">Efs 5:5</ref>; <ref loc="1TI 1:19">1Tim 1:19</ref></char><verse eid="1TI 6:10" /></para>
  <para style="s">Kjamf dän gooden Gloowens-Kaumf</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />Oba du, Gottes-Mensch, kleiw ut von soont! Joag oba no de Jerajchtichkjeit, de Jettlichkjeit, dän Gloowen, de Leew, de Jedult, de Saunftmoot. <char style="rq"><ref loc="2TI 3:17">2Tim 3:17</ref>; <ref loc="2TI 2:22">2:22</ref></char> <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />Kjamf dän gooden Gloowens-Kaumf; jriep daut eewje Läwen, wuatoo du uk beroopen best un een goodet Bekjantnis ver väle Zeijen bekjant hast. <char style="rq"><ref loc="1CO 9:25-26">1Kor 9:25-26</ref>; <ref loc="1TI 1:18">1Tim 1:18</ref>; <ref loc="1TI 4:14">4:14</ref>; <ref loc="2TI 4:7">2Tim 4:7</ref>; <ref loc="HEB 3:1">Heb 3:1</ref></char><verse eid="1TI 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TI 6:13" />Ekj jebeed die ver Gott, dee aules läwendich moakt un ver Christus Jesus, dee ver Pontius Pilatus een goodet Bekjantnis jezeicht haft, <char style="rq"><ref loc="JHN 18:36-37">Joh 18:36-37</ref>; <ref loc="REV 1:5">Opb 1:5</ref></char> <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />daut du daut Jeboot helst onen Plaken, onstrofboa, bat de Erschienunk von ons Har Jesus Christus, <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />dee to siene Tiet wiesen woat, wäa de Seelja un auleen Jewaultja, de Kjennich von Kjennichs un Har von Haren es, <char style="rq"><ref loc="DEU 10:17">5Mo 10:17</ref>; <ref loc="REV 17:14">Opb 17:14</ref></char> <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />dee auleen Onstoaflichkjeit haft, dee doa wont en een Licht, wua kjeena naunkomen kaun, woonen kjeen Mensch jeseenen haft, noch seenen kaun; däm jehieet Iea un eewje Macht! Amen. <char style="rq"><ref loc="EXO 33:20">2Mo 33:20</ref>; <ref loc="JHN 1:18">Joh 1:18</ref></char><verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />De Rikje en dise Welt befäl, daut see nich stolt sent, uk nich hopen opp dän onsechren Rikjtum, oba opp dän läwendjen Gott, dee ons rikjlich aules jeft to erjazen; <char style="rq"><ref loc="PSA 62:11">Ps 62:11</ref>; <ref loc="LUK 12:15-21">Luk 12:15-21</ref></char> <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />daut see Goodet doonen, rikj sent aun goode Woakjen, jieren jäwen, reed toom metdeelen, <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />endäm see sikj selfst eenen gooden Grunt fa de Tookunft oppsaumlen, daut see daut eewje Läwen jriepen. <char style="rq"><ref loc="MAT 6:20">Mat 6:20</ref>; <ref loc="LUK 16:9">Luk 16:9</ref></char><verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />Oo Timotäus, bewoa daut Aunvetrude, un meid de onjeistliche, loose Jeschwauza<note caller="+" style="f"><char style="fr" closed="false">6:20 </char><char style="ft" closed="false">Ooda: loose Jeblauba.</char></note> un daut Jezank von de faulsch jenande Wissenschoft, <char style="rq"><ref loc="1TI 4:7">1Tim 4:7</ref>; <ref loc="2TI 1:12-14">2Tim 1:12-14</ref></char> <verse eid="1TI 6:20" /><verse number="21" style="v" sid="1TI 6:21" />woone eenje behaupten un sent vom Gloowen aufjeert. Mucht de Jnod met die sennen! Amen. <char style="rq"><ref loc="1TI 1:6">1Tim 1:6</ref>; <ref loc="2TI 2:18">2Tim 2:18</ref></char><verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>