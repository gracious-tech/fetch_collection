<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Plautdietsch</book>
  <para style="h">Paulus sien Breef aun de Efeesa</para>
  <para style="toc3">Efs</para>
  <para style="toc2">Efs</para>
  <para style="toc1">Paulus sien Breef aun de Efeesa</para>
  <para style="mt1">Paulus sien Breef aun de Efeesa</para>
  <para style="cl">Efeesa</para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="s">Gruss</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />Paulus, Jesus Christus sien Apostel derch Gott sien Wellen, aun de Heilje, dee en Efesus sent un de True en Christus Jesus: <verse eid="EPH 1:1" /><verse number="2" style="v" sid="EPH 1:2" />Jnod met junt un Fräd von Gott, onsem Voda, un däm Harn Jesus Christus.<verse eid="EPH 1:2" /></para>
  <para style="s">Jeistliche Säajnungen en Christus</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />Jeloft es de Gott un Voda von ons Har Jesus Christus, dee ons jesäajent haft met jieda jeistlicha Säajen en de himlische Städen en Christus; <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />doano aus Hee ons jewält haft en Am ver de Welt-Gruntlajunk, daut wie sullen heilich un onstrof-falich sennen ver Am en Leew; <char style="rq"><ref loc="ROM 8:28-30">Ree 8:28-30</ref>; <ref loc="GEN 12:3">1Mo 12:3</ref></char> <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />un haft ons verhäa-bestemt fa de Kjintschoft derch Jesus Christus fa sikj selfst, no daut Wooljefaulen von sien Wellen, <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />fa daut Low von de Harlichkjeit von siene Jnod, en woone Hee ons aunjenäm jemoakt haft<note caller="+" style="f"><char style="fr" closed="false">1:6 </char><char style="ft" closed="false">Ooda: bejnodicht haft.</char></note> en däm Jeleewden; <char style="rq"><ref loc="MAT 3:17">Mat 3:17</ref></char> <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" />en woonem wie de Erleesunk haben derch sien Bloot, de Sinden-Vejäwunk, no däm Rikjtum von siene Jnod, <char style="rq"><ref loc="EPH 2:7">Efs 2:7</ref>; <ref loc="EPH 3:8">3:8</ref>,<ref loc="EPH 3:16">16</ref>; <ref loc="COL 1:14">Kol 1:14</ref></char> <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />dee Hee jäajen ons haft äwastreemen loten en aule Weisheit un Ensecht; <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />un haft ons daut Jeheemnis von sien Wellen weeten loten no sien Wooljefaulen, dän Hee sikj väajenomen haud en sikj selfst, <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />fa de Vewaultunk von de Erfellunk von de Tieden, om aules toop to brinjen en Christus, beides, waut em Himmel un opp Ieeden es, en Am, <char style="rq"><ref loc="GAL 4:4">Gal 4:4</ref></char> <verse eid="EPH 1:10" /><verse number="11" style="v" sid="EPH 1:11" />en woonem wie uk eene Oafschoft erlangt haben, dee wie verhäa-bestemt sent no daut Väanämen von däm, dee aules wirkjt no däm Rot von sien Wellen, <char style="rq"><ref loc="COL 1:12">Kol 1:12</ref></char> <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />daut wie doa sent fa daut Low von siene Harlichkjeit, wie, dee wie verhäa opp dän Christus hopten; <verse eid="EPH 1:12" /><verse number="13" style="v" sid="EPH 1:13" />en woonem uk jie hopten, nodäm jie daut Wuat von de Woarheit hieeden, daut Evangelium von june Radunk, en woonem uk jie, nodäm jie jejleeft haben, sent vesäajelt worden met däm Heiljen Jeist von de Vespräakjunk, <char style="rq"><ref loc="EPH 4:30">Efs 4:30</ref></char> <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />woona de Auntolinj von ons Oafgoot es, bat de Erleesunk von daut jekofte Ieejentum, fa daut Low von siene Harlichkjeit. <char style="rq"><ref loc="2CO 1:22">2Kor 1:22</ref>; <ref loc="2CO 5:5">5:5</ref></char><verse eid="EPH 1:14" /></para>
  <para style="s">Jebäd om jeistliche Weisheit</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />Doawäajens uk ekj, nodäm ekj jehieet haud von junem Gloowen aun dän Harn Jesus un von de Leew to aul de Heilje, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />hia ekj nich opp, fa junt to danken un junt to erwänen en miene Jebäda, <char style="rq"><ref loc="COL 1:4">Kol 1:4</ref>,<ref loc="COL 1:9">9</ref></char> <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />om daut de Gott von ons Har Jesus Christus, de Voda von de Harlichkjeit, junt mucht dän Jeist von Weisheit un Openboarunk jäwen, en de Erkjantnis von Am, <char style="rq"><ref loc="EXO 28:3">2Mo 28:3</ref>; <ref loc="ISA 11:2">Jes 11:2</ref></char> <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />de Uagen von jun Vestentnis oppjedacht, daut jie muchten weeten, woont doa de Hopninj von sien Roop es un woont de Rikjtum von de Harlichkjeit von sien Oafgoot en de Heilje <char style="rq"><ref loc="PSA 119:18">Ps 119:18</ref></char> <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />un woont doa de äwatrafende Grootheit von siene Krauft aun ons es, dee wie jleewen no daut Wirkjen von de Macht von siene Krauft, <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />woone Hee en Christus jewirkjt haft, wäarent Hee Am von de Doodje opperwakjt haft un Am aun siene rajchte Haunt jesat en de himlische Städen, <char style="rq"><ref loc="PSA 110:1">Ps 110:1</ref></char> <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />wiet äwa jieda Ferschtentum un Autorität un Krauft un Harschoft un jieda Nomen, dee jenant woat, nich bloos en dise Welt<note caller="+" style="f"><char style="fr" closed="false">1:21 </char><char style="ft" closed="false">Ooda: Tiet.</char></note>, oba uk en de Tookjinftje; <char style="rq"><ref loc="ROM 8:38-39">Ree 8:38-39</ref>; <ref loc="PHP 2:9">Flp 2:9</ref>; <ref loc="COL 2:10">Kol 2:10</ref></char> <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" />un haft aules unja siene Feet jedonen un jeef Am aus Haupt äwa aules to de Jemeent, <char style="rq"><ref loc="PSA 8:6">Ps 8:6</ref>; <ref loc="MAT 28:18">Mat 28:18</ref>; <ref loc="EPH 4:15">Efs 4:15</ref> </char> <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />woone sien Kjarpa es, de Vollheit von däm, dee aules en aules erfelt. <char style="rq"><ref loc="EPH 5:30">Efs 5:30</ref>; <ref loc="1CO 12:27">1Kor 12:27</ref>; <ref loc="COL 1:19">Kol 1:19</ref></char><verse eid="EPH 1:23" /></para>
  <para style="cl">Efeesa</para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">Ut Jnod derch dän Gloowen</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />Un junt haft Hee läwendich jemoakt, dee jie doot wieren en Äwaträdungen un Sinden, <char style="rq"><ref loc="LUK 15:24">Luk 15:24</ref>,<ref loc="LUK 15:32">32</ref>; <ref loc="COL 2:13">Kol 2:13</ref></char> <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />en woone jie ea jewaundelt haben no däm Gank von dise Welt, no däm Väaschten von de Vollmacht en de Loft, no däm Jeist, dee nu wirkjt en de Kjinja vom Ongloowen<note caller="+" style="f"><char style="fr" closed="false">2:2 </char><char style="ft" closed="false">Ooda: Onjehuarsom.</char></note>, <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />mank woone uk wie aula ea onsen Waundel hauden en de Losten von ons Fleesch un deeden dän Wellen vom Fleesch un de Jedanken un wieren von Natua Kjinja vom Oaja, jrod soo aus de aundre. <char style="rq"><ref loc="COL 3:6">Kol 3:6</ref>; <ref loc="1PE 4:3">1Pe 4:3</ref></char> <verse eid="EPH 2:3" /><verse number="4" style="v" sid="EPH 2:4" />Oba Gott, dee rikj es aun Boarmherzichkjeit, wäajens siene groote Leew, wuamet Hee ons jeleeft haft, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />aus wie noch doot wieren en Sinden, haft ons met Christus toop läwendich jemoakt, (derch Jnod sent jie jerat) <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />un haft ons toop opperwakjt un toop to setten jejäft en de himlische Städen en Christus Jesus, <char style="rq"><ref loc="PHP 3:20">Flp 3:20</ref></char> <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />daut Hee en de komende Tieden dän äwatrafenden Rikjtum von siene Jnod aun ons bewiesen kunn derch siene Leeftolichkjeit aun ons en Christus Jesus. <char style="rq"><ref loc="EPH 1:7">Efs 1:7</ref></char><verse eid="EPH 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 2:8" />Wiels derch de Jnod sent jie jerat derch dän Gloowen un daut nich ut junt, daut es een Jeschenkj von Gott; <char style="rq"><ref loc="ROM 3:23-24">Ree 3:23-24</ref>; <ref loc="GAL 2:16">Gal 2:16</ref></char> <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />nich ut Woakjen, daut sikj kjeena riemen mucht. <char style="rq"><ref loc="ROM 3:28">Ree 3:28</ref>; <ref loc="1CO 1:29">1Kor 1:29</ref></char> <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />Wiels wie sent sien Woakj, jeschaufen en Christus Jesus fa goode Woakjen, dee Gott verhäa reedjemoakt haft, daut wie en dee waundlen sellen. <char style="rq"><ref loc="TIT 2:14">Tit 2:14</ref></char><verse eid="EPH 2:10" /></para>
  <para style="s">Aula eent en Christus</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />Doawäajen denkjt doaraun, daut jie ea, aus Heiden em Fleesch, de Onbeschnädne jenant worden von dee, dee de Beschniedunk jenant woaren, dee aum Fleesch met de Henj passieet; <char style="rq"><ref loc="EPH 5:8">Efs 5:8</ref></char> <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />daut jie to dee Tiet onen Christus wieren, aufjesondat von daut Birjarajcht von Israel un Framde to de Bintnissen von de Vespräakjunk, hauden kjeene Hopninj un wieren onen Gott en de Welt. <char style="rq"><ref loc="ROM 9:4">Ree 9:4</ref>; <ref loc="1TH 4:13">1Tess 4:13</ref></char> <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />Oba nu, en Christus Jesus, sent jie, dee jie ea wietauf wieren, derch Christus sien Bloot dichtbie jeworden. <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />Wiels Hee es ons Fräd, dee ut beid eent jemoakt haft un de Meddelwaunt von de Aufdeelunk doljebroaken, <char style="rq"><ref loc="ISA 9:5">Jes 9:5</ref>; <ref loc="GAL 3:28">Gal 3:28</ref></char> <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />endäm Hee en sien Fleesch de Fientschoft, daut Jesaz von Jebooten en Befälungen, wajchjenomen haft, daut Hee von de twee en sikj selfst eenen nieen Mensch schauft un Fräd muak, <char style="rq"><ref loc="COL 2:14">Kol 2:14</ref></char> <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />un daut hee mucht de beid en eenem Kjarpa met Gott veseenen derch daut Kjriez, nodäm Hee derch dautselwje de Fientschoft dootjemoakt haft. <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />Un Hee kjeem un vekjindijd Fräd to junt, dee wietauf wieren, un to dee dichtbie. <char style="rq"><ref loc="ISA 57:19">Jes 57:19</ref></char> <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />Wiels derch Am hab wie beid dän Toogank derch eenen Jeist no däm Voda. <char style="rq"><ref loc="EPH 3:12">Efs 3:12</ref></char><verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />Soo sent jie nu nich mea Framdlinja un Utlenda, oba Metbirja met de Heilje un Gott siene Husfamielje, <char style="rq"><ref loc="EPH 3:6">Efs 3:6</ref>; <ref loc="HEB 12:22-23">Heb 12:22-23</ref></char> <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />oppjebut opp dän Grunt von de Apostel un Profeeten, wua Jesus Christus selfst de Haupt-Akjsteen es, <char style="rq"><ref loc="PSA 118:22">Ps 118:22</ref>; <ref loc="ISA 28:16">Jes 28:16</ref>; <ref loc="MAT 16:18">Mat 16:18</ref>; <ref loc="1PE 2:4-6">1Pe 2:4-6</ref></char> <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />en woonem de gaunza Bu aunenaunda toopjebut waust to eenem heiljen Tempel en däm Harn, <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />en woonem uk jie met-oppjebut woaren to Gott siene Woninj em Jeist.<verse eid="EPH 2:22" /></para>
  <para style="cl">Efeesa</para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">Daut Jeheemnis vom Evangelium jeopenboat</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />Doawäajen ekj, Paulus, Christus Jesus sien Jefangna fa junt Heiden, <char style="rq"><ref loc="PHP 1:7">Flp 1:7</ref>,<ref loc="PHP 1:13">13</ref></char> <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />wan jie sest jehieet haben von de Vewaultunk von Gott siene Jnod, dee mie fa junt jejäft worden es, <char style="rq"><ref loc="GAL 2:7">Gal 2:7</ref></char> <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />daut mie daut Jeheemnis derch Openboarunk es toweeten jeworden (soo aus ekj verhäa kort jeschräwen hab, <char style="rq"><ref loc="EPH 1:9-10">Efs 1:9-10</ref>; <ref loc="GAL 1:12">Gal 1:12</ref></char> <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" />wuaraun, wan jie läsen, moakjen kjennen mien Vestentnis von Christus sien Jeheemnis), <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />woont en aundre Jennerazionen de Menschenkjinja nich weeten jeloten wort, soo aus daut nu siene heilje Apostel un Profeeten em Jeist es jeopenboat worden: <char style="rq"><ref loc="COL 1:26">Kol 1:26</ref></char> <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />Daut de Heiden Metoawen sent un met em Kjarpa un Deelnäma von siene Vespräakjunk en Christus derch daut Evangelium, <char style="rq"><ref loc="ACT 15:7-9">Apj 15:7-9</ref>; <ref loc="ROM 8:17">Ree 8:17</ref>; <ref loc="GAL 3:29">Gal 3:29</ref>; <ref loc="GAL 4:7">4:7</ref></char> <verse eid="EPH 3:6" /><verse number="7" style="v" sid="EPH 3:7" />wuavon ekj een Deena jeworden sie no de Gow von Gott siene Jnod, dee mie jejäft es no de Wirkjunk von siene Krauft.<verse eid="EPH 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 3:8" />Mie, däm gaunz jerinjsten von aul de Heilje, es dise Jnod jejäft worden, mank de Heiden dän onutforschlichen Rikjtum von Christus to vekjindjen <char style="rq"><ref loc="1CO 15:9-10">1Kor 15:9-10</ref>; <ref loc="GAL 1:16">Gal 1:16</ref>; <ref loc="EPH 1:7">Efs 1:7</ref></char> <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />un aulem seenen to moaken, waut de Jemeenschoft<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">Ooda: Vewaultunk.</char></note> von daut Jeheemnis es, daut von de Welt Aunfank vestoaken wia en Gott, dee aule Dinja jeschaufen haft derch Jesus Christus, <char style="rq"><ref loc="ROM 16:25-26">Ree 16:25-26</ref>; <ref loc="EPH 1:9-10">Efs 1:9-10</ref>; <ref loc="COL 1:16">Kol 1:16</ref></char> <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />om daut nu to de Ferschtentiema un de Autoritäten en de himlische Städen derch de Jemeent de välfache Weisheit von Gott weeten-jeloten woat, <char style="rq"><ref loc="1PE 1:12">1Pe 1:12</ref></char> <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />no de eewje Aufsecht, dee Hee faustjestalt haud en Christus Jesus, onsem Harn, <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />en woonem wie dän Friemoot haben un dän Toogank em Toovetruen derch dän Gloowen von<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">Ooda: aun.</char></note> Am. <char style="rq"><ref loc="ROM 5:2">Ree 5:2</ref></char> <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />Doawäajen bedd ekj junt, nich mootloos to woaren en miene Triebsaulen fa junt, woone june Iea sent. <char style="rq"><ref loc="COL 1:24">Kol 1:24</ref></char><verse eid="EPH 3:13" /></para>
  <para style="s">Jebäd om jeistliche Krauft</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />Wäajens dit bieej ekj miene Kjneeen ver däm Voda von ons Har Jesus Christus, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />von woonem de gaunze Famielje jenant woat em Himmel un opp Ieeden, <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />daut Hee junt jäwen mucht, no däm Rikjtum von siene Harlichkjeit, met Krauft jestoakjt to woaren aun däm ennalichen Mensch derch sienen Jeist; <char style="rq"><ref loc="2CO 4:16">2Kor 4:16</ref>; <ref loc="EPH 1:7">Efs 1:7</ref>; <ref loc="EPH 6:10">6:10</ref></char> <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />daut Christus derch dän Gloowen en june Hoaten wonen mucht, endäm jie en Leew enjewartelt un jejrint sent, <char style="rq"><ref loc="COL 2:2-3">Kol 2:2-3</ref></char> <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />soo daut jie bejriepen muchten met aul de Heilje, woont de Breed un de Lenjd un de Deep un de Hecht es, <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />un to erkjanen Christus siene Leew, dee aule Erkjantnis äwatraft, om daut jie muchten erfelt sennen met aul Gott siene Vollheit.<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />Oba to däm, dee doa äwamotich<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">Ooda: butajeweenlich.</char></note> doonen kaun äwa aules, waut wie bedden ooda vestonen kjennen, no de Krauft, dee en ons wirkjt, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />to däm de Iea en de Jemeent en Christus Jesus derch aule Tieden, von Eewichkjeit to Eewichkjeit! Amen.<verse eid="EPH 3:21" /></para>
  <para style="cl">Efeesa</para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">Eenichkjeit en Christus sien Kjarpa</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />Aulsoo, ekj bedd junt, ekj, de Jefangna en däm Harn, daut jie wirdich waundlen no de Beroopunk, to woone jie beroopen sent, <char style="rq"><ref loc="COL 1:10">Kol 1:10</ref>; <ref loc="1TH 2:12">1Tess 2:12</ref></char> <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" />met aule Deemoot un Saunftmoot, met Jedult, eena dän aundren vedroagen en de Leew. <char style="rq"><ref loc="COL 3:12-13">Kol 3:12-13</ref></char> <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />Siet flietich, de Eenheit vom Jeist to bewoaren en däm Frädens-Baunt. <char style="rq"><ref loc="COL 3:15">Kol 3:15</ref>; <ref loc="PHP 2:2">Flp 2:2</ref></char> <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />Doa es een Kjarpa un een Jeist, soo aus jie uk beroopen sent en eene Hopninj von june Beroopunk. <char style="rq"><ref loc="ROM 12:5">Ree 12:5</ref></char> <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />Een Har, een Gloowen, eene Doop, <char style="rq"><ref loc="1CO 8:6">1Kor 8:6</ref></char> <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />een Gott un Voda fa aula, dee äwa aula es un derch aula un en junt aula. <char style="rq"><ref loc="1CO 12:6">1Kor 12:6</ref></char><verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />Oba to eenem jiedren von ons es de Jnod jejäft no de Mot von Christus siene Gow. <char style="rq"><ref loc="ROM 12:3">Ree 12:3</ref>,<ref loc="ROM 12:6">6</ref>; <ref loc="1CO 12:11">1Kor 12:11</ref></char> <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />Doawäajen sajcht Hee: “Aus Hee noppjefoaren wia no de Hecht, fieed Hee de Jefangenschoft jefangen un jeef de Menschen Gowen”. <char style="rq"><ref loc="PSA 68:18">Ps 68:18</ref>; <ref loc="COL 2:15">Kol 2:15</ref></char> <verse eid="EPH 4:8" /><verse number="9" style="v" sid="EPH 4:9" />(Oba daut “Hee es noppjefoaren”, waut es daut aundasch, aus daut Hee ieescht raufjefoaren es en de unjaschte Städen von de Ieed? <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />Dee raufjefoaren es, es deeselwja, dee uk noppjefoaren es äwa aule Himmels, om daut Hee aules erfellen mucht.) <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />Un Hee jeef eenje aus Apostel un eenje aus Profeeten un eenje aus Evangelisten un eenje aus Hoads un Lierasch, <char style="rq"><ref loc="ACT 21:8">Apj 21:8</ref>; <ref loc="1CO 12:28">1Kor 12:28</ref></char> <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />om de Heilje vollkomen to moaken fa daut Woakj vom Deenst, fa daut Oppbuen von Christus sien Kjarpa, <char style="rq"><ref loc="1CO 14:26">1Kor 14:26</ref>; <ref loc="1PE 2:5">1Pe 2:5</ref></char> <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />bat wie aula aunkomen to de Eenheit vom Gloowen un to de Erkjantnis von Gott sien Sän, to eenem volljewosnen Maun, to de Mot von Christus siene volle Jestault; <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />soo daut wie nich mea onmindje Kjinja sent, dee romjeschmäten un romjedräwen woaren von jieda Wint von Lia, dee derch dän Menschenkonst kjemt, derch Hinjalest, äant toom Errtum to vefieren; <char style="rq"><ref loc="1CO 14:20">1Kor 14:20</ref>; <ref loc="HEB 13:9">Heb 13:9</ref>; <ref loc="JAS 1:6">Jak 1:6</ref></char> <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />oba de Woarheit räden en Leew, lot ons en aules waussen en däm nenn, dee daut Haupt es, Christus, <char style="rq"><ref loc="EPH 1:22">Efs 1:22</ref>; <ref loc="EPH 5:23">5:23</ref>; <ref loc="COL 1:18">Kol 1:18</ref></char> <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" />von woonem de gaunza Kjarpa aunenaunda toopjebut un vebungen es, derch daut Biedroagen von jieda Jelenkj, no de Mot von de Wirkjunk von jieda Jliet, fa daut Waussen vom Kjarpa, fa daut Oppbuen aun sikj selfst en Leew. <char style="rq"><ref loc="COL 2:19">Kol 2:19</ref></char><verse eid="EPH 4:16" /></para>
  <para style="s">Nieet Läwen en Christus</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />Dit saj ekj dan un bezeij en däm Harn, daut jie nich mea waundlen, soo aus de aundre Heiden waundlen, en de Nutzloosichkjeit von äa Senn, <char style="rq"><ref loc="ROM 1:21-24">Ree 1:21-24</ref></char> <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />dee äa Vestaunt vediestat es, aufjesondat von daut Läwen von Gott, derch de Onweetenheit, dee en äant es, wäajens daut Hoatwoaren von äa Hoat, <char style="rq"><ref loc="EPH 2:12">Efs 2:12</ref></char> <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />woone, wiels see aule Jefeelen veloaren haben, sikj de Onveschämtheit äwajäft haben, om aule Onreinichkjeit met Jiez ut to eewen. <verse eid="EPH 4:19" /><verse number="20" style="v" sid="EPH 4:20" />Oba jie haben Christus nich soo jelieet, <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />wan jie sest Am jehieet haben un en Am jelieet sent, soo aus de Woarheit en Jesus es: <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" />Daut jie, en waut dän verhäajen Waundel betraft, dän oolen Mensch auflajen, dee no de vefierarische Losten vedorwen es, <char style="rq"><ref loc="COL 3:9-10">Kol 3:9-10</ref>; <ref loc="ROM 8:13">Ree 8:13</ref>; <ref loc="GAL 6:8">Gal 6:8</ref></char> <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />un siet ernieet em Jeist von jun Senn, <char style="rq"><ref loc="ROM 12:2">Ree 12:2</ref></char> <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" />un trakjt dän nieen Mensch aun, dee no Gott jeschaufen es en Jerajchtichkjeit un woarhauftje Heilichkjeit.<verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />Doawäajen lajcht de Lieej auf un rät de Woarheit, een jiedra met sienem Näakjsten, wiels wie sent Jlieda unjarenaunda<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">Ooda: vonenaunda.</char></note>. <char style="rq"><ref loc="ZEC 8:16">Sach 8:16</ref></char> <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />Oajat junt, un sindicht nich. Lot de Sonn nich unjagonen äwa junem Oaja; <char style="rq"><ref loc="PSA 4:4">Ps 4:4</ref>; <ref loc="JAS 1:19-20">Jak 1:19-20</ref></char> <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />jäft däm Diewel uk nich Rum. <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />Wäa jestolen haft, saul nich mea stälen, oba saul väl mea oabeiden un met siene Henj waut Goodet schaufen, daut hee waut haft, däm to jäwen, dee Bederfnis haft. <char style="rq"><ref loc="EXO 20:15">2Mo 20:15</ref>; <ref loc="1TH 4:11">1Tess 4:11</ref></char> <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />Lot kjeen schlajchtet Jeräd ut jun Mul gonen, oba daut, waut goot es fa de needje Oppbuunk, soo daut et de Toohorcha Jnod jäwen mucht. <char style="rq"><ref loc="EPH 5:4">Efs 5:4</ref>; <ref loc="COL 4:6">Kol 4:6</ref></char> <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />Un betriept nich dän Heiljen Jeist von Gott, met däm jie vesäajelt worden sent fa dän Dach von de Erleesunk. <char style="rq"><ref loc="ISA 63:10">Jes 63:10</ref>; <ref loc="EPH 1:13-14">Efs 1:13-14</ref></char> <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />Aule Bettanis un Wutt un Oaja un Jeschrech un Lastrunk, lot wajch von junt, met aul de Boosheit toop. <char style="rq"><ref loc="COL 3:8">Kol 3:8</ref></char> <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" />Oba siet unjarenaunda frintlich, metliedent, vejäft eenaunda, jrod soo aus uk Gott junt en Christus vejäft haft. <char style="rq"><ref loc="MAT 6:14">Mat 6:14</ref>; <ref loc="MAT 18:22-35">18:22-35</ref>; <ref loc="COL 3:13">Kol 3:13</ref></char><verse eid="EPH 4:32" /></para>
  <para style="cl">Efeesa</para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">Waundelt en de Leew</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />Siet jie aulsoo Gott siene Nofolja, aus jeleewde Kjinja, <char style="rq"><ref loc="LUK 6:36">Luk 6:36</ref></char> <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />un waundelt en de Leew, soo aus uk Christus ons jeleeft un sikj selfst fa ons hanjejäft haft, aus een Opfa un Schlachtopfa fa Gott, fa een scheenrikjendet Jeroch. <char style="rq"><ref loc="GAL 2:20">Gal 2:20</ref></char> <verse eid="EPH 5:2" /><verse number="3" style="v" sid="EPH 5:3" />Oba Huararie un aule Onreinichkjeit ooda Habsucht, lot nich eenmol mank junt jenant woaren, soo aus sikj de Heilje daut jeziemt; <char style="rq"><ref loc="COL 3:5">Kol 3:5</ref></char> <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />uk nich schenteljet un noarischet Jeräd ooda Domheiten, woone junt nich jeziemen, oba väl mea Danksajen. <char style="rq"><ref loc="EPH 4:29">Efs 4:29</ref></char> <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />Wiels dit sell jie weeten, daut kjeen Huara ooda Onreina ooda Jiezja (dee een Jettadeena es), Oafdeel haft en daut Rikj von Christus un von Gott. <char style="rq"><ref loc="1CO 6:9-10">1Kor 6:9-10</ref>; <ref loc="REV 21:8">Opb 21:8</ref>; <ref loc="REV 22:15">22:15</ref></char> <verse eid="EPH 5:5" /><verse number="6" style="v" sid="EPH 5:6" />Lot kjeenem junt vefieren met ladje Wieed, wiels wäajens dise Dinja kjemt Gott sien Oaja äwa de Kjinja vom Ongloowen<note caller="+" style="f"><char style="fr" closed="false">5:6 </char><char style="ft" closed="false">Ooda: Onjehuarsom.</char></note>. <char style="rq"><ref loc="COL 3:6">Kol 3:6</ref></char> <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />Siet aulsoo nich äare Deelnäma.<verse eid="EPH 5:7" /></para>
  <para style="s">Waundelt em Licht</para>
  <para style="p">
    <verse number="8" style="v" sid="EPH 5:8" />Wiels jie wieren ieescht Diestanis, oba nu sent jie Licht en däm Harn; waundelt soo aus Kjinja vom Licht, <char style="rq"><ref loc="MAT 5:14">Mat 5:14</ref>; <ref loc="JHN 12:36">Joh 12:36</ref>; <ref loc="EPH 2:11">Efs 2:11</ref>; <ref loc="1TH 5:5">1Tess 5:5</ref>; <ref loc="1PE 2:9">1Pe 2:9</ref></char> <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />(wiels de Frucht vom Jeist es en aulet Goode un Jerajchtichkjeit un Woarheit), <char style="rq"><ref loc="GAL 5:22">Gal 5:22</ref>; <ref loc="PHP 1:11">Flp 1:11</ref></char> <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />endäm jie priefen, waut däm Harn wooljefellich es. <char style="rq"><ref loc="ROM 12:2">Ree 12:2</ref></char> <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />Un habt kjeene Jemeenschoft met de onfruchtboare Woakjen von de Diestanis, oba stroft dee välmea; <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />wiels waut em Jeheemen von äant passieet, es uk schentlich to sajen. <char style="rq"><ref loc="ROM 1:24">Ree 1:24</ref></char> <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />Oba aul de Dinja, dee jestroft woaren, woaren vom Licht openboa jemoakt, wiels wautemma openboa moakt, es Licht. <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />Doawäajen sajcht Hee: Wakj opp, dee du schlapst, un sto opp von de Doodje, dan woat Christus die Licht jäwen. <char style="rq"><ref loc="ISA 60:1">Jes 60:1</ref>; <ref loc="JHN 3:20-21">Joh 3:20-21</ref>; <ref loc="JHN 8:12">8:12</ref>; <ref loc="ROM 13:11">Ree 13:11</ref></char><verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />Kjikjt aulsoo, woo jie väasechtich waundlen, nich soo aus Onweise, oba aus Weise, <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" />de Tiet utkjeepen, wiels de Doag sent beese. <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />Doawäajen siet nich onvestendich, oba vestendich, waut däm Harn sien Wellen es. <verse eid="EPH 5:17" /><verse number="18" style="v" sid="EPH 5:18" />Un bedrinkjt junt nich met Wien, wuarenn Heillooset es, oba woat voll vom Jeist, <char style="rq"><ref loc="LUK 21:34">Luk 21:34</ref></char> <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" />endäm jie metenaunda räden en Psalmen un Lowleeda un jeistliche Leeda, sinjen un spälen fa dän Harn en jun Hoat, <char style="rq"><ref loc="PSA 33:2-3">Ps 33:2-3</ref>; <ref loc="COL 3:16">Kol 3:16</ref></char> <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />emma dank jäwen fa aules däm Gott un Voda en däm Nomen von ons Har Jesus Christus, <char style="rq"><ref loc="1TH 5:18">1Tess 5:18</ref></char> <verse eid="EPH 5:20" /><verse number="21" style="v" sid="EPH 5:21" />junt eena däm aundren unjastalen en de Forcht Gottes. <char style="rq"><ref loc="1PE 5:5">1Pe 5:5</ref></char><verse eid="EPH 5:21" /></para>
  <para style="s">Fa Mana un Frues</para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />Frues, siet june ieejne Mana unjadon, soo aus däm Harn. <char style="rq"><ref loc="GEN 3:16">1Mo 3:16</ref>; <ref loc="1TI 2:11-12">1Tim 2:11-12</ref>; <ref loc="TIT 2:5">Tit 2:5</ref></char> <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />Wiels de Maun es daut Haupt von de Fru, jrod soo aus Christus daut Haupt es von de Jemeent, un Hee es de Rada von däm Kjarpa. <char style="rq"><ref loc="1CO 11:3">1Kor 11:3</ref>; <ref loc="EPH 1:22-23">Efs 1:22-23</ref></char> <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />Oba jrod soo aus de Jemeent Christus unjadon es, soo uk de Frues äare ieejne Mana en aules.<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />Jie Mana, leeft june ieejne Frues, soo aus uk Christus de Jemeent jeleeft un sikj selfst fa ar hanjejäft haft, <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />om daut Hee ar kunn heiljen un reinjen derch daut Wauschen von Wota derch daut Wuat, <char style="rq"><ref loc="TIT 3:5">Tit 3:5</ref>; <ref loc="HEB 10:22">Heb 10:22</ref></char> <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />soo daut Hee ar fa sikj selfst mucht doastalen, eene veharlichte Jemeent, dee nich eene Plak ooda Veknutschtet ooda irjent soowaut haft, oba daut see mucht heilich sennen un onen Fäla. <char style="rq"><ref loc="2CO 11:2">2Kor 11:2</ref>; <ref loc="COL 1:22">Kol 1:22</ref></char> <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />Jrod soo sellen uk de Mana äare ieejne Frues leewen, soo aus äare ieejne Kjarpasch; wäa siene ieejne Fru leeft, dee leeft sikj selfst. <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />Wiels kjeena haft jeemols sien ieejnet Fleesch jehaust, oba hee näat un fläajcht daut, jrodsoo aus uk Christus de Jemeent. <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />Wiels wie sent Jlieda von sien Kjarpa, von sien Fleesch un von siene Knoakes. <char style="rq"><ref loc="EPH 1:23">Efs 1:23</ref></char> <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />“Doawäajen woat een Mensch sienen Voda un Mutta veloten un siene Fru aunhenjen, un dee twee woaren een Fleesch sennen.” <char style="rq"><ref loc="GEN 2:24">1Mo 2:24</ref></char> <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />Dit Jeheemnis es groot; oba ekj saj dit von Christus un siene Jemeent. <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />Doch uk jie, lot eenem jiedren siene ieejne Fru soo leewen aus sikj selfst; oba de Fru, daut see däm Maun Ieaforcht jeft.<verse eid="EPH 5:33" /></para>
  <para style="cl">Efeesa</para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">Fa Kjinja un Elren</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />Kjinja, siet june Elren jehuarsom en däm Harn, wiels daut es rajcht. <char style="rq"><ref loc="MRK 7:10-13">Mrk 7:10-13</ref></char> <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />Iea dienen Voda un Mutta, daut es daut ieeschte Jeboot, daut eene Vespräakjunk haft, <char style="rq"><ref loc="EXO 20:12">2Mo 20:12</ref></char> <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />soo daut die daut goot jeit un du lang läfst opp Ieeden. <char style="rq"><ref loc="DEU 5:16">5Mo 5:16</ref></char><verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />Un jie Vodasch, reizt june Kjinja nich toom Oaja, oba trakjt dee opp en de Belierunk un Vemonunk vom Harn. <char style="rq"><ref loc="DEU 6:20-25">5Mo 6:20-25</ref></char><verse eid="EPH 6:4" /></para>
  <para style="s">Deena un äare Haren</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />Kjnajchts, siet june fleeschliche Haren jehuarsom met Forcht un Zetren, en de Eenfachheit von jun Hoat, soo aus to Christus; <char style="rq"><ref loc="1TI 6:1-2">1Tim 6:1-2</ref>; <ref loc="TIT 2:9-10">Tit 2:9-10</ref>; <ref loc="1PE 2:18">1Pe 2:18</ref></char> <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />nich met Uagen-Deenst, aus Menschen-jefaulende, oba aus Christus siene Kjnajchts, wäarent jie Gott sien Wellen vom Hoaten doonen. <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />Deent met eenem gooden Wellen, aus däm Harn un nich de Menschen, <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />wiels jie weeten, wautemma fa Goodet irjentwäa deit, daut hee dautselwje vom Harn kjrieen woat, auf hee een Sklow es ooda een Fria. <char style="rq"><ref loc="2CO 5:10">2Kor 5:10</ref></char><verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />Un jie Haren, doot äant dautselwje un lot daut Dreiwen toch, wiels jie weeten, daut jun Har uk em Himmel es un daut doa bie Am kjeen Aunseenen von de Persoon es.<verse eid="EPH 6:9" /></para>
  <para style="s">Gott sien gaunzet Jescherr</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />Tolatst, miene Breeda, siet stoakj em Harn un en de Macht von siene Krauft. <char style="rq"><ref loc="EPH 3:16">Efs 3:16</ref>; <ref loc="1CO 16:13">1Kor 16:13</ref>; <ref loc="2TI 2:1">2Tim 2:1</ref>; <ref loc="1JN 2:14">1Joh 2:14</ref></char> <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />Trakjt junt Gott sien gaunzet Jescherr aun, soo daut jie bestonen kjennen jäajen de lestje Wäaj vom Diewel. <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />Wiels ons Kaumf es nich jäajen Fleesch un Bloot, oba jäajen Ferschtentiema, jäajen Jewaulten, jäajen de Harscha von de Diestanis von dise Welt, jäajen jeistliche Boosheit en himlische Städen. <char style="rq"><ref loc="LUK 22:31">Luk 22:31</ref>; <ref loc="EPH 2:2">Efs 2:2</ref></char> <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />Doawäajen nämt Gott sien gaunzet Jescherr, daut jie aun däm beesen Dach wadastonen kjennen un aules jedonen haben, stonen to bliewen. <verse eid="EPH 6:13" /><verse number="14" style="v" sid="EPH 6:14" />Soo stot nu, june Hoften met de Woarheit omjeschnalt un aunjetrocken met daut Brostschilt von de Jerajchtichkjeit <char style="rq"><ref loc="LUK 12:35">Luk 12:35</ref>; <ref loc="1TH 5:8">1Tess 5:8</ref>; <ref loc="1PE 1:13">1Pe 1:13</ref></char> <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />un aun de Feet jeschoot met daut Reedsennen vom Evangelium von däm Fräd. <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />Äwa aules oba nämt daut Schilt vom Gloowen opp, met woont jie aul de fieeje Feilen von däm Beesen utlaschen kjennen. <char style="rq"><ref loc="1PE 5:9">1Pe 5:9</ref>; <ref loc="1JN 5:4">1Joh 5:4</ref></char> <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />Un nämt dän Schutzhelm von de Radunk un daut Schwieet vom Jeist, woont Gott sien Wuat es. <char style="rq"><ref loc="1TH 5:8">1Tess 5:8</ref>; <ref loc="HEB 4:12">Heb 4:12</ref></char> <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />Un bät to aule Tiet met aulem Jebäd un Bedden em Jeist, un hiatoo woakt met aulem Aunhoolen un Bedden fa aul de Heilje <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />un fa mie, daut mie daut Wuat jejäft woat, soo daut ekj mien Mul met Friemoot opmoak, daut Jeheemnis vom Evangelium bekaunt to moaken, <char style="rq"><ref loc="ACT 4:29">Apj 4:29</ref>; <ref loc="COL 4:3">Kol 4:3</ref>; <ref loc="2TH 3:1">2Tess 3:1</ref></char> <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />fa woont ekj een Bootschofta sie en Kjäden, om daut ekj doarenn friemootich räd, soo aus ekj räden saul. <char style="rq"><ref loc="ACT 28:31">Apj 28:31</ref>; <ref loc="2CO 5:20">2Kor 5:20</ref></char><verse eid="EPH 6:20" /></para>
  <para style="s">Gruss un Säajenswunsch</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />Oba om daut uk jie miene Omstend weeten, woo mie daut jeit, woat Tiechikus, de leewa Brooda un trua Deena em Harn, junt aules to weeten doonen, <char style="rq"><ref loc="ACT 20:4">Apj 20:4</ref>; <ref loc="COL 4:8">Kol 4:8</ref>; <ref loc="2TI 4:12">2Tim 4:12</ref>; <ref loc="TIT 3:12">Tit 3:12</ref></char> <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />woonen ekj doawäajen no junt jeschekjt hab, om daut jie onse Omstend weeten un hee june Hoaten treesten mucht. <verse eid="EPH 6:22" /><verse number="23" style="v" sid="EPH 6:23" />Fräd met de Breeda un Leew met Gloowen von Gott, däm Voda, un däm Harn Jesus Christus! <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />De Jnod met aul dee, dee onsen Harn Jesus Christus leef haben en Opprechtichkjeit! Amen. <char style="add">No de Efeesa jeschräwen von Room, derch Tiechikus.</char><verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>