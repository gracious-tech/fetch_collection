<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Plautdietsch</book>
  <para style="h">De dredda Breef von Johanes</para>
  <para style="toc3">3Joh</para>
  <para style="toc2">3Joh</para>
  <para style="toc1">De dredda Breef von Johanes</para>
  <para style="mt1">De dredda Breef von Johanes</para>
  <para style="cl">3. Johanes</para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">Gruss</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />De Eltesta, aun Gajus, dän Jeleewden, dän ekj en de Woarheit leew. <char style="rq"><ref loc="2JN 1:1">2Joh 1:1</ref></char> <verse eid="3JN 1:1" /><verse number="2" style="v" sid="3JN 1:2" />Jeleewda, ekj wensch äwa aules, daut du muchst Erfolch haben un jesunt sennen, soo aus uk diene Seel erfolchrikj es. <char style="rq"><ref loc="2JN 1:4">2Joh 1:4</ref></char> <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />Wiels ekj freid mie sea, aus Breeda kjeemen un von diene Woarheit<note caller="+" style="f"><char style="fr" closed="false">1:3 </char><char style="ft" closed="false">Ooda: de Woarheit en die.</char></note> zeijden, jrodsoo aus du en de Woarheit waundelst. <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />Ekj hab kjeene jratre Freid aus dee, daut ekj hia, daut miene Kjinja en de Woarheit waundlen.<verse eid="3JN 1:4" /></para>
  <para style="s">Unjastettunk un Jäajenstaunt</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />Jeleewda, du haundelst tru en däm, waut du aun de Breeda un aun de Framde deist, <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />dee von diene Leew Zeichnis jejäft haben ver de Jemeent; un du woascht goot doonen, wan du äant wieda brinjst, wirdich ver Gott. <char style="rq"><ref loc="TIT 3:13">Tit 3:13</ref></char> <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />Wiels om sien Nomens haulwen sent see rutjegonen un nämen nuscht von de Heiden. <char style="rq"><ref loc="1CO 9:12">1Kor 9:12</ref></char> <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />Doawäajen sull wie soone oppnämen, om daut wie muchten Metoabeida fa de Woarheit sennen. <char style="rq"><ref loc="HEB 13:2">Heb 13:2</ref></char><verse eid="3JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />Ekj schreef aun de Jemeent, oba Diotrefes, dee jieren well de Väaschta mank äant sennen, nemt ons nich opp. <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />Doawäajens, wan ekj kom, well ekj am aun siene Woakjen denkjen-halpen, dee hee deit, wäarent hee met beese Wieed jäajen ons pludat; un am es daut nich jenuach, hee selfst nemt uk nich de Breeda opp un wäat dee, dee daut doonen wellen un stat äant ut de Jemeent.<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />Jeleewda, doo daut Beese nich no-open, oba daut Goode. Wäa Goodet deit, dee es von Gott; wäa oba Beeset deit, haft Gott nich jeseenen. <verse eid="3JN 1:11" /><verse number="12" style="v" sid="3JN 1:12" />Däm Demetrius woat von aulem, un von de Woarheit selfst, goodet Zeichnis jejäft; un wie zeijen uk, un jie weeten, daut ons Zeichnis woarhauftich es.<verse eid="3JN 1:12" /></para>
  <para style="s">Schluss Jriss</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />Ekj haud väl to schriewen, oba ekj well die nich met Tint un Fada schriewen, <char style="rq"><ref loc="2JN 1:12">2Joh 1:12</ref></char> <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />oba ekj hop, die boolt to seenen, un wie wellen mintlich unjarenaunda räden. <verse eid="3JN 1:14" /><verse number="15" style="v" sid="3JN 1:15" />Fräd met die! Doa jreessen die de Frind. Jrees de Frind biem Nomen.<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>