<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="MRK" style="id">Dai-Chin: Bible Translation 1st Edition</book>
  <para style="ide">Unicode (UTF-8)</para>
  <para style="h">Makuh</para>
  <para style="toc1">MAKUHA Yuk Thangkdaw</para>
  <para style="toc2">Makuh</para>
  <para style="toc3">Mk</para>
  <para style="mt1">MAKUHA</para>
  <para style="mt2">Yuk Thangkdaw</para>
  <para style="imt">Pyenhlüma</para>
  <para style="ip">
    <char style="bk">Makuha yuk thangkdaw</char> “Hin hin Mhnama capa Jesuh Khritawa mawng, thangkdaw ni” tia cuteiki. Jesuh cun khutbinak la ana takia khyanga ngdangsaka kyaki. A ana cun a mtheimthangnake, ngmüimkhya kse he a ja nängnak, la khyang hea katnak he a jah mhlätnak üng hmuha kyaki. Jesuh naw amät cun katnak üngka naw jah mhlät lü a xünnak jah pe khaia lawkia khyanga capa, ti lü a pyen.</para>
  <para style="ip">
    <char style="bk">Makuh</char> naw Jesuha jah mtheimthangnak la a ngthukhyü hea kthaka, Jesuha a bilawh he ngsingkhai bawk khaia jah mdangki. Baptican pekia Johan, Baptican a khannak la Jesuh naw hlawhlep a khamnaka mawng aktawia a jah pyen käna, Jesuha khutbi, a jah yaisaknak la a jah mtheimthangnake jah mdangki. Akcün bäih läk läk se Jesuha a hnukläk he naw ani cun akdawa ami ksing law däm däm. Cunsepi Jesuh am hlüeiki he naw hneng law ksehlenkie. Abäihnaka akyangdäm üng Jesuh khawmdeka a xün a bäihnaka khyün üng, ami taihnak la a thawhnak bea mawng he mi jah hmuki.</para>
  <para style="ip">Thangkdawa bäihnak nghngih cun, <char style="bk">Makuh</char> naw am yuk lü khyang kcea yuk bea ngaiha kyaki.</para>
  <para style="iot">Amawng Ktawi he</para>
  <para style="io1">Thangkdawa cuteinak <char style="ior">(<ref loc="MRK 1:1-13">1:1-13</ref>)</char></para>
  <para style="io1">Jesuh Kalile khaw üng khut a binak <char style="ior">(<ref loc="MRK 1:14-9:50">1:14—9:50</ref>)</char></para>
  <para style="io1">Kalile üngka naw Jerusalem mlüha <char style="ior">(<ref loc="MRK 10:1-52">10:1-52</ref>)</char></para>
  <para style="io1">Abäihnaka khyün la Jerusalema pipei <char style="ior">(<ref loc="MRK 11:1-15:47">11:1—15:47</ref>)</char></para>
  <para style="io1">Jesuha thawhnak be <char style="ior">(<ref loc="MRK 16:1-8">16:1-8</ref>) </char></para>
  <para style="io1">Thobeki Bawipa ngdangnak la khana a kainak be <char style="ior">(<ref loc="MRK 16:9-20">16:9-20</ref>)</char></para>
  <chapter number="1" style="c" sid="MRK 1"/>
  <para style="s">Baptican Saja Johana Ngthu pyen</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mt 3:1-12</ref>; <ref loc="LUK 3:1-18">Lk 3:1-18</ref>; <ref loc="JHN 1:19-28">Jn 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1"/>Hin hin Pamhnama Capa<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">Pamhnama Capa </char><char style="ft" closed="false">tia avang üng am ami yuk si. </char></note> Jesuh Khritawa mawng Thangkdaw ni.<verse eid="MRK 1:1"/></para>
  <para style="q1">
    <verse number="2" style="v" sid="MRK 1:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:2:</char>
      <char style="xt" closed="false">
        <ref loc="MAL 3:1">Mal 3:1</ref>
      </char>
    </note>“Pamhnam naw, ‘na maa ka ngsä,</para>
  <para style="q2" vid="MRK 1:2">lam pyang khaia ka tüi law khai.’<verse eid="MRK 1:2"/></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:3: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 40:3">Hesa 40:3</ref> (LXX)</char>
    </note>Khyang mat, khawkhyawng khawa ngpyangki naw,</para>
  <para style="q2" vid="MRK 1:3">‘Bawipa a lam pyang ua;</para>
  <para style="q2" vid="MRK 1:3">a cehnak vai lam ngdüngsak ua!’ a ti” tia, akphyüma sahma Hesajah naw, a yuka kba.<verse eid="MRK 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4"/>Acunüng, Johan khawkhyawng khawa ngdang law lü, baptican jah pe law lü, jah mtheimthang law lü,<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="fq" closed="false">Johan khawkhyawng khawa ngdang law lü, baptican jah pe law lü, jah mtheimthang law lü ft ti cun avang üng Johan khawkhyawng khawa ngdang law lü, jah mtheimthang law lü </char><char style="ft" closed="false">tia ng'yuki. </char></note> “Nami katnak nghlata u lü Baptican khan ua, Pamhnam naw nami katnak he ning jah mhlät khai ni,” a ti. <verse eid="MRK 1:4"/><verse number="5" style="v" sid="MRK 1:5"/>Acunüng, Judah khaw la Jerusalem mlüha khyang he ngthu ngai khaia Johana veia citki he. Ami katnak he jah phyeh u se Jordan tuinu üng Johan naw baptican a jah khansak.<verse eid="MRK 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:6:</char>
      <char style="xt" closed="false">
        <ref loc="2KI 1:8">2Sang 1:8</ref>
      </char>
    </note>Johan cun samu am ami pyan suisak suisa lü, savunksawmyüi a kcawi üng vawp lü, mkhaü he la mawkpyawnga khawitui jah ei awki. <verse eid="MRK 1:6"/><verse number="7" style="v" sid="MRK 1:7"/>Johan naw sang lü, “Ka hnua law khaia khyang ta keia kthaka kyäp bawk ve, kei cun kawp lü a khawdawkyüi ka kphyan pe khaia pi am ka ngkawihki ni. <verse eid="MRK 1:7"/><verse number="8" style="v" sid="MRK 1:8"/>Kei naw tui am baptican ka ning jah peki, cunsepi ani naw Ngmüimkhya Ngcim am Baptican ning jah pe khai,” a ti.<verse eid="MRK 1:8"/></para>
  <para style="s">Baptican la Jesuh hlawhlepnak</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">Mt 3:13—4:11</ref>; <ref loc="LUK 3:21">Lk 3:21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9"/>Acun käna ivei am ngsawk se, Jesuh Kalile khaw Nazaret üngka naw law se, Johan naw Jordan tuinu üng baptican a pet. <verse eid="MRK 1:9"/><verse number="10" style="v" sid="MRK 1:10"/>Tui üngka naw angxita a thawh law be üng, khankhaw nghmawng law lü, Ngmüimkhya cun mümca kba a khana kyum law se a hmuh. <verse eid="MRK 1:10"/><verse number="11" style="v" sid="MRK 1:11"/><note caller="-" style="x"><char style="xo" closed="false">1:11: </char><char style="xt" closed="false"><ref loc="GEN 22:2">Gen 22:2</ref>; <ref loc="PSA 2:7">Sal 2:7</ref>; <ref loc="ISA 42:1">Hesa 42:1</ref>; <ref loc="MAT 3:17">Mt 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">Mk 9:7</ref>; <ref loc="LUK 3:22">Lk 3:22</ref></char></note>Acunüng khankhaw üngka kthai naw, “Nang, ka ning jawng'engnak kcanga ka Capa, na khana ka je leng lengki,” tia, ngthang lawki.<verse eid="MRK 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12"/>Acun la Ngmüimkhya naw khawkhyawng khawa a tüih. <verse eid="MRK 1:12"/><verse number="13" style="v" sid="MRK 1:13"/>Acuia khawmhmüp kphyükip khawyam naw hlawhlep se awmki. Khisa he pi awmki he, acunüngpi khankhawngsä he naw law u lü ami msümcei law.<verse eid="MRK 1:13"/></para>
  <para style="s">Jesuh naw ngaksui kphyü a jah khü</para>
  <para style="r">(<ref loc="MAT 4:12-22">Mt 4:12-22</ref>; <ref loc="LUK 4:14">Lk 4:14</ref>,<ref loc="LUK 4:15">15</ref>; <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14"/>Johan thawngim üng ami khyum käna, Jesuh Kalile khawa cit lü, Mhnama Thangkdaw pyen hü lü, <verse eid="MRK 1:14"/><verse number="15" style="v" sid="MRK 1:15"/><note caller="-" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">Mt 3:2</ref></char></note><char style="wj">“Akcün pha lawpäng ve, Mhnama khaw ng’et law ve! Nami katnak he jah nghlata u lü, thangkdaw jum ua!”</char> a ti.<verse eid="MRK 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16"/>Kalile tuili kama Jesuh a ceh üng, Sihmon la a na Andru ngvai vawiki xawi jah hmu lü, <verse eid="MRK 1:16"/><verse number="17" style="v" sid="MRK 1:17"/>Jesuh naw, <char style="wj">“Na läk law nia, kei naw khyang man khaia ka ning jah mthei khai,”</char> a ti. <verse eid="MRK 1:17"/><verse number="18" style="v" sid="MRK 1:18"/>Acunüng angxita ani ngvai jah yawk hüt ni lü, Jesuha hnu läki xawi.<verse eid="MRK 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19"/>Acun üngka naw, asäng va cit lü, Zebedea capa Jakuk la a na Johan, mlawnga khana ani ngvai jah na pyangei ni se a jah hmuh. <verse eid="MRK 1:19"/><verse number="20" style="v" sid="MRK 1:20"/>Jesuh naw a jah hmuh la jah khü se, ani pa Zebede la mlawnga khana ani jah ngvaha khyang he jah yawk hüt ni lü, Jesuha hnu läki xawi.<verse eid="MRK 1:20"/></para>
  <para style="s">Ngmüimkhyakse Mata Awmnaka Khyang Mat</para>
  <para style="r">(<ref loc="LUK 4:31-37">Lk 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21"/>Jesuh la axüisaw he Kapenawm mlüha law u se, angawi Sabbath mhmüp üng Jesuh naw Sinakok k’uma lut lü, a jah mthei. <verse eid="MRK 1:21"/><verse number="22" style="v" sid="MRK 1:22"/><note caller="-" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">Mt 7:28</ref>,<ref loc="MAT 7:29">29</ref></char></note>Thum jah mtheiki hea kba am kya lü, ana takia kba jah mthei se khyang he aktäa cäiki he.<verse eid="MRK 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23"/>Acunüng, ami Sinakoka k’uma khyang mat, ngmüimkhyaksea awmnak naw, <verse eid="MRK 1:23"/><verse number="24" style="v" sid="MRK 1:24"/>“Nazaret Jesuh aw, i mi nglak ve se ja? Na jah kpyeh khaia na lawki aw? Nang u ti ka ksingki. Nang cun Mhnama ngsä ngcim ni!” ti lü, ngpyangki.<verse eid="MRK 1:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25"/>Jesuh naw, “Ä khihkhe lü, a k’um üngka naw, angxita lut lawa,” ti lü, ngmüimkhya kse a ksät. <verse eid="MRK 1:25"/><verse number="26" style="v" sid="MRK 1:26"/>Khawyai naw acuna khyang cun ksün lü, angsanga ngpyang lü, lut lawki. <verse eid="MRK 1:26"/><verse number="27" style="v" sid="MRK 1:27"/>Khyang he ami van cäi law u lü, “Hin hin ia ngkhaw ni? Ahina mtheimthangnak hin akthai am niki aw? Ana takia kba khawyai he pi jah ksät se, a pyen ngaiki he hin,” tia mat la mat ngthähki he.<verse eid="MRK 1:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28"/>Acun la angxita, Kalile khaw avan üng Jesuha mawng ngthang hüki.<verse eid="MRK 1:28"/></para>
  <para style="s">Jesuh naw Khyang Khawjah a jah M’yai</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mt 8:14-17</ref>; <ref loc="LUK 4:38-41">Lk 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29"/>Jesuh la axüisaw he Sinakok üngka naw lut law u lü, Jakuk la Johan am, Sihmon la Andrua ima cit ktäiki he. <verse eid="MRK 1:29"/><verse number="30" style="v" sid="MRK 1:30"/>Sihmona pi, mhnatei se ngjänki, Jesuh a pha law la ami mtheh. <verse eid="MRK 1:30"/><verse number="31" style="v" sid="MRK 1:31"/>Jesuh naw a veia cit lü, a kut üng kaih lü, a mthawh la mhnat naw khya se, acun la a jah khinak.<verse eid="MRK 1:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32"/>Mü lam khawkyak käna, am phetki he avan la khawyai he naw a jah awmnak avan he cun Jesuha veia ami jah lawpüi. <verse eid="MRK 1:32"/><verse number="33" style="v" sid="MRK 1:33"/>Mlüh üngka khyang avan mkawt maa ngcun lawki he. <verse eid="MRK 1:33"/><verse number="34" style="v" sid="MRK 1:34"/>Jesuh naw natnak ahmäi hmäia phäha am phetki he jah m’yai be lü khawyai he a jah ksät. Khawyai he naw ani cun ami ksinga phäha ani naw ä a jah ngthuheisak.<verse eid="MRK 1:34"/></para>
  <para style="s">Jesuh Kalilea Ngthu pyenki</para>
  <para style="r">(<ref loc="LUK 4:42-44">Lk 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35"/>Ngawi lam khaw am a thaih phat üng, Jesuh tho law lü im ceh ta lü, anghinaka hmüna cit lü, va ktaiyüki. <verse eid="MRK 1:35"/><verse number="36" style="v" sid="MRK 1:36"/>Cunsepi Sihmon la a püi he cun Jesuh sui khai hea citki he. <verse eid="MRK 1:36"/><verse number="37" style="v" sid="MRK 1:37"/>Acunüng, ami hmuh law üng, “Khyang avan naw ning suihüki he ni,” ami ti.<verse eid="MRK 1:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38"/>Cunsepi, Jesuh naw, <char style="wj">“Ahina pipei ngnam hea pi, ngthu ka pyen khaia mi cit khai, acun vaia ni kei ka law,” </char>a ti.<verse eid="MRK 1:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:23">Mt 4:23</ref>; <ref loc="MAT 9:35">9:35</ref></char>
    </note>Acukba, Jesuh cun Kalile khaw avan üng cit hü lü, Sinakok hea ngthu pyen hü lü, khawyai he pi jah ksätki.<verse eid="MRK 1:39"/></para>
  <para style="s">Jesuh naw Khyang mat a M’yai</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mt 8:1-4</ref>; <ref loc="LUK 5:12-16">Lk 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40"/>Mnehkse mnehki khyang mat Jesuha veia law lü, a mkhuk ngdäng lü, “Na hlüei üng ta, na na ngcimcaihsak theiki ni,” ti lü, a nghuinak.<verse eid="MRK 1:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41"/>Jesuh naw m'yeneinak<note caller="+" style="f"><char style="fr" closed="false">1:41 </char><char style="fq" closed="false">m'yeneinak avang üng mlungsonak tia ng'yuki. </char></note> am a kut sängki naw hnet lü, <char style="wj">“Ä, hlüei veng, ngcima,” </char>a ti. <verse eid="MRK 1:41"/><verse number="42" style="v" sid="MRK 1:42"/>Acukba a pyen la angxita mnehkse cun khyük se, ani cun ngcimcai law beki. <verse eid="MRK 1:42"/><verse number="43" style="v" sid="MRK 1:43"/>Acunüng Jesuh naw ksükki naw a tüih be. <verse eid="MRK 1:43"/><verse number="44" style="v" sid="MRK 1:44"/><note caller="-" style="x"><char style="xo" closed="false">1:44</char><char style="xt" closed="false"><ref loc="LEV 14:1-32">Lev 14:1-32</ref></char></note>Acukba a pyen käna, <char style="wj">“U am icapi ä na mtheh vai, cit lü, ktaiyü am na va ngtengei kyusak vai, acunüng Mosi naw a jah mtheha kba, na ngcimcainak ami msingnak vaia ngkengnak va pawha,” </char>ti lü a tüih be.<verse eid="MRK 1:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45"/>Cunsepi, acuna khyang naw cit lü acuna mawng cun avan üng va sang hü se, Jesuh angdanga mlüh k’uma am lut thei lü anghinaka awmki. Acuia, khyang pung akce kce üngka he naw ami ceh si.<verse eid="MRK 1:45"/></para>
  <chapter eid="MRK 1"/>
  <chapter number="2" style="c" sid="MRK 2"/>
  <para style="s">Jesuh naw Akxo a M’yai be</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mt 9:1-8</ref>; <ref loc="LUK 5:17-26">Lk 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1"/>Khaw mhmüp asäng ngsawk se Jesuh Kapenawma cit be lü ima awmki tia mawng cun ngthang hüki. <verse eid="MRK 2:1"/><verse number="2" style="v" sid="MRK 2:2"/>Ami luhnak vai khuiim am nghäng lü, mkawt peia pi thetkia, khyang khawjah ngcun lawki he. Acunüng Jesuh naw ngthu pyenki. <verse eid="MRK 2:2"/><verse number="3" style="v" sid="MRK 2:3"/>Acunüng, akxo cun khyang kphyü naw kawt u lü, Jesuha veia ami lawpüi. <verse eid="MRK 2:3"/><verse number="4" style="v" sid="MRK 2:4"/>Khuiima khyang be se, Jesuha veia am ami cehpüi thei. Acunakyase Jesuha ngdanga mkyung ami kpäk. Acunüng mkyung kpäk lawpäng u lü akxo cun a ihnak phak mah maha ami ju khyak. <verse eid="MRK 2:4"/><verse number="5" style="v" sid="MRK 2:5"/>Jesuh naw ihlawka ami jumeinak dämki ti hmu lü, akxo üng, <char style="wj">“Ka capa aw, na katnak he cun jah mhlät pänga kya ve,”</char> a ti.<verse eid="MRK 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6"/>Acunüng thum jah mtheiki avang ngawki he naw ami mlungmthin k’uma ngai kyu u lü, <verse eid="MRK 2:6"/><verse number="7" style="v" sid="MRK 2:7"/>“I vaia hina khyang naw Mhnam ksekhanaka ngthu a pyen ni? Mhnama thea ta u naw katnak he jah mhlät thei khai ni?” ami ti.<verse eid="MRK 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8"/>Jesuh naw acunkba ami ngaihkyu cun angxita ksing lü, <char style="wj">“I vai acunkba nami ngaikyuki ni? </char> <verse eid="MRK 2:8"/><verse number="9" style="v" sid="MRK 2:9"/><char style="wj">“Ini akxoa veia pyen a jäi bawk kawm? Na katnak he jah mhlät pänga kya ve ti la; tho law lü na ihphak lo lü cita ti aw a jäi bawk?</char> <verse eid="MRK 2:9"/><verse number="10" style="v" sid="MRK 2:10"/><char style="wj">Khyanga Capa naw khawmdek khana katnak he jah mhlät theinaka ana taki ti nami ksingnak vaia ka mdang khai,” </char>ti lü, akxo üng, <verse eid="MRK 2:10"/><verse number="11" style="v" sid="MRK 2:11"/><char style="wj">“Ka ning mthehki, tho law, na ihphak lo lü, na ima cit bea,” </char>a ti.<verse eid="MRK 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12"/>Avan naw ami teng k’um üng tho law lü, a ihphak lo lü, cit se aktäa cäi u lü, Mhnam mhlünmtai u lü, “Hina mäih am mi hmu khawi naw!” tia ng’yüngki he.<verse eid="MRK 2:12"/></para>
  <para style="s">Jesuh naw Levih a Khü</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mt 9:9-13</ref>; <ref loc="LUK 5:27-32">Lk 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13"/>Jesuh Kalile tuili kama cit beki. A veia khyang he law u se, Jesuh naw a jah mthei. <verse eid="MRK 2:13"/><verse number="14" style="v" sid="MRK 2:14"/>A ceh lama, Levih naki Alphaha capa ngcawnklawk junga ngaw se hmu lü, <char style="wj">“Na läk lawa,” </char>ti se, Levih naw ngdüi law lü a läk.<verse eid="MRK 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15"/>Acun käna Jesuh cun Leviha ima<note caller="+" style="f"><char style="fr" closed="false">2:15 </char><char style="fq" closed="false">Leviha ima </char><char style="ft" closed="false">am acunüng ania ima </char></note> ei eiki. Ngcawnklawk he la akxawi he am Jesuh la axüisaw he ei ei khaia atänga ngaw hmaihki he. Isetiakyaüng, acuia awmki he cun khawjah law u lü, ami van naw Jesuh ami läka phäha kyaki. <verse eid="MRK 2:15"/><verse number="16" style="v" sid="MRK 2:16"/>Acukba Jesuh ngcawnklawk he la khyangka he am ei aw hmaih u se Mosia Thum jah mtheikia pharise he naw ami hmu üng, axüisaw he üng, “Ise hin naw ngcawnklawk he la khyangka hea veia ei aw hngaki ni? ti u se,<verse eid="MRK 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17"/>Acunüng Jesuh naw ngja lü, <char style="wj">“Khyang kphetyai he naw Seibawi am hlü u, am phetyaikie naw ni Seibawi ami hlü, kei hin khyang ngsungpyune jah khü khaia am law lü khyangka he ngjutnaka jah khü khaia ni ka law,”</char> a ti.<verse eid="MRK 2:17"/></para>
  <para style="s">Ei Jeihnaka Mawng Ngthähnak</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mt 9:14-17</ref>; <ref loc="LUK 5:33-39">Lk 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18"/>Johana axüisaw he la pharise he naw ei jeihki he. Mhmüp mat üng khyang avang Jesuha veia law u lü, “Johana axüisaw he la pharise he naw ami ei jeihki he, ise nanga xüisaw he naw ami ei am jeihki he ni?” tia ami kthäh. <verse eid="MRK 2:18"/><verse number="19" style="v" sid="MRK 2:19"/>Acunüng Jesuh naw, <char style="wj">“Khin he cun cambumkia cangpyang ami veia a awma küt üng ami ei ka cit be khai he aw? Cangpyang ami junga a awma küt üng ami ei am jeih u. </char> <verse eid="MRK 2:19"/><verse number="20" style="v" sid="MRK 2:20"/><char style="wj">“Cunsepi cangpyang ami vei üngka naw, ami lakin lawnaka kcün pha law khai. Acunüng acuna mhmüp he üng ami ei jeih law khai he. </char><verse eid="MRK 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21"/>
    <char style="wj">“U naw suisak akthai kpyawn akphyüm am am kbun khawi naw, ami kbun üng akthai naw eitek se, acun käna ateknak ksehlen law khai. </char> <verse eid="MRK 2:21"/><verse number="22" style="v" sid="MRK 2:22"/><char style="wj">“U naw capyittui asü capyit um akphyüm üng am than khawi naw, acunkba ami than üng capyittui asü naw capyit um eipäk se, capyittui ngsawi lü capyit um pi se khai. Acunakyase capyittui asü cun capyit um akthai üng than khawiki he,”</char> ti lü a pyen.<verse eid="MRK 2:22"/></para>
  <para style="s">Sabbatha Mawng Ngthähnak</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mt 12:1-8</ref>; <ref loc="LUK 6:1-5">Lk 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">2:23: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 23:25">Deut 23:25</ref>
      </char>
    </note>Jesuh axüisaw he am loma lama Sabbath mhmüp üng ami ceh üng, axüisaw he naw cangvui he ami jah kpyat. <verse eid="MRK 2:23"/><verse number="24" style="v" sid="MRK 2:24"/>Acun Pharise he naw hmu u lü Jesuh üng, “Tenga, Sabbath mhmüp üng na xüisaw he naw hinkba ami pawh hin mi thum üng am nglawiki ni!” tia ami pyen.<verse eid="MRK 2:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">2:25,26: </char>
      <char style="xt" closed="false">
        <ref loc="1SA 21:1-6">1Sam 21:1-6</ref>
      </char>
    </note>Jesuh naw jah msang lü, <char style="wj">“Davit naw acuna mhmüp üng a khyang he am ami ei ngai law u lü ami pawh am nami kheh khawiki aw?</char> <verse eid="MRK 2:25"/><verse number="26" style="v" sid="MRK 2:26"/><note caller="-" style="x"><char style="xo" closed="false">2:26: </char><char style="xt" closed="false"><ref loc="LEV 24:9">Lev 24:9</ref></char></note><char style="wj">Acuna Pamhnama im üng lut lü Pamhnam üng peta muk eiki. Ktaiyü ktung Abithaa kcün pät üng kyaki. Mi thum üng ktaiyü ktung he däng naw ami ei theia muk Davit naw ei lü a khyang he üng pi a jah pet cen,”</char> ami ti.<verse eid="MRK 2:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27"/>Jesuh naw, <char style="wj">“Sabbath cun khyanga dawnak vaia pyana kyaki; khyang cun Sabbatha phäha pyana am kya.</char> <verse eid="MRK 2:27"/><verse number="28" style="v" sid="MRK 2:28"/><char style="wj">Acunakyase Khyanga Capa cun Sabbatha Bawia pi kyaki ni,” </char>a ti.<verse eid="MRK 2:28"/></para>
  <chapter eid="MRK 2"/>
  <chapter number="3" style="c" sid="MRK 3"/>
  <para style="s">Akutxo Khyang mat</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mt 12:9-14</ref>; <ref loc="LUK 6:6-11">Lk 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1"/>Acunüng Jesuh Sinakoka khuia a luh be üng, acuia a kut vang lam xokia khyang mat awmki. <verse eid="MRK 3:1"/><verse number="2" style="v" sid="MRK 3:2"/>Ami mkateinak vaia, Sabbath üng akxo a mdaw law be täng täng la am a mdaw law be k’et u lü ami teng. <verse eid="MRK 3:2"/><verse number="3" style="v" sid="MRK 3:3"/>Acunüng Jesuh naw akutxo üng, “Ngdüi lü maa lawa,” a ti. <verse eid="MRK 3:3"/><verse number="4" style="v" sid="MRK 3:4"/>Acunüng khyang he üng, <char style="wj">“Mi thum naw Sabbath üng i ti vai ni a jah mtheh? Kpüi vai aw, mkhuimkha vai aw? Khyanga xünnak küikyan vai aw, mkhyüh vai aw?” </char>ti lü jah kthäh se,</para>
  <para style="p" vid="MRK 3:4">I pi am pyen be u. <verse eid="MRK 3:4"/><verse number="5" style="v" sid="MRK 3:5"/>Jesuh naw jah teng hü lü aktäa a mlung soki, cunsepi ami mlung nghlang lü ami kata phäha a pukseki. Acunüng akxo üng, <char style="wj">“Na kut sänga,” </char>ti se, akutxo naw a kut a säng la daw law beki. <verse eid="MRK 3:5"/><verse number="6" style="v" sid="MRK 3:6"/>Acunüng pharise he Sinakok ceh ta u lü, Heroda khyang he am nghmu u lü Jesuh ami mkhyühnak vaia cengki he.<verse eid="MRK 3:6"/></para>
  <para style="s">Tuili kama khyang he</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7"/>Jesuh la axüisaw he Kalile tuilia cit u se khyang khawjah naw ami läk. Acuna khyang he cun Kalile khaw, Judah khaw, <verse eid="MRK 3:7"/><verse number="8" style="v" sid="MRK 3:8"/>Jerusalem mlüh, Idume khaw, Jordan pipei üngka he, Turah la Sidon mlüh hea pipei üngka naw law hüki he. Acun he cun Jesuh naw a bilawh he khawjah ami ngjaka phäha a veia lawkia kyaki he. <verse eid="MRK 3:8"/><verse number="9" style="v" sid="MRK 3:9"/><note caller="-" style="x"><char style="xo" closed="false">3:9,10 </char><char style="xt" closed="false"><ref loc="MRK 4:1">Mk 4:1</ref>; <ref loc="LUK 5:1-3">Lk 5:1-3</ref></char></note>Khyang aktäa adaa phäha a hama mlawngca ami nghängsak thüp thüp vaia axüisaw he a jah mtheh. Acun cun khyang he naw am ami net vaia phäha kyaki. <verse eid="MRK 3:9"/><verse number="10" style="v" sid="MRK 3:10"/>Khyang khawjah jah m’yai bekia kyase, ami hneh vaia ami ngcun law si. <verse eid="MRK 3:10"/><verse number="11" style="v" sid="MRK 3:11"/>Khawyai hea awmnaka khyang he naw ami hmuh üng a maa kawp u lü, ngpyang u lü, “Nang Mhnama Capa!” ami ti.<verse eid="MRK 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12"/>Jesuh naw khawyai he üng a unak ä ami pyen hü vaia a jah ksük.<verse eid="MRK 3:12"/></para>
  <para style="s">Jesuh naw Axüisaw he xaleinghngih a jah xü</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mt 10:1-4</ref>; <ref loc="LUK 6:12-16">Lk 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13"/>Acunüng Jesuh mcunga khana kai lü amäta ngaih he, a veia jah khü se lawki he. <verse eid="MRK 3:13"/><verse number="14" style="v" sid="MRK 3:14"/>Acunüng, ngsä hea a jah sui a xü xaleinghngih he jah xü lü, “Ka veia nami ve khaia ka ning jah xüki” ti lü a jah mtheh. “Ngthu nami sang hü khaia ka ning jah tüi khai, <verse eid="MRK 3:14"/><verse number="15" style="v" sid="MRK 3:15"/>acunüng khawyai he nami jah ksät khaia ana nami ta khai,” a ti.<verse eid="MRK 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16"/>A jah xüa xaleinghngih he cun: Sihmon, (Jesuh naw Pita a sui); <verse eid="MRK 3:16"/><verse number="17" style="v" sid="MRK 3:17"/>Zebedea capa xawi Jakuk la Johan, (Jesuh naw Boneraketa a jah sui, acun cun, “Mkyeka capa xawi”); tinaka kyaki. <verse eid="MRK 3:17"/><verse number="18" style="v" sid="MRK 3:18"/>Andru, Philip, Batolame, Mahte, Thomah, Alaphaha capa Jakuk, Thade, Zelot Sihmon <verse eid="MRK 3:18"/><verse number="19" style="v" sid="MRK 3:19"/>la Judah Iskarot, Jesuh cengkia khyanga kyaki he.<verse eid="MRK 3:19"/></para>
  <para style="s">Jesuh la Beelzebul</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mt 12:22-32</ref>; <ref loc="LUK 11:14-23">Lk 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20"/>Acunüng, Jesuh ima citki. Khyang khawjah ngcun law be u se, Jesuh la axüisaw he ami ei pi am ei hlawt u. <verse eid="MRK 3:20"/><verse number="21" style="v" sid="MRK 3:21"/>Khyang he naw, “Hin hin yaw lawki va ni mäih ja,” ami ti a khuiim kyawnglawng naw sim u lü ngdumsak khai hea büki he.<verse eid="MRK 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:34">Mt 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char>
    </note>Thum mtheiki he avang Jerusalem üngka naw lawki he naw, “Hina k’uma Beelzebul um ve! acuna khawyai hea mkhawnga ana am ni khawyai he a jah ksät ve,” ami ti.<verse eid="MRK 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23"/>Acunüng, Jesuh naw a veia jah khü lü, msuimcäpnak am, <char style="wj">“Ihawkba Khawyam naw Khawyam ksät thei khai? </char> <verse eid="MRK 3:23"/><verse number="24" style="v" sid="MRK 3:24"/><char style="wj">Ia pung pi amimät ngtung’atki he cun khawvei am khäng u naw.</char> <verse eid="MRK 3:24"/><verse number="25" style="v" sid="MRK 3:25"/><char style="wj">Ia khuiim kyawnglawng pi amimät ngtung’atiki he cun ngkyangtai khai he ni. </char> <verse eid="MRK 3:25"/><verse number="26" style="v" sid="MRK 3:26"/><char style="wj">Acunakyase Khawyam khaw ahnga hnga a ngkyangtai üng khawvei am khäng lü düt khai. </char><verse eid="MRK 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27"/>
    <char style="wj">“U naw khyang kyana im akcüka amät am a pinpawk ma küt üng a ima lut lü a khawhthem am yut thei naw. Acunakyase, im mah akyan cun khit ma khai. </char><verse eid="MRK 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28"/>
    <char style="wj">“Akcanga ka ning jah mthehki, nghnicim khyanga ca hea katnak avan la Mhnam pyetsenaka katnak</char>
    <note caller="+" style="f">
      <char style="fr" closed="false">3:28 </char>
      <char style="fq" closed="false">Mhnam pyetsenaka katnak am acunüng am dawkyakia katnak. </char>
    </note>
    <char style="wj">avan cun mhläta kya khai. </char> <verse eid="MRK 3:28"/><verse number="29" style="v" sid="MRK 3:29"/><note caller="-" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">Lk 12:10</ref></char></note> <char style="wj">Cunsepi, Ngmüimkhya Ngcim pyetseki cun itia pi mhläta am kya. Isetiakyaküng acun cun anglät katnaka kyaki,” </char>a ti. <verse eid="MRK 3:29"/><verse number="30" style="v" sid="MRK 3:30"/>(Jesuh naw acun cun, “Hin naw khawyai a k’uma ta ve,” ami tia phäha a pyena kyaki.)<verse eid="MRK 3:30"/></para>
  <para style="s">Jesuh a Nu la a Bena he</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mt 12:46-50</ref>; <ref loc="LUK 8:19-21">Lk 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31"/>Acunüng, Jesuha nu la a bena he pha lawki he. Kpunga ngdüi u lü khyang mat tüi u lü ami va khüsak. <verse eid="MRK 3:31"/><verse number="32" style="v" sid="MRK 3:32"/>Khyang he a peia ngawki he naw, <char style="wj">“Tenga, na nu la na bena he kpunga ve u lü ning sui ve u,” </char>ami ti.<verse eid="MRK 3:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33"/>Jesuh naw jah msang lü, <char style="wj">“U ni ka nu? Ue ni ka bena he?”</char> a ti. <verse eid="MRK 3:33"/><verse number="34" style="v" sid="MRK 3:34"/>A peia ngawki he ngvei lü jah tengki naw, <char style="wj">“Teng u! hin he hin ka nu la ka bena he ni! </char> <verse eid="MRK 3:34"/><verse number="35" style="v" sid="MRK 3:35"/><char style="wj">U pi Mhnama a ngjakhlü tiki avan cun ka bena, ka cina la ka nua kyaki he ni,”</char> a ti.<verse eid="MRK 3:35"/></para>
  <chapter eid="MRK 3"/>
  <chapter number="4" style="c" sid="MRK 4"/>
  <para style="s">Mciksaw am Msuimcäpnak</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mt 13:1-9</ref>; <ref loc="LUK 8:4-8">Lk 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:1-3">Lk 5:1-3</ref>
      </char>
    </note>Acunüng, Kalile tuili peia jah mthei be se, khyang khawjah a veia ngcun lawki he. Acunüng lawkia khyang he cun aktäa dämda u se, Jesuh mlawnga khana kai lü ngawki. Khyang avan tui kama tuinu ma na u lü, ngkhäm lawki he. <verse eid="MRK 4:1"/><verse number="2" style="v" sid="MRK 4:2"/>Jesuh naw msuimcäpnak he am hinkba khawjah a jah mthei,<verse eid="MRK 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3"/>
    <char style="wj">“Ngai ua, mhmüp mat üng khyang mat mci saw khaia citki.</char> <verse eid="MRK 4:3"/><verse number="4" style="v" sid="MRK 4:4"/><char style="wj">A saw k’um üng, mci avang lam khana kyakia kyase, kha he naw jawng law u lü, ami ei. </char> <verse eid="MRK 4:4"/><verse number="5" style="v" sid="MRK 4:5"/><char style="wj">Mci avang nglei am a danak bäk, lunga danaka kyaki. Nglei am thahkia kyase angxita pyo lawki.</char> <verse eid="MRK 4:5"/><verse number="6" style="v" sid="MRK 4:6"/><char style="wj">Nghngi lut law lü, khaw ngling law se, a pya am saükia kyase, ng’yawngki.</char> <verse eid="MRK 4:6"/><verse number="7" style="v" sid="MRK 4:7"/><char style="wj">Mci avang nghling hmua kyaki, nghling saü law lü, yai se am vuipai thei.</char> <verse eid="MRK 4:7"/><verse number="8" style="v" sid="MRK 4:8"/><char style="wj">Cunsepi, mci avang nglei kdaw üng kyaki, cawt law lü, saü law lü, avang thumkip, khyukip la aphyaa ngtheipai lawki,” </char>a ti.<verse eid="MRK 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9"/>Akbäihnaka Jesuh naw, <char style="wj">“A ngjaknak vaia a nghnga taki naw ngja se,” </char>a ti.<verse eid="MRK 4:9"/></para>
  <para style="s">Msuimcäpnaka Suilam</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mt 13:10-17</ref>; <ref loc="LUK 8:9">Lk 8:9</ref>,<ref loc="LUK 8:10">10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10"/>Jesuh amät a ve üng, xaleinghngih he la akce läk hngaki he naw a veia law u lü msuimcäpnaka suilam a jah mtheh vaia ami kthäh. <verse eid="MRK 4:10"/><verse number="11" style="v" sid="MRK 4:11"/>Jesuh naw, <char style="wj">“Nangmia phäha ta, Pamhnama khawa mawng athukhlüng ksingnak vai ning jah peta kya ve, Cunsepi khyang kce hea phäha avan msuimcäpnak am pyena kyaki. </char> <verse eid="MRK 4:11"/><verse number="12" style="v" sid="MRK 4:12"/><note caller="-" style="x"><char style="xo" closed="false">4:12: </char><char style="xt" closed="false"><ref loc="ISA 6:9">Hesa 6:9</ref>,<ref loc="ISA 6:10">10</ref> (LXX)</char></note><char style="wj">Acunakyase,</char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">‘Teng u lü pi, </char></para>
  <para style="q2" vid="MRK 4:12">
    <char style="wj">am hmu u,</char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">ngja u lü pi, </char></para>
  <para style="q2" vid="MRK 4:12">
    <char style="wj">am ksing u. </char></para>
  <para style="q1" vid="MRK 4:12">
    <char style="wj">Hmu ngja u lü Pamhnama veia ami nghlat be vai sü ta</char></para>
  <para style="q2" vid="MRK 4:12">
    <char style="wj">ani naw jah mhlät khai sü,” </char> a ti.<verse eid="MRK 4:12"/></para>
  <para style="s">Mciksaw Msuimcäpnak a jah Mthehnak khai</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mt 13:18-23</ref>; <ref loc="LUK 8:11-15">Lk 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13"/>Acunüng Jesuh naw, <char style="wj">“Hina msuimcäpnak am nami ksingki aw? Acunüng ihawkba msuimcäpnak avan nami ksing thei kawm?</char> <verse eid="MRK 4:13"/><verse number="14" style="v" sid="MRK 4:14"/><char style="wj">Mciksaw naw Mhnama ngthu a saw. </char> <verse eid="MRK 4:14"/><verse number="15" style="v" sid="MRK 4:15"/><char style="wj">Acunüng, avang he cun lam kpema kyaki mci hea mäih lawki he, ngthu ami ngai la khawyam naw law lü ngthu cun a lawhei.</char> <verse eid="MRK 4:15"/><verse number="16" style="v" sid="MRK 4:16"/><char style="wj">Khyang avang he cun lunga danaka kyaki mci hea mäih lawki he. Ngthu ami ngjak üng jekyainak am doeiki he.</char> <verse eid="MRK 4:16"/><verse number="17" style="v" sid="MRK 4:17"/><char style="wj">Cunsepi, amimät üng apya am ve se, ivei am khäng. Acun käna thangkdaw phäha, mkhuimkhanaka pi kyase, khuikhanaka pi kyase, a pha law üng pyai beki he. </char> <verse eid="MRK 4:17"/><verse number="18" style="v" sid="MRK 4:18"/><char style="wj">Khyang avang he cun nghling hmua sawa mci hea mäih lawki he. Acun he cun ngthu ngjaki he,</char> <verse eid="MRK 4:18"/><verse number="19" style="v" sid="MRK 4:19"/><char style="wj">cunsepi khawmdek cäicanak he, bawimangnak vai mnaiheinak la iyaw akce kce mnaiheinak he naw ngthu cun yai law u se, am vuipai thei.</char> <verse eid="MRK 4:19"/><verse number="20" style="v" sid="MRK 4:20"/><char style="wj">Cunsepi khyang kce he cun nglei kdaw üng sawa mci hea mäih lawki he. Acun he cun ngthu ngja u lü doeiki he, acunüng avang thumkip, avang khyukip, avang aphya vuipai lawki he,”</char> a ti.<verse eid="MRK 4:20"/></para>
  <para style="s">Kphya am Müka Mei kdäi</para>
  <para style="r">(<ref loc="LUK 8:16-18">Lk 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:21: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">Mt 5:15</ref>; <ref loc="LUK 11:33">Lk 11:33</ref></char>
    </note>Acuna thea Jesuh naw, <char style="wj">“Mei kdäi u naw lawpüi lü kphya k’uma, am ani üng ihnaka kea thup khawiki aw? Angdangnaka vai khaia am ta khai aw?</char> <verse eid="MRK 4:21"/><verse number="22" style="v" sid="MRK 4:22"/><note caller="-" style="x"><char style="xo" closed="false">4:22:</char><char style="xt" closed="false"><ref loc="MAT 10:26">Mt 10:26</ref>; <ref loc="LUK 12:2">Lk 12:2</ref></char></note> Ipi ä ngdang khaia thup cun mdana kya law lü, ipi ä ngphyäü khaia mjih cun phyeha kya law khai. <verse eid="MRK 4:22"/><verse number="23" style="v" sid="MRK 4:23"/><char style="wj">A ngjaknak vaia a nghnga awmki naw ngja se,” </char> a ti.<verse eid="MRK 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:24: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:2">Mt 7:2</ref>; <ref loc="LUK 6:38">Lk 6:38</ref></char>
    </note>Jesuh naw, <char style="wj">“Nami ngjak cäi na ua! Khyang nami mtehnak am Mhnam naw ning jah mteh be khai, acuna kthaka pi ning jah mteh be khai. </char> <verse eid="MRK 4:24"/><verse number="25" style="v" sid="MRK 4:25"/><note caller="-" style="x"><char style="xo" closed="false">4:25: </char><char style="xt" closed="false"><ref loc="MAT 13:12">Mt 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">Lk 19:26</ref></char></note><char style="wj">Upi taki üng pet däm däma kya lü, upi am taki cun a takca pi yuh pet bea kya khai,” </char>a ti.<verse eid="MRK 4:25"/></para>
  <para style="s">Ngbaüngbu Lawkia Mcia Mawng</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26"/>Jesuh naw, <char style="wj">“Pamhnama khaw cun khyang mat mci a loa sawki am tängki.</char> <verse eid="MRK 4:26"/><verse number="27" style="v" sid="MRK 4:27"/><char style="wj">Mciksaw mthana ip lü mhmüpa tho lawki. Acun k’um üng mci cun pawk law lü ngbang lawki. Cunsepi ihawkba akya law am ksing. </char> <verse eid="MRK 4:27"/><verse number="28" style="v" sid="MRK 4:28"/><char style="wj">Nglei amät naw vuipaiei lawsak khawiki. Akcüka aphung, avui, acunüng avui üngka naw akcang ngdang law khawiki.</char> <verse eid="MRK 4:28"/><verse number="29" style="v" sid="MRK 4:29"/><note caller="-" style="x"><char style="xo" closed="false">4:29: </char><char style="xt" closed="false"><ref loc="JOL 3:13">Jol 3:13</ref></char></note><char style="wj">Avui a hmin law la, khyang naw cang ah kcünkia kyase, angxita ngvinca am atki,” </char>a ti.<verse eid="MRK 4:29"/></para>
  <para style="s">Anca ui am Msuimcäpnak</para>
  <para style="r">(<ref loc="MAT 13:31">Mt 13:31</ref>,<ref loc="MAT 13:32">32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18">Lk 13:18</ref>,<ref loc="LUK 13:19">19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30"/>Jesuh naw, <char style="wj">“Pamhnama khaw cun i am mtäng vai? Msuimcäpnak i am mtumtäng vai?</char> <verse eid="MRK 4:30"/><verse number="31" style="v" sid="MRK 4:31"/><char style="wj">Pamhnama khaw cun khyang mat naw khawmdek khana jaw säihki anca ui lo lü nglei üng a saw am tängki.</char> <verse eid="MRK 4:31"/><verse number="32" style="v" sid="MRK 4:32"/><char style="wj">Cunsepi asäng ngsawk se, a cawt law üng loa sawngling avana kthaka ngbangbu law lü ngban mah law se kha he naw law u lü ami ngbu ami tuknak khawi,” </char>a ti.<verse eid="MRK 4:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33"/>Jesuh naw acunkba msuimcäpnak khawjah am ami ksing thei vaia ngthu a jah mtheh. <verse eid="MRK 4:33"/><verse number="34" style="v" sid="MRK 4:34"/>Msuimcäpnaka kaa khyang hea veia ngthu am pyen khawi. Cunsepi, axüisaw he amimät ami awmnaka avan a jah mtheh be khai.<verse eid="MRK 4:34"/></para>
  <para style="s">Jesuh naw Khawkhi kse Mgdümsak beki</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mt 8:23-27</ref>; <ref loc="LUK 8:22-25">Lk 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35"/>Acuna mhmüp khaw a mü law üng, Jesuh naw axüisaw he üng, <char style="wj">“Tuilia caye lama mi va pek vai u,”</char> a ti. <verse eid="MRK 4:35"/><verse number="36" style="v" sid="MRK 4:36"/>Acuna, khyang he akdäm jah yawk hüt u lü, Jesuh mlawng üng ngaw se ami cehpüi. Akce mlawngca he pi acunüng awmki he. <verse eid="MRK 4:36"/><verse number="37" style="v" sid="MRK 4:37"/>Acunüng, khawkhi ksenu khi law se tuimvawn cun mlawng üng be law hlüki. <verse eid="MRK 4:37"/><verse number="38" style="v" sid="MRK 4:38"/>Jesuh cun ngkhumnak üng ngkhumei lü mlawnga hnu lama ip lü ve se axüisaw he naw, “Saja aw, mi thih vai hin am na cäinaki aw?” ti u lü ami mthawh.<verse eid="MRK 4:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39"/>Jesuh naw tho law lü khawkhi kse üng, <char style="wj">“Ngdüma!” </char>ti lü a mtheh. Acunüng tuimvawn üng, <char style="wj">“Pyaia”</char> ti se avan ngdüm lawki he. <verse eid="MRK 4:39"/><verse number="40" style="v" sid="MRK 4:40"/>Acunüng Jesuh naw axüisaw he a veia, <char style="wj">“I vaia nami kyükyawk aihki ni? Ise jumnak am nami taki ni?” </char>a ti.<verse eid="MRK 4:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41"/>Cunsepi kyü law ngen u lü, “Khawkhi la tuimvawn naw pi a mtheh ani ngjak hin ia khyang ni?” tia ngthehei kyuki he.<verse eid="MRK 4:41"/></para>
  <chapter eid="MRK 4"/>
  <chapter number="5" style="c" sid="MRK 5"/>
  <para style="s">Jesuh naw Ngmüimkhya kse hea Awmnaka Khyang a M’yai be</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mt 8:28-34</ref>; <ref loc="LUK 8:26-39">Lk 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1"/>Jesuh la axüisaw he Kalile tuili caye, Kerasa khawa pha lawki he. <verse eid="MRK 5:1"/><verse number="2" style="v" sid="MRK 5:2"/>Mlawng üngka naw Jesuh a kco law la, ng’uhnün üngka naw lawki khawyaia awmnaka khyang mat naw ana khyum. <verse eid="MRK 5:2"/><verse number="3" style="v" sid="MRK 5:3"/>Acun cun ng’uhnüna awmki, u naw mthiyüi am pi am ami khih thei; <verse eid="MRK 5:3"/><verse number="4" style="v" sid="MRK 5:4"/>Khawveia mthiyüi am a kut la a khaw ami jah khih üng pi mthiyüie jah ksäkpat lü amcäm cäma a jah pawh. U naw pi am ami mcing theia vai aktä ktha mahki. <verse eid="MRK 5:4"/><verse number="5" style="v" sid="MRK 5:5"/>Amhmüp amthan ng’uhnün he la khawmcung hea cit hü lü ngpyang lü, amät la amät lung am ng’at kyu lü awmki.<verse eid="MRK 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6"/>Jesuh akhawsang üngka naw a hmuh üng a veia dawng lü a ma ngdäng lü, <verse eid="MRK 5:6"/><verse number="7" style="v" sid="MRK 5:7"/>“Jesuh, ak'hlüng säih Mhnama Capa aw! i ni nglak na se ni? Ä na na mkhuimkha vaia Pamhnama ngming am ning nghui na veng,” ti lü, angsanga ngpyangki. <verse eid="MRK 5:7"/><verse number="8" style="v" sid="MRK 5:8"/>(Acukba a tinak cun Jesuh naw, <char style="wj">“Ngmüimkhya kse aw, hina khyang üngka naw lut lawa,” </char>ti lü, a ksenaka phäha kyaki).<verse eid="MRK 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9"/>Acunüng Jesuh naw, <char style="wj">“Na ngming u ni?”</char> ti se,</para>
  <para style="p" vid="MRK 5:9">Ani naw, “Ka ngming cun ‘Apä ni’ keimi cun khawjah kami lawki tinaka kyaki” a ti. <verse eid="MRK 5:9"/><verse number="10" style="v" sid="MRK 5:10"/>Acun käna ngmüimkhya kse he naw khaw üngka naw ä a jah ksät vaia Jesuh aktäa a nghuinak.<verse eid="MRK 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11"/>Acuia mcung peia vawk khawjah ami jah mcah awmki. <verse eid="MRK 5:11"/><verse number="12" style="v" sid="MRK 5:12"/>Acuna ngmüimkhya naw Jesuh üng, “Vawk hea veia jah tüia, acuia kami lut khai,” ti u lü, ami nghuinak. <verse eid="MRK 5:12"/><verse number="13" style="v" sid="MRK 5:13"/>Jesuh naw ami luh vaia ti se, ngmüimkhya kse he cun khyang üngka naw lut law u lü vawk hea k’uma lutki he. Thawng nghngih lawkia vawk he cun ami van tuilia dawng u lü, kdang üng ngtäng u lü tui üng ngcumki he.<verse eid="MRK 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14"/>Vawk sämki he dawng u lü, mlüh k’um la ngnam k’uma jah va mtheh u se khyang he cun i thawnhlawki ti cun teng khai hea lawki he. <verse eid="MRK 5:14"/><verse number="15" style="v" sid="MRK 5:15"/>Jesuha veia law u lü yai pä hea awmnaka khyang cun ngsuingsa lü akdawa a na ngaw se ami hmuh üng, aktäa kyüei lawki he. <verse eid="MRK 5:15"/><verse number="16" style="v" sid="MRK 5:16"/>Acun hmuki he naw khawyai he awmnaka khyang ikba a awm la, vawk he ihawkba ami kya cun khyang he üng pi ami jah mtheh be.<verse eid="MRK 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17"/>Acuna, Jesuh naw ami khaw a ceh tak vaia ami nghuinak.<verse eid="MRK 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18"/>Jesuh mlawnga khana a kai be üng khawyai hea awmnak khawia khyang naw, “Na hlawnga cit hnga vang” ti lü a nghuinak.<verse eid="MRK 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19"/>Cunsepi Jesuh naw mah lü, <char style="wj">“Na ima cit be lü, Bawipa naw na phäha ihlawka a pawh la na khana m'yeneinak a tak jah va mtheha,” </char>a ti.<verse eid="MRK 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20"/>Acunüng, acuna khyang naw cit lü Jesuh naw a phäha a pawh peta mawng cun Mlüh Xa üng va sang hü se ngjaki avan cäiki he.<verse eid="MRK 5:20"/></para>
  <para style="s">Jairuha Canu la Jesuha Kcu Hnetkia Nghnumi</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mt 9:18-26</ref>; <ref loc="LUK 8:40-56">Lk 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21"/>Jesuh tuilia caye kama mlawng am va pek se, acuia khyang khawjah a veia ngcun lawki he. <verse eid="MRK 5:21"/><verse number="22" style="v" sid="MRK 5:22"/>Sinakok mkhawng Jairuh ngmingnaki mat lawki naw Jesuh a hmuh üng a khaw kunga ngdäng lü, <verse eid="MRK 5:22"/><verse number="23" style="v" sid="MRK 5:23"/>“Ka ca, nghnumica aktäa mhnatei ve, phet be lü a xüngseinak vaia law lü na kut a khana mtaih lawa” ti lü aknuia a nghuinak.<verse eid="MRK 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24"/>Acunüng Jesuh a veia cit se khyang khawjah naw läk law u lü a hnuma kcung lawki he naw ami hneh.<verse eid="MRK 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25"/>Acuia nghnumi kum xaleinghngih a thi put lü khuikhaki mat awmki. <verse eid="MRK 5:25"/><verse number="26" style="v" sid="MRK 5:26"/>Seibawi khawjah naw ami ngnünak, ngui a tak avan am ngsawiei sepi am kyäpei be lü ksehlen law bawki. <verse eid="MRK 5:26"/><verse number="27" style="v" sid="MRK 5:27"/>Jesuh ami ti a ngjak üng a hnua khyang hea ksunga lawki. <verse eid="MRK 5:27"/><verse number="28" style="v" sid="MRK 5:28"/>“A suisak dänga hleng ka hneh üng ta ka phet be khai ni,” tia ngai kyuki.<verse eid="MRK 5:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29"/>Jesuha suisak a hneh. Acun la a thia put ngdüm lü a pumsa üng natnak daw bekia a sim. <verse eid="MRK 5:29"/><verse number="30" style="v" sid="MRK 5:30"/>Acun la Jesuh naw a johit amät üngka naw akcea lut lawki ti a ksing la khyang hea ksunga nghlat lü, <char style="wj">“U ni ka suisak hnetki?” </char>a ti.<verse eid="MRK 5:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31"/>Axüisaw he naw, “Hinkba khyang khawjah naw ning hneh u se hmu ye lü, <char style="wj">‘U ni na hnetki’ </char>na tiki hin” ami ti.<verse eid="MRK 5:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32"/>Cunsepi Jesuh naw hnetki hmu khaia nghlat lü teng hü se, <verse eid="MRK 5:32"/><verse number="33" style="v" sid="MRK 5:33"/>Nghnumi naw kyüh lü ngxet lü amät üng ihawkba akya ksingki naw law lü Jesuha ma ngdäng lü, a thawnhlawk akcang naküt a mtheh. <verse eid="MRK 5:33"/><verse number="34" style="v" sid="MRK 5:34"/>Acunüng Jesuh naw, <char style="wj">“Ka canghnu aw, na jumnak naw ning dawsak be ve. Dim’yenak am cita, na natnak üngka naw yai bea,” </char>a ti.<verse eid="MRK 5:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35"/>Acukba ana ngthuhei k’um üng khyang avang Sinakok mkhawng Jairuha im üngka naw law u lü, “I vaia Saja na kbawngkbaieiki ni? Na canu thihpäng ye se,” ami ti law.<verse eid="MRK 5:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36"/>Jesuh naw ami pyen ia am msui lü Sinakok mkhawnga veia, <char style="wj">“Ä kyüha, a jum dänga juma,” </char>a ti. <verse eid="MRK 5:36"/><verse number="37" style="v" sid="MRK 5:37"/>Acunüng Jesuh naw Pita, Jakuk la a na Johana thea u pi a hlawnga am ngkhahpüi. <verse eid="MRK 5:37"/><verse number="38" style="v" sid="MRK 5:38"/>Jairuha ima ami law üng Jesuh naw ana üicai u lü, ana mbawikyapki he a jah hmu üng, <verse eid="MRK 5:38"/><verse number="39" style="v" sid="MRK 5:39"/>Im k’uma lut lü, <char style="wj">“I vaia üicai u lü nami kyapki ni? Hnasen cun thiki am ni, ipki ni,”</char> a ti.<verse eid="MRK 5:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40"/>Acun he naw ami yaihei. Acuna Jesuh naw ami van kpunga a jah tüih käna hnasena a pa la a nu, acunüng amät jah a ngkhahpüi he am hnasen ami msännaka a jah luhpüi. <verse eid="MRK 5:40"/><verse number="41" style="v" sid="MRK 5:41"/>Acunüng, hnasen cun a kut üng kpang lü, <char style="wj">“Talita, Kumi,” </char>a ti, acun cun <char style="wj">“Nghnumica aw, tho lawa ti veng!”</char> tinaka kyaki.<verse eid="MRK 5:41"/></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42"/>Acun la angxita nghnumica cun tho law lü cit hüki. (Ani cun kum xaleinghngih lawki). Acunüng avan cäi lawki he. <verse eid="MRK 5:42"/><verse number="43" style="v" sid="MRK 5:43"/>Cunsepi, Jesuh naw u üng pi ä ami mtheh vaia jah ksük lü, “A ei vai iyaw pe ua,” a ti.<verse eid="MRK 5:43"/></para>
  <chapter eid="MRK 5"/>
  <chapter number="6" style="c" sid="MRK 6"/>
  <para style="s">Jesuh Nazareta ami Kpana mawng</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mt 13:53-58</ref>; <ref loc="LUK 4:16-30">Lk 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1"/>Acuna hmün Jesuh naw ceh ta lü a ngnama cit be se axüisaw he naw pi ami läk. <verse eid="MRK 6:1"/><verse number="2" style="v" sid="MRK 6:2"/>Sabbath mhmüp pha law se Sinakoka k’uma a jah mthei. Acunüng khyang khawjah awmki he; a ngthu pyen ngja u lü, “Hin naw hawia hina ngkhaw he a jah yahei hü ni? Hina veia themnak pet hin, ia themnak ni? Ahinkba sena müncankse he jah pawhki ni? <verse eid="MRK 6:2"/><verse number="3" style="v" sid="MRK 6:3"/>Hina khyang hin Mariha ca Jakuk, Josep, Judah la Sihmona ami ktai, imksa am kya aih se? A na he pi hin üng am awmki hea kya aih u se?” tia ami ma.<verse eid="MRK 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">6:4: </char>
      <char style="xt" closed="false">
        <ref loc="JHN 4:44">Jn 4:44</ref>
      </char>
    </note>Jesuh naw, <char style="wj">“Sahma he cun amimäta ngnam, amimäta mjükphyüi la khuikkyawnga thea ta hmün naküta mhlünmtainak yahki he,” </char>a ti.<verse eid="MRK 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5"/>Am phetkia khyang he ajawca hea khana a kut mtaih lü a jah m’yai be thea ta müncankse bilawh i pi am pawh. <verse eid="MRK 6:5"/><verse number="6" style="v" sid="MRK 6:6"/>Khyang he naw am ami jumeia phäha Jesuh aktäa müncaki.</para>
  <para style="s" vid="MRK 6:6">Jesuh naw Axüisaw he Xaleinghngih a jah Tüih</para>
  <para style="r" vid="MRK 6:6">(<ref loc="MAT 10:5-15">Mt 10:5-15</ref>; <ref loc="LUK 9:1-6">Lk 9:1-6</ref>)</para>
  <para style="p" vid="MRK 6:6">Acunüng ngnam he üng jah mthei hü lü ngvei hüki. <verse eid="MRK 6:6"/><verse number="7" style="v" sid="MRK 6:7"/>Jesuh naw xaleinghngih he a veia jah khü lü nghngih cia a jah tüih. Ngmüimkhya kse he jah nängnaka ana a jah pet. <verse eid="MRK 6:7"/><verse number="8" style="v" sid="MRK 6:8"/><note caller="-" style="x"><char style="xo" closed="false">6:8-11: </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">Lk 10:4-11</ref></char></note>Ami ceh üng, “Ksawngkhe thea muk, kthäheinaka ngja, nami kcukcawk üng ngui ä nami jah cehei vai. <verse eid="MRK 6:8"/><verse number="9" style="v" sid="MRK 6:9"/>Khawdawk nami ngcum vai, kcu nghngih ä nami cehei vai,” a ti. <verse eid="MRK 6:9"/><verse number="10" style="v" sid="MRK 6:10"/>Acuna thea pi Jesuh naw, <char style="wj">“Ahawiapi ami ning jah jenak üng nami ceh be vei acuna im üng nami awm vai. </char> <verse eid="MRK 6:10"/><verse number="11" style="v" sid="MRK 6:11"/><note caller="-" style="x"><char style="xo" closed="false">6:11: </char><char style="xt" closed="false"><ref loc="ACT 13:5">Ngs 13:5</ref></char></note><char style="wj">Am ami ning jah jenak la nami ngthu am ami ngainaka mlüha nami law üng, ceh ta u lü nami khaw üngka mput nami kha hüt vai. Acun cun ami phäha ngthumkhyanak vaia msingnaka kya khai,” </char>a ti.<verse eid="MRK 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12"/>Acunüng cit u lü, acuna khyang he ami katnak he üngka naw ami nghlat lawnak vaia ngthu va pyenki he. <verse eid="MRK 6:12"/><verse number="13" style="v" sid="MRK 6:13"/><note caller="-" style="x"><char style="xo" closed="false">6:13: </char><char style="xt" closed="false"><ref loc="JAS 5:14">Jak 5:14</ref></char></note>Khawyai he khawjah jah ksät u lü am phetki he khawjah Olip ksi am jah hluk u se yai beki he.<verse eid="MRK 6:13"/></para>
  <para style="s">Baptican Johana Thiha Mawng</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mt 14:1-12</ref>; <ref loc="LUK 9:7-9">Lk 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">6:14,15</char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:14">Mt 16:14</ref>; <ref loc="MRK 8:28">Mk 8:28</ref>; <ref loc="LUK 9:19">Lk 9:19</ref></char>
    </note> Sangpuxang Herod<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="fq" closed="false">Sangpuxang Herod: Antipas Herod, Kalile Bawi.</char></note> naw Jesuha ngming aktäa ngthang lawkia kyase a ngjak law. Khyang avang he naw, “Baptican Johan thihnak üngka naw tho law be ve. Acunakyase ni, hinkba khyaihbahnak he ani üng awm khai,” ami ti.<verse eid="MRK 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15"/>Avang he naw, “Elijah ni” ami ti.</para>
  <para style="p" vid="MRK 6:15">Avang he naw, “Hin hin ajana ka sahma hea kba, sahma mat ni,” ami ti.<verse eid="MRK 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16"/>Herod naw a ngjak üng, “Hin hin a lu ka khyüna Johan ni, thihnak üngka naw tho law beki ni,” a ti. <verse eid="MRK 6:16"/><verse number="17" style="v" sid="MRK 6:17"/><note caller="-" style="x"><char style="xo" closed="false">6:17,18</char><char style="xt" closed="false"><ref loc="LUK 3:19">Lk 3:19</ref>,<ref loc="LUK 3:20">20</ref></char></note>Isetiakyaüng, Herod naw a na Philipa khyu, Herodih yut lü khyu naki naw, acuna nghnumia phäha Johan cun jah mansak lü thawngim üng a khyuma kyaki. <verse eid="MRK 6:17"/><verse number="18" style="v" sid="MRK 6:18"/>Johan naw Herod üng, “Na naa khyu na khyunak hin nglawiki aw?” a ti.<verse eid="MRK 6:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19"/>Acunakyase Herodih naw Johan cun hneng lü a mkhyüh vaia a bü, cunsepi Heroda phäha am hnim thei. <verse eid="MRK 6:19"/><verse number="20" style="v" sid="MRK 6:20"/>Sangpuxang Herod naw Johan cun khyang kdawa kya lü, ngcimcaihkia ksingki naw kyüh lü aktäa a yung. Johana ngthu pyena phäha kyükyawk sepi, a ngthu pyen cun ngai hlüki.<verse eid="MRK 6:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21"/>Mhmüp mat üng, Herod naw a hminaka khawmhmüp pawi pawh lü a khyang ngvai he, yekap ngvai he, bawi he la, Kalile khaw üng khyang ngvai he am buh a jah pawh pet. Acunüng Heroda khyu Herodih naw Johan a hnimnak vaia kcün kdaw yahki. <verse eid="MRK 6:21"/><verse number="22" style="v" sid="MRK 6:22"/>Herodiha canu, nglaca law lü nglam lawki naw, Herod la a ngawhpüia khin he ami mlung aktäa a jah jesak. Acuna sangpuxang naw, “Ipi na ngaih kthäha, ka ning pe khai,” a ti. <verse eid="MRK 6:22"/><verse number="23" style="v" sid="MRK 6:23"/>Acunüng Herod naw khyütam na lü, “Ipi na ngaih kthäha, ka uka khaw amte pi ka ning pe khai” a ti.<verse eid="MRK 6:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24"/>Acuna nglaca naw a nua veia cit lü, “Ini ka kthäh kawm?” ti se,</para>
  <para style="p" vid="MRK 6:24">A nu naw, “Baptican Johana lu,” a ti.<verse eid="MRK 6:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25"/>Acunja nglaca angxita sangpuxanga veia va cit be lü, “Baptican Johana lu, angxita mlikbe üng na na pet vai ngaih veng!” a ti.<verse eid="MRK 6:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26"/>Sangpuxang cun aktäa ngjutki, cunsepi a sitiha phäha la a veia ngawki khin hea phäha am ma thei. <verse eid="MRK 6:26"/><verse number="27" style="v" sid="MRK 6:27"/>Acuna sangpuxang naw yekap angxita tüi lü, Johana lu a lawpüi vaia a mtheh. Yekap naw thawngima cit lü Johana lu a va khyün. <verse eid="MRK 6:27"/><verse number="28" style="v" sid="MRK 6:28"/>Acunüng, Johana lu mlikbe üng lawpüi lü nglaca am pe se, nglaca naw a nu üng a pet. <verse eid="MRK 6:28"/><verse number="29" style="v" sid="MRK 6:29"/>Johana axüisaw he naw ami ngjak üng a yawk va mhläm u lü ami k’ut.<verse eid="MRK 6:29"/></para>
  <para style="s">Jesuh naw Khyang Thawng Mhma Mbeiki</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mt 14:13-21</ref>; <ref loc="LUK 9:10-17">Lk 9:10-17</ref>; <ref loc="JHN 6:1-14">Jn 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30"/>Ngsä he Jesuha veia law be u lü ami pawhmsah he la ami jah mtheimthange avan ami mtheh law be. <verse eid="MRK 6:30"/><verse number="31" style="v" sid="MRK 6:31"/>Khyang khawjah citcawn hüki hea kyase, Jesuh la axüisaw he ei, ami ei vaia pi am ngbünei u. Acuna Jesuh naw <char style="wj">“Khyang am a awmnaka mi cit vai u, namimät awm u lü asäng nami xüieinak thei vaia,”</char> a ti. <verse eid="MRK 6:31"/><verse number="32" style="v" sid="MRK 6:32"/>Acuna angxinaka mlawng am amimät citki he.<verse eid="MRK 6:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33"/>Cunsepi ami ktawih jah hmu u lü, ami unak jah ksingki he naw, ami van mlüh avan üngka naw kawng lama ana dawng u lü, Jesuh la axüisaw he am ami pha phat üng phaki he. <verse eid="MRK 6:33"/><verse number="34" style="v" sid="MRK 6:34"/><note caller="-" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">Num 27:17</ref>; <ref loc="1KI 22:17">1Sang 22:17</ref>; <ref loc="2CH 18:16">2Khro 18:16</ref>; <ref loc="EZK 34:5">Hez 34:5</ref>; <ref loc="MAT 9:36">Mt 9:36</ref></char></note>Jesuh mlawng üngka naw kyum law lü khyang aktäkpai, toksäm am awmkia to hea kba law u se jah hmu lü, aktäa mthinmhnateiki. Acunüng tün lü khawjah a jah mthei. <verse eid="MRK 6:34"/><verse number="35" style="v" sid="MRK 6:35"/>Khaw mü law se axüisaw he a veia law u lü, “Hin hin angxinak khawkhyawng khawa kyaki, khaw pi mü pängki. <verse eid="MRK 6:35"/><verse number="36" style="v" sid="MRK 6:36"/>Khyang he jah tüi bea, ahina pipei ngnam he la lomaea ami ei vai kheihei hü u se,” ami ti.<verse eid="MRK 6:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37"/>Jesuh naw, “Nangmi naw ami ei vai iyaw jah pe ua,” a ti.</para>
  <para style="p" vid="MRK 6:37">Axüisaw he naw, <char style="wj">“Cit u lü, denarih ngui phya nghngih</char><note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="ft" closed="false">Denarih ngui phya nghngih cun khya khyet üng hlawheia ngkhengnaka kyaki</char></note><char style="wj">phu muk ei vai va khei u lü kami jah pe khai aw?” </char>ami ti.<verse eid="MRK 6:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38"/>Jesuh naw, <char style="wj">“Muk, ijah nami taki aw? Cit u lü va teng ua,” </char>ti se.</para>
  <para style="p" vid="MRK 6:38">Hmu u lü, “Muk mhma la nga nghngih,” ami ti.<verse eid="MRK 6:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39"/>Jesuh naw axüisaw he üng msai kxünga khana aphäh phäha ami jah ngawhsak vaia a jah mtheh. <verse eid="MRK 6:39"/><verse number="40" style="v" sid="MRK 6:40"/>Acunüng avang aphya, avang mhmakip phäh phäha ngawki he. <verse eid="MRK 6:40"/><verse number="41" style="v" sid="MRK 6:41"/>Acunüng Jesuh naw muk mhma la nga nghngih jah lo lü, khana mang lü, Mhnama veia jenak pyen lü, muk cun boki naw ami yet vaia axüisaw he üng a jah pet. Nga nghngih pi bo lü a jah pet. <verse eid="MRK 6:41"/><verse number="42" style="v" sid="MRK 6:42"/>Ami van naw ei u lü phüki he. <verse eid="MRK 6:42"/><verse number="43" style="v" sid="MRK 6:43"/>Axüisaw he naw muk la nga mnawi mkhäm u se, cä xaleinghngih lawki. <verse eid="MRK 6:43"/><verse number="44" style="v" sid="MRK 6:44"/>Muk eiki he cun kpami däng thawng mhma lawki he.<verse eid="MRK 6:44"/></para>
  <para style="s">Jesuh Tuia Khana Citki</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mt 14:22-33</ref>; <ref loc="JHN 6:15-21">Jn 6:15-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45"/>Jesuh naw khyang he a jah ngpyengsak k’um üng, axüisaw he mlawnga khana jah luhsak ktäih lü, caye tuili kam Bethsaida mlüh da a jah cehsak. <verse eid="MRK 6:45"/><verse number="46" style="v" sid="MRK 6:46"/>Acukba khyang he a jah khyah käna amät cun ktaiyü khaia mcunga citki. <verse eid="MRK 6:46"/><verse number="47" style="v" sid="MRK 6:47"/>Khawmü lama mlawng tuili nglung üng ve se, Jesuh amät kawnga awmki. <verse eid="MRK 6:47"/><verse number="48" style="v" sid="MRK 6:48"/>Acunüng khawkhi naw ami mlawng vei hü hü se, am va pek thei u lü ami ve k’um üng, ngawi lam naji kthum la khyuka nglak üng Jesuh tuia khana ami veia lawki. Jah khye<note caller="+" style="f"><char style="fr" closed="false">6:48 </char><char style="fq" closed="false">Jah khye law hlü lü, am acunüng ami veia va ngdawn lü.</char></note> law hlü lü, <verse eid="MRK 6:48"/><verse number="49" style="v" sid="MRK 6:49"/>tuia khana cit se hmuki he naw ngmüimkhyaa sui u lü ngpyangki he. <verse eid="MRK 6:49"/><verse number="50" style="v" sid="MRK 6:50"/>Ami van naw hmu u lü, kyühki he.</para>
  <para style="p" vid="MRK 6:50">Jesuh naw, <char style="wj">“Dim’yenak am ve ua, kei ni, ä kyüh ua,” </char> ti lü a jah msang.<verse eid="MRK 6:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 6:51"/>Acunüng ami veia mlawnga khana kai hnga se khawkhi ngdümki. Acunüng ami van aktäa cäi leng lengki he. <verse eid="MRK 6:51"/><verse number="52" style="v" sid="MRK 6:52"/>Isetiakyaüng muk am a jah mcaha mawng pi akcanga am ami ksing theia phäha kyaki; ami ngaikyunak naw am ksing thei.<verse eid="MRK 6:52"/></para>
  <para style="s">Kenesareta Jesuh naw am Khetki a M’yai be</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mt 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53"/>Tuili khe u lü ami va pek käna Kenesaret mlüh kawnga pha law u lü, tui kama ami mlawng cun ami kphung. <verse eid="MRK 6:53"/><verse number="54" style="v" sid="MRK 6:54"/>Mlawng üngka naw ami kyum law la khyang he naw Jesuh cun ami ksing law. <verse eid="MRK 6:54"/><verse number="55" style="v" sid="MRK 6:55"/>Acunakyase khaw üngka avan dawng law u lü, Jesuh awmki ti ami ngjaknak avana, am phetki he cun ami ngjännak maha a veia ami jah kawh law. <verse eid="MRK 6:55"/><verse number="56" style="v" sid="MRK 6:56"/>Ahawia pi Jesuh a cehnak ngnam avan, mlüh avan la loma avana, am phetkia khyang he jah lawpüi u lü khyang hea ngcunnak hmüna jah ta hüt u lü, a suisak mdawngca hleng hnet vaia ami nghuinak. Acunüng hnetki avan cun phet beki he.<verse eid="MRK 6:56"/></para>
  <chapter eid="MRK 6"/>
  <chapter number="7" style="c" sid="MRK 7"/>
  <para style="s">Pupa hea Thum Mtheimthangnak</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mt 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1"/>Pharise avang he la thum jah mtheiki he Jerusalem üngka naw law u lü Jesuha veia ngcun lawki he. <verse eid="MRK 7:1"/><verse number="2" style="v" sid="MRK 7:2"/>Acunüng axüisaw he naw ami kut mtüihkheh am ei u se jah hmu u lü ami jah msing, acun cun Pharise hea kba ami kut am ami mthiheia kyaki.</para>
  <para style="p" vid="MRK 7:2">(<verse eid="MRK 7:2"/><verse number="3" style="v" sid="MRK 7:3"/>Isetiakyaüng, Pharise he la Judah he naw pupa thum läk u lü ami kut aküa am ami mthi üng ei am ami ei khawia phäha kyaki. <verse eid="MRK 7:3"/><verse number="4" style="v" sid="MRK 7:4"/>Jawituknak üngka naw ami lawpüi ipi am mthi lü am ei u.<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="fq" closed="false">Jawituknak üngka naw ami lawpüi ipi am mthih lü am ei u; </char><char style="ft" closed="false">am acunüng jawituknak üngka naw ami law be üng amimät am ngthihei ma u lü ipi am ei u. </char></note> Pupa thum khawjah läk piling vaia ami ngai he cun khawt he, k’am he, mlikbe he la ihnak he<note caller="+" style="f"><char style="fr" closed="false">7:4 </char><char style="fq" closed="false">avang üng ihnak he ti am ami yuk. </char></note> jah mthia ngkhaw hea kyaki.)<verse eid="MRK 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5"/>Acuna Pharise he la thum jah mtheiki he naw, “Ise na xüisaw he naw pupa he naw jah mthei u lü ami jah tak hüta thum am läk u lü, ami kut mtüihkheh am ei aw sawxatki he ni?” tia, ami kthäh.<verse eid="MRK 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">7:6,7:</char>
      <char style="xt" closed="false">
        <ref loc="ISA 29:13">Hesa 29:13</ref> (LXX)</char>
    </note>Jesuh naw jah msang lü, <char style="wj">“Hesajah naw nangmia hleihlaknak hinkba a pyen hin cang ve: </char></para>
  <para style="q1" vid="MRK 7:6">
    <char style="wj">‘Hina khyang he naw ami m'yawng am na ngak u lü, </char></para>
  <para style="q2" vid="MRK 7:6">
    <char style="wj">ami mlungmthin am na thuk ta ve u. </char><verse eid="MRK 7:6"/></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7"/>
    <char style="wj">Amdanga na sawkhah u lü, </char></para>
  <para style="q2" vid="MRK 7:7">
    <char style="wj">khyanga thum he </char></para>
  <para style="q2" vid="MRK 7:7">
    <char style="wj">Mhnama thum hea kba jah mtheiki he!’ a ti cen, </char><verse eid="MRK 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8"/>
    <char style="wj">Pamhnama ngthupet yawk u lü khyanga thumcam nami läki,” </char>a ti.<verse eid="MRK 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9"/>Jesuh naw pyen be lü, <char style="wj">“Pamhnama ngthupet nami yawknak vaia phäha namimäta thumcam nami ktung naki. </char> <verse eid="MRK 7:9"/><verse number="10" style="v" sid="MRK 7:10"/><note caller="-" style="x"><char style="xo" closed="false">7:10:</char><char style="xt" closed="false"><ref loc="EXO 20:12">Ex 20:12</ref>; <ref loc="DEU 5:16">Deut 5:16</ref>; </char><char style="xt" closed="false"><ref loc="EXO 21:17">Ex 21:17</ref>; <ref loc="LEV 20:9">Lev 20:9</ref></char></note> <char style="wj">Mosi naw, ‘Na nu la na pa na jah mhlünmtai vai, u pi a nu la a pa jah ksenaki cun mkhyüh vai’ a ti </char> <verse eid="MRK 7:10"/><verse number="11" style="v" sid="MRK 7:11"/><char style="wj">Cunsepi khyang naw a nu la a pa üng a pet vaia khawhthem ta mah mah lü, ‘hin hin Koban ni’ (Koban ti cun mhnama ka ni tinaka kyaki) ti lü, </char> <verse eid="MRK 7:11"/><verse number="12" style="v" sid="MRK 7:12"/><char style="wj">a nu pa am a jah kpüikpaknak vaia lam suiki.</char> <verse eid="MRK 7:12"/><verse number="13" style="v" sid="MRK 7:13"/><char style="wj">Ahinkba namimäta nami jah mtheimthangnak am Mhnama ngthu nami yawkki. Acukba am dawki nami pawh khawjah awmki,”</char> a ti.<verse eid="MRK 7:13"/></para>
  <para style="s">Nghngicim Mtüihkhehsaki</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mt 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14"/>Acunüng Jesuh naw khyang khawjah a veia jah khü be lü, “<char style="wj">Nami van naw na ngai u lü, ksing ua. </char> <verse eid="MRK 7:14"/><verse number="15-16" style="v" sid="MRK 7:15-16"/><char style="wj">Nami m'yawng üng ju lutkia nami ei naw pamhnam hjawhkhahnak vaia am ning jah mtüihkhehsak ve, cunsepi nami m'yawng üng lut lawkia ngthu naw ni a ning jah mtüihkhehsak ve” </char>a ti.<verse eid="MRK 7:15-16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17"/>Jesuh cun khyang he jah yawk lü ima lut se, axüisaw he naw acuna suilam a jah mtheh khai vaia ami kthäh. <verse eid="MRK 7:17"/><verse number="18" style="v" sid="MRK 7:18"/>Jesuh naw, <char style="wj">“Nangmi pi ahikba sena am nami ngsümki aw? Am nami ksingki he aw? M'yawng üng lutkia ei naw khyang am mtüihkhehsaki tia angsinga nami ksingki.</char> <verse eid="MRK 7:18"/><verse number="19" style="v" sid="MRK 7:19"/><char style="wj">M'yawng üng lutki cun khyanga mlungmthin k’uma am lut lü a khawnua k’uma ni a luh ve. Acunüng a pumsa üngka naw kpunga lut law bekia kyaki,”</char> a ti. (Acun a pyenak am Jesuh naw ei avan ei vaia nglawiki a tinaka kyaki.)<verse eid="MRK 7:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20"/>Jesuh naw pyen be lü, <char style="wj">“Khyanga k’um üngka naw lut lawki naw va khyang mtüihkhehsak theiki.</char> <verse eid="MRK 7:20"/><verse number="21" style="v" sid="MRK 7:21"/><char style="wj">Isetiakyaüng khyanga mlungmthin k’uma am dawkia ngaihkyunak, m'yuknak, khyang hnimnak,</char> <verse eid="MRK 7:21"/><verse number="22" style="v" sid="MRK 7:22"/><char style="wj">khyanga khyuca katnak, khyanga ka mnaiheinak, am dawkyaki avan jah pawhmsahnak; hleihlaknak, hüipawmnak, ng’eihkyünak, pyenksenak, awhcahnak ja yunak,</char> <verse eid="MRK 7:22"/><verse number="23" style="v" sid="MRK 7:23"/><char style="wj">ahina am dawki he avan cun khyanga k’um üngka naw lut law lü khyang mtüihkhehsakia kyaki,” </char>a ti.<verse eid="MRK 7:23"/></para>
  <para style="s">Krik Nghnuminu mata Jumeinak</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mt 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24"/>Acunüng Jesuh tho law lü Turah mlüh hne peia citeiki. Im mata lut lü u naw pi am a ksing vai ngaih teki, am ngthup thei. <verse eid="MRK 7:24"/><verse number="25" style="v" sid="MRK 7:25"/>Nghnumi mata a canu ngmüimkhya ksea awmnak Jesuha mawng a ngjak üng law lü a khaw kunga ngdäng lawki. <verse eid="MRK 7:25"/><verse number="26" style="v" sid="MRK 7:26"/>Acuna nghnumi cun Krik nghnumi, Siria khaw Phoinikia hnea hmikia khyanga kyaki. Ani naw a canu üngka khawyai Jesuh naw a ksät vaia a nghuinak. <verse eid="MRK 7:26"/><verse number="27" style="v" sid="MRK 7:27"/>Cunsepi Jesuh naw, <char style="wj">“Ca he jah mbei ma vai. Ca hea ei lo u lü ui he jah tawn pet vai hin am nglawiki ni,” </char>a ti.<verse eid="MRK 7:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28"/>Nghnumi naw, <char style="wj">“Bawipa aw, cang veki, cunsepi ui he naw pi hnasena buhkbaw mthüpei khawiki he ni,”</char> a ti.<verse eid="MRK 7:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29"/>Acunüng Jesuh naw, <char style="wj">“Na ngthua phäha, ima cita, canu üngka naw khawyai dawng päng se na hmu khai,”</char> a ti.<verse eid="MRK 7:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30"/>Nghnumi naw ima cit be lü a canu üngka khawyai dawng se, a canu a ihnak üng ngkaw se a hmuh.<verse eid="MRK 7:30"/></para>
  <para style="s">Jesuh naw a nghnga pang lü am ngthuhei theiki a mdaw be</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31"/>Jesuh Turah üngka naw Sidon mlüh da cit lü Kalilea phaki. Mlüh Xa khe pah lü citki. <verse eid="MRK 7:31"/><verse number="32" style="v" sid="MRK 7:32"/>Khyang he naw khyang mat am ngthuhei thei lü a nghnga pi pangki Jesuha veia lawpüi u lü a khana a kut a taih vaia ami nghuinak. <verse eid="MRK 7:32"/><verse number="33" style="v" sid="MRK 7:33"/>Acunüng Jesuh naw khyang hea ngbumnak üngka naw akcea khü lü a kutpyün a nghnga khuia ktun lü, a mci am msawh lü a mlei a hneh. <verse eid="MRK 7:33"/><verse number="34" style="v" sid="MRK 7:34"/>Acunüng Jesuh khankhaw da jeng mang lü, <char style="wj">“Ephata,” </char>a ti. Acun cun <char style="wj">“Nghmawng lawa!” </char>tinaka kyaki.<verse eid="MRK 7:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35"/>Acunja angxita ngja law be thei lü a mleiyüi pi daw law se angsinga ngthuhei law theiki. <verse eid="MRK 7:35"/><verse number="36" style="v" sid="MRK 7:36"/>Acunüng Jesuh naw u üng pi ä ami mtheh vaia a jah ksük; Cunsepi jah mtheh däm däm se ami sang däm däm u. <verse eid="MRK 7:36"/><verse number="37" style="v" sid="MRK 7:37"/>Acunüng aktäa cäi law u lü, “Hin naw avan jah mdaw be ve! A nghnga kpange pi jah ngjaksak be lü angki he pi jah ngthuheisak be ve!” ami ti.<verse eid="MRK 7:37"/></para>
  <chapter eid="MRK 7"/>
  <chapter number="8" style="c" sid="MRK 8"/>
  <para style="s">Jesuh naw khyang thawng kphyü a jah mbei</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mt 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1"/>I vei am ngsawk ham se, khyang khawjah Jesuha veia ngbum law be tüki he. Ami ei vai ipi am lawei u se, Jesuh naw axüisaw he jah khü lü, <verse eid="MRK 8:1"/><verse number="2" style="v" sid="MRK 8:2"/><char style="wj">“Hina khyang he naw na mthimhmatei ve u, mhmüp kthum ka veia awm pängki he atuh ami ei vai ipi am ve.</char> <verse eid="MRK 8:2"/><verse number="3" style="v" sid="MRK 8:3"/><char style="wj">Ei ka ami ima ka jah tüih be üng mä lam cäpa bawng u lü khuikha khai he ni; isetiüng avang he bawk bawk ta ami lawnak thuksihki,”</char> a ti.<verse eid="MRK 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4"/>Axüisaw he naw, “U naw, hina khawkhyawng khawa khyang hijaha ei khyawh vai hmu thei khai ni?” tia ami msang.<verse eid="MRK 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5"/>Jesuh naw, <char style="wj">“Muk ijah nami taki?” </char>ti lü jah kthäh se, <char style="wj">“Khyüh”</char> ami ti.<verse eid="MRK 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6"/>Jesuh naw khyang he mdeka khana a jah ngawsak. Acunüng muk khyüh lo lü Pamhnama veia jenaka ngthu pyen lü, jah bo lü, axüisaw he am khyang hea veia ami jah yet vaia jah pe se, axüisaw he naw ami jah yet. <verse eid="MRK 8:6"/><verse number="7" style="v" sid="MRK 8:7"/>Nga ajaw ami tak pi Jesuh naw Pamhnama veia jenak pyen lü ami yet vaia axüisaw he a jah pet. <verse eid="MRK 8:7"/><verse number="8" style="v" sid="MRK 8:8"/>Ami van naw ei u lü phüki he. Ami ei käna axüisaw he naw mkhäm u se akpawih cä khyüh lawki. <verse eid="MRK 8:8"/><verse number="9" style="v" sid="MRK 8:9"/>Eikie cun thawng phyü lawki he. Acun käna jah tüih be se <verse eid="MRK 8:9"/><verse number="10" style="v" sid="MRK 8:10"/>mlawng üng axüisaw he am lut u lü Damanuta khawa citki he.<verse eid="MRK 8:10"/></para>
  <para style="s">Pharise he naw Müncanak ami kthäh</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mt 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">Mt 12:38</ref>; <ref loc="LUK 11:16">Lk 11:16</ref></char>
    </note> Pharise avang Jesuha veia law u lü ngcuhpüiki he naw, Pamhnam naw a kcangnak angsingnak vaia mhnüteinak khanaka müncankse ami kthäh. <verse eid="MRK 8:11"/><verse number="12" style="v" sid="MRK 8:12"/><note caller="-" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">Mt 12:39</ref>; <ref loc="LUK 11:29">Lk 11:29</ref></char></note> Cunsepi Jesuh naw a mlungmthin k’uma aktäa ngko lü, <char style="wj">“Ise atuha kcün khyang he naw müncankse ami kthäh ni? Akcanga ka ning jah mthehki! Msingnak mat pi am ning jah mhnüh hlü ve nawng,”</char> a ti.<verse eid="MRK 8:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13"/>Jah yawk hütki naw mlawng üng lut be lü tuili cayea citki.<verse eid="MRK 8:13"/></para>
  <para style="s">Pharise he la Heroda Nghngen</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mt 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14"/>Axüisaw he naw ami ei khyawh vai muk mhnih hüt u lü mlawng üng muk mat däng taki he. <verse eid="MRK 8:14"/><verse number="15" style="v" sid="MRK 8:15"/><note caller="-" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">Lk 12:1</ref></char></note>Jesuh naw, <char style="wj">“Pharise hea nghngen</char><note caller="+" style="f"><char style="fr" closed="false">8:15 </char><char style="ft" closed="false">Nghngen cun Pharise he naw am dawkia ami jah mtheimthangnaka kyaki</char></note><char style="wj">la Heroda nghngen üng ngxungei kyu u lü ngcäiei na ua,”</char> a ti.<verse eid="MRK 8:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16"/>Axüisaw he naw, “Muk<note caller="+" style="f"><char style="fr" closed="false">8:16 </char><char style="ft" closed="false">Judah he naw muk ami pawh üng ami sumei khawia kyaki</char></note> am mi ta se va hinkba pyen mäih ja,” tia ngthähki he.<verse eid="MRK 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17"/>Jesuh naw ami ngthäh kyu jah ksing lü, <char style="wj">“I vai muk am nami taka phäha nami ngthäh kyuki ni? Atuh pi nami mlungmthin am am nami ksing hamki aw? Nami mlung nghlang hamki aw? </char> <verse eid="MRK 8:17"/><verse number="18" style="v" sid="MRK 8:18"/><note caller="-" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">Jer 5:21</ref>; <ref loc="EZK 12:2">Hez 12:2</ref>; <ref loc="MRK 4:12">Mk 4:12</ref></char></note><char style="wj">Mik mah u lü am nami hmuki aw? Nghnga mah u lü am nami ngjaki aw? Am nami süm hamki aw?</char> <verse eid="MRK 8:18"/><verse number="19" style="v" sid="MRK 8:19"/><char style="wj">Kei naw muk mhma khyang thawng mhma phäha ka pawh üng, kpawihki cä ijaha ni nami kaw?”</char> ti se, amimi naw,</para>
  <para style="p" vid="MRK 8:19">“Xaleinghngih,” ami ti.<verse eid="MRK 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20"/>
    <char style="wj">“Acun käna muk khyüh khyang thawng kphyüa phäha ka pawh üng kpawihki cä ijah ni nami kaw?” </char>ti se, amimi naw,</para>
  <para style="p" vid="MRK 8:20">“Cä khyüh,” ami ti.<verse eid="MRK 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21"/>Jesuh naw, <char style="wj">“Acunüng ihawkba am ksing u lü nami awmki ni?”</char> a ti.<verse eid="MRK 8:21"/></para>
  <para style="s">Bethsaida khawa a mik müki a mdaw be</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22"/>Bethsaida khawa law u se Jesuha veia a mik müki mat khyang avang naw lawpüi u lü a hnet vaia ami nghuinak. <verse eid="MRK 8:22"/><verse number="23" style="v" sid="MRK 8:23"/>Jesuh naw a mik müki a kut üng kpang lü ngnam kpunga cehpüiki naw, a mik üng msawh lü a kut a khana mtaih lü, <char style="wj">“Ini na hmu thei,” </char>ti lü, a kthäh.<verse eid="MRK 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24"/>A mik müki naw jeng mang lü, “Ä, khyang he thinga mäiha cit hü u se jah hmu veng,” a ti.<verse eid="MRK 8:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25"/>Jesuh naw a kut cun a mika khana mtaih beki naw, yet lü a teng süm vaia a mtheh. Acunüng a mik vai law be se, avan a ngkhaia hmu theiki. <verse eid="MRK 8:25"/><verse number="26" style="v" sid="MRK 8:26"/>Jesuh naw a ima tüi be lü, <char style="wj">“Ngnam k’uma ä cit bea,” </char>ti lü a mtheh.<verse eid="MRK 8:26"/></para>
  <para style="s">Pita naw Jesuh a ninak a pyen</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mt 16:13-20</ref>; <ref loc="LUK 9:18-21">Lk 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27"/>Acunüng Jesuh la axüisaw he cun Kesari Philipih pei ngnam hea citki he. Lama, “Khyang he naw, ua ni ami na ngaih?” ti se,<verse eid="MRK 8:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:28 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 6:14">Mk 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">Lk 9:7</ref>,<ref loc="LUK 9:8">8</ref></char>
    </note>
    <char style="wj">“Baptican Johan; avang naw Elijah; avang naw sahma he üngka mat mat,” </char>ti ve u ami ti.<verse eid="MRK 8:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:29 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:68">Jn 6:68</ref>,<ref loc="JHN 6:69">69</ref></char>
    </note>Jesuh naw, <char style="wj">“Nangmi naw mä ua ni nami na ngaih?”</char> ti se,</para>
  <para style="p" vid="MRK 8:29">Pita naw, “Nang cun Mesijah ni,” ti lü a msang.<verse eid="MRK 8:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30"/>Acunüng Jesuh naw, <char style="wj">“U pi ä mtheh ua”</char> a ti.<verse eid="MRK 8:30"/></para>
  <para style="s">A khuikhanak vai la a Thihnak vai Jesuh naw pyenki</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mt 16:21-28</ref>; <ref loc="LUK 9:22-27">Lk 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31"/>Acunüng Jesuh naw, “Khyanga Capa cun mkhuimkha khai he, axüngvai he , ktaiyü ktung he la, thum jah mtheiki he naw mah u lü, hnim khai he, acunüng amhmüp kthum üng tho law be khai,” ti lü a jah mtheh. <verse eid="MRK 8:31"/><verse number="32" style="v" sid="MRK 8:32"/>Acukba angsinga ngthu jah mtheh se Pita naw akcea khü lü a ksenak. <verse eid="MRK 8:32"/><verse number="33" style="v" sid="MRK 8:33"/>Cunsepi Jesuh naw nghlat hü lü, axüisaw he jah teng lü, Pita üng, <char style="wj">“Khawyam aw, ka vei üngka naw cita; na ngaihkyunak Pamhnama vei üngkaa am kya lü khyang üngkaa ni a kya ve,”</char> ti lü a ksenak be.<verse eid="MRK 8:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:34</char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">Mt 10:38</ref>; <ref loc="LUK 14:27">Lk 14:27</ref></char>
    </note>Acunüng Jesuh naw khyang he la axüisaw he a veia jah khü lü, <char style="wj">“Upi ka veia na läk law khaia büki naw amät naw amät yawk lü, a kutlamktung kawt lü, na läk law se.</char> <verse eid="MRK 8:34"/><verse number="35" style="v" sid="MRK 8:35"/><note caller="-" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">Mt 10:39</ref>; <ref loc="LUK 17:33">Lk 17:33</ref>; <ref loc="JHN 12:25">Jn 12:25</ref></char></note><char style="wj">Isetiakyaüng, upi amäta xünnak küikyanei khaia büki naw mkhyüh lü, upi a xünnak keia phäha ja thangkdaw phäha mkhyühki cun naw küikyanei khai. </char> <verse eid="MRK 8:35"/><verse number="36" style="v" sid="MRK 8:36"/><char style="wj">Khyang naw khawmdek avan ka na lü, a xünnak a mkhyüh üng i ngmang na khai ni? I am ngmang na. </char> <verse eid="MRK 8:36"/><verse number="37" style="v" sid="MRK 8:37"/><char style="wj">A xünnak a yahnak be thei vaia i am pi am thawng be thei.</char> <verse eid="MRK 8:37"/><verse number="38" style="v" sid="MRK 8:38"/><char style="wj">Hina Mhnam am ktäkie la katnaka mhmüp he üng, upi kei la keia mtheimthangnaka phäh ngkekhyakeiki he cun Khyanga Capa naw pi a Pa hlüngtainak la khankhawngsä ngcim he am a law be üng jah ngkekhyakei na be khai,” </char>a ti.<verse eid="MRK 8:38"/></para>
  <chapter eid="MRK 8"/>
  <chapter number="9" style="c" sid="MRK 9"/>
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1"/>Acunüng amät kung naw ami veia, <char style="wj">“Ka ning jah mthehki, hin üng ngdüiki he avang cun Pamhnama khaw hlüngtainak am pha law se, am hmu pha u lü am thi khai he awmki he,”</char> a ti.<verse eid="MRK 9:1"/></para>
  <para style="s">Jesuha Hngalangnak</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mt 17:1-13</ref>; <ref loc="LUK 9:28-36">Lk 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">9:2-7:</char>
      <char style="xt" closed="false">
        <ref loc="2PE 1:17-18">2Pit 1:17-18</ref>
      </char>
    </note> Amhmüp khyuk käna Jesuh naw, Pita, Jakuk la Johan jah khü lü angxinak khawmcung, a hlüngnaka a jah cehpüi. Acunüng ami maa Jesuh a hmai halangei lawki. <verse eid="MRK 9:2"/><verse number="3" style="v" sid="MRK 9:3"/>A suisak he cun khawmdek khana suisak msawpkie u naw pi acunkba bawk khaia am ami msawp thei vaia bawk lawki. <verse eid="MRK 9:3"/><verse number="4" style="v" sid="MRK 9:4"/>Acunüng Elijah la Mosi cun Jesuh am ngthuhei ni se axüisaw kthum he naw ami jah hmuh. <verse eid="MRK 9:4"/><verse number="5" style="v" sid="MRK 9:5"/>Pita naw, “Saja aw, hia mi ve hin daw ve! na phäha mat, Mosia phäha mat, Elijaha phäha mat, sam kthum pha va üng,” a ti.<verse eid="MRK 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 9:6"/>Ami van kyü ngenki hea kyase, Pita naw i a ti vai am ksingei. <verse eid="MRK 9:6"/><verse number="7" style="v" sid="MRK 9:7"/><note caller="-" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="MAT 3:17">Mt 3:17</ref>; <ref loc="MRK 1:11">Mk 1:11</ref>; <ref loc="LUK 3:22">Lk 3:22</ref></char></note>Acunüng khawngmei lawki naw a jah ksungin law; kthaih ngmei üngka naw, “Hin hin ka jawng'engnaka ka Capaa kyaki ni, a ngthu ngai ua,” tia ngthang lawki. <verse eid="MRK 9:7"/><verse number="8" style="v" sid="MRK 9:8"/>Acun käna ami pipei ami teng üng i pi am hmu u lü Jesuh däng ami veia ve se ami hmuh.<verse eid="MRK 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9"/>Mcung üngka naw ami kyum law be üng Jesuh naw, “Khyanga Capa thihnak üngka naw am a thawh law be phata küt üng nami hmuhtheh he u pi ä jah mtheh ua” ti lü a jah ksük.<verse eid="MRK 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10"/>A mtheh ngjaki he, acunüngpi, “Thihnak üngka naw thawh be tia suilam hin i ni?” tia amimät ngthäh kyuki he. <verse eid="MRK 9:10"/><verse number="11" style="v" sid="MRK 9:11"/><note caller="-" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAL 4:5">Mal 4:5</ref>; <ref loc="MAT 11:14">Mt 11:14</ref></char></note>Axüisaw he naw Jesuh üng, “Ise thum jah mtheiki he naw Elijah law ma khai ami ti ni?” tia ami kthäh.<verse eid="MRK 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12"/>Jesuh naw, <char style="wj">“Elijah cun law ma kung lü avan jah pyangtham law be khai. Ise cangcim naw Khyanga Capa mah u se aktäa khuikha khai a ti ni? </char> <verse eid="MRK 9:12"/><verse number="13" style="v" sid="MRK 9:13"/><char style="wj">Ka ning jah mthehki, Elijah pi law päng se a mawngma a ng’yuka kba amimäta ngaih ngaiha ami pawh,” </char>a ti.<verse eid="MRK 9:13"/></para>
  <para style="s">Khawyaia Awmnak Hnasen Jesuh naw a M’yai be</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mt 17:14-21</ref>; <ref loc="LUK 9:37-43">Lk 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14"/>Jesuh axüisaw he a veia a law üng khyang he khawjah naw jah ngbum si u lü, thum jah mtheiki he naw jah mtaipüi u se a jah hmuh. <verse eid="MRK 9:14"/><verse number="15" style="v" sid="MRK 9:15"/>Acunüng Jesuh ami hmuh la khyang ami van naw aktäa cäi law u lü a veia dawngkie naw ami hnukset law. <verse eid="MRK 9:15"/><verse number="16" style="v" sid="MRK 9:16"/>Jesuh naw a xüisaw he üng, <char style="wj">“Acane am i nami ngcuhki ni?”</char> ti lü a jah kthäh.<verse eid="MRK 9:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17"/>Khyang mat ami ksung üngka naw, “Saja aw, ka capa khawyai naw ve na se am ngthuheiki na veia ka lawpüi. <verse eid="MRK 9:17"/><verse number="18" style="v" sid="MRK 9:18"/>A man law naküt üng mdek üng a kyuksak; acunüng a mcimvawne jah mhlawn lü, a ha jah kyet lü, cai law lü, ve khawiki; na xüisaw he am ami ksät vaia ka jah mtheh amimi naw pi am ksät khawh ve u,” ti lü a pyen.<verse eid="MRK 9:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19"/>Jesuh naw, <char style="wj">“Aw, jumeinak am takia khyang he, ivei nami hlawnga ka awm khai aw? Ivei nami hlawnga ka ve khai ni? Ka veia hnasen cun lawpüi ua,” </char>a ti. <verse eid="MRK 9:19"/><verse number="20" style="v" sid="MRK 9:20"/>Jesuha veia ami lawpüi.</para>
  <para style="p" vid="MRK 9:20">Khawyai naw Jesuh a hmuh la, hnasen cun aknuia pawh lü mdek vawih na se ngtat hü lü a mcimvawn lawng lawki. <verse eid="MRK 9:20"/><verse number="21" style="v" sid="MRK 9:21"/>Jesuh naw a pa üng, <char style="wj">“Ahinkba a awmnak ivei law pängki ni?” ti lü kthäh se a pa naw, </char></para>
  <para style="p" vid="MRK 9:21">“Angmawca üng a tünei ni, <verse eid="MRK 9:21"/><verse number="22" style="v" sid="MRK 9:22"/>hnim hü lü khawvei mei üng, tui üng a buhtawn khawi; Cunsepi na mdaw be khawh üng ta jah m’yenei lü jah kpüia,” ti lü a nghuinak.<verse eid="MRK 9:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23"/>Jesuh naw <char style="wj">“Ä” </char>ti lü, <char style="wj">“Na jumki aw? Jumkia phäha avan kya theiki ni,”</char> a ti.<verse eid="MRK 9:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24"/>Hnasena pa naw ngpyang lü, “Jum veng, Cunsepi ka jumnak am khäk ve; ka jum lawnak däm vaia na kpüia,” a ti.<verse eid="MRK 9:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25"/>Jesuh naw khyang he naw jah k’et lawki he ti a jah ksing üng khawyai üng, <char style="wj">“Pang lü, angkia ngmüimkhya, hina hnasen üngka naw lut law lü, a veia ä lut be tia,”</char> ti lü a ksenak.<verse eid="MRK 9:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26"/>Acunüng khawyai cun ngpyang lü, hnasen kthüng lü, lut lawki. Hnasen cun akthia mäiha ve law se khyang naküt naw, “Thi ve,” ami ti. <verse eid="MRK 9:26"/><verse number="27" style="v" sid="MRK 9:27"/>Jesuh naw hnasen cun a kut üng kpang lü mtho se, ngdüi lawki.<verse eid="MRK 9:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28"/>Acun käna Jesuh im k’uma a luh law üng axüisaw he naw, “Ise keimi naw am kami ksät thei ni?” tia, ami kthäh.<verse eid="MRK 9:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29"/>Jesuh naw, <char style="wj">“Hina mäih cun ktaiyünaka thea ta i am ksät thei vaia am kya naw,” </char>a ti.<verse eid="MRK 9:29"/></para>
  <para style="s">Jesuh naw a Thih vai Pyen beki</para>
  <para style="r">(<ref loc="MAT 17:22">Mt 17:22</ref>,<ref loc="MAT 17:23">23</ref>; <ref loc="LUK 9:43-45">Lk 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30"/>Jesuh la axüisaw he ngnam ceh ta u lü Kalile da citki he. Jesuh naw a awmnak u naw pi a ksing vai am a ngaih. <verse eid="MRK 9:30"/><verse number="31" style="v" sid="MRK 9:31"/>Isetiakyaüng, axüisaw he üng, <char style="wj">“Khyanga Capa cun khyang he üng ap khai he, hnima kya khai, acun käna amhmüp kthum üng tho law be khai,”</char> ti lü a jah mtheia phäha kyaki.<verse eid="MRK 9:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32"/>Cunsepi axüisaw he naw a jah mtheimthangnak am ksing u, ami kthäh vaia pi kyüh u lü, am kthäh u.<verse eid="MRK 9:32"/></para>
  <para style="s">U kyäp Säihki?</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mt 18:1-5</ref>; <ref loc="LUK 9:46-48">Lk 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33"/>Kapenawma law u lü, im k’uma ami ve k’um üng, Jesuh naw axüisaw he üng, <char style="wj">“Lam cäpa i nami mtaiki?”</char> ti lü a jah kthäh.<verse eid="MRK 9:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">9:34 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">Lk 22:24</ref>
      </char>
    </note> Lam cäpa amimät he üng u kyäp säih khai tia mtaiki hea kyase ami van naw am ami msang. <verse eid="MRK 9:34"/><verse number="35" style="v" sid="MRK 9:35"/><note caller="-" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">Mt 20:26</ref>,<ref loc="MAT 20:27">27</ref>; <ref loc="MAT 23:11">23:11</ref>; <ref loc="MRK 10:43">Mk 10:43</ref>,<ref loc="MRK 10:44">44</ref>; <ref loc="LUK 22:26">Lk 22:26</ref></char></note>Acunüng Jesuh naw a ngawhnak üng xaleinghngih he jah khü lü, <char style="wj">“Upi a ma säih vai ngjahlüki cun hnu säih lü, avana m'yaa kya se,” </char> ti lü a jah mtheh. <verse eid="MRK 9:35"/><verse number="36" style="v" sid="MRK 9:36"/>Jesuh naw hnasenca mat khü lü ami ksung üng a ngdüihsak. Acunüng a kut am kpawm lü, <verse eid="MRK 9:36"/><verse number="37" style="v" sid="MRK 9:37"/><note caller="-" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">Mt 10:40</ref>; <ref loc="LUK 10:16">Lk 10:16</ref>; <ref loc="JHN 13:20">Jn 13:20</ref></char></note><char style="wj">“Upi hina hnasenca he üngka mat ka ngming üng doeiki cun kei na dokia kyaki; acunüng upi kei na doki cun, kei däng na dokia am kya lü kei na tüih lawkia ka Pa pi dokia kyaki ni,” </char> a ti.<verse eid="MRK 9:37"/></para>
  <para style="s">Am ning jah Hnengki cun nangmi da Awmki ni</para>
  <para style="r">(<ref loc="LUK 9:49">Lk 9:49</ref>,<ref loc="LUK 9:50">50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38"/>Johan naw, “Saja aw, khyang mat mi hlawnga am ngkhap hü hngaki naw na ngming am khawyai he jah ksät se kami hmuh, mi hlawnga am ngkhap hü hngakia kyase a bilawh kami mkhye,” a ti.<verse eid="MRK 9:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39"/>Jesuh naw, <char style="wj">“Ä mkhye pe ua, ka ngming am müncankse vai pawhmsahki naw acun käna akjäiha am na pyetse khai ni. </char> <verse eid="MRK 9:39"/><verse number="40" style="v" sid="MRK 9:40"/><note caller="-" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">Mt 12:30</ref>; <ref loc="LUK 11:23">Lk 11:23</ref></char></note><char style="wj">Mimi am jah hnengki cun mimi da awmkia kyaki ni.</char> <verse eid="MRK 9:40"/><verse number="41" style="v" sid="MRK 9:41"/><note caller="-" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">Mt 10:42</ref></char></note><char style="wj">Ka ning jah mthehki, upi ka khyanga nami kyaa phäha awk vai tui a khawtca ning jah peki cun a ngkhyengnak vai am lap khai ni. </char><verse eid="MRK 9:41"/></para>
  <para style="s">Katnak vaia Hlawhlepnak</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mt 18:6-9</ref>; <ref loc="LUK 17:1">Lk 17:1</ref>,<ref loc="LUK 17:2">2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42"/>
    <char style="wj">“Upi hnasena kba kei na jumki kyukngtängsaki cun a nghngü üng ksumnu khawp u lü mliktui üng tawnin üng daw bawk khai ni.</char> <verse eid="MRK 9:42"/><verse number="43-44" style="v" sid="MRK 9:43-44"/><note caller="-" style="x"><char style="xo" closed="false">9:43-44 </char><char style="xt" closed="false"><ref loc="MAT 5:30">Mt 5:30</ref></char></note><char style="wj">Acunakyase na kut naw a ning katkawngsaki üng khyüngina! Kut nghngih küm se, am dim theikia mulaia na ceha kdama ta, kut am küm se xünnaka pha hin na phäha daw bawki ni.</char> <verse eid="MRK 9:43-44"/><verse number="45-46" style="v" sid="MRK 9:45-46"/><char style="wj">Na khaw naw a ning katkawngsak üng xüngina! Khaw nghngih küm se, mei am dim theikia mulaia na ceha kdama ta, khaw am küm se xünnaka pha hin na phäha daw bawki ni. </char> <verse eid="MRK 9:45-46"/><verse number="47" style="v" sid="MRK 9:47"/><note caller="-" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">Mt 5:29</ref></char></note> <char style="wj">Na mik naw a ning katkawngsak üng kawihina! Na mik küm se mulaia na ceha kdama ta, mik mat däng am Pamhnama khaw na luh hin daw bawki ni.</char> <verse eid="MRK 9:47"/><verse number="48" style="v" sid="MRK 9:48"/><note caller="-" style="x"><char style="xo" closed="false">9:48: </char><char style="xt" closed="false"><ref loc="ISA 66:24">Hesa 66:24</ref></char></note> <char style="wj">Acuia jah eikia mkyüt am thi lü jah uikia mei pi am dim thei. </char><verse eid="MRK 9:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49"/>
    <char style="wj">Ngkengnaka sa mci am caihsaka kba khyang avan mei am caisak vai. </char><verse eid="MRK 9:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">9:50 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:13">Mt 5:13</ref>; <ref loc="LUK 14:34">Lk 14:34</ref>,<ref loc="LUK 14:35">35</ref></char>
    </note>
    <char style="wj">Mci hin dawki ni; Cunsepi a tuinak a khyüh üng ihawkba nami tuisak be khai ni? </char></para>
  <para style="p" vid="MRK 9:50">
    <char style="wj">Mcia kba tuikia ngkhawteinak ta u lü, mat la mat dim’yenak am awm ua,” </char>a ti.<verse eid="MRK 9:50"/></para>
  <chapter eid="MRK 9"/>
  <chapter number="10" style="c" sid="MRK 10"/>
  <para style="s">Ngkhyungla Ngtainaka mawng jah mtheinak</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mt 19:1-12</ref>; <ref loc="LUK 16:18">Lk 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1"/>Acunüng Jesuh Judah khaw da cit lü Jordan mliktui khe paki. Khyang he a veia ngcun law be u se Jesuh naw a ti khawia kba a jah mthei be.<verse eid="MRK 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2"/>Pharise avang naw law u lü a ngthu ami man vaia phäha, “Khyang naw a khyu a yawk vai hin mi thum üng nglawiki aw?” tia ami kthäh.<verse eid="MRK 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3"/>Jesuh naw, <char style="wj">“Mosi naw ia thum ni a ning jah pet?”</char> ti lü ngthähnak am a jah msang be.<verse eid="MRK 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">10:4: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 24:1-4">Deut 24:1-4</ref>; <ref loc="MAT 5:31">Mt 5:31</ref></char>
    </note>Amimi naw, “Mosi naw ngtainaka kca yu u lü, khyu cun mtai vaia a ti ni,” tia ami msang.<verse eid="MRK 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5"/>Jesuh naw, <char style="wj">“Ning jah mthei vaia nami mlung nghlang se, Mosi naw acunkba thum a ning jah yuk pet ni.</char> <verse eid="MRK 10:5"/><verse number="6" style="v" sid="MRK 10:6"/><note caller="-" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 1:27">Gen 1:27</ref>; <ref loc="GEN 5:2">5:2</ref></char></note><char style="wj">Cunsepi, cangcim naw a pyena kba, ‘mhmünmcengnak atünei üng Mhnam naw nghnumi la kpami a jah mhmün’ tia kyaki. </char> <verse eid="MRK 10:6"/><verse number="7" style="v" sid="MRK 10:7"/><note caller="-" style="x"><char style="xo" closed="false">10:7,8: </char><char style="xt" closed="false"><ref loc="GEN 2:24">Gen 2:24</ref></char></note><char style="wj">‘Acunakyase kpami naw a nu la a pa jah yawk lü, a khyua veia ngdawn</char><note caller="+" style="f"><char style="fr" closed="false">10:7 </char><char style="fq" closed="false">a khyua veia ngdawn khai ti avang üng am ami yuk. </char></note><char style="wj">khai</char>, <verse eid="MRK 10:7"/><verse number="8" style="v" sid="MRK 10:8"/><char style="wj">acunüng nghngih cun mata kya law khai.’ Acunüng ni nghngiha am kya ti lü mata kya law khai.</char> <verse eid="MRK 10:8"/><verse number="9" style="v" sid="MRK 10:9"/><char style="wj">Acunakyase Mhnam naw atänga a jah mdawn päng khyang naw ä jah mtai se,” </char>a ti.<verse eid="MRK 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10"/>Ima ami ceh be käna axüisaw he naw acuna mawng bä cun ami kthäh be tü. <verse eid="MRK 10:10"/><verse number="11" style="v" sid="MRK 10:11"/><note caller="-" style="x"><char style="xo" closed="false">10:11,12: </char><char style="xt" closed="false"><ref loc="MAT 5:32">Mt 5:32</ref>; <ref loc="1CO 7:10">1Kor 7:10</ref>,<ref loc="1CO 7:11">11</ref></char></note>Jesuh naw, <char style="wj">“Upi a khyu yawk lü akce khyu na beki cun a khyu katnaki ni.</char> <verse eid="MRK 10:11"/><verse number="12" style="v" sid="MRK 10:12"/><char style="wj">Acun kba nghnumi pi a cei yawk lü akce cei na beki cun a cei katnaki ni,” </char>a ti.<verse eid="MRK 10:12"/></para>
  <para style="s">Jesuh naw hnasen he josenak am a jah be</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mt 19:13-15</ref>; <ref loc="LUK 18:15-17">Lk 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13"/>Avang naw hnasen he, Jesuh naw ami khana a kut a mtaih vaia a veia jah lawpüi u se, axüisaw he naw lawpüiki he ami jah kdunak. <verse eid="MRK 10:13"/><verse number="14" style="v" sid="MRK 10:14"/>Jesuh naw ksing lü thüiki naw, <char style="wj">“Hnasen he ka veia law u se, ä jah mah ua, Pamhnama khaw cun amimia mäiha phäha kyaki ni.</char> <verse eid="MRK 10:14"/><verse number="15" style="v" sid="MRK 10:15"/><note caller="-" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">Mt 18:3</ref></char></note> <char style="wj">Akcanga ka ning jah mthehki, upi Pamhnama khaw hina hnasen naw a dokhameia kba am dokhameiki cun acuia am lut khai,”</char> a ti. <verse eid="MRK 10:15"/><verse number="16" style="v" sid="MRK 10:16"/>Acunüng Jesuh naw hnasen he a ban am jah jäk lü, ami khana a kut mtaih lü, josenak am jah kbeki.<verse eid="MRK 10:16"/></para>
  <para style="s">Anglät Xünnak Suikia Bawimangpa mat</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mt 19:16-30</ref>; <ref loc="LUK 18:18-30">Lk 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17"/>Jesuh lam üng a ceh k’um üng khyang mat a veia dawng law lü, a ma ngdäng lü, “Saja kdaw aw, anglät xünnak ka yahnak thei vaia i ka pawh khai?” ti lü a kthäh.<verse eid="MRK 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18"/>Jesuh naw, <char style="wj">“Ivai saja kdaw tia, na na khüki ni? Mhnama thea u mat pi am daw naw. </char> <verse eid="MRK 10:18"/><verse number="19" style="v" sid="MRK 10:19"/><note caller="-" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:13">Ex 20:13</ref>; <ref loc="DEU 5:17">Deut 5:17</ref>; </char><char style="xt" closed="false"><ref loc="EXO 20:14">Ex 20:14</ref>; <ref loc="DEU 5:18">Deut 5:18</ref>; </char><char style="xt" closed="false"><ref loc="EXO 20:15">Ex 20:15</ref>; <ref loc="DEU 5:19">Deut 5:19</ref>; </char><char style="xt" closed="false"><ref loc="EXO 20:16">Ex 20:16</ref>; <ref loc="DEU 5:20">Deut 5:20</ref>; </char><char style="xt" closed="false"><ref loc="EXO 20:12">Ex 20:12</ref>; <ref loc="DEU 5:16">Deut 5:16</ref></char></note><char style="wj">‘Khyanga khyu ä na katnak vai; khyang ä na hnim vai; ä na m'yuk vai; ä na hleihlak vai; khyanga ka am hman müi se ä na bi vai; na nu la na pa na jah mhlünmtai vai’ tia ngthupet he cun na jah ksingki ni,”</char> a ti.<verse eid="MRK 10:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20"/>Acuna khyang naw, “Saja aw, ahin he avan cun ka nghmawca üng tün lü, ka jah läk päng ni,” ti se,<verse eid="MRK 10:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21"/>Jesuh naw jawng'engnaka mlungmthin am teng lü, <char style="wj">“Mat kpawih na veki. Cit lü na taka khawhthem avan jawi lü sim'yaki he am jah pea, khankhawa bawimangnak na yah khai ni; acunüng law lü na läk lawa,” </char>a ti. <verse eid="MRK 10:21"/><verse number="22" style="v" sid="MRK 10:22"/>Acun bawimangpa naw a ngjak la aktäa khawhthem danakia kyase, a hmai se lü thuiseinak am citki.<verse eid="MRK 10:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23"/>Acunüng Jesuh naw mdei hü lü axüisaw he üng, <char style="wj">“Khawhthem danaki he, Pamhnama khaw ami luh vai aktäa khak ve,”</char> a ti.<verse eid="MRK 10:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24"/>Acuna ngthua phäha axüisaw he cun aktäa cäiki he. Acunüng Jesuh naw, <char style="wj">“Ka ca he aw, Pamhnama khaw luh vai aktäa khak ve!</char> <verse eid="MRK 10:24"/><verse number="25" style="v" sid="MRK 10:25"/><char style="wj">Bawimangki, Pamhnama khaw a luha kdama ta, kulauk mpyüma nghnga üng a luh vai jäi bawk ve,” </char>ti lü a jah mtheh.<verse eid="MRK 10:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26"/>Acuna axüisaw he aksehlena cäi law u lü, amimät la amimät, “Am ani üng u küikyana kya thei khai aw?” tia ngthäh kyuki he.<verse eid="MRK 10:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27"/>Jesuh naw jah teng lü, <char style="wj">“Khyanga phäha hin hin khaki ni, Cunsepi Mhnama phäha khaki i am ve naw,”</char> a ti.<verse eid="MRK 10:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28"/>Acunüng Pita naw msang lü, “Tenga, avan jah yawk hüt u lü kami ning läk law hin,” a ti.<verse eid="MRK 10:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29"/>Jesuh naw, <char style="wj">“Akcanga ka ning jah mthehki, kei la thangkdaw phäha a im, a bena he la, a nu pa, a ca he, a khawloe jah yawkki naw,</char> <verse eid="MRK 10:29"/><verse number="30" style="v" sid="MRK 10:30"/><char style="wj">Atuh xün k’um üng däm bawki jah yah be khai. Ime, a bena he, a nu pa he, a ca he, a khawloe la mkhuimkhanak he pi aphyaa däm bawki jah yah be lü, pha law khaia kcün üng anglät xünnak pi yah be khai.</char> <verse eid="MRK 10:30"/><verse number="31" style="v" sid="MRK 10:31"/><note caller="-" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">Mt 20:16</ref>; <ref loc="LUK 13:30">Lk 13:30</ref></char></note> <char style="wj">Cunsepi, atuh khawjah maki he hnu u lü, hnuki he ma law khai he,” </char>a ti.<verse eid="MRK 10:31"/></para>
  <para style="s">Jesuh naw a Thihnak vai a Pyen Akthumveinak</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mt 20:17-19</ref>; <ref loc="LUK 18:31-34">Lk 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32"/>Jesuh la axüisaw he Jerusalem cehnaka lam üng awmki he. Jesuh cun axüsaw hea hmaia ma lü cit se kcäväki he. A hnu läk law hngaki he kyü lawki he. Jesuh naw xaleinghngih he akcea jah khü lü a khana pha law khai jah mthehki naw, <verse eid="MRK 10:32"/><verse number="33" style="v" sid="MRK 10:33"/><char style="wj">“Ngai u, Jerusalema mi jeng cit khai he, acuia Khyanga Capa cun ktaiyü ktung he la thum jah mtheiki hea veia cenga kya khai. Amimi naw thi khaia mkatei u lü khyangmjükce he üng msum khai he.</char> <verse eid="MRK 10:33"/><verse number="34" style="v" sid="MRK 10:34"/><char style="wj">Acun he naw yaihei khai he, msawh khai he, kpai khai he, hnim khai he; Cunsepi amhmüp kthum üng tho law be khai,”</char> a ti.<verse eid="MRK 10:34"/></para>
  <para style="s">Jakuk la Johan naw Hlüngtainak ani Kthäh</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mt 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35"/>Acunüng Zebedea capa xawi Jakuk la Johan Jesuha veia law ni lü, “Saja aw, kani phäha na jah pawh pet vai kani ngjak hlü iyaw awmki,” ani ti.<verse eid="MRK 10:35"/></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36"/>Jesuh naw jah kthäh lü, <char style="wj">“Ini ka ning jah pawh pet vai na ni ngjak hlü?” </char>a ti.<verse eid="MRK 10:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37"/>Anini naw, “Na hlüngtainaka khawa, na bawingawhnak üng na ngawh law üng, mat na kpat da mat na k'eng da na jah ngawhsak vai kani ngjahlüki,” ani ti.<verse eid="MRK 10:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">10:38 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:50">Lk 12:50</ref>
      </char>
    </note>Jesuh naw, <char style="wj">“Nani kthäh am ksingei ve niki. Ka awk vaia khuikhanaka khawt nani aw khawh khai aw? Baptican ka khan vaia kba pi nani khan khawh khai aw?” </char>ti se,<verse eid="MRK 10:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39"/>anini naw, “Kani khyaih khai ni” ani ti.</para>
  <para style="p" vid="MRK 10:39">Jesuh naw, <char style="wj">“Ka awk vaia khawt nani aw thei kcang taw khai, Baptican ka khan vaia kba pi nani khan thei kcang taw khai;</char> <verse eid="MRK 10:39"/><verse number="40" style="v" sid="MRK 10:40"/><char style="wj">Cunsepi ka kpat lama ngaw khai ja ka k'eng lama ngaw khai cun keia xü vaia am kya naw. Acun cun ani naw a jah pyan peta khyang hea phäha acuna hmün he jah pe khai cun Mhnama kyaki,”</char> a ti.<verse eid="MRK 10:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41"/>Akce xa he naw ngja law u lü Jakuk la Johana khana aktäa thüiki he. <verse eid="MRK 10:41"/><verse number="42" style="v" sid="MRK 10:42"/><note caller="-" style="x"><char style="xo" closed="false">10:42,43</char><char style="xt" closed="false"><ref loc="LUK 22:25">Lk 22:25</ref>,<ref loc="LUK 22:26">26</ref></char></note>Acunakyase Jesuh naw a veia jah khü lü, <char style="wj">“Khyangmjükce hea khana mkhawnga ami jah mcawn he cun ana atäa taki he ti nami ksingki. </char> <verse eid="MRK 10:42"/><verse number="43" style="v" sid="MRK 10:43"/><note caller="-" style="x"><char style="xo" closed="false">10:43,44 </char><char style="xt" closed="false"><ref loc="MAT 23:11">Mt 23:11</ref>; <ref loc="MRK 9:35">Mk 9:35</ref>; <ref loc="LUK 22:26">Lk 22:26</ref></char></note><char style="wj">Cunsepi acunkba nangmi üng ä kya se. Nangmi üng a kyäp säih vai ngjahlüki cun nami m'ya a kya se.</char> <verse eid="MRK 10:43"/><verse number="44" style="v" sid="MRK 10:44"/><char style="wj">Nangmi üng a ma säih vai ngjahlüki cun avana m'yaa kyase.</char> <verse eid="MRK 10:44"/><verse number="45" style="v" sid="MRK 10:45"/><char style="wj">Khyanga Capa cun khyanga khüih vaia am law lü; khyang jah khüih lü khawjah thawnnak vaia a xünnak pe khaia ni a law ve,”</char> a ti.<verse eid="MRK 10:45"/></para>
  <para style="s">Jesuh naw a mik müki Batihme a mdaw be</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mt 20:29-34</ref>; <ref loc="LUK 18:35-43">Lk 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46"/>Jerikho mlüha law u se, Jerikho üngka naw axüisaw he la khyang khawjah am ami ceh be üng, kthäheiki amikmü, Timea capa Batihme cun lam peia a na ngawki. <verse eid="MRK 10:46"/><verse number="47" style="v" sid="MRK 10:47"/>Nazaret Jesuh ni ti a ngjak la, “Jesuh! Davita Capa! na m'yeneia,” ti lü ngpyangki.<verse eid="MRK 10:47"/></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48"/>Khyang khawjah naw kse na u lü ä khihkheh khaia mtheh u se pi, “Davita Capa, na m'yeneia!” ti lü ngpyang law däm dämki.<verse eid="MRK 10:48"/></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49"/>Acunüng Jesuh naw ngdüi lü, <char style="wj">“Khü ua,”</char> ti se,</para>
  <para style="p" vid="MRK 10:49">khyang he naw amikmü khü u lü, “ä cäi lü, ngdüi lawa, ning khü ve,” ami ti.<verse eid="MRK 10:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50"/>Acunja amikmü cun a jih ngvaih tawnin lü, ngtawp lü, Jesuha veia lawki.<verse eid="MRK 10:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51"/>Jesuh naw, <char style="wj">“Na phäha ini ka ning pawh pet vai na ngjak hlü?” </char>ti se amikmü naw,</para>
  <para style="p" vid="MRK 10:51">“Saja aw, ka hmuh be vai ngaih veng,” a ti.<verse eid="MRK 10:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52"/>Acunüng Jesuh naw, <char style="wj">“Cita, na jumnak naw ning m’yai be ve,”</char> ti se.</para>
  <para style="p" vid="MRK 10:52">Acunja angxita hmu law be lü lama Jesuha hnu läki.<verse eid="MRK 10:52"/></para>
  <chapter eid="MRK 10"/>
  <chapter number="11" style="c" sid="MRK 11"/>
  <para style="s">Jesuh hlüngtainak am Jerusalem a luha mawng</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mt 21:1-11</ref>; <ref loc="LUK 19:28-40">Lk 19:28-40</ref>; <ref loc="JHN 12:12-19">Jn 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1"/>Jerusalem pha law hlü lü Betphake la Bethanih mlüh pei ami pha law üng Olip mcunga lawki he. Acunüng Jesuh naw axüisaw he üngka nghngih la na tüi lü, <verse eid="MRK 11:1"/><verse number="2" style="v" sid="MRK 11:2"/><char style="wj">“Nani maa ngnama va cit nia. Nani va pha la sanghngaksaü ngphungki, u naw pi am a ngcumnak ham nani hmu khai. Sut ni lü hia lawpüi nia.</char> <verse eid="MRK 11:2"/><verse number="3" style="v" sid="MRK 11:3"/><char style="wj">Khyang</char><note caller="+" style="f"><char style="fr" closed="false">11:3 </char><char style="fq" closed="false">Mkhang, </char><char style="ft" closed="false">am acunüng </char><char style="fq" closed="false">kamah. </char></note><char style="wj">naw, ‘Ivai acen nani pawhki ni?’ ami ti üng, ‘Bawi naw ngjahlü ve, asäng tha law be khai ni’ nani ti vai,”</char> a ti.<verse eid="MRK 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4"/>Acunüng cit ni lü sanghngaksaü cun lama pei mkawt üng ngphung se, hmu ni lü, ani suh. <verse eid="MRK 11:4"/><verse number="5" style="v" sid="MRK 11:5"/>Acunüng ngdüikia khyang avang naw, “Ise, acena sanghngaksaü nani sutki ni?” ami ti u.<verse eid="MRK 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6"/>Jesuh naw a jah mtheha kba jah mtheh ni se, acunüng ami jah cehsak. <verse eid="MRK 11:6"/><verse number="7" style="v" sid="MRK 11:7"/>Acuna sanghngaksaü cun Jesuha veia lawpüi ni se, a khana ami suisak mtaih u lü Jesuh ngawki. <verse eid="MRK 11:7"/><verse number="8" style="v" sid="MRK 11:8"/>Khyang he naw ami suisak he lama jah phah u se, avang naw thing hnah he jah ksawm u lü lama ami jah phah. <verse eid="MRK 11:8"/><verse number="9" style="v" sid="MRK 11:9"/><note caller="-" style="x"><char style="xo" closed="false">11:9: </char><char style="xt" closed="false"><ref loc="PSA 118:25">Sal 118:25</ref>,<ref loc="PSA 118:26">26</ref></char></note>A ma citki he la a hnua läkia khyang he naw, “Hosana! ‘Bawipa ngming üng lawki hin Pamhnam naw dawnak pe seh!’ <verse eid="MRK 11:9"/><verse number="10" style="v" sid="MRK 11:10"/>Pha law khaia khaw cun Davita uknaka kcün üngka kba josenaka am be se,” tia ngpyangki he.<verse eid="MRK 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11"/>Jesuh Jerusalema lawki, temple k’uma lut lü avan jah tengki. Khaw mü law hlükia kyase axüsaw xaleinghngih he am Bethanih mlüha citki he.<verse eid="MRK 11:11"/></para>
  <para style="s">Jesuh naw Fik Thing a Yünce</para>
  <para style="r">(<ref loc="MAT 21:18">Mt 21:18</ref>,<ref loc="MAT 21:19">19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12"/>Angawi, Bethanih üngka naw ami law be üng Jesuh a ei ngaih lawki. <verse eid="MRK 11:12"/><verse number="13" style="v" sid="MRK 11:13"/>Fik thing a hnah naw a bu athuknak üngka naw hmu lü akthei ve khai aw, ti lü teng khaia citki. Cunsepi a phung a pha üng a ngtheinaka kcüna am kyakia kyase a hnah däng a hmuh. <verse eid="MRK 11:13"/><verse number="14" style="v" sid="MRK 11:14"/>Jesuh naw fik dung üng, <char style="wj">“U naw pi na ktheih ä ei be ti se,”</char> ti se,</para>
  <para style="p" vid="MRK 11:14">axüisaw he naw ami ngjak.<verse eid="MRK 11:14"/></para>
  <para style="s">Jesuh Templea a Ceha Mawng</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mt 21:12-17</ref>; <ref loc="LUK 19:45-48">Lk 19:45-48</ref>; <ref loc="JHN 2:13-22">Jn 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15"/>Jerusalem ami pha law üng Jesuh temple üng lut lü, ngui mthawngki hea ngawhnak he la müme jah jawituki hea ngawhnak he a jah hukin. <verse eid="MRK 11:15"/><verse number="16" style="v" sid="MRK 11:16"/>Jesuh naw Temple jawihtuknaka kba ami summang vai am ti. <verse eid="MRK 11:16"/><verse number="17" style="v" sid="MRK 11:17"/><note caller="-" style="x"><char style="xo" closed="false">11:17:</char><char style="xt" closed="false"><ref loc="ISA 56:7">Hesa 56:7</ref>; </char><char style="xt" closed="false"><ref loc="JER 7:11">Jer 7:11</ref></char></note>Acunüng jah mthei lü, <char style="wj">“Cangcim üng Pamhnam naw, ‘Ka im cun khyangmjü avana ktaiyünaka im ti khai he, tia ng’yuki,’ Cunsepi nangmi naw m'yukei hea umnaka pawh ve uki,” </char>a ti.<verse eid="MRK 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18"/>Acun ktaiyü ktung he la thum jah mtheiki he naw ami ngjak üng Jesuh ami hnimnak vaia lam suiki he. Ani cun kyühki he isetiakhyaüng a ja mtheimthanga phäha khyang he ami cäileta phäh kyaki.<verse eid="MRK 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19"/>Khaw mü law se Jesuh la axüisaw he cun Jerusalem üngka naw akcea citeiki he.<verse eid="MRK 11:19"/></para>
  <para style="s">Fik Thing üngka naw Ngtheinak</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mt 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20"/>Angawi ngawilam, ami ceh lama fik thing a pya cäpa ng’yawngei se ami hmuh. <verse eid="MRK 11:20"/><verse number="21" style="v" sid="MRK 11:21"/>Pita naw süm law be lü, “Saja aw tenga, Fik thing na yünce cen ng’yawngei ve!” a ti.<verse eid="MRK 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22"/>Jesuh naw jah msang lü, <char style="wj">“Pamhnam jum ua. </char> <verse eid="MRK 11:22"/><verse number="23" style="v" sid="MRK 11:23"/><note caller="-" style="x"><char style="xo" closed="false">11:23: </char><char style="xt" closed="false"><ref loc="MAT 17:20">Mt 17:20</ref>; <ref loc="1CO 13:2">1Kor 13:2</ref></char></note><char style="wj">Akcanga ka ning jah mthehki, u naw pi a pyena kba kya khai tia jum lü hina khawmcung üng, ‘Ngnawn lü mliktui üng kyaa’ a ti üng, a tia kba kya khai. </char> <verse eid="MRK 11:23"/><verse number="24" style="v" sid="MRK 11:24"/><char style="wj">Acunakyase ka ning jah mthehki, ipi ktaiyünak am nami kthäh üng yah lü nami ka na khaia ksing ua, acunüng nami yah khai.</char> <verse eid="MRK 11:24"/><verse number="25" style="v" sid="MRK 11:25"/><note caller="-" style="x"><char style="xo" closed="false">11:25,26</char><char style="xt" closed="false"><ref loc="MAT 6:14">Mt 6:14</ref>,<ref loc="MAT 6:15">15</ref></char></note><char style="wj">Nami ktaiyü üng ua khana pi mlung am jenak nami tak üng mhlät ua. Acunüng nami Pa, khankhawa ka naw nangmia katnak pi ning jah mhlät khai”</char> a ti. <note caller="+" style="f"><char style="fr" closed="false">11:25-26 </char><char style="ft" closed="false">Cangcim khawjah naw hina 26 am yuk si u. 26 khyanga katnak am nami mhlät üng khankhawa awmkia nami pa naw nangmia katnak pi am ning jah mhlät khai ni” a ti. </char></note><verse eid="MRK 11:25"/></para>
  <para style="s">Jesuh naw ana a taka Mawng Ngthähnak</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mt 21:23-27</ref>; <ref loc="LUK 20:1-8">Lk 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27"/>Jerusalema law be tüki he. Jesuh temple k’uma a ceh üng, ktaiyü ktung he, thum jah mtheiki he la, axüngvai he a veia law u lü, <verse eid="MRK 11:27"/><verse number="28" style="v" sid="MRK 11:28"/>“Ia ana am hina ngkhaw he na jah pawhki ni? U naw hina ana a ning pet ni?” tia, ami kthäh.<verse eid="MRK 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29"/>Jesuh naw jah msang lü, <char style="wj">“Kei pi mat ka ning jah kthäh khai, nami na msang üng kei naw pi ia ana am hina ngkhaw he ka jah pawh ning jah mtheh kawng. </char> <verse eid="MRK 11:29"/><verse number="30" style="v" sid="MRK 11:30"/><char style="wj">Johana Baptican petnak hawia ka naw lawki? Mhnam üngka naw lawki aw, khyang üngka naw lawki aw? Na mtheh ua,” </char>a ti.<verse eid="MRK 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31"/>Amimät he ngthäh u lü, “I mi ti khai? Mhnam üngka mi ti üng mä, acunüng ise Johan am nami jumki ni? ti khai. <verse eid="MRK 11:31"/><verse number="32" style="v" sid="MRK 11:32"/>Khyang üngka mi ti üng mä, (Khyang avan naw Johan cun sahma mata ami ngaia kyase)” tia khyang he jah kyüh u lü, <verse eid="MRK 11:32"/><verse number="33" style="v" sid="MRK 11:33"/>“Am ksing ve ung,” ami ti.</para>
  <para style="p" vid="MRK 11:33">Jesuh naw jah msang lü, <char style="wj">“Kei naw pi ia ana am hina ngkhaw he ka jah pawh am ning jah mtheh hlü veng,” </char>a ti.<verse eid="MRK 11:33"/></para>
  <chapter eid="MRK 11"/>
  <chapter number="12" style="c" sid="MRK 12"/>
  <para style="s">Capyit ngvawng ngängki he am msuimcäpnak</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mt 21:33-46</ref>; <ref loc="LUK 20:9-19">Lk 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:1: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 5:1">Hesa 5:1</ref>,<ref loc="ISA 5:2">2</ref></char>
    </note>Acunüng Jesuh naw msuimcäpnak am ami veia ngthu pyen lü, <char style="wj">“Khyang mat naw capyit nglin lü, ngvawng lü, capyittui msawihnak vai khui co lü, ngängnak vaia im sa lü, lokbi he üng jah khah lü, a im ceh ta lü kdunglawngki.</char> <verse eid="MRK 12:1"/><verse number="2" style="v" sid="MRK 12:2"/><char style="wj">Capyit kbih kcün üng capyit ngvawng ngängki hea veia a m'ya mat capyitkthei a yah vai la khaia a tüih.</char> <verse eid="MRK 12:2"/><verse number="3" style="v" sid="MRK 12:3"/><char style="wj">Capyit ngängki he naw m'ya cun man u lü kpaiki he naw a jünga ami tüih be.</char> <verse eid="MRK 12:3"/><verse number="4" style="v" sid="MRK 12:4"/><char style="wj">Acunüng capyit ngvawng mah naw a m'ya akce ami veia a tüih be; acun pi a lu kpai u lü, am hmuhtheh phyakia pawh u lü, ami tüih be.</char> <verse eid="MRK 12:4"/><verse number="5" style="v" sid="MRK 12:5"/><char style="wj">Acunüng ngvawng mah naw akce ami veia tüih be tü se, ani cun hnim u lü, acunkba bäa akce he pi avang jah kpai u lü, avang ami jah hnim.</char> <verse eid="MRK 12:5"/><verse number="6" style="v" sid="MRK 12:6"/><char style="wj">A tüih vai mat däng awmki cun amäta jawngnak leng lenga a capa mat dänga kyaki. Anghnua a capa cun ngvawng kngängea veia a tüih. ‘Hina ka capa ta leisawng khai hea ngsingki ni’ </char> a ti. <verse eid="MRK 12:6"/><verse number="7" style="v" sid="MRK 12:7"/><char style="wj">Cunsepi capyit ngvawng ngängki he naw, ‘Hin hin ngvawng maha capa va ni kbak. Law ua, mi hnim u lü, a khawh mi ka na vai’ tia pyen u lü,</char> <verse eid="MRK 12:7"/><verse number="8" style="v" sid="MRK 12:8"/><char style="wj">acunkba manki he naw hnim u lü capyit ngvawng kpunga ami tawnin. </char><verse eid="MRK 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9"/>
    <char style="wj">Acunüng capyit ngvawng mah naw i ti law khai? Ngvawng mah law lü ngvawng ngängki he jah hnim lü capyit ngvawng cun akce he üng jah pe khai. </char><verse eid="MRK 12:9"/></para>
  <para style="q1">
    <verse number="10" style="v" sid="MRK 12:10"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:10,11: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 118:22">Sal 118:22</ref>,<ref loc="PSA 118:23">23</ref> </char>
    </note> <char style="wj">‘Sawngsaki he naw ami yawka lung cun ,</char></para>
  <para style="q2" vid="MRK 12:10">
    <char style="wj">avana kthaka kyäp law be säihki ni. </char><verse eid="MRK 12:10"/></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11"/>
    <char style="wj">Ahin cun Bawipa pawha kyaki;</char></para>
  <para style="q2" vid="MRK 12:11">
    <char style="wj">ihlawka mi ma kyühkse vaia kyaki ni’ ti hin cangcim üng am nami kheh khawiki aw?”</char> a ti.<verse eid="MRK 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12"/>Acunüng Judah mkhawng he naw amimi a jah pyennaka msuimcäpnak ni ti ksing u lü man khai hea ami bü. Cunsepi khyang he jah kyüh u lü yawk u lü ami cehtak.<verse eid="MRK 12:12"/></para>
  <para style="s">Ngcawn lawka Mawng Ngthähnak</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mt 22:15-22</ref>; <ref loc="LUK 20:20-26">Lk 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13"/>Pharise avang he la Heroda khyang üngka he ngthähnak am Jesuh man khai hea Jesuha veia ami jah tüih. <verse eid="MRK 12:13"/><verse number="14" style="v" sid="MRK 12:14"/>A veia law u lü, “Saja aw, nang cun u pi am na cäinaki, khyang naw hawkba a ning ngaih pi am cäi na lü, khyanga hmai am teng lü, nghnicima phäha Pamhnama ngthungtak ngjak hlü na jah mtheiki ti kami ksingki. Romah Sangpuxang üng ngcawn pet vai hin mi thum üng nglawiki aw? Pet vai aw am pet vai aw?” jah mtheha ami ti.<verse eid="MRK 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15"/>Jesuh naw ami hleihlaknak jah ksing lü, <char style="wj">“Ivaia nami na mhnüteiki he ni? Denarih ngui na pe law ua, teng vang,” </char>a ti.<verse eid="MRK 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16"/>Denarih ngui mat a veia lawpüi u se Jesuh naw, <char style="wj">“Hin hin ua müihmai la ua ngming ni?”</char> ti se amimi naw,</para>
  <para style="p" vid="MRK 12:16">“Empero” ami ti.<verse eid="MRK 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17"/>Acunüng Jesuh naw jah msang lü, <char style="wj">“Emperoa ka Empero üng pe u lü, Mhnama ka Mhnam üng pe ua,” </char>ti se,</para>
  <para style="p" vid="MRK 12:17">Ami van cäi lawki he.<verse eid="MRK 12:17"/></para>
  <para style="s">Thihnak üngka naw Thawh bea Mawng Ngthähnak</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mt 22:23-33</ref>; <ref loc="LUK 20:27-40">Lk 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:18: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">Ngs 23:8</ref>
      </char>
    </note>Acunüng Saduke he avang thihnak üngka naw thawhnak be am ve tikie Jesuha veia law u lü, <verse eid="MRK 12:18"/><verse number="19" style="v" sid="MRK 12:19"/><note caller="-" style="x"><char style="xo" closed="false">12:19: </char><char style="xt" closed="false"><ref loc="DEU 25:5">Deut 25:5</ref></char></note> “Saja aw, Mosi naw mi phäha thum a yuknak üng, ‘Khyang naw am ca lü a khyu a thih tak üng a na naw a ktaia cangsawn am düt khaia, acuna hmeinu cun a khäm be vai a ti.’ <verse eid="MRK 12:19"/><verse number="20" style="v" sid="MRK 12:20"/>Bena khyüh awmki he; axüngvai he säih khyumahki am ca mah lü thiki. <verse eid="MRK 12:20"/><verse number="21" style="v" sid="MRK 12:21"/>Acunüng anghngihnak naw nghnumi a khäm be ani pi am ca lü thiki. Akthumnak naw acunkba bäa khämki naw am ca lü a thihtak. <verse eid="MRK 12:21"/><verse number="22" style="v" sid="MRK 12:22"/>Acukba ami van naw ami khäm be; ami khyüh am ca u lü thiki he. Anghnua nghnumi pi thiki. <verse eid="MRK 12:22"/><verse number="23" style="v" sid="MRK 12:23"/>Thikie thawhnak bea mhmüp üng ami thawh law be üng nghnumi cun ua khyua kya khai ni, ami khyüh naw ami khyunaka kyaki,” ami ti.<verse eid="MRK 12:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24"/>Jesuh naw jah msang lü, <char style="wj">“Ihlawka nami hmaki he! Ise am nami ksing ni tia kyaküng, Mhnama johit la cangcim am nami ksinga phäha kyaki. </char> <verse eid="MRK 12:24"/><verse number="25" style="v" sid="MRK 12:25"/><char style="wj">Akthi he ami thawh law be üng khankhawngsä hea kba law khai he, ngkhyunglanak am ve be ti khai. </char> <verse eid="MRK 12:25"/><verse number="26" style="v" sid="MRK 12:26"/><note caller="-" style="x"><char style="xo" closed="false">12:26 </char><char style="xt" closed="false"><ref loc="EXO 3:6">Ex 3:6</ref></char></note> <char style="wj">Thihnak üngka naw thawh bea mawnglam: Pamhnam naw Mosi üng, ‘Kei Abrahama Mhnam, Isaka Mhnam, Jakopa Mhnama ka kyaki’ tia a mtheh cen, Mosia cauk üng kpyap meiha a däinaka manwg ng’yuki am nami khe khawiki he aw? </char> <verse eid="MRK 12:26"/><verse number="27" style="v" sid="MRK 12:27"/><char style="wj">Mhnam cun akthi hea Mhnama am kya, akxüng hea Mhnama kyaki. Aktäa am ngtäikia ngai kyu ve uki,” </char>a ti.<verse eid="MRK 12:27"/></para>
  <para style="s">Ngthupet Aktung</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mt 22:34-40</ref>; <ref loc="LUK 10:25-28">Lk 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:28-34 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:25-28">Lk 10:25-28</ref> </char>
    </note>Ami ngcuhnak ngjaki thum jah mtheiki mat awmki. Jesuh naw Saduke he akdawa jah msangki ti hmu lü ngthäh khaia a veia lawki naw, “Ia ngthupet ni aktung säih?” tia a kthäh law.<verse eid="MRK 12:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:29,30: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 6:4">Deut 6:4</ref>,<ref loc="DEU 6:5">5</ref></char>
    </note>Jesuh naw msang lü, <char style="wj">“Ngthupet he üngka aktung säih cun, ‘Aw Isarel ngaia! Bawipa mi Pamhnam mat däng ni mi Bawipa</char><note caller="+" style="f"><char style="fr" closed="false">12:29 </char><char style="fq" closed="false">Bawipa mi Pamhnam mat däng ni mi Bawipa, am acunüng Bawipa amät däng ni mi Pamhnam. </char></note> <char style="wj">akya ve.</char> <verse eid="MRK 12:29"/><verse number="30" style="v" sid="MRK 12:30"/><char style="wj">Bawipa na Pamhnam cun na mlungmthin, na xünnak, na ksingnak la na kyannak avan am na jawngnak vai’ tia kyaki. </char> <verse eid="MRK 12:30"/><verse number="31" style="v" sid="MRK 12:31"/><note caller="-" style="x"><char style="xo" closed="false">12:31: </char><char style="xt" closed="false"><ref loc="LEV 19:18">Lev 19:18</ref></char></note><char style="wj">Anghngihnak cun: ‘Na impeiloceng namät na jawngnaka kba na jawngnak vai’ tia kyaki. Ahina thea kyäp bawkia ngthupet akce i am ve ti,” </char>a ti.<verse eid="MRK 12:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">12:32 </char>
      <char style="xt" closed="false">
        <ref loc="DEU 4:35">Deut 4:35</ref>
      </char>
    </note>Acunüng thum jah mtheiki naw, “Saja aw, pyen thei veki! na kcang pyen veki, Bawipa däng ni Mhnama akya ve, Ania thea Mhnam akce am ve. <verse eid="MRK 12:32"/><verse number="33" style="v" sid="MRK 12:33"/><note caller="-" style="x"><char style="xo" closed="false">12:33 </char><char style="xt" closed="false"><ref loc="HOS 6:6">Hos 6:6</ref> </char></note>Nghngicim naw a mlungmthin, a ksingnak la a kyannak avan am Mhnam a jawngnak vaia kyaki; acunüng a impeiloceng, amät a jawngnaka kba a jawngnak vai. Xüngkseie la akce he am Mhnama veia ngkengnak pawha kthaka a mtheh ngjak hin daw bawki ni,” ti lü a pyen.<verse eid="MRK 12:33"/></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34"/>Thum jah mtheiki naw mcei ye lü msang beki ti Jesuh naw ksing lü, <char style="wj">“Nang naw Pamhnama khaw am thuk na veki,” </char>a ti.</para>
  <para style="p" vid="MRK 12:34">Acun käna u naw i pi am kthäh dat u.<verse eid="MRK 12:34"/></para>
  <para style="s">Mesijaha kyanak Ngthähnak</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mt 22:41-46</ref>; <ref loc="LUK 20:41-44">Lk 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35"/>Jesuh naw temple k’uma a jah mthei k’um üng jah kthäh lü, <char style="wj">“Mesijah cun Davita mjükphyüi ni tia thum jah mtheiki he naw ihawkba ami ti thei ni? </char> <verse eid="MRK 12:35"/><verse number="36" style="v" sid="MRK 12:36"/><note caller="-" style="x"><char style="xo" closed="false">12:36 </char><char style="xt" closed="false"><ref loc="PSA 110:1">Sal 110:1</ref></char></note> <char style="wj">Ngmüimkhya Ngcim naw pyensak se, Davit amät naw pi pyen lü: </char></para>
  <para style="q1" vid="MRK 12:36">
    <char style="wj">‘Bawipa naw ka Bawipa veia:</char></para>
  <para style="q2" vid="MRK 12:36">
    <char style="wj">Na ye he na khawkunga ka jah tak law vei däa,</char></para>
  <para style="q2" vid="MRK 12:36">
    <char style="wj">ka kpat da ngawa’ a ti ni?</char><verse eid="MRK 12:36"/></para>
  <para style="b"/>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37"/>
    <char style="wj">Davit amät ye naw, ‘Bawipa’; tia a khü hin ihawkba a mjükphyüia kya khai ni?” </char>a ti.</para>
  <para style="s" vid="MRK 12:37">Jesuh naw Thum jah Mtheiki he a jah Mkatei</para>
  <para style="r" vid="MRK 12:37">(<ref loc="MAT 23:1-36">Mt 23:1-36</ref>; <ref loc="LUK 20:45-47">Lk 20:45-47</ref>)</para>
  <para style="p" vid="MRK 12:37">Acunüng khyang khawjah naw jekyai u lü ami ngaih. <verse eid="MRK 12:37"/><verse number="38" style="v" sid="MRK 12:38"/>Acukba a jah mthei k’um üng Jesuh naw, <char style="wj">“Thum jah mtheiki he jah cäiei na ua, suisak akkyu suisa u lü ami ngtaw hü vai jawngnaki he, jawituknaka khyang hea jah mhlünmtai vai ngaihki he. </char> <verse eid="MRK 12:38"/><verse number="39" style="v" sid="MRK 12:39"/><char style="wj">Sinakoka ngawhnak akdaw säih ja buh pawhnaka hmün akdaw säih ngjahlüki he.</char> <verse eid="MRK 12:39"/><verse number="40" style="v" sid="MRK 12:40"/><char style="wj">Hmeinu hea khawhthem ei aw u lü, khyang hleihlaknak vaia aksoa ktaiyüki he. Ahin he naw mkhuimkhanak khamei däm khai he,” </char>a ti.<verse eid="MRK 12:40"/></para>
  <para style="s">Hmeinua Khawhpetnak</para>
  <para style="r">(<ref loc="LUK 21:1-4">Lk 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41"/>Jesuh cun khawhthem ami petnaka peia ngaw lü, khyang he naw ihawkba khawhthem pung k’uma ami ktawk jah tengki. Aktäa bawimangki he naw ngui khawjah ktawki he. <verse eid="MRK 12:41"/><verse number="42" style="v" sid="MRK 12:42"/>Acunüng hmeinu m'yenkse mat naw law lü, tangka ajawca nghngih a ktawk law. <verse eid="MRK 12:42"/><verse number="43" style="v" sid="MRK 12:43"/>Acunüng Jesuh naw axüisaw he atänga jah khü lü, <char style="wj">“Akcanga ka ning jah mthehki, hina hmeinu m'yenkse naw pung üng akdäm bawk pe ve. </char> <verse eid="MRK 12:43"/><verse number="44" style="v" sid="MRK 12:44"/><char style="wj">Peki he ami van naw ami taka ngui kpawih üngka va peki he; Cunsepi hina hmeinu naw a m'yenksenak üngka a xünnak vaia a takca avan pe ve,”</char> a ti.<verse eid="MRK 12:44"/></para>
  <chapter eid="MRK 12"/>
  <chapter number="13" style="c" sid="MRK 13"/>
  <para style="s">Temple a Pyehnak law vai Mawng a Pyennak</para>
  <para style="r">(<ref loc="MAT 24:1">Mt 24:1</ref>,<ref loc="MAT 24:2">2</ref>; <ref loc="LUK 21:5">Lk 21:5</ref>,<ref loc="LUK 21:6">6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1"/>Acunüng temple üngka naw a ceh be üng axüisaw he üngka mat naw, “Saja aw, tenga, lunge la ime cun pi khyäp ve u bä!” ti se,<verse eid="MRK 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2"/>Jesuh naw msang lü, <char style="wj">“Hina im he na jah hmuki aw? Lung matca pi ahin üng am ve tikia ami van pyeh bäih khai he,”</char> a ti.<verse eid="MRK 13:2"/></para>
  <para style="s">Khuikhanak la Khuimkhanak</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mt 24:3-14</ref>; <ref loc="LUK 21:7-19">Lk 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3"/>Jesuh Olip mcunga ngaw lü temple da mang se Pita, Jakuk, Johan la Andru a veia law u lü, <verse eid="MRK 13:3"/><verse number="4" style="v" sid="MRK 13:4"/>“Itia acukba kya law khai? Acuna ngkhaw hea pha law vai ia msingnak he ngdang law khai?” jah mtheha ti u lü ami kthäh.<verse eid="MRK 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5"/>Jesuh naw, <char style="wj">“U naw ä a ning jah mhleimhlak vaia mceiei ua.</char> <verse eid="MRK 13:5"/><verse number="6" style="v" sid="MRK 13:6"/><char style="wj">Khyang khawjah ka phäha ngthu pyenki hea ngsaih u lü, ‘Kei ania ka kyaki ni! ti u lü khyang khawjah jah mhleimhlak law khai he.</char> <verse eid="MRK 13:6"/><verse number="7" style="v" sid="MRK 13:7"/><char style="wj">Acunüng ngtuknak la ngtuknak vaia mawng ng’et lawki la so hünki tia ngthu nami ngjak üng ä nami kyüh vai; acun he cun ve law kung khai, cunsepi adütnak pha law pängki tinaka am kya.</char> <verse eid="MRK 13:7"/><verse number="8" style="v" sid="MRK 13:8"/><char style="wj">Pung la pung ngtu law khai he; khaw kce la khaw kce ngtu law khai he. Hmün naküta ngkhyü ngsün law lü, khawkjaw law lü, khuikhanak he awm law khai he. Acun he cun na hmi hlüki a huiei law kcüka mäiha khuikhanak hea tüneinaka kyaki. </char><verse eid="MRK 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:9-11: </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:17-20">Mt 10:17-20</ref>; <ref loc="LUK 12:11">Lk 12:11</ref>,<ref loc="LUK 12:12">12</ref></char>
    </note>
    <char style="wj">Acunüngpi ana cäiei na u; ning jah kpang u lü ngthu mkhyahnaka junga ning jah cehpüi khai he. Sinakok hea k’uma ning jah kpai khai he. Thangkdaw nami jah mtheh khaia, ngvai he la sangpuxang hea ma keia phäha nami ngdüi law khai. </char> <verse eid="MRK 13:9"/><verse number="10" style="v" sid="MRK 13:10"/><char style="wj">Cunsepi adütnak am pha law ham se, thangkdaw khyang avana veia sanga kya khai.</char> <verse eid="MRK 13:10"/><verse number="11" style="v" sid="MRK 13:11"/><char style="wj">Acunüng ning jah kpang u lü ngthu mkhyanak junga ami ning jah cehpüi üng, i nami pyen vai ä cäi na ua; Akcün a pha law üng ipi a ning jah pet nami pyen vai. Nami pyen vai cun nami mäta ngthua am kya lü Ngmüimkhya Ngcim üngka naw law khaia kyaki. </char> <verse eid="MRK 13:11"/><verse number="12" style="v" sid="MRK 13:12"/><char style="wj">Khyang he naw ami bena he thi khaia jah ap law khai he, ami pa naw pi acunkba bäa ami ca he thi khaia jah ap law khai he. Ami ca he naw ami nupa he jah hneng law u lü thi khaia jah ap law khai he.</char> <verse eid="MRK 13:12"/><verse number="13" style="v" sid="MRK 13:13"/><note caller="-" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">Mt 10:22</ref></char></note> <char style="wj">Keia phäha khyang he naw ning jah hneng law khai he. Acunsepi adütnak cäpa ling lü sitihki cun küikyana kya khai.</char><verse eid="MRK 13:13"/></para>
  <para style="s">Khuikhanak pha law khai</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mt 24:15-28</ref>; <ref loc="LUK 21:20-24">Lk 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:14 </char>
      <char style="xt" closed="false">
        <ref loc="DAN 9:27">Dan 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char>
    </note> <char style="wj">“Acunakyase, ‘pyükpyeh thei lü, mtüihkhehki’ am a ngdüihnak vai üng ngdüi se, nami hmu üng, (khehki avan naw asuilam ksing kawm) Judah khawa awmki he mcunga dawng u se;</char> <verse eid="MRK 13:14"/><verse number="15" style="v" sid="MRK 13:15"/><note caller="-" style="x"><char style="xo" closed="false">13:15,16</char><char style="xt" closed="false"><ref loc="LUK 17:31">Lk 17:31</ref> </char></note><char style="wj">mkyum khana awmki im k’uma iyaw lo khaia ä kyum law be se, akcün bäih khai ni.</char> <verse eid="MRK 13:15"/><verse number="16" style="v" sid="MRK 13:16"/><char style="wj">Loa awmki naw a jih loei khaia ima ä nghlat be se.</char> <verse eid="MRK 13:16"/><verse number="17" style="v" sid="MRK 13:17"/><char style="wj">Acuna mhmüp cun pawieiki he la cihtui awkia hnasen kpawmeikia nu hea phäha aktäa khuikhanaka kya khai.</char> <verse eid="MRK 13:17"/><verse number="18" style="v" sid="MRK 13:18"/><char style="wj">Nami dawngnak khawksik khyaa ä akyanak vaia Mhnama veia ktaiyü ua.</char> <verse eid="MRK 13:18"/><verse number="19" style="v" sid="MRK 13:19"/><note caller="-" style="x"><char style="xo" closed="false">13:19 </char><char style="xt" closed="false"><ref loc="DAN 12:1">Dan 12:1</ref>; <ref loc="REV 7:14">Malam 7:14</ref></char></note><char style="wj">Acuna mhmüp cun mkhuimkhanaka mhmüpa kya khai, acuna kba khuikhanak cun Pamhnama pyang khawmdeka ngtüi üng tün lü, atuh cäpa am ve khawi, i tia pi am ve be ti.</char> <verse eid="MRK 13:19"/><verse number="20" style="v" sid="MRK 13:20"/><char style="wj">Bawipa naw acuna mhmüp he am a tawisak vai sü üng ua ca pi am xüng khai sü, cunsepi a jah xü hea phäha acuna mhmüp he cun a jah tawisaka kyaki. </char><verse eid="MRK 13:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21"/>
    <char style="wj">Acunüng khyang naw, “Tenga, hia Mesijah ve ve, ‘Tenga caia ve ve’ ami ti üng, acun ä nami kcangnak vai.</char> <verse eid="MRK 13:21"/><verse number="22" style="v" sid="MRK 13:22"/><char style="wj">Isetiakyaüng, Mesijah kcang he am niki he la sahma kcanga am niki he awm law khai he. Akya thei vai süta Pamhnama xü he pi ami jah mhleihlaknak vaia müncankse he la cäicatnak he jah pawh law khai he.</char> <verse eid="MRK 13:22"/><verse number="23" style="v" sid="MRK 13:23"/><char style="wj">Cunsepi cäiei na u, akcün am a pha law ham üng avan ka ning jah na mthehki ni. </char><verse eid="MRK 13:23"/></para>
  <para style="s">Khyanga Capaa lawnak be vaia Mawng</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mt 24:29-31</ref>; <ref loc="LUK 21:25-28">Lk 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:24 </char>
      <char style="xt" closed="false">
        <ref loc="ISA 13:10">Hesa 13:10</ref>; <ref loc="EZK 32:7">Hez 32:7</ref>; <ref loc="JOL 2:10">Jol 2:10</ref>,<ref loc="JOL 2:31">31</ref>; <ref loc="JOL 3:15">3:15</ref>; <ref loc="REV 6:12">Malam 6:12</ref></char>
    </note> <char style="wj">Acuna khuikhanaka mhmüp he käna, khawnghngi nghmüp law lü, khya pi am vai law ti.</char> <verse eid="MRK 13:24"/><verse number="25" style="v" sid="MRK 13:25"/><note caller="-" style="x"><char style="xo" closed="false">13:25:</char><char style="xt" closed="false"><ref loc="ISA 34:4">Hesa 34:4</ref>; <ref loc="REV 6:13">Malam 6:13</ref>; </char><char style="xt" closed="false"><ref loc="JOL 2:10">Jol 2:10</ref></char></note><char style="wj">Khankhaw üngka naw aisi he kya law khai he, khana johite ngsün law khai he.</char> <verse eid="MRK 13:25"/><verse number="26" style="v" sid="MRK 13:26"/><note caller="-" style="x"><char style="xo" closed="false">13:26: </char><char style="xt" closed="false"><ref loc="DAN 7:13">Dan 7:13</ref>; <ref loc="REV 1:7">Malam 1:7</ref></char></note><char style="wj">Acunüng Khyanga Capa hlüngtainak la johit am khawngmei üng law lü ngdang law khai.</char> <verse eid="MRK 13:26"/><verse number="27" style="v" sid="MRK 13:27"/><char style="wj">A khankhawngsä he jah tüi lü, khawmdeka cum, sip, nghngilaw, khawkyak avan üng Pamhnama xü he atänga jah mkhäm law khai. </char><verse eid="MRK 13:27"/></para>
  <para style="s">Fik thing üngka naw Ngtheingthangnak</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mt 24:32-35</ref>; <ref loc="LUK 21:29-33">Lk 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28"/>
    <char style="wj">“Fik thing üng ngtheingthang ua. A ngban he mkim law u lü a hlip law üng, khaw khye law hlüki ti nami ksingki.</char> <verse eid="MRK 13:28"/><verse number="29" style="v" sid="MRK 13:29"/><char style="wj">Acuna kba ahin hea kya law u se, akcün ng’et law lü tün law hlüki</char><note caller="+" style="f"><char style="fr" closed="false">13:29 </char><char style="fq" closed="false">akcün ng’et law lü tün law hlüki; am acunüng a lawnak vai ng’et lawki. </char></note><char style="wj">ti nami ksing khai he.</char> <verse eid="MRK 13:29"/><verse number="30" style="v" sid="MRK 13:30"/><char style="wj">Atuha khyang he am thi ham u se, ahin he thawn law khai he ti süm ua.</char> <verse eid="MRK 13:30"/><verse number="31" style="v" sid="MRK 13:31"/><char style="wj">Khawmdek la khankhaw khyük ni se pi ka ngthu itia pi am khyük. </char><verse eid="MRK 13:31"/></para>
  <para style="s">Akcün la Khawmhmüp u naw am Ksing</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mt 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:32</char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:36">Mt 24:36</ref>
      </char>
    </note> <char style="wj">Acuna khawmhmüp la akcün cun Pa dänga thea, u naw am ksing; khana khankhawngsä he la a Capa naw pi am ksing u.</char> <verse eid="MRK 13:32"/><verse number="33" style="v" sid="MRK 13:33"/><char style="wj">Akcüna pha law vai am nami ksingkia kyase, ana mceiei ua.</char> <verse eid="MRK 13:33"/><verse number="34" style="v" sid="MRK 13:34"/><note caller="-" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">Lk 12:36-38</ref></char></note><char style="wj">Hin cun khyang mat athuknak punga citki, a im yawk hüt lü a m'ya he üng ami ham phäh phäh khüih vai jah pe hütki naw mkawt ngängki üng a teng vaia a mtheh hüta kba kyaki.</char> <verse eid="MRK 13:34"/><verse number="35" style="v" sid="MRK 13:35"/><char style="wj">Imah a lawnak be vai cun mü lam aw? Mthan nglunga aw? Khawthaih hlan aw? Nghngi luh law aw? ti am nami ksingkia kyase angläta ana ngängei ua.</char> <verse eid="MRK 13:35"/><verse number="36" style="v" sid="MRK 13:36"/><char style="wj">Am nami äpa kcün üng a law be üng nami ih ä ning jah hmu se.</char> <verse eid="MRK 13:36"/><verse number="37" style="v" sid="MRK 13:37"/><char style="wj">Nangmi üng ka ning jah mtheh cun khyang avan üng pi ka mtheh ni. Ana ngcüngcei ua!”</char> a ti.<verse eid="MRK 13:37"/></para>
  <chapter eid="MRK 13"/>
  <chapter number="14" style="c" sid="MRK 14"/>
  <para style="s">Jesuh ami Ceng</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mt 26:1-5</ref>; <ref loc="LUK 22:1">Lk 22:1</ref>,<ref loc="LUK 22:2">2</ref>; <ref loc="JHN 11:45-53">Jn 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:1-27">Ex 12:1-27</ref>
      </char>
    </note>Atuh hin lätnak pawi la nghngen am bawikia buhpawhnak pawi a pha vai amhmüp nghngihnak ni. Ktaiyü ktung he la thum jah mtheiki he naw, Jesuh man u lü ampyua ami mkhyühnak vaia lam suiki he. <verse eid="MRK 14:1"/><verse number="2" style="v" sid="MRK 14:2"/>Cunsepi, “Pawi k’um üng ta am kya kawm, khyang he suksak khai he ni,” ami ti.<verse eid="MRK 14:2"/></para>
  <para style="s">Bethanih Ngnama Jesuh si am Hluk</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mt 26:6-13</ref>; <ref loc="JHN 12:1-8">Jn 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">14:3 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:37">Lk 7:37</ref>,<ref loc="LUK 7:38">38</ref></char>
    </note>Jesuh Bethanih ngnam mnehkse mnehki Sihmona ima awmki. Buh a ei k’um üng nghuminu mat naw aphu küi alabasta sing’ui cun aphu küikia um üng abea lawpüi lü, um seih ak lü Jesuha lu khana a buih law. <verse eid="MRK 14:3"/><verse number="4" style="v" sid="MRK 14:4"/>Acunüng awmki he avang naw am kyäpsak u lü, “Ivai hina sing’ui päihcaihsaki ni? <verse eid="MRK 14:4"/><verse number="5" style="v" sid="MRK 14:5"/>Ahin hin ngui phya kthuma (kum mat hlawheia däm bawki phu naki) jawi lü m'yenkse he üng jah pet vai sü,” tia nghnumi ami pyenei.<verse eid="MRK 14:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6"/>Cunsepi Jesuh naw, <char style="wj">“Amäta ngaiha ti se. I vaia am nami pyenksaeiki ni? Hin naw ka phäha akdaw pawh ye se.</char> <verse eid="MRK 14:6"/><verse number="7" style="v" sid="MRK 14:7"/><note caller="-" style="x"><char style="xo" closed="false">14:7</char><char style="xt" closed="false"><ref loc="DEU 15:11">Deut 15:11</ref> </char></note><char style="wj">M'yenkseki he cun anglät se nami hlawnga ve hlü ye u se, anglätse nami ngaiha kcün üng nami jah kpüi theiki. Cunsepi kei cun anglätse nami hlawnga am ve hlü nawng.</char> <verse eid="MRK 14:7"/><verse number="8" style="v" sid="MRK 14:8"/><char style="wj">Hina nghnumi naw a khyaihca pawh ve; ka pumsa k’ut vaia kcün am a pha ham üng, ka ng’utnak vai pyang ve.</char> <verse eid="MRK 14:8"/><verse number="9" style="v" sid="MRK 14:9"/><char style="wj">Akcanga ka ning jah mthehki, khawmdek khan naküta thangkdaw sang hünak naküt üng hina nghnumia a bilawh pi ani sümnak vaia pyen sih khai he ni,”</char> a ti.<verse eid="MRK 14:9"/></para>
  <para style="s">Judah naw Jesuh Kpan vaia a jah Cengpüi</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mt 26:14-16</ref>; <ref loc="LUK 22:3-6">Lk 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10"/>Acunüng Judah Iskarot, xaleinghngih he üngka mat cun Jesuh ceng khaia ktaiyü ktung hea veia citki. <verse eid="MRK 14:10"/><verse number="11" style="v" sid="MRK 14:11"/>A pyen ami ngjak üng aktäa je na u lü, ngui ami pet vaia ami khyütamnak. Acunüng, Judah naw a jah kpanaksak vaia kcün suiki.<verse eid="MRK 14:11"/></para>
  <para style="s">Axüisaw he am Lätnak Pawi Buh Eiki he</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mt 26:17-25</ref>; <ref loc="LUK 22:7-14">Lk 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">Jn 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12"/>Nghngen am bawikia buhpawhnaka mhmüp kcük, lätnak toca he ami jah hnimnak khawia mhmüp üng, axüisaw he naw, “Lätnak pawi buh na einak vaia hawia ni kami va pyan vai na hlüei?” tia ami kthäh.<verse eid="MRK 14:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13"/>Acunüng Jesuh naw axüisaw xawi nghngih jah tüi lü, <char style="wj">“Mlüh k’uma va cit ni lü kpami mat k’am üng tui kawtki naw ning jah na khyum khai. Acun nani läk vai.</char> <verse eid="MRK 14:13"/><verse number="14" style="v" sid="MRK 14:14"/><char style="wj">A luhnaka im üng lut ni lü, ‘Saja naw, ka xüisaw he am lätnak pawi buh kami einak hmaih vai im hawia ni?’ ti ve nani ti vai.</char> <verse eid="MRK 14:14"/><verse number="15" style="v" sid="MRK 14:15"/><char style="wj">Acunüng ani naw im khan angsawngnu, mi phäha avan küm khaia ami pyan päng ning jah mhmuh khai, acuia ei vai nami pyang vai”</char> a ti.<verse eid="MRK 14:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16"/>Axüisaw xawi cit ni lü mlüh k’uma cit ni se, a jah mtheha kba va hmu ni lü, lätnak pawi buh ani va pyang.<verse eid="MRK 14:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17"/>Khaw a mü law üng Jesuh axüisaw he xaleinghngih am lawki he. <verse eid="MRK 14:17"/><verse number="18" style="v" sid="MRK 14:18"/><note caller="-" style="x"><char style="xo" closed="false">14:18: </char><char style="xt" closed="false"><ref loc="PSA 41:9">Sal 41:9</ref></char></note>Ngaw u lü ami ei k’um üng Jesuh naw, <char style="wj">“Akcanga ka ning jah mthehki, nangmi üngka mat, kani ei hmaihki naw na ceng khai,” </char>a ti.<verse eid="MRK 14:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19"/>Axüisaw he thüisei law u lü, “Acun mä kei na na pyenak aw, am ni aw? tia kthäh law tüi tüiki he.<verse eid="MRK 14:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20"/>Jesuh naw jah msang lü, <char style="wj">“Xaleinghngih üngka mat, kbe üng na kpuiheipüi hmaihkia kyaki ni.</char> <verse eid="MRK 14:20"/><verse number="21" style="v" sid="MRK 14:21"/><char style="wj">Khyanga Capa cun amawng cangcim üng ana ng’yuka kba thih khai; cunsepi Khyanga Capa cengki hin a jo se ve! Acuna khyang hin am a hmi law a phäha daw bawk khai sü,” </char>a ti.<verse eid="MRK 14:21"/></para>
  <para style="s">Bawipa Müei</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mt 26:26-30</ref>; <ref loc="LUK 22:14-20">Lk 22:14-20</ref>; <ref loc="1CO 11:23-25">1Kor 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22"/>Ami ei k’um üng Jesuh naw muk lo lü, jekyainaka ngthu am ktaiyü lü, boki naw jah pe lü, <char style="wj">“Ei ua, hin cun ka pumsa ni,” </char>a ti.<verse eid="MRK 14:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23"/>Acunüng capyittui khawt lo lü, jekyainak Mhnam üng mtheh lü, jah pe se; ami van naw awki he. <verse eid="MRK 14:23"/><verse number="24" style="v" sid="MRK 14:24"/><note caller="-" style="x"><char style="xo" closed="false">14:24: </char><char style="xt" closed="false"><ref loc="EXO 24:8">Ex 24:8</ref>; </char><char style="xt" closed="false"><ref loc="JER 31:31-34">Jer 31:31-34</ref></char></note>Jesuh naw, <char style="wj">“Hin hin ka thisen khyang khawjaha phäha ngsawiki, Pamhnama ngthumkhän</char><note caller="+" style="f"><char style="fr" closed="false">14:24 </char><char style="ft" closed="false">Cangcim avang üng ‘ngthumkhän kthai’ ti ami yuk si.</char></note><char style="wj">msingnaka kyaki.</char> <verse eid="MRK 14:24"/><verse number="25" style="v" sid="MRK 14:25"/><char style="wj">Akcanga ka ning jah mthehki, Pamhnama khawa capyittui akthai ka awknaka mhmüp am a pha law hama küt üng, hina capyittui am ka aw be ti khai,” </char>a ti.<verse eid="MRK 14:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26"/>Acunüng ng’äi mcuk u lü, Olip mcung da citki he.<verse eid="MRK 14:26"/></para>
  <para style="s">Pita naw a Manak vai Jesuh naw a Pyen</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mt 26:31-35</ref>; <ref loc="LUK 22:31-34">Lk 22:31-34</ref>; <ref loc="JHN 13:36-38">Jn 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">14:27: </char>
      <char style="xt" closed="false">
        <ref loc="ZEC 13:7">Zakh 13:7</ref>
      </char>
    </note>Jesuh naw jah mtheh lü, <char style="wj">‘Pamhnam naw toksäm hnim se, to he ngpyeng hü khai he’ tia cangcim üng a awma kba, “Na yawk u lü nami van naw nami na cen ta khai.</char> <verse eid="MRK 14:27"/><verse number="28" style="v" sid="MRK 14:28"/><note caller="-" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">Mt 28:16</ref></char></note><char style="wj">Cunsepi ka thawh be käna Kalile khawa nami ma ka na cit khai,”</char> a ti.<verse eid="MRK 14:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29"/>Pita naw msang lü, “Ami van naw ning dawng ta u se pi, kei naw ta am ka ning dawng ta süm süm khai,” a ti.<verse eid="MRK 14:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30"/>Jesuh naw, <char style="wj">“Akcanga ka ning mthehki, tuhmü mthan, ai nghngih vei am khawng ham se kthum vei na ngcim khai,”</char> a ti.<verse eid="MRK 14:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31"/>Pita naw, “Na hlawnga ka thih hnga vai üng pi, am ka ngcim khai,” a ti.</para>
  <para style="p" vid="MRK 14:31">Acukba ami van naw ami ti hnga.<verse eid="MRK 14:31"/></para>
  <para style="s">Ketaseman Ngvawng k'uma Jesuh Ktaiyüki</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mt 26:36-46</ref>; <ref loc="LUK 22:39-46">Lk 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32"/>Ketaseman ami tia hmüna lawki he Jesuh naw, <char style="wj">“Hin üng a na ngaw u, va ktaiyü vang,” </char>ti lü axüisaw he a jah mtheh. <verse eid="MRK 14:32"/><verse number="33" style="v" sid="MRK 14:33"/>Acunüng Pita, Jakuk la Johan jah ngkhahpüi lü, aktäa a mlung na se khüikhaki. <verse eid="MRK 14:33"/><verse number="34" style="v" sid="MRK 14:34"/>Acunüng Jesuh naw, <char style="wj">“Ka mlungmthina khuikhanak cun aktä leng lenga na lü na mthih khaia kya ve. Hin üng awm u lü ana mdei ua,”</char> a ti.<verse eid="MRK 14:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35"/>Ajawha va cit lü, mdeka ngbawk lü, akya thei vai sü ta acuna khuikhanak am a khamei vaia ktaiyü lü, <verse eid="MRK 14:35"/><verse number="36" style="v" sid="MRK 14:36"/><char style="wj">“Ka Pa aw, ka pa aw! Nang üng avan kya theiki ni. Hina khuikhanaka khawt hin ka khan üngka naw loa. Cunsepi keia ngjakhlüa am ni na ngjakhlüa kyase,” </char>ti lü ktaiyüki.<verse eid="MRK 14:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37"/>Acunüng a nghlat law be üng axüisaw he kthum ip u se jah hmu lü Pita üng, <char style="wj">“Sihmon, na ipeiki aw? Naji matca pi am na mdei theiki aw?</char> <verse eid="MRK 14:37"/><verse number="38" style="v" sid="MRK 14:38"/><char style="wj">Hlawhlepnak üng am nami kyukngtängnak vaia, ngäng u lü ktaiyü ua. Ngmüimkhya ta yäng teki pumsa naw am läih ve,”</char> a ti.<verse eid="MRK 14:38"/></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39"/>Jesuh va cit be lü, a pyena kba pyen lü va ktaiyü beki. <verse eid="MRK 14:39"/><verse number="40" style="v" sid="MRK 14:40"/>Acunüng axüisaw hea veia a law be üng ami ihmik am caikia kpi ana ipei be u lü, ihawkba ami msang vaia pi am ksing u lü awmki he.<verse eid="MRK 14:40"/></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41"/>Akthumnaka a law be üng, <char style="wj">“Atuh vei cäpa ip u lü nami xüieiki aw? Khäk ve! akcün pi pha law päng ve! teng u, Khyanga Capa cun khyangka hea kut üng mansak vaia kya ve.</char> <verse eid="MRK 14:41"/><verse number="42" style="v" sid="MRK 14:42"/><char style="wj">Tho law ua mi cit vai. Teng u, na cengki pha law päng ve,”</char> a ti.<verse eid="MRK 14:42"/></para>
  <para style="s">Jesuh ami Kpanak</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mt 26:47-56</ref>; <ref loc="LUK 22:47-53">Lk 22:47-53</ref>; <ref loc="JHN 18:3-12">Jn 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43"/>Acukba ana ngthuhei k’um üng xaleinghngih üngka mat Judah pha lawki. Ani mah maha likcim la kpaihmäng kpawmkia khyang khawjah; ktaiyü ktung he, thum jah mtheiki he la axüngvai hea ami jah tüi law pha lawki he. <verse eid="MRK 14:43"/><verse number="44" style="v" sid="MRK 14:44"/>Jesuh cengki naw khyang he üng msingnak a jah pet: “Ka mhnama khyang cun nami ngaiha khyanga kyaki. Acun kpang u lü, mcei u lü nami cehpüi vai,” a ti.<verse eid="MRK 14:44"/></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45"/>Judah naw a pha law ja Jesuha veia cit lü, “Saja aw!” ti lü a mhnam. <verse eid="MRK 14:45"/><verse number="46" style="v" sid="MRK 14:46"/>Acunüng Jesuh akceta ami kpan. <verse eid="MRK 14:46"/><verse number="47" style="v" sid="MRK 14:47"/>Acunüng ngdüiki üngka mat naw a kcim kphawngei lü ktaiyü ktunga m'yaa nghngakawi a ksawmpat. <verse eid="MRK 14:47"/><verse number="48" style="v" sid="MRK 14:48"/>Acunüng Jesuh naw jah msang lü, <char style="wj">“Khyang kse man khai hea kba likcim he la kpaihmänge jah kpawmei u lü nami lawki he aw?</char> <verse eid="MRK 14:48"/><verse number="49" style="v" sid="MRK 14:49"/><note caller="-" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">Lk 19:47</ref>; <ref loc="LUK 21:37">21:37</ref> </char></note><char style="wj">Amhmüp tä temple k’um üng ning jah mthei lü nami veia ve ni se, am nami na manki. Cunsepi cangcima kümkawinak vaia kya ve,” </char>a ti.<verse eid="MRK 14:49"/></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50"/>Acunüng axüisaw he ami van naw yawk u lü ami dawngtak.<verse eid="MRK 14:50"/></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51"/>Cawngpyang mat jihca däng sui lü Jesuh ana läk hü hngaki man hlü u se,<verse eid="MRK 14:51"/></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 14:52"/>a jihca pi yawk hüt lü akawnga dawngki.<verse eid="MRK 14:52"/></para>
  <para style="s">Jesuh Kawngci hea Ma ami Cehpüi</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mt 26:57-68</ref>; <ref loc="LUK 22:54">Lk 22:54</ref>,<ref loc="LUK 22:55">55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13">Jn 18:13</ref>,<ref loc="JHN 18:14">14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53"/>Acunüng Jesuh ktaiyü ngvai säiha ima ami cehpüi. Acuia ktaiyü ktung he, axüngvai he la thum jah mtheiki he ami van ngcunki he. <verse eid="MRK 14:53"/><verse number="54" style="v" sid="MRK 14:54"/>Pita athuknakca üngka naw ktaiyü ngvai säiha im ngvawng mkawt cäpa Jesuh läk hngaki. Acuia xungki hea hlawnga ngaw lü mei awmei hngaki. <verse eid="MRK 14:54"/><verse number="55" style="v" sid="MRK 14:55"/>Ktaiyü ktung he la kawngci he naw Jesuh ami mkhyühnak vaia ami kpuknak vai suiki he, cunsepi i pi am hmu u. <verse eid="MRK 14:55"/><verse number="56" style="v" sid="MRK 14:56"/>Khyang khawjah naw hleihlaknak am ami kpuk law, cunsepi ami pyenksak he naw am jah cangsak.<verse eid="MRK 14:56"/></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57"/>Acunüng avang he ngdüi law u lü ami hleihlaknak am, <verse eid="MRK 14:57"/><verse number="58" style="v" sid="MRK 14:58"/><note caller="-" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">Jn 2:19</ref></char></note>“Hin naw, ‘khyanga saka temple kpyeh lü, amhmüp kthum üng khyanga am saka temple ka sa be khai,’ ti se kami ngjaki ni,” ami ti. <verse eid="MRK 14:58"/><verse number="59" style="v" sid="MRK 14:59"/>Ami hleihlak ami pyen naw pi amimät am jah kcang na.<verse eid="MRK 14:59"/></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60"/>Ktaiyü ktung säih cun ami maa ngdüi law lü Jesuh üng, “Na katnak ami ning kpuknak he hin i am pi am na jah msangki aw?” a ti.<verse eid="MRK 14:60"/></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61"/>Cunsepi Jesuh am khihkheh lü i pi am pyen. Acunüng ktaiyü ktung säih naw, “Nang Mesijah, Mhnama Capaa na kyaki aw?” a ti.<verse eid="MRK 14:61"/></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">14:62 </char>
      <char style="xt" closed="false">
        <ref loc="DAN 7:13">Dan 7:13</ref>
      </char>
    </note>Jesuh naw, <char style="wj">“Ä, khyanga Capa hlüngtaiki Mhnama kpat da ngaw lü, khankhawa khawngmei üng law se nami van naw nami hmu law khai,</char>” a ti.<verse eid="MRK 14:62"/></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63"/>Ktaiyü ktung säih naw a suisak he jah ktek lü, “Ia saksi am hlü be ve! <verse eid="MRK 14:63"/><verse number="64" style="v" sid="MRK 14:64"/><note caller="-" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:16">Lev 24:16</ref></char></note>Pamhnam a pyenksenak nami ngjak, ihawkba ni nami ngaih?” ti se.</para>
  <para style="p" vid="MRK 14:64">Ami van naw thi khaia ngkawih ve ami ti.<verse eid="MRK 14:64"/></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65"/>Avang naw ami mci am msawh u lü, avang naw a mik hlawp u lü pung u lü, “U naw ning pungki ni?” ami ti. Ngängki he naw ami kut am ami kbeih.<verse eid="MRK 14:65"/></para>
  <para style="s">Pita naw Jesuh a Manak</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mt 26:69-75</ref>; <ref loc="LUK 22:56-62">Lk 22:56-62</ref>; <ref loc="JHN 18:15-18">Jn 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66"/>Pita cun ktaiyü ngvai säiha m'ya, nghnumica mata peia a law üng, im ngvawnga k’keh lama ana awm hünki. <verse eid="MRK 14:66"/><verse number="67" style="v" sid="MRK 14:67"/>Pita mei ana awmei se hmu üng tengki naw, “Nang pi Nazaret Jesuh am nani awm hü hmaih khawiki va ni mäih ja,” ti se,<verse eid="MRK 14:67"/></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68"/>Pita naw, “Am ksing nawng, na pyena mawng am ksing thei veng,” tia ngcim lü kawma lama va cit se ai khawngki.<verse eid="MRK 14:68"/></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69"/>Acuia nghnumica naw hmu be tü lü, acunüng ngdüiki hea veia, “Hin hin acun he üngka mat ni,” ti se, <verse eid="MRK 14:69"/><verse number="70" style="v" sid="MRK 14:70"/>Pita ngcim be tüki.</para>
  <para style="p" vid="MRK 14:70">Acun käna pi acunüng ngdüiki he naw, “Acun he üngka na kya am ngcim theiki. Isetiakyaküng nang pi Kalile khyang ni,” ami ti.<verse eid="MRK 14:70"/></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71"/>Acunüng Pita naw, “Akcang ka pyenki ni! Akcang am ka pyen üng ta Mhnam naw na ju khmu law kawm tia ng'yün veng! Nami pyena khyang kei am ksing veng,” a ti.<verse eid="MRK 14:71"/></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72"/>Acun la anghngihnaka ai khawngki. Acunüng Pitaa veia Jesuh naw, <char style="wj">“Ai nghngih vei am a khawng ham üng nang naw am ksing nawng ti lü kthum vei na ngcim khai,”</char> a ti cun süm law be lü aktäa kyapki.<verse eid="MRK 14:72"/></para>
  <chapter eid="MRK 14"/>
  <chapter number="15" style="c" sid="MRK 15"/>
  <para style="s">Pilata veia Jesuh ami Lawpüi</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mt 27:1-2</ref>,<ref loc="MAT 27:11-14">11-14</ref>; <ref loc="LUK 23:1-5">Lk 23:1-5</ref>; <ref loc="JHN 18:28-38">Jn 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1"/>Khaw a thaih law la ktaiyü ktung he naw axüngvai he, thum jah mtheiki he la kawngci bawi he jah nghmuhpüi u lü, Jesuh cun khitkie naw cehpüi u lü, Pilat üng ami msum. <verse eid="MRK 15:1"/><verse number="2" style="v" sid="MRK 15:2"/>Pilat naw, “Nang Judah hea Sangpuxanga na kyaki aw?” ti lü kthäh se,</para>
  <para style="p" vid="MRK 15:2">Jesuh naw msang lü, <char style="wj">“Na pyena kba kya ve”</char> a ti.<verse eid="MRK 15:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3"/>Ktaiyü ktung he naw aktäa mkatei law u se, <verse eid="MRK 15:3"/><verse number="4" style="v" sid="MRK 15:4"/>Pilat naw kthäh be lü, “Am na jah msang hlü beki aw? Ami ning mkatnak he jah ngaia,” a ti.<verse eid="MRK 15:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5"/>Acunüng pi Jesuh naw am msang be tü se Pilat cäi lawki.<verse eid="MRK 15:5"/></para>
  <para style="s">Jesuh Thi khaia ami Mkhyäp</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mt 27:15-26</ref>; <ref loc="LUK 23:13-25">Lk 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Jn 18:39—19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6"/>Lätnak pawi buh pawh mhmüp üng Pilat naw thawngim üngka khyang mat mat, u pi khyang hea kthäh a mhlät khawia thum awmki. <verse eid="MRK 15:6"/><verse number="7" style="v" sid="MRK 15:7"/>Acuna mhmüp üng khyang khnim mat Barabah ami tia la Romah he a uknak kpetmjaki he am atänga jah man hmaih u lü thawngim üng ami khyum awmki. <verse eid="MRK 15:7"/><verse number="8" style="v" sid="MRK 15:8"/>Khyang he naw ngcun law u lü a jah pawh pet khawia kba dawnak a jah pawh pet vaia ami mso law. <verse eid="MRK 15:8"/><verse number="9" style="v" sid="MRK 15:9"/>Acunüng Pilat naw jah kthäh lü, “Hina Judah hea Sangpuxang ka ning jah mhlät pet vai nami ngaihki he aw?” a ti. <verse eid="MRK 15:9"/><verse number="10" style="v" sid="MRK 15:10"/>Ktaiyü ktung he naw Jesuh ami k’eia phäh ni a veia ami lawpüi ti Pilat naw ksing lü acunkba a jah kthäh.<verse eid="MRK 15:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11"/>Cunsepi ktaiyü ktung he naw Jesuha kdama ta Barabah a mhlät vaia mso khai hea khyang he ami jah ksük. <verse eid="MRK 15:11"/><verse number="12" style="v" sid="MRK 15:12"/>Pilat naw jah msang be lü, “Acunüng Judah Sangpuxang nami ti hin ihawkba ka pawh vai ni?” ti se,<verse eid="MRK 15:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13"/>Ngpyang u lü, “Kutlamktung üng taiha!” ami ti.<verse eid="MRK 15:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14"/>Acunüng Pilat naw, “Ia katnak pawhki ni?” ti lü jah kthäh se.</para>
  <para style="p" vid="MRK 15:14">Ami van naw ngpyang law däm däm u lü, “Kutlamktung üng taiha!” ami ti.<verse eid="MRK 15:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15"/>Pilat naw khyang hea mlung a je vai ngaih lü Barabah a mhlät. Acun käna Jesuh kpai lü kutlamktung üng taih vaia a jah ap.<verse eid="MRK 15:15"/></para>
  <para style="s">Yekap he naw Jesuh ami Yaihei</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mt 27:27-31</ref>; <ref loc="JHN 19:2">Jn 19:2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16"/>Yekap he naw Jesuh cun bawia mkhyumima luhpüi u lü, yekap akce he pi ami jah cehpüi. <verse eid="MRK 15:16"/><verse number="17" style="v" sid="MRK 15:17"/>Bawi jihnu suisak u lü, nghling am pyanga bawilukhum a lu üng ami ngbüngsak. <verse eid="MRK 15:17"/><verse number="18" style="v" sid="MRK 15:18"/>Acunüng, “Judah hea Sangpuxang, na xünnak saü se,” ti u lü ngpyangki he. <verse eid="MRK 15:18"/><verse number="19" style="v" sid="MRK 15:19"/>Cung am a lu üng kpai u lü ami msawh, ami mkhuk am ngdäng u lü sawkhahkia ngsaihkie. <verse eid="MRK 15:19"/><verse number="20" style="v" sid="MRK 15:20"/>Acukbaa ami yaihei law päng üng Bawi jihnu lo be u lü amäta suisak kphyüm msuimsak beki he naw kutlamktung üng ami taih vaia ami cehpüi.<verse eid="MRK 15:20"/></para>
  <para style="s">Jesuh Kutlamktung üng ami Taih</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mt 27:32-44</ref>; <ref loc="LUK 23:26-43">Lk 23:26-43</ref>; <ref loc="JHN 19:17-27">Jn 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">15:21 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 16:13">Rom 16:13</ref>
      </char>
    </note>Kpami mat Sihmon ngming naki, pung kce üngka naw mlüha lawki yekap he naw hmu u lü Jesuha kutlamktung amthuia ami kawhsak. (Sihmon cun Kurenih khyang, Aleksanda la Rufuha paa kyaki.) <verse eid="MRK 15:21"/><verse number="22" style="v" sid="MRK 15:22"/>Kolkotha tia hmüna ami cehpüi, acun cun “Lukawi hmün,” tinaka kyaki. <verse eid="MRK 15:22"/><verse number="23" style="v" sid="MRK 15:23"/>Acuia mura ami tia seitui am ami kcawa capyittui a awk vaia pe u se, Jesuh naw maki. <verse eid="MRK 15:23"/><verse number="24" style="v" sid="MRK 15:24"/><note caller="-" style="x"><char style="xo" closed="false">15:24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">Sal 22:18</ref> </char></note>Acunüng kutlamktung üng taihkie naw, u naw hawn bi khai tia mtainak vaia cung kphawng u lü a suisak ng’yeteiki he. <verse eid="MRK 15:24"/><verse number="25" style="v" sid="MRK 15:25"/>Jesuh kutlamktung üng ami taihnak cun ngawi lam naji kawa kyaki. <verse eid="MRK 15:25"/><verse number="26" style="v" sid="MRK 15:26"/>Ami ksekhanaka kca: “JUDAHEA SANGPUXANG” tia a lu khana ami taih. <verse eid="MRK 15:26"/><verse number="27" style="v" sid="MRK 15:27"/>Jesuh am atänga m'yukei xawi nghngih pi mat a kpat lam, mat a k'eng lama ami jah taih hnga.<verse eid="MRK 15:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 15:28"/>
    <note caller="+" style="f">
      <char style="fr" closed="false">15:28 </char>
      <char style="ft" closed="false">Ahin cun cangcing avang üng am yuk si u. </char>
    </note> Acukba, “Ani cun khyangka he am ami jah taih hmaih,” tia cangcim kümkawi lawki.<verse eid="MRK 15:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">15:29 </char>
      <char style="xt" closed="false">
        <ref loc="PSA 22:7">Sal 22:7</ref>; <ref loc="PSA 109:25">109:25</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:58">Mk 14:58</ref>; <ref loc="JHN 2:19">Jn 2:19</ref></char>
    </note>Acunüng cit hükia khyang he naw ami lu kting u lü, “Ajä! Nang Pamhnama temple kpyeh lü mhmüp kthum üng na sa hlü beki, <verse eid="MRK 15:29"/><verse number="30" style="v" sid="MRK 15:30"/>Atuh namät naw namät küikyanei lü kutlamktung üngka naw kyum lawa,” tia ami ksekhanak.<verse eid="MRK 15:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31"/>Acukba bäa ktaiyü ktung he la thum jah mtheiki he naw pi yaihei u lü, “Khyang he ta jah küikyan khawhki, amät am ngküikyanei thei ve! <verse eid="MRK 15:31"/><verse number="32" style="v" sid="MRK 15:32"/>Mesijah, Isarel hea Sangpuxanga a kyak üng ta, kutlamktung üngka naw atuh kyum law se; mi hmu u lü mi jum kawm,” ami ti.</para>
  <para style="p" vid="MRK 15:32">Jesuh am ami jah taih hmaih xawi naw pi ani ksenak hnga.<verse eid="MRK 15:32"/></para>
  <para style="s">Jesuha Thihnak</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mt 27:45-56</ref>; <ref loc="LUK 23:44-49">Lk 23:44-49</ref>; <ref loc="JHN 19:28-30">Jn 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33"/>Mhmüp ngsung üngka naw tün lü, naji kthum bang so khaia khaw avan üng nghmüp lawki. <verse eid="MRK 15:33"/><verse number="34" style="v" sid="MRK 15:34"/><note caller="-" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">Sal 22:1</ref></char></note> Naji kthum üng Jesuh naw, <char style="wj">“Eloi, Eloi, lema Sabathani?”</char> ti lü angsanga ngpyangki. Acun cun, <char style="wj">“Ka Pamhnam, ka Pamhnam, ise na na yawki ni?”</char> tinaka kyaki.<verse eid="MRK 15:34"/></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35"/>Acunüng ngdüikia khyang avang naw ngja u lü, “Ngai ua, hin naw Elijah khü ve!” ami ti. <verse eid="MRK 15:35"/><verse number="36" style="v" sid="MRK 15:36"/><note caller="-" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">Sal 69:21</ref></char></note> Acunüng khyang mat naw dawng lü kpyawn lo lü, capyit kthui üng mcawiki naw, cungmdawng üng a tak. Acunüng Jesuha m'yawng üng a awk vaia han säng lü, “Asäng ve se! Yung khaia Elijah a law la am a law mi na teng vai u,” a ti.<verse eid="MRK 15:36"/></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37"/>Acunüng Jesuh angsanga ngpyang lü thiki.<verse eid="MRK 15:37"/></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">15:38 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 26:31-33">Ex 26:31-33</ref>
      </char>
    </note>Temple k’uma ngbangkia jihnu cun khan üngka naw aphung düta nghngiha tek lawki. <verse eid="MRK 15:38"/><verse number="39" style="v" sid="MRK 15:39"/>Yekap bawi kutlamktunga maa ngdüiki naw Jesuh a thih<note caller="+" style="f"><char style="fr" closed="false">15:39 </char><char style="fq" closed="false">Jesuh a thih</char><char style="ft" closed="false">; avang üng Jesuh ngpyang lü a thih tia ami yuk si. </char></note> hmu lü, “Hina khyang hin Mhnama Capa kcanga kya ve,” a ti.<verse eid="MRK 15:39"/></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">15:40,41</char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:2">Lk 8:2</ref>,<ref loc="LUK 8:3">3</ref></char>
    </note>Nghnumi avang Marih Makdalin, Jakuk la Josepa nu Marih la Salome naw pi athuknak üngka naw tengki he. <verse eid="MRK 15:40"/><verse number="41" style="v" sid="MRK 15:41"/>Acun he cun Jesuh Kalile khawa a ve üng läk law u lü khüihki hea kyaki he. Nghnumi kce he khawjah Jerusalema amät maha law hngaki he pi awmki he.<verse eid="MRK 15:41"/></para>
  <para style="s">Jesuh K'uta Mawng</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mt 27:57-61</ref>; <ref loc="LUK 23:50-56">Lk 23:50-56</ref>; <ref loc="JHN 19:38-42">Jn 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v" sid="MRK 15:42-43"/>Josep Arimahte cun khawmü lama pha lawki. Ani cun Pamhnama Khaw a pha law vai a na ngängki, aktäa ami leisawng kawngci ngvaia kyaki. Acuna ngcüngceinaka mhmüp (Sabbath a phanak vai mhmüp mat) üng Pilata veia cit lü Jesuha yawk a kthäh. <verse eid="MRK 15:42-43"/><verse number="44" style="v" sid="MRK 15:44"/>Pilat naw Jesuh thi pängki ti ngja lü cäiki. Yekap bawi khüki naw, “A thihnak so pängki aw?” ti lü a kthäh. <verse eid="MRK 15:44"/><verse number="45" style="v" sid="MRK 15:45"/>Yekap bawia pyen a ngjak käna Pilat naw Josep üng Jesuha yawk a lak vaia a mtheh. <verse eid="MRK 15:45"/><verse number="46" style="v" sid="MRK 15:46"/>Acunüng Josep naw jih kthai khyei lü, Jesuha yawk cun la lü, jih am hlawp lü, lung ami cawh ng’utnaka ng’uhnüna k’uma ta lü, lungnu am mkawt a khaih hüt. <verse eid="MRK 15:46"/><verse number="47" style="v" sid="MRK 15:47"/>Marih Makdalin la Josepa nu Marih naw ami k’utnak cun tengki xawi naw Jesuha yawk cun ani hmuh.<verse eid="MRK 15:47"/></para>
  <chapter eid="MRK 15"/>
  <chapter number="16" style="c" sid="MRK 16"/>
  <para style="s">Jesuha Thawhnak bea Mawng</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mt 28:1-8</ref>; <ref loc="LUK 24:1-12">Lk 24:1-12</ref>; <ref loc="JHN 20:1-10">Jn 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1"/>Sabbath a bäih üng, Marih Makdalin, Jakuka nu Marih la Salome naw Jesuh ami hluknak vaia ngsi’ui khyei u lü, <verse eid="MRK 16:1"/><verse number="2" style="v" sid="MRK 16:2"/>ngpum mhmüp ngawi, khawnghngia luh law üng ng’uhnüna citki he. <verse eid="MRK 16:2"/><verse number="3" style="v" sid="MRK 16:3"/>Ami ceh k’um üng amimät he, “U naw ng’uhnün mkawt üngka lungnu a jah ktän pet vai aw?” tia ngthähki he. (Acuna lungnu cun aktäa ngbaüki.) <verse eid="MRK 16:3"/><verse number="4" style="v" sid="MRK 16:4"/>Acunüng ami jeng mang üng acuna lungnu cun a na ngtängin päng se ami hmuh. <verse eid="MRK 16:4"/><verse number="5" style="v" sid="MRK 16:5"/>Ng’uhnün ami va luh üng suisak abawk suisakia cawngpyang mat kpat lam da ngaw se ami hmuh üng cäiki he.<verse eid="MRK 16:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6"/>Acunüng ani naw, “Ä cäi ua, kutlamktung üng ami taiha Nazaret Jesuh nami sui hüki ti ka ksingki, ani cun tho be pängki ni, hia am ve, ami msännak pi teng ua. <verse eid="MRK 16:6"/><verse number="7" style="v" sid="MRK 16:7"/><note caller="-" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">Mt 26:32</ref>; <ref loc="MRK 14:28">Mk 14:28</ref></char></note>Atuh cit u lü axüisaw he la Pita üng, ‘nami maa Kalile khawa ana cit hlü ve,’ tia jah va mtheh ua, amäta pyena kba acuia nami hmu khai ni,” a ti.<verse eid="MRK 16:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8"/>Acunüng aktäa kyüh u lü ng’uhnün üngka naw dawngkie. Kyüh ngen u lü u üng ipi am mtheh u.</para>
  <para style="s" vid="MRK 16:8">THANGKDAWA DÜTNAK KPHYÜM<note caller="+" style="f"><char style="fr" closed="false">16:8 </char><char style="ft" closed="false">Avanga yuknak la akphyüma ami jah yuke üng akyang kdik 9-20 am ami yuk si. </char></note></para>
  <para style="s" vid="MRK 16:8">Marih Makdalina veia Jesuha Ngdangnak</para>
  <para style="r" vid="MRK 16:8">(<ref loc="MAT 28:9-10">Mt 28:9-10</ref>; <ref loc="JHN 20:11-18">Jn 20:11-18</ref>)</para>
  <para style="p" vid="MRK 16:8">[ <verse eid="MRK 16:8"/><verse number="9" style="v" sid="MRK 16:9"/>Ngpum mhmüp ngawi lam üng Jesuh tho law be lü, akcüka khawyai khyüh a puk k’um üngka a ksät peta Marih Makdalina veia ngdangki. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>Ani naw cit lü Jesuha awmpüi khawie üng a jah va mtheh. A na mbawikyapki he, <verse eid="MRK 16:10"/><verse number="11" style="v" sid="MRK 16:11"/>ani naw Jesuh xüngki a hmuh pyen se ami ngjak üng, am kcang na u.<verse eid="MRK 16:11"/></para>
  <para style="s">Jesuh Axüisaw xawi nghngiha veia Ngdangki</para>
  <para style="r">(<ref loc="LUK 24:13-35">Lk 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12"/>Acun käna nghngih xawi mlüha ani ceh k’um üng, Jesuh ani veia khyang kcea kba va ngdangki. <verse eid="MRK 16:12"/><verse number="13" style="v" sid="MRK 16:13"/>Acun xawi naw law be ni lü akce he üng jah mtheh law ni se, acun he naw pi am jah kcang na u.<verse eid="MRK 16:13"/></para>
  <para style="s">Jesuh Xaleiat hea veia Ngdangki</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mt 28:16-20</ref>; <ref loc="LUK 24:36-49">Lk 24:36-49</ref>; <ref loc="JHN 20:19-23">Jn 20:19-23</ref>; <ref loc="ACT 1:6-8">Ngs 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14"/>Anghnua Jesuh axüisaw xaleiat he ami ei ana ei k’um u se ami veia ngdangki. Jesuh a thawh be käna hmukia khyang he am ami jah kcangnak la ami mlunga nghlanga phäha a jah ksenak. <verse eid="MRK 16:14"/><verse number="15" style="v" sid="MRK 16:15"/><note caller="-" style="x"><char style="xo" closed="false">16:15: </char><char style="xt" closed="false"><ref loc="ACT 1:8">Ngs 1:8</ref></char></note>Jesuh naw, <char style="wj">“Khawmdek avan üng cit u lü thangkdaw khyang avana veia sang hü ua.</char> <verse eid="MRK 16:15"/><verse number="16" style="v" sid="MRK 16:16"/><char style="wj">Upi jum lü baptican khanki cun küikyana kya khai; upi am jumki avan cun mkatnak yah khai.</char> <verse eid="MRK 16:16"/><verse number="17" style="v" sid="MRK 16:17"/><char style="wj">Jumeiki he üng müncankse he ami pawhnak thei vaia johit jah peta kya khai. Ka ngming am khawyai he jah ksät khai he; ngthu kthai he am ngthuhei law khai he;</char> <verse eid="MRK 16:17"/><verse number="18" style="v" sid="MRK 16:18"/><char style="wj">Kphyu ami kut am kpang u lü thihnak vaia tui ami awk üng pi ia am kya u; am phetki hea khana ami kut mtaih u se yai be khai he,” </char>a ti.<verse eid="MRK 16:18"/></para>
  <para style="s">Jesuh Khankhawa Kai beki</para>
  <para style="r">(<ref loc="LUK 24:50-53">Lk 24:50-53</ref>; <ref loc="ACT 1:9-11">Ngs 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">16:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:9-11">Ngs 1:9-11</ref>
      </char>
    </note> Bawipa Jesuh ami veia ngthuhei päng lü khankhawa kai be lü Pamhnama kpat lama ngawki. <verse eid="MRK 16:19"/><verse number="20" style="v" sid="MRK 16:20"/>Axüisaw he pung naküt üng cit hü u lü ngthu sang hüki he. Bawipa naw jah khüipüi lü, ami ngthu sang hü cun cangki tia müncankse he jah pawhnak am ngdangsaki.]</para>
  <para style="s" vid="MRK 16:20">AVANG AKPHYÜMA DÜTNAK AKCE</para>
  <para style="p" vid="MRK 16:20">[ <verse eid="MRK 16:20"/><verse number="9" style="v" sid="MRK 16:9"/>Nghnumi he naw Pita la a püi hea veia cit u lü ami ngjak avan aktawia ami jah va mtheh. <verse eid="MRK 16:9"/><verse number="10" style="v" sid="MRK 16:10"/>Acun käna Jesuh amät naw axüisaw he am nghngilaw lam üngka naw khawkyak lam düta ngcimcaihki la, anglät küikyanaka kyakia, anglät xünnaka ngthu cun a jah sang hüsak. ]<verse eid="MRK 16:10"/></para>
  <chapter eid="MRK 16"/>
</usx>
