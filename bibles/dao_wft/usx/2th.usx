<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2TH" style="id">Dai-Chin: Bible Translation 1st Edition</book>
  <para style="ide">Unicode (UTF-8)</para>
  <para style="h">2 Thesalonikah</para>
  <para style="toc1">THESALONIKAHEA veia Pawluha Cayuk Anghngihnak</para>
  <para style="toc2">2 Thesalonikah</para>
  <para style="toc3">2Thes</para>
  <para style="mt1">THESALONIKAHEA</para>
  <para style="mt2">Veia Pawluha Cayuk Anghngihnak</para>
  <para style="imt">Pyenhlüma</para>
  <para style="ip">Khritawa law be vai ami äpeinak nghngih kthum lü acun naw Thesalonikah sangcim jah suksakeiki. <char style="bk">Thesalonikah üng Pawluha Kca Yuk Anghngihnak </char> hin Bawipaa law be vai khawmhnüp cun pha law pängki tia khyekia jumeinaka mawnga kyaki. Pawluh naw acuna khyekia jumeinak cun ami ksing law vaia a jah mthehnak ni. Khritawa law be hlana, “Setxutnaka Capa” (2:3) tia ngming naki naw jah ngkhahpüi se aksekhyu ja limmanake cun naw Khritaw ngtukpüi khaia ngdang law ma acun he a ti.</para>
  <para style="ip">Thesalonikah sangcim khyange cun khuikha mpyenset ami khamei üngpi Khritaw jumeinak am ngkhängpang lü, Pawluh ja a khüipüi hea khüia kba khüi lü ami awmih vai, ja akdaw pawhnaka mlung ami takei nglät vaia Pawluh naw aktunga jah mthehki.</para>
  <para style="iot">Amawng Ktawie</para>
  <para style="io1">Pyenhlüma <char style="ior">(<ref loc="2TH 1:1-2">1:1-2</ref>)</char></para>
  <para style="io1">Mküieinak ja Ngaknak <char style="ior">(<ref loc="2TH 1:3-12">1:3-12</ref>)</char></para>
  <para style="io1">Khritawa law be vaia mawng mthehnak <char style="ior">(<ref loc="2TH 2:1-17">2:1-17</ref>)</char></para>
  <para style="io1">Khritjan awmih mthümhletnak <char style="ior">(<ref loc="2TH 3:1-15">3:1-15</ref>)</char></para>
  <para style="io1">Khüpnak <char style="ior">(<ref loc="2TH 3:16-18">3:16-18</ref>)</char></para>
  <chapter number="1" style="c" sid="2TH 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1"/>Pawluh, Tilah ja Timoti üngkhyüh naw,<note caller="-" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="ACT 17:1">Ngs 17:1</ref></char></note></para>
  <para style="p" vid="2TH 1:1">Mi Pa Pamhnam ja Bawi Jesuh Khritaw üng sängeikia Thesalonikah sangcim khyangea veia,<verse eid="2TH 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2"/>Mi Pa Pamhnam ja Bawi Jesuh Khritaw naw bäkhäknak ja dimdeihnak ning jah pe se.<verse eid="2TH 1:2"/></para>
  <para style="s">Khritawa law be üng ngthumkhyahnak</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3"/>Kami benae aw, nami jumeinak däm law phätphät lü khyang nami mhläkphyanak pi däm law bawkbawk ve. Acuna phäh kami jenak vaia nglawiki Pamhnam cun akcün tä se kami je naki. <verse eid="2TH 1:3"/><verse number="4" style="v" sid="2TH 1:4"/>Acunakyase, mkhuimkhanak ja khuikhatnak naküt nami sawngtawh üng mlung msaü lü nami jumeia phäh, Pamhnama sangcimea maa kami ning jah awhcah naki.<verse eid="2TH 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5"/>Ahin he naw Pamhnama ngthumkhyah ngtäi ve tia mdan lü nangmi pi Pamhnama Khawa nami pha khaia nami nglawikia kya ve. Acuna phäh ni khuikhanak nami khamei. <verse eid="2TH 1:5"/><verse number="6" style="v" sid="2TH 1:6"/>Pamhnam naw angtäia va khut biki. Ning jah mkhuimkhakiea khana mkhuimkhanak pha law be khai. <verse eid="2TH 1:6"/><verse number="7" style="v" sid="2TH 1:7"/>Mkhuimkhanak khameikie üng hüieinak jah pe khai. Keimi pi jah pe khai. Bawipa Jesuh hlüngtaikia khankhawngsäe am khankhaw üngka naw a law be üng, acune cun jah pawh law khai. <verse eid="2TH 1:7"/><verse number="8" style="v" sid="2TH 1:8"/>Mi Bawipa Jesuha Thangkdaw am ngja hlükie ja Pamhnam mahkie cun meikdäi am jah mkhuikha law khai. <verse eid="2TH 1:8"/><verse number="9" style="v" sid="2TH 1:9"/>Bawipaa hlüngtainak ja a ma üngka naw jah mtai lü angsäia cimpyehnaka mkhuimkhanak cun khamei khaie.<note caller="-" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="ISA 2:10">Hesa 2:10</ref></char></note> <verse eid="2TH 1:9"/><verse number="10" style="v" sid="2TH 1:10"/>Acukba a law bea Mhnüp üng, a khyangea mhlünmtainak ja ani jumeikiea leisawngnak cun yahei khai. Keimi naw kami ning jah mtheha ngthu nami doeikia kyase, acun üng nangmi pi nami ngpüi hnga khai.<verse eid="2TH 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11"/>A ning jah khünaka xün khaia lawingkawihkia a ning jah pyang vaia mi Pamhnama veia alä se kami ning jah ktaiyü petki. Nami dawkyanak hlü ja nami jumeinak cun ani naw kümbesak se. <verse eid="2TH 1:11"/><verse number="12" style="v" sid="2TH 1:12"/>Mi Pamhnam ja Bawipa Jesuh Khritaw üngkhyüh, ahikba Bawipa Jesuha ngming naw nangmi üngka naw hlüngtainak yah khai. Nangmi naw pi ani üngkhyüha hlüngtainak nami yah khai.<verse eid="2TH 1:12"/></para>
  <chapter eid="2TH 1"/>
  <chapter number="2" style="c" sid="2TH 2"/>
  <para style="s">Setxutnaka Capa</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1"/>Ka benae aw, mi Bawipa Jesuh Khritaw a lawnak be vai ja a veia mi ngkhyumnak be vaia mawngma üng,<note caller="-" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="1TH 4:15-17">1Thes 4:15-17</ref></char></note> <verse eid="2TH 2:1"/><verse number="2" style="v" sid="2TH 2:2"/>“Bawipaa Khawmhnüp cun pha law päng ve” ti lü ngmüimkhya ngcim üngka naw pi kyase, ngthu üngka naw pi kyase, keimia yuk lawa kcaa mäih naw pi kyase, nami cungngaihnak käh nghngih kthum lü käh nami kthaset vaia ning jah nghui na veng. <verse eid="2TH 2:2"/><verse number="3" style="v" sid="2TH 2:3"/>U naw pi ihawkba pi käh ning jah mhlei se. Akpäihnaka Pamhnam Kpetkie ja mulai meia cit khai Setxutnaka Capa am a po lawa küt üng ta, acuna Mhnüp am pha law ham. <verse eid="2TH 2:3"/><verse number="4" style="v" sid="2TH 2:4"/>Mhnama ami jah ngaihe ja ami sawkhahe naküt cun ani naw ia käh jah msui lü, ami khana vekia mhnünei law khai. Pamhnama Templea pi lutlang lü ngaw khai, amät cun Mhnam ni tia pyenei law khai.<note caller="-" style="x"><char style="xo" closed="false">2:4 </char><char style="xt" closed="false"><ref loc="DAN 11:36">Dan 11:36</ref>; <ref loc="EZK 28:2">Hez 28:2</ref></char></note><verse eid="2TH 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5"/>Nami hlawnga ka ve üng, ahin he avan ka ning jah mtheh cen am nami sümkie aw. <verse eid="2TH 2:5"/><verse number="6" style="v" sid="2TH 2:6"/>Setxutnaka Capa cun naw amäta kcün üng a podang law vaia phäh, atuh hin käh podang law khaia ani khamki veki ti nami ksingki. <verse eid="2TH 2:6"/><verse number="7" style="v" sid="2TH 2:7"/>Ngthupkia Setxutnaka Capa cun naw khut pawh k’um ve. Cunüngpi, sungkhamki mat cun am lak bea küt üngta, Setxutnaka Capa cun am podang law yah. <verse eid="2TH 2:7"/><verse number="8" style="v" sid="2TH 2:8"/>Acunüng, Setxutnaka Capa cun podang law khai. Cunüngpi, Bawipa Jesuh naw a law bea kcün üng hmut sawxat lü hnim khai. Bawipa naw hlüngtaikia akvai am avana cimkpye khai.<note caller="-" style="x"><char style="xo" closed="false">2:8 </char><char style="xt" closed="false"><ref loc="ISA 11:4">Hesa 11:4</ref></char></note> <verse eid="2TH 2:8"/><verse number="9" style="v" sid="2TH 2:9"/>Acunüng, Setxutnaka Capa cun Khawyama johit am law lü müncankse ja cäiletnak akse mjüküm cun jah pawh law khai.<note caller="-" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="MAT 24:24">Mt 24:24</ref></char></note> <verse eid="2TH 2:9"/><verse number="10" style="v" sid="2TH 2:10"/>Jah kcimpyeh vaia khyangea khana hleihlak ksekhyu mjüküm sumei law khai. Isenitiüng, acune cun naw küikyannak ami yahnak vaia ngthukcang cun mhläkphyanak üng am dodangei u. <verse eid="2TH 2:10"/><verse number="11" style="v" sid="2TH 2:11"/>Pamhnam naw johit ksekhyu cun tüih se, acun naw ami ksunga khut bi lü aksekhyu cun jumeikie. <verse eid="2TH 2:11"/><verse number="12" style="v" sid="2TH 2:12"/>Acun he cun ngthungtak käh jumei lü mkhyenak am ami hlimtui phäh mkatnak ami khamei vaia phäh ni.<verse eid="2TH 2:12"/></para>
  <para style="s">Küikyan vaia ning jah xü</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13"/>Bawipa naw a ning jah mhläkphyanaka benae aw, Ngmüimkhya Ngcima johit ja ngthungtak nami jumnak am a khyang ngcima ning jah thawnsak lü, khawmdek am a ngtüi ham üngkhyüh küikyannak nami yah khaia Pamhnam naw a ning jah xüa phäh Pamhnam cun akcün tä se kami jenaki. <verse eid="2TH 2:13"/><verse number="14" style="v" sid="2TH 2:14"/>Nami veia Thangkdaw kami sang law üngkhyüha Pamhnam naw a ning jah xü ni. Mi Bawipa Jesuh Khritawa hlüngtainak nami ka na hnga khaia a ning jah khü ni. <verse eid="2TH 2:14"/><verse number="15" style="v" sid="2TH 2:15"/>Acunakyase, kami benae aw, ngthu kami sang ja kca kami yuk law am kami ning jah mtheia ngthungtake üng ngmanei lü ngkhängcek ua.<verse eid="2TH 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16"/>Jah mhläkphya na lü a bäkhäknak üng ngkhängcekia äpeinak ja am düt theikia lingnak jah peki, mi Bawipa Jesuh Khritaw amät ja mi Pa Pamhnam naw,<verse eid="2TH 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 2:17"/>aläa akdaw pyen lü akdaw nami pawh vaia ngjuktha ning jah pe lü ning jah mcuhmcäi se.<verse eid="2TH 2:17"/></para>
  <chapter eid="2TH 2"/>
  <chapter number="3" style="c" sid="2TH 3"/>
  <para style="s">Jah ktaiyü pet ua</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1"/>Akpäihnaka, kami benae aw, Bawipaa ngthu cun nami ksunga akjanga ngthang lü a hlüngtaia mäiha, hnün lum üng ngthang hü lü leisawngnak am ami dodangei vai ua jah ktaiyü pet ua. <verse eid="2TH 3:1"/><verse number="2" style="v" sid="2TH 3:2"/>Amawngma am ksing lü am dawkia khyange ja sexukia khyangea kut üng Pamhnam naw a jah yung vaia pi ktaiyü u bä.<verse eid="2TH 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3"/>Cunüngpi Bawipa ta sitih bekhüt khawhki. Ani naw ngjuktha ning jah pe lü Khawyaipa üngkhyüh ning jah yungkaih khai ni. <verse eid="2TH 3:3"/><verse number="4" style="v" sid="2TH 3:4"/>Kami ning jah mthei läklam lü nami läklam nglät khai tia Bawipa naw mkhühüpnak jah peki.<verse eid="2TH 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5"/>Pamhnama mhläkphyanak ksing bawk vai ja Khritawa a khamei kba nami khamei khawh vaia, Bawipa naw lam ning jah msüm se.<verse eid="2TH 3:5"/></para>
  <para style="s">Käh dam vai</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6"/>Kami benae aw, kami ning jah mcuhmthehe käh jah läklam lü dudamkia jumeikiea ksunga käh nami ngcawngcik vaia mi Bawipa Jesuh Khritaw ngming üng ning jah nghui na veng. <verse eid="2TH 3:6"/><verse number="7" style="v" sid="2TH 3:7"/>Nami hlawnga kami ve üng am dam u ngü. Acukba nami ve vai cun namimät naw angtea nami ksing bawki ni. <verse eid="2TH 3:7"/><verse number="8" style="v" sid="2TH 3:8"/>Ua jah pet pi aphu kaa am doei u nawng. U pi ning jah bawngkhasak vai am yü na ung se, amhnüp amthan kami khyaih khawha kami khüiki. <verse eid="2TH 3:8"/><verse number="9" style="v" sid="2TH 3:9"/>Nami veia kthähei lü yah kyawki. Cunüngpi, am ning jah kthähei u nawng. Acun cun nami jah ngcuhngkihnak vaia ahikba kami khüikie ni. <verse eid="2TH 3:9"/><verse number="10" style="v" sid="2TH 3:10"/>Nami hlawnga kami ve k’um üng, “Au pi khüia damki üng ei käh mbei vai” mi ti khawiki.<verse eid="2TH 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11"/>Nami ksunga khyang avang cun dudam lü khyanga khut üng ngcawngcik vai sawxat ksing lü, ipi käh pawhkia khyange ami ve mi ngjaka phäh kami pyen ni. <verse eid="2TH 3:11"/><verse number="12" style="v" sid="2TH 3:12"/>Ahina khyange hin amimäta kut am khüi lü ami yah ami ei vaia kami jah mcäiki. Bawipa Jesuh Khritawa ngming am kami jah mthehki.<verse eid="2TH 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13"/>Acunüngpi, ka benae aw, akdaw pawhnak üng käh nami pyaitham vai. <verse eid="2TH 3:13"/><verse number="14" style="v" sid="2TH 3:14"/>Kami ning jah kbi lawa kca üngka ngthu am läklam hlüki ve taw khai. Cunüngpi, ami ngkeei law vaia i käh pawh ua. Jah msing sawxat u lü ami hlawnga käh ngpüingpaw ua. <verse eid="2TH 3:14"/><verse number="15" style="v" sid="2TH 3:15"/>Cunüngpi, yea mäiha ta käh jah vepüi ua. Nami khritjanpüia ngai lü jah mcäi ua.<verse eid="2TH 3:15"/></para>
  <para style="s">Akpäihnaka ngthu</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16"/>Dimdeihnaka phungnu, Bawipa amät naw akcün tä lü amjüküm üng dimdeihnak ning jah pe se. Bawipa cun nami vana khana ve nglät se.<verse eid="2TH 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17"/>
    <char style="sig">Pawluha Hnuksetnak</char> hin kamäta kut am ka yuk ni. Ahikba ngsing sun lü kca ka yuk naküt ahikba ni ka yuk khawi.<verse eid="2TH 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18"/>Mi Bawipa Jesuh Khritawa bäkhäknak nami khana pha law se.<verse eid="2TH 3:18"/></para>
  <chapter eid="2TH 3"/>
</usx>
