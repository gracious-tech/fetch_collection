<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="2CO" style="id">Dai-Chin: Bible Translation 1st Edition</book>
  <para style="ide">Unicode (UTF-8)</para>
  <para style="h">2 Korintuh</para>
  <para style="toc1">KORINTUHEA veia Pawluha Cayuk Anghngihnak</para>
  <para style="toc2">2 Korintuh</para>
  <para style="toc3">2Kor</para>
  <para style="mt1">KORINTUH</para>
  <para style="mt2">hea veia Pawluha Cayuk Anghngihnak</para>
  <para style="imt">Pyenhlüma</para>
  <para style="ip">Korintuh khyang hea veia Pawluha cayuk anghngihnak cun, Korintuh sangcim am ami ngpüingpaw kyunak am a dawa kcün üng yuka kyaki. Sangcim üngka avang he naw Pawluh aktäa ami hneng, cunsepi ami ngkhawtnak be vai a ngaih la, ami veia a jekyainak cun Pawluh naw mdangki.</para>
  <para style="ip">Acuteinak üng Korintuh sangcim am ami nglak, ise a jah ksenak tia mawng, la acunkba a jah ksenak naw ngjutnak la ngkhawtnak be jah lawipüi se a jekyaia mawng pyenki. Acunüng Judah khawa awmki hea khritjan m'yenkse he jah kpüinak vaia, am hnaiei u lü khawh ami pet vaia Korintuh sangcim a jah mtheh. Pawluh naw amät ngsä kcanga akyanak la, khyang kce he naw amäta ksai ngsä kcanga am kyakia kba ami ngaihnak cun akyanga bäihnak üng jah pyen ngkhaiki.</para>
  <para style="iot">Amawng Ktawi he</para>
  <para style="io1">Pyenhlüma <char style="ior">(<ref loc="2CO 1:1-11">1:1-11</ref>) </char></para>
  <para style="io1">Pawluh la Korintuh Sangcim <char style="ior">(<ref loc="2CO 1:12-7:16">1:12—7:16</ref>) </char></para>
  <para style="io1">Judah Khritjan hea phäha khawh pet <char style="ior">(<ref loc="2CO 8:1-9:15">8:1—9:15</ref>) </char></para>
  <para style="io1">Pawluh naw ngsä kcanga akya a pyenak <char style="ior">(<ref loc="2CO 10:1-13:10">10:1—13:10</ref>) </char></para>
  <para style="io1">Khüpnak <char style="ior">(<ref loc="2CO 13:11-13">13:11-13</ref>) </char></para>
  <chapter number="1" style="c" sid="2CO 1"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:1: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:1">Ngs 18:1</ref>
      </char>
    </note> Pamhnama ngjakhlüa, Jesuh Khritawa ngsä, kei Pawluh la mi na Timoti naw, Korintuh khawa awmkia Pamhnama sangcim la, Akaijah khawa awmki hea Pamhnama khyang ngcim hea veia:<verse eid="2CO 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2"/>Mi Pa Pamhnam la Bawipa Jesuh Khritaw üngka bäkhäknak la dim’yenak nami veia ve se.<verse eid="2CO 1:2"/></para>
  <para style="s">Pawluh naw Pamhnama veia Jekyainak Pyenki</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3"/>Mi Bawipa Jesuh Khritawa Pamhnam la Pa, m'yeneinaka Pa la dawkyanak naküta phung, mi Pamhnama veia jenak mi pyen vai.<verse eid="2CO 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 1:4"/>Pamhnam naw a jah jekyainak sak am, khuikhaki he pi mi jah jekyaisak thei hnga vaia, ani naw mi khuikhanak naküt üng jah jekyai saki.<verse eid="2CO 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 1:5"/>Khritawa khuikhanak akdäm kami yümeia kba, Khritaw üng Pamhnama kpüikpaknak pi kami yümei püiki.<verse eid="2CO 1:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 1:6"/>Khuikha u lü kami ve üng pi nangmia dawnak vai la küikyanak vaia ni akya ve; dawnak am kami ve üng pi khameinak kami dunei theia kba khameinak nami duneinak thei hnga vaia nami dawkyanak vaia ni akya ve.<verse eid="2CO 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 1:7"/>Khuikhanak nami jah khameipüikia kyase jekyainak pi nami yah khai tia üpna kami taki.<verse eid="2CO 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:8: </char>
      <char style="xt" closed="false">
        <ref loc="1CO 15:32">1Kor 15:32</ref>
      </char>
    </note>Ka püi he aw, Asah khawa am khamei hlawt vaia khuikhanak, xüng be vaia pi ä ngaih vaia ami jah bawngkhanak sak he cen nami ksing vai ngja hlü veng.<verse eid="2CO 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 1:9"/>Kami thi khaia kami ngaiki. Acun cun, kami mät am üpna u lü, khyang kthi mtho bekia Pamhnam kami üpnak thei vai phäha ni akya ve.<verse eid="2CO 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 1:10"/>Acukba kyühksekia thihnak üng Pamhnam naw jah küikyan pängki, jah küikyan be khai; jah küikyan be laih laih khai ti amät kami üpnaki.<verse eid="2CO 1:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 1:11"/>Kami phäha ktaiyünak am nami jah kpüikia kyase, tuha pi jah küikyan khai ti kami jumki. Acunakyase, khyang khawjah naw nami jah ktaiyü peta phäha kami khana pha lawkia bäkhäknak hmu u lü khyang khawjah naw kami phäha jekyainak pyen khai he.<verse eid="2CO 1:11"/></para>
  <para style="s">Pawluh Korintuh khawa a ceh vai Pyaiki</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12"/>Khawmdek khana kami xünak hin khyanga thengvainak am am ni lü, aktunga nangmi am mi ngkhawteinak üng Pamhnama jah peta ngcimcaihnak, cingcainak, Pamhnama bäkhäknaka johit am akdaw akse ksingnak theia phäh kami awhcaki ni.<verse eid="2CO 1:12"/></para>
  <para style="p">
    <verse number="13-14" style="v" sid="2CO 1:13-14"/>Nami ksing thei la nami kheh thei vaia däng ni nami veia ca kami yuk law ve. Bawipa Jesuha mhmüp üng kami ning jah awhcahnak vaia kba, keimi pi nami jah awcahna khai ti avang nami ksing pängki. Avan nami ksing law khai ti ngah'uhnak ka taki.<verse eid="2CO 1:13-14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15"/>Acunüng, acuna jumnak ta u lü a bäkhäknak ngsawn nghngih nami yahnak vaia nami veia ka law ma khai.<verse eid="2CO 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 1:16"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:16: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:21">Ngs 19:21</ref>
      </char>
    </note>Nangmi ning jah hmu law lü, Maketawnih khawa ka cit pah khai; acunüng, Maketawnih khaw üngka naw nami veia ka nghlat law be khaia ka büki; acunüng, Judah khawa ka cehnak vai üng nangmi naw nami na tha vaia ka bü siki.<verse eid="2CO 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 1:17"/>Acukba ka ngtünak üng, ka ngcüngcei sawxatki aw? Pumsa lama ngtün lü, “Ä’ sawxat lü ‘Ka’ sawxat lü ka awmki aw?<verse eid="2CO 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 1:18"/>Pamhnam cun ngthungtak akya kba, nami veia ka ngtün cun, “Ä” tia kya lü, “Ka” tia am kya.<verse eid="2CO 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 1:19"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:19: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:5">Ngs 18:5</ref>
      </char>
    </note>Pamhnama Capa Jesuh Khritawa ngthu kei, Tilah la Timoti naw nami veia kami sang khawi cen, “Ä” la “Ka” am kya lü, Pamhnam üng “Ä” tia ni akya nglät ve.<verse eid="2CO 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 1:20"/>Pamhnama ngthu khyütam ijah ve se pi, Jesuh üng “Ä” tia ni akya bäih ve. Acunakyase ni, Amät üng “Amen” mi ti u lü, Pamhnama hlüngtainak mi ngsing saki.<verse eid="2CO 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CO 1:21"/>Acunüng, Khritaw üng nangmi la keimi atänga jah ngdüihsak lü, jah khängsaki cun Pamhnam ni. Jah kphyei nghaki cun Mhnam amäta kyaki.<verse eid="2CO 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 1:22"/>Ani cun a jah ka ni tia msingnak mi khana ta lü, mi ka vaia khawjah a tak üpnak vaia khängsakia Ngmüimkhya Ngcim mi mlungmthin k’uma jah pekia kyaki.<verse eid="2CO 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23"/>Nangmi ka ning jah m'yeneia phäha ni, Korintuh khawa atuh veia am ka law hin; ka mlungmthin ksingkia Pamhnam na ksingpüi khaia khü veng.<verse eid="2CO 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CO 1:24"/>Nami jumnaka khana bawia kami kyakia am kya ve, nami jekyainak vaia kami khüiki ka tinak ni; jumnak üng khäng khaia nami ngdüiki ti ka ksingki.<verse eid="2CO 1:24"/></para>
  <chapter eid="2CO 1"/>
  <chapter number="2" style="c" sid="2CO 2"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1"/>Acunakyase nami mlung ka ning jah thüisak khaia nami veia ka law khaia am kya.<verse eid="2CO 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 2:2"/>Acukba nami mlung ka ning jah thüisak üng, nangmia thea u naw kei na jesak khai ni?<verse eid="2CO 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 2:3"/>Nangmi naw nami na jekyaisak khai sü te, ka law üng ka mlung nami na thüisak vai kyüh lü, ca ka yu lawki. Ka jekyainak nami ngkhäa jekyainaka kya khaia ka jumki.<verse eid="2CO 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 2:4"/>Ka kphyutui aktäa kya law se, mlung thüi mbawikyahnak am ka yuk law ni; acun cun nami mlunga natnak vaia ka yuka am kya lü, ka ning jah jawngnaka mlungmthin nami ksingnak vaia ka yuk law ni.<verse eid="2CO 2:4"/></para>
  <para style="s">Kaki Mhlätnak</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5"/>Khyang mat naw khyang mata mlung a thüi sak üng kei däng ka mlung na thüisakia am kya lü nangmia mlung pi ning jah thüisak pängkia ni akya ve. (Ngjut bekia khana natnak am ka ngaiha phäha ka pyena kyaki)<verse eid="2CO 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 2:6"/>Acuna khyanga khana nami mkhuimkhanak hin a phäha khäki ni.<verse eid="2CO 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 2:7"/>Acunakyase, acuna mäih cun aktäa thüisei lü pyaikia am a kyanak vaia mhlät u lü nami mcäi vai.<verse eid="2CO 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 2:8"/>Acuna thea, ani akcanga nami jawng naki ti cun nami mdang vaia ning jah nghui na veng.<verse eid="2CO 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 2:9"/>Ka pyena ngthu nami ngaih la am nami ngaih ka ning jah hmuhnak vaia pi ka yuka kyaki ni.<verse eid="2CO 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 2:10"/>Upi a katnak nami mhlät cun kei naw pi ka mhlätki. Kei naw mat mat a katnak ka mhlät khawikia akya üng nangmia phäha Khritaw üng ka mhlätki.<verse eid="2CO 2:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 2:11"/>Am ani üng khawyam naw jah näng khai ni; i a bilawh hlü mi ksingki ni.<verse eid="2CO 2:11"/></para>
  <para style="s">Turah Mlüha Pawluha Ng'änak</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">2:12,13:</char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:1">Ngs 20:1</ref>
      </char>
    </note>Acunüng, Khritawa thangkdaw ka sang khaia Turah mlüha ka pha üng, Bawipa naw ksawh na mhmawn petki.<verse eid="2CO 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 2:13"/>Kami na Tihtuh am ka hmuha phäha aktäa ka cäiki. Acunakyase khyang he jah hnukset lü Maketawnih khawa ka citki.<verse eid="2CO 2:13"/></para>
  <para style="s">Jesuh üng Ngnängnak</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14"/>Khritawa ngnängnak üng Pamhnam naw thawng kyuma kba jah cehpüiki. Pamhnam naw khritaw ksingkhyapnak cun ng’uinghnama kba avan üng pha hü khaia jah summangeiki.<verse eid="2CO 2:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 2:15"/>Mimi cun, küikyan he ja khyükaki he üng, Pamhnama veia Khritaw naw a bilawha ng’uinghnama mi kyaki ni.<verse eid="2CO 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 2:16"/>Khyükakia khyang hea phäha thihnaka thu lü, küikyana khyang hea phäha xünnaka ng’uinghnama kyaki. Acuna mäih vaia u naw khyaih khai ni?<verse eid="2CO 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 2:17"/>Khyang khawjah naw Pamhnama ngthu cun khyang he jah hleihlak na u lü ami khawnua phäha ami summangeia kba keimi naw ta am summangei u nawng; akcanga Pamhnama ngjakhlüa, Pamhnama hmuha Khritawa ngthu kami sangki ni.<verse eid="2CO 2:17"/></para>
  <chapter eid="2CO 2"/>
  <chapter number="3" style="c" sid="2CO 3"/>
  <para style="s">Ngthumkhän Kthaia M'ya he</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1"/>Kamimät kami awhcah bekia mäih lawki aw? Khyang avang hea kba nangmi üngka, am acunüng nangmi üng ngaihsimnaka ca hlü beki aw?<verse eid="2CO 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 3:2"/>Nangmi cun, kami ca , kami mlungmthin üng ng’yuki khyang naküt naw ksing lü ami kheha nami kyaki ni.<verse eid="2CO 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 3:3"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:3: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 24:12">Ex 24:12</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JER 31:33">Jer 31:33</ref>; <ref loc="EZK 11:19">Hez 11:19</ref>; <ref loc="EZK 36:26">36:26</ref></char>
    </note>Nangmi cun, ca yuknaktui am yuka caa am kya u lü xüngkia Pamhnama Ngmüimkhya am yuka nami kyaki. Lunga khana yuka am kya lü mtisa mlungmthin cauk üng yuk, Khritaw amät naw a yuka ca keimi naw kami lawa ca nami kyaki ti ngsingki.<verse eid="2CO 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4"/>Acukba kami pyenak cun Khritaw üngka Pamhnam üng mlung üpnak kami taka phäha kyaki.<verse eid="2CO 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 3:5"/>Kami mäta khyaihnak am, kami mäta ngaiha iyaw kami bilo theikia am kya. Bilawh thei vaia kami khyaihnak cun Pamhnam üngka naw ni a law ve.<verse eid="2CO 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 3:6"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:6:</char>
      <char style="xt" closed="false">
        <ref loc="JER 31:31">Jer 31:31</ref>
      </char>
    </note>Amät kung naw, ngthumkhän kthai khutbi kami bilo khaia jah ngkawihsaki; yuk sawxata ca am kya lü, Ngmüimkhya am kyaki; thum naw thinak lawpüi se ngmüimkhya naw xünak peki.<verse eid="2CO 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 34:29">Ex 34:29</ref>
      </char>
    </note>Lunga khana thum yu lü peta kyase Mhnama hlüngtainak ngdang lawki. Mosia müiha vainak a dim law be üng pi Isarel he naw am teng thei u. Thihnak theia thum pi aktäa hlüngtaikia akya üng,<verse eid="2CO 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 3:8"/>Ngmüimkhya bilawhnak cun ihlawka hlüngtai bawk khai ni?<verse eid="2CO 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 3:9"/>Khyang mkatkia khutbinak pi a hlüngtai üng, küikyanak lawpüikia khutbi binak cun ihlawka hlüngtai bawk khai ni.<verse eid="2CO 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 3:10"/>Anghnua ve lawkia hlüngtainak cun hlüngtai bawkia kyase, a na hlüngtai khawiki cun bäihki.<verse eid="2CO 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 3:11"/>Asängca khängki üng pi hlüngtainak a awm khawi üng, angläta khängki üng ta ihlawka hlüngtainak awm ksetam khai ni.<verse eid="2CO 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12"/>Acukba äpnak awmkia kyase ahmäi üng kami lingki.<verse eid="2CO 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 3:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:13: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 34:33">Ex 34:33</ref>
      </char>
    </note>Isarel he naw akvai am hmu u lü ami khyühnak vaia Mosi naw a hmai a bua kba keimi naw ta am bilo ve ung.<verse eid="2CO 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 3:14"/>Ami mlungmthin ä ngsümkia kyaki; atuh vei cäpa ngthumkhän kphyüm ami kheh üng pi ami mlung ä ngsüm khaia acuna jih am ngbueiki he. Khritaw üng ngpang käna ni acuna bunaka jih cun mkhyüha akya ve.<verse eid="2CO 3:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 3:15"/>Atuh cäpa, Mosia yuk ami kheh üng ami mlungmthin bua kya hamki.<verse eid="2CO 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 3:16"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:16 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 34:34">Ex 34:34</ref>
      </char>
    </note>Cunsepi, cangcim naw, “Bawipa veia a nghlat la a mlungmthin bunak cun khyüki,” <note caller="+" style="f"><char style="fr" closed="false">3:16 </char><char style="fq" closed="false">Upi Bawipa veia a nghlat be la a mlungmthin bunak khyüki: </char><char style="ft" closed="false">tia pi pyen üng yahki. </char></note> tia Mosia mawng a pyena kba khyük theiki.<verse eid="2CO 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 3:17"/>Hin üng, “Bawipa” cun Ngmüimkhyaa kyaki; Bawipa Ngmüimkhya awmnak naküta lätnak awmki.<verse eid="2CO 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 3:18"/>Acunakyase, mi hmai cun am ngbuei. Bawipaa ngmüimkhya kung naw ani üng mi täng khaia jah pawhki. Acun naw Bawipaa hlüngtainak akvai cun mdan lü.<verse eid="2CO 3:18"/></para>
  <chapter eid="2CO 3"/>
  <chapter number="4" style="c" sid="2CO 4"/>
  <para style="s">Mdek k’am üng Ngmüimkhya Khawhthem</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1"/>Pamhnama m’yeneinak am ahina khutbi a jah peta kyase, kami ktha am se.<verse eid="2CO 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 4:2"/>Angthupnaka bilawha khyakeinak kami yawk hütki. Hleihlaknak am bilo u lü, Pamhnama ngthu khyang mhleinak vaia am kami biloki; ngthungtak ksingsak u lü, Pamhnama hmuha khyang naküta ngaiha dawnak va kami biloki.<verse eid="2CO 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 4:3"/>Kami sanga thangkdaw thupa akya üng pi khyükaki hea phäha ni thupa akya ve.<verse eid="2CO 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 4:4"/>Acukba am jummeiki he cun khawmdek mhnama johit naw ami ksingnak nghmüp khui üng a jah thupa phäha kyaki. Ami khana vaikia akvai, thangkdaw üngka naw lawkia Khritawa hlüngtainak cun amät Pamhnam kunga tängpüi, ami hmuhnak thei üngka naw Khawmdek mhnam naw a jah thupa kyaki.<verse eid="2CO 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 4:5"/>Kami mäta mawngma am pyen u nawng, Jesuh Khritaw Bawia a kyanak la Jesuha phäha m'ya kami kyanaka mawng ni kami pyen ve.<verse eid="2CO 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 4:6"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:6: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 1:3">Gen 1:3</ref>
      </char>
    </note>Jesuh Khritawa hmai üng Pamhnama hlüngtainak, ksingnaka akvai, vainak jah pe khaia, “Nghmüp üngka akvai vai law khai,” tikia Pamhnam kung naw mi mlungmthin he üng akvai vai lawsaki.<verse eid="2CO 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7"/>Cunsepi khyaihnak cun mimi üngka am kya lü, Pamhnama vei üngka akyanak a ngdangnak vaia, acuna ngmüimkhya khawh cun mdek k’am üng mi taki.<verse eid="2CO 4:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 4:8"/>Ahmäi üng ami jah mkhuimkha, cunsepi am kami mhmüiki; kami mlung naki, cunsepi kami mlung am uplat ve;<verse eid="2CO 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 4:9"/>kami ye daki, cunsepi kami püi he awmki he; ami jah mkhuimkha, cunsepi am kami pyehki;<verse eid="2CO 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 4:10"/>kami pumsa üng Jesuha xünnak angdangnak vaia, Jesuha thihnak kami pumsa üng angläta kami phüiki.<verse eid="2CO 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 4:11"/>Isetiakyaküng, thi theikia kami pumsa üng Jesuha xünnak angdangnak thei vaia, kami xün k'um üng Jesuha phäha thi khai hlawka ami jah pawh khawi.<verse eid="2CO 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 4:12"/>Acunakyase, thihnak naw keimi üng khutbi bi se, xünnak naw nangmi üng khutbi biki.<verse eid="2CO 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:13: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 116:10">Sal 116:10</ref> (LXX)</char>
    </note> Cangcim üng, “Ka juma phäha ngthu ka pyenki” tia a ng’yuka kba, acuna ngmüimkhya jumnak bä am keimi naw pi kami pyenki.<verse eid="2CO 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 4:14"/>Bawipa Jesuh mtho bekia Pamhnam naw keimi pi Jesuh mah maha jah mtho be lü, nangmi am atänga a veia jah cehpüi khai tia kami ksingki.<verse eid="2CO 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 4:15"/>Avan hin nangmia phäha ni; Pamhnama bäkhäknak cun khyang khawjaha veia apha üng, Pamhnama hlüngtainak cun ktaiyü lü jenak pyen khai he.<verse eid="2CO 4:15"/></para>
  <para style="s">Jumnak üng Xünsei</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16"/>Acunakyase kami mlung ktha am se, kami kpung lam khyang pyehpyam sepi kami ngmüimkhya khyang cun amhmüp tä se pyang be kthai laih laiha kyaki.<verse eid="2CO 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 4:17"/>Am mawngkia kami khuikhanak, atuh asäng khuikhanak kami kham hin naw dämduh lü angläta hlüngtainak law püi khai. Acun cun atuh mi khameia kthaka däm säihki.<verse eid="2CO 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 4:18"/>Hmuh thei am teng u lü, am hmuh thei kami tengki; hmuh theie cun asängca vaia kya lü, am hmuh theie cun angläta kyaki.<verse eid="2CO 4:18"/></para>
  <chapter eid="2CO 4"/>
  <chapter number="5" style="c" sid="2CO 5"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1"/>Khawmdek khana mi awmnaka pumsa im pyeh sepi khana kut am am sak, Pamhnam amäta sak, khankhaw im, anglät khäng khaia im, mi taki ti mi ksingki.<verse eid="2CO 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 5:2"/>Khawmdek im üng mi ve k’um üng khankhaw ima mi luh vai aktäa ngaih u lü mi ngkoki.<verse eid="2CO 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 5:3"/>Acun mi suiawi üng pumsa kaa am mi ve khai.<verse eid="2CO 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 5:4"/>Hina khawmdek im üng mi ve üng phüi k’yüh mi phüi u lü, mkhuimkhanak am mi ngkoki; Mi awmnaka khawmdek pumsa üngka naw mi ngtai vai mi ngaiha phäha am kya lü, khankhaw suiawi mi khana mi suiawi vai mi ngaiha phäha kyaki. Acunüng va pyeh theiki cun xünaka nglat khai.<verse eid="2CO 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 5:5"/>Acukba jah biloki cun Pamhnama kyaki. Acuna Pamhnam cun khängnak saka Ngmüimkhya jah pekia kyaki. Ngmüimkhya ngcim a jah bekhütnak cun mimia phäha a jah tak pet ni.<verse eid="2CO 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6"/>Acunakyase, pumsa im üng mi awma küt üng Bawipa im üngka naw mi thuki tia mi ksing u lü anglät se mi lingki.<verse eid="2CO 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 5:7"/>Jumnak üng mi xüng lü hmuhnak thei üng am mi xüng.<verse eid="2CO 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 5:8"/>Pumsa im mi yawk u lü Bawipa am im üng mi awm hmaih khaia aktäa mi ngaih u lü mi lingki.<verse eid="2CO 5:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 5:9"/>Acunakyase, hia im üng kami ve üng pi kyase, acai im üng kami ve üng pi kyase Mhnam jekyainak sak vai kami ngaihki.<verse eid="2CO 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 5:10"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">5:10: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 14:10">Rom 14:10</ref>
      </char>
    </note> Isetiakyaküng, mi van mi pumsa üng mi vecawh, am dawkyaki la dawkyaki mi bilawha kba mi yahnak vaia Khritawa ngthumkhyanaka ma mi ngdang law khai.<verse eid="2CO 5:10"/></para>
  <para style="s">Khritaw üng Mhnama Püia Kyanak</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11"/>Acunakyase, Pamhnam kyühnak ksing u lü khyang he kami jah kdäk khawiki. Pamhnam naw jah ksingki; nangmi naw pi nami mlung üng nami na ksingkia ngai veng.<verse eid="2CO 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 5:12"/>Nami veia kami awhcah hlü bekia am kya ve, khyanga ngneingnawnga mawng am ni lü, khyanga ngtotai awhcah naki he nami jah msangnak be thei vaia mawng ka ning jah mtheh hlüki ni.<verse eid="2CO 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 5:13"/>Kami ang kcangki aw? Pamhnama phäha ni akya ve. Am acunüng kami ngsümki aw? Nangmi phäha ni akya ve.<verse eid="2CO 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 5:14"/>Khritawa jawng'engnak naw amthuia jah uki; Khyang naküta thihnak vaia nghnün üng khyang mat thi se acuna phäha khyang naküt thiki hea kami ngaiki.<verse eid="2CO 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 5:15"/>Acunüng, xüngki he ami mäta phäha am xüng ti u lü, ami thihnak vaia nghnün üng thi lü tho bekia phäha ami xünnak vaia ni khyang naküta phäha a thih ve.<verse eid="2CO 5:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16"/>Acunakyase, tuhkbäih üng tün lü pumsa thuma ua lei am mkhya ti ve ung. Khritaw mata khyanga thum am kami mkhya pe khawikia akya üng pi.<verse eid="2CO 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 5:17"/>Acunakyase, khyang cun Khritaw üng a ve üng akthaia kyaki; akphyüm khyük bäih lü akthaia kya lawki.<verse eid="2CO 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 5:18"/>Ahmäi Pamhnama pawha kyase; ani naw Khritawa ye hea kyanak üngka naw amäta püi hea jah pawh lü, khyang kce pi a püia jah pawh vaia khut jah peki.<verse eid="2CO 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 5:19"/>Pamhnam naw Khritaw üng khyang avan a püia jah pawh lü,<note caller="+" style="f"><char style="fr" closed="false">5:19</char><char style="fq" closed="false">Pamhnam naw Khritaw üng khyang avan a püia jah pawh lü; am acunüng </char><char style="fq" closed="false">Pamhnam naw khyang avan Khritaw üngka a püia jah pawh lü. </char></note> ami katnak he jah mhlät lü, ihawkba khyang he a püia a jah pawh ni tia ngthu keimi üng a jah pet.<verse eid="2CO 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20"/>Pamhnam naw ning jah nghui nakia mäiha kami pyenki. Pamhnam naw kami ngthu pyen nami ngai khaia ning jah nghui naki. Yea kyanak üngka naw a püia kyanak vaia ning jah mthawng mhlai kawm tia Khritawa nghnün üng ning jah nghui na ve ung.<verse eid="2CO 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CO 5:21"/>Khritaw üng Pamhnama ngdüngdainak mi yumei püi khaia, katkawngnak am ksingeikia Khritaw cun Pamhnam naw mi phäha kakawngkia a pyang.<verse eid="2CO 5:21"/></para>
  <chapter eid="2CO 5"/>
  <chapter number="6" style="c" sid="2CO 6"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1"/>Pamhnama bäkhäknak nami yah cen amdanga am akyanak vaia, Pamhnam kami khüihpüikia keimi naw ning jah nghui na ve ung.<verse eid="2CO 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 6:2"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">6:2: </char>
      <char style="xt" closed="false">
        <ref loc="ISA 49:8">Hesa 49:8</ref>
      </char>
    </note>Pamhnam naw, “Ka ning m’yeneinak ka ning mhmuhnak vaia kcün a pha law üng ning ngai pe veng; ka ning küikyanak vaia mhmüp a pha law üng, ning kpüi veng” a tia kba, atuh ni m’yeineinaka kcüna kya lü, atuh ni küikyanaka mhmüpa akyak ve.<verse eid="2CO 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3"/>Kami khutbi khyang naw am ami ksekhanak vaia, khyanga kyukngtängnak vaia pi i am bilo u nawng.<verse eid="2CO 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 6:4"/>Pamhnama khutbi biki hea kba, aktäa khuikhat khameinak, bawngkhanak la m'yenksenake jah khamei u lü, ahmäi üng khyanga hmuha daw khaia Pamhnama m'ya kami kyanak kami mdanki.<verse eid="2CO 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 6:5"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">6:5: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:23">Ngs 16:23</ref>
      </char>
    </note> Ami jah kpaih, thawng üng ami jah khyum, ami jah sip; khüikhawm ngang u lü am ihnak, buh am einak kami khameiki.<verse eid="2CO 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 6:6"/>Jawngengnak kcang la Ngmüimkhya ngcim üng kami ngcimcaihnak, kami ksingkhyapnak, kami duneinak la kami mlunga dawnak,<verse eid="2CO 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 6:7"/>Ngthungtak kami pyennak, Pamhnama khyaihnak am Pamhnama m'ya kami kyanak kami mdanki. Kami mäta ngsungeinak vai la ngtuknak vaia ngdüngdainak cun likcima kba kami taki.<verse eid="2CO 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 6:8"/>Jah ngak u lü ami jah hmuhmsit; jah ksena u lü ami jah mhlünmtai. Hleihlakia kba ami jah pawh, cunsepi ngthungtak kami pyenki,<verse eid="2CO 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 6:9"/>u naw am a jah ksinga mäiha ami jah awmpüi, cunsepi khyang naküt naw a jah ksing; kami thikia mäih lawki cunsepi xüng ung se jah hmu ve uki. Ami jah mkhuimkha cunsepi am ami jah hnim;<verse eid="2CO 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 6:10"/>ami jah mthüimsei cunsepi angläta kami jekyaki; m'yenksekia mäiha kami ngdangki cunsepi khyang khawjah kami bawimang saki; i am kami takia mäiha kami ngdangki cunsepi ahmäi kami da na kcangki.<verse eid="2CO 6:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11"/>Ka püi Korintuh khyang he aw! Angsinga nami veia ngthu pyen u lü kami mlung aktäa ning jah mhmawng pe ung se; nangmi naw ni nami mlung am nami mhmawng ve.<verse eid="2CO 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 6:12"/>Kami mlung mthin nami hama am khai u nawng, nangmi naw ni nami mlung mthin kami hama nami khai ve.<verse eid="2CO 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 6:13"/>Acunakyase, nami khana kami awma kba kami khana nami mlung nami mhmawng hnga vaia ca hea kba ning jah mtheih veng.<verse eid="2CO 6:13"/></para>
  <para style="s">Am Jumeiki he jah Cäinak vai</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14"/>Am jummeiki he am atänga am nami khüihkhawm hmaih vai, ikba akcang la am akcang ngkhawt thei khai xawi ni? Ikba nghmüp la akvai awm hmaih khai xawi ni?<verse eid="2CO 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 6:15"/>Ihawkba Khritaw la Khawyai ngaisim hmaih thei khai xawi ni? Jummeiki naw am jummeiki cun i yümei püi thei khai ni?<verse eid="2CO 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 6:16"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">6:16: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 26:12">Lev 26:12</ref>; <ref loc="EZK 37:27">Hez 37:27</ref>; <ref loc="1CO 3:16">1Kor 3:16</ref>; <ref loc="1CO 6:19">6:19</ref></char>
    </note> Pamhnama Temple la juktuh he pi ihawkba nglawi khai xawi ni? Mimi cun xüngki Pamhnama Temple mi kyaki; “Ka im ka khyang he üng pyang lü ami ksunga ka awm khai; kei ami pamhnama kya ni se, acunüng amimi pi ka khyanga kya khai he,” tia, Pamhnam naw a pyena kba.<verse eid="2CO 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 6:17"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">6:17:</char>
      <char style="xt" closed="false">
        <ref loc="ISA 52:11">Hesa 52:11</ref>
      </char>
    </note> Acunakyase, “Jah yawk lü nami jah ngtai püi vai. Am ngcimcaihki pi ä hnet u, acunüng ka ning jah dokhamei khai”<verse eid="2CO 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 6:18"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">6:18</char>
      <char style="xt" closed="false">
        <ref loc="2SA 7:14">2Sam 7:14</ref>; <ref loc="1CH 17:13">1Khro 17:13</ref>; <ref loc="ISA 43:6">Hesa 43:6</ref>; <ref loc="JER 31:9">Jer 31:9</ref></char>
    </note>“Kei nami Pa kya ni se, nangmi pi ka capa he la ka canu he nami kya khai” tia ahmäi khyaihkia Pamhnam naw a ti.<verse eid="2CO 6:18"/></para>
  <chapter eid="2CO 6"/>
  <chapter number="7" style="c" sid="2CO 7"/>
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1"/>Ka püi he aw, khyütam avan mi hama pyana kyaki. Pumsa la mlungmthin nghmüimkhya mtüihkhyehnak üngka naw mi ngcimcaih u lü, Pamhnam kyühnak am mi xüngsei vai u.<verse eid="2CO 7:1"/></para>
  <para style="s">Pawluha Jekyainak</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2"/>Nami mlung k’uma hmün jah mhäng pe ua; ua khana katnak am kami pawhki, u pi am kami kpyehki, ua ka pi hleihlak u lü am kami ka naki ni.<verse eid="2CO 7:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 7:3"/>Acun cun ka ning jah mkateinak vaia ka pyena am kya ve, thih üng thih hmaih vai, xüng üng pi xüng hmaih vaia; kami ning jah mlungei naki ti ajana ka ning jah mtheh päng ni.<verse eid="2CO 7:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 7:4"/>Aktäa ka ning jah üpangnaki, aktäa ka ning jah awhcah naki, aktäa mlung dimnak am ka beki, kami khuikhanak naküt üng pi jekyainak am ka beki.<verse eid="2CO 7:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">7:5: </char>
      <char style="xt" closed="false">
        <ref loc="2CO 2:13">2Kor 2:13</ref>
      </char>
    </note>Maketawnih khawa kami pha üng pi am xüiei u nawng, ahawia pi khuikha u lü kami awmki; kpunga ngtunngvawknak la mlung k’uma kyühkyawknak am kami awmki.<verse eid="2CO 7:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 7:6"/>Cunsepi, ami mlung hnemki ktha jah pekia Pamhnam naw Tihtuha lawnak vai am jah dim’yesak ve;<verse eid="2CO 7:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 7:7"/>a lawnak dänga am kya lü, nami vedamnak, nami kyahnaka khana nami kthanakea mawng na jah mtheh se nangmi üngka dim’yenak naw na dim’yesak ve; acunakyase ka jekyai beki ni.<verse eid="2CO 7:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8"/>Ka ca yuk naw ning jah thüisak sepi am ning jah maih nawng. Ka yuk law kcük naw a ning jah thüisak cen üng ka ning jah maih haw khai sü.<verse eid="2CO 7:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 7:9"/>Tuhkbäi ka jekyaiki, ka ning jah pukset saka phäha am kya lü, nami puksetnak naw a ning jah ngjutsaka phäha kyaki. Acuna puksetnak cun Mhnama sumeia kyaki; keimi naw kami ning jah mkhuimkhakia am kya.<verse eid="2CO 7:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 7:10"/>Pamhnama ngjakhlüa puksetnak naw küikyanak pha lawsakia kyase am danga am kya, khawmdek mlungthuinak naw ta thihnak ni a lawpüi.<verse eid="2CO 7:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 7:11"/>Pamhnama ngjakhlüa nami mlungthuinak naw, nami khana ngmangnak a bilawh he cun, sitiknak, am dawki am nami biloki tia ngdang hlünak sak, katnak hnengnak la katnak kyühnak, nami na ngaihnak la kthanak, katnak pawhki mtai pet vaia nami ngaihnak hea kyaki.<verse eid="2CO 7:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12"/>Acunakyase, ca ka yuk law üng pi mkhyekatkie la ami katnaka phäha ka yuka am kya. Pamhnama hmuha kami veia nami kthanak cen nami ksingnak vaia ka yuka kyaki ni.<verse eid="2CO 7:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 7:13"/>Acunakyase, kami ktha beki. Keimia ktha benak dänga am kya, Tihtuh naw ihlawka jah jesaki ti cun ania cehnak hüa nami kpüia phäha kyaki.<verse eid="2CO 7:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 7:14"/>Am nami na helatsakia kya se ania veia ka ning jah awhcah naki. Akcang cun nami veia angläta kami pyenki, acunkba kunga Tihtuha veia ka mi awhcaknak naw mdanki ve.<verse eid="2CO 7:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 7:15"/>Aning jah mtheinak nami ngai hlünak, kyühnak la ngkhyetnak am nami dokhamnak he jah ksing lü ning jah jawng law na ksetamki.<verse eid="2CO 7:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 7:16"/>Ahmäi üng ka ning jah üpnaka phäha ka jekyaiki.<verse eid="2CO 7:16"/></para>
  <chapter eid="2CO 7"/>
  <chapter number="8" style="c" sid="2CO 8"/>
  <para style="s">Khritjan hea Petmsawtnak</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:1-4:</char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:26">Rom 15:26</ref>
      </char>
    </note>Kami püi he aw, Maketawniha sangcim hea veia Pamhnam naw bäkhäknak a jah pet kami ning jah ksing hlüsaki.<verse eid="2CO 8:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 8:2"/>Acuna sangcim he cun ami awmnaka khuikhanak aktäa khamei u lü m'yenkseki he, acunsepi aktäa petmsawtnak üng ktha naki he kyase ami jekyainak dämki.<verse eid="2CO 8:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 8:3"/>Ami khyaih khawjah pe u lü acuna thea pi peki he tia ka ksingki. Ami pet hlüa kba peki he ni.<verse eid="2CO 8:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 8:4"/>Acukba petmsawtnak üng khyang ngcim he jah kpüi yüm vaia Judah khawa jah nghui naki he.<verse eid="2CO 8:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 8:5"/>Kami ngaiha kthaka, akcüka Bawipa veia ngpe kyu u lü; acunüng Pamhnama ngjakhlüa amimät keimia veia ngpe kyuki he.<verse eid="2CO 8:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 8:6"/>Acunakyase, Petmsawtnaka khut tünei maki Tihtuh naw petmsawtnaka khut a kpäng vaia kami mthehki.<verse eid="2CO 8:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 8:7"/>Acunakyase, ahmäi üng jummeinak, ngthu sangnak, ksingkhyapnak, ahmäi hmäi üng ngsümtawmnak, keimi nami jah jawngnak<note caller="+" style="f"><char style="fr" closed="false">8:7: </char><char style="fq" closed="false">keimi nami jah jawngnak; </char><char style="ft" closed="false">avang naw </char><char style="fq" closed="false">kami ning jah jawngnak </char><char style="ft" closed="false">tia ami yuk. </char></note> nami mdana kba, acuna bäkhäknak pi nami mdan vaia ktha na ua.<verse eid="2CO 8:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8"/>Ngthupeta kba am ka ning jah mthehki, khyang kcea jah kpüi vai ihlawka yängki he ti la, jawngnak akcang la am akcang ti mhnüteinaka ka pyen na kyaki ni.<verse eid="2CO 8:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 8:9"/>Mi Bawipa Jesuh Khritawa bäkhäknak nami ksingki ni; ani cun nangmi nami bawimangnak vaia phäha amät naw amät m'yenkse saki ni. Acun cun Nangmi nami bawimangnak vaia phäha m'yenkse lawki.<verse eid="2CO 8:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10"/>Tuh kum üng nami tüneinak atuh nami kpäng vai ka ngja lüki. Nangmi cun nami tünei khai dänga am kya lü nami tünei vai nami ngjahlü kcükia pi nami kyaki.<verse eid="2CO 8:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 8:11"/>Acunakyase, ajana petmsawt hlünaka mlungmthin nami taka kba, atuh nami khyaiha pe u lü ngpängsak ua.<verse eid="2CO 8:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 8:12"/>Petmsawt hlünaka mlung a ve üng, am na tak am ni, na takca i pi na pet cun Mhnam naw ning dokhamei pe khai.<verse eid="2CO 8:12"/></para>
  <para style="p">
    <verse number="13-14" style="v" sid="2CO 8:13-14"/>Akce he phüiha jang vaia nami khana phüih k’yüh am ta veng. Atuh nami bawimangnak am amimi jah kpüi u lü, tuha amimi ami bawimang law üng ning jah kpüi khai he. Ahinkba atänga ve ua.<verse eid="2CO 8:13-14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 8:15"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:15: </char>
      <char style="xt" closed="false">
        <ref loc="EXO 16:18">Ex 16:18</ref>
      </char>
    </note>Cangcim naw, “Mcun dämki naw am da na law naw, apica mcunki pi a tak am jaw naw” tia a pyena kba.<verse eid="2CO 8:15"/></para>
  <para style="s">Tihtuh la a Püi he</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16"/>Ning jah kpüi vaia kami kthanaka kba Tihtuh naw pi a kthanak vaia mlung pekia Pamhnam kami jenaki.<verse eid="2CO 8:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 8:17"/>Ani cun, ka nghuinak, a ngai dänga am kya lü mlung hlünak am nami veia a hlüa lawki.<verse eid="2CO 8:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 8:18"/>Acunüng, thangkdaw a khüihnak üng sangcim he naw aktäa ami leisawnga bena, ani am atänga kami tüih law khai.<verse eid="2CO 8:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 8:19"/>Acun dänga am kya, Bawipa hlüngtainak vaia kami bilawh, petmsawtnak kami cehpüi üng jah ngkhahpüi khai la, kpüi vaia kami yängnak mdang khaia, sangcim he naw ami xüa kyaki.<verse eid="2CO 8:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 8:20"/>Acunüng, acuna petmsawtnaka khutbi kami bilawh üng, u naw am a jah mkatei vaia kami mceiki.<verse eid="2CO 8:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CO 8:21"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">8:21: </char>
      <char style="xt" closed="false">
        <ref loc="PRO 3:4">Ngthk 3:4</ref> (LXX)</char>
    </note>Bawipa ngaih dänga am kya lü khyanga ngaiha pi dawkya khaia kami ngaiki he ni.<verse eid="2CO 8:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22"/>Ami veia kami bena kce pi kami tüih si khai; ani cun ahmäi üng khüi lü kthanaki ti khawvei kami ksing päng, atuh pi ning jah üp na lü ning jah kpüi khaia yäng bawk bawki.<verse eid="2CO 8:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 8:23"/>Tihtuh cun ka püi la nami phäha ka khüihpüia kyaki; ani mah maha lawki hea bena kce he cun sangcim hea jah tüih law, Khritawa hlüngtainaka kyaki he.<verse eid="2CO 8:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CO 8:24"/>Acun hea veia nami jawngnak jah mdan u; acunüng kami ning jah awhcahnak cun sangcim he naw ksing khai he.<verse eid="2CO 8:24"/></para>
  <chapter eid="2CO 8"/>
  <chapter number="9" style="c" sid="2CO 9"/>
  <para style="s">M'yenkseki he jah Kpüi vai</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1"/>Judah khawa Pamhnama Khyang he naw aning jah kbi lawa mawng hin ka yuk vai am hlü ve.<verse eid="2CO 9:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 9:2"/>Jah kpüi vai nami tängki ti ka ksinga phäha Maketawnih khyang hea veia ning jah awhcah na veng. “Akaijah khawa awmki jumeiki he ta tuhkum üngka ami jah kpüikpak vaia ngtün pängki he ni” tia ka pyen. Nami jah kpüikpak hlü naw jah thawhlet sak ve.<verse eid="2CO 9:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 9:3"/>Cunsepi, acuna ka ning jah awhcahnak, amdanga am akya lawnak vaia bena he ka jah tüiki, acun cun ka pyena mäiha ngcüngcei u lü nami na awm vaia kyaki.<verse eid="2CO 9:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 9:4"/>Am acunüng Maketawnih khaw üngka khyang he naw na läk law hnga u lü, am ngcüngcei u lü nami ve ning jah hmu law se, keimi (nangmi ä ka tiki) kami ning jah üppangei naki ihlawka kami ngkehkhyakei khai he ni.<verse eid="2CO 9:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 9:5"/>Acunakyase, jumeiki he nami veia ana law ma u lü, petmsawt vaia ngthumkhän nami mkhän päng cen nami na ngpängnak vaia, ning jah nghuina kdaw khaia ka ngaihki ni, acun cun amthuia kthäha kba am kya lü, mlung yängnak am petmsawta ngpäng lü ana awmnak vaia kyaki.<verse eid="2CO 9:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6"/>Cunsepi, acuna mawngma üng hin hin sümei ua, mci apica sawki naw apica at be khai, akdäm sawki naw akdäm at be khai.<verse eid="2CO 9:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 9:7"/>Upi kpameinak am am pe lü, am pet üng am daw khai tia ngainak am pi ä pe lü, a mlunga yängnak am pe se; Pamhnam naw mlung yängnak am peki mhläkphya naki.<verse eid="2CO 9:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 9:8"/>Acunüng Pamhnam naw a bäkhäknak naküt nami khana kbe theiki; acunüng, nangmi naw ahmäi üng khäk ve tia am awmkia, khutbi kdaw binak naküt üng nami ve khai.<verse eid="2CO 9:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 9:9"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">9:9:</char>
      <char style="xt" closed="false">
        <ref loc="PSA 112:9">Sal 112:9</ref>
      </char>
    </note> “Ani naw hlükaweiki he üng jah peki, ania m'yeneinak angläta awmki” tia cangcim naw pyenki.<verse eid="2CO 9:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 9:10"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">9:10:</char>
      <char style="xt" closed="false">
        <ref loc="ISA 55:10">Hesa 55:10</ref>
      </char>
    </note>Mciksaw üng mci la ei vai buh pekia Pamhnam kung naw, nami hlüa mci cun pi ning jah pe lü dämduhsak se khawjaha nami yah be khai.<verse eid="2CO 9:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 9:11"/>Angläta pet hlünaka mlung nami ta khaia Mhnam naw ning jah bawimang sak khai. Acunüng khyang he naw nami petmsawtnak yah u lü Pamhnam je na khai he.<verse eid="2CO 9:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 9:12"/>Ahina ngpüinaka khutbinak naw khyang ngcim hea khuikhanak a jah kpüinak dänga am kya lü, Pamhnama bäkhäknak aktäa sangnak vaia pi kyasaki ni.<verse eid="2CO 9:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 9:13"/>Acuna petmsawtnaka khut nami bilawh la am kpamei u lü nami jah petmsawta phäha, khyang he naw Khritawa thangkdaw üng nami sitihnak üng Pamhnam mhlünmtai khai he.<verse eid="2CO 9:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 9:14"/>Nami khana Pamhnama bäkhäknak dämda khaia nami phäha ning jah ktaiyü pe u lü, aktäa ning jah ngai khai he.<verse eid="2CO 9:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 9:15"/>Aphuküi bäkhäknak a jah yeta phäha Pamhnam mi je na vai u.<verse eid="2CO 9:15"/></para>
  <chapter eid="2CO 9"/>
  <chapter number="10" style="c" sid="2CO 10"/>
  <para style="s">Pawluh naw a Khutbi Kthanaki</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1"/>Kei Pawluh nami ksunga mlung hnemnak am awm lü, athuknaka ka ve üng linglai khawiki naw, Khritawa hniphnawinak la dawnak am ning jah nghui na veng.<verse eid="2CO 10:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 10:2"/>Pumsa lama keimi, kami ngdüithokia jah ngaiki hea veia ka linga kba, nami veia ka pha law üng ka linglai khaia ä nami na lingnak vaia ning jah nghui na veng.<verse eid="2CO 10:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 10:3"/>Khawmdek üng mi awmki, acunsepi khawmdeka thum üng am mi ngtu naw.<verse eid="2CO 10:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 10:4"/>Keimia ngtuknaka likcim he cun khawmdek likcim hea am kya lü Pamhnama johita likcim he ni. Acun cun mlüh ngvawng he jah kpyehnak vaia kami summangki.<verse eid="2CO 10:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 10:5"/>Am cangkia ngcuhnak he la Pamhnam ksingkhyapnak sungkhamkia awhcahnak he cun jah kpyeh u lü, ami cungaihnak jah pinpawk u lü Khritawa ngthu kami jah läklam saki.<verse eid="2CO 10:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 10:6"/>Ngthu nami ngaihnak a kümkawi käna, ngthu ä ngaihnak naküt kami mkhuimkha khaia kami ngcüngcei pängki.<verse eid="2CO 10:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7"/>Ipi akpung lam nami tengki. Nangmi üngka uyaw Khritawa ka kyakia a ngaihkyu üng, ngaikyu be kawm. Amimi Khritawa ka ami kyaa kba, Keimi pi Khritawa ka kami kya hngaki.<verse eid="2CO 10:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 10:8"/>Ka ana (nangmi ning jah kpyehnak vaia am kya lü nangmi ning jah pyanthamnak kdaw vaia, Bawipa naw ana pet cen) aktäa ka awhcahnak üng pi ka hmai am se khai.<verse eid="2CO 10:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 10:9"/>Ca ka yuk law am ka ning jah mkyühkia am kya.<verse eid="2CO 10:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 10:10"/>Uyaw naw, “Pawluha cayuk he yüh u lü kyanki he, amät mi hlawnga a awm üng a ktha am kyan lü a ngthu pyen pi amdang ni,” tiki.<verse eid="2CO 10:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 10:11"/>Acuna khyang he naw nami hlawnga am kami ve üng ca üng kami yuka kba, nami hlawnga kami ve üng bilawhnak am kami awmki ni ti hin ksing khai.<verse eid="2CO 10:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12"/>Amimät la amimät mhlünmtaieikia khyang he am atänga kami ve vai am ngaih u nawng, mtängnak vai pi am kami ngaihki. Ihlawka angki he ni! Amimät naw amimät msuimcäpnak am amimäta ngthu mkhyahki he.<verse eid="2CO 10:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 10:13"/>Keimi awhcahnak hin kami awhcah vaia kthaka am awhcah u nawng; Mhnam naw a jah tak peta khuta k’uma um lü nami ksunga kami bilawh pi ngpüiki ni.<verse eid="2CO 10:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 10:14"/>Acuna k’uma nami umkia kyase, Khritawa thangkdaw law püi u lü nami veia kami law üng acuna thea am bilo u nawng.<verse eid="2CO 10:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 10:15"/>Acunakyase, Pamhnam naw pawh vaia a jah tak peta thea khyang kcea khutbia kthaka am awhcah ve ung. Nami jumnak däm law se, nami ksunga khutbi akdäm bawk kami pawh law khaia kami ngak’uhki.<verse eid="2CO 10:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 10:16"/>Acunüng thangkdaw cun nangmia khaw pi khye u lü kami sang khai. Khyang kce hea khawa bilawh pänga khutbi kami awhcahnak vai am ngaih ve ung.<verse eid="2CO 10:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 10:17"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">10:17: </char>
      <char style="xt" closed="false">
        <ref loc="JER 9:24">Jer 9:24</ref>
      </char>
    </note> Cunsepi, “A awhcah vai ngaiki naw, Bawipa bilawhnak awhcah na se” tia cangcim naw pyenki.<verse eid="2CO 10:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 10:18"/>Amät mhlünmtaieiki naw ngaknak am hlawhei khawi, Bawipa naw a mhlünmtai naw ni ngaknak a hlawhei. Mimät naw mimät dawkia mi ngaiha phäha am kya.<verse eid="2CO 10:18"/></para>
  <chapter eid="2CO 10"/>
  <chapter number="11" style="c" sid="2CO 11"/>
  <para style="s">Pawluh la am Ngsä Kcang he</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1"/>Ka angnak api a awm üng na ngaisim pe ua; na ngaisim pe kcang ua.<verse eid="2CO 11:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 11:2"/>Pamhnama kba ning jah k’eihei veng; nangmi cun khyang mat, amät Khritawa khyu vaia ngla ngcim ka tak peta nami kyaki.<verse eid="2CO 11:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 11:3"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">11:3: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 3:1-5">Gen 3:1-5</ref>,<ref loc="GEN 3:13">13</ref></char>
    </note> Kphyu naw a hleihlaknak am Evah a mhleia kba, nami ngaikyunak pyeh se Khritawa veia nami ng’apnak nami pyai tak vai kyüh veng.<verse eid="2CO 11:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 11:4"/>Isetiakyaküng, am kami sanga Jesuh akce sang lü nami veia lawki naküt nami na dokham, keimi üngka naw nami yaha nghmüimkhya la keimi üngka naw nami yaha thangkdawa am kyakia ngmüimkhya la thangkdaw akce nami yaha phäha kyaki!<verse eid="2CO 11:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5"/>Ngsä kkü he nami ti hea kthaka ka hnem bawk khaia am ngai veng.<verse eid="2CO 11:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 11:6"/>Ngthu sangnak üng amimia kba am ka thengvai üngpi, ksingkhyapnak üngta akcunkba am ni; ahin hin nami veia hmün naküt la akcün naküt ngsing khaia kami pawhki he ni.<verse eid="2CO 11:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7"/>Nami veia thangkdaw ka sang law üng aphu am kthäk khawi nawng; nami hlüngtainak vaia kamät naw kamät ka hnem sak hin ka katnaka kyaki aw?<verse eid="2CO 11:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 11:8"/>Nami ksunga khutbi ka bi k’um üng sangcim kce he naw na khyengki he. Nangmi ning jah kpüinak vaia phäha ka jah yuteikia kya ve.<verse eid="2CO 11:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 11:9"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">11:9: </char>
      <char style="xt" closed="false">
        <ref loc="PHP 4:15-18">Phi 4:15-18</ref>
      </char>
    </note>Acunüng, nami veia ve lü ngui ka hlüei üng pi u am kpyankhaei nawng; jumeiki he Maketawnih khaw üngka naw ami law üng ka hlükaw cun na kpüikie; ahmäi üng am ka ning jah kpyankhaei khaia ka ngcüngceiki, acunkba ka ngcüngcei laih laih khai.<verse eid="2CO 11:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 11:10"/>Khritawa ngthungtak kei üng awmkia kyase, “Ngui am ning jah kthäh nawng” ti lü ka awhcahnak hin Akaijah khaw naküta pi am düt khai ni.<verse eid="2CO 11:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 11:11"/>Am ka ning jah jawngnaka phäha ahikba ka pyenki aw? Pamhnam naw ksingki.<verse eid="2CO 11:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12"/>Tuhkbäih aphu kaa ka bilawha kba tuha pi ka bi khai, isetiüng ngsä kce he naw pi ka bilawha kba bilo nghaki he tia am ami awhcah vaia phäha ni.<verse eid="2CO 11:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 11:13"/>Acuna Khyang he cun ngsä kcanga am kya u lü, ngsä kcanga ngsaihkie ni, amimi cun Khritawa ngsä kcanga mäiha ngdang khaia khutbi biki he ni.<verse eid="2CO 11:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 11:14"/>Acun cun mün vai am kya; Khawyam pi khankhawngsäa mäiha ngpyang kyuki ni.<verse eid="2CO 11:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 11:15"/>Acunakyase, ania ngsä he pi ngsungpyunkia ngsä hea kba ami kya üng jah münak vai am kya. Abäihnaka mhmüp üng ami bilawh kunga kba yah law khai he.<verse eid="2CO 11:15"/></para>
  <para style="s">Ngsä a kyaa phäha Pawluha Khuikhanak</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16"/>Ka pyen be tüki, u naw pi angkia ä na ngaih kawm. Angkia nami na ngaih üng apica ka awhcahnak vaia angki hlawka na dokham ua.<verse eid="2CO 11:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 11:17"/>Ahinkba ka pyen hin Bawipa naw a na pyensaka am kya, angkia kba awhcah lü ka pyen ni.<verse eid="2CO 11:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 11:18"/>Khyang he naw pumsa lama ami awhcaha kba awhcah law hnga süm vang.<verse eid="2CO 11:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 11:19"/>Nami mät nami themkia kyase angki he jekyai u lü nami jah doki.<verse eid="2CO 11:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 11:20"/>Khyang naw ning jah tamna na lü, ning jah jawiei lü, nami ka ning jah lawhei pe lü, ning jah hmumsit lü, ning jah kbei sepi khamei ua.<verse eid="2CO 11:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CO 11:21"/>Acun he ka jah bilawh vai kyühei veng ti lü ka ng’anei vai cun ngkekhyakei veng. Cunsepi, khyang mat mat awhcah khaia a ling üng angkia kba pyen veng, ani a linga kba kei pi ling veng.<verse eid="2CO 11:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 11:22"/>Amimi cun Hebru khyang he aw? Kei pi ka kyaki. Isarel khyang he aw? Kei pi ka kya hngaki. Abrahama mjü he aw? Kei pi ka kyaki.<verse eid="2CO 11:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 11:23"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">11:23: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:23">Ngs 16:23</ref>
      </char>
    </note> Khritawa m'ya he aw? Angkia mäiha ka pyen üng, kei daw bawkia m'yaa kya veng; khüihnak üng aktäa ka kthanaki, thawngim üng kyumnak üng däm bawkia ka kyumki, kpaihnak khawvei khamei lü, thihnak khawvei ka tawki.<verse eid="2CO 11:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="2CO 11:24"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">11:24: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 25:3">Deut 25:3</ref>
      </char>
    </note>Judah khyang he naw, thumkip ja kaw vei cia mhma vei ami na kpaih.<verse eid="2CO 11:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="2CO 11:25"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">11:25: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:22">Ngs 16:22</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ACT 14:19">Ngs 14:19</ref>
      </char>
    </note>Romah he naw kthum vei kphi ngpum am ami na kpaih, mata lung am ami na vawih, kthum vei mlawnga pyehnak ka tawki, mthan mat la mhmüp mat tui üng ka awmki;<verse eid="2CO 11:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="2CO 11:26"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">11:26: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 9:23">Ngs 9:23</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ACT 14:5">Ngs 14:5</ref>
      </char>
    </note> Ka kdung hünaka khawvei tui hea khana kyühkseki üng, m'yuk’ei hea ksunga kyühkseki üng, Judah khyanga ksunga kyühkseki üng, khyangmjükce hea ksunga kyühkseki üng, khawkhiksea ksunga kyühkseki üng, khawkhyawng khawa kyühkseki üng, mliktuia ksunga kyühkseki üng, bena phawk phawk hea ksunga kyühksekia ka khameiki.<verse eid="2CO 11:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="2CO 11:27"/>Bawngkha khüihkhawmnak, khawvei am ip lü awmnak, eiawk cawixainak, khawvei buh am einak, ngtungjinak vai la suisak vai am ve lü ka ve pängki.<verse eid="2CO 11:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="2CO 11:28"/>Acuna thea akce am pyena, sangcim he jah ngai lü a mhmüp tä se ka khuikhaki.<verse eid="2CO 11:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="2CO 11:29"/>Khyang am kyanki a awm üng am ka kyan hngaki, khyang mat katnak da a ceh üng mlung natnak am ka beki.<verse eid="2CO 11:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30"/>Ka awhcah üng pi am ka kyanaka mawng ni ka awhcahnak hlü ve.<verse eid="2CO 11:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="2CO 11:31"/>Bawipa Jesuha Pa la Mhnama ngming angläta josenak am awmki naw am ka yaileinak cun ksingki.<verse eid="2CO 11:31"/></para>
  <para style="p">
    <verse number="32" style="v" sid="2CO 11:32"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">11:32,33: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 9:23-25">Ngs 9:23-25</ref>
      </char>
    </note> Damateta ka ve k’um üng bawi Aretaha keha awmki yekap he naw ami na man vaia mlüh mkawt cun ngängki he.<verse eid="2CO 11:32"/></para>
  <para style="p">
    <verse number="33" style="v" sid="2CO 11:33"/>Acunsepi, kei cun yang üng na ktawk u lü, ngvawng khan üngka na khya u se, acuna sangpuxanga kut üngka naw ka lätki.<verse eid="2CO 11:33"/></para>
  <chapter eid="2CO 11"/>
  <chapter number="12" style="c" sid="2CO 12"/>
  <para style="s">Pawluh naw Mhmumthehnak la Mdanak a Mmuhnak</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1"/>Awhcahnak naw akdaw am a pawh üngpi awhcanak vai awmki. Cunsepi Bawipa naw a na peta hmuhthehnak la mdanak ka jah pyen khai.<verse eid="2CO 12:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 12:2"/>Khritjan khyang mat, ajana kum xaleikphyü law pängkia kcün üng khankhaw ak'hlüng säiha khüa kyaki tia ka ksingki. (Ahin hin akcang aw mhmuhthehnak aw ti cun am ksing, Mhnam däng naw ksingki).<verse eid="2CO 12:2"/></para>
  <para style="p">
    <verse number="3-4" style="v" sid="2CO 12:3-4"/>Pyen be tü veng; acuna khyang cun Paradaia khünak khamki tia ka ksingki (acuna khyang cun pumsa üng awmki aw, pumsa kaa awmki aw? ti am ksing nawng, Pamhnam däng naw ksingki), acuna khyang naw nghngicima ngthu üng am pyen thei la nghngicima m'yawng am, am pyen theia ngthu ngjaki.<verse eid="2CO 12:3-4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 12:5"/>Acuna khyanga phäh ka awhcah khai; cunsepi, ihlawka am ka ktha mahki tia thea ta kamäta phäha am awhcah veng.<verse eid="2CO 12:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 12:6"/>Ngthungtak ka pyen khaia kyase, ka awhcah hlü üng pi ka angkia am kya. Cunsepi am awhcah hlü veng, Khyang naw ami na hmuh la ami na ngjaka kthaka ami na mhlünmtai vai am ngja hlü veng.<verse eid="2CO 12:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 12:7"/>Acunüng, ka hmuh khawjah a lawa phäha ka awhcahkia am akyanak vaia, ka pumsa üng Khawyam naw khuikhanaka nghling a na pet.<verse eid="2CO 12:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 12:8"/>Acuna khuikhanak üng lätnak vaia Bawipa veia kthum vei nghui lü ktaiyü ni se,<verse eid="2CO 12:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 12:9"/>ani naw, <char style="wj">“Ka bäkhäknak na phäha khäki; ka johit naw am na kyannak kümbe saki” </char>a ti. Acunakyase, Khritawa johit ka khana a awmnak thei vaia jekyai leng leng lü am ka kyannak ka awhcah na bawk khai.<verse eid="2CO 12:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 12:10"/>Acunakyase, Khritawa phäha am kyannak, setnak, hnepeinak, mkhuimkhanak, am mkhawteinake cun ka jah ngaihki. Am ka kyan üng ni ka kyan ve.<verse eid="2CO 12:10"/></para>
  <para style="s">Pawluh naw Korintuh Khyang he a jah Ng’änak</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11"/>Angkia kba ka awmki, acunkba nami na vesaki ni. Nangmi cun keia dawnak nami mdan khaia nami kyaki ni. Kei cun ia am ka kya üng pi nami ngsä kkü hea kthaka ka jaw bawkia am kya.<verse eid="2CO 12:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 12:12"/>Ngsäa ka kyanak msingnak vaia müncankse he la cäicatnak he khawkän cun mlung msaünak am nami ksunga pawh pänga kyaki.<verse eid="2CO 12:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 12:13"/>Ngui am nami na kpüi vaia am ka ning jah kthähki. Acuna phäha sangcim kce he ka jah ksenaka kthaka nangmi veia akse ka biloki aw? Am kümkawinak na mhlätei ua.<verse eid="2CO 12:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14"/>Hin hin nami veia ka lawnak vaia ka ngcüngceinak akthumnaka kya ve; nami veia i ka thäp vai am ve. Nangmi ni ka ning jah hlüei, ngui am ni. Cana naw nupa i am pe khawi. Nupa naw ni cana a pet khawi.<verse eid="2CO 12:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 12:15"/>Ka ning jah kpüinak vaia ta ka tak avan la kamät pi summang vai üng pi ka jekyai khai ni. Ka ning jah jawngnak lawa phäha apica däng nami na jawng na khai aw?<verse eid="2CO 12:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 12:16"/>Am ka ning jah kbawngkhaki ti nami ksing khai. Cunsepi khyang naw hleihlaknak am ka ning jah mhleimhlakia ngai khai ni.<verse eid="2CO 12:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 12:17"/>Ngsä he nami veia jah tüi law lü nami ka amdanga ka yaheiki aw?<verse eid="2CO 12:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="2CO 12:18"/>Tihtuh nghui na lü, ani mah mah am atänga jumeiki mat ka tüih law. Tihtuh naw amdanga nami ka ning jah yahei peki aw? Atänga kani mlung täng se kani awmkia am kyaki aw? Lam mat üng kani citkia am kyaki aw?<verse eid="2CO 12:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19"/>Nami ma ka cangnak vaia ngthu ka pyeneikia nami na ngaiki aw? Khritaw üng Pamhnama hmuha ni ngthu kami pyen ve. Cunsepi, ka püi he aw, ahmäi hin nangmia kyäpnak vaia ni akya ve.<verse eid="2CO 12:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 12:20"/>Ka law üng am ka ngjakhlüa a na ve u lü, kei pi am nami na ngjakhlü vai naw na ähei ve. Ngvawk ngpyeinak, ng’eihnak, mlung sonak, mäta malam vai kthanak, ngsekhanak ja khyanga mawng pyeneinak, awhcahnak la am mawngmeikia awmihnake ka jah hmuh law vai naw na ähei ve.<verse eid="2CO 12:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="2CO 12:21"/>Nami veia ka law be üng Pamhnam naw nami ma a na ksenak vai kyüh veng. Ajana am dawkyakia hüipawmnak la mtisa hlükawa awmihnak am kakawng u lü ä ngjutki hea phäha Pamhnam naw na kse na se ka kyah law vai naw na ähei ve.<verse eid="2CO 12:21"/></para>
  <chapter eid="2CO 12"/>
  <chapter number="13" style="c" sid="2CO 13"/>
  <para style="s">Anghnu säiha Mcäinak la Hnuksetnak</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">13:1: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 17:6">Deut 17:6</ref>; <ref loc="DEU 19:15">19:15</ref></char>
    </note>Nami veia ka lawnak vai hin tuhkbäih akthum veinaka kyaki. “Ksingki nghngih la nghngiha dämkia saksi am cangki ti cun mdan vai” tia cangcim naw pyenki.<verse eid="2CO 13:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 13:2"/>Ajana kakawngkie la akce he pi ka jah mtheh vai ngaih veng; nami veia anghngiha ka law üng ka pyenki. Cunsepi athuknaka ve lü ka pyen beki. Tuha ka law be üng upi mkhuimkhanak üng ä lät khai.<verse eid="2CO 13:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 13:3"/>Khritaw naw kei üng ngthu pyenki tia msingnak nami yah khai. A ning jah mcing üng am kyankia am kya; a johit nangmi üng ngdangsak khai.<verse eid="2CO 13:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 13:4"/>Khritaw cun am kyannak am kutlamktung üng thi se pi, Pamhnama johit am xüngki. Ani üng keimi pi am kami kyanki; cunsepi nangmi üng Pamhnama johit am a xünak cun mi yumeipüi hngaki.<verse eid="2CO 13:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5"/>Jumnak üng nami xüngki ti cun namimät naw namimät ngcetei ua. Jesuh Khritaw nangmi üng xüngki ti cun akcanga nami ksingeiki. Jesuh Khritaw am nami yahei üng ani üng ä nami xüngki ti am nami ksingki aw?<verse eid="2CO 13:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 13:6"/>Keimi cun am kami sungki tia nami ksing khaia ning jah jum veng.<verse eid="2CO 13:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 13:7"/>Am dawki am nami pawhnak vaia Pamhnama veia kami ktaiyü hin kami ngnängnak kami mdan vaia phäh am kya, akdaw nami pawhnak vaia ni akya ve; sungkia mäih kami kya üng pi.<verse eid="2CO 13:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 13:8"/>Ngthungtak hnengkia i am kami bilo theiki. Ngthungtaka phäha ni kami bilawh ve.<verse eid="2CO 13:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="2CO 13:9"/>Am kami ktha mah üng kami jekyaiki, acunsepi nangmi nami kthamahki. Nami kümbe law vaia pi kami ning jah ktaiyü peki.<verse eid="2CO 13:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 13:10"/>Acunakyase ni nami veia hinkba ca ka yuk law ve; nami veia ka pha law üng Bawipa Jesuh naw a na peta ana am, am ning jah pyenksenak vaia. Bawi Jesuh naw a na peta ana cun ning jah kpyehnak vaia am kya lü, ning jah pyanthamnak vaia ni a kya ve.<verse eid="2CO 13:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11"/>Acunüng atuh, ka püi he aw, yai lü ve u! Kümkawinak, dim’yenak, mlunga tängnak, mlungmthin mat am ve u; jawng'engnak la dim’yenaka Pamhnam nami veia ve khai.<verse eid="2CO 13:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12"/>Mat la mat dim’yekia mhnamnak am nghnukset kyu ua. Pamhnama khyang he naw hnusetnak ning jah kbi law ve u.<verse eid="2CO 13:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 13:13"/>Bawipa Jesuh Khritawa bäkhäknak, Pamhnama jawng'engnak, la Ngmüimkhya Ngcima awmpüinak nami vana khana awm se.<verse eid="2CO 13:13"/></para>
  <chapter eid="2CO 13"/>
</usx>
