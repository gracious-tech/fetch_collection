<?xml version="1.0" encoding="UTF-8"?>
<usx version="3.0">
  <book code="GAL" style="id">Dai-Chin: Bible Translation 1st Edition</book>
  <para style="ide">Unicode (UTF-8)</para>
  <para style="h">Kalatih</para>
  <para style="toc1">KALATIHEA veia Pawluha Cayuk</para>
  <para style="toc2">Kalatih</para>
  <para style="toc3">Kal</para>
  <para style="mt1">KALATIH</para>
  <para style="mt2">hea veia Pawluha Cayuk</para>
  <para style="imt">Pyenhlüma</para>
  <para style="ip">Khyangmjükce he veia Jesuha mawng thangkdaw sang la dokhama kya lawkia kyase, khyang naw Khritjan kcanga akya lawnak vaia Mosia thum läk khai aw, tia ngthähnak ve lawki. Pawluh naw Khritaw üng xünnak kcang cun jumeinak am kya lü, acun am ni avan Mhnam üng ngsungpyuna akya ve; Mosia thum am hlü ktung naw tia mtaiki. Acunsepi Asah khaw, Romah hne, Kalatih sangcim he üngka khyang avang he naw Pawluh kehlan u lü, ‘Khyang naw Pamhnam üng a ngsungpyun hlü üng Mosia thum pi a läk vai hlüki’ tia pyenki awm lawki he.</para>
  <para style="ip">Kalatih khyang hea veia Pawluha cayuk cun am hmankia mtheimthangnak naw lam a jah hmapüi he, jummeinak kcang üng jah lawpüi be vaia yuka kyaki. Pawluh naw amät cun Jesuh Khritawa ngsä kcanga a kyanak üngka naw tünei lü pyenki. Pawluh naw amät ngsäa kya khaia Mhnam naw a khünak cun Mhnam üngka naw lawki, nghngicima ana üngka naw lawkia am kya, a mission cun aktunga khyangmjükce he veia kyaki ti pyenki. Acunüng khyang cun jumnak däng am ni Mhnam üng a ngsungpyun ve tia a mtainak däm saki. A khupnaka kyange üng Pawluh naw, Khritjan hea ngsungnak cun Khritaw jumeinaka jawngnak üngka naw awm ip lawki tia mdanki.</para>
  <para style="iot">Amawng Ktawi he</para>
  <para style="io1">Pyenhlüma <char style="ior">(<ref loc="GAL 1:1-10">1:1-10</ref>) </char></para>
  <para style="io1">Ngsä kba Pawluha ana <char style="ior">(<ref loc="GAL 1:11-2:21">1:11—2:21</ref>) </char></para>
  <para style="io1">Pamhnama bäkhäknak Thangkdaw <char style="ior">(<ref loc="GAL 3:1-4:31">3:1—4:31</ref>) </char></para>
  <para style="io1">Khritjana lätlangnak la Khritjana khutma <char style="ior">(<ref loc="GAL 5:1-6:10">5:1—6:10</ref>) </char></para>
  <para style="io1">Khüpnak <char style="ior">(<ref loc="GAL 6:11-18">6:11-18</ref>) </char></para>
  <chapter number="1" style="c" sid="GAL 1"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1"/>Nghngicim üngka naw lawkia am kya lü, nghngicima phäha pi am kya lü, Jesuh Khritaw mtho beki Pa Pamhnam la Jesuh Khritaw üngka kei Pawluh la,<verse eid="GAL 1:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 1:2"/>ka hlawnga awmkia jumeiki he naküt naw Kalatiha awmkia sangcim he ning jah hnukset ve ung:<verse eid="GAL 1:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3"/>Mi Pa Pamhnam la Bawipa Jesuh Khritaw naw bäkhäknak la dim’yenak ning jah pe se.<verse eid="GAL 1:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4"/>Mi Pamhnam la mi Pa ngjakhlüa, tuhkbäih ahina kcün kse üngka naw a jah mhlätnak vaia, Khritaw naw mi katnak hea phäha amät ngpe kyuki;<verse eid="GAL 1:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 1:5"/>Pamhnama veia hlüngtainak angläta ve se! Amen.<verse eid="GAL 1:5"/></para>
  <para style="s">Thangkdaw mat Däng</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6"/>Khritawa bäkhäknak üng<note caller="+" style="f"><char style="fr" closed="false">1:6: </char><char style="fq" closed="false">Khritawa bäkhäknak üng; </char><char style="ft" closed="false">avang üng </char><char style="fq" closed="false">a bäkhäknak üng </char><char style="ft" closed="false">tia ami yuk.</char></note> ning jah khüki yawk u lü, thangkdaw akce nami dokhamei naw na m’yühei ve.<verse eid="GAL 1:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 1:7"/>“Thangkdaw akce” am ve. Khyang avang naw ning jah mlung mthüiei u lü Khritawa thangkdaw thuhlai hlüsaki he pi ami awma phäha ahikba ka pyen ni.<verse eid="GAL 1:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 1:8"/>Cunsepi, keimia pi kyase, khankhaw üngka khankhawngsäa pi kyase nami veia kami pyena thangkdawa kthaka hngalangeikia thangkdaw a pyen üngta, mulaimei däa mkateia kya kawm.<verse eid="GAL 1:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GAL 1:9"/>Kami ning jah mtheh päng, tuhkbäih ning jah mtheh law be vang: “Nami yah pänga thangkdawa kthaka thangkdaw akce ning jah mtheh lawki a awm üngta mulaimei däa mkateia kya kawm.”<verse eid="GAL 1:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10"/>Khyanga ngak ka yahnak vaia ka pyenkia mäi lawki aw? Acukba am ni! Mhnama ngaknak ni ka ngjak hlü. Khyang hea ksunga ka ngminga ngthang vai ka ktha naki aw? Acukba ka ni üngta Khritawa m'ya am ka kya khai.<verse eid="GAL 1:10"/></para>
  <para style="s">Pawluh Ngsä a kyanaka Mawng</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11"/>Ka püi he aw, thangkdaw ka sang hin nghngicim khyang üngka ngthuha am kya naw ti ning jah mtheh veng.<verse eid="GAL 1:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 1:12"/>Nghngicim khyang üngka ka yahkia am kya, u naw pi am na mthei naw. Jesuh Khritaw amät naw a na mdana ni akya ve.<verse eid="GAL 1:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:13: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:3">Ngs 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>,<ref loc="ACT 22:5">5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char>
    </note>Judah hea jumeinak ka läk k’um üng Pamhnama sangcim he ä jah m’yenei lü jah mkhuimkha lü jah kpyeh vaia ka kthanak khawi cen nami ngjaki.<verse eid="GAL 1:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 1:14"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:14: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 22:3">Ngs 22:3</ref>
      </char>
    </note>Judah hea jumeinak lama kei cun ka ngtehpüi hea kthaka pi ktha na bawk lü, mi pupa hea thumcame üng pi ka ng’apei bawki.<verse eid="GAL 1:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:15,16: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 9:3-6">Ngs 9:3-6</ref>; <ref loc="ACT 22:6-10">22:6-10</ref>; <ref loc="ACT 26:13-18">26:13-18</ref></char>
    </note>Acunsepi am ka hmi law ham üng Pamhnam naw a bäkhäknak am na xü lü amät ka khüih khaia a na khü päng.<verse eid="GAL 1:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 1:16"/>Ka veia a capa a mdan law üng Khyangmjükce hea veia amäta mawng thangkdaw ka sangnak vaia ua mcäinak am kthäh nawng,<verse eid="GAL 1:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 1:17"/>keia kthaka ngsäa kya maki he ka jah hmu khaia Jerusalema pi am cit nawng. Arab khawa cit ktäih lü acunüng Damatet khawa ni ka nghlat be ve.<verse eid="GAL 1:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 1:18"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">1:18: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 9:26-30">Ngs 9:26-30</ref> </char>
    </note>Acunüng, kum kthum ngsawk se Pitaa veia ksingkhyapnak ka yah khaia Jerusalem khawa hang cit lü acuia ania hlawnga mhmüp xaleimhma ka awmki.<verse eid="GAL 1:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 1:19"/>Bawipaa na Jakuk dänga thea ngsä akce u am jah hmu nawng.<verse eid="GAL 1:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20"/>Nami veia ka yuk law hmanki. Am ka hleihlak Pamhnam naw ksingki.<verse eid="GAL 1:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21"/>Acun käna Siria khaw la Kilikih khawa ka citki.<verse eid="GAL 1:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 1:22"/>Acuna kcün üng Judah khawa sangcim he naw akhyang puma am na ksing ham u.<verse eid="GAL 1:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 1:23"/>“Ajana jah mkhuimkha khawi lü, ajana a kpyeh hlü khawia jumnak cen sang hü ve” ti khyang hea pyen ngja u lü,<verse eid="GAL 1:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 1:24"/>acunüng, keia phäha Pamhnam mküimtoki he.<verse eid="GAL 1:24"/></para>
  <chapter eid="GAL 1"/>
  <chapter number="2" style="c" sid="GAL 2"/>
  <para style="s">Pawluh la Ngsä Akce he</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">2:1: </char>
      <char style="xt" closed="false">
        <ref loc="ACT 11:30">Ngs 11:30</ref>; <ref loc="ACT 15:2">15:2</ref></char>
    </note>Acunüng, kum xaleikphyü angvei käna Tihtuh pi cehpüi lü, Banabah am Jerusalem khawa kani hang cit beki.<verse eid="GAL 2:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 2:2"/>Pamhnam naw ka ceh vaia mdanak na mhmuh se ka citkia kyaki. Khyangmjükce he veia ka sang khawia thangkdaw cun angvai he veia pi ngbämnaka ka jah mtheh khaiki. Ajana kcün üng ka bilawh pänga pi kyase atuh ka bilawha pi kyase amdanga akya vai am ka ngaiki.<verse eid="GAL 2:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 2:3"/>Ka hlawnga awmki, Tihtuh cun Krik khyanga kyase pi amthuia a vun am mawihsak u.<verse eid="GAL 2:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 2:4"/>Avang naw ta a vun mawih vai ami täng. Khritaw Jesuh üng kami taka lätnaka mawng hmu khai hea jumeiki hlawk hlawka ahina khyang he kami ksunga anghmüa lutki he. Tamna ami jah pawh hlü.<verse eid="GAL 2:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 2:5"/>Cunsepi thangkdaw, ngthungtak cun sungkham akyanak vaia phäha asängca hman pi ami ngthua keha am awm u nawng.<verse eid="GAL 2:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 2:6"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">2:6: </char>
      <char style="xt" closed="false">
        <ref loc="DEU 10:17">Deut 10:17</ref>
      </char>
    </note>Mkhawnga kya kyaw u sepi keia phäha ta ami hngalangnak am ve. Pamhnam naw akpung da teng lü ä mtaiki. Khyang ngvai hea veia ka pyen hlü ta, “Akthai mcäinak keia phäha am hlü.”<verse eid="GAL 2:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 2:7"/>Mhnam naw Pita Judah he veia thangkdaw sang khaia khutbi a peta kba, kei pi ani naw khyangmjükce he veia thangkdaw sangnak khut a na petia hmuki he.<verse eid="GAL 2:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 2:8"/>Judah he phäha Pita ngsäa mcawna kba, kei pi Pamhnama johit am khyangmjükce he phäha ngsäa mcawna ka kyaki.<verse eid="GAL 2:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GAL 2:9"/>Mkhawnga ami jah ngaih Jakuk, Pita la Johan naw, Pamhnam naw ahina khutbi kei üng pi na peki ti ngsingsaki he. Acunakyase kami van kami khüi hmaihki ti msingnak vaia Banabah la kei jah hnuksetki he. Banabah la kei khyangmjükce he ksunga khutbi pawh ning se amimi cun Judah he ksunga khutbi pawh khai hea kami mkhyäpki.<verse eid="GAL 2:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 2:10"/>Ami ksunga khuikha m'yenkseki he jah süm nglät vaia avan naw ami jah mcäi, acuna khutbi cun ka pawh vaia kamät naw pi akcüka ka bü kunga kyaki.<verse eid="GAL 2:10"/></para>
  <para style="s">Pawluh naw Pita Antioka a Ksenak</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11"/>Acunüng, Pita Antioka law se khyang he maa ka ksenak. Hma kungkia kyase ni.<verse eid="GAL 2:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 2:12"/>Jakuka jah tüih lawa khyang hea am ami pha law ham üng Pita cun jumeiki khyangmjükce am atänga ei hmaihki. Acunsepi khyang hea pha law käna, vun mawih vai ktungnaki he jah kyüh lü khyangmjükce he hlawnga am ei lü pyaiki.<verse eid="GAL 2:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 2:13"/>Jumeikia Judah khyang he pi Pita am atänga yailei hnga u lü awmki he naw Banabah pi yaileina u se ami hlawnga ngkhawki.<verse eid="GAL 2:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 2:14"/>Thangkdaw üng am ami cehcawn ka jah ksing law üng Pitaa veia, “Nang Judah khyanga na kyaki cunsepi Judah khyanga mäiha am xüngsei lü khyangmjükce hea mäiha na xüngseiki. Acunüng ihawkba khyangmjükce he Judah khyang hea kba xüngsei khai hea amthuia na jah ngtünsaki ni?” ti lü avana ma ka pyen.<verse eid="GAL 2:14"/></para>
  <para style="s">Judah he la Khyangmjükce he pi Mumeinak am Küikyana kyaki he</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15"/>Khyang he naw “Khyangka khyangmjükcea” ami jah suia kba am kya u lü, akcanga Judah khyanga kami hmi lawki.<verse eid="GAL 2:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 2:16"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">2:16: </char>
      <char style="xt" closed="false">
        <ref loc="PSA 143:2">Sal 143:2</ref>; <ref loc="ROM 3:20">Rom 3:20</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ROM 3:22">Rom 3:22</ref>
      </char>
    </note> Cunsepi khyang cun Thuma pyen a pawhnak am ngdüngdaikia am kya lü, Jesuh Khritaw a jumeinak däng am ni ngdüngdaikia akya ve. Keimi pi Khritaw kami jumnak am Pamhnam üng kami ngsungpyun khaia Khritaw Jesuh kami jumeiki. Thum kami läka phäha am kya. U pi Thuma ti pawh lü am mi ngsungpyun thei.<verse eid="GAL 2:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 2:17"/>Acunüng Khritaw üng Pamhnama veia ngsungpyun vai kami kthanaka phäha Khyangmjükce he mäiha khyangka kami kya hngaki aw? Khritaw cun mkhyekat jah pawh sakia kyaki aw? Am kya.<verse eid="GAL 2:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 2:18"/>Ka kpyeh pänga Thuma ninge läk vaia ka tünei be üngta, kamät cun khyang hea veia Thum kpyehkia ka ngdan saki ni.<verse eid="GAL 2:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 2:19"/>Thuma awma küt üng kei cun ka thiki. Isetiakyaküng Thum naw a na hnima kyaki. Acun cun Pamhnama phäha ka xünseinak vaia phäha kyaki ni. Kei cun Khritaw am atänga ania kutlamktunga khana ka thiki.<verse eid="GAL 2:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 2:20"/>Acunakyase kamät am xüng ti veng. Khritaw kei üng xüngki. Atuh ka xünak cun na mhläkphya na lü amäta xünak na pekia Pamhnama Capa ka jumnak am ni ka xün ve.<verse eid="GAL 2:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 2:21"/>Pamhnama bäkhäknak am ma veng. Thuma phäha ngdüngdainak yah theia akya üng Khritaw amdanga thikia kya khai.<verse eid="GAL 2:21"/></para>
  <chapter eid="GAL 2"/>
  <chapter number="3" style="c" sid="GAL 3"/>
  <para style="s">Jumnak la Thum</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1"/>Nangmi Kalatih khyang k’ang he aw! u naw a ning jah mhleimhlak ni? Nami mika hmuh yea Jesuh Khritaw kutlamktung üng a thiha mawng angsinga mdana kya ye se.<verse eid="GAL 3:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 3:2"/>Thuma pyen nami läka phäha Pamhnama Ngmüimkhya nami yahki aw? Thangkdaw ngja u lü nami jumeia phäha Pamhnama Ngmüimkhya nami yahki aw? Ning jah kthäh veng na mtheh ua.<verse eid="GAL 3:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 3:3"/>Ihlawka nami yawki ni! Pamhnama Ngmüimkhya am tünei u lü atuh nami mäta khyaihnak am nami kpäng vai nami ngja hlüki aw?<verse eid="GAL 3:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 3:4"/>Nami hmuh ngjak he avan amdanga kyaki tinak aw? Iyaw hlenga ta kya vü.<verse eid="GAL 3:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 3:5"/>Pamhnam naw Ngmüimkhya ning jah pe lü khutbi bi lü, müncan he nami ksunga a jah mdan hin Thum nami läka phäha aw, am acunüng thangkdaw ngja u lü nami jumeia phäha aw?<verse eid="GAL 3:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:6: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 15:6">Gen 15:6</ref>; <ref loc="ROM 4:3">Rom 4:3</ref></char>
    </note>Abrahama mawng cen ngai süm u; “Pamhnam jum se, a jumnaka phäha Pamhnam naw ngdüngdaikia a ngaih pet” tia cangcim üng a ng’yuka kba.<verse eid="GAL 3:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 3:7"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:7: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:16">Rom 4:16</ref>
      </char>
    </note>Acunakyase Abrahama cana kcang he cun jumnak takia khyanga kyaki he ti cun nami süm vai sü.<verse eid="GAL 3:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 3:8"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:8:</char>
      <char style="xt" closed="false">
        <ref loc="GEN 12:3">Gen 12:3</ref>
      </char>
    </note> Pamhnam naw khyangmjükce he ami jumnak am amät üng jah ngdüngdaisak khai tia cangcim naw pyen khawiki. Acunakyase cangcim naw, “Pamhnam naw nang üngka naw khyangmjü naküt dawkyanak jah pe khai” tia Abrahama veia thangkdaw a sang cen.<verse eid="GAL 3:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GAL 3:9"/>Acunakyase Abraham naw jumei lü dawkyanak a yaha kba; jumeiki naküt naw dawkyanak yah hngaki he.<verse eid="GAL 3:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:10:</char>
      <char style="xt" closed="false">
        <ref loc="DEU 27:26">Deut 27:26</ref> (LXX) </char>
    </note>Thum üp na u lü läkie cun yüncenaka keha awmki he. Isetiakyaküng, “Thum cauk üng ng’yuki naküt am läki naküt cun Pamhnama yüncenaka keha awmki” tia cangcim naw a pyena phäha kyaki.<verse eid="GAL 3:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 3:11"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:11: </char>
      <char style="xt" closed="false">
        <ref loc="HEB 2:4">Heb 2:4</ref>
      </char>
    </note>“A jumnaka phäh Pamhnam naw a ngdüngdaisaka khyang däng ni a xün khawm” tia cangcim üng ng’yukia kyase, u pi Thum läka phäha Pamhnama vei ä ngsungpyunki ti ngsingki.<verse eid="GAL 3:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 3:12"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:12: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 18:5">Lev 18:5</ref>
      </char>
    </note>Thum cun jumnak üng am sengei. “Thuma ti naküt läki xüng khai” tia ni cangcim naw a pyen ve.<verse eid="GAL 3:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:13:</char>
      <char style="xt" closed="false">
        <ref loc="DEU 21:23">Deut 21:23</ref>
      </char>
    </note>“Thing üng taih naküt cun Pamhnama yüncea kyaki” tia cangcim naw a pyena kyase, mi phäha Khritaw amät yüncea ngpawh kyu lü Thuma lawpüia yüncenak üngka jah thawngki.<verse eid="GAL 3:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 3:14"/>Pamhnam naw Abrahama veia a khyütam cen khyangmjükce he naw pi Khritaw Jesuh üngka ami yahnak hnga vaia, Khritaw naw ahin a pawha kyaki. Acunüng Pamhnama khyütamnaka Ngmüimkhya cun mimi naw pi jumnak am mi yahnak hnga vaia kyaki.<verse eid="GAL 3:14"/></para>
  <para style="s">Thum la Khyütam</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15"/>Ka püi he aw, msuimcäpnak am ka pyen khai: khyang nghngih naw iyaw ngaisim ni lü khyütam ani pawh käna u naw am kpyeh thei, mkhahsia pi am kya khawi.<verse eid="GAL 3:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 3:16"/>Pamhnam naw Abraham la a mjükphyüia veia khyütam pawhki. Ngthungcim naw khawjah a pyena kba, “Mjükphyüiea” tia am kya lü khyang mat däng pyena kba, “Mjükphyüia” tia ni akya ve. Acun cun Khritawa kyaki.<verse eid="GAL 3:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 3:17"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:17 </char>
      <char style="xt" closed="false">
        <ref loc="EXO 12:40">Ex 12:40</ref>
      </char>
    </note> Ka pyen hlü cun: Pamhnam naw Abrahama veia ngthumkhän ta lü acun kümsak khaia khyütam pawhki. Kum phyakphyü la thumkip käna peta Thum naw Pamhnama ngthumkhän am kpyeh thei. Pamhnama khyütam pi am pyaisak thei.<verse eid="GAL 3:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 3:18"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:18: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:14">Rom 4:14</ref>
      </char>
    </note> Pamhnama khawh yet hin Thum üng sengkia akya üng Pamhnama khyütam üng sengkia am kya hlü ti ve. Acunsepi a khyütama phäha ni Pamhnam naw acuna khawh yet cun Abraham üng a pet ve.<verse eid="GAL 3:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19"/>Acunüng Thum cun ia ham vai ni? Katnak cun katnaka kyaki ti mdan khaia kyaki. Thum cun khyütam pet Abrahama mjükphyüia pha law däa khäng khaia pawha kyaki. Thum cun khankhawngsä naw ngsä mata kut üng a peta kyaki.<verse eid="GAL 3:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 3:20"/>Acunsepi khyang mat däng a bawi üng ngsä mat am hlü ti; Mhnam ta mat däng<note caller="+" style="f"><char style="fr" closed="false">3:20 :</char><char style="fq" closed="false">Mhnam mat däng; am acunüng Mhnam amät däng naw biloki. </char></note> ni.<verse eid="GAL 3:20"/></para>
  <para style="s">Thuma Khutbi</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21"/>Am acunüng Thum naw Pamhnama khyütam he jah tuki aw? Am jah tu! Nghngicim naw xünak a yahnak vai Thum yahkia akya vai sü, khyang naküt naw Thum läklam lü Pamhnama veia ngdüngdai khai su.<verse eid="GAL 3:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 3:22"/>Cunsepi cangcim naw, “Khawmdek avan cun katnak johita keha awmki; Jesuh Khritaw jumei phäha yah vai aphu ka a jah yeta khyütam cun jumeiki he üng jah peta kyaki” a ti.<verse eid="GAL 3:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23"/>Cunsepi jumeinaka kcün am a pha law ham üng, jumeinak a ngdang law veicäpa Thum naw thawngkyuma mäiha jah küpki.<verse eid="GAL 3:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 3:24"/>Acunakyase jumeinak üng Pamhnama veia mi ngdüngdainak vaia, Khritaw am a pha law ham üng Thum naw jah ngkhapüikia kyaki.<verse eid="GAL 3:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GAL 3:25"/>Atuh jumeinaka kcün pha lawki. Thum naw am jah ngkhahpüi ti.<verse eid="GAL 3:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26"/>Jumnak am Khritaw Jesuh üng Pamhnama ca nami kya bäihki.<verse eid="GAL 3:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GAL 3:27"/>Khritaw üng baptican nami khanki; amät Khritaw nami suiawiki ni.<verse eid="GAL 3:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 3:28"/>Acunakyase Judah khyang ja khyangmjükce he, m'ya la ä m'ya, nghnumi he la kpamie hngalangnak am awm; Jesuh Khritaw üng nami van pum mata nami kyaki.<verse eid="GAL 3:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GAL 3:29"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">3:29:</char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:13">Rom 4:13</ref>
      </char>
    </note>Khritawa ka nami kya üng Abrahama mjükphyüi hea kya u lü Pamhnama khyütam nami yah khai.<verse eid="GAL 3:29"/></para>
  <chapter eid="GAL 3"/>
  <chapter number="4" style="c" sid="GAL 4"/>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1"/>Cunsepi, hin kba pyen be tü veng: a pa khawh mkhäm khaia ahmäi cun capa a ka vai kyase pi a nghmaw ham üng cun m'ya mäiha ni ngaih khawi.<verse eid="GAL 4:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 4:2"/>A nghmaw ham üng a pa naw a mhnütnaka kcün am a pha ham üng msumcei khaia khyang he awmki he.<verse eid="GAL 4:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 4:3"/>Acukba mimi pi ngmüimkhya lama am mi xüxam ham üng cun khawmdek ukia ngmüimkhya he keha m'ya mi kyaki.<verse eid="GAL 4:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 4:4"/>Cunsepi akcüna pha law üng Pamhnam naw amäta Capa a tüih law. Nghngicim nghnumia capa mäiha law lü Judah he Thuma keha xüngseiki,<verse eid="GAL 4:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 4:5"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:5-7: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 8:15-17">Rom 8:15-17</ref>
      </char>
    </note> Thuma keha awmki he jah thawng se, Pamhnama ca he mi kya lawnak vaia kyaki.<verse eid="GAL 4:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 4:6"/>A ca he nami kyanak mdanak vaia Pamhnam naw a Capaa Ngmüimkhya cun nami mlung k’uma a tüih law. Acuna Ngmüimkhya naw, “Ka Pa, ka Pa” tia ngpyangki.<verse eid="GAL 4:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 4:7"/>Acunakyase m'yaa am kya ti u lü capa nami kyaki. A capa nami kya pängkia kyase Pamhnam naw a capaa phäh vai a tak avan ning jah pe khai.<verse eid="GAL 4:7"/></para>
  <para style="s">Pawluh naw Kalatih Khyang he a jah Cäinak</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8"/>Tuhkbäih Pamhnam nami ksingki am acunüng Pamhnam naw ning jah ksingki ti veng. Ise a ktha kcek lü m'yenei phyakia ngmüimkhya veia nami nglat be vai nami ngaihki ni.<verse eid="GAL 4:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GAL 4:9"/>Mhnam nami ksing kän la Mhnam naw a ning jah ksing käna, Ise am ktha mah lü m'yenei phyakia ngmüimkhya veia nami nghlat be vai nami ngaihki ni ti pyen hlü veng? Ise acun hea m'ya nami kya vai cun nami ngaih beki ni?<verse eid="GAL 4:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 4:10"/>Khawmhmüp he, nghngi khya he, akcün he la khawkum he, nami jah künaki.<verse eid="GAL 4:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 4:11"/>Ning jah cäi na veng! Nami phäha ka kthanak avan amdanga kya khai aw?<verse eid="GAL 4:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12"/>Ka püi he aw, “Keia mäiha awm u” tia ning jah nghui na veng. Nangmia mäih ka lawki. Akse ka khana nami bi am ve.<verse eid="GAL 4:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 4:13"/>Akcüka nami veia ivai thangkdaw ka pyen ni ti cen süm ua; am ka phetyaia phäha kyaki ni.<verse eid="GAL 4:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 4:14"/>Ka pumsa üng am ka phetyainak cen nami hama khameinaka kyase pi am na hmumsit u lü, am nami na yawkinki. Khankhaw üngka khankhawngsä mata mäiha nami na dokhamki. Jesuh Khritawa mäiha nami na dokhamki.<verse eid="GAL 4:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 4:15"/>Aktäa nami jekyaiki! Ise ni? Akya thei vai sü ta nami mik pi lo u lü nami na pe khai sü ti kamät naw pyen thei veng.<verse eid="GAL 4:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 4:16"/>Ngthungtak ka ning jah mtheha phäha nami yea ka kya lawki aw?<verse eid="GAL 4:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17"/>Khyang kce he naw ning jah kü na leng lengkia mäiha awmki he, cunsepi ami ning jah künak am daw. Ami ning jah künaka kba nami jah künak be vaia phäha kei üngka ning jah mtai hlü ve u.<verse eid="GAL 4:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 4:18"/>Bünak a daw üng ta künak hin dawki ni. Nami hlawnga ka awma kcün däng üng am kyakia nami hlawnga am ka awm üng pi.<verse eid="GAL 4:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 4:19"/>Ka cana he aw, Khritawa ngneiksak nangmi üng am a awm hama küt üng ta nghnumi naw a ca law vai üng a huieia kba nami hama na huiei ve.<verse eid="GAL 4:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 4:20"/>Atuh nami hlawnga ka ve vai ngaih veng. Ahin kba am ka ning jah tinak vai sü. Aktäa ning jah cäi na veng.<verse eid="GAL 4:20"/></para>
  <para style="s">Hakarah la Sarah am Msuimcäpnak</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21"/>Thuma keha awm hlüki he ning jah kthäh vang: Thum naw i a pyen am nami ngjaki aw?<verse eid="GAL 4:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 4:22"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:22: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 16:15">Gen 16:15</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="GEN 21:2">Gen 21:2</ref>
      </char>
    </note>Abraham naw cangpyang nghngih ca naki. Mat m'yanua ca kya lü mat cun m'yanu am nikia ca kyaki.<verse eid="GAL 4:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 4:23"/>M'yanu am ani ca cun pumsa thuma hmi lü, m'yanu am niki am ani ca cun khyütama thuma hmi lawkia kyaki tia pyenki.<verse eid="GAL 4:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 4:24"/>Acuna ngthu cun msuimcäpnaka kyaki ti ksing theia kyaki; acuna nghnuminu xawi cun ngthumkhän nghngiha kyaki xawi. M'ya jah ca nakia nghnumi Hakarah cun Sinai mcung üng pawha ngthumkhäna kyaki.<verse eid="GAL 4:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GAL 4:25"/>Arab khawa Sinai mcunga nghnün üng ngdüikia Hakarah cun, tuhkbäih Jerusalem a khyang he mah mah am m'yaa kyaki msuimcäpnaka kyaki.<verse eid="GAL 4:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 4:26"/>Cunsepi khankhaw Jerusalem cun m'ya am kyakia kyase, acun cun mi nua kyaki.<verse eid="GAL 4:26"/></para>
  <para style="p">
    <verse number="27" style="v" sid="GAL 4:27"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:27:</char>
      <char style="xt" closed="false">
        <ref loc="ISA 54:1">Hesa 54:1</ref>
      </char>
    </note></para>
  <para style="q1" vid="GAL 4:27">“Na cingkia nghnumi jekyaia!</para>
  <para style="q2" vid="GAL 4:27">Na am pawi na khawi lü na hmia natnak am na khamei khawiki je lü ngpyanga!</para>
  <para style="q1" vid="GAL 4:27">A cei naw am a yawk khawia nghnumia kthaka</para>
  <para style="q2" vid="GAL 4:27">a cei naw am a ktä naw hnasen da na bawk khai” tia cangcim naw pyenki.<verse eid="GAL 4:27"/></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28"/>Acunakyase ka püi he aw, nangmi cun Isaka mäiha khyütama phäha Pamhnama ca hea nami kyaki.<verse eid="GAL 4:28"/></para>
  <para style="p">
    <verse number="29" style="v" sid="GAL 4:29"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:29: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 21:9">Gen 21:9</ref>
      </char>
    </note>Acuna kcün üng pumsa thuma hmi lawki naw Pamhnama Ngmüimkhya thuma hmi lawki a mkhuimkha khawia kba; tuhkbäih pi acuna mäih lawki.<verse eid="GAL 4:29"/></para>
  <para style="p">
    <verse number="30" style="v" sid="GAL 4:30"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">4:30: </char>
      <char style="xt" closed="false">
        <ref loc="GEN 21:10">Gen 21:10</ref>
      </char>
    </note> Cunsepi, cangcim naw, “M'yanu cun a capa am jah ksäta; m'yanua capa naw ä m'yanua capa khawh ä mkhämpüi khai” tia a pyen.<verse eid="GAL 4:30"/></para>
  <para style="p">
    <verse number="31" style="v" sid="GAL 4:31"/>Acunakyase ka püi he aw, mimi cun m'yanua ca am mi kya u lü ä m'yanua ca hea mi kyaki.<verse eid="GAL 4:31"/></para>
  <chapter eid="GAL 4"/>
  <chapter number="5" style="c" sid="GAL 5"/>
  <para style="s">Nami Lätnak Xungei u</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1"/>Lätnak mi taki. Khritaw naw jah lätsaki! Khyang kläta mäiha ngdüitho u. Namimät m'yaa ä ngpawhei be ua.<verse eid="GAL 5:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2"/>Kei Pawluh naw nami veia pyen veng, ngai ua: nami vun nami mawih üng nami phäha Khritaw amdanga kya khai.<verse eid="GAL 5:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 5:3"/>A vun mawi khaia büki cun Thum avan läk khaia leimah ve tia ning jah mtheh veng.<verse eid="GAL 5:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 5:4"/>Thum läknak am Pamhnama veia ngsungpyun khaia nami büki naw Khritaw nami thuknaki ni. Pamhnama bäkhäknaka kpunga nami awmki ni.<verse eid="GAL 5:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 5:5"/>Keimia äpnak ta Pamhnam naw amäta veia jah ngsungpyun sak khai tia kya ve. Ahin ni Pamhnama Ngmüimkhya johit naw kami jumnak üng a bilawh kami ngängeia akya ve.<verse eid="GAL 5:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 5:6"/>Khritaw Jesuh üng vun mawih la vun am mawih hngalangnak am ve. Jawng'engnak üngka pawhmsaha jumeinak ni aktunga akya vei.<verse eid="GAL 5:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7"/>Akyäpa nami pawhki cen! U naw ngthungtak nami läknak üng a ning jah pyaisak ni? Ihawkba a ning jah kdäk ni?<verse eid="GAL 5:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 5:8"/>Ahin hin ning jah khüki Pamhnama pawha am kya. <verse eid="GAL 5:8"/><verse number="9" style="v" sid="GAL 5:9"/><note caller="-" style="x"><char style="xo" closed="false">5:9: </char><char style="xt" closed="false"><ref loc="1CO 5:6">1Kor 5:6</ref></char></note>“Kcaw ajawca naw buh avan thawhsak theiki” ami tia kba.<verse eid="GAL 5:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 5:10"/>Atuh vei cäpa ka ning jah mkhü üpnaki. Nami cungaihnak ä hngalang se. Nami mlung ning jah uplatsakia khyang naküt pi Pamhnam naw mkhuimkha be khai tia mi Bawipa jumeinak üng mkhü üpnak ka taki.<verse eid="GAL 5:10"/></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11"/>Ka püi he aw, vun mawih vai hlüki tia mawng ngthu ka sang laih laihkia akya üng ise mkhuimkhaa ka kyaki ni? Acun he hmankia akya üng Khritawa kutlamktung ka sang naw khuikhanak i am pawh.<verse eid="GAL 5:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 5:12"/>Ning jah uplatsaki he naw ami vun mawih däng ä khäk lü ami kte pi ami kphyet vai täng veng.<verse eid="GAL 5:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13"/>Ka püi he aw, nami lät khaia ning jah khüa nami kyaki. Cunsepi nami läta phäha nami pumsa hlükawnak naw ä ning jah näng se. Acuna kthaka ta jawng'engnak am nami püi mcei ua.<verse eid="GAL 5:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 5:14"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">5:14: </char>
      <char style="xt" closed="false">
        <ref loc="LEV 19:18">Lev 19:18</ref>
      </char>
    </note> “Namät na jawngnaka mäiha na impei loceng na jawngnak vai” tia ngthupet mat naw Thum naküt kümsaki.<verse eid="GAL 5:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 5:15"/>Cunsepi sakyung hea kba mat la mat mhlem kyu u lü ngtun u lü nami ve vai mcei ua, mät naw mät nami kpyehei khai ni.<verse eid="GAL 5:15"/></para>
  <para style="s">Ngmüimkhya la Nghngicima Ngneisak</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16"/>Acunakyase ahikba pyen veng: nghngicim ngneiksak üng am nami yängsä khaia Ngmüimkhya naw nami xünnake lam ning jah msüm kawm.<verse eid="GAL 5:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 5:17"/>
    <note caller="-" style="x">
      <char style="xo" closed="false">5:17: </char>
      <char style="xt" closed="false">
        <ref loc="ROM 7:15-23">Rom 7:15-23</ref>
      </char>
    </note> Mi nghngicim ngneiksak naw Ngmüimkhya ngneisak ä ngja hlü se, Ngmüimkhya ngneiksak naw pi mi nghngicim ngneiksak ä ngja hlüki. Ahin xawi cun ye xawi ni. Acunakyase namäta ngjak hlü ä na bi theiki.<verse eid="GAL 5:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 5:18"/>Ngmüimkhya naw a ning jah ngkhahpüi üng Thuma keha am nami awmki ni.<verse eid="GAL 5:18"/></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19"/>Nghngicim ngneiksaka bilawh cun ngdangki. Acun he cun hüipawmnak, phyawksaknak, am dawkia ngneiksak,<verse eid="GAL 5:19"/></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 5:20"/>Juktuh sawkkhahnake la tuiyaia luhvangnake ni. Khyang he nghneng lawki he, ng’eihei lawki he, ami mlung thüi lawki, ngnütei lawki he. Ngpai law u lü ngtai lawki he;<verse eid="GAL 5:20"/></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 5:21"/>hnaihei law kyu peki he, ju aw ngenki he, hlimtui ngen u lü akce he pi jah pawhki he. Ajana ka ning jah mtheha kba atuh pi ning jah mtheh be tü veng: Ahin he jah tiki naw Pamhnama Khaw am ka na.<verse eid="GAL 5:21"/></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22"/>Cunsepi Ngmüimkhya naw jawngnak, jekyainak, dim’yenak, mlung saünak, bänak, dawnak, sitihnak,<verse eid="GAL 5:22"/></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 5:23"/>mlung hnemnak, mät la mät ngxungei kyunake cun jah ngtheipai lawsaki. Acun he jah kpetkia Thum am ve.<verse eid="GAL 5:23"/></para>
  <para style="p">
    <verse number="24" style="v" sid="GAL 5:24"/>Khritaw Jesuha khyang he naw ami nghngicim ngneiksaka mtisa hlükawnak naküt cun jah thihsak pängki he ni.<verse eid="GAL 5:24"/></para>
  <para style="p">
    <verse number="25" style="v" sid="GAL 5:25"/>Ngmüimkhya naw xünak jah pe pängki; ani naw mi xünake pi jah ngkhahpüi khai.<verse eid="GAL 5:25"/></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 5:26"/>Am mi awhcah u lü, mat la mat ä mi ngsähna lü, mat la mat ä mi ng’eih kawm.<verse eid="GAL 5:26"/></para>
  <chapter eid="GAL 5"/>
  <chapter number="6" style="c" sid="GAL 6"/>
  <para style="s">Mat la mat Kpüikpak ua</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1"/>Ka püi he aw, khyang naw katnak a pawh msawk üng, Ngmüimkhya khyanga nami kyakia nangmi naw akdawa mtho be u; cunsepi mlung hnipnak am pawh ua. Acunüng namimät pi hlawhlepnak üng am nami kyuknak vaia mceiei ua.<verse eid="GAL 6:1"/></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 6:2"/>Mat la mata bawngkhanak nglawng püi u, acunkba Khritawa Thum nami läkia kya khai.<verse eid="GAL 6:2"/></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 6:3"/>Nami mät ia am kya kphei u lü kyäp säihkia nami ngaihkyu üng ta nami mät nami yailei nakia ni akya ve.<verse eid="GAL 6:3"/></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 6:4"/>Nami mäta bilawh bükteng ua. Nami bilawh a daw üng nami mäta bilawha khana awhcah ua; khyanga bilawh am ä mtäng ua.<verse eid="GAL 6:4"/></para>
  <para style="p">
    <verse number="5" style="v" sid="GAL 6:5"/>Nami mäta phüih phäh phäh nami phüi khaia kyaki ni.<verse eid="GAL 6:5"/></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6"/>Khritjana mawngma ning mtheikia saja üng na tak akdaw na pet vai.<verse eid="GAL 6:6"/></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7"/>Namät ä mhleia; u naw Pamhnam am yaw ang sak thei. Na sawa mäih kunga na at be khai.<verse eid="GAL 6:7"/></para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 6:8"/>Na nghngicim ngneiksak hlükawa mci na saw üng acun üngka thihnak na at khai; Ngmüimkhya lama mci na saw üng Ngmüimkhya lam üngka anglät xünak na at khai.<verse eid="GAL 6:8"/></para>
  <para style="p">
    <verse number="9" style="v" sid="GAL 6:9"/>Acunakyase akdaw bilawh ä mi ngkho na vai; am mi pyai ta u lü akcüna pha law üng angtheipai mi at law khai.<verse eid="GAL 6:9"/></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 6:10"/>Acunakyase akcün kdaw mi tak ham üng khyang naküta veia akdaw mi bilo vai u; aktunga jumnak üng khuiim mata mi kyaki hea veia mi bilo ksetam vai u.<verse eid="GAL 6:10"/></para>
  <para style="s">Akbäihnaka Mcäinak la Hnuksetnak</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11"/>Kamäta kut ye am canglung angbaü ngbaüa nami veia ca ka yuk law cen teng ua.<verse eid="GAL 6:11"/></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 6:12"/>Nami vun amthuia ning jah mawih hlüsaki he cun ami bilawh kce awhcah hlü na u lü, mdan hlükia kyaki he ni. Biloki he, acunsepi Khritawa kutlamktunga phäha mkhuimkhanak am ami khamei vai dänga phäha ni akya ve.<verse eid="GAL 6:12"/></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 6:13"/>Vun mawiki he ye naw pi Thum am läk u. Pumsa üng nami bilawh ami awhcahnak vaia phäha nami vun ning jah mawih hlüsaki he ni.<verse eid="GAL 6:13"/></para>
  <para style="p">
    <verse number="14" style="v" sid="GAL 6:14"/>Kei naw ta mi Bawipa Jesuh Khritawa kutlamktung ni ka awhcahnak ve; ania kutlamktung üng hina khawmdek ka phäha thiki, kei pi khawmdeka phäha ka thiki.<verse eid="GAL 6:14"/></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 6:15"/>Vun mawih la am mawih ia am ngtäh. Mhmünmceng kthaia kya ni angtäh.<verse eid="GAL 6:15"/></para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 6:16"/>Acuna thumcam ami xünnake üng läkie la Pamhnama khyang avana khana dim’yenak la m'yeneinak ve se.<verse eid="GAL 6:16"/></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17"/>Akbäihnaka: ka pumsa khana awmkia nghmalem he naw kei Jesuha m'ya ka kyaki ti mdankia kyase u naw pi ä na mkhuimkha kawm.<verse eid="GAL 6:17"/></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18"/>Ka püi he aw, mi Bawipa Jesuh Khritawa bäkhäknak nami vana khana awm se. Amen.<verse eid="GAL 6:18"/></para>
  <chapter eid="GAL 6"/>
</usx>
