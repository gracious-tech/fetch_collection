<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHP" style="id">- Paliya</book>
  <para style="h">फीलीपीयो</para>
  <para style="toc3">फीलीपीयो</para>
  <para style="toc2">फीलीपीयो</para>
  <para style="toc1">फीलीपीयो ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="mt2">फीलीप्‌पीयों के नाम पोलुस की पत्री</para>
  <para style="mt1">फीलीपीयो ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">मसी ना पयदा हयवा ना 61 साल नी अळतेण पोलुस ने आहयी चीट्‌ठी फीलीपीयो मे रेवा वाळा भरहो करन्‌या जुगु लीखी जत्‌यार तीहयो आहयी चीट्‌ठी लीख्‌यो ता तीहयो रोम ना जेल मे हतो। <char style="xt"><ref loc="PHP 1:13">1:13</ref></char> आहयी चीट्‌ठी तीहयो तीहयी मंडळी जुगु लीख्‌यो जे फीलीपीयो मे हती। फीलीपीयो ना बारा मे आमु थोड़ु घणु नेवताळा नी कीताप सी जड़े। मकीदुनीया देस नी फीलीपीयो नी राजधानी ह़ेर हतु। आहयी मंडळी मकीदुनीया देस नी पेली मंडळी हती जे फीलीपीयो मे हती। पोलुस अने सीलास बेम जणा हय्‌न आहयी मंडळी नी सुरुवात कर्‌या जत्‌यार आहया फीलीपीयो मे हता। जत्‌यार आहया फीलीपीयो मे हता ता ईमने आखी रात जेल मे रेवा पड़्‌यु <char style="xt"><ref loc="ACT 16">नेवताळा ना काम 16</ref></char>।</para>
  <para style="ip">पोलुस नी आहयी चीट्‌ठी घणा वीच्‌यार नी हती। जत्‌यार तीहयो जेल मे हतो तत्‌यार तीहया तीने जे दान ली मोकल्‌या। तीनी लेदे तीमनो आव-भाव करवा नी लेदे आहयी चीट्‌ठी लीख्‌यो। <char style="xt"><ref loc="PHP 4:10-19">4:10-19</ref></char> जेल मे तीनी हालत कीसम हती आहयु देखाड़वा नी लेदे लीख्‌यो। अने तीमुथीयुस अने ईपफ्‌रुदीतुस ना बारा मे देखाड़े के तीहया तीमनो आव-भाव करीन तीमना पुडारी हयवा नी ईज्‌जत आपीन आवरे। <char style="xt"><ref loc="PHP 2:19-30">2:19-30</ref> </char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. फीलीपीयो नी मंडळी ने वारला से के करीन चीट्‌ठी नी सुरुवात करे। <char style="ior"><ref loc="PHP 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. अळतेण तीहयो तीनी हालत ना बारा मे कंय वेला ना बारा मे देखाड़े। <char style="ior"><ref loc="PHP 1:3-2:30">1:3–2:30</ref> </char></para>
  <para style="io1">3. अळतेण तीहयो मसी जीवाय ना लेदे वेहवार ना बारा मे ह़ीकापण आपे। <char style="ior"><ref loc="PHP 3:1-4:9">3:1–4:9</ref> </char></para>
  <para style="io1">4. तीमना भेट नी लेदे तीमने घणु वारु से कीन अने वारला से के करीन आहयी चीट्‌ठी बंद करे। <char style="ior"><ref loc="PHP 4:10-23">4:10-23</ref></char></para>
  <chapter number="1" style="c" sid="PHP 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHP 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:12">नेवताळा ना काम 16:12</ref>
      </char>
    </note>मसी ईसु नो चाकर्‌यो मे पोलुस अने तीमुथीयुस भणी गेथी, आखा भगवान ना चोखला माणहु ना नाम, जे मसी ईसु मे हय्‌न फीलीपी ह़ेर मे री र्‌या, मुखी अने सेवा करवा वाळा ने। <verse eid="PHP 1:1" /><verse number="2" style="v" sid="PHP 1:2" />अमारा बाह भगवान अने मालीक ईसु मसी भणी गेथी तमने दया अने सांती जड़ती रेय। <figure style="fig" alt="City of Philippi" file="hk00363c.tif" size="span" copy="Horace Knowles ©" ref="1:1">फीलीपीयो नु ह़ेर</figure><verse eid="PHP 1:2" /></para>
  <para style="s">वारु से केय अने मंडळी ना लेदे वीन्‌ती</para>
  <para style="p">
    <verse number="3" style="v" sid="PHP 1:3" />मे जत्‌यार-जत्‌यार तमने फोम करु, तत्‌यार-तत्‌यार आपणा भगवान ने वारु से केम, <verse eid="PHP 1:3" /><verse number="4" style="v" sid="PHP 1:4" />अने जत्‌यार कदी तमारी आखा नी लेदे वीन्‌ती करु, ता सदा खुस हय्‌न वीन्‌ती करु। <verse eid="PHP 1:4" /><verse number="5" style="v" sid="PHP 1:5" />जीसम तमु खुस-खबर ना काम मे मारी मदत पेल्‌ना दाड़े सी हमणे लग करला से। <verse eid="PHP 1:5" /><verse number="6" style="v" sid="PHP 1:6" />मने आहयी वात नो भरहो से, के जे बी तमारी मे वारला काम चालु करलो से, तीहयोत तीने ईसु मसी ना आव्‌वा ना दाड़े लग पुरु करहे। <verse eid="PHP 1:6" /><verse number="7" style="v" sid="PHP 1:7" />वारु से के मे तमारी आखा नी लेदे आसमेत वीच्‌यार करु, काहाके तमु मारा मन मे आय्‌न बह जेला से, अने हाव मे जेल मे कुंडायलो से ते बी अने खुस-खबर नी लेदे जपाप अने गवा आप्‌पा मे तमु आखा मारी ह़ाते दया मे ह़ाते से। <verse eid="PHP 1:7" /><verse number="8" style="v" sid="PHP 1:8" />आहयी वात मे भगवान मारो गवा से के मे मसी ईसुन तेम मोंग करीन तमु आखा ने भेटवा नी घणी हेर करु।<verse eid="PHP 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="PHP 1:9" />अने मे आहयी वीन्‌ती करत्‌लो, के तमारो मोंग, ह़ाचली अक्‌कल अने आखी भाती नी ह़मज भेळ अळी बी वद्‌तु जाय। <verse eid="PHP 1:9" /><verse number="10" style="v" sid="PHP 1:10" />आञे लग के तमु वारु सी वारु वातु ने मोंगाळ्‌ळी जाणो, अने मसी ना आव्‌वा ना दाड़े लग खरला बणीन रेवो, अने ठोकर ना खावो; <verse eid="PHP 1:10" /><verse number="11" style="v" sid="PHP 1:11" />अने तीहया धरमपण ना फोळ सी जे ईसु मसी ना लारे हये, भरायता जावो जीनी सी भगवान नी बड़ाय अने गुण गवायता रेय।<verse eid="PHP 1:11" /></para>
  <para style="s">जेल मे कुंडायला ना वेह मे चाकरी</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 1:12" />ए भायु, मे चाहु, के तमु आहयु जाण लेवो के मारी पोर जे वीत्‌यु, तीनी सी खुस-खबर आड़े-धेड़े बी पुग जी। <verse eid="PHP 1:12" /><verse number="13" style="v" sid="PHP 1:13" /><note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 28:30">नेवताळा ना काम 28:30</ref></char></note>आञे लग के राजघोराणा ना आखा रखवाळी करन्‌या सीपायड़ा अने तीमना आखा माणहु ने बी आहयु मालम हय ज्‌यु के मे ईसु मसी नो चाकर्‌यो हयवा नी कारण जेल मे कुंडायलो से, <verse eid="PHP 1:13" /><verse number="14" style="v" sid="PHP 1:14" />अने मालीक मे जे मारा भाय अने बेन्‌या से, तीनी मे गेथा घणा झाजा मे जेल मे कुंडायलो से करीन, हीम्‌मत करीन, भगवान नो बोल बेफीकर हय्‌न ह़मळावा नी अळी बी हीम्‌मत कर र्‌या।<verse eid="PHP 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 1:15" />काना ते डहवाये अने झगड़ा सी ईसु मसी नो परच्‌यार करे, पण काना ते वारलो वीच्‌यार लीन परच्‌यार करे। <verse eid="PHP 1:15" /><verse number="16" style="v" sid="PHP 1:16" />कंय जणा ते आहयु जाणीन के मे खुस-खबर नी लेदे जपाप आपवा करीन ठेरावलो से करीन मोंग सी परच्‌यार करे। <verse eid="PHP 1:16" /><verse number="17" style="v" sid="PHP 1:17" />अने कंय जणा ते वारलो वीच्‌यार लीन नी पण वीरोद सी मसी नो परच्‌यार ह़मळावे, आहयु ह़मजीन के मने जेल मे कुंडायलो से जादा वेला हयवु जोवे।<verse eid="PHP 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="PHP 1:18" />ता ह़ु हय ज्‌यु? नीस्‌तु आहयु, के आखी भाती सी भले बोनु सी, भले सच्‌चाय सी, मसी नो बोल ह़मळाय र्‌या, अने मे आनी सी घणो खुस से, अने अळी घणो खुस रेही बी। <verse eid="PHP 1:18" /><verse number="19" style="v" sid="PHP 1:19" />काहाके मे जाणु के तमारी वीन्‌ती ना लारे, अने ईसु मसी नी आत्‌मा नी लारे, आनो फोळ सी, मारो छुटकारो हयहे।<verse eid="PHP 1:19" /></para>
  <para style="s">जीवत्‌लो रेवा मसी से</para>
  <para style="p">
    <verse number="20" style="v" sid="PHP 1:20" />मे ते आहयी घणी हेर अने आह राखु के मे कानी बी वात मे नी लजवायु नी, पण जीसम मारी वातड़ी हीम्‌मत नी करीन मसी नी ईज्‌जत मारा डील ना लारे जलम हयती रेय, आसमेत हाव बी हये भले मे जीवत्‌लो रेम नीता मर जाम। <verse eid="PHP 1:20" /><verse number="21" style="v" sid="PHP 1:21" />काहाके मारी लेदे जीवत्‌लो रेवा मसी से, अने मर जवा फायदो से। <verse eid="PHP 1:21" /><verse number="22" style="v" sid="PHP 1:22" />पण कदी डील मे जीवत्‌लो रेवात मारा काम नी लेदे फायदो से ता मे नी जाणतो के कोयने टाळु। <verse eid="PHP 1:22" /><verse number="23" style="v" sid="PHP 1:23" />काहाके मे आहयी बेम वात ना वच मे पड़ र्‌यो, ह़ु करुन ह़ु नी? जीव ते हेर करे के डील ने सोड़ीन ईसु मसी नी ह़ाते जाय्‌न रेम, काहाके आहयु घणुत वारु से, <verse eid="PHP 1:23" /><verse number="24" style="v" sid="PHP 1:24" />बाखीन डील मे रेवा तमारी करीन अळी बी जरुड़ी से। <verse eid="PHP 1:24" /><verse number="25" style="v" sid="PHP 1:25" />अने आनी लेदे के मने आनो पक्‌को भरहो से। आनीन लेदे जाणु के मे जीवत्‌लो रेही, मतलब तमु आखा नी ह़ाते रेही, जीनी सी तमु भरहा मे पाका हयता जावो अने तीनी मे घणा खुस रेवो; <verse eid="PHP 1:25" /><verse number="26" style="v" sid="PHP 1:26" />अने जे बड़ाय तमु मारा बारा मे कर र्‌या, तीहयी मने अळी तमारी तां आव्‌वा सी मसी ईसु मे जादा वद जाय।<verse eid="PHP 1:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="PHP 1:27" />नीस्‌तु आतरुत करो के तमारो वेहवार मसी नी खुस-खबर ना अनसारे हय जाय, के भले मे आय्‌न तमने देखु, भले नी बी आवु, तमारा बारा मे आहयु ह़मळु के तमु आखा एकीत आत्‌मा मे टेक्‌ला री र्‌या, अने एक मन हय्‌न खुस-खबर ना भरहा नी लेदे मेहनत करता री र्‌या। <verse eid="PHP 1:27" /><verse number="28" style="v" sid="PHP 1:28" />अने कानी वात मे वीरोद्‌या सी बीह्‌या वगर। आहयु तीमनी लेदे बरबात हयवा नी सेलाणी से, बाखीन तमारी लेदे छुटकारा नी सेलाणी से, अने आहयु भगवान भणी गेथु से। <verse eid="PHP 1:28" /><verse number="29" style="v" sid="PHP 1:29" />काहाके ईसु मसी नी कारण सी तमारी पोर आहयी दया हयी के तमु नी नीस्‌ता तीनी पोर भरहो करो पण तीनी लेदे दुख बी उचलो, <verse eid="PHP 1:29" /><verse number="30" style="v" sid="PHP 1:30" /><note caller="+" style="x"><char style="xo" closed="false">1:30 </char><char style="xt" closed="false"><ref loc="ACT 16:19-40">नेवताळा ना काम 16:19-40</ref></char></note>अने तमने ईसमेत मेहनत करवु से, जीसम तमुत मने करते देखता हता, अने हमणे बी ह़मळतला के मे हीसमेत करतलो।<verse eid="PHP 1:30" /></para>
  <chapter eid="PHP 1" />
  <chapter number="2" style="c" sid="PHP 2" />
  <para style="s">ईसु मसीन तेम ह़ुमाळा बणो</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 2:1" />कदी मसी ईसु मे कंय सांती, अने मोंग सी हीम्‌मत अने आत्‌मा नी ह़ात-ह़ंगात, अने दया हय। <verse eid="PHP 2:1" /><verse number="2" style="v" sid="PHP 2:2" />ता मारी आहयी खुसी पुरी करो, के एक मन रेवो अने एकीत मोंग, एकीत मन, अने एकीत वीच्‌यार राखो। <verse eid="PHP 2:2" /><verse number="3" style="v" sid="PHP 2:3" />वीरोद नीता झुटी बड़ाय ना लेदे कंय ना करो, पण ह़ुमाळा रीन एक-बीजा ने आपणी गेथा वारु ह़मजो <verse eid="PHP 2:3" /><verse number="4" style="v" sid="PHP 2:4" />हरेक आपणा फायदा नी, पण बीजा ना फायदा नी बी फीकर करे।<verse eid="PHP 2:4" /></para>
  <para style="s">मसी नी दया अने बड़ाय</para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 2:5" />तमु आपणा वीच्‌यार ने ईसु मसी ना वीच्‌यार नी ह़रका बणाय लेवो। <verse eid="PHP 2:5" /><verse number="6" style="v" sid="PHP 2:6" />जे भगवान ना वेह मे हय्‌न बी</para>
  <para style="q1" vid="PHP 2:6">भगवान नी बराबर हयवा</para>
  <para style="q2" vid="PHP 2:6">नो वीच्‌यार नी कर्‌यो।<verse eid="PHP 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="PHP 2:7" />पण आह़फा ने ठारलो कर देदो,</para>
  <para style="q2" vid="PHP 2:7">अने पावर्‌या नो वेह धर लेदो,</para>
  <para style="q1" vid="PHP 2:7">अने माणेह नी ह़रको बण ज्‌यो<verse eid="PHP 2:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="PHP 2:8" />अने माणेह ना वेह मे उजन्‌तो हय्‌न आह़फा ने नानो कर्‌यो,</para>
  <para style="q2" vid="PHP 2:8">अने आञे लग के हुकम पाळ्‌यो के मरवा, ह़ाचली, होव कुरुस पोर नी मोत बी वेठ लेदो।<verse eid="PHP 2:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="PHP 2:9" />एतरे भगवान तीने घणो मोटो बी कर्‌यो,</para>
  <para style="q2" vid="PHP 2:9">अने तीने तीहयु नाम आप्‌यो जे आखा नामु मे मोटु से।<verse eid="PHP 2:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="PHP 2:10" />के जे ह़रग मे अने कळ पोर अने जे कळीन हेटा से;</para>
  <para style="q2" vid="PHP 2:10">तीहया आखा ईसु ना नाम पोर मांडा टेके।<verse eid="PHP 2:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="PHP 2:11" />अने भगवान बाह नो बड़ाय नी लेदे</para>
  <para style="q2" vid="PHP 2:11">आखा माणहु मान लेय के “ईसु मसी मालीक से।”<verse eid="PHP 2:11" /></para>
  <para style="s">कळी मे वीजाळुन तेम पपलो</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 2:12" />आनी लेदे ए मारा मोंगाळ्‌ळा भाय अने बेन्‌या, जीसम तमु हमेसा गेथा हुकम मान्‌ता आय र्‌या, हेमेत हाव बी नी नीस्‌ता मारी ह़ाते रेता जाय्‌न पण खास करीन हाव मारी सी सेटा रीन बी बीहता अने कापता जाय्‌न आपणा-आपणा छुटकारा नु काम पुरु करता जावो। <verse eid="PHP 2:12" /><verse number="13" style="v" sid="PHP 2:13" />काहाके भगवाननेत से, जे आपणु मोंग नु काम पुरु करवा ना लेदे तमारा मन मे वीच्‌यार नाखे, अने तीनी अनसारे काम करवा नी ताखत बी आपे।<verse eid="PHP 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 2:14" />आपणा आखा काम बड़बड़ कर्‌या वगर अने पाड़ोपाड़्‌या वगर कर्‌या करो। <verse eid="PHP 2:14" /><verse number="15" style="v" sid="PHP 2:15" />के तमु वण-गुनाळ्‌ळा अने भोळा हय्‌न वाकला अने हटाळा माणहु ना वच मे भगवान ना वण-गुनाळ्‌ळा अवल्‌यात बणीन रेवो, तीमनी वच मे तमु जीवाय नो बोल लीन कळी मे धप्‌तला दीवा नी तेम देखाय देवो, <verse eid="PHP 2:15" /><verse number="16" style="v" sid="PHP 2:16" />के मसी ना आव्‌वा ना दाड़े मने घमंड करवा नो कारण हये के नी मारो दवड़ो अने नी मारी मेहनत करवा नु फाल्‌तु हयी।<verse eid="PHP 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 2:17" />कदी मने तमारा भरहा ना लेदे बादा अने चाकरी ना लेदे मने मारु लोय बी वयाड़वा पड़े ते बी मे घण खुस से, अने तमु आखा ह़ाते घण खुस रेम। <verse eid="PHP 2:17" /><verse number="18" style="v" sid="PHP 2:18" />ईसमेत तमु बी घण खुस हयो, अने मारी ह़ाते घण खुसी मनावो।<verse eid="PHP 2:18" /></para>
  <para style="s">तीमुथीयुस अने ईपफ्‌रुदीतुस</para>
  <para style="p">
    <verse number="19" style="v" sid="PHP 2:19" />मने मालीक ईसु मे आह से के मे तीमुथीयुस ने तमारीन्‌तां छोटोत मोकलही, के तमारा बारा मे ह़मळीन मने सांती जड़हे। <verse eid="PHP 2:19" /><verse number="20" style="v" sid="PHP 2:20" />काहाके मारी ह़ाते आसवु कोय बी माणेह नी हय, जे खरला मन सी तमारी भलाय नी फीकर करे। <verse eid="PHP 2:20" /><verse number="21" style="v" sid="PHP 2:21" />काहाके आखा आपणी भलाय नी फीकर करी र्‌या, ईसु मसी नी भलाय नी फीकर नी करता। <verse eid="PHP 2:21" /><verse number="22" style="v" sid="PHP 2:22" />पण तीमुथीयुस ने तमु ते पारख्‌या अने जाणी बी लेदला से के जीसम सोरो बाह ह़ाते काम करतलो, तेमेत तीहयो बी खुस-खबर ने ह़मळाव्‌वा मे मारी ह़ाते मेहनत कर्‌यो। <verse eid="PHP 2:22" /><verse number="23" style="v" sid="PHP 2:23" />एतरे मने आह से के जीसमेत मने मारा बारा मे पतो चालहे के मारी ह़ाते ह़ुं हयवा वाळु से, तीसमेत मे तीने छोटोत तमारीन्‌तां मोकल देही। <verse eid="PHP 2:23" /><verse number="24" style="v" sid="PHP 2:24" />अळी मने मालीक पोर पक्‌को भरहो से के मे आह़फो बी छोटोत आवही।<verse eid="PHP 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHP 2:25" />पण मेत ईपफ्‌रुदीतुस ने जे मारो भाय, अने ह़ाती अने सीपायड़ान तेम काठो-जीव करन्‌यो अने तमारो नेवताळो, अने जरुड़ी वातु मे मारी चाकरी करन्‌यो से, तमारीन्‌तां मोकलवा जरुड़ी ह़मज्‌यो। <verse eid="PHP 2:25" /><verse number="26" style="v" sid="PHP 2:26" />काहाके तीनु मन तमु आखा पोर लागलु हतु, एतरे तीहयो दुखी रेतो हतो काहाके तमु ते तीनी बेमारी ना बारा मे ह़मळला हता। <verse eid="PHP 2:26" /><verse number="27" style="v" sid="PHP 2:27" />अने ह़ाचली तीहयो घणो मांदलो हतो, आञे लग के मरवा पोर हतो, पण भगवान तीनी पोर दया कर्‌यो; अने नीस्‌तो तीनी पोर एतरो नी, पण मारी पोर बी के मने दुख पोर दुख वेठवा नी पड़े। <verse eid="PHP 2:27" /><verse number="28" style="v" sid="PHP 2:28" />एतरे मेत तीने मोकलवा अळी बी तीयार कर्‌यो के तीने अळी भेटीन घण खुस हय जावो अने मारो बी दुख कम हय जाय। <verse eid="PHP 2:28" /><verse number="29" style="v" sid="PHP 2:29" />एतरे तमु मालीक मे रीन तीनी सी घण खुस हय्‌न भेट करजो, अने आसवा ने ईज्‌जत कर्‌या करजो, <verse eid="PHP 2:29" /><verse number="30" style="v" sid="PHP 2:30" />काहाके तीहयो मसी ना काम ना लेदे आह़फा ना जीव पोर भार उचलीन मोत ना ह़ाते हय जेलो हतो, के जे कमी तमारी भणी गेथी मारी चाकरी मे हयी तीने पुरी करो।<verse eid="PHP 2:30" /></para>
  <chapter eid="PHP 2" />
  <chapter number="3" style="c" sid="PHP 3" />
  <para style="s">खरली सच्‌चाय</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 3:1" />एतरे ए मारा भाय अने बेन्‌या, मालीक ईसु मे खुस रेवो। तीहयीत वात तमने वळ-वळीन लीखवा सी मने कंय दुख नी लागतो, अने आञेत तमारी रखवाळी अने भलाय से। <verse eid="PHP 3:1" /><verse number="2" style="v" sid="PHP 3:2" />कुतरा नी तेवा माणहु सी चेतीन रेवो, गळत काम करवा वाळा सी चेतीन रेवो, मार-कुट करवा वाळा सी चेतीन रेवो। <verse eid="PHP 3:2" /><verse number="3" style="v" sid="PHP 3:3" />काहाके खतना वाळा ते आमुत से जे भगवान नी आत्‌मा नी अगवाय ना लारे भगवान नी पुजा करतला, अने ईसु मसी पोर एतरी मोटाय करतला अने आपणा डील नी उपरली रीती-रीवाज पोर भरहो नी करतला। <verse eid="PHP 3:3" /><verse number="4" style="v" sid="PHP 3:4" />पण मे ते डील पोर बी भरहो राख सकु। कदी काना बीजा ने डील पोर भरहो राखवा नो वीच्‌यार हय, ता मे तीनी सी बड़ीन राख सकु। <verse eid="PHP 3:4" /><verse number="5" style="v" sid="PHP 3:5" /><note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="ROM 11:1">रोमीयो 11:1</ref>; </char><char style="xt" closed="false"><ref loc="ACT 23:6">नेवताळा ना काम 23:6</ref>; <ref loc="ACT 26:5">26:5</ref></char></note>काहाके आंठवा दाड़े मारु खतनु हयु, मे ईस्‌रायली माणहु नो अवल्‌यात से, अने बीन्‌यामीन ना घोराणा नो से; ईब्‌रानी जाती नो से, कायदा ना बारा मे कदी केम ता फरीसी टोळा नो से <verse eid="PHP 3:5" /><verse number="6" style="v" sid="PHP 3:6" /><note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 8:3">नेवताळा ना काम 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char></note>हीम्‌मत ना बारा मे कदी केम ता मंडळी ने वेला पाड़वा वाळो, अने कायदा ना धरमपण ना बारा मे कदी केम ता गुनाळ्‌ळो नी हतो। <verse eid="PHP 3:6" /><verse number="7" style="v" sid="PHP 3:7" />पण जे-जे वात मारा फायदा नी हती, तीमनेत मे मसी ना कारण नुकसान ह़मज लेदो। <verse eid="PHP 3:7" /><verse number="8" style="v" sid="PHP 3:8" />आतरु नी पण ईसु मसी ने “मारो मालीक” से करीन जाणवा आखा मे गेथु वारु ह़मजीन, मे आखी बीजी वात ने नुकसान नी ह़मजी लेदो। तीना लेदे मे आखी चीज नो नुकसान झेल्‌यो, ईसु मसी ने हात करवा करीन, मे तीहयी आखी चीज ने कचरु ह़मजु। <verse eid="PHP 3:8" /><verse number="9" style="v" sid="PHP 3:9" />अने तीनी ह़ाते पुरोत एक हय जाम। मने आपणी सच्‌चाय पोर नी, जे कायदा ने पाळवा सी जड़े, पण तीहयी सच्‌चाय पोर भरहो से, जे ईसु मसी पोर भरहो करवा सी जड़े अने भगवान नी भणी गेथी भरहो करवा सी जड़े। <verse eid="PHP 3:9" /><verse number="10" style="v" sid="PHP 3:10" />जीनी सी मे ईसु मसी ने अने तीने पासो जीवतो करन्‌याण नी ताखत जाणु, अने तीनी ह़ाते दुख अने मोत मे एक हय जाम। <verse eid="PHP 3:10" /><verse number="11" style="v" sid="PHP 3:11" />काहाके मे बी कानी बी रीते मरलाम गेथु पासु जीवतु हयणु हात कर सकु।<verse eid="PHP 3:11" /></para>
  <para style="s">ईसु ना माणहु नो ठीयो</para>
  <para style="p">
    <verse number="12" style="v" sid="PHP 3:12" />आनु मतलब आहयु नी के मे हात कर लेदो, अने चोखलो हय ज्‌यो; पण तीहयी चीज ने हात करवा नी लेदे दवड़ीन जवा बाज र्‌यो, जीनी लेदे ईसु मसी मने टाळ्‌ळो हतो। <verse eid="PHP 3:12" /><verse number="13" style="v" sid="PHP 3:13" />ए मारा भाय अने बेन्‌या, मारो वीच्‌यार आहयो नी के मे हात कर लेदो, पण नीस्‌तु आहयु एक काम करु, के जे वात पसळ री जेली से तीने भुलीन, अगली वात नी भणी वदतो जाय्‌न, <verse eid="PHP 3:13" /><verse number="14" style="v" sid="PHP 3:14" />ठीया भणी दवड़ीन जवा बाज र्‌यो, के तीहयो ईलाम हात करु, जीनी लेदे भगवान मने ईसु मसी मे उपर बोलावलो से।<verse eid="PHP 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHP 3:15" />एतरे अमारी मे गेथा जेतरा चोखला से, तीहया आहयोत वीच्‌यार राखो, अने कदी कानी वात मे तमारो बीजी भाती नो वीच्‌यार हय ता भगवान तीने बी तमारी पोर उजन्‌तो कर देहे। <verse eid="PHP 3:15" /><verse number="16" style="v" sid="PHP 3:16" />एतरे आमु तीहया कायदा ना अनसारे अगा वदो तीहया कायदा ने आमु हमणे लग पाळ्‌या कर्‌या।<verse eid="PHP 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHP 3:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:17 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:16">1 कुरन्‌थी 4:16</ref>; <ref loc="1CO 11:1">11:1</ref></char>
    </note>ए भाय अने बेन्‌या तमु आखा मेळीन मारीन तेम चालो, अने तीने ओळखो, जे आहयी रीती पोर चालत्‌ला से जीनो उदारण तमु अमारी मे देखत्‌ला से। <verse eid="PHP 3:17" /><verse number="18" style="v" sid="PHP 3:18" />मे तमने कंय वार पेलो बी की देदलो, अने हाव बी रड़तो जाय्‌न केम, आसवा कंय माणहु से तीमनी जीवाय तीमनेत कुरुस पोर मसी नी मोत ना वेरी बणावे। <verse eid="PHP 3:18" /><verse number="19" style="v" sid="PHP 3:19" />तीहया नरक मे खत्‌तम हयवा जवा बाज र्‌या, तीमनो भगवान तीमनु पेट से, अने वण-लाज्‌याण वात पोर मोटाय करे, अने धरती पोर नी चीजु पोर मन लगाड़्‌या करे। <verse eid="PHP 3:19" /><verse number="20" style="v" sid="PHP 3:20" />पण आपणु खास देस ते ह़रग मे से, तां गेथो आपणु ने सोड़ाव्‌वा वाळो ईसु मसी आव्‌वा वाळो से अने आमु तीनी वाट जोय र्‌या। <verse eid="PHP 3:20" /><verse number="21" style="v" sid="PHP 3:21" />तीहयो आपणी ताखत ना अनसारे आखी चीज ने आह़फा ना कब्‌जा मे करन्‌यो से, आपणा कमजोर डील ना सीका ने बदलीन, आह़फा ना बड़ाय भरला डील ना सीका मे बदली देहे।<verse eid="PHP 3:21" /></para>
  <chapter eid="PHP 3" />
  <chapter number="4" style="c" sid="PHP 4" />
  <para style="s">वेहवार मे लावण्‌याण ह़ीकापण</para>
  <para style="p">
    <verse number="1" style="v" sid="PHP 4:1" />एतरे ए मारा मोंगाळ्‌ळा भायु अने बेन्‌या, मारो जीव तमारी हेर करे, जे मारी खुसी अने पागड़ी से, ए मोंगाळ्‌ळा भायु अने बेन्‌या, मालीक ईसु मे आहयी रीती सी टेकला रेवो।<verse eid="PHP 4:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="PHP 4:2" />मे युओदीया अने सुनतुखे ने बी, ह़मजाड़ु के तीहया मालीक ईसु मे एक मन रेवो। <verse eid="PHP 4:2" /><verse number="3" style="v" sid="PHP 4:3" />ए मारा खरला हाती, मे तने बी वीन्‌ती करीन केम के तु तीहया बयरा नी मदत कर, काहाके तीहया मारी ह़ाते खुस-खबर ह़मळाव्‌वा मे, कलेमेस अने मारा बीजा ह़ाती ह़ाते मेहनत कर्‌या, आमनु आखा नु नाम भगवान नी अमर जीवाय नी कीताप मे लीखला से।<verse eid="PHP 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="PHP 4:4" />मालीक मे जलम खुस रेवो; मे अळी केम, खुस रेवो।<verse eid="PHP 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="PHP 4:5" />तमारी नीचळाय आखा माणहु पोर उजन्‌ती हये। मालीक छोटोत आव्‌वा वाळो से। <verse eid="PHP 4:5" /><verse number="6" style="v" sid="PHP 4:6" />कानी बी वात नी फीकर ना करो; पण आखी वात मे तमारी वीन्‌ती अने रावण्‌या नी लारे घण वारु से केता जाय्‌न भगवान अगळ आवो। <verse eid="PHP 4:6" /><verse number="7" style="v" sid="PHP 4:7" />तत्‌यार भगवान नी सांती, जे आखी ह़मज गेथी अलग से, तमारा हीय्‌या मन ने मसी ईसु मे रखवाळी करहे।<verse eid="PHP 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="PHP 4:8" />एतरे ए भायु, अने बेन्‌या जे-जे वात ह़ाचली से, अने जे-जे वात ईज्‌जत करे एवी से, अने जे-जे वात वारु से, अने जे-जे वात चोखली से, अने जे-जे वात ह़ुबे एवी से, अने जे-जे वात मन ने गमे एवी से, काहाके, जे बी वारला गुण अने वारु केय एवी वात से, तीनी पोर ध्‌यान लगाड़्‌या करो। <verse eid="PHP 4:8" /><verse number="9" style="v" sid="PHP 4:9" />जे वात तमु मारी सी ह़ीक्‌या, अने आवरी लेदा, अने ह़मळ्‌या, तीनी पाळनी कर्‌या करो, तत्‌यार भगवान जे सांती नो झोर से तमारी ह़ाते रेहे।<verse eid="PHP 4:9" /></para>
  <para style="s">दान नी जुगु घणु वारु केम</para>
  <para style="p">
    <verse number="10" style="v" sid="PHP 4:10" />मे मालीक मे घणो खुस से, के हाव एतरा दाड़ान अळतेण तमारी फीकर मारा बारा मे अळी जाग जेली से; ह़ाचली तमने पेले बी आनु वीच्‌यार हतु, पण तमने टेम नी जड़ी। <verse eid="PHP 4:10" /><verse number="11" style="v" sid="PHP 4:11" />आहयु नी के मे आपणी कमी ना कारण आहयु केम; काहाके मे आहयु ह़ीकलु से के जे हालत मे से, तीनी मे, मे खुस से। <verse eid="PHP 4:11" /><verse number="12" style="v" sid="PHP 4:12" />मे नानो हयवा बी जाणत्‌लो से अने बड़वा बी जाणत्‌लो से; आखी वात अने आखी हालत मे आफरवा, भुकलो रेवा, अने बड़वा-घटवा ह़ीकलो से। <verse eid="PHP 4:12" /><verse number="13" style="v" sid="PHP 4:13" />जे मने सक्‌ती आपे, तीनी मे मे आखु कंय कर सकत्‌लो से।<verse eid="PHP 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="PHP 4:14" />ते बी तमु मारी वेला मे मारो भलो करीन मारा साजल्‌या बण्‌या। <verse eid="PHP 4:14" /><verse number="15" style="v" sid="PHP 4:15" />ए फीलीपीयो, तमु आह़फा बी जाणत्‌ला से के खुस-खबर पर्‌च्‌यार ना सुरु ना दाड़ा मे जत्‌यार मे मकीदुनीया सी आयो ता तमने सोड़ीन अने कानी मंडळी लेवा-आपवा ना बारा मे मारी मदत नी कर्‌या। <verse eid="PHP 4:15" /><verse number="16" style="v" sid="PHP 4:16" /><note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="ACT 17:1">नेवताळा ना काम 17:1</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="2CO 11:9">2 कुरन्‌थी 11:9</ref></char></note>आहयी रीते जत्‌यार मे थीसलुनीकीयो मे हतो; ते बी तमु मारी कमी पुरी करवा नी लेदे एक कावा नी पण वळ-वळीन मदत मोकल्‌ता र्‌या। <verse eid="PHP 4:16" /><verse number="17" style="v" sid="PHP 4:17" />आहयु नी के मे दान लेवा नी हेर करु, पण मे एसवु फोळ चाहु, जे तमारा फायदा नी लेदे बड़तु जाय। <verse eid="PHP 4:17" /><verse number="18" style="v" sid="PHP 4:18" />मारी पांह आखु कंय से, अने जादा बी से; जे चीज तमने ईपफ्‌रुदीतुस ना हात सी मोकल्‌ली हती तीने हात करीन मे धाप ज्‌यो, तीहयी ते सुख आपण्‌या गंदायण्‌या, आवरे एवी बादा से जे भगवान ने गमे। <verse eid="PHP 4:18" /><verse number="19" style="v" sid="PHP 4:19" />मारो भगवान बी आपणा तीहया धन नी लारे जे बड़ाय भेळ मसी ईसु मे से, तमारी आखी कमी ने पुरी करहे। <verse eid="PHP 4:19" /><verse number="20" style="v" sid="PHP 4:20" />अमारा भगवान अने बाह नी बड़ाय जलमकी हयतीत रेय। आमीन।<verse eid="PHP 4:20" /></para>
  <para style="s">आखरी कावा वारला से के केम</para>
  <para style="p">
    <verse number="21" style="v" sid="PHP 4:21" />आखा भगवान ना चोखला माणहु ने जे ईसु मसी मे से आवही अने आवजो केवो। जे भाय मार ह़ाते से तमने आवही अने आवजो केय। <verse eid="PHP 4:21" /><verse number="22" style="v" sid="PHP 4:22" />आखा भगवान ना चोखला माणहु, खास करीन जे केसर ना घोरल्‌या ना से तमने आवजो अने आवही केय।<verse eid="PHP 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="PHP 4:23" />अमारा मालीक ईसु मसी नी दया तमारी आत्‌मा नी ह़ाते रेय।<verse eid="PHP 4:23" /></para>
  <chapter eid="PHP 4" />
</usx>