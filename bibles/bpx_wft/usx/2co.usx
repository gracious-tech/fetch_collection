<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2CO" style="id">- Paliya</book>
  <para style="h">2 कुरन्‌थी</para>
  <para style="toc3">2 कुरन्‌थी</para>
  <para style="toc2">2 कुरन्‌थी</para>
  <para style="toc1">कुरन्‌थी ना नाम पोलुस नी बीजी चीट्‌ठी</para>
  <para style="mt2">कुरन्‌थियों के नाम पोलुस की दुसरी पत्री</para>
  <para style="mt1">कुरन्‌थी ना नाम पोलुस नी बीजी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">आहयी चीट्‌ठी बीजी कुरन्‌थी ना नेवताळा पोलुस मसी ना पयदा हयवा ना 55-56 साल बाद लीख्‌यो, <char style="xt"><ref loc="2CO 1:1">1:1</ref></char> पोलुस नी आहयी बे चीट्‌ठी मे गेथी बीजी चीट्‌ठी से। ढेरेत महाराज्‌या ईसम देखाड़्‌यो के आहयी चीट्‌ठी नी पेले कुरन्‌थी मे रेवा वाळा ने एक मोटी अने काठी चीट्‌ठी लीखलो हतो। आना बारा मे<char style="xt"><ref loc="2CO 2:3-4">2:3-4</ref></char> बोलु मे आहयी चीट्‌ठी ना बारा मे वारु देखाड़लो से, पण आहयी चीट्‌ठी नी तेवी चीट्‌ठी अमारी पांह नी हय। आहयी बीजी कुरन्‌थी नी चीट्‌ठी पोलुस मकीदुनीया गेथीत लीखली हहे <char style="xt"><ref loc="2CO 2:13">2:13</ref> </char>।</para>
  <para style="ip">बीजी कुरन्‌थी नी चीट्‌ठी मे खास वात आहयी से आहयी चीट्‌ठी मे माणहु नी जीवाय ना वीच्‌यार करला से। आहयी चीट्‌ठी मे पोलुस तीतुस तीना बारा मे खुसी देखाड़े। आहयी चीट्‌ठी मे ह़ीकापण आपवा ना बारा मे नवला नेम ना वीच्‌यारु सी देखाय। आहयी ह़ीकापण आहयी तीहया देस गेथी जड़े जे देस मे पोलुस तीहयी फाववणी ना बारा मे वात करे जे फाववणी यरुसलेम ना भरहो करन्‌या नी मदत करवा करीन हयली हती हुकम आपे। <char style="xt"><ref loc="2CO 8-9">8–9</ref></char> मंडळी मे थोड़ाक माणहु पोलुस ना वीरोद मे हता पण तां आव्‌वा वाळा थोड़ाक झुटा नेवताळा आह़फा नो बड़ावो करवा करीन तीनो फायदो उठाया। तीहया पोलुस ना अदीकार पोर सण्‌का कर र्‌या हता। एतरे पोलुस आहयी चीट्‌ठी ना आखरी भाग मे मसी नो नेवताळो हयवा ना नाते जे हक तीने जड़लो से तीहया हक पोर पोलुस जोर देय।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पोलुस आह़फा नी चीट्‌ठी मे मंडळी ने आवजो अने आवही केय। <char style="ior"><ref loc="2CO 1:1-7">1:1-7</ref></char></para>
  <para style="io1">2. पोलुस आह़फा नी यात्‌रा योजना बदल देदो तीहयो जे खबर कुरन्‌थी ना बारा मे हात करलो हतो अने आह़फा नी सेल्‌ली काठी चीट्‌ठी ना बारा मे जे सवाल पयदा करलो हतो देखाड़े। <char style="ior"><ref loc="2CO 1:8">1:8</ref>; <ref loc="2CO 7:16">7:16</ref></char></para>
  <para style="io1">3. यरुसलेम मे रेवा वाळा भरहो करन्‌या माणहु जुगु भेट एकठु करवा ना बारा मे पोलुस नी खबर। <char style="ior"><ref loc="2CO 8:1">8:1</ref>; <ref loc="2CO 9:15">9:15</ref> </char></para>
  <para style="io1">4. आखरी मे पोलुस आह़फा ना नेवताळा हयवा नी बचाव करे अने आह़फा नी आव्‌वा वाळी भेट ना बारा मे चेतावे। <char style="ior"><ref loc="2CO 10:1">10:1</ref>; <ref loc="2CO 13:10">13:10</ref> </char></para>
  <chapter number="1" style="c" sid="2CO 1" />
  <para style="s">पोलुस वारला से के केय</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:1">नेवताळा ना काम 18:1</ref>
      </char>
    </note>पोलुस भणी गेथी जे भगवान नी मरजी सी ईसु मसी नो नेवताळो से, अने भाय तीमुथीयुस भणी गेथी भगवान नी तीहयी मंडळी जुगु, जे कुरीन्‌थुस मे से, अने आखा अखाया जीला मे रेवा वाळा चोखला माणहु जुगु लीखला से:<verse eid="2CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 1:2" />आपणा बाह भगवान अने मालीक ईसु मसी भणी गेथी सुक अने सांती जड़ती रेय।<verse eid="2CO 1:2" /></para>
  <para style="s">भगवान ने घणो वारु केणु</para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 1:3" />आपणा ईसु मसी ना भगवान अने बाह ने घणो वारु कीया, जे दया नो बाह अने आखी भाती नी सांती नो भगवान से। <verse eid="2CO 1:3" /><verse number="4" style="v" sid="2CO 1:4" />तीहयो आपणा आखा दुख मे सांती आपे; काहाके आपणु तीहयी सांती ना कारण जे भगवान आपणु ने आपे, तीने बी सांती आप सकया जे काना बी भाती ना दुख मे हय। <verse eid="2CO 1:4" /><verse number="5" style="v" sid="2CO 1:5" />काहाके जेम ईसु मसी ना दुख मे साजल्‌या रीया, तेमेत आपणु सांती मे बी ईसु मसी नी लारे साजल्‌या रीया। <verse eid="2CO 1:5" /><verse number="6" style="v" sid="2CO 1:6" />आमु दुख झेलया, ता आहयु तमारी सांती अने छुटकारा जुगु से, अने आमने सांती जड़ री ता तमने सांती आपवा करीनेत जड़ री: आहयी सांती तीहया आखा दुख ने अराम सी झेलवा मे मदत करहे, जे दुख आमु बी झेल र्‌या। <verse eid="2CO 1:6" /><verse number="7" style="v" sid="2CO 1:7" />तमारा बारा मे आमने पक्‌की आह से, काहाके आमने मालम से के जेम तमु अमारा दुख मे साजल्‌या से तेमेत अमारी सांती मे बी साजल्‌या से।<verse eid="2CO 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 1:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:8 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 15:32">1 कुरन्‌थी 15:32</ref>
      </char>
    </note>एतरे ए भायु अने बेन्‌या, अमारी पोर जे कळ-कळीन वीती तीहयी वात तमने पक्‌की मालम हयवा जोवे। आसीया परगणा मे अमारी उपर घणी आफत आय पड़ली हती, अने तीहयी आफत वेठाये नी एतरी जबर हती के आमु मर जाय ईसम हय जेला। <verse eid="2CO 1:8" /><verse number="9" style="v" sid="2CO 1:9" />ह़ाचली मे, आमु ते मन मे वीच्‌यार कर लेदला के आमने मोत नो डंड जड़ीत ज्‌यो। आहयु आनीन करते हयु के आमु अमारी पोर नी पण तीहया भगवान पोर भरहो करवा ह़ीकया जे मरला ने बी जीवाड़ देय। <verse eid="2CO 1:9" /><verse number="10" style="v" sid="2CO 1:10" />हाव, आहयो भगवान आपणु ने मोत मे गेथो बचाड़्‌यो, अने अगो बी घण-जबर मोत मे गेथो बचाड़हे, अने अमारी आहयी आह से के तीहयो अगो बी बचाड़तो रेहे। <verse eid="2CO 1:10" /><verse number="11" style="v" sid="2CO 1:11" />अने अमारी जुगु वीन्‌ती करवा नी लारे तमु बी भगवान ना साजल्‌या बणहु ता भगवान वीन्‌ती ह़मळीन आमने संयबरकत आपहे अने ढेरेत माणहु भगवान ने घणो वारु केता रेहे।<verse eid="2CO 1:11" /></para>
  <para style="s">पोलसु नी यात्‌रा मे बदलाव</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 1:12" />अमारी मोटाय, होव, अमारा खरला मन नी गवाय आहयी से के आहयी कळी मे रीन आखा ह़ाते अने खास करीन तमारी ह़ाते चोखलो अने खरलो वेहवार करला हता। आहयो वेहवार आहयी कळी मे रेवा वाळा माणहु नी अक्‌कल नी अनसारे नी पण भगवान नी दया नी अनसारे हतो। <verse eid="2CO 1:12" /><verse number="13" style="v" sid="2CO 1:13" />तमु जे भणे अने ह़मजे तीहयुत आमु लीख र्‌या, अने मे आह करु के तमु आहयी आखी वात ने सेल्‌ली कावा वारु ह़मजी जहु। <verse eid="2CO 1:13" /><verse number="14" style="v" sid="2CO 1:14" />आहयी वात ने तमु थोड़ीक ह़मजी बी जेला से एतरे तमु अमारी पोर मोटाय कर सकत्‌ला जेम आमु बी मालीक ईसु पासो आवहे तीहया दाड़े तमारी पोर मोटाय करहु।<verse eid="2CO 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2CO 1:15" />अने आहयोत भरहो करीन मे तमारीन्‌तां आव्‌वा हींडतो हतो; के तमने एक कावा नी पण बे कावा संयबरकत जड़वा जोवे। <verse eid="2CO 1:15" /><verse number="16" style="v" sid="2CO 1:16" /><note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="ACT 19:21">नेवताळा ना काम 19:21</ref></char></note>एतरे तमारीन्‌तां माय्‌न मकीदुनीया जीला मे जवा हींडतो हतो, अने अळतेण मकीदुनीया जीला मे गेथो पासो तमारीन्‌तां आव्‌वा हींडतो हतो, अने तां गेथो तमने भेटीन युहद्‌या जीला मे जवा करीन खुसी सी वळाय सको। <verse eid="2CO 1:16" /><verse number="17" style="v" sid="2CO 1:17" />मे एमेत वीच्‌यार कर र्‌यो हतो ता मे काहा वचकी ज्‌यो? मे आहयी कळी ना मनख्‌यान तेम वीच्‌यार कर्‌यो ह़ु? अने तीहयी टेमे होव-होव आवही की देय अने तत्‌यारुत नी-नी मे नी आवु की देय। <verse eid="2CO 1:17" /><verse number="18" style="v" sid="2CO 1:18" />भगवान खरलो गवा से, के जे बोलु आमु तमने केदा तीमनी मे “होव” अने “नी” बेम नी जड़े। <verse eid="2CO 1:18" /><verse number="19" style="v" sid="2CO 1:19" /><note caller="+" style="x"><char style="xo" closed="false">1:19 </char><char style="xt" closed="false"><ref loc="ACT 18:5">नेवताळा ना काम 18:5</ref></char></note>काहाके सीलवानुस अने तीमुथीयुस नी लारे जे भगवान ना बेटा ईसु मसी नी खुस-खबर तमारी वच मे पुगी; तीहया ईसु मसी नी वात बी मोडे करीन “होव” केवा अने मन मे “नी” की देवा नी वात नी हती; पण होवेत होव हतु। <verse eid="2CO 1:19" /><verse number="20" style="v" sid="2CO 1:20" />काहाके भगवान ना आखा वायदा पक्‌का से, तीहया आखा ईसु मे “होव” पुरा हय र्‌या: एतरे आपणु भगवान ना बड़ाय नी अनसारे भगवान नी बड़ाय करवा नी करतेत ईसु नी लारेत “आमीन” कीन हुकारया। <verse eid="2CO 1:20" /><verse number="21" style="v" sid="2CO 1:21" />अने भगवान आमने तमारी ह़ाते ईसु मसी ना भरहा मे पक्‌का बणावे, अने जे आपणु ने टाळलो से तीहयो आहयोत भगवान से। <verse eid="2CO 1:21" /><verse number="22" style="v" sid="2CO 1:22" />जे अमारी पोर छाप बी लगाड़ देदलो से के आमु तीना से, अने तीना केवा सी आत्‌मा ने अमारा मन मे आपलो से।<verse eid="2CO 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="2CO 1:23" />मे ह़ाचली केम भगवान आहयी वात नो गवा से, मे तमारीन्‌तां आव्‌वा हींडतो हतो; पण मे तत्‌यारुत तमने वडी-वडीन वेला पाड़वा नी हींडतो हतो, एतरे मे कुरीन्‌थुस ह़ेर मे तमारीन्‌तां नी आयो। <verse eid="2CO 1:23" /><verse number="24" style="v" sid="2CO 1:24" />अने आमु तमारी पोर राज करीन हक जमाड़वा हींड र्‌या? कदी नी, आमु ईसु पोर ना भरहा मे तमारी खुसी नी करतेत आमु तमारा साजल्‌या से। ईसु पोर भरहो करवा नी लारेत तमु टेक र्‌या, एतरे आमने तमारा भरहा पोर राज नी कराये।<verse eid="2CO 1:24" /></para>
  <chapter eid="2CO 1" />
  <chapter number="2" style="c" sid="2CO 2" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 2:1" />एतरे मे मारा मन मे आहयु ठान लेदो के मे तमने वडीन वेला पाड़वा करीन अळी पासो तमारीन्‌तां नी आवु। <verse eid="2CO 2:1" /><verse number="2" style="v" sid="2CO 2:2" />काहाके कदीम मे तमने वडीन वेला पाड़ु ता मने सुक कोय आपहे? तीहयोत सुक आपहे जीने मे वडीन वेला पाड़लो हतो। <verse eid="2CO 2:2" /><verse number="3" style="v" sid="2CO 2:3" />मे आहयीत वात ने पेले आनीन करते लीखलो के जत्‌यार मे तमारीन्‌तां आवु तत्‌यार जीनी पांह गेथो मने सुक जड़वा जोवे तीनी पांह गेथो दुख नी जड़वा जोवे। पण मने तमारी आखा पोर भरहो से के जे सुक मारो से तीहयोत सुक तमारो बी से। <verse eid="2CO 2:3" /><verse number="4" style="v" sid="2CO 2:4" />मे घण-जबर वेला करतो जाय्‌न, अने मन मे बी घणो फीकर मे पड़ीन, अने गीरी-गीरी आहवा पाड़तो जाय्‌न आहयी चीट्‌ठी मे तमारी जुगु लीखलो से। आनीन करते नी लीख्‌यो के तमु दुखी हय्‌न फीकर मे पड़ जावो, पण आनीन करते लीखलो से के तमु आहयु जाण जावो के मे तमने घण-जबर मोंग करु।<verse eid="2CO 2:4" /></para>
  <para style="s">गुनेगार ने माफी आपवा</para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 2:5" />पण कदीम कोय मने वेला पाड़्‌यु ता तीहयु मने एतरुत वेला नी पाड़्‌यु, पण थोड़ुक तमने बी वेला पाड़्‌यु। <verse eid="2CO 2:5" /><verse number="6" style="v" sid="2CO 2:6" />आसम वेला पाड़न्‌या ने ते आखा भायु मेळीन डंड आप्‌या एतरुत घणु से। <verse eid="2CO 2:6" /><verse number="7" style="v" sid="2CO 2:7" />पण हाव तीने माफी आपो, अने सांती आपो, काहाके तमु माफी नी आपे ता तीहयो फीकर मे पड़ीन हहटाय जहे। <verse eid="2CO 2:7" /><verse number="8" style="v" sid="2CO 2:8" />एतरे मे तमने रावण्‌या करीन केम के तीने आह़फाम नो मोंग देखाड़ो। <verse eid="2CO 2:8" /><verse number="9" style="v" sid="2CO 2:9" />तमु मारी वात मानो के नी मानो ईसम पारखवा करीन बी मे तीहयी वात लीखलो हतो। <verse eid="2CO 2:9" /><verse number="10" style="v" sid="2CO 2:10" />जीने तमु माफी आपला से तीने मे बी माफी आपु, काहाके तीने एतरोत नी पण बीजा ने बी तमारी भलाय नी करतेत ईसु मसी वगो हय्‌न माफी आप देदलो से, <verse eid="2CO 2:10" /><verse number="11" style="v" sid="2CO 2:11" />के भुतड़ा ने अमारी वच मे मोखो नी जड़वा जोवे, काहाके भुतड़ो घण कदर्‌यो से अने तीनी कदर आमु घण वारु जाणया।<verse eid="2CO 2:11" /></para>
  <para style="s">त्‌रोवास ह़ेर मे पोलुस</para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 2:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:12 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:1">नेवताळा ना काम 20:1</ref>
      </char>
    </note>जत्‌यार मे मसी नी खुस-खबर ह़मळाव्‌वा करीन त्‌रोवास ह़ेर आयो, तत्‌यार मालीक ईसु मने खुस-खबर ह़मळाव्‌वा करीन तां ह़ारीक मोखो आप देदो। <verse eid="2CO 2:12" /><verse number="13" style="v" sid="2CO 2:13" />पण तां ह़ारीक आपणो भाय तीतुस नी हतो करीन मे घण-जबर घबराय्‌न फीकर मे पड़ ज्‌यो; अने मे तीमने आवजे अने आवही कीदीन तां गेथो मकीदुनीया परगणा मे जत र्‌यो।<verse eid="2CO 2:13" /></para>
  <para style="s">मसी नी लारे जीक</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 2:14" />पण मे भगवान ने घणो वारु केम, जे मसी मे आमने जलम जीक मे रेवा करीन मदत करे; जेम गंदायण्‌या तेल नो गंद आखी दुर फेल जाय तेमेत भगवान अमारी लारे आमु जां जीया तां ह़ारीक ईसु ना बारा मे खुस-खबर पुगाड़ देय। <verse eid="2CO 2:14" /><verse number="15" style="v" sid="2CO 2:15" />काहाके आमु भगवान अगळ छुटकारो हात करन्‌या अने छुटकारो हात नी करन्‌या तीहया बेम जणा जुगु मसी नी गंद से। <verse eid="2CO 2:15" /><verse number="16" style="v" sid="2CO 2:16" />काना जुगु ते मरवा करीन मरवा वाळी गंद अने काना जुगु, जीवाय करते जीवाय नी गंद से। अने एतरु मोटु काम करे एवु कोय से? <verse eid="2CO 2:16" /><verse number="17" style="v" sid="2CO 2:17" />आमु से, काहाके भगवान आमु ने मोकल्‌यो; आमु तीमनीन तेवा नी हय, जे आह़फाम ना नफा नी करते भगवान ना बोल मे रीकामी वात भेसकीन केय; पण आमु ते खरला मन सी भगवान वगा हय्‌न भगवान नी हजरी मे, ईसु मसी मे खरला रीन खुस-खबर ह़मळावया।<verse eid="2CO 2:17" /></para>
  <chapter eid="2CO 2" />
  <chapter number="3" style="c" sid="2CO 3" />
  <para style="s">नवला वायदा ना चाकर्‌या</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 3:1" />ह़ु आमु आह़फात अमारी बड़ाय कर र्‌या? आहयु आमु ने देखाड़वा करीन आहयी वात नी गवा जुगु बीजा पांह गेथी तमने चीट्‌ठी लीखाड़ मांगवा पड़हे ह़ु? आहयु तमने देखाड़वा करीन आहयी वात नी गवा जुगु बीजा नी तेम आमने बीजा पांह गेथी चीट्‌ठी लीखाड़ मांगवा पड़हे ह़ु? <verse eid="2CO 3:1" /><verse number="2" style="v" sid="2CO 3:2" />नी, काहाके तमु ते एक गवा नी चीट्‌ठी तेम अमारा मन मे लीखाय ज्‌या जाणो, जे गवा नी चीट्‌ठी ने तमारी लारे आखा माणहु उजन्‌ता ओळखे अने भणे। <verse eid="2CO 3:2" /><verse number="3" style="v" sid="2CO 3:3" />आहयी वात ते उजन्‌ती से के तमु अमारी लारे खुस-खबर ह़मळ्‌या। एतरे तमु ईसु मसी नी गवा नी चीट्‌ठी से; अने आहयी चीट्‌ठी संये करीन नी लीख्‌या, पण जीवत्‌ला भगवान नी आत्‌मा नी लारे मन मे लीखला से आहयी एक कीया मे मन ना माह नी पट्‌टी पोर लीखली से।<verse eid="2CO 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2CO 3:4" />अने आमु ईसु मसी नी लारे भगवान पोर ईसमेत भरहो करया। <verse eid="2CO 3:4" /><verse number="5" style="v" sid="2CO 3:5" />अमारु आहयुत केणु से के आमु जे कंय बी करया तीहयु अमारा ज्‌योरे नी पण भगवान नी ज्‌योरेत करया। <verse eid="2CO 3:5" /><verse number="6" style="v" sid="2CO 3:6" />जे आमु ने नवला वायदा ना काम करे एवा पावर्‌या बणावलो से, आहया वायदा लीखला कायदा ना नी हय, पण आत्‌मा ना से। काहाके कायदो मारे अने आत्‌मा जीवाड़े।<verse eid="2CO 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 3:7" />मुसा नो वायदो दगड़ा नी बणली पट्‌टी पोर टुचीन लीखलो हतो, तीहयो वायदो एतरो जबर बड़ाय भर्‌यो हय्‌न आयो के ईस्‌रायली जाती ना माणहु ने मुसा ना मुख ने एकडीट्‌या हय्‌न नी भळायु, पण ते बी मुसा ना मुख पोर वाळो बड़ाय कम हयतो जतो हतो। <verse eid="2CO 3:7" /><verse number="8" style="v" sid="2CO 3:8" />ता आत्‌मा नी सेवा अळी बी जादा बड़ाय भर्‌या काहा नी रेय? <verse eid="2CO 3:8" /><verse number="9" style="v" sid="2CO 3:9" />जत्‌यार गुनो लगाड़न्‌या काम घण-जबर जुगाळा हता, ता छुटकारो आपण्‌या काम अळी बी जादा जुगाळा काहा नी रेय। <verse eid="2CO 3:9" /><verse number="10" style="v" sid="2CO 3:10" />ह़ाचली वात ते आहयी से के जे काम बड़ाय भर्‌या हता तीहयात काम आहया नवला काम अगळ फीका पड़ ज्‌या। <verse eid="2CO 3:10" /><verse number="11" style="v" sid="2CO 3:11" />एतरे मे आहयु केम के जे कमतो हयतो जत्‌लो तीहयो बड़ाय घण-जबर हतो, ता आहयो जलम वदतो जाण्‌यो बड़ाय, तीनी गेथो बी जादा बड़ाय भर्‌यो काहा नी रेय।<verse eid="2CO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 3:12" />एतरे आमु नवला जोरभर्‌या बड़ाय नो आह करीन हीम्‌मत भेळ बोलया। <verse eid="2CO 3:12" /><verse number="13" style="v" sid="2CO 3:13" />अने मुसान तेम नी, जे आह़फा ना मोडा पोर लुगड़ु नाख रेलो काहाके ईस्‌रायली माणहु तीहया कमतो हयवा वाळा बड़ाय ने आखरी मे कम हयत्‌लो नी देखे। <verse eid="2CO 3:13" /><verse number="14" style="v" sid="2CO 3:14" />पण ईस्‌रायल ना माणहु नु मन आंदळु हय ज्‌यु काहाके तीहया बी तीहया जुन्‌ला कायदा ने भणे तत्‌यार तीमनु मन बी लुगड़ु ओड रेय अने ह़मज नी आवे; जत्‌यार कोय बी ईसु मसी वगो वळीन तीने मान लेय ता आहयु मन नु लुगड़ु उचु हय जाय अने वारु ह़मज आय जाय। <verse eid="2CO 3:14" /><verse number="15" style="v" sid="2CO 3:15" />अने आज बी तीहया मुसा ना कीताप्‌या मे गेथा भणे ता तीमनु मन लुगड़ु ओड रेय; <verse eid="2CO 3:15" /><verse number="16" style="v" sid="2CO 3:16" />पण जत्‌यार बी तीमनु मन मालीक ईसु भणी वळहे, तत्‌यार तीहया मन नु लुगड़ु उचु हय जाय अने तीमने वारु ह़मज आय जाय। <verse eid="2CO 3:16" /><verse number="17" style="v" sid="2CO 3:17" />हाव ते मालीक ईसु नी चोखली आत्‌मा से; अने आञे ह़ारीक मालीक ईसु नी चोखली आत्‌मा से तां ह़ारीक एवी आखी वात नो छुटकारो से। <verse eid="2CO 3:17" /><verse number="18" style="v" sid="2CO 3:18" />एतरे हाव जेम आरहा पोर दाड़ु नु वीजाळु भबळे तेमेत मालीक भगवान नो बड़ाय आपणा आखा ना उगाड़ला मुख पोर उजन्‌तो हय्‌न भबळे। एम करीन आपणु मालीक ईसु नी आत्‌मा नी लारे ईसु नो बड़ाय भर्‌या सीका मे थोड़ा-थोड़ाक करीन बदलता जाय र्‌या।<verse eid="2CO 3:18" /></para>
  <chapter eid="2CO 3" />
  <chapter number="4" style="c" sid="2CO 4" />
  <para style="s">कादा ना ठाहरा मे धन</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 4:1" />मालीक ईसु नी तेवा बणवा करीन आमने एतरु मोटु बड़ाय भर्‌यु काम भगवान नी दया नी लारेत जड़लु से; एतरे आमु हीम्‌मत नी सोड़या। <verse eid="2CO 4:1" /><verse number="2" style="v" sid="2CO 4:2" />पण आमु लाजे पाड़े एवा काम सोड़ देदला से, अने ढोंगड़ा करीन नी जीवया, अने आमु आह़फात ना नफा जुगु भगवान नी खुस-खबर मे रीकामी वात भेसकीन नी कीया; पण जेम से तेम ने तेम ह़ाची वात ने उजन्‌ती कीया। एतरे जे भगवान अगळ अमारो नीयाव करवा हींडे तीहया माणहु अगळ अमारा कामु उजन्‌ता से, अने आहया काम नी सच्‌चाय ना बारा मे तीहया माणहु नु मन लग गवा देय। <verse eid="2CO 4:2" /><verse number="3" style="v" sid="2CO 4:3" />पण ते बी तीहया जे जलमका खुटवा वाळा से तीमना मन ना डोळा अगळ झीमरु आडु देवाय र्‌यु एतरे ईसु नी खुस-खबर ह़मजीन तीहया भरहो नी करता। <verse eid="2CO 4:3" /><verse number="4" style="v" sid="2CO 4:4" />ईसु पोर भरहो नी करन्‌या आहया माणहु ना मन मे, भगवान ईसु मसी नी बड़ाय भरी खुस-खबर नी भबळवा जोवे, करीन भुतड़ो आहया भगवान ना वीरोद मे आह़फोत भगवान बणीन आहयी कळी मे राज कर र्‌यो, तीहयो तीमना अक्‌कल ना डोळा ने आंदळा कर देदलो से। <verse eid="2CO 4:4" /><verse number="5" style="v" sid="2CO 4:5" />काहाके आमु अमारी खुस-खबर नी ह़मळावया, पण ईसु मसी नी खुस-खबर ह़मळावया; आहयो ईसु मसीत मालीक से; अने अमारा बारा मे आहयुत कीया के आमु ईसु नी लेदे तमारा पावर्‌या से। <verse eid="2CO 4:5" /><verse number="6" style="v" sid="2CO 4:6" />भगवान केदलो हतो के “अंदारला मे वीजाळु हय जाय।” हीयोत भगवान अमारा मन मे भबळीन वीजाळु कर देदलो से, आनीन करते के आमु तीना बड़ाय ने जाण जीया, जे ईसु मसी ना मुख मे गेथु भबळे।<verse eid="2CO 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 4:7" />पण भगवान नु खजानु आपणा आहया कादा ना बण्‌ला डील मे मेल मेल्‌यु जे कादा ना बणला डोसरा ह़रका से, जीनी सी आपणु ने आहयु अकनाय जाय के आहयी बड़ाय नी घणी जुदी ताखत आपणी नी, पण भगवान नी से। <verse eid="2CO 4:7" /><verse number="8" style="v" sid="2CO 4:8" />आमु वेला मे घेरवायला रीया, बाखीन आफत मे नी पड़या। आमु घंगवाय रीया, पण कदी आह नी सोड़या। <verse eid="2CO 4:8" /><verse number="9" style="v" sid="2CO 4:9" />आमु ने वेला ते पाड़े; पण आमने भगवान सोड़े नी; आमु ने पाड़ देय पण आमु जलमकात खुटया नी। <verse eid="2CO 4:9" /><verse number="10" style="v" sid="2CO 4:10" />ईसु नु जीवणु बी अमारा डील मे उजन्‌तु हय जवा जोवे करीन आमु दाड़ीक अमारा डील मे ईसु नी मोत नो दुख भुगतीन अकन्‌या। <verse eid="2CO 4:10" /><verse number="11" style="v" sid="2CO 4:11" />ईसु नी जीवाय बी अमारा डील मे उजन्‌ती हय जवा जोवे करीन आमु जीवतेन ईसु नी करते दुख झेलीन मरे एवा हय जीया। <verse eid="2CO 4:11" /><verse number="12" style="v" sid="2CO 4:12" />मोत ते आमु झेलया पण सुक नी जीवाय तमु जीवे।<verse eid="2CO 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 4:13" />अमारी पांह तीहयीत भरहा नी आत्‌मा से, जीना बारा मे सास्‌तर केय, मे भरहो कर्‌यो एतरे बोल्‌यो। एतरे आमु भरहो करया, भरहो करीनेत बोलया। <verse eid="2CO 4:13" /><verse number="14" style="v" sid="2CO 4:14" />काहाके आमु जाणया के जे भगवान, मालीक ईसु ने मर्‌या-ह़र्‌या मे गेथो पासो जीवाड़लो से। तीहयोत भगवान आमु ने बी मर्‌या-ह़र्‌या मे गेथा पासा जीवाड़ देहे, अने आह़फा अगळ हजुर करहे। <verse eid="2CO 4:14" /><verse number="15" style="v" sid="2CO 4:15" />काहाके आहयु आखु तमारीत करते हय र्‌यु, के जे रीते भगवान नी दया अने बड़ाय जुगु भगवान ने घणो वारु से केवा वाळा नी गीनती बी वदती जवा जोवे।<verse eid="2CO 4:15" /></para>
  <para style="s">भरहा नी लारे जीव्‌वा</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 4:16" />एतरुत नी करते आमु हीम्‌मत नी सोड़या। भले अमारा डील मे नो जोर कमतो हयतो जाय र्‌यो हय ते बी अमारी आत्‌मा दाड़ी-दाड़ीक नवली हयतीत जाय री। <verse eid="2CO 4:16" /><verse number="17" style="v" sid="2CO 4:17" />काहाके अमारी थोड़ीक वार नी हळकली वेला अमारी जुगु घण-जबर फायदा वाळी से अने आहयी आमु ने जलमकी बड़ाय मे जवा करीन मदत आपती जाय। <verse eid="2CO 4:17" /><verse number="18" style="v" sid="2CO 4:18" />एतरे आमु देखली चीज ने नी; पण वण-देख्‌याण चीज ने भरहा नी लारे एकडीट्‌या भाळ रीया; काहाके देखाये तीहयी चीज थोड़ाक दाड़ा तक टेकहे; पण वण-देख्‌याण चीज अमरकाय नी जलमकी बण्‌ली रेय अने रेहे।<verse eid="2CO 4:18" /></para>
  <chapter eid="2CO 4" />
  <chapter number="5" style="c" sid="2CO 5" />
  <para style="s">आपणु ह़रगे नु डील</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 5:1" />आपणु जाणया के जत्‌यार आपणु धरती पोर वाळु डील तम्‌बुन तेम ओदरी जाय ता आमने भगवान वगे गेथु एक एवु डील जड़हे तीहयु डील माणहु ना हाते करीन बणावलु नी रेय; पण ह़रगे नु अने जलमकु टेकलु रेहे। <verse eid="2CO 5:1" /><verse number="2" style="v" sid="2CO 5:2" />हमणे ते आहया डील मे रीन आपणु रड़ी-कलपीन कंजारया, अने घण-जबर हेर करया के ह़रगे नु डील पेर लीया। <verse eid="2CO 5:2" /><verse number="3" style="v" sid="2CO 5:3" />के आने पेरवा सी आमु नांगरला नी देखायवा जोवे। <verse eid="2CO 5:3" /><verse number="4" style="v" sid="2CO 5:4" />अने आपणु आहया तम्‌बु ह़रका डील मे रीन भार मे डबाय्‌न कंजारता फीरया; काहाके आपणु, आहया डील ने उतारीन मरवा नी पण अळी आनी पोर ह़रगे वाळु डील पेरवा नी हेर करया। आपणु आनीन करते आहयी हेर करया के आहयु मरलु डील से तीहयु अमरकाय नी जीवाय मे डुब जवा जोवे। <verse eid="2CO 5:4" /><verse number="5" style="v" sid="2CO 5:5" />अने आहया अमरकाय डील अने अमरकाय जीवाय नी करते भगवान आपणु ने बणावलो से, अने तीहयो आपणु ने चोखली जीव आत्‌मा नी ह़ाय आप देदलो।<verse eid="2CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 5:6" />आहयी धरती पोर रीन आपणु हीम्‌मत राखया अने आहयु जाणया के जत्‌यार लग आपणा घोर ह़रका आहया डील मे रीया तां तक आपणु मालीक ईसु ना रेवा ना जागा गेथा नाम्‌बे से। <verse eid="2CO 5:6" /><verse number="7" style="v" sid="2CO 5:7" />एतरे आपणु मालीक ईसु नो सीक्‌को देखीन नी पण भरहो करीन जीवया। <verse eid="2CO 5:7" /><verse number="8" style="v" sid="2CO 5:8" />एतरे आमु हीम्‌मत राखया अने आमने आहया डील गेथा अलग हय्‌न मालीक भगवान ह़ाते रेवा जादा वारु गमे। <verse eid="2CO 5:8" /><verse number="9" style="v" sid="2CO 5:9" />एतरे अमारी मन नी खुसी आहयी से के भले आमु मालीक ईसु ह़ाते रीया भले तीनी गेथा अलग आहया डील मे रीया पण आमु तीने गमता रेवा जोवे। <verse eid="2CO 5:9" /><verse number="10" style="v" sid="2CO 5:10" /><note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="ROM 14:10">रोमीयो 14:10</ref></char></note>काहाके एक दाड़ो आपणो आखा नो नीयाव मसी नी नीयाव नी गादी अगळ हयहे अने आखा नी जीवाय ना कामु उजन्‌ता हय जहे, तीहयी टेमे आखा ने भला-बुरा काम कर्‌या तीनो हीसाब आपवा पड़हे। अने आह़फा ना डील मे रीन जेम कर्‌या तेम भुगतवा पड़हे।<verse eid="2CO 5:10" /></para>
  <para style="s">ईसु मसी नी लारे भगवान ह़ाते मेळ करवा</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 5:11" />आमु मालीक ईसु नी बीक मानीन माणहु ने ह़मजाड़या अने भगवान अगळ अमारी जीवाय उजन्‌ती से; अने मारी आहयी आह से के तमारु मन मे बी अमारी जीवाय उजन्‌ती से। <verse eid="2CO 5:11" /><verse number="12" style="v" sid="2CO 5:12" />ते बी आमु तमारी अगळ आह़फात अमारी मोटाय नी करया; पण तमने आहयो मोखो आपया के तमु अमारा बारा मे मोटाय करवा जोवे आनीन करते के तमु तीमने जपाप आप सको जे मन नी चोखली वात पोर नी पण माणहु ने देखाड़वा करीन ढोंगड़ाळी वात पोर मोटाय करे। <verse eid="2CO 5:12" /><verse number="13" style="v" sid="2CO 5:13" />कदीम आमु कमजोर से ता, भगवान जुगु; अने कदीम आमु नीचळा से ता तमारी जुगु। <verse eid="2CO 5:13" /><verse number="14" style="v" sid="2CO 5:14" />ईसु मसी नो मोंग आमने कब्‌जा मे कर र्‌यो; काहाके आमु आहयु ह़मजी जेला से के जत्‌यार एक आखा नी करते मर जेलो से, ता आखा मर जेला से। <verse eid="2CO 5:14" /><verse number="15" style="v" sid="2CO 5:15" />एम करीन तीहयो आखा नी करते आनीन करीन मर ज्‌यो, के जे जीवत्‌ला से, तीहया हाव गेथा आह़फा नी करते नी जीव्‌वा जोवे पण तीनी जुगु जीव्‌वा जोवे जे तीमनी जुगु मर ज्‌यो अने अळी पासो मर्‌या-ह़र्‌या मे गेथो जीवतो हय ज्‌यो।<verse eid="2CO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 5:16" />एतरे हाव गेथा आमु कोयने बी माणहु नी वात नी अनसारे नी ह़मजया। आमु ईसु मसी ने बी माणहु नी वात नी अनसारे पेले ह़मजी रेला, ते बी तीने हाव हेम नी ह़मजया। <verse eid="2CO 5:16" /><verse number="17" style="v" sid="2CO 5:17" />एतरे हाव जे कोय ईसु मसी मे से तीहयो नवलो घड़ायलो से: जुन्‌ली वात जत री; अने देखो, तीहयी नवली वात आय लागी। <verse eid="2CO 5:17" /><verse number="18" style="v" sid="2CO 5:18" />अने आहयी आखी वात भगवान वगे गेथी से, आहयो भगवानेत ईसु मसी नी लारे आपणो मेळ आह़फा ह़ाते कर लेदो अने आहयी कळी ना माणहु ने आह़फा ह़ाते मेळ कराव्‌वा नु काम आमने ह़ोप देदु। <verse eid="2CO 5:18" /><verse number="19" style="v" sid="2CO 5:19" />भगवान ईसु मसी नी लारे आहयी कळी ना माणहु ह़ाते मेळ करवा बाज र्‌यो हतो, तीहयी टेमे आहयो भगवान आहयी कळी ना माणहु पोर गुनो लगाड़ीन वाक नी काड्‌यो अने हाव तीहयो आमने तीनी खुस-खबर नी लारे आह़फा ह़ाते मेळ करवा नु काम आमने ह़ोप देदो।<verse eid="2CO 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 5:20" />हाव ते आमु ईसु मसी ना दुत से, भगवान अमारी लारे तमारी पांह रावण्‌या कर र्‌यो, मसी भणी गेथी तमारी पांह अमारी रावण्‌या करया के भगवान ह़ाते मेळ कर लेवो। <verse eid="2CO 5:20" /><verse number="21" style="v" sid="2CO 5:21" />जे पाप गेथो अंजाण्‌यो हतो तीहयात ईसु मसी पोर भगवान आपणा आखा पाप नो भार मेल देदो अने एक कीया मे तीने पाप बणाय देदो। आनीन करते के आपणु तीनी मे हय्‌न भगवान नो धरम बण जीया।<verse eid="2CO 5:21" /></para>
  <chapter eid="2CO 5" />
  <chapter number="6" style="c" sid="2CO 6" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 6:1" />आमु भगवान नी ह़ाते काम करन्‌या से करीन आमु तमने रावण्‌या करीन कीया, के भगवान नी आहयी दया तमारी पोर हयली से तीहयी दया ने रीकामी ना हयवा देवो। <verse eid="2CO 6:1" /><verse number="2" style="v" sid="2CO 6:2" />काहाके भगवान केय,</para>
  <para style="q1" vid="2CO 6:2">“जे टेमे वीन्‌ती ह़मळवा जोवे तीहयीत टेमे वीन्‌ती ह़मळी लेदो,</para>
  <para style="q2" vid="2CO 6:2">अने छुटकारा ना दाड़ेते मदत करवा आयो।”</para>
  <para style="m" vid="2CO 6:2">अने ह़मळो, भगवान नी वगे गेथो छुटकारो जड़वा नो दाड़ो आजेत से।<verse eid="2CO 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2CO 6:3" />आमु कानी बी वात मे ठोकर खावा नो कंय मोखो नी आपया जीनी सी अमारी सेवा ना काम पोर आच आवे। <verse eid="2CO 6:3" /><verse number="4" style="v" sid="2CO 6:4" />पण आखी वात मे भगवान ना चाकर्‌यान तेम आह़फा ना वारला गुण ने उजन्‌ता करया, अने आखी भाती ना दुख, वेला अने आफत ने घण-जबर गम खाय्‌न वेठया। <verse eid="2CO 6:4" /><verse number="5" style="v" sid="2CO 6:5" /><note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="ACT 16:23">नेवताळा ना काम 16:23</ref></char></note>आमने ह़ड़का देय ते बी, आमने जेल मे कुंड देय ते बी, अमारी भणी जोर करीन आवे ते बी, काठु काम करे ते बी, जागला रीया ते बी, अने उपाह़ पाळया। <verse eid="2CO 6:5" /><verse number="6" style="v" sid="2CO 6:6" />चोखला रीन, अक्‌कल देखाड़ीन, गम खाय्‌न, बीजा पोर दया करता जाय्‌न, चोखली आत्‌मा नी, ताखत सी खरलो मोंग देखाड़या। <verse eid="2CO 6:6" /><verse number="7" style="v" sid="2CO 6:7" />सच्‌चाय ना बोलु मे, भगवान नी ताखत सी; अने धरम नो हत्‌यार जमणा अने डाखर्‌या हात मे लीन, <verse eid="2CO 6:7" /><verse number="8" style="v" sid="2CO 6:8" />अमारी ईज्‌जत करे, नी करे ते बी, अमारु नामबद्‌दी करे ते बी, अने आमु नामह़ाद्‌या हवया ते बी, भले आमु बीजा ने ठगण्‌यान तेवा लागया पण ते बी सच्‌चाय सी बोलया। <verse eid="2CO 6:8" /><verse number="9" style="v" sid="2CO 6:9" />आमु अंजाण्‌यान तेवा से; ते बी जे आमने ह़मजे तीमनी अगळ आमु नामह़ाद्‌या से; आमु मार खाया, पण मर्‌या नी; आमु बीजा माणहु नी लारे डंड भुक्‌ती र्‌या पण ते बी आमु नी मरता। <verse eid="2CO 6:9" /><verse number="10" style="v" sid="2CO 6:10" />अमारी कळ-कळीन नी वीत री; पण आमु जलम खुस रीया, गरीब ने तेवा से; पण ढेरेत माणहु ने ईसु मे मालदार बणाय दीया; अमारु से एम करीन केवा जुगु अमारी पांह कंय नी हय ते बी जे जोवे तीहयु आखु अमारी पांह से।<verse eid="2CO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 6:11" />ए कुरन्‌थी वाळा, आमु अमारा मन नी वात ह़ोदी-ह़ोदीन की देदला से, आमु तमने घण-जबर मोंग करया। <verse eid="2CO 6:11" /><verse number="12" style="v" sid="2CO 6:12" />आमु मोंग करवा नी छोड़्‌या पण तमुत आह़फा तमारा मन मे आमने मोंग करवा वचकी र्‌या। <verse eid="2CO 6:12" /><verse number="13" style="v" sid="2CO 6:13" />पण आमु अमारा सोरा ह़मजीन तमने कीया, के तमु बी अमारीन तेम तमारु मन उगाड़ीन आमने मोंग करो।<verse eid="2CO 6:13" /></para>
  <para style="s">आमु जीवत्‌ला भगवान ना मंदीर से</para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 6:14" />जे ईसु पोर भरहो नी करे तीमनी ह़ाते ना भेसकायो, काहाके धरम अने अधरम, वीजाळु अने अंदारलु मेळ खाय ह़ु? <verse eid="2CO 6:14" /><verse number="15" style="v" sid="2CO 6:15" />ईसु मसी भुतड़ा ह़ाते दोस्‌ती करे ह़ु? ईसु पोर भरहो नी करन्‌या अने ईसु पोर भरहो करन्‌या साजल्‌या बणे ह़ु? <verse eid="2CO 6:15" /><verse number="16" style="v" sid="2CO 6:16" /><note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 कुरन्‌थी 3:16</ref>; <ref loc="1CO 6:19">6:19</ref></char></note>वण-जीव्‌या मुरत्‌या ह़ाते जीवत्‌ला भगवान ना मंदीर नु ह़ु लेणु-देणु से? काहाके आपणु ते जीवत्‌ला भगवान ना मंदीर से; जेम भगवान केदलो बी से के,</para>
  <para style="q1" vid="2CO 6:16">“मे तीमनी मे रेही अने तीमनी मे रीन हींड्‌या-फीर्‌या करही;</para>
  <para style="q2" vid="2CO 6:16">अने मे तीमनो भगवान केवायही, अने तीहया मारा माणहु केवायहे।”<verse eid="2CO 6:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="2CO 6:17" />एतरे मालीक केय, के</para>
  <para style="q1" vid="2CO 6:17">“तीमनी वच मे गेथा नीकळो अने अलग हय जावो;</para>
  <para style="q2" vid="2CO 6:17">अने वीटळ्‌ळी चीज ने ना छीमो, ता मे तमने आवरी लेही;<verse eid="2CO 6:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="2CO 6:18" />अने मे तमारो बाह बणही,</para>
  <para style="q2" vid="2CO 6:18">अने तमु मारा सोरा-सोरी बणहु:</para>
  <para style="q2" vid="2CO 6:18">आखा मे जोरभर्‌यो मालीक भगवान आहयुत केय।”<verse eid="2CO 6:18" /></para>
  <chapter eid="2CO 6" />
  <chapter number="7" style="c" sid="2CO 7" />
  <para style="p">
    <verse number="1" style="v" sid="2CO 7:1" />एतरे ए मोंगाळ्‌ळा भायु अने बेन्‌या, एतरो मोटो वायदो भगवान कर्‌यो ता आवो आखा मेळीन आह़फा ना डील ना अने आत्‌मा ना आखा पाप ने सेटा करीन चोखा हय जता अने भगवान नी बीक मान्‌ता जाय्‌न चोखलापणा मे रीन पक्‌का हय जता।<verse eid="2CO 7:1" /></para>
  <para style="s">पोलुस नी खुसी</para>
  <para style="p">
    <verse number="2" style="v" sid="2CO 7:2" />आमने आह़फाम ना मन मे जागो आपो। आमु नी ते कोय ह़ाते गलत वेहवार कर्‌या, अने नी कोयने बगाड़्‌या, अने नी कोयने ठग्‌या। <verse eid="2CO 7:2" /><verse number="3" style="v" sid="2CO 7:3" />मे तमने गुनाळ्‌ळो ठेराव्‌वा करीन आहयु नी केतो। काहाके मे पेलेत की देदलो के तमु अमारा मन मे ईसम बह जेला से के आमु तमारी ह़ाते मरवा-जीव्‌वा तीयार से। <verse eid="2CO 7:3" /><verse number="4" style="v" sid="2CO 7:4" />मारो तमारी पोर घण जबर भरहो से; अने मे तमारी पोर घण-जबर मोटाय करु। ते बी हाव मने तमारी पांह गेथी हीम्‌मत जड़ जी; आखी वेला मे बी घण-जबर खुस रीया।<verse eid="2CO 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 7:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:5 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 2:13">2 कुरन्‌थी 2:13</ref>
      </char>
    </note>काहाके जत्‌यार आमु मकीदुनीया मे आवला, ते बी अमारा डील ने अराम नी जड़्‌यो, पण आमु ने च्‌यारो-मेर गेथो दुख जड़लो से; बारी अड़चन हती, अने मोय डील मे बीक हती। <verse eid="2CO 7:5" /><verse number="6" style="v" sid="2CO 7:6" />ते बी दुखी माणहु ने सांती आपण्‌यो भगवान तीतुस आयो एतरे आमने सांती आप्‌यो; <verse eid="2CO 7:6" /><verse number="7" style="v" sid="2CO 7:7" />अने तीतुस आयो करीन एतरोत नी पण तीनी तीहयी सांती सी बी, जे तीने तमारीन्‌तां गेथी जड़ली हती। आहयु ह़मळीन मने घणी सांती अने हीम्‌मत जड़ी, अने तीहयो तीतुस आहयु केदो के तमारा दुख अने मारी जुगु फीकर कर्‌या अने हाव मने भेटवा करीन मारी केतरी जबर हेर कर र्‌या। आहयु आखु ह़मळीन मे अळी जादा खुस हय ज्‌यो।<verse eid="2CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 7:8" />काहाके मे मारी चीट्‌ठी नी लारे तमने दुखी कर्‌यो, पण मे आनी सी पछतातो नी जेम मे पेले पछतातो हतो, काहाके मे देखु के तीहयी चीट्‌ठी नी लारे तमने दुख ते हयो पण तीहयो थोड़ीक वार लग नो हतो। <verse eid="2CO 7:8" /><verse number="9" style="v" sid="2CO 7:9" />हाव मे खुस से पण आनीन करते नी के तमने दुख हयो, पण आनीन करते के तमु तीहया दुख नी लारे मन फीराया, काहाके तमारो दुख भगवान नी मरजी नी अनसारे हतो के अमारी भणी गेथु तमने कानी बी वात मे कंय बी नुकसान नी हयवा जोवे। <verse eid="2CO 7:9" /><verse number="10" style="v" sid="2CO 7:10" />काहाके जे दुख भगवान नी मरजी नी अनसारे हयो तीहयो दुख एवो पस्‌तावो करे के तीने छुटकारो जड़े अने एवो पछतावो मे काहा कर्‌यो करीन अळी पछतावो नी करवा पड़े। पण आहयी कळी ना दुख ते मोत ने पयदा करे। <verse eid="2CO 7:10" /><verse number="11" style="v" sid="2CO 7:11" />भगवान नी वगे गेथो जे दुख तमने हयो तीहयो दुख तमारी मे ह़ु-ह़ु वारली वात पयदा कर्‌यो आहयु अकनी लेवो। आहयो दुख तमारी मे आत्‌मा नी फीकर मे पाड़ देदो, हाव तमु आह़फा ना बारा मे आहयु केवा तीयार से के अमारु मन चोखलु से, गलत काम नी करवा जोवे करीन रीह करवा जोवे भगवान नी बीक मे रेवा जोवे, भगवान नी हेर करवा जोवे, अने गलत वात मे नीयाव करवा जोवे, एम करीन तमु आखी रीते आहयु आखु देखाड़ देदा के आमु वण-गुनाळ्‌ळा से।<verse eid="2CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 7:12" />आहयी चीट्‌ठी जे गलत वेहवार करे तीनी जुगु नी लीख्‌यो अने तीनी जुगु बी नी लीख्‌यो जीना वीरोद मे गलत वेहवार कर्‌यो पण तमारी जुगु आनीन करते लीख्‌यो के तमु भगवान अगळ आहयु जाण लेवो के तमु मारी फीकर घण-जबर कर र्‌या। <verse eid="2CO 7:12" /><verse number="13" style="v" sid="2CO 7:13" />करीन आमने सांती जड़ी। अमारी आहयी सांती नी ह़ाते तीतुस नी खुसी नी कारण सी अळी बी खुसी हयी काहाके तीनो जीव तमु आखा ना कारण सी अळी जादा खुस हय ज्‌यो। <verse eid="2CO 7:13" /><verse number="14" style="v" sid="2CO 7:14" />कदीम मे तीतुस अगळ तमारा बारा मे मोटाय कर्‌यो, ता मने तीनी जुगु लजवायवा नी पड़्‌यु, जेम जे कंय मे तमने केदलो तीहयु ह़ाचलीन हतु, आहयीत रीते तीतुस अगळ मारी मोटाय करवु तेमेत नीकळी। <verse eid="2CO 7:14" /><verse number="15" style="v" sid="2CO 7:15" />तमु आखा बीहता अने कापता जाय्‌न तीतुस नो आव-भाव कर्‌या अने तीनी वात मान्‌या, आहयी वात ने तीतुस जत्‌यार फोम करे ता तीहयो घण-जबर मोंग सी भराय्‌न तमने पेले गेथो जादा मोंग कर र्‌यो <verse eid="2CO 7:15" /><verse number="16" style="v" sid="2CO 7:16" />मे आनीन करते खुस से काहाके आखी वात मे तमारी पोर भरहो कर सकु।<verse eid="2CO 7:16" /></para>
  <chapter eid="2CO 7" />
  <chapter number="8" style="c" sid="2CO 8" />
  <para style="s">ईसु पोर भरहो करन्‌या माणहु नु दान आपणु</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 8:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:26">रोमीयो 15:26</ref>
      </char>
    </note>हाव ए ईसु पोर भरहो करन्‌या भाय अने बेन्‌या, आमु तमने भगवान नी तीहयी संयबरकत ना बारा मे खबर आपया, जे भगवान मकीदुनीया ना मंडळ्‌या पोर देखाड़्‌यो। <verse eid="2CO 8:1" /><verse number="2" style="v" sid="2CO 8:2" />ईसु पोर भरहो करन्‌या ने वेला पाड़्‌या, ते बी आहया मकीदुनीया वाळा घण-जबर गरबाय मे बी मदत करवा नी वचक्‌या पण घण-जबर खुस हय्‌न भेट करवा मे मदत कर्‌या। <verse eid="2CO 8:2" /><verse number="3" style="v" sid="2CO 8:3" />मे आहयी वात नो गवा से के तीहया जेतरु अपाये हेतरु आप्‌या, अने ईन गेथु बी जादा खुस हय्‌न आप्‌या। <verse eid="2CO 8:3" /><verse number="4" style="v" sid="2CO 8:4" />तीहया आह़फात वळ-वळीन रावण्‌या करीन केदा के भगवान ना माणहु जुगु दान आपीन तीमनी चाकरी करवा करीन आमने वारलो मोखो आपो। <verse eid="2CO 8:4" /><verse number="5" style="v" sid="2CO 8:5" />तीहया ते पेले आह़फाम नेत मालीक ईसु ना हात मे ह़ोप देदा, अने अळतेण भगवान नी मरजी नी अनसारे आह़फा ने अमारा हात मे ह़ोप देदा। एतरो वारु वीच्‌यार करीन तीहया दान आपहे एवी आह आमु नी कर्‌या। <verse eid="2CO 8:5" /><verse number="6" style="v" sid="2CO 8:6" />एतरे आमु तीतुस ने वीन्‌ती कर्‌या के जेम पेले दान नु काम तीहयो सुरु करलो तेमेत तमारी वच मे दान आपवा नु संयबरकत नु आहयु काम पुरु करे। <verse eid="2CO 8:6" /><verse number="7" style="v" sid="2CO 8:7" />पण जेम एक-एक वात मे मतलब भरहा मे, भगवान ना बोलु मे, अक्‌कल मे अने आखी भाती नी कोसीत करवा मे, अने तीहया मोंग मे जे अमारी ह़ाते राखे, वदता जाय, तेमेत आहया दान ना काम मे बी वदता जावो।<verse eid="2CO 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2CO 8:8" />मे तमने आना बारा मे हुकम नी आपतो, पण बीजा माणहु हेर करीन दान आप र्‌या तीहयी वात ने देखाड़ीन मे तमने आहयु देखाड़वा हींड र्‌यो के तमु बी तीमनीन तेम दान करीन आह़फाम ना मोंग ने उजन्‌तो करो। <verse eid="2CO 8:8" /><verse number="9" style="v" sid="2CO 8:9" />तमु ते आपणा मालीक ईसु मसी नी दया ने जाणो ते खरा; तीहयो मालदार हतो पण तमारीन करते आनीन करते गरीब बण्‌यो के तमु तीनी गरबाय नी लारे मालदार बण जावो।<verse eid="2CO 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2CO 8:10" />आहयी वात मे मारी ह़ला आहयी से: आहयु तमारी जुगु वारु से: ज्‌या साल भेट आप्‌या अने दान आपवा नी हेर मे तमु अगळ हता। <verse eid="2CO 8:10" /><verse number="11" style="v" sid="2CO 8:11" />एतरे जे काम सुरु करला हता, तीने पुरु करो के जेम हेर करवा मे तीयार बी हता, तेमेत आपणी-आपणी कमाय नी अनसारे पुरु बी करो। <verse eid="2CO 8:11" /><verse number="12" style="v" sid="2CO 8:12" />एम ना वीच्‌यार करो के तमारी पांह जे से तीनी गेथु जादा आपवा पड़हे। पण दान आपवा नी मन मे हेर हय ता भगवान बी आपणा दान ने जे आपणी पांह से तीहयु अवरी लेहे। तीहयो एवो भगवान नी हय जे, आपणी पांह नी हय, तीहयु मांगे। <verse eid="2CO 8:12" /><verse number="13" style="v" sid="2CO 8:13" />आहयी दान नी वात मे तमने आनीन करते नी केतो, के बीजा मजा करवा जोवे अने तमने वेला करवा पड़े। <verse eid="2CO 8:13" /><verse number="14" style="v" sid="2CO 8:14" />आहयी टेमे तमारी पांह जादा से ता, जीमनी जरवत से तीमनी मदत करवा जोवे, जीनी सी काना दाड़े तीमनी पांह जादा रेहे अने तमने जरवत पड़हे ता तमारी मदत कर देहे। अने आहयी रीते आपणु आखा मेळीन आंबा-सांबा साजल्‌या बण जीया, <verse eid="2CO 8:14" /><verse number="15" style="v" sid="2CO 8:15" />जेम भगवान ना कीताप्‌या मे बी लीखलु से, “जे जादा ह़ेमटी लेदलो तीनी पांह वदु नी नीकळ्‌यु, अने जे कम ह़ेमट्‌लो हतो तीनी पांह कम नी नीकळ्‌यु।”<verse eid="2CO 8:15" /></para>
  <para style="s">तीतुस ने कुरन्‌थी ह़ेर मे मोकले</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 8:16" />भगवान ने मे घणो वारु से केम जे तीतुस ना मन मे तमारी मदत करवा नी हेर पयदा कर देदो जेम तमारी मदत करवा करीन अमारा मन मे हेर हती। <verse eid="2CO 8:16" /><verse number="17" style="v" sid="2CO 8:17" />आमु ह़मजाड़्‌या ता तीहयो मान ज्‌यो अने घण हेर सी आह़फा नी मरजी सी तमारीन्‌तां आव्‌वा नी हेर कर्‌यो। <verse eid="2CO 8:17" /><verse number="18" style="v" sid="2CO 8:18" />अने आमु तीनी ह़ाते तीहया भाय ने बी मोकल्‌ला से जे खुस-खबर ह़मळावीन ह़ीकाड़वा मे आखी मंडळी मे नामह़ाद्‌यो से। <verse eid="2CO 8:18" /><verse number="19" style="v" sid="2CO 8:19" />अने एतरुत नी पण मंडळी ना माणहु तीने आहया दान ना काम नी करते टाळ बी लेदला से के तीहयो आहया काम नी करते अमारी ह़ाते जवा जोवे अने आमु आहयी सेवा आनीन करते करया के मालीक ईसु नी बड़ाय अने दान आपवा मे अमारा मन नी तीयारी बी उजन्‌ती हय जवा जोवे।<verse eid="2CO 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2CO 8:20" />आमु आहयी वात मे चेतीन रीया के आहया दान ना काम ना बारा मे जीनी सेवा आमु कर र्‌या, कोय अमारी पोर गुनो नी लगाड़वा जोवे। <verse eid="2CO 8:20" /><verse number="21" style="v" sid="2CO 8:21" />मालीक ईसु अने माणहु नी नींगा मे आहयी वात वारली से तीहयीत वात ना बारा मे आमु फीकर करया।<verse eid="2CO 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2CO 8:22" />आमु तीतुस ह़ाते एक जणा ने अळी मोकल्‌ला से, जे ईसु पोर भरहो करे, तीने आमु आखी वात मे पारख्‌या, तीहयो आखी वात मे काम करवा नी हेर करे; पण तीहयो आहयी वात मे तमारी पोर जादा भरहो करे, एतरे तीहयो अळी बी जादा दान भेळु करवा नु काम मे घण-जबर हेर सी भराय र्‌यो। <verse eid="2CO 8:22" /><verse number="23" style="v" sid="2CO 8:23" />कदीम कोय मने तीतुस ना बारा मे पुछे, ता मे तीना बारा मे केही, के तीहयो मारो ह़ाती से, अने तमारी जुगु मारा काम मे मारो सात देण्‌यो से, अने कदीम कोय तीनी ह़ाते आवला भाय ना बारा मे पुछे, ता मे केही के तीहया मंडळी नी लारे मोकल्‌ला से अने ईसु मसी नी बड़ाय से। <verse eid="2CO 8:23" /><verse number="24" style="v" sid="2CO 8:24" />एतरे तमु मंडळी मे आहया दान ना काम ने करीन आह़फा नो मोंग देखाड़ो अने आहयु बी देखाड़ो के आमु तमारी पोर आहया दान नु काम ना बारा मे घण-जबर मोटाय करया।<verse eid="2CO 8:24" /></para>
  <chapter eid="2CO 8" />
  <chapter number="9" style="c" sid="2CO 9" />
  <para style="s">ह़ाती मसी माणहु जुगु मदत</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 9:1" />हाव, तमु दान आपीन युहद्‌या ना माणहु जुगु आहयी सेवा कर्‌या, तीहया दान नी सेवा ना बारा मे अळी अगु नी लीखतो। <verse eid="2CO 9:1" /><verse number="2" style="v" sid="2CO 9:2" />काहाके मे तमारा मन नी तीयारी ने जाणु के तमु दान आपवा तीयार से, अने जे दान नी सेवा ना बारा मे मे मकीदुनीया वाळा ईसु पोर भरहो करन्‌या अगळ मोटाय बी करु, के अखाया मे रेवा वाळा माणहु एक साल गेथा तीयार से, अने तमारी दान आपवा नी हेर अळी ढेरेत जणा ना मन मे बी हेर पयदा कर देदली से। <verse eid="2CO 9:2" /><verse number="3" style="v" sid="2CO 9:3" />पण मे ईसु पोर भरहो करन्‌या भाय-बेन्‌या ह़ाती ने आनीन करते मोकल्‌लो से के आमु जे तमारा बारा मे मोटाय करला हता, तीहयी मोटाय वायबार नी जवा जोवे; पण जीसम मे केदलो हतो तेमेत तमु तीयार से। <verse eid="2CO 9:3" /><verse number="4" style="v" sid="2CO 9:4" />कंय माय्‌न ईसम नी हयवा जोवे के कानो मकीदुनीया रेवा वाळो अमारी ह़ाते आवे अने तमने तीयार नी देखीन आमने अने तमने लजवायवा पड़े काहाके आमु तमारा बारा मे पेले सी भरहो कराय नाखला हता के तमु दान आपवा मे घणा वारु से। <verse eid="2CO 9:4" /><verse number="5" style="v" sid="2CO 9:5" />एतरे मे भायु नी लारे आहयी वात पेलेत की देवा वारु ह़मज्‌यो, के तीहया पेले तमारीन्‌तां आवीन दान आपवा ना बारा मे कीन तमने तीयार करे, जीना बारा मे तमने पेलेत की देदलो हतो, आहयु दान नु काम जोर करीन मांगवा नी जोवे पण खुसी सी आपवा जोवे।<verse eid="2CO 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2CO 9:6" />फोम राखजो: जे कमतु वेरहे तीहयो कमतुत वाडहे, अने जे जादा वेरहे तीहयो जादा वाडहे। <verse eid="2CO 9:6" /><verse number="7" style="v" sid="2CO 9:7" />जे बी माणेह जेतरु बी दान आपवा नो मन मे वीच्‌यार कर र्‌यो हय तेतरुत दान आपवा जोवे, काला-वीला जीव करीन नी आपवा जोवे, अने नी आपवा नु मन हय ते बी जबरजस्‌ती नी आपवा जोवे, काहाके जे खुसी सी आपे भगवान तीनेत मोंग करे। <verse eid="2CO 9:7" /><verse number="8" style="v" sid="2CO 9:8" />अने भगवान आखी भाती नी संयबरकत तमने आप सके, जीनी सी तमु आखी वात मे अने आखी टेमे, जे जोवे तीहयु आखु तमारी पांह रेवा जोवे, अने बीजा नु भलु करवा जुगु तमारी पांह ढेरेत रेवा जोवे। <verse eid="2CO 9:8" /><verse number="9" style="v" sid="2CO 9:9" />जेम सास्‌तर केय</para>
  <para style="q1" vid="2CO 9:9">“तीहयो भलाय सी, गरीब ने आप देदो,</para>
  <para style="q2" vid="2CO 9:9">तीनी भलाय जलम बणली रेहे।”<verse eid="2CO 9:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="2CO 9:10" />एतरे जे वेरवा वाळा ने बीज अने खावा वाळा ने रोट्‌लो आपे, तीहयो तमने वेरवा करीन बीज आपहे अने तमारा भलाय ना काम नी सेवा वदाड़हे। <verse eid="2CO 9:10" /><verse number="11" style="v" sid="2CO 9:11" />तत्‌यार तमु आखी वात मे आखी भाते मालदार बणावहे; अने एम करीन के तीहया भगवान ने घणो वारु कीया करे। <verse eid="2CO 9:11" /><verse number="12" style="v" sid="2CO 9:12" />दान नी आहयी सेवा करवा सी भगवान ना चोखला माणहु नी जरवत पुरी हये, अने तीमना मन मे भगवान ने घणो वारु से केवा नु मन हयतु जाय। <verse eid="2CO 9:12" /><verse number="13" style="v" sid="2CO 9:13" />आहया दान नी सेवा भगवान वगे गेथीत से करीन तीहया भगवान ना गुण गावहे, काहाके तमु ईसु मसी नी खुस-खबर ने मन मे उतारीन तीनी वात मानीन तीना हक मे रेवो, अने ईसु मसी नी अने नीचळा मन सी दान आपीन आखा नी मदत करवा तीयार रेवो। <verse eid="2CO 9:13" /><verse number="14" style="v" sid="2CO 9:14" />अने एम करीन तीहया बी तमारी जुगु वीन्‌ती करे; अने तमारी पोर भगवान नी संयबरकत उजन्‌ती हयी करीन तमारी हेर बी करे। <verse eid="2CO 9:14" /><verse number="15" style="v" sid="2CO 9:15" />एतरे आवो, आपणु भगवान ने घणो वारु से कीया जीनी कीमत गीणाये नी एतरी से।<verse eid="2CO 9:15" /></para>
  <chapter eid="2CO 9" />
  <chapter number="10" style="c" sid="2CO 10" />
  <para style="s">पोलुस नो हक</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 10:1" />हाव मे तीहयोत पोलुस, जे तमारी अगळ ईसु मसीन तेम नीचळो अने भोळो से, पण तमारी मे एवा माणहु बी से जे आहयु कीन गुनो लगाड़े के जत्‌यार पोलुस तमारी अगळ रेय ता नीचळो अने भोळो हय जाय पण जत्‌यार तमारीन्‌तां गेथो जत रेय ता चीट्‌ठी मे लीखीन आहयु देखाड़े के मे घण डहवाळो से। <verse eid="2CO 10:1" /><verse number="2" style="v" sid="2CO 10:2" />एतरे मे तमारी पांह वीन्‌ती करु के तमारी अगळ मने डहवाय नी करवा पड़े; जेम मे ढेरेत माणहु अगळ डहवाय करवा नो वीच्‌यार करु जे आमने कळी नी रीतीन अनसारे माणहुन तेवा जीव्‌वा वाळा ह़मजे। <verse eid="2CO 10:2" /><verse number="3" style="v" sid="2CO 10:3" />भले आमु कळी मे रीन जीवया ते बी कळी नी अनसारे झगड़ो नी करया। <verse eid="2CO 10:3" /><verse number="4" style="v" sid="2CO 10:4" />काहाके अमारा झगड़ा नो हत्‌यार डील नी रखवाळी करन्‌या हत्‌यार ह़रकु नी हय, पण भुतड़ा ना वण-देख्‌या ठीया ने ओदारवा करीन भगवान नी लारे आपला ताखत वाळा वण-देख्‌या हत्‌यार से। <verse eid="2CO 10:4" /><verse number="5" style="v" sid="2CO 10:5" />ह़ाचलीन, आमु आहया हत्‌यार नी लारे माणहु ना एक-एक मोटाय ना वीच्‌यार ने अने भगवान ने जाणवा नी देवा वाळा माणहु ना वीच्‌यार ने, अने आखा गलत वीच्‌यार ने बांदीन मसी नो हुकम मानवा वाळा बणाय दीया। <verse eid="2CO 10:5" /><verse number="6" style="v" sid="2CO 10:6" />एम करीन तमु ईसु ना आखा हुकम पाळहु ता जे हुकम नी माने तीमनो आमु बदलो ली लेहु।<verse eid="2CO 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 10:7" />तमु ते तीहयी चीज ने एतरात देखो जे तमारा डोळा अगळ देखाये, मन नी वात तमु नी जाणो। कदीम तमारी माय्‌न कोयने आहयो भरहो से के मे ईसु मसी नो से, ता तीहयो आहयु बी जाण लेवा जोवे के जेम तीहयो ईसु मसी नो से तेमेत आमु बी से। <verse eid="2CO 10:7" /><verse number="8" style="v" sid="2CO 10:8" />मालीक ईसु जे हक आमने आपलो से तीहयो हक तमने बगाड़वा करीन नी पण ह़ुदारवा करीन आपलो से मे आहया हक पोर मोटाय करही अने लजवायु नी। <verse eid="2CO 10:8" /><verse number="9" style="v" sid="2CO 10:9" />मे आनीन करते की र्‌यो के तमने आसम नी लागवा जोवे के तमने मारी चीट्‌ठी नी लारे बीहाड़ र्‌यो। <verse eid="2CO 10:9" /><verse number="10" style="v" sid="2CO 10:10" />काहाके तीमनु केणु पड़े के “तीना चीट्‌ठ्‌या ते घणा जुदा अने घणा ताखत वाळा से; पण जत्‌यार तीहयो आवीन वात देखाड़्‌यो ता कमजोर अने कोयने गमे नी एवी से।” <verse eid="2CO 10:10" /><verse number="11" style="v" sid="2CO 10:11" />एतरे जे बी आसम की र्‌या, तीहया आहयु जाण लेवा जोवे के आमु सेटा रीन जे बी चीट्‌ठ्‌या मे लीखया; तीहयु आमु तमारीन्‌तां आवया ता तेमेत काम करीन बी देखाड़या।<verse eid="2CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 10:12" />आमु तीहया माणहु ह़ाते गीणायवा हीम्‌मत नी करया जे आह़फा ने वारु ह़मजे; पण जत्‌यार तीहया आह़फा ने आह़फा ना ह़ाते तोले ता तीमने मालम पड़ जाय के तीहया केतरा वण-अकल्‌या से। <verse eid="2CO 10:12" /><verse number="13" style="v" sid="2CO 10:13" />पण आमने जेतरी वात करवा जोवे तेतरीत करहु वात ना गोफण-गोळा सोड़ीन मोटाय नी करया पण भगवान आमने जे-जे केवा नु काम ह़ोप देदलो से तीहयुत केहु; आहयीत वात तमने बी की देदला से अने आहयी वात मेत मोटाय करया। <verse eid="2CO 10:13" /><verse number="14" style="v" sid="2CO 10:14" />आमु जेतरी जागे खुस-खबर नु काम करला से तीहयी वात पोर एतरात मोटाय करहु, आमु तमारी पोर बी मोटाय करहु काहाके आमु तमारीन्‌तां मसी नी खुस-खबर पेले लाया। <verse eid="2CO 10:14" /><verse number="15" style="v" sid="2CO 10:15" />जां ह़ारीक बीजा माणहु जाय्‌न खुस-खबर ह़मळाया तीहयी वात पोर आमु मोटाय नी करया, अने आमने आह से के जेम-जेम तमारो भरहो ईसु पोर वदतो जहे तेम-तेम तमारी लारे भरहो वदहे। तेम-तेम भरहा मे तमारी लारे वदती जहे। <verse eid="2CO 10:15" /><verse number="16" style="v" sid="2CO 10:16" />अने आमु तमारी काकड़ सेकीन बी खुस-खबर ह़मळावहु, अने जां ह़ारीक बीजा खुस-खबर ह़मळावा नु काम कर्‌या तीहया कामु पोर मोटाय नी करया।<verse eid="2CO 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2CO 10:17" />जेम खरला सास्‌तर मे बी लीखलु से, “मोटाय करवा हय, ता मालीक भगवान पोरेत करो।” <verse eid="2CO 10:17" /><verse number="18" style="v" sid="2CO 10:18" />काहाके जे आह़फा नी बड़ाय आह़फोत करे तीनी पोर नी; पण जीनी बड़ाय मालीक करे भगवान तीनेत अवरे।<verse eid="2CO 10:18" /></para>
  <chapter eid="2CO 10" />
  <chapter number="11" style="c" sid="2CO 11" />
  <para style="s">पोलुस अने झुटा नेवताळा</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 11:1" />भले मारी मोटाय नी वात तमने गंडवायला माणहु ह़रकी लागे, ते बी मारी गंडवायली वात ने वेठ लेवो। <verse eid="2CO 11:1" /><verse number="2" style="v" sid="2CO 11:2" />काहाके मे तमारी जुगु भगवान ने तेम घण-जबर फीकर कर र्‌यो। काहाके मे एकीत माणेह ह़ाते तमारी ह़गाय करवा नी बोली करलो से अने तीहयु माणेह मसी से, मे आनीन करते आहयी वेवा नी वात करलो से मे एक कुवारी चोखली सोरीन तेम तीना हात मे ह़ोप देम। <verse eid="2CO 11:2" /><verse number="3" style="v" sid="2CO 11:3" />पण मने बीक लाग री के कंखर माय्‌न जेम गड़हो पेल्‌ना वारा मे जेम हवा ने कदर करीन ठग लेदलो तेम तमने ते नी ठग लेय अने तमारा मन ने ईसु मसी नी चोखली भक्‌ती गेथा सेटा ते नी कर देय। <verse eid="2CO 11:3" /><verse number="4" style="v" sid="2CO 11:4" />काहाके कदीम कोय आवीन बीजा ईसु ना बारा मे केय, जीना बारा मे आमु कोयने नी केदा; नीता कदीम बीजी आत्‌मा जड़ जाय, जे पेले नी जड़ी हय; नीता कंखर माय्‌न बीजीत खुस-खबर ह़मळ्‌या हय, जे खुस-खबर ने तमु पेले नी मान्‌या हय; ता तमु तीनी वात ह़ेल्‌येत मान लेवो।<verse eid="2CO 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 11:5" />मे आहयु ह़मजु के मे कानी बी वात मे मोटा सी मोटा नेवताळा गेथो कम नी हय। <verse eid="2CO 11:5" /><verse number="6" style="v" sid="2CO 11:6" />भले मने वारु बोलाये नी; ते बी अक्‌कल वाळो से, मे आहयी सच्‌चाय नी वात, आखी भाते ह़ीकापण नी लारे, पुरावो दीन तमारी आखा अगळ उजन्‌ती कर देदलो से।<verse eid="2CO 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2CO 11:7" />तमने भगवान नी नींगा मे मोट्‌ला बणाव्‌वा करीन मे पय्‌हा लेदा वगर, भगवान नी खुस-खबर तमने ह़मळायो; अने आह़फा ने नानो अने हेटो कर देदो, जरीक वीच्‌यार करो ईसम करीन मे कंय पाप कर्‌यो ह़ु? <verse eid="2CO 11:7" /><verse number="8" style="v" sid="2CO 11:8" />ईसु नी बीजी वेगळे वाळी मंडळी पांह गेथु जे बी मने भेट जड़लु तीहया भेट ना पय्‌हा मे तमारी पोर खरचो करीन तमारी सेवा कर्‌यो। <verse eid="2CO 11:8" /><verse number="9" style="v" sid="2CO 11:9" /><note caller="+" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PHP 4:15-18">फीलीपीयो 4:15-18</ref></char></note>अने जत्‌यार मे तमारीन्‌तां हतो, ता मने पय्‌हा जोय पड़ला, तत्‌यार मे तमारी माय्‌न कोय पांह बी पय्‌हा नी मांग्‌यो, पण मकीदुनीया जीला नी मंडळी वाळा आवीन भाय-बेन्‌या मने पय्‌हा आपीन मने मदत कर्‌या: अने मे तमारी गेथो अलग रीन तमारी पांह कंय नी मांग्‌यो, अने मांगु बी नी। <verse eid="2CO 11:9" /><verse number="10" style="v" sid="2CO 11:10" />ईसु मसी नी सच्‌चाय मारी मे से, एतरे अखाया परगणा मे कोय बी आहयी वात पोर मोटाय करवा सी मने नी रोके। <verse eid="2CO 11:10" /><verse number="11" style="v" sid="2CO 11:11" />काहा नी रोके? मे तमने मोंग नी करु करीन ह़ु? भगवान आहयी वात ने जाणे, के मे तमने मोंग करु।<verse eid="2CO 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 11:12" />जे काम मे करतो आय र्‌यो तीहयु करतोत रेही, के जे मोट्‌ला चेला केवाड़े, अने मोखो ह़ोद र्‌या, तीमने मे मोखो नी आपु, के जे वात मे आमु घमंड करया तीहयी वात मे तीहया बी घमंड कर सके। <verse eid="2CO 11:12" /><verse number="13" style="v" sid="2CO 11:13" />काहाके एवा माणहु झुटा नेवताळा, अने ठगण्‌या, अने मसी ना नेवताळा नो रुप लेवा वाळा से। <verse eid="2CO 11:13" /><verse number="14" style="v" sid="2CO 11:14" />आहयी वात ह़मळीन तमने वहराय्‌न भुले नी पड़वा जोवे काहाके भुतड़ो आह़फोत पपलन्‌या ह़रगदुत नो नकली वेह़ लीन ढोंगड़ा करे अने भुले पाड़े। <verse eid="2CO 11:14" /><verse number="15" style="v" sid="2CO 11:15" />एतरे कदीम भुतड़ा ना चाकर्‌या बी धरम ना चाकर्‌या नो वेह़ लीन ढोंगड़ा करे, ता आहयु देखीन वहराय्‌न भुले नी पड़वा जोवे, पण आखरी मे तीमना काम नी अनसारे तीमनो नीयाव हयहे अने डंड जड़हे।<verse eid="2CO 11:15" /></para>
  <para style="s">पोलुस आह़फा ना दुख झेले</para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 11:16" />मे अळी केम, कोय मने गांडो ना ह़मजो; पण गांडो ह़मजीत र्‌या ता गांडोत ह़मजीन मारी वात मानो, आनीन करते के मे बी थोड़ीक वात मे मोटाय कर सकु। <verse eid="2CO 11:16" /><verse number="17" style="v" sid="2CO 11:17" />मे जे की र्‌यो तीहयु मालीक ईसु नी मरजी सी नी केतो, पण गांडा नी तेम आत्‌मा ना भरहा ना मोटाय मे की र्‌यो। <verse eid="2CO 11:17" /><verse number="18" style="v" sid="2CO 11:18" />ढेरेत माणहु डील नी अनसारे मोटाय करे ता मे बी मोटाय काहा नी करु? <verse eid="2CO 11:18" /><verse number="19" style="v" sid="2CO 11:19" />तमु ते अक्‌कल वाळा बणीन गांडा नी गंडाय, खुसी सी वेठ लेवो! <verse eid="2CO 11:19" /><verse number="20" style="v" sid="2CO 11:20" />देखो, जत्‌यार तमने कोय गुलाम बणाय लेय नीता तमने बरबात कर देय नीता तमारी पांह फायदो लेय नीता आह़फा ने तमारी वच मे मोटो बणावे नीता तमारा गाल्‌ये थापड़ देय, ता तमु तीनी वेठ लेवो। <verse eid="2CO 11:20" /><verse number="21" style="v" sid="2CO 11:21" />मे लजवाय्‌न आहयु केम के आपणु आंबा-सांबा मे वारु तु नी वारु कीन कमजोर हय जेला से, पण कानो कानी वात मे हीम्‌मत करतो हय, पण मे बी गंडवायेत केम ता मे बी तेतरीत हीम्‌मत करु। <verse eid="2CO 11:21" /><verse number="22" style="v" sid="2CO 11:22" />तीहया एतरात ईब्‌रानी जाती वाळा से ह़ु? मे बी से। तीहया एतरात ईस्‌रायली जाती वाळा से ह़ु? मे बी से। तीहया एतरात अब्‌राहम नी अवल्‌यात से ह़ु? मे बी से। <verse eid="2CO 11:22" /><verse number="23" style="v" sid="2CO 11:23" /><note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="ACT 16:23">नेवताळा ना काम 16:23</ref></char></note>तीहया एतरात मसी ना चाकर्‌या से ह़ु? मे गंडवायलान तेम केम के मे तीमनी गेथो सेकीन से, जादा मेहनत करवा मे, ईसु नी लेदे वळ-वळीन जेल मे जवा मे, गीणाये नी एतरी कावा कुटायवा मे, ढेरेत कावा मरतो-मरतो बचवा मे। <verse eid="2CO 11:23" /><verse number="24" style="v" sid="2CO 11:24" />युहदी माणहु मने पांच काव एक कम चाळीह़-चाळीह़ ह़ड़का देदा। <verse eid="2CO 11:24" /><verse number="25" style="v" sid="2CO 11:25" /><note caller="+" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="ACT 16:22">नेवताळा ना काम 16:22</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:19">नेवताळा ना काम 14:19</ref></char></note>तीन कावा मने ह़ोटी वेर देदा, एक कावा दगड़ाट्‌या, तीन कावा मारी ढुंड्‌या मे घणी वीती एक रात अने दाड़ो मे दर्‌या मे र्‌यो। <verse eid="2CO 11:25" /><verse number="26" style="v" sid="2CO 11:26" /><note caller="+" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="ACT 9:23">नेवताळा ना काम 9:23</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:5">नेवताळा ना काम 14:5</ref></char></note>मे वळ-वळीन आञे अने ह़ेले जतो र्‌यो, नंद्‌या मे बी वेला कर्‌यो, मारा देस वाळात मने वेला पाड़्‌या, ह़ेर वाळा बी वेला पाड़्‌या, डाकु माणहु बी मने वेला पाड़्‌या, युहदी अने आड़जात्‌या बी वेला पाड़्‌या, बड़ा मे बी वेला कर्‌यो, दर्‌या मे बी वेला कर्‌यो, झुट मेलन्‌या भायु नी लारे बी वेला कर्‌यो। <verse eid="2CO 11:26" /><verse number="27" style="v" sid="2CO 11:27" />मे काम करी-करीन अने वेला करी-करीन दाड़ा काट्‌यो, आखी रात जागीन रात काट्‌यो, भुकलो अने तरहेलो दाड़ा काट्‌यो काय केतरी कावा उपाह़ पाळ्‌यो, बारो रीन टाड वेठ्‌यो। <verse eid="2CO 11:27" /><verse number="28" style="v" sid="2CO 11:28" />आहयी आखी वात ने सोड़ीन मने दाड़ीनेत ईसु नी मंडळी नी फीकर आवे। <verse eid="2CO 11:28" /><verse number="29" style="v" sid="2CO 11:29" />कोय कमजोर हये अने मे कमजोर नी हयु? कोय पाप करे अने मे दुखी नी हयु?<verse eid="2CO 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="2CO 11:30" />कदीम मने मोटाय करवात पड़े ता मे मारी कमजोरी पोरेत करही। <verse eid="2CO 11:30" /><verse number="31" style="v" sid="2CO 11:31" />मालीक ईसु नो भगवान बाह, जे जलम जुगाळो से, तीहयो जाणे के मे झुट नी मेल्‌तो। <verse eid="2CO 11:31" /><verse number="32" style="v" sid="2CO 11:32" /><note caller="+" style="x"><char style="xo" closed="false">11:32 </char><char style="xt" closed="false"><ref loc="ACT 9:23-25">नेवताळा ना काम 9:23-25</ref></char></note>दमीस्‌क ह़ेर नो अरीतास राजो जे राज करतो हतो, तीहयो मने धराव्‌वा करीन दमीस्‌क ह़ेर ना झापला पोर सीपायड़ा नो पेहरो बहाड़ र्‌यो हतो। <verse eid="2CO 11:32" /><verse number="33" style="v" sid="2CO 11:33" />तत्‌यार मारा ह़ाती मने चार्‌या मे बहाड़ीन कीला ना भीतड़ा नी खीड़की मे गेथा दोड़ु बांदीन उतार देदा अने मे तीमने नी धरायो अने मे नाह ज्‌यो। <figure style="fig" alt="Entrance to the city gate and wall" file="hk00238c.tif" size="col" copy="Horace Knowles ©" ref="11:32">ह़ेर ना झापला अने भीतडा भणी जाय </figure><verse eid="2CO 11:33" /></para>
  <chapter eid="2CO 11" />
  <chapter number="12" style="c" sid="2CO 12" />
  <para style="s">पोलुस नो दरसन</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 12:1" />मोटाय करवा वारु नी हय, ते बी मोटाय करवात पड़ र्‌यु; एतरे मालीक ईसु मने जे सेलभात्‌याण चीज अने वण-देख्‌याण चीज देखाड़्‌यो, तीहया चीज ना बारा मे मे वात करही। <verse eid="2CO 12:1" /><verse number="2" style="v" sid="2CO 12:2" />मे ईसु मसी पोर भरहो करन्‌या एक माणेह ने जाणु, जे आज गेथो चोवदे साल पेलो, आखान उचा ह़रग मे उचलाय जेलो जां ह़ारीक भगवान रेय जे तीसरो ह़रग से। मालम नी डील भेळे उचलाय जेलो, के डील वगर नीस्‌तो आत्‌मा भेळे उचलाय जेलो, आहयी वात ने ते भगवानेत जाणे। <verse eid="2CO 12:2" /><verse number="3" style="v" sid="2CO 12:3" />मे तीहया माणेह ने जाणु, मालम नी डील भेळे, के डील वगर नीस्‌तो आत्‌मा मे, आहयी वात ते भगवानेत जाणे। <verse eid="2CO 12:3" /><verse number="4" style="v" sid="2CO 12:4" />ह़रग मे उचलाय जेलो जां ह़ारीक भगवान रेय, अने आहयो माणेह एवी वात ह़मळ्‌यो, जे वात बीजा ने ह़मळावे एवी नी हय; होव, जे वात ने मोडे लाव्‌वा माणहु जुगु वारु नी हय। <verse eid="2CO 12:4" /><verse number="5" style="v" sid="2CO 12:5" />आहयी ह़रग नी वात मोटाय करे एवी से, पण मे ते मारी कमजोरी पोरेत मोटाय करही, आहयी कमजोरी नी वात ने सोड़ीन कानी बी वात पोर मोटाय नी करु। <verse eid="2CO 12:5" /><verse number="6" style="v" sid="2CO 12:6" />कदीम मे मोटाय करवा बी हींडु ते बी गांडो नी केवायु, काहाके मे जे बी देख्‌यो अने ह़मळ्‌ळो हतो तीहयुत ह़ाची हतु; ते बी मे तीहयीत वात ने केवा मे होगो री जाम; कंखर माय्‌न आसम नी हय जाय के, जे कोय मने देखे अने मारी ह़मळे तीहयो मने आहयी वात ने सेकीन नी मानवा जोवे। <verse eid="2CO 12:6" /><verse number="7" style="v" sid="2CO 12:7" />मे भगवान ना वण-देख्‌या अने सेल-भात्‌याण चीज ने देखलो से करीन मोटाय नी करवा जोवे करीन भगवान मारा डील मे घोदलायण्‌यो दुख पयदा करलो से। पोलुस आह़फा पोर भरहो करीन मोटाय नी करवा जोवे करीन भगवान मारीन्‌तां, भुतड़ा नो एक दुत मोकल्‌लो से, जे मने घोदल्‌या करे। <verse eid="2CO 12:7" /><verse number="8" style="v" sid="2CO 12:8" />आना बारा मे मे मालीक ईसु पांह तीन कावा वीन्‌ती कर्‌यो, के आहयो दुख मारीन्‌तां गेथो सेटो कर। <verse eid="2CO 12:8" /><verse number="9" style="v" sid="2CO 12:9" />पण मालीक ईसु मने केदो, “मारी दया तारी जुगु रेट से; काहाके तारी लुलखाय मे मारो जोर उजन्‌तो मालम पड़े।” एतरे मे, खुस हय्‌न मारी कमजोरी पोर मोटाय करही, आनीन करते के ईसु मसी नो जोर मारी उपर साहळो करतो रेय। <verse eid="2CO 12:9" /><verse number="10" style="v" sid="2CO 12:10" />एतरे मे ईसु मसी नी लेदो मारी कमजोरी मे, नामबद्‌दी करे ते बी, गरबाय मे बी, आफत मे आवे ते बी, अने जबरजस्‌ती करे ते बी, खुस रेम; काहाके जत्‌यार मे कमजोर रेम ता ते मे जोरभर्‌यो हय जाम।<verse eid="2CO 12:10" /></para>
  <para style="s">कुरन्‌थी वाळा ईसु पोर भरहो करन्‌या जुगु पोलुस नी फीकर</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 12:11" />मे गांडो ते बण ज्‌यो, पण तमुत मने जबरजस्‌ती गांडो बणाय देदा, तमु मारी जीवाय देखीन मारा बारा मे बीजा अगळ आहयो घण वारु से केवा हतु भले माणहु केय “मे कंय नी हय” ते बी मे तीहया मोट्‌ला नेवताळा गेथो कम नी हय। <verse eid="2CO 12:11" /><verse number="12" style="v" sid="2CO 12:12" />ईसु ना नेवताळा नी सेलाणी घण-जबर गम भेळे तमारी वच मे मारी लारे सेलाणी नी, अने सेल-भात्‌या काम नी लारे, अने भगवान ना ताखत वाळा काम नी लारे देखाव पड़ी। <verse eid="2CO 12:12" /><verse number="13" style="v" sid="2CO 12:13" />बीजी मंडळी ना माणहु तमने कमजोर काहा ह़मज्‌या, आनीन करते ह़मज्‌या काहाके मे तमारी पोर बोजो नी बण्‌यो? अने आहयी मारी भुल मने माफी आपो।<verse eid="2CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2CO 12:14" />हाव मे तीसरी कावा तमारीन्‌तां आव्‌वा करीन तीयार से, अने मे तमारी पोर बोजो नी बणु, काहाके मने तमारी कानी बी चीज नी जोवती, पण तमु जोवे। काहाके सोरा-सोरी आय्‌ह़-बाहा जुगु धन भेळु नी करे, पण आय्‌ह़-बाहा सोरा-सोरी जुगु धन भेळु करे। <verse eid="2CO 12:14" /><verse number="15" style="v" sid="2CO 12:15" />मे खुस हय्‌न तमारी जुगु मारी पांह जे कंय से तीहयु आखु खरचो करही अने आह़फोत खरचो हय जही, मे ते तमने घण-जबर मोंग करु ता तमारी वगे गेथो कम मोंग जड़वा जोवे ह़ु?<verse eid="2CO 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2CO 12:16" />तमने मालम के मे तमारी पोर भार नी बण्‌यो, पण बीजा माणहु केहे के मे कदर करीन तमने फसाड़ लेदो। <verse eid="2CO 12:16" /><verse number="17" style="v" sid="2CO 12:17" />मे जे माणहु ने तमारीन्‌तां मोकल्‌लो तीमनी लारे तमारी पांह कंय ली लेदलो ह़ु? कदी नी। <verse eid="2CO 12:17" /><verse number="18" style="v" sid="2CO 12:18" />मे तीतुस ह़ाते ईसु पोर भरहो करन्‌यो एक-बीजा भाय ने बी मोकल्‌लो। तीतुस कंय तमारी पांह ठगीन मांग्‌यो ह़ु? कदी नी। अने आमु बी तीहयीत ह़ीकाड़ली वाट्‌ये नी चाल्‌या ह़ु?<verse eid="2CO 12:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2CO 12:19" />तमु हजु लग आहयुत ह़मजी र्‌या हहे के आमु तमारी अगळ अमारोत बचाव करवा करीन की र्‌या, ए मोंगाळ्‌ळा भाय अने बेन्‌या, आमु ते भगवान नी हजरी मे ईसु मसी ना हक मे बोलया, अने आखी वात तमारा नफा नी करते कीया। <verse eid="2CO 12:19" /><verse number="20" style="v" sid="2CO 12:20" />काहाके मने बीक से के कंखर माय्‌न मे तमने देखवा नी हेर कर र्‌यो तेम नी देखु अने जेम तमु मने देखवा नी हेर कर र्‌या तेम मे नी देखायु। अने कंखर माय्‌न आसम नी हय जाय के मे तमारी मे झगड़ो, आंबा-सांबा वाक काडवा, वात मे जखड़ी पड़वा, अने चुगली अने मोटाय अने खुन-खराबो देखु। <verse eid="2CO 12:20" /><verse number="21" style="v" sid="2CO 12:21" />अने कंखर माय्‌न आसम नी हय जाय के मे तमारीन्‌तां आवु ता मारो भगवान तमारी अगळ नीचळो बणाय देय अने मे तीहया आखा जुगु दुखी हयु जे वीत्‌या दाड़ा मे पाप कर्‌या अने गलत काम कर्‌या, चंगलाय कर्‌या अने छीनाळु कर्‌या ते बी पाप नी माफी मांगीन भगवान भणी नी वळ्‌या।<verse eid="2CO 12:21" /></para>
  <chapter eid="2CO 12" />
  <chapter number="13" style="c" sid="2CO 13" />
  <para style="s">आखरी चेतावणी</para>
  <para style="p">
    <verse number="1" style="v" sid="2CO 13:1" />तमारीन्‌तां मे तीसरी कावा आव्‌वा बाज र्‌यो। एक-एक सच्‌चाय ने पुरी करवा करीन बे नीता तीन गवा नी जरवत रेय। <verse eid="2CO 13:1" /><verse number="2" style="v" sid="2CO 13:2" />जेम मे बीजी कावा तमारी ह़ाते हतो, तेमेत हाव सेटो रीन तीहया माणहु ने जे पेले पाप करला, अने बीजा आखा माणहु ने बी हाव पेले गेथोत की देम के मे कदीम अळी आवही ता नी सोड़ु, <verse eid="2CO 13:2" /><verse number="3" style="v" sid="2CO 13:3" />काहाके ईसु मसी मारी मे रीन बोले आहयी वात नो तमु गवा ह़ोद र्‌या। आहयो ईसु मसी कमजोर नी हय: पण तीहयो तमने ह़ुदारवा करीन तमारी वच मे जोर वाळो से। <verse eid="2CO 13:3" /><verse number="4" style="v" sid="2CO 13:4" />ह़ाचलीन, तीहयो जाण बुजीन कमजोर बण जेलो, अने तीने कुरुस पोर चड़ाय देदला हता, ते बी भगवान ना जोर नी लारे तीहयो मर्‌या-ह़र्‌या मे गेथो जीवतो हय जेलो। ईसुन तेमेत आमु बी कमजोर से; पण भगवान ना जोर नी लारे जीवता रीन तमारी सेवा करवा करीन आमु जोर वाळा से।<verse eid="2CO 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2CO 13:5" />आह़फा ना मन ने पारखो के तमु ईसु पोर भरहो कर र्‌या के नी करता? तमु आह़फा नी जीवाय ने पारखो के तमारी मे आहयी वात नो पुरावो हय के नी हय। तमरात बारा मे तमने मालम नी हय ह़ु? तमारी मे ईसु मसी नी हय ह़ु? नी हय, ता ते तमु पारख मे खोटला नीकळ्‌या। <verse eid="2CO 13:5" /><verse number="6" style="v" sid="2CO 13:6" />पण मारी आह से तमु आह़फा ने पारखहु ता जाण लेहु के आमु रीकामा नी हय। <verse eid="2CO 13:6" /><verse number="7" style="v" sid="2CO 13:7" />अने आमु आपणा भगवान पांह तमारी जुगु आहयी वीन्‌ती करया के तमु कानी बी कुहराय ना करो; एम करीन मे आहयु नी केतो के आमु खरला देखाव पड़या, पण आनीन करते के तमु भलाय करो, भले माणहु आमने रीकामा केवा जोवे। <verse eid="2CO 13:7" /><verse number="8" style="v" sid="2CO 13:8" />काहाके आपणु ने सच्‌चाय ना वीरोद मे कंय बी नी कराये, पण सच्‌चाय जुगुत कंय बी कराये। <verse eid="2CO 13:8" /><verse number="9" style="v" sid="2CO 13:9" />जत्‌यार आमु कमजोर रीया अने तमु जोर वाळा रेवो, ता आमु खुस हवया, अने आहयी वीन्‌ती बी करया के तमु पक्‌का हय जावो। <verse eid="2CO 13:9" /><verse number="10" style="v" sid="2CO 13:10" />एतरे मे सेटो रीन बी आहयी वात ने तमारी जुगु लीख र्‌यो के जत्‌यार मे तमारी वच मे आवु ता मने मालीक ईसु नी लारे आपला हक नी लारे तमने वडवा पड़े ते बी तीहयु तमारा नुकसान जुगु नी पण तमारा फायदा जुगु।<verse eid="2CO 13:10" /></para>
  <para style="s">आखरी काव वारला से के केम</para>
  <para style="p">
    <verse number="11" style="v" sid="2CO 13:11" />आखरी मे। भायु अने बेन्‌या, खुस रेवो। पक्‌का हयता जावो; हीम्‌मत राखो; एक-मन्‌या हय्‌न रेवो; हेळी-मेळीन रेवो, ता मोंग अने सांती आपण्‌यो भगवान तमारी ह़ाते रेहे।<verse eid="2CO 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="2CO 13:12" />चोखला मन सी कुको दीन एक-बीजा नो आव-भाव करो।<verse eid="2CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2CO 13:13" />आखा भगवान ना भगत माणहु तमने आवही अने आवजो की र्‌या। <verse eid="2CO 13:13" /><verse number="14" style="v" sid="2CO 13:14" />अमारा मालीक ईसु नी संयबरकत अने भगवान नो मोंग अने चोखली आत्‌मान ह़ात-ह़ंगात तमु आखा भेळती रीया करे।<verse eid="2CO 13:14" /></para>
  <chapter eid="2CO 13" />
</usx>