<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EZK" style="id">- Paliya New Testament</book>
  <para style="h">यहेजकेल</para>
  <para style="toc3">यहेजकेल नी कीताप</para>
  <para style="toc2">यहेजकेल</para>
  <para style="toc1">यहेजकेल</para>
  <para style="mt2">कीताप</para>
  <para style="mt1">भगवान वगे गेथी वात केवा वाळा यहेजकेल नी कीताप</para>
  <para style="imt">ओळखाण</para>
  <para style="ip">यहेजकेल नी कीताप ईस्‌रायल नु खत्‌तम हयणु अने तीने पासु बणावणु ना बारा मे भगवान वगे गेथी केदली वात नी कीताप से। भगवान वगे गेथी वात केवा वाळा यहेजकेल ना बारा मे जे कंय बी जाणया, तीहयु कीताप मे गेथुत आवे। तीनी भगवान वगे गेथी वात केवा नी सेवा 22 साल नी आड़े-धेड़े तक चाली, ईसुन आव्‌वान पेले 586 मे यरुसलेम ने खत्‌तम हयवा सी पेले अने 15 सालु बाद। आह़फा ना दरसन ना जपाप मे, यहेजकेल ने कंय चीजु ने करवा नी जरवत हती जे ईस्‌रायल नी ह़ाते हयहे। एक उदारण पाट 5 मे जड़े जां ह़ारीक तीने आह़फा नी डाडी बोड़वा, अने नीम्‌बाळा ने 3 हीस्‌सा <char style="xt"><ref loc="EZK 5:1">5:1</ref></char> मे वाटवा करीन केदलु हतु, जीनी मे देखाड़लु हतु के यरुसलेम नु ह़ु हयहे।</para>
  <para style="ip">यहेजकेल नी कीताप तीन खास भाग मे वटायली से; ईस्‌रायल नो नीयाव, आड़े-धेड़े ना राज्‌य नो नीयाव, अने ईस्‌रायल ने पासु बणावणु। आहया आखा वाटा मे एक खास वात आहयी से के कीसम चीज आपणु ने भगवान ने जाणवा करीन अगो बड़ावहे। यहेजकेल 60 सी बी जादा कावा आहया वाक्‌य ने लीख्‌यो, “ता तीहया ह़मजी जहे के में यहोवा से। भले भगवान नीयाव कर र्‌यो हय नीता पासो बणाव्‌वा बाज र्‌यो हय, आमु तीना बारा मे अने तीहयो आपणु सी ह़ु चाहे, ह़ीक सकत्‌ला।”</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. मे ईस्‌रायल पोर भगवान ना नीयाव ना बारा मे से। <char style="ior"><ref loc="EZK 1:1-24:27">1:1–24:27</ref></char></para>
  <para style="io1">2. भगवान आड़े-धेड़े ना राज्‌य नो नीयाव करे। <char style="ior"><ref loc="EZK 25-32">25–32</ref></char></para>
  <para style="io1">3. पाट 33 सी 48 मे यहेजकेल ईस्‌रायल ने पासु बणाव्‌वा ना बारा मे भगवान वगे गेथी वात करे। <char style="ior"><ref loc="EZK 33-48">33–48</ref></char></para>
  <chapter number="1" style="c" sid="EZK 1" />
  <para style="s">भगवान ना बारा मे यहेजकेल नो पेल्‌लो दरसन</para>
  <para style="r">(<ref loc="EZK 1:1-7:27">1:1–7:27</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 1:1" />तीसवा साल ना चोवथा मयना ना पांचवा दाड़े, में गुलामी मे वाळा माणहुम नी वच मे कबार नंदी ना काठे हतो, ता ह़रग उगड़ी ज्‌यु, अने में भगवान नो दरसन देख्‌यो। <verse eid="EZK 1:1" /><verse number="2" style="v" sid="EZK 1:2" />यहोयाकीन राजा नी गुलामी ना पांचवा साल ना चोवथा मयना ना पांचवा दाड़े,<note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2KI 24:10-16">2 राजा 24:10-16</ref>; <ref loc="2CH 36:9">2 ईतीहास 36:9</ref>,<ref loc="2CH 36:10">10</ref></char></note> <verse eid="EZK 1:2" /><verse number="3" style="v" sid="EZK 1:3" />कसदीयो ना देस मे कबार नंदी ना काठे, यहोवा भगवान नो बोल बुजी ना सोरा यहेजकेल पुंजारान्‌तां पुग्‌यो; अने यहोवा नी सक्‌ती तीनी पोर तांत उजन्‌ती हयी।<verse eid="EZK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 1:4" />जत्‌यार में नजर उची कर्‌यो, ता देख्‌यो के धुराव भणी गेथी लेहराती जाय्‌न आक्‌ठु भेळ मोट्‌ली आंजी आव्‌वा बाज री, अने तीनी ह़ाते मोट्‌लु वादळु अने तीनी चारो-मेर वीजाळु अने आक्‌ठु नी वचा-वच पपलत्‌लु पीतळ ने तेवु कंय देखाव पड़े। <verse eid="EZK 1:4" /><verse number="5" style="v" sid="EZK 1:5" />अने तीनी वच मे गेथा च्‌यार जीव ने तेवा कंय नीकळ्‌या, तीमनो रुप माणहुन तेवो हतो।<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="REV 4:6">परकासीतवाक्‌य 4:6</ref></char></note> <verse eid="EZK 1:5" /><verse number="6" style="v" sid="EZK 1:6" />पण तीमनी मे गेथा आखा ना च्‌यार-च्‌यार मुंडा अने च्‌यार-च्‌यार पाखड़ा हता। <verse eid="EZK 1:6" /><verse number="7" style="v" sid="EZK 1:7" />तीमना पोगु ह़ुदा हता, अने तीमना पोगु ना तळे ना वाछड़ा ना खुर्‌यान तेवा हता; अने तीहया झलकावलु पीतळ ने तेम चमकता हता। <verse eid="EZK 1:7" /><verse number="8" style="v" sid="EZK 1:8" />तीमनी च्‌यारो-मेर पाखड़ा तळे माणहुन तेवा हात हता। तीहया च्‌यारोव ना मोडा अने पाखड़ा आहयी रीते हता: <verse eid="EZK 1:8" /><verse number="9" style="v" sid="EZK 1:9" />तीमना पाखड़ा एक-बीजा ने चोटायता एम हता; तीहया आह़फा-आह़फाम नी ह़ामने ह़ुदात चालता जाय्‌न तीमनु डील ने वाळता नी हता।<verse eid="EZK 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 1:10" />तीमनु अगळ नु मोडु नो सीक्‌को माणहुन तेवो हतो अने तीहया च्‌यारोव नी जमणी ह़ोड़ ना मोडा नाहर ने तेवा हता, डखरी ह़ोड़ ना मोडा बोळद्‌यान तेवा हता, अने च्‌यारोव ना पसळ ना मोडा घुवड़ ने तेवा हता।<note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="EZK 10:14">यहेजकेल 10:14</ref>; <ref loc="REV 4:7">परकासीतवाक्‌य 4:7</ref></char></note> <verse eid="EZK 1:10" /><verse number="11" style="v" sid="EZK 1:11" />तीमना सीका एवात हता। तीमना मोडा अने पाखड़ा उपर नी ह़ोड़ अलग-अलग हता, आखा जीव ना बे-बे पाखड़ा हता, जे एक बीजा ना पाखड़ा ह़ाते भेसकायला हता, अने बे-बे पाखड़ा वेर तीमनु डील ढकायलु हतु। <verse eid="EZK 1:11" /><verse number="12" style="v" sid="EZK 1:12" />तीहया ह़ुदा आह़फा-आह़फाम नी अगळेत चालता हता; जींखर आत्‌मा जवा हींडती हती, तीहया तींखरेत जता हता, अने चालती टेमे वळता नी हता।<verse eid="EZK 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 1:13" />जीव नो रुप ईंगाळा अने धपत्‌ला कांदील ने तेवो देखाव पड़तो हतो, अने तीहयु आक्‌ठु जीव नी वच मे एथुन एथु चालतु जाय्‌न घणु वीजाळु करतु हतु; अने तीहयु आक्‌ठु मे गेथी वीजळी नीकळती हती।<note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="REV 4:5">परकासीतवाक्‌य 4:5</ref></char></note> <verse eid="EZK 1:13" /><verse number="14" style="v" sid="EZK 1:14" />तीहया जीव नु चालनु-फीरनु वीजळीन तेवु हतु।<verse eid="EZK 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 1:15" />जत्‌यार में जीव ने देखीत र्‌यो हतो, ता ह़ु देख्‌यो के धरती पोर तीमनी धेड़े च्‌यारोव मोडा नी गीनती नी अनसारे, एक-एक चाकटु हतु।<note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="EZK 10:9-13">यहेजकेल 10:9-13</ref></char></note> <verse eid="EZK 1:15" /><verse number="16" style="v" sid="EZK 1:16" />चाकटा नो रुप अने बनावट ह़ोना नी मणीन तेवो हतो, अने तीमनो च्‌यारोव नो एक ह़रकोत सीको हतो; अने तीमनो सीको अने बनावट आसवीत हती जेम एक चाकटा नी वच मे बीजु चाकटु हय। <verse eid="EZK 1:16" /><verse number="17" style="v" sid="EZK 1:17" />चालती टेमे तीहया तीमनी च्‌यारो-मेर चाल सकता हता, अने चालवा मे वळता नी हता। <verse eid="EZK 1:17" /><verse number="18" style="v" sid="EZK 1:18" />अने तीहया च्‌यारोव चाकटा ना घेरा घणा मोटा अने बीहाड़े एवा हता, अने तीमना घेरा मे च्‌यारो-मेर डोळात डोळा भरला हता।<note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="REV 4:8">परकासीतवाक्‌य 4:8</ref></char></note> <verse eid="EZK 1:18" /><verse number="19" style="v" sid="EZK 1:19" />जत्‌यार तीहया जीव चालता हता, ता चाकटा बी तीमनी ह़ाते चालता हता; अने जत्‌यार जीव धरती पोर गेथा उपर उठता हता, ता चाकटा बी उपर उठता हता। <verse eid="EZK 1:19" /><verse number="20" style="v" sid="EZK 1:20" />जींखर आत्‌मा जवा हींडती हती, तींखरेत तीहया जता हता, अने चाकटा जीव ह़ाते उपर उठता हता; काहाके तीमनी आत्‌मा चाकटा मे हती। <verse eid="EZK 1:20" /><verse number="21" style="v" sid="EZK 1:21" />जत्‌यार तीहया चालता हता ता आहया बी चालता हता; अने जत्‌यार-जत्‌यार तीहया उबा हयता हता, ता आहया बी उबा हयता हता; अने जत्‌यार तीहया धरती पोर गेथा उचा उचलायता हता ता चाकटा बी तीमनी ह़ाते उचलायता हता; काहाके जीवुम नी आत्‌मा चाकटा मे हती।<verse eid="EZK 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 1:22" />तीहया जीव ना मुंडा नी उपर तारा मंडळीन तेवु कंय हतु जे बरप ने तेम घण-जबर चमकतु हतु, अने तीहयु तीमना मुंडा नी उपर फेल्‌लु हतु। <verse eid="EZK 1:22" /><verse number="23" style="v" sid="EZK 1:23" />तारा मंडळीन तळे, तीमना पाखड़ा एक-बीजा भणीन ह़ुदा फेल्‌ला हता; अने आखा जीव ना बे-बे अळी पाखड़ा हता जीमनी सी तीमना मुंडा ढकायला हता। <verse eid="EZK 1:23" /><verse number="24" style="v" sid="EZK 1:24" />तीमनी चालवा नी टेमे तीमना पाखड़ा नी अवाज मने घणु ढेरकु पाणी, नीता ताखत वाळा नी बोली, नीता सेना नी चालवा नी अवाज ने तेवी ह़मळायती हती; अने जत्‌यार तीहया उबा हयता हता, ता तीमना पाखड़ा टांग देता हता।<note caller="+" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="REV 1:4-15">परकासीतवाक्‌य 1:4-15</ref>; <ref loc="REV 19:6">19:6</ref></char></note> <verse eid="EZK 1:24" /><verse number="25" style="v" sid="EZK 1:25" />अळतेण जे तीमना मुंडा पोर जे तारा मंडळीन तेवु हतु, तीनी उपर गेथो एक बोल ह़मळाय पड़तो हतो; अने जत्‌यार तीहया उबा हयता हता, ता तीमना पाखड़ा हेटा टांग लेता हता।<verse eid="EZK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 1:26" />जे तारा मंडळीन तेवु तीमना मुंडा पोर हतु, तीनी पोर मानो लील्‌ला रंग नी मोगला दगड़ान तेवी राजगादी बणली हती; आहयी राजगादी पोर माणेह ने तेवु कोय बह रेलु देखाव पड़तु हतु।<note caller="+" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="EZK 10:1">यहेजकेल 10:1</ref>; <ref loc="REV 4:2">परकासीतवाक्‌य 4:2</ref>,<ref loc="REV 4:3">3</ref></char></note> <verse eid="EZK 1:26" /><verse number="27" style="v" sid="EZK 1:27" />तीना केड़्‌ये गेथु लगाड़ीन उपरली ह़ोड़ मने मानो पपलत्‌लु पीतळ ने तेवु देखाव पड़्‌यु, अने तीनी मोय अने च्‌यारो-मेर आक्‌ठुन तेवु देखाव पड़तु हतु; अळतेण तीहया माणेह नी केड़्‌ये गेथु लगाड़ीन हेट्‌ली ह़ोड़ बी मने आक्‌ठुन तेवु देखाव पड़तु हतु; अने तीनी च्‌यारो-मेर वीजाळु हतु।<note caller="+" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="EZK 8:2">यहेजकेल 8:2</ref></char></note> <verse eid="EZK 1:27" /><verse number="28" style="v" sid="EZK 1:28" />जेम पाणी ना दाड़ा मे वादळा मे बाम देखाव पड़े, तेमेत च्‌यारो-मेर नु वीजाळु देखाव पड़तु हतु। यहोवा नी बड़ाय नो रुप आवोत हतो। तीने देखीन, में मोडा ना भरहे पड़्‌यो, ता में एक बोल ह़मळ्‌यो जेम कोय वात करे।<verse eid="EZK 1:28" /></para>
  <chapter eid="EZK 1" />
  <chapter number="2" style="c" sid="EZK 2" />
  <para style="s">भगवान वगे गेथी वात केवा वाळा ना रुप मे यहेजकेल ने भगवान नु बोलावणु</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 2:1" />तीहयु मने केदु, “ए माणेह नी अवल्‌यात, तारा पोगु ना भरहे उबो हय, अने में तारी ह़ाते वात करही।” <verse eid="EZK 2:1" /><verse number="2" style="v" sid="EZK 2:2" />जेमेत तीहयु मने आहयु केदु, तेमेत आत्‌मा मारी मे ह़माय्‌न मने पोगु ना भरहे उबो कर देदी; अने जे मारी ह़ाते वात करतु हतु तीनी ह़मळ्‌यो। <verse eid="EZK 2:2" /><verse number="3" style="v" sid="EZK 2:3" />तीहयु मने केदु, “ए माणेह नी अवल्‌यात, में तने ईस्‌रायलीम ने तां मतलब बकबक करवा वाळा माणहुन्‌तां मोकलु, जे मारा वीरोद मे बकबक करला से; तीमना आड़ा-बुड़ा अने तीहया बी आज ना दाड़े तक मारा वीरोद मे गुनो करता आय र्‌या। <verse eid="EZK 2:3" /><verse number="4" style="v" sid="EZK 2:4" />आहयी पीड़ी ना माणहु जीमनीन्‌तां में तने मोकलु, तीहया वण-लाज्‌या अने हेटाळ्‌ळा से; <verse eid="EZK 2:4" /><verse number="5" style="v" sid="EZK 2:5" />अने तु तीमने केजे, ‘मालीक यहोवा आसम केय,’ आनी सी तीहया, जे बकबक करवा वाळा घोराणा ना से, भले तीहया ह़मळे के नी ह़मळे, ते बी तीहया आहयु जाण लेहे के अमारी वच मे एक भगवान वगे गेथी वात केवा वाळो उजन्‌तो हयलो से।<verse eid="EZK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 2:6" />“ए माणेह नी अवल्‌यात, तु तीमनी सी नी बीहजे; भले तने काटा, कटाळस्‌या अने वीसा नी वच मे बी रेवा पड़े, ते बी तीमना बोलु सी नी बीहजे; तीहया धोको देण्‌या घोराणा ना से, ते बी नी ते तीमना बोलु सी बीहजे, अने नी तीमनु मोडु देखीन तारु मन काचु हये। <verse eid="EZK 2:6" /><verse number="7" style="v" sid="EZK 2:7" />करीन तीहया ह़मळे के नी ह़मळे; ते बी तु मारा बोलु तीमने केजे, तीहया ते घणा धोको देण्‌या से।<verse eid="EZK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 2:8" />“पण ए माणेह नी अवल्‌यात, जे में तने केम, तीने तु ह़मळ ले, तीहया धोको देण्‌या घोराणान तेम तु बी धोको देण्‌यो नी बणजे, जे में तने आपु, तीने मोडु उगाड़ीन खाय ले।” <verse eid="EZK 2:8" /><verse number="9" style="v" sid="EZK 2:9" />ता में नींगा नाख्‌यो अने ह़ु देख्‌यो, के मारी भणीन एक हात नाम्‌बो हय र्‌यो अने तीनी मे एक कीताप<note caller="+" style="f"><char style="fr" closed="false">2:9 </char><char style="ft" closed="false">गुचवली चामड़ा नी चीट्‌ठी</char></note> से।<note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="REV 5:1">परकासीतवाक्‌य 5:1</ref></char></note> <verse eid="EZK 2:9" /><verse number="10" style="v" sid="EZK 2:10" />तीने तीहयो मारी अगळ उगाड़ीन फेलायो, अने तीहयी बेम ह़ोड़ लीखली हती; अने जे तीनी मे लीखलु हतु, तीहयु वेला अने कलपवा अने दुख भर्‌या बोल हता।<verse eid="EZK 2:10" /></para>
  <chapter eid="EZK 2" />
  <chapter number="3" style="c" sid="EZK 3" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 3:1" />ता तीहयु मने केदु, “ए माणेह नी अवल्‌यात, जे तने जड़लु से तीने खाय ले; मतलब आहयी कीताप ने खा, ता जाय्‌न ईस्‌रायल ना माणहु ह़ाते वात कर।”<verse eid="EZK 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 3:2" />करीन में मोडु उगड़्‌यो अने तीहयु मने तीहयी कीताप खवाड़ नाख्‌यु। <verse eid="EZK 3:2" /><verse number="3" style="v" sid="EZK 3:3" />ता तीहयु मने केदु, “ए माणेह नी अवल्‌यात, आहयी कीताप जे में तने आपु, तीने जरवी ले, अने तारु पेट आनी सी भर ले।” अने में तीने खाय लेदो; अने मारा मोडा मे तीहयी मोद ने तेम गळी लागी।<verse eid="EZK 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 3:4" />अळतेण तीहयु मने केदो, “ए माणेह नी अवल्‌यात, तु ईस्‌रायल ना माणहुन्‌तां जाय्‌न तीमने मारा बोल ह़मळाव। <verse eid="EZK 3:4" /><verse number="5" style="v" sid="EZK 3:5" />काहाके तने कानी अंजाणली नीता काठी भासा वाळा राज्‌यन्‌तां नी मोकलतो, पण ईस्‌रायल नात घोराणान्‌तां मोकलु। <verse eid="EZK 3:5" /><verse number="6" style="v" sid="EZK 3:6" />अंजाणली बोली नीता काठी भासा वाळा राज्‌यन्‌तां जे तारी वात ह़मज नी सके, तने नी मोकलतो। सणका कर्‌या वगर कदीम में तने एवा माणहुन्‌तां मोकलतो ता तीहया तारी ह़मळता। <verse eid="EZK 3:6" /><verse number="7" style="v" sid="EZK 3:7" />पण ईस्‌रायल ना माणहु तारी ह़मळवा सी नीकारो करहे; तीहया मारी बी ह़मळवा सी नीकारो करे; काहाके आखा तीहया माणहु वण-लाज्‌या अने एकहेट्‌या मन ना से। <verse eid="EZK 3:7" /><verse number="8" style="v" sid="EZK 3:8" />देख में तारा मुख ने तीमना मुख अगळ, अने तारु नींडाळु ने तीमनु नींडाळु अगळ, एकहेट्‌यु कर देम। <verse eid="EZK 3:8" /><verse number="9" style="v" sid="EZK 3:9" />में तारु नींडाळु ने हीरान तेम वातड़ु कर देम जे पपलन्‌या दगड़ा सी बी वातड़ो रेय, एतरे तु तीमनी सी नी बीहजे, अने नी तीमनु मोडु देखीन तारु मन काचु हये; काहाके तीहया धोको देवा वाळा घोराणा ना से।”<verse eid="EZK 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 3:10" />अळतेण तीहयु मने केदु, “ए माणेह नी अवल्‌यात, जेतरा बोलु में तने केम, तीहया आखा मन मे राख अने कांटा वेर ह़मळ। <verse eid="EZK 3:10" /><verse number="11" style="v" sid="EZK 3:11" />अने तीहया गुलामी मे वाळान्‌तां जाय्‌न, जे तारा राज्‌य वाळा अने भायु से, तीमनी ह़ाते वात करजे अने केजे, ‘मालीक यहोवा आसम केय’ भले तीहया ह़मळे, के नी ह़मळे।”<verse eid="EZK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 3:12" />ता भगवान नी आत्‌मा मने उपर उठाड़ी, अने में मारी पसळ एक मोटात बोल नी घड़घड़ अवाज ह़मळ्‌यो, तीहयो केदो, “भगवान नी बड़ाय बरकत नी से।” <verse eid="EZK 3:12" /><verse number="13" style="v" sid="EZK 3:13" />अने तीनी ह़ातेत तीहया जीवु नो पाखड़ा नो अवाज, जे एक बीजा ने लागता हता, अने तीमनी ह़ाते ना चाकटा नी अवाज अने ज्‌योरेत घड़घड़ अवाज ह़मळाय पड़ी। <verse eid="EZK 3:13" /><verse number="14" style="v" sid="EZK 3:14" />ता आत्‌मा मने उठाड़ीन ली जी, अने में काठा दुख सी भरायलो, अने मन मे खीजवायतो जाय्‌न जत र्‌यो; अने यहोवा नी सक्‌ती मारी मे भरायली हती; <verse eid="EZK 3:14" /><verse number="15" style="v" sid="EZK 3:15" />अने में तीहया गुलामी मे वाळान्‌तां आयो जे कबार नंदी नी काठे तेलाबीब ह़ेर मे रेता हता। अने तां में ह़ात दाड़ा तक तीमनी वच मे दुखी हय्‌न बह र्‌यो।<verse eid="EZK 3:15" /></para>
  <para style="s">पेहरो देण्‌या ना रुप मे यहेजकेल ने टाळणु</para>
  <para style="r">(<ref loc="EZK 33:1-9">यहेजकेल 33:1-9</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 3:16" />ह़ात दाड़ा वीतवान अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 3:16" /><verse number="17" style="v" sid="EZK 3:17" />“ए माणेह नी अवल्‌यात,” में तने ईस्‌रायल ना घोराणा जुगु पेहरो देण्‌यो टाळलो से; तु मारा मोडा नी वात ह़मळीन, तीमने मारी भणी गेथो चेतावजे। <verse eid="EZK 3:17" /><verse number="18" style="v" sid="EZK 3:18" />जत्‌यार में गलत काम करन्‌या ने केम, तु पक्‌को मरही, अने कदीम तु तीने नी चेतावे, अने नी गलत काम करन्‌या ने आसवी वात केय जीनी सी तीहयो चेत जाय अने तीनी गलत काम नी वाट छोड़ीन जीवत्‌लो रेय, ता तीहयो गलत काम करवा वाळो तीना अधरम मे फसलोत मरहे, पण में तीना खुन नो लेखो तारीत पांह लेही। <verse eid="EZK 3:18" /><verse number="19" style="v" sid="EZK 3:19" />पण कदीम तु गलत काम करन्‌या ने चेतावे, अने तीहयो तीना गलत काम सी, अने गलत वाटे गेथो नी फीरे, ता तीहयो तीनात अधरम मे फसीन मर जहे; पण तु खुद ने बचाड़ही।<verse eid="EZK 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 3:20" />“अळतेण जत्‌यार धरमी माणहु तीना धरम सी फीरीन गलत काम करवा बाज जाय, अने में तीनी अगळ ठोकर मेकु, ता तीहयो मर जहे, काहाके तु जे तीने नी चेतायो, करीन तीहयो तीना पाप मे फसलो मरहे; अने जे धरम ना काम तीहयो कर्‌यो हय, तीहया काम नी फोम नी करे, पण तीना खुन नो लेखो में तारीत पांह लेही। <verse eid="EZK 3:20" /><verse number="21" style="v" sid="EZK 3:21" />पण कदीम तु धरमी ने आहयु कीन चेतावे, के तीहयो पाप नी करे, अने तीहयो पाप सी बच जाय, ता तीहयो चेतावणी ने मानवा ना कारण सी पक्‌कोत जीवत्‌लो रेहे, अने तु खुद ने बचाड़ही।”<verse eid="EZK 3:21" /></para>
  <para style="s">यहेजकेल बोल नी सक्‌यो</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 3:22" />अळतेण यहोवा नी ताखत तां मारी पोर उजन्‌ती हयी, अने तीहयो मने केदो। “उठीन चोवगान मे जा; अने ता में तारी ह़ाते वात करही।”<verse eid="EZK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 3:23" />ता में उठीन चोवगान मे ज्‌यो, अने तां ह़ु देख्‌यो, के यहोवा नो ह़ेक जेम मने कबार नंदीन काठे देखायलो, तेमेत आञे बी देखाव पड़्‌यो, अने में मोडा ना भरहे पड़ ज्‌यो। <verse eid="EZK 3:23" /><verse number="24" style="v" sid="EZK 3:24" />ता आत्‌मा मारी मे ह़माय्‌न मने पोगु ना भरहे उबी कर देदी; अळतेण तीहयी मने केवा बाज जी, “जा तारा घोर मे मोय झापलु दीन बही रे। <verse eid="EZK 3:24" /><verse number="25" style="v" sid="EZK 3:25" />ए माणेह नी अवल्‌यात, देख, तीहया माणहु तने दोड़ा वेर कहीन बांद रेहे, अने तु तीमनी वच मे नीकळीन जाय नी सके। <verse eid="EZK 3:25" /><verse number="26" style="v" sid="EZK 3:26" />में तारी जीप ने तारु ताळु सी लगाड़ही; जीनी सी तु होगो रीन तीमने वडवा वाळो नी रेय, काहाके तीहया झगड़ो करवा वाळा घोराणा ना से। <verse eid="EZK 3:26" /><verse number="27" style="v" sid="EZK 3:27" />पण जत्‌यार-जत्‌यार में तारी ह़ाते वात करही, ता-ता तारु मोडु ने उगड़ही, अने तु तीमने आसम केजे, ‘मालीक यहोवा आसम केय,’ जे ह़मळतु हय तीहयु ह़मळी लेय अने जे नी ह़मळतु तीहयु नी ह़मळे, तीहया झगड़ो करवा वाळा घोराणा ना सेत।”<verse eid="EZK 3:27" /></para>
  <chapter eid="EZK 3" />
  <chapter number="4" style="c" sid="EZK 4" />
  <para style="s">यरुसलेम नी घेराबन्‌दी ने देखाड़नु</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 4:1" />“ए माणेह नी अवल्‌यात, तु एक ईटड़ु ले अने तीने तारी अगळ मेकीन तीनी पोर एक ह़ेर, मतलब यरुसलेम नु चीत्‌र बणाव; <verse eid="EZK 4:1" /><verse number="2" style="v" sid="EZK 4:2" />अळतेण तीने घेर मतलब तीना वीरोद मे एक कीलो बणाव अने तीनी अगळ कोतड़्‌या खोद; अने पड़ावो नाख, अने तीनी च्‌यारो-मेर झुमायवा ना हत्‌यार लगाड़। <verse eid="EZK 4:2" /><verse number="3" style="v" sid="EZK 4:3" />ता तु लुहड़ा नो तवो लीन तीने लुहड़ा नु भीतड़ु मानीन तारी अने तीहया ह़ेर नी वच मे उबो कर, ता तारु मोडु तीनी अगळ करीन तीनी घेराबन्‌दी कर, आहयी रीते तु तीने घेरवीन राखजे। आहयु ईस्‌रायल ना घोराणा जुगु सेलाणी ठेरहे।<verse eid="EZK 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 4:4" />“अळतेण तु डाखरी ह़ोड़ केड़ दीन ह़ुवीन ईस्‌रायल ना घोराणा नो अधरम आह़फा पोर मेक, काहाके जेतरा दाड़ा तु तेम केड़ दीन ह़ुय रेही, तेतरा दाड़ा तक तीहया माणहु ना अधरम नो भार वेठतो रेही। <verse eid="EZK 4:4" /><verse number="5" style="v" sid="EZK 4:5" />में तीमना अधरम ना साल नी बराबर तारी जुगु दाड़ा ठेरावलो से, मतलब तीन ह़ो नब्‌बे दाड़ा; एतरा दाड़ा तक तु ईस्‌रायल ना घोराणा ना अधरम नो भार वेठतो रे। <verse eid="EZK 4:5" /><verse number="6" style="v" sid="EZK 4:6" />जत्‌यार एतरा दाड़ा पुरा हय जाय, ता तु जमणी ह़ोड़ केड़ दीन ह़ुवीन यहुदा ना घोराणा ना अधरम नो भार वेठ लेजे; में तीनी जुगु बी अने तारी जुगु एक साल नी बदले एक दाड़ो मतलब चाळीह दाड़ा ठेरावलो से।<verse eid="EZK 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 4:7" />“तु यरुसलेम नी घेराबन्‌दी जुगु बाथ उगाड़ीन आह़फा नु मोडु तींखर करीन तीना वीरोद मे भगवान वगे गेथी वात केजे। <verse eid="EZK 4:7" /><verse number="8" style="v" sid="EZK 4:8" />देख, में तने दोड़ा वेर कसही, अने जत्‌यार तक तीना घेराबन्‌दी ना दाड़ा पुरा नी हये, तांह तक तु केड़ नी दी सके।<verse eid="EZK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 4:9" />“तु गम, जुवार, वटळ्‌या, मसुर, बाजरी, अने जळगम, लीन एक ठाहरु मे मेकीन तीमनी वेर रोट्‌लो बणाया करजे। जेतरा दाड़ा तक केड़ दीन ह़ुय रेही, तेतरा मतलब तीन ह़ो नब्‌बे दाड़ा तक तीने खाया करजे। <verse eid="EZK 4:9" /><verse number="10" style="v" sid="EZK 4:10" />जे खाणु तु खाय, तीने तोली-तोलीन खाजे, मतलब दाड़ीक बे ह़ो तीस ग्‌राम<note caller="+" style="f"><char style="fr" closed="false">4:10 </char><char style="fq" closed="false">बे ह़ो तीस ग्‌राम </char><char style="ft" closed="false">20 सेकेल</char></note> खाया करजे, अने तीने टेम-टेम पोर खाजे। <verse eid="EZK 4:10" /><verse number="11" style="v" sid="EZK 4:11" />पाणी बी तु मापीन पीया करजे, मतलब दाड़ीक बे गीलास, अने तीने बी तु ठेरावली टेम पोर पीजे। <verse eid="EZK 4:11" /><verse number="12" style="v" sid="EZK 4:12" />तारु खाणु जळगम ना रोल्‌टान तेम बणाय्‌न खाया करजे, अने तीने माणहु ना हगार ना छाणा पोर तीमनी देखणते ह़ेकजे।”<verse eid="EZK 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 4:13" />अळतेण यहोवा केदो, “आहयी रीते ईस्‌रायल तीहया राज्‌य नी वच मे आह़फा-आह़फा ना वीटळ्‌ळा रोट्‌ला खाया करहे, जां में तीमने जबरजस्‌ती पुगाड़ही।”<verse eid="EZK 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 4:14" />ता में केदो, “गरा आय पड़े, यहोवा भगवान देख, मारु मन कारु बी नी वीटळ्‌यु, अने नी में नान्‌लो हतो तां गेथो लगाड़ीन हजु तक मरला पाळला-जानवरु नु, अने नी जंगली जानवरु नी लारे मारला नु मांह खादो, अने नी कानी भाती नु ह़ीगी आवे एवु मांह मारा मोडा मे कारु बी जेलु हय।”<verse eid="EZK 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 4:15" />ता तीहयो मने केदो, “देख, में तारी जुगु माणहु ना हगार ना छाणा नी बदले ढुरु ना छाण ना छाणा ठेरावलो से, अने तीनीत वेर तु तारा रोट्‌ला ह़ेकजे।”<verse eid="EZK 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 4:16" />अळतेण तीहयो मने केदो, “ए माणेह नी अवल्‌यात, देख, में यरुसलेम मे खाणु-पीणु बंद करही; करीन तां ना माणहु तोली-तोलीन अने चीन्‌ता करी-करीन रोट्‌ला खाया करहे; अने ह़ोह़ मे पड़ी-पड़ीन पाणी पीया करहे। <verse eid="EZK 4:16" /><verse number="17" style="v" sid="EZK 4:17" />अने आनी सी तीमने रोट्‌ला अने पाणी नी कमी हयहे; अने तीहया आखान-आखा घबरायहे, अने आह़फाम ना अधरम मे फसीन खत्‌तम हय जहे।”<verse eid="EZK 4:17" /></para>
  <chapter eid="EZK 4" />
  <chapter number="5" style="c" sid="EZK 5" />
  <para style="s">नीम्‌बाळा बोड़ीन यहेजकेल नी लारे यरुसलेम नु खत्‌तम हयणु देखाड़नु</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 5:1" />“ए माणेह नी अवल्‌यात, एक वेताळी तलवार ले, अने तीने नावटु नी पावड़ीन तेम काम मे लीन आह़फा नी डाडी अने मुंडे ना नीम्‌बाळा बोड़ दे, ता तोलवा नो काटो लीन तीना तीन वाटा पाड़। <verse eid="EZK 5:1" /><verse number="2" style="v" sid="EZK 5:2" />जत्‌यार ह़ेर ना घेराबन्‌दी ना दाड़ा पुरा हय जाय, ता ह़ेर मे तीन वाटा ना एक वाटा ने लीन आक्‌ठु वेर धपाड़जे, अने बीजा वाटा लीन ह़ेर नी च्‌यारो-मेर तलवार वेर टुकड़ा-टुकड़ा करजे; अने तीसरा वाटा ने लीन वाहळा मे उडाड़जे, अने में तलवार हापकीन तीनी पसळ चलाड़ही। <verse eid="EZK 5:2" /><verse number="3" style="v" sid="EZK 5:3" />ता आमनी मे गेथा थोड़ाक नीम्‌बाळा लीन आह़फा ना लुगड़ा नी कोर्‌ये बांदजे। <verse eid="EZK 5:3" /><verse number="4" style="v" sid="EZK 5:4" />अळतेण आमनी मे गेथा बी थोड़ाक लीन आक्‌ठु नी वच मे नाखजे के तीहया धप जाय, ता तीनी मे गेथुत एक आक्‌ठु नीकळीन ईस्‌रायल ना आखा घोराणा मे फेल जहे।”<verse eid="EZK 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 5:5" />मालीक यहोवा आसम केय: यरुसलेम आसवुत से; में तीने बीजा राज्‌य नी वच मे वहाड़लो से, अने तीहयु च्‌यारो-मेर देसु सी घेरवायलु से। <verse eid="EZK 5:5" /><verse number="6" style="v" sid="EZK 5:6" />यरुसलेम ह़ेर मारा नेमु ना वीरोद मे काम करीन बीजा राज्‌य सी जादा गलत काम करलु से, अने मारी रीती ना वीरोद मे च्‌यारो-मेर ना देसु ना माणहु ह़ाते जादा बुराय करला से; काहाके तीहया मारा नेम ने नी मान्‌या, अने तीहया मारी रीती पोर नी चाल्‌या। <verse eid="EZK 5:6" /><verse number="7" style="v" sid="EZK 5:7" />करीन मालीक यहोवा आसम केय: तमु जे तमारी च्‌यारो-मेर ना राज्‌य सी जादा बकबक करला से, अने नी मारी रीती पोर चालता, अने नी मारा नेमु ने मान्‌ता अने तमारी च्‌यारो-मेर ना राज्‌य ना नेमु नी अनसारे बी नी कर्‌या, <verse eid="EZK 5:7" /><verse number="8" style="v" sid="EZK 5:8" />करीन मालीक यहोवा आसम केय: देख, में खुद तारा वीरोद मे से; अने बीजा राज्‌य नी देखणते में तारी वच मे नीयाव ना काम करही। <verse eid="EZK 5:8" /><verse number="9" style="v" sid="EZK 5:9" />तारा आखा गलत कामु ना कारण सी में तारी वच मे आसम करही, जेम हजु तक नी कर्‌यो, अने नी अगो चालीन अळी करु। <verse eid="EZK 5:9" /><verse number="10" style="v" sid="EZK 5:10" />ह़मळो, तारी वच मे सोरा आह़फा-आह़फाम ना बाह नु, अने बाह आह़फा-आह़फाम ना सोरा नु मांह खाहे; अने मे तने डंड आपही, अने जे माणहु बच जहे, तीमने में च्‌यारो-मेर खोळवी देही।<verse eid="EZK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 5:11" />करीन मालीक यहोवा आसम केय: के मारी जीवाय नी ह़ाम, आनीन करते के तु मारा चोखला जागा ने तारा ह़ीगी आवे एवा मुरत्‌या अने आखा ह़ीगी आवे एवा कामु सी वीटाळला से, में तने कम करही, अने तारी पोर दया नी नींगा नी करु, अने तारी पोर कंय बी भलाय नी करु। <verse eid="EZK 5:11" /><verse number="12" style="v" sid="EZK 5:12" />तारी मे नो तीसरा वाटा मे गेथो एक वाटो ते गरा सी मरहे, तीहया तारी वच मे भुक सी मर मीटहे; बीजो वाटो तारी आड़े-धेड़े तलवार वेर मरहे; अने बचला तीसरा वाटा ने मे च्‌यारो-मेर तीतर-बीतर करही अने तलवार हापकीन तीमनी पसळ पाड़ही।<verse eid="EZK 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 5:13" />“आहयी रीते मारी रीह ठंडी पड़हे, अने मारी रीह तीमनी पोर पुरी नीकाळीन सांती हात करही; अने जत्‌यार में मारी रीह तीमनी पोर पुरी रीते नीकाळ लेही, ता तीहया जाण लेहे के में यहोवात रीह मे आवीन आहयु केदलो से। <verse eid="EZK 5:13" /><verse number="14" style="v" sid="EZK 5:14" />में तने तारी च्‌यारो-मेर नी जाती नी वच मे, आखा आव्‌वा-जवा वाळा नी देखणते उजाड़ही, अने तारो वाक कडाड़ही।<verse eid="EZK 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 5:15" />“करीन जत्‌यार में तने रीह, खीज अने काठी डाट भेळ डंड आपही, ता तारी च्‌यारो-मेर ना राज्‌य अगळ ह़ीगी, वाक, ठट्‌टा, अने नामबद्‌दी हयहे, काहाके में यहोवा आहयु केदलो से। <verse eid="EZK 5:15" /><verse number="16" style="v" sid="EZK 5:16" />आहयु तीहयी टेमे हयहे, जत्‌यार में तीहया माणहु ने खत्‌तम करवा करीन तारी पोर काळ ना बीलखा चलाड़ीन, तमारी वच मे काळ लावही, अने तमारु खाणु पीणु ने बंद करही। <verse eid="EZK 5:16" /><verse number="17" style="v" sid="EZK 5:17" />में तमारी वच मे काळ अने जन्‌तु मोकलही जे तमारा सोरा ने खाय जहे; अने गरा अने मोत तमारी वच मे चालता रेहे; अने में तमारी पोर तलवार चलाड़ही, में यहोवा आहयु केदलो से।”<verse eid="EZK 5:17" /></para>
  <chapter eid="EZK 5" />
  <chapter number="6" style="c" sid="EZK 6" />
  <para style="s">भगवान नी लारे मुर्‌ती पुजान वाक काडणु</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 6:1" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 6:1" /><verse number="2" style="v" sid="EZK 6:2" />“ए माणेह नी अवल्‌यात, आह़फा नु मोडु ईस्‌रायल ना बड़ा भणीन करीन तीमना वीरोद मे भगवान वगे गेथी वात के, <verse eid="EZK 6:2" /><verse number="3" style="v" sid="EZK 6:3" />अने के, ए ईस्‌रायल ना बड़ा, मालीक यहोवा नो बोल ह़मळो! मालीक यहोवा बड़ा अने बड़ी सी, अने कोतड़ा अने घाट्‌या ने आसम केय: देखो में तमारी पोर तलवार चलाड़ही, अने तमारा पुजा ना उचा जागा ने खत्‌तम करही। <verse eid="EZK 6:3" /><verse number="4" style="v" sid="EZK 6:4" />तमारी वेद्‌या उजड़हे अने तमारा दाहड़ु ना मुरत्‌या तोड़ देहे; अने में तमारी मे गेथा मारला ने तमारा मुरत्‌या अगळ नाख देही। <verse eid="EZK 6:4" /><verse number="5" style="v" sid="EZK 6:5" />में ईस्‌रायली माणहु ना धोड़ ने तीमना मुरत्‌या अगळ मेकही, अने तीमना हाटका ने तमारा वेद्‌या नी आड़े-धेड़े खोळवी देही। <verse eid="EZK 6:5" /><verse number="6" style="v" sid="EZK 6:6" />तमारा जेतरा वहाड़ला ह़ेर से, तीहया आखा आसम उजड़ जहे, के तमारा पुजा नी उची जागा बी उजड़ जहे, तमारा वेद्‌या उजड़ी जहे अने ओदार देहे, तमारा मुरत्‌या तोड़ देहे अने तमारा दाड़ु ना मुरत्‌या टुकड़ा-टुकड़ा कर देहे; अने तमारी आखी कारीगरी मीटाड़ देहे। <verse eid="EZK 6:6" /><verse number="7" style="v" sid="EZK 6:7" />तमारी वच मे धोड़ ना ढेर रेहे, अने तमु जाण लेहु के में यहोवा से।<verse eid="EZK 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 6:8" />“ते बी में थोड़ाक ने बचाड़ीन राखही। एतरे जत्‌यार तमु देस-देस मे तीतर-बीतर हयहु, ता राज्‌य-राज्‌य नी वच मे तमारा थोड़ाक माणहु तलवार सी बच जहे। <verse eid="EZK 6:8" /><verse number="9" style="v" sid="EZK 6:9" />तीहया बचला माणहु, तीहया राज्‌य नी वच मे, जीनी मे तीहया गुलामी मे रेहे, मने फोम करहे; अने आहयु बी के अमारु छीनाळ्‌यु मन यहोवा पोर गेथु केम सेटु हय जेलु से, अने छीनाळ्‌याण ने तेम अमारा डोळा मुरत्‌या पोर कीकम जाय टेक्‌या, जीनी सी यहोवा नु मन टुटलु से। आहयी रीते तीहयी बुराय ना कारण, जे तीहया आह़फाम ना आखा ह़ीगी आवे एवा काम करला से, तीहया आह़फाम नी नींगा मे ह़ीगी आवे एवा ठेरहे। <verse eid="EZK 6:9" /><verse number="10" style="v" sid="EZK 6:10" />ता तीहया जाण लेहे के में यहोवा से, अने तीमनु आखु नुकसान करवा करीन जे में केदलो से, तीने उदड़ेत नी केदो।”<verse eid="EZK 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 6:11" />मालीक यहोवा आसम केय: “आह़फा नो हात मड़ीन अने आह़फा नो पोग हेटो आंहटीन के, ईस्‌रायल ना घोराणा ना आखा ह़ीगी आवे एवा कामु पोर गरा आय पड़े, गरा आय पड़े, काहाके तीहया तलवार, भुक, अने गरा सी खत्‌तम हय जहे। <verse eid="EZK 6:11" /><verse number="12" style="v" sid="EZK 6:12" />जे सेटा हय तीहया गरा सी मरहे, अने जे ह़ाते हय तीने तलवार सी मारहे; अने जे बचीन ह़ेर मे घेरवाय जहे, तीहयो भुक सी मरहे। आहयी रीते मारी आखी रीह तीमनी पोर पुरी रीते नीकाळही। <verse eid="EZK 6:12" /><verse number="13" style="v" sid="EZK 6:13" />जत्‌यार एक-एक बड़ी अने बड़ा नी एक-एक चोट्‌ली पोर, अने एक-एक लील्‌ला झाड़ नी तळे, अने एक-एक झाजला वांज्‌या नाम ना झाड़ ना साहळा मे, जां-जां तीहया आह़फाम ना मुरत्‌या ने वारु घटाळ्‌ळा अने वारु गंदायण्‌या मसाला चड़ावता हता, तां तीमना मारला माणहु तीमना वेद्‌या नी आड़े-धेड़े तीमना मुरत्‌या नी वच मे पड़ी रेहे; ता तमु जाण लेहु के में यहोवा से। <verse eid="EZK 6:13" /><verse number="14" style="v" sid="EZK 6:14" />में मारो हात तीमना वीरोद मे नाम्‌बो करीन तीहया देस ने आखा घोरु भेळ जंगल गेथो लगाड़ीन रीबला ह़ेर तक उजाड़ेत-उजाड़ कर देही। ता तीहया जाण लेहे के में यहोवा से।”<verse eid="EZK 6:14" /></para>
  <chapter eid="EZK 6" />
  <chapter number="7" style="c" sid="EZK 7" />
  <para style="s">ईस्‌रायल नो डंड ह़ाते से</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 7:1" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 7:1" /><verse number="2" style="v" sid="EZK 7:2" />“ए माणेह नी अवल्‌यात,” मालीक यहोवा ईस्‌रायल नी धरती ना बारा मे आसम केय: खत्‌तम हयु; च्‌यारोव खुणा भेळ देस खत्‌तम हयणु आय जेलु से।<verse eid="EZK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 7:3" />“ए ईस्‌रायल, तारु खत्‌तम हयणु बी आय जेलु से, अने में मारी रीह तारी पोर नीकाळीन तारी चाल-चलण नी अनसारे तने डंड आपही; अने तारा आखा ह़ीगी आवे एवा काम नो फोळ में तने आपही। <verse eid="EZK 7:3" /><verse number="4" style="v" sid="EZK 7:4" />मारी भलाय नी नींगा तारी पोर नी रेय, अने नी में भोळाय करु, अने जत्‌यार तक तारा ह़ीगी आवे एवा पाप तारी मे बणीन रेहे तांह तक में तारी चाल-चलण नो फोळ तने आपही। ता तु जाण लेही के में यहोवा से।”<verse eid="EZK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 7:5" />मालीक यहोवा आसम केय: “गरा से, एक मोट्‌ली गरा से! देखो तीहयी आवे। <verse eid="EZK 7:5" /><verse number="6" style="v" sid="EZK 7:6" />खत्‌तम हयणु आय जेलु से, आखा नु खत्‌तम हयणु आय जेलु से; तीहयो तारा वीरोद मे जागलो से। देखो तीहयो आवे। <verse eid="EZK 7:6" /><verse number="7" style="v" sid="EZK 7:7" />ए ईस्‌रायल देस ना रेवा वाळा! तमारी खत्‌तम हयवा नी टेम आय लागी। तमारी जुगु मोत नी चक्‌री फीरी जेली से, खत्‌तम हयवा नो दाड़ो ह़ाते आय लागलो से; तीहयो बड़ा पोर खुसी ना सब्‌द नो नी, पण एथान-एथा दवड़वा नो दाड़ो रेहे।<verse eid="EZK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 7:8" />“हाव थोड़ाक दाड़ा मे, में मारी रीह तारी पोर नीकाळही, अने तारी पोर आखी खीज नीकाळही अने तारा चाल-चलण नी अनसारे तने डंड आपही। ता आखा ह़ीगी आवे एवा काम नो फोळ में तने भुकताड़ही। <verse eid="EZK 7:8" /><verse number="9" style="v" sid="EZK 7:9" />मारी भलाय नी नींगा तारी पोर नी रेय अने नी में तारी पोर भोळाय करु। में तने तारी चाल-चलण नो फोळ भुगताड़ही, अने तारा ह़ीगी आवे एवा पाप तारी मे बणीन रेहे। ता तमु जाण लेहु के में यहोवा डंड आपवा वाळो से।”<verse eid="EZK 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 7:10" />देखो, तीहया दाड़ा ने देखो, तीहयो आवे! चक्‌री फीर जेली से, अने वेला पाड़वा नी घड़ी बड़ जेली से, अने तारो घमंड बड़ जेलो से। <verse eid="EZK 7:10" /><verse number="11" style="v" sid="EZK 7:11" />कोहराय बड़ती-बड़ती बुराय नो डंड बण जेली से; तीमनी मे गेथु कोय बी नी वचे, अने नी तीमनी भीड़-भाड़, अने नी तीमना धन मे गेथु कंय रेय; अने नी तीमनी मे गेथा कोय जुगु कलपवु ह़मळाये।<verse eid="EZK 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 7:12" />टेम आय जेली से, दाड़ो ह़ातेत आय जेलो से; नी ते वेचातु लेवा वाळो खुसी मनावे अने नी वेचवा वाळो दुखी हये, काहाके तीमनी आखी भीड़ पोर मालीक नी रीह आय पड़हे। <verse eid="EZK 7:12" /><verse number="13" style="v" sid="EZK 7:13" />भले तीहया जीवत्‌ला रेय, ते बी वेचवा वाळो वेचली चीज ने तां कारु बी पासो नी जाय सके; काहाके केदली आहयी आखी वात देस नी आखी भीड़ पोर पुरी हयहे, कोय बी पासु नी आवे; कोय बी माणेह जे अधरम मे जीवत्‌लु रेय, तीहयो खुद ने ह़माळ नी सके। <verse eid="EZK 7:13" /><verse number="14" style="v" sid="EZK 7:14" />तीहया फेपार्‌या वगाड़्‌या अने आखु कंय तीयार कर देदा; पण झुमायवा कोय बी नी जतु काहाके देस नी आखी भीड़ पोर मारी रीह आय पड़ली से।<verse eid="EZK 7:14" /></para>
  <para style="s">ईस्‌रायल ना पापु नो डंड</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 7:15" />“बाहर तलवार अने मोय काळ अने गरा से; जे मेदान मे हय तीहयु तलवार सी मरहे, अने जे ह़ेर मे हय तीहयु भुक अने काळ सी मरहे। <verse eid="EZK 7:15" /><verse number="16" style="v" sid="EZK 7:16" />तीमनी मे गेथा जे बच नीकळहे तीहया बची ते जहे पण आह़फा-आह़फाम ना अधरम मे फसीन रीन घाटी मे रेवा वाळा पारवान तेम बड़ा पोर कलपता रेहे। <verse eid="EZK 7:16" /><verse number="17" style="v" sid="EZK 7:17" />आखा ना हात ढीला अने आखा ना घोटणा कमजोर हय जहे। <verse eid="EZK 7:17" /><verse number="18" style="v" sid="EZK 7:18" />तीहया केड़ मे गोंटा ना लुगड़ा पेरहे, अने तीहया माणहु कापवा बाज जहे, अने आखा ना मोडा ह़ुक जहे अने आखा ना मुंडा ने बोड़ देहे। <verse eid="EZK 7:18" /><verse number="19" style="v" sid="EZK 7:19" />तीहया आह़फाम नु चांदी ह़ड़क पोर नाख देहे, अने तीमनु ह़ोनु वीटळ्‌ळु चीज ठेरहे; यहोवा नी रीह ना दाड़े तीमनु ह़ोनु-चांदी तीमने बचाड़ी नी सके, अने नी तीनी सी तीमनो जीव खुस हये, अने नी तीमना पेट भराय। काहाके तीहयु तीमना अधरम ना ठोकर नो कारण बणलु से। <verse eid="EZK 7:19" /><verse number="20" style="v" sid="EZK 7:20" />तीमनु देस जे घटाळ्‌ळु अने वजन वेर ह़ींगारलु हतु, तीना वारा मे तीहया वारुत-वारु कीन तीनी मे ह़ीगी आवे एवी चीज ना मुरत्‌या, अने ह़ीगी आवे एवा चीज बणाय्‌न राख र्‌या, करीन में तीने तीमनी जुगु वीटळ्‌ळा चीज ठेरावलो से।<verse eid="EZK 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 7:21" />“में तीने लुटवा करीन बीजा देस वाळा ना हात मे, अने धन लुटवा करीन धरती ना वेरी माणहु ना हात मे कर देही, अने तीहया तीने वीटाळ देहे। <verse eid="EZK 7:21" /><verse number="22" style="v" sid="EZK 7:22" />में तीमनी भणी गेथो मोडु फीरवी लेही, ता तीहया मारा वारला जागा ने वीटाळ देहे; डाकु तीनी मे भराय्‌न तीने वीटाळहे।<verse eid="EZK 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 7:23" />“एक ह़ाकळ बणाय दे, काहाके देस वेला नी मोत सी, अने ह़ेर गलत कामु सी भरायलु से। <verse eid="EZK 7:23" /><verse number="24" style="v" sid="EZK 7:24" />मे राज्‌य-राज्‌य ना बुरा सी बुरा माणहु ने लावही, जे तीमना घोरु ना मालीक बण जहे; अने में हीम्‌मत वाळान हीम्‌मत तोड़ देही अने तीमना चोखला जागा वीटाळ देहे। <verse eid="EZK 7:24" /><verse number="25" style="v" sid="EZK 7:25" />दुख-वेला आव्‌वा पोर तीहया सांती ने ह़ोदहे, पण तीमने सांती नी जड़े। <verse eid="EZK 7:25" /><verse number="26" style="v" sid="EZK 7:26" />गरा पोर गरा आवहे अने आनी वात पोर वात ह़मळायहे; अने माणहु भगवान वगे गेथी वात केवा वाळा ने दरसन नी वात पुछहे, पण पुंजारा पांह गेथो नेम, अने डायला माणहु पांह गेथी ह़ला आपवा नी सक्‌ती जत रेहे। <verse eid="EZK 7:26" /><verse number="27" style="v" sid="EZK 7:27" />राजा ते दुखी हयहे, अने पोमत्‌ला ह़ोह़ मे पड़ रेहे, अने देस ना माणहु ना हात ढीला पड़हे। में तीमनी चाल-चलण नी अनसारे तीमनी ह़ाते वेहवार करही, अने तीमनी कमाय ने तेम तीमने डंड आपही; ता तीहया जाण लेहे के में यहोवा से।”<verse eid="EZK 7:27" /></para>
  <chapter eid="EZK 7" />
  <chapter number="8" style="c" sid="EZK 8" />
  <para style="s">भगवान ना बारा मे यहेजकेल नो बीजो दरसन</para>
  <para style="r">(<ref loc="EZK 8:1-10:22">8:1–10:22</ref>)</para>
  <para style="s">यरुसलेम मे मुरती पुजा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 8:1" />अळतेण छटवा साल ना छटवा मयना ना पांचवा दाड़े जत्‌यार में मारा घोर बह रेलो, अने यहुदीम ना डायला माणहु मारी अगळ बहला हता, ता मालीक यहोवा नी सक्‌ती तांत मारी पोर उजन्‌ती हयी। <verse eid="EZK 8:1" /><verse number="2" style="v" sid="EZK 8:2" />ता में देख्‌यो के आक्‌ठुन तेवो एक रुप देखाव पड़े; तीना केड़्‌या गेथु हेटु आक्‌ठु से, अने तीना केड़्‌ये गेथु उपर चमकाड़लु पीतळ नी चमक ने तेवु कंय से। <verse eid="EZK 8:2" /><verse number="3" style="v" sid="EZK 8:3" />तीहयो हात ने तेवु कंय नाम्‌बु करीन मारा मुंडे ना नीम्‌बाळा धर्‌यो; ता आत्‌मा मने धरती अने वादळा नी वच मे उचलीन भगवान ना देखाड़ला दरसन मे यरुसलेम ना मंदीर नी मोय, आंगणु ना तीहया झापले पुगाड़ देदो जीनु मोडु धुराव भणी से; अने जीनी मे तीहयी रीह पयदा करवा वाळी मुर्‌ती नो जागो हतो जीना कारण सी वीरोद पयदा हये।<note caller="+" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="EZK 1:28">यहेजकेल 1:28</ref></char></note><verse eid="EZK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 8:4" />अळतेण तां ईस्‌रायल ना भगवान नु वीजाळु तेवुत हतु जेवु में कबार नंदी ना काठे देखलो हतो। <verse eid="EZK 8:4" /><verse number="5" style="v" sid="EZK 8:5" />तीहयो मने केदो, “ए माणेह नी अवल्‌यात, तारा डोळा धुराव भणी उचा करीन देख।” अने में मारा डोळा धुराव भणी उचा करीन देख्‌यो के वेदी नु झापलु नी धुराव भणी मोय भरायवा ना जागेत तीहयी रीह पयदा करवा वाळी मुर्‌ती से।<verse eid="EZK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 8:6" />ता तीहयो मने केदो, “ए माणेह नी अवल्‌यात, ह़ु तु देखे के आहया माणहु ह़ु करवा बाज र्‌या? ईस्‌रायल नु घोराणु ह़ु ह़ीगी आवे एवु आञे काम कर र्‌यु, आनी करते के में मारा चोखला जागा मे गेथो सेटो हय जाम; पण तु आनी सी बी जादा ह़ीगी आवे एवा काम देखही।”<verse eid="EZK 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 8:7" />ता तीहयो मने आंगणु ना झापले ली ज्‌यो, अने में देख्‌यो, के भीतड़ु मे एक डुचो से। <verse eid="EZK 8:7" /><verse number="8" style="v" sid="EZK 8:8" />ता तीहयो मने केदो, “ए माणेह नी अवल्‌यात, भीतड़ु ने फोड़” करीन में भीतड़ु ने फोड़ीन ह़ु देख्‌यो के एक झापलु से। <verse eid="EZK 8:8" /><verse number="9" style="v" sid="EZK 8:9" />तीहयो मने केदो, “मोय जाय्‌न देख के आहया माणहु आञे केवा-केवा अने घणा ह़ीगी आवे एवा काम कर र्‌या।” <verse eid="EZK 8:9" /><verse number="10" style="v" sid="EZK 8:10" />अने में मोय जाय्‌न देख्‌यो के च्‌यारो-मेर नु भीतड़ु पोर भाती-भाती ना घीहाय्‌न चालवा वाळा जन्‌तु अने ह़ीगी आवे जानवर अने ईस्‌रायल ना घोराणा ना आखा मुरत्‌या ना चीत्‌रा बणावला हता। <verse eid="EZK 8:10" /><verse number="11" style="v" sid="EZK 8:11" />ईस्‌रायल ना घोराणा ना डायला माणहु मे गेथा सत्‌तर अदमी जीमनी वच मे सापान नो सोरो याजन्‌याह बी से। तीहया आहया चीत्‌रा नी अगळ उबा हय र्‌या, अने एक-एक अदमी आह़फा-आह़फाम ना हात मे धुप-अगरबत्‌ती लेदला से, अने धुप-अगरबत्‌ती नो धुकरो उपर उड र्‌यो। <verse eid="EZK 8:11" /><verse number="12" style="v" sid="EZK 8:12" />ता तीहयो मने केदो, “ए माणेह नी अवल्‌यात, ह़ु तु देखलो से के ईस्‌रायल ना घोराणा ना डायला माणहु आह़फा-आह़फाम ना हात वेर बणावला फुटक्‌या सी भरला खोल्‌या नी मोय मतलब अंदारलु मे ह़ु करवा बाज र्‌या? तीहया केय के यहोवा आमने नी देखतो; यहोवा देस ने छोड़ देदलो से।”<verse eid="EZK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 8:13" />अळतेण तीहयो मने केदो, “तु आमनी सी अळी बी जादा ह़ीगी आवे एवा काम देखही जे तीहया करे।” <verse eid="EZK 8:13" /><verse number="14" style="v" sid="EZK 8:14" />ता तीहयो मने यहोवा ना घोर ना तीहया फाटा ना झापलान्‌तां लीज्‌यो जे धुराव भणी हतु अने तां बयरा बहीन तम्‌मुज नाम ना देवता जुगु रड़वा बाज री हती।<verse eid="EZK 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 8:15" />ता तीहयो मने केदो, “ए माणेह नी अवल्‌यात, ह़ु तु आहयु देखलो से? अळतेण आमनी सी बी जादा ह़ीगी आवे एवा काम तु देखही।” <verse eid="EZK 8:15" /><verse number="16" style="v" sid="EZK 8:16" />ता तीहयो मने यहोवा ना मोय ना घोर ना मोय ना आंगणा मे ली ज्‌यो; अने तां यहोवा ना घोर ना झापलान्‌तां मांडवा अने वेदी नी वच मे पच्‌चीहेक अदमी आह़फाम ना वाहां यहोवा ना घोर भणीन करीन अने आह़फाम ना मोडा उगवणी ह़ोड़ करला हता; अने तीहया उगवणी ह़ोड़ दाहड़ु ने वांदवा बाज र्‌या हता।<verse eid="EZK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 8:17" />ता तीहयो मने केदो, “ए माणेह नी अवल्‌यात, ह़ु तु आहयु देख्‌यो? ह़ु यहुदा ना घोराणा जुगु ह़ीगी आवे एवा कामु नु करनु जे तीहया आञे करे नानी वात से? तीहया आह़फाम नु देस ने झगड़ा सी भर देदा, अने अळतेण आञे आवीन मने रीह लगाड़े। अने मानो तीहया मोडु चड़ाय्‌न मारो वाक काडे। <verse eid="EZK 8:17" /><verse number="18" style="v" sid="EZK 8:18" />करीन में बी रीह भेळ काम करही, नी में दया करु अने नी में भोळाय करु, भले तीहया मारा कांटा मे ज्‌योरे आड़े, ते बी में तीमनी वात नी ह़मळु।”<verse eid="EZK 8:18" /></para>
  <chapter eid="EZK 8" />
  <chapter number="9" style="c" sid="EZK 9" />
  <para style="s">यरुसलेम ने डंड आपणु</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 9:1" />अळतेण तीहयो मारा कांटा मे ज्‌योरेत आड़ीन केदो, “ह़ेर ने डंड आपवा वाळा आह़फा-आह़फाम ना हात मे हत्‌यार लीन मारीन्‌तां आवो।” <verse eid="EZK 9:1" /><verse number="2" style="v" sid="EZK 9:2" />ता छो अदमी धुराव भणी उपरला झापला नी वाटे माय्‌न आह़फा-आह़फाम ना मारवा ना हत्‌यार लीन आया, अने तीमनी वच मे सुती ना लुगड़ा पेरीन, केड़ मे लीखवा नी संय नी डब्‌बी बांदीन एक अळी अदमी हतो; अने तीहया आखा घोर मे जाय्‌न पीतळ नी वेदीन्‌तां जाय्‌न उबा हया।<verse eid="EZK 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 9:3" />ता ईस्‌रायल ना भगवान नो ह़ेक करुबु पोर गेथो, जीमनी पोर तीहयो रीया करतो हतो, घोर ना मांडवा पोर उठ आवलो हतो; अने तीहयो तीहया सुती ना लुगड़ा पेरला अदमी ने जे केड़ मे संय नी डब्‌बी बांदीन हतो, आड़्‌यो। <verse eid="EZK 9:3" /><verse number="4" style="v" sid="EZK 9:4" />अने यहोवा तीने केदो, “आहया यरुसलेम ह़ेर नी मोय एथोन-एथो जाय्‌न जेतरा माणहु तीहया आखा ह़ीगी आवे एवा कामु ना कारण सी जे तीनी मे करे, कपले अने दुख नी मारे आड़े, तीमना मुंडा पोर सेलाणी लगाड़ दे।”<note caller="+" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="REV 7:3">परकासीतवाक्‌य 7:3</ref>; <ref loc="REV 9:4">9:4</ref>; <ref loc="REV 14:1">14:1</ref></char></note><verse eid="EZK 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 9:5" />ता तीहयो मारी ह़मळते बीजाम ने केदो, “ह़ेर मे तीमनी पसळ-पसळ चालीन मारता जावो; कोय पोर बी दया नी करजो अने नी भोळाय सी काम करजो। <verse eid="EZK 9:5" /><verse number="6" style="v" sid="EZK 9:6" />डायला, जुवान्‌या, कुवारी सोरी, बाळ-बच्‌चा, बयरा, आखा ने मारीन खत्‌तम करो, पण जे कोय माणेह ना मुंडा पोर तीहयी सेलाणी हय, तीनी ह़ाते नी जजो। मारा चोखला जागान्‌तां गेथात सुरु करो।” अने तीहया ते डायलाम ने तां गेथा सुरु कर्‌या जे मालीक ना घोर नी अगळ हता।<verse eid="EZK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 9:7" />अळतेण तीहयो तीमने केदो, “घोर ने वीटाळ देवो, अने आंगणु ने धोड़ सी भर देवो। चालो, बाहर नीकळो।” ता तीहया नीकळीन ह़ेर मे मारवा बाज ज्‌या।<verse eid="EZK 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 9:8" />जत्‌यार तीहया मारवा बाज र्‌या हता, अने में एखलो री ज्‌यो, ता में मोडा ना भरहे पड़्‌यो अने आड़ीन केदो, “गरा आय पड़े यहोवा! ह़ु तु तारी रीह यरुसलेम पोर नीकाळीन ईस्‌रायल ना आखा बचला ने बी खत्‌तम करही?”<verse eid="EZK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 9:9" />ता तीहयो मने केदो, “ईस्‌रायल अने यहुदा ना घोराणा नो अधरम घणो जादा से, आञे तक के देस मोत सी अने ह़ेर गलत काम सी भराय जेलु से; काहाके तीहया केय, ‘यहोवा धरती ने छोड़ देदलो से, अने यहोवा कंय बी नी देखतो।’ <verse eid="EZK 9:9" /><verse number="10" style="v" sid="EZK 9:10" />करीन तीमनी पोर दया नी हये, अने नी में भोळाय करु, अने तीहया जेम बीजा ह़ाते कर्‌या तेमेत तीमनी ह़ाते बी करही।”<verse eid="EZK 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 9:11" />ता में ह़ु देख्‌यो, के जे अदमी सुती ना लुगड़ा पेरीन अने केड़ मे संय नी डब्‌बी बांदलो हतो, तीहयो आहयु कीन खबर आप्‌यो, “जेम तु हुकम आपलो, में तेमेत करलो से।”<verse eid="EZK 9:11" /></para>
  <chapter eid="EZK 9" />
  <chapter number="10" style="c" sid="EZK 10" />
  <para style="s">भगवान नो वीजाळु मंदीर मे गेथु नीकळे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 10:1" />आनीन अळतेण मे देख्‌यो के करुब ना मुंडा पोर जे तारा मंडळी हती, तीनी मे नीलमणी नाम ना मोगला दगड़ान तेवु देखाव पड़्‌यु।<note caller="+" style="x"><char style="xo" closed="false">10:1 </char><char style="xt" closed="false"><ref loc="EZK 1:26">यहेजकेल 1:26</ref>; <ref loc="REV 4:2">परकासीतवाक्‌य 4:2</ref></char></note> <verse eid="EZK 10:1" /><verse number="2" style="v" sid="EZK 10:2" />ता यहोवा तीहया सुती ना लुगड़ा पेरला अदमी ने केदो, “फीरवा वाळा चाकटा नी वचे करुबुन हेटो जा अने तारा बेम मुठ ने करुबु नी वच मे ना ईंगाळा वेर भरीन ह़ेर पोर नाख दे।”</para>
  <para style="p" vid="EZK 10:2">अने तीहयो मारी देखणते तीमनी वच मे ज्‌यो। <verse eid="EZK 10:2" /><verse number="3" style="v" sid="EZK 10:3" />जत्‌यार तीहयो अदमी मोय ज्‌यो, ता तीहया करुबु मालीक ना घोर नी जमणी ह़ोड़ उबा हय र्‌या हता; अने वादळु मोय वाळु आंगणु मे भरलु हतु। <verse eid="EZK 10:3" /><verse number="4" style="v" sid="EZK 10:4" />ता यहोवा नु वीजाळु करुबु नी उपर गेथु उठीन घोर ना अगळ ना ओट्‌ला पोर आय लाग्‌यु; अने वादळु घोर मे भराय ज्‌यु; अने तीहयु आंगणु यहोवा नु वीजाळु नु उजड़ सी भराय ज्‌यु। <verse eid="EZK 10:4" /><verse number="5" style="v" sid="EZK 10:5" />करुबु ना पाखड़ा नी अवाज बारला आंगणा मे तक ह़मळायती हती, तीहयी आखा मे जोर भर्‌या भगवान बोले तीनीन तेवो सब्‌द हतो।<verse eid="EZK 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 10:6" />जत्‌यार तीहयो सुती ना लुगड़ा पेरला अदमी ने फीरवा वाळा चाकटा नी मोय करुबु नी वच मे गेथा ईंगाळा लेवा नो हुकम आप्‌यो, ता तीहयो तीमनी वच मे जाय्‌न एक चाकटुन्‌तां उबो हयो। <verse eid="EZK 10:6" /><verse number="7" style="v" sid="EZK 10:7" />ता करुबु नी वच मे गेथु एक करुब आह़फा नो हात नाम्‌बो करीन, तीहयु आक्‌ठु मे गेथु जे करुबु नी वच मे हतु, थोड़ाक चुटीन सुती ना लुगड़ा पेरला अदमी नी मुठ मे आप देदो; अने तीहयो तीने लीन बारो जत र्‌यो।<verse eid="EZK 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 10:8" />करुबु ना पाखड़ान हेटु ते माणहुन हात ने तेवु कंय देखाव पड़तु हतु। <verse eid="EZK 10:8" /><verse number="9" style="v" sid="EZK 10:9" />ता में देख्‌यो, करुबुन्‌तां च्‌यार चाकटा से; मतलब एक-एक करुबुन्‌तां एक-एक चाकटु से, अने चाकटा फीरोजा नाम ना पपलन्‌या मोगला दगड़ान तेवा से। <verse eid="EZK 10:9" /><verse number="10" style="v" sid="EZK 10:10" />तीमनो आवो रुप से, के च्‌यारोव एक ह़रका देखाव पड़े, जेम एक चाकटु नी वच मे एक चाकटु हय। <verse eid="EZK 10:10" /><verse number="11" style="v" sid="EZK 10:11" />जत्‌यार तीहया चालता हता ता च्‌यारो-मेर तीहया वळ्‌या वगरेत चाल सकता हता। पण अगळ नु चाकटु जींखरली ह़ोड़ चालतु हतु, बचला चाकटा बी तीनी पसळ-पसळ जता हता, अने चालती टेमे तीहया वळता नी हता। <verse eid="EZK 10:11" /><verse number="12" style="v" sid="EZK 10:12" />वाहां मे, हात मे, पाखड़ा मे अने आखा डीले अने जे चाकटा करुबु ना हता, तीमनी च्‌यारो-मेर डोळात-डोळा हता।<note caller="+" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="REV 4:8">परकासीतवाक्‌य 4:8</ref></char></note> <verse eid="EZK 10:12" /><verse number="13" style="v" sid="EZK 10:13" />मारी ह़मळते आहया चाकटा ने चक्‌कर करीन केदो। मतलब फीरवा वाळा चाकटा।<note caller="+" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="EZK 1:15-21">यहेजकेल 1:15-21</ref></char></note><verse eid="EZK 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 10:14" />एक-एक ना च्‌यार-च्‌यार मोडा हता; एक मोडु ते करुब ने तेवु, बीजु माणेह ने तेवु, तीसरु नाहर ने तेवु, अने चोवथु घुवड़ चड़ुन तेवु।<note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="EZK 1:10">यहेजकेल 1:10</ref>; <ref loc="REV 4:7">परकासीतवाक्‌य 4:7</ref></char></note> <verse eid="EZK 10:14" /><verse number="15" style="v" sid="EZK 10:15" />करुब धरती पोर गेथा उपर उठ ज्‌या। आहया तीहयात जीव से; जे में कबार नंदीन्‌तां देखलो हतो। <verse eid="EZK 10:15" /><verse number="16" style="v" sid="EZK 10:16" />जत्‌यार-जत्‌यार तीहया करुब चालता हता तत्‌यार-तत्‌यार तीहया चाकटा तीमनी ह़ाते-ह़ाते चालता हता; अने जत्‌यार-जत्‌यार करुब धरती पोर गेथा उपर उडवा करीन आह़फाम ना पाखड़ा उचा करता हता तत्‌यार-तत्‌यार चाकटा तीमनीन्‌तां गेथा सेटा नी हयता हता। <verse eid="EZK 10:16" /><verse number="17" style="v" sid="EZK 10:17" />जत्‌यार तीहया उबा हयता हता ता चाकटा बी उबा हयता हता; अने जत्‌यार तीहया उपर उठता हता ता चाकटा बी तीमनी ह़ाते उपर उठता हता; काहाके तीहया जीव नी आत्‌मा तीहया चाकटा मे हती।<verse eid="EZK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 10:18" />यहोवा भगवान नु वीजाळु घोर ना ओट्‌ला पोर गेथु करुबु नी उपर जाय्‌न उबु री ज्‌यु। <verse eid="EZK 10:18" /><verse number="19" style="v" sid="EZK 10:19" />ता करुब आह़फाम ना पाखड़ा चवड़ा करीन मारी देखणते धरती पोर गेथा उपर उठ्‌या अने जत र्‌या; अने चाकटा बी तीमनी ह़ाते-ह़ाते जत र्‌या, अने तीहया आखा यहोवा ना घोर नी उगवणी धेड़ ना फाटे उबा हय ज्‌या; अने ईस्‌रायल ना भगवान नु वीजाळु तीमनी पोर उबु र्‌यु। <verse eid="EZK 10:19" /><verse number="20" style="v" sid="EZK 10:20" />आहया तीहयात जीवु से जे में कबार नंदीन्‌तां ईस्‌रायल ना भगवान नी तळे देखलो हतो, अने में जाण लेदो के तीहया बी करुब से।<verse eid="EZK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 10:21" />आखा ना च्‌यारोव मोडा अने च्‌यारोव पाखड़ा तळे माणहु ना हात ने तेवा हात बी हता। <verse eid="EZK 10:21" /><verse number="22" style="v" sid="EZK 10:22" />तीमना मोडा नो रुप तेवोत हतो जे में कबार नंदी ना काठे देखलो हतो। तीमनु मोडु नी पण तीमनु डील बी तेवुत हतु। तीहया ह़ुदा आह़फा-आह़फाम नी अगळेत चालता हता।<verse eid="EZK 10:22" /></para>
  <chapter eid="EZK 10" />
  <chapter number="11" style="c" sid="EZK 11" />
  <para style="s">यरुसलेम नो वाक</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 11:1" />ता भगवान नी आत्‌मा मने उपर उचलीन यहोवा ना घोर ना उगवणी ह़ोड़ ना फाटान्‌तां जीनु मोडु उगवणी ह़ोड़ भणीन से, पुगाड़ देदो; अने तां में ह़ु देख्‌यो, के मोय भरायवा ना फाटेत पच्‌चीह अदमी से। में तीमनी वच मे अज्‌जुर ना सोरा याजन्‌याह ने अने बनायाह ना सोरा पलत्‌याह ने देख्‌यो, जे माणहु ना मुख्‌या हता।<verse eid="EZK 11:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EZK 11:2" />ता भगवान मने केदो, “ए माणेह नी अवल्‌यात, जे माणेह आहया ह़ेर मे गलत सोच अने बुरी ह़ला आपे तीहया आहयात से। <verse eid="EZK 11:2" /><verse number="3" style="v" sid="EZK 11:3" />आहया केय, ‘घोर बणाव्‌वा नी टेम ह़ाते नी हय, आहयु ह़ेर हांडलु अने आमु तीनी मे नु मांह से।’ <verse eid="EZK 11:3" /><verse number="4" style="v" sid="EZK 11:4" />करीन ए माणेह नी अवल्‌यात, आमना वीरोद मे भगवान वगे गेथी वात के, भगवान वगे गेथी वात।”<verse eid="EZK 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 11:5" />ता यहोवा नी आत्‌मा मारी पोर उतरी, अने मने केदी, “आसम के, यहोवा आसम केय: ए ईस्‌रायल ना घोराणा, तमु आसमेत केदला से; जे कंय तमारा मन मे आवे, तीने में जाणु। <verse eid="EZK 11:5" /><verse number="6" style="v" sid="EZK 11:6" />तमु ते घणा ने आहया ह़ेर मे मार नाख्‌या अने आनी ह़ड़क ने धोड़ सी भर देदा।<verse eid="EZK 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 11:7" />“करीन मालीक यहोवा आसम केय: जे माणहु तमु आनी मे मार नाखला से, तीमना धोड़ेत आहया ह़ेर ह़रका हांडला मे नु मांह से; अने तमु ने आनी मे गेथा नीकाळ देहे। <verse eid="EZK 11:7" /><verse number="8" style="v" sid="EZK 11:8" />तमु तलवार सी बीहो, अने में तमने तलवार वेरेत मारही, मालीक यहोवा आसमेत केय। <verse eid="EZK 11:8" /><verse number="9" style="v" sid="EZK 11:9" />में तमने आनी मे गेथा नीकाळीन बीजा देस वाळा ना हात मे ह़ोप देही, अने तमने डंड अपाड़ही। <verse eid="EZK 11:9" /><verse number="10" style="v" sid="EZK 11:10" />तमु तलवार सी मरीन पड़हु, में तमने ईस्‌रायल देस नी काकड़ पोर डंड आपही, ता तमु जाण लेहु के में यहोवा से। <verse eid="EZK 11:10" /><verse number="11" style="v" sid="EZK 11:11" />आहयु ह़ेर तमारी जुगु हान्‌लु नी बणे, अने नी तमु आनी मे नु मांह बणहु; में तमने ईस्‌रायल देस नी काकड़ पोर डंड आपही। <verse eid="EZK 11:11" /><verse number="12" style="v" sid="EZK 11:12" />ता तमु जाण लेहु के में यहोवा से; तमु ते मारी रीती पोर नी चाल्‌या, अने मारा नेमु ने तमु नी मान्‌या; पण आह़फाम नी च्‌यारो-मेर ना राज्‌य नी रीती पोर चालला से।”<verse eid="EZK 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 11:13" />में आहयी भाती नी भगवान वगे गेथी वात केवा बाज र्‌यो हतो के बनायाह नो सोरो पलत्‌याह मर ज्‌यो। ता में मोडा ना भरहे पड़ीन ज्‌योरेत आड़ी पड़्‌यो, अने केदो, “गरा आय पड़े मालीक यहोवा, ह़ु तु ईस्‌रायल ना बचला ने खत्‌तम कर देही?”<verse eid="EZK 11:13" /></para>
  <para style="s">गुलामी मे ना माणहु ह़ाते भगवान नो वायदो</para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 11:14" />ता यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 11:14" /><verse number="15" style="v" sid="EZK 11:15" />“ए माणेह नी अवल्‌यात,” यरुसलेम ना रेवा वाळा तारा ह़ाते वाळा भायु ने अने ईस्‌रायल ना आखा घोराणा ने बी केदला से के, तमु यहोवान्‌तां गेथा सेटा हय जावो, आहयु देस अमारात हक मे आपलु से।<verse eid="EZK 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 11:16" />“पण तु ईमने के, ‘मालीक यहोवा आसम केय: में तमने नाम्‌बे-नाम्‌बे ना राज्‌य मे वहाड़्‌यो अने देस-देस मे रीवण्‌या-तीवण्‌या कर देदलो से ईमनी मे गेथा तमने एक्‌ठा करही, अने तमने ईस्‌रायल नो जागो आपही।’<verse eid="EZK 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 11:17" />“करीन तीमने के, ‘मालीक यहोवा आसम केय: में तमने राज्‌य-राज्‌य ना माणहु नी वच मे गेथा भेळा करही, अने जे देस मे तमने रीवण्‌या-तीवण्‌या करला से, तीमनी मे गेथा तमने एकठा करही, अने तमने ईस्‌रायल नो जागो आपही।’ <verse eid="EZK 11:17" /><verse number="18" style="v" sid="EZK 11:18" />तीहया तां पुगीन तीहया देस नी आखी ह़ीगी आवे एवा मुरत्‌या अने आखा ह़ीगी आवे एवा काम बी तीहया देस मे गेथा सेटा करहे। <verse eid="EZK 11:18" /><verse number="19" style="v" sid="EZK 11:19" />में तीमनु मन एक कर देही, अने तीमनी मे नवली आत्‌मा पयदा करही, अने तीमना डील मे दगड़ा ह़रकु दील नीकाळीन तीमने माह नु दील आपही,<note caller="+" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="EZK 36:20-28">यहेजकेल 36:20-28</ref></char></note> <verse eid="EZK 11:19" /><verse number="20" style="v" sid="EZK 11:20" />जीनी सी तीहया मारी रीती पोर हमेसा चाल्‌या करे अने मारा नेमु ने मान्‌या करे; अने तीहया मारा माणहु ठेरहे, अने में तीमनो भगवान ठेरही। <verse eid="EZK 11:20" /><verse number="21" style="v" sid="EZK 11:21" />पण तीहया माणहु जे आह़फाम ना ह़ीगी आवे एवा मुरत्‌या अने ह़ीगी आवे एवा काम मे मन लगाड़ीन चालता रेहे, तीमने में आसम करही के तीमना गलत कामु नो फोळ तीमनात मुंडा पोर नाखही। मालीक यहोवा आसमेत केय।”<verse eid="EZK 11:21" /></para>
  <para style="s">भगवान नु वीजाळु यरुसलेम मे गेथु नीकळे</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 11:22" />करुब आह़फाम ना पाखड़ा उचा कर्‌या, अने चाकटा तीमनी ह़ाते-ह़ाते चाल्‌या, अने ईस्‌रायल ना भगवान नु वीजाळु तीमनी उपर हतु। <verse eid="EZK 11:22" /><verse number="23" style="v" sid="EZK 11:23" />ता यहोवा नु वीजाळु ह़ेर नी वच मे गेथु नीकळीन तीहया बड़ा पोर जाय्‌न उबु री ज्‌यु जे ह़ेर गेथो उगवणो से। <verse eid="EZK 11:23" /><verse number="24" style="v" sid="EZK 11:24" />अळतेण आत्‌मा मने उचली, अने भगवान नी आत्‌मा नी सक्‌ती सी दरसन मे कसदी देस मे गुलामी मे वाळान्‌तां पुगाड़ देदी। जे दरसन मे देखलो हतो तीहयु उलुप हय ज्‌यु। <verse eid="EZK 11:24" /><verse number="25" style="v" sid="EZK 11:25" />ता जेतरी वात यहोवा मने देखाड़लो हतो, तीहयी में गुलामी मे वाळा ने देखाड़ देदो।<verse eid="EZK 11:25" /></para>
  <chapter eid="EZK 11" />
  <chapter number="12" style="c" sid="EZK 12" />
  <para style="s">भगवान वगे गेथी वात केवा वाळा, नु गुलामी मे जवान सेलाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 12:1" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 12:1" /><verse number="2" style="v" sid="EZK 12:2" />“ए माणेह नी अवल्‌यात, तु बकबक करवा वाळा घोराणा नी वच मे रेय, जीमना देखवा नी करते डोळा ते से, पण नी देखता, अने ह़मळवा करीन कान्‌टा ते से पण नी ह़मळता; काहाके तीहया बकबक करवा वाळा घोराणा ना से।<note caller="+" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="ISA 6:9-10">यसाया 6:9-10</ref>; <ref loc="JER 5:21">यीरम्‌या 5:21</ref>; <ref loc="MRK 8:18">मरकुस 8:18</ref></char></note><verse eid="EZK 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 12:3" />“करीन ए माणेह नी अवल्‌यात, दीहु गुलामी मे जवा नु ह़मान तीयार करीन तीमनी देखणते उठ जजो, अने तीमनी देखणते तमारा जागे गेथा बीजा जागे जत रेजो। तीहया बकबक करवा वाळा घोराणा ना से, ते बी पक्‌का तीहया धीयान देय। <verse eid="EZK 12:3" /><verse number="4" style="v" sid="EZK 12:4" />करीन तु दीहु तीमनी देखणते गुलामी मे जवा वाळा नु ह़मान ने तेम तारु ह़मान नीकाळजे, अने तु ह़ांतो गुलामी मे जवा वाळान तेम तीमनी देखणते उठ जजे। <verse eid="EZK 12:4" /><verse number="5" style="v" sid="EZK 12:5" />तीमनी देखणते तारा घोर नु भीतड़ु फोड़जे तीनी मेत तारु ह़मान नीकाळजे। <verse eid="EZK 12:5" /><verse number="6" style="v" sid="EZK 12:6" />तीमनी देखणते ह़मान ने तारा खांदा पोर उचलीन अंदारलु मे नीकळजे, अने तारु मोडु ढाकीन राखजे के तने धरती नी देखाव पड़े; काहाके में तने ईस्‌रायल ना घोराणा जुगु एक सेलाणी ठेरावलो से।”<verse eid="EZK 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 12:7" />तीहया हुकम नी अनसारे मे तेमेत कर्‌यो। दीहु में मारु ह़मान गुलामी नु ह़मान ने तेम नीकाळ्‌यो, अने ह़ांतो मारा हात सी भीतड़ु ने फोड़्‌यो; अळतेण अंदारलु मे ह़मान ने नीकाळीन, तीमनी देखणते मारा खांदा पोर उचलीन जत र्‌यो।<verse eid="EZK 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 12:8" />ह़वारे यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 12:8" /><verse number="9" style="v" sid="EZK 12:9" />“ए माणेह नी अवल्‌यात,” ह़ु ईस्‌रायल नु घोराणु मतलब तीहया बकबक करवा वाळा नु घोराणु तने आहयु नी पुछ्‌यु, आहयु तु ह़ु करे? <verse eid="EZK 12:9" /><verse number="10" style="v" sid="EZK 12:10" />तु तीमने के, मालीक यहोवा आसम केय: आहयो जोर-भर्‌यो बोल यरुसलेम ना मुख्‌या अदमी अने ईस्‌रायल नु आखु घोराणु ना बारा मे से जीमना वच मे तीहया रेय। <verse eid="EZK 12:10" /><verse number="11" style="v" sid="EZK 12:11" />तु तीमने के, में तमारी जुगु सेलाणी से; जेम में करलो से, तेमेत ईस्‌रायली माणहु ह़ाते करहे; तीमने उठीन गुलामी मे जवा पड़हे। <verse eid="EZK 12:11" /><verse number="12" style="v" sid="EZK 12:12" />तीमनी वचमे जे मुख्‌यो से, तीहयो अंदारला मे आह़फा ना खांदा पोर भार उचलीन नीकळहे; तीहयो आह़फा नु ह़मान नीकाळवा करीन भीतड़ु ने फोड़हे, अने आह़फा नु मोडु ढाकीन राखहे के तीने धरती नी देखाव पड़वा जोवे। <verse eid="EZK 12:12" /><verse number="13" style="v" sid="EZK 12:13" />में तीनी पोर मारी जाळ नाखही, अने तीहयो मारी जाळ मे फसहे; अने में तीने कसदीम ना देस मे बेबीलोन ह़ेर मे पुगाड़ देही; तीहयो तीहया ह़ेर मे मरी जहे ते बी तीहयु ह़ेर ने देखी नी सके।<note caller="+" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="2KI 25:7">2 राजा 25:7</ref>; <ref loc="JER 52:11">यीरम्‌या 52:11</ref></char></note> <verse eid="EZK 12:13" /><verse number="14" style="v" sid="EZK 12:14" />जेतरा तीना मदत करन्‌या तीनी आड़े-धेड़े रेहे, तीमने अने तीमना आखा टोळा ने मे च्‌यारो-मेर रीवण्‌या-तीवण्‌या कर देही; अने तलवार हापकीन तीमनी पसळ मोकलही।<verse eid="EZK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 12:15" />“जत्‌यार में तीमने राज्‌य-राज्‌य मे रीवण्‌या-तीवण्‌या कर देही, अने देस-देस मे खोळवी देही, ता तीहया जाण लेहे के में यहोवा से। <verse eid="EZK 12:15" /><verse number="16" style="v" sid="EZK 12:16" />पण में तीमनी मे गेथा थोड़ाक माणहु ने तलवार, काळ अने गरा सी बचाड़ीन राखही; अने तीहया आह़फाम ना ह़ीगी आवे एवा काम नी तीहया राज्‌य मे वात करहे जीनी वचमे तीहया पुगहे; ता तीहया जाण लेहे के में यहोवा से।”<verse eid="EZK 12:16" /></para>
  <para style="s">कापत्‌ला भगवान वगे गेथी वात केवा वाळा नी सेलाणी</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 12:17" />ता यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 12:17" /><verse number="18" style="v" sid="EZK 12:18" />“ए माणेह नी अवल्‌यात,” “कापतो जीन तारो रोट्‌लो खाजे अने थतरतो जीन अने चीन्‌ता करतो जीन तारु पाणी पीजे; <verse eid="EZK 12:18" /><verse number="19" style="v" sid="EZK 12:19" />अने आहया देस ना माणहु ने केजे, के मालीक यहोवा यरुसलेम अने ईस्‌रायल ना देस ना रेवा वाळा ना बारा मे आसम केय: तीहया तीमनो रोट्‌लो चीन्‌ता करता जीन खाहे, अने तीमनु पाणी बीहता जीन पीहे; काहाके देस तीना आखा रेवा वाळा ना गलत कामु ना कारण ठारलु हय जहे। <verse eid="EZK 12:19" /><verse number="20" style="v" sid="EZK 12:20" />वहला ह़ेर उजड़ जहे, अने देस बी उजाड़ हय जहे, ता तमु जाण लेहु के में यहोवा से।”<verse eid="EZK 12:20" /></para>
  <para style="s">खत्‌तम हयणु ह़ाते से</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 12:21" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 12:21" /><verse number="22" style="v" sid="EZK 12:22" />“ए माणेह नी अवल्‌यात, आहयी ह़ु कहावत से जे तमु ईस्‌रायल देस मे कीया करो, ‘दाड़ा जादा हय जेला से, अने दरसन नी कानी वात पुरी नी हयी?’ <verse eid="EZK 12:22" /><verse number="23" style="v" sid="EZK 12:23" />करीन तीमने के, ‘मालीक यहोवा आसम केय: में आहयी कहावत ने बंद करही; अने आहयी कहावत ने ईस्‌रायल में अळी नी करे।’ तु तीमने के, के तीहयो दाड़ो ह़ाते आय जेलो से, अने दरसन नी आखी वात पुरी हयवा वाळी से।<verse eid="EZK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 12:24" />“काहाके ईस्‌रायल ना घोराणा मे नी ते अळी झुटा दरसन नी कानी वात अने नी कानी फसाड़वा वाळी वात अळी केय। <verse eid="EZK 12:24" /><verse number="25" style="v" sid="EZK 12:25" />काहाके में यहोवा से, जत्‌यार में बोलु, ता में जे बोल केम, तीहयो पुरो हय जहे। तीनी मे वार नी लागे, पण ए बक-बक करवा वाळा घोराणा, तमारात दाड़ा मे में बोल कीही, अने तीहयो पुरो हय जहे, मालीक यहोवा आसम केय।”<verse eid="EZK 12:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 12:26" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 12:26" /><verse number="27" style="v" sid="EZK 12:27" />“ए माणेह नी अवल्‌यात, देख, ईस्‌रायल ना घोराणा ना माणहु आहयु की र्‌या, ‘जे दरसन तीहयो देखे, तीहयु घणा दाड़ा मे पुरु हयवा वाळु से; अने तीहयो नाम्‌बे नी टेम ना बारा मे भगवान वगे गेथी वात केय।’ <verse eid="EZK 12:27" /><verse number="28" style="v" sid="EZK 12:28" />करीन तु तीमने के, मालीक यहोवा आसम केय, मारा काना बी बोल ने पुरो हयवा मे अळी टेम नी लागे, पण जे बोल में केम तीहयो पक्‌को पुरो हयहे, मालीक यहोवा आसमेत केय।”<verse eid="EZK 12:28" /></para>
  <chapter eid="EZK 12" />
  <chapter number="13" style="c" sid="EZK 13" />
  <para style="s">झुटा भगवान वगे गेथी वात केवा वाळा ना वीरोद मे भगवान वगे गेथी वात</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 13:1" />यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 13:1" /><verse number="2" style="v" sid="EZK 13:2" />“ए माणेह नी अवल्‌यात, ईस्‌रायल ना जे भगवान वगे गेथी वात केण्‌या आह़फाम नात मन सी भगवान वगे गेथी वात केय, तीमना वीरोद मे भगवान वगे गेथी वात कीन तु के, यहोवा नो बोल ह़मळो!”<verse eid="EZK 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 13:3" />मालीक यहोवा आसम केय: “गरा आय पड़े, तीहया वण-अकल्‌या भगवान वगे गेथी वात केवा वाळा पोर जे आह़फाम नीत आत्‌मा पसळ भटक जाय, अने कंय बी दरसन नी देख्‌या! <verse eid="EZK 13:3" /><verse number="4" style="v" sid="EZK 13:4" />ए ईस्‌रायल, तारी मे ना भगवान वगे गेथी वात केवा वाळा ओदरला घोरु मे ना कोल्‌यान तेवा बण र्‌या। <verse eid="EZK 13:4" /><verse number="5" style="v" sid="EZK 13:5" />तमु चीहायलु भीतड़ु पोर चड़ीन ईस्‌रायल ना घोराणा जुगु भीतड़ु नी ह़ुदार्‌या, जीनी सी तीहया यहोवा ना दाड़े झुमायवा मे टेकीन री सकता। <verse eid="EZK 13:5" /><verse number="6" style="v" sid="EZK 13:6" />तीहया माणहु जे केय, यहोवा आसम केय, तीहया दरसन नी रीकामी अने झुटी वात करला से; अने ते बी आहयी आह करावे के यहोवा आहयो बोल पुरो करहे; ते बी यहोवा तीमने नी मोकल्‌यो। <verse eid="EZK 13:6" /><verse number="7" style="v" sid="EZK 13:7" />ह़ु तमारो दरसन झुटो नी हय, अने ह़ु तमु झुटी अगी हयवा वाळी वात नी केता? तमु केवो, ‘यहोवा आसम केय’ पण में कंय बी नी केदो।”<verse eid="EZK 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 13:8" />करीन मालीक यहोवा तमु ने आसम केय: “तमु जे रीकामी वात केदा अने झुटा दरसन देखला से, करीन में तमारा वीरोद मे से, मालीक यहोवा आसमेत केय। <verse eid="EZK 13:8" /><verse number="9" style="v" sid="EZK 13:9" />जे भगवान वगे गेथी वात केवा वाळा झुटा दरसन देखे अने झुटी अगी हयवा वाळी वात केय, मारो हात तीना वीरोद मे रेहे, अने तीहया मारा माणहु नी मंडळी मे साजल्‌या नी रेय, अने नी तीमना नाम ईस्‌रायल नी नाम नी चीट्‌ठी मे लीखे, अने नी तीहया ईस्‌रायल ना देस मे भराय सके; आनी सी तमु जाण लेहु के में मालीक यहोवा से।<verse eid="EZK 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 13:10" />“झुटा भगवान वगे गेथी वात केण्‌या आहयु कीन मारा माणहु ने वहराड़े के आखु कंय सांती मे से पण आञे कोय सांती मे हयेत नी। मारा माणहु कमजोर दगड़ा नु भीतड़ु उबु कर्‌या अने भगवान वगे गेथी वात केण्‌या चुनो लगाड़ीन तीने धोळ्‌ळा चुना वेर पुताय करीन ढाक देदा।<note caller="+" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="JER 6:14">यीरम्‌या 6:14</ref>; <ref loc="JER 8:11">8:11</ref></char></note> <verse eid="EZK 13:10" /><verse number="11" style="v" sid="EZK 13:11" />तीहया पुताय करवा वाळा ने के तीहयु भीतड़ु ओदरी जहे। काहाके जण जबर पाणी पड़हे, अने मोट्‌ली आंजी तीने पाड़ देहे। <verse eid="EZK 13:11" /><verse number="12" style="v" sid="EZK 13:12" />करीन जत्‌यार भीतड़ु पड़ जहे, ता ह़ु माणहु तमने आहयु नी केय, जे तमु पुताय करला तीहयु कां ज्‌यु?”<verse eid="EZK 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 13:13" />करीन मालीक यहोवा तमने आसम केय: “में खीजवाय्‌न तीने मोट्‌ली आंजी नी लारे पाड़ही; अने मारी रीह सी घण जबर पाणी पड़हे, अने मारी सी मोट्‌ला-मोट्‌ला गारा पड़हे के भीतड़ु ने ओदार नाखे। <verse eid="EZK 13:13" /><verse number="14" style="v" sid="EZK 13:14" />आहयी रीते जे भीतड़ु पोर तमु पुताय करला से, तीने में ओदार देही, अने कादा मे भेसकी देही, अने तीनी नीव उखड़ जहे; अने जत्‌यार तीहयी पड़हे, ता तमु बी तीनी तळे डबाय्‌न मर जहु; अने तमु जाण लेहु के में यहोवा से।<verse eid="EZK 13:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 13:15" />“आहयी रीते में भीतड़ु पोर अने तीने पुताय करवा वाळा पोर मारी रीह नीकाळीन; अळतेण तमने कीही, नी ते भीतड़ु र्‌यु, अने नी तीने पुताय करवा वाळा र्‌या, <verse eid="EZK 13:15" /><verse number="16" style="v" sid="EZK 13:16" />मतलब ईस्‌रायल ना तीहया भगवान वगे गेथी वात केवा वाळा जे यरुसलेम ना बारा मे भगवान वगे गेथी वात केता हता अने यरुसलेम नी सांती नो दरसन देखता हता, पण मालीक यहोवा आसम केय, के सांती हयेत नी।”<verse eid="EZK 13:16" /></para>
  <para style="s">झुटा भगवान वगे गेथी वात केवा वाळा बयरा ना वीरोद मे भगवान वगे गेथी वात</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 13:17" />अळतेण मालीक केदो, “ए माणेह नी अवल्‌यात, तु तारा भायु ना बयरा-सोर्‌या ना वीरोद मे मोडु खोल, जे आह़फाम नात मन सी भगवान वगे गेथी वात केय; तीमना वीरोद मे भगवान वगे गेथी वात कीन के, <verse eid="EZK 13:17" /><verse number="18" style="v" sid="EZK 13:18" />मालीक यहोवा आसम केय:</para>
  <para style="p" vid="EZK 13:18">“तीहया बयरा खत्‌तम हये! जे माणहु ने फसाड़वा करीन आह़फाम ना हातु वेर जादु वाळा तावीज बणावे अने आह़फाम ना मुंडा ढाकवा करीन बीजा भाती ना पड़दा बणावे, तमु मारा माणहु ना जीव ने जाळ मे नाखीन आह़फीम नो जीव बचाड़ लेहे ह़ु? <verse eid="EZK 13:18" /><verse number="19" style="v" sid="EZK 13:19" />तमु ते मुठ-मुठ भरीन जळगम अने रोट्‌ला ना टुकड़ा नी बदले मने मारा माणहु नी नींगा मे वीटळ्‌ळो ठेरावीन, अने तमारी तीहयी झुटी वात नी लारे, जे मारा माणहु तमारा मोडे ह़मळे, जे खत्‌तम हयवा नी लायक नी हता, तीमने मार नाख्‌या; अने जे बचवा नी लायक नी हता तीहया जीव ने बचाड़ राखला से।”<verse eid="EZK 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 13:20" />करीन मालीक यहोवा तमु ने आसम केय, “देखो, में तमारा तीहया मुंडा तळे घालवा नी गादीम ना वीरोद मे से, जीमनी लारे तमु जीव नो सीकार करो, करीन जीमने तमु सीकार करीन उडाड़ो तीमने मे तमारी बाथ मे गेथा हापकीन तीमने उडाड़ देही। <verse eid="EZK 13:20" /><verse number="21" style="v" sid="EZK 13:21" />में तमारा मुंडे ना रुमाल ने फाड़ीन मारा माणहु ने तमारा हात मे गेथा छोड़ावही, अने अगा चालीन तीहया तमारा हक मे नी रेय के तमु तीमनो सीकार कर सको; ता तमु जाण लेहु के में यहोवा से।<verse eid="EZK 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 13:22" />“तमु जे झुट मेकीन धरमीम नु मन दुखी करला से, में तीने दुखी करवा नी चाह्‌यो, तमु वेरी माणहु ने हीम्‌मत आपला से, के तीहया तीमनी गलत वाटे गेथा नी फीरे अने जीवत्‌ला रेय। <verse eid="EZK 13:22" /><verse number="23" style="v" sid="EZK 13:23" />आहया कारण सी तमु अळी नी ते झुटो दरसन देखो, अने नी अगी हयवा वाळी झुटी वात केवो; काहाके में मारा माणहु ने तमारा हात मे गेथा छोड़ावही। ता तमु जाण लेहु के में यहोवा से।”<verse eid="EZK 13:23" /></para>
  <chapter eid="EZK 13" />
  <chapter number="14" style="c" sid="EZK 14" />
  <para style="s">भगवान मुर्‌ती पुजा करवा वाळा ने चेतावे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 14:1" />अळतेण ईस्‌रायल ना थोड़ाक डायला मारीन्‌तां आवीन मारी अगळ बह ज्‌या। <verse eid="EZK 14:1" /><verse number="2" style="v" sid="EZK 14:2" />ता यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 14:2" /><verse number="3" style="v" sid="EZK 14:3" />“ए माणेह नी अवल्‌यात” आहया माणहु ते आह़फाम ना मुरत्‌या आह़फाम ना मन मे वह़ाड़्‌या, अने आह़फाम नी अधरम नी ठोकर आह़फाम नी अगळ मेक र्‌या; अळतेण तीहया ह़ु मने कंय बी पुछ सकहे ह़ु?<verse eid="EZK 14:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 14:4" />“करीन तु तीमने के, मालीक यहोवा आसम केय: ईस्‌रायल ना घोराणा मे गेथा जे कोय आह़फाम ना मुरत्‌या आह़फाम ना मन मे वह़ाड़ीन, अने आह़फाम नी अधरम नी ठोकर आह़फाम नी अगळ मेकीन भगवान वगे गेथी वात केवा वाळान्‌तां आया, तीने में यहोवा, तीना घणा ढेरका मुरत्‌या नी अनसारेत जपाप आपही, <verse eid="EZK 14:4" /><verse number="5" style="v" sid="EZK 14:5" />जीनी सी ईस्‌रायल नु घोराणु, जे आह़फाम ना मुरत्‌या नी लारे मने छोड़ीन सेटु हय जेलु से, तीमने में तीमनात मन नी लारे फसाड़ही।<verse eid="EZK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 14:6" />“करीन ईस्‌रायल ना घोराणा ने के, मालीक यहोवा आसम केय: मन फीरावो अने मुरत्‌या भणी गेथा मोडा फीरवो; अने तमारा आखा गलत कामु ने छोड़ देवो।<verse eid="EZK 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 14:7" />“काहाके ईस्‌रायल ना घोराणा मे गेथा अने तीनी वच मे रेवा वाळा बीजा देस वाळा मे गेथा कोय बी काहा नी हय, जे मारी पसळ हयवा छोड़ीन आह़फाम ना मुरत्‌या ने आह़फाम ना मन मे वह़ाड़े, अने आह़फाम नी अधरम नी ठोकर ने आह़फाम नी अगळ मेके, अने ता मने आह़फाम नी कानी वात पुछवा करीन भगवान वगे गेथी वात केवा वाळान्‌तां आवे, ता तीने में यहोवा खुद जपाप आपही। <verse eid="EZK 14:7" /><verse number="8" style="v" sid="EZK 14:8" />में तीहया माणेह ना वीरोद मे हय्‌न तीने घबराड़ही, अने तीने सेलाणी ठेरावही; अने तीनी कहावत अगी फेलावही अने तीने मारा माणहु मे गेथो खत्‌तम करही; ता तमु जाण लेहु के मे यहोवा से।<verse eid="EZK 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 14:9" />“कदीम कानो भगवान वगे गेथी वात केवा वाळो धोको खाय्‌न कोय बोल केदो हय, ता जाणजो के में यहोवा तीहया बोल ने धोको देदलो से; अने में मारो हात तीना वीरोद मे नाम्‌बो करीन तीने मारा माणहु ईस्‌रायल मे गेथो खत्‌तम करही। <verse eid="EZK 14:9" /><verse number="10" style="v" sid="EZK 14:10" />तीहया आखा माणहु आह़फा-आह़फाम ना अधरम नो बोज उठावहे, मतलब जेम भगवान वगे गेथी वात केवा वाळा पांह पुसवा वाळो नो अधरम ठेरहे, तेमेत भगवान वगे गेथी वात केवा वाळा नो बी अधरम ठेरहे। <verse eid="EZK 14:10" /><verse number="11" style="v" sid="EZK 14:11" />आनीन करते के ईस्‌रायल नु घोराणु अगु चालीन मारी पसळ चालवा नी छोड़े अने नी आह़फाम ना भाती-भाती ना गुना नी लारे अगा चालीन वीटळ्‌ळा बणे; पण तीहया मारा माणहु बणे अने में तीमनो भगवान ठेरु, मालीक यहोवा आसमेत केय।”<verse eid="EZK 14:11" /></para>
  <para style="s">नुहो, दानीयल, अने अय्‌युब</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 14:12" />ता यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 14:12" /><verse number="13" style="v" sid="EZK 14:13" />“ए माणेह नी अवल्‌यात, जत्‌यार काना देस ना माणहु मने धोको दीन पापी हय जाय, ता में मारो हात तीना वीरोद मे नाम्‌बो करीन तीनु खाणु-पीणु ने बंद करु, अने तीनी मे काळ पाड़ीन तीनी मे गेथा माणहु अने जानवरु बेम ने खत्‌तम करु, <verse eid="EZK 14:13" /><verse number="14" style="v" sid="EZK 14:14" />ता भले तीनी मे नुह, दानीयल, अने अय्‌युब आहया तीनोव अदमी हय, ते बी तीहया आह़फाम ना धरम नी लारे तीमना जीव ने एतरात बचाड़ सकहे; मालीक यहोवा आसमेत केय।<verse eid="EZK 14:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 14:15" />“कदीम में काना देस मे जंगली जानवरु ने मोकलु जे तीने ह़ुनह़ान करीन उजाड़ नाखे, अने जानवरु ना कारण सी तीनी मे हय्‌न कोय नी जाय, <verse eid="EZK 14:15" /><verse number="16" style="v" sid="EZK 14:16" />ता भले तीनी मे तीहया तीन अदमी हय, ते बी मालीक यहोवा आसमेत केय, मारा जीवाय नी ह़ाम, नी तीहया सोरा अने नी सोर्‌या ने बचाड़ सके, तीहया एतरात एखला बचहे; पण देस उजाड़ हय जहे।<verse eid="EZK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 14:17" />“कदीम में तीहया देस पोर तीना वेरीम नी लारे तलवार वेर हमलो करावीन केम, ‘आहया देस मे तलवार वेर मारो’ अने आहयी रीते मे तीनी मे गेथा माणहु अने जानवरु खत्‌तम करु, <verse eid="EZK 14:17" /><verse number="18" style="v" sid="EZK 14:18" />ता भले तीनी मे तीहया तीन अदमी बी हय, ते बी मालीक यहोवा आसमेत केय, मारी जीवाय नी ह़ाम, नी ते तीहया सोरा ने बचाड़ सके अने नी सोर्‌या ने बचाड़ सके, तीहया एखलात बचहे।<verse eid="EZK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 14:19" />“कदीम में तीहया देस मे गरा फेलावु अने तीनी पोर मारी रीह नीकाळीन तीनु लोय आसम वयाड़ु के तां ना माणहु अने जानवरु बेम खत्‌तम हये, <verse eid="EZK 14:19" /><verse number="20" style="v" sid="EZK 14:20" />ता भले नुहो, दानीयल अने अय्‌युब बी तीनी मे हय, ते बी, यहोवा आसमेत केय, मारी जीवाय नी ह़ाम, तीहया नी ते सोरा ने अने नी सोर्‌या ने बचाड़ सके, आह़फाम ना धरम नी लारे तीहया तीमना एतरात जीव ने बचाड़ सकहे।<verse eid="EZK 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 14:21" />“काहाके मालीक यहोवा आसम केय: में यरुसलेम पोर मारा च्‌यारोव डंड पुगाड़ही, मतलब तलवार, काळ, जंगली जानवर अने गरा, जीमनी सी माणहु अने जानवर आखा तीनी मे गेथा खत्‌तम हये।<note caller="+" style="x"><char style="xo" closed="false">14:21 </char><char style="xt" closed="false"><ref loc="REV 6:8">परकासीतवाक्‌य 6:8</ref></char></note> <verse eid="EZK 14:21" /><verse number="22" style="v" sid="EZK 14:22" />ते बी तीनी मे थोड़ाक सोरा-सोरी बचहे जे तां गेथा नीकाळीन तमारीन्‌तां पुगाड़हे, अने तमु तीमनी चाल-चलण अने कामु ने देखीन तीहयी गरा ना बारा मे जे में यरुसलेम पोर नाखही, मतलब जेतरी गरा मे तीनी पोर नाखही, तीहयी आखी ना बारा मे सांती हात करहु। <verse eid="EZK 14:22" /><verse number="23" style="v" sid="EZK 14:23" />जत्‌यार तमु तीमनी चाल-चलण अने काम देखो, ता तीहया तमारी सांती नो कारण बणहे, अने तमु जाण लेहु के में यरुसलेम मे जे कंय कर्‌यो, उदड़ेत नी कर्‌यो तीनो कारण हतो, मालीक यहोवा आसमेत केय।”<verse eid="EZK 14:23" /></para>
  <chapter eid="EZK 14" />
  <chapter number="15" style="c" sid="EZK 15" />
  <para style="s">अंगुर ना वेला नो दाखलो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 15:1" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 15:1" /><verse number="2" style="v" sid="EZK 15:2" />“ए माणेह नी अवल्‌यात,” आखा झाड़ु मे अंगुर ना वेला नी ह़ु कीमत से? अंगुर नी डाळ जे जंगल नी वच मे उगे, तीनी मे ह़ु गुण से? <verse eid="EZK 15:2" /><verse number="3" style="v" sid="EZK 15:3" />ह़ु कंय चीज बणाव्‌वा करीन तीनी मे गेथु लाकड़ु लेय, नीता ठाहरु टांगवा करीन तीनी मे गेथी खुटी बण सके? <verse eid="EZK 15:3" /><verse number="4" style="v" sid="EZK 15:4" />तीने ते बळतण बणावीन आक्‌ठु मे धपाड़े; तीना बेम मुंडा आक्‌ठु मे धप जाय, अने तीनी वच मे नो हीस्‌सो रोखड़ो बण जाय, ह़ु तीहयो कंय बी काम नो से? <verse eid="EZK 15:4" /><verse number="5" style="v" sid="EZK 15:5" />देख, जत्‌यार तीहयो बणलो हतो, ते बी तीहयो कंय काम नो नी हतो, अळतेण जत्‌यार तीहयो धपीन रोखड़ो बण ज्‌यो, ता ह़ु काम नो हय सके?<verse eid="EZK 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 15:6" />करीन मालीक यहोवा आसम केय, “जेम जंगल ना झाड़ु मे गेथो में अंगुर ना वेला ने आक्‌ठु नी बळतण बणाय देम, तेमेत में यरुसलेम ना रेवा वाळा ने खत्‌तम कर देही। <verse eid="EZK 15:6" /><verse number="7" style="v" sid="EZK 15:7" />में तीमना वीरोद मे हयही, तीहया एक आक्‌ठु मे गेथा नीकळीन अळतेण बीजु आक्‌ठु नी बळतण बण जहे; जत्‌यार में तीमनी सी मारु मोडु फीरवी लेही, ता तु जाण लेहु के मे यहोवा से। <verse eid="EZK 15:7" /><verse number="8" style="v" sid="EZK 15:8" />में तीमनु देस उजाड़ देही, काहाके तीहया मारो भरहो तोड़ला से, मालीक यहोवा आसमेत केय।”<verse eid="EZK 15:8" /></para>
  <chapter eid="EZK 15" />
  <chapter number="16" style="c" sid="EZK 16" />
  <para style="s">छीनाळ्‌यु यरुसलेम</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 16:1" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां आहयो बोल पुग्‌यो, <verse eid="EZK 16:1" /><verse number="2" style="v" sid="EZK 16:2" />“ए माणेह नी अवल्‌यात,” यरुसलेम ने तीना आखा ह़ीगी आवे एवा काम देखाड़ दे, <verse eid="EZK 16:2" /><verse number="3" style="v" sid="EZK 16:3" />अने तीने के, ए यरुसलेम, मालीक यहोवा तने आसम केय:</para>
  <para style="p" vid="EZK 16:3">तु कनानी ना देस मे उबज्‌यु अने पयदा हयलु से; तारो बाह एमोरी घोराणा नो अने तारी आय्‌ह हीत्‌ती घोराणा नी हती। <verse eid="EZK 16:3" /><verse number="4" style="v" sid="EZK 16:4" />तु आसम पयदा हयु के जे दाड़े तु पयदा हयु, तीहया दाड़े नी ते तारु नाळु तोड़्‌या, अने नी तने चोखो हयवा करीन धोया, नी ते तने खारलु मीठु वेर चोळ्‌या, अने नी तने लुगड़ा मे गुचळ्‌या। <verse eid="EZK 16:4" /><verse number="5" style="v" sid="EZK 16:5" />कोयनी बी दया नी नींगा तारी पोर नी हयी के आहया कामु मे गेथु एक बी काम तारी जुगु करे; पण तु पयदा हयु तीहया दाड़े ह़ीगी आवे एवु हयवा ना कारण सी तने खळा मे नाख देदा।<verse eid="EZK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 16:6" />“जत्‌यार मे तारीन्‌तां माय्‌न नीकळ्‌यो, अने तने लोय मे लत-पत देख्‌यो, ता मे तने केदो, ‘ए लोय मे ढबळवा वाळु जीवत्‌लु रे’ होव, तनेत मे केदलो से, ‘ए लोय मे ढबळवा वाळु, जीवत्‌लु रे।’ <verse eid="EZK 16:6" /><verse number="7" style="v" sid="EZK 16:7" />अळतेण में तने खेतर ना झाड़कान तेम बड़ायो, अने तु बड़तु-बड़तु घणु घटाळु हय ज्‌यु; अने तारी छाती मोटी हय जी, अने तारा नीम्‌बाळा मोटा हय ज्‌या, ते बी तु लुगड़ा वगर हतु।<verse eid="EZK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 16:8" />“में अळी तारीन्‌तां माय्‌न ज्‌यो अने देख्‌यो, अने हाव तु पुरु बयर बण जेलु हतु; करीन में तने मारु लुगड़ु आपीन तारु डील ढाक नाख्‌यो; अने ह़ाम खाय्‌न तारी ह़ाते वायदो कर्‌यो,” अने तु मारु हय ज्‌यु, मालीक यहोवा आसमेत केय।<verse eid="EZK 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 16:9" />“ता में तने पाणी वेरु उंगवाळीन तारी पोर गेथु लोय धोय देदो, अने तारा डील पोर तेल चोपड़्‌यो। <verse eid="EZK 16:9" /><verse number="10" style="v" sid="EZK 16:10" />में तने हात वेर बणावला घटाळा करला लुगड़ा अने सुईसो नाम नी माछली ना चामड़ा ना खाहड़ा पेरायो; अने में तारी केड़ मे ह़ोण नी साल बांद्‌यो, अने रेसम नु लुगड़ु ओडाड़्‌यो। <verse eid="EZK 16:10" /><verse number="11" style="v" sid="EZK 16:11" />ता में तने ह़जाड़्‌यो, अने तारा हातु मे कामळ्‌या अने तारा गळा मे ह़ाकळ पेरायो। <verse eid="EZK 16:11" /><verse number="12" style="v" sid="EZK 16:12" />अळतेण में तारा नखरा मे नथनी अने तारा कान्‌टा मे टोकर्‌या पेरायो, अने तारा मुंडा पोर घटाळ्‌ळु मुकुट मेक्‌यो। <verse eid="EZK 16:12" /><verse number="13" style="v" sid="EZK 16:13" />तारु वजन ह़ोनु-चांदी नु अने तारा लुगड़ा वारलु सुती, रेसम अने हात वेर बणावला घटाळा करला कापड़ा ना हता; अळतेण तारु खाणु मेदो, मोद अने तेल बण्‌यु; अने तु घणी घटाळी, अने राणी बणवा नी लायक हय जी। <verse eid="EZK 16:13" /><verse number="14" style="v" sid="EZK 16:14" />तारी घटाळी हयवा नी वात आखा राज्‌य मे फेल जी, काहाके तीहयी ह़ोबा ना कारण सी, जे मे तने मारी भणी गेथी आपलो हतो,” तु घणु घटाळु हतु, मालीक यहोवा आसमेत केय।<verse eid="EZK 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 16:15" />“पण तु तारु घटाळ्‌ळु से तीनी पोर भरहो करीन तु नामह़ाद्‌यु हयवा ना कारण सी छीनाळु करवा बाज ज्‌यु, अने आखा आव्‌वा-जवा वाळा ह़ाते गलत काम कर्‌यु, अने जीने तु गमतु हतु तीनीत ह़ाते तु मेळतु हतु। <verse eid="EZK 16:15" /><verse number="16" style="v" sid="EZK 16:16" />तु तारा लुगड़ा लीन भाती-भाती ना रंगाळा उचा जागा बणाय लेदु, अने तीनी पोर छीनाळु कर्‌यु, एवा गलत काम कर्‌यु जे नी हया अने अळी नी हये। <verse eid="EZK 16:16" /><verse number="17" style="v" sid="EZK 16:17" />तु तारु घटाळ्‌ळु वजन लीन जे मारु आपलु ह़ोनु-चांदी नु हतु, तीनी वेर माणहु ना मुरत्‌या बणाय लेदु, अने तीनी वेर बी छीनाळु करवा बाज ज्‌यु, <verse eid="EZK 16:17" /><verse number="18" style="v" sid="EZK 16:18" />अने आह़फु ना हात वेर बणावला घटाळा करला लुगड़ा लीन तीहया मुरत्‌या ने पेरायु, अने मारु तेल अने मारी धुप-अगरबत्‌ती तीमनी अगळ चड़ायु। <verse eid="EZK 16:18" /><verse number="19" style="v" sid="EZK 16:19" />जे खाणु में तने आपलो हतो, मतलब जे मेदो, तेल अने मोद में तने खवाड़तो हतो, तीहयु आखु तीमनी अगळ वारु गंदायण्‌यान बादा करीन मेक्‌यु; मालीक यहोवा आहयुत केय के आसमेत हयु।<verse eid="EZK 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 16:20" />“अळतेण तु तारा सोरा-सोरी ने लीन जीमने तु मारी जुगु पयदा करलु हतु, तीमने तीहया मुरत्‌या ने बादा करीन चड़ाय नाख्‌यु। ह़ु तारु छीनाळु एवी नान्‌ली वात हती; <verse eid="EZK 16:20" /><verse number="21" style="v" sid="EZK 16:21" />के तु मारा सोरा ने तीहया मुरत्‌या नी अगळ आक्‌ठु मे चड़ावीन मारलु से? <verse eid="EZK 16:21" /><verse number="22" style="v" sid="EZK 16:22" />तु तारा आखा ह़ीगी आवे एवा कामु मे अने छीनाळु करतु जाय्‌न, तारा नान्‌लु हतु तीहया दाड़ा नी फोम नी कर्‌यु, तु नांगरलु तारा लोय मे गबड़तु हतु।”<verse eid="EZK 16:22" /></para>
  <para style="s">यरुसलेम नी जीवाय एक छीनाळ्‌याण ने तेवु</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 16:23" />तारी तीहयी आखी बुराय पसळ ह़ु हयु? मालीक यहोवा आसमेत केय, “गरा आय पड़े, तारी पोर गरा आय पड़े! <verse eid="EZK 16:23" /><verse number="24" style="v" sid="EZK 16:24" />तु एक उचीत बड़ी बणाय लेदु, अने एक-एक चोवराया पोर एक उचो जागो बणाय लेदु; <verse eid="EZK 16:24" /><verse number="25" style="v" sid="EZK 16:25" />अने एक-एक ह़ड़क नी धेड़े बी तु तारो उचो जागो बणावीन तु घटाळ्‌ळु से तीनी पोर ह़ीगी आवे एवो डाग लगाड़ लेदु, अने एक-एक आव्‌वा-जवा वाळा ने गलत काम करवा करीन बोलावीन मोट्‌ली छीनाळ्‌याण बण ज्‌यु। <verse eid="EZK 16:25" /><verse number="26" style="v" sid="EZK 16:26" />तु तारा धेड़े वाळा मीस्‌री माणहु ह़ाते बी, जे मोटा-माता से, छीनाळु कर्‌यु अने मने रीह लगाड़वा करीन तु अळी छीनाळु करतु ज्‌यु।<verse eid="EZK 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 16:27" />“आहया कारण सी में तारो हात तारा वीरोद मे बड़ावीन, तारु दाड़ीक नु खाणु कम कर देदो, अने तारा वेरी पलीस्‌ती बयरा जे तारा मोटा पाप नी चाल सी लजवाय, तीमना हात मे तने ह़ोप देदलो से।<verse eid="EZK 16:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 16:28" />“ते बी तारु मन नी भरायु, करीन तु अस्‌सुरी माणहु ह़ाते बी छीनाळु कर्‌यु; अने तीमनी ह़ाते छीनाळु करवा सी बी तारु मन नी भरायु। <verse eid="EZK 16:28" /><verse number="29" style="v" sid="EZK 16:29" />अळतेण तु लेन-देन करवा वाळु देस मे छीनाळु करते-करते कसदी माणहु देस तक पुग्‌यु, अने तां बी तारु मन नी भरायु।”<verse eid="EZK 16:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 16:30" />मालीक यहोवा आसम केय, “के तारु मन केवु लालच्‌यु से के तु आहया आखा काम करे, जे वण-लाज्‌याण रंडी नात काम से! <verse eid="EZK 16:30" /><verse number="31" style="v" sid="EZK 16:31" />तु एक-एक ह़ड़क नी धेड़े जे तारु गुम्‌मट, अने एक-एक चोवराया पोर तारो उचो जागो बणावलु से, ह़ु आनी मेत तु रंडीन तेम नी र्‌यु? काहाके तु आवी कमाय पोर हाहे। <verse eid="EZK 16:31" /><verse number="32" style="v" sid="EZK 16:32" />तु छीनाळ्‌याण लाडी से, तु बीजा अदमी ने तारा अदमी नी बदले आवरी लेय। <verse eid="EZK 16:32" /><verse number="33" style="v" sid="EZK 16:33" />आखी रंडीम ने ते पय्‌हा जड़े, पण तु तारा आखा दोस्‌तीदार्‌या ने खुद पय्‌हा आपीन, अने तीमने लालच करावीन बोलावलु से के तीहया च्‌यारो-मेर गेथा आवीन तारी ह़ाते छीनाळु करे। <verse eid="EZK 16:33" /><verse number="34" style="v" sid="EZK 16:34" />आहयी रीते तारु छीनाळु बीजा छीनाळ्‌या गेथु उल्‌टु से। तारी पसळ कोय छीनाळ्‌यु नी चाले, अने तु कोय पांह गेथु कीमत लेय नी, पण तुत आपे, आहयात कारण सी तु उल्‌टु ठेरलु से।”<verse eid="EZK 16:34" /></para>
  <para style="s">यरुसलेम ने भगवान डंड आपे</para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 16:35" />करीन ए छीनाळ्‌यु, यहोवा नो आहयो बोल ह़मळ<verse eid="EZK 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 16:36" />मालीक यहोवा आसम केय: “तु जे छीनाळु मे घण-जबर वण-लाज्‌यु हय्‌न, तारु डील तारा दोस्‌तीदार्‌या ने देखाड़लु से, अने तारा मुरत्‌या सी ह़ीगी आवे एवु काम कर्‌या, अने तमारा सोरा नु लोय वयाड़ीन तीमने बादा चड़ावला से। <verse eid="EZK 16:36" /><verse number="37" style="v" sid="EZK 16:37" />करीन देख, में तारा आखा दोस्‌तीदार्‌या ने जे तारी ह़ाते मोंग करन्‌या से, अने जेतरा ह़ाते तु मोंग कर्‌यु, अने जेतरा ह़ाते तु दुस्‌मनी कर्‌यु, तीहया आखा ने च्‌यारो-मेर गेथा तारा वीरोद मे एक्‌ठा करीन तीमने तारु डील नांगरलु करीन देखाड़ही, अने तीहया तारु डील देखहे। <verse eid="EZK 16:37" /><verse number="38" style="v" sid="EZK 16:38" />ता में तने एवो डंड आपही, जेम छीनाळ्‌याण अने मारवा वाळा बयरा ने आपे; अने रीह अने खीज भेळ तारु लोय वयाड़ही। <verse eid="EZK 16:38" /><verse number="39" style="v" sid="EZK 16:39" />आहयी रीते में तने तीमना हक मे कर देही; अने तीहया तारा गुम्‌मट ने ओदार देहे, अने तारा उचा जागा ने तोड़-फोड़ देहे, तीहया तारा लुगड़ा जबरजस्‌ती नीकाळहे, अने तारु घटाळ्‌ळु वजन हापक लेहे, अने तने लुगड़ा वगर नु करीन रेवा देहे।<verse eid="EZK 16:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EZK 16:40" />“ता तारा वीरोद मे एक टोळो एक्‌ठो करीन तीहया तने दगड़ाटहे, तलवार वेर टुकड़ा-टुकड़ा करहे। <verse eid="EZK 16:40" /><verse number="41" style="v" sid="EZK 16:41" />ता तीहया आक्‌ठु धपाड़ीन तारा घोरु ने धपाड़ देहे, अने तने घणा ढेरका बयरा नी देखणते डंड आपहे; अने में तारु छीनाळु बंद करही, अळतेण अळी तु बीजा अदमीम ने छीनाळा जुगु कीमत नी आपे। <verse eid="EZK 16:41" /><verse number="42" style="v" sid="EZK 16:42" />जत्‌यार में तारी पोर मारी पुरी रीह नीकाळ लेही, तारी पोर अळी नी रीह करु अने होगो री जही, अने अळतेण नी खीजवाम। <verse eid="EZK 16:42" /><verse number="43" style="v" sid="EZK 16:43" />तु जे तारा नान्‌लु हतु तीहया दाड़ा ने फोम नी राख्‌यु, अने आहयी आखी वात नी लारे मने रीह लगाड़्‌यु, करीन में तारी चाल-चलण नो फोळ तारा मुंडा पोर नाखही अने तु तारा आखा पाछला ह़ीगी आवे एवा काम गेथु घणा-जादा पाप नी करे,” मालीक यहोवा आसमेत केय।<verse eid="EZK 16:43" /></para>
  <para style="s">जेवी आय्‌ह तेवी सोरी</para>
  <para style="p">
    <verse number="44" style="v" sid="EZK 16:44" />देख, आखा कहावत केवा वाळा तारा बारा मे आहयी कहावत केहे, “जेवी आय्‌ह तेवी सोरी। <verse eid="EZK 16:44" /><verse number="45" style="v" sid="EZK 16:45" />तारी आय्‌ह जे आह़फा ना घोरवाळा अने सोरा सी ह़ीगी करती हती, तु बी तीनीत सोरी ठेर्‌यु; अने तारा बेनेह्‌या जे आह़फा-आह़फाम ना घोरवाळा अने सोरा सी ह़ीगी करता हता, तु बी तीमनीत बेनेह नीकळ्‌यु। तारी आय्‌ह हीत्‌तीम घोराणा नी अने तारो बाह एमोरी घोराणा नो हतो।<verse eid="EZK 16:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="EZK 16:46" />“तारी धुराव भणीन नी काकड़ पोर आह़फी ना सोर्‌या ह़ाते रेवा वाळी तारी बेनेह सामरी ह़ेर तारी मोट्‌ली बेनेह से, अने जे तारी दखणाव नी काकड़ पोर आह़फा ना सोर्‌या ह़ाते रेय, तीहयी सदोम ह़ेर से। तीहयी तारी नान्‌ली बेनेह से। <verse eid="EZK 16:46" /><verse number="47" style="v" sid="EZK 16:47" />तु तीमनीन तेवी चाल नी चाल्‌यु, अने नी तीमना काम ने तेवा ह़ीगी आवे एवा काम सी मन भरायु; आहयी ते घणी नानी वेत ठेरती, पण तारी चाल-चलण तीमनी गेथी बी जादा बगड़ जी।<verse eid="EZK 16:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="EZK 16:48" />“मालीक यहोवा आसम केय, मारी जीवाय नी ह़ाम,” तारी बेनेह सदोम तीना सोर्‌या भेळ, तारीन तेवा अने तारा सोर्‌यान तेवा काम नी कर्‌यु। <verse eid="EZK 16:48" /><verse number="49" style="v" sid="EZK 16:49" />देख, तारी बेनेह सदोम नो अधरम आहयो हतो, के तीहयी तीना सोर्‌या भेळ घमंड करतु हतु, पेट भरी-भरीन खातु अने मोज-मस्‌ती सी रेतु हतु; अने कमजोर अने गरीब ने नी ह़माळतु हतु। <verse eid="EZK 16:49" /><verse number="50" style="v" sid="EZK 16:50" />तीहयु घमंड करीन मारी अगळ गलत काम करवा वाज ज्‌यु, अने आहयु देखीन में तीमने मारी अगळ गेथो सेटो कर देदो।<verse eid="EZK 16:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="EZK 16:51" />अळतेण सामरी तारा पापु सी आदा पाप बी नी कर्‌यु, तु ते तीनी सी घणा जादा ह़ीगी आवे एवा काम कर्‌यु, अने तारा घणा जादा ह़ीगी आवे एवा कामु नी लारे तारी बेनेह तारी बराबरी मे वण-गुनाळ्‌ळी ठेरी। <verse eid="EZK 16:51" /><verse number="52" style="v" sid="EZK 16:52" />करीन तु जे तारा बेनेह्‌या नो नीयाव कर्‌यु, आहया कारण सी लाज पड़, काहाके तु तीमनी सी जादा ह़ीगी आवे एवा पाप करलु से; करीन तीहया तारी सी कम गुनाळ्‌ळा ठेरला से। करीन तु आहयी वात सी लजवा अने लजवायतु रे, काहाके तु तारा बेनेह्‌या ने कम गुनाळ्‌ळु ठेरावलु से।<verse eid="EZK 16:52" /></para>
  <para style="s">सदोम अने सामरी ने पासु बणावे</para>
  <para style="p">
    <verse number="53" style="v" sid="EZK 16:53" />“जत्‌यार में तीमने मतलब सोर्‌या भेळ सदोम अने सामरी ने गुलामी मे गेथा पासो ली आवही, ता तीमनी वच मेत तारा धरायला ने बी पासा ली आवही, <verse eid="EZK 16:53" /><verse number="54" style="v" sid="EZK 16:54" />जीनी सी तु लजवायतु रेही, अने तारा आखा कामु ने देखीन लजवाय, काहाके तुत तीमनी सांती नो कारण से। <verse eid="EZK 16:54" /><verse number="55" style="v" sid="EZK 16:55" />तारा बेनेह्‌या सदोम अने सामरी आह़फी-आह़फी नी सोर्‌याम नी भेळ तीमनी पेल्‌नी हालत मे अळी पुग जहे, अने तु बी तारा सोर्‌या भेळ तारी पेल्‌नी हालत मे पुग जही। <verse eid="EZK 16:55" /><verse number="56" style="v" sid="EZK 16:56" />जत्‌यार तक तारी बुराय ह़ामने नी आयी, मतलब जे टेमे तक तु आड़े-धेड़े ना माणहु भेळ अरामी अने पलीस्‌ती बयरा नो जे हाव तने च्‌यारो-मेर गेथा हेटा ह़मजे, अने वाक काडतु हतु, <verse eid="EZK 16:56" /><verse number="57" style="v" sid="EZK 16:57" />तीहया तारा घमंड ना दाड़ा मे ते तु तारी आह़फी नी बेनेह सदोम ह़ेर नु नाम बी नी लेती हती। <verse eid="EZK 16:57" /><verse number="58" style="v" sid="EZK 16:58" />पण हाव तने आह़फु ना मोटा पाप अने ह़ीगी आवे एवा कामु नो भार खुदेत उचलवा पड़ र्‌यो, यहोवा आसमेत केय।<verse eid="EZK 16:58" /></para>
  <para style="s">एक वायदो जे आखरी तक ठेरहे</para>
  <para style="p">
    <verse number="59" style="v" sid="EZK 16:59" />“मालीक यहोवा आसम केय, में तारी ह़ाते एवोत वेहवार करही, जेवो तु करलु से, काहाके तु वायदा ने तोड़ीन ह़ाम ने हेटी ह़मजलु से, <verse eid="EZK 16:59" /><verse number="60" style="v" sid="EZK 16:60" />ते बी में तु नान्‌लो हतो तीहया दाड़ा ना मारा वायदा ने फोम करही, अने तारी ह़ाते जलम नो वायदो करही। <verse eid="EZK 16:60" /><verse number="61" style="v" sid="EZK 16:61" />जत्‌यार तु तारा बेनेह्‌या ने मतलब मोट्‌ली अने नान्‌ली बेनेह ने आवरी लेही, ता तु तारी चाल-चलण ने फोम करीन लाजे पड़ही; अने में तीमने तारा सोर्‌या ठेराय देही; पण आहयु तारा वायदा नी अनसारे नी करु। <verse eid="EZK 16:61" /><verse number="62" style="v" sid="EZK 16:62" />में तारी ह़ाते मारो वायदो करही, ता तु जाण लेही के में यहोवा से, <verse eid="EZK 16:62" /><verse number="63" style="v" sid="EZK 16:63" />जीनी सी तु फोम करीन लाजे पड़े, अने लाज ना कारण सी अळी कारु बी मोडु नी खोले। आहयु तीहयी टेमे हयहे, जत्‌यार में तारा आखा काम ने ढाकही, मालीक यहोवा आसमेत केय।”<verse eid="EZK 16:63" /></para>
  <chapter eid="EZK 16" />
  <chapter number="17" style="c" sid="EZK 17" />
  <para style="s">घुवड़ु नो अने अंगुर ना वेला नो दाखलो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 17:1" />यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 17:1" /><verse number="2" style="v" sid="EZK 17:2" />“ए माणेह नी अवल्‌यात, ईस्‌रायल ना घोराणा ने आहयो वारतो अने दाखलो के: मालीक यहोवा आसम केय, <verse eid="EZK 17:2" /><verse number="3" style="v" sid="EZK 17:3" />एक नाम्‌बला पाखड़ा वाळी, पीखड़ा सी भरली अने रंगाळी मोट्‌ली घुवड़ लबानोन देस जाय्‌न एक देवदार नाम ना झाड़ नी सींडी तोड़ लेदी। <verse eid="EZK 17:3" /><verse number="4" style="v" sid="EZK 17:4" />ता तीहयी तीहया सींडी नी आखा गेथी उपर नी डाळ ने तोड़ लेदी, अने तीने लेन-देण करवा वाळा ना देस मे ली जाय्‌न वेपारीम ना एक ह़ेर मे रोप देदी। <verse eid="EZK 17:4" /><verse number="5" style="v" sid="EZK 17:5" />ता तीहयी देस नु एक बीज लीन वारला खेतर मे चोपी, अने तीने घणु पाणी भरला जागा मे मजनु नाम ना झाड़ ने तेम चोपी। <verse eid="EZK 17:5" /><verse number="6" style="v" sid="EZK 17:6" />तीहयु बीज उगीन नान्‌ला फेलवा वाळो अंगुर नो वेलो बण ज्‌यो जीना डाळ्‌या घुवड़ भणीन वळ्‌या, अने तीना मुळ्‌या तीनी तळेत फेल्‌या, आहयी रीते तीहयो अंगुर नो वेलो बण ज्‌यो अने डाळ्‌या अने पान्‌टा सी भरायवा बाज ज्‌यो।<verse eid="EZK 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 17:7" />“एक अळी नाम्‌बा पाखड़ा वाळी अने पीखड़ा सी भरली एक मोट्‌ली घुवड़ हती; अने तीहयो अंगुर नो वेलो जां तीने चोपलो हतो तीहया जागे गेथो तीहयी बीजी घुवड़ भणीन तीना मुळ्‌या फेलाव्‌वा बाज ज्‌यो अने तीना डाळ्‌या बी तीनी भणीन वाळवा बाज ज्‌यो, के तीहयी घुवड़ तीने पाणी आप्‌या करे। <verse eid="EZK 17:7" /><verse number="8" style="v" sid="EZK 17:8" />पण तीने ते आनीन करते वारला जागा मे घणु पाणीन्‌तां चोपलो हतो, के डीरा फोड़े, अने फाले, अने वारला अंगुर नो वेलो बणे।<verse eid="EZK 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 17:9" />“करीन तु आहयु के, मालीक यहोवा आसम पुछे: ह़ु तीहयो वेलो फुलहे-फालहे? ह़ु तीहयो तीने थुड़े गेथो नी उखड़े, अने तीना फोळ ने नी झाड़ देय के तीहयो वेलो तीना आखा लील्‌ला पान्‌टा भेळ ह़ुक जाय? आने थुड़े गेथो उखड़वा करीन जादा ताखत अने ढेरका माणहु नी जरवत नी पड़े। <verse eid="EZK 17:9" /><verse number="10" style="v" sid="EZK 17:10" />भले तीहयो चोपलो बी रेय, ते बी तीहयो ह़ु फुलहे-फालहे? जत्‌यार उगवणु नु वाहळु तीने लागहे, ता ह़ु तीहयो वेलो पुरोत ह़ुकी नी जाय? तीहयो ते जां उगलो से तीहयात जागा मे ह़ुक जहे।”<verse eid="EZK 17:10" /></para>
  <para style="s">दाखला नु मतलब</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 17:11" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 17:11" /><verse number="12" style="v" sid="EZK 17:12" />“तीहया बक-बक करवा वाळा घोराणा ने के, ह़ु तमु आहयी वातु नु मतलब नी ह़मजता? अळतेण तीमने के, बेबीलोन नो राजो यरुसलेम जाय्‌न यरुसलेम ना राजा अने बीजा मुख्‌याम ने बांदीन आह़फान्‌तां बेबीलोन मे पुगाड़्‌यो। <verse eid="EZK 17:12" /><verse number="13" style="v" sid="EZK 17:13" />तीहयो राज घोराणा ना एक अदमी ने लेदो अने तीनी ह़ाते वायदो कर्‌यो, अने तीने हक मे रेवा नी ह़ाम खवाड़्‌यो, अने देस ना ताखत वाळा अदमी ने ली ज्‌यो। <verse eid="EZK 17:13" /><verse number="14" style="v" sid="EZK 17:14" />के तीहयु राज्‌य कमजोर रेय अने मुंडु उचु नी कर सके, अने वायदा ने मानवा मे बणीन रेय। <verse eid="EZK 17:14" /><verse number="15" style="v" sid="EZK 17:15" />ते बी तीहयो घोड़ा अने सेना ना माणहु मांगवा करीन तीना माणहु ने मीस्‌र मे मोकलीन तीनी ह़ाते धोको कर्‌यो। ह़ु तीहयो फुलहे-फालहे? ह़ु आवु काम ने करवा वाळो बचहे? ह़ु तीहयो आह़फा नो वायदो तोड़वा पोर बी बच जहे?<note caller="+" style="x"><char style="xo" closed="false">17:15 </char><char style="xt" closed="false"><ref loc="1KI 14:15-20">1 राजा 14:15-20</ref>; <ref loc="2CH 36:10-13">2 ईतीहास 36:10-13</ref></char></note><verse eid="EZK 17:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 17:16" />“मालीक यहोवा आसम केय, मारी जीवाय नी ह़ाम” जे राजा नी खवाड़ली ह़ाम ने तीहयो कमजोर जाण्‌यो, अने तीहयो वायदो तीहयो तोड़्‌यो, तीनीन्‌तां जीने तीहयो राजो बणावलो हतो, मतलब बेबीलोन मेत तीहयो तीनीन्‌तांत मर जहे। <verse eid="EZK 17:16" /><verse number="17" style="v" sid="EZK 17:17" />जत्‌यार तीहया घणा जीव ने खत्‌तम करवा करीन हालर बांदे, अने कीलो बणावे, ता फीरोन आह़फा नी मोट्‌ली सेना अने घणा नी मंडळी रेहे ते बी झुमायवा मे तीनी मदत नी करे। <verse eid="EZK 17:17" /><verse number="18" style="v" sid="EZK 17:18" />काहाके तीहयो ह़ाम ने हेटी ह़मज्‌यो, अने वायदा ने तोड़्‌यो; देखो, तीहयो वायदो करवा पोर बी एवा-एवा काम करलो से, करीन तीहयो बची नी सके।<verse eid="EZK 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 17:19" />मालीक यहोवा आसम केय: “मारी जीवाय नी ह़ाम, तीहयो मारी ह़ाम ने हेटी ह़मज्‌यो, अने मारो वायदो तोड़लो से; आहयो पाप में तीनात मुंडा पोर नाखही। <verse eid="EZK 17:19" /><verse number="20" style="v" sid="EZK 17:20" />में मारी जाळ तीना मुंडा पोर फेलावही अने तीहयो मारी फांद मे फसहे; अने में तीने बेबीलोन मे पुगाड़ीन तीहया भरहो तोड़्‌यो तीनो मुकदमो तीनी ह़ाते लड़ही, जे तीहयो मारी ह़ाते करलो से। <verse eid="EZK 17:20" /><verse number="21" style="v" sid="EZK 17:21" />तीना टोळा मे गेथा जेतरा बी नाहे तीहया आखा तलवार सी मरहे, अने जे री जाय तीहया च्‌यारो-मेर रीवण्‌या-तीवण्‌या हय जहे। ता तमु जाण लेहु के में यहोवात आसम केदलो से।”<verse eid="EZK 17:21" /></para>
  <para style="s">भगवान नो वायदो</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 17:22" />अळतेण मालीक यहोवा आसम केय:</para>
  <para style="q1" vid="EZK 17:22">“में बी देवदार नाम ना झाड़ नी उची सींडी मे गेथा</para>
  <para style="q2" vid="EZK 17:22">थोड़ाक लीन चोपही,</para>
  <para style="q1" vid="EZK 17:22">अने तीनी आखा गेथी उपरवाळी डाळु मे गेथी एक कुमळ्‌ळी डाळ तोड़ीन एक घणा उचा बड़ा पोर चोपही,<verse eid="EZK 17:22" /></para>
  <para style="q2">
    <verse number="23" style="v" sid="EZK 17:23" />मतलब ईस्‌रायल ना उचा बड़ा पोर चोपही;</para>
  <para style="q1" vid="EZK 17:23">ता तीहयी डाळ्‌या सोड़ीन ताखत वाळु</para>
  <para style="q2" vid="EZK 17:23">अने वारलु देवदार नाम ना झाड़ बण जहे,</para>
  <para style="q1" vid="EZK 17:23">अने तीनी तळे मतलब तीना छाहळा मे</para>
  <para style="q2" vid="EZK 17:23">भाती-भाती ना आखा चड़ा पोतरो बांदहे।<verse eid="EZK 17:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="EZK 17:24" />ता चोवगान मे वाळा आखा झाड़का जाण लेहे के</para>
  <para style="q2" vid="EZK 17:24">में यहोवात उचा झाड़ ने नीचु</para>
  <para style="q1" vid="EZK 17:24">अने नीचु झाड़ ने उचु करलो से,</para>
  <para style="q2" vid="EZK 17:24">लील्‌ला झाड़ ने ह़ुकाड़ नाख्‌यो,</para>
  <para style="q1" vid="EZK 17:24">अने ह़ुकलु झाड़ ने फुलाड़्‌यो-फलाड़्‌यो,</para>
  <para style="m" vid="EZK 17:24">में यहोवात आहयु केदो अने तेमेत करी बी देदलो से।”<verse eid="EZK 17:24" /></para>
  <chapter eid="EZK 17" />
  <chapter number="18" style="c" sid="EZK 18" />
  <para style="s">खुद नी जीम्‌मेदारी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 18:1" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 18:1" /><verse number="2" style="v" sid="EZK 18:2" />“तमु जे ईस्‌रायल देस ना बारा मे आहयी कहावत केवो?”</para>
  <para style="q1" vid="EZK 18:2">खाट्‌ला अंगुर ते खादा आड़ा-बुड़ा,</para>
  <para style="q1" vid="EZK 18:2">पण दात खटाया सोरा ना। आनु ह़ु मतलब से?<note caller="+" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="JER 31:29">यीरम्‌या 31:29</ref></char></note><verse eid="EZK 18:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 18:3" />“मालीक यहोवा आसम केय के मारी जीवाय नी ह़ाम,” तमु ने ईस्‌रायल मे अळी आहयी कहावत केवा नो मोखो नी जड़े। <verse eid="EZK 18:3" /><verse number="4" style="v" sid="EZK 18:4" />देखो, आखा ना जीव ते मारा से, जेम बाह नो जीव, तेमेत सोरा नो जीव बी से; बेम मारात से। करीन जे जीव पाप करे तीहयोत मरहे।<verse eid="EZK 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 18:5" />“जे कोय धरमी से, अने नीयाव ना अने धरम ना काम करे, <verse eid="EZK 18:5" /><verse number="6" style="v" sid="EZK 18:6" />अने नी ते बड़ा ना पुजा करवा ना जागा मे खाणु खादो हय, अने नी ईस्‌रायल ना घोराणाम ना मुरत्‌या भणीन नींगा नाख्‌यो हय; अने नी बीजी बयर ने बगाड़्‌यो हय, अने नी मयना आवली बयर ह़ाते छीनाळु कर्‌यो हय। <verse eid="EZK 18:6" /><verse number="7" style="v" sid="EZK 18:7" />अने नी कोय पांह लुच्‌चाय कर्‌यो हय, अने करजा वाळा नो करजो माप कर्‌यो हय, अने भुकला ने आह़फा नो रोट्‌लो आप्‌यो हय अने नांगरला ने लुगड़ु ओडाड़्‌यो हय, <verse eid="EZK 18:7" /><verse number="8" style="v" sid="EZK 18:8" />अने नी वीयाज सी पय्‌हा आप्‌यो हय, अने नी वदु पय्‌हा लेदो हय, अने आह़फा नो हात गलत काम सी रोक्‌यो हय, माणहु नी वच मे सच्‌चाय सी नीयाव कर्‌यो हय, <verse eid="EZK 18:8" /><verse number="9" style="v" sid="EZK 18:9" />मारी रीती पोर चालतो हय अने मारा नेम ने मान्‌तो जाय्‌न सच्‌चाय सी काम कर्‌यो हय, आवो माणेह धरमी से, तीहयो पक्‌को जीवत्‌लो रेहे,” मालीक यहोवा आसमेत केय।<note caller="+" style="x"><char style="xo" closed="false">18:9 </char><char style="xt" closed="false"><ref loc="LEV 18:5">लेव्‌यवेवस्‌था 18:5</ref></char></note><verse eid="EZK 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 18:10" />“पण तीनो सोरो डाकु, हत्‌यारो, नीता उपर केदला पापु मे गेथो काना बी पाप ने करवा वाळो हय, <verse eid="EZK 18:10" /><verse number="11" style="v" sid="EZK 18:11" />अने उपर केदला वारला कामु ने करवा वाळो नी हय, अने बड़ा मे ना पुजा करवा ना जागा मे खाणु खादो हय, अने बीजी बयर ने बगाड़्‌यो हय, <verse eid="EZK 18:11" /><verse number="12" style="v" sid="EZK 18:12" />कमजोर गरीब ने वेला पाड़्‌यो हय, बीजा ने लुट्‌यो हय, अने कर्‌जा वाळा नु गीरवे मेकलु ह़मान पासु नी आप्‌यो हय, अने मुरत्‌या भणीन नींगा नाख्‌यो हय, ह़ीगी आवे एवु काम कर्‌यो हय, <verse eid="EZK 18:12" /><verse number="13" style="v" sid="EZK 18:13" />वीयाज सी पय्‌हा आप्‌यो हय, अने वदु पय्‌हा लेदो हय, ता ह़ु तीहयो जीवत्‌लो रेहे? तीहयो जीवत्‌लो नी रेय; आनीन करते के तीहयो आहया आखा ह़ीगी आवे एवा काम करलो से तीहयो पक्‌को मरहे अने तीनी मोत नो गुनो तीनात माथे पड़हे।<verse eid="EZK 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 18:14" />“अळतेण कदीम एवा माणेह नो सोरो हय अने तीहयो बाह ना आहया आखा पाप देखीन बीक ना कारण सी तीमनीन तेम नी करतो हय। <verse eid="EZK 18:14" /><verse number="15" style="v" sid="EZK 18:15" />मतलब नी ते बड़ा मे ना पुजा करवा ना जागा मे खाणु खादो हय, नी ते ईस्‌रायल ना घोराणा ना मुरत्‌या भणीन नींगा नाख्‌यो हय, अने नी बीजी बयर ने बगाड़्‌यो हय, <verse eid="EZK 18:15" /><verse number="16" style="v" sid="EZK 18:16" />अने नी कोय ने वेला पाड़्‌यो हय, अने नी कर्‌जा वाळा नु गीरवे मेकलु ह़मान नी लुट्‌यो हय, अने आह़फा नो रोट्‌लो भुकला ने आप्‌यो हय, नांगरला ने लुगड़ा ओडाड़्‌यो हय, <verse eid="EZK 18:16" /><verse number="17" style="v" sid="EZK 18:17" />कमजोर नु नुकसान करवा मे हात ने रोक्‌यो हय, वीयाज अने वदु पय्‌हा नी लेदो हय, मारा नेम ने मान्‌यो हय, अने मारी रीती पोर चाल्‌यो हय, ता तीहयो तीना बाह ना अधरम ना कारण सी नी मरे, पण जीवत्‌लोत रेहे। <verse eid="EZK 18:17" /><verse number="18" style="v" sid="EZK 18:18" />तीनो बाह, जे गरीब माणहु ने वेला पाड़्‌यो अने लुट्‌यो, अने आह़फा ना भायु नी वच मे गलत काम करलो से, तीहयोत तीना अधरम ना कारण सी मर जहे।<verse eid="EZK 18:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 18:19" />“ते बी तमु केवो, काहा? ह़ु सोरो बाह ना अधरम नो भार नी उचले? जत्‌यार सोरो नीयाव ना अने धरम ना काम कर्‌यो हय, अने मारी आखी रीती ने मानीन तीमनी पोर चाल्‌यो हय, ता तीहयो जीवत्‌लोत रेहे। <verse eid="EZK 18:19" /><verse number="20" style="v" sid="EZK 18:20" />जे पाप करहे तीहयोत जीव मरहे, नी ते सोरो बाह ना अधरम नो भार उचले नी बाह सोरा नो, धरमी ने आह़फा नात धरम नो फोळ, अने वेरी ने आह़फा नात पाप नो फोळ जड़हे।<note caller="+" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="DEU 24:16">वेवस्‌थावीवरन 24:16</ref></char></note><verse eid="EZK 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 18:21" />“पण कदीम वेरी माणेह आह़फा ना पाप भणी गेथु फीरीन, मारी आखी रीती ने पाळे अने नीयाव अने धरम ना काम करे, ता तीहयो नी मरे, पण जीवत्‌लो रेहे। <verse eid="EZK 18:21" /><verse number="22" style="v" sid="EZK 18:22" />तीहयो जेतरो गुनो करलो हय, तीमनी मे गेथा एक बी गुना नी फोम तीना वीरोद मे नी करे; जे धरम ना काम तीहयो कर्‌यो हय, तीना कारण सी तीहयो जीवत्‌लो रेहे। <verse eid="EZK 18:22" /><verse number="23" style="v" sid="EZK 18:23" />मालीक यहोवा आसमेत केय, ह़ु में वेरी ने मरवा सी थोड़ोक बी खुस हयु ह़ु? ह़ु में आनी सी खुस नी हयु के तीहयो तीनी वाटे गेथो फीरीन जीवत्‌लो रेय?<verse eid="EZK 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 18:24" />“पण जत्‌यार धरमी तीना धरम ना काम सी फीरीन गलत काम, मतलब वेरी ना आखा ह़ीगी आवे एवा कामु नी अनसारे करवा बाज जाय, ता ह़ु तीहयो जीवत्‌लो रेहे? जेतरा धरम ना काम तीहयो कर्‌यो हय, तीमनी मे गेथा काना काम नी बी फोम नी करे। जे धोको अने पाप तीहयो कर्‌यो हय, तीना कारण सी तीहयो मर जहे।<verse eid="EZK 18:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 18:25" />“ते बी तमु केवो, ‘मालीक नो वेहवार वारु नी हय।’ ए ईस्‌रायल ना घोराणा, देख, ह़ु मारो वेहवार वारु नी हय? ह़ु तमारी चाल बगड़ली नी हय ह़ु? <verse eid="EZK 18:25" /><verse number="26" style="v" sid="EZK 18:26" />जत्‌यार धरमी तीना धरम भणी गेथो फीरीन, गलत काम करवा बाज जाय, ता तीहयो तीहया काम ना कारण सी मरहे, मतलब तीहयो तीना गलत कामु ना कारण सीत मर जहे। <verse eid="EZK 18:26" /><verse number="27" style="v" sid="EZK 18:27" />अने कदीम वेरी तीना गलत कामु सी फीरीन, नीयाव अने धरम ना काम करवा बाज जाय, ता तीहयो तीनो जीव बचाड़हे। <verse eid="EZK 18:27" /><verse number="28" style="v" sid="EZK 18:28" />तीहयो जे सोच वीच्‌यार करीन आह़फा ना आखा गुना सी फीर्‌यो, करीन नी मरे, अने जीवत्‌लोत रेहे। <verse eid="EZK 18:28" /><verse number="29" style="v" sid="EZK 18:29" />ते बी ईस्‌रायल नु घोराणु केय के मालीक नो वेहवार वारलो नी हय। ए ईस्‌रायल ना घोराणा, ह़ु मारो वेहवार वारलो नी हय? ह़ु तमारीत चाल बगड़ली नी हय?<verse eid="EZK 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 18:30" />“मालीक यहोवा आसम केय, ए ईस्‌रायल ना घोराणा, में तमारी मे गेथो एक-एक माणेह नो नीयाव तीनी चाल-चलण नी अनसारेत करही। मन फीरावो अने आह़फाम ना आखा गुना ने छोड़ो, तात तमारो अधरम तमारा ठोकर खावा नो कारण नी बणे। <verse eid="EZK 18:30" /><verse number="31" style="v" sid="EZK 18:31" />आह़फाम ना आखा गुना ने जे तमु करला से, सेटा करो; आह़फाम नु मन अने आह़फाम नी आत्‌मा ने बदल देवो! ए ईस्‌रायल ना घोराणा, तमु ह़ुका मरो? <verse eid="EZK 18:31" /><verse number="32" style="v" sid="EZK 18:32" />काहाके, मालीक यहोवा आसम केय, जे मरे,” तीने मरवा सी में खुस नी हयु, “करीन मन फीरावो, तात तमु जीवत्‌ला रेहु।”<verse eid="EZK 18:32" /></para>
  <chapter eid="EZK 18" />
  <chapter number="19" style="c" sid="EZK 19" />
  <para style="s">एक दुख नु गीत</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 19:1" />ईस्‌रायल ना मुख्‌या ना बारा मे तु आहयु दुख नु गीत ह़मळाव:<verse eid="EZK 19:1" /></para>
  <para style="q1">
    <verse number="2" style="v" sid="EZK 19:2" />तारी आय्‌ह एक एवी नाहरनी हती!</para>
  <para style="q1" vid="EZK 19:2">तीहयी नाहरु नी वच मे बह्‌या करती हती अने तीना बच्‌चा ने जुवान नाहरु नी वच मे पाळती-पोहती हती।<verse eid="EZK 19:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="EZK 19:3" />तीना बच्‌चा मे गेथी तीहयी एक ने पाळी अने तीहयु जुवान नाहर बण ज्‌यु, अने सीकार करवा ह़ीक ज्‌यु;</para>
  <para style="q2" vid="EZK 19:3">तीहयु माणहु नो बी सीकार करवा बाज ज्‌यु।<verse eid="EZK 19:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 19:4" />राज्‌य-राज्‌य ना माणहु तीना बारा मे वात ह़मळ्‌या,</para>
  <para style="q2" vid="EZK 19:4">अने तीने तीनात खोदला खाडा मे फसाड़्‌या,</para>
  <para style="q1" vid="EZK 19:4">अने तीना नखरा मे नाथ पेराय्‌न तीने मीस्‌र मे ली ज्‌या।<verse eid="EZK 19:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="EZK 19:5" />जत्‌यार तीनी आय्‌ह देखी अने तीहयी दम धर राखी ते बी तीनी आह टुट जी,</para>
  <para style="q1" vid="EZK 19:5">ता तीहयी तीनु एक अळी बच्‌चु ने लीन</para>
  <para style="q2" vid="EZK 19:5">तीने जुवान बणाय देदी।<verse eid="EZK 19:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="EZK 19:6" />ता तीहयु जुवान नाहर बणीन नाहरु नी वच मे चालवा-फीरवा बाज ज्‌यु,</para>
  <para style="q2" vid="EZK 19:6">अने तीहयु बी सीकार करवा ह़ीक ज्‌यु,</para>
  <para style="q1" vid="EZK 19:6">अने माणहु नो बी सीकार करवा बाज ज्‌यु।<verse eid="EZK 19:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="EZK 19:7" />तीहयु तीमना घोरु ने उजाड़ देदु, अने तीमना ह़ेरु ने उजाड़्‌यु।</para>
  <para style="q1" vid="EZK 19:7">अने तीना आड़वा ना बीक सी देस</para>
  <para style="q2" vid="EZK 19:7">अने जे कंय तीनी मे हतु आखु उजड़ ज्‌यु।<verse eid="EZK 19:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="EZK 19:8" />ता च्‌यारो-मेर ना राज्‌य-राज्‌य ना माणहु</para>
  <para style="q2" vid="EZK 19:8">आह़फा-आह़फाम ना फळ्‌या मे गेथा तीना वीरोद मे नीकळ आया,</para>
  <para style="q1" vid="EZK 19:8">अने तीनी पोर जाळ नो फंदो नाख्‌या;</para>
  <para style="q2" vid="EZK 19:8">अने तीहयु तीमना खाडा मे फस ज्‌यु।<verse eid="EZK 19:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="EZK 19:9" />ता तीहया तीना नखरा मे नाथ घालीन</para>
  <para style="q2" vid="EZK 19:9">अने लाकड़ान पींजरा मे कुंडीन बेबीलोन ना राजान्‌तां ली ज्‌या।</para>
  <para style="q1" vid="EZK 19:9">अने तीहया तीने पींजरा मे कुंड देदा,</para>
  <para style="q2" vid="EZK 19:9">के तीनी अवाज ईस्‌रायल ना</para>
  <para style="q2" vid="EZK 19:9">बड़ा वाळा देस मे अळी नी ह़मळाय।<verse eid="EZK 19:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 19:10" />तारी आय्‌ह जीनी सी तु पयदा हयो,</para>
  <para style="q2" vid="EZK 19:10">तीहयी वाड़ी मे चोपला अंगुर ना वेला ह़रकी हती,</para>
  <para style="q1" vid="EZK 19:10">अने पाणी ढेरकु हयवा ना कारण सी फोळ</para>
  <para style="q2" vid="EZK 19:10">अने डाळ्‌या सी भरली हती।<verse eid="EZK 19:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 19:11" />राज करवा वाळा ना राजडंड जुगु</para>
  <para style="q2" vid="EZK 19:11">तीनी मे मोटा-मोटा डाळ्‌या हता;</para>
  <para style="q1" vid="EZK 19:11">अने तीहयु एतरु उचु हयु के वादळा मे तक पुग ज्‌यु;</para>
  <para style="q2" vid="EZK 19:11">अने तीना ढेरेत डाळ्‌या भेळ घणीत नाम्‌बी देखाव पड़ी।<verse eid="EZK 19:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 19:12" />ते बी तीने खीजवाय्‌न तीने उखड़ीन</para>
  <para style="q2" vid="EZK 19:12">धरती पोर नाख देदा,</para>
  <para style="q1" vid="EZK 19:12">अने तीना फोळ उगवणु नु वाहळु चालवा ना कारण सी ह़ुक ज्‌या;</para>
  <para style="q1" vid="EZK 19:12">अने तीना मोटा डाळ्‌या टुटीन ह़ुक ज्‌या;</para>
  <para style="q2" vid="EZK 19:12">अने तीहया आक्‌ठु मे धपीन रोखड़ो हय ज्‌या।<verse eid="EZK 19:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 19:13" />हाव तीहया वेला ने जंगल मे,</para>
  <para style="q2" vid="EZK 19:13">मतलब उजाड़ी जागा मे चोपलो से।<verse eid="EZK 19:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="EZK 19:14" />तीना डाळ्‌या ना फणहा मे गेथु आक्‌ठु नीकळ्‌यु,</para>
  <para style="q2" vid="EZK 19:14">जीनी सी तीना फोळ धपीन रोखड़ो बण ज्‌या,</para>
  <para style="q1" vid="EZK 19:14">अने राज करवा नी लायक राजडंड जुगु</para>
  <para style="q2" vid="EZK 19:14">तीनी मे कानी बी मोटी डाळ नी बची।</para>
  <para style="m" vid="EZK 19:14">आहयु दुख नु गीत से, अने आहयु दुख नु गीत बणलु रेहे।<verse eid="EZK 19:14" /></para>
  <chapter eid="EZK 19" />
  <chapter number="20" style="c" sid="EZK 20" />
  <para style="s">भगवान नी ईच्‌छा अने माणहु नी चुनोती</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 20:1" />ह़ातवा साल ना पांचवा मयना ना दहवा दाड़े ईस्‌रायल ना थोड़ाक डायला यहोवा पांह जपाप करवा करीन आया, अने मारी अगळ बह ज्‌या। <verse eid="EZK 20:1" /><verse number="2" style="v" sid="EZK 20:2" />ता यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 20:2" /><verse number="3" style="v" sid="EZK 20:3" />“ए माणेह नी अवल्‌यात,” ईस्‌रायल ना डायला ने आहयु के, मालीक यहोवा आसम केय, ह़ु तमु मारी पांह जपाप करवा आवला से? मालीक यहोवा आसम केय के मारा जीवाय नी ह़ाम, तमु मारी ईच्‌छा कदी नी जाण सको।<verse eid="EZK 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 20:4" />ए माणेह नी अवल्‌यात, ह़ु तु तीनो नीयाव नी करे? ह़ु तु तीमनो नीयाव नी करे? तीमना आड़ा-बुड़ाम ना ह़ीगी आवे एवा काम ईमने देखाड़ दे, <verse eid="EZK 20:4" /><verse number="5" style="v" sid="EZK 20:5" />अने तीमने के, मालीक यहोवा आसम केय: जे दाड़े में ईस्‌रायल ने टाळ लेदो, अने याकुब ना घोराणु सी ह़ाम खादो, अने में, मीस्‌र देस मे तीमनी पोर मने उजन्‌तो कर्‌यो, अने तीमने ह़ाम खाय्‌न केदो, में तमारो भगवान यहोवा से। <verse eid="EZK 20:5" /><verse number="6" style="v" sid="EZK 20:6" />तीहयात दाड़े में तीमनी ह़ाते आहयी बी ह़ाम खादो, के में तमने मीस्‌र देस मे गेथा नीकाळीन एक देस मे पुगाड़ही, जीने में तमारी जुगु टाळ लेदलो से; तीहयु आखा देसु मे आखा सी वारु से, अने तीनी मे दुद अने मोद ना झोरु वये। <verse eid="EZK 20:6" /><verse number="7" style="v" sid="EZK 20:7" />अळतेण में तीमने केदो, जे ह़ीगी आवे एवी चीज पोर तमारी मे गेथा आखा नी नींगा लाग री, तीमने नाख देवो; अने मीस्‌र ना मुरत्‌या वेर आह़फाम ने ना वीटाळो; अने मेंत तमारो भगवान यहोवा से। <verse eid="EZK 20:7" /><verse number="8" style="v" sid="EZK 20:8" />पण तीहया मारी ह़ाते धोको कर्‌या, अने मारी एक बी वात ह़मळवा नी चाह्‌या; जे ह़ीगी आवे एवी चीज पोर तीमनी नजर लागली हती, तीहयी चीज ने कोय नाख्‌यु नी, अने नी मीस्‌र ना मुरत्‌या ने छोड़्‌या। ता में केदो, में आहयात मीस्‌र देस नी वच मे तमारी पोर मारी रीह नीकाळही अने आखी खीज देखाड़ही। <verse eid="EZK 20:8" /><verse number="9" style="v" sid="EZK 20:9" />ते बी में मारा नाम ना कारण सी आसम कर्‌यो के जीमनी वच मे तीहया हता, अने जीमनी देखणते में तीमने मीस्‌र देस गेथा नीकळवा करीन खुद ने तीमनी पोर उजन्‌तो कर्‌यो तीहया राज्‌य नी अगळ तीहया वीटळ्‌ळा नी ठेरे।<verse eid="EZK 20:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 20:10" />में तीमने मीस्‌र देस मे गेथा नीकाळीन जंगल मे ली आयो। <verse eid="EZK 20:10" /><verse number="11" style="v" sid="EZK 20:11" />तां तीमने में रीती भाती देखाड़्‌यो अने मारा नेम बी देखाड़्‌यो के जे माणेह तीमने माने, तीहयो तीमना कारण सी जीवत्‌लो रेहे।<note caller="+" style="x"><char style="xo" closed="false">20:11 </char><char style="xt" closed="false"><ref loc="LEV 18:5">लेव्‌यवेवस्‌था 18:5</ref></char></note> <verse eid="EZK 20:11" /><verse number="12" style="v" sid="EZK 20:12" />अळतेण में तीमनी जुगु अराम ना दाड़ा बी ठेरायो जे मारी अने तीमनी वच मे सेलाणी ठेरे; के तीहया जाणे के में यहोवा तीमनो चोखो करवा वाळो से। <verse eid="EZK 20:12" /><verse number="13" style="v" sid="EZK 20:13" />ते बी ईस्‌रायल नु घोराणु जंगल मे मारी ह़ाते धोको कर्‌यु; तीहया मारी रीती पोर नी चाल्‌या, अने मारा नेम ने नीकार देदा, जीमने कदीम माणेह माने ता तीहयो तीमना कारण जीवत्‌लो रेहे; अने तीहया मारा अराम ना दाड़ा ने घणो जादा वीटाळ नाखला से. ता मे केदो, में जंगल मे मारी रीह तीमनी पोर नीकाळीन तीमने खत्‌तम कर देही। <verse eid="EZK 20:13" /><verse number="14" style="v" sid="EZK 20:14" />पण में मारा नाम ना कारण सी आसम कर्‌यो के तीहया ते राज्‌य नी अगळ, जीमनी देखणते में ईमने नीकाळ लावलो हतो, वीटळ्‌ळा नी ठेरे। <verse eid="EZK 20:14" /><verse number="15" style="v" sid="EZK 20:15" />अळतेण में जंगल मे तीमनी ह़ाते ह़ाम खादो के जे देस में तीमने आप देदो, अने जे आखु देस मे गेथु वारलु देस से, जीनी मे दुद अने मोद ना झोर वये, तीनी मे तीमने नी पुगाड़ु, <verse eid="EZK 20:15" /><verse number="16" style="v" sid="EZK 20:16" />काहाके तीहया मारा नेम ने हेटा ह़मज्‌या अने मारी रीती-भाती पोर नी चाल्‌या, अने मारा अराम ना दाड़ा ने वीटाळला हता; आनीन करते के तीमना मन तीमना मुरत्‌या भणीन लागलु र्‌यु।<verse eid="EZK 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 20:17" />“ते बी में तीमनी पोर दया नी नींगा नाख्‌यो, अने तीमने खत्‌तम नी कर्‌यो, अने नी जंगल मे तीमने पुरी रीते खत्‌तम कर्‌यो। <verse eid="EZK 20:17" /><verse number="18" style="v" sid="EZK 20:18" />अळतेण में जंगल मे तीमनी अवल्‌यात ने केदो, आह़फाम ना आड़ा-बुड़ाम नी रीती-भाती पोर ना चालो, अने नी तीमनी रीती ने मानो अने नी तीमना मुरत्‌या पुंजीन आह़फाम ने वीटाळो। <verse eid="EZK 20:18" /><verse number="19" style="v" sid="EZK 20:19" />में तमारो भगवान यहोवा से, मारी रीती-भाती पोर चालो, अने मारा नेम ने मानवा मे चेतीन रेवो, <verse eid="EZK 20:19" /><verse number="20" style="v" sid="EZK 20:20" />अने मारा अराम ना दाड़ा ने चोखला मानो के तीहया मारी अने तमारी वच मे सेलाणी ठेरे, जीनी सी तमु जाणो के में तमारो भगवान यहोवा से।<verse eid="EZK 20:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 20:21" />“पण तीमनी अवल्‌यात बी मारी ह़ाते धोको कर्‌या; तीहया मारी रीती-भाती पोर नी चाल्‌या, अने नी मारा नेम ने मानवा मे चेतीन र्‌या; जीमने कदीम माणेह माने ता तीहयो तीमना कारण जीवत्‌लो रेहे; मारा अराम ना दाड़ा ने तीहया वीटाळ देदा। ता में केदो, में जंगल मे मारी रीह तीमनी पोर नीकाळही मारी रीह देखाड़ही। <verse eid="EZK 20:21" /><verse number="22" style="v" sid="EZK 20:22" />ते बी में मारो हात पासो कर लेदो, अने मारा नाम कारण सी आसम कर्‌यो, के तीहया माणहुम नी अगळ, जीमनी देखणते में तीमने नीकाळ लावलो हतो, तीहया वीटळ्‌ळा नी ठेर्‌या। <verse eid="EZK 20:22" /><verse number="23" style="v" sid="EZK 20:23" />अळतेण में तीमनी ह़ाते जंगल मे ह़ाम खादो, के में तमने राज्‌य-राज्‌य मे रीवण्‌या-तीवण्‌या करही, अने देस-देस मे खोळवी देही,<note caller="+" style="x"><char style="xo" closed="false">20:23 </char><char style="xt" closed="false"><ref loc="LEV 26:33">लेव्‌यवेवस्‌था 26:33</ref></char></note> <verse eid="EZK 20:23" /><verse number="24" style="v" sid="EZK 20:24" />काहाके तीहया मारा नेम ने नी मान्‌या, अने मारी रीती-भाती ने रीकामा ह़मज्‌या, मारा अराम ना दाड़ा ने वीटाळ्‌या, अने आह़फाम ना आड़ा-बुड़ाम ना मुरत्‌या भणीन तीमना डोळा लागला र्‌या।<verse eid="EZK 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 20:25" />“अळतेण में तीमनी जुगु एवी-एवी रीती-भाती ठेरायो जे वारली नी हती अने एवी-एवी रीती जीमना कारण सी तीहया जीवत्‌ला नी री सक्‌या। <verse eid="EZK 20:25" /><verse number="26" style="v" sid="EZK 20:26" />मतलब तीहया तीमना आखा गेथा मोट्‌ला सोरा ने आक्‌ठु मे होम बादा चड़ाव्‌वा बाज ज्‌या; आहयी रीते में तीमने तीमनीत भेट नी लारे वीटाळ्‌यो जीमनी सी तीमने अवल्‌यात वगर ना कर देम; अने ता तीहया जाण लेहे के में यहोवा से।<verse eid="EZK 20:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 20:27" />“ए माणेह नी अवल्‌यात, तु ईस्‌रायल ना घोराणा ने के: मालीक परभु आसम तमारा आड़ा-बुड़ा आनी मे बी मारो वाक काड्‌या के तीहया मारी ह़ाते धोको कर्‌या। <verse eid="EZK 20:27" /><verse number="28" style="v" sid="EZK 20:28" />काहाके जत्‌यार में तीमने तीहया देस मे पुगाड़्‌यो, जीने तीमने आपवा नी ह़ाम में तीमनी ह़ाते खादलो हतो, ता तीहया एक-एक उची टेकड़ी अने एक-एक झाजला झाड़ पोर नींगा नाखीन तांत तीमनी मेलबादा चड़ाव्‌वा बाज ज्‌या; अने तां रीह लगाड़वा वाळी भेट चड़ाव्‌वा बाज ज्‌या अने तां तीमनो वारलु गंदायण्‌यु तेल धपाड़ता हता, अने तीमनी पीवा नी बादा रेचवता हता। <verse eid="EZK 20:28" /><verse number="29" style="v" sid="EZK 20:29" />ता में तीमने पुछ्‌यो, ‘जे उचा जागा’ मे तमु जावो, हीय्‌यु ह़ु से? आनी सीत तीनु नाम आज तक बामा केवाड़े। <verse eid="EZK 20:29" /><verse number="30" style="v" sid="EZK 20:30" />करीन ईस्‌रायल ना घोराणा ने के, मालीक यहोवा तमने आहयु पुछे: ह़ु तमु बी तमारा आड़ा-बुड़ा नी रीती पोर चालीन वीटळीन, अने तीमना ह़ीगी आवे एवा कामु नी अनसारे छीनाळ्‌याण ने तेवा काम करो? <verse eid="EZK 20:30" /><verse number="31" style="v" sid="EZK 20:31" />आज तक जत्‌यार-जत्‌यार तमु तमारी भेट चड़ावो अने तमारा सोरा ने होम बादा चड़ावो, तत्‌यार-तत्‌यार तमु तमारा मुरत्‌या ना कारण सी वीटळ्‌ळा ठेरो। ए ईस्‌रायल ना घोराणा, ह़ु तमु मने पुछ सकहु? मालीक यहोवा नो आहयो बोल से, मारी जीवाय नी ह़ाम तमु मारी ईच्‌छा ने जाणी नी सको। <verse eid="EZK 20:31" /><verse number="32" style="v" sid="EZK 20:32" />जे वात तमारा मन मे आवे, आमु लाकड़ा ना अने दगड़ा ना मुरत्‌या ना उपाह पाळन्‌या बणीन राज्‌य-राज्‌य अने देस-देस ना कुळ ने तेवा हय जहु, तीहयी कानी बी भात्‌ये पुरी नी हये। भगवान डंड आपे अने माप बी करे।<verse eid="EZK 20:32" /></para>
  <para style="s">भगवान डंड आपे अने माप बी करे</para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 20:33" />“मालीक यहोवा आसम केय, मारी जीवाय नी ह़ाम में पक्‌को ताखत वाळा हात अने बड़ावला हात सी, अने पुरी लगाड़ली रीह भेळ तमारी पोर राज करही। <verse eid="EZK 20:33" /><verse number="34" style="v" sid="EZK 20:34" />में ताखत वाळा हात अने अगो करला हात वेर अने लागली खीज भेळ तमने देस-देस ना माणहु मे गेथा अलग करही, अने तीहया देस मे जीनी मे तमु रीवण्‌या-तीवण्‌या हय जेला हता, एक्‌ठा करही; <verse eid="EZK 20:34" /><verse number="35" style="v" sid="EZK 20:35" />अने में तमने ‘देस-देस ना माणहु ना जंगल मे ली जाय्‌न,’ तां आमने-सामने तमारो नीयाव करही। <verse eid="EZK 20:35" /><verse number="36" style="v" sid="EZK 20:36" />जेम में तमारा आड़ा-बुड़ा नो मीस्‌र देस ना जंगल मे नीयाव करतो हतो, तीहयीत रीते में तमारो बी नीयाव करही,” मालीक यहोवा आसमेत केय।<verse eid="EZK 20:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 20:37" />“में तमने गुवाळ्‌यान तेम छाटवा अने गणवा करीन लाकड़ी तळे चलाड़ही, अने में तमने वायदा ना बंदन मे बांदही; <verse eid="EZK 20:37" /><verse number="38" style="v" sid="EZK 20:38" />में तमारी मे गेथा तीहया माणहु ने सेटा करही, जे बक-बक करन्‌या अने पापी से। अने तमने चोखा करही तीमने तीहया देस मे गेथा जीनी मे तीहया हमणे री र्‌या, में नीकाळ लेही, पण ईस्‌रायल ना देस मे अळी पासा जवा नी देम। ता तमु जाण लेहु के में यहोवा से।”<verse eid="EZK 20:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="EZK 20:39" />ए ईस्‌रायल ना घोराणा तमने ते मालीक आसम केय: “जाय्‌न आह़फा-आह़फाम ना मुरत्‌यान उपाह पाळो; अने कदीम तमु मारी वात नी ह़मळो, ता अगा बी आहयुत कर्‌या करो; पण मारा चोखला नाम ने तमारी भेटु अने मुरत्‌या नी लारे अळी वीटाळजो नी। <verse eid="EZK 20:39" /><verse number="40" style="v" sid="EZK 20:40" />काहाके मालीक यहोवा आसम केय के ईस्‌रायल नु आखु घोराणु आह़फाम ना देस मे मारा चोखला बड़ा पोर, ईस्‌रायल ना उचा बड़ा पोर, पुरुन पुरु घोराणु मारी भक्‌ती करहे; तां में तीमनी सी खुस हयही, अने तांत में तमारी उचल्‌ली भेट अने चड़ावली वारली-वारली चीज, अने तमारी आखी चोखी करली चीज तमारी पांह लीया करही। <verse eid="EZK 20:40" /><verse number="41" style="v" sid="EZK 20:41" />जत्‌यार में तमने देस-देस ना माणहु मे गेथा अलग करही अने तीहया देस मे जीमनी मे तमु रीवण्‌या-तीवण्‌या हय र्‌या, एक्‌ठा करही, ता तमु ने वारु गंद वाळु गंद जाणीन आवरी लेही, अने बीजा माणहु नी अगळ तमारी लारे चोखलो ठेरही। <verse eid="EZK 20:41" /><verse number="42" style="v" sid="EZK 20:42" />जत्‌यार में तमने ईस्‌रायल ना देस मे पुगाड़ही, जीने आपवा नी ह़ाम में तमारा आड़ा-बुड़ा ह़ाते खादलो हतो, ता तमु जाण लेहु के में यहोवा से। <verse eid="EZK 20:42" /><verse number="43" style="v" sid="EZK 20:43" />ता तमु तमारी चाल-चलण ने अने आह़फाम ना आखा काम ने जीमने करवा सी तमु वीटळ जेला से फोम करहु, अने आह़फाम ना आखा गलत कामु ना कारण सी आह़फाम नी नींगा मे ह़ीगी आवे एवा ठेरहु। <verse eid="EZK 20:43" /><verse number="44" style="v" sid="EZK 20:44" />ए ईस्‌रायल ना घोराणा, में तमारी गलत चाल-चलण अने बगड़ला कामु नी अनसारे डंड नी आपु, पण मारा नाम ना कारण सी तमारी ह़ाते दयाळ्‌ळो वेहवार करही ता तमु जाण लेहु के में यहोवा से।” मालीक यहोवा आसमेत केय।<verse eid="EZK 20:44" /></para>
  <para style="s">दखणाव मे आक्‌ठु</para>
  <para style="p">
    <verse number="45" style="v" sid="EZK 20:45" />यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 20:45" /><verse number="46" style="v" sid="EZK 20:46" />“ए माणेह नी अवल्‌यात,” तारो मुख दखणाव भणीन फीरव, “दखणाव देस ना वीरोद मे बोल ह़मळाव, अने दखणाव देस ना जंगल ना बारा मे भगवान वगे गेथी वात कर; <verse eid="EZK 20:46" /><verse number="47" style="v" sid="EZK 20:47" />अने दखणाव देस ना जंगल ने के; यहोवा नो बोल ह़मळ: मालीक यहोवा आसम केय, में तारी मे आक्‌ठु लावही, अने तारी मे ह़ु लील्‌ला, ह़ु ह़ुकला, जेतरा झाड़का से, आखा ने तीहयु आक्‌ठु खत्‌तम कर देहे; तीनी होळो-होळो आच नी ओलाये, अने तीना कारण सी दखणाव गेथा धुराव तक ना आखा ना मोडा अचवाय जहे। <verse eid="EZK 20:47" /><verse number="48" style="v" sid="EZK 20:48" />ता आखा जीव ने मालम पड़ जहे के आहयु आक्‌ठु यहोवा धपाड़लो से; अने तीहयु कारु नी ओलाये।”<verse eid="EZK 20:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="EZK 20:49" />ता में केदो, “ए भगवान यहोवा! माणहु ते मारा बारा मे कीया करे के ह़ु तीहयो दाखलानेत केवा वाळो नी हय?”<verse eid="EZK 20:49" /></para>
  <chapter eid="EZK 20" />
  <chapter number="21" style="c" sid="EZK 21" />
  <para style="s">नीयाव नी तलवार</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 21:1" />यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 21:1" /><verse number="2" style="v" sid="EZK 21:2" />“ए माणेह नी अवल्‌यात,” तारु मोडु यरुसलेम भणीन कर अने चोखला जागाम नी भणीन बोल ह़मळाव, ईस्‌रायल देस ना बारा मे भगवान वगे गेथी वात कर अने तीने के, <verse eid="EZK 21:2" /><verse number="3" style="v" sid="EZK 21:3" />मालीक यहोवा आसम केय: देख, में तारा वीरोद मे से, अने मारी तलवार ने मीयान मे गेथी नीकाळीन तारी मे गेथा धरमी अने अधरमी बेम ने खत्‌तम करही। <verse eid="EZK 21:3" /><verse number="4" style="v" sid="EZK 21:4" />आनीन करते के में तारी मे गेथा धरमी अने अधरमी आखा ने खत्‌तम करवा वाळो से, करीन मारी तलवार मीयान मे गेथी नीकाळीन दखणाव गेथी धुराव तक आखा जीवु ना वीरोद मे चलाड़ही; <verse eid="EZK 21:4" /><verse number="5" style="v" sid="EZK 21:5" />ता आखा जीव जाण लेहे के यहोवा मीयान मे गेथी आह़फा नी तलवार नीकाळलो से; अने तीने मीयान मे अळतेण नी मेके।<verse eid="EZK 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 21:6" />“करीन ए माणेह नी अवल्‌यात, तु कंजार, घणो दुखी हय, अने भागलु केड़्‌या लीन माणहु अगळ कंजार। <verse eid="EZK 21:6" /><verse number="7" style="v" sid="EZK 21:7" />जत्‌यार तीहया तने पुछे, ‘तु ह़ुका कंजारे?’ ता केजे, खबर ना कारण। काहाके एवी वात आव्‌वा वाळी से के आखा ना मन काप उठहे, अने आखा ना हात ढीला पड़ जहे, आखा नी आत्‌मा मजबुर अने आखा ना घोटणा कमजोर हय जहे। देखो, आवीत वात आव्‌वा वाळी से, अने तीहयी पक्‌की पुरी हयहे,” भगवान यहोवा आसमेत केय।<verse eid="EZK 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 21:8" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 21:8" /><verse number="9" style="v" sid="EZK 21:9" />ए माणेह नी अवल्‌यात, भगवान वगे गेथी वात करीन के, भगवान यहोवा आसम केय:</para>
  <para style="q1" vid="EZK 21:9">देख, पंजावली तलवार, अने चमकावली तलवार!<verse eid="EZK 21:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="EZK 21:10" />तीने आनीन करते पंजायी के तीनी वेर मारी सके,</para>
  <para style="q2" vid="EZK 21:10">अने आनीन करते चमकाड़्‌या के तीहयी वीजळीन तेम चमके!</para>
  <para style="q1" vid="EZK 21:10">ता ह़ु आमु खुसी मनावया?</para>
  <para style="q2" vid="EZK 21:10">तीहयी ते यहोवा ना सोरा नो राज डंड से अने आखा झाड़ु ने हेटा जाणवा वाळो से।<verse eid="EZK 21:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="EZK 21:11" />तीहयी चमकाड़वा आनीन करते</para>
  <para style="q2" vid="EZK 21:11">आपली के हात मे लेय,</para>
  <para style="q1" vid="EZK 21:11">तीने आनीन करते पंजायी अने चमकाड़ी के</para>
  <para style="q2" vid="EZK 21:11">खत्‌तम करवा वाळा ना हात मे आपे।<verse eid="EZK 21:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="EZK 21:12" />ए माणेह नी अवल्‌यात आड़,</para>
  <para style="q2" vid="EZK 21:12">अने छाती ठोकीन रड़, अने दुख मनाव!</para>
  <para style="q2" vid="EZK 21:12">काहाके तीहयी मारात माणहु ना वीरोद मे चालवा हींडे,</para>
  <para style="q1" vid="EZK 21:12">तीहयी ईस्‌रायल ना आखा मुख्‌या ना वीरोद मे चालवा हींडे;</para>
  <para style="q2" vid="EZK 21:12">मारा माणहु नी ह़ाते तीहया बी तलवार ना अदीकार मे आय लागला से।</para>
  <para style="q1" vid="EZK 21:12">करीन तु तारी छाती ठोकीन रड़।<verse eid="EZK 21:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="EZK 21:13" />काहाके ह़ाचलीन तीनी जाच हयली से,</para>
  <para style="q2" vid="EZK 21:13">अने कदीम तीने हेटो जाणवा वाळो राज डंड बी नी रेय,</para>
  <para style="q2" vid="EZK 21:13">ता ह़ु? भगवान यहोवा आसमेत केय।<verse eid="EZK 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 21:14" />“करीन ए माणेह नी अवल्‌यात, भगवान वगे गेथी वात कर, ने थापड़्‌या ठोक, अने तीन काव तलवार नो जोर डबल करे; तीहयी ते मारवा वाळी तलवार मतलब मोट्‌ला सी मोट्‌ला ने मारवा नी तलवार से, जीनी सी मोहट्‌या मे बी ह़ताय्‌न कोय बची नी सके। <verse eid="EZK 21:14" /><verse number="15" style="v" sid="EZK 21:15" />में तीमने मारवा वाळी तलवार ने तीमना आखा झापला ना वीरोद मे आनीन करते चलाड़लो से, के माणहु नु मन बीक ना कारण सी काप टुटे, अने तीहया घणा ठोकर खाय। गरा आय पड़े! गरा आय पड़े! तीहयी ते वीजळीन तेवी बणावली से, अने मारवा करीन पंजावली से। <verse eid="EZK 21:15" /><verse number="16" style="v" sid="EZK 21:16" />जमणी अने डाखरी ह़ोड़ तोड़, ए पंजावली तलवार! जंय वळे तंय तोड़। <verse eid="EZK 21:16" /><verse number="17" style="v" sid="EZK 21:17" />में बी थापड़्‌या बगाड़ही अने मारी रीह ने टाडी करही, मे यहोवा आसम केदलो से।”<verse eid="EZK 21:17" /></para>
  <para style="s">बेलीलोन ना राजा नी तलवार</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 21:18" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 21:18" /><verse number="19" style="v" sid="EZK 21:19" />“ए माणेह नी अवल्‌यात,” बे वाट ठेराय ले के “बेबीलोन ना राजा नी तलवार आवे; बेम वाट एकीत देस मे गेथी नीकळे। अळतेण एक सेलाणी बणाव, मतलब ह़ेर नी वाट जां गेथी सुरु हयहे तां एक सेलाणी बणाव। <verse eid="EZK 21:19" /><verse number="20" style="v" sid="EZK 21:20" />एक वाट बणाव के तलवार अम्‌मोनीम ना रब्‌बा ह़ेर पोर, अने यहुदा देस ना कीला वाळा ह़ेर यरुसलेम पोर बी चाले। <verse eid="EZK 21:20" /><verse number="21" style="v" sid="EZK 21:21" />काहाके बेबीलोन नो राजो चोवरायो मतलब बेम वाट ना नीकळवा ना जागा पोर अगी हयवा वाळी वात जाणवा करीन उबो हय र्‌यो, तीहयो बीलखा ने हीलाय देदो, अने घोर ना देवताम नी पांह जपाप कर्‌यो, अने काळजु ने बी देख्‌यो। <verse eid="EZK 21:21" /><verse number="22" style="v" sid="EZK 21:22" />तीना जमणा हात मे ‘यरुसलेम’ नु नाम से के तीनी भणीन झुमायवा नु ह़मान ने लगाड़े, अने गळु फाड़ीन मारवा नो हुकम आपे अने उचा बोल सी कुर्‌राटे, झापला भणीन झुमायवा नु ह़मान ने लगाड़े अने हालर बांदे अने कोट बणावे। <verse eid="EZK 21:22" /><verse number="23" style="v" sid="EZK 21:23" />पण यरुसलेम ना रेवा वाळा ने आहयो सुक झुटो मालम पड़ र्‌यो। तीहया जे ह़ाम खादला से; करीन तीहयो तीमना अधरम नी फोम करावीन तीमने धर लेहे। <verse eid="EZK 21:23" /><verse number="24" style="v" sid="EZK 21:24" />करीन मालीक यहोवा आसम केय: आनीन करते के तमारो अधरम जे फोम करलो से, अने तमारा गुना जे उजन्‌तां हय जेला से, काहाके तमारा कामु मे पापेत पाप देखाव पड़लो से, अने तमने आहयु आखु नी फोम आय जेली से, करीन तमु आमनीत सी धराय जहु।<verse eid="EZK 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 21:25" />“ए ईस्‌रायल वीटळ्‌ळा मुख्‌या, तारो दाड़ो आय जेलो से; अधरम नी खत्‌तम हयवा नी टेम आय लागली से। <verse eid="EZK 21:25" /><verse number="26" style="v" sid="EZK 21:26" />तारा बारा मे भगवान यहोवा आसम केय: पागड़ी उतार, अने मुकुट बी उतार दे; तीहयो जेवो से तेवो नी रेय; जे नीचो से तीने उचो कर अने जे उचो से तीने नीचो कर। <verse eid="EZK 21:26" /><verse number="27" style="v" sid="EZK 21:27" />में तीमने उथलाय देही अने उथलाय्‌न गबड़ाय देही; होव उथलाय देही अने जत्‌यार तक तीनो अदीकारी नी आवे तांह तक तीहयु उथलावलु रेहे; अने मालीक आवहे ता में तीने आप देही।<verse eid="EZK 21:27" /></para>
  <para style="s">अम्‌मोनीम ना वीरोद मे तलवार</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 21:28" />“अळतेण ए माणेह नी अवल्‌यात, भगवान वगे गेथी वात कीन के, के मालीक यहोवा अम्‌मोनी अने तीमना काडला वाक ना बारा मे आसम केय; तु आसम के: नीकाळली तलवार से, तीहयी तलवार मारवा करीन चमकाड़ली से के मारे अने वीजळीन तेम रेय।<verse eid="EZK 21:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="EZK 21:29" />जत्‌यार तक के तीहया तारा बारा मे झुटा दरसन देखे, अने झुटा दरसन देखवा वाळा तने देखाड़े के तु वीटळ्‌ळा घाव लागला ना बोचा पोर पड़े जीमनो दाड़ो आय जेलो से, अने जीमना अधरम नी खत्‌तम हयवा नी टेम आय लागली से।<verse eid="EZK 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 21:30" />“‘तीने मीयान मे पासी मेक। जे जागा मे तने बणायी अने जे देस मे तु पयदा हयी, तीनीत मे, में तारो नीयाव करही। <verse eid="EZK 21:30" /><verse number="31" style="v" sid="EZK 21:31" />में तारी पोर मारी रीह नीकाळही अने तारी पोर मारु खुद नु आक्‌ठु फुक देही; अने तने जानवर ने तेम माणहु ना हात मे कर देही जे मारवा वाळा वारु ह़ीकला से। <verse eid="EZK 21:31" /><verse number="32" style="v" sid="EZK 21:32" />तु आक्‌ठु नी कोर बणही; तारु लोय देस मे वयाड़हे, अने तने कोय फोम बी नी करे’” काहाके में यहोवात आसम केदलो से।<verse eid="EZK 21:32" /></para>
  <chapter eid="EZK 21" />
  <chapter number="22" style="c" sid="EZK 22" />
  <para style="s">यरुसलेम ना गुना नो नीयाव</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 22:1" />16 यहोवा भगवान नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 22:1" /><verse number="2" style="v" sid="EZK 22:2" />“ए माणेह नी अवल्‌यात,” “ह़ु तु तीहया हत्‌यारा ह़ेर नो नीयाव नी करे? ह़ु तु तीनो नीयाव नी करे? तीने तीना आखा बुरा काम देखाड़ दे, <verse eid="EZK 22:2" /><verse number="3" style="v" sid="EZK 22:3" />अने के, भगवान यहोवा आसम केय: ए ह़ेर तु तारी वच मे हत्‌या करे जीनी सी तारी टेम आवे, अने खुद नु नुकसान करवा अने वीटळवा करीन मुरत्‌या बणावे। <verse eid="EZK 22:3" /><verse number="4" style="v" sid="EZK 22:4" />जे हत्‌या तु करलु से, तीनी सी तु गुनाळ्‌ळु ठेरलु से, अने जे मुरत्‌या तु बणावलु से, तीमना कारण सी तु वीटळ जेलु से; तु तारा खत्‌तम हयवा ना दाड़ा ने ह़ाते कर लेदु, अने तारा पाछला साल तक पुग जेलु से। करीन मे तने राज्‌य-राज्‌य ना माणहु भणीन गेथो वाक काडवा नो, अने आखा देस ने हाही-ठट्‌टा ना कारण बणाय देदलो से। <verse eid="EZK 22:4" /><verse number="5" style="v" sid="EZK 22:5" />ए बदनाम ह़ेर, ए कचाट सी भरलु ह़ेर, जे ह़ाते अने नाम्‌बे से, तीहया आखा तारी ह़ाही-ठट्‌टा उड़ावहे। <verse eid="EZK 22:5" /><verse number="6" style="v" sid="EZK 22:6" />देख, ईस्‌रायल मा मुख्‌या माणहु आह़फा-आह़फाम नी ताखत नी अनसारे तारी मे हत्‌या करवा वाळा बणला से। <verse eid="EZK 22:6" /><verse number="7" style="v" sid="EZK 22:7" />ह़ेर मे तमारी मे गेथा कोय बी आह़फा ना आय्‌ह-बाहा नी ईज्‌जत नी करे। तमु बीजा देस वाळा ने धोको देवो अने नमल्‌या अने रंडायला माणहु पांह फायदो हात करो।<note caller="+" style="x"><char style="xo" closed="false">22:7 </char><char style="xt" closed="false"><ref loc="EXO 20:12">नीरगमन 20:12</ref>; <ref loc="EXO 22:21">22:21</ref>,<ref loc="EXO 22:22">22</ref>; <ref loc="DEU 5:16">वेवस्‌थावीवरन 5:16</ref>; <ref loc="DEU 24:17">24:17</ref></char></note> <verse eid="EZK 22:7" /><verse number="8" style="v" sid="EZK 22:8" />तु मारा चोखला जागा नी ईज्‌जत नी कर्‌यु, अने मारा अराम ना दाड़ा ने वीटाळलु से। <verse eid="EZK 22:8" /><verse number="9" style="v" sid="EZK 22:9" />तारी मे लुच्‌चा माणहु हत्‌या करवा करीन तीयार हया, अने तारा माणहु बड़ा पोर खाणु खादला से, अने मारी वच मे घणो-मोटो पाप करला से। <verse eid="EZK 22:9" /><verse number="10" style="v" sid="EZK 22:10" />तारी मे एवा बी माणहु से जे आह़फा ना बाह नी लाडी ह़ाते बी ह़ुवे; अने तीमना मयना आव्‌वा नी टेमे बी सवसार करवा नी लेदे तीमने मजबुर करे।<note caller="+" style="x"><char style="xo" closed="false">22:10 </char><char style="xt" closed="false"><ref loc="LEV 18:7-20">लेव्‌यवेवस्‌था 18:7-20</ref></char></note> <verse eid="EZK 22:10" /><verse number="11" style="v" sid="EZK 22:11" />काना तारी मे आड़ी-धेड़े वाळी बयर ह़ाते गलत काम करला से; अने कोय आह़फा नी ववेह ने बगाड़ीन घणो-मोटो पाप करला से; अने काना एवा बी से, जे खुद नी सोतेली बेनेह ह़ाते गलत काम करे। <verse eid="EZK 22:11" /><verse number="12" style="v" sid="EZK 22:12" />तारी मे थोड़ाक माणहु पय्‌हा नी लेदे हत्‌या करे; थोड़ाक माणहु बीजा ईस्‌रायली माणहु पांह आपला कर्‌जा नु वीयाज लेय; अने तीनो फायदो उठावे; अने तमु मने भुल जेला से।” मालीक यहोवा आसमेत केय।<verse eid="EZK 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 22:13" />“करीन देख, जे फायदो तु वेला पाड़ीन हात कर्‌यो अने तारी वच मे हत्‌या करलु से, करीन मे पक्‌को तारी पोर हात उठावही। <verse eid="EZK 22:13" /><verse number="14" style="v" sid="EZK 22:14" />जे दाड़े मे तारो नीयाव करही, ह़ु तीहया दाड़ा मे तारु मन मजबुत अने तारो हात टेकीन री सकहे ह़ु? में यहोवा आहयु केदलो से, अने आसमेत करही। <verse eid="EZK 22:14" /><verse number="15" style="v" sid="EZK 22:15" />में तारा माणहु ने राज्‌य-राज्‌य मे रीवण्‌या-तीवण्‌या करही, अने देस-देस मे खोळवी देही, अने तीनु वीटळ्‌ळु ने मारी गेथु सेटु करही। <verse eid="EZK 22:15" /><verse number="16" style="v" sid="EZK 22:16" />तु राज्‌य-राज्‌य नी देखणते आह़फु नीत नींगा मे वीटळ्‌ळु ठेरही; ता तु जाण लेही में के यहोवा से।”<verse eid="EZK 22:16" /></para>
  <para style="s">भगवान नी रीह</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 22:17" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 22:17" /><verse number="18" style="v" sid="EZK 22:18" />“ए माणेह नी अवल्‌यात, ईस्‌रायल नु घोराणु मारी नींगा मे धातु नो मोळ बण जेला से; तीहया आखान-आखा मोट्‌ला चुला ना वच मे नु पीतळ अने कथीर लुहड़ु अने ह़ीह़ान तेम बण जेला से; तीहया चांदी ना मोळ ने तेवा बण जेला से। <verse eid="EZK 22:18" /><verse number="19" style="v" sid="EZK 22:19" />करीन मालीक यहोवा तीमने आसम केय: आनीन करते के तमु आखान-आखा धातु ना मोळ ने तेवा बण जेला से, करीन हाव देखो, में तमने ईस्‌रायल नी मोय एक्‌ठा करवा वाळो से। <verse eid="EZK 22:19" /><verse number="20" style="v" sid="EZK 22:20" />जेम माणहु चांदी, पीतळ, लुहड़ु ह़ीह़ा अने कथीर आनीन करते मोट्‌ला चुलान मोय एक्‌ठु करीन मेके के तीमने आक्‌ठु धपाड़ीन ओगळावे, तेमेत में तमने मारी रीह सी एक्‌ठा करीन तांत मेकीन ओगाळ देही। <verse eid="EZK 22:20" /><verse number="21" style="v" sid="EZK 22:21" />में तमने तां एक्‌ठा करीन मारी रीह नु आक्‌ठु मे तमारी पोर फुकही, अने तमु तीमनी वच मे ओगळी जहु। <verse eid="EZK 22:21" /><verse number="22" style="v" sid="EZK 22:22" />जेम भाटी नी वच मे चांदी ने पीगळावे, तेमेत तमु ने बी तीनी वच मे पीगळावहे; ता तमु जाण लेहु के जे अमारी पोर आह़फा नी रीह नीकाळलो से, तीहयो यहोवा से।”<verse eid="EZK 22:22" /></para>
  <para style="s">ईस्‌रायल ना अगवाय करन्‌या ना पाप</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 22:23" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 22:23" /><verse number="24" style="v" sid="EZK 22:24" />“ए माणेह नी अवल्‌यात,” तीहया देस ने के, “तु एवु देस से जे चोखलु नी हयु, अने भगवान ना रीह ना दाड़ा मे तारी पोर पाणी नी पड़्‌यो। <verse eid="EZK 22:24" /><verse number="25" style="v" sid="EZK 22:25" />तारा भगवान वगे गेथी वात केवा वाळा तारी मे धोको देवा नी वात कर्‌या, तीहया डोखारवा वाळा नाहर ने तेम सीकार धर्‌या अने जीव ने खाय जेला से; तीहया मेकलु मोगलु धन ने हापकी लेय, अने तारी मे घणा बयरा ने रंडायला बणाय देय। <verse eid="EZK 22:25" /><verse number="26" style="v" sid="EZK 22:26" />तीना पुंजारा मारा नेम ने बड़ाय्‌न-चड़ाय्‌न देखाड़ला से, अने मारु चोखलु ह़मान ने वीटाळ नाखला से; तीहया चोखलु अने वीट्‌ळलु नो कंय बी भेद नी करे, अने नी बीजा ने चोखलु अने वीटळ्‌ळु नो भेद ह़ीकाड़ला हय, अने तीहया मारा अराम ना दाड़ा ना बारा मे नीरहा रेय, जीनी में तीमनी वच मे वीटळलो ठेरु। <verse eid="EZK 22:26" /><verse number="27" style="v" sid="EZK 22:27" />तीना मुख्‌या लेंड्‌यान तेम सीकार धरे, अने गलत काम सी फायदो करवा करीन हत्‌या करे अने जीव ने मारवा करीन तीयार रेय। <verse eid="EZK 22:27" /><verse number="28" style="v" sid="EZK 22:28" />तीना भगवान वगे गेथी वात केवा वाळा तीमनी जुगु कच्‌ची नीपाय-पुताय करे, अने तीमनु दरसन देखणु झुट से; यहोवा भगवान कंय नी केदो ते बी तीहया आहयु कीन झुटी अगी हयवा वाळी वात देखाड़े के, ‘मालीक यहोवा आसम केय।’ <verse eid="EZK 22:28" /><verse number="29" style="v" sid="EZK 22:29" />देस ना बीजा ह़ुदला माणहु बी धोको देय अने बीजा नु धन हापके, तीहया गरीब-गुरबा ने वेला पाड़े अने नीयाव नी चीन्‌ता छोड़ीन बीजा देस वाळा ने लुटे। <verse eid="EZK 22:29" /><verse number="30" style="v" sid="EZK 22:30" />में तीमनी मे गेथु एवु माणेह ने ह़ोदवा नु कर्‌यो जे वाड़ ने ह़ुदारे अने देस जुगु नाका पोर मारी अगळ आसम उबु हये के मने तीमने खत्‌तम नी करवा पड़े, पण एवु कोय नी जड़्‌यु। <verse eid="EZK 22:30" /><verse number="31" style="v" sid="EZK 22:31" />आहया कारण सी में तीमनी पोर मारी रीह नीकाळ्‌यो अने मारी रीह नु आक्‌ठु सी तीमने खत्‌तम कर नाखलो से; में तीमनी चाल ने तीमनात मुंडा पोर नाख देदो,” भगवान यहोवा आसमेत केय।<verse eid="EZK 22:31" /></para>
  <chapter eid="EZK 22" />
  <chapter number="23" style="c" sid="EZK 23" />
  <para style="s">बे छीनाळ्‌याण बेनेह</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 23:1" />यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 23:1" /><verse number="2" style="v" sid="EZK 23:2" />“ए माणेह नी अवल्‌यात,” बे बयर हती, “जे एकीत आय्‌ह नी सोरी हती। <verse eid="EZK 23:2" /><verse number="3" style="v" sid="EZK 23:3" />तीहयी नान्‌लीत हतीन रंडी नु काम मीस्‌र मे करवा बाज जी; तांत तीमनी छाती ने डाब्‌या अने तीहयी कुवारी नी री। <verse eid="EZK 23:3" /><verse number="4" style="v" sid="EZK 23:4" />तीहयी सोरी मे गेथु मोट्‌ली नु नाम ओहोला<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="fq" closed="false">ओहोला </char><char style="ft" closed="false">तीनो आसरो लेवा नो जागो</char></note> अने तीनी नान्‌ली बेनेह नु नाम ओहोलीबा<note caller="+" style="f"><char style="fr" closed="false">23:4 </char><char style="fq" closed="false">ओहोलीबा </char><char style="ft" closed="false">मारो आसरो लेवा नो जागो</char></note> हतु। में तीहयी बेम बेनेह ने आवरी लेदो, अने तीमना सोरा-सोरी पयदा हया। तीमना नामु नी अनसारे ओहोला ते सामरी, अने ओहोलीबा झुमायण्‌यु यरुसलेम से। <verse eid="EZK 23:4" /><verse number="5" style="v" sid="EZK 23:5" />ओहोला जत्‌यार मारी हती, तात छीनाळ्‌याण बणीन तीना दोस्‌तीदार्‌या भणीन मनवायवा बाज जी जे तीना ह़ाते वाळा अस्‌सुरी ईलाका ना हता। <verse eid="EZK 23:5" /><verse number="6" style="v" sid="EZK 23:6" />तीहया ते आखान-आखा नीळ्‌ळा लुगड़ा पेरवा वाळा मनगमता जुवान अदीकार्‌या अने मुख्‌या हता, अने घोड़ा पोर बहला हता। <verse eid="EZK 23:6" /><verse number="7" style="v" sid="EZK 23:7" />करीन तीहया तीमनीत ह़ाते छीनाळु कर्‌या जे आखान-आखा वारला सी वारला अस्‌सुरी हता; अने जे कोय भणीन बी तीहयी मनवायी तीमनात मुरत्‌या सी तीहयी वीटळी। <verse eid="EZK 23:7" /><verse number="8" style="v" sid="EZK 23:8" />जे छीनाळु तीहयी मीस्‌र मे ह़ीकली हती, तीने बी तीहयी नी छोड़ी; काहाके नान्‌ली हती ता माणहु तीनी ह़ाते गलत काम कर्‌या, अने तीनी छाती पोर हात फीरव्‌या, अने डील-मन सी तीमनी ह़ाते छीनाळु कर्‌या। <verse eid="EZK 23:8" /><verse number="9" style="v" sid="EZK 23:9" />करीन में तीने तीहयात अस्‌सुरी दोस्‌तीदर्‌या ने ह़ोप देदो जीमनी पोर तीहया मनवायला हता। <verse eid="EZK 23:9" /><verse number="10" style="v" sid="EZK 23:10" />तीहया तीने नांगरी कर्‌या; तीना सोरा-सोरी हापकीन तीने तलवार वेर मार्‌या; आहया कारण सी तीमना हात सी डंड हात करीन तीहयी बयरा मे नामह़ाद्‌याण हय जी।<verse eid="EZK 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 23:11" />“तीनी बेनेह ओहोलीबा आहयु देखी, ते बी तीहयी मनवाय्‌न छीनाळु करवा मे तीनी बेनेह सी जादा बड़ जी। <verse eid="EZK 23:11" /><verse number="12" style="v" sid="EZK 23:12" />तीहयी तीना अस्‌सुरी ह़ाते वाळा पोर मनवायती हती, अने आखान-आखा घणा घटाळा लुगड़ा पेरवा वाळा अने घोड़ा पोर बहण्‌या मनगमता, जुवान अदीकार्‌या अने आखा भातीन मुख्‌या हता। <verse eid="EZK 23:12" /><verse number="13" style="v" sid="EZK 23:13" />ता में देख्‌यो के तीहयी बी वीटळ जी; तीहयी बेम बेनेह नी ह़रकी चाल हती।<verse eid="EZK 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 23:14" />“पण ओहोलीबा जादा छीनाळु करे; अने जत्‌यार तीहयी दीवाल पोर ह़ींदुर वेर पाड़ला एवा कसदी अदमी ना चीत्‌रा देखी, <verse eid="EZK 23:14" /><verse number="15" style="v" sid="EZK 23:15" />जे केड़ मे फटका बांदीन, मुंडा मे छेड़ो टींगायली रंगाळी पागड़ी पेरीन, अने आखान-आखा आह़फाम नी पयदा हयली जागा मतलब बेबीलोन ना माणहु नी रीती पोर मुख्‌यान तेवा बणला हता, <verse eid="EZK 23:15" /><verse number="16" style="v" sid="EZK 23:16" />ता तीमने देखतेत तीमनी ह़ाते मनवाय ज्‌यु अने तीमनीन्‌तां कसदीम ना देस मे दुत मोकल्‌या। <verse eid="EZK 23:16" /><verse number="17" style="v" sid="EZK 23:17" />करीन बेबीलोन ना माणहु तीनीन्‌तां पलंग पोर आया, अने तीनी ह़ाते छीनाळु करीन तीने वीटाळ्‌या; अने जत्‌यार तीहयी तीमनी सी वीटळ जी, ता तीमनु मन भराय ज्‌यु अने सेटा हय ज्‌या। <verse eid="EZK 23:17" /><verse number="18" style="v" sid="EZK 23:18" />ते बी जत्‌यार तीहयी डील उगाड़ती अने छीनाळु करती जी, ता मारु मन जेम तीनी बेनेह भणी गेथु फीर जेलु हतु, तेमेत तीनी भणी गेथु बी फीर ज्‌यु। <verse eid="EZK 23:18" /><verse number="19" style="v" sid="EZK 23:19" />ते बी तीहयी मीस्‌र देस ना आह़फी ना नान्‌ली हती तीहया दाड़ा ने फोम करीन जत्‌यार तीहयी रंडी नु काम करती हती, अळी जादा छीनाळु करती जी; <verse eid="EZK 23:19" /><verse number="20" style="v" sid="EZK 23:20" />अने एवा दोस्‌तीदार्‌या पोर मनवाय जी, जीमनु अंग गदड़ान तेवु, अने वीर्‌य घोड़ान तेवु हतु।” <verse eid="EZK 23:20" /><verse number="21" style="v" sid="EZK 23:21" />तु आहयी रीते तारा नान्‌ली हतीन करली तीहया टेमे ना मोट्‌ला पाप ने फोम करावे जत्‌यार मीस्‌री माणहु तारी छाती ने चमदता हता।<verse eid="EZK 23:21" /></para>
  <para style="s">नान्‌ली बेनेह ने भगवान नो डंड</para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 23:22" />“आहया कारण सी ए ओहोलीबा, भगवान यहोवा तने आसम केय: देख, में तारा दोस्‌तीदार्‌या ने भड़कावीन जीमनी सी तारु मन भराय ज्‌यु च्‌यारो-मेर तारी वीरोद मे ली आवही। <verse eid="EZK 23:22" /><verse number="23" style="v" sid="EZK 23:23" />मतलब बेबीलोन ना रेवा वाळा अने आखा कसदीम ने, पकोद, सो अने कोवा ना माणहु ने; अने तीमनी ह़ाते आखा अस्‌सुरीम ने लावही जे आखान-आखा घोड़ा पोर बहण्‌या, मनगमता जुवान अदीकार्‌या, अने कंय भाती ना डायला, मुख्‌या अने नामह़ाद्‌या अदमी से। <verse eid="EZK 23:23" /><verse number="24" style="v" sid="EZK 23:24" />तीहया माणहु हत्‌यार, घोड़ागाड्‌या, छेकड़ी-गाडी अने देस-देस ना माणहु ना टोळा लीन तारी पोर हमलो करहे; अने ढाळ अने भाला अने लुहड़ा नी टोपी पेरीन तारा वीरोद मे च्‌यारो-मेर हालर बणावहे; अने में तीमनात हात मे नीयाव नु काम ह़ोपही, अने तीहया आह़फा-आह़फाम ना नेम नी अनसारे तारो नीयाव करहे। <verse eid="EZK 23:24" /><verse number="25" style="v" sid="EZK 23:25" />में तारी पोर रीह करही, जीनी सी तीहया रीह भेळ तारी ह़ाते वेहवार करहे। तीहया तारा नखरा अने कांटा ने तोड़ लेहे, अने तारु जे बी बच रेहे तीने तलवार वेर मार नाखहे। तीहया तारा सोरा-सोर्‌या ने हापकी लीजहे, अने तारु जे बी बच रेहे, तीहयु आक्‌ठु मे धप जहे। <verse eid="EZK 23:25" /><verse number="26" style="v" sid="EZK 23:26" />तीहया तारा लुगड़ा नीकाळीन तारु घटाळु-घटाळु वजन हापकी ली जहे। <verse eid="EZK 23:26" /><verse number="27" style="v" sid="EZK 23:27" />आहयी रीते में तारो मोट्‌लो पाप अने जे रंडी नु काम तु मीस्‌र देस मे ह़ीकली हती, तीने बी तने छोड़ावही, आञे तक के तु तारा डोळा तीमनी भणीन नी फीरवे अने नी मीस्‌र देस ने अळी फोम करे।”<verse eid="EZK 23:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 23:28" />काहाके मालीक यहोवा तने आसम केय: “देख, में तने तीमना हात मे ह़ोपही जीमनी सी तु दुस्‌मनी राखे अने जीमनी सी तारु मन फीर जेलु से; <verse eid="EZK 23:28" /><verse number="29" style="v" sid="EZK 23:29" />अने तीहया तारी ह़ाते दुस्‌मनी सी वेहवार करहे, अने तारी आखी कमाय हापकी लेहे, अने तने नांगरली करीन छोड़ देहे, अने तारु डील ने उगाड़वा सी तारु छीनाळु अने मोट्‌लो पाप उजन्‌तो हय जहे। <verse eid="EZK 23:29" /><verse number="30" style="v" sid="EZK 23:30" />आहया काम तारी ह़ाते आनीन करते करहे काहाके तु बीजा राज्‌य नी पसळ छीनाळ्‌याण ने तेम हय जी, अने तीमना मुरत्‌या पुंजीन वीटळ जी। <verse eid="EZK 23:30" /><verse number="31" style="v" sid="EZK 23:31" />तु तारी बेनेह नी वाट पोर चाले; आहया कारण सी में तारा हात मे तीना कटवरान तेवो कटवरो आपही।”<verse eid="EZK 23:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 23:32" />मालीक यहोवा आसम केय:</para>
  <para style="q1" vid="EZK 23:32">“तारी बेनेह ना कटवरा मे गेथु तने पीवा पड़हे,</para>
  <para style="q2" vid="EZK 23:32">जे उंडो अने चवड़ो से; तारी हाही अने ठट्‌टा उड़ावहे,</para>
  <para style="q2" vid="EZK 23:32">काहाके तीहया कटवरा मे घणु ढेरकु ह़माय।<verse eid="EZK 23:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="EZK 23:33" />तु माण अने दुख मे छाक जही।</para>
  <para style="q2" vid="EZK 23:33">तु तारी बेनेह सामरी ना कटवरा ने,</para>
  <para style="q2" vid="EZK 23:33">मतलब वहराड़न्‌यु अने उजाड़ ने पीन छाक जही।<verse eid="EZK 23:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="EZK 23:34" />तीनी मे गेथी तु तेड़ो-तेड़ो पीही,</para>
  <para style="q2" vid="EZK 23:34">अने तीना ठीकरा ने बी चावही अने तारी छाती ने घाव लगाड़ही;</para>
  <para style="q2" vid="EZK 23:34">काहाके मेंत आसम केदलो से,</para>
  <para style="m" vid="EZK 23:34">मालीक यहोवा आसमेत केय।”<verse eid="EZK 23:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 23:35" />तु जे मने भुलाड़ नाखली से, अने तारु मोडु मारी भणी गेथु फीरवी लेदली से, “करीन हाव तु खुदेत आह़फी ना मोट्‌ला पाप अने छीनाळु नो भार उचल, मालीक यहोवा नो आहयोत बोल से।”<verse eid="EZK 23:35" /></para>
  <para style="s">बेम बेनेह ने भगवान नो डंड</para>
  <para style="p">
    <verse number="36" style="v" sid="EZK 23:36" />यहोवा मने केदो: “ए माणेह नी अवल्‌यात, ह़ु तु ओहोला अने ओहोलीबा नो नीयाव करही? ता अळतेण तीना आखा गलत काम तीने देखाड़ दे। <verse eid="EZK 23:36" /><verse number="37" style="v" sid="EZK 23:37" />काहाके तीहया छीनाळु करला से, अने तीमना हातु मे लोय लागलु से; तीहया आह़फाम ना मुरत्‌या ह़ाते छीनाळु कर्‌या, अने आह़फाम ना सोराम ने जे मारी सी पयदा हयला, तीहया मुरत्‌या अगळ खत्‌तम हयवा करीन बादा चड़ावला से। <verse eid="EZK 23:37" /><verse number="38" style="v" sid="EZK 23:38" />अळतेण तीहया मारी ह़ाते एवो वेहवार बी कर्‌या के तीनीत ह़ाते मारा चोखला जागा ने बी वीटाळ देदा अने मारा अराम ना दाड़ा ने वीटाळला से। <verse eid="EZK 23:38" /><verse number="39" style="v" sid="EZK 23:39" />तीहया आह़फाम ना सोराम ने तीमना मुरत्‌या अगळ बादा चड़ावीन तीहयात दाड़े मारा चोखला जागा ने वीटाळवा करीन तीनी मे भरायी। देख, तीहया आहया भाती नु काम मारा घोर नी मोय करला से।<verse eid="EZK 23:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="EZK 23:40" />“तीहया सेटा रीन अदमीम ने नेवतु आपीन बोलाया, अने तीहया आया बी। तीमनी जुगु तु उंगळीन, डोळा मे काजळ ह़ारीन, वजन पेरीन; <verse eid="EZK 23:40" /><verse number="41" style="v" sid="EZK 23:41" />घटाळी पलंग पोर बह री; अने तारी अगळ एक टेबल लागली हती, जीनी पोर तु मारु धुप अने तेल मेकलु हतु। <verse eid="EZK 23:41" /><verse number="42" style="v" sid="EZK 23:42" />ता तीनी ह़ाते बेफीकर्‌या माणहु नी भीड़ नी कचाट ह़मळाय पड़ी, अने तीहया ह़ुदला माणहु नी ह़ाते जंगल मे गेथा बोलावला दारकुट्‌टा माणहु बी हता; तीहया तीहयी बेम बेनेह ना हातु मे कामळ्‌या पेराया, अने तीमना मुंडा पोर घटाळ्‌ळा मुकुट मेक्‌या। <verse eid="EZK 23:42" /><verse number="43" style="v" sid="EZK 23:43" />ता जे छीनाळु करते-करते डायी हय जेली हती, तीना बारा में की उठ्‌यो, हाव ते तीहया तीनीत ह़ाते छीनाळु करहे। <verse eid="EZK 23:43" /><verse number="44" style="v" sid="EZK 23:44" />काहाके तीहया तीनीन्‌तां आसम ज्‌या जेम माणहु रंडीन्‌तां जाय। तेमेत तीहया ओहोला अने ओहोलीबा नाम ना मोट्‌ला पापी बयरान्‌तां ज्‌या। <verse eid="EZK 23:44" /><verse number="45" style="v" sid="EZK 23:45" />अने धरमी माणहु छीनाळ्‌याण अने हत्‌याराम नी लायक ओहोला अने ओहोलीबा नो नीयाव करे; काहाके तीहया छीनाळ्‌याण छे, अने तीमना हातु मे लोय लागलु से।” <verse eid="EZK 23:45" /><verse number="46" style="v" sid="EZK 23:46" />आहया कारण सी भगवान यहोवा आसम केय: “में एक भीड़ सी तीमनी पोर हमलो कराय्‌न तीमने आसम करही के तीहया काठी वेला मे फीरहे अने तीमने लुटहे। <verse eid="EZK 23:46" /><verse number="47" style="v" sid="EZK 23:47" />तीहयी भीड़ ना माणहु तीमने दगड़ाटहे तीमने तलवार वेर तोड़ नाखहे; ता तीहया तीमना सोरा-सोरी ने मारीन तीमना घोरु ने बी आक्‌ठु धपाड़ीन धपाड़ देहे। <verse eid="EZK 23:47" /><verse number="48" style="v" sid="EZK 23:48" />आहयी रीते में मोट्‌ला पाप ने देस मे गेथो सेटो करही, अने आखा बयरा ह़ीकापण हात करीन तमारीन तेवो मोटो पाप करवा सी बचीन रेहे। <verse eid="EZK 23:48" /><verse number="49" style="v" sid="EZK 23:49" />तमारो मोट्‌लो पाप तमारात मुंडे पड़हे; अने तमु पक्‌का तमारा मुरत्‌या ना पापु नो भार उचलहु; अने ता तमु जाण लेहु के में भगवान यहोवा से।”<verse eid="EZK 23:49" /></para>
  <chapter eid="EZK 23" />
  <chapter number="24" style="c" sid="EZK 24" />
  <para style="s">हांडलु नो दाखलो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 24:1" />नव्‌वा साल ना दहवा मयना ना दहवा दाड़े, यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 24:1" /><verse number="2" style="v" sid="EZK 24:2" />“ए माणेह नी अवल्‌यात,” आज नो दाड़ो लीखीन राख, काहाके आज नात दाड़े बेबीलोन नो राजा यरुसलेम ने घेरवी लेदलो से।<note caller="+" style="x"><char style="xo" closed="false">24:2 </char><char style="xt" closed="false"><ref loc="2KI 25:1">2 राजा 25:1</ref>; <ref loc="JER 52:4">यीरम्‌या 52:4</ref></char></note> <verse eid="EZK 24:2" /><verse number="3" style="v" sid="EZK 24:3" />आहया बक-बक करवा वाळा घोराणा ने आहयो दाखलो के; मालीक यहोवा केय: हांडलु ने आक्‌ठु पोर मेक देवो; तीने मेकीन तीनी मे पाणी नाख देवो; <verse eid="EZK 24:3" /><verse number="4" style="v" sid="EZK 24:4" />ता तीनी मे ह़ातळ्‌या, खांदा अने आखा वारला-वारला टुकड़ा एक्‌ठा करीन मेको; अने हांडलु मे वारला-वारला हाटका वेर भर देवो। <verse eid="EZK 24:4" /><verse number="5" style="v" sid="EZK 24:5" />टोळा मे गेथा आखा सी वारु जानवरु ने लीन तीहया हाटका ने हांडलु नी तळे ढेर करो; अने तीमने वारु चड़ावो के तीनी मोय ना हाटका बी वारु चड़ जाय। <verse eid="EZK 24:5" /><verse number="6" style="v" sid="EZK 24:6" />“करीन मालीक यहोवा आसम केय: गरा आय पड़े, तीहयु हत्‌यारु ह़ेर पोर! गरा आय पड़े तीहयु हांडलु पोर! जीनो जंग तीनी मे बणलो से अने छुट्‌यो नी; तीनी मे गेथो टुकड़ा-टुकड़ा करीन नीकाळ लेवो, तीनी जुगु चीट्‌ठी नी जरवत नी हय। <verse eid="EZK 24:6" /><verse number="7" style="v" sid="EZK 24:7" />काहाके तीहया ह़ेर मे करली हत्‌या तीनी मे से; तीहयु तीने धरती पोर नाखीन कादा वेर नी ढाक्‌यु, पण उगाड़ला चाफर्‌या पोर मेक देदु। <verse eid="EZK 24:7" /><verse number="8" style="v" sid="EZK 24:8" />करीन में बी तीनु लोय उगाड़ला चाफर्‌या पोर रेचवलो से के तीहयु ढकाय नी सके अळी के बदलो लेवा करीन रीह भड़के। <verse eid="EZK 24:8" /><verse number="9" style="v" sid="EZK 24:9" />मालीक यहोवा आसम केय: गरा आय पड़े तीहयु हत्‌यारु ह़ेर पोर! में बी ढेर ने मोटो करही। <verse eid="EZK 24:9" /><verse number="10" style="v" sid="EZK 24:10" />अने जादा लाकड़ा नाखीन, आक्‌ठु ने जादा करीन, मांह ने वारु चड़ावो अने मसालो भेसको, अने हाकटा बी धपाड़ देवो। <verse eid="EZK 24:10" /><verse number="11" style="v" sid="EZK 24:11" />ता हांडलु ने ठारलु करीन ईंगाळा पोर मेक जीनी सी तीहयु उनु हये अने तीनु पीतळ धपे अने तीनी मे नो मोळ ओगळे, अने तीनो जंग खत्‌तम हय जाय। <verse eid="EZK 24:11" /><verse number="12" style="v" sid="EZK 24:12" />में तीना कारण सी मेहनत करते-करते थाक ज्‌यो, पण तीनी भारी जंग तीनी सी छुटती नी, तीनी जंग आक्‌ठु नी लारे बी नी छुटती। <verse eid="EZK 24:12" /><verse number="13" style="v" sid="EZK 24:13" />ए यरुसलेम ह़ेर तारु वीटळ्‌ळु मोट्‌ला पाप नु से. में ते तने चोखु करवा हींडतो हतो, पण तु चोखु नी हयु, करीन जत्‌यार तक में मारी रीह कम नी कर लेय, तांह तक तु चोखु नी हये। <verse eid="EZK 24:13" /><verse number="14" style="v" sid="EZK 24:14" />में यहोवात आहयु केदलो से; अने तीहयु हय जहे; में आसमेत करही, में तने नी छोड़ु, अने नी तारी पोर दया करु, नी पसताम; तारी चाल-चलण अने कामु नीत अनसारे तारो नीयाव हयहे, मालीक यहोवा आसमेत केय।”<verse eid="EZK 24:14" /></para>
  <para style="s">यहेजकेल नी लाडी नु मरनु</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 24:15" />यहोवा नो आहयो बोल बी मारीन्‌तां पुग्‌यो: <verse eid="EZK 24:15" /><verse number="16" style="v" sid="EZK 24:16" />“ए माणेह नी अवल्‌यात, देख, में तारा डोळा नी मोंगाळ्‌ळी चीज ने मारीन तारी पांह गेथी ली लेवा पोर से; पण तु नी रड़जे अने दुखी हयजे, अने नी आंहवा पाड़जे। <verse eid="EZK 24:16" /><verse number="17" style="v" sid="EZK 24:17" />डहका ते ली लेय, पण तीहया ह़मळायवा नी जोवे; मरला जुगु बी दुखी नी हयहे। मुंडे पागड़ी बांदीन अने पोगे खाहड़ा पेरीन रेजे; अने नी ते आह़फा ना होट्‌या ने डाबजे नी दुखीन तेम रोट्‌लो खाजे।” <verse eid="EZK 24:17" /><verse number="18" style="v" sid="EZK 24:18" />ता में ह़वारे माणहु ने केदो, अने ह़ांती मारी लाडी मर जी। ता ह़वारे में हुकम नी अनसारे कर्‌यो। <verse eid="EZK 24:18" /><verse number="19" style="v" sid="EZK 24:19" />ता माणहु मने केवा बाज ज्‌या, “ह़ु तु आमने नी देखाड़े के आहयु जे तु करे, तीनु अमारी जुगु ह़ु मतलब से?”<verse eid="EZK 24:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 24:20" />में तीमने जपाप आप्‌यो, “यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 24:20" /><verse number="21" style="v" sid="EZK 24:21" />तु ईस्‌रायल ना घोराणा ने के, मालीक यहोवा आसम केय: देखो, में मारा चोखला जागा ने जीने कीलो बणवा सी तमु खुस हयो; अने जे तमारा डोळा ने गमण्‌यु से, अने जे तमारु मन ने गमे, तीने में वीटाळवा पोर से; अने मारात सोरा-सोरी ने तमु तीमने तां मेक आवला से, तीमने तलवार वेर मार नाखहे। <verse eid="EZK 24:21" /><verse number="22" style="v" sid="EZK 24:22" />जेम में करलो से तेमेत तमु बी करहु; तमु बी तमारा होट्‌या नी ढाको, अने नी दुखीन तेम रोट्‌लो खावो। <verse eid="EZK 24:22" /><verse number="23" style="v" sid="EZK 24:23" />तमु मुंडे पागड़ी बांदीन अने पोग मे खाहड़ा पेरीन रेहु, नी तमु रड़ो, नी छाती ठोको, पण आह़फाम ना अधरम ना काम मे फसला गळता जहु अने एक-बीजा भणीन कंजारता रेहु। <verse eid="EZK 24:23" /><verse number="24" style="v" sid="EZK 24:24" />आहयी रीते यहेजकेल तमारी जुगु सेलाणी ठेरहे; जेम तीहयो कर्‌यो, तेमेत तमु बी करहु। जत्‌यार आहयु हय जाय, ता तमु जाण लेहु के में भगवान यहोवा से।”<verse eid="EZK 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 24:25" />“ए माणेह नी अवल्‌यात, ह़ु आहयु ह़ाचली नी हय, के जे दाड़े में तीमनो मजबुत कीलो, जे तीमनी ह़ोबा, अने तीमनी खुसी नो कारण से, अने तीमना सोरा-सोरी जे तीमनी ह़ोबा, तीमना डोळा नो आनन्‌द, अने मन ने गमण्‌या से, तीमने मे हापकी लेही, <verse eid="EZK 24:25" /><verse number="26" style="v" sid="EZK 24:26" />तीहयात दाड़े जे नाहीन बच जहे, तीहयु तारीन्‌तां आवीन तने खबर ह़मळावहे। <verse eid="EZK 24:26" /><verse number="27" style="v" sid="EZK 24:27" />तीहयात दाड़े तारु मोडु उगड़ी जहे, अने तु होगो नी रेय पण तु तीहया बचला माणेह ह़ाते वात करही। आहयी रीते तु आहया माणहु जुगु सेलाणी ठेरही; अने आहया जाण लेहे के में यहोवा से।”<verse eid="EZK 24:27" /></para>
  <chapter eid="EZK 24" />
  <chapter number="25" style="c" sid="EZK 25" />
  <para style="s">अम्‌मोनीम ना वीरोद मे भगवान वगे गेथी वात</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 25:1" />यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 25:1" /><verse number="2" style="v" sid="EZK 25:2" />“ए माणेह नी अवल्‌यात, अम्‌मोनीयोम नी भणी मोडु करीन तीमना बारा मे भगवान वगे गेथी वात के। <verse eid="EZK 25:2" /><verse number="3" style="v" sid="EZK 25:3" />तीमने के, ए अम्‌मोनी, भगवान नो बोल ह़मळो, भगवान यहोवा आसम केय के तमु जे मारा चोखला जागा ने वीटाळ्‌या, अने ईस्‌रायल नु देस जत्‌यार तीहयु उजड़ ज्‌यु, अने यहुदा ना घोराणा ना बारा मे जत्‌यार तीहया गुलामी मे ज्‌या, ता अहा! अहा! केदा। <verse eid="EZK 25:3" /><verse number="4" style="v" sid="EZK 25:4" />करीन देखो, में तमने उगवणु देस ना माणहु ना हक मे करवा वाळो से; अने तीहया तारी वच मे तीमना पड़ावा नाखहे अने तीमना घोर बणावहे; तीहया तारा फोळ खाहे अने तारु दुद पीहे। <verse eid="EZK 25:4" /><verse number="5" style="v" sid="EZK 25:5" />में रब्‌बा ह़ेर ने उटड़ा नो रेवा नो, अने अम्‌मोनीम नु देस ने गाडरा-बोकड़ान बहवा नो जागो बणाय देही; ता तमु जाण लेहु के में यहोवा से। <verse eid="EZK 25:5" /><verse number="6" style="v" sid="EZK 25:6" />काहाके भगवान यहोवा आसम केय: तमु जे ईस्‌रायल ना देस ना कारण सी थापड़्‌या ठोक्‌या अने नाच्‌या, अने तमारा पुरा मन ना घमंड सी खुसी मनाया, <verse eid="EZK 25:6" /><verse number="7" style="v" sid="EZK 25:7" />आहया कारण सी देख, में मारो हात तारी पोर बड़ावलो से; अने तने राज्‌य-राज्‌य नी लुट बणाय देही, अने देस-देस ना माणहु मे गेथो तने मीटाड़ही; अने देस-देस मे गेथा खत्‌तम करही। में तने पुरी रीती सी खत्‌तम कर देही; ता तु जाण लेही के में यहोवा से।<verse eid="EZK 25:7" /></para>
  <para style="s">मोवाब ना बारा मे भगवान वगे गेथी वात</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 25:8" />“भगवान यहोवा आसम केय: मोवाब अने सेईर देस ना माणहु जे आसम केय, देखो, यहुदा नु घोराणु अळी बीजा आखा राज्‌य ह़रकु हय जेलु से। <verse eid="EZK 25:8" /><verse number="9" style="v" sid="EZK 25:9" />आहया कारण सी देख, मोवाब ना देस नी धेड़े ना ह़ेरु ने बेत्‌यसीमोत, बालमोन, अने कीर्‌यातेम, जे तीहया देस नी बड़ाय से, में तीमनी वाट उगाड़ीन <verse eid="EZK 25:9" /><verse number="10" style="v" sid="EZK 25:10" />तीमने उगवणा देस ना माणहु ना हक मे आसम कर देही के तीहया अम्‌मोनीम नी ह़ाते झगड़ो करे; अने में अम्‌मोनीम ने आसम तीमना हक मे कर देही के राज्‌य-राज्‌य नी वच मे तीमनी फोम तक नी करे। <verse eid="EZK 25:10" /><verse number="11" style="v" sid="EZK 25:11" />में मोवाब ने बी डंड आपही। ता तीहया जाण लेहे के में यहोवा से।<verse eid="EZK 25:11" /></para>
  <para style="s">एदोम ना वीरोद मे भगवान वगे गेथी वात</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 25:12" />“भगवान यहोवा आसम बी केय: एदोम जे यहुदा ना घोराणा सी बदलो लेदु, अने तीनी सी बदलो लीन जादा गुनाळ्‌ळु हय ज्‌यु। <verse eid="EZK 25:12" /><verse number="13" style="v" sid="EZK 25:13" />करीन भगवान यहोवा आसम केय, में एदोम ना देस ना वीरोद मे मारो हात बड़ावीन तीनी मे गेथा माणहु अने जानवरु बेम ने मीटाड़ही; अने तेमान ह़ेर गेथो लगाड़ीन ददान ह़ेर तक तीने उजाड़ देही; अने तीमने तलवार वेर मारहे। <verse eid="EZK 25:13" /><verse number="14" style="v" sid="EZK 25:14" />में मारा माणहु ईस्‌रायल नी लारे एदोम सी मारो बदलो लेही; अने तीहया ते देस मे मारी रीह अने खीज नी अनसारे काम करहे। ता तीहया मारा बदला ने जाण लेहे, भगवान यहोवा आसमेत केय।<verse eid="EZK 25:14" /></para>
  <para style="s">पलीस्‌तीम ना वीरोद मे भगवान वगे गेथी वात</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 25:15" />“भगवान यहोवा आसम केय: काहाके पलीस्‌ती माणहु बदलो लेदा, अने जलमकी दुस्‌मनी का कारण सी आह़फाम ना मन ना घमंड सी बदलो लेदा के खत्‌तम करे,<note caller="+" style="x"><char style="xo" closed="false">25:15 </char><char style="xt" closed="false"><ref loc="ISA 14:29-31">यसाया 14:29-31</ref>; <ref loc="JER 1">यीरम्‌या 1</ref></char></note> <verse eid="EZK 25:15" /><verse number="16" style="v" sid="EZK 25:16" />आहया कारण सी भगवान यहोवा आसम केय, देख, में पलीस्‌तीम ना वीरोद मे मारो हात बड़ाव्‌वा वाळो से, अने करेती माणहु ने मीटाड़ देही; अने दर्‌या ना काठे बचला रेवा वाळा ने खत्‌तम करही। <verse eid="EZK 25:16" /><verse number="17" style="v" sid="EZK 25:17" />मे तीमने मोटो डंड आपही। रीह भेळ में तीमनी पांह बदलो लेही, ता तीहया जाण लेहे के मेंत यहोवा से।”<verse eid="EZK 25:17" /></para>
  <chapter eid="EZK 25" />
  <chapter number="26" style="c" sid="EZK 26" />
  <para style="s">सोर ह़ेर ना वीरोद मे भगवान वगे गेथी वात</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 26:1" />ग्‌यारवा साल ना पेल्‌ला मयना ना पेल्‌ला दाड़े यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 26:1" /><verse number="2" style="v" sid="EZK 26:2" />“ए माणेह नी अवल्‌यात,” सोर ह़ेर जे यरुसलेम ना बारा मे आसम केदलु से, ओहोय! ओहोय! जे देस-देस ना माणहु ना झापलान तेवु हतु, तीहयु खत्‌तम हय ज्‌यु! तीनी उजड़ जवा सी में भर-पुर हय जही।<verse eid="EZK 26:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 26:3" />आहया कारण सी भगवान यहोवा आसम केय: ए सोर ह़ेर, देख, में तारा वीरोद मे से; अने आसम करही के घणा ढेरका राज्‌य तारा वीरोद मे आसम उठहे जेम दर्‌या नी लेहर उठे। <verse eid="EZK 26:3" /><verse number="4" style="v" sid="EZK 26:4" />तीहया सोर नु भीतड़ु ने ओदारहे, अने तीना उचा गुम्‌मट ने तोड़ देहे; अने में तीनी पोर गेथो तीनो कादो खुरचीन तीने मानो नांगरला चाफर्‌या बणाय देही। <verse eid="EZK 26:4" /><verse number="5" style="v" sid="EZK 26:5" />तीहयु दर्‌या नी वच मे जाळ फेलाव्‌वा वाळी जागा बण जहे; काहाके भगवान यहोवा आसमेत केय, अने तीने राज्‌य-राज्‌य लुट लेहे; <verse eid="EZK 26:5" /><verse number="6" style="v" sid="EZK 26:6" />अने तीना जे सोर्‌या मेदान मे से, तीने तलवार वेर मारहे। ता तीहया जाण लेहे के में यहोवा से।<verse eid="EZK 26:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 26:7" />“काहाके भगवान यहोवा आहयु केय: देख, में सोर ह़ेर ना वीरोद मे आखा सी वारला राजा मतलब बेबीलोन ना राजा नबुकदनेस्‌सर ने घोड़ा, घोड़ागाड्‌या, घोड़ा पोर बहण्‌या, मोट्‌ली भीड़, अने टोळा भेळ धुराव भणीन गेथो लावही। <verse eid="EZK 26:7" /><verse number="8" style="v" sid="EZK 26:8" />तारा जे सोर्‌या मेदान मे हय, तीमने तीहयो तलवार वेर मारहे, तीहया तारा वीरोद मे घेराबन्‌दी नी दीवाल बणावहे अने हालर बांदहे; अने ढाळ उचलहे। <verse eid="EZK 26:8" /><verse number="9" style="v" sid="EZK 26:9" />तीहयो तारु भीतड़ु ने तोड़वा करीन झुमायवा ना हत्‌यार वेर देहे अने तारा गुम्‌मटु ने फरसा वेर ओदार देहे। <verse eid="EZK 26:9" /><verse number="10" style="v" sid="EZK 26:10" />तीना घोड़ा एतरा रेहे, के तु तीना सरड़ा मे ढकाय जही, अने जत्‌यार तीहयो तारा झापले आसम भरायहे जेम माणहु नाका वाळा ह़ेर मे भराय, ता तारी दीवाल घोड़ा पोर बहण्‌या, अने छेकड़ा गाडा, अने घोड़ागाड्‌या नी अवाज सी काप उठहे। <verse eid="EZK 26:10" /><verse number="11" style="v" sid="EZK 26:11" />तीहयो तीना घोड़ा ना टापरा वेर तारी आखी ह़ड़क ने रोंदळी देहे, अने तारी मे रेवा वाळा ने तलवार वेर मार नाखहे, अने तारा ताखत वाळा खम्‌बा भोयमे पाड़ देहे। <verse eid="EZK 26:11" /><verse number="12" style="v" sid="EZK 26:12" />माणहु तारु धन लुटहे अने तारा वेपारी नु ह़मान हापक लेहे; तीहया तारी दीवाल ने ओदार देहे अने तारु घटाळ्‌ळु घोर ने ओदार देहे; तारा दगड़ा अने लाकड़ा, अने तारो कादो तीहया दर्‌या मे नाख देहे। <verse eid="EZK 26:12" /><verse number="13" style="v" sid="EZK 26:13" />में तारा गीतु ना रींग ने बंद करही, अने अळतेण तारा तम्‌बुरा नी अवाज अळी नी ह़मळाय। <verse eid="EZK 26:13" /><verse number="14" style="v" sid="EZK 26:14" />में तने नांगरला चाफर्‌या बणाय देही; तु जाळ फेलाव्‌वा वाळो जागोत बण जही, अने अळतेण सदा उजाड़ बणीन रेहे; काहाके में यहोवात आहयु केदलो से, भगवान यहोवा आसम केय।”<verse eid="EZK 26:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 26:15" />“भगवान यहोवा सोर ने आसम केय: तारी पड़वा नी अवाज सी जत्‌यार घाव लागला माणहु कंजारहे अने तारी मे मोतेत मोत हयहे, ता ह़ु टापु नी काप उठे? <verse eid="EZK 26:15" /><verse number="16" style="v" sid="EZK 26:16" />ता दर्‌या नी धेड़े ना देस ना आखा मुख्‌या माणहु आह़फा-आह़फाम नी राजगादी पोर गेथा उतरहे, अने आह़फाम ना राजा ना नाम्‌बला डगला अने हात वेर बणावला घटाळा करला लुगड़ा नीकाळीन थतरता जीन दुखी ना लुगड़ा पेरहे, अने भोयमे बहीन टेम-टेम पोर कापहे; अने तारा कारण सी वहरायहे। <verse eid="EZK 26:16" /><verse number="17" style="v" sid="EZK 26:17" />तीहया तारा बारा में दुख नु गीत बणाय्‌न तने केहे, ‘गरा आय पड़े! ढुंड्‌या चलाड़वा वाळा नु वहाड़लु गरा आय पड़े! नामह़ाद्‌याण ह़ेर जे दर्‌या नी वच मे रेवा वाळा भेळ ताखत वाळु र्‌यु अने आखा थांगवा वाळा ने बीहाड़वा वाळु ह़ेर हतु, तु केवु खत्‌तम हयलु से। <verse eid="EZK 26:17" /><verse number="18" style="v" sid="EZK 26:18" />तारा पड़वा ना दाड़े टापु काप उठहे, अने तने खत्‌तम हयवा ना कारण सी आखा टापु घबराय जहे।’<verse eid="EZK 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 26:19" />“काहाके भगवान यहोवा आसम केय: जत्‌यार में तने ह़ुनह़ान ह़ेर ने तेम उजाड़ करही अने में तारी पोर मोट्‌ली दर्‌या लावही, अने तु उंडला पाणी मे डुब जही, <verse eid="EZK 26:19" /><verse number="20" style="v" sid="EZK 26:20" />ता में खाडा मे अने पड़वा वाळा नी ह़ाते तने बी आड़ा-बुड़ा माणहु मे उतार देही; अने खाडा मे अने पड़वा वाळा नी ह़ाते मे तने बी पताळ मे मेकीन पेल्‌ना वारा ना उजड़ला जागान तेम कर देही; आञे तक के तु पासु नी वहे अने नी जीवाय ना जागा मे कोय जागो जड़े। <verse eid="EZK 26:20" /><verse number="21" style="v" sid="EZK 26:21" />में तने घबरायवा नो कारण बणावही, अने तु आव्‌वा वाळा दाड़ा मे नी रेय, ह़ोदवा पोर बी तारो पतो नी चाले, भगवान यहोवा आसमेत केय।”<verse eid="EZK 26:21" /></para>
  <chapter eid="EZK 26" />
  <chapter number="27" style="c" sid="EZK 27" />
  <para style="s">सोर ह़ेर जुगु दुख गीत</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 27:1" />यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 27:1" /><verse number="2" style="v" sid="EZK 27:2" />ए माणेह नी अवल्‌यात, सोर ना बारा मे एक दुख नु गीत बणाय्‌न तीने आहयु के, <verse eid="EZK 27:2" /><verse number="3" style="v" sid="EZK 27:3" />ए दर्‌या नी मोय भरायवान झापले रेवा वाळु, ए ढेरेत टापु जुगु देस-देस ना माणहु ह़ाते वेपार करवा वाळु, भगवान यहोवा आसम केय: ए सोर, तु केदलु से के तु खुद पुरुन पुरु घटाळु से। <verse eid="EZK 27:3" /><verse number="4" style="v" sid="EZK 27:4" />तारी काकड़ दर्‌या नी वच मे से; तारा बणाव्‌वा वाळा तने पुरुन पुरु घटाळ्‌ळु बणाया। <verse eid="EZK 27:4" /><verse number="5" style="v" sid="EZK 27:5" />तारा आखा पाट्‌या सनीर बड़ा ना सनोवर झाड़ ना लाकड़ा ना बणला से; तारा ढुंड्‌या चलाड़वा ना खुटा जुगु लबानोन ना देवदार नाम ना झाड़ ना लेदा। <verse eid="EZK 27:5" /><verse number="6" style="v" sid="EZK 27:6" />तारा डांडा बासान ना वांज्‌या झाड़ ना बणाया; तारा ढुंड्‌या नी छत कीत्‌तीयो ना टापु मे गेथा लावला ह़ुदला सनोवर नाम ना झाड़ ना हाती ना दात बहाड़ला लाकड़ा ना बणाया। <verse eid="EZK 27:6" /><verse number="7" style="v" sid="EZK 27:7" />तारा ढुंड्‌या नी पाल मीस्‌र मे गेथा लावला, हात वेर बणावला घटाळा सुती लुगड़ा ना बणाया के तारी जुगु झंडा नु काम करे; तारी चांदनी<note caller="+" style="f"><char style="fr" closed="false">27:7 </char><char style="fq" closed="false">चांदनी </char><char style="ft" closed="false">छाहळो करवा नु घटाळु करलु कापड़ु</char></note> एलीसा ना टापु मे गेथा लावला नीळ्‌ळा अने जामण्‌या रंग ना लुगड़ा नी बणायी। <verse eid="EZK 27:7" /><verse number="8" style="v" sid="EZK 27:8" />तारा ढुंड्‌या चलाड़वा वाळा सीदोन अने अर्‌वद ह़ेर ना रेवा वाळा से; ए सोर, तारीत वच मे ना अक्‌कल वाळा माणहु तारा ढुंड्‌या चलाड़वा वाळा हता। <verse eid="EZK 27:8" /><verse number="9" style="v" sid="EZK 27:9" />तारा कारीगर जोड़ाय करवा वाळा गबल ह़ेर ना डायला अने अक्‌कल वाळा माणहु हता; तारी मे वेपार करवा करीन ढुंड्‌या चलाड़वा वाळा भेळ दर्‌या पोर ना आखा ढुंड्‌या तारी मे आय जेला हता। <verse eid="EZK 27:9" /><verse number="10" style="v" sid="EZK 27:10" />तारी सेना मे फारसी, लुदी, अने पुत देस ना माणहु भरती हयला हता; तीहया तारी मे ढाळ, अने टोपी टांग्‌या; अने तीमनात कारण सी बड़ाय हयली से। <verse eid="EZK 27:10" /><verse number="11" style="v" sid="EZK 27:11" />तारु भीतड़ु पोर तारी सेना नी ह़ाते अर्‌वद ह़ेर ना माणहु च्‌यारो-मेर हता; अने तारा गुम्‌मट मे वारला झुमायण्‌या उबा हता; तीहया तीमनी ढाळ ने तारी च्‌यारो-मेर नु भीतड़ु पोर टांगला हता; तीमना कारण सी तु पुरु घटाळ्‌ळु हयलु हतु।<verse eid="EZK 27:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 27:12" />तारु आखु भाती नु धन-दवल्‌यत घणु रेवा ना कारण सी तर्‌सीसी माणहु तारा वेपारी हता; तीहया चांदी, लुगड़ु, रांगा अने ह़ीह़ा आपीन तारो माल वेचातो लेदा। <verse eid="EZK 27:12" /><verse number="13" style="v" sid="EZK 27:13" />यावान, तुबल, अने मेसेक देस ना माणहु तारा माल ना बदले पावर्‌या-पावर्‌याण अने पीतळ ना ठाहरा आपता हता। <verse eid="EZK 27:13" /><verse number="14" style="v" sid="EZK 27:14" />तोगर्‌मा ना घोराणा ना माणहु तारु धन-दवल्‌यत लीन, घोड़ा, बहीन जवा ना घोड़ा, अने खच्‌चर घोड़ो आप्‌या। <verse eid="EZK 27:14" /><verse number="15" style="v" sid="EZK 27:15" />ददान ह़ेर ना तारा वेपारी हता; ढेरेत टापु तारा हाट बण्‌या; तीहया तारी पांह हाती ना दात अने आबनुस नाम ना झाड़ ना लाकड़ा वेपार मे लावता हता। <verse eid="EZK 27:15" /><verse number="16" style="v" sid="EZK 27:16" />तारी घणी करीगरी ना कारण सी अराम तारो वेपारी हतो; मरकत मणी, जामण्‌या रंग नु अने हात वेर बणावलु घटाळु करलु कापड़ु, सुती, मुंगा नाम नी चीज, अने लालड़ी आपीन तारो माल लेता हता। <verse eid="EZK 27:16" /><verse number="17" style="v" sid="EZK 27:17" />यहुदा अने ईस्‌रायल बी तारा वेपारी हता; तीहया मीन्‌नीत ना गम, अंजीर, मोद, तेल अने बलसान आपीन तारो माल लेदला से। <verse eid="EZK 27:17" /><verse number="18" style="v" sid="EZK 27:18" />तारी मे घणी कारीगरी हयी अने आखी भाती नु धन-दवल्‌यत एक्‌ठु हयु, आनी सी दमीस्‌क तारु वेपारी बण्‌यु; तारीन्‌तां हेलबोन ह़ेर नु ह़रु अने धोळु-बग हीर पुगाड़्‌या। <verse eid="EZK 27:18" /><verse number="19" style="v" sid="EZK 27:19" />वदान अने यावान ह़ेर ना माणहु तारा माल ना बदला मे सुत आप्‌या; अने तीमना बदले फोलाद तजपान्‌टा अने अगर नाम नो मसालो बी आपता हता। <verse eid="EZK 27:19" /><verse number="20" style="v" sid="EZK 27:20" />बहवा नी काठी जुगु ददान तारु वेपारी बण्‌यु। <verse eid="EZK 27:20" /><verse number="21" style="v" sid="EZK 27:21" />अरब अने केदार ना आखा मुख्‌या तारा वेपारी ठेर्‌या; तीहया गाडरा ना बच्‌चा, गाडरा अने बोकड़ा लावीन तारी ह़ाते लेन-देन कर्‌या। <verse eid="EZK 27:21" /><verse number="22" style="v" sid="EZK 27:22" />सबा अने रामाह ह़ेर ना वेपारी बी तारी ह़ाते वेपार करता हता; तीहया वारला-वारला भाती ना वारला मसाला, आखी भाती ना मणी अने ह़ोनु आपीन तारो माल लेदा। <verse eid="EZK 27:22" /><verse number="23" style="v" sid="EZK 27:23" />हारान, कन्‌ने, एदेन, सबा ना वेपारी, अने अस्‌सुर अने कलमद ह़ेर आहया आखा तारा वेपारी बण्‌या। <verse eid="EZK 27:23" /><verse number="24" style="v" sid="EZK 27:24" />तीहया वारली-वारली चीज मतलब ओडवा ना नीळ्‌ळा अने हात वेर बणावला घटाळा करला लुगड़ा अने दोर्‌या वेर बांदली अने देवदार ना बणला चीत्‌रा-रंगाळा कापड़ा ना पेट्‌या लावीन तारी ह़ाते लेण-देण कर्‌या। <verse eid="EZK 27:24" /><verse number="25" style="v" sid="EZK 27:25" />तर्‌सीस ना ढुंड्‌या तारा वेपार ना माल ने वयवा वाळा बण्‌या। “तीमनी लारे तु दर्‌या नी वच मे रीन घणु पोमतु अने बड़ाय वाळु हय ज्‌यु। <verse eid="EZK 27:25" /><verse number="26" style="v" sid="EZK 27:26" />तारा ढुंड्‌या चलाड़वा वाळा तने उंडला पाणी मे पुगाड़ देदला से, अने उगवणु नु वाहळु तने दर्‌या नी वच मे तोड़ नाखलु से। <verse eid="EZK 27:26" /><verse number="27" style="v" sid="EZK 27:27" />जे दाड़े तु डुबही, तीहयात दाड़े तारु धन-दवल्‌यत, वेपार नो माल, ढुंड्‌या वाळा, ढुंड्‌या चलाड़वा वाळा, जोड़ाय नु काम करवा वाळा, वेपारी माणहु, अने तारी मे जेतरा सीपायड़ा से, अने तारा आखा टोळा दर्‌या नी वच मे पड़ जहे। <verse eid="EZK 27:27" /><verse number="28" style="v" sid="EZK 27:28" />तारा ढुंड्‌या वाळा नी आड़वा नी अवाज ना कारण सी तारी आड़े-धेड़े नी जागा काप उठहे। <verse eid="EZK 27:28" /><verse number="29" style="v" sid="EZK 27:29" />आखा ढुंड्‌या चलाड़वा वाळा मल्‌लाह, अने दर्‌या मे जेतरा ढुंड्‌या वाळा रेय, तीहया आह़फा-आह़फाम ना ढुंड्‌या पोर गेथा उतरहे। <verse eid="EZK 27:29" /><verse number="30" style="v" sid="EZK 27:30" />अने तीहया धरती पोर उबा हय्‌न तारा बारा मे उची अवाज सी कलपी-कलपीन रड़हे। तीहया आह़फा-आह़फाम ना मुंडा पोर कादो नाखीन रोखड़ा मे ढबळहे; <verse eid="EZK 27:30" /><verse number="31" style="v" sid="EZK 27:31" />अने तारा दुख मे आह़फाम ना मुंडा बोड़ाय देहे, अने केड़्‌ये गोंटो बांदीन तीमना मन ना घणा दुख भेळ तारी जुगु रड़हे अने छाती ठोकहे। <verse eid="EZK 27:31" /><verse number="32" style="v" sid="EZK 27:32" />तीहया दुखी हयता जीन तारा बारा मे दुख नु आहयु गीत बणाय्‌न गावहे: ‘सोर ह़ेर जे हाव दर्‌या नी वच मे होगुथीन पड़ र्‌यु, तीनीन तेवु कानु ह़ेर से? <verse eid="EZK 27:32" /><verse number="33" style="v" sid="EZK 27:33" />जत्‌यार तारो माल दर्‌या मे गेथो नीकळतो हतो, ता ढेरेत राज्‌य आफरता हता; तारु धन अने वेपार नो माल घण-जादा हयवा सी धरती ना राजा पोमता हयता हता। <verse eid="EZK 27:33" /><verse number="34" style="v" sid="EZK 27:34" />जे टेमे तु तळ वगर नी दर्‌या मे लेहर वेर टुट्‌यु, तीहयी टेमे तारा वेपारु नो माल, अने तारा आखा रेवा वाळा बी तारी मोय रीन खत्‌तम हय ज्‌या। <verse eid="EZK 27:34" /><verse number="35" style="v" sid="EZK 27:35" />दर्‌या नी काठे देसु ना आखा रेवा वाळा तारा कारण सी वहराय ज्‌या; अने तीमना आखा राजाम ना नेहटा उबा हय ज्‌या, अने तीमना मोडा पोर बीक छवाय जी। <verse eid="EZK 27:35" /><verse number="36" style="v" sid="EZK 27:36" />देस-देस ना वेपारी तारा वीरोद मे तारा बारा मे भलु-बुरु की र्‌या; तु बीक नु कारण बण जेलु से अने अळतेण तु टेकलु नी री सके।’”<verse eid="EZK 27:36" /></para>
  <chapter eid="EZK 27" />
  <chapter number="28" style="c" sid="EZK 28" />
  <para style="s">सोर ह़ेर ना राजा ना वीरोद मे भगवान वगे गेथी वात</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 28:1" />यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 28:1" /><verse number="2" style="v" sid="EZK 28:2" />“ए माणेह नी अवल्‌यात, सोर ह़ेर ना मुख्‌या ने के, भगवान यहोवा आसम केय: तु मन मे घमंड करीन आहयु केदलो से, ‘में भगवान से, मे दर्‌या नी वच मे भगवान नी जागा पोर बह र्‌यो,’ पण कदीम तु आह़फा ने भगवान ने तेवो देखाड़े, ते बी तु भगवान नी, पण माणेहेत से। <verse eid="EZK 28:2" /><verse number="3" style="v" sid="EZK 28:3" />तु दानीयल सी जादा अक्‌कल वाळो ते से; कोय बी वात तारी सी ह़तायली नी हहे; <verse eid="EZK 28:3" /><verse number="4" style="v" sid="EZK 28:4" />तु तारी अक्‌कल अने ह़मज नी लारे धन हात कर्‌यो, अने तारा ह़मान ना ह़मान मेकवा ना गोदाम मे ह़ोनु-चांदी मेकलो से; <verse eid="EZK 28:4" /><verse number="5" style="v" sid="EZK 28:5" />तु घणी अक्‌कल सी लेण-देण कर्‌यो जीनी सी तारु धन बड़्‌यु, अने धन ना कारण सी तारु मन घमंड सी भराय जेलु से। <verse eid="EZK 28:5" /><verse number="6" style="v" sid="EZK 28:6" />करीन भगवान यहोवा आसम केय: तु जे आह़फा नु मन भगवान ने तेवु देखाड़े, <verse eid="EZK 28:6" /><verse number="7" style="v" sid="EZK 28:7" />करीन देख, में तारी पोर एवा बीजा देस वाळा सी हमलो करावही, जे आखा राज्‌य गेथा वण-दयाळ्‌ळा से, तीहया तारु घटाळ्‌ळु अने अक्‌कल ना वीरोद मे तीमनी तलवार नीकाळहे अने तारी चमकत्‌ली ह़ोबा ने रीवण्‌या-तीवण्‌या कर देहे। <verse eid="EZK 28:7" /><verse number="8" style="v" sid="EZK 28:8" />तीहया तने मोत ना खाडा मे उतारहे, अने तु दर्‌या मे मारला नी रीते मर जही। <verse eid="EZK 28:8" /><verse number="9" style="v" sid="EZK 28:9" />ता, ह़ु तु तने मारवा वाळा नी अगळ केतो रेही, ‘में भगवान से?’ तु तारा हत्‌यारा ना हात मे भगवान नी, पण माणेहेत ठेरही। <verse eid="EZK 28:9" /><verse number="10" style="v" sid="EZK 28:10" />तु बीजा देस वाळा ना हात सी खतना वगर ना माणहुन तेम मर जही; काहाके मेंत आसम केदलो से, भगवान यहोवा आसम केय।”<verse eid="EZK 28:10" /></para>
  <para style="s">सोर ना राजा नु खत्‌तम हयणु</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 28:11" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 28:11" /><verse number="12" style="v" sid="EZK 28:12" />“ए माणेह नी अवल्‌यात, सोर ह़ेर ना राजा ना बारा मे दुख नु गीत बणाय्‌न तीने के; भगवान यहोवा आसम केय: तु ते वारु सी बी वारु से; तु अक्‌कल सी पुरो भरायलो अने आखा सी घटाळो से। <verse eid="EZK 28:12" /><verse number="13" style="v" sid="EZK 28:13" />तु भगवान नी अदन नाम नी वाड़ी मे हतो; तारी पांह पेरवा नु ह़मान, माणीक्‌य मणी, पद्‌मराग मणी, हीरो, फीरोजा मणी, सुलेमानी मणी, यसब मणी, नीलमणी, मरकद मणी, अने रात्‌ली मणी आखी भाती ना मण्‌या अने ह़ोना ना पेरावा हता; तारा डफ अने पाहळ्‌या तारीत मे बणावला हता; जे दाड़े तने बणाया, तीहया दाड़े तीमने बी तीयार करला हता। <verse eid="EZK 28:13" /><verse number="14" style="v" sid="EZK 28:14" />में तारी रखवाळी करवा करीन वहराड़ देवा वाळो ह़रगदुत टाळलो हतो। में तने आसम ठेरायो के तु भगवान ना चोखला बड़ा पोर रेतो हतो; तु आक्‌ठुन तेम चमकवा वाळा मण्‌या नी वच मे चालतो-फीरतो हतो। <verse eid="EZK 28:14" /><verse number="15" style="v" sid="EZK 28:15" />जे दाड़े गेथो तु बण्‌यो, अने जे दाड़े तक तारी मे कंय गलत काम नी जड़्‌यु, तीहयी टेमे तक तु तारी आखी चाल-चलण मे वण-गुनाळ्‌ळो र्‌यो। <verse eid="EZK 28:15" /><verse number="16" style="v" sid="EZK 28:16" />पण लेण-देण जादा हयवा ना कारण सी कोहराय सी भराय्‌न पापी हय ज्‌यो; आनीत सी में तने वीटळ्‌ळो जाणीन भगवान ना बड़ा पोर गेथो उतार्‌यो, अने तारा डील नी रखवाळी करन्‌यो ह़रगदुत बी आक्‌ठु ह़रका चमकवा वाळा मण्‌या नी वच मे गेथो तने नीकाळ देदो। <verse eid="EZK 28:16" /><verse number="17" style="v" sid="EZK 28:17" />घटाळ्‌ळा ना कारण सी तारा मन मे घमंड आय जेलो हतो; अने बड़ाय ना कारण सी तारी अक्‌कल बगड़ जेली हती। में तने धरती पोर नाख देदो; अने राजाम नी अगळ तने मेक्‌यो के तीहया तने देखे। <verse eid="EZK 28:17" /><verse number="18" style="v" sid="EZK 28:18" />तारा अधरम ना कामु ढेरका हयवा सी अने तारी लेण-देण मे धोका करवा सी तारा चोखला जागा वीटळ ज्‌या; करीन में तारी मे गेथु एवु आक्‌ठु पयदा कर्‌यो जीनी सी तु धप ज्‌यो, अने में तने आखा देखवा वाळा नी अगळ धरती पोर रोखड़ो बणाय नाख्‌यो। <verse eid="EZK 28:18" /><verse number="19" style="v" sid="EZK 28:19" />देस-देस ना माणहु मे गेथा जेतरा तने जाणे आखा तारा कारण सी दुखी हया; तु बीक नो कारण बणलो से अने अळी कदी जड़े नी।”<verse eid="EZK 28:19" /></para>
  <para style="s">सीदोन ह़ेर ना बारा मे भगवान वगे गेथी वात</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 28:20" />यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 28:20" /><verse number="21" style="v" sid="EZK 28:21" />“ए माणेह नी अवल्‌यात, तारु मोडु सीदोन भणीन करीन तीना वीरोद मे भगवान वगे गेथी वात के, <verse eid="EZK 28:21" /><verse number="22" style="v" sid="EZK 28:22" />अने के, मालीक यहोवा आसम केय: ए सीदोन, में तारा वीरोद मे से; में तारी वच मे मारी बड़ाय करावही। जत्‌यार में तीनी वच मे डंड आपही अने में खुद ने तीनी मे चोखलो ठेरावही, ता माणहु जाण लेहे के में यहोवा से। <verse eid="EZK 28:22" /><verse number="23" style="v" sid="EZK 28:23" />में तीनी मे मोट्‌ली बीमारी फेलावही, अने तीनी आखी ह़ड़कु पोर लोय वयाड़ही; अने तीनी च्‌यारो-मेर तलवार चालहे; ता तीनी वच मे घाव लागला माणहु मरहे, अने तीहया जाण लेहे के में यहोवा से।”<verse eid="EZK 28:23" /></para>
  <para style="s">ईस्‌रायल ने बरकत जड़हे</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 28:24" />“ईस्‌रायल ना घोराणा ना च्‌यारो-मेर ना जेतरा राज्‌य तीमनी ह़ाते गलत वेहवार करे, तीमनी मे गेथा कोय तीमना गोपायवा वाळो काटो नीता कोरवा वाळो भालो अळी नी ठेरे; ता तीहया जाण लेहे के में भगवान यहोवा से।” <verse eid="EZK 28:24" /><verse number="25" style="v" sid="EZK 28:25" />“भगवान यहोवा आसम केय: जत्‌यार में ईस्‌रायल ना घोराणा ने तीहया आखा माणहुम नी मे गेथा एक्‌ठा करही, जीमनी वच मे तीहया रीवण्‌या-तीवण्‌या हयला से, अने देस-देस ना माणहु नी अगळ तीमनी लारे चोखलो ठेरही, ता तीहया ते देस मे रेहे जे में मारा चाकर्‌या याकुब ने आपलो हतो। <verse eid="EZK 28:25" /><verse number="26" style="v" sid="EZK 28:26" />तीहया तीनी मे बेफीकर्‌या वहला रेहे; तीहया घोर बणाय्‌न अने अंगुर ना वाड़्‌या लगाड़ीन बेफीकर्‌या रेहे; ता में तीमना च्‌यारो-मेर ना आखा माणहु ने डंड आपही जे तीमनी ह़ाते गलत वेहवार करे, ता तीहया जाण लेहे के तीमनो भगवान यहोवात से।”<verse eid="EZK 28:26" /></para>
  <chapter eid="EZK 28" />
  <chapter number="29" style="c" sid="EZK 29" />
  <para style="s">मीस्‌र देस ना राजा ना वीरोद मे भगवान वगे गेथी वात</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 29:1" />दहवा साल ना दहवा मयना ना बारवा दाड़े यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 29:1" /><verse number="2" style="v" sid="EZK 29:2" />“ए माणेह नी अवल्‌यात,” तारु मोडु मीस्‌र ना राजा फीरोन भणीन करीन तीनी अने आखा मीस्‌र ना वीरोद मे भगवान वगे गेथी वात के; <verse eid="EZK 29:2" /><verse number="3" style="v" sid="EZK 29:3" />आहयु के, भगवान यहोवा आसम केय: ए मीस्‌र ना राजा फीरोन, में तारा वीरोद मे से, से मोटु पण, तु जे तारी नंदीम नी वच मे पड़ रेय, जे केदलो से, मारी नंदी मारी खुद नी से, अने मेंत तीने मारी जुगु बणावलो से। <verse eid="EZK 29:3" /><verse number="4" style="v" sid="EZK 29:4" />में तारा जबाड़ा मे हेकड़ा घालही, अने तारा नंद्‌या ना माछला ने तारी खाल मे चीपकाड़ही, अने तारी खाल मे चीपकला तारा नंद्‌या ना आखा माछला भेळ तने तारा नंद्‌या मे गेथो नीकाळही। <verse eid="EZK 29:4" /><verse number="5" style="v" sid="EZK 29:5" />ता में तने तारा नंद्‌या ना आखा माछला भेळ जंगल मे नीकाळही, अने तु मेदान मे पड़ रेही; कानी बी भाते तारी ह़ला नी लेय। में तने जंगल ना जानवर अने वादळा मे ना चड़ा नु खाणु बणाय देदलो से। <verse eid="EZK 29:5" /><verse number="6" style="v" sid="EZK 29:6" />ता मीस्‌र ना आखा रेवा वाळा जाण लेहे के में यहोवा से। तीहयो ते ईस्‌रायल ना घोराणा जुगु मानो कमजोर लाकड़ी ठेरलो।<note caller="+" style="x"><char style="xo" closed="false">29:6 </char><char style="xt" closed="false"><ref loc="ISA 36:6">यसाया 36:6</ref></char></note> <verse eid="EZK 29:6" /><verse number="7" style="v" sid="EZK 29:7" />जत्‌यार तीहया तारी पोर हात नी ताखत लगाड़्‌या ता तु टुट ज्‌यो अने तीमना खबा उपकी ज्‌या, अने जत्‌यार तीहया तने टेको लगाड़्‌या, ता तु टुट ज्‌यो, अने तीमना केड़्‌ये ना आखा नेहटा हपकाय ज्‌या। <verse eid="EZK 29:7" /><verse number="8" style="v" sid="EZK 29:8" />आहया कारण सी मालीक यहोवा आसम केय: देख, में तारी पोर तलवार चलाड़ीन, तारा माणहु अने जानवरु, आखा ने खत्‌तम करही। <verse eid="EZK 29:8" /><verse number="9" style="v" sid="EZK 29:9" />ता आखु मीस्‌र देस उजाड़ेत उजाड़ हय जहे; अने तीहया जाण लेहे के में यहोवा से। “तु केदलो से, ‘मारी नील नंदी मारी खुद नीत से, अने मेंत तीने बणावलो से।’ <verse eid="EZK 29:9" /><verse number="10" style="v" sid="EZK 29:10" />आहया कारण सी देख, में तारी अने तारा नंद्‌या ना वीरोद मे से अने मीस्‌र देस ने मीगदोल ह़ेर गेथु लगाड़ीन सवेने ह़ेर तक मतलब कुस देस नी काकड़ तक उजाड़ेत उजाड़ कर देही। <verse eid="EZK 29:10" /><verse number="11" style="v" sid="EZK 29:11" />चाळीह साल तक तीनी मे माणेह नीता जानवरु नो पोग तक नी पड़े; अने नी तीनी मे कोय वहे। <verse eid="EZK 29:11" /><verse number="12" style="v" sid="EZK 29:12" />चाळीह साल तक में मीस्‌र देस ने उजड़ला देसु नी वच मे उजाड़ीन राखही; अने तीना ह़ेर उजड़ला ह़ेरु नी वच मे उजड़लात रेहे। में मीस्‌री मे रेवा वाळा ने राज्‌य-राज्‌य मे खोळवी देही, अने देस-देस मे रीवण्‌या-तीवण्‌या कर देही।”<verse eid="EZK 29:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 29:13" />“भगवान यहोवा आसम केय: चाळीह साल वीतवान अळतेण में मीस्‌री माणहु ने तीहयी जातीम नी वच मे गेथा एक्‌ठा करही, जीमनी मे तीहया रीवण्‌या-तीवण्‌या हय जेला; <verse eid="EZK 29:13" /><verse number="14" style="v" sid="EZK 29:14" />अने में मीस्‌री माणहु ने गुलामी मे गेथा छोड़ावीन पत्‌रोस देस मे, जां तीहया पयदा हयला से, पासो पुगाड़ही; अने तां तीमनु नान्‌लु राज्‌य हय जहे। <verse eid="EZK 29:14" /><verse number="15" style="v" sid="EZK 29:15" />तीहयु आखा राज्‌य मे नानु रेहे, अने बीजा राज्‌य नी अगळ आह़फा नु मुंडु उचु नी कर सके; काहाके में मीस्‌री माणहु ने आसम कम करही के तीहया राज्‌य-राज्‌य पोर अळतेण कारु बी राज नी कर सके। <verse eid="EZK 29:15" /><verse number="16" style="v" sid="EZK 29:16" />तीहया अळतेण ईस्‌रायल ना घोराणा ना भरहा नो कारण नी बणे, काहाके जत्‌यार तीहया तीमनी भणीन फीरीन तीमने देखहे, ता तीहया तीमना अधरम ने फोम करहे, ता तीहया जाण लेहे के में भगवान यहोवा से।”<verse eid="EZK 29:16" /></para>
  <para style="s">राजो नबुकदनेस्‌सर मीस्‌र देस ने हरावहे</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 29:17" />अळतेण सत्‌तावीसवा साल ना पेल्‌ला मयना ना पेल्‌ला दाड़े यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 29:17" /><verse number="18" style="v" sid="EZK 29:18" />“ए माणेह नी अवल्‌यात,” बेबीलोन नो राजो नबुकदनेस्‌सर सोर ह़ेर ने घेरव्‌वा मे आह़फा नी सेना ने घणी मेहनत करायो; एक-एक नु मुंडु टकलु हय ज्‌यु, अने एक-एक जणा ना खबा नी चामड़ी छोलाय जी; ते बी तीमने सोर ह़ेर मे गेथी नी ते आहयु काठु काम नी कंय दाड़की जड़ी अने नी तीनी सेना ने। <verse eid="EZK 29:18" /><verse number="19" style="v" sid="EZK 29:19" />आहया कारण सी भगवान यहोवा आसम केय: देख, में बेबीलोन ना राजा नबुकदनेस्‌सर ने मीस्‌र देस आपही, अने तीहयो तीनी भीड़ ने ली जहे, अने तीनु धन-दवल्‌यत ने लुटीन कब्‌जा मे कर लेहे; अने आहयीत दाड़की तीनी सेना ने जड़हे। <verse eid="EZK 29:19" /><verse number="20" style="v" sid="EZK 29:20" />में तीनी मेहनत ना बदला मे तीने मीस्‌र देस आनीन करते आप्‌यो के तीहया माणहु मारी जुगु काम करला हता, भगवान यहोवा आसमेत केय। <verse eid="EZK 29:20" /><verse number="21" style="v" sid="EZK 29:21" />“तीहयीत टेमे में ईस्‌रायल नु घोराणु मे एक ह़ींगड़ु उगाड़ही, अने तीमनी वच मे तारु मोडु उगाड़ देही। ता तीहया जाण लेहे के में यहोवा से।”<verse eid="EZK 29:21" /></para>
  <chapter eid="EZK 29" />
  <chapter number="30" style="c" sid="EZK 30" />
  <para style="s">भगवान मीस्‌र देस ने डंड आपहे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 30:1" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 30:1" /><verse number="2" style="v" sid="EZK 30:2" />“ए माणेह नी अवल्‌यात,” भगवान वगे गेथी वात कीन के, भगवान यहोवा आसम केय: छाती ठोकीन रड़ो: गरा आय पड़े! गरा नो दाड़ो आय पड़्‌यो! <verse eid="EZK 30:2" /><verse number="3" style="v" sid="EZK 30:3" />काहाके तीहयो दाड़ो मतलब यहोवा नो दाड़ो ह़ाते से; तीहयो वादळा नो दाड़ो, अने राज्‌य ना डंड नी टेम रेहे। <verse eid="EZK 30:3" /><verse number="4" style="v" sid="EZK 30:4" />मीस्‌र मे तलवार चालहे, अने मीस्‌र मे माणहु टुटी-टुटीन पड़हे, ता कुस देस मे बी बीक भराय जहे, माणहु मीस्‌र देस ने लुट लीजहे, अने तीनी नीव ने ओदार देहे। <verse eid="EZK 30:4" /><verse number="5" style="v" sid="EZK 30:5" />कुस, पुत, लुद, अने दोगले अने कुब देस ना माणहु ने, अने वायदो करला देस मे रेवा वाळा ने, मीस्‌री माणहुम नी ह़ाते तलवार वेर मार नाखहे। <verse eid="EZK 30:5" /><verse number="6" style="v" sid="EZK 30:6" />“यहोवा आसम केय: मीस्‌र ना ह़माळवा वाळा बी पड़ जहे, अने आह़फाम नी जे ताखत पोर मीस्‌री माणहु घमंड करे, तीहयी टुटहे; मीगदोल ह़ेर गेथा लगाड़ीन सवेने ह़ेर तक तीना रेवा वाळा ने तलवार वेर मारहे, भगवान यहोवा आसमेत केय। <verse eid="EZK 30:6" /><verse number="7" style="v" sid="EZK 30:7" />तीहया उजड़ला देस नी वच मे उजड़ला ठेरहे, अने तीमना ह़ेर उजाड़ करला ह़ेरु मे गीणायहे। <verse eid="EZK 30:7" /><verse number="8" style="v" sid="EZK 30:8" />जत्‌यार में मीस्‌र मे आक्‌ठु धपाड़ही अने तीना आखा मदत करन्‌या खत्‌तम हयहे, ता तीहया जाण लेहे के में यहोवा से।<verse eid="EZK 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 30:9" />“तीहयी टेमे मारी अगळ गेथा दुत ढुंड्‌या पोर चड़ीन बीह्‌या वगर जहे अने कुस देस वाळा ने बीहाड़हे; अने तीमनी पोर एवी वेला आय पड़हे जेम के मीस्‌री माणहु ना डंड नी टेमे आवली; काहाके देख, तीहयो दाड़ो आवे!” <verse eid="EZK 30:9" /><verse number="10" style="v" sid="EZK 30:10" />भगवान यहोवा आसम केय: “में बेबीलोन ना राजा नबुकदनेस्‌सर ना हात सी मीस्‌री नी भीड़ ने खत्‌तम कराय देही। <verse eid="EZK 30:10" /><verse number="11" style="v" sid="EZK 30:11" />तीहयो आह़फा ना माणहु भेळ, आखु राज्‌य मे घणो-जुदो से, तीहयो देस ने खत्‌तम करवा करीन आवहे। अने तीहया मीस्‌र देस ना वीरोद मे तलवार हापकीन देस ने मरला सी भर देहे। <verse eid="EZK 30:11" /><verse number="12" style="v" sid="EZK 30:12" />में नंद्‌या ने ह़ुकाड़ देही, अने देस ने बुरा माणहु ना हात मे ह़ोप देही; अने में बीजा देस वाळा नी लारे देस ने, अने जे कंय तीनी मे से, उजाड़ कराय देही; में यहोवात आहयु केदलो से।” <verse eid="EZK 30:12" /><verse number="13" style="v" sid="EZK 30:13" />“भगवान यहोवा आसम केय: में नोप ह़ेर मे गेथा मुरत्‌या ने खत्‌तम करही अने तीनी मे ना मुरत्‌या ने रेवा नी देम; अळतेण कोय बी मुख्‌यो मीस्‌र देस मे नी उठे; अने में मीस्‌र देस मे बीक उबजाड़ही। <verse eid="EZK 30:13" /><verse number="14" style="v" sid="EZK 30:14" />में पत्‌रोस ह़ेर ने उजाड़ही, अने सोवन ह़ेर मे आक्‌ठु धपाड़ही, अने नो ह़ेर ने डंड आपही। <verse eid="EZK 30:14" /><verse number="15" style="v" sid="EZK 30:15" />सीन ह़ेर जे मीस्‌र देस नो कीलो से, तीनी पोर मारी रीह नीकाळही। अने नो ह़ेर नी भीड़ ने खत्‌तम कर देही। <verse eid="EZK 30:15" /><verse number="16" style="v" sid="EZK 30:16" />में मीस्‌र देस मे आक्‌ठु धपाड़ही; सीन ह़ेर घणु थतरहे; अने नो ह़ेर ना भीतड़ा मे चीह पड़ जहे अने नो ह़ेर ना वीरोदी दीहुत उठहे। <verse eid="EZK 30:16" /><verse number="17" style="v" sid="EZK 30:17" />आवेन ह़ेर अने पीवेसेत ह़ेर ना जुवान ने तलवार वेर मारहे, अने आहया ह़ेर गुलामी मे जत रेहे। <verse eid="EZK 30:17" /><verse number="18" style="v" sid="EZK 30:18" />जत्‌यार में मीस्‌री माणहु ना राज्‌य ने तहपन्‌हेस मे खत्‌तम करही, ता तीनी मे दीहु अंदारु रेहे, अने तीनी ताखत जीनी पोर तीहयु घमंड करे, तीहयी खत्‌तम हय जहे; तीनी पोर वादळु छवाय जहे अने तीना सोर्‌या गुलामी मे जत रेहे। <verse eid="EZK 30:18" /><verse number="19" style="v" sid="EZK 30:19" />आहयी रीते मे मीस्‌री माणहु ने डंड आपही। ता तीहया जाण लेहे के में यहोवा से।”<verse eid="EZK 30:19" /></para>
  <para style="s">मीस्‌र ना राजा नी टुटली सक्‌ती</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 30:20" />अळतेण ग्‌यारवा साल ना पेल्‌ला मयना ना ह़ातवा दाड़े यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 30:20" /><verse number="21" style="v" sid="EZK 30:21" />“ए माणेह नी अवल्‌यात, में मीस्‌र ना राजा फीरोन ना हात तोड़ नाखलो से; अने देख, नी तीने जोड़्‌या, अने नी तीनी पोर वारु हयवा करीन पट्‌टी बांदी। तीनी मे एतरी ताखत नी हये के तीहयो तलवार चुट सके। <verse eid="EZK 30:21" /><verse number="22" style="v" sid="EZK 30:22" />करीन मालीक यहोवा आसम केय: देख, में मीस्‌र ना राजा फीरोन ना वीरोद मे से, अने तीनो वारलो अने टुटलो बेम हात ने तोड़ही; अने तलवार ने तीना हात मे गेथी पाड़ देही। <verse eid="EZK 30:22" /><verse number="23" style="v" sid="EZK 30:23" />में मीस्‌री माणहु ने राज्‌य-राज्‌य मे रीवण्‌या-तीवण्‌या करही, अने देस-देस मे खोळवी देही। <verse eid="EZK 30:23" /><verse number="24" style="v" sid="EZK 30:24" />में बेबीलोन ना राजा ना हातु ने मजबुत करीन मारी तलवार तीना हात मे आपही; पण फीरोन ना हातु ने तोड़ही, अने तीहयो तीनी अगळ आसम कंजारहे जेम घाव लागलो मरन्‌यो कंजारे। <verse eid="EZK 30:24" /><verse number="25" style="v" sid="EZK 30:25" />में बेबीलोन ना राजा ना हातु ने ह़माळही, अने फीरोन ना हातु ढीला पड़ जहे, ता तीहया जाणहे के में यहोवा से। जत्‌यार में बेबीलोन ना राजा ना हात मे मारी तलवार आपही, ता तीहयो तीने मीस्‌र देस पोर चलाड़हे; <verse eid="EZK 30:25" /><verse number="26" style="v" sid="EZK 30:26" />अने में मीस्‌री माणहु ने राज्‌य-राज्‌य मे रीवण्‌या-तीवण्‌या करही अने देस-देस मे खोळवी देही। ता तीहया जाण लेहे के में यहोवा से।”<verse eid="EZK 30:26" /></para>
  <chapter eid="EZK 30" />
  <chapter number="31" style="c" sid="EZK 31" />
  <para style="s">मीस्‌र नी बराबरी देवदारु ना झाड़का सी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 31:1" />ग्‌यारवा साल ना तीसरा मयना ना पेल्‌ला दाड़े यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 31:1" /><verse number="2" style="v" sid="EZK 31:2" />“ए माणेह नी अवल्‌यात,” मीस्‌र ना राजा फीरोन अने तीनी भीड़ ने के, तारी बड़ाय मे तु कोय ने तेवु से। <verse eid="EZK 31:2" /><verse number="3" style="v" sid="EZK 31:3" />देख, अस्‌सुर ते लबानोन नु एक देवदार नाम नु झाड़ हतु जीना घटाळ्‌ळा-घटाळ्‌ळा डाळ्‌या हता; अने तीना सींडा वादळे तक पुगता हता। <verse eid="EZK 31:3" /><verse number="4" style="v" sid="EZK 31:4" />पाणी तीने वदाड़्‌यु, अने उंडु पाणी ना कारण सी तीहयु उचु हयु, जीनी सी नंद्‌या तीनी च्‌यारो-मेर वयती हती; अने तीना कोतड़्‌या नीकळीन मेदान ना आखा झाड़ुन्‌तां पुगता हता। <verse eid="EZK 31:4" /><verse number="5" style="v" sid="EZK 31:5" />आहया कारण सी तीनी उचाय मेदान ना आखा झाड़ु सी जादा हयी; तीना डाळ्‌या घणा नीकळ्‌या, अने तीना डाळ्‌या नाम्‌बा हय ज्‌या, काहाके जत्‌यार तीहया नीकळ्‌या, ता तीमने घणु पाणी जड़्‌यु। <verse eid="EZK 31:5" /><verse number="6" style="v" sid="EZK 31:6" />तीना डाळ्‌या पोर वादळा ना आखा चड़ा पोतरो बांदता हता, अने तीना डाळ्‌या तळे मेदान ना आखा भाती ना जीव-जन्‌तु पयदा हयला हता; अने तीना छाहळा मे आखा मोट्‌ला राज्‌य रेता हता। <verse eid="EZK 31:6" /><verse number="7" style="v" sid="EZK 31:7" />तीहयु तीनी लम्‌बाय अने तीना डाळ्‌या नी लम्‌बाय का कारण सी घटाळु हयु; काहाके तीना मुळ्‌या घणु पाणी नी ह़ाते हता। <verse eid="EZK 31:7" /><verse number="8" style="v" sid="EZK 31:8" />भगवान नी वाड़ी ना देवदारु झाड़ बी तीने नी ढाक सकता हता, सनोवर झाड़ तीना डाळ्‌यान बराबर बी नी हता, अने नी अर्‌मोन झाड़ तीना डाळ्‌यान तेवु हतु; भगवान नी वाड़ी नु कानु बी झाड़ तीनी बराबर घटाळ्‌ळु नी हतु। <verse eid="EZK 31:8" /><verse number="9" style="v" sid="EZK 31:9" />में तीने ढेरका डाळ्‌या वेर घटाळ्‌ळु बणावलो हतो, आञे तक के अदन ना आखा झाड़ जे भगवान नी वाड़ी मे हता, तीनी सी रीह करता हता।<verse eid="EZK 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 31:10" />करीन मालीक भगवान आसम केदलो से: तीनी उचाय जे बड़ जेली से, तीनी सींडी जे वादळे तक पुगली से, अने तीनी उचाय ना कारण सी तीनु मन घमंड सी भराय जेलु से, <verse eid="EZK 31:10" /><verse number="11" style="v" sid="EZK 31:11" />करीन राज्‌य मे जे ताखत वाळु से, में तीनात हात मे तीने कर देही, अने तीहयो पक्‌को तीनी ह़ाते गलत वेहवार करहे। तीना गलत कामु का कारण सी में तीने नीकाळ देदलो से। <verse eid="EZK 31:11" /><verse number="12" style="v" sid="EZK 31:12" />बीजा देस वाळा, जे राज्‌य मे घणा-जुदा माणहु से, तीहया तीने तोड़ीन छोड़ देहे, तीना डाळ्‌या बड़ा पोर, अने आखा घाट्‌या मे पाड़ देहे, अने तीना डाळ्‌या देस ना आखा कोतड़ा मे टुटला पड़ रेहे, अने राज्‌य-राज्‌य ना आखा माणहु तीना छाहळा ने छोड़ीन जत रेहे। <verse eid="EZK 31:12" /><verse number="13" style="v" sid="EZK 31:13" />तीहया पड़ला झाड़ पोर वादळा ना आखा चड़ा पोतरो बांदे, अने डाळ्‌या नी उपर मेदान ना आखा जीव-जन्‌तु चड़वा बाज जहे। <verse eid="EZK 31:13" /><verse number="14" style="v" sid="EZK 31:14" />आहयु आनीन करते हयु के पाणीन्‌तां ना झाड़ु मे गेथु कानु बी झाड़ आह़फु नी उचाय नी बड़ावे, अने नी सींडी ने वादळा मे तक पुगाड़े, अने तीमनी मे जेतरा पाणी हात करीन मजबुत हय जेला से तीहया उचा हयवा ना कारण सी मुंडु नी उचु कर्‌या; काहाके तीमने बी आखान-आखा ने मड़ाट्‌या मे गड़ायला माणहुन तेम मोत ना हक मे आपीन पताळ मे नाख देहे। <verse eid="EZK 31:14" /><verse number="15" style="v" sid="EZK 31:15" />भगवान यहोवा आसम केय: जे दाड़े तीहयु पताळ मे उतरी ज्‌यु, तीहया दाड़े में दुख करायो अने उंडलु पाणी ने ढाक देदो, अने नंद्‌या नु घणु पाणी रोकाय ज्‌यु, अने तीना कारण सी में लबानोन ने दुख मे डुबाड़ देदो, अने मेदान ना आखा झाड़ चीमाय ज्‌या। <verse eid="EZK 31:15" /><verse number="16" style="v" sid="EZK 31:16" />जत्‌यार में तीने मड़ाट्‌या मे गाड़लान्‌तां पताळ मे नाख देदो, ता तीनी पड़वा नी अवाज सी राज्‌य-राज्‌य काप उठ्‌यु, अने अदन ना बगीचा ना आखा झाड़ मतलब लबानोन ना वारला-वारला जेतरा झाड़का ने तीनी मे गेथु पाणी जड़तु हतु, तीहया आखा पताळ मे सांती हात कर्‌या। <verse eid="EZK 31:16" /><verse number="17" style="v" sid="EZK 31:17" />तीहया बी तीनी ह़ाते तलवार वेर मारलान्‌तां पताळ मे उतर ज्‌या; मतलब तीहया जे तीना हात हता, अने राज्‌य-राज्‌य नी वच मे तीना छाहळा मे रेता हता। <verse eid="EZK 31:17" /><verse number="18" style="v" sid="EZK 31:18" />“करीन महीमा अने बड़ाय ना बारा मे अदन बगीचा ना झाड़ु मे गेथु तु कोय ने तेवु से? तने ते अदन बगीचा ना बीजा झाड़का ह़ाते पताळ मे उतार देहे, अने खतना वगर ना माणहु नी वच मे तलवार वेर मारला नी ह़ाते पड़ रेही। फीरोन अने तीना माणहु नो हाल आसमेत हयहे, भगवान यहोवा आसमेत केय।”<verse eid="EZK 31:18" /></para>
  <chapter eid="EZK 31" />
  <chapter number="32" style="c" sid="EZK 32" />
  <para style="s">मीस्‌र ना राजा नी बराबरी मोगर ह़ाते</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 32:1" />बारवा साल ना बारवा मयना ना पेल्‌ला दाड़े यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 32:1" /><verse number="2" style="v" sid="EZK 32:2" />“ए माणेह नी अवल्‌यात,” मीस्‌र ना राजा फीरोन ना बारा मे दुख नु गीत बणाय्‌न तीने ह़मळाव: राज्‌य-राज्‌य मे तु आह़फा ने जुवान नाहर ने तेवो मान्‌तो हतो, पण तु दर्‌या ना मोगर ने तेवो से; तु आह़फा ना नंद्‌या मे जाय्‌न, आह़फा ना पोगु वेर पाणी ने डोहळु कर देदलो से। <verse eid="EZK 32:2" /><verse number="3" style="v" sid="EZK 32:3" />भगवान यहोवा आसम केय: ढेरेत राज्‌य नी सबा नी लारे तारी पोर मारी जाळ फेलावही अने तीहया तने मारी मोट्‌ली जाळ मे हापकी लेहे। <verse eid="EZK 32:3" /><verse number="4" style="v" sid="EZK 32:4" />ता में तने धरती पोर छोड़ीन, अने मेदान मे नाखीन वादळा ना आखा चड़ा ने तारी पोर बहाड़ही; अने तारा मांह सी आखी धरती ना जीव-जन्‌तु ने अफराड़ही। <verse eid="EZK 32:4" /><verse number="5" style="v" sid="EZK 32:5" />में तारु मांह ने बड़ा पोर मेकही, अने घाट्‌या ने तारी उचाय सी भर देही। <verse eid="EZK 32:5" /><verse number="6" style="v" sid="EZK 32:6" />जे देस मे तु तीरे, तीने बड़ा तक में तारा लोय सी ह़ीचही; अने तीना कोतड़ा तारी सी भराय जहे। <verse eid="EZK 32:6" /><verse number="7" style="v" sid="EZK 32:7" />जे दाड़े में तने मीटाड़वा बाज जही, तीहयी टेमे में वादळु ने ढाकही अने तारा ने धुदळा कर देही; में दाड़ु ने वादळु वेर ह़ताड़ही, अने चांद तीनु वीजाळु नी आपे।<note caller="+" style="x"><char style="xo" closed="false">32:7 </char><char style="xt" closed="false"><ref loc="ISA 13:10">यसाया 13:10</ref>; <ref loc="MAT 24:29">मत्‌ती 24:29</ref>; <ref loc="MRK 13:24">मरकुस 13:24</ref>,<ref loc="MRK 13:25">25</ref>; <ref loc="LUK 21:25">लुका 21:25</ref>; <ref loc="REV 6:12">परकासीतवाक्‌य 6:12</ref>,<ref loc="REV 6:13">13</ref>; <ref loc="REV 8:12">8:12</ref></char></note> <verse eid="EZK 32:7" /><verse number="8" style="v" sid="EZK 32:8" />ह़रग मे जेतरु वीजाळु वाळु उजड़ से, तीमने आखु ने में तारा कारण सी धुदळा कर देही, अने तारा देस मे अंदारलु कर देही, भगवान यहोवा आसमेत केय।<verse eid="EZK 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 32:9" />“जत्‌यार में तारा खत्‌तम हयवा नी खबर राज्‌य-राज्‌य मे अने तारा अंजाण्‌या देसु मे फेलावही, ता मोटा-मोटा देसु ना माणहु ना मन मे रीह उबजाड़ही। <verse eid="EZK 32:9" /><verse number="10" style="v" sid="EZK 32:10" />में घणा-ढेरका राज्‌य ने तारा कारण सी वहराड़ देही, अने जत्‌यार में तीमना राजान नी अगळ खुद नी तलवार मोकलही, ता तारा कारण सी बीहीन कापवा बाज जहे, अने तारा पड़वा ना दाड़े तीहया आह़फा-आह़फाम ना जीव जुगु कापता रेहे।”<verse eid="EZK 32:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 32:11" />काहाके भगवान यहोवा आसम केय: बेबीलोन नी तलवार तारी पोर चालहे। <verse eid="EZK 32:11" /><verse number="12" style="v" sid="EZK 32:12" />में तारी भीड़ ने एवा वारला झुमायण्‌या नी तलवार नी लारे मारही जे आखु राज्‌य मे घणा-जुदा से। तीहया मीस्‌र ना घमंड ने तोड़ देहे, अने तीनी आखी भीड़ खत्‌तम हय जहे। <verse eid="EZK 32:12" /><verse number="13" style="v" sid="EZK 32:13" />में तीना आखा जानवरु ने तीना नंद्‌या-कोतड़ा ना काठे गेथा खत्‌तम करही; अने आव्‌वा वाळी टेम मे तीहया नी ते माणहु ना पोगु वेर अने नी जानवरु ना खुर्‌या वेर डोहळु करे। <verse eid="EZK 32:13" /><verse number="14" style="v" sid="EZK 32:14" />ता में तीमनु पाणी वारलु कर देही, अने तीना नंद्‌या तेल ने तेम वयहे, भगवान यहोवा आसमेत केय। <verse eid="EZK 32:14" /><verse number="15" style="v" sid="EZK 32:15" />जत्‌यार में मीस्‌र देस ने उजाड़ देही अने जीनी सी तीहयु पुरुन पुरु से, तीनी सी तीने बांडळ्‌ळु कर देही, अने जत्‌यार में तीना आखा रेवा वाळा ने मारही, ता तीहया जाण लेहे के में यहोवा से। <verse eid="EZK 32:15" /><verse number="16" style="v" sid="EZK 32:16" />“माणहु जुगु दुखी हयवा करीन दुख नु गीत आहयुत से; राज्‌य-राज्‌य ना सोर्‌या आने गावहे; मीस्‌र अने तीनी आखी भीड़ ना बारा मे तीहया आहयुत दुख नु गीत गावहे, भगवान यहोवा आसमेत केय।”<verse eid="EZK 32:16" /></para>
  <para style="s">मरलाम नी कळी</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 32:17" />अळतेण बारवा साल ना पेल्‌ला मयना ना पंदरवा दाड़े यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 32:17" /><verse number="18" style="v" sid="EZK 32:18" />“ए माणेह नी अवल्‌यात,” मीस्‌र नी भीड़ जुगु दुखी हय, अने तीने ताखत वाळु राज्‌य ना सोर्‌या भेळ मड़ाट्‌या मे गड़ायलान्‌तां पताळ मे उतार। <verse eid="EZK 32:18" /><verse number="19" style="v" sid="EZK 32:19" />तु कोय सी वारु से? तु उतरीन खतना वगर ना नी ह़ाते पड़ रे।<verse eid="EZK 32:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 32:20" />तीहया तलवार वेर मरलाम नी वच मे पड़हे, तीमनी जुगु तलवारेत ठेरावली से; करीन मीस्‌र ने तीनी भीड़ भेळ घीही ली जावो। <verse eid="EZK 32:20" /><verse number="21" style="v" sid="EZK 32:21" />ताखत वाळा वारला झुमायण्‌या तीनी ह़ाते अने तीना मदत करन्‌या ह़ाते वात करहे; ह़ेला खतना वगर ना माणहु ह़ेले तलवार वेर मरला पड़ र्‌या।<verse eid="EZK 32:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 32:22" />तीनी आखी सबा भेळ अस्‌सुरी बी तां से, तीना मड़ाट्‌या तीनी च्‌यारो-मेर से; आखान-आखा ने तलवार वेर मार नाखला से। <verse eid="EZK 32:22" /><verse number="23" style="v" sid="EZK 32:23" />तीना मड़ाट्‌या खाडा ना खुणा मे बणला से, अने तीना मड़ाट्‌या नी च्‌यारो-मेर तीनी सबा से; तीहया आखान-आखा जे जीवाय नी कळ मे बीक उबजाड़ता हता, हाव तलवार वेर मरला पड़ र्‌या।<verse eid="EZK 32:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 32:24" />ह़ेले एलाम देस से, अने तीना मड़ाट्‌या नी च्‌यारो-मेर तीनी आखी भीड़ से; तीहया आखान-आखा ने तलवार वेर मार नाखला से, तीहया खतना वगर ना पताळ मे उतर जेला से; तीहया जीवाय नी कळ मे बीक उबजाड़ता हता, पण हाव मड़ाट्‌या मे अने गाड़ला नी ह़ाते तीमना मोडा पोर वाक छवाय जेलो से। <verse eid="EZK 32:24" /><verse number="25" style="v" sid="EZK 32:25" />तीनी आखी भीड़ भेळ तीने मारला नी वच मे खाट्‌लु जड़्‌यु, तीना मड़ाट्‌या तीनीत च्‌यारो-मेर से, तीहया आखान-आखा ने जे खतना वगर ना से तलवार वेर मारला; तीहया जीवाय नी कळ मे बीक उबजाड़ला हता, पण हाव मड़ाट्‌या मे अने गाड़ला नी ह़ाते तीमना मोडा पोर वाक छवाय ज्‌यो; अने तीमने मरला नी वच मे मेकला से।<verse eid="EZK 32:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 32:26" />“तां आखी भीड़ भेळ मेसेक अने तुबल से, तीमनी च्‌यारो-मेर मड़ाट्‌या से; तीहया आखान-आखा ने जे खतना वगर ना से तलवार वेर मारला, काहाके तीहया जीवाय की कळ मे बीक उबजाड़ता हता। <verse eid="EZK 32:26" /><verse number="27" style="v" sid="EZK 32:27" />तीहया पड़ला खतना वगर ना वारला झुमायण्‌या भेळ तीहया पड़ी नी रेय जे आह़फा-आह़फाम ना हत्‌यार लीन पताळ मे उतर जेला से, तां तीमनी तलवार तीमना मुंडा नी तळे मेकली से; अने तीमना अधरम ना काम तीमना हाटका मे भरला से; काहाके जीवाय नी कळ मे तीमनी सी वारला झुमायण्‌या ने बीक लागती हती।<verse eid="EZK 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 32:28" />“करीन तु बी खतना वगर ना माणहु ह़ाते कचराय्‌न तलवार वेर मरलाम नी ह़ाते पड़ रेही।<verse eid="EZK 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 32:29" />“तां एदोम अने तीना राजा अने तीना आखा मुख्‌या से, जे वारला झुमायण्‌या हयवा पोर बी तलवार वेर मरलाम नी ह़ाते मेकला से; खाडा मे गड़ायला खतना वगर ना माणहु ह़ाते तीहया बी पड़ी रेहे।<verse eid="EZK 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 32:30" />“तां दखणाव भणी ना आखा मुख्‌या अने सीदोन ना बी से जे मरलाम नी ह़ाते उतर जेला; तीहया आह़फाम नी सक्‌ती सी बीक फेलाड़ला हता, पण तीहया हाव लाजे पड़्‌या अने तलवार वेर अने मरला नी ह़ाते तीहया बी खतना वगर ना पड़ र्‌या, अने मड़ाट्‌या मे बीजा गड़ायला नी ह़ाते तीमना मोडा लाजे पड़ला से।<verse eid="EZK 32:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EZK 32:31" />“ईमने देखीन फीरोन बी आह़फा नी आखी भीड़ जुगु सांती हात करहे, होव फीरोन अने तीनी आखी सेना जे तलवार वेर मरली से,” भगवान यहोवा आसमेत केय।<verse eid="EZK 32:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 32:32" />“काहाके तीहयो बी जीवाय नी कळ मे बीक उबजाड़लो हतो; करीन तीने आखी भीड़ भेळ तलवार सी मरला अने खतना वगर ना मरला नी वच मे ह़ुवाड़हे,” भगवान यहोवा आसमेत केय।<verse eid="EZK 32:32" /></para>
  <chapter eid="EZK 32" />
  <chapter number="33" style="c" sid="EZK 33" />
  <para style="s">यहेजकेल ईस्‌रायलीम नो पेहरो देण्‌यो</para>
  <para style="r">(<ref loc="EZK 3:16-21">यहेजकेल 3:16-21</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 33:1" />यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 33:1" /><verse number="2" style="v" sid="EZK 33:2" />“ए माणेह नी अवल्‌यात,” आह़फा ना माणहु ने के, जत्‌यार में काना देस पोर वेरीम नी लारे हमलो करावु, ता तीहया देस ना माणहु कोय ने बी आह़फाम नो पेहरो देण्‌यो करीन टाळे, <verse eid="EZK 33:2" /><verse number="3" style="v" sid="EZK 33:3" />ता तीहयो आहयु देखीन के आहया देस पोर वेरी हमलो करवा वाळो से, फेपार्‌यु वगाड़ीन माणहु ने चेताव देय, <verse eid="EZK 33:3" /><verse number="4" style="v" sid="EZK 33:4" />ता जे कोय फेपार्‌या नी अवाज ह़मळीन चेतीन नी रेय अने तलवार चालवा सी मर जाय, ता तीना खुन नो गुनो तीना माथे पड़हे। <verse eid="EZK 33:4" /><verse number="5" style="v" sid="EZK 33:5" />तीहया फेपार्‌या नी अवाज ह़मळ्‌या, पण चेतीन नी र्‌या; करीन तीनी मोत नो जीम्‌मेदार तीहयोत रेहे। पण कदीम तीहयो साटो चेत जतो, ता आह़फा नो जीव बचाड़ लेतो। <verse eid="EZK 33:5" /><verse number="6" style="v" sid="EZK 33:6" />पण कदीम पेहरो देण्‌यो आहयु देखीन के वेरी हमलो करवा वाळा से फेपार्‌यु वगाड़ीन माणहु ने नी चेतावे, अने वेरी नो हमलो करवा सी तीमनी मे गेथु कोय मर जाय, ता तीहयो मरवा वाळो आह़फा ना अधरम मे फसलो मर जहे, पण तीनी मोत नो लेखो मे पेहरो देण्‌या पांहेत लेही।<verse eid="EZK 33:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 33:7" />“करीन, ए माणेह नी अवल्‌यात, मे तने ईस्‌रायल ना घोराणा नो पेहरो देण्‌यो ठेराय देदलो से; तु मारा मोडा सी बोल ह़मळी-ह़मळीन तीमने मारी भणी गेथो चेताय दे। <verse eid="EZK 33:7" /><verse number="8" style="v" sid="EZK 33:8" />कदीम में गलत काम करन्‌या माणेह ने केम, ‘ए गलत काम करन्‌या माणेह, तु पक्‌को मरही,’ ता कदीम तु गलत काम करन्‌या माणहे ने तीनी गलत वाट सोड़वा सी नी चेतावे, ता तीहयो गलत काम करन्‌यो माणेह तीना अधरम मे फसलो मरहे, पण तीनी मोत नो लेखो में तारीत पांह लेही। <verse eid="EZK 33:8" /><verse number="9" style="v" sid="EZK 33:9" />पण कदीम तु गलत काम करन्‌या माणेह ने तीनी गलत वाट सोड़वा सी चेतावे के तीहयो अने तीनी गलत वाटे गेथो नी फीरे, ता तीहयो ते आह़फा ना अधरम मे फसलो मरहे, पण तु आह़फा नो जीव बचाड़ लेही।”<verse eid="EZK 33:9" /></para>
  <para style="s">खुद नी जीम्‌मेदारी</para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 33:10" />अळतेण ए “माणेह नी अवल्‌यात,” ईस्‌रायल ना घोराणा ने आहयु के, तमु केत्‌ला: “अमारा गुना अने पापु नो भार अमारी पोर लदायलो से अने आमु तीना कारण सी खत्‌तम हयता जाय र्‌या; आमु कीकम जीवत्‌ला रीया? <verse eid="EZK 33:10" /><verse number="11" style="v" sid="EZK 33:11" />करीन तु तीमने आहयु के, भगवान यहोवा आसम केय: मारी जीवाय नी ह़ाम, में गलत काम करन्‌या माणहु ने मरवा सी जरीक बी खुस नी हयु, पण आनी सी खुस हयु के गलत काम करन्‌यो माणेह तीनी गलत वाटे गेथो फीरीन जीवत्‌लो रेय; ए ईस्‌रायल ना घोराणा, तमु आह़फा-आह़फाम नी गलत वाटे गेथा फीर जावो; तमु ह़ुका मरवा हींड र्‌या?<verse eid="EZK 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 33:12" />“ए माणेह नी अवल्‌यात, तारा माणहु ने आहयु के, जत्‌यार धरमी माणेह गुनो करे ता तीनो धरम तीने बचाड़ नी सके, अने कदीम गलत काम करन्‌यो माणेह आह़फा ना गलत काम छोड़ देय ता तीहयो तीना कारण सी बच जहे; अने धरमी माणेह कदीम तीहयो पाप करे, ता आह़फा ना धरम ना कारण सी जीवत्‌लो नी रेय। <verse eid="EZK 33:12" /><verse number="13" style="v" sid="EZK 33:13" />कदीम में धरमी ने केम के तु पक्‌को जीवत्‌लो रेही, अने तीहयो आह़फा ना धरम पोर भरहो करीन गलत काम करवा बाज जाय, ता तीना धरम ना कामु मे गेथा काना बी काम नी फोम नी करे; जे गलत काम तीहयो करलो हय तीहयो तीमनीमेत फसलो मरहे। <verse eid="EZK 33:13" /><verse number="14" style="v" sid="EZK 33:14" />अळतेण में जत्‌यार गलत काम करन्‌या माणेह ने केम, तु पक्‌को मरही, अने तीहयो आह़फा ना पाप सी फीरीन नीयाव अने धरम ना काम करवा बाज जाय, <verse eid="EZK 33:14" /><verse number="15" style="v" sid="EZK 33:15" />मतलब गलत काम करन्‌यो माणेह गीरवे राखली चीज पासी आप देय, अने तीहयो लुटली चीज पासी आप देय, अने गलत काम कर्‌या वगर जीवाय आपवा वाळा नेम पोर चालवा बाज जाय, ता तीहयो नी मरे; तीहयो पक्‌को जीवत्‌लो रेहे। <verse eid="EZK 33:15" /><verse number="16" style="v" sid="EZK 33:16" />जेतरा पाप तीहयो करलो हय, तीनी मे गेथा काना बी पाप नी फोम नी करे; तीहयो नीयाव अने धरम ना काम कर्‌यो अने तीहयो पक्‌को जीवत्‌लो रेहे।<verse eid="EZK 33:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 33:17" />“ते बी तमारा माणहु केय, मालीक नी चाल वारु नी हय; पण तीमनीत चाल वारु नी हय। <verse eid="EZK 33:17" /><verse number="18" style="v" sid="EZK 33:18" />जत्‌यार धरमी आह़फाम ना धरम सी फीरीन गलत काम करवा बाज जाय, ता पक्‌को तीहयो तीमनी मे फसलो मर जहे। <verse eid="EZK 33:18" /><verse number="19" style="v" sid="EZK 33:19" />जत्‌यार गलत काम करन्‌यो आह़फा ना गलत कामु सी फीरीन नीयाव अने धरम ना कामु करवा बाज जाय, ता तीहयो तीमना कारण सी जीवत्‌लो रेहे। <verse eid="EZK 33:19" /><verse number="20" style="v" sid="EZK 33:20" />ते बी तमु केवो, ‘मालीक नी चाल वारु नी हय!’ ए ईस्‌रायल नु घोराणु, एक-एक माणेह नो नीयाव तीनी चाल-चलण नीत अनसारे करही।”<verse eid="EZK 33:20" /></para>
  <para style="s">यरुसलेम नी खत्‌तम हयवा नी खबर</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 33:21" />अळतेण अमारी गुलामी ना ग्‌यारवा साल ना दहवा मयना ना पांचवा दाड़े, एक माणेह जे यरुसलेम मे गेथु नाहीन बच जेलु हतु, तीहयु मारीन्‌तां आवीन केवा बाज ज्‌यु, ह़ेर खत्‌तम हय ज्‌यु।<note caller="+" style="x"><char style="xo" closed="false">33:21 </char><char style="xt" closed="false"><ref loc="2KI 25:3-10">2 राजा 25:3-10</ref>; <ref loc="JER 39:2-8">यीरम्‌या 39:2-8</ref>; <ref loc="JER 52:4-14">52:4-14</ref></char></note> <verse eid="EZK 33:21" /><verse number="22" style="v" sid="EZK 33:22" />तीहया नाहीन आव्‌वा वाळा माणेह नी पेले ह़ांतली टेमे यहोवा नी सक्‌ती मारी पोर आयी; अने ह़वारे तक मतलब तीहया माणेह नी आवते लग तीहयी सक्‌ती मारु मोडु उगड़ी देदी; अने मारु मोडु उगड़लुत र्‌यु, अने अळतेण में अळी गुंगो नी र्‌यो।<verse eid="EZK 33:22" /></para>
  <para style="s">माणहु ना पाप</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 33:23" />ता यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 33:23" /><verse number="24" style="v" sid="EZK 33:24" />“ए माणेह नी अवल्‌यात,” ईस्‌रायल नी जागा ना “तीहया उजाड़ी जागा मे रेवा वाळा आहयु केय, ‘अब्‌राहम एकीत माणेह हतो, ते बी देस नो अदीकार्‌यो बण्‌यो; पण आमु ते घणा ढेरका से, आनीन करते देस पक्‌कु अमारात हक मे आप देदलु से।’<verse eid="EZK 33:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 33:25" />“आहया कारण सी तु के, भगवान यहोवा आसम केय: तमु ते मांह ने लोय भेळ खावो अने आह़फाम ना मुरत्‌या भणीन नींगा नाखो, अने तमु हत्‌या करो, ता ह़ु तमु तीहया देस ना अदीकार्‌या री सकहु? <verse eid="EZK 33:25" /><verse number="26" style="v" sid="EZK 33:26" />तमु आह़फा-आह़फाम नी तलवार पोर भरहो करो अने गलत काम करो, अने आह़फा-आह़फाम ना ह़ाते वाळा नी लाडी ने वीटाळो: ता ह़ु तमु तीहया देस ना अदीकार्‌या री सकहु?<verse eid="EZK 33:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="EZK 33:27" />“तु तीमने आहयु के, भगवान यहोवा आसम केय: मारी जीवाय नी ह़ाम, सण्‌का कर्‌या वगर जे माणहु उजाड़ जागा मे री र्‌या, तीहया तलवार वेर मरहे, अने जे अदमी खेतर मे रेहे, तीने में जंगली जानवरु नो सीकार बणाय देही, अने जे कीला अने दोरु मे रेय, तीहया मोट्‌ली बीमारी सी मरहे। <verse eid="EZK 33:27" /><verse number="28" style="v" sid="EZK 33:28" />में तीहया देस ने उजाड़ेत उजाड़ कर देही; अने तीनी ताखत नी घमंड जत रेहे; अने ईस्‌रायल ना बड़ा आसम उजड़हे के तीमनी मे हय्‌न कोय बी नी चाले। <verse eid="EZK 33:28" /><verse number="29" style="v" sid="EZK 33:29" />करीन जत्‌यार में तीहया माणहु ना करला आखा गलत कामु का कारण सी तीहया देस ने उजाड़ेत उजाड़ कर देही, ता तीहया जाण लेहे के में यहोवा से।”<verse eid="EZK 33:29" /></para>
  <para style="s">भगवान वगे गेथी वात केण्‌या नी खबर नो परीणाम</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 33:30" />“ए माणेह नी अवल्‌यात, तारा माणहु भीतड़ान्‌तां अने घोरु ना झापले तारा बारा मे वात करे अने एक-बीजा ने केय, ‘आवो, ह़मळो, के यहोवा भणी गेथो कानो बोल नीकळे।’ <verse eid="EZK 33:30" /><verse number="31" style="v" sid="EZK 33:31" />तीहया माणहुन तेम तारीन्‌तां आवे अने मारा माणहु बणीन तारी अगळ बहीन तारा बोलु ह़मळे, पण तीहया तीनी पोर चालता नी; मोडा सी ते तीहया घणा मोंग देखाड़े, पण तीमनु मन लालच मेत लागलु रेय। <verse eid="EZK 33:31" /><verse number="32" style="v" sid="EZK 33:32" />तु तीमनी नींगा मे मोंग ना वारला गीत गाव्‌वा वाळान तेवो अने वारला वजवाळीन तेवो ठेरलो से, काहाके तीहया तारा बोलु ह़मळते ते खरा, पण तीमनी पोर चाले नी। <verse eid="EZK 33:32" /><verse number="33" style="v" sid="EZK 33:33" />करीन जत्‌यार आहयी वात पुरी हयहे, अने तीहयी पक्‌की पुरी हयहे! ता तीहया जाण लेहे के अमारी वच मे एक भगवान वगे गेथी वात केवा वाळो आवलो हतो।”<verse eid="EZK 33:33" /></para>
  <chapter eid="EZK 33" />
  <chapter number="34" style="c" sid="EZK 34" />
  <para style="s">ईस्‌रायल ना गुवाळ्‌या</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 34:1" />यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 34:1" /><verse number="2" style="v" sid="EZK 34:2" />ए माणेह नी अवल्‌यात, ईस्‌रायल ना गुवाळ्‌या ना वीरोद मे भगवान वगे गेथी वात कीन तीहया गुवाळ्‌या ने के, भगवान यहोवा आसम केय: गरा आय पड़े ईस्‌रायल ना गुवाळ्‌या पोर जे आह़फा-आह़फाम ना पेट भरे! ह़ु गुवाळ्‌या ने गाडरा-बोकड़ा नु पेट नी भरवा जोवे? <verse eid="EZK 34:2" /><verse number="3" style="v" sid="EZK 34:3" />तमु चर्‌बी खावो, हीर पेरो अने मोटा-मोटा जानवरु ने मारो; पण गाडरा-बोकड़ा ने तमु नी चारो। <verse eid="EZK 34:3" /><verse number="4" style="v" sid="EZK 34:4" />तमु मांदला ने ताखत वाळा नी बणाया, अने नी मांदला ने आरगा कर्‌या, अने नी घाव लागला ना घावु ने पट्‌टी बांद्‌या, तमु भटकला ने पासा नी लाया। अने नी खोवायला ने ह़ोद्‌या, पण तमु ताखत अने जबरजस्‌ती अदीकार चलाड़ला से। <verse eid="EZK 34:4" /><verse number="5" style="v" sid="EZK 34:5" />तीहया गुवाळ्‌यो नी रेवा ना कारण सी रीवण्‌या-तीवण्‌या हय ज्‌या; अने आखा जंगल ना जानवरु नु खाणु बण ज्‌या।<note caller="+" style="x"><char style="xo" closed="false">34:5 </char><char style="xt" closed="false"><ref loc="NUM 27:17">गीनती 27:17</ref>; <ref loc="1KI 22:17">1 राजा 22:17</ref>; <ref loc="MAT 9:36">मत्‌ती 9:36</ref>; <ref loc="MRK 6:34">मरकुस 6:34</ref></char></note> <verse eid="EZK 34:5" /><verse number="6" style="v" sid="EZK 34:6" />मारा गाडरा-बोकड़ा रीवण्‌या-तीवण्‌या हयला से; तीहया आखा बड़ा अने उचा-उचा बड़्‌या पोर भटक र्‌या; मारा गाडरा-बोकड़ा आखी धरती नी उपर रीवण्‌या-तीवण्‌या हया; अने नी कोय तीमनी फोम करवा वाळु हतु, अने नी कोय तीमने ह़ोद्‌यु।<verse eid="EZK 34:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 34:7" />“आहया कारण सी, ए गुवाळ्‌या, यहोवा नो आहयो बोल ह़मळो। <verse eid="EZK 34:7" /><verse number="8" style="v" sid="EZK 34:8" />भगवान यहोवा आसम केय, मारा जीवाय नी ह़ाम, मारा गाडरा-बोकड़ा जे लुटाय जेला से, अने गाडरा-बोकड़ा जे गुवाळ्‌यो नी हयवा ना कारण सी जे आखा जंगल ना जानवरु नु खाणु बण जेला; अने आनीन करते के मारा गुवाळ्‌या मारा गाडरा-बोकड़ा नी खबर नी लेदा, अने मारा गाडरा-बोकड़ा नु पेट नी, पण आह़फाम नु पेट भर्‌या। <verse eid="EZK 34:8" /><verse number="9" style="v" sid="EZK 34:9" />आहया कारण सी ए गुवाळ्‌या, यहोवा नो आहयो बोल ह़मळो, <verse eid="EZK 34:9" /><verse number="10" style="v" sid="EZK 34:10" />भगवान यहोवा आसम केय देखो, में गुवाळ्‌या ना वीरोद मे से अने में तीमनी पांह मारा गाडरा-बोकड़ा नो लेखो लेही, अने अळी तीमने पासा चारवा नी देम; तीहया अळतेण आह़फा-आह़फाम नु पेट भरी नी सके। में मारा गाडरा-बोकड़ा ने तीमना मोडा मे गेथा छोड़ावही के अगा चालीन तीहया तीमनु खाणु नी बणे।<verse eid="EZK 34:10" /></para>
  <para style="s">वारलो गुवाळ्‌यो</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 34:11" />“काहाके भगवान यहोवा आसम केय देखो, में खुदेत मारा गाडरा-बोकड़ा नी खबर लेही, अने तीमने ह़ोदही। <verse eid="EZK 34:11" /><verse number="12" style="v" sid="EZK 34:12" />जेम गुवाळ्‌यो आह़फा ना गाडरा-बोकड़ा मे गेथा भटकला ने पासो आह़फा ना टोळा मे एक्‌ठो करे, तेमेत में बी मारा गाडरा-बोकड़ा ने एक्‌ठा करही; में तीमने तीहया आखा जागे गेथा नीकाळ लावही, जां-जां तीहया वादळा अने घणु अंदारलु ना दाड़े रीवण्‌या-तीवण्‌या हय जेला हता। <verse eid="EZK 34:12" /><verse number="13" style="v" sid="EZK 34:13" />में तीमने देस-देस ना माणहु मे गेथा नीकाळही, अने देस-देस मे गेथा एक्‌ठा करही, अने तीमनात खुद ना जागा मे ली आवही; अने ईस्‌रायल ना बड़ाम नी पोर अने कोतड़ा मे अने तीहया देस ना आखा वह़ला जागा मे चारही। <verse eid="EZK 34:13" /><verse number="14" style="v" sid="EZK 34:14" />में तीमने वारला चरवा ना जागा मे चारही, अने ईस्‌रायल ना उचा-उचा बड़ा पोर तीमने वारलो चरवा नो जागो जड़हे; ता तीहया वारलु लील्‌लु-लील्‌लु मे बह्‌या करहे, अने ईस्‌रायल ना बड़ा पोर वारु सी वारु चरवा ना जागा मे चरहे। <verse eid="EZK 34:14" /><verse number="15" style="v" sid="EZK 34:15" />में खुदेत मारा गाडरा-बोकड़ा नो गुवाळ्‌यो रेही, अने में खुदेत तीमने बहाड़ही, भगवान यहोवा आसमेत केय।<verse eid="EZK 34:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 34:16" />“में खोवायला ने ह़ोदही, अने भटकला ने पासो ली आवही, अने घाव लागला ना घाव पोर पट्‌टी बांदही, अने मांदला ने ताखत वाळा बणावही अने जे माता अने ताखत वाळा से तीमने मे खत्‌तम करही; में तीमनु चरावणु नीयाव सी करही।<verse eid="EZK 34:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 34:17" />“ए मारा टोळा, तमु ने भगवान यहोवा आसम केय देखो, में गाडरा-गाडरा नी वच मे अने गाडरा अने बोकड़ा नी वच मे नीयाव करु। <verse eid="EZK 34:17" /><verse number="18" style="v" sid="EZK 34:18" />ह़ु तमने आहयी नान्‌ली वात मालम पड़े के तमु वारला चरवा ना जागा मे चर लेवो अने बचला वारला चरवा ना जागा ने आह़फाम ना पोगु वेर रोंदळो; ह़ु तमने आहयु नान्‌ली वात मालम पड़े के तमु आसलु पाणी पी लेवो अने बचलु पाणी ने आह़फाम ना पोगु वेर डोहळु करो? <verse eid="EZK 34:18" /><verse number="19" style="v" sid="EZK 34:19" />ह़ु मारा गाडरा-बोकड़ा ने तमारा पोगु सी रोंदळला ने चरवा, अने तमारा पोगु वेर डोहळु करलु पाणी ने पीवा पड़हे?<verse eid="EZK 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 34:20" />“आहया कारण सी भगवान यहोवा तीमने आहयु केय: देखो, में खुद माता अने कमजोर गाडरा-बोकड़ा नी वच मे नीयाव करही। <verse eid="EZK 34:20" /><verse number="21" style="v" sid="EZK 34:21" />तमु जे आखा मांदला ने पाहळी अने खबा सी आञे तक धेकलो अने ह़ींगड़ा वेर आसम मारो के तीहया रीवण्‌या-तीवण्‌या हय जाय, <verse eid="EZK 34:21" /><verse number="22" style="v" sid="EZK 34:22" />आहया कारण सी में मारा गाडरा-बोकड़ा ने छोड़ावही, अने तीहया तमारु खाणु नी बणे, अने में गाडरा-गाडरा अने बोकड़ा-बोकड़ा नी वच मे नीयाव करही। <verse eid="EZK 34:22" /><verse number="23" style="v" sid="EZK 34:23" />में तीमनी जुगु एक एवो गुवाळ्‌यो ठेरावही जे तीमनी गुवाळी करहे, तीहयो मारो चाकर्‌यो दावुद रेहे, तीहयोत तीमने चारहे, अने तीहयोत तीमनो गुवाळ्‌यो रेहे। <verse eid="EZK 34:23" /><verse number="24" style="v" sid="EZK 34:24" />में यहोवा तीमनो भगवान ठेरही, अने मारो चाकर्‌यो दावुद तीनी वच मे मुख्‌यो रेहे; में यहोवात आहयु केदलो से।<verse eid="EZK 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 34:25" />“में तीमनी ह़ाते सांती नो वायदो करही, अने जंगली जानवरु ने देस मे नी रेवा देम; अने तीहया जंगल मे बीह्‌या वगर रेहे, अने जंगल मे ह़ुवहे।<verse eid="EZK 34:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="EZK 34:26" />“में तीमने अने मारा बड़्‌या नी आड़े-धेड़े नी आखी जागा ने बरकत नो कारण बणाय देही; अने पाणी ने में टेम पोर पाड़्‌या करही; अने तीहयो बरकत नो पाणी रेहे। <verse eid="EZK 34:26" /><verse number="27" style="v" sid="EZK 34:27" />मेदान ना झाड़का फालहे अने जागो आह़फी नी मेर उगाड़हे, अने तीहया आह़फाम ना देस मे बीह्‌या वगर रेहे; जत्‌यार में तीहया वळा ने तोड़ीन तीहया माणहु ना हात मे गेथो छोड़ावही, जे तीमने चाकरी करावे, ता तीहया जाण लेहे के में यहोवा से। <verse eid="EZK 34:27" /><verse number="28" style="v" sid="EZK 34:28" />अळतेण तीमने राज्‌य-राज्‌य नी लुटे, अने नी तीमने जंगल मे वाळा जानवर खाय; तीहया बीह्‌या वगर रेहे, अने तीमने कोय नी बीहाड़े। <verse eid="EZK 34:28" /><verse number="29" style="v" sid="EZK 34:29" />तीमनी जुगु पकाड़वा वाळी वाड़ी उबजाड़ही, अने तीहया देस मे अळी भुकला नी मरे, अने नी राज्‌य-राज्‌य ना माणहु अळी तीनो वाक काडे। <verse eid="EZK 34:29" /><verse number="30" style="v" sid="EZK 34:30" />तीहया जाणहे के में भगवान यहोवा तीमनी ह़ाते से, अने तीहया जे ईस्‌रायल ना घोराणा से, तीहया मारा माणहु से, में यहोवा आसमेत केम।<verse eid="EZK 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="EZK 34:31" />“तमु ते मारा गाडरा-बोकड़ा, मारा चारवा ना जागा ना गाडरा-बोकड़ा से, तमु ते माणहु से, अने में तमारो भगवान से,” भगवान यहोवा आसमेत केय।<verse eid="EZK 34:31" /></para>
  <chapter eid="EZK 34" />
  <chapter number="35" style="c" sid="EZK 35" />
  <para style="s">एदोम ने भगवान डंड आपे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 35:1" />यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो। <verse eid="EZK 35:1" /><verse number="2" style="v" sid="EZK 35:2" />“ए माणेह नी अवल्‌यात,” आह़फा नु मोडु “सेईर बड़ा भणीन करीन तीना वीरोद मे भगवान वगे गेथी वात के। <verse eid="EZK 35:2" /><verse number="3" style="v" sid="EZK 35:3" />अने तीने के, भगवान यहोवा आसम केय</para>
  <para style="q1" vid="EZK 35:3">“ए सेईर बड़ा, में तारा वीरोद मे से;</para>
  <para style="q1" vid="EZK 35:3">अने मारो हात तारा वीरोद मे बड़ावीन तने उजाड़ेत उजाड़ कर देही!<verse eid="EZK 35:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="EZK 35:4" />में तारा ह़ेरु ने उजाड़ कर देही</para>
  <para style="q1" vid="EZK 35:4">अने तु उजाड़ हय जही;</para>
  <para style="q1" vid="EZK 35:4">ता तु जाण लेही के में यहोवा से।”<verse eid="EZK 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 35:5" />“काहाके तु ईस्‌रायलीम नी ह़ाते जलमकी दुस्‌मनी राखतो हतो, अने तीमनी गरा नी टेमे जत्‌यार तीमना अधरम ना डंड नी टेम आयी, ता तीमने तलवार वेर मारवा करीन आप देदो। <verse eid="EZK 35:5" /><verse number="6" style="v" sid="EZK 35:6" />करीन भगवान यहोवा आसम केय: मारी जीवाय नी ह़ाम, में तने हत्‌या करवा करीन तीयार करही अने लोय तारी पसळ पड़हे; तु ते लोय सी ह़ीगी नी करतो हतो, आहया कारण सी लोय तारी पसळ पड़हे। <verse eid="EZK 35:6" /><verse number="7" style="v" sid="EZK 35:7" />आहयी रीते में सेईर बड़ा ने उजाड़ेत उजाड़ कर देही, अने जे तीनी में आवतु-जतु हय, में तीने खत्‌तम करही। <verse eid="EZK 35:7" /><verse number="8" style="v" sid="EZK 35:8" />में तीना बड़ा ने मारला सी भर देही; तारा टेकड़ा, घाट्‌या, अने आखा कोतड़ा मे तलवार वेर मरला पड़हे। <verse eid="EZK 35:8" /><verse number="9" style="v" sid="EZK 35:9" />में तने जलमकु उजाड़ कर देही, अने तारा ह़ेर पासा नी वहे। ता तमु जाण लेहु के में यहोवा से।<verse eid="EZK 35:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 35:10" />“काहाके तु केदलो से, आहया बेम राज्‌य अने आहया बेम देस मारा रेहे; अने आमुत तीना मालीक बण जहु, पण यहोवा तां हतो। <verse eid="EZK 35:10" /><verse number="11" style="v" sid="EZK 35:11" />आहया कारण सी, भगवान यहोवा आसम केय, मारी जीवाय नी ह़ाम, तारी रीह नी अनसारे, अने जे खीज तु तीमनी पोर तारी दुस्‌मनी का कारण सी करलो से, तीनीत अनसारे में तारी ह़ाते वेहवार करही, अने जत्‌यार में तारो नीयाव करही, ता में तमारी मे खुद ने उजन्‌तो करही। <verse eid="EZK 35:11" /><verse number="12" style="v" sid="EZK 35:12" />तु जाणही के में यहोवा तारी आखी नीकारा नी वात ह़मळलो से, जे तु ईस्‌रायल ना बड़ा ना बारा मे केदलो, ‘तीहया ते उजड़ ज्‌या, तीहया आमनेत आपला से के आमु तीमने खाय जीया।’ <verse eid="EZK 35:12" /><verse number="13" style="v" sid="EZK 35:13" />तु मारा वीरोद मे आह़फा नु मोडु सी मोटी-मोटी वात कर्‌यो, अने मारा वीरोद मे घणी वात केदलो से, आने में ह़मळलो से।”<verse eid="EZK 35:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 35:14" />भगवान यहोवा आसम केय, “जत्‌यार आखी धरती पोर खुसी रेहे, ता में तने उजाड़ करही। <verse eid="EZK 35:14" /><verse number="15" style="v" sid="EZK 35:15" />तु ईस्‌रायल ना खुद ना वाटा ने उजड़ जवा ना कारण सी खुस हयो, करीन में बी तारी ह़ाते तेमेत करही; ए सेईर बड़ा, ए एदोम ना आखु देस, तु उजड़ जही। ता तीहया जाण लेहे के में यहोवा से।”<verse eid="EZK 35:15" /></para>
  <chapter eid="EZK 35" />
  <chapter number="36" style="c" sid="EZK 36" />
  <para style="s">ईस्‌रायल पोर भगवान नी बरकत</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 36:1" />“अळी ए माणेह नी अवल्‌यात, तु ईस्‌रायल ना बड़ा ने भगवान वगे गेथी वात कीन के, ए ईस्‌रायलु ना बड़ा, यहोवा नो बोल ह़मळो, <verse eid="EZK 36:1" /><verse number="2" style="v" sid="EZK 36:2" />भगवान यहोवा आसम केय, दुस्‌मन ते तमारा बारा मे केदला से, ओहोय! पेल्‌ना वारा ना उचला जागा हाव अमारा अदीकार मे आय जेला से!<verse eid="EZK 36:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EZK 36:3" />“आहया कारण सी भगवान वगे गेथी वात कीन के, भगवान यहोवा आसम केय: माणहु जे तमने उजाड़्या अने च्‌यारो-मेर गेथा जे तमने आसम गळ ज्‌या के तमु बचलु राज्‌य ना अदीकार मे हय जावो, अने लुटवा वाळा तमारी वात करे अने बीजा माणहु तमारो वाक काडे, <verse eid="EZK 36:3" /><verse number="4" style="v" sid="EZK 36:4" />आहया कारण सी, ए ईस्‌रायल ना बड़ा, भगवान यहोवा नो बोल ह़मळो, भगवान यहोवा तमने आसम केय: मतलब बड़ा अने बड़्‌या ने, अने कोतड़ा अने घाट्‌या ने, अने उजड़ला जागा ने अने ह़ुनह़ान ह़ेरु ने जे च्‌यारो-मेर नु बचलु राज्‌य सी लुटाय ज्‌या अने तीमना हाह़वा नो कारण बण जेला से।<verse eid="EZK 36:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 36:5" />“भगवान यहोवा आसम केय: पक्‌को में मारी घण-जबर रीह मे बचला राज्‌य ना अने आखा एदोम ना वीरोद मे केदलो से के जे मारा देस ने आह़फाम ना मन ना पुरा आनन्‌द अने घमंड सी आह़फाम ना अदीकार मे करला से के तीहया पारका हय्‌न लुटाय जाय।<verse eid="EZK 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 36:6" />“आहया कारण सी ईस्‌रायल ना देस ना बारा मे भगवान वगे गेथी वात कीन बड़ा, बड़्‌या, कोतड़ा अने घाट्‌या ने के, भगवान यहोवा आसम केय: देखो, राज्‌य तमारो वाक काड्‌यु तीने तमु वेठला से, करीन में घण-जबर खीजवाय्‌न केदलो से। <verse eid="EZK 36:6" /><verse number="7" style="v" sid="EZK 36:7" />भगवान यहोवा आसम केय: में आहयु ह़ाम खादलो से के सण्‌का कर्‌या वगर तमारी च्‌यारो-मेर जे आखु राज्‌य से, तीमने आह़फाम नो वाक खुदेत वेठवा पड़हे। <verse eid="EZK 36:7" /><verse number="8" style="v" sid="EZK 36:8" />पण ए ईस्‌रायल ना बड़ा, तमारी पोर नवला-नवला डाळ्‌या फुटहे अने तीमना फोळ मारा माणहु ईस्‌रायल जुगु फालहे; काहाके तीमनु पासु आवणु ह़ाते से। <verse eid="EZK 36:8" /><verse number="9" style="v" sid="EZK 36:9" />देखो, में तमारी ह़ोड़ से, अने तमारी भणीन दया नी नींगा नाखही, अने तमु खेती-वाड़ी करहु। <verse eid="EZK 36:9" /><verse number="10" style="v" sid="EZK 36:10" />अने में तमारी पोर घणा माणहु ने मतलब ईस्‌रायल ना आखा घोराणा ने वहाड़ही; अने ह़ेर ने अळी वहाड़हे अने उजाड़ी जागा ने अळी बणावहे। <verse eid="EZK 36:10" /><verse number="11" style="v" sid="EZK 36:11" />में तमारी पोर माणहु अने जानवरु बेम जणा ने घणो बड़ावही, अने तीहया बड़हे अने फुलहे-फालहे, अने में तमने पेल्‌ना वारामनान तेम वहाड़ही, अने पेले गेथो जादा तमारी भलाय करही। ता तमु जाण लेहु के में यहोवा से। <verse eid="EZK 36:11" /><verse number="12" style="v" sid="EZK 36:12" />में आसम करही के माणहु मतलब मारा माणहु ईस्‌रायल तमारी पोर चालहे-फीरहे, अने तीहया तारा मालीक बणहे, अने तमु तीमनो वाटो रेहु, अने तीहया अळी तमारा कारण अवल्‌यात वगर ना नी रेय।<verse eid="EZK 36:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 36:13" />“भगवान यहोवा आसम केय, जे माणहु तमु ने कीया करे, तु माणहु ने खावा वाळु से, अने तारी पोर वहला राज्‌य ने अवल्‌यात वगर नो कर देय। <verse eid="EZK 36:13" /><verse number="14" style="v" sid="EZK 36:14" />करीन हाव तु माणहु ने नी खाय, अने नी आह़फु पोर वहला राज्‌य ने वण अवल्‌यात नो करे, भगवान यहोवा आसमेत केय। <verse eid="EZK 36:14" /><verse number="15" style="v" sid="EZK 36:15" />में अळतेण राज्‌य-राज्‌य ना माणहु सी तारो वाक नी ह़मळावु, अने तने राज्‌य-राज्‌य भणी गेथु अळी नामबद्‌दी नी वेठवा पड़े, अने तारी पोर वहलु राज्‌य ने तु ठोकर नी खवाड़े, भगवान यहोवा आसमेत केय।”<verse eid="EZK 36:15" /></para>
  <para style="s">ईस्‌रायल नी नवली जीवाय</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 36:16" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो, <verse eid="EZK 36:16" /><verse number="17" style="v" sid="EZK 36:17" />“ए माणेह नी अवल्‌यात,” “जत्‌यार ईस्‌रायल नु घोराणु आह़फाम ना देस मे रेतु हतु, ता आह़फाम नी चाल-चलण अने कामु नी लारे तीहया तीने वीटाळ देता हता; तीमनी चाल-चलण मने मयनो आवली बयर नु वीटळ्‌ळुन तेवी मालम पड़ती हती। <verse eid="EZK 36:17" /><verse number="18" style="v" sid="EZK 36:18" />करीन जे हत्‌या तीहया देस मे कर्‌या, अने देस ने मुरत्‌या नी लारे वीटाळ देदा, आहया कारण सी तीमनी पोर में मारी रीह नीकाळलो हतो। <verse eid="EZK 36:18" /><verse number="19" style="v" sid="EZK 36:19" />में तीमने राज्‌य-राज्‌य मे रीवण्‌या-तीवण्‌या कर्‌यो, अने तीहया देस-देस मे खोळवाय ज्‌या; तीमनी चाल-चलण अने कामु नी अनसारे में तीमने डंड आप्‌यो। <verse eid="EZK 36:19" /><verse number="20" style="v" sid="EZK 36:20" />पण जत्‌यार तीहया ते राज्‌य मे पुग्‌या, जीमनी मे तीमनी मे पुगाड़्‌या, ता तीहया मारा चोखला नाम ने वीटळ्‌ळु ठेराया, काहाके माणहु तीमना बारा मे आहयु केवा बाज ज्‌या, ‘आहया यहोवा ना माणहु से, पण तीना देस मे गेथा नीकाळ देदला से।’ <verse eid="EZK 36:20" /><verse number="21" style="v" sid="EZK 36:21" />पण में मारा चोखला नाम नी फोम कर्‌यो, जे ईस्‌रायल ना घोराणा तीहया राज्‌य नी वच मे वीटळ्‌ळु ठेरावला हता, जां तीहया जेला हता।<verse eid="EZK 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="EZK 36:22" />“आहया कारण सी तु ईस्‌रायल ना घोराणा ने के, भगवान यहोवा आसम केय ए ईस्‌रायल ना घोराणा, में आहयु काम तमारा कारण सी नी, पण मारा चोखला नाम नी जुगु करु जीने तमु तीहया राज्‌य मे वीटळ्‌ळु ठेराया जां तमु जेला हता। <verse eid="EZK 36:22" /><verse number="23" style="v" sid="EZK 36:23" />में मारु मोटु नाम ने चोखलु ठेरावही, जे राज्‌य मे वीटळ्‌ळु ठेरावला से, जीने तमु तीमनी वच मे वीटाळला; अने जत्‌यार में तीमनी नींगा मे तमारी वच मे चोखलो ठेरही, ता तीहया राज्‌य जाण लेहे के में यहोवा से, भगवान यहोवा आसमेत केय। <verse eid="EZK 36:23" /><verse number="24" style="v" sid="EZK 36:24" />में तमु ने राज्‌य मे गेथा नीकाळ लेही, अने आखा देसु मे गेथा एक्‌ठा करही; अने तमु ने तमारा आह़फाम ना देस मे पुगाड़ देही। <verse eid="EZK 36:24" /><verse number="25" style="v" sid="EZK 36:25" />में तमारी पोर चोखलु पाणी छाटही, अने तमु चोखा हय जहु; अने में तमने तमारी आखी वीटळ अने मुरत्‌या सी चोखो करही। <verse eid="EZK 36:25" /><verse number="26" style="v" sid="EZK 36:26" />में तमने नवलु मन आपही, अने तमारी मोय नवली आत्‌मा पयदा करही, अने तमारा डील मे गेथु दगड़ा नु दील नीकाळीन तमने मांह नु दील आपही।<note caller="+" style="x"><char style="xo" closed="false">36:26 </char><char style="xt" closed="false"><ref loc="EZK 11:19">यहेजकेल 11:19</ref>; <ref loc="2CO 3:3">2 कुरन्‌थी 3:3</ref></char></note> <verse eid="EZK 36:26" /><verse number="27" style="v" sid="EZK 36:27" />में मारी आत्‌मा तमारी मे आपीन आसम करही के तमु मारी रीती पोर चालहु अने मारा नेमु ने मानीन तीमनी अनसारे करहु। <verse eid="EZK 36:27" /><verse number="28" style="v" sid="EZK 36:28" />तमु तीहया देस मे वहहु जे में तमारा बाहु ने आपलो हतो; अने तमु मारा माणहु ठेरहु, अने में तमारो भगवान ठेरही। <verse eid="EZK 36:28" /><verse number="29" style="v" sid="EZK 36:29" />में तमने तमारी आखी वीटळ सी छोड़ावही, अने अन उगवा नो हुकम आपही, तीने बड़ावही अने तमारी वच मे काळ नी पड़वा देम। <verse eid="EZK 36:29" /><verse number="30" style="v" sid="EZK 36:30" />में झाड़ु ना फोळ अने खेतर नी मेर बड़ावही, के राज्‌य मे काळ ना कारण सी अळी तमारु नामबद्‌दी नी हये। <verse eid="EZK 36:30" /><verse number="31" style="v" sid="EZK 36:31" />ता तमु आह़फाम नी बुरी चाल-चलण अने आह़फाम ना कामु ने जे वारला नी हता, फोम करीन आह़फाम ना अधरम अने गलत कामु ना कारण सी आह़फाम नी सी ह़ीगी करहु। <verse eid="EZK 36:31" /><verse number="32" style="v" sid="EZK 36:32" />भगवान यहोवा आसमेत केय, तमु जाण लेहु के में आने तमारी जुगु नी करतो। ए ईस्‌रायल ना घोराणा आह़फा नी चाल-चलण ना बारा मे लाजे पड़ो अने तमारो मुख काळो हय जाय।”<verse eid="EZK 36:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="EZK 36:33" />भगवान यहोवा आसम केय, “जत्‌यार में तमने तमारा आखा अधरम ना कामु सी चोखा करही, ता तमारा ह़ेरु ने वहाड़ही; अने तमारा उजाड़ी जागा ने पासा बणावहे। <verse eid="EZK 36:33" /><verse number="34" style="v" sid="EZK 36:34" />तमारु देस जे आखा आव्‌वा-जवा वाळा नी अगळ उजाड़ से, तीहयु उजाड़ हयवा ना बदले जोपहे-वेरहे। <verse eid="EZK 36:34" /><verse number="35" style="v" sid="EZK 36:35" />माणहु कीया करहे, आहयु देस जे उजाड़ हतु, तीहयु अदन बगीचान तेवु हय ज्‌यु, अने जे ह़ेरु ह़ुनह़ान अने उजाड़ हय जेला अने ओदर जेला हता, तीहया कीला वाळा बण्‌या, अने वहाड़ला से। <verse eid="EZK 36:35" /><verse number="36" style="v" sid="EZK 36:36" />ता जे राज्‌य तमारी आड़े-धेड़े बचला रेहे, तीहयी जाण लेहे के में यहोवा ओदारलु ने अळी बणायो, अने उजाड़ मे झाड़का रोपला से, में यहोवा आहयु केदो, अने आसमेत करही।”<verse eid="EZK 36:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="EZK 36:37" />भगवान यहोवा आसम केय, “ईस्‌रायल ना घोराणा मे अळी मारी पांह वीन्‌ती करहे के में तीमनी जुगु आहयु करु; मतलब में तीमनी मे माणहु नी गीनती गाडरा-बोकड़ान तेम बड़ावु। <verse eid="EZK 36:37" /><verse number="38" style="v" sid="EZK 36:38" />जेम चोखली टेम ना गाडरा-बोकड़ा, मतलब टाकला तीवार नी टेम पोर यरुसलेम मे ना गाडरा-बोकड़ा गीणाय नी एतरा रेय तेमेत जे ह़ेर हाव उजाड़ से तीहया गीणाय नी एतरा माणहु ना टोळा सी भराय जहे। ता तीहया जाण लेहे के में यहोवा से।”<verse eid="EZK 36:38" /></para>
  <chapter eid="EZK 36" />
  <chapter number="37" style="c" sid="EZK 37" />
  <para style="s">ह़ुकला हाटका नी घाटी</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 37:1" />यहोवा नी सक्‌ती मारी पोर हयी, अने तीहयो मारी मे आह़फा नी आत्‌मा ने ह़माड़ीन बाहर ली ज्‌यो अने मने घाटी नी वच मे उबो कर देदो; तीहयी घाटी हाटका सी भरली हती। <verse eid="EZK 37:1" /><verse number="2" style="v" sid="EZK 37:2" />ता तीहयो मने च्‌यारो-मेर फीरव्‌यो, अने घाटी नी जागा पोर घणा हाटका हता; अने तीहया घणा ह़ुकला हता। <verse eid="EZK 37:2" /><verse number="3" style="v" sid="EZK 37:3" />ता तीहयो मने पुछ्‌यो, “ए माणेह नी अवल्‌यात, ह़ु आहया हाटका जीव सके?”</para>
  <para style="p" vid="EZK 37:3">में केदो, “ए भगवान यहोवा, तुत जाणे।”<verse eid="EZK 37:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 37:4" />ता तीहयो मने केदो, “आहया हाटका ने भगवान वगे गेथी वात कीन के, ए ह़ुकला हाटका भगवान नो बोल ह़मळो। <verse eid="EZK 37:4" /><verse number="5" style="v" sid="EZK 37:5" />भगवान यहोवा तमु हाटका ने आसम केय: देखो, में खुद तमारी मे ह़ाह़ ह़माड़ही, अने तमु जीव उठहु। <verse eid="EZK 37:5" /><verse number="6" style="v" sid="EZK 37:6" />में तमारी नेह उबजाड़ीन हाटका मे मांह भरही। अने तमु ने चामड़ु वेर ढाकही; अने तमारी मे ह़ाह़ ह़माड़ही, ता तमु जीव उठहु; अने तमु जाण लेहु के में यहोवा से।”<verse eid="EZK 37:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 37:7" />आहया हुकम नी अनसारे में भगवान वगे गेथी वात केवा बाज ज्‌यो; अने में भगवान वगे गेथी वात केवात बाज र्‌यो हतो, ता एक अवाज ह़मळायी, अने ज्‌योरेत अवाज आयी, अने तीहया हाटका एक्‌ठा हय्‌न हाटकु सी हाटकु जोड़ाय ज्‌या। <verse eid="EZK 37:7" /><verse number="8" style="v" sid="EZK 37:8" />में देखतो र्‌यो, के तीमनी मे नेहटा अने मांह भराय ज्‌यु, अने तीहया आखा उपर चामड़ा वेर ढकाय ज्‌या; पण तीमनी मे जीवाय नी ह़ाह़ नी हती।<verse eid="EZK 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 37:9" />ता तीहयो मने केदो, “ए माणेह नी अवल्‌यात, ह़ाह़ ने भगवान वगे गेथी वात करीन के, ए ह़ाह़ भगवान यहोवा आसम केय: च्‌यारो-मेर गेथी आवीन आहया आखा मारला मे ह़माय जा के आहया जीव उठे।”<verse eid="EZK 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 37:10" />तीना आहया हुकम नी अनसारे में भगवान वगे गेथी वात केदो, ता ह़ाह़ तीमनी मे आय जी, अने तीहया जीवीन आह़फा-आह़फाम ना पोगु ना भरहे उबा हय ज्‌या; अने एक घणी मोटी सेना बण जी।<note caller="+" style="x"><char style="xo" closed="false">37:10 </char><char style="xt" closed="false"><ref loc="REV 11:11">परकासीतवाक्‌य 11:11</ref></char></note><verse eid="EZK 37:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 37:11" />अळतेण तीहयो मने केदो, “ए माणेह नी अवल्‌यात, आहया हाटका मानो ईस्‌रायल नु आखु घोराणु से। तीहया केय, अमारा हाटका ह़ुक ज्‌या, अने अमारी आह खत्‌तम हय जी; आमु पुरी रीते खत्‌तम हय जेला से। <verse eid="EZK 37:11" /><verse number="12" style="v" sid="EZK 37:12" />करीन भगवान वगे गेथी वात करीन तीमने के, भगवान यहोवा आसम केय: ए मारा माणहु, देखो, में तमारा मड़ाट्‌या उगाड़ीन तमने तीमनी मे गेथा नीकाळही, अने ईस्‌रायल ना देस मे पुगाड़ देही। <verse eid="EZK 37:12" /><verse number="13" style="v" sid="EZK 37:13" />एतरे जत्‌यार में तमारा मड़ाट्‌या उगाड़ु, अने तमु ने तीमनी मे गेथा नीकाळही, ता ए मारा माणहु, तमु जाण लेहु के में यहोवा से। <verse eid="EZK 37:13" /><verse number="14" style="v" sid="EZK 37:14" />में तमारी मे मारी आत्‌मा ह़माड़ही, अने तमु जीवहु; अने तमने तमारा खुद ना देस मे वहाड़ही; ता तमु जाण लेहु के में यहोवात आहयु केदलो, अने करलो बी से, यहोवा आसमेत केय।”<verse eid="EZK 37:14" /></para>
  <para style="s">यहुदा अने ईस्‌रायल एकीत राज्‌य</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 37:15" />अळतेण यहोवा नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 37:15" /><verse number="16" style="v" sid="EZK 37:16" />“ए माणेह नी अवल्‌यात,” एक लाकड़ी लीन तीनी पोर लीख, “यहुदा नी अने तीनी ह़ाते वाळा ईस्‌रायल नी, अने अळतेण बीजी लाकड़ी लीन तीनी पोर लीख, ‘युसुफ नी मतलब एप्‌रेम नी, अने तीनी ह़ाते वाळा ईस्‌रायल नी लाकड़ी।’ <verse eid="EZK 37:16" /><verse number="17" style="v" sid="EZK 37:17" />अळतेण तीहया लाकड़्‌या ने एक बीजी ह़ाते जोड़ीन एकीत बणाय लेय के तीहयी तारा हात मे एकीत लाकड़ी बण जाय। <verse eid="EZK 37:17" /><verse number="18" style="v" sid="EZK 37:18" />जत्‌यार तारा माणहु तने पुछे, ‘ह़ु तु आमने नी देखाड़े के आनु ह़ु मतलब से?’ <verse eid="EZK 37:18" /><verse number="19" style="v" sid="EZK 37:19" />ता तीमने केजे, भगवान यहोवा आसम केय: देखो, में युसुफ नी लाकड़ी ने जे एप्‌रेम ना हात मे से, अने ईस्‌रायल ना जे घोराणा तीना ह़ाते वाळा से, तीमने लीन यहुदा नी लाकड़ी ह़ाते जोड़ीन तीनी ह़ाते एकीत लाकड़ी बणाय देही; अने बेम मारा हात मे एकीत लाकड़ी बणहे।<verse eid="EZK 37:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 37:20" />“जे लाकड़्‌या पोर तु आसम लीखही, तीहया तीमनी अगळ तारा हात मे रेय। <verse eid="EZK 37:20" /><verse number="21" style="v" sid="EZK 37:21" />ता तु तीहया माणहु ने के, भगवान यहोवा आसम केय देखो, में ईस्‌रायलीम ने तीहया राज्‌य मे गेथो लावीन जीमनी मे तीहया जत रेला से, च्‌यारो-मेर गेथा एक्‌ठा करही; अने तीमना खुद ना देस मे पुगाड़ही। <verse eid="EZK 37:21" /><verse number="22" style="v" sid="EZK 37:22" />में तीमने तीहया देस मतलब ईस्‌रायल ना बड़ा पोर एकीत राज्‌य बणाय देही; अने तीहया आखा नो एकीत राजो रेहे; अने तीहया अळतेण बे नी रेय अने नी बे राज्‌य मे कारु बी वटाये। <verse eid="EZK 37:22" /><verse number="23" style="v" sid="EZK 37:23" />अळतेण तीहया मुरत्‌या, अने गलत कामु नीता आह़फाम ना काना भाती ना पापु नी लारे आह़फाम ने नी वीटाळे; पण में तीमने तीहया आखा जागा मे गेथा, जां तीहया पाप करता हता, नीकाळीन चोखा करही, अने तीहया मारा माणहु रेहे, अने में तीमनो भगवान रेही। <verse eid="EZK 37:23" /><verse number="24" style="v" sid="EZK 37:24" />मारो चाकर्‌यो दावुद तीमनो राजो रेहे; अने तीहया आखा नो एकीत गुवाळ्‌यो रेहे। तीहया मारा नेम पोर चालहे अने मारा रीत्‌या ने मानीन तीमनी अनसारे चालहे।<note caller="+" style="x"><char style="xo" closed="false">37:24 </char><char style="xt" closed="false"><ref loc="EZK 34:24">यहेजकेल 34:24</ref></char></note> <verse eid="EZK 37:24" /><verse number="25" style="v" sid="EZK 37:25" />तीहया आहया देस मे रेहे, जीने में मारा चाकर्‌या याकुब ने आपलो हतो; अने जीनी मे तमारा आड़ा-बुड़ा रेता हता, तीनी मे तीहया अने तीमना सोरा अने सोरा ना सोरा जलम वह़ला रेहे; अने मारो चाकर्‌यो दावुद जलम तीमनो मुख्‌यो रेहे। <verse eid="EZK 37:25" /><verse number="26" style="v" sid="EZK 37:26" />में तीमनी ह़ाते सांती नो वायदो करही; तीहयो जलम नो वायदो ठेरहे; अने में तीमने जागो आपीन गीनती बड़ावही, अने तीमनी वच मे मारो चोखलो जागो जलम बणाय राखही। <verse eid="EZK 37:26" /><verse number="27" style="v" sid="EZK 37:27" />मारु रेवा नु तम्‌बु तीमनी वच मे रेहे; अने में तीमनो भगवान रेही, अने तीहया मारा माणहु रेहे।<note caller="+" style="x"><char style="xo" closed="false">37:27 </char><char style="xt" closed="false"><ref loc="2CO 6:16">2 कुरन्‌थी 6:16</ref>; <ref loc="REV 21:3">परकासीतवाक्‌य 21:3</ref></char></note> <verse eid="EZK 37:27" /><verse number="28" style="v" sid="EZK 37:28" />जत्‌यार मारो चोखलो जागो तीमनी वच मे जलम जुगु रेहे, ता आखु राज्‌य जाण लेहे के में यहोवा ईस्‌रायल ने चोखो करवा वाळो से।”<verse eid="EZK 37:28" /></para>
  <chapter eid="EZK 37" />
  <chapter number="38" style="c" sid="EZK 38" />
  <para style="s">गोग राज्‌य भगवान ना सादन ना रुप मे</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 38:1" />अळतेण भगवान नो आहयो बोल मारीन्‌तां पुग्‌यो: <verse eid="EZK 38:1" /><verse number="2" style="v" sid="EZK 38:2" />“ए माणेह नी अवल्‌यात,” आह़फा नु मोडु “मागोग देस ना राजा गोग भणीन करीन, जे रोस, मेसेक अने तुबल राज्‌य नो मुख्‌यो से, तीना वीरोद मे भगवान वगे गेथी वात के,<note caller="+" style="x"><char style="xo" closed="false">38:2 </char><char style="xt" closed="false"><ref loc="REV 20:8">परकासीतवाक्‌य 20:8</ref></char></note> <verse eid="EZK 38:2" /><verse number="3" style="v" sid="EZK 38:3" />अने आहयु के, ए गोग, रोस, मेसेक, अने तुबल ना मुख्‌या, भगवान यहोवा आसम केय: देख, में तारी वीरोद मे से। <verse eid="EZK 38:3" /><verse number="4" style="v" sid="EZK 38:4" />में तने फीरवही, अने तारा मोडा मे हेकड़ा घालीन तने नीकाळही; अने तारी आखी सेना ने बी मतलब घोड़ा अने घोड़ा पोर बहण्‌या ने जे आखान-आखा कवच पेरला एक मोटी भीड़ से, भाला अने ढाळ लीन आखान-आखा तलवार ह़ीकला रेहे; <verse eid="EZK 38:4" /><verse number="5" style="v" sid="EZK 38:5" />अने तीनी ह़ाते फारस, कुस देस अने पुत देस ने, जे आखान-आखा ढाळ अने टोपा मेकला रेहे; <verse eid="EZK 38:5" /><verse number="6" style="v" sid="EZK 38:6" />अने गोमेर अने तीना आखा सेना ना टोळा ने, अने धुराव देसु ना तोगर्‌मा ना घोराणा, अने तीना आखा टोळा ने नीकाळही, तारी ह़ाते घणा देस ना माणहु रेहे। <verse eid="EZK 38:6" /><verse number="7" style="v" sid="EZK 38:7" />करीन तु तीयार हय जा; तु अने जेतरी भीड़ तारीन्‌तां एक्‌ठी हये, तीयार रेजे, अने तु तीमनो अगवाय करन्‌यो बणजे। <verse eid="EZK 38:7" /><verse number="8" style="v" sid="EZK 38:8" />घणा दाड़ा वीतवान अळतेण तारी फोम करही; अने आखरी ना साल मे तु तीहया देस मे आवही, जे तलवार ना हक सी छुटलु हहे, अने जीना रेवा वाळा घणा राज्‌य मे गेथा एक्‌ठा हयहे; मतलब तु ईस्‌रायल ना बड़ा पोर आवही जे लगातार उजाड़ रेला से; पण तीहया देस-देस ना माणहु ना हक मे गेथा छोड़ावीन आखान-आखा बीह्‌या वगर रेहे। <verse eid="EZK 38:8" /><verse number="9" style="v" sid="EZK 38:9" />तु हमलो करही, अने आंजीन तेम आवही, अने आह़फा ना आखा टोळा अने घणा देसु ना माणहु भेळ पाणीन तेम देस पोर छवाय जही।”<verse eid="EZK 38:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 38:10" />भगवान यहोवा आसम केय “तीहया दाड़े तारा मन मे एवी-एवी वात आवहे के तु एक बुरी योजना बी बणावही। <verse eid="EZK 38:10" /><verse number="11" style="v" sid="EZK 38:11" />अने तु कीही, ‘में भीतड़ु वगर ना गामु पोर हमलो करही; में तीहया माणहुन्‌तां जही जे अराम सी बीह्‌या वगर रेय; जे आखान-आखा भीतड़ु वगर अने डांडा अने पल्‌ला वगर वह़ला से,’ <verse eid="EZK 38:11" /><verse number="12" style="v" sid="EZK 38:12" />आनीन करते के तु हापकीन तीमने अने आह़फा नो हात तीहया उजाड़ भणीन बड़ावे जे पासा वहाड़ला से, अने तीहया माणहु ना वीरोद मे जाय जे राज्‌य मे गेथा एक्‌ठा करला हता अने धरती नी डुटी पोर वह़ला रीन जानवरु अने बीजु धन राखे। <verse eid="EZK 38:12" /><verse number="13" style="v" sid="EZK 38:13" />सबा अने ददान ना माणहु अने तर्‌सीस ना वेपारी आह़फा ना देस आखा जुवान नाहरु भेळ तने केहे, ‘ह़ु तु लुटवा करीन आवलो से? ह़ु तु धन हापकवा, अने ह़ोनु-चांदी चुटवा, जानवरु अने बीजु धन लीजवा, अने घणु ढेरकु लुट ली लेवा करीन आह़फा नी भीड़ एक्‌ठी करलो से?’”<verse eid="EZK 38:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EZK 38:14" />आहया कारण सी, ए माणेह नी अवल्‌यात, भगवान वगे गेथी वात कीन गोग ने के, भगवान यहोवा आसम केय “जे टेमे मारा माणहु बीह्‌या वगर वह़ला रेहे, ह़ु तने तीनी खबर नी जड़े? <verse eid="EZK 38:14" /><verse number="15" style="v" sid="EZK 38:15" />तु धुराव भणी ना नाम्‌बे-नाम्‌बे ना जागे गेथो आवही; तु अने तारी ह़ाते ढेरेत राज्‌य ना माणहु, जे आखान-आखा घोड़ा पोर बहला रेहे, मतलब एक मोट्‌ली भीड़ अने ताखत वाळी सेना। <verse eid="EZK 38:15" /><verse number="16" style="v" sid="EZK 38:16" />जेम वादळु धरती पोर छवाय जाय, तेमेत तु मारा माणहु ईस्‌रायल ना देस पोर हमलो करही। करीन ए गोग, आखरी ना दाड़ा मे आसमेत हयहे, के में तारी सी मारा देस पोर आनीन करते हमलो करावही, के जत्‌यार में राज्‌य नी देखणते तारी लारे आह़फा ने चोखलो ठेरावही, ता तीहया मने ओळख लेहे। <verse eid="EZK 38:16" /><verse number="17" style="v" sid="EZK 38:17" />भगवान यहोवा आसम केय: ह़ु तु तीहयोत नी हय जीना बारा मे पेलेत में मारा चाकर्‌या, मतलब ईस्‌रायल ना तीहया भगवान वगे गेथी वात केवा वाळा नी लारे केदलो हतो, जे तीहया दाड़ा मे सालु तक आहयु भगवान भणी गेथा केता ज्‌या, के यहोवा गोग सी ईस्‌रायलीम” नी पोर हमलो करावहे।<verse eid="EZK 38:17" /></para>
  <para style="s">गोग राजा ने भगवान नो डंड</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 38:18" />जे दाड़े ईस्‌रायलीम नी पोर गोग हमलो करहे, “तीहया दाड़े मारी रीह मारा मोडे गेथी नीकळहे, भगवान यहोवा आसमेत केय। <verse eid="EZK 38:18" /><verse number="19" style="v" sid="EZK 38:19" />में खीज अने रीह नु आक्‌ठु मे केदलो के सण्‌का कर्‌या वगर तीहया दाड़े ईस्‌रायल ना देस मे मोट्‌लो भुकम्‌प हयहे। <verse eid="EZK 38:19" /><verse number="20" style="v" sid="EZK 38:20" />मारा दरसन सी दर्‌या ना माछला अने वादळा ना चड़ा, अने मेदान ना जानवरु अने धरती पोर जेतरा जीव-जन्‌तु घीहाय्‌न चाले, अने धरती नी उपर जेतरा माणहु रेय, आखा काप उठहे अने बड़ा ओदरी जहे; अने उबला ढाटड़ा पड़ जहे, अने आखा भीतड़ा पड़ीन कादा मे भेसकाय जहे. <verse eid="EZK 38:20" /><verse number="21" style="v" sid="EZK 38:21" />भगवान यहोवा आसम केय के में तीना वीरोद मे तलवार वेर मारवा करीन मारा आखा बड़ा ने आड़ही अने एक-एक नी तलवार आह़फा ना भाय ना वीरोद मे उठहे। <verse eid="EZK 38:21" /><verse number="22" style="v" sid="EZK 38:22" />में गरा अने लोय ना रुप मे तीने डंड आपही; अने तीनी पोर अने तीना टोळा पोर, अने तीहया ढेरेत राज्‌य पोर जे तीनीन्‌तां रेहे, तीमनी पोर मुसळधार्‌यो पाणी पाड़ही अने गारा, आक्‌ठु अने बारुद पाड़ही। <verse eid="EZK 38:22" /><verse number="23" style="v" sid="EZK 38:23" />आहयी भाते में मने मोटो अने चोखलो ठेरावही अने ढेरेत राज्‌य नी अगळ खुद ने उजन्‌तो करही। ता तीहया जाण लेहे के में यहोवा से।”<verse eid="EZK 38:23" /></para>
  <chapter eid="EZK 38" />
  <chapter number="39" style="c" sid="EZK 39" />
  <para style="s">गोग राजा नु हारनु</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 39:1" />अळतेण ए “माणेह नी अवल्‌यात, गोग ना वीरोद मे भगवान वगे गेथी वात करीन आहयु के, ए गोग, ए रोस, मेसेक, अने तुबल राज्‌य ना मुख्‌या, भगवान यहोवा आसम केय: में तारा वीरोद मे से। <verse eid="EZK 39:1" /><verse number="2" style="v" sid="EZK 39:2" />में तने फीराय लावही, अने धुराव ना नाम्‌बे-नाम्‌बे ना देस गेथा चड़ाय लावही, अने ईस्‌रायल ना बड़ा पोर पुगाड़ही, <verse eid="EZK 39:2" /><verse number="3" style="v" sid="EZK 39:3" />तां में तारी धंदली तारा डाखर्‌या हात मे गेथी पाड़ही, अने तारा बीलखा ने तारा जमणा हात मे गेथा पाड़ देही। <verse eid="EZK 39:3" /><verse number="4" style="v" sid="EZK 39:4" />तु आह़फा ना आखी सेना अने आह़फा नी ह़ाते नु आखु राज्‌य भेळ ईस्‌रायल ना बड़ा पोर मर जही; में तने भाती-भाती ना मांह खाण्‌या चड़ा अने जानवरु नु खाणु बणाय देही। <verse eid="EZK 39:4" /><verse number="5" style="v" sid="EZK 39:5" />तु खेतर मे पड़ही, काहाके मेत आसम केदलो से, भगवान यहोवा आसमेत केय। <verse eid="EZK 39:5" /><verse number="6" style="v" sid="EZK 39:6" />में मागोग ह़ेर मे अने टापु मे बीह्‌या वगर रेवा वाळा नी वच मे आक्‌ठु धपाड़ही; अने तीहया जाण लेहे के में यहोवा से। <verse eid="EZK 39:6" /><verse number="7" style="v" sid="EZK 39:7" />में मारा माणहु ईस्‌रायल नी वच मे मारु नाम उजन्‌तु करही; अने मारु चोखलु नाम ने अळी वीटळवा नी देम; ता राज्‌य-राज्‌य ना माणहु बी जाण लेहे के में यहोवा ईस्‌रायल नो चोखलो भगवान से।”<verse eid="EZK 39:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 39:8" />आहयु हयवा वाळु से, “अने आहयु पक्‌कु हयहे, भगवान यहोवा आसमेत केय। आहयो तीहयोत दाड़ो से जीना बारा मे, में वात करलो से। <verse eid="EZK 39:8" /><verse number="9" style="v" sid="EZK 39:9" />ता ईस्‌रायल ना ह़ेरु मे रेवा वाळा नीकळहे अने हत्‌यार ने धपाड़ देहे, नान्‌ली मोट्‌ली ढाळ, धंदली, अने बीलखा, अने लाकड़ी, भाला, आखु ने तीहया ह़ात साल तक धपाड़ता रेहे। <verse eid="EZK 39:9" /><verse number="10" style="v" sid="EZK 39:10" />आहया कारण सी तीहया मेदान मे लाकड़ा ने ह़ोदवा नी जरवत नी पड़े। नी जंगल मे वाडे, काहाके तीहया हत्‌यार नेत धपाड़्‌या करहे, तीहया आह़फाम ने लुटवा वाळा ने लुटहे, अने आह़फाम नी पांह हापकवा वाळा पांह हापकहे,” भगवान यहोवा आसमेत केय।<verse eid="EZK 39:10" /></para>
  <para style="s">गोग ने गाड़नु</para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 39:11" />“तीहयी टेमे में गोग ने ईस्‌रायल मे मड़ाट्‌यु आपही, तीहयु तळाव नी उगवणी ह़ोड़ रेहे; तीहयु आव्‌वा जवा वाळा नी घाटी केवायहे, अने आव्‌वा जवा वाळा ने तां उबा रेवा पड़हे; तां आखी भीड़ भेळ गोग ने वगे करहे अने तीहया जागा नु नाम गोग नी भीड़ नी घाटी पड़हे। <verse eid="EZK 39:11" /><verse number="12" style="v" sid="EZK 39:12" />ईस्‌रायल नु घोराणु तीने ह़ात मयना लग वगे करतु रेहे आनीन करते के आह़फा नु देस ने चोखु करे। <verse eid="EZK 39:12" /><verse number="13" style="v" sid="EZK 39:13" />देस ना आखा माणहु मेळीन तीमने वगे करहे; अने जे टेमे मारी बड़ाय हयहे, तीहयी टेमे तीमनु बी नाम मोटु हयहे, भगवान यहोवा आसमेत केय। <verse eid="EZK 39:13" /><verse number="14" style="v" sid="EZK 39:14" />ता तीहया माणहु ने टाळहे, जे लगातार आहयात काम मे लागला रेहे, मतलब देस मे फीरी-फीरीन आव्‌वा-जवा वाळा नी ह़ाते मेळीन देस ने चोखु करवा करीन तीमने जे जागा पोर पड़ला रेहे, वगे करहे; अने ह़ात मयना वीतते तक तीहया ह़ोदी-ह़ोदीन आहयु काम करता रेहे। <verse eid="EZK 39:14" /><verse number="15" style="v" sid="EZK 39:15" />देस मे आव्‌वा-जवा वाळा मे गेथा जत्‌यार कोय काना माणेह नु हाटकु ने देखहे, ता तीनीन्‌तां एक सेलाणी उबी करहे, आहयी सेलाणी तत्‌यार तक रेहे जत्‌यार तक वगे करवा वाळा तीने गोग नी भीड़ नी घाटी मे गाड़ नी देय। <verse eid="EZK 39:15" /><verse number="16" style="v" sid="EZK 39:16" />तां ना ह़ेर नु नाम बी ‘हमोना’ से। आहयी रीते देस चोखु करहे।<verse eid="EZK 39:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 39:17" />“अळतेण ए माणेह नी अवल्‌यात, भगवान यहोवा आसम केय: भाती-भाती ना आखा चड़ा अने आखा जंगल ना जानवरु ने हुकम आप, आखा एक्‌ठा हय्‌न आवो, मारु आहयु मोट्‌लु बादा नु खाणु मे जे मे तमारी जुगु ईस्‌रायल ना बड़ा पोर तीयार करु, च्‌यारो-मेर गेथा एक्‌ठा हयो के तमु मांह खावो अने लोय पीवो। <verse eid="EZK 39:17" /><verse number="18" style="v" sid="EZK 39:18" />तमु वारला झुमायवा वाळा नु मांह खाहु, अने धरती ना मुख्‌या नु लोय पीहु अने गाडरा, गाडरा ना बच्‌चा, बोकड़ा अने बोळद्‌या नु बी जे आखान-आखा बासान देस ना तीयार करला रेहे। <verse eid="EZK 39:18" /><verse number="19" style="v" sid="EZK 39:19" />मारु तीहयु बादा नु खाणु नी चर्‌बी वेर जे में तमारी जुगु तीयार करु, तमु खाता-खाता आफरी जहु, अने तीनु लोय पीता-पीता छाक जहु। <verse eid="EZK 39:19" /><verse number="20" style="v" sid="EZK 39:20" />तमु मारी खावा नी टेबल पोर घोड़ा, घोड़ा पोर बहण्‌या, वारला झुमायण्‌या, अने आखा भाती ना झुमायण्‌या सी आफरहु, भगवान यहोवा आसमेत केय।<note caller="+" style="x"><char style="xo" closed="false">39:20 </char><char style="xt" closed="false"><ref loc="REV 19:17">परकासीतवाक्‌य 19:17</ref>,<ref loc="REV 19:18">18</ref></char></note><verse eid="EZK 39:20" /></para>
  <para style="s">ईस्‌रायल नु पासु अळी बणावणु</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 39:21" />“में राज्‌य-राज्‌य नी वच मे मारी बड़ाय उजन्‌ती करही, अने राज्‌य-राज्‌य ना आखा माणहु मारा नीयाव ना काम जे में करही, अने मारो हात जे तीमनी पोर पड़हे, देख लेहे। <verse eid="EZK 39:21" /><verse number="22" style="v" sid="EZK 39:22" />तीहया दाड़े गेथा अगा ईस्‌रायल नु घोराणु जाण लेहे के यहोवा अमारो भगवान से। <verse eid="EZK 39:22" /><verse number="23" style="v" sid="EZK 39:23" />राज्‌य-राज्‌य ना माणहु बी जाण लेहे के ईस्‌रायल नु घोराणु आह़फाम ना अधरम ना कारण गुलामी मे जेलु हतु; काहाके तीहया मारी ह़ाते आसम धोको कर्‌या के में मारु मोडु तीमनी भणी गेथु सेटु कर लेदो अने तीमने तीमना वेरी ना हात मे कर देदो, अने तीहया आखा तलवार वेर मर ज्‌या, <verse eid="EZK 39:23" /><verse number="24" style="v" sid="EZK 39:24" />में तीमनी वीटळ अने गुना नीत अनसारे तीमनी ह़ाते वेहवार करीन तीमनी भणी गेथु मारु मोडु फीरवी लेदलो हतो।<verse eid="EZK 39:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 39:25" />“करीन भगवान यहोवा आसम केय: हाव में याकुब ने गुलामी मे गेथो पासो ली आवही, अने ईस्‌रायल ना आखा घोराणा पोर दया करही; अने मारा चोखला नाम जुगु मने रीह लागहे। <verse eid="EZK 39:25" /><verse number="26" style="v" sid="EZK 39:26" />ता तीहया आखा धोका ना कारण सी जे तीहया मारा वीरोद मे करला लजवाहे; अने आह़फाम ना देस मे बीह्‌या वगर रेहे; अने कोय तीमने नी बीहाड़े। <verse eid="EZK 39:26" /><verse number="27" style="v" sid="EZK 39:27" />जत्‌यार में तीमने राज्‌य-राज्‌य मे गेथा पासा ली आवही, अने तीहया वेरीम ना देसु मे गेथा एक्‌ठा करही, ता घणा राज्‌य नी नींगा मे तीमनी लारे चोखलो ठेरही। <verse eid="EZK 39:27" /><verse number="28" style="v" sid="EZK 39:28" />ता तीहया जाण लेहे के यहोवा अमारो भगवान से, काहाके में तीमने राज्‌य-राज्‌य मे गुलाम बणावीन मोकलीन पासो तीमना आह़फाम ना देस मे एक्‌ठा करलो से। में तीमनी मे गेथा कोय ने बी अळी बीजा देस मे नी रेवा देम, <verse eid="EZK 39:28" /><verse number="29" style="v" sid="EZK 39:29" />अने तीमनी भणी गेथु मोडु अळी कदी नी फीरवु, काहाके में ईस्‌रायल ना घोराणा पोर मारी आत्‌मा रेचवलो से, भगवान यहोवा आसमेत केय।”<verse eid="EZK 39:29" /></para>
  <chapter eid="EZK 39" />
  <chapter number="40" style="c" sid="EZK 40" />
  <para style="s">अगो चालीन बणवा वाळा मंदीर नो दरसन</para>
  <para style="r">(<ref loc="EZK 40:1-48:35">यहेजकेल 40:1–48:35</ref>)</para>
  <para style="s">यहेजकेल ने यरुसलेम मे पुगाड़नु</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 40:1" />अमारा गुलामी ना पच्‌चीहवा साल मतलब यरुसलेम ह़ेर ने हक मे कर लेवान अळतेण चोवदवा साल ना पेल्‌ला मयना ना दहवा दाड़े, यहोवा नी सक्‌ती मारी पोर आयी, अने तीहयी मने तां पुगाड़ी। <verse eid="EZK 40:1" /><verse number="2" style="v" sid="EZK 40:2" />आह़फा ना दरसन मे भगवान मने ईस्‌रायल ना देस मे पुगाड़्‌यो अने तां एक घणा उचा बड़ा पोर उबो कर्‌यो, जीनी पोर दखणाव नी ह़ोड़ मानो काना ह़ेर ह़रकु हतु।<note caller="+" style="x"><char style="xo" closed="false">40:2 </char><char style="xt" closed="false"><ref loc="REV 21:10">परकासीतवाक्‌य 21:10</ref></char></note> <verse eid="EZK 40:2" /><verse number="3" style="v" sid="EZK 40:3" />जत्‌यार तीहयो मने तां लीज्‌यो, ता में ह़ु देख्‌यो के पीतळ ने तेवु माणेह हात मे ह़ोण नी ह़ोटी अने मापवा नु टोकरु लीन एक फाटा पोर उबु हय र्‌यु।<note caller="+" style="x"><char style="xo" closed="false">40:3 </char><char style="xt" closed="false"><ref loc="REV 11:1">परकासीतवाक्‌य 11:1</ref>; <ref loc="REV 21:15">21:15</ref></char></note> <verse eid="EZK 40:3" /><verse number="4" style="v" sid="EZK 40:4" />तीहयु माणेह मने केदु, “ए माणेह नी अवल्‌यात, ता डोळा वेर देख, अने तारा कान्‌टा वेर ह़मळ; अने जे कंय में तने देखाड़ही तीहयु आखु पोर धीयान दे, काहाके तने आनीन करते आञे पुगाड़लो से के में तने आहयी वात देखाड़ु; अने जे कंय तु देखे तीहयु ईस्‌रायल ना घोराणा ने देखाड़े।”<verse eid="EZK 40:4" /></para>
  <para style="s">उगवणो फाटो</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 40:5" />अने देखो, घोर नी बाहर च्‌यारो-मेर एक भीतड़ु हतु, अने तीहया अदमी ना हात मे मापवा नु टोकरु हतु, तीहयु छो हात, मतलब तीन मीटर नी आड़े-धेड़े नाम्‌बु हतु; तीहयु भीतड़ु केतरु मोटु अने उचु से माप्‌यो, ता मोटु तीन मीटर नी आड़े-धेड़े अने उचु तीन मीटर<note caller="+" style="f"><char style="fr" closed="false">40:5 </char><char style="fq" closed="false">तीन मीटर </char><char style="ft" closed="false">हात नी आहयी माप आखा बीजा हातु गेथी च्‌यार आंगळा मोटी हती</char></note> नी आड़े-धेड़े नीकळ्‌यु।<note caller="+" style="x"><char style="xo" closed="false">40:5 </char><char style="xt" closed="false"><ref loc="1KI 6:1-38">1 राजा 6:1-38</ref>; <ref loc="2CH 3:1-9">2 ईतीहास 3:1-9</ref></char></note> <verse eid="EZK 40:5" /><verse number="6" style="v" sid="EZK 40:6" />ता तीहयो तीहया फाटान्‌तां आयो जीनु मोडु उगवणु हतु, अने तीनी पयड़ी पोर चड़ीन फाटा नी बेम ढेहळी नी चवड़ाय माप्‌यो, अने ढेहळी तीन मीटर नाम्‌बी नीकळी। <verse eid="EZK 40:6" /><verse number="7" style="v" sid="EZK 40:7" />तीहयो पेहरो देवा वाळा कोपरा ने माप्‌यो, अने आखा कोपरा तीन मीटर नाम्‌बा अने तीन मीटर चवड़ा हता; अने बे-बे कोपरा पांच हात नाम्‌बे हता; अने फाटा नी ढेहळी जे फाटा ना मांडवान्‌तां घोर भणीन हती, तीहयी बी तीन मीटर हती। <verse eid="EZK 40:7" /><verse number="8" style="v" sid="EZK 40:8" />ता तीहयो फाटा नो ते मांडवो बी जे घोर नी अगळ हतो, माप्‌यो, अने तीहयो बी तीन मीटर नीकळ्‌यो। <verse eid="EZK 40:8" /><verse number="9" style="v" sid="EZK 40:9" />तीहयो फाटा नो मांडवो माप्‌यो ता आंठ हात नीकळ्‌यो, अने तीना खम्‌बा बे-बे हात ना नीकळ्‌या, अने फाटा नो मांडवो घोर नी अगळ हतो। <verse eid="EZK 40:9" /><verse number="10" style="v" sid="EZK 40:10" />उगवणा ना फाटा नी बेम ह़ोड़ तीन-तीन पेहरो देवा ना कोपरा हता जे आखा एकीत माप ना हता, अने बेम ह़ोड़ ना खम्‌बा बी एकीत माप ना हता। <verse eid="EZK 40:10" /><verse number="11" style="v" sid="EZK 40:11" />अळतेण तीहयो फाटा ना झापला नी चवड़ाय माप्‌यो, तीहयु दह हात नीकळ्‌यु; अने फाटा नी लम्‌बाय माप्‌यो, ता तेरे हात नीकळ्‌यु। <verse eid="EZK 40:11" /><verse number="12" style="v" sid="EZK 40:12" />बेम ह़ोड़ ना पेहरो देवा ना कोपरा नी अगळ हात भर नो जागो हतो अने बेम ह़ोड़ कोपरा छो-छो हात ना हता। <verse eid="EZK 40:12" /><verse number="13" style="v" sid="EZK 40:13" />अळतेण तीहयो फाटा ने एक ह़ोड़ ना पेहरो देवा ना कोपरा नी छत गेथु लगाड़ीन बीजी ह़ोड़ ना पेहरो देवा वाळा कोपरा नी छत तक माप्‌यो, ता पच्‌चीह हात सेटु नीकळ्‌यु, अने झापला आम्‌बा-साम्‌बा हता। <verse eid="EZK 40:13" /><verse number="14" style="v" sid="EZK 40:14" />अळतेण तीहयो बरामदा ने बी माप्‌यो, अने तीनी चवड़ाय साट हात नीकळी, अने आंगणु, फाटा नी आड़े-धेड़े, बरामदा तक हतु। <verse eid="EZK 40:14" /><verse number="15" style="v" sid="EZK 40:15" />फाटा ना बाहरला झापला नी अगळ गेथु लगाड़ीन तीनी मोय ना मांडवा नी अगळ तक पचाह हात नाम्‌बु हतु। <verse eid="EZK 40:15" /><verse number="16" style="v" sid="EZK 40:16" />पेहरो देवा वाळा कोपरा मे, अने फाटा ना मोय च्‌यारो-मेर कोपरा नी वच मे ना खम्‌बा नी वच-वच मे घटाळ्‌ळा खीड़क्‌या हता, अने खम्‌बा ना मांडवा मे बी तेवात हता; अने फाटा नी मोय नी च्‌यारो-मेर खीड़क्‌या हता, अने आखा खम्‌बा पोर खजुरा ना झाड़ बणावला हता।<verse eid="EZK 40:16" /></para>
  <para style="s">बाहर वाळु आंगणु</para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 40:17" />ता तीहयो मने बाहरलु आंगणु मे ली ज्‌यो, अने तीहयु आंगणु नी च्‌यारो-मेर कोपरा हता; अने एक फरसी बणली हती, जीनी पोर तीस कोपरा बणला हता। <verse eid="EZK 40:17" /><verse number="18" style="v" sid="EZK 40:18" />आहयी फरसी मतलब हेट्‌ली फरसी फाटान्‌तां गेथी लागली हती अने तीनी लम्‌बाय नी अनसारे हती। <verse eid="EZK 40:18" /><verse number="19" style="v" sid="EZK 40:19" />अळतेण तीहयो हेट्‌ला फाटा नी अगळ गेथो लगाड़ीन मोय ना आंगणा नी बाहर अगु तक माप्‌यो, ता ह़ोव हात नीकळ्‌यु; तीहयु उगवणु अने धुराव बेम ह़ोड़ आसमेत हतु।<verse eid="EZK 40:19" /></para>
  <para style="s">धुराव नो फाटो</para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 40:20" />ता बाहर नु आंगणु ने जीनु मोडु धुराव भणीन हतु तीनी लम्‌बाय अने चवड़ाय माप्‌यो। <verse eid="EZK 40:20" /><verse number="21" style="v" sid="EZK 40:21" />तीनी बेम ह़ोड़ तीन-तीन पेहरो देवा वाळा कोपरा हता, अने आना बी खम्‌बा ना मांडवा नी माप पेल्‌ला फाटा नी अनसारे हती; आनी लम्‌बाय पचाह हात अने चवड़ाय पच्‌चीह हात नी हती। <verse eid="EZK 40:21" /><verse number="22" style="v" sid="EZK 40:22" />आना बी खीड़क्‌या अने खम्‌बा ना मांडवा अने खजुर ना झाड़का नी माप उगवणु मोडु ना फाटान तेवी हती; अने आनी पोर चड़वा करीन ह़ात पयड़ी हती; अने तीमनी अगळ तीमना मांडवा हता। <verse eid="EZK 40:22" /><verse number="23" style="v" sid="EZK 40:23" />मोय नु आंगणु नी धुराव अने उगवणी ह़ोड़ बीजा फाटा नी अगळ फाटा हता अने तीहयो फाटा ने केतरा सेटा से माप्‌यो; ता तीहया ह़ोव हात नीकळ्‌या।<verse eid="EZK 40:23" /></para>
  <para style="s">दखणाव नो फाटो</para>
  <para style="p">
    <verse number="24" style="v" sid="EZK 40:24" />अळतेण तीहयो मने दखणाव भणीन ली ज्‌यो, अने दखणाव भणीन एक फाटो हतो; अने तीहयो तीना खम्‌बा अने खम्‌बा ना मांडवा ने माप्‌यो, अने आहया बी बीजा हता तेतरात नीकळ्‌या। <verse eid="EZK 40:24" /><verse number="25" style="v" sid="EZK 40:25" />जे बीजा फाटे खीड़क्‌या हता तेमेत आहया फाटा अने मांडवा ना च्‌यारो-मेर बी खीड़क्‌या हता; आनी बी लम्‌बाय पचाह हात अने चवड़ाय पच्‌चीह हात हती। <verse eid="EZK 40:25" /><verse number="26" style="v" sid="EZK 40:26" />आनी मे बी चड़वा करीन ह़ात पयड़ी हती अने तीमनी अगळ खम्‌बा नो मांडवो हतो; अने तीनी बेम ह़ोड़ ना खम्‌बा पोर खजुर ना झाड़ बणला हता। <verse eid="EZK 40:26" /><verse number="27" style="v" sid="EZK 40:27" />दखणाव भणीन बी मोय नु आंगणु नो एक फाटो हतो, अने तीहयो दखणाव भणीन ना बेम फाटा केतरा सेटा से माप्‌यो, ता ह़ोव हात नीकळ्‌या।<verse eid="EZK 40:27" /></para>
  <para style="s">मोय नु आंगणु: दखणाव नो फाटो</para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 40:28" />ता तीहयो मने दखणाव ना फाटे माय्‌न मने मोय ना आंगणा मे ली ज्‌यो, अने तीहयो दखणाव ना फाटा ने माप्‌यो; ता बीजा फाटान तेतरोत नीकळ्‌यु। <verse eid="EZK 40:28" /><verse number="29" style="v" sid="EZK 40:29" />आना बी पेहरो देवा ना कोपरा, अने खम्‌बा, अने खम्‌बा ना मांडवा, आहया आखा तेमेत हता जे बीजा ना हता; अने आना अने आना मांडवा नी बी च्‌यारो-मेर खीड़क्‌या हता; फाटा नी लम्‌बाय अने चवड़ाय पच्‌चीह हात हती। <verse eid="EZK 40:29" /><verse number="30" style="v" sid="EZK 40:30" />आनी च्‌यारो-मेर नो खम्‌बा नो मांडवो बी पच्‌चीह हात नाम्‌बो, अने पचाह हात चवड़ो हतो। <verse eid="EZK 40:30" /><verse number="31" style="v" sid="EZK 40:31" />आना खम्‌बा नो मांडवो बाहरलु आंगणु भणीन हतो, अने आना खम्‌बा पोर बी खजुर ना झाड़ बणला हता, अने आनी पोर चड़वा करीन आंठ पयड़ी हती।<verse eid="EZK 40:31" /></para>
  <para style="s">मोय नु आंगणु: उगवणो फाटो</para>
  <para style="p">
    <verse number="32" style="v" sid="EZK 40:32" />अळतेण तीहयो अदमी मने उगवणी ह़ोड़ मोय नु आंगणु मे लीज्‌यो, अने तीहया ह़ोड़ ना फाटा ने माप्‌यो ता तीहयो बी बीजा फाटान तेतरोत नीकळ्‌यो। <verse eid="EZK 40:32" /><verse number="33" style="v" sid="EZK 40:33" />आना बी पेहरो देवा ना कोपरा अने खम्‌बा अने खम्‌बा नो मांडवो, आखु तेवुत हतु; अने आनी अने आना खम्‌बा ना मांडवा नी च्‌यारो-मेर बी खीड़क्‌या हता; आनी लम्‌बाय पचाह हात अने चवड़ाय पच्‌चीह हात हती। <verse eid="EZK 40:33" /><verse number="34" style="v" sid="EZK 40:34" />आनो मांडवो बी बाहरलु आंगणु भणीन हतो, अने आना बेम ह़ोड़ ना खम्‌बा पोर खजुर ना झाड़ बणला हता, अने आनी पोर बी चड़वा करीन आंठ पयड़ी हती।<verse eid="EZK 40:34" /></para>
  <para style="s">मोय नु आंगणु: धुराव नो फाटो</para>
  <para style="p">
    <verse number="35" style="v" sid="EZK 40:35" />अळतेण तीहयो अदमी मने धुराव भणीन ना फाटान्‌तां ली जाय्‌न तीने माप्‌यो, अने तीहयु बी बीजा फाटान तेतरोत नीकळ्‌यो। <verse eid="EZK 40:35" /><verse number="36" style="v" sid="EZK 40:36" />तीना बी पेहरो देवा ना कोपरा अने खम्‌बा अने मांडवो हतो; अने तीनी बी च्‌यारो-मेर खीड़क्‌या हता, तीनी लम्‌बाय पचाह हात अने चवड़ाय पच्‌चीह हात हती। <verse eid="EZK 40:36" /><verse number="37" style="v" sid="EZK 40:37" />तीना खम्‌बा बाहरलु आंगणु भणीन हता, अने तीमनी पोर बी बेम ह़ोड़ खजुर ना झाड़का बणला हता; अने तीनी पोर चड़वा करीन आंठ पयड़ी हती।<verse eid="EZK 40:37" /></para>
  <para style="s">धुराव ना फाटा नी धेड़े वह़ला कोपरा</para>
  <para style="p">
    <verse number="38" style="v" sid="EZK 40:38" />अळतेण फाटान्‌तां ना खम्‌बा नी धेड़े झापलु भेळ कोपरा हता, जां ह़ारीक होम बादा ने धोवता हता। <verse eid="EZK 40:38" /><verse number="39" style="v" sid="EZK 40:39" />होम बादा, पापबादा, अने गुना नी बादा ना जानवरु ने मारवा करीन फाटा ना मांडवान्‌तां तीनी बेम ह़ोड़ बे-बे टेबल हती। <verse eid="EZK 40:39" /><verse number="40" style="v" sid="EZK 40:40" />फाटा नी एक ह़ोड़ मतलब धुराव ना फाटा ना झापला नी चड़ाव पोर बे टेबल हती; अने तीनी बीजी बाहरली ह़ोड़ बी, जे फाटा ना मांडवान्‌तां हती, तां बी बे टेबल हती। <verse eid="EZK 40:40" /><verse number="41" style="v" sid="EZK 40:41" />फाटा नी बेम ह़ोड़ च्‌यार-च्‌यार टेबल हती, आखी मेळीन आंठ टेबल हती, जे बादा ना जानवरु मारवा जुगु हती। <verse eid="EZK 40:41" /><verse number="42" style="v" sid="EZK 40:42" />अळतेण होम बादा जुगु घड़ला दगड़ा नी च्‌यार टेबल हती, जे डेड़ हात नाम्‌बी, डेड़ हात चवड़ी, अने हात भर उची हती; तीमनी पोर होम बादा अने मेलबादा ना जानवरु ने मारवा ना हत्‌यार मेकता हता। <verse eid="EZK 40:42" /><verse number="43" style="v" sid="EZK 40:43" />मोय च्‌यारो-मेर च्‌यार ईंची नी आड़े-धेड़े आकड़ा लागला हता, अने टेबलु पोर बादा नु मांह मेकलु हतु। <verse eid="EZK 40:43" /><verse number="44" style="v" sid="EZK 40:44" />मोय ना आंगणा नी धुराव नी फाटा नी बाहर गाव्‌वा वाळा ना कोपरा हता जीमना झापला दखणाव भणीन हता; अने उगवणा फाटा भणीन एक कोपरो हतो, जीनु झापलु धुराव भणीन हतु। <verse eid="EZK 40:44" /><verse number="45" style="v" sid="EZK 40:45" />तीहयो मने केदो, “आहयो कोपरो, जीनु झापलु दखणाव भणीन से, तीहया पुंजारा जुगु से जे घोर नी चोकसी करे, <verse eid="EZK 40:45" /><verse number="46" style="v" sid="EZK 40:46" />अने जे कोपरा ना झापला धुराव भणीन से, तीहया कोपरा तीहया पुंजारा जुगु से जे वेदी नी चोकसी करे; आहया सादोक नी अवल्‌यात से; अने लेवीम नी मे गेथा यहोवा नी सेवा-चाकरी करवा करीन आहया एतरात तीनी ह़ाते जाय।”<verse eid="EZK 40:46" /></para>
  <para style="s">मोय नु आंगणु अने मंदीर नु घोर</para>
  <para style="p">
    <verse number="47" style="v" sid="EZK 40:47" />अळतेण तीहयो आंगणु ने माप्‌यो, तीहयु च्‌यार खुट्‌यु, अने ह़ोव हात नाम्‌बु अने ह़ोव हात चवड़ु नीकळ्‌यु; अने घोर नी अगळ वेदी हती। <verse eid="EZK 40:47" /><verse number="48" style="v" sid="EZK 40:48" />अळतेण तीहयो मने घोर ना मांडवा मे लीज्‌यो, अने मांडवा ना बेम ह़ोड़ ना खम्‌बा ने माप्‌यो, ता खम्‌बा पांच-पांच हात नीकळ्‌या; अने बेम ह़ोड़ फाटा नी चवड़ाय तीन-तीन हात हती। <verse eid="EZK 40:48" /><verse number="49" style="v" sid="EZK 40:49" />मांडवा नी लम्‌बाय वीह हात अने चवड़ाय ग्‌यारे हात नी हती; अने तीनी पोर चड़वा नी पयड़ी हती; अने बेम ह़ोड़ ना खम्‌बान्‌तां पील्‌लर हता।<verse eid="EZK 40:49" /></para>
  <chapter eid="EZK 40" />
  <chapter number="41" style="c" sid="EZK 41" />
  <para style="p">
    <verse number="1" style="v" sid="EZK 41:1" />अळतेण तीहयो मने मंदीर ने तां ली ज्‌यो, अने तीना बेम ह़ोड़ ना खम्‌बा ने माप्‌यो, अने तीहया छो-छो हात चवड़ा नीकळ्‌या, आहयी ते तम्‌बु नी चवड़ाय हती। <verse eid="EZK 41:1" /><verse number="2" style="v" sid="EZK 41:2" />झापलु नी चवड़ाय दह हात हती, अने झापलु नी बेम ह़ोड़ ना भीतड़ा पांच-पांच हात ना हता; अने तीहयो मंदीर नी लम्‌बाय माप्‌यो, ता चाळीह हात नीकळी, अने तीनी चवड़ाय वीह हात नी नीकळी। <verse eid="EZK 41:2" /><verse number="3" style="v" sid="EZK 41:3" />ता तीहयो मोय जाय्‌न झापलु ना खम्‌बा ने माप्‌यो, ता बे-बे हात ना नीकळ्‌या; अने झापलु छो हात नु हतु; अने झापलु नी चवड़ाय ह़ात हात नी हती। <verse eid="EZK 41:3" /><verse number="4" style="v" sid="EZK 41:4" />ता तीहयो मोय ना घोर नी लम्‌बाय अने चवड़ाय मंदीर नी अगळ माप्‌यो, ता वीह-वीह हात नीकळ्‌यु; अने तीहयो मने केदो, “आहयो ते आखा मे चोखलो जागो से।”<verse eid="EZK 41:4" /></para>
  <para style="s">मंदीर ना कोपरा</para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 41:5" />अळतेण तीहयो घोर नु भीतड़ु ने माप्‌यो, ता तीहयु छोव हात नीकळ्‌यु; अने घोर नी आड़े-धेड़े च्‌यार-च्‌यार हात चवड़ा बाहरला कोपरा हता। <verse eid="EZK 41:5" /><verse number="6" style="v" sid="EZK 41:6" />आहया बाहरला कोपरा तीन मंजली ना हता; अने एक-एक मंजली मे तीस-तीस कोपरा हता। घोर नी आड़े-धेड़े नु भीतड़ु आनीन करते हतु के बाहरला कोपरा तीना सहारे रेय; अने तीनीत मे कोपरा ना कड़्‌या बहाड़ला हता; अने तीहया घोर नु भीतड़ु ना सहारे नी हता। <verse eid="EZK 41:6" /><verse number="7" style="v" sid="EZK 41:7" />घोर नी आड़े-धेड़े जे कोपरा हता, तीमनी मे गेथा जे उपर हता, तीहया जादा चवड़ा हता; मतलब घोर नी आड़े-धेड़े जे कंय बणलु हतु, तीहयु जेम-जेम उपर नी ह़ोड़ बड़तु ज्‌यु, तेम-तेम चवड़ु हयतु ज्‌यु; आहयी रीते, आहया घोर नी चवड़ाय उपरली ह़ोड़ बड़ जेली हती, अने माणहु हेट्‌ली मंजली नी वचे माय्‌न उपरली मंजली मे चड़ सकता हता। <verse eid="EZK 41:7" /><verse number="8" style="v" sid="EZK 41:8" />अळतेण में घोर नी आड़े-धेड़े उचो जागो देख्‌यो, अने बाहरला कोपरा नी उचाय जोड़ तक छोव हात नु टोकरु नी हती। <verse eid="EZK 41:8" /><verse number="9" style="v" sid="EZK 41:9" />बाहरला कोपरा जुगु जे भीतड़ु हतु, तीहयु पांच हात मोटु हतु, अने जे जागो ठारलो री जेलो हतो, तीहयो घोर ना बारहला कोपरा नो जागो हतो। <verse eid="EZK 41:9" /><verse number="10" style="v" sid="EZK 41:10" />बाहरला कोपरा नी वचे-वचे घोर नी आड़े-धेड़े वीह़ हात सेटु हतु। <verse eid="EZK 41:10" /><verse number="11" style="v" sid="EZK 41:11" />बाहरला कोपरा नु झापलु तीहया जागा भणीन हता, जे ठारलो हतो, मतलब एक झापलु धुराव भणीन अने बीजु दखणाव भणीन हतु; अने जे जागो री जेलो, तीनी चवड़ाय च्‌यारो-मेर पांच-पांच हात नी हती।<verse eid="EZK 41:11" /></para>
  <para style="s">बुडवणी ह़ोड़ नु घोर</para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 41:12" />अळतेण जे घोर मंदीर नी बुडणली ह़ोड़ भणीन अगळ हतु, तीहयु सत्‌तर हात चवड़ु हतु; अने घोर नु आड़े-धेड़े नु भीतड़ु पांच हात मोटु हतु, अने तीहयु नब्‌बे हात नाम्‌बु हतु।<verse eid="EZK 41:12" /></para>
  <para style="s">मंदीर नी आखी माप</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 41:13" />ता तीहयो घोर नी लम्‌बाय माप्‌यो, ता ह़ोव हात नीकळ्‌यु; अने भीतड़ु भेळ आंगणु नी बी लम्‌बाय माप्‌यो; तीहयु बी ह़ोव हात नीकळ्‌यु। <verse eid="EZK 41:13" /><verse number="14" style="v" sid="EZK 41:14" />मंदीर नो अगळ वाळो हीस्‌सो अने तीनु आंगणु ह़ोव हात चवड़ु हतु। <verse eid="EZK 41:14" /><verse number="15" style="v" sid="EZK 41:15" />अळतेण तीहयो पसळ ना आंगणु नी अगळ नु भीतड़ु नी लम्‌बाय माप्‌यो तीनी बेम ह़ोड़ छीवण्‌या हता, तीहयु ह़ोव हात नीकळ्‌यु; अने मोय नु घोर अने आंगणु ना मांडवा बी माप्‌यो।<verse eid="EZK 41:15" /></para>
  <para style="s">मंदीर नु ह़जाड़लु</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 41:16" />ता तीहयो ढेहळी अने घटाळा करला खीड़क्‌या, अने आड़े-धेड़े नी तीनोव मंजली ना छीवण्‌या ने माप्‌यो जे ढेहळ नी अगळ हता, अने च्‌यारो-मेर तीमनी मे पाट्‌या बहाड़ला हता; अने भोयमे गेथा खीड़क्‌ये तक अने खीड़क्‌ये नी आड़े-धेड़े आखी वगड़े पाट्‌या बहाड़ला हता।<verse eid="EZK 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EZK 41:17" />अळतेण तीहयो झापलु नो उपर नो जागो मोय ना घोर तक अने तीनी बाहर बी अने आड़े-धेड़े नु आखु भीतड़ु नी मोय अने बाहर बी माप्‌यो। <verse eid="EZK 41:17" /><verse number="18" style="v" sid="EZK 41:18" />तीनी मे करुब<note caller="+" style="f"><char style="fr" closed="false">41:18 </char><char style="fq" closed="false">करुब </char><char style="ft" closed="false">पाखड़ा वाळो ह़रगदुत</char></note> अने खजुर ना झाड़ आसम बणला हता के बे-बे करुब नी वच मे एक-एक खजुर नु झाड़ हतु; अने करुब ना बे-बे मुख हता। <verse eid="EZK 41:18" /><verse number="19" style="v" sid="EZK 41:19" />एक खजुर नी झाड़ नी ह़ोड़ अदमी ना मुख नो छाप बणावलो हतो, अने बीजी ह़ोड़ जुवान नाहर नु मोडु बणावलु हतु। आहयी रीते आखु घोर नी च्‌यारो-मेर बणलु हतु। <verse eid="EZK 41:19" /><verse number="20" style="v" sid="EZK 41:20" />भोयमे गेथा लगाड़ीन झापलु नी उपर तक करुब अने खजुर ना झाड़ बणला हता, मंदीर नु भीतड़ु आहयीत भाते बणलु हतु।<verse eid="EZK 41:20" /></para>
  <para style="s">लाकड़ा नी वेदी</para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 41:21" />घोर ना झापला ना खम्‌बा च्‌यार-खुट्‌या हता, अने चोखला जागा नी अगळ वाळु मंदीर ने तेवु हतु। <verse eid="EZK 41:21" /><verse number="22" style="v" sid="EZK 41:22" />वेदी लाकड़ा नी बणली हती। अने तीहयी तीन हात उची, अने लम्‌बाय बे हात नी हती; अने तीना खुणा अने तीनो आखो हीस्‌सो अने कोपरा बी लाकड़ा ना हता। तीहयो मने केदो, “आहयी ते यहोवा नी अगळ नी टेबल से।”<verse eid="EZK 41:22" /></para>
  <para style="s">चोखला जागा ना झापला</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 41:23" />मंदीर अने चोखला ना झापला ना बे-बे पल्‌ला हता। <verse eid="EZK 41:23" /><verse number="24" style="v" sid="EZK 41:24" />अने एक-एक पल्‌ले बे-बे वळवा वाळा पल्‌ला हता, एक-एक झापला जुगु बे-बे पल्‌ला। <verse eid="EZK 41:24" /><verse number="25" style="v" sid="EZK 41:25" />जेम मंदीर ना भीतड़े करुब अने खजुर ना झाड़का बणला हता, तेमेत तीना पल्‌ला मे बी हता, अने मांडवा नी बाहरली ह़ोड़ लाकड़ा नी मोट्‌ली-मोट्‌ली धारण हती। <verse eid="EZK 41:25" /><verse number="26" style="v" sid="EZK 41:26" />मांडवा नी बेम ह़ोड़ घटाळा करला खीड़क्‌या हता अने खजुर ना झाड़ बणला हता; अने घोर ना बाहरला कोपरा अने मोटी-मोटी धारण बी हती।<verse eid="EZK 41:26" /></para>
  <chapter eid="EZK 41" />
  <chapter number="42" style="c" sid="EZK 42" />
  <para style="s">मंदीर नी ह़ाते बणला बे कोपरा</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 42:1" />अळतेण तीहयो मने बाहरलु आंगणु मे धुराव भणीन ली ज्‌यो, अने मने तीहया बे कोपरान्‌तां लायो जे घोर ना आंगणा नी अगळ अने आंगणु नी धुराव नी ह़ोड़ हता। <verse eid="EZK 42:1" /><verse number="2" style="v" sid="EZK 42:2" />ह़ोव हात सेटु धुराव नु झापलु हतु, अने चवड़ाय पचाह हात हती। <verse eid="EZK 42:2" /><verse number="3" style="v" sid="EZK 42:3" />मोय नु आंगणु नी वीह हात अगळ अने बाहरलु आंगणु ना फर्‌सी नी अगळ तीनोव मंजली मे छीवण्‌या हता। <verse eid="EZK 42:3" /><verse number="4" style="v" sid="EZK 42:4" />कोपरा नी अगळ मोय नी ह़ोड़ जवा वाळी एक दह हात चवड़ी एक वाट हती; अने हात भर नी अळी वाट हती; अने कोपरा ना झापला धुराव भणीन हता। <verse eid="EZK 42:4" /><verse number="5" style="v" sid="EZK 42:5" />उपरला कोपरा नाना हता, मतलब छीवण्‌या ना कारण सी तीहया वचला अने हेटला कोपरा गेथा नाना हता। <verse eid="EZK 42:5" /><verse number="6" style="v" sid="EZK 42:6" />काहाके तीहया तीन मंजली ना हता, अने आंगणुन तेम तीमना खम्‌बा नी हता; आहया कारण सी उपरला कोपरा हेटला अने वचे ना कोपरा गेथा नाना हता। <verse eid="EZK 42:6" /><verse number="7" style="v" sid="EZK 42:7" />जे भीड़तु कोपरा नी बाहर तीमनी पांह हतु मतलब कोपरा नी अगळ बाहरलु आंगणु भणीन हतु, तीनी लम्‌बाय पचाह हात हती। <verse eid="EZK 42:7" /><verse number="8" style="v" sid="EZK 42:8" />काहाके बाहरलु आंगणु ना कोपरा पचाह हात नाम्‌बा हता, अने तीनी अगळ ना कोपरा ह़ोव हात ना हता। <verse eid="EZK 42:8" /><verse number="9" style="v" sid="EZK 42:9" />आहया कोपरान हेटी उगवणी ह़ोड़ वाट हती, जां माणहु बाहरलु आंगणु मे गेथा आमनी मे जता हता। <verse eid="EZK 42:9" /><verse number="10" style="v" sid="EZK 42:10" />आंगणु नु भीड़तु नी चवड़ाय मे उगवणी ह़ोड़ अलग जागो अने घोर बेम नी अगळ कोपरा हता। <verse eid="EZK 42:10" /><verse number="11" style="v" sid="EZK 42:11" />तीमनी अगळ नी वाट धुराव ना कोपरा नी वाट ह़रकी हती; तीमनी लम्‌बाय अने चवड़ाय बराबर हती अने नीकळवा नु अने बणावट तीमना झापलान तेवा हता। <verse eid="EZK 42:11" /><verse number="12" style="v" sid="EZK 42:12" />दखणाव ना कोपरा ना झापला नी अनसारे वाट ना मुंडे झापलु हतु, मतलब उगवणी ह़ोड़ नु भीतड़ुन अगळ, जां गेथा माणहु तीमनी मे मोय भरायता हता।<verse eid="EZK 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 42:13" />अळतेण तीहयो मने केदो, “आहया धुराव अने दखणाव भणीन ना कोपरा जे आंगणु नी अगळ से, तीहयात चोखला कोपरा से, जीनी मे यहोवा अगळ जवा वाळा पुंजारा आखु सी चोखली चीज खाया करहे, तीहयी आखु सी चोखली आखी चीज, अने अनबादा, पापबादा, अने गुना नी बादा, तांत मेकहे; काहाके तीहयो जागो चोखलो से। <verse eid="EZK 42:13" /><verse number="14" style="v" sid="EZK 42:14" />जत्‌यार-जत्‌यार पुंजारा माणहु मोय जहे, तत्‌यार-तत्‌यार नीकळवा नी टेमे तीहया चोखला जागा मे गेथा बाहरला आंगणा मे एमेत नी नीकळे, मतलब तीहया पेले आह़फाम ना सेवा-चाकरी करवा ना लुगड़ा चोखला जागा मे मेक देहे; काहाके आहया कोपरा चोखला से। ता तीहया बीजा लुगड़ा पेरीन बीजा आखा माणहु ना जागा मे जहे।”<verse eid="EZK 42:14" /></para>
  <para style="s">मंदीर ना आखा जागा नु मापवु</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 42:15" />जत्‌यार तीहयो मोय ना घोर ने माप देदो, ता मने उगवणी ह़ोड़ ना फाटा नी वाटे गेथो बाहर ली जाय्‌न बाहर नो जागो च्‌यारो-मेर मापवा बाज ज्‌यो। <verse eid="EZK 42:15" /><verse number="16" style="v" sid="EZK 42:16" />तीहयो उगवणी ह़ोड़ नु ने मापवा नु टोकरु वेर माप्‌यो, अने तीहयु पांच ह़ो टोकरा नीकळ्‌यु। <verse eid="EZK 42:16" /><verse number="17" style="v" sid="EZK 42:17" />ता तीहयो उगवणी ह़ोड़ नु ने मापवा नु टोकरु वेर माप्‌यो, अने तीहयु पांच ह़ोव टोकरा नीकळ्‌यु। <verse eid="EZK 42:17" /><verse number="18" style="v" sid="EZK 42:18" />ता तीहयो दखणाव ह़ोड़ नु ने मापवा नु टोकरु वेर माप्‌यो, अने तीहयु पांच ह़ोव टोकरा नीकळ्‌यु। <verse eid="EZK 42:18" /><verse number="19" style="v" sid="EZK 42:19" />अने बुडवणी ह़ोड़ वळीन तीहयो मापवा नु टोकरु वेर माप्‌यो, अने तीहयु पांच ह़ोव टोकरा नीकळ्‌यु। <verse eid="EZK 42:19" /><verse number="20" style="v" sid="EZK 42:20" />तीहयो तीहया जागा नी च्‌यारोव काकड़ ने माप्‌यो, अने तीनी च्‌यारो-मेर एक भीतड़ु हतु, तीहयु पांच ह़ोव टोकरा नाम्‌बु अने पांच ह़ोव चवड़ु हतु, अने आनीन करते बणलु हतु के चोखला अने बीजा आखा जागा ने अलग-अलग करे।<verse eid="EZK 42:20" /></para>
  <chapter eid="EZK 42" />
  <chapter number="43" style="c" sid="EZK 43" />
  <para style="s">घोर मे भगवान नु वीजाळु</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 43:1" />अळतेण तीहयो मने तीहया फाटान्‌तां लीज्‌यो जे उगवणो फीरीन नो हतो। <verse eid="EZK 43:1" /><verse number="2" style="v" sid="EZK 43:2" />ता ईस्‌रायल ना भगवान नु वीजाळु उगवणी ह़ोड़ गेथु आयु; अने तीनी अवाज दर्‌या नु पाणी नी गाज ने तेवी हती; अने तीनु वीजाळु वेर धरती उजड़ान हयी।<note caller="+" style="x"><char style="xo" closed="false">43:2 </char><char style="xt" closed="false"><ref loc="EZK 10:3">यहेजकेल 10:3</ref>,<ref loc="EZK 10:4">4</ref>,<ref loc="EZK 10:18">18</ref>,<ref loc="EZK 10:19">19</ref>; <ref loc="EZK 11:22">11:22</ref>,<ref loc="EZK 11:23">23</ref>; <ref loc="REV 1:15">परकासीतवाक्‌य 1:15</ref></char></note> <verse eid="EZK 43:2" /><verse number="3" style="v" sid="EZK 43:3" />आहयो दरसन तीहया दरसन ने तेवो हतो, जे में तीने ह़ेर ने खत्‌तम करवा करीन आव्‌वा नी टेमे देखलो हतो; अने तीहया दरसन ने तेम, जे में कबार नंदी ना काठे देखलो हतो; अने में मोडा ना भरहे पड़ ज्‌यो। <verse eid="EZK 43:3" /><verse number="4" style="v" sid="EZK 43:4" />ता यहोवा नु वीजाळु तीहया फाटे हय्‌न घोर मे आय लाग्‌यु, जे उगवणो फीरीन हतो।<verse eid="EZK 43:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EZK 43:5" />ता आत्‌मा मने उचलीन मोय नु आंगणु मे पुगाड़ देदी; अने यहोवा नु वीजाळु घोर मे भराय जेलु हतु। <verse eid="EZK 43:5" /><verse number="6" style="v" sid="EZK 43:6" />ता में एक जणा नो बोल ह़मळ्‌यो, जे घोर मे गेथो मने केवा बाज र्‌यो हतो, अने तीहयो अदमी मारी ह़ाते उबो हय र्‌यो हतो। <verse eid="EZK 43:6" /><verse number="7" style="v" sid="EZK 43:7" />तीहयो मने केदो, “ए माणेह नी अवल्‌यात, यहोवा आसम केय: आहयो ते मारी राजगादी नो जागो अने पोग मेकवा नो जागो से, जा में ईस्‌रायल नी वच मे जलम रीया करही। नी ते ईस्‌रायल नु घोराणु, अने नी तीना राजा तीमनु छीनाळु सी, नीता आह़फाम ना उचा जागा मे आह़फाम ना राजाम ना धोड़ु नी लारे मारु चोखलु नाम वीटळ्‌ळु ठेरावे। <verse eid="EZK 43:7" /><verse number="8" style="v" sid="EZK 43:8" />तीहया आह़फाम नी ढेहळ मारी ढेहळ ने तां, अने आह़फाम ना झापला ना खम्‌बा मारा झापला ना खम्‌बान्‌तां बणावता हता, अने मारी अने तीमनी वच मे भीतड़ु एतरुत हतु, अने तीहया तीमना गलत कामु वेर मारु चोखलु नाम वीटळ्‌ळु ठेरावला हता; करीन मे रीह करीन तीमने खत्‌तम कर्‌यो। <verse eid="EZK 43:8" /><verse number="9" style="v" sid="EZK 43:9" />हाव तीहया आह़फाम नु छीनाळु अने आह़फाम ना राजा ना धोड़ मारी अगळ गेथा सेटा कर देय, ता में तीमनी वच मे जलम रीया करही।<verse eid="EZK 43:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 43:10" />“ए माणेह नी अवल्‌यात, तु ईस्‌रायल ना घोराणा ने भक्‌ती ना बारा मे देखाड़ के तीहया आह़फाम ना अधरम ना कामु सी लजवाय्‌न तीहया भक्‌ती करवा ह़ीके । <verse eid="EZK 43:10" /><verse number="11" style="v" sid="EZK 43:11" />कदीम तीहया आह़फाम ना आखा कामु सी लजवाय, ता तीमने आहया घोर नी बणावट अने केवु बणाव्‌वा, अने तीनी मोय-बारा आव्‌वा-जवा नी वाट, अने तीनी आखी बणावट रीती, अने नेम देखाड़जे, अने तीनी अगळ लीख राखजे; जीनी सी तीहया आनी आखी बणावट अने आनी रीती ने फोम करीन तीनी अनसारे करे। <verse eid="EZK 43:11" /><verse number="12" style="v" sid="EZK 43:12" />घोर नो नेम आहयो से के बड़ा नी चोट्‌ली नी च्‌यारो-मेर नो आखो वाटो आखा गेथो चोखलो से। देख, घोर नो नेम आहयोत से।<verse eid="EZK 43:12" /></para>
  <para style="s">वेदी नी बणावट</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 43:13" />“एवा हात ना माप सी जे आखा बीजा हात सी च्‌यार आंगळा जादा हय, वेदी नी माप आहयी रेय, मतलब तीनी नीव एक हात नो, अने तीनी चवड़ाय एक हात नी, अने तीनी च्‌यारो-मेर नी कोर पोर नी पटड़ी च्‌यार आंगळा नी। वेदी नी उचाय आहयी से:<note caller="+" style="x"><char style="xo" closed="false">43:13 </char><char style="xt" closed="false"><ref loc="EXO 27:1">नीरगमन 27:1</ref>,<ref loc="EXO 27:2">2</ref>; <ref loc="2CH 4:1">2 ईतीहास 4:1</ref></char></note> <verse eid="EZK 43:13" /><verse number="14" style="v" sid="EZK 43:14" />धरती पोर मेकला नीव गेथी लगाड़ीन हेटला पाया तक बे हात नी रेय, अने तीनी चवड़ाय हातेक रेय; अने नान्‌ला पाया गेथी लगाड़ीन मोट्‌ला पाया तक च्‌यार हात रेय अने तीनी चवड़ाय हातेक रेवा जोवे; <verse eid="EZK 43:14" /><verse number="15" style="v" sid="EZK 43:15" />अने उपरलो वाटो च्‌यार हात उचो रेय; अने वेदी पोर धपाड़वा ना जागा ना च्‌यार ह़ींगड़ा उपरली ह़ोड़ नीकळला रेय। <verse eid="EZK 43:15" /><verse number="16" style="v" sid="EZK 43:16" />वेदी पोर धपाड़वा नो जागो च्‌यार-खुट्‌यो रेवा जोवे, अने बारे हात नाम्‌बु अने बारे हात चवड़ु रेय। <verse eid="EZK 43:16" /><verse number="17" style="v" sid="EZK 43:17" />हेट्‌लो पायो चवदे हात नाम्‌बो अने चवदे हात चवड़ो रेय, अने तीनी च्‌यारो-मेर नी पटड़ी आदा हात नी रेय, अने नीव च्‌यारो-मेर हातेक रेय। तीनी पयड़ी तीनी उगवणी ह़ोड़ रेय।”<verse eid="EZK 43:17" /></para>
  <para style="s">वेदी ने ह़ोपणु</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 43:18" />अळतेण तीहयो मने केदो, “ए माणेह नी अवल्‌यात, भगवान यहोवा आसम केय, जे दाड़े होम बादा चड़ाव्‌वा अने लोय छाटवा करीन वेदी बणावे, तीहया दाड़े नी रीती-भाती आहयी ठेरे:<note caller="+" style="x"><char style="xo" closed="false">43:18 </char><char style="xt" closed="false"><ref loc="EXO 29:35-37">नीरगमन 29:35-37</ref></char></note> <verse eid="EZK 43:18" /><verse number="19" style="v" sid="EZK 43:19" />मतलब लेवी पुंजारा माणहु, जे सादोक नी अवल्‌यात से, अने मारी सेवा-चाकरी करवा करीन मारी ह़ाते रेय, तीमने तु पाप नी बादा जुगु एक वाछड़ु आपजे, भगवान यहोवा आसमेत केय। <verse eid="EZK 43:19" /><verse number="20" style="v" sid="EZK 43:20" />ता तु तीनु लोय मे गेथु थोड़ुक लीन वेदी ना च्‌यारोव ह़ींगड़ा पोर अने कुड़ची ना च्‌यारो खुणा पोर अने च्‌यारो-मेर नी पटड़ी पोर लगाड़जे; आहयी भाते तीनी जुगु पछतावो करवा नी लारे तीने चोखी करजे। <verse eid="EZK 43:20" /><verse number="21" style="v" sid="EZK 43:21" />ता पाप नी बादा नु वाछड़ु ने लीन, घोर ना चोखला जागा नी बाहर ठेरावला जागा मे धपाड़ देजे। <verse eid="EZK 43:21" /><verse number="22" style="v" sid="EZK 43:22" />बीजा दाड़े एक वण-गुनाळ्‌ळो बोकड़ो पाप नी बादा करीन चड़ावजे, अने जेम वाछड़ु नी लारे वेदी ने चोखी करे, तेमेत आहया बोकड़ा नी लारे बी चोखी करे। <verse eid="EZK 43:22" /><verse number="23" style="v" sid="EZK 43:23" />जत्‌यार तु तीने चोखी कर देय, ता एक वण-गुनाळ्‌ळु वाछड़ु, अने एक वण-गुनाळ्‌ळु गाडरु चड़ावजे। <verse eid="EZK 43:23" /><verse number="24" style="v" sid="EZK 43:24" />तु तीमने यहोवा नी अगळ ली आवजे, अने पुंजारा माणहु तीमनी पोर खरलु-मीठु नाखीन तीमने यहोवा ने होम बादा करीन चड़ावे। <verse eid="EZK 43:24" /><verse number="25" style="v" sid="EZK 43:25" />ह़ात दाड़ा तक तु दाड़ीक पाप नी बादा जुगु एक बोकड़ो तीयार करजे, अने वण-गुनाळ्‌ळु वाछड़ु अने गाडरा मे गेथु एक गाडरु बी तीयार करे। <verse eid="EZK 43:25" /><verse number="26" style="v" sid="EZK 43:26" />ह़ात दाड़ा तक पुंजारा माणहु वेदी जुगु पछतावो करीन तीने चोखा करता रेय; आहयीत रीते तीनी रीती हये। <verse eid="EZK 43:26" /><verse number="27" style="v" sid="EZK 43:27" />जत्‌यार तीहया दाड़ा पुरा हय जाय, ता आंठवा दाड़ान अळतेण गेथा पुंजारा माणहु तमारी होम बादा अने मेल-मीलाप नी बादा वेदी पोर चड़ाया करे; ता मे तमारी सी खुस हयही, भगवान यहोवा आसमेत केय।”<verse eid="EZK 43:27" /></para>
  <chapter eid="EZK 43" />
  <chapter number="44" style="c" sid="EZK 44" />
  <para style="s">उगवणु झापलु नु वापर करनु</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 44:1" />अळतेण तीहयो मने चोखला जागा ना तीहया बारहला फाटान्‌तां पासो ली ज्‌यो, जीनु झापलु उगवणु से; अने तीहयु देदलु से। <verse eid="EZK 44:1" /><verse number="2" style="v" sid="EZK 44:2" />ता यहोवा मने केदो, “आहयो फाटो देदलो रेय अने उगाड़वा नी जोवे; कोय बी आनी मे हय्‌न मोय नी जवा जोवे; काहाके ईस्‌रायल नो भगवान यहोवा आनी मे हय्‌न मोय आवलो से; आहया कारण सी आहयो देदलो रेय। <verse eid="EZK 44:2" /><verse number="3" style="v" sid="EZK 44:3" />मुख्‌यो एतरोत, मुख्‌यो हयवा ना कारण सी, मारी अगळ खाणु खावा करीन तां बठहे; तीहया फाटा ना मांडवा मे माय्‌न मोय जाय, अने आहयीत रीते नीकळे।”<verse eid="EZK 44:3" /></para>
  <para style="s">मंदीर मे मोय जवा ना नेम</para>
  <para style="p">
    <verse number="4" style="v" sid="EZK 44:4" />अळतेण तीहयो मने धुराव ना फाटान्‌तां माय्‌न मने घोर नी अगळ ली ज्‌यो; ता मे देख्‌यो के यहोवा नु घोर यहोवा नु वीजाळु सी भराय जेलु से; अने मे मोडा ना भरहे पड़ ज्‌यो। <verse eid="EZK 44:4" /><verse number="5" style="v" sid="EZK 44:5" />ता यहोवा मन केदो, “ए माणेह नी अवल्‌यात, धीयान दीन तारा डोळा वेर देख, अने जे कंय मे तने मारा घोर ना आखा रीत्‌या-भात्‌या अने नेमु ना बारा मे केम, तीहया आखा तारा कांटा वेर ह़मळ; अने घोर ना मोय आव्‌वा ना अने चोखला जागा ना आखा नीकळवा ना पोर धीयान दे।<verse eid="EZK 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 44:6" />“अने तीहया बक-बक करन्‌या मतलब ईस्‌रायल ना घोराणा ने के, भगवान यहोवा आसम केय: ए ईस्‌रायल ना घोराणा, आह़फाम ना आखा गलत कामु सी हाव हात सेटा करो। <verse eid="EZK 44:6" /><verse number="7" style="v" sid="EZK 44:7" />जत्‌यार तमु मारु खाणु मतलब चर्‌बी अने लोय चड़ावता हता, ता तमु बीजा माणहु ने जे मन सी अने डील सी खतना वगर ना हता, मारा चोखला जागा मे आव्‌वा देता हता के तीहया मारा घोर ने वीटाळे; अने तीहया मारा वायदा ने तोड़ नाख्‌या जीनी सी तमारा आखा गलत काम जादा हय ज्‌या। <verse eid="EZK 44:7" /><verse number="8" style="v" sid="EZK 44:8" />तमु मारु चोखलु ह़मान नी रखवाळी नी कर्‌या, पण तमु तमारात मन सी बीजा माणहु ने मारा चोखला जागा मे मारु चोखलु ह़मान नी रखवाळी करवा वाळा ठेराया।<verse eid="EZK 44:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 44:9" />“करीन भगवान यहोवा आसम केय: ईस्‌रायलीम नी वच मे जेतरा बीजा माणहु हय, जे मन अने डील बेम ना खतना वगर ना से, तीमनी मे गेथा कोय बी मारा चोखला जागा मे नी आव्‌वा जोवे।”<verse eid="EZK 44:9" /></para>
  <para style="s">लेवीम ने पुंजारा ना जागा जुगु अलग कर्‌या</para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 44:10" />“पण लेवी माणहु जे तीहयी टेमे मारी गेथा सेटा हय जेला हता, जत्‌यार ईस्‌रायली माणहु मने छोड़ीन आह़फाम ना मुरत्‌या पछळ भटक जेला हता, तीहया आह़फाम ना अधरम नो भार उचलहे। <verse eid="EZK 44:10" /><verse number="11" style="v" sid="EZK 44:11" />पण तीहया मारा चोखला जागा मे सेवा करवा वाळा बणीन घोर ना झापला ना पेहरो देवा वाळा अने घोर ना सेवा करवा वाळा रेहे; तीहया होम बादा अने मेलबादा ना जानवरु माणहु जुगु मारे, अने तीमनी सेवा-चाकरी करवा करीन तीमनी अगळ उबा हया करे। <verse eid="EZK 44:11" /><verse number="12" style="v" sid="EZK 44:12" />काहाके ईस्‌रायल ना घोराणा नी सेवा-चाकरी तीहया तीमना मुरत्‌या अगळ करता हता, अने तीमना ठोकर खावा अने अधरम मे फसवा नो कारण बण जेला हता; आहया कारण सी में तीमना बारा मे ह़ाम खादलो से के तीहया आह़फाम ना अधरम नो भार उचले, भगवान यहोवा आसमेत केय। <verse eid="EZK 44:12" /><verse number="13" style="v" sid="EZK 44:13" />तीहया मारी ह़ाते नी आवे, अने नी मारी जुगु पुंजारा नु काम करे; अने नी मारु कानु बी चोखलु ह़मान, नीता आखा गेथु चोखलु ह़मान ने छीमे; तीहया आह़फाम नी लाज नो अने जे गलत काम तीहया कर्‌या, तीमनो बी भार उचले। <verse eid="EZK 44:13" /><verse number="14" style="v" sid="EZK 44:14" />ते बी में तीमने घोर मे नु ह़ोपलु ह़मान नो रखवाळ्‌यो बणावही; तीनी मे सेवा नु जेतरु काम हय, अने जे कंय तीनी मे करवा नु हय, तीने करवा वाळा तीहयात रेय।”<verse eid="EZK 44:14" /></para>
  <para style="s">पुंजारा</para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 44:15" />अळतेण लेवी पुंजारा जे सादोक नी अवल्‌यात से, अने जे तीहयी टेमे मारा चोखला जागा नी रखवाळी करला जत्‌यार ईस्‌रायली माणहु मारीन्‌तां गेथा भटक जेला हता, तीहया मारी सेवा-चाकरी करवा करीन मारी अगळ आया करे, अने मने चर्‌बी अने लोय चड़ाव्‌वा करीन मारी अगळ उबा हया करे, भगवान यहोवा आसमेत केय। <verse eid="EZK 44:15" /><verse number="16" style="v" sid="EZK 44:16" />तीहया मारा चोखला जागा मे आया करे, अने मारी टेबल ने तां मारी सेवा-चाकरी करवा करीन आवे अने मारु ह़मान नी रखवाळी करे। <verse eid="EZK 44:16" /><verse number="17" style="v" sid="EZK 44:17" />जत्‌यार तीहया मारा मोय ना झापले माय्‌न जीया करे, ता ह़ोण ना लुगड़ा पेरला जाय, अने जत्‌यार तीहया मोय ना आंगणा ना फाटे नीता तीनी मोय सेवा-चाकरी करता हय, ता हीर ना काना लुगड़ा नी पेरे। <verse eid="EZK 44:17" /><verse number="18" style="v" sid="EZK 44:18" />तीहया मुंडा पोर ह़ोण ना घटाळ्‌ळा टोप्‌या पेरे अने केड़ मे ह़ोण ना चड्‌या पेरला रेय; काना एवा कापड़ा तीहया केड़े नी पेरे जीनी सी पसीनो आवे।<note caller="+" style="x"><char style="xo" closed="false">44:18 </char><char style="xt" closed="false"><ref loc="EXO 28:39-43">नीरगमन 28:39-43</ref>; <ref loc="LEV 16:4">लेव्‌यवेवस्‌था 16:4</ref></char></note> <verse eid="EZK 44:18" /><verse number="19" style="v" sid="EZK 44:19" />जत्‌यार तीहया बाहरला आंगणा मे माणहुन्‌तां नीकळे, ता जे लुगड़ा पेरला तीहया सेवा-चाकरी तीहया करता हता, तीमने नीकाळीन अने चोखला कोपरा मे मेकीन बीजा लुगड़ा पेरे, जीनी सी माणहु तीमना लुगड़ा ना कारण सी चोखला नी ठेरे।<note caller="+" style="x"><char style="xo" closed="false">44:19 </char><char style="xt" closed="false"><ref loc="LEV 16:23">लेव्‌यवेवस्‌था 16:23</ref></char></note> <verse eid="EZK 44:19" /><verse number="20" style="v" sid="EZK 44:20" />नी तीहया मुंडु बोड़ावे, अने नी नीम्‌बाळा नाम्‌बा हयवा देय; तीहया आह़फाम ना नीम्‌बाळा तोड़ावे एतरात।<note caller="+" style="x"><char style="xo" closed="false">44:20 </char><char style="xt" closed="false"><ref loc="LEV 21:5">लेव्‌यवेवस्‌था 21:5</ref></char></note> <verse eid="EZK 44:20" /><verse number="21" style="v" sid="EZK 44:21" />मोय ना आंगणा मे जवा नी टेमे कोय ह़रु नी पीय।<note caller="+" style="x"><char style="xo" closed="false">44:21 </char><char style="xt" closed="false"><ref loc="LEV 10:9">लेव्‌यवेवस्‌था 10:9</ref></char></note> <verse eid="EZK 44:21" /><verse number="22" style="v" sid="EZK 44:22" />तीहया रंडायली नीता छोड़ली बयर ह़ाते वेवा नी करे; ईस्‌रायल नात घोराणा ना कुळ मे गेथी कुवारी ह़ाते नीता एवी रंडायली ह़ाते वेवा करे जे काना पुंजारा नी लाडी बणी हय।<note caller="+" style="x"><char style="xo" closed="false">44:22 </char><char style="xt" closed="false"><ref loc="LEV 21:7">लेव्‌यवेवस्‌था 21:7</ref>,<ref loc="LEV 21:13">13</ref>,<ref loc="LEV 21:14">14</ref></char></note> <verse eid="EZK 44:22" /><verse number="23" style="v" sid="EZK 44:23" />तीहया मारा माणहु ने चोखलु अने वीटळ्‌ळु नो फरक देखाड़्‌या करे, अने वारलु अने नी वारलु नो फरक देखाड़्‌या करे। <verse eid="EZK 44:23" /><verse number="24" style="v" sid="EZK 44:24" />जत्‌यार कानो लड़ाय-झगड़ो नीता कानी वात हय ता नीयाव करवा करीन तीहयात बहे, अने मारा नेम नी अनसारे नीयाव करे। अने मारा आखा टाकला तीवार ना बारा मे बी तीहया मारा नेम अने रीतीम ने मान्‌या करे, अने मारा अराम ना दाड़ा ने चोखला माने। <verse eid="EZK 44:24" /><verse number="25" style="v" sid="EZK 44:25" />तीहया काना बी माणेह ना धोड़ ने तां नी जाय नीता वीटळ जहे; कदीम आय्‌ह-बाहा; भाय नीता एवी बेनेह हय जीना वेवा नी हया हय ता आह़फाम ने वीटाळ सके। <verse eid="EZK 44:25" /><verse number="26" style="v" sid="EZK 44:26" />जत्‌यार तीहया वीटळ जाय, ता तीमनी जुगु ह़ात दाड़ा ठेरावे अळतेण तीहया चोखला ठेरे। <verse eid="EZK 44:26" /><verse number="27" style="v" sid="EZK 44:27" />अळतेण जे दाड़े तीहया चोखला जागा मे मतलब मोय ना आंगणा मे सेवा-चाकरी करवा करीन अळी जाय, तीहया दाड़े आह़फाम नी जुगु पाप नी बादा चड़ावे, भगवान यहोवा आसमेत केय।<verse eid="EZK 44:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 44:28" />“तीमनो एकीत खुद नो वाटो रेहे, मतलब तीमनो वाटो मेंत से; तमु तीमने ईस्‌रायल नी वच मे कंय आवी जागा नी आपजो जे तीमनो खुद नो हये; तीमनो खुद नो जागो मेंत से।<note caller="+" style="x"><char style="xo" closed="false">44:28 </char><char style="xt" closed="false"><ref loc="NUM 18:20">गीनती 18:20</ref></char></note> <verse eid="EZK 44:28" /><verse number="29" style="v" sid="EZK 44:29" />तीहया अनबादा, पापबादा अने गुना नी बादा खाया करे; अने ईस्‌रायल मे जे ह़मान मने ह़ोपे, तीहयु तीमने जड़्‌या करे। <verse eid="EZK 44:29" /><verse number="30" style="v" sid="EZK 44:30" />आखी भाती नी आखा सी पेली मेर अने आखी भाती नु मने चड़ावलु ह़मान जे तमु चड़ावो; पुंजारा ने जड़्‌या करे; अने नवला अन नो पेल्‌लो कोहणलो लोट बी पुंजारा ने आप्‌या करजो, जीनी सी तमारा घोरु मे बरकत हये। <verse eid="EZK 44:30" /><verse number="31" style="v" sid="EZK 44:31" />जे कंय आह़फुत मर जाय नीता कंय जानवर मारे, भले चड़ा हय नीता जानवर तीनु मांह पुंजारा नी खाय।”<note caller="+" style="x"><char style="xo" closed="false">44:31 </char><char style="xt" closed="false"><ref loc="LEV 22:8">लेव्‌यवेवस्‌था 22:8</ref></char></note><verse eid="EZK 44:31" /></para>
  <chapter eid="EZK 44" />
  <chapter number="45" style="c" sid="EZK 45" />
  <para style="s">देस नी जागा मे भगवान नो वाटो</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 45:1" />जत्‌यार तमु चीट्‌ठी नाखीन देस ने वाटो, ता देस मे गेथो एक वाटो चोखलो जाणीन यहोवा ने ह़ोपजो; तीनी लम्‌बाय पच्‌चीह हजार टोकरा रेय अने चवड़ाय दह हजार टोकरा रेय, तीहयो वाटो तीनी च्‌यारो-मेर नी काकड़ तक चोखलो ठेरे। <verse eid="EZK 45:1" /><verse number="2" style="v" sid="EZK 45:2" />तीनी मे गेथो चोखला जागा जुगु पांच ह़ोव टोकरा नाम्‌बो अने पांच ह़ोव टोकरा चवड़ो जागो रेय, अने तीनी च्‌यारो-मेर पचाह-पचाह हात चवड़ो जागो छुट्‌लो पड़लो रेय। <verse eid="EZK 45:2" /><verse number="3" style="v" sid="EZK 45:3" />तीहया चोखला जागा मे तमु पच्‌चीह हजार टोकरा नाम्‌बो अने दह हजार टोकरा चवड़ो जागो मापजो; अने तीनीत मे चोखलो जागो बणावजो, जे आखा गेथो चोखलो ठेरे। <verse eid="EZK 45:3" /><verse number="4" style="v" sid="EZK 45:4" />जे पुंजारो चोखला जागा नी सेवा-चाकरी करे अने यहोवा नी सेवा-चाकरी करवा करीन ह़ाते आवे, तीहयो तीमनीत जुगु रेय; तां तीमना घोरु जुगु जागो रेय अने चोखला जागा जुगु चोखलो ठेरे। <verse eid="EZK 45:4" /><verse number="5" style="v" sid="EZK 45:5" />अळतेण पच्‌चीह हजार टोकरा नाम्‌बो, अने दह हजार टोकरा चड़वो एक वाटो, घोर नी सेवा-चाकरी करवा वाळा लेवीम ना वीह कोपरा जुगु रेय।<verse eid="EZK 45:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EZK 45:6" />अळतेण ह़ेर जुगु, ह़ोपला चोखला जागान्‌तां तमु पांच हजार टोकरा चड़वो अने पच्‌चीह हजार टोकरा नाम्‌बो, खास जागो ठेरावजो; तीहयो ईस्‌रायल ना आखा घोराणा जुगु रेय।<verse eid="EZK 45:6" /></para>
  <para style="s">मुख्‌या जुगु जागो</para>
  <para style="p">
    <verse number="7" style="v" sid="EZK 45:7" />मुख्‌या नो खुद नो वाटो चोखला ह़ोपला वाटा अने ह़ेर ना खास जागा नी बेम ह़ोड़ मतलब बेम नी बुडवणी अने उगवणी ह़ोड़ बेम वाटा नी अगळ हय; अने तीनी लम्‌बाय बुडवणी गेथी लगाड़ीन उगवणी ह़ोड़ तक तीहया बे वाटा मे गेथो काना बी एक नी बराबर हय। <verse eid="EZK 45:7" /><verse number="8" style="v" sid="EZK 45:8" />ईस्‌रायल ना देस मे मुख्‌या नो आहयोत खुद नो जागो रेय। मारा ठेरावला मुख्‌या मारा माणहु ने अळी वेला नी पाड़े; पण ईस्‌रायल ना घोराणा ने तीमना घोराणा नी अनसारे देस जड़े।<verse eid="EZK 45:8" /></para>
  <para style="s">मुख्‌या जुगु नेम</para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 45:9" />भगवान यहोवा आसम केय, “ए ईस्‌रायल ना मुख्‌या! रेवा देवो, वेला पाड़वा अने दमवा छोड़ देवो, अने नीयाव अने धरम ना काम कर्‌या करो; मारा माणहु ने नीकाळवा छोड़ देवो, भगवान यहोवा आसमेत केय।<verse eid="EZK 45:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EZK 45:10" />“तमारी ताकड़ी, माप-तोल ना बाट अने मापवा नु ठाहरु खरलु रेय।<note caller="+" style="x"><char style="xo" closed="false">45:10 </char><char style="xt" closed="false"><ref loc="LEV 19:36">लेव्‌यवेवस्‌था 19:36</ref> </char></note><verse eid="EZK 45:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EZK 45:11" />“एपा<note caller="+" style="f"><char style="fr" closed="false">45:11 </char><char style="fq" closed="false">एपा </char><char style="ft" closed="false">10 कीला बराबर</char></note> अने बाट बेम एकीत माप ना रेय, मतलब बेम मे होमोर नो दह़वो वाटो ह़माय; बेम नी माप होमोर ना हीसाप सी रेय।<verse eid="EZK 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 45:12" />“सेकेल<note caller="+" style="f"><char style="fr" closed="false">45:12 </char><char style="fq" closed="false">सेकेल </char><char style="ft" closed="false">11गराम सी थोड़ुक वदु रेय</char></note> वीह गेरा<note caller="+" style="f"><char style="fr" closed="false">45:12 </char><char style="fq" closed="false">गेरा </char><char style="ft" closed="false">आदो गराम</char></note> नो रेय; अने तमारा मानेह<note caller="+" style="f"><char style="fr" closed="false">45:12 </char><char style="fq" closed="false">मानेह </char><char style="ft" closed="false">आनो भार आदा कीला सी थोड़ोक वदु रेय</char></note> वीह, पच्‌चीह, नीता पंदरे सेकेल नी रेय।<verse eid="EZK 45:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 45:13" />“तमारी भेट आहयी रेय, मतलब गम ना होमेर<note caller="+" style="f"><char style="fr" closed="false">45:13 </char><char style="fq" closed="false">होमेर </char><char style="ft" closed="false">100 कीलो बराबर</char></note> वेर एपा नो छटवो वाटो, अने जळगम ना होमेर मे गेथा एपा नो छटवो वाटो आपजो। <verse eid="EZK 45:13" /><verse number="14" style="v" sid="EZK 45:14" />तेल नो ठेरावलो वाटो कोर<note caller="+" style="f"><char style="fr" closed="false">45:14 </char><char style="fq" closed="false">कोर </char><char style="ft" closed="false">220 लीटर</char></note> ते दह बत<note caller="+" style="f"><char style="fr" closed="false">45:14 </char><char style="fq" closed="false">बत </char><char style="ft" closed="false">22 लीटर</char></note> मतलब एक होमेर नी बराबर से, काहाके होमेर दह बाट नो रेय। <verse eid="EZK 45:14" /><verse number="15" style="v" sid="EZK 45:15" />ईस्‌रायल ना वारला-वारला चारवा ना जागा मे गेथा बे-बे ह़ो गाडरा-बोकड़ा मे गेथा एक गाडरु नीता बोकड़ु आपे। आहयु आखु ह़मान अनबादा, होम बादा अने मेल-मीलाप नी बादा जुगु आपे जीनी सी तीमनी जुगु पछतावो करे, भगवान यहोवा आसमेत केय।<verse eid="EZK 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 45:16" />“ईस्‌रायल ना मुख्‌या जुगु देस ना आखा माणहु आहयी भेट आपे। <verse eid="EZK 45:16" /><verse number="17" style="v" sid="EZK 45:17" />तीवार, नवला चांद ना दाड़ा, अराम ना दाड़ा अने ईस्‌रायल ना घोराणा नी आखी ठेरावली टेम मे होम बादा, अनबादा, अने रेचव्‌वा नी बादा आपवा मुख्‌या नुत काम रेय। ईस्‌रायल ना घोराणा जुगु पछतावो करवा करीन तीहयी पापबादा, अनबादा, होम बादा अने मेल-मीलाप नी बादा तीयार करे। ईस्‌रायल ना घोराणा जुगु पछतावो करवा करीन तीहयी पापबादा, अनबादा, होम बादा अने मेलबादा तीयार करे।”<verse eid="EZK 45:17" /></para>
  <para style="s">तीवार</para>
  <para style="r">(<ref loc="EXO 12:1-20">नीरगमन 12:1-20</ref>; <ref loc="LEV 23:33-43">लेव्‌यवेवस्‌था 23:33-43</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 45:18" />भगवान यहोवा आसम केय, “पेल्‌ला मयना ना पेल्‌ला दाड़े तु एक वण-गुनाळ्‌ळु वाछड़ु लीन चोखला जागा ने चोखो करजे। <verse eid="EZK 45:18" /><verse number="19" style="v" sid="EZK 45:19" />आहयी पापबादा नी लोय मे गेथु पुंजारो थोड़ुक लीन घोर नी चवखट ना खम्‌बे, अने वेदी ना पाया ना च्‌यारोव खुणा, अने मोय नु आंगणु ना फाटा ना खम्‌बा पोर लगाड़े। <verse eid="EZK 45:19" /><verse number="20" style="v" sid="EZK 45:20" />अळतेण भुलीन नीता गलती सी पाप कर्‌या हय तीमनी जुगु मयना ना ह़ातवा दाड़े बी आसमेत करजे; आहयीत रीते घोर जुगु पछतावो करजे।<verse eid="EZK 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 45:21" />“पेल्‌ला मयना ना चोवदवा दाड़े तमारो तीवार हया करे, तीहयो ह़ात दाड़ा नो तीवार रेय अने तीहया तीवार मे खमीर वगर ना रोट्‌ला खाय। <verse eid="EZK 45:21" /><verse number="22" style="v" sid="EZK 45:22" />तीहया दाड़े मुख्‌यो आह़फा अने आखा माणहु जुगु एक वाछड़ु पापबादा जुगु तीयार करे। <verse eid="EZK 45:22" /><verse number="23" style="v" sid="EZK 45:23" />तीवार ना ह़ातोव दाड़ा तीहयो यहोवा जुगु होम बादा तीयार करे, मतलब एक-एक दाड़े ह़ात-ह़ात वण-गुनाळ्‌ळा वाछड़ा अने ह़ात-ह़ात वण-गुनाळ्‌ळा गाडरा अने दाड़ीक एक-एक बोकड़ो पाप नी बादा जुगु तीयार करे। <verse eid="EZK 45:23" /><verse number="24" style="v" sid="EZK 45:24" />आखा वाछड़ा अने गाडरा ह़ाते तीहयो एपा भरीन अनबादा, अने एपा पसळ हीन<note caller="+" style="f"><char style="fr" closed="false">45:24 </char><char style="fq" closed="false">हीन </char><char style="ft" closed="false">साड़ी तीन लीटर</char></note> भर तेल तीयार करे।<verse eid="EZK 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EZK 45:25" />“ह़ातवा मयना ना पंदरवा दाड़े गेथा लगाड़ीन ह़ात दाड़ा तक मतलब तीवार ना दाड़ा मे तीहयो पापबादा, होम बादा, अनबादा अने तेल नी भेट आहयीत रीती नी अनसारे कर्‌या करे।”<verse eid="EZK 45:25" /></para>
  <chapter eid="EZK 45" />
  <chapter number="46" style="c" sid="EZK 46" />
  <para style="s">मुख्‌यो अने तीवार</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 46:1" />भगवान यहोवा आसम केय, “मोय नु आंगणु नो उगवणो फाटो काम-काज ना छोव दाड़ा देदलो रेय, पण अराम ना दाड़े उगड़लो रेय। अने नवला चांद ना दाड़े बी उगड़लो रेय। <verse eid="EZK 46:1" /><verse number="2" style="v" sid="EZK 46:2" />मुख्‌यो बाहर गेथो फाटा ना मांडवा नी वाटे माय्‌न आवीन फाटा ना एक खम्‌बान्‌तां उबो हय जाय, अने पुंजारो तीनी होम बादा अने मेल-मीलाप नी बादा तीयार करे; अने तीहयो फाटा नी डेहळी पोर वांदे; ता तीहयो बारो जाय, अने फाटो ह़ांतो तक नी देवा देवो। <verse eid="EZK 46:2" /><verse number="3" style="v" sid="EZK 46:3" />माणहु अराम अने नवला चांद ना दाड़ा मे तीहया फाटा ना झापले यहोवा अगळ वांदे। <verse eid="EZK 46:3" /><verse number="4" style="v" sid="EZK 46:4" />अराम ना दाड़े जे होम बादा मुख्‌या यहोवा जुगु चड़ावे, तीहया गाडरा ना छोव वण-गुनाळ्‌ळा बच्‌चा अने एक वण-गुनाळ्‌ळा गाडरा नु रेय। <verse eid="EZK 46:4" /><verse number="5" style="v" sid="EZK 46:5" />अनबादा आहयी रेय: मतलब गाडरा नी ह़ाते एपा भर अन अने गाडरा ना बच्‌चा भेळ ईच्‌छा नी अनसारे अन अने एपा ह़ाते हीन भर तेल। <verse eid="EZK 46:5" /><verse number="6" style="v" sid="EZK 46:6" />नवला चांद ना दाड़े तीहयो एक वण-गुनाळ्‌ळु वाछड़ु अने गाडरु ना छोव बच्‌चा अने एक गाडरो; आहया आखा वण-गुनाळ्‌ळा रेय। <verse eid="EZK 46:6" /><verse number="7" style="v" sid="EZK 46:7" />वाछड़ु अने गाडरा बेम नी ह़ाते तीहयो एक-एक एपा अनबादा तीयार करे, अने गाडरा ना बच्‌चा ह़ाते ईच्‌छा नी अनसारे अन, अने एपा ह़ाते हीर भर तेल। <verse eid="EZK 46:7" /><verse number="8" style="v" sid="EZK 46:8" />जत्‌यार मुख्‌यो मोय जाय ता तीहयो फाटा ना मांडवा मे माय्‌न जाय, अने तीहयीत वाटे नीकळी जाय।<verse eid="EZK 46:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 46:9" />“जत्‌यार बीजा आखा माणहु टाकली टेम पोर यहोवा अगळ वांदवा करीन आवे, ता जे धुराव ना फाटे माय्‌न वांदवा मोय आवे, तीहया दखणाव ना फाटे माय्‌न नीकळे, अने जे दखणाव ना फाटे माय्‌न मोय आवे, तीहया धुराव ना फाटे माय्‌न नीकळे, मतलब जे, जे फाटे माय्‌न मोय आहयु हय, तीहयु तीहया फाटे माय्‌न नी पासु जाय, आह़फाम नी अगळेत ह़ुदा नीकळ जाय। <verse eid="EZK 46:9" /><verse number="10" style="v" sid="EZK 46:10" />जत्‌यार तीहया मोय आवे ता मुख्‌यो तीमनी ह़ाते मोय आवे, अने जत्‌यार तीहया नीकळे, ता तीहया एक्‌ठा नीकळे। <verse eid="EZK 46:10" /><verse number="11" style="v" sid="EZK 46:11" />तीवारु अने बीजी टाकली टेम नी अनबादा वाछड़ु ह़ाते एपा भर अने गाडरा ह़ाते एपा भर हय; अने गाडरा ना बच्‌चा ह़ाते ईच्‌छा नी अनसारे अन अने एपा ह़ाते हीन भर तेल।<verse eid="EZK 46:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EZK 46:12" />“अळतेण जत्‌यार मुख्‌यो होम बादा नीता मेल-मीलाप नी बादा ने वारली बादा करीन यहोवा अगळ तीयार करे, ता उगवणा मोडा नो फाटो तीमनी जुगु उगाड़े, अने तीहया आह़फाम नी होम बादा नीता मेलबादा तेमेत तीयार करे जेम तीहयो अराम ना दाड़े करे; ता तीहयो नीकळे, अने तीने नीकळवान अळतेण फाटो देय।”<verse eid="EZK 46:12" /></para>
  <para style="s">दाड़ीक नी भेट</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 46:13" />“दाड़ीक तु सालेक नु एक वण-गुनाळ्‌ळु गाडरु नु बच्‌चु यहोवा जुगु होम बादा जुगु तीयार करजे, आहयु दाड़ीक ह़वारे तीयार करे। <verse eid="EZK 46:13" /><verse number="14" style="v" sid="EZK 46:14" />दाड़ीक ह़वारे तीनी ह़ाते एक अनबादा तीयार करजे, मतलब एपा नो छटवो वाटो अने मेदा मे भेसकवा करीन हीन भर तेल नो तीसरो वाटो यहोवा जुगु जलमकी अनबादा हमेसा नी रीती नी अनसारे चड़ाया करे। <verse eid="EZK 46:14" /><verse number="15" style="v" sid="EZK 46:15" />गाडरु नु बच्‌चु, अनबादा अने तेल, दाड़ीक ह़वारे हमेसा होम बादा करीन चड़ावे।”<verse eid="EZK 46:15" /></para>
  <para style="s">मुख्‌यो अने जागा नो वाटो</para>
  <para style="p">
    <verse number="16" style="v" sid="EZK 46:16" />भगवान यहोवा आसम केय: “कदीम मुख्‌यो आह़फा ना काना सोरा ने कंय आपे, ता तीहयो तीनो वाटो तीना सोरा ना सोरा ने बी जड़े; वाटा ना नेम नी अनसारे तीहयो तीमनो बी खुद नो वाटो ठेरे। <verse eid="EZK 46:16" /><verse number="17" style="v" sid="EZK 46:17" />पण कदीम तीहयो आह़फा ना वाटा मे गेथु कंय आह़फा ना पावर्‌या ने आपे, ता छुटवा ना दाड़े तक ते तीहयो तीनो रेय, पण अळतेण पासो मुख्‌या ने आप देय; अने तीनो खुद नो वाटोत तीना सोरा ने जड़े। <verse eid="EZK 46:17" /><verse number="18" style="v" sid="EZK 46:18" />माणहु नो एवो वाटो मुख्‌यो नी लेय, जे वेला पाड़ीन तीनी खुद नी जागा मे गेथो हापक्‌यो हय; आह़फा ना सोरा ने तीहयो आह़फा नी खुद नीत जागा मे गेथो वाटो आपे; आसम नी हयवा जोवे के मारा माणहु आह़फाम नी खुद नी जागा मे गेथा रीवण्‌या-तीवण्‌या हय जाय।”<verse eid="EZK 46:18" /></para>
  <para style="s">मंदीर ना रांदवा ना घोर</para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 46:19" />अळतेण तीहयो मने फाटा ना एक ह़ोड़ ना झापले माय्‌न पुंजारा ना धुराव भणी झापला वाळा चोखला कोपरान्‌तां ली ज्‌यो; तां बुडवणी ह़ोड़ ना खुणा मे एक जागो हतो। <verse eid="EZK 46:19" /><verse number="20" style="v" sid="EZK 46:20" />ता तीहयो मने केदो, “आहयो तीहयो जागो से जीनी मे पुंजारा गुना नी बादा अने पापबादा नु मांह ने रांदे अने अनबादा ने रांदे, आसम नी हयवा जोवे के तीमने बारहलु आंगणु मे लीजवा सी बीजा आखा माणहु चोखला ठेरे।”<verse eid="EZK 46:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 46:21" />ता तीहयो मने बाहरलु आंगणु मे ली जाय्‌न तीहया आंगणा ना च्‌यारोव खुणा मे फीरायो, अने आंगणु ना आखा खुणे एक-एक ओट्‌लो बणली हती, <verse eid="EZK 46:21" /><verse number="22" style="v" sid="EZK 46:22" />मतलब आंगणु ना च्‌यारोव खुणे चाळीह हात नाम्‌बा अने तीस हात चोवड़ा ओट्‌ला हता; च्‌यारोव खुणा ना ओट्‌ला नी एकीत माप हती। <verse eid="EZK 46:22" /><verse number="23" style="v" sid="EZK 46:23" />मोय च्‌यारो-मेर भीड़तु हतु, अने भीड़तु नी तळे रांदवा करीन चुला बणला हता। <verse eid="EZK 46:23" /><verse number="24" style="v" sid="EZK 46:24" />ता तीहयो मने केदो, “रांदवा ना घोर, जां घोर ना काम करन्‌या माणहु नी लारे चड़ावली बादा ने रांदे, तीहया आहयात से।”<verse eid="EZK 46:24" /></para>
  <chapter eid="EZK 46" />
  <chapter number="47" style="c" sid="EZK 47" />
  <para style="s">मंदीर मे गेथो वयत्‌लो झोर</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 47:1" />अळतेण तीहयो मने घोर ना झापले पासो ली जती र्‌यो; अने घोर नी ढेहळ नी तळे गेथो झोर नीकळीन उगवणी ह़ोड़ वय र्‌यो हतो। घोर नु झापलु ते उगवणी ह़ोड़ हतु, अने झोर घोर नी जमणी ह़ोड़ अने वेदी नी दखणाव नी ह़ोड़ हेटो गेथो नीकळतो हतो।<note caller="+" style="x"><char style="xo" closed="false">47:1 </char><char style="xt" closed="false"><ref loc="ZEC 14:8">जकर्‌याह 14:8</ref>; <ref loc="JHN 7:38">युहन्‌ना 7:38</ref>; <ref loc="REV 22:1">परकासीतवाक्‌य 22:1</ref></char></note> <verse eid="EZK 47:1" /><verse number="2" style="v" sid="EZK 47:2" />ता तीहयो मने धुराव ना फाटे माय्‌न बारो ली ज्‌यो, अने बारो-बारो फीरावीन बाहरला मतलब उगवणा मोडा वाळा फाटान्‌तां पुगाड़ देदो, अने दखणाव भणीन गेथु पाणी थोड़ुक-थोड़ुक वयतु हतु। <verse eid="EZK 47:2" /><verse number="3" style="v" sid="EZK 47:3" />जत्‌यार तीहयो माणेह हात मे मापवा नी दोरी लीन उगवणी ह़ोड़ नीकळ्‌यो, ता तीहयो घोर ने तां गेथो लगाड़ीन, हजार हात तक तीहया झोर ने माप्‌यो, अने मने पाणी मे चलाड़्‌यो, अने पाणी मांडे तक हतु। <verse eid="EZK 47:3" /><verse number="4" style="v" sid="EZK 47:4" />तीहयो अळी हजार हात मापीन मने पाणी मे चलाड़्‌यो, अने पाणी घुटणे तक हतु, अळतेण अळी हजार हात मापीन मने पाणी मे चलाड़्‌यो, अने पाणी केड़े तक हतु। <verse eid="EZK 47:4" /><verse number="5" style="v" sid="EZK 47:5" />ता अळी तीहयो एक हजार हात माप्‌यो, अने एवी नंदी बण जी जीनी पार मे जाय नी सक्‌यो, काहाके पाणी जादा हय्‌न तीरवा नी लायक हय ज्‌यु; मतलब एवी नंदी हती जीनी पार कोय जाय नी सकतु हतु। <verse eid="EZK 47:5" /><verse number="6" style="v" sid="EZK 47:6" />ता तीहयो मने केदो, “ए माणेह नी अवल्‌यात, ह़ु तु आहयु देखलो से?” ता तीहयो मने नंदी ना कापे-कापे पासो लावीन पुगाड़ देदो। <verse eid="EZK 47:6" /><verse number="7" style="v" sid="EZK 47:7" />पासो आयो ता आवीन में देख्‌यो, के नंदी नी बेम काठे ढेरेत झाड़का से। <verse eid="EZK 47:7" /><verse number="8" style="v" sid="EZK 47:8" />ता तीहयो मने केदो, “आहयो झोर उगवणु देस भणीन वय र्‌यो, अने अराबा मे उतरीन तळाव बणीन वयहे; अने घोर मे गेथो नीकळलो ह़ुदो तळाव मे भेसकाय जहे; अने तीनु पाणी गळु हय जहे। <verse eid="EZK 47:8" /><verse number="9" style="v" sid="EZK 47:9" />जां-जां आहयी नंदी वये, तां-तां आखी भाती ना घणा ईंडा मेकवा वाळा जीव-जन्‌तु जीवहे अने माछला बी घणा हय जहे; काहाके आहया झोर नु पाणी तां पुगलु से, अने तळाव नु पाणी गळु हय जहे; अने जां कंय आहयी नंदी पुगहे तां आखा जानवर पीहे। <verse eid="EZK 47:9" /><verse number="10" style="v" sid="EZK 47:10" />तळाव ना काठे माछला मारन्‌या काहर्‌या उबा रेहे, अने एनगदी झोर गेथा लगाड़ीन एनेग्‌लेम झोर तक जाळ फेलावहे, अने तीमने मोट्‌ली दर्‌या मे वाळान तेवा भाती-भाती ना गीणाय नी एतरा माछला जड़हे। <verse eid="EZK 47:10" /><verse number="11" style="v" sid="EZK 47:11" />पण तळाव ने तां जे दलदल अने खाडा से, तीमनु पाणी गळु नी हये; तीहया खारलात रेहे। <verse eid="EZK 47:11" /><verse number="12" style="v" sid="EZK 47:12" />नंदी ना बेम काठे भाती-भाती ना खावा नी लायक फालण्‌या झाड़का उबजहे, जीमना पान्‌टा नी चीमाय अने तीमनु फालनु बी कारु बंद नी हये, काहाके नंदी नु पाणी चोखला जागा मे गेथु नीकळलु से। तीमनी मे मयना डीट नवला-नवला फोळ लागहे। तीमना फोळ खावा जुगु, अने पान्‌टा दवा ना काम मे आवहे।”<verse eid="EZK 47:12" /></para>
  <para style="s">देस नी काकड़</para>
  <para style="p">
    <verse number="13" style="v" sid="EZK 47:13" />भगवान यहोवा आसम केय, “जे काकड़ नी मोय तमने आहयु देस आह़फाम ना बारे घोराणा नी अनसारे वाटवा पड़हे, तीहया आहया से युसुफ ने बे वाटा जड़े। <verse eid="EZK 47:13" /><verse number="14" style="v" sid="EZK 47:14" />तीने तमु एक-बीजा ना बराबर खुद ना वाटा मे देखहु, काहाके में ह़ाम खादलो के तीने तमारा बाहु ने आपही, करीन आहयु देस तमारो खुद नो वाटो ठेरहे।<verse eid="EZK 47:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 47:15" />“देस नी काकड़ आहयी रेय: मतलब धुराव नी काकड़ मोट्‌ली दर्‌या गेथी लगाड़ीन हेतलोन ह़ेर ने तां माय्‌न सदाद नी घाटी तक पुगे, <verse eid="EZK 47:15" /><verse number="16" style="v" sid="EZK 47:16" />अने तीहयी काकड़ ने तां हमात बेरोता, अने सीब्‌रेम जे दमीस्‌क अने हमात नी काकड़ नी वच मे से, हसर्‌हत्‌तीकोन तक, जे होरान नी काकड़ पोर से। <verse eid="EZK 47:16" /><verse number="17" style="v" sid="EZK 47:17" />आहयी काकड़ दर्‌या गेथी लगाड़ीन दमीस्‌क नी काकड़ ने तां ना हसरेनोन तक पुगे, अने तीनी धुराव नी ह़ोड़ हमात रेय। धुराव नी काकड़ आहयीत रेय।<verse eid="EZK 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EZK 47:18" />“उगवणी काकड़ जीनी एक ह़ोड़ होरान दमीस्‌क; अने यरदन भणीन गीलाद अने ईस्‌रायल नु देस रेय; धुराव नी काकड़ गेथी लगाड़ीन उगवणा तळाव तक तीने मापजे। उगवणी काकड़ ते आहयीत रेय।<verse eid="EZK 47:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EZK 47:19" />“दखणाव नी काकड़ तामार गेथी लगाड़ीन कादेस ना मरीबा नाम ना झोर तक मतलब मीस्‌र ना कोतड़े तक, अने मोट्‌ली दर्‌या तक पुगे। दखणाव नी काकड़ आहयीत रेय।<verse eid="EZK 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 47:20" />“बुडवणी काकड़ दखणाव नी काकड़ गेथी लगाड़ीन हमात नी घाटी नी अगळ तक नी मोट्‌ली दर्‌या रेय। बुडवणी काकड़ आहयीत रेय।<verse eid="EZK 47:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 47:21" />“आहयी रीते देस ने ईस्‌रायल ना घोराणा नी अनसारे तमारी वच मे वाट लेजो। <verse eid="EZK 47:21" /><verse number="22" style="v" sid="EZK 47:22" />आने तमारी वच मे अने तीहया बीजा देस वाळा ह़ाते वाट लेजो, जे तमारी वच मे रेता जाय्‌न सोरा पयदा करला से। तीहया तमारी नींगा मे देस ना ईस्‌रायलीन तेवा ठेरे, अने तमारा घोराणा नी वच मे आह़फा-आह़फाम नो वाटो हात करे। <verse eid="EZK 47:22" /><verse number="23" style="v" sid="EZK 47:23" />जे बीजा देस वाळो जे घोराणा ना देस मे रेतो हय, तीने तांत वाटो आपजो, भगवान यहोवा आसमेत केय।”<verse eid="EZK 47:23" /></para>
  <chapter eid="EZK 47" />
  <chapter number="48" style="c" sid="EZK 48" />
  <para style="s">घोराणा मे जागो वाटणु</para>
  <para style="p">
    <verse number="1" style="v" sid="EZK 48:1" />घोराणा ना वाटा आहया रेय धुराव नी काकड़ ने चोटायतो हेतलोन नी वाट ने तां गेथो हमात नी घाटी तक, अने दमीस्‌क नी काकड़ ने तां ना हसरेनान गेथो धुराव नी ह़ोड़ हमात ने तां तक एक वाटो दान नो रेय; अने तीनी उगवणी अने बुडवणी काकड़ बी रेय। <verse eid="EZK 48:1" /><verse number="2" style="v" sid="EZK 48:2" />दान नी काकड़ ने चोटायतो उगवणो गेथो बुडवणो तक आसेर नो वाटो रेय। <verse eid="EZK 48:2" /><verse number="3" style="v" sid="EZK 48:3" />आसेर नी काकड़ ने चोटायतो, उगवणो गेथो बुडवणो तक नप्‌ताली नो वाटो रेय। <verse eid="EZK 48:3" /><verse number="4" style="v" sid="EZK 48:4" />नप्‌ताली नी काकड़ ने चोटायतो उगवणो गेथो बुडवणो तक मनस्‌से नो वाटो रेय। <verse eid="EZK 48:4" /><verse number="5" style="v" sid="EZK 48:5" />मनस्‌से नी काकड़ ने चोटायतो उगवणो गेथो बुडवणो तक एप्‌रेम नो एक वाटो रेय। <verse eid="EZK 48:5" /><verse number="6" style="v" sid="EZK 48:6" />एप्‌रेम नी काकड़ ने चोटायतो उगवणो गेथो बुडवणो तक रुबेन नो वाटो रेय। <verse eid="EZK 48:6" /><verse number="7" style="v" sid="EZK 48:7" />रुबेन नी काकड़ ने चोटायतो उगवणो गेथो बुडवणो तक यहुदा नो एक वाटो रेय।<verse eid="EZK 48:7" /></para>
  <para style="s">देस नी वच मे जागा नो खास वाटो</para>
  <para style="p">
    <verse number="8" style="v" sid="EZK 48:8" />यहुदा नी काकड़ ने चोटायतो उगवणो गेथो बुडवणो तक तीहयो ह़ोपलो वाटो रेय, जीने तमने ह़ोपवा पड़हे, तीहयो पच्‌चीह हजार टोकरा चवड़ो अने उगवणो गेथो बुडवणो तक काना एक घोराणा ना वाटा नी बराबर रेय, अने तीनी वच मे चोखलो जागो रेय।<verse eid="EZK 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EZK 48:9" />जे वाटो तमने यहोवा ने आपवा नो रेहे, तीनी लम्‌बाय पच्‌चीह हजार टोकरा अने चवड़ाय दह हजार टोकरा रेय। <verse eid="EZK 48:9" /><verse number="10" style="v" sid="EZK 48:10" />आहयो ह़ोपलो चोखलो वाटो पुंजारा ने जड़वा जोवे; तीहयो धुराव नी ह़ोड़ पच्‌चीह हजार टोकरा नाम्‌बो, बुडवणी ह़ोड़ दह हजार टोकरा चवड़ो, उगवणी नी ह़ोड़ दह हजार टोकरा चवड़ो, दखणाव नी ह़ोड़ पच्‌चीह हजार टोकरा नाम्‌बो रेय; अने तीनी वचा-वच यहोवा नो चोखलो जागो रेय। <verse eid="EZK 48:10" /><verse number="11" style="v" sid="EZK 48:11" />आहयो खास चोखलो जागो सादोक नी अवल्‌यात ना तीहया पुंजारा नो रेय जे मारा हुकम ने मान्‌ता र्‌या, अने ईस्‌रायलीम ने भटक जवा नी टेमे लेवीम ने तेम नी भटकला हता। <verse eid="EZK 48:11" /><verse number="12" style="v" sid="EZK 48:12" />करीन देस ना ह़ोपला वाटा मे गेथो आहयो तीमनी जुगु ह़ोपलो वाटो मतलब आखा गेथु चोखलु देस ठेरे; अने लेवीम नी काकड़ ने चोटायतु रेय। <verse eid="EZK 48:12" /><verse number="13" style="v" sid="EZK 48:13" />पुंजाराम नी काकड़ ने चोटायतो लेवीम नो वाटो रेय, तीहयो पच्‌चीह हजार टोकरा नाम्‌बो अने दह हजार टोकरा चवड़ो रेय। पुरी लम्‌बाय पच्‌चीह हजार टोकरा नी अने चवड़ाय दह हजार टोकरा नी रेय। <verse eid="EZK 48:13" /><verse number="14" style="v" sid="EZK 48:14" />तीहया तीनी मे गेथा नी ते कंय वेचे, नी बीजी जागा बदले; अने नी जागा नी पेल्‌ली मेर अळी बीजा ने आपे। काहाके तीहयो यहोवा जुगु चोखलो से।<verse eid="EZK 48:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EZK 48:15" />चवड़ाय ना पच्‌चीह हजार टोकरा नी अगळ जे पांच हजार बच रेहे, तीहयो ह़ेर अने घोरु अने चारवा ना जागा जुगु आखा बीजा वाटान तेवो रेय; अने ह़ेर तीनी वच मे रेय। <verse eid="EZK 48:15" /><verse number="16" style="v" sid="EZK 48:16" />ह़ेर नी आहयी माप रेय, मतलब धुराव, दखणाव, उगण, अने बुडवणी ह़ोड़ साड़ी च्‌यार-च्‌यार हजार हात रेय। <verse eid="EZK 48:16" /><verse number="17" style="v" sid="EZK 48:17" />ह़ेर नी ह़ाते धुराव, दखणाव, उगण अने बुडणली ह़ोड़ चारवा नी जागा रेय। जे ढाय-ढाय ह़ोव हात चवड़ी रेय। <verse eid="EZK 48:17" /><verse number="18" style="v" sid="EZK 48:18" />ह़ोपला चोखला वाटान्‌तां नी मे गेथो जे कंय बचे, मतलब उगवणी अने बुडवणी ह़ोड़ बेम ह़ोड़ दह-दह हजार टोकरा जे ह़ोपला वाटान्‌तां हय, तीनी मेर ह़ेर मे मेहनत करवा वाळा नी खावा जुगु रेय। <verse eid="EZK 48:18" /><verse number="19" style="v" sid="EZK 48:19" />ईस्‌रायल ना आखा घोराणा मे गेथा जे ह़ेर मे मेहनत करे, तीहया तीनी खेती कर्‌या करे।<verse eid="EZK 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EZK 48:20" />आखो ह़ोपलो वाटो पच्‌चीह हजार टोकरा नाम्‌बो अने पच्‌चीह हजार टोकरा चवड़ो रेय; तमने च्‌यार खुट्‌यो चोखलो वाटो ह़ोपवा नु रेहे जीनी मे ह़ेर नी खास जागा रेय।<verse eid="EZK 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EZK 48:21" />जे वाटो री जाय, तीहयो मुख्‌या ने जड़े। चोखला ह़ोपला वाटा ना, अने ह़ेर नी खास जागा नी बेम ह़ोड़ मतलब तीमनी उगवणी ह़ोड़ अने बुडवणी ह़ोड़ नी पच्‌चीह-पच्‌चीह हजार टोकरा नी चवड़ाय ने तां, जे घोराणा ना वाटान्‌तां रेय, तीहयो मुख्‌या ने जड़े। ह़ोपलो चोखलो वाटो अने घोर नो चोखलो जागो तीमनी वच मे रेय। <verse eid="EZK 48:21" /><verse number="22" style="v" sid="EZK 48:22" />जे मुख्‌या नो वाटो रेय, तीहयो लेवीम नी वच मे अने ह़ेरु नी खास जागा रेय। मुख्‌या नो वाटो यहुदा अने बीन्‌यामीन नी काकड़ नी वच मे रेय।<verse eid="EZK 48:22" /></para>
  <para style="s">बीजा घोराणा नो वाटो</para>
  <para style="p">
    <verse number="23" style="v" sid="EZK 48:23" />बीजा घोराणा नो वाटो आहयी भाते रेय उगवणो गेथो बुडवणो तक बीन्‌यामीन नो एक वाटो रेय। <verse eid="EZK 48:23" /><verse number="24" style="v" sid="EZK 48:24" />बीन्‌यामीन नी काकड़ ने चोटायतो उगवणो गेथो बुडवणो तक सीमोन नो एक वाटो रेय। <verse eid="EZK 48:24" /><verse number="25" style="v" sid="EZK 48:25" />सीमोन नी काकड़ ने चोटायतो उगवणो गेथो बुडवणो तक ईस्‌साकार नो एक वाटो रेय। <verse eid="EZK 48:25" /><verse number="26" style="v" sid="EZK 48:26" />ईस्‌साकार नी काकड़ ने चोटायतो उगवणो गेथो बुडवणो तक जबुलुन नो एक वाटो रेय। <verse eid="EZK 48:26" /><verse number="27" style="v" sid="EZK 48:27" />जबुलुन नी काकड़ ने चोटायतो उगवणो गेथो बुडवणो तक गाद नो एक वाटो रेय।<verse eid="EZK 48:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="EZK 48:28" />गाद नी काकड़ ने तां दखणाव नी ह़ोड़ नी काकड़ तामार गेथो लगाड़ीन कादेस तक मरीबा नाम झोर तक, अने मीसर ना कोतड़े अने मोट्‌ली दर्‌या तक पुगे।<verse eid="EZK 48:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EZK 48:29" />जे देस तमने ईस्‌रायल ना घोराणा ने वाटवा नु रेहे “तीहयु आहयुत से, अने तीमना वाटा बी आहयात से, भगवान यहोवा आसमेत केय।”<verse eid="EZK 48:29" /></para>
  <para style="s">ह़ेर ना झापला</para>
  <para style="p">
    <verse number="30" style="v" sid="EZK 48:30" />ह़ेर नी नीकळवा नी वाट आहयी रेय, मतलब धुराव नी ह़ोड़ जीनी लम्‌बाय साड़ी च्‌यार हजार टोकरा नी रेय। <verse eid="EZK 48:30" /><verse number="31" style="v" sid="EZK 48:31" />तीनी मे तीन फाटा रेय; मतलब एक रुबेन नो फाटो, एक यहुदा नो फाटो, अने एक लेवी नो फाटो रेय; काहाके ह़ेर ना फाटा नु नाम ईस्‌रायल ना घोराणा ना नाम पोर राखवा पड़हे। <verse eid="EZK 48:31" /><verse number="32" style="v" sid="EZK 48:32" />उगवणी ह़ोड़ नी काकड़ साड़ी च्‌यार हजार टोकरा नाम्‌बी रेय; ने तीनी मे तीन फाटा रेय; मतलब एक युसुफ नो फाटो, एक बीन्‌यामीन नो फाटो, अने एक दान नो फाटो रेय। <verse eid="EZK 48:32" /><verse number="33" style="v" sid="EZK 48:33" />दखणाव नी ह़ोड़ काकड़ साड़ी च्‌यार हजार टोकरा नाम्‌बी रेय, अने तीनी मे तीन फाटा रेय; मतलब एक सीमोन नो फाटो, एक ईस्‌साकार नो फाटो, अने एक जबुलुन नो फाटो रेय; <verse eid="EZK 48:33" /><verse number="34" style="v" sid="EZK 48:34" />बुडवणी ह़ोड़ नी काकड़ साड़ी च्‌यार हजार टोकरा नाम्‌बी रेय, अने तीनी मे तीन फाटा रेय; मतलब एक गाद नो रेय, एक आसेर नो फाटो अने एक नप्‌ताली नो फाटो रे।<note caller="+" style="x"><char style="xo" closed="false">48:34 </char><char style="xt" closed="false"><ref loc="REV 21:12">परकासीतवाक्‌य 21:12</ref>,<ref loc="REV 21:13">13</ref></char></note> <verse eid="EZK 48:34" /><verse number="35" style="v" sid="EZK 48:35" />ह़ेर नी च्‌यारो-मेर नी घेराव अट्‌ठारे हजार टोकरा नी रेय, अने तीहयात दाड़े गेथु अगु ह़ेर नु नाम “यहोवा साम्‌मा<note caller="+" style="f"><char style="fr" closed="false">48:35 </char><char style="fq" closed="false">यहोवा साम्‌मा </char><char style="ft" closed="false">मतलब, मालीक आञे से</char></note> रेहे।”<verse eid="EZK 48:35" /></para>
  <chapter eid="EZK 48" />
</usx>