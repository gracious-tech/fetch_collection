<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PHM" style="id">- Paliya</book>
  <para style="h">फीलेमोन</para>
  <para style="toc3">फीलेमोन</para>
  <para style="toc2">फीलेमोन</para>
  <para style="toc1">फीलेमोन ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="mt2">फीलेमोन के नाम पोलुस की पत्री</para>
  <para style="mt1">फीलेमोन ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">फीलेमोन नी आहयी नान्‌ली कीताप नेवताळा पोलुस ना लारे लीखली हती। <char style="xt"><ref loc="PHM 1:1">1:1</ref></char> जत्‌यार पोलुस लीख्‌यो हतो, तत्‌यार पोलुस जेल मे हतो आनु मतलब से के तीहयो हय सके रोम सी आने लीख र्‌यो हतो। कदीम तीहयो रोम मे हतो ता आहयी चीट्‌ठी मसी ना पयदा हयवा ना 61 साल ना अळतेण लीख्‌यो हहे, जे आहयी टेम से जत्‌यार तीहयो कोलोसीयन ने बी लीखतो हतो।</para>
  <para style="ip">तीहयो आहयी चीट्‌ठी ने फीलेमोन नाम ना एक माणेह ने लीख्‌यो हतो। फीलेमोन मंडळी नो अगवो अने चाकर्‌या नो मालीक बी हतो। पोलुस तीने पुछ्‌यो के तीहयो आपणा चाकर्‌या ओनेसीमुस ने डंड नी आपे जे फीलेमोन तां गेथो नाह जेलो हतो। रोम ना कायदा ना लारे फीलेमोन ने ओनेसीमुस ने मारवा नी लेदे राखवा नो हक हतो। पोलुस फीलेमोन ने एक ईसु पोर भरहो करन्‌यो भाय ना वेह मे ओनेसीमुस ने आवरवा नी लेदे अने अगवाय करवा नी लेदे हीम्‌मत आपण्‌या तरीका वापर करत्‌लो अने आहयु बी ह़मजाड़त्‌लो के ओनेसीमुस ने <char style="xt"><ref loc="PHM 1:13-14">1:13-14</ref></char> पोलुस ना ह़ाते चाकरी करवा नो हुकम बी आपहे।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. मे पोलुस फीलेमोन ने घणो वारु केम। <char style="ior"><ref loc="PHM 1:1-3">1:1-3</ref></char></para>
  <para style="io1">2. ता पोलुस ओनेसीमुस नी वगे सी पुसे के फीलेमोन तीने एक ईसु पोर भरहो करन्‌या भाय ना वेह मे आवरहे। <char style="ior"><ref loc="PHM 1:4-21">1:4-21</ref></char></para>
  <para style="io1">3. पोलुस यात्‌रा करवा अने बधाय मोकलवा अने आपणा वीच्‌यार ने लागु करीन खत्‌तम हयत्‌लु से। <char style="ior"><ref loc="PHM 1:22-25">1:22-25</ref></char></para>
  <chapter number="1" style="c" sid="PHM 1" />
  <para style="p">
    <verse number="1" style="v" sid="PHM 1:1" />पोलुस भणी गेथो जे ईसु मसी नो केदी से, अने भाय तीमुथीयुस भणी गेथा अमारा मोंगाळ्‌ळा साजल्‌या फीलेमोन, <verse eid="PHM 1:1" /><verse number="2" style="v" sid="PHM 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="COL 4:17">कुलुस्‌यो 4:17</ref></char></note>अने बेनेह अफफीया, अने अमारा ह़ाती झुमायवा वाळो अरखीपुस अने फीलेमोन ना घोर मे भेळी हयवा वाळी मंडळी ने।<verse eid="PHM 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="PHM 1:3" />आपणा बाह भगवान अने मालीक ईसु मसी भणी गेथी दया अने सांती तमने जड़ती रेय।<verse eid="PHM 1:3" /></para>
  <para style="s">फीलेमोन नो मोंग अने भरहो</para>
  <para style="p">
    <verse number="4" style="v" sid="PHM 1:4" />भाय फीलेमोन मे हमेसा भगवान ने घणो वारु केम, अने आपणी वीन्‌ती मे बी तने फोम करु। <verse eid="PHM 1:4" /><verse number="5" style="v" sid="PHM 1:5" />काहाके मे तारा मोंग नी अने भरहा ना बारा मे वात ह़मळु, जे आखा चोखला माणहु नी ह़ाते अने मालीक ईसु पोर से। <verse eid="PHM 1:5" /><verse number="6" style="v" sid="PHM 1:6" />मे वीन्‌ती करु के तु आपणा भरहा ने देखाड़वा टणको बणीन रे, जीनी सी ईसु मसी नी एकता नी लारे आखी वात नो ग्‌यान हये। <verse eid="PHM 1:6" /><verse number="7" style="v" sid="PHM 1:7" />काहाके ए भाय, मने तारा मोंग सी घणी खुसी अने सांती जड़ली से, आनीन करते के तारी लारे भगवान ना चोखला माणहु नु मन खुस हय ज्‌यु।<verse eid="PHM 1:7" /></para>
  <para style="s">उनेसीमुस नी लेदे वीन्‌ती</para>
  <para style="p">
    <verse number="8" style="v" sid="PHM 1:8" />एतरे मसी मे मने मोटी हीमम्‌त से के जे वात वारु से, तीनी वात नो हुकम तने आपु। <verse eid="PHM 1:8" /><verse number="9" style="v" sid="PHM 1:9" />ते बी तीहया मोंग नी करते मने डायला पोलुस नी लेदे हाव ईसु मसी नी लेदे केदी से, आहयु वारु मालम पड़्‌यु के तारी सी वीन्‌ती करु। <verse eid="PHM 1:9" /><verse number="10" style="v" sid="PHM 1:10" /><note caller="+" style="x"><char style="xo" closed="false">1:10 </char><char style="xt" closed="false"><ref loc="COL 4:9">कुलुस्‌यो 4:9</ref></char></note>मारी वीन्‌ती से मारा उनेसीमुस जुगु से, जे तारो पावोर से। तीहयो ते जेल मे मारीन्‌तां आवलो, ता तीने मे ईसु ना बारा मे केदलो, अने तीहयो ईसु पोर भरहो करीन नवली जीवाय हात कर्‌यो। एतरे मारी जुगु सोरा बण्‌यो। <verse eid="PHM 1:10" /><verse number="11" style="v" sid="PHM 1:11" />पेले उनेसीमुस तारी जुगु कंय काम नो नी हतो, पण हाव तारी जुगु अने मारी जुगु, बेम नी जुगु घणो काम नो हय जेलो से।<verse eid="PHM 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="PHM 1:12" />उनेसीमुस ने मतलब जे मारा काळजा नो टुकड़ो से, मे तारीन्‌तां पासो मोकलवा बाज र्‌यो। <verse eid="PHM 1:12" /><verse number="13" style="v" sid="PHM 1:13" />तीने मे मारीन्‌तांत राखवा हींड र्‌यो हतो, के तारी तरप सी आहया जेल मे जे खुस-खबर ना कारण से, मारी सेवा करे। <verse eid="PHM 1:13" /><verse number="14" style="v" sid="PHM 1:14" />पण मे तारी मरजी वगर कंय बी नी करवा हींड्‌यो के तारी आहयी दया दबाव सी नी पण तारी मरजी सी हये।<verse eid="PHM 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="PHM 1:15" />काय जाणु तीहयो तारी सी थोड़ाक दाड़ा सेटो र्‌यो, के सदा तारी ह़ाते रेय। <verse eid="PHM 1:15" /><verse number="16" style="v" sid="PHM 1:16" />पण हाव गेथो चाकर्‌यान तेवो नी, पण चाकर्‌या सी बी वारु मतलब मोंगाळ्‌ळा भाय ने तेम। जे मारो ते मोंगाळ्‌ळो से, पण हाव माणेह हयवा नी नाते अळी मसी भाय हयवा ना नाते तमु मारी सी जादा मोंग करो<verse eid="PHM 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="PHM 1:17" />कदीम तु मने तारो साजल्‌यो ह़मजे, ता तीने आसम अवरी ले जेम मने अवरी लेदो। <verse eid="PHM 1:17" /><verse number="18" style="v" sid="PHM 1:18" />अने कदीम तीहयो तारु कंय बी गलत करलो हय, नीता तारो करजा वाळो हय, ता मारा नाम पोर लीख ले। <verse eid="PHM 1:18" /><verse number="19" style="v" sid="PHM 1:19" />मे पोलुस आपणा हात सी लीखु के मे आह़फो भर देही, अने आने केवा नी कंय जरवत नी हय के मारो करजो जे तारी पोर से तीहयो तुत से। <verse eid="PHM 1:19" /><verse number="20" style="v" sid="PHM 1:20" />ए भाय, ईसु मसी मे आहयी खुसी मने तारी भणी गेथी जड़े। के मारा जीव ने खुसी सी भर दे।<verse eid="PHM 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="PHM 1:21" />मे तारी पोर हुकम मानवा वाळो से करीन भरहो करीन, तारी जुगु आहयु लीखु अने आहयु जाणु के जे कंय तने केम, तु मारी गेथो जादा बी करही। <verse eid="PHM 1:21" /><verse number="22" style="v" sid="PHM 1:22" />अने आहयु बी के मारी लेदे रेवा नो जागो तीयार राख; मने आह से के तमारी वीन्‌ती नी लारे मे छुटीन तमारीन्‌तां आवही।<verse eid="PHM 1:22" /></para>
  <para style="s">फीलेमोन ने वारलो छे के? पुछे</para>
  <para style="p">
    <verse number="23" style="v" sid="PHM 1:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:23 </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">कुलुस्‌यो 1:7</ref>; <ref loc="COL 4:12">4:12</ref></char>
    </note>ईपफ्‌रास जे मसी ईसु मे मारी ह़ाते जेल मे से। <verse eid="PHM 1:23" /><verse number="24" style="v" sid="PHM 1:24" /><note caller="+" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="ACT 12:12">नेवताळा ना काम 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">कुलुस्‌यो 4:10</ref>; </char><char style="xt" closed="false"><ref loc="ACT 19:29">नेवताळा ना काम 19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="COL 4:10">कुलुस्‌यो 4:10</ref>; </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्‌यो 4:14</ref>; <ref loc="2TI 4:10">2 तीमुथीयुस 4:10</ref>; </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्‌यो 4:14</ref>; <ref loc="2TI 4:11">2 तीमुथीयुस 4:11</ref></char></note>अने मरकुस अने अरीस्‌तरखुस, अने देमास अने लुको, जे मारा साजल्‌या से, तने आवजो अने आवही की र्‌या।<verse eid="PHM 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="PHM 1:25" />मालीक ईसु मसी नी दया तमारी आत्‌मा ह़ाते रेय, आमीन।<verse eid="PHM 1:25" /></para>
  <chapter eid="PHM 1" />
</usx>