<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GAL" style="id">- Paliya Project</book>
  <para style="h">गलातीयो</para>
  <para style="toc3">गलातीयो</para>
  <para style="toc2">गलातीयो</para>
  <para style="toc1">गलातीया ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="mt2">गलातीयों के नाम पोलुस की पत्री</para>
  <para style="mt1">गलातीया ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">गलातीयो नी कीताप ने नेवताळो पोलुस लीख्‌यो। <char style="xt"><ref loc="GAL 1:1">1:1</ref></char> आहयी एक चीट्‌ठी से जीने पोलुस ईसु मसीन पयदा हयवा नी अळतेण 48-57 साल ना वचे गलातीया नी मंडळी ने लीखलो हतो। गलातीया, रोम देस ना गलातीया ह़ेर मे रेण्‌या माणहु हता। जानकारु ने मालम नी हतु के जत्‌यार चीट्‌ठी लीख्‌यो ता पोलुस कां हतो, बाखीन आसम माने के तीहयो ईफीसुस अने कुरन्‌थी ह़ेर मे रीन आहयी चीट्‌ठी लीख्‌यो हहे।</para>
  <para style="ip">तीहया युहदी अने आड़जात्‌या मसी माणहु ना नाम जे गलातीया नी मंडळी ने पोलुस आहयी चीट्‌ठी लीख्‌यो। झुटी ह़ीकापण मसी माणहु ने युहदी कायदा ने खास करीन चोखु करवा नी रीती ने पाळवा जोवे आहयु केवा वाळी झुटी ह़ीकापण नु ह़ामनु करवा करीन पोलुस आहयी चीट्‌ठी लीख्‌यो। मसी मे एक जुड़ायस नाम नो टोळो हतो, तीमनु मान्‌नु हतु के आड़जात्‌या मसी माणहु ने चोखु करवा जरुड़ी से तीहया पोलुस नी सेवा ना हक पोर बी सक कर्‌या, पोलुस तीनी थोड़ीक जीवाय ना बारा मे देखाड़ीन नेवताळो हयवा नु ने अगळ कर्‌यो, <char style="xt"><ref loc="GAL 1:11-2:14">1:11–2:14</ref></char> अने छुटकारो नीस्‌तो ईसु मसी पोर भरहो करवा सी हात कर सकत्‌ला। <char style="xt"><ref loc="GAL 2:16">2:16</ref></char> तीहयो खुस-खबर ने उजन्‌ती कर्‌यो के छुटकारो भगवान नी दया नो फोळ से माणहु ना काम सी नी हय।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. गलातीया नी मंडळी ने वारला से के कीन पोलुस आहयी चीट्‌ठी ने लीखवा सुरु करे। <char style="ior"><ref loc="GAL 1:1-5">1:1-5</ref> </char></para>
  <para style="io1">2. पोलुस आह़फा नी जीवाय ना बारा मे आनी लेदे देखाड़्‌यो के तीहयो कायदा सास्‌तर ना अनसारे रेवा नी कोसीत कर्‌यो पण कंय फायदो नी हयो। <char style="ior"><ref loc="GAL 1:6-2:21">1:6–2:21</ref></char></para>
  <para style="io1">3. तीनी अळतेण मे कायदा अने दया आपणु ने छुटकारो आपवा मे ह़ु करे तीहयु आहयु उजन्‌तु करे। <char style="ior"><ref loc="GAL 3-4">3–4</ref></char></para>
  <para style="io1">4. भलो मसी जीवाय जीव्‌वा नी लेदे तीहयो कंय नानी खबर आपे। <char style="ior"><ref loc="GAL 5:1-6:10">5:1–6:10</ref></char></para>
  <para style="io1">5. पोलुस आखरी वीन्‌ती करे के भगवान नी लारे नवलु माणेह बणवा आहयी चोखु हयवान तेवी बारी रीती-रीवाज सी घणी काम नी से, आने फोम राखो अने वारु से के कीन चीट्‌ठी ने बंद करे। <char style="ior"><ref loc="GAL 6:11-18">6:11-18</ref></char></para>
  <chapter number="1" style="c" sid="GAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="GAL 1:1" />पोलुस भणी गेथी, जे मने नेवताळो बणवा करीन टाळलो से। जे नी माणहु भणी गेथु अने नी माणेह ना लारे, बाखीन ईसु मसी अने भगवान बाह ना लारे, जे तीने मरला मे गेथो जीवाड़लो से। <verse eid="GAL 1:1" /><verse number="2" style="v" sid="GAL 1:2" />अने आखा भाय-बेन्‌या भणी गेथी, जे मारी ह़ाते से; गलातीया ना मंडळ्‌या ने वारला से के कीया।<verse eid="GAL 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GAL 1:3" />अमारा भगवान बाह अने मालीक ईसु मसी नी भणी गेथी तमने दया अने सांती जड़ती रेय।<verse eid="GAL 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GAL 1:4" />तीहयोत आह़फा ने अमारा पाप नी लेदे आप देदो, काहाके अमारा भगवान अने बाह नी मरजी ना अनसारे आपणु ने हमणे नी बुरी कळी सी छोड़ावे। <verse eid="GAL 1:4" /><verse number="5" style="v" sid="GAL 1:5" />तीनीत बड़ाय जलमकी हयती रेय। आमीन।<verse eid="GAL 1:5" /></para>
  <para style="s">एकीत खुस-खबर</para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 1:6" />मने घणु जुदु लागे, के जे तमने मसी नी दया सी बोलायो तीनी सी तमु एतरा सोटा भटकीन बीजी भाती नी खुस-खबर भणी वळवा बाज ज्‌या। <verse eid="GAL 1:6" /><verse number="7" style="v" sid="GAL 1:7" />बाखीन तीहयी बीजी खुस-खबर हय नी, पण वात आहयी से, के केतरा आसवा से, जे तमने घबराड़ देय, अने मसी ना खुस-खबर ने बदलवा हींड र्‌या। <verse eid="GAL 1:7" /><verse number="8" style="v" sid="GAL 1:8" />बाखीन कदीम आमु नीता ह़रग सी कानो दुत बी तीहयी खुस-खबर ने सोड़ीन जे आमु तमने ह़मळावला से, कोय अळी खुस-खबर ह़मळावे, ता सरापीत हये। <verse eid="GAL 1:8" /><verse number="9" style="v" sid="GAL 1:9" />जेम आमु पेला की देदला से, हेमेत मे हमणे अळी केम, तीहयी खुस-खबर ने सोड़ीन जीने तमु ली लेदला से, कदीम कोय बीजी खुस-खबर ह़मळावतो हय ता सरापीत हये।<verse eid="GAL 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 1:10" />हाव मे ह़ु माणहु ने मानु के भगवान ने? ह़ु मे माणहु ने खुस करवा हींड र्‌यो? कदीम मे हमणे तक माणहु नेत खुस करतो रेतो, ता मसी नो पावर्‌यो नी रेतो।<verse eid="GAL 1:10" /></para>
  <para style="s">भगवान लारे पोलुस नो बोलावो</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 1:11" />ए भायु, मे तमने देखाड़ देम, के जे खुस-खबर मेत ह़मळावलो से, तीहयी माणेह नी बणावली नी हय। <verse eid="GAL 1:11" /><verse number="12" style="v" sid="GAL 1:12" />काहाके तीहयो मने माणेह नी भणी गेथो नी पुग्‌यो, अने नी मने ह़ीकाड़्‌या, पण ईसु मसी मारी पोर उजन्‌तु कर्‌यो।<verse eid="GAL 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 1:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:13 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:3">नेवताळा ना काम 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>,<ref loc="ACT 22:5">5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char>
    </note>युहदी-धरम मे जे पेले मारो चाल-चलण हतो, तमु ह़मळी लेदला से; के मे भगवान नी मंडळी ने घणोत वेला पाड़त्‌लो अने खत्‌तम करतो हतो। <verse eid="GAL 1:13" /><verse number="14" style="v" sid="GAL 1:14" /><note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="ACT 22:3">नेवताळा ना काम 22:3</ref></char></note>अने मे युहदी-धरम मे आपणा ह़ाती युहद्‌या सी वदु अगो वदतो हतो अने आपणा आड़ा-बुड़ा नी रीती-रीवाज मे घणोत होह हतो।<verse eid="GAL 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 1:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:15 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 9:3-6">नेवताळा ना काम 9:3-6</ref>; <ref loc="ACT 22:6-10">22:6-10</ref>; <ref loc="ACT 26:13-18">26:13-18</ref></char>
    </note>बाखीन भगवान नी जत्‌यार मरजी हयी, तीहयो मारी आह्‌य ना पेट मेत गेथो मने ठेरावलो से अने आपणी दया सी बोलाय लेदो। <verse eid="GAL 1:15" /><verse number="16" style="v" sid="GAL 1:16" />जत्‌यार तीहयो वीच्‌यार कर्‌यो के मारी मे आपणा सोरा ने उजन्‌तो करे के मे आड़जात्‌या मे तीनी खुस-खबर ह़मळावु, ता मे काना माणहु सी ह़ला नी लेदो। <verse eid="GAL 1:16" /><verse number="17" style="v" sid="GAL 1:17" />अने नी यरुसलेम मे तीमनीन्‌तां मळवा ज्‌यो, जे मारी सी पेले नेवताळा हता, पण तत्‌यारुत अरब मे जत र्‌यो अने अळी तां गेथो दमीस्‌क मे आवती र्‌यो। <verse eid="GAL 1:17" /><verse number="18" style="v" sid="GAL 1:18" /><note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="ACT 9:26-30">नेवताळा ना काम 9:26-30</ref></char></note>अळी तीन साल अळतेण मे पतरस सी भेटवा करीन यरुसलेम मे ज्‌यो, अने तीनी ह़ाते पन्‌दरे दाड़ा लग र्‌यो। <verse eid="GAL 1:18" /><verse number="19" style="v" sid="GAL 1:19" />पण मालीक ना भाय याकुब ने सोड़ीन अने बीजा चेला मे कोयने नी भेट्‌यो।<verse eid="GAL 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GAL 1:20" />जे वातु मे तमने लीखु, भगवान नी हजरी जाणीन केम के तीहयी झुटी नी हय।<verse eid="GAL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 1:21" />तीनी अळतेण मे सीरीया अने कीलीकीया ना देस मे आयो। <verse eid="GAL 1:21" /><verse number="22" style="v" sid="GAL 1:22" />पण युहद्‌या नी मंडळ्‌या ने जे मसी मे हती, तीने कदी नी भेट्‌यो अने मारु मोडु कदी नी देखला हता। <verse eid="GAL 1:22" /><verse number="23" style="v" sid="GAL 1:23" />पण मार बारा मे आहयुत जाणता हता अने ह़मळ्‌या जे पेले आमने वेला पाड़तो हतो, तीहयो हाव तीनात भरहा नी खुस-खबर ह़मळावे, जीने पेले खत्‌तम करतो हतो। <verse eid="GAL 1:23" /><verse number="24" style="v" sid="GAL 1:24" />अने तीहयी मंडळी मारा बारा मे भगवान नी बड़ाय कर्‌या करती हती।<verse eid="GAL 1:24" /></para>
  <chapter eid="GAL 1" />
  <chapter number="2" style="c" sid="GAL 2" />
  <para style="s">बीजा</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 11:30">नेवताळा ना काम 11:30</ref>; <ref loc="ACT 15:2">15:2</ref></char>
    </note>चोवदे साल बाद मे बरनाबास नी ह़ाते यरुसलेम मे ज्‌यो अने तीतुस ने बी ह़ाते लीन ज्‌यो। <verse eid="GAL 2:1" /><verse number="2" style="v" sid="GAL 2:2" />अने मारु जवा नु भगवान ना वीजाळु ना लारे हयु अने जे खुस-खबर मे आड़जात्‌या मे परच्‌यार करु, तीने मेत तीमने देखाड़ देदो, पण एखला मे तीमने जे मोटा ह़मजता हता, काहाके आसम नी हये, के मारी आहयी टेम नी, नीता पासलो दवड़ो अमथो ठेरे। <verse eid="GAL 2:2" /><verse number="3" style="v" sid="GAL 2:3" />बाखीन तीतुस ने बी जे मारो ह़ाती भाय बी हतो अने आड़जात्‌यो से; खतनु करवा करीन मजबुर नी कर्‌या। <verse eid="GAL 2:3" /><verse number="4" style="v" sid="GAL 2:4" />अने आहयु तीहया झुटा भायु ना कारण सी हयु, जे चोराये अमारी वच मे भराय्‌न आय लागला हता, के तीहयी छुट ना जे ईसु मसी मे आमने जड़ली से, जाणीन आमने पावर्‌यो बणावे। <verse eid="GAL 2:4" /><verse number="5" style="v" sid="GAL 2:5" />तीना हक मे रेवा आमु जरीक वार बी नी मान्‌या, आनीन करते के खुस-खबर नी सच्‌चाय तमारी मे बणली रेय। <verse eid="GAL 2:5" /><verse number="6" style="v" sid="GAL 2:6" />अळी जे माणहु खास लागत्‌ला तीहया जे कोय बी हता, मने तीनी सी कंय फरक नी पड़े, भगवान कोय नु मोडु देखीन नीयाव नी करे तीमनी सी मने कंय बी फायदो नी हयो। <verse eid="GAL 2:6" /><verse number="7" style="v" sid="GAL 2:7" />पण तीना उलटु तीहया देख्‌या, के जीसम खतनु करला माणहु ना लेदे खुस-खबर नु काम पतरस ने ह़ोप मेक्‌यु, तेमेत खतनु नी करला माणहु ना लेदे खुस-खबर ह़मळाव्‌वा मने ह़ोप मेक्‌यु। <verse eid="GAL 2:7" /><verse number="8" style="v" sid="GAL 2:8" />काहाके जे भगवान पतरस ने खतनु करला माणहु मे नेवताळो बणाय्‌न सेवा नु काम करायो, तीहयोत मने बी आड़जात्‌या माणहु मे काम करायो। <verse eid="GAL 2:8" /><verse number="9" style="v" sid="GAL 2:9" />अने जत्‌यार तीहया ते दया ने जे मने जड़ली हती जाण लेदा, ता याकुब अने केफा, अने युहन्‌नो ने मंडळी ना डायला अगवा ह़मजता हता, मने अने बरनाबास ने ह़ंगात नो जमणो हात आपीन ह़ाती कर लेदा, के आमु आड़जात्‌यान तां जीया, अने तीहया खतना करलाम नी तां। <verse eid="GAL 2:9" /><verse number="10" style="v" sid="GAL 2:10" />नीस्‌तु आहयु केदु, के आमु गरीब नी खबर लेवो, अने आहयुत काम ने करवा नु मे आह़फोत बी कोसीस करतो हतो।<verse eid="GAL 2:10" /></para>
  <para style="s">पोलुस नी लारे पतरस नो वीरोद</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 2:11" />पण जत्‌यार पतरस अंताकीया मे आयो ता मे आखा माणहु नी अगळ तीनु वीरोद कर्‌यो, काहाके तीहयो पुरी रीती सी गलत हतो। <verse eid="GAL 2:11" /><verse number="12" style="v" sid="GAL 2:12" />आनीन करते के याकुब भणी गेथा थोड़ाक माणहु आञे आव्‌वा सी पेले, पतरस आड़जात्‌या भरहो करन्‌या ना ह़ाते खाया-पीया करतो हतो। पण जत्‌यार तीहया माणहु पुग्‌या, ता पतरस खतनु करला माणहु नी बीक ना लेदे तीमनी सी सेटो हय ज्‌यो अने एक धेड़े हयवा बाज ज्‌यो। <verse eid="GAL 2:12" /><verse number="13" style="v" sid="GAL 2:13" />अने तीनी ह़ाते बचला युहदी माणहु आहया ढोंग मे बी पतरस नो सात देदा अने कपट कर्‌या, आनी लेदे बरनाबास बी तीमना ढोंग मे पड़ ज्‌यो। <verse eid="GAL 2:13" /><verse number="14" style="v" sid="GAL 2:14" />पण जत्‌यार मे देख्‌यो, के तीहया खुस-खबर नी सच्‌चाय पोर ह़ुदी चाल नी चालता, ता मे आखा नी अगळ पतरस सी केदो, तु युहदी हय्‌न बी आड़जात्‌यान तेम चाले अने युहदीन तेम नी चाले ता तु आड़जात्‌या ने युहदीन तेम चाल चालवा काहा केतलो।<verse eid="GAL 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 2:15" />आमु जे पयदा सी युहदी से, अने पापी आड़जात्‌या मे गेथा नी हय। <verse eid="GAL 2:15" /><verse number="16" style="v" sid="GAL 2:16" /><note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ROM 3:20">रोमीयो 3:20</ref>; </char><char style="xt" closed="false"><ref loc="ROM 3:22">रोमीयो 3:22</ref></char></note>ते बी आहयु जाणीन के माणेह कायदा ना कामु सी नी, पण ईसु मसी पोर भरहो करवा ना लारे धरमी ठेरे, आमु ईसु मसी पोर भरहो कर्‌या, के आमु कायदा ना कामु सी नी पण मसी पोर भरहो करवा सी धरमी ठेर्‌या; आनीन करते के कायदा ना काम सी कोय माणेह धरमी नी ठेरे <verse eid="GAL 2:16" /><verse number="17" style="v" sid="GAL 2:17" />आमु जे मसी मे धरमी ठेरवा चाह र्‌या, कदी आड़जात्‌या नी तेम पापी नकळ्‌या, ता ह़ु मसी पाप नो पावर्‌यो से? कदी नी! <verse eid="GAL 2:17" /><verse number="18" style="v" sid="GAL 2:18" />काहाके जे कंय मे पाड़ देदो, कदी तीनेत फीर सी बणावु, ता मे आह़फा ने गुनाळ्‌ळो ठेरावु। <verse eid="GAL 2:18" /><verse number="19" style="v" sid="GAL 2:19" />मे ते कायदा ना लारे कायदा ना लेदे मर ज्‌यो, के भगवान ना लेदे जीवु। <verse eid="GAL 2:19" /><verse number="20" style="v" sid="GAL 2:20" />मे मसी ना ह़ाते कुरुस पोर चड़ावलो से, अने हाव मे जीवत्‌लो नी र्‌यो, पण मसी मारी मे जीवत्‌लो से। अने मे डील मे हाव जे जीवत्‌लो से ता नीस्‌तो तीहयात भरहा सी जीवत्‌लो से, जे भगवान ना सोरा पोर से, जे मारी सी मोंग कर्‌यो, अने मारी लेदे आह़फा ने आप देदो। <verse eid="GAL 2:20" /><verse number="21" style="v" sid="GAL 2:21" />मे भगवान नी दया ने नी नीकारतो। काहाके कदीम कायदा नी लारे माणेह ने धरमी ठेरावे, ता मसी नु मरवु फाल्‌तु से।<verse eid="GAL 2:21" /></para>
  <chapter eid="GAL 2" />
  <chapter number="3" style="c" sid="GAL 3" />
  <para style="s">भरहो नीता कायदा नो पाळण करवा</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 3:1" />ए वण-अकल्‌या गलातीया, कोय तमने मनवी लेदु? तमारा ते मानो डोळा ना अगळ ईसु मसी कुरुस पोर देखाड़लो से! <verse eid="GAL 3:1" /><verse number="2" style="v" sid="GAL 3:2" />मे तमारी सी नीस्‌तु आहयु जाणवा चाहु, के तमु चोखली आत्‌मा ने, कायदा पाळवा सी, नीता खुस-खबर ह़मळवा सी, नीता भरहो करवा सी जड़ी? <verse eid="GAL 3:2" /><verse number="3" style="v" sid="GAL 3:3" />ह़ु तमु एतरा वण-अकल्‌या से, के भगवान नी आत्‌मा नी रीती पोर चालु करीन हाव डील नी रीती पोर पुरु करवा हींड र्‌या। <verse eid="GAL 3:3" /><verse number="4" style="v" sid="GAL 3:4" />तमु एतरो दुख फाल्‌तु झेल्‌या ह़ु? पण कदी बी फाल्‌तु नी। <verse eid="GAL 3:4" /><verse number="5" style="v" sid="GAL 3:5" />जे भगवान तमने आत्‌मा आपे अने तमारी मे जोरभर्‌यु काम करतो हय, तीहयो ह़ु तमु कायदा ने मानवा सी के तमु खुस-खबर ह़मळ्‌या अने भरहो कर्‌या करीन आसम करतलो?<verse eid="GAL 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 3:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:6 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 4:3">रोमीयो 4:3</ref>
      </char>
    </note>जीसम अब्‌राहम नी जानकारी ना बारा मे सास्‌तर मे लीखलु से। तीहयो ते भगवान पोर भरहो कर्‌यो अने तीहया भरहा ना कारण भगवान तीने धरमी मान्‌यो। <verse eid="GAL 3:6" /><verse number="7" style="v" sid="GAL 3:7" /><note caller="+" style="x"><char style="xo" closed="false">3:7 </char><char style="xt" closed="false"><ref loc="ROM 4:16">रोमीयो 4:16</ref></char></note>ता आहयु जाण लेवो, के जे भरहो करवा वाळा से, तीहयात अब्‌राहम नी अवल्‌यात से। <verse eid="GAL 3:7" /><verse number="8" style="v" sid="GAL 3:8" />अने चोखली सास्‌तर मे पेलेत सी देखाड़ देदलो, के भगवान आड़जात्‌या ने भरहा सी धरमी ठेरावहे, पेलेत सी अब्‌राहम ने आहयी खुस-खबर ह़मळाय देदी, के तारी मे आखा माणहु ने बरकत जड़हे। <verse eid="GAL 3:8" /><verse number="9" style="v" sid="GAL 3:9" />अब्‌राहम भरहो कर्‌यो अने बरकत जड़ी, तीनीन तेम जे भरहो करे तीहया बरकत हात करे।<verse eid="GAL 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GAL 3:10" />आनी लेदे जेतरा माणहु कायदा नो पाळण करीन जीवता हय, तीहया आखा सराप ना हक मे से, काहाके सास्‌तर मे लीखलु से, जे कोय कायदा नी कीताप मे लीखली आखी वातु ने करवा मे टेकलो नी रेय, तीहयो सरापीत से। <verse eid="GAL 3:10" /><verse number="11" style="v" sid="GAL 3:11" />पण आहयी वात उजन्‌ती से के कायदा ना लारे भगवान ने तां कोय धरमी नी ठेरे, काहाके धरमी माणेह भरहा सी जीवत्‌लो रेहे। <verse eid="GAL 3:11" /><verse number="12" style="v" sid="GAL 3:12" />पण कायदा नो भरहा सी कंय रीस्‌तो नी हय; काहाके “जे तीमने मानहे, तीहयो तीमना कारण जीवत्‌लो रेहे।”<verse eid="GAL 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 3:13" />मसी जे अमारी लेदे सरापीत बण्‌यो, आमने वेचाता लीन कायदा ना सराप गेथो सोड़ायो काहाके सास्‌तर मे लीखलु से, “जे कोयने लाकड़ा ना कुरुस पोर टांग देता हय तीहयो सरापीत से।” <verse eid="GAL 3:13" /><verse number="14" style="v" sid="GAL 3:14" />आहयु आनीन करते हयु, के अब्‌राहम नी बरकत मसी ईसु मे आड़जात्‌या लग पुगे, अने आमु भरहा ना लारे तीहयी आत्‌मा ने हात करीया, जीनो वायदो भगवान करलो से।<verse eid="GAL 3:14" /></para>
  <para style="s">कायदा अने वायदो</para>
  <para style="p">
    <verse number="15" style="v" sid="GAL 3:15" />ए भायु अने बेन्‌या, मे तमने एक दाड़ा नो उदारण देखाड़ र्‌यो; जेम काना बे माणहु नी राजी सी बोली पक्‌की हय जाय, ता नी कोय तीने टाळे अने नी कोय तीनी मे कंय बड़ावे। <verse eid="GAL 3:15" /><verse number="16" style="v" sid="GAL 3:16" />अने वायदा अब्‌राहम ने अने तीनी अवल्‌यात ने आपलो से। तीहयो आहयु नी केदु के आखा जुगु; पण तीनी अवल्‌यात मे गेथा एकीत जणा जुगु वायदो करलो से; अने तीहयी अवल्‌यात मसी से। <verse eid="GAL 3:16" /><verse number="17" style="v" sid="GAL 3:17" />पण मे आहयु केम, जे बोली भगवान अब्‌राहम ह़ाते पेले सी पाकी करलो हतो, तीने कायदा च्‌यार ह़ो तीस साल बाद आय्‌न नी टाळ सके। <verse eid="GAL 3:17" /><verse number="18" style="v" sid="GAL 3:18" /><note caller="+" style="x"><char style="xo" closed="false">3:18 </char><char style="xt" closed="false"><ref loc="ROM 4:14">रोमीयो 4:14</ref></char></note>काहाके कदी भगवान नो दान कायदा सी जड़्‌यो, ता वायदा सी नी, पण भगवाननेत अब्‌राहम ने वायदा नी लारे आप देदलो से।<verse eid="GAL 3:18" /></para>
  <para style="s">कायदा नो मकसत</para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 3:19" />ता कायदा ह़ु करवा आप मेल्‌या? तीहया ते गुना ना कारण अळतेण आप मेल्‌या के तीहयी अवल्‌यात ने आवता लग रेय, जीने वायदो आपलो हतो, अने कायदा ह़रगदुत ना लारे एक वचे वाळा ना हात मे आप मेल्‌या। <verse eid="GAL 3:19" /><verse number="20" style="v" sid="GAL 3:20" />वचे ते बे जणान वच मे हये, पण भगवान ते एकीत से।<verse eid="GAL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 3:21" />ता ह़ु कायदा भगवान ना वायदा ना वीरोद मे से? कदी नी! काहाके एवा कायदा आप्‌तो हतो जे जीवाय आप सके, ता ह़ाचलीन धरमीपण कायदा सी हये। <verse eid="GAL 3:21" /><verse number="22" style="v" sid="GAL 3:22" />पण चोखली सास्‌तर आखा ने पाप ना हक मे कर देदी, के ईसु मसी मे भरहो करवा ना लारे भरहो करवा वाळा ना लेदे दान आपवा ना वायदा पुरा हये।<verse eid="GAL 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GAL 3:23" />पण भरहा ने आव्‌वा सी पेले कायदा ना हक मे अमारी गुवाळी हयती हती, अने तीहया भरहा ने आवते लग जे उजन्‌तु हयवा वाळु हतु, आमु तीनीत बंदण मे र्‌या। <verse eid="GAL 3:23" /><verse number="24" style="v" sid="GAL 3:24" />आनीन करते कायदा मसी लग पुगाड़वान लेदे अमारी मास्‌तर हयी के आमु भरहा सी धरमी ठेरे। <verse eid="GAL 3:24" /><verse number="25" style="v" sid="GAL 3:25" />पण जत्‌यार भरहो आयो, ता आमु हाव मास्‌तर ना हक नी र्‌या।<verse eid="GAL 3:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GAL 3:26" />काहाके तमु आखा तीहया भरहा नी लारे जे ईसु मसी पोर से, भगवान ना सोरा बण जेला से। <verse eid="GAL 3:26" /><verse number="27" style="v" sid="GAL 3:27" />अने तमारी मे गेथा जेतरा बी मसी मे बपतीस्‌मा लेदला से तीहया मसी मे एक हय जेला से। <verse eid="GAL 3:27" /><verse number="28" style="v" sid="GAL 3:28" />हाव नी कोय युहदी र्‌यो अने नी युनानी, नी कोय पावोर, नी कोय अदमी नी बयर, काहाके तमु आखा मालीक ईसु मसी मे मळ जवा ना कारण तमु एक से। <verse eid="GAL 3:28" /><verse number="29" style="v" sid="GAL 3:29" /><note caller="+" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="ROM 4:13">रोमीयो 4:13</ref></char></note>अने कदी तमु मसी ना माणहु हय, ता तमु बी अब्‌राहम नी अवल्‌यात अने वायदा ना अनसारे हकदार्‌या बी से।<verse eid="GAL 3:29" /></para>
  <chapter eid="GAL 3" />
  <chapter number="4" style="c" sid="GAL 4" />
  <para style="s">मसी मे भगवान ना छुट्‌ला सोरा</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 4:1" />मे आहयु केम के, वारीस जत्‌यार लग सोरु से, अने आखी चीज नो मालीक से, ते बी तीनी मे अने पावोर मे कंय भेद-भाव नी हय। <verse eid="GAL 4:1" /><verse number="2" style="v" sid="GAL 4:2" />पण बाह नी टाकली टेम लग रखवाळ्‌या अने जुगाड़ करन्‌या ना हक मे रेय। <verse eid="GAL 4:2" /><verse number="3" style="v" sid="GAL 4:3" />तेमेत आमु बी, जत्‌यार सोरा हता, ता कळी नी पेल्‌नी ह़ीकापण हक मे हय्‌न पावर्‌यो बणला हता। <verse eid="GAL 4:3" /><verse number="4" style="v" sid="GAL 4:4" />पण टेम पुरी हय जी, ता भगवान आह़फा ना बेटा ने मोकल्‌यो जे बयर ने लारे पयदा हयो, अने कायदा ना हक मे जीव्‌यो। <verse eid="GAL 4:4" /><verse number="5" style="v" sid="GAL 4:5" /><note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="ROM 8:15-17">रोमीयो 8:15-17</ref></char></note>काहाके कायदा ना हक मे रेवा वाळा आपणु आखा ने वेचाता लीन सोड़ाय लेय, काहाके आपणु भगवान ना बेटा-बेटी बण सकीया। <verse eid="GAL 4:5" /><verse number="6" style="v" sid="GAL 4:6" />हाव तमु भगवान ना सोरा से, आनी लेदे भगवान आह़फा ना बेटा नी आत्‌मा ने अमारा मन मे मोकल्‌लो से, आनी लेदे आहयु कीन बोलाड़े, ए बाह! ए बाह। <verse eid="GAL 4:6" /><verse number="7" style="v" sid="GAL 4:7" />एतरे हाव तु पावोर नी पण बेटो से, जत्‌यार बेटो हयो, एतरे हाव तमु भगवान नी लारे वारीस बी हया।<verse eid="GAL 4:7" /></para>
  <para style="s">गलातीया ना बारा मे पोलुस नी चीन्‌ता</para>
  <para style="p">
    <verse number="8" style="v" sid="GAL 4:8" />पेले जत्‌यार तमु भगवान ने नी जाणत्‌ला, तत्‌यार तमु तीहया भगवान ना गुलाम हता, जे ह़ाच्‌लीन भगवान नी हता। <verse eid="GAL 4:8" /><verse number="9" style="v" sid="GAL 4:9" />पण हाव जे तमु भगवान ने ओळखी लेदा, नीता भगवान तमने ओळख्‌यो, ता तीहयी लुल्‌ली अने रीकामी ह़ीकापण भणी काहा फीर र्‌या, तीना तमु अळी गुलाम बणवा हय र्‌या? <verse eid="GAL 4:9" /><verse number="10" style="v" sid="GAL 4:10" />तमु खास दाड़ा अने मयना अने संय टेम अने सालु ने मान र्‌या। <verse eid="GAL 4:10" /><verse number="11" style="v" sid="GAL 4:11" />मे तमारा बारा मे घणो फीकर करतलो, कंखर माय्‌न आसम नी हय जाय, के जे मेहनत मे तमारी लेदे करलो से तीहयी अमथी नी हय जाय।<verse eid="GAL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GAL 4:12" />ए भायु, मे तमारी सी वीन्‌ती करु, तमु मारीन तेवा हय जावो; काहाके मे बी तमारीन तेवो हयलो से; तमु ते मारु कंय नी बगाड़्‌या। <verse eid="GAL 4:12" /><verse number="13" style="v" sid="GAL 4:13" />पण तमने मालम से, के पेले ते मे मारा डील नी लुल्‌खाय ना कारण सी तमने खुस-खबर ह़मळायो। <verse eid="GAL 4:13" /><verse number="14" style="v" sid="GAL 4:14" />अने तमु मारा डील नी हालत ने जे तमारी पारख ना कारण हती, हेटो नी ह़मज्‌या; अने नी तीनी सी ह़ीगी कर्‌या; अने भगवान नो दुत ह़मजीन नीता मसी ईसुन तेम मने मान लेदा। <verse eid="GAL 4:14" /><verse number="15" style="v" sid="GAL 4:15" />ता तीहयी तमारी खुसी कां जी? मे तमारो गवा से, के कदी हय सके, ता तमु आपणा डोळा बी नीकाळीन मने आप देता। <verse eid="GAL 4:15" /><verse number="16" style="v" sid="GAL 4:16" />ता ह़ु मे तमने ह़ाचली वात केवा ना कारण सी तमारो वेरी बण ज्‌यो?<verse eid="GAL 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 4:17" />तीहया तमने दोस्‌तीदार बणाव्‌वा हींड र्‌या, पण भला वीच्‌यार सी नी, बाखीन तमने मारी सी सेटा करवा हींड र्‌या, के तमु तीमनीत ह़ाते हय जावो। <verse eid="GAL 4:17" /><verse number="18" style="v" sid="GAL 4:18" />पण होह मे रेवा वारु से, भली वात मे जलम कोसीत करवा जोवे, नीस्‌तु तीहयी टेमे नी, के जत्‌यार मे तमारी ह़ाते रेम। <verse eid="GAL 4:18" /><verse number="19" style="v" sid="GAL 4:19" />ए मारा सोरा, जत्‌यार लग तमारी मे ईसु मसी नो वेह़ नी बण जाय, तत्‌यार लग मे तमारी लेदे अळी सोरु पयदा करवा वाळी बयर नी तेम तळफी र्‌यो। <verse eid="GAL 4:19" /><verse number="20" style="v" sid="GAL 4:20" />मारी हेर ते आहयी से, के हाव तमारीन्‌तां आय्‌न मोंग सी बोलु; काहाके तमारा बारा मे फीकर मे से।<verse eid="GAL 4:20" /></para>
  <para style="s">सारा अने हाजीरा नो दाखलो</para>
  <para style="p">
    <verse number="21" style="v" sid="GAL 4:21" />तमु जे कायदा ना हक मे हयवा हींड र्‌या, मने केवो, ह़ु तमु कायदा नी ह़मळतला नी? <verse eid="GAL 4:21" /><verse number="22" style="v" sid="GAL 4:22" />चोखली सास्‌तर मे लीखलु से, के अब्‌राहम ना बे सोरा हया; अने एक छुट्‌टी बयर सी अने बीजो सोरो पावर्‌याण सी। <verse eid="GAL 4:22" /><verse number="23" style="v" sid="GAL 4:23" />पण जे पावर्‌याण सी हयो, तीहयो डील ना रीते पयदा हयो, अने जे छुट्‌टी बयर सी हयो, तीहयो वायदा ना लारे पयदा हयो। <verse eid="GAL 4:23" /><verse number="24" style="v" sid="GAL 4:24" />आहयी वात मे दाखलो से, आहया बयरा मानो बे वायदा से, एक ते सीने बड़ा नी जीनी सी पावोरेत पयदा हये; तीहयी हाजीरा से। <verse eid="GAL 4:24" /><verse number="25" style="v" sid="GAL 4:25" />अने हाजीरा मानो अरब नो सीने बड़ो से, नवलु यरुसलेम तीनीन तेम से, काहाके तीना सोरा भेळ गुलामी मे से। <verse eid="GAL 4:25" /><verse number="26" style="v" sid="GAL 4:26" />पण उपर ह़रगे वाळो यरुसलेम छुट्‌लु से, अने तीहयी अमारी आय्‌ह से। <verse eid="GAL 4:26" /><verse number="27" style="v" sid="GAL 4:27" />काहाके सास्‌तर मे लीखलु से,</para>
  <para style="q1" vid="GAL 4:27">ए वांज्‌याण, तु जे नी जणती, खुसी हय;</para>
  <para style="q2" vid="GAL 4:27">तु जे जीने वेणा नी छुटे, गळु फाड़ीन बड़ाय कर,</para>
  <para style="q1" vid="GAL 4:27">काहाके छुट्‌ली बयर नी अवल्‌यात,</para>
  <para style="q2" vid="GAL 4:27">धणी वाळी बयर नी अवल्‌यात गेथी जादा से।<verse eid="GAL 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GAL 4:28" />ए भायु अने बेन्‌या, आमु ईसाक नी तेम वायदा नी अवल्‌यात से। <verse eid="GAL 4:28" /><verse number="29" style="v" sid="GAL 4:29" />अने जीसम तीहयी टेमे डील ना अनसारे पयदा हयो, आत्‌मा ना अनसारे पयदा हयो तीने वेला पाड़तो हतो, तेमेत हाव बी हये। <verse eid="GAL 4:29" /><verse number="30" style="v" sid="GAL 4:30" />पण खरली सास्‌तर ह़ु केय? “पावर्‌याण अने तीना सोरा ने नीकाळ दे” काहाके पावर्‌याण नो सोरो छुट्‌टी बयर ना सोरा ह़ाते बाह ना माल-धन मे हीस्‌सो नी रेय। <verse eid="GAL 4:30" /><verse number="31" style="v" sid="GAL 4:31" />आनी लेदे ए भायु अने बेन्‌या, आमु पावर्‌याण ना नी हय पण छुट्‌टी बयर नी अवल्‌यात से।<verse eid="GAL 4:31" /></para>
  <chapter eid="GAL 4" />
  <chapter number="5" style="c" sid="GAL 5" />
  <para style="s">ईसु मसी मे छुटकारो</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 5:1" />मसी छुटकारा ना लेदे आमने सोड़ावलो से; आनी लेदे टेकला रेवो, अने गुलामी ना वळा मे अळी ना जोड़ावो।<verse eid="GAL 5:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GAL 5:2" />देखो, मे पोलुस तमने केम, के कदी तमु खतनु करावीन पासा कायदा भणी जावो, ता ईसु मसी मे तमने कंय फायदो नी हये। <verse eid="GAL 5:2" /><verse number="3" style="v" sid="GAL 5:3" />ते बी मे आखा खतना कराव्‌वा वाळा ने चेताय देम, के तीने आखा कायदा मानवा पड़हे। <verse eid="GAL 5:3" /><verse number="4" style="v" sid="GAL 5:4" />तमु जे कायदा ना लारे धरमी बणवा हींड र्‌या, मसी सी आंग्‌ये अने दया जड़वा सी ठारला री जेला से। <verse eid="GAL 5:4" /><verse number="5" style="v" sid="GAL 5:5" />काहाके आत्‌मा ना कारण आमु भरहा सी, आह करली धरमपण नी वाट जोय र्‌या। <verse eid="GAL 5:5" /><verse number="6" style="v" sid="GAL 5:6" />अने मसी ईसु मे खतना करलु नीता नी करलु कंय काम नु हय, पण नीस्‌तो भरहो, जे मोंग लारे काम नो से।<verse eid="GAL 5:6" /></para>
  <para style="s">मोंग ना लारे कायदा नु पुरु हयणु</para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 5:7" />तमु ते वारु दवड़ र्‌या हता, हाव तमने कोय रोक देदु, के सच्‌चाय ने ना मानो। <verse eid="GAL 5:7" /><verse number="8" style="v" sid="GAL 5:8" />आसवी ह़ीक तमारा बोलाव्‌वा वाळा भगवान भणी गेथी नी हय। <verse eid="GAL 5:8" /><verse number="9" style="v" sid="GAL 5:9" /><note caller="+" style="x"><char style="xo" closed="false">5:9 </char><char style="xt" closed="false"><ref loc="1CO 5:6">1 कुरन्‌थी 5:6</ref></char></note>थोड़ुक खमीर आखा कोहणला लोट ने खमीर बणाय देय। <verse eid="GAL 5:9" /><verse number="10" style="v" sid="GAL 5:10" />मे मालीक मे एक हयवा ना लेदे तमारा बारा मे भरहो राखु, के तमारो कोय बीजो वीच्‌यार नी हय, पण जे तमने घबराड़ देय, तीहयो कोय काहा नी हय, डंड जड़हे।<verse eid="GAL 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 5:11" />ए भायु, कदी तमु बी जीसम थोड़ाक माणहु ह़मजे के खतनु करवा खास से। अने आहयु परच्‌यार करु, ता मने हमणे लग काहा वेला पाड़े? आसम हतु ता मसी ना कुरुस ना लेदे पयदा हयली आखी अड़चन खत्‌तम हय जवु हती। <verse eid="GAL 5:11" /><verse number="12" style="v" sid="GAL 5:12" />भलु रेतु के जे तमने वेला पाड़ र्‌या, तीहया आह़फाम नो अंग वाड लेता!<verse eid="GAL 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GAL 5:13" />ए भायु, तमु छुट्‌टा हयवा करीन बोलावला से, पण आसम नी हयवा जोवे, के आहयो छुटकारो डील ना कामु ना लेदे मोखो बणे, पण मोंग सी एक-बीजा ना पावर्‌या बणो। <verse eid="GAL 5:13" /><verse number="14" style="v" sid="GAL 5:14" />काहाके आखा कायदा आहयी एकीत वात मे पुरा हय जाय, “तु आपणा ह़ाते वाळा सी आह़फान तेम मोंग कर।” <verse eid="GAL 5:14" /><verse number="15" style="v" sid="GAL 5:15" />कदी तमु एक-बीजा ने दुख दीन चोट पुगाड़ता हय, ता चेतीन रेवो के एक-बीजा नु नुकसान नी कर देवो।<verse eid="GAL 5:15" /></para>
  <para style="s">आत्‌मा अने माणहु नो सोभाव</para>
  <para style="p">
    <verse number="16" style="v" sid="GAL 5:16" />पण मे केम, आत्‌मा ना अनसारे चालो, ता तमु डील नी हेर कानी रीते सी बी पुरी नी करो। <verse eid="GAL 5:16" /><verse number="17" style="v" sid="GAL 5:17" /><note caller="+" style="x"><char style="xo" closed="false">5:17 </char><char style="xt" closed="false"><ref loc="ROM 7:15-23">रोमीयो 7:15-23</ref></char></note>काहाके डील आत्‌मा ना वीरोद मे अने आत्‌मा डील ना वीरोद मे हेर करे, अने आयहा एक-बीजा ना वीरोद मे से; आनी लेदे के जे तमु करवा हेर करो तीहयु नी कर सको। <verse eid="GAL 5:17" /><verse number="18" style="v" sid="GAL 5:18" />अने कदी तमु आत्‌मा ना चाले चालता हय ता कायदा ना कब्‌जा मे ना रेवो।<verse eid="GAL 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GAL 5:19" />डील ना काम ते उजन्‌ता से; मतलब छीनाळु करवा, गलत काम, लुच्‌चाय, <verse eid="GAL 5:19" /><verse number="20" style="v" sid="GAL 5:20" />मुर्‌ती नी पुजा करवा, बड़वाय, वेरपोणु करवा, झगड़ो करवा, कुहरायवा, खीजवायवा, गरज्‌यो, <verse eid="GAL 5:20" /><verse number="21" style="v" sid="GAL 5:21" />रीह, दारकुट्‌टो बणवा, छाकीन छीनाळु मे मजा लेवा अळी ईमनी सेवा अळी कामु से; ईमना बारा मे जीसम पेले बी मे की देदलो, के आसवा-आसवा काम करवा वाळा भगवान ना राज ना वारीस कदी नी हये।<verse eid="GAL 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GAL 5:22" />पण आत्‌मा ना फोळ; मोंग करवा, खुस रेवा, सांती गम खावा, अने दया करवा, भलाय करवा, भरहो; <verse eid="GAL 5:22" /><verse number="23" style="v" sid="GAL 5:23" />ह़ुमाळा रेवा, अने हक मे राखवा; आवा-आवा कामु ना वीरोद मे काना बी कायदा नी हय। <verse eid="GAL 5:23" /><verse number="24" style="v" sid="GAL 5:24" />अने जे मसी ईसु ना से, तीहया डील ने तीमनी हेर अने पापी नी हाय भेळ कुरुस पोर चड़ाय देदला से। <verse eid="GAL 5:24" /><verse number="25" style="v" sid="GAL 5:25" />कदी आमु आत्‌मा ना लारे जीवत्‌ला से, ता आत्‌मा ना अनसारे चालो बी। <verse eid="GAL 5:25" /><verse number="26" style="v" sid="GAL 5:26" />आमु घमंड्‌या हय्‌न एक-बीजा ने ना छेड़ो, अने एक-बीजा सी डहवाय ना करो।<verse eid="GAL 5:26" /></para>
  <chapter eid="GAL 5" />
  <chapter number="6" style="c" sid="GAL 6" />
  <para style="s">आखा ह़ाते भलाय करो</para>
  <para style="p">
    <verse number="1" style="v" sid="GAL 6:1" />ए भाय-बेन्‌या, कदीम कोय माणहे गुना मे धराय जाय, ता तमु जे आत्‌मा सी भरायला से, भोळाय भेळ एवा ने ह़माळो, अने आह़फाम नी बी देख-भाळ करो, के तमु बी पारख मे नी पड़ो। <verse eid="GAL 6:1" /><verse number="2" style="v" sid="GAL 6:2" />तमु एक-बीजा नो भार उचलो, अने आहयी रीते मसी ना कायदा ने पुरा करो। <verse eid="GAL 6:2" /><verse number="3" style="v" sid="GAL 6:3" />कदीम कोय कंय नी हयवा सी बी आह़फा ने कंय ह़मजे, ता आह़फा ने धोको दी र्‌यो। <verse eid="GAL 6:3" /><verse number="4" style="v" sid="GAL 6:4" />पण एक-एक जणा आपणा काम ने पारखी लेय, अने ता बीजा ना बारा मे नी पण आह़फात ना बारा मे तीने मोटाय करवा नो मोखो रेहे। <verse eid="GAL 6:4" /><verse number="5" style="v" sid="GAL 6:5" />काहाके एक-एक माणेह आह़फात नो बोजो झेलहे।<verse eid="GAL 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GAL 6:6" />जे बोलु नी ह़ीकापण हात करे, तीहयो आखी वारली चीज मे ह़ीकाड़वा वाळा ने वाटो आपो।<verse eid="GAL 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GAL 6:7" />धोको ना खावो, भगवान नी कोय हाही-ठट्‌टा नी उड़ाय सके, काहाके माणहे जे कंय वेरे, तीहयुत वाडहे। <verse eid="GAL 6:7" /><verse number="8" style="v" sid="GAL 6:8" />जे कोय आह़फा ना डील जुगु वेरे, तीहयो डील नी लारे मोत नी वाडणी वाडहे; अने जे आत्‌मा जुगु वेरे, तीहयो आत्‌मा नी लारे अमरकाय जीवाय नी वाडणी वाडहे। <verse eid="GAL 6:8" /><verse number="9" style="v" sid="GAL 6:9" />आमने भला काम करवा मे हीम्‌मत नी सोड़वा जोवे, काहाके आमु ढीला नी हयवा जोवे, ता वारु टेमे पोर वाडणी वडायहे। <verse eid="GAL 6:9" /><verse number="10" style="v" sid="GAL 6:10" />एतरे जां तक मोखो जड़े अमारी आखा ह़ाते भलाय करो; खास करीन भरहो करन्‌या भायु ह़ाते।<verse eid="GAL 6:10" /></para>
  <para style="s">आखरी चेतावणी अने वारला से के केणु</para>
  <para style="p">
    <verse number="11" style="v" sid="GAL 6:11" />देखो, मे कीकम मोट्‌ला-मोट्‌ला आकड़ा मे तमारी जुगु मारा हात सी लीखलो से। <verse eid="GAL 6:11" /><verse number="12" style="v" sid="GAL 6:12" />जेतरा माणहु डील नो दीखावो ह़ोदे तीहया खतना कराव्‌वा जुगु दबाव देय, आनीन करते के तीहया मसी ना कुरुस ना कारण सी वेला नी पाड़े। <verse eid="GAL 6:12" /><verse number="13" style="v" sid="GAL 6:13" />काहाके खतना कराव्‌वा वाळा आह़फा ते कायदा पोर नी चाले, पण तमारा खतना आनीन करते करवा हींडे के तमारा डील नी हालत पोर घमंड करे <verse eid="GAL 6:13" /><verse number="14" style="v" sid="GAL 6:14" />पण आसम नी हये, के मे अळी कानी वात नो घमंड करु, नीस्‌तो अमारा मालीक ईसु मसी ने कुरुस ना जीना लारे कळी मारी नींगा मे अने मे कळी नी नींगा मे कुरुस पोर चड़ावलो से। <verse eid="GAL 6:14" /><verse number="15" style="v" sid="GAL 6:15" />काहाके नी खतना, अने नी वण-खतना कंय से, पण नवली कळी खास से। <verse eid="GAL 6:15" /><verse number="16" style="v" sid="GAL 6:16" />अने जेतरा आहया कायदा पोर चालहे तीमनी पोर, अने भगवान ना ईस्‌रायल पोर, सांती अने दया हयती रेय।<verse eid="GAL 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GAL 6:17" />चीट्‌ठी ने खत्‌तम करतो जाय्‌न मे तमारी सी वीन्‌ती करु के मने अळी कंय दुख ना आपो, काहाके के मे पेले सीत मारा डील पोर ईसु ना घाव ने वेठ र्‌यो।<verse eid="GAL 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GAL 6:18" />ए भायु अने बेन्‌या, अमारा मालीक ईसु मसी नी दया तमारी ह़ाते रेय। आमीन।<verse eid="GAL 6:18" /></para>
  <chapter eid="GAL 6" />
</usx>