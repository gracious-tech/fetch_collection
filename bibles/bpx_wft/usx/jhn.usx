<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JHN" style="id">- Paliya</book>
  <para style="h">युहन्‌ना</para>
  <para style="toc3">युहन्‌ना</para>
  <para style="toc2">युहन्‌ना</para>
  <para style="toc1">युहन्‌ना नी लीखली ईसु मसी नी खुस-खबर</para>
  <para style="mt2">युहन्‌ना का लीखा यीशु मसी का सु-समाचार</para>
  <para style="mt1">युहन्‌ना नी लीखली ईसु मसी नी खुस-खबर</para>
  <para style="imt">जानकारी</para>
  <para style="ip">युहन्‌ना ना लारे खुस-खबर नी नवला कायदा नी च्‌यार कीताप्‌या मे नी एक से, जे ईसु मसी नी जीवाय ना बारा मे देखाड़े। तीहयी आखी कीताप “खुस-खबर” नी कीताप केवाय, आनु मतलब से “वारली खबर।” तीहया मत्‌ती, मरकुस, लुका अने युहन्‌ना ना लारे ईसु मसीन मरवान अळतेण लीखला हता। युहन्‌ना ना हीसाब सी खुस-खबर कंय माय्‌न नेवताळा युहन्‌ना ना लारे ईसु मसी पयदा हयवान आड़े-धेड़े 90 साल अळतेण लीखली हती। भले कीताप आहयु नी केती के लीखण्‌यो युहन्‌नो से, पण लीखावट 1 युहन्‌ना 2 युहन्‌ना अने 3 युहन्‌ना ना आक्‌सर ने तेवा से। थोड़ाक पुराणा लीखण्‌या आसम माने के युहन्‌नो तीहयी टेमे ईफीसुस ह़ेर मे रेतो हतो करीन कीताप ईफीसुस ह़ेर मे लीखी हहे।</para>
  <para style="ip">युहन्‌नो ह़ुदो केय के आहयी कीताप नो मकसत आहयो से के माणहु ने भरहो कराव्‌वा मे मदत करवा नु से के ईसु मसी जीवत्‌ला भगवान नो सोरो से। <char style="xt"><ref loc="JHN 20:31">20:31</ref></char> आहयो भरहो करीन आपणु तीना नाम सी जीवाय जीवी सकत्‌ला। कीताप युहदी अने आड़जात्‌या बेम जुगु लीखली से। युहन्‌ना नी खुस-खबर मे बीजी तीन कीताप सी घणु अलग लीखलु से। तीहयो ते जुदा-कामु पोर ध्‌यान देदो, जे ईसु मसी करलो हतो अने आह़फा नी काहणी ना बारा मे जादा नी लीखलो हतो। ईसु ना बपतीस्‌मा अने। जंगल अने बीजी घटना ने बी आहयी खुस-खबर मे नी लीखलु हय।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. युहन्‌नो खुस-खबर नी सुरुवात करे। <char style="ior"><ref loc="JHN 1:1-18">1:1-18</ref> </char></para>
  <para style="io1">2. तीनी अळतेण तीहयो ते कंय जुदा-कामु ना बारा लीखलो जे ईसु मसी करलो हतो। <char style="ior"><ref loc="JHN 1:19-12:50">1:19–12:50</ref></char></para>
  <para style="io1">3. तीनी अळतेण तीहयो ईसु नी कंय घटना ना बारा मे देखाड़े जे ईसु मसी नी मोत अने पासो जीव उठवा ना बारा मे देखाड़े। <char style="ior"><ref loc="JHN 13:1-20:31">13:1–20:31</ref> </char></para>
  <para style="io1">4. युहन्‌नो खुस-खबर ने खत्‌तम करे अने कीताप लीखवा नो मकसत देखाड़े के ईसु मसी मरीन पासो जीवतो हय्‌न माणहु ने देखाव पड़े। <char style="ior"><ref loc="JHN 21">21</ref></char></para>
  <chapter number="1" style="c" sid="JHN 1" />
  <para style="s">जीवाय नो बोल</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 1:1" />सुरुवात मे बोल हतो, अने बोल भगवान ह़ाते हतो, अने बोलेत भगवान हतो। <verse eid="JHN 1:1" /><verse number="2" style="v" sid="JHN 1:2" />सुरु गेथोत आहयो बोल भगवान ह़ाते हतो। <verse eid="JHN 1:2" /><verse number="3" style="v" sid="JHN 1:3" />तीना लारे भगवान आखी चीज बणायो; अने जे चीज बण्‌ली से तीहयी तीना वगर एक बी नी बणी। <verse eid="JHN 1:3" /><verse number="4" style="v" sid="JHN 1:4" />बोल जीवाय नु वीजाळु हतो, अने तीहयी जीवाय माणहु नु वीजाळु हतु। <verse eid="JHN 1:4" /><verse number="5" style="v" sid="JHN 1:5" />अने वीजाळु अंदारला मे भबळ्‌यु, पण अंदारलु तीने आवर्‌यु नी।<verse eid="JHN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 1:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:6 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:1">मत्‌ती 3:1</ref>; <ref loc="MRK 1:4">मरकुस 1:4</ref>; <ref loc="LUK 3:1">लुका 3:1</ref>,<ref loc="LUK 3:2">2</ref></char>
    </note>भगवान वगे गेथो एक खबर्‌यो, तीनु नाम युहन्‌नो हतो। <verse eid="JHN 1:6" /><verse number="7" style="v" sid="JHN 1:7" />युहन्‌नो आहयी गवा देवा आयो, के वीजाळु नी गवाय देय, काहाके आखा तीनी लारे भरहो करे। <verse eid="JHN 1:7" /><verse number="8" style="v" sid="JHN 1:8" />तीहयो युहन्‌नो आह़फो तीहयु वीजाळु नी हतो पण तीहया वीजाळा ना बारा मे गवाय देवा आवलो हतो। <verse eid="JHN 1:8" /><verse number="9" style="v" sid="JHN 1:9" />खरलु वीजाळु आखा माणहु ने वीजाळा मे करे, कळ मे आव्‌वा वाळु हतु।<verse eid="JHN 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 1:10" />तीहयो बोल कळी मे हतो, अने भगवान तीनी लारे कळी बणायो, ते बी आहयी कळी ना माणहु तीने नी ओळख्‌या। <verse eid="JHN 1:10" /><verse number="11" style="v" sid="JHN 1:11" />तीहयो आपणा घोर मे आयो, पण तीनात माणहु तीने आह़फाम ना जीव मे नी मान्‌या। <verse eid="JHN 1:11" /><verse number="12" style="v" sid="JHN 1:12" />पण जेतरा बी माणहु तीने आपणा जीव मे मानीन तीना नाम पोर भरहो करे, तीहयो तीहया आखा ने भगवान ना सोरा-सोरी बणवा नो हक आपे। <verse eid="JHN 1:12" /><verse number="13" style="v" sid="JHN 1:13" />तीहया नी ते लोय सी, नी ते डील नी हेर नी लारे, नी ते माणहु नी हेर नी लारे, पण भगवान सी पयदा हयला से।<verse eid="JHN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 1:14" />अने बोल माणेह बण्‌यो, अने दया अने सच्‌चाय सी पुरो भराय्‌न अमारी वच मे डेरो कर्‌यो, अने आमु तीनी आवी बड़ाय देख्‌या, जीसम बाह ना एक-खोळ्‌या नी बड़ाय।<verse eid="JHN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 1:15" />युहन्‌नोत तीना बारा मे गवाय देदो, अने आड़ी-आड़ीन केदो “आहयो तीहयोत से” जीना बारा मे आहयु केतो हतो, के एक जणो आव्‌वा वाळो से, तीहयो मार गेथो घण मोटो से, काहाके तीहयो मारी सी पेले हतो।<verse eid="JHN 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 1:16" />काहाके तीनी भरपुरी सी आमु आखात हात कर्‌या मतलब दया पोर दया। <verse eid="JHN 1:16" /><verse number="17" style="v" sid="JHN 1:17" />कायदा ते भगवान, मुसा ना लारे आपलो हतो, बाखीन दया अने सच्‌चाय ईसु मसी नी लारे आपणीन तां पुगली से। <verse eid="JHN 1:17" /><verse number="18" style="v" sid="JHN 1:18" />भगवान ने आज लग कोय नी देख्‌यु; एक-खोळ्‌यो बेटो जे बाह ना खोळा मे से, तीहयोत तीने उजन्‌तो कर्‌यो।<verse eid="JHN 1:18" /></para>
  <para style="s">बपतीस्‌मा आपवा वाळा युहन्‌ना नी खबर</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्‌ती 3:1-12</ref>; <ref loc="MRK 1:1-8">मरकुस 1:1-8</ref>; <ref loc="LUK 3:1-8">लुका 3:1-8</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 1:19" />युहन्‌ना नी गवाय आहयी से, के जत्‌यार युहद्‌या यरुसलेम गेथा पुंजारा ने अने लेवी जाती ना माणहु ने युहन्‌ना ने आहयु पुछवा ना लेदे मोकल्‌या, के “तु कोय से?”<verse eid="JHN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 1:20" />ता युहन्‌नो आहयु मान लेदो, अने मना नी कर्‌यो, पण मान लेदो के “मे मसी नी हय?”<verse eid="JHN 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 1:21" />तत्‌यार तीहया युहन्‌ना ने पुछ्‌या, ता तु कोय से?</para>
  <para style="p" vid="JHN 1:21">ता तु एलीयो से ह़ुं?</para>
  <para style="p" vid="JHN 1:21">ता युहन्‌नो केदो, “मे एलीयो नी हय?” ता तीहया अळी पुछ्‌या, “ता तु भगवान वगे गेथी वात केण्‌यो से ह़ु?” तीहयो युहन्‌नो जपाप आप्‌यो, “नी।”<verse eid="JHN 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 1:22" />ता तीहया तीने केदा, “ता तु कोय से? जे आमने मोकल्‌या, तीमने आमु ह़ु जपाप आपया? तु तारा बारा मे ह़ु केय?”<verse eid="JHN 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 1:23" />युहन्‌नो केदो, “जीसम यसायो भगवान वगे गेथी वात केण्‌यो माणेह केदलो से, मे बड़ा मे एक आड़वा वाळा नी अवाज से के तमु मालीक ईसु नी वाट ह़ुदी करो।”<verse eid="JHN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 1:24" />आहया यरुसलेम गेथा मोकल्‌ला माणहु मे गेथा थोड़ाक फरीसी पंथवाळा बी हता।<verse eid="JHN 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 1:25" />तीहया माणहु युहन्‌ना ने अळी पुछ्‌या, “तु नी ते मसी अने नी ते तु एलीयो हय, अने भगवान वगे गेथी वात केण्‌यो बी नी हय, ता तु माणहु ने बपतीस्‌मा काहा आपे?”<verse eid="JHN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 1:26" />युहन्‌नो तीमने जपाप आप्‌यो, “मे ते पाणी सी बपतीस्‌मा आप र्‌यो, बाखीन तमारा वच मे एक माणेह उबो हय र्‌यो, जीने तमु नी ओळखो। <verse eid="JHN 1:26" /><verse number="27" style="v" sid="JHN 1:27" />मतलब जे मार गेथो अळतेण आव्‌वा वाळो से, मे ते जीना खाहड़ा ना बोंदु सोड़वा लायक बी नी हय।”<verse eid="JHN 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 1:28" />आहयु आखु बेतन्‌या गाम मे हयु जे यरदन नंदी ना ह़ेली धेड़े से, तां युहन्‌नो बपतीस्‌मा आपतो हतो।<verse eid="JHN 1:28" /></para>
  <para style="s">भगवान नु गाडरु</para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 1:29" />बीजा दाड़े युहन्‌नो ईसु ने आह़फा भणी आवत्‌लो देखीन केदो, “आहयु भगवान नु गाडरु से, जे आखी कळी ना मनख्‌या ना पाप ने उचलीन लीत्‌ती रेय। <verse eid="JHN 1:29" /><verse number="30" style="v" sid="JHN 1:30" />आहयो तीहयो से, जीना बारा मे, मे तमने केतो हतो, के एक जणो आव्‌वा वाळो से, तीहयो मार गेथो घण मोटो से, काहाके तीहयो मार गेथो पेलो हतो। <verse eid="JHN 1:30" /><verse number="31" style="v" sid="JHN 1:31" />अने मे ते तीने ओळखतो नी हतो, एतरे मे पाणी सी बपतीस्‌मा आपतो आयो, के तीहयो ईस्‌रायल पोर उजन्‌तो हय जाय।”<verse eid="JHN 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 1:32" />अने युहन्‌नो आहयी गवाय देदो, के मे चोखली आत्‌मा ने पारवान वेह मे ह़रगे गेथी उतरत्‌ली, अने ईसु पोर थांगत्‌ली देखलो से। <verse eid="JHN 1:32" /><verse number="33" style="v" sid="JHN 1:33" />अने मे तीने ओळखतो नी हतो, पण जे मने बपतीस्‌मा आपवा मोकल्‌यो, तीहयोत मने केदो, जीनी पोर तु चोखली आत्‌मा ने उतरते अने थांगते देख्‌यो, तीहयोत चोखली आत्‌मा सी बपतीस्‌मा आपवा वाळो से। <verse eid="JHN 1:33" /><verse number="34" style="v" sid="JHN 1:34" />अने मेत देख्‌यो, अने गवाय देदो के “आहयोत भगवान नो बेटो से।”<verse eid="JHN 1:34" /></para>
  <para style="s">मालीक ईसु ना पेल्‌ना चेला</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 1:35" />बीजा दाड़े अळी युहन्‌नो अने आह़फा ना चेला मे गेथा बे जणा उबा हय र्‌या हता। <verse eid="JHN 1:35" /><verse number="36" style="v" sid="JHN 1:36" />तीहयो युहन्‌नो ईसु ने तां माय्‌न जत्‌लो देख्‌यो, अने आह़फा ना चेला ने केदो, “देखो, हीय्‌युत भगवान नु गाडरु से।”<verse eid="JHN 1:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 1:37" />तत्‌यार तीहया बे चेला युहन्‌ना नी वात ह़मळीन ईसु पसळ चाल पड़्‌या। <verse eid="JHN 1:37" /><verse number="38" style="v" sid="JHN 1:38" />ईसु पासो फीरीन भाळ्‌यो, अने तीमने आह़फा पसळ आवत्‌ला देख्‌यो, अने तीमने केदो, “तमु कोयने ह़ोद र्‌या?” तीहया ईसु ने केदा, “ए गुरु! तु कां रेय?”<verse eid="JHN 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 1:39" />ईसु तीमने केदो, “आवीन देख लेवो” तीहयी टेमे ह़ांती टेमे नी च्‌यार बज रेली, अने तीहया जाय्‌न देख्‌या के तीहयो कां रेय, अने ते दाड़े तीहया तीनी ह़ाते र्‌या।<verse eid="JHN 1:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 1:40" />युहन्‌ना नी वात ह़मळीन ईसु पसळ जवा वाळा मे एक जणा नु नाम अंदर्‌यास हतु, जे सीमोन पतरस नो भाय हतो। <verse eid="JHN 1:40" /><verse number="41" style="v" sid="JHN 1:41" />अने अंदर्‌यास पेलो आह़फा ना सग्‌गा भाय सीमोन ने केदो, “आमने ते मसी जड़ जेलो से।” <verse eid="JHN 1:41" /><verse number="42" style="v" sid="JHN 1:42" />अने अंदर्‌यास ते सीमोन ने ईसुन्‌तां ली ज्‌यो।</para>
  <para style="p" vid="JHN 1:42">ईसु सीमोन भणी भाळीन केदो, के तु युहन्‌ना नो बेटो सीमोन से, पण तु केफा मतलब पतरस केवाही।<verse eid="JHN 1:42" /></para>
  <para style="s">फीलीपुस अने नतनेल नो बोलावो</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 1:43" />बीजा दाड़े ईसु गलील मे जवा कर्‌यो। अने फीलीपुस ने भेटीन तीने केदो, “मार पसळ आव।” <verse eid="JHN 1:43" /><verse number="44" style="v" sid="JHN 1:44" />अने आहयो फीलीपुस अंदर्‌यास अने पतरस ना बेतसेदा ह़ेर मे रेण्‌यो हतो। <verse eid="JHN 1:44" /><verse number="45" style="v" sid="JHN 1:45" />अने फीलीपुस, नतनेल ने भेटीन तीने केदो, “जे मसी ना बारा मे मुसा ना कायदा मे अने भगवान वगे गेथी खबर लावण्‌या माणहु लीखला से, तीहयो आमने जड़ जेलो से, तीहयो नासरत मे रेवा वाळा युसुफ नो बेटो ईसु से।”<verse eid="JHN 1:45" /></para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 1:46" />नतनेल फीलीपुस ने केदो, “नासरत मे गेथी कानी बी वारली चीज उबजी सके ह़ु?” ता फीलीपुस तीने केदो, “चाल आवीन देख ले।”<verse eid="JHN 1:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 1:47" />ईसु नतनेल ने आवत्‌लो देख्‌यो, अने तीना बारा मे केदो, “देखो, आहयो ईस्‌रायली जाती नो खरलो माणेह से आनी मे कंय बी दगो नी हय।”<verse eid="JHN 1:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 1:48" />नतनेल ईसु ने पुछ्‌यो, “तु मने कीसम ओळखे?”</para>
  <para style="p" vid="JHN 1:48">ईसु जपाप आप्‌यो, “मे तने केम, फीलीपुस तने नी बोलायो अने पेले गेथोत मे तने जाणु। मे तने गुलर ना झाड़ तळे देखलो।”<verse eid="JHN 1:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 1:49" />नतनेल ईसु ने केदो, “ए गुरु! तु भगवान नो बेटो से, अने ईस्‌रायल नो राजा से।”<verse eid="JHN 1:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 1:50" />ईसु नतनेल ने केदो, “मे तने केदो, के मे तने गुलर ना झाड़ तळे देखलो एतरे तु मार पोर भरहो कर र्‌यो। तु आनी गेथा बी मोटा काम देखही।”<verse eid="JHN 1:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="JHN 1:51" />अळी ईसु तीमने केदो, “मे तमने ह़ाचली केम, एक दाड़े तमु ह़रग ने उगड़लु अने भगवान ह़रगदुतु ने माणहु ना बेटा नी पोर उतरत्‌ला अने तां गेथा उपर चड़त्‌ला देखहु।”<verse eid="JHN 1:51" /></para>
  <chapter eid="JHN 1" />
  <chapter number="2" style="c" sid="JHN 2" />
  <para style="s">काना नाम ना ह़ेर मे वेवा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 2:1" />तीसरा दाड़े गलील जीला ना काना ह़ेर मे एक माणेह ना वेवा हता। अने ईसु नी आह्‌य बी तां हती। <verse eid="JHN 2:1" /><verse number="2" style="v" sid="JHN 2:2" />वेवा मे ईसु अने तीना चेला ने बी बोलावला हता। <verse eid="JHN 2:2" /><verse number="3" style="v" sid="JHN 2:3" />जत्‌यार तां अंगुर नो लहणायलो रोह खुट ज्‌यो, ता ईसु नी आह्‌य ईसु ने केदी, हीमनी पांह अंगुर नो रोह नी र्‌यो।<verse eid="JHN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 2:4" />ईसु आह़फा नी आह्‌य ने केदो, “ए बाय मारी ह़ाते तारु ह़ु काम से? हमणे मारी टेम नी आयी।”<verse eid="JHN 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 2:5" />ईसु नी आह्‌य चाकर्‌या ने केदी, “हीय्‌यो तमने जे कंय केय तीहयु तमु करजो।”<verse eid="JHN 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 2:6" />तां दगड़ा ना छोव मोट्‌ला गोळा मेकला हता, आहया गोळा मे गेथु पाणी हेड़ीन युहदी माणहु चोखा हयवा करीन हातु-पोगु धोवता हता। ते गोळा मे ह़ोवेक लीटर पाणी ह़मातु हतु। <verse eid="JHN 2:6" /><verse number="7" style="v" sid="JHN 2:7" />ईसु पावर्‌या ने केदो, “गोळा मे पाणी भर देवो।” अने तीहया गोळा मे उबरायतु पाणी भर देदा। <verse eid="JHN 2:7" /><verse number="8" style="v" sid="JHN 2:8" />ईसु तीमने केदो, “हाव थोड़ुक पाणी काडीन वेवा करन्‌या डायलान्‌तां ली जावो” अने चाकर्‌या डायलान तां ली ज्‌या। <verse eid="JHN 2:8" /><verse number="9" style="v" sid="JHN 2:9" />जत्‌यार डायलो तीहयु पाणी चाख्‌यो, ते पाणी अंगुर नो रोह बण जेलु हतु, अने तीने मालम नी हतु, के तीहयो कां गेथो आवलो से, पण गोळा मे गेथु पाणी काडण्‌या पावर्‌या ने मालम हतु। ता डायलो लाडा ने बोलावीन तीने केदो। <verse eid="JHN 2:9" /><verse number="10" style="v" sid="JHN 2:10" />आखा माणहु पेले वारु अंगुर नो रोह आपे, अने जत्‌यार माणहु पीन छाक जाय, ता थोड़ोक हळको अंगुर नो रोह आपे, पण तु हजु लग वारलो अंगुर नो रोह राख रेलो। <figure style="fig" alt="Filling water in the stone jars" file="lb00135c.tif" size="col" copy="Horace Knowles ©" ref="2:7">दगड़ा ना ठाहरा मे पाणी भरे</figure><verse eid="JHN 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 2:11" />ईसु गलील ना काना ह़ेर मे पेली कावा जुदा-काम नी सेलाणी देखाड़ीन आह़फा नी बड़ाय देखाड़्‌यो। अने आहयु देखीन ईसु ना चेला भरहो कर्‌या।<verse eid="JHN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 2:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:13">मत्‌ती 4:13</ref>
      </char>
    </note>अळतेण ईसु आह़फा नी आह्‌य, अने भाय, अने आह़फा ना चेला ह़ाते कफरनहुम ह़ेर मे जत र्‌यो, अने तां थोड़ाक दाड़ा र्‌या।<verse eid="JHN 2:12" /></para>
  <para style="s">ईसु नु मंदीर मे जवु</para>
  <para style="r">(<ref loc="MAT 21:12">मत्‌ती 21:12</ref>,<ref loc="MAT 21:13">13</ref>; <ref loc="MRK 11:15-17">मरकुस 11:15-17</ref>; <ref loc="LUK 19:45">लुका 19:45</ref>,<ref loc="LUK 19:46">46</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 2:13" />युहदी माणहु नो फसह नो तीवार ह़ाते आय र्‌यो हतो। अने ईसु यरुसलेम मे ज्‌यो। <verse eid="JHN 2:13" /><verse number="14" style="v" sid="JHN 2:14" />अने तीहयो मंदीर मे बोळद्‌या, अने गाडरा अने पारवा वेचवा वाळा, अने पय्‌हा ना अदला-बदली करवा वाळा वेपार्‌या ने बह रेला देख्‌यो। <verse eid="JHN 2:14" /><verse number="15" style="v" sid="JHN 2:15" />अने तीहयो दोड़ा नो ह़ड़को बणावीन आखा गाडरा अने बोळद्‌या ने मंदीर मे गेथा बारा नीकाळ देदो, अने पय्‌हा ने खोळ्‌वी देदो, अने टेबल्‌या ने उथलाय देदो। <verse eid="JHN 2:15" /><verse number="16" style="v" sid="JHN 2:16" />अने पारवा वेचवा वाळा ने केदो, “ईमने आञे गेथा ली जावो। मारा बाह ना घोर ने हाट नु घोर ना बणावो।” <verse eid="JHN 2:16" /><verse number="17" style="v" sid="JHN 2:17" />तत्‌यार ईसु ना चेला ने फोम आयु के लीखलु से, “तारा घोर नी धुंद मने खाय जहे।”<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="PSA 69:9">भजन सहीता 69:9</ref> </char></note><verse eid="JHN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 2:18" />आहयी वात पोर युहद्‌या माणहु तीने केदा, “तु जे आहयु करे ता आमने काना जुदा-काम नी सेलाणी देखाड़?”<verse eid="JHN 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 2:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:19 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:61">मत्‌ती 26:61</ref>; <ref loc="MAT 27:40">27:40</ref>; <ref loc="MRK 14:58">मरकुस 14:58</ref>; <ref loc="MRK 15:29">15:29</ref></char>
    </note>ईसु तीमने जपाप आप्‌यो, “आहया मंदीर ने ओदार देवो, अने मे आने तीन दाड़ा मे बांद देही।”<verse eid="JHN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 2:20" />युहद्‌या माणहु केदा, “आहया मंदीर ने बणाव्‌वा चाळीह़ ने छो साल लाग जेला से, अने तु ह़ुं तीने तीन दाड़ा मे बांद देही?”<verse eid="JHN 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 2:21" />पण ईसु आह़फा ना डील ना मंदीर ना बारा मे केतो हतो। <verse eid="JHN 2:21" /><verse number="22" style="v" sid="JHN 2:22" />अने जत्‌यार तीहयो मरला मे गेथो जीवतो हय्‌न बठो हयो, ता अळी चेला ने फोम आयु के तीहयो आहयु केदलो हतो, अने तीहया चोखली सास्‌तर अने तीहया बोल पोर जे ईसु केदलो हतो, तीनी पोर भरहो कर्‌या।<verse eid="JHN 2:22" /></para>
  <para style="s">ईसु माणहु ना मन ने जाणे</para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 2:23" />जत्‌यार ईसु यरुसलेम मे फसह ना, तीवार मे हतो, ता घणात तीना जुदा-काम ने जे तीहयो करतो हतो देखीन तीना नाम पोर भरहो कर्‌या। <verse eid="JHN 2:23" /><verse number="24" style="v" sid="JHN 2:24" />पण ईसु आह़फा ने तीमना भरहा पोर नी सोड़्‌यो, काहाके तीहयो आखा ना मन ना वीच्‌यार जाणतो हतो, <verse eid="JHN 2:24" /><verse number="25" style="v" sid="JHN 2:25" />अने तीने जरवत नी हती के माणहु ना बारा मे कोय गवाय देय, काहाके तीहयो आह़फो जाणतो हतो के माणहु ना मन मे ह़ुं से?<verse eid="JHN 2:25" /></para>
  <chapter eid="JHN 2" />
  <chapter number="3" style="c" sid="JHN 3" />
  <para style="s">ईसु अने नीकुदेमुस</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 3:1" />फरीसी पंथवाळा मे नीकुदेमुस नाम नो एक माणेह हतो, तीहयो युहदी माणहु नो पुडार्‌यो हतो। <verse eid="JHN 3:1" /><verse number="2" style="v" sid="JHN 3:2" />तीहयो राते ईसुन्‌तां आयो अने ईसु ने केदो, “ए गुरु! आमु जाणये के तु भगवान वगे गेथो आवलो से, काहाके कदी भगवान ह़ाते नी हय, ता कोय बी जुदा-काम नी सेलाणी नी देखाड़ सके जीसम तु देखाड़े।”<verse eid="JHN 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 3:3" />ईसु जपाप आप्‌यो, “मे तने ह़ाचली केम, जत्‌यार लग कोय अळी पासो पयदा नी हये, तत्‌यार लग तीहयो भगवान ना राज ने नी देख सके।”<verse eid="JHN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 3:4" />नीकुदेमुस ईसु ने पुछ्‌यो, “कानो बी माणेह डायो हय्‌न पासो कीसम पयदा हय सके? ह़ुं तीहयो आह़फा नी आह्‌य ना कोख मे पासो जाय्‌न बीजी कावा पयदा हय सके?” <verse eid="JHN 3:4" /><verse number="5" style="v" sid="JHN 3:5" />ईसु जपाप आप्‌यो, “मे तने ह़ाचली केम, जत्‌यार लग कोय बी माणेह पाणी अने आत्‌मा सी पयदा नी हये, तत्‌यार लग तीहयो भगवान ना राज मे नी भराय सके। <verse eid="JHN 3:5" /><verse number="6" style="v" sid="JHN 3:6" />काहाके जे डील सी पयदा हयु, तीहयु डील से; अने जे आत्‌मा सी पयदा हयु, तीहयु आत्‌मा से। <verse eid="JHN 3:6" /><verse number="7" style="v" sid="JHN 3:7" />मे तने आहयी वात केदो, करीन वहराय ना तने आत्‌मा सी पासो पयदा हयवा जरुड़ी से। <verse eid="JHN 3:7" /><verse number="8" style="v" sid="JHN 3:8" />वाहळु जंखर जवा लागे, तींखोर जाय; अने तु तीनी अवाज ते ह़मळे, पण तीहयु कां गेथु आयु अने कां जाय, तीहयु तने मालम नी पड़े। जे कोय आत्‌मा मे पयदा हयला से, तीहया आहयु वाहळुन तेमेत से।”<verse eid="JHN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 3:9" />नीकुदेमुस ईसु ने केदो, “आहयु आसम कीसम हय सके।”<verse eid="JHN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 3:10" />आहयी वात ह़मळीन ईसु तीने केदो, “तु ईस्‌रायली माणहु नो गुरु” हय्‌न बी आहयी वात ने नी ह़मजतो। <verse eid="JHN 3:10" /><verse number="11" style="v" sid="JHN 3:11" />मे तने ह़ाचली केम, आमु जे जाणया, तीहयुत कीया, अने जीने आमु देख्‌या तीनीत गवाय दीया, पण तमु अमारी गवाय ने नी मान्‌ता। <verse eid="JHN 3:11" /><verse number="12" style="v" sid="JHN 3:12" />मे तमने धरती पोर नी वात देखाड़्‌यो, ते बी तमु भरहो नी करता, कदी मे तमने ह़रगे वाळी वात देखाड़ही, ता तमु कीसम भरहो करहु? <verse eid="JHN 3:12" /><verse number="13" style="v" sid="JHN 3:13" />अने कोय ह़रग पोर नी चड़्‌यु, जे माणेह नो बेटो बणीन ह़रगे गेथो धरती पोर आवलो से, तीहयो एतरोत ह़रग मे चड़लो से।<verse eid="JHN 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 3:14" />अने जीसम मुसो उजाड़ी बड़ा मे गड़हा नी मुर्‌ती बणाय्‌न लाकड़ा ना खम्‌बा पोर चड़ावलो, तीसमेत माणेह ना बेटा ने बी उपर चड़ाय्‌न टांगहे अने आसम हयवा जरुड़ी से। <verse eid="JHN 3:14" /><verse number="15" style="v" sid="JHN 3:15" />काहाके जे कोय ईसु पोर भरहो करहे, तीहयो अमर जीवाय हात करहे।<verse eid="JHN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 3:16" />भगवान आहयी कळी सी एतरो मोंग कर्‌यो, के तीना एक-खोळ्‌या बेटा ने आप देदो के, जे कोय तीनी पोर भरहो करे, तीहयो बरबात नी हये, पण अमर जीवाय हात करहे। <verse eid="JHN 3:16" /><verse number="17" style="v" sid="JHN 3:17" />भगवान आह़फा ना बेटा ने कळी मे आनी लेदे नी मोकल्‌यो, के कळी पोर डंड नो हुकम आपे, पण आनी लेदे के कळी तीनी लारे बचे।<verse eid="JHN 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 3:18" />जे ईसु पोर भरहो करे, तीनी पोर डंड नो हुकम नी हय, पण जे ईसु पोर भरहो नी करे, तीहयो गुनाळ्‌ळो गणाय जेलो से, आनीन करते के तीहयो भगवान ना एक-खोळ्‌या बेटा ना नाम पोर भरहो नी कर्‌यो। <verse eid="JHN 3:18" /><verse number="19" style="v" sid="JHN 3:19" />अने डंड ना हुकम नो कारण आहयो से के वीजाळु कळी मे आयु, अने माणहु वीजाळु गेथा अंदारलु ने जादा मोंग कर्‌या काहाके तीना काम बुरा हता। <verse eid="JHN 3:19" /><verse number="20" style="v" sid="JHN 3:20" />काहाके जे कोय बुराय करे, तीहयो वीजाळा सी वेर राखे, अने आह़फा ना कुहर्‌या कामु उजन्‌ता हय जहे, करीन तीहयो वीजाळा मे नी आवे। <verse eid="JHN 3:20" /><verse number="21" style="v" sid="JHN 3:21" />पण जे कोय खराय सी चाले, तीहयो वीजाळु ह़ाते आवे, काहाके तीना काम उजन्‌ता हये के मे भगवान नी वखे हय जाम।<verse eid="JHN 3:21" /></para>
  <para style="s">ईसु ना बारा मे युहन्‌ना नी गवाय</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 3:22" />अळतेण ईसु अने तीना चेला युहद्‌या देस मे आया, अने तीहयो तीमनी ह़ाते रीन बपतीस्‌मा आपवा लाग्‌यो। <verse eid="JHN 3:22" /><verse number="23" style="v" sid="JHN 3:23" />अने युहन्‌नो बी सालेम ना ह़ाते एनोन मे बपतीस्‌मा आपतो हतो, काहाके तां घणु पाणी हतु, अने माणहु आय्‌न बपतीस्‌मा लेता हता। <verse eid="JHN 3:23" /><verse number="24" style="v" sid="JHN 3:24" /><note caller="+" style="x"><char style="xo" closed="false">3:24 </char><char style="xt" closed="false"><ref loc="MAT 14:3">मत्‌ती 14:3</ref>; <ref loc="MRK 6:17">मरकुस 6:17</ref>; <ref loc="LUK 3:19">लुका 3:19</ref>,<ref loc="LUK 3:20">20</ref></char></note>काहाके युहन्‌नो तीहयी टेम लग जेल मे नी ज्‌यो।<verse eid="JHN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 3:25" />तां युहन्‌ना ना चेला काना युहदी माणहु ह़ाते चोखा हयवा नी रीती ना बारा मे जखड़ी पड़ ज्‌या। <verse eid="JHN 3:25" /><verse number="26" style="v" sid="JHN 3:26" />अने तीहया युहन्‌नान तां आय्‌न तीने केदा, ए गुरु, जे माणेह यरदन नंदी नी ह़ेली धेड़ तारी ह़ाते हतो, अने जीनी तु गवाय देदलो, तीहयो बपतीस्‌मा आपे, अने आखा तीनीन्‌तां आवे।<verse eid="JHN 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 3:27" />युहन्‌नो केदो, जत्‌यार लग माणेह ने ह़रग मे गेथु नी आपे, ता लग तीहयो कंय बी नी ली सके। <verse eid="JHN 3:27" /><verse number="28" style="v" sid="JHN 3:28" /><note caller="+" style="x"><char style="xo" closed="false">3:28 </char><char style="xt" closed="false"><ref loc="JHN 1:20">युहन्‌ना 1:20</ref></char></note>तमु ते खुदेत मारा गवा से, के मेत केदो, मे मसी नी हय, पण तीनी अगळ मोकलो से। <verse eid="JHN 3:28" /><verse number="29" style="v" sid="JHN 3:29" />जीनी नवली लाडी से, तीहयोत नवलो लाडो से, पण नवला लाडा नो खास दोस्‌तीदार से जे तीनी ह़ाते उबो हय र्‌यो तीहयो तीनी ह़मळे, अने नवला लाडा ना बोल सी घणो खुस हये, तीसम हाव मारी खुसी पुरी हय जी। <verse eid="JHN 3:29" /><verse number="30" style="v" sid="JHN 3:30" />आसम हयवा जरुड़ी से के तीहयो बड़े अने मे घटु।<verse eid="JHN 3:30" /></para>
  <para style="s">तीहया जे ह़रगे गेथो उतर्‌यो</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 3:31" />जे उपर गेथो आवे तीहयो आखा मे गेथो मोट्‌लो से, पण जे धरती पोर गेथु आवे, तीहयु धरती नु से, अने धरती नी वात केय, जे ह़रग मे गेथु आवे, तीहयु आखु सी उपर से। <verse eid="JHN 3:31" /><verse number="32" style="v" sid="JHN 3:32" />जे कंय तीहयो देख्‌यो, अने ह़मळ्‌यो, तीनीत गवाय देय, पण कोय तीनी गवाय ने नी मान्‌ता। <verse eid="JHN 3:32" /><verse number="33" style="v" sid="JHN 3:33" />जे कोय तीनी गवाय ने मान लेदा तीहया आहयी वात पोर गवा दी र्‌या के भगवान खरलो से। <verse eid="JHN 3:33" /><verse number="34" style="v" sid="JHN 3:34" />काहाके जीने भगवान मोकल्‌लो से, तीहयो भगवान नी वात केय, काहाके तीहयो आत्‌मा मापी-मापीन नी आवतलो। <verse eid="JHN 3:34" /><verse number="35" style="v" sid="JHN 3:35" /><note caller="+" style="x"><char style="xo" closed="false">3:35 </char><char style="xt" closed="false"><ref loc="MAT 11:27">मत्‌ती 11:27</ref>; <ref loc="LUK 10:22">लुका 10:22</ref></char></note>बाह आह़फा ना बेटा ने मोंग करे, अने तीहयो आह़फा ना बेटा ना हात मे आखो हक आप देदलो से। <verse eid="JHN 3:35" /><verse number="36" style="v" sid="JHN 3:36" />बेटा ईसु पोर भरहो करे, अमर जीवाय तीनीत से; पण जे ईसु ने नी माने तीने अमर जीवाय कदी नी जड़े, पण भगवान नी रीह तीनी पोर रेहे।<verse eid="JHN 3:36" /></para>
  <chapter eid="JHN 3" />
  <chapter number="4" style="c" sid="JHN 4" />
  <para style="s">ईसु सामरी बयर ह़ाते भगवान नी वात करे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 4:1" />जत्‌यार मालीक ने मालम हयु, के फरीसी पंथवाळा आहयु ह़मळ्‌या, के ईसु युहन्‌ना गेथो वदु चेला बणावे अने तीमने बपतीस्‌मा आपे। <verse eid="JHN 4:1" /><verse number="2" style="v" sid="JHN 4:2" />ईसु आह़फोत बपतीस्‌मा नी आपत्‌लो, पण तीना चेला बपतीस्‌मा आपत्‌ला। <verse eid="JHN 4:2" /><verse number="3" style="v" sid="JHN 4:3" />तत्‌यार तीहयो युहद्‌या जीला ने सोड़ीन गलील मे जत र्‌यो। <verse eid="JHN 4:3" /><verse number="4" style="v" sid="JHN 4:4" />अने ईसु ने सामर्‌या हय्‌न जवा नु जरुड़ी हतु।<verse eid="JHN 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 4:5" />एतरे ईसु सामर्‌या जीला ना सुखार नाम ना एक ह़ेर धेड़्‌ये पुग्‌यो। तां एक खेतर हतु, तीहयु खेतर पेल्‌ना वारा मे याकुब आह़फा ना बेटा युसुफ ने आपलो हतो। <verse eid="JHN 4:5" /><verse number="6" style="v" sid="JHN 4:6" />अने याकुब नो कुवो बी तां हतो, ईसु वाट्‌ये चालीन थाकलो तीहया कुवा पोर उदड़ेत बह ज्‌यो, अने आहयी वात तोपीवळे नी टेम मे हयी।<verse eid="JHN 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 4:7" />एक सामरी बयर पाणी भरवा करीन आयी, तीने ईसु केदो, “मने पाणी पीवाड़ दे।” <verse eid="JHN 4:7" /><verse number="8" style="v" sid="JHN 4:8" />काहाके तीना चेला खाणु लेवा करीन ह़ेर मे जत रेला हता।<verse eid="JHN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 4:9" />एतरे तीहयी सामरी बयर ईसु ने केदी, तु युहदी जाती वाळो हय्‌न बी मारी पांह पाणी पीवा करीन काहा मांगे? मे ते एक सामरी जाती नी बयर से काहाके युहदी माणहु सामरी माणहु ह़ाते भेद-भाव राखे।<verse eid="JHN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 4:10" />ईसु तीने जपाप आप्‌यो, “तु आहयु नी जाणती के भगवान तने कानो वाटो आपवा हींडे, अने जे तारी पांह पीवा करीन पाणी मांग र्‌यो, तीहयो कोय से। कदी तु जाण लेती ता तु मार पांह पाणी मांगती, अने मे तने अमर जीवाय नु पाणी आपतो।”<verse eid="JHN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 4:11" />सामरी बयर ईसु ने केदी, “ए मालीक! तारी पांह कुवा मे गेथु पाणी काडवा नी लेदे ठाहरु बी नी हय, अने कुवो घणो उंडो से ता अळी तीहयु अमर जीवाय नु पाणी कां गेथु लावही? <verse eid="JHN 4:11" /><verse number="12" style="v" sid="JHN 4:12" />तु अमारा बाह याकुब गेथो बी मोटो से ह़ु? तीहयो आमने आहयो कुवो आप्‌यो; तीहयो आह़फो बी अने तीना अवल्‌यात अने तीना पाळ्‌ळा ढुरु बी आहया कुवा मे गेथु पाणी पीदला।”<verse eid="JHN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 4:13" />ईसु केदो, “जे कोय आहयु पाणी ने पीहे, तीने अळी तरहे लागहे। <verse eid="JHN 4:13" /><verse number="14" style="v" sid="JHN 4:14" />बाखीन मे आपही ते पाणी जे बी पीहे, तीने कदी तरहे नी लागे एतरुत नी पण तीहयु पाणी तीनी जीवाय मे पाणीन झोर बण जहे, अने तीनी अमरकाय जीवाय जुगु वयतु रेहे।”<verse eid="JHN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 4:15" />सामरी बयर ईसु ने केदी, “ए मालीक! मने तीहयु पाणी आप दे, ता मने वळ-वळीन तरहे नी लागे, अने मने आतरा नाम्‌बे पाणी भरवा नी आव्‌वा पड़े।” <verse eid="JHN 4:15" /><verse number="16" style="v" sid="JHN 4:16" />ईसु तीने केदो, “जा तारा धणी ने आञे बोलाय लाव।”<verse eid="JHN 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 4:17" />तीहयी बयर जपाप आपी, “मारो धणी नी हय।” ईसु तीने केदो, “तु ह़ाची की री के मारो धणी नी हय। <verse eid="JHN 4:17" /><verse number="18" style="v" sid="JHN 4:18" />काहाके तु पांच लाडा कर लेदली से, अने हाव तु जीनीन तां री, री तीहयो बी तारो धणी नी हय; तु आहयी वात ह़ाचली की री।”<verse eid="JHN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 4:19" />तीहयी बयर ईसु ने केदी, “मने लागे के तु भगवान वगे गेथी वात केण्‌यो से।” <verse eid="JHN 4:19" /><verse number="20" style="v" sid="JHN 4:20" />अमारा डाह-डाहा आहया बड़ा पोर भगवान नी पुजा-पाट कर्‌या, पण युहदी माणहु केय के भगवान नी पुजा-पाट नो जागो यरुसलेम मेत से।<verse eid="JHN 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 4:21" />ईसु तीने केदो, “ओ बाय जात! मारी आहयी वात पोर भरहो कर आसवी टेम आव्‌वा बाज री, तीहयी टेमे तमु नी ते बड़ा पोर, अने नी ते यरुसलेम मे भगवान बाह नी पुजा-पाट करहु। <verse eid="JHN 4:21" /><verse number="22" style="v" sid="JHN 4:22" />तमु जीने नी जाणता तीनी पुजा-पाट कर र्‌या, पण आमु ते जीने जाणये तीनीत पुजा-पाट कर र्‌या, काहाके छुटकारो युहदी जाती वाळा मसी मे गेथोत से। <verse eid="JHN 4:22" /><verse number="23" style="v" sid="JHN 4:23" />पण तीहयी टेम आव्‌वा बाज री, अने हमणे आय लागली से, जे टेमे भगवान नी पुजा-पाट करन्‌या आत्‌मा मे अने खराय सी करहे, काहाके भगवान बाह बी आसवी पुजा-पाट करन्‌या ने ह़ोद र्‌यो। <verse eid="JHN 4:23" /><verse number="24" style="v" sid="JHN 4:24" />भगवान आत्‌मा से; अने जरुड़ी से के तीनी पुजा-पाट करन्‌या ने तीनी आत्‌मा अने सच्‌चाय मे हय्‌न तीनी पुजा-पाट करवा जोवे।”<verse eid="JHN 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 4:25" />बयर ईसु ने केदी, “मने मालम से के, मसी जे मसी केवाय तीहयो आव्‌वा वाळो से जत्‌यार तीहयो आवहे, तत्‌यार आमने आखी वात देखाड़ देहे।” <verse eid="JHN 4:25" /><verse number="26" style="v" sid="JHN 4:26" />ईसु तीने केदो, “मेत मसी से, जे तारी ह़ाते वात करवा बाज र्‌यो।”<verse eid="JHN 4:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 4:27" />तीहयी टेमे ईसु ना चेला आय लाग्‌या, अने ईसु ने एक बयर ह़ाते वात करत्‌लो देखीन वीच्‌यार मे पड़ ज्‌या; ते बी कोय नी केदु के तने आनी पांह ह़ु जोवे “नीता तु आनी ह़ाते ह़ु वात कर र्‌यो।”<verse eid="JHN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 4:28" />तत्‌यार तीहयी बयर आह़फी नो वटळो तांत रेवा दीन ह़ेर मे जाय्‌न माणहु ने आहयु केवा बाज जी, <verse eid="JHN 4:28" /><verse number="29" style="v" sid="JHN 4:29" />“चालो एक माणेह ने देखो, तीहयो मे जे करली तीहयु आखु देखाड़ देदो; कंखर माय्‌न हीय्‌योत मसी नी हय?” <verse eid="JHN 4:29" /><verse number="30" style="v" sid="JHN 4:30" />तत्‌यार तीहया ह़ेर मे गेथा नीकळीन तीनीन्‌तां आव्‌वा बाज ज्‌या।<verse eid="JHN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 4:31" />तीहयी टेमे तीना चेला ईसु सी वीन्‌ती करता हता के, “ए गुरु थोड़ुक खाय ले।”<verse eid="JHN 4:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 4:32" />पण ईसु तीमने केदो, “मारी पांह खावा जुगु एवु खाणु से तीने तमु नी जाणो।”<verse eid="JHN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 4:33" />तत्‌यार चेला आह़फा-आह़फात केदा, “कोय आनी जुगु खाणु लायु हहे ह़ुं?”<verse eid="JHN 4:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 4:34" />ईसु तीमने केदो, “मारु खाणु आहयु से के मने मोकल्‌वा वाळा नी मरजीन अनसारे चालु अने तीनु काम पुरु करु। <verse eid="JHN 4:34" /><verse number="35" style="v" sid="JHN 4:35" />तमु ते आसम केता आय र्‌या, मेर पाकवा मे हजु च्‌यार मयना बच र्‌या, पण मे तमने केम, उचा डोळा करीन खेतरु भणी भाळो, आहयी खेतरु नी मेर पाकीन वाडे ईसम हय री। <verse eid="JHN 4:35" /><verse number="36" style="v" sid="JHN 4:36" />अने वाडवा वाळा ने दाड़की जड़े, अने अमर जीवाय जुगु फोळ एखठा करे, काहाके बीज वेरन्‌यो अने मेर वाडण्‌यो भेळा हय्‌न खुसी मनावे। <verse eid="JHN 4:36" /><verse number="37" style="v" sid="JHN 4:37" />काहाके आनी पोर आहयो कवाड़ो वारु मेळ खाय के ओरवा वाळो बीजो से, अने वाडवा वाळो बीजो से। <verse eid="JHN 4:37" /><verse number="38" style="v" sid="JHN 4:38" />मे तमने तीहया खेतर नी मेर वाडवा करीन मोकल्‌लो से, जीनी मे तमु मेहनत नी कर्‌या, बीजा मेहनत कर्‌या अने तमु तीमनी मेहनत नी मेर मे साजल्‌या बण ज्‌या।”<verse eid="JHN 4:38" /></para>
  <para style="s">सामर्‌या माणहु नु भरहो करणु</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 4:39" />तीहयी सामरी बयर ईसु ना बारा मे आहयी गवाय देदली, “के तीहयो मे जे करली तीहयु आखु मने देखाड़ देदो।” एतरे तीहया सामर्‌या ह़ेर ना ढेरेत माणहु ते बयर नी गवाय ह़मळीन ईसु पोर भरहो कर्‌या। <verse eid="JHN 4:39" /><verse number="40" style="v" sid="JHN 4:40" />एतरे सामरी माणहु ईसुन्‌तां आया, अने तीनी सी वीन्‌ती कर्‌या के तु अमारीन्‌तां रे। एतरे ईसु चेला ह़ाते तीमनीन्‌तां बे दाड़ा लग र्‌यो।<verse eid="JHN 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 4:41" />अने ईसु नी वात ह़मळीन ढेरेत बीजा माणहु बी ईसु पोर भरहो कर्‌या। <verse eid="JHN 4:41" /><verse number="42" style="v" sid="JHN 4:42" />तीहया ते बयर ने केदा, “हाव आमु तारा केवा सी भरहो नी करता, काहाके आमुत ह़मळी लेदा, अने जाण लेदा के आहयोत ह़ाचली मे कळी ने छुटकारो आपण्‌यो से।”<verse eid="JHN 4:42" /></para>
  <para style="s">ईसु नु अदीकारी ना सोरा ने आरगो करवु</para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 4:43" />तीहया बे दाड़ान अळतेण ईसु चेला ह़ाते तां गेथो गलील मे जत र्‌यो। <verse eid="JHN 4:43" /><verse number="44" style="v" sid="JHN 4:44" /><note caller="+" style="x"><char style="xo" closed="false">4:44 </char><char style="xt" closed="false"><ref loc="MAT 13:57">मत्‌ती 13:57</ref>; <ref loc="MRK 6:4">मरकुस 6:4</ref>; <ref loc="LUK 4:24">लुका 4:24</ref></char></note>ईसु आह़फोत आहयी गवाय देदलो हतो के, जे बी भगवान वगे गेथो खबर लावण्‌यो से, तीने आह़फा ना देस मे ईज्‌जत नी जड़े। <verse eid="JHN 4:44" /><verse number="45" style="v" sid="JHN 4:45" /><note caller="+" style="x"><char style="xo" closed="false">4:45 </char><char style="xt" closed="false"><ref loc="JHN 2:23">युहन्‌ना 2:23</ref></char></note>जत्‌यार ईसु गलील मे आयो ता गलील ना माणहु तीने खुसी सी मळ्‌या; काहाके जेतरा जुदा-काम तीहयो यरुसलेम मे तीवार नी टेमे करलो तीहया ते आखा कामु ने देखला हता, काहाके तीहया बी तीवार मे जेला हता।<verse eid="JHN 4:45" /></para>
  <para style="s">राजवाड़ा मे काम करवा वाळा ना सोरा ने वारु करनु</para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 4:46" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:46 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 2:1-11">युहन्‌ना 2:1-11</ref>
      </char>
    </note>तत्‌यार तीहयो अळी गलील ना काना ह़ेर मे आयो, जां तीहयो पाणी ने अंगुर नो रोह बणावलो हतो। अने राजा नो एक पावोर हतो, तीनो सोरो कफरनहुम ह़ेर मे मांदलो हतो। <verse eid="JHN 4:46" /><verse number="47" style="v" sid="JHN 4:47" />जत्‌यार राजा नो पावर्‌यो आहयु ह़मळ्‌यो के ईसु युहद्‌या मे गेथो गलील मे आय र्‌यो, तत्‌यार तीहयो ईसुन्‌तां जाय्‌न तीनी सी वीन्‌ती कर्‌यो के आवीन मारा सोरा ने आरगो कर दे, काहाके तीहयो मरवा पोर हतो। <verse eid="JHN 4:47" /><verse number="48" style="v" sid="JHN 4:48" />ईसु गलील वाळा नो कमतो भरहो देखीन तीने केदो, “तमु ते जुदा-काम नी सेलाणी देख्‌या वगर मार पोर भरहो नी करो।”<verse eid="JHN 4:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 4:49" />राजा नो पावर्‌यो ईसु ने केदो, “ए मालीक, मारा सोरा ने मरवा सी पेले चाल।”<verse eid="JHN 4:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 4:50" />ईसु राजा ना पावर्‌या ने केदो, “जा तारो सोरो जीवत्‌लो से। तीहयो ईसु नी वात पोर भरहो करीन जत र्‌यो।” <verse eid="JHN 4:50" /><verse number="51" style="v" sid="JHN 4:51" />तीहयो वाट्‌येत हतो, ता तीना पावर्‌या आवीन तीने भेट्‌या अने केदा, “तारो सोरो जीवत्‌लो से।”<verse eid="JHN 4:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 4:52" />तीहयो तीमने पुछ्‌यो कानी टेमे मार सोरो वारु हयवा बाज जेलो? तीहया केदा, “काले दीह़ु एक बजे तीनो ताव उतरी जेलो।” <verse eid="JHN 4:52" /><verse number="53" style="v" sid="JHN 4:53" />तत्‌यार तीनो बाह जाण ज्‌यो के आहयु तीहयी टेमे हयु जत्‌यार ईसु मने केदलो, “जा तारो सोरो जीवत्‌लो से।” आसम करीन तीहयो अने तीना आखा घोरल्‌या ईसु पोर भरहो कर्‌या।<verse eid="JHN 4:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 4:54" />ईसु नी गलील मे आहयी बीजी सेलाणी हती। ईसु युहद्‌या गेथो आवीन गलील मे देखाड़्‌या।<verse eid="JHN 4:54" /></para>
  <chapter eid="JHN 4" />
  <chapter number="5" style="c" sid="JHN 5" />
  <para style="s">अड़तीस साल ना मांदला नु आरगु करनु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 5:1" />अळतेण युहदी माणहु नो तीवार आयो, एतरे ईसु यरुसलेम ह़ेर अळी ज्‌यो। <verse eid="JHN 5:1" /><verse number="2" style="v" sid="JHN 5:2" />यरुसलेम मे गाडरा नु झापलु हतु, ते झापला धेड़े एक हळाव हतो, जे ईब्‌रानी भासा मे बेतसेदा केवात्‌लो, अने तीनी धेड़े पांच मांडवा हता। <verse eid="JHN 5:2" /><verse number="3" style="v" sid="JHN 5:3" />तीहया मांडवा मे घणा ढेरका मांदला, आंदळा, लंगड़ा, पांगळा पड़ रेता हता अने तीहया वारु हयवा नी आह करीन पाणी हीलवा नी वाट जोय रेता हता। <verse eid="JHN 5:3" /><verse number="4" style="v" sid="JHN 5:4" />काहाके टेम-टेम पोर भगवान ना ह़रगदुत हळावा मे उतरीन पाणी ने हीलाया करता हता, पाणी हीलावतेत जे बी मांदलु माणेह पाणी मे पेले उतर जतु हतु तीहयु आरगु हय जतु हतु, चाहे तीनी कानी बी मंदवाड़ काहा नी हय। <verse eid="JHN 5:4" /><verse number="5" style="v" sid="JHN 5:5" />तां एक माणेह हतो, जे तीस ने आंठ साल नो मंदवाड़ मे पड़लो हतो। <verse eid="JHN 5:5" /><verse number="6" style="v" sid="JHN 5:6" />ईसु तीने तां पड़ रेलो देख्‌यो, अने आहयु जाणीन के आहयो, घणा दाड़ा सी आसमेत पड़ र्‌यो, तीने पुछ्‌यो, “तु वारु हयवा हींड र्‌यो ह़ुं?”<verse eid="JHN 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 5:7" />तीहयो मांदलो तीने केदो, “ए मालीक, मारी ह़ाते कोय माणेह नी हय, जत्‌यार पाणी हीलावे, ता मने हळावा मे उतारे। पण मने पुगते-पुगते पेले हळाव मे बीजो उतरी पड़े।”<verse eid="JHN 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 5:8" />ईसु तीने केदो, “उठ, अने तारी खाटली उचलीन चाल-फीर।” <verse eid="JHN 5:8" /><verse number="9" style="v" sid="JHN 5:9" />तीहयो माणेह तत्‌यारुत आरगो हय ज्‌यो, अने आह़फा नी खाटली उचलीन चालवा-फीरवा लाग्‌यो। तीहयो आरगो हयो ते दाड़ो अराम नो हतो। <verse eid="JHN 5:9" /><verse number="10" style="v" sid="JHN 5:10" />तीहयो दाड़ो अराम नो हतो, एतरे युहदी माणहु जे आरगो हयो हतो तीने केवा बाज ज्‌या के आज तने खाटली उचलवा ताले नी हय।<verse eid="JHN 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 5:11" />तीहयो तीमने केदो, “जे मने आरगो करलो से, तीहयो मने केदलो से, तारी खाटली उचलीन चाल-फीर।”<verse eid="JHN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 5:12" />तीहया तीने पुछ्‌या, “तीहयो कोय से, जे तने आहयु केदो, खाटली उचलीन चाल-फीर?”<verse eid="JHN 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 5:13" />पण जे आरगो हयलो हतो तीहयो नी जाणतो हतो के तीहयो कोय से, काहाके तीहया जागा मे भीड़ हयवा सी ईसु तां गेथो जत रेलो हतो।<verse eid="JHN 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 5:14" />अळतेण ईसु जे आरगो हयलो हतो तीने मंदीर मे भेट्‌यो, ता ईसु तीने केदो, “देख तु आरगो हय जेलो से, अळी पाप नी करजे। नीता आनी गेथी बी वदु गरा तार पोर आय पड़े।”<verse eid="JHN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 5:15" />तीहयो माणेह जाय्‌न युहदी माणहु ने की देदो, के “जे मने आरगो करलो तीहयो ईसु से।” <verse eid="JHN 5:15" /><verse number="16" style="v" sid="JHN 5:16" />ईसु अराम ना दाड़े एवा-एवा काम करतो हतो, करीन युहदी माणहु ईसु ने वेला पाड़वा बाज ज्‌या। <verse eid="JHN 5:16" /><verse number="17" style="v" sid="JHN 5:17" />पण ईसु तीमने आहयु केदो, “मारो बाह हजु लग काम कर र्‌यो, एतरे मे बी काम कर र्‌यो।”<verse eid="JHN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 5:18" />ईसु अराम ना दाड़ा नो कायदो तोड़े, अने भगवान ने मारो बाह कीन खुद ने भगवान बराबर देखाड़े, करीन युहदी माणहु हीने मार नाक्‌खु करीन वदु कोसीत करवा बाज ज्‌या अने मोखो ह़ोदवा लाग्‌या।<verse eid="JHN 5:18" /></para>
  <para style="s">बेटा नो हक</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 5:19" />ईसु तीमने केदो, मे तमने ह़ाचली केम, बेटो आह़फा ना मन सी कंय बी नी कर सके, पण तीहयुत कर सके, तीना बाह ने करत्‌ले देख्‌यो हय; काहाके जे-जे काम तीनो बाह करे तीहयु काम तीनो बेटो बी तीहयीत रीते करे। <verse eid="JHN 5:19" /><verse number="20" style="v" sid="JHN 5:20" />काहाके बाह बेटा सी मोंग करे, अने जे-जे काम तीहयो करे, तीहया आखा काम तीने देखाड़े; अने तीहयो आनी सी बी मोटा काम देखाड़हे, काहाके तमु काम देखीन वहराया करो। <verse eid="JHN 5:20" /><verse number="21" style="v" sid="JHN 5:21" />काहाके जेम बाह मर्‌या-ह़र्‌या मे गेथा जीवाड़े, अने उठाड़े, तेमेत बेटा पांह बी जीवता अने बठा करवा नो हक से। <verse eid="JHN 5:21" /><verse number="22" style="v" sid="JHN 5:22" />अने बाह हाव कोयनो बी नीयाव नी करे, पण हाव माणहु नो नीयाव करवा नो आखो हक तीना बेटा ने ह़ोप देदलो से। <verse eid="JHN 5:22" /><verse number="23" style="v" sid="JHN 5:23" />एतरे के जीसम बाह नी ईज्‌जत करे तेमेत आखा माणहु तीना बेटा नी बी ईज्‌जत करे, जे बेटा नी ईज्‌जत नी करे, तीहयो बेटा ने मोकलन्‌या बाह नी बी ईज्‌जत नी करे।<verse eid="JHN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 5:24" />मे तमने ह़ाचली आहयु केम जे मारा बोलु ह़मळीन मने मोकलन्‌या बाह पोर भरहो करे, ता अमर जीवाय तीनी से, अने तीनी पोर डंड नो हुकम नी हय पण तीहयो मोत ने सेकीन अमर जीवाय हात कर लेदलो से। <verse eid="JHN 5:24" /><verse number="25" style="v" sid="JHN 5:25" />मे तमने ह़ाची-ह़ाची केम, तीहयी टेम आव्‌वा बाज री, अने हमणे से, जे टेम मे मरला भगवान ना बेटा नो बोल ह़मळहे, अने जे ह़मळहे तीहया जीवहे। <verse eid="JHN 5:25" /><verse number="26" style="v" sid="JHN 5:26" />काहाके जे रीते बाह आह़फा मे जीवाय राखे, तीहयीत रीते तीना बेटा ने बी आहयो हक आपलो से के आह़फा मे जीवाय राखे, <verse eid="JHN 5:26" /><verse number="27" style="v" sid="JHN 5:27" />मतलब तीने नीयाव करवा नो बी हक आपलो से, एतरे के तीहयो माणेह नो बेटो से। <verse eid="JHN 5:27" /><verse number="28" style="v" sid="JHN 5:28" />आनी सी ना वहराय, काहाके तीहयी टेम आव्‌वा बाज री, के जेतरा बी मड़ाट्‌या मे डाट्‌ला से तीहया आखा तीनो बोल ह़मळीन जीवता हय जहे अने नीकळी आवहे। <verse eid="JHN 5:28" /><verse number="29" style="v" sid="JHN 5:29" />जे भलाय करला से, तीहया अमर जीवाय जुगु मरला मे गेथा जीवता हयहे अने जे कुहराय करला से, तीहया नीयाव ना दाड़े डंड भुगतवा करीन मरला मे गेथा जीवता हय जहे।<verse eid="JHN 5:29" /></para>
  <para style="s">ईसु ना बारा मे गवाय</para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 5:30" />मे खुद कंय नी कर सकतो, जीसम मे ह़मळु, तीसम नीयाव करु, अने मारो नीयाव खरलो से, काहाके मे मारी मरजी नी, पण मने मोकलवा वाळा नी मरजी चाहत्‌लो।<verse eid="JHN 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 5:31" />कदी मे मारा बारा मे एतरोत गवाय देम ता मारी गवाय खरली नी हय। <verse eid="JHN 5:31" /><verse number="32" style="v" sid="JHN 5:32" />पण मारी वगे गवा देण्‌यो एक अळी से, तीहयो मारो ह़रगे वाळो बाह से अने तीनी गवाय खरली से। <verse eid="JHN 5:32" /><verse number="33" style="v" sid="JHN 5:33" /><note caller="+" style="x"><char style="xo" closed="false">5:33 </char><char style="xt" closed="false"><ref loc="JHN 1:19-27">युहन्‌ना 1:19-27</ref>; <ref loc="JHN 3:27-30">3:27-30</ref></char></note>तमु युहन्‌ना बपतीस्‌मा आपण्‌या सी पुसाड़्‌या अने तीहयो मारा बारा मे खरली गवाय देदो। <verse eid="JHN 5:33" /><verse number="34" style="v" sid="JHN 5:34" />पण मे मारा बारा मे माणहु नी गवाय नी चाहतो, अळी बी मे आहयी वात आनी लेदे केदो, के तमु बी बचे। <verse eid="JHN 5:34" /><verse number="35" style="v" sid="JHN 5:35" />युहन्‌नो ते धपतलो अने भबळन्‌यो दीवो हतो, अने तमने थोड़ीक वार लग तीना वीजाळा मे, खुसी मनाव्‌वा वारु लाग्‌यु। <verse eid="JHN 5:35" /><verse number="36" style="v" sid="JHN 5:36" />पण युहन्‌नो मारा बारा मे जे गवाय देदलो, तीनी गेथी मोटी गवाय मारी पांह से, काहाके जे काम बाह मने करवा करीन मोकल्‌लो से, तीहया काम मे करवा बाज र्‌यो अने तीहया काम मारा गवा से, के मारो बाह मने मोकल्‌लो से। <verse eid="JHN 5:36" /><verse number="37" style="v" sid="JHN 5:37" /><note caller="+" style="x"><char style="xo" closed="false">5:37 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्‌ती 3:17</ref>; <ref loc="MRK 1:11">मरकुस 1:11</ref>; <ref loc="LUK 3:22">लुका 3:22</ref></char></note>अने बाह जे मने मोकल्‌लो से, तीहयो मारी गवाय दी र्‌यो, तमु तीनी वात नी ह़मळ्‌या, अने तीनो वेह नी देख्‌या। <verse eid="JHN 5:37" /><verse number="38" style="v" sid="JHN 5:38" />अने तीना बोल आपणा मन मे जापते नी मेल्‌या, काहाके जीने तीहयो मोकल्‌लो तीनी पोर भरहो नी करता। <verse eid="JHN 5:38" /><verse number="39" style="v" sid="JHN 5:39" />तमु खरला सास्‌तर मे ह़ोदवा बाज र्‌या, काहाके तमु ह़मजी र्‌या के सास्‌तर मे गेथी अमर जीवाय जड़त्‌ली से, अने आहयी सास्‌तर मारा बारा मे गवाय दी री। <verse eid="JHN 5:39" /><verse number="40" style="v" sid="JHN 5:40" />ते बी तमु जीवाय ने लेवा करीन मारीन्‌तां आव्‌वा नी हंडता।<verse eid="JHN 5:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 5:41" />मने माणहु पांह गेथी ईज्‌जत नी जोवती। <verse eid="JHN 5:41" /><verse number="42" style="v" sid="JHN 5:42" />पण मने मालम से के तमारी मे भगवान नो मोंग नी हय। <verse eid="JHN 5:42" /><verse number="43" style="v" sid="JHN 5:43" />मे मारा भगवान बाह ना नाम सी आवलो से, अने तमु मने नी मान्‌ता पण कोय बीजो आह़फा ना नाम सी आवतो, ता तमु तीने मान लेता। <verse eid="JHN 5:43" /><verse number="44" style="v" sid="JHN 5:44" />तमु जे एक-बीजा सी ईज्‌जत ह़ोद र्‌या अने आहयी ईज्‌जत जे एक जणा भगवान भणी गेथी से, नी ह़ोद्‌ता, के कीसम भरहो करहे? <verse eid="JHN 5:44" /><verse number="45" style="v" sid="JHN 5:45" />आहयु ना ह़मजो के मे बाह अगळ तमारी पोर गुनो लगाड़ही, तमारी पोर गुनो लगाड़न्‌यो मे नी हय पण मुसो से जीनी पोर तमु आह राख र्‌या। <verse eid="JHN 5:45" /><verse number="46" style="v" sid="JHN 5:46" />काहाके कदी तमु मुसा पोर भरहो करता, ता मार पोर बी भरहो करता काहाके तीहयो मारा बारा मे लीखलो से। <verse eid="JHN 5:46" /><verse number="47" style="v" sid="JHN 5:47" />पण तमु मुसा नी लारे लीखला सास्‌तर पोर बी भरहो नी करता, ता मारी वात पोर कीसम भरहो करहु?<verse eid="JHN 5:47" /></para>
  <chapter eid="JHN 5" />
  <chapter number="6" style="c" sid="JHN 6" />
  <para style="s">ईसु पांच हजार माणहु ने खवाड़े</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 6:1" />थोड़ाक दाड़ान अळतेण ईसु गलील नी दर्‌या मतलब तीबर्‌या नी दर्‌या ने सेकीन ज्‌यो। <verse eid="JHN 6:1" /><verse number="2" style="v" sid="JHN 6:2" />ईसु घणा मांदला माणहु ने आरगा करतो हतो। ईसु ना वहराड़न्‌या काम नी सेलाणी देखीन माणहु नो जुदो मोटो मेळो ईसु पसळ चाल पड़्‌यो। <verse eid="JHN 6:2" /><verse number="3" style="v" sid="JHN 6:3" />ईसु आह़फा ना चेला ह़ाते एक बड़ा पोर चड़ीन, तीमनी ह़ाते बह ज्‌यो। <verse eid="JHN 6:3" /><verse number="4" style="v" sid="JHN 6:4" />अने युहदी माणहु नो फसह नो तीवार ह़ाते आय रेलो हतो।<verse eid="JHN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 6:5" />ईसु घण मोटो मेळो आह़फा भणी आवत्‌लो देख्‌यो, अने फीलीपुस ने केदो, “आपणु ईमने खवाड़वा करीन कां गेथा रोट्‌ला वेचाता लावहु?” <verse eid="JHN 6:5" /><verse number="6" style="v" sid="JHN 6:6" />पण तीहयो आहयी वात तीने पन्‌तारवा नी लेदे केदो, काहाके तीहयो खुद जाणतो हतो के तीहयो ह़ुं करहे?<verse eid="JHN 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 6:7" />फीलीपुस ईसु ने केदो, बे ह़ो दाड़ा नी दाड़की ना पय्‌हा ना रोट्‌ला लावहु अने थोड़ाक-थोड़ाक वाटहु ते बी तीमनी जुगु पुरती नी पड़े।<verse eid="JHN 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 6:8" />ईसु ना चेला मेथो सीमोन पतरस नो भाय अंदर्‌यास ईसु ने केदो। <verse eid="JHN 6:8" /><verse number="9" style="v" sid="JHN 6:9" />आञे एक सोरु से तीनी पांह जळगम ना पांच रोट्‌ला से अने बे माछला से, पण एतरा ढेरका माणहु ने ह़ु लागे।<verse eid="JHN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 6:10" />तीहया जागे घणो चारो हतो, अने ईसु चेला ने केदो, माणहु ने पंगात मे बहाड़ देवो। तां अदमड़ा पांच हजार हता अने आखा माणहु बह ज्‌या। <verse eid="JHN 6:10" /><verse number="11" style="v" sid="JHN 6:11" />तत्‌यार ईसु रोट्‌ला ने ली लेदो, अने भगवान ने जुगाळो कीन बह रेला माणहु ने वाट देदा, अने माछला बी तेमेत वाट देदा जेतरु तीमने जोवे तेतरु वाट देदा। <verse eid="JHN 6:11" /><verse number="12" style="v" sid="JHN 6:12" />जत्‌यार माणहु खायलीन आफरी ज्‌या ता ईसु आह़फा ना चेला ने केदो बचला रोट्‌ला ना टुकड़ा भेळा कर लेवो थोड़ुक बी बगड़वा नी जोवे। <verse eid="JHN 6:12" /><verse number="13" style="v" sid="JHN 6:13" />एतरे चेला भेळा कर्‌या, अने जळगम ना पांच रोट्‌ला ना टुकड़ा जे खायलीन बचला हता, तीना बारे चार्‌या भराय ज्‌या।<verse eid="JHN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 6:14" />माणहु ईसु ना वहराड़न्‌या काम नी सेलाणी देखीन की पड़्‌या, “ह़ाचली आहयो भगवान वगे गेथो खबर लावण्‌यो कळी मे आव्‌वा वाळो हतो तीहयो आहयोत से।” <verse eid="JHN 6:14" /><verse number="15" style="v" sid="JHN 6:15" />ईसु आहयु जाणीन के माणहु आवीन मने जबराण राजा बणाव्‌वा हींडे, एतरे तीहयो एखलोत बड़ा पोर जत र्‌यो।<verse eid="JHN 6:15" /></para>
  <para style="s">ईसु नु पाणी पोर चालनु</para>
  <para style="r">(<ref loc="MAT 14:22-27">मत्‌ती 14:22-27</ref>; <ref loc="MRK 6:45-52">मरकुस 6:45-52</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 6:16" />ह़ांती टेमे ईसु ना चेला दर्‌या धेड़े ज्‌या। <verse eid="JHN 6:16" /><verse number="17" style="v" sid="JHN 6:17" />अने ढुंड्‌यु मे बहीन ह़ेली धेड़े कफरनहुम भणी जवा बाज ज्‌या। अंदारु हय जेलु हतु, अने ईसु हजु लग तीमनीन्‌तां नी आयो। <verse eid="JHN 6:17" /><verse number="18" style="v" sid="JHN 6:18" />अने आंजी ना कारण झलक बी दर्‌या मे ज्‌योरेत आव्‌वा बाज जी। <verse eid="JHN 6:18" /><verse number="19" style="v" sid="JHN 6:19" />जत्‌यार तीहया तीन च्‌यार मील जत र्‌या, ता तीहया ईसु ने दर्‌या पोर चालीन ढुंड्‌यु भणी आवतलो देख्‌या अने तीमने बीक लागी। <verse eid="JHN 6:19" /><verse number="20" style="v" sid="JHN 6:20" />पण ईसु तीमने केदो, बीहो ना मेत से। <verse eid="JHN 6:20" /><verse number="21" style="v" sid="JHN 6:21" />तत्‌यार तीहया ईसु ने ढुंड्‌यु मे बहाड़वा करीन तीनीन्‌तां ढुंड्‌यु ने ली ज्‌या।<verse eid="JHN 6:21" /></para>
  <para style="s">माणहु ईसु ने ह़ोदे</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 6:22" />बीजा दाड़े, दर्‌या नी ह़ेली धेड़े उबो हय रेलो माणहु नो टोळो देख्‌यो के, आञे एकीत ढुंड्‌यु हतु, बीजा नान्‌ला ढुंड्‌या हता नी, अने ईसु चेला ह़ाते ढुंड्‌या मे नी चड़्‌यो, पण तीना चेला एतरा जत रेला हता। <verse eid="JHN 6:22" /><verse number="23" style="v" sid="JHN 6:23" />ता अळी बीजा नान्‌ला ढुंड्‌या तीबर्‌या गेथा तीहया जागा धेड़े आया, जां तीहया भगवान ने जुगाळो केदला अने रोट्‌ला खादला हता। <verse eid="JHN 6:23" /><verse number="24" style="v" sid="JHN 6:24" />जत्‌यार भीड़ मे वाळा माणहु देख्‌या, के आञे नी ते ईसु हय, अने नी ते तीना चेला हय, ता तीहया माणहु नान्‌ला ढुंड्‌या मे बहीन ईसु ने ह़ोदवा करीन कफरनहुम मे पुग्‌या।<verse eid="JHN 6:24" /></para>
  <para style="s">ईसु जीवाय नो रोट्‌लो से</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 6:25" />अने तीहया दर्‌यान ह़ेली धेड़े कफरनहुम मे ईसु ने भेटीन केदा, ए गुरु! तु आञे कत्‌यार आयो?<verse eid="JHN 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 6:26" />ईसु तीमने जपाप आप्‌यो, मे तमने ह़ाची-ह़ाची केम, तमु मने आनीन करते नी ह़ोद र्‌या के तमु वहराड़न्‌या काम देख्‌या, पण रोट्‌ला खायलीन आफरी ज्‌या करीन ह़ोद र्‌या?<verse eid="JHN 6:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 6:27" />खत्‌तम हयण्‌या खाणान करते मेहनत ना करो, पण तीहया खाणान करते मेहनत करो, अने तीहयु खाणु अमर जीवाय जुगु जलमकु टेकलु रेहे, अने आसवु खाणु तमने मनख्‌या नो बेटो आपहे, काहाके बाह भगवान मनख्‌यान बेटा पोर सीलटप्‌पो लगाड़ देदलो से।<verse eid="JHN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 6:28" />तीहया माणहु ईसु ने पुछ्‌या, “भगवान ने गमे एवु कानु काम करवा ना लेदे आमु ह़ुं करया?”<verse eid="JHN 6:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 6:29" />ईसु तीहया माणहु ने जपाप आप्‌यो, “भगवान ने गमे एवु काम आहयु से, के जीने भगवान मोकल्‌लो से, तीनी पोर भरहो करो।”<verse eid="JHN 6:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 6:30" />तीहया माणहु केदा, “तु काना काम नी सेलाणी देखाड़ही, के सेलाणी देखीन आमु तार पोर भरहो करया? अने तु आमने कानु काम करीन देखाड़ही? <verse eid="JHN 6:30" /><verse number="31" style="v" sid="JHN 6:31" />अमारा डाह-डाहा बड़ा मे मन्‌ना खादा; जीसम के लीखलु से, के तीहयो तीमने खावा करीन ह़रगे गेथा रोट्‌ला आप्‌यो।”<verse eid="JHN 6:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 6:32" />ईसु तीमने केदो, मे तमने ह़ाचली केम, के रोट्‌ला ह़रगे गेथा मुसो नी आप्‌यो, पण मारो बाह तमने ह़रगे गेथो खरला रोट्‌ला आपे। <verse eid="JHN 6:32" /><verse number="33" style="v" sid="JHN 6:33" />भगवान नो रोट्‌लो तीहयोत से, जे ह़रगे गेथो उतरीन मनख्‌या ने अमर जीवाय आपे।<verse eid="JHN 6:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 6:34" />तीहया ईसु ने केदा, “ए मालीक! आहयो रोट्‌लो आमने जलम आप्‌या कर।”<verse eid="JHN 6:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 6:35" />ईसु तीमने केदो, अमर जीवाय नो रोट्‌लो मेत से: अने जे मारीन्‌तां आवहे तीहयो कदी भुकलो नी रेय अने मार पोर भरहो करहे तीहयो तरहेलो नी रेय। <verse eid="JHN 6:35" /><verse number="36" style="v" sid="JHN 6:36" />पण मे तमने केदो, के तमु मने देखी बी लेदला से, ते बी भरहो नी करता। <verse eid="JHN 6:36" /><verse number="37" style="v" sid="JHN 6:37" />बाह जीने बी मने आप देहे, तीहया आखा मारीन्‌तां आवहे, अने मे तीमने मारीन्‌तां गेथो कदी नी नीकाळु। <verse eid="JHN 6:37" /><verse number="38" style="v" sid="JHN 6:38" />काहाके मे मारी मरजी पुरी करवा करीन नी, पण मने मोकलन्‌या नी मरजी पुरी करवा करीन ह़रगे गेथो उतरलो से। <verse eid="JHN 6:38" /><verse number="39" style="v" sid="JHN 6:39" />अने मने मोकलन्‌या नी मरजी आहयी से के जीने तीहयो मने आपलो से, तीमनी मे गेथा एक ने बी खोवाव्‌वा नी देम, पण तीमने आखरी दाड़े मर्‌या-ह़र्‌या मे गेथो जीवता कर देही। <verse eid="JHN 6:39" /><verse number="40" style="v" sid="JHN 6:40" />काहाके मारा बाह नी मरजी आहयी से के, जे कोय तीना बेटा ने देखे, अने तीनी पोर भरहो करे, ता तीनी पांह अमर जीवाय रेहे, तीने मे आखरी दाड़े मर्‌या-ह़र्‌या मे गेथो पासो जीवतो कर देही।<verse eid="JHN 6:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 6:41" />ईसु तीमने केदलो, के ह़रगे गेथो उतरलो रोट्‌लो मेत से। आहयी वात पोर युहदी माणहु ईसु पोर कुर-कुर करवा बाज ज्‌या। <verse eid="JHN 6:41" /><verse number="42" style="v" sid="JHN 6:42" />अने तीहया केदा, “आहयो युसुफ नो सोरो ईसु नी हय, आमु आना आह्‌य-बाहा ने जाणये, ता हीय्‌यो आसम काहा की र्‌यो के मे ह़रगे गेथो उतरलो से?”<verse eid="JHN 6:42" /></para>
  <para style="p">
    <verse number="43" style="v" sid="JHN 6:43" />ईसु तीमने जपाप आप्‌यो, के तमु-तमुत ना कुर-कुर करो। <verse eid="JHN 6:43" /><verse number="44" style="v" sid="JHN 6:44" />कोय मारीन्‌तां नी आय सकत्‌लु, जत्‌यार लग बाह, जे मने मोकलो से, तीने हापकीन नी लावे, अने मे तीने आखरी दाड़े अळी जीवतो करही। <verse eid="JHN 6:44" /><verse number="45" style="v" sid="JHN 6:45" />भगवान वगे गेथा केवा वाळा नी कीताप मे आहयु लीखलु से, तीहया आखा भगवान वगे गेथा ह़ीकाड़ला रेहे, जे कोय बाह सी ह़मळला अने ह़ीकला से, तीहया मारीन्‌तां आवहे।<note caller="+" style="x"><char style="xo" closed="false">6:45 </char><char style="xt" closed="false"><ref loc="ISA 54:13">यसाया 54:13</ref></char></note> <verse eid="JHN 6:45" /><verse number="46" style="v" sid="JHN 6:46" />आहयु नी, के कोय बाह ने देखला से पण जे भगवान वगे गेथो आवलो से, तीहयोत भगवान बाह ने देखलो से। <verse eid="JHN 6:46" /><verse number="47" style="v" sid="JHN 6:47" />मे तमने ह़ाची-ह़ाची केम, “जे कोय भरहो करे, अमर जीवाय तीनीत से।” <verse eid="JHN 6:47" /><verse number="48" style="v" sid="JHN 6:48" />अमर जीवाय नो रोट्‌लो मेत से। <verse eid="JHN 6:48" /><verse number="49" style="v" sid="JHN 6:49" />तमारा आड़ा-बुड़ा बड़ा मे मन्‌ना खादा, अने तीहया मर ज्‌या। <verse eid="JHN 6:49" /><verse number="50" style="v" sid="JHN 6:50" />आहयो तीहयो रोट्‌लो से जे ह़रगे गेथो उतरलो से काहाके माणहु तां गेथा खाय अने नी मरे। <verse eid="JHN 6:50" /><verse number="51" style="v" sid="JHN 6:51" />ह़रगे गेथो उतरलो अमर जीवाय नो रोट्‌लो मेत से, कदी कोय आहयो रोट्‌लो खाहे, तीहयो जलम जीवत्‌लो रेहे। अने जे रोट्‌लो मे कळी नी जीवाय जुगु आपही, तीहयो रोट्‌लो मारु माह से।<verse eid="JHN 6:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 6:52" />एतरे युहदी माणहु आहयु कीन झगड़वा बाज ज्‌या, के “आहयो माणेह आह़फा नु माह खावा करीन कीसम आप सके।”<verse eid="JHN 6:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 6:53" />ईसु तीमने केदो, “मे तमने ह़ाची-ह़ाची केम, जत्‌यार लग तमु मनख्‌या ना बेटा नु माह नी खावो, अने तीनु लोय नी पीवो, तां लग तमारी मे जीवाय नी हय। <verse eid="JHN 6:53" /><verse number="54" style="v" sid="JHN 6:54" />जे कोय मारु माह खाय, अने मारु लोय पीतो हय, अमर जीवाय तीनीत से, अने आखरी दाड़े तीने मे मर्‌या-ह़र्‌या मे गेथो पासो जीवतो कर देही। <verse eid="JHN 6:54" /><verse number="55" style="v" sid="JHN 6:55" />मारु माह खरलु खाणु से, अने मारु लोय पीवा नी खरली चीज से। <verse eid="JHN 6:55" /><verse number="56" style="v" sid="JHN 6:56" />जे मारु माह खाया करहे, अने मारु लोय पीया करहे, तीहयो मारी मे रेहे, अने मे तीनी मे रेही। <verse eid="JHN 6:56" /><verse number="57" style="v" sid="JHN 6:57" />जीसम जीवत्‌लो बाह मने मोकल्‌यो अने मे बाह नी मरजी ना लारे जीवत्‌लो से, तीसमेत जे मने खाहे, तीहयो मारी मरजी ना लारे जीवत्‌लो रेहे। <verse eid="JHN 6:57" /><verse number="58" style="v" sid="JHN 6:58" />ह़रगे गेथो उतरलो रोट्‌लो मेत से। आहयो रोट्‌लो ते रोट्‌लान तेवो नी हय जीने आड़ा-बुड़ा खादा अने मर ज्‌या; पण जे कोय आहयो रोट्‌लो खाहे तीहयो जलम जीवत्‌लो रेहे।”<verse eid="JHN 6:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 6:59" />कफरनहुम मे भक्‌ती ना घोर मे ईसु ह़ीकापण आपतो जाय्‌न आहयी आखी वात केदो।<verse eid="JHN 6:59" /></para>
  <para style="s">जलम जीवाय ना बोलु</para>
  <para style="p">
    <verse number="60" style="v" sid="JHN 6:60" />एतरे तीना चेला मे गेथा घणात आहयु ह़मळीन केदा, “आहयी ते वातड़ी ह़ीकापण से। आने कोय मान सकत्‌लु?”<verse eid="JHN 6:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JHN 6:61" />ईसु आह़फा ना मन मे आहयु जाणीन के मारा चेला आह़फा-आह़फात आहयी वात पोर कुर-कुर कर र्‌या, तीमने पुछ्‌यो, ह़ुं आहयी वात सी तमने ठोकर लाग री? <verse eid="JHN 6:61" /><verse number="62" style="v" sid="JHN 6:62" />अने कदी तमु माणहु ना बेटा ने जां तीहयो हतो, तां उपर जते देखहु, ता ह़ुं हयहे? <verse eid="JHN 6:62" /><verse number="63" style="v" sid="JHN 6:63" />आत्‌मा ते जीवाय आपण्‌याण से, डील सी कंय फायदो नी हय, जे वात मे तमने केदलो से तीहयी आत्‌मा से, अने जीवाय बी से। <verse eid="JHN 6:63" /><verse number="64" style="v" sid="JHN 6:64" />पण तमारी मे गेथा काय केतरा आसवा से जे भरहो नी करे। काहाके ईसु ते पेले सीत जाणतो हतो के, जे भरहो नी करे, तीहया कोय से, अने कोय मने धरावहे। <verse eid="JHN 6:64" /><verse number="65" style="v" sid="JHN 6:65" />अने ईसु केदो, एतरे मे तमने केदलो के जत्‌यार लग बाह तीने मारीन्‌तां आव्‌वा लायक नी बणावे तत्‌यार लग तीहयो मारीन्‌तां नी आय सके।<verse eid="JHN 6:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="JHN 6:66" />आनीन करते ईसु ना ढेरेत चेला ईसुन्‌तां गेथा जत र्‌या, अने ईसु नी वात ने सोड़ देदा। <verse eid="JHN 6:66" /><verse number="67" style="v" sid="JHN 6:67" />एतरे ईसु बारे चेला ने केदो, “तमु बी जवा हींड र्‌या ह़ु?”<verse eid="JHN 6:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="JHN 6:68" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:68 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:16">मत्‌ती 16:16</ref>; <ref loc="MRK 8:29">मरकुस 8:29</ref>; <ref loc="LUK 9:20">लुका 9:20</ref></char>
    </note>सीमोन पतरस ईसु ने केदो, “ए मालीक, आमु कोयने तां जीया? अमर जीवाय आपण्‌या बोलु ते तारी पांह से। <verse eid="JHN 6:68" /><verse number="69" style="v" sid="JHN 6:69" />आमु जाण ज्‌या अने भरहो कर लेदा के भगवान नो चोखलो माणेह तुत से।”<verse eid="JHN 6:69" /></para>
  <para style="p">
    <verse number="70" style="v" sid="JHN 6:70" />ईसु तीमने जपाप आप्‌यो, “मे तमने बारे जणा ने नी टाळ्‌यो ह़ु? ते बी तमारी मे एक जणो भुतड़ो से।” <verse eid="JHN 6:70" /><verse number="71" style="v" sid="JHN 6:71" />ईसु आहयी वात सीमोन ईस्‌करीयोती ना बेटा यहुदा ना बारा मे केदो। हीय्‌योत बारे चेला मे एक हतो, जे ईसु ने धराव्‌वा हींडतो हतो।<verse eid="JHN 6:71" /></para>
  <chapter eid="JHN 6" />
  <chapter number="7" style="c" sid="JHN 7" />
  <para style="s">ईसु अने तीना भायु नु तीवार मे जाणु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 7:1" />युहदी ईसु ने मार नाखवा नो वीच्‌यार कर र्‌या हता; करीन तीहयो युहद्‌या मे नी फीरवा हींडतो हतो। एतरे ईसु गलील मे सेवा करतो जाय्‌न फीरतो र्‌यो। <verse eid="JHN 7:1" /><verse number="2" style="v" sid="JHN 7:2" />अने युहदी माणहु नो तम्‌बु नो तीवार ह़ातेत आय र्‌यो हतो। <verse eid="JHN 7:2" /><verse number="3" style="v" sid="JHN 7:3" />एतरे ईसु ना भाय ईसु ने केदा, “आञे सी कंय करीन युहद्‌या मे जत रे के, जे काम तु करे, तीने तारा चेला बी देखे। <verse eid="JHN 7:3" /><verse number="4" style="v" sid="JHN 7:4" />काहाके आसवो कोय नी हहे जे मोटो बणवा हींडे, अने तीहयो ह़ताय्‌न काम करे, पण तु जुदा-काम करीत र्‌यो, ता आह़फा ने कळी मे उजन्‌तो कर दे।” <verse eid="JHN 7:4" /><verse number="5" style="v" sid="JHN 7:5" />काहाके ईसु ना भाय बी ईसु पोर भरहो नी करता हता।<verse eid="JHN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 7:6" />तत्‌यार ईसु तीमने केदो, “मारी टेम हजु नी आयी; पण तमारी लेदे आखी टेमेत से। <verse eid="JHN 7:6" /><verse number="7" style="v" sid="JHN 7:7" />कळी ना माणहु तमारी सी रीह नी करे, पण तीहया मारी पोर रीह करहे, काहाके मे तीमना वीरोद मे गवाय देम, के तीमना काम बुरा से। <verse eid="JHN 7:7" /><verse number="8" style="v" sid="JHN 7:8" />तमु तीवार मे जावो, मे हमणे आहया तीवार मे नी जतो; काहाके हमणे मारी टेम नी आयी। <verse eid="JHN 7:8" /><verse number="9" style="v" sid="JHN 7:9" />आहयी वात तीमने कीन ईसु गलील मेत री ज्‌यो।”<verse eid="JHN 7:9" /></para>
  <para style="s">तम्‌बु ना तीवार मे ईसु</para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 7:10" />पण तीना भाय तीवार मे ज्‌या, ता ईसु बी ज्‌यो पण उजन्‌तो नी ज्‌यो बाखीन होगलोत तां ज्‌यो। <verse eid="JHN 7:10" /><verse number="11" style="v" sid="JHN 7:11" />तीवार मे युहदी माणहु ईसु ने ह़ोदता जाय्‌न केता हता के “तीहयो माणेह कां से?”<verse eid="JHN 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 7:12" />अने माणहु ईसु ना बारा मे ह़ळ्‌ये-ह़ळ्‌ये ढेरेत वात केता हता, थोड़ाक केता हता, हीय्‌यो भलाय करवा वाळो माणेह से अने थोड़ाक केता हता, नी हीय्‌यो माणहु ने भंगलाड़ र्‌यो। <verse eid="JHN 7:12" /><verse number="13" style="v" sid="JHN 7:13" />पण कोय बी युहदी माणहु ना धाके ईसु ना बारा मे उजन्‌ता हय्‌न नी केतला।<verse eid="JHN 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 7:14" />अने जत्‌यार तीवार ना आदा दाड़ा वीत ज्‌या, ता ईसु मंदीर मे जाय्‌न ह़ीकाड़वा बाज ज्‌यो। <verse eid="JHN 7:14" /><verse number="15" style="v" sid="JHN 7:15" />युहदी माणहु वहराय्‌न केवा बाज ज्‌या के आने भण्‌या वगर आतरी वीद्‌या कां गेथी जड़ी?<verse eid="JHN 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 7:16" />ईसु तीमने जपाप आप्‌यो, “मारी ह़ीकापण मारी नी हय पण मने मोकलन्‌या नी से। <verse eid="JHN 7:16" /><verse number="17" style="v" sid="JHN 7:17" />कदी कोय भगवान नी मरजी पोर चालवा हींडे, ता ह़ीकापण ना बारा मे जाण जहे के आहयी भगवान भणी गेथी से के मारी भणी गेथी की र्‌यो। <verse eid="JHN 7:17" /><verse number="18" style="v" sid="JHN 7:18" />जे कोय आह़फा भणी गेथो कंय केय, तीहयो आह़फा नी बड़ाय कराव्‌वा हींडे; पण जे कोय आह़फा ने मोकलन्‌या नी बड़ाय कराव्‌वा हींडे तीहयो खरलो से, अने तीनी मे कंय बी खोट नी हय। <verse eid="JHN 7:18" /><verse number="19" style="v" sid="JHN 7:19" />मुसो तमने कायदा नी आप्‌यो ह़ु? ते बी तमारी मे गेथा कोय बी कायदा पोर नी चाले। ता तमु मने काहा मारवा हींड र्‌या?”<verse eid="JHN 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 7:20" />माणहु जपाप आप्‌या, “तारी मे भुतड़ो से! कोय तने मारवा हींडे?”<verse eid="JHN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 7:21" />ईसु तीमने जपाप आप्‌यो, “मे एक काम करलो से, करीन तमु आखा भंगलाय र्‌या। <verse eid="JHN 7:21" /><verse number="22" style="v" sid="JHN 7:22" />आनीन करते मुसो तमने खतना करवा नी रीती नो कायदा आप्‌यो, पण आहयी मुसा ना लारे नी सुरु हयी, पण पेले गेथी आड़ा-बुड़ा नी टेमे गेथीत सुरु हयी, अने तमु अराम ना दाड़े माणेह नु खतनु कर र्‌या। <verse eid="JHN 7:22" /><verse number="23" style="v" sid="JHN 7:23" /><note caller="+" style="x"><char style="xo" closed="false">7:23 </char><char style="xt" closed="false"><ref loc="JHN 5:9">युहन्‌ना 5:9</ref></char></note>जत्‌यार अराम ना दाड़े माणेह नु खतनु ना काम कर देत्‌ला काहाके मुसा ना कायदा नी टुटवा जोवे, ता अराम ना दाड़े मे एक माणेह ने पुरो आरगो कर देदो करीन तमु मार पोर काहा रीहवाय र्‌या? <verse eid="JHN 7:23" /><verse number="24" style="v" sid="JHN 7:24" />मोडा देखीन नीयाव ना करो, पण खरलो नीयाव करो।”<verse eid="JHN 7:24" /></para>
  <para style="s">ईसुत मसी से ह़ुं?</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 7:25" />ता यरुसलेम मे वाळा माणहु केवा बाज ज्‌या के आहयो तीहयोत माणेह नी हय जीने मार नाखवा नो वीच्‌यार कर र्‌या? <verse eid="JHN 7:25" /><verse number="26" style="v" sid="JHN 7:26" />पण देखो आहयो ते उजन्‌तो वात करवा बाज र्‌यो, अने पुडार्‌या आने कंय बी नी केता, कंय माय्‌न हीय्‌या हीने ह़ाचली आव्‌वा वाळो मसी ते नी मान लेदा? <verse eid="JHN 7:26" /><verse number="27" style="v" sid="JHN 7:27" />पण आमु ते हीने जाणये, के हीय्‌यो कां गेथो आवलो से; पण जत्‌यार मसी आवहे, ता कोय नी जाणे, के हीय्‌यो कां गेथो आवलो से।<verse eid="JHN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 7:28" />तत्‌यार ईसु मंदीर मे ह़ीकाड़तो जाय्‌न आड़ीन केदो, “तमने आसम लागे के आमु हीने ओळखी र्‌या, अने आहयु बी जाणये के हीय्‌यो कां गेथो आवलो से। ते बी मारी मरजी सी नी आयो, पण जे मने मोकलवा वाळो खरलो से, तीने तमु नी जाणता।” <verse eid="JHN 7:28" /><verse number="29" style="v" sid="JHN 7:29" />मे तीने जाणु; काहाके मे तीनी वगे गेथो आवलो से, अने तीहयोत मने मोकल्‌लो से।<verse eid="JHN 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 7:30" />एतरे ईसु ने तीहया धरीन लीजवा हंडता हता, पण ईसु ने धरीन लीजवा नी कोयने हीम्‌मत नी आयी काहाके ईसु नी टेम हजु लग नी आवली हती। <verse eid="JHN 7:30" /><verse number="31" style="v" sid="JHN 7:31" />अने मेळा मे गेथा घणात ईसु पोर भरहो कर्‌या, अने केवा बाज ज्‌या, जीसम आहयो करलो से, “एतरा ढेरका वहराड़न्‌या काम ना सेलाण्‌या बीजो कोय बी नी देखाड़ सके; एतरे आहयोत मसी से?”<verse eid="JHN 7:31" /></para>
  <para style="s">ईसु ने धरवा नी कोसीत</para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 7:32" />फरीसी पंथवाळा आहयु ह़मळ्‌या के माणहु ईसु ना बारा मे ह़ळ्‌ये-ह़ळ्‌ये वात करवा बाज र्‌या; ता डायलो पुंजारो अने फरीसी पंथवाळा ईसु ने धरीन लाव्‌वा करीन सीपायड़ा ने मोकल्‌या। <verse eid="JHN 7:32" /><verse number="33" style="v" sid="JHN 7:33" />ईसु केदो, “हाव मे थोड़ीक वार लग तमारी ह़ाते रेही। अळतेण मने मोकलन्‌यान तां पासो जत रेही। <verse eid="JHN 7:33" /><verse number="34" style="v" sid="JHN 7:34" />तमु मने ह़ोद्‌या करहु, पण मे तमने नी जड़ु। अने मे जां जवा बाज र्‌यो, तां तमु नी आय सकत्‌ला।”<verse eid="JHN 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 7:35" />युहदी माणहु आह़फा-आह़फात केवा बाज ज्‌या, आहयो कां जहे के आमु ईने ह़ोदी नी सकया? ह़ुं हीय्‌यो तीहया युहदी माणहुन तां जहे जे युनानी माणहु ना वच मे तीतर-बीतर हय्‌न री र्‌या, अने युनानी माणहु ने बी ह़ीकापण आपहे? <verse eid="JHN 7:35" /><verse number="36" style="v" sid="JHN 7:36" />आहयी ह़ुं वात से जे तीहयो केदो, के तमु मने ह़ोदहु, पण मे तमने नी जड़ु, अने जां मे जाम, तां तमु नी आय सकत्‌ला?<verse eid="JHN 7:36" /></para>
  <para style="s">जीवाय ना पाणी नी नंदी</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 7:37" />तीवार ना आखरी दाड़े, जे खास दाड़ो केवाय, ईसु उबो हयो, अने ज्‌योरेत आड़ीन केदो, “जे कोय तरहेलो हय तीहयो मारीन्‌तां आवो अने पीवो। <verse eid="JHN 7:37" /><verse number="38" style="v" sid="JHN 7:38" />खरला सास्‌तर मे लीखलु से, जे कोय मार पोर भरहो करे, तीनी मे गेथी जीवाय ना पाणी नी नंदी वय्‌न नीकळहे।” <verse eid="JHN 7:38" /><verse number="39" style="v" sid="JHN 7:39" />ईसु आहयी वात आत्‌मा ना बारा मे केदलो हतो, जे भरहो करवा वाळा नी जीवाय मे आव्‌वा वाळी हती; काहाके आत्‌मा हजु लग नी उतरली हती, काहाके हजु लग ईसु आह़फा नी बड़ाय मे पासो नी जेलो हतो।<verse eid="JHN 7:39" /></para>
  <para style="s">माणहु ना वच मे बेरजाव</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 7:40" />तत्‌यार मेळा मे वाळा काना-काना माणहु आहयी वात ह़मळीन केदा, “ह़ाचली आहयो भगवान वगे गेथो वात केण्‌यो माणेह से।”<verse eid="JHN 7:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 7:41" />थोड़ाक माणहु केदा, “आहयो ते मसी से।”</para>
  <para style="p" vid="JHN 7:41">पण थोड़ाक माणहु केदा, “आहयो मसी नी हय। काहाके मसी गलील मे हय्‌न नी आय सके। <verse eid="JHN 7:41" /><verse number="42" style="v" sid="JHN 7:42" />खरला सास्‌तर मे लीखलु से के, मसी बेतलहम गाम मे दावुद नी अवल्‌यात मे पयदा हयहे।” <verse eid="JHN 7:42" /><verse number="43" style="v" sid="JHN 7:43" />आसम करीन माणहु मे बेरजाव पड़ ज्‌यो। <verse eid="JHN 7:43" /><verse number="44" style="v" sid="JHN 7:44" />तीमनी मे गेथा थोड़ाक माणहु ईसु ने धरीन लीजवा हींडता हता, पण तीने धरीन लीजवा नी कोयने हीम्‌मत नी आयी।<verse eid="JHN 7:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 7:45" />तत्‌यार सीपायड़ा पुंजारान तां अने फरीसी माणहु भणी पासा आया, अने तीहया केदा, “तमु तीने काहा नी लाया?”<verse eid="JHN 7:45" /></para>
  <para style="s">युहदी अगवा नो वण-भरहो</para>
  <para style="p">
    <verse number="46" style="v" sid="JHN 7:46" />सीपायड़ा केदा, कोय माणेह कदी आसवी वात नी कर्‌यु। जीसम तीहयो केय।<verse eid="JHN 7:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JHN 7:47" />फरीसी केदा, तमु बी भंगलाय ज्‌या ह़ु? <verse eid="JHN 7:47" /><verse number="48" style="v" sid="JHN 7:48" />पुडार्‌या अने फरीसी माणहु मे ना कोय बी, ईसु पोर भरहो करला से ह़ु? <verse eid="JHN 7:48" /><verse number="49" style="v" sid="JHN 7:49" />पण आहया माणहु ने कायदा मालम नी हय, एतरे ईमनी पोर गरा से।<verse eid="JHN 7:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="JHN 7:50" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:50 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 3:1">युहन्‌ना 3:1</ref>,<ref loc="JHN 3:2">2</ref></char>
    </note>नीकुदेमुस, जे पेलेत ईसु ने भेटवा जेलो, तीहयो तीमनी मे गेथो एक हतो, तीहयो केदो। <verse eid="JHN 7:50" /><verse number="51" style="v" sid="JHN 7:51" />ह़ुं आपणा कायदा काना माणेह ने जत्‌यार लग पेले तीनी ह़मळीन जाणी नी लेय के तीहयो ह़ुं कर्‌यो, तीने गुनाळ्‌ळो बणावत्‌ला?<verse eid="JHN 7:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 7:52" />तीहया नीकुदेमुस ने केदा, “ह़ुं तु बी गलील वाळो से, खरला सास्‌तर मे ह़ोद, अने भणीन भाळ, के भगवान वगे गेथी वात केण्‌यो माणेह गलील मे गेथो आवण्‌यो नी हय।” <verse eid="JHN 7:52" /><verse number="53" style="v" sid="JHN 7:53" />तत्‌यार आखा आपणा-आपणा घोर जत र्‌या।<verse eid="JHN 7:53" /></para>
  <chapter eid="JHN 7" />
  <chapter number="8" style="c" sid="JHN 8" />
  <para style="s">ईसु छीनाळ बयर ना पाप माफ करे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 8:1" />ईसु जेतुन ना बड़ा पोर ज्‌यो। <verse eid="JHN 8:1" /><verse number="2" style="v" sid="JHN 8:2" />अने ह़वारे मंदीर मे आयो, अने आखा माणहु ईसुन्‌तां आया, अने तीहयो बहीन तीमने ह़ीकाड़वा बाज ज्‌यो। <verse eid="JHN 8:2" /><verse number="3" style="v" sid="JHN 8:3" />तत्‌यार सास्‌तर ह़ीकाड़न्‌या अने फरीसी एक बयर ने धरीन लाया, अने तीने वच मे उबी कर देदा, काहाके तीने छीनाळु करतली देख पाड़ला, अने ईसु ने केदा, <verse eid="JHN 8:3" /><verse number="4" style="v" sid="JHN 8:4" />“ए गुरु!” आहयी बयर ने छीनाळु करतली देख पाड़ला से <verse eid="JHN 8:4" /><verse number="5" style="v" sid="JHN 8:5" />मुसा ना कायदा मे लीखलु से के आसवी छीनाळ्‌याण बयर ने दगड़ाटीन मार नाखवा जोवे। एतरे आहयी बयर ना बारा मे तारु ह़ु केणु पड़े। <verse eid="JHN 8:5" /><verse number="6" style="v" sid="JHN 8:6" />तीहया ईसु ने पारखवा करीन आहयी वात केदा, ईसु पोर गुनो लगाड़वा करीन कंय वात जड़ जाय, पण ईसु ढुंगो वळीन आगळ्‌ये करीन भोयमे लीखवा लाग्‌यो। <verse eid="JHN 8:6" /><verse number="7" style="v" sid="JHN 8:7" />जत्‌यार तीहया ईसु ने पुछता र्‌या, ता ईसु उबो हय्‌न तीमने केदो, “तमारी मे जे कोय पाप नी कर्‌यो हय, तीहयोत आखान पेले आहयी बयर ने दगड़ो देवो।” <verse eid="JHN 8:7" /><verse number="8" style="v" sid="JHN 8:8" />अने अळी ढुंगो वळीन धरती पोर लीखवा बाज ज्‌यो। <verse eid="JHN 8:8" /><verse number="9" style="v" sid="JHN 8:9" />अने आहयु ह़मळीन मोट्‌ला गेथा नान्‌ला लग, आखा एकीक करीन जत र्‌या। अने तां ईसु अने तीहयी बयर री जी। <verse eid="JHN 8:9" /><verse number="10" style="v" sid="JHN 8:10" />ईसु उबो हय्‌न तीहयी बयर ने केदो, “ए बाय जात! तीहया माणहु कां जत र्‌या? तने कोय बी डंड नी आप्‌यो ह़ु?”<verse eid="JHN 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 8:11" />तीहयी बयर केदी, ए मालीक!</para>
  <para style="p" vid="JHN 8:11">कोय बी डंड नी आप्‌यो। ईसु तीने केदो, मे बी तने डंड नी आपतो। जा, अने अळी पाप नी करजे।<verse eid="JHN 8:11" /></para>
  <para style="s">कळी नु वीजाळु ईसु से</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 8:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:14">मत्‌ती 5:14</ref>; <ref loc="JHN 9:5">युहन्‌ना 9:5</ref></char>
    </note>तत्‌यार ईसु अळी माणहु ने केदो, कळ नु वीजाळु मेत से; जे कोय मारी पसळ आवहे, तीहयो अंदारला मे नी चाले, पण जीवाय नु वीजाळु हात करहे।<verse eid="JHN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 8:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:13 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 5:31">युहन्‌ना 5:31</ref>
      </char>
    </note>एतरे फरीसी ईसु ने केदा, “तु आह़फा ना बारा मे गवाय आह़फोत दी र्‌यो। एतरे तारी गवाय खरली नी हय।”<verse eid="JHN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 8:14" />ईसु तीमने जपाप देदो, “मे जाणु के मे कां गेथो आवलो से, अने कां जवा बाज र्‌यो। पण तमु नी जाणता के मे कां गेथो आवलो से, अने कां जवा बाज र्‌यो। एतरे आह़फोत मे मारा बारा मे गवा देम; ते बी मारी गवाय खरली से। <verse eid="JHN 8:14" /><verse number="15" style="v" sid="JHN 8:15" />तमु कळ ना हीसाबे नीयाव कर र्‌या, पण मे कोयनो आसम नीयाव नी करु। <verse eid="JHN 8:15" /><verse number="16" style="v" sid="JHN 8:16" />अने कदीम नीयाव बी करु, ता मारो नीयाव खरलो से; काहाके मे एखलो नी, पण मारा बाह ह़ाते से, जे मने मोकल्‌लो से। <verse eid="JHN 8:16" /><verse number="17" style="v" sid="JHN 8:17" />तमारी कायदा नी सास्‌तर मे बी लीखलु से; के बे जणा नी गवाय खरली मनाये। <verse eid="JHN 8:17" /><verse number="18" style="v" sid="JHN 8:18" />मे मारा बारा मे गवा देम, अने मारो बाह बी मारा बारा मे गवाय देय, जे मने मोकल्‌लो से।”<verse eid="JHN 8:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 8:19" />तीहया ईसु ने केदा, कां से तारो बाह? ईसु तीमने जपाप आप्‌यो, तमु मने बी नी जाणता, अने मारा बाह ने बी नी जाणता।</para>
  <para style="p" vid="JHN 8:19">कदी तमु मने जाणता, ता मारा बाह ने बी जाण लेता।<verse eid="JHN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 8:20" />ईसु मंदीर मे, दान-पेटीन तां ह़ीकापण आपतो जाय्‌न आहयी वात केदो, ते बी कोय नी तीने धर्‌या, काहाके तीनी टेम हजु लग नी आवली हती।<verse eid="JHN 8:20" /></para>
  <para style="s">आह़फा ना बारा मे नी वात</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 8:21" />ईसु अळी माणहु ने केदो, “मे जाम, अने तमु मने ह़ोदहु, अने आह़फा ना पाप मेत मर जहु। जां मे जाम, तां तमने नी अवाय सके।”<verse eid="JHN 8:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 8:22" />आहयी वात पोर युहदी माणहु केदा, “आहयो आसम काहा की र्‌यो, जां मे जाम, तां तमु नी आय सको, ह़ुं आहयो आह़फा ने मार नाखहे?”<verse eid="JHN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 8:23" />ईसु तीमने केदो, “तमु हेटला से, मे उपरलो से। तमु आहयी कळ ना से, मे आहयी कळ नो नी हय।” <verse eid="JHN 8:23" /><verse number="24" style="v" sid="JHN 8:24" />एतरे मे तमने केदलो, आह़फाम ना पाप मेत मर जहु; काहाके तमु तीहयोत से करीन भरहो नी करो, ता तमु आह़फाम ना पाप मेत मर जहु।<verse eid="JHN 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 8:25" />तीहया ईसु ने केदा, तु कोय से? ईसु तीमने केदो, मे तीहयोत से जे सुरु सी केतो आय र्‌यो। <verse eid="JHN 8:25" /><verse number="26" style="v" sid="JHN 8:26" />तमारा बारा मे मने घणु कंय केवा नु से, अने नीयाव करवा नो से। पण मने मोकलवा वाळो खरलो से; अने जे मे तीनी सी ह़मळु तीहयुत आहयी कळ ना माणहु ने केम।<verse eid="JHN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 8:27" />ईसु तीमने भगवान बाह ना बारा मे केवा बाज र्‌यो हतो, पण तीहयी वात तीमने पल्‌ले नी पड़ी। <verse eid="JHN 8:27" /><verse number="28" style="v" sid="JHN 8:28" />ता ईसु केदो, के जत्‌यार तमु मनख्‌या ना बेटा ने उपर कुरुस पोर चड़ावहु, ता तमु जाण जहु के मे तीहयो से। अने मे मारी मरजी सी कंय बी नी केम, पण जेम मारो बाह मने ह़ीकाड़लो से, तेमेत आहयी वात केम। <verse eid="JHN 8:28" /><verse number="29" style="v" sid="JHN 8:29" />मने मोकलवा वाळो मारी ह़ाते से; तीहयो मने एखलो नी सोड़्‌यो; मे सदा तीहयुत काम करत्‌लो, जे काम तीने गमे।<verse eid="JHN 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 8:30" />ईसु आहयी वात केवा बाज र्‌यो हतो, ता ढेरेत माणहु तीनी पोर भरहो कर्‌या।<verse eid="JHN 8:30" /></para>
  <para style="s">सच्‌चाय तमारो छुटकारो करहे</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 8:31" />जे युहदी माणहु ईसु पोर भरहो कर्‌या, तीमने केदो, “कदी तमु मारी ह़ीकापण मे टेकला रेहु, ता ह़ाचली तमु मारा चेला बण जहु। <verse eid="JHN 8:31" /><verse number="32" style="v" sid="JHN 8:32" />अने सच्‌चाय ने ओळखी लेहु, अने तीहयी सच्‌चाय तमने सोड़ावहे।”<verse eid="JHN 8:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 8:33" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:33 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:9">मत्‌ती 3:9</ref>; <ref loc="LUK 3:8">लुका 3:8</ref></char>
    </note>तीहया ईसु ने केदा, “आमु अब्‌राहम नी अवल्‌यात से, अने आमु कदी कोयना कब्‌जा मे नी हया। अने तु आसम कीसम केय के सच्‌चाय तमने कब्‌जा मे गेथा सोड़ाय देहे।”<verse eid="JHN 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 8:34" />ईसु तीमने केदो, “मे तमने ह़ाची-ह़ाची केम, जे पाप करे, तीहयो पाप नो गुलाम से। <verse eid="JHN 8:34" /><verse number="35" style="v" sid="JHN 8:35" />पावर्‌यो जलम घोर मे नी रेय, पण बेटो जलम घोर मे रेय। <verse eid="JHN 8:35" /><verse number="36" style="v" sid="JHN 8:36" />एतरे कदी बेटो तमने पाप नी गुलामी मे गेथो सोड़ाय लेय, ता तमु ह़ाचली पाप ना गुलाम मे गेथा छुट जहु। <verse eid="JHN 8:36" /><verse number="37" style="v" sid="JHN 8:37" />मे जाणु के तमु अब्‌राहम नी अवल्‌यात से; ते बी तमु मारी ह़ीकापण जुगु तमारा मन मे जागो नी हय, करीन तमु मने मारवा हंड र्‌या। <verse eid="JHN 8:37" /><verse number="38" style="v" sid="JHN 8:38" />मे तीहयुत केम अने करु, जे मारा बाहन्‌तां देखलो से, अने तमु तीहयुत कर र्‌या जे तमारा बाह सी ह़मळ्‌ळा से।”<verse eid="JHN 8:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 8:39" />तीहया ईसु ने केदा, अब्‌राहम अमारो बाह से।</para>
  <para style="p" vid="JHN 8:39">एतरे ईसु तीमने केदो, “कदी तमु अब्‌राहम नी अवल्‌यात हता, ता तमु तीहयुत काम करता जे काम अब्‌राहम करत्‌लो।” <verse eid="JHN 8:39" /><verse number="40" style="v" sid="JHN 8:40" />मे तमने भगवान वगे गेथो सच्‌चाय नो बोल ह़मळायो; आहयु ह़मळीन बी तमु मने मारवा हींड र्‌या, तमारीन तेवा काम अब्‌राहम ते नी कर्‌यो। <verse eid="JHN 8:40" /><verse number="41" style="v" sid="JHN 8:41" />तमु तमारा बाह ने तेम काम कर र्‌या, तीहया ईसु ने केदा, “आमु छीनाळा सी पयदा नी हया; अमारो एकीत बाह से मतलब भगवान से।”<verse eid="JHN 8:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JHN 8:42" />ईसु तीहया युहदी माणहु ने केदो, भगवान तमारो बाह नी हय कदीम तमारो बाह हतो ता तमु मने ओळखीन मोंग करता काहाके तमारी मरजी सी नी आयो पण मने भगवान मोकल्‌लो से करीन मे भगवान बाह मे गेथो नीकळीन आवलो से। <verse eid="JHN 8:42" /><verse number="43" style="v" sid="JHN 8:43" />तमु मारी वात काहा नी ह़मजता? एतरे के तमु मारी वात मन लगाड़ीन नी ह़मळता। <verse eid="JHN 8:43" /><verse number="44" style="v" sid="JHN 8:44" />काहाके तमु भुतड़ा नी अवल्‌यात से, तमारा बाह नी मरजी पुरी करवा हींड र्‌या। तीहयो ते सुरु गेथो हत्‌यारो से, अने तीहयो सच्‌चाय भणी कदी नी वळ्‌यो, अने काहाके सच्‌चाय तीनी मे हयेत नी। तीहयो जलम झुटेत मेक्‌या करे, काहाके तीहयो झुटो एतरोत नी, पण झुट नो बाह से। <verse eid="JHN 8:44" /><verse number="45" style="v" sid="JHN 8:45" />मे ह़ाची वात केम, करीन तमु मारी पोर भरहो नी करता। <verse eid="JHN 8:45" /><verse number="46" style="v" sid="JHN 8:46" />तमारी मे गेथा कोय मने पापी ठेरावे? अने कदी मे ह़ाची केम, ता तमु मार पोर भरहो काहा नी करता? <verse eid="JHN 8:46" /><verse number="47" style="v" sid="JHN 8:47" />जे भगवान वगे गेथो से, तीहयो भगवान नी वात ह़मळीन माने, आनीन करते तमु भगवान नी वात नी मान्‌ता; के तमु भगवान वगे गेथा हय।<verse eid="JHN 8:47" /></para>
  <para style="s">ईसु अने अब्‌राहम</para>
  <para style="p">
    <verse number="48" style="v" sid="JHN 8:48" />आहयी वात ह़मळीन युहदी माणहु ईसु ने केदा, “ह़ुं आमु ते तने वारु नी केता, के तु सामरी से, अने तने भुतड़ा चोट र्‌या।”<verse eid="JHN 8:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 8:49" />ईसु तीमने जपाप आप्‌यो, “मने भुतड़ा नी चोट्‌या। पण मे मारा बाह नु आबरु राख र्‌यो, अने तमु मारु आबरु ली र्‌या। <verse eid="JHN 8:49" /><verse number="50" style="v" sid="JHN 8:50" />मने मारी ईज्‌जत नी जोवती, पण एक जणो से जे, मारु आबरु राखवा नी हेर कर र्‌यो, अने नीयाव करन्‌यो से। <verse eid="JHN 8:50" /><verse number="51" style="v" sid="JHN 8:51" />मे तमने ह़ाची-ह़ाची आहयु केम, ‘जे कोय मारी ह़ीकापण ने मानीन पाळहे तीहयो जलम नी मरे।’”<verse eid="JHN 8:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JHN 8:52" />युहदी माणहु ईसु ने केदा, के आमु जाण ज्‌या के तने भुतड़ा चोट र्‌या: अब्‌राहम मर ज्‌यो, अने भगवान वगे गेथा वात केण्‌या माणहु बी मर ज्‌या, अने तु की र्‌यो के जे कोय मारी ह़ीकापण मानीन पाळहे, तीहयो कदी नी मरे। <verse eid="JHN 8:52" /><verse number="53" style="v" sid="JHN 8:53" />अमारो बाह अब्‌राहम ते मर ज्‌यो, अने भगवान वगे गेथा वात केण्‌या माणहु बी मर ज्‌या, तु अब्‌राहम गेथो मोटो से ह़ु? तु आह़फा ने ह़मजी ह़ु र्‌यो।<verse eid="JHN 8:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="JHN 8:54" />ईसु तीमने जपाप आप्‌यो, कदी मे मारी बड़ाय करु, ता मारी बड़ाय कंय बी नी, पण मारी बड़ाय करवा वाळो मारो बाह से, जीने तमु केवो, के हीय्‌यो अमारो भगवान से। <verse eid="JHN 8:54" /><verse number="55" style="v" sid="JHN 8:55" />तमु तीने कदी नी ओळख्‌या; पण मे तीने ओळखु; अने कदी मे केम के तीने नी ओळखु, ता मे बी तमारीन तेम झुटो से, पण मे तीने ओळखु अने तीनी ह़ीकापण मानीन पाळु। <verse eid="JHN 8:55" /><verse number="56" style="v" sid="JHN 8:56" />तमारो बाह अब्‌राहम मने देखवा करीन मारा आव्‌वा ना दाड़ा नी वाट जोवीन खुस हय ज्‌यो, अने तीहयो मने देख बी लेदो अने खुस हय ज्‌यो।<verse eid="JHN 8:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="JHN 8:57" />युहदी माणहु ईसु ने केदा, “हजु लग तारी उमर पचाह साल बी नी हयी, ते बी तु अब्‌राहम ने देखलो से?”<verse eid="JHN 8:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JHN 8:58" />ईसु तीमने केदो, “मे तमने ह़ाची-ह़ाची आहयु केम, अब्‌राहम पयदा नी हयो तीन गेथो पेल्‌नो, मे से।”<verse eid="JHN 8:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="JHN 8:59" />तत्‌यार युहदी माणहु ईसु ने मारवा करीन दगड़ा चुट लेदा, पण ईसु ह़ताय्‌न मंदीर मे गेथो जत र्‌यो।<verse eid="JHN 8:59" /></para>
  <chapter eid="JHN 8" />
  <chapter number="9" style="c" sid="JHN 9" />
  <para style="s">ईसु आंदळु जणायलु माणेह ने वारु करे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 9:1" />ईसु जवा बाज रेलो ता एक माणेह ने देख्‌यो, जे आंदळुत जणायलु हतु। <verse eid="JHN 9:1" /><verse number="2" style="v" sid="JHN 9:2" />अने ईसु ना चेला तीने पुछ्‌या, “ए मालीक! कोय पाप कर्‌यु हहे, के आहयु आंदळु पयदा हयु, आहयो माणेह, के आना आह्‌य-बाहा पाप कर्‌या हहे?”<verse eid="JHN 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 9:3" />ईसु तीमने जपाप आप्‌यो, के नी ते आहयो पाप कर्‌यो, अने नी ते आना आह्‌य-बाहा पाप कर्‌या, पण आहयु आनीन करते हयु, के आनी जीवाय मे भगवान ना काम देखाव पड़े। <verse eid="JHN 9:3" /><verse number="4" style="v" sid="JHN 9:4" />जे मने मोकल्‌लो से; तीना काम आमने दीहु-दीहु पुरा कर लेवा आपणी जुगु जरुड़ी से: तीहयी रात आव्‌वा वाळी से तीनी मे कोय काम नी कर सके। <verse eid="JHN 9:4" /><verse number="5" style="v" sid="JHN 9:5" /><note caller="+" style="x"><char style="xo" closed="false">9:5 </char><char style="xt" closed="false"><ref loc="MAT 5:14">मत्‌ती 5:14</ref>; <ref loc="JHN 8:12">युहन्‌ना 8:12</ref></char></note>जत्‌यार लग मे कळी मे से, तत्‌यार लग मे कळी ना माणहु जुगु वीजाळु से।<verse eid="JHN 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 9:6" />आहयु कीदीन ईसु भोयमे थुप्‌यो, अने थुपे करीन धुळो कोहणीन आंदळा ना डोळे चोपड़ी देदो। <verse eid="JHN 9:6" /><verse number="7" style="v" sid="JHN 9:7" />अने तीने केदो; “जा सीलोम नाम ना हळावा मे धोय ले।” सीलोम नाम नु मतलब से मोकल्‌लो, एतरे तीहयो जाय्‌न डोळा धोय लेदो, अने देखवा बाज ज्‌यो, अने पासो आवती र्‌यो।<verse eid="JHN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 9:8" />ता आनी आड़े-धेड़े वाळा अने जे आने पेले भीक मांगत्‌ले देखला हता, तीहया देखीन केदा, आहयु तीहयुत आंदळु नी हय ह़ु? जे पेले बहीन भीक मांग्‌या करतु हतु?<verse eid="JHN 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 9:9" />थोड़ाक माणहु केदा, आहयो तीहयोत से, अने थोड़ाक केदा, आहयो तीहयो नी हय, पण तीनीन तेवो से, तीहयो केदो “मे तीहयोत से।”<verse eid="JHN 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 9:10" />ता तीहया तीने पुछवा बाज ज्‌या, तारा डोळा कीसम उगड़ी ज्‌या?<verse eid="JHN 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 9:11" />तीहयो जपाप आप्‌यो, के ईसु नाम नो एक माणेह थुपे करीन धुळो कोहणीन मारा डोळा पोर चोपड़ी देदो, अने मने केदो, “सीलोम मे जाय्‌न धोय ले, अने मे जाय्‌न धोय लेदो, अने देखवा बाज ज्‌यो।”<verse eid="JHN 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 9:12" />तीहया तीने पुछ्‌या; “तीहयो कां से?”</para>
  <para style="p" vid="JHN 9:12">तीहयो केदो, “मे नी जाणतो।”<verse eid="JHN 9:12" /></para>
  <para style="s">फरीस्‌या नी लारे आरगाय नी जाच पड़ताव</para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 9:13" />माणहु जे पेले आंदळु हतु तीने फरीसीन तां ली ज्‌या। <verse eid="JHN 9:13" /><verse number="14" style="v" sid="JHN 9:14" />जे दाड़े ईसु धुळो कोहणीन आंदळु ना डोळा उगाड़लो, तीहयो अराम नो दाड़ो हतो। <verse eid="JHN 9:14" /><verse number="15" style="v" sid="JHN 9:15" />अळी फरीसी बी तीने पुछ्‌या, तु कीसम देखवा बाज ज्‌यो। तीहयो तीमने केदो, तीहयो मारा डोळा पोर धुळो लगाड़्‌यो अने अळतेण मे धोय लेदो, अने देखवा बाज ज्‌यो।<verse eid="JHN 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 9:16" />आहयी वात ह़मळीन थोड़ाक फरीसी केदा; ईसु भगवान वगे गेथो आवलो माणेह नी हय, काहाके हीय्‌यो अराम ना दाड़ा ने नी पाळतो।</para>
  <para style="p" vid="JHN 9:16">अने थोड़ाक जणा केदा, पापी माणेह जुदा-काम नी सेलाणी कीसम देखाड़ सके? एतरे तीमनी मे बेरजाव पड़ ज्‌यो।<verse eid="JHN 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 9:17" />तीहया आंदळा माणेह ने अळी पुछ्‌या, “जे माणेह तारा डोळा वारु करलो से, तु तीना बारा मे ह़ु केय?” तीहयो केदो, “तीहयो भगवान वगे गेथी वात केण्‌यो से।”<verse eid="JHN 9:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 9:18" />युहदी ने भरहो नी हयो के आहयो पेले आंदळो हतो अने हाव देखवा बाज र्‌यो, एतरे तीहया तीना आह्‌य-बाहा ने बोलाया। <verse eid="JHN 9:18" /><verse number="19" style="v" sid="JHN 9:19" />अने तीमने पुछ्‌या, “आहयो तमारो बेटो से ह़ु? आहयो जणायो तार नो आंदळो हतो ह़ु? आंदळो की र्‌या ता हाव कीसम देखवा बाज ज्‌यो?”<verse eid="JHN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 9:20" />तीना आह्‌य-बाहा जपाप आप्‌या, “आमु जाणये के आहयो अमारो बेटो से, अने आहयो आंदळोत पयदा हयलो। <verse eid="JHN 9:20" /><verse number="21" style="v" sid="JHN 9:21" />पण आमु नी जाणता के हीय्‌यो हाव कीसम देखे; अने आहयु बी नी जाणता के आना डोळा कोय वारु कर्‌यो, हीनेत पुछ लेवो; हीय्‌यो नान्‌लो नी हय हीना बारा मे देखाड़ देहे।” <verse eid="JHN 9:21" /><verse number="22" style="v" sid="JHN 9:22" />आहयी वात तीना आह्‌य-बाहा आनीन करते केदला काहाके तीहया युहदी सी बीहता हता; काहाके युहदी माणहु एको कर र्‌या हता, के ईसु ने कोय बी मसी करीन मान लेहे, ता आपणु आपणा भक्‌ती ना घोर मे गेथो बारो कर देह़ु। <verse eid="JHN 9:22" /><verse number="23" style="v" sid="JHN 9:23" />एतरे तीना आह्‌य-बाहा केदला, के हीय्‌यो नान्‌लो नी हय; हीनेत पुछ लेवो।<verse eid="JHN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 9:24" />ता तीहया तीहयु माणेह ने जे आंदळु हतु अळी बोलाय्‌न तीने केदा, नीस्‌ती भगवान नी बड़ाय कर काहाके आमु जाणये के हीय्‌यो माणेह पापी से।<verse eid="JHN 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 9:25" />तीहयो जपाप देदो, मे नी जाणतो के तीहयो पापी से के नी हय: पण मे आतरुत जाणु के मे आंदळो हतो अने हाव देखु।<verse eid="JHN 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 9:26" />तीहया तीने अळी पुछ्‌या, “तीहयो ह़ु कर्‌यो? अने तारा डोळा ने कीसम वारु कर्‌यो?”<verse eid="JHN 9:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 9:27" />तीहयो केदो, “मे तमने पेलेत की देदो, हाव अळी काहा ह़मळवा हींड र्‌या? तमु बी तीना चेला बणवा हींड र्‌या ह़ु?”<verse eid="JHN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 9:28" />तत्‌यार तीहया तीने वडीन केदा, तु तीनो चेलो से; आमु ते मुसा ना चेला से। <verse eid="JHN 9:28" /><verse number="29" style="v" sid="JHN 9:29" />आमु जाणये के भगवान मुसा ह़ाते वात कर्‌यो; पण आहया ईसु ने आमु नी जाणता के हीय्‌यो कां गेथो आवलो से।<verse eid="JHN 9:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 9:30" />तीहयो तीमने केदो, अला! आहयी घणी जुदी वात से, के तमु नी जाणता के कां वाळो से ते बी तीहयो मारा डोळा उगाड़ देदो। <verse eid="JHN 9:30" /><verse number="31" style="v" sid="JHN 9:31" />आमु जाणये के भगवान पापी माणहु नी, नी ह़मळे, पण तीनीत ह़मळे जे भगवान नी भक्‌ती करतो हय, अने भगवान नी मरजी पोर चालतो हय। <verse eid="JHN 9:31" /><verse number="32" style="v" sid="JHN 9:32" />कळ घड़ायी तां गेथु आज लग, आहयु ह़मळवा मे नी आयु, के कोय आंदळो जणायला माणेह ना डोळा उगाड़ीन वारु कर्‌यो हय। <verse eid="JHN 9:32" /><verse number="33" style="v" sid="JHN 9:33" />कदी आहयो माणेह भगवान वगे गेथो नी हतो, ता आहयो कंय बी नी कर सकतो।<verse eid="JHN 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 9:34" />तीहया तीने केदा, “तु ते पाप मेत पयदा हयलो से, अने आमने ह़ीकाड़वा बाज र्‌यो” आसम कीन तीहया तीने बारो नीकाळ देदा।<verse eid="JHN 9:34" /></para>
  <para style="s">वारु हयलु आंदळु माणेह ईसु पोर पक्‌को भरहो करे</para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 9:35" />ईसु ह़मळ्‌यो के, तीहया तीने बारो कर देदला से, अने अळतेण ईसु तीने भेट्‌यो ता केदा, “तु मनख्‌या ना सोरा पोर भरहो करे ह़ु?”<verse eid="JHN 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 9:36" />ता तीहयो केदो, “ए मालीक! तीहयो कोय से के मे तीनी पोर भरहो करु।”<verse eid="JHN 9:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 9:37" />ईसु तीने केदो, “तु तीने देखलो बी से, अने जे तार ह़ाते वात करवा बाज र्‌यो तीहयोत से।”<verse eid="JHN 9:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 9:38" />अने तीहयो ईसु ने केदो, “ए मालीक! मे भरहो करु।” अने तीने वांद्‌यो।<verse eid="JHN 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 9:39" />तत्‌यार ईसु केदो, “मे आहयी कळी मे माणहु नो नीयाव करवा आवलो से के, जे आंदळा से तीहया देखवा बाज जाय, अने जे देखे तीहया आंदळा हय जाय।”<verse eid="JHN 9:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 9:40" />फरीसी ईसु ह़ाते हता, तीहया आहयी वात ह़मळीन ईसु ने केदा, आमु बी आंदळा से ह़ु?<verse eid="JHN 9:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 9:41" />ईसु तीमने केदो, तमु आंदळा हता, ता तमु पापी नी गणाता, पण हमणे ते तमु की र्‌या के आमु देखत्‌ला से, एतरे तमु पापीत गणाय र्‌या।<verse eid="JHN 9:41" /></para>
  <chapter eid="JHN 9" />
  <chapter number="10" style="c" sid="JHN 10" />
  <para style="s">गुवाळ्‌यो अने तीना गाडरा</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 10:1" />मे तमने ह़ाची-ह़ाची केम, जे कोय गाडरा ना वाड़ा ना झापले माय्‌न नी भराय, पण कानी बीजी धेड़े सी चड़ जाय, तीहयो चोट्‌टो अने गुंडो से। <verse eid="JHN 10:1" /><verse number="2" style="v" sid="JHN 10:2" />पण जे गाडरा ना वाड़ग्‌या ना झापले माय्‌न भराय, तीहयो गाडरा नो गुवाळ्‌यो से। <verse eid="JHN 10:2" /><verse number="3" style="v" sid="JHN 10:3" />अने तीनी जुगु झापले पेहरो देण्‌यो झापलु उगाड़ देय। अने गाडरा तीनी बोली ह़मळी लेय, अने तीहयो तीना गाडरा ने एकीक ने नाम धरी-धरीन बोलावे, अने बारा ली जाय। <verse eid="JHN 10:3" /><verse number="4" style="v" sid="JHN 10:4" />अने जत्‌यार तीहयो आखा गाडरा ने बारा काड लेय, ता तीहयो तीमनी अगळ-अगळ चाले, अने गाडरा तीनी पसळ-पसळ आवे, काहाके गाडरा तीनी बोली ओळखी लेय। <verse eid="JHN 10:4" /><verse number="5" style="v" sid="JHN 10:5" />पण गाडरा अंजाण्‌या पसळ नी जाय, पण तीने देखीन नाह्‌ह़े, काहाके तीहया अंजाण्‌या नी बोली ने ओळखे।<verse eid="JHN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 10:6" />ईसु तीमने आहयो दाखलो केदो, पण तीहया ह़मजी नी सक्‌या, के आहयी ह़ु वात से जे आमने की र्‌यो।<verse eid="JHN 10:6" /></para>
  <para style="s">ईसु वारलो गुवाळ्‌यो</para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 10:7" />तत्‌यार ईसु तीमने अळी केदो, “मे तमने ह़ाची-ह़ाची केम, के गाडरा नु झापलु मे से।” <verse eid="JHN 10:7" /><verse number="8" style="v" sid="JHN 10:8" />जेतरा बी पेले आया; तीहया आखा चोट्‌टा अने गुंडा हता। पण गाडरा तीमनी नी ह़मळ्‌या। <verse eid="JHN 10:8" /><verse number="9" style="v" sid="JHN 10:9" />झापलु मे से, कदी कोय मारा झापले मोय जहे ता छुटकारो जड़हे अने मोय बारो आया जीया करहे अने चारो जड़हे। <verse eid="JHN 10:9" /><verse number="10" style="v" sid="JHN 10:10" />चोट्‌टो नीस्‌तो चोरी करवा, मारवा, अने खत्‌तम करवा आवे, पण मे आनीन करते आवलो से, के माणहु जीवाय हात करे, अने पुरीन-पुरी हात करे। <figure style="fig" alt="Shepherd with his sheep in sheepfold" file="lb00014c.tif" size="span" copy="Horace Knowles ©" ref="10:7">गाडरा ना कुंडवाड़ा मे गाडरा ह़ाते गुवाळ्‌यो</figure><verse eid="JHN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 10:11" />वारलो गुवाळ्‌यो मे से, वारलो गुवाळ्‌यो गाडरा ना लेदे आह़फा नो जीव बी आप देय। <verse eid="JHN 10:11" /><verse number="12" style="v" sid="JHN 10:12" />पावर्‌यो जे नी गुवाळ्‌यो हय, अने नी गाडरा नो मालीक हय, तीहयो लेंड्‌या ने आवत्‌ला देखीन गाडरा ने नाखीन नाह जाय, अने लेंड्‌या गाडरा ने धर लेय, अने गाडरा ने रीवण्‌या-तीवण्‌या कर देय। <verse eid="JHN 10:12" /><verse number="13" style="v" sid="JHN 10:13" />पावोर आनीन करते नाह जाय, काहाके तीहयो पावोर से, अने तीने गाडरा नी फीकर नी हय। <verse eid="JHN 10:13" /><verse number="14" style="v" sid="JHN 10:14" /><note caller="+" style="x"><char style="xo" closed="false">10:14 </char><char style="xt" closed="false"><ref loc="MAT 11:27">मत्‌ती 11:27</ref>; <ref loc="LUK 10:22">लुका 10:22</ref></char></note>वारलो गुवाळ्‌यो मे से, जीसम मारो भगवान बाह मने जाणे, अने मे मारा भगवान बाह ने जाणु। <verse eid="JHN 10:14" /><verse number="15" style="v" sid="JHN 10:15" />तेमेत मे मारा गाडरा ने जाणु, अने मारा गाडरा मने जाणे, अने मे मारा गाडरा जुगु मारो जीव बी आप देम। <verse eid="JHN 10:15" /><verse number="16" style="v" sid="JHN 10:16" />अने मारा अळी बी गाडरा से, तीहया आहया गाडरा ना वाड़ा ना नी हय; तीमने बी मे लावही, तीहया बी मारी बोली ह़मळहे अने आखा एकीत टोळो बण जहे, अने तीमनो एकीत गुवाळ्‌यो रेहे।<verse eid="JHN 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 10:17" />मारो बाह मने आनीन करते मोंग करे, के मे मारो जीव आप देम, अने पासो बी ली लेम। <verse eid="JHN 10:17" /><verse number="18" style="v" sid="JHN 10:18" />कोय बी मारा जीव ने हापकी नी सके, पण मे मारा जीव ने आप देम; मने मारा बाह पांह गेथो मारो जीव आपवा नो बी हक जड़लो से, अने पासो मांगवा नो बी हक जड़लो से, आहयो हुकम मने मारा बाह पांह गेथो जड़लो से।<verse eid="JHN 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 10:19" />आहयी वात ह़मळीन युहदी माणहु मे अळी बेरजाव पड़ ज्‌यो। <verse eid="JHN 10:19" /><verse number="20" style="v" sid="JHN 10:20" />घणा माणहु केता हता, के हीने भुतड़ा लागला से, अने हीय्‌यो गंडवाय र्‌यो। तमु हीनी काहा ह़मळो?<verse eid="JHN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 10:21" />पण बीजा माणहु केता हता, के आहयी वात भुतड़ा लागला माणेह नी नी हय, भुतड़ो आंदळा ना डोळा ने वारु कर सके ह़ु?<verse eid="JHN 10:21" /></para>
  <para style="s">युहद्‌या नो वण-भरहो</para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 10:22" />यरुसलेम मे मंदीर ने भगवान ना हात मे ह़ोपवा नो तीवार आयो। तीहयी टेमे टाड ना दाड़ा हता। <verse eid="JHN 10:22" /><verse number="23" style="v" sid="JHN 10:23" />अने ईसु मंदीर मे सुलेमान ना मांडवा मे हींडतो हतो। <verse eid="JHN 10:23" /><verse number="24" style="v" sid="JHN 10:24" />तत्‌यार युहदी ईसु ने घेरवी लेदा, अने पुछ्‌या, “तु आमने कत्‌यार लग भुले पाड़ रेही? कदी तु मसी हय ता आमने ह़ुते देखाड़ दे।”<verse eid="JHN 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 10:25" />ईसु तीमने जपाप आप्‌यो, मे तमने की देदो, पण तमु भरहो नी करता, जे जुदा-कामु मे मारा बाह ना नाम सी कर र्‌यो, तीहयात मारा गवा से। <verse eid="JHN 10:25" /><verse number="26" style="v" sid="JHN 10:26" />पण तमु भरहो नी करता, काहाके तमु मारा गाडरा नी हय। <verse eid="JHN 10:26" /><verse number="27" style="v" sid="JHN 10:27" />मारा गाडरा मारी बोली जाण लेय, अने मे हीमने जाणु, अने हीय्‌या मारी पसळ-पसळ चाले। <verse eid="JHN 10:27" /><verse number="28" style="v" sid="JHN 10:28" />अने मे तीमने अमर जीवाय आपु, अने तीहयी कदी जलमकी खुटे नी, अने कोय हीमने मारा हात मे गेथा हापकी नी सके। <verse eid="JHN 10:28" /><verse number="29" style="v" sid="JHN 10:29" />मारो बाह, जे हीमने मारा सुपरत करलो से, तीहयो आखा गेथो मोटो से, एतरे हीमने बाह ना हात मे गेथा हापकी नी सके। <verse eid="JHN 10:29" /><verse number="30" style="v" sid="JHN 10:30" />मे अने मारो बाह एक से।<verse eid="JHN 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 10:31" />युहदी ईसु ने मारवा करीन अळी दगड़ा चुट्‌या। <verse eid="JHN 10:31" /><verse number="32" style="v" sid="JHN 10:32" />ता ईसु तीमने केदो, “मे मारा बाह ना कीया मे घणा ढेरका भला काम देखाड़्‌यो। तीहया काना काम ना करते मने दगड़ाटीन मारवा हींड र्‌या?”<verse eid="JHN 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 10:33" />तत्‌यार युहद्‌या केदा, भला काम ना करते नी, पण तु भगवान नी नामबद्‌दी कर र्‌यो, अने तु माणेह हय्‌न बी खुद ने भगवान बणावे।<verse eid="JHN 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 10:34" />ईसु तीमने जपाप आप्‌यो, ह़ुं तमारी सास्‌तर मे आसम नी लीखलु हय, मेत केदो, तमु देवता से? <verse eid="JHN 10:34" /><verse number="35" style="v" sid="JHN 10:35" />कदी तीहयो तीमने देवता केदो जीनी पांह भगवान आह़फा नो बोल पुगाड़लो, अने खरला सास्‌तर मे लीखलु कदी नी टळ सके। <verse eid="JHN 10:35" /><verse number="36" style="v" sid="JHN 10:36" />ता जीने बाह चोखलो बणावीन कळ मे मोकल्‌लो से, तमु तीने की र्‌या, तु नामबद्‌दी कर र्‌यो, एतरे के मेत केदो, मे भगवान नो बेटो से। <verse eid="JHN 10:36" /><verse number="37" style="v" sid="JHN 10:37" />कदीम मे मारा बाह नु काम नी करतो हय, ता मारी पोर भरहो ना करो। <verse eid="JHN 10:37" /><verse number="38" style="v" sid="JHN 10:38" />पण कदी मे काम करतो हय, ता भले मारी पोर भरहो ना बी करो, पण तीहया कामु पोर भरहो करो, काहाके तमु जाणो, अने ह़मजो, के बाह मारी मे से, अने मे बाह मे से।<verse eid="JHN 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 10:39" />तत्‌यार युहदी अळी ईसु ने धरवा हींड्‌या पण ईसु तीमना हात सी नीकळ ज्‌यो।<verse eid="JHN 10:39" /></para>
  <para style="s">ईसु यरदन नंदी ना ह़ेली धेड़े जाय</para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 10:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:40 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:28">युहन्‌ना 1:28</ref>
      </char>
    </note>ईसु यरदन नंदीन ह़ेली धेड़े तीहया जागे अळी ज्‌यो, जां युहन्‌नो पेले बपतीस्‌मा आप्‌या करतो हतो, अने तांत र्‌यो। <verse eid="JHN 10:40" /><verse number="41" style="v" sid="JHN 10:41" />अने घणा ढेरका माणहु ईसुन्‌तां आय्‌न केता हता, युहन्‌नो ते जुदा-काम नी सेलाणी नी देखाड़्‌यो, पण जे कंय ईसु ना बारा मे केदलो तीहयु आखु ह़ाचलीन हयलु। <verse eid="JHN 10:41" /><verse number="42" style="v" sid="JHN 10:42" />अने तां घणा ढेरका माणहु ईसु पोर भरहो कर्‌या।<verse eid="JHN 10:42" /></para>
  <chapter eid="JHN 10" />
  <chapter number="11" style="c" sid="JHN 11" />
  <para style="s">लाजर नी मोत</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 11:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:38">लुका 10:38</ref>,<ref loc="LUK 10:39">39</ref></char>
    </note>बेतन्‌या गाम मे तीन भाय-बेन्‌या रेता हता, लाजर अने तीनी बे बेनेह मारथा अने मरीयम। <verse eid="JHN 11:1" /><verse number="2" style="v" sid="JHN 11:2" /><note caller="+" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="JHN 12:3">युहन्‌ना 12:3</ref></char></note>आहयी मरीयम मालीक ईसु ना पोगु पोर ईत्‌तर रेड़ीन नीम्‌बाळा वेते तीना पोगु नुसवा वाळी हती, आनोत भाय लाजर मांदलो हतो। <verse eid="JHN 11:2" /><verse number="3" style="v" sid="JHN 11:3" />लाजर ना बेन्‌या ईसुन्‌तां आहयु की मोकल्‌या, “ए मालीक! ह़मळ, जीने तु मोंग करे तीहयो मांदलो से।”<verse eid="JHN 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 11:4" />आहयी वात ह़मळीन ईसु केदो, आहयी मंदवाड़ मारवा नी नी हय, पण भगवान नी बड़ाय ना लेदे से, तीना लारे भगवान ना बेटा नी बड़ाय हये।<verse eid="JHN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 11:5" />ईसु लाजर ने अने तीना बेन्‌या मारथा अने मरीयम ने मोंग करतो हतो। <verse eid="JHN 11:5" /><verse number="6" style="v" sid="JHN 11:6" />जत्‌यार ईसु ह़मळ्‌यो, के लाजर मांदलो से, ता ईसु जां हतो तां बे दाड़ा अळी री ज्‌यो। <verse eid="JHN 11:6" /><verse number="7" style="v" sid="JHN 11:7" />बे दाड़ा वीत ज्‌यान अळतेण ईसु चेला ने केदो, “चालो आपणु अळी युहद्‌या मे जता।”<verse eid="JHN 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 11:8" />चेला ईसु ने केदा, “हे गुरु! पेले ते युहदी दगड़ाटीन मारवा हींडता हता, अने तु अळी तात जवा हींड र्‌यो?”<verse eid="JHN 11:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 11:9" />ईसु जपाप आप्‌यो, “दीह़ु ना बारे घंटा नी हवे ह़ु? कदी कोय दीह़ु चाले, ता तीहयो ठेहवाय नी, काहाके तीनी जुगु देखवा ना लेदे कळी नु वीजाळु से। <verse eid="JHN 11:9" /><verse number="10" style="v" sid="JHN 11:10" />पण कोय अंदारला मे चाले, तीहयो ठेहवाय जाय काहाके तीनी जुगु देखवा करीन वीजाळु नी हय।” <verse eid="JHN 11:10" /><verse number="11" style="v" sid="JHN 11:11" />ईसु आहयी वात केदो, अने अळतेण तीमने केदो, आपणो दोस्‌तीदार लाजर ह़ुय जेलो से; पण मे तीने जगाड़वा जाम।<verse eid="JHN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 11:12" />तत्‌यार चेला तीने केदा, “ए मालीक! कदी तीहयो ह़ुय र्‌यो हहे, ता आरगो हय जहे।”<verse eid="JHN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 11:13" />ईसु ते लाजर नी मोत ना बारा मे केदलो, पण चेला ह़मज्‌या के लाजर नींदर मे ह़ुव्‌वा बाज र्‌यो हहे। <verse eid="JHN 11:13" /><verse number="14" style="v" sid="JHN 11:14" />ता ईसु तीमने चोखुझण की देदो, लाजर मर जेलो से। <verse eid="JHN 11:14" /><verse number="15" style="v" sid="JHN 11:15" />ते बी मे तमारीन करते खुस से, के मे लाजर मर्‌यो तीहयी टेमे तां नी हतो, काहाके तमु पक्‌को भरहो करो। पण हाव चालो आपणु तीनीन्‌तां जीया।<verse eid="JHN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 11:16" />तत्‌यार थोमस जे दीदुमस केवातो हतो, आह़फा ना ह़ाती चेला ने केदो, चालो आपणु बी हीनी ह़ाते मरवा जता।<verse eid="JHN 11:16" /></para>
  <para style="s">ईसु लाजर ना बेन्‌या ने सांती आप्‌यो</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 11:17" />जत्‌यार ईसु बेतन्‌या गाम मे पुग्‌यो ता पतो चाल्‌यो के लाजर ने मड़ाट्‌या मे डाट्‌ला च्‌यार दाड़ा हय ज्‌या। <verse eid="JHN 11:17" /><verse number="18" style="v" sid="JHN 11:18" />बेतन्‌या गाम यरुसलेम गेथु तीन कीलोमीटर नी आड़े-धेड़े नाम्‌बे हतु। <verse eid="JHN 11:18" /><verse number="19" style="v" sid="JHN 11:19" />अने घणा ढेरका युहदी भाय लाजर नी मोत नी खबर ह़मळीन तीना बेन्‌या मारथा अने मरीयम ने सांती आपवा आय र्‌या हता।<verse eid="JHN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 11:20" />जत्‌यार मारथा ह़मळी के ईसु आव्‌वा बाज र्‌यो, ता तीहयी तीने भेटवा करीन बारथी जी, पण मरीयम घोर मेत री। <verse eid="JHN 11:20" /><verse number="21" style="v" sid="JHN 11:21" />मारथा ईसु ने केदी, “ए मालीक! कदी तु आञे रेतो, ता मारो भाय कदी नी मरतो। <verse eid="JHN 11:21" /><verse number="22" style="v" sid="JHN 11:22" />अने मे जाणु के तु हमणे बी भगवान पांह जे मांगही तीहयुत तने आप देहे।”<verse eid="JHN 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 11:23" />ईसु मारथा ने केदो, “तारो भाय जीवतो हय जहे।”<verse eid="JHN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 11:24" />मारथा ईसु ने केदी, मने पतो से, के आखरी दाड़े मारो भाय बी जीवतो हय जहे।<verse eid="JHN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 11:25" />ईसु तीने केदो, मरला मे गेथा जीवता करन्‌यो अने अमर जीवाय आपण्‌यो मे से, पण जे मारी पोर भरहो करे तीहयो मरी बी जहे ते बी जीवतो हय जहे। <verse eid="JHN 11:25" /><verse number="26" style="v" sid="JHN 11:26" />अने जे कोय जीवत्‌लो से, अने मारी पोर भरहो करे तीहयो जलम लग नी मरे, तु आहयी वात पोर भरहो करे ह़ु?<verse eid="JHN 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 11:27" />मारथा केदी, होव मालीक! मे भरहो करु के आहयी कळी मे आव्‌वा वाळो भगवान नो बेटो मसी तु से।<verse eid="JHN 11:27" /></para>
  <para style="s">लाजर ने जीवाड़नु</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 11:28" />आहयु कीदीन तीहयी जत री, अने आह़फी नी बेनेह मरीयम ने बोलाय्‌न होगीत तीने केदी, मालीक! आय र्‌यो तीहयो तने बोलाय र्‌यो। <verse eid="JHN 11:28" /><verse number="29" style="v" sid="JHN 11:29" />आहयु ह़मळीन मरीयम छोटीत उठीन ईसुन्‌तां आयी। <verse eid="JHN 11:29" /><verse number="30" style="v" sid="JHN 11:30" />ईसु हजु गाम मे नी पुगलो हतो, पण तांत हतो, जां ह़ारीक तीने मारथा भेटली। <verse eid="JHN 11:30" /><verse number="31" style="v" sid="JHN 11:31" />तत्‌यार जे युहदी तीनी ह़ाते घोर मे हता, तीने सांती आपता हता, तीहया आहयु देख्‌या के मरीयम उचकाली उठीन बारी चाल पड़ी, ता तीहया आसम ह़मज्‌या के हीय्‌यी मड़ाट्‌या मे रड़वा करीन जती हहे, करीन तीहया बी तीनी पसळ चाल पड़्‌या।<verse eid="JHN 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JHN 11:32" />मरीयम ते जागे पुगी, जां ईसु हतो, अने ईसु ने देखतेत तीना पोगु पोर पड़ी अने केदी, “ए मालीक! कदी तु आञे रेतो ता मारो भाय नी मरतो।”<verse eid="JHN 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 11:33" />जत्‌यार ईसु मरीयम अने तीनी ह़ाते आवला युहदी ने रड़त्‌ला देख्‌यो, ता ईसु आत्‌मा मे घणोत नराज हय ज्‌यो अने घबराय्‌न केदो, “तीने तमु कां ह़रा वगे करला से।” <verse eid="JHN 11:33" /><verse number="34" style="v" sid="JHN 11:34" />तीहया ईसु ने केदा, “ए मालीक! चाल आवीन देख ले।”<verse eid="JHN 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 11:35" />अने ईसु रड़्‌यो। <verse eid="JHN 11:35" /><verse number="36" style="v" sid="JHN 11:36" />ता युहदी केवा बाज ज्‌या, देखो! आहयो लाजर ने घणो मोंग करतो हतो।<verse eid="JHN 11:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 11:37" />पण थोड़ाक माणहु केदा, “आहयो ते आंदळा ना डोळा उगाड़्‌यो, ता आहयो लाजर ने काहा नी बचाड़्‌यो?”<verse eid="JHN 11:37" /></para>
  <para style="s">ईसु लाजर ने जीवतो कर्‌यो</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 11:38" />आहयु ह़मळीन ईसु मन मे अळी उदास हयो, अने तीहयो मड़ाट्‌यान्‌तां ज्‌यो अने तीहयो एक खाडो हतो, अने एक दगड़ो तीनी पोर मेकलो हतो। <verse eid="JHN 11:38" /><verse number="39" style="v" sid="JHN 11:39" />ईसु केदो, “दगड़ो हेड़ देवो।” मरला लाजर नी बेनेह मारथा केदी, “ए मालीक! लाजर ने मरलो च्‌यार दाड़ा हय ज्‌या, हाव ते तीनु धोड़ गंदातु हहे।”<verse eid="JHN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 11:40" />ईसु मारथा ने केदो, ह़ुं मे तने नी केदो के, कदी तु भरहो करही, ता तु भगवान नी बड़ाय देखही। <verse eid="JHN 11:40" /><verse number="41" style="v" sid="JHN 11:41" />तत्‌यार तीहया ते दगड़ा ने हेड़ देदा, अने ईसु ह़रग भणी भाळीन केदो, “ए बाह, मे तने घणो जुगाळो केम के तु मारी वीन्‌ती ह़मळी लेदो। <verse eid="JHN 11:41" /><verse number="42" style="v" sid="JHN 11:42" />अने मे जाणु, के तु सदा मारी वीन्‌ती ने ह़मळे, पण जे आड़े-धेड़े उबा हय र्‌या, तीना कारण मे आहयु केदो, जीनी सी के आहया भरहो करे, के तुत मने मोकल्‌लो से।” <verse eid="JHN 11:42" /><verse number="43" style="v" sid="JHN 11:43" />आहयु कीदीन ईसु आड़ीन केदो, “ए लाजर! बारो नीकळ्‌याव!” <verse eid="JHN 11:43" /><verse number="44" style="v" sid="JHN 11:44" />तीहयो मरलो लाजर जीवतो हय्‌न बारथो नीकळ आयो। तीना मोडे अने हाते-पोगे लुगड़ा ना पाटा बांदला हता। ईसु तीमने केदो, हीना पाटा सोड़ देवो।<verse eid="JHN 11:44" /></para>
  <para style="s">ईसु ने मारवा नी जाळसादी</para>
  <para style="p">
    <verse number="45" style="v" sid="JHN 11:45" />तत्‌यार जे युहदी मरीयम ने तां आय र्‌या हता, तीहया आहयु जुदु काम देख्‌या, अने तीमनी मे गेथा ढेरेत जणा ईसु पोर भरहो कर्‌या। <verse eid="JHN 11:45" /><verse number="46" style="v" sid="JHN 11:46" />पण थोड़ाक जणा जाय्‌न फरीसी माणहु ने ईसु ना आहया जुदा-काम ना बारा मे की देदा। <verse eid="JHN 11:46" /><verse number="47" style="v" sid="JHN 11:47" />एतरे डायला पुंजारा अने फरीसी भेसकाय्‌न पंचु बहाड़ीन केदा, आपणु ह़ु करया? हीय्‌यो माणेह ते जुदा-काम देखाड़े। <verse eid="JHN 11:47" /><verse number="48" style="v" sid="JHN 11:48" />कदी आपणु हीने आसमेत करवा देह़ु, ता आखा हीनी पोर भरहो करवा बाज जहे, अने रोमी माणहु आवीन आपणा जागा पोर अने आपणी आखी जाती पोर हक जमाड़ लेहे।<verse eid="JHN 11:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="JHN 11:49" />तत्‌यार तीमनी मे गेथो एक जणो जीनु नाम केफा हतु, अने तीहयो ते साल नो डायलो पुंजारा हतो, तीहयो तीमने केदो, तमने जरीक बी मालम नी हय ह़ु? <verse eid="JHN 11:49" /><verse number="50" style="v" sid="JHN 11:50" />जरीक ते वीच्‌यार करो; आपणा माणहु जुगु एक माणेह मरहे, ता आपणी आखी जाती बच जहे, आपणी जुगु आहयु वारलु रेहे। <verse eid="JHN 11:50" /><verse number="51" style="v" sid="JHN 11:51" />आहयी वात तीहयो आह़फा भणी गेथी नी केदो, पण तीहया साल नो डायलो पुंजारो हय्‌न अगी हयवा वाळी वात केदो, के ईसु ते आखी जाती ना लेदे मरहे। <verse eid="JHN 11:51" /><verse number="52" style="v" sid="JHN 11:52" />ईसु युहदी जाती जुगु एतरोत नी, पण रीवण्‌या-तीवण्‌या हयला भगवान ना माणहु ने भेळा करवा करीन मरहे।<verse eid="JHN 11:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="JHN 11:53" />ते दाड़े गेथा तीहया ईसु ने मार नाखवा नो पक्‌को वीच्‌यार कर्‌या। <verse eid="JHN 11:53" /><verse number="54" style="v" sid="JHN 11:54" />करीन ईसु ते दाड़े गेथो युहद्‌या मे उजन्‌तो नी फीर्‌यो; पण तां गेथो बड़ा धेड़े वाळा एप्‌रेम नाम ना ह़ेर मे जाय्‌न तीना चेला ह़ाते रेवा बाज ज्‌यो।<verse eid="JHN 11:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="JHN 11:55" />अने युहदी नो फसह नो तीवार ह़ाते आय र्‌यो हतो, एतरे फसह ना तीवार ना पेले आह़फा ने चोखा करवा करीन घणा माणहु गाम-खेड़ा मे गेथा यरुसलेम ह़ेर मे आय र्‌या हता। <verse eid="JHN 11:55" /><verse number="56" style="v" sid="JHN 11:56" />तीहया ईसु ने ह़ोदवा बाज ज्‌या अने मंदीर मे उबा हय्‌न आह़फा-आह़फा केवा बाज ज्‌या, तमु ह़ुं ह़मजी र्‌या? ह़ुं तीहयो तीवार मे नी आवे? <verse eid="JHN 11:56" /><verse number="57" style="v" sid="JHN 11:57" />डायला पुंजारा अने फरीसी पेलेत आहयो हुकम आप देदला हता, के “तमारी मे गेथा कोयने बी मालम पड़ जाय के ईसु कां से ता आवीन की देजो आमु हीने धराय देह़ु।”<verse eid="JHN 11:57" /></para>
  <chapter eid="JHN 11" />
  <chapter number="12" style="c" sid="JHN 12" />
  <para style="s">बेतन्‌या मे ईसु नु चोखु हयणु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 12:1" />ईसु फसह ना तीवार ना छोव दाड़ा पेले, बेतन्‌या मे लाजर ना घोर ज्‌यो, जे अदमी ने तीहयो मरला मे सी जीवाड़लो हतो। <verse eid="JHN 12:1" /><verse number="2" style="v" sid="JHN 12:2" />तां तीहया ईसु नी पोरणा-चाकरी कर्‌या। अने लाजर बी तीमनी ह़ाते खाणु खावा नी लेदे बह र्‌यो हतो। अने मारथा तीमने खाणु खवाड़ती हती। <verse eid="JHN 12:2" /><verse number="3" style="v" sid="JHN 12:3" /><note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37">लुका 7:37</ref>,<ref loc="LUK 7:38">38</ref></char></note> तीहयी टेमे मरीयम आदो लीटर घणु मोगु ईत्‌तर लावीन ईसु ना पोगु पोर रेड़ देदी, अने आह़फी ना नीम्‌बाळा वेते तीना पोगु नुछी, अने ईत्‌तर नी ह़वादली गंद सी आखु घोर भराय ज्‌यु। <verse eid="JHN 12:3" /><verse number="4" style="v" sid="JHN 12:4" />पण ईसु नो एक चेलो, यहुदा ईस्‌करीयोती, जे ईसु ने धराव्‌वा वाळो हतो, तीहयो केवा बाज ज्‌यो। <verse eid="JHN 12:4" /><verse number="5" style="v" sid="JHN 12:5" />आहयु ईत्‌तर वेचीन तीन ह़ो दाड़ा ना दाड़की ना पय्‌हा लीन, गरीब ने काहा नी आपी? <verse eid="JHN 12:5" /><verse number="6" style="v" sid="JHN 12:6" />तीने गरीब नी फीकर हती, करीन आहयी वात तीहयो नी केदो, पण तीहयो चोट्‌टो हतो। अने तीनी पांह एक कोथळी रेती हती, अने तीनी मे जे कंय घालता हता, तीने तीहयो नीकाळ लेतो हतो। <figure style="fig" alt="Alabaster jars" file="hk00142c.tif" size="col" copy="Horace Knowles ©" ref="12:3">संगमरमर ना ठाहरा</figure><verse eid="JHN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 12:7" />ईसु केदो, मरीयम ते मने डाटवा नी तीयारी पेले गेथीत करवा बाज री, हीने कंय ना केय। <verse eid="JHN 12:7" /><verse number="8" style="v" sid="JHN 12:8" />काहाके गरीब तमारी ह़ाते जलम रेहे, पण मे तमारी ह़ाते जलम नी रेम।<verse eid="JHN 12:8" /></para>
  <para style="s">लाजर ने मारवा नी योजना</para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 12:9" />युहदी माणहु आहयी वात ह़मळ्‌या के ईसु बेतन्‌या मे से, एतरे तीहया ईसु ने एतरात नी पण लाजर ने बी देखवा करीन तां ज्‌या, जीने ईसु मरला मे गेथो जीवतो करलो हतो। <verse eid="JHN 12:9" /><verse number="10" style="v" sid="JHN 12:10" />एतरे डायला पुंजारा लाजर ने बी मारवा नो वीच्‌यार कर्‌या। <verse eid="JHN 12:10" /><verse number="11" style="v" sid="JHN 12:11" />काहाके लाजर ना कारण सी घणा युहदी तीमने सोड़ीन ईसु पोर भरहो करता हता।<verse eid="JHN 12:11" /></para>
  <para style="s">ईसु यरुसलेम मे राजा ना वेह मे आवे</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 12:12" />बीजा दाड़े तीवार मे आवला माणहु नो टोळो आहयु ह़मळ्‌या, के ईसु यरुसलेम मे आव्‌वा बाज र्‌यो। <verse eid="JHN 12:12" /><verse number="13" style="v" sid="JHN 12:13" />एतरे तीहया माणहु ताड़ ना डाळ्‌या लीन तीने भेटवा करीन बारथा ज्‌या, अने आड़वा बाज ज्‌या, “भगवान नी बड़ाय हये! जुगाळो से ईस्‌रायल नो राजा, जे भगवान ना नाम सी आवे।”<verse eid="JHN 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 12:14" />ईसु ने पाठड़ु गदड़ु जड़्‌यु अने तीहयो तीनी पोर बह ज्‌यो, जीसम के सास्‌तर मे लीखलु से,<verse eid="JHN 12:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="JHN 12:15" />ए सीयोन ह़ेर, बीहे ना!</para>
  <para style="q1" vid="JHN 12:15">तारो राजा तारीन्‌तां पाठड़ु गदड़ु</para>
  <para style="q2" vid="JHN 12:15">पोर बठीन आव्‌वा बाज र्‌यो।<verse eid="JHN 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 12:16" />तीना चेला ने आहयी वात पेले पल्‌ले नी पड़ी, पण जत्‌यार ईसु नी बड़ाय उजन्‌ती हयी, ता तीमने पल्‌ले पड़्‌यु के ईसु ना बारा मे सास्‌तर मे आसम लीखलु से, अने माणहु तीनी सी तेम के तेम वेहवार कर्‌या।<verse eid="JHN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 12:17" />ता मेळा ना माणहु जे तीहयी टेमे ईसु ह़ाते हता तीहया आहयी गवाय देदा के ईसु लाजर ने मड़ाट्‌या मे गेथो बोलाय्‌न, मरला मे गेथो जीवाड़्‌यो हतो। <verse eid="JHN 12:17" /><verse number="18" style="v" sid="JHN 12:18" />एतरे माणहु तीने मळवा करीन आया काहाके तीहया ह़मळला हता, के ईसु आहयु जुदा-काम करलो से। <verse eid="JHN 12:18" /><verse number="19" style="v" sid="JHN 12:19" />ता फरीसी माणहु आह़फा-आह़फा केदा, वीच्‌यार करो, आमने कंय नी बणतु, देखो, आखी कळी ईसु पसळ चाल पड़ी!<verse eid="JHN 12:19" /></para>
  <para style="s">ईसु आह़फा नी मोत ना बारा मे केय</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 12:20" />जे माणहु तीवार नी टेमे पुजा-पाट करवा करीन यरुसलेम मे आय र्‌या हता तीनी मे गेथा थोड़ाक युनानी हता। <verse eid="JHN 12:20" /><verse number="21" style="v" sid="JHN 12:21" />तीहया गलील ना बेतसेदा गाम मे रेण्‌या फीलीपुस ने तां ज्‌या अने केदा, “ए मास्‌तर! आमु ईसु ने देखवा से।”<verse eid="JHN 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 12:22" />फीलीपुस जाय्‌न अंदर्‌यास ने केदो, अने बेम जणा जाय्‌न ईसु ने केदा। <verse eid="JHN 12:22" /><verse number="23" style="v" sid="JHN 12:23" />ईसु तीमने केदो, “टेम आय जेली से के माणेह ना बेटा नी बड़ाय हये।” <verse eid="JHN 12:23" /><verse number="24" style="v" sid="JHN 12:24" />मे तमने ह़ाची-ह़ाची की र्‌यो, जत्‌यार लग गम नो दाणो कादा मे पड़ीन नी मरे, तत्‌यार लग तीहयो एखलो रेय, पण तीहयो मर जाय ता तीहयो घण ढेरका दाणा पयदा करे। <verse eid="JHN 12:24" /><verse number="25" style="v" sid="JHN 12:25" /><note caller="+" style="x"><char style="xo" closed="false">12:25 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्‌ती 10:39</ref>; <ref loc="MAT 16:25">16:25</ref>; <ref loc="MRK 8:35">मरकुस 8:35</ref>; <ref loc="LUK 9:24">लुका 9:24</ref>; <ref loc="LUK 17:33">17:33</ref></char></note>जे कोय आह़फा ना जीव ने जादा मोंग करे, तीहयो आह़फा ना जीव ने खोवहे; पण जे कोय आहयी कळी मे आह़फा नो जीव लग आपवा तीयार से, तीहयो आह़फा ना जीव ने अमर जीवाय जुगु बचाड़ लेहे। <verse eid="JHN 12:25" /><verse number="26" style="v" sid="JHN 12:26" />कदी कोय मारु काम करवा हींडे, ता मारी पसळ चाले, अने जां मे रेही तांत मारो काम करन्‌यो बी रेहे, कदी कोय मारु काम करहे, ता मारो बाह तीनी ईज्‌जत करहे।<verse eid="JHN 12:26" /></para>
  <para style="s">ईसु आह़फा नी मोत ना बारा मे देखाड़्‌यो</para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 12:27" />हाव मारो जीव कलपी र्‌यो अने मे ह़ुं केम? के “ए मारा बाह” मने आहयी दुख नी घड़ी मे गेथो बचाड़, पण मे आहयी कळ मे दुख वेठवान करतेत आवलो से। <verse eid="JHN 12:27" /><verse number="28" style="v" sid="JHN 12:28" />ए भगवान बाह तारा नाम नी बड़ाय उजन्‌ती कर!</para>
  <para style="p" vid="JHN 12:28">तीहयी टेमे ह़रग गेथी आहयी अवाज ह़मळायी, “मे बड़ाय देखाड़लो से, अने अळी बी देखाड़ही।”<verse eid="JHN 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 12:29" />तत्‌यार आड़े-धेड़े उबा रेण्‌या माणहु अवाज ह़मळीन केदा, “वादळु गाज्‌यु।” थोड़ाक माणहु केदा, “एक ह़रगदुत हीनी ह़ाते वात कर्‌यो!”<verse eid="JHN 12:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 12:30" />ईसु तीमने केदो, “आहयो अवाज मारी जुगु नी आयो, पण तमारी जुगु ह़रगे गेथो आवलो से।” <verse eid="JHN 12:30" /><verse number="31" style="v" sid="JHN 12:31" />हाव आहयी कळी नो नीयाव हयवा नी टेम आय जेली से, हाव आहयी कळी ना राजा ने नीकाळ देहे। <verse eid="JHN 12:31" /><verse number="32" style="v" sid="JHN 12:32" />जत्‌यार माणहु मने उपर कुरुस पोर चड़ावीन मारहे, “ता मे आखा माणहु ने मारी भणी मनवी लेही।” <verse eid="JHN 12:32" /><verse number="33" style="v" sid="JHN 12:33" />आसम कीन ईसु आहयु उजन्‌तु कर देदो, के मारी मोत आसम हयवा वाळी से।<verse eid="JHN 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 12:34" />आहयी वात पोर माणहु तीने केदा, आमु कायदा नी आहयी वात ह़मळ्‌ळा से, के मसी सदा रेहे, अने तु काहा की र्‌यो, के माणेह ना बेटा ने उपर कुरुस पोर चड़ाव्‌वा जरुड़ी से? आहयो माणेह नो बेटो कोय से?<verse eid="JHN 12:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 12:35" />ईसु तीमने केदो, वीजाळु हमणे थोड़ीक वार लग तमारी वच मे से, जत्‌यार लग वीजाळु तमारी ह़ाते से तत्‌यार लग चालता रेवो; आसम नी हयवु जोवे के अंदारलु तमने आय्‌न घेरवी लेय; जे अंदारला मे चाले तीने नी मालम रेय के कंखर जाय र्‌यो। <verse eid="JHN 12:35" /><verse number="36" style="v" sid="JHN 12:36" />जत्‌यार लग वीजाळु तमारी पांह से, वीजाळु पोर भरहो करो। आसम करहु ता तमु वीजाळा नी अवल्‌यात बण जहु। ईसु आहयी वात कीदीन अळतेण, तीहयो तां गेथो जत र्‌यो अने खुद ने तीमनी सी ह़ताड़ लेदो।<verse eid="JHN 12:36" /></para>
  <para style="s">युहदी माणहु नो वण-भरहो</para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 12:37" />अने ईसु माणहु अगळ घणा ढेरका जुदा-काम देखाड़लो, ते बी तीहया तीनी पोर भरहो नी कर्‌या। <verse eid="JHN 12:37" /><verse number="38" style="v" sid="JHN 12:38" />अनीन करते के भगवान वगे गेथी वात केण्‌यो यसायो जे वात केदलो हतो तीहयी वात पुरी हय सके,</para>
  <para style="q1" vid="JHN 12:38">“हे भगवान! कोय अमारा लारे देखाड़ली खबर पोर भरहो कर्‌यु?</para>
  <para style="q2" vid="JHN 12:38">कोय पोर भगवान नी सक्‌ती उजन्‌ती हयी।”<verse eid="JHN 12:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 12:39" />आनीन करते तीहया भरहो नी कर्‌या, काहाके यसायो आहयु बी केदलो हतो,<verse eid="JHN 12:39" /></para>
  <para style="q1">
    <verse number="40" style="v" sid="JHN 12:40" />भगवान तीमना डोळा ने आंदळा कर देदो,</para>
  <para style="q2" vid="JHN 12:40">अने तीमनु मन वातड़ु कर देदलो से।</para>
  <para style="q1" vid="JHN 12:40">कंखर माय्‌न आसम नी हय जाय के</para>
  <para style="q2" vid="JHN 12:40">तीहया डोळा सी देख लेय,</para>
  <para style="q2" vid="JHN 12:40">अने मन सी ह़मजी लेय, अने मार भणी पासा आय लागे,</para>
  <para style="q2" vid="JHN 12:40">अने मे हीमने आरगा कर देम।<verse eid="JHN 12:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="JHN 12:41" />यसायो आहयी वात आनी लेदे केदो, के तीहयो तीनी बड़ाय ने देख्‌यो; अने तीना बारा मे वात कर्‌यो। <verse eid="JHN 12:41" /><verse number="42" style="v" sid="JHN 12:42" />ते बी युहदी मुखी मे गेथा घणात तीनी पोर भरहो कर्‌या, पण फरीसी माणहु नी धाके तीहया उजन्‌ता हय्‌न तीना बारा मे वात नी करता हता, आनीन करते के तीमने भक्‌ती ना घोर मे गेथा बारथा काड देहे। <verse eid="JHN 12:42" /><verse number="43" style="v" sid="JHN 12:43" />काहाके माणहु भणी गेथी जड़ण्‌याण ईज्‌जत तीमने भगवान वगे गेथी जड़ण्‌याण ईज्‌जत गेथी जादा मोंगाळ्‌ळी लागती हती।<verse eid="JHN 12:43" /></para>
  <para style="s">ईसु नी वात ना बारा मे नीयाव</para>
  <para style="p">
    <verse number="44" style="v" sid="JHN 12:44" />ईसु आड़ीन केदो, “जे मार पोर भरहो करे, तीहयो ह़ाचलीन तीनी पोर बी भरहो कर र्‌यो, जे मने मोकल्‌लो से। <verse eid="JHN 12:44" /><verse number="45" style="v" sid="JHN 12:45" />अने जे कोय मने देखे, तीहयो मने मोकलन्‌या ने देखे, <verse eid="JHN 12:45" /><verse number="46" style="v" sid="JHN 12:46" />मे कळी मे वीजाळु बणीन आवलो से; आनीन करते के जे मार पोर भरहो करे, तीहयो अंदारला मे नी रेवु जोवे। <verse eid="JHN 12:46" /><verse number="47" style="v" sid="JHN 12:47" />कदी कोय मारी वात ह़मळे अने तीने पाळ्‌या नी करे, ता मे तीनो नीयाव नी करु; काहाके मे आहयी कळी मे गुनाळ्‌ळा ठेराव्‌वा नी आयो, पण तीमने छुटकारो आपवा करीन आवलो से। <verse eid="JHN 12:47" /><verse number="48" style="v" sid="JHN 12:48" />जे मने नीचो ह़मजीन मारी ह़ीकापण ने नी माने, तीने गुनाळ्‌ळो ठेराव्‌वा वाळो ते एक से, जे बोलु मे केदलो से, तीहया बोलु तीने आखरी दाड़े, गुनाळ्‌ळो ठेराय देहे। <verse eid="JHN 12:48" /><verse number="49" style="v" sid="JHN 12:49" />मे मारी मरजी सी कंय बी नी केदो, पण ह़ु-ह़ु केवा जोवे अने ह़ु-ह़ु ह़ीकाड़वा जोवे तीहयु आखु, मारो बाह जे मने मोकल्‌लो से, तीहयोत मने हुकम आपलो से। <verse eid="JHN 12:49" /><verse number="50" style="v" sid="JHN 12:50" />मे जाणु के जे बोलु केवा करीन बाह मने हुकम आपलो से, तीनी मे अमर जीवाय से। एतरे जीसम मने बाह केदलो से तेमेत मे ह़ीकाड़ु।”<verse eid="JHN 12:50" /></para>
  <chapter eid="JHN 12" />
  <chapter number="13" style="c" sid="JHN 13" />
  <para style="s">ईसु ना लारे चेला ना पोगु धोवणु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 13:1" />फसह ना तीवार सी पेले जत्‌यार ईसु जाण लेदो, के मारी तीहयी टेम आय जेली से के कळ ने सोड़ीन भगवान बाह ने तां जाम, ता आह़फा ना माणहु सी, जे कळ मे हता, जीसम मोंग तीहयो करतो हतो, आखरी लग तीसमेत मोंग करतो र्‌यो।<verse eid="JHN 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JHN 13:2" />अने जत्‌यार भुतड़ो सीमोन ना बेटा यहुदा ईस्‌करीयोती ना मन मे ईसु ने धराव्‌वा नो वीच्‌यार नाख देदलो, ता खावा नी टेमे <verse eid="JHN 13:2" /><verse number="3" style="v" sid="JHN 13:3" />ईसु जाणतो हतो के मे भगवान बाहन्‌तां गेथो आवलो से, अने भगवान बाह मारा हात मे आखु कंय आप देदलो से, अने मे पासो तीनीन्‌तां जवा वाळो से। <verse eid="JHN 13:3" /><verse number="4" style="v" sid="JHN 13:4" />खाणु खावा रेवा दीन उबो हय ज्‌यो, अने आह़फा ना लुगड़ा काड देदो, अने केड़्‌या मे फटकु बांद लेदो।<verse eid="JHN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 13:5" />अने तीहयो टगारा मे पाणी हेड़ लेदो, अने आह़फा ना चेला ना पोगु धोवतो ज्‌यो, अने केड़्‌ये बांदला फटकु वेते तीमना पोगु नुसतो ज्‌यो। <verse eid="JHN 13:5" /><verse number="6" style="v" sid="JHN 13:6" />जत्‌यार ईसु सीमोन पतरस ने तां पोग धोव्‌वा करीन आयो, ता पतरस ईसु ने केदो, “ए मालीक! तु मारा पोगु धोव्‌वा हींड र्‌यो ह़ु?”<verse eid="JHN 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 13:7" />ईसु पतरस ने जपाप आप्‌यो, “मे जे करवा बाज र्‌यो, तीहयु तु हमणे नी ह़मजतो, बाखीन अळतेण तु ह़मजी जही।”<verse eid="JHN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 13:8" />पतरस ईसु ने केदो, “मे तने मारा पोगु कदी नी धोव्‌वा देम।” ईसु पतरस ने केदो, “कदी मे तने नी धोवु, ता तने मारी ह़ाते रेवा नो हक नी जड़े।”<verse eid="JHN 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 13:9" />सीमोन पतरस ईसु ने केदो, “ए मालीक! आसम हय ता, तु मारा पोग एतरा नी पण मारा हात अने मुंडु लग धोय दे।”<verse eid="JHN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 13:10" />ता ईसु पतरस ने केदो, “जे उंगळी लेय तीने पोगु एतरात धोव्‌वा नी जरवत से; तीनु आखु डील ते चोखलु से, तमु चोखला से, पण आखान-आखा चोखला नी हय।” <verse eid="JHN 13:10" /><verse number="11" style="v" sid="JHN 13:11" />ईसु ने मालम हतु के मने कोय धरावहे, एतरे तीहयो केदो, “तमु आखान-आखा चोखला नी हय।”<verse eid="JHN 13:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 13:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:12 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:27">लुका 22:27</ref>
      </char>
    </note>जत्‌यार ईसु तीमना पोग धोय देदो, ता लुगड़ा पेरीन पासो बह ज्‌यो, अने तीमने केदो, “मे जे वेहवार तमारी ह़ाते कर्‌यो तीहया वेहवार नो मतलब तमु ह़मजी ज्‌या ह़ु?” <verse eid="JHN 13:12" /><verse number="13" style="v" sid="JHN 13:13" />तमु मने गुरु अने मालीक की र्‌या, अने तमु तालेत की र्‌या, काहाके मे तीहयोत से। <verse eid="JHN 13:13" /><verse number="14" style="v" sid="JHN 13:14" />कदी मे तमारो मालीक अने गुरु हय्‌न बी तमारा पोगु धोयो; ता तमने बी एक-बीजा ना पोगु धोव्‌वा जोवे। <verse eid="JHN 13:14" /><verse number="15" style="v" sid="JHN 13:15" />मे दाखला नी सेलाणी देखाड़लो से; एतरे जीसम मे तमारी ह़ाते वेहवार करलो से तीसमेत तमु बी बीजा ह़ाते कर्‌या करो। <verse eid="JHN 13:15" /><verse number="16" style="v" sid="JHN 13:16" /><note caller="+" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्‌ती 10:24</ref>; <ref loc="LUK 6:40">लुका 6:40</ref>; <ref loc="JHN 15:20">युहन्‌ना 15:20</ref></char></note>मे तमने ह़ाची-ह़ाची केम, पावर्‌यो आपणा मालीक गेथो मोटो नी हय, अने नेवताळो बी मोकलन्‌या गेथो मोटो नी हय। <verse eid="JHN 13:16" /><verse number="17" style="v" sid="JHN 13:17" />कदी तमु आहयी वात ह़मजीन आना लारे जीवहु, ता जुगाळा से।<verse eid="JHN 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 13:18" />“मे तमु आखा ना बारा मे नी केतो, जीने मे टाळ लेदलो से, तीने मे जाणु, पण आहयु आनी लेदे, के खरली सास्‌तर नो बोल पुरो हये, जे मारो रोट्‌लो खादो, तीहयोत मने पटवाट्‌यो। <verse eid="JHN 13:18" /><verse number="19" style="v" sid="JHN 13:19" />हाव मे तमने पेलेत आहयु की देम, जीनी सी मारु केदलु पुरु हय जाय, ता तमु भरहो करजो, के मे तीहयोत से। <verse eid="JHN 13:19" /><verse number="20" style="v" sid="JHN 13:20" /><note caller="+" style="x"><char style="xo" closed="false">13:20 </char><char style="xt" closed="false"><ref loc="MAT 10:40">मत्‌ती 10:40</ref>; <ref loc="MRK 9:37">मरकुस 9:37</ref>; <ref loc="LUK 9:48">लुका 9:48</ref>; <ref loc="LUK 10:16">10:16</ref></char></note>मे तमने ह़ाची-ह़ाची केम, जे कोय मारा लारे मोकल्‌ला नो आव-भाव करे, तीहयो मारोत आव-भाव करे। अने जे मारो आव-भाव करे, तीहयो मने मोकलन्‌या नो आव-भाव करे।”<verse eid="JHN 13:20" /></para>
  <para style="s">ईसु आह़फा ह़ाते अगो हयवा वाळा धोका ना बारा मे केदो</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 13:21" />आहयी वात कीदीन ईसु जीव मे घण-जबर कलपी पड़्‌यो, “मे तमने ह़ाची-ह़ाची केम, तमारी मे नो एक जणो मने धराय देहे।”<verse eid="JHN 13:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 13:22" />चेला ने आहयु नी ह़मज पड़्‌यु के ईसु कोयना बारा मे केवा बाज र्‌यो। एतरे चेला वहराय्‌न एक-बीजा भणी भाळवा बाज ज्‌या। <verse eid="JHN 13:22" /><verse number="23" style="v" sid="JHN 13:23" />तीहया बारे चेला मे नो एक जणो ईसु नो लाडलो चेलो केवायतो हतो, तीहयो ईसु नी छाती भणी वळीन बह र्‌यो हतो। <verse eid="JHN 13:23" /><verse number="24" style="v" sid="JHN 13:24" />सीमोन पतरस तीने ईसारो करीन आहयु केदो, “ईसु ने पुछ तीहयो चेलो कोय से?”<verse eid="JHN 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 13:25" />तत्‌यार तीहयो हीसम ने हीसम ईसु नी छाती भणी वळीन बह रेलोत ईसु ने पुछ्‌यो, “ए मालीक! तीहयो कोय से?” <verse eid="JHN 13:25" /><verse number="26" style="v" sid="JHN 13:26" />ईसु जपाप आप्‌यो, “मे जीने रोट्‌ला नो कोळ बोळीन आपही, तीहयोत मने धरावण्‌यो से।” अने तीहयो रोट्‌ला नो कोळ बोळीन सीमोन ईस्‌करीयोती ना बेटा यहुदा ने आप्‌यो। <verse eid="JHN 13:26" /><verse number="27" style="v" sid="JHN 13:27" />अने रोट्‌ला नो कोळ लेतेत. यहुदा ना डील मे भुतड़ो भराय ज्‌यो, तत्‌यार ईसु यहुदा ने केदो, “जे काम तु करवा हींड र्‌यो, तीहयु छोटो कर।” <verse eid="JHN 13:27" /><verse number="28" style="v" sid="JHN 13:28" />पण तां ह़रा बह रेला चेला मे कोयने बी आहयी वात ह़मज मे नी पड़ी, के ईसु तीने आहयी वात काहा केदो। <verse eid="JHN 13:28" /><verse number="29" style="v" sid="JHN 13:29" />यहुदा पांह कोथळी रेती हती, एतरे काना-काना आहयु ह़मज्‌या के ईसु तीने आहयु केदो हहे, के आपणु ने तीवार नी करते जे कंय जोवे, तीहयु वेचातु ली ले नीता गरीब ने आप दे।<verse eid="JHN 13:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 13:30" />अळतेण रोट्‌ला नो कोळ खायलीन यहुदो तत्‌यारुत बारो जत र्‌यो। तीहयी रात नी टेम हती।<verse eid="JHN 13:30" /></para>
  <para style="s">एक नवलो हुकम</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 13:31" />तीने बारो जवादीन ईसु केदो, हाव मनख्‌या ना बेटा नी बड़ाय हयी, अने भगवान नी बड़ाय तीनी मे हयी। <verse eid="JHN 13:31" /><verse number="32" style="v" sid="JHN 13:32" />अने भगवान बी मनख्‌या ना बेटा ने ह़रग मे वाळी बड़ाय पासी आपीन ईज्‌जत करहे, अने छोटोत करहे। <verse eid="JHN 13:32" /><verse number="33" style="v" sid="JHN 13:33" /><note caller="+" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="JHN 7:34">युहन्‌ना 7:34</ref></char></note>“ए मारा लाडला बेटा-बेटी! मे अळी जरीक वार तमारी ह़ाते से। अळतेण तमु मने ह़ोदहु, अने मे जीसम युहदी-पुडार्‌या ने केदलो हतो, तीसम हाव मे तमने बी केम, जां मे जवा बाज र्‌यो, तां तमु नी आय सको।” <verse eid="JHN 13:33" /><verse number="34" style="v" sid="JHN 13:34" /><note caller="+" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="JHN 15:12">युहन्‌ना 15:12</ref>,<ref loc="JHN 15:17">17</ref>; <ref loc="1JN 3:23">1 युहन्‌ना 3:23</ref>; <ref loc="2JN 1:5">2 युहन्‌ना 1:5</ref></char></note>“मे तमने एक नवलो हुकम आपु, तमु एक-बीजा ने मोंग करो। जीसम मे तमने मोंग कर्‌यो, तेमेत तमु बी एक-बीजा ने मोंग करो। <verse eid="JHN 13:34" /><verse number="35" style="v" sid="JHN 13:35" />कदी तमु एक-बीजा ने मोंग करहु, ता आहयु देखीन आखा माणहु जाण लेहे, के तमु मारा चेला से।”<verse eid="JHN 13:35" /></para>
  <para style="s">ईसु पतरस ना नीकारा ना बारा मे केय</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्‌ती 26:31-35</ref>; <ref loc="MRK 14:27-31">मरकुस 14:27-31</ref>; <ref loc="LUK 22:31-34">लुका 22:31-34</ref>)</para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 13:36" />सीमोन पतरस ईसु ने केदो, “मालीक! तु कां जवा बाज र्‌यो?”</para>
  <para style="p" vid="JHN 13:36">ईसु पतरस ने केदो, “मे जां जवा बाज र्‌यो, तां तने हमणे नी अवाये, पण अळतेण तु तां आवही।”<verse eid="JHN 13:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 13:37" />पतरस तीने केदो, “ए मालीक! मने हमणे, तु जाय तां काहा नी अवाये? मे तारीन करते मारो जीव बी आप देही।”<verse eid="JHN 13:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 13:38" />ईसु पतरस ने जपाप आप्‌यो, “तु मारीन करते आह़फा नो जीव आप देही ह़ु? मे तने ह़ाची-ह़ाची आहयु केम, कुकड़ो वाहवान पेलेत तु तीन कावा बीजा अगळ आसम केही के ‘मे ईसु ने ओळखु लग नी।’”<verse eid="JHN 13:38" /></para>
  <chapter eid="JHN 13" />
  <chapter number="14" style="c" sid="JHN 14" />
  <para style="s">ईसु खुद ना चेला ने सांती आपे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 14:1" />ईसु चेला ने केदो, “तमारु मन दुखी नी हयवा जोवे भगवान पोर भरहो राखो, अने मार पोर बी भरहो राखो। <verse eid="JHN 14:1" /><verse number="2" style="v" sid="JHN 14:2" />मारा बाह ना घोर मे ढेरेत कोपरा से; अने नी हता, ता मे तमने पेलेत की देतो। मे तमारी जुगु जागो तीयार करवा जवा बाज र्‌यो। <verse eid="JHN 14:2" /><verse number="3" style="v" sid="JHN 14:3" />अने मे जाय्‌न तमारी जुगु जागो तीयार कर देही, ता मे तमने लेवा पासो आवही, तमने मारीन्‌तां ली जही के जां मे रेम तां तमु बी रेवो। <verse eid="JHN 14:3" /><verse number="4" style="v" sid="JHN 14:4" />अने मे जां जवा बाज र्‌यो, तां जवा नी वाट तमने मालम से।”<verse eid="JHN 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 14:5" />थोमस ईसु ने केदो, “मालीक! आमने आहयु बी नी मालम हय के तु कां जवा बाज र्‌यो, ता आमु तां जवा नी वाट कीसम जाणहु?”<verse eid="JHN 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 14:6" />ईसु थोमास ने केदो, “वाट, खराय, अने जीवाय मेत से। मारी वगर कोयने बी बाह ने तां नी जवाय।” <verse eid="JHN 14:6" /><verse number="7" style="v" sid="JHN 14:7" />“कदीम तमु मने ओळखी लेता, ता मारा बाह ने बी ओळखी लेता। पण आहयु ह़ाची से के तीने तमु देखला से, अने हाव गेथा मारा बाह ने ओळखी लेहु।”<verse eid="JHN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 14:8" />फीलीपुस ईसु ने केदो, “ए मालीक! आमने बाह ने देखाड़ दे: अमारी जुगु एतरुत घणु।”<verse eid="JHN 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 14:9" />ईसु फीलीपुस ने केदो, “ए फीलीपुस! मे तमारी ह़ाते एतरा दाड़ा लग र्‌यो, ते बी तु मने नी ओळख्‌यो? जे मने देखलो से तीहयो भगवान बाह ने बी देखलो से” तु आसम काहा की र्‌यो, के आमने बाह ने देखाड़ दे? <verse eid="JHN 14:9" /><verse number="10" style="v" sid="JHN 14:10" />तने भरहो नी आवतो ह़ु के बाह मारी मे से, अने मे बाह मे से? मे जे बोलु केम तीहया बोलु मारा नी हय, पण बाह मारी मे रीन बोले, अने आसम करीन मारा लारे तीना मोटा काम करे। <verse eid="JHN 14:10" /><verse number="11" style="v" sid="JHN 14:11" />मारी आहयी वात पोर भरहो करो, के मे बाह मे से, अने बाह मारी मे से। नीता जे मोटा कामु मारा लारे हयला से, तीहया कामु ने देखीन भरहो करो। <verse eid="JHN 14:11" /><verse number="12" style="v" sid="JHN 14:12" />मे तमने ह़ाची-ह़ाची केम, जे मार पोर भरहो करे, तीहयो बी मे करु तीहया काम करहे, पण आनी सी बी मोटा-मोटा काम करहे, काहाके मे बाहन्‌तां जवा बाज र्‌यो। <verse eid="JHN 14:12" /><verse number="13" style="v" sid="JHN 14:13" />अने तमु जे कंय मारा नाम सी भगवान पांह मांगहु, तीहयुत मे करही। जीनी सी बेटा नी लारे बाह ने ईज्‌जत जड़े। <verse eid="JHN 14:13" /><verse number="14" style="v" sid="JHN 14:14" />कदी तमु जे कंय बी मारा नाम सी, मारी सी मांगहु, मे तीने पुरु करही।<verse eid="JHN 14:14" /></para>
  <para style="s">चोखली आत्‌मा मोकलवा ना बारा मे ईसु वात करे</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 14:15" />कदी तमु मने मोंग करता हय, ता मारा हुकम ने बी पाळहु। <verse eid="JHN 14:15" /><verse number="16" style="v" sid="JHN 14:16" />अने मे बाह सी वीन्‌ती करही, अने तीहयो एक अळी मदत करन्‌यो आपहे, तीहयो जलम तमारी ह़ाते रेहे। <verse eid="JHN 14:16" /><verse number="17" style="v" sid="JHN 14:17" />मतलब खराय नी आत्‌मा, तमु ते तीने जाणो, काहाके तीहयी तमारी ह़ाते रेय। पण आव्‌वा वाळा दाड़ा मे तीहयी तमारी मे रेहे। पण कळी ना माणहु खराय नी आत्‌मा ने आवरी नी सके, काहाके तीहया तीने देख्‌या बी नी अने ओळख्‌या बी नी।<verse eid="JHN 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 14:18" />मे तमने वीखा मे नी सोड़ु, मे तमारीन्‌तां पासो आवही। <verse eid="JHN 14:18" /><verse number="19" style="v" sid="JHN 14:19" />थोड़ीक वार सी आहयी कळी ना माणहु, जे मार पोर भरहो नी करे, तीहया मने अळी नी देखे, पण तमु मने अळी देखहु, मे जीवत्‌लो रेही, एतरे तमु बी जीवत्‌ला रेहु। <verse eid="JHN 14:19" /><verse number="20" style="v" sid="JHN 14:20" />ते दाड़े तमु जाण जहु के मे मारा बाह मे से, अने तमु मारी मे से, अने मे तमारी मे से।<verse eid="JHN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 14:21" />मने मोंग करन्‌यो तीहयोत से, जे मारा हुकम जाणे अने तीमने पाळे। अने जे मने मोंग करे तीने मारो बाह बी मोंग करहे, अने तीने मे बी मोंग करही, अने मे आह़फा ने तीनी अगळ उजन्‌तो करही।<verse eid="JHN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 14:22" />तत्‌यार ईस्‌करीयोती यहुदा नी हतो, पण एक बीजो यहुदा ईसु ने पुछ्‌यो, “ए मालीक तु अमारी अगळ आह़फा ने उजन्‌तो करही, अने आहयी कळी ना मनख्‌या पोर उजन्‌तो नी करे, आसम काहा की र्‌यो?”<verse eid="JHN 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 14:23" />ईसु तीहया यहुदा ने केदो, “कदी कोय मने मोंग करहे, ता तीहयो मारा हुकम ने मानहे, अने मारो बाह तीने मोंग करहे” अने आमु तीनीन्‌तां आवहु, अने तीनी मे रेहु। <verse eid="JHN 14:23" /><verse number="24" style="v" sid="JHN 14:24" />आहयी ह़ीकापण मे तमने आप र्‌यो, तीहयी आखी ह़ीकापण मारी नी हय, पण मने मोकलन्‌या बाह नी से, जे मने मोंग नी करे, तीहयो मारी ह़ीकापण ने नी माने।<verse eid="JHN 14:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 14:25" />मे आहयी आखी वात तमारी ह़ाते रीन केदलो से। <verse eid="JHN 14:25" /><verse number="26" style="v" sid="JHN 14:26" />पण मदत करन्‌याण मतलब चोखली आत्‌मा जीने बाह मारा नाम सी मोकलहे, तीहयी तमने आखी वात ह़ीकाड़हे, अने जे कंय मे तमने केदलो से, तीहयु आखु तमने हेर करावहे।<verse eid="JHN 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 14:27" />मे तमने सांती आपीन जाम, मे मारीत सांती तमने आपु, जीसम कळी ना माणहु तमने आपे, तीसम मे नी आपु, तमु मन मे नी घबरायजो अने नी बीहजो। <verse eid="JHN 14:27" /><verse number="28" style="v" sid="JHN 14:28" />तमु ते ह़मळ्‌या, मे तमने केदो, मे जाय र्‌यो, कदी तमु मने मोंग करता, ता आहयु जाणीन खुस हयता के मे बाहन्‌तां जवा बाज र्‌यो, काहाके बाह मारी सी मोटो से। <verse eid="JHN 14:28" /><verse number="29" style="v" sid="JHN 14:29" />अने मे हाव आहयु हयवा सी पेले तमने की देदो, के जत्‌यार आहयु हय जाय, ता तमु भरहो करो। <verse eid="JHN 14:29" /><verse number="30" style="v" sid="JHN 14:30" />मे हाव तमारी ह़ाते अळी वात नी करु, काहाके आहयी कळी नो राजा आव्‌वा बाज र्‌यो, अने मारी पोर तीनो कंय हक नी हय। <verse eid="JHN 14:30" /><verse number="31" style="v" sid="JHN 14:31" />पण आहयु आनी लेदे हयु के कळी ना माणहु जाणे के मे बाह सी मोंग करु।</para>
  <para style="p" vid="JHN 14:31">अने जीसम बाह मने हुकम आप्‌यो, मे तीसमेत करु, उठो, आञे गेथा जता।<verse eid="JHN 14:31" /></para>
  <chapter eid="JHN 14" />
  <chapter number="15" style="c" sid="JHN 15" />
  <para style="s">खरलो अंगुर नो वेलो</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 15:1" />खरलो वेलो मेत से अने मारो बाह कीरसाण से। <verse eid="JHN 15:1" /><verse number="2" style="v" sid="JHN 15:2" />जे डाळ नी फाले, तीने मारो बाह वाडी नाखे, अने जे फाले, तीने तीहयो साटे के अळी बी वदु फाले। <verse eid="JHN 15:2" /><verse number="3" style="v" sid="JHN 15:3" />तमने जे ह़ीकापण मे आपलो से, तीहयी ह़ीकापण नी लारे तमु चोखा हय जेला से। <verse eid="JHN 15:3" /><verse number="4" style="v" sid="JHN 15:4" />तमु मारी मे बणला रेवो अने मे तमारी मे जीसम डाळ कदी थुड़ मे बणीन नी रेय, ता आह़फीत नी फाल सके, तेमेत तमु बी कदीम मारी मे बणीन नी रेवो ता तमु बी नी फाली सको।<verse eid="JHN 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 15:5" />मे अंगुर नो वेलो से, अने तमु मारा डाळ्‌या से। मारी गेथा आंग्‌ये हय्‌न तमने कंय बी नी कराय। एतरे जे मारी मे जोड़ायलो रेय अने मे तीनी मे जोड़ायलो रेम, तीहयो घणो फालहे। <verse eid="JHN 15:5" /><verse number="6" style="v" sid="JHN 15:6" />जे मारी मे जोड़ायला नी रेय, तीहया ते डाळ्‌या ह़रका से, जीने कीरसाण वाडीन नाख देय, अने तीहया ह़ुक जाय। अने कीरसाण ते डाळ्‌या ने चुटीन आक्‌ठा मे नाख देय अने तीहया धप जाय। <verse eid="JHN 15:6" /><verse number="7" style="v" sid="JHN 15:7" />कदी तमु मारी मे जोड़ायला रेहु, अने मारी ह़ीकापण ने पाळता रेहु, ता जे जोवे तीहयु वीन्‌ती करीन मांगजो, अने मे तमने आप देही। <verse eid="JHN 15:7" /><verse number="8" style="v" sid="JHN 15:8" />तमु घण ढेरका फोळ लावहु, ता मारा भगवान बाह नी बड़ाय हयहे, तात तमु मारा चेला बण जहु। <verse eid="JHN 15:8" /><verse number="9" style="v" sid="JHN 15:9" />जीसम बाह मने मोंग करलो से, तेमेत मे बी तमने मोंग करलो से। एतरे तमु मारा मोंग मे घोळायला रेहु। <verse eid="JHN 15:9" /><verse number="10" style="v" sid="JHN 15:10" />मे मारा बाह नो हुकम पाळतो जाय्‌न तीना मोंग मे घोळायलो रेम, तेमेत तमु बी मारा हुकम पाळहु, ता तमु मारा मोंग मे घोळायला से।<verse eid="JHN 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 15:11" />मे तमने आहयी वात आनी करते केदो, के मारी खुसी तमारी मे बणीन रेय, अने तमारी खुसी पुरी हय जाय। <verse eid="JHN 15:11" /><verse number="12" style="v" sid="JHN 15:12" /><note caller="+" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="JHN 13:34">युहन्‌ना 13:34</ref>; <ref loc="JHN 15:17">15:17</ref>; <ref loc="1JN 3:23">1 युहन्‌ना 3:23</ref>; <ref loc="2JN 1:5">2 युहन्‌ना 1:5</ref></char></note>मारो हुकम आहयो से के जीसम मे तमने मोंग करलो से, तेमेत तमु बी एक-बीजा ने मोंग करता रेजो। <verse eid="JHN 15:12" /><verse number="13" style="v" sid="JHN 15:13" />आह़फा ना दोस्‌तीदार्‌या ने मोंग करीन तीमनीन करते मरवात आखा गेथो मोटो मोंग से। आहया मोंग गेथो कानो बी मोंग मोटो नी हय। <verse eid="JHN 15:13" /><verse number="14" style="v" sid="JHN 15:14" />कदीम तमु मारा हुकम पाळहु, ता तमु मारा खरला दोस्‌तीदार्‌या केवायहु। <verse eid="JHN 15:14" /><verse number="15" style="v" sid="JHN 15:15" />पावर्‌या ने मालम नी पड़े के तीना मालीक नी मरजी ह़ु से, अने तीहयो ह़ु करवा वाळो से, पण मे मारा बाह पांह गेथु जे ह़मळ्‌ळो तीहयु आखु तमने की देदलो से। पण हाव गेथो मे तमने पावर्‌या नी केम, पण दोस्‌तीदार्‌या केही। <verse eid="JHN 15:15" /><verse number="16" style="v" sid="JHN 15:16" />तमु मने नी टाळ्‌या, पण मे तमने टाळीन मारा कामे लगाड़लो से, के तमु मारा नाम सी भगवान पांह वीन्‌ती करीन जे कंय मांगहु, तीहयु भगवान बाह तमने आप देहे। अने आसम करीन तमु जाय्‌न तमारी जीवाय मे जलम रेण्‌यान मेर पकाड़ो। <verse eid="JHN 15:16" /><verse number="17" style="v" sid="JHN 15:17" />मे तमने आहयो हुकम आनीन करते आप र्‌यो, के तमु एक-बीजा ने मोंग करता रेय।<verse eid="JHN 15:17" /></para>
  <para style="s">आहयी कळी ना माणहु ईसु ना चेला भणी खार करहे</para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 15:18" />कदीम आहयी कळी ना माणहु तमारी भणी खार करहे, ता तमु आहयु फोम राखजो के तमारी गेथा पेले मारी भणी खार करला से। <verse eid="JHN 15:18" /><verse number="19" style="v" sid="JHN 15:19" />कदीम तमु आहयी कळी ना माणहु रेता, तत्‌यार तीहया आपणा ह़मजीन मोंग करता, पण मे तमने आहयी कळी ना माणहु मे गेथा टाळ लेदलो से, करीनेत तीहया तमारी भणी खार करहे। <verse eid="JHN 15:19" /><verse number="20" style="v" sid="JHN 15:20" /><note caller="+" style="x"><char style="xo" closed="false">15:20 </char><char style="xt" closed="false"><ref loc="MAT 10:24">मत्‌ती 10:24</ref>; <ref loc="LUK 6:40">लुका 6:40</ref>; <ref loc="JHN 13:16">युहन्‌ना 13:16</ref></char></note>मे तमने जे वात केदो, तीने फोम राखजो के पावर्‌यो आह़फा ना मालीक गेथो मोटो नी हय। मे तमारो मालीक से; ते बी माणहु मने वेला पाड़्‌या आसवा माणहु तमने बी वेला पाड़हे। आहयी कळी ना माणहु मारी ह़ीकापण ने नी पाळ्‌या, ता तमारी ह़ीकापण ने बी नी पाळे। <verse eid="JHN 15:20" /><verse number="21" style="v" sid="JHN 15:21" />एसवा माणहु, मने मोकलन्‌या भगवान ने नी ओळख्‌या, अने मारो वीरोद कर्‌या। तमु ते मारु नाम ली र्‌या, एतरे तीहया तमारी भणी खार करीन वेला पाड़हेन-पाड़हे। <verse eid="JHN 15:21" /><verse number="22" style="v" sid="JHN 15:22" />कदीम मे नी आवतो, अने हीमने पाप ना बारा मे भगवान नी सच्‌चाय ना बारा मे नी ह़ीकाड़तो ता हीमने पाप नी लागतो; पण हाव ते हीमनी पांह पाप ना बारा मे कंय बी ढोंगड़ा करवा नो मोखो नी हय। <verse eid="JHN 15:22" /><verse number="23" style="v" sid="JHN 15:23" />जे मार भणी खार करे, तीहयो मारा भगवान बाह भणी बी खार करे। <verse eid="JHN 15:23" /><verse number="24" style="v" sid="JHN 15:24" />कदीम तीमनी अगळ तीहया मोटा कामु नी करतो, जे कामु कोय बीजो कदी नी कर्‌यो, ता हीमने पाप नी लागतो। पण हमणे ते तीहया आसवा कामु देखीन बी मने नी मान्‌या अने ह़ाम्‌बा मार भणी अने मारा भगवान बाह भणी खार करला से। <verse eid="JHN 15:24" /><verse number="25" style="v" sid="JHN 15:25" />खरली सास्‌तर जीने तीहया माने, तीहयी सास्‌तर मे आसम लीखलु से, के तीहया माणहु उदड़ेत मारा वेरी बण जेला से। आहयु आखु ते बोल ना लारे हय र्‌यु।<verse eid="JHN 15:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 15:26" />मे तमारीन्‌तां सात देण्‌या ने मतलब सच्‌चाय नी आत्‌मा ने भगवान बाहन्‌तां गेथो मोकलही। जत्‌यार तीहयी सच्‌चाय नी आत्‌मा भगवान बाह मे गेथी आवहे, तत्‌यार तीहयी मारा बारा मे गवाय देहे। <verse eid="JHN 15:26" /><verse number="27" style="v" sid="JHN 15:27" />अने तीनी ह़ाते तमु बी मारी गवा देजो काहाके तमु सुरु गेथात मारी ह़ाते रेला से।<verse eid="JHN 15:27" /></para>
  <chapter eid="JHN 15" />
  <chapter number="16" style="c" sid="JHN 16" />
  <para style="p">
    <verse number="1" style="v" sid="JHN 16:1" />मे तमने आहयी आखी वात आनीन करते केदो, के भरहो नी सोड़ो। <verse eid="JHN 16:1" /><verse number="2" style="v" sid="JHN 16:2" />माणहु तमने तीमना भक्‌ती ना घोर मे गेथा बारा काड देहे। अने आहयी टेम बी आवहे के माणहु आहयु ह़मजीन तमने मारहे के आमु ईमने मारीन भगवान नी सेवा-चाकरी कर र्‌या। <verse eid="JHN 16:2" /><verse number="3" style="v" sid="JHN 16:3" />तीहया भगवान बाह ने बी नी ओळखे अने मने बी नी ओळखे। एतरे तीहया तमारी ह़ाते आसम वेहवार करहे। <verse eid="JHN 16:3" /><verse number="4" style="v" sid="JHN 16:4" />मे आहयी आखी वात आनीन करते देखाड़्‌यो, के जत्‌यार तीहया वेला पाड़हे, ता तमने आहयी आखी वात फोम आव्‌वा जोवे, के मे तमने आहयी वात पेलेत कीन चेताय देदलो से। एतरा दाड़ा मे तमारी ह़ाते हतो करीन मे आहयी आखी वात सुरु मे नी केदो।<verse eid="JHN 16:4" /></para>
  <para style="s">चोखली आत्‌मा ना काम ना बारा मे ईसु देखाड़े</para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 16:5" />पण हाव मे तीनीन्‌तां जवा बाज र्‌यो, जे मने मोकल्‌लो से, अने तमारी मे गेथो कोय बी आहयु नी पुछ्‌ता के तु कां जवा बाज र्‌यो? <verse eid="JHN 16:5" /><verse number="6" style="v" sid="JHN 16:6" />मे तमने आहयी आखी वात की देदो, करीन तमारु मन दुख सी भराय जेलु से। <verse eid="JHN 16:6" /><verse number="7" style="v" sid="JHN 16:7" />पण ते बी मे तमने ह़ाचलीन केम, मे जत रेही ता तमारी जुगु वारु रेहे; काहाके मे नी जाम, ता तमने सात देण्‌यो तमारीन्‌तां नी आवे। पण मे जही ता ते सात देण्‌या ने तमारीन्‌तां मोकल देही। <verse eid="JHN 16:7" /><verse number="8" style="v" sid="JHN 16:8" />अने जत्‌यार चोखली आत्‌मा आवहे, ता तीहयी आहयी कळी ना माणहु ने आहयु उजन्‌तु कर देहे के पाप नीयाव ना बारा मे गलत, अने भगवान नी खराय ना बारा मे संय से। <verse eid="JHN 16:8" /><verse number="9" style="v" sid="JHN 16:9" />पाप ना बारा मे आनीन करते के तीहया मार पोर भरहो नी करता। <verse eid="JHN 16:9" /><verse number="10" style="v" sid="JHN 16:10" />मे ते भगवान बाह ने तां जाम, अने जत्‌यार मे जत रेही ता तमु मने नी देखो; एतरे मारी अवजी पोर चोखली आत्‌मा तमारी ह़ाते रीन कळी ना माणहु ने तीमना झुटा धरम ना बारा मे पुरावा भेळ गुनो देखाड़ीन ह़मजाड़हे <verse eid="JHN 16:10" /><verse number="11" style="v" sid="JHN 16:11" />आहयी कळी ना मुखी भुतड़ा नो नीयाव हय जेलो से अने तीना पाप नो डंड तीने छोटोत जड़न्‌यो से। एतरे चोखली आत्‌मा कळी ना माणहु ने बी तीमना झुटा नीयाव ना बारा मे पुरावा भेळ देखाड़ीन ह़मजाड़हे।<verse eid="JHN 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 16:12" />तमने केवा करीन अळी ढेरेत वात मारा मन मे आय री, पण हमणे केही ता तमने वेठाय नी। <verse eid="JHN 16:12" /><verse number="13" style="v" sid="JHN 16:13" />जत्‌यार आत्‌मा आवहे, ता तीहयी तमने भगवान नी आखी सच्‌चाय भणी लीजवा करीन अगवाय करहे। काहाके तीहयी आह़फा नी अवड़ते कंय बी नी केय, बाखीन तीहयी जे कंय मारी पांह गेथु ह़मळहे तीहयुत केहे, अने आव्‌वा वाळी वात ना बारा मे बी तमने देखाड़हे। <verse eid="JHN 16:13" /><verse number="14" style="v" sid="JHN 16:14" />तीहयी मारी बड़ाय करहे, काहाके तीहयी तमने मारी भणी गेथु जे जड़लु से, तीहयु तमने देखाड़हे। <verse eid="JHN 16:14" /><verse number="15" style="v" sid="JHN 16:15" />जे कंय बाह नु से तीहयु आखु मारु से, आनीन करते मे केदलो, के तीहयी मारी वातु मे गेथी तमने देखाड़हे।<verse eid="JHN 16:15" /></para>
  <para style="s">दुख, खुसी मे बदली जहे</para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 16:16" />ईसु आह़फा ना चेला ने अगो केतो ज्‌यो, “थोड़ीक वार मे तमु मने नी देखो। अने अळतेण अळी थोड़ीक वार मे मने देखहु।”<verse eid="JHN 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 16:17" />तत्‌यार तीना थोड़ाक चेला आंबा-सांबा पुछ्‌या, “आहयु ह़ु से, जे तीहयो आमने केय, थोड़ीक वार मे तमु मने नी देखो, अने अळी थोड़ीक वार मे मने देखहु? अने आहयु आनीन करते के मे बाह ने तां जाय र्‌यो।” <verse eid="JHN 16:17" /><verse number="18" style="v" sid="JHN 16:18" />तत्‌यार तीहया केदा, “आहयी थोड़ीक वार जे तीहयो केय, ह़ु वात से? आमु नी जाणता, के ह़ु की र्‌यो।”<verse eid="JHN 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 16:19" />ईसु आहयु जाणतो हतो, के हीय्‌या मने पुछवा हींड र्‌या, तीमने केदो, तमु आह़फा-आह़फा मारी वात ना बारा मे पुछवा बाज र्‌या, थोड़ीक वार मे तमु मने नी देखो, अने अळी थोड़ीक वार मे देखहु? <verse eid="JHN 16:19" /><verse number="20" style="v" sid="JHN 16:20" />मे तमने ह़ाची-ह़ाची केम, के तमु रड़हु अने कलपहु, पण आहयी कळी खुस हयहे अने तमु दुखी हयह़ु पण तमारो दुख खुसी मे बदल जहे। <verse eid="JHN 16:20" /><verse number="21" style="v" sid="JHN 16:21" />जत्‌यार बयर जणवा बाज जाय, ता तीहयी वेला करे, काहाके तीनी दुख नी टेम आय लागी, पण जत्‌यार तीहयी सोरु ने जण देय ता आहयी खुसी से के कळी मे एक माणेह पयदा हयु, तीहया दुख ने अळी फोम नी करे। <verse eid="JHN 16:21" /><verse number="22" style="v" sid="JHN 16:22" />हेमेत हमणे ते तमु बी दुखी से, बाखीन मे तमने अळी भेटही, तत्‌यार तमारा मन मे बी खुस हय जहु; अने तमारी खुसी ने तमारी पांह गेथी कोय सी नी हपकाये।<verse eid="JHN 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 16:23" />ते दाड़े तमु मारी पांह कंय बी नी मांगो: मे तमने ह़ाची-ह़ाची आहयु केम, कदीम तमु भगवान बाह पांह मारा नाम सी वीन्‌ती करीन मांगहु, ता तीहयो तमने आपहे। <verse eid="JHN 16:23" /><verse number="24" style="v" sid="JHN 16:24" />हजु लग तमु मारा नाम सी कंय बी नी मांग्‌या। मांगो, ता भगवान तमने आप देहे, आनीन करते के तमारी खुसी पुरी हय जाय।<verse eid="JHN 16:24" /></para>
  <para style="s">ईसु कळी ने जीक लेदलो से</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 16:25" />मे तमने आहयी आखी वात दाखला ना लारे केदलो से। आसवी टेम आव्‌वा बाज री, के मे अळी तमने दाखला ना लारे नी देखाड़ु; पण भगवान बाह ना बारा मे चोखुझण देखाड़ही। <verse eid="JHN 16:25" /><verse number="26" style="v" sid="JHN 16:26" />तीहया दाड़े तमु मारा नाम सी मांगहु, अने मे तमने आहयु नी केतो, के मे तमारी लेदे बाह सी वीन्‌ती करही। <verse eid="JHN 16:26" /><verse number="27" style="v" sid="JHN 16:27" />काहाके बाह ते खुद तमारी सी मोंग करे, आनीन करते के तमु मारी सी मोंग राखला से, अने आहयो बी भरहो कर्‌या, के मे बाह भणी गेथो आवलो से। <verse eid="JHN 16:27" /><verse number="28" style="v" sid="JHN 16:28" />मे बाह भणी गेथो धरती पोर आवलो से, अळी धरती ने सोड़ीन पासो बाह ने तां जवा बाज र्‌यो।<verse eid="JHN 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 16:29" />ईसु ना चेला ईसु ने केदा, “देख, तु हाव दाखला ना लारे नी केतो पण चोखुझण केवा बाज र्‌यो। <verse eid="JHN 16:29" /><verse number="30" style="v" sid="JHN 16:30" />हाव आमु जाण ज्‌या, के तु आखु जाणे, अने जरवत नी के कोय तारी सी कंय पुछे, आनी सी आमु भरहो कर र्‌या, के तु भगवान भणी गेथो आवलो से।”<verse eid="JHN 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 16:31" />ईसु तीमने केदो, “तमु वीच्‌यार कर र्‌या के हाव आमु पक्‌को भरहो कर लेदा। <verse eid="JHN 16:31" /><verse number="32" style="v" sid="JHN 16:32" />पण देखो! आसवी टेम आव्‌वा बाज री, अने आय वागली से, जत्‌यार तमु आखा रीवण्‌या-तीवण्‌या हय जहु, अने मने एखलोत सोड़ीन जत रेहु। ते बी मे एखलो नी हय, काहाके भगवान बाह मारी ह़ाते से।” <verse eid="JHN 16:32" /><verse number="33" style="v" sid="JHN 16:33" />हाव आहयी कळी मे तमने दुख झेलवा पड़हे। ते बी हीम्‌मत राखजो, मे आहयी कळी ने जीक लेदलो से। मे आहयी आखी वात आनीन करते केदलो से, के आव्‌वा वाळा दाड़ा मे तमु दुख झेलता जाय्‌न बी मारी मे सांती हात कर लेवो तेम।<verse eid="JHN 16:33" /></para>
  <chapter eid="JHN 16" />
  <chapter number="17" style="c" sid="JHN 17" />
  <para style="s">ईसु आह़फा ना चेला जुगु वीन्‌ती करे</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 17:1" />ईसु आहयी वात कीदीन ह़रग भणी भाळीन केदो, “ए मारा भगवान बाह! तारा बेटा नी मरवा नी घड़ी आय वागली से, एतरे तारा बेटा नी बड़ाय उजन्‌ती कर। <verse eid="JHN 17:1" /><verse number="2" style="v" sid="JHN 17:2" />तु ते तारा बेटा ने आखा माणहु पोर हक आपलो से, के तीहया हक ना लारे तीहयो आखा माणहु ना वच मे तारी बड़ाय उजन्‌ती करे, अने तीमनी मे गेथा जेतरा बी माणहु तु तीना हात मे ह़ोपलो से, तीमने आखाम ने तु अमर जीवाय आपही। <verse eid="JHN 17:2" /><verse number="3" style="v" sid="JHN 17:3" />एकीत खरलो भगवान तुत से अने मे, ईसु तारी लारे सोड़ावण्‌यो मसी से, तने अने मने जाणीन मानवा सीत माणहु ने अमर जीवाय जड़े। <verse eid="JHN 17:3" /><verse number="4" style="v" sid="JHN 17:4" />जे काम तु मने करवा करीन आपलो हतो, तीहयु काम करीन मे धरती पोर तारी बड़ाय ने उजन्‌ती करलो से। <verse eid="JHN 17:4" /><verse number="5" style="v" sid="JHN 17:5" />ए भगवान बाह! कळ नी घड़ायी अने पेल्‌नो मे तारी ह़ाते हतो, अने मे तारीन तेम बड़ाय मे हतो। हाव मने ते बड़ाय मे पासो भेसकी ले।”<verse eid="JHN 17:5" /></para>
  <para style="s">ईसु आह़फा ना चेला जुगु वीन्‌ती करे</para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 17:6" />“जे माणहु ने तु आहयी कळी मे गेथा टाळीन मने ह़ोपलो से, तीमनी अगळ मे तारु नाम उजन्‌तु कर देदलो से। ह़ाचलीन तीहया माणहु तारात हता; अने तु तीमने मारा हात मे ह़ोप देदो। अने तीहया तारी ह़ीकापण ने मान र्‌या। <verse eid="JHN 17:6" /><verse number="7" style="v" sid="JHN 17:7" />हाव तीहया जाण जेला से, के जे कंय तु मने आपलो से, तीहयु आखु तारी भणी गेथु से; <verse eid="JHN 17:7" /><verse number="8" style="v" sid="JHN 17:8" />काहाके जे खबर तु मने आप्‌यो, मे तीमने पुगाड़ देदो अने तीहया तीने आवरी लेदा अने तीहया तीने ह़ाचली जाण लेदा के मे तारी भणी गेथो आवलो से, अने तीहया भरहो कर्‌या के तु मने मोकल्‌लो से।”<verse eid="JHN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JHN 17:9" />“मे ईमनी जुगु वीन्‌ती करु तीहयी वीन्‌ती तु ह़मळी ले। मे कळी ना माणहु जुगु वीन्‌ती नी करतो, पण तीमनीत जुगु वीन्‌ती कर र्‌यो के जीने तु मारा हात मे ह़ोपलो से, काहाके आहया तारात से। <verse eid="JHN 17:9" /><verse number="10" style="v" sid="JHN 17:10" />ह़ाचलीन जे कंय मारु से, तीहयु तारु से, अने तारु से, तीहयु मारु से। एतरे ईमनी लारे मारी बड़ाय उजन्‌ती हयली से।” <verse eid="JHN 17:10" /><verse number="11" style="v" sid="JHN 17:11" />“मे आहयी कळी ने सोड़ीन तारीन्‌तां आव्‌वा हींड र्‌यो। पण आहया चेला कळीत मे रेहे। ए चोखला भगवान बाह! तु जे मने नाम आपलो से, तीहया नामे आमनी रखवाळी कर, जीनी सी आहया आपणीन तेम एक हय जाय। <verse eid="JHN 17:11" /><verse number="12" style="v" sid="JHN 17:12" /><note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="JHN 13:18">युहन्‌ना 13:18</ref></char></note>जत्‌यार तक मे आमनी ह़ाते हतो, तत्‌यार लग मे तारा नाम नी लारे आमनी पुरी रखवाळी करतो र्‌यो। तीमनी मे नो कोय बी ठायको नी मर्‌यो; पण एकीत जणो ठायको मर जेलो, जे खुटवा वाळोत हतो। खरला सास्‌तर मे लीखली वात पुरी हयवात जोवे करीनेत आसम हयु।” <verse eid="JHN 17:12" /><verse number="13" style="v" sid="JHN 17:13" />“हाव मे तारीन्‌तां आव्‌वा हय र्‌यो, अने मे आहयी वीन्‌ती आहयी कळी मे रीन करवा बाज र्‌यो, जीनी सी जे खुसी मारी मे से, तीहयी खुसी चेला पुरीन-पुरी हात कर लेय। <verse eid="JHN 17:13" /><verse number="14" style="v" sid="JHN 17:14" />मे तारी वात आमने की देदलो से। अने भगवान नो वीरोद करन्‌या आहयी कळी ना माणहु आमनी सी ह़ीगी करे, काहाके जेम मे आहयी कळी ना माणहु ह़ाते ह़ात-ह़ंगात नी करु, तेमेत आहया चेला बी आहयी कळी ना माणहु ह़ाते ह़ात-ह़ंगात नी करे। <verse eid="JHN 17:14" /><verse number="15" style="v" sid="JHN 17:15" />मे आहयी वीन्‌ती नी करतो, के तु तीमने आहयी कळी मे गेथा लीजती रे; पण आहयु के तु तीने बुराय सी बचाड़। <verse eid="JHN 17:15" /><verse number="16" style="v" sid="JHN 17:16" />जीसम मे आहया कळी नो नी हय तेमेत तीहया बी आहयी कळी ना नी हय। <verse eid="JHN 17:16" /><verse number="17" style="v" sid="JHN 17:17" />ए भगवान बाह, तारो बोल खरलो से। आहयी सच्‌चाय नी लारे आमने तारी सेवा जुगु चोखा करीन तीयार कर। <verse eid="JHN 17:17" /><verse number="18" style="v" sid="JHN 17:18" />जेम तु मने आहयी कळी मे सेवा ना काम नो हक आपीन मोकल्‌लो से, तेमेत मे बी आमने आहयी कळी मे सेवा ना काम नो हक आपीन मोकल्‌लो से। <verse eid="JHN 17:18" /><verse number="19" style="v" sid="JHN 17:19" />अने तीमना फायदा जुगु मे मारो जीव आपीन आह़फा ने टाळीन चोखो करु, आनीन करते के आहया बी तारी सच्‌चाय ना बोलु नी लारे तारी सेवा जुगु टळीन चोखा हय्‌न तीयार हय जाय।”<verse eid="JHN 17:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 17:20" />“मे आमनी जुगु एतरोत नी वीन्‌ती करतो, पण तीमनी जुगु बी वीन्‌ती कर र्‌यो, जे आव्‌वा वाळा दाड़ा मे आमनी वात ह़मळीन मारी पोर भरहो करहे।”<verse eid="JHN 17:20" /></para>
  <para style="s">ईसु पोर भरहो करवा वाळा आखा जुगु ईसु पेलेत वीन्‌ती करे</para>
  <para style="p">
    <verse number="21" style="v" sid="JHN 17:21" />“मे वीन्‌ती करु, के तीहया आखा एक हय जाय। ए बाह! जीसम तु मारी मे से अने मे तारी मे, तेमेत हीय्‌या बी अमारी मे एक हय जाय, आनी सी कळी ने भरहो हय जहे के तु मने मोकल्‌लो से। <verse eid="JHN 17:21" /><verse number="22" style="v" sid="JHN 17:22" />अने तीहयी बड़ाय जे तु मने आपलो से, तीहयी मे तीमने आप देदलो से, के जीसम आपणु एक से, तीसम तीहया बी हये। <verse eid="JHN 17:22" /><verse number="23" style="v" sid="JHN 17:23" />मे तीमनी मे अने तु मारी मे, जीनी सी तीहया पुरी रीते एक हय जाय अने आहयी कळी ना माणहु जाण लेय के तु मने मोकल्‌लो से अने जे रीते तु मने मोंग कर्‌यो तेमेत तीमनी सी बी मोंग करलो से।”<verse eid="JHN 17:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 17:24" />“ए बाह, मे चाहु के जीमने तु मने आपलो से, जां मे से तां तीहया बी मारी ह़ाते रेय, के तीहया मारी तीहयी बड़ाय ने देख सके, जे तु मने आपलो से, काहाके तु कळ नी घड़ायी तीनी पेले गेथो मारी सी मोंग कर्‌यो। <verse eid="JHN 17:24" /><verse number="25" style="v" sid="JHN 17:25" />ए धरमी बाह, आहयी कळी मने नी जाणी, पण मे तने जाणलो से, अने तीहया जाण ज्‌या के तुत मने मोकल्‌लो से। <verse eid="JHN 17:25" /><verse number="26" style="v" sid="JHN 17:26" />मे तारु नाम तीमने देखाड़्‌यो, अने देखाड़तो रेही, के जे मोंग तु मने आप्‌यो, तीहयो मोंग तीमनी मे बणलो रेय अने मे बी तीमनी मे बणलो रेम।”<verse eid="JHN 17:26" /></para>
  <chapter eid="JHN 17" />
  <chapter number="18" style="c" sid="JHN 18" />
  <para style="s">ईसु नु धरावणु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 18:1" />ईसु आह़फा ना भगवान बाह ह़ाते वीन्‌ती करीन नवराय ज्‌यो, अने अळतेण आह़फा ना चेला ह़ाते एक कोतड़ु ने छेकीन एक वाड़ी मे ज्‌यो। ते कोतड़ु नु नाम कीदरोन हतु। <verse eid="JHN 18:1" /><verse number="2" style="v" sid="JHN 18:2" />ईसु आह़फा ना चेला ह़ातेण घणो झाजो जीया करतो हतो। एतरे ईसु ने धोको दीन धराव्‌वा वाळो चेलो यहुदा बी आहयी वाड़ी ने देख र्‌यो हतो <verse eid="JHN 18:2" /><verse number="3" style="v" sid="JHN 18:3" />अळतेण यहुदो, रोमी सीपायड़ा नो टोळो लीन, अने मंदीर ना डायला पुंजारा ना, अने फरीसी पंथवाळा माणहु ना लारे मोकल्‌ला मंदीर ना रखवाळ्‌या सीपायड़ा ने लीन तीहयी वाड़ी मे आय लाग्‌यो। तीहया दीवा, कंदल्‌या, अने हत्‌यार भेळ आवला हता। <verse eid="JHN 18:3" /><verse number="4" style="v" sid="JHN 18:4" />मारी पोर ह़ु-ह़ु वीतहे तीहयु आखु जाणीन, ईसु अगो ज्‌यो, अने तीमने केदो, “तमु कोयने ह़ोद र्‌या?”<verse eid="JHN 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JHN 18:5" />तीहया तीमने जपाप आप्‌या, “ईसु नासरी ने।”</para>
  <para style="p" vid="JHN 18:5">ईसु तीमने केदो, “मे से।”</para>
  <para style="p" vid="JHN 18:5">अने तीने धराव्‌वा वाळो यहुदा बी तीमनी ह़ाते उबो हतो। <verse eid="JHN 18:5" /><verse number="6" style="v" sid="JHN 18:6" />जत्‌यार ईसु तीमने केदो, “मे तीहयो से” तीहया पासा जत र्‌या अने हेटा पड़ ज्‌या। <verse eid="JHN 18:6" /><verse number="7" style="v" sid="JHN 18:7" />ईसु तीमने अळी पुछ्‌यो, “तमु कोयने ह़ोद र्‌या?”</para>
  <para style="p" vid="JHN 18:7">तीहया केदा, “ईसु नासरी ने ह़ोद र्‌या?”<verse eid="JHN 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 18:8" />ईसु जपाप आप्‌यो, मे तमने पेलेत की देदो के मे तीहयोत से, कदीम तमु मने ह़ोद र्‌या हय ता मारा आहया चेला ने जवा देवो। <verse eid="JHN 18:8" /><verse number="9" style="v" sid="JHN 18:9" />आहयु आनीन करते हयु, के जे तीहयो केदलो तीहयु पुरु हयवा जोवे, “जीने तीहयो मारा सुपरत करलो से, तीमनी मे ना ने एक बी खोवायवा नी देम।”<verse eid="JHN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JHN 18:10" />तत्‌यार सीमोन पतरस आह़फा नी तलवार मीयान मे गेथी काडीन मंदीर ना डायला पुंजारा ना पावर्‌या ने देदो, अने तीनो जमणो कान्‌टो वाड नाख्‌यो। ते पावर्‌या नु नाम मलखुस हतु। <verse eid="JHN 18:10" /><verse number="11" style="v" sid="JHN 18:11" /><note caller="+" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="MAT 26:39">मत्‌ती 26:39</ref>; <ref loc="MRK 14:36">मरकुस 14:36</ref>; <ref loc="LUK 22:42">लुका 22:42</ref></char></note> ईसु पतरस ने केदो, “तलवार पासी मीयान मे घाल ले। जे दुख नो पीयालो भगवान बाह मने पीवा करीन आपलो से, तीहयो दुख नो पीयालो तु ना पीय करीन तु अड़चन काहा नाख र्‌यो?”<verse eid="JHN 18:11" /></para>
  <para style="s">सीपायड़ा ईसु ने धरीन मुखी पुंजारा हन्‌ना अगळ ली जाय</para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 18:12" />अळतेण रोमी सीपायड़ा नो टोळो, अने तीमनो सुबेदार, अने युहदी-पुडार्‌या ना लारे मोकल्‌ला मंदीर ना रखवाळ्‌या सीपायड़ा, ईसु ने धरीन बांद लेदा। <verse eid="JHN 18:12" /><verse number="13" style="v" sid="JHN 18:13" />अने ईसु ने धरीन पेले हन्‌नान तां ली ज्‌या, तीहयो मंदीर ना डायला पुंजारा नो जुन्‌लो मुखी हतो। काहाके आहयो हन्‌ना केफा नो ह़ाहरो हतो, आहयो केफा तीहया साल मंदीर ना डायला पुंजारा नो मुखी हतो। <verse eid="JHN 18:13" /><verse number="14" style="v" sid="JHN 18:14" /><note caller="+" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="JHN 11:49">युहन्‌ना 11:49</ref>,<ref loc="JHN 11:50">50</ref></char></note>आहयो तीहयोत केफा हतो, जे युहदी ने आसम कीन अगवाय करलो के, आपणा माणहु जुगु एक माणेह ने मरवा वारु से।<verse eid="JHN 18:14" /></para>
  <para style="s">पतरस ईसु नो नीकारो करे</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 18:15" />सीमोन पतरस अने एक अळी बीजो चेलो ईसु पसळ-पसळ चाल पड़्‌या। आहयो बीजो चेलो, डायला पुंजारा ना मुखी नो ओळखायतो हतो; एतरे आहयो चेलो, ईसु ह़ाते मंदीर ना डायला पुंजारा ना मुखी ना आंगणा मे लग ज्‌यो, आने कोय नी रोक्‌यु। <verse eid="JHN 18:15" /><verse number="16" style="v" sid="JHN 18:16" />पण पतरस झापलेत उबो री ज्‌यो। एतरे डायला पुंजारा ना मुखी नो ओळखायतो चेलो ते आंगणा मे गेथो पासो बारो जाय्‌न झापलु रखवाळ्‌याण पावर्‌याण ने पुसीन, पतरस ने मोय आंगणा मे ली आयो। <verse eid="JHN 18:16" /><verse number="17" style="v" sid="JHN 18:17" />तीहयी झापलु रखवाळ्‌याण पावर्‌याण पतरस ने केदी, “तु बी तीहया अदमी ना चेला मे नो नी हय ह़ु?”</para>
  <para style="p" vid="JHN 18:17">पतरस केदो, “नी हय।”<verse eid="JHN 18:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 18:18" />टाड ना दाड़ा हता, एतरे घोर ना पावर्‌या अने मंदीर ना रखवाळ्‌या सीपायड़ा उबा-उबा तापवा बाज र्‌या हता। अने पतरस बी तीमनी ह़ाते आक्‌ठु तापवा बाज र्‌यो हतो।<verse eid="JHN 18:18" /></para>
  <para style="s">डायला पुंजारा नु ईसु ने पुछवु</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 18:19" />अळतेण मंदीर ना डायला पुंजारा नो मुखी हन्‌ना, ईसु ने तीना चेला ना बारा मे, अने तीनी ह़ीकापण ना बारा मे पुछ्‌यो। <verse eid="JHN 18:19" /><verse number="20" style="v" sid="JHN 18:20" />ईसु जपाप आप्‌यो, “मे होगो-होगो कंय बी नी ह़ीकाड़्‌यो, मे माणहु अगळ उजन्‌तो ह़ीकापण आपलो से, मे जलम तमारा भक्‌ती ना घोर मे अने मंदीर मे, जां आखा युहदी माणहु भेळा हया करे, ह़ीकापण आपतो र्‌यो। <verse eid="JHN 18:20" /><verse number="21" style="v" sid="JHN 18:21" />तु मने ह़ुका पुछ र्‌यो? ह़मळन्‌या ने आसम पुछ के हीय्‌यो तमने ह़ु ह़ीकाड़लो से? मे तीमने ह़ु-ह़ु केदलो से तीमने मालम से।”<verse eid="JHN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 18:22" />जत्‌यार ईसु आहयी वात केदो, ता तां उबा हय रेला मंदीर ना रखवाळ्‌या सीपायड़ा मे नो एक जणो ईसु ने एक थापड़ देदो अने केदो, “तु मंदीर ना पुंजारा ना मुखी ने आसम जपाप काहा आप र्‌यो?”<verse eid="JHN 18:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 18:23" />ईसु तीने जपाप आप्‌यो, “कदीम मे गलत वात केदो हय, ता पुरावो दीन देखाड़; पण ह़ाचली वात केदो हय, ता मने काहा देय।”<verse eid="JHN 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 18:24" />अळतेण हन्‌नो हेमेत बंदायलोत ईसु ने हमणे ना डायला पुंजारा ना मुखी केफान्‌तां मोकली देदो।<verse eid="JHN 18:24" /></para>
  <para style="s">पतरस ईसु नो अळी नीकारो करे</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 18:25" />तीहयी टेमे सीमोन पतरस आक्‌ठुन तां उबो-उबो तापवा बाज र्‌यो हतो।</para>
  <para style="p" vid="JHN 18:25">तत्‌यार थोड़ाक माणहु पतरस ने केदा, “तु बी तीना चेला मे नो एक से ह़ु?” पतरस ईसु नो नीकारो करतो जाय्‌न केदो, “मे नी हय।”<verse eid="JHN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 18:26" />मोट्‌ला पुंजारा ना चाकर्‌या मे गेथो एक, तीहया माणहु नो ह़गलो हतो तीनो कान्‌टो पतरस तोड़ देदलो हतो। तीहयो केदो, “ह़ु मे तने तीनी ह़ाते वाड़ी मे नी देख्‌यो?”<verse eid="JHN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 18:27" />पतरस अळी ईसु नो नीकारो करतो जाय्‌न केदो, “मे नी हय।” अने तत्‌यारुत कुकड़ो वाही देदो।<verse eid="JHN 18:27" /></para>
  <para style="s">ईसु ने पीलातुस अगळ उबो करे</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 18:28" />ह़वारे-ह़वारे ईसु ने केफा ना घोर गेथा राजा नी हवेली मे ली ज्‌या। युहदी मुखी माणहु हवेली मे नी जता हता, काहाके तीहया फसह ना तीवार नु खाणु खावा लायक बणवा नी लेदे खुद ने चोखला राखवा हींडता हता। <verse eid="JHN 18:28" /><verse number="29" style="v" sid="JHN 18:29" />एतरे राज करन्‌यो पीलातुस हवेली मे गेथो बारो नीकळीन तीमनी अगळ आयो अने केदो, “तमु आहया माणेह पोर कानो गुनो लगाड़ र्‌या?”<verse eid="JHN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 18:30" />तीहया जपाप आप्‌या, “कदीम आहयो गुनाळ्‌ळो नी हतो, ता आमु आने तारीन्‌तां नी लावता।”<verse eid="JHN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 18:31" />पीलातुस तीमने केदो, “तमुत आने ली जावो ने तमारा कायदा ना लारे आनो नीयाव करजो।”</para>
  <para style="p" vid="JHN 18:31">युहदी-पुडार्‌या केदा, “अमारी पांह कोयने जीव ह़ाटे डंड आपवा नो हक नी हय।” <verse eid="JHN 18:31" /><verse number="32" style="v" sid="JHN 18:32" /><note caller="+" style="x"><char style="xo" closed="false">18:32 </char><char style="xt" closed="false"><ref loc="JHN 3:14">युहन्‌ना 3:14</ref>; <ref loc="JHN 12:32">12:32</ref></char></note>मारी मोत कीसम हयहे करीन ईसु पेलेत आह़फा ना चेला ने केदलो हतो। अने ईसु नी केदली वात नी लारे आखु हयु, अने तीनात लारे हाव युहदी-पुडार्‌या तीने मोत नो डंड अपाड़वा करीन पीलातुस सी वात कर्‌या।<verse eid="JHN 18:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JHN 18:33" />अळतेण पीलातुस अळी पासो हवेली मे जत र्‌यो, अने ईसु ने बोलाय मांग्‌यो, अने तीने पुछ्‌यो, “तु युहदी माणहु नो राजा से ह़ु?”<verse eid="JHN 18:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JHN 18:34" />ईसु पीलातुस ने जपाप आप्‌यो, “आहयी वात तु तारा अवड़तेत की र्‌यो के मारा बारा मे काना बीजा तने केदला से?”<verse eid="JHN 18:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="JHN 18:35" />पीलातुस ईसु ने जपाप आप्‌यो, “मे युहदी से ह़ु? तारीत जाती ना माणहु, मंदीर ना डायला पुंजारा भेळता भेसकाय्‌न, तने धराय्‌न मारी सुपरत करला से। तु कानो गुनो करलो से?”<verse eid="JHN 18:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JHN 18:36" />ईसु केदो, “मारु राज आहयी कळी ना राजान तेम नी हय। कदीम मारु राज आहयी कळी ना राजान तेवु रेतु, ता मारा रखवाळ्‌या सीपायड़ा मारीन करते झगड़ो करता, अने मे युहदी माणहु ना हात मे नी धरायतो। पण मारु राज आहयी कळी ना राज ने तेवु नी हय।”<verse eid="JHN 18:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JHN 18:37" />आहयु ह़मळीन पीलातुस ईसु ने केदो, “ता तु ह़ाचलीन राजा से ह़ु?” ईसु पीलातुस ने जपाप आप्‌यो, “तु तालेत की र्‌यो, काहाके मे राजा से। अने मे सच्‌चाय ना गवा-पुरावा आपवा करीनेत आहयी कळी मे पयदा हय्‌न आवलो से। अने जे सच्‌चाय वगो से, तीहयो मारी वात ह़मळीन पाळे।”<verse eid="JHN 18:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 18:38" />पीलातुस ईसु ने पुछ्‌यो, “सच्‌चाय ह़ु से?” आहयु पुछीन पीलातुस अळी हवेली मे गेथो बारो नीकळीन, युहदी-पुडार्‌या अगळ केदो, “मने ते हीय्‌या माणेह मे कंय बी गुनो नी देखायतो।”<verse eid="JHN 18:38" /></para>
  <para style="s">ईसु ने मोत नो डंड आपे</para>
  <para style="p">
    <verse number="39" style="v" sid="JHN 18:39" />“पण तमारी रीती ना लारे, मे तमारी जुगु फसह ना तीवार नी टेमे एक केदी ने जेल मे गेथो छोड़्‌या करतो हतो। एतरे तमारी मरजी हय ता तमारी जुगु हीने सोड़ देम ह़ु, जीने तमु अमारा युहदी माणहु नो राजा कीन वाक काडे?”<verse eid="JHN 18:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JHN 18:40" />आहयु ह़मळीन तीहया एक कावा अळी आड़ीन केदा, “हीने ना सोड़े पण बरब्‌बा ने सोड़ दे।” अने आहयो बरब्‌बा डाकु हतो।<verse eid="JHN 18:40" /></para>
  <chapter eid="JHN 18" />
  <chapter number="19" style="c" sid="JHN 19" />
  <para style="s">सीपायड़ा ईसु ना मुंडा पोर काटा नु मुळ्‌यु गुथीन मेके</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 19:1" />अळतेण पीलातुस ईसु ने लीजवाड़ीन ह़ड़का देवाड़्‌यो। <verse eid="JHN 19:1" /><verse number="2" style="v" sid="JHN 19:2" />अने सीपायड़ा कटाळस्‌या नु मुळ्‌यु गुथीन ईसु ना मुंडा पोर मेक देदा, अने जामण्‌यु डगलु पेराया। <verse eid="JHN 19:2" /><verse number="3" style="v" sid="JHN 19:3" />अने ईसुन्‌तां आवीन केवा बाज ज्‌या, “ए युहदी माणहु ना राजा, वारु से के!” अने तीहया तीने थापड़्‌या देदा।<verse eid="JHN 19:3" /></para>
  <para style="s">पीलातुस ईसु ने मारवा नो हुकम आपे</para>
  <para style="p">
    <verse number="4" style="v" sid="JHN 19:4" />पीलातुस अळी बारो जाय्‌न माणहु ने केदो, “देखो, मारी नींगा मे आनी मे कंय बी खोड़ देखाव नी पड़तो। आहयु तमु बी जाणवा जोवे करीन मे आने अळी बारो तमारी अगळ लवाड़ु।” <verse eid="JHN 19:4" /><verse number="5" style="v" sid="JHN 19:5" />तीहयी टेमे ईसु ना मुंडा पोर काटा नु मुळ्‌यु मेकलुत हतु, अने तीने जामण्‌यु डगलु पेरावलुत हतु, तेमेत तीहयो बारो आयो। अने पीलातुस माणहु ने केदो, “देखो आहयो से तीहयो माणेह!”<verse eid="JHN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 19:6" />मंदीर ना डायला पुंजारा अने मंदीर ना रखवाळ्‌या सीपायड़ा, ईसु ने देखीन, पीलातुस अगळ आसम आड़ी पड़्‌या, “हीने कुरुस पोर चड़ाव, कुरुस पोर चड़ाव!” पीलातुस तीमने केदो, “मारी नींगा मे आनी मे कंय बी खोड़ नी देखाव पड़तो। एतरे आने तमुत ली जावो, अने तमु आह़फात हीने कुरुस पोर चड़ावीन मार देवो!”<verse eid="JHN 19:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 19:7" />युहदी-पुडार्‌या केदा, “अमारी पांह मुसा नी लारे लीखली सास्‌तर से, तीनी लारे हीने मोत नो डंड जड़वा जोवे। काहाके हीय्‌यो आह़फोत भगवान नो बेटो हयवा नो दावो करलो से।”<verse eid="JHN 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JHN 19:8" />पीलातुस तीमनी वात ह़मळीन अळी बी, बीही ज्‌यो। <verse eid="JHN 19:8" /><verse number="9" style="v" sid="JHN 19:9" />तीहयो अळी ईसु ने हवेली ना आंगणा मे ली जाय्‌न ईसु ने पुछ्‌यो, “तु कां गेथो आवलो से?” बाखीन ईसु तीने कंय जपाप नी आप्‌यो। <verse eid="JHN 19:9" /><verse number="10" style="v" sid="JHN 19:10" />एतरे पीलातुस ईसु ने केदो, “तु मने जपाप काहा नी आप्‌तो? तने नी मालम हय ह़ु, के मारी पांह तने सोड़वा नो हक से, ‘अने कुरुस पोर चड़ाव्‌वा नो बी हक से।’”<verse eid="JHN 19:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 19:11" />ईसु पीलातुस ने जपाप आप्‌यो, “कदीम तने ह़रगे गेथो हक नी जड़तो, ता तारो मारी पोर कानो बी हक नी रेतो। एतरे जे माणेह मने धरावीन तारा सुपरत करलो से तीहयो वदु पापी से।”<verse eid="JHN 19:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JHN 19:12" />ईसु नी आहयी वात ह़मळीन पीलातुस, ईसु ने सोड़वा नो वीच्‌यार कर्‌यो, पण युहदी-पुडार्‌या आड़ी-आड़ीन केदा, “जे आह़फा ने राजा केय, तीहयो आपणा रोमी राजा नो वीरोद करे, अने तीने डंड जड़वात जोवे। एतरे कदीम तु हीने सोड़ देही, ता तु आपणा रोमी राजा नो दोस्‌तीदार नी हय।”<verse eid="JHN 19:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JHN 19:13" />आहयी वात ह़मळीन पीलातुस, ईसु ने बारो गब्‌बाता नाम ना जागान तां लवाड़्‌यो। युहदी माणहु नी बोली मे आहया नाम नु मतलब “दगड़ा नी पयड़ी” हतु। अने पीलातुस तीहया जागा मे आह़फा नी नीयाव नी गादी पोर बह ज्‌यो। <verse eid="JHN 19:13" /><verse number="14" style="v" sid="JHN 19:14" />आहयो फसह ना तीवार नी तीयारी नो दाड़ो हतो। अने माथेक दाहड़ु हतु: तत्‌यार पीलातुस युहदी माणहु ने केदो, “देखो आहयो से, तमारो राजा!”<verse eid="JHN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 19:15" />ता युहदी-पुडार्‌या अळी आड़ीन केदा, आने आञे गेथो ली जा! आने आञे गेथो ली जा!</para>
  <para style="p" vid="JHN 19:15">अने आने कुरुस पोर चड़ाय दे! पीलातुस तीमने पुछ्‌यो, “मे तमारा राजा ने कुरुस चड़ाय देम ह़ु?”</para>
  <para style="p" vid="JHN 19:15">मंदीर ना डायला पुंजारा केदा, “रोमी राजा ने सोड़ीन अमारो कानो बी राजा नी हय।”<verse eid="JHN 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 19:16" />एतरे पीलातुस ईसु ने तीमना हात मे आनीन करते ह़ोप देदो, के तीहया हीने कुरुस पोर चड़ावे।<verse eid="JHN 19:16" /></para>
  <para style="s">सीपायड़ा ईसु ने कुरुस पोर चड़ावे</para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 19:17" />तत्‌यार तीहया ईसु ने ली ज्‌या, अने तीहयो आह़फा नु कुरुस उचलीन तीहया जागान्‌तां तक बारो ज्‌यो, जे “खोपड़ी नो जागो” अने ईब्‌रानी बोली मे “गुलगुता” केवाय। <verse eid="JHN 19:17" /><verse number="18" style="v" sid="JHN 19:18" />तां तीहया तीने अने अळी बे माणहु ने कुरुस पोर चड़ाया, एक ने आंखर अने एक ने तींखर अने वच मे ईसु ने। <verse eid="JHN 19:18" /><verse number="19" style="v" sid="JHN 19:19" />पीलातुस एक गुना नी चीट्‌ठी लीखाड़ीन कुरुस पोर लगाड़ देदो, तीनी पोर लीखलु हतु, “ईसु नासरी युहदी माणहु नो राजा।” <verse eid="JHN 19:19" /><verse number="20" style="v" sid="JHN 19:20" />आहयी गुना नी चीट्‌ठी घणा युहदी माणहु भण्‌या, काहाके तीहयो जागो जां ईसु ने कुरुस पोर चड़ावला, ह़ेर ह़ाते हतो अने गुना नी चीट्‌ठी ईब्‌रानी अने लतीनी अने युनानी भासा मे लीखली हती। <verse eid="JHN 19:20" /><verse number="21" style="v" sid="JHN 19:21" />तत्‌यार युहदी माणहु ना मुख्‌या पुंजारा पीलातुस ने केदो, युहद्‌या ना राजा ना लीखे, बाखीन तीहयो केदलो के मे युहद्‌या नो राजा से।<verse eid="JHN 19:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 19:22" />पीलातुस तीमने जपाप आप्‌यो, “मे जे लीखाड़ देदो, तीहयुत रेहे।”<verse eid="JHN 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 19:23" />अळतेण सीपायड़ा ईसु ने कुरुस पोर चड़ाय देदा: तत्‌यार तीहया ईसु ना लुगड़ा ना च्‌यार वाटा पाड़्‌या: एकीक सीपायड़ा जुगु एकीक वाटो पाड़्‌या। पण ईसु नु डगलु ह़ीवीन बणावलु नी हतु, अने पुरु गुथीन बणावलु हतु। <verse eid="JHN 19:23" /><verse number="24" style="v" sid="JHN 19:24" />तीहया आह़फा-आह़फा केदा,</para>
  <para style="q1" vid="JHN 19:24">आपणु आने नी फाड़ता पण आनी पोर चीट्‌ठी नाखीया के आहयु कोयने जड़े,</para>
  <para style="q2" vid="JHN 19:24">आहयु आनीन करते हयु के खरला सास्‌तर मे लीखलु हतु पुरु हयु,</para>
  <para style="m" vid="JHN 19:24">तीहया मारा लुगड़ा आह़फा वाट लेदा अने चीट्‌ठी नाख्‌या।<verse eid="JHN 19:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 19:25" />ईसु ना कुरुस धेड़्‌ये, ईसु नी आह्‌य, अने ईसु नी आह्‌य नी बेनेह, अने केलपास नी लाडी मरीयम, अने मगदलीनी मरीयम उबा हय र्‌या हता। <verse eid="JHN 19:25" /><verse number="26" style="v" sid="JHN 19:26" />ईसु तां ह़रो आह़फा नी आह्‌य ने देख्‌यो, अने तीना चेला ने बी देख्‌यो जे ईसु नो लाडलो चेलो केवायतो हतो; ता तीहयो आह़फा नी आह्‌य ने केदो, “ओ बाय! आहयो तारो बेटो से।”<verse eid="JHN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JHN 19:27" />तत्‌यार तीहया चेला ने केदो, “देख, आहयी तारी आय्‌ह से।” अने तीहयी टेमे तीहयो चेलो, तीने आह़फा ना घोर ली ज्‌यो।<verse eid="JHN 19:27" /></para>
  <para style="s">ईसु नी मोत</para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 19:28" />अळतेण ईसु आहयु जाणीन के हाव आखु कंय पुरु हय ज्‌यु; आनी लेदे के चोखली सास्‌तर मे जे की मेल्‌यु तीहयु पुरु करवा केदो, “मे तरहेलो से।”<verse eid="JHN 19:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 19:29" />ता एक ठाहरा मे अंगुर नो कड़वलो रोह भरीन मेल्‌लो हतो; रोह मे पोतु भीगवीन जुफा नी लाकड़ी पोर मेलीन ईसु ना मोडे लगाड़्‌या। <verse eid="JHN 19:29" /><verse number="30" style="v" sid="JHN 19:30" />जत्‌यार ईसु अंगुर नो कड़वलो रोह चाख्‌यो, ता केदो, “पुरु हय ज्‌यु।” अने आह़फा नु मुंडु हेटु वाळ लेदो, अने आह़फा नो जीव भगवान ने आप देदो।<verse eid="JHN 19:30" /></para>
  <para style="s">भालो पाहळी मे गोपे</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 19:31" />अने आनी लेदे के तीहयो तीयारी नो दाड़ो हतो, युहदी माणहु पीलातुस सी वीन्‌ती कर्‌या के हीना पोगु तोड़ दे अने उतार देवो काहाके अराम ना दाड़े हीय्‌यो कुरुस पोर नी रेय, काहाके तीहयो तीवार नो दाड़ो हतो <verse eid="JHN 19:31" /><verse number="32" style="v" sid="JHN 19:32" />एतरे सीपायड़ा आवीन ईसु नी आड़े-धेड़े कुरुस पोर चड़ावला माणहु ना पोगु भांग देदा। <verse eid="JHN 19:32" /><verse number="33" style="v" sid="JHN 19:33" />पण अळतेण तीहया ईसु ह़ाते आवीन देख्‌या, ता तीमने मालम पड़्‌यु के तीहयो मर जेलो से। ता तीहया तीना पोगु नी भांग्‌या। <verse eid="JHN 19:33" /><verse number="34" style="v" sid="JHN 19:34" />बाखीन तीहया सीपायड़ा मे नु एक सीपायड़ु ईसु ना कुखे भालो गोप्‌यु, अने कुखे गेथु तत्‌यारु लोय अने पाणी नीकळ्‌यु। <verse eid="JHN 19:34" /><verse number="35" style="v" sid="JHN 19:35" />जे कोय आहयु देख्‌यो, तीहयोत गवाय देदो, तीनी गवाय ह़ाचली से; तीहयो जाणे के हीय्‌यो ह़ाची की र्‌यो, के तमु बी भरहो करो। <verse eid="JHN 19:35" /><verse number="36" style="v" sid="JHN 19:36" />आहयी वात आनीन करते हयी के चोखली सास्‌तर मे लीखली वात पुरी हये तीनु कानु बी हाटकु नी भांगे। <verse eid="JHN 19:36" /><verse number="37" style="v" sid="JHN 19:37" /><note caller="+" style="x"><char style="xo" closed="false">19:37 </char><char style="xt" closed="false"><ref loc="REV 1:7">परकासीतवाक्‌य 1:7</ref></char></note>ते बी सास्‌तर मे एक जागा मे आहयु लीखलु से, जे बी तीने खुटा ठोकला से, तीनी भणी भाळहे।<verse eid="JHN 19:37" /></para>
  <para style="s">ईसु नु गाड़नु</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्‌ती 27:57-61</ref>; <ref loc="MRK 15:42-47">मरकुस 15:42-47</ref>; <ref loc="LUK 23:50-56">लुका 23:50-56</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="JHN 19:38" />आनीन अळतेण अरीमीतीया नो युसुफ ने जे ईसु नो चेलो हतो, पण युहदी माणहु ना धाके आहयी वात ने ह़ताड़ीन राखतो हतो, पीलातुस सी वीन्‌ती कर्‌यो के मे ईसु ना धोड़ ने ली जाय सकु, पीलातुस तीनी वीन्‌ती ह़मळ्‌यो, अने तीहयो आवीन तीनु धोड़ ली ज्‌यो। <verse eid="JHN 19:38" /><verse number="39" style="v" sid="JHN 19:39" /><note caller="+" style="x"><char style="xo" closed="false">19:39 </char><char style="xt" closed="false"><ref loc="JHN 3:1">युहन्‌ना 3:1</ref>,<ref loc="JHN 3:2">2</ref></char></note>नीकुदेमुस बी जे पेले ईसुन्‌तां राते जेलो हतो, तयतीस कीला नी आड़े-धेड़े गंदाण्‌यो मसालो लीन आयो। <verse eid="JHN 19:39" /><verse number="40" style="v" sid="JHN 19:40" />अने युहदी माणहु जीसम मरला माणहु ना धोड़ ने वगे करे तेमेत तीहया ईसु ना धोड़ ने वारु गंदाण्‌यो मसालो चोपड़्‌या अने लेफड़्‌या कफन मे वीटाळ देदा। <verse eid="JHN 19:40" /><verse number="41" style="v" sid="JHN 19:41" />जे जागा मे ईसु ने कुरुस पोर चड़ावला, ते जागा ह़ातेत एक वाड़ी हती; अने तीहयी वाड़ी मे एक नवलु मड़ाट्‌यु हतु; तीहया मड़ाट्‌या मे हजु लग कोयने वगे नी करला हता। <verse eid="JHN 19:41" /><verse number="42" style="v" sid="JHN 19:42" />हाव युहदी माणहु नो अराम नो दाड़ो सुरु हयवा वाळो हतो। अने तीहयु मड़ाट्‌यु ह़ातेत हतु करीन ईसु ना धोड़ ने तीहयात मड़ाट्‌या मे मेल देदा।<verse eid="JHN 19:42" /></para>
  <chapter eid="JHN 19" />
  <chapter number="20" style="c" sid="JHN 20" />
  <para style="s">ठारलु मड़ाट्‌यु</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 20:1" />हप्‌ता ना पेल्‌ना दाड़े, ह़वारे भळ-भाकेत, मरीयम मगदलीनी मड़ाट्‌यान्‌तां आयी; अने तीहयी मड़ाट्‌या पोर गेथो दगड़ो हेड़ मेकलो देखी। <verse eid="JHN 20:1" /><verse number="2" style="v" sid="JHN 20:2" />तीहयी सीमोन पतरस ने तां अने तीना बीजा चेलान्‌तां दवड़ीन आयी, जीने ईसु मोंग करत्‌लो, तीने केदी, “तीहया, मालीक ईसु नु धोड़ ने मड़ाट्‌या मे गेथु काडीन लीजती र्‌या; अने आमने मालम नी हय के तीहया धोड़ ने कां ह़रा मेल र्‌या।”<verse eid="JHN 20:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JHN 20:3" />तत्‌यार पतरस अने ईसु नो बीजो चेलो मड़ाट्‌या भणी दवड़ी पड़्‌या। <verse eid="JHN 20:3" /><verse number="4" style="v" sid="JHN 20:4" />तीहया बेम जणा ह़ाते-ह़ाते दवड़ी र्‌या हता, पण बीजो चेलो पतरस गेथो अगळ हय्‌न मड़ाट्‌यान्‌तां पेले पुग्‌यो। <verse eid="JHN 20:4" /><verse number="5" style="v" sid="JHN 20:5" />अने वाको वळीन लुगड़ा पड़ रेला देख्‌यो, ते बी तीहयो मड़ाट्‌या मे मोय नी ज्‌यो। <verse eid="JHN 20:5" /><verse number="6" style="v" sid="JHN 20:6" />ता सीमोन पतरस तीनी पसळ पुग्‌यो, अने मड़ाट्‌या मे मोय ज्‌यो अने लुगड़ा पड़ रेला देख्‌यो। <verse eid="JHN 20:6" /><verse number="7" style="v" sid="JHN 20:7" />अने तीहयु फटकु जे ईसु ना मुंडे बांदलु हतु, ईसु ना लुगड़ा ह़ाते पड़ रेलु नी हतु पण लुगड़ा गेथु सेटु बमणीन एक जागे मेकलु देख्‌यो। <verse eid="JHN 20:7" /><verse number="8" style="v" sid="JHN 20:8" />ता बीजो चेलो बी जे मड़ाट्‌या मे पेलो पुगलो, मोय ज्‌यो अने देखीन भरहो कर्‌यो। <verse eid="JHN 20:8" /><verse number="9" style="v" sid="JHN 20:9" />तीहया हजु लग तीहयी खरली सास्‌तर नी वात ने नी ह़मज्‌या के तीने मरला मे गेथो जीवतो हय्‌न बठो हयणुत से। <verse eid="JHN 20:9" /><verse number="10" style="v" sid="JHN 20:10" />अने तीहया बेम चेला तीमना-तीमना घोर जत र्‌या।<verse eid="JHN 20:10" /></para>
  <para style="s">मरीयम ने ईसु देखाव पड़े</para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 20:11" />पण मरीयम रड़ती जाय्‌न मड़ाट्‌यान्‌तांत उबी री, अने रड़ती-रड़ती मड़ाट्‌या भणी ढुंगी वळीन, मोय भाळी। <verse eid="JHN 20:11" /><verse number="12" style="v" sid="JHN 20:12" />अने जां ईसु नु धोड़ मेल्‌लु हतु, तां ह़रा उजळा लुगड़ा पेर रेला बे ह़रगदुत ने देखी। एक ने मुड़ाख्‌ये अने एक ने पायता भणी बह रेला देखी। <verse eid="JHN 20:12" /><verse number="13" style="v" sid="JHN 20:13" />तीहया तीने केदा, “ओ बाय जात! तु काहा रड़ री?” तीहयी केदी, तीहया मारा मालीक! ने चुट लीजला से, अने मने नी मालम हय के तीहया तीने कां ह़रा मेल र्‌या। <verse eid="JHN 20:13" /><verse number="14" style="v" sid="JHN 20:14" />आहयु कीन तीहयी पासु फीरीन भाळी अने तीहयी ईसु ने उबो हय रेलो देखी; पण तीने आहयो ईसु से करीन ओळखायु नी। <verse eid="JHN 20:14" /><verse number="15" style="v" sid="JHN 20:15" />ईसु तीने केदो, “ओ बाय जात! तु काहा रड़ री? कोयने ह़ोद री?” तीहयी मरीयम तीने, वाड़ी मे काम करन्‌यो पावोर ह़मजीन केदी, “ए दादा कदीम तु तीने चुट ली ज्‌यो हय ता मने कीदे के तीने कां ह़रो मेल र्‌यो, अने मे तीने ली आवही।”<verse eid="JHN 20:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JHN 20:16" />आहयु ह़मळीन ईसु तीने केदो, “ओ मरीयम!” तीहयी पासी फीरीन ईसु ने ओळखीन तीने केदी, “रब्‌बनी” ईब्‌रानी बोली मे आहया बोल नु मतलब “ए गुरु हतु।”<verse eid="JHN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JHN 20:17" />ईसु तीने केदो, मे हजु लग भगवान बाह ने तां उपर ह़रग मे नी ज्‌यो। एतरे मने छीमीन ना रोके, पण मारा भायुन तां जाय्‌न तीमने आहयु कीदे, “के ईसु की र्‌यो के मे मारा भगवान बाह ने तां जवा हींड र्‌यो, जे हाव गेथो तमारो बी भगवान बाह से।”<verse eid="JHN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JHN 20:18" />मरीयम मगदलीनी जाय्‌न आहयी वात चेला ने केदी के “मे मालीक ने देखली से, अने तीहयो मने आहयी वात की मोकल्‌यो।”<verse eid="JHN 20:18" /></para>
  <para style="s">ईसु चेला ने देखावा पड़े</para>
  <para style="p">
    <verse number="19" style="v" sid="JHN 20:19" />तीहयात दाड़े, हप्‌ता नो पेल्‌नो दाड़ो हतो, ह़ांती वळे ईसु ना चेला युहदी माणहु ना धाके आह़फात झापला दीन घोर मे कुंडाय र्‌या हता। अने ईसु तीमना वच मे आवीन उबो हय ज्‌यो। अने चेला ने केदो, “तमने सांती जड़े!” <verse eid="JHN 20:19" /><verse number="20" style="v" sid="JHN 20:20" />आहयु कीदीन ईसु आह़फा ना हाते ना घावु, अने आह़फा ना कुखे ना घाव देखाड़्‌यो: ता तीना चेला, मालीक ईसु ने देखीन खुस हय ज्‌या। <verse eid="JHN 20:20" /><verse number="21" style="v" sid="JHN 20:21" />एतरे ईसु तीमने अळी केदो, “तमु सांती सी रेवो! जीसम भगवान बाह मने मोकल्‌लो से, तेमेत मे बी तमने मोकलु।” <verse eid="JHN 20:21" /><verse number="22" style="v" sid="JHN 20:22" />आहयु कीदीन ईसु तीमनी पोर फुक्‌यो अने तीमने केदो, “लेवो, आहयी चोखली आत्‌मा तमारा जीव मे आवरी लेवो।” <verse eid="JHN 20:22" /><verse number="23" style="v" sid="JHN 20:23" /><note caller="+" style="x"><char style="xo" closed="false">20:23 </char><char style="xt" closed="false"><ref loc="MAT 16:19">मत्‌ती 16:19</ref>; <ref loc="MAT 18:18">18:18</ref></char></note>तमु जे माणहु ने पाप नी माफी आपहु, तीहया माणहु ने पाप नी माफी जड़ जहे, अने जे माणहु ने तमु पाप नी माफी नी आपो, तीहया माणहु ने पाप नी माफी नी जड़े।<verse eid="JHN 20:23" /></para>
  <para style="s">पासो जीवतो हयलो ईसु थोमास ने देखावा पड़े</para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 20:24" />जत्‌यार ईसु चेलान्‌तां आयो, ता थोमस तीमनी भेळतो नी हतो, तीहयो बी बारे चेला मे नो एक हतो, आहयो दीदुमस नीता जोवळ्‌यो बी केवायतो हतो। <verse eid="JHN 20:24" /><verse number="25" style="v" sid="JHN 20:25" />बीजा चेला तीने केदा, “आमु मालीक ईसु ने देखला से।” ता तीहयो केदो, “जत्‌यार लग मे तीना हात मे खुटा ना घाव नी देख लेम, अने खुटा ना लारे पड़ला घाव मे, मारी आंगळी नी घाल देम, अने तीना कोख मे पड़ला घाव मे मारो हात नी घाल देम, तां लग मे भरहो नी करु।”<verse eid="JHN 20:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JHN 20:26" />आंठ दाड़ा वीत ज्‌या अने अळतेण ईसु ना अळी चेला घोर मे हता, अने थोमस बी तीमनी ह़ाते हतो। तीहयी टेमे घोर नु झापलु देदलु हतु। ते बी ईसु तीमनी वच मे आवीन उबो हय ज्‌यो, अने केदो, “तमु ह़ुकना रेवो!” <verse eid="JHN 20:26" /><verse number="27" style="v" sid="JHN 20:27" />ता ईसु थोमस ने आह़फा ना हात देखाड़ीन केदो, “तारी आंगळी आहया हात ना घाव मे घाल, अने तारो हात ओरो कर, अने मारा कोख मे वाळा घाव मे तारो हात घाल। अने वण-भरह्‌यो ना बणे, पण मार पोर भरहो कर।”<verse eid="JHN 20:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="JHN 20:28" />थोमस ईसु ने जपाप आप्‌यो, “ए मारा मालीक! ए मारा भगवान!”<verse eid="JHN 20:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JHN 20:29" />ता ईसु थोमास ने केदो, “तु ते मने देखीन मार पोर भरहो करलो से। जुगाळा से तीहया, जे मने देख्‌या वगर मार पोर भरहो करे।”<verse eid="JHN 20:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JHN 20:30" />ईसु आह़फा ना चेला अगळ अळी रेट जुदा-कामु ना सेलाण्‌या देखाड़्‌यो, पण तीहयी जुदा-काम नी सेलाणी ना बारा मे आहया कीताप मे लीखलु नी हय।<verse eid="JHN 20:30" /></para>
  <para style="s">आहयी कीताप नो मकसत</para>
  <para style="p">
    <verse number="31" style="v" sid="JHN 20:31" />पण आहयी वात आञे आनीन करते लीखली से, के तमु आहयो भरहो करो के ईसुत भगवान नो बेटो मसी से, अने तीनी पोर भरहो करीन तीना नाम ना लारे अमर जीवाय हात करो तेम।<verse eid="JHN 20:31" /></para>
  <chapter eid="JHN 20" />
  <chapter number="21" style="c" sid="JHN 21" />
  <para style="s">ईसु चेला अगळ उजन्‌तो हये</para>
  <para style="p">
    <verse number="1" style="v" sid="JHN 21:1" />तीबर्‌या दर्‌या धेड़े ईसु अळी आह़फा ना चेला अगळ आहयी रीते उजन्‌तो देखाव पड़्‌यो। <verse eid="JHN 21:1" /><verse number="2" style="v" sid="JHN 21:2" />एक दाड़े, सीमोन पतरस, थोमस, जे दीदुमस बी केवायतो हतो, नतनेल, जे गलील ना काना ह़ेर नो हतो, अने जब्‌दी ना बे बेटा अने ईसु ना बे बीजा चेला आहया आखा भेळात हता। <verse eid="JHN 21:2" /><verse number="3" style="v" sid="JHN 21:3" /><note caller="+" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="LUK 5:5">लुका 5:5</ref></char></note>सीमोन पतरस, तीमने केदो, “मे ते माछला मारवा जाम।” अने तीहया पतरस ने केदा, “आमु बी तारी ह़ाते आवये।” अने तीहया तीनी ह़ाते चाल पड़्‌या, अने ढुंड्‌या मे चड़ीन बह ज्‌या, पण तीहयी राते तीमने एक बी माछली नी मरी। <verse eid="JHN 21:3" /><verse number="4" style="v" sid="JHN 21:4" />ह़वारे हयतेत ईसु दर्‌या नी धेड़े आवीन उबो री ज्‌यो; बाखीन चेला ईसु ने नी ओळख्‌या। <verse eid="JHN 21:4" /><verse number="5" style="v" sid="JHN 21:5" />तत्‌यार ईसु तीहया चेला ने केदो, “ए सोरा! तमने खावा करीन एक बी माछली नी मरी ह़ु?” तीहया चेला जपाप आप्‌या, “एक बी नी मरी।”<verse eid="JHN 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JHN 21:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">21:6 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:6">लुका 5:6</ref>
      </char>
    </note>तत्‌यार ईसु तीमने केदो, “ढुंड्‌या नी जमणी धेड़े जाळ नाखो ता तमने माछला मरहे।” तीहया जाळ नाख्‌या अने एतरा माछला आया के तीमने जाळ नी हपकायी।<verse eid="JHN 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JHN 21:7" />ता तीहयो चेलो, जे ईसु नो लाडलो चेलो केवायतो हतो, पतरस ने केदो, “आहयो ते मालीक ईसुत से।” जत्‌यार सीमोन पतरस ह़मळ्‌यो के आहयो मालीक ईसुत से, ता तीहयो अरदो नागरलो हतो करीन फटकु सी केड़ वाळ लेदो, अने ईसु ने भेटवा जवा करीन दर्‌या मे कुद पड़्‌यो। <verse eid="JHN 21:7" /><verse number="8" style="v" sid="JHN 21:8" />पण बीजा चेला, माछला भरायली जाळ ने हापकता जाय्‌न नान्‌ला ढुंड्‌या ने दर्‌या नी धेड़े लाया। काहाके तीहया दर्‌या नी धेड़े गेथा सेटा नी हता, तीहया दर्‌या धेड़े गेथा बेक ह़ोव हात सेटा हता। <verse eid="JHN 21:8" /><verse number="9" style="v" sid="JHN 21:9" />जत्‌यार धेड़े पुग्‌या, ता तीहया कोयला नु आक्‌ठु, अने तीनी पोर माछला मेकला देख्‌या, अने रोट्‌ला देख्‌या। <verse eid="JHN 21:9" /><verse number="10" style="v" sid="JHN 21:10" />ईसु तीमने केदो, जे माछला तमु हमणे मारला से, तीनी मे गेथा थोड़ाक लावो।<verse eid="JHN 21:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="JHN 21:11" />सीमोन पतरस ढुंड्‌या पोर चड़ीन एक ह़ो तीरपन मोट्‌ला माछला सी भरायली जाळ धेड़े हापक्‌यो, अने एतरा माछला हता ते बी जाळ नी फाटी। <verse eid="JHN 21:11" /><verse number="12" style="v" sid="JHN 21:12" />ईसु तीमने केदो, आवो, खाणु खाय लेवो, अने चेला मे गेथा कोयनी बी हीम्‌मत नी आयी, के तीने पुसे, तु कोय से? काहाके तीहया जाणता हता के आहयो मालीक ईसु से। <verse eid="JHN 21:12" /><verse number="13" style="v" sid="JHN 21:13" />ईसु अगो आयो, अने खावा करीन तीहयो तीमने रोट्‌लो आप्‌यो, अने आसमेत माछला बी आप्‌यो।<verse eid="JHN 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JHN 21:14" />मर्‌या-ह़र्‌या मे गेथो पासो जीवतो हय्‌न ईसु तीसरी कावा आह़फा ना चेला अगळ उजन्‌तो देखाव पड़्‌यो।<verse eid="JHN 21:14" /></para>
  <para style="s">ईसु अने पतरस</para>
  <para style="p">
    <verse number="15" style="v" sid="JHN 21:15" />खायलीन नवराय्‌न ईसु, पतरस ने पुछ्‌यो, “ए सीमोन, युहन्‌ना ना बेटा! तु ह़ाचलीनेत आमनी गेथो वदु मने मोंग करे ह़ु?” पतरस ईसु ने केदो, “होव, मालीक! तु जाणे के मे तने मोंग करु, तीहयो तीने केदो, मारा गाडरा ने चार।” <verse eid="JHN 21:15" /><verse number="16" style="v" sid="JHN 21:16" />ईसु बीजी कावा अळी सीमोन पतरस ने केदो, “ए सीमोन, युहन्‌ना ना बेटा! तु ह़ाचली मने मोंग करे ह़ु?” पतरस ईसु ने जपाप आप्‌यो, “होव मालीक! तु जाणे के मे तने मोंग करु।” ईसु पतरस ने केदो, “मारा गाडरा नी गुवाळी कर।” <verse eid="JHN 21:16" /><verse number="17" style="v" sid="JHN 21:17" />ईसु तीसरी कावा पतरस ने केदो, ए सीमोन, युहन्‌ना ना बेटा, तु मने मोंग करे ह़ुं? पतरस उदास हय ज्‌यो, के ईसु तीने तीसरी कावा आसम केदो, तु मने मोंग करे ह़ुं? अने ईसु ने केदो, ए मालीक, तने ते आखु कंय मालम से, तने आहयु बी मालम से के मे तने मोंग करु। ईसु तीने केदो, मारा गाडरा नो ध्‌यान राख। <verse eid="JHN 21:17" /><verse number="18" style="v" sid="JHN 21:18" />मे तने ह़ाची-ह़ाची केम, जत्‌यार तु जुवान हतो, ता तु तीयार हय जतो हतो अने जां जवा लागे, तां फीरतो हतो, पण जत्‌यार तु डायो हयही, ता तारा हात नाम्‌बा करही, अने बीजो तने तीयार करीन जां तने जवा नी लागे तां तने लीजहे। <verse eid="JHN 21:18" /><verse number="19" style="v" sid="JHN 21:19" />ईसु आहयी वात ना लारे आहयु देखाड़्‌यो के पतरस केवी मोत सी भगवान नी बड़ाय करहे, अळी ईसु केदो, मारी पसळ आव।<verse eid="JHN 21:19" /></para>
  <para style="s">ईसु अने तीनो मोंगाळ्‌ळो चेलो</para>
  <para style="p">
    <verse number="20" style="v" sid="JHN 21:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">21:20 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:25">युहन्‌ना 13:25</ref>
      </char>
    </note>पतरस पासो फीरीन ईसु ना तीहया चेला ने पसळ आवत्‌ला देख्‌यो, जीने ईसु मोंग करतो हतो, आहयो तीहयोत हतो, जे ईसु नी छाती भणी वळीन “ए मालीक! तने धराव्‌वा वाळो कोय से?” करीन पुछलो हतो। <verse eid="JHN 21:20" /><verse number="21" style="v" sid="JHN 21:21" />पतरस तीने देखीन ईसु ने पुछ्‌यो, “मालीक! आनी पोर ह़ु वीतवा वाळु से?”<verse eid="JHN 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JHN 21:22" />ईसु केदो, “कदी मने आवते लग हीय्‌यो जीवत्‌लो री जाय, ता तारु ह़ु लेणु-देणु से? तु मारी पसळ चाल्‌या कर।”<verse eid="JHN 21:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="JHN 21:23" />एतरे ईसु पोर भरहो करन्‌या भायु मे आहयी वात फीर ज्‌यी के हीय्‌यो चेलो नी मरे; पण ईसु आसम नी केदो के “हीय्‌यो चेलो नी मरे” पण आसम केदलो के “हीय्‌यो मने पासो आवते लग कदी जीवत्‌लो री जाय, ता आहयी वात मे तारु ह़ु लेणु-देणु से?”<verse eid="JHN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JHN 21:24" />आहयो तीहयोत चेलो से, जे आहयी वात नी गवा देवा करीन आहयी वात लीखलो से, आमु जाणये के आनी गवाय ह़ाची से।<verse eid="JHN 21:24" /></para>
  <para style="s">खत्‌तम हयणु</para>
  <para style="p">
    <verse number="25" style="v" sid="JHN 21:25" />ईसु अळी बी रेट काम कर्‌यो; कदी एकीक करीन तीहया काम ना बारा मे लीखता, ता मे ह़मजु के जे कीताप्‌या लीखायता, ता तीहया कीताप्‌या एतरा जबर हय जता के आहयी कळी मे बी नी ह़माता।<verse eid="JHN 21:25" /></para>
  <chapter eid="JHN 21" />
</usx>