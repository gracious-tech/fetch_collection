<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TI" style="id">- Paliya</book>
  <para style="h">2 तीमुथीयुस</para>
  <para style="toc3">2 तीमुथीयुस</para>
  <para style="toc2">2 तीमुथीयुस</para>
  <para style="toc1">तीमुथीयुस ना नाम पोलुस नी बीजी चीट्‌ठी</para>
  <para style="mt2">तीमुथियुस के नाम पोलुस की दुसरी पत्री</para>
  <para style="mt1">तीमुथीयुस ना नाम पोलुस नी बीजी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">2 तीमुथीयुस नी कीताप नेवताळा पोलुस ना बीजा चेला जुगु बीजी चीट्‌ठी से, 2 तीमुथीयुस नी चीट्‌ठी तीनी मरवा नी टेम ह़ाते आय रेली अने लीखलो। अने तीहयी टेमे पोलुस रोम ह़ेर मे धरायलो हतो <char style="xt"><ref loc="2TI 1:16">1:16</ref> </char>पोलुस अने तीमुथीयुस नी वच मे घण-जबर ह़गाय हती अने तीमुथीयुस ने सोरा ना रुप मे मान्‌तो हतो। <char style="xt"><ref loc="PHP 2:22">फीलीपीयो 2:22</ref></char> <char style="xt"><ref loc="1TI 1:2">1 तीमुथीयुस 1:2</ref>;</char> <char style="xt"><ref loc="2TI 1:18">1:18</ref></char>।</para>
  <para style="ip">आहयी तीहया च्‌यार चीट्‌ठी माय्‌न एक से, जे एक माणेह ने सोड़ीन एक मंडळी ने लीख्‌यो, आहयी तीन चीट्‌ठी एवी से 1 तीमुथीयुस, तीतुस, अने फीलेमोन। 2 तीमुथीयुस मे लीखलु हतु के रोम ह़ेर नी लारे ईसु वाळा माणहु ने वेला पाड़ता हता, तीनो कारण आहयो से के पोलुस तीहयी टेमे जेल मे हतो अने तीमुथीयुस ने दुख झेलवा नो हुकम पोलुस आपतो हतो, तीमुथीयुस झुटा ह़ीकाड़न्‌या ना बारा मे कंय चेतावण्‌या आप्‌यो। <char style="xt"><ref loc="1TI 1:16-18">1 तीमुथीयुस 1:16-18</ref></char> आहयु बी तीमुथीयुस केय के तां काठी टेम मे अगळ रेहे। <char style="xt"><ref loc="2TI 3:1">3:1</ref></char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पोलुस तीमुथीयुस ने वारलो से के केय अने हीम्‌मत आपे। <char style="ior"><ref loc="2TI 1:1-18">1:1-18</ref></char></para>
  <para style="io1">2. तीहयो तीमुथीयुस ने दुख वेठवा नी चेतावणी आपे। <char style="ior"><ref loc="2TI 2:1-13">2:1-13</ref></char></para>
  <para style="io1">3. अगो तीहयो तीने सरल हुकम आपे। <char style="ior"><ref loc="2TI 2:14-26">2:14-26</ref></char></para>
  <para style="io1">4. अळी तीहयो तीने अगी हयवा वाळी घटना ने वारु रीती सी ह़मजवा ना बारा मे चेतावणी आपे। <char style="ior"><ref loc="2TI 3:1-4:8">3:1–4:8</ref></char></para>
  <para style="io1">5. पोलुस तीमुथीयुस ना बारा मे थोड़ीक वात कीन खत्‌तम करे। <char style="ior"><ref loc="2TI 4:9-22">4:9-22</ref></char></para>
  <chapter number="1" style="c" sid="2TI 1" />
  <para style="s">तीमुथीयुस जुगु पोलुस नी बीजी चीट्‌ठी</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 1:1" />पोलुस भणी गेथी जे तीहयी जीवाय ना वायदा ना अनसारे जे मालीक ईसु मे से, भगवान नी मरजी सी मसी ईसु नो नेवताळो से।<verse eid="2TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TI 1:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:2 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">नेवताळा ना काम 16:1</ref>
      </char>
    </note>मोंगाळ्‌ळा सोरा तीमुथीयुस ना नामे। भगवान बाह अने मालीक मसी ईसु नी तने दया संयबरकत अने सांती जड़ती रेय।<verse eid="2TI 1:2" /></para>
  <para style="s">झुटा मास्‌तर्‌या ना वीरोद मे चेतावणी</para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 1:3" />जे भगवान नी सेवा मे आपणा डाहा-डाहा नी रीती पोर चोखला मन सी करु, तीहया भगवान ने घणो वारु केम के आपणी वीन्‌ती मे तने रात-दाड़ो तने भेट करवा नी फोम करतो रेम। <verse eid="2TI 1:3" /><verse number="4" style="v" sid="2TI 1:4" />अने तारा आंहवा नी फोम करतो जाय्‌न तने भेटवा नी हेर करु अने घण-जबर खुस हय जाम लागे। <verse eid="2TI 1:4" /><verse number="5" style="v" sid="2TI 1:5" /><note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="ACT 16:1">नेवताळा ना काम 16:1</ref></char></note>तने तारा तीहया वण-गुनाळ्‌ळा भरहा नी फोम आवे। जे तारी डाय्‌ली आय्‌ह लेयीस मे हतो। अने तारी आय्‌ह युनीके मे बी हतो। ह़ाचलीन, हाव आहयोत तारी मे बी से। <verse eid="2TI 1:5" /><verse number="6" style="v" sid="2TI 1:6" />एतरे मे तने फोम करावु, मे तारी पोर हात मेल्‌लो तीहयी टेमे भगवान पांह गेथो तने जे ईलाम जड़लो से, तीने पासो उजन्‌तो कर दे। <verse eid="2TI 1:6" /><verse number="7" style="v" sid="2TI 1:7" />काहाके भगवान आपणु ने बीक नी आत्‌मा नी, पण ताखत, अने मोंग, अने गम नी आत्‌मा आपलो से।<verse eid="2TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 1:8" />एतरे आपणा मालीक नी गवाय सी, अने मे कुंडाय र्‌यो, करीन ना लजवाये, पण भगवान ना जोर ना अनसारे खुस-खबर नी लेदे मारी ह़ाते दुख झेल। <verse eid="2TI 1:8" /><verse number="9" style="v" sid="2TI 1:9" />जे अमारो छुटकारो कर्‌यो, अने चोखला बोलाव्‌वा सी बोलायो, अने आपणा काम नी अनसारे नी, पण आह़फा नी मरजी अने दया नी अनसारे से मसी ईसु मे कळ घड़ायवा नी पेले गेथीत अमारी पोर हयो। <verse eid="2TI 1:9" /><verse number="10" style="v" sid="2TI 1:10" />अने हाव आपणु ने सोड़ाव्‌वा वाळा ईसु मसी ने उजन्‌तो हयवा नी लारे वीजाळा मे हयो, जे मोत ने खत्‌तम कर्‌यो, अने जीवाय अने अमरकाय ने तीहयी खुस-खबर नी लारे उजन्‌ती कर देदलो से।<verse eid="2TI 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TI 1:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:11 </char>
      <char style="xt" closed="false">
        <ref loc="1TI 2:7">1 तीमुथीयुस 2:7</ref>
      </char>
    </note>जीनी जुगु मे परच्‌यार करन्‌यो, नेवताळो, अने ह़ीकाड़वा वाळो बण्‌यो। <verse eid="2TI 1:11" /><verse number="12" style="v" sid="2TI 1:12" />आनीन करीन मे आहया दुख ने बी वेठतो आय र्‌यो, अने नी लजवातो, काहाके मे जीनी पोर भरहो करु, तीने जाणु, अने मने पक्‌कु मालम से, के तीहयो मारा वाटा नी तीहया दाड़े लग रखवाळी करहे, <verse eid="2TI 1:12" /><verse number="13" style="v" sid="2TI 1:13" />जे खरली वात तु मारी लारे ह़मळलो से, तीमने तीहया भरहा अने मोंग नी ह़ाते जे ईसु मसी मे दाखलो बणावीन राख। <verse eid="2TI 1:13" /><verse number="14" style="v" sid="2TI 1:14" />जे चोखली आत्‌मा आपणी मे रेय, तीहयी चोखली आत्‌मा नी मदत सी, वारली ह़ीकापण ने वारलु खजानु ह़मजीन आनी रखवाळी कर।<verse eid="2TI 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="2TI 1:15" />तने ते मालम से के आसीया देस वाळा, आखा मारी ह़ात-ह़ंगात सोड़ देदा; अने फुगीलुस अने हीरमुगीनेस बी जत र्‌या। <verse eid="2TI 1:15" /><verse number="16" style="v" sid="2TI 1:16" />उनेसीफुरुस ना घोरल्‌या पोर मालीक दया करे, काहाके तीहयो काय केतरी कावा मारा जीव ने ठंडो कर्‌यो, अने मे जेल मे से करीन नी लजवायो। <verse eid="2TI 1:16" /><verse number="17" style="v" sid="2TI 1:17" />पण जत्‌यार तीहयो रोम ह़ेर मे आयो, ता तीहयो मने भेटवा करीन काळ्‌जी करीन ह़ोद्‌यो अने भेट्‌यो। <verse eid="2TI 1:17" /><verse number="18" style="v" sid="2TI 1:18" />मालीक करे, के तीहया दाड़े तीनी पोर मालीक नी दया हये। अने जे-जे सेवा तीहयो ईफीसुस ह़ेर मे करलो से तीमने बी तु वारु रीती सी जाणे।<verse eid="2TI 1:18" /></para>
  <chapter eid="2TI 1" />
  <chapter number="2" style="c" sid="2TI 2" />
  <para style="s">ईसु मसी नो ईमानदार चाकर्‌यो</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 2:1" />एतरे ए मारा बेटा तीमुथीयुस, तीहयी दया सी जे मालीक ईसु मे से, टणको हय जा। <verse eid="2TI 2:1" /><verse number="2" style="v" sid="2TI 2:2" />अने तु मारी पांह गेथी जे-जे वात, ढेरेत गवा देण्‌या अगळ ह़मळीन ह़ीकलो, तीहयी आखी वात ईमानदार माणहु ने ह़ोप देदो, जे बीजा माणहु ने ह़ीकाड़वा मे हुनर वाळा से।<verse eid="2TI 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TI 2:3" />एक वारलु सीपायड़ुन तेम, तु बी ईसु मसी जुगु दुख झेलवा मे मारो साजल्‌यो बण। <verse eid="2TI 2:3" /><verse number="4" style="v" sid="2TI 2:4" />जत्‌यार कानु बी सीपायड़ु झुमायवा करीन जाय, ता तीहयो जे तीने भरती करे, तीने खुस करवा करीन आह़फा ने आहया कळी ना कामु मे नी फसाड़े। <verse eid="2TI 2:4" /><verse number="5" style="v" sid="2TI 2:5" />पण जे खेल मे जखड़ी पड़े, अने कायदा नी रीते नी जखड़ी पड़े, ता तीने ईलाम नी जड़े। <verse eid="2TI 2:5" /><verse number="6" style="v" sid="2TI 2:6" />जे कीरसाण काठी मेहनत करे, तीनेत फोळ नो पेल्‌नो वाटो जड़वा जोवे। <verse eid="2TI 2:6" /><verse number="7" style="v" sid="2TI 2:7" />जे मे केम तीनी पोर धीयान दे, अने मालीक तने आहयी आखी वात मे ह़मज आपहे।<verse eid="2TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2TI 2:8" />ईसु मसी ने फोम राखतो रे, जे दावुद राजा ना घोराणा मे पयदा हयो, अने मर्‌या-ह़र्‌या मे गेथो पासो जीवतो हय ज्‌यो। अने आहयु मारी खुस-खबर नी अनसारे से। <verse eid="2TI 2:8" /><verse number="9" style="v" sid="2TI 2:9" />जीनी करते मे दुख झेलु; आञे तक के, एक गुनो करन्‌यान तेम जेल मे कुंडाय बी र्‌यो। पण भगवान नो बोल बंदायलो नी हय। <verse eid="2TI 2:9" /><verse number="10" style="v" sid="2TI 2:10" />मे ते भगवान ना टाळला आखा माणहु नी करते आखा दुख वेठ लेम, के तीहया बी तीहया छुटकारा ने जे मसी ईसु मे से अमरकाय बड़ाय भेळ हात करे। <verse eid="2TI 2:10" /><verse number="11" style="v" sid="2TI 2:11" />आहयी वात ते ह़ाचली से,</para>
  <para style="q1" vid="2TI 2:11">के कदीम आपणु तीनी ह़ाते मरी बी ज्‌या,</para>
  <para style="q2" vid="2TI 2:11">ता तीनी ह़ाते जीवहु बी।<verse eid="2TI 2:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="2TI 2:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:33">मत्‌ती 10:33</ref>; <ref loc="LUK 12:9">लुका 12:9</ref></char>
    </note>कदीम आपणु गम खाय्‌न दुख झेलहु, ता ह़रग मे</para>
  <para style="q2" vid="2TI 2:12">तीनी ह़ाते राज बी करहु;</para>
  <para style="q1" vid="2TI 2:12">अने कदीम आपणु तीनो नीकारो करहु, ता तीहयो बी</para>
  <para style="q2" vid="2TI 2:12">आपणो नीकारो करहे;<verse eid="2TI 2:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="2TI 2:13" />कदीम आपणु धोको देवा वाळा हय,</para>
  <para style="q2" vid="2TI 2:13">ते बी तीहयो भरहो करे एवोत रेहे,</para>
  <para style="q2" vid="2TI 2:13">काहाके तीहयो आह़फा नो नीकारो नी कर सके।<verse eid="2TI 2:13" /></para>
  <para style="s">वारलो कारीगर</para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 2:14" />आहयी आखी वात फोम करावतो रे, अने आखा ने मालीक अगळ चेतावतो रे, के रीकामी बोलु नी लेदे, जखड़ी नी पड़जो; जीनी सी कंय फायदो नी हये पण ह़मळवा वाळा बगड़ जाय। <verse eid="2TI 2:14" /><verse number="15" style="v" sid="2TI 2:15" />तु आह़फा ने भगवान ने मानवा वाळो अने काम करवा मे सरमायण्‌यो नी रेवा जोवे; अने जे भगवान ना सच्‌चाय ना बोलु वारु रीते काम मे लावे। <verse eid="2TI 2:15" /><verse number="16" style="v" sid="2TI 2:16" />पण वीटळ्‌ळी एवी अने रीकामी वात सी सेटो रे, काहाके एवा माणहु अळी बी भगवान नी भक्‌ती गेथा सेटा हयता जहे, अने बड़ता जहे। <verse eid="2TI 2:16" /><verse number="17" style="v" sid="2TI 2:17" />एवा माणहु नी ह़ीकापण ह़ड़ला घाव ने तेम डील मे बड़ती जहे, जेम हुमीनयुस अने फीलेतुस बी तीमनीत मे ना से। <verse eid="2TI 2:17" /><verse number="18" style="v" sid="2TI 2:18" />जे कोय आहयु केय के मर्‌या-ह़र्‌या मे गेथा पासा जीवता हयवा नु हय जेलु से, ता तीहया भरहा सी भटक जेला से, अने काय केतरा माणहु ना भरहा ने तीतर-बीतर कर देय। <verse eid="2TI 2:18" /><verse number="19" style="v" sid="2TI 2:19" />ते बी भगवान नी पक्‌की नीव वारु जमली रेय, अने तीनी पोर आहयो छाप लाग र्‌यो; के “मालीक आह़फा ना माणहु ने ओळखे” अने “जे कोय मालीक नु नाम लेय, तीहयो वण-धरम सी बचलो रेय।”<verse eid="2TI 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="2TI 2:20" />मोटा माणहु ना घोर मे ह़ोना-चांदी ना एतरात नी, पण लाकड़ा ना अने कादा ना बी रेय; अने काना ठाहरा खास काम ना रेय अने काना कम काम ना रेय। <verse eid="2TI 2:20" /><verse number="21" style="v" sid="2TI 2:21" />कदीम कोय आह़फा ने आमनी सी चोखो करहे, ता तीहयु ईज्‌जत करे एवु अने चोखलु ठाहरु ठेरहे; अने मालीक ना कामे आवहे, अने आखा भला काम नी लेदे तीयार करलु केवायहे। <verse eid="2TI 2:21" /><verse number="22" style="v" sid="2TI 2:22" />जुवानी नी आखी भात-भाती नी गलत वात-वीच्‌यार सी सेटो रे, अने जे चोखला मन सी मालीक नु नाम लेय, तीमनी ह़ाते धरम, अने भरहा, अने मोंग, सांती नी पसळ पड़। <verse eid="2TI 2:22" /><verse number="23" style="v" sid="2TI 2:23" />पण रीकामी अने गलत वात नी जखड़ी गेथो सेटो रे। काहाके तु जाणे के आहयी आखी वात सी झगड़ा पयदा हये। <verse eid="2TI 2:23" /><verse number="24" style="v" sid="2TI 2:24" />मालीक ना चाकर्‌या झगड़ो करन्‌या नी रेवा जोवे, पण आखा पोर दया करीन आखा ह़ाते भोळो, गम राखण्‌यो, अने वारु ह़ीकाड़वा वाळो रेवा जोवे। <verse eid="2TI 2:24" /><verse number="25" style="v" sid="2TI 2:25" />अने वीरोदी माणहु ने मोंग सी ह़ीकाड़वा जोवे, कंय माय्‌न भगवान तीमने बी मन फीराव्‌वा नु मन कर देय, अने तीहया बी सच्‌चाय ने ओळखे। <verse eid="2TI 2:25" /><verse number="26" style="v" sid="2TI 2:26" />अने तत्‌यार तीमनी ह़ान आय जहे, अने भुतड़ा नी फंदा मे गेथा छुट जहे, जे आह़फा नी मरजी पुरी करवा करीन बांदीन राख र्‌यो।<verse eid="2TI 2:26" /></para>
  <chapter eid="2TI 2" />
  <chapter number="3" style="c" sid="2TI 3" />
  <para style="s">आखरी दाड़ा</para>
  <para style="p">
    <verse number="1" style="v" sid="2TI 3:1" />आहयी वात फोम राखजे के आखरी दाड़ा मे काठी टेम आवहे। <verse eid="2TI 3:1" /><verse number="2" style="v" sid="2TI 3:2" />तत्‌यार माणेह, लालच्‌यो, अने ह़ोवकारलो, मोटाय करन्‌यो, अने वाक काडण्‌यो, अने आय्‌ह-बाहा ना हुकम नी मानन्‌यो, एसान भुलवा वाळो, अने वीटळ्‌ळ। <verse eid="2TI 3:2" /><verse number="3" style="v" sid="2TI 3:3" />अने मोंग नी करवा वाळो, अने माफी नी करवा वाळो, अने चुगली करन्‌या, गम नी राखवा वाळा, जे बी भलु से, तीनो वीरोद करन्‌या, <verse eid="2TI 3:3" /><verse number="4" style="v" sid="2TI 3:4" />धोको देण्‌या, हेटाळ्‌ळा, अने आह़फाम नीत बड़ाय करन्‌या बण जहे। अने तीहया भगवान ने पुजण्‌या नी, पण मजा लेवा नी हेर करन्‌या बण जहे। <verse eid="2TI 3:4" /><verse number="5" style="v" sid="2TI 3:5" />तीहया भक्‌ती करवा ना ढोंगड़ा ते करहे, पण तीनी सक्‌ती ने नी माने। एवा माणहु गेथो सेटो रेजे। <verse eid="2TI 3:5" /><verse number="6" style="v" sid="2TI 3:6" />आमनी मे एवा माणहु बी से, जे बीजा ना घोरु मे होगात भराय जाय, अने कमजोर बयरा ने पटाय लेय, जे बयरा पेले गेथात आखी वात मे घणा हयाळ्‌ळा से, अने पाप ना बोजा मे डबायला से। <verse eid="2TI 3:6" /><verse number="7" style="v" sid="2TI 3:7" />अने सदा ह़ीकती ते रेय, पण सच्‌चाय ने कदी ओळखी नी सके। <verse eid="2TI 3:7" /><verse number="8" style="v" sid="2TI 3:8" />जेम यन्‌नेस अने यम्‌ब्‌रेस मुसा नो वीरोद करला हता, तेमेत आहया बी सच्‌चाय नो वीरोद करे; आहया एवा माणहु से, जीमनी अक्‌कल बगड़ी जेली से, अने तीहया भरहा मे काचा से। <verse eid="2TI 3:8" /><verse number="9" style="v" sid="2TI 3:9" />पण हाव तीहया अगा अळी कंय नी कर सके, काहाके तीमनी धोको देण्‌याण रीकामी वात आखा माणहु मे उजन्‌ती हय जेली हती, तेमेत आमनी बी हय जहे।<verse eid="2TI 3:9" /></para>
  <para style="s">आखरी हुकम</para>
  <para style="p">
    <verse number="10" style="v" sid="2TI 3:10" />पण तु ह़ीकापण, चाल-चलण, आह, भरहो, धीरज, मोंग, गम आहयी आखी वात वारु रीते जाणे। <verse eid="2TI 3:10" /><verse number="11" style="v" sid="2TI 3:11" /><note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="ACT 13:14-52">नेवताळा ना काम 13:14-52</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:1-7">नेवताळा ना काम 14:1-7</ref>; </char><char style="xt" closed="false"><ref loc="ACT 14:8-20">नेवताळा ना काम 14:8-20</ref></char></note>अने एवा दुख मे बी जे अंताकीया ह़ेर मे अने ईकुनीयुम ह़ेर मे, अने लुस्‌तरा ह़ेर मे, मार पोर आय पड़ला, अने बीजा दुख मे बी जे मे झेल्‌यो, पण हाव मालीक मने तीहया आखा दुख मे गेथो सोड़ाय लेदो। <verse eid="2TI 3:11" /><verse number="12" style="v" sid="2TI 3:12" />पण जेतरा बी ईसु मसी मे भक्‌ती करता जाय्‌न जीव्‌वा हींडे, तीमने आखा ने दुख झेलवा पड़हे। <verse eid="2TI 3:12" /><verse number="13" style="v" sid="2TI 3:13" />पण खोटला माणहु बीजा ने धोको देता जहे, अने धोको खाता जहे, अने अगा बगड़ता जहे। <verse eid="2TI 3:13" /><verse number="14" style="v" sid="2TI 3:14" />पण तु आहयी आखी वात पोर जे तु ह़ीकलो से, अने पक्‌को भरहो बी करलो से, आहयु जाणीन वातड़ो रे; के तु आने काना माणहु सी ह़ीकलो से। <verse eid="2TI 3:14" /><verse number="15" style="v" sid="2TI 3:15" />तु नान्‌लो हतो तां गेथोत खरली सास्‌तर नी वात ह़ीकतो आय र्‌यो, जे तने ईसु मसी पोर भरहो करवा सी छुटकारो हात करीन अक्‌कल वाळो बणाय देहे। <verse eid="2TI 3:15" /><verse number="16" style="v" sid="2TI 3:16" />आखी खरली सास्‌तर भगवान नी अगवाय सीत लीखली से, अने आहयी खरली सास्‌तर माणहु ने ह़ीकाड़वा, ह़ुदारवा, अने धरम नी ह़ीकापण जुगु फायदा वाळी से। <verse eid="2TI 3:16" /><verse number="17" style="v" sid="2TI 3:17" />काहाके भगवान नी सेवा करन्‌यो माणेह पुरी रीती सी नामह़ाद्‌यो बणे, अने आखा भला काम करवा करीन तीयार हय जाय।<verse eid="2TI 3:17" /></para>
  <chapter eid="2TI 3" />
  <chapter number="4" style="c" sid="2TI 4" />
  <para style="p">
    <verse number="1" style="v" sid="2TI 4:1" />भगवान अने ईसु मसी नी हजरी मे जे जीवत्‌ला अने मरला नो नीयाव करहे अने राजो बणीन राज करवा आवहे, गवा मानीन हुकम आपु। <verse eid="2TI 4:1" /><verse number="2" style="v" sid="2TI 4:2" />के भगवान ना बोल नो तु परच्‌यार करतो रे; टेमे अने कु-टेमे बी तीयार रे। अने आखा भातीन गम सी, अने वडजे अने ह़ीकापण भेळ ह़मजाड़जे। <verse eid="2TI 4:2" /><verse number="3" style="v" sid="2TI 4:3" />काहाके एवी टेम बी आवहे जे टेमे माणहु खरली वात ने नी ह़मळी सके अने तीहया आह़फाम ने फायदो जड़े एवीत वात कान्‌टा सी ह़मळवा करीन आह़फाम नी मरजी नी अनसारे आह़फा जुगु घणा मास्‌तर्‌या ह़ोद लेहे। <verse eid="2TI 4:3" /><verse number="4" style="v" sid="2TI 4:4" />अने आह़फाम ना कान्‌टा सच्‌चाय सी फीरवी लेहे, अने मन घड़्‌या काहण्‌या ने मन लगाड़ीन ह़मळहे। <verse eid="2TI 4:4" /><verse number="5" style="v" sid="2TI 4:5" />पण तु आखी वात मे चेतीन रे, अने खुस-खबर ह़मळाव्‌वा नु काम ने दुख झेलतो आहयु काम पुरु करजे।<verse eid="2TI 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="2TI 4:6" />काहाके हाव मने बादा चड़वा नी टेम आय जेली से, अने मने आहयी जीवाय ने सोड़ीन जवा नी टेम बी आय जेली से। <verse eid="2TI 4:6" /><verse number="7" style="v" sid="2TI 4:7" />मे वारली कुस्‌ती लड़ लेदलो से, मे मारी दवड़ पुरी कर लेदलो से, मे भरहा नी रखवाळी करलो से। <verse eid="2TI 4:7" /><verse number="8" style="v" sid="2TI 4:8" />मारी जीवाय मे अगी नीयाव नी तीहयी पागड़ी मेक मेली, जीने मालीक, जे नीयाव करवा वाळो से, मने तीहया दाड़े आपहे अने मने एतरोत नी, पण तीहया आखा ने बी, जे तीने उजन्‌तो आवहे मोंगाळ्‌ळा माने।<verse eid="2TI 4:8" /></para>
  <para style="s">खुद ने ह़ला</para>
  <para style="p">
    <verse number="9" style="v" sid="2TI 4:9" />ए तीमुथीयुस! मारीन्‌तां छोटोत आव्‌वा नी काळ्‌जी कर। <verse eid="2TI 4:9" /><verse number="10" style="v" sid="2TI 4:10" /><note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्‌यो 4:14</ref>; <ref loc="PHM 1:24">फीलेमोन 1:24</ref>; </char><char style="xt" closed="false"><ref loc="2CO 8:23">2 कुरन्‌थी 8:23</ref>; <ref loc="GAL 2:3">गलातीयो 2:3</ref>; <ref loc="TIT 1:4">तीतुस 1:4</ref></char></note>काहाके देमास आहयी कळी ने मोंगाळ्‌ळी ह़मजीन मने सोड़ीन थीसलुनीकीयो मे जत र्‌यो। अने क्‌रेसकेंस गलातीया देस मे जत र्‌यो, अने तीतुस दलमतीया ह़ेर मे जत र्‌यो। <verse eid="2TI 4:10" /><verse number="11" style="v" sid="2TI 4:11" /><note caller="+" style="x"><char style="xo" closed="false">4:11 </char><char style="xt" closed="false"><ref loc="COL 4:14">कुलुस्‌यो 4:14</ref>; <ref loc="PHM 1:24">फीलेमोन 1:24</ref>; </char><char style="xt" closed="false"><ref loc="ACT 12:12">नेवताळा ना काम 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">कुलुस्‌यो 4:10</ref>; <ref loc="PHM 1:24">फीलेमोन 1:24</ref></char></note>लुको एतरोत मारी ह़ाते से। अने तु मरकुस ने लीन आवती रे, काहाके सेवा ना काम जुगु हीय्‌यो मारो घणो मदत करन्‌यो से। <verse eid="2TI 4:11" /><verse number="12" style="v" sid="2TI 4:12" /><note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 20:4">नेवताळा ना काम 20:4</ref>; <ref loc="EPH 6:21">ईफीसीयो 6:21</ref>,<ref loc="EPH 6:22">22</ref>; <ref loc="COL 4:7">कुलुस्‌यो 4:7</ref>,<ref loc="COL 4:8">8</ref></char></note>तुखीकुस ने मे ईफीसुस ह़ेर मे मोकल्‌लो से। <verse eid="2TI 4:12" /><verse number="13" style="v" sid="2TI 4:13" /><note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="ACT 20:6">नेवताळा ना काम 20:6</ref></char></note>जे कोट मे त्‌रोवास ह़ेर मे करपुस ने तां मेक्‌यावलो से, जत्‌यार तु आवे ता तीने अने कीताप खास करीन चामड़ा ना कागदा ने बी लेतो आवजे। <figure style="fig" alt="Scrolls standing by ink well" file="hk00153c.tif" size="col" copy="Horace Knowles ©" ref="4:13">वारु रीते साय सी उबी लपटली चीट्‌ठी</figure><verse eid="2TI 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2TI 4:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:14 </char>
      <char style="xt" closed="false">
        <ref loc="1TI 1:20">1 तीमुथीयुस 1:20</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ROM 2:6">रोमीयो 2:6</ref>
      </char>
    </note>सीकंदर लुवार मार पोर घण कुहराय करलो से। मालीक तीने तीना कामु ना अनसारे दाड़की आपहे। <verse eid="2TI 4:14" /><verse number="15" style="v" sid="2TI 4:15" />तु बी हीनी सी चेतीन रे, काहाके हीय्‌यो आपणी वात नो घण-जबर वीरोद करलो से।<verse eid="2TI 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TI 4:16" />पेल्‌नी कावा जत्‌यार कोरट-कचवरी मे मने मारी गवा भरवा पड़्‌यु, कोय बी बीजा मारो सात नी देदा, पण आखा मने नाखदीन जत र्‌या। भलु हये, के आमने आहया काम नो लेखो नी देवा पड़े। <verse eid="2TI 4:16" /><verse number="17" style="v" sid="2TI 4:17" />पण मालीक मारी मदत कर्‌यो, अने नाहर ना डाचा<note caller="+" style="f"><char style="fr" closed="false">4:17 </char><char style="ft" closed="false">मोत नी सजा सी बचाड़ लेदो।</char></note> मे गेथो बचाड़्‌यो। अने मने हीम्‌मत आप्‌यो, के मारी लारे भगवान नी खुस-खबर नु परच्‌यार पुरु-पुरु हये, अने आड़जात्‌या माणहु खुस-खबर ने जाणे। <verse eid="2TI 4:17" /><verse number="18" style="v" sid="2TI 4:18" />अने मालीक मने आखी भाती नी कुहराय ना कामु सी बचाड़हे, अने मने छुटकारो आपीन ह़रग ना राज मे पुगाड़ देहे। तीहयात मालीक नी जलम बड़ाय हयती रेय। आमीन।<verse eid="2TI 4:18" /></para>
  <para style="s">चीट्‌ठी नी आखरी वात</para>
  <para style="p">
    <verse number="19" style="v" sid="2TI 4:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">नेवताळा ना काम 18:2</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="2TI 1:16">2 तीमुथीयुस 1:16</ref>,<ref loc="2TI 1:17">17</ref></char>
    </note>पीरीस्‌कीला अने अक्‌वीला, अने उनेसीफुरुस ना घोराणा ने आवही अने आवजो केम। <verse eid="2TI 4:19" /><verse number="20" style="v" sid="2TI 4:20" /><note caller="+" style="x"><char style="xo" closed="false">4:20 </char><char style="xt" closed="false"><ref loc="ACT 19:22">नेवताळा ना काम 19:22</ref>; <ref loc="ROM 16:23">रोमीयो 16:23</ref>; </char><char style="xt" closed="false"><ref loc="ACT 20:4">नेवताळा ना काम 20:4</ref>; <ref loc="ACT 21:29">21:29</ref></char></note>ईरास्‌तुस कुरीन्‌थुस ह़ेर मे री जेलो से, अने तरोफीमुस ने मने मीलेतुस ह़ेर मे मांदलोत रेवा दीन आव्‌वा पड़्‌यु।<verse eid="2TI 4:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="2TI 4:21" />टाड ना दाड़ा आव्‌वान पेले काळ्‌जी करीन आवजे। युबलुस, अने पुंदेस, अने लीनुस अने कलोद्‌या, अने आखा भरहो करन्‌या भाय-बेन्‌या आवही अने आवजे की र्‌या।<verse eid="2TI 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="2TI 4:22" />मालीक तारी आत्‌मा ह़ाते रेय: अने तमने भगवान नी दया जड़ती रेय।<verse eid="2TI 4:22" /></para>
  <chapter eid="2TI 4" />
</usx>