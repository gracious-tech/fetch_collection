<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="COL" style="id">- Paliya</book>
  <para style="h">कुलुस्‌यो</para>
  <para style="toc3">कुलुस्‌यो</para>
  <para style="toc2">कुलुस्‌यो</para>
  <para style="toc1">कुलुस्‌यो ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="mt2">कुलुस्‌यों के नाम पोलुस की पत्री</para>
  <para style="mt1">कुलुस्‌यो ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">कुलुस्‌यो नी चीट्‌ठी नेवताळा पोलुस नी <char style="xt"><ref loc="COL 1:1">1:1</ref></char> लारे मंडळी ने लीखली से। तीहयो आहयी चीट्‌ठी तत्‌यार लीख्‌यो जत्‌यार तीहयो जेल मे हतो, कदीम रोम मे, मसीन पयदा हयवान 60 साल नी आड़े-धेड़े। अळतेण कुलुस्‌यो, ईफीसीयो, अने फीलेमोन आहयी चीट्‌ठी पोलुस जेल मे हतोन लीखलो से। करीन आमने जेल चीट्‌ठी केय।</para>
  <para style="ip">तीहयो आहयी चीट्‌ठी कुलुस्‌यो मे मंडळी ने लीखलो हतो। पोलुस कुलुस्‌यो मे मंडळी तीयार नी कर्‌यो, काहाके तीनी <char style="xt"><ref loc="COL 2:1">2:1</ref></char> मे देखाड़लो से, पण तीनी जुगु थोड़ीक जपापदारी माने। आहयु हय सके के ईपफ्‌रास मंडळी ने बणायो काहाके आहयो कुलुस्‌यो सी हतो। पोलुस कुलुस्‌यो नी मंडळी मे थोड़ीक गलत ह़ीकापण सी जोड़ायलो हतो। तीहयो आना बारा मे चीट्‌ठी लीखवा मे घणो खरचो करलो, हय सके के युहदी मसी माणहु नो एक टोळो र्‌यो हय। जे जुन्‌ला नेम सी युहदी नेम पाळवा करीन बीजा मसी भायु ने मजबुर कर र्‌या हता। खास करीन खतनु। पोलुस खास करीन लीखे के मसी ने भगवान <char style="xt"><ref loc="COL 1:15-20">1:15-20</ref></char> नी लारे मान लेदो के आने सोड़ीन मसी ने सोड़ीन कंय बी नी नीता नी बीजा नी जरवत हय। माणहु नी रीती पोर ह़ीकापण रीकामी से। <char style="xt"><ref loc="COL 2:8">2:8</ref></char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पोलुस कुलुस्‌यो मे मंडळी ने वारला से के कीन चीट्‌ठी सुरु कर्‌यो। <char style="ior"><ref loc="COL 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. अळतेण तीहयो मसी नी बड़ाय ना बारा मे लीखे खास करीन कुलुस्‌यो मे झुटी ह़ीकापण ना जपाप मे। <char style="ior"><ref loc="COL 1:3-3:4">1:3–3:4</ref></char></para>
  <para style="io1">3. पोलुस नी थोड़ाक चीट्‌ठ्‌या मे, तीहया चीट्‌ठी ना अदीकारी ने देखाड़े, जे वारली मसी जीवाय जीव्‌वा करीन थोड़ाक खास हुकम आपे। <char style="ior"><ref loc="COL 3:5-4:6">3:5–4:6</ref></char></para>
  <para style="io1">4. पोलुस बीजी मंडळी मे ज्‌योरे भणवा करीन वारला से के केणु अने हुकम भेळ खत्‌तम करे। <char style="ior"><ref loc="COL 4:7-18">4:7-18</ref></char></para>
  <chapter number="1" style="c" sid="COL 1" />
  <para style="s">वारला से के</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 1:1" />पोलुस भणी गेथी, जे भगवान नी मरजी सी मसी ईसु नो नेवताळो से, अने अमारा भाय तीमुथीयुस भणी गेथी।<verse eid="COL 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="COL 1:2" />कुलुस्‌या मे रेवा वाळा भगवान ना चोखला अने तीहया भरहो करे एवा भायु ने जे मसी मे एक से: अमारा बाह भगवान भणी गेथी दया अने सांती जड़ती रेय।<verse eid="COL 1:2" /></para>
  <para style="s">घण वारु से केवा नी वीन्‌ती</para>
  <para style="p">
    <verse number="3" style="v" sid="COL 1:3" />आमु तमारी जुगु जत्‌यार बी वीन्‌ती करया, ता आपणा मालीक ईसु मसी ना बाह भगवान ने घणो वारु से कीया। <verse eid="COL 1:3" /><verse number="4" style="v" sid="COL 1:4" />काहाके आमु मसी ईसु मे तमारा भरहा अने आखा भगवान ना चोखला माणहु नी लेदे तमारा मोंग ना बारा मे ह़मळला से। <verse eid="COL 1:4" /><verse number="5" style="v" sid="COL 1:5" />जत्‌यार खरली खबर, खुस-खबर, पेली कावा तमारीन्‌तां आयी, ता तमु तीहयी आह ना बारा मे ह़मळला के आहयो आपण्‌यो से, आनीन करते तमारो भरहो अने मोंग तीहयी चीज पोर टेकलो से जीनी तमु हेर करो, जे तमारी जुगु ह़रग मे ह़माळीन मेक मेली। <verse eid="COL 1:5" /><verse number="6" style="v" sid="COL 1:6" />खुस-खबर संयबरकत लाय री अने आखी कळी मे फेल री, तेमेत जेम तमारी वच मे तीहया दाड़े गेथी से; जत्‌यार तमु पेली कावा भगवान नी गीण ना बारा मे ह़मळला हता अने तीनी सी आहयु मालम पड़्‌यु के आहयु ह़ाचली से। <verse eid="COL 1:6" /><verse number="7" style="v" sid="COL 1:7" /><note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 4:12">कुलुस्‌यो 4:12</ref>; <ref loc="PHM 1:23">फीलेमोन 1:23</ref></char></note>भगवान नी दया ने तमु अमारा मोंगाळ्‌ळा साजल्‌या ईपफ्‌रास नी लारे ह़ीकला से,<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 4:12">कुलुस्‌यो 4:12</ref>; <ref loc="PHM 1:23">फीलेमोन 23</ref></char></note> जे अमारी जुगु मसी नो भरहो करे एवो चाकर्‌यो से। <verse eid="COL 1:7" /><verse number="8" style="v" sid="COL 1:8" />तीहयोत तमारा मोंग ने जे आत्‌मा मे से अमारी पोर उजन्‌तो कर्‌यो।<verse eid="COL 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="COL 1:9" />आनीन करते जे दाड़े गेथा आहयु ह़मळला से, आमु बी तमारी जुगु आहयी वीन्‌ती अने रावण्‌या करवा नी सोड़ता के तमु आखी आत्‌मा नी अक्‌कल अने ह़मज भेळ भगवान नी हेर नी मरजी नी ओळखाण मे पुरा-पुरा हय जावो। <verse eid="COL 1:9" /><verse number="10" style="v" sid="COL 1:10" />के तमारी चाल-चलण मालीक ने गमे एवी रेवा जोवे, अने तीहयो आखी भाते खुस रेय, अने तमारी मे आखी भाती ना भलाय ना कामु ना फोळ फाले, अने तमु भगवान नी अक्‌कल मे वदता जावो, <verse eid="COL 1:10" /><verse number="11" style="v" sid="COL 1:11" />तीनी बड़ाय नी सक्‌ती ना अनसारे आखा भाती नी ताखत सी ताखत वाळा हयता जावो, आञे तक के खुस भेळ आखी भाती नी टणकाय अने धीरज देखाड़ सको, <verse eid="COL 1:11" /><verse number="12" style="v" sid="COL 1:12" />अने बाह ने घणो वारु से केता रेवो, जे आमने आनी लायक बणायो के वीजाळु मे चोखला माणहु नी ह़ाते पंगात मे साजल्‌या बणया। <verse eid="COL 1:12" /><verse number="13" style="v" sid="COL 1:13" />तीहयोत आमु ने अंदारलु ना कब्‌जा मे गेथो नीकाळीन आह़फा ना मोंगाळ्‌ळा सोरा ना राज मे मोकल्‌यो, <verse eid="COL 1:13" /><verse number="14" style="v" sid="COL 1:14" /><note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="EPH 1:7">ईफीसीयो 1:7</ref></char></note>जीनी मे आमने छुटकारो मतलब पाप नी माफी जड़ली से।<note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="EPH 1:7">ईफीसीयो 1:7</ref></char></note><verse eid="COL 1:14" /></para>
  <para style="s">मसी ना काम अने माणेह</para>
  <para style="p">
    <verse number="15" style="v" sid="COL 1:15" />तीहयो ते वण-देख्‌या भगवान नो सीको अने आखी कळी मे आखा गेथो पेल्‌नो से। <verse eid="COL 1:15" /><verse number="16" style="v" sid="COL 1:16" />काहाके तीनी लारे आखी चीज बणी, जे ह़रग मे से, अने जे धरती मे से, देखली अने वण-देखली, चाहे राजगादी हय, नीता मालीक हय, नीता मोट्‌लो हक हय, नीता सक्‌ती हय: आखी चीज तीना लारे बणावली हती, अने तीनी जुगु। <verse eid="COL 1:16" /><verse number="17" style="v" sid="COL 1:17" />तीहयो आखी चीज गेथो पेल्‌नो से, अने आखी चीज तीनी मे बणली रेय। <verse eid="COL 1:17" /><verse number="18" style="v" sid="COL 1:18" /><note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="EPH 1:22">ईफीसीयो 1:22</ref>,<ref loc="EPH 1:23">23</ref></char></note>तीहयोत डील, मतलब मंडळी नु मुंडु से; तीहयोत पेल्‌नो से, अने मरला मे गेथो जीव उठवा वाळा मे गेथो बी पेल्‌नो से के तीहयोत आखा मे डायलो ठेरे।<note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="EPH 1:22">ईफीसीयो 1:22</ref>,<ref loc="EPH 1:23">23</ref></char></note> <verse eid="COL 1:18" /><verse number="19" style="v" sid="COL 1:19" />काहाके बाह नी खुसी आनीत मे से के तीनी मे भगवान नु आखु कंय रेय <verse eid="COL 1:19" /><verse number="20" style="v" sid="COL 1:20" /><note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="EPH 2:16">ईफीसीयो 2:16</ref></char></note>अने तीना कुरुस पोर वयला लोय नी लारे मेळ करीन, आखी चीज नु तीनीत लारे आह़फा ह़ाते मेळ कर लेय, भले तीहयी धरती पोर नी रेय, भले ह़रग मे नी रेय।<note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="EPH 2:16">ईफीसीयो 2:16</ref></char></note><verse eid="COL 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 1:21" />तमु जे पेले नीका‌ळ्‌ला हता अने गलत कामु ना कारण सी तमारा मन मे भगवान ना वेरी हता; <verse eid="COL 1:21" /><verse number="22" style="v" sid="COL 1:22" />तीहयो हाव तीना आहयी कळी ना आह़फा ना सोरा ना डील मे मोत नी लारे तमारो बी मेळ कर लेदलो से के तमने तीहयो भगवान नी अगळ वण-गुनाळ्‌ळा अने पाप वगर ना बणावीन हजुर करे, <verse eid="COL 1:22" /><verse number="23" style="v" sid="COL 1:23" />कदीम तमु भरहा नी नीव पोर वातड़ा बणीन रेवो अने तीहयी खुस-खबर नी आह ने जीने तमु ह़मळला से नी सोड़ो, जीनो परच्‌यार वादळा नी तळे वाळी पुरी धरती पोर कर्‌या, अने जीनो मे, पोलुस, चाकर्‌यो बण्‌यो।<verse eid="COL 1:23" /></para>
  <para style="s">मंडळी नो चाकर्‌यो पोलुस</para>
  <para style="p">
    <verse number="24" style="v" sid="COL 1:24" />हाव मे तीहयी वेला नी कारण सी खुस हयु, जे तमारी जुगु झेलु अने मसी ना दुख नी कमी तीना डील जुगु, मतलब मंडळी जुगु, आह़फा ना डील मे पुरी करु; <verse eid="COL 1:24" /><verse number="25" style="v" sid="COL 1:25" />जीनो मे भगवान ना तीहया जुगाड़ नी अनसारे चाकर्‌यो बण्‌यो जे तमारी जुगु मने ह़ोपलु से, के मे भगवान ना बोलु ने पुरा-पुरा परच्‌यार करु। <verse eid="COL 1:25" /><verse number="26" style="v" sid="COL 1:26" />मतलब तीहयी वात सुरुवात नी टेम सी ह़तायली री, पण हाव तीना तीहया भगवान ना चोखला माणहु पोर उजन्‌ती हयी। <verse eid="COL 1:26" /><verse number="27" style="v" sid="COL 1:27" />जीमनी पोर भगवान उजन्‌तो करवा हींड्‌यो के तीमने मालम हये के आड़जात्‌या मे तीहयी ह़तायली वात नी बड़ाय नी कीमत ह़ु से अने तीहयी आहयी से के मसी जे बड़ाय नी आह से तमारी मे रेय। <verse eid="COL 1:27" /><verse number="28" style="v" sid="COL 1:28" />जीनो परच्‌यार करीन आमु एक-एक माणेह ने चेतावणी आपया अने आखी अक्‌कल सी एक-एक माणेह ने ह़ीकाड़या, के आमु एक-एक माणेह ने मसी मे नामह़ाद्‌यो करीन भगवान अगळ हजुर करया। <verse eid="COL 1:28" /><verse number="29" style="v" sid="COL 1:29" />तीनीत जुगु मे तीनी तीहयी सक्‌ती नी अनसारे जे मारी मे ताखत भेळ बदलाव नाखे तन-मन लगाड़ीन मेहनत बी करु।<verse eid="COL 1:29" /></para>
  <chapter eid="COL 1" />
  <chapter number="2" style="c" sid="COL 2" />
  <para style="p">
    <verse number="1" style="v" sid="COL 2:1" />मारु मन से के तमु जाण लेवो, के तमारी अने तीमनी जे लोदीकीया मे से, अने तीहया आखा जुगु जे मारो आहयी कळी मे नु मोडु नी देख्‌या मे केवी मेहनत करु। <verse eid="COL 2:1" /><verse number="2" style="v" sid="COL 2:2" />के तीमना मन मे सांती रेय अने तीहया मोंग सी एक-बीजा हेळ-मेळीन रेय, अने तीहया पुरी ह़मज नु आखु धन हात करे, अने भगवान बाह नी ह़तायली वात मतलब मसी ने ओळखी लेय। <verse eid="COL 2:2" /><verse number="3" style="v" sid="COL 2:3" />जीनी मे अक्‌कल अने ह़ीकापण ना आखा खजानु<note caller="+" style="f"><char style="fr" closed="false">2:3 </char><char style="ft" closed="false">नीता धन</char></note> ह़तायला से।<verse eid="COL 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="COL 2:4" />आहयु मे आनीन करते केम के कोय माणेह तमने लालच्‌याण वात सी भटकाड़वा नी जोवे। <verse eid="COL 2:4" /><verse number="5" style="v" sid="COL 2:5" />मे डील ना मान सी तमारी गेथो सेटो से, ते बी आत्‌मा ना मान सी तमारी ह़ाते से, अने तमारा कायदा नी अनसारे वेहवार अने तमारा भरहा नी जे मसी मे से टणकाय देखीन खुस हयु।<verse eid="COL 2:5" /></para>
  <para style="s">मसी मे बणीन रेवो</para>
  <para style="p">
    <verse number="6" style="v" sid="COL 2:6" />तमु जेम मसी ईसु ने मालीक करीन मान लेदला से, तेमेत तीनी मे बणीन रेवो, <verse eid="COL 2:6" /><verse number="7" style="v" sid="COL 2:7" />अने तीनीत मे मुळ्‌यान तेम वातड़ा हयता अने बड़ता जावो; अने जेम तमने ह़ीकाड़ला से तेमेत भरहा मे वातड़ा हयता जावो, अने घण-जबर घणो वारु से केता रेवो।<verse eid="COL 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 2:8" />चेतीन रेवो के कोय तमने तीहयी माणहु नी अक्‌कल सी अने रीकामा धोका नी लारे आह़फा ना हक मे नी कर लेय, जे माणहु नी रीती अने कळी नी सुरु वाळी ह़ीकापण नी अनसारे से, पण मसी नी अनसारे नी। <verse eid="COL 2:8" /><verse number="9" style="v" sid="COL 2:9" />काहाके तीनी मे देवता नु आखु कंय जलम रेत्‌लु। <verse eid="COL 2:9" /><verse number="10" style="v" sid="COL 2:10" />अने तमु तीनीत मे पुरान-पुरा हय जेला से जे आखा सी डायलो अने हक नो डायलो से।<verse eid="COL 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="COL 2:11" />तीनीत मे तमारु एवु खतनु हयलु से जे हात सी नी हये, पण मसी ना हात नु करलु से, जीनी सी आहयी कळी नु पापी डील उतार देय। <verse eid="COL 2:11" /><verse number="12" style="v" sid="COL 2:12" /><note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ROM 6:4">रोमीयो 6:4</ref></char></note>अने जत्‌यार तमु बपतीस्‌मा लेदा ता मसी ह़ाते गड़ाय ज्‌या, अने तीनीत मे भगवान नी ताखत पोर भरहो करीन, जे तीने मरला मे गेथो जीवाड़्‌यो, तीनीत ह़ाते जीव बी उठ्‌या।<note caller="+" style="x"><char style="xo" closed="false">2:12 </char><char style="xt" closed="false"><ref loc="ROM 6:4">रोमीयो 6:4</ref></char></note> <verse eid="COL 2:12" /><verse number="13" style="v" sid="COL 2:13" /><note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EPH 2:1-5">ईफीसीयो 2:1-5</ref></char></note>तीहयो तमने बी, जे आह़फा ना गुना, अने आह़फा ना डील ना बीना खतना वाळा हाल मे मरला हता, तीनी ह़ाते जीवाड़्‌यो, अने अमारा आखा गुना ने माफ कर्‌यो,<note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="EPH 2:1-5">ईफीसीयो 2:1-5</ref></char></note> <verse eid="COL 2:13" /><verse number="14" style="v" sid="COL 2:14" /><note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="EPH 2:15">ईफीसीयो 2:15</ref></char></note>तीहयो आमने गुनाळ्‌ळा ठेराव्‌वा वाळा कीताप्‌या ने खत्‌तम कर देदो, जे नेम-कायदा ना कारण सी अमारा वीरोद मे हता, अने तीहयो कुरुस पोर खुटा ठोकाड़ीन आखु मीटाड़ देदो। <verse eid="COL 2:14" /><verse number="15" style="v" sid="COL 2:15" />अने तीहयो मुख्‌या ने अने अदीकार्‌या ने उपर गेथा उतारीन तीमनो उजन्‌तो तमासो बणायो अने कुरुस ना कारण तीमनी पोर जय-जयकार नी अवाज ह़मळाया।<verse eid="COL 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="COL 2:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:16 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 14:1-6">रोमीयो 14:1-6</ref>
      </char>
    </note>करीन खावा-पीवा नीता तीवार नीता नवलो चांद नीता अराम ना बारा मे तमारो कोय बी फेसलो नी करवा जोवे।<note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="ROM 14:1-6">रोमीयो 14:1-6</ref></char></note> <verse eid="COL 2:16" /><verse number="17" style="v" sid="COL 2:17" />काहाके आहयु आखु आव्‌वा वाळी वात नो साहळो से, पण आहयी आखी<note caller="+" style="f"><char style="fr" closed="false">2:17 </char><char style="ft" closed="false">डील</char></note> चीज मसी मे से। <verse eid="COL 2:17" /><verse number="18" style="v" sid="COL 2:18" />कानु बी माणेह तमने ह़रगदुत नी पुंजा करीन तमने दवड़ ना ईलाम सी सेटो नी कर देय। एवु माणहे देखली वातु मे लाग रेय अने आह़फा नी आहयी कळी नी रीती नी ह़मज सी मोटाय करे। <verse eid="COL 2:18" /><verse number="19" style="v" sid="COL 2:19" /><note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="EPH 4:16">ईफीसीयो 4:16</ref></char></note>अने तीहया मुख्‌या ने धरीन नी राखे जीनी सी आखु डील जोड़ अने नेहटा नी लारे पळाय पोहाय्‌न अने एकठा हय्‌न, भगवान भणी गेथी बड़ती जाय।<verse eid="COL 2:19" /></para>
  <para style="s">मसी ह़ाते मरनु अने जीवणु</para>
  <para style="p">
    <verse number="20" style="v" sid="COL 2:20" />काहाके तमु मसी नी ह़ाते मर जेला से, अने तमने कळी नी सुरु नी ह़ीकापण सी छुटकारो जड़ जेलो से, ता अळतेण काहा तीमनीन तेम जे कळी ना से जीवाय जीव र्‌या? अने एवा कायदा ना हक मे ह़ुका री र्‌या? <verse eid="COL 2:20" /><verse number="21" style="v" sid="COL 2:21" />के “आहयु नी छीमजो तीने नी चाखजो अने तीने हात नी लगाड़जो?” <verse eid="COL 2:21" /><verse number="22" style="v" sid="COL 2:22" />आहयी आखी चीज कामे लावता-लावता खत्‌तम हय जहे काहाके आहयु माणहु ना हुकम अने ह़ीकापण नी अनसारे से। <verse eid="COL 2:22" /><verse number="23" style="v" sid="COL 2:23" />आहया कायदा मे आह़फा नी मरजी नी अनसारे बणावली भक्‌ती नी रीती, अने भोळाय, अने आहयी कळी नी कोसीत ना भाव सी अक्‌कल नु नाम ते से, पण आहयी कळी नी लालच ने रोकवा मे आमनी सी कंय बी फायदो नी हये।<verse eid="COL 2:23" /></para>
  <chapter eid="COL 2" />
  <chapter number="3" style="c" sid="COL 3" />
  <para style="p">
    <verse number="1" style="v" sid="COL 3:1" />एतरे कदीम तमु मसी नी ह़ाते नवली जीवाय मे जीवाड़ला हय ता ह़रगे नी चीज ना ह़ोदवाळ्‌या रेवो, जा ह़ारीक मसी से, अने भगवान नी जमणी ह़ोड़ बह र्‌यो।<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">भजन सहीता110:1</char></note> <verse eid="COL 3:1" /><verse number="2" style="v" sid="COL 3:2" />धरती पोर वाळी चीज नी, पण ह़रगे वाळी चीज पोर धीयान लगाड़ो। <verse eid="COL 3:2" /><verse number="3" style="v" sid="COL 3:3" />काहाके तमु ते मर ज्‌या, अने तमारी जीवाय मसी नी ह़ाते भगवान मे ह़तायली से। <verse eid="COL 3:3" /><verse number="4" style="v" sid="COL 3:4" />जत्‌यार मसी जे आपणी जीवाय से, उजन्‌तो हयहे, ता तमने बी तीनी ह़ाते बड़ाय भेळ उजन्‌ता करहे।<verse eid="COL 3:4" /></para>
  <para style="s">जुन्‌ली जीवाय अने नवली जीवाय</para>
  <para style="p">
    <verse number="5" style="v" sid="COL 3:5" />एतरे आपणा तीहया डील ना वाटा ने मार नाखो, जे धरती पोर से, मतलब छीनाळु, वीटळ, गलत काम, लालच, गलत वीच्‌यार ने जे मुर्‌ती नी पुजा बराबर से।<note caller="+" style="f"><char style="fr" closed="false">3:5 </char><char style="ft" closed="false">नीता मुर्‌ती पुजा से</char></note> <verse eid="COL 3:5" /><verse number="6" style="v" sid="COL 3:6" />आमनात कारण सी भगवान नी रीह हुकम नी मानवा वाळा पोर आय पड़े। <verse eid="COL 3:6" /><verse number="7" style="v" sid="COL 3:7" />अने तमु बी, आहया गलत कामु मे जीवाय जीवता हता ता आमनात अनसारे चालता हता।<verse eid="COL 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="COL 3:8" />पण हाव तमु बी आहयी आखी वात ने, मतलब रीह, ह़ीगी, वाक काडवा, अने वडवा आहयी आखी वात सोड़ देवो। <verse eid="COL 3:8" /><verse number="9" style="v" sid="COL 3:9" /><note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="EPH 4:22">ईफीसीयो 4:22</ref></char></note>एक-बीजा ने झुट ना मेको, काहाके तमु जुन्‌ला माणहे ने तीनी आदत भेळ नीकाळ देदला से।<note caller="+" style="f"><char style="fr" closed="false">3:9 </char><char style="ft" closed="false">ईफीसीयो 4:22</char></note> <verse eid="COL 3:9" /><verse number="10" style="v" sid="COL 3:10" /><note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="EPH 4:24">ईफीसीयो 4:24</ref></char></note>अने नवलु माणेह ने पेर लेदला से, जे आह़फा ना बणाव्‌वा वाळा ना सीका नी अनसारे अक्‌कल हात करवा करीन नवलु बणतु जतलु।<note caller="+" style="f"><char style="fr" closed="false">3:10 </char><char style="ft" closed="false">उबजणाय कीताप 1:26; ईफीसीयो 4:24</char></note> <verse eid="COL 3:10" /><verse number="11" style="v" sid="COL 3:11" />तीनी मे नी ते आड़जात्‌यो र्‌यो अने नी ते युहदी, नी ते खतना अने वण-खतना, नी ते जंगली, नी ते वण-अकल्‌यो नी ते चाकर्‌यो अने नी ते छुट्‌टो नीस्‌तो मसी आखु से अने आखा मे से।<verse eid="COL 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 3:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:12 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 4:2">ईफीसीयो 4:2</ref>
      </char>
    </note>एतरे भगवान ना टाळलान तेम जे चोखला अने मोंगाळ्‌ळा से, घण-जबर बरकत, अने भलाय, अने दया, अने नीचळा रेवा, अने गम खावा ह़ीको।<note caller="+" style="f"><char style="fr" closed="false">3:12 </char><char style="ft" closed="false">ईफीसीयो 4:2</char></note> <verse eid="COL 3:12" /><verse number="13" style="v" sid="COL 3:13" /><note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="EPH 4:32">ईफीसीयो 4:32</ref></char></note>अने कदीम कोयने कोय पोर गुनो लगाड़वा नो कंय कारण हय, ता एक-बीजा नी वेठ लेवो, अने एक-बीजा नो गुनो माफ करो; जेम मालीक तमारा गुना ने माफ कर्‌यो, तेमेत तमु बी करो।<note caller="+" style="f"><char style="fr" closed="false">3:13 </char><char style="ft" closed="false">ईफीसीयो 4:32</char></note> <verse eid="COL 3:13" /><verse number="14" style="v" sid="COL 3:14" />अने आहयी वात ने सोड़ीन मोंग ने मानो, मोंग आखा ने एक-बीजा सी बांदे अने पुरुन-पुरु करे? <verse eid="COL 3:14" /><verse number="15" style="v" sid="COL 3:15" />मसी नी सांती जीनी जुगु तमने एक डील हय्‌न बोलावला बी से, तमारा मन मे राज करे; अने घणा वारु से केय एवा बणीन रेवो। <verse eid="COL 3:15" /><verse number="16" style="v" sid="COL 3:16" /><note caller="+" style="x"><char style="xo" closed="false">3:16 </char><char style="xt" closed="false"><ref loc="EPH 5:19">ईफीसीयो 5:19</ref>,<ref loc="EPH 5:20">20</ref></char></note>मसी ना बोल ने आह़फा ना मन मे पुरी रीती सी बहवा देवो, अने नामह़ाद्‌याण अक्‌कल भेळ एक-बीजा ने ह़ीकाड़ो अने चेतावो, अने आह़फा-आह़फाम ना मन मे घणो वारु से केता जाय्‌न भगवान जुगु भजन अने बड़ाय नु गीत अने आत्‌मीक गीत गावो। <verse eid="COL 3:16" /><verse number="17" style="v" sid="COL 3:17" />भगवान ना बोल सी नीता काम सी जे कंय बी करो आखु मालीक ईसु नाम सी करो, अने तीनी लारे भगवान बाह ने घणो वारु से केवो।<note caller="+" style="f"><char style="fr" closed="false">3:17 </char><char style="ft" closed="false">ईफीसीयो 5:19,20 </char></note><verse eid="COL 3:17" /></para>
  <para style="s">नवली जीवाय ना घोराणा ना कायदा</para>
  <para style="p">
    <verse number="18" style="v" sid="COL 3:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:18 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">ईफीसीयो 5:22</ref>; <ref loc="1PE 3:1">1 पतरस 3:1</ref></char>
    </note>ए लाड्‌या, जेम मालीक मे वारु से, तेमेत आह़फी-आह़फीम ना लाडा नी ह़ाते रेवो।<note caller="+" style="f"><char style="fr" closed="false">3:18 </char><char style="ft" closed="false">ईफीसीयो 5:22; 1 पतरस 3:1</char></note><verse eid="COL 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="COL 3:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:19 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:25">ईफीसीयो 5:25</ref>; <ref loc="1PE 3:7">1 पतरस 3:7</ref></char>
    </note>ए लाडा, आपणी-आपणी लाडी ह़ाते मोंग राखो, अने तीमनी ह़ाते वातड़ा ना रेवो।<note caller="+" style="f"><char style="fr" closed="false">3:19 </char><char style="ft" closed="false">ईफीसीयो 5:25; 1 पतरस 3:7</char></note><verse eid="COL 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="COL 3:20" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:20 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:1">ईफीसीयो 6:1</ref>
      </char>
    </note>ए सोरा, आखी वात मे आपणा-आपणा आय्‌ह-बाहाम ना हुकम मानो, काहाके मालीक आनीत सी खुस हये।<note caller="+" style="f"><char style="fr" closed="false">3:20 </char><char style="ft" closed="false">ईफीसीयो 6:1</char></note><verse eid="COL 3:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="COL 3:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:21 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:4">ईफीसीयो 6:4</ref>
      </char>
    </note>ए आय्‌ह-बाहा, आपणा-आपणा सोराम ने रीह ना लगाड़ो, आसम नी हय जाय के तीमनो आह टुट जाय।<note caller="+" style="f"><char style="fr" closed="false">3:21 </char><char style="ft" closed="false">ईफीसीयो 6:4</char></note><verse eid="COL 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="COL 3:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:22 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:5-8">ईफीसीयो 6:5-8</ref>
      </char>
    </note>ए चाकर्‌या, जे डील नी अनसारे तमारो मालीक से, आखी वात मे तीमना हुकम मानो, माणहु ने खुस करवा वाळान तेम देखावा करीन नी, पण मन नी सच्‌चाय सी अने भगवान नी बीक सी। <verse eid="COL 3:22" /><verse number="23" style="v" sid="COL 3:23" />जे कंय तमु करो, खरला मन सी अने पुरो जीव अने डील लगाड़ीन करो, आहयु ह़मजीन के माणहु जुगु नी पण मालीक जुगु कर र्‌या। <verse eid="COL 3:23" /><verse number="24" style="v" sid="COL 3:24" />काहाके तमु जाणो के तमने आनी बदले मालीक ने तां गेथु ईलाम ने तेवु चीज जड़हे; तमु मालीक मसी नी सेवा कर र्‌या। <verse eid="COL 3:24" /><verse number="25" style="v" sid="COL 3:25" /><note caller="+" style="x"><char style="xo" closed="false">3:25 </char><char style="xt" closed="false"><ref loc="EPH 6:9">ईफीसीयो 6:9</ref></char></note>काहाके जे गलत करे तीहयो तीना गलत काम नो फोळ हात करहे,<note caller="+" style="f"><char style="fr" closed="false">3:25 </char><char style="ft" closed="false">ईफीसीयो 6:5-8</char></note> काहाके भगवान कोयनो भेद-भाव नी करे।<verse eid="COL 3:25" /></para>
  <chapter eid="COL 3" />
  <chapter number="4" style="c" sid="COL 4" />
  <para style="s">मसी संयबरकत</para>
  <para style="p">
    <verse number="1" style="v" sid="COL 4:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 6:9">ईफीसीयो 6:9</ref>
      </char>
    </note>ए मालक्‌या, आपणा-आपणा चाकर्‌या ह़ाते नीयाव अने वारु-वारु वेहवार करो, आहयु ह़मजीन के ह़रग मे तमारो बी एक मालीक से।<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="ft" closed="false">ईफीसीयो 6:9</char></note><verse eid="COL 4:1" /></para>
  <para style="s">मसी माणहु जुगु ह़ला</para>
  <para style="p">
    <verse number="2" style="v" sid="COL 4:2" />वीन्‌ती करता रेवो, अने घणो वारु से केता जाय्‌न तीनी मे जागता रेवो; <verse eid="COL 4:2" /><verse number="3" style="v" sid="COL 4:3" />अने तीनी ह़ाते-ह़ाते अमारी जुगु बी वीन्‌ती करता रेवो के भगवान अमारी जुगु भगवान ना बोलु ह़मळावा नु एवु झापलु उगड़ देय, के आमु मसी नी ह़तायली वात ने उजन्‌तु कर सकया जीना कारण सी मे जेल मे कुंडाय र्‌यो, <verse eid="COL 4:3" /><verse number="4" style="v" sid="COL 4:4" />वीन्‌ती करो के मे आने आसम वारु रीती सी देखाड़ सकु जेम मने देखाड़वा जोवे।<verse eid="COL 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="COL 4:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:5 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:16">ईफीसीयो 5:16</ref>
      </char>
    </note>टेम ने पुरीन-पुरी वापर करो अने भरहो नी करवा वाळा ह़ाते अक्‌कल सी वेहवार करो।<note caller="+" style="f"><char style="fr" closed="false">4:5 </char><char style="ft" closed="false">ईफीसीयो 5:16</char></note> <verse eid="COL 4:5" /><verse number="6" style="v" sid="COL 4:6" />तमारी वात जलमकी संयबरकत भेळ अने वारु रेय के तमने एक-एक माणहे ने वारु रीते जपाप आपवा अवड़ी जाय।<verse eid="COL 4:6" /></para>
  <para style="s">आखरी काव वारला से के केणु</para>
  <para style="p">
    <verse number="7" style="v" sid="COL 4:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:7 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">नेवताळा ना काम 20:4</ref>; <ref loc="2TI 4:12">2 तीमुथीयुस 4:12</ref>; <ref loc="EPH 6:21">ईफीसीयो 6:21</ref>,<ref loc="EPH 6:22">22</ref></char>
    </note>मोंगाळ्‌ळा भाय अने भरहो करे एवा चाकर्‌या तुखीकुस<note caller="+" style="f"><char style="fr" closed="false">4:7 </char><char style="ft" closed="false">नेवताळा ना काम 20:4; 2 तीमुथीयुस4:12 </char></note>, जे मालीक मे मारो साजल्‌यो से, मारी आखी वात तमने की देहे। <verse eid="COL 4:7" /><verse number="8" style="v" sid="COL 4:8" />तीने मे आनीन करते तमारीन्‌तां मोकल्‌लो से के तमने अमारो हाल मालम हय जाय अने तमारा मन ने सांती आपे। <verse eid="COL 4:8" /><verse number="9" style="v" sid="COL 4:9" /><note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="PHM 1:10-12">फीलेमोन 1:10-12</ref></char></note>तीनी ह़ाते मे उनेसीमुस ने बी मोकल्‌लो से जे भरहो करे एवो अने मोंगाळ्‌ळो भायु अने तमारीत मे नो से; आहया तमने आञे नी आखी वात देखाड़ देहे।<verse eid="COL 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="COL 4:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:10 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">नेवताळा ना काम 19:29</ref>; <ref loc="ACT 27:2">27:2</ref>; <ref loc="PHM 1:24">फीलेमोन 1:24</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ACT 12:12">नेवताळा ना काम 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref></char>
    </note>अरीस्‌तरखुस जे मारी ह़ाते जेल मे से, अने मरकुस ने जे बरनाबास नो भाय लागे जीना बारा मे तमने हुकम आपला हता के कदीम तीहयो तमारीन्‌तां आवे, ता तीनी ह़ाते वारु वेहवार करजो, <verse eid="COL 4:10" /><verse number="11" style="v" sid="COL 4:11" />अने ईसु जीनु बीजु नाम युस्‌तुस से, तमने वारला से के केय। खतना करला माणहु माय्‌न आहयो एतरोत भगवान ना राज जुगु मारो साजल्‌यो अने मारी सांती नो कारण से।<verse eid="COL 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="COL 4:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:12 </char>
      <char style="xt" closed="false">
        <ref loc="COL 1:7">कुलुस्‌यो 1:7</ref>; <ref loc="PHM 1:23">फीलेमोन 1:23</ref></char>
    </note>ईपफ्‌रास, जे तमारी मे नो से अने मसी ईसु नो चाकर्‌यो से, तमने वारला से के केय अने सदा तमारी जुगु वीन्‌ती मे कोसीत करे, के तमु नामह़ाद्‌या हय्‌न पुरा भरहा भेळ भगवान नी मरजी पोर टेकला रेवो। <verse eid="COL 4:12" /><verse number="13" style="v" sid="COL 4:13" />मे तीनो गवा से तीहयो तमारी जुगु अने लोदीकीया अने हीयरापुलीस वाळा जुगु काठी मेहनत करतो रेय। <verse eid="COL 4:13" /><verse number="14" style="v" sid="COL 4:14" /><note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="2TI 4:11">2 तीमुथीयुस 4:11</ref>; <ref loc="PHM 1:24">फीलेमोन 1:24</ref>; </char><char style="xt" closed="false"><ref loc="2TI 4:10">2 तीमुथीयुस 4:10</ref>; <ref loc="PHM 1:24">फीलेमोन 1:24</ref></char></note>मोंगाळ्‌ळो दाक्‌तर लुको अने देमास तमने वारला से के केय।<verse eid="COL 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="COL 4:15" />लोदीकीया ना भायु ने, अने नुमफास अने तीमना घोर नी मंडळी ने अमारी भणी सी वारला से के केजो। <verse eid="COL 4:15" /><verse number="16" style="v" sid="COL 4:16" />जत्‌यार आहयी चीट्‌ठी तमारीन्‌तां भण लेय ता आसम करजो के लोदीकीया नी मंडळी अगळ बी भणे। अने तीहयी चीट्‌ठी जे लोदीकीया मे गेथी आवे तीने तमु बी भणजो। <verse eid="COL 4:16" /><verse number="17" style="v" sid="COL 4:17" /><note caller="+" style="x"><char style="xo" closed="false">4:17 </char><char style="xt" closed="false"><ref loc="PHM 1:2">फीलेमोन 1:2</ref></char></note>अने अरखीपुस ने केजो के जे सेवा मालीक मे तने ह़ोपली से, तीने चेतीन रीन पुरी करजे।<verse eid="COL 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="COL 4:18" />मे पोलुस मारा हात सी लीखीन आवजो अने आवही केम। मे हातकड़्‌या मे से फोम राखजो। तमारी पोर संयबरकत हयती रेय।<verse eid="COL 4:18" /></para>
  <chapter eid="COL 4" />
</usx>