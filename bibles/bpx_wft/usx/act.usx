<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ACT" style="id">- Paliya</book>
  <para style="h">नेवताळा ना काम</para>
  <para style="toc3">नेवताळा ना काम</para>
  <para style="toc2">नेवताळा ना काम</para>
  <para style="toc1">लुका नी लीखली नेवताळा नी कीताप</para>
  <para style="mt2">लुका की लीखी प्रेरितो की कीताप</para>
  <para style="mt1">लुका नी लीखली नेवताळा नी कीताप</para>
  <para style="imt">जानकारी</para>
  <para style="ip">नेवताळा नी कीताप मंडळी नी सुरुवात नी काहणी से, अने यरुसलेम सी युहद्‌या, सामर्‌या, अने तीनी सी अगी लग खोळवायली से, जीसम ईसु आह़फा ना चेला ने ह़रग मे जवा सी पेले देखाड़लो हतो। <char style="xt"><ref loc="ACT 1:8">1:8</ref> </char>आहयी कीताप लुको काना हात सी पुगली से, जे लुको खुस-खबर नी कीताप लीखलो हतो। तीहयो दाक्‌तर हतो, अने एक वारु कीताप बणाव्‌वा नी लेदे घणो चेतीन रेतो जतो। तीहयो आह़फा नी खुस-खबर अने कायदा नी कीताप थीयुफीलुस ने लीखलो हतो, जे एक आड़जात्‌यो हतो, बाखीन आहयी कीताप आखा भरहो करन्‌या नी लेदे बी हती, जीनी मे आड़जात्‌या अने युहदी बेम भेसकायला हता <char style="xt"><ref loc="ACT 1:1">1:1</ref> </char>।</para>
  <para style="ip">आहयी कीताप ईसु मसी ना पयदा हयवान 60-64 साल नी वच मे लीखायली हती काहाके आहयी कीताप पोलुस ना जेल मे गेथो छुटवा सी पेले लीखाय जेली हती। नेवताळा नी कीताप लुका नी खुस-खबर नी कीताप ह़रकी से अने ईसु ना ह़रग मे जवान अळतेण सुरु हये। लीखवा मे लुका नो वीच्‌यार आह़फा नी खुस-खबर नी कीताप ह़रको से। तीहयो थीयुफीलुस हेर करतो हतो, अने ह़ाते-ह़ाते भरहो करन्‌या ना कारण सी वीच्‌यार करतो हतो के तीमने ह़ु ह़ीकाड़्‌यु हहे एतरे तीहयो ईसु नी जीवाय अने भरहो करन्‌या नी खराय ना बारा मे कीताप लीख्‌यो।</para>
  <para style="ip">नेवताळा नी कीताप आपणी लेदे सुरुवात नी मंडळी ना दाखला देखाड़े अने ईसु मे भरहो करीन कीसम जीव्‌वा तीहयु देखाड़े। नेवताळा ना आहया दाखला आमने आहयु देखाड़े के बीजा ने खुस-खबर नी खबर ह़मळाव्‌वा ना लेदे चोखली आत्‌मा पोर भरहो केम करवा जोवे।</para>
  <para style="iot">रुपरेख</para>
  <para style="io1">1. पेले चोखली आत्‌मा चेला पोर आवे अने मंडळी फेलवा लागे। <char style="ior"><ref loc="ACT 1:1-8:1">1:1–8:1</ref> </char></para>
  <para style="io1">2. अळतेण मंडळी ने वेला पाड़े अने खबर यरुसलेम नी बाहर फेलवा लागे। <char style="ior"><ref loc="ACT 8:2-12:23">8:2–12:23</ref> </char></para>
  <para style="io1">3. अळतेण पोलुस आह़फा नी पेली परच्‌यार यात्‌रा पोर जाय। <char style="ior"><ref loc="ACT 12:24-14:28">12:24–14:28</ref></char></para>
  <para style="io1">4. यरुसलेम मे बठक पक्‌की करे के नवला भरहो करन्‌या ने ह़ु जोवे। <char style="ior"><ref loc="ACT 15:1-35">15:1-35</ref></char></para>
  <para style="io1">5. पोलुस आह़फा नी बीजी परच्‌यार यात्‌रा पोर जाय। <char style="ior"><ref loc="ACT 15:36-18:22">15:36–18:22</ref></char></para>
  <para style="io1">6. पोलुस आह़फा नी तीसरी परच्‌यार यात्‌रा पोर जाय। <char style="ior"><ref loc="ACT 18:23-20:38">18:23–20:38</ref></char></para>
  <para style="io1">7. पोलुस यरुसलेम मे धराय ज्‌यो। <char style="ior"><ref loc="ACT 21:1-26:32">21:1–26:32</ref> </char></para>
  <para style="io1">8. आखरी मे पोलुस ने रोम ह़ेर मे ली जाय। <char style="ior"><ref loc="ACT 27:1-28:31">27:1–28:31</ref> </char></para>
  <chapter number="1" style="c" sid="ACT 1" />
  <para style="s">कीताप ना बारा मे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 1:1-4">लुका 1:1-4</ref>
      </char>
    </note>ए थीयुफीलुस! मे मारी पेल्‌नी कीताप तीहया आखा काम ना बारा मे लीखलो से, जे काम ईसु सुरु कर्‌यो अने ह़ीकाड़तो र्‌यो। <verse eid="ACT 1:1" /><verse number="2" style="v" sid="ACT 1:2" />अने जत्‌यार लग तीहयो चोखली आत्‌मा ना लारे आह़फा ना टाळला नेवताळा ने हुकम आप्‌यो अने ह़रगे नी उचलायो, तां लग तीहयो तीमने ह़ीकाड़तो र्‌यो। <verse eid="ACT 1:2" /><verse number="3" style="v" sid="ACT 1:3" />अने ईसु खुद मरवा नी अळतेण नेवताळा ने घणा पाका पुरावा भेळ देखाव पड़्‌यो, के तीहयो जीवत्‌लो से, अने तीहयो चाळीह दाड़ा लग तीमने देखावा पड़तो र्‌यो, अने तीमनी ह़ाते भगवान ना राज ना बारा मे वात करतो र्‌यो। <verse eid="ACT 1:3" /><verse number="4" style="v" sid="ACT 1:4" /><note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="LUK 24:49">लुका 24:49</ref></char></note>अने चेला ह़ाते आय्‌न तीमने हुकम आप्‌यो के “बाह जे वायदो करलो से तीहयो वायदो पुरो हयता लग तमु यरुसलेम ह़ेर मे गेथा नी जजो, अने तमु तीहयो वायदो पुरो हयवा नी वाट जोवता रेजो। मे तमने तीहया वायदा ना बारा मे देखाड़ देदलो से। <verse eid="ACT 1:4" /><verse number="5" style="v" sid="ACT 1:5" /><note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="MAT 3:11">मत्‌ती 3:11</ref>; <ref loc="MRK 1:8">मरकुस 1:8</ref>; <ref loc="LUK 3:16">लुका 3:16</ref>; <ref loc="JHN 1:33">युहन्‌ना 1:33</ref></char></note>युहन्‌नो ते पाणी सी बपतीस्‌मा आपलो से, पण थोड़ाक दाड़ान अळतेण तमु चोखली आत्‌मा सी बपतीस्‌मा लेहु।”<verse eid="ACT 1:5" /></para>
  <para style="s">ईसु नु ह़रगे उचलायणु</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 1:6" />एतरे तीहया ईसुन्‌तां भेळा हय्‌न आहयी वात पुछ्‌या, “ए मालीक! तु आहयी टेमे ईस्‌रायल राज्‌य ने पासु बणावही ह़ु?”<verse eid="ACT 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 1:7" />ईसु जपाप आप्‌यो, “तीहयी टेम अने सीजन ने जाणवा नो हक बाह ना हात मे से, तमारु काम नी हय। <verse eid="ACT 1:7" /><verse number="8" style="v" sid="ACT 1:8" /><note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="MAT 28:19">मत्‌ती 28:19</ref>; <ref loc="MRK 16:15">मरकुस 16:15</ref>; <ref loc="LUK 24:47">लुका 24:47</ref>,<ref loc="LUK 24:48">48</ref></char></note>बाखीन चोखली आत्‌मा तमारी पोर उतरहे, ता तमु सक्‌ती हात करहु; अने यरुसलेम ह़ेर मे आखा युहद्‌या मे, अने सामर्‌या ह़ेर मे अने धरती नी सेल्‌ली काकड़ लग मारा गवा बणहु।” <verse eid="ACT 1:8" /><verse number="9" style="v" sid="ACT 1:9" /><note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MRK 16:19">मरकुस 16:19</ref>; <ref loc="LUK 24:50">लुका 24:50</ref>,<ref loc="LUK 24:51">51</ref></char></note>आहयी वात की देदो अने अळतेण ईसु तीमनी देखणते उपर ह़रग मे उचलाय ज्‌यो, अने वादळु तीने ढाक लेदु।<verse eid="ACT 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 1:10" />तीनी जती वखत चेला ह़रग भणी एकडीट्‌या भाळ रेला हता, तत्‌यार धोळासप लुगड़ा पेर रेला बे अदमड़ा तीनीन्‌तां आवीन उबा हय ज्‌या। <verse eid="ACT 1:10" /><verse number="11" style="v" sid="ACT 1:11" />अने केदा, “ए गलील मे रेण्‌या माणहु! तमु ह़रग भणी काहा भाळ र्‌या? आहयोत ईसु, तमारी वच मे गेथो ह़रग मे उचलाय जेलो से, आहयीत रीते पासो आवहे, जीसम तमु हीने जत्‌लो देखला से।”<verse eid="ACT 1:11" /></para>
  <para style="s">यहुदा ना जागे मत्‌ती ने टाळणु</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 1:12" />ता चेला जेतुन नाम ना बड़ा मे गेथा पासा यरुसलेम आया, आहयो बड़ो यरुसलेम ह़ेर गेथो एक कीलोमीटरेक नाम्‌बे हतो। <verse eid="ACT 1:12" /><verse number="13" style="v" sid="ACT 1:13" /><note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="MAT 10:2-4">मत्‌ती 10:2-4</ref>; <ref loc="MRK 3:16-19">मरकुस 3:16-19</ref>; <ref loc="LUK 6:14-16">लुका 6:14-16</ref></char></note>तां पुगीन तीहया घोर नी बीजी मंजली पोर चड़्‌या, जां तीहया रेता हता। पतरस, युहन्‌नो, याकुब, अंदर्‌यास, फीलीपुस, थोमस, बरतुलमय, मत्‌ती हलफाय नो सोरो याकुब, सीमोन जलोतेस अने याकुब नो सोरो यहुदा। <verse eid="ACT 1:13" /><verse number="14" style="v" sid="ACT 1:14" />तीमनी ह़ाते ढेरेत बयरा अने ईसु नी आय्‌ह मरीयम अने भाय बी हता। आहया आखा एक्‌ठा हय्‌न वीन्‌ती करवा बाज र्‌या हता।<verse eid="ACT 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 1:15" />तां आखा मेळीन एक ह़ोन वीह जणा हता तीहया दाड़े पतरस भाय-बेन्‌या ना वच मे उबो हय्‌न केवा बाज ज्‌यो। <verse eid="ACT 1:15" /><verse number="16" style="v" sid="ACT 1:16" />“ए भाय-बेन्‌या, सास्‌तर मे चोखली आत्‌मा दावुद ना मोडा सी यहुदा ना बारा मे जे पेले गेथी हती केदली तीहयी वात पुरी हयवा जरुड़ी हती। के यहुदा ईसु ने धरवा वाळा नो अगवो बणहे। <verse eid="ACT 1:16" /><verse number="17" style="v" sid="ACT 1:17" />अने तीहयो आपणी मे गणायतो हतो अने ईनी सेवा-चाकरी मे तीनो बी हीस्‌सो हतो।”<verse eid="ACT 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 1:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:18 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:3-8">मत्‌ती 27:3-8</ref>
      </char>
    </note>पण तीहयो पाप-धंदा ना कमायला पय्‌हा सी एक खेतर वेचातु लेदो; अने तीहयो ते खेतर ना झाड़े जाय्‌न टंगाय ज्‌यो, अने मोडान भरहे पड़्‌यो, तीनु पेट फाट ज्‌यु, अने तीना आखा आतड़ा बारा नीकळी आया। <verse eid="ACT 1:18" /><verse number="19" style="v" sid="ACT 1:19" />आहयी वात यरुसलेम ह़ेर मे आखा रेवा वाळा ने पतो हय जी, अने तीहया खेतर नु नाम हकळदमा मतलब लोय नु खेतर पड़ ज्‌यु।<verse eid="ACT 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 1:20" />भजन नी कीताप मे बी आहयु लीखलु से,</para>
  <para style="q1" vid="ACT 1:20">“तीनी जागा उजड़ी जवा जोवे,</para>
  <para style="q2" vid="ACT 1:20">अने तीनी मे रेण्‌या एक बी नी बचवा जोवे।”</para>
  <para style="m" vid="ACT 1:20">अने “तीहया माणेह नी आवजी पोर कोय बीजो रेवा जोवे।”<verse eid="ACT 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 1:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:16">मत्‌ती 3:16</ref>; <ref loc="MRK 1:9">मरकुस 1:9</ref>; <ref loc="LUK 3:21">लुका 3:21</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MRK 16:19">मरकुस 16:19</ref>; <ref loc="LUK 24:51">लुका 24:51</ref></char>
    </note>एतरे तालेत से के जेतरी टेमे लग मालीक ईसु अमारीन्‌तां आवतो-जतो र्‌यो मतलब तीहयो ईसु, युहन्‌नो बपतीस्‌मा आपलो तीहयी टेमे गेथो मरीन जीवतो हय्‌न ह़रगे जता लग अमारी ह़ाते र्‌यो, तीहयी टेमे जे माणहु आपणी ह़ाते र्‌या। <verse eid="ACT 1:21" /><verse number="22" style="v" sid="ACT 1:22" />मतलब युहन्‌ना ना बपतीस्‌मा सी लीन मालीक ना ह़रगे जवा ना दाड़े लग जे माणहु बराबर अमारी ह़ाते हता, तीमनी माय्‌न एक अमारी ह़ाते मालीक नो मर्‌या-ह़र्‌या मे गेथो जीव उठवा नो गवा बणे।<verse eid="ACT 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 1:23" />एतरे तीहया बे अदमी ने ह़ाम्‌बा लाया युसुफ ने, जे बरसबा केवायतो हतो, अने जीनु नामह़ाद्‌यु नाम युसतुस हतु, अने मतीयाह ने। <verse eid="ACT 1:23" /><verse number="24" style="v" sid="ACT 1:24" />ता तीहया भगवान सी आसम वीन्‌ती कर्‌या, “ए मालीक! तु आखा ना मन ने जाणे। आमने आहयु देखाड़, के तु आहया बे जणा मे गेथो कोयने टाळलो से, <verse eid="ACT 1:24" /><verse number="25" style="v" sid="ACT 1:25" />अने तीहयो एक ईसुन नेवताळान रुप मे यहुदा नी आवजी पोर आहयी सेवा-चाकरी नो जागो लेय। जे जागा ने सोड़ीन यहुदो आह़फा ना जागे जत र्‌यो।” <verse eid="ACT 1:25" /><verse number="26" style="v" sid="ACT 1:26" />अने तीहया ते बे जणा ना नाम सी चीट्‌ठी नाख्‌या ता तीहयी चीट्‌ठी मतीयाह ना नाम पोर नीकळी। आसम करीन तीहयो मतीयाह ईसु ना ग्‌यारे नेवताळा मे भेसकाय ज्‌यो।<verse eid="ACT 1:26" /></para>
  <chapter eid="ACT 1" />
  <chapter number="2" style="c" sid="ACT 2" />
  <para style="s">चोखली आत्‌मा नु उतरवु</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 2:1" />जत्‌यार पीन्‌तेकुस्‌त नो तीवार आयो, मतलब तीवार ना दाड़ा ना अळतेण नो पचाहवो दाड़ो, अने ईसु पोर भरहो करन्‌या आखा एक जागे भेळा हता। <verse eid="ACT 2:1" /><verse number="2" style="v" sid="ACT 2:2" />ता उचकाहलु आंजी ना झोकान तेवो अवाज ह़रगे गेथो आयो अने जे घोर मे तीहया बह रेला, तीहयु आखु घोर गुंज उठ्‌यु। <verse eid="ACT 2:2" /><verse number="3" style="v" sid="ACT 2:3" />अने तीमने आक्‌ठु नी आच ने तेवी जीप देखाव पड़ी, अने तीमनी माय्‌न आखा पोर आवीन थांग जी। <verse eid="ACT 2:3" /><verse number="4" style="v" sid="ACT 2:4" />अने तीहया आखा माणहु चोखली आत्‌मा सी भराय ज्‌या, अने तीहया ते भगवान नी आत्‌मान लारे आप्‌ली सक्‌ती सी भात-भातीन बोली बोलवा बाज ज्‌या।<verse eid="ACT 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 2:5" />अने तीहयी टेमे यरुसलेम मे ह़रग ने हेटा धरती ना आखा देसु मे गेथा आय रेण्‌या युहदी-धरम ना भक्‌त माणहु रेता हता। <verse eid="ACT 2:5" /><verse number="6" style="v" sid="ACT 2:6" />अने तीहया ईसु ना नेवताळा ने भात-भातीन बोली बोलत्‌ला ह़मळीन वहराय ज्‌या काहाके तीमनी मे एकीक जणो तीमने तीमनीत बोली मे बोलत्‌ला ह़मळी र्‌या हता। <verse eid="ACT 2:6" /><verse number="7" style="v" sid="ACT 2:7" />तीहया आखान-आखा घण-जबर वीच्‌यार मे पड़ ज्‌या, अने वहराय्‌न केदा, “ह़मळो! आहया बोलवा वाळा आखान-आखा गलील मे रेण्‌या नी हय ह़ु? <verse eid="ACT 2:7" /><verse number="8" style="v" sid="ACT 2:8" />ता आपणी मे नो एकीक जणो ईमने आपणा-आपणा देस नी बोली बोलत्‌ला काहा ह़मळी र्‌या। <verse eid="ACT 2:8" /><verse number="9" style="v" sid="ACT 2:9" />आमु ते पारथी ने, मेदी ने, एलामी ने, मीसुपुताम्‌या मे रेण्‌या से, अने युहद्‌या अने कपदुक्‌या ने, पुंतुस, अने आसीया मे रेण्‌या से। <verse eid="ACT 2:9" /><verse number="10" style="v" sid="ACT 2:10" />अने फुरग्‌या ने, पमफुल्‌या ने, मीसर ने, लीबुवा देस मे रेण्‌या से, जे कुरेन देसु धेड़्‌ये से, आहया आखा देसु मे रेण्‌या अने रोम मे रेण्‌या माणहु से, ईमनी मे ना काना युहदी-धरम वाळा, अने काना युहदी-धरम धरीन नवला चेला बणन्‌या से, अने क्‌रेते मे रेण्‌या, अने अरब देस वाळा बी से। <verse eid="ACT 2:10" /><verse number="11" style="v" sid="ACT 2:11" />मतलब ह़ु युहदी, अने ह़ु युहदी-धरम धरन्‌या आमु आखा आपणी-आपणी बोली मे ईमना मोडे भगवान ना मोट्‌ला काम ने नामलत्‌ला ह़मळवा बाज र्‌या।” <verse eid="ACT 2:11" /><verse number="12" style="v" sid="ACT 2:12" />अने तीहया आखान-आखा वहराय ज्‌या, अने घबराय्‌न एक-बीजा ने केवा बाज ज्‌या, “आहयु आसम काहा हय र्‌यु?”<verse eid="ACT 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 2:13" />पण थोड़ाक बीजा माणहु ह़ाही करता जाय्‌न केदा, “आहया ते ह़रु पीन नस्‌या मे से।”<verse eid="ACT 2:13" /></para>
  <para style="s">पतरस आखा अगळ उजन्‌तो केय</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 2:14" />पतरस ग्‌यारे नेवताळान वच मे उबो हय ज्‌यो, अने मोटेत केदो, ए युहदी माणहु अने यरुसलेम मे रेण्‌या, तमु मारी वात कान्‌टा लगाड़ीन ह़मळो अने आहयु जाण लेवो। <verse eid="ACT 2:14" /><verse number="15" style="v" sid="ACT 2:15" />आहया माणहु नस्‌या मे नी हय, जेम तमु ह़मजी र्‌या। हमणे ते ह़वारे नी नवेत बज री। <verse eid="ACT 2:15" /><verse number="16" style="v" sid="ACT 2:16" />पण आहयी तीहयी वात से, जीना बारा मे भगवान वगे गेथो वात केण्‌यो योयल केदलो हतो:<verse eid="ACT 2:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 2:17" />आहया आखरी दाड़ा ना बारा मे भगवान आहयु केय:</para>
  <para style="q2" vid="ACT 2:17">मे सेला दाड़ा मे आखा माणहुन डील मे मारी चोखली आत्‌मा उतारही।</para>
  <para style="q1" vid="ACT 2:17">अने तमारा बेटा-बेटी भगवान वगे गेथी वात केहे;</para>
  <para style="q2" vid="ACT 2:17">अने तमारा जुवान्‌या मोटा दरसन देखहे,</para>
  <para style="q2" vid="ACT 2:17">अने तमारा डायला माणहु ह़पना मे भगवान ह़ाते वात करहे।<verse eid="ACT 2:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="ACT 2:18" />अने मे तीहया दाड़ा मे मारा पावर्‌या अने पावर्‌याण पोर बी</para>
  <para style="q2" vid="ACT 2:18">मारी चोखली आत्‌मा उतारही,</para>
  <para style="q2" vid="ACT 2:18">अने तीहया बी भगवान वगे गेथी वात केहे।<verse eid="ACT 2:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="ACT 2:19" />मे उपर ह़रग मे सेल-भात्‌या जुदा-काम देखाड़ही,</para>
  <para style="q2" vid="ACT 2:19">अने हेटो धरती पोर सेलाणी देखाड़ही,</para>
  <para style="q2" vid="ACT 2:19">मतलब लोय, आक्‌ठी, अने धुकरा नु वादळु देखाड़ही।<verse eid="ACT 2:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="ACT 2:20" />मालीक ना मोटा भारी अने बड़ाय भर्‌या दाड़ा आव्‌वान</para>
  <para style="q2" vid="ACT 2:20">पेले दाहड़ु अंदारु डुब हय जहे, अने चांद लोय</para>
  <para style="q2" vid="ACT 2:20">ने तेवो रातो हय जहे।<verse eid="ACT 2:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="ACT 2:21" />अने तीहया दाड़ा मे जे कोय मालीक नाम सी वीन्‌ती करहे,</para>
  <para style="q2" vid="ACT 2:21">तीहयो छुटकारो हात करहे।<verse eid="ACT 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 2:22" />ए ईस्‌रायली जाती ना मारा भायु! मारी वात मन लगाड़ीन ह़मळो! तमु आह़फा जाणो के ईसु नासरी ना लारे तमारी अगळ सेल-भात्‌या जुदा-कामु अने वहराड़न्‌या जुदा भारी कामु नी सेलाणी देखाड़लो से। तीनी सी आहयु मालम पड़ जेलु के ईसु, भगवान वगे गेथो मोकल्‌लो हतो। <verse eid="ACT 2:22" /><verse number="23" style="v" sid="ACT 2:23" /><note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="MAT 27:35">मत्‌ती 27:35</ref>; <ref loc="MRK 15:24">मरकुस 15:24</ref>; <ref loc="LUK 23:33">लुका 23:33</ref>; <ref loc="JHN 19:18">युहन्‌ना 19:18</ref></char></note>तीहयो ईसु भगवान नी टाकली मरजीन अनसारे, अने भगवान नी योजना नी अनसारे धरायलो अने तमु कायदो तोड़न्‌या ना हात सी तीने कुरुस पोर खुटा ठोकाड़ीन चड़ाय मांग्‌या अने मराय नाख्‌या। <verse eid="ACT 2:23" /><verse number="24" style="v" sid="ACT 2:24" /><note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 28:5">मत्‌ती 28:5</ref>,<ref loc="MAT 28:6">6</ref>; <ref loc="MRK 16:6">मरकुस 16:6</ref>; <ref loc="LUK 24:5">लुका 24:5</ref></char></note>बाखीन भगवान मोत ना बोंदु सोड़ीन ईसु ने मर्‌या-ह़र्‌या मे गेथो पासो जीवाड़्‌यो। काहाके ईसु मनख्‌यान तेम मोत नी बंदण मे रेय एम नी हतो।<verse eid="ACT 2:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="ACT 2:25" />काहाके ईसु ना बारा मे दावुद आहयु केय,</para>
  <para style="q2" vid="ACT 2:25">मे जलम मालीक भणी भाळ रेम, तीहयो मारी जमणी धेड़े रेय; एतरे मे केवा बी दुख मे लथड़ीन नी पड़ु।<verse eid="ACT 2:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 2:26" />एतरे मारु मन बी घण-जबर खुस रेय।</para>
  <para style="q2" vid="ACT 2:26">अने मारी आत्‌मा बी घण-जबर खुस हयहे,</para>
  <para style="q2" vid="ACT 2:26">अने मारु डील बी आह मे अराम हात करहे।<verse eid="ACT 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 2:27" />काहाके तु मारा जीव ने पताळ मे नी नाखे। अने नी ते तु तारा खरला भगत ने मड़ाट्‌या मे ह़ड़वा देय।<verse eid="ACT 2:27" /></para>
  <para style="q1">
    <verse number="28" style="v" sid="ACT 2:28" />तु मने जीवाय नी खरली वाट देखाड़ही,</para>
  <para style="q2" vid="ACT 2:28">तारी हजरी मे रेवा सी मने सेलभात्‌याण खुसी सी भर देही।<verse eid="ACT 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 2:29" />ए भायु! मे आड़ा-बुड़ा डायला बाह दावुद ना बारा मे तमारो धाक राख्‌या वगर आहयु केम के तीहयो मर ज्‌यो अने तीने गाड़ बी देदा। अने तीनु मड़ाट्‌यु आज लग अमारी वच मे से। <verse eid="ACT 2:29" /><verse number="30" style="v" sid="ACT 2:30" />दावुद भगवान वगे गेथी वात केण्‌यो माणेह हतो, एतरे तीहयो आहयी वात जाणतो हतो, के भगवान ह़ाम खाय्‌न मने आहयु केदलो हतो के मे तारीत कुळी मे गेथो एक जणा ने तारी राजगादी पोर बहाड़ही। <verse eid="ACT 2:30" /><verse number="31" style="v" sid="ACT 2:31" />तीहयो हयवा वाळी वात ने पेले गेथोत देखीन मसी ने मरला मे गेथो पासो जीव उठवा ना बारा मे भगवान वगे गेथी आहयी वात केदो, के</para>
  <para style="q1" vid="ACT 2:31">नी ते तु तीना जीव ने पताळ मे नाखे।</para>
  <para style="q2" vid="ACT 2:31">अने तु तारा खरला भगत ने नी ह़ड़वा देय।<verse eid="ACT 2:31" /></para>
  <para style="m">
    <verse number="32" style="v" sid="ACT 2:32" />आहयात ईसु ने भगवान मर्‌या-ह़र्‌या मे गेथो पासो जीवतो करीन बठो कर देदलो से, अने आमु आखा आहयी वात ना गवा से। <verse eid="ACT 2:32" /><verse number="33" style="v" sid="ACT 2:33" />अने आहया ईसु ने भगवान आखी कळजुग नो हकदार्‌यो बणावीन आह़फा नी जमणी धेड़े बहाड़ देदो, अने आहयो ईसु वायदो करली चोखली आत्‌मा ने बाह पांह ह़ात करीन आञे ह़ारीक पोखड़ी देदलो से, तीने तमु देख र्‌या, अने ह़मळी र्‌या। <verse eid="ACT 2:33" /><verse number="34" style="v" sid="ACT 2:34" />दावुद आह़फो डील भेळो ह़रग मे नी ज्‌यो, पण तीहयो आह़फोत केय,</para>
  <para style="q1" vid="ACT 2:34">यहोवा भगवान मारा मालीक भगवान ने केय:</para>
  <para style="q2" vid="ACT 2:34">तु मारी जमणी धेड़े बह,<verse eid="ACT 2:34" /></para>
  <para style="q2">
    <verse number="35" style="v" sid="ACT 2:35" />जत्‌यार लग मे तारा वेरी ने, तारा पोगु मेलवा नो जागो नी बणाय देम।<verse eid="ACT 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 2:36" />“ईस्‌रायली जाती नी आखी कुळी आहयु जाण लेवा जोवे के भगवान ईसु नेत जीने तमु कुरुस पोर चड़ावला, मालीक बी, अने मसी बी ठेराय देदलो से!”<verse eid="ACT 2:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 2:37" />आहयु ह़मळीन तीमनु मन ने घण-जबर ठेह लागी, अने तीहया पतरस ने अने ईसु ना बीजा नेवताळा ने पुसवा बाज ज्‌या, “ए भायु! आमने ह़ु करवा जोवे?”<verse eid="ACT 2:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 2:38" />पतरस तीमने आहयो जपाप आप्‌यो, “तमु पाप भणी गेथा मन फीरवीन भगवान वगा वळो, अने तमारी मे गेथो एकीक जणो आपणा-आपणा पाप नी माफी जुगु ईसु मसी ना नाम सी बपतीस्‌मा लेवो; ता तमु चोखली आत्‌मा नो वाटो हात करहु। <verse eid="ACT 2:38" /><verse number="39" style="v" sid="ACT 2:39" />काहाके भगवान नी चोखली आत्‌मा नो वाटो आपवा नो वायदो तमारी जुगु, अने तमारी अवल्‌यात जुगु से, अने तीहया आखा जुगु से, जे हमणे सेटा से, अने जीमने अमारो मालीक भगवान बोलाव्‌वा वाळो से।”<verse eid="ACT 2:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 2:40" />पतरस अळी ढेरेत वात नी लारे गवाय देदो, अने आहयु केतो जाय्‌न तीमनी पांह रावण्‌या करीन केदो, “तमु आह़फा ने आहयी पीड़ी ना घाड़्‌या माणहु सी बचाड़ो!” <verse eid="ACT 2:40" /><verse number="41" style="v" sid="ACT 2:41" />जे पतरस पोर भरहो कर्‌या तीहया बपतीस्‌मा ली लेदा; अने तीहया दाड़े तीनेक हजार माणहु ईसु ना नेवताळा ह़ाते भेसकाय ज्‌या। <verse eid="ACT 2:41" /><verse number="42" style="v" sid="ACT 2:42" />अने तीहया ईसु ना नेवताळा पांह ह़ीकवा मे, ह़ात-ह़ंगात मे, अने ईसु नी खतरीन रीती<note caller="+" style="f"><char style="fr" closed="false">2:42 </char><char style="ft" closed="false">युनानी बोलु मे आञे ह़ारीक रोट्‌लो तोड़वा मे लीखलु से।</char></note> मे, अने ईसु पांह वीन्‌ती करवा मे झींग पड़ला र्‌या।<verse eid="ACT 2:42" /></para>
  <para style="s">ईसु पोर भरहो करन्‌या नी ह़ात-ह़ंगात</para>
  <para style="p">
    <verse number="43" style="v" sid="ACT 2:43" />ईसु ना नेवताळा ना लारे सेल-भात्‌या कामु अने सेलाण्‌या हयता हता एतरे आखा माणहु बीही ज्‌या। <verse eid="ACT 2:43" /><verse number="44" style="v" sid="ACT 2:44" /><note caller="+" style="x"><char style="xo" closed="false">2:44 </char><char style="xt" closed="false"><ref loc="ACT 4:32-35">नेवताळा ना काम 4:32-35</ref></char></note>अने आखा ईसु पोर भरहो करन्‌या भेळात रेता हता, अने तीमनी पांह जे कंय बी हतु तीनी मे आखा नो साजो हतो। <verse eid="ACT 2:44" /><verse number="45" style="v" sid="ACT 2:45" />तीहया आपणु-आपणु माल-धन वेचीन, जे रुप्‌या-टका जड़े, तीहया रुप्‌या-टका जीने जोवे तीने आप देता हता। <verse eid="ACT 2:45" /><verse number="46" style="v" sid="ACT 2:46" />तीहया आखा एक-मन्‌या हय्‌न दाड़ीन मंदीर मे भेळा हयत्‌ला, अने आखान घोरे-घोरे जाय्‌न खुस हय्‌न मालीक नी खतरीन रीती मे भेसकायत्‌ला अने ह़ुदला मन सी भेळा हय्‌न खाणु खात्‌ला। <verse eid="ACT 2:46" /><verse number="47" style="v" sid="ACT 2:47" />अने तीहया भगवान नो गुण गाया करता हता, अने आखा माणहु तीमनी सी खुस हता। अने जे-जे पाप मे गेथो छुटकारो हात करत्‌ला, तीमने मालीक ईसु दाड़ीत तीमनी ह़ाते भेसकी देत्‌लो।<verse eid="ACT 2:47" /></para>
  <chapter eid="ACT 2" />
  <chapter number="3" style="c" sid="ACT 3" />
  <para style="s">लंगड़ा भीकारी नु आरगो हयणु</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 3:1" />पतरस अने युहन्‌नो मांजणीक टेमे, वीन्‌ती करवा उप्‌पर मंदीर मे जवा बाज र्‌या हता। <verse eid="ACT 3:1" /><verse number="2" style="v" sid="ACT 3:2" />अने तीहयी टेमे माणहु एक माणेह ने लीजवा बाज र्‌या हता, तीहयो पयदावारी सी लंगड़ो हतो। तीहया तीने दाड़ीन लावीन मंदीर ना घटाळु नाम ना झापला पोर बहाड़ देत्‌ला। अने तीहयो मंदीर मे जवा वाळा पांह भीक मांग्‌या करतो हतो। <verse eid="ACT 3:2" /><verse number="3" style="v" sid="ACT 3:3" />जत्‌यार तीहयो पतरस अने युहन्‌ना ने मंदीर मे जत्‌ला देख्‌यो, ता तीमनी पांह भीक मांग्‌यो। <verse eid="ACT 3:3" /><verse number="4" style="v" sid="ACT 3:4" />पतरस अने युहन्‌नो तीनी भणी एकडीट्‌यो भाळ्‌या अने पतरस केदो, “अमारी भणी भाळ!” <verse eid="ACT 3:4" /><verse number="5" style="v" sid="ACT 3:5" />अने तीहयो कंय जड़हे करीन तीमनी भणी एकडीट्‌यु भाळ्‌यो। <verse eid="ACT 3:5" /><verse number="6" style="v" sid="ACT 3:6" />जत्‌यार पतरस केदो, “मारी पांह नी ते चांदी हय, अने नी ते ह़ोनु हय, बाखीन जे मारी पांह से, तीहयु तने आपु ईसु मसी नासरी ना नाम सी चाल-फीर।” <verse eid="ACT 3:6" /><verse number="7" style="v" sid="ACT 3:7" />अने पतरस तीनो जमणो हात धरीन तीने उठाड़्‌यो, अने तेतरीत घड़ी लंगड़ा ना पोग मे अने मांडा मे जोर आय ज्‌यो। <verse eid="ACT 3:7" /><verse number="8" style="v" sid="ACT 3:8" />तीहयो उछळीन उबो हय ज्‌यो अने चालवा-फीरवा बाज ज्‌यो। अने भगवान ना गुण गावतो जाय्‌न तीमनी ह़ाते मंदीर मे जत र्‌यो। <verse eid="ACT 3:8" /><verse number="9" style="v" sid="ACT 3:9" />आखा माणहु तीने चालतो-फीरतो अने भगवान ना गुण गावत्‌लो देख्‌या। <verse eid="ACT 3:9" /><verse number="10" style="v" sid="ACT 3:10" />अने माणहु तीने ओळखीन केदा, “आहयो ते तीहयोन-तीहयो से, जे मंदीर ना घटाळा झापला पोर भीक मांग्‌या करत्‌लो।” तीहया लंगड़ा ह़ाते जे कंय बी हयु तीने देखीन तीहया वहराय जता हता।<verse eid="ACT 3:10" /></para>
  <para style="s">मंदीर मे जाय्‌न पतरस माणहु ने ह़ीकाड़े</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 3:11" />जत्‌यार तीहयो माणेह पतरस अने युहन्‌ना नो हात धरीन ह़ाते जवा बाज र्‌यो हतो। तत्‌यार आखा माणहु वहराय्‌न सुलेमान नाम ना मांडवा मे तीमनीन्‌तां दवड़ता आया। <verse eid="ACT 3:11" /><verse number="12" style="v" sid="ACT 3:12" />पतरस तीमने आवत्‌ला देखीन केदो, “ए ईस्‌रायली माणहु! तमु आहया माणेह ने देखीन काहा वहराय र्‌या, अने अमारी भणी भाळीन काहा तकाय र्‌या। तमने आसम लाग र्‌यु के आमुत अमारा ज्‌योरे अने अमारी भक्‌तीन ज्‌योरे आने चालतो-फीरतो करला से पण आसम नी हय। <verse eid="ACT 3:12" /><verse number="13" style="v" sid="ACT 3:13" />अब्‌राहम नो, ईसाक नो अने याकुब नो भगवान, अने अमारा आड़ा-बुड़ा नो भगवान आह़फा नो पावर्‌यो ईसु ने बड़ाय करलो से। तमु आहया ईसु ने सीपायड़ान हात मे धराय्‌न पीलातुस ना हात मे ह़ोप देदा अने जत्‌यार पीलातुस तीनो नीयाव करीन सोड़वा नो वीच्‌यार कर्‌यो, ता तमु हीने ना सोड़ो करीन नीकारो कर देदा। <verse eid="ACT 3:13" /><verse number="14" style="v" sid="ACT 3:14" /><note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 27:15-23">मत्‌ती 27:15-23</ref>; <ref loc="MRK 15:6-14">मरकुस 15:6-14</ref>; <ref loc="LUK 23:13-23">लुका 23:13-23</ref>; <ref loc="JHN 19:12-15">युहन्‌ना 19:12-15</ref></char></note>तमु चोखला अने धरमी माणेह ने ना सोड़ो करीन तीनो नीकारो कर देदा, अने तमारीन करते हत्‌यारा ने सोड़ दे करीन केदा। <verse eid="ACT 3:14" /><verse number="15" style="v" sid="ACT 3:15" />आसम करीन तमु जीवाय आपण्‌या ने मराय नाख्‌या, बाखीन भगवान तीने मर्‌या-ह़र्‌या मे गेथो जीवतो करीन बठो कर देदो; अने आमु हीय्‌यी वात ना गवा से। <verse eid="ACT 3:15" /><verse number="16" style="v" sid="ACT 3:16" />काहाके आमु ‘ईसु’ नाम पोर भरहो कर्‌या, अने आहयात नाम ना ज्‌योरे आहया माणेह ने जीने तमु देखो, अने जाणो, जोर जड़लो से ह़ाचलीन तीहयोत भरहो जे ईसुन लारे जड़लो से, आने तमारी आखा अगळ पुरोन-पुरो आरगो करलो से।<verse eid="ACT 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 3:17" />“अने हाव ए भायु! मे जाणु के तमु अने तमारा मुख्‌या अंजाण्‌या हता, ईनीन करते तीहया ईसु ने कुरुस पोर चड़ावीन मराय नाख्‌या। <verse eid="ACT 3:17" /><verse number="18" style="v" sid="ACT 3:18" />पण भगवान वगे गेथी वात केण्‌या माणेह ना लारे पेले गेथोत की देदलो के तीनी वगे गेथा आवण्‌या मसी ने दुख झेलवा पड़हे। आसम करीन भगवान आह़फो केदलु तीहयु पुरु कर्‌यो। <verse eid="ACT 3:18" /><verse number="19" style="v" sid="ACT 3:19" />एतरे आह़फा ना पाप ने मीटाड़वा करीन तमु पाप भणी गेथा मन फीरवीन भगवान वगा वळो; <verse eid="ACT 3:19" /><verse number="20" style="v" sid="ACT 3:20" />ता तमने मालीक नी हजरी मे ह़ुकना जीवे जीव्‌वा जड़हे। तत्‌यार भगवान तमारी जुगु पेले गेथा ठेरावला ईसु मसी ने तमारीन्‌तां मोकलहे <verse eid="ACT 3:20" /><verse number="21" style="v" sid="ACT 3:21" />आहयो मसी तीहयी टेमे लग ह़रग मे रेहे, जत्‌यार लग तीहयो आखी चीज ने पेले हती तेवीन-तेवी नी बणावे आहयी टेम अने वात ना बारा मे, भगवान वगे गेथा वात करन्‌या चोखला माणहु कळ घड़ायी तां गेथात केता आय र्‌या। <verse eid="ACT 3:21" /><verse number="22" style="v" sid="ACT 3:22" />जीसम मुसो केदलो हतो, मालीक भगवान तमारी जुगु, तमारा भाय-बेटा मे गेथोत एक मारीन तेवा भगवान वगे गेथी वात केण्‌या माणहे ने उबजाड़हे, तीहयो भगवान वगे गेथी वात केण्‌यो माणेह जे कंय तमने केहे, तीहयु ह़मळीन तमु तीनी वात मान्‌जो। <verse eid="ACT 3:22" /><verse number="23" style="v" sid="ACT 3:23" />पण जे बी तीहया भगवान वगे गेथी वात केण्‌या माणेह नी वात ह़मळीन नी माने, तीहयो तीने आह़फा ना माणहु मे गेथो खुटाड़ देहे। <verse eid="ACT 3:23" /><verse number="24" style="v" sid="ACT 3:24" />अने समुएल अने तीनी गेथा अळतेण आवला आखा भगवान ना वात केण्‌या माणहु ईसु ना दाड़ा ना बारा मे पेले गेथात वात केदला हता। <verse eid="ACT 3:24" /><verse number="25" style="v" sid="ACT 3:25" />तमु भगवान वगे गेथी वात केण्‌या माणहु नी अवल्‌यात से, अने तीना वायदा ना साजल्‌या से, जे वायदा ने भगवान तमारा आड़ा-बुड़ा वाटु ते वखत ठेरायो, जत्‌यार तीहयो अब्‌राहम ने केदो, तारी अवल्‌यात नी लारे धरती पोर रेण्‌या आखी कळी ना माणहु संयबरकत हात करहे। <verse eid="ACT 3:25" /><verse number="26" style="v" sid="ACT 3:26" />भगवान तमारी मे गेथा एकीक जणा ने कुहराय सोड़ावीन संयबरकत आपवा करीन, आह़फा ना पावर्‌या ने तमारीन्‌तां मोकल्‌लो से।”<verse eid="ACT 3:26" /></para>
  <chapter eid="ACT 3" />
  <chapter number="4" style="c" sid="ACT 4" />
  <para style="s">मोट्‌ली बठक अगळ पतरस अने युहन्‌नो</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 4:1" />पतरस अने युहन्‌नो माणहु ने केवा बाज रेला, ता पुंजारो, मंदीर रखवाळ्‌यो डखी, अने सदुकी पंथवाळा माणहु तीमनीन्‌तां जोर करीन आय लाग्‌या। <verse eid="ACT 4:1" /><verse number="2" style="v" sid="ACT 4:2" />पतरस अने युहन्‌नो ईसु मर्‌या-ह़र्‌या मे गेथो जीवतो हय ज्‌यो करीन मर्‌या-ह़र्‌या मे गेथो जीवतो हय्‌न बठो हयवान बारा मे ईसु नो दाखलो देखाड़ीन परच्‌यार करता हता। एतरे तीहया घण-जबर रीहवाय र्‌या हता। <verse eid="ACT 4:2" /><verse number="3" style="v" sid="ACT 4:3" />एतरे तीहया पतरस अने युहन्‌ना ने धरीन बीजा दाड़े लग कुंड़वाड़ा मे कुंड देदा, काहाके ह़ांज हय जेली हती। <verse eid="ACT 4:3" /><verse number="4" style="v" sid="ACT 4:4" />पण जे तीमनी ह़ीकापण ह़मळी र्‌या हता, तीमनी मे गेथा ढेरेत जणा ईसु पोर भरहो कर्‌या, अने ईसु पोर भरहो करन्‌या अदमड़ा-अदमड़ा पांचेक हजार हय जेला।<verse eid="ACT 4:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 4:5" />बीजा दाड़े यरुसलेम मे राज करन्‌या मुखी नी, अने पुडारी नी, अने युहदी-धरम ह़ीकाड़न्‌या नी बठक हयी। <verse eid="ACT 4:5" /><verse number="6" style="v" sid="ACT 4:6" />अने ता ह़ारीक भगवान नो डायलो पुंजारो हन्‌ना, अने केफा, अने युहन्‌नो, अने सीकंदर अने मुखी पुंजारा ना घोरल्‌या बी आखा यरुसलेम मे भेळा हया। <verse eid="ACT 4:6" /><verse number="7" style="v" sid="ACT 4:7" />तीहया चेला ने आखा ना वच मे उबा करीन पुछवा बाज ज्‌या “तमु काना हक सी अने काना नाम सी आहयु करला से?”<verse eid="ACT 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 4:8" />तत्‌यार पतरस चोखली आत्‌मा ना कब्‌जा मे हय्‌न तीमने केदो, ए माणहु ना मुखी अने डायला! <verse eid="ACT 4:8" /><verse number="9" style="v" sid="ACT 4:9" />एक लंगड़ा माणेह नु भलु हयलु से, ईना बारा मे आज आमने तमु पुछवा बाज र्‌या के आहयो कीसम आरगो हयलो से, <verse eid="ACT 4:9" /><verse number="10" style="v" sid="ACT 4:10" />ता तमु आखा ने अने ईस्‌रायली जाती ना माणहु ने मालम हय जवा जोवे के आहयो लंगड़ो माणेह ईसु मसी नासरी ना नाम सी आरगो हय्‌न तमारी अगळ उबो हय र्‌यो। जीने तमु तीहया कुरुस पोर चड़ावीन खुटा ठोकीन मार नाखला, अने भगवान तीने मर्‌या-ह़र्‌या मे गेथो पासो जीवतो कर्‌यो। <verse eid="ACT 4:10" /><verse number="11" style="v" sid="ACT 4:11" />आहयो ईसु तीहयो दगड़ो से, जे दगड़ा ने राज मीसतर्‌या रीकामो ह़मजीन बारथो काड देदा,</para>
  <para style="q1" vid="ACT 4:11">तीहयो दगड़ोत घोर ना नीव नो,</para>
  <para style="q2" vid="ACT 4:11">खुणे वाळो दगड़ो बण ज्‌यो।<verse eid="ACT 4:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ACT 4:12" />एतरे ईसु ने सोड़ीन काना बी बीजा माणेह ना लारे पाप नो छुटकारो नी जड़े, काहाके ह़रग ने हेटु आहयी आखी कळी मे ईसु ने सोड़ीन बीजु नामेत नी हय, तीहया नाम सी आपणु ने पाप मे गेथो छुटकारो जड़ सके।<verse eid="ACT 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 4:13" />जत्‌यार युहदी मुखी पतरस अने युहन्‌ना नी हीम्‌मत देखीन वहराय ज्‌या, काहाके आहया ते भणला नी हता अने ह़ुदला माणहु से, पण अळतेण मालम पड़्‌यु के आहया ते ईसु ह़ाते रेला हता। <verse eid="ACT 4:13" /><verse number="14" style="v" sid="ACT 4:14" />बाखीन आरगो हयला माणेह ने तीमनी भेळतो उबो हय रेलो देखीन, तीमने जपाप मे कंय नी केवायु। <verse eid="ACT 4:14" /><verse number="15" style="v" sid="ACT 4:15" />पण तीहया पतरस अने युहन्‌ना ने बठक मे गेथा बारा मोकली देदा अने आह़फा-आह़फात आहयो वीच्‌यार काड्‌या, <verse eid="ACT 4:15" /><verse number="16" style="v" sid="ACT 4:16" />के “आमु ईमने ह़ु करया ने ह़ु नी? काहाके यरुसलेम मे रेण्‌या आखा माणहु ने आहयो पतो हय जेलो से के आहया एक घणा जुदा-काम नी सेलाणी देखाड़ला से; अने आपणु ने आहया काम नो नीकारो करते नी बणे। <verse eid="ACT 4:16" /><verse number="17" style="v" sid="ACT 4:17" />पण ते बी आहयी वात नो वदु परच्‌यार माणहु मे नी हयवा जोवे, करीन आपणु ईमने धमकाय देता, के तमु आहया ईसु नु नाम लीन कोय ह़ाते वात ना करो।”<verse eid="ACT 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 4:18" />ता तीहया पतरस अने युहन्‌ना ने अळी बोलाव्‌वा मोकल्‌या अने तीमने हुकम आपीन केदा, के तमु ईसु नु नाम लीन कोय ह़ाते वात बी नी करजो, अने कोयने ह़ीकाड़जो बी नी। <verse eid="ACT 4:18" /><verse number="19" style="v" sid="ACT 4:19" />पण पतरस अने युहन्‌नो तीमने आहयो जपाप आप्‌या, “तमु ते नीयाव करीन केवो, आमने भगवान नी नींगा मे, भगवान नी ह़मळवा रेवा दीन तमारी ह़मळवा ताले रेहे ह़ु? <verse eid="ACT 4:19" /><verse number="20" style="v" sid="ACT 4:20" />काहाके आमु जे देखला अने ह़मळ्‌ळा से, तीना बारा मे नी कीया, आसम हय नी सके।” <verse eid="ACT 4:20" /><verse number="21" style="v" sid="ACT 4:21" />तत्‌यार तीहया अळी पतरस अने युहन्‌ना ने धमकाय्‌न सोड़ देदा, काहाके तीमने डंड आपवा नु कंय बी बोनु नी जड़्‌यु, एतरे जे घटना हयली हती तीना कारण सी आखा माणहु भगवान नी बड़ाय करता हता। <verse eid="ACT 4:21" /><verse number="22" style="v" sid="ACT 4:22" />काहाके तीहया जुदा-कामु नी सेलाणी ना लारे जे माणेह ने अरगाय जड़ली हती, तीनी उमर चाळीह साल गेथी वदु हती।<verse eid="ACT 4:22" /></para>
  <para style="s">ईसु पोर भरहो करन्‌या नी वीन्‌ती</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 4:23" />जत्‌यार तीहया पतरस अने युहन्‌ना ने सोड़ देदा, ता पतरस अने युहन्‌ना तीमना ह़ातीन तां आया, अने जे कंय पुडार्‌या अने भगवान ना डायला पुंजारा केदला, तीहयु आखु तीमने की देदा। <verse eid="ACT 4:23" /><verse number="24" style="v" sid="ACT 4:24" />आहयु ह़मळीन पतरस अने युहन्‌ना अने तीमना ह़ाती आखा मेळीन एकीत रींग मे भगवान सी आहयी वीन्‌ती कर्‌या, ए मालीक, तुत ह़रग अने धरती, अने दर्‌या अने दर्‌या मे जे कंय से, तीहयु आखु बणावलो से। <verse eid="ACT 4:24" /><verse number="25" style="v" sid="ACT 4:25" />तु चोखली आत्‌मान लारे आह़फा ना पावर्‌या दावुद ना मोडे आहयु केदलो हतो,</para>
  <para style="q1" vid="ACT 4:25">बीजी जाती ना माणहु फालतुत कुहराये काहा आड़े?</para>
  <para style="q2" vid="ACT 4:25">आखा देसु ना माणहु फाल्‌तु वीच्‌यार काहा कर र्‌या।<verse eid="ACT 4:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 4:26" />धरती ना राजा अने देस-देस मे राज करन्‌या आखा भेळा हया,</para>
  <para style="q2" vid="ACT 4:26">तीहया मालीक भगवान भणी</para>
  <para style="q2" vid="ACT 4:26">अने तीना टाळला राजा भणी जोर करे।<verse eid="ACT 4:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ACT 4:27" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:27 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 23:7-11">लुका 23:7-11</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 27:1">मत्‌ती 27:1</ref>,<ref loc="MAT 27:2">2</ref>; <ref loc="MRK 15:1">मरकुस 15:1</ref>; <ref loc="LUK 23:1">लुका 23:1</ref>; <ref loc="JHN 18:28">युहन्‌ना 18:28</ref>,<ref loc="JHN 18:29">29</ref></char>
    </note>काहाके तीहया ह़ाचलीन, तारा चोखला पावर्‌या ईसु ना वीरोद मे हय्‌न जाळसादी बणाय र्‌या, जीने तु टाळलो से, हेरोद अने पुन्‌तीयुस पीलातुस, अने आड़जात्‌या अने ईस्‌रायली जाती ना माणहु ह़ेर मे भेळा हय र्‌या। <verse eid="ACT 4:27" /><verse number="28" style="v" sid="ACT 4:28" />हाव तीहया आनीन करते भेळा हय र्‌या के जे कंय तारी ताखत अने मरजी सी पेले गेथुत ठेरावलु से, तीहयु पुरु करो। <verse eid="ACT 4:28" /><verse number="29" style="v" sid="ACT 4:29" />ए मालीक हाव, तु ईमनी धमकी ने देख, अने तारा गुलाम पावर्‌या ने आहयो वाटो आप के तीहया तारा बोलु ने बीह्‌या वगर पुरु मन लगाड़ीन ह़मळावे तेम। <verse eid="ACT 4:29" /><verse number="30" style="v" sid="ACT 4:30" />अने तु माणहु ने आरगा करवा करीन आह़फा नो हात अगो कर; अने तारा चोखला पावर्‌या ईसु ना नामे, सेलाणी अने सेल-भात्‌या जुदा-कामु देखाड़।<verse eid="ACT 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 4:31" />तत्‌यार तीहया भगवान ह़ाते वीन्‌ती करीन नवराय ज्‌या, ता तीहयो जागो, जां तीहया भेळा हय रेला, हील पड़्‌यो, अने चोखली आत्‌मा तीमनी मे पुरीन-पुरी भराय्‌न तीमने कब्‌जा मे कर लेदी, अने तीहया हीम्‌मत सी भगवान ना बोल माणहु ने ह़मळावा बाज ज्‌या।<verse eid="ACT 4:31" /></para>
  <para style="s">ईसु ना माणहु नु हेळ-मेळीन रेणु</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 4:32" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:32 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 2:44">नेवताळा ना काम 2:44</ref>,<ref loc="ACT 2:45">45</ref></char>
    </note>ईसु पोर भरहो करन्‌या माणहु एक-मन्‌या अने एक जीव्‌या रीन रेता हता। कोय बी आपणा धन ने आपणु नी ह़मजत्‌ला। जे कंय तीमनी पांह रेत्‌लु, तीनी मे आखा नो साजो हतो। <verse eid="ACT 4:32" /><verse number="33" style="v" sid="ACT 4:33" />ईसु ना नेवताळा पुरो जोर लगाड़ीन मालीक ईसु मर्‌या-ह़र्‌या मे गेथो जीवतो हय्‌न बठो हयवा नी गवा देत्‌ला, अने तीहया आखा पोर भगवान नी मोट्‌ली दया हती। <verse eid="ACT 4:33" /><verse number="34" style="v" sid="ACT 4:34" />अने तीमनी मे कोय बी गरीब नी हतो, काहाके तीमनी पांह खेतर नीता घोर हतु, तीने तीहया वेच देत्‌ला। <verse eid="ACT 4:34" /><verse number="35" style="v" sid="ACT 4:35" />अने तीमनो दाम लावीन ईसु ना नेवताळा ना पोगुन तां लावीन मेक देत्‌ला; अने जीने जे जोवत्‌लु तीहयु तीमने वाट देत्‌ला।<verse eid="ACT 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 4:36" />युसुफ नाम नो एक लेवी हतो, तीहयो कुपरुस मे पयदा हयलो हतो, तीनु नाम ईसु ना नेवताळा बरनाबास पाड़ला हता। बरनाबास नु मतलब सांती आपण्‌या नो बेटो। <verse eid="ACT 4:36" /><verse number="37" style="v" sid="ACT 4:37" />तीनी थोड़ीक जागा हती तीने तीहयो वेच्‌यो, अने कीमत ना पय्‌हा लाय्‌न नेवताळा ना पोगु मे मेल देदो।<verse eid="ACT 4:37" /></para>
  <chapter eid="ACT 4" />
  <chapter number="5" style="c" sid="ACT 5" />
  <para style="s">हनन्‌या अने सफीरा</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 5:1" />हनन्‌या नाम नो एक अदमी अने तीनी लाडी सफीरा एक खेतर वेच्‌या। <verse eid="ACT 5:1" /><verse number="2" style="v" sid="ACT 5:2" />तीहयो खेतर ना कीमत नो एक वाटो आह़फो राख लेदो आहयी वात तीनी घोरवाळी बी जाणती हती, अने तीहयो बीजो वाटो लावीन चेला ना पोगु मे मेक देदो। <verse eid="ACT 5:2" /><verse number="3" style="v" sid="ACT 5:3" />पण पतरस केदो, “ए हनन्‌या! भुतड़ो तारा मन मे आहयी वात काहा नाख देदो, के तु चोखली आत्‌मा ने झुट मेके अने जागो वेचलो तीनी कीमत मे गेथो थोड़ाक पय्‌हा बचाड़ीन मेक ले? <verse eid="ACT 5:3" /><verse number="4" style="v" sid="ACT 5:4" />वेचवा नी पेले तीहयु खेतर तारु नी हतु ह़ु? अने तीहया वेचला खेतर नी कीमत पोर तारो हक नी हतो ह़ु? अने तु आह़फा ना मन मे आवो वीच्‌यार काहा कर्‌यो? तु माणहु ने नी, पण भगवान ने झुट मेकलो से।” <verse eid="ACT 5:4" /><verse number="5" style="v" sid="ACT 5:5" />हनन्‌यो आहयी वात ह़मळीन पड़्‌यो अने तीनो जीव नीकळी ज्‌यो। अने जे बी तीना बारा मे ह़मळ्‌या, तीहया घण-जबर बीही ज्‌या। <verse eid="ACT 5:5" /><verse number="6" style="v" sid="ACT 5:6" />अळतेण जुवान्‌या धोड़ ने उचलीन कफन ना लुगड़ा मे गुचवीन, तीने बारथा ली जाय्‌न वगे कर देदा।<verse eid="ACT 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 5:7" />आसम हयु, तीहयी वात ना बारा मे हनन्‌या नी लाडी ने मालम नी हतु, अने तीन घंटान अळतेण तीहयी पतरस हतो तीहयात घोर मे आयी।<verse eid="ACT 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 5:8" />तत्‌यार पतरस तीहयी बयर ने आहयो सवाल पुछ्‌यो, “मने देखाड़, तमु तीहयु खेतर एतरात मे वेचला ह़ु?” तीहयी केदी, “होव, एतरात मे वेचला।”<verse eid="ACT 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 5:9" />तीनो जपाप ह़मळीन पतरस तीहयी बयर ने केदो, “तमु बेम जणा मालीक भगवान नी आत्‌मा ने पारखवा करीन एको करला से? ह़मळ! आहया माणहु तारा धणी ने वगे करवा जेला, तीहयात पासा आवीन झापलेत उबा हय र्‌या, अने हाव तीहया तने बी वगे करवा बारथा लीजहे।” <verse eid="ACT 5:9" /><verse number="10" style="v" sid="ACT 5:10" />आहयी वात ह़मळतेत तीहयी पतरस ना पोगु मे पड़ी, अने मर जी। अने तीहया जुवान्‌या घोर मे आवीन तीने मरली देख्‌या, अने तीने बी बारथा ली जाय्‌न तीना अदमी ना धेड़े वगे कर देदा। <verse eid="ACT 5:10" /><verse number="11" style="v" sid="ACT 5:11" />एतरे आखी मंडळी ना माणहु अने आहयी वात ह़मळन्‌या आखा घणा बीह ज्‌या।<verse eid="ACT 5:11" /></para>
  <para style="s">जुदा-काम अने सेलाणी</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 5:12" />ईसु ना नेवताळा घणा ढेरका जुदा-कामु अने सेलाणी देखाड़ता हता, अने आखा एक मन हय्‌न सुलेमान ना मांडवा मे भेळा हया करता हता। <verse eid="ACT 5:12" /><verse number="13" style="v" sid="ACT 5:13" />पण बीजा माणहु ने ईसु ना नेवताळा ह़ाते भेसकावा नी हीम्‌मत नी हयती हती। पण तीहया माणहु ईसु ना नेवताळा ने घणा वारु से, करीन केता हता। <verse eid="ACT 5:13" /><verse number="14" style="v" sid="ACT 5:14" />पण भरहो करन्‌या ढेरेत अदमी अने बयरा आवीन मालीक नी मंडळी मे भेसकायता ज्‌या। <verse eid="ACT 5:14" /><verse number="15" style="v" sid="ACT 5:15" />आञे लग के माणहु मांदला ने ह़ड़क पोर लावी-लावीन, खाटला पोर ह़ुवाड़ देता हता, के जत्‌यार पतरस आञे माय्‌न सरके ता मांदला माणहु पोर पतरस नो साहळो कोय पोर पड़ जाय। <verse eid="ACT 5:15" /><verse number="16" style="v" sid="ACT 5:16" />यरुसलेम ना ह़ेर ना आड़े-धेड़े ना ह़ेर वाळा बी मांदला अने वीटळ्‌ळा भुत लागला माणहु ने लावत्‌ला अने तीहया आखा आरगा हय जत्‌ला।<verse eid="ACT 5:16" /></para>
  <para style="s">नेवताळा ने धरीन ली जाणु</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 5:17" />आहयु आखु देखीन डायलो पुंजारो, अने सदुकी पंथवाळा अने तीना आखा ह़ाती-ह़ंगात वाळा कुहरायवा बाज ज्‌या। <verse eid="ACT 5:17" /><verse number="18" style="v" sid="ACT 5:18" />अने तीहया ईसु ना नेवताळा ने धरीन जेल मे कुंड देदा। <verse eid="ACT 5:18" /><verse number="19" style="v" sid="ACT 5:19" />पण मालीक भगवान नो एक ह़रगदुत, जेल नु झापलु उगाड़ देदो, अने तीहयो तीमने बारथा ली जाय्‌न केदो, <verse eid="ACT 5:19" /><verse number="20" style="v" sid="ACT 5:20" />अने तीहयो तत्‌यारुत भगवान ना भक्‌ती ना घोर मे ज्‌यो अने ईसु नु परच्‌यार करवा बाज ज्‌यो के तीहयो भगवान नो सोरो से। <verse eid="ACT 5:20" /><verse number="21" style="v" sid="ACT 5:21" />अने ईसु ना नेवताळा ह़रगदुत नी वात ह़मळीन ह़वारे हयतात मंदीर मे जाय्‌न नवली जीवाय नी ह़ीकापण आपवा बाज ज्‌या। तत्‌यार भगवान नो डायलो पुंजारो, अने सदुकी पंथवाळा अने तीना आखा ह़ात-ह़ंगात वाळा आवीन युहदी माणहु नी बठक ने अने ईस्‌रायली जाती ना आखा पुडार्‌या ने भेळा कर्‌या, अने सीपायड़ा ने की मोकल्‌या के तमु जेल मे गेथा ईसु ना नेवताळा ने ली आवो। <verse eid="ACT 5:21" /><verse number="22" style="v" sid="ACT 5:22" />पण जत्‌यार सीपायड़ा तां पुग्‌या, ता ईसु ना नेवताळा तीमने जेल मे नी जड़्‌या। ता सीपायड़ा पासा आवीन भगवान ना डायला पुंजारा ने अने सदुकी पंथवाळा ने आहयु केदा, <verse eid="ACT 5:22" /><verse number="23" style="v" sid="ACT 5:23" />“आमु जाय्‌न देख्‌या ता जेल मे वारु ह़च करीन बंद कर मेकला हयला, अने झापले पोहरो देण्‌या पोहरो देता जाय्‌न उबा हय रेला; पण जत्‌यार आमु मोय ज्‌या, तत्‌यार तां कोय नी हतु।” <verse eid="ACT 5:23" /><verse number="24" style="v" sid="ACT 5:24" />आहयी वात ह़मळीन मंदीर ना रखवाळ्‌या डखी अने भगवान ना डायला पुंजारा ने ह़मज मे नी आयु, के चेला नु ह़ु हयु अने “हाव ह़ु हयहे।” <verse eid="ACT 5:24" /><verse number="25" style="v" sid="ACT 5:25" />तीहयीत टेमे कानो आवीन तीमने आहयी खबर आप्‌यो, “देखो, जे माणहु ने तमु जेल मे कुंड देदला, तीहयात माणहु मंदीर मे उबा हय्‌न माणहु ने नवली जीवाय ना बारा मे ह़ीकाड़वा बाज र्‌या।” <verse eid="ACT 5:25" /><verse number="26" style="v" sid="ACT 5:26" />तत्‌यार मंदीर रखवाळ्‌या सीपायड़ा नो डखी, तीना सीपायड़ा ने लीन ज्‌यो, अने ईसु ना नेवताळा ने धर लायो। पण माणहु दगड़ाट देहे, करीन जबराण धरीन नी लायो, काहाके तीहया माणहु ने देखीन बीहता हता।<verse eid="ACT 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 5:27" />तीहया नेवताळा ने लावीन मोट्‌ली बठक अगळ उबा कर देदा; अने भगवान नो डायलो पुंजारो तीमने केदो, <verse eid="ACT 5:27" /><verse number="28" style="v" sid="ACT 5:28" /><note caller="+" style="x"><char style="xo" closed="false">5:28 </char><char style="xt" closed="false"><ref loc="MAT 27:25">मत्‌ती 27:25</ref></char></note>“आमु तमने घणा जुदा हुकम आपला के तमु तीनु नाम लीन माणहु ने नी ह़ीकाड़जो? ते बी तमु आखा यरुसलेम ह़ेर ने तमारी ह़ीकापण सी भर देदा, अने तीहया माणेह ना लोय नो गुनो अमारी पोर लगाड़वा हींड र्‌या।”<verse eid="ACT 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 5:29" />पतरस अने ईसु ना नेवताळा आहयो जपाप आप्‌या, “माणहु नो हुकम पाळवा सी भगवान नो हुकम पाळवा वदु वारु से। <verse eid="ACT 5:29" /><verse number="30" style="v" sid="ACT 5:30" />जे ईसु ने तमु कुरुस पोर चड़ावीन खुटा ठोकीन मार नाख्‌या, तीहया ईसु ने आपणा डाह-डाहा नो भगवान मर्‌या-ह़र्‌या मे गेथो जीवाड़ देदो। <verse eid="ACT 5:30" /><verse number="31" style="v" sid="ACT 5:31" />आहयात ईसु ने भगवान, डायलो अने पाप मे गेथो सोड़ाव्‌वा वाळो ठेरावीन, तीनी जमणी धेड़े बहाड़ीन मोट्‌लो हक आप देदो, अने तीहयो ईस्‌रायली जाती ना माणहु ने पाप भणी गेथा मन फीरवीन, भगवान भणी वाळवा नी सक्‌ती अने पाप नी माफी आपे तेम। <verse eid="ACT 5:31" /><verse number="32" style="v" sid="ACT 5:32" />आहयी आखी वात ना गवा आमु से, अने चोखली आत्‌मा बी से, अने आहयी चोखली आत्‌मा, भगवान तीहया माणहु ने आपलो से, जे भगवान नो हुकम पाळे।”<verse eid="ACT 5:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 5:33" />आहयी वात ह़मळीन तीहया घण-जबर रीहवाय ज्‌या, अने नेवताळा ने मार नाखवा नो वीच्‌यार कर्‌या। <verse eid="ACT 5:33" /><verse number="34" style="v" sid="ACT 5:34" />तीहयी मोट्‌ली बठक मे गमलीएल नाम नो एक फरीसी पंथवाळो हतो, तीहयो मुसा नी लीखली सास्‌तर ना कायदा ह़ीकाड़न्‌यो मास्‌तर हतो, अने तीनी ईज्‌जत आखा करत्‌ला। तीहयो मोट्‌ली बठक मे उबो हय्‌न हुकम आप्‌यो के “आहया नेवताळा ने जरीक वार लग बारा ली जावो।” <verse eid="ACT 5:34" /><verse number="35" style="v" sid="ACT 5:35" />अने अळतेण तीहयो बठक मे वाळा ईस्‌रायली माणहु ने केदो, “ए ईस्‌रायली जाती ना माणहु, तमु आहया माणहु ह़ाते जे कंय करवा हींड र्‌या, तीहयु वारु वीच्‌यार करीन नेत करजो। <verse eid="ACT 5:35" /><verse number="36" style="v" sid="ACT 5:36" />काहाके आहया दाड़ा गेथो पेले थीयुदास नाम नो एक माणेह आहयु केतो जाय्‌न उबो हयो, के ‘मे बी कंय से’ अने च्‌यारेक ह़ोव माणहु तीनी पोर भरहो करीन तीनी ह़ाते चाल पड़्‌या, पण तीने कानो मार नाख्‌यो; अने जेतरा बी माणहु तीनी ह़ाते हता, तीहया रीवण्‌या-तीवण्‌या हय्‌न मीट ज्‌या। <verse eid="ACT 5:36" /><verse number="37" style="v" sid="ACT 5:37" />अळतेण माणहु नी गीनती नी टेम आयी, तीहयी टेमे गलील जीला मे रेण्‌यो यहुदा उठ्‌यो। तीहयो थोड़ाक माणहु ने पटाड़ीन पाल्‌टी बणाय लेदो। पण तीने बी कानो मार नाख्‌यो। अने तीनी पोर भरहो करन्‌या बी रीवण्‌या-तीवण्‌या हय ज्‌या। <verse eid="ACT 5:37" /><verse number="38" style="v" sid="ACT 5:38" />एतरे मे तमने केम के तमु आहया नेवताळा गेथा सेटा रेवो, अने हीमना काम मे आडा ना देवायो, काहाके हीमनु काम माणहु वगे गेथु हहे ता तीहयु आह़फुत मीट जहे। <verse eid="ACT 5:38" /><verse number="39" style="v" sid="ACT 5:39" />पण आहयु काम भगवान वगे गेथु हहे, ता तमु हीमने कदी मटाड़ी नी सके; अने तमु भगवान ना वीरोद मे हय्‌न तीनी ह़ाते झुमायण्‌या बी गणायहु।” <verse eid="ACT 5:39" /><verse number="40" style="v" sid="ACT 5:40" />तत्‌यार बठक मे वाळा माणहु गमलीएल नी वात मान लेदा। अने तीहया नेवताळा ने बोलावीन तीमने ठोकाड़्‌या; अने तीमने आहयो हुकम आपीन केदा, “ईसु नु नाम लीन कोय ह़ाते वात नी करजो।” अने अळतेण तीमने सोड़ देदा। <verse eid="ACT 5:40" /><verse number="41" style="v" sid="ACT 5:41" />अने नेवताळा आहयी वात सी खुस हय्‌न आहयु केता जाय्‌न मोट्‌ली बठक मे गेथा जत र्‌या, के कम सी कम अमारी ईसु ना नाम सी नामबद्‌दी ते हयी। <verse eid="ACT 5:41" /><verse number="42" style="v" sid="ACT 5:42" />तीहया दाड़ीत मंदीर मे, अने घोर-घोर जाय्‌न ईसु नी ह़ीकापण ह़मळावता र्‌या, अने ईसु नी आहयी खुस-खबर ह़मळावता ज्‌या के “ईसुत मसी से।”<verse eid="ACT 5:42" /></para>
  <chapter eid="ACT 5" />
  <chapter number="6" style="c" sid="ACT 6" />
  <para style="s">ह़ात चाकर्‌या ने टाळे</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 6:1" />तीहया दाड़ा मे जत्‌यार चेला नी गीनती बड़वा बाज जी। ता युनानी बोली बोलन्‌या, अने ईब्‌रानी बोली बोलन्‌या नी वच मे झगड़ो हयवा बाज ज्‌यो, ईब्‌रानी भासा बोलन्‌या आहयो दावो कर र्‌या हता के आमनी दाड़ीक नी सेवा मे रंडायला बयरा नी खबर नी लेता। <verse eid="ACT 6:1" /><verse number="2" style="v" sid="ACT 6:2" />तत्‌यार ईसु ना बारे नेवताळा, चेला नी मंडळी बोलावीन केदा, “आहयु ताले नी हय के आमु खाणु वाटवान करते वारती बणीन भगवान नो बोल सोड़ दीया। <verse eid="ACT 6:2" /><verse number="3" style="v" sid="ACT 6:3" />एतरे ए भायु, तमु, तमारी मे गेथा वारला गुण वाळा नामह़ाद्‌या ह़ात अदमी ने टाळ लेवो, तीमनी मे चोखली आत्‌मा पुरीन-पुरी भरायली से, अने तीहया अक्‌कल वाळा अने ईमानदार से, अने आमु तीमने खाणु अने ह़मान आपवा नो हक आप देह़ु। <verse eid="ACT 6:3" /><verse number="4" style="v" sid="ACT 6:4" />पण आमु ते वीन्‌ती मे अने बोलु ने वाटवा नी सेवा-चाकरी करता रेहु।”<verse eid="ACT 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 6:5" />आहयी वात ह़मळीन आखी मंडळी ना माणहु खुस हय ज्‌या। अने तीहया स्‌तीफनुस ने टाळ लेदा, तीनी मे चोखली आत्‌मा पुरीन-पुरी भरायली हती, अने तीहयो ईसु पोर पक्‌को भरहो करन्‌यो हतो। अने तीहया फीलीपुस ने, अने परखरुस ने, अने नीकानोर ने, अने तीमोन ने, अने परमीनास ने, अने अंताकीया वाळा नीकलाउस ने, जे युहदी-धरम ने मानवा बाज जेलो हतो, टाळ्‌या। <verse eid="ACT 6:5" /><verse number="6" style="v" sid="ACT 6:6" />अने तीहया तीमने नेवताळा अगळ उबा कर देदा अने नेवताळा तीहया टाळला जुगु भगवान ह़ाते वीन्‌ती कर्‌या अने अळतेण तीमनी पोर तीहया हात मेल्‌या।<verse eid="ACT 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 6:7" />भगवान ना बोलु फेलता ज्‌या, अने यरुसलेम मे घण ढेरका ईसु पोर भरहो करीन चेला बण ज्‌या; अने भगवान ना डायला पुंजारा नो मोट्‌लो टोळो ईसु ना भरहा ने मान लेदो।<verse eid="ACT 6:7" /></para>
  <para style="s">स्‌तीफनुस ने धरीन ली जाय</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 6:8" />स्‌तीफनुस भगवान नी दया अने भगवान ना जोर सी भराय्‌न माणहु मे सेलाणी ना जुदा-काम, अने सेल-भात्‌या जुदा-कामु देखाड़त्‌लो। <verse eid="ACT 6:8" /><verse number="9" style="v" sid="ACT 6:9" />तीहयी टेमे युहदी माणहु ना भक्‌ती ना घोर मे गेथा थोड़ाक जणा स्‌तीफनुस ह़ाते वात मे झटा-पटी करवा बाज ज्‌या। वात मे जखड़ी पड़न्‌या मे कुरेनी वाळा अने सीकंदर्‌या वाळा अने कीलीकीया वाळा, अने आसीया वाळा हता। <verse eid="ACT 6:9" /><verse number="10" style="v" sid="ACT 6:10" />पण स्‌तीफनुस भगवान नी आत्‌मा नी अगवाय मे अने भगवान नी अक्‌कल नी अगवाय मे बोलत्‌लो एतरे तीहया स्‌तीफनुस नी वात काटी नी सक्‌या। <verse eid="ACT 6:10" /><verse number="11" style="v" sid="ACT 6:11" />एतरे तीहया पय्‌हा आपीन थोड़ाक अदमी ने आहयी झुटी गवा देवाड़्‌या, “आमु आहया स्‌तीफनुस ने मुसा नी अने भगवान नी नामबद्‌दी करत्‌लो ह़मळ्‌ळा से।” <verse eid="ACT 6:11" /><verse number="12" style="v" sid="ACT 6:12" />आसम करीन तीहया माणहु ने, अने पुडार्‌या ने अने युहदी-धरम ह़ीकाड़न्‌या ने भड़कावीन उचकाहला स्‌तीफनुस ने तां आय लाग्‌या, अने तीने धरीन मोट्‌ली बठक अगळ ली ज्‌या। <verse eid="ACT 6:12" /><verse number="13" style="v" sid="ACT 6:13" />अने तां तीहया झुटा गवा उबा कर्‌या, अने तीहया झुटी गवा देण्‌या केदा “आहयो अदमी” दाड़ीन आहया चोखला मंदीर अने मुसा नी लीखली सास्‌तर नी नामबद्‌दी करे। <verse eid="ACT 6:13" /><verse number="14" style="v" sid="ACT 6:14" />आमु ईने आहयु केतलो ह़मळ्‌ळा से, “ईसु नासरी आहया मंदीर ने ओदार देहे, अने मुसा नी आपली रीती-भाती ने बदली देहे।” <verse eid="ACT 6:14" /><verse number="15" style="v" sid="ACT 6:15" />मोट्‌ली बठक मे बहला आखा माणहु स्‌तीफनुस भणी एकडीट्‌या भाळ र्‌या हता, ता तीमने, स्‌तीफनुस नो मुख नो सीको ह़रगदुत ने तेवो देखाव पड़्‌यो।<verse eid="ACT 6:15" /></para>
  <chapter eid="ACT 6" />
  <chapter number="7" style="c" sid="ACT 7" />
  <para style="s">स्‌तीफनुस नु परच्‌यार</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 7:1" />डायलो पुंजारो स्‌तीफनुस ने पुछ्‌यो, “आहयी वात ह़ाचली से ह़ु?”<verse eid="ACT 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 7:2" />तत्‌यार स्‌तीफनुस केदो, ए डाह-डाहा अने भायु! मारी वात ह़मळो। जत्‌यार अमारो बाह अब्‌राहम, हारान मे वहवा सी पेले मीसुपुताम्‌या मे रेतो हतो, ता तीने ह़ेक भर्‌यो भगवान देखाव पड़्‌यो, <verse eid="ACT 7:2" /><verse number="3" style="v" sid="ACT 7:3" />अने केदो, तारु देस अने तारु घोराणु सोड़ दे, अने तीहया देस मे जा, जे देस मे तने देखाड़ही। <verse eid="ACT 7:3" /><verse number="4" style="v" sid="ACT 7:4" />एतरे अब्‌राहम कसद्‌यान देस सोड़ीन हारान मे वही ज्‌यो। तीनो बाह मर ज्‌यो अने अळतेण भगवान तीने तां गेथो आहया देस मे लायो, जा तमु हमणे री र्‌या। <verse eid="ACT 7:4" /><verse number="5" style="v" sid="ACT 7:5" />आहया देस मे भगवान तीने कानी जागा नी आप्‌यो, आञे लग के पोग मेलवा करीन बी जागो नी आप्‌यो। बाखीन तीहयो वायदो कर्‌यो के मे आहयु देस तने अने अळतेण तारी अवल्‌यात ने आपही तीहयी टेमे अब्‌राहम नो एक बी सोरो नी हतो। <verse eid="ACT 7:5" /><verse number="6" style="v" sid="ACT 7:6" />भगवान अब्‌राहम ने आहयु बी केदो, तारी अवल्‌यात नी अवल्‌यात पारका देस मे पारकान तेम रेहे। अने तीहया तीने पावर्‌यो बणावहे, अने च्‌यार ह़ोव साल लग वेला पाड़हे। <verse eid="ACT 7:6" /><verse number="7" style="v" sid="ACT 7:7" />अळी भगवान केदो, जोर जबराये काम करावीन वेला पाड़न्‌या आड़जात्‌या माणहु ने, मे नीयाव करीन डंड आपही, अने अळतेण काम करन्‌या ने तीना देस गेथो नीकाळ लावही अने आहयात जागा मे मारी भक्‌ती करीन सेवा करहे। <verse eid="ACT 7:7" /><verse number="8" style="v" sid="ACT 7:8" />अने भगवान अब्‌राहम जुगु खतना नी बोली कर्‌यो; अने आसम करीन तीहयो ईसाक नो बाह बण्‌यो अने आंठवा दाड़े तीनु खतनु कर्‌या। ईसाक, याकुब नो बाह बण्‌यो, अने याकुब बारे कुल धणी नो बाह बण्‌यो।<verse eid="ACT 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 7:9" />कुल धण्‌या, युसुफ पोर कुहरायत्‌ला, एतरे तीहया युसुफ ने मीसर देस जाण्‌या वेपारी ने वेच देदा; पण भगवान युसुफ ह़ाते हतो। <verse eid="ACT 7:9" /><verse number="10" style="v" sid="ACT 7:10" />तीहयो आखी गरा गेथो युसुफ ने बचाड़्‌यो। अने भगवान युसुफ ने मीसर ना राजा फीरोन अगळ दया अने अक्‌कल आप्‌यो; अने तीहयो राजा युसुफ ने आह़फा ना घोरबार नो हकदार्‌यो बणाय देदो। <verse eid="ACT 7:10" /><verse number="11" style="v" sid="ACT 7:11" />तत्‌यार मीसर देस अने कनान देस मे काळ पड़्‌यो; अने भारी गरा आवी, अने आपणा आड़ा-बुड़ा ने खावा करीन अन नी जड़्‌यु। <verse eid="ACT 7:11" /><verse number="12" style="v" sid="ACT 7:12" />जत्‌यार याकुब आहयु ह़मळ्‌यो के मीसर देस मे अन जड़े, ता तीहयो अमारा आड़ा-बुड़ा ने पेली कावा मोकल्‌यो। <verse eid="ACT 7:12" /><verse number="13" style="v" sid="ACT 7:13" />अने तीहया बीजी कावा तां मीसर मे ज्‌या, ता युसुफ आह़फा ना भाय ने आह़फा नी ओळखाण करायो, अने फीरोन ने बी युसुफ नी कुळी नो पतो चाल्‌यो। <verse eid="ACT 7:13" /><verse number="14" style="v" sid="ACT 7:14" />तत्‌यार युसुफ आह़फा ना बाह याकुब अने तीना आखा घोरबाल्‌या ने बोलाव्‌वा मोलक्‌यो। तीहया आखा मेळीन पीचोतर माणहु हता। <verse eid="ACT 7:14" /><verse number="15" style="v" sid="ACT 7:15" />याकुब मीसर देस हेटो ज्‌यो। ता तीहयो अने तीना सोरा बी मर ज्‌या। <verse eid="ACT 7:15" /><verse number="16" style="v" sid="ACT 7:16" />अळतेण तीमना धोड़ सकेम मे लाया, अने तीहया मड़ाट्‌या मे वगे कर्‌या, जां अब्‌राहम सकेम मे हामोर ना बेटा पांह चांदी आपीन वेचातु लेदलो।<verse eid="ACT 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 7:17" />भगवान अब्‌राहम ह़ाते जे वायदो करलो हतो, तीहयो वायदो पुरो हयवा नी टेम ह़ाते आय री हती, ता आपणा माणहु मीसर मे घण-जबर हय ज्‌या। <verse eid="ACT 7:17" /><verse number="18" style="v" sid="ACT 7:18" />अळतेण मीसर मे एक नवलो राजा पयदा हयो, तीहयो युसुफ ना बारा मे कंय नी जाणतो हतो। <verse eid="ACT 7:18" /><verse number="19" style="v" sid="ACT 7:19" />तीहयो आपणी जाती ना माणहु ने वेला पाड़्‌यो। एतरे आपणा आड़ा-बुड़ा ने आपणा सोरा ने मरवा करीन बारा नाखवा पड़्‌या <verse eid="ACT 7:19" /><verse number="20" style="v" sid="ACT 7:20" />तीहयी टेमे मुसो पयदा हयो। भगवान तीने घण घटाळो घड़लो हतो, अने तीन मयना लग तीना बाह ना घोर मे पोहायो। <verse eid="ACT 7:20" /><verse number="21" style="v" sid="ACT 7:21" />अने जत्‌यार सोरु ने बारा नंदी मे नाख देदा, ता फीरोन राजा नी बेटी तीने चुट लेदी, अने तीने आह़फी ना सोरान तेम पाळी-पोही। <verse eid="ACT 7:21" /><verse number="22" style="v" sid="ACT 7:22" />अने मुसा ने मीसर देस नी आखी वीद्‌या भणाया। अने मुसो वात मे अने काम मे जोरभर्‌यो बण ज्‌यो।<verse eid="ACT 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 7:23" />जत्‌यार मुसो चाळीह साल नो हय ज्‌यो, ता तीना मन मे वीच्‌यार आयो के मे मारा ईस्‌रायली भाय-बेन्‌या ने भेटु। <verse eid="ACT 7:23" /><verse number="24" style="v" sid="ACT 7:24" />तीमनी मे गेथा एक जणा ने वेला पाड़त्‌लो देखीन मुसो तीनी वगो वळ्‌यो, अने मीसर देस वाळा ने मारीन वेला पाड़वा नो बदलो लेदो। <verse eid="ACT 7:24" /><verse number="25" style="v" sid="ACT 7:25" />मुसा नो वीच्‌यार आहयो हतो के मारा माणहु ह़मजी जहे के भगवान आनी लारे आमने छुटकारो आपहे बाखीन तीहया तेम नी ह़मज्‌या। <verse eid="ACT 7:25" /><verse number="26" style="v" sid="ACT 7:26" />बीजा दाड़े बे ईस्‌रायली भाय-बेटा ने झुमायत्‌ला देख्‌यो, ता तीहयो तीमनीन्‌तां आवीन तीमने मेळ कराव्‌वा करीन तीमने केदो, ए भायु, तमु ते भाय-बेटा से, तमु काहा आंबा-सांबा झुमाय्‌न एक-बीजा ह़ाते गलत वेहवार कर र्‌या? <verse eid="ACT 7:26" /><verse number="27" style="v" sid="ACT 7:27" />पण आहयो अदमी आह़फा ना भाय-बेटा ह़ाते झुमाय्‌न गलत वेहवार कर र्‌यो, तीहयो मुसा ने धकली देदो, अने केदो, कोय तने अमारो मुखी अने नीयाव करन्‌यो बणावलु से? <verse eid="ACT 7:27" /><verse number="28" style="v" sid="ACT 7:28" />काले ते, तु मीसर देस वाळा ने मार नाख्‌यो। तेमेत मने बी मारवा हींड र्‌यो ह़ु? <verse eid="ACT 7:28" /><verse number="29" style="v" sid="ACT 7:29" />आहयी वात ह़मळीन मुसो तां गेथो नाह ज्‌यो अने मीद्‌यान देस मे पारको बणीन रेवा बाज ज्‌यो। अने तीहया मीद्‌यान देस मे तीना बे सोरा हया।<verse eid="ACT 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 7:30" />जत्‌यार तां रेते-रेते चाळीह साल वीत ज्‌या, ता भगवान नो ह़रगदुत, सीने बड़ा पोर एक धपत्‌ला कटाळा झाटवा मे देखाव पड़्‌यो। <verse eid="ACT 7:30" /><verse number="31" style="v" sid="ACT 7:31" />आहयु देखीन मुसो वहराय ज्‌यो, अने धपत्‌ला झाटवा ने देखवा करीन ह़ाते ज्‌यो, ता तीहयो मालीक भगवान ने आहयु केत्‌लो ह़मळ्‌यो, <verse eid="ACT 7:31" /><verse number="32" style="v" sid="ACT 7:32" />मे तारा आड़ा-बुड़ा नो भगवान से, हाव, अब्‌राहम नो, अने ईसाक नो, अने याकुब नो भगवान से। आहयु ह़मळीन मुसो थुरु-थुरु कापवा बाज ज्‌यो अने तीने तीहयु धपत्‌लु झाटवु अळी देखवा नु मन नी हयु। <verse eid="ACT 7:32" /><verse number="33" style="v" sid="ACT 7:33" />तत्‌यार मालीक भगवान मुसा ने आहयु केदो, तु तारा पोग मे पेरला चाट्‌या नीकाळ दे, काहाके तु जां उबो हय र्‌यो, तीहयो जागो चोखलो से। <verse eid="ACT 7:33" /><verse number="34" style="v" sid="ACT 7:34" />मे मीसर देस मे रेण्‌या मारा माणहु नी वेला ने देखलो से; अने तीमनु कंजारणु अने रड़णु ह़मळ्‌ळो से; एतरे मे तीमने छोड़ाव्‌वा करीन उतरीन आवलो से। हाव तीयार हय जा मे तने मीसर देस मे मोकलही।<verse eid="ACT 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 7:35" />तीहया मुसा ने माणहु आहयु केता जाय्‌न तीनो नीकारो करला, कोय तने अमारो मुखी अने सोड़ाव्‌वा वाळो बणावलु से? तीहयात मुसा ने भगवान मुखी अने नीयाव करन्‌यो बणावीन तीहया ह़रगदुत ना लारे तीमनीन्‌तां मोकल्‌यो, जे तीने धपत्‌ला कटाळा झाटवा मे देखाव पड़लो। <verse eid="ACT 7:35" /><verse number="36" style="v" sid="ACT 7:36" />तीहयोत मुसा तीमने मीसर देस मे अने रात्‌ला दर्‌या मे अने जंगल मे चाळीह साल लग सेल-भात्‌या जुदा-काम अने सेलाण्‌या देखाड़ीन तीमने नीकाळ लायो। <verse eid="ACT 7:36" /><verse number="37" style="v" sid="ACT 7:37" />आहयो तीहयोत मुसा से, जे ईस्‌रायली माणहु ने आहयु केदो, भगवान तमारात भायु मे गेथो तमारी जुगु मार ह़रको एक भगवान वगे गेथी वात केण्‌यो माणेह उबो करहे। <verse eid="ACT 7:37" /><verse number="38" style="v" sid="ACT 7:38" />मुसो जंगल मे आपणा माणहु नी मंडळी वगो उबो हय्‌न आपणा आड़ा-बुड़ा अने तीहया भगवान ना ह़रगदुत ना वच मे भांजड़्‌यो बण्‌यो, जे सीने बड़ा पोर तीनी ह़ाते वाते लाग्‌यो। तीने जीवत्‌ला भगवान नी बोली जड़ी, तीनी सी तीहयो तीहयी भगवान नी बोली आपणु ने ह़मळावे तेम।<verse eid="ACT 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 7:39" />बाखीन आपणा आड़ा-बुड़ा तीनी वात मानवा नी हींड्‌या; अने तीहया मुसा नी वात ने टाळ देदा। अने मीसर देस भणी आह़फा नु मन लगाड़्‌या। <verse eid="ACT 7:39" /><verse number="40" style="v" sid="ACT 7:40" />अने तीहया हारुन ने केदा, अमारी जुगु एवो देवता बणाव, जे अमारी अगळ-अगळ चाले तेम; काहाके मुसो आमने मीसर देस गेथो काडीन लावलो, तीनु ह़ु हयु अने ह़ु नी जाणे आमने मालम नी हय? <verse eid="ACT 7:40" /><verse number="41" style="v" sid="ACT 7:41" />तीहया दाड़ा मे तीहया केड़ा नी मुर्‌ती बणावीन तीनी अगळ जानवर मारीन बादा चड़ाया; अने तीनी पुजा-पाट कर्‌या; अने तीहया हात सी बणावली मुर्‌ती नो तीवार वाळीन खुस हय ज्‌या। <verse eid="ACT 7:41" /><verse number="42" style="v" sid="ACT 7:42" />एतरे भगवान तीमनी गेथो आडो भाळ लेदो,</para>
  <para style="q1" vid="ACT 7:42">अने तीहयो तीमने ह़रग ना तारा नी भक्‌ती कराव्‌वा करीन रेवा देदो, जीसम भगवान भणी गेथी वात केण्‌या माणहु नी कीताप मे बी लीखलु से:</para>
  <para style="q2" vid="ACT 7:42">ए ईस्‌रायली माणहु ना घोराणा,</para>
  <para style="q2" vid="ACT 7:42">तमु चाळीह साल लग मारी पुजा-पाट करवा करीन नेत जानवरु मारीन बादा चड़ावला ह़ु?<verse eid="ACT 7:42" /></para>
  <para style="q1">
    <verse number="43" style="v" sid="ACT 7:43" />तमु मोलेक देवता नु तम्‌बु ने अने रेफान देवता</para>
  <para style="q2" vid="ACT 7:43">ना तारा ने आह़फाम नी खांद पोर उचलीन लीजला,</para>
  <para style="q2" vid="ACT 7:43">अने तमु तीहयी मुरत्‌या ने बी ह़ाते लीजला तीमने पुजवा अने वांदवा करीन बणावला हता।</para>
  <para style="q2" vid="ACT 7:43">एतरे मे तमने बेबीलोन मुलक गेथा बी नाम्‌बे मोकल देही।<verse eid="ACT 7:43" /></para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 7:44" />जंगल मे अमारा आड़ा-बुड़ा पांह गवा ना तम्‌बु हता। भगवान मुसा ने आहया तम्‌बु ना बारा मे आहयो हुकम आपलो हतो, मे जे तम्‌बु नी सेलाणी तने देखाड़लो से, तीहयी सेलाणी नी अनसारे तम्‌बु बणावजे। <verse eid="ACT 7:44" /><verse number="45" style="v" sid="ACT 7:45" />तीहया तम्‌बु ने अगली पीड़ी ना आपणा आड़ा-बुड़ा यहोसु नी अगवाय मे आञे ली आया। जे टेमे तीहया आड़जात्‌या पांह आहयी धरती हापकी लेदला, काहाके भगवान आड़जात्‌या ने आपणा आड़ा-बुड़ा अगळ गेथु नीकाळ देदलु; अने आसम करीन तीहयु तम्‌बु दावुद नी टेमे लग आपणा आड़ा-बुड़ा ना ह़ात मे र्‌यु। <verse eid="ACT 7:45" /><verse number="46" style="v" sid="ACT 7:46" />आहया दावुद पोर भगवान दया कर्‌यो, अने दावुद आहयी हेर कर्‌यो के मे याकुब ना भगवान जुगु एक रेवा नो जागो बणावही। <verse eid="ACT 7:46" /><verse number="47" style="v" sid="ACT 7:47" />बाखीन सुलेमान याकुब ना भगवान जुगु घोर बणायो।<verse eid="ACT 7:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 7:48" />ते बी आखाम उचे रेण्‌या भगवान, माणेह ना लारे बणावला घोर मे नी रेय, जीसम भगवान वगे गेथी वात केण्‌यो माणेह केय,<verse eid="ACT 7:48" /></para>
  <para style="q1">
    <verse number="49" style="v" sid="ACT 7:49" />ह़रग मारी राजगादी से, अने</para>
  <para style="q2" vid="ACT 7:49">धरती मारी पोग नी पयड़ी से,</para>
  <para style="q1" vid="ACT 7:49">तमु मारी जुगु केवो मंदीर बणावहु? मालीक पुसे,</para>
  <para style="q2" vid="ACT 7:49">मारी जुगु अराम करवा नो एसवो कानो जागो से, तां मे अराम करु?<verse eid="ACT 7:49" /></para>
  <para style="q1">
    <verse number="50" style="v" sid="ACT 7:50" />ह़ु आहयु आखु मारा हात सी बणावलु नी हय ह़ु?<verse eid="ACT 7:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="ACT 7:51" />“ए एकहेट्‌या, अने मन अने कान्‌टा ना चोखा नी करला माणहु, तमु जलम चोखली आत्‌मा नो वीरोद करे। जेम तमारा आड़ा-बुड़ा करता हता, तेमेत तमु बी कर र्‌या। <verse eid="ACT 7:51" /><verse number="52" style="v" sid="ACT 7:52" />तमारा आड़ा-बुड़ा काना भगवान वगे गेथी वात केण्‌या माणेह ने वेला नी पाड़्‌या? पण तीहया ते तीमने मार नाख्‌या, जे पेले गेथात तीहया धरमी माणेह ना बारा मे केता हता, जे आव्‌वा वाळो हतो। <verse eid="ACT 7:52" /><verse number="53" style="v" sid="ACT 7:53" />तमने ह़रगदुत ना लारे पुगाड़लो कायदो ते जड़्‌यो, पण तमु तीहया कायदा ने पाळ्‌या नी।”<verse eid="ACT 7:53" /></para>
  <para style="s">स्‌तीफनुस ने दगड़ाटवा</para>
  <para style="p">
    <verse number="54" style="v" sid="ACT 7:54" />तीहया स्‌तीफनुस नी वात ह़मळीन घण-जबर रीहवाय ज्‌या, अने तीनी पोर दात ककड़ाव्‌वा बाज ज्‌या। <verse eid="ACT 7:54" /><verse number="55" style="v" sid="ACT 7:55" />पण स्‌तीफनुस चोखली आत्‌मा मे पुरोन-पुरो भराय्‌न ह़रग भणी एकडीट्‌यु भाळ्‌यो, अने भगवान नी बड़ाय ने अने ईसु मसी ने भगवान नी जमणी धेड़े उबो हय रेलो देख्‌यो। <verse eid="ACT 7:55" /><verse number="56" style="v" sid="ACT 7:56" />अने तीहयो की पड़्‌यो, “ह़मळो! मे ह़रग ने उगड़लु, अने मनख्‌या ना बेटा ने भगवान नी जमणी धेड़े बह रेलो देख र्‌यो।”<note caller="+" style="x"><char style="xo" closed="false">7:56 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानीयल 7:13</ref></char></note><verse eid="ACT 7:56" /></para>
  <para style="s">स्‌तीफनुस नु मरनु</para>
  <para style="p">
    <verse number="57" style="v" sid="ACT 7:57" />तीनी वात ह़मळीन तीहया तीमना कान्‌टा बुज लेदा, अने आखा एक्‌को करीन तीनी भणी हुहड़ीन आया। <verse eid="ACT 7:57" /><verse number="58" style="v" sid="ACT 7:58" />अने तीने ह़ेर मे गेथा बारा ली ज्‌या, अने गवा देण्‌या माणहु आह़फा ना लुगड़ा नीकाळीन साउल नाम ना जुवान माणेह अगळ मेल देदा। अने तीहया माणहु स्‌तीफनुस ने दगड़ाट्‌या। <verse eid="ACT 7:58" /><verse number="59" style="v" sid="ACT 7:59" />तीहया माणहु स्‌तीफनुस ने दगड़ाटता र्‌या, अने तीहयो आसम करीन वीन्‌ती कर्‌यो, “मालीक ईसु! मारी आत्‌मा ने आवरी ले।” <verse eid="ACT 7:59" /><verse number="60" style="v" sid="ACT 7:60" />ता तीहयो मांडा ना भरहे पड़ ज्‌यो, अने आड़्‌यो, “मालीक! आहया पाप ईमनी पोर नी लगाड़जे।” अने आहयु कीन तीहयो मर ज्‌यो।<verse eid="ACT 7:60" /></para>
  <chapter eid="ACT 7" />
  <chapter number="8" style="c" sid="ACT 8" />
  <para style="s">ईसु नी मंडळी ने वेला पाड़े</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 8:1" />साउल तीने मारवा मे राजी हतो। तीहया दाड़े गेथा माणहु यरुसलेम मे वाळी ईसु नी मंडळी ने घण-जबर वेला पाड़वा सुरु कर देदा, अने ईसु ना नेवताळा ने सोड़ीन आखान-आखा युहद्‌या जीला मे अने सामर्‌या जीला मे वेरवाय ज्‌या। <verse eid="ACT 8:1" /><verse number="2" style="v" sid="ACT 8:2" />ईसु ना भगत माणहु स्‌तीफनुस ना धोड़ ने घण-जबर फुकु-फुकु रड़ता जाय्‌न वगे कर देदा।<verse eid="ACT 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 8:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:3 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 22:4">नेवताळा ना काम 22:4</ref>,<ref loc="ACT 22:5">5</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char>
    </note>साउल तीहयी टेमे ईसु नी मंडळी ने वेला पाड़ र्‌यो हतो; अने तीहयो ईसु ना आखा माणहु ना घोरु-घोरु मे जाय्‌न अदमड़ा ने अने बयरा ने घीहड़ीन लावीन जेल मे घाल देतो हतो।<verse eid="ACT 8:3" /></para>
  <para style="s">सामर्‌या मे फीलीपुस नु परच्‌यार</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 8:4" />जे भरहो करन्‌या माणहु रीवण्‌या-तीवण्‌या हय जेला तीहया हींडी-हींडीन ईसु नी खुस-खबर ह़मळवा बाज ज्‌या। <verse eid="ACT 8:4" /><verse number="5" style="v" sid="ACT 8:5" />अने फीलीपुस, सामर्‌या ह़ेर मे हेटो जाय्‌न तां ईसु मसी नु परच्‌यार करवा बाज ज्‌यो। <verse eid="ACT 8:5" /><verse number="6" style="v" sid="ACT 8:6" />माणहु फीलीपुस नी वात ह़मळीन अने तीना हाते हयला जुदा-काम नी सेलाणी देखीन, एक-मन्‌या हय्‌न घण-जबर मन लगाड़्‌या। <verse eid="ACT 8:6" /><verse number="7" style="v" sid="ACT 8:7" />काहाके ढेरेत मे गेथा वीटळ्‌ळा भुत आड़ीन नीकळ जेला, अने ढेरेत लखवा नी मंदवाड़ वाळा अने लंगड़ा आरगा हय जेला। <verse eid="ACT 8:7" /><verse number="8" style="v" sid="ACT 8:8" />एतरे तीहया ह़ेर मे घणी खुसी हय जी।<verse eid="ACT 8:8" /></para>
  <para style="s">जादु-वीद्‌या देखाड़न्‌यो सीमोन</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 8:9" />सीमोन नाम नो एक अदमी फीलीपुस गेथो पेले आहया ह़ेर मे आय र्‌यो हतो। तीहयो जादु-टोणा देखाड़ीन सामर्‌या ह़ेर वाळा ने वहराड़ र्‌यो हतो, अने आह़फा ने घणो मोटो माणेह देखाड़तो हतो। <verse eid="ACT 8:9" /><verse number="10" style="v" sid="ACT 8:10" />नान्‌ला गेथा मोट्‌ला लग आखा माणहु तीनी ईज्‌जत करता हता, अने केता हता, “आहयो माणेह भगवान नी तीहयी सक्‌ती से जे घण भारी केवाय।” <verse eid="ACT 8:10" /><verse number="11" style="v" sid="ACT 8:11" />तीहयो ढेरेत दाड़ा गेथो जादु नो खेल खेलीन आखा ने वहराड़ र्‌यो हतो, एतरे आखा माणहु तीने घण-जबर मानत्‌ला। <verse eid="ACT 8:11" /><verse number="12" style="v" sid="ACT 8:12" />बाखीन जत्‌यार तीहया माणहु फीलीपुस ना लारे भगवान ना राज नी खुस-खबर अने ईसु मसी नु नाम ह़मळ्‌या, ईसु पोर भरहो कर्‌या अने बयरा अने अदमड़ा बपतीस्‌मा लेवा बाज ज्‌या। <verse eid="ACT 8:12" /><verse number="13" style="v" sid="ACT 8:13" />अने सीमोन बी ईसु पोर भरहो कर्‌यो अने बपतीस्‌मा ली लेदो अने अळतेण फीलीपुस ह़ाते रेवा बाज ज्‌यो। अने फीलीपुस ना लारे जुदा-काम नी सेलाण्‌या अने जुदा-कामु देख्‌यो, ता वहराय ज्‌यो।<verse eid="ACT 8:13" /></para>
  <para style="s">सामर्‌या मे पतरस अने युहन्‌ना</para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 8:14" />जत्‌यार यरुसलेम मे रेण्‌या ईसु ना नेवताळा आहयु ह़मळ्‌या के सामर्‌या वाळा भगवान ना बोल ने मान लेदा, ता तीहया पतरस अने युहन्‌ना ने तीमनीन्‌तां मोकल्‌या। <verse eid="ACT 8:14" /><verse number="15" style="v" sid="ACT 8:15" />तीहया जाय्‌न तीमनी जुगु भगवान पांह वीन्‌ती कर्‌या के ईमने चोखली आत्‌मा जड़वा जोवे। <verse eid="ACT 8:15" /><verse number="16" style="v" sid="ACT 8:16" />काहाके हजु लग तीमने चोखली आत्‌मा नी जड़ली हती, तीमने मालीक ईसु ना नाम सी बपतीस्‌मा एतरा आपला हता। <verse eid="ACT 8:16" /><verse number="17" style="v" sid="ACT 8:17" />एतरे पतरस अने युहन्‌नो तीमनी पोर ह़ात मेक्‌या अने तीमने चोखली आत्‌मा जड़ जी।<verse eid="ACT 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 8:18" />सीमोन आहयु देख्‌यो के ईसु ना नेवताळा माणहु पोर हात मेके एतरात ने तीमने चोखली आत्‌मा जड़ जाय। एतरे तीहयो तीमनीन्‌तां रुप्‌या लावीन केदो। <verse eid="ACT 8:18" /><verse number="19" style="v" sid="ACT 8:19" />“मे जीनी पोर बी हात मेकु तीने चोखली आत्‌मा जड़ जवा जोवे, एसवो हक मने बी आपो।”<verse eid="ACT 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 8:20" />पण पतरस तीने जपाप आप्‌यो, “तारी ह़ाते तारा रुप्‌या बी खुट जवा जोवे, काहाके तु भगवान ना वाटा ने रुप्‌या आपीन हात करवा नी हेर कर्‌यो। <verse eid="ACT 8:20" /><verse number="21" style="v" sid="ACT 8:21" />आहयी वात मे तारो हीस्‌सो बी नी हय, अने हक बी नी हय। काहाके भगवान अगळ तारु मन ह़ुते नी हय। <verse eid="ACT 8:21" /><verse number="22" style="v" sid="ACT 8:22" />एतरे तु तारा मन ने पाप भणी गेथो बदलीन भगवान भणी वाळ अने मालीक ईसु सी वीन्‌ती कर। कंखर माय्‌न भगवान तारा मन ना वीच्‌यार नी माफी आप देय। <verse eid="ACT 8:22" /><verse number="23" style="v" sid="ACT 8:23" />काहाके मने चोखुझण देखाव पड़ र्‌यु के तु आखी भातीन पाप मे बंदायलो से।”<verse eid="ACT 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 8:24" />आहयी वात ह़मळीन सीमोन जपाप आप्‌यो, “तमु जे बी वात केदला से, तेम मारी ह़ाते नी हयवा जोवे, करीन तमु मालीक भगवान पांह मारी जुगु वीन्‌ती करो!”<verse eid="ACT 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 8:25" />अळतेण ईसु ना नेवताळा, मालीक ईसु नी गवाय दीन अने भगवान ना बोल ह़मळावीन यरुसलेम पासा जत र्‌या, अने वाट्‌ये-वाट्‌ये ढेरेत सामरी जीला ना गाम मे ईसु नी खुस-खबर ह़मळावता ज्‌या।<verse eid="ACT 8:25" /></para>
  <para style="s">फीलीपुस कुस देस ना मंत्‌री ने बपतीस्‌मा आपे</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 8:26" />अळतेण मालीक नो एक ह़रगदुत फीलीपुस ने केदो, “उठ, यरुसलेम गेथी गाजा ह़ेर भणी जवा वाळी वाट पोर दखणाव भणी जा।” आहयी वाट उजाड़ी बड़ा मे से। <verse eid="ACT 8:26" /><verse number="27" style="v" sid="ACT 8:27" />ह़रगदुत नी वात ह़मळीन फीलीपुस चाल पड़्‌यो। ता वाट्‌येत कुस देस नो एक माणेह जवा बाज र्‌यो हतो, तीहयो गतराड़ो हतो अने कुस देस नी कंदाके राणी नो मंत्‌री अने पय्‌हा टका नो हीसाब राखण्‌यो हतो, अने तीहयो भगवान नी पुजा-पाट करवा करीन यरुसलेम आवलो हतो, अने पुजा-पाट करीन पासो जवा बाज र्‌यो हतो। <verse eid="ACT 8:27" /><verse number="28" style="v" sid="ACT 8:28" />तीहयो आह़फा नी घोड़ागाडी पोर बह र्‌यो हतो, अने भगवान वगे गेथी वात केण्‌या यसाया नी कीताप भणवा बाज र्‌यो हतो। <verse eid="ACT 8:28" /><verse number="29" style="v" sid="ACT 8:29" />भगवान नी आत्‌मा फीलीपुस ने केदी, “अगो जा, अने घोड़ागाडी ह़ाते चाल पड़।” <verse eid="ACT 8:29" /><verse number="30" style="v" sid="ACT 8:30" />फीलीपुस दवड़ीन तीनीन्‌तां ज्‌यो अने तीहयो तीने भगवान वगे गेथी वात केण्‌या माणेह यसाया नी कीताप भणत्‌लो ह़मळ्‌यो, अने तीने पुछ्‌यो, “तु जे वात भणवा बाज र्‌यो, तीहयी वात ह़मजी र्‌यो ह़ु?”<verse eid="ACT 8:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 8:31" />तीहयो जपाप आप्‌यो, “जत्‌यार लग कोय मने नी ह़मजाड़े, तांह लग मे कीसम ह़मजु?” आहयु कीदीन तीहयो फीलीपुस ने आह़फा नी घोड़ागाडी पोर चड़ावीन बहाड़ लेदो। <verse eid="ACT 8:31" /><verse number="32" style="v" sid="ACT 8:32" />खरला सास्‌तर नो जे तोड़पो तीहयो भणवा बाज र्‌यो हतो, तीहयो तोड़पो आहयो हतो,</para>
  <para style="q1" vid="ACT 8:32">तीने गाडरान तेम मारवा ली ज्‌या,</para>
  <para style="q2" vid="ACT 8:32">अने जीसम गाडरु तीना नीम्‌बाळा वाडवा नी टेमे होगु हय रेय,</para>
  <para style="q2" vid="ACT 8:32">तेमेत तीहयो होगो हय र्‌यो अने आह़फा नु मोडु लग नी उगाड़्‌यो।<verse eid="ACT 8:32" /></para>
  <para style="q1">
    <verse number="33" style="v" sid="ACT 8:33" />तीहयो भोळो बणीन र्‌यो, पण आहयी टेमे तीनो नीयाव नी हयो,</para>
  <para style="q2" vid="ACT 8:33">अने तीहयी टेमे ना माणहु ना बारा मे कोय केहे,</para>
  <para style="q2" vid="ACT 8:33">काहाके धरती पोर गेथो तीनो जीव उचलाय ज्‌यो।<verse eid="ACT 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 8:34" />आहयी टेमे गतराड़ो फीलीपुस ने पुछ्‌यो, “तु मने दया करीन देखाड़ के भगवान वगे गेथी वात केण्‌यो माणेह आहयी वात कोयना बारा मे की र्‌यो, आह़फा ना बारा मे की र्‌यो के काना बीजा ना बारा मे की र्‌यो?” <verse eid="ACT 8:34" /><verse number="35" style="v" sid="ACT 8:35" />ता फीलीपुस आहयी खरली सास्‌तर मे गेथो सुरु करीन ईसु नी खुस-खबर ह़मळायो। <verse eid="ACT 8:35" /><verse number="36" style="v" sid="ACT 8:36" />वाट्‌ये जता-जता तीहया पाणी हतु तां पुग ज्‌या। पाणी ने देखीन खोजो केदो, “देख, ह़ेलु हयु पाणी। हाव मने बपतीस्‌मा लेवा मे ह़ु रोक से?” <verse eid="ACT 8:36" /><verse number="37" style="v" sid="ACT 8:37" />फीलीपुस केदो, कदीम तु पुरो मन लगाड़ीन भरहो करे, ता ली सके। तीहयो जपाप आप्‌यो, “होव, मे भरहो करु के ईसु मसी भगवान नो बेटो से।”<note caller="+" style="f"><char style="fr" closed="false">8:37 </char><char style="ft" closed="false">आहयो बोल आखा कीताप्‌या मे नी हय</char></note><verse eid="ACT 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 8:38" />तत्‌यार खोजो घोड़ागाडी चलाड़न्‌या ने घोड़ागाडी उबराखवा केदो, अने फीलीपुस अने खोजो बेम जणा पाणी मे भराया अने फीलीपुस तीने बपतीस्‌मा आप्‌यो। <verse eid="ACT 8:38" /><verse number="39" style="v" sid="ACT 8:39" />जत्‌यार तीहया पाणी मे गेथा बारा आया, ता मालीक भगवान नी आत्‌मा फीलीपुस ने चुट ली जी। खोजो, तीहया फीलीपुस ने अळी नी देख्‌यो; अने तीहयो खोजो खुस हय्‌न आह़फा नी वाट्‌ये अगो चाल पड़्‌यो। <verse eid="ACT 8:39" /><verse number="40" style="v" sid="ACT 8:40" />अने फीलीपुस असदोद मे देखाव पड़्‌यो, अने तीहयो जत्‌यार लग केसर्‌या नी पुग्‌यो तां लग ह़ेर-ह़ेर मे ईसु नी खुस-खबर ह़मळावतो ज्‌यो।<verse eid="ACT 8:40" /></para>
  <chapter eid="ACT 8" />
  <chapter number="9" style="c" sid="ACT 9" />
  <para style="s">साउल नो बोलावो</para>
  <para style="r">(<ref loc="ACT 22:6-16">नेवताळा ना काम 22:6-16</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 9:1" />साउल भगवान ना डायला पुंजारान तां ज्‌यो, साउल हजु बी मालीक ईसु ना चेला ने धमकी देवा अने मार नाखवा नी झींग मे पड़ र्‌यो हतो। <verse eid="ACT 9:1" /><verse number="2" style="v" sid="ACT 9:2" />अने तीहयो दमीस्‌क ह़ेर ना युहदी ना भक्‌ती ना घोर ना नामे, ईसु ने मानन्‌या अदमड़ा अने बयरा ने बांदीन यरुसलेम लाव्‌वा नो हक मांग लायो।<verse eid="ACT 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 9:3" />पण जतो-जतो साउल दमीस्‌क ह़ेर धेड़े पुग्‌यो, ता उचकाहलुत ह़रगे गेथु तीनी च्‌यारो-मेर वीजाळु भबळ्‌यु। <verse eid="ACT 9:3" /><verse number="4" style="v" sid="ACT 9:4" />तीहयो साउल धरती पोर पड़ ज्‌यो, अने तीने आसम केतलो एक बोल ह़मळायो “साउल! साउल! तु मने काहा वेला पाड़े?”<verse eid="ACT 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 9:5" />साउल केदो, “मालीक! तु कोय से?” साउल ने पासो जपाप जड़्‌यो, “मे ईसु से; जीने तु वेला पाड़ र्‌यो। <verse eid="ACT 9:5" /><verse number="6" style="v" sid="ACT 9:6" />पण हाव तु उठीन ह़ेर मे जा, अने तने जे करवा जोवे तीहयु, मे तने देखाड़ देही।”<verse eid="ACT 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 9:7" />जे माणहु साउल भेळता हता, तीहया तेमेत उबा हय्‌न देखतात र्‌या; काहाके तीहया बोली ते ह़मळता हता, बाखीन तीमने कोय बी देखाव नी पड़्‌यु। <verse eid="ACT 9:7" /><verse number="8" style="v" sid="ACT 9:8" />अळतेण साउल धरती पोर गेथो उठ्‌यो, अने डोळा उगाड़्‌यो पण तीने अमाळ बी नी देखायु। एतरे तीना ह़ाती तीनो हात धरीन तीने दमीस्‌क ह़ेर मे ली ज्‌या। <verse eid="ACT 9:8" /><verse number="9" style="v" sid="ACT 9:9" />अने तीहयो तीन दाड़ा लग आंदळो बणीन र्‌यो, अने तीहयो तीन दाड़ा लग खाणु बी नी खादो अने पाणी बी नी पीदो।<verse eid="ACT 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 9:10" />दमीस्‌क ह़ेर मे हनन्‌या! नाम नो ईसु नो एक चेलो रेतो हतो। मालीक ईसु तीने देखावा पड़ीन केदो, “ए हनन्‌या!” तीहयो हनन्‌या केदो, “होव, मालीक मे ह़मळी र्‌यो।”<verse eid="ACT 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 9:11" />ता मालीक तीहया हनन्‌या ने केदो, “उठीन, ह़ुदी नाम नी गळी मे जा, अने यहुदा ना घोर मे जाय्‌न तरसुस मे रेण्‌या साउल ना बारा मे पतो लगाड़ ले; काहाके तीहयो भगवान पांह वीन्‌ती करवा बाज र्‌यो। <verse eid="ACT 9:11" /><verse number="12" style="v" sid="ACT 9:12" />अने तीहयो आहयु देखलो से के ‘आहयो अळी पासो देखवा बाज जवा जोवे’ करीन हनन्‌या नाम नो एक अदमी मोय आवीन मारा मुंडा पोर हात मेक र्‌यो।”<verse eid="ACT 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 9:13" />हनन्‌या वात टाळतो जाय्‌न जपाप आप्‌यो, “ए मालीक! मे झाजला माणहु पांह गेथो आना बारा मे ह़मळी र्‌यो की तीहयो अदमी यरुसलेम मे तारा चोखला माणहु ने घण जुदो वेला पाड़ीन दमलो से। <verse eid="ACT 9:13" /><verse number="14" style="v" sid="ACT 9:14" />अने ‘जे माणहु तारा नाम पोर भरहो करे, तीमने आखा ने बांदीन ली आव्‌वा जोवे।’ करीन हीने भगवान ना डायला पुंजारा पांह गेथो हक जड़लो से।”<verse eid="ACT 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 9:15" />पण मालीक ईसु, हनन्‌या ने केदो, “तु जत रे! काहाके मे हीने आखा आड़जात्‌या माणहु अगळ, अने राजा अगळ, अने ईस्‌रायली जाती ना माणहु अगळ मारु नाम उजन्‌तु करवा करीन टाळलो से। <verse eid="ACT 9:15" /><verse number="16" style="v" sid="ACT 9:16" />अने मारा नामे हीने केतरा मन दुख झेलवा पड़हे, तीहयी वात मे देखाड़ही।”<verse eid="ACT 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 9:17" />ता हनन्‌या तां गेथो उठीन साउल हतो तां ज्‌यो, अने घोर मे जाय्‌न साउल पोर हात मेकीन केदो, “ए भाय साउल, तु पासो देखवा बाज जाय करीन अने चोखली आत्‌मा तार मे पुरीन-पुरी भराय जवा जोवे करीन, मालीक मतलब ईसु, मने तारीन्‌तां मोकल्‌लो से, जे तने वाट्‌ये देखावा पड़लो।” <verse eid="ACT 9:17" /><verse number="18" style="v" sid="ACT 9:18" />अने तत्‌यारुत साउल ना डोळा मे गेथा छोल्‌टान तेवा कंय पड़्‌या, अने तीहयो पासो देखवा बाज ज्‌यो अने उठीन पाणी मे बपतीस्‌मा लेदो; <verse eid="ACT 9:18" /><verse number="19" style="v" sid="ACT 9:19" />अने तीहयो साउल दमीस्‌क मे रेण्‌या ईसु ना चेला ह़ाते थोड़ाक दाड़ा र्‌यो। <verse eid="ACT 9:19" /><verse number="20" style="v" sid="ACT 9:20" />अने अळतेण तीहयो उतवाळ्‌यो युहदी माणहु ना भक्‌ती ना घोर मे जाय्‌न ईसु नु परच्‌यार आसम कीन करवा बाज ज्‌यो के “ईसुत भगवान नो बेटो से।”<verse eid="ACT 9:20" /></para>
  <para style="s">साउल दमीस्‌क मे ईसु नु परच्‌यार करे</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 9:21" />अने आखा ह़मळन्‌या वहराय्‌न केवा बाज ज्‌या, “आहयो तीहयोन-तीहयो माणेह नी हय ह़ु, जे यरुसलेम मे ईसु नु नाम लीन वीन्‌ती करन्‌या ने जलमकात खुटाड़वा नी कोसीस करतो हतो? अने हीय्‌यो आञे बी आनीन करतेत आवलो हतो के तीमने धरीन भगवान ना पुंजारान्‌तां ली जाय तेम।”<verse eid="ACT 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 9:22" />बाखीन साउल नो जोर अळी बी वदतो ज्‌यो, अने तीहयो पुरावो दी-दीन आहयु केतो हतो के ईसुत मसी से। आसम करीन तीहयो दमीस्‌क मे रेण्‌या युहदी माणहु नी बोलती बंद करतो र्‌यो।<verse eid="ACT 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 9:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:23 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 11:32">2 कुरन्‌थी 11:32</ref>,<ref loc="2CO 11:33">33</ref></char>
    </note>जत्‌यार ढेरेत दाड़ा वीत ज्‌या, ता युहदी माणहु मेळीन तीने मार नाखवा नी जाळसादी बणाया। <verse eid="ACT 9:23" /><verse number="24" style="v" sid="ACT 9:24" />बाखीन साउल ने तीमनी जाळसादी ना बारा मे पतो चाल ज्‌यो। तीहया ते साउल ने रात-दाड़ो मारवा करीन ह़ेर ना झापला पोर पेहरा दी र्‌या हता। <verse eid="ACT 9:24" /><verse number="25" style="v" sid="ACT 9:25" />पण राते साउल ना चेला साउल ने ली जाय्‌न चार्‌या मे बहाड़्‌या, अने ह़ेर ना च्‌यारो-मेर वाळा भीतड़ा पोर गेथा चार्‌या हेटा उतारीन नहाड़ देदा।<verse eid="ACT 9:25" /></para>
  <para style="s">यरुसलेम मे साउल</para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 9:26" />जत्‌यार साउल यरुसलेम पुग्‌यो, ता तीहयो ईसु ना चेला ना टोळा मे भेसकायवा कर्‌यो, पण तीहया आखा तीने देखीन बीहता हता, काहाके तीमने भरहो नी हयो के आहयो बी ईसु नो ह़ाचलीन चेलो बण जेलो से। <verse eid="ACT 9:26" /><verse number="27" style="v" sid="ACT 9:27" />पण बरनाबास, साउल ने ईसु ना नेवताळान्‌तां ली जाय्‌न तीमने केदो के, साउल ने मालीक वाट्‌ये देखाव पड़्‌यो अने तीनी ह़ाते वात करलो से, अने आहयो साउल दमीस्‌क ह़ेर मे बीह्‌या वगर ईसु ना नाम नो परच्‌यार करलो से। <verse eid="ACT 9:27" /><verse number="28" style="v" sid="ACT 9:28" />अळतेण साउल यरुसलेम मे चेलान्‌तां आवतो-जतो र्‌यो, अने तीहयो बीह्‌या वगर मालीक ना नाम नु परच्‌यार करतो र्‌यो। <verse eid="ACT 9:28" /><verse number="29" style="v" sid="ACT 9:29" />अने तीहयो ईब्‌रानी बोली बोलन्‌या युहदी ह़ाते वात मे जखड़ी पड़ र्‌यो; पण तीहया तीने मार नाखवा नी कोसीस कर्‌या। <verse eid="ACT 9:29" /><verse number="30" style="v" sid="ACT 9:30" />जत्‌यार साउल ना भाय-बेटा ने पतो चाल्‌यो ता तीहया तीने केसर्‌या ह़ेर मे लीत्‌ती र्‌या अने अळतेण तीने तरसुस मोकली देदा।<verse eid="ACT 9:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 9:31" />तीहयी टेमे आखा युहद्‌या जीला मे, अने गलील जीला मे, अने सामर्‌या जीला मे ईसु नी मंडळी ने सुक-सांती जड़ी, अने ईसु नी मंडळी मे नवला माणहु जोड़ायता ज्‌या; अने तीहयी मंडळी मालीक ईसु नी बीक मे अने चोखली आत्‌मा मे वदती जती हती।<verse eid="ACT 9:31" /></para>
  <para style="s">लुद्‌दा अने याफा मे पतरस ना काम</para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 9:32" />पतरस तीहया आखा परगणा मे फीरी-फीरीन, लुद्‌दा मे भगवान ना चोखला माणहु ने भेटवा ज्‌यो। <verse eid="ACT 9:32" /><verse number="33" style="v" sid="ACT 9:33" />तां तीने एनीयास नाम नो एक माणेह भेट्‌यो, तीहयो आंठ साल लग गोदड़ा मे पड़ र्‌यो हतो। काहाके तीने लखवो दुख हात लाग रेलो। <verse eid="ACT 9:33" /><verse number="34" style="v" sid="ACT 9:34" />पतरस तीने केदो, “एनीयास! ईसु मसी तने आरगो करे। उठ अने तारु गोदड़ु उचल।” अने तीहयो तत्‌यारुत उठीन उबो हय ज्‌यो। <verse eid="ACT 9:34" /><verse number="35" style="v" sid="ACT 9:35" />अने अळतेण लुद्‌दा अने सारोन मे रेण्‌या माणहु तीहया आरगो हयला माणेह ने देख्‌या अने तीहया मालीक ईसु पोर भरहो करीन मान लेदा।<verse eid="ACT 9:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 9:36" />याफा मे तबीता मतलब दोरकास नाम नी ईसु नी एक चेली रेती हती। तीहयी घण-जबर बीजा नी भलाय करत्‌ली अने गरीब ने दान आप्‌या करत्‌ली। <verse eid="ACT 9:36" /><verse number="37" style="v" sid="ACT 9:37" />तीहया दाड़ा मे तीहयी मांदी पड़ी अने मर जी; अने माणहु तीना धोड़ ने उंगळावीन उपरी पोर वाळा कमरा मे ली जाय्‌न मेल देदा। <verse eid="ACT 9:37" /><verse number="38" style="v" sid="ACT 9:38" />लुद्‌दा याफा गेथु नाम्‌बे नी हतु, एतरे चेला आहयु ह़मळ्‌या के पतरस याफा मे से ता तीहया बे अदमी ने मोकलीन तीने आहयी वीन्‌ती कर्‌या के “तु छोटो अमारीन्‌तां आव, अने वार ना लगाड़े।” <verse eid="ACT 9:38" /><verse number="39" style="v" sid="ACT 9:39" />पतरस तत्‌यारुत तीमनी ह़ाते चाल पड़्‌यो अने जत्‌यार तीहयो याफा मे पुग्‌यो, ता माणहु तीने उपरी पोर ली ज्‌या; अने आखा रंडायला बयरा रड़ता जाय्‌न तीनी च्‌यारो-मेर उबा हय ज्‌या; अने जे डगला अने लुगड़ा दोरकास तीमनी ह़ाते रीन बणावली हती, तीहया डगला अने लुगड़ा देखाड़वा बाज ज्‌या। <verse eid="ACT 9:39" /><verse number="40" style="v" sid="ACT 9:40" />ता पतरस आखा ने बारो मोकली देदो, अने मांडा टेकीन भगवान पांह वीन्‌ती कर्‌यो; अने धोड़ भणी फीरीन भाळीन केदो, “ए तबीता उठ।” तत्‌यार तीहयी आह़फी ना डोळा उगाड़ देदी, अने पतरस ने देखीन उठीन बह जी। <verse eid="ACT 9:40" /><verse number="41" style="v" sid="ACT 9:41" />पतरस तीने ह़ात धरीन उठाड़्‌यो, अने चोखला माणहु ने अने रंडायला बयरा ने बोलावीन तीने जीवती जागती तीमनी अगळ उबी कर देदो। <verse eid="ACT 9:41" /><verse number="42" style="v" sid="ACT 9:42" />आहयी वात आखा याफा मे फेल जी, अने ढेरेत माणहु मालीक ईसु पोर भरहो कर्‌या। <verse eid="ACT 9:42" /><verse number="43" style="v" sid="ACT 9:43" />अने पतरस थोड़ाक दाड़ा लग याफा मे सीमोन नाम ना एक चमायड़ान तां र्‌यो।<verse eid="ACT 9:43" /></para>
  <chapter eid="ACT 9" />
  <chapter number="10" style="c" sid="ACT 10" />
  <para style="s">कुरनेलीयुस अने पतरस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 10:1" />केसर्‌या ह़ेर मे कुरनेलीयुस नाम नो एक माणेह हतो, तीहयो एक ईतालीयानी नाम ना सीपायड़ा ना एक टोळा नो सुबेदार हतो। <verse eid="ACT 10:1" /><verse number="2" style="v" sid="ACT 10:2" />तीहयो सुबेदार भगवान नो भगत हतो, अने आह़फा ना घोराणा भेळतो भगवान नी बीक मान्‌तो हतो, अने युहदी माणहु ने घण-जबर दान आप्‌तो हतो, अने दाड़ीक भगवान सी वीन्‌ती कर्‌या करतो हतो। <verse eid="ACT 10:2" /><verse number="3" style="v" sid="ACT 10:3" />तीहयो तोपीवळे तीनेक बजे हेम आहयु उजन्‌तु देख्‌यो के भगवान नो ह़रगदुत तीनीन्‌तां आय्‌न आहयु केतलो ह़मळ्‌यो “ए कुरनेलीयुस।”<verse eid="ACT 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 10:4" />कुरनेलीयुस तीनी भणी एकडीट्‌यो भाळ्‌यो; अने बीहीन केदो, “ए मालीक ह़ु वात से?” ह़रगदुत केदो, “तारी वीन्‌ती अने दान, भगवान ने तां पुग जेलु से अने तीहयो तने फोम करलो से। <verse eid="ACT 10:4" /><verse number="5" style="v" sid="ACT 10:5" />एतरे हाव तु अदमड़ा ने याफा ह़ेर मे मोकलीन सीमोन ने आञे बोलाय ले, जे पतरस केवाये। <verse eid="ACT 10:5" /><verse number="6" style="v" sid="ACT 10:6" />तीहयो सीमोन, एक चमायड़ान्‌तां पोरणो से। तीनु घोर दर्‌या धेड़े से।” <verse eid="ACT 10:6" /><verse number="7" style="v" sid="ACT 10:7" />अने तीहयो ह़रगदुत तां गेथो जत र्‌यो, ता कुरनेलीयुस आह़फा ना बे पावर्‌या ने जे तीनी ह़ाते रेत्‌ला, अने एक भगत सीपायड़ु ने बोलायो, <verse eid="ACT 10:7" /><verse number="8" style="v" sid="ACT 10:8" />अने तीमने आखी वात ह़मजाड़ीन याफा ह़ेर मे मोकल्‌यो।<verse eid="ACT 10:8" /></para>
  <para style="s">पतरस नो दरसन</para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 10:9" />बीजा दाड़े तीहया चालता-चालता ह़ेर ह़ाते पुग ज्‌या, ता पतरस तोपीक वळे हेम घोर नी छत पोर वीन्‌ती करवा बाज ज्‌यो। <verse eid="ACT 10:9" /><verse number="10" style="v" sid="ACT 10:10" />तत्‌यार तीने भुक लागी, अने तीहयो खावा नो वीच्‌यार कर्‌यो; पण बीजा खाणु रांदवात बाज र्‌या हता; तत्‌यार पतरस बेह़ुद हय ज्‌यो। <verse eid="ACT 10:10" /><verse number="11" style="v" sid="ACT 10:11" />अने जत्‌यार तीहयो देख्‌यो के ह़रग उगड़ी जेलु से, अने एक मोट्‌लु चादरान तेवी कानी चीज ह़रगे गेथी अथराय्‌न उतरवा बाज री अने तीना च्‌यारोव खुणा धरती पोर मेकाय र्‌या। <verse eid="ACT 10:11" /><verse number="12" style="v" sid="ACT 10:12" />अने तीहयी चीज मे धरती ना आखा भाती ना चयारपोग्‌या जानवरु, अने घीहाय्‌न चालन्‌या जानवर, अने ह़रग ना चड़ा से। <verse eid="ACT 10:12" /><verse number="13" style="v" sid="ACT 10:13" />अने तीने एक बोली ह़मळायी के “ए पतरस उठ, अने ईमने मारीन खा।”<verse eid="ACT 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 10:14" />पण पतरस केदो, “ए मालीक! मे ईमने कदी नी मारीन खाम। काहाके मे, मोयाळ्‌ळी अने वीटळ्‌ळी चीज हजु लग नी खादो।”<verse eid="ACT 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 10:15" />ते बी तीहयी बोली बीजी कावा अळी तीने ह़मळायी, “भगवान जे चीज ने चोखली केदलो से, ते चीज ने तु वीटळ्‌ळी नी केजे।” <verse eid="ACT 10:15" /><verse number="16" style="v" sid="ACT 10:16" />आसम तीन कावा हयु; अने अळतेण तीहयी चादरा ह़रकी चीज ह़रग मे पासी उचलाय जी।<verse eid="ACT 10:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 10:17" />अने पतरस जे देखलो हतो, तीहयी वात पोर वीच्‌यारेत करवा बाज र्‌यो हतो, ता कुरनेलीयुस जे माणहु ने मोकल्‌लो हतो, तीहया माणहु सीमोन ना घोर ना झापला पोर आवीन सीमोन नु घोर कां से? करीन पुछ र्‌या हता। <verse eid="ACT 10:17" /><verse number="18" style="v" sid="ACT 10:18" />अने तीहया घोर मे वाळा माणहु ने बारा रीन आड़ीन पुछ्‌या, “सीमोन, जे पतरस केवाये, आञेत पोरणो से ह़ु?”<verse eid="ACT 10:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 10:19" />पतरस, जे दरसन देखलो तीना बारा मे वीच्‌यारेत करवा बाज र्‌यो हतो, ता भगवान नी आत्‌मा पतरस ने केदी, “देख, तीन माणहु तने ह़ोदवा बाज र्‌या। <verse eid="ACT 10:19" /><verse number="20" style="v" sid="ACT 10:20" />एतरे उठीन हेटो जा, अने धाक राख्‌या वगर ईमनी ह़ाते जत रे; काहाके हीमने मेत मोकल्‌लो से।” <verse eid="ACT 10:20" /><verse number="21" style="v" sid="ACT 10:21" />तत्‌यार पतरस हेटो उतरीन तीहया माणहु ने केदो, “देखो, जीने तमु ह़ोद र्‌या तीहयो मेत से; तमु ह़ु कामे आय र्‌या?”<verse eid="ACT 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 10:22" />तीहया माणहु जपाप आप्‌या, “सुबेदार कुरनेलीयुस धरमी अने भगवान नी बीक मानन्‌यो से। आखा युहदी माणहु मे तीहयो नामह़ाद्‌यो से, तीने चोखलो ह़रगदुत केदलो से के तु पतरस ने तार घोर बोलाय लाव, अने जे कंय तीहयो केहे, तीनी ह़मळजे।” <verse eid="ACT 10:22" /><verse number="23" style="v" sid="ACT 10:23" />पतरस तीमने घोर मे बोलायो, अने पोरणा नो आव-भाव करे तेम तीमनो आव-भाव कर्‌यो। बीजा दाड़े तीहयो तीयार हय ज्‌यो अने तीमनी ह़ाते जत र्‌यो, अने याफा ह़ेर ना थोड़ाक भरहो करन्‌या भायु तीमनी ह़ाते ज्‌या। <verse eid="ACT 10:23" /><verse number="24" style="v" sid="ACT 10:24" />अने बीजा दाड़े तीहयो केसर्‌या ह़ेर मे पुग्‌या, अने कुरनेलीयुस तीना भाय-बेटा अने मोंगाळ्‌ळा दोस्‌तीदार्‌या ने एक्‌ठा करीन तीमनी वाट जोय र्‌यो हतो। <verse eid="ACT 10:24" /><verse number="25" style="v" sid="ACT 10:25" />जत्‌यार पतरस कुरनेलीयुस ना घोर मे भरायवा बाज र्‌यो हतो, ता तीहयो कुरनेलीयुस ने भेट्‌यो। अने कुरनेलीयुस पतरस ना पोगे पड़ीन पतरस ने वांद्‌यो। <verse eid="ACT 10:25" /><verse number="26" style="v" sid="ACT 10:26" />पण पतरस तीने उठाड़तो जाय्‌न केदो, “उबो हय जा। मे बी एक माणेह से।” <verse eid="ACT 10:26" /><verse number="27" style="v" sid="ACT 10:27" />अने पतरस, कुरनेलीयुस ह़ाते वात करतो-करतो घोर मे भरायो। अने तां ढेरेत माणहु ने भेळा हय रेला देखीन। <verse eid="ACT 10:27" /><verse number="28" style="v" sid="ACT 10:28" />तीहयो तीमने आहयु केदो, “तमने आहयी वात मालम से के युहदी माणहु जुगु आड़जात्‌या ना घोर मे उठवा-बहवा मना से। पण भगवान मने केदलो से के तु काना बी माणेह ने वीटळ्‌ळो ना केय। <verse eid="ACT 10:28" /><verse number="29" style="v" sid="ACT 10:29" />एतरे मने बोलाव्‌वा पोर, मे रोकावट वगर नो आञे आय लागलो से: हाव मे तने पुछु के तु मने काहा बोलावलो से?”<verse eid="ACT 10:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 10:30" />कुरनेलीयुस केदो, “आहयीत टेमे आज गेथो च्‌यार दाड़ा पेले, मे मारा घोर मे बोपरी वळे, वीन्‌ती करवा बाज रेलो, ता एक अदमी झोळो-झोळो करत्‌ला लुगड़ा पेरीन मारी अगळ उचकाहलोत आवीन उबो हय ज्‌यो। <verse eid="ACT 10:30" /><verse number="31" style="v" sid="ACT 10:31" />अने केवा बाज ज्‌यो, ‘ए कुरनेलीयुस, तारी वीन्‌ती, अने तु गरीब ने जे दान आपलो, तीहयु भगवान ने तां पुग जेलु से। <verse eid="ACT 10:31" /><verse number="32" style="v" sid="ACT 10:32" />एतरे हाव तु अदमड़ा ने याफा ह़ेर मे मोकलीन सीमोन ने आञे बोलाय ले, जे पतरस केवाये। तीहयो एक चमायड़ान्‌तां पोरणो से। तीहया चमायड़ा नु घोर दर्‌या धेड़े से।’ <verse eid="ACT 10:32" /><verse number="33" style="v" sid="ACT 10:33" />अने तीनी वात ह़मळीन तत्‌यारुत माणहु ने तारीन्‌तां मोकली देदो, अने तु आञे आवीन भलु करलो से: हाव जे कंय भगवान तने केवा करीन हुकम आपलो से, तीहयु ह़मळवा करीन आमु आञे ह़रा भगवान अगळ हजुर से।”<verse eid="ACT 10:33" /></para>
  <para style="s">पतरस नु परच्‌यार</para>
  <para style="p">
    <verse number="34" style="v" sid="ACT 10:34" />आहयु आखु ह़मळीन पतरस केदो, “हाव मने पतो चाल ज्‌यो, के भगवान आखा ह़ाते एकरंगो वेहवार करे। <verse eid="ACT 10:34" /><verse number="35" style="v" sid="ACT 10:35" />पण जे कोय तीनी बीक मानीन जीवे अने धरम नु काम करे, तीहयोत माणेह भगवान ने गमे, भले तीहयो कोय काहा नी हय। <verse eid="ACT 10:35" /><verse number="36" style="v" sid="ACT 10:36" />भगवान ईस्‌रायली माणहुन्‌तां आह़फा नी खबर मोकल्‌यो अने ईसु मसी ना लारे, जे आखा नो मालीक से, सांती नी खुस-खबर ह़मळायो। <verse eid="ACT 10:36" /><verse number="37" style="v" sid="ACT 10:37" />तमु तीहयी वात जाणो के जे गलील मे सुरु हयी अने युहन्‌नो बपतीस्‌मा आप्‌यो अने अळतेण तीना बारा मे एकदम सी परच्‌यार हयो। अने तीहयी वात आखा युहद्‌या मे पुग जी। <verse eid="ACT 10:37" /><verse number="38" style="v" sid="ACT 10:38" />तमु नासरत वाळा ईसु ने जाणो के भगवान तीने आह़फा नी सक्‌ती अने चोखली आत्‌मा आपीन टाळ लेदो, अने तीहयो वारला काम करतो जाय्‌न भलाय कर्‌यो, अने जेतरा बी भुतड़ा ना कब्‌जा मे हता, तीमने सोड़ावतो र्‌यो; काहाके भगवान तीनी ह़ाते हतो। <verse eid="ACT 10:38" /><verse number="39" style="v" sid="ACT 10:39" />तीहयो जे युहद्‌या मे, अने यरुसलेम मे जे बी काम कर्‌यो, तीहया काम ना आमु गवा से। पण तीने माणहु कुरुस ना लाकड़ा पोर चड़ाय्‌न मार नाख्‌या। <verse eid="ACT 10:39" /><verse number="40" style="v" sid="ACT 10:40" />पण भगवान तीने तीसरा दाड़े जीवाड़्‌यो अने तीने उजन्‌तो देखाड़्‌यो। <verse eid="ACT 10:40" /><verse number="41" style="v" sid="ACT 10:41" />आखा माणहु नी, पण तीना गवा ने, जीने भगवान टाळ लेदलो, मतलब अमारी अगळ उजन्‌तो कर्‌यो। तीहयो मर्‌या-ह़र्‌या मे गेथो जीवतो हय ज्‌यो अने अळतेण आमु तीनी ह़ाते खादा-पीदा। <verse eid="ACT 10:41" /><verse number="42" style="v" sid="ACT 10:42" />तीहयो आमने हुकम आपलो से, के तमु माणहु मे आनो परच्‌यार करो; अने गवाय देवो, के आहयो तीहयोत से; जीने भगवान जीवत्‌ला अने मरला नो नीयाव करन्‌यो बणावलो से। <verse eid="ACT 10:42" /><verse number="43" style="v" sid="ACT 10:43" />तीना बारा मे भगवान वगे गेथी वात केण्‌या गवाय देय, के जे कोय ईसु पोर भरहो करहे, तीनेत तीना नाम सी पापु नी माफी जड़हे।”<verse eid="ACT 10:43" /></para>
  <para style="s">आड़जात्‌या माणहु पोर चोखली आत्‌मा उतरे</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 10:44" />पतरस आहयी वात केवात बाज र्‌यो हतोन चोखली आत्‌मा ह़मळन्‌या पोर उतरीन आय लागी। <verse eid="ACT 10:44" /><verse number="45" style="v" sid="ACT 10:45" />आड़जात्‌या माणहु ने बी चोखली आत्‌मा नो वाटो जड़ ज्‌यो आहयु देखीन पतरस ह़ाते आवला भरहो करन्‌या खतनु करला माणहु वहराय ज्‌या। <verse eid="ACT 10:45" /><verse number="46" style="v" sid="ACT 10:46" />अने आहया भरहो करन्‌या माणहु, आड़जात्‌या माणहु ने भात-भातीन बोली बोलत्‌ला अने भगवान नी बड़ाय करत्‌ला ह़मळी र्‌या हता। ता पतरस केदो, <verse eid="ACT 10:46" /><verse number="47" style="v" sid="ACT 10:47" />“आहया माणहु ने आमने जड़ली तीहयी चोखली आत्‌मा जड़ जेली से, ता हाव आमने पाणी ना बपतीस्‌मा लेवा सी कोय रोक सके ह़ुं?” <verse eid="ACT 10:47" /><verse number="48" style="v" sid="ACT 10:48" />अने पतरस आहयो हुकम आप्‌यो के ईमने बी ईसु मसी ना नाम पोर पाणी मे बपतीस्‌मा आप देवो। तत्‌यार तीहया बपतीस्‌मा लेण्‌या पतरस सी वीन्‌ती कर्‌या के “थोड़ाक दाड़ा तु अमारीन्‌तां रे।”<verse eid="ACT 10:48" /></para>
  <chapter eid="ACT 10" />
  <chapter number="11" style="c" sid="ACT 11" />
  <para style="s">यरुसलेम नी मंडळी ने पतरस नी चीट्‌ठी</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 11:1" />आखा युहद्‌या ना भाय-बेन्‌या ने अने नेवताळा ने पतो चाल्‌यो के आड़जात्‌या माणहु बी भगवान ना बोलु ने मान लेदा। <verse eid="ACT 11:1" /><verse number="2" style="v" sid="ACT 11:2" />जत्‌यार पतरस यरुसलेम आयो, ता भरहो करन्‌या खतनु करला माणहु वाक काडता जाय्‌न केदा। <verse eid="ACT 11:2" /><verse number="3" style="v" sid="ACT 11:3" />“तु आड़जात्‌या माणहु ना घोर मे भरायो, अने तीमनी ह़ाते खाणु काहा खादो?” <verse eid="ACT 11:3" /><verse number="4" style="v" sid="ACT 11:4" />ता पतरस, जे कंय हयलु तीहयु आखु सुरु गेथु आखरी लग ह़मजाड़तो जाय्‌न केदो:<verse eid="ACT 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 11:5" />“मे याफा ह़ेर मे वीन्‌ती करवा बाज रेलो हतो, ता मे चोखली आत्‌मा ना कब्‌जा मे हय ज्‌यो अने मारी चेत नी री अने मे ह़पनु देख्‌यो, अने तेतरी वळे ह़रग उगड़ी ज्‌यु, अने नाम्‌बा-चवड़ा चादरान तेवी कानी चीज ने ह़रगे गेथी पथराय्‌न उतरीन मार भणी आयु, अने तीना च्‌यार खुणा धरती पोर मेकाय ज्‌या। <verse eid="ACT 11:5" /><verse number="6" style="v" sid="ACT 11:6" />मे तीहयी चीज ने ध्‌यान सी देख्‌यो। ता तीहयी चीज मे धरती ना आखा भाती ना च्‌यार पोग्‌या जानवर्‌या, जंगली जानवर्‌या, अने घीहाय्‌न चालन्‌या जानवर्‌या अने ह़रग ना चड़ा हता। <verse eid="ACT 11:6" /><verse number="7" style="v" sid="ACT 11:7" />अने मने एक बोली ह़मळायी के ए पतरस! उठ, आमने मार अने खा। <verse eid="ACT 11:7" /><verse number="8" style="v" sid="ACT 11:8" />पण मे केदो, ए मालीक! मे आमने कदी नी खाम? काहाके मे बगड़ली अने वीटळ्‌ळी चीज हजु लग नी खादो। <verse eid="ACT 11:8" /><verse number="9" style="v" sid="ACT 11:9" />ते बी तीहयी बोली अळी बीजी कावा ह़रगे गेथी मने ह़मळायी, भगवान जे चीज ने चोखली केदलो से, ते चीज ने तु वीटळ्‌ळी ना केय। <verse eid="ACT 11:9" /><verse number="10" style="v" sid="ACT 11:10" />आसम तीन कावा हयु; अने अळतेण तीहयी ह़रग मे पासी उचलाय जी। <verse eid="ACT 11:10" /><verse number="11" style="v" sid="ACT 11:11" />अने अळतेण जे तीन अदमी ने केसर्‌या गेथा मारीन्‌तां मोकल्‌ला हता, तीहया अदमी जे घोर मे आमु हता, तां ह़रा आय लाग्‌या। <verse eid="ACT 11:11" /><verse number="12" style="v" sid="ACT 11:12" />तत्‌यार चोखली आत्‌मा मने हुकम आपी के तु ईमनी ह़ाते सेड़साड़ कर्‌या वगर जा। अने आहया छो भाय बी मारी ह़ाते चाल पड़्‌या; अने आमु तीहया माणेह ना घोर ज्‌या। <verse eid="ACT 11:12" /><verse number="13" style="v" sid="ACT 11:13" />अने तीहयो आमने देखाड़्‌यो के मने ह़रगदुत मार घोर मे उबो हय रेलो देखाव पड़्‌यो, तीहयो मने केदो, ‘तु याफा ह़ेर मे तारा माणहु ने मोकलीन सीमोन ने बोलाय लेजे पतरस केवाय। <verse eid="ACT 11:13" /><verse number="14" style="v" sid="ACT 11:14" />तीहयो एवी वात केहे, तीनी लारे तु अने तारु घोराणु छुटकारो हात करहु।’ <verse eid="ACT 11:14" /><verse number="15" style="v" sid="ACT 11:15" />अने जत्‌यार मे तां जाय्‌न तीमने वात देखाड़वा बाज र्‌यो हतो, ता चोखली आत्‌मा तीमनी पोर तेम ने तेम उतरी जीसम आपणी पोर सुरु मे उतरली। <verse eid="ACT 11:15" /><verse number="16" style="v" sid="ACT 11:16" /><note caller="+" style="x"><char style="xo" closed="false">11:16 </char><char style="xt" closed="false"><ref loc="ACT 1:5">नेवताळा ना काम 1:5</ref></char></note>तीहयी टेमे मने मालीक नो आहयो बोल फोम आयो, ‘युहन्‌ना ते पाणी मे बपतीस्‌मा आपतो हतो, पण थोड़ाक दाड़ा मे, तमने चोखली आत्‌मा मे बपतीस्‌मा अपायहे।’ <verse eid="ACT 11:16" /><verse number="17" style="v" sid="ACT 11:17" />भगवान तीमने तीहयुत ईलाम आप्‌यो जे आपणु ने मालीक ईसु मसी पोर भरहो कर्‌या करीन आप्‌यो; ता आमु कोय केवाय, जे भगवान ना काम ने रोकया?”<verse eid="ACT 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 11:18" />आहयी वात ह़मळीन तीहया धीरा पड़ ज्‌या, अने तीहया भगवान ना गुण गावीन केवा बाज ज्‌या, “ता भगवान आड़जात्‌या ने बी अमर जीवाय आपवा करीन तीमने पाप भणी गेथा मन फीरवीन भगवान भणी वळवा नो वाटो आपलो से।”<verse eid="ACT 11:18" /></para>
  <para style="s">अंताकीया नी मंडळी</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 11:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:1-4">नेवताळा ना काम 8:1-4</ref>
      </char>
    </note>स्‌तीफनुस ना बाह ने यरुसलेम मे वेला पाड़वा ना कारण सी। जे माणहु रीवण्‌या-तीवण्‌या हय्‌न वेरवाय ज्‌या, जता-जता तीहया फीनीके अने कुपरुस अने अंताकीया ह़ेर मे पुग्‌या; पण तीहया ईसु ना माणहु ईसु नी खुस-खबर युहदी माणहु ने एतरा ह़मळावत्‌ला। <verse eid="ACT 11:19" /><verse number="20" style="v" sid="ACT 11:20" />बाखीन तीहया ईसु ना चेला मे ना थोड़ाक कुपरुस मे रेण्‌या, अने कुरेन मे रेण्‌या हता, जे अंताकीया मे आवीन युनानी माणहु ने बी मालीक ईसु नी खुस-खबर ह़मळावा बाज ज्‌या। <verse eid="ACT 11:20" /><verse number="21" style="v" sid="ACT 11:21" />अने मालीक नी सक्‌ती तीमनी ह़ाते हती, अने ढेरेत माणहु मालीक ईसु पोर भरहो करीन मालीक ईसु वगा वळ ज्‌या।<verse eid="ACT 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 11:22" />यरुसलेम नी मंडळी मे बी आहयी वात पुग जी, अने तीहया बरनाबास ने अंताकीया ह़ेर मे तीमनीन्‌तां मोकली देदा। <verse eid="ACT 11:22" /><verse number="23" style="v" sid="ACT 11:23" />अने बरनाबास तां जाय्‌न भगवान नी दया देखीन घण-जबर खुस हयो; अने आखा ने रावण्‌या करीन ह़ीकाड़्‌यो, के तमु डील अने मन लगाड़ीन मालीक ईसु पोर भरहो करता रेवो। <verse eid="ACT 11:23" /><verse number="24" style="v" sid="ACT 11:24" />काहाके बरनाबास एक भलास्‌यो माणेह हतो; अने चोखली आत्‌मा तीनी मे पुरी भरायली हती अने ईसु पोर तीनो भरहो बी पक्‌को हतो। अने ढेरेत माणहु तीमनी ह़ाते भेसकाय ज्‌या।<verse eid="ACT 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 11:25" />अळतेण बरनाबास साउल ने ह़ोदवा करीन तरसुस ह़ेर मे जत र्‌यो। <verse eid="ACT 11:25" /><verse number="26" style="v" sid="ACT 11:26" />अने तीहयो ते साउल ने ह़ोदीन अंताकीया ह़ेर मे ली आयो, अने तीहया एक साल लग ईसु नी मंडळी ने भेटता र्‌या, अने ढेरेत माणहु ने ह़ीकाड़ता र्‌या, अने अंताकीया मे माणहु आखा ना पेले ईसु ना चेला ने मसी केवा बाज ज्‌या।<verse eid="ACT 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 11:27" />तीहया दाड़ा मे थोड़ाक भगवान वगे गेथी वात केण्‌या माणहु यरुसलेम गेथा अंताकीया ह़ेर नी मंडळी मे आया। <verse eid="ACT 11:27" /><verse number="28" style="v" sid="ACT 11:28" /><note caller="+" style="x"><char style="xo" closed="false">11:28 </char><char style="xt" closed="false"><ref loc="ACT 21:10">नेवताळा ना काम 21:10</ref></char></note>तीमनी मे अगबुस नाम नो एक जणो उबो हय्‌न आत्‌मा नी अगवाय मे केदो, आखी कळी मे काळ पड़वा वाळो से। आहयो काळ राजान राजा कलोदीयुस नी टेमे पड़लो। <verse eid="ACT 11:28" /><verse number="29" style="v" sid="ACT 11:29" />तत्‌यार ईसु ना चेला आहयो वीच्‌यार काड्‌या के एकीक जणो आपणा-आपणा रुप्‌या-टका ना अनसारे युहद्‌या परगणा मे रेवा वाळा आपणा भाय-बेटा नी सेवा-चाकरी जुगु थोड़ाक रुप्‌या-टका ली मोकलहु। <verse eid="ACT 11:29" /><verse number="30" style="v" sid="ACT 11:30" />अने तीहया जेम वीच्‌यार्‌या तेमेत कर्‌या; अने तीहया पुडार्‌यान्‌तां, बरनाबास अने साउल ने रुप्‌या-टका ली मोकल्‌या।<verse eid="ACT 11:30" /></para>
  <chapter eid="ACT 11" />
  <chapter number="12" style="c" sid="ACT 12" />
  <para style="s">अळी बुराय</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 12:1" />तीहयी टेमे हेरोद राजा मंडळी ने वेला पाड़वा सुरु कर देदो। <verse eid="ACT 12:1" /><verse number="2" style="v" sid="ACT 12:2" />तीहयो युहन्‌ना ना भाय याकुब ने तलवार सी झटकावीन मराय नाख्‌यो। <verse eid="ACT 12:2" /><verse number="3" style="v" sid="ACT 12:3" />अने जत्‌यार तीहयो देख्‌यो के आसम करवा सी युहदी माणहु खुस हये, ता तीहयो पतरस ने धर लेदो: तीहया दाड़ा मे खमीर वगर ना रोट्‌ला नो तीवार हतो। <verse eid="ACT 12:3" /><verse number="4" style="v" sid="ACT 12:4" />तीहयो पतरस ने धराय्‌न जेल मे बंद कराय नाख्‌यो, अने तीनी रखवाळी करवा करीन च्‌यार-च्‌यार सीपायड़ा ने च्‌यार टोळा बणावीन मेल देदो: हेरोद राजा नो वीच्‌यार हतो के मे आमने फसह ना तीवार ना दाड़े माणहु अगळ लावही। <verse eid="ACT 12:4" /><verse number="5" style="v" sid="ACT 12:5" />तीहयो जेल मे पतरस नी रखवाळी करवा करीन पेहरा बहाड़ र्‌यो हतो; पण मंडळी ना माणहु मन लगाड़ीन पतरस जुगु भगवान सी वीन्‌ती करवा बाज र्‌या हता।<verse eid="ACT 12:5" /></para>
  <para style="s">पतरस नो छुटकारो</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 12:6" />अने हेरोद राजा पतरस ने माणहु अगळ लाव्‌वा वाळो हतो, तीहयीत राते पतरस बे हातकड़ी मे बंदायलो, बे सीपायड़ान वच मे ह़ुव्‌वा बाज र्‌यो हतो, अने झापला पोर बी पेहरो देण्‌या सीपायड़ा पेहरो दी र्‌या हता। <verse eid="ACT 12:6" /><verse number="7" style="v" sid="ACT 12:7" />उचकाहलोत ह़रगदुत आवीन उबो हय ज्‌यो: अने कोपरो उजड़ान हय ज्‌यो; अने तीहयो पतरस ने कुखे टुचलीन तीने जगाड़्‌यो, अने केदो, “छोटो उठ।” एतरा मे आह़फात हातकड़्‌या छुटीन पड़ ज्‌या। <verse eid="ACT 12:7" /><verse number="8" style="v" sid="ACT 12:8" />तत्‌यार ह़रगदुत हुकम आपीन केदो, “केड़ बांद अने चाट्‌या पेर ले।” एतरे तीनी ह़मळीन तेमेत कर्‌यो। तीहयो पतरस ने अळी केदो, “तारु डगलु पेर ले अने मारी पसळ आव।” <verse eid="ACT 12:8" /><verse number="9" style="v" sid="ACT 12:9" />पतरस ह़रगदुत पसळ चालतो-चालतो कुंडवाड़ा मे गेथो बारो नीकळी पड़्‌यो। पण तीने तीहयु पल्‌ले नी पड़्‌यु, के आहयु ह़ाची से। पण तीहयो आहयु ह़मज्‌यो के मे ह़पनु देखवा बाज र्‌यो। <verse eid="ACT 12:9" /><verse number="10" style="v" sid="ACT 12:10" />ता तीहया पेल्‌नो पेहरो अने बीजो पेहरो छेकीन तीहया लुहड़ा ना झापलान्‌तां लग आया, जे ह़ेर भणी वाट जाय। तीहयु झापलु तीमनी जुगु आफुत उगड़ी ज्‌यु, अने तीहया बारा नीकळी ज्‌या। अने तीहया गळीन सींडे लग आया अने ह़रगदुत पतरस ने तां सोड़ीन जत र्‌यो। <figure style="fig" alt="Chains embedded in prison wall" file="hk00204c.tif" size="col" copy="Horace Knowles ©" ref="12:7">जेलखाणा ना भीतड़ा पोर ह़ाकळ ठोक मेल्‌ली</figure><verse eid="ACT 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 12:11" />अळतेण जत्‌यार पतरस ने ह़मज आयु, ता तीहयो की पड़्‌यो, “हाव मने ह़ाचलीन पल्‌ले पड़ ज्‌यु के आहयु हयु तीहयु खरलु से। मालीक आह़फा ना ह़रगदुत ने मोकलीन मने हेरोद राजा ना हात मे गेथो छोड़ाय लेदलो से, अने युहद्‌या नी आखी आह तोड़ देदली से।”<verse eid="ACT 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 12:12" />जत्‌यार पतरस ने आहयी वात ह़मज आय जी, ता तीहयो युहन्‌ना नी आय्‌ह मरीयम ना घोर जत र्‌यो। आहयो युहन्‌ना मरकुस बी केवाय। तां ह़रा ढेरेत जणा भेळा हय्‌न वीन्‌ती करवा बाज र्‌या हता। <verse eid="ACT 12:12" /><verse number="13" style="v" sid="ACT 12:13" />पतरस बारो झापलु ने ठोक्‌यो, ता कोय से करीन पतो लगाड़वा, रुदे नाम नी एक पावर्‌याण आयी। <verse eid="ACT 12:13" /><verse number="14" style="v" sid="ACT 12:14" />तीहयी पतरस नी अवाज पारखी लेदी, अने झापलु उगाड़वा भुल ज्‌यी अने पासी दवड़ीन जी अने तां भेळा हय रेला तीमने केदी, के पतरस झापला पोर उबो हय र्‌यो। <verse eid="ACT 12:14" /><verse number="15" style="v" sid="ACT 12:15" />तीहया तीने केदा, “तु मजाक कर री।” पण तीहयी पक्‌को भरहो करीन केतीत री के मे जे की री, तीहयी खरली वात से। तत्‌यार तीहया केदा, “तीमनो ह़रगदुत हहे।”<verse eid="ACT 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 12:16" />पण पतरस झापलु ठोकटोत र्‌यो। तत्‌यार तीहया झापलु उगाड़्‌या अने पतरस ने देख्‌या, ता तीहया घण-जबर वहराय ज्‌या। <verse eid="ACT 12:16" /><verse number="17" style="v" sid="ACT 12:17" />अने पतरस हात सी होगा रेवा नो ईसारो कर्‌यो, अने कानी रीते भगवान मने जेल मे गेथो नीकाळ लायो तीहयु तीमने की देदो; अळतेण अळी तीहयो केदो “याकुब ने अने भाय-बेन्‌या ने आहयी वात नी खबर की देजो।” अने कीदीन तीहयो ते घोर मे गेथो नीकळीन तां गेथो जत र्‌यो।<verse eid="ACT 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 12:18" />ह़वारे हयु ता सीपायड़ा थतवाय वळ्‌या; के पतरस नु ह़ु हयु। <verse eid="ACT 12:18" /><verse number="19" style="v" sid="ACT 12:19" />जत्‌यार हेरोद पतरस ने ह़ोदवाळ्‌या आखी दुर मोकल्‌यो, अने तीमने पतरस नी जड़्‌यो। ता अळतेण हेरोद सीपायड़ा ने हुकम आप्‌यो के तमु आहया पेहरो देण्‌या ने मार नाखो। अने हेरोद युहद्‌या ने सोड़ीन केसर्‌या ह़ेर मे जाय्‌न रेवा बाज ज्‌यो।<verse eid="ACT 12:19" /></para>
  <para style="s">हेरोद नु मरनु</para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 12:20" />हेरोद राजा सुर अने सेदा ह़ेर ना माणहु पोर खीजवाय र्‌यो हतो; एतरे तीहया एक-मन्‌या हय्‌न आया, अने हेरोद राजा ना पावोर बलास्‌तुस ने पटाड़ीन तीनी लारे हेरोद राजा ह़ाते भेळा हयवा हंडता हता। काहाके तीमने हेरोद राजा ना देस गेथु खावा नो सादन जड़त्‌लो।<verse eid="ACT 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 12:21" />अने टाकला दाड़े हेरोद राजा राज ना लुगड़ा पेरीन नीयाव नी गादी पोर बह्‌यो, अने माणहु मे परच्‌यार करवा बाज ज्‌यो। <verse eid="ACT 12:21" /><verse number="22" style="v" sid="ACT 12:22" />माणहु आड़ीन केदा, “आहयी माणेह नी अवाज नी हय, पण भगवान नी अवाज से।” <verse eid="ACT 12:22" /><verse number="23" style="v" sid="ACT 12:23" />तीहयी टेमे मालीक नो ह़रगदुत हेरोद ने देदो, अने तीना डील मे कीड़ा पड़ ज्‌या अने तीहयो मर ज्‌यो, काहाके तीहयो भगवान नी बड़ाय नी कर्‌यो।<verse eid="ACT 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 12:24" />भगवान ना बोलु वद्‌ता अने फेलता ज्‌या।<verse eid="ACT 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 12:25" />जत्‌यार बरनाबास अने साउल यरुसलेम मे आह़फाम नी सेवा-चाकरी करीन पासा आया, अने मरकुस ने लीन आया। जे युहन्‌नो केवातो हतो।<verse eid="ACT 12:25" /></para>
  <chapter eid="ACT 12" />
  <chapter number="13" style="c" sid="ACT 13" />
  <para style="s">बरनाबास अने साउल ने खुस-खबर ह़मळाव्‌वा मोकले</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 13:1" />अंताकीया ह़ेर नी मंडळी मे थोड़ाक भगवान वगे गेथी वात केण्‌या माणहु अने ह़ीकाड़न्‌या हता, जीसम बरनाबास, अने सीमोन जे काळ्‌ळो केवायत्‌लो अने कुरेनी मे रेण्‌यो लुकीयुस, अने देस ना चोवथा हीस्‌सा मे राज करन्‌यो हेरोद राजा नो बाखड़्‌यो भाय मनाहेम अने साउल। <verse eid="ACT 13:1" /><verse number="2" style="v" sid="ACT 13:2" />जत्‌यार तीहया उपाह़ भेळ मालीक नी भक्‌ती करवा बाज र्‌या हता, तत्‌यार चोखली आत्‌मा केदी, “मे जे सेवा ना काम जुगु मारीन करते बरनाबास अने साउल ने बोलावली से, तीमने आंग्‌ये कर लेवो।”<verse eid="ACT 13:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 13:3" />ता तीहया उपाह़ अने वीन्‌ती करीन बरनाबास अने साउल पोर हात मेकीन तीमने मोकली देदा।<verse eid="ACT 13:3" /></para>
  <para style="s">पोलुस नी पेली परच्‌यार यात्‌रा</para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 13:4" />अळतेण बरनाबास अने साउल चोखली आत्‌मा नी अगवाय मे सीलुकीया ज्‌या, अने तां गेथा मोट्‌ला ढुंड्‌या मे बहीन कुपरुस जत र्‌या। <verse eid="ACT 13:4" /><verse number="5" style="v" sid="ACT 13:5" />अने सलमीस ह़ेर पुगीन, तीहया युहदी माणहु ना भक्‌ती ना घोर मे भगवान नो बोल ह़मळाया। अने युहन्‌नो तीमनो चाकर्‌यो हतो। <figure style="fig" alt="Front view of a synagogue" file="lb00246c.tif" size="col" copy="Horace Knowles ©" ref="13:5">युहदी माणहु नु भक्‌ती नु घोर </figure><verse eid="ACT 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 13:6" />अने तीहया तां आखा देस फीरता-फीरता, पाफुस मे पुग्‌या: तां तीमने बार-ईसु नाम नो एक युहदी जाती नो जादु-वीद्‌या देखाड़न्‌यो अने झुटो भगवान वगे गेथी वात केण्‌यो माणेह भेट्‌यो। <verse eid="ACT 13:6" /><verse number="7" style="v" sid="ACT 13:7" />तीहयो राजो सीरग्‌युस पोलुस नी ह़ाते हतो। जे अक्‌कल वाळो माणेह हतो। तीहयो बरनाबास अने साउल ने बोलावीन भगवान नो बोल ह़मळवा कर्‌यो। <verse eid="ACT 13:7" /><verse number="8" style="v" sid="ACT 13:8" />पण आहयो एलीमास जादु देखाड़न्‌यो हतो। आहयो बरनाबास अने साउल भणी जोर कर्‌यो। अने सीरग्‌युस ने भरहो करवा सी रोकवा हींड्‌यो। <verse eid="ACT 13:8" /><verse number="9" style="v" sid="ACT 13:9" />बाखीन साउल, जे पोलुस बी केवायतो हतो। चोखली आत्‌मा ना कब्‌जा मे हय्‌न तीहया ईलीमास भणी एकडीट्‌यो भाळीन केदो। <verse eid="ACT 13:9" /><verse number="10" style="v" sid="ACT 13:10" />तु भुतड़ा नो सोरो से, तारी मे बीजा ने धोको देवा नी वात अने ठगवा नी वात भरायली से। अने तु आखा धरम नो वेरी से, ह़ु तु भगवान नी ह़ुदी वाट ने वाकी करवा नी सोड़े? <verse eid="ACT 13:10" /><verse number="11" style="v" sid="ACT 13:11" />हाव देख, मालीक तने डंड आपवा बाज र्‌यो, तु थोड़ाक दाड़ा लग आंदळो रेही अने दाड़ु ने नी देखे: ता तीनी पोर अंदारलु छवाय ज्‌यु, अने तीहयो कानो मारो हात धरीन लीजहे करीन आञे ने ह़ेले ह़ोलकवा बाज ज्‌यो। <verse eid="ACT 13:11" /><verse number="12" style="v" sid="ACT 13:12" />जे हयु तीहयु आखु देखीन ह़ेर नो हकदार्‌यो, ईसु पोर भरहो कर लेदो; अने तीहयो मालीक ईसु ना बारा मे ह़मळीन वहराय ज्‌यो।<verse eid="ACT 13:12" /></para>
  <para style="s">पीसीद्‌या मे पोलुस नु आवणु</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 13:13" />पोलुस अने तीना ह़ाती मोट्‌ला ढुंड्‌या मे बहीन पाफुस गेथा पमफुल्‌या देस ना पीरगा ह़ेर मे आया; अने युहन्‌नो तीमने तां सोड़दीन पासो यरुसलेम जत र्‌यो। <verse eid="ACT 13:13" /><verse number="14" style="v" sid="ACT 13:14" />पोलुस अने बरनाबास पीरगा गेथा अगा जाय्‌न पीसीद्‌या ना अंताकीया मे पुग्‌या, अने तीहया अराम ना दाड़े युहदी माणहु ना भक्‌ती ना घोर मे जाय्‌न बह ज्‌या। <verse eid="ACT 13:14" /><verse number="15" style="v" sid="ACT 13:15" />मुसा ना लारे लीखली सास्‌तर अने भगवान वगे गेथा लीखण्‌या माणहु नी कीताप भणीन अळतेण भक्‌तीन घोर ना पुडारी, बरनाबास ने तां अने पोलुस ने तां आहयी वात की मोकल्‌या, “ए भायु! कदीम माणहु ने हीम्‌मत आपवा जुगु तमारी पांह कंय बी वात हय ता केवो।” <verse eid="ACT 13:15" /><verse number="16" style="v" sid="ACT 13:16" />तत्‌यार पोलुस उबो हय ज्‌यो, अने हात उरवतो जाय्‌न केवा बाज ज्‌यो; ए ईस्‌रायली माणहु अने भगवान नी बीक मानीन जीवण्‌या आड़जात्‌या माणहु ह़मळो: <verse eid="ACT 13:16" /><verse number="17" style="v" sid="ACT 13:17" />आपणो ईस्‌रायली माणहु नो भगवान आपणा आड़ा-बुड़ा ने टाळ लेदलो से, अने जत्‌यार तीहया मीसर देस मे पारका बणीन री र्‌या हता, ता तीमनो वेल वदाड़ीन तीमने मोटा बणायो, अने आह़फा ना हात ना ज्‌योरे तीमने तां गेथो नीकाळ लायो। <verse eid="ACT 13:17" /><verse number="18" style="v" sid="ACT 13:18" />तीहयो चाळीह साल लग जंगल मे तीमनी रखवाळी कर्‌यो। <verse eid="ACT 13:18" /><verse number="19" style="v" sid="ACT 13:19" />अने भगवान कनान देस मे ह़ात जाती ने खत्‌तम कर देदो, अने तीहयु देस आपणा आड़ा-बुड़ा ना हक मे कर देदो। <verse eid="ACT 13:19" /><verse number="20" style="v" sid="ACT 13:20" />अने अळतेण भगवान भणी गेथी वात केण्‌या माणेह समुएल लग नीयाव करन्‌या ठेरायो। <verse eid="ACT 13:20" /><verse number="21" style="v" sid="ACT 13:21" />भगवान पांह एक राजा नी मांग कर्‌या: ता भगवान तीमनी जुगु बीन्‌यामीन नी कुळी मे गेथो कीस नो बेटो साउल ने राजा बणाय देदो। <verse eid="ACT 13:21" /><verse number="22" style="v" sid="ACT 13:22" />अने अळतेण भगवान साउल ने राज गेथो सेटो करीन दावुद ने तीमनो राजा बणायो; आहया दावुद ना बारा मे भगवान आहयी गवा देदो, “के मने एक माणेह मारा मन ना अनसारे जड़ जेलो से, जे यीसे नो बेटो दावुद से। आहयोत दावुद मारी मरजी पुरी करहे।” <verse eid="ACT 13:22" /><verse number="23" style="v" sid="ACT 13:23" />आहया दावुद नी अवल्‌यात मे गेथोत भगवान आह़फा ना वायदा ना अनसारे ईस्‌रायली माणहुन तां एक सोड़ाव्‌वा वाळा ने ईसु ना रुप मे मोकल्‌यो। <verse eid="ACT 13:23" /><verse number="24" style="v" sid="ACT 13:24" /><note caller="+" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="MRK 1:4">मरकुस 1:4</ref>; <ref loc="LUK 3:3">लुका 3:3</ref></char></note>तीने आव्‌वान पेले युहन्‌नो आखा ईस्‌रायली माणहु ने पाप भणी गेथा मन फीरवीन भगवान वगा वळवा ना बपतीस्‌मान परच्‌यार करतो हतो <verse eid="ACT 13:24" /><verse number="25" style="v" sid="ACT 13:25" /><note caller="+" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="JHN 1:20">युहन्‌ना 1:20</ref>; </char><char style="xt" closed="false"><ref loc="MAT 3:11">मत्‌ती 3:11</ref>; <ref loc="MRK 1:7">मरकुस 1:7</ref>; <ref loc="LUK 3:16">लुका 3:16</ref>; <ref loc="JHN 1:27">युहन्‌ना 1:27</ref></char></note>अने युहन्‌नो भगवान नु काम पुरु करवात वाळो हतो, ता केदो, तमु मने जे ह़मजी र्‌या, तीहयो मे नी हय! बाखीन देखो, एक आसवो से जे मार गेथो अळतेण आव्‌वा बाज र्‌यो। अने मे तीना खाहड़ा ना बोंद सोड़वान लायक नी हय।<verse eid="ACT 13:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 13:26" />ए भायु, अब्‌राहम नी अवल्‌यात! अने भगवान नी बीक मानीन जीवण्‌या आड़जात्‌या माणहु! छुटकारा नी आहयी खुस-खबर आपणु आखा जुगु से। <verse eid="ACT 13:26" /><verse number="27" style="v" sid="ACT 13:27" />यरुसलेम मे रेवा वाळा अने तां नीयाव करन्‌या मुखी ईसु ने नी ओळख्‌या, अने तीहया भगवान वगे गेथी वात केण्‌या नी कीताप मे लीखली वात ने नी ह़मज्‌या; जे अराम ना दाड़ाडीट भणत्‌ला। जाण बुजीन तीने गुनाळ्‌ळो ठेरावीन लीखली वात पुरी कर्‌या। <verse eid="ACT 13:27" /><verse number="28" style="v" sid="ACT 13:28" /><note caller="+" style="x"><char style="xo" closed="false">13:28 </char><char style="xt" closed="false"><ref loc="MAT 27:22">मत्‌ती 27:22</ref>,<ref loc="MAT 27:23">23</ref>; <ref loc="MRK 15:13">मरकुस 15:13</ref>,<ref loc="MRK 15:14">14</ref>; <ref loc="LUK 23:21-23">लुका 23:21-23</ref>; <ref loc="JHN 19:15">युहन्‌ना 19:15</ref></char></note>भले तीमने डंड आपे एवो गुनो तीनी मे देखावा नी पड़्‌यो, ते बी तीहया पीलातुस ह़ाते रावण्‌या कर्‌या, के हीने मराय नाख। <verse eid="ACT 13:28" /><verse number="29" style="v" sid="ACT 13:29" /><note caller="+" style="x"><char style="xo" closed="false">13:29 </char><char style="xt" closed="false"><ref loc="MAT 27:57-61">मत्‌ती 27:57-61</ref>; <ref loc="MRK 15:42-47">मरकुस 15:42-47</ref>; <ref loc="LUK 23:50-56">लुका 23:50-56</ref>; <ref loc="JHN 19:38-42">युहन्‌ना 19:38-42</ref></char></note>अने तीहया ईसु ना बारा मे जे कंय लीखलु हतु, तीहयु आखु पुरु कर लेदा, ता तीहया ईसु ने कुरुस पोर गेथा उतार लेदा, मड़ाट्‌या मे गाड़ देदा। <verse eid="ACT 13:29" /><verse number="30" style="v" sid="ACT 13:30" />पण भगवान ईसु ने मर्‌या-ह़र्‌या मे गेथो पासो जीवाड़ीन बठो कर देदो। <verse eid="ACT 13:30" /><verse number="31" style="v" sid="ACT 13:31" /><note caller="+" style="x"><char style="xo" closed="false">13:31 </char><char style="xt" closed="false"><ref loc="ACT 1:3">नेवताळा ना काम 1:3</ref></char></note>अने तीहयो घणा दाड़ा लग तीहया माणहु ने देखाव पड़तो र्‌यो, जे तीनी ह़ाते गलील जीला मे गेथा यरुसलेम मे आवता हता। हाव तीहयात माणहु अगळ तीना गवा से। <verse eid="ACT 13:31" /><verse number="32" style="v" sid="ACT 13:32" />अने आमु तमने तीहया बोली करला वायदा नी खुस-खबर ह़मळावया, जे वायदो भगवान आपणा आड़ा-बुड़ा ह़ाते करलो हतो। <verse eid="ACT 13:32" /><verse number="33" style="v" sid="ACT 13:33" />भगवान ईसु मसी ने मर्‌या-ह़र्‌या मे गेथो जीवतो करीन तीहयोत वायदो आपणी अवल्‌यात जुगु पुरो करलो से, जीसम भजन मे बी लीखलु से:</para>
  <para style="q1" vid="ACT 13:33">तु मारो सोरो से;</para>
  <para style="q2" vid="ACT 13:33">आज गेथो मे तारो बाह बण ज्‌यो।<verse eid="ACT 13:33" /></para>
  <para style="m">
    <verse number="34" style="v" sid="ACT 13:34" />भगवान ईसु ने मर्‌या-ह़र्‌या मे गेथो पासो जीवाड़वा ना बारा मे केदो, के तीहयो कदी नी ह़ड़े। काहाके भगवान तीने केदलो हतो,</para>
  <para style="q1" vid="ACT 13:34">मे तने चोखली अने जलमकी संयबरकत आपही,</para>
  <para style="q2" vid="ACT 13:34">जे संयबरकत मे दावुद ने आपवा नी बोली करलो हतो।<verse eid="ACT 13:34" /></para>
  <para style="m">
    <verse number="35" style="v" sid="ACT 13:35" />एतरे तीहयो एक अळी बीजा भजन मे केदलो;</para>
  <para style="q1" vid="ACT 13:35">तु आपणा चोखला भगत ने ह़ड़वा नी देय।<verse eid="ACT 13:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ACT 13:36" />“काहाके दावुद ते भगवान नो हुकम मानीन भगवान नी मरजी पुरी कर्‌यो; अने मर ज्‌यो; अने तीने आड़ा-बुड़ा ने गाड़ला तां गाड़ देदा; अने तीनु डील तां ह़ड़ ज्‌यु। <verse eid="ACT 13:36" /><verse number="37" style="v" sid="ACT 13:37" />बाखीन भगवान तीने मर्‌या-ह़र्‌या मे गेथो जीवाड़ीन पासो बठो कर्‌यो, तीनु डील नी ह़ड़्‌यु। <verse eid="ACT 13:37" /><verse number="38" style="v" sid="ACT 13:38" />एतरे ए भायु! तमु वारु रीते ह़मजी लेवो के आहयात ईसु ना लारे तमने पाप नी माफी नी ह़ीकापण ह़मळावलो से। मुसान लारे लीखली सास्‌तर आहया पाप मे गेथो छुटकारो आपीन तमने धरमी नी बणावे। <verse eid="ACT 13:38" /><verse number="39" style="v" sid="ACT 13:39" />पण भगवान ईसु पोर भरहो करन्‌या नेत वण-गुनाळ्‌ळा ठेरावे। <verse eid="ACT 13:39" /><verse number="40" style="v" sid="ACT 13:40" />एतरे चेतीन रेवो, कंखर माय्‌न भगवान वगे गेथी वात केण्‌या माणहु ना कीताप मे लीखली वात पुरी नी हय जाय:<verse eid="ACT 13:40" /></para>
  <para style="q1">
    <verse number="41" style="v" sid="ACT 13:41" />ए वाक काडण्‌या, वहराय्‌न मर जावो;</para>
  <para style="q1" vid="ACT 13:41">काहाके मे तमारा जमाना मे एक जुदु काम करवा वाळो से;</para>
  <para style="q2" vid="ACT 13:41">एक आसवु काम, कदी तमारी मे ना कोय आना बारा मे वात बी करहे,</para>
  <para style="q2" vid="ACT 13:41">ते बी कोयने आहयी वात नो भरहो नी आवे।”<verse eid="ACT 13:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 13:42" />जत्‌यार पोलुस अने बरनाबास बारा नीकळवा बाज र्‌या हता ता माणहु तीमनी पांह रावण्‌या कर्‌या, तमु आवता अराम ना दाड़े आहयी वात ना बारा मे केजो। <verse eid="ACT 13:42" /><verse number="43" style="v" sid="ACT 13:43" />जत्‌यार तीमनी भक्‌ती नी बठक हय जी, ता युहदी माणहु अने आड़जात्‌या युहदी-धरम मानवा वाळा नवला चेला, पोलुस अने बरनाबास नी वात मानवा बाज ज्‌या। पोलुस अने बरनाबास तीमने ह़मजाड़ीन केदा, भगवान नी दया मे बणला रेजो।<verse eid="ACT 13:43" /></para>
  <para style="s">आड़जात्‌या मे पोलुस खुस-खबर ह़मळावे</para>
  <para style="p">
    <verse number="44" style="v" sid="ACT 13:44" />आवता अराम ना दाड़े ह़ेर ना आखा माणहु मालीक भगवान नो बोल ह़मळवा करीन भेळा हय ज्‌या। <verse eid="ACT 13:44" /><verse number="45" style="v" sid="ACT 13:45" />पण ढेरेत माणहु आवत्‌ला देखीन युहदी माणहु कुहरायवा बाज ज्‌या, अने वीरोद करीन पोलुस नी वात नो वाक काडवा बाज ज्‌या। <verse eid="ACT 13:45" /><verse number="46" style="v" sid="ACT 13:46" />पोलुस अने बरनाबास बीह्‌या वगर केदा, जरुड़ी हतु के पेले तमने भगवान नो बोल ह़मळावु हतु, बाखीन तमु भगवान नो बोल नीकारो करीन ह़मळवा नी हींडता, अने तमु आह़फा ने अमरकाय नी जलमकी जीवाय्‌न लायक नी ह़मज्‌ता; एतरे आमु हाव आड़जात्‌या माणहुन तां भगवान नो बोल लीजीया। <verse eid="ACT 13:46" /><verse number="47" style="v" sid="ACT 13:47" />काहाके मालीक भगवान आमने आहयो हुकम आपलो से,</para>
  <para style="q1" vid="ACT 13:47">मे तमने आड़जात्‌या माणहु जुगु वीजाळु बणावलो से,</para>
  <para style="q2" vid="ACT 13:47">आनीन करीन के तमारी लारे धरती ना खुणे-कोपरे लग माणहु छुटकारो हात करे तेम।<verse eid="ACT 13:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="ACT 13:48" />आड़जात्‌या माणहु पोलुस नी अने बरनाबास नी वात ह़मळीन घणा खुस हया अने तीहया मालीक भगवान ना बोल नी ईज्‌जत कर्‌या। जेतरा माणहु अमरकाय नी जीवाय जुगु टाळला हता, तीहया ईसु पोर भरहो कर्‌या।<verse eid="ACT 13:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="ACT 13:49" />अने आखा परगणा मे मालीक नो बोल फीर ज्‌यो। <verse eid="ACT 13:49" /><verse number="50" style="v" sid="ACT 13:50" />पण युहदी माणहु, उची कुळी ना भगत माणहु ने अने ह़ेर ना बयरा ने जोर चड़ाय देदा, अने पोलुस अने बरनाबास नो वीरोद कराव्‌वा हुहड़ीन आय लाग्‌या, अने तीमने आह़फा ना परगणा मे गेथा काड देदा। <verse eid="ACT 13:50" /><verse number="51" style="v" sid="ACT 13:51" /><note caller="+" style="x"><char style="xo" closed="false">13:51 </char><char style="xt" closed="false"><ref loc="MAT 10:14">मत्‌ती 10:14</ref>; <ref loc="MRK 6:11">मरकुस 6:11</ref>; <ref loc="LUK 9:5">लुका 9:5</ref>; <ref loc="LUK 10:11">10:11</ref></char></note>अने अळतेण पोलुस अने बरनाबास तीमना वीरोद मे आपणा पोगु नो धुळो झाटकीन ईकुनीयुम ह़ेर मे जत र्‌या। <verse eid="ACT 13:51" /><verse number="52" style="v" sid="ACT 13:52" />पण चेला खुसी अने चोखली आत्‌मा सी पुरान-पुरा भरायला हता।<verse eid="ACT 13:52" /></para>
  <chapter eid="ACT 13" />
  <chapter number="14" style="c" sid="ACT 14" />
  <para style="s">ईकुनीयुम ह़ेर मे पोलुस अने बरनाबास</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 14:1" />ईकुनीयुम मे आसम हयु के पोलुस अने बरनाबास युहद्‌या ना भक्‌ती ना घोर मे भेळात ज्‌या, अने आसम वात कर्‌या, के युहद्‌या अने आड़जात्‌या बेम मे ना घणा ढेरका भरहो कर लेदा। <verse eid="ACT 14:1" /><verse number="2" style="v" sid="ACT 14:2" />पण ईसु पोर भरहो नी करन्‌या युहदी माणहु, आड़जात्‌या माणहु ने वीरखाड़ देदा अने भायु ना वीरोद मे तीमना मन मे काट करवा नो वीच्‌यार नाख देदा। <verse eid="ACT 14:2" /><verse number="3" style="v" sid="ACT 14:3" />पोलुस अने बरनाबास ढेरेत दाड़ा तां र्‌या, अने मालीक पोर भरहो करीन बीह्‌या वगर ईसु ना बारा मे वात करता र्‌या: अने मालीक ईसु तीमनी लारे सेल-भात्‌या जुदा-कामु अने सेलाणी देखाड़ीन आह़फा नी दया ना बोल नी गवा देतो हतो। <verse eid="ACT 14:3" /><verse number="4" style="v" sid="ACT 14:4" />पण तीहया ह़ेर ना माणहु मे बेरजाव पड़ ज्‌यो; अने आसम करीन थोड़ाक युहदी माणहु वगा अने थोड़ाक ईसु ना नेवताळा वगा वळ ज्‌या।<verse eid="ACT 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 14:5" />ता युहदी माणहु अने आड़जात्‌या माणहु आह़फाम ना मुख्‌या हाते भेसकाय्‌न पोलुस अने बरनाबास ह़ाते खोटो वेहवार करवा अने तीमने दगड़ाटवा करीन वीच्‌यार कर्‌या। <verse eid="ACT 14:5" /><verse number="6" style="v" sid="ACT 14:6" />ता पोलुस अने बरनाबास तीमनी वात जाण ज्‌या अने तीहया लुकाउन्‌या जीला ना लुस्‌तरा ह़ेर मे, अने दीरबे ह़ेर मे नाह पड़्‌या। <verse eid="ACT 14:6" /><verse number="7" style="v" sid="ACT 14:7" />अने तीहया तां जाय्‌न खुस-खबर ह़मळावा बाज ज्‌या।<verse eid="ACT 14:7" /></para>
  <para style="s">लुस्‌तरा अने दीरबे मे पोलुस अने बरनाबास</para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 14:8" />लुस्‌तरा मे एक माणेह बह र्‌यो हतो, तीना पोग लुल्‌ला हता: तीहयो पयदासी लंगड़ो हतो, अने तीहयो कदी चाल्‌लो नी हतो। <verse eid="ACT 14:8" /><verse number="9" style="v" sid="ACT 14:9" />तीहयो पोलुस ने वात करत्‌लो ह़मळी र्‌यो हतो, अने तीहयो पोलुस भणी एकडीट्‌यु भाळ र्‌यो हतो, अने ते लंगड़ा मे वारु हयवा नो भरहो हतो। <verse eid="ACT 14:9" /><verse number="10" style="v" sid="ACT 14:10" />एतरे पोलुस ज्‌योरेत आड़ीन केदो, “तारा पोगु ना भरहे उबो हय जा।” अने तीहयो पोलुस नी वात ह़मळीन उबो हय ज्‌यो अने चालवा-फीरवा बाज ज्‌यो। <verse eid="ACT 14:10" /><verse number="11" style="v" sid="ACT 14:11" />पोलुस ना लारे हयला जुदा-कामु ने देखीन माणहु लुकाउन्‌या बोली मे ज्‌योरेत आड़ीन केदा, “माणेह नो वेह लीन देवता अमारी वच मे उतरी आवलो से।” <verse eid="ACT 14:11" /><verse number="12" style="v" sid="ACT 14:12" />अने तीहया बरनाबास ने ज्‌युस देवता अने पोलुस ने हीरमेस देवता केवा बाज ज्‌या; काहाके पोलुस वात करवा मे पुडारी हतो। <verse eid="ACT 14:12" /><verse number="13" style="v" sid="ACT 14:13" />अने ज्‌युस देवता नो मंदीर ह़ेर ना झापला अगळ हतो। अने तीहया मंदीर वाळो पुंजारी बोळद्‌यो अने फुलु नी हार लीन ता आय लाग्‌यो। तीहयो माणहु भेळो पोलुस अने बरनाबास जुगु बोळद्‌यो मारीन बादा चड़ाव्‌वा हींडतो हतो।<verse eid="ACT 14:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 14:14" />पण बरनाबास अने पोलुस जे ईसु ना नेवताळा हता, तीहया आहयु ह़मळ्‌या, ता तीहया मन मे घण-जबर दुखी हय्‌न आह़फाम ना लुगड़ा फाड़ीन माणहु मे जाय पड़्‌या, अने आड़ीन केदा, “ए माणहु! तमु आसम आहयु काहा करवा बाज र्‌या? <verse eid="ACT 14:14" /><verse number="15" style="v" sid="ACT 14:15" />आमु बी तमारीन तेवा माणहु से। तमु आहयी फालतु वात ने सोड़ीन जीवत्‌ला भगवान भणी वळीन तीने मानो, जे ह़रग अने धरती, अने दर्‌या, अने जे कंय दर्‌या मे से तीहयु आखु बणायो। करीनेत आमु आञे तमने ईसु नी खुस-खबर ह़मळावा आय र्‌या। <verse eid="ACT 14:15" /><verse number="16" style="v" sid="ACT 14:16" />वीत्‌या जमाना मे भगवान आखी जाती ना माणहु ने आपणा-आपणा मेण्‌ये जेवा-तेवा देवता नी पुजा-पाट करीन जीव्‌वा देदो, काहाके तीहया तीने नी ओळख्‌या। <verse eid="ACT 14:16" /><verse number="17" style="v" sid="ACT 14:17" />ते बी तीहयो तीमनी भलाय कर्‌यो, ह़रगे गेथो पाणी पाड़तो र्‌यो अने टेमे-टेमे मेर पकाड़तो र्‌यो, खावा नो सादन आप्‌तो र्‌यो, अने तीमना मन ने खुस करतो र्‌यो।” <verse eid="ACT 14:17" /><verse number="18" style="v" sid="ACT 14:18" />आसम कीदीन पोलुस कंय करीन तीहया माणहु ने तमु बोळद्‌यो मारीन बादा चड़ावीन मारी पुजा-पाट ना करो करीन रोक्‌यो।<verse eid="ACT 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 14:19" />पण थोड़ाक युहदी माणहु अंताकीया ह़ेर मे गेथा अने ईकुनीयुम गेथा आवीन माणहु ने आह़फाम नी वगा कर लेदा अने पोलुस ने दगड़ाट्‌या, अने मर ज्‌यो ह़मजीन तीने घीहीन ह़ेर गेथो बारो ली ज्‌या; अने तां नाखीन जत र्‌या। <verse eid="ACT 14:19" /><verse number="20" style="v" sid="ACT 14:20" />बाखीन जत्‌यार चेला पोलुस ना च्‌यार मेर आवीन भेळा हय ज्‌या, ता तीहयो उठीन ह़ेर मे ज्‌यो, अने बीजा दाड़े बरनाबास ह़ाते दीरबे ह़ेर मे जत र्‌यो।<verse eid="ACT 14:20" /></para>
  <para style="s">अंताकीया मे पासु आवणु</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 14:21" />तीहया ते ह़ेर ना माणहु ने ईसु नी खुस-खबर ह़मळाया, अने ढेरेत चेला बणाया, अने लुस्‌तरा अने ईकुनीयुम अने अंताकीया पासा जत र्‌या। <verse eid="ACT 14:21" /><verse number="22" style="v" sid="ACT 14:22" />अने तीहया चेला ने हीमम्‌त आपता जाय्‌न तीमने भरहा मे टेकला रेवा करीन आहयी वात ह़ीकाड़ता र्‌या, आपणु ने घण-जबर वेला करीन भगवान ना राज मे भरायणु से। <verse eid="ACT 14:22" /><verse number="23" style="v" sid="ACT 14:23" />अने तीहया मंडळी डीट पुडारी बणाव्‌वा करीन माणहु ने टाळ्‌या अने तीमने पुडारी ठेराया, उपाह़ भेळा भगवान ह़ाते वीन्‌ती करीन, तीमने मालीक ना हात मे ह़ोप देदा; जे मालीक ईसु पोर तीहया भरहो कर र्‌या हता।<verse eid="ACT 14:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 14:24" />अळतेण पोलुस अने बरनाबास पीसीद्‌या जीला ने वणकीन, पमफुल्‌या जीला मे पुग्‌या। <verse eid="ACT 14:24" /><verse number="25" style="v" sid="ACT 14:25" />अने पीरगा ह़ेर मे ईसु नी खुस-खबर ह़मळावीन अतलीया ह़ेर मे आया <verse eid="ACT 14:25" /><verse number="26" style="v" sid="ACT 14:26" />अळतेण तां गेथा तीहया मंडळीन लारे भगवान नी दया अनसारे ह़ोपलु काम पुरु करीन मोट्‌ला ढुंड्‌या मे बहीन अंताकीया ह़ेर मे आवती र्‌या, तां गेथा तीहया काम सुरु करला।<verse eid="ACT 14:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 14:27" />तां पुगीन तीहया मंडळी ने भेळी कर्‌या, अने जे कंय हयु तीहयु मंडळी ने ह़मळाया, के भगवान अमारी ह़ाते रीन मोटा-मोटा काम करलो, अने आड़जात्‌या माणहु बी ईसु पोर भरहो कर्‌या अने भगवान तां बी भरहा नु झापलु उगाड़ देदो। <verse eid="ACT 14:27" /><verse number="28" style="v" sid="ACT 14:28" />तीहया ढेरेत दाड़ा लग तां चेला ह़ाते र्‌या।<verse eid="ACT 14:28" /></para>
  <chapter eid="ACT 14" />
  <chapter number="15" style="c" sid="ACT 15" />
  <para style="s">यरुसलेम नी बठक</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 15:1" />अळतेण थोड़ाक माणहु युहद्‌या ह़ेर मे गेथा अंताकीया आवीन भरहो करन्‌या भाय-बेन्‌या ने ह़ीकाड़वा बाज ज्‌या: “कदीम मुसा नी रीतीन अनसारे तमारु खतनु नी हये ता तमु छुटकारो नी हात कर सको।” <verse eid="ACT 15:1" /><verse number="2" style="v" sid="ACT 15:2" />आना बारा मे पोलुस अने बरनाबास तीमनी वात पोर राजी नी हता करीन तीहया पोलुस नो अने बरनाबास नो वीरोद कर्‌या, अने वात मे जखड़ी पड़ ज्‌या। ता आहयु ठेराया, के पोलुस, अने बरनाबास, अने तीमनी मे गेथा थोड़ाक माणहु आहयी वात ना बारा मे नेवताळान्‌तां अने डायलान्‌तां यरुसलेम ह़ेर जाय।<verse eid="ACT 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 15:3" />अने मंडळी ना माणहु तीमने थोड़ेक तक मेकवा ज्‌या; अने तीहया फीनीके अने सामर्‌या मे हतीन आड़जात्‌या ने मन फीराव्‌वा नी खबर ह़मळावता ज्‌या, अने आखा भरहो करन्‌या भायु आहयी खबर सी घण-जबर खुस हया। <verse eid="ACT 15:3" /><verse number="4" style="v" sid="ACT 15:4" />अने जत्‌यार तीहया यरुसलेम मे पुग्‌या, ता मंडळी ना माणहु, अने नेवताळा, अने डायला तीमने खुसी भेळ मळ्‌या, अने तीहया देखाड़्‌या के भगवान तीमनी ह़ाते हय्‌न केवा-केवा काम करलो। <verse eid="ACT 15:4" /><verse number="5" style="v" sid="ACT 15:5" />पण फरीसी पंथवाळा मे गेथा थोड़ाक माणहु जे भरहो करला हता, तीमनी मे गेथा थोड़ाक उठीन केदा, “ईमने खतना कराव्‌वा अने मुसा ना कायदा मानवा नो हुकम आपवा जोवे।”<verse eid="ACT 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 15:6" />ता नेवताळा अने डायला आहयी वात ना बारा मे वीच्‌यार करवा करीन एक्‌ठा हया। <verse eid="ACT 15:6" /><verse number="7" style="v" sid="ACT 15:7" /><note caller="+" style="x"><char style="xo" closed="false">15:7 </char><char style="xt" closed="false"><ref loc="ACT 10:1-43">नेवताळा ना काम 10:1-43</ref></char></note>जत्‌यार पतरस ढेरेत वार तक झटा-पटी हय जवान अळतेण उबो हय्‌न तीमने केदो, “ए भायु, तमु जाणो, के ढेरेत दाड़ा पेले, भगवान तमारी मे गेथो मने टाळ लेदो, के मे आड़जात्‌या ने खुस-खबर नो बोल ह़मळावु अने ह़मळीन भरहो करे। <verse eid="ACT 15:7" /><verse number="8" style="v" sid="ACT 15:8" /><note caller="+" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="ACT 10:44">नेवताळा ना काम 10:44</ref>; <ref loc="ACT 2:4">2:4</ref></char></note>अने आखा मन ने पारखवा वाळो भगवान ईमने बी आपणीन तेम चोखली आत्‌मा नो वाटो आपीन ईमना बारा मे गवाय देय; <verse eid="ACT 15:8" /><verse number="9" style="v" sid="ACT 15:9" />अने तीमना भरहा नी लारे तीमनु मन चोखु कर्‌यो, अने तीमनी अने अमारी वच मे कंय फरक नी राख्‌यो। <verse eid="ACT 15:9" /><verse number="10" style="v" sid="ACT 15:10" />ता हाव तमु भगवान ने काहा पारखी र्‌या? अने चेला ना बोचाटा मे मुसा ना कायदा ना वळा मेलीन काहा भार बणाय र्‌या, जे वळा ने आपणा आड़ा-बुड़ा लग नी उचल्‌या? <verse eid="ACT 15:10" /><verse number="11" style="v" sid="ACT 15:11" />नी, अमारो आहयो पक्‌को भरहो से के जे रीते तीहया मालीक ईसु नी दयान लारे पाप मे गेथा छुटकारो हात करहे; तीहयीत रीते आपणु हात करहु।”<verse eid="ACT 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 15:12" />तीहया आखा होगा हय्‌न बरनाबास अने पोलुस नी वात ह़मळवा बाज र्‌या हता। अने तीहया सेलाण्‌या ना अने सेल-भात्‌या जुदा-कामु ना बारा मे केवा बाज र्‌या हता, जे सेलाण्‌या अने सेल-भात्‌या जुदा-कामु भगवान तीमनी लारे आखी जाती ना माणहु अगळ देखाड़लो हतो। <verse eid="ACT 15:12" /><verse number="13" style="v" sid="ACT 15:13" />साउल अने पोलुस की देदा अने अळतेण याकुब केवा बाज ज्‌यो, ए भायु, अने बेन्‌या हाव मारी वात ह़मळो। <verse eid="ACT 15:13" /><verse number="14" style="v" sid="ACT 15:14" />सीमोन आमने देखाड़्‌यो के भगवान आड़जात्‌या माणहु पोर गीण करीन आह़फा ना नाम जुगु टाळ लेदो। <verse eid="ACT 15:14" /><verse number="15" style="v" sid="ACT 15:15" />अने आहयी वात भगवान वगे गेथा वात केण्‌या माणहु नी वात सी मेळ बी खाय, जीसम तीमनी कीताप मे लीखलु से,<verse eid="ACT 15:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="ACT 15:16" />आनीन अळतेण मे आवीन दावुद ना</para>
  <para style="q2" vid="ACT 15:16">ओदरला देस ने पासो बणावही,</para>
  <para style="q1" vid="ACT 15:16">अने तीना जुन्‌ला ह़ुनह़ान घोर ने</para>
  <para style="q2" vid="ACT 15:16">अळी पासो मजबुत बांदही।<verse eid="ACT 15:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ACT 15:17" />जीनी सी बचला आड़जात्‌या माणहु मालीक ने ह़ोदे तेम,</para>
  <para style="q2" vid="ACT 15:17">जे मारा नाम ना केवाये।<verse eid="ACT 15:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ACT 15:18" />आहयी वात तीहयोन-तीहयो मालीक केय, जे पेल्‌ना वारा मे कळ घड़ायी तां गेथो पीड़ीडीट केतो आय र्‌यो।<verse eid="ACT 15:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 15:19" />“एतरे मारी ह़ला आहयी से” के “जे आड़जात्‌या मे गेथा भगवान भणी वळ र्‌या तीमने आपणु वेला नी पाड़वा जोवे। <verse eid="ACT 15:19" /><verse number="20" style="v" sid="ACT 15:20" />बाखीन आपणु ने तीमनीन्‌तां चीट्‌ठी लीख मोकलवा जोवे के, तीहया तीहयु खाणु नी खाय, जे रीती नी अनसारे वीटळ्‌ळु से, काहाके तीहयु मुर्‌ती पोर चड़ावलु से, अने छीनाळु सी छेटा रेय, अने गळु डाबीन मारला काना बी जानवर नु माह अने लोय नी खाय। <verse eid="ACT 15:20" /><verse number="21" style="v" sid="ACT 15:21" />काहाके पेल्‌ना वारा मे गेथात मुसा ना कायदा नो परच्‌यार करन्‌या ह़ेर-ह़ेर मे रीन। अने तीहया अराम ना दाड़ाडीट तीमना भक्‌ती ना घोर मे मुसा ना कायदा नी कीताप ह़मळावे।”<verse eid="ACT 15:21" /></para>
  <para style="s">आड़जात्‌या भरहो करन्‌या ने चीट्‌ठी लीखे</para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 15:22" />आहयी वात ह़मळीन आखी मंडळी ना माणहु ने, ईसु ना नेवताळा ने अने पुडारी ने वारु लाग्‌यु, अने तीहया वीच्‌यार काड्‌या के आपणी मे गेथा थोड़ाक माणहु टाळया। अने तीहया यहुदा ने टाळ्‌या, जे बरसबा केवाये। अने सीलास ने टाळ्‌या, जे तीहया भायु मे मुख्‌यो हतो; अने तीमने पोलुस अने बरनाबास ह़ाते अंताकीया मे मोकल्‌या। <verse eid="ACT 15:22" /><verse number="23" style="v" sid="ACT 15:23" />अने आहयी चीट्‌ठी लीखीन तीमना हाते मोकल्‌या, तीनी मे लीखलु हतु:</para>
  <para style="p" vid="ACT 15:23">“ए अंताकीया मे, अने सीरीया मे, अने कीलीकीया मे रेण्‌या आड़जात्‌या भायु, तमने ईसु ना नेवताळा वगे गेथु अने पुडारी वगे गेथु आवही अने आवजो कीया! <verse eid="ACT 15:23" /><verse number="24" style="v" sid="ACT 15:24" />आमु आहयु ह़मळ्‌ळा से के अमारी मे गेथा थोड़ाक माणहु तमारीन्‌तां आवीन जेवी-तेवी वात कीन भंगलाड़ देदला से; अने तमारा जीव ने घबराड़ देदला से। पण आमु तीमने हुकम नी आपला हता। <verse eid="ACT 15:24" /><verse number="25" style="v" sid="ACT 15:25" />एतरे आमु आखान-आखा एक-मन्‌या हय्‌न वीच्‌यार काडला से के आमु अमारी मे गेथा जे माणहु ने टाळला से, तीहया माणहु ने अमारा मोंगाळ्‌ळा बरनाबास अने पोलुस भेळता तमारीन्‌तां मोकलया तेम। <verse eid="ACT 15:25" /><verse number="26" style="v" sid="ACT 15:26" />आहया माणहु एवा से, जे मालीक ईसु मसी ना नामे आह़फा नो जीव लग आपवा तीयार हय जेला हता। <verse eid="ACT 15:26" /><verse number="27" style="v" sid="ACT 15:27" />अने आमु ईमनी ह़ाते यहुदा अने सीलास ने मोकल्‌ला से, आहया तमने मोडे आखी वात की देहे। <verse eid="ACT 15:27" /><verse number="28" style="v" sid="ACT 15:28" />चोखली आत्‌मा ने अने आमने तालेत मालम पड़्‌यु के आहयी काम नी वात सोड़ीन तमारी पोर कानो अळी भार नी मेलवा जोवे: <verse eid="ACT 15:28" /><verse number="29" style="v" sid="ACT 15:29" />अने काम नी वात आहयी से, तमु मुर्‌ती पोर चड़ावलु खाणु नी खाजो। अने गळु डाबीन मारला काना बी जानवर नु माह नी खाजो, अने काना बी जानवर नु लोय नी खाजो। अने छीनाळु नी करजो। आसम करीन तमु आहयी आखी वात सी सेटा रेजो ता तमारु भलु हयहे।”<verse eid="ACT 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 15:30" />आसम करीन तीहया आहयी चीट्‌ठी लीन अंताकीया ज्‌या, अने तां जाय्‌न तीहया आखा माणहु ने भेळा करीन तीहयी चीट्‌ठी तीमने आप देदा। <verse eid="ACT 15:30" /><verse number="31" style="v" sid="ACT 15:31" />अने तीहया ते चीट्‌ठी मे लीखलु भणीन घण खुस हय ज्‌या। <verse eid="ACT 15:31" /><verse number="32" style="v" sid="ACT 15:32" />यहुदा अने सीलास जे भगवान वगे गेथी वात केण्‌या माणहु हता, तीहया बी ढेरेत वात कीन तीमने तीहया भायु ने हीम्‌मत आप्‌या। अने तीमना भरहा ने टणको कर्‌या। <verse eid="ACT 15:32" /><verse number="33" style="v" sid="ACT 15:33" />अने तीहया थोड़ाक दाड़ा तां र्‌या, अने अळतेण तीहया ते भायु ने आवह़ु अने आवजो कीन, जे तीमने मोकल्‌ला तीनीन तां पासा जत र्‌या। <verse eid="ACT 15:33" /><verse number="34" style="v" sid="ACT 15:34" />पण सीलास ने तां रेवा वारु लाग्‌यु।<verse eid="ACT 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 15:35" />अने पोलुस अने बरनाबास अंताकीया मे थोड़ाक दाड़ा र्‌या: अने ढेरेत बीजा माणहु ह़ाते रीन तीहया माणहु ने ह़ीकाड़ता जाय्‌न मालीक ईसु नी खुस-खबर ह़मळाया।<verse eid="ACT 15:35" /></para>
  <para style="s">पोलुस अने बरनाबास अलग हये</para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 15:36" />थोड़ाक दाड़ा हय ज्‌या अने अळतेण पोलुस बरनाबास ने केदो “चाल, जे-जे ह़ेर मे आपणु खुस-खबर ह़मळाया, तीहया-तीहया ह़ेर मे जाय्‌न ईसु पोर भरहो करन्‌या भायु ने देखता के तीहया ह़ु करवा बाज र्‌या।” <verse eid="ACT 15:36" /><verse number="37" style="v" sid="ACT 15:37" />तत्‌यार बरनाबास नी हेर आहयी हती, के आपणु युहन्‌ना ने बी ह़ाते ली जता। जे मरकुस बी केवायतो हतो। <verse eid="ACT 15:37" /><verse number="38" style="v" sid="ACT 15:38" /><note caller="+" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="ACT 13:13">नेवताळा ना काम 13:13</ref></char></note>पण पोलुस तीने ह़ाते लीजवा वारु नी ह़मज्‌यो, काहाके तीहयो पेले पमफुल्‌या मे सात सोड़ देदलो अने मालीक भगवान ना काम मे सात नी देदो। <verse eid="ACT 15:38" /><verse number="39" style="v" sid="ACT 15:39" />अने तीमनी मे झगड़ो हय ज्‌यो: अने बरनाबास मरकुस ने लीन मोट्‌लु ढुंड्‌यु मे बहीन कुपरुस मे जत र्‌यो। <verse eid="ACT 15:39" /><verse number="40" style="v" sid="ACT 15:40" />पण पोलुस, सीलास ने टाळ्‌यो, अने भायु तीनी जुगु भगवान पांह दया मांगीन तीने मालीक ना ह़ात मे ह़ोप देदा। <verse eid="ACT 15:40" /><verse number="41" style="v" sid="ACT 15:41" />अने पोलुस सीरीया अने कीलीकीया ह़ेर ना परगणा मे ईसु नी मंडळी मे जाय्‌न तीमने ईसु ना भरहा मे टणका कर्‌यो।<verse eid="ACT 15:41" /></para>
  <chapter eid="ACT 15" />
  <chapter number="16" style="c" sid="ACT 16" />
  <para style="s">पोलुस तीमुथीयुस ने ह़ाते ली जाय</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 16:1" />अळतेण पोलुस, दीरबे अने लुस्‌तरा मे बी ज्‌यो। तां तीमुथीयुस नाम नो एक चेलो हतो, तीनी आय्‌ह युहदी हती, पण तीनो बाह युनानी हतो। <verse eid="ACT 16:1" /><verse number="2" style="v" sid="ACT 16:2" />आहयो तीमुथीयुस लुस्‌तरा अने ईकुनीयुम वाळा भाय-बेटा मे वारली वात मे नामह़ाद्‌यो हतो। <verse eid="ACT 16:2" /><verse number="3" style="v" sid="ACT 16:3" />पोलुस नी मरजी हती के तीमुथीयुस पोलुस ह़ाते आवे; अने जे युहदी माणहु तीहया जागा मे हता, तीमना कारण सी तीनु खतनु कर्‌यो, काहाके तीहया आखा जाणता हता, के तीनो बाह युनानी हतो। <verse eid="ACT 16:3" /><verse number="4" style="v" sid="ACT 16:4" />अने ह़ेर-ह़ेर मे जाय-जाय्‌न तीहया ते कायदा ने जे यरुसलेम ना नेवताळा अने डायला जे ठेरावला हता, मानवा करीन तीमनीन्‌तां पुगाड़ता हता। <verse eid="ACT 16:4" /><verse number="5" style="v" sid="ACT 16:5" />आसम करीन ईसु नी मंडळी वाळा भरहा मे टणका हयता ज्‌या, अने गीनती मे दाड़ीन वदता ज्‌या।<verse eid="ACT 16:5" /></para>
  <para style="s">त्‌रोवास मे पोलुस नो दरसन</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 16:6" />अने पोलुस अने तीना ह़ाती फुरग्‌या अने गलातीया देस मे हय्‌न ज्‌या, अने चोखली आत्‌मा तीमने आसीया मे भगवान ना बोलु नो परच्‌यार नी करजो करीन केदी। <verse eid="ACT 16:6" /><verse number="7" style="v" sid="ACT 16:7" />अने अळतेण तीहया मुसीया नी काकड़ धेड़े पुगीन, बीतुनीया देस मे जवा हींड्‌या; पण ईसु नी आत्‌मा तीमने जवा नी देदी। <verse eid="ACT 16:7" /><verse number="8" style="v" sid="ACT 16:8" />अने तीहया मुसीया छेकीन त्‌रोवास आया। <verse eid="ACT 16:8" /><verse number="9" style="v" sid="ACT 16:9" />अने तां पोलुस राते एक ह़पनु देख्‌यो के एक मकीदुनीया वाळो माणेह उबो हय र्‌यो, अने पोलुस ने रावण्‌या करीन आहयु की र्‌यो के “दर्‌या वणकीन मकीदुनीया परगणा मे आवीन अमारी मदत कर।” <verse eid="ACT 16:9" /><verse number="10" style="v" sid="ACT 16:10" />पोलुस आहयु ह़पनु देख लेदो अने अळतेण आमु मकीदुनीया मे आहयु ह़मजीन जवा हींडता हता के भगवान आमने तां खुस-खबर ह़मळावा करीन मोकल्‌लो से।<verse eid="ACT 16:10" /></para>
  <para style="s">फीलीपुस मे लुदीया नु मन बदले</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 16:11" />त्‌रोवास गेथा आमु मोट्‌ला ढुंड्‌या मे बहीन ह़ुदा-ह़ट सुमात्‌राके आया अने तां गेथा बीजा दाड़े नीयापुलीस आया। <verse eid="ACT 16:11" /><verse number="12" style="v" sid="ACT 16:12" />अने आमु नीयापुलीस गेथा फीलीपी पुग्‌या, जे मकीदुनीया परगणा नु मुख्‌यु ह़ेर से; अने आमु थोड़ाक दाड़ा तां र्‌या। <verse eid="ACT 16:12" /><verse number="13" style="v" sid="ACT 16:13" />युहदी माणहु ना अराम ना दाड़े आमु आहयु ह़मजीन ह़ेर नु झापलु वणकीन ह़ेर गेथा बारा, नंदी धेड़े आया के तां युहदी माणहु जुगु कानु वीन्‌ती करवा नु घोर हहे; अने तां पुगीन आमु तां भेळा हय रेला थोड़ाक बयरा ह़ाते वात करवा बाज ज्‌या। <verse eid="ACT 16:13" /><verse number="14" style="v" sid="ACT 16:14" />अने लुदीया नाम नी एक थुवातीरा ह़ेर नी बयर जामण्‌या लुगड़ा वेचवा वाळी एक भगत बयर ह़मळी री हती, मालीक भगवान तीनु मन उगाड़ देदो, के तीहयी पोलुस नी वात पोर मन लगाड़े। <verse eid="ACT 16:14" /><verse number="15" style="v" sid="ACT 16:15" />जत्‌यार तीहयी आह़फी ना घोरबाल्‌या भेळ पाणी मे बपतीस्‌मा लेदी, ता अमारी सी वीन्‌ती करी, के “कदीम तमु मने मालीक नी भक्‌ती करन्‌याण ह़मजी र्‌या हय, ता मारा घोर मे रेवो, अने तीहयी आमने टीणे पड़ीन ली जी।”<verse eid="ACT 16:15" /></para>
  <para style="s">पोलुस अने सीलास जेल मे</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 16:16" />एक दाड़े जत्‌यार आमु वीन्‌ती करन्‌या जागे जवा बाज र्‌या हता, ता आमने एक पावर्‌याण भेटी; तीनी मे आव्‌वा वाळी वात केण्‌यो भुत भराय रेलो; अने तीहयी ते भुतड़ान लारे माणहु ने आव्‌वा वाळी वात देखाड़त्‌ली अने तीना मालक्‌या जुगु ढेरेत पय्‌हा कमाय्‌न आपत्‌ली। <verse eid="ACT 16:16" /><verse number="17" style="v" sid="ACT 16:17" />तीहयी पोलुस अने अमारी पसळ-पसळ आवीन आड़ती जाय्‌न केदी, “आहया माणहु आखा मे उचे रेण्‌या भगवान ना चाकर्‌या से, अने तमने छुटकारा नी वाट नी खबर ह़मळावे।” <verse eid="ACT 16:17" /><verse number="18" style="v" sid="ACT 16:18" />तीहयी घणा दाड़ा लग आसम करती री; पण सेल्‌ली वार पोलुस दुखी हय्‌न पासो फीरीन ते भुत ने केदो, “मे तने ईसु मसी ना नामे आनीम गेथो नीकळीन जवा नो हुकम आपु” अने तीहयो भुत तेतरी घड़ी तीनी मे गेथो नीकळी ज्‌यो। <verse eid="ACT 16:18" /><verse number="19" style="v" sid="ACT 16:19" />जत्‌यार तीना मालक्‌या देख्‌या के अमारी कमाय नी आह जत री, ता तीहया पोलुस अने सीलास ने धरीन रोहा ना मेळ्‌या पोर मुख्‌यान्‌तां घीहड़ीन ली ज्‌या। <verse eid="ACT 16:19" /><verse number="20" style="v" sid="ACT 16:20" />तीहया पोलुस अने सीलास ने नीयाव करन्‌यान तां ली ज्‌या अने तीने केदा, “आहया अदमी युहदी से अने अमारा ह़ेर ना माणहु मे गरबड़ी कर र्‌या। <verse eid="ACT 16:20" /><verse number="21" style="v" sid="ACT 16:21" />अने आहया एसवी रीती-भाती ना बारा मे भणाय र्‌या, जीने पाळवा अने मानवा आपणु रोमी जुगु ताले नी हय।” <verse eid="ACT 16:21" /><verse number="22" style="v" sid="ACT 16:22" />तत्‌यार भीड़ मे वाळा माणहु पोलुस अने सीलास भणी हुहड़ीन आय लाग्‌या।</para>
  <para style="p" vid="ACT 16:22">अने नीयाव करन्‌या तीमना लुगड़ा फाड़ीन डील पोर गेथा सेटा कर देदा, अने तीमने चपकाटवा नो हुकम आप्‌या। <verse eid="ACT 16:22" /><verse number="23" style="v" sid="ACT 16:23" />अने तीहया पोलुस अने सीलास ने घण-जबर चपकाटीन, तीमने जेल मे बुज देदा; अने जेल रखवाळ ने केदा, “ईमने वारु चेतीन भाळजे।” <verse eid="ACT 16:23" /><verse number="24" style="v" sid="ACT 16:24" />हुकम ह़मळीन जेल रखवाळ्‌यो तीमने मोय ना कोपरा मे बुज देदो अने तीमना पोगु ने लाकड़ा मे ठोक देदा।<verse eid="ACT 16:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 16:25" />अरदीक राते पोलुस अने सीलास भगवान ह़ाते वीन्‌ती करीन भगवान ना गुण गाव्‌वा बाज र्‌या हता, अने बीजा केदड़ा ह़मळी र्‌या हता। <verse eid="ACT 16:25" /><verse number="26" style="v" sid="ACT 16:26" />अने तत्‌यारुत तां उचकाहलु घण ज्‌योरे धरती हीली अने जेल ना पाया हील पड़्‌या; अने तत्‌यारु जेल ना झापला उगड़ी ज्‌या; अने आखा केदड़ा ना हातकड़्‌या अने पोगकड़्‌या उगड़ी ज्‌या। <verse eid="ACT 16:26" /><verse number="27" style="v" sid="ACT 16:27" />जेल नो रखवाळ्‌यो जाग ज्‌यो, अने जेल नु झापलु उगड़लु देखीन आहयु ह़मज्‌यो के केदड़ा नाह जेला से। एतरे तीहयो मीयान मे गेथी तलवार नीकाळीन आह़फा ने तलवार सी मारवा हींडतो हतो। <verse eid="ACT 16:27" /><verse number="28" style="v" sid="ACT 16:28" />पण पोलुस ज्‌योरेत आड़ीन तीने केदो, “तु आह़फा ने मारीन आह़फा नु नुकसान ना करे, काहाके आमु आञेत से।”<verse eid="ACT 16:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 16:29" />ता तीहयो जेल रखवाळ्‌यो दीवो मंगाड़ीन मोय दवड़ीन ज्‌यो, अने कापतो जाय्‌न पोलुस अने सीलास ना पोगु मे पड़्‌यो। <verse eid="ACT 16:29" /><verse number="30" style="v" sid="ACT 16:30" />अने तीहयो तीमने बारा लावीन केदो, “ए मालक्‌या छुटकारो ह़ात करवा करीन मने ह़ु करवा पड़हे?”<verse eid="ACT 16:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 16:31" />तीहया केदा, “तु मालीक ईसु पोर भरहो करे, ता तने अने तारा घोरन्‌या ने छुटकारो जड़हे।” <verse eid="ACT 16:31" /><verse number="32" style="v" sid="ACT 16:32" />अने पोलुस अने सीलास ते जेल रखवाळ्‌या ने अने तीना आखा घोराणा ने मालीक ईसु नो बोल ह़मळाया। <verse eid="ACT 16:32" /><verse number="33" style="v" sid="ACT 16:33" />अने तीहयो जेल नो रखवाळ्‌यो; तीहयीत राते तीमने ली जाय्‌न तीमना घाव धोयो, अने तीहयो तत्‌यारुत आह़फा ना घोराणा भेळ बपतीस्‌मा लेदो। <verse eid="ACT 16:33" /><verse number="34" style="v" sid="ACT 16:34" />ता तीहयो पोलुस अने सीलास ने आह़फा ना घोर ली ज्‌यो, अने तीमने खाणु खवाड़्‌यो, अने आह़फा ना आखा घोरबाल्‌या ह़ाते खुसी मनायो; काहाके तीहया भगवान पोर भरहो कर्‌या।<verse eid="ACT 16:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 16:35" />ह़वारे हयतेत रोमी अदीकार्‌या आह़फा ना सीपायड़ा ने आहयु की मोकल्‌या के “आहया माणहु ने सोड़ देवो।”<verse eid="ACT 16:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 16:36" />जेल नो रखवाळ्‌यो पोलुस ने आहयी खबर ह़मळायो, “रोमी अदीकार्‌या तमने सोड़वा नो हुकम की मोकल्‌ला से। एतरे हाव तमु सुक सी बारा नीकळीन जत रेवो।”<verse eid="ACT 16:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 16:37" />पण पोलुस सीपायड़ा ने केदो, “आमु रोमी से, ते बी अमारी पोर लगाड़ला गुना नी चोकसी कर्‌या वगर आमने आखा अगळ चापका देवाड़्‌या, अने जेल मे कुंड देदा, अने हाव आमने काहा मोकली र्‌या? आसम आमु नी जीया, पण तीहयात आवीन आमने बारा लीजवा जोवे।”<verse eid="ACT 16:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="ACT 16:38" />सीपायड़ा अदीकार्‌या ने आहयी वात ह़मळाया। अने पोलुस अने सीलास रोमी से करीन बीही ज्‌या। <verse eid="ACT 16:38" /><verse number="39" style="v" sid="ACT 16:39" />अने तीहया रोमी अदीकार्‌या आवीन माफी मांग्‌या, अने तीमने जेल मे गेथा बारा लावीन ह़ेर ने सोड़ीन जत रेवो केदा। <verse eid="ACT 16:39" /><verse number="40" style="v" sid="ACT 16:40" />पोलुस अने सीलास जेल मे गेथा नीकळीन लुदीया ना घोर ज्‌या, अने भरहो करन्‌या भाय-बेटा ने भेटीन तीमने हीम्‌मत नी वात कीन तां गेथा चाल पड़्‌या।<verse eid="ACT 16:40" /></para>
  <chapter eid="ACT 16" />
  <chapter number="17" style="c" sid="ACT 17" />
  <para style="s">थीसलुनीकीयो ह़ेर मे पोलुस अने सीलास</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 17:1" />पोलुस अने सीलास अम्‌फीपुलीस अने अपुलोनीया ह़ेर छेकीन थीसलुनीकीयो मे आया। ता एक युहदी माणहु नु भक्‌तीन घोर हतु। <verse eid="ACT 17:1" /><verse number="2" style="v" sid="ACT 17:2" />अने पोलुस आह़फा नी रीती नी अनसारे भक्‌ती ना घोर मे ज्‌यो, अने तीहयो अराम ना तीन दाड़ा लग तीमनी ह़ाते खरला सास्‌तर मे गेथी वात देखाड़ीन पुरावो दी-दीन वात मे जखड़ी पड़्‌यो। <verse eid="ACT 17:2" /><verse number="3" style="v" sid="ACT 17:3" />अने सास्‌तर ने सरल रीती सी ह़मजाड़तो हतो, के ईसु मसी ने दुख झेलवा, अने मर्‌या-ह़र्‌या मे गेथो जीवतो हयवा नु टकायलु से; अने “आहयोत ईसु मसी से” जीना बारा मे, मे परच्‌यार करु। <verse eid="ACT 17:3" /><verse number="4" style="v" sid="ACT 17:4" />तीमनी मे गेथा थोड़ाक माणहु जे राजी हय जेला हता, पोलुस अने सीलास ह़ाते भेसकाय ज्‌या। अने भगवान नी भक्‌ती करवा वाळा घणा ढेरका युनानी माणहु बी तीमनी ह़ाते भेसकाय ज्‌या, आमनी मे ढेरेत बयरा बी हता।<verse eid="ACT 17:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 17:5" />पण युहदी माणहु डहवाय करीन हाट मे वाळा लुच्‌चा-गुंडा माणहु ने भेळा करीन हुहड़ीन आया, अने यासोन ना घोर आय लाग्‌या, अने तीहया कोसीत करवा बाज ज्‌या, के पोलुस अने सीलास ने माणहु अगळ लाव्‌वा हींडता हता। <verse eid="ACT 17:5" /><verse number="6" style="v" sid="ACT 17:6" />पण तीमने यासोन ना घोर मे नी जड़्‌या, ता तीहया यासोन अने तां वाळा बीजा भायु ने घीहड़ीन ह़ेर ना नीयाव करन्‌यान तां ली ज्‌या, अने आड़ीन केदा, “आहया माणहु आखी कळी मे गरबड़ी कर देद्‌ला से, अने हाव आञे बी आय लाग्‌या। <verse eid="ACT 17:6" /><verse number="7" style="v" sid="ACT 17:7" />अने यासोन तीमने आह़फा ना घोर मे थंगाड़ र्‌यो। तीहया आखा केसर ना हुकम नो वीरोद करे, अने केय के एक राजो अळी से जीनु नाम ईसु से।” <verse eid="ACT 17:7" /><verse number="8" style="v" sid="ACT 17:8" />आहयु ह़मळीन ह़ेर ना माणहु अने ह़ेर ना अदीकार्‌या घण जादा खीजवाय ज्‌या। <verse eid="ACT 17:8" /><verse number="9" style="v" sid="ACT 17:9" />तीहया यासोन अने तीनी ह़ाते वाळा बीजा पांह डंड लेदा, अने तीमने सोड़ देदा।<verse eid="ACT 17:9" /></para>
  <para style="s">बीर्‌या ह़ेर मे पोलुस</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 17:10" />भरहो करन्‌या भायु, तीहयीत राते पोलुस अने सीलास ने बीर्‌या मे मोकली देदा: अने तीहया बीर्‌या ह़ेर मे पुगीन युहदी ना भक्‌ती ना घोर मे ज्‌या। <verse eid="ACT 17:10" /><verse number="11" style="v" sid="ACT 17:11" />आहया थीसलुनीकीयो ह़ेर वाळा युहदी गेथा जादा वारु हता, अने तीहया घण-जबर मन लगाड़ीन भगवान नो बोल ह़मळ्‌या, अने पोलुस केदो तीहयी वात पारखवा करीन खरला सास्‌तर मे भणीन देखता हता। <verse eid="ACT 17:11" /><verse number="12" style="v" sid="ACT 17:12" />तीमनी मे ढेरेत माणहु, अने युनानी मे मुखी बयरा, अने घणा अदमी बी भरहो कर्‌या। <verse eid="ACT 17:12" /><verse number="13" style="v" sid="ACT 17:13" />जत्‌यार थीसलुनीकीयो मे रेवा वाळा युहदी माणहु ने मालम पड़ ज्‌यु के पोलुस बीर्‌या मे भगवान ना बोलु नो परच्‌यार करवा बाज ज्‌यो, ता तीहया तां आय लाग्‌या अने माणहु ने भड़कावीन तीमनो जोर वदाड़वा बाज ज्‌या। <verse eid="ACT 17:13" /><verse number="14" style="v" sid="ACT 17:14" />एतरे ईसु पोर भरहो करन्‌या भायु पोलुस ने तत्‌यारु तु दर्‌या धेड़्‌ये जत रे, करीन केदा; पण सीलास अने तीमुथीयुस तां री ज्‌या। <verse eid="ACT 17:14" /><verse number="15" style="v" sid="ACT 17:15" />पोलुस ने, भरहो करन्‌या भायु मेकवा करीन अथेंस लग ज्‌या। अने पोलुस सीलास अने तीमुथीयुस जुगु आहयी वात की मोकल्‌यो के, तमु छोटा आवजो।<verse eid="ACT 17:15" /></para>
  <para style="s">एथेंस ह़ेर मे पोलुस</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 17:16" />जत्‌यार पोलुस अथेंस ह़ेर मे तीमुथीयुस अने सीलास नी वाट जोय र्‌यो हतो, ता तीहया अथेंस ह़ेर मे ढीगारो देवु ना मुरत्‌या देखीन पोलुस ने आह़फा ना जीव मे घणो दुख लाग्‌यो। <verse eid="ACT 17:16" /><verse number="17" style="v" sid="ACT 17:17" />एतरे पोलुस युहदी भक्‌ती ना घोर मे रीन युहदी माणहु ह़ाते अने आड़जात्‌या माणहु ह़ाते, जे भगवान नी भक्‌ती करन्‌या हता, दाड़ीन वात मे जखड़ी पड़तो हतो। अने चोवराया पोर जे माणहु भेटता हता, तीमनी ह़ाते बी वात मे जखड़ी पड़तो हतो। <verse eid="ACT 17:17" /><verse number="18" style="v" sid="ACT 17:18" />तां ईपीकुरी अने स्‌तोईकी मास्‌तर्‌या हता, अने तीहया पोलुस ह़ाते जखड़ी पड़्‌या, अने तीमनी मे थोड़ाक केदा, “आहयो, झपाट्‌यो ह़ु केवा हींडे?” अने बीजा केदा, “आहयो बीजा देवता नो परच्‌यार करन्‌यो मालम पड़े।” काहाके पोलुस, ईसु ना बारा मे आहयी ह़ीकापण आपत्‌लो के, ईसु मर्‌या-ह़र्‌या मे गेथो जीवतो हय्‌न बठो हय जेलो से। <verse eid="ACT 17:18" /><verse number="19" style="v" sid="ACT 17:19" />एतरे तीहया पोलुस ने धरीन अरीयुपगुस नाम ना ह़ेर नी एक बठक मे ली ज्‌या अने पुछ्‌या, “तु आहयी नवली ह़ीकापण माणहु ने आपवा बाज र्‌यो, तीहयी ह़ु से। <verse eid="ACT 17:19" /><verse number="20" style="v" sid="ACT 17:20" />काहाके तु आमने जे वात आमु ह़मळ्‌या नी तीहयी वात ह़मळावे, एतरे आमु जाणवा हींड र्‌या, के आनु मतलब ह़ु से?” <verse eid="ACT 17:20" /><verse number="21" style="v" sid="ACT 17:21" />तां रेण्‌या आखा अथेंस ना माणहु अने पारका माणहु नवली-नवली वात केवा मे अने ह़मळवा मे टेम लगाड़त्‌ला। आहयी वात ने सोड़ीन बीजु तीमनु कामेत नी हतु।<verse eid="ACT 17:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 17:22" />तत्‌यार पोलुस अरीयुपगुस नाम ह़ेर नी बठक मे उबो हय्‌न केदो, ए अथेंस वाळा माणहु! मे देखवा बाज र्‌यो के तमु आखी भाते धरमी से। <verse eid="ACT 17:22" /><verse number="23" style="v" sid="ACT 17:23" />मे ह़ेर मे फीरतो जाय्‌न तमारा भक्‌ती करवा ना जागा ने देखवा बाज र्‌यो हतो, ता मने एक आसवी वेदी देखाव पड़ी, ते वेदी पोर आहयु लीखलु हतु, अंजाणला भगवान जुगु। एतरे तमु तीने जाण्‌या वगर तीनी भक्‌ती कर र्‌या, तीना बारा मे, मे तमने ह़मळावु। <verse eid="ACT 17:23" /><verse number="24" style="v" sid="ACT 17:24" /><note caller="+" style="x"><char style="xo" closed="false">17:24 </char><char style="xt" closed="false"><ref loc="ACT 7:48">नेवताळा ना काम 7:48</ref></char></note>जे भगवान धरती अने तीनी मे जे कंय से, तीहयु आखु बणावलो से; अने जे ह़रग अने धरती नो मालीक से। तीहयो हाते बणावला मंदीरु मे नी रेय। <verse eid="ACT 17:24" /><verse number="25" style="v" sid="ACT 17:25" />तीने कानी बी चीज नी कसर नी हय, एतरे तीने कानी बी चीज नी जोवती, काहाके तीहयो आखा माणहु ने जीवाय अने जीवाय नो दम आपे, अने आखु आप्‌या करे। <verse eid="ACT 17:25" /><verse number="26" style="v" sid="ACT 17:26" />तीहयो ते एकी माणेह मे गेथो आखी जाती ना माणहु ने उबजाड़ीन बणायो; अने तीमने आखी धरती पोर रेवा आप देदो; तीहयो तीमनी जीव्‌वा नी टेम टाक देदो, अने तीमने रेवा ना जागा नी जां तीहया रेय काकड़ बांद देदो। <verse eid="ACT 17:26" /><verse number="27" style="v" sid="ACT 17:27" />आहयु आखु आनीन करते कर्‌यो के माणहु भगवान ने ह़ोदे, अने हय सके तीहया तीने तीनीन्‌तां तक पुगीन पाळे, ते बी तीहयो अमारी मे गेथो काना सी बी सेटो नी हय। <verse eid="ACT 17:27" /><verse number="28" style="v" sid="ACT 17:28" />जीसम कोय केदलु से</para>
  <para style="q1" vid="ACT 17:28">के तीनी मे जीवत्‌ला रीया, अने तीनी मे हींडया-फीरया, अने तीनी मे हजुर से।</para>
  <para style="m" vid="ACT 17:28">आहयीत रीते तमारात लीखण्‌या बी केदला से,</para>
  <para style="q1" vid="ACT 17:28">के आमु तीना सोरा-सोरी से।<verse eid="ACT 17:28" /></para>
  <para style="m">
    <verse number="29" style="v" sid="ACT 17:29" />एतरे भगवान ना सोरा-सोरी हय्‌न आपणु ने आहयु नी ह़मजवा जोवे के भगवान, माणहु ना वीच्‌यार सी ह़ोनु-चांदी, नी नीता दगड़ा नी बणावली मुर्‌तीन तेवो हहे। <verse eid="ACT 17:29" /><verse number="30" style="v" sid="ACT 17:30" />जत्‌यार माणहु भगवान ने नी जाणता हता, तीहयी टेमे भगवान धीयान नी देदो, पण हाव आखा जागे आखा माणहु ने मन फीराव्‌वा नो हुकम आपे। <verse eid="ACT 17:30" /><verse number="31" style="v" sid="ACT 17:31" />भगवान एक दाड़ो टाकलो से, तीहया दाड़े तीहयो आह़फा ना टाळला माणेह नी लारे सच्‌चाय सी कळी नो नीयाव करहे, अने आहयी वात नो पुरावो तीहयो तीहया माणहे ने मर्‌या-ह़र्‌या मे गेथो जीवाड़ीन एक-एक जणा ने आपलो से।<verse eid="ACT 17:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 17:32" />मर्‌या-ह़र्‌या मे गेथा पासा जीवता हयवा नी वात ह़मळीन थोड़ाक माणहु पोलुस नी हाही-ठट्‌टा करवा बाज ज्‌या, पण थोड़ाक बीजा माणहु केदा, “मर्‌या-ह़र्‌या मे गेथा पासा जीवता हयवा नी वात अळी पासा ह़मळवा हय र्‌या।” <verse eid="ACT 17:32" /><verse number="33" style="v" sid="ACT 17:33" />एतरे पोलुस तीमने रेवा दीन जत र्‌यो। <verse eid="ACT 17:33" /><verse number="34" style="v" sid="ACT 17:34" />पण ते बी थोड़ाक माणहु पोलुस नी वात पोर भरहो कर्‌या अने तीनी ह़ाते चाल पड़्‌या, तीमनी मे दीयुनुसीयुस हतो, तीहयो अरीयुपगुस नो एक मेहमर हतो, अने दमरीस नाम नी एक बयर हती, अने तीमनी ह़ाते अळी थोड़ाक माणहु हता।<verse eid="ACT 17:34" /></para>
  <chapter eid="ACT 17" />
  <chapter number="18" style="c" sid="ACT 18" />
  <para style="s">कुरीन्‌थुस ह़ेर मे पोलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 18:1" />अळतेण पोलुस अथेंस ह़ेर सोड़दीन कुरीन्‌थुस ह़ेर मे ज्‌यो। <verse eid="ACT 18:1" /><verse number="2" style="v" sid="ACT 18:2" />तां तीने एक अक्‌वीला नाम नो एक युहदी माणेह भेट्‌यो; तीनी पयदावारी पुन्‌तुस मे हयली हती, अने तीहयो तीनी लाडी पीरीस्‌कीला ह़ाते ईटली गेथो नवलो आवलो हतो, काहाके कलोदीयुस राजो आखा युहदी माणहु ने रोम ह़ेर मे गेथा नीकळी जावो करीन हुकम आपलो हतो, एतरे पोलुस तीमनीन्‌तां ज्‌यो। <verse eid="ACT 18:2" /><verse number="3" style="v" sid="ACT 18:3" />काहाके पोलुस अने तीमनो एकीत धंदो हतो; एतरे पोलुस तीमनी ह़ाते रीन काम करवा बाज ज्‌यो, अने तीमनो धंदो तम्‌बु बणाव्‌वा नो हतो। काहाके तीहया तम्‌बु बणावण्‌या हता। <verse eid="ACT 18:3" /><verse number="4" style="v" sid="ACT 18:4" />पोलुस अराम ना दाड़ाडीट युहदी माणहु ना भक्‌ती ना घोर मे जाय्‌न वात मे जखड़ी पड़तो हतो अने युहदी माणहु ने अने आड़जात्‌या माणहु ने ह़मजाड़तो हतो।<verse eid="ACT 18:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 18:5" />जत्‌यार सीलास अने तीमुथीयुस मकीदुनीया गेथा आया, ता पोलुस भगवान ना बोलु ह़मळवा झींग पड़ र्‌यो हतो, अने तीहयो युहदी माणहु अगळ आहयु केतो र्‌यो के ईसुत मसी से। <verse eid="ACT 18:5" /><verse number="6" style="v" sid="ACT 18:6" />बाखीन जत्‌यार तीहया माणहु पोलुस नो वीरोद करीन वाक काडता हता, ता पोलुस आह़फा नु डगलु झटकीन तीमने केदो, “तमारा मोत नो कारण तमुत से। मे वण-गुनाळ्‌ळो से, अने आनो जपापदार मे नी हय। हाव गेथो आड़जात्‌या माणहु मे ईसु नो परच्‌यार करवा जही।” <verse eid="ACT 18:6" /><verse number="7" style="v" sid="ACT 18:7" />तीहयो तीमने सोड़दीन आड़जात्‌या तीतुस युस्‌तुस नाम ना एक माणेह ना घोर ज्‌यो, तीहयो भगवान नी भक्‌ती करन्‌यो हतो। अने तीनु घोर भगवान ना भक्‌ती ना घोर ना ह़ाते चोटाय्‌न बांदलु हतु। <verse eid="ACT 18:7" /><verse number="8" style="v" sid="ACT 18:8" />भक्‌ती ना घोर नो मुखी कीरीस्‌पुस आह़फा ना आखा घोराणा भेळ मालीक पोर भरहो कर्‌यो; अने घणा ढेरका कुरन्‌थी ह़ेर वाळा माणहु बी पोलुस ना लारे ईसु ना बारा मे ह़मळीन मालीक पोर भरहो कर्‌या, अने बपतीस्‌मा लेदा।<verse eid="ACT 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 18:9" />मालीक ईसु तीहयीत राते ह़पना मे पोलुस ने आहयु केदो, “बीहे ना, पण भगवान नी वात केतो रे, अने होगो ना रेय। <verse eid="ACT 18:9" /><verse number="10" style="v" sid="ACT 18:10" />काहाके मे तारी ह़ाते से। अने कोय बी तारु नुकसान नी करे; काहाके आहया ह़ेर मे मारा घणा माणहु से।” <verse eid="ACT 18:10" /><verse number="11" style="v" sid="ACT 18:11" />एतरे पोलुस माणहु ने भगवान नी वात ह़ीकाड़तो जाय्‌न तां एक साल ने छोव मयना र्‌यो।<verse eid="ACT 18:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 18:12" />ते टेमे गल्‌लीयो अखाया परगणा नो मुखी हतो, तात युहदी माणहु एक्‌को करीन पोलुस भणी जोर करीन आया, अने तीने नीयाव करवा ना जागा अगळ लाया, <verse eid="ACT 18:12" /><verse number="13" style="v" sid="ACT 18:13" />अने केवा बाज ज्‌या, आहयो माणहु ने ह़मजाड़े के “अने भगवान नी भक्‌ती करवा नो आसवो कायदो, ह़ीकाड़े, जे मुसा ना कायदा गेथो अलग से।”<verse eid="ACT 18:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 18:14" />पोलुस आह़फा ने बचाड़वा करीन केवा हींडत्‌लो, ता गल्‌लीयो युहदी माणहु ने केदो, “ए युहदी माणहु! कदी आहयो कायदा ना वीरोद मे कंय बी गुनो करलो हतो नीता मोटो गुनो करलो हतो, ता मे तमारी वात ह़मळवा तीयार रेतो। <verse eid="ACT 18:14" /><verse number="15" style="v" sid="ACT 18:15" />पण आहयी वात नी झटा-पटी ते ढेरेत नाम ना बारा मे अने मुसान लारे लीखला कायदा ना बारा मे से। एतरे आहयी वात मे, मे नीयाव करन्‌यो नी बणु। तमुत आहयी वात ना बारा मे जाणो।” <verse eid="ACT 18:15" /><verse number="16" style="v" sid="ACT 18:16" />अने तीहयो गल्‌लीयो पोलुस ने नीयाव करे तीहयी कोरट-कचवरी मे गेथो काड देदो। <verse eid="ACT 18:16" /><verse number="17" style="v" sid="ACT 18:17" />ता आखा युहदी माणहु भक्‌तीन घोर ना मुखी सोस्‌थीनेस ने कोरट-कचवरी अगळ धर पाड़्‌या, अने घण-जबर ठोक्‌या: पण गल्‌लीयो आहयी वात पोर धीयान नी देदो।<verse eid="ACT 18:17" /></para>
  <para style="s">पोलुस अंताकीया पासो जाय</para>
  <para style="p">
    <verse number="18" style="v" sid="ACT 18:18" />पोलुस ढेरेत दाड़ा लग तां र्‌यो, अने अळतेण तीहयो भरहो करन्‌या भायु ने आवजो कीन पीरीस्‌कीला अने अक्‌वीला ह़ाते ढुंड्‌या मे बहीन सीरीया भणी चाल पड़्‌यो। अने तीहयो बादा लेदलो करीन कीरख्‌या मे आह़फा नु मुंडु बोड़ायो। <verse eid="ACT 18:18" /><verse number="19" style="v" sid="ACT 18:19" />अळतेण तीहया ईफीसुस पुग्‌या, ता पोलुस पीरीस्‌कीला अने अक्‌वीला ने तां रेवा दीन युहदी माणहु ना भक्‌ती ना घोर मे जाय्‌न युहदी माणहु ह़ाते भगवान नी वात मे जखड़ी पड़ ज्‌यो। <verse eid="ACT 18:19" /><verse number="20" style="v" sid="ACT 18:20" />जत्‌यार तां वाळा माणहु वीन्‌ती कर्‌या, “थोड़ाक दाड़ा अळी आञे रे।” पण पोलुस केदो, “मे नी रेतो।” <verse eid="ACT 18:20" /><verse number="21" style="v" sid="ACT 18:21" />अने तीमने सोड़ीन जवा नी टेमे केदो, “भगवान नी मरजी हहे, ता मे अळी तमारीन्‌तां आवही।” अळतेण पोलुस ईफीसुस गेथो ढुंड्‌या मे बहीन चाल देदो।<verse eid="ACT 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 18:22" />अळतेण तीहयो केसर्‌या ह़ेर मे पुग्‌यो। अने ता गेथो यरुसलेम ह़ेर मे ज्‌यो, अने तां वाळी ईसु नी मंडळी ने भेट्‌यो। अळतेण तीहयो तां गेथो अंताकीया ह़ेर मे जत र्‌यो। <verse eid="ACT 18:22" /><verse number="23" style="v" sid="ACT 18:23" />पोलुस थोड़ाक दाड़ा अंताकीया ह़ेर मे र्‌यो अने अळतेण आवजो कीन तीहयो गलातीया अने अळतेण फुरग्‌या फीरतो जाय्‌न आखा चेला ने भरहा मे वातड़ा करतो ज्‌यो।<verse eid="ACT 18:23" /></para>
  <para style="s">ईफीसुस अने कुरीन्‌थी मे अपुल्‌लोस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 18:24" />एक युहदी माणेह हतो, तीनु नाम अपुल्‌लोस हतु। तीहयो सीकंदर्‌या मे पयदा हयलो हतो। तीहयो अक्‌कल वाळो माणेह हतो अने सास्‌तर ने वारु रीते जाणतो हतो। तीहयो ईफीसुस मे आयो। <verse eid="ACT 18:24" /><verse number="25" style="v" sid="ACT 18:25" />तीने मालीक ना केणा मे चालवा नी ह़ीकापण जड़ली हती। अने मन लगाड़ीन अने पुरी हीम्‌मत सी ईसु ना बारा मे ह़ाची-ह़ाची ह़ीकाड़तो हतो। पण तीने युहन्‌नान बपतीस्‌मान बारा मे एतरुत मालम हतु। <verse eid="ACT 18:25" /><verse number="26" style="v" sid="ACT 18:26" />तीहयो भक्‌ती ना घोर मे धाक राख्‌या वगर भगवान नी वात केवा बाज ज्‌यो। पीरीस्‌कीला अने अक्‌वीला तीनी वात ह़मळीन तीने आह़फाम ना घोर ली ज्‌या, अने तीने वदु उंडे रीते भगवान नी वात ह़मजाड़्‌या। <verse eid="ACT 18:26" /><verse number="27" style="v" sid="ACT 18:27" />अने जत्‌यार अपुल्‌लोस दर्‌या छेकीन अखाया जवा करीन ठान लेदो। ता ईफीसुस ना ईसु पोर भरहो करन्‌या भायु तीने हीम्‌मत आप्‌या। अने चेला जुगु आहयु लीख्‌या के तमु पोलुस नो आव-भाव करजो। जत्‌यार पोलुस अखाया पुग्‌यो ता तां वाळा माणहु तीनी घण मदत कर्‌या। जे भगवान नी दया सीत ईसु पोर भरहो करला हता। <verse eid="ACT 18:27" /><verse number="28" style="v" sid="ACT 18:28" />काहाके तीहयो खरला सास्‌तर मे गेथो केतलो के “ईसुत मसी से।” अने युहदी माणहु अगळ खरला सास्‌तर मे गेथो घण-जबर वात कीन तीमनु मोडु बंद कर देत्‌लो।<verse eid="ACT 18:28" /></para>
  <chapter eid="ACT 18" />
  <chapter number="19" style="c" sid="ACT 19" />
  <para style="s">ईफीसुस मे पोलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 19:1" />जे टेमे अपुल्‌लोस कुरीन्‌थुस मे हतो, तीहयी टेमे पोलुस उपर ना परगणा मे फीरतो जाय्‌न ईफीसुस मे आयो। ता तीने थोड़ाक चेला भेट्‌या। <verse eid="ACT 19:1" /><verse number="2" style="v" sid="ACT 19:2" />तीहया चेला ने पोलुस पुछ्‌यो, “जत्‌यार तमु ईसु पोर भरहो करला ता चोखली आत्‌मा हात करला ह़ु?”</para>
  <para style="p" vid="ACT 19:2">तीहया चेला केदा, “आमु ते चोखली आत्‌मा ना बारा मे ह़मळ्‌या लग नी।”<verse eid="ACT 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 19:3" />एतरे पोलुस तीमने पुछ्‌यो, “ता तमु कोयनो बपतीस्‌मा लेदला से?” तीहया जपाप आप्‌या, “युहन्‌ना नो बपतीस्‌मा लेदला से।”<verse eid="ACT 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 19:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:4 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:11">मत्‌ती 3:11</ref>; <ref loc="MRK 1:4">मरकुस 1:4</ref>,<ref loc="MRK 1:7">7</ref>,<ref loc="MRK 1:8">8</ref>; <ref loc="LUK 3:4">लुका 3:4</ref>,<ref loc="LUK 3:16">16</ref>; <ref loc="JHN 1:26">युहन्‌ना 1:26</ref>,<ref loc="JHN 1:27">27</ref></char>
    </note>ता पोलुस केदो, “युहन्‌ना नो बपतीस्‌मा ते पाप भणी गेथो मन फीरवीन भगवान वगे वळवा नो हतो। युहन्‌नो माणहु ने केतो हतो के जे मसी मार गेथो अळतेण आवहे, तीहयात मसी पोर भरहो करजो। अने तीहयो मसी नासरत वाळो ईसु से।”<verse eid="ACT 19:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 19:5" />आहयु ह़मळीन तीहया मालीक ईसु ना नामे बपतीस्‌मा लेदा। <verse eid="ACT 19:5" /><verse number="6" style="v" sid="ACT 19:6" />जत्‌यार पोलुस तीमनी पोर हात मेकीन तीमनी जुगु भगवान ह़ाते वीन्‌ती कर्‌यो, ता चोखली आत्‌मा तीमनी पोर उतरीन तीमनी मे भराय जी, अने तीहया भात-भातीन बोली बोलवा बाज ज्‌या। अने भगवान वगे गेथी वात केवा बाज ज्‌या। <verse eid="ACT 19:6" /><verse number="7" style="v" sid="ACT 19:7" />तीहया आखा मेळीन बारे जणा हता।<verse eid="ACT 19:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ACT 19:8" />पोलुस तीन मयना लग युहदी माणहु ना भक्‌ती ना घोर मे जाय्‌न बीह्‌या वगर भगवान ना राज ना बारा मे युहदी माणहु ह़ाते वात मे जखड़ी पड़्‌या करतो हतो अने ह़मजाड़्‌या करतो हतो। <verse eid="ACT 19:8" /><verse number="9" style="v" sid="ACT 19:9" />बाखीन तीमनी मे थोड़ाक माणहु पीटड़ा हता अने पोलुस नी वात ह़मळीन ईसु पोर भरहो नी कर्‌या, अने बीजा माणहु अगळ आहया ईसु ना पंथ ना बारा मे वाक काडवा बाज ज्‌या। एतरे पोलुस तीमनी गेथो आंग्‌ये हय ज्‌यो अने आह़फा ना चेला ने लीन तां गेथो जत र्‌यो। अने तीहयो दाड़ीत तुरनुस ना भणावण्‌या घोर मे भगवान ना राज ना बारा मे वात कीन तीमनी ह़ाते जखड़ी पड़तो हतो। <verse eid="ACT 19:9" /><verse number="10" style="v" sid="ACT 19:10" />बे साल लग तीहयो आसम भगवान ना राज ना बारा मे केतो र्‌यो। अने तीनी वात ह़मळीन आसीया परगणा मे रेण्‌या युहदी माणहु अने आड़जात्‌या माणहु मालीक ईसु ना बारा मे बोलु ह़मळीन भरहो कर्‌या।<verse eid="ACT 19:10" /></para>
  <para style="s">सीकवा ना सोरा</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 19:11" />भगवान पोलुस ना लारे जुदा-काम देखाड़तो र्‌यो। <verse eid="ACT 19:11" /><verse number="12" style="v" sid="ACT 19:12" />जत्‌यार माणहु पोलुस ना डीले रुमाल अने फटकु छीमाड़ीन मांदला ह़ाते ली जत्‌ला, ता तीमनी मंदवाड़ सेटी हय जत्‌ली अने भुत तीमनी मे गेथा नीकळी जत्‌ला। <verse eid="ACT 19:12" /><verse number="13" style="v" sid="ACT 19:13" />थोड़ाक युहदी माणहु, माणहु मे गेथा भुत नीकाळ्‌या करता हता। एक दाड़े वीच्‌यार कर्‌या के आमु ईसु ना नाम सी भुत नीकाळहु। अने अळतेण तीहया एक माणेह मे गेथो भुत नीकाळवा नी टेमे केदा, “जे ईसु ना नाम सी पोलुस हक सी परच्‌यार करे, तीहया ईसुन नामे मे तने हुकम आपु के तु आनी मे गेथो नीकळ।” <verse eid="ACT 19:13" /><verse number="14" style="v" sid="ACT 19:14" />अने सीकवा नाम नो एक युहदी डायला पुंजारा ना ह़ात सोरा हता। तीहया बी आसमेत करता हता।<verse eid="ACT 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 19:15" />पण भुत तीमने जपाप आप्‌यो, “मे ईसु ने बी जाणु अने पोलुस ने बी जाणु, पण तमु कोय से?”<verse eid="ACT 19:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 19:16" />अळतेण जे माणेह मे भुत भरायलो हतो, तीहयो माणेह आदड़ी-आदड़ीन तीमने आखा ने ढबळाय देदो, अने तीमना आखा लुगड़ा फाड़ीन तीमने नांगरा कर देदो, अने घायल कर देदो अने तीहया नांगरला अने घायलेत घोर मे गेथा नीकळीन नाह ज्‌या। <verse eid="ACT 19:16" /><verse number="17" style="v" sid="ACT 19:17" />आहयु जे हयु तीनी खबर ईफीसुस ह़ेर मे रेण्‌या युहदी माणहु मे अने आड़जात्‌या माणहु मे जत री। अने तीहया आखा माणहु बीहीन तीमने घण-जबर धाक भराय जी। अने आहयी रीते मालीक ईसु नी ईज्‌जत अळी जादा हयवा बाज जी। <verse eid="ACT 19:17" /><verse number="18" style="v" sid="ACT 19:18" />अने जे बी आहयी वात ह़मळ्‌या तीमनी मे ढेरेत जणा गलत कामु ने करला मान लेदा, अने ईसु पोर भरहो कर्‌या, अने आहयी वात मान लेदा। <verse eid="ACT 19:18" /><verse number="19" style="v" sid="ACT 19:19" />अने तीहया बड़वाय करन्‌या आपणा-आपणा बड़वाय करवा ना पोती ना कीताप्‌या तीमनीन्‌तां लावीन भेळा कर देदा अने आखा अगळ तीहया कीताप्‌या ने धपाड़ देदा। जत्‌यार माणहु ते कीताप्‌या नी कीमत नो हीसाब लगाड़्‌या ता ते कीताप्‌या नी कीमत चांदी ना पचाह हजार टका हती। <verse eid="ACT 19:19" /><verse number="20" style="v" sid="ACT 19:20" />आहयी रीते मालीक ना बोलु ताखत भेळ फेलता ज्‌या, अने मजबुत हयता ज्‌या।<verse eid="ACT 19:20" /></para>
  <para style="s">ईफीसुस मे झगड़ो</para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 19:21" />आहयु हय ज्‌यु अने अळतेण पोलुस ना जीव मे आहयो वीच्‌यार कर्‌यो के मे मकीदुनीया अने अखाया माय्‌न यरुसलेम जही, तां “जाय्‌न अळतेण रोम बी देखवा जही।” <verse eid="ACT 19:21" /><verse number="22" style="v" sid="ACT 19:22" />एतरे पोलुस आह़फा ना सेवा करन्‌या ह़ाती तीमुथीयुस ने अने ईरास्‌तुस ने मकीदुनीया मोकली देदो अने आह़फो आसीया मे थोड़ाक दाड़ा अळी र्‌यो।<verse eid="ACT 19:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 19:23" />तीहयी टेमे तीहया पंथ ना बारा मे मोट्‌लो दंगो हयो। <verse eid="ACT 19:23" /><verse number="24" style="v" sid="ACT 19:24" />तां एक देमेत्‌रीयुस नाम नो एक ह़ोनार हतो तीहयो अरतीमीस नाम ना एक देव नो मंदीर चांदी सी बणाय मांगत्‌लो अने आसम करीन तीहयो तीमने काम-धंदो आपत्‌लो। <verse eid="ACT 19:24" /><verse number="25" style="v" sid="ACT 19:25" />तीहयो काम-धंदो करन्‌या ने भेळा कर्‌यो अने तीमने केदो, “ए माणहु, तमने मालम से के आपणु ने आहया काम-धंदा सी घण-जबर फायदो हये। <verse eid="ACT 19:25" /><verse number="26" style="v" sid="ACT 19:26" />पण तमु देखो, अने ह़मळो, के तीहयो पोलुस ईफीसुस आखा आसीया परगणा मे माणहु ने आहयु कीन ह़मजाड़े अने मुर्‌ती लेवा वचकाड़े के हात सी बणावला मुरत्‌या देवता नी हय। <verse eid="ACT 19:26" /><verse number="27" style="v" sid="ACT 19:27" />पोलुस आसमेत माणहु ने ह़जाड़्‌या करहे ता आहयी बीक से के आपणो मुर्‌ती बणावीन वेचवा नो काम-धंदो बंद हय जहे अने मोट्‌ली देवी अरतीमीस ना मंदीर नु अबरु बी जत रेहे। अने जे देवीन पुजा-पाट आखु आसीया परगणु अने आखी कळ करे, तीनी ईज्‌जत बी कम हय जहे।”<verse eid="ACT 19:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 19:28" />भीड़ ना माणहु आहयी वात ह़मळीन रीहवाय पड़्‌या अने आड़ी-आड़ीन केदा, “ईफीसीयो ह़ेर मे रेण्‌यान अरतीमीस देवी घण मोटी से।” <verse eid="ACT 19:28" /><verse number="29" style="v" sid="ACT 19:29" />ह़ेर ना बीजा माणहु बी माणहु ने आड़त्‌ला ह़मळीन तीमनी मे भेसकाय ज्‌या अने मकीदुनीया वाळा गयुस अने अरीस्‌तरखुस ने धर लेदा, जे पोलुस ह़ाते हींडत्‌ला। आखान-आखा एक-मन्‌या हय्‌न उपरी वाळा मोकळा घोर मे दवड़ी पड़्‌या। <verse eid="ACT 19:29" /><verse number="30" style="v" sid="ACT 19:30" />पोलुस तीहया माणहुन तां जवा हींडतो हतो, पण चेला तीने तां जवा नी देदा। <verse eid="ACT 19:30" /><verse number="31" style="v" sid="ACT 19:31" />आसीया परगणा ना थोड़ाक हकदार्‌या पोलुस ना दोस्‌तीदार हता। तीहया हकदार्‌या आहयी खबर ली मोकल्‌या के तु उपरी वाळा मोकळा घोर मे जाय्‌न दुख ना झेले। <verse eid="ACT 19:31" /><verse number="32" style="v" sid="ACT 19:32" />तीहयी टेमे गड़दी मे गेथा काना कंखरेत आड़ी र्‌या हता अने काना कंखरेत आड़ी र्‌या हता; काहाके घणा ढेरका माणहु ने आहयु मालम नी हतु के तीहया काहा भेळा हयला से। <verse eid="ACT 19:32" /><verse number="33" style="v" sid="ACT 19:33" />तीहयी गड़दी मे सीकंदर नाम नो एक माणेह हतो। तीने युहदी माणहु तीमनी गेथा टाळला हता। तीहया तीने ह़मजाड़ीन गड़दी मे वाळा माणहु अगळ उबो कर देदा। सीकंदर हात पालवी-पालवीन अनसारो करीन आह़फा ने बचाड़वा हींडतो हतो। <verse eid="ACT 19:33" /><verse number="34" style="v" sid="ACT 19:34" />पण जत्‌यार तीमने मालम हयु के तीहयो एक युहदी माणेह से, ता तीहया आखान-आखा एक रंगा बे घंटा लग आड़ी-आड़ीन केदा, “ईफीसीयो ह़ेर मे रेण्‌यान देवी अरतीमीस घण मोटी से।”<verse eid="ACT 19:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="ACT 19:35" />ह़ेर नो लीखापुड़ी करवा वाळो गड़दी ने होगी राखीन केदो, “ए ईफीसीयो मे रेण्‌या माणहु! आखी कळी मे कोय एवो माणेह से के आहयु नी जाणतु हय, के ईफीसुस ह़ेर नी मोट्‌ली देवी अरतीमीस देवीन मंदीर ना अने ह़रग मे रेण्‌या गयुस देवता वगे गेथी पड़ली मुर्‌ती ना रखवाळ्‌या से। <verse eid="ACT 19:35" /><verse number="36" style="v" sid="ACT 19:36" />एतरे आहयी वात ने कोय काटी नी सके, एतरे आहयु तालेत से के तमु होगा रेवो; अने वीच्‌यार काड्‌या वगर कंय ना करो। <verse eid="ACT 19:36" /><verse number="37" style="v" sid="ACT 19:37" />काहाके तमु जे माणहु ने लावला से, तीहया नी ते मंदीर मे लुटण्‌या हय अने नी ते आपणी देवी नो वाक काडण्‌या हय। <verse eid="ACT 19:37" /><verse number="38" style="v" sid="ACT 19:38" />कदी माय्‌न देमेत्‌रीयुस ने अने तीना ह़ाते काम-धंदो करन्‌या नो कानी बी वात मे वाक हय ता नीयाव जुगु कोरट-कचवरी चालु से, अने तां नीयाव करन्‌यान परगणा नो धणी बी से; तां जाय्‌न एक-बीजा नो वाक काड्‌या करो। <verse eid="ACT 19:38" /><verse number="39" style="v" sid="ACT 19:39" />पण तमु कंय पुछवा हींडे तां आहयी वात ना बारा मे जाणवा करीन ह़ेर नी बठक हये तां आवजो तां आहयी वात नो वीच्‌यार काडहु। <verse eid="ACT 19:39" /><verse number="40" style="v" sid="ACT 19:40" />काहाके आज जे बी हुहड़ो हयलो से, तीहयो अमारा माथे पड़हे, एतरे आञे आना बारा मे वीच्‌यार काडवा ताले नी हय काहाके आहयी टेमे आहयी गड़दी मे वाळा माणहु ने अमारी भणी गेथो कंय बी जपाप नी अपाये।” <verse eid="ACT 19:40" /><verse number="41" style="v" sid="ACT 19:41" />अने आहयु कीदीन तीहयो ह़ेर नो लीखापुड़ी करवा वाळो पंचु ने वळाय देदो।<verse eid="ACT 19:41" /></para>
  <chapter eid="ACT 19" />
  <chapter number="20" style="c" sid="ACT 20" />
  <para style="s">मकीदुनीया, युनान, अने त्‌रोआस मे पोलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 20:1" />झगड़ो बंद हय ज्‌योन अळतेण पोलुस चेला ने बोलावीन ह़मजाड़्‌यो, के तमु ईसु ना भरहा मे वातड़ा रेजो। अने तीमने आवजो कीन मकीदुनीया भणी चाल पड़्‌यो। <verse eid="ACT 20:1" /><verse number="2" style="v" sid="ACT 20:2" />अने तीहयो ते आखा देस मे हय्‌न अने चेला ने हीम्‌मत आपीन तीहयो युनान मे आयो। <verse eid="ACT 20:2" /><verse number="3" style="v" sid="ACT 20:3" />अने पोलुस तां तीन मयना लग र्‌यो, काहाके युहदी तीने मारवा नी धुन मे हता, अने तीहयो वीच्‌यार कर्‌यो के मे ढुंड्‌या मे बहीन सीरीया जत रेही, पण मकीदुनीया पासो जत र्‌यो। <verse eid="ACT 20:3" /><verse number="4" style="v" sid="ACT 20:4" />बीर्‌या ना पुरुर्‌स नो बेटो सोपत्‌रुस, अने थीसलुनीकीयो मे वाळा अरीस्‌तरखुस अने सीकुन्‌दुस, अने आसीया वाळा तुखीकुस अने तरोफीमुस, अने दीरबे वाळा गयुस, अने तीमुथीयुस बी तीनी ह़ाते हता। <verse eid="ACT 20:4" /><verse number="5" style="v" sid="ACT 20:5" />पण तीहया अमारी गेथा पेले त्‌रोवास मे जाय्‌न वाट जोय र्‌या हता। <verse eid="ACT 20:5" /><verse number="6" style="v" sid="ACT 20:6" />खमीर वगर ना रोट्‌ला नो तीवार हय ज्‌यो अने अळतेण आमु ढुंड्‌या मे बहीन फीलीपी ह़ेर गेथा त्‌रोवास भणी चाल पड़्‌या। अने पांच दाड़ा मे आमु त्‌रोवास मे आवीन तीमने भेट्‌या। अने तां आमु ह़ात दाड़ा र्‌या।<verse eid="ACT 20:6" /></para>
  <para style="s">पोलुस नी त्‌रोआस मे आखरी भेट</para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 20:7" />हप्‌ता ना पेल्‌ना दाड़े, आमु खाणु खावा ना लेदे भेळा हया, अने पोलुस बीजा दाड़े जवा वाळो हतो, एतरे तीहयो ईसु पोर भरहो करन्‌या ह़ाते वात करतो र्‌यो, अने तीहयो अरदी रात लग वात करतो र्‌यो। <verse eid="ACT 20:7" /><verse number="8" style="v" sid="ACT 20:8" />आमु उपरी पोर वाळा कोपरे भेळा हता, अने तां घणा ढेरका दीवा धपवा बाज र्‌या हता। <verse eid="ACT 20:8" /><verse number="9" style="v" sid="ACT 20:9" />तां एक जुवान सोरो खीड़की ना खुणा पोर बह र्‌यो हतो, तीनु नाम युतुखुस हतु, जत्‌यार पोलुस घणी वार लग वात देखाड़तो र्‌यो, एतरे तीने नींदर आय जी। अने तीहयो नींदर मे उंगाय्‌न तीसरी मंजली गेथो हेटो पड़ ज्‌यो, अने तीने मरलो उचलीन लाया। <verse eid="ACT 20:9" /><verse number="10" style="v" sid="ACT 20:10" />पोलुस उपरी पोर गेथो उतरीन आयो, अने तीने बथलाटीन गळे लगाड़्‌यो अने केदो घबरायो ना काहाके हीय्‌यो जीवत्‌लो से। <verse eid="ACT 20:10" /><verse number="11" style="v" sid="ACT 20:11" />पोलुस अने आखा पासा उपर जाय्‌न खाणु खादा अने एतरी वार लग वात करतो र्‌यो के परगण फाट ज्‌यी, अळतेण तीहयो जत र्‌यो। <verse eid="ACT 20:11" /><verse number="12" style="v" sid="ACT 20:12" />अने तीहया ते जुवान सोरा ने जीवत्‌लो घोर ली आया। अने तीमने घणी सांती जड़ी।<verse eid="ACT 20:12" /></para>
  <para style="s">त्‌रोआस मे गेथा मीलेतुस मे जाणु</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 20:13" />आमु पेलेत ढुंड्‌या मे बहीन अस्‌सुस भणी चाल पड़्‌या। अने तां पोलुस ने बी ढुंड्‌या मे बहाड़वा नु हतु। काहाके तीहयो आह़फोत चालीन आव्‌वा वाळो हतो। <verse eid="ACT 20:13" /><verse number="14" style="v" sid="ACT 20:14" />जत्‌यार पोलुस अस्‌सुस मे भेट्‌यो, ता आमु तीने ढुंड्‌या मे बहाड़ लेदा अने मीतुलेन ह़ेर मे ज्‌या। <verse eid="ACT 20:14" /><verse number="15" style="v" sid="ACT 20:15" />बीजा दाड़े आमु तां गेथा ढुंड्‌या मे बहीन खीयुस ह़ेर अगळ पुग्‌या अने बीजा दाड़े सामुस ह़ेर मे आय लाग्‌या। अळतेण बीजा दाड़े मीलेतुस ह़ेर मे पुग ज्‌या। <verse eid="ACT 20:15" /><verse number="16" style="v" sid="ACT 20:16" />काहाके पोलुस ईफीसुस अगळ माय्‌न जवा ठान लेदलो हतो। जीनी सी तीने आसीया मे वार नी लागे, करीन पोलुस उतवाळ कर र्‌यो हतो, हय सके ता तीहयो पीन्‌तेकुस्‌त ना दाड़े यरुसलेम मे रेय।<verse eid="ACT 20:16" /></para>
  <para style="s">ईफीसुस ना डायला ने ह़ीकाड़नु</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 20:17" />ईफीसुस मे रेण्‌या मंडळी ना मुख्‌या ने बोलाय लावजो करीन पोलुस मीलेतुस गेथो खबर ली मोकल्‌यो। <verse eid="ACT 20:17" /><verse number="18" style="v" sid="ACT 20:18" />जत्‌यार तीहया तां आया, ता पोलुस तीमने केदो, “तमने मालम से के आसीया मे पुग्‌यो ते दाड़े गेथो मे तमारी ह़ाते कीसम री र्‌यो।” <verse eid="ACT 20:18" /><verse number="19" style="v" sid="ACT 20:19" />युहदी माणहु नी जाळसादीन करते मारी पोर घण-जबर आफत आयी, बाखीन मे रड़तो जाय्‌न बी घण भोळाय सी मालीक ईसु नी सेवा करतो र्‌यो। <verse eid="ACT 20:19" /><verse number="20" style="v" sid="ACT 20:20" />अने आहयी वात तमारी जुगु फायदा नी हती, तीहयी वात केवा मे, मे माणहु अगळ अने घोर-घोर जाय्‌न ह़ीकाड़वा कदी नी वचक्‌यो। <verse eid="ACT 20:20" /><verse number="21" style="v" sid="ACT 20:21" />युहदी माणहु ने अने आड़जात्‌या माणहु ने चेतावणी आपतो हतो के “तमु भगवान भणी वळो अने मालीक ईसु मसी पोर भरहो करो। <verse eid="ACT 20:21" /><verse number="22" style="v" sid="ACT 20:22" />हाव मे चोखली आत्‌मा ना हुकम सी यरुसलेम जवा बाज र्‌यो, पण मने आहयु नी मालम हय के मार पोर तां ह़ु वीतहे? <verse eid="ACT 20:22" /><verse number="23" style="v" sid="ACT 20:23" />मे ते आहयु एतरुत जाणु के आखा ह़ेर डीट चोखली आत्‌मा मने चेतावणी आपे के, जेल अने वेला मारी वाट जोय री। <verse eid="ACT 20:23" /><verse number="24" style="v" sid="ACT 20:24" /><note caller="+" style="x"><char style="xo" closed="false">20:24 </char><char style="xt" closed="false"><ref loc="2TI 4:7">2 तीमुथीयुस 4:7</ref></char></note>बाखीन मे जीवाय नी फीकर नी करतो, पण आहयी जीवाय मे मारु खास काम से के मे मालीक ईसु ना ह़ोपला काम ने पुरा करु। तीहयु काम आहयु से, के मे भगवान नी दया नी खुस-खबर माणहु ने ह़मळावु।<verse eid="ACT 20:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 20:25" />“अने हाव मे जाणु के भगवान ना राज नु परच्‌यार तमने ह़मळावलो से, अने तमु मने अळी नी देखो। <verse eid="ACT 20:25" /><verse number="26" style="v" sid="ACT 20:26" />एतरे आज मे तमने उजन्‌तो आहयी वात केम के, आखा ना मोत नो कारण मे नी हय। <verse eid="ACT 20:26" /><verse number="27" style="v" sid="ACT 20:27" />काहाके मे भगवान नी जे मरजी तमारी जुगु से, तीहयी पुरीन-पुरी केवा सी नी वचक्‌यो। <verse eid="ACT 20:27" /><verse number="28" style="v" sid="ACT 20:28" />तमु तमारी अने तमारी मंडळी नी रखवाळी करता रेवो, काहाके चोखली आत्‌मा तमने तीमनी फीकर करवा वाळा बणावली से; के तमु भगवान नी तीहयी मंडळी नी रखवाळी करो, जीने तीहयो आह़फा ना लोय नी बदले वेचातो लेदलो हतो। <verse eid="ACT 20:28" /><verse number="29" style="v" sid="ACT 20:29" />मने मालम से के मारा जवा नी अळतेण तमारी वच मे घणा जुदा लेंड्‌या आवहे, अने तीहया भोळी मंडळी ने नी सोड़े। <verse eid="ACT 20:29" /><verse number="30" style="v" sid="ACT 20:30" />अने एवी टेम आवहे तमारीत मंडळी मे गेथा एवा माणहु उबा हय जहे, जे चेला ने आह़फाम नी पसळ लाव्‌वा करीन झुटी वात केहे। <verse eid="ACT 20:30" /><verse number="31" style="v" sid="ACT 20:31" />एतरे चेतीन रेजो! अने फोम राखजो के मे तीन साल लग एक-एक जणा ने रात-दाड़ो रड़ी-रड़ीन ह़ीकाड़लो से।<verse eid="ACT 20:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="ACT 20:32" />“अने हाव मे तमने भगवान अने तीनी दया ना हात मे ह़ोपु, तीहयोत तमने बांदीन राख सकहे, अने तमने भगवान ना चोखा करला माणहु नी ह़ाते आखी बरकत अपाड़ सकहे। <verse eid="ACT 20:32" /><verse number="33" style="v" sid="ACT 20:33" />मे कोय नु ह़ोनु-चांदी अने लुगड़ा नी लालच नी कर्‌यो। <verse eid="ACT 20:33" /><verse number="34" style="v" sid="ACT 20:34" />तमने मालम से के मे मारा हात सी काम करीन मने अने मारा ह़ाती ने जोवे तीहयु भेळु करलो से। <verse eid="ACT 20:34" /><verse number="35" style="v" sid="ACT 20:35" />मे तमने आखु देखाड़लो से के कानी रीते मेहनत करीन लुल्‌ला नी मदत करवा जोवे, अने आपणु ने मालीक ईसु मसी नी केदली वात फोम राखवा जोवे, के ‘लेवा सी आपवा वारु से।’”<verse eid="ACT 20:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="ACT 20:36" />आहयु कीन पोलुस तीमनी ह़ाते मांडा टेकीन भगवान सी वीन्‌ती कर्‌यो। <verse eid="ACT 20:36" /><verse number="37" style="v" sid="ACT 20:37" />तत्‌यार तीहया आखा घणा रड़्‌या अने पोलुस ने गळे लगाड़्‌या अने तीने कुको दीन वळाय देदा। <verse eid="ACT 20:37" /><verse number="38" style="v" sid="ACT 20:38" />तीहयो तीमने केदलो हतो के तमु मने अळी नी देखो। एतरे तीमने वदु दुख हयो अने तीहया तीने ढुंड्‌यान तां लग मेकवा ज्‌या।<verse eid="ACT 20:38" /></para>
  <chapter eid="ACT 20" />
  <chapter number="21" style="c" sid="ACT 21" />
  <para style="s">पोलुस नु यरुसलेम जाणु</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 21:1" />तीमने आवजो कीदीन आमु दर्‌या मे ढुंड्‌या मे बहीन अने कोस मे आया अने बीजा दाड़े रुदुस मे, अने तां गेथा पतरा मे। <verse eid="ACT 21:1" /><verse number="2" style="v" sid="ACT 21:2" />अळतेण पतरा गेथा आमु एक ढुंड्‌या मे बहीन चाल पड़्‌या, जे फीनीके जवा बाज रेलु। <verse eid="ACT 21:2" /><verse number="3" style="v" sid="ACT 21:3" />जत्‌यार आमने कुपरुस देखाव पड़्‌यु, तत्‌यार आमु तीहया कुपरुस ने सोड़ीन डाखर्‌ये धेड़े सीरीया भणी वळ ज्‌या, काहाके ढुंड्‌या मे वाळु ह़मान सुर ह़ेर मे उतारवा नु हतु, एतरे आमु बी ह़मान उतार्‌या तांत उतरी ज्‌या। <verse eid="ACT 21:3" /><verse number="4" style="v" sid="ACT 21:4" />तां आमने चेला भेट्‌या, तीमनी ह़ाते आमु ह़ात दाड़ा लग र्‌या। तीहया आत्‌मा नी ताखत सी पोलुस ने केदा, “तु यरुसलेम मे नी जजे।” <verse eid="ACT 21:4" /><verse number="5" style="v" sid="ACT 21:5" />पण तां रेवा ना अमारा दाड़ा पुरा हय ज्‌या, अने अळतेण आमु तीमने आवजो करीन तां गेथा अमारी वाट्‌ये चाल पड़्‌या। तीहया आखा बयरा-सोरा ह़ेर गेथा बारथा दर्‌या धेड़्‌ये लग अमारी ह़ाते आया। अने अळतेण आमु दर्‌या धेड़्‌ये मांडा टेकीन वीन्‌ती कर्‌या। <verse eid="ACT 21:5" /><verse number="6" style="v" sid="ACT 21:6" />अने एक-बीजा ने आवजो कीन आमु ढुंड्‌या पोर चड़ीन जत र्‌या। अने तीहया बी आपणा-आपणा घोर जत र्‌या।<verse eid="ACT 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 21:7" />जत्‌यार आमु सुर गेथा ढुंड्‌या मे बहीन पतुलीमयीस मे पुग्‌या, अने भरहो करन्‌या भायु ने वारला से कीन तीमनी ह़ाते एक दाड़ो र्‌या। <verse eid="ACT 21:7" /><verse number="8" style="v" sid="ACT 21:8" /><note caller="+" style="x"><char style="xo" closed="false">21:8 </char><char style="xt" closed="false"><ref loc="ACT 6:5">नेवताळा ना काम 6:5</ref>; <ref loc="ACT 8:5">8:5</ref></char></note>बीजा दाड़े आमु तां गेथा केसर्‌या मे आया, अने खुस-खबर ह़मळावण्‌या फीलीपुस ना घोर ज्‌या। आहयो फीलीपुस तीहया टाळला ह़ात जणा मे गेथो एक हतो। जाय्‌न तीनीन्‌तां र्‌या। <verse eid="ACT 21:8" /><verse number="9" style="v" sid="ACT 21:9" />तीहया फीलीपुस ना च्‌यार छड़्‌ला सोर्‌या हता; तीहया भगवान वगे गेथी वात केण्‌या हता। <verse eid="ACT 21:9" /><verse number="10" style="v" sid="ACT 21:10" /><note caller="+" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="ACT 11:28">नेवताळा ना काम 11:28</ref></char></note>जत्‌यार आमु तां ढेरेत दाड़ा री लेदा, ता तां एक भगवान वगे गेथी वात केण्‌यो माणेह युहद्‌या गेथो आयो, तीनु नाम अगबुस हतु। <verse eid="ACT 21:10" /><verse number="11" style="v" sid="ACT 21:11" />तीहयो ह़ाते आवीन पोलुस ना केड़्‌या मे वाळो पट्‌टो मांग लेदो अने आह़फा ना हात ने पोग बांदीन केदो, “चोखली आत्‌मा आहयु केय, जे माणेह नो आहयो पट्‌टो से, तीने यरुसलेम मे युहदी माणहु आहयी रीते बांदहे, अने आड़जात्‌या ना हात मे आप देहे।”<verse eid="ACT 21:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 21:12" />जत्‌यार आमु आहयी वात ह़मळ्‌या, ता आमु अने तां ना माणहु पोलुस ने टीणे पड़ीन केदा, “तु यरुसलेम ह़ेर मे नी जजे।” <verse eid="ACT 21:12" /><verse number="13" style="v" sid="ACT 21:13" />पण पोलुस केदो, “तमु आसम रड़ी-रड़ीन मने आञे रेवा करीन काहा मन काचु कर र्‌या, मे ते मालीक ईसु नी करते यरुसलेम ह़ेर मे बंदायवा एतरोत नी पण मरवा बी तीयार से।”<verse eid="ACT 21:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ACT 21:14" />पोलुस अमारी सी नी मान्‌यो; एतरे आमु कीदीन होगा री ज्‌या, “जीसम भगवान नी मरजी से, तेमेत हयवा दे।”<verse eid="ACT 21:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ACT 21:15" />थोड़ाक दाड़ा रेवान अळतेण आमु तीयारी कर लेदा, अने यरुसलेम भणी चाल पड़्‌या। <verse eid="ACT 21:15" /><verse number="16" style="v" sid="ACT 21:16" />जत्‌यार केसर्‌या गेथा थोड़ाक चेला बी अमारी ह़ाते चाल पड़्‌या, अने तीहया आमने कुपरुस मे रेण्‌यो एक जुन्‌ला चेलान्‌तां ली ज्‌या, के आमु तीनीन्‌तां रीया, तीनु नाम मनासोन हतु।<verse eid="ACT 21:16" /></para>
  <para style="s">पोलुस नी याकुब ह़ाते भेट</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 21:17" />जत्‌यार आमु यरुसलेम मे पुग्‌या, ता ईसु पोर भरहो करन्‌या भायु खुस हय्‌न आमने भेट्‌या अने अमारो आव-भाव कर्‌या। <verse eid="ACT 21:17" /><verse number="18" style="v" sid="ACT 21:18" />बीजा दाड़े पोलुस अमारी ह़ाते याकुब ने भेटवा ज्‌यो, तां आखा मंडळी ना मुख्‌या भेळा हय रेला। <verse eid="ACT 21:18" /><verse number="19" style="v" sid="ACT 21:19" />पोलुस तीमनो आव-भाव कर्‌यो अने अळतेण तीहयो जे कंय भगवान तीना हाते आड़जात्‌या मे जुदा-काम करलो हतो तीहया एकीक करीन की देदो। <verse eid="ACT 21:19" /><verse number="20" style="v" sid="ACT 21:20" />तीहया पोलुस नी वात ह़मळीन भगवान ना गुण गाया अने पोलुस ने केदा, “भाय तु देखीत र्‌यो के हजारो युहदी ईसु पोर भरहो कर लेदला से, पण तीहया मुसा ना कायदा पाळवा नी धुन मे लाग ज्‌या। <verse eid="ACT 21:20" /><verse number="21" style="v" sid="ACT 21:21" />तारा बारा मे माणहु तीमने आहयु केदला से के आहयो माणेह आड़जात्‌या माणहु ना वच मे रेवा वाळा आखा युहदी माणहु ने मुसा ना कायदा सोड़वा ह़ीकाड़े। अने तीहयो तीमने केय के तमु आपणा सोरा ने खतनु ना करावो अने मुसा नी जुन्‌ली रीती ना पाळो।” <verse eid="ACT 21:21" /><verse number="22" style="v" sid="ACT 21:22" />एतरे हाव ह़ु करवा जोवे? तीहया ते हाव ह़ाचलीन ह़मळी लेहे के तु आञे आय र्‌यो। <verse eid="ACT 21:22" /><verse number="23" style="v" sid="ACT 21:23" />एतरे तु अमारु केणु मान ले, अमारी ह़ाते आञे च्‌यार जणा एसवा से जे बादा लेदला से। <verse eid="ACT 21:23" /><verse number="24" style="v" sid="ACT 21:24" />आहया माणहु ने तार ह़ाते ली जा, ईमनी ह़ाते चोखो हयवा करीन भेसकाय जा, अने ईमनु मुंडु बोड़ाव्‌वा करीन ईमनो जे खरचो लागे तीहयो आप दे। ता आखा माणहु ने मालम पड़ जहे, के मुसा नो कायदो तोड़वा नी ह़ीकाड़े, पण तु ते मुसा ना कायदा ने मानीन तीनी अनसारे चाले। <verse eid="ACT 21:24" /><verse number="25" style="v" sid="ACT 21:25" /><note caller="+" style="x"><char style="xo" closed="false">21:25 </char><char style="xt" closed="false"><ref loc="ACT 15:29">नेवताळा ना काम 15:29</ref></char></note>पण भरहो करन्‌या आड़जात्‌या ना बारा मे आहयी वात से के आमु तीमनीन्‌तां आसम चीट्‌ठी लीखीन ली मोकल्‌ला से: तमु मुर्‌ती पोर चड़ावलु खाणु नी खाजो, अने गळु डाबीन मारला काना बी जानवर नु माह नी खाजो, अने काना बी जानवर नु लोय नी पीजो। अने छीनाळु नी करजो।<verse eid="ACT 21:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 21:26" />आहयी रीते पोलुस तीहया माणहु ने आह़फा नी ह़ाते लीन ज्‌यो, अने तीहया माणहु नी ह़ाते आह़फा ने बी चोखा हयवा नी रीती नी अनसारे अगला दाड़े चोखो कर लेदो, अळतेण तीहयो मंदीर मे ज्‌यो, जां तीहयो घोसणा कर्‌यो के चोखा हयवा ना दाड़ा कारु पुरा हयहे अने अमारी मे ना आखा जुगु भेट कारु चड़ावहे।<verse eid="ACT 21:26" /></para>
  <para style="s">मंदीर मे पोलुस नु धरायणु</para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 21:27" />चोखा हयवा ना ह़ात दाड़ा पुरा हयवात वाळा हता, ता आसीया देस वाळा थोड़ाक युहदी माणहु तीने मंदीर मे देख लेदा, अने तीहया आखा माणहु ने भड़काया, अने पोलुस ने धर पाड़्‌या। <verse eid="ACT 21:27" /><verse number="28" style="v" sid="ACT 21:28" />“ए ईस्‌रायली माणहु मदत करो! आहयो तीहयो माणेह से, जे ईस्‌रायली माणहु ना वीरोद मे, अने मुसा ना कायदा ना वीरोद मे, अने आहया चोखला मंदीर ना वीरोद मे आखा जागे माणहु ने ह़ीकाड़े, अने हाव आहयो आड़जात्‌या माणहु ने बी मंदीर मे ली आयो, अने चोखला मंदीर ने वीटाळ देदो।” <verse eid="ACT 21:28" /><verse number="29" style="v" sid="ACT 21:29" /><note caller="+" style="x"><char style="xo" closed="false">21:29 </char><char style="xt" closed="false"><ref loc="ACT 20:4">नेवताळा ना काम 20:4</ref></char></note>तीहया आहयु आनीन करते केदा, काहाके पोलुस ने मंदीर मे आव्‌वान पेले आहया युहदी माणहु आने तरोफीमुस ह़ाते ह़ेर मे देखला हता, आहयो तुरुफीमस ईफीसीयो ह़ेर वाळो हतो, तीहया तीने पोलुस ह़ाते देखीन आहयु ह़मज्‌या के पोलुस हीने मंदीर मे लाय र्‌यो हहे।<verse eid="ACT 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 21:30" />एतरे आखा ह़ेर ना माणहु हुहड़ीन, दवड़ी-दवड़ीन आया, अने पोलुस ने धरीन घीहड़ता-घीहड़ता मंदीर मे गेथा बारो लाया अने तत्‌यारुत मंदीर ना झापला बंद कर देदा। <verse eid="ACT 21:30" /><verse number="31" style="v" sid="ACT 21:31" />जत्‌यार भीड़ पोलुस ने मार नाखवा हींड्‌ती हती, तीहयीत टेमे सीपायड़ा ना मेळा ना मुखी सुबेदार ने कानो खबर पुगाड़्‌यो के “आखा यरुसलेम ह़ेर ना माणहु हुहड़ीन पोलुस भणी जाय र्‌या।” <verse eid="ACT 21:31" /><verse number="32" style="v" sid="ACT 21:32" />तीहयो सुबेदार तत्‌यारुत सीपायड़ा ने अने बीजा मुख्‌या-मुख्‌या ने आह़फा ह़ाते लीन पोलुस ने मारवा हींडत्‌ला तीहया युहदी माणहु भणी ज्‌यो, तीहया युहदी सीपायड़ान मुख्‌या ने अने सीपायड़ा ना बीजा मुख्‌या ने देख्‌या, ता तीहया पोलुस ने ठोकवा बंद कर देदा। <verse eid="ACT 21:32" /><verse number="33" style="v" sid="ACT 21:33" />तत्‌यार सीपायड़ान मुख्‌यो तां आयो अने पोलुस ने धर पाड़्‌यो अने बीजा सीपायड़ान मुख्‌या ने केदो के “आने हातकड़ी लगाड़ देवो।” अळतेण तीहयो सीपायड़ान मुख्‌यो माणहु ने पुछ्‌यो, “आहयो कोय से अने आहयो ह़ु गुनो करलो से?” <verse eid="ACT 21:33" /><verse number="34" style="v" sid="ACT 21:34" />गड़दी मे वाळा माणहु कानो कंयेत की र्‌यो हतो अने कानो कंय की र्‌यो हतो, एतरे तीहया सुबेदार ने आहयु मालम नी पड़्‌यु के ह़ाची वात ह़ु से, एतरे तीहयो हुकम आप्‌यो के “आने कीला मे ली लेवो।” <verse eid="ACT 21:34" /><verse number="35" style="v" sid="ACT 21:35" />जत्‌यार तीहयो पयड़ी पोर पुग्‌यो ता गड़दी घण जबर हती अने गड़दी मे वाळा माणहु धकलाय र्‌या हता एतरे कीला मे पोलुस ने उचलीन लीजवा पड़्‌यु। <verse eid="ACT 21:35" /><verse number="36" style="v" sid="ACT 21:36" />अने गड़दी मे वाळा माणहु “आने मार नाखो।” करीन आड़ता जाय्‌न पसळ-पसळ आव्‌वा बाज र्‌या हता।<verse eid="ACT 21:36" /></para>
  <para style="s">पोलुस आह़फा ने बचाड़े</para>
  <para style="p">
    <verse number="37" style="v" sid="ACT 21:37" />जत्‌यार सीपायड़ा पोलुस ने कीला मे लीजवात वाळा हता, ता पोलुस सुबेदार ने केदो, “मे तने कंय केवा हींडु, केम ह़ु?” सुबेदार पोलुस ने जपाप आप्‌यो, “तने युनानी बोली अवड़े ह़ु? <verse eid="ACT 21:37" /><verse number="38" style="v" sid="ACT 21:38" />ह़ु तु तीहयो मीसरी माणेह ते नी हय, जे थोड़ीक वार पेले झगड़ो करायो, अने जे आञे बड़ा मे च्‌यार हत्‌यार वाळा हजार माणहु नी अगवाय करतो हतो?”<verse eid="ACT 21:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 21:39" />पोलुस केदो, “मे ते तरसुस ह़ेर नो युहदी माणेह से, अने कीलीकीया नो खास रेण्‌यो से, तारी सी मारी आहयी वीन्‌ती से के मने माणहु ह़ाते वात करवा दे।”<verse eid="ACT 21:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="ACT 21:40" />गड़दी ह़ाते वात करवा नी छुट जड़ी ता पोलुस पयड़ी पोर उबो हय्‌न हात सी अनसारो कर्‌यो, अने आखा माणहु होगा री ज्‌या, ता तीहयो ईब्‌रानी बोली मे बोलवा बाज ज्‌यो:<verse eid="ACT 21:40" /></para>
  <chapter eid="ACT 21" />
  <chapter number="22" style="c" sid="ACT 22" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 22:1" />“ए बाह ह़रका माणहु, अने भायु! मने बचाड़वा करीन मे जे कंय की र्‌यो तीहयु ह़मळो।” <verse eid="ACT 22:1" /><verse number="2" style="v" sid="ACT 22:2" />जत्‌यार माणहु पोलुस ने ईब्‌रानी बोली बोलत्‌लो ह़मळीन होगा री ज्‌या। ता पोलुस तीमने केदो:<verse eid="ACT 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ACT 22:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">22:3 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 5:34-39">नेवताळा ना काम 5:34-39</ref>
      </char>
    </note>मे एक युहदी माणेह से, अने मे कीलीकीया ना तरसुस ह़ेर मे पयदा हयलो से, अने मे आहयात यरुसलेम मे मोटो हयो अने गमलीएल मास्‌तर ना पोगु मे बहीन आपणा आड़ा-बुड़ा ना कायदा पुरान-पुरा मान्‌यो; अने मे भगवान ना कायदा पाळवा मे जादा ह़ोह मे हतो जीसम आज तमु होह मे से। <verse eid="ACT 22:3" /><verse number="4" style="v" sid="ACT 22:4" /><note caller="+" style="x"><char style="xo" closed="false">22:4 </char><char style="xt" closed="false"><ref loc="ACT 8:3">नेवताळा ना काम 8:3</ref>; <ref loc="ACT 26:9-11">26:9-11</ref></char></note>मे आहयी वाट पोर चालवा वाळा अदमड़ा ने अने बयरा ने धरी-धरीन ह़ाकळ्‌ये करीन बांदीन जेल मे बंद कर देत्‌लो, अने एतरी जबर वेला पाड़्‌यो के तीहया मरी बी ज्‌या। <verse eid="ACT 22:4" /><verse number="5" style="v" sid="ACT 22:5" />आहयी वात ना लेदे पुंजारा अने आखा डायला गवा से; के तीमनी सी मे युहदी भायु ना नाम पोर चीट्‌ठ्‌या लीन दमीस्‌क ह़ेर मे जवा बाज र्‌यो हतो, के जे माणहु आहयी वाट पोर चाले तीमने बांदीन यरुसलेम ह़ेर मे लीन आव्‌वा जेलो के तीमने डंड अपाड़ सकु।<verse eid="ACT 22:5" /></para>
  <para style="s">पोलुस आह़फा नु मन बदलवा ना बारा मे केय</para>
  <para style="r">(<ref loc="ACT 9:1-19">9:1-19</ref>; <ref loc="ACT 26:12-18">26:12-18</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 22:6" />“जत्‌यार मे जतो-जतो दमीस्‌क पुग्‌यो, ता माथेक दाड़े ह़रगे गेथु घण जादा वीजाळु उचकाहलुत मारा च्‌यारो-मेर भबळ्‌यु।” <verse eid="ACT 22:6" /><verse number="7" style="v" sid="ACT 22:7" />मे भोयमे पड़ ज्‌यो अने मने एक बोल ह़मळायो, साउल! साउल! तु मने काहा वेला पाड़ र्‌यो? <verse eid="ACT 22:7" /><verse number="8" style="v" sid="ACT 22:8" />तत्‌यार मे जपाप आप्‌यो, “मालीक! तु कोय से?” तीहयो मने केदो, “मे ईसु नासरी से। जीने तु वेला पाड़े।” <verse eid="ACT 22:8" /><verse number="9" style="v" sid="ACT 22:9" />मारा ह़ाती वीजाळु ते देख्‌या बाखीन मारी ह़ाते वात करन्‌या नो बोल नी ह़मळ्‌या। <verse eid="ACT 22:9" /><verse number="10" style="v" sid="ACT 22:10" />ता मे तीने केदो, ए मालीक, मने ह़ु करवा जोवे? मालीक मने जपाप आप्‌यो, उठीन दमीस्‌क जत रे, अने तने ह़ु करवा जोवे, अने तारी जुगु ह़ु करवा नु ठेरावलु से, तीहयु मे तां की देही। <verse eid="ACT 22:10" /><verse number="11" style="v" sid="ACT 22:11" />तीहयु वीजाळु ना भबळा ना कारण सी मे आंदळो हय जेलो, एतरे मारा ह़ाती मारो हात धरीन मने दमीस्‌क मे ली ज्‌या।<verse eid="ACT 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 22:12" />अने तां भगवान ना कायदा ना अनसारे चालवा वाळो भगत माणेह हतो। तीनु नाम हनन्‌या हतु। तीहयो तां रेण्‌या युहदी माणहु मे नामह़ाद्‌यो हतो। आहयोत हनन्‌यो मारीन्‌तां आयो। <verse eid="ACT 22:12" /><verse number="13" style="v" sid="ACT 22:13" />अने मारी ह़ाते उबो हय्‌न केदो, “भाय साउल! अळी पासो देखवा बाज जा।” अने मे तत्‌यारुत तीनी भणी देख्‌यो। <verse eid="ACT 22:13" /><verse number="14" style="v" sid="ACT 22:14" />अळतेण तीहयो हनान्‌या मने केदो, अमारा डाह-डाहा नो भगवान तने एतरोत टाळलो से के तु तीनी मरजी जाण लेय, अने ते नीयाव करन्‌या चाकर्‌या ने देखीन तीनी मोडा सी वात ह़मळे। <verse eid="ACT 22:14" /><verse number="15" style="v" sid="ACT 22:15" />काहाके तु जे देखलो से अने ह़मळ्‌ळो से तीहयी वात नी गवा आखी दुर हये तेम। <verse eid="ACT 22:15" /><verse number="16" style="v" sid="ACT 22:16" />एतरे हाव तु वार ना लगाड़े, अने छोटो उठीन बपतीस्‌मा ली ले अने तीना नामे भगवान ह़ाते वीन्‌ती करीन आपणा पाप सी छुटकारो हात कर ले।<verse eid="ACT 22:16" /></para>
  <para style="s">पोलुस आड़जात्‌या माणहु ने ह़ीकाड़े</para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 22:17" />“जत्‌यार मे पासो यरुसलेम मे आयो अने मंदीर मे भगवान ह़ाते वीन्‌ती करवा बाज रेलो, ता मे बेह़ुद हय ज्‌यो। <verse eid="ACT 22:17" /><verse number="18" style="v" sid="ACT 22:18" />अने मे मालीक ने देख्‌यो अने मने तीहयो आहयु केवा बाज र्‌यो हतो, ‘उतवाळ करीन यरुसलेम गेथो छोटो बारथो नीकळ जा, काहाके तीहया मारा बारा मे तारी गवाय नी हुकारे।’ <verse eid="ACT 22:18" /><verse number="19" style="v" sid="ACT 22:19" />एतरे मे मालीक ने केदो, ‘मालीक! हीय्‌या ते जाणे के मे तारी पोर भरहो करन्‌या ने धरीन जेल मे कुंडतो हतो, अने जागे-जाग भक्‌ती ना घोरु डीट तीमने ठोकाड़तो हतो। <verse eid="ACT 22:19" /><verse number="20" style="v" sid="ACT 22:20" /><note caller="+" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="ACT 7:58">नेवताळा ना काम 7:58</ref></char></note>जत्‌यार तारी गवाय देण्‌या स्‌तीफनुस ने माणहु दगड़ाटीन मारवा बाज रेला, तत्‌यार मे बी तीहयी वात मे राजी हतो अने तां उबो हय रेलो। अने जे माणहु स्‌तीफनुस ने मारवा बाज रेला तीमना लुगड़ा नी रखवाळी करवा बाज रेलो।’ <verse eid="ACT 22:20" /><verse number="21" style="v" sid="ACT 22:21" />एतरा मे मालीक मने केदो, ‘तु जत रे। मे तने आखी जाती ना माणहुन तां मारी गवा देवा करीन नाम्‌बे-नाम्‌बे मोकलही।’”<verse eid="ACT 22:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 22:22" />माणहु पोलुस नी आहयी वात आञे लग ह़मळता र्‌या; बाखीन हाव तीहया आड़ीन केदा, “आने मार नाखो। आने धरती पोर जीवत्‌लो रेवा वारु नी हय।” <verse eid="ACT 22:22" /><verse number="23" style="v" sid="ACT 22:23" />जत्‌यार तीहया आड़ता अने लुगड़ा एथान-एथा नाख र्‌या हता, अने वाहळा मे धुळो उडाड़ता हता, <verse eid="ACT 22:23" /><verse number="24" style="v" sid="ACT 22:24" />ता सीपायड़ा ना मेळा नो सुबेदार हुकम आप्‌यो, “आने कीला मे ली जावो, अने ह़ड़का दीन पारखो, जीनी सी आहयु मालम पड़े के माणहु आना वीरोद मे काहा आड़ी र्‌या।” <verse eid="ACT 22:24" /><verse number="25" style="v" sid="ACT 22:25" />जत्‌यार तीहया तीने बांद र्‌या हता, ता पोलुस तीनी ह़ाते उबो हय रेला सुबेदार ने पुछ्‌यो, “कायदा ना अनसारे वण-गुनाळ्‌ळा रोमी माणेह ने चपकाटवा ताले से ह़ु?”<verse eid="ACT 22:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 22:26" />ता आहयु ह़मळीन सुबेदार सीपायड़ा ना डायला मुखी ने जाय्‌न केदो, “तु आसम काहा करवा बाज र्‌यो? तने मालम नी हय ह़ु के आहयो रोमी माणेह से।”<verse eid="ACT 22:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 22:27" />आहयु ह़मळीन सीपायड़ा नो डायलो मुखी पोलुस ना ह़ाते आवीन पुछ्‌यो, “मने देखाड़ तु रोमी से ह़ु?” पोलुस केदो, “होव!”<verse eid="ACT 22:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 22:28" />आहयु ह़मळीन सीपायड़ा नो डायलो मुखी केदो, “रोमी राज मे रेवा नो हक हात करवा करीन मने घण ढेरका पय्‌हा आपवा पड़्‌या।” पोलुस केदो, “मे ते पयदा हयो ता गेथोत रोमी से।”<verse eid="ACT 22:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 22:29" />आहयु ह़मळीन जे माणहु पोलुस ने पारखवा हींड्‌ता हता, तीहया पोलुस ने तां गेथा पासा ह़रकी ज्‌या; अने सीपायड़ा नो डायलो मुखी बी आहयु जाण्‌यो के पोलुस रोमी से, मे धरीन बंदाड़लो से करीन बीही ज्‌यो।<verse eid="ACT 22:29" /></para>
  <para style="s">मोट्‌ली पंचु अगळ पोलुस</para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 22:30" />बीजा दाड़े तीहयो पोलुस नी हातकड़ी सोड़ देदो अने मंदीर ना डायला पुंजारा ने अने आखी मोट्‌ली बठक ने भेळी करो करीन सीपायड़ा ने हुकम आप्‌यो। अने पोलुस ने हेटो ली जाय्‌न तीमनी अगळ उबो कर देदो काहाके युहदी माणहु आनो वाक काहा काड र्‌या आहयी वात तीहयो जाणवा हींड्‌तो हतो।<verse eid="ACT 22:30" /></para>
  <chapter eid="ACT 22" />
  <chapter number="23" style="c" sid="ACT 23" />
  <para style="p">
    <verse number="1" style="v" sid="ACT 23:1" />पोलुस युहदी माणहु नी मोट्‌ली बठक भणी एकडीट्‌यो भाळीन केदो, “ए मारा भाय-बेटा! मे आज लग भगवान अगळ वारला मन सी जीवाय जीवलो से।” <verse eid="ACT 23:1" /><verse number="2" style="v" sid="ACT 23:2" />पोलुस नी वात ह़मळीन मंदीर नो डायलो पुंजारो हनन्‌या ह़ाते उबा हय रेला माणहु ने हुकम आपीन केदो, “पोलुस ना गाल्‌ये थापड़ दे।” <verse eid="ACT 23:2" /><verse number="3" style="v" sid="ACT 23:3" /><note caller="+" style="x"><char style="xo" closed="false">23:3 </char><char style="xt" closed="false"><ref loc="MAT 23:27">मत्‌ती 23:27</ref>,<ref loc="MAT 23:28">28</ref></char></note>तत्‌यार पोलुस तीमने केदो, “ए चुना वेर नीपलु भीतड़ु! तु मुसा ना कायदा ना अनसारे मारो नीयाव करवा बह र्‌यो, पण मुसा नो कायदो तोड़ीन मने थापड़ दे करीन बीजा ने की र्‌यो। तने ते भगवान देहे।”<verse eid="ACT 23:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 23:4" />ह़ाते उबा हय रेला माणहु पोलुस ने केदा, “तु भगवान ना मंदीर ना डायला पुंजारा ने हीसम वाक काडीन जपाप काहा आप्‌यो?”<verse eid="ACT 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ACT 23:5" />पोलुस जपाप आप्‌यो, “ए भायु! मने नी मालम हतु, के आहयो डायलो पुंजारो से; काहाके चोखली सास्‌तर मे लीखलु से के ‘जे आपणा माणहु नो डायलो से तीने बुरु नी केवो।’”<verse eid="ACT 23:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 23:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">23:6 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 26:5">नेवताळा ना काम 26:5</ref>; <ref loc="PHP 3:5">फीलीपीयो 3:5</ref></char>
    </note>ता पोलुस ने मालम पड़्‌यु के एक टोळो सदुकी पंथवाळा नो अने एक टोळो फरीसी पंथवाळा नो से। ता तीहयो मोट्‌ली बठक ने आड़ीन केदो, “ए भायु! मे फरीसी पंथवाळो से अने फरीसी माणहु नो सोरो से। मर्‌या-ह़र्‌या मे गेथा पासा जीवता हयवा नी आह ना बारा मे मारो नीयाव हयवा बाज र्‌यो।”<verse eid="ACT 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 23:7" />पोलुस नी आहयी वात ह़मळीन सदुकी पंथवाळा नो अने फरीसी पंथवाळा नो झगड़ो हयवा बाज ज्‌यो। अने मोट्‌ली बठक मे बेरजाव पड़ ज्‌यो। <verse eid="ACT 23:7" /><verse number="8" style="v" sid="ACT 23:8" /><note caller="+" style="x"><char style="xo" closed="false">23:8 </char><char style="xt" closed="false"><ref loc="MAT 22:23">मत्‌ती 22:23</ref>; <ref loc="MRK 12:18">मरकुस 12:18</ref>; <ref loc="LUK 20:27">लुका 20:27</ref></char></note>काहाके सदुकी पंथवाळा नो भरहो से के मर्‌या-ह़र्‌या मे गेथा पासा जीवता हयवा नु नी हय, अने ह़रगदुत बी नी हय। अने नी आत्‌मा हय। पण फरीसी पंथवाळा आहयु आखु ने माने। <verse eid="ACT 23:8" /><verse number="9" style="v" sid="ACT 23:9" />अने तां घणी कचाट हय री हती। फरीसी पंथ मे गेथा थोड़ाक पुडार्‌या उबा हय ज्‌या, अने आहयु कीन झगड़वा बाज ज्‌या, के “आमु आहया माणेह मे कंय बी बुराय नी जड़ी। पण कदी कोय आत्‌मा नीता ह़रगदुत आनी ह़ाते वात कर्‌यो बी हय!”<verse eid="ACT 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 23:10" />जत्‌यार झगड़ो जादा हयवा बाज ज्‌यो, ता सीपायड़ा नो मुखी सुबेदार बीही ज्‌यो काहाके तीहया पोलुस ने मारीन टुकड़ा-टुकड़ा नी कर नाखे। एतरे तीहयो सीपायड़ा ना टोळा ने हुकम आप्‌यो, के हेटा उतरीन जावो, अने हीने जबराण हीमनीन तां गेथो नीकाळ लावो, अने कीला मे ली जावो।<verse eid="ACT 23:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 23:11" />तीहयीत राते मालीक ईसु पोलुस ने देखाव पड़्‌यो अने केदो, “ए पोलुस, हीम्‌मत राख; काहाके जीसम तु यरुसलेम मे मारी गवाय देदलो से, तेमेत तने रोम ह़ेर मे बी जाय्‌न गवा देवा पड़हे।”<verse eid="ACT 23:11" /></para>
  <para style="s">पोलुस ने मारवा नी योजना</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 23:12" />बीजा दाड़े ह़वारे युहदी माणहु एक्‌को कर्‌या, अने ह़ाम खादा के जत्‌यार लग आमु पोलुस ने मारी नी नाखीया तां लग नी खाणु खाया अने नी पाणी पीया। <verse eid="ACT 23:12" /><verse number="13" style="v" sid="ACT 23:13" />जे आहयी ह़ाम खादला तीहया चाळीह़ जणा गेथा बी वदु हता। <verse eid="ACT 23:13" /><verse number="14" style="v" sid="ACT 23:14" />तीहया पुंजारान्‌तां अने पुडार्‌यान्‌तां जाय्‌न केदा, “आमु आहयी ह़ाम खादला से के जत्‌यार लग पोलुस ने नी मार नाखीया तांह लग नी खाणु खाया अने नी पाणी पीया। <verse eid="ACT 23:14" /><verse number="15" style="v" sid="ACT 23:15" />एतरे हाव मोट्‌ली बठक भेळ जाय्‌न सीपायड़ा ना मुखी सुबेदार ने ह़मजाड़ो के हीय्‌या पोलुस ने तमारीन्‌तां ली आवे, काहाके तमु हीने वारु पारखवा हय र्‌या, अने आमु तीने पुगवा सी पेलेत तीने मार नाखवा नी लेदे तीयारी मे रेहु।”<verse eid="ACT 23:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 23:16" />पण पोलुस ना भाणजे ने जाळसादी ना बारा मे मालम पड़ ज्‌यु एतरे तीहयो कीला मे जाय्‌न पोलुस ने आखी वात की देदो। <verse eid="ACT 23:16" /><verse number="17" style="v" sid="ACT 23:17" />पोलुस सुबेदार्‌या मे गेथो एक ने आह़फान तां बोलावीन केदो; “आहया सोरा ने डायला सुबेदार ने तां ली जावो; काहाके आहयो डायला सुबेदार ने कंय केवा हींड र्‌यो।” <verse eid="ACT 23:17" /><verse number="18" style="v" sid="ACT 23:18" />एतरे तीहयो सुबेदार ते सोरा ने डायला सुबेदार ने तां ली जाय्‌न तीहया डायला सुबेदार ने केदो, “हातकड़ी लगाड़ मेली तीहयो पोलुस मने बोलावीन वीन्‌ती कर्‌यो के आहयो सोरो डायला सुबेदार ने कंय केवा हींड र्‌यो; एतरे आहया सोरा ने डायला सुबेदार ने तां ली जा।”<verse eid="ACT 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 23:19" />डायलो सुबेदार तीहया सोरा नो हात धरीन तीने एक धेड़्‌यो ली जाय्‌न पुछ्‌यो, “मने ह़ु केवा हींड र्‌यो?”<verse eid="ACT 23:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ACT 23:20" />ते सोरो केदो, “युहदी माणहु एक्‌को कर र्‌या के तारी पांह वीन्‌ती करहु, के वाहणे पोलुस ने मोट्‌ली बठक मे लावे, मानो तु अळी वारु तीनी पारख करवा हींड र्‌यो। <verse eid="ACT 23:20" /><verse number="21" style="v" sid="ACT 23:21" />पण तु हीमनी वात नी मानजे, काहाके हीमनी मे चाळीह़ गेथा बी वदु माणहु पोलुस ने मारवा तकाय र्‌या। अने तीहया ह़ाम खादला से के जत्‌यार लग आमु पोलुस ने मारीन नी नाखीया तांह लग नी खाणु खाया अने नी पाणी पीया। अने तीहया हमणे तीयार से, अने तारा हुकम नी वाट जोय र्‌या।”<verse eid="ACT 23:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 23:22" />ते सोरा नी वात ह़मळीन डायलो सुबेदार तीहया सोरा ने आहयो हुकम आपीन मोकल्‌यो के “तु आहयी वात कोयने नी केजे के तु आहयी वात मने देखाड़्‌यो।”<verse eid="ACT 23:22" /></para>
  <para style="s">पोलुस ने फेलीक्‌स राजान तां मोकले</para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 23:23" />अने बे सुबेदार्‌या ने बोलावीन केदो, “केसर्‌या ह़ेर जवा करीन बे ह़ो सीपायड़ा अने सत्‌तर घोड़ा पोर बहीन जाण्‌या, अने बे ह़ो भाला वाळा सीपायड़ा तीयार हय जावो। अने आज राते नव बजे तक नीकळवा तीयार रेजो। <verse eid="ACT 23:23" /><verse number="24" style="v" sid="ACT 23:24" />अने पोलुस ने नीयाव करन्‌या फेलीक्‌स ने तां घोड़ा पोर बहाड़ीन आरगलो लीजवा करीन घोड़ो तीयार राखजो।” <verse eid="ACT 23:24" /><verse number="25" style="v" sid="ACT 23:25" />तीहयो आसम चीट्‌ठी बी लीखीन ली मोकल्‌यो:<verse eid="ACT 23:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ACT 23:26" />“मुख्‌या नीयाव करन्‌या फेलीक्‌स! ने कलोदीयुस लुसीयास ने वारलो से के केम। <verse eid="ACT 23:26" /><verse number="27" style="v" sid="ACT 23:27" />आहया माणेह ने युहदी माणहु धर लेदला अने मारवा हींडत्‌ला; पण जत्‌यार मने मालम पड़्‌यु के आहयो रोमी से, ता मे सीपायड़ा ने लीन जाय्‌न ईने बचाड़ लेदो। <verse eid="ACT 23:27" /><verse number="28" style="v" sid="ACT 23:28" />अने मे जाणवा हींडतो हतो के हीय्‌या आनी पोर काहा गुनो लगाड़ र्‌या; एतरे मे हीने हीमनी मोट्‌ली बठक मे ली ज्‌यो। <verse eid="ACT 23:28" /><verse number="29" style="v" sid="ACT 23:29" />ता मने मालम पड़्‌यु के तीहया तीमना कायदा नी लीखली सास्‌तर नी वात ने लीन तीनी पोर गुनो लगाड़ र्‌या, पण आहयो एसवो गुनो नी कर्‌यो के आने जेल मे कुंडु पड़े अने मारवा पड़े। <verse eid="ACT 23:29" /><verse number="30" style="v" sid="ACT 23:30" />अने जत्‌यार मने आहयु मालम पड़्‌यु के माणहु हीने मारवा नी जाळसादी मे लाग र्‌या, ता मे हीने तत्‌यारुत तारीन्‌तां मोकली देदो। अने गुनो लगाड़न्‌या ने बी केदो के जे बी गुनो तमु आनी पोर लगाड़ र्‌या ते गुनो नीयाव करन्‌या फेलीक्‌स अगळ लगाड़जो।”<verse eid="ACT 23:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="ACT 23:31" />एतरे सीपायड़ा जीसम केदलु तेमेत कर्‌या अने तीहया रातम-रात पोलुस ने अंतपतरीस मे पुगाड़ देदा। <verse eid="ACT 23:31" /><verse number="32" style="v" sid="ACT 23:32" />बीजा दाड़े घोड़ा पोर बहीन जाण्‌या सीपायड़ा पोलुस ह़ाते ज्‌या अने बीजा यरुसलेम कीला मे पासा आवती र्‌या। <verse eid="ACT 23:32" /><verse number="33" style="v" sid="ACT 23:33" />अने तीहया केसर्‌या मे पुग्‌या ता ते चीट्‌ठी नीयाव करन्‌या ने आप देदा, अने पोलुस ने बी तीना हात मे ह़ोप देदा <verse eid="ACT 23:33" /><verse number="34" style="v" sid="ACT 23:34" />अने तीहयो चीट्‌ठी भणीन पोलुस ने पुछ्‌यो, “तु काना देस मे वाळो से?” जत्‌यार तीने मालम हयु के हीय्‌यो कीलीकीया गेथो से। <verse eid="ACT 23:34" /><verse number="35" style="v" sid="ACT 23:35" />अने तीहयो जाण लेदो के कीलीकीया परगणा नो से, ता पोलुस ने केदो, “जत्‌यार तार पोर गुनो लगाड़न्‌या आवहे ता तारो नीयाव करही।” अने तीहयो सीपायड़ा ने हुकम आपीन केदो, आने हेरोद ना कीला मे ली जाय्‌न पेहरो देवो।<verse eid="ACT 23:35" /></para>
  <chapter eid="ACT 23" />
  <chapter number="24" style="c" sid="ACT 24" />
  <para style="s">फेलीक्‌स नी अगळ पोलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 24:1" />पांच दाड़ान अळतेण डायलो पुंजारो हनन्‌यो थोड़ाक पुडार्‌या अने तीरतुल्‌लुस नाम ना वकील ने लीन केसर्‌या आयो। तीहया आखा नीयाव करन्‌या अगळ पोलुस पोर गुनो लगाड़्‌या। <verse eid="ACT 24:1" /><verse number="2" style="v" sid="ACT 24:2" />जत्‌यार पोलुस ने बोलाया ता तीरतुल्‌लुस पोलुस पोर आहयो गुनो लगाड़ीन केदो, “ए मोटा मे मोटा फेलीक्‌स! आमु तारा कारण वारु ह़ुकना जीवी र्‌या, तु नाम्‌बे गेथो देखीन चाले एतरे कंय बुराय ह़ुदरती जाय री। <verse eid="ACT 24:2" /><verse number="3" style="v" sid="ACT 24:3" />ए आखा गेथा वारु फेलीक्‌स! आमु तारी लारे ह़ुदारली वात ने वारु मानया, अने तने वारु कीया। <verse eid="ACT 24:3" /><verse number="4" style="v" sid="ACT 24:4" />पण मारी वीन्‌ती से के तु थोड़ीक वार अळी थांग, अने दया करीन अमारी बेक वात अळी ह़मळ ले। <verse eid="ACT 24:4" /><verse number="5" style="v" sid="ACT 24:5" />अमारु केवु से के आहयो अदमी भड़कावण्‌यो से। आहयो आखी कळी ना युहदी माणहु मे झगड़ो घालन्‌यो से, अने नासरी ना पंथवाळा नो डायलो से। <verse eid="ACT 24:5" /><verse number="6" style="v" sid="ACT 24:6" />आहयो यरुसलेम ना मंदीर ने बी वीटाळ्‌वा नी कोसीस करलो एतरे आमु आने धर पाड़्‌या। आमु मुसा ना कायदा ना अनसारे आनो नीयाव करवा हींडत्‌ला। <verse eid="ACT 24:6" /><verse number="7" style="v" sid="ACT 24:7" />पण डायलो सुबेदार हीने जबराण अमारा हात मे गेथो हापकी लेदो। <verse eid="ACT 24:7" /><verse number="8" style="v" sid="ACT 24:8" />अने आसम गुनो लगाड़न्‌या ने तीहयो केदो के तमु फेलीक्‌सन तां जाय्‌न गुनो लगाड़जो। आहयी आखी वात ना बारा मे जे गुनो आमु आनी पोर लगाड़ र्‌या। तीहयी वात ने तु आह़फोत पारखी लेही।” <verse eid="ACT 24:8" /><verse number="9" style="v" sid="ACT 24:9" />युहदी माणहु बी तीनो सात दीन केदा, “होव, आहयी वात ह़ाचली से।”<verse eid="ACT 24:9" /></para>
  <para style="s">फेलीक्‌स राजा नी अगळ पोलुस नो बचावो</para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 24:10" />जत्‌यार नीयाव करन्‌यो पोलुस ने बोलाव्‌वा नो ईसारो कर्‌यो ता तीहयो आसम जपाप आप्‌यो, “मे जाणु के तु घणा साल गेथो आहयी जाती ना माणहु नो नीयाव कर र्‌यो, एतरे मे खुस हय्‌न तारी वात नो जपाप देही। <verse eid="ACT 24:10" /><verse number="11" style="v" sid="ACT 24:11" />तु जाण सकत्‌लो, के जत्‌यार मे यरुसलेम मे भगवान नी भक्‌ती करवा आवलो, मने बारे दाड़ा गेथा वदु नी हया। <verse eid="ACT 24:11" /><verse number="12" style="v" sid="ACT 24:12" />अने तीहया मने नी मंदीर मे अने नी भक्‌ती ना घोर मे अने नी ह़ेर मे वात मे झटा-पटी अने माणहु ने भेळा करीन भड़कावत्‌लो देख्‌या। <verse eid="ACT 24:12" /><verse number="13" style="v" sid="ACT 24:13" />अने आहया जे वात मे मारो वाक काडीन गुनो लगाड़ र्‌या, तीहयी वात ने हाव बी आहया ह़ाचली नी ठेराय सके। <verse eid="ACT 24:13" /><verse number="14" style="v" sid="ACT 24:14" />मे तारी अगळ आहयी वात मान लेम के जे पंथ आहया रद्‌दी-पंथ केय। तीनीत रीती पोर मे आपणा आड़ा-बुड़ा ना भगवान नी सेवा-चाकरी कर र्‌यो; अने जे वात मुसा ना लारे लीखली सास्‌तर मे अने भगवान वगे गेथा वात करन्‌या माणहु नी कीताप मे लीखली से, तीहयी आखी वात पोर मे भरहो करु। <verse eid="ACT 24:14" /><verse number="15" style="v" sid="ACT 24:15" />अने भगवान सी मे आह राखु जीसम तीहया राखता हता, के भगवान धरमी ने अने वण-धरमी ने मर्‌या-ह़र्‌या मे गेथो जीवतो करीन बठो करहे। <verse eid="ACT 24:15" /><verse number="16" style="v" sid="ACT 24:16" />एतरे मे बी भगवान अगळ अने माणहु अगळ मारा सच्‌चा मन सी जे ह़ाची से तीहयुत करवा नी कोसीत करु।<verse eid="ACT 24:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 24:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">24:17 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 21:17-28">नेवताळा ना काम 21:17-28</ref>
      </char>
    </note>“ढेरेत साल बाद मे मारा भाय-बेटा ने भेट पुगाड़वा अने जानवर मारीन बादा चड़ाव्‌वा यरुसलेम आवलो हतो। <verse eid="ACT 24:17" /><verse number="18" style="v" sid="ACT 24:18" />अने तीहया मने मंदीर मे जानवर मारीन बादा चड़ावत्‌लो अने भेट आपत्‌लो देख लेदा। मे आहयु काम चोखली हालत सी अने बीजा माणहु ने बोलावीन गड़दी कर्‌या वगर कर र्‌यो हतो। तीहयी टेमे मारी ह़ाते आसीया वाळा ढेरेत युहदी बी हता; अने तीमने आहयु काम वारु लाग्‌यु। <verse eid="ACT 24:18" /><verse number="19" style="v" sid="ACT 24:19" />कदीम तीमने मारा वीरोद मे कंय केवा नु हतु, ता तीहया आञे तार अगळ आय्‌न मार पोर गुनो लगाड़ता। <verse eid="ACT 24:19" /><verse number="20" style="v" sid="ACT 24:20" />नीता जे माणहु आञे से ईमनेत केवा दे के जत्‌यार मे मोट्‌ली बठक मे हतो, ता तीहया मारी मे कंय गुनो देखला? <verse eid="ACT 24:20" /><verse number="21" style="v" sid="ACT 24:21" /><note caller="+" style="x"><char style="xo" closed="false">24:21 </char><char style="xt" closed="false"><ref loc="ACT 23:6">नेवताळा ना काम 23:6</ref></char></note>होव, एक वात जरुड़ हयी के मे हीमना वच मे उबो रीन ज्‌योरेत आड़ीन केदलो हतो के ‘मर्‌या-ह़र्‌या मे गेथा पासा जीवता हयवा नी आह ना बारा मे आज तमारी अगळ मारो नीयाव हयवा बाज र्‌यो।’”<verse eid="ACT 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 24:22" />फेलीक्‌स आहया पंथ ना बारा मे वारु जाणतो हतो, पण तीहयो आहयु कीन तीमनी सुनवाय टाळ देदो, “जत्‌यार डायलो सुबेदार लुसीयास आवहे, ता तमारी वात नो फेसलो करही।” <verse eid="ACT 24:22" /><verse number="23" style="v" sid="ACT 24:23" />अळतेण तीहयो सुबेदार ने हुकम आप्‌यो के तु पोलुस नी जेल मे वारु रखवाळी करजे, अने तीना दोस्‌तीदार आवे ता तीनी सेवा-चाकरी करवा सी नी रोकजे।<verse eid="ACT 24:23" /></para>
  <para style="s">फेलीक्‌स अने तीनी लाडी द्‌रुसील्‌ला नी अगळ पोलुस</para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 24:24" />थोड़ाक दाड़ान अळतेण फेलीक्‌स आह़फा नी घोरवाळी द्‌रुसील्‌ला ने, जे युहदी जाती नी हती, ह़ाते लीन आयो। तीहयो पोलुस ने बोलावीन आहयु पुछ्‌यो के ईसु मसी पोर भरहो काहा करवा जोवे? अने पोलुस तीने देखाड़्‌यो। <verse eid="ACT 24:24" /><verse number="25" style="v" sid="ACT 24:25" />जत्‌यार पोलुस धरम ना बारा मे, अने आपणा जीव ने मनाड़वा ना बारा मे, अने आव्‌वा वाळा नीयाव ना बारा मे वात कर र्‌यो हतो। ता फेलीक्‌स घण-जबर बीही ज्‌यो अने पोलुस ने केदो “हाव तु जत रे, टेम जड़हे ता मे तने अळी बोलावही।” <verse eid="ACT 24:25" /><verse number="26" style="v" sid="ACT 24:26" />फेलीक्‌स आहयी आह कर र्‌यो हतो के पोलुस मने रुप्‌या आपहे। करीन तीहयो पोलुस ने वळ-वळीन तीनी वात ह़मळवा करीन बोलाया करत्‌लो।<verse eid="ACT 24:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 24:27" />फेलीक्‌स युहदी माणहु ने खुस करवा हींडतो हतो। एतरे तीहयो पोलुस ने जेल मेत रेवा देदो। पण अळतेण बे साल वीत ज्‌या, ता फेलीक्‌स नी अवजी पोर पुरकीयुस फेस्‌तुस आयो।<verse eid="ACT 24:27" /></para>
  <chapter eid="ACT 24" />
  <chapter number="25" style="c" sid="ACT 25" />
  <para style="s">फेस्‌तुस नी अगळ पोलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 25:1" />फेस्‌तुस ते परगणा मे पुगीन तीन दाड़ान अळतेण केसर्‌या गेथो यरुसलेम पुग्‌यो। <verse eid="ACT 25:1" /><verse number="2" style="v" sid="ACT 25:2" />तां मंदीर नो डायलो पुंजारो अने युहदी माणहु ना नेता आवीन पोलुस पोर गुनो लगाड़्‌या। <verse eid="ACT 25:2" /><verse number="3" style="v" sid="ACT 25:3" />अने तीहया माणहु फेस्‌तुस पांह आहयी वीन्‌ती कर्‌या के तु पोलुस ने यरुसलेम बोलाव। काहाके तीहया वाट्‌येत पोलुस ने मार नाखवा हींडता हता। <verse eid="ACT 25:3" /><verse number="4" style="v" sid="ACT 25:4" />बाखीन फेस्‌तुस आहयो जपाप आप्‌यो, “पोलुस केसर्‌या ह़ेर नी जेल मे से। अने मे खुद तां छोटोत जही। <verse eid="ACT 25:4" /><verse number="5" style="v" sid="ACT 25:5" />एतरे तमु तमारा अदीकार्‌या ने मारी ह़ाते मोकली देवो अने कदीम तीहयो माणेह कंय गुनो कर्‌यो हहे, ता तीहया तां तीनी पोर गुनो लगाड़े तेम।”<verse eid="ACT 25:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ACT 25:6" />अने फेस्‌तुस तीमनी वच मे आंठ दह दाड़ा रीन पासो केसर्‌या ज्‌यो, बीजा दाड़े फेस्‌तुस नीयाव नी गादी पोर बहीन सीपायड़ा ने हुकम आप्‌यो के “पोलुस ने बोलाय लावो।” <verse eid="ACT 25:6" /><verse number="7" style="v" sid="ACT 25:7" />जत्‌यार पोलुस आयो, ता यरुसलेम गेथा आवला युहदी अदीकार्‌या, तीनी च्‌यारो-मेर उबा हय्‌न तीनी पोर ढेरेत गुना लगाड़्‌या। जीनो पुरावो तीहया दी नी सकता हता। <verse eid="ACT 25:7" /><verse number="8" style="v" sid="ACT 25:8" />पण पोलुस जपाप आप्‌यो, “मे युहदी कायदा ना बी, अने मंदीर ना बी, अने राजा केसर ना बी वीरोद मे कंय गुनो नी कर्‌यो।”<verse eid="ACT 25:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 25:9" />बाखीन फेस्‌तुस युहदी माणहु ने खुस करवा करीन पोलुस ने पुछ्‌यो, “तु यरुसलेम जवा तीयार से ह़ु, जीनी सी तां मारी अगळ आहयी वात नो नीयाव हये तेम?”<verse eid="ACT 25:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ACT 25:10" />पोलुस जपाप आप्‌यो, “मे राजा केसर नीयाव करे, तीहयी गादी अगळ उबो हय र्‌यो, एतरे मारो नीयाव आञेत हयवा जोवे। जीसम तने मालम से के मे युहदी माणहु नु कंय बी गलत नी कर्‌यो। <verse eid="ACT 25:10" /><verse number="11" style="v" sid="ACT 25:11" />कदी मे गुनाळ्‌ळो हय, अने मोत नो डंड जड़े एसवो गुनो कर्‌यो हय, ता मे मरवा तीयार से; पण कदीम जे वात मे आहया मार पोर गुनो लगाड़ र्‌या, तीहयी वात ह़ाची नी हय ता, कोय बी मने हीमना सुपरत नी कर सके: मे केसर राजा अगळ नीयाव जुगु उबो हयवा नी वीन्‌ती करु।”<verse eid="ACT 25:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 25:12" />फेस्‌तुस बठक ना मंतर्‌या ह़ाते वीच्‌यार काडीन पोलुस ने आहयो जपाप आप्‌यो, “तु केसर राजा अगळ नीयाव जुगु उबो हयवा नी वीन्‌ती करलो से, एतरे तने केसर राजान तांत पुगाड़ देहु।”<verse eid="ACT 25:12" /></para>
  <para style="s">अगरीपा अने तीनी बेनेह बीरनीके अगळ पोलुस</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 25:13" />थोड़ाक दाड़ा वीतवान अळतेण राजो अगरीपा, तीनी बेनेह बीरनीके ह़ाते नवला राजा फेस्‌तुस ने भेटवा करीन केसर्‌या आया। <verse eid="ACT 25:13" /><verse number="14" style="v" sid="ACT 25:14" />तीहया तां ढेरेत दाड़ा री लेदा अने अळतेण फेस्‌तुस राजो पोलुस ना बारा मे अगरीपा राजा ने आहयु केदो, “फेलीक्‌स आञे एक अदमी ने जेल मेत रेवा दीन जत रेलो से। <verse eid="ACT 25:14" /><verse number="15" style="v" sid="ACT 25:15" />जत्‌यार मे यरुसलेम मे हतो, ता पुंजारा अने युहदी माणहु ना पुडार्‌या तीनी पोर गुनो लगाड़्‌या, अने केदा के हीने डंड आप। <verse eid="ACT 25:15" /><verse number="16" style="v" sid="ACT 25:16" />पण मे तीमने जपाप आप्‌यो, के ‘रोमी माणहु नी आहयी रीती नी हय के गुनो लगाड़न्‌या ने अने गुनो करन्‌या ने आंबा-सांबा उबा करीन तीमनी सुनवाय कर्‌या वगर डंड आप देय।’ <verse eid="ACT 25:16" /><verse number="17" style="v" sid="ACT 25:17" />एतरे जत्‌यार तीहया भेळा हये, ता जादा वार नी लगाड़्‌यो, पण बीजा दाड़े नीयाव नी गादी पोर बह ज्‌यो, अने तीहया माणेह ने लाव्‌वा नो हुकम आप्‌यो। <verse eid="ACT 25:17" /><verse number="18" style="v" sid="ACT 25:18" />बाखीन गुनो लगाड़न्‌या उबा हय्‌न तीनी पोर गुनो लगाड़्‌या, ता तीहया बुरी वात नो गुनो नी लगाड़्‌या जीसम मे ह़मजी रेलो। <verse eid="ACT 25:18" /><verse number="19" style="v" sid="ACT 25:19" />पण तीहया तीमना भरहान धरम ना बारा मे अने ईसु नाम ना माणेह ना बारा मे वात मे जखड़ी पड़ीन गुनो लगाड़ र्‌या हता, काहाके ईसु नाम नो माणेह जे मर जेलो तीने पोलुस मरला मे गेथो जीवतो हय ज्‌यो करीन केतो हतो। <verse eid="ACT 25:19" /><verse number="20" style="v" sid="ACT 25:20" />तीमनी वात नी झटा-पटी ह़मळीन मने ह़मज मे नी पड़्‌यु के आहयी वात नो पतो कीसम लगाड़ु? एतरे मे तीने पुछ्‌यो, तु यरुसलेम जही ह़ु, तां आहयी वात नो नीयाव हय सके तेम? <verse eid="ACT 25:20" /><verse number="21" style="v" sid="ACT 25:21" />बाखीन पोलुस केदो, के ‘मे मोट्‌ला राजा अगळ नीयाव जुगु उबो हयवा नी वीन्‌ती करु।’ ता मे सीपायड़ा ने हुकम आप्‌यो के जत्‌यार लग मे आने केसर ने तां नी मोकली देम, तां लग तमु आनी रखवाळी करो।”<verse eid="ACT 25:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ACT 25:22" />ता अगरीपा फेस्‌तुस ने केदो, “मे हीय्‌या माणेह नी वात ह़मळवा हींडु।” तीहयो केदो, “तु काले ह़मळ लेजे।”<verse eid="ACT 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 25:23" />बीजा दाड़े अगरीपा अने तीनी बेनेह बीरनीके रोमो-झोमो हय्‌न सीपायड़ा ना सुबेदार अने ह़ेर ना डायला माणहु ह़ाते तां आय लाग्‌या। ता फेस्‌तुस सीपायड़ा ने हुकम आप्‌यो, “पोलुस ने ली आवो।” <verse eid="ACT 25:23" /><verse number="24" style="v" sid="ACT 25:24" />फेस्‌तुस केदो, “ए राजा अगरीपा, अने आखा माणहु जे हजुर से। तमु आहया माणेह ने देख र्‌या, जीना बारा मे आखा युहदी माणहु यरुसलेम ह़ेर मे अने आञे बी आड़ी-आड़ीन मारी सी रावण्‌या करीन केदा, ‘आने मार नाखो। आने जीवत्‌लो रेवा वारु नी हय। <verse eid="ACT 25:24" /><verse number="25" style="v" sid="ACT 25:25" />पण मे जाण लेदो के आहयो मोत नो डंड जड़े एसवो कंय बी गुनो नी कर्‌यो पण ते बी तीहयो आफोत आसम वीन्‌ती कर्‌यो के मे मोट्‌ला राजा अगळ नीयाव जुगु उबो हयवा से।’ ता मे आने मोट्‌ला राजान तां मोकलवा नो फेसलो कर्‌यो। <verse eid="ACT 25:25" /><verse number="26" style="v" sid="ACT 25:26" />पण मोट्‌ला राजा ने आना बारा मे लीखीन ली मोकलवा जुगु कंय पुरावो नी जड़्‌यो। एतरे मे हीने तारी अगळ अने खास करीन ए राजा अगरीपा तारी अगळ लावलो से। आनी पारख करवा ना अळतेण लीखवा जुगु कंय ने कंय पुरावो जड़े तेम। <verse eid="ACT 25:26" /><verse number="27" style="v" sid="ACT 25:27" />मारो वीच्‌यार से के जे माणेह ने गुनाळ्‌ळो ह़मजीन धरीन हातकड़ी लगाड़ला से, तीना बारा मे ‘आहयो ह़ाचलीन गुनाळ्‌ळो से’ करीन चीट्‌ठी लीख्‌या वगर मोट्‌ला राजान तां मोकलवा वारु नी हय।”<verse eid="ACT 25:27" /></para>
  <chapter eid="ACT 25" />
  <chapter number="26" style="c" sid="ACT 26" />
  <para style="s">अगरीपा नी अगळ पोलुस नी बचाव नी वात</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 26:1" />अगरीपा राजा पोलुस ने केदो, “तने तारा बारा मे केवा नो हुकम से।” तत्‌यार पोलुस आह़फा ने बचाड़वा करीन हात उचो करीन केवा बाज ज्‌यो।<verse eid="ACT 26:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ACT 26:2" />“ए राजा अगरीपा, जे वात मे युहदी माणहु मार पोर घणो जादा गुनो लगाड़ला से। तीहयी वात मे आज तार अगळ जपाप आपवा मे खुद ने जुगाळो ह़मजु।” <verse eid="ACT 26:2" /><verse number="3" style="v" sid="ACT 26:3" />खास करीन आनीन करते के तु युहदी माणहु नी आखी रीती-भाती ने अने वात नी जखड़ी ने जाणे। एतरे मे तारी सी वीन्‌ती करु के तु गम खाय्‌न मारी ह़मळ।<verse eid="ACT 26:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="ACT 26:4" />“जेम मारी चाल-चलण सुरु गेथी मारा भाय-बेटा अने यरुसलेम मे जेम हती, आहयु आखु युहदी जाणे। <verse eid="ACT 26:4" /><verse number="5" style="v" sid="ACT 26:5" /><note caller="+" style="x"><char style="xo" closed="false">26:5 </char><char style="xt" closed="false"><ref loc="ACT 23:6">नेवताळा ना काम 23:6</ref>; <ref loc="PHP 3:5">फीलीपीयो 3:5</ref></char></note>कदीम तीहया गवाय देवा हींडे ता दी सके, तीहया सुरु गेथा मने ओळखे, के मे फरीसी पंथवाळो हय्‌न मारा धरम ना आखा खरला पंथ नी अनसारे जीवाय जीवलो से। <verse eid="ACT 26:5" /><verse number="6" style="v" sid="ACT 26:6" />अने हाव तीहया वायदा नी आह ना कारण सी जे भगवान अमारा आड़ा-बुड़ा ह़ाते करलो से, अने तीहयात वायदा ना लेदे मारो नीयाव हयवा बाज र्‌यो। <verse eid="ACT 26:6" /><verse number="7" style="v" sid="ACT 26:7" />तीहयोत वायदो पुरो हयवा नी आह करीन, अमारी बारे कुळी रात-दाड़ो भगवान नी सेवा कर री। एतरे ए राजा! आहयी आह ना बारा मे युहदी मार पोर गुनो लगाड़ र्‌या। <verse eid="ACT 26:7" /><verse number="8" style="v" sid="ACT 26:8" />भगवान मर्‌या-ह़र्‌या माणहु ने पासा जीवता करे। आसम वात मे केम ता तमारीन्‌तां आहयी वात काहा भरहा ना लायक नी ह़मजे?”<verse eid="ACT 26:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 26:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">26:9 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 8:3">नेवताळा ना काम 8:3</ref>; <ref loc="ACT 22:4">22:4</ref>,<ref loc="ACT 22:5">5</ref></char>
    </note>“मे बी ह़मजतो हतो के ईसु नासरी नाम ना वीरोद मे मने ढेरेत कंय करवा जोवे।” <verse eid="ACT 26:9" /><verse number="10" style="v" sid="ACT 26:10" />मे यरुसलेम मे बी वीरोद कर्‌यो; अने मंदीर ना डायला पुंजारान्‌तां जाय्‌न हक मांग लेदो अने ढेरेत चोखला माणहु ने जेल मे कुंड देदो। अने जत्‌यार बीजा तीमनो वीरोद करीन तीमने मार देत्‌ला ता मे बी तीमनी वात ने हुकारत्‌लो। <verse eid="ACT 26:10" /><verse number="11" style="v" sid="ACT 26:11" />अने मे तीहया आखा ने तीमना भक्‌ती ना घोर मे वेला पाड़त्‌लो अने तीमने जोर करीनेत केत्‌लो के तमु ईसु नो वाक काडो, अने मे तीमनी पोर एतरी जबर रीहवाय ज्‌यो के बीजा ह़ेर मे रेण्‌या ने बी वेला पाड़वा बाज ज्‌यो।<verse eid="ACT 26:11" /></para>
  <para style="s">पोलुस आह़फा ना मन बदलाव ना बारा मे देखाड़े</para>
  <para style="p">
    <verse number="12" style="v" sid="ACT 26:12" />आहयीत धुंद मे, मे मंदीर ना डायला पुंजारा पांह हक अने हुकम नी चीट्‌ठी लीन दमीस्‌क जवा बाज र्‌यो हतो। <verse eid="ACT 26:12" /><verse number="13" style="v" sid="ACT 26:13" />ता ए राजा! तीहयी वाट्‌येत मे माथेक दाड़े वादळा मे दाहड़ु ना ह़ेक करते बी जादा एक वीजाळु, मारी अने मारी ह़ाते चालवा वाळा नी च्‌यारो-मेर भबळत्‌लु देख्‌यो। <verse eid="ACT 26:13" /><verse number="14" style="v" sid="ACT 26:14" />आमु आखा धरती पोर पड़ ज्‌या अने मने ईब्‌रानी बोली मे एक बोल ह़मळायो, ए साउल, ए साउल! तु मने काहा वेला पाड़े? तारी जुगु पेराणा पोर पाटु देवा घणु काठु से। <verse eid="ACT 26:14" /><verse number="15" style="v" sid="ACT 26:15" />अने मे केदो, “मालीक! तु कोय से?” मालीक केदो, “मे ईसु से” जीने तु वेला पाड़े। <verse eid="ACT 26:15" /><verse number="16" style="v" sid="ACT 26:16" />तु उबो हय जा, काहाके मे तने तु जे देखलो तीहयु आखु माणहु ने केवा करीन मारो पावर्‌यो अने गवा बणावीन ठेरावलो से अने अळी आव्‌वा वाळी वात देखाड़वा करीन तने देखाड़ही। <verse eid="ACT 26:16" /><verse number="17" style="v" sid="ACT 26:17" />अने मे तने तारा माणहु सी अने आड़जात्‌या माणहु सी बचाड़तो रेही, जीमनी पांह मे हाव तने आनीन करते मोकलु <verse eid="ACT 26:17" /><verse number="18" style="v" sid="ACT 26:18" />तु हीमना डोळा उगाड़जे के तीहया अंदारला भणी गेथा वीजाळा भणी चाले। अने भुतड़ा ना हक मे गेथा सोड़ावीन भगवान भणी फीरे; के पापु नी माफी हात करीन, अने तीहया माणहु नी ह़ाते जे मारी पोर भरहो करवा सी चोखा करला से, तीमनी ह़ाते पंगात मे भेसकाय।<verse eid="ACT 26:18" /></para>
  <para style="s">पोलुस आह़फा ना काम ना बारा मे देखाड़े</para>
  <para style="p">
    <verse number="19" style="v" sid="ACT 26:19" />“एतरे ए राजा अगरीपा! मे तीहयी ह़रग मे गेथी देखाड़ली वात कदी नी टाळ्‌यो। <verse eid="ACT 26:19" /><verse number="20" style="v" sid="ACT 26:20" /><note caller="+" style="x"><char style="xo" closed="false">26:20 </char><char style="xt" closed="false"><ref loc="ACT 9:20">नेवताळा ना काम 9:20</ref>,<ref loc="ACT 9:28">28</ref>,<ref loc="ACT 9:29">29</ref></char></note>पण मे पेले दमीस्‌क वाळा ने, अळतेण यरुसलेम ह़ेर मे रेवा वाळा ने, अळतेण आखा युहद्‌या परगणा मे रेवा वाळा आड़जात्‌या माणहु ने आहयु ह़मजाड़तो र्‌यो, के तमु पाप करवा सोड़ीन भगवान भणी वळो अने भगवान ने गमे तेवु काम करो। <verse eid="ACT 26:20" /><verse number="21" style="v" sid="ACT 26:21" />आहयी वात नी करते युहदी माणहु मने मंदीर मे धर लेदा, अने मारीन नाख देवा नी कोसीत कर्‌या। <verse eid="ACT 26:21" /><verse number="22" style="v" sid="ACT 26:22" />पण मे भगवान नी मदत सी आज लग मर्‌यो नी अने नान्‌ला-मोट्‌ला अगळ ईसु नी गवाय देतो र्‌यो। अने तीहयीत वात केतो र्‌यो जे वात भगवान वगे गेथा केण्‌या माणहु अने मुसो बी केदो के हयवा वाळी से। <verse eid="ACT 26:22" /><verse number="23" style="v" sid="ACT 26:23" /><note caller="+" style="x"><char style="xo" closed="false">26:23 </char><char style="xt" closed="false"><ref loc="1CO 15:20">1 कुरन्‌थी 15:20</ref></char></note>के ईसु मसी ने दुख झेलवा पड़हे अने तीहयोत पेल्‌ना मरला मे गेथो जीवतो हय्‌न अमारा माणहु ने अने आड़जात्‌या माणहु ने जीवाय ना वीजाळा नी खुस-खबर ह़मळावहे।”<verse eid="ACT 26:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ACT 26:24" />जत्‌यार पोलुस आहयी रीती सी जपाप आपतो हतो, ता फेस्‌तुस ज्‌योरेत आड़ीन केदो, पोलुस “तु सणकाय जेलो से! अने तु जादा भणीण गंडवाय जेलो से।”<verse eid="ACT 26:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ACT 26:25" />पोलुस केदो, ए आबरु वाळा फेस्‌तुस, “मे सणकायलो नी हय, पण जे वात मे की र्‌यो तीहयी वात ह़ाचली से अने अक्‌कल नी बी से। <verse eid="ACT 26:25" /><verse number="26" style="v" sid="ACT 26:26" />अने जे वात मे बीह्‌या वगर राजा अगळ केवा बाज र्‌यो, तीहयी वात ने राजा जाणे अने मे भरहो करु के आहयी वातु मे नी कानी बी वात ह़तायली नी हय, काहाके तीहयी घटना खुणा मे नी हयी। <verse eid="ACT 26:26" /><verse number="27" style="v" sid="ACT 26:27" />ए राजा अगरीपा, भगवान वगे गेथी वात केण्‌या माणहु नी केदली वात पोर भरहो करे ह़ु? होव, मने मालम से के तु भरहो करे।”<verse eid="ACT 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 26:28" />आहयी वात ह़मळीन राजा अगरीपा पोलुस ने केदो, “ह़ु तु थोड़ुक ह़मजाड़वा सी मने ईसु मसी वाळो बणाव्‌वा हींड र्‌यो ह़ु?”<verse eid="ACT 26:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="ACT 26:29" />पोलुस जपाप आप्‌यो, “भगवान पांह मारी वीन्‌ती आहयी से के ह़ु थोड़ीक, अने ह़ु जादा, तु एतरोत नी पण जेतरा बी मारी वात ह़मळी र्‌या, तीहया आखा बंदण सी छुटीन मारीन तेवा बण जवा जोवे।”<verse eid="ACT 26:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 26:30" />आहयी वात ह़मळीन राजा अगरीपा अने बीरनीके अने तीनी ह़ाते बह रेला आखा उबा हय ज्‌या। <verse eid="ACT 26:30" /><verse number="31" style="v" sid="ACT 26:31" />अने बारा जता-जता आंबा-सांबा केवा बाज ज्‌या, “आहयो माणेह जेल मे कुंडे एवो अने मोत नो डंड जड़े एवो कंय बी गुनो नी कर्‌यो।” <verse eid="ACT 26:31" /><verse number="32" style="v" sid="ACT 26:32" />राजा अगरीपा फेस्‌तुस ने केदो, “कदीम आहयो आसम नी केतो के ‘केसर राजा अगळ मारो नीयाव हयवा जोवे’ ता आहया हीने जेल मे गेथा बरी कर देता।”<verse eid="ACT 26:32" /></para>
  <chapter eid="ACT 26" />
  <chapter number="27" style="c" sid="ACT 27" />
  <para style="s">पोलुस नु रोम ह़ेर मोकलनु</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 27:1" />जत्‌यार आहयु पक्‌कु हय ज्‌यु के आमु ढुंड्‌यु मे बहीन ईटली जीया, ता तीहया पोलुस ने अने थोड़ाक बीजा केदड़ा ने बी युलीयुस नाम ना अगस्‌तुस ना सीपायड़ा ना टोळा ना डायला मुखी ना हात मे ह़ोप देदा। <verse eid="ACT 27:1" /><verse number="2" style="v" sid="ACT 27:2" />अदरमुतीयुम नु एक ढुंड्‌यु पोर जे आसीया मुलक नी धेड़े ना जागे जवा वाळु हतु, ढुंड्‌यु पोर चड़ीन आमु ढुंड्‌यु ने सोड़ देदा, अने अरीस्‌तरखुस नाम नु मकीदुनीया मुलक ना थीसलुनीकीयो ह़ेर नु माणेह अमारी ह़ाते हतु। <verse eid="ACT 27:2" /><verse number="3" style="v" sid="ACT 27:3" />बीजा दाड़े आमु सेदा ह़ेर मे पुग्‌या, अने तां मोट्‌लु ढुंड्‌यु उबु राख देदा, युलीयुस पोलुस पोर दया कर्‌यो अने तीने दोस्‌तीदार्‌यान्‌तां जवा देदो। के तीनी सेवा-चाकरी करे। <verse eid="ACT 27:3" /><verse number="4" style="v" sid="ACT 27:4" />तां गेथा आमु ढुंड्‌या मे बहीन चाल पड़्‌या, तीहयी टेमे वाहळु अमारी ह़ाम्‌बु आवत्‌लु करीन कुपरुस आडे-आडे हय्‌न ज्‌या। <verse eid="ACT 27:4" /><verse number="5" style="v" sid="ACT 27:5" />एतरे आमु कीलीकीया अने पमफुल्‌या ना धेड़े वाळा दर्‌या माय्‌न लस्‌या मुलक ना मुरा ह़ेर मे उतर्‌या। <verse eid="ACT 27:5" /><verse number="6" style="v" sid="ACT 27:6" />तां सुबेदार ने एक बीजु ढुंड्‌यु देखाव पड़्‌यु। जे सीकंदर्‌या ह़ेर गेथु आवीन ईटली मुलक जवा वाळु हतु। एतरे तीहयो आमने ते ढुंड्‌या मे बहाड़ देदो।<verse eid="ACT 27:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 27:7" />जत्‌यार आमु घणा दाड़ा तक धीरा-धीरा चालीन वेला करता जाय्‌न कनीदुस नी अगळ पुग्‌या, ता आनीन करते के वाहळु आमने अगा जवा नी देतु हतु, आमु सलमोने नी अगळ माय्‌न क्‌रेते ह़ेर नी आडे-आडे चाल्‌या; <verse eid="ACT 27:7" /><verse number="8" style="v" sid="ACT 27:8" />अने तां माय्‌न घणा वेला करता जाय्‌न एक ह़ेर मे पुग्‌या, ते ह़ेर नु नाम हतु ढुंड्‌या उबा राखवा नी वारली ठेसण। तां गेथु लस्‌या ह़ेर ह़ाते हतु।<verse eid="ACT 27:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ACT 27:9" />जत्‌यार घणा दाड़ा वीत ज्‌या, अने ढुंड्‌यु ने चालवा मे खतरो आनीन करते हयतो हतो के तीमना उपाह़ ना दाड़ा बी वीत जेला हता, ता पोलुस तीमने आहयु कीन चेतावणी आप्‌यो। <verse eid="ACT 27:9" /><verse number="10" style="v" sid="ACT 27:10" />“ए मनख्‌या! मने आसम लागे के आञे गेथा आपणु जहु, ता आपणी पोर आफत आय पड़हे अने घणु नुकसान झेलवा पड़हे। अने मोट्‌लु ढुंड्‌यु बी टुट जहे अने कंखर माय्‌न आपणु ने बी मरवा पड़हे।” <verse eid="ACT 27:10" /><verse number="11" style="v" sid="ACT 27:11" />पण ते बी सुबेदार पोलुस नी वात ने सोड़ीन ढुंड्‌यु चलाड़न्‌या पोर अने ढुंड्‌यान मालीक पोर वदु भरहो कर्‌यो। <verse eid="ACT 27:11" /><verse number="12" style="v" sid="ACT 27:12" />ते ठेसण टाड ना दाड़ा काटवा जुगु वारु नी हती करीन वदु माणहु वीच्‌यार करीन केदा, कंय बी करीन हय सके ता फीनीक्‌स मे पुगीन टाड ना दाड़ा काडहु। क्‌रेते ह़ेर नी ठेसण दखणाव-बुडवणी अने धुराव-बुडवणी उगड़तली से।<verse eid="ACT 27:12" /></para>
  <para style="s">दर्‌या मे तोफान</para>
  <para style="p">
    <verse number="13" style="v" sid="ACT 27:13" />जत्‌यार दखवरी गेथी वाहळी आव्‌वा बाज जी, तत्‌यार तीहया आहयु सोच्‌या, के तीमने जे जोय रेलु तीहयु जड़ ज्‌यु, ता तीहया ढुंड्‌या नी मांजरी पाणी मे गेथी हेड़ लेदा, अने क्‌रेते भणी चाल पड़्‌या। <verse eid="ACT 27:13" /><verse number="14" style="v" sid="ACT 27:14" />पण थोड़ीक वार मे तां गेथी घण-जबर आंजी आयी। जे “युरकुलीन” आंजी केवायती हती। <verse eid="ACT 27:14" /><verse number="15" style="v" sid="ACT 27:15" />आंजी ढुंड्‌ये अफठायी ता ढुंड्‌यु वाहळा मे ह़ाम्‌बु जाय नी सक्‌यु, अने आमु ढुंड्‌या ने जंखर जाय तंखोर जवा देदा। <verse eid="ACT 27:15" /><verse number="16" style="v" sid="ACT 27:16" />ता आमु कोदा नाम ना टापु ना आडे वयता-वयता काठी मेहनत करीन नान्‌ला ढुंड्‌या ने हक मे कर्‌या। <verse eid="ACT 27:16" /><verse number="17" style="v" sid="ACT 27:17" />अने मोट्‌ला ढुंड्‌या चलाड़न्‌या ढुंड्‌या ने नाड़्‌ये करीन बांद देदा। अने सुरतीस मे उतळा पाणी मे ढुंड्‌यु टेकवा नी बीक सी पाल सोड़ देदा, अने ढुंड्‌यु ने वयवा देदा। <verse eid="ACT 27:17" /><verse number="18" style="v" sid="ACT 27:18" />आंजी अने झलक मोट्‌ला ढुंड्‌ये घण-जबर अफठायी। ता बीजा दाड़े तीहया ढुंड्‌या मे गेथु ह़मान नाखवा बाज ज्‌या। <verse eid="ACT 27:18" /><verse number="19" style="v" sid="ACT 27:19" />अने तीसरा दाड़े लग तीहया आह़फाम ना हात सी ढुंड्‌या मे वाळु ह़मान बी नाख देदा। <verse eid="ACT 27:19" /><verse number="20" style="v" sid="ACT 27:20" />अने ढेरेत दाड़ा लग, नी दाहड़ु देखायु, अने नी तारा देखाया, अने घण-जबर आंजी चाल री हती, ता आखरी मे आमु बचवा नी आह सोड़ देदा। <figure style="fig" alt="Ship being wrecked in a storm" file="lb00219c.tif" size="col" copy="Horace Knowles ©" ref="27:18">आंजी-तोफान मे ढुंड्‌यु बर्‌बाद हय ज्‌यु</figure><verse eid="ACT 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 27:21" />अने ढेरेत दाड़ा लग तीहया कंय नी खादा, तत्‌यार पोलुस तीमना वच मे उबो हय्‌न केदो, “ए माणहु तमु मारी वात मानीन क्‌रेते गेथा नी आवता ता नी आहयी आफत आवती अने नी नुकसान हयतु। <verse eid="ACT 27:21" /><verse number="22" style="v" sid="ACT 27:22" />पण हाव मे तमने ह़मजाड़ु के हीम्‌मत राखो काहाके तमारी मे गेथा कोय नी मरे, पण मोट्‌ला ढुंड्‌या नु नुकसान हयहे। <verse eid="ACT 27:22" /><verse number="23" style="v" sid="ACT 27:23" />काहाके जे भगवान ह़ाते मे रेलो से, अने जीनी मे सेवा-चाकरी कर्‌यो, तीनो ह़रगदुत काले राते मारीन्‌तां आयो। <verse eid="ACT 27:23" /><verse number="24" style="v" sid="ACT 27:24" />अने केदो, ‘ए पोलुस बीहे ना! तने केसर अगळ उबो हयवात पड़हे अने देख, जे तारी ह़ाते ढुंड्‌या मे से तीमने आखा ने भगवान तारा हात मे ह़ोप देदलो से।’ <verse eid="ACT 27:24" /><verse number="25" style="v" sid="ACT 27:25" />एतरे ए माणहु, हीम्‌मत राखो; काहाके मे भगवान पोर आहयो भरहो करु, के जीसम तीहयो केदलो से तेम हयहे। <verse eid="ACT 27:25" /><verse number="26" style="v" sid="ACT 27:26" />पण आपणु ढुंड्‌यु टापु पोर जाय्‌न टेक जहे।”<verse eid="ACT 27:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ACT 27:27" />जत्‌यार चोवदवी रात आयी ता आमु अद्‌रीया नाम ना दर्‌या मे एथान-एथा भटकता हता, अने अरदीक राते ढुंड्‌यु चलाड़न्‌या ने मालम पड़्‌यु के आमु काना देस धेड़े पुग र्‌या। <verse eid="ACT 27:27" /><verse number="28" style="v" sid="ACT 27:28" />अने तीहया दोड़ु नाखीन दर्‌या नी उंडाय देख्‌या ता मालम पड़्‌यु के वीह़ पुरसाव से, अने अळी थोड़ाक धेड़े ज्‌या ता मालम पड़्‌यु के उंडाय पन्‌दरे पुरसाव से। <verse eid="ACT 27:28" /><verse number="29" style="v" sid="ACT 27:29" />ता दगड़ा वाळी जागा मे अमारु मोट्‌लु ढुंड्‌यु अटकी जहे करीन बीही ज्‌या अने तीहया ढुंड्‌या ना पाछला हीस्‌सा भणी गेथा ढुंड्‌यु उबु राखवा करीन च्‌यारो-मेर मांजरी नाख्‌या, अने ह़वारे हयवा नी वाट जोवता र्‌या। <verse eid="ACT 27:29" /><verse number="30" style="v" sid="ACT 27:30" />एतरे ढुंड्‌यु चलाड़न्‌या ढुंड्‌या मे गेथा नाह जवा नो वीच्‌यार कर र्‌या हता, ता तीहया ढुंड्‌या ना अगला हीस्‌सा भणी मांजरी नाखवा नु बोनु पाड़ीन नान्‌लु ढुंड्‌यु दर्‌या मे उतार लेदा। <verse eid="ACT 27:30" /><verse number="31" style="v" sid="ACT 27:31" />ता पोलुस सुबेदार अने सीपायड़ा ने केदो; “कदीम आहया ढुंड्‌यु पोर नी रेय ता तमु बी नी बचो।” <verse eid="ACT 27:31" /><verse number="32" style="v" sid="ACT 27:32" />ता सीपायड़ा नाड़ा तोड़ीन नान्‌ला ढुंड्‌या हेटा दर्‌या मे उतार देदा।<verse eid="ACT 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="ACT 27:33" />जत्‌यार ह़वारे हयवा वाळु हतु ता पोलुस आखा ने आहयु कीन खावा करीन ह़मजाड़्‌यो के “बचवा नी आह करते-करते चोवदे दाड़ा हय ज्‌या अने तमु भुकलात र्‌या, अने जरीक बी खाणु नी खादा। <verse eid="ACT 27:33" /><verse number="34" style="v" sid="ACT 27:34" />मे तमने आनीन करते ह़मजाड़ु; के कंय खाय लेवो जीनी सी तमारो बचावो हये; काहाके तमारी गेथा काना ना मुंडा नो एक बी नीम्‌बाळो नी पड़े।” <verse eid="ACT 27:34" /><verse number="35" style="v" sid="ACT 27:35" />अने आहयु कीन पोलुस रोट्‌लो हात मे लेदो, अने आखा अगळ रोट्‌ला जुगु भगवान ने तु घणो वारु से केदो अने रोट्‌लो भागीन खावा बाज ज्‌यो। <verse eid="ACT 27:35" /><verse number="36" style="v" sid="ACT 27:36" />ता आखा बीजा बी हीम्‌मत राखीन खाणु खावा बाज ज्‌या। <verse eid="ACT 27:36" /><verse number="37" style="v" sid="ACT 27:37" />आमु ढुंड्‌या मे आखा मेळीन बे ह़ो छीयोत्‌तर जणा हता। <verse eid="ACT 27:37" /><verse number="38" style="v" sid="ACT 27:38" />तीहया खायलीन आफरी ज्‌या अने ढुंड्‌यु ने फोवरु करवा करीन गम ने दर्‌या मे नाखवा बाज ज्‌या।<verse eid="ACT 27:38" /></para>
  <para style="s">ढुंड्‌यु नु टुटणु</para>
  <para style="p">
    <verse number="39" style="v" sid="ACT 27:39" />जत्‌यार ह़वारे हयु ता तीहया ते देस ने ओळख्‌या नी, पण एक खाय देख्‌या तीनी च्‌यारो-मेर बराबर धेकड़ हती तीहया वीच्‌यार कर्‌या के हय सके ता आञे ढुंड्‌यु ने उबु राख देता। <verse eid="ACT 27:39" /><verse number="40" style="v" sid="ACT 27:40" />ता तीहया मांजरी ने दर्‌या मे नाख देदा, अने बरसादी बांदला नाड़ा सोड़ देदा, अने जंय गेथी वाहळी आवे तींखर बरसादी बांदीन धेड़े चाल पड़्‌या। <verse eid="ACT 27:40" /><verse number="41" style="v" sid="ACT 27:41" />तीहया दर्‌या भेसकायवा ना जागा पोर मोट्‌लु ढुंड्‌यु उबु राख देदा, अने ढुंड्‌या नो अगलो हीस्‌सो राबड़ा मे गड़ाय ज्‌यो, अने पासलो हीस्‌सो लेहर ठोकाय-ठोकाय्‌न भागवा बाज ज्‌यो।<verse eid="ACT 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="ACT 27:42" />ता सीपायड़ा वीच्‌यार काड्‌या, के केदी माणहु ने मार नाख्‌ता; कदीम आसम नी हय जाय के तीहया तीरीन बारा नीकळीन नाह जाय। <verse eid="ACT 27:42" /><verse number="43" style="v" sid="ACT 27:43" />पण सुबेदार पोलुस ने बचाड़वा करीन तीमने आहया वीच्‌यार सी रोक्‌यो, अने केदो जीने तीरते अवड़ी जाय, तीहया तीरीन दर्‌या धेड़े जत रेवो। <verse eid="ACT 27:43" /><verse number="44" style="v" sid="ACT 27:44" />अने जीने तीरते नी अवड़े तीहया ढुंड्‌या ना पाट्‌या पोर बहीन जत रेवो। अने आसम करीन आखान-आखा दर्‌या धेड़े जत र्‌या।<verse eid="ACT 27:44" /></para>
  <chapter eid="ACT 27" />
  <chapter number="28" style="c" sid="ACT 28" />
  <para style="s">मालटा ह़ेर मे पोलुस</para>
  <para style="p">
    <verse number="1" style="v" sid="ACT 28:1" />जत्‌यार आमु बचीन दर्‌या धेड़े एक टापु मे पुग ज्‌या, ता मालम पड़्‌यु के आहयु टापु ने मालटा केय। <verse eid="ACT 28:1" /><verse number="2" style="v" sid="ACT 28:2" />अने तां वाळा माणहु अमारी पोर गीण कर्‌या; पाणी पड़वा बाज र्‌यो हतो अने टाडु बी लागवा बाज र्‌यु हतु, एतरे तीहया आक्‌ठु धपाड़्‌या, अने रेवा नो आसरो आप्‌या। <verse eid="ACT 28:2" /><verse number="3" style="v" sid="ACT 28:3" />जत्‌यार पोलुस लाकड़ा भेळा करीन आक्‌ठा मे मेल्‌यो, ता आक्‌ठा नी आच लागवा सी एक गड़हो नीकळ्‌यो, अने पोलुस ना हाते वळगी ज्‌यो। <verse eid="ACT 28:3" /><verse number="4" style="v" sid="ACT 28:4" />जत्‌यार तां वाळा माणहु गहड़ा ने हाते वळगी रेलो देख्‌या, ता आह़फा-आह़फात केदा, “ह़ाचलीन आहयो हत्‌यारो माणेह से, भले आहयो दर्‌या मे गेथो बच ज्‌यो, पण ते बी नीयाव आने नी जीव्‌वा देदो।” <verse eid="ACT 28:4" /><verse number="5" style="v" sid="ACT 28:5" />तत्‌यार पोलुस आह़फोत हात झीझड़ीन गहड़ा ने आक्‌ठा मे पाड़ देदो, अने पोलुस ने कंय बी नुकसान नी हयु। <verse eid="ACT 28:5" /><verse number="6" style="v" sid="ACT 28:6" />पण तीहया वाट जोवतात र्‌या के पोलुस नो हात ह़ुजी आवहे, नीता हीय्‌यो पड़ जहे अने मर जहे, पण तीहया वाट जोवी-जोवीन थाक ज्‌या, पण ईनु कंय बी नी नुकसान नी हयु, ता तीमना मन मे बीजोत वीच्‌यार आयो अने तीहया केदा, “आहयो ते कानो देवता से।”<verse eid="ACT 28:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ACT 28:7" />जां आमु जेला तां दर्‌या धेड़े पुबलीयुस नाम ना माणहे नी जागा हती, तीहयो ते मालटा टापु नो डायलो हतो; तीहयो आमने तीना घोर ली जाय्‌न तीन दाड़ा लग पोरणा कर्‌यो। <verse eid="ACT 28:7" /><verse number="8" style="v" sid="ACT 28:8" />ते पुबलीयुस ना बाह ने घण जादा ताव चड़ रेलो, अने तीहयो गोदड़ा मे पड़ र्‌यो हतो, पोलुस तीनीन्‌तां जाय्‌न तीनी वाटु भगवान सी वीन्‌ती कर्‌यो, अने ते टापु ना डायला ना बाह पोर हात मेक्‌यो अने तीहयो आरगो हय ज्‌यो <verse eid="ACT 28:8" /><verse number="9" style="v" sid="ACT 28:9" />जत्‌यार आसम हयु, तत्‌यार ते टापु मे रेण्‌या माणहु बी आया; अने तां आवीन आरगा हय ज्‌या। <verse eid="ACT 28:9" /><verse number="10" style="v" sid="ACT 28:10" />अने तीहया अमारो घण-जबर आव-भाव कर्‌या, अने आमु जवा बाज ज्‌या ता तीहया आमने जे बी जोवतु हतु तीहयु ढुंड्‌या मे मेळ देदा।<verse eid="ACT 28:10" /></para>
  <para style="s">पोलुस नु रोम ह़ेर मे जाणु</para>
  <para style="p">
    <verse number="11" style="v" sid="ACT 28:11" />तीन मयनान बाद आमु सीकंदर्‌या गेथा ढुंड्‌या मे बहीन चाल पड़्‌या। ते ढुंड्‌यु टाड ना दाड़ा मे तांत रेलु हतु; अने जीनी पोर जोवळ्‌या सोरा नी सेलाणी हती। <verse eid="ACT 28:11" /><verse number="12" style="v" sid="ACT 28:12" />अळतेण आमु सुरकुसा मे ज्‌या, अने तां आमु तीन दाड़ा र्‌या। <verse eid="ACT 28:12" /><verse number="13" style="v" sid="ACT 28:13" />तां गेथा आमु रेगीयुम मे ज्‌या: अने बीजा दाड़े दखणाव गेथु वाहळु आव्‌वा बाज ज्‌यु, एतरे आमु बीजा दाड़े पुतीयुली मे जत र्‌या। <verse eid="ACT 28:13" /><verse number="14" style="v" sid="ACT 28:14" />तां आमने थोड़ाक भरहो करन्‌या भायु भेट्‌या, अने तीहया घणा रावण्‌या कर्‌या करीन आमु तीमनीन्‌तां ह़ात दाड़ा र्‌या; अने आसम करीन तां गेथा रोम ह़ेर भणी चाल पड़्‌या। <verse eid="ACT 28:14" /><verse number="15" style="v" sid="ACT 28:15" />अळतेण तां भरहो करन्‌या भायु ने मालम पड़्‌यु के आमु आव्‌वा बाज र्‌या, ता तीहया आमने भेटवा करीन अपीयुस ना चोवराया लग अने तीन धरमसाहळान तां लग आया, तीमने देखीन पोलुस भगवान ने तु घणो वारु से केदो, अने आह़फो हीम्‌मत कर्‌यो।<verse eid="ACT 28:15" /></para>
  <para style="s">रोम ह़ेर मे पोलुस</para>
  <para style="p">
    <verse number="16" style="v" sid="ACT 28:16" />जत्‌यार आमु रोम ह़ेर मे पुग्‌या, ता पोलुस ने एक सीपायड़ु नी ह़ाते जे तीनी रखवाळी करतो हतो, आंग्‌ये रेवा नो हुकम जड़ ज्‌यो। <figure style="fig" alt="Street scene of The Roman city" file="hk00242c.tif" size="span" copy="Horace Knowles ©" ref="28:16">रोम ह़ेर नी ह़ड़क नो देखावो</figure><verse eid="ACT 28:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ACT 28:17" />तीन दाड़ा हय ज्‌या अने अळतेण पोलुस तां वाळा युहदी माणहु ना डायला पुडारी ने बोलायो, अने जत्‌यार तीहया भेळा हय ज्‌या ता तीहयो तीमने केदो, “ए भायु, मे आपणा माणहु ना अने आपणा डाह-डाहान वीरोद मे कंय बी नी केदो, ते बी मने यरुसलेम गेथा धरावीन रोमी सीपायड़ा ना हात मे ह़ोप देदा। <verse eid="ACT 28:17" /><verse number="18" style="v" sid="ACT 28:18" />तीहया मारी पारख करीन सोड़ देवा हींडता हता काहाके मे मोत नो डंड जड़े ईसम कंय बी गुनो नी कर्‌यो। <verse eid="ACT 28:18" /><verse number="19" style="v" sid="ACT 28:19" /><note caller="+" style="x"><char style="xo" closed="false">28:19 </char><char style="xt" closed="false"><ref loc="ACT 25:11">नेवताळा ना काम 25:11</ref></char></note>पण जत्‌यार युहदी माणहु मारा वीरोद मे केवा बाज ज्‌या, ता केसर राजा सी मारा बारा मे वीच्‌यार करवा करीन रावण्‌या करवा पड़्‌यु: आनीन करते नी के मे मारा माणहु पोर गुनो लगाड़ु। <verse eid="ACT 28:19" /><verse number="20" style="v" sid="ACT 28:20" />अने मे तमने आनीन करते बोलायो, के तमारी सी भेटु अने वात करु; काहाके मे ईस्‌रायली माणहु नी आह जुगु ह़ाकळ्‌या मे बंदाय र्‌यो।”<verse eid="ACT 28:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ACT 28:21" />आहयु ह़मळीन तीहया केदा, “नी ते आमने तारा बारा मे युहदी माणहु पांह गेथी चीट्‌ठी जड़ी, अने नी ते युहदी भायु मे ना कोय आवीन तारा बारा मे केदा, अने नी ते बुरु-भलु केदा। <verse eid="ACT 28:21" /><verse number="22" style="v" sid="ACT 28:22" />पण तारो ह़ु वीच्‌यार से, तीहयो आमु ह़मळवा हींड र्‌या, काहाके आमने मालम से के आखी दुर आहया पंथ ना वीरोद मे माणहु वात करवा बाज र्‌या।”<verse eid="ACT 28:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ACT 28:23" />तत्‌यार तीहया माणहु एक दाड़ो नक्‌खी कर्‌या, अने तीहया दाड़े ढेरेत माणहु पोलुस ने तां भेळा हया, अने पोलुस तीमने ईसु ना बारा मे मुसा ना लारे लीखली सास्‌तर मे गेथु अने भगवान वगे गेथा वात करन्‌या माणहु नी लीखली सास्‌तर मे गेथु ह़वारे गेथो ह़ांतो लग ह़मजाड़तो र्‌यो अने भगवान ना राज ना बारा मे गवा देतो र्‌यो। <verse eid="ACT 28:23" /><verse number="24" style="v" sid="ACT 28:24" />ता थोड़ाक तीहयी वात ने मान लेदा, अने थोड़ाक भरहो नी कर्‌या। <verse eid="ACT 28:24" /><verse number="25" style="v" sid="ACT 28:25" />जत्‌यार तीहया एक-मन्‌या नी हया, ता पोलुस तीमने केदो, चोखली आत्‌मा भगवान वगे गेथी वात केण्‌या माणेह यसाया ना लारे तमारा डाह-डाहा ने आहयु केदली हती,<verse eid="ACT 28:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ACT 28:26" />जाय्‌न आहया माणहु ने कीदे,</para>
  <para style="q1" vid="ACT 28:26">तमु ह़मळह़ु, पण ह़मज मे नी आवे,</para>
  <para style="q2" vid="ACT 28:26">अने तमु देखहु, पण तमने देखाय नी।<verse eid="ACT 28:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ACT 28:27" />काहाके आहया माणहु नु मन काठु,</para>
  <para style="q2" vid="ACT 28:27">अने तीहया मन बेरा हय जेला से,</para>
  <para style="q2" vid="ACT 28:27">अने आहया डोळा मीच लेदला से,</para>
  <para style="q1" vid="ACT 28:27">आसम नी हय जाय के तीहया कदी डोळा सी देखे,</para>
  <para style="q2" vid="ACT 28:27">अने कान्‌टा सी ह़मळे, अने मन सी ह़मजे,</para>
  <para style="q2" vid="ACT 28:27">अने फीरे, अने मे तीमने आरगा करु।<verse eid="ACT 28:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ACT 28:28" />एतरे “तमु जाण लेवो के भगवान नी छुटकारा नी आहयी खुस-खबर आड़जात्‌या मे ह़मळावा करीन मोकली र्‌यो, तीहया ध्‌यान सी आहयी खुस-खबर ने ह़मळहे।” <verse eid="ACT 28:28" /><verse number="29" style="v" sid="ACT 28:29" />पोलुस आहयी वात की देदो, अने अळतेण युहदी माणहु वात मे जखड़ी पड़ ज्‌या, अने तीनीन्‌तां गेथा जत र्‌या।<verse eid="ACT 28:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ACT 28:30" />अने पोलुस रोम ह़ेर मे बे साल लग कीराया ना घोर मे र्‌यो। <verse eid="ACT 28:30" /><verse number="31" style="v" sid="ACT 28:31" />अने जे तीनीन्‌तां आवत्‌ला तीमने आखा ने भेट्‌यो अने बीना धाक सी अने बीना रोक-टोक सी भगवान ना राज नो परच्‌यार कर्‌यो, अने मालीक ईसु मसी नी वात ह़ीकाड़तो र्‌यो।<verse eid="ACT 28:31" /></para>
  <chapter eid="ACT 28" />
</usx>