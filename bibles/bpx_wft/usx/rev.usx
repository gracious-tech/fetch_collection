<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="REV" style="id">- Paliya</book>
  <para style="h">परकासीतवाक्‌य</para>
  <para style="toc3">परकासीतवाक्‌य</para>
  <para style="toc2">परकासीतवाक्‌य</para>
  <para style="toc1">युहन्‌ना नी लारे लीखली परकासीतवाक्‌य नी कीताप</para>
  <para style="mt2">युहन्‌ना के द्वारा लीखी प्रकाशितवाक्‌य की पुस्तक</para>
  <para style="mt1">युहन्‌ना नी लारे लीखली परकासीतवाक्‌य नी कीताप</para>
  <para style="imt">जानकारी</para>
  <para style="ip">परकासीतवाक्‌य नी आहयी कीताप नवला नेम नी आखरी कीताप से। अने आहयी आखरी मे लीखली से नेवताळो युहन्‌ना ईसु मसी ना पयदा हयवान बाद 95 साल ना आड़े-धेड़े लीखली से। <char style="xt"><ref loc="REV 1:1">1:1</ref></char> अने तीहयात युहन्‌ना नी लारे लीखली खुस-खबर अने युहन्‌ना नी 1 2 3 चीट्‌ठी लीख्‌यो आहया युहन्‌ना ने माणहु “ईसु जीनी सी मोंग करतो हतो” ईसम मानीन ओळखता हता। <char style="xt"><ref loc="JHN 13:23">युहन्‌ना 13:23</ref></char> ईसु मसी नी खुस-खबर ना कारण सी पतमुस नाम ना टापु पोर जत्‌यार सजा भुकती र्‌यो हतो तत्‌यार आहयी कीताप लीख्‌यो <char style="xt"><ref loc="REV 1:9">1:9</ref></char>।</para>
  <para style="ip">आहयी कीताप लीखवा नो युहन्‌ना नो मकसत आहयो हतो के मारा भणवा वाळा ने ईसु मसी ह़ाते भरहा मे रेवा करीन हीम्‌मत आपे अने ईसु नु अळी पासु आव्‌वा नु ह़ाते से। एतरे तीनी मे आह उपजाड़वा नी लेदे <char style="xt"><ref loc="REV 1:3-22:7">1:3–22:7</ref></char>। आहयी चीट्‌ठी आखा भरहो करन्‌या ने लीखी पण खास करीन तीहयी ह़ात मंडळी ने लीख्‌यो जीना बारा मे लीखलु <char style="xt"><ref loc="REV 2-3">2–3</ref></char> मे से। युहन्‌नो आह़फा नी लीखावट ने भगवान वगे गेथी आवली खबर से ईसम देखाड़े। अने जे वातु ने तीहयो खुद देख्‌यो तीहयी वातु ना बारा मे तीहयो ह़ींगारली भासा मे लीखे। आहयी जे कीताप से पुराणा नेम ना थोड़ाक वाटा सी मेळ खाय खास करीन <char style="xt"><ref loc="ZEC 6:1-8">जकर्‌याह 6:1-8</ref></char> बोल ह़रको से, तेमेत ह़ात फेपार्‌या अने ह़ात कटोरा भगवान मीस्‌र देस पोर दुख ना रुप मे मोकल्‌लो से। <char style="xt"><ref loc="EXO 7-9">नीरगमन 7–9</ref></char> परकासीतवाक्‌य आखरी दाड़ा ना बारा मे देखाड़े, तीहया आसम केय के आखरी दाड़ा मे ईसु कीकम जीकहे अने तीनी पोर भरहो करन्‌या तीनी ह़ाते अमरकाय जीवाय जीवहे ईसम केय। आहयी कीताप नी लारे तमने चेतावणी जड़े, अने ईसु ना पासो आव्‌वा ना बारा मे तमने आह जड़हे।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. सुरुवात मे युहन्‌नो आह़फा नी ओळखाण करीन तीने भगवान वगे गेथी वात कीसम जड़ी देखाड़ीन सुरुवात करे। <char style="ior"><ref loc="REV 1:1-20">1:1-20</ref></char></para>
  <para style="io1">2. ईसु भणी गेथो ह़ात मंडळी ने युहन्‌नो खबर ह़मळावे। <char style="ior"><ref loc="REV 1:1-3:22">1:1–3:22</ref></char></para>
  <para style="io1">3. अने तीहयो ह़ात सीक्‌का ना बारा मे देखाड़े। <char style="ior"><ref loc="REV 4:1-8:5">4:1–8:5</ref></char> अने ह़ात फेपार्‌या ना बारा मे देखाड़े। <char style="ior"><ref loc="REV 8:6-11:19">8:6–11:19</ref></char></para>
  <para style="io1">4. अळतेण युहन्‌नो एक नान्‌लु सोरु ह़ात मुंडा वाळा गड़हा ह़ाते कीसम झुमाये तीहयु देखाड़े। <char style="ior"><ref loc="REV 12:1-14:20">12:1–14:20</ref></char></para>
  <para style="io1">5. आनी बाद युहन्‌नो ह़ात रीह ना कटोरा ना बारा मे लीखे। <char style="ior"><ref loc="REV 15:1-16:18">15:1–16:18</ref></char></para>
  <para style="io1">6. अळतेण भगवान तीना ह़रगे वाळा वेरी सी कीसम जीके तीहयु देखाड़े। <char style="ior"><ref loc="REV 17:1-20:15">17:1–20:15</ref></char></para>
  <para style="io1">7. जे नवली धरती अने नवलु ह़रग आखरी मे आव्‌वा वाळु से तीना बारा मे लीखलो से। <char style="ior"><ref loc="REV 21:1-22:21">21:1–22:21</ref></char></para>
  <chapter number="1" style="c" sid="REV 1" />
  <para style="p">
    <verse number="1" style="v" sid="REV 1:1" />ईसु मसी नु वीजाळु, जे तीने भगवान आनीन करते आप्‌यो के तीहयो आह़फा ना चाकर्‌या ने तीहयी वात जे छोटी हयवात वाळी से, देखाड़े; अने तीहयो आह़फा ना ह़रगदुत ने मोकलीन तीनी लारे आह़फा ना चाकर्‌या युहन्‌ना ने देखाड़्‌यो। <verse eid="REV 1:1" /><verse number="2" style="v" sid="REV 1:2" />युहन्‌नो जे भगवान ना बोलु अने ईसु मसी नी गवाय, मतलब जे कंय तीहयो देखलो हतो तीनी गवाय देदो। <verse eid="REV 1:2" /><verse number="3" style="v" sid="REV 1:3" />जुगाळा से तीहया जे आहयी कीताप ने भणे, अने जुगाळा से तीहया जे भगवान वगे गेथी केदली वात नी खबर ने ह़मळे; अने जे लीखलु से तीनी अनसारे चाले। काहाके आहयी आखी वात हयवा वाळी टेम ह़ाते आय लागली से।<verse eid="REV 1:3" /></para>
  <para style="s">ह़ात मंडळी नो आव-भाव</para>
  <para style="p">
    <verse number="4" style="v" sid="REV 1:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:4 </char>
      <char style="xt" closed="false">
        <ref loc="REV 4:5">परकासीतवाक्‌य 4:5</ref>
      </char>
    </note>युहन्‌नान्‌तां गेथी तीहयी ह़ात मंडळी ना नामे जे आसीया देस मे से:</para>
  <para style="p" vid="REV 1:4">तीहया भगवान ने तां गेथी बरकत अने सांती हये, जे से, अने जे हतो, अने जे आव्‌वा वाळो से; अने तीहयी ह़ात आत्‌मान्‌तां गेथी जे तीनी राजगादी अगळ से।<verse eid="REV 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 1:5" />अने ईसु मसीन तां गेथी जे भरहो करे एवी गवाय से अने मरला मे गेथो आखा सी पेल जीवतो हय्‌न उठवा वाळो से अने धरती पोर ना राजा नो डायलो से। तमने दया अने सांती जड़ती रेय। तीहयो आपणी ह़ाते मोंग करे, अने तीहयो आह़फा ना लोय नी लारे आपणु ने पापु मे गेथा सोड़ावलो से, <verse eid="REV 1:5" /><verse number="6" style="v" sid="REV 1:6" /><note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="REV 5:10">परकासीतवाक्‌य 5:10</ref></char></note>अने आपणु ने एक राज अने आपणा बाह भगवान जुगु पुंजारा बी बणाय देदलो से; ईसु मसी नो बड़ाय अने राज जलमकु रेय। आमीन।<verse eid="REV 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 1:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">मत्‌ती 24:30</ref>; <ref loc="MRK 13:26">मरकुस 13:26</ref>; <ref loc="LUK 21:27">लुका 21:27</ref>; <ref loc="1TH 4:17">1 थीसलुनीकीयो 4:17</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="JHN 19:34">युहन्‌ना 19:34</ref>,<ref loc="JHN 19:37">37</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:30">मत्‌ती 24:30</ref>
      </char>
    </note>देखो, तीहयो वादळा भेळ आव्‌वा बाज र्‌यो, अने एक-एक ना डोळा तीने देखहे, अने तीहया बी देखहे जे तीने खुटा ठोकला हता, अने धरती पोर वाळा आखा तीना कारण सी छाती ठोकहे। होव। आमीन।<verse eid="REV 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 1:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:8 </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:13">परकासीतवाक्‌य 22:13</ref>
      </char>
    </note>मालीक भगवान, जे से अने जे हतो अने जे आव्‌वा वाळो से, जे ताखत वाळो से, आहयु केय, “मेत अल्‌फा अने ओमेगा से।”<verse eid="REV 1:8" /></para>
  <para style="s">मसी नो दरसन</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 1:9" />मे युहन्‌नो, जे तमारो भाय अने ईसु मसी ना दुख, अने राज अने गम खावा मे तमारो साजल्‌यो से, भगवान ना बोलु अने ईसु मसी नी गवाय ना कारण सी दर्‌या नी वच मे वाळा पतमुस नाम ना टापु मे हतो। <verse eid="REV 1:9" /><verse number="10" style="v" sid="REV 1:10" />मे मालीक ना दाड़े आत्‌मा मे भराय ज्‌यो, अने मारी पसळ फेपार्‌यान तेवो बोल आहयु केतले ह़मळ्‌यो, <verse eid="REV 1:10" /><verse number="11" style="v" sid="REV 1:11" />“जे कंय तु देखे तीने एक कीताप मे लीख ले अने आहयी कीताप ने ह़ातोव ह़ेर नी मंडळी मे ली मोकल, मतलब. ईफीसुस, स्‌मुरना, पीरगमुन, थुवातीरा, सरदीस, फीलदीलफीया, अने लोदीकीया ने।” <figure style="fig" alt="Map of seven churches in Asia" file="hk00378c.tif" size="span" copy="Horace Knowles ©" ref="1:11">आसीया नी ह़ात मंडळी नो नक्‌सो </figure><verse eid="REV 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 1:12" />ता मे तीने, जे मने केवा बाज र्‌यु हतु, देखवा करीन मारु मोडु फीरव्‌यो; अने पासो फीरीन मे ह़ोना ना ह़ात दीवा मेलवा ना खुटा देख्‌यो, <verse eid="REV 1:12" /><verse number="13" style="v" sid="REV 1:13" />अने तीहया दीवा मेलवा ना खुटा नी वच मे एक माणेह ना सोरा ह़रकु एक माणेह ने देख्‌यो, जे पोग मे तक नाम्‌ला लुगड़ा पेरीन, अने छाती पोर ह़ोना नो पट्‌टो बांदीन हतु। <verse eid="REV 1:13" /><verse number="14" style="v" sid="REV 1:14" />तीनु मोडु अने नीम्‌बाळा हीर ने तेवा धोळ्‌ळा बरप ने तेवा उजळा, अने डोळा आक्‌ठु नी आच ने तेवा हता। <verse eid="REV 1:14" /><verse number="15" style="v" sid="REV 1:15" />तीना पोगु वारलु पीतळ ने तेवा हता, जे मानो भाटी मे हहळाया हय; अने तीनु मोडु बोपरी वळे नु दाहड़ु ह़रकु हतु, अने तीनो बोल घणु पाणी नी अवाज ने तेवो हतो। <verse eid="REV 1:15" /><verse number="16" style="v" sid="REV 1:16" />तीहयो आह़फा ना जामण्‌या हात मे ह़ात तारा ली रेतो हतो। अने तीना मोडु मे गेथी बे धार वाळी तलवार नीकळ री हती। अने तीनो मुख बोपरी वळे नु दाहड़ुन तेम पपलतो हतो। <verse eid="REV 1:16" /><verse number="17" style="v" sid="REV 1:17" /><note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="REV 2:8">परकासीतवाक्‌य 2:8</ref>; <ref loc="REV 22:13">22:13</ref></char></note>तीने देखीन मे तीना पोगु मे मरलान तेम पड़ ज्‌यो। तीहयो आह़फा नो जमण्‌यो हात मारी पोर मेकीन केदो: “बीहे ना. पेल्‌नो अने आखरी मेत से। <verse eid="REV 1:17" /><verse number="18" style="v" sid="REV 1:18" />अने जीवत्‌लो मेत से; मे मर जेलो हतो पण देखो, हाव मे जलम जीवत्‌लो से। मोत पोर अने मोत नी दुनीया पोर मारो हक से। <verse eid="REV 1:18" /><verse number="19" style="v" sid="REV 1:19" />करीन जे वात तु देखलो से अने जे वात हयवा बाज री अने जे वात आनी पसळ हयवा वाळी से, तीहयी आखी वात ने लीख ले। <verse eid="REV 1:19" /><verse number="20" style="v" sid="REV 1:20" />आहया ह़ात तारा नु, जे तु मारा जमणा हात मे देख र्‌यो, अने ह़ात ह़ोना ना दीवा मेलवा ना खुटा नु मतलब आहयु से: आहया ह़ात तारा ह़ात मंडळीन तां मोकल्‌ला दुत अने ह़ात दीवा मेलवा ना खुटा ह़ात मंडळी से।”<verse eid="REV 1:20" /></para>
  <chapter eid="REV 1" />
  <chapter number="2" style="c" sid="REV 2" />
  <para style="s">ईफीसुस ने खबर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 2:1" />ईफीसुस नी मंडळी ना दुत ने आहयु लीख: “जे ह़ातोव तारा आह़फा ना जमणा हात मे ली र्‌यो, अने ह़ोना ना ह़ात दीवलाय नी वच मे फीरे, तीहयो आहयु केय के: <verse eid="REV 2:1" /><verse number="2" style="v" sid="REV 2:2" />जे तु कर्‌यो, अने तारी मेहनत ना काम ने, अने तारा गम ने जाणु; अने आहयु बी के तु कुहर्‌या माणहु ने देख नी सके, अने जे आह़फा ने चेला केय, अने तीहया नी हय, तीमने तु पारखीन झुटा देख्‌यो। <verse eid="REV 2:2" /><verse number="3" style="v" sid="REV 2:3" />तु गम खाय, अने मारा नाम नी करते दुख झेल्‌यो, ते बी तु नी थाक्‌यो। <verse eid="REV 2:3" /><verse number="4" style="v" sid="REV 2:4" />पण मने तारा वीरोद मे आहयु केणु से के तु पेलो जे मोंग करतो हतो तीने तु सोड़ देदलो से। <verse eid="REV 2:4" /><verse number="5" style="v" sid="REV 2:5" />करीन तु फोम कर के तु केतरो उचे गेथो पड़ जेलो से! अने पापु सी मन फीरव अने पेलेन तेम काम कर। कदीम तु पापु सी मन नी फीरावे, ता मे तारीन्‌तां आवीन तारा दीवा मेलवा ना खुटा ने तीना जागा पोर गेथो सेटो कर देही। <verse eid="REV 2:5" /><verse number="6" style="v" sid="REV 2:6" />पण होव, तारी मे आहयी वात ते से के तु नीकुलीयो ना कामु सी ह़ीगी करे, जीनी सी मे बी ह़ीगी करु।”<verse eid="REV 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 2:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:7 </char>
      <char style="xt" closed="false">
        <ref loc="REV 22:2">परकासीतवाक्‌य 22:2</ref>
      </char>
    </note>“जीना कान्‌टा हय तीहया ह़मळ लेय, के आत्‌मा मंडळी ने ह़ु केय, जे जीकहे, मे तीने तीहया जीवाय ना झाड़ मे गेथो जे भगवान ना बगीचा मे से, फोळ खावा देही।”<verse eid="REV 2:7" /></para>
  <para style="s">स्‌मुरना ने खबर</para>
  <para style="p">
    <verse number="8" style="v" sid="REV 2:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:8 </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:17">परकासीतवाक्‌य 1:17</ref>; <ref loc="REV 22:13">22:13</ref></char>
    </note>“स्‌मुरना नी मंडळी ना दुत ने आहयु लीख: ‘जे पेल्‌नो अने आखरी से जे मर जेलो अने हाव पासो जीवतो हय जेलो से, तीहयो आहयु केय के।’ <verse eid="REV 2:8" /><verse number="9" style="v" sid="REV 2:9" />मे तारा दुख अने गरबाय ने जाणु पण तु पामतो से, अने जे माणहु आह़फाम ने युहदी केय पण हय नी, अने तारा वीरोद मे तीहया जे गलत वात केय तीने मे जाणु। तीहया भुतड़ा नो टोळो से। <verse eid="REV 2:9" /><verse number="10" style="v" sid="REV 2:10" />जे दुख तने झेलवा पड़हे, तीनी सी ना बीहे। काहाके देखो, भुतड़ो तमारी माय्‌न थोड़ाक ने जेल मे कुंडवा वाळो से के तमने पारखे; अने तमने दह दाड़ा लग दुख झेलवा पड़हे। जीव आपते लग भरहो करन्‌यो रे, ता मे तने तारा जीक नु ईलाम जीवाय आपही।”<verse eid="REV 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 2:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:11 </char>
      <char style="xt" closed="false">
        <ref loc="REV 20:14">परकासीतवाक्‌य 20:14</ref>; <ref loc="REV 21:8">21:8</ref></char>
    </note>“जीना कान्‌टा हय, तीहयो ह़मळी लेय के आत्‌मा मंडळी ने ह़ु केय, ‘जे जीकलो से’ तीने बीजी मोत सी कंय बी नुकसान नी हये।”<verse eid="REV 2:11" /></para>
  <para style="s">पीरगमुन नी मंडळी ना लेदे खबर</para>
  <para style="p">
    <verse number="12" style="v" sid="REV 2:12" />“पीरगमुन नी मंडळी ना दुत ने आहयु लीख: ‘जीनी पांह बे धार्‌याण अने वेताळी तलवार से, तीहयो आहयु केय के’ <verse eid="REV 2:12" /><verse number="13" style="v" sid="REV 2:13" />मे आहयु जाणु के तु तां रेय, जां ह़ारीक भुतड़ा नी राजगादी से। तु मारी ह़ाते खरलो से, अने मारी पोर भरहो करवा मे तीहया दाड़ा मे बी नी पासो पड़्‌यो जे दाड़ा मे मारा भरहा नी लायक गवा अंतीपास ने तमारा ह़ेर मे मार नाखला, जां ह़ारीक भुतड़ो रेय। <verse eid="REV 2:13" /><verse number="14" style="v" sid="REV 2:14" />पण तमारी वच मे थोड़ाक माणहु एवा से जे बीलाम नी ह़ीकापण माने, जे बालाक राजा ने ह़ीकाड़्‌या के ईस्‌रायली जाती ना माणहु ने मुरत्‌या पोर चड़ावलु खाणु खावा अने छीनाळु करवा नी लारे तीमने पाप मे पाड़वा करीन अगवाय करे। <verse eid="REV 2:14" /><verse number="15" style="v" sid="REV 2:15" />तेवात तारीन्‌तां थोड़ाक माणहु से, जे नीकुलीयो नी ह़ीकापण माने।” <verse eid="REV 2:15" /><verse number="16" style="v" sid="REV 2:16" />हाव पापु सी मन फीराव, नीता मे तारीन्‌तां छोटोत आवीन तमारा वीरोद मे मारा मोडा नी तलवार सी झुमायही।<verse eid="REV 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 2:17" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:17 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:48-50">युहन्‌ना 6:48-50</ref>
      </char>
    </note>जीना कान्‌टा हय, तीहयो ह़मळी लेय के आत्‌मा मंडळी ने ह़ु केय। जे जीक जाय, तीहया माणेह ने मे कंय ह़तायला मन्‌ना आपही। अने तीमनी माय्‌न एक-एक ने धोळ्‌ळो दगड़ो बी आपही, अने तीहया दगड़ा पोर एक नवलु नाम लीखलु रेहे, तीने नीस्‌तो लेवा वाळोत जाणहे।<verse eid="REV 2:17" /></para>
  <para style="s">थुवातीरा नी मंडळी ने खबर</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 2:18" />“थुवातीरा नी मंडळी ना दुत ने आहयु लीख: ‘भगवान नो सोरो जीना डोळा आक्‌ठु नी आच ने तेवा, अने पोग वारला पीतळ ने तेवा से, तीहयो आहयु केय के’ <verse eid="REV 2:18" /><verse number="19" style="v" sid="REV 2:19" />मे तारा कामु, मोंग, भरहो, सेवा अने गम ने जाणु, अने आहयु बी जाणु के तु तारा पाछला काम सी जादा वारु काम हमणे कर र्‌यो। <verse eid="REV 2:19" /><verse number="20" style="v" sid="REV 2:20" />पण मे तारा वीरोद मे आहयु केम के तु तीहयी ईजेबेल नाम नी बयर ना गलत काम ने वेठ र्‌यो, जे आह़फी ने भगवान वखे गेथी वात केवा वाळी केय। अने तीनी ह़ीकापण नी लारे मारा चाकर्‌या ने छीनाळु करवा अने मुरत्‌या अगळ चड़ावलु खाणु खावा करीन गलत अगवाय करे। <verse eid="REV 2:20" /><verse number="21" style="v" sid="REV 2:21" />मे तीने तीमना पापु सी मन फीरवा नो मोखो आप्‌यो, पण तीहयी तीना छीनाळा ना कामु सी मन फीराव्‌वा तीयार नी हय। <verse eid="REV 2:21" /><verse number="22" style="v" sid="REV 2:22" />करीन हाव देखो, मे तीने मंदवाड़ ना गोदड़ा मे ह़ुवाड़ देही अने तीमने बी, जे तीनी ह़ाते छीनाळु मे भेसकायला से; के तीहया तीहयी टेमे तक घण-जबर दुख झेलता रेय, जत्‌यार तीहया तीनी ह़ाते करला आह़फाम ना गलत काम सी मन नी फीरवे। <verse eid="REV 2:22" /><verse number="23" style="v" sid="REV 2:23" />मे तीनी पसळ चालन्‌या ने मार नाखही; ता आखी मंडळी ना माणहु जाण लेहे के मन अने वीच्‌यारु ने पारखवा वाळो मेत से, अने मे तीमनी माय्‌न एक-एक जणा ने तीमना काम नी अनसारे बदलो लेही।”<verse eid="REV 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 2:24" />“पण तमु थुवातीरा ना बचला बीजा माणहु सी, जेतरा आहयी गलत ह़ीकापण ने नी मान्‌ता, अने तीहयी वात ने जे भुतड़ा नी केदली घणी जुदी वात ने नी जाण्‌या, तीमने आहयु केम के मे तमारी पोर अळी भार नी नाखु। <verse eid="REV 2:24" /><verse number="25" style="v" sid="REV 2:25" />पण जे तमारी पांह से तीने मने आवते लग वारु ह़माळीन राख रेवो। <verse eid="REV 2:25" /><verse number="26" style="v" sid="REV 2:26" />जे जीकीन रेय अने मारा कामु नी अनसारे आखरी तक करतो रेहे, मे तीने तीहयोत हक आपही जे मे मारा बाह पांह गेथो हात करलो से। <verse eid="REV 2:26" /><verse number="27" style="v" sid="REV 2:27" />अने मे तीमने देसु पोर हक आपही, अने तीहया लुहड़ा नो ह़र्‌यो लीन तीमनी पोर राज करहे, अने तीमने कादा ना रासुन तेम टुकड़ा-टुकड़ा कर देय: <verse eid="REV 2:27" /><verse number="28" style="v" sid="REV 2:28" />अने मे बी तीमने ह़वारे नी चांदणी आपही”<verse eid="REV 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="REV 2:29" />“जीना कान्‌टा हय तीहया ह़मळी लेवो के आत्‌मा मंडळी ने ह़ु केय।”<verse eid="REV 2:29" /></para>
  <chapter eid="REV 2" />
  <chapter number="3" style="c" sid="REV 3" />
  <para style="s">सरदीस ने खबर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 3:1" />“सरदीस नी मंडळी ना दुत ने आहयु लीख: ‘जीनी पांह भगवान नी ह़ात आत्‌मा अने ह़ात तारा से, तीहयो आहयु केय के मे तारा कामु ने जाणु, अने माणहु केय तु जीवत्‌लो से पण ह़ाचलीन तु मरलो से।’ <verse eid="REV 3:1" /><verse number="2" style="v" sid="REV 3:2" />एतरे उठ जा, अने तीने मजबुत कर, जे बच जेलु से आनीन पेले के तीहयु पुरी रीती सी मर जाय, काहाके मे तारा काम ने भगवान नी नींगा मे अरदा देख्‌यो। <verse eid="REV 3:2" /><verse number="3" style="v" sid="REV 3:3" /><note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्‌ती 24:43</ref>,<ref loc="MAT 24:44">44</ref>; <ref loc="LUK 12:39">लुका 12:39</ref>,<ref loc="LUK 12:40">40</ref>; <ref loc="REV 16:15">परकासीतवाक्‌य 16:15</ref></char></note>करीन तु फोम कर के तु केवी ह़ीकापण ह़ीकलो अने ह़मळलो, अने तीने मान अने पापु सी मन फीराव। कदीम तु नी जाग्‌यो, ता मे चोट्‌टान तेम तारीन्‌तां आय लागही, अने तु कदी तीहयी टेम ने नी जाण सके के मे कानी टेमे तारीन्‌तां आवही। <verse eid="REV 3:3" /><verse number="4" style="v" sid="REV 3:4" />पण होव, सरदीस ह़ेर मे तारीन्‌तां थोड़ाक एवा माणहु से जे आह़फा ना लुगड़ा ने चोखा राख्‌या। तीहया धोळ्‌ळा लुगड़ा पेरीन मारी ह़ाते फीरहे, काहाके तीहया आनी लायक से। <verse eid="REV 3:4" /><verse number="5" style="v" sid="REV 3:5" /><note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="REV 20:12">परकासीतवाक्‌य 20:12</ref>; </char><char style="xt" closed="false"><ref loc="MAT 10:32">मत्‌ती 10:32</ref>; <ref loc="LUK 12:8">लुका 12:8</ref></char></note>जे जीक जहे तीने एमेत धोळ्‌ळा लुगड़ा पेरावहे, अने मे तीनु नाम जीवाय नी कीताप मे गेथु कानी बी रीते कदी नी काटु; पण तीनु नाम मारा बाह अने तीना ह़रगदुत अगळ देखाड़ही के आहयो मारो से।”<verse eid="REV 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 3:6" />जीना कान्‌टा हय तीहया ह़मळ लेय के आत्‌मा मंडळी ना माणहु ने ह़ु केय।<verse eid="REV 3:6" /></para>
  <para style="s">फीलदीलफीया ने खबर</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 3:7" />“फीलदीलफीया नी मंडळी ना दुत ने आहयु लीख: ‘जे चोखलो अने खरलो से, अने जे दावुद नी कुची राखे, अने जे झापलु ने तीहयो उगाड़े, तीने कोय दी नी सके, अने जे झापलु तीहयो देय, तीने कोय उगाड़ी नी सके, तीहयो आहयु केय के।’” <verse eid="REV 3:7" /><verse number="8" style="v" sid="REV 3:8" />“मे तारा कामु ने जाणु; देख मे तारी अगळ एक झापलु उगड़लु राख र्‌यो, जीने कोय दी नी सके; मे जाणु के तारी ताखत थोड़ीक से, ते बी तु मारी ह़ीकापण ने मान्‌यो अने तु मारी ह़ाते भरहा नी लायक बणीन र्‌यो। <verse eid="REV 3:8" /><verse number="9" style="v" sid="REV 3:9" />देख, मे भुतड़ा ना टोळा मे वाळा ने तारा हक मे कर देही जे आह़फा ने युहदी केय, पण तीहया नी हय अने झुट मेक र्‌या, देख, मे आसम करही के तीहया आवीन तारा पोगे पड़हे, अने आहयु जाण लेहे के मे तारी सी मोंग कर र्‌यो। <verse eid="REV 3:9" /><verse number="10" style="v" sid="REV 3:10" />काहाके तु गम खावा ना हुकम ने ठाण लेदलो से, करीन मे बी तने पारख नी तीहयी टेमे बचाड़ीन राखही जे धरती पोर रेवा वाळा ने पारखवा करीन आखी कळी पोर आव्‌वा वाळी से। <verse eid="REV 3:10" /><verse number="11" style="v" sid="REV 3:11" />मे छोटोत आव्‌वा वाळो से; जे कंय तारी पांह से तीने धरीन राख के कोय तारी जीक नु ईलाम हापकी नी लेय। <verse eid="REV 3:11" /><verse number="12" style="v" sid="REV 3:12" /><note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="REV 21:2">परकासीतवाक्‌य 21:2</ref></char></note>जे जीक जहे तीने मे मारा भगवान ना मंदीर मे एक खम्‌बो बणावही, अने तीहया अळतेण कदी बारा नी नीकळे; अने मे तीमनी पोर मारा भगवान नु नाम अने मारा भगवान ना ह़ेर मतलब नवला यरुसलेम नु नाम लीखही, जे मारा भगवान भणी गेथु ह़रगे गेथु उतरवा वाळु से, अने मे मारु नवलु नाम बी लीखही।”<verse eid="REV 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 3:13" />“जीना कान्‌टा हय, तीहयो ह़मळी लेय के मंडळी ना माणहु ने आत्‌मा ह़ु केय।”<verse eid="REV 3:13" /></para>
  <para style="s">लोदीकीया ने खबर</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 3:14" />“लोदीकीया नी मंडळी ना दुत ने आहयु लीख: ‘जे आमीन अने भरहो करे एवो अने खरलो गवा से, अने भगवान नी बणावट नो हकदार्‌यो से, तीहयो आहयु केय के।’ <verse eid="REV 3:14" /><verse number="15" style="v" sid="REV 3:15" />मे तारा काम ने जाणु काहाके तु नी ते टाडलो हय अने नी ते उन्‌लो हय: भलु रेतु के तु टाडलो नीता उन्‌लो रेतो। <verse eid="REV 3:15" /><verse number="16" style="v" sid="REV 3:16" />एतरे के तु फळको-फळको से, नी टाडलो हय अने नी उन्‌लो हय, मे तने मारा मोडा मे गेथो बारो नीकाळवा पोर से। <verse eid="REV 3:16" /><verse number="17" style="v" sid="REV 3:17" />तु केय के मे पामत्‌लो से अने पामतो हय ज्‌यो, अने मारी पांह कंय चीज नी कमी नी हय; पण तु आहयु नी जाणतो के तारो कीसमत नी हय, अने फाल्‌तु, गरीब, आंदळो अने नांगरलो से। <verse eid="REV 3:17" /><verse number="18" style="v" sid="REV 3:18" />एतरे मारी ह़ला तारी जुगु आहयी से के आक्‌ठु मे चोखु करलु ह़ोनु मारी पांह गेथु वेचातु ली ले के तु पामतो हय जाय। अने धोळ्‌ळु लुगड़ु बी वेचातु लीन पेर ले, अने तु तारु लजवायणु नांगरलु ने ढाक, अने तारा डोळा पोर लगाड़वा ना लेदे सुरमो ली ले के तु देख सके। <verse eid="REV 3:18" /><verse number="19" style="v" sid="REV 3:19" /><note caller="+" style="x"><char style="xo" closed="false">3:19 </char><char style="xt" closed="false"><ref loc="HEB 12:6">ईब्‌रानीयो 12:6</ref></char></note>मे जीमने मोंग करु तीमने मे वडु अने सजा आपु। एतरे हीम्‌मत वाळा बणो अने आह़फा ना पाप सी मन फीरावो। <verse eid="REV 3:19" /><verse number="20" style="v" sid="REV 3:20" />देख, मे झापले उबो रीन झापलु ठोक र्‌यो; कदीम कोय मारो बोल ह़मळीन झापलु उगड़हे, ता मे तीना घोर मे आय्‌न तीनी ह़ाते खाणु खाही अने तीहया मारी ह़ाते खाहे। <verse eid="REV 3:20" /><verse number="21" style="v" sid="REV 3:21" />जे जीक जहे मे तीने मारी ह़ाते मारी राजगादी पोर बहवा नो हक आपही, जेम मे बी जीकीन मारा बाह ह़ाते तीनी राजगादी पोर बह ज्‌यो।<verse eid="REV 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 3:22" />“जीना कान्‌टा हय, तीहयो ह़मळी लेय के मंडळी ना माणहु ने आत्‌मा ह़ु केय।”<verse eid="REV 3:22" /></para>
  <chapter eid="REV 3" />
  <chapter number="4" style="c" sid="REV 4" />
  <para style="s">ह़रग मे भक्‌ती</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 4:1" />आहयी आखी वात नी अळतेण मे जे देख्‌यो ता आहयु देख्‌यो के ह़रग मे एक झापलु उगड़लु से, अने जीने मे पेले फेपार्‌यान तेवी अवाज मे मारी ह़ाते वात करते ह़मळलो, तीहयोत केय, “आञे उपर आवती रे; अने तीहयी वात मे तने देखाड़ही. जे आहयी वात हय जाय अने अळतेण पुरी हयवात वाळी से।” <verse eid="REV 4:1" /><verse number="2" style="v" sid="REV 4:2" />पण तत्‌यारुत आत्‌मा मने हक मे कर लेदी। अने मे देख्‌यो के मारी अगळ ह़रग मे राजगादी मेकली हती, अने तीहयी राजगादी पोर कोय बही र्‌यु हतु। <verse eid="REV 4:2" /><verse number="3" style="v" sid="REV 4:3" />तीहयो जे राजगादी पोर बह र्‌यो हतो, तीहयो रात्‌ला-भुरला अने पीळ्‌ळा-रात्‌ला पपलन्‌या दगड़ान तेम देखाय, तीहयी राजगादी ना च्‌यारो-मेर बाम नो रंग हतो। <verse eid="REV 4:3" /><verse number="4" style="v" sid="REV 4:4" />तीहयी राजगादी नी च्‌यारो-मेर चोवीह़ राजगादी अळी हती; अने आहयी राजगादी पोर पेल्‌ना वारा ना चोवीह़ माणहु धोळ्‌ळा लुगड़ा पेरीन बह र्‌या हता। अने तीमना मुंडा पोर ह़ोना नी पागड़ी हती। <verse eid="REV 4:4" /><verse number="5" style="v" sid="REV 4:5" /><note caller="+" style="x"><char style="xo" closed="false">4:5 </char><char style="xt" closed="false"><ref loc="REV 8:5">परकासीतवाक्‌य 8:5</ref>; <ref loc="REV 11:19">11:19</ref>; <ref loc="REV 16:18">16:18</ref>; </char><char style="xt" closed="false"><ref loc="REV 1:4">परकासीतवाक्‌य 1:4</ref></char></note>राजगादी मे गेथी वीजळी नी चमक अने वादळा मे नी गाज नीकळती हती, अने राजगादी अगळ आक्‌ठु ना ह़ात दीवा धपता हता, तीहयी भगवान नी ह़ात आत्‌मा से।<verse eid="REV 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 4:6" />अळी बी राजगादीन अगळ आर-पार देखायवा वाळा काच ने तेवी दर्‌या फेल्‌ली हती, अने राजगादीन अगळेत अने राजगादी नी च्‌यारो-मेर च्‌यार जीव हता, जीमना अगळ-पसळ डोळात-डोळा से। <verse eid="REV 4:6" /><verse number="7" style="v" sid="REV 4:7" />पेलो जीव नाहर ने तेवो हतो, अने बीजो जीव वाछड़ुन तेवो हतो, अने तीसरा जीव नु मोडु माणेह ने तेवु हतु, अने चोवथो जीव उडण्‌यान घुवड़ ने तेवो हतो। <verse eid="REV 4:7" /><verse number="8" style="v" sid="REV 4:8" />तीहया च्‌यारोव जीव ना छोव-छोव पाखड़ा हता, अने च्‌यारो-मेर अने मोय डोळात-डोळा हता; अने तीहया रात ने दाड़ो अराम कर्‌या वगर आहयु केय,</para>
  <para style="q1" vid="REV 4:8">“चोखलो, चोखलो, चोखलो, मालीक भगवान, जे जोरभर्‌यो,</para>
  <para style="q2" vid="REV 4:8">हतो अने जे से, अने जे आव्‌वा वाळो से।”<verse eid="REV 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 4:9" />ता तीहया जीव तीनी जे राजगादी पोर बह र्‌यो हतो, अने जे जलमको जीवत्‌लो से, बड़ाय अने ईज्‌जत करहे अने तु घणो वारु से केहे; <verse eid="REV 4:9" /><verse number="10" style="v" sid="REV 4:10" />ता तीहया पेल्‌ना वारा ना चोवीह़ माणहु जे राजगादी पोर बह र्‌या हता, तीना पोगु मे पड़ीन, अने जे सदा जीवत्‌लो रेवा वाळा नी उपाह़ पाळे। अने तीहया राजगादी अगळ आह़फाम नी पागड़ी नाख देय अने आहयु केय,<verse eid="REV 4:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="REV 4:11" />“ए अमारा मालीक अने भगवान, तुत बड़ाय,</para>
  <para style="q2" vid="REV 4:11">ईज्‌जत, अने ताखत नी लायक से;</para>
  <para style="q1" vid="REV 4:11">काहाके तुत आखी चीज बणायो अने तीहयी आखी</para>
  <para style="q2" vid="REV 4:11">तारीत मरजी सी, तीहयी बणी अने जीवत्‌ली से।”<verse eid="REV 4:11" /></para>
  <chapter eid="REV 4" />
  <chapter number="5" style="c" sid="REV 5" />
  <para style="s">कीताप अने गाडरु</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 5:1" />जे राजगादी पोर बहलो हतो, मे तीना जमणा हात मे एक कीताप देख्‌यो जे मोय अने बारी गेथी लीखली हती, अने तीहयी ह़ात सीलटप्‌पा लगाड़ीन बंद करली हती। <verse eid="REV 5:1" /><verse number="2" style="v" sid="REV 5:2" />अळतेण मे एक जोर वाळा ह़रगदुत ने देख्‌यो जे उचा बोलु सी आहयु परच्‌यार करतो हतो, “आहयी कीताप ने उगड़वा अने तीना सीलटप्‌पा तोड़वा नी लायक कोय से?” <verse eid="REV 5:2" /><verse number="3" style="v" sid="REV 5:3" />पण नी ह़रग मे, नी धरती पोर, नी ते धरती तळे कोय तीहयी कीताप ने उगाड़वा नीता तीहयी कीताप मे ह़ु से भाळवा नी लायक नी नीकळ्‌यु। <verse eid="REV 5:3" /><verse number="4" style="v" sid="REV 5:4" />ता मे कल्‌पी-कल्‌पीन रड़वा बाज ज्‌यो, काहाके तीहयी कीताप ने उगाड़वा वाळो अने तीनी मे ह़ु से भाळवा नी लायक कोय नी नीकळ्‌यु। <verse eid="REV 5:4" /><verse number="5" style="v" sid="REV 5:5" />ता तीहया डायला माणहु माय्‌न एक जणो मने केदो, “ना रड़े; देख, यहुदा ना घोराणा नो तीहयो नाहर जे दावुद नी अवल्‌यात से, तीहयो आहया ह़ातोव सीलटप्‌पा ने अने आहयी कीताप ने उगाड़वा मे ताखत वाळो से।”<verse eid="REV 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 5:6" />ता मे देख्‌यो गाडरु राजगादी नी वचा-वच उबु हय र्‌यु, अने च्‌यारोव जीव अने पेल्‌ना वारा ना माणहु नी वच मे घेरवाय र्‌यु हतु, तीहयु एक मार नाखलुन तेवु गाडरु देखायतु हतु; तीना ह़ात ह़ींगड़ा अने ह़ात डोळा हता; जे भगवान नी ह़ातोव आत्‌मा से जीमने आखी धरती पोर मोकल्‌ली हती। <verse eid="REV 5:6" /><verse number="7" style="v" sid="REV 5:7" />तीहयो आवीन तीना जमणा हात मे गेथी जे राजगादी पोर बहलो हतो, तीहयी कीताप ली लेदो। <verse eid="REV 5:7" /><verse number="8" style="v" sid="REV 5:8" />जत्‌यार तीहयो कीताप ली लेदो, ता तीहया च्‌यारोव जीव अने चोवीह़ पेल्‌ना वारा ना माणहु तीहयु गाडरुन अगळ मांडा टेक्‌या। तीमनी माय्‌न एक-एक जणा ना हात मे तम्‌बुरो अने धुप सी भरला ह़ोना ना कटोरा हता, जे भगवान ना चोखला माणहु नी वीन्‌ती हती। <verse eid="REV 5:8" /><verse number="9" style="v" sid="REV 5:9" />अने तीहया एक नवलु गीत गाव्‌वा बाज र्‌या हता,</para>
  <para style="q1" vid="REV 5:9">“तु आहयी कीताप ने लेवा, अने आहयी कीताप ना सीलटप्‌पा ने उगाड़वा मे ताखत वाळो से।</para>
  <para style="q2" vid="REV 5:9">काहाके तने बादा ना रुप मे कर देदो।</para>
  <para style="q1" vid="REV 5:9">अने तीनीत लारे तु भगवान ना माणहु ने</para>
  <para style="q2" vid="REV 5:9">आखा घोराणा अने भासा अने माणहु अने जाती मे गेथो माणहु ने वेचातो लेदलो से,<verse eid="REV 5:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="REV 5:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:10 </char>
      <char style="xt" closed="false">
        <ref loc="REV 1:6">परकासीतवाक्‌य 1:6</ref>
      </char>
    </note>अने तीमने आपणा भगवान जुगु एक राज अने पुंजारो बणावलो से;</para>
  <para style="q2" vid="REV 5:10">अने तीहया धरती पोर राज करहे।”<verse eid="REV 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 5:11" />अळी मे देख्‌यो, अने हजारो लाखो ह़रगदुत नी अवाज ह़मळ्‌यो, तीहयी ते राजगादी, अने तीहया च्‌यार जीव, अने तीहया पेल्‌ना वारा नी च्‌यारो-मेर उबा हय र्‌या हता। <verse eid="REV 5:11" /><verse number="12" style="v" sid="REV 5:12" />अने तीहया उचा बोलु सी केवा बाज ज्‌या,</para>
  <para style="q1" vid="REV 5:12">“बादा चड़ावलु गाडरुत ताखत वाळु</para>
  <para style="q2" vid="REV 5:12">अने धन वाळु अने अक्‌कल वाळु अने सक्‌ती वाळु,</para>
  <para style="q2" vid="REV 5:12">ईज्‌जत वाळु अने बड़ाय नी लायक से!” <verse eid="REV 5:12" /><verse number="13" style="v" sid="REV 5:13" />अळतेण मे ह़रग मे अने धरती पोर अने धरती तळे अने दर्‌या नी आखी बणावली चीज ने,</para>
  <para style="q1" vid="REV 5:13">अने आखी जे तीनी मे से, आहयु केते ह़मळ्‌यो,</para>
  <para style="q2" vid="REV 5:13">“जे राजगादी पोर बह र्‌यो तीनी अने गाडरु नी बड़ाय,</para>
  <para style="q2" vid="REV 5:13">अने ईज्‌जत, अने राज जलम रेय!”<verse eid="REV 5:13" /></para>
  <para style="m">
    <verse number="14" style="v" sid="REV 5:14" />अने च्‌यारोव जीव केदा, “आमीन!” अने पेल्‌ना वारा ना माणहु मांडा टेकीन बड़ाय कर्‌या।<verse eid="REV 5:14" /></para>
  <chapter eid="REV 5" />
  <chapter number="6" style="c" sid="REV 6" />
  <para style="s">सीलटप्‌पा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 6:1" />अळतेण मे देख्‌यो के गाडरु तीहया ह़ात सीलटप्‌पा मे गेथो एक उगाड़्‌यो; अने तीहया च्‌यारोव जीव माय्‌न एक नो वादळु नी गाज ह़रको बोल ह़मळ्‌यो, “आव!” <verse eid="REV 6:1" /><verse number="2" style="v" sid="REV 6:2" />मे भाळ्‌यो, अने देख्‌यो, के एक धोळ्‌ळो घोड़ो से, अने तीनी पोर बहण्‌यो धंदली लीन से;<note caller="+" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="ZEC 1:8">जकर्‌याह 1:8</ref>; <ref loc="ZEC 6:3">6:3</ref>,<ref loc="ZEC 6:6">6</ref></char></note> अने तीने एक पागड़ी आप्‌या, अने तीहयो जीकतो जाय्‌न नीकळ्‌यो, के तीहयो अळी जीक हात करे।<verse eid="REV 6:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 6:3" />अने गाडरु बीजो सीलटप्‌पो उगड़्‌यो, ता मे बीजा जीव ने आहयु केते ह़मळ्‌यो, “आव!” <verse eid="REV 6:3" /><verse number="4" style="v" sid="REV 6:4" />अने अळतेण एक अळी घोड़ो नीकळ्‌यो जे रात्‌ला रंग नो हतो;<note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="ZEC 1:8">जकर्‌याह 1:8</ref>; <ref loc="ZEC 6:2">6:2</ref> </char></note> तीनी पोर बहण्‌या ने आहयी हीम्‌मत आप्‌यो के धरती पोर गेथो मेळ अने सांती हापकी लेय, काहाके माणहु एक-बीजा ने मारे; अने तीने एक मोट्‌ली तलवार आप्‌यो।<verse eid="REV 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 6:5" />जत्‌यार तीहयो तीसरो सीलटप्‌पो उगाड़्‌यो, ता मे तीसरा जीव ने आहयु केते ह़मळ्‌यो, “आव!” मे भाळ्‌यो, अने देख्‌यो, एक काळ्‌ळो घोड़ो से, <note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="ZEC 6:2">जकर्‌याह 6:2</ref>,<ref loc="ZEC 6:6">6</ref> </char></note>अने तीनी पोर बहण्‌या ना हात मे एक ताकड़ी से। <verse eid="REV 6:5" /><verse number="6" style="v" sid="REV 6:6" />तात मे तीहया च्‌यारोव जीव नी वच मे गेथो एक आहयो बोल केते ह़मळ्‌यो, जे केवा बाज र्‌यो हतो, “एक दाड़ा नी दाड़की ना बदले एक दाड़ा ना खावा ना गम अने एक दाड़ा नी दाड़की ना बदले तीन दाड़ा लग खावा नी जुवार। पण जेतुन नु तेल, अने अंगुर ना रोह नु नुकसान नी करजो।”<verse eid="REV 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 6:7" />जत्‌यार तीहयो चोवथो टप्‌पो उगाड़्‌यो, ता मे चोवथा जीव ने आहयो बोल केते ह़मळ्‌यो, “आव!” <verse eid="REV 6:7" /><verse number="8" style="v" sid="REV 6:8" />मे भाळ्‌यो, अने देख्‌यो, एक पीळ्‌ळो घोड़ो से; अने तीनी पोर बहण्‌या नु नाम मोत से, अने पताळ तीनी पसळ-पसळ से; अने तीने धरती ना एक चोवथा खुणा पोर हक आप्‌यो के झगड़ो, अने काळ, मंदवाड़, अने जंगली-जंगली जानवरु नी लारे माणहु ने मार नाखे।<note caller="+" style="x"><char style="xo" closed="false">6:8 </char><char style="xt" closed="false"><ref loc="EZK 14:21">यहेजकेल 14:21</ref></char></note><verse eid="REV 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 6:9" />जत्‌यार तीहयो पांचवो सीलटप्‌पो उगाड़्‌यो, ता मे वेदी नी तळे तीमना जीव ने देख्‌यो, जे भगवान ना बोलु ने परच्‌यार करवा ना कारण अने तीना बारा मे गवाय देवा ना कारण सी मार नाखला हता। <verse eid="REV 6:9" /><verse number="10" style="v" sid="REV 6:10" />तीहया उचा बोलु सी आड़ीन केदा, “ए मालीक, ए चोखला अने खरला; तु कारु तक तु धरती पोर वाळा माणहु नो नीयाव नी करे? अने आमने मारवा वाळा ने कारु तक सजा नी आपे?” <verse eid="REV 6:10" /><verse number="11" style="v" sid="REV 6:11" />तीमनी माय्‌न आखा ने धोळ्‌ला लुगड़ा आप्‌या, अने तीमने केदो के अळी थोड़ीक वार अराम करो, जत्‌यार तक के तमारा ह़ाती चाकर्‌या अने भरहो करन्‌या भायु नी मरवा नी गीनती पुरी नी हय जाय, तीमनी बी तेमेत हत्‌या हयवा वाळी से जेम तमारी करला हता।<verse eid="REV 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 6:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:12 </char>
      <char style="xt" closed="false">
        <ref loc="REV 11:13">परकासीतवाक्‌य 11:13</ref>; <ref loc="REV 16:18">16:18</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:29">मत्‌ती 24:29</ref>; <ref loc="MRK 13:24">मरकुस 13:24</ref>,<ref loc="MRK 13:25">25</ref>; <ref loc="LUK 21:25">लुका 21:25</ref></char>
    </note>जत्‌यार गाडरु छटवो सीलटप्‌पो उगाड़्‌यो, ता मे देख्‌यो के एक मोट्‌लो भुकम्‌प आयो,<note caller="+" style="x"><char style="xo" closed="false">6:12 </char><char style="xt" closed="false"><ref loc="REV 11:13">परकासीतवाक्‌य 11:13</ref>; <ref loc="REV 16:18">16:18</ref></char></note> अने दाहड़ु चादरुन तेम काळु अने पुरो चांद लोय ने तेवो हय ज्‌यो। <verse eid="REV 6:12" /><verse number="13" style="v" sid="REV 6:13" />वादळा मे ना तारा धरती पोर आसम पड़वा बाज ज्‌या जेम मोट्‌ली आंजी आवेन अने हीलीन गुलर ना काचलात फोळ धरती पोर पड़ जाय। <verse eid="REV 6:13" /><verse number="14" style="v" sid="REV 6:14" /><note caller="+" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="REV 16:20">परकासीतवाक्‌य 16:20</ref></char></note>वादळु फाटीन आसम हय ज्‌यु जेम चामड़ा नी कीताप फाटीन एकठी हय जाय,<note caller="+" style="x"><char style="xo" closed="false">6:14 </char><char style="xt" closed="false"><ref loc="ISA 34:4">यसाया 34:4</ref></char></note> अने एक-एक टापु तीमना जागा गेथा ह़रकी ज्‌या। <verse eid="REV 6:14" /><verse number="15" style="v" sid="REV 6:15" />ता धरती पोर वाळो राजो, अने पुडार्‌या, अने मुख्‌या, अने मालदार अने जोरभर्‌या माणहु, अने एक-एक चाकर्‌या अने एक-एक छुटला माणहु गुफा मे अने बड़ा ना दगड़ा मे जाय्‌न ह़ताय ज्‌या,<note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="HOS 10:8">होसे 10:8</ref>; <ref loc="LUK 23:30">लुका 23:30</ref></char></note> <verse eid="REV 6:15" /><verse number="16" style="v" sid="REV 6:16" /><note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="LUK 23:30">लुका 23:30</ref></char></note>अने बड़ा अने चाफर्‌या ने केवा बाज ज्‌या, “अमारी पोर पड़ जावो; अने आमने तीनी सी जे राजगादी पोर बह र्‌यो, अने गाडरु नी रीह सी ह़ताड़ लेवो। <verse eid="REV 6:16" /><verse number="17" style="v" sid="REV 6:17" />काहाके तीमनी घण-जबर रीह नो दाड़ो आय लागलो से,<note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="JOL 2:11">योएल 2:11</ref>; <ref loc="MAL 3:2">मलाकी 3:2</ref></char></note> अने एवु कोय से जे आनी अगळ टेक सकहे?”<verse eid="REV 6:17" /></para>
  <chapter eid="REV 6" />
  <chapter number="7" style="c" sid="REV 7" />
  <para style="s">144,000 ईस्‌रायल माणहु</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 7:1" />अळतेण मे धरती ना च्‌यारोव खुणा पोर च्‌यार ह़रगदुत उबा हय रेला देख्‌यो। तीहया धरती नी च्‌यारो-मेर नु वाहळु रोक र्‌या हता काहाके धरती अने दर्‌या अने काना बी झाड़का पोर वाहळु नी लागे।<note caller="+" style="x"><char style="xo" closed="false">7:1 </char><char style="xt" closed="false"><ref loc="JER 49:36">यीरम्‌या 49:36</ref>; <ref loc="DAN 7:2">दानीयल 7:2</ref>; <ref loc="ZEC 6:5">जकर्‌याह 6:5</ref></char></note> <verse eid="REV 7:1" /><verse number="2" style="v" sid="REV 7:2" />अळतेण मे एक अळी बीजा ह़रगदुत ने जीवत्‌ला भगवान ना सीलटप्‌पा लीन उगवणो गेथो उपर आवते देख्‌यो; तीहयो तीहया च्‌यारोव ह़रगदुत ने जीमने धरती अने दर्‌या नु नुकसान करवा नो हक आपलो हतो, उचा बोल सी आड़ीन केदो, <verse eid="REV 7:2" /><verse number="3" style="v" sid="REV 7:3" />“जत्‌यार तक आमु अमारा भगवान ना चाकर्‌या ना नींडाळे सीलटप्‌पो नी लगाड़ दीया, तांह तक धरती अने दर्‌या अने झाड़का नु नुकसान नी करजो।”<note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="EZK 9:4">यहेजकेल 9:4</ref>,<ref loc="EZK 9:6">6</ref></char></note> <verse eid="REV 7:3" /><verse number="4" style="v" sid="REV 7:4" />जीमनी पोर भगवान नो सीलटप्‌पो लागलो से मे तीमनी गीनती ह़मळ्‌यो, मतलब ईस्‌रायली नी अवल्‌यात ना आखा घोराणा जात्‌या माय्‌न एक लाख चाळीह़ ने च्‌यार हजार पोर सीलटप्‌पा लगाड़ला से: <verse eid="REV 7:4" /><verse number="5" style="v" sid="REV 7:5" />एक-एक जाती माय्‌न बारे हजार पोर सीलटप्‌पो लगाड़्‌या, यहुदा ना जात्‌या माय्‌न बारे हजार पोर सीलटप्‌पा लगाड़ला से; रुबेन ना जात्‌या माय्‌न बारे हजार पोर, अने गाद ना जात्‌या माय्‌न बारे हजार पोर, <verse eid="REV 7:5" /><verse number="6" style="v" sid="REV 7:6" />आसेर ना जात्‌या माय्‌न बारे हजार पोर, नप्‌ताली ना जात्‌या माय्‌न बारे हजार पोर, मनस्‌सीह ना जात्‌या माय्‌न बारे हजार पोर, <verse eid="REV 7:6" /><verse number="7" style="v" sid="REV 7:7" />सीमोन ना जात्‌या माय्‌न बारे हजार पोर, अने लेवी ना जात्‌या माय्‌न बारे हजार पोर, ईस्‌साकार ना जात्‌या माय्‌न बारे हजार पोर, <verse eid="REV 7:7" /><verse number="8" style="v" sid="REV 7:8" />जबुलुन ना जात्‌या माय्‌न बारे हजार पोर, अने युसुफ ना जात्‌या माय्‌न बारे हजार पोर, अने बीन्‌यामीन ना जात्‌या माय्‌न बारे हजार पोर सीलटप्‌पा लगाड़्‌या।<verse eid="REV 7:8" /></para>
  <para style="s">धोळ्‌ळा लुगड़ा मे मोट्‌ली भीड़</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 7:9" />अळतेण मे भाळ्‌यो, अने देखो, एक-एक जाती अने घोराणा अने भासा मे गेथी एक एवी मोट्‌ली भीड़, जीने कोय गीण नी सके, धोळ्‌ळा लुगड़ा पेरीन अने हात मे खजुरा ना डाळ्‌या लीन राजगादी नी अने गाडरु नी अगळ उबी हय री हती, <verse eid="REV 7:9" /><verse number="10" style="v" sid="REV 7:10" />अने उचा बोल सी आड़ीन केय, “छुटकारा जुगु अमारा भगवान नी, जे राजगादी पोर बह र्‌यो, अने गाडरु नी जय-जयकार हये!” <verse eid="REV 7:10" /><verse number="11" style="v" sid="REV 7:11" />अने आखा ह़रगदुत तीहयी राजगादी अने पेल्‌ना वारा ना माणहु अने च्‌यारोव जीव नी च्‌यारो-मेर उबा हय र्‌या; अळतेण तीहया मोडा ना भरहे पड़ ज्‌या अने भगवान नी बड़ाय कर्‌या। <verse eid="REV 7:11" /><verse number="12" style="v" sid="REV 7:12" />अने केदा, “आमीन! अमारा भगवान नी बड़ाय, अक्‌कल अने घणो वारु से केवा, अने ईज्‌जत, अने ताखत, अने सक्‌ती जलमकी बणली रेय। आमीन!”<verse eid="REV 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 7:13" />ता पेल्‌ना वारा ना माणहु माय्‌न एक जणो मने केदो, “आहया धोळ्‌ळा लुगड़ा पेरला कोय से? अने कां गेथा आवला से?”<verse eid="REV 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 7:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:21">मत्‌ती 24:21</ref>; <ref loc="MRK 13:19">मरकुस 13:19</ref></char>
    </note>मे तीने केदो, “ए मालीक, तुत जाणे।” तीहयो मने केदो, “आहया तीहया माणहु से, जे घण-जबर दुख मे गेथा आरगला नीकळीन आवला से;<note caller="+" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="DAN 12:1">दानीयल 12:1</ref>; <ref loc="MAT 24:21">मत्‌ती 24:21</ref>; <ref loc="MRK 13:19">मरकुस 13:19</ref></char></note> आहया आह़फा-आह़फाम ना लुगड़ा गाडरु ना लोय मे धोवीन धोळ्‌ळा करला से। <verse eid="REV 7:14" /><verse number="15" style="v" sid="REV 7:15" />आनीत करते तीहया भगवान नी राजगादी अगळ से, अने तीना मंदीर<note caller="+" style="f"><char style="fr" closed="false">7:15 </char><char style="ft" closed="false">मतलब, चोखलो जागो</char></note> मे रात-दाड़ो तीनी चाकरी करे, अने जे राजगादी पोर बह र्‌यो, तीहयो तीनी हजरी मे तीमनी रखवाळी करहे। <verse eid="REV 7:15" /><verse number="16" style="v" sid="REV 7:16" />तीहया अळतेण कदी भुकला अने तरहेला नी हये; अने नी ते दाहड़ु अने नी ते हहळत्‌लो तोप धपाड़ सके।<note caller="+" style="x"><char style="xo" closed="false">7:16 </char><char style="xt" closed="false"><ref loc="ISA 49:10">यसाया 49:10</ref></char></note> <verse eid="REV 7:16" /><verse number="17" style="v" sid="REV 7:17" />काहाके जे गाडरु राजगादी नी वच मे से तीमनो गुवाळ्‌यो रेहे,<note caller="+" style="x"><char style="xo" closed="false">7:17 </char><char style="xt" closed="false"><ref loc="PSA 23:1">भजन सहीता 23:1</ref>; <ref loc="EZK 34:23">यहेजकेल 34:23</ref> </char></note> अने तीमने जीवाय ना झोरुनतां ली ज्‌या करहे; अने भगवान तीमना डोळा ना आखा आंहवा नुस देहे।”<verse eid="REV 7:17" /></para>
  <chapter eid="REV 7" />
  <chapter number="8" style="c" sid="REV 8" />
  <para style="s">ह़ातवो सीलटप्‌पो</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 8:1" />जत्‌यार गाडरु ह़ातवो सीलटप्‌पो उगाड़्‌यो, ता ह़रग मे अरदा घंटा लग ह़ानाह़ुन र्‌यु। <verse eid="REV 8:1" /><verse number="2" style="v" sid="REV 8:2" />ता मे तीहया ह़ातोव ह़रगदुत ने देख्‌यो जे भगवान अगळ उबा रेय, अने तीमने ह़ात फेपार्‌या आप्‌या।<verse eid="REV 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 8:3" />अने अळतेण एक अळी ह़रगदुत ह़ोना नु धुप देवा नु ठाहरु लीन आयो, अने वेदी नी ह़ाते जाय्‌न उबो हयो; अने तीमने घणो धुप आप्‌यो के आखा भगवान ना चोखला माणहु नी वीन्‌ती नी ह़ाते ह़ोना नी तीहयी वेदी पोर, जे राजगादी नी अगळ से चड़ावे।<note caller="+" style="x"><char style="xo" closed="false">8:3 </char><char style="xt" closed="false"><ref loc="AMO 9:1">आमोस 9:1</ref>; <ref loc="EXO 30:2">नीरगमन 30:2</ref>,<ref loc="EXO 30:3">3</ref></char></note> <verse eid="REV 8:3" /><verse number="4" style="v" sid="REV 8:4" />तीहया धुप नो धुकरो भगवान ना चोखला माणहु नी वीन्‌ती भेळ ह़रगदुत ना हात सी भगवान नी अगळ पुग ज्‌यो। <verse eid="REV 8:4" /><verse number="5" style="v" sid="REV 8:5" /><note caller="+" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="REV 11:19">परकासीतवाक्‌य 11:19</ref>; <ref loc="REV 16:18">16:18</ref></char></note>अळतेण ह़रगदुत तीहया धुप देवा नु ठाहरु लेदो अने तीनी मे वेदी नु आक्‌ठु भर्‌यो अने धरती पोर नाख देदो। अने अळतेण वादळा नी गाज अने बोलु अने वीजळी नी चमक अने भुकम्‌प हयवा बाज ज्‌या।<note caller="+" style="x"><char style="xo" closed="false">8:5 </char><char style="xt" closed="false"><ref loc="LEV 16:12">लेव्‌यवेवस्‌था 16:12</ref>; <ref loc="EZK 10:2">यहेजकेल 10:2</ref>; <ref loc="EXO 19:16">नीरगमन 19:16</ref>; <ref loc="REV 11:19">परकासीतवाक्‌य 11:19</ref>; <ref loc="REV 16:18">16:18</ref></char></note><verse eid="REV 8:5" /></para>
  <para style="s">फेपार्‌या</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 8:6" />तत्‌यार तीहया ह़ात ह़रगदुत जीमनी पांह ह़ात फेपार्‌या हता तीमने वगाड़वा तीयार हया।<verse eid="REV 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 8:7" />पेन्‌लो ह़रगदुत फेपार्‌यु वगाड़्‌यो, अने ता गारा अने आक्‌ठु लोय मे भेसकायला पयदा हया, अने तीमने धरती पोर उन्‌दा वाळ देदो।<note caller="+" style="x"><char style="xo" closed="false">8:7 </char><char style="xt" closed="false"><ref loc="EXO 9:23-25">नीरगमन 9:23-25</ref>; <ref loc="EZK 38:22">यहेजकेल 38:22</ref></char></note> अने धरती नो एक तीसरो खुणो धप ज्‌यो, अने झाड़का नो एक तीसरो खुणो धप ज्‌यो, अने आखो लील्‌लो चारो बी रोखड़ो हय ज्‌यो।<verse eid="REV 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 8:8" />अने अळतेण बीजो ह़रगदुत तीनु फेपार्‌यु वगाड़्‌यो, ता मोट्‌ला बड़ान तेवी चीज दर्‌या मे नाख्‌यो, अने दर्‌या नो एक तीसरो खुणो लोय मे बदल ज्‌यो। <verse eid="REV 8:8" /><verse number="9" style="v" sid="REV 8:9" />अने दर्‌या ना तीन खुणा मे गेथा एक खुणा ना पाणी मे रेवा वाळा जीव मर ज्‌या, अने तीन खुणा मे गेथा एक खुणा ना ढुंड्‌या बी खत्‌तम हय ज्‌या।<verse eid="REV 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 8:10" />अने अळतेण तीसरो ह़रगदुत तीनु फेपार्‌यु वगाड़्‌यो, एक मोट्‌लो तारो जे कंदील ने तेम धपत्‌लो, ह़रगे गेथो टुट्‌यो,<note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="ISA 14:12">यसाया 14:12</ref></char></note> अने नंद्‌या ना तीन खुणा मे गेथो एक खुणा पोर अने पाणी ना झोरु पोर जाय पड़्‌यो। <verse eid="REV 8:10" /><verse number="11" style="v" sid="REV 8:11" />आहया तारा नु नाम “कड़वलो तारो” हतु; अने तीन खुणा मे गेथु एक खुणा नु पाणी कड़वाट मे बदली ज्‌यु,<note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="JER 9:15">यीरम्‌या 9:15</ref></char></note> अने घण ढेरका माणहु पाणी पीवा सी मर ज्‌या, काहाके पाणी कड़वु हय जेलु हतु।<verse eid="REV 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 8:12" />जत्‌यार चोवथो ह़रगदुत तीनु फेपार्‌यु वगाड़्‌यो, ता तीन खुणा मे गेथा दाहड़ु ना एक खुणा पोर अने तीनी भेळ चांद ना एक खुणा पोर, अने तारा ना एक खुणा पोर गरा आयी, करीन तीमनो एक खुणो अंदारो हय ज्‌यो अने दाहड़ु ना एक खुणा मे वीजाळु नी र्‌यु, तीना कारण सी एक खुणो दाड़ो अने एक खुणो रात अंदारलु मे डुब ज्‌या।<note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="ISA 13:10">यसाया 13:10</ref>; <ref loc="EZK 32:7">यहेजकेल 32:7</ref>; <ref loc="JOL 2:10">योएल 2:10</ref>,<ref loc="JOL 2:31">31</ref>; <ref loc="JOL 3:15">3:15</ref></char></note><verse eid="REV 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 8:13" />जत्‌यार मे अळी देख्‌यो, ता वादळु नी वच मे घुवड़ ने उडते अने उचा बोलु सी आहयु केते ह़मळ्‌यो, “तीहया तीन ह़रगदुत ना फेपार्‌या ना कारण सी जीमनु वगाड़वा नु हजु री र्‌यु, धरती पोर रेवा वाळा पोर गरा आय पड़े, गरा आय पड़े, गरा आय पड़े!”<verse eid="REV 8:13" /></para>
  <chapter eid="REV 8" />
  <chapter number="9" style="c" sid="REV 9" />
  <para style="p">
    <verse number="1" style="v" sid="REV 9:1" />जत्‌यार पांचवो ह़रगदुत तीनु फेपार्‌यु वगाड़्‌यो, ता मे ह़रगे गेथो एक तारो धरती पोर पड़ते देख्‌यो, तीहया तारा ने पताळ खाडा नी कुची आप्‌यो। <verse eid="REV 9:1" /><verse number="2" style="v" sid="REV 9:2" />तीहयो तारो तीहयी कुची सी पताळ खाडा ने उगाड़्‌यो, अने तीनी मे गेथो मोट्‌ला चुला मे धुकरो उडे हेम धुकरो उडतो हतो,<note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="GEN 19:28">उबजणाय कीताप 19:28</ref></char></note> अने खाडा ना धुकरा सी दाहड़ु अने वाहळु घण-जबर काळु पड़ ज्‌यु। <verse eid="REV 9:2" /><verse number="3" style="v" sid="REV 9:3" />तीहया धुकरा मे गेथा धरती पोर टीड्‌या नीकळ्‌या,<note caller="+" style="x"><char style="xo" closed="false">9:3 </char><char style="xt" closed="false"><ref loc="EXO 10:12-15">नीरगमन 10:12-15</ref></char></note> अने तीमने वीसान तेवी सक्‌ती आप्‌यो। <verse eid="REV 9:3" /><verse number="4" style="v" sid="REV 9:4" />तीमने केदो नी ते धरती ना चारा ने, अने नी लील्‌ला झाड़का ने, अने नी काना झाड़का ने नुकसान करे, तीहया माणहु नु एतरुत नुकसान करो जीमना नींडाळ्‌ळा पोर भगवान नो सीलटप्‌पो<note caller="+" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="EZK 9:4">यहेजकेल 9:4</ref></char></note> नी हय। <verse eid="REV 9:4" /><verse number="5" style="v" sid="REV 9:5" />तीहया टीड्‌या ने हक आप्‌यो: के तीहया माणहु ने मारवा ते नी पण पांच मयना तक वेला पाड़े अने तीमनी वेला एवी हती जेम वीसो चाय देय ने माणेह ने हये। <verse eid="REV 9:5" /><verse number="6" style="v" sid="REV 9:6" />तीहया पांच मयना मे माणहु मोत ने मरवा करीन ह़ोदहे अने तीमने नी जड़े; अने मरवा नी हेर करहे, पण मोत तीमनी गेथी सेटी नाहे।<note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="JOB 3:21">अय्‌युब 3:21</ref>; <ref loc="JER 8:3">यीरम्‌या 8:3</ref></char></note><verse eid="REV 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 9:7" />अने तीहया टीड्‌या झुमायवा करीन तीयार करला घोड़ान तेवा देखायता हता,<note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="JOL 2:4">योएल 2:4</ref></char></note> अने तीमना मुंडा पोर ह़ोना नी पागड़ीन तेवु हतु, अने तीमना मोडा माणहु ना मोडान तेवा हता। <verse eid="REV 9:7" /><verse number="8" style="v" sid="REV 9:8" />तीमना नीम्‌बाळा बयरा ना नीम्‌बाळान तेवा हता, अने तीमना दात नाहर ना दात ने तेवा हता। <verse eid="REV 9:8" /><verse number="9" style="v" sid="REV 9:9" />तीहया लुहड़ा ह़रकी ढाळ पेरला हता; अने तीमना पाखड़ा नी अवाज आसवी हती जेम घण ढेरका घोड़ागाड्‌या जे झुमायवा जाय्‌न दवड़ेन वागे तेवी हती। <verse eid="REV 9:9" /><verse number="10" style="v" sid="REV 9:10" />तीमनी पुछड़ी वीसा ना ह़ुळान तेवी हती, अने तीहया पुछड़ा मे माणहु ने पांच मयना लग वेला पाड़वा नी सक्‌ती हती। <verse eid="REV 9:10" /><verse number="11" style="v" sid="REV 9:11" />पताळ खाडा नो दुत तीमनो राजो हतो; तीमनु नाम ईब्‌रानी मे अबद्‌दोन<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">मतलब खत्‌तम</char></note>, अने युनानी भासा ने अपुलयोन<note caller="+" style="f"><char style="fr" closed="false">9:11 </char><char style="ft" closed="false">मतलब खत्‌तम</char></note> से। जीनु मतलब “खत्‌तम करन्‌यो” से।<verse eid="REV 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 9:12" />पेल्‌नी मोट्‌ली वेला जत री, देखो, हाव आनी पसळ बीजी बे वेला अळी आव्‌वा वाळी से।<verse eid="REV 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 9:13" />अळतेण छटवो ह़रगदुत तीनु फेपार्‌यु वगाड़्‌यो ता ह़ोना नी वेदी जे भगवान नी अगळ से तीना ह़ींगड़ा मे गेथी एवी अवाज ह़मळ्‌यो,<note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="EXO 30:1-3">नीरगमन 30:1-3</ref></char></note> <verse eid="REV 9:13" /><verse number="14" style="v" sid="REV 9:14" />मान लेवो कानो छटवा ह़रगदुत ने, जीनी पांह फेपार्‌यु हतु, की र्‌यो, “तीहया च्‌यार ह़रगदुत ने जे मोट्‌ली नंदी फुरात ने तां बंदाय र्‌या, सोड़ देवो।” <verse eid="REV 9:14" /><verse number="15" style="v" sid="REV 9:15" />च्‌यारोव ह़रगदुत ने सोड़ देदा, तीहया तीहयीत टेम, तीहयात दाड़ा, अने तीहयात मयना, अने तीहयात साल जुगु तीयार करला हता। के तीहया तीसरा माणहु ना वाटा ने मार नाखे। <verse eid="REV 9:15" /><verse number="16" style="v" sid="REV 9:16" />तीमनी पाल्‌टी मे बहीन जवा वाळा नी गीनती वीह़ करोड़ हती; मे तीमनी गीनती ह़मळ्‌यो। <verse eid="REV 9:16" /><verse number="17" style="v" sid="REV 9:17" />मने आहया दरसन मे घोड़ा अने तीमनी पोर एवा बहण्‌या देखाया, जीमनी ढाळ आक्‌ठु, अने बारुद ने तेवी हती, अने तीहया घोड़ा ना मुंडा नाहर ना मुंडा ह़रका हता: अने तीमना मोडा मे गेथु आक्‌ठु, बारुद, अने धुकरो, नीकळतो हतो। <verse eid="REV 9:17" /><verse number="18" style="v" sid="REV 9:18" />आहयी तीनोव गरा सी; मतलब आक्‌ठु, धुकरो, अने बारुद सी, जे तीना मोडा मे गेथा नीकळता हता, एक माणहु ना तीसरो वाटा ने मार नाख्‌यो। <verse eid="REV 9:18" /><verse number="19" style="v" sid="REV 9:19" />काहाके तीहया घोड़ा नी ताखत तीमना मोडा मे अने पुछड़ा मे हती; आनीन करते के तीमना पुछड़ा गड़हान तेवा हता, अने तीहया पुछड़ा ना मुंडा बी हता अने आमनीत सी तीहया माणहु ने वेला पाड़ता हता।<verse eid="REV 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 9:20" />अने बीजा माणहु जे आहया मारन्‌या सी बी नी मर्‌या, अने आह़फा ना हातु सी बणावला चीजु सी मन नी फीरव्‌या, अने भुत नी, अने ह़ोना, चांदी, अने काच, दगड़ा, अने लाकड़ा ना मुरत्‌या नी पुंजा नी करे, जे नी देखे, नी ह़मळे अने नी चाल सके। <verse eid="REV 9:20" /><verse number="21" style="v" sid="REV 9:21" />अने जे खुन, अने बड़वाय अने छीनाळु, अने चोरी तीहया करला, तीहया आखा कामु सी मन नी फीराया।<verse eid="REV 9:21" /></para>
  <chapter eid="REV 9" />
  <chapter number="10" style="c" sid="REV 10" />
  <para style="s">ह़रगदुत अने नान्‌ली कीताप</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 10:1" />अळतेण मे एक अळी जोरभर्‌या ह़रगदुत ने ह़रगे गेथो उतरते देख्‌यो। तीहयो वादळु ने ओड र्‌यो हतो, अने तीना मुंडा नी आड़े-धेड़े एक बाम हतो। तीनु मोडु दाहड़ुन तेवु अने तीना पोगु आक्‌ठु ना खम्‌बा ह़रका हता। <verse eid="REV 10:1" /><verse number="2" style="v" sid="REV 10:2" />तीना हात मे एक नान्‌ली कीताप उगड़ली हती। तीनो जमणो पोग दर्‌या मे अने डाखर्‌यो पोग धरती पोर मेक्‌यो, <verse eid="REV 10:2" /><verse number="3" style="v" sid="REV 10:3" />अने एवी उची अवाज सी आड़्‌यो, जेम नाहर आड़े; अने जत्‌यार तीहयो आड़्‌यो ता वादळा नी गाज ना ह़ात बोलु ह़मळाया। <verse eid="REV 10:3" /><verse number="4" style="v" sid="REV 10:4" />जत्‌यार ह़ातोव गाज ना बोलु ह़मळाय ज्‌या, ता मे लीखवा तीयार हय जेलो; पण मे ह़रगे गेथी आहयी अवाज ह़मळ्‌यो, “जे वात तीहयी गाज ना बोलु सी ह़मळ्‌यो तीने सील लगाड़ीन मन मे ह़ताड़ीन राख,<note caller="+" style="f"><char style="fr" closed="false">10:4 </char><char style="ft" closed="false">तीमनी पोर छापो लगाड़ दे</char></note> अने ना लीखे।”<verse eid="REV 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 10:5" />जे ह़रगदुत मे धरती अने दर्‌या पोर उबो हय रेलो देखलो, तीहयो तीनो जमण्‌यो हात ह़रग भणी कर्‌यो, <verse eid="REV 10:5" /><verse number="6" style="v" sid="REV 10:6" />अने जे जलमको जीवत्‌लो से, अने जे ह़रग ने अने जे कंय ह़रग मे से, अने धरती ने अने जे कंय धरती पोर से, अने दर्‌या अने जे कंय दर्‌या मे बण्‌यु, तीनीत ह़ाम खाय्‌न केदो, “हाव ते अळी वार नी लागे<note caller="+" style="f"><char style="fr" closed="false">10:6 </char><char style="ft" closed="false">टेम नी रेय</char></note>। <verse eid="REV 10:6" /><verse number="7" style="v" sid="REV 10:7" />पण जत्‌यार ह़ातवा ह़रगदुत ने ह़मळवा नी टेम आवहे मतलब तीहयो तीनु फेपार्‌यु वगाड़वा वाळो रेहे, ता भगवान नी ह़तायली योजना पुरी हय जहे। जीनी खुस-खबर तीहयो आह़फा ना चाकर्‌या भगवान वगे गेथा केण्‌या माणहु ने आपलो पुरी हयहे।”<verse eid="REV 10:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 10:8" />जे बोल ह़मळावा वाळा ने मे ह़रगे गेथो बोलते ह़मळ्‌यो, तीहयो अळी मारी ह़ाते वात करवा बाज ज्‌यो, अने केदो, “जा, जे ह़रगदुत धरती पोर अने दर्‌या मे उबो हय र्‌यो, तीना हात मे वाळी उगड़ली कीताप ली ले।”<verse eid="REV 10:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 10:9" />अने मे ह़रगदुत ने तां जाय्‌न केदो, “आहयी नान्‌ली कीताप मने आप दे।” तीहयो मने केदो, “ले, आने खाय ले; आहयी तारु पेट खाटु ते करहे, पण तारा मोडा मे मोद ने तेवी गळ्‌ळी लागहे।”<verse eid="REV 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 10:10" />मे तीहयी नान्‌ली कीताप तीहया ह़रगदुत पांह गेथी मांगीन खाय ज्‌यो। तीहयी मारा मोडा मे मोद ने तेवी ते लागी, पण जत्‌यार मे तीने खाय ज्‌यो, ता मारु पेट खाटु हय ज्‌यु।<note caller="+" style="x"><char style="xo" closed="false">10:10 </char><char style="xt" closed="false"><ref loc="EZK 2:8-3:3">यहेजकेल 2:8–3:3</ref></char></note> <verse eid="REV 10:10" /><verse number="11" style="v" sid="REV 10:11" />ता मने केदो, “तने घणा माणहु ने, अने जात्‌या ने, अने बोली वाळा ने अने राजा ना बारा मे पासी भगवान वगे गेथी वात केवा पड़हे।”<verse eid="REV 10:11" /></para>
  <chapter eid="REV 10" />
  <chapter number="11" style="c" sid="REV 11" />
  <para style="s">बे गवा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 11:1" />अने अळतेण मने मापवा करीन एक ह़ोटी आप्‌यो, अने एक जणो केदो, “उठ, भगवान ना मंदीर अने वेदी ने माप ले, अने तीनी मे भक्‌ती करवा वाळा नी गीनती कर ले।<note caller="+" style="x"><char style="xo" closed="false">11:1 </char><char style="xt" closed="false"><ref loc="EZK 40:3">यहेजकेल 40:3</ref>; <ref loc="ZEC 2:1">जकर्‌याह 2:1</ref>,<ref loc="ZEC 2:2">2</ref></char></note> <verse eid="REV 11:1" /><verse number="2" style="v" sid="REV 11:2" /><note caller="+" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="LUK 21:24">लुका 21:24</ref></char></note>पण मंदीर नु बारलु आंगणु रेवा दे; तीने ना मापे काहाके तीहयु आड़जात्‌या माणहु ने आप मेक्‌यु, अने तीहयु चोखलु ह़ेर ने चाळीह़ ने बे मयना तक पोगु तळे रोंदळहे।<note caller="+" style="x"><char style="xo" closed="false">11:2 </char><char style="xt" closed="false"><ref loc="LUK 21:24">लुका 21:24</ref></char></note> <verse eid="REV 11:2" /><verse number="3" style="v" sid="REV 11:3" />अने मे मारा बे गवा ने पुरो हक आपही के तीहया एक हजार बे ह़ो साट दाड़ा तक भगवान वगे गेथी वात केहे अने तीहया ठेला ह़रका लुगड़ा पेरहे।”<verse eid="REV 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 11:4" />आहया तीहयात बे जेतुन ना झाड़ अने दीवा मेलवा ना खुटा से, जे धरती ना मालीक अगळ उबा हय रेत्‌ला।<note caller="+" style="x"><char style="xo" closed="false">11:4 </char><char style="xt" closed="false"><ref loc="ZEC 4:3">जकर्‌याह 4:3</ref>,<ref loc="ZEC 4:11-14">11-14</ref></char></note> <verse eid="REV 11:4" /><verse number="5" style="v" sid="REV 11:5" />कदीम कोय तीमनु नुकसान करवा हींडे, ता तीमना मोडा मे गेथु आक्‌ठु नीकळीन तीमना वेरी ने रोखड़ो बणाय देय; अने कदीम कोय तीमनु नुकसान करवा हींडे, ता ह़ाचलीन आहयीत रीते मार देहे। <verse eid="REV 11:5" /><verse number="6" style="v" sid="REV 11:6" />तीमनी पांह हक से के वादळु ने बंद करे, के तीमनी भगवान वगे गेथी वात केवा ना दाड़ा मे पाणी नी पड़े; अने तीमने आखा पाणी ना झोर पोर हक से के तीहया तीमने लोय मे बदले, अने तीमनी पांह आहयो बी हक से के जत्‌यार तीमनु मन हये तत्‌यार तीहया धरती पोर आखी भाती नी गरा लावे।<note caller="+" style="x"><char style="xo" closed="false">11:6 </char><char style="xt" closed="false"><ref loc="1KI 17:1">1 राजा 17:1</ref>; <ref loc="EXO 7:17-19">नीरगमन 7:17-19</ref>; <ref loc="1SA 4:8">1 समुवेल 4:8</ref></char></note><verse eid="REV 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 11:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:7 </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:5-7">परकासीतवाक्‌य 13:5-7</ref>; <ref loc="REV 17:8">17:8</ref></char>
    </note>जत्‌यार तीहया तीमनी गवाय दी देहे, ता तीहयु जंगली जानवर जे पताळ खाडा मे गेथु नीकळहे, तीमनी ह़ाते झुमाय्‌न तीमने हराय्‌न तीमने मार नाखहे।<note caller="+" style="x"><char style="xo" closed="false">11:7 </char><char style="xt" closed="false"><ref loc="DAN 7:7">दानीयल 7:7</ref>; <ref loc="GEN 13:5-7">उबजणाय कीताप 13:5-7</ref>; <ref loc="GEN 17:8">17:8</ref></char></note> <verse eid="REV 11:7" /><verse number="8" style="v" sid="REV 11:8" />अने तीमना धोड़ तीहया मोट्‌ला ह़ेर ना चोवराया पोर पड़ रेहे, आहयु ह़ेर सेलाणी ना रुप सी सदोम अने मीस्‌र केवाये, आञेत ह़ारीक तीमना मालीक ने बी कुरुस पोर चड़ावीन मारला हता।<note caller="+" style="x"><char style="xo" closed="false">11:8 </char><char style="xt" closed="false"><ref loc="ISA 1:9">यसाया 1:9</ref>,<ref loc="ISA 1:10">10</ref></char></note> <verse eid="REV 11:8" /><verse number="9" style="v" sid="REV 11:9" />अने आखा देस अने आखी बोली वाळा अने आखी जाती ना माणहु तीमना धोड़ ने साड़ी तीन दाड़ा तक देखता रेहे, अने तीमना धोड़ु ने मड़ाट्‌या मे कोयने नी वगे करवा देय। <verse eid="REV 11:9" /><verse number="10" style="v" sid="REV 11:10" />धरती पोर रेवा वाळा तीहया मर ज्‌या करीन घण-जबर खुस हयहे, अने एक बीजान तां भेट ली मोकलहे, काहाके आहया बेम भगवान वगे गेथा केण्‌या माणहु धरती पोर वाळा माणहु ने घण-जबर वेला पाड़ला। <verse eid="REV 11:10" /><verse number="11" style="v" sid="REV 11:11" />पण साड़ी तीन दाड़ान बाद भगवान ने तां गेथी जीवाय नी ह़ाह़ तीमनी मे आय लागी, अने तीहया उबा हय ज्‌या, अने तीमने देखवा वाळा घण-जबर बीह ज्‌या।<note caller="+" style="x"><char style="xo" closed="false">11:11 </char><char style="xt" closed="false"><ref loc="EZK 37:10">यहेजकेल 37:10</ref></char></note> <verse eid="REV 11:11" /><verse number="12" style="v" sid="REV 11:12" />ता तीहया बे भगवान वगे गेथा केण्‌या माणहु ने एक ह़रगे गेथो मोट्‌लो बोल ह़मळायो, “आञे उपर आवती रेवो!” आहयु ह़मळीन तीहया वादळु पोर बहीन उपर जत र्‌या अने तीमने उपर जते तीमना वेरी बी देख्‌या।<note caller="+" style="x"><char style="xo" closed="false">11:12 </char><char style="xt" closed="false"><ref loc="2KI 2:11">2 राजा 2:11</ref></char></note> <verse eid="REV 11:12" /><verse number="13" style="v" sid="REV 11:13" /><note caller="+" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="REV 6:12">परकासीतवाक्‌य 6:12</ref>; <ref loc="REV 16:18">16:18</ref></char></note>ता तीहयीत टेमे एक मोट्‌लो भुकम्‌प आयो, अने ह़ेर नो दसवो वाटो ओदर ज्‌यो; अने तीहया भुकम्‌प सी ह़ात हजार माणहु मर ज्‌या, अने जे बच ज्‌या तीहया आखा बीही ज्‌या अने ह़रग वाळा भगवान ने घणो वारु कीन बड़ाय करवा बाज ज्‌या।<note caller="+" style="x"><char style="xo" closed="false">11:13 </char><char style="xt" closed="false"><ref loc="GEN 6:12">उबजणाय कीताप 6:12</ref> </char></note><verse eid="REV 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 11:14" />बीजी गरा जत री, अने देखो, तीसरी गरा सोटीत आव्‌वा वाळी से।<verse eid="REV 11:14" /></para>
  <para style="s">ह़ातवु फेपार्‌यु</para>
  <para style="p">
    <verse number="15" style="v" sid="REV 11:15" />जत्‌यार ह़ातवो ह़रगदुत तीनु फेपार्‌यु वगाड़्‌यो, ता वादळा मे घणी जबर अवाज हयवा बाज ज्‌यी, अने तीहयी केती हती: “हाव कळी पोर राज करवा नी ताखत अमारा मालीक पांह से। अने तीहया मसी मे से, अने तीहयोत जलमको राज करहे!”<note caller="+" style="x"><char style="xo" closed="false">11:15 </char><char style="xt" closed="false"><ref loc="EXO 15:18">नीरगमन 15:18</ref>; <ref loc="DAN 2:44">दानीयल 2:44</ref>; <ref loc="DAN 7:14">7:14</ref>,<ref loc="DAN 7:27">27</ref></char></note> <verse eid="REV 11:15" /><verse number="16" style="v" sid="REV 11:16" />ता वीह़ ने च्‌यारोव डायला जे भगवान अगळ आह़फा-आह़फाम नी राजगादी पोर बह र्‌या हता, मोडा ना भरहे पड़ीन भगवान नी बड़ाय कर्‌या, <verse eid="REV 11:16" /><verse number="17" style="v" sid="REV 11:17" />अने आहयु केवा बाज ज्‌या,</para>
  <para style="q1" vid="REV 11:17">“जोरभर्‌या मालीक भगवान, जे से अने जे हतो,</para>
  <para style="q1" vid="REV 11:17">आमु तने घणो वारु से कीया के तु</para>
  <para style="q2" vid="REV 11:17">तारी मोट्‌ली ताखत सी राज करवा सुरु करलो से।<verse eid="REV 11:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="REV 11:18" />आखी जाती ना माणहु रीह कर्‌या,</para>
  <para style="q2" vid="REV 11:18">पण तारी रीह आय लागी,</para>
  <para style="q2" vid="REV 11:18">अने तीहयी टेम आय लागी के मरला नो नीयाव करे,</para>
  <para style="q1" vid="REV 11:18">अने तारा चाकर्‌या भगवान वगे गेथा केण्‌या माणहु अने</para>
  <para style="q2" vid="REV 11:18">भगवान ना चोखला माणहु ने</para>
  <para style="q2" vid="REV 11:18">अने तीहया नान्‌ला-मोट्‌ला ने जे तारा नाम सी बीहे ईलाम आपे,</para>
  <para style="q1" vid="REV 11:18">अने जे धरती ने खत्‌तम कर र्‌या तीमने खत्‌तम करे!”<note caller="+" style="x"><char style="xo" closed="false">11:18 </char><char style="xt" closed="false"><ref loc="PSA 2:5">भजन सहीता 2:5</ref>; <ref loc="PSA 11:5">11:5</ref>; <ref loc="PSA 115:13">115:13</ref></char></note><verse eid="REV 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 11:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:19 </char>
      <char style="xt" closed="false">
        <ref loc="REV 8:5">परकासीतवाक्‌य 8:5</ref>; <ref loc="REV 16:18">16:18</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="REV 16:21">परकासीतवाक्‌य 16:21</ref>
      </char>
    </note> ता जे भगवान नो मंदीर ह़रग मे से, तीने उगड़्‌या, अने तीहया मंदीर मे तीना वायदा नु पेटारु देखाव पड़्‌यु; अने वीजळी अने अवाज अने वादळु नी गाज अने भुकम्‌प हया अने मोट्‌ला गारा पड़्‌या।<note caller="+" style="x"><char style="xo" closed="false">11:19 </char><char style="xt" closed="false"><ref loc="GEN 8:5">उबजणाय कीताप 8:5</ref> </char></note><verse eid="REV 11:19" /></para>
  <chapter eid="REV 11" />
  <chapter number="12" style="c" sid="REV 12" />
  <para style="s">बयर अने अजगर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 12:1" />अळतेण वादळा मे एक मोट्‌ली सेलाणी देखाव पड़ी, मतलब एक बयर जे दाहड़ु ने ओड री हती, अने चांद तीना पोग तळे हतो, अने तीना मुंडा पोर बारे तारा नी पागड़ी हती। <verse eid="REV 12:1" /><verse number="2" style="v" sid="REV 12:2" />तीहयी भारेपोगे हती, अने आड़ती हती, काहाके तीहयी पोखड़ायवा नी टेमे ना दुख मे हती।<verse eid="REV 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 12:3" />एक अळी मोट्‌ली सेलाणी वादळा मे देखाव पड़ी; अने देखो, एक मोट्‌लो रात्‌लो अजगर हतो, जीना ह़ात मुंडा अने दह़ ह़ींगड़ा हता, अने तीना ह़ातोव मुंडा पोर एक-एक पागड़ी हती।<note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="DAN 7:7">दानीयल 7:7</ref></char></note> <verse eid="REV 12:3" /><verse number="4" style="v" sid="REV 12:4" />तीनु पुछड़ु वादळा मे ना तीन खुणा मे गेथा एक खुणा ना तारा ने हापकीन धरती पोर पाड़ देदु।<note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="DAN 8:10">दानीयल 8:10</ref></char></note> तीहयो अजगर तीहयी बयर अगळ जे पोखड़ायवा वाळी हती, उबो हयो के जत्‌यार तीहयी पोखड़ाये ता तीहयु सोरु ने गळ जाय। <verse eid="REV 12:4" /><verse number="5" style="v" sid="REV 12:5" />अळतेण तीहयी बयर एक सोरु ने पयदा करी जे सोरो हतो, अने आहया सोरा ने लुहड़ा नो डंडो लीन आखी जाती पोर राज करनु हतु, पण तीहयु सोरु ने तत्‌यारुत उचलीन भगवान अने तीनी राजगादी अगळ लीजती र्‌या;<note caller="+" style="x"><char style="xo" closed="false">12:5 </char><char style="xt" closed="false"><ref loc="ISA 66:7">यसाया 66:7</ref>; <ref loc="PSA 2:9">भजन सहीता 2:9</ref></char></note> <verse eid="REV 12:5" /><verse number="6" style="v" sid="REV 12:6" />अने तीहयी बयर तीहया जंगल मे नाह ज्‌यी जां ह़ारीक भगवान नी लारे तीनी जुगु एक जागो तीयार करलो हतो, के तां ह़ारीक तीहयी बयर ने एक हजार बे ह़ोव साट दाड़ा तक ह़माळे।<verse eid="REV 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 12:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:7 </char>
      <char style="xt" closed="false">
        <ref loc="JUD 1:9">यहुदा 1:9</ref>
      </char>
    </note>अळतेण ह़रग मे झगड़ो हयो, मीकाईल अने तीना ह़रगदुत अजगर ह़ाते झुमायवा नीकळ्‌या; अने अजगर अने तीना ह़रगदुत तीमनी ह़ाते झुमाया,<note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="DAN 10:13">दानीयल 10:13</ref>,<ref loc="DAN 10:21">21</ref>; <ref loc="DAN 12:1">12:1</ref>; <ref loc="JUD 1:9">यहुदा 9</ref></char></note> <verse eid="REV 12:7" /><verse number="8" style="v" sid="REV 12:8" />पण तीहया टेक नी सक्‌या, एतरे तीमनी जुगु ह़रग मे रेवा नो हक नी र्‌यो। <verse eid="REV 12:8" /><verse number="9" style="v" sid="REV 12:9" /><note caller="+" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="LUK 10:18">लुका 10:18</ref></char></note>अने तीहया अजगर ने हेटो धकल देदा, आहयो तीहयोत पेल्‌नो गड़हो से, जीने भुतड़ो अने वेरी केवाड़े, आहयो आखी धरती पोर वाळा ने भटकाड़न्‌यो से, तीने अने तीना दुत ने धरती पोर नाख देदा।<note caller="+" style="x"><char style="xo" closed="false">12:9 </char><char style="xt" closed="false"><ref loc="GEN 3:1">उबजणाय कीताप 3:1</ref>; <ref loc="LUK 10:18">लुका 10:18</ref></char></note><verse eid="REV 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 12:10" />अळतेण मे ह़रगे गेथी एक उची अवाज आवते ह़मळ्‌यो, “हाव अमारा भगवान नो छुटकारो अने ताखत अने राज अने तीना मसी नो हक उजन्‌तो हयलो से, काहाके अमारा भाय-बेन्‌या पोर गुनो लगाड़वा वाळो, जे रात-दाड़ो अमारा भगवान अगळ तीमनी पोर गुनो लगाड़्‌या करतो हतो,<note caller="+" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="JOB 1:9-11">अय्‌युब 1:9-11</ref>; <ref loc="ZEC 3:1">जकर्‌याह 3:1</ref></char></note> हेटो पाड़ देदा। <verse eid="REV 12:10" /><verse number="11" style="v" sid="REV 12:11" />तीहया गाडरु ना लोय ना कारण सी अने तीमनी गवाय ना बोल ना कारण सी तीनी सी जीक ज्‌या, अने तीहयो आह़फा ना जीव ने मोंगाळ्‌ळो नी जाण्‌यो आञे तक के मोत ने बी वेठ लेदो। <verse eid="REV 12:11" /><verse number="12" style="v" sid="REV 12:12" />करीन ए ह़रग अने ह़रग मे रेवा वाळा, खुस हयो, पण ए धरती, अने दर्‌या, तमारी पोर गरा आय पड़े! काहाके भुतड़ो<note caller="+" style="f"><char style="fr" closed="false">12:12 </char><char style="ft" closed="false">ईबलीस</char></note> घण-जबर खीजवाय र्‌यो अने तमारीन्‌तां उतर जेलो से, काहाके तीहयो जाणे के तीनी पांह थोड़ीकेत टेम री, री।”<verse eid="REV 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 12:13" />जत्‌यार अजगर ना ह़मज मे आयु के तीने धरती पोर हेटो धकल देदा, ता तीहयो तीहयी बयर ने जे सोरो पयदा करली, तीनी पसळ पड़्‌यो। <verse eid="REV 12:13" /><verse number="14" style="v" sid="REV 12:14" />पण तीहयी बयर ने मोट्‌ला घुवड़ ना बे पाखड़ा आप्‌या के गड़हा नी अगळ गेथी उडीन जंगल मे तीहया जागे जत रेय, जां ह़ारीक तीने अजगर ना हमला सी ह़माळीन राखवा मे साड़ी तीन साल तक तीनी देख-रेख हये।<note caller="+" style="x"><char style="xo" closed="false">12:14 </char><char style="xt" closed="false"><ref loc="DAN 7:25">दानीयल 7:25</ref>; <ref loc="DAN 12:7">12:7</ref></char></note> <verse eid="REV 12:14" /><verse number="15" style="v" sid="REV 12:15" />अने गड़हो तीहयी बयर पसळ आह़फा ना मोडा मे गेथु नंदीन तेम पाणी वयाड़्‌यो के तीने आहयी नंदी मे वयाड़ देय। <verse eid="REV 12:15" /><verse number="16" style="v" sid="REV 12:16" />पण धरती तीहयी बयर नी मदत करी, अने धरती मोडु उगाड़ीन तीहयी नंदी ने जे अजगर आह़फा ना मोडा मे गेथो वयाड़लो पी जी। <verse eid="REV 12:16" /><verse number="17" style="v" sid="REV 12:17" />अळतेण तीहयो अजगर बयर पोर घण-जबर रीह कर पड़्‌यो, अने बयर नी बीजी अवल्‌यात नी ह़ाते जे भगवान ना हुकम माने अने ईसु नी गवाय देवा टेकला से, तीमनी ह़ाते झुमायवा करीन चाल पड़्‌यो। <verse eid="REV 12:17" /><verse number="18" style="v" sid="REV 12:18" />अने गड़हो दर्‌या नी धेकड़ पोर जाय्‌न उबो हय ज्‌यो।<verse eid="REV 12:18" /></para>
  <chapter eid="REV 12" />
  <chapter number="13" style="c" sid="REV 13" />
  <para style="s">जंगली जानवर</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 13:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:1 </char>
      <char style="xt" closed="false">
        <ref loc="REV 17:3">परकासीतवाक्‌य 17:3</ref>,<ref loc="REV 17:7-12">7-12</ref></char>
    </note>ता मे एक जंगली जानवर ने दर्‌या मे गेथो नीकळते देख्‌यो, जीना दह ह़ींगड़ा अने ह़ात मुंडा से। तीना ह़ींगड़ा पोर दह पागड़ी अने तीना मुंडा पोर भगवान ना वाक ना नाम लीखला हता।<note caller="+" style="x"><char style="xo" closed="false">13:1 </char><char style="xt" closed="false"><ref loc="DAN 7:3">दानीयल 7:3</ref>; <ref loc="GEN 17:3">उबजणाय कीताप 17:3</ref>,<ref loc="GEN 17:7-12">7-12</ref></char></note> <verse eid="REV 13:1" /><verse number="2" style="v" sid="REV 13:2" />जे जंगली जानवर मे देख्‌यो तीहयु चीतान तेवु हतु;<note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="DAN 7:4-6">दानीयल 7:4-6</ref></char></note> अने तीना पोगु भालुन तेवा हता, अने मोडु नाहर ने तेवु हतु। तीहयो अजगर आह़फा नी ताखत अने आह़फा नी राजगादी अने मोट्‌लो हक तीने आप देदो। <verse eid="REV 13:2" /><verse number="3" style="v" sid="REV 13:3" />मे तीना एक मुंडा पोर एवो घाव लागलो देख्‌यो मान लेवो के तीहयो मरवा वाळो से, अळतेण तीनो मार लेय एवो घाव वारु हय ज्‌यो, अने आखी धरती पोर वाळा माणहु वहरायता-वहरायता ते जानवर पसळ ज्‌या। <verse eid="REV 13:3" /><verse number="4" style="v" sid="REV 13:4" />अने माणहु अजगर नी पुंजा कर्‌या, काहाके तीहयो जंगली जानवर ने हक आप देदलो हतो, अने आहयु कीन जंगली जानवर नी पुंजा कर्‌या, “आहया जंगली जानवर ने तेवु कोय से? अने कोय आनी ह़ाते झुमाय सकहे?”<verse eid="REV 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 13:5" />मोट्‌ला बोलु बोलवा अने वाक काडवा तीने एक मोडु आप्‌यो, अने तीने चाळीह ने बे मयना तक काम करवा नो हक आप्‌यो। <verse eid="REV 13:5" /><verse number="6" style="v" sid="REV 13:6" />ता तीहयो भगवान नो वाक काडवा चालु कर देदो, तीहयो भगवान ना नाम अने जां तीहयो रेय, तीहया जागा नो अने ह़रग मे रेवा वाळा से, तीमनो वाक काडवा बाज ज्‌यो।<note caller="+" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="DAN 7:8">दानीयल 7:8</ref>,<ref loc="DAN 7:25">25</ref>; <ref loc="DAN 11:36">11:36</ref></char></note> <verse eid="REV 13:6" /><verse number="7" style="v" sid="REV 13:7" />तीने आहयो बी हक आप्‌यो के भगवान ना चोखला माणहु ना वीरोद मे झुमाये अने तीमने हराय देय,<note caller="+" style="x"><char style="xo" closed="false">13:7 </char><char style="xt" closed="false"><ref loc="DAN 7:21">दानीयल 7:21</ref></char></note> अने तीने एक-एक घोराणा अने माणहु अने बोली अने देस पोर हक आप्‌यो। <verse eid="REV 13:7" /><verse number="8" style="v" sid="REV 13:8" />धरती नी सुरुवात नी पेले गेथात जीमना नाम बादा चड़ावलु गाडरु नी जीवाय नी कीताप मे लीखला से,<note caller="+" style="x"><char style="xo" closed="false">13:8 </char><char style="xt" closed="false"><ref loc="PSA 69:28">भजन सहीता 69:28</ref></char></note> तीमने सोड़ीन आखा धरती पोर रेवा वाळा तीहया जंगली जानवर नी पुंजा करहे।<verse eid="REV 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 13:9" />जीमना कान्‌टा हय तीहया ह़मळी लेय: <verse eid="REV 13:9" /><verse number="10" style="v" sid="REV 13:10" />जे धरायवा वाळो से तीहयो धरायहे; जे तलवार सी मारहे, तीने बी तलवार सी मारहे। करीन भगवान ना चोखला माणहु ने धीरज अने भरहो राखवा जरुड़ी से। <note caller="+" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="JER 15:2">यीरम्‌या 15:2</ref>; <ref loc="JER 43:11">43:11</ref></char></note><verse eid="REV 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 13:11" />अळतेण मे एक अळी जानवर ने धरती मे गेथो नीकळते देख्‌यो, तीना गाडरुन तेवा बे ह़ींगड़ा हता, अने तीहयु अजगर ने तेम बोलत्‌लु। <verse eid="REV 13:11" /><verse number="12" style="v" sid="REV 13:12" />तीहयु तीहया पेल्‌ना जानवर नो पुरो हक तीनी अगळ काम मे लावतो हतो; धरती अने धरती पोर रेवा वाळा सी तीहया पेल्‌ना जंगली जानवर नी, जीनो मार लेय एवो घाव वारलो हय जेलो हतो, पुंजा करावतो हतो। <verse eid="REV 13:12" /><verse number="13" style="v" sid="REV 13:13" />तीहयो बीजो जीव मोटा-मोटा सेलाण्‌या देखाड़तो हतो, आञे तक के माणहु अगळ ह़रगे गेथो धरती पोर आक्‌ठु पाड़ देतो हतो। <verse eid="REV 13:13" /><verse number="14" style="v" sid="REV 13:14" />तीहया सेलाण्‌या नी कारण, जीमने तीहया जंगली जानवर नी अगळ देखाड़वा नो हक तीने आपलो हतो, तीहयो धरती पोर रेवा वाळा ने आहयी रीते भटकाड़तो हतो के अने धरती पोर रेवा वाळा ने केतो हतो जे जानवर ने तलवार लागली हती तीहयो जीव जेलो से, तीनी मुर्‌ती बणावो। <verse eid="REV 13:14" /><verse number="15" style="v" sid="REV 13:15" />तीने तीहया जानवर नी मुर्‌ती मे जीव नाखवा नो हक आप्‌यो के तीहया जंगली जानवर नी मुर्‌ती बोलवा बाज जाय, अने जेतरा माणहु तीहया जंगली जानवर नी मुर्‌ती नी पुंजा नी करे, तीमने मराय नाखे। <verse eid="REV 13:15" /><verse number="16" style="v" sid="REV 13:16" />तीहयु बीजु जानवर नान्‌ला-मोट्‌ला, मालदार-गरीब, छुट्‌ला-पावर्‌या, अने आखा माणहु ने मजबुर कर्‌यो के तीहया आह़फा-आह़फाम ना जमणा हात पोर नीता तीमना नींडाळे तीनो सीलटप्‌पो लगाड़े, <verse eid="REV 13:16" /><verse number="17" style="v" sid="REV 13:17" />के तीने सोड़ीन जीनी पोर छाप मतलब तीहया जानवर नु नाम नीता तीना नाम ना आकड़ा रेय, बीजु कोय बी लेणु-देणु नी कर सके।<verse eid="REV 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 13:18" />जीनी पांह अक्‌कल हय, तीहयो आहया जानवर ना आकड़ा नु मतलब नीकाळ लेय, काहाके आकड़ा काना माणहे ना नाम सी जोड़ायला से, तीना आकड़ा 666 से।<verse eid="REV 13:18" /></para>
  <chapter eid="REV 13" />
  <chapter number="14" style="c" sid="REV 14" />
  <para style="s">गाडरु अने तीना माणहु</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 14:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="REV 7:3">परकासीतवाक्‌य 7:3</ref>
      </char>
    </note>अळतेण मे भाळ्‌यो, अने देख्‌यो, तीहयु गाडरु सीयोन बड़ा पोर उबु हय र्‌यु, अने तीनी ह़ाते एक लाख चाळीह ने च्‌यार हजार माणहु से, जीना नींडाळा पोर तीनु अने तीना बाह नु नाम लीखलु से।<note caller="+" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EZK 9:4">यहेजकेल 9:4</ref>; <ref loc="GEN 7:3">उबजणाय कीताप 7:3</ref></char></note> <verse eid="REV 14:1" /><verse number="2" style="v" sid="REV 14:2" />अने ह़रगे गेथो मने एक एवो बोल ह़मळायो, जे पाणी नी घण ढेरकी धार अने वादळु नी गाज ने तेवो हतो, अने जे बोल मे ह़मळ्‌यो तीहयो एवो हतो जेम कोय तम्‌बुरा वगाड़वा वाळा तम्‌बुरो वगाड़ता हय। <verse eid="REV 14:2" /><verse number="3" style="v" sid="REV 14:3" />तीहया राजगादी अगळ अने च्‌यारोव जीव अने पेल्‌ना वारा ना माणहु नी अगळ एक नवलु गीत गाव्‌वा बाज र्‌या हता। तीहया एक लाख चाळीह ने च्‌यार हजार माणहु ने सोड़ीन, जे धरती पोर गेथा वेचाता लीन सोड़ावला हता, तीमने सोड़ीन कोय बी माणेह तीहयु गीत ने ह़ीक नी सकतु हतु। <verse eid="REV 14:3" /><verse number="4" style="v" sid="REV 14:4" />आहया तीहया एवा माणहु हता जे कानी बी बयर ह़ाते नी वीटळ्‌या, काहाके तीहया कुवारला हता; अने जां कंय गाडरु जतु हतु तीहया बी तीनीन तेमेत करता हता, आखा माणहु मे गेथा तीमने वेचाता लीन सोड़ावला हता, तीहया भगवान अने गाडरु जुगु फसल ना पेल्‌ना फोळ हता। <verse eid="REV 14:4" /><verse number="5" style="v" sid="REV 14:5" />तीमना मोडा मे गेथु कारु बी झुट नी नीकळ्‌यु, तीहया वण-गुनाळ्‌ळा से।<note caller="+" style="x"><char style="xo" closed="false">14:5 </char><char style="xt" closed="false"><ref loc="ZEP 3:13">सपन्‌याह 3:13</ref></char></note><verse eid="REV 14:5" /></para>
  <para style="s">तीन ह़रगदुत</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 14:6" />अळतेण मे एक अळी ह़रगदुत ने वादळा मे उचेत उडत्‌लो देख्‌यो, जीनी पांह धरती पोर रेवा वाळा नी एक-एक जाती अने घोराणा अने बोली, अने माणहु ने ह़मळाव्‌वा करीन अमरकाय नी खुस-खबर हती। <verse eid="REV 14:6" /><verse number="7" style="v" sid="REV 14:7" />तीहयो उचा बोल सी केदो, “भगवान नी ईज्‌जत करो, अने तीना मोट्‌ला कामु नी जुगु तीनी बड़ाय करो, काहाके आखा माणहु नो नीयाव करवा नी तीनी टेम आय लागली से; तीनी भक्‌ती करो, जे ह़रग अने धरती अने दर्‌या अने पाणी ना झोर बणायो।”<verse eid="REV 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 14:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:8 </char>
      <char style="xt" closed="false">
        <ref loc="REV 18:2">परकासीतवाक्‌य 18:2</ref>
      </char>
    </note>अने अळतेण एक अळी तीनी पसळ बीजो ह़रगदुत, आहयु केतो जाय्‌न आयो, “पड़ ज्‌यु मोट्‌लु बेबीलोन पड़ ज्‌यु, जे आह़फाम नु छीनाळु, नु माणलु ह़रु आखी जाती ने पीवाड़लु से।”<note caller="+" style="x"><char style="xo" closed="false">14:8 </char><char style="xt" closed="false"><ref loc="ISA 21:9">यसाया 21:9</ref>; <ref loc="JER 51:8">यीरम्‌या 51:8</ref>; <ref loc="GEN 18:2">उबजणाय कीताप 18:2</ref></char></note><verse eid="REV 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 14:9" />अने तीहया बे ह़रगदुत नी अळतेण एक अळी तीसरो ह़रगदुत आयो, अने उची अवाज सी आहयु केतो जाय्‌न आयो, “जे कोय तीहया जंगली जानवर अने तीनी मुर्‌ती नी पुंजा करे, अने आह़फा ना हात नीता नींडाळे तीनो सीलटप्‌पो लगाड़े, <verse eid="REV 14:9" /><verse number="10" style="v" sid="REV 14:10" />ता तीहयो भगवान नी रीह नु ह़रु पीहे, एवु जे कंय बी भेसकायलु नी हय अने माणलु ह़रु जे भगवान नी रीह ना कटोरा मे तीयार करलु से। अने तीने चोखला ह़रगदुत अने गाडरु नी अगळ हुड़ु-हुड़ु धपत्‌लु आक्‌ठु अने बारुद<note caller="+" style="x"><char style="xo" closed="false">14:10 </char><char style="xt" closed="false"><ref loc="ISA 51:17">यसाया 51:17</ref>; <ref loc="GEN 29:24">उबजणाय कीताप 29:24</ref>; <ref loc="EZK 38:22">यहेजकेल 38:22</ref></char></note> मे दुख आपहे। <verse eid="REV 14:10" /><verse number="11" style="v" sid="REV 14:11" />तीमनी वेला नो धुकरो जलमको उडतो रेहे,<note caller="+" style="x"><char style="xo" closed="false">14:11 </char><char style="xt" closed="false"><ref loc="ISA 34:10">यसाया 34:10</ref></char></note> अने जे तीहया जंगली जानवर नी अने तीनी मुर्‌ती नी पुंजा करे, अने जे तीना नाम नो सीलटप्‌पो लगाड़े, तीमने रात-दाड़ो अराम नी जड़े।”<verse eid="REV 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 14:12" />आनीन करते भगवान ना चोखला माणहु जे भगवान ना हुकम ने माने अने ईसु पोर भरहो राखे, धीरज धरवा जरुड़ी से।<verse eid="REV 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="REV 14:13" />अळतेण मे ह़रग मे आहयो बोल ह़मळ्‌यो, “लीख: जुगाळा रेहे तीहया मरन्‌या, जे हाव गेथा मालीक मे मरहे।” आत्‌मा केय, “होव, काहाके तीहया तीमनी आखी वेला ना कामु सी अराम हात करहे, अने तीमना काम तीमनी ह़ाते चाल पड़हे।”<verse eid="REV 14:13" /></para>
  <para style="s">धरती नी फसल नी वाडणी</para>
  <para style="p">
    <verse number="14" style="v" sid="REV 14:14" />मे भाळ्‌यो, अने देख्‌यो, एक उजळु वादळु से, अने तीहया वादळा पोर एक माणेह ना सोरान तेवु कोय बहलु से,<note caller="+" style="x"><char style="xo" closed="false">14:14 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानीयल 7:13</ref></char></note> जीना मुंडा पोर ह़ोना नी पागड़ी अने हात मे वेताळु दातड़ु से। <verse eid="REV 14:14" /><verse number="15" style="v" sid="REV 14:15" />अळतेण एक अळी ह़रगदुत मंदीर मे गेथो नीकळीन तीने जे वादळा पोर बह र्‌यो हतो, उची अवाज सी आड़ीन केदो, “आह़फा नु दातड़ु लगाड़ीन वाडणी वाड, काहाके वाडणी नी टेम आय जेली से, आनीन करते के धरती पोर नी फसल पाक जेली से।” <verse eid="REV 14:15" /><verse number="16" style="v" sid="REV 14:16" />ता जे वादळु पोर बहलो हतो तीहयो धरती पोर तीनु दातड़ु टेकव्‌यो, अने धरती नी फसल नी वाडणी कर्‌यो।<verse eid="REV 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 14:17" />अळतेण अळी एक बीजो ह़रगदुत तीहया मंदीर मे गेथो नीकळ्‌यो जे ह़रग मे से, अने तीनी पांह बी वेताळु दातड़ु हतु।<verse eid="REV 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="REV 14:18" />अळतेण एक अळी ह़रगदुत जीने आक्‌ठु पोर हक हतो, वेदी मे गेथो नीकळ्‌यो, अने जीनी पांह वेताळु दातड़ु हतु, तीने उचा बोल सी केदो, “तारु वेताळु दातड़ु ली ले अने धरती ना वेला मे गेथा अंगुर ना घोड़ ने तोड़ लेय, काहाके आना अंगुर पाक जेला से।” <verse eid="REV 14:18" /><verse number="19" style="v" sid="REV 14:19" />ता ह़रगदुत धरती पोर तीनु दातड़ु ने लगाड़्‌यो, अने अंगुरु ने भेळा कर्‌यो अने तीमने भगवान ना रीह ना मोट्‌ला ह़रु ना कटोरा मे नाख देदो। <verse eid="REV 14:19" /><verse number="20" style="v" sid="REV 14:20" /><note caller="+" style="x"><char style="xo" closed="false">14:20 </char><char style="xt" closed="false"><ref loc="REV 19:15">परकासीतवाक्‌य 19:15</ref></char></note>अने तीमने ह़ेर सी बाहर ह़रु ना कटोरा मे रोदळी देदा, अने ह़रु ना कटोरा मे सी आतरु लोय नीकळ्‌यु के घोड़ा ना लगाम लग पुग ज्‌यु, अने बे ह़ोव मील लग वय ज्‌यु।<verse eid="REV 14:20" /></para>
  <chapter eid="REV 14" />
  <chapter number="15" style="c" sid="REV 15" />
  <para style="s">आखरी गरा नी ह़ाते ह़रगदुत</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 15:1" />अळतेण मे वादळा मे एक अळी वहराड़ नाखे एवी अने मोट्‌ली अने ह़तायली सेलाणी देख्‌यो, मे देख्‌यो के ह़ात ह़रगदुत आखरी ह़ातोव गरा ली र्‌या, आहयु आखरी खत्‌तम हयणु से। काहाके आमनी ह़ाते भगवान नी रीह बी खत्‌तम हय जाय।<verse eid="REV 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 15:2" />अळतेण मने एक काच ने तेवी दर्‌या देखायी; जीनी मे मान लेवो आक्‌ठु भेसकायलु हय। अने मे देख्‌यो के जे तीहया जानवर नी मुर्‌ती पोर अने तीना नाम ना आकड़ा पोर जीक जेला हता, तीहया बी काच ना दर्‌या पोर उबा हय र्‌या हता, अने तीहया भगवान ना आपला तम्‌बुरा ली र्‌या हता। <verse eid="REV 15:2" /><verse number="3" style="v" sid="REV 15:3" />तीहया भगवान ना चाकर्‌या मुसा नु गीत, अने गाडरु नु गीत गाव्‌वा बाज र्‌या हता,</para>
  <para style="q1" vid="REV 15:3">“ए जोरभर्‌या मालीक भगवान,</para>
  <para style="q2" vid="REV 15:3">तारा काम सेल-भात्‌या अने मोटा से;</para>
  <para style="q1" vid="REV 15:3">ए आखी जाती ना राजा,</para>
  <para style="q2" vid="REV 15:3">तारी वाट वारली अने खरली से।”<note caller="+" style="x"><char style="xo" closed="false">15:3 </char><char style="xt" closed="false"><ref loc="EXO 15:1">नीरगमन 15:1</ref></char></note><verse eid="REV 15:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="REV 15:4" />“ए मालीक,</para>
  <para style="q2" vid="REV 15:4">कोय तारी सी नी बीहे अने तारा नाम नी</para>
  <para style="q2" vid="REV 15:4">बड़ाय नी करे?</para>
  <para style="q1" vid="REV 15:4">काहाके तु एतरोत चोखलो से।</para>
  <para style="q2" vid="REV 15:4">आखी जाती आवीन तारी भक्‌ती करहे,</para>
  <para style="q2" vid="REV 15:4">काहाके तारा नीयाव ना काम आखा पोर उजन्‌ता हय जेला से।<note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="JER 10:7">यीरम्‌या 10:7</ref>; <ref loc="PSA 86:9">भजन सहीता 86:9</ref></char></note>”<verse eid="REV 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 15:5" />आनी बाद, मे देख्‌यो के ह़रग मे नो मंदीर मतलब गवाय ना चोखलु तम्‌बु ने उगड़लु देख्‌यो।<note caller="+" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="EXO 38:21">नीरगमन 38:21</ref></char></note> <verse eid="REV 15:5" /><verse number="6" style="v" sid="REV 15:6" />अने तीहया ह़ातोव ह़रगदुत जीमनी पांह ह़ातोव गरा हती, चोखला अने पपलन्‌या लुगड़ा पेरीन अने छाती पोर ह़ोना नी पट्‌टी बांदीन मंदीर मे गेथा नीकळ्‌या। <verse eid="REV 15:6" /><verse number="7" style="v" sid="REV 15:7" />ता तीहया च्‌यारोव जीव मे गेथो एक तीहया ह़ातोव ह़रगदुत ने भगवान ना, जे जलमको जीवत्‌लो से, तीनी रीह ना भरला ह़ोना ना ह़ात कटोरा आप्‌यो; <verse eid="REV 15:7" /><verse number="8" style="v" sid="REV 15:8" />अने भगवान नी बड़ाय अने तीनी ताखत ना कारण सी मंदीर धुकरा सी भराय ज्‌यो,<note caller="+" style="x"><char style="xo" closed="false">15:8 </char><char style="xt" closed="false"><ref loc="EXO 40:34">नीरगमन 40:34</ref>; <ref loc="1KI 8:10">1 राजा 8:10</ref>,<ref loc="1KI 8:11">11</ref>; <ref loc="2CH 5:13">2 ईतीहास 5:13</ref>,<ref loc="2CH 5:14">14</ref>; <ref loc="ISA 6:4">यसाया 6:4</ref></char></note> अने जत्‌यार तक तीहया ह़ातोव ह़रगदुत नी ह़ातोव गरा खत्‌तम नी हयी तांह तक कोय मंदीर मे नी जाय सक्‌यु।<verse eid="REV 15:8" /></para>
  <chapter eid="REV 15" />
  <chapter number="16" style="c" sid="REV 16" />
  <para style="s">भगवान नी रीह ना ह़ात कटोरा</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 16:1" />अळतेण मे ह़मळ्‌यो एक उची अवाज मंदीर मे गेथा तीहया ह़ात ह़रगदुत ने आहयु केते ह़मळ्‌यो, “जावो, भगवान ना रीह ना ह़ातोव कटोरा धरती पोर रेचव देवो।”<verse eid="REV 16:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="REV 16:2" />पेल्‌नो ह़रगदुत ज्‌यो अने आह़फा नो कटोरो धरती पोर उन्‌दो वाळ देदो। ता तीहया माणहु ने, जीमनी पोर जंगली जानवर नो सीलटप्‌पो हतो अने तीनी मुर्‌ती नी पुंजा करता हता, तीमने एक भाती ना घण-जबर दुख देण्‌या, फोड़ा नीकळ्‌या।<note caller="+" style="x"><char style="xo" closed="false">16:2 </char><char style="xt" closed="false"><ref loc="EXO 9:10">नीरगमन 9:10</ref></char></note><verse eid="REV 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 16:3" />अने बीजो ह़रगदुत आह़फा नो कटोरो दर्‌या पोर रेचव देदो, ता दर्‌या मरला माणहु ना लोय ने तेवी हय ज्‌यी, अने दर्‌या मे ना आखा रेवा वाळा जीव मर ज्‌या।<verse eid="REV 16:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 16:4" />अळतेण तीसरो ह़रगदुत बी आह़फा नो कटोरो नंद्‌या अने पाणी ना झोर पोर रेचव देदो, अने तीहया लोय बण ज्‌या।<note caller="+" style="x"><char style="xo" closed="false">16:4 </char><char style="xt" closed="false"><ref loc="EXO 7:17-21">नीरगमन 7:17-21</ref>; <ref loc="PSA 78:44">भजन सहीता 78:44</ref></char></note> <verse eid="REV 16:4" /><verse number="5" style="v" sid="REV 16:5" />ता मे पाणी पोर हक वाळा ह़रगदुत ने आहयु केते ह़मळ्‌यो, “ए चोखला, जे से अने हतो, तु नीयाव करन्‌यो से अने तु आहयो नीयाव संय कर्‌यो। <verse eid="REV 16:5" /><verse number="6" style="v" sid="REV 16:6" />काहाके तीहया भगवान ना चोखला माणहु अने भगवान वगे गेथा केण्‌या नु लोय वयाड़ला हता, अने तु नीयाव करन्‌यो से अने तु तीमने पीयाड़वा लोय बी आप्‌यो काहाके आहया आनीत लायक से।” <verse eid="REV 16:6" /><verse number="7" style="v" sid="REV 16:7" />अळतेण मे वेदी ने आहयु केते ह़मळ्‌यो, “होव, एक जोरभर्‌या मालीक भगवान, तारा फेसला वारु अने खरला से।”<verse eid="REV 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 16:8" />चोवथो ह़रगदुत आह़फा नो कटोरो दाहड़ु पोर रेचव देदो, अने दाहड़ु ने माणहु ने आक्‌ठु सी धपाड़ देवा नो हक आप्‌यो। <verse eid="REV 16:8" /><verse number="9" style="v" sid="REV 16:9" />अने माणहु घण-जबर तपवा सी घण-जबर झळाय ज्‌या, अने भगवान ना नाम नी जीने आहयी गरा पोर हक से, वाक काड्‌या पण तीनी बड़ाय करवा करीन तीमना पापु सी नी फीर्‌या।<verse eid="REV 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 16:10" />पांचवो ह़रगदुत तीनो कटोरो तीहया जंगली जानवर नी राजगादी पोर रेचव देदो, अने तीना राज पोर अंदारु हय ज्‌यु।<note caller="+" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="EXO 10:21">नीरगमन 10:21</ref></char></note> अने माणहु वेला ना कारण सी आह़फाम नी जीप चाव्‌वा बाज ज्‌या, <verse eid="REV 16:10" /><verse number="11" style="v" sid="REV 16:11" />अने तीमनी वेला अने फोड़ाम ना कारण सी ह़रगे ना भगवान नो वाक काड्‌या, पण आह़फा-आह़फाम ना पापु सी नी फीर्‌या।<verse eid="REV 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 16:12" />छटवो ह़रगदुत आह़फा नो कटोरो मोट्‌ली नंदी फुरात पोर रेचव देदो, अने तीनु पाणी ह़ुक ज्‌यु के उगवणा गेथा आव्‌वा वाळा राजाम नी जुगु वाट तीयार हय जाय।<note caller="+" style="x"><char style="xo" closed="false">16:12 </char><char style="xt" closed="false"><ref loc="EXO 9:10">नीरगमन 9:10</ref></char></note> <verse eid="REV 16:12" /><verse number="13" style="v" sid="REV 16:13" />अळतेण मे तीहया अजगर ना मोडा मे गेथी, अने तीहया जंगली जानवर ना मोडा मे गेथी, अने तीहया झुटा भगवान वगे गेथा केण्‌या माणेह ना मोडा मे गेथी तीन वीटळ्‌ळी आत्‌मा ने डेकटा ना वेह मे नीकळते देख्‌यो। <verse eid="REV 16:13" /><verse number="14" style="v" sid="REV 16:14" />आहया सेलाणी देखाड़वा वाळा भुतड़ा नी आत्‌मा से। आहयी तीन आत्‌मा जे आखी कळी ना राजान तां नीकळीन आनीन करते जाय के तीमने जोरभर्‌या भगवान ना तीहया मोट्‌ला दाड़ा नी लड़ाय नी जुगु एक्‌ठा करे।<verse eid="REV 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 16:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:15 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:43">मत्‌ती 24:43</ref>,<ref loc="MAT 24:44">44</ref>; <ref loc="LUK 12:39">लुका 12:39</ref>,<ref loc="LUK 12:40">40</ref>; <ref loc="REV 3:3">परकासीतवाक्‌य 3:3</ref></char>
    </note>“देख, मे चोट्‌टान तेम आवु; जुगाळो से तीहयो जे जागतो रेय,<note caller="+" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्‌ती 24:43</ref>,<ref loc="MAT 24:44">44</ref>; <ref loc="LUK 12:39">लुका 12:39</ref>,<ref loc="LUK 12:40">40</ref>; <ref loc="GEN 3:3">उबजणाय कीताप 3:3</ref></char></note> अने आह़फा ना लुगड़ा ने ह़माळीन राखे, के तीहयो नांगरलो नी फीरे, अने माणहु तीने लाजे पड़ते नी देखे।”<verse eid="REV 16:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 16:16" />अने तीहयी भुत आत्‌मा राजाम ने तीहया जागे एक्‌ठा करी, जे ईब्‌रानी मे हरमगीदोन केवाये।<note caller="+" style="x"><char style="xo" closed="false">16:16 </char><char style="xt" closed="false"><ref loc="2KI 23:29">2 राजा 23:29</ref>; <ref loc="ZEC 12:11">जकर्‌याह 12:11</ref></char></note><verse eid="REV 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 16:17" />ह़ातवो ह़रगदुत आह़फा नो कटोरो वाहवु पोर रेचव देदो, अने मंदीर<note caller="+" style="f"><char style="fr" closed="false">16:17 </char><char style="ft" closed="false">चोखलो जागो</char></note> नी राजगादी मे गेथो मोट्‌लो बोल ह़मळायो, “पुरु हय ज्‌यु!” <verse eid="REV 16:17" /><verse number="18" style="v" sid="REV 16:18" /><note caller="+" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="REV 8:5">परकासीतवाक्‌य 8:5</ref>; <ref loc="REV 11:13">11:13</ref>,<ref loc="REV 11:19">19</ref></char></note>अळतेण वीजळ्‌या चमक्‌या, अने वादळु मे गाजवा बाज ज्‌यु, अने एक मोट्‌लो भुकम्‌प आयो, जे जत्‌यार गेथी माणहु नी सुरुवात धरती पोर हयी, तत्‌यार गेथो एवो मोट्‌लो भुकम्‌प कदी नी आयो।<note caller="+" style="x"><char style="xo" closed="false">16:18 </char><char style="xt" closed="false"><ref loc="GEN 8:5">उबजणाय कीताप 8:5</ref>; <ref loc="GEN 11:13">11:13</ref>,<ref loc="GEN 11:19">19</ref></char></note> <verse eid="REV 16:18" /><verse number="19" style="v" sid="REV 16:19" />आनी सी मोट्‌ला ह़ेर ना तीन टुकड़ा हय ज्‌या, अने जाती-जाती ना ह़ेर खत्‌तम हय ज्‌या; अने भगवान मोट्‌ला बेबीलोन ने डंड आपवा करीन फोम करलो हतो, अने तीहयो तीने आह़फा ना भड़कत्‌ला रीह नु माणलु ह़रु नो पीयालो तीने पीवा आप्‌यो।<note caller="+" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ISA 51:17">यसाया 51:17</ref></char></note> <verse eid="REV 16:19" /><verse number="20" style="v" sid="REV 16:20" /><note caller="+" style="x"><char style="xo" closed="false">16:20 </char><char style="xt" closed="false"><ref loc="REV 6:14">परकासीतवाक्‌य 6:14</ref></char></note>अने एक-एक टापु तीमना जागा गेथु हील ज्‌यु, अने बड़ाम नो पतो नी चाल्‌यो।<note caller="+" style="x"><char style="xo" closed="false">16:20 </char><char style="xt" closed="false"><ref loc="GEN 6:14">उबजणाय कीताप 6:14</ref></char></note> <verse eid="REV 16:20" /><verse number="21" style="v" sid="REV 16:21" /><note caller="+" style="x"><char style="xo" closed="false">16:21 </char><char style="xt" closed="false"><ref loc="REV 11:19">परकासीतवाक्‌य 11:19</ref></char></note>वादळा मे गेथा माणहु पोर मोटात-मोटा गारा पड़्‌या जे चाळीह़-चाळीह़ कीला ना हता, अने आनीन करते के आहयी वेला घणी भारी हती, माणहु गारा नी वेला नी कारण सी भगवान नो वाक काड्‌या।<note caller="+" style="x"><char style="xo" closed="false">16:21 </char><char style="xt" closed="false"><ref loc="EXO 9:23">नीरगमन 9:23</ref>; <ref loc="GEN 11:19">उबजणाय कीताप 11:19</ref></char></note><verse eid="REV 16:21" /></para>
  <chapter eid="REV 16" />
  <chapter number="17" style="c" sid="REV 17" />
  <para style="s">मोट्‌ली छीनाळ</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 17:1" />अळतेण जे ह़ात ह़रगदुत पांह तीहया ह़ात कटोरा हता, तीमनी माय्‌न एक आवीन मने आहयु केदो, “ओरो आव, के ढेरेत नंदी नी धेड़े बह री, तीहयी मोट्‌ली छीनाळ, मतलब मोट्‌लु ह़ेर बेबीलोन नो डंड देखाड़ु।<note caller="+" style="x"><char style="xo" closed="false">17:1 </char><char style="xt" closed="false"><ref loc="JER 51:13">यीरम्‌या 51:13</ref></char></note> <verse eid="REV 17:1" /><verse number="2" style="v" sid="REV 17:2" />जीनी ह़ाते धरती पोर ना राजा छीनाळु करला; अने धरती पोर रेवा वाळा तीनु छीनाळु नु ह़रु ना नसा नी धुंद मे हय जेला हता।”<note caller="+" style="x"><char style="xo" closed="false">17:2 </char><char style="xt" closed="false"><ref loc="ISA 23:17">यसाया 23:17</ref>; <ref loc="JER 51:7">यीरम्‌या 51:7</ref></char></note><verse eid="REV 17:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 17:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">17:3 </char>
      <char style="xt" closed="false">
        <ref loc="REV 13:1">परकासीतवाक्‌य 13:1</ref>
      </char>
    </note>ता मने पुरी रीती सी आत्‌मा हक मे कर लेदी, अने अळतेण ह़रगदुत मने जंगल मे ली ज्‌यो, अने तां मे रात्‌ला रंग नु जंगली जानवर पोर एक बयर ने बह रेली देख्‌यो। तीनी पोर भगवान ना वाक ना नामु आखे लीखला हता, अने तीना ह़ात मुंडा अने दह़ ह़ींगड़ा हता।<note caller="+" style="x"><char style="xo" closed="false">17:3 </char><char style="xt" closed="false"><ref loc="GEN 13:1">उबजणाय कीताप 13:1</ref></char></note> <verse eid="REV 17:3" /><verse number="4" style="v" sid="REV 17:4" />तीहयी बयर जमणा अने रात्‌ला रंग ना लुगड़ा पेरली हती, अने ह़ोनु, अने घणा मोगला मण्‌या अने मोती सी तीयार हयली हती, अने तीना हात मे एक ह़ोना नो कटोरो हतो जे ह़ीगी आवे एवी चीज सी अने तीना छीनाळा नी वीटाळन्‌याण चीज सी भरलो हतो।<note caller="+" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="JER 51:7">यीरम्‌या 51:7</ref></char></note> <verse eid="REV 17:4" /><verse number="5" style="v" sid="REV 17:5" />तीना नींडाळा पोर आहयु नाम लीखलु हतु, “ह़तायलु मतलब आहयु मोट्‌लु बेबीलोन धरती नी छीनाळ्‌याण नी अने ह़ीगी आवे एवी चीज नी आय्‌ह।”<verse eid="REV 17:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="REV 17:6" />मे तीहयी बयर ने भगवान ना चोखला माणहु नु अने ईसु नी गवाय देण्‌या नु लोय पीवा सी छाकली देख्‌यो; अने जत्‌यार मे तीने देख्‌यो ता देखीन वहराय ज्‌यो। <verse eid="REV 17:6" /><verse number="7" style="v" sid="REV 17:7" />ता तीहयो ह़रगदुत मने केदो, तु काहा वहराय र्‌यो? मे तीहयी बयर नु अने तीहयु जंगली जानवर नु, जीनी पोर तीहयी बह री अने जीना ह़ात मुंडा अने दह़ ह़ींगड़ा से, तीनु ह़तायलु मतलब मे तने देखाड़ु। <verse eid="REV 17:7" /><verse number="8" style="v" sid="REV 17:8" /><note caller="+" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="REV 11:7">परकासीतवाक्‌य 11:7</ref></char></note>जे जंगली जानवर तु देखलो से, तीहयु पेले ते जीवत्‌लु हतु पण हाव नी हय, ते बी तीहयु पताळ खाडा मे गेथु नीकळहे तात खत्‌तम हय जहे; अने धरती पोर रेवा वाळा आखा माणहु जीमना नाम धरती बणली तीहयी टेमे गेथा जीवाय नी कीताप मे लीख्‌या नी, आहयु जंगली जानवर नी आहयी हालत देखीन के पेले हतु अने हाव नी हय अने अळतेण आय लागहे, तीने देखीन वहराय जहे।<note caller="+" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="DAN 7:7">दानीयल 7:7</ref>; <ref loc="GEN 11:7">उबजणाय कीताप 11:7</ref>; <ref loc="PSA 69:28">भजन सहीता 69:28</ref></char></note><verse eid="REV 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 17:9" />आहयु ह़मजवा करीन एक ग्‌यानी मन नी जरवत से: तीहया ह़ातोव मुंडा ह़ात बड़ा से, अने तीहया ह़ात राजा बी से, जीमनी पोर तीहयी बयर बह री। <verse eid="REV 17:9" /><verse number="10" style="v" sid="REV 17:10" />अने आमनी मे गेथा पांच ते पड़ जेला से, अने एक हजु बी राज कर र्‌यो, अने एक हजु तक आयो नी, अने जत्‌यार आवहे ता थोड़ीक वार तक तीहयो राज करहे। <verse eid="REV 17:10" /><verse number="11" style="v" sid="REV 17:11" />जे जंगली जानवर पेले जीवत्‌लु हतु, अने हाव तीहयु जीवत्‌लु नी हय, तीहयो आंठवो राजो से, जे तीहयो आहया ह़ातोव माय्‌न एक से, जीनु खत्‌तम हयणु नख्‌खी से।<verse eid="REV 17:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 17:12" />“जे दह़ ह़ींगड़ा तु देखलो तीहया दह़ राजा से जे हजु तक आह़फाम नु राज करवा सुरु नी कर्‌या,<note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="DAN 7:24">दानीयल 7:24</ref></char></note> पण तीहयु जंगली जानवर नी ह़ाते थोड़ीक वार लग राजाम नी तेवो राज करवा नो हक जड़हे। <verse eid="REV 17:12" /><verse number="13" style="v" sid="REV 17:13" />आहया आखा एक-मन्‌या हयहे, अने तीहया आह़फा-आह़फाम नी ताखत अने हक तीहया जंगली जानवर ने आपहे। <verse eid="REV 17:13" /><verse number="14" style="v" sid="REV 17:14" />तीहया गाडरु ना वीरोद मे झुमायहे, पण गाडरु आह़फा ना टाळला अने भरहा नी लायक तीनी पसळ चालवा वाळा ने एक्‌ठा करीन तीमने हराय नाखहे, काहाके तीहयो मालीक नो मालीक अने राजा नो राजा से।”<verse eid="REV 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="REV 17:15" />अळतेण ह़रगदुत मने केदो, जे पाणी तु देख्‌यो, जीनी पोर छीनाळ बह री, तीहया जाती, माणहु, अने बोली से। <verse eid="REV 17:15" /><verse number="16" style="v" sid="REV 17:16" />अने जे दह़ ह़ींगड़ा तु देख्‌यो, तीहया अने जंगली जानवर तीहयी छीनाळ सी दुस्‌मनी राखहे, अने तीनी पांह आखु कंय हापकीन नांगरली मेक जहे। अने तीहया तीनु माह खाय जहे, अने तीने आक्‌ठु मे धपाड़ देहे। <verse eid="REV 17:16" /><verse number="17" style="v" sid="REV 17:17" />आह़फा नी आह पुरी करवा करीन भगवान तीहया आखा ने एक-मन्‌या करीन तीमना मन मे आहयु बहाड़ नाखलो से के तीहया जत्‌यार तक भगवान ना बोलु पुरा नी हय जाय तांह तक राज करवा नो आह़फा नो हक तीहयु जंगली जानवर ने ह़ोप देय। <verse eid="REV 17:17" /><verse number="18" style="v" sid="REV 17:18" />“तीहयी बयर, जीने तु देखलो से, तीहयी मोट्‌लु ह़ेर से जे धरती ना राजा पोर राज करे।”<verse eid="REV 17:18" /></para>
  <chapter eid="REV 17" />
  <chapter number="18" style="c" sid="REV 18" />
  <para style="s">बेबीलोन नु खत्‌तम हयणु</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 18:1" />आनी बाद एक अळी ह़रगदुत ने ह़रगे गेथो उतरते देख्‌यो, जीने मोट्‌लो हक जड़लो हतो; अने धरती तीनी चमक सी पपलवा बाज ज्‌यी। <verse eid="REV 18:1" /><verse number="2" style="v" sid="REV 18:2" /><note caller="+" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="REV 14:8">परकासीतवाक्‌य 14:8</ref></char></note>तीहयो उची अवाज सी आड़ीन केदो, “पड़ ज्‌यु, मोट्‌लु बेबीलोन पड़ ज्‌यु! तीहयु हाव भुत नो रेवास, अने एक-एक वीटळ्‌ळी आत्‌मा नो ठीयो बण जेलु से, अने ह़ीगी आवे एवा चड़ा नो ठीयो बण जेलु से।<note caller="+" style="f"><char style="fr" closed="false">18:2 </char><char style="ft" closed="false">यसाया 13:21; 21:9; यीरम्‌या 50:39; 51:8; उबजणाय कीताप 14:8 </char></note> <verse eid="REV 18:2" /><verse number="3" style="v" sid="REV 18:3" />काहाके आखा देस वाळा तीनु ह़रु मतलब गलत ईच्‌छा ने पीदला से। अने धरती ना राजा तीनी ह़ाते छीनाळु करला से, अने आहयी धरती पोर वाळा वेपारी तीना मोज-मस्‌ती ना धन सी पामता हय जेला से।<note caller="+" style="x"><char style="xo" closed="false">18:3 </char><char style="xt" closed="false"><ref loc="ISA 23:17">यसाया 23:17</ref>; <ref loc="JER 51:7">यीरम्‌या 51:7</ref></char></note>”<verse eid="REV 18:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 18:4" />अळतेण मे ह़रगे गेथो एक अळी बोल ह़मळ्‌यो,</para>
  <para style="q1" vid="REV 18:4">“ए मारा माणहु, तीनी मे गेथा नीकळ आवो के</para>
  <para style="q2" vid="REV 18:4">तमु तीना पाप मे साजल्‌या नी रेवो, अने तीना डंड मे</para>
  <para style="q2" vid="REV 18:4">तमु साजल्‌या ना बणो।<note caller="+" style="x"><char style="xo" closed="false">18:4 </char><char style="xt" closed="false"><ref loc="ISA 48:20">यसाया 48:20</ref>; <ref loc="JER 50:8">यीरम्‌या 50:8</ref>; <ref loc="JER 51:6">51:6</ref>,<ref loc="JER 51:45">45</ref></char></note><verse eid="REV 18:4" /></para>
  <para style="q1">
    <verse number="5" style="v" sid="REV 18:5" />काहाके तीना पाप नो ढेर ह़रगे तक पुग जेलो से,</para>
  <para style="q2" vid="REV 18:5">अने भगवान तीना गलत काम ने फोम करलो से।<note caller="+" style="x"><char style="xo" closed="false">18:5 </char><char style="xt" closed="false"><ref loc="GEN 18:20">उबजणाय कीताप 18:20</ref>,<ref loc="GEN 18:21">21</ref>; <ref loc="JER 51:9">यीरम्‌या 51:9</ref></char></note><verse eid="REV 18:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="REV 18:6" />तमु बी तीनी ह़ाते तेवोत वेहवार करो जेम तीहयी तमारी ह़ाते करली से,</para>
  <para style="q2" vid="REV 18:6">जे तीहयी तमारी ह़ाते करी तीना बदला मे बे गुणा वदु तीनी ह़ाते करो।</para>
  <para style="q1" vid="REV 18:6">तमारी जुगु तीहयी जे कटोरा मे ह़रु भेसकी तेमेत तमु</para>
  <para style="q2" vid="REV 18:6">तीनी जुगु बे गुणा जादा भेसको।<note caller="+" style="x"><char style="xo" closed="false">18:6 </char><char style="xt" closed="false"><ref loc="PSA 137:8">भजन सहीता 137:8</ref>; <ref loc="JER 50:29">यीरम्‌या 50:29</ref></char></note><verse eid="REV 18:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="REV 18:7" />काहाके जे बड़ाय अने सुख तीहयी आह़फी ने आपी तमु</para>
  <para style="q2" vid="REV 18:7">तीहयीत रीते दुख आपो।</para>
  <para style="q1" vid="REV 18:7">काहाके तीहयी आह़फी मन मे केती रेय,</para>
  <para style="q1" vid="REV 18:7">‘मे राणीन तेम बह री।</para>
  <para style="q2" vid="REV 18:7">मे रंडायली नी हय,</para>
  <para style="q2" vid="REV 18:7">अने कदी दुख मे नी पड़ु।’<verse eid="REV 18:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="REV 18:8" />आनीन करते तीनी पोर एकीत दाड़ा मे गरा आय पड़हे,</para>
  <para style="q2" vid="REV 18:8">मतलब मोत, दुख, काळ;</para>
  <para style="q1" vid="REV 18:8">अने तीने आक्‌ठु मे खत्‌तम कर देहे,</para>
  <para style="q2" vid="REV 18:8">काहाके तीनो नीयाव करन्‌यो मालीक भगवान जोरभर्‌यो से।”<note caller="+" style="x"><char style="xo" closed="false">18:8 </char><char style="xt" closed="false"><ref loc="ISA 47:7-9">यसाया 47:7-9</ref></char></note><verse eid="REV 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 18:9" />धरती पोर वाळा राजा जे तीनी ह़ाते छीनाळु कर्‌या, अने मोज-मस्‌ती कर्‌या, जत्‌यार तीनो धपवा नो धुकरो देखहे, ता तीनी जुगु रड़हे अने छाती ठोकहे। <verse eid="REV 18:9" /><verse number="10" style="v" sid="REV 18:10" />तीनी वेला नी बीक ना कारण सी छेटात उबा रीन तीहया केहे, “ए मोट्‌ला ह़ेर, बेबीलोन! ए ताखत वाळा ह़ेर, गरा आय पड़े! गरा आय पड़े! थोड़ीकेत वार मेत तारो डंड तने जड़ ज्‌यो।”<note caller="+" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="EZK 26:16">यहेजकेल 26:16</ref>,<ref loc="EZK 26:17">17</ref></char></note><verse eid="REV 18:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="REV 18:11" />धरती पोर वाळा वेपारी तीनी जुगु रड़हे अने कलपहे, काहाके हाव कोय तीमनो माल वेचातो नी लेय;<note caller="+" style="x"><char style="xo" closed="false">18:11 </char><char style="xt" closed="false"><ref loc="EZK 27:32">यहेजकेल 27:32</ref>,<ref loc="EZK 27:36">36</ref></char></note> <verse eid="REV 18:11" /><verse number="12" style="v" sid="REV 18:12" />मतलब ह़ोनु, चांदी, मोगला दगड़ा, मोती, अने लेफड़्‌या, जामण्‌या, रेसमी लुगड़ा, अने रात्‌ला रंग ना लुगड़ा, अने आखी भाती ना गंदायण्‌या लाकड़ा, हाती ना दात ना आखा चीज, मोगला लाकड़ा, काच, लुहड़ा ना अने संगमरमर ना दगड़ा नु आखु चीज, <verse eid="REV 18:12" /><verse number="13" style="v" sid="REV 18:13" />अने दाळ मसालो, मसाला, धुप अगरबत्‌ती, गंदायण्‌यु तेल, लोबान, ह़रु, तेल, मयदो, गम, गाय-बोळद्‌या, गाडरा, घोड़ा, घोड़ागाडी, अने चाकर्‌या, अने आञे तक के माणहु नु डील अने जीवाय बी। <verse eid="REV 18:13" /><verse number="14" style="v" sid="REV 18:14" />हाव तारा मन गमता फोळ तारीन्‌तां गेथा जत र्‌या, अने घटाळी चीज तारीन्‌तां गेथी सेटी हय ज्‌यी, अने तीहयु तने अळतेण कदी नी जड़े। <verse eid="REV 18:14" /><verse number="15" style="v" sid="REV 18:15" />तीहया वेपारी जे तीहयी चीज नु वेपारु करता जाय्‌न पामता हय जेला हता, तीहया तीनी ह़ाते तीना दुख मे साजल्‌या बणवा ना बीक ना कारण सी छेटात उबा रेहे, तीहया रड़हे अने कलपहे।<note caller="+" style="x"><char style="xo" closed="false">18:15 </char><char style="xt" closed="false"><ref loc="EZK 26:16">यहेजकेल 26:16</ref>,<ref loc="EZK 26:17">17</ref></char></note> <verse eid="REV 18:15" /><verse number="16" style="v" sid="REV 18:16" />अने केहे, “गरा आय पड़े! गरा आय पड़े! आहयु मोट्‌लु ह़ेर जे लेफड़्‌या, अने जामण्‌या अने रात्‌ला रंग नु लुगड़ु पेरलु हतु, अने ह़ोनु अने मोगला दगड़ा, अने मोती सी ह़ींगारलु हतु; <verse eid="REV 18:16" /><verse number="17" style="v" sid="REV 18:17" />अने थोड़ीक वार मेत तीनु आखु माल-धन खत्‌तम हय ज्‌यु।” अने आखा ढुंड्‌या ना डायला अने आव्‌वा-जवा वाळा अने ढुंड्‌या चलाड़न्‌या, अने जेतरा दर्‌या मे वेपार करता हता, आखा सेटा उबा र्‌या,<note caller="+" style="x"><char style="xo" closed="false">18:17 </char><char style="xt" closed="false"><ref loc="ISA 23:14">यसाया 23:14</ref>; <ref loc="EZK 27:26-30">यहेजकेल 27:26-30</ref> </char></note> <verse eid="REV 18:17" /><verse number="18" style="v" sid="REV 18:18" />अने तीनो धपवा नो धुकरो देखता जाय्‌न आड़ीन केहे, “कानु ह़ेर आहयु मोट्‌लु ह़ेर ने तेवु बण्‌यु?”<note caller="+" style="x"><char style="xo" closed="false">18:18 </char><char style="xt" closed="false"><ref loc="EZK 27:32">यहेजकेल 27:32</ref></char></note> <verse eid="REV 18:18" /><verse number="19" style="v" sid="REV 18:19" />अने आह़फा-आह़फाम ना मुंडा पोर कादो नाखहे, अने रड़ता जाय्‌न अने कलपता जाय्‌न केहे, “मोट्‌लु ह़ेर गरा आय पड़े! गरा आय पड़े! आहयु मोट्‌लु ह़ेर जीनी धन-दवल्‌यत नी लारे दर्‌या ना आखा ढुंड्‌या वाळा पामता हय जेला हता, थोड़ीक वार मेत तीनु आखु उजड़ ज्‌यु।”<note caller="+" style="x"><char style="xo" closed="false">18:19 </char><char style="xt" closed="false"><ref loc="EZK 27:30-34">यहेजकेल 27:30-34</ref></char></note><verse eid="REV 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 18:20" />ए ह़रग अने ए भगवान ना चोखला माणहु, अने नेवताळा अने भगवान वगे गेथा केण्‌या माणहु, खुस हयो, काहाके भगवान तीने तेवोत डंड आपलो से जेवो तीहयु तमने आपलु हतु!<note caller="+" style="x"><char style="xo" closed="false">18:20 </char><char style="xt" closed="false"><ref loc="DEU 32:43">वेवस्‌थावीवरन 32:43</ref>; <ref loc="JER 51:48">यीरम्‌या 51:48</ref></char></note><verse eid="REV 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 18:21" />अळतेण एक जोरभर्‌यो ह़रगदुत मोट्‌ली घट्‌टी ना पोड़ ने तेवो दगड़ो चुट्‌यो, अने आहयु कीन दर्‌या मे नाख देदो, “मोट्‌लु ह़ेर बेबीलोन ने आसमेत ताखत सी हेटु नाख देहे, अने अळतेण कारु बी तीनो पतो नी चाले।<note caller="+" style="x"><char style="xo" closed="false">18:21 </char><char style="xt" closed="false"><ref loc="JER 51:63">यीरम्‌या 51:63</ref>,<ref loc="JER 51:64">64</ref>; <ref loc="EZK 26:21">यहेजकेल 26:21</ref></char></note> <verse eid="REV 18:21" /><verse number="22" style="v" sid="REV 18:22" />तम्‌बुरा वगाड़वा वाळा नी, अने गीत गाव्‌वा वाळा नी, अने पाहळी वगाड़वा वाळा नी, अने फेपार्‌या वगाड़वा वाळा नी अवाज अळतेण कारु बी तारी मे नी ह़मळाये; अने अळतेण कानु काम करन्‌यो कारीगर बी तारी मे नी जड़े; अने कारु बी तारी मे घट्‌टी चालवा नी अवाज नी ह़मळाय;<note caller="+" style="x"><char style="xo" closed="false">18:22 </char><char style="xt" closed="false"><ref loc="EZK 26:13">यहेजकेल 26:13</ref>; <ref loc="ISA 24:8">यसाया 24:8</ref></char></note> <verse eid="REV 18:22" /><verse number="23" style="v" sid="REV 18:23" />अने दीवा नु वीजाळु अळतेण कदी नी तारी मे देखाय, अने अळतेण कदी नी तारी मे लाडी अने लाडा नी अवाज ह़मळाय; काहाके तारा वेपारी धरती पोर ना डायला हता, अने कळी ना आखा माणहु तारा झुटा सेलाण्‌या सी भटकाड़ला हता।”<note caller="+" style="x"><char style="xo" closed="false">18:23 </char><char style="xt" closed="false"><ref loc="JER 7:34">यीरम्‌या 7:34</ref>; <ref loc="JER 25:10">25:10</ref></char></note><verse eid="REV 18:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="REV 18:24" />बेबीलोन ने डंड जड़्‌यो, काहाके, भगवान वगे गेथा केण्‌या माणहु अने भगवान ना चोखला माणहु, अने धरती पोर जेतरा मार नाखला हता आखा नु लोय तीनीत मे जड़लु से।<note caller="+" style="x"><char style="xo" closed="false">18:24 </char><char style="xt" closed="false"><ref loc="JER 51:49">यीरम्‌या 51:49</ref></char></note><verse eid="REV 18:24" /></para>
  <chapter eid="REV 18" />
  <chapter number="19" style="c" sid="REV 19" />
  <para style="p">
    <verse number="1" style="v" sid="REV 19:1" />अळतेण मे ह़रगे गेथी मानो मोट्‌ली भीड़ ना माणहु ने उचा बोल सी आहयु केते ह़मळ्‌यो, “हालेलुया! छुटकारो, अने बड़ाय, ताखत अमारा भगवान नीत से। <verse eid="REV 19:1" /><verse number="2" style="v" sid="REV 19:2" />काहाके तीनो नीयाव खरलो अने वारलो से। तीहयो तीहयी छीनाळ नो, जे आह़फी नु छीनाळु सी धरती ने खत्‌तम करती हती, नीयाव कर्‌यो अने भगवान तीना चाकर्‌या ना लोय नो बदलो लेदलो से।”<note caller="+" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="DEU 32:43">वेवस्‌थावीवरन 32:43</ref>; <ref loc="2KI 9:7">2 राजा 9:7</ref></char></note> <verse eid="REV 19:2" /><verse number="3" style="v" sid="REV 19:3" />अळतेण बीजी कावा तीहया आड़ीन केदा, “हालेलुया! तीनो धपवा नो धुकरो जलमको उडतो रेहे।”<note caller="+" style="x"><char style="xo" closed="false">19:3 </char><char style="xt" closed="false"><ref loc="ISA 34:10">यसाया 34:10</ref></char></note> <verse eid="REV 19:3" /><verse number="4" style="v" sid="REV 19:4" />ता चोवीह़ पेल्‌ना वारा ना माणहु अने च्‌यारोव जीव पड़ीन भगवान ने वांदीन बड़ाय कर्‌या, जे राजगादी पोर बह र्‌यो हतो। अने तीहया केदा, “आमीन! भगवान नी बड़ाय हये!”<verse eid="REV 19:4" /></para>
  <para style="s">गाडरु ना वेवा नी पंगात</para>
  <para style="p">
    <verse number="5" style="v" sid="REV 19:5" />ता राजगादी मे गेथी एक अवाज नीकळी, “ए आखा तीना चाकर्‌या अने आखा माणहु बेम नान्‌ला अने मोट्‌ला, अमारा भगवान नी बड़ाय करो, तमु जे तीनी सी बीहो।”<note caller="+" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="PSA 115:13">भजन सहीता 115:13</ref></char></note> <verse eid="REV 19:5" /><verse number="6" style="v" sid="REV 19:6" />अळतेण मे मोट्‌ली भीड़ ने तेवी, अने घण-जबर पाणीन तेवी, अने पाणी ना गाज ने तेवी उची अवाज ह़मळ्‌यो: मे तीमने केते ह़मळ्‌यो,<note caller="+" style="x"><char style="xo" closed="false">19:6 </char><char style="xt" closed="false"><ref loc="EZK 1:24">यहेजकेल 1:24</ref></char></note> “भगवान नी बड़ाय हये! काहाके मालीक अमारो भगवान जोरभर्‌यो राजो से। <verse eid="REV 19:6" /><verse number="7" style="v" sid="REV 19:7" />आवो, आपणु खुस हय्‌न खुसी मनावया, अने मोटा काम नी लेदे तीनी बड़ाय करया, काहाके गाडरु ना वेवा आय जेला से, अने तीनी लाडी आह़फी ने तीयार कर लेदली से। <verse eid="REV 19:7" /><verse number="8" style="v" sid="REV 19:8" />तीने चोखला अने लेफड़्‌या उजळा लुगड़ा पेरवा आपला से” आहयु लेफड़्‌यु लुगड़ु नु मतलब भगवान ना माणहु ना वारला कामु नी सेलाणी से।<verse eid="REV 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="REV 19:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">19:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:2">मत्‌ती 22:2</ref>,<ref loc="MAT 22:3">3</ref></char>
    </note>ता ह़रगदुत मने केदो, “आहयु लीख, के जुगाळा तीहया से, जे गाडरु ना वेवा नु खाणु खावा बोलावला से।”<note caller="+" style="x"><char style="xo" closed="false">19:9 </char><char style="xt" closed="false"><ref loc="MAT 22:2">मत्‌ती 22:2</ref>,<ref loc="MAT 22:3">3</ref></char></note> अने ह़रगदुत मने केदो, “आहया बोलु भगवान ना खरला बोलु से।”<verse eid="REV 19:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="REV 19:10" />ता मे तीने वांदवा करीन तीना पोगु पड़्‌यो। पण तीहयो मने केदो, “देख, आसम ना करे, मे तारीन तेवो अने बीजा भरहो करन्‌या भायुन तेवोत चाकर्‌यो से, जे मसी ईसु नी गवा देवा करीन टेकला से। भगवाननेत वांद।”</para>
  <para style="p" vid="REV 19:10">काहाके ईसु नी गवाय भगवान वगे गेथी केदली वात नी आत्‌मा से।<verse eid="REV 19:10" /></para>
  <para style="s">धोळ्‌ळा घोड़ा पोर बहीन जाण्‌यो</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 19:11" />अळतेण मे ह़रग ने उगड़लु देख्‌यो, अने ता एक धोळ्‌ळा घोड़ो हतो; अने तीनी पोर बहण्‌या ने भरहो करे एवो खरलु केता हता। काहाके नीयाव भेळ तीहयो फेसलो करतो हतो। अने तीनी लड़ाय लड़े।<note caller="+" style="x"><char style="xo" closed="false">19:11 </char><char style="xt" closed="false"><ref loc="EZK 1:1">यहेजकेल 1:1</ref>; <ref loc="PSA 96:13">भजन सहीता 96:13</ref>; <ref loc="ISA 11:4">यसाया 11:4</ref></char></note> <verse eid="REV 19:11" /><verse number="12" style="v" sid="REV 19:12" />तीना डोळा एवा हता मानो आक्‌ठु नी आच से,<note caller="+" style="x"><char style="xo" closed="false">19:12 </char><char style="xt" closed="false"><ref loc="DAN 10:6">दानीयल 10:6</ref></char></note> अने तीना मुंडा पोर घण ढेरकी पागड़ी हती। तीनी पोर एक नाम लीखलु हतु, पण तीने सोड़ीन बीजु कोय नी जाणतु के तीहयु ह़ु से। <verse eid="REV 19:12" /><verse number="13" style="v" sid="REV 19:13" />तीहयो लोय मे डुबाड़ला लुगड़ा पेर र्‌यो हतो, अने तीनु नाम भगवान नो बोल हतु। <verse eid="REV 19:13" /><verse number="14" style="v" sid="REV 19:14" />ह़रगे नो मेळो धोळ्‌ळा घोड़ा पोर बहीन अने धोळ्‌ळा अने चोखला लेफड़्‌या लुगड़ा पेरीन तीनी पसळ-पसळ चाले। <verse eid="REV 19:14" /><verse number="15" style="v" sid="REV 19:15" /><note caller="+" style="x"><char style="xo" closed="false">19:15 </char><char style="xt" closed="false"><ref loc="REV 14:20">परकासीतवाक्‌य 14:20</ref></char></note>जाती-जाती ने मारवा करीन तीना मोडा मे गेथी एक धार वाळी तलवार नीकळी। तीहयो लुहड़ा नो डंडो लीन तीमनी पोर राज करहे, अने जोरभर्‌यो भगवान नी रीह नु माणलु ह़रु ना कुंड मे अंगुर रोंदळहे।<note caller="+" style="x"><char style="xo" closed="false">19:15 </char><char style="xt" closed="false"><ref loc="PSA 2:9">भजन सहीता 2:9</ref>; <ref loc="ISA 63:3">यसाया 63:3</ref>; <ref loc="JOL 3:13">योएल 3:13</ref>; <ref loc="GEN 14:20">उबजणाय कीताप 14:20</ref></char></note> <verse eid="REV 19:15" /><verse number="16" style="v" sid="REV 19:16" />तीना लुगड़ा अने ह़ातळ्‌या पोर आहयु नाम लीखलु से: “राजा नो राजा अने मालीक नो मालीक।”<verse eid="REV 19:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 19:17" />अळतेण मे एक ह़रगदुत ने दाहड़ु पोर उबो हय रेलो देख्‌यो। तीहयो उची अवाज मे आड़ीन वादळा नी वच मे उडवा वाळा आखा चड़ा ने केदो, “आवो, भगवान नु खाणु जुगु एकठा हय जावो, <verse eid="REV 19:17" /><verse number="18" style="v" sid="REV 19:18" />आवो अने राजाम नु माह, अने मुख्‌या नु माह, अने सीपायड़ा, अने घोड़ा नु अने तीमनी पोर बहण्‌या नु माह, अने ह़ु छुटला ह़ु पावर्‌या, ह़ु नान्‌ला अने ह़ु मोट्‌ला, आखा माणहु नु डील खावो।”<note caller="+" style="x"><char style="xo" closed="false">19:18 </char><char style="xt" closed="false"><ref loc="EZK 39:17-20">यहेजकेल 39:17-20</ref></char></note><verse eid="REV 19:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="REV 19:19" />अळतेण मे तीहयु जंगली जानवर, अने धरती ना राजाम ने अने तीमनी भीड़ ने तीहया घोड़ा पोर बहण्‌या अने तीनी भीड़ ह़ाते झुमायवा करीन एकठा हय रेला देख्‌यो। <verse eid="REV 19:19" /><verse number="20" style="v" sid="REV 19:20" /><note caller="+" style="x"><char style="xo" closed="false">19:20 </char><char style="xt" closed="false"><ref loc="REV 13:1-18">परकासीतवाक्‌य 13:1-18</ref></char></note>तीहयु जंगली जानवर, अने तीनी ह़ाते तीहयो झुटो भगवान वगे गेथो केण्‌यो माणहे धराय ज्‌यो, जे तीनी अगळ एवी सेलाणी देखाड़लो हतो, जीनी लारे तीहयो आमने भटकाड़लो जीनी पोर तीहयु जंगली जानवर नो सीलटप्‌पो हतो अने जे तीनी मुर्‌ती नी पुंजा करता हता। तीहया बेम जणा ने जीवते-जीव तीहयु आक्‌ठु नी दर्‌या मे, जे बारुद सी धपे, नाख देदा। <verse eid="REV 19:20" /><verse number="21" style="v" sid="REV 19:21" />अने बचला सीपायड़ा तीहया घोड़ा पोर बहण्‌या नी तलवार सी, जे तीना मोडा मे गेथी नीकळती हती, मार देदा; अने आखा चड़ा तीमना माह सी आफरी ज्‌या।<verse eid="REV 19:21" /></para>
  <chapter eid="REV 19" />
  <chapter number="20" style="c" sid="REV 20" />
  <para style="s">हजार साल</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 20:1" />अळतेण मे एक ह़रगदुत ने ह़रगे गेथो उतरते देख्‌यो, जीना हात मे पताळ खाडा नी कुची अने एक मोट्‌ली ह़ाकळ हती। <verse eid="REV 20:1" /><verse number="2" style="v" sid="REV 20:2" />तीहयो तीहया अजगर, ने मतलब पेल्‌ना गड़हा ने, जे भुतड़ो से,<note caller="+" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="GEN 1">उबजणाय कीताप</ref></char></note> ह़ाकळ वेर बांदीन एक हजार साल नी लेदे बांद देदो, <verse eid="REV 20:2" /><verse number="3" style="v" sid="REV 20:3" />ता तीहयो ह़रगदुत तीने पताळ खाडा मे नाखीन कुंड देदो अने तीने सील लगाड़ देदो के तीहयो एक हजार साल पुरा हयते तक जाती-जाती ना माणहु ने अळी नी भटकाड़े। अळतेण नख्‌खी से के थोड़ीक वार तक उगड़े।<verse eid="REV 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="REV 20:4" />अळतेण मे राजगाद्‌या देख्‌यो, अने तीमनी पोर माणहु बह ज्‌या, अने तीमने नीयाव करवा नो हक आप्‌या। अने मे तीमनी आत्‌मा ने बी देख्‌यो, जीमना मुंडा ईसु नी गवाय देवा अने भगवान ना बोलु ना कारण सी तोड़ देदला हता, अने जे नी तीहयु जानवर नी, अने नी तीनी मुर्‌ती नी पुंजा कर्‌या, अने नी आह़फाम ना नींडाळे अने हाते तीनो सीलटप्‌पो लगाड़्‌या। तीहया जीवता हय्‌न मसी ह़ाते एक हजार साल तक राज करता र्‌या।<note caller="+" style="x"><char style="xo" closed="false">20:4 </char><char style="xt" closed="false"><ref loc="DAN 7:9">दानीयल 7:9</ref>,<ref loc="DAN 7:22">22</ref></char></note> <verse eid="REV 20:4" /><verse number="5" style="v" sid="REV 20:5" />जत्‌यार तक आहया एक हजार साल पुरा नी हया तांह तक बीजा आखा मरला जीवता नी हया। आहयु ते पेल्‌नु मरीन जीव उठणु से। <verse eid="REV 20:5" /><verse number="6" style="v" sid="REV 20:6" />जुगाळा अने चोखला तीहया से, जे आहया पेली कावा जीव उठवा मे साजल्‌या से। एवा पोर बीजी मोत नो कंय बी हक नी हय, पण तीहया भगवान ना मसी अने पुंजारा बणहे अने तीनी ह़ाते एक हजार साल तक राज करहे।<verse eid="REV 20:6" /></para>
  <para style="s">भुतड़ा नु हारणु</para>
  <para style="p">
    <verse number="7" style="v" sid="REV 20:7" />जत्‌यार एक हजार साल पुरा हय जहे ता भुतड़ा ने जेल मे गेथो सोड़ देहे। <verse eid="REV 20:7" /><verse number="8" style="v" sid="REV 20:8" />अने तीहयो आखी धरती पोर फेल्‌ली जाती ने भटकाड़वा करीन नीकळ पड़हे। तीहयो गोग अने मागोग ने भटकाड़हे, तीहयो तीमने झुमायवा करीन एकठा करहे। तीमनी गीनती दर्‌या नु रेळतु बराबर रेहे। <note caller="+" style="x"><char style="xo" closed="false">20:8 </char><char style="xt" closed="false"><ref loc="EZK 7:2">यहेजकेल 7:2</ref>; <ref loc="EZK 38:2">38:2</ref>,<ref loc="EZK 38:9">9</ref>,<ref loc="EZK 38:15">15</ref></char></note> <verse eid="REV 20:8" /><verse number="9" style="v" sid="REV 20:9" />तीहया आखी धरती पोर फेलीन भगवान ना चोखला माणहु नु तम्‌बु अने मोंगाळु ह़ेर ने घेरवी लेहे अने आक्‌ठु ह़रगे गेथु उतरीन तीमने खत्‌तम करहे। <verse eid="REV 20:9" /><verse number="10" style="v" sid="REV 20:10" />तीमने भटकाड़वा वाळा भुतड़ा ने<note caller="+" style="f"><char style="fr" closed="false">20:10 </char><char style="ft" closed="false">ईबलीस</char></note> आक्‌ठु अने बारुद नी दर्‌या मे, जीनी मे तीहयु जानवर अने झुटो भगवान वगे गेथो केण्‌यो माणेह बी रेहे, नाख देहे; अने तीहया रात-दाड़ो जलमका वेला मे तड़पता रेहे।<verse eid="REV 20:10" /></para>
  <para style="s">आखरी नीयाव</para>
  <para style="p">
    <verse number="11" style="v" sid="REV 20:11" />अळतेण मे एक धोळ्‌ळी राजगादी अने तीनी पोर बह रेला ने देख्‌यो, तीनी अगळ गेथा धरती अने वादळु नाह ज्‌या, अने तीमनो पतो तक नी चाल्‌यो। <verse eid="REV 20:11" /><verse number="12" style="v" sid="REV 20:12" />अळतेण मे नान्‌ला-मोट्‌ला आखा मरला ने राजगादी अगळ उबा हय रेला देख्‌यो, अने कीताप उगाड़्‌या; अने अळतेण एक अळी कीताप उगाड़्‌या, मतलब जीवाय नी कीताप अने जेम तीहया कीताप्‌या मे लीखलु हतु, तेमेत तीमना कामु नी अनसारे मरला नो नीयाव कर्‌या।<note caller="+" style="x"><char style="xo" closed="false">20:12 </char><char style="xt" closed="false"><ref loc="DAN 7:9">दानीयल 7:9</ref>,<ref loc="DAN 7:10">10</ref></char></note> <verse eid="REV 20:12" /><verse number="13" style="v" sid="REV 20:13" />जे मरला दर्‌या मे हता तीहया मरला ने दर्‌या आप देदी, अने मोत अने पताळ बी तीहया मरला ने जे तीमनी मे हता, आप देदा; अने तीमनी माय्‌न एक-एक जणा नो तीमना कामु नी अनसारे नीयाव कर्‌या। <verse eid="REV 20:13" /><verse number="14" style="v" sid="REV 20:14" />मोत अने पताळ ने बी आक्‌ठु नी दर्‌या मे नाख देदा। आहयु आक्‌ठु नी दर्‌या बीजी मोत से; <verse eid="REV 20:14" /><verse number="15" style="v" sid="REV 20:15" />अने जे कोय नु बी नाम जीवाय नी कीताप मे लीखलु नी जड़्‌यु, तीने आक्‌ठु नी दर्‌या मे नाख्‌या।<verse eid="REV 20:15" /></para>
  <chapter eid="REV 20" />
  <chapter number="21" style="c" sid="REV 21" />
  <para style="s">नवलु वादळु अने नवली धरती</para>
  <para style="p">
    <verse number="1" style="v" sid="REV 21:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">21:1 </char>
      <char style="xt" closed="false">
        <ref loc="2PE 3:13">2 पतरस 3:13</ref>
      </char>
    </note>अळतेण मे नवलु वादळु अने नवली धरती ने देख्‌यो, काहाके पेल्‌नु वादळु अने पेल्‌नी धरती गायब हय जेली हती, अने दर्‌या बी नी हती।<note caller="+" style="x"><char style="xo" closed="false">21:1 </char><char style="xt" closed="false"><ref loc="ISA 65:17">यसाया 65:17</ref>; <ref loc="ISA 66:22">66:22</ref>; <ref loc="2PE 3:13">2 पतरस 3:13</ref></char></note> <verse eid="REV 21:1" /><verse number="2" style="v" sid="REV 21:2" /><note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="REV 3:12">परकासीतवाक्‌य 3:12</ref></char></note>अळतेण मे चोखलु ह़ेर नवलु यरुसलेम ने ह़रग मे भगवान ने तां गेथु उतरते देख्‌यो।<note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="ISA 52:1">यसाया 52:1</ref>; <ref loc="ISA 61:10">61:10</ref>; <ref loc="GEN 3:12">उबजणाय कीताप 3:12</ref></char></note> तीहयु तीहयी लाडी ह़रकु हतु जे आह़फा ना लाडा जुगु ह़ींगराय। <verse eid="REV 21:2" /><verse number="3" style="v" sid="REV 21:3" />अळतेण मे राजगादी मे गेथो काना ने उची अवाज सी आहयु केते ह़मळ्‌यो, “देख, हाव भगवान नु घोर माणहु नी वच मे से। अने तीहयो तीमनी ह़ाते रेहे, अने तीहया तीना माणहु केवायहे। अने भगवान खुद तीमनी ह़ाते रेहे अने तीमनो भगवान केवायहे।<note caller="+" style="x"><char style="xo" closed="false">21:3 </char><char style="xt" closed="false"><ref loc="EZK 37:27">यहेजकेल 37:27</ref>; <ref loc="LEV 26:11">लेव्‌यवेवस्‌था 26:11</ref>,<ref loc="LEV 26:12">12</ref></char></note> <verse eid="REV 21:3" /><verse number="4" style="v" sid="REV 21:4" />अने तीहयो तीमना डोळा ना आखा आंहवा नुस देहे। अने आनीन अळतेण मोत नी रेय, अने नी दुख, अने नी रड़वा-कलपवा नु रेय, अने नी वेला रेय; पेल्‌नी वात हाव खत्‌तम हय जी।” <note caller="+" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="ISA 25:8">यसाया 25:8</ref>; <ref loc="ISA 35:10">35:10</ref>; <ref loc="ISA 65:19">65:19</ref></char></note><verse eid="REV 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="REV 21:5" />अने जे राजगादी पोर बहलो हतो, तीहयो केदो, “देख, मे आखु कंय नवलु कर देम।” अळतेण तीहयो केदो, “लीख ले, काहाके आहयो बोल भरहो करे एवो अने खरलो से।” <verse eid="REV 21:5" /><verse number="6" style="v" sid="REV 21:6" />अळतेण तीहयो मने केदो, “आहयी वात पुरी हय ज्‌यी। मे अल्‌फा अने ओमेगा, आदी अने अन्‌त से। अने जे कोय तहरेलु से तीने मे जीवाय ना पाणी ना झोर मे गेथु फीरी मे पाणी पीवा नो हक आपही।<note caller="+" style="x"><char style="xo" closed="false">21:6 </char><char style="xt" closed="false"><ref loc="ISA 55:1">यसाया 55:1</ref></char></note> <verse eid="REV 21:6" /><verse number="7" style="v" sid="REV 21:7" />जे जीक जहे, तीहयोत आहयी चीज ने हात करहे, अने मे तीमनो भगवान केवायही अने तीहया मारा सोरा।<note caller="+" style="x"><char style="xo" closed="false">21:7 </char><char style="xt" closed="false"><ref loc="2SA 7:14">2 समुवेल 7:14</ref>; <ref loc="PSA 89:26">भजन सहीता 89:26</ref>,<ref loc="PSA 89:27">27</ref></char></note> <verse eid="REV 21:7" /><verse number="8" style="v" sid="REV 21:8" />पण बीहण्‌या, अने भरहो नी करन्‌या, गलत काम करन्‌या, हत्‌यारा, छीनाळु करन्‌या, बड़वाय, मुर्‌ती पुजा करन्‌या, अने आखा झुटा नो वाटो तीहयी दर्‌या मे जड़हे, जे आक्‌ठु अने बारुद सी धपती रेय: आहयी बीजी मोत से।”<verse eid="REV 21:8" /></para>
  <para style="s">नवलु यरुसलेम</para>
  <para style="p">
    <verse number="9" style="v" sid="REV 21:9" />अळतेण जे ह़ात ह़रगदुत पांह ह़ात आखरी गरा सी भरला ह़ात कटोरा हता, तीमनी माय्‌न एक जणो मारीन्‌तां आयो, अने मारी ह़ाते वात करीन केदो, “आंखर आव, मे तने लाडी मतलब गाडरु नी लाडी देखाड़ही।” <verse eid="REV 21:9" /><verse number="10" style="v" sid="REV 21:10" />ता मे आत्‌मा नी लारे घेरवाय ज्‌यो, अने ह़रगदुत मने एक मोट्‌ला अने उचा बड़ा पोर ली ज्‌यो, अने तीहयो मने चोखलु ह़ेर यरुसलेम देखाड़्‌यो, तीहयु भगवान भणी ह़रगे गेथु हेटु उतरतु हतु।<note caller="+" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="EZK 40:2">यहेजकेल 40:2</ref></char></note> <verse eid="REV 21:10" /><verse number="11" style="v" sid="REV 21:11" />भगवान नी बड़ाय तीमनी मे हती अने तीमनु वीजाळु<note caller="+" style="f"><char style="fr" closed="false">21:11 </char><char style="ft" closed="false">नीता वीजाळु करवा वाळु</char></note> घण मोगला दगड़ा, मतलब, पपलन्‌या दगड़ान तेवु चोखलु हतु। <verse eid="REV 21:11" /><verse number="12" style="v" sid="REV 21:12" />अने तीनी च्‌यारो-मेर एक मोट्‌लु अने उचु भीतड़ु हतु, अने तीना बारे फाटा हता, अने आखा फाटे एक-एक ह़रगदुत रखवाळ्‌या हता; अने तीहया फाटे ईस्‌रायल ना बारे घोराणा नु नाम लीखलु हतु। <verse eid="REV 21:12" /><verse number="13" style="v" sid="REV 21:13" />आनी मे गेथा तीन फाटा उगवणा, तीन फाटा धुराव, तीन फाटा दखणाव, अने तीन फाटा बुडवणा हता।<note caller="+" style="x"><char style="xo" closed="false">21:13 </char><char style="xt" closed="false"><ref loc="EZK 48:30-35">यहेजकेल 48:30-35</ref></char></note> <verse eid="REV 21:13" /><verse number="14" style="v" sid="REV 21:14" />आहयु ह़ेर बारे दगड़ा नी नीव पोर बणावलु हतु, अने एक-एक पोर गाडरु ना बारे नेवताळा ना नामु लीखला हता। <verse eid="REV 21:14" /><verse number="15" style="v" sid="REV 21:15" />जे ह़रगदुत मारी ह़ाते वात करतो हतो तीनी पांह ह़ेर अने तीना फाटा अने तीनु भीतड़ु ने मापवा जुगु एक ह़ोना नी मापवा नी ह़ोटी हती।<note caller="+" style="x"><char style="xo" closed="false">21:15 </char><char style="xt" closed="false"><ref loc="EZK 40:3">यहेजकेल 40:3</ref></char></note> <verse eid="REV 21:15" /><verse number="16" style="v" sid="REV 21:16" />तीहयु ह़ेर च्‌यार खुट्‌यु वहलु हतु अने तीहयु जेतरु चवड़ु हतु, तेतरु नाम्‌बु हतु; अने तीहयो तीहयी ह़ोना नी मापवा नी ह़ोटी सी तीहयु ह़ेर ने माप्‌यो, ता बे हजार च्‌यार ह़ोव कीलोमीटर नु नीकळ्‌यु: तीहयु नाम्‌बु उचु अने चवड़ु बराबर हतु। <verse eid="REV 21:16" /><verse number="17" style="v" sid="REV 21:17" />तीहयो तीनु भीतड़ु ने माणहु ना माफ सी जे ह़रगदुत ना हात मे हतो माप्‌यो, ता बे ह़ोव ह़ोळ्‌ळे फीट नीकळ्‌यु। <verse eid="REV 21:17" /><verse number="18" style="v" sid="REV 21:18" />तीनु भीतड़ु मोगला दगड़ा सी बणलु हतु, अने ह़ेर एवु चोखलु ह़ोनु नु हतु जे वारला काच ने तेवु हय। <verse eid="REV 21:18" /><verse number="19" style="v" sid="REV 21:19" />तीहया ह़ेर नी नीव आखा भाती ना मोगला दगड़ा सी ह़जाड़ली हती; पेल्‌नी नीव नो दगड़ो योसोब नाम नो रात्‌लो हतो, बीजी नीव नो दगड़ो नीलमणी नाम नो जामण्‌यो एवो हतो, तीसरी नीव नो दगड़ो लालड़ी नाम नो लीलोगार हतो, अने चवथी नीव नो दगड़ो मरकत नाम नो लील्‌लो एवो हतो। <verse eid="REV 21:19" /><verse number="20" style="v" sid="REV 21:20" />पांचवी नीव नो दगड़ो गोमेदक नाम नो भुरलो दगड़ो हतो, छठवी नीव नो दगड़ो माणीक्‌य नाम नो रात्‌लो हतो, ह़ातवी नीव नो दगड़ो पीतमणी नाम नो पीळ्‌ळो हतो, आंठवी नीव नो दगड़ो पेरोज नाम नो लीलोगार हतो, नव्‌वी नीव नो दगड़ो पुखराज नाम नो पीळ्‌ळो हतो, दसवी नीव नो दगड़ो लहसनीया नाम नो लीलोगार हतो, ग्‌यारवी नीव नो दगड़ो राहु नाम नो लील्‌लो हतो, बारवी नीव नो दगड़ो याकुत नाम नो जामण्‌यो हतो। <verse eid="REV 21:20" /><verse number="21" style="v" sid="REV 21:21" />बारोव फाटा बारे मोती ना हता; एक-एक फाटो एक-एक मोती नो बणलो हतो। ह़ेर नी ह़ड़क वारला काच ने तेवी चोखलु ह़ोनु नी हती<note caller="+" style="x"><char style="xo" closed="false">21:21 </char><char style="xt" closed="false"><ref loc="ISA 54:11">यसाया 54:11</ref>,<ref loc="ISA 54:12">12</ref></char></note>।<verse eid="REV 21:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="REV 21:22" />मे तीहया ह़ेर मे कानो बी मंदीर <note caller="+" style="f"><char style="fr" closed="false">21:22 </char><char style="ft" closed="false">चोखलो जागो</char></note>नी देख्‌यो, काहाके जोरभर्‌यो मालीक भगवान अने गाडरु तीमनो मंदीर से। <verse eid="REV 21:22" /><verse number="23" style="v" sid="REV 21:23" />तीहया ह़ेर मे दाहड़ु अने चांद नु वीजाळु नी जोवतु, काहाके भगवान ना तेज सी तां वीजाळु हय र्‌यु, अने गाडरु तीनो दीवो से।<note caller="+" style="x"><char style="xo" closed="false">21:23 </char><char style="xt" closed="false"><ref loc="ISA 60:19">यसाया 60:19</ref>,<ref loc="ISA 60:20">20</ref></char></note> <verse eid="REV 21:23" /><verse number="24" style="v" sid="REV 21:24" />कळी ना माणहु तीहयु वीजाळु मे चालहे फीरहे, अने धरती पोर वाळा राजा आह़फा-आह़फाम नु आखु माल-धन तीनी मे लावहे।<note caller="+" style="x"><char style="xo" closed="false">21:24 </char><char style="xt" closed="false"><ref loc="ISA 60:3">यसाया 60:3</ref></char></note> <verse eid="REV 21:24" /><verse number="25" style="v" sid="REV 21:25" />तीना झापला दीहु कारु बी नी देय, अने रात तां नी हये। <verse eid="REV 21:25" /><verse number="26" style="v" sid="REV 21:26" />माणहु जाती-जाती ना वीजाळु अने बड़ाय नु ह़मान तीनी मे लावहे।<note caller="+" style="x"><char style="xo" closed="false">21:26 </char><char style="xt" closed="false"><ref loc="ISA 60:11">यसाया 60:11</ref></char></note> <verse eid="REV 21:26" /><verse number="27" style="v" sid="REV 21:27" />पण कानी बी वीटळ्‌ळी चीज तीनी मे नी भराय सके, अने नी गलत काम करवा वाळा, अने नी झुट मेकवा वाळा मोय नी भराय सके, पण तीहया माणहु एतरात जीमनु नाम गाडरु नी जीवाय नी कीताप मे लीखलु से।<note caller="+" style="x"><char style="xo" closed="false">21:27 </char><char style="xt" closed="false"><ref loc="ISA 52:1">यसाया 52:1</ref>; <ref loc="EZK 44:9">यहेजकेल 44:9</ref></char></note><verse eid="REV 21:27" /></para>
  <chapter eid="REV 21" />
  <chapter number="22" style="c" sid="REV 22" />
  <para style="p">
    <verse number="1" style="v" sid="REV 22:1" />आनीन अळतेण तीहयो ह़रगदुत मने जीवाय आपवा वाळा पाणी नी एक नंदी देखाड़्‌यो, अने आहयी नंदी काच ने तेवी उजळी हती, तीहयी भगवान अने गाडरु नी राजगादी मे गेथी नीकळती हती।<note caller="+" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="EZK 47:1">यहेजकेल 47:1</ref>; <ref loc="ZEC 14:8">जकर्‌याह 14:8</ref></char></note> <verse eid="REV 22:1" /><verse number="2" style="v" sid="REV 22:2" />तीहया नंदी ह़ेर नी ह़ड़क नी वचा-वच वयती हती। नंदी नी बेम धेड़े जीवाय नु झाड़ हतु। तीहया झाड़के हर साल बारे कावा फोळ फालता हता। एक मयना मे एक वार, अने तीहयु झाड़ ना पान्‌टा वेर जाती-जाती ना माणहु आरगा हयता हता।<note caller="+" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="GEN 2:9">उबजणाय कीताप 2:9</ref>; <ref loc="EZK 47:12">यहेजकेल 47:12</ref></char></note><verse eid="REV 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="REV 22:3" />अने तीहया ह़ेर मे कोय बी भगवान ना सराप मे नी रेय, अने भगवान अने गाडरु नी राजगादी तीहया ह़ेर मे रेहे, अने तीमना चाकर्‌या तीमनी बड़ाय करहे।<note caller="+" style="x"><char style="xo" closed="false">22:3 </char><char style="xt" closed="false"><ref loc="ZEC 14:11">जकर्‌याह 14:11</ref></char></note> <verse eid="REV 22:3" /><verse number="4" style="v" sid="REV 22:4" />तीहया तीनु मोडु देखहे, अने तीनु नाम तीमना नींडाळे लीखलु रेहे। <verse eid="REV 22:4" /><verse number="5" style="v" sid="REV 22:5" />अळतेण रात नी हये, अने तीमने दीवा नु अने दाहड़ु नु वीजाळु नी जरवत नी रेय, काहाके मालीक भगवान तीमने वीजाळु आपहे, अने तीहया राजान तेम जलमका राज करहे।<note caller="+" style="x"><char style="xo" closed="false">22:5 </char><char style="xt" closed="false"><ref loc="ISA 60:19">यसाया 60:19</ref>; <ref loc="DAN 7:18">दानीयल 7:18</ref></char></note><verse eid="REV 22:5" /></para>
  <para style="s">ईसु नु आवणु</para>
  <para style="p">
    <verse number="6" style="v" sid="REV 22:6" />अळतेण ह़रगदुत मने केदो, “आहयी वात भरहा नी लायक अने खरली से। अने मालीक भगवान जे भगवान वगे गेथा केण्‌या माणहु ने आह़फा नी आत्‌मा आपे, आह़फा ना ह़रगदुत ने आनीन करते मोकल्‌यो के आह़फा ना चाकर्‌या ने तीहयी वात, जे घण छोटी पुरी हयवात वाळी से, देखाड़े।”<verse eid="REV 22:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="REV 22:7" />“देख, मे छोटोत आव्‌वा वाळो से! जुगाळा से तीहया, जे आहयी कीताप नी भगवान नी केदली वात माने।”<verse eid="REV 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="REV 22:8" />मे तीहयोत युहन्‌नो से, जे आहयी वात ह़मळतो अने देखतो हतो। जत्‌यार मे ह़मळ्‌यो अने देख्‌यो, ता जे ह़रगदुत मने आहयी वात देखाड़तो हतो, मे तीनी भक्‌ती करवा करीन तीना पोगु मे पड़ ज्‌यो। <verse eid="REV 22:8" /><verse number="9" style="v" sid="REV 22:9" />पण तीहयो मने केदो, “देख, आसम ना करे; काहाके मे तारो, अने तारा भायु भगवान वगे गेथी वात केण्‌या, अने आहयी कीताप नी वात ने मानवा वाळान तेवो चाकर्‌यो से। भगवान नीत बड़ाय कर।” <verse eid="REV 22:9" /><verse number="10" style="v" sid="REV 22:10" />अळतेण तीहयो मने केदो, “आहयी कीताप नी भगवान वगे गेथी केदली वात ने ह़ताड़ीन ना राखे;<note caller="+" style="f"><char style="fr" closed="false">22:10 </char><char style="ft" closed="false">नीता पोर सीलटप्‌पो ना लगाड़े</char></note> काहाके आहयी आखी वातु नी पुरी हयवा नी टेम घणी ह़ाते से। <verse eid="REV 22:10" /><verse number="11" style="v" sid="REV 22:11" />जे गलत करे, तीहयो गलतेत करतो रेय; अने जे पापी से, तीहयो पापीत बणीन रेय; अने जे वारु करे, तीहयो वारलुत करतो रेय; अने जे चोखलो से, तीहयो चोखलोत बणलो रेय।<note caller="+" style="x"><char style="xo" closed="false">22:11 </char><char style="xt" closed="false"><ref loc="DAN 12:10">दानीयल 12:10</ref></char></note>”<verse eid="REV 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="REV 22:12" />“देख!” मे छोटोत आव्‌वा वाळो से; अने एक-एक माणहे ना काम नी अनसारे बदला मे आपवा जुगु फोळ मारी पांह से।<note caller="+" style="x"><char style="xo" closed="false">22:12 </char><char style="xt" closed="false"><ref loc="ISA 40:10">यसाया 40:10</ref>; <ref loc="ISA 62:11">62:11</ref>; <ref loc="PSA 28:4">भजन सहीता 28:4</ref>; <ref loc="JER 17:10">यीरम्‌या 17:10</ref></char></note> <verse eid="REV 22:12" /><verse number="13" style="v" sid="REV 22:13" /><note caller="+" style="x"><char style="xo" closed="false">22:13 </char><char style="xt" closed="false"><ref loc="REV 1:8">परकासीतवाक्‌य 1:8</ref>; </char><char style="xt" closed="false"><ref loc="REV 1:17">परकासीतवाक्‌य 1:17</ref>; <ref loc="REV 2:8">2:8</ref></char></note>मे अल्‌फा अने ओमेगा, पेल्‌नो अने आखरी, आदी अने अन्‌त से।<note caller="+" style="f"><char style="fr" closed="false">22:13 </char><char style="ft" closed="false">उबजणाय कीताप 18:17; 2:8; यसाया 44:6; 48:12</char></note><verse eid="REV 22:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="REV 22:14" />जुगाळा तीहया से, जे आह़फा ना लुगड़ा धोय लेय, काहाके तीमने जीवाय ना झाड़ नो फोळ खावा नो हक जड़हे, अने तीहया फाटा पोर माय्‌न ह़ेर मे भरायहे।<note caller="+" style="x"><char style="xo" closed="false">22:14 </char><char style="xt" closed="false"><ref loc="GEN 2:9">उबजणाय कीताप 2:9</ref>; <ref loc="GEN 3:22">3:22</ref></char></note> <verse eid="REV 22:14" /><verse number="15" style="v" sid="REV 22:15" />पण कुतरा, अने बड़वाय करन्‌या, अने छीनाळु करन्‌या, अने हत्‌यारा अने मुर्‌ती पुजण्‌या, अने एक-एक जे झुट सी खुस रेवा वाळा बाहर री जहे।<verse eid="REV 22:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="REV 22:16" />“मे ईसु मारा ह़रगदुत ने आनीन करते मोकल्‌यो के तमारी अगळ मंडळी ना बारा मे आहयी वात नी गवाय देय। मे दावुद ना घोराणा नी अवल्‌यात से, अने परगड़ फाटे नो पपलत्‌लो तारो से।<note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="ISA 11:1">यसाया 11:1</ref>,<ref loc="ISA 11:10">10</ref></char></note>”<verse eid="REV 22:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="REV 22:17" />आत्‌मा अने लाडी बेम केय, “आव!”</para>
  <para style="p" vid="REV 22:17">अने ह़मळवा वाळो बी केय, “आव!”</para>
  <para style="p" vid="REV 22:17">जे तरहेलो से तीहयो आवे, अने जीने गमे तीहयो जीवाय नु पाणी ईलाम फीरी मे पीय।<note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="ISA 55:1">यसाया 55:1</ref></char></note><verse eid="REV 22:17" /></para>
  <para style="s">आखरी</para>
  <para style="p">
    <verse number="18" style="v" sid="REV 22:18" />मे युहन्‌नो एक-एक माणहे ने, जे आहयी कीताप नी भगवान वगे गेथी केदली वात ने ह़मळे, चेतावणी आपु: कदीम कानु माणहु आहयी वात मे कंय बी जादा भेसके ता भगवान तीहयी गरा ने, जे आहयी कीताप मे लीखली से, तीनी पोर मोकल देहे। <verse eid="REV 22:18" /><verse number="19" style="v" sid="REV 22:19" />कदीम कोय आहयी भगवान वगे गेथी केदली वात नी कीताप नी वात मे गेथु कंय बी नीकाळ देय, ता भगवान तीहया जीवाय ना झाड़ अने चोखला ह़ेर मे गेथो, जीना बारा मे आहयी कीताप मे देखाड़लु से, तीनो वाटो नीकाळ देहे।<verse eid="REV 22:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="REV 22:20" />ईसु जे आहयी वात नो गवा से, तीहयो केय, “होव, मे छोटोत आव्‌वा वाळो से।” आमीन। ए मालीक ईसु आव!<verse eid="REV 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="REV 22:21" />मालीक ईसु नी दया भगवान ना माणहु ह़ाते रेय। आमीन।<verse eid="REV 22:21" /></para>
  <chapter eid="REV 22" />
</usx>