<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2PE" style="id">- Paliya</book>
  <para style="h">2 पतरस</para>
  <para style="toc3">2 पतरस</para>
  <para style="toc2">2 पतरस</para>
  <para style="toc1">पतरस नी बीजी चीट्‌ठी</para>
  <para style="mt2">पतरस की दुसरी पत्री</para>
  <para style="mt1">पतरस नी बीजी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">2 पतरस नी चीट्‌ठी मे केदलु से के आहयी नेवताळा पतरस नी लारे लीखली हती, बाखीन आज ना कंय डायला ने आहयु नी लागतु के आहयु ह़ाचली से। आहयु हय सके के कानो अळी बीजो पतरस ने भणी गेथो लीख्‌यो हय। लीखण्‌यो केय के तीहयो ईसु ना जीवाय अने खास कारण सी बदलवा नी लेदे एक उजन्‌तु करलो हतो। <char style="xt"><ref loc="2PE 1:17-18">1:17-18</ref></char> कदी पतरस चीट्‌ठी लीख्‌यो हहे ता हय सके के तीहयो रोम ह़ेर मे 65-69 साल अळतेण ईसु मसी ने पयदा हयवान अळतेण लीख्‌यो हहे। पतरस 1 पतरस नी चीट्‌ठी नी अळतेण लीखवा नी तारीक राखीन आपणी बीजी चीट्‌ठी बी लीख्‌यो <char style="xt"><ref loc="2PE 3:1">3:1</ref></char>।</para>
  <para style="ip">तीहयो आखा ईसु पोर भरहो करन्‌या ना बारा मे चीट्‌ठी मे देखाड़्‌यो। पतरस आहयी चीट्‌ठी ने वारली जीवाय जीव्‌वा नी लेदे तीयारी करवा नी लेदे लीख्‌यो अने तीमने चेतावणी आप्‌यो के तीहया झुटा गुरु नी वात ने नी माने। <char style="xt"><ref loc="2PE 1">2 पतरस</ref></char> तीहयो तीहया माणहु ने वण-देख्‌या करवा नी लेदे तीयार कर्‌यो जे बचाड़ र्‌यो ईसु पासो आव्‌वा मे घणी टेम ली र्‌यो। आनी कारण सी तीहयो उजन्‌तु कर्‌यो के भगवान धीरो नी हय पण आखा ने बचाड़वा चाहत्‌लो <char style="xt"><ref loc="2PE 3:8-9">2 पतरस 3:8-9</ref></char> आहयी एक वारली जीवाय जीव्‌वा नो एक कारण से। <char style="xt"><ref loc="2PE 3:14">3:14</ref></char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पतरस आह़फो आपणा भणवा वाळा ना बारा मे देखाड़े। <char style="ior"><ref loc="2PE 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. अळी तीहयो तीमने वारली जीवाय जीव्‌वा नी फोम करावे काहाके भगवान आमने अगळ कर्‌यो। <char style="ior"><ref loc="2PE 1:3-21">1:3-21</ref></char></para>
  <para style="io1">3. अळतेण तीहयो झुटी वात ह़ीकाड़न्‌या ना वीरोद मे चेतावणी आपे अळी केय के आखरी मे झुटी वात ह़ीकाड़न्‌या ना ह़ाते ह़ु हयहे। <char style="ior"><ref loc="2PE 2:1-22">2:1-22</ref></char></para>
  <para style="io1">4. तीनी अळतेण पतरस ईसु बीजी कावा आव्‌वा नी लेदे तीयार हयवा नी लेदे वारली जीवाय जीव्‌वा नी लेदे भरहो करन्‌या ने तीयार कर्‌यो। <char style="ior"><ref loc="2PE 3:1-17">3:1-17</ref></char></para>
  <chapter number="1" style="c" sid="2PE 1" />
  <para style="s">वारला से के केम</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 1:1" />सीमोन पतरस भणी गेथी जे मसी ईसु नो नेवताळो अने चाकर्‌यो से तीहया माणहु ना नामे जे अमारा भगवान अने छुटकारो आपण्‌या ईसु मसी ना धरम सी अमारीन तेवो घण मोगो भरहो हात करला से।<verse eid="2PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2PE 1:2" />भगवान नी अने अमारा ईसु मसी नी ओळखाण ना लारे संयबरकत अने सांती तमारी मे घणीत बड़ती जाय।<verse eid="2PE 1:2" /></para>
  <para style="s">भगवान नो बोलावो अने टाळे</para>
  <para style="p">
    <verse number="3" style="v" sid="2PE 1:3" />काहाके ईसुत भगवान नी सक्‌ती आखु कंय जे जीवाय अने भक्‌ती मे जे कंय जोवे आमने तीनीत ओळखाण नी लारे आपलो से, जे आमने तीनीत बड़ाय अने वारला गुण सी बोलावलो से। <verse eid="2PE 1:3" /><verse number="4" style="v" sid="2PE 1:4" />जीमनी लारे तीहयो आमने घण मोगु अने घण मोटो वायदो आपलो से: काहाके तीमनी लारे तमु तीहया गलत वात अने कामु सी छुटीन, जे कळी मे गलत लालच सी हये, अने तमु भगवान नी तेम वेहवार ना साजल्‌या बण जावो। <verse eid="2PE 1:4" /><verse number="5" style="v" sid="2PE 1:5" />एतरे तमु आखी भात्‌ये काळ्‌जी करीन, तमारा भरहा मे वारला गुण ने जोड़ो अने वारला गुण मे ग्‌यान ने। <verse eid="2PE 1:5" /><verse number="6" style="v" sid="2PE 1:6" />अने ग्‌यान मे गम राखो अने गम मे धीरज राखो अने धीरज मे भक्‌ती। <verse eid="2PE 1:6" /><verse number="7" style="v" sid="2PE 1:7" />अने भक्‌ती पोर भाय-बेन्‌या नो मोंग, अने भाय-बेन्‌या मे मोंग मे वदाड़ता जावो। <verse eid="2PE 1:7" /><verse number="8" style="v" sid="2PE 1:8" />काहाके आहया वारला गुण नी जरवत से, अने कदीम आहयी वात तमारी मे घण-जबर से ता आहयु तमने आपणा ईसु मसी नी अक्‌कल मजबुत बणावहे। <verse eid="2PE 1:8" /><verse number="9" style="v" sid="2PE 1:9" />काहाके जीनी मे आहयी वात नी हय, तीहयो आंदळो से अने धुंदळु देखे, अने तारा पेल्‌ना पाप धोय्‌न चोखो करलो तीहयु भुल ज्‌यो।<verse eid="2PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 1:10" />एतरे ए भाय-बेन्‌या, आपणु ने बोलायो अने टाळ लेदो तीने उजन्‌तु करवा आखी भाते कोसीत करता जावो काहाके कदीम आसम करहु ता कदी ठोकर नी खावो। <verse eid="2PE 1:10" /><verse number="11" style="v" sid="2PE 1:11" />पण आहयीत रीते आपणा मालीक अने छुटकारो आपण्‌या ईसु मसी ना अमरकाय राज मे घण-जबर ईज्‌जत भेळ भरायहु<verse eid="2PE 1:11" /></para>
  <para style="s">पतरस नी आखरी टेम</para>
  <para style="p">
    <verse number="12" style="v" sid="2PE 1:12" />भले तमु आहयी आखी वात जाणो, अने जे सच्‌चाय नो बोल तमने जड़लो से, तीहयी सच्‌चाय पोर टेकला बी से, ते बी मे तमने आहयी वात फोम कराव्‌वा करीन जलम तीयार रेही। <verse eid="2PE 1:12" /><verse number="13" style="v" sid="2PE 1:13" />मे आहयु आपणी जुगु वारु ह़मजाड़ु के जत्‌यार तक तम्‌बुन तेवा डील मे से तत्‌यार तक तमने फोम करावी-करावीन चेताय्‌न राखु। <verse eid="2PE 1:13" /><verse number="14" style="v" sid="2PE 1:14" />काहाके आहयु जाणु के मारा तम्‌बु ने ओदार नाखवा नी टेम छोटीत आव्‌वा वाळी से, जेम के आपणो ईसु मसी मारी पोर उजन्‌ती करलो से। <verse eid="2PE 1:14" /><verse number="15" style="v" sid="2PE 1:15" />आनीन करते मे आसम कोसीस करही के मने कय करवान बाद तमु आहयी आखी वातु ने सदा फोम राख सको।<verse eid="2PE 1:15" /></para>
  <para style="s">मसी नी बड़ाय ना डोळा देखे गवाय</para>
  <para style="p">
    <verse number="16" style="v" sid="2PE 1:16" />काहाके जत्‌यार आमु तमने आपणा मालीक ईसु मसी नी ताखत नी अने आव्‌वा ना बारा मे खबर आपला से, ता तीहयी मन घड़्‌याण काहणी नो दाखलो नी हतो पण आमुत तीना ह़ेक ने देखला। <verse eid="2PE 1:16" /><verse number="17" style="v" sid="2PE 1:17" /><note caller="+" style="x"><char style="xo" closed="false">1:17 </char><char style="xt" closed="false"><ref loc="MAT 17:1-5">मत्‌ती 17:1-5</ref>; <ref loc="MRK 9:2-7">मरकुस 9:2-7</ref>; <ref loc="LUK 9:28-35">लुका 9:28-35</ref></char></note>काहाके जत्‌यार तीहयो भगवान बाह सी ईज्‌जत अने बड़ाय हात कर्‌यो अने तीहया ह़ेक वाळा बड़ाय मे गेथी आहयी अवाज आयी, “आहयो मारो मोंगाळ्‌ळो सोरो से जीनी सी मे खुस से।” <verse eid="2PE 1:17" /><verse number="18" style="v" sid="2PE 1:18" />तत्‌यार आमु तीनी ह़ाते चोखला बड़ा पोर हता, ता ह़रगे गेथी आहयी अवाज आवते ह़मळ्‌या।<verse eid="2PE 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="2PE 1:19" />अमारी पांह जे भगवान भणी गेथा केण्‌या माणहु ना बोलु से, तीहयो आहयी घटना सी तीहयो वातड़ो हय ज्‌यो। तमु आहयु वारु करो के जे आहयु ह़मजीन तीनी पोर धीयान करो, के तीहयो एक दीवो से, जे अंदारला जागा मे तीहयी टेम तक वीजाळु आपे जत्‌यार तक के परगण नी फाटे अने भळ-भाके नो तारो तमारा मन मे वीजाळु नी करे देय। <verse eid="2PE 1:19" /><verse number="20" style="v" sid="2PE 1:20" />पण पेले तमु आहयु जाण लेवो, के चोखली सास्‌तर नी भगवान वगे गेथी केदली वात कोयना आह़फात ना वीच्‌यार ना आधार पोर पुरी नी हये <verse eid="2PE 1:20" /><verse number="21" style="v" sid="2PE 1:21" />कानी बी भगवान वगे गेथी केदली वात माणेह नी मरजी सी कदी नी हयी पण भगत माणहु चोखली आत्‌मा ना सत मे भगवान भणी गेथा बोलत्‌ला।<verse eid="2PE 1:21" /></para>
  <chapter eid="2PE 1" />
  <chapter number="2" style="c" sid="2PE 2" />
  <para style="s">झुटा मास्‌तर्‌या अने भगवान वगे गेथा केण्‌या माणहु</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 2:1" />जीसम तीमनी मे झुटा भगवान वगे गेथी वात करन्‌या हता, तेमेत तमारी मे झुटा ह़ीकाड़न्‌या हयहे। खत्‌तम करवा वाळा वेरी नी सुरुवात ह़ताय-ह़ताय्‌न करहे, अने तीहया मालीक ने जे तीमने वेचाता लेदलो से नीकारो करहे अने आह़फाम ने छोटोत खत्‌तम करवा नो कारण बणहे। <verse eid="2PE 2:1" /><verse number="2" style="v" sid="2PE 2:2" />अने घणा ढेरका तीमनीन तेम लुच्‌चाय करहे, अने तीनी लेदे सच्‌चाय नी वाट नो वाक काडहे। <verse eid="2PE 2:2" /><verse number="3" style="v" sid="2PE 2:3" />तीहया लालच जुगु झुटी वात करीन तमने आह़फा ना फायदा नो कारण बणावहे, अने जे डंड नो हुकम तीमनी पोर पेले सी हय जेलो से; तीनी आव्‌वा नी कंय बी वार नी हय, अने खत्‌तम हयणु उंगाय नी।<verse eid="2PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="2PE 2:4" />काहाके जत्‌यार भगवान तीहया ह़रगदुतु ने जे पाप नी कर्‌या सोड़्‌यो, पण हातकड़ी मे बांदीन नरक अने अंदारला कुंड मे नाख देदो, काहाके नीयाव ना दाड़े लग बंदायलो रेय। <verse eid="2PE 2:4" /><verse number="5" style="v" sid="2PE 2:5" />अने पेल्‌ना वारा नी कळ ने बी नी सोड़्‌यो बाखीन भक्‌ती नी करन्‌याण कळ पोर मुसळधार पाणी मोकल्‌यो पण धरम नो परच्‌यार करन्‌या नुहा समेत आंठ जणा ने बचाड़ लेदो; <verse eid="2PE 2:5" /><verse number="6" style="v" sid="2PE 2:6" />अने सदोम अने अमोरा ना ह़ेर ने नास नो एवो डंड आप्‌यो, के तीने खत्‌तम करीन रोखड़ा मे मीलाय देदो, काहाके तीहया आव्‌वा वाळा भक्‌ती नी करवा वाळा माणहु ह़ीकाड़वा ना लेदे दाखलो बणे। <verse eid="2PE 2:6" /><verse number="7" style="v" sid="2PE 2:7" />अने धरमी लुत ने जे अधरमी ना वीटळ्‌ळा चाल-चलण सी घणो दुखी हतो छुटकारो आप्‌यो। <verse eid="2PE 2:7" /><verse number="8" style="v" sid="2PE 2:8" />काहाके तीहयो धरमी तीमना वच मे रेतो जाय्‌न तीमना अधरम ना कामु ने देखी देखीन अने ह़मळी ह़मळीन दाड़ीन आपणा सच्‌चा मन ने दुखी करतो हतो। <verse eid="2PE 2:8" /><verse number="9" style="v" sid="2PE 2:9" />ता मालीक भक्‌ती करन्‌या ने पारख गेथा नीकाळ लेय अने अधरमी ने नीयाव ना दाड़े लग डंड जड़े एवी दसा मे राखवा बी जाणे।<verse eid="2PE 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 2:10" />खास करीन तीहया जे वीटळ्‌ळी हेर नी पसळ डील ना अनसारे चाले अने बड़ाय ने हेटी जाणे। तीहया घमंडी अने हटाळा से, अने उचा पद वाळा ने बुरु-भलु केवा नी बीहे। <verse eid="2PE 2:10" /><verse number="11" style="v" sid="2PE 2:11" />ते बी ह़रगदुत जे सक्‌ती अने ताखत मे तीमनी सी मोटा से, मालीक ना अगळ तीमने बुरु-भलु कीन गुनो नी लगाड़े। <verse eid="2PE 2:11" /><verse number="12" style="v" sid="2PE 2:12" />पण आहया माणहु अक्‌कल वगर ना जानवर ने तेवा से, जे धरायवा अने खत्‌तम हयवा करीन पयदा हयला से; अने जे वातु ने नी जाणता तीना बारा मे बीजा ने भलु-बुरु केय तीहया आह़फा नी ह़ड़ मे आह़फात ह़ड़ जहे। <verse eid="2PE 2:12" /><verse number="13" style="v" sid="2PE 2:13" />बीजा नु बुरु करवा नी बदले तीमनुत बुरु हयहे, तीमने आखो दाड़ो गलत काम करवा वारु लागे आहयु नामबद्‌दी अने गुनो से, जत्‌यार तीहया तमारी ह़ाते खाय-पीय ता आह़फा नी भणी गेथु मोंगाळु खाणु से करीन मोज-मजा करे। <verse eid="2PE 2:13" /><verse number="14" style="v" sid="2PE 2:14" />तीमना डोळा मे छीनाळु भरायलु से, अने तीहया पाप कर्‌या वगर रोकाय बी नी सके। तीहया भोळा मन वाळा ने पटाड़ लेय, तीमना मन ने पटाड़वा नी जानकारी हय जेली से तीहया सराप ना सोरा से। <verse eid="2PE 2:14" /><verse number="15" style="v" sid="2PE 2:15" />तीहया ह़ुदला रोहा सी भटक जेला से, अने बीवोर ना सोरो बीलाम ना रोहा पोर हय लेदला से, जे गलत काम नी दाड़की ने वारु ह़मज्‌यो। <verse eid="2PE 2:15" /><verse number="16" style="v" sid="2PE 2:16" />पण तीना गुना ना बारा मे फटकार बी जड़ी, आञे तक के गुंगी गदड़ी माणेह नी बोली सी तीहया भगवान वगे गेथी वात केण्‌या माणेह ने तीनी सण्‌का सी रोकी।<verse eid="2PE 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 2:17" />आहया माणहु ह़ुकला कुवान तेवा अने आंजी ना उडाड़ला वादळा से, तीमनी जुगु हमेसा नी लेदे घण जबर अंदारलु मेकलु से। <verse eid="2PE 2:17" /><verse number="18" style="v" sid="2PE 2:18" />तीहया रीकामी घमंड नी वात करी-करीन लुच्‌चाय ना कामु नी लारे, तीहया माणहु ने आहयी डील नी लालच मे फसाड़ लेय, जे भटकला मे गेथा हाव नीकळवा नी सुरुवातेत कर र्‌या। <verse eid="2PE 2:18" /><verse number="19" style="v" sid="2PE 2:19" />आहया तीमने छुटकारा नो वायदो ते करे, पण तीहया आह़फात ह़ड़लु ना पावर्‌यो से। माणेह तीनोत पावर्‌यो बण जाय, जीनी सी तीहयो हार जाय। <verse eid="2PE 2:19" /><verse number="20" style="v" sid="2PE 2:20" />जत्‌यार तीहया मालीक अने छुटकारो आपण्‌या ईसु मसी नी ओळखाण नी लारे कळी नी आखी भाती नी वीटळ सी बच नीकळ्‌या, अने अळतेण तीमनी मे फसीन हार ज्‌या, ता तीमनी पासली हालत पेल्‌नी गेथी बी खराब हय ज्‌यी। <verse eid="2PE 2:20" /><verse number="21" style="v" sid="2PE 2:21" />काहाके धरम नी वाट ने नी ओळखवात तीमनी जुगु आनी सी वारु रेतु के तीने ओळखीन तीहया चोखला हुकम सी फीर जता जे तीमने ह़ोपलो हतो। <verse eid="2PE 2:21" /><verse number="22" style="v" sid="2PE 2:22" />तीमनी पोर बी तीहयुत वीत्‌यु जीसम कवाड़ा मे बी लीखलु से तीहयु ह़ाची से, “कुतरु ओखळीन आह़फुत पासु चाट लेय” अने “एक उंगळावली ह़ुवर्‌याण पासी पोणा मे जत रेय।”<verse eid="2PE 2:22" /></para>
  <chapter eid="2PE 2" />
  <chapter number="3" style="c" sid="2PE 3" />
  <para style="s">मालीक नो पासो आव्‌वा नो वायदो</para>
  <para style="p">
    <verse number="1" style="v" sid="2PE 3:1" />ए मोंगाळ्‌ळा, हाव मे तमने बीजी चीट्‌ठी लीखु, अने बेम चीट्‌ठी मे फोम करावु तमारा चोखला मन मे वारला वीच्‌यार पयदा करवा बाज र्‌यो। <verse eid="2PE 3:1" /><verse number="2" style="v" sid="2PE 3:2" />के तमु तीहयी वातु ने जे चोखला भगवान वगे गेथा केण्‌या माणहु पेले गेथात केदला से, अने भगवान अने छुटकारो आपण्‌या ना तीहया हुकम ने फोम करो जे तमारा नेवताळा ना लारे आपला हता। <verse eid="2PE 3:2" /><verse number="3" style="v" sid="2PE 3:3" /><note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="JUD 1:18">यहुदा 1:18</ref></char></note>पेले आहयु जाण लेवो के आखरी दाड़ा मे ठट्‌टा करवा वाळा आवहे जे आह़फाम नी लालच नी अनसारे चालहे। <verse eid="2PE 3:3" /><verse number="4" style="v" sid="2PE 3:4" />अने तीहया पुछहे, “तीने आव्‌वा नो वायदो कां जत र्‌यो? काहाके जत्‌यार गेथा आड़ा-बुड़ा मर जेला से, आखु तेमेत से जीसम धरती बणली ने हतु।” <verse eid="2PE 3:4" /><verse number="5" style="v" sid="2PE 3:5" />तीहया ते जाण बुजीन आहयु भुल ज्‌या के भगवान ना बोल ना लारे ह़रग पेले गेथुत बणलु से, अने धरती बी पाणी मे गेथी बणावली से अने पाणी नी लारे, <verse eid="2PE 3:5" /><verse number="6" style="v" sid="2PE 3:6" />आनीन करते तीहया जमाना नी कळ पाणी मे डुबीन खत्‌तम हय जेली। <verse eid="2PE 3:6" /><verse number="7" style="v" sid="2PE 3:7" />पण हमणे नी टेम ना ह़रग अने कळी तीहया भगवान ना बोलु नी लारे आनीन जुगु मेकला से, के धपाड़ देय; अने तीहया भक्‌ती नी करन्‌या माणहु ना नीयाव अने खत्‌तम हयवा ना दाड़े तक आसमेत मेकला रेहे।<verse eid="2PE 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="2PE 3:8" />ए मोंगाळ्‌ळा आहयी वात तमु ना भुलो के मालीक नी नजर मे एक दाड़ो हजार साल बराबर से अने हजार साल एक दाड़ा बराबर से। <verse eid="2PE 3:8" /><verse number="9" style="v" sid="2PE 3:9" />मालीक आह़फा ना आव्‌वा ना वायदा मे वार नी करे, जीसम कय माणहु ह़मजे; पण तमारा बारा मे धीरज धरे अने आसम नी चाहतो के कोय खत्‌तम हये, बाखीन आखा ने मन फीराव्‌वा नो मोखो जड़े।<verse eid="2PE 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="2PE 3:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:43">मत्‌ती 24:43</ref>; <ref loc="LUK 12:39">लुका 12:39</ref>; <ref loc="1TH 5:2">1 थीसलुनीकीयो 5:2</ref>; <ref loc="REV 16:15">परकासीतवाक्‌य 16:15</ref></char>
    </note>पण मालीक ना आव्‌वा नो दाड़ो चोट्‌टान तेम आवहे, तीहया दाड़े ह़रग होड़ो-होड़ो अवाज करतु जाय्‌न खत्‌तम हय जहे, अने ह़रग नी चीज आक्‌ठु सी धप जहे खत्‌तम हय जहे अने धरती अने तीनी पोर ना काम धप जहे। <verse eid="2PE 3:10" /><verse number="11" style="v" sid="2PE 3:11" />आहयी आखी चीज आहयीत रीते खत्‌तम हय जहे ता तमु चोखली चाल-चलण अने भक्‌ती मे केवा माणहु रेवा जोवे? <verse eid="2PE 3:11" /><verse number="12" style="v" sid="2PE 3:12" />अने भगवान ना तीहया दाड़ा नी वाट कानी रीते जोव्‌वा जोवे, अने तीने छोटो आव्‌वा नी करते कीसम कोसीत करवा जोवे, जीना कारण वादळु आक्‌ठु सी ओगळ जहे अने वादळु ना तारागण घणा उना हय्‌न गळ जहे। <verse eid="2PE 3:12" /><verse number="13" style="v" sid="2PE 3:13" /><note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="REV 21:1">परकासीतवाक्‌य 21:1</ref></char></note>पण तीना वायदा ना अनसारे आमु एक नवलु ह़रग अने नवली धरती नी आह कर र्‌या, तां नीस्‌तु वारलु रेहे।<verse eid="2PE 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="2PE 3:14" />आनीन करते, ए मोंगाळ्‌ळा, जत्‌यार तमु आहया दाड़ा नी आह कर र्‌या, ता कोसीस करो के तमु सांती सी भगवान नी नींगा मे वारला अने वण-गुनाळ्‌ळा नीकळो। <verse eid="2PE 3:14" /><verse number="15" style="v" sid="2PE 3:15" />अने अमारा मालीक नी धीरज ने तमारा छुटकारा जुगु आपलो मोखो ह़मजो, जीसम अमारा मोंगाळ्‌ळो भाय पोलुस बी तीहया ग्‌यान ना अनसारे तमने लीख्‌यो जे तीने भगवान ने तां गेथो जड़लो हतो। <verse eid="2PE 3:15" /><verse number="16" style="v" sid="2PE 3:16" />तेमेत तीहयो आह़फा नी आखी चीट्‌ठी मे आहयी वात ना बारा मे लीखलो से। तीनी मे कय वात आसवी से जीने ह़मजवा काठु से, नी भणला अने हुस्‌यार माणहु तीमना मतलब बी चोखली सास्‌तर ने तेम मानीन खुद नो नास नो कारण बणावे।<verse eid="2PE 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2PE 3:17" />ए मोंगाळ्‌ळा, तमु ते पेलेत गेथा आहयी वात ने जाणीन चेतीन रेवो। अधरमी माणहु ना चाल मे फसीन कंय माय्‌न आह़फा नी टणकाय ने हात सी नी खोय देवो। <verse eid="2PE 3:17" /><verse number="18" style="v" sid="2PE 3:18" />एतरे आपणा मालीक अने छुटकारो आपण्‌या ईसु मसी नी दया अने ग्‌यान मे वदता जावो, तीनीत बड़ाय हमणे बी हये, अने जलम पीड़ीडीट हयती रेय; आमीन।<verse eid="2PE 3:18" /></para>
  <chapter eid="2PE 3" />
</usx>