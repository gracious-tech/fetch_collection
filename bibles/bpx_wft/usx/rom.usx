<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ROM" style="id">- Paliya</book>
  <para style="h">रोमीयो</para>
  <para style="toc3">रोमीयो</para>
  <para style="toc2">रोमीयो</para>
  <para style="toc1">रोमीयो ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="mt2">रोमीयों के नाम पोलुस की पत्री</para>
  <para style="mt1">रोमीयो ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">रोमीयो नी कीताप लग-भग नेवताळो पोलुस 54-58 साल नी आड़े-धेड़े ईसु मसीन पयदा हयवान अळतेण लीखलो हतो, पोलुस हजु तक रोम ह़ेर मे नी जेलो हतो, करीन तीहयो आहयी चीट्‌ठी रोम ह़ेर मे भरहो करन्‌या माणहु ने खबर आपवा करीन ली मोकल्‌यो, बेम युहद्‌या अने आड़जात्‌या तीहया कुरन्‌थी ह़ेर सी चीट्‌ठी लीखला हता, जां ह़ारीक तीहया तीहयी टेमे रेता हता। पोलुस आनीन करते लीख्‌यो के पुरु राज ईसु मसी <char style="xt"><ref loc="ROM 16:26">16:26</ref></char> पोर भरहो करे अने पाळ सके।</para>
  <para style="ip">रोमीयो नी कीताप आखी जागे अने आखी टेमे मसी माणहु नी लेदे एक खास कीताप से काहाके पोलुस उजन्‌तो अने वारु रीती सी ह़मजाड़े के आमु ईसु मसी ना छुटकारा ना बारा मे देखाड़ सकया। पोलुस ईसु मसी नी खुस-खबर ने जुन्‌ला नेम सी बी जोड़लो से। थोड़ाक जानकारु नु माननु से के कीताप मे आखा सी खास कीताप <char style="xt"><ref loc="ROM 1:16">1:16</ref></char> से जे केय, “मने खुस-खबर सी कंय लाज नी, काहाके आहया आखा ना छुटकारा नी जुगु भगवान नी सक्‌ती से जे माने: पेले युहदी जुगु, ता तीनी जुगु आड़जात्‌या <char style="xt"><ref loc="ROM 1-12">रोमीयो 1–12</ref></char> नी पेले भाग धरम जुगु काम करवा वाळा से अने बीजा भाग <char style="xt"><ref loc="ROM 13-15">13–15</ref></char> मे मसी जीवाय नी जुगु वेहवारीक खबर से।”</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पोलुस सादा रुप सी आह़फा ना बारा मे देखाड़तो जाय्‌न आह़फा नी चीट्‌ठी नी सुरुवात करे अने तीहयो केय के तीहयो कोयने लीख र्‌यो। <char style="ior"><ref loc="ROM 1:1-15">1:1-15</ref></char></para>
  <para style="io1">2. आनीन अळतेण तीहयो ईसु मसी नी लारे माणहु जाती नी हालत अने छुटकारा ना बारा मे लीखे। <char style="ior"><ref loc="ROM 1:16-11:36">1:16–11:36</ref> </char></para>
  <para style="io1">3. आनीन अळतेण पोलुस मसी जीवाय जीव्‌वा नी लेदे थोड़ाक वेहवारीक ह़ला आपे। <char style="ior"><ref loc="ROM 12:1-15:13">12:1–15:13</ref></char></para>
  <para style="io1">4. तीहयो रोम मंडळी ना माणहु ने वारु रेजो कीन रोमीयो नी कीताप ने पुरी कर्‌यो। <char style="ior"><ref loc="ROM 16">16</ref></char></para>
  <chapter number="1" style="c" sid="ROM 1" />
  <para style="s">जानकारी</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 1:1" />आहयी चीट्‌ठी पोलुस भणी गेथी से, जे मसी ईसु नो चाकर्‌यो से, तीने भगवान नेवताळो बणाव्‌वा करीन बोलाव्‌लो से; अने खुस-खबर परच्‌यार करवा करीन अलग करलो से।<verse eid="ROM 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="ROM 1:2" />जीनो भगवान पेलेत गेथो आह़फा भणी गेथा खबर लावण्‌या माणहु ना लारे चोखली सास्‌तर मे खुस-खबर नो वायदो करलो हतो। <verse eid="ROM 1:2" /><verse number="3" style="v" sid="ROM 1:3" />तीहयो आह़फा ना बेटा ना बारा मे से; तीहयो डील ना मान सी ते दावुद ना घोरणा मे गेथो पयदा हयो। <verse eid="ROM 1:3" /><verse number="4" style="v" sid="ROM 1:4" />अने चोखलापणा नी आत्‌मा ना मान सी मरला मे गेथो जीव उठवा ना कारण ताखत ह़ाते भगवान नो सोरो ठेरलो से, आहयोत ईसु मसी आपणो मालीक से। <verse eid="ROM 1:4" /><verse number="5" style="v" sid="ROM 1:5" />तीनी लारे भगवान आमने दया आपे के नेवताळा नो हक जड़े अने तीना नाम ना कारण सी आखा आड़जात्‌या माणहु भरहो करीन तीनो हुकम माने, <verse eid="ROM 1:5" /><verse number="6" style="v" sid="ROM 1:6" />आनी मे तमु बी भेसकायला से जे रोम मे रेय, जीमने भगवान ईसु मसी ना हयवा ना लेदे बोलावलो से।<verse eid="ROM 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 1:7" />तीहया आखा जुगु मे लीख र्‌यो, जे रोम ह़ेर मे री र्‌या जे भगवान ना मोंगाळ्‌ळा से अने तीमने भगवान आह़फा ना माणहु हयवा करीन बोलावलो से: आपणा बाह भगवान अने मालीक ईसु मसी भणी गेथी तमने दया अने सांती जड़ती रेय।<verse eid="ROM 1:7" /></para>
  <para style="s">घण वारु से केवा नी वीन्‌ती</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 1:8" />पेले मे तमु आखा जुगु ईसु मसी नी लारे आपणा भगवान ने घणो वारु से केम, काहाके तमारा भरहा ना बारा मे आखी कळ ना माणहु ह़मळ्‌वा बाज र्‌या। <verse eid="ROM 1:8" /><verse number="9" style="v" sid="ROM 1:9" />भगवान, जीनी सेवा मे खुद नी आत्‌मा वेर तीना सोरा नी खुस-खबर ना बारा मे करु, तीहयोत मारो गवा से, के मे तमने मारी वीन्‌ती मे दाड़ीन फोम करु। <verse eid="ROM 1:9" /><verse number="10" style="v" sid="ROM 1:10" />मारी वीन्‌ती मे मे सदा वीन्‌ती करु के भगवान नी मरजी सी तमारीन्‌तां आव्‌वा नी कानी बी रीते मारी मरजी पुरी हये। <verse eid="ROM 1:10" /><verse number="11" style="v" sid="ROM 1:11" />काहाके मे तमने भेटवा नी हेर करु के मे तमने एक आत्‌मा नो वाटो आप सकु, जीनी सी तमु टणका हय जावो; <verse eid="ROM 1:11" /><verse number="12" style="v" sid="ROM 1:12" />मतलब आहयु, के जत्‌यार मे तमारी वच मे आवु ता आपणु तीहया भरहा ना लारे जे मारी मे अने तमारी मे से, तीनी सी मने अने तमने मदत जड़े।<verse eid="ROM 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 1:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:13 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:21">नेवताळा ना काम 19:21</ref>
      </char>
    </note>ए भायु, मे नी चाहतो के तमु आहयी वात सी अंजाणा रेवो के मे वळ-वळीन तमारीन्‌तां आव्‌वा नी योजना बणायो, जीसम के मने आड़जात्‌या मे भरहो करन्‌या नो फोळ जड़्‌यो, तेमेत तमारी मे बी जड़े, पण हजु लग रोकावट आवती री। <verse eid="ROM 1:13" /><verse number="14" style="v" sid="ROM 1:14" />मे आखा माणहु नो, युहदी अने आड़जात्‌या नो, अने अकल्‌या अने वण-अकल्‌या नो करजाळ्‌ळो से। <verse eid="ROM 1:14" /><verse number="15" style="v" sid="ROM 1:15" />हाव मे तमने बी जे रोम ह़ेर मे री र्‌या, खुस-खबर ह़मळाव्‌वा करीन तीयार से।<verse eid="ROM 1:15" /></para>
  <para style="s">खुस-खबर नी ताखत</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 1:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:16 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 8:38">मरकुस 8:38</ref>
      </char>
    </note>मे खुस-खबर सी लजवाम नी, काहाके आहयी भगवान नी ताखत से, जे आखा भरहो करवा वाळा ना लेदे छुटकारो लावे, जे माने तीनी लेदे: पेले युहदी, अळतेण आड़जात्‌या ना लेदे। <verse eid="ROM 1:16" /><verse number="17" style="v" sid="ROM 1:17" />काहाके खुस-खबर आहयु उजन्‌तु करे के भगवान माणहु ने आह़फा नी लेदे कीसम संय बणावे। आहयु सुरुवात सी आखरी लग भरहा पोर टेकलु से। जीसम के सास्‌तर मे लीखलु से, “जे माणेह भगवान ह़ाते धरमी से भरहा ना लारे जीवत्‌लो रेहे।”<verse eid="ROM 1:17" /></para>
  <para style="s">माणेह जाती नो पाप</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 1:18" />भगवान नी रीह ते तीहया आखा माणहु ना पाप अने बुराय पोर ह़रग मे गेथी उजन्‌ती हये, जे सच्‌चाय ने पाप सी डाबीन राखे। <verse eid="ROM 1:18" /><verse number="19" style="v" sid="ROM 1:19" />आनीन करते भगवान नो ग्‌यान तीमना मन मे उजन्‌तो से, काहाके भगवान तीमनी पोर उजन्‌तो करलो से। <verse eid="ROM 1:19" /><verse number="20" style="v" sid="ROM 1:20" />जत्‌यार गेथो भगवान कळी ने घड़्‌यो तत्‌यार गेथा तीना वण-देख्‌या गुण, मतलब, आहयी बेम अमरकाय सक्‌ती अने देवताम नो सोभाव पुरी रीती सी आसुझण देखाय। तीहया ते चीज ने जीमने भगवान बणावलो से तीने जाण सके। करीन तीहया माणहु पांह कंय बोनु नी हय। <verse eid="ROM 1:20" /><verse number="21" style="v" sid="ROM 1:21" /><note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="EPH 4:17">ईफीसीयो 4:17</ref>,<ref loc="EPH 4:18">18</ref></char></note>आनी लेदे के भगवान ने जाण लेदा ते बी तीहया भगवान ना लायक बड़ाय अने वारु से के नी केदा, पण अमथो वीच्‌यार करवा लाग्‌या, आञे लग के तीमनु वण-अकल्‌यु मन अंदारलु सी भराय ज्‌यु। <verse eid="ROM 1:21" /><verse number="22" style="v" sid="ROM 1:22" />तीहया खुद ने ग्‌यान वाळा ह़मजे, पण तीहया गांडा से। <verse eid="ROM 1:22" /><verse number="23" style="v" sid="ROM 1:23" />अने खत्‌तम नी हयण्‌या भगवान नी बड़ाय ने खत्‌तम हयण्‌यु माणेह, अने चड़ा, अने जानवरु, अने घीहावा वाळा जन्‌तु नी मुर्‌ती नी वेह मे तीहया बदल देदा।<verse eid="ROM 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="ROM 1:24" />आनी लेदे भगवान तीमने तीमना मन नी हेर ना अनसारे वीटळ मे सोड़ देदो के तीहया आह़फा-आह़फात आपणा डील नी ईज्‌जत नी करे। <verse eid="ROM 1:24" /><verse number="25" style="v" sid="ROM 1:25" />काहाके तीहया भगवान नी सच्‌चाय ने झुट मे बदलीन झुट बणाय देदा, अने तीहया आहयी कळी ने बणावण्‌या नी उपाह़ अने सेवा नी कर्‌या जे सदा नो से, पण कळी नी उपाह़ अने सेवा कर्‌या! आमीन।<verse eid="ROM 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 1:26" />आनी लेदे भगवान तीमने ह़ीगी करे एवा ना हक मे सोड़ देदो; आञे लग के तीमना बयरा बी वारला वेहवार ने सोड़ीन गलत तीनी सी जे सोभाव ना वीरोद से, बदल नाख्‌या। <verse eid="ROM 1:26" /><verse number="27" style="v" sid="ROM 1:27" />अने अदमी बयरा ह़ाते सवसार करवा रेवा दीन अदमी, अदमी ह़ाते सवसार करवा बाज ज्‌या। घण-जबर सवसार करवा नी हेर करवा बाज ज्‌या। अने तीमना चंगला अने वणलाज्‌या काम नो डंड तीमने जड़ ज्‌यो।<verse eid="ROM 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 1:28" />तीहया भगवान ने नी ओळखवा हींडता हता, एतरे भगवान बी तीमना रीकामा मन पोर सोड़ देदो; के तीहया गलत काम करे जे नी करवु हतु। <verse eid="ROM 1:28" /><verse number="29" style="v" sid="ROM 1:29" />तीहया आखा भातीन पाप, गलत काम, अने लालच, अने रीह-दगा सी भराय ज्‌या; अने रीह, अने मारवा, अने झगड़वा, अने धोको देवा, अने बुरफाय सी पुरा भराय ज्‌या, अने चुगल्‌या, <verse eid="ROM 1:29" /><verse number="30" style="v" sid="ROM 1:30" />नामबद्‌दी करन्‌या, बुराय करन्‌या, भगवान नी बुराय करन्‌या, बीजा नी ईज्‌जत नी करन्‌या, घमंड करन्‌या, बुरी-बुरी वात ने बणाव्‌वा वाळा, आह्‌य-बाहा ना हुकम ने नी मानवा वाळा, <verse eid="ROM 1:30" /><verse number="31" style="v" sid="ROM 1:31" />वण-अकल्‌या, धोको देण्‌या, मोंग अने दया ना कमी से अने कठोर हय ज्‌या। <verse eid="ROM 1:31" /><verse number="32" style="v" sid="ROM 1:32" />तीहया ते भगवान नी आहयी रीती ने जाणे के एवा-एवा काम करवा वाळा मोत ना डंड नी लायक से, ते बी नीस्‌ता तीहया एतरात नी एवा काम करे, पण करवा वाळा ने बी मदत करे।<verse eid="ROM 1:32" /></para>
  <chapter eid="ROM 1" />
  <chapter number="2" style="c" sid="ROM 2" />
  <para style="s">भगवान नो नीयाव</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:1">मत्‌ती 7:1</ref>; <ref loc="LUK 6:37">लुका 6:37</ref></char>
    </note>एतरे ए गुनो लगाड़न्‌या, तु कोय बी काहा नी हय, तारी पांह कंय बी जपाप नी हय; काहाके जे वात मे तु बीजा पोर गुनो लगाड़े, तीहयीत वात मे आह़फा पोर बी गुनो लगाड़े, आनीन करते के तु जे गुनो लगाड़े खुदेत तीहयु काम करवा बाज र्‌यो। <verse eid="ROM 2:1" /><verse number="2" style="v" sid="ROM 2:2" />आपणु जाणया के एवा काम करवा वाळा नो नीयाव भगवान सच्‌चाय ना अनसारे करे। <verse eid="ROM 2:2" /><verse number="3" style="v" sid="ROM 2:3" />ए माणेह, तु जे एवा-एवा काम करवा वाळा पोर गुनो लगाड़े अने तु तीहयात काम करे ता तु आहयु ह़मजे के तु भगवान ना डंड सी बच जही? <verse eid="ROM 2:3" /><verse number="4" style="v" sid="ROM 2:4" />तु तीनी भलाय, अने गम, गम राखवा नु ने हेटु ह़मजे ह़ु? आहयु नी ह़मजे ह़ु के भगवान नी दया तने मन बदलवा ह़ीकाड़े। <verse eid="ROM 2:4" /><verse number="5" style="v" sid="ROM 2:5" />तमु आपणा हेटाळ्‌ळा मन वाळा अने वतड़ाय ना कारण सी तीहया दाड़े जत्‌यार भगवान नी रीह अने खरलो नीयाव उजन्‌तो हयहे, आह़फा जुगु डंड लाय र्‌यो। <verse eid="ROM 2:5" /><verse number="6" style="v" sid="ROM 2:6" />भगवान आपणु आखा ने आपणा कामु ना अनसारे फोळ आपहे। <verse eid="ROM 2:6" /><verse number="7" style="v" sid="ROM 2:7" />जे बी वारला काम मे टेकीन बड़ाय अने ईज्‌जत, अने अमर जीवाय ने ह़ोदे, तीने तीहयो अमरकाय जीवाय आपहे। <verse eid="ROM 2:7" /><verse number="8" style="v" sid="ROM 2:8" />पण जे लालच्‌यो से अने सच्‌चाय ने नी माने, अने एवा वण-धरम पोर चाले, एवा माणहु पोर भगवान आह़फा नी रीह अने गरा लावहे। <verse eid="ROM 2:8" /><verse number="9" style="v" sid="ROM 2:9" />अने जे गलत करे तीहया आखा माणहु पोर दुख अने गरा आय पड़हे, पेले युहदी माणहु पोर अळतेण आड़जात्‌या पोर। <verse eid="ROM 2:9" /><verse number="10" style="v" sid="ROM 2:10" />पण भगवान आखा ने जे वारला काम करे तीमने बड़ाय अने ईज्‌जत अने सांती आपहे। पेले युहदी ने अळतेण आड़जात्‌या ने। <verse eid="ROM 2:10" /><verse number="11" style="v" sid="ROM 2:11" />काहाके भगवान कोयनो भेद-भाव कर्‌या वगर आखा नो नीयाव करे।<verse eid="ROM 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 2:12" />आड़जात्‌या पांह मुसा नो नेम नी हय, अने तीमना पापु नो नीयाव बी नेम वगर हयहे। अने युहदी पांह मुसा नो नेम से, अने तीमना करला पापु नो नीयाव बी नेम नी अनसारे हयहे। <verse eid="ROM 2:12" /><verse number="13" style="v" sid="ROM 2:13" />काहाके भगवान ने तां नेम ह़मळवा वाळा धरमी नी हय, पण नेम पोर चालवा वाळा ने धरमी ठेरावहे। <verse eid="ROM 2:13" /><verse number="14" style="v" sid="ROM 2:14" />आड़जात्‌या माणहु पांह मुसा नो नेम नी हय, पण ते बी तीहया आह़फात नेम पोर चाले, अने नेम तीमनी पांह नी हय ते बी तीहया आह़फा जुगु खुद नेम से। <verse eid="ROM 2:14" /><verse number="15" style="v" sid="ROM 2:15" />तीमनी चाल-चलण देखाड़े के सास्‌तर तीमना मन मे लीखली से। अने तीमनु मन केय आहयुत संय से, अने आने लीन तीमना वीच्‌यार कदी गुनो लगाड़े नीता कदी वण-गुनाळ्‌ळा ठेरावे। <verse eid="ROM 2:15" /><verse number="16" style="v" sid="ROM 2:16" />जे दाड़े भगवान मारी परच्‌यार करली खुस-खबर ना अनसारे ईसु मसी ना लारे माणहु नी ह़तायली वातु नो नीयाव करहे।<verse eid="ROM 2:16" /></para>
  <para style="s">युहदी माणहु अने नेम</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 2:17" />कदी तु युहदी केवायतो हय, अने नेम पोर भरहो राखतो हय, अने आह़फा ना भगवान ना बारा मे घमंड करतो हय। <verse eid="ROM 2:17" /><verse number="18" style="v" sid="ROM 2:18" />अने तने मालम से भगवान तने ह़ु कराव्‌वा हींड र्‌यो अने वारली वात ने टाळवा तु नेम सास्‌तर सी ह़ीकलो से। <verse eid="ROM 2:18" /><verse number="19" style="v" sid="ROM 2:19" />अने आह़फा पोर भरहो राखतो हय के मे आंदळा नो अगवाय करन्‌यो से, अने अंदारला मे पड़ला माणहु जुगु वीजाळु से। <verse eid="ROM 2:19" /><verse number="20" style="v" sid="ROM 2:20" />अने वण-अकल्‌या ने ह़ीकाड़न्‌यो, अने भोळा माणहु नो मास्‌तर से, अने तु पक्‌को से के जे नेम सास्‌तर तारी पांह से तीनी मे पुरी सच्‌चाय अने पुरो ग्‌यान मने जड़लो से। <verse eid="ROM 2:20" /><verse number="21" style="v" sid="ROM 2:21" />अने जे तु बीजा ने ह़ीकाड़े तीहयु खुद ने नी ह़ीकाड़तो ह़ु? तु चोरी नी करवा ह़ीकाड़े अने खुद चोरी करे? <verse eid="ROM 2:21" /><verse number="22" style="v" sid="ROM 2:22" />तु जे केय, छीनाळु नी करवा, अने खुद छीनाळु करे? तु जे मुर्‌ती सी ह़ीगी करे, अने तुत मंदीर ने लुटे? <verse eid="ROM 2:22" /><verse number="23" style="v" sid="ROM 2:23" />तु जे कायदा ना बारा मे घमंड करे, कायदा ने नी मानीन भगवान नी ईज्‌जत नी करे ह़ु? <verse eid="ROM 2:23" /><verse number="24" style="v" sid="ROM 2:24" />काहाके सास्‌तर मे जीसम लीखलु बी से, “तमारा कारण आड़जात्‌या मे भगवान ना नाम नी बुराय करे।”<verse eid="ROM 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 2:25" />कदी तु नेम पोर चाले ता खतना सी फायदो ते से, पण कदी तु नेम नी माने ता तारु खतनु, खतनु नी करलान तेम ठेरहे। <verse eid="ROM 2:25" /><verse number="26" style="v" sid="ROM 2:26" />एतरे कदीम आड़जात्‌या जीमनु खतनु नी हयलु हय, ते बी तीहयो सास्‌तर ना नेम ने पाळे, ता तीनी नी खतना करली हालत खतना ना बराबर नी गणाय ह़ु? <verse eid="ROM 2:26" /><verse number="27" style="v" sid="ROM 2:27" />अने तमु युहदी ने आड़जात्‌या नी लारे गुनाळ्‌ळा ठेरावहु जे बी तमारी पांह लीखली सास्‌तर अने तमारु खतनु हयलु से पण आड़जात्‌या सास्‌तर ने माने जे के डील सी तीमनु खतनु नी हयु। <verse eid="ROM 2:27" /><verse number="28" style="v" sid="ROM 2:28" />खरलो युहदी तीहयो नी हय जीमनु बाहरला रुप सी युहदी से अने नी खरलु खतनु तीहयु हय जे डील मे करलु से। <verse eid="ROM 2:28" /><verse number="29" style="v" sid="ROM 2:29" />पण खरलो युहदी तीहयोत से जे मोय सी युहदी से; जीमनु मन सी खतनु हयलु से, अने आहयु भगवान नी आत्‌मा नु काम से नी के लीखली सास्‌तर नु एवो माणहे भगवान भणी गेथी बड़ाय हात करहे नी के माणहे भणी गेथी।<verse eid="ROM 2:29" /></para>
  <chapter eid="ROM 2" />
  <chapter number="3" style="c" sid="ROM 3" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 3:1" />ता अळतेण आड़जात्‌या नी अगळ तमारो युहदी हयवा नो ह़ु फायदो अने खतनु हयवा नी ह़ु कीमत से? <verse eid="ROM 3:1" /><verse number="2" style="v" sid="ROM 3:2" />आखी भाते घणो फायदो से! पेले ते युहदी माणहु ने भगवान ना बोलु ह़ोप्‌या। <verse eid="ROM 3:2" /><verse number="3" style="v" sid="ROM 3:3" />कदी थोड़ाक वण-भरह्‌या बी नीकळ्‌या ता ह़ु हयु? तीमनो वण-भरहो भगवान नी सच्‌चाय ने अमथी कर देहे ह़ु? <verse eid="ROM 3:3" /><verse number="4" style="v" sid="ROM 3:4" />कदी नी! बाखीन भगवान खरलो से अने एकीक माणहु झुटा ठेरहे, जीसम सास्‌तर मे लीखलु से,</para>
  <para style="q1" vid="ROM 3:4">जीनी सी तु आपणी वात मे धरमी ठेरे,</para>
  <para style="q2" vid="ROM 3:4">अने नीयाव करवा नी टेमे जीक जाय।<verse eid="ROM 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 3:5" />पण कदी अमारो वण-धरम भगवान ने धरमपण ठेराय देय, ता आमु ह़ु कीया? ह़ु आहयु के भगवान जे रीह करे गलत करे? आहयु ते मे माणेह नी रीती पोर केम। <verse eid="ROM 3:5" /><verse number="6" style="v" sid="ROM 3:6" />कदी नी! नीता भगवान कीसम कळी नो नीयाव करहे?<verse eid="ROM 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 3:7" />कदी मारा झुट ना कारण भगवान नी सच्‌चाय तीनी बड़ाय ना लेदे, जादा करीन उजन्‌तो हयु, ता काहा मने पापीन तेम डंड ना लायक ठेरावे? <verse eid="ROM 3:7" /><verse number="8" style="v" sid="ROM 3:8" />आमु काहा नी बुराय करीया के भलाय उजन्‌ती हये? जीसम के अमारी पोर आहयो गुनो लगाड़े बी, अने काना केय के आमनु आहयु केणु से। पण आसवा ने गुनाळ्‌ळा ठेराव्‌वा ताले से।<verse eid="ROM 3:8" /></para>
  <para style="s">कोय धरमी नी हय</para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 3:9" />ता अळतेण ह़ु हयु? ता आमु तीहया आड़जात्‌या सी वारु से? कदी नी; काहाके आमु युहदी अने आड़जात्‌या बेम पोर आहयो गुनो लगाड़ देदला से के तीहया आखान-आखा पाप ना हक मे से। <verse eid="ROM 3:9" /><verse number="10" style="v" sid="ROM 3:10" />जीसम सास्‌तर मे लीखलु से:</para>
  <para style="q1" vid="ROM 3:10">कोय धरमी नी, एक बी नी।<verse eid="ROM 3:10" /></para>
  <para style="q2">
    <verse number="11" style="v" sid="ROM 3:11" />कोय ह़मजदार नी;</para>
  <para style="q2" vid="ROM 3:11">कोय भगवान ने ह़ोदवा वाळो नी हय।<verse eid="ROM 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="ROM 3:12" />आखा भगवान सी भटकी जेला से,</para>
  <para style="q2" vid="ROM 3:12">अने आखान-आखा रीकामा बण जेला से;</para>
  <para style="q2" vid="ROM 3:12">कोय भलाय करन्‌यो नी हय, एक बी नी हय।<verse eid="ROM 3:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="ROM 3:13" />तीमनु मोडु उगाड़लु मड़ाट्‌यु से,</para>
  <para style="q2" vid="ROM 3:13">तीहया आह़फाम नी जीप सी घमंड कर्‌या,</para>
  <para style="q2" vid="ROM 3:13">तीमना होट्‌या मे गहड़ा नी जेर से।<verse eid="ROM 3:13" /></para>
  <para style="q2">
    <verse number="14" style="v" sid="ROM 3:14" />तीमनु मोडु गरा अने कड़वाट सी भरलु से।<verse eid="ROM 3:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="ROM 3:15" />तीमना पोगु लोय वयाड़वा मे उतवाळ्‌या से,<verse eid="ROM 3:15" /></para>
  <para style="q2">
    <verse number="16" style="v" sid="ROM 3:16" />तीमनी वाट्‌ये खत्‌तम हयणु अने दुख से,<verse eid="ROM 3:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="ROM 3:17" />तीहया सांती नी वाट नी जाणता।<verse eid="ROM 3:17" /></para>
  <para style="q2">
    <verse number="18" style="v" sid="ROM 3:18" />तीमना डोळा अगळ भगवान नी बीक नी हय।<verse eid="ROM 3:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 3:19" />आमु जाणये के नेम जे कंय केय तीमनेत केय, जे नेम पोर चाले; आनीन करते के आखा ना मोडा बंद कर देय अने आखी कळी भगवान ना नीयाव ना लायक ठेर्‌यी; <verse eid="ROM 3:19" /><verse number="20" style="v" sid="ROM 3:20" /><note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="GAL 2:16">गलातीयो 2:16</ref></char></note>काहाके नेम ना काम सी कोय बी माणेह तीनी अगळ धरमी नी ठेरे, आनीन करते के नेम ना लारे पाप नी ओळखाण हये।<verse eid="ROM 3:20" /></para>
  <para style="s">भरहा ना लारे धरमी</para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 3:21" />पण हाव नेम सी अलग भगवान नी तीहयी धारमीक्‌ता उजन्‌ती हयली से, जीनी गवाय नेम अने भगवान वगे गेथा केवा वाळा माणहु देय। <verse eid="ROM 3:21" /><verse number="22" style="v" sid="ROM 3:22" /><note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="GAL 2:16">गलातीयो 2:16</ref></char></note>मतलब भगवान नु तीहयु धरमपणु, जे ईसु मसी पोर भरहो करवा सी आखा भरहो करवा वाळा जुगु से। काहाके कंय बी भेद-भाव नी हय। <verse eid="ROM 3:22" /><verse number="23" style="v" sid="ROM 3:23" />काहाके आखान-आखा पाप करला से, अने आखान-आखा भगवान नी बड़ाय सी बाकता हय ज्‌या। <verse eid="ROM 3:23" /><verse number="24" style="v" sid="ROM 3:24" />पण भगवान आह़फा नी दया सी तीहया छुटकारा ना लारे ईसु मसी मे आखान-आखा ने फोकट मे धरमी ठेरावलो से। <verse eid="ROM 3:24" /><verse number="25" style="v" sid="ROM 3:25" />ईसु मसी ने भगवान तीना लोय ना लेदेत पाप नो डंड उचलन्‌यो बणाय देदो, अने ईसु मसी पोर भरहो करवा सीत आपणु ने छुटकारो जड़े, अने जे पाप माणहु पेले करला अने भगवान वेठतो र्‌यो अने तीमना पाप पोर ध्‌यान नी देदो। पण हाव तीहयो ईसु ना लारे आह़फा नु धरमपण उजन्‌तु कर्‌यो। <verse eid="ROM 3:25" /><verse number="26" style="v" sid="ROM 3:26" />पण आहयीत टेमे तीनु धरमपणु उजन्‌तु हय ज्‌यु; तीनी सी तीहयो आह़फोत धरमी गणाय अने जे ईसु पोर भरहो करे, तीमने बी धरमी ठेरावण्‌यो बणे।<verse eid="ROM 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 3:27" />ता घमंड कां से? घमंड ने बाहर नीकाळ देदा काना कायदा सी, ह़ु आमु नेम सास्‌तर ने पाळया करीन, नी, पण आमु भरहो करया करीन। <verse eid="ROM 3:27" /><verse number="28" style="v" sid="ROM 3:28" />आसम आपणु देख्‌या के कायदा पाळवा ना लारे नी, बाखीन भगवान पोर भरहो करवा नी लारे माणेह पाप गेथो छुट जाय। <verse eid="ROM 3:28" /><verse number="29" style="v" sid="ROM 3:29" />भगवान युहदी माणहु नो एतरोत भगवान से ह़ु? आहयो भगवान आड़जात्‌या माणहु नो भगवान नी हय ह़ु? होव, हीय्‌यो आड़जात्‌या माणहु नो बी भगवान से। <verse eid="ROM 3:29" /><verse number="30" style="v" sid="ROM 3:30" /><note caller="+" style="x"><char style="xo" closed="false">3:30 </char><char style="xt" closed="false"><ref loc="GAL 3:20">गलातीयो 3:20</ref></char></note>काहाके एकीत भगवान से, तीहयो खतना करला जुगु अने नी खतना करला ने बी भरहा ना लारे धरमी ठेरावे। <verse eid="ROM 3:30" /><verse number="31" style="v" sid="ROM 3:31" />ता आपणु मुसा ना लारे लीखला कायदा ने भरहा ना लारे अमथा ठेरावये ह़ु? नी, जलमकु आसम नी हय; पण मुसा ना कायदा ने जादा ताखत वाळा बणावीन पक्‌का कर्‌या।<verse eid="ROM 3:31" /></para>
  <chapter eid="ROM 3" />
  <chapter number="4" style="c" sid="ROM 4" />
  <para style="s">अब्‌राहम नो उदारण</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 4:1" />आनीन करते आमु ह़ु कीये के अमारा आहयी कळी ना बाह अब्‌राहम ने ह़ु जड़्‌यु। <verse eid="ROM 4:1" /><verse number="2" style="v" sid="ROM 4:2" />काहाके अब्‌राहम ने काम ना लारे धरमी ठेरावे, ता तीने घमंड करवा नी जागा रेती, पण भगवान ना ह़ाते नी। <verse eid="ROM 4:2" /><verse number="3" style="v" sid="ROM 4:3" /><note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="GAL 3:6">गलातीयो 3:6</ref></char></note>चोखली सास्‌तर मे लीखलु से, के “अब्‌राहम भगवान पोर भरहो कर्‌यो, अने आहयु तीना लेदे धारमीक गणाय ज्‌यु।” <verse eid="ROM 4:3" /><verse number="4" style="v" sid="ROM 4:4" />काम करन्‌या ने दाड़की आपवा दान नी हय, पण हक ह़मजवा जोवे। <verse eid="ROM 4:4" /><verse number="5" style="v" sid="ROM 4:5" />पण जे काम नी करतो हय, वण-भक्‌ती करन्‌या ने धरमी ठेरावण्‌या पोर भरहो करतो हय, तीनो भरहो तीनी लेदे धारमीक्‌ता गीणायहे। <verse eid="ROM 4:5" /><verse number="6" style="v" sid="ROM 4:6" />जीने भगवान बीना काम सी धरमी ठेरावे, तीने दावुद बी वारु से केय:<verse eid="ROM 4:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="ROM 4:7" />“जुगाळा से तीहया जीमना अधरम माफ हया,</para>
  <para style="q2" vid="ROM 4:7">अने जीमना पाप ढाक देदा।<verse eid="ROM 4:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="ROM 4:8" />जुगाळो से तीहयो माणेह जीने भगवान पापी नी ठेरावे!”<verse eid="ROM 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 4:9" />ता तीहयो वारलो बोल, खतना करला तीमनी जुगु एतरोत से, के बीना खतना वाळा जुगु बी से? आमु आहयु कीया, “अब्‌राहम ना लेदे तीनो भरहो धरमी गणायो।” <verse eid="ROM 4:9" /><verse number="10" style="v" sid="ROM 4:10" />ता तीहयो कीसम गीनती मे लाग्‌यो? खतना नी दसा मे के बीना खतना नी दसा मे? खतना नी दसा मे नी पण बीना खतना नी दसा मे। <verse eid="ROM 4:10" /><verse number="11" style="v" sid="ROM 4:11" />अने तीने खतना नी सेलाणी जड़ी के तीहया भरहा नी धारमीक्‌ता पोर छाप लाग जाय जे तीहयो बीना खतना नी हालत मे हतो, जीनी सी तीहयो तीमनो आखा नो बाह ठेरे जे बीना खतना नी हालत मे भरहो करे तीहयो बी धरमी ठेरे; <verse eid="ROM 4:11" /><verse number="12" style="v" sid="ROM 4:12" />अने तीहयो खतना करला नो बाह हय; जे नीस्‌ता खतना करला से, पण अमारा बाह अब्‌राहम ना तीहया भरहा ना सोभाव पोर बी चाल्‌या, जे तीहयो बीना खतना नी हालत मे बी करलो हतो। <verse eid="ROM 4:12" /><verse number="13" style="v" sid="ROM 4:13" /><note caller="+" style="x"><char style="xo" closed="false">4:13 </char><char style="xt" closed="false"><ref loc="GAL 3:29">गलातीयो 3:29</ref></char></note>काहाके आहयो वायदो के तीहयो कळी नो वारीस हयहे, नी अब्‌राहम ने, नी तीना पीड़ी ने कायदा ना लारे आप्‌ली हती, पण भरहा नी धरमपण ना लारे जड़ी।<verse eid="ROM 4:13" /></para>
  <para style="s">भरहा ना लारे</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 4:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:14 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 3:18">गलातीयो 3:18</ref>
      </char>
    </note>काहाके कदी कायदा वाळा वारीस हय ता, भरहो फालतु अने वायदो अमथो हय ज्‌यो। <verse eid="ROM 4:14" /><verse number="15" style="v" sid="ROM 4:15" />कायदा ते रीह उबजाड़े, अने जां कायदा नी हय हाही बी नी।<verse eid="ROM 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 4:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:16 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 3:7">गलातीयो 3:7</ref>
      </char>
    </note>एतरे वायदो भरहा पोर अने दया पोर टेकलो से, आनीन करते के तीहयो तीनी अवल्‌यात जुगु पक्‌को हय जाय तेम। तीमनी जुगु एतरुत नी जे कायदा पाळन्‌या से, पण तीमनी जुगु बी से, जे अब्‌राहम नी तेम भरहो करे। अब्‌राहम अमारो आखा नो बाह से। <verse eid="ROM 4:16" /><verse number="17" style="v" sid="ROM 4:17" />जेम के लीखलु से, “मे तने घणा ढेरका मुलक नो बाह ठेरावलो से।” भगवान नी नींगा मे अब्‌राहम अमारो बाह से। अब्‌राहम भगवान पोर भरहो कर्‌यो, जे भगवान मरला ने जीवाड़े अने जे हय नी तीमने बी घड़ीन उबजाड़े। <verse eid="ROM 4:17" /><verse number="18" style="v" sid="ROM 4:18" />अब्‌राहम ह़ोह़वाय ना दाड़ा मे बी आह राखीन भरहो कर्‌यो अने तीहयो घणा ढेरका मुलक नो बाह बण ज्‌यो, जेम तीने केदलु हतु के तारी गणाये नी एतरी अवल्‌यात हयहे। <verse eid="ROM 4:18" /><verse number="19" style="v" sid="ROM 4:19" />अब्‌राहम नी उमर एक ह़ो साल नी हती, पण भरहो तीना डील ने तेम कमजोर नी हयो जीसम तीहयो डायो हय जेलो, अने सच्‌चाय ते आहयी से सारा वांजाण हती अने डाहली हय जेली, तीहयी सोरा पयदा नी कर सक्‌ती हती। <verse eid="ROM 4:19" /><verse number="20" style="v" sid="ROM 4:20" />अने तीहयो भगवान ना वायदा पोर सण्‌का नी कर्‌यो, बाखीन भरहा मे वातड़ो रीन भगवान नी बड़ाय कर्‌यो। <verse eid="ROM 4:20" /><verse number="21" style="v" sid="ROM 4:21" />तीने पक्‌को भरहो हतो के भगवान जे वात नो वायदो करलो से, तीहयो तीने पुरो करीन सोड़हे। <verse eid="ROM 4:21" /><verse number="22" style="v" sid="ROM 4:22" />आनीत लेदे भगवान अब्‌राहम ने तीना भरहा नी लारे धरमी गणायो। <verse eid="ROM 4:22" /><verse number="23" style="v" sid="ROM 4:23" />अने आहयो बोल, “भरहा ना लेदे धरमी गणाय ज्‌यो” तीनी लेदे एतरुत नी लीख्‌या। <verse eid="ROM 4:23" /><verse number="24" style="v" sid="ROM 4:24" />पण आपणी जुगु बी लीखलो से। आपणु बी भरहा नी करते धरमी गणायहु। काहाके आपणु तीहया भगवान पोर भरहो करया, जे मालीक ईसु ने मर्‌या-ह़र्‌या मे गेथो जीवाड़लो से। <verse eid="ROM 4:24" /><verse number="25" style="v" sid="ROM 4:25" />हीय्‌योत ईसु आपणा पाप गुना नी करते मरवा करीन धराय ज्‌यो, अने आपणु ने धरमी बणाव्‌वा करीन मर्‌या-ह़र्‌या मे गेथो जीवतो हय्‌न बठो नी हय ज्‌यो।<verse eid="ROM 4:25" /></para>
  <chapter eid="ROM 4" />
  <chapter number="5" style="c" sid="ROM 5" />
  <para style="s">भगवान सी मेळ राखो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 5:1" />अने जत्‌यार आमु भरहा सी धरमी ठेर्‌या, ता आपणा मालीक ईसु मसी ना लारे भगवान ह़ाते मेळ राखो। <verse eid="ROM 5:1" /><verse number="2" style="v" sid="ROM 5:2" />जीना लारे भरहा ना कारण तीहयी दया लग जीनी मे आमु बणला से, अमारी पुग बी हयी, अने भगवान नी बड़ाय नी आह पोर घमंड करो। <verse eid="ROM 5:2" /><verse number="3" style="v" sid="ROM 5:3" />नीस्‌तु आहयु नी, बाखीन आमु दुख मे बी घमंड करो, आहयु जाणीन के दुख मे धीरज से। <verse eid="ROM 5:3" /><verse number="4" style="v" sid="ROM 5:4" />अने धीरज सी खरा नीकळवा, अने खरा नीकळवा सी आह पयदा हये। <verse eid="ROM 5:4" /><verse number="5" style="v" sid="ROM 5:5" />अने आह सी लाज नी आवे, काहाके जे चोखली आत्‌मा आमने आप मेली तीना लारे भगवान नो मोंग आपणा मन मे नाख मेल्‌यो।<verse eid="ROM 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 5:6" />काहाके जत्‌यार आमु कमजोर हता, ता मसी वारु टेमे पापी माणहु ना लेदे मर्‌यो। <verse eid="ROM 5:6" /><verse number="7" style="v" sid="ROM 5:7" />काना धरमी जुगु कोय मरे, आहयु ते हय नी सके; पण हय सके के कोय भला माणेह जुगु मरवा नी ह़ेर करे। <verse eid="ROM 5:7" /><verse number="8" style="v" sid="ROM 5:8" />पण भगवान आपणी पोर मोंग नी भलाय आहयी रीते उजन्‌ती करे के जत्‌यार आमु पापीत हता, तत्‌यार मसी अमारा लेदे मर्‌यो। <verse eid="ROM 5:8" /><verse number="9" style="v" sid="ROM 5:9" />अने हाव आमु तीना लोय ना कारण धरमी ठेर्‌या, ता तीना लारे भगवान नी रीह सी काहा नी बचया? <verse eid="ROM 5:9" /><verse number="10" style="v" sid="ROM 5:10" />जत्‌यार वेरी हता ते बी तीना सोरा ना मोत नी लारे भगवान ह़ाते मेळ हयो ता मेळ हय जवा सी तीना जीवाय ना कारण आपणु छुटकारो काहा नी हात करया? <verse eid="ROM 5:10" /><verse number="11" style="v" sid="ROM 5:11" />नीस्‌तु आहयुत नी, पण आपणु आपणा मालीक ईसु मसी ना लारे, जीना लारे आपणो मेळ हयलो से, भगवान मे खुस हयला से।<verse eid="ROM 5:11" /></para>
  <para style="s">आदम ना लारे मोत मसी ना लारे जीवाय</para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 5:12" />आनीन करते जीसम एक माणेह ना लारे पाप आहयी कळी मे आयो, अने पाप ना लारे मोत आयी, अने आहयी रीते मोत आखा माणहु मे फेल जी, काहाके आखा पाप करला। <verse eid="ROM 5:12" /><verse number="13" style="v" sid="ROM 5:13" />कायदा आपवा नी टेम लग पाप कळी मे हतो, पण जां कायदा नी हय तां पाप नी गणाय जाय। <verse eid="ROM 5:13" /><verse number="14" style="v" sid="ROM 5:14" />ते बी आदम सी लीन मुसा लग मोत तीहया माणहु पोर राज करी, जे बी तीहया आदम, जे तीहया आव्‌वा वाळा नी सेलाणी से, के गुनान तेम पाप नी कर्‌या।<verse eid="ROM 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 5:15" />पण जीसम गुना नी हालत से, तेम भगवान ना वाटा नी हय। काहाके एकीत माणेह ना गुना नी लारे घणा माणहु मर ज्‌या, ते बी भगवान नो वाटो एकीत माणेह नी लारे मतलब ईसु मसी नी दया नी लारे आखा ने घण-जबर जड़लो से। <verse eid="ROM 5:15" /><verse number="16" style="v" sid="ROM 5:16" />अने आहयो वाटो, एकीत माणेह पाप गुना ना मोत ना फोळ ने तेम नी हय; काहाके एकीत जणो पाप कर्‌यो, अने पाप नो डंड नो दाड़ो टकाय ज्‌यो, पण ढेरेत पाप करवा सी वाटो पयदा हयो के ढेरेत माणहु धरमी बण जाय तेम। <verse eid="ROM 5:16" /><verse number="17" style="v" sid="ROM 5:17" />कदीम एकीत माणेह ना पाप नी लेदे मोत राज करवा बाज ज्‌यो, ता जे माणहु दया अने धरम ना वाटा घण-जबर हात करे, तीहया एकीत जणा नी लारे, मतलब ईसु मसी नी लारे ह़ाचलीनेत जलमकी जीवाय मे राज करहे।<verse eid="ROM 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 5:18" />एतरे जीसम एकीत जणा ना पाप नी लेदे आखा गुनाळ्‌ळा गणाया, तेमेत एकीत जणा ना धरम ना काम नी लारे आखा ने अमरकाय जीवाय आपण्‌यो धरम नो वाटो जड़ ज्‌यो।<verse eid="ROM 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 5:19" />एतरे जेम एक माणेह हुकम नी पाळवा सी आखा पापी बण ज्‌या, तेमेत एक माणहे हुकम पाळवा सी आखा धरमी बण ज्‌या।<verse eid="ROM 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 5:20" />अने मुसा नी लारे लीखलो कायदो वच मे आय लाग्‌यो, अने माणहु मे पाप जादा हयवा बाज ज्‌यो। पण जां ह़ारीक पाप जादा हयो तां दया बी जादात वदती ज्‌यी। <verse eid="ROM 5:20" /><verse number="21" style="v" sid="ROM 5:21" />जेम पाप माणहु मे मोत लावतो जाय्‌न राज कर्‌यो, तेमेत आपणा ईसु मसी नी लारे गीण-दया बी अमरकाय जीवाय नी करते माणहु ने धरमी ठेरावीन राज करती जाय तेम।<verse eid="ROM 5:21" /></para>
  <chapter eid="ROM 5" />
  <chapter number="6" style="c" sid="ROM 6" />
  <para style="s">पाप मे मरला, मसी मे जीवत्‌ला</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 6:1" />ता आमु ह़ु कीया? आमने पाप करतात रेवा जोवे ह़ु के भगवान नी गीण-दया जादा हये? <verse eid="ROM 6:1" /><verse number="2" style="v" sid="ROM 6:2" />कदी नी! आमु जत्‌यार पाप ना लेदे मर ज्‌या ता आनी सी अगा तीनी मे कीसम जीवहु? <verse eid="ROM 6:2" /><verse number="3" style="v" sid="ROM 6:3" />तमु नी जाणता ह़ु के आपणु आखा जे मसी ईसु ना बपतीस्‌मा लेदा, तीनी मोत मे बपतीस्‌मा लेदा। <verse eid="ROM 6:3" /><verse number="4" style="v" sid="ROM 6:4" /><note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="COL 2:12">कुलुस्‌यो 2:12</ref></char></note>अने तीहयी मोत ना बपतीस्‌मा लेवा सी आपणु तीनी ह़ाते गड़ाय ज्‌या, काहाके जीसम मसी बाह नी बड़ाय ना लेदे मरला मे गेथो जीवाड़्‌यो, तीसमेत आपणु बी नवली जीवाय नी चाल चालो।<verse eid="ROM 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 6:5" />काहाके कदी आपणु तीनी मोत मे तीनी ह़ाते र्‌या ता तीनीन तेम पासा जीवता हयवा मे बी तीनी ह़ाते रेहु। <verse eid="ROM 6:5" /><verse number="6" style="v" sid="ROM 6:6" />आमने मालम से के अमारी पुराणी जीवाय तीनी ह़ाते कुरुस पोर चड़ाय देदी, काहाके पापी डील फालतु हय जाय, अने आमु अगा पाप ना गुलाम नी रीया। <verse eid="ROM 6:6" /><verse number="7" style="v" sid="ROM 6:7" />काहाके जे मर ज्‌यु, तीहयु पाप सी छुटीन धरमी ठेर्‌यु। <verse eid="ROM 6:7" /><verse number="8" style="v" sid="ROM 6:8" />आनीन करते कदी आमु मसी ह़ाते मर ज्‌या, ता अमारो भरहो आहयो से के तीनी हाते जीवहु बी। <verse eid="ROM 6:8" /><verse number="9" style="v" sid="ROM 6:9" />काहाके आहयु जाणये के मसी मरला मे गेथो जीवतो हय्‌न पासो मरवा नो नी; हाव तीनी पोर मोत नो हक नी रेय। <verse eid="ROM 6:9" /><verse number="10" style="v" sid="ROM 6:10" />काहाके तीहयो जे मर ज्‌यो ता पाप ना लेदे एकी कावा मर ज्‌यो; पण जे जीवत्‌लो से ता भगवान ना लेदे जीवत्‌लो से। <verse eid="ROM 6:10" /><verse number="11" style="v" sid="ROM 6:11" />आसमेत तमु बी खुद नी लेदे ह़मजो के तमु पाप ना लेदे मर ज्‌या, पण भगवान ना कारण मसी ईसु मे जीवत्‌ला ह़मजो।<verse eid="ROM 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 6:12" />आनीन करते पाप तमारा मरला डील मे राज नी करे, के तमु तीनी हेर ना हक मे रेवो; <verse eid="ROM 6:12" /><verse number="13" style="v" sid="ROM 6:13" />अने आपणा अंगु ने अधरम नी सेवा ना लेदे पाप ना सुपरत ना करो पण खुद ने मरला मे गेथो पासो जीवतो हयो ह़मजीन भगवान ने ह़ोप देवो, अने आपणा डील ना अंगु ने धरम ना हत्‌यार ना रुप मे भगवान ना सुपरत कर देवो। <verse eid="ROM 6:13" /><verse number="14" style="v" sid="ROM 6:14" />तत्‌यार तमारी पोर पाप नो हक नी रेय, काहाके तमु कायदा ना हक मे नी, पण बरकत ना हक मे से।<verse eid="ROM 6:14" /></para>
  <para style="s">धारमीक्‌ता नो पावोर</para>
  <para style="p">
    <verse number="15" style="v" sid="ROM 6:15" />ता ह़ु हयु? आमु आनीन करते पाप करीया के आमु कायदा ना हक मे नी पण बरकत ना हक मे से? कदी नी! <verse eid="ROM 6:15" /><verse number="16" style="v" sid="ROM 6:16" />तमु नी जाणता के कोयना हुकम मानवा करीन तमु आह़फा ने गुलाम ना रुप मे ह़ोप देवो, तीनात गुमाल से, चाहे पाप ना जीनु आखरी मे मरनु से, <verse eid="ROM 6:16" /><verse number="17" style="v" sid="ROM 6:17" />पण मे भगवान ने तु घणो वारु से केम, के तमु जे पेले पाप ना पावर्‌या हता, पण ते बी हाव मन सी तीनी ह़ीकापण ने मानवा बाज ज्‌या, जे ह़ीकापण ना ह़ाचा मे ढाळला से। <verse eid="ROM 6:17" /><verse number="18" style="v" sid="ROM 6:18" />अने हाव तमु पाप नी गुलामी मे गेथा छुटीन धरम ना पावर्‌या बण जेला से। <verse eid="ROM 6:18" /><verse number="19" style="v" sid="ROM 6:19" />मे तमारा डील नी लुलखाय ना लेदे माणहु ना अनसारे केम, जीसम तमु आपणा अंग ने पाप करवा करीन वीटळ्‌ला काम करवा अने छीनाळा ना गुलाम बणाय्‌न तीना हात मे आपला हता, तेमेत हाव तमु आपणा अंग ने चोखलो बणाव्‌वा करीन भगवान ना धरम ना पावर्‌या बणाय्‌न तीना हात मे ह़ोप देवो।<verse eid="ROM 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ROM 6:20" />जत्‌यार तमु पाप ना पावर्‌या हता, ता धरम वगे गेथा तमु छुटला हता। <verse eid="ROM 6:20" /><verse number="21" style="v" sid="ROM 6:21" />एतरे जे वात सी तमु लजवाय र्‌या, ता तीहयी वात सी पेले तमने कंय फायदो हयत्‌लो? काहाके तीनो आखरी फोळ ते मोत से। <verse eid="ROM 6:21" /><verse number="22" style="v" sid="ROM 6:22" />पण हाव पाप नी गुलामी गेथा छुटीन भगवान ना गुलाम बणीन, तमने आहयो फोळ जड़लो से के तमु चोखला बण जावो, अने आखरी मे अमरकाय जीवाय हात करवु से। <verse eid="ROM 6:22" /><verse number="23" style="v" sid="ROM 6:23" />काहाके पाप नी दाड़की ते मोत से, पण भगवान नो फोकट्‌यो वाटो आपणा मालीक ईसु मसी मे अमरकाय जीवाय से।<verse eid="ROM 6:23" /></para>
  <chapter eid="ROM 6" />
  <chapter number="7" style="c" sid="ROM 7" />
  <para style="s">वेवा हयला जीवाय नो उदारण</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 7:1" />ए भायु तमु नी जाणता ह़ु मे कायदा ने जाणवा वाळा ने केम, के जत्‌यार लग माणेह जीवत्‌लो रेय, तत्‌यार लग तीनी पोर कायदा नो राज रेहे? <verse eid="ROM 7:1" /><verse number="2" style="v" sid="ROM 7:2" />काहाके लाडा वाळी बयर कायदा ना अनसारे आपणा लाडा सी तीहयो जीवत्‌लो रेय तां लग बंदायली रेय, पण लाडो मर जाय, ता तीहयी लाडा ना कायदा सी छुट जी। <verse eid="ROM 7:2" /><verse number="3" style="v" sid="ROM 7:3" />आनीन करते कदी लाडा ना जीवतेत तीहयी बीजा माणेह नी हय जाय ता तीहयी छीनाळ्‌याण केवायहे, पण कदी लाडो मर जाय, ता कायदा सी छुट जी, आञे लग के कदी बीजा माणेह नी हय जाय ते बी छीनाळ्‌याण नी ठेरे। <verse eid="ROM 7:3" /><verse number="4" style="v" sid="ROM 7:4" />तेमेत ए मारा भायु, तमु बी मसी ना डील ना लारे कायदा ना लेदे मरला बण ज्‌या, के तीहया बीजा ना हय जावो, जे मरला मे गेथो जीवी उठ्‌यो: काहाके आमु भगवान ना लेदे फोळ लावये। <verse eid="ROM 7:4" /><verse number="5" style="v" sid="ROM 7:5" />काहाके जत्‌यार आमु डील ना हता, ता पाप नी लालच जे कायदा ना लारे हती, मोत ना फोळ पयदा करवा करीन आपणा डील मे काम करती हती। <verse eid="ROM 7:5" /><verse number="6" style="v" sid="ROM 7:6" />पण जीना हक मे आमु हता तीना लेदे मरीन, हाव कायदा सी छुट ज्‌या, के लीखायलु नी पुराणी रीती पोर नी पण आत्‌मा नी नवली रीती पोर सेवा कर र्‌या।<verse eid="ROM 7:6" /></para>
  <para style="s">कायदा अने पाप</para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 7:7" />ता आमु ह़ु कीया? ह़ु कायदा पाप से? कदी नी! पण बीना कायदा नो मे पाप ने नी ओळखतो: कायदो कदी नी केतो, के लालच ना कर, ता मे लालच नी जाणतो। <verse eid="ROM 7:7" /><verse number="8" style="v" sid="ROM 7:8" />पण पाप मोखो देखीन हुकम ना लारे मारी मे आखा लालच पयदा कर्‌यो, काहाके बीना कायदा सी पाप मरलो से। <verse eid="ROM 7:8" /><verse number="9" style="v" sid="ROM 7:9" />मे ते कायदा वगर नो पेले जीवत्‌लो हतो, पण जत्‌यार हुकम आयो, ता पाप जीवी ज्‌यो, अने मे मर ज्‌यो। <verse eid="ROM 7:9" /><verse number="10" style="v" sid="ROM 7:10" />अने तीहयोत हुकम जे जीवाय ना लेदे हतो, मारा लेदे मोत नो कारण ठेर्‌यो। <verse eid="ROM 7:10" /><verse number="11" style="v" sid="ROM 7:11" />काहाके पाप मोखो देखीन हुकम ना लारे मने धोको देदो, अने तीना लारे मने मारी बी नाख्‌यो।<verse eid="ROM 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 7:12" />आनीन करते कायदो चोखलो से, अने हुकम बी चोखलो, वारु अने धरमी से अने वारलो से। <verse eid="ROM 7:12" /><verse number="13" style="v" sid="ROM 7:13" />ता तीहयी वात जे वारु हती मारी लेदे मोत नो कारण बणी? कदी नी! पण पाप तीहयी वारली चीज ना लारे मारा लेदे मोत ने पयदा करवा वाळो बण्‌यो के तीनो पाप हयवा उजन्‌तो हये, अने हुकम ना लारे पाप घणो पापी बण्‌यो।<verse eid="ROM 7:13" /></para>
  <para style="s">पाप अने कायदा</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 7:14" />आमु जाणये के कायदा ते आत्‌मीक से, पण मे कळी अने पाप ना हाते वेचायलो चाकर्‌यो से। <verse eid="ROM 7:14" /><verse number="15" style="v" sid="ROM 7:15" /><note caller="+" style="x"><char style="xo" closed="false">7:15 </char><char style="xt" closed="false"><ref loc="GAL 5:17">गलातीयो 5:17</ref></char></note>जे मे करु तीने नी जाणतो; काहाके जे मे चाहु तीहयु नी करतो, पण जीनी सी मने ह़ीगी आवे तीहयुत करु। <verse eid="ROM 7:15" /><verse number="16" style="v" sid="ROM 7:16" />अने कदी, मे नी चाहु तीहयुत करु, ता मे मान लेम के कायदो भलो से। <verse eid="ROM 7:16" /><verse number="17" style="v" sid="ROM 7:17" />ता आवी हालत मे तीनो करवा वाळो मे नी, पण पाप से जे मारी मे बहलो से। <verse eid="ROM 7:17" /><verse number="18" style="v" sid="ROM 7:18" />काहाके मे जाणु के मारी मे अने मारा डील मे वारलु नी रेय, हेर ते मारी मे से, पण भला काम करवा नी मारी मे ताखत नी हय। <verse eid="ROM 7:18" /><verse number="19" style="v" sid="ROM 7:19" />काहाके जे वारला काम नी मे हेर करु तीहया ते नी करु, पण जे बुराय नी हेर नी करु, तीनेत कर्‌या करु। <verse eid="ROM 7:19" /><verse number="20" style="v" sid="ROM 7:20" />अने कदी मे तीहयुत कर्‌या करु जीनी हेर नी करु, ता तीनो करवा वाळो मे नी, पण पाप जे मारी मे बह र्‌यो।<verse eid="ROM 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 7:21" />जत्‌यार मने कायदो जड़्‌यो ता पतो चाल्‌यो के जत्‌यार भलाय करवा नु हेर करु, ता बुरायत करु। <verse eid="ROM 7:21" /><verse number="22" style="v" sid="ROM 7:22" />काहाके मे मोय ना मन सी ते भगवान ना कायदा सी घणो खुस रेम। <verse eid="ROM 7:22" /><verse number="23" style="v" sid="ROM 7:23" />पण मारा डील ना अंगु मे बीजा भाती ना कायदा नी जानकारी करु, जे मारा मन ना कायदा सी झुमाय अने मने पाप ना कायदा ना कब्‌जा मे नाख देय जे मारा अंग मे रेय। <verse eid="ROM 7:23" /><verse number="24" style="v" sid="ROM 7:24" />मे केवो नीकम्‌मो माणेह से! मने आहयी मोत ना डील सी कोय सोड़ावहे? <verse eid="ROM 7:24" /><verse number="25" style="v" sid="ROM 7:25" />अमारा मालीक ईसु मसी ना लारे भगवान ने घणो वारु से केम। आनीन करते के मे मन मे ते भगवान ना कायदा नो, पण डील सी पाप ना कायदा नी सेवा करु।<verse eid="ROM 7:25" /></para>
  <chapter eid="ROM 7" />
  <chapter number="8" style="c" sid="ROM 8" />
  <para style="s">चोखली आत्‌मा ना लारे जीवाय</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 8:1" />हाव जे मसी ईसु मे से, तीमनी पोर डंड नो हुकम नी हय। <verse eid="ROM 8:1" /><verse number="2" style="v" sid="ROM 8:2" />काहाके चोखली आत्‌मा नो कायदो मसी ईसु ना लारे जीवाय आपे, मने पाप अने मोत ना कायदा सी सोड़ाय लेदी। <verse eid="ROM 8:2" /><verse number="3" style="v" sid="ROM 8:3" />काहाके जे काम कायदा डील नी कमजोरी ना कारण सी नी कर सक्‌यो, तीने भगवान कर्‌यो, अने आह़फा ना सोरा ने पापी डील मे हय्‌न अने पाप ना लेदे मरवा करीन मोकल्‌यो, डील मे पाप पोर डंड नो हुकम आप्‌यो। <verse eid="ROM 8:3" /><verse number="4" style="v" sid="ROM 8:4" />आनीन करते कायदा नो नेम अमारी मे जे डील ना अनसारे नी पण आत्‌मा ना अनसारे चाले अने पुरी करे। <verse eid="ROM 8:4" /><verse number="5" style="v" sid="ROM 8:5" />काहाके डील नु माणेह डील नी वात पोर मन लगाड़े; पण आतमीक माणेह आत्‌मा नी वात पोर मन लगाड़े। <verse eid="ROM 8:5" /><verse number="6" style="v" sid="ROM 8:6" />डील पोर मन लगाड़वा ते मोत से, पण आत्‌मा पोर मन लगाड़वा जीवाय अने सांती से। <verse eid="ROM 8:6" /><verse number="7" style="v" sid="ROM 8:7" />काहाके डील पोर मन लगाड़वा ते भगवान सी रीह करवा से, काहाके नी ते भगवान ना कायदा मे हय, अने नी ते हय सके। <verse eid="ROM 8:7" /><verse number="8" style="v" sid="ROM 8:8" />अने जे डील नी हालत मे से, तीहया भगवान ने खुस नी कर सके।<verse eid="ROM 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 8:9" />पण जत्‌यार के भगवान नी आत्‌मा तमारी मे बहे, ता तमु डील नी हालत मे नी पण आत्‌मा नी हालत मे से। कदी काना मे मसी नी आत्‌मा नी हय, ता तीहयो मसी नो नी हय। <verse eid="ROM 8:9" /><verse number="10" style="v" sid="ROM 8:10" />कदी मसी मे तमु हय, ता डील पाप ना कारण मरलु से; पण आत्‌मा धरम ना कारण जीवत्‌ली से। <verse eid="ROM 8:10" /><verse number="11" style="v" sid="ROM 8:11" /><note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 कुरन्‌थी 3:16</ref></char></note>अने कदी तीनीत आत्‌मा जे ईसु ने मरला मे गेथो जीवाड़लो तीनीत आत्‌मा तमारी मे रेय, ता जे मसी ने मरला मे गेथो जीवाड़लो, तीहयो आह़फा नी आत्‌मा ना लारे जे तमारी मे रेय, तमारा मरवा वाळा डील ने बी जीवाड़हे।<verse eid="ROM 8:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 8:12" />आनीन करते ए भायु, आपणु डील ना करजाळ्‌ळा नी, के डील ना अनसारे दाड़ा काटये। <verse eid="ROM 8:12" /><verse number="13" style="v" sid="ROM 8:13" />काहाके कदी तमु डील ना अनसारे दाड़ा काटहु ता मरहु, कदी आत्‌मा सी डील ना काम ने मारहु ता जीवत्‌ला रेहु। <verse eid="ROM 8:13" /><verse number="14" style="v" sid="ROM 8:14" />आनीन करते के जेतरा माणहु भगवान नी आत्‌मा चलाड़े तेम चाले, तीहयात भगवान नी अवल्‌यात से। <verse eid="ROM 8:14" /><verse number="15" style="v" sid="ROM 8:15" /><note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="GAL 4:5-7">गलातीयो 4:5-7</ref></char></note><note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="MRK 14:36">मरकुस 14:36</ref>; <ref loc="GAL 4:6">गलातीयो 4:6</ref></char></note>काहाके तमने पावोर नी आत्‌मा नी जड़ी, के अळी बीह जाय पण तीनी अवल्‌यात हयवा नी आत्‌मा जड़ली से, जीनी सी आमु ओ डायला बाह, ओ बाह कीन आड़ीया। <verse eid="ROM 8:15" /><verse number="16" style="v" sid="ROM 8:16" />आत्‌मा खुद अमारी आत्‌मा ह़ाते गवाय देय, के आमु भगवान ना अवल्‌यात से। <verse eid="ROM 8:16" /><verse number="17" style="v" sid="ROM 8:17" />अने सोरो से ता वारीस बी, पण भगवान नो वारीस अने मसी नो ह़ाती वारीस से, के जत्‌यार आमु तीनी ह़ाते दुख झेलहु ता तीनी ह़ाते बड़ाय बी हयहे।<verse eid="ROM 8:17" /></para>
  <para style="s">अगी उजन्‌ती हयवा वाळी बड़ाय</para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 8:18" />काहाके मे आहयु ह़मजु के आहयी टेमे वाळा दुख अने वेला, आव्‌वा वाळी टेम अमारी पोर उजन्‌ती हयवा वाळी बड़ाय अगळ फीका से। <verse eid="ROM 8:18" /><verse number="19" style="v" sid="ROM 8:19" />काहाके आहयी कळी घण-जबर आह करीन भगवान ना सोरा ने उजन्‌तो हयवा नी डोळा फाट वाट जोय र्‌या। <verse eid="ROM 8:19" /><verse number="20" style="v" sid="ROM 8:20" />काहाके आहयी कळजुग ने आह़फा नी मरजी सी बगाड़वा वाळा ना हात मे नी आप्‌यो, पण जे कब्‌जा मे कर देय तीना वगे गेथी आहयी आह सी बगाड़वा वाळा ना हात मे आप देदलो से। <verse eid="ROM 8:20" /><verse number="21" style="v" sid="ROM 8:21" />के आहयी कळजुग बी आह़फोत बगाड़ीन गुलामी मे गेथो छुटकारो हात करे तेम, अने भगवान नी अवल्‌यात नी बड़ाय नो छुटकारो बी हात करे तेम। <verse eid="ROM 8:21" /><verse number="22" style="v" sid="ROM 8:22" />काहाके आपणु ने मालम से के आखी धरती हमणे लग कंजारीन वेला करीन फपड़ी री। <verse eid="ROM 8:22" /><verse number="23" style="v" sid="ROM 8:23" /><note caller="+" style="x"><char style="xo" closed="false">8:23 </char><char style="xt" closed="false"><ref loc="2CO 5:2-4">2 कुरन्‌थी 5:2-4</ref></char></note>हीयीत एतरीत नी फपड़ती, पण आपणु बी वेला कर र्‌या, जीमने भगवान नी आत्‌मा नो पेलो फोळ जड़ र्‌यो, आह़फात कंजारी र्‌या; अने खोळे लेदला सोरा बणवा नु, मतलब आपणा डील ना छुटकारा नी वाट जोय र्‌या। <verse eid="ROM 8:23" /><verse number="24" style="v" sid="ROM 8:24" />आह नी लारेत आपणो छुटकारो हयलो से, पण जे चीज नी आपणु आह करया, अने तीहयीत चीज देखवा मे आवे, ता तीहयी चीज आह नी केवाय? काहाके जे चीज ने कोय देखवा बाज र्‌यो हय, ता तीहयो ते चीज नी आह काहा करहे? <verse eid="ROM 8:24" /><verse number="25" style="v" sid="ROM 8:25" />पण जे चीज ने आपणु नी देखया, कदीम तीहयीत चीज नी आह करया, ता गम खाय्‌न डोळा फाट वाट बी जोवया।<verse eid="ROM 8:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="ROM 8:26" />आहयीत रीते भगवान नी आत्‌मा बी आपणी लुलखाय मे आपणु ने सात देय, काहाके आपणु ने आहयु नी मालम हय के आपणु ने कीकम भगवान ह़ाते वीन्‌ती करवा जोवे; पण भगवान नी आत्‌मा आह़फीत डहका लीन आपणी ह़मज गेथी बारी हय्‌न भगवान ह़ाते वीन्‌ती करे। <verse eid="ROM 8:26" /><verse number="27" style="v" sid="ROM 8:27" />अने आपणु मन ने पारखवा वाळो भगवान जाणे के भगवान नी आत्‌मा नी मरजी ह़ु से? काहाके तीहयो भगवान नी आत्‌मा चोखला माणहु जुगु भगवान नी मरजी ना अनसारे भगवान ह़ाते वीन्‌ती करे।<verse eid="ROM 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="ROM 8:28" />अने आपणु ने मालम से के जे भगवान ने मोंग करे, तीमनी जुगु आखी वात भलाय नेत उबजाड़े, मतलब तीहया माणहु जुगु भलाय उबजाड़े जे भगवान नी मरजी ना अनसारे भगवान ना बोलावला से। <verse eid="ROM 8:28" /><verse number="29" style="v" sid="ROM 8:29" />काहाके जीमने तीहयो पेले गेथोत जाण लेदो, तीमने तीहयो पेले गेथो ठेराय बी देदो, आनीन करते के तीहया भगवान ना बेटा ना सीका मे बण जाय अने भगवान नो बेटो ढेरेत भाय-बेन्‌या मे पेलखोळ्‌यो बेटो बण जाय तेम। <verse eid="ROM 8:29" /><verse number="30" style="v" sid="ROM 8:30" />आसम करीन भगवान जीमने पेले गेथो ठेरायो, तीमने बोलायो बी, अने जीमने बोलायो तीमने धरमी बी ठेरायो, अने जीमने धरमी ठेरायो तीमने बड़ाय मे बी भेसकी देदो।<verse eid="ROM 8:30" /></para>
  <para style="s">मसी ईसु मे भगवान नो मोंग</para>
  <para style="p">
    <verse number="31" style="v" sid="ROM 8:31" />एतरे ए भायु! आहयी वात ने जाणीन आमु ह़ु कीया? आहयु कीया के कदीम भगवान अमारी वगो से, ता अमारो वीरोद कोय करहे? कोय नी करे। <verse eid="ROM 8:31" /><verse number="32" style="v" sid="ROM 8:32" />भगवान आह़फा ना बेटा ने लग आपणीन करते मरवा करीन आप देदो: ता तीनी ह़ाते आपणु ने अळी आखु कंय काहा नी आपे? आपहेन आपहे। <verse eid="ROM 8:32" /><verse number="33" style="v" sid="ROM 8:33" />भगवान जीमने टाळलो से, तीमनी पोर कोय गुनो ढाळहे? कोय नी ढाळे। भगवान ते आह़फोत तीमने धरमी ठेराव्‌वा वाळो से। <verse eid="ROM 8:33" /><verse number="34" style="v" sid="ROM 8:34" />ता आसम कोय से, जे तीमने डंड नो हुकम आपहे? ईसु मसी डंड नो हुकम आपहे ह़ु? नी आपे। काहाके तीहयो ते मर ज्‌यो, अने मर्‌या-ह़र्‌या मे गेथो जीवतो हय्‌न बठो बी हय ज्‌यो, अने भगवान ना जमणी धेड़े बह र्‌यो, अने आपणी जुगु भगवान ह़ाते वीन्‌ती बी कर्‌या करे। <verse eid="ROM 8:34" /><verse number="35" style="v" sid="ROM 8:35" />आपणु ने ईसु मसी ना मोंग गेथा सेटा करवा नी हीम्‌मत कोय पांह से? वेला आंग्‌ये करहे ह़ु, नीता काळ आंग्‌ये करहे ह़ु, नीता नांगरला रेहु ता आंग्‌ये हय जहु ह़ु, नीता आफत आवहे ता आंग्‌ये हय जहु ह़ु, तलवार सी मारवा आवहे ता आंग्‌ये हय ह़ु? <verse eid="ROM 8:35" /><verse number="36" style="v" sid="ROM 8:36" />जीसम खरला सास्‌तर मे लीखलु बी से:</para>
  <para style="q1" vid="ROM 8:36">तारी जुगु आमु दाड़ीन मोत ना हात मे अपाय जीया।</para>
  <para style="q2" vid="ROM 8:36">आमु ते तीहया गाडरान तेम गीणाये, जे गाडरा ने मार नाखे।<verse eid="ROM 8:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="ROM 8:37" />पण ते बी आमु भगवान ना लारे जे आमु ने मोंग कर्‌यो जीक गेथा बी अगा सेकीन से। <verse eid="ROM 8:37" /><verse number="38" style="v" sid="ROM 8:38" />काहाके मने भरहो से के कोय बी चीज आमने तीना मोंग सी अलग नी कर सके, नी ते मोत अने नी ते जीवाय, नी ते ह़रगदुत अने नी ते बुरो मुख्‌यो, नी ते हमणे अने नी अळतेण, अने नी ताखत, <verse eid="ROM 8:38" /><verse number="39" style="v" sid="ROM 8:39" />नी उचाय अने नी उंडाय अने नी कंय कळी मे बणावली चीज, आमने भगवान ना मोंग सी, जे अमारा मालीक मसी ईसु मे से अलग कर सके।<verse eid="ROM 8:39" /></para>
  <chapter eid="ROM 8" />
  <chapter number="9" style="c" sid="ROM 9" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 9:1" />मे ईसु मसी मे ह़ाचलीनेत केम, मे झुट नी मेल्‌तो, अने मारु मन बी चोखली आत्‌मा भेळतु गवा देय; <verse eid="ROM 9:1" /><verse number="2" style="v" sid="ROM 9:2" />के मे घण-जबर दुखी से, अने मारु मन बी एक रंगु दुख्‌तु रेय। <verse eid="ROM 9:2" /><verse number="3" style="v" sid="ROM 9:3" />काहाके मारी आहयी हेर से, के मे मारा भाय-बेटा जुगु, जे डील ना अनसारे भाय-बेटा से, ईसु मसी गेथो आग्‌ये हयवा नी हेर कर र्‌यो। <verse eid="ROM 9:3" /><verse number="4" style="v" sid="ROM 9:4" />तीहया ईस्‌रायली से; खोळे लेवायवा नो हक, अने बड़ाय, अने वायदो, अने कायदो, अने भगवान नी भक्‌ती करवा ना हक नी बोली भगवान ईमनी ह़ाते करलो से। <verse eid="ROM 9:4" /><verse number="5" style="v" sid="ROM 9:5" />डाह-डाहा बी ईमनी ह़ाते जोड़ायला से, अने ईसु मसी बी डील ना मान सी ईमनी मेत पयदा हयलो से, जे आखाम नो भगवान से, अने पीड़ीडीट आखाम नी पोर राज करे जे जलम जुगाळु से।<verse eid="ROM 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 9:6" />पण आसम नी हयु के भगवान नी करली बोली टळ जी, काहाके ईस्‌रायली अवल्‌यात मे आखा ईस्‌रायली नी हय। <verse eid="ROM 9:6" /><verse number="7" style="v" sid="ROM 9:7" />अने आखा अब्‌राहम नी कुळी मे पयदा हया करीन आखा तीनीत अवल्‌यात नी हय, पण लीखलु से के “ईसाक ना लारेत तारो वेल वदहे।” <verse eid="ROM 9:7" /><verse number="8" style="v" sid="ROM 9:8" />मतलब डील ना अनसारे पयदा हयवा वाळी अवल्‌यात भगवान नी अवल्‌यात नी हय, पण भगवान नी बोली ना अनसारे पयदा हयली अवल्‌यातेत भगवान नी अवल्‌यात गीणाय। <verse eid="ROM 9:8" /><verse number="9" style="v" sid="ROM 9:9" />काहाके वायदा नी बोली आहयी से, के “मे वारु टेम ना अनसारे पासो आवही, अने तीहयी टेमे सारा नो एक सोरो हय रेहे।”<verse eid="ROM 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 9:10" />अने एतरुत नी, पण रीबीका लग एकीत अदमी ना लारे भारेपोगे हयी, अने तीना बे सोरा हया जे आपणो बाह हतो अने तीनु नाम ईसाक हतु। <verse eid="ROM 9:10" /><verse number="11" style="v" sid="ROM 9:11" />अने हजु लग सोरा पयदा नी हयला हता, अने तीहया भलु-बुरु नी करला हता, तीहयी टेमे भगवान पेले गेथो केदो, “मोट्‌लो भाय, नान्‌ला भाय नी गुलामी करहे।” <verse eid="ROM 9:11" /><verse number="12" style="v" sid="ROM 9:12" />एतरे भगवान नी मरजी तीना टाळला नी अनसारे हये, जे माणेह काम ना अनसारे टेकलो नी रेय, पण बोलाव्‌वा वाळा भगवान ना लारे टेकलो रेहे। आनीत अनसारे रीबीका ने केदलु हतु “तारो मोट्‌लो सोरो, तारा नान्‌ला सोरा नी सेवा-चाकरी करहे।” <verse eid="ROM 9:12" /><verse number="13" style="v" sid="ROM 9:13" />खरला सास्‌तर मे लीखलु से: “मे एसाव सी याकुब ने जादा मोंग कर्‌यो।”<verse eid="ROM 9:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 9:14" />एतरे आपणु ह़ु कीया? भगवान अगळ नीयाव नी हये ह़ु? कदी नी! <verse eid="ROM 9:14" /><verse number="15" style="v" sid="ROM 9:15" />काहाके भगवान मुसा ने केय, “जीनी पोर दया करवा लागे तीनी पोर दया करही, अने जीनी पोर गीण करवा लागे तीनी पोर गीण करही।” <verse eid="ROM 9:15" /><verse number="16" style="v" sid="ROM 9:16" />एतरे आहयी वात हेर करन्‌या माणहु पोर टेकली नी हय, अने मेहनत करवा वाळा पोर बी टेकली नी हय, पण दया करवा वाळा भगवान पोर टेकली से। <verse eid="ROM 9:16" /><verse number="17" style="v" sid="ROM 9:17" />काहाके खरला सास्‌तर मे फीरोन ने केदलु हतु, के “मे तने आनीन करते टाळलो से, के मे तारी पोर मारी ताखत देखाड़ु, अने आसम करीन मारा नाम नो परच्‌यार आखी कळी मे हये।”<note caller="+" style="x"><char style="xo" closed="false">9:17 </char><char style="xt" closed="false"><ref loc="EXO 9:16">नीरगमन 9:16</ref></char></note> <verse eid="ROM 9:17" /><verse number="18" style="v" sid="ROM 9:18" />एतरे तीने जीनी पोर दया करवा लागे तीनी पोर दया करे; अने जीने एकहीट्‌यो बणाव्‌वा लागे तीने एकहीट्‌यो बणाय देय।<verse eid="ROM 9:18" /></para>
  <para style="s">भगवान नी रीह अने दया</para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 9:19" />आहयु ह़मळीन तु आहयु केही के “ता भगवान बीजा नो वाक काहा काडे? जरीक वीच्‌यार करो! भगवान नी मरजी नो वीरोद कोय कर सके?” <verse eid="ROM 9:19" /><verse number="20" style="v" sid="ROM 9:20" />ए माणेह तु कोय से जे भगवान ने ह़ाम्‌बो जपाप आप देय? घड़ली चीज घड़न्‌या ने आहयु की सके ह़ु, तु मने आसम काहा घड़्‌यो? <verse eid="ROM 9:20" /><verse number="21" style="v" sid="ROM 9:21" />ह़ु कुमार ने कादा पोर हक नी हय ह़ु? के तीहयो कादा ना एकी लोये करीन एक ठाहरु वारु कामे लगाड़वा करीन अने एक ठाहरु खराब काम मे लगाड़वा करीन घड़े।<verse eid="ROM 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 9:22" />पेल्‌ना वारा नो भगवान आह़फा नी रीह देखाड़वा अने आह़फा नी सक्‌ती देखाड़वा करीन रीह लागे एवा माणहु नी वेठ लेदो, जे जलमका खुटवा करीन घड़ायला हता। <verse eid="ROM 9:22" /><verse number="23" style="v" sid="ROM 9:23" />अने दया आवे एसवा माणहु नो फायदो करवान करते तीहयो तीमनी वेठ लेदो, तीमने भगवान आह़फा नी बड़ाय देखाड़वान करते घड़लो हतो। <verse eid="ROM 9:23" /><verse number="24" style="v" sid="ROM 9:24" />दया आवे एसवा माणहु आपणुत हता, तीहया युहदी मे ना एतरात नी हता, पण आड़जात्‌या माणहु मे ना बी हता। <verse eid="ROM 9:24" /><verse number="25" style="v" sid="ROM 9:25" />जीसम के तीहयो होसे नाम नी कीताप मे बी केय,</para>
  <para style="q1" vid="ROM 9:25">“जे मारा असामी नी हता तीमने मे मारा असामी केही,</para>
  <para style="q2" vid="ROM 9:25">अने जे मारा मोंगाळ्‌ळा नी हता तीमने मे मारा मोंगाळ्‌ळा केही।”<verse eid="ROM 9:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="ROM 9:26" />अने जे जागा पोर तीमने आहयु केदलु हतु, “तमु मारा माणहु नी हय”</para>
  <para style="q2" vid="ROM 9:26">तीहयात जागा मे तीहया जीवत्‌ला भगवान नी अवल्‌यात केवायहे।<verse eid="ROM 9:26" /></para>
  <para style="m">
    <verse number="27" style="v" sid="ROM 9:27" />अने यसायो ईस्‌रायली माणहु ना बारा मे आड़ीन केय, “भले ईस्‌रायली माणहु नी गीनती दर्‌या नी बालु रेत ना काकरान तेम हहे, ते बी तीमनी मे थोड़ाक बचहे। <verse eid="ROM 9:27" /><verse number="28" style="v" sid="ROM 9:28" />काहाके भगवान धरती पोर तीनो डंड नो हुकम ममार पुरो करहे।” <verse eid="ROM 9:28" /><verse number="29" style="v" sid="ROM 9:29" />जीसम यसायो पेले बी केतो हतो, “कदीम मेळा नो भगवान आपणी जुगु थोड़ीक अवल्‌यात नो वेल नी सोड़तो ता आपणु सदोम अने अमोरा ह़ेर ने तेम हय जता।”<verse eid="ROM 9:29" /></para>
  <para style="s">ईस्‌रायल नो वण-भरहो</para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 9:30" />हाव ह़ु केवा जोवे? आहयु केवा जोवे के आड़जात्‌या जे भगवान ना धरम नी हेर नी करत्‌ला तीमने भगवान नो धरम जड़ ज्‌यो मतलब तीहया धरम ने जे भरहा नी लारे से। <verse eid="ROM 9:30" /><verse number="31" style="v" sid="ROM 9:31" />पण ईस्‌रायली माणहु मुसा ना कायदा ना लारे जीवीन धरमी बणवा नी ह़ेर करत्‌ला। पण तीमने मुसा ना कायदा ना अनसारे जीवीन धरमी नी बणायु। <verse eid="ROM 9:31" /><verse number="32" style="v" sid="ROM 9:32" />तीमने आनीन करते धरमी नी बणायु काहाके तीहया मुसा ना कायदा भगवान पोर भरहो करीन नी पाळ्‌या पण कायदा पाळीन धरमी बणवा नी हेर कर्‌या अने तीहया ते ढाटड़े ठेहवाया जे तीमने पाड़ देय। <verse eid="ROM 9:32" /><verse number="33" style="v" sid="ROM 9:33" />सास्‌तर मे लीखलु से:</para>
  <para style="q1" vid="ROM 9:33">“देखो मे सीयोन मे एक ठेह लागवा नो दगड़ो,</para>
  <para style="q2" vid="ROM 9:33">अने ठोकर खावा ना चाफर्‌या मेकु,</para>
  <para style="q1" vid="ROM 9:33">अने जे कोय तीनी पोर भरहो करहे।</para>
  <para style="q2" vid="ROM 9:33">तीहयो लाजे नी पड़े।”<note caller="+" style="x"><char style="xo" closed="false">9:33 </char><char style="xt" closed="false"><ref loc="ISA 28:16">यसाया 28:16</ref></char></note><verse eid="ROM 9:33" /></para>
  <chapter eid="ROM 9" />
  <chapter number="10" style="c" sid="ROM 10" />
  <para style="p">
    <verse number="1" style="v" sid="ROM 10:1" />मारा भाय अने बेन्‌या, मे पुरा मन सी चाहु, अने भगवान सी वीन्‌ती करु के आखा माणहु बच जाय। <verse eid="ROM 10:1" /><verse number="2" style="v" sid="ROM 10:2" />तीमना बारा मे, मे आहयी गवाय देम के तीमनी मे भगवान लेदे होह ते से पण तीमनो आहयो होह खरला ग्‌यान ना अनसारे नी हय। <verse eid="ROM 10:2" /><verse number="3" style="v" sid="ROM 10:3" />भगवान नी धरमीपण ना बारा मे अंजाणला अने आपणीत धरमीपण बणाव्‌वा करीन तीहया होह मे खुद ने भगवान ना हक मे नी कर्‌या। <verse eid="ROM 10:3" /><verse number="4" style="v" sid="ROM 10:4" />तीहया आखा जणा वाटु, जे मसी पोर भरहो करे, मसीत धरमीपण ना कायदा नो खत्‌तम से।<verse eid="ROM 10:4" /></para>
  <para style="s">आखा जुगु छुटकारो</para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 10:5" />मुसो कायदा सी जड़ली धरमीपण ना बारा मे आहयु लीखे, “जे माणेह कायदा नो पाळण करहे तीहयो तीनी सी जीवत्‌लो रेहे।” <verse eid="ROM 10:5" /><verse number="6" style="v" sid="ROM 10:6" />पण भरहा सी जड़वा वाळी धारमीक्‌ता ना बारा मे सास्‌तर आहयु केय, “तु आह़फा ना मन मे आहयु ना पुछे, ह़रग मे उप्‌पर कोय जहे?” मसी ने हेटो धरती पोर लाव्‌वा। <verse eid="ROM 10:6" /><verse number="7" style="v" sid="ROM 10:7" />नीता मसी ने मरला मे गेथो जीवतो करवा करीन “पताळ मे कोय उतरहे?” <verse eid="ROM 10:7" /><verse number="8" style="v" sid="ROM 10:8" />ह़ु से आनो मतलब भगवान नो बोल तमारी पांह से तमारा मोडा मे के मन मे भरहा तीहयी खबर, जे अमारा परच्‌यार ना बारा मे से। <verse eid="ROM 10:8" /><verse number="9" style="v" sid="ROM 10:9" />आनीन करते कदी तमु आपणा मोडा सी ईसु ने मालीक करीन मान्‌ता हय अने मन मे आहयो भरहो करता हय के भगवान तीने मरला मे गेथो जीवतो करलो से ता तमने छुटकारो जड़हे। <verse eid="ROM 10:9" /><verse number="10" style="v" sid="ROM 10:10" />काहाके भरहो मन सी कराय, जीनु फोळ से धारमीक्‌ता अने मानवा मोडा सी हये जीनु फोळ से छुटकारो। <verse eid="ROM 10:10" /><verse number="11" style="v" sid="ROM 10:11" />चोखली सास्‌तर मे लीखलु से, आखा जणा जे तीनी मे भरहो करहे, तीहयो कदी लाजे नी पड़े। <verse eid="ROM 10:11" /><verse number="12" style="v" sid="ROM 10:12" />युहदी अने आड़जात्‌या मे कंय भेद-भाव नी र्‌यो काहाके एकीत मालीक आखा नो मालीक से, जे तीहया आखा ना लेदे, जे तीनी गवाय देता हय, <verse eid="ROM 10:12" /><verse number="13" style="v" sid="ROM 10:13" />काहाके सास्‌तर केय के, जे कोय मालीक नाम सी वीन्‌ती करहे, तीहयो छुटकारो हात करहे।<verse eid="ROM 10:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 10:14" />अने माणहु ईसु ना बारा मे ह़मळ्‌यात नी ता तीहया तीनी पोर कीसम भरहो करहे, अने तीहया ईसु पोर भरहो नी करे, ता तीहया तीना नाम सी काहा वीन्‌ती करहे, पण परच्‌यार करन्‌या वगर माणहु ईसु ना बारा कीसम ह़मळे? <verse eid="ROM 10:14" /><verse number="15" style="v" sid="ROM 10:15" />कदी परच्‌यार करन्‌या ने मोकल्‌लो नी हय ता कीसम परच्‌यार कर सकहे? चोखली सास्‌तर मे लीखलु से केवा वारु से तीहया पोगु जीनी लारे वारली वातु नी खुस-खबर लावे!<note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="ISA 52:7">यसाया 52:7</ref>; <ref loc="NAM 1:15">नहुम 1:15</ref></char></note> <verse eid="ROM 10:15" /><verse number="16" style="v" sid="ROM 10:16" />ते बी आखा भगवान नी खुस-खबर पोर ध्‌यान नी देदा, भगवान वगे गेथा बोलन्‌या यसाया नु लीखलु से: मालीक! कोय भरहो करलु से अमारी खबर पोर? <note caller="+" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="ISA 53:1">यसाया 53:1</ref></char></note> <verse eid="ROM 10:16" /><verse number="17" style="v" sid="ROM 10:17" />आनीन करते खुल्‌लु से के भरहा उबजवु ह़मळवा सी अने ह़मळवा मसी ना बोलु सी।<verse eid="ROM 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="ROM 10:18" />पण सवाल आहयो से; तीहया ह़मळ्‌या नी ह़ु? तीहया ह़मळ्‌ळा से:</para>
  <para style="q1" vid="ROM 10:18">तीनो बोल आखी धरती पोर अने,</para>
  <para style="q2" vid="ROM 10:18">तीनी खबर धरती ना आखरी लग पुग जेली से।<verse eid="ROM 10:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="ROM 10:19" />पण मे पुछु, ईस्‌रायली माणहु आने ह़मज सकहे ह़ु? पेले मुसो केदलो:</para>
  <para style="q1" vid="ROM 10:19">“मे एवा राज ना लारे तमारी मे रीह पयदा करही, एक वण-भरह्‌या जाती ना लारे तमारा</para>
  <para style="q2" vid="ROM 10:19">मन मे रीह पयदा करही।”<note caller="+" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="DEU 32:21">वेवस्‌थावीवरन 32:21</ref></char></note><verse eid="ROM 10:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="ROM 10:20" />यसायो हीम्‌मत राखीन केय,</para>
  <para style="q1" vid="ROM 10:20">“जे मने नी ह़ोदत्‌ला तीमने मे जड़ ज्‌यो,</para>
  <para style="q2" vid="ROM 10:20">अने जे मने पुछत्‌ला बी नी तीमनी अगळ मे उजन्‌तो हय ज्‌यो।”<note caller="+" style="x"><char style="xo" closed="false">10:20 </char><char style="xt" closed="false"><ref loc="ISA 65:1">यसाया 65:1</ref></char></note><verse eid="ROM 10:20" /></para>
  <para style="m">
    <verse number="21" style="v" sid="ROM 10:21" />पण ईस्‌रायली माणहु ना बारा मे तीहयो केय, मे आखो दाड़ो हुकम नी माने तीमनी अगळ अने जखड़ी पड़न्‌या अगळ मारो हात फेंदारलो र्‌यो<note caller="+" style="x"><char style="xo" closed="false">10:21 </char><char style="xt" closed="false"><ref loc="ISA 65:1">यसाया 65:1</ref></char></note>।<verse eid="ROM 10:21" /></para>
  <chapter eid="ROM 10" />
  <chapter number="11" style="c" sid="ROM 11" />
  <para style="s">ईस्‌रायेल पोर भगवान नी दया</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 11:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="PHP 3:5">फीलीपीयो 3:5</ref>
      </char>
    </note>एतरे मे केम: भगवान आह़फा ना माणहु ने सोड़ देदो ह़ु? कदी नी; मे बी ते ईस्‌रायली से: अब्‌राहम नी अवल्‌यात अने बीन्‌यामीन नी कुळी नो से। <verse eid="ROM 11:1" /><verse number="2" style="v" sid="ROM 11:2" />भगवान आह़फा ना माणहु ने नी सोड़्‌यो, जीमने तीहयो पेले गेथो टाळ लेदलो: खरली सास्‌तर मे एलीयो ईस्‌रायली माणहु नी वीरोद मे, भगवान ह़ाते वीन्‌ती करलो तीहयी वात तमने मालम नी हय ह़ु? <verse eid="ROM 11:2" /><verse number="3" style="v" sid="ROM 11:3" />“ए मालीक, तीहया तारी वगे गेथा वात करन्‌या माणहु़ ने मार नाख्‌या, अने तारी वेदी ने ओदार नाख्‌या; अने मे एखलोत बच र्‌यो, अने मने बी मारवा करीन ह़ोद र्‌या।” <verse eid="ROM 11:3" /><verse number="4" style="v" sid="ROM 11:4" />पण भगवान तीने ह़ु जपाप आप्‌यो, “मे मारी लेदे ह़ात हजार माणहु ने बचाड़ र्‌यो तीहया झुटा देवता नी पुजा-पाट नी कर्‌या।” <verse eid="ROM 11:4" /><verse number="5" style="v" sid="ROM 11:5" />आहयीत रीते आहयी टेमे बी भगवान नी दया सी टाळला घणा माणहु बच र्‌या। <verse eid="ROM 11:5" /><verse number="6" style="v" sid="ROM 11:6" />आहयु भगवान नी दया सी हयु, ता आहयु कामु ना अनसारे नी हयु, नीता भगवान नी दया अमथी हय जती।<verse eid="ROM 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 11:7" />ता ह़ु हय ज्‌यु? वात आहयी से के ईस्‌रायली माणहु जीने ह़ोदत्‌ला तीहयो तीमने नी जड़्‌यो; पण तीहयो टाळला माणहु ने जड़ ज्‌यो, अने रेला माणहु नु मन वातड़ु कर देदो। <verse eid="ROM 11:7" /><verse number="8" style="v" sid="ROM 11:8" />जीसम सास्‌तर मे लीखलु से, के भगवान तीमना मन ने वातड़ु कर देदलो से, आहया दाड़े लग तीहया देखी अने ह़मळ नी सके। <verse eid="ROM 11:8" /><verse number="9" style="v" sid="ROM 11:9" />दावुद केय;</para>
  <para style="q1" vid="ROM 11:9">“तीमनु खाणु तीमनी जुगु जाळ, अने फंदा,</para>
  <para style="q2" vid="ROM 11:9">अने ठोकर खाय्‌न पड़े, अने डंड जड़े।<verse eid="ROM 11:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="ROM 11:10" />तीमना डोळा पोर अंदारलु छवाय ज्‌यु,</para>
  <para style="q2" vid="ROM 11:10">अने नी देखे, अने तीमनु केड़्‌यु झुकाड़ राख।”<verse eid="ROM 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 11:11" />एतरे मे पुछु, तीहया ठोकर खादा ता बरबात हय जेला ह़ु? कदी नी पण तीहया ठोकर खादा एतरे आड़जात्‌या माणहु ने छुटकारो जड़्‌यो। के तीमने रीह लागे। <verse eid="ROM 11:11" /><verse number="12" style="v" sid="ROM 11:12" />एतरे हाव तीमनु पड़वु, कळी जुगु धन अने तीमनी कमी आड़जात्‌या जुगु धन नो कारण बण्‌यु, ता तीमना नफा सी केतरी मोटी बरकत जड़हे।<verse eid="ROM 11:12" /></para>
  <para style="s">आड़जात्‌या नो छुटकारो</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 11:13" />मे तमु आड़जात्‌या ने केम; जत्‌यार तक मे आड़जात्‌या जुगु नेवताळो से, ता मे मारी सेवा नी बड़ाय करु। <verse eid="ROM 11:13" /><verse number="14" style="v" sid="ROM 11:14" />के मे कानी बी रीती सी कुटुम्‌ब वाळा मे रीह पयदा कर सकु के तीनी लारे मे तीमनी माय्‌न थोड़ाक ने छुटकारो जड़ सके। <verse eid="ROM 11:14" /><verse number="15" style="v" sid="ROM 11:15" />काहाके तीमनु सोड़ देणु कळी नु मेळ नु कारण बण्‌यु, ता ह़ु तीमनु आवरी लेणु, ह़ु मरला ने जीवाड़नु नी हय ह़ु?<verse eid="ROM 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 11:16" />कदीम भेट नो पेल्‌नो वाटो चोखलो से, ता तीहयो आखो वाटो चोखलो नी हय ह़ु? कदी झाड़ ना मुळ्‌या चोखला से, ता तीना डाळ्‌या बी चोखला से। <verse eid="ROM 11:16" /><verse number="17" style="v" sid="ROM 11:17" />थोड़ाक जेतुन झाड़ ना डाळ्‌या वाडीन तीहया डाळ्‌यान जागे भगवान तने कलम करलो से, अने तने जेतुन झाड़ ना मुळ्‌या मे गेथो रस-कस जड़ र्‌यो। <verse eid="ROM 11:17" /><verse number="18" style="v" sid="ROM 11:18" />ता तु डाळ्‌या पोर मोटाय नी करजे, काहाके तु मुळ्‌या ने नी पण मुळ्‌या तने ह़माळ र्‌या।<verse eid="ROM 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 11:19" />अळतेण तु केही के मारी कलम करवा करीनेत आहया डाळ्‌या ने वाडीन नाखलो से। <verse eid="ROM 11:19" /><verse number="20" style="v" sid="ROM 11:20" />आहयी वात ह़ाची से के हीय्‌या डाळ्‌या भरहो नी कर्‌या एतरे तीमने वाडीन नाख देदा, पण तु भरहो करे एतरे टेक र्‌यो। एतरे तु मोटाय नी करजे पण बीहतो रेजे। <verse eid="ROM 11:20" /><verse number="21" style="v" sid="ROM 11:21" />काहाके भगवान खास डाळ्‌या ने नी रेवा देदो, ता तने बी नी रेवा देय। <verse eid="ROM 11:21" /><verse number="22" style="v" sid="ROM 11:22" />एतरे भगवान नी गीण पोर अने वात पोर अने भगवान वडे तीहयी वात पोर धीयान राख! जे भरहो सोड़ीन पासा हय ज्‌या, तीमने तीहयो वडे, पण तारी पोर गीण करे, तु तीनी दया मे रेजे, नीता तीहयो तने बी झाड़ पोर गेथो वाड नाखहे। <verse eid="ROM 11:22" /><verse number="23" style="v" sid="ROM 11:23" />कदीम तीहया पासा भरहो करहे, ता तीहयो तीमने बी कलम कर देहे; काहाके भगवान ताखत वाळो से के तीमने अळी पासो कलम लगाड़ सके। <verse eid="ROM 11:23" /><verse number="24" style="v" sid="ROM 11:24" />जत्‌यार तु जंगली जेतुन झाड़ मे गेथो खास जेतुन झाड़ मे कलम लगाड़लो से, ता जे खास जेतुन नी डाळ्‌या से तीमने खास जेतुन मे लगाड़वा ह़ु हय जाय।<verse eid="ROM 11:24" /></para>
  <para style="s">भगवान आखा ईस्‌रायली पोर दया करे</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 11:25" />ए भायु, अने बेन्‌या कंखर माय्‌न आसम नी हय जाय के तमु आह़फा ने अक्‌कल वाळा ह़मजी लेवो; एतरे मारी हेर आहयी नी हय के तमु आहयी वात सी अंजाण्‌या रेवो के जत्‌यार लगण आड़जात्‌या माणहु जीमनु ह़रग राज मे आवणु टकायलु से, तीहया पुरान-पुरा नी आवे, तां लग ईस्‌रायली माणहु ना थोड़ाक माणहु भगवान वगे मन फीरव्‌या वगर रेहे। <verse eid="ROM 11:25" /><verse number="26" style="v" sid="ROM 11:26" />अने आसम करीन आखा ईस्‌रायली माणहु छुटकारो हात करहे; जीसम खरला सास्‌तर मे लीखलु से के</para>
  <para style="q1" vid="ROM 11:26">“सोड़ाव्‌वा वाळो सीयोन मे गेथो आवहे,</para>
  <para style="q2" vid="ROM 11:26">अने याकुब ना घोराणा मे गेथी आखी कुहराय सेटी कर देहे<note caller="+" style="x"><char style="xo" closed="false">11:26 </char><char style="xt" closed="false"><ref loc="ISA 59:20-21">यसाया 59:20-21</ref></char></note>;<verse eid="ROM 11:26" /></para>
  <para style="q1">
    <verse number="27" style="v" sid="ROM 11:27" />अने तीमनी ह़ाते मारो आहयो वायदो ता रेहे,</para>
  <para style="q2" vid="ROM 11:27">के मे तत्‌यार तीमनो पाप माफ कर देही।”<verse eid="ROM 11:27" /></para>
  <para style="m">
    <verse number="28" style="v" sid="ROM 11:28" />काहाके तीहया खुस-खबर नी नींगा मे ते तमारी जुगु भगवान ना वेरी से, पण टाळवा नी नींगा मे तीहया आड़ा-बुड़ा ना कारण सी भगवान ना लाडला से। <verse eid="ROM 11:28" /><verse number="29" style="v" sid="ROM 11:29" />काहाके भगवान तीने बोलाय्‌न अने आह़फा नो वाटो आपीन, आह़फा ना मन ने कदी नी बदले। <verse eid="ROM 11:29" /><verse number="30" style="v" sid="ROM 11:30" />जीसम तमु पेले भगवान नी वात नी मान्‌या, पण हमणे तीहया भगवान नो हुकम नी मान्‌या करीन भगवान तमारी पोर दया करलो से। <verse eid="ROM 11:30" /><verse number="31" style="v" sid="ROM 11:31" />तीहया हमणे बी भगवान ना हुकम नी मान्‌या, के तमारी पोर दया हय री, आनीन करते के तमारीन तेवी तीमनी पोर बी दया हय जाय। <verse eid="ROM 11:31" /><verse number="32" style="v" sid="ROM 11:32" />भगवान आखा ने आनीन करते हुकम नी मानवा नु मन बणाय देदो के तीहयो तीमनी पोर दया कर सके।<verse eid="ROM 11:32" /></para>
  <para style="s">भगवान जुगाळो से</para>
  <para style="p">
    <verse number="33" style="v" sid="ROM 11:33" />भगवान नु धन, अने अक्‌कल अने ग्‌यान! तीना वीच्‌यार केतरा उंडा, तीना नेम ने कोय उजन्‌तु कर सके अने तीनी वाट ने कोय ह़मज सके।<verse eid="ROM 11:33" /></para>
  <para style="q1">
    <verse number="34" style="v" sid="ROM 11:34" />जेम सास्‌तर मे लीखलु से, “मालीक नी अक्‌कल कोय जाण सके?</para>
  <para style="q2" vid="ROM 11:34">अने तीनो ह़ला आपण्‌यो कोय बण्‌यु?”<verse eid="ROM 11:34" /></para>
  <para style="q1">
    <verse number="35" style="v" sid="ROM 11:35" />कोय बी भगवान ने कंय आपला से ह़ु</para>
  <para style="q2" vid="ROM 11:35">के भगवान तीमने पासु तीहयु आपे।<verse eid="ROM 11:35" /></para>
  <para style="m">
    <verse number="36" style="v" sid="ROM 11:36" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:36 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 8:6">1 कुरन्‌थी 8:6</ref>
      </char>
    </note>काहाके भगवान आखा ने बणावलो से। तीनी मे आखा टेकला रेय, अने तीहयो तीमनी जुगु से। तीनीत जलम बड़ाय हयती रेय। आमीन।<verse eid="ROM 11:36" /></para>
  <chapter eid="ROM 11" />
  <chapter number="12" style="c" sid="ROM 12" />
  <para style="s">भगवान नी सेवा नी जीवाय</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 12:1" />आनीन करते ए भायु अने बेन्‌या, मे तमने भगवान नी दया फोम कराय्‌न वीन्‌ती करु के आपणा डील ने जीवत्‌लु, अने चोखलु, अने भगवान ने गमे तेम भेट चड़ावो। आहयीत तमारी खरली भक्‌ती से। <verse eid="ROM 12:1" /><verse number="2" style="v" sid="ROM 12:2" />आहयी कळीन तेवा ना बणो; पण तमारु मन ने नवलु हय जवा सी तमारो चाल-चलण बी बदलतो जाय, जीनी सी तमु भगवान नी भली, अने गमती, अने वारली मरजी मालम पड़ती जाय।<verse eid="ROM 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 12:3" />काहाके मे तीहयी दया ना कारण जे मने जड़ली से, तमारी मे ना आखा ने केम, के जीसम ह़मजवा जोवे तीनी सी बड़ीन खुद ने नी ह़मजवा जोवे; पण जीसम भगवान आखा ने भरहा ना काम ना अनसारे वाट देदलो से; तीसमेत खुद ने वारला मन सी ह़मजे। <verse eid="ROM 12:3" /><verse number="4" style="v" sid="ROM 12:4" /><note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="1CO 12:12">1 कुरन्‌थी 12:12</ref></char></note>काहाके जीसम आपणा एक डील मे घणा ढेरका अंग से, अने आखा अंग नु एकीत काम नी हय। <verse eid="ROM 12:4" /><verse number="5" style="v" sid="ROM 12:5" />तीसमेत आपणु घणा ढेरका से, मसी मे एक डील हय्‌न आपणु एक-बीजा नो अंग से।<verse eid="ROM 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 12:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:6 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 12:4-11">1 कुरन्‌थी 12:4-11</ref>
      </char>
    </note>जत्‌यार तीहयी दया ना हीसाब सी जे आमने आपली से, आपणु ने अलग-अलग वाटा जड़ला से, ता जीने भगवान वगे गेथो खबर आपवा नो वाटो जड़लो हय, तीहयो भरहा ना काम ना लारे अगी हयवा वाळी वात करवा जोवे; <verse eid="ROM 12:6" /><verse number="7" style="v" sid="ROM 12:7" />कदी सेवा करवा नो दान जड़लो हय ता सेवा करो, कदी ह़ीकाड़वा वाळो हय ता ह़ीकाड़्‌या कर; <verse eid="ROM 12:7" /><verse number="8" style="v" sid="ROM 12:8" />जे परच्‌यार करन्‌यो हय ता परच्‌यार कर्‌या करे; जे दान आपण्‌यो हय ता दान खुसी सी आपे; जे अगवाय करन्‌यो हय ता होह सी अगवाय कर अने जे दया करे ता होह सी कर।<verse eid="ROM 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ROM 12:9" />मोंग दगा वगर रेवा जोवे; बुराय सी ह़ीगी करो; अने भलाय कर्‌या करो। <verse eid="ROM 12:9" /><verse number="10" style="v" sid="ROM 12:10" />भाय नी तेम मोंग सी एक-बीजा ने फोम राखो; अने सदा ईज्‌जत करवा मे एक-बीजा सी बड़ता जावो। <verse eid="ROM 12:10" /><verse number="11" style="v" sid="ROM 12:11" />कोसीत करवा मे आळह्‌या ना हयो; आत्‌मीक होह सी भरला रेवो; मालीक नी सेवा करता रेवो। <verse eid="ROM 12:11" /><verse number="12" style="v" sid="ROM 12:12" />आह मे खुस रेवो; दुख मे धीरज राखो; अने वीन्‌ती करतात रेवो। <verse eid="ROM 12:12" /><verse number="13" style="v" sid="ROM 12:13" />चोखला माणहु ने जे कंय जरवत हय, ता तीमनी मदत करो; अने पोरणा कर्‌या करो।<verse eid="ROM 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 12:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:44">मत्‌ती 5:44</ref>; <ref loc="LUK 6:28">लुका 6:28</ref></char>
    </note>आपणु ने दुख देवा वाळा ने बरकत आपो; सराप ना आपो। <verse eid="ROM 12:14" /><verse number="15" style="v" sid="ROM 12:15" />खुसी मनाव्‌वा वाळा ह़ाते खुसी मनावो अने रड़वा वाळा ह़ाते रड़ो। <verse eid="ROM 12:15" /><verse number="16" style="v" sid="ROM 12:16" />आखा एकीत मन राखो; मोटाय ना करो; पण गरीब ह़ाते ह़ात-ह़ंगात राखो; आपणी नींगा मे अक्‌कल वाळो ना ह़मजो।<verse eid="ROM 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 12:17" />बुराय ना बदले कोय सी बुराय ना करो; जे वात आखा माणहु अगळ वारली हय तीनी चीन्‌ता करो। <verse eid="ROM 12:17" /><verse number="18" style="v" sid="ROM 12:18" />जां तक हय सके, तमु आखा माणहु ह़ाते सांती सी रेवो। <verse eid="ROM 12:18" /><verse number="19" style="v" sid="ROM 12:19" />ए मोंगाळ्‌ळा, बदलो नी लेजो, पण भगवान नी रीह ने मोखो आपो, काहाके लीखलु से, “बदलो लेवा नु मारु काम से, मालीक केय मेत बदलो लेही।” <verse eid="ROM 12:19" /><verse number="20" style="v" sid="ROM 12:20" />पण कदी तारो वेरी भुकलो हय ता खाणु खवाड़, कदी तरहेलो हय ता पाणी पीवाड़; काहाके कदीम तु आसम करही ता तीहयो लाजे पड़हे। <verse eid="ROM 12:20" /><verse number="21" style="v" sid="ROM 12:21" />बुराय सी ना हारो, पण बुराय ने भलाय सी जीक लेवो।<verse eid="ROM 12:21" /></para>
  <chapter eid="ROM 12" />
  <chapter number="13" style="c" sid="ROM 13" />
  <para style="s">अदीकार्‌या ना हुकम मानो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 13:1" />हरेक माणेह अदीकार्‌या ना हक मे रेवा जोवे, काहाके कानो बी हक आसम नी हय के तीने भगवान नी बणायो; अने जे बी हक से, तीमने भगवान ठेरावलो से। <verse eid="ROM 13:1" /><verse number="2" style="v" sid="ROM 13:2" />आनीन करते जे कोय हक नो वीरोद करे तीहयो भगवान नी रीती नो वीरोद करे, अने वीरोद करन्‌या ने डंड जड़हे। <verse eid="ROM 13:2" /><verse number="3" style="v" sid="ROM 13:3" />काहाके राजा वारला काम ना करते नी, पण बुरा काम ना लेदे बीक नो कारण से, कदी तु अदीकारी सी बीहवा नी चाहतो हय, ता वारला काम कर, अने तीनी भणी गेथी तारी बड़ाय हयहे। <verse eid="ROM 13:3" /><verse number="4" style="v" sid="ROM 13:4" />काहाके तीहया तारी भलाय ना लेदे भगवान नो चाकर्‌यो से। पण कदी तु बुराय करे ता बीह, काहाके तीहया तलवार फालतु नी ली र्‌या; अने भगवान ना चाकर्‌या से के तीनी रीह ना अनसारे बुरु काम करवा वाळा ने डंड आपे। <verse eid="ROM 13:4" /><verse number="5" style="v" sid="ROM 13:5" />आहयात कारण सी तमने अने आमु ने अदीकार्‌या ना हुकम मानवा जोवे। भगवान ना डंड ना कारण सी नी पण अमारा मन ना कारण सी।<verse eid="ROM 13:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ROM 13:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:6 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 22:21">मत्‌ती 22:21</ref>; <ref loc="MRK 12:17">मरकुस 12:17</ref>; <ref loc="LUK 20:25">लुका 20:25</ref></char>
    </note>आनी लेदे फाळो बी आपो काहाके राज करवा वाळा भगवान ना चाकर्‌या से, अने सदा आहयात काम मे लागला रेय। <verse eid="ROM 13:6" /><verse number="7" style="v" sid="ROM 13:7" />आनी लेदे हरेक जणा नो हक आप दीया करो; जीने फाळो जोवे तीने फाळो आपो; जीने पय्‌हा जोवे तीने पय्‌हा आपो; जीनी ईज्‌जत करवा जोवे तीनी ईज्‌जत करो।<verse eid="ROM 13:7" /></para>
  <para style="s">एक-बीजा ना लेदे मोंग</para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 13:8" />एक-बीजा सी मोंग ने सोड़ीन कानी बीजी वात मे करजाळ्‌ळा ना हयो; काहाके जे बीजा मोंग करे तीनी सी नेम नो पाळण करलो से। <verse eid="ROM 13:8" /><verse number="9" style="v" sid="ROM 13:9" />आहयु के “छीनाळु नी करजे, हत्‌या नी करजे, चोरी नी करजे, लालच नी करजे” अने आमने सोड़ीन अळी कानो बी हुकम हय ता आखा हुकम नु मतलब आञे देखाड़े, के “आपणा ह़ाते वाळा सी आपणीन तेम मोंग कर।” <verse eid="ROM 13:9" /><verse number="10" style="v" sid="ROM 13:10" />मोंग ह़ाते वाळा नी बुराय नी करे, मोंग करवा आहयु नेम ने पाळण करनु से।<verse eid="ROM 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="ROM 13:11" />टेम ने ओळखीन आसमेत करो, आनीन लेदे के हाव तमने नींदर मे गेथा जाग उठवा नी घड़ी आय जेली से; काहाके जे टेमे आमु भरहो करला हता, तीहयी टेमे ना वीच्‌यार सी हाव अमारो छुटकारो ह़ाते से। <verse eid="ROM 13:11" /><verse number="12" style="v" sid="ROM 13:12" />रात घणी हय जेली से, अने दाहड़ु उगवा मे से; आनी लेदे आमु अंदारला ना कामु ने सोड़ीन वीजाळा ना हत्‌यार बांद लीया। <verse eid="ROM 13:12" /><verse number="13" style="v" sid="ROM 13:13" />जीसम दीहु ह़ोबा देय, तेमेत आपणु ने ह़ुदी चाल चालवा जोवे, नी बेमान्‌या अने दारकुट्‌या, नी छीनाळ्‌या अने नी लुच्‌चा, अने नी झगड़्‌या अने नी खीजर्‌या। <verse eid="ROM 13:13" /><verse number="14" style="v" sid="ROM 13:14" />पण मालीक ईसु मसी ने पेर लेवो, अने डील नी लालच ने पुरी करवा नो जुगाड़ ना करो।<verse eid="ROM 13:14" /></para>
  <chapter eid="ROM 13" />
  <chapter number="14" style="c" sid="ROM 14" />
  <para style="s">एक-बीजा पोर गुनो ना लगाड़ो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 14:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:1 </char>
      <char style="xt" closed="false">
        <ref loc="COL 2:16">कुलुस्‌यो 2:16</ref>
      </char>
    </note>जे भरहा मे कमजोर से, तीने आपणी ह़ंगात मे ली लेवो, पण सण्‌का पोर जखड़ी पड़वा करीन नी। <verse eid="ROM 14:1" /><verse number="2" style="v" sid="ROM 14:2" />एक ने भरहो से के आखु खावा वारलुत से, पण जे भरहा मे कमजोर से तीहयो ते भाजी-पालो एतरोत खाय। <verse eid="ROM 14:2" /><verse number="3" style="v" sid="ROM 14:3" />अने खावा वाळो, नी खावा वाळा ने कमजोर ना ह़मजे, अने नी खावा वाळो, खावा पोर गुनो ना लगाड़े काहाके भगवान तीने आवरी लेदलो से। <verse eid="ROM 14:3" /><verse number="4" style="v" sid="ROM 14:4" />तु कोय से बीजा ना चाकर्‌या पोर गुनो लगाड़े? तीनु टेकीन रेवा नीता पड़ जवा नु ते तीना मालीक नी जपापदारी से, तीने टेकलोत राखहे; काहाके मालीक तीने टेकीन राख सके।<verse eid="ROM 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="ROM 14:5" />कोय माणेह ते एक दाड़ा ने बीजा दाड़ा सी बड़ीन माने, अने कोय आखा दाड़ा ने एक ह़रका माने, आखा आपणा मन मे ठान लेय। <verse eid="ROM 14:5" /><verse number="6" style="v" sid="ROM 14:6" />जे कोय काना दाड़ा ने माने, तीहयो मालीक ना लेदे माने। अने जे कोय खाय, तीहयो मालीक ना लेदे खाय, काहाके तीहयो मालीक ने वारु से के केय, अने जे नी खाय, तीहयो मालीक ना लेदे नी खाय, अने भगवान ने वारु से के केय। <verse eid="ROM 14:6" /><verse number="7" style="v" sid="ROM 14:7" />काहाके आपणी मे गेथा नी कोय आपणी लेदे जीवे अने नी कोय आपणी लेदे मरे। <verse eid="ROM 14:7" /><verse number="8" style="v" sid="ROM 14:8" />आमु जीवत्‌ला से ता मालीक ना लेदे जीवत्‌ला से, अने कदी आमु मरीया ता मालीक ना लेदे मरया; आमु जीवया के मरया मालीक ना लेदे से। <verse eid="ROM 14:8" /><verse number="9" style="v" sid="ROM 14:9" />काहाके मसी आनी लेदे मरलो अने जीवतो बी हय जेलो के तीहयो मरला नो अने जीवत्‌ला बेम नो मालीक हये।<verse eid="ROM 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ROM 14:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:10 </char>
      <char style="xt" closed="false">
        <ref loc="2CO 5:10">2 कुरन्‌थी 5:10</ref>
      </char>
    </note>तु आपणा भाय पोर काहा गुनो लगाड़त्‌लो? नीता तु काहा आपणा भाय ने कमजोर ह़मजत्‌लो? आपणु आखान-आखा भगवान ना नीयाव ना जागा अगळ उबा हयहु। <verse eid="ROM 14:10" /><verse number="11" style="v" sid="ROM 14:11" />काहाके सास्‌तर मे लीखलु से,</para>
  <para style="q1" vid="ROM 14:11">“मालीक केय, मारी जीवाय नी ह़ाम,</para>
  <para style="q2" vid="ROM 14:11">आखा माणहु मार अगळ मांडा टेकहे,</para>
  <para style="q2" vid="ROM 14:11">अने एक-एक भगवान ने हुकार लेहे।”<verse eid="ROM 14:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 14:12" />एतरे आपणी मे ना आखान-आखा ने भगवान अगळ लेखो आपवा पड़हे।<verse eid="ROM 14:12" /></para>
  <para style="s">बीजा ने कमजोर ना बणावो</para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 14:13" />एतरे हाव गेथा अगा कोय पोर गुनो ना लगाड़ो, पण तमु आहयुत ठाण लेवो के आपणा भाय अगळ ठोकर खाय्‌न पाप मे पड़वा नो कारण ना बणो। <verse eid="ROM 14:13" /><verse number="14" style="v" sid="ROM 14:14" />मालीक ईसु मसी मे एक हयवा ना नाते पक्‌कु मालम से के कानी बी चीज वीटळ्‌ळी नी हय, पण जे कोय तीहयी चीज ने वीटळ्‌ळी ह़मजी लेय तीनी जुगु तीहयी चीज वीटळ्‌ळी से। <verse eid="ROM 14:14" /><verse number="15" style="v" sid="ROM 14:15" />कदीम तारा भाय-बेन्‌या तु जे खाय तीनी जुगु दुखी हये, ता तु मोंग सी नी जीव र्‌यो; जीनी लेदे ईसु मसी मर जेलो से, तीमने तु तारा खाणु नी करते ना खत्‌तम करे। <verse eid="ROM 14:15" /><verse number="16" style="v" sid="ROM 14:16" />जीने तमु भलु ह़मजो तीने तमु कोयने गलत नी केवा देवो। <verse eid="ROM 14:16" /><verse number="17" style="v" sid="ROM 14:17" />काहाके भगवान नु राज खाणु-पीणु नी हय; पण धरम, सांती अने खुसी सी रेवा नु से; अने आहयु आखु चोखली आत्‌मा ना लारे जड़े। <verse eid="ROM 14:17" /><verse number="18" style="v" sid="ROM 14:18" />अने जे कोय आहयी रीते मसी नी सेवा करे, तीहयु भगवान ने गमे, अने माणहु मे बी अबरु री जाय।<verse eid="ROM 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="ROM 14:19" />एतरे आपणु ने तीहयी वात नी हेर करवा जोवे, जीनी सी मेळीन रीया तेम अने एक-बीजा ने ह़ुदारया तेम। <verse eid="ROM 14:19" /><verse number="20" style="v" sid="ROM 14:20" />खाणान करते भगवान नु काम ना बगाड़े: आखु कंय चोखु ते से, पण तीहयु ते माणेह जुगु वीटळ्‌ळु से, जे खाणु नी जुगु काना बीजा भाय ने ठोकर लागे। <verse eid="ROM 14:20" /><verse number="21" style="v" sid="ROM 14:21" />भलु ते आहयु से, के तु ना माह खाय, अने ना ह़रु पीय, नी अळी कंय एवु काम करे, जीनी सी तारा भरहो करन्‌या भाय-बेन्‌या ठोकर खाय। <verse eid="ROM 14:21" /><verse number="22" style="v" sid="ROM 14:22" />तारो जे भरहो हय, तीने भगवान ना अगळ आपणात मन मे राख। जुगाळा से जे तीहयी वात मे, जीने तीहयो वारु ह़मजतो हय, खुद ने गुनाळ्‌ळो नी ठेरावे। <verse eid="ROM 14:22" /><verse number="23" style="v" sid="ROM 14:23" />पण जे सण्‌का करीन खातो हय, तीने भगवान गुनाळ्‌ळो ठेरावे, काहाके तीहयो भरहा सी नी खाय, अने जे कंय भरहा सी नी खाय, तीहयु पाप से।<verse eid="ROM 14:23" /></para>
  <chapter eid="ROM 14" />
  <chapter number="15" style="c" sid="ROM 15" />
  <para style="s">बीजा नी बड़ोत्‌री करो</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 15:1" />अने आमने जोवे के कमजोर्‌या नी कमजोरी ने वेठे, नी के खुद खुस करे। <verse eid="ROM 15:1" /><verse number="2" style="v" sid="ROM 15:2" />आपणी मे गेथा हरेक जणा आपणा हाते वाळा नी भलाय ना लेदे खुस करे के तीनी बड़ोत्‌री हवे। <verse eid="ROM 15:2" /><verse number="3" style="v" sid="ROM 15:3" />काहाके मसी आह़फा ने खुस नी कर्‌यो, पण जीसम लीखलु से: “तारा बुराय करन्‌या नी बुराय मारी पोर आय लागी।” <verse eid="ROM 15:3" /><verse number="4" style="v" sid="ROM 15:4" />जेतरी वात पेले गेथी लीखली से, तीहयी आपणीत ह़ीकापण ना लेदे लीखली से के आमु धीरज अने चोखली सास्‌तर ना हीम्‌मत ना लारे आह राखये। <verse eid="ROM 15:4" /><verse number="5" style="v" sid="ROM 15:5" />धीरज अने सांती आपण्‌यो भगवान तमने आहयो वरदान आपे के मसी ईसु ना अनसारे एक-मन्‌या एक-बीजा सी रेय। <verse eid="ROM 15:5" /><verse number="6" style="v" sid="ROM 15:6" />काहाके तमु एक-मन्‌या अने एक रींग मे अमारा मालीक ईसु मसी ना बाह भगवान नी बड़ाय करो।<verse eid="ROM 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ROM 15:7" />आनी लेदे, जीसम मसी भगवान ना बड़ाय ना लेदे तमने आवरी लेदो, तेमेत तमु बी एक-बीजा ने आवरी लेवो। <verse eid="ROM 15:7" /><verse number="8" style="v" sid="ROM 15:8" />आनी लेदे मे केम, के जे वायदा आड़ा-बुड़ा सी करला हता तीमने वातड़ा करवा करीन मसी, भगवान नी सच्‌चाय नी सबुत आपवा करीन खतना करला माणहु नो चाकर्‌यो बण्‌यो। <verse eid="ROM 15:8" /><verse number="9" style="v" sid="ROM 15:9" />अने आड़जात्‌या बी दया ना कारण भगवान नी गुणगान करे; जीसम लीखलु से</para>
  <para style="q1" vid="ROM 15:9">“आनी लेदे मे जाती-जाती मे तने वारु से केम,</para>
  <para style="q2" vid="ROM 15:9">अने तारा नाम ना भजन गावु।”<verse eid="ROM 15:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="ROM 15:10" />अळी केदलो से,</para>
  <para style="q1" vid="ROM 15:10">“ए जाती-जाती ना आखा माणहु, तीना मालीक ना माणहु हाते खुसी मनावो।”<verse eid="ROM 15:10" /></para>
  <para style="m">
    <verse number="11" style="v" sid="ROM 15:11" />अने अळी,</para>
  <para style="q1" vid="ROM 15:11">“ए आड़जात्‌या आखा माणहु, मालीक ना गीत गावो; अने</para>
  <para style="q2" vid="ROM 15:11">ए राज-राज ना आखा माणहु, तीनी बड़ाय करो।”<verse eid="ROM 15:11" /></para>
  <para style="m">
    <verse number="12" style="v" sid="ROM 15:12" />भगवान वगे गेथो केवा वाळो यसायो बी केदलो हतो:</para>
  <para style="q1" vid="ROM 15:12">यीसे नी एक अवल्‌यात उबजहे,</para>
  <para style="q2" vid="ROM 15:12">अने तीहयो आड़जात्‌या पोर अदीकार करहे,</para>
  <para style="q2" vid="ROM 15:12">तीहया तीनी पोर आह लगाड़हे।<verse eid="ROM 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ROM 15:13" />भगवान जे आह नो मालीक से, तमने भरहो करवा मे आखी भाती नी खुसी अने सांती सी भरपुर करे, के चोखली आत्‌मा नी सक्‌ती सी तमारी आह वदती जाय।<verse eid="ROM 15:13" /></para>
  <para style="s">हीम्‌मत सी लीखवा नो कारण</para>
  <para style="p">
    <verse number="14" style="v" sid="ROM 15:14" />ए मारा भायु अने बेन्‌या, मे खुद तमारा बारा मे ह़ाचलीन जाणु के तमु बी खुद भलाय सी भरायला अने भगवान ना ग्‌यान सी भरपुर से, अने एक-बीजा ने ह़मजाड़ सको। <verse eid="ROM 15:14" /><verse number="15" style="v" sid="ROM 15:15" />ते बी मे आहयी चीट्‌ठी मे कंखर-कंखर फोम कराव्‌वा नी लेदे तमने घणो मजबुत करीन लीख्‌यो, आहयु तीहयी दया ना कारण हयु, जे भगवान मने आपलु से। <verse eid="ROM 15:15" /><verse number="16" style="v" sid="ROM 15:16" />मे आड़जात्‌या ना लेदे मसी ईसु नो चाकर्‌यो बणीन भगवान नी खुस-खबर नी सेवा पुंजारान तेम करु; जीनी सी आड़जात्‌या ने मानो चड़ाव्‌वा, चोखली आत्‌मा सी चोखला बणीन ली लेवो। <verse eid="ROM 15:16" /><verse number="17" style="v" sid="ROM 15:17" />एतरे मे ईसु मसी मे एक हयवा ना कारण भगवान नी सेवा जुगु बड़ाय करु। <verse eid="ROM 15:17" /><verse number="18" style="v" sid="ROM 15:18" />काहाके मसी मने आड़जात्‌या ने हुकम मानीन आहयी वाट देखाड़वा करीन बोल मे अने काम मे, <verse eid="ROM 15:18" /><verse number="19" style="v" sid="ROM 15:19" />अने सेलाण्‌या देखाड़वा मे, अने सेल-भात्‌या काम करवा मे चोखली आत्‌मा नी सक्‌ती मे काम लावलो से। एतरे मे यरुसलेम गेथो ईल्‌लुरीकुम लग च्‌यारो-मेर तक मसी नी खुस-खबर नु परच्‌यार करलो से। <verse eid="ROM 15:19" /><verse number="20" style="v" sid="ROM 15:20" />पण मारी हेर आहयी से के जां-जां माणहु मसी नु नाम लग नी ह़मळ्‌या तां-तां जाय्‌न ईसु नी खुस-खबर ह़मळावु, काहाके मे काना बीजा ना नीव पोर घोर नी बांदु। <verse eid="ROM 15:20" /><verse number="21" style="v" sid="ROM 15:21" />पण जीसम सास्‌तर मे लीखलु से,</para>
  <para style="q1" vid="ROM 15:21">“जीमने तीना बारा मे नी ह़मळाया, तीहयात देखहे,</para>
  <para style="q2" vid="ROM 15:21">अने जे भगवान नी वात ह़मळ्‌या लग नी, तीहयात ह़मजहे।”<verse eid="ROM 15:21" /></para>
  <para style="s">रोम यात्‌रा नी पोलुस नी योजना</para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 15:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:22 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 1:13">रोमीयो 1:13</ref>
      </char>
    </note>एतरे मे वळ-वळीन तमारीन्‌तां आव्‌वा नी हींड्‌तो हतो। <verse eid="ROM 15:22" /><verse number="23" style="v" sid="ROM 15:23" />पण हाव आहया परगणा मे ईसु नी वात ह़मळावा नी बची, अने ढेरेत साल पेले गेथोत तमारीन्‌तां आव्‌वा नी हेर कर र्‌यो हतो। <verse eid="ROM 15:23" /><verse number="24" style="v" sid="ROM 15:24" />करीन मे जत्‌यार स्‌पेन मे जही ता तमारीन्‌तां हय्‌न जही काहाके मारी आह से, के तीहयी यात्‌रा मे तमारी सी भेट करु, अने जत्‌यार मे तमने भेटु अने मारो जीव खुसी सी भर जाय ता मने थोड़ेक अगा तक पुगाड़ देजो। <verse eid="ROM 15:24" /><verse number="25" style="v" sid="ROM 15:25" /><note caller="+" style="x"><char style="xo" closed="false">15:25 </char><char style="xt" closed="false"><ref loc="1CO 16:1-4">1 कुरन्‌थी 16:1-4</ref></char></note>पण हाव ते मे चोखला माणहु नी सेवा करवा यरुसलेम जवा बाज र्‌यो। <verse eid="ROM 15:25" /><verse number="26" style="v" sid="ROM 15:26" />मकीदुनीया अने अखाया मुलक नी मंडळ्‌या यरुसलेम ना गरीब चोखला माणहु नी मदत ना लेदे खुसी सी अगळ आया। <verse eid="ROM 15:26" /><verse number="27" style="v" sid="ROM 15:27" /><note caller="+" style="x"><char style="xo" closed="false">15:27 </char><char style="xt" closed="false"><ref loc="1CO 9:11">1 कुरन्‌थी 9:11</ref></char></note>ह़ाची मानो, तीहया आहयु खुसी करला से, तीहया यरुसलेम मे रेवा वाळा ना करजाळ्‌ळा से, काहाके आड़जात्‌या तीमनी सी आत्‌मा नी बरकत हात करला से ता आहयु बी से के तीहया वारली चीज ना लारे बी मदत करहे। <verse eid="ROM 15:27" /><verse number="28" style="v" sid="ROM 15:28" />आनीन करते तारा काम ने पुरु कर जत्‌यार मे जाण जही के तीने आहयु रकम जड़ जेलु से, मे स्‌पेन भणी जही तां तने वाट्‌ये भेटही। <verse eid="ROM 15:28" /><verse number="29" style="v" sid="ROM 15:29" />आहयु ते मने मालम से के जत्‌यार मे तारी सी भेटही, मारी ह़ाते ईसु मसी नी बरकत रेहे।<verse eid="ROM 15:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="ROM 15:30" />ओ भायु, अमारा मसी ईसु ना अने चोखली आत्‌मा ना मोंग ना लारे तमारी सी मारी वीन्‌ती से के मारी ह़ाते मेळीन भगवान सी मारी लेदे वीन्‌ती करो। <verse eid="ROM 15:30" /><verse number="31" style="v" sid="ROM 15:31" />के मे युहद्‌या मुलक मे ईसु ने नी मानन्‌या माणहु सी बच जाम, अने यरुसलेम ना चोखला माणहु ना लेदे सेवा माने। <verse eid="ROM 15:31" /><verse number="32" style="v" sid="ROM 15:32" />के मे भगवान नी मरजी नी लारे तमारीन्‌तां खुसी भेळ आवीन तमारी ह़ाते अराम हात करु। <verse eid="ROM 15:32" /><verse number="33" style="v" sid="ROM 15:33" />सांती नो भगवान तमारी आखा ह़ाते रेय। आमीन<verse eid="ROM 15:33" /></para>
  <chapter eid="ROM 15" />
  <chapter number="16" style="c" sid="ROM 16" />
  <para style="s">वारला से के केम</para>
  <para style="p">
    <verse number="1" style="v" sid="ROM 16:1" />मे तमने फीबे ना लेदे जे अमारी बेनेह अने कीरख्‌या नी मंडळी नी सेवा करवा वाळी से, वीन्‌ती करु। <verse eid="ROM 16:1" /><verse number="2" style="v" sid="ROM 16:2" />के तमु सेवा चोखला माणहु ने जोवे, तीने मालीक मे मानो अने कानी बी वात मे तमारी तीने जरवत पड़े, ता तमु मदत करो, काहाके तीहयी घणा जणा नु अने मारी बी भलु करवा वाळी रेली से।<verse eid="ROM 16:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="ROM 16:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:3 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">नेवताळा ना काम 18:2</ref>
      </char>
    </note>पीरीस्‌कीला अने अक्‌वीला ने जे मसी ईसु मे मारी ह़ाती से, वारु से केम। <verse eid="ROM 16:3" /><verse number="4" style="v" sid="ROM 16:4" />तीहयी मारा जीव ना लेदे खुद ना जीव ने खतरा मे नाख देदली; अने मे एतरोत नी पण आड़जात्‌या नी आखी मंडळी बी तीने वारु से केय। <verse eid="ROM 16:4" /><verse number="5" style="v" sid="ROM 16:5" />तीहयी मंडळी ने बी वारला से केम जे तीना घोर से, मारा मोंगाळ्‌ळा ईपेनीतुस ने, जे मसी ना लेदे आसीया नो पेल्‌नो फोळ से, वारलो से केम। <verse eid="ROM 16:5" /><verse number="6" style="v" sid="ROM 16:6" />मरीयम ने जे तमारी लेदे घणी मेहनत करी वारली से केम। <verse eid="ROM 16:6" /><verse number="7" style="v" sid="ROM 16:7" />अंदरुनीकुस अने युनीयास ने जे मारा कुटुम ना से, अने मारी ह़ाते जेल मे बंद हया अने नेवताळा मे नामह़ाद्‌या से, अने मारी गेथा पेले मसी बणला तीमने वारला से के केम।<verse eid="ROM 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ROM 16:8" />अम्‌पलीयातुस ने, जे मालीक मे मारो मोंगाळ्‌ळो से, वारलो से केम। <verse eid="ROM 16:8" /><verse number="9" style="v" sid="ROM 16:9" />उरबानुस ने, जे मसी मे अमारो ह़ाती से, अने मारा मोंगाळ्‌ळा ईस्‌तखुस ने वारलो से केम। <verse eid="ROM 16:9" /><verse number="10" style="v" sid="ROM 16:10" />अपीलेस ने जे मसी मे खरलो नीकळ्‌यो, वारलो से केम। अरीस्‌तुबुलुस ना घोराणा ने वारला से केम। <verse eid="ROM 16:10" /><verse number="11" style="v" sid="ROM 16:11" />मारी ह़गली हेरोद्‌यान ने वारली से के केम। नरकीसुस ना घोराणा ने जे माणहु मालीक मे से, तीमने वारला से के केम।<verse eid="ROM 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ROM 16:12" />तरुफेना अने तरुफोसा ने जे मालीक मे मेहनत करे, तीमने वारला से के केम। मोंगाळ्‌ळा पीरसीस ने जे मालीक मे घण-जबर मेहनत कर्‌यो, वारलो से के केम। <verse eid="ROM 16:12" /><verse number="13" style="v" sid="ROM 16:13" /><note caller="+" style="x"><char style="xo" closed="false">16:13 </char><char style="xt" closed="false"><ref loc="MRK 15:21">मरकुस 15:21</ref></char></note>रुसुफ ने जे मालीक मे टाळलो से, अने तीनी आय्‌ह ने जे मारी बी से, बेम ने वारला से के केम। <verse eid="ROM 16:13" /><verse number="14" style="v" sid="ROM 16:14" />असुंकीरीतुस ने अने फीलगोन ने अने हीरमेस ने, अने पतरुबास ने, अने हीरमास ने, तीमनी ह़ाते रेण्‌या भाय ने मे आवही अने आवजो की र्‌यो। <verse eid="ROM 16:14" /><verse number="15" style="v" sid="ROM 16:15" />फीलुलुगुस ने अने युलीया ने, अने नेरयुस ने अने तीनी बेनेह ने, अने उलम्‌पास ने अने तीनी ह़ाते ना आखा चोखला माणहु ने आवही अने आवजो केम।<verse eid="ROM 16:15" /></para>
  <para style="s">आखरी हुकम</para>
  <para style="p">
    <verse number="16" style="v" sid="ROM 16:16" />तमु आंबा-सांबा चोखलो कुको दीन वारला से के करीन पुछो अने आवही अने आवजो केवो। तमु आखा ने ईसु मसी नी मंडळी वगे गेथा आवही अने आवजो केम।<verse eid="ROM 16:16" /></para>
  <para style="s">आखरी चेतावणी</para>
  <para style="p">
    <verse number="17" style="v" sid="ROM 16:17" />भायु अने बेन्‌या मे तमारी सी वीन्‌ती करु, के तमु तीहया माणहु सी चेतीन रेजो जे बेरजाव पाड़वा अने बीजा ना लेदे पाप ना कारण बणे। आवो वेहवार तीहयी ह़ीकापण सी मेळ नी खाय जे तमने जड़ली से तमु एवा माणहु सी सेटा रेवो। <verse eid="ROM 16:17" /><verse number="18" style="v" sid="ROM 16:18" />काहाके आसवा माणहु आपणा मालीक ईसु मसी नी नी, पण आह़फा ना पेट नी सेवा कर र्‌या; अने वारु-वारु वातु सी ह़ुदला मन ना माणहु ने बहकाड़ देय। <verse eid="ROM 16:18" /><verse number="19" style="v" sid="ROM 16:19" />तमारी हुकम मानवा नी वात आखी दुर पुग जेली से, एतरे मे तमारा बारा मे खुस से, पण मारी आहयी मरजी से के तमु भलाय करवा करीन अगळवाण्‌या बण जावो, अने कुहराय बुरफाय जुगु वण-अकल्‌या बण जावो। <verse eid="ROM 16:19" /><verse number="20" style="v" sid="ROM 16:20" />सांती आपण्‌यो भगवान भुतड़ा ने छोटोत तमारा पोगु तळे कचरी देहे।</para>
  <para style="p" vid="ROM 16:20">अमारा मालीक ईसु मसी नी दया तमने जड़ती रेवा जोवे।<verse eid="ROM 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="ROM 16:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:21 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">नेवताळा ना काम 16:1</ref>
      </char>
    </note>मारी ह़ाते काम करन्‌यो साजल्‌यो माणेह तीमुथीयुस, अने लुकीयुस जे मारा घोरल्‌या मे नो से, अने यासोन अने सोसीपतरस मे तमने आवही ने आवजो की र्‌यो।<verse eid="ROM 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="ROM 16:22" />मारी चीट्‌ठी ने लीखण्‌यो तीरतीयुस, तमने मालीक ईसु मे आवही ने आवजो की र्‌यो।<verse eid="ROM 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="ROM 16:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:23 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">नेवताळा ना काम 19:29</ref>; <ref loc="1CO 1:14">1 कुरन्‌थी 1:14</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="2TI 4:20">2 तीमुथीयुस 4:20</ref>
      </char>
    </note>ग्‌युस नु जे मारी अने मारी मंडळी नी पोरणा-चाकरी करन्‌यो से, तीहयो तमने वारला से के केय, ईरास्‌तुस जे ह़ेर नो हीसाप-कीताप राखण्‌यो से, अने भाय कारतुस बी वारला से के केय। <verse eid="ROM 16:23" /><verse number="24" style="v" sid="ROM 16:24" />अमारा मालीक ईसु मसी नी दया तमने जड़ती रेवा जोवे। आमीन।<verse eid="ROM 16:24" /></para>
  <para style="s">भगवान नी बड़ाय</para>
  <para style="p">
    <verse number="25" style="v" sid="ROM 16:25" />हाव जे तमने मारी खुस-खबर नु मतलब ईसु मसी नी खुस-खबर ना परच्‌यार ना लारे तमने टणका कर सके। भगवान नु ह़तायलु वीजाळु जलम गेथुत ह़तायलु हतु। <verse eid="ROM 16:25" /><verse number="26" style="v" sid="ROM 16:26" />पण हाव उजन्‌तु हय्‌न सदा ना भगवान ना हुकम सी भगवान वगे गेथा वात करन्‌या नी कीतापु ना लारे आखी जाती ने देखाड़ देदलु से, के तीहया भरहा सी हुकम मानवा वाळा बण जाय।<verse eid="ROM 16:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="ROM 16:27" />एकीत अगळवाण्‌या भगवान नी बड़ाय ईसु मसी ना लारे जलमकी हयती रेय। आमीन।<verse eid="ROM 16:27" /></para>
  <chapter eid="ROM 16" />
</usx>