<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JOS" style="id">- Paliya New Testament</book>
  <para style="h">यहोसु</para>
  <para style="toc3">यहोसु</para>
  <para style="toc2">यहोसु</para>
  <para style="toc1">यहोसु</para>
  <para style="mt1">यहोसु नी कीताप</para>
  <para style="imt">जानकारी</para>
  <para style="ip">यहोसु नी कीताप ईस्‌रायल देस नी काहणी ने अगी बड़ावे जां ह़ारीक वेवस्‌थावीवरण खत्‌तम हये। ईस्‌रायली माणहु यरदन नंदी नी उगणली धेड़े गेथा सुरु हये। यहोसु नी कीताप देखाड़े के कीकम तीहया यरदन नंदी ने पार कर्‌या अने मुसा ना हकदार्‌या, यहोसु नी अगवाय मे कनान नी जागा पोर जीक हात कर्‌या। तीहया आसम आनीन करते कर्‌या काहाके भगवान तीमने हुकम आपलो हतो। आहयी रीते, भगवान अब्‌राहम नी अवल्‌यात ने कनान जागा आपवा नो आह़फा नो वायदो पुरो कर र्‌यो हतो <char style="xt"><ref loc="GEN 12:7">उबजणाय कीताप 12:7</ref></char>।</para>
  <para style="ip">आहयु मालम नी हय के यहोसु नी कीताप कोय लीख्‌यु अने कोय भेळी कर्‌यु। कंय वार, लीखण्‌यो आसम बोले के जीसम के तीहयो तीमनी वच मे हतो जे हय र्‌यु हतु। उदारण नी लेदे <char style="xt"><ref loc="JOS 5:1">यहोसु 5:1</ref>,<ref loc="JOS 5:6">6</ref></char>। आहया कारण सी, घणा ढेरका जानकारुम नु माननु से यहोसु कीताप नो जादा सी जादा हीस्‌सो खुद लीखलो से। आहयु पक्‌कु से के यहोसु ने छोड़ीन बीजो अळी थोड़ोक हीस्‌सो लीखलो से, जीसम के यहोसु ना वगे करवा ना बारा मे <char style="xt"><ref loc="JOS 24:29">यहोसु 24:29</ref></char>। बीजा जानकारुम नु माननु से के आहयु आखु हयवान 800 साल नी आड़े-धेड़ेन अळतेण कीताप लीखली हती। यहोसु नी कीताप मे हयु तीहयु कंय माय्‌न 1250 ईसा पेले नी आड़े-धेड़े हयलु हतु, जे मीस्‌र मे रामसेस ना राज करवान 40 साल नी अळतेण नी हहे। रामसेस तीहयो राजा से जीना बारा मे माने के तीहयो मीस्‌र मे गेथा ईस्‌रायलीम ना नीकळवा नी टेमे राज करलो हतो <char style="xt"><ref loc="EXO 1:11">नीरगमन 1:11</ref></char>।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. कीकम ईस्‌रायली माणहु यरदन नंदी पार कर्‌या अने कनान देस मे मोय भराया। <char style="ior"><ref loc="JOS 1:1-5:12">1:1–5:12</ref></char></para>
  <para style="io1">2. अळतेण ईस्‌रायलीम नी लारे कनान ने जीकवा ना बारा मे देखाड़लु से। <char style="ior"><ref loc="JOS 5:13-12:1">5:13–12:1-24</ref></char></para>
  <para style="io1">3. आनीन अळतेण कनान देस ने ईस्‌रायल ना घोराणा मे कीकम वाट्‌या। <char style="ior"><ref loc="JOS 13-21">13–21</ref></char></para>
  <para style="io1">आखरी मे कीकम थोड़ीक जाती यरदन नंदीन उगवणी धेड़ पासी आवती री, यहोसु ने लीजवा अने वगे करवा, अने कीकम भगवान नी ह़ाते ईस्‌रायल नो नवलो वायदो हयो। <char style="ior"><ref loc="JOS 22-24">22–24</ref></char></para>
  <chapter number="1" style="c" sid="JOS 1" />
  <para style="s">भगवान यहोसु ने कनान देस ने जीकवा नो हुकम आपे</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 1:1" />यहोवा भगवान ना चाकर्‌या मुसान मरवान अळतेण यहोवा भगवान तीना चाकर्‌या यहोसु ने जे नुन नो सोरो हतो केदो, <verse eid="JOS 1:1" /><verse number="2" style="v" sid="JOS 1:2" />“मारो चाकर्‌यो मुसो मर जेलो से; एतरे हाव तु उठ, केड़ बांद, अने आहया आखा माणहु ह़ाते यरदन नंदीन पार हय्‌न तीहया देस मे जा जीने मे मतलब ईस्‌रायली माणहु ने आपु। <verse eid="JOS 1:2" /><verse number="3" style="v" sid="JOS 1:3" />तीहया बोल नी अनसारे जे मे मुसा ने केदलो, मतलब जे-जे जागा पोर तमु पोग मेकहु तीहयो आखो मे तमने आप देम।<note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="DEU 11:24-25">वेवस्‌थावीवरन 11:24-25</ref></char></note> <verse eid="JOS 1:3" /><verse number="4" style="v" sid="JOS 1:4" />जंगल अने तीहया लबानोन सी लगाड़ीन मोट्‌ली नंदी फरात तक, अने उगवणी ह़ोड़ मोट्‌ली दर्‌या तक हीत्‌तीम नु आखु देस तमारो वाटो ठेरहे। <verse eid="JOS 1:4" /><verse number="5" style="v" sid="JOS 1:5" />तु जीवत्‌लो रेही तांह तक तारी अगळ कोय बी माणेह तारो सामनो नी कर सके; जेम मे मुसा नी ह़ाते र्‌यो तेमेत तारी ह़ाते बी रेही; अने नी ते मे तने धोको देम, अने नी तने छोड़ु।<note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="EXO 3:12">नीरगमन 3:12</ref>; <ref loc="DEU 7:24">वेवस्‌थावीवरन 7:24</ref>; <ref loc="DEU 31:6">31:6</ref>,<ref loc="DEU 31:8">8</ref>; <ref loc="HEB 13:5">ईब्‌रानीयो 13:5</ref></char></note> <verse eid="JOS 1:5" /><verse number="6" style="v" sid="JOS 1:6" />एतरे हीम्‌मत राखीन टणको हय जा; काहाके जे देस ने आपवा नी ह़ाम मे आहया माणहु ना आड़ा-बुड़ा ह़ाते खादलो हतो तीनो हकदार्‌यो तु आमने करावही।<note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="DEU 31:6">वेवस्‌थावीवरन 31:6</ref>,<ref loc="DEU 31:7">7</ref>,<ref loc="DEU 31:23">23</ref></char></note> <verse eid="JOS 1:6" /><verse number="7" style="v" sid="JOS 1:7" />आतरुत हये के तु हीम्‌मत राखीन अने वारु टणको हय्‌न जे नेम मारो चाकर्‌यो मुसो तने आपलो से तीहया आखा नी अनसारे करवा नी चोकसी करजे; अने तीनी सी नी ते डाखरी ह़ोड़ वळजे अने नी जमणी ह़ोड़, ता जां-जां तु जही तां-तां तारु काम पुरु हयहे। <verse eid="JOS 1:7" /><verse number="8" style="v" sid="JOS 1:8" />नेम नी आहयी कीताप तारा दीमाक मे गेथी कदी नी उतरवा जोवे, आनी मेत रात-दाड़ो धीयान लगाड़ राखजे, आनीन करते के जे कंय तीनी मे लीखलु से तीनी अनसारे करवा नी तु चोकसी करे; काहाके आसमेत करवा सी तारा आखा काम पुरा हयहे, अने तु ताखत वाळो बणही। <verse eid="JOS 1:8" /><verse number="9" style="v" sid="JOS 1:9" />ह़ु मे तने हुकम नी आप्‌यो? हीम्‌मत राखीन टणको हय जा; बीहे ना, अने तारु मन काचु ना करे; काहाके जां-जां तु जही तां-तां तारो भगवान यहोवा तारी ह़ाते रेहे।”<verse eid="JOS 1:9" /></para>
  <para style="s">यहोसु नु माणहु ने हुकम आपणु</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 1:10" />ता यहोसु माणहु ना मुख्‌या ने आहयो हुकम आप्‌यो, <verse eid="JOS 1:10" /><verse number="11" style="v" sid="JOS 1:11" />“पड़ावा मे एथान-एथा जाय्‌न माणहु ने आहयो हुकम आपो, के आह़फा-आह़फाम नी जुगु खाणु तीयार कर राखो; काहाके तीन दाड़ा सी पेले-पेले तमु ने आहयी यरदन नंदीन पार उतरीन तीहया देस ने आह़फाम ना हक मे करवा करीन जवा नु से जीने तमारो भगवान यहोवा तमारा हक मे आपवा वाळो से।”<verse eid="JOS 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 1:12" />अळतेण यहोसु रुबेनीयो, गादीयो, अने मनस्‌से नी आदी जाती ना माणहु ने केदो,<note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="NUM 32:28">गीनती 32:28</ref>,<ref loc="NUM 32:32">32</ref>; <ref loc="DEU 18:20">वेवस्‌थावीवरन 18:20</ref></char></note> <verse eid="JOS 1:12" /><verse number="13" style="v" sid="JOS 1:13" />“जे वात यहोवा नो चाकर्‌यो मुसो तमने केदलो के तमारो भगवान यहोवा तमने अराम आपे, अने आहयुत देस तमने आपहे, तीनी फोम करो। <verse eid="JOS 1:13" /><verse number="14" style="v" sid="JOS 1:14" />तमारा बयरा, बाळ-बच्‌चा, अने जानवरु ते आहया देस मे रेय जे मुसो तमने यरदन नंदी नी आहयीत धेड़े आपलो से, पण तमु जे ताखत वाळा से हत्‌यार बांदीन तमारा भायु नी अगळ-अगळ पार उतरीन चालो, अने तीमनी मदत करो; <verse eid="JOS 1:14" /><verse number="15" style="v" sid="JOS 1:15" />अने जत्‌यार यहोवा तीमने एवो अराम आपहे जेवो तीहयो तमने आप देदलो से, अने तीहया बी तमारा यहोवा भगवान ना आपला देस ना हकदार्‌या हय जहे; ता तमु तमारा हक मे ना देस मे, जे यहोवा नो चाकर्‌यो मुसो यरदन नंदी नी आहयी धेड़े उगवणी ह़ोड़ तमने आपलो से पासा आवीन आना हकदार्‌या बणहु।” <verse eid="JOS 1:15" /><verse number="16" style="v" sid="JOS 1:16" />ता तीहया यहोसु ने जपाप आप्‌या, “जे कंय करवा नो तु आमने हुकम आपलो से तीहयो आमु करहु, अने जां कंय तु आमने मोकलही तां आमु जहु। <verse eid="JOS 1:16" /><verse number="17" style="v" sid="JOS 1:17" />जेम आमु आखी वात मे मुसा नी मान्‌ता हता तेमेत तारी बी मान्‌या करहु; आतरु हयवा जोवे के तारो भगवान यहोवा जेम मुसा नी ह़ाते रेतो हतो तेमेत तारी ह़ाते बी रेय। <verse eid="JOS 1:17" /><verse number="18" style="v" sid="JOS 1:18" />कोय बी काहा नी हय जे तारा वीरोद मे बक-बक करे, अने जेतरा हुकम तु आपे तीमने नी माने, ता तीने मोत नो डंड जड़हे। पण तु टणको अने हीम्‌मत राखीन रे।”<verse eid="JOS 1:18" /></para>
  <chapter eid="JOS 1" />
  <chapter number="2" style="c" sid="JOS 2" />
  <para style="s">यरीहो ह़ेर मे यहोसु होगा ह़ला लेवा वाळा ने मोकलनु</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 2:1" />ता नुन नो सोरो यहोसु बे होगात ह़ला लेवा वाळा ने सीत्‌तीम पड़ावा मे गेथा होगात मोकल्‌यो, अने तीमने केदो, “जाय्‌न तीहया देस यरीहो ने देखो।” तत्‌यारुत तीहया चाल पड़्‌या, अने राहाब नाम नी कानी छीनाळ्‌याण ना घोर मे जाय्‌न ह़ुय ज्‌या।<note caller="+" style="x"><char style="xo" closed="false">2:1 </char><char style="xt" closed="false"><ref loc="HEB 11:31">ईब्‌रानीयो 11:31</ref>; <ref loc="JAS 2:25">याकुब 2:25</ref> </char></note> <verse eid="JOS 2:1" /><verse number="2" style="v" sid="JOS 2:2" />ता कानो यरीहो ना राजा ने केदो, “आज राते थोड़ाक ईस्‌रायली माणहु अमारा देस ना बारा मे ह़ला लेवा करीन आञे आय र्‌या।” <verse eid="JOS 2:2" /><verse number="3" style="v" sid="JOS 2:3" />ता यरीहो नो राजो राहाब ने आसम केवाड़ मोकल्‌यो, “जे अदमी तारीन्‌तां आवला से ईमने बारा ली आव; काहाके तीहया आखा देस ना बारा मे ह़ला लेवा करीन आवला से।” <verse eid="JOS 2:3" /><verse number="4" style="v" sid="JOS 2:4" />तीहयी बयर तीहया बेम अदमी ने ह़ताड़ीन राखी; अने आहयी रीते केदी, “मारीन्‌तां थोड़ाक माणहु आवला ते खरा, पण मे नी जाणती के तीहया कां वाळा हता; <verse eid="JOS 2:4" /><verse number="5" style="v" sid="JOS 2:5" />अने जत्‌यार अंदारु हयु ता ह़ेर नु झापलु देवा बाज ज्‌या, ता तीहया नीकळ ज्‌या; मने नी मालम के तीहया कां ज्‌या; तमु उतवाळ करीन तीमनी पछळ जावो ता तीमने धर लेहु।” <verse eid="JOS 2:5" /><verse number="6" style="v" sid="JOS 2:6" />तीमने तीहयी घोर नी छत पोर चड़ावीन ह़ण्‌या तळे ह़ताड़ देदली जे तीहयी छत पोर ह़जाड़ीन मेक रेली। <verse eid="JOS 2:6" /><verse number="7" style="v" sid="JOS 2:7" />राजा ना माणहु यरदन नंदी नी वाटे-वाटे तीमने ह़ोदवा करीन घाटी तक जत र्‌या; अने जेम तीमने ह़ोदवा वाळा झापले गेथा नीकळ्‌या तेमेत झापलु ने दी देदा।<verse eid="JOS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 2:8" />तीहया ह़ुया नीन पेले तीहयी बयर छत पोर तीमनीन्‌तां जाय्‌न <verse eid="JOS 2:8" /><verse number="9" style="v" sid="JOS 2:9" />तीहया अदमी ने केवा बाज जी, “मने पक्‌कु मालम से के यहोवा भगवान तमने आहयु देस आपलो से, अने आमने आखा ने तमारी बीक से, अने आहया देस ना आखा रेवा वाळा तमारा कारण सी घबराय र्‌या। <verse eid="JOS 2:9" /><verse number="10" style="v" sid="JOS 2:10" />काहाके आमु ह़मळला से के यहोवा भगवान तमने मीस्‌र देस मे गेथा नीकळवा नी टेमे तमारी अगळ रात्‌ली दर्‌या नु पाणी ह़ुकाड़ देदो। अने तमु सीहोन अने ओग नाम ना यरदन नंदीन पार रेवा वाळा एमोरी ना बेम राजा ने खत्‌तम कर नाखला से।<note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="EXO 14:21">नीरगमन 14:21</ref>; <ref loc="NUM 21:21-35">गीनती 21:21-35</ref></char></note> <verse eid="JOS 2:10" /><verse number="11" style="v" sid="JOS 2:11" />अने आहयु ह़मळतेत अमारु मन घबराय आयु, अने तमारा कारण सी कोय मे बी जीव मे जीव नी र्‌यो; काहाके तमारो भगवान यहोवा उप्‌पर नु ह़रग अने हेटी नी धरती नो भगवान से। <verse eid="JOS 2:11" /><verse number="12" style="v" sid="JOS 2:12" />हाव मे जे तमारी पोर दया करली से, एतरे हाव तमु यहोवा नी ह़ाम खावो के तमु बी मारा बाह ना घोराणा पोर दया करहु, अने आनी खरली सेलाणी मने आपो, <verse eid="JOS 2:12" /><verse number="13" style="v" sid="JOS 2:13" />के तमु मारा आय्‌ह-बाहा, भायु अने बेन्‌या ने, अने जे कंय तीमनु से तीहयु आखु ने बी जीवत्‌लु रेवा देवो, अने अमारा आखा नो जीव मरवा सी बचाड़हु।” <verse eid="JOS 2:13" /><verse number="14" style="v" sid="JOS 2:14" />ता तीहया अदमी तीने केदा, “कदीम तु अमारी आहयी वात कोय अगळ उजन्‌ती नी करे, ता तमारा जीव ना बदले अमारो जीव जाय; अने जत्‌यार यहोवा भगवान आमने आहयु देस आपहे, ता आमु तारी ह़ाते दया अने सच्‌चाय सी वेहवार करहु।”<verse eid="JOS 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 2:15" />ता राहाब जीनु घोर ह़ेर नु मोट्‌लु भीतड़ु धेड़े बणलु हतु, अने तीहयी तांत रेती हती, तीहयी तीमने खीड़की मे गेथा दोड़ु ना भरहे उतारीन ह़ेर गेथा बारा कर देदी। <verse eid="JOS 2:15" /><verse number="16" style="v" sid="JOS 2:16" />अने तीहयी तीमने केदी, “बड़ा भणीन जत रेवो, आसम नी हय जाय के ह़ोदवा वाळा तमने देख लेय; एतरे जत्‌यार तक तमने ह़ोदवा वाळा पासा नी आवती रेय तांह तक, मतलब तीन दाड़ा तक तांत ह़ताय रेजो, अळतेण तमारी वाटे चाल पड़जो।” <verse eid="JOS 2:16" /><verse number="17" style="v" sid="JOS 2:17" />तीहया तीने केदा, “जे ह़ाम तु आमने खवाड़ली से तीना बारा मे आमु ते वण-गुनाळ्‌ळा रेहु। <verse eid="JOS 2:17" /><verse number="18" style="v" sid="JOS 2:18" />ह़मळ, जत्‌यार आमु आहया देस मे आवहु, ता जे खीड़की मे गेथा तु आमने उतारली से तीनी मे आहयीत रात्‌ला रंग नी ह़ुतळी नी दोरी बांद लेजे; अने तारा आय्‌ह-बाहा, भायु; अने तारा बाह ना आखा घोरल्‌या ने आहयात घोर मे तारीन्‌तां एक्‌ठा कर राखजे। <verse eid="JOS 2:18" /><verse number="19" style="v" sid="JOS 2:19" />ता जे कोय तारा घोर ना झापले गेथु बारु नीकळे, तीना खुन नो गुनेगार तीहयोत ठेरहे, अने आमु वण-गुनाळ्‌ळा ठेरहु: पण कदीम तारी ह़ाते घोर मे रीन बी काना माणेह नी मोत हये, ता तीना खुन नो गुनो अमारा माथे पड़हे। <verse eid="JOS 2:19" /><verse number="20" style="v" sid="JOS 2:20" />अने कदीम तु अमारी आहयी वात काना अगळ उजन्‌ती करे, ता जे ह़ाम तु आमु ने खवाड़ली से तीनी गेथा आमु छुट जहु।” <verse eid="JOS 2:20" /><verse number="21" style="v" sid="JOS 2:21" />तीहयी केदी, “तमारा बोलु नी अनसारे हये।” ता तीहयी तीमने वळाय देदी, अने तीहया जत र्‌या; अने तीहयी राल्‌ता रंग नी दोरी ने खीड़की मे बांद देदी।<verse eid="JOS 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 2:22" />तीहया जाय्‌न बड़ा पोर पुग्‌या, अने ह़ोदवा वाळा ने पासा आवते तक, मतलब तीन दाड़ा तक र्‌या; अने ह़ोदवा वाळा तीमने आखी वाटे ह़ोदता र्‌या अने तीमने कंखर नी जड़्‌या। <verse eid="JOS 2:22" /><verse number="23" style="v" sid="JOS 2:23" />ता तीहया बेम अदमी बड़ा पोर गेथा उतर्‌या, अने नंदीन पार जाय्‌न नुन ना सोरा यहोसुन्‌तां पुगीन जे कंय तीमनी पोर वीतली तीहयु आखु देखाड़ देदा। <verse eid="JOS 2:23" /><verse number="24" style="v" sid="JOS 2:24" />अने तीहया यहोसु ने केदा, “कंय बी सण्‌का कर्‌या वगर यहोवा तीहयु आखु देस अमारा हात मे कर देदलो से; अने आने सोड़ीन तीहया देस ना आखा रेवा वाळा अमारा कारण सी घबराय र्‌या।”<verse eid="JOS 2:24" /></para>
  <chapter eid="JOS 2" />
  <chapter number="3" style="c" sid="JOS 3" />
  <para style="s">ईस्‌रायली माणहु नु यरदन नंदी पार करनु</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 3:1" />यहोसु ह़वारे उठ्‌यो, अने आखा ईस्‌रायलीम ने ह़ाते लीन सीत्‌तीम मे गेथो नीकळीन यरदन नंदी ना काठे आयो; अने तीहया पार हयवा सी पेले तांत पड़ावो नाख देदा। <verse eid="JOS 3:1" /><verse number="2" style="v" sid="JOS 3:2" />अने तीन दाड़ा बाद मुख्‌या पड़ावा मे जाय्‌न <verse eid="JOS 3:2" /><verse number="3" style="v" sid="JOS 3:3" />माणहु ने आहयो हुकम आप्‌यो, “जत्‌यार तमु ने आपणा भगवान यहोवा ना वायदा नु मोट्‌लु पेटारु<note caller="+" style="f"><char style="fr" closed="false">3:3 </char><char style="fq" closed="false">वायदा नु मोट्‌लु पेटारु </char><char style="ft" closed="false">जीनी मे दह हुकम ना पट्‌या ने मेकता हता</char></note> अने तीने उचलवा वाळा लेवी पुंजारा बी देखाव पड़े, ता आह़फाम ना जागे गेथा नीकळीन तीमनी पसळ-पसळ चालजो, <verse eid="JOS 3:3" /><verse number="4" style="v" sid="JOS 3:4" />पण तीमनी अने तमारी वचमे बे हजार हात नी आड़े-धेड़े फासलो रेवा जोवे; तमु पेटारु नी ह़ाते नी जजो। के तमु देख सको के तमने कानी वाटे माय्‌न जवा नु से, काहाके तमु हजु तक आहयी वाटे माय्‌न नी चाल्‌या।” <verse eid="JOS 3:4" /><verse number="5" style="v" sid="JOS 3:5" />अळतेण यहोसु माणहु ने केदो, “तमु आह़फा-आह़फाम ने चोखा करो; काहाके वाहणे ना दाड़े यहोवा तमारी वचमे वहराड़न्‌या काम करहे।” <verse eid="JOS 3:5" /><verse number="6" style="v" sid="JOS 3:6" />ता यहोसु पुंजारा ने केदो, “वायदा नु पेटारु उचलीन माणहु नी अगळ-अगळ चालो।” ता तीहया वायदा नु पेटारु उचलीन अगळ-अगळ चाल्‌या।<verse eid="JOS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 3:7" />ता यहोवा यहोसु ने केदो, “आज ना दाड़े गेथो मे आखा ईस्‌रायली माणहु अगळ तारी बड़ाय करवा सुरु कर देही, जीनी सी तीहया जाण लेय के जेम मे मुसा ह़ाते रेतो हतो तेमेत तारी ह़ाते बी से। <verse eid="JOS 3:7" /><verse number="8" style="v" sid="JOS 3:8" />अने तु वायदा नु पेटारु ने उचलवा वाळा पुंजारा ने आहयो हुकम आप, ‘जत्‌यार तमु यरदन नंदी ना पाणी नी धेड़े पुगो, ता यरदन नंदी मे उबा रेजो।’”<verse eid="JOS 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 3:9" />ता यहोसु ईस्‌रायली माणहु ने केदो, “ह़ाते आवीन आपणा यहोवा भगवान ना बोलु ने ह़मळो।” <verse eid="JOS 3:9" /><verse number="10" style="v" sid="JOS 3:10" />अने यहोसु केवा बाज ज्‌यो, “आनी सी तमु जाण लेहु के जीवत्‌लो भगवान तमारी वचमे से, अने तीहयो तमारी अगळ गेथा सण्‌का कर्‌या वगर कनानी, हीत्‌ती, हीब्‌बी, परीज्‌जी, गीर्‌गासी, एमोरी, अने यबुसीम ने तीमना देस मे गेथा नीकाळ देहे। <verse eid="JOS 3:10" /><verse number="11" style="v" sid="JOS 3:11" />ह़मळो, आखी धरती ना मालीक ना वायदा नु पेटारु तमारी अगळ-अगळ यरदन नंदी ने पार करवा वाळु से। <verse eid="JOS 3:11" /><verse number="12" style="v" sid="JOS 3:12" />करीन हाव ईस्‌रायल नी जाती मे गेथा बारे अदमी ने टाळ लेवो, तीहया एक-एक जाती मे गेथा एक अदमी रेय। <verse eid="JOS 3:12" /><verse number="13" style="v" sid="JOS 3:13" />अने जे टेमे आखी धरती नो मालीक यहोवा ना वायदा नु पेटारु उचलवा वाळा पुंजारा ना पोगु यरदन नंदी ना पाणी मे मेकहे, तीहयी टेमे यरदन नंदी नु उपर गेथु वयत्‌लु पाणी उबु री जहे, अने ढेर हय्‌न उबु हय रेहे।”<verse eid="JOS 3:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 3:14" />एतरे जत्‌यार माणहु आह़फाम ना पड़ावा मे गेथा यरदन नंदीन पार जवा करीन नीकळ्‌या, अने पुंजारा वायदा नु पेटारु उचलीन माणहु नी अगळ-अगळ चाल्‌या, <verse eid="JOS 3:14" /><verse number="15" style="v" sid="JOS 3:15" />अने पेटारु ने उचलवा वाळा यरदन नंदीन्‌तां पुग्‌या, अने पेटारु ने उचलवा वाळा पुंजारा ना पोगु यरदन ना पाणी मे डुब ज्‌या यरदन नंदी नु पाणी ते वाडणी नी टेम तक ना आखा दाड़ा मे तीनी धेकड़े गेथु उपर-उपर वया करे, <verse eid="JOS 3:15" /><verse number="16" style="v" sid="JOS 3:16" />ता जे पाणी उपर गेथु वय्‌न आवतु हतु तीहयु घण नाम्‌बे, मतलब आदाम ह़ेर ने तां जे सारतान नी धेड़े से उबु रीन एक ढेर हय ज्‌यु, अने भीतड़ुन तेम उबु हय ज्‌यु, अने जे पाणी अराबा नी दर्‌या जे खारली दर्‌या बी केवाय, तीनी भणीन हय्‌न आवतु हतु, तीहयु पुरी रीते ह़ुक ज्‌यु; अने माणहु यरीहो नी अगळ पार उतर ज्‌या। <verse eid="JOS 3:16" /><verse number="17" style="v" sid="JOS 3:17" />अने पुंजारा यहोवा नु वायदा नु पेटारु उचलीन यरदन नंदीन वचा-वच पुगीन ह़ुकला जागा पोर एक जागे उबा र्‌या, अने आखा ईस्‌रायली माणहु ह़ुकला जागा पोरेत चालीन पार उतरता र्‌या, आखरी मे तीहयी आखी जाती ना माणहु यरदन नंदीन पार हय ज्‌या।<verse eid="JOS 3:17" /></para>
  <chapter eid="JOS 3" />
  <chapter number="4" style="c" sid="JOS 4" />
  <para style="s">फोम राखवा ना बारे दगड़ा</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 4:1" />जत्‌यार तीहयी आखी जाती ना माणहु यरदन नंदी ने पार हय ज्‌या, ता यहोवा भगवान यहोसु ने केदो, <verse eid="JOS 4:1" /><verse number="2" style="v" sid="JOS 4:2" />“माणहु मे गेथा बारे अदमी, मतलब जाती पसळ एक-एक अदमी ने टाळीन आहयो हुकम आप, <verse eid="JOS 4:2" /><verse number="3" style="v" sid="JOS 4:3" />‘तमु यरदन नंदी नी वच मे, जां ह़ारीक पुंजारा पोग मेकला हता तां गेथा बारे दगड़ा उचलीन तमारी ह़ाते पार ली लेवो, अने जां ह़ारीक आज नी राते नो पड़ावो रेहे तांत तीमने मेक देजो।’” <verse eid="JOS 4:3" /><verse number="4" style="v" sid="JOS 4:4" />ता यहोसु तीहया बारे अदमी ने, जीमने तीहयो ईस्‌रायली नी आखा जाती मे गेथा छाटीन ठेराय रेलो हतो, <verse eid="JOS 4:4" /><verse number="5" style="v" sid="JOS 4:5" />बोलावीन केदो, “तमु आपणा भगवान यहोवा नु मोट्‌लु पेटारु अगळ यरदन नंदी नी वचमे जाय्‌न ईस्‌रायली जाती नी गीनती नी अनसारे एक-एक दगड़ो उचलीन आह़फा-आह़फाम ना खांदा पोर मेको, <verse eid="JOS 4:5" /><verse number="6" style="v" sid="JOS 4:6" />जीनी सी आहयी तमारी वचमे सेलाणी ठेरे, अने अगा चालीन तमारा सोरा आहयु पुछे, ‘के आहया दगड़ा नु ह़ु मतलब से?’ <verse eid="JOS 4:6" /><verse number="7" style="v" sid="JOS 4:7" />ता तमु तीमने आहयो जपाप आपजो, के यरदन नंदी नु पाणी यहोवा भगवान ना वायदा नु पेटारु अगळ बे वाटा मे वटाय जेलु, काहाके जत्‌यार भगवान नु पेटारु नंदी पार करवा बाज रेलु, ता यरदन नंदी नु पाणी बे वाटा मे वटाय ज्‌यु। अने तीहया दगड़ा ईस्‌रायली माणहु ने जलमका फोम कराव्‌वा वाळा ठेरहे।”<verse eid="JOS 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 4:8" />यहोसु ना आहया हुकम नी अनसारे ईस्‌रायली माणहु कर्‌या, जेम यहोवा यहोसु ने केदलो हतो तेमेत तीहया ईस्‌रायली जाती नी गीनती नी अनसारे बारे दगड़ा यरदन नंदी नी वच मे गेथा चुट लेदा; अने तीमने आह़फाम नी ह़ाते ली जाय्‌न पड़ावा मे मेक देदा। <verse eid="JOS 4:8" /><verse number="9" style="v" sid="JOS 4:9" />अने यरदन नंदी नी वच मे, जां ह़ारीक पुंजारा भगवान ना वायदा नु पेटारु ने उचलीन पोग मेकला हता ता यहोसु बारे दगड़ा उबा कराड़्‌यो; तीहया आज बी तांत से। <verse eid="JOS 4:9" /><verse number="10" style="v" sid="JOS 4:10" />अने पुंजारा मोट्‌लु पेटारु उचलीन तीहयी टेमे तक यरदन नंदी नी वचमे उबा र्‌या जत्‌यार तक तीहयी आखी वात पुरी नी हय जी, अने यहोवा भगवान यहोसु ने जे हुकम आपलो तीहयोत हुकम मुसा माणहु ने केवा नो हुकम आपलो हतो। ता आखा माणहु उतवाळ्‌या पार हय ज्‌या; <verse eid="JOS 4:10" /><verse number="11" style="v" sid="JOS 4:11" />अने जत्‌यार आखा माणहु पार हय ज्‌या, ता पुंजारा अने यहोवा भगवान नु मोट्‌लु पेटारु बी तीमनी देखणते पार हय ज्‌यु। <verse eid="JOS 4:11" /><verse number="12" style="v" sid="JOS 4:12" />अने रुबेनी, गादी, अने मनस्‌से नी आदी जाती ना माणहु मुसान केवा नी अनसारे ईस्‌रायली माणहु नी अगळ झुमायवा ना हत्‌यार बांदीन पार ज्‌या; <verse eid="JOS 4:12" /><verse number="13" style="v" sid="JOS 4:13" />मतलब चाळीह हजार अदमी झुमायवा ना हत्‌यार लीन झुमायवा करीन यहोवा अगळ पार उतरीन यरीहोन्‌तां ना मयदान मे पुग्‌या। <verse eid="JOS 4:13" /><verse number="14" style="v" sid="JOS 4:14" />तीहया दाड़े यहोवा आखा ईस्‌रायली माणहु अगळ यहोसु नी बड़ाय कर्‌यो; अने जेम तीहया मुसा नी बीक मान्‌ता हता तेमेत तीनी बी बीक तीहयो जीवत्‌लो हतो तांह तक मान्‌ता र्‌या।<verse eid="JOS 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 4:15" />ता यहोवा यहोसु ने केदो, <verse eid="JOS 4:15" /><verse number="16" style="v" sid="JOS 4:16" />“वायदा नु पेटारु उचलवा वाळा पुंजारा ने हुकम आप के यरदन नंदी मे गेथा नीकळ आवे।” <verse eid="JOS 4:16" /><verse number="17" style="v" sid="JOS 4:17" />ता यहोसु पुंजारा ने हुकम आप्‌यो, “यरदन नंदी मे गेथा नीकळ आवो।” <verse eid="JOS 4:17" /><verse number="18" style="v" sid="JOS 4:18" />जेमेत यहोवा भगवान ना वायदा नु पेटारु ने उचलवा वाळा पुंजारा यरदन नंदी नी वचमे गेथा नीकळ आया, अने तीमना पोगु ह़ुकला जागा पोर पड़्‌या, तत्‌यारुत यरदन नंदी नु पाणी तीमना जागा पोर आय पड़्‌यु, अने पेलेन तेम धेकड़ पोर माय्‌न वयवा बाज ज्‌यु।<verse eid="JOS 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 4:19" />पेल्‌ला मयना ना दहवा दाड़े माणहु यरदन नंदी मे गेथा नीकळीन यरीहोन उगणली काकड़ पोर गीलगाल मे पड़ावो नाख्‌या। <verse eid="JOS 4:19" /><verse number="20" style="v" sid="JOS 4:20" />अने जे बारे दगड़ा यरदन नंदी मे गेथा नीकाळला हता, तीमने यहोसु गीलगाल मे उबा कर्‌यो। <verse eid="JOS 4:20" /><verse number="21" style="v" sid="JOS 4:21" />ता तीहयो ईस्‌रायलीम ने केदो, “अगा चालीन तमारा सोरा आह़फा-आह़फाम ना बाहु ने आहयु पुछे, ‘आहया दगड़ा नु ह़ु मतलब से?’ <verse eid="JOS 4:21" /><verse number="22" style="v" sid="JOS 4:22" />ता तमु आहयु कीन तीमने देखाड़जो, ‘आमु ईस्‌रायली माणहु यरदन नंदी ने ह़ुकला जागे चालीन पार करला।’ <verse eid="JOS 4:22" /><verse number="23" style="v" sid="JOS 4:23" />काहाके जेम तमारो भगवान यहोवा रात्‌ली दर्‌या ने आमु ने पार हयते तक अमारी अगळ गेथी ह़ुकाड़ीन सेटी कर रेलो हतो, तेमेत तीहयो यरदन नंदी नु पाणी बी तमने पार हयते तक तमारी अगळ गेथु सेटु करीन ह़ुकाड़ राख्‌यो; <verse eid="JOS 4:23" /><verse number="24" style="v" sid="JOS 4:24" />आनीन करते के कळी ना आखा देसु ना माणहु जाण लेय के यहोवा नो हात ताखत वाळो से; अने तमु जलमका आपणा यहोवा भगवान नी बीक मान्‌ता रेवो।”<verse eid="JOS 4:24" /></para>
  <chapter eid="JOS 4" />
  <chapter number="5" style="c" sid="JOS 5" />
  <para style="p">
    <verse number="1" style="v" sid="JOS 5:1" />जत्‌यार यरदन नंदी नी बुडणली ह़ोड़ रेवा वाळा एमोरी ना आखा राजा, अने दर्‌या धेड़े रेवा वाळा कनानी ना आखा राजा आहयु ह़मळ्‌या, के यहोवा ईस्‌रायली माणहु ने नंदी पार हयते तक तीमनी अगळ गेथु यरदन नंदी नु पाणी सेटु करीन ह़ुकाड़ीन राख्‌यो, ता ईस्‌रायली माणहु ना बीक ना कारण सी तीमनु मन घबराय ज्‌यु, अने तीमना जीव मे जीव नी र्‌यो।<verse eid="JOS 5:1" /></para>
  <para style="s">गीलगाल जागा मे ईस्‌रायली माणहु नु खतनु हयणु</para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 5:2" />तीहयी टेमे यहोवा यहोसु ने केदो, “चमकण्‌या दगड़ा ना चक्‌का बणावीन बीजी काव ईस्‌रायलीम नु खतनु कराय दे।” <verse eid="JOS 5:2" /><verse number="3" style="v" sid="JOS 5:3" />ता यहोसु चमकण्‌या दगड़ा ना चक्‌का बणावीन खतना नाम ना बड़ा पोर ईस्‌रायली माणहु नु खतनु करायो। <verse eid="JOS 5:3" /><verse number="4" style="v" sid="JOS 5:4" />अने यहोसु जे खतनु करायो, तीनो कारण आहयो से, के जेतरा झुमायवा नी लायक अदमी मीस्‌र देस मे गेथा नीकळला तीहया आखा मीस्‌र मे गेथा नीकळला ता जंगल नी वाटे मर जेला हता। <verse eid="JOS 5:4" /><verse number="5" style="v" sid="JOS 5:5" />जे अदमी मीस्‌र देस मे गेथा नीकळला हता तीमना आखा नु खतनु ते हय जेलु हतु, पण जेतरा तीमना मीस्‌र मे गेथा नीकळला अने जंगल नी वाटे पयदा हयला तीमनी मे गेथा कोय नु बी खतनु नी हयलु हतु। <verse eid="JOS 5:5" /><verse number="6" style="v" sid="JOS 5:6" />काहाके ईस्‌रायली माणहु ते चाळीह साल तक जंगल मे फीरता र्‌या, जत्‌यार तक तीहयी जाती ना माणहु, मतलब जेतरा झुमायवा नी लायक माणहु मीस्‌र देस मे गेथा नीकळला हता तीहया खत्‌तम नी हय ज्‌या, काहाके तीहया यहोवा भगवान नी वात नी मान्‌या; एतरे यहोवा भगवान ह़ाम खाय्‌न तीमने केदलो हतो, के जे देस मे तमारा आड़ा-बुड़ा ह़ाते ह़ाम खाय्‌न तमने आपही केदलो, अने तीनी मे दुद अने मोद ना झोरु वये, तीहयु देस मे तमने नी देखाड़ु।<note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="NUM 14:28-35">गीनती 14:28-35</ref></char></note> <verse eid="JOS 5:6" /><verse number="7" style="v" sid="JOS 5:7" />ता तीहया माणहु ना सोरा जीमने यहोवा तीमना जागा पोर पयदा करलो, तीमनु खतनु यहोसु पांह कराया, काहाके वाटे तीमनु खतनु नी हयवा ना कारण सी तीहया खतना वगर ना हता। <verse eid="JOS 5:7" /><verse number="8" style="v" sid="JOS 5:8" />अने जत्‌यार तीहयी आखी जाती ना माणहु नु खतनु हय ज्‌यु, ता तीहया वारु हय जते तक आह़फा-आह़फाम ना पड़ावा मे र्‌या। <verse eid="JOS 5:8" /><verse number="9" style="v" sid="JOS 5:9" />ता यहोवा यहोसु ने केदो, “तमारु नामबद्‌दी जे मीस्‌र देस मे हयली से तीने मे आज सेटी कर देदलो से।” करीन तीहया जागा नु नाम आज ना दाड़े तक गीलगाल<note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">मुल मे, ढबळायो या सेटु कर्‌यो</char></note> पड़लु से।<verse eid="JOS 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 5:10" />एतरे ईस्‌रायली माणहु गीलगाल मे पड़ावो नाखीन र्‌या, अने तीहया यरीहो ना मयदान मे मयना ना चोवदवा दाड़े ह़ांतली टेमे तीवार वाळ्‌या।<note caller="+" style="x"><char style="xo" closed="false">5:10 </char><char style="xt" closed="false"><ref loc="EXO 12:1-13">नीरगमन 12:1-13</ref></char></note> <verse eid="JOS 5:10" /><verse number="11" style="v" sid="JOS 5:11" />अने फसह तीवार ना बीजा दाड़े तीहया ते देस नी मेर मे गेथा खमीर वगर ना रोट्‌ला अने भुंजला दाणा बी खावा बाज ज्‌या। <verse eid="JOS 5:11" /><verse number="12" style="v" sid="JOS 5:12" />अने जे दाड़े तीहया ते देस नी मेर मे गेथु खावा बाज ज्‌या, तीहयात दाड़े ह़वारे गेथा मन्‌ना पड़वा बंद हय ज्‌या; अने ईस्‌रायलीम ने अगा अळी कारु बी मन्‌ना नी जड़्‌या, पण तीहया साल तीहया कनान देस नी मेर मे गेथु खादा।<note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="EXO 16:35">नीरगमन 16:35</ref></char></note><verse eid="JOS 5:12" /></para>
  <para style="s">यहोसु अने तलवार लेदलो एक अदमी</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 5:13" />जत्‌यार यहोसु यरीहोन्‌तां हतो ता तीहयो आह़फा ना डोळा उचा कर्‌यो, अने देख्‌यो, के हात मे एक मीयान मे गेथी नीकाळली तलवार लीन एक अदमी अगळ उबो हय र्‌यो; अने यहोसु तीनीन्‌तां ह़ाते जाय्‌न पुछ्‌यो, “ह़ु तु अमारी भणीन नो से, के अमारा वेरीम नी भणी नो?” <verse eid="JOS 5:13" /><verse number="14" style="v" sid="JOS 5:14" />ता तीहयो जपाप आप्‌यो, “नी; पण मे यहोवा भगवान ना मेळा नो मुख्‌यो हय्‌न हमणेत आवलो से।” ता यहोसु धरती पोर मोडा ना भरहे पड़ीन वांद्‌यो, अने तीने केदो, “तीना चाकर्‌या जुगु मारा मालीक नो ह़ु हुकम से?” <verse eid="JOS 5:14" /><verse number="15" style="v" sid="JOS 5:15" />यहोवा ना मेळा नो मुख्‌यो यहोसु ने केदो, “आह़फा ना खाहड़ा पोग मे गेथा नीकाळ दे, काहाके जे जागा पोर तु उबो हय र्‌यो तीहयो चोखलो से।” ता यहोसु तेमेत कर्‌यो।<verse eid="JOS 5:15" /></para>
  <chapter eid="JOS 5" />
  <chapter number="6" style="c" sid="JOS 6" />
  <para style="s">यरीहो नु खत्‌तम हयणु</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 6:1" />यरीहो ना आखा झापला ईस्‌रायली माणहुम ना बीक ना कारण सी लगातार देदला र्‌या, अने कोय बी मोय अने बाहर आय-जाय नी सकत्‌ला। <verse eid="JOS 6:1" /><verse number="2" style="v" sid="JOS 6:2" />अळतेण यहोवा यहोसु ने केदो, “ह़मळ, यरीहो ने तीना राजा अने तीना झुमायण्‌या भेळ तारा हक मे कर देम। <verse eid="JOS 6:2" /><verse number="3" style="v" sid="JOS 6:3" />एतरे तमारी मे जेतरा झुमायण्‌या से ह़ेर ने घेरवी लेवो, अने तीहया ह़ेर नी च्‌यारो-मेर एक वार फीरी आवे। अने छो दाड़ा तक एमेत कर्‌या करजे। <verse eid="JOS 6:3" /><verse number="4" style="v" sid="JOS 6:4" />अने ह़ात पुंजारा मोट्‌लु पेटारु नी अगळ-अगळ गाडरा ना ह़ींगड़ा ना ह़ात फेपार्‌या लीन चाले, अळतेण ह़ातवा दाड़े तमु ह़ेर नी च्‌यारो-मेर ह़ात काव फीरजो, अने पुंजारा फेपार्‌या बी वगाड़ता चाले। <verse eid="JOS 6:4" /><verse number="5" style="v" sid="JOS 6:5" />अने जत्‌यार तीहया गाडरा ना ह़ींगड़ा ना फेपार्‌या ढेरेत वार वगाड़ता र्‌या, ता आखा माणहु फेपार्‌या नी अवाज ह़मळतेत उची अवाज मे जयजयकार करे; ता ह़ेर नु भीतड़ु नीव पोर गेथु पड़ जहे, अने आखा माणहु आपणी-आपणी अगळ ह़ुदा ह़ेर मे जत रेय।” <verse eid="JOS 6:5" /><verse number="6" style="v" sid="JOS 6:6" />एतरे नुन नो सोरो यहोसु पुंजारा ने बोलावीन केदो, “वायदा नु पेटारु ने उचल लेवो, अने ह़ात पुंजारा यहोवा नु मोट्‌लु पेटारु अगळ-अगळ गाडरा ना ह़ींगड़ा ना ह़ात फेपार्‌या लीन चालो।” <verse eid="JOS 6:6" /><verse number="7" style="v" sid="JOS 6:7" />अळतेण तीहयो माणहु ने केदो, “अगा जाय्‌न ह़ेर नी च्‌यारो-मेर फीरी आवो; अने हत्‌यार लेदला अदमी यहोवा नु मोट्लु पेटारु अगळ-अगळ चालो।”<verse eid="JOS 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 6:8" />अने जत्‌यार यहोसु आहयी वात माणहु ने की देदो, ता तीहया ह़ात पुंजारा जे यहोवा अगळ ह़ात फेपार्‌या लीन हता फेपार्‌या वगाड़ता-वगाड़ता चाल्‌या, अने यहोवा ना वायदा नु मोट्‌लु पेटारु लेदला पुंजारा तीमनी पछळ-पछळ चाल्‌या। <verse eid="JOS 6:8" /><verse number="9" style="v" sid="JOS 6:9" />अने हत्‌यार लेदला अदमी फेपार्‌या वगाड़वा वाळा पुंजारा अगळ-अगळ चाल्‌या, अने पसळ वाळा मोट्‌लु पेटारुन पसळ चाल्‌या, अने पुंजारा फेपार्‌या वगाड़ता-वगाड़ता चाल्‌या। <verse eid="JOS 6:9" /><verse number="10" style="v" sid="JOS 6:10" />अने यहोसु माणहु ने हुकम आप्‌यो, “जत्‌यार तक मे तमने जय-जयकार करवा नो हुकम नी आपु, तांह तक जय-जयकार नी करजो, अने नी तमारो कानो बोल ह़मळाय, अने नी कानी बी वात तमारा मोडे गेथी नीकळवा जोवे; हुकम जड़तेत जय-जयकार करजो।” <verse eid="JOS 6:10" /><verse number="11" style="v" sid="JOS 6:11" />तीहयो यहोवा नु मोट्‌लु पेटारु ने एक वार ह़ेर नी च्‌यारो-मेर फीरवाड़्‌यो; अळतेण तीहया पड़ावा मे आवती र्‌या, अने रात तांत र्‌या।<verse eid="JOS 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 6:12" />यहोसु ह़वारे उठ्‌यो, अने पुंजारा यहोवा नु मोट्‌लु पेटारु ने उचल लेदा। <verse eid="JOS 6:12" /><verse number="13" style="v" sid="JOS 6:13" />अने तीहया ह़ातोव पुंजारा गाडरा ना ह़ींगड़ा ना ह़ात फेपार्‌या लीन अने यहोवा नु मोट्‌लु पेटारु अगळ-अगळ वगाड़ता चाल्‌या; अने तीमनी अगळ हत्‌यार लेदला अदमी चाल्‌या, अने पसळ वाळा यहोवा नु मोट्‌लु पेटारु नी पसळ-पसळ चाल्‌या, अने पुंजारा फेपार्‌या वगाड़ता-वगाड़ता चाल्‌या। <verse eid="JOS 6:13" /><verse number="14" style="v" sid="JOS 6:14" />आहयी रीते तीहया बीजा दाड़े बी एक वार ह़ेर नी च्‌यारो-मेर फीरीन पड़ावा मे पासा आवती र्‌या। अने आहयीत रीते आसमेत तीहया छो दाड़ा तक कर्‌या।<verse eid="JOS 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 6:15" />अने ह़ातवा दाड़े परगड़ फाटतेत वेगात उठीन तीहयीत रीते ह़ेर नी च्‌यारो-मेर ह़ात वार फीरी आया; तीहया दाड़े एतरा तीहया ह़ात वार फीर्‌या। <verse eid="JOS 6:15" /><verse number="16" style="v" sid="JOS 6:16" />ता ह़ातवी काव जत्‌यार पुंजारा फेपार्‌या वगाड़्‌या, ता यहोसु माणहु ने केदो, “जय-जयकार करो; काहाके यहोवा तमने आहयु ह़ेर आप देदलो से। <verse eid="JOS 6:16" /><verse number="17" style="v" sid="JOS 6:17" />ह़ेर अने तीनु आखु ह़मान मालीक जुगु बादा ना रुप मे ह़ोपीन पुरी रीते खत्‌तम कर देहे। राहाब छीनाळ्‌याण अने जेतरा तीना घोर मे हय तीहया जीवत्‌ला रेहे, काहाके तीहयी आपणा मोकल्‌ला दुतु ने ह़ताड़ीन राखली। <verse eid="JOS 6:17" /><verse number="18" style="v" sid="JOS 6:18" />पण तमु आमनी मे गेथु कंय बी नी लेजो, जीनु खत्‌तम हयणु से; कदीम तमु आहयी चीज मे गेथु कंय बी लेहु ता ईस्‌रायल ना पड़ावा पोर गरा अने वेला ने लावहु। <verse eid="JOS 6:18" /><verse number="19" style="v" sid="JOS 6:19" />आखु ह़ोनु, चांदी, अने जे ठाहरा पीतळ ना अने लुहड़ा ना से, तीहया यहोवा भगवान जुगु चोखला से, अने तीनात ठाहरा मेकवा ना घोर मे मेके।” <verse eid="JOS 6:19" /><verse number="20" style="v" sid="JOS 6:20" />ता माणहु जय-जयकार कर्‌या, अने पुंजारा फेपार्‌या वगाड़ता र्‌या। अने जत्‌यार माणहु फेपार्‌या नी अवाज ह़मळ्‌या ता अळतेण ज्‌योरेत अवाज सी तीहया जय-जयकार कर्‌या, ता भीतड़ु नीव पोर गेथु पड़ ज्‌यु, अने माणहु आह़फा-आह़फाम नी अगळ गेथा तीहया ह़ेर मे चड़ ज्‌या, अने ह़ेर पोर हक जमाड़ लेदा।<note caller="+" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="HEB 11:30">ईब्‌रानीयो 11:30</ref></char></note> <verse eid="JOS 6:20" /><verse number="21" style="v" sid="JOS 6:21" />अने आखा मतलब अदमी, बयरा, जुवान, डायला, अने बोळद्‌या, गाडरा-बोकड़ा, गदड़ा, अने जेतरा ह़ेर मे हता, तीहया आखा ने ह़ोपली चीज ह़मजीन तलवार वेर मार नाख्‌या।<verse eid="JOS 6:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 6:22" />ता यहोसु तीहया बेम अदमी ने जे तीहया देस ना बारा मे जाणवा करीन जेला हता केदो, “आह़फाम नी ह़ाम नी अनसारे तीहयी छीनाळ्‌याण ना घोर मे जाय्‌न तीने अने जे तीना घोर मे से तीमने बी नीकाळ लावो।” <verse eid="JOS 6:22" /><verse number="23" style="v" sid="JOS 6:23" />ता तीहया बेम जुवान मोय जाय्‌न राहाब ने, अने तीना आय्‌ह-बाहा, भायु, अने आखा ने जे तीनीन्‌तां रेता हता, मतलब तीना आखा ह़गला ने नीकाळ लाया, अने ईस्‌रायली माणहु ना पड़ावा गेथा सेटा बहाड़ देदा। <verse eid="JOS 6:23" /><verse number="24" style="v" sid="JOS 6:24" />ता तीहया ह़ेर ने अने जे कंय तीनी मे हतु, आखु ने आक्‌ठु धपाड़ीन बाळ नाख्‌या; अने चांदी, ह़ोनु, अने जे ठाहरा पीतळ अने लुहड़ा ना हता, तीहया तीने यहोवा ना ठाहरा मेकवा ना घोर मे मेक देदा। <verse eid="JOS 6:24" /><verse number="25" style="v" sid="JOS 6:25" />अने यहोसु राहाब छीनाळ्‌याण अने तीना बाह ना घोरल्‌या ने, अने तीना आखा माणहु ने जीवत्‌ला छोड़ देदो; अने आज तक तीनी जाती ईस्‌रायल मे रेय, काहाके जे दुत ने यहोसु यरीहो ना बारा मे जाणवा करीन मोकल्‌लो तीमने तीहयी ह़ताड़ रेली हती।<note caller="+" style="x"><char style="xo" closed="false">6:25 </char><char style="xt" closed="false"><ref loc="HEB 11:31">ईब्‌रानीयो 11:31</ref> </char></note> <verse eid="JOS 6:25" /><verse number="26" style="v" sid="JOS 6:26" />अळतेण तीहयीत टेमे यहोसु ईस्‌रायलीम नी अगळ आहयी ह़ाम खादो, अने केदो, “जे माणेह उठीन आहया ह़ेर यरीहो ने अळी पासो बणावे तीहयो यहोवा भणी गेथो सरापीत हये। जत्‌यार तीहयो तीनी नीव नाखहे ता तीनो मोट्‌लो सोरो मरहे, अने जत्‌यार तीहयो तीना झापला लगाड़हे ता तीनो नान्‌लो सोरो मर जहे।<note caller="+" style="x"><char style="xo" closed="false">6:26 </char><char style="xt" closed="false"><ref loc="1KI 16:34">1 राजा 16:34</ref></char></note> <verse eid="JOS 6:26" /><verse number="27" style="v" sid="JOS 6:27" />अने यहोवा भगवान यहोसु नी ह़ाते र्‌यो; अने यहोसु नु काम तीहया पुरा देस मे फेल ज्‌यु।”<verse eid="JOS 6:27" /></para>
  <chapter eid="JOS 6" />
  <chapter number="7" style="c" sid="JOS 7" />
  <para style="s">आकान नो पाप</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 7:1" />पण ईस्‌रायल ना माणहु भेट करवा नी चीज ना बारा मे भरहो तोड़ देदा; मतलब यहुदा जाती मे नो आकान, जे जेरह घोराणा नो जब्‌दी ना सोरा नो सोरो अने कर्‌मी नो सोरो हतो, तीहयो भेट करवा नी चीज मे गेथु थोड़ुक ली लेदो; करीन यहोवा भगवान ने ईस्‌रायल ना माणहु पोर रीह लागी।<verse eid="JOS 7:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JOS 7:2" />यहोसु यरीहो मे गेथा ए नाम ना ह़ेर ने तां, जे बेतावेन नी ह़ाते बेतेल नी उगवणी ह़ोड़ से, थोड़ाक माणहु ने आहयु कीन मोकल्‌यो, “जाय्‌न देस ना बारा मे मालम करीन आवो।” अने तीहया माणहु जाय्‌न देस ना बारा मे मालम कर्‌या। <verse eid="JOS 7:2" /><verse number="3" style="v" sid="JOS 7:3" />अने तीहया यहोसुन्‌तां आवीन केदा, “आखा माणहु ने तां जवा नी जरवत नी हय, बे-तीन हजार अदमी जाय्‌न ए ह़ेर ने जीक लेहु; आखा माणहु ने तां जवा नो दुख ना आपे, काहाके तीहया माणहु थोड़ाकेत से।” <verse eid="JOS 7:3" /><verse number="4" style="v" sid="JOS 7:4" />करीन तीनेक हजार अदमी ए नाम ना देस मे ज्‌या; पण ए देस मे रेवा वाळा माणहु नी अगळ गेथा नाहीन पासा आवती र्‌या, <verse eid="JOS 7:4" /><verse number="5" style="v" sid="JOS 7:5" />ता ए ह़ेर मे रेवा वाळा तीमनी मे गेथा छत्‌तीस अदमी ने मार नाख्‌या, अने तीना झापले गेथा दगड़ा नी खदान तक तीमनी पसळ आवीन उतार मे तक तीमने ठोकता-ठोकता ज्‌या। ता माणहु नु मन कमजोर हय्‌न ठंडु पड़ ज्‌यु अने तीहया बीह ज्‌या।<verse eid="JOS 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 7:6" />ता यहोसु आह़फा ना लुगड़ा फाड़्‌यो, अने तीहयो अने ईस्‌रायल ना मुख्‌या माणहु यहोवा नु मोट्‌लु पेटारु अगळ मोडा ना भरहे पड़ीन धरती पोर ह़ांता तक पड़ र्‌या; अने तीहया आह़फा-आह़फाम ना मुंडा पोर कादु नाख्‌या। <verse eid="JOS 7:6" /><verse number="7" style="v" sid="JOS 7:7" />अने यहोसु केदो, “गरा आय पड़े, मालीक यहोवा, तु तारा आहया माणहु ने यरदन नंदीन पार ह़ुका ली आयो? ह़ु आमने एमोरी जाती ना हक मे करीन खत्‌तम करवा करीन ली आवलो से? भलु हयतु के आमु काठो जीव करीन यरदन नंदीन बीजी धेड़े री जता! <verse eid="JOS 7:7" /><verse number="8" style="v" sid="JOS 7:8" />गरा आय पड़े, मालीक मे ह़ु केम, जत्‌यार ईस्‌रायल ना माणहु आह़फाम ना वेरीम ने वाहो देखाड़ला से! <verse eid="JOS 7:8" /><verse number="9" style="v" sid="JOS 7:9" />काहाके कनानी जाती अने आहया देस ना आखा रेवा वाळा आहयु ह़मळीन आमु ने घेर लेहे, अने अमारु नाम धरती पोर गेथु मीटाड़ देहे; अळतेण तु तारा मोटा नाम नी लेदे ह़ु करही?” <verse eid="JOS 7:9" /><verse number="10" style="v" sid="JOS 7:10" />यहोवा यहोसु ने केदो, “उठ, उबो हय जा, तु ह़ुका आहयी रीते मोडा ना भरहे धरती पोर पड़ र्‌यो? <verse eid="JOS 7:10" /><verse number="11" style="v" sid="JOS 7:11" />ईस्‌रायल ना माणहु पाप करला से; अने जे वायदो मे तीमने मारी ह़ाते करावलो तीने तीहया तोड़ देदला से, तीहया भेट करवा नी चीज मे गेथु ली लेदला से, अने चोरी बी करला से अने झुट मेकीन तीने आह़फाम ना ह़मान मे मेक लेदला से। <verse eid="JOS 7:11" /><verse number="12" style="v" sid="JOS 7:12" />करीन ईस्‌रायली माणहु आह़फाम ना वेरी अगळ उबा नी री सकता; तीहया आह़फाम ना वेरी ने वाहो देखाड़े, आनीन करते के तीहया आह़फात भेट करवा नी चीज बण जेला से। अने कदीम तमु तमारी वचमे गेथा भेट करवा नी चीज ने खत्‌तम नी करो, ता मे अगो चालीन तमारी ह़ाते नी रेम। <verse eid="JOS 7:12" /><verse number="13" style="v" sid="JOS 7:13" />उठ, माणहु ने चोखा कर, तीमने के, ‘ह़वारे तक आह़फा-आह़फाम ने चोखला कर राखो; काहाके ईस्‌रायल नो भगवान यहोवा आसम केय, “ए ईस्‌रायल, तारी वच मे भेट करवा नी चीज से; एतरे जत्‌यार तक तु भेट करवा नी चीज ने तारी वचमे गेथी सेटी नी करे तांह तक तु तमारा वेरी अगळ उबो नी री सके।” <verse eid="JOS 7:13" /><verse number="14" style="v" sid="JOS 7:14" />एतरे ह़वारे तमु ने जाती-जाती नी अनसारे ह़ाते उबा करहे; अने जे जाती ने यहोवा केहे तीहया एक-एक घोराणु करीन ह़ाते आवे; अने अळतेण जे घोराणु यहोवा भगवान केहे तीहया एक-एक अदमी करीन ह़ाते आवे। <verse eid="JOS 7:14" /><verse number="15" style="v" sid="JOS 7:15" />अळतेण जे अदमी भेट करवा नी चीज ने मेकलो धराय जहे, तीहयो अने जे कंय तीनु हय तीहयु आखु आक्‌ठु मे नाखीन धपाड़ देय; काहाके तीहया यहोवा ना वायदा ने तोड़ला से, अने ईस्‌रायल मे गलत काम करलो से।’”<verse eid="JOS 7:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 7:16" />यहोसु ह़वारे उठीन ईस्‌रायली माणहु ने जाती-जाती करीन ह़ाते ली ज्‌यो, अने यहुदा नी जाती धराय जी; <verse eid="JOS 7:16" /><verse number="17" style="v" sid="JOS 7:17" />ता तीहयो यहुदा नी जाती ने ह़ाते लीज्‌यो, अळतेण जेरह नु घोराणु धराय ज्‌यु; अळतेण जेरह ना घोराणा ना एक-एक अदमी ने ह़ाते लायो, अने जब्‌दी धराय ज्‌यो; <verse eid="JOS 7:17" /><verse number="18" style="v" sid="JOS 7:18" />ता तीहयो तीना घोराणा ना एक-एक अदमी ने ह़ाते उबा कर्‌यो, अने यहुदा जाती नो आकान, जे जेरह घोराणा नो जब्‌दी ना सोरा ना सोरा कर्‌मी नो सोरो हतो धराय ज्‌यो। <verse eid="JOS 7:18" /><verse number="19" style="v" sid="JOS 7:19" />ता यहोसु आकान ने केवा बाज ज्‌यो, “ए मारा सोरा, ईस्‌रायल ना भगवान यहोवा नी ईज्‌जत कर, अने तीनी अगळ मान ले; अने जे कंय तु करलो से तीहयु मने देखाड़ दे, अने मारी अगळ कंय ना ह़ताड़े।” <verse eid="JOS 7:19" /><verse number="20" style="v" sid="JOS 7:20" />आकान यहोसु ने जपाप आप्‌यो, “ह़ाचलीन मे ईस्‌रायल ना भगवान यहोवा ना वीरोद मे पाप करलो से, अने आहयी रीते मे करलो से, <verse eid="JOS 7:20" /><verse number="21" style="v" sid="JOS 7:21" />के जत्‌यार मने लुट मे सीनार देस नु एक घटाळ्‌ळु डगलु, अने बे कीलो चांदी, अने आदो कीलो ह़ोना नु ईटड़ु देखाव पड़्‌यु, ता मे तीनी लालच करीन तीमने राख लेदो; तीहयु आखु मारा पड़ावा मे मोय कादा मे गाड़लु से, अने आखान हेटु चांदी से।”<verse eid="JOS 7:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 7:22" />ता यहोसु माणहु ने मोकल्‌यो अने तीहया दवड़ीन पड़ावा मे ज्‌या; अने तीहया देख्‌या के तीहयु ह़मान तीना पड़ावा मे गाड़लु से, अने आखा गेथु हेटु चांदी से। <verse eid="JOS 7:22" /><verse number="23" style="v" sid="JOS 7:23" />तीहयु ह़मान ने तीहया पड़ावा मे गेथा काडीन यहोसु अने आखा ईस्‌रायल ना माणहुन्‌तां लावीन यहोवा अगळ मेक देदा। <verse eid="JOS 7:23" /><verse number="24" style="v" sid="JOS 7:24" />ता आखा ईस्‌रायल ना माणहु भेळ यहोसु जेरह घोराणा ना आकान ने, अने तीहयु चांदी अने डगलु अने ह़ोना नु ईटड़ु ने, अने तीना सोरा ने, अने तीना बोळद्‌या, गदड़ा अने गाडरा-बोकड़ा ने, अने तीना पड़ावा ने, मतलब जे कंय तीनु हतु तीहयु आखु ने आकोर नाम नी घाटी मे लीज्‌यो। <verse eid="JOS 7:24" /><verse number="25" style="v" sid="JOS 7:25" />ता यहोसु तीने केदो, “तु आमने ह़ुका वेला मे नाखलो से? आज ना दाड़े यहोवा तनेत वेला पाड़हे।” ता आखा ईस्‌रायल ना माणहु तीमने दगड़ाट्‌या; अने तीमने आक्‌ठु मे नाखीन धपाड़्‌या, अने तीमनी पोर दगड़ा नाख देदा। <verse eid="JOS 7:25" /><verse number="26" style="v" sid="JOS 7:26" />अने तीहया तीमनी पोर दगड़ा नो मोट्‌लो ढेर बणाय देदा जे आज तक बणलो से; ता यहोवा भगवान ने लागली रीह ठंडी पड़ जी। आहया कारण सी तीहया जागा नु नाम आज तक आकोर<note caller="+" style="f"><char style="fr" closed="false">7:26 </char><char style="ft" closed="false">मतलब, वेला पाड़वा</char></note> घाटी पड़्‌यु।<verse eid="JOS 7:26" /></para>
  <chapter eid="JOS 7" />
  <chapter number="8" style="c" sid="JOS 8" />
  <para style="s">ए ह़ेर ने कब्‌जो अने खत्‌तम करनु</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 8:1" />ता यहोवा भगवान यहोसु ने केदो, “बीहे ना, अने तारु मन काचु ना कर; केड़ बांदीन आखा झुमायण्‌या ने ह़ाते ले, अने ए ह़ेर ह़ाते झुमाय; ह़मळ, मे ए ना राजा ने तीना माणहु अने तीना ह़ेर अने जागा भेळ तारा हक मे कर देदलो से। <verse eid="JOS 8:1" /><verse number="2" style="v" sid="JOS 8:2" />अने जेम तु यरीहो अने तीना राजा ह़ाते कर्‌यो तेमेत ए ह़ेर अने तीना राजा ह़ाते बी करजे; तमु जानवरु ने अने ह़मान ने एतरात तमारी जुगु लुट लेजो; करीन तीहया ह़ेर नी पसळ ह़ोड़ गेथा तारा माणहु ने झगड़ो करवा करीन मोकल दे।”<verse eid="JOS 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="JOS 8:3" />अने यहोसु आखा झुमायण्‌या भेळ ए ह़ेर ह़ाते झुमायवा नी तीयारी कर्‌यो; अने यहोसु तीस हजार अदमी ने जे झुमायण्‌या हता टाळीन रातेत हुकम आपीन मोकल्‌यो। <verse eid="JOS 8:3" /><verse number="4" style="v" sid="JOS 8:4" />अने तीमने आहयो हुकम आप्‌यो, “ह़मळो, तमु तीहया ह़ेर नी पाछली ह़ोड़ गेथा झुमायवा तकाय रेजो; ह़ेर गेथा जादा सेटा नी जजो, अने आखान आखा तीयार रेजो; <verse eid="JOS 8:4" /><verse number="5" style="v" sid="JOS 8:5" />अने मे मारा आखा ह़ाती भेळ तीहया ह़ेर नी ह़ाते जही। अने जत्‌यार तीहया पेलेन तेम अमारी ह़ाते झुमायवा नीकळहे, आमु तीमनी अगळ गेथा नाह्‌हु। <verse eid="JOS 8:5" /><verse number="6" style="v" sid="JOS 8:6" />ता तीहया आहयु सोचीन, के तीहया पेलेन तेम अमारी अगळ गेथा नाहीन जाय, करीन अमारी पसळ पड़हे; आहयी रीते आमु तीमनी अगळ गेथा नाहीन तीमने ह़ेर गेथा बाहर नीकळीन ली जहु; <verse eid="JOS 8:6" /><verse number="7" style="v" sid="JOS 8:7" />ता तमु तकाय रेहु तां गेथा उठीन ह़ेर ने तमारा हक मे कर लेजो; काहाके तमारो भगवान यहोवा तीने तमारा हात मे कर देहे। <verse eid="JOS 8:7" /><verse number="8" style="v" sid="JOS 8:8" />अने जत्‌यार ह़ेर ने हक मे कर लेवो ता तीनी मे आक्‌ठु धपाड़ देजो, यहोवा ना हुकम नी अनसारेत काम करजो; ह़मळो, मे तमने हुकम आपलो से।” <verse eid="JOS 8:8" /><verse number="9" style="v" sid="JOS 8:9" />ता यहोसु तीमने मोकल देदो; अने तीहया तकाय्‌न बहवा करीन जत र्‌या, अने बेतेल अने ए ह़ेर नी वचमे अने ए ह़ेर नी बुडणली ह़ोड़ बह र्‌या; पण यहोसु तीहयी राते माणहु नी वच मे र्‌यो।<verse eid="JOS 8:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 8:10" />यहोसु ह़वारे उठ्‌यो, अने माणहु ने एक्‌ठा करीन ईस्‌रायल ना मुख्‌या माणहु भेळ माणहु नी अगळ-अगळ ए ह़ेर भणीन चाल पड़्‌यो। <verse eid="JOS 8:10" /><verse number="11" style="v" sid="JOS 8:11" />अने तीनी ह़ाते ना आखा झुमायण्‌या अगा बड़्‌या, अने ए ह़ेर नी ह़ाते पुगीन तीनी अगळ जमणी ह़ोड़ पड़ावो नाख्‌या, अने तीमना अने ए ह़ेर नी वच मे एक घाटी हती। <verse eid="JOS 8:11" /><verse number="12" style="v" sid="JOS 8:12" />ता तीहयो पांचेक हजार अदमी टाळीन बेतेल अने ए ह़ेर नी वचे वाळा ह़ेर नी बुडणली ह़ोड़ तीमने ह़ताड़ीन बहाड़ देदो। <verse eid="JOS 8:12" /><verse number="13" style="v" sid="JOS 8:13" />अने हाव माणहु ह़ेर नी धुराव भणी नी आखी सेना ने तीमनी बुडणली ह़ोड़ ह़ताय्‌न बहण्‌या ने बी ठीकाणा पोर कर देदो, ता यहोसु तीहयीत राते घाटी नी वच मे ज्‌यो। <verse eid="JOS 8:13" /><verse number="14" style="v" sid="JOS 8:14" />जत्‌यार ए ह़ेर नो राजो आहयु देख्‌यो, ता तीहया उतवाळ करीन ह़वारे उठ्‌या, अने राजो आह़फा ना आखा माणहु ने लीन ईस्‌रायल ना माणहु नी अगळ तीमनी ह़ाते झुमायवा नीकळीन ठेरावला जागे जे यरदन नी घाटी अगळ से पुग्‌यो; अने तीहयो नी जाणतो हतो के ह़ेर नी पासली ह़ोड़ माणहु तकाय्‌न बह र्‌या। <verse eid="JOS 8:14" /><verse number="15" style="v" sid="JOS 8:15" />ता यहोसु अने आखा ईस्‌रायली माणहु तीमनी सी हार जेलान तेम जंगल नी वाटे माय्‌न नाह पड़्‌या। <verse eid="JOS 8:15" /><verse number="16" style="v" sid="JOS 8:16" />ता ह़ेर ना आखा माणहु ने ईस्‌रायल ना माणहु नी पसळ जवा करीन आड़ी-आड़ीन बोलाया; अने तीहया यहोसुम नी पसळ पड़ीन ह़ेर गेथा सेटा नीकळ ज्‌या। <verse eid="JOS 8:16" /><verse number="17" style="v" sid="JOS 8:17" />अने नी ए ह़ेर मे अने नी बेतेल ह़ेर मे कोय माणेह र्‌यु, जे ईस्‌रायल ना माणहु नी पसळ नी ज्‌या हय; अने तीहया ह़ेर ने खुल्‌लु मेकीन ईस्‌रायल ना माणहु नी पसळ जत र्‌या।<verse eid="JOS 8:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JOS 8:18" />ता यहोवा यहोसु ने केदो, “तारा हात मे नो भालो ए ह़ेर भणीन नाम्‌बो कर; काहाके मे तीने तारा हात मे आप देही।” अने यहोसु तीना हात मे ना भाला ने ह़ेर भणीन नाम्‌बो कर्‌यो। <verse eid="JOS 8:18" /><verse number="19" style="v" sid="JOS 8:19" />तीनो हात नाम्‌बो करतेत जे माणहु ह़ताय्‌न बह रेला साटात तीमना जागे गेथा उठ्‌या, अने दवड़ीन ह़ेर मे भराय ज्‌या अने तीने तीमना हक मे कर लेदा; अने साटात तीनी मे आक्‌ठु धपाड़ देदा। <verse eid="JOS 8:19" /><verse number="20" style="v" sid="JOS 8:20" />जत्‌यार ए ह़ेर मे रेवा वाळा माणहु पासा फीरीन नींगा नाख्‌या, ता देख्‌या के ह़ेर नो धुकरो वादळु भणीन उडीन जाय; अने तीमने नी आंखर नाहवा नी हीम्‌मत आयी अने नी एथा नाहवा नी, अने जे माणहु जंगल भणीन नाहीन जता हता तीहया तीमने दवड़ाव्‌वा वाळा भणीन जी लाग्‌या। <verse eid="JOS 8:20" /><verse number="21" style="v" sid="JOS 8:21" />जत्‌यार यहोसु अने आखा ईस्‌रायल ना माणहु देख्‌या के ह़ताय्‌न बहवा वाळा ह़ेर ने हक मे कर लेदा, अने तीनो धुकरो उडवा बाज र्‌यो, ता पासा फीरीन ए ह़ेर ना माणहु ने ठोकवा बाज ज्‌या। <verse eid="JOS 8:21" /><verse number="22" style="v" sid="JOS 8:22" />अने तीमनी ह़ाते झुमायवा करीन ए ह़ेर मे वाळा बी नीकळ आया। एतरे तीहया ईस्‌रायल ना माणहु नी वचमे घेरवाय ज्‌या, थोड़ाक ईस्‌रायली माणहु तीमनी अगळ, अने थोड़ाक तीमनी पसळ हता; अने तीहया तीमने आसम मार्‌या के तीमनी मे गेथा नी ते कोय बच्‌यु अने नी कोय नाहीन जाय सक्‌यु। <verse eid="JOS 8:22" /><verse number="23" style="v" sid="JOS 8:23" />अने तीहया ए ह़ेर ना राजा ने जीवत्‌लो धरीन यहोसुन्‌तां ली आया।<verse eid="JOS 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 8:24" />जत्‌यार ईस्‌रायल ना माणहु ए ह़ेर ना आखा रेवा वाळा ने चोगान मे, मतलब तीहया जंगल मे जां तीहया ईमनी पसळ आवला हता मार देदा, अने तीहया आखा तलवार नी धार वेर मर्‌या आञे तक के तीहया खत्‌तम हय ज्‌या, ता आखा ईस्‌रायल ना माणहु ए ह़ेर मे पासा जाय्‌न आखा रेवा वाळा ने तलवार वेर मार नाख्‌या। <verse eid="JOS 8:24" /><verse number="25" style="v" sid="JOS 8:25" />अने अदमी अने बयरा अने आखा मळीन जे तीहया दाड़े मर्‌या तीहया बारे हजार हता, अने ए ह़ेर ना आखा माणहु एतरात हता। <verse eid="JOS 8:25" /><verse number="26" style="v" sid="JOS 8:26" />काहाके जत्‌यार तक यहोसु ए ह़ेर ना आखा रेवा वाळा ने मारीन खत्‌तम नी कर देदो तांह तक तीहयो आह़फा नो हात, जीनी वेर भालो अगो करलो हतो हेटो नी कर्‌यो। <verse eid="JOS 8:26" /><verse number="27" style="v" sid="JOS 8:27" />यहोवा भगवान ना तीहया हुकम नी अनसारे जे तीहयो यहोसु ने आपलो ईस्‌रायल ना माणहु जानवरु अने ह़ेर मे नु ह़मान ने तीमनी जुगु लुट लेदा। <verse eid="JOS 8:27" /><verse number="28" style="v" sid="JOS 8:28" />अळतेण यहोसु ए ह़ेर मे आक्‌ठु धपाड़ देदो, अने तीने जलमकु उजाड़ कर देदो: तीहयु आज तक उजाड़ पड़ र्‌यु। <verse eid="JOS 8:28" /><verse number="29" style="v" sid="JOS 8:29" />अने ए ह़ेर ना राजा ने तीहयो ह़ांतो तक झाड़ पोर टांग राख्‌यो; अने दाड़ु बुडते-बुडते यहोसु ना हुकम सी तीनु धोड़ झाड़ पोर गेथु उतारीन ह़ेर ना झापला अगळ नाख देदा, अने तीनी पोर दगड़ा नो मोट्‌लो ढेर लगाड़ देदा, जे आज तक बणलो से।<verse eid="JOS 8:29" /></para>
  <para style="s">एबाल बड़ा पोर नेम नो पाट</para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 8:30" />ता यहोसु ईस्‌रायल ना भगवान यहोवा जुगु एबाल बड़ा पोर एक वेदी बणायो,<note caller="+" style="x"><char style="xo" closed="false">8:30 </char><char style="xt" closed="false"><ref loc="DEU 27:2-8">वेवस्‌थावीवरन 27:2-8</ref></char></note> <verse eid="JOS 8:30" /><verse number="31" style="v" sid="JOS 8:31" />जेम यहोवा भगवान नो चाकर्‌यो मुसो ईस्‌रायल ना माणहु ने हुकम आपलो, अने जेम मुसा नी कायदा नी कीताप मे लीखलु से, तीहयो एक वारला दगड़ा नी एक वेदी बणायो जीनी पोर अवज्‌यार नी लागलु हतु। अने तीनी पोर तीहया यहोवा जुगु होम बादा, अने मेल-मीलाप नी बादा चड़ाया।<note caller="+" style="x"><char style="xo" closed="false">8:31 </char><char style="xt" closed="false"><ref loc="EXO 20:25">नीरगमन 20:25</ref></char></note> <verse eid="JOS 8:31" /><verse number="32" style="v" sid="JOS 8:32" />तीहयात जागे यहोसु ईस्‌रायली माणहुम नी अगळ तीहया दगड़ा पोर मुसा नी नेम, जे तीहयो लीखलो हतो, तीनीन तेमेत लीखाड़्‌यो। <verse eid="JOS 8:32" /><verse number="33" style="v" sid="JOS 8:33" />अने तीहया बीजा देस वाळा अने देस वाळा आखा ईस्‌रायल ना माणहु आह़फाम ना मुख्‌या माणहु, डाहला, अने नीयाव करन्‌या भेळ यहोवा नु वायदा नु मोट्‌लु पेटारु उचलवा वाळा लेवी जाती ना पुंजाराम नी अगळ तीहयु मोट्‌लु पेटारुन एथान-एथा उबा हया, मतलब आदा माणहु ते गीरीज्‌जीम बड़ा नी, अने आदा एबाल बड़ान अगळ उबा हया, जीसम के यहोवा नो चाकर्‌यो मुसो पेले गेथोत हुकम आपलो हतो के ईस्‌रायली माणहु ने बरकत आपे। <verse eid="JOS 8:33" /><verse number="34" style="v" sid="JOS 8:34" />तीनीन अळतेण तीहयो बरकत अने सराप नी नेम ना आखा बोल, जेम-जेम नेम नी कीताप मे लीखला से तेम-तेम भणी-भणीन ह़मळाय देदो। <verse eid="JOS 8:34" /><verse number="35" style="v" sid="JOS 8:35" />जेतरी वात नो मुसो हुकम आपलो हतो, तीनी मे गेथी एवी कानी वात नी री जे यहोसु ईस्‌रायल ना माणहु नी सबा, अने बयरा, अने सोरा, अने तीमनी ह़ाते रेवा वाळा बीजा देस वाळा माणहु अगळ बी भणीन नी देखाड़्‌यो हय।<note caller="+" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="DEU 11:29">वेवस्‌थावीवरन 11:29</ref>; <ref loc="DEU 27:11-14">27:11-14</ref></char></note><verse eid="JOS 8:35" /></para>
  <chapter eid="JOS 8" />
  <chapter number="9" style="c" sid="JOS 9" />
  <para style="s">गीबोनी यहोसु ने धोको देय</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 9:1" />आहयु ह़मळीन हीत्‌ती, एमोरी, कनानी, परीज्‌जी, हीब्‌बी, अने यबुसी, जेतरा राजा यरदन नंदीन आहयी धेड़े बड़ा वाळा देस मे, अने लबानोन नी अगळ नी मोट्‌ली दर्‌या ना काठे रेता हता, <verse eid="JOS 9:1" /><verse number="2" style="v" sid="JOS 9:2" />तीहया एक-मन्‌या हय्‌न यहोसु अने ईस्‌रायल ना माणहु नी ह़ाते झुमायवा करीन एक्‌ठा हया। <verse eid="JOS 9:2" /><verse number="3" style="v" sid="JOS 9:3" />जत्‌यार गीबोन ना रेवा वाळा ह़मळ्‌या के यहोसु यरीहो अने ए ह़ेर वाळा ह़ाते ह़ु-ह़ु कर्‌यो, <verse eid="JOS 9:3" /><verse number="4" style="v" sid="JOS 9:4" />ता तीहया चाल चाल्‌या, अने राजदुत नो रुप बणावीन आह़फाम ना गदड़ा पोर जुन्‌ला ठेला, अने जुन्‌ला फाट्‌ला अने जोड़ला ह़रु ना कवड़्‌या लादीन <verse eid="JOS 9:4" /><verse number="5" style="v" sid="JOS 9:5" />आह़फाम ना पोगु मे जुन्‌ला ह़ीवला खाहड़ा, अने डील पोर जुन्‌ला लुगड़ा पेर्‌या, अने आह़फा खावा जुगु ह़ुकला बुरथायला रोट्‌ला ली लेदा। <verse eid="JOS 9:5" /><verse number="6" style="v" sid="JOS 9:6" />ता तीहया गीलगाल ना पड़ावा मे यहोसुन्‌तां जाय्‌न तीने अने ईस्‌रायल ना अदमी ने केवा बाज ज्‌या, “आमु नाम्‌बे देस मे गेथा आवला से; एतरे तमु हाव अमारी ह़ाते वायदो करो।” <verse eid="JOS 9:6" /><verse number="7" style="v" sid="JOS 9:7" />ईस्‌रायल ना अदमी तीहया हीब्‌बी ने केदा, “आमने ह़ु मालम तमु अमारी धेड़ेत रेता हय; आमु तमारी ह़ाते वायदो कीकम करया?”<note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="EXO 23:32">नीरगमन 23:32</ref>; <ref loc="EXO 34:12">34:12</ref>; <ref loc="DEU 7:2">वेवस्‌थावीवरन 7:2</ref></char></note> <verse eid="JOS 9:7" /><verse number="8" style="v" sid="JOS 9:8" />तीहया यहोसु ने केदा, “आमु तारा चाकर्‌या से।” ता यहोसु तीमने केदो, “तमु कोय से? अने कां गेथा आवला से?” <verse eid="JOS 9:8" /><verse number="9" style="v" sid="JOS 9:9" />तीहया तीने केदा, “तारा चाकर्‌या घणा नाम्‌बे ना देस गेथा तारा भगवान यहोवा नु नाम ह़मळीन आवला से; काहाके आमु आहयु आखु ह़मळला से, मतलब तीनु काम अने जे कंय तीहयो मीस्‌र मे कर्‌यो, <verse eid="JOS 9:9" /><verse number="10" style="v" sid="JOS 9:10" />अने जे कंय तीहयो एमोरी ना बेम राजा ह़ाते कर्‌यो जे यरदन नंदी नी ह़ेली धेड़े उगवणी ह़ोड़ रेता हता, मतलब हेसबोन ना राजा सीहोन ह़ाते, अने बासान ना राजा ओग ह़ाते जे अस्‌तारोत मे हतो।<note caller="+" style="x"><char style="xo" closed="false">9:10 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">गीनती 21:21-35</ref></char></note> <verse eid="JOS 9:10" /><verse number="11" style="v" sid="JOS 9:11" />करीन अमारीन्‌तां ना मुख्‌या माणहु अने अमारा देस मे ना आखा रेवा वाळा आमने केदा, के वाट्‌ये जुगु तमारी ह़ाते खावा नु चीज लीन तीमने भेटवा जावो, अने तीमने केजो, के आमु तमारा चाकर्‌या से; एतरे हाव तमु अमारी ह़ाते वायदो करो। <verse eid="JOS 9:11" /><verse number="12" style="v" sid="JOS 9:12" />जे दाड़े आमु तमारीन्‌तां आव्‌वा करीन नीकळ्‌या तीहया दाड़े ते आमु अमारा-अमारा घोर गेथा आहया रोट्‌ला उन्‌ला अने ताबला लेदला; पण हाव देखो, आहया ह़ुक जेला से अने आहया बुरथाय जेला से। <verse eid="JOS 9:12" /><verse number="13" style="v" sid="JOS 9:13" />अळतेण जे आहया ह़रु ना कवड़्‌या आमु भरला लेदला, ता ते नवला हता, पण देखो आहया हाव फाट जेला से; अने अमारा आहया लुगड़ा अने खाहड़ा घणी नाम्‌बे नी चाल ना कारण सी जुना हय जेला से।” <verse eid="JOS 9:13" /><verse number="14" style="v" sid="JOS 9:14" />ता तीहया अदमी यहोवा भगवान पांह ह़ला लीया वगर तीमनु खाणु मे गेथु ली लेदा। <verse eid="JOS 9:14" /><verse number="15" style="v" sid="JOS 9:15" />ता यहोसु तीमने भेटीन तीमनी ह़ाते आहयो वायदो कर्‌यो के तमु ने जीवत्‌ला रेवा देहु; अने मंडळी ना मुख्‌या बी ह़ाम खादा।<verse eid="JOS 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 9:16" />तीमनी ह़ाते वायदो करवान तीन दाड़ान अळतेण तीमने आहयी खबर जड़ी, के तीहया अमारी धेड़े ना देस मे रेवा वाळा से, अने अमारीत धेड़े वहला से। <verse eid="JOS 9:16" /><verse number="17" style="v" sid="JOS 9:17" />ता ईस्‌रायली माणहु नीकळीन तीसरा दाड़े तीमना ह़ेर मे पुग्‌या जीमना नाम गीबोन, कपीरा, बेरोत, अने कीर्‌यात्‌यारीम से। <verse eid="JOS 9:17" /><verse number="18" style="v" sid="JOS 9:18" />अने ईस्‌रायली माणहु तीमने नी मार्‌या, काहाके मंडळी ना मुख्‌या तीमनी ह़ाते ईस्‌रायल ना भगवान नी ह़ाम खादला हता। ता आखी मंडळी ना माणहु मुख्‌या ना वीरोद मे कंय-कंय केवा बाज ज्‌या। <verse eid="JOS 9:18" /><verse number="19" style="v" sid="JOS 9:19" />ता आखा मुख्‌या आखी मंडळी ने केदा, “आमु तीमने ईस्‌रायल ना भगवान यहोवा नी ह़ाम खादला से, एतरे हाव ईमने छीमी बी नी सकता। <verse eid="JOS 9:19" /><verse number="20" style="v" sid="JOS 9:20" />आमु तीमनी ह़ाते आहयुत करहु के तीहयी ह़ाम नी अनसारे आमु तीमने जीवत्‌ला छोड़ देहु, नीता अमारी खादली ह़ाम ना कारण सी आपणी पोर मालीक ने रीह लागहे।” <verse eid="JOS 9:20" /><verse number="21" style="v" sid="JOS 9:21" />अळतेण मुख्‌या तीमने केदा, “तीमने जीवत्‌ला छोड़ देवो।” अने मुख्‌या ना आहया बोल नी अनसारे तीहया आखी मंडळी जुगु लाकड़ा वाडण्‌या अने पाणी भरन्‌या बण्‌या।<verse eid="JOS 9:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 9:22" />अळतेण यहोसु तीमने बोलावीन केदो, “तमु ते अमारी धेड़ेत रेवो, ता तमु आमने आहयु कीन काहा धोको देदा, के आमु तमारी गेथा घणा नाम्‌बे रीया? <verse eid="JOS 9:22" /><verse number="23" style="v" sid="JOS 9:23" />एतरे तमु हाव सरापीत से, अने तमारी मे गेथा एवा कोय बी नी रेय के चाकर्‌या, मतलब मारा भगवान ना घोर जुगु लाकड़ा वाडण्‌या अने पाणी भरवा वाळा नी हय।” <verse eid="JOS 9:23" /><verse number="24" style="v" sid="JOS 9:24" />तीहया यहोसु ने जपाप आप्‌या, “तारा चाकर्‌या ने आहयु पक्‌कु देखाड़लु हतु, के तारो भगवान यहोवा तीना चाकर्‌या मुसा ने हुकम आपलो हतो के तमने तीहयो आखु देस आपे, अने तीनी मे आखा रेवा वाळा ने तमारी अगळ गेथा खत्‌तम करे; करीन आमु ने तमारा कारण सी अमारा जीव नी लेदे घणा बीह ज्‌या, करीन आमु आसवु काम कर्‌या। <verse eid="JOS 9:24" /><verse number="25" style="v" sid="JOS 9:25" />अने हाव आमु तारा हक मे से, जेवो वेहवार तने भलो लागे अने वारु मालम पड़े, तेवोत वेहवार अमारी ह़ाते कर।” <verse eid="JOS 9:25" /><verse number="26" style="v" sid="JOS 9:26" />ता तीहयो तीमनी ह़ाते तेमेत कर्‌यो, अने तीमने ईस्‌रायल ना माणहु ना हात मे गेथा आसम बचाड़्‌यो, के तीहया तीमने मार नी सक्‌या। <verse eid="JOS 9:26" /><verse number="27" style="v" sid="JOS 9:27" />पण यहोसु तीहयात दाड़े तीमने मंडळी जुगु, अने जे जागो यहोवा टाळ लेय तीनी मे तीनी वेदी जुगु, लाकड़ा लावण्‌या अने पाणी भरन्‌या टाळ देदो, जेम आज तक से।<verse eid="JOS 9:27" /></para>
  <chapter eid="JOS 9" />
  <chapter number="10" style="c" sid="JOS 10" />
  <para style="s">एमोरी जाती ने हरावणु</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 10:1" />जत्‌यार यरुसलेम नो राजो अदोनीसेदेक ह़मळ्‌यो के यहोसु ए ह़ेर ने हक मे कर लेदो, अने तीने खत्‌तम कर देदलो से, अने जेम तीहयो यरीहो अने तीना राजा ह़ाते करलो तेमेत ए ह़ेर ह़ाते अने तीना राजा ह़ाते बी कर्‌यो, अने आहयु बी ह़मळ्‌यो के गीबोन ना रेवा वाळा ईस्‌रायल ना माणहु नी ह़ाते मळ जेला से, अने तीमनी ह़ाते रेवा बाज ज्‌या, <verse eid="JOS 10:1" /><verse number="2" style="v" sid="JOS 10:2" />ता तीहया घणा बीह ज्‌या, काहाके गीबोन मोट्‌लु ह़ेर अने तीनी मे बी राजो राज करतो हतो अने ए ह़ेर गेथु बी मोटु हतु, अने तीनी मे रेवा वाळा आखा झुमायण्‌या सीपायड़ा हता। <verse eid="JOS 10:2" /><verse number="3" style="v" sid="JOS 10:3" />करीन यरुसलेम नो राजो अदोनीसेदेक हेब्‌रोन ना राजा होहाम, यर्‌मुत ना राजा पीराम, लाकीस ना राजा यापी, अने एग्‌लोन ना राजा दबीर ने तां आहयु की मोकल्‌यो: <verse eid="JOS 10:3" /><verse number="4" style="v" sid="JOS 10:4" />“मारीन्‌तां आवीन मारी मदत करो, अने चालो आपणु गीबोन ह़ेर ने हरावता; काहाके गीबोन ना रेवा वाळा यहोसु अने ईस्‌रायली ह़ाते मेळ कर लेदला से।” <verse eid="JOS 10:4" /><verse number="5" style="v" sid="JOS 10:5" />करीन यरुसलेम, हेब्‌रोन, यर्‌मुत, लाकीस, अने एग्‌लोन ना पांचोव एमोरी राजा आह़फा-आह़फाम ना आखा झुमायवा वाळा टोळा एक्‌ठा करीन तीमनी भणीन जी लाग्‌या, अने गीबोन ह़ेर अगळ पड़ावा नाखीन तीमनी ह़ाते झुमायवा करीन चालु कर देदा।<verse eid="JOS 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 10:6" />ता गीबोन ना रेवा वाळा गीलगाल ना पड़ावा मे यहोसुन्‌तां आहयु की मोकल्‌या, “तारा चाकर्‌या भणीन गेथो तारो हात सेटो नी करजे; साटोत अमारीन्‌तां आवीन आमने बचाड़ ले, अने अमारी मदत कर; काहाके बड़ा पोर रेवा वाळा एमोरी ना आखा राजा अमारा वीरोद मे एक्‌ठा हयला से।” <verse eid="JOS 10:6" /><verse number="7" style="v" sid="JOS 10:7" />ता यहोसु आखा टोळा ने अने आखा ताखत वाळा झुमायण्‌या ने ह़ाते लीन गीलगाल गेथो चाल पड़्‌यो। <verse eid="JOS 10:7" /><verse number="8" style="v" sid="JOS 10:8" />अने यहोवा भगवान यहोसु ने केदो, “तीमनी सी ना बीहे, काहाके मे तीमने तारा हात मे कर देदलो से; तीमनी मे गेथो एक अदमी बी तारी अगळ टेकी नी सके।” <verse eid="JOS 10:8" /><verse number="9" style="v" sid="JOS 10:9" />ता यहोसु गीलगाल गेथो रात भर चालीन आयो अने उचकालेत तीमनी पोर हमलो कर देदो। <verse eid="JOS 10:9" /><verse number="10" style="v" sid="JOS 10:10" />ता यहोवा भगवान आसम कर्‌यो के तीहया ईस्‌रायल ना माणहु ने देखीन घबराय ज्‌या, अने ईस्‌रायल ना माणहु तीमने गीबोन ह़ेर मे घणा ठोक्‌या, अने बेथोरोन ना चड़ाव पोर तीमनी पसळ जाय्‌न अजेका अने मक्‌केदा तक तीमने ठोकता ज्‌या। <verse eid="JOS 10:10" /><verse number="11" style="v" sid="JOS 10:11" />अळतेण जत्‌यार तीहया ईस्‌रायल ना माणहु नी अगळ गेथा नाहीन बेथोरोन ना उतार पोर आया, ता अजेका पुगते तक यहोवा भगवान तीमनी पोर वादळा मे गेथा मोट्‌ला-मोट्‌ला गारा पाड़्‌यो, अने तीहया मर ज्‌या; जे गारा सी मरला माणहु ईस्‌रायल ना माणहु नी तलवार सी मारला तीमनी गेथा जादा हता।<verse eid="JOS 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JOS 10:12" />तीहयी टेमे, मतलब जे दाड़े यहोवा भगवान एमोरीयो ने ईस्‌रायलीम ना हक मे कर देदो, तीहया दाड़े यहोसु यहोवा भगवान ने ईस्‌रायल ना माणहु नी देखणते आहयी रीते केदो, “ए दाड़ु, तु गीबोन पोर, अने ए चांद, तु अय्‌यालोन नी घाटी पोर उबो री रे।” <verse eid="JOS 10:12" /><verse number="13" style="v" sid="JOS 10:13" />अने दाड़ु तीहयी टेमे तक उबु री र्‌यु, अने चांद तीहयी टेमे तक उबो हय र्‌यो, जत्‌यार तक तीहयी जाती ना माणहु तीना वेरी ह़ाते बदलो नी ली लेदा। ह़ु आहयी वात यासार नाम नी कीताप मे नी लीखली हय के दाड़ु वादळु नी वचा-वच उबु री ज्‌यु, अने तीहयु आखी दाड़ो तक नी डुब्‌यु?<note caller="+" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="2SA 1:18">2 समुवेल 1:18</ref></char></note> <verse eid="JOS 10:13" /><verse number="14" style="v" sid="JOS 10:14" />नी ते ईनी गेथो पेले आवो दाड़ो आयो अने नी आनीन अळतेण, जीनी मे यहोवा भगवान काना माणेह नी वात ह़मळ्‌यो हय; काहाके यहोवा ते ईस्‌रायल ना माणहु नी भणी गेथो झुमायतो हतो।<verse eid="JOS 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 10:15" />ता यहोसु आखा ईस्‌रायल ना माणहु भेळ गीलगाल ना पड़ावा मे पासो जत र्‌यो।<verse eid="JOS 10:15" /></para>
  <para style="s">यहोसु नु एमोरी ना पांचोव राजा ने धरीन लावणु</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 10:16" />तीहया पांचोव राजा नाहीन मक्‌केदान्‌तां वाळा दोर मे जाय्‌न ह़ताय ज्‌या। <verse eid="JOS 10:16" /><verse number="17" style="v" sid="JOS 10:17" />ता यहोसु ने आहयी खबर जड़ी, “पांचोव राजा मक्‌केदान्‌तां वाळा दोर मे ह़ताय रेला आमने जड़ला से।” <verse eid="JOS 10:17" /><verse number="18" style="v" sid="JOS 10:18" />यहोसु केदो, “दोर ना मोडा पोर मोट्‌ला-मोट्‌ला दगड़ा गबड़ाय्‌न तीमनी देख-रेख करवा करीन थोड़ाक माणहु ने तां बहाड़ देवो; <verse eid="JOS 10:18" /><verse number="19" style="v" sid="JOS 10:19" />पण तमु ना रेवो, तमारा वेरीम नी पसळ जाय्‌न तीमनी मे गेथा जे पसळ री जेला से तीमने मार देवो, तीमने तीमना ह़ेर मे जवा नो मोखो ना आपो; काहाके तमारो भगवान यहोवा तीमने तमारा हात मे ह़ोप नाखलो से।” <verse eid="JOS 10:19" /><verse number="20" style="v" sid="JOS 10:20" />जत्‌यार यहोसु अने ईस्‌रायल ना माणहु तीमने मारीन खत्‌तम कर देदा, अने तीमनी मे गेथा जे बच जेला तीहया आह़फा-आह़फाम ना कीला वाळा ह़ेर मे भराय ज्‌या, <verse eid="JOS 10:20" /><verse number="21" style="v" sid="JOS 10:21" />ता आखा माणहु मक्‌केदा ना पड़ावा मे यहोसुन्‌तां पासा वारला आवती‌ र्‌या; अने ईस्‌रायल ना माणहु ना वीरोद मे कोय बी एक सब्‌द तक नी बोल्‌या।<verse eid="JOS 10:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JOS 10:22" />ता यहोसु हुकम आप्‌यो, “दोर नु मोडु उगाड़ीन तीहया पांचोव राजा ने मारीन्‌तां नीकाळ लावो।” <verse eid="JOS 10:22" /><verse number="23" style="v" sid="JOS 10:23" />तीहया तेमेत कर्‌या, अने यरुसलेम, हेब्‌रोन, यर्‌मुत, लाकीस, अने एग्‌लोन ना तीहया पांचोव राजा ने दोर मे गेथा तीनीन्‌तां नीकाळीन ली आया। <verse eid="JOS 10:23" /><verse number="24" style="v" sid="JOS 10:24" />जत्‌यार तीहया ते राजाम ने यहोसुन्‌तां नीकाळ लाया, ता यहोसु ईस्‌रायल ना आखा अदमी ने बोलावीन आह़फा नी ह़ाते चालवा वाळा झुमायवा वाळा ना मुख्‌या ने केदो, “ह़ाते जाय्‌न आह़फा-आह़फाम ना पोग आहया राजाम ना बोचा मे मेको।” अने तीहया ह़ाते जाय्‌न आह़फा-आह़फाम ना पोगु तीमना बोचा मे मेक्‌या। <verse eid="JOS 10:24" /><verse number="25" style="v" sid="JOS 10:25" />ता यहोसु तीमने केदो, “बीहो ना, अने तमारु मन काचु ना करो; हीम्‌मत राखीन वातड़ा रेवो; काहाके यहोवा तमारा आखा वेरी ह़ाते जीमनी ह़ाते तमु झुमायवा वाळा से आसमेत करहे।” <verse eid="JOS 10:25" /><verse number="26" style="v" sid="JOS 10:26" />आनीन अळतेण यहोसु तीमने मराय नाख्‌यो, अने पांच झाड़का पोर टांग देदो। अने तीहया ह़ांता तक झाड़का पोर टंगायला र्‌या। <verse eid="JOS 10:26" /><verse number="27" style="v" sid="JOS 10:27" />दाहड़ु बुडते-बुडते यहोसु पांह गेथो हुकम मांगीन माणहु तीमने झाड़का पोर गेथा उतारीन तीहयात दोर मे जां तीहया ह़ताय जेला हता घाल देदा, अने तीहया दोर ना मोडा पोर मोट्‌ला-मोट्‌ला दगड़ा मेक देदा, तीहया आज तक तांत मेकला से।<verse eid="JOS 10:27" /></para>
  <para style="s">यहोसु नी अळी जादा एमोरी राज्‌य पोर जीक</para>
  <para style="p">
    <verse number="28" style="v" sid="JOS 10:28" />तीहयात दाड़े यहोसु मक्‌केदा ह़ेर ने हराय नाख्‌यो, अने तीनी मे रेवा वाळा ने अने तीना राजा ने खत्‌तम कर देदो; अने जेतरा जीव तीनी मे हता तीमनी मे गेथा कोय ने बी जीवत्‌ला नी सोड़्‌यो; अने जेम तीहयो यरीहो ना राजा ह़ाते करलो तेमेत मक्‌केदा ना राजा ह़ाते बी कर्‌यो।<verse eid="JOS 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 10:29" />ता यहोसु आखा ईस्‌रायली माणहु भेळ मक्‌केदा गेथो चालीन लीब्‌ना ह़ेर भणी ज्‌यो, अने लीब्‌ना ह़ेर वाळा ह़ाते झुमायो; <verse eid="JOS 10:29" /><verse number="30" style="v" sid="JOS 10:30" />अने यहोवा लीब्‌ना ह़ेर ने बी राजा भेळ ईस्‌रायल ना माणहु ना हात मे कर देदो; अने यहोसु तीहयु ह़ेर ने अने तीनी मे ना आखा जीव ने तलवार वेर मार्‌यो; अने एक ने बी जीवत्‌लु नी सोड़्‌यो; अने तीना राजा ह़ाते तेमेत कर्‌यो जेम तीहयो यरीहो ना राजा ह़ाते करलो।<verse eid="JOS 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 10:31" />अळतेण यहोसु आखा ईस्‌रायल ना माणहु भेळ लीब्‌ना गेथो चालीन लाकीस ह़ेर ज्‌यो, अने तीना वीरोद मे पड़ावा नाखीन झुमायो; <verse eid="JOS 10:31" /><verse number="32" style="v" sid="JOS 10:32" />अने यहोवा भगवान लाकीस ह़ेर ने ईस्‌रायल ना हक मे कर देदो, अने बीजा दाड़े तीहयु ह़ेर यहोसु जीक लेदो; अने जेम तीहयो लीब्‌ना ना आखा जीव ने तलवार वेर मारलो हतो तेमेत तीहयो लाकीस ह़ेर वाळा ह़ाते बी कर्‌यो।<verse eid="JOS 10:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 10:33" />ता गेजेर ह़ेर नो राजो होराम लाकीस ह़ेर वाळा नी मदत करवा करीन आय लाग्‌यो; अने यहोसु तीना माणहु भेळ तीने बी आसम मार्‌यो के तीनी जुगु कोय ने जीवत्‌लो नी छोड़्‌यो।<verse eid="JOS 10:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="JOS 10:34" />अळतेण यहोसु आखा ईस्‌रायल ना माणहु भेळ लाकीस ह़ेर गेथो जाय्‌न एग्‌लोन ह़ेर ज्‌यो; अने तीना वीरोद मे पड़ावा नाखीन झुमायवा बाज ज्‌यो; <verse eid="JOS 10:34" /><verse number="35" style="v" sid="JOS 10:35" />अने तीहयात दाड़े तीहयो ते ह़ेर ने हक मे कर लेदा, अने तीनी मे रेवा वाळा ने तलवार वेर मार्‌यो; अने तीहयात दाड़े जेम तीहयो लाकीस ना आखा जीव ने खत्‌तम कर देदलो हतो तेमेत तीहयो एग्‌लोन ना रेवा वाळा ह़ाते बी कर्‌यो।<verse eid="JOS 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="JOS 10:36" />अने यहोसु आखा ईस्‌रायल ना माणहु भेळ एग्‌लोन गेथो चालीन हेब्‌रोन ह़ेर ज्‌यो, अने तीहया ह़ेर वाळा ह़ाते झुमायवा बाज ज्‌यो; <verse eid="JOS 10:36" /><verse number="37" style="v" sid="JOS 10:37" />अने तीहया तीहयु ह़ेर ने हक मे कर लेदा, अने तीहयु ह़ेर ने अने तीना आखा राजा ने अने आखा गामु ने तीमनी मे गेथा आखा जीव ने तलवार वेर मार नाख्‌यो; जेम यहोसु एग्‌लोन वाळा ह़ाते कर्‌यो तेमेत तीहयो हेब्‌रोन मे बी कोय ने जीवत्‌ला नी रेवा देदो; तीहयो ह़ेर ने अने तीनी मे ना आखा जीव ने खत्‌तम कर देदो।<verse eid="JOS 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="JOS 10:38" />ता यहोसु आखा ईस्‌रायल ना माणहु भेळ फीरीन दबीर ह़ेर मे ज्‌यो, अने तीमनी ह़ाते झुमायवा बाज ज्‌यो; <verse eid="JOS 10:38" /><verse number="39" style="v" sid="JOS 10:39" />अने राजा भेळ तीने अने तीना आखा गाम ने हक मे कर लेदो; अने तीहया तीमने तलवार वेर मार्‌यो, अने जेतरा जीव ह़ेर मे हता तीमने आखा ने खत्‌तम कर देदो; कोय ने बी जीवत्‌ला नी छोड़्‌यो, जेम यहोसु हेब्‌रोन अने लीब्‌ना अने तीना राजा ह़ाते करलो हतो तेमेत तीहयो दबीर अने तीना राजा ह़ाते बी कर्‌यो।<verse eid="JOS 10:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 10:40" />आहयीत रीते यहोसु तीहया आखा देस ने, मतलब बड़ा मे वाळु देस, दखणाव देस, हेट्‌लु देस, चवगान मेना देस ने, तीमना आखा राजा भेळ मार्‌यो; अने ईस्‌रायल ना भगवान यहोवा ना हुकम नी अनसारे कोय ने बी जीवत्‌ला नी छोड़्‌यो, अने जेतरा जीव हता आखा ने खत्‌तम कर देदो। <verse eid="JOS 10:40" /><verse number="41" style="v" sid="JOS 10:41" />अने यहोसु कादेसबर्‌ने ह़ेर गेथो गाजा तक, अने गीबोन तक ना आखा गोसेन देस ना आखा माणहु ने मार्‌यो। <verse eid="JOS 10:41" /><verse number="42" style="v" sid="JOS 10:42" />आहया आखा राजा ने तीमना देस भेळ यहोसु एकीत टेम मे हक मे कर लेदो, काहाके ईस्‌रायल नो भगवान यहोवा ईस्‌रायल ना माणहु भणी गेथो झुमायतो हतो। <verse eid="JOS 10:42" /><verse number="43" style="v" sid="JOS 10:43" />ता यहोसु आखा ईस्‌रायल ना माणहु भेळ गीलगाल ना पड़ावा मे पासो आवती र्‌यो।<verse eid="JOS 10:43" /></para>
  <chapter eid="JOS 10" />
  <chapter number="11" style="c" sid="JOS 11" />
  <para style="s">यहोसु याबीन राजा अने तीना मदत करन्‌या अलाज ने हरावे</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 11:1" />आहयु ह़मळीन हासोर नो राजो याबीन मादोन ना राजा योबाब, अने सीम्‌रोन अने अक्‌साप ना राजा ने, <verse eid="JOS 11:1" /><verse number="2" style="v" sid="JOS 11:2" />अने जे-जे राजा धुराव भणी बड़ा वाळा देस मे, अने कीन्‌नेरेत नी दखणाव भणी ना अराबा मे, अने हेट्‌ला देस मे, अने बुडवणी ह़ोड़ दोर ह़ेर ना उचा देस मे रेता हता, तीमने, <verse eid="JOS 11:2" /><verse number="3" style="v" sid="JOS 11:3" />अने उगण-बुडण बेम ह़ोड़ रेवा वाळा कनानी, अने एमोरी, हीत्‌ती, परीज्‌जी, अने बड़ा मे वाळा यबुसी, अने मीस्‌पा देस मे हेर्‌मोन बड़ान हेटा रेवा वाळा हीब्‌बीम ने बोलावो मोकल्‌यो। <verse eid="JOS 11:3" /><verse number="4" style="v" sid="JOS 11:4" />अने तीहया आह़फा-आह़फाम नी सेना भेळ, जे दर्‌या नी काठे नु बालु रेवतु ह़रकी घणी ढेरकी हती, मेळीन नीकळ आया, अने तीमनी ह़ाते घणा ढेरका घोड़ा अने घोड़ागाड्‌या बी हता। <verse eid="JOS 11:4" /><verse number="5" style="v" sid="JOS 11:5" />ता तीहया आखा राजा ह़ला लीन एक्‌ठा हया, अने ईस्‌रायलीम नी ह़ाते झुमायवा करीन मेरोम नाम ना तळाव ने तां पुग्‌या अने तीहया एक्‌ठा पड़ावो नाख्‌या।<verse eid="JOS 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 11:6" />ता यहोवा यहोसु ने केदो, “तीमने देखीन ना बीहे, काहाके वाहणे आहयीत टेमे तीहया आखा ने ईस्‌रायली माणहु ना हक मे करीन मराय नाखही; ता तु तीमना घोड़ा ना मांडा नी नेह ने तोड़ावजे अने तीमना घोड़ा-गाड़्‌या ने धपाड़ देजे।” <verse eid="JOS 11:6" /><verse number="7" style="v" sid="JOS 11:7" />अने यहोसु आखा झुमायण्‌या भेळ मेरोम नाम ना तळाव ने तां उचकालेत पुगीन तीमनी ह़ाते झुमाय पड़्‌यो। <verse eid="JOS 11:7" /><verse number="8" style="v" sid="JOS 11:8" />अने यहोवा भगवान तीमने ईस्‌रायलीम ना हक मे कर देदो, एतरे तीहया तीमने मार नाख्‌या, अने मोट्‌लु ह़ेर सीदोन अने मीस्‌रपोतमेम तक, अने उगवणी ह़ोड़ मीस्‌पे मेदान तक तीमनी पसळ ज्‌या; अने तीमने मार्‌या, अने तीमनी मे गेथा कोय ने बी जीवत्‌ला नी छोड़्‌या। <verse eid="JOS 11:8" /><verse number="9" style="v" sid="JOS 11:9" />ता यहोसु यहोवा भगवान ना हुकम नी अनसारे तीमनी ह़ाते कर्‌यो, मतलब तीमना घोड़ा ना मांडा नी नेह तोड़ायो, अने तीमना घोड़ागाड्‌या आक्‌ठु मे धपाड़ देदा।<verse eid="JOS 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 11:10" />तीहयी टेमे यहोसु पासो जाय्‌न हासोर ह़ेर ने जे पेले तीहया आखा राज्‌य मे मुख्‌यु हतु हक मे कर लेदो, अने तीहया ह़ेर ना राजा ने तलवार वेर मार नाख्‌यो। <verse eid="JOS 11:10" /><verse number="11" style="v" sid="JOS 11:11" />अने जेतरा जीव तीनी मे हता तीमने आखा ने तीहया तलवार वेर मारीन खत्‌तम कर्‌या; अने काना बी जीव ने जीवत्‌लु नी छोड़्‌या, अने हासोर ह़ेर ने यहोसु आक्‌ठु वेर धपाड़ नाख्‌यो। <verse eid="JOS 11:11" /><verse number="12" style="v" sid="JOS 11:12" />अने तीहया आखा ह़ेर ने तीमना आखा राजा भेळ यहोसु हक मे कर लेदो, अने यहोवा भगवान ना चाकर्‌या मुसा ना हुकम नी अनसारे तीमने तलवार वेर मारीन खत्‌तम कर नाख्‌यो। <verse eid="JOS 11:12" /><verse number="13" style="v" sid="JOS 11:13" />पण हासोर ह़ेर, जीने यहोसु धपाड़ देदलो, तीने छोड़ीन ईस्‌रायली अळी बीजा काना ह़ेर ने नी धपाड़्‌या जे टेकड़ा पोर वह़ला हता। <verse eid="JOS 11:13" /><verse number="14" style="v" sid="JOS 11:14" />अने आहया ह़ेर ना जानवरु अने आमनी मे नु धन-दवल्‌यत ईस्‌रायली माणहु आह़फाम नी जुगु लुट लेदा; पण माणहु ने तीहया तलवार वेर मार नाख्‌या, आञे तक तीमने खत्‌तम कर नाख्‌या के एक बी जीव ने जीवत्‌ला नी रेवा देदा। <verse eid="JOS 11:14" /><verse number="15" style="v" sid="JOS 11:15" />जे हुकम यहोवा तीना चाकर्‌या मुसा ने आपलो हतो तीनीत अनसारे मुसो यहोसु ने हुकम आपलो हतो, अने तेमेत यहोसु कर्‌यो बी; जे-जे हुकम यहोवा मुसा ने आपलो हतो तीमनी मे गेथो कानो बी हुकम यहोसु पुरो कर्‌या वगर नी छोड़्‌यो।<verse eid="JOS 11:15" /></para>
  <para style="s">यहोसु नी लारे जीकला देस</para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 11:16" />ता यहोसु तीहया आखा देस ने, मतलब बड़ा मे वाळु देस, दखणाव भणी ना देस, अने आखु गोसेन देस, अने हेट्‌ला देस, अराबा, अने ईस्‌रायल ना बड़ा मे वाळा देस, अने तीना हेट्‌ला देस ने, <verse eid="JOS 11:16" /><verse number="17" style="v" sid="JOS 11:17" />हालाक नाम ना बड़ा गेथा लगाड़ीन, जे सेईर ना चड़ाव पोर से, बालगाद तक, जे लबानोन ना मयदान मे हेर्‌मोन बड़ान हेटु से, जेतरा देस से तीमने जीक लेदा अने तीहया आखा देस ना पुरा राजाम ने धरीन मार नाख्‌या। <verse eid="JOS 11:17" /><verse number="18" style="v" sid="JOS 11:18" />तीहया आखा राजा ह़ाते झुमाते-झुमाते यहोसु ने घणा दाड़ा लाग ज्‌या। <verse eid="JOS 11:18" /><verse number="19" style="v" sid="JOS 11:19" />गीबोन ना रेवा वाळा हीब्‌बी ने छोड़ीन बीजा काना बी ह़ेर ना माणहु ईस्‌रायली माणहु ह़ाते मेळ नी कर्‌या; अने आखा ह़ेर ने तीहया झुमाय-झुमाय्‌न जीक लेदा। <verse eid="JOS 11:19" /><verse number="20" style="v" sid="JOS 11:20" />काहाके यहोवा भगवान नी जे हेर हती, के आह़फा ना तीहया हुकम नी अनसारे जे तीहयो मुसा ने आपलो तीमनी पोर कंय बी दया नी करे, अने तीमने खत्‌तम कर देय,<note caller="+" style="x"><char style="xo" closed="false">11:20 </char><char style="xt" closed="false"><ref loc="DEU 7:16">वेवस्‌थावीवरन 7:16</ref></char></note> करीन तीहयो तीमना मन ने एतरु काठु कर देदो, के तीहया ईस्‌रायली ह़ाते झगड़ो कर्‌या। <verse eid="JOS 11:20" /><verse number="21" style="v" sid="JOS 11:21" />तीहयी टेमे यहोसु बड़ा वाळा देस मे आवीन हेब्‌रोन, दबीर, अनाब, अने यहुदा अने ईस्‌रायल बेम देस ना बड़ा मे वाळा देस मे रेवा वाळा ने अनाकी माणहु ने खत्‌तम कर देदो; यहोसु ह़ेर भेळ तीमने खत्‌तम कर देदो। <verse eid="JOS 11:21" /><verse number="22" style="v" sid="JOS 11:22" />ईस्‌रायल ना देस मे कोय बी अनाकी माणेह नी र्‌यु; गाजा, गत, अने असदोद मे एतरात कोय-कोय री ज्‌या। <verse eid="JOS 11:22" /><verse number="23" style="v" sid="JOS 11:23" />जेम यहोवा भगवान मुसा ने केदलो, तेमेत यहोसु तीहया आखा देस ने हक मे कर लेदो; अने तीमने ईस्‌रायल नी जाती अने घोराणा नी अनसारे वाटीन तीमने आप देदो। अने देस ने झुमायवा सी सांती जड़ी।<verse eid="JOS 11:23" /></para>
  <chapter eid="JOS 11" />
  <chapter number="12" style="c" sid="JOS 12" />
  <para style="s">मुसा नी लारे हरावला राजा</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 12:1" />यरदन नंदीन पार उगवणी ह़ोड़, मतलब अर्‌नोन घाटी गेथा लगाड़ीन हेर्‌मोन बड़ा तक ना देस, अने आखा उगवणी ह़ोड़ ना अराबा ना जे राजाम ने ईस्‌रायली माणहु मारीन तीमना देस ने आह़फाम ना हक मे कर लेदला हता तीहया आहया से:<note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">गीनती 21:21-35</ref>; <ref loc="DEU 2:26">वेवस्‌थावीवरन 2:26</ref>; <ref loc="DEU 3:11">3:11</ref></char></note> <verse eid="JOS 12:1" /><verse number="2" style="v" sid="JOS 12:2" />एमोरी जाती वाळा नो हेसबोन ह़ेर मे रेवा वाळो राजो सीहोन, जे अर्‌नोन घाटीन धेड़े वाळु अरोयर गेथो लगाड़ीन, अने तीहयीत घाटी ना वचे वाळा ह़ेर ने छोड़ीन यब्‌बोक नंदी तक, जे अम्‌मोनीयो नी काकड़ से, आदा गीलाद पोर,<note caller="+" style="f"><char style="fr" closed="false">12:2 </char><char style="ft" closed="false">आहयु गाम आदा गीलाद नी बराबर हतु।</char></note> <verse eid="JOS 12:2" /><verse number="3" style="v" sid="JOS 12:3" />अने कीन्‌नेरेत नाम ना तळाव गेथो लगाड़ीन बेत्‌यसीमोत माय्‌न अराबा ना तळाव तक; जे खारलो तळाव बी केवाये, अने उगवणी ह़ोड़ ना अराबा, दखणाव भणी पीसगा नी ढाळ नी हेट्‌ला-हेट्‌ला देस पोर हक राखता हता। <verse eid="JOS 12:3" /><verse number="4" style="v" sid="JOS 12:4" />अळतेण बचला रपाई जाती मे गेथा बासान ना राजा ओग नु देस हतु, अस्‌तारोत अने एद्‌रेई मे रीया करतो हतो, <verse eid="JOS 12:4" /><verse number="5" style="v" sid="JOS 12:5" />अने हेर्‌मोन बड़ो, सलका, अने गसुरीयो, अने माकीयो नी काकड़ तक आखा बासान मे, अने हेसबोन ना राजा सीहोन नी काकड़ तक आदा गीलाद मे बी राज करतो हतो। <verse eid="JOS 12:5" /><verse number="6" style="v" sid="JOS 12:6" />ईस्‌रायली अने यहोवा भगवान नो चाकर्‌यो मुसो तीमने हराय नाख्‌या; अने यहोवा नो चाकर्‌यो मुसो आमनु देस रुबेनी अने गादीयो अने मनस्‌से नी आदी जाती ना माणहु ने हक मे आप देदो।<note caller="+" style="x"><char style="xo" closed="false">12:6 </char><char style="xt" closed="false"><ref loc="NUM 32:33">गीनती 32:33</ref>; <ref loc="DEU 3:12">वेवस्‌थावीवरन 3:12</ref></char></note><verse eid="JOS 12:6" /></para>
  <para style="s">यहोसु नी लारे हरावला राजा</para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 12:7" />यरदन नंदी नी बुडणली ह़ोड़, लबानोन ना मेदान मे ना बालगाद ह़ेर सी लगाड़ीन सेईर ना चड़ाव ना हालाक बड़ा तक ना देस ना जे राजा मे यहोसु अने ईस्‌रायली मारीन तीमना देस ईस्‌रायलीम ने जाती अने घोराणा नी अनसारे वाटो पाड़ीन हक मे आप देदलो हतो तीहया आहया से: <verse eid="JOS 12:7" /><verse number="8" style="v" sid="JOS 12:8" />हीत्‌ती, अने एमोरी, अने कनानी, अने परीज्‌जी, अने हीब्‌बी, अने यबुसी, जे बड़ा वाळा देस मे, अने हेट्‌ला देस मे, अने अराबा मे, अने ढालु देस मे, अने जंगल मे, अने दखणाव देस मे रेता हता। <verse eid="JOS 12:8" /><verse number="9" style="v" sid="JOS 12:9" />एक, यरीहो नो राजो; अने एक, बेतेल नी ह़ाते नो ए ह़ेर नो राजो; <verse eid="JOS 12:9" /><verse number="10" style="v" sid="JOS 12:10" />एक, यरुसलेम नो राजो; एक, हेब्‌रोन नो राजो; <verse eid="JOS 12:10" /><verse number="11" style="v" sid="JOS 12:11" />एक यर्‌मुत नो राजो; एक, लाकीस नो राजो; <verse eid="JOS 12:11" /><verse number="12" style="v" sid="JOS 12:12" />एक, एग्‌लोन नो राजो; एक, गेजेर नो राजो; <verse eid="JOS 12:12" /><verse number="13" style="v" sid="JOS 12:13" />एक, दबीर नो राजो; एक, गेदेर नो राजो; <verse eid="JOS 12:13" /><verse number="14" style="v" sid="JOS 12:14" />एक, होर्‌मा नो राजो; एक, अराद नो राजो; <verse eid="JOS 12:14" /><verse number="15" style="v" sid="JOS 12:15" />एक, लीब्‌ना नो राजो; एक, अदुल्‌लाम नो राजो; <verse eid="JOS 12:15" /><verse number="16" style="v" sid="JOS 12:16" />एक, मक्‌केदा नो राजो; एक, बेतेल नो राजो; <verse eid="JOS 12:16" /><verse number="17" style="v" sid="JOS 12:17" />एक, तप्‌पुह नो राजो; एक हेपेर नो राजो; <verse eid="JOS 12:17" /><verse number="18" style="v" sid="JOS 12:18" />एक, अपेक नो राजो; एक, लस्‌सारोन नो राजो; <verse eid="JOS 12:18" /><verse number="19" style="v" sid="JOS 12:19" />एक, मादोन नो राजो; एक, हासोर नो राजो; <verse eid="JOS 12:19" /><verse number="20" style="v" sid="JOS 12:20" />एक, सीम्‌रोन्‌मरोन नो राजो; एक, अक्‌साप नो राजो; <verse eid="JOS 12:20" /><verse number="21" style="v" sid="JOS 12:21" />एक, तानाक नो राजो; एक, मगीद्‌दो नो राजो; <verse eid="JOS 12:21" /><verse number="22" style="v" sid="JOS 12:22" />एक, केदेस नो राजो; एक, कार्‌मेल मे ना योकनाम नो राजो; <verse eid="JOS 12:22" /><verse number="23" style="v" sid="JOS 12:23" />एक, दोर नाम ना उचा देस मे ना दोर नो राजो; एक, गीलगाल मे ना गोयीम नो राजो; <verse eid="JOS 12:23" /><verse number="24" style="v" sid="JOS 12:24" />अने एक, तीर्‌सा नो राजो से, आहयी रीते आखा हय्‌न एकतीस राजा हया।<verse eid="JOS 12:24" /></para>
  <chapter eid="JOS 12" />
  <chapter number="13" style="c" sid="JOS 13" />
  <para style="s">जागा अळी बी लेवा नी से</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 13:1" />यहोसु डायो अने घणो उमर नो हय जेलो हतो; अने यहोवा भगवान तीने केदो, “तु डायो अने घणी उमर नो हय जेलो से, अने घणा देस री जेला से, जे ईस्‌रायल ना हक मे हजु तक नी हया। <verse eid="JOS 13:1" /><verse number="2" style="v" sid="JOS 13:2" />आहया देस री जेला से, मतलब पलीस्‌ती जाती नु आखु देस, अने आखी गसुरी जाती नु देस, <verse eid="JOS 13:2" /><verse number="3" style="v" sid="JOS 13:3" />मीस्‌र मे गेथु अगु सीहोर गेथु लगाड़ीन धुराव भणी एक्‌रोन नी काकड़ तक जे कनानीम नो वाटो गणाय; अने पलीस्‌तीम ना पांचोव मुख्‌या, मतलब गाजा, असदोद, असकलोन, गत, अने एक्‌रोन ना माणहु, अने दखणाव भणी अव्‌वी जाती नु देस, <verse eid="JOS 13:3" /><verse number="4" style="v" sid="JOS 13:4" />अळतेण अपेक अने एमोरी नी काकड़ तक कनानीम नु आखु देस, अने सीदोनी नु मारा नाम नु देस, <verse eid="JOS 13:4" /><verse number="5" style="v" sid="JOS 13:5" />अळतेण गबालीयो नु देस, अने उगवणी भणीन हेर्‌मोन बड़ान हेट्‌ला बालगाद सी लगाड़ीन हमात नी घाटी तक आखु लबानोन नु देस, <verse eid="JOS 13:5" /><verse number="6" style="v" sid="JOS 13:6" />अळतेण लबानोन देस सी लगाड़ीन मीस्‌रपोतमेम तक सीदोनीयोम ना बड़ा मे वाळा देस ना रेवा वाळा। आमने मे ईस्‌रायलीम नी अगळ गेथा नीकाळ देही; आतरु हयवा जोवे के तु मारा हुकम नी अनसारे चीट्‌ठी नाखी-नाखीन तीमनु देस ईस्‌रायल ने वाट देय।<note caller="+" style="x"><char style="xo" closed="false">13:6 </char><char style="xt" closed="false"><ref loc="NUM 33:54">गीनती 33:54</ref></char></note> <verse eid="JOS 13:6" /><verse number="7" style="v" sid="JOS 13:7" />करीन तु हाव आहया देस ने नव जाती अने मनस्‌से नी आदी जाती ने वाट दे के तीहयो तीमनो वाटो हय जाय।”<verse eid="JOS 13:7" /></para>
  <para style="s">यरदन नंदीन उगवणी ह़ोड़ ना जागा नु वाटणु</para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 13:8" />रुबेनी अने गाद माणहु ने ते तीहयो वाटो जड़ जेलो हतो, जीने मुसो तीमने यरदन नंदीन उगवणी ह़ोड़ आपलो हतो, काहाके यहोवा नो चाकर्‌यो मुसो आहयु ईमनेत आपलो हतो, <verse eid="JOS 13:8" /><verse number="9" style="v" sid="JOS 13:9" />मतलब अर्‌नोन नाम नी घाटी नी कोरे ना अरोयर ह़ेर सी लगाड़ीन, अने तीहयी घाटी ना वचे वाळा ह़ेर ने छोड़ीन दीबोन तक मेदबान्‌तां वाळु आखु चोगान वाळु देस; <verse eid="JOS 13:9" /><verse number="10" style="v" sid="JOS 13:10" />अने अम्‌मोनीयो नी काकड़ तक हेसबोन मे राज करवा वाळा एमोरी ना राजा सीहोन नु आखु ह़ेर; <verse eid="JOS 13:10" /><verse number="11" style="v" sid="JOS 13:11" />अने गीलाद देस, अने गसुरी अने माका मे रेवा वाळा नी काकड़, अने आखो हेर्‌मोन बड़ो, अने सलका ह़ेर तक आखु बासान देस, <verse eid="JOS 13:11" /><verse number="12" style="v" sid="JOS 13:12" />अळतेण अस्‌तारोत अने एद्‌रेई मे राज करवा वाळा तीहयु ओग नु आखु राज्‌य जे रपाईयो मे गेथु एखलु बच जेलु हतु; काहाके आमनेत मारीन मुसो ईमना माणहु ने तीहया देस मे गेथा नीकाळ देदलो हतो। <verse eid="JOS 13:12" /><verse number="13" style="v" sid="JOS 13:13" />पण ईस्‌रायली माणहु गसुरी अने माकी जाती ने तीमना देस मे गेथो नी नीकाळ्‌यो; एतरे गसुरी अने माकी ईस्‌रायलीम नी वचमे आज तक री र्‌या। <verse eid="JOS 13:13" /><verse number="14" style="v" sid="JOS 13:14" />अने लेवीम नी जाती ने तीहयो कानो बी वाटो नी आप्‌यो; काहाके ईस्‌रायली ना भगवान यहोवा ना बोल नी अनसारे तीनात हवन मे चड़ावलु तीमनी जुगु वाटो ठेरलु से।<note caller="+" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DEU 18:1">वेवस्‌थावीवरन 18:1</ref></char></note><verse eid="JOS 13:14" /></para>
  <para style="s">रुबेन नी जाती ने आपलो वाटो</para>
  <para style="p">
    <verse number="15" style="v" sid="JOS 13:15" />मुसो जागा नो वाटो रुबेन नी जाती ना घोराणा ने तीमना बाह ना वाटा ना रुप मे आप्‌यो, <verse eid="JOS 13:15" /><verse number="16" style="v" sid="JOS 13:16" />मतलब अर्‌नोन नाम नी घाटी नी कोरे ना अरोयर ह़ेर गेथु लगाड़ीन अने तीहयीत घाटी ना वचे ना ह़ेर ने छोड़ीन मेदबान्‌तां नु आखु चोवगान वाळु देस; <verse eid="JOS 13:16" /><verse number="17" style="v" sid="JOS 13:17" />अळतेण चोवगान वाळु देस मे नु हेसबोन ह़ेर अने तीना आखा गाम; अळतेण दीबोन, बामोतबाल, बेतबाल्‌मोन, <verse eid="JOS 13:17" /><verse number="18" style="v" sid="JOS 13:18" />यहसा, कदेमोत, मेपात, <verse eid="JOS 13:18" /><verse number="19" style="v" sid="JOS 13:19" />कीर्‌यातेम, सीबमा, अने घाटी मे ना बड़ा मे वहलु सेरेथस्‌सहर, <verse eid="JOS 13:19" /><verse number="20" style="v" sid="JOS 13:20" />बेतपोर, पीसगा नी ढाळ अने बेत्‌यसीमोत, <verse eid="JOS 13:20" /><verse number="21" style="v" sid="JOS 13:21" />मतलब चोवगान वाळा देस मे वहला हेसबोन ह़ेर मे राज करवा वाळा एमोरी ना तीहया राजा सीहोन ना राज्‌य ना आखा ह़ेर जीमने मुसो हरावलो हतो। मुसो एवी, रेकेम, सुर, हुर, अने रेबा नाम नी मीद्‌यानी जाती ना मुख्‌या ने बी हरावलो हतो जे सीहोन ना ठेरावला मुख्‌या अने तीहयात देस ना रेवा वाळा हता। <verse eid="JOS 13:21" /><verse number="22" style="v" sid="JOS 13:22" />अने ईस्‌रायली तीमना अने मारला नी ह़ाते बोर ना सोरा ने जे भगवान वगे गेथी वात केवा वाळा बीलाम ने बी तलवार वेर मार नाखला। <verse eid="JOS 13:22" /><verse number="23" style="v" sid="JOS 13:23" />अने रुबेनी नी काकड़ यरदन नंदी नी कोर ठेरी। रुबेनी माणहु नो वाटो तीमनी जाती नी अनसारे ह़ेर अने गाम भेळ आहयोत ठेर्‌यो।<verse eid="JOS 13:23" /></para>
  <para style="s">गाद ना घोराणा ने आपलो वाटो</para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 13:24" />अळतेण मुसो गाद नी जाती ने तीमना घोराणा नी अनसारे तीमना बाह ना वाटा ना रुप मे आप्‌यो। <verse eid="JOS 13:24" /><verse number="25" style="v" sid="JOS 13:25" />ता आहयु ठेर्‌यु, मतलब याजेर अने गीलाद ना आखा ह़ेर, अने रब्‌बा नी अगळ ना अरोएर तक अम्‌मोनीयो नु आदु देस, <verse eid="JOS 13:25" /><verse number="26" style="v" sid="JOS 13:26" />अने हेसबोन सी रामतमीस्‌पे अने बतोनीम तक, अने महनेम सी दबीर नी काकड़ तक, <verse eid="JOS 13:26" /><verse number="27" style="v" sid="JOS 13:27" />अने यरदन नी घाटी मे बेतहारम, बेतनीम्‌रा, सुक्‌कोत, अने सापोन, अने हेसबोन ना राजा सीहोन ना राज्‌य ना बचला वाटा, अने कीन्‌नेरेत नाम ना तळाव ना मुंडे तक, यरदन नंदी नी उगवणी धेड़ नु तीहयु देस जीनी काकड़ यरदन नंदी से। <verse eid="JOS 13:27" /><verse number="28" style="v" sid="JOS 13:28" />गादीयो नो वाटो तीमनी जाती नी अनसारे ह़ेर अने गाम भेळ आहयोत ठेर्‌यो।<verse eid="JOS 13:28" /></para>
  <para style="s">मनस्‌से नी आदी जाती ने आपलो वाटो</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 13:29" />अळतेण मुसो मनस्‌से नी आदी जाती ने तीमना बाह ना वाटा ना रुप मे आप देदो। <verse eid="JOS 13:29" /><verse number="30" style="v" sid="JOS 13:30" />तीहयो आहयो से, मतलब महनेम सी लगाड़ीन बासान ना राजा ओग ना राज्‌य नु आखु देस, अने बासान मे वहला याईर ना साटोव ह़ेर, <verse eid="JOS 13:30" /><verse number="31" style="v" sid="JOS 13:31" />अने गीलाद नो आदो वाटो, अने अस्‌तारोत, अने एद्‌रेई, जे बासान देस मे ओग ना राज्‌य ना ह़ेर हता, आहया मनस्‌से ना सोरा माकीर नी जाती नो, मतलब माकीर नी आदी जाती नो वाटो घोराणा नी अनसारे ठेरे।<verse eid="JOS 13:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 13:32" />जे वाटा मुसो मोवाब ना अराबा मे यरीहोन्‌तां नी यरदन नंदीन उगवणी ह़ोड़ वाट देदो तीहया आहयात से। <verse eid="JOS 13:32" /><verse number="33" style="v" sid="JOS 13:33" />पण लेवी नी जाती ने मुसो कानो बी वाटो नी आप्‌यो; ईस्‌रायल नो भगवान यहोवात आह़फा ना बोलु नी अनसारे तीमनो वाटो ठेर्‌यो।<note caller="+" style="x"><char style="xo" closed="false">13:33 </char><char style="xt" closed="false"><ref loc="NUM 18:20">गीनती 18:20</ref>; <ref loc="DEU 18:2">वेवस्‌थावीवरन 18:2</ref></char></note><verse eid="JOS 13:33" /></para>
  <chapter eid="JOS 13" />
  <chapter number="14" style="c" sid="JOS 14" />
  <para style="s">यरदन नंदीन बुडवणी धेड़ ना वाटा नो वाटो पाड़नु</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 14:1" />जे-जे वाटो ईस्‌रायलीम ने कनान देस मे जड़्‌यो, जीमने एलीयाजार पुंजारो, अने नुन नो सोरो यहोसु, अने ईस्‌रायली जाती ना डायला घोराणा ना मुख्‌या-मुख्‌या अदमी तीमने आपला तीहयो आहयो से। <verse eid="JOS 14:1" /><verse number="2" style="v" sid="JOS 14:2" />जे हुकम यहोवा मुसा नी लारे साड़ी नव जाती जुगु आपलो हतो, तीनी अनसारे तीमनो वाटो चीट्‌ठी नाखी-नाखीन आप्‌या।<note caller="+" style="x"><char style="xo" closed="false">14:2 </char><char style="xt" closed="false"><ref loc="NUM 26:52-56">गीनती 26:52-56</ref>; <ref loc="NUM 34:13">34:13</ref></char></note> <verse eid="JOS 14:2" /><verse number="3" style="v" sid="JOS 14:3" />मुसो ते ढाय जाती नो वाटो यरदन नंदीन पार आपलो; पण लेवीम ने तीहयो तीमनी वचमे कानो बी वाटो नी आप्‌यो। <verse eid="JOS 14:3" /><verse number="4" style="v" sid="JOS 14:4" />युसुफ ना घोराणा नी ते बे जाती हय जेली हती, मतलब मनस्‌से अने एप्‌रेम; अने तीहया देस मे लेवीम ने कंय बी वाटो नी आप्‌या, रेवा जुगु ह़ेर, अने जानवरु अने धन मेकवा जुगु जानवरु चरवा नो जागो जड़्‌यो।<note caller="+" style="x"><char style="xo" closed="false">14:4 </char><char style="xt" closed="false"><ref loc="NUM 32:33">गीनती 32:33</ref>; <ref loc="NUM 34:14">34:14</ref>,<ref loc="NUM 34:15">15</ref>; <ref loc="DEU 3:12-17">वेवस्‌थावीवरन 3:12-17</ref></char></note> <verse eid="JOS 14:4" /><verse number="5" style="v" sid="JOS 14:5" />जे हुकम यहोवा मुसा ने आपलो हतो तीनी अनसारे ईस्‌रायली माणहु कर्‌या; अने तीहया देस ने वाट लेदा।<verse eid="JOS 14:5" /></para>
  <para style="s">हेब्‌रोन ह़ेर कालेब ने आपणु</para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 14:6" />ता यहुदी माणहु यहोसुन्‌तां गीलगाल मे आया; अने कनजी यपुन्‌ने नो सोरो कालेब तीने केदो, “तु जाणतो हहे के यहोवा कादेसबर्‌ने ह़ेर मे मुसा ने मारा अने तारा बारा मे ह़ु केदलो हतो।<note caller="+" style="x"><char style="xo" closed="false">14:6 </char><char style="xt" closed="false"><ref loc="NUM 14:30">गीनती 14:30</ref></char></note> <verse eid="JOS 14:6" /><verse number="7" style="v" sid="JOS 14:7" />जत्‌यार यहोवा नो चाकर्‌यो मुसो मने आहया देस ना बारा मे जानकारी लेवा करीन कादेसबर्‌ने ह़ेर मे गेथो मोकल्‌लो हतो; ता मे चाळीह साल नो हतो; अने मे खरला मन सी तीमनीन्‌तां खबर ली आयो<note caller="+" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="NUM 13:1-30">गीनती 13:1-30</ref></char></note> <verse eid="JOS 14:7" /><verse number="8" style="v" sid="JOS 14:8" />अने मारा ह़ाती जे मारी ह़ाते जेला हता तीहया ते माणहु नु मन ने कमजोर कर देदा, पण मे आपणा भगवान यहोवा नी पुरी रीते वात मान्‌यो। <verse eid="JOS 14:8" /><verse number="9" style="v" sid="JOS 14:9" />ता तीहया दाड़े मुसो ह़ाम खाय्‌न मने केदो, ‘तु पुरी रीते मारा भगवान यहोवा नी वात पोर चाललो से, एतरे कंय बी सण्‌का कर्‌या वगर जे जागा पोर तु तारा पोग मेक आवलो से तीहयो जागो जलमको तारो अने तारी जाती नो रेहे।’<note caller="+" style="x"><char style="xo" closed="false">14:9 </char><char style="xt" closed="false"><ref loc="NUM 14:24">गीनती 14:24</ref></char></note> <verse eid="JOS 14:9" /><verse number="10" style="v" sid="JOS 14:10" />अने हाव देख, जत्‌यार यहोवा भगवान मुसा ने आहयो बोल केदलो हतो तां गेथा पेतालीस साल हय ज्‌या, तीहया दाड़ा मे ईस्‌रायली माणहु जंगल मे फीरता र्‌या; तीहया दाड़ा मे यहोवा तीहयो केदलो तीनी अनसारे मने जीवत्‌लो राखलो से, अने हाव मे पीच्‌यासी साल नो से। <verse eid="JOS 14:10" /><verse number="11" style="v" sid="JOS 14:11" />जेतरी ताखत मुसो मने मोकल्‌लो तीहया दाड़े मारी हती तेतरी ताखत हजु तक मारी मे से; झुमायवा, नीता मोय-बारा आव्‌वा-जवा जुगु जेतरी ताखत तीहयी टेमे मारी मे हती तेतरीत आज बी मारी मे ताखत से। <verse eid="JOS 14:11" /><verse number="12" style="v" sid="JOS 14:12" />एतरे तीहयु बड़ा वाळु देस मने आप दे जीनी वात यहोवा भगवान तीहया दाड़े करलो हतो; तु ते तीहया दाड़े ह़मळ्‌यो हहे के तीनी मे ते अनाक जाती वाळा रेय, अने मोट्‌ला-मोट्‌ला कीला वाळा ह़ेर बी से; पण ह़ु मालम हय सके के यहोवा भगवान मारी ह़ाते रेय, अने तीहयो केदलो तीनी अनसारे मे तीमने तीमना देस मे गेथो नीकाळ देम।” <verse eid="JOS 14:12" /><verse number="13" style="v" sid="JOS 14:13" />ता यहोसु तीमने बरकत आप्‌यो; अने हेब्‌रोन ह़ेर ने यपुन्‌ने ना सोरा कालेब नो वाटो करीन आप देदो। <verse eid="JOS 14:13" /><verse number="14" style="v" sid="JOS 14:14" />करीन हेब्‌रोन ह़ेर कनजी जाती ना यपुन्‌ने ना सोरा कालेब नो वाटो आज तक बणलो से, काहाके तीहयो ईस्‌रायल ना भगवान यहोवा नी सच्‌चाय सी हुकम मान्‌यो। <verse eid="JOS 14:14" /><verse number="15" style="v" sid="JOS 14:15" />पेले हेब्‌रोन ह़ेर नु नाम कीर्‌यतर्‌बा हतु; तीहयो अर्‌बा अनाकी जाती मे आखा गेथो मोटो माणेह हतो। अने तीहया देस ने झगड़ा सी सांती जड़ी।<verse eid="JOS 14:15" /></para>
  <chapter eid="JOS 14" />
  <chapter number="15" style="c" sid="JOS 15" />
  <para style="s">यहुदा नी जाती ने आपलो वाटो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 15:1" />यहुदी माणहु नी जाती नो वाटो तीमना घोराणा नी अनसारे चीट्‌ठी नाखवा सी एदोम नी काकड़ तक, अने दखणाव भणी सीन ना जंगल तक जे दखवरी काकड़ तक से जड़्‌यो। <verse eid="JOS 15:1" /><verse number="2" style="v" sid="JOS 15:2" />तीमना वाटा नी दखणाव नी काकड़ खारली दर्‌या नी काठे गेथी नीकळे। <verse eid="JOS 15:2" /><verse number="3" style="v" sid="JOS 15:3" />अने तीहयी अकरबीम नाम ना चड़ाव नी धुराव भणी गेथी नीकळीन सीन मे हय्‌न कादेसबर्‌ने नी दखणाव भणी जती हती, अळतेण हेस्‌रोन ने तां हतीन अद्‌दार मे हतीन कर्‌का भणीन वळ जी, <verse eid="JOS 15:3" /><verse number="4" style="v" sid="JOS 15:4" />तां गेथी अस्‌मोन हय्‌न तीहयी मीस्‌र ना कोतड़े नीकळी, अने तीहयी काकड़ नी आखरी दर्‌या हती। तमारी दखणाव नी काकड़ आहयीत रेहे। <verse eid="JOS 15:4" /><verse number="5" style="v" sid="JOS 15:5" />अळतेण उगवणी काकड़ यरदन ना मोडे तक खारली दर्‌यात ठे‌री, अने दखणाव भणी नी काकड़ यरदन नंदी ना मोडान्‌तां ना तळाव ना मोडे गेथी सुरु हय्‌न, <verse eid="JOS 15:5" /><verse number="6" style="v" sid="JOS 15:6" />अने तां गेथी बेथोग्‌ला माय्‌न बेतराबा नी दखणाव भणी माय्‌न रुबेनी बोहन नाम ना दगड़ा तक से; <verse eid="JOS 15:6" /><verse number="7" style="v" sid="JOS 15:7" />अने तीहयीत काकड़ आकोर नाम नी घाटी मे गेथी दबीर भणी जत री, अने दखणाव भणी माय्‌न गीलगाल भणीन वळी जे घाटी नी दखणाव भणी अदुम्‌मीम ना चड़ाव नी अगळ से; तां गेथी एनसेमेस नाम ना झोर ने तां माय्‌न एनरोगेल मे खत्‌तम हयी; <verse eid="JOS 15:7" /><verse number="8" style="v" sid="JOS 15:8" />अळतेण तीहयीत काकड़ हीन्‌नोम ना सोरा नी घाटी माय्‌न यबुसी जे यरुसलेम केवाय तीनी दखणाव भणी माय्‌न तीहया बड़ा नी चोट्‌ली पोर पुगी, जे दखणाव नी ह़ोड़ हीन्‌नोम नी घाटी नी अगळ अने रपाईम नी घाटी ना धुराव भणीन ना सींडे से; <verse eid="JOS 15:8" /><verse number="9" style="v" sid="JOS 15:9" />अळतेण तीहयीत काकड़ तीहया बड़ा नी काकड़ गेथी नेप्‌तोह नाम ना झोर ने तां माय्‌न एप्‌रोन बड़ा ना ह़ेर मे हय्‌न नीकळी; अळतेण तां गेथी बाला मे (जे कीर्‌यात्‌यारीम बी केवाय) पुगी; <verse eid="JOS 15:9" /><verse number="10" style="v" sid="JOS 15:10" />अने तीहयी काकड़ बाला गेथी बुडवणी ह़ोड़ वळीन सेईर बड़ा तक पुगी अने यारीम बड़ा (जे कसालोन बी केवाय) तीनी धुराव भणी माय्‌न बेतसेमेस मे जत री, अने तां गेथी तीम्‌ना मे जत री; <verse eid="JOS 15:10" /><verse number="11" style="v" sid="JOS 15:11" />तां गेथी तीहयी काकड़ एक्‌रोन नी धुराव भणी हय्‌न सीक्‌करोन जती हती, अने बाला बड़े हय्‌न यन्‌बेल पोर नीकळी; अने तीहयी काकड़ दर्‌या नी काठे खत्‌तम हयी। <verse eid="JOS 15:11" /><verse number="12" style="v" sid="JOS 15:12" />अने उगवणी नी काकड़ मोट्‌ली दर्‌या नी काठे तक ठेरी। यहुदीम ने जे वाटो तीमना घोराणा नी अनसारे जड़्‌यो तीनी च्‌यारो-मेर नी काकड़ आहयीत हती।<verse eid="JOS 15:12" /></para>
  <para style="s">कालेब नु हेब्‌रोन अने दबीर ने हरावणु</para>
  <para style="r">(<ref loc="JDG 1:11-15">न्‌यायीयो 1:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 15:13" />यपुन्‌ने ना सोरा कालेब ने तीहयो यहोवा भगवान ना हुकम नी अनसारे यहुदीम नी वचमे वाटो आप्‌यो, मतलब कीर्‌यतर्‌बा जे हेब्‌रोन बी केवाय तीहयो अर्‌बा अनाक नो बाह हतो।<note caller="+" style="x"><char style="xo" closed="false">15:13 </char><char style="xt" closed="false"><ref loc="JDG 1:20">न्‌यायीयो 1:20</ref></char></note> <verse eid="JOS 15:13" /><verse number="14" style="v" sid="JOS 15:14" />अने कालेब तां गेथो सेसे, अहीमन, अने तल्‌मे नाम ना अनाक ना तीनोव सोरा ने नीकाळ देदो। <verse eid="JOS 15:14" /><verse number="15" style="v" sid="JOS 15:15" />अने तां गेथो तीहयो दबीर ना रेवा वाळा ह़ाते झुमायो; पेले ते दबीरा नु नाम कीर्‌यत्‌सेपेर हतु। <verse eid="JOS 15:15" /><verse number="16" style="v" sid="JOS 15:16" />अने कालेब केदो, “जे कीर्‌यत्‌सेपेर ह़ेर ने हराय देय तीनी ह़ाते मे मारी सोरी अकसा ना वेवा कर देही।” <verse eid="JOS 15:16" /><verse number="17" style="v" sid="JOS 15:17" />ता कालेब नो भाय कनज नो सोरो ओतनीयल तीने हराय नाख्‌यो; अने कालेब तीनी ह़ाते आह़फा नी सोरी अकसा ना वेवा कर देदो। <verse eid="JOS 15:17" /><verse number="18" style="v" sid="JOS 15:18" />जत्‌यार तीहयी तीनीन्‌तां आयी, ता ओतनीयल तीने तीना बाह पांह थोड़ोक जागो मांगवा करीन केदो, अळतेण तीहयी तीनु गदड़ु पोर गेथी उतर पड़ी, अने कालेब तीने पुछ्‌यो, “तने ह़ु जोवे?” <verse eid="JOS 15:18" /><verse number="19" style="v" sid="JOS 15:19" />तीहयी केदी, “मने बरकत आप; तु मने दखणाव भणी नो थोड़ोक जागो ते आपलो से, मने पाणी ना झोर बी आप दे।” ता तीहयो उपर ना झोर अने हेट्‌ला झोर बेम तीने आप देदो।<verse eid="JOS 15:19" /></para>
  <para style="s">यहुदा नी जाती ना ह़ेर</para>
  <para style="p">
    <verse number="20" style="v" sid="JOS 15:20" />यहुदी जाती नो वाटो ते तीमना घोराणा नी अनसारे आहयोत ठेर्‌यो। <verse eid="JOS 15:20" /><verse number="21" style="v" sid="JOS 15:21" />यहुदी जाती नी धेड़े वाळा ह़ेर नी दखणाव भणी ना देस मे एदोम नी काकड़ भणीन आहया से, मतलब कबसेल, एदेर, यागुर, <verse eid="JOS 15:21" /><verse number="22" style="v" sid="JOS 15:22" />कीना, दीमोना, अदादा, <verse eid="JOS 15:22" /><verse number="23" style="v" sid="JOS 15:23" />केदेस, हासोर, यीत्‌नान, <verse eid="JOS 15:23" /><verse number="24" style="v" sid="JOS 15:24" />जीप, लेतेम, बालोत, <verse eid="JOS 15:24" /><verse number="25" style="v" sid="JOS 15:25" />हासोर्‌हदत्‌ता, करीय्‌योहेस्‌रोन, जे हासोर बी केवाय, <verse eid="JOS 15:25" /><verse number="26" style="v" sid="JOS 15:26" />अने अमाम, सेमा, मोलादा, <verse eid="JOS 15:26" /><verse number="27" style="v" sid="JOS 15:27" />हसगर्‌ददा, हेसमोन, बेत्‌पालेत, <verse eid="JOS 15:27" /><verse number="28" style="v" sid="JOS 15:28" />हसर्‌सुवाल, बेर्‌सेबा, बीज्‌योत्‌या, <verse eid="JOS 15:28" /><verse number="29" style="v" sid="JOS 15:29" />बाला, ईय्‌यीम, एसेम, <verse eid="JOS 15:29" /><verse number="30" style="v" sid="JOS 15:30" />एलतोलद, कसील, होर्‌मा, <verse eid="JOS 15:30" /><verse number="31" style="v" sid="JOS 15:31" />सीकलग, मदमन्‌ना, सनसन्‌ना, <verse eid="JOS 15:31" /><verse number="32" style="v" sid="JOS 15:32" />लबावोत, सील्‌हीम, एन, अने रीम्‌मोन; आहया आखा ह़ेर उन्‌तीस से, अने आमना गाम बी से।<verse eid="JOS 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 15:33" />हेट्‌ला देस मे आहया से: मतलब एसतावोल, सोरा, असना, <verse eid="JOS 15:33" /><verse number="34" style="v" sid="JOS 15:34" />जानोह, एनगन्‌नीम, तप्‌पुह, एनाम, <verse eid="JOS 15:34" /><verse number="35" style="v" sid="JOS 15:35" />यर्‌मुत, अदुल्‌लाम, सोको, अजेका, <verse eid="JOS 15:35" /><verse number="36" style="v" sid="JOS 15:36" />सारेम, अदीतेम, गदेरा, अने गदेरोतेम; आहया आखा चोवदे ह़ेर से, अने आमना गाम बी से।<verse eid="JOS 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="JOS 15:37" />अळतेण सनान, हदासा, मीगदलगाद, <verse eid="JOS 15:37" /><verse number="38" style="v" sid="JOS 15:38" />दीलान, मीस्‌पे, योक्‌तेल, <verse eid="JOS 15:38" /><verse number="39" style="v" sid="JOS 15:39" />लाकीस, बोस्‌कत, एग्‌लोन, <verse eid="JOS 15:39" /><verse number="40" style="v" sid="JOS 15:40" />कब्‌बोन, लहमास, कीतलीस, <verse eid="JOS 15:40" /><verse number="41" style="v" sid="JOS 15:41" />गदेरोत, बेतदागोन, नामाह, अने मक्‌केदा; आहया ह़ोळ्‌ळे ह़ेर से, अने आमना गाम बी से।<verse eid="JOS 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="JOS 15:42" />अळतेण लीब्‌ना, एतेर, आसान, <verse eid="JOS 15:42" /><verse number="43" style="v" sid="JOS 15:43" />यीप्‌ताह, असना, नसीब, <verse eid="JOS 15:43" /><verse number="44" style="v" sid="JOS 15:44" />कीला, अकजीब अने मारेसा; आहया नव ह़ेर से, अने आमना गाम बी से। <verse eid="JOS 15:44" /><verse number="45" style="v" sid="JOS 15:45" />अळतेण ह़ेर अने गाम भेळ एक्‌रोन, <verse eid="JOS 15:45" /><verse number="46" style="v" sid="JOS 15:46" />अने एक्‌रोन गेथा लगाड़ीन दर्‌या तक, आह़फा-आह़फाम ना गाम भेळ जेतरा ह़ेर असदोद भणीन से।<verse eid="JOS 15:46" /></para>
  <para style="p">
    <verse number="47" style="v" sid="JOS 15:47" />अळतेण आह़फा-आह़फाम ना ह़ेर अने गाम भेळ असदोद, अने गाजा, आहया मीस्‌र ना कोतड़े तक अने मोट्‌ली दर्‌या ना काठे तक जेतरा ह़ेर से।<verse eid="JOS 15:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="JOS 15:48" />बड़ा वाळा देस मे आहया से: मतलब सामीर, यत्‌तीर, सोको, <verse eid="JOS 15:48" /><verse number="49" style="v" sid="JOS 15:49" />दन्‌ना, कीर्‌यत्‌सन्‌ना जे दबीर बी केवाय, <verse eid="JOS 15:49" /><verse number="50" style="v" sid="JOS 15:50" />अनाब, एस्‌तमो, आनीम, <verse eid="JOS 15:50" /><verse number="51" style="v" sid="JOS 15:51" />गोसेन, होलोन, अने गीलो; आहया ग्‌यारे ह़ेर से, अने आमना गाम बी से।<verse eid="JOS 15:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="JOS 15:52" />अळतेण अराब, दुमा, एसान, <verse eid="JOS 15:52" /><verse number="53" style="v" sid="JOS 15:53" />यानीम, बेत्‌तप्‌पुहम अपेका, <verse eid="JOS 15:53" /><verse number="54" style="v" sid="JOS 15:54" />हुमता, कीर्‌यतर्‌बा जे हेब्‌रोन बी केवाय, अने सीवोर; आहया नव ह़ेर से, अने आमना गाम बी से। <verse eid="JOS 15:54" /><verse number="55" style="v" sid="JOS 15:55" />अळतेण मावोन, कर्‌मेल, जीप, युत्‌ता, <verse eid="JOS 15:55" /><verse number="56" style="v" sid="JOS 15:56" />यीज्‌रेल, योकदाम, जानोह, <verse eid="JOS 15:56" /><verse number="57" style="v" sid="JOS 15:57" />केन, गीबा अने तीम्‌नाह; आहया दह ह़ेर से, अने आमना गाम बी से।<verse eid="JOS 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="JOS 15:58" />अळतेण हलहुल, बेतसुर, गदोर, <verse eid="JOS 15:58" /><verse number="59" style="v" sid="JOS 15:59" />मरात, बेतनोत, अने एलतकोन; आहया छो ह़ेर से, अने आमना गाम बी से।<verse eid="JOS 15:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="JOS 15:60" />अळतेण कीर्‌यतबाल जे कीर्‌यात्‌यारीम बी केवाय, अने रब्‌बा; आहया बे ह़ेर से, अने आमना गाम बी से।<verse eid="JOS 15:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="JOS 15:61" />जंगल मे आहया ह़ेर से: मतलब बेतराबा, मीद्‌दीन, सकाका; <verse eid="JOS 15:61" /><verse number="62" style="v" sid="JOS 15:62" />नीबसान, खारलु मीठु नु ह़ेर, अने एनगदी, आहया छो ह़ेर से, अने आमना गाम बी से।<verse eid="JOS 15:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="JOS 15:63" />यरुसलेम मे रेवा वाळा यहुदी यबुसी जाती वाळा ने नी नीकाळ सक्‌या; एतरे आज ना दाड़े तक यबुसी माणहु यहुदीम नी ह़ाते यरुसलेम मे री र्‌या।<note caller="+" style="x"><char style="xo" closed="false">15:63 </char><char style="xt" closed="false"><ref loc="JDG 1:21">न्‌यायीयो 1:21</ref>; <ref loc="2SA 5:6">2 समुवेल 5:6</ref>; <ref loc="1CH 11:4">1 ईतीहास 11:4</ref></char></note><verse eid="JOS 15:63" /></para>
  <chapter eid="JOS 15" />
  <chapter number="16" style="c" sid="JOS 16" />
  <para style="s">एप्‌रेम अने मनस्‌से जाती ने आपलो वाटो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 16:1" />अळतेण युसुफ नी अवल्‌यात नो वाटो चीट्‌ठी नाखवा सी ठेराया, तीमनी काकड़ यरीहोन्‌तां नी यरदन नंदी गेथी, मतलब उगवणी ह़ोड़ यरीहो ना झोर गेथी सुरु हय्‌न तीहया बड़ा वाळा देस मे हय्‌न, जे जंगल मे से, बेतेल ह़ेर मे जाय री। <verse eid="JOS 16:1" /><verse number="2" style="v" sid="JOS 16:2" />बेतेल ह़ेर गेथी लुज<note caller="+" style="f"><char style="fr" closed="false">16:2 </char><char style="fq" closed="false">लुज </char><char style="ft" closed="false">लुज एक गाम से</char></note> मे तक पुग री, अने एरेकी जाती नी काकड़ ने तां हय्‌न अतारोत पुग जी; <verse eid="JOS 16:2" /><verse number="3" style="v" sid="JOS 16:3" />अने बुडवणी ह़ोड़ यपलेती जाती नी काकड़ भणीन हय्‌न अने हेट्‌ली बेथोरोन नी काकड़ माय्‌न गेजेर मे पुगी, अने दर्‌यान्‌तां खत्‌तम हयी। <verse eid="JOS 16:3" /><verse number="4" style="v" sid="JOS 16:4" />ता मनस्‌से अने एप्‌रेम नाम ना युसुफ ना बेम सोरा नी अवल्‌यात आह़फा-आह़फाम नो वाटो लेदा।<verse eid="JOS 16:4" /></para>
  <para style="s">एप्‌रेम नो वाटो</para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 16:5" />एप्‌रेम जाती वाळा नी काकड़ तीमनी जाती नी अनसारे आहयी ठेरी; मतलब तीमना वाटा नी काकड़ उगवणी गेथी सुरु हय्‌न अत्‌रोतद्‌दार हय्‌न उप्‌परवाळा बेथोरोन तक पुगी; <verse eid="JOS 16:5" /><verse number="6" style="v" sid="JOS 16:6" />अने धुराव भणी नी काकड़ बुडवणी ह़ोड़ ना मीकमतात गेथी सुरु हय्‌न उगवणी ह़ोड़ वळीन तानतसीलो मे पुगी, अने तीनीन्‌तां माय्‌न यानोह तक पुगी; <verse eid="JOS 16:6" /><verse number="7" style="v" sid="JOS 16:7" />अळतेण यानोह गेथी तीहयी अतारोत अने नारा भणीन हेटी उतरती जाय्‌न यरीहोन्‌तां हय्‌न यरदन नंदीन्‌तां नीकळी। <verse eid="JOS 16:7" /><verse number="8" style="v" sid="JOS 16:8" />अळतेण तीहयीत काकड़ तप्‌पुह ने तां नीकळीन, अने बुडवणी ह़ोड़ जाय्‌न, काना नाम ना कोतड़े तक हय्‌न दर्‌या पोर नीकळी। एप्‌रेम जाती नो वाटो तीमना घोराणा नी अनसारे आहयोत ठेर्‌यो। <verse eid="JOS 16:8" /><verse number="9" style="v" sid="JOS 16:9" />अने मनस्‌से जाती ना वाटा नी वचमे गेथा ढेरेत ह़ेर तीमना गाम भेळ एप्‌रेम जाती जुगु अलग कर्‌या। <verse eid="JOS 16:9" /><verse number="10" style="v" sid="JOS 16:10" />पण जे कनानी गेजेर ह़ेर मे वहला हता तीमने तां गेथा एप्‌रेमी माणहु नी नीकाळ्‌या; एतरे तीहया कनानी माणहु तीमनी वचमे आज ना दाड़े तक वहला से, अने तीमने दाड़की करवा करीन पावर बणाय देदला से।<note caller="+" style="x"><char style="xo" closed="false">16:10 </char><char style="xt" closed="false"><ref loc="JDG 1:29">न्‌यायीयो 1:29</ref></char></note><verse eid="JOS 16:10" /></para>
  <chapter eid="JOS 16" />
  <chapter number="17" style="c" sid="JOS 17" />
  <para style="s">बुडवणी ह़ोड़ मनस्‌से जाती नो वाटो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 17:1" />अळतेण युसुफ ना मोट्‌ला सोरा मनस्‌से नी जाती नो वाटो चीट्‌ठी नाखवा सी आहयो ठेर्‌यो। मनस्‌से नो मोट्‌लो सोरो, गीलाद नो बाह माकीर, झुमायण्‌यो, योद्‌दा हतो करीन तीना घोराणा ने गीलाद अने बासान देस आप्‌या। <verse eid="JOS 17:1" /><verse number="2" style="v" sid="JOS 17:2" />एतरे आहयो वाटो बीजा मनस्‌से ना बीजा सोरा जुगु तीमना घोराणा नी अनसारे ठेर्‌यो, मतलब अबीयेजेर, हेलेक, अस्‌रीएल, सकेम, हेपेर, अने समीदा; जे आह़फा-आह़फाम नी जाती नी अनसारे युसुफ ना सोरा मनस्‌सेम ना घोराणा ना अदमी हता, तीमना अलग-अलग घोराणा जुगु ठेर्‌यो। <verse eid="JOS 17:2" /><verse number="3" style="v" sid="JOS 17:3" />पण हेपेर जे गीलाद नो सोरो, अने माकीर नो सोरा नो सोरो, अने मनस्‌से नो सोरा ना सोरा नो सोरो हतो, तीना सोरा सलोफाद ना एक बी सोरा नी हता आखा सोर्‌यात हता; अने तीमना नाम महला, नोवा, होग्‌ला, मील्‌का, अने तीर्‌सा से। <verse eid="JOS 17:3" /><verse number="4" style="v" sid="JOS 17:4" />ता तीहया सोर्‌या एलीयाजार पुंजारा, नुन ना सोरा यहोसु, अने मुख्‌यान्‌तां जाय्‌न केवा बाज ज्‌या, “यहोवा भगवान मुसा ने हुकम आपलो हतो, के तीहयो आमने अमारा ह़गला नी वचमे वाटो आपे।” ता यहोसु यहोवा ना हुकम नी अनसारे तीमने तीमना काकाम नी वचमे वाटो आप्‌यो।<note caller="+" style="x"><char style="xo" closed="false">17:4 </char><char style="xt" closed="false"><ref loc="NUM 27:1-7">गीनती 27:1-7</ref></char></note> <verse eid="JOS 17:4" /><verse number="5" style="v" sid="JOS 17:5" />ता मनस्‌से ने, यरदन नंदीन पार गीलाद देस अने बासान देस मे छोड़ीन, दह वाटा अळी जड़्‌या: <verse eid="JOS 17:5" /><verse number="6" style="v" sid="JOS 17:6" />काहाके मनस्‌सेम नी जाती नी वच मे मनस्‌से ना सोर्‌या ने बी वाटो जड़्‌यो। अने मनस्‌से जाती वाळा बीजाम ने गीलाद देस जड़्‌यु।<verse eid="JOS 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 17:7" />मनस्‌से नी काकड़ आसेर गेथी लगाड़ीन मीकमतात तक हती, जे सकेम नी उगवणी ह़ोड़ से; अळतेण तीहयी काकड़ दखणाव भणी एनतप्‌पुह ना रेवा वाळा भणीन तक जत री। <verse eid="JOS 17:7" /><verse number="8" style="v" sid="JOS 17:8" />तप्‌पुह नी जागा ते मनस्‌से ने जड़ी, पण तप्‌पुह ह़ेर जे मनस्‌से नी काकड़ पोर वहलु से तीहयु एप्‌रेम जाती ना हक मे हतु। <verse eid="JOS 17:8" /><verse number="9" style="v" sid="JOS 17:9" />अळतेण तीहयी काकड़ तां गेथी काना नाम ना कोतड़ान्‌तां माय्‌न उतरीन तीनी दखणाव भणी तक पुग जी; आहया ह़ेर मनस्‌से ना ह़ेर नी वचमे हता ते बी एप्‌रेम ना ठेर्‌या; अने मनस्‌से नी काकड़ तीहया कोतड़ा नी धुराव भणी हतीन दर्‌या पोर नीकळी; <verse eid="JOS 17:9" /><verse number="10" style="v" sid="JOS 17:10" />दखणाव भणी नु देस ते एप्‌रेम नी जाती ने जड़्‌यु अने धुराव भणी नु देस मनस्‌से ने जड़्‌यु, अने तीनी काकड़ दर्‌या ठेरी; तीमनी काकड़ धुराव भणी आसेर मे अने उगवणी ह़ोड़ ईस्‌साकार मे जाय्‌न भेसकाय जी। <verse eid="JOS 17:10" /><verse number="11" style="v" sid="JOS 17:11" />अने मनस्‌से ने, अने ईस्‌साकार अने आसेर आह़फा-आह़फाम ना ह़ेर भेळ बेतसान, यीबलाम, अने आह़फाम ना ह़ेर दोर ह़ेर मे रेवा वाळा, अने आह़फाम ना ह़ेर भेळ एनदोर ह़ेर ना रेवा वाळा, अने आह़फाम ना ह़ेर भेळ तानाक ह़ेर ना रेवा वाळा अने आह़फाम ना ह़ेर भेळ मगीद्‌दो ह़ेर ना रेवा वाळा, आहया तीनोव जे उचा जागा मे वहला से जड़्‌या। <verse eid="JOS 17:11" /><verse number="12" style="v" sid="JOS 17:12" />पण मनस्‌से नी जाती वाळा तीहया ह़ेर मे रेण्‌या ने ह़ेर मे गेथा नी नीकाळ सक्‌या; एतरे तीहया कनानी तीहया देस मे हीम्‌मत भेळ वहला र्‌या।<note caller="+" style="x"><char style="xo" closed="false">17:12 </char><char style="xt" closed="false"><ref loc="JDG 1:27">न्‌यायीयो 1:27</ref>,<ref loc="JDG 1:28">28</ref></char></note> <verse eid="JOS 17:12" /><verse number="13" style="v" sid="JOS 17:13" />ते बी ईस्‌रायली जत्‌यार ताखत वाळा हय ज्‌या, ता कनानी माणहु ने जबराण ते काम कराव्‌वा बाज ज्‌या, पण तीमने पुरी रीते नीकाळ्‌या नी।<verse eid="JOS 17:13" /></para>
  <para style="s">एप्‌रेम अने मनस्‌से जाती नी लारे जादा जागो मांगणु</para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 17:14" />युसुफ नी अवल्‌यात यहोसु ने केवा बाज ज्‌यी, “अमारी गीनती ते घणी से, काहाके हजु तक यहोवा आमु ने बरकतेत आपतो आय र्‌यो, ता तु अमारा आखा देस जुगु चीट्‌ठी नाखीन काहा एकीत वाटो आप र्‌यो?” <verse eid="JOS 17:14" /><verse number="15" style="v" sid="JOS 17:15" />यहोसु तीमने केदो, “तमु गीनती मे जादा से, अने एप्‌रेम नु बड़ा मे वाळु देस तमारी जुगु नानु हय, ता जे परीज्‌जी अने रपाई जाती नु देस जे जंगल से तीनी मे जाय्‌न झाड़का ने वाड देवो।” <verse eid="JOS 17:15" /><verse number="16" style="v" sid="JOS 17:16" />युसुफ नी अवल्‌यात केदी, “तीहयु बड़ा मे वाळु देस अमारी जुगु नानु से; अने बेतसान अने तीना ह़ेर मे रेवा वाळा अने यीज्‌रेल नी घाटी मे रेवा वाळा, जेतरा कनानी हेट्‌ला देस मे रेय, तीमनी आखा पांह लुहड़ा ना घोड़ा-गाड्‌या से।” <verse eid="JOS 17:16" /><verse number="17" style="v" sid="JOS 17:17" />ता यहोसु, ह़ु एप्‌रेम, ह़ु मनस्‌से, मतलब युसुफ नु आखु घोराणु ने केदो, “होव, तमु ते गीनती मे वदु से, अने तमारी जाती बी ताखत वाळी से, एतरे तमने एकीत वाटो नी जड़े। <verse eid="JOS 17:17" /><verse number="18" style="v" sid="JOS 17:18" />बड़ा मे वाळु देस बी तमारु हय जहे; काहाके तीहयु जंगल ते से, पण तीना झाड़का वाड देवो, ता तीनी आड़े-धेड़े नु देस बी तमारु हय जहे; काहाके भले कनानी ताखत वाळा हय, अने तीमनी पांह लुहड़ा ना घोड़ा-गाड्‌या बी हय, ते बी तमु तीमने तां गेथा नीकाळ सकहु।”<verse eid="JOS 17:18" /></para>
  <chapter eid="JOS 17" />
  <chapter number="18" style="c" sid="JOS 18" />
  <para style="s">बचला जागा ने वाटणु</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 18:1" />अळतेण ईस्‌रायली माणहु नी आखी मंडळी सीलो ह़ेर मे एक्‌ठा हय्‌न तां भगवान नी हजुरी नु तम्‌बु ने उबु कर्‌या; काहाके देस तीमना हक मे हय जेलु हतु। <verse eid="JOS 18:1" /><verse number="2" style="v" sid="JOS 18:2" />अने ईस्‌रायली मे गेथी ह़ात जाती आह़फा-आह़फाम नो वाटो लीया वगर री जेली हती। <verse eid="JOS 18:2" /><verse number="3" style="v" sid="JOS 18:3" />ता यहोसु ईस्‌रायली माणहु ने केदो, “जे देस तमारा आड़ा-बुड़ाम नो भगवान यहोवा तमने आपलो से, तीने तमारा हक मे कर लेवा करीन तमु कारु तक ढीलाय करता रेहु? <verse eid="JOS 18:3" /><verse number="4" style="v" sid="JOS 18:4" />हाव एक-एक जाती मे गेथा तीन-तीन माणहु ने टाळ लेवो, अने मे तीमने आनीन करते मोकलही के तीहया जाय्‌न देस मे चाले फीरे, अने आह़फा-आह़फाम नी जाती ना वाटा ना जुगाड़ नी अनसारे तीना बारा मे लीखी-लीखीन मारीन्‌तां पासा आवती रेय। <verse eid="JOS 18:4" /><verse number="5" style="v" sid="JOS 18:5" />अने तीहया देस ना ह़ात वाटा लीखहे, यहुदी ते दखणाव भणी आह़फाम ना वाटा मे, अने युसुफ ना घोराणा ना माणहु धुराव भणी तीमना वाटा मे रेहे। <verse eid="JOS 18:5" /><verse number="6" style="v" sid="JOS 18:6" />अने तमु देस ना ह़ात वाटा लीखीन मारीन्‌तां ली आवो; अने मे आञे तमारी जुगु आपणा भगवान यहोवा अगळ चीट्‌ठी नाखही। <verse eid="JOS 18:6" /><verse number="7" style="v" sid="JOS 18:7" />अने लेवीम नो तमारी वचमे कंय बी वाटो नी रेय, काहाके यहोवा नो आपलो पुंजारा नो जागोत ईमनो वाटो से; अने गाद रुबेन, अने मनस्‌से ना आदी जाती ना माणहु यरदन नंदी नी उगवणी धेड़ यहोवा नो चाकर्‌यो मुसो आपलो तीहयो वाटो हात कर लेदला से।”<verse eid="JOS 18:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 18:8" />ता तीहया अदमी उठीन चाल पड़्‌या; अने जे तीहया देस ना बारा मे लीखवा चाल्‌या तीमने यहोसु आहयो हुकम आप्‌यो, “जाय्‌न देस मे फीरो, अने तीना बारा मे लीखीन मारीन्‌तां आवती रेवो; अने मे आञे सीलो मे यहोवा नी अगळ तमारी जुगु चीट्‌ठी नाखही।” <verse eid="JOS 18:8" /><verse number="9" style="v" sid="JOS 18:9" />ता तीहया अदमी चाल पड़्‌या, अने तीहया देस मे फीर्‌या, अने तीहया ह़ेर ने ह़ात वाटा करीन तीना बारा मे कीताप मे लीखीन सीलो ना पड़ावा मे यहोसुन्‌तां आया। <verse eid="JOS 18:9" /><verse number="10" style="v" sid="JOS 18:10" />ता यहोसु सीलो मे यहोवा भगवान अगळ तीमनी जुगु चीट्‌ठी नाख्‌यो; अने तांत यहोसु ईस्‌रायली माणहु ने तीमना वाटा नी अनसारे देस ने वाट देदो।<verse eid="JOS 18:10" /></para>
  <para style="s">बीन्‌यामीन नी जाती ने आपलो वाटो</para>
  <para style="p">
    <verse number="11" style="v" sid="JOS 18:11" />बीन्‌यामीन जाती नी चीट्‌ठी तीमना घोराणा नी अनसारे नीकळी, अने तीमनो वाटो यहुदा अने युसुफ नी जाती नी वचमे पड़्‌यो। <verse eid="JOS 18:11" /><verse number="12" style="v" sid="JOS 18:12" />अने तीमनी दखवरी काकड़ यरदन नंदीन्‌तां गेथी सुरु हयी, अने यरीहो नी धुराव भणी चड़तीन बुडवणी ह़ोड़ बड़ा वाळा देस मे हय्‌न बेतावेन ना जंगल मे पुगी; <verse eid="JOS 18:12" /><verse number="13" style="v" sid="JOS 18:13" />तां गेथी काकड़ लुज मे पुगी जे बेतेल बी केवाये, अने लुज नी दखणाव भणी हतीन हेट्‌ला बेथोरोन नी दखणाव भणी ना बड़ा मे हय्‌न अत्‌रोतद्‌दार मे जत री। <verse eid="JOS 18:13" /><verse number="14" style="v" sid="JOS 18:14" />अळतेण बुडणली काकड़ वळीन बेथोरोन नी अगळ अने दखणाव भणी ना बड़ा मे हतीन कीर्‌यतबाल नाम ना यहुदा ना एक ह़ेर ने तां नीकळी जे कीर्‌यात्‌यारीम बी केवाय; बुडवणी नी काकड़ आहयीत ठेरी। <verse eid="JOS 18:14" /><verse number="15" style="v" sid="JOS 18:15" />अळतेण दखणाव भणी नी काकड़ बुडवणी गेथी सुरु हय्‌न कीर्‌यात्‌यारीम नी धेड़े गेथी नीकळीन नेप्‌तोह ना झोर पोर पुगी; <verse eid="JOS 18:15" /><verse number="16" style="v" sid="JOS 18:16" />अने तीहया बड़ा नी धेड़े नीकळी, जे हीन्‌नोम ना सोरा नी घाटी नी अगळ अने रपाईम नाम नी घाटी नी धुराव भणी से; अने तां गेथी हीन्‌नोम नी घाटी मे, मतलब यबुसी नी दखणाव भणी हय्‌न एनरोगेल झोर ने तां पुगी; <verse eid="JOS 18:16" /><verse number="17" style="v" sid="JOS 18:17" />तां गेथी तीहयी धुराव भणी वळीन एनसेमेस भणीन नीकळीन तीहयु गलीलोत भणीन जी, जे अदुम्‌मीम ना चड़ाव नी अगळ से, अळतेण तां गेथी तीहयी काकड़ रुबेन ना सोरा बोहन ना दगड़ा तक जत री; <verse eid="JOS 18:17" /><verse number="18" style="v" sid="JOS 18:18" />तां गेथी तीहयी धुराव भणी जाय्‌न अराबा नी अगळ ना बड़ा भणीन हय्‌न यरदन नी घाटी मे जत री; <verse eid="JOS 18:18" /><verse number="19" style="v" sid="JOS 18:19" />तां गेथी तीहयी काकड़ बेथोग्‌ला नी धुराव मे हय्‌न खारली दर्‌यान नी दखणाव मे हय्‌न यरदन नंदी ना मोडा पोर नीकळी; दखणाव नी काकड़ आहयीत ठेरी। <verse eid="JOS 18:19" /><verse number="20" style="v" sid="JOS 18:20" />अने उगवणी ह़ोड़ नी काकड़ यरदन नंदीत ठेरी। बीन्‌यामीन नी जाती नो वाटो, च्‌यारो-मेर नी काकड़ भेळ, तीमनी जाती नी अनसारे, आहयोत ठेर्‌यो।<verse eid="JOS 18:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 18:21" />बीन्‌यामीन नी जाती ने तीमनी जाती नी अनसारे आहया ह़ेर जड़्‌या, मतलब यरीहो, बेथोग्‌ला, एमेक्‌कसीस, <verse eid="JOS 18:21" /><verse number="22" style="v" sid="JOS 18:22" />बेतराबा, समारेम, बेतेल, <verse eid="JOS 18:22" /><verse number="23" style="v" sid="JOS 18:23" />अब्‌बीम, पारा, ओप्‌रा, <verse eid="JOS 18:23" /><verse number="24" style="v" sid="JOS 18:24" />कपरम्‌मोनी, ओप्‌रनी अने गेबा; आहया बारे ह़ेर अने तीमना गाम जड़्‌या। <verse eid="JOS 18:24" /><verse number="25" style="v" sid="JOS 18:25" />अळतेण गीबोन, रामाह, बेरोत, <verse eid="JOS 18:25" /><verse number="26" style="v" sid="JOS 18:26" />मीस्‌पे, कपीरा, मोसा, <verse eid="JOS 18:26" /><verse number="27" style="v" sid="JOS 18:27" />रेकेम, यीर्‌पेल, तरला, <verse eid="JOS 18:27" /><verse number="28" style="v" sid="JOS 18:28" />सेला, एलेप, यबुसी, जे यरुसलेम बी केवाय, गीबत, अने कीर्‌यत; आहया चोवदे ह़ेर अने ईमना गाम ईमने जड़्‌या। बीन्‌यामीन जाती ने तीमनो वाटो तीमना घोराणा नी अनसारे आहयोत ठेर्‌यो।<verse eid="JOS 18:28" /></para>
  <chapter eid="JOS 18" />
  <chapter number="19" style="c" sid="JOS 19" />
  <para style="s">सीमोन ना घोराणा ने आपलो वाटो</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 19:1" />बीजी चीट्‌ठी सीमोन ना नाम पोर नीकळी, मतलब सीमोनी जाती नी अनसारे तीमना घोराणा ना नाम पोर नीकळी; अने तीमनो वाटो यहुदाम ना वाटा नी वच मे ठेर्‌यो। <verse eid="JOS 19:1" /><verse number="2" style="v" sid="JOS 19:2" />तीमना वाटा मे आहया ह़ेर से, मतलब बेर्‌सेबा, सेबा, मोलादा,<note caller="+" style="x"><char style="xo" closed="false">19:2 </char><char style="xt" closed="false"><ref loc="1CH 4:28-33">1 ईतीहास 4:28-33</ref> </char></note> <verse eid="JOS 19:2" /><verse number="3" style="v" sid="JOS 19:3" />हसर्‌सुवाल, बाला, एसेम, <verse eid="JOS 19:3" /><verse number="4" style="v" sid="JOS 19:4" />एलतोलद, बतुल होर्‌मा, <verse eid="JOS 19:4" /><verse number="5" style="v" sid="JOS 19:5" />सीकलग, बेत्‌मकार्‌बोत, हससुर्‌सा, <verse eid="JOS 19:5" /><verse number="6" style="v" sid="JOS 19:6" />बेतलबावोत, अने सारुहेन; आहया तेरे ह़ेर अने तीमना गाम ईमने जड़्‌या। <verse eid="JOS 19:6" /><verse number="7" style="v" sid="JOS 19:7" />अळतेण एन, रीम्‌मोन, एतेर, अने आसान, आहया च्‌यार ह़ेर गाम भेळ; <verse eid="JOS 19:7" /><verse number="8" style="v" sid="JOS 19:8" />अने बालत्‌बेर जे दखणाव देस नु रामाह बी केवाय, तां तक आहया ह़ेर नी च्‌यारो-मेर ना आखा गाम बी ईमने जड़्‌या। सीमोनी जाती नो वाटो तीमना घोराणा नी अनसारे आहयोत ठेर्‌यो। <verse eid="JOS 19:8" /><verse number="9" style="v" sid="JOS 19:9" />सीमोन नी जातीम नो वाटो ते यहुदा घोराणा ना वाटा मे गेथो आप्‌या; काहाके यहुदा घोराणा नो वाटो तीमनी जुगु घणो ढेरको हतो, करीन सीमोन नी जाती नो वाटो ईमनीत वचमे ठेर्‌यो।<verse eid="JOS 19:9" /></para>
  <para style="s">जबुलुन ना घोराणा ने आपलो वाटो</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 19:10" />तीसरी चीट्‌ठी जबुलुनी जाती नी अनसारे तीमना नाम पोर नीकळी। अने तीमना वाटा नी काकड़ सारीद तक पुगी; <verse eid="JOS 19:10" /><verse number="11" style="v" sid="JOS 19:11" />अने तीमनी काकड़ बुडवणी ह़ोड़ मरला नाम ना जागे हतीन दब्‌बेसेत मे पुगी, अने योकनाम ना अगळ ना कोतड़े तक पुगी; <verse eid="JOS 19:11" /><verse number="12" style="v" sid="JOS 19:12" />अळतेण तीहयी काकड़ सारीद गेथी उगवणी ह़ोड़ वळीन कीसलोत्‌ताबोर नी काकड़ तक पुगी, अने तां गेथी अगी जाय्‌न दाबरत मे नीकळी, अने यापी भणीन जाय्‌न नीकळी; <verse eid="JOS 19:12" /><verse number="13" style="v" sid="JOS 19:13" />तां गेथी तीहयी उगवणी भणीन जाय्‌न गथेपेर अने ईत्‌कासीन मे जत री, अने तीहया रीम्‌मोन मे नीकळी जे नेवा भणी फेललु से; <verse eid="JOS 19:13" /><verse number="14" style="v" sid="JOS 19:14" />तां गेथी तीहयी काकड़ तीनी धुराव भणी वळीन हन्‌नातोन पोर पुगी; अने यीप्‌तहेल नी घाटी मे जाय्‌न नीकळी; <verse eid="JOS 19:14" /><verse number="15" style="v" sid="JOS 19:15" />कत्‌तात, नहलाल, सीम्‌रोन, यीदला, अने बेतलहम; आहया बारे ह़ेर तीमना गाम भेळ तीहयात वाटा ना ठेर्‌या। <verse eid="JOS 19:15" /><verse number="16" style="v" sid="JOS 19:16" />जबुलुनीम नो वाटो तीमना घोराणा नी अनसारे आहयोत ठेर्‌यो; अने तीनी मे तीमना गाम भेळ आहयात ह़ेर से।<verse eid="JOS 19:16" /></para>
  <para style="s">ईस्‌साकार ना घोराणा ने आपलो वाटो</para>
  <para style="p">
    <verse number="17" style="v" sid="JOS 19:17" />चोवथी चीट्‌ठी ईस्‌साकार नी जाती नी अनसारे तीमना नाम पोर नीकळी। <verse eid="JOS 19:17" /><verse number="18" style="v" sid="JOS 19:18" />अने तीमनी काकड़ यीज्‌रेल, कसुल्‌लोत, सुनेम, <verse eid="JOS 19:18" /><verse number="19" style="v" sid="JOS 19:19" />हपारेम, सीवोल, अनाहरत, <verse eid="JOS 19:19" /><verse number="20" style="v" sid="JOS 19:20" />रब्‌बीत, कीस्‌योन, एबेस, <verse eid="JOS 19:20" /><verse number="21" style="v" sid="JOS 19:21" />रेमेत, एनगन्‌नीम, एनहद्‌दा, अने बेत्‌पस्‌सेस तक पुगी। <verse eid="JOS 19:21" /><verse number="22" style="v" sid="JOS 19:22" />अळतेण तीहयी काकड़ ताबोर, सहसुमा अने बेतसेमेस तक पुगी, अने तां गेथी यरदन नंदी पोर जाय नीकळी; आहयी रीते ईमने ह़ोळ्‌ळे ह़ेर तीमना गाम भेळ जड़्‌या। <verse eid="JOS 19:22" /><verse number="23" style="v" sid="JOS 19:23" />जाती नी अनसारे ईस्‌साकारीयो नी जाती नो वाटो ह़ेर अने गाम भेळ आहयोत ठेर्‌यो।<verse eid="JOS 19:23" /></para>
  <para style="s">आसेर ना घोराणा ने आपलो वाटो</para>
  <para style="p">
    <verse number="24" style="v" sid="JOS 19:24" />पांचवी चीट्‌ठी आसेरीम ना घोराणा नी जाती नी अनसारे तीमना नाम पोर नीकळी। <verse eid="JOS 19:24" /><verse number="25" style="v" sid="JOS 19:25" />तीमनी काकड़ मे हेल्‌कात, हली, बेतेन, अक्‌साप, <verse eid="JOS 19:25" /><verse number="26" style="v" sid="JOS 19:26" />अलाम्‌मेल्‌लेक, अमाद, अने मीसाल हता; अने तीहयी काकड़ बुडवणी ह़ोड़ कार्‌मेल तक अने सीहोर्‌लीन्‌बात तक पुगी; <verse eid="JOS 19:26" /><verse number="27" style="v" sid="JOS 19:27" />अळतेण तीहयी उगवणी वळीन बेतदागोन मे जत री, अने जबुलुन ना वाटा तक, अने यीप्‌तहेल नी घाटी गेथी धुराव भणी हय्‌न बेतेमेक अने नीयल तक पुगी; अने धुराव भणी जाय्‌न काबुल पोर नीकळी, <verse eid="JOS 19:27" /><verse number="28" style="v" sid="JOS 19:28" />अने तीहयी एब्‌रोन, रहोब, हम्‌मोन, अने काना मे हय्‌न मोट्‌ला सीदोन मे पुगी; <verse eid="JOS 19:28" /><verse number="29" style="v" sid="JOS 19:29" />तां गेथी तीहयी काकड़ वळीन रामाह मे हतीन सोर नाम ना कीला वाळा ह़ेर तक जत री; अळतेण काकड़ होसा भणीन वळीन अने अकजीब ने तां ना देस मे हय्‌न दर्‌या पोर नीकळी, <verse eid="JOS 19:29" /><verse number="30" style="v" sid="JOS 19:30" />उम्‌मा, अपेक, अने रहोब, बी तीमना वाटा मे ठेर्‌या; आहयी रीते बावीस ह़ेर तीमना गाम भेळ तीमने जड़्‌या। <verse eid="JOS 19:30" /><verse number="31" style="v" sid="JOS 19:31" />जाती नी अनसारे आसेरीम ना घोराणा नो वाटो ह़ेर अने गाम भेळ आहयोत ठेर्‌यो।<verse eid="JOS 19:31" /></para>
  <para style="s">नप्‌ताली नी जाती ने आपलो वाटो</para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 19:32" />छट्‌टी चीट्‌ठी नप्‌ताली ना घोराणा नी अनसारे तीमना नामे नीकळी। <verse eid="JOS 19:32" /><verse number="33" style="v" sid="JOS 19:33" />अने तीमनी काकड़ हेलेप गेथी, अने सानन्‌नीम ना वांज्‌या झाड़ गेथी, अदामीनेकेब अने यब्‌नेल माय्‌न, अने लक्‌कुम मे जाय्‌न यरदन नंदी पोर नीकळी; <verse eid="JOS 19:33" /><verse number="34" style="v" sid="JOS 19:34" />तां गेथी तीहयी काकड़ बुडवणी ह़ोड़ वळीन अजनोत्‌ताबोर मे जी, अने तां गेथी हुक्‌कोक मे पुगी, अने दखणाव ह़ोड़, अने जबुलुन ना वाटा तक, अने बुडवणी ह़ोड़ आसेर ना वाटा तक, अने उगवणी ह़ोड़ यहुदा ना वाटान्‌तां नी यरदन नंदीन्‌तां नीकळी। <verse eid="JOS 19:34" /><verse number="35" style="v" sid="JOS 19:35" />अने तीमना कीला वाळा ह़ेर आहया से, मतलब सीद्‌दीम, सेर, हम्‌मत, रक्‌कत, कीन्‌नेरेत, <verse eid="JOS 19:35" /><verse number="36" style="v" sid="JOS 19:36" />अदामा, रामाह, हासोर, <verse eid="JOS 19:36" /><verse number="37" style="v" sid="JOS 19:37" />केदेस, एद्‌रेई, एन्‌हासोर, <verse eid="JOS 19:37" /><verse number="38" style="v" sid="JOS 19:38" />यीरोन, मीगदलेल, होरेम, बेतनात, अने बेतसेमेस; आहया उन्‌नीस ह़ेर अने गाम भेळ ईमने जड़्‌या। <verse eid="JOS 19:38" /><verse number="39" style="v" sid="JOS 19:39" />घोराणा नी अनसारे नप्‌ताली जाती नो वाटो ह़ेर अने गाम भेळ आहयोत ठेर्‌यो।<verse eid="JOS 19:39" /></para>
  <para style="s">दान ना घोराणा ने आपलो वाटो</para>
  <para style="p">
    <verse number="40" style="v" sid="JOS 19:40" />ह़ातवी चीट्‌ठी जाती नी अनसारे दान ना घोराणा ना नाम पोर नीकळी। <verse eid="JOS 19:40" /><verse number="41" style="v" sid="JOS 19:41" />अने तीमना वाटा नी काकड़ मे सोरा, एसतावोल, ईरसेमेस, <verse eid="JOS 19:41" /><verse number="42" style="v" sid="JOS 19:42" />सालब्‌बीन, अय्‌यालोन, यीतला, <verse eid="JOS 19:42" /><verse number="43" style="v" sid="JOS 19:43" />एलोन, तीम्‌ना, एक्‌रोन, <verse eid="JOS 19:43" /><verse number="44" style="v" sid="JOS 19:44" />एलतके, गीब्‌बतोन, बालात, <verse eid="JOS 19:44" /><verse number="45" style="v" sid="JOS 19:45" />यहुद, बनेबराक, गत्‌रीम्‌मोन, <verse eid="JOS 19:45" /><verse number="46" style="v" sid="JOS 19:46" />मेयकोर्‌न, अने रक्‌कोन ठेर्‌या, अने यापो नी अगळ नी काकड़ बी तीमनी हती। <verse eid="JOS 19:46" /><verse number="47" style="v" sid="JOS 19:47" />अने दान जाती नो वाटो आनी गेथो जादा हय ज्‌यो, मतलब दान जाती ना माणहु लेसेम मे रेवा वाळा ह़ाते झुमाय पड़्‌या, अने तीने तलवार वेर मारीन हक मे कर लेदा, अने तीने आह़फाम ना हक मे करीन तीनी मे वह ज्‌या, अने तीमना मुलअदमी ना नाम पोर लेसेम नु नाम दान पाड़्‌या।<note caller="+" style="x"><char style="xo" closed="false">19:47 </char><char style="xt" closed="false"><ref loc="JDG 18:27-29">न्‌यायीयो 18:27-29</ref></char></note> <verse eid="JOS 19:47" /><verse number="48" style="v" sid="JOS 19:48" />घोराणा नी अनसारे दान जाती नो वाटो ह़ेर अने गाम भेळ आहयोत ठेर्‌यो।<verse eid="JOS 19:48" /></para>
  <para style="s">यहोसु ने बी जागा नो वाटो जड़नु</para>
  <para style="p">
    <verse number="49" style="v" sid="JOS 19:49" />जत्‌यार देस ने वाटो पाड़वा नु काम खत्‌तम हयु, ता ईस्‌रायली नुन ना सोरा यहोसु ने बी आह़फाम नी वचमे वाटो आप्‌या। <verse eid="JOS 19:49" /><verse number="50" style="v" sid="JOS 19:50" />यहोवा केदलो तीनी अनसारे तीहया तीने तीहयो मांग्‌यो तीहयु ह़ेर आप्‌या, आहयु एप्‌रेम ना बड़ा मे वाळु तीन्‌मत्‌सेरह से; अने तीहयो तीहयु ह़ेर ने पासो वारु ह़ुदारीन तीनी मे रेवा बाज ज्‌यो। <verse eid="JOS 19:50" /><verse number="51" style="v" sid="JOS 19:51" />जे-जे वात एलीयाजार पुंजारो, अने नुन नो सोरो यहोसु, अने ईस्‌रायलीम ना जाती ना घोराणा ना डाहला ना मुख्‌या-मुख्‌या अदमी सीलो मे, मळवा वाळा तम्‌बु ना झापले, यहोवा अगळ चीट्‌ठी नाखी-नाखीन वाट देदा तीहया आहयात से। करीन तीहया देस वाटो पाड़वा नु काम खत्‌तम कर्‌या।<verse eid="JOS 19:51" /></para>
  <chapter eid="JOS 19" />
  <chapter number="20" style="c" sid="JOS 20" />
  <para style="s">आसरा ना ह़ेर नु ठेरावणु</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 20:1" />अळतेण यहोवा भगवान यहोसु ने केदो,<note caller="+" style="x"><char style="xo" closed="false">20:1 </char><char style="xt" closed="false"><ref loc="NUM 35:9-34">गीनती 35:9-34</ref>; <ref loc="DEU 4:41-43">वेवस्‌थावीवरन 4:41-43</ref>; <ref loc="DEU 19:1-13">19:1-13</ref></char></note> <verse eid="JOS 20:1" /><verse number="2" style="v" sid="JOS 20:2" />“ईस्‌रायलीम ने आहयु के, ‘मे मुसा नी लारे तमारी ह़ाते आसरा ना ह़ेर नी जे वात करलो तीनी अनसारे तीमने ठेराय लेवो, <verse eid="JOS 20:2" /><verse number="3" style="v" sid="JOS 20:3" />जीनी सी कानो भुलीन अंजाण्‌या मे काना ने मार नाखे, तीहयो तीमनी मे गेथा काना मे बी नाह जाय; एतरे तीहया ह़ेर खुन नो बदलो लेवा वाळा सी बचवा करीन तमारो आसरो आपण्‌यो जागो ठेरे। <verse eid="JOS 20:3" /><verse number="4" style="v" sid="JOS 20:4" />तीहयो तीहया ह़ेर मे गेथा काना बी ह़ेर मे नाह जाय, अने तीहया ह़ेर ना फाटे उबो हय्‌न तीना डायला ने आह़फा नी वात ह़मळावे; अने तीहया तीने तीमना ह़ेर मे तीमनीन्‌तां बोलाय लेय, अने तीने कानो जागो आपे, जीनी मे तीहयो तीमनी ह़ाते रेय। <verse eid="JOS 20:4" /><verse number="5" style="v" sid="JOS 20:5" />अने कदीम खुन नो बदलो लेवा वाळो तीनी पछळ आवे, ता तीहया मारवा वाळा ने तीना हात मे नी ह़ोपे; काहाके तीहयो जाण्‌या वगर तीनी ह़ाते वाळा ने मारलो से, अने ह़ाते वाळा ना वीरोद मे कंय बी रीह नी हती। <verse eid="JOS 20:5" /><verse number="6" style="v" sid="JOS 20:6" />अने जत्‌यार तक तीहयो मंडळी नी अगळ आह़फा नो नीयाव जुगु उबो नी हये, अने जत्‌यार तक तीहया बेम जणा नो मोट्‌लो पुंजारो मरी नी जाय, तांह तक तीहयो तीहयात ह़ेर मे रेय; आनीन अळतेण तीहयो मारवा वाळो तीना ह़ेर मे पासो आवीन जीनी मे गेथो तीहयो नाह जेलो हतो तीना घोर मे पासो रेवा बाज जाय।’” <verse eid="JOS 20:6" /><verse number="7" style="v" sid="JOS 20:7" />अळतेण तीहया नप्‌ताली ना बड़ा मे वाळु देस मे गलील ना केदेस ना ह़ेर ने, अने एप्‌रेम ना बड़ा मे वाळु देस मे सकेम ने, अने यहुदा ना बड़ा मे वाळु देस मे कीर्‌यतर्‌बा ने, जे हेब्‌रोन बी केवाय आसरा ना ह़ेर ठेरायो। <verse eid="JOS 20:7" /><verse number="8" style="v" sid="JOS 20:8" />अने यरीहोन्‌तां यरदन नंदी नी उगवणी धेड़े तीहया रुबेन नी जाती ना वाटा मे बेसेर ने, जे जंगल मे चपाट जागा मे वहलु से, अने गाद नी जाती ना वाटा मे गीलाद ना रामोत ने, अने मनस्‌से नी जाती ना वाटा मे बासान ना गोलान ने ठेराया। <verse eid="JOS 20:8" /><verse number="9" style="v" sid="JOS 20:9" />आखा ईस्‌रायलीम नी जुगु, अने तीमनी वचमे रेवा वाळा बीजा देस वाळा जुगु बी, जे ह़ेर आहयी हेर करीन ठेरावला से के जे कोय काना माणेह ने भुलचुक मे मार देय तीहयो तीहया ह़ेर मे गेथा काना ह़ेर मे नाह जाय, अने जत्‌यार तक नीयाव जुगु मंडळी अगळ उबो नी हये, तांह तक खुन नो बदलो लेवा वाळो तीने मारवा नी जोवे, तीहया आहयात से।<verse eid="JOS 20:9" /></para>
  <chapter eid="JOS 20" />
  <chapter number="21" style="c" sid="JOS 21" />
  <para style="s">लेवीम ने ह़ेर आपणु</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 21:1" />ता लेवीम ना डाहलाम ना घोराणा ना मुख्‌या-मुख्‌या माणहु एलीयाजार पुंजारा, अने नुन ना सोरा यहोसु, अने ईस्‌रायली जाती ना डाहलाम ना घोराणा ना मुख्‌या-मुख्‌या माणहुन्‌तां आवीन <verse eid="JOS 21:1" /><verse number="2" style="v" sid="JOS 21:2" />कनान देस ना सीलो ह़ेर मे केवा बाज ज्‌या, “यहोवा मुसा नी लारे आमु ने वहवा करीन ह़ेर, अने अमारा जानवरु जुगु चारवा नो जागो बी आपवा नो हुकम आपलो हतो।”<note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="NUM 35:1-8">गीनती 35:1-8</ref>; <ref loc="1CH 6:54-81">1 ईतीहास 6:54-81</ref></char></note> <verse eid="JOS 21:2" /><verse number="3" style="v" sid="JOS 21:3" />ता ईस्‌रायली यहोवा केदलो तीनी अनसारे आह़फा-आह़फाम ना वाटा मे गेथा लेवी जाती ने चारवा ना जागा भेळ आहया ह़ेर आप्‌या। <verse eid="JOS 21:3" /><verse number="4" style="v" sid="JOS 21:4" />ता कहाती जाती ना नाम पोर चीट्‌ठी नीकळी। एतरे लेवी मे गेथा हारुन पुंजारा ना घोराणा ने यहुदा, सीमोन अने बीन्‌यामीन नी जाती मे ना वाटा मे गेथा तेरे ह़ेर जड़्‌या।<verse eid="JOS 21:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JOS 21:5" />बीजा कहातीम ने एप्‌रेम नी जाती ना घोराणा, अने दान नी जाती, अने मनस्‌से नी आदी जाती ना वाटा मे गेथा चीट्‌ठी नाख-नाखीन दह ह़ेर आप्‌या।<verse eid="JOS 21:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="JOS 21:6" />अळतेण गेर्‌सोनीयो ने ईस्‌साकार नी जाती ना घोराणा, अने आसेर, अने नप्‌ताली नी जाती ना वाटा मे गेथा, अने मनस्‌से नी तीहया आदी जाती ना वाटा मे गेथा बी जे बासान मे हतो चीट्‌ठी नाख-नाखीन तेरे ह़ेर आप्‌या।<verse eid="JOS 21:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JOS 21:7" />घोराणा नी अनसारे मरारीम रुबेन, गाद, अने जबुलुन ना वाटा मे गेथा बारे ह़ेर आप्‌या।<verse eid="JOS 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JOS 21:8" />जे हुकम यहोवा मुसा नी लारे आपलो तीनी अनसारे ईस्‌रायली लेवीम ने चारवा ना जागा भेळ आहया ह़ेर चीट्‌ठी नाख-नाखीन आप्‌या। <verse eid="JOS 21:8" /><verse number="9" style="v" sid="JOS 21:9" />तीहया यहुदा अने सीमोनीम नी जातीम ना वाटा मे गेथा आहया ह़ेर जीमना नाम लीखला से आप्‌या; <verse eid="JOS 21:9" /><verse number="10" style="v" sid="JOS 21:10" />आहया ह़ेर लेवी कहाती घोराणा मे गेथा हारुन ना घोराणा जुगु हता; काहाके पेली चीट्‌ठी तीमनात नाम पोर नीकळली हती। <verse eid="JOS 21:10" /><verse number="11" style="v" sid="JOS 21:11" />मतलब तीहया तीमने यहुदा ना बड़ा वाळा देस मे च्‌यारो-मेर ना चारवा ना जागा भेळ कीर्‌यतर्‌बा ह़ेर आप देदा, जे अनाक ना बाह अर्‌बा ना नाम पोर केवाय अने हेब्‌रोन बी केवाय। <verse eid="JOS 21:11" /><verse number="12" style="v" sid="JOS 21:12" />पण तीहया ह़ेर ना खेतर अने तीना गाम तीहया यपुन्‌ने ना सोरा कालेब ने तीनो बाह वाटो करीन आप देदा।<verse eid="JOS 21:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JOS 21:13" />ता तीहया हारुन पुंजारा ना घोराणा ने चारवा ना जागा भेळ खुनी ना आसरा ना ह़ेर हेब्‌रोन, अने तीमना-तीमना चारवा ना जागा भेळ लीब्‌ना, <verse eid="JOS 21:13" /><verse number="14" style="v" sid="JOS 21:14" />यत्‌तीर, एस्‌तमो, <verse eid="JOS 21:14" /><verse number="15" style="v" sid="JOS 21:15" />होलोन, दबीर, <verse eid="JOS 21:15" /><verse number="16" style="v" sid="JOS 21:16" />एन, युत्‌ता अने बेतसेमेस आप्‌या; आहयी रीते तीहया बेम जाती ना वाटा मे गेथा नव ह़ेर आप्‌या। <verse eid="JOS 21:16" /><verse number="17" style="v" sid="JOS 21:17" />अने बीन्‌यामीन ना वाटा मे गेथा तीमना-तीमना चारवा ना जागा भेळ आहया च्‌यार ह़ेर आप्‌या, मतलब गीबोन, गेबा, <verse eid="JOS 21:17" /><verse number="18" style="v" sid="JOS 21:18" />अनातोत अने अल्‌मोन। <verse eid="JOS 21:18" /><verse number="19" style="v" sid="JOS 21:19" />आहयी रीते हारुन घोराणा ना पुंजाराम ने तेरे ह़ेर अने तीमनो चारवा नो जागो जड़्‌यो। <verse eid="JOS 21:19" /><verse number="20" style="v" sid="JOS 21:20" />अळतेण बीजा कहाती लेवीम ना घोराणा ना वाटा ना ह़ेर चीट्‌ठी नाख-नाखीन एप्‌रेम नी जाती ना वाटा मे गेथा आप्‌या। <verse eid="JOS 21:20" /><verse number="21" style="v" sid="JOS 21:21" />मतलब तीमने चारवा ना जागा भेळ एप्‌रेम ना बड़ा मे वाळा देस मे खुनी नो आसरो लेवा नु सकेम ह़ेर आप्‌या, अळतेण तीमना-तीमना चारवा ना जागा भेळ गेजेर, <verse eid="JOS 21:21" /><verse number="22" style="v" sid="JOS 21:22" />कीबसेम, अने बेथोरोन; आहया च्‌यार ह़ेर आप्‌या। <verse eid="JOS 21:22" /><verse number="23" style="v" sid="JOS 21:23" />अने दान नी जाती ना वाटा मे गेथो तीमना-तीमना चारवा ना जागा भेळ, एलतके, गीब्‌बतोन, <verse eid="JOS 21:23" /><verse number="24" style="v" sid="JOS 21:24" />अय्‌यालोन, अने गत्‌रीम्‌मोन आहया च्‌यार ह़ेर आप्‌या। <verse eid="JOS 21:24" /><verse number="25" style="v" sid="JOS 21:25" />अने मनस्‌से नु आदु घोराणु ना वाटा मे गेथा तीमना-तीमना चारवा ना जागा भेळ तानाक अने गत्‌रीम्‌मोन; आहया बे ह़ेर आप्‌या। <verse eid="JOS 21:25" /><verse number="26" style="v" sid="JOS 21:26" />आहयी रीते बीजा कहाती जाती ना आखा ह़ेर चारवा ना जागा भेळ दह ठेर्‌या।<verse eid="JOS 21:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="JOS 21:27" />अळतेण लेवीम ना घोराणा मेना गेर्‌सोनीयो ने मनस्‌से नी आदी जाती ना वाटा मे गेथा तीमना-तीमना चारवा ना जागा भेळ खुनी नु आसरा नु ह़ेर बासान नु गोलान अने बेसतरा; आहया बेम ह़ेर आप्‌या। <verse eid="JOS 21:27" /><verse number="28" style="v" sid="JOS 21:28" />अने ईस्‌साकार नी जाती ना वाटा मे गेथो तीमना-तीमना चारवा ना जागा भेळ कीस्‌योन, दाबरत, <verse eid="JOS 21:28" /><verse number="29" style="v" sid="JOS 21:29" />यर्‌मुत, अने एनगन्‌नीम; आहया च्‌यार ह़ेर आप्‌या। <verse eid="JOS 21:29" /><verse number="30" style="v" sid="JOS 21:30" />अने आसेर नी जाती ना वाटा मे गेथा तीमना-तीमना चारवा ना जागा भेळ मीसाल, अब्‌दोन, <verse eid="JOS 21:30" /><verse number="31" style="v" sid="JOS 21:31" />हेल्‌कात, अने रहोब; आहया च्‌यार ह़ेर आप्‌या। <verse eid="JOS 21:31" /><verse number="32" style="v" sid="JOS 21:32" />अने नप्‌ताली नी जाती ना वाटा मे गेथा तीमना-तीमना चारवा ना जागा भेळ खुनी नु आसरा नु ह़ेर गलील नु केदेस, अळतेण हम्‌मोतदोर, अने कर्‌तान; आहया तीन ह़ेर आप्‌या। <verse eid="JOS 21:32" /><verse number="33" style="v" sid="JOS 21:33" />गेर्‌सोनीयो नी जाती नी अनसारे तीमना आखा ह़ेर तीमना-तीमना चारवा ना जागा भेळ तेरे ठेर्‌या। <verse eid="JOS 21:33" /><verse number="34" style="v" sid="JOS 21:34" />अळतेण बीजा लेवी, मतलब मरारी जाती ने जबुलुन नी घोराणा ना वाटा मे गेथा तीमना-तीमना चारवा ना जागा भेळ योकनाम, कर्‌ता, <verse eid="JOS 21:34" /><verse number="35" style="v" sid="JOS 21:35" />दीम्‌ना, अने नहलाल; आहया च्‌यार ह़ेर आप्‌या। <verse eid="JOS 21:35" /><verse number="36" style="v" sid="JOS 21:36" />अने रुबेन ना घोराणा ना वाटा मे गेथा तीमना-तीमना चारवा ना जागा भेळ बेसेर, यहसा, <verse eid="JOS 21:36" /><verse number="37" style="v" sid="JOS 21:37" />कदेमोत, अने मेपात; आहया च्‌यार ह़ेर आप्‌या। <verse eid="JOS 21:37" /><verse number="38" style="v" sid="JOS 21:38" />अने गाद ना घोराणा ना वाटा मे गेथा तीमना-तीमना चारवा ना जागा भेळ खुनी ना आसरा ना ह़ेर गीलाद मे नु रामोत, अळतेण महनेम, <verse eid="JOS 21:38" /><verse number="39" style="v" sid="JOS 21:39" />हेसबोन, अने याजेर, जे आखा मळीन च्‌यार ह़ेर से, आप्‌या। <verse eid="JOS 21:39" /><verse number="40" style="v" sid="JOS 21:40" />लेवीम नी बचली जाती मतलब मरारी नी जाती नी अनसारे तीमना आखा ह़ेर आहयात ठेर्‌या, आहयी रीते तीमने चीट्‌ठी नाखी-नाखीन बारे ह़ेर आप्‌या। <verse eid="JOS 21:40" /><verse number="41" style="v" sid="JOS 21:41" />ईस्‌रायलीम ना ह़ेर नी वचमे लेवीम ना आखा ह़ेर तीमना-तीमना चारवा ना जागा भेळ अड़तालीस ठेर्‌या। <verse eid="JOS 21:41" /><verse number="42" style="v" sid="JOS 21:42" />आहया आखा ह़ेर तीमना-तीमना च्‌यारो-मेर ना चारवा ना जागा भेळ ठेर्‌या; आहया आखा ह़ेर नी आहयीत हालत हती।<verse eid="JOS 21:42" /></para>
  <para style="s">कनान देस पोर ईस्‌रायलीम नो पोर हक</para>
  <para style="p">
    <verse number="43" style="v" sid="JOS 21:43" />आहयी रीते यहोवा ईस्‌रायलीम ने तीहयु आखु देस आप्‌यो, जीने तीहयो तीमना डाह-डाहा ने ह़ाम खाय्‌न आपवा केदलो; अने तीहया तीना हकदार्‌या हय्‌न तीनी मे वह ज्‌या। <verse eid="JOS 21:43" /><verse number="44" style="v" sid="JOS 21:44" />यहोवा तीहयी आखी वात नी अनसारे, जे तीहयो तीमना डाह-डाहा ने ह़ाम खाय्‌न केदलो हतो, तीमने च्‌यारो-मेर गेथो अराम आप्‌यो; अने तीमना वेरी मे गेथु कोय बी तीमनी अगळ टेक नी सक्‌यु; अने यहोवा भगवान तीमने आखा ने तीमना हक मे कर देदो।<verse eid="JOS 21:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="JOS 21:45" />जेतरी भलाय नी वात यहोवा ईस्‌रायलीम ना घोराणा ने केदलो तीहयी वात मे गेथी कानी वात बी नी छुटी; आखीन आखी पुरी हयी।<verse eid="JOS 21:45" /></para>
  <chapter eid="JOS 21" />
  <chapter number="22" style="c" sid="JOS 22" />
  <para style="s">यहोसु उगवणी ह़ोड़ वहला ने पासो जवा केय</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 22:1" />तीहयी टेमे यहोसु रुबेनी, गाद, अने मनस्‌से ना आदा घोराणा ना माणहु ने बोलावीन केदो, <verse eid="JOS 22:1" /><verse number="2" style="v" sid="JOS 22:2" />“जे-जे हुकम यहोवा नो चाकर्‌यो मुसो तमने आपलो तीहया आखा तमु मान्‌ला से, अने जे-जे हुकम मे तमने आपलो से तीमने बी तमु मान्‌ला से;<note caller="+" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="NUM 32:20-32">गीनती 32:20-32</ref>; <ref loc="JOS 1:12-15">यहोसु 1:12-15</ref></char></note> <verse eid="JOS 22:2" /><verse number="3" style="v" sid="JOS 22:3" />तमु आह़फाम ना भाय ने एतरा दाड़ा मे आज तक ना दाड़े तक नी छोड़्‌या, अने आपणा भगवान यहोवा नो हुकम तमु चेतीन रीन मान्‌ला से। <verse eid="JOS 22:3" /><verse number="4" style="v" sid="JOS 22:4" />अने हाव तमारो भगवान यहोवा तमारा भायु ने तीना बोल नी अनसारे अराम आपलो से; एतरे हाव तमु आह़फा-आह़फाम ना पड़ावा मे, अने तमारा जागा मे, जीने यहोवा नो चाकर्‌यो मुसो यरदन नंदीन पार तमने आपलो से, जत रेवो। <verse eid="JOS 22:4" /><verse number="5" style="v" sid="JOS 22:5" />आहयीत वात नी पुरी चोकसी करजो के जे-जे हुकम अने नेम यहोवा नो चाकर्‌यो मुसो तमने आपलो से तीने मानीन आपणा भगवान ह़ाते मोंग राखो, तीनी आखी वाट्‌ये चालो, तीना हुकम ने मानो अने तीनी भक्‌ती करवा मे लागला रेवो, अने खुद ना आखा मन सी अने आखा जीव सी तीनी सेवा करो।” <verse eid="JOS 22:5" /><verse number="6" style="v" sid="JOS 22:6" />ता यहोसु तीमने बरकत आपीन तीमने मोकल देदो अने तीहया तीमना-तीमना पड़ावा मे जत र्‌या। <verse eid="JOS 22:6" /><verse number="7" style="v" sid="JOS 22:7" />मनस्‌से नु आदु घोराणु ने मुसो बासान मे वाटो आपलो हतो; पण बीजा आदा घोराणा ने यहोसु तीमना भायु नी वच मे यरदन नंदी नी बुडवणी ह़ोड़ वाटो आप्‌यो। तीमने जत्‌यार यहोसु मोकल्‌यो के आह़फा-आह़फाम ना पड़ावा मे जाय, <verse eid="JOS 22:7" /><verse number="8" style="v" sid="JOS 22:8" />ता तीमने बी बरकत आपीन केदो, “ढेरेत जानवरु, अने चांदी, ह़ोनु, पीतळ, लुहड़ु, अने ढेरेत लुगड़ा, अने ढेरेत धन-दवल्‌यत लीन आह़फा-आह़फाम ना पड़ावे जत रेवो; अने आपणा वेरी नु लुटलु धन ने खुद ना भायु ह़ाते वाटे लेजो।”<verse eid="JOS 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JOS 22:9" />ता रुबेन, गाद, अने मनस्‌से नु आदु घोराणु ईस्‌रायलीन्‌तां गेथा, मतलब कनान देस ना सीलो ह़ेर मे गेथा, आह़फाम नी गीलाद नाम नी जागा मे, जे मुसा नी लारे आपली यहोवा भगवान ना हुकम नी अनसारे तीमनी जागा हय जेली हती, जवा ना वीच्‌यार सी पासा जत र्‌या।<verse eid="JOS 22:9" /></para>
  <para style="s">यरदन नंदी ना काठे वेदी नु बणावणु</para>
  <para style="p">
    <verse number="10" style="v" sid="JOS 22:10" />जत्‌यार रुबेनी, गादी, अने मनस्‌से नी आदी जाती यरदन नंदी नी तीहयी घाटी मे पुग्‌या जे कनान देस मे से, ता तीहया तां देखवा लायक एक मोट्‌ली वेदी बणाया। <verse eid="JOS 22:10" /><verse number="11" style="v" sid="JOS 22:11" />अने आनी खबर ईस्‌रायलीम ने ह़मळवा मे आयी, के रुबेनी, गादी, अने मनस्‌से नु आदु घोराणु कनान देस अगळ यरदन नंदी नी घाटी मे, मतलब तीनी बीजी धेड़ जे ईस्‌रायलीम नु से, एक वेदी बणाया। <verse eid="JOS 22:11" /><verse number="12" style="v" sid="JOS 22:12" />जत्‌यार ईस्‌रायली आहयु ह़मळ्‌या, ता ईस्‌रायली नी आखी मंडळी तीमनी ह़ाते झुमायवा करीन सीलो मे एकठी हयी। <verse eid="JOS 22:12" /><verse number="13" style="v" sid="JOS 22:13" />ता ईस्‌रायली रुबेनी, गादी, अने मनस्‌से नी आदी जाती ना माणहु गीलाद देस मे एलीयाजार पुंजारा ना सोरा पीनहास ने, <verse eid="JOS 22:13" /><verse number="14" style="v" sid="JOS 22:14" />अने तीनी ह़ाते दह मुख्‌या ने, मतलब ईस्‌रायल मे गेथी एक-एक जाती मे गेथा डाहला ना घोराणा ना एक-एक मुख्‌या ने मोकल्‌या, अने तीहया ईस्‌रायलीम ना हजारो मे आह़फा-आह़फाम ना डाहलाम ना घोराणा ना मुख्‌या अदमी हता। <verse eid="JOS 22:14" /><verse number="15" style="v" sid="JOS 22:15" />तीहया गीलाद देस मे रुबेनी, गादी, अने मनस्‌से नी आदी जातीन्‌तां जाय्‌न केवा बाज ज्‌या, <verse eid="JOS 22:15" /><verse number="16" style="v" sid="JOS 22:16" />“यहोवा नी आखी मंडळी आहयु केय, ‘तमु ईस्‌रायल ना भगवान यहोवा ने धोको देदला से; आज जे तमु एक वेदी बणाय लेदला से, आनी मे तमु तीनी पसळ चालवा छोड़ीन तीना वीरोद मे झगड़ो करला से?<note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="DEU 12:13">वेवस्‌थावीवरन 12:13</ref>,<ref loc="DEU 12:14">14</ref></char></note> <verse eid="JOS 22:16" /><verse number="17" style="v" sid="JOS 22:17" />ह़मळो, पोर ह़ेर मे नो अधरम आपणी जुगु ह़ु कम हतो, ते बी यहोवा नी मंडळी ने घणो डंड जड़्‌यो ते बी आज ना दाड़े तक आमु तीहया अधरम सी चोखा नी हया; तीहयी वात तमारी नींगा मे नानी से ह़ु।<note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="NUM 25:1-9">गीनती 25:1-9</ref></char></note> <verse eid="JOS 22:17" /><verse number="18" style="v" sid="JOS 22:18" />के आज तमु यहोवा ने छोड़ीन तीनी पसळ चालवा छोड़ र्‌या? आज तमु यहोवा भणी गेथा फीर जेला से, अने वाहणे तीहयो ईस्‌रायली नी आखी मंडळी पोर रीह करहे। <verse eid="JOS 22:18" /><verse number="19" style="v" sid="JOS 22:19" />पण कदीम तमारी जागा वीटळ्‌ळी हय, ता पार आवीन यहोवा नी जागा मे, जां ह़ारीक यहोवा नु रेवा नु से, अमारी वच मे आह़फा-आह़फाम नी जागा हात कर लेवो; पण अमारा भगवान नी वेदी छोड़ीन अळी बीजी वेदी बणाय्‌न नी ते यहोवा ह़ाते झगड़ो करो अने नी अमारी ह़ाते। <verse eid="JOS 22:19" /><verse number="20" style="v" sid="JOS 22:20" />देखो, जत्‌यार जेरह नो सोरो आकान ह़ोपली चीज ना बारा मे धोको देदो, ता ह़ु यहोवा ईस्‌रायल नी आखी मंडळी पोर रीह नी कर्‌यो? अने तीहया माणेह ना अधरम नो मोत नो डंड एखला ने नी जड़्‌यो पण बीजा माणहु ने बी जड़्‌यो।’”<note caller="+" style="x"><char style="xo" closed="false">22:20 </char><char style="xt" closed="false"><ref loc="JOS 7:1-26">यहोसु 7:1-26</ref></char></note><verse eid="JOS 22:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="JOS 22:21" />ता रुबेनी, गाद, अने मनस्‌से नी आदी जाती ईस्‌रायल ना हजारो ना मुख्‌या माणहु ने आहयो जपाप आप्‌या, <verse eid="JOS 22:21" /><verse number="22" style="v" sid="JOS 22:22" />“यहोवा भगवान जे भगवान नो भगवान से, भगवान नो भगवान यहोवा आने जाणे, अने ईस्‌रायली बी आने जाण लेहे के कदीम यहोवा भणी गेथा फीरीन नीता तीनी ह़ाते धोको तोड़ीन आमु आहयु काम कर्‌या हय, ता तु आज आमने जीवत्‌ला ना छोड़े, <verse eid="JOS 22:22" /><verse number="23" style="v" sid="JOS 22:23" />कदीम आज ना दाड़े आमु वेदी ने आनीन करते बणाया हय के यहोवा पसळ चालवा छोड़ दीया, नीता आनीन करते के तीनी पोर होम बादा, अनबादा, नीता मेल-मीलाप नी बादा चड़ावे, ता यहोवा खुद आनो हीसाब लेय; <verse eid="JOS 22:23" /><verse number="24" style="v" sid="JOS 22:24" />पण आमु आहयात वीच्‌यार अने मन सी आहयु करला से के कंय माय्‌न अगा चालीन तमारी अवल्‌यात अमारी अवल्‌यात ने आहयु नी केवा बाज जाय, ‘तमु ने ईस्‌रायल ना भगवान यहोवा ह़ाते ह़ु काम? <verse eid="JOS 22:24" /><verse number="25" style="v" sid="JOS 22:25" />काहाके, ए रुबेनी, ए गादी, यहोवा जे अमारी अने तमारी वचमे यरदन नंदी ने काकड़ ठेरावला से, एतरे यहोवा मे तमारो कंय बी वाटो नी हय।’ आसम कीन तमारी अवल्‌यात अमारी अवल्‌यात मे गेथी यहोवा नी बीक ने सेटी कर देहे। <verse eid="JOS 22:25" /><verse number="26" style="v" sid="JOS 22:26" />एतरे आमु केदा, ‘आवो, आमु आपणी जुगु एक वेदी बणाय लीया, तीहयी होम बादा नीता मेलबादा जुगु नी, <verse eid="JOS 22:26" /><verse number="27" style="v" sid="JOS 22:27" />पण आनीन करते के अमारी अने तमारी, अने अमारीन अळतेण अमारी अने तमारी जाती नी वच मे गवा नी सेलाणी बणे; आनीन करते के आमु होम बादा, मेल-मीलाप नी बादा, अने बादा चड़ावीन यहोवा अगळ तीनी बड़ाय करे; अने अगा चालीन तमारी अवल्‌यात अमारी अवल्‌यात ने आहयु नी केवा जोवे, के यहोवा मे तमारो कंय बी वाटो नी हय।’ <verse eid="JOS 22:27" /><verse number="28" style="v" sid="JOS 22:28" />एतरे आमु केदा, ‘जत्‌यार तीहया माणहु अगा चालीन आमु ने नीता अमारी जाती ने आसम केवा बाज जाय, ता आमु तीमने केहु, के यहोवा नी वेदीन तेवी बीजी बणावली वेदी ने देखो, जीने अमारा आड़ा-बुड़ा होम बादा नीता मेलबादा जुगु नी बणाया; पण आनीन करते बणावला हता के अमारी अने तमारी वच मे गवाय नी सेलाणी बणे।’ <verse eid="JOS 22:28" /><verse number="29" style="v" sid="JOS 22:29" />आहयु अमारी गेथु सेटु रेवा जोवे के यहोवा भणी गेथा फीरीन आज तीनी पसळ चालवा छोड़ दीया, अने आपणा यहोवा नी वेदी ने छोड़ीन जे तीना रेवा ना जागा अगळ से होम बादा, अने अनबादा नीता मेलबादा जुगु बीजी वेदी बणावया।”<verse eid="JOS 22:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="JOS 22:30" />रुबेनी, गादी अने मनस्‌से नी आदी जाती ना माणहु आहयी वात ने ह़मळीन पीनहास पुंजारो अने तीनी ह़ाते मंडळी ना मुख्‌या, जे ईस्‌रायल ना हजारो ना मुख्‌या अदमी हता, तीहया घणा खुस हया। <verse eid="JOS 22:30" /><verse number="31" style="v" sid="JOS 22:31" />अने एलीयाजार पुंजारा नो सोरो पीनहास रुबेनी, गादी, अने मनस्‌से माणहु ने केदो, “तमु जे यहोवा नो आसम भरहो नी तोड़्‌या, आनी सी आमु आज आहयु जाण लेदा के यहोवा अमारी वच मे से: अने तमु ईस्‌रायलीम ने यहोवा ना हात सी गुनेगार ठेरवा सी बचाड़ला से।” <verse eid="JOS 22:31" /><verse number="32" style="v" sid="JOS 22:32" />ता एलीयाजार पुंजारा नो सोरो पीनहास मुख्‌या भेळ रुबेनी अने गादी माणहुन्‌तां गेथो गीलाद मे हय्‌न कनान देस मे ईस्‌रायलीम ने तां पासो जत र्‌यो: अने आहयी वात तीमने आखा ने ह़मळायो। <verse eid="JOS 22:32" /><verse number="33" style="v" sid="JOS 22:33" />ता ईस्‌रायली आखा खुस हया; अने यहोवा ने जुगाळो से केदा, अने रुबेनी अने गादी माणहु ह़ाते झुमायवा अने तीमनु रेवा नु देस उजाड़वा करीन झुमायवा नी वात अळी नी कर्‌या। <verse eid="JOS 22:33" /><verse number="34" style="v" sid="JOS 22:34" />अने रुबेनी अने गादी माणहु आहयु कीन, “आहयी वेदी अमारी अने तीमनी वच मे आहयी वात नी गवा ठेरली से, के यहोवा भगवानेत भगवान से।” तीहयी वेदी नु नाम एद<note caller="+" style="f"><char style="fr" closed="false">22:34 </char><char style="ft" closed="false">मतलब, गवा</char></note> पाड़्‌या।<verse eid="JOS 22:34" /></para>
  <chapter eid="JOS 22" />
  <chapter number="23" style="c" sid="JOS 23" />
  <para style="s">यहोसु नो आखरी परच्‌यार</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 23:1" />आनीन ढेरेत दाड़ान अळतेण, जत्‌यार यहोवा ईस्‌रायलीम ने तीमना च्‌यारो-मेर ना वेरी सी अराम आप्‌यो, अने यहोसु डायलो अने घणी उमर नो हय ज्‌यो, <verse eid="JOS 23:1" /><verse number="2" style="v" sid="JOS 23:2" />ता यहोसु आखा ईस्‌रायलीम ने, मतलब डायला, मुख्‌या माणहु, अने नीयाव करन्‌या, अने अदीकार्‌या ने बोलावीन केवा बाज ज्‌यो, “मे ते हाव डायो अने घणी उमर नो हय जेलो से; <verse eid="JOS 23:2" /><verse number="3" style="v" sid="JOS 23:3" />अने तमु देखला से के तमारो भगवान यहोवा तमारी जुगु आहयी आखी जाती ह़ाते ह़ु-ह़ु करलो से, काहाके जे तमारी भणी गेथो झुमायतो आय र्‌यो तीहयो तमारो भगवान यहोवा से। <verse eid="JOS 23:3" /><verse number="4" style="v" sid="JOS 23:4" />देखो, मे आहयी बचली जातीम ने चीट्‌ठी नाखी-नाखीन तमने वाट देदलो से; अने यरदन नंदी गेथो लगाड़ीन उगवणी ह़ोड़ नी मोट्‌ली दर्‌या तक रेवा वाळी तीहयी आखी जातीम ने बी आसमेत आपलो से, जीमने मे काट देदलो से। <verse eid="JOS 23:4" /><verse number="5" style="v" sid="JOS 23:5" />अने तमारो भगवान यहोवा तीमने तमारी अगळ गेथा तीमना देस मे गेथा नीकाळ देहे; अने तमु आपणा यहोवा ना बोल नी अनसारे तीमना देस ना अदीकार्‌या हय जहु। <verse eid="JOS 23:5" /><verse number="6" style="v" sid="JOS 23:6" />एतरे घण जबर हीम्‌मत राखीन, जे कंय मुसा नी नेम नी कीताप मे लीखलु से तीने पुरु करवा करीन चोकसी करजो, तीनी गेथा नी ते डाखरी ह़ोड़ वळजो अने नी ते जमणी ह़ोड़ वळजो। <verse eid="JOS 23:6" /><verse number="7" style="v" sid="JOS 23:7" />आहयी जाती जे तमारी वचमे री जेली से आमनी वचमे नी जजो, अने नी आमना देवताम ना नामु नी वात करजो, अने नी आमनी ह़ाम खवाड़जो, अने नी आमनो उपाह पाळजो अने नी आमने वांदजो, <verse eid="JOS 23:7" /><verse number="8" style="v" sid="JOS 23:8" />पण जेम आज ना दाड़े तक तमु आपणा भगवान यहोवा नी भक्‌ती मे लागला री र्‌या, तेमेत रीया करजो। <verse eid="JOS 23:8" /><verse number="9" style="v" sid="JOS 23:9" />यहोवा तमारी अगळ गेथी मोट्‌ली-मोट्‌ली अने ताखत वाळी जाती ने नीकाळलो से; अने तमारी अगळ आज तक कोय बी उबु नी री सक्‌यु। <verse eid="JOS 23:9" /><verse number="10" style="v" sid="JOS 23:10" />तमारी मे गेथो एक माणेह हजार माणहु ने नहाड़हे, काहाके तमारो भगवान यहोवा आह़फा ना बोल नी अनसारे तमारी लेदे झुमाय।<note caller="+" style="x"><char style="xo" closed="false">23:10 </char><char style="xt" closed="false"><ref loc="DEU 3:22">वेवस्‌थावीवरन 3:22</ref>; <ref loc="DEU 32:30">32:30</ref></char></note> <verse eid="JOS 23:10" /><verse number="11" style="v" sid="JOS 23:11" />करीन आपणा भगवान यहोवा ह़ाते मोंग राखवा नो पुरो ध्‌यान राखजो। <verse eid="JOS 23:11" /><verse number="12" style="v" sid="JOS 23:12" />काहाके कदीम तमु आनी रीते यहोवा भगवान भणी गेथा फीरीन आहयी जाती ना बीजा माणहु ह़ाते भेसकायवा बाज जावो जे तमारी वच मे बच र्‌या, अने आमनी ह़ाते वेवा करीन आमनी ह़ाते सवसार नो रीस्‌तो जोड़ो, <verse eid="JOS 23:12" /><verse number="13" style="v" sid="JOS 23:13" />ता पक्‌का जाण लेवो अगा चालीन तमारो भगवान यहोवा आहयी जाती ने तमारी अगळ गेथी नी नीकाळे; अने आहयी तमारी जुगु जाळ, फंदा, अने तमारा वाहां जुगु ह़ड़का, अने तमारा डोळा मे काटा ठेरहे, अने आखरी मे तमु आहयी वारली जागा पोर गेथा जे तमारो भगवान यहोवा तमने आपलो से खत्‌तम हय जहु।<verse eid="JOS 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 23:14" />“देखो, मे हाव मोत नी वाटे से, जीनी पोर आखा ने चालवा नु से। अने तमु आखा आह़फा-आह़फाम ना मन मे जाणो, के जेतरी भलाय नी वात अमारो भगवान यहोवा अमारा बारा मे केदो तीमनी मे गेथी एक बी पुरी हया वगर नी री; तीहयी आखीन आखी तमारी पोर पुरी हय जेली से, तीमनी मे गेथी एक बी पुरी हया वगर नी री। <verse eid="JOS 23:14" /><verse number="15" style="v" sid="JOS 23:15" />ता जेम तमारा भगवान यहोवा नी केदली आखी भलाय नी वात तमारी ह़ाते पुरी हयली से; तेमेत यहोवा भगवान गरा नी आखी वात तमारी पोर लावहे अने तमु ने आहयी वारली जागा पोर गेथो, जीने तमारो यहोवा भगवान तमने आपलो से, खत्‌तम कर देहे। <verse eid="JOS 23:15" /><verse number="16" style="v" sid="JOS 23:16" />जत्‌यार तमु तीहया वायदा ने, जीने तमारो भगवान यहोवा तमने हुकम आपीन आह़फा नी ह़ाते बंदाड़लो से, तोड़ीन बीजा देवताम नी बड़ाय अने तीमने वांदवा बाज जावो, ता यहोवा भगवान नी रीह तमारी उपर आय लागहे, अने तमु आहया वारला देस मे गेथा जीने तीहयो तमने आपलो से सोटात खत्‌तम हय जहु।”<verse eid="JOS 23:16" /></para>
  <chapter eid="JOS 23" />
  <chapter number="24" style="c" sid="JOS 24" />
  <para style="s">यहोसु नो सकेम माणहु जुगु आखरी परच्‌यार</para>
  <para style="p">
    <verse number="1" style="v" sid="JOS 24:1" />अळतेण यहोसु ईस्‌रायली ना आखा घोराणा ने सकेम मे एक्‌ठा कर्‌यो, अने ईस्‌रायल ना डायला माणहु अने मुख्‌या अदमी, अने नीयाव करन्‌या, अने सरदारु ने बोलायो; अने तीहया भगवान अगळ हजुर हया। <verse eid="JOS 24:1" /><verse number="2" style="v" sid="JOS 24:2" />ता यहोसु तीहया आखा माणहु ने केदो, ईस्‌रायल नो भगवान यहोवा आहयी रीते केय, पेल्‌ना वारा मे अब्‌राहम अने नाहोर नो बाह तेरह अने, तमारा आड़ा-बुड़ा मोट्‌ली नंदी फरात नी ह़ेली धेड़े रेता जाय्‌न बीजा देवताम नो उपाह पाळता हता।<note caller="+" style="x"><char style="xo" closed="false">24:2 </char><char style="xt" closed="false"><ref loc="GEN 11:27">उबजणाय कीताप 11:27</ref></char></note> <verse eid="JOS 24:2" /><verse number="3" style="v" sid="JOS 24:3" />अने मे तमारा डायला माणेह अब्‌राहम ने मोट्‌ली नंदीन पार गेथो लावीन कनान देस ना आखा जागा मे फीरव्‌यो, अने तीनु घोराणु बड़ा‌यो। अने तीने ईसाक ने आप्‌यो;<note caller="+" style="x"><char style="xo" closed="false">24:3 </char><char style="xt" closed="false"><ref loc="GEN 12:1-9">उबजणाय कीताप 12:1-9</ref>; <ref loc="GEN 21:1-3">21:1-3</ref></char></note> <verse eid="JOS 24:3" /><verse number="4" style="v" sid="JOS 24:4" />अळतेण में ईसाक ने याकुब अने एसाव आप्‌यो।<note caller="+" style="x"><char style="xo" closed="false">24:4 </char><char style="xt" closed="false"><ref loc="GEN 25:24-26">उबजणाय कीताप 25:24-26</ref>; <ref loc="GEN 36:8">36:8</ref>; <ref loc="GEN 46:1-7">46:1-7</ref>; <ref loc="DEU 2:5">वेवस्‌थावीवरन 2:5</ref></char></note> अने एसाव ने में सेईर नाम नु बड़ा वाळु देस आप्‌यो के तीहयो तीनो अदीकारी हये, पण याकुब सोरा अने सोरा ना सोरा भेळ मीस्‌र मे ज्‌यो। <verse eid="JOS 24:4" /><verse number="5" style="v" sid="JOS 24:5" />अळतेण मे मुसा ने अने हारुन ने मोकलीन तीहया आखा कामु नी लारे जीमने मे मीस्‌र मे कर्‌यो, तीहया देस ने मार्‌यो; अने तीनीन अळतेण तमने नीकाळ लायो। <verse eid="JOS 24:5" /><verse number="6" style="v" sid="JOS 24:6" />अने मे तमारा आड़ा-बुड़ा ने मीस्‌र मे गेथो नीकाळ लायो, अने तमु रात्‌ली दर्‌यान्‌तां पुग्‌या; अने मीस्‌री माणहु घोड़ागाड्‌या अने बहण्‌या ने ह़ाते लीन रात्‌ली दर्‌या तक तमारी पसळ पड़्‌या, <verse eid="JOS 24:6" /><verse number="7" style="v" sid="JOS 24:7" />अने जत्‌यार तमु यहोवा ने आड़्‌या ता तीहयो तमारी अने मीस्‌री माणहु नी वच मे अंदारु कर देदो, अने तीमनी पोर दर्‌या नु पाणी वयाड़ीन तीमने डुबाड़ नाख्‌यो; अने जे कंय मे मीस्‌र मे कर्‌यो तीने तमु तमारा डोळे देख्‌या; “‘अळतेण तमु घणा दाड़ा तक जंगल मे र्‌या।<note caller="+" style="x"><char style="xo" closed="false">24:7 </char><char style="xt" closed="false"><ref loc="EXO 14:1-31">नीरगमन 14:1-31</ref></char></note> <verse eid="JOS 24:7" /><verse number="8" style="v" sid="JOS 24:8" />जत्‌यार मे तमने तीहया एमोरीम ना देस मे ली आयो, जे यरदन नंदीन ह़ेली धेड़े वहला हता; अने तीहया तमारी ह़ाते झुमाया, अने मे तीमने तमारा हक मे कर देदो, अने तमु तीमना देस ना हकदार्‌या हय ज्‌या, अने मे तीमने तमारी अगळ गेथा खत्‌तम कर देदो।<note caller="+" style="x"><char style="xo" closed="false">24:8 </char><char style="xt" closed="false"><ref loc="NUM 21:21-35">गीनती 21:21-35</ref></char></note> <verse eid="JOS 24:8" /><verse number="9" style="v" sid="JOS 24:9" />अळतेण मोवाब नो राजा सीप्‌पोरा नो सोरो बालाक तमारी ह़ाते आवीन झुमायो; अने तमने सराप देवा करीन बोर ना सोरा बीलाम ने बोलावो मोकल्‌यो,<note caller="+" style="x"><char style="xo" closed="false">24:9 </char><char style="xt" closed="false"><ref loc="NUM 22:1-24:25">गीनती 22:1–24:25</ref></char></note> <verse eid="JOS 24:9" /><verse number="10" style="v" sid="JOS 24:10" />पण मे बीलाम नी, नी ह़मळ्‌यो; तीहयो तमने बरकतेत बरकत आपतो ज्‌यो; आहयी रीते मे तमने तीना हात सी बचाड़्‌यो।<note caller="+" style="x"><char style="xo" closed="false">24:10 </char><char style="xt" closed="false"><ref loc="NUM 22:1-24:25">गीनती 22:1–24:25</ref></char></note> <verse eid="JOS 24:10" /><verse number="11" style="v" sid="JOS 24:11" />ता तमु यरदन नंदी पार हय्‌न यरीहो ह़ेर ने तां आया, अने जत्‌यार यरीहो ह़ेर ना माणहु, अने एमोरी, परीज्‌जी, कनानी, हीत्‌ती, गीर्‌गासी, हीब्‌बी, अने यबुसी, तमारी ह़ाते झुमाया, ता मे तीमने तमारा हक मे कर देदो। <verse eid="JOS 24:11" /><verse number="12" style="v" sid="JOS 24:12" />अने मे तमारी अगळ मतवाली ने मोकल्‌यो, अने तीहया एमोरी ना बेम राजा ने तमारी अगळ गेथा नहाड़ देदो; देखो, आहयु तमारी तलवार वेर नीता धंदली वेर करलु काम नी हतु।<note caller="+" style="x"><char style="xo" closed="false">24:12 </char><char style="xt" closed="false"><ref loc="EXO 23:28">नीरगमन 23:28</ref>; <ref loc="DEU 22:20">वेवस्‌थावीवरन 22:20</ref></char></note> <verse eid="JOS 24:12" /><verse number="13" style="v" sid="JOS 24:13" />अळतेण मे तमने एवु देस आप्‌यो जीनी मे तमु अराम नी कर्‌या, अने एवा ह़ेर बी आपलो से जीने तमु नी वहाड़ला हता, अने तमु तीनी मे वह र्‌या; अने जे अंगुर अने जेतुन ना बगीचा ना फोळ तमु खावो तीमने तमु नी चोप्‌या।’<note caller="+" style="x"><char style="xo" closed="false">24:13 </char><char style="xt" closed="false"><ref loc="DEU 6:10-11">वेवस्‌थावीवरन 6:10-11</ref></char></note><verse eid="JOS 24:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JOS 24:14" />“एतरे हाव यहोवा नी बीक मानीन,” तीनी सेवा खराय अने सच्‌चाय सी करो, “अने जे देवताम नी सेवा तमारा आड़ा-बुड़ा मोट्‌ली नंदीन ह़ेली धेड़े अने मीस्‌र मे करता हता, तीमने सेटा करीन यहोवा नी सेवा करो। <verse eid="JOS 24:14" /><verse number="15" style="v" sid="JOS 24:15" />अने कदीम यहोवा नी सेवा करवा तमने बुरु लागे, ता आज तमु ठान लेवो के तमु कोयनी सेवा करहु, भले तीहया देवताम नी जीमनी सेवा तमारा आड़ा-बुड़ा मोट्‌ली नंदीन ह़ेली पार करता हता, अने भले एमोरीम ना देवताम नी सेवा करो जीमना देस मे तमु रेवो; पण मे ते मारु घोराणु भेळ यहोवा नीत सेवा जलम करही।”<verse eid="JOS 24:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JOS 24:16" />ता माणहु जपाप आप्‌या, “यहोवा ने छोड़ीन बीजा देवताम नी सेवा करवा अमारी गेथु सेटु रेय; <verse eid="JOS 24:16" /><verse number="17" style="v" sid="JOS 24:17" />काहाके अमारो भगवान यहोवा तीहयोत से जे आमु ने अने अमारा आड़ा-बुड़ाम ने गुलामी ना घोर, मतलब मीस्‌र देस मे गेथो नीकाळ लायो, अने अमारा देखणते-देखणते मोट्‌ला-मोट्‌ला वहराड़न्‌या काम कर्‌यो, अने जे वाटे अने जेतरी जाती नी वचमे आमु चालीन आवता हता तीमनी सी अमारी रखवाळी कर्‌यो; <verse eid="JOS 24:17" /><verse number="18" style="v" sid="JOS 24:18" />अने अमारी अगळ गेथो आहया देस मे रेवा वाळी एमोरी अने आखी जाती ने नीकाळ देदलो से; एतरे आमु बी यहोवा नी सेवा करहु, काहाके अमारो भगवान तीहयोत से।”<verse eid="JOS 24:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JOS 24:19" />यहोसु माणहु ने केदो, “तमने यहोवा नी सेवा नी हये; काहाके तीहयो चोखलो भगवान से; तीहयो रीह राखवा वाळो भगवान से; तीहयो तमारा पाप अने गुना ने माफ नी करे। <verse eid="JOS 24:19" /><verse number="20" style="v" sid="JOS 24:20" />कदीम तमु यहोवा ने सोड़ीन बीजा देवताम नी सेवा करवा बाज जहु, ता तीहयो तमारु भलु करतो आय र्‌यो ते बी फीरीन तमारु नुकसान करहे, अने तमने खत्‌तम बी कर देहे।” <verse eid="JOS 24:20" /><verse number="21" style="v" sid="JOS 24:21" />माणहु केदा, “नी आमु यहोवा नीत सेवा करहु।” <verse eid="JOS 24:21" /><verse number="22" style="v" sid="JOS 24:22" />यहोसु माणहु ने केदो, “तमु आह़फात तमारी गवा से के तमु यहोवा नी सेवा करवा ठान लेदला से।” तीहया केदा, “होव, आमु गवा से।” <verse eid="JOS 24:22" /><verse number="23" style="v" sid="JOS 24:23" />यहोसु केदो, “आपणी वच मे गेथा बीजा देवताम ने सेटा करीन,” आपणु-आपणु “मन ईस्‌रायल ना भगवान यहोवा भणीन लगाड़ो।” <verse eid="JOS 24:23" /><verse number="24" style="v" sid="JOS 24:24" />माणहु यहोसु ने केदा, “आमु ते आपणा भगवान यहोवा नीत सेवा करहु, अने तीनीन वात मानहु।”<verse eid="JOS 24:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JOS 24:25" />ता यहोसु तीहयात दाड़े तीहया माणहु पांह वायदो करायो, अने सकेम मे तीमनी जुगु रीती-भाती अने नेम ठेराया।<verse eid="JOS 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JOS 24:26" />आहयी आखी वात यहोसु भगवान नी नेम नी कीताप मे लीख देदो; अने एक मोट्‌लो दगड़ो टाळीन तां तीहया वांज्‌या झाड़ तळे उबो कर्‌यो, जे यहोवा ना चोखला जागा मे हतु। <verse eid="JOS 24:26" /><verse number="27" style="v" sid="JOS 24:27" />ता यहोसु आखा माणहु ने केदो, “ह़मळो, आहयो दगड़ो अमारी गवा रेहे, काहाके जे बोलु यहोवा आमु ने केदलो से तीमने आहयो दगड़ो ह़मळलो से; एतरे आहयो तमारी गवा रेहे, आसम नी हये के तमु आपणा भगवान गेथा पासा वळ जावो।” <verse eid="JOS 24:27" /><verse number="28" style="v" sid="JOS 24:28" />ता यहोसु माणहु ने आह़फा-आह़फाम ना खुद ना वाटा पोर जवा करीन मोकल देदो।<verse eid="JOS 24:28" /></para>
  <para style="s">यहोसु अने एलीयाजार नी मोत</para>
  <para style="p">
    <verse number="29" style="v" sid="JOS 24:29" />आहयी वात ने अळतेण यहोवा नो चाकर्‌यो, नुन नो सोरो यहोसु, एक ह़ो दह साल नो हय्‌न मर ज्‌यो। <verse eid="JOS 24:29" /><verse number="30" style="v" sid="JOS 24:30" />अने तीने तीनात वाटा तीन्‌मत्‌सेरह ह़ेर मे वगे कर्‌या। जे एप्‌रेम ना बड़ा वाळा देस मे गास नाम ना बड़ा नी धुराव भणीन से।<note caller="+" style="x"><char style="xo" closed="false">24:30 </char><char style="xt" closed="false"><ref loc="JOS 19:49">यहोसु 19:49</ref>,<ref loc="JOS 19:50">50</ref></char></note><verse eid="JOS 24:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="JOS 24:31" />यहोसु नी आखी जीवाय मे, अने जे मुख्‌या माणहु यहोसुन मरवान अळतेण जीवत्‌ला र्‌या अने जाणता हता के यहोवा ईस्‌रायली जुगु केवा-केवा काम करलो हतो, तीमनी बी आखी जीवाय मे ईस्‌रायल ना माणहु यहोवा नीत सेवा करता र्‌या।<verse eid="JOS 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="JOS 24:32" />अळतेण युसुफ ना हाटका जे ईस्‌रायली मीस्‌र मे गेथा ली आवला हता तीहया सकेम नी जागा मे तीहया वाटा मे गाड़्‌या, जीने याकुब सकेम ना बाह हमोर ना सोरा पांह एक ह़ो चांदी ना सीक्‌का वेर वेचाती लेदलो हतो; एतरे तीहयो युसुफ नी अवल्‌यात नो वाटो बण ज्‌यो।<verse eid="JOS 24:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="JOS 24:33" />हारुन नो सोरो एलीयाजार बी मर ज्‌यो; अने तीने एप्‌रेम ना बड़ा वाळा देस मे गीबा ह़ेर मे वगे कर्‌या, जे तीना सोरा पीनहास ने आपला हता।<verse eid="JOS 24:33" /></para>
  <chapter eid="JOS 24" />
</usx>