<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2JN" style="id">- Paliya Project</book>
  <para style="h">2 युहन्‌ना</para>
  <para style="toc3">2 युहन्‌ना</para>
  <para style="toc2">2 युहन्‌ना</para>
  <para style="toc1">युहन्‌ना नी बीजी चीट्‌ठी</para>
  <para style="mt2">युहन्‌ना की दुसरी पत्री</para>
  <para style="mt1">युहन्‌ना नी बीजी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">युहन्‌ना नी पेल्‌नी चीट्‌ठी नेवताळो युहन्‌नो ईसुन पयदा हयवान 50-100 साल नी वच मे लीख्‌यो, युहन्‌नो आह़फा ने लीखण्‌यो नी केवाड़तो पण डायलो केय। युहन्‌ना नी अनसारे खुस-खबर नी वात 2 युहन्‌ना नी वात ने तेवीत से। आहयु उजन्‌तु से के जीसम तीहयो एक-बीजा ने मोंग करवा नी लेदे ईसु ना हुकम आपे, अने जीसम तीहयो तीना हुकम ने मानीन ईसु सी मोंग करे <char style="xt"><ref loc="2JN 1:5-6">1:5-6</ref></char> <char style="xt"><ref loc="JHN 15:9-10">युहन्‌ना 15:9-10</ref></char> आहयु माने के युहन्‌ना नी लारे खुस-खबर लीखलो से, तीहयी तीन चीट्‌ठी ईफीसुस मे रीन लीखलो से, 1 युहन्‌ना 2 युहन्‌ना 3 युहन्‌ना से।</para>
  <para style="ip">युहन्‌नो आहयी चीट्‌ठी मे टावली बयर अने तीना सोरा ना बारा मे देखाड़े। तीहयो एक मंडळी ना बारा मे देखाड़तो हतो। आहयी चीट्‌ठी लीखवा मे युहन्‌ना नो मकसत मंडळी ने खुस करवा अने झुटी ह़ीकापण आपण्‌या ने चेतावणी आपवा हतो।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. युहन्‌नो आहयु कीन चीट्‌ठी लीख्‌यो के आहयी कोय नी लेदे से, अने जे लेय तीमने घणो वारु केय। <char style="ior"><ref loc="2JN 1:1-3">1:1-3</ref></char></para>
  <para style="io1">2. अळी तीहयो मंडळी ने खुस करे, अने तीमने मोट्‌ला हुकम ने फोम करावे। <char style="ior"><ref loc="2JN 1:4-6">1:4-6</ref></char></para>
  <para style="io1">3. अळतेण तीहयो झुटा ह़ीकाड़न्‌या ने चेतावणी आपे। <char style="ior"><ref loc="2JN 1:7-11">1:7-11</ref></char></para>
  <para style="io1">4. युहन्‌नो मंडळी ना भरहो करन्‌या माणहु ने खबर आपीन वारला से केय, अने आह़फा नी चीट्‌ठी खत्‌तम करे। <char style="ior"><ref loc="2JN 1:12-13">1:12-13</ref></char></para>
  <chapter number="1" style="c" sid="2JN 1" />
  <para style="p">
    <verse number="1" style="v" sid="2JN 1:1" />मे पेल्‌ना वारा नी टाळली बयर अने तीनी अवल्‌यात ने, तीना सोरा ना नामे जीनी सी मे खरलो मोंग करु पण मे एतरोत नी पण तीहया आखा बी मोंग करे जे सच्‌चाय ने जाणे। <verse eid="2JN 1:1" /><verse number="2" style="v" sid="2JN 1:2" />तीहयी सच्‌चाय जे अमारी मे टेकली रेय, अने जलम अमारी ह़ाते रेहे।<verse eid="2JN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2JN 1:3" />बाह भगवान, अने तीना सोरा ईसु मसी भणी गेथी संयबरकत, दया, सांती, अने सच्‌चाय, मोंग भेळ आपणी ह़ाते रेहे।<verse eid="2JN 1:3" /></para>
  <para style="s">सच्‌चाय अने मोंग</para>
  <para style="p">
    <verse number="4" style="v" sid="2JN 1:4" />मे घणो खुस हयो, के मे तारा केतरा सोरा-सोरी ने तीहया हुकम ना अनसारे, जे आपणु ने बाह भणी गेथी जड़ली हती सच्‌चाय पोर चालत्‌ला देख्‌यो। <verse eid="2JN 1:4" /><verse number="5" style="v" sid="2JN 1:5" /><note caller="+" style="x"><char style="xo" closed="false">1:5 </char><char style="xt" closed="false"><ref loc="JHN 13:34">युहन्‌ना 13:34</ref>; <ref loc="JHN 15:12">15:12</ref>,<ref loc="JHN 15:17">17</ref></char></note>ए बयर, मे तने काना नवला हुकम नी, पण तीहयात जे सुरु गेथा अमारी पांह से, लीखु; अने तारी सी वीन्‌ती करु के आपणु एक-बीजा सी मोंग करया। <verse eid="2JN 1:5" /><verse number="6" style="v" sid="2JN 1:6" />अने मोंग आहयो से के आमु भगवान ना हुकम ना अनसारे चाले: आहया तीहयात हुकम से, जे तमु सुरु मे ह़मळला से अने तमने आहया हुकम नी अनसारे चालवा बी जोवे।<verse eid="2JN 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="2JN 1:7" />काहाके घणा भटकाड़वा वाळा आहयी कळी मे आय लागला से, जे आहयु नी मान्‌ता, के ईसु मसी डील मे हय्‌न आयो: भटकाड़वा वाळा अने मसी नो वीरोदी आहयोत से। <verse eid="2JN 1:7" /><verse number="8" style="v" sid="2JN 1:8" />आह़फा ना बारा मे चेतीन रेवो; के जे मेहनत आमु करला से, तीने तमु ना बगाड़ो: पण तीनो पुरो फोळ हात करो।<verse eid="2JN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="2JN 1:9" />जे कोय मसी नी ह़ीकापण मे नी रेय, अने ईसु मसी नी ह़ीकापण पोर बणीन नी रेय, तीनी पांह भगवान नी हय: जे कोय तीनी ह़ीकापण पोर टेकलो रेय, तीनी पांह बाह बी से, अने बेटो बी से। <verse eid="2JN 1:9" /><verse number="10" style="v" sid="2JN 1:10" />कदीम कोय तमारी पांह आवे, आहयीत ह़ीकापण नी आपे, तीने नी ते घोर मे आव्‌वा देवो, अने ना वारलो से के करीन केवो। <verse eid="2JN 1:10" /><verse number="11" style="v" sid="2JN 1:11" />काहाके जे कोय एवा माणेह ने वारलो से के करीन केय, तीहयो तीना गलत कामु मे साजल्‌यो रेय।<verse eid="2JN 1:11" /></para>
  <para style="s">आखरी कावा आवही अने आवजो केय</para>
  <para style="p">
    <verse number="12" style="v" sid="2JN 1:12" />मने घणी ढेरकी वात आपणी जुगु लीखवा नी से, पण कागत अने संय वेर लीखवा नी हींडतो; पण आह से, के मे तमारीन्‌तां आवही, अने तमने मेळीन वात करही: जीनी सी तमारी खुसी पुरी हये।<verse eid="2JN 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2JN 1:13" />तारी टाळली बेनेह ना सोरा-सोरी तने वारलो से के करीन केय।<verse eid="2JN 1:13" /></para>
  <chapter eid="2JN 1" />
</usx>