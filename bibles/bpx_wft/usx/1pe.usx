<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1PE" style="id">- Paliya</book>
  <para style="h">1 पतरस</para>
  <para style="toc3">1 पतरस</para>
  <para style="toc2">1 पतरस</para>
  <para style="toc1">पतरस नी पेली चीट्‌ठी</para>
  <para style="mt2">पतरस की पहली पत्री</para>
  <para style="mt1">पतरस नी पेली चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">पतरस नी चीट्‌ठी नेवताळा पतरस नी लारे लीखली से, पतरस आहयु कीन तीनी चीट्‌ठी लीखवा सुरु कर्‌यो, के तीहयो कोय से अने कोय जुगु लीख र्‌यो। तीहयो तीहया आखा भरहो करन्‌या ना बारा मे देखाड़्‌यो, जीने तीहयो “अंजाण्‌या” केदो। <char style="xt"><ref loc="1PE 1:1">1:1</ref></char> <char style="xt"><ref loc="1PE 1:17">1:17</ref></char> अने <char style="xt"><ref loc="1PE 2:11">2:11</ref></char> तीहयो तीनी चीट्‌ठी भणवा वाळा ने कंय कावा अलग-अलग देस मे वेरवायला से देखाड़े। काहाके आहयी चीट्‌ठी थोड़ीक भाते ईफीसीयो नी चीट्‌ठीन तेम देखाव पड़े, कंय माणहु माने के मसी ना पयदा हयवान 65 साल अळतेण ईफीसीयो ने 1 पतरस लीखलो हतो। पतरस रोम ह़ेर मे रीन आहयी चीट्‌ठी लीखलो हतो जीने तीहयो बाबील केदलो हतो <char style="xt"><ref loc="1PE 5:13">5:13</ref></char>।</para>
  <para style="ip">पतरस केय के तीहयो आहयी चीट्‌ठी ने तमने खुस करवा अने आहयु साबीत करवा ना मकसत सी लीखलो हतो के आहयी भगवान नी खरली दया से। <char style="xt"><ref loc="1PE 5:12">5:12</ref></char> <char style="xt"><ref loc="1PE 2:11-3:7">1 पतरस 2:11–3:7</ref></char><char style="xt"><ref loc="EPH 5:18-6:9">ईफीसीयो 5:18–6:9</ref></char> अने <char style="xt"><ref loc="COL 3:18-4:6">कुलुस्‌यो 3:18–4:6</ref></char> नी वच मे कंय वात एक रंगी से, आहयी तीनोव कीताप मे घोरल्‌या नी ह़गाय अने अदीकार्‌या नी पाळनी ना बारा मे हुकम जड़े। तीहयो दुखी हयवा पोर भरहो करन्‌या ने मजबुती सी खुस करे काहाके आखरी टेम ह़ाते से। <char style="xt"><ref loc="1PE 4:1">4:1</ref></char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पतरस आह़फा ना बारा मे देखाड़े अने भणवा वाळा ना बारा मे देखाड़े। <char style="ior"><ref loc="1PE 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. अळतेण तीहयो छुटकारा जुगु भगवान ने घणो वारु से केय के तीहया आखा मेळ राखे अने आनु मतलब तीमनी जीवाय जुगु ह़ु से। <char style="ior"><ref loc="1PE 1:3-2:10">1:3–2:10</ref></char></para>
  <para style="io1">3. तीहयो भरहो करन्‌या ने हुकम आपे के कळी मे वारु रीते रेजो, लाडी अने लाडा, चाकर्‌या अने मास्‌तर ना वच मे आखी ह़गाय ने देखाड़जो। <char style="ior"><ref loc="1PE 2:11-4:11">2:11–4:11</ref></char></para>
  <para style="io1">4. आनीन अळतेण पतरस दुखी हयवा पोर तीमने मजबुती सी हीम्‌मत आपे। <char style="ior"><ref loc="1PE 4:12-5:11">4:12–5:11</ref></char></para>
  <para style="io1">5. अळतेण तीहयो तीनी चीट्‌ठी खत्‌तम करे। <char style="ior"><ref loc="1PE 5:12-14">5:12-14</ref></char></para>
  <chapter number="1" style="c" sid="1PE 1" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 1:1" />पतरस भणी गेथी जे ईसु मसी नो नेवताळो से, भगवान ना टाळला माणहु जुगु जे पारका देस मे रेण्‌या पुंतुस, गलातीया कपदुक्‌या, आसीया अने बीतुनीया मे तीतर-बीतर हय्‌न री र्‌या।<verse eid="1PE 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1PE 1:2" />अने भगवान बाह ना पेल्‌ना वारा ना ग्‌यान ना लारे, आत्‌मा ने चोखी करवा मालीक ना लेदे टाळला से, के तीहया ईसु मसी ना हुकम माने अने ईसु मसी ना लोय ना छीड़काव लेय: तमने संयबरकत अने सांती घण-जबर जड़े।<verse eid="1PE 1:2" /></para>
  <para style="s">एक जीवत्‌ली आह</para>
  <para style="p">
    <verse number="3" style="v" sid="1PE 1:3" />आपणा मालीक ईसु मसी ना बाह भगवान नी बड़ाय हये, ईसु मसी ने मर्‌या-ह़र्‌या मे गेथो जीवतो हय्‌न उठवा नी लारे, भगवान बाह आपणी पोर घणो गीण करीन आपणु ने नवली जीवाय आप्‌यो। <verse eid="1PE 1:3" /><verse number="4" style="v" sid="1PE 1:4" />अने आमु तीहयी जुगाळी बरकत ना लेदे तीयार रीया, जे भगवान आह़फा ना माणहु नी लेदे ह़माळीन मेक र्‌यो; तां तीहयी कदी नी ह़ड़े नी बगड़े अने नी खत्‌तम हय सके। <verse eid="1PE 1:4" /><verse number="5" style="v" sid="1PE 1:5" />जीनी रखवाळी भगवान नी सक्‌ती सी भरहा ना लारे तीहया छुटकारा ना लेदे, जे आव्‌वा वाळी टेमे उजन्‌तु हयवा वाळी से। करे।<verse eid="1PE 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1PE 1:6" />आनीन करते तमु खुस हयो, जरुड़ी से के हाव थोड़ाक दाड़ा लेदे कंय भाती नी पारख नी लेदे दुख मे से। <verse eid="1PE 1:6" /><verse number="7" style="v" sid="1PE 1:7" />आहयु आनीन करते से के तमारो जाणलो भरहो, जे आक्‌ठा मे तपाड़लु खत्‌तम हयवा वाळु ह़ोनु गेथु घणु कीमती से, जत्‌यार ईसु मसी पासो आवहे ता खुसी बड़ाय अने ईज्‌जत जड़हे। <verse eid="1PE 1:7" /><verse number="8" style="v" sid="1PE 1:8" />तमु मालीक ने बीना देखे मोंग करो, अने हमणे ते तीने नी देख्‌या ते बी भरहो करीन घण-जबर खुस हय र्‌या, जे गीनती सी बाहर अने बड़ाय सी भरायलु से। <verse eid="1PE 1:8" /><verse number="9" style="v" sid="1PE 1:9" />अने आपणा भरहा नु फोळ नीता आत्‌मा नो छुटकारो हात कर र्‌या।<verse eid="1PE 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1PE 1:10" />आहया छुटकारा ना बारा मे भगवान भणी गेथी वात केण्‌या घणा छानबीन करीन ह़ोद्‌या तीहयी दया ना बारा मे जे तमारी पोर हयवा वाळी हती देखाड़्‌या। <verse eid="1PE 1:10" /><verse number="11" style="v" sid="1PE 1:11" />तीहया आहयी वात ने ह़ोद्‌या के मसी नी आत्‌मा तीमनी मे हती, अने पेले गेथोत मसी ना दुख नी अने तीनी पसळ हयवा वाळी बड़ाय ना बारा मे गवाय देतो हतो, तीहयो कानी अने केवी टेम ना बारा मे देखाड़त्‌लो। <verse eid="1PE 1:11" /><verse number="12" style="v" sid="1PE 1:12" />तीहयो आहयु उजन्‌तु कर्‌यो के तीहयो आह़फा नी, पण तमारी सेवा ना लेदे आहयी वात कीया करतो हतो जीनी खबर हाव तमने तीना लारे जड़ी, जे चोखली आत्‌मा ना लारे जे ह़रगे गेथो मोकल्‌लो से तमने खुस-खबर ह़मळायो; अने आहयीत वात ह़रगदुत बी देखवा नी आह करे।<verse eid="1PE 1:12" /></para>
  <para style="s">चोखली जीवाय जीव्‌वा नो बोलावो</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 1:13" />आनीन करते आपणी-आपणी अक्‌कल नी केड़ बांद लेवो, अने चेतीन रीन तीहयी दया नी पुरी आह राखो, जे ईसु मसी आवहे तीहयी टेम जड़वा वाळी से। <verse eid="1PE 1:13" /><verse number="14" style="v" sid="1PE 1:14" />हुकम मानवा वाळा सोरान तेम आपणु पेलेन तेवा ना बणो। अने अक्‌कल नी हती तीहयी टेमे ने तेवा ना बणो। <verse eid="1PE 1:14" /><verse number="15" style="v" sid="1PE 1:15" />पण जीसम तमारो बोलाव्‌वा वाळो चोखलो से, तेमेत तमु बी आखी चाल-चलण मे चोखला बणो। <verse eid="1PE 1:15" /><verse number="16" style="v" sid="1PE 1:16" />काहाके लीखलु से, “चोखला बणो, काहाके मे चोखलो से।”<verse eid="1PE 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 1:17" />अने जत्‌यार तमु ए बाह कीन तीनी सी वीन्‌ती करता हय, तीहयो मोडा भाळीन नी नीयाव करे पण आपणा-आपणा काम ना लारे नीयाव करे ता आपणु अंजाणला हयवा नी टेमे बीक सी जीवो। <verse eid="1PE 1:17" /><verse number="18" style="v" sid="1PE 1:18" />काहाके तमु जाणो के तमारी फालतु चाल-चलण तमारा आड़ा-बुड़ा गेथी चालती आय री, आनीन करते तमारो छुटकारो ह़ोना-चांदी अने खत्‌तम हयवा वाळी चीज सी नी हयो। <verse eid="1PE 1:18" /><verse number="19" style="v" sid="1PE 1:19" />पण वण-गुनाळ्‌ळु अने चोखलु गाडरु अने मसी ना कीमती लोय ना लारे हयु। <verse eid="1PE 1:19" /><verse number="20" style="v" sid="1PE 1:20" />तीनी अक्‌कल ते कळ घड़ावान पेले गेथात जाण लेदला, पण हाव आखरी दाड़ा मे तमारी जुगु उजन्‌तु हयु। <verse eid="1PE 1:20" /><verse number="21" style="v" sid="1PE 1:21" />तीनी लारे तमु तीहया भगवान पोर भरहो कर र्‌या, जीने तीहयो मरला मे गेथो जीवाड़्‌यो अने बड़ाय आप्‌यो तमारो भरहो अने आह भगवान पोर हये।<verse eid="1PE 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1PE 1:22" />जत्‌यार के तमु भाय-बेटा ना दगा वगर मोंग ना लेदे सच्‌चाय ने मानवा सी आपणा मन ने चोखला कर्‌या, ता पुरु मन लगाड़ीन एक-बीजा ने जादा मोंग करो <verse eid="1PE 1:22" /><verse number="23" style="v" sid="1PE 1:23" />काहाके तमने खत्‌तम हवे एवु नी पण कदी खत्‌तम नी हवे एवु बीज सी भगवान जीवत्‌ला अने जलम रेवा वाळा बोल ना लारे नवली जीवाय जड़ली से। <verse eid="1PE 1:23" /><verse number="24" style="v" sid="1PE 1:24" />काहाके</para>
  <para style="q1" vid="1PE 1:24">आखा जीव चारान तेम से,</para>
  <para style="q2" vid="1PE 1:24">अने तीमनी ह़ोबा जंगली फुलुन तेम से;</para>
  <para style="q1" vid="1PE 1:24">चारो चीमाय जाय अने फुलु झड़ जाय;<note caller="+" style="x"><char style="xo" closed="false">1:24 </char><char style="xt" closed="false"><ref loc="ISA 40:7">यसाया 40:7</ref> </char></note><verse eid="1PE 1:24" /></para>
  <para style="q2">
    <verse number="25" style="v" sid="1PE 1:25" />पण मालीक नो बोल जलमको बणलो रेहे।</para>
  <para style="m" vid="1PE 1:25">आहयो से तीहयो बोल, जे तमने ह़मळावलो हतो।<verse eid="1PE 1:25" /></para>
  <chapter eid="1PE 1" />
  <chapter number="2" style="c" sid="1PE 2" />
  <para style="p">
    <verse number="1" style="v" sid="1PE 2:1" />आखी भातीन कुहराय करवा, अने बीजा ने ठगवा, ढोंगड़ा करवा, अने रीह, अने बीजा नी नामबद्‌दी करवा सोड़ देवो। <verse eid="1PE 2:1" /><verse number="2" style="v" sid="1PE 2:2" />नवलु पयदा हयलु सोरुन तेम आतमीक दुद नी हेर करो, काहाके तीनी लारे छुटकारो हात करवा मे बड़ता जावो। <verse eid="1PE 2:2" /><verse number="3" style="v" sid="1PE 2:3" />काहाके तमु मालीक नी भलाय नो ह़वाद चाख लेदला से।<verse eid="1PE 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1PE 2:4" />ईसु मसी ने बीजा माणहु अमथो जाण्‌या, पण तमु तीनी पोर भरहो करीन तीनीन्‌तां आवला से। ईसु जीवाय आपण्‌या कामका दगड़ान तेम से, जीने माणहु अमथो ह़मजीन सेटो कर देदा। बाखीन भगवान नी नींगा मे घणो मोगलो अने जीवत्‌लो दगड़ो से। <verse eid="1PE 2:4" /><verse number="5" style="v" sid="1PE 2:5" />तमु बी जीवत्‌ला दगड़ान तेम आत्‌मीक घोर बणता जावो, जीनी सी पुंजारा ना चोखला समाज बणीन एसवी भेट चड़ावो के ईसु मसी ना लारे भगवान ली लेय। <verse eid="1PE 2:5" /><verse number="6" style="v" sid="1PE 2:6" />खरला सास्‌तर मे पेले गेथु आसम लीखलु से,</para>
  <para style="q1" vid="1PE 2:6">“मे सीयोन ह़ेर मे मारा टाळला दगड़ा ने मेकु</para>
  <para style="q2" vid="1PE 2:6">अने जे कोय तीनी पोर भरहो करहे,</para>
  <para style="q2" vid="1PE 2:6">तीने लजवायवा नी पड़े।”<verse eid="1PE 2:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="1PE 2:7" />तमारी लेदे जे भरहो करता हय तीहया घणा कीमती से, पण जे भरहो नी करे तीमनी लेदे</para>
  <para style="q1" vid="1PE 2:7">“जे दगड़ा ने राजमीस्‌त्‌या रीकामो ह़मजीन नीकाळ देदला</para>
  <para style="q2" vid="1PE 2:7">तीहयोत दगड़ो एक खुणा नो सीरो बण ज्‌यो।<verse eid="1PE 2:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="1PE 2:8" />अने</para>
  <para style="q1" vid="1PE 2:8">ठेह लागवा नो दगड़ो,</para>
  <para style="q2" vid="1PE 2:8">अने ठोकर खावा ना चाफर बण जेलो से”</para>
  <para style="m" vid="1PE 2:8">काहाके तीहया ते भगवान ना बोलु ने नी मानीन ठोकर खाय अने आनीत जुगु तीहया ठेरावला बी से।<verse eid="1PE 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1PE 2:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:9 </char>
      <char style="xt" closed="false">
        <ref loc="TIT 2:14">तीतुस 2:14</ref>
      </char>
    </note>बाखीन तमु एक टाळली कुळी से, अने राजवाड़्‌या पुंजारा से, अने चोखला माणहु नो टोळो से, आने भगवान ना असामी से, भगवान ते तमने पाप नी अंदारली जीवाय मे गेथा नीकाळीन, वीजाळा नी जीवाय जुगु बोलावलो से। तीना गुण उजन्‌ता करो। <verse eid="1PE 2:9" /><verse number="10" style="v" sid="1PE 2:10" />पेले तमु असामी नी हता, पण हाव तमु भगवान ना असामी से। पेले तमारी पोर गीण नी हयली हती, पण हाव तमारी पोर गीण हयली से।<verse eid="1PE 2:10" /></para>
  <para style="s">भगवान जुगु जीवो</para>
  <para style="p">
    <verse number="11" style="v" sid="1PE 2:11" />ए मारा मोंगाळ्‌ळा भाय-बेन्‌या, मे तमारी सी वीन्‌ती करु के तमु आह़फाम ने अंजाण्‌या अने पारको ह़मजीन आहयी कळी नी लालच सी जे आत्‌मा सी झुमाया करे बचीन रेवो। <verse eid="1PE 2:11" /><verse number="12" style="v" sid="1PE 2:12" />आड़जात्‌या माणहु मे तमारी चाल-चलण भली रेय, के जे-जे वात मे तीहया तमने कुहर्‌या ह़मजीन नामबद्‌दी करे, तीहया तमारा भला कामु ने देखीन तीमनीत लेदे दया ना दाड़े भगवान नी बड़ाय करे।<verse eid="1PE 2:12" /></para>
  <para style="s">ईसु ना माणहु सरकारी अदीकार्‌या ना हक मे रेवा जोवे</para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 2:13" />तमु मालीक नी करते माणहु ना वच मे टाळला आखा अदीकार्‌या ना हक मे रेवो, भले राजो कळीन आखा देस पोर राज करन्‌यो हय; <verse eid="1PE 2:13" /><verse number="14" style="v" sid="1PE 2:14" />भले तीहयो राजवाड़ा मे राज करन्‌यो हय। कुहर्‌या ने डंड आपवा अने भलास्‌या ने वारु कर्‌यो केवा करीन तीमने ठेरावला से। <verse eid="1PE 2:14" /><verse number="15" style="v" sid="1PE 2:15" />हाव भगवान नी मरजी आहयीत से के तमु भलास्‌या रेवो अने तमारा भला काम ना लारे, जे भगवान नी जाणे तीमनी अमथी वात केवा नी बोलती बंद कर देवो। <verse eid="1PE 2:15" /><verse number="16" style="v" sid="1PE 2:16" />आह़फा ने छुट्‌लो जाणो, पण आह़फा ना छुटलापण ने बुराय नी लेदे आड ना बणावो पण आह़फा ने भगवान नो चाकर्‌यो ह़मजीन चाल। <verse eid="1PE 2:16" /><verse number="17" style="v" sid="1PE 2:17" />आखा माणहु नी ईज्‌जत करो; ईसु नी मंडळी ना भाय-बेन्‌या ने मोंग बी करता रेवो; भगवान नी बीक बी मान्‌ता रेवो; अने देस ना मुखी राजा नी ईज्‌जत करता रेवो।<verse eid="1PE 2:17" /></para>
  <para style="s">मसी अमारी ईज्‌जत</para>
  <para style="p">
    <verse number="18" style="v" sid="1PE 2:18" />ए पावर्‌या, आखी भाती नी बीक भेळ आपणा मालीक ना हक मे रेवो नीस्‌ता तीमना जे भला अने नीचळा हय, तीमना जे बेमान से। <verse eid="1PE 2:18" /><verse number="19" style="v" sid="1PE 2:19" />काहाके कदीम कोय भगवान ना वीच्‌यार करीन गलती सी दुख झेलतो जाय्‌न वेला वेठतो हय ता आहयु वारु से। <verse eid="1PE 2:19" /><verse number="20" style="v" sid="1PE 2:20" />कदी कोय गुनो करे, तीने बीजा ठोके, अने तीहयो होगो हय्‌न तीमनी वेठ्‌या करे, ता बड़ाय करे एसवी कानी बी वात से पण कानो भलाय ना काम करीन कोयना हात नी मार खाय, अने तीहयो वेठतो रेय, ता आसम करवा सी भगवान ने वारु गमे, अने आहयु आखा अगळ बड़ाय करे ईसम से। <verse eid="1PE 2:20" /><verse number="21" style="v" sid="1PE 2:21" />आनीन करते भगवान तमने टाळीन बोलावलो से के वण-गुनाळ्‌ळा हय्‌न बी दुख झेले जीसम ईसु मसी वण-गुनाळ्‌ळा हय्‌न बी दुख झेलवा भगवान नो दाखलो बण ज्‌यो। <verse eid="1PE 2:21" /><verse number="22" style="v" sid="1PE 2:22" />ईसु ते कानो बी पाप नी कर्‌यो, अने नी तीना मोडे ठगारी-दगाळी वात नकळी। <verse eid="1PE 2:22" /><verse number="23" style="v" sid="1PE 2:23" />तीहयो गाळ ते खादो, पण कदी पासो फीरीन गाळ नी देदो। ईसु बीजा ना हाते दुख ते झेल्‌यो, पण कदी बी गुनो नी लगाड़्‌यो। तीहयो आह़फा ने खरला नीयाव करन्‌या भगवान बाह ना हात मे ह़ोप देदो। <verse eid="1PE 2:23" /><verse number="24" style="v" sid="1PE 2:24" />अने तीहयो आह़फोत आपणा पाप ने तीना डील पोर लीन कुरुस पोर चड़ ज्‌यो जीनी सी आपणु पाप नी लेदे मरीन धरम जुगु जीवाय जीवया, तीनात मार खावा सी तमु आरगा हया। <verse eid="1PE 2:24" /><verse number="25" style="v" sid="1PE 2:25" />पेले तमु खोवायला गाडरान तेम खोवाय्‌न भटकी जेला,<note caller="+" style="x"><char style="xo" closed="false">2:25 </char><char style="xt" closed="false"><ref loc="ISA 53:6">यसाया 53:6</ref></char></note> बाखीन हाव तमु, तमारा जीव नी रखवाळी करन्‌या खरला गुवाळ्‌यान तां पासा आय लागला से।<verse eid="1PE 2:25" /></para>
  <chapter eid="1PE 2" />
  <chapter number="3" style="c" sid="1PE 3" />
  <para style="s">लाडी अने लाडा ना बारा मे</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 3:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:1 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:22">ईफीसीयो 5:22</ref>; <ref loc="COL 3:18">कुलुस्‌यो 3:18</ref></char>
    </note>ए लाड्‌या, तमु बी आह़फाम ना लाडा ना हक मे रेवो आनीन करते के कदी आमनी मे गेथो कानो एवो हय जे भगवान ना बोलु ने नी मान्‌तो हय, <verse eid="1PE 3:1" /><verse number="2" style="v" sid="1PE 3:2" />ते बी, तमारी बीक भेळ चोखली चाल-चलण देखीन भगवान ना बोल वगर आह़फा-आह़फाम नी लाडी नी चाल-चलण नी लारे मानवा बाज जहे। <verse eid="1PE 3:2" /><verse number="3" style="v" sid="1PE 3:3" /><note caller="+" style="x"><char style="xo" closed="false">3:3 </char><char style="xt" closed="false"><ref loc="1TI 2:9">1 तीमुथीयुस 2:9</ref></char></note>अने तमारो बड़ाय रीकामो नी हय, मतलब नीम्‌बाळा गुथवा, अने ह़ोना नु वजन, नीता भात-भाती ना लुगड़ा पेरवा। <verse eid="1PE 3:3" /><verse number="4" style="v" sid="1PE 3:4" />पण तमारो बड़ाय तमारा मन मे हयवा जोवे, जे बड़ाय सुक-सांती ना वेहवार ना लारे उजन्‌तो हये, तीनी लारे तमु जलम घटाळा रेहु। भगवान नी नींगा मे आसवो वेहवार नो बड़ाय घणो मोगो से। <verse eid="1PE 3:4" /><verse number="5" style="v" sid="1PE 3:5" />पेल्‌ना वारा ना भक्‌ती करन्‌या, जे भगवान पोर आह राखे, तीहया बी आहयीत रीते ह़ींगार करे अने आह़फा-आह़फा ना धणी ना हक मे रेय। <verse eid="1PE 3:5" /><verse number="6" style="v" sid="1PE 3:6" />जीसम सारा आह़फा ना धणी अब्‌राहम ना हुकम मान्‌ती हती अने तीने मालीक केती हती। तीनीत रीते तमु बी कदी भलाय करहु अने कंय भात्‌याण बीक सी तमु बीहो नी, ता तीनी बेट्‌या मनाहु।<verse eid="1PE 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 3:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:7 </char>
      <char style="xt" closed="false">
        <ref loc="EPH 5:25">ईफीसीयो 5:25</ref>; <ref loc="COL 3:19">कुलुस्‌यो 3:19</ref></char>
    </note>तीसमेत ए लाडा, तमु बी अक्‌कल सी लाड्‌या नी ह़ाते जीवाय जीवो, अने बयरा ने कमजोर ठाहरु जाणीन तीनी ईज्‌जत करो, आहयु ह़मजीन के आमु बेम जणा जीवाय ना वाटा ना हकदार्‌या से जीनी सी तमारी वीन्‌ती रोकाय नी जाय।<verse eid="1PE 3:7" /></para>
  <para style="s">भला काम ना करते दुख झेलवा</para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 3:8" />करीन मे तमने आहयु की र्‌यो के तमु आखा एक-मन्‌या रेवो, अने एक-बीजा नी फीकर करो; अने भोळा अने दयाळा बणीन आंबा-सांबा भाय-बेन्‌या ना मोंग ने तेम मोंग करता रेवो। <verse eid="1PE 3:8" /><verse number="9" style="v" sid="1PE 3:9" />कुहराय्‌न बदले कुहराय ना करो; गाळ ना बदले गाळ ना देवो; पण उल्‌टा तीमने बरकत आपो: काहाके तमु बरकत ना हकदार्‌या बणवा करीन बोलावला से। <verse eid="1PE 3:9" /><verse number="10" style="v" sid="1PE 3:10" />काहाके सास्‌तर मे बी लीखलु से,</para>
  <para style="q1" vid="1PE 3:10">“जे कोय जीवाय नी हेर करे,</para>
  <para style="q2" vid="1PE 3:10">अने वारला दाड़ा देखवा हींडे,</para>
  <para style="q2" vid="1PE 3:10">तीहयो आह़फा नी जीप ने बुराय सी,</para>
  <para style="q2" vid="1PE 3:10">अने आह़फा ना होट्‌या ने झुटी वात सी बचाड़ीन राखो।<verse eid="1PE 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="1PE 3:11" />कुहराय नी ह़ात सोड़ अने भलाय कर;</para>
  <para style="q2" vid="1PE 3:11">तीहयो सुक-सांती ने ह़ोदे अने तीने लेदे कोसीत कर।<verse eid="1PE 3:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="1PE 3:12" />काहाके भगवान ना डोळा धरमी माणहु पोर लागला रेय,</para>
  <para style="q2" vid="1PE 3:12">अने तीना कान्‌टा तीमनी वीन्‌ती ह़मळता रेय,</para>
  <para style="q2" vid="1PE 3:12">पण मालीक कुहर्‌या माणहु सी आडो भाळ लेय।”<verse eid="1PE 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 3:13" />कदी तमु भलाय करवा मे उतवाळ्‌या रेहु, ता कोय तमारी कुहराय करहे? <verse eid="1PE 3:13" /><verse number="14" style="v" sid="1PE 3:14" /><note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="MAT 5:10">मत्‌ती 5:10</ref></char></note>कदी तमु धरम ना लेदे दुख बी झेलो, ता तमु जुगाळा से पण माणहुन बीहाड़वा सी ना बीहो, अने ना घबरावो। <verse eid="1PE 3:14" /><verse number="15" style="v" sid="1PE 3:15" />पण मसी ने मालीक जाणीन आपणा-आपणा मन मे चोखला ह़मजो। जे कोय तमने तमारी आह ना बारा मे पुछे, तीने जपाप आपवा नीचळाय अने ईज्‌जत नी ह़ाते सदा तीयार रेवो। <verse eid="1PE 3:15" /><verse number="16" style="v" sid="1PE 3:16" />अने मन चोखलु राखो, आनीन करते के जे वात ना बारा मे तमारी बुराय हयती हय, तीना बारा मे जे मसी मे तमारी वारली चाल-चलण ने बुराय करवा वाळा लाजे पड़ जहे। <verse eid="1PE 3:16" /><verse number="17" style="v" sid="1PE 3:17" />काहाके कदी भगवान नी आहयी हेर हय के तमु भलाय करवा सी दुख झेलो, ता आहयु बुराय करवा सी दुख झेलवा वारु से। <verse eid="1PE 3:17" /><verse number="18" style="v" sid="1PE 3:18" />आनीन करते मसी बी वण-धरमी माणहु ना पाप ना करते दुख झेल्‌यो, काहाके आपणु ने भगवान ने तां लीजवा करीन डील ना रुप मे ते मार्‌या पण आत्‌मा ना रुप मे जीवाड़्‌या। <verse eid="1PE 3:18" /><verse number="19" style="v" sid="1PE 3:19" />तीनी मे तीहयो जाय्‌न आत्‌मा ने बी खुस-खबर नु परच्‌यार कर्‌यो। <verse eid="1PE 3:19" /><verse number="20" style="v" sid="1PE 3:20" />तीहया जे वीतली टेम मे हुकम नी मान्‌या, जत्‌यार भगवान नुहा ना दाड़ा मे धीरज राख रेलो, अने तीहयो ढुंड्‌यु बणाय र्‌यो हतो, तीनी मे बहीन पाणी सी आंठ माणहु बच जेला। <verse eid="1PE 3:20" /><verse number="21" style="v" sid="1PE 3:21" />तीहयु बपतीस्‌मान तेवु से, जे ईसु मसी ने जीव उठवा ना लारे, हाव तमने बचाड़े, आनी सी डील नो मोळ सेटो करवा नो मतलब नी हय, पण चोखला मन सी भगवान ना हक मे हय जवा नो मतलब से। <verse eid="1PE 3:21" /><verse number="22" style="v" sid="1PE 3:22" />तीहयो ह़रग मे जाय्‌न भगवान नी जमणी धेड़े बह ज्‌यो; अने ह़रगदुतु ने अने ह़रगे ना अदीकार्‌या ने अने सक्‌ती ने तीना हक मे कर देदो। <note caller="+" style="x"><char style="xo" closed="false">3:22 </char><char style="xt" closed="false"><ref loc="EPH 6:12">ईफीसीयो 6:12</ref>; <ref loc="DAN 10:12-13">दानीयल 10:12-13</ref> </char></note><verse eid="1PE 3:22" /></para>
  <chapter eid="1PE 3" />
  <chapter number="4" style="c" sid="1PE 4" />
  <para style="s">बदल्‌ली जीवाय</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 4:1" />आनीन करते के मसी डील मे हय्‌न दुख झेल्‌यो ता तमु बी तीहयी हेर ने हत्‌यार ने तेम धर लेवो, काहाके जे डील मे दुख झेल्‌यो तीहयो पाप सी छुट ज्‌यो। <verse eid="1PE 4:1" /><verse number="2" style="v" sid="1PE 4:2" />काहाके तमारी रेली जीवाय, डील नी लालच ना लारे नी पण भगवान नी मरजीन अनसारे जीव्‌वा जोवे। <verse eid="1PE 4:2" /><verse number="3" style="v" sid="1PE 4:3" />काहाके जे वात आड़जात्‌या करवा चाहता हता, अने लुच्‌चाय नी बुरी लालच, खोड़ला काम करवा, छीनाळु, छाकीन लथ-पथ रेवा, अने मुर्‌ती पुजा करवा मे उदड़ेत टेम गमाया एतरुत घणु। <verse eid="1PE 4:3" /><verse number="4" style="v" sid="1PE 4:4" />आनी सी तीहया वहराय करे के तमु एवा भारी लुच्‌चाय मे तीमनो सात नी देता, अने आनीन करते तीहया तमारु नामबद्‌दी करे। <verse eid="1PE 4:4" /><verse number="5" style="v" sid="1PE 4:5" />पण तीहया तीने जे जीवत्‌ला अने मरला नो नीयाव करवा तीयार से तीने लेखो आपवा पड़हे। <verse eid="1PE 4:5" /><verse number="6" style="v" sid="1PE 4:6" />काहाके मरला माणहु ने बी, खुस-खबर आनीत करते ह़मळावलो हतो। के माणहु नी अनसारे डील मे ते नीयाव हयहे, पण आत्‌मा मे डील भगवान ने तेम जीवत्‌ला रेहे।<verse eid="1PE 4:6" /></para>
  <para style="s">भगवान नी बड़ाय जुगु सेवा</para>
  <para style="p">
    <verse number="7" style="v" sid="1PE 4:7" />आखी वात छोटीत खुटवा वाळी से, आनी लेदे नीचळा हय्‌न वीन्‌ती जुगु चेतीन रेवो। <verse eid="1PE 4:7" /><verse number="8" style="v" sid="1PE 4:8" />अने आखान मोटी वात आहयी से के तमु एक-बीजा सी खरलो मोंग करो; काहाके मोंग आखा पापु ने ढाक देय। <verse eid="1PE 4:8" /><verse number="9" style="v" sid="1PE 4:9" />कुड़कुड़ कर्‌या वगर, एक-बीजा ने पोरणा करो। <verse eid="1PE 4:9" /><verse number="10" style="v" sid="1PE 4:10" />जीने जे वाटो जड़लो से, तीहयो तीने भगवान ना आखी भाती नी संयबरकत ना भला पुंजारान तेम एक-बीजा नी सेवा मे लगाड़े। <verse eid="1PE 4:10" /><verse number="11" style="v" sid="1PE 4:11" />कदीम कोय बोले, ता आसम बोलवा जोवे के मानो भगवान ना बोलु हय; कदीम कोय सेवा करे, ता तीहयी सक्‌ती सी करे जे भगवान आपे; जीनी सी आखी वात मे ईसु मसी नी लारे, भगवान नी बड़ाय उजन्‌ती हये। बड़ाय अने ताखत जलमकी तीनीत से। आमीन।<verse eid="1PE 4:11" /></para>
  <para style="s">ईसु मसी ना दुख मे साजल्‌या</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 4:12" />ए मोंगाळ्‌ळा, जे दुख ना वेह मे आक्‌ठु तमने पारखवा जुगु तमारी मे भड़कली से, आनी सी आहयु ह़मजीन ना वहरावो के कानी बीजीत वात तमारी पोर वीत र्‌यी। <verse eid="1PE 4:12" /><verse number="13" style="v" sid="1PE 4:13" />पण जीसम-जीसम मसी ना दुख मे साजल्‌या बणो, ता खुस हयो, जीनी सी तीनी बड़ाय उजन्‌ती हयहे तीहयी टेमे खुस हयो। <verse eid="1PE 4:13" /><verse number="14" style="v" sid="1PE 4:14" />अळतेण कदी मसी ना नाम ना लेदे तमारी बुराय करे, ता तमु जुगाळा से, काहाके बड़ाय नी आत्‌मा जे भगवान नी आत्‌मा से, तमारी पोर साहळो करे। <verse eid="1PE 4:14" /><verse number="15" style="v" sid="1PE 4:15" />तमारी मे गेथो कोय बी माणेह हत्‌यारो नीता चोट्‌टो नीता गलत काम करन्‌यो, नीता बीजा ना काम मे हात नाखवान लेदे दुख नी उठावा जोवे। <verse eid="1PE 4:15" /><verse number="16" style="v" sid="1PE 4:16" />बाखीन कदीम ईसु मसी वाळा हयवा सी दुख झेले, ता लजवायजो नी। पण आहयी वात जुगु भगवान नी बड़ाय करे।<verse eid="1PE 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1PE 4:17" />काहाके तीहयी टेम आय लागली से, के पेले भगवान ना माणहु नो नीयाव करे, अने जत्‌यार के नीयाव करवा अमारीन्‌तां गेथु सुरु हयहे ता तीहया माणहु नु ह़ु हयहे जे भगवान नी खुस-खबर ने नी मान्‌ता। <verse eid="1PE 4:17" /><verse number="18" style="v" sid="1PE 4:18" />अने</para>
  <para style="q1" vid="1PE 4:18">धरमी माणेह नेत छुटकारो हात करवा काठु से,</para>
  <para style="q2" vid="1PE 4:18">ता भक्‌ती नी करे अने पापी नु ह़ु हयहे?<verse eid="1PE 4:18" /></para>
  <para style="m">
    <verse number="19" style="v" sid="1PE 4:19" />आनीन करते जे भगवान नी हेर ना अनसारे दुख झेले, तीहया भलाय करता जाय्‌न आपणा-आपणा जीव ने भरहो करे एवा बणावण्‌या ना हात मे ह़ोप देय।<verse eid="1PE 4:19" /></para>
  <chapter eid="1PE 4" />
  <chapter number="5" style="c" sid="1PE 5" />
  <para style="s">डायला अने जुवान्‌या ने खबर</para>
  <para style="p">
    <verse number="1" style="v" sid="1PE 5:1" />तमु जे पुराणा से, मे तीमनीन तेम पुराणो अने मसी ना दुख नो गवा अने उजन्‌ती हयवा वाळी बड़ाय मे साजल्‌या बणीन तीमने आहयु ह़मजाड़ु। <verse eid="1PE 5:1" /><verse number="2" style="v" sid="1PE 5:2" /><note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="JHN 21:15-17">युहन्‌ना 21:15-17</ref></char></note>भगवान ना तीहया मेळा नी रखवाळी करो जे तमारा वच मे से, पण दबाव सी नी पण भगवान नी मरजी ना लारे खुसी सी, पय्‌हा ना लेदे नी पण मन लगाड़ीन। <verse eid="1PE 5:2" /><verse number="3" style="v" sid="1PE 5:3" />जे माणहु तमने ह़ोप मेल्‌या तीमनी पोर हक ना जमाड़ो, पण मेळा ना लेदे ईज्‌जत बणो। <verse eid="1PE 5:3" /><verse number="4" style="v" sid="1PE 5:4" />जत्‌यार डायलो रखवाळ्‌यो आवहे, ता तमने बड़ाय नी पागड़ी जड़हे तीनी चमक कदी खत्‌तम नी हये।<verse eid="1PE 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1PE 5:5" />आहयीत रीते ए जुवान्‌या तमु बी पुराणा ना हक मे रेवो अने तमु आखान-आखा एक-बीजा नी सेवा जुगु भोळाय सी केड़ बांदीन रेवो, काहाके “भगवान घमंड करन्‌या नो वीरोद करे, पण भोळा पोर दया करे।” <verse eid="1PE 5:5" /><verse number="6" style="v" sid="1PE 5:6" /><note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="MAT 23:12">मत्‌ती 23:12</ref>; <ref loc="LUK 14:11">लुका 14:11</ref>; <ref loc="LUK 18:14">18:14</ref></char></note>आनीन करते भगवान ना ताखत वाळा हात तळे भोळाय सी रेवो, जीनी सी तीहयो तमने संय टेमे वदाड़हे। <verse eid="1PE 5:6" /><verse number="7" style="v" sid="1PE 5:7" />आपणी आखी चीन्‌ता भगवान पोर सोड़ देवो, काहाके तीने तमारी फीकर से।<verse eid="1PE 5:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1PE 5:8" />चेतीन रेवो, अने ह़मळीन रेवो; काहाके तमारो वेरी भुतड़ो डोखारवा वाळा नाहर ने तेम आहयी ह़ोद मे रेय के कोयने फाड़ीन खाम। <verse eid="1PE 5:8" /><verse number="9" style="v" sid="1PE 5:9" />भरहा मे मजबुत हय्‌न, अने आहयु जाणीन तीनो सामनो करो के कळी मे आसमेत बीजा मसी भाय बी दुख झेल र्‌या। <verse eid="1PE 5:9" /><verse number="10" style="v" sid="1PE 5:10" />हाव भगवान जे आखी संयबरकत नो डायलो से जे तीहयो तमने मसी मे आह़फा नी अमरकाय नी बड़ाय जुगु बोलावलो से, तमने थोड़ीक वार तक दुख झेलवान बाद आह़फोत तमने नामह़ाद्‌या अने वातड़ा ताखत वाळा बणावहे। <verse eid="1PE 5:10" /><verse number="11" style="v" sid="1PE 5:11" />आखी चीज पोर तीनो हक सदा रेवा जोवे। आमीन।<verse eid="1PE 5:11" /></para>
  <para style="s">आखरी काव वारला से के केम</para>
  <para style="p">
    <verse number="12" style="v" sid="1PE 5:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:12 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 15:22">नेवताळा ना काम 15:22</ref>,<ref loc="ACT 15:40">40</ref></char>
    </note>मे सीलवानुस नी लारे जीने मे भरहो करे एवो भाय ह़मजु, आखी वात ने लीखीन ह़मजाड़लो से, अने आहयी गवाय देदो के भगवान नी खरली संयबरकत आहयी से, आनीत मे टेकला रेवो।<verse eid="1PE 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1PE 5:13" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:13 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 12:12">नेवताळा ना काम 12:12</ref>,<ref loc="ACT 12:25">25</ref>; <ref loc="ACT 13:13">13:13</ref>; <ref loc="ACT 15:37-39">15:37-39</ref>; <ref loc="COL 4:10">कुलुस्‌यो 4:10</ref>; <ref loc="PHM 1:24">फीलेमोन 1:24</ref></char>
    </note>जे बेबीलोन देस मे तमारीन तेम टाळला से, तीहया माणहु अने मारो सोरो मरकुस तमने आवही अने आवजो केय।<verse eid="1PE 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1PE 5:14" />एक-बीजा ने मसी मोंग सी गळे लगाड़ो, तमने आखा ने जे मसी मे से सांती जड़े।<verse eid="1PE 5:14" /></para>
  <chapter eid="1PE 5" />
</usx>