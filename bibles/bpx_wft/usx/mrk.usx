<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">- Paliya</book>
  <para style="h">मरकुस</para>
  <para style="toc3">मरकुस</para>
  <para style="toc2">मरकुस</para>
  <para style="toc1">मरकुस नी लीखली ईसु मसी नी खुस-खबर</para>
  <para style="mt2">मरकुस का लीखा यीशु मसी का सु-समाचार</para>
  <para style="mt1">मरकुस नी लीखली ईसु मसी नी खुस-खबर</para>
  <para style="imt">जानकारी</para>
  <para style="ip">ईसु नी जीवाय ना बारा मे देखाड़वा वाळा नवला कायदा नी च्‌यार कीताप से, तीमनी मे गेथी एक कीताप मरकुस नी खुस-खबर से अने आहयी च्‌यार कीताप्‌या ईसु नी खुस-खबर ह़मळावे।</para>
  <para style="ip">ईसु ने मरवान बाद आहयी च्‌यार खुस-खबर ने मत्‌ती मरकुस लुका अने युहन्‌नो एवा लीखला से आहयी च्‌यारोव खुस-खबर मे गेथी मरकुस नी खुस-खबर आखा गेथी नानी कीताप से। आहयी च्‌यारोव कीताप मे गेथी मरकुस नी खुस-खबर आखा गेथी पेले लीखली से। अने बीजी तीन खुस-खबर ईसुन पयदा हयवान 65 से 70 साल बाद लीखला अने आने लीखवा नो मतलब से के रोम ह़ेर नी भरहो करन्‌यान मंडळी ना मन नी ताखत बड़ाव्‌वा करीन अने खुस करवा करीन आहयी खुस-खबर लीखला हता।</para>
  <para style="ip">आहयो मरकुस कोय हतो अने चेलो पोलुस बरनाबास जुवान आहयो तीमनी ह़ाते काम करवा वाळो ह़ाती हतो। युहन्‌ना मरकुस मतलब मरकुस खुस-खबर ने लीखवा वाळो मरकुस तीनी ह़ाते पेल्‌नी मीसनरी यात्‌रा नी वचमेत गेथो सोड़ीन नाह जवा सी तीना मन ने ठोकर लागी। <char style="xt"><ref loc="ACT 13:13">नेवताळा ना काम 13:13</ref></char> अळतेण आहयो मरकुस बरनाबास नी सेवा नु काम मे ह़ाते हतो। लीखलु से के <char style="xt"><ref loc="ACT 15:37-39">नेवताळा ना काम 15:37-39</ref></char> ना लारे मरकुस पतरस नो ह़ाते वाळो ह़ाती हतो। <char style="xt"><ref loc="1PE 5:13">1 पतरस 5:13</ref></char> जानकार माणहु आसम माने के मरकुस नी जीवाय अने सेवा अगळ गेथा नी देख्‌या अळतेण बी पतरस नी गवाय ना आधार पोर तीहयो आहयी खुस-खबर लीखली से।</para>
  <para style="ip">चेला बणाव्‌वा अने आखरी टेमे आहयी खुस-खबर ना बे खास वात ना बारा मे चेला बणाव्‌वा अने आखरी टेमे मरकुस नु लीखलु खुस-खबर मे ईसु ना लारे आपली ह़ीकापण।</para>
  <para style="ip">मरकुस ना लीखला खुस-खबर मे ईसु ने चाकर्‌यो अने मालीक भगवान नो मोंगाळ्‌ळो सोरो जे तीना बाह नी मरजी पुरी करीन तीयार से। आनी आहयी वात नी लेदे ईसम करीन मरकुस ईसु ना सेल-भात्‌या कामु ने जादा सी जादा देखाड़ मेक्‌यु। खुस-खबर नी आखरी मे ईसु नो मोट्‌लो हुकम आवलो से।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. बपतीस्‌मा नी रीती करवा वाळा युहन्‌ना ईसु नी बपतीस्‌मा नी रीती। <char style="ior"><ref loc="MRK 1:1-13">1:1-13</ref></char></para>
  <para style="io1">2. गलील देस अने आड़े-धेड़े ना ईलाका मे कर्‌यो चमत्‌कार। <char style="ior"><ref loc="MRK 1:14-9:50">1:14–9:50</ref></char></para>
  <para style="io1">3. गलील सी यरुसलेम तक ना ईसु नी यात्‌रा अने तां मंदीर मे तीनु भरायवु। <char style="ior"><ref loc="MRK 10:1-12:44">10:1–12:44</ref></char></para>
  <para style="io1">4. ईसु ना भगवान वगे गेथी वात केण्‌या ना बारा मे कर्‌यो खबर। <char style="ior"><ref loc="MRK 13:1-37">13:1-37</ref></char></para>
  <para style="io1">5. ईसु नी मोत, जीवतो हयवा अने मोटो हुकम। <char style="ior"><ref loc="MRK 14:1-10">14:1-10</ref>,<ref loc="MRK 14:16-20">16-20</ref></char></para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">युहन्‌ना बपतीस्‌मा आपण्‌या नु परच्‌यार</para>
  <para style="r">(<ref loc="MAT 3:1-12">मत्‌ती 3:1-12</ref>; <ref loc="LUK 3:1-18">लुका 3:1-18</ref>; <ref loc="JHN 1:19-28">युहन्‌ना 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />भगवान नो सोरो ईसु मसी, नी खुस-खबर सुरुवात हयी:<verse eid="MRK 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 1:2" />जीसम यसाया भगवान वगे गेथी वात केण्‌या माणेह नी कीताप मे लीखलु हतु के: “देख, ‘मे मारा ह़रगदुत ने तारी अगळ मोकलु, तीहयो तारी जुगु रोहो तीयार करहे।’<note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="EXO 23:20">नीरगमन 23:20</ref>; <ref loc="MAL 3:1">मलाकी 3:1</ref>; <ref loc="MAT 11:10">मत्‌ती 11:10</ref>; <ref loc="LUK 7:27">लुका 7:27</ref></char></note> <verse eid="MRK 1:2" /><verse number="3" style="v" sid="MRK 1:3" />ह़ुनह़ान जागा मे एक आड़वा वाळा नो बोल ह़मळाय र्‌यो, मालीक जुगु वाट तीयार करो; अने तीनी जुगु रोहा ह़ुदा करो।”<note caller="+" style="x"><char style="xo" closed="false">1:3 </char><char style="xt" closed="false"><ref loc="ISA 40:3">यसाया 40:3</ref>; <ref loc="JHN 1:23">युहन्‌ना 1:23</ref></char></note><verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />बपतीस्‌मान रीती<note caller="+" style="f"><char style="fr" closed="false">1:4 </char><char style="ft" closed="false">पाणी मे डुबाड़ीन उपर नकाळवा</char></note> आपण्‌यो युहन्‌ना आयो, अने परच्‌यार करतो हतो, “अने बपतीस्‌मा आपवा बाज ज्‌यो।” अने “तीहयो माणहुम ने केदो पाप भणी गेथा मन बदलीन अने पाप सी पस्‌तावो करो ता तमारा पाप ने भगवान माफ करहे।”<note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="JHN 1:5">युहन्‌ना 1:5</ref>,<ref loc="JHN 1:33">33</ref>; <ref loc="ACT 1:5">नेवताळा ना काम 1:5</ref>,<ref loc="ACT 1:22">22</ref>; <ref loc="ACT 13:24">13:24</ref>; <ref loc="ACT 18:24">18:24</ref>; <ref loc="ACT 19:3">19:3</ref>,<ref loc="ACT 19:4">4</ref></char></note> <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />अने आखा युहद्‌या देस ना अने यरुसलेम ह़ेर मे आखा रेवा वाळा माणहु नीकळीन युहन्‌नान तां ज्‌या; अने आपणा पाप मानीन यरदन नंदी मे युहन्‌ना सी बपतीस्‌मा लेदा।<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />युहन्‌नो उटड़ा ना नीम्‌बाळा ना लुगड़ा पेरत्‌लो अने केड़्‌या मे चामड़ा नो पट्‌टो बांदीन रेत्‌लो<note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="2KI 1:8">2 राजा 1:8</ref></char></note> तीहयो टीड्‌या अने बड़ा मे वाळु मोद खाया करत्‌लो। <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />अने तीहयो आहयु परच्‌यार करतो हतो, “मारी बाद तीहयो आव्‌वा वाळो से; तीहयो मार गेथो घणो मोटो से; मे आना लायक बी नी हय के ढुंगो वळीन तीना चाट्‌या ना बोंद सोड़ु। <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />मे तमने पाणी सी बपतीस्‌मा आप र्‌यो, पण तीहयो तमने चोखली आत्‌मा सी बपतीस्‌मान रीती आप्‌हे।”<note caller="+" style="x"><char style="xo" closed="false">1:8 </char><char style="xt" closed="false"><ref loc="ISA 44:3">यसाया 44:3</ref>; <ref loc="JOL 2:28">योएल 2:28</ref>; <ref loc="JHN 1:33">युहन्‌ना 1:33</ref>; <ref loc="ACT 1:5">नेवताळा ना काम 1:5</ref>; <ref loc="ACT 2:4">2:4</ref>; <ref loc="ACT 11:16">11:16</ref>; <ref loc="ACT 19:4-6">19:4-6</ref></char></note><verse eid="MRK 1:8" /></para>
  <para style="s">ईसुन बपतीस्‌मा अने पारख</para>
  <para style="r">(<ref loc="MAT 3:13-4:11">मत्‌ती 3:13–4:11</ref>; <ref loc="LUK 3:21">लुका 3:21</ref>,<ref loc="LUK 3:22">22</ref>; <ref loc="LUK 4:1-13">4:1-13</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />तीहया दाड़ा मे ईसु गलील जीला ना नासरत ह़ेर<note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="MAT 2:23">मत्‌ती 2:23</ref></char></note> गेथो आवीन, युहन्‌ना सी यरदन नंदी मे बपतीस्‌मान रीती लेदो। <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />अने जत्‌यार ईसु पाणी मे डुबीन उपर नीकळ्‌यो, ता तत्‌यारुत तीहयो ह़रग ने उगड़तलु अने चोखली आत्‌मा ने पारवान तेम आह़फा नी उपर उतरत्‌लो देख्‌यो। <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" /><note caller="+" style="x"><char style="xo" closed="false">1:11 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्‌ती 3:17</ref>; <ref loc="MAT 12:18">12:18</ref>; <ref loc="MRK 9:7">मरकुस 9:7</ref>; <ref loc="LUK 3:22">लुका 3:22</ref></char></note>अने ह़रग गेथो आहयो बोल ह़मळायो: “आहयो मारो मोंगाळ्‌ळो सोरो से, मे आनी सी घणो खुस से।”<verse eid="MRK 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />तत्‌यारुत भगवान नी आत्‌मा ईसु ने उजाड़ी बड़ा भणी मोकली। <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />ता ईसु ने चाळीह दाड़ा<note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="EXO 24:18">नीरगमन 24:18</ref>; <ref loc="1KI 19:8">1 राजा 19:8</ref></char></note> तक भुतड़ो पाप कराव्‌वा करीन पारखतो र्‌यो। अने तां ईसु जंगली जानवरु नी वच मे र्‌यो, अने ह़रगदुत तीनी चाकरी करता र्‌या।<verse eid="MRK 1:13" /></para>
  <para style="s">ईसु आह़फा ना कामु सुरु करे</para>
  <para style="r">(<ref loc="MAT 4:12-17">मत्‌ती 4:12-17</ref>; <ref loc="LUK 4:14-15">लुका 4:14-15</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />बपतीस्‌मा आपण्‌या युहन्‌ना ने धराय जवान, बाद ईसु आवीन भगवान ना राज नी खुस-खबर ह़मळाव्‌वा करीन गलील जीला मे ज्‌यो,<note caller="+" style="x"><char style="xo" closed="false">1:14 </char><char style="xt" closed="false"><ref loc="MAT 4:12">मत्‌ती 4:12</ref></char></note> <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" /><note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="MAT 3:2">मत्‌ती 3:2</ref></char></note>अने केदो, “टेम पुरी हयवागी,<note caller="+" style="x"><char style="xo" closed="false">1:15 </char><char style="xt" closed="false"><ref loc="ROM 5:6">रोमीयो 5:6</ref>; <ref loc="GAL 4:4">गलातीयो 4:4</ref>; <ref loc="EPH 1:10">ईफीसीयो 1:10</ref>; <ref loc="ISA 46:13">यसाया 46:13</ref>; <ref loc="ISA 51:5">51:5</ref></char></note> अने भगवान नु राज ह़ाते आय जेलु से; एतरे पाप भणी गेथा मन बदलीन भगवान वगा वळो, अने खुस-खबर पोर भरहो करो।”<verse eid="MRK 1:15" /></para>
  <para style="s">काहर्‌याम नो बोलावो</para>
  <para style="r">(<ref loc="MAT 4:18-22">मत्‌ती 4:18-22</ref>; <ref loc="LUK 5:1-11">लुका 5:1-11</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />अने ईसु गलील दर्‌या ना धेड़े-धेड़े जतो हतो। तत्‌यार तां माछला मारन्‌या बे भाय सीमोन अने अंदर्‌यास ने दर्‌या मे जाळ नाखत्‌ला देख्‌यो; काहाके तीहया माछला मारन्‌या काहर्‌या हता। <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />ईसु तीमने केदो, “मारी पसळ आवो; जेम तमु माछला ने भेळा करो, तेमेत मे तमने माणहु ने भेळा करवा वाळा ह़ीकाड़ही।” <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />तीहया तत्‌यारुत जाळ ने रेवा दीन ईसु पसळ चाल पड़्‌या।<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />ईसु अमाळ अळी अगो ज्‌यो, ता तां जब्‌दी ना बे सोरा, याकुब अने युहन्‌ना ने ढुंड्‌या मे जाळ ह़ुदारत्‌ला देख्‌यो। <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />अने ईसु तीमने तत्‌यारुत बोलायो। अने तीहया तीमना बाह जब्‌दी ने दाड़क्‌याम नी ह़ाते ढुंड्‌या मे रेवा दीन ईसु नी पसळ चाल पड़्‌या।<verse eid="MRK 1:20" /></para>
  <para style="s">ईसु भुत ने नीकाळे</para>
  <para style="r">(<ref loc="LUK 4:31-37">लुका 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />ता ईसु अने तीना चेला कफरनहुम ह़ेर मे आया। अने तत्‌यारुत अराम ना दाड़े, ईसु तीमना भक्‌तीन घोर मे जीन माणहु ने ह़ीकाड़वा बाज ज्‌यो।<note caller="+" style="x"><char style="xo" closed="false">1:21 </char><char style="xt" closed="false"><ref loc="MAT 4:23">मत्‌ती 4:23</ref>; <ref loc="MRK 10:1">मरकुस 10:1</ref></char></note> <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" /><note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">मत्‌ती 7:28</ref>,<ref loc="MAT 7:29">29</ref></char></note>एतरे माणहु ह़मळीन वहराय ज्‌या; काहाके ईसु युहदी-धरम ह़ीकाड़न्‌यान तेम नी, पण अदीकार्‌यान तेम हक सी ह़ीकाड़्‌यो।<note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="MAT 7:28">मत्‌ती 7:28</ref>,<ref loc="MAT 7:29">29</ref></char></note><verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />अने तीहयी टेमे तीमना भक्‌ती ना घोर मे एक माणेह हतो, तीने वीटळ्‌ळो भुत लागलो हतो। <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />“तीहयो आड़ीन केदो, ए ईसु नासरी, मार ह़ाते तारु ह़ु काम? तु आमने खुटाड़वा करीन आय र्‌यो ह़ु मे तने ओळखु तु कोय से भगवान नो चोखलो माणेह?”<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />ईसु तीने वडीन केदो, “होगो रे; अने ईनी मे गेथो नीकळ जा।”<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />वीटळ्‌ळो भुत तीहया माणेह ने महकीन, अने ज्‌योरेत आड़ीन नीकळ ज्‌यो।<note caller="+" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="MRK 9:20">मरकुस 9:20</ref></char></note> <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />अने माणहु आहयु देखीन घणा जबर घबराय ज्‌या अने तीहया आंबा-सांबा पुसवा बाज ज्‌या: “आहयी ह़ु वात से? आहयी ते नवली ह़ीकापण आप र्‌यो? तीहयो हक भेळ वीटळ्‌ळी आत्‌माम ने बी हुकम आप र्‌यो, अने तीहया हीनी वात माने!”<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />अने तीनु नाम तत्‌यारुत गलील जीला ना आड़े-धेड़े ना आखा देस मे फेल ज्‌यु।<note caller="-" style="fe"><char style="fr" closed="false">1:28 </char><char style="ft" closed="false">मत्‌ती 9:26</char></note><verse eid="MRK 1:28" /></para>
  <para style="s">ईसु घणा ढेरका ने वारु करे</para>
  <para style="r">(<ref loc="MAT 8:14-17">मत्‌ती 8:14-17</ref>; <ref loc="LUK 4:38-41">लुका 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />ईसु तीमना भक्‌ती ना घोर मे गेथो नीकळीन, याकुब अने युहन्‌ना ह़ाते सीमोन अने अंदर्‌यास ना घोर आया। <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />सीमोन नी ह़ाहु ताव सी मांदली हती, अने चेला ईसु ने तत्‌यारुत तीना बारा मे केदा, <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />अने ईसु तीनीन्‌तां ज्‌यो, अने हात धरीन बही कर्‌यो। अने तीनो ताव उतर ज्‌यो, अने तीहयी तीमनी, सेवा-चाकरी करवा बाज जी।<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />दाहड़ु बुड्‌ये माणहु आखा मांदलाम ने अने भुत लागला माणहु ने बी ईसुन्‌तां लाया।<note caller="+" style="x"><char style="xo" closed="false">1:32 </char><char style="xt" closed="false"><ref loc="MAT 4:24">मत्‌ती 4:24</ref></char></note> <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />अने आखा ह़ेर ना माणहु तीहया घोर ना झापला पोर एकठा हय ज्‌या। <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />ढेरेत माणहु ने जे कंय भात-भातीन मंदवाड़ मे हता, तीमने ईसु वारु कर्‌यो।<note caller="+" style="x"><char style="xo" closed="false">1:34 </char><char style="xt" closed="false"><ref loc="MAT 4:23">मत्‌ती 4:23</ref></char></note> अने तीमनी मे गेथा ढेरेत भुत ने बी काड्‌यो; भुत ईसु ने ओळख्‌ता हता, ईसम करीन ईसु तीमने बोलवा बी नी देदो।<verse eid="MRK 1:34" /></para>
  <para style="s">ईसु ह़ुनह़ान जागा मे वीन्‌ती करे</para>
  <para style="r">(<ref loc="LUK 4:42-44">लुका 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />ह़वारे पेल्‌ना कुकड़ा वाहरे ईसु उठीन उजाड़्या जागा मे ज्‌यो, अने तां तीहयो वीन्‌ती करवा बाज ज्‌यो।<note caller="+" style="x"><char style="xo" closed="false">1:35 </char><char style="xt" closed="false"><ref loc="LUK 3:21">लुका 3:21</ref></char></note> <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />तत्‌यार सीमोन अने तीना दोस्‌तीदार्‌या ईसु ने ह़ोदवा ज्‌या। <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />अने ईसु तीमने जड़ी ज्‌यो; ता तीहया तीने केदा, “आखा माणहु तने ह़ोदवा बाज र्‌या।”<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />ईसु तीमने केदो, “चालो आपणु बीजे आड़े-धेड़े ना गाम मे जता अने तां बी मने खुस-खबर नु परच्‌यार करवु से, काहाके मे हीय्‌यात काम करवा आवलो से।”<note caller="+" style="x"><char style="xo" closed="false">1:38 </char><char style="xt" closed="false"><ref loc="ISA 61:1">यसाया 61:1</ref></char></note><verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:39 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 4:23">मत्‌ती 4:23</ref>; <ref loc="MAT 9:35">9:35</ref></char>
    </note>एतरा मे ईसु गलील देस मे तीमना युहद्‌यान भक्‌तीन घोरु मे जाय-जाय्‌न परच्‌यार करतो र्‌यो, अने भुत ने नीकाळतो र्‌यो।<verse eid="MRK 1:39" /></para>
  <para style="s">ईसु कुड़ावा मांदला माणेह ने वारु करे</para>
  <para style="r">(<ref loc="MAT 8:1-4">मत्‌ती 8:1-4</ref>; <ref loc="LUK 5:12-16">लुका 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />ईसम करीन एक दाड़े एक कुड़ावो माणेह ईसुन्‌तां आयो, अने तीनी अगळ मांडा टेकवीन वीन्‌ती कर्‌यो, “तारी मरजी हय, ता मने वारु करीन चोखो कर दे।”<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />“ईसु ने तीनी पोर एतरी जबर गीण आवी के तीहयो तीने सीमीन केदो, मारी मरजी से, तु चोखो हय जा।” <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />अने तत्‌यारुत तीनु कोड़ जत र्‌यु, अने तीहयो तत्‌यारुत वारु हय्‌न चोखो हय ज्‌यो। <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />ईसु तत्‌यारुत तीने वळावतो जीन आहयु कीन चेतायो; <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />ह़मळ आहयी वात कोयने बी नी केजे; पण पुंजारान्‌तां जा अने तीने तारु डील पारखवा करीन देखाड़जे; अने मुसा ना कायदान लारे तीने बादा चड़ावजे; ता आखा माणहु जाणीन गवा बण जहे, के तु वारु हय्‌न चोखो हय ज्‌यो।<note caller="+" style="x"><char style="xo" closed="false">1:44 </char><char style="xt" closed="false"><ref loc="LEV 14:1-32">लेव्‌यवेवस्‌था 14:1-32</ref></char></note><verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />पण तीहयो ते जाय्‌न ईसु नी वात ने बमदीन परच्‌यार करवा बाज ज्‌यो, अने ईसम करीन आहयी खबर आखी दुर पुगाड़्‌यो। एतरे ईसु उजन्‌तो ह़ेर मे नी ज्‌यो, अने तीने सेटो उजाड़्या जागा मे रेवा पड़्‌यु। ते बी च्‌यारो-मेर गेथा माणहु ईसुन्‌तां जीया करता हता।<note caller="+" style="x"><char style="xo" closed="false">1:45 </char><char style="xt" closed="false"><ref loc="MRK 2:13">मरकुस 2:13</ref>; <ref loc="LUK 5:17">लुका 5:17</ref>; <ref loc="JHN 6:2">युहन्‌ना 6:2</ref></char></note><verse eid="MRK 1:45" /></para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">ईसु लखवान मांदला माणेह ने वारु करे</para>
  <para style="r">(<ref loc="MAT 9:1-8">मत्‌ती 9:1-8</ref>; <ref loc="LUK 5:17-26">लुका 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />थोड़ाक दाड़ा हय ज्‌या, अने अळतेण ईसु अळी कफरनहुम ह़ेर मे ज्‌यो, अने तां आखे खबर हय जी, के ईसु पासो घोर आय र्‌यो। <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />घणा ढेरका माणहु ईसुन्‌तां आया, अने आखु घोर ठेह़ाम-ठेह़ भराय ज्‌यु, अने झापलान अगळ बी जागो नी र्‌यो। ईसु तीमने भगवान ना बोलु ह़ीकाड़वा बाज र्‌यो हतो। <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />एक लखवा मे पड़ला माणेह ने च्‌यार जणा खाटलु मे उचलीन ईसुन्‌तां लाया। <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />पण तीमने घोर मे, ईसुन्‌तां जवा जागो नी जड़्‌यो; करीन तीहया घोर पोर चड़्‌या, अने ईसु जां हतो तां तीनी ह़ुदवाये उपर घोर नो ह़ीवड़ो वेखड़्‌या, अने मांदलु ने ईसु नी अगळ खाटलु भेळ उतार देदा। <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />अने तीहया ईसु पोर घणा जबर भरहो कर र्‌या, आहयु देखीन ईसु लखवा मे पड़ला माणेह ने केदो: “सोरा, तारा पाप माफ हय ज्‌या।”<note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="LUK 7:48">लुका 7:48</ref> </char></note><verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />थोड़ाक युहदी-धरम ह़ीकाड़न्‌या बी तां हता; तीहया आह़फाम ना मन मे वीच्‌यार करवा बाज ज्‌या, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />“आहयु माणेह ह़ु करवा ईसम केतु हहे? आहयु ते भगवान नु नामबद्‌दी करे; पाप ते भगवान एतरो माफ करे।”<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="ISA 43:25">यसाया 43:25</ref></char></note><verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />ईसु तीमना मन मे वाळी वात ने तत्‌यारुत जाण लेदो अने केदो, “तमु मन मे ईसम गलत वीच्‌यार ह़ु करवा कर र्‌या? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />आहयु मांदलु ने ह़ु केवा सरल से? के ‘तारा पाप माफ हय ज्‌या’ केवा वारु से, के तारु खाटलु उचलीन चाल, केवा सरल से? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />मे जे मनख्‌यान सोरो बणीन आहयी कळी मे आयो, मार पांह माणहुन पाप माफ करवान बी हक से।” अने ईसु लखवा ना मांदला माणेह ने केदो, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />“उठ तारु खाटलु चुटलीन घोर जत रे।”<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />अने तीहयो तत्‌यारुत वारु हय्‌न उठ ज्‌यो, अने आखान देखणतो, खाटलु चुटलीन तां गेथो जत र्‌यो, ता आखा भंगलाय ज्‌या, “अने एला! आमु ईसम कदी नी देख्‌या ईसम केता जीन भगवान नी बड़ाय करता हता!”<verse eid="MRK 2:12" /></para>
  <para style="s">ईसु लेवी ने बोलावे</para>
  <para style="r">(<ref loc="MAT 9:9-13">मत्‌ती 9:9-13</ref>; <ref loc="LUK 5:27-32">लुका 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />ईसु अळी गलील दर्‌या धेड़े ज्‌यो, अने तां बी माणहुन मेळो जी लाग्‌यो<note caller="+" style="x"><char style="xo" closed="false">2:13 </char><char style="xt" closed="false"><ref loc="MRK 1:45">मरकुस 1:45</ref>; <ref loc="LUK 5:15">लुका 5:15</ref>; <ref loc="JHN 6:2">युहन्‌ना 6:2</ref></char></note>। ईसु तीमने भगवान ना बोलु ह़ीकाड़वा बाज ज्‌यो। <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />थोड़ीक वार मे ईसु दर्‌या धेड़े-धेड़े जवा बाज र्‌यो हतो, ता ईसु हलफाय ना सोरा लेवी ने जे फाळो लेवा वाळो हतो, फाळो लेवान नाका पोर बह रेलो देख्‌यो; ईसु तीने केदो, “मारो चेलो बणीन मार ह़ाते चाल।” अने तीहयो ईसु ह़ाते चाल पड़्‌यो।<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />अळतेण, लेवी, ईसु ने अने तीना बीजा चेला ने पोरणा बोलायो तीहयो तीनीन तेवा घणा ढेरका फाळो लेण्‌यामने अने तीमनीन तेवा पापी माणहु ने बी पोरणा बोलायो, तीहया बी ईसु पोर भरहो कर लेदला, अने आखा मेळीन खावा बह्‌या। <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />तत्‌यार फरीसी दलवाळा<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="ft" closed="false">ईसुन नेवताळान कामे</char></note> अने थोड़ाक युहदी-धरम ह़ीकाड़न्‌या तीमनी ह़ाते ईसु ने खातलो देखीन, चेलाम ने पुछ्‌या, आहयो फाळो लेण्‌या अने तीमनी ह़ारका पापी माणहु ह़ाते काहा खाय र्‌यो?<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />ईसु आहयी वात ह़मळीन तीमने केदो, “दाक्‌तर आरगला ने नी, पण मांदला ने जोवे। तेमेत मे धरमी ने नी, पण पापी माणहु ने बोलाव्‌वा आवलो से।”<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="LUK 19:10">लुका 19:10</ref>; <ref loc="1TI 1:15">1 तीमुथीयुस 1:15</ref></char></note><verse eid="MRK 2:17" /></para>
  <para style="s">उपाह़ नो सवाल</para>
  <para style="r">(<ref loc="MAT 9:14-17">मत्‌ती 9:14-17</ref>; <ref loc="LUK 5:35-39">लुका 5:35-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />बपतीस्‌मा आपण्‌या युहन्‌ना ना चेला अने फरीसी दलवाळान चेला उपाह़ पाळत्‌ला, करीन थोड़ाक माणहु आवीन ईसु ने पुछ्‌या, “युहन्‌ना ना अने फरीसी दलवाळान चेला उपाह़ पाळे, पण तारा चेला उपाह़ नी पाळता?”<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />ईसु तीमने केदो, जत्‌यार तक लाडो वरात्‌याम नी ह़ाते रेय, ता वरात्‌या उपाह़ पाळे ह़ु, कदी नी; जत्‌यार तक मे ईमनी ह़ाते रेम, तां तक तीहया उपाह़ नी पाळे। <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />पण जे दाड़े मे ईमनी गेथो अलग हय जही,<note caller="+" style="x"><char style="xo" closed="false">2:20 </char><char style="xt" closed="false"><ref loc="LUK 17:22">लुका 17:22</ref></char></note> ते दाड़े गेथा उपाह़ पाळहे।<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />नवलु थीगळु जुन्‌ला लुगड़ा पोर कोय नी लगाड़े; कदीम ईसम करहु ता, तीहयु जुन्‌लु लुगड़ु धोवहे, ता तीहयु नवलु थीगळु उहटी जहे, अने जुन्‌ला लुगड़ा ने हापकीन जादा फाड़ देहे। <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />नवलो अंगुर नो रोह, चामड़ान जुन्‌ला कवड़्‌या मे कोय नी भरे, पण भरहे ता चामड़ान कवड़्‌या ने वदाड़ीन फाड़ देहे। अने अंगुर नो रोह, अने चामड़ा नु कवड़्‌यु अने बेम बगड़ी जहे। करीन नवलो अंगुर नो रोह चामड़ान नवला कवड़्‌या मे भरे। <figure style="fig" alt="Wineskin bag" file="lb00145c.tif" size="col" copy="Horace Knowles ©" ref="2:22">अंगुर नो रोह मेकवा नो कवड़्‌यो</figure><verse eid="MRK 2:22" /></para>
  <para style="s">अराम ना दाड़ा नो मालीक</para>
  <para style="r">(<ref loc="MAT 12:1-8">मत्‌ती 12:1-8</ref>; <ref loc="LUK 6:1-5">लुका 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />अराम ना दाड़े, ईसु अने चेला खेतर मे हय्‌न जवा बाज र्‌या हता। तत्‌यार चेला ने भुक लागी। तत्‌यार तीहया उंब्‌या तोड़ीन चोळी-चोळीन खाता-खाता जता हता।<note caller="+" style="f"><char style="fr" closed="false">2:23 </char><char style="ft" closed="false">वेवस्‌थावीवरण 23:25</char></note> <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />ता फरीसी पंथवाळा ईसु ने केदा, “तारा चेला ने देख! अराम ना दाड़े कायदा ना मान सी एवु काम करवा ताले नी हय!”<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 2:25" />ईसु तीमने केदो, “जत्‌यार दावुद राजा ने भुक लागी, ता तीहयो ह़ु कर्‌यो, तीहयी वात तमु भण्‌या नी ह़ु? जत्‌यार दावुद राजा अने तीना सात देण्‌या एथान-एथा डंडवायता हता, अने तीमने भुक लागी, <verse eid="MRK 2:25" /><verse number="26" style="v" sid="MRK 2:26" />ता तीहयो भगवान ना घोर मे ज्‌यो अने चोखला रोट्‌ला खादो, अने दोस्‌तीदार्‌याम ने बी आप्‌यो! तीहया दाड़ाम अबीयातार भगवान नो डायलो पुंजारो हतो,<note caller="+" style="x"><char style="xo" closed="false">2:26 </char><char style="xt" closed="false"><ref loc="1SA 21:1-7">1 समुवेल 21:1-7</ref>; <ref loc="2SA 8:17">2 समुवेल 8:17</ref>; <ref loc="1CH 24:6">1 ईतीहास 24:6</ref></char></note> तीहया रोट्‌ला खावा पुंजारा ने सोड़ीन कोय जुगु ताले नी हतु।”<verse eid="MRK 2:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />भगवान अराम नो दाड़ो माणहुन भलाय जुगु बणावलो से,<note caller="+" style="x"><char style="xo" closed="false">2:27 </char><char style="xt" closed="false"><ref loc="EXO 23:12">नीरगमन 23:12</ref>; <ref loc="DEU 5:14">वेवस्‌थावीवरन 5:14</ref>; <ref loc="COL 2:16">कुलुस्‌यो 2:16</ref></char></note> पण माणहु ने अराम ना दाड़ा वाटु नी बणायो। <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />पण मे मनख्‌यान सोरो अराम ना दाड़ा नो बी मालीक से।<verse eid="MRK 2:28" /></para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">ईसु ह़ुकला हात वाळा ने वारु करे</para>
  <para style="r">(<ref loc="MAT 12:9-14">मत्‌ती 12:9-14</ref>; <ref loc="LUK 6:6-11">लुका 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />अळी एक-बीजा अराम ना दाड़े ईसु अळी तीमना भक्‌तीन घोर मे ज्‌यो;<note caller="+" style="f"><char style="fr" closed="false">3:1 </char><char style="ft" closed="false">मत्‌ती 4:23; मरकुस 1:21</char></note> तां ह़ारीक ह़ुकला हात वाळो एक माणेह हतो। <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />थोड़ाक फरीसी दलवाळा ईसु पोर आहयो गुनो लगाड़वा नो मोखो ह़ोद र्‌या हता के आहयो अराम ना दाड़ा नो कायदो तोड़ीन आहया मांदला ने वारु करे के नी करे? एतरे तीहया तीनी भणी एकडीट्‌या भाळ र्‌या हता।<note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="MAT 12:10">मत्‌ती 12:10</ref>; <ref loc="LUK 14:1">लुका 14:1</ref></char></note> <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />ईसु मांदला ने हुकम आपीन केदो, “माणहुन वच मे उबो हय जा।” <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />अने ईसु माणहु ने पुछ्‌यो “कायदान लारे अराम ना दाड़े भलु करवा वारु से के कुहराय करवा वारु से? जीव ने बचाड़वा वारु से, के मारवा? पण तीहया मोडाम गेथो बाफ तक नी काड्‌या?”<verse eid="MRK 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 3:5" />तीहया मन मे घणा वातड़ा हता एम करीन ईसु घणो दुखी हय ज्‌यो, अने तीहयो रीहवाय्‌न च्‌यारो-मेर तीमने देख्‌यो। अने ईसु मांदला ने केदो, “हात नाम्‌बो कर” तीहयो हात नाम्‌बो कर्‌यो अने हात पेलेन तेम वारु हय ज्‌यो। <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />अने फरीसी दलवाळा तां गेथा ममार जत र्‌या, अने हेरोद राजान पाल्‌टी ह़ाते भेसकाय्‌न आहयो वीच्‌यार करवा बाज ज्‌या, के आमु ईसु ने कीसम करीन मरावया।<note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="MAT 22:16">मत्‌ती 22:16</ref>; <ref loc="MRK 12:13">मरकुस 12:13</ref></char></note><verse eid="MRK 3:6" /></para>
  <para style="s">ईसु पसळ माणहु नो टोळो</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />ईसु तीना चेलाम नी ह़ाते गलील दर्‌या भणी जत र्‌यो। पण गलील जीला वाळा घणा ढेरका माणहु ईसु पसळ चाल पड़्‌या। <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />अने ईसु ना मोट्‌ला काम ह़मळीन युहद्‌या जीला वाळा, यरुसलेम ह़ेर वाळा, ईदुम्‌या जीला वाळा, यरदन नंदीन ह़ेली पार वाळा अने सुर अने सेदा मुलक वाळा माणहु नो एक घणो मोटो टोळो तीनीन्‌तां भेळो हयो।<note caller="+" style="x"><char style="xo" closed="false">3:8 </char><char style="xt" closed="false"><ref loc="MAT 4:25">मत्‌ती 4:25</ref>; <ref loc="MAT 11:21">11:21</ref></char></note> <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" /><note caller="+" style="x"><char style="xo" closed="false">3:9 </char><char style="xt" closed="false"><ref loc="MRK 4:1">मरकुस 4:1</ref>; <ref loc="LUK 5:1-3">लुका 5:1-3</ref></char></note>गड़दी देखीन, माणहु मने धकलायवा नी जोवे एम करीन ईसु आह़फा ना चेला ने केदो, “मार वाटु एक नान्‌लु ढुंड्‌यु तीयार करो।” <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />ईसु घणा ढेरकाम ने आरगा करलो हतो। तत्‌यार बीजा बी मांदला माणहु आरगा हयवा करीन, ईसु ने सीम्‌वा जत्‌ला अने सीम्‌वा मे तीहया तीनी पोर पड़ जत्‌ला।<note caller="+" style="x"><char style="xo" closed="false">3:10 </char><char style="xt" closed="false"><ref loc="MAT 9:20">मत्‌ती 9:20</ref>; <ref loc="MRK 4:1">मरकुस 4:1</ref>; <ref loc="LUK 5:1-3">लुका 5:1-3</ref></char></note> <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />वीटळ्‌ळा भुत लागला माणहु ईसु ने देखता वार मे, तीनी अगळ पड़ जत्‌ला, अने आड़ीन केतला, “तु भगवान नो बेटो से।”<note caller="+" style="x"><char style="xo" closed="false">3:11 </char><char style="xt" closed="false"><ref loc="MRK 1:23">मरकुस 1:23</ref>,<ref loc="MRK 1:24">24</ref></char></note> <verse eid="MRK 3:11" /><verse number="12" style="v" sid="MRK 3:12" />अने तत्‌यार मने उजन्‌तो ना करे कीन ईसु तीमने घणो जुदो चेतावणी आपत्‌लो।<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="MRK 1:25">मरकुस 1:25</ref>,<ref loc="MRK 1:34">34</ref>; <ref loc="ACT 16:17">नेवताळा ना काम 16:17</ref>,<ref loc="ACT 16:18">18</ref></char></note><verse eid="MRK 3:12" /></para>
  <para style="s">ईसु बारे चेला ने टाळे</para>
  <para style="r">(<ref loc="MAT 10:1-4">मत्‌ती 10:1-4</ref>; <ref loc="LUK 6:12-16">लुका 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />अळतेण ईसु बड़ा मे ज्‌यो अने जीने तीहयो मोंग करतो हतो, तीने आह़फान तां बोलायो, अने तीहया तीनीन्‌तां ज्‌या।<note caller="+" style="x"><char style="xo" closed="false">3:13 </char><char style="xt" closed="false"><ref loc="MAT 5:1">मत्‌ती 5:1</ref></char></note> <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />ईसु बारे जणा ने मार ह़ाते रेवो करीन टाळ्‌यो, अने तीमने नेवताळा बणायो अने तीहयो तीमने परच्‌यार करवा बी मोकलहे। <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />अने माणहुम गेथा भुत ने काडवा नो हक बी तमारी पांह रेहे।<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />अने तीना बारे नेवताळान नाम आहया से: सीमोन ईसु आनु नाम पतरस पाड़्‌यो; <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />अने जब्‌दी ना बे सोरा याकुब अने युहन्‌ना, आहया बे जणा ना नाम ईसु बुनरगीस पाड़्‌यो, तीनु मतलब गाजवा ह़रकु से; <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />अने अंदर्‌यास, अने फीलीपुस, अने बरतुलमय अने मत्‌ती, अने थोमस, अने हलफाय नो सोरो याकुब, अने तद्‌दे, अने सीमोन कनानी। <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />अने यहुदा ईस्‌करीयोती, तीहयो अगो जीन ईसु ने धोको दीन धराय देदलो।<verse eid="MRK 3:19" /></para>
  <para style="s">ईसु अने बालजबुल</para>
  <para style="r">(<ref loc="MAT 12:22-32">मत्‌ती 12:22-32</ref>; <ref loc="LUK 11:14-23">लुका 11:14-23</ref>; <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />बड़े गेथो ईसु घोर ज्‌यो। तां बी माणहु ढेरेत भेळा हय ज्‌या; एतरे ईसु ने अने चेला ने, रोट्‌लो खावा तक नवराय नी जड़ी।<note caller="+" style="x"><char style="xo" closed="false">3:20 </char><char style="xt" closed="false"><ref loc="MRK 6:31">मरकुस 6:31</ref></char></note> <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />एतरे ईसुन बारा मे माणहु आहयु केतला के, “ईसु सणकाय ज्‌यो!” एम करीन ईसु ना घोरल्‌या, ईसु ने जबराण आह़फा ना घोर, लाव्‌वा करीन चाल पड़्‌या।<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:22 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 9:34">मत्‌ती 9:34</ref>; <ref loc="MAT 10:25">10:25</ref></char>
    </note>यरुसलेम गेथा आवला युहदी-धरम ह़ीकाड़न्‌या बी केता हता के “ईसु मे ते बालजबुल भराय र्‌यो, जे भुत नो मुखी भुतड़ो से, अने आहयो ईसु आहया भुत ना ज्‌योरे भुत ने माणहु मे गेथा काडीन नहाड़े।”<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />ईसु तीमने ह़ाते बोलायो अने दाखलान<note caller="+" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="MRK 4:2">मरकुस 4:2</ref></char></note> लारे तीमने केदो: “भुतड़ो कीसम भुतड़ा ने नीकाळीन नहाड़ सके? <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />कदी एकीत राज ना माणहु आंबा-सांबा वीरोद करीन वटाय जाय, ता तीहयु राज कीसम टेकी सकहे? <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />एकीत घोर ना माणहु आंबा-सांबा वीरोद करीन वटाय जाय, ता तीहयु घोर कीसम टेकी सकहे? <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />एतरे कदी भुतड़ो आह़फा नो वीरोद करीन वटाय जाय, ता तीने टेकलो नी रेवाय अने तीहयो मर जाय।<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />“कोय बी माणहे एक जोर वाळा माणेह ना घोर मे भराय्‌न तीनु माल-धन लुटीन नी ली जाय सके; जत्‌यार तक तीने बांदी नी देय, अने जत्‌यार बांद देय ता तीना घोर ने लुट लेय।<note caller="+" style="x"><char style="xo" closed="false">3:27 </char><char style="xt" closed="false"><ref loc="ISA 49:24">यसाया 49:24</ref>,<ref loc="ISA 49:25">25</ref></char></note><verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />“मे तमने ह़ाचलीन केम के माणहु ने आखा पाप नी माफी जड़ जहे अने आञे तक कोय भगवान नो वाक काडीन तीनु नामबद्‌दी करहे तीने बी माफी जड़ जहे। <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" /><note caller="+" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">लुका 12:10</ref></char></note>पण कोय बी चोखली आत्‌मा नो वाक काडहे, तीमने कदी पाप नी माफी नी जड़े; पण तीहया जलम तक पाप ना गुनेगार रेहे।”<note caller="+" style="x"><char style="xo" closed="false">3:29 </char><char style="xt" closed="false"><ref loc="LUK 12:10">लुका 12:10</ref></char></note> <verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />ईसु आहयी वात आनी करते केदो काहाके तीहया केता हता के “ईसु मे एक वीटळ्‌ळो भुतड़ो भराय र्‌यो।”<verse eid="MRK 3:30" /></para>
  <para style="s">ईसु नी आय्‌ह अने भाय कोय से?</para>
  <para style="r">(<ref loc="MAT 12:46-50">मत्‌ती 12:46-50</ref>; <ref loc="LUK 8:19-21">लुका 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />तत्‌यार ईसुन आय्‌ह, अने भाय तां आया, अने बारथा उबा रीन ईसु ने बोलाव्‌वा करीन घोर मे बीजा ने मोकल्‌या। <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />माणहु नो मेळो तीनी आड़े-धेड़े बह र्‌यो हतो तीहया केदा, “तारी आय्‌ह अने तारो भाय अने बेनेह आय र्‌या अने तीहया तने ह़ोद र्‌या।”<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />ईसु जपाप आप्‌यो, “मारी आय्‌ह अने मारो भाय कोय से?” <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />ईसु तां बह रेला भणी भाळीन केदो, “देखो, आहया से, मारी आय्‌ह अने मारो भाय बेनेह; <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />जे भगवान नी मरजी नी लारे चालहे, तीहयो मारो भाय अने बेनेह, अने आय्‌ह से।”<verse eid="MRK 3:35" /></para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">बीज वावण्‌या नो दाखलो</para>
  <para style="r">(<ref loc="MAT 13:1-9">मत्‌ती 13:1-9</ref>; <ref loc="LUK 8:4-8">लुका 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:1 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 5:1-3">लुका 5:1-3</ref>
      </char>
    </note>ईसु अळी गलील दर्‌या धेड़े माणहु ने ह़ीकाड़वा बाज ज्‌यो। अळी घणा ढेरका माणहु ईसुन्‌तां ज्‌या। एतरे ईसु दर्‌या मे वाळा ढुंड्‌या मे जीन बह ज्‌यो, अने आखा माणहु दर्‌या धेड़े भोयमे उबा र्‌या। <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />अने दाखलान<note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="MRK 3:23">मरकुस 3:23</ref></char></note> लारे ईसु तीमने ढेरेत वात ह़ीकाड़्‌यो अने ह़ीकाड़तो जीन केदो:<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />“ह़मळो! एक बीज वावण्‌यो बीज वाव्‌वा ज्‌यो। <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />वाव्‌वा मे थोड़ाक बीज वाट धेड़े पड़्‌या अने चड़ा आवीन चुट खाय ज्‌या। <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />थोड़ाक बीज चाफर्‌या वाळा जागा मे पड़्‌या तां उतळो कादो हतो; एतरे तीहया छोटा उगी आया; <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />अने मुळ्‌या उन्‌डे नी ज्‌या। एतरे दाहड़ु उगीन तोप लाग्‌यो ता तीहया चीमाय्‌न ह़ुक ज्‌या। <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />पण थोड़ाक बीज काटा वाळा झाटवा मे पड़्‌या, अने काटा वाळा झाटवा मोटा हय्‌न तीने डाब देदा, अने मेर नी पाकी। <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />पण थोड़ाक बीज, वारली जागा मे पड़्‌या, अने तीहया उग्‌या, अने वदीन काना तीस गुणा, अने काना साट, अने काना ह़ोव गुणा, लग पाक्‌या।”<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="JHN 15:5">युहन्‌ना 15:5</ref>; <ref loc="COL 1:6">कुलुस्‌यो 1:6</ref></char></note><verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />ता ईसु केदो, जीनी पांह कान्‌टा हय तीहयो ह़मळी लेय।<note caller="+" style="x"><char style="xo" closed="false">4:9 </char><char style="xt" closed="false"><ref loc="MAT 11:15">मत्‌ती 11:15</ref>; <ref loc="MRK 4:23">मरकुस 4:23</ref></char></note><verse eid="MRK 4:9" /></para>
  <para style="s">ईसु दाखलो देखाड़ीन ह़ु केय?</para>
  <para style="r">(<ref loc="MAT 13:10-17">मत्‌ती 13:10-17</ref>; <ref loc="LUK 8:9-10">लुका 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />अळतेण जत्‌यार माणहु जत र्‌या अने ईसु एखलो री ज्‌यो, ता बारे नेवताळा अने थोड़ाक बीजा चेला बी ईसु ह़ाते आवीन तीहया दाखला ना बारा मे पुछ्‌या। <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />ईसु आह़फा ना चेला ने केदा, “भगवान आह़फा ना राज नी ह़तायली वात, तमारीत पोर उजन्‌ती करलो से, पण तमने सोड़ीन बीजा ने दाखलान लारे भगवान नी वात ह़मळावा पड़े। <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />तीहया देखे ते खरा पण देखता जीन बी नी ओळखे, अने तीहया ह़मळता जीन बी नी ह़मजे। कदीम तीहया आह़फा ना पाप भणी गेथा मन बदलीन भगवान भणी वळ जता ता भगवान तीमने माफ कर देतो।”<note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ISA 6:9">यसाया 6:9</ref>,<ref loc="ISA 6:10">10</ref></char></note><verse eid="MRK 4:12" /></para>
  <para style="s">बीज वावण्‌या ना दाखला नो ह़ारो</para>
  <para style="r">(<ref loc="MAT 13:18-23">मत्‌ती 13:18-23</ref>; <ref loc="LUK 8:11-15">लुका 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />ईसु तीहया चेला ने अळी केदो, “तमने आहयो दाखलो नी ह़मज आवतो ता बीजा आखा दाखला कीसम पल्‌ले पड़हे। <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />कीरसाण जे वावे तीहया भगवान ना बोल से।<note caller="+" style="x"><char style="xo" closed="false">4:14 </char><char style="xt" closed="false"><ref loc="MRK 16:20">मरकुस 16:20</ref>; <ref loc="LUK 1:2">लुका 1:2</ref>; <ref loc="ACT 4:31">नेवताळा ना काम 4:31</ref>; <ref loc="ACT 8:4">8:4</ref>; <ref loc="ACT 16:6">16:6</ref>; <ref loc="ACT 17:11">17:11</ref>; <ref loc="PHP 1:14">फीलीपीयो 1:14</ref></char></note> <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />काना माणहु तीहया वाट धेड़े वाळा जागान तेम से, तां ह़ारीक बीज ह़रको भगवान नो बोल ववाय जाय, तीहया भगवान नो बोल ह़मळे ते खरा पण भुतड़ो तत्‌यारुत आवीन भगवान नो बोल तीमनी मे गेथो लीन जती रेय। <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />काना माणहु तीहया चाफर्‌या वाळा जागान तेवा से; तीहया भगवान ना बोलु ह़मळीन खुसी-खुसी सी अवरी ते लेय: <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />पण तीमनी मोय भगवान ना बोलु ना मुळ्‌या उन्‌डे नी रेय, एतरे तीहया थोड़ीक वार लग भरहो करे; अने अळतेण भगवान नी वात नी लेदे कंय बी वेला, अने दुख झेलवा पड़े ता तीहया तत्‌यारुत भरहो करवा सोड़ देय। <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />अने काना माणहु कटाळस्‌या वाळा जागान तेवा से; तीहया भगवान नो बोल ह़मळे, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />पण तीहया जीवाय नी फीकर करीन अने मालदार बणवा नी हेर<note caller="+" style="x"><char style="xo" closed="false">4:19 </char><char style="xt" closed="false"><ref loc="MAT 19:23">मत्‌ती 19:23</ref>; <ref loc="1TI 6:9">1 तीमुथीयुस 6:9</ref>,<ref loc="1TI 6:10">10</ref>,<ref loc="1TI 6:17">17</ref>; <ref loc="1JN 2:15-17">1 युहन्‌ना 2:15-17</ref> </char></note> करीन भगवान ना बोल ने टाळ देय, अने तीहया नी फाले। <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />अने काना माणहु तीहया वारला जागान तेवा से, तां ह़ारीक बीज ने तेवो भगवान नो बोल ववाय जाय; आहया भगवान नो बोल ह़मळे अने मनीन पाळे। अने आहया फोळ लावे, काना तीस गुणा, अने काना साट गुणा, अने काना ह़ोव गुणा।”<verse eid="MRK 4:20" /></para>
  <para style="s">दीवा नो दाखलो</para>
  <para style="r">(<ref loc="LUK 8:16-18">लुका 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:21 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:15">मत्‌ती 5:15</ref>; <ref loc="LUK 11:33">लुका 11:33</ref></char>
    </note>ईसु चेला ने केदो, “दीवा ने धपाड़ीन कांगणी तळे अने खाटला तळे मेकवा लावत्‌ला? के घोर मे वीजाळु करवा करीन दीवलाय पोर मेकवा लावत्‌ला? <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" /><note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="MAT 10:26">मत्‌ती 10:26</ref>; <ref loc="LUK 12:2">लुका 12:2</ref></char></note>एवु कंय बी चीज ह़तायलु नी हय, जे वीजाळाम नी लवाये, अने एवु कंय बी ढकायलु नी हय जे उजन्‌तु मालम नी हये।<note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="JER 16:17">यीरम्‌या 16:17</ref>; <ref loc="MAT 10:26">मत्‌ती 10:26</ref>; <ref loc="LUK 8:17">लुका 8:17</ref>; <ref loc="LUK 12:2">12:2</ref></char></note> <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />जीना ह़मळवा ना कान्‌टा हय, तीहयो ह़मळी लेय।”<note caller="+" style="x"><char style="xo" closed="false">4:23 </char><char style="xt" closed="false"><ref loc="MAT 7:2">मत्‌ती 7:2</ref>; <ref loc="LUK 6:38">लुका 6:38</ref></char></note><verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:24 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 7:2">मत्‌ती 7:2</ref>; <ref loc="LUK 6:38">लुका 6:38</ref></char>
    </note>ईसु अळी तीमने केदो, “जे कंय तमु ह़मळो तीहयी वात पोर मन लगाड़ीन वीच्‌यार करो! जे माप सी तमु मापहु तीहया माप सी तमारी जुगु बी मापहे अळी तमने जादा आपहे। <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" /><note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 13:12">मत्‌ती 13:12</ref>; <ref loc="MAT 25:29">25:29</ref>; <ref loc="LUK 19:26">लुका 19:26</ref></char></note>काहाके जीनी पांह से, तीने आपहे; पण जीनी पांह नी हय, तीनी पांह तीहयु बी जे तीनी पांह से, ली लेहे।”<note caller="+" style="x"><char style="xo" closed="false">4:25 </char><char style="xt" closed="false"><ref loc="MAT 7">मत्‌ती 7</ref>; <ref loc="LUK 6:38">लुका 6:38</ref></char></note><verse eid="MRK 4:25" /></para>
  <para style="s">उगवा वाळा बीज नो दाखलो</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />ईसु अळी एक दाखलो केदो “भगवान नु राज आह़फु वदवा वाळा बीज ह़रकु से। एक कीरसाण खेतर मे बीज वाव्‌यो। <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />तीहयो राते ह़ुयो, अने दीहु जाग्‌यो। अने तीहया बीज कीसम उगीन वद्‌या, तीहयो नी जाणे। <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />कादु मे मेर आह़फी वदीन पाक जाय। पेले ह़ुको फुटे, अळतेण उंब्‌या आवीन नीहवे, अळतेण उंब्‌या मे दाणा आवे। <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />जत्‌यार दाणा पाक जाय, अने वाडवा नी टेम आय जाय, ता तत्‌यारुत तीहयो दातड़े करीन वाडवा बाज जाय।”<note caller="+" style="x"><char style="xo" closed="false">4:29 </char><char style="xt" closed="false"><ref loc="JOL 3:13">योएल 3:13</ref></char></note><verse eid="MRK 4:29" /></para>
  <para style="s">राय ना बीज नो दाखलो</para>
  <para style="r">(<ref loc="MAT 13:31">मत्‌ती 13:31</ref>,<ref loc="MAT 13:32">32</ref>,<ref loc="MAT 13:34">34</ref>; <ref loc="LUK 13:18">लुका 13:18</ref>,<ref loc="LUK 13:19">19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />“ईसु अळी केदो आपणु काना हीसाबे देखाड़या के भगवान नु राज केवु से?”<note caller="+" style="x"><char style="xo" closed="false">4:30 </char><char style="xt" closed="false"><ref loc="MAT 13:24">मत्‌ती 13:24</ref></char></note> अने आहया राज ने अळी काना राज्‌य सी अने काना दाखलान लारे ह़मजाड़या? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />भगवान नु राज राय ना दाणान तेवु से; तीहयु जत्‌यार धरती मे वावे, ता बीजा आखा बीज गेथु नानु देखाये। <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />पण वदे ता आखा भाजी-पाला ना झाटवा गेथु मोटु हय जाय, अने डाळ्‌या घणा पनाय जाय, अने ईना साहळे उडण्‌या चड़ा तक पोतरो बांदीन रेय।<note caller="+" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="DAN 4:12">दानीयल 4:12</ref></char></note><verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />ईसु अळी एसवा रेट दाखलान लारे माणहु जेतरु ह़मज सके, तेतरो भगवान नो बोल; ह़मळावतो हतो।<note caller="+" style="x"><char style="xo" closed="false">4:33 </char><char style="xt" closed="false"><ref loc="JHN 16:12">युहन्‌ना 16:12</ref></char></note> <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />दाखलो देखाड़ीन ईसु तीमने ह़ीकाड़त्‌लो,<note caller="+" style="x"><char style="xo" closed="false">4:34 </char><char style="xt" closed="false"><ref loc="JHN 16:25">युहन्‌ना 16:25</ref></char></note> पण माणहु जत रेय ता चेला ने दाखला नो ह़ारो काडीन देखाड़त्‌लो।<verse eid="MRK 4:34" /></para>
  <para style="s">आंजी ने हुकम आपीन मनाड़वा</para>
  <para style="r">(<ref loc="MAT 8:23-27">मत्‌ती 8:23-27</ref>; <ref loc="LUK 8:22-25">लुका 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />तीहया दाड़े ह़ांती टेमे, “ईसु चेला ने केदो; आपणु दर्‌या नी ह़ेली पार जता।” <verse eid="MRK 4:35" /><verse number="36" style="v" sid="MRK 4:36" />एतरे माणहु ने तांत रेवा दीन चेला ईसु ने ढुंड्‌या मे जेमेत बहलो हतो तेमेत लीन जवा बाज ज्‌या,<note caller="+" style="x"><char style="xo" closed="false">4:36 </char><char style="xt" closed="false"><ref loc="MRK 3:9">मरकुस 3:9</ref>; <ref loc="MRK 5:2">5:2</ref>; <ref loc="MRK 6:32">6:32</ref>,<ref loc="MRK 6:45">45</ref></char></note> अने तीमनी ह़ाते थोड़ाक माणहु बी ढुंड्‌या लीन चाल पड़्‌या। <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />ता दर्‌या मे आंजी आवी, अने झलक ढुंड्‌ये घणी अफठायी, अने ढुंड्‌या मे लग पाणी भराय ज्‌यु। <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />ईसु ढुंड्‌या ना पाछला खुणा मे गादी पोर ह़ुय र्‌यो हतो। चेला ईसु ने उठाड़्‌या अने तीने केदा, “मास्‌तर आमु ते डुबीन मरवा बाज र्‌या, तने फीकर नी हय ह़ु?”<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />ईसु तत्‌यार उठ्‌यो अने आंजी ने वड्‌यो, अने झलक ने केदो, “होगी री जा!” उबी री जा, ता आंजी बंद हय जी अने धीरी पड़ जी।<verse eid="MRK 4:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 4:40" />ईसु चेला ने केदो, “तमु काहा बीही र्‌या? तमने हजु लग भरहो नी हय ह़ु?”<note caller="+" style="x"><char style="xo" closed="false">4:40 </char><char style="xt" closed="false"><ref loc="MAT 14:31">मत्‌ती 14:31</ref>; <ref loc="MRK 16:14">मरकुस 16:14</ref></char></note> <verse eid="MRK 4:40" /><verse number="41" style="v" sid="MRK 4:41" />चेला घणा जबर बीह ज्‌या अने आंबा-सांबा केवा बाज ज्‌या, आहयो माणहे कोय से? आनो हुकम आंजी अने झलक लग मान लेय!<verse eid="MRK 4:41" /></para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">ईसु भुत ने एक माणेह मे गेथो काडे</para>
  <para style="r">(<ref loc="MAT 8:28-34">मत्‌ती 8:28-34</ref>; <ref loc="LUK 8:26-39">लुका 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />ईसु अने तीना चेला दर्‌यान ह़ेली धेड़े, गेरासन्‌या मुलक पुग्‌या। <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />ईसु ढुंड्‌या मे गेथो उतर्‌यो; ता वीटळ्‌ळा भुत लागलो एक माणेह मड़ाट्‌या मे गेथो नीकळीन ईसु भणी दवड़ीन आयो। <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />तीहयो माणेह मड़ाट्‌या मे रेतो हतो। तीहया माणेह ने हातकड़ी अने पोगकड़ी अने ह़ाकळ वेर बांदता हता, ते बी तीहयो कोय सी नी बंदायतो हतो। <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />काहाके तीने काय केतरा कावा हातकड़ी अने पोगकड़ी अने ह़ाकळ्‌ये वेर बांदता हता पण तीहयो तीमने आजड़ो दीन तोड़ नाखत्‌लो। अने ह़ाकल्‌या ने तोड़ीन वेखड़ी देत्‌लो अने ईने कोय बी बदाड़ नी सकता हता। <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />तीहयो रात-दाड़ो मड़ाट्‌या मे अने बड़ा मे आड़तो फीरतो हतो, अने आह़फा ने दगड़ा दी-दीन सुंदतो हतो।<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />तीहयु माणेह थोड़ोक सेटो रीन ईसु ने आवत्‌लो देख्‌यो अने दवड़ीन जाय्‌न ईसु अगळ मांडा ना भरहे पड़्‌यो। <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />ज्‌योरेत आड़ीन केदो, “ए ईसु आखा मे मुख्‌या भगवान ना सोरा;<note caller="+" style="x"><char style="xo" closed="false">5:7 </char><char style="xt" closed="false"><ref loc="MAT 4:3">मत्‌ती 4:3</ref>; <ref loc="LUK 1:32">लुका 1:32</ref>; <ref loc="LUK 6:35">6:35</ref>; <ref loc="ACT 16:17">नेवताळा ना काम 16:17</ref>; <ref loc="HEB 7:1">ईब्‌रानीयो 7:1</ref></char></note> मारी ह़ाते तारु ह़ु काम? मने डंड ना आपे करीन भगवान नी आण घाल देदो।” <verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />काहाके ईसु तीने केतो हतो, “ए वीटळ्‌ळा भुत, आहया माणेह मे गेथो नीकळ जा!”<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />ईसु तीहया माणेह ने पुछ्‌यो, “तारु ह़ु नाम से?” अने तीहयो ईसु ने केदो, “मेळा, काहाके आमु घणा ढेरका से।” <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />अने भुत ईसु सी वीन्‌ती कर्‌या, “आमने आहया मुलक मे गेथो ना मोकले।”<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />तां एक बड़ी पोर गुवाळ्‌या ह़ुवर्‌या ना एक मोट्‌ला टोळा ने चारवा बाज र्‌या हता। <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />भुत अळी ईसु सी वीन्‌ती कर्‌या, “आमने ह़ेला ह़ुवर्‌या मे मोकली दे, ता आमु हीमनी मे भराय जीया।” <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />ईसु वीटळ्‌ळा भुत ने हुकम आप्‌यो; तत्‌यार तीहया वीटळ्‌ळा भुत तीनी मे गेथा नीकळीन ह़ुवर्‌या मे जाय्‌न भराय ज्‌या; अने तीहया ह़ुवर्‌या बेक हजार हता, अने आखा ह़ुवर्‌या आड़खे गेथा दर्‌या मे कुद पड़्‌या, अने पाणी मे डुबीन मर ज्‌या।<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />आहयु देखीन गुवाळ्‌या दवड़ीन फळ्‌या अने गाम मे जाय्‌न जे हयु, तीनी खबर कर देदा, अने जे हयु तीहयु देखवा आखा माणहु आया। <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />जत्‌यार तीहया ईसुन्‌तां आया, ता तीहया ते माणेह ने देख्‌या जीने पेले भुत लागला हता। हाव तीहयो वारु हय्‌न लुगड़ा पेरीन होगो हय्‌न बही र्‌यो हतो, एतरे तीहया बीही ज्‌या। <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />भुत लागला माणेह ने अने ह़ुवर्‌या ने ह़ु हयु, तीहयु देखवा वाळा माणहु, जाय्‌न बीजा माणहु ने की देदा।<verse eid="MRK 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 5:17" />तत्‌यार माणहु आवीन ईसु ने वीन्‌ती कर्‌या के “अमारु मुलक सोड़ीन जती रे।”<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />ईसु पासो जवा करीन ढुंड्‌यु मे बहवा बाज ज्‌यो; ता जीने पेले भुत लागला हता, तीहयो माणेह ईसु ने केदो: “मने तारी ह़ाते आव्‌वा दे।”<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />ईसु तीने केदो: “नी, मार ह़ाते ना आवे, पण घोर जा अने भगवान मालीक तार पोर दया करीन तारी वाटु केतरु वारु काम कर्‌यो तीहयु तारा माणहु ने देखाड़जे।”<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />तीहयो ता गेथो आह़फा ना दीकापुलीस जीला मे आखी जागे जाय्‌न परच्‌यार करवा बाज ज्‌यो के ईसु मारी वाटु घणु वारु काम कर्‌यो अने माणहु तीनी वात ह़मळीन वहराय जता हता।<verse eid="MRK 5:20" /></para>
  <para style="s">आयर नी मरली सोरी अने पोगराळा दुख वाळी बयर</para>
  <para style="r">(<ref loc="MAT 9:18-26">मत्‌ती 9:18-26</ref>; <ref loc="LUK 8:40-56">लुका 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />गरासन्‌या मुलक गेथो ईसु पासो ढुंड्‌या मे बहीन दर्‌या नी ह़ेली धेड़े ज्‌यो; तत्‌यार तां घणा ढेरका माणहु भेळा हय ज्‌या।<note caller="+" style="x"><char style="xo" closed="false">5:21 </char><char style="xt" closed="false"><ref loc="MRK 4:1">मरकुस 4:1</ref></char></note> <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />आयर नाम नु एक माणेह हतु, तीहयो तीमना भक्‌तीन घोर ना अदीकार्‌या मे नो एक हतो।<note caller="+" style="x"><char style="xo" closed="false">5:22 </char><char style="xt" closed="false"><ref loc="LUK 13:14">लुका 13:14</ref></char></note> तीहयो आवीन ईसु ना पोगे पड़्‌यो। <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />तीहयो ईसु सी वीन्‌ती कर्‌यो, “मारी नान्‌ली सोरी मरवा वाळी से। दया करीन मारी ह़ाते चाल, अने तीनी पोर हात मेल अने तीहयी वारु हय्‌न जीवत्‌ली रेय!”<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />ईसु तीनी ह़ाते चाल पड़्‌यो अने हुड़ु-हुड़ु माणहु बी तीनी ह़ाते चाल पड़्‌या। अने तीनी ह़ाते चालन्‌या माणहु चमदाय्‌न अने धकलाय्‌न ईसु पोर पड़ जता हता।<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />एक बयर हती तीने बारे साल सी पोगराळो दुख हतो। <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />तीहयी घणी दुखी हती अने दाकतर्‌या मे ईलाज करावी-करावीन आखा पय्‌हा खरचो कर देदली। ते बी वारु नी हयी। पण अळी जादा मांदी हय जी। <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />तीहयी ईसु ना बारा मे आहयु ह़मळीन गड़दी मे तीनी पसळ गेथी आयी अने तीनु लुगड़ु सीम लेदी, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />काहाके तीहयी केती हती “कदी मे ईसु नु लुगड़ु सीम लेही, ता मे वारु हय जही करीन माणहु नी भीड़ मे धकलाय्‌न ईसु नु लुगड़ु सीम लेदी।”<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />अने तीनु लोय वयवा बंद हय ज्‌यु, अने तीने आह़फी ना डील मे मालम पड़्‌यु, के मे हीड़ा-पीड़ाम मे गेथी छुटीन वारु हय जी। <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />अने तत्‌यारुत ईसु ने बी आह़फा ना डील मे मालम पड़ ज्‌यु के मारी मे गेथो आरगाय आपवा नो जोर नीकळलो से, अने ईसु पासो फीरीन गड़दी मे वाळा माणहु ने पुछ्‌यो, “मारु डगलु कोय छीम्‌यु?”<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />तीना चेला तीने केदा, “आहया माणहु ते चमदाय्‌न अने धकलाय्‌न तारी पोर पड़ र्‌या ता तु काहा पुछ र्‌यो के; मने कोय छीम्‌यु?”<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />ते बी मने कोय छीम्‌यो आहयु देखवा करीन ईसु च्‌यारो-मेर भाळवा बाज ज्‌यो। <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />मारु घणु जबर भलु हयलु से, ईसम जाणीन तीहयी बीहती अने कापती जाय्‌न ईसुन्‌तां आवी। अने ईसु ना पोगे पड़ी, अने आखा ने जे कंय हयु तीहयु ह़ाचलीन की देदी। <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />ईसु तीने केदो, “ओ बेटी, तु ते मार पोर भरहो करी, करीन तु हीड़ा-पीड़ाम गेथी छुटीन वारु हय जी।<note caller="+" style="x"><char style="xo" closed="false">5:34 </char><char style="xt" closed="false"><ref loc="MAT 9:22">मत्‌ती 9:22</ref></char></note> एतरे ह़ुकना जीवे जती रे, तारो रोग जती र्‌यो हाव तु बेफीकर रेजे।”<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />ईसु तीहयी बयर ने केवात बाज र्‌यो हतो ता थोड़ाक माणहु आयर ना घोर गेथा आवीन तीने केदा, “तारी सोरी नी बची, एतरे मास्‌तर ने उदड़े ना दमे।”<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />ईसु तीमनी वात ह़मळ्‌यो पण ध्‌यान नी देदो, ते बी आयर ने केदो, “बीहे ना, पण नीस्‌तो मारी पोर भरहो राख।” <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />ईसु बीजा माणहु ने वाट्‌ये रेवा दीन पतरस ने, याकुब ने अने याकुब ना भाय युहन्‌ना ने एतरो आह़फा ह़ाते आव्‌वा देदो। <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />अने ईसु तीमनी ह़ाते आयर ना घोर ज्‌यो; अने घोर मे माणहु ने घणा जादा रड़त्‌ला देख्‌यो अने ह़मळ्‌यो। <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />ईसु तीमने केदो, “तमु काहा रड़ीन-कल्‌पी र्‌या? सोरी मरी नी, पण ह़ुव्‌वा बाज र्‌यी।”<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />माणहु ईसु नी वात ह़मळीन ईसु ने हाह़वा बाज ज्‌या। अने ईसु तीमने आखा ने घोर मे गेथो बारो काड देदो, अने आय्‌ह़-बाहा ने अने तीन चेला ने लीन तीना कोपरा मे ज्‌यो तां ह़ारीक सोरी मरली पड़ रेली हती। <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />ईसु सोरी नो हात धरीन तीमनी बोली मे केदो, “तलीता कुमी, आनु मतलब से, ‘ओ सोरी, मे तने केम उठ!’”<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />अने तीहयी नान्‌ली सोरी तत्‌यारुत जीवती हय्‌न उठ जी अने तां ह़ारीक हींडवा बाज ज्‌यी; तीहयी सोरी बारे साल नी हती। अने तीहया आहयु देखीन घणा घबराय ज्‌या। <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />ईसु तीमने हुकम आपीन केदो, आहयी वात कोयने मालम नी हयवा देजो, “अने आहयु बी केदो के सोरी ने खावा आपो।”<verse eid="MRK 5:43" /></para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">नासरत गाम मे ईसु नी कंय ईज्‌जत नी</para>
  <para style="r">(<ref loc="MAT 13:53-58">मत्‌ती 13:53-58</ref>; <ref loc="LUK 4:16-30">लुका 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />तां गेथो ईसु आह़फा ना ह़ेर नासरत<note caller="+" style="x"><char style="xo" closed="false">6:1 </char><char style="xt" closed="false"><ref loc="MAT 2:23">मत्‌ती 2:23</ref></char></note> भणी चाल पड़्‌यो अने तीनी ह़ाते तीना चेला बी चाल पड़्‌या। <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />अने तीहयो अराम ना दाड़े <note caller="+" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="MRK 1:21">मरकुस 1:21</ref></char></note> तीमना भक्‌तीन घोर मे माणहु ने ह़ीकाड़वा बाज ज्‌यो, अने आखा तीनी ह़मळीन भंगलाय ज्‌या, अने आंबा-सांबा पुछवा बाज ज्‌या, “आने ईसम अक्‌कल अने घणा काम करवा करीन सक्‌ती कां गेथी जड़ी? <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />आहयो तीहयोन-तीहयो ह़ुतार नी हय ह़ु, आहयो मरीयम नो सोरो से, अने आहयोत याकुब नो, योसेस नो, यहुदा नो, अने सीमोन नो भाय नी हय ह़ु?<note caller="+" style="x"><char style="xo" closed="false">6:3 </char><char style="xt" closed="false"><ref loc="MAT 12:46">मत्‌ती 12:46</ref></char></note> अने आना बेन्‌या अमारी वच मे नी रेय ह़ु?” आहयो तीहयोत से अने ईसम वात करीन तीहया ईसु ने नकार देदा।<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:4 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 4:44">युहन्‌ना 4:44</ref>
      </char>
    </note>ईसु तीमने केदो “भगवान वगे गेथी वात केण्‌या माणहु ना गांमल्‌या, भाय-बेटा अने घोरल्‌या ईज्‌जत नी करे, पण बीजा ईज्‌जत करे।”<note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="LUK 4:24">लुका 4:24</ref></char></note><verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />एतरे ईसु आह़फा ना ह़ेर मे ढेरेत काम नी कर्‌यो; पण थोड़ाक मांदला पोर हात मेलीन<note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="MRK 5:23">मरकुस 5:23</ref></char></note> तीमने आरगा कर्‌यो। <verse eid="MRK 6:5" /><verse number="6" style="v" sid="MRK 6:6" />ईसु आह़फा ना ह़ेर वाळा नो वण-भरहो देख्‌यो ता तीहयो घबराय ज्‌यो। अळतेण ईसु आहया गाम ने ह़ेला गाम, हींडी-हींडीन ह़ीकाड़तो र्‌यो।<note caller="+" style="x"><char style="xo" closed="false">6:6 </char><char style="xt" closed="false"><ref loc="MAT 9:35">मत्‌ती 9:35</ref>; <ref loc="MRK 1:39">मरकुस 1:39</ref>; <ref loc="LUK 13:22">लुका 13:22</ref></char></note><verse eid="MRK 6:6" /></para>
  <para style="s">ईसु बारे चेला ने परच्‌यार करवा मोकले</para>
  <para style="r">(<ref loc="MAT 10:5-15">मत्‌ती 10:5-15</ref>; <ref loc="LUK 9:1-6">लुका 9:1-6</ref>)</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 6:7" />ईसु आह़फा ना बारे नेवताळा ने बोलायो अने तीमने भुत पोर हक आप्‌यो; अने बे-बे जणा करीन मोकलवा बाज ज्‌यो।<note caller="+" style="x"><char style="xo" closed="false">6:7 </char><char style="xt" closed="false"><ref loc="LUK 10:1">लुका 10:1</ref></char></note> <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />ईसु तीमने हुकम आप्‌यो, “जत्‌यार तमु जावो ता वाट्‌ये वापरवा जुगु एक डींगा ने सोड़ीन कंय नी लीज्‌जो रोट्‌ला झोलो अने खीच्‌या मे पय्‌हा नी लीज्‌जो।” <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />चाट्‌या पेरजो अने पेरलु डगलुत पेरीन जजो, बीजु नी लीज्‌जो। <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />अने ईसु तीमने केदो, “जे घोर मे तमने बोलावे, तीहया घोर मे तांह तक रेजो, जत्‌यार तक तां गेथा जावो नी <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" /><note caller="+" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">लुका 10:4-11</ref></char></note>काना बी जागे माणहु तमारो आव-भाव नी करे अने तमारी वात नी ह़मळे, ता तां गेथा आव्‌वान पेले पोगे नो कादो तां झटकी देजो आहयु तीमनी वाटु आव्‌वा वाळा डंड ना बारा मे चेतावणी रेहे।”<note caller="+" style="x"><char style="xo" closed="false">6:11 </char><char style="xt" closed="false"><ref loc="LUK 10:4-11">लुका 10:4-11</ref></char></note><verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />तीहया तां गेथा जत र्‌या अने जीन परच्‌यार कर्‌या पापु करवा सोड़ देवो अने भगवान वगा वळो। <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" /><note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">याकुब 5:14</ref></char></note>घण ढेरका माणहु मे गेथा तीहया भुत काड्‌या, अने मांदला ने तेल लगाड़ीन आरगा कर्‌या।<note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JAS 5:14">याकुब 5:14</ref></char></note><verse eid="MRK 6:13" /></para>
  <para style="s">बपतीस्‌मा आपण्‌या युहन्‌ना ने मारवा</para>
  <para style="r">(<ref loc="MAT 14:1-12">मत्‌ती 14:1-12</ref>; <ref loc="LUK 9:7-9">लुका 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:14 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 16:14">मत्‌ती 16:14</ref>; <ref loc="MRK 8:28">मरकुस 8:28</ref>; <ref loc="LUK 9:19">लुका 9:19</ref></char>
    </note>ईसम करीन ईसु आखी दुर नामह़ाद्‌यो हय ज्‌यो, आञे तक के हेरोद राजा। ईसु ना बारा मे ह़मळीन केदो, “बपतीस्‌मा आपण्‌यो युहन्‌नो पासो जीवतो हय जेलो से; करीन आनी सी सक्‌ती ना घणा कामु हये।”<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />पण बीजा केदा, “नीला, आहयो एलीयो से।” अने बीजा केदा, “नीला, आहयो भगवान वगे गेथी वात केण्‌या माणहुन तेवो एक से।”<note caller="+" style="x"><char style="xo" closed="false">6:15 </char><char style="xt" closed="false"><ref loc="MAL 4:5">मलाकी 4:5</ref>; <ref loc="MAT 16:14">मत्‌ती 16:14</ref>; <ref loc="MAT 21:11">21:11</ref>; <ref loc="MRK 8:28">मरकुस 8:28</ref>; <ref loc="LUK 9:19">लुका 9:19</ref></char></note><verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />हेरोद राजा आहयी वात ह़मळ्‌यो ता केदो “ह़ाचलीन, आहयो ते युहन्‌नोत से, जीनु मुंडु मे वडाड़ नाखलो हतो। अने आहयोत पासो जीवतो हय जेलो से।” <verse eid="MRK 6:16" /><verse number="17" style="v" sid="MRK 6:17" /><note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="LUK 3:19">लुका 3:19</ref>,<ref loc="LUK 3:20">20</ref></char></note>हेरोद राजा सीपायड़ा ने मोकलीन युहन्‌ना ने ह़ाकळ्‌या वेर बांदीन जेल मे कुंडाड़ देदलो काहाके हेरोद तीना नान्‌ला भाय फीलीपुस नी लाडी हेरोदीयास ना ह़ाते वेवा कर लेदलो हतो अने युहन्‌नो तीने आहयु गलत से केतो हतो।<note caller="+" style="x"><char style="xo" closed="false">6:17 </char><char style="xt" closed="false"><ref loc="MAT 4:12">मत्‌ती 4:12</ref>; <ref loc="MAT 11:2">11:2</ref>; <ref loc="LUK 3:19">लुका 3:19</ref>,<ref loc="LUK 3:20">20</ref></char></note> <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />आहयो बपतीस्‌मा आपण्‌यो युहन्‌नो हेरोद ने वळ-वळीन केतो हतो के तु आह़फा ना भाय फीलीपुस नी लाडी ना ह़ाते वेवा कर्‌यो हीय्‌यु वारु नी हय।<note caller="+" style="x"><char style="xo" closed="false">6:18 </char><char style="xt" closed="false"><ref loc="LEV 18:16">लेव्‌यवेवस्‌था 18:16</ref>; <ref loc="LEV 20:21">20:21</ref></char></note><verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />आहयी हेरोदीयास तीहया युहन्‌ना पोर रीह कर री हती, तीहयी तीने मराव्‌वा हींडती हती। पण हेरोद राजा ईनी वात मे राजी नी हतो, करीन नी मार सकी। <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />हेरोद राजा युहन्‌ना ने धरमी अने चोखलो माणेह जाणीन तीनी सी बीहतो हतो, अने तीनी रखवाळी करावतो हतो।<note caller="+" style="x"><char style="xo" closed="false">6:20 </char><char style="xt" closed="false"><ref loc="MAT 11:9">मत्‌ती 11:9</ref></char></note> हेरोद तीनी वात ह़मळीन घण-जबर घबरायतो ते हतो, ते बी खुस हय्‌न तीनी वात ह़मळतो हतो।<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />राजा हेरोद नी पयदावारी ना तीवार ना दाड़े हेरोदीयास ने वारु मोखो जड़ी ज्‌यो। तीहया दाड़े, राजा हेरोद, आह़फा ना गलील जीला ना डायला ने अने रोमी सीपायड़ा ना डायला ने अने तां वाळा असामी माय्‌न मोट्‌ला ने पंगात मे खावा बोलायो। <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />अने तत्‌यारुत एक सोरी आखा पोरणा अगळ नाचवा आयी तीहयी ते हेरोदीयास नी सोरी हती अने तीहयी तां बह रेला आखा ने केदी अने हेरोद राजा ने वारु नाचीन खुस कर देदी। तत्‌यार राजा हेरोद सोरी ने केदो “तने जे बी जोवे तीहयु मारी पांह मांग, मे तने आप देही।” <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />अने तीहयो आण घालीन केदो, “जे कंय तु मांगही तीहयु आप देही, भले आदु राज मांगे तीहयु लग आप देही।”<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />सोरी बारथी जीन आह़फी नी आय्‌ह़ हेरोदीयास ने पुछी अया मे ह़ु मांगु? तीहयी केदी “बपतीस्‌मा आपवा वाळा युहन्‌ना नु मुंडु मांग ले।”<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />सोरी तत्‌यारुत पाछी राजान्‌तां दवड़ीन जी अने केदी “बपतीस्‌मा आपवा वाळा युहन्‌ना नु मुंडु हमणे थाळी मे मंगाड़ ले।”<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />सोरी नी वात ह़मळीन राजा ने घणो दुख ते लाग्‌यो, पण पोरणाम नी अगळ आण घालीन वायदो करलो हतो; एतरे तीहयी सोरी नी वात ने नी टाळ्‌यो। <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />अने राजा तत्‌यारुत एक सीपायड़ा ने युहन्‌ना नु मुंडु वाडीन लाव कीन जेल मे मोकल्‌यो, <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />तीहयो जेल मे ज्‌यो अने युहन्‌ना नु मुंडु वाडीन थाळी मे मेलीन लायो, अने तीहयी सोरी ने आप्‌यो अने सोरी आय्‌ह़ ने आप देदी। <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />युहन्‌ना ना चेला आहयी खबर ह़मळीन आया, अने तीनु धोड़ ली जाय्‌न मड़ाट्‌या मे गाड़ीन वगे कर देदा।<verse eid="MRK 6:29" /></para>
  <para style="s">चेला पासा आवे अने उजाड़ी जागो</para>
  <para style="r">(<ref loc="MAT 14:1-12">मत्‌ती 14:1-12</ref>; <ref loc="LUK 9:7-9">लुका 9:7-9</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />अने ईसु ना बारे नेवताळा<note caller="+" style="x"><char style="xo" closed="false">6:30 </char><char style="xt" closed="false"><ref loc="MAT 10:2">मत्‌ती 10:2</ref>; <ref loc="MAT 17:5">17:5</ref>; <ref loc="MAT 22:14">22:14</ref>; <ref loc="MAT 24:10">24:10</ref>; <ref loc="ACT 1:2-26">नेवताळा ना काम 1:2-26</ref>; <ref loc="MRK 3:20">मरकुस 3:20</ref></char></note> सेवा करवा जेला हता, तीहया ईसुन्‌तां पासा आवीन भेळा हया अने जे कर्‌या अने ह़ीकाड़्‌या तीहयु आखु की देदा। <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />तां लग घणा ढेरका माणहु आव्‌वा अने जवा बाज र्‌या हता। करीन तीमने खावा लग नवराय नी जड़ी।<note caller="+" style="x"><char style="xo" closed="false">6:31 </char><char style="xt" closed="false"><ref loc="MRK 3:20">मरकुस 3:20</ref></char></note> एतरे ईसु तीमने केदो, “चालो, आपणु बड़ा मे एक वगा उजाड़ी जागा मे जता, तां जीन तमु थोड़ीक वार थाको पी लेजो।” <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />अने ईसम कीन तीहया ढुंड्‌या मे बहीन एक वगा उजाड़ी जागा मे जवा बाज ज्‌या<verse eid="MRK 6:32" /></para>
  <para style="s">ईसु पांच हजार माणहु ने खाणु खवाड़े</para>
  <para style="r">(<ref loc="MAT 14:13-21">मत्‌ती 14:13-21</ref>; <ref loc="LUK 9:10-17">लुका 9:10-17</ref>; <ref loc="JHN 6:1-14">युहन्‌ना 6:1-14</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />पण तीमने जत्‌ला देखीन माणहु ओळखी लेदा अने आखा गाम ना माणहु एखठा हय्‌न तां चालीन दव्‌ड़ी पड़्‌या अने ईसु अने चेला ने पुगवा सी पेले पुग ज्‌या। <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" /><note caller="+" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="MAT 9:36">मत्‌ती 9:36</ref></char></note>ईसु ढुंड्‌या मे गेथो उतर्‌यो ता घणा ढेरका माणहु ने देख्‌यो, जे गुवाळ्‌या वगर खोवायला गाडरान तेवा हता,<note caller="+" style="x"><char style="xo" closed="false">6:34 </char><char style="xt" closed="false"><ref loc="NUM 27:17">गीनती 27:17</ref>; <ref loc="1KI 22:17">1 राजा 22:17</ref>; <ref loc="2CH 18:16">2 ईतीहास 18:16</ref>; <ref loc="EZK 34:5">यहेजकेल 34:5</ref>; <ref loc="MAT 9:36">मत्‌ती 9:36</ref></char></note> करीन ईसु ने तीमनी पोर घणी गीण आवी, अने तीहयो घण ढेरकी वात तीमने ह़ीकाड़्‌यो। <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />अने मांजणीक दाड़े ईसु ना चेला ईसुन्‌तां आवीन केदा, “आहयो जागो उजाड़ से, अने दाहड़ु ढळ जेलु से। <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />एतरे माणहु ने वळाय दे, जीनी सी हीय्‌या आड़े-धेड़े ना गाम अने वस्‌ती मे जीन खावा जुगु कंय वेचातु ली लेय तेम।”<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />पण ईसु तीमने केदो, “तमुत ईमने खावा आपो।” तीहया तीने पुछ्‌या, “ईमने आखा ने खवाड़वा करीन बे ह़ोव दाड़ान दाड़की<note caller="+" style="f"><char style="fr" closed="false">6:37 </char><char style="ft" closed="false">एक चांदी नो सीक्‌को बराबर एक दाड़ा नी दाड़की</char></note> ना पय्‌हा खरचो करीन रोट्‌ला वेचाता लावया ह़ु? ईसम तु की र्‌यो ह़ु?”<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />ईसु तीमने केदो, “तमारी पांह केतरा रोट्‌ला से? आञे भेळा हयला माणहुम जाय्‌न देखो।” तीहया जाय्‌न देख्‌या अने केदा, “अमारी पांह पांच रोट्‌ला अने बे माछला से।”<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />ईसु चेला ने हुकम आपीन केदो “आखाम ने लील्‌ला चारा मे पंगात बहाड़ देवो।” <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />आखा माणहु ह़ोव-ह़ोव नी अने पचाह-पचाह नी पंगात बणावीन बह ज्‌या। <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />अने अळतेण ईसु तीहयो पांच रोट्‌ला अने बे माछला मांगीन हात मे लेदो, अने ह़रग भणी उपर भाळीन भगवान ने केदो, तु घणो वारु से, अने रोट्‌ला अने माछला ढेरका हयता ज्‌या, अने ईसु रोट्‌ला भांगीन चेला ने आप्‌यो, अने तीहया चेला माणहु ने वाटता ज्‌या, अने माछला बी पंगात मे वाटता ज्‌या। <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />अने आखान-आखा खायलीन आफरी ज्‌या। <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />तीहया बचला रोट्‌ला ना कटका अने माछला ना डळा चुटीन भेळा कर्‌या ता बारे चार्‌या भराय ज्‌या। <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />रोट्‌ला खाण्‌या मे गेथा बयरा-सोरा ने सोड़ीन अदमड़ा-अदमड़ात पांच हजार हता।<verse eid="MRK 6:44" /></para>
  <para style="s">ईसु दर्‌या पोर चाले</para>
  <para style="r">(<ref loc="MAT 14:22-23">मत्‌ती 14:22-23</ref>; <ref loc="JHN 6:16-21">युहन्‌ना 6:16-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />अने ईसु माणहु ने वळावे तां लग तीना चेला दर्‌यान ह़ेली पार बेतसेदा ह़ेर जत रेवा जोवे, करीन ईसु आह़फा ना चेला ने तावणी करीन ढुंड्‌या मे बहाड़्‌यो। <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />अने आखा माणहु ने वळाय दीन ईसु बड़ी पोर भगवान पांह वीन्‌ती करवा ज्‌यो। <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />अने दाहड़ु बुड्‌ये ह़ांती टेमे ढुंड्‌यु दर्‌यान वच मे हतु अने ईसु बड़ी पोर एखलो हतो। <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />अने ईसु, तां रीन चेलाम ने देख्‌यो के तीहया ढुंड्‌या ने चलाड़ी-चलाड़ीन घबराय र्‌या, काहाके वाहळु तीमनी ह़ाम्‌बु आव्‌वा बाज र्‌यु हतु। एतरे ईसु कुकड़ा वाहरेक दर्‌या पोर चालतो जीन तीमनी भणी आयो, अने तीमनी ह़ाते माय्‌न अगो जवा हींड्‌तो हतो। <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />पण तीहया तीने दर्‌या पोर चालत्‌लो देखीन आसम ह़मज्‌या के आमने भुत देखावा पड़्‌यो, अने तीहया घबराय्‌न आड़ी पड़्‌या। <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />आखान-आखा तीने देखीन बीहीन घबराय ज्‌या। तत्‌यारुत ईसु तीमने केदो, “मे से हीम्‌मत राखो, बीहो ना।”<verse eid="MRK 6:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 6:51" />अने तीहयो तीमनी ह़ाते ढुंड्‌या मे चड़ ज्‌यो, अने वाहळी धीरी पड़ जी, अने तीहया घण-जबर वहराय ज्‌या। <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />तीहया पांच हजार माणहु ने खवाड़वा वाळी वात नी ह़मज सक्‌या काहाके तीमनु मन वातड़ु हतु।<verse eid="MRK 6:52" /></para>
  <para style="s">गन्‌नेसरत मे ईसु मांदला ने वारु करे</para>
  <para style="r">(<ref loc="MAT 14:34-36">मत्‌ती 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />ईसु अने तीना चेला दर्‌या सेकीन गन्‌नेसरत ह़ेर मे पुग्‌या अने दर्‌या नी धेड़े ढुंड्‌यु बांद देदा। <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />अने जेमेत तीहया ढुंड्‌या मे गेथा उतर्‌या ता माणहु ईसु ने ओळखी लेदा। <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />तीहया आखी मुलक मे गेथा दवड़ी-दवड़ीन मांदला ने झोळना मे घालीन उचलीन ली आया, अने जा बी ईसु से, मालम पड़्‌यु तां ह़ारीक तीमने उचलीन ली ज्‌या। <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />अने कंखर बी ईसु गाम मे, ह़ेर मे, नीता वस्‌ती मे जतो हतो, ता तां ह़ारीक माणहु मांदला ने हाट मे वाट धेड़े मेलीन ईसु पांह आहयी वीन्‌ती करता हता के, “मांदला ने तारा लुगड़ा नी कोर एतरीत छीमवा दे” अने जेतरा बी तीना डगला नी कोर छीमता हता, तीहया आखा आरगा हय जता हता।<verse eid="MRK 6:56" /></para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">डाहा-डाहा नी ह़ीकापण</para>
  <para style="r">(<ref loc="MAT 15:1-9">मत्‌ती 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />ता फरीसी दलवाळा अने थोड़ाक युहदी-धरम ह़ीकाड़न्‌या यरुसलेम गेथा आवीन ईसु नी च्‌यारो-मेर भेळा हया। <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />तीहया ईसु ना थोड़ाक चेला ने फरीसी दलवाळा नी ह़ीकापण नी अनसारे हात धोया वगर रोट्‌ला खात्‌ला देख लेदा।<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />काहाके फरीसी एतरा नी पण आखा युहदी, डाय-डायान रीतीन तेम चालत्‌ला, अने हात धोव्‌वान रीती करीनेत खाणु खात्‌ला। <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />अने हाट गेथा आवीन बी पाण्‌ये करीन आह़फा ने चोखो करवा नी रीती कर्‌या वगर नी खात्‌ला। अने एवी घण ढेरकी रीती से तीहयी तीमनी वाटु करता रेवा जोवे करीनेत तीमना आड़ा-बुड़ान लारे पुगाड़ली हती जेम गीलास ने, कळह्‌या ने, वटळ्‌या ने अने ताम्‌बा ना, काच ना अने पीतळ ना ठाहरा धोवीन चोखु करवा, एमेत बीजी रीती बी।<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />एतरे फरीसी दलवाळा अने युहदी-धरम ह़ीकाड़न्‌या ईसु ने पुछ्‌या “तारा चेला डाय-डायान रीती पोर काहा नी चालता, अने हात धोया वगर रोट्‌ला काहा खाय?”<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />ईसु तीमने केदो, “भगवान वगे गेथी वात केण्‌यो माणेह यसाया, तमारी ह़रका ढोंगड़ा करन्‌या ना बारा मे भगवान वगे गेथी वात केदलो हतो, जेम लीखलु से; आहया माणहु मोडा सी ते मारी ईज्‌जत करे, पण ईमनु मन मार गेथु घणु सेटु रेय। <verse eid="MRK 7:6" /><verse number="7" style="v" sid="MRK 7:7" />आहया आह़फाम ना कायदा ने भगवान नो कायदा से करीन ह़ीकाड़े; एतरे तीमनी लारे मारी भक्‌ती करवा अमथु से।<note caller="+" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="ISA 29:13">यसाया 29:13</ref></char></note><verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />“तमु ते भगवान नो हुकम टाळीन, माणहु नी रीती ने मान्‌ता आय र्‌या।”<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />अने ईसु तीमने केदो, “तमु ते तमारी रीती ने मान्‌ता रेवा करीन, भगवान नो हुकम टाळवा मे घणा कदर्‌या से। <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />काहाके मुसो हुकम आपलो हतो, के ‘आह़फा ना आय्‌ह़-बाहा नी ईज्‌जत करजे; अने जे कोय आय्‌ह़-बाहा ने खोटलो बोल केय तीने मार देवा जोवे।’<note caller="+" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="EXO 20:12">नीरगमन 20:12</ref>; <ref loc="EXO 21:17">21:17</ref>; <ref loc="LEV 20:9">लेव्‌यवेवस्‌था 20:9</ref>; <ref loc="DEU 5:16">वेवस्‌थावीवरन 5:16</ref></char></note> <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />पण तमु केय के कदीम कोय माणेह आह़फा ना आय्‌ह़-बाहा ने केय जे चीज वेर तमने फायदो हयतो हतो, तीहयु भगवान ने आप देदलो से।” <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />एम करीन तमु तीने तीमना आय्‌ह़-बाहा नी चाकरी नी करवा देत्‌ला। <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />एमेत तमु तमारा कायदा ने बणावीन, भगवान नो बोल टाळ देवो, अने एवात घणा काम करत्‌ला।<verse eid="MRK 7:13" /></para>
  <para style="s">माणहु ने वीटाळ्‌नाय वात</para>
  <para style="r">(<ref loc="MAT 15:10-20">मत्‌ती 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />अने ईसु माणहु ने ह़ाते बोलावीन तीमने केदो, तमु आखा मारी ह़मळो अने ह़मजो। <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />एवी कंय बी चीज नी हय, तीहयी माणहु मे भराय्‌न तीमने वीटाळ्‌ती हय, पण तीहयी गलत वात माणहु मे गेथी नीकळे, तीहयीत वात तीमने वीटाळ देय। <verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />जीना कान्‌टा हय तीहयो ह़मळी लेय<note caller="+" style="f"><char style="fr" closed="false">7:16 </char><char style="ft" closed="false">आहयो बोल पुराणा कायदा मे नी हतो</char></note><verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />अळतेण ईसु गड़दी मे गेथो घोर ज्‌यो, तां तीना चेला तीहया दाखला ना बारा मे पुछ्‌या। <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />ईसु तीमने केदो, “तमु बी वण-अकल्‌या से ह़ु? तमने आहयी वात नी ह़मज्‌या ह़ु? के, जे चीज बारथी गेथी माणहुन मोय जाय, तीहयी तीने नी वीटाळे।” <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />काहाके तीहयु खावा नु चीज तीना मन मे नी, पण पेट मे जाय, अने हागे ता, तीहयी चीज पेट मे गेथी नीकळी जाय। ईसम कीन ईसु आहयी वात उजन्‌ती कर्‌यो, के आखी खावा नी चीज चोखलीत से।<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />ईसु अगो केतो ज्‌यो, “जे माणहु मे गेथु नीकळे, तीहयु तीने वीटाळ देय। <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />काहाके माणहु ना मन मे गेथात गळत वीच्‌यार; छीनाळु नीती, चोरी, हत्‌या, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />छीनाळु, हाय करवा, कुहराय करवा, बीजा ने ठगवा, बीजा नु नामबद्‌दी करवा, आहयी वात बारी आवे। <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />आहयी आखी गलत वात माणहु ना मन मे गेथीत नीकळे अने माणहु ने वीटाळ देय।”<verse eid="MRK 7:23" /></para>
  <para style="s">वण-भरह्‌याण बयर नो भरहो</para>
  <para style="r">(<ref loc="MAT 15:21-28">मत्‌ती 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />अळतेण ईसु गन्‌नेसरत ह़ेर मे गेथो सुर अने सेदा देस ज्‌यो; अने तां एक घोर मे ज्‌यो, अने मने कोय नी जाणवा जोवे, ईसम चाहतो हतो, पण तीहयो ह़ताय नी सक्‌यो। <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />अने तत्‌यारुत तां ह़रकी एक बयर, ईसु आय र्‌यो करीन ह़मळीन आयी, तीनी सोरी ने वीटळ्‌ळो भुत लागलो हतो, अने तीहयी ईसु ना पोगु पोर पड़ी। <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />आहयी बयर युनानी बोली बोलण्‌यान हती अने तीहयी सीरीया देस ना फीनीकी जीला मे पयदा हयली हती। अने तीहयी रावण्‌या करीन ईसु पांह आहयी वीन्‌ती करी “भुत ने मारी सोरी मे गेथो नीकाळ दे।” <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />पण ईसु दाखलान लारे तीने केदो, “पेले सोरा ने खाय्‌न आफरवा दे, काहाके सोरा नु खाणु कुतरा अगळ नाखवा वारु नी हय।”<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />तीहयी बयर बी तीने दाखला मे एक कड़ी जोड़ीन जपाप आपी, “ह़ाचली वात से मालीक, पण ते बी कुतरा सोरा ना एठला रोट्‌ला ना टुकड़ा ने खाय लेय।”<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />अने ईसु तीने केदो, “तु आहयी वात केदी एतरे आराम सी जा, भुत तारी सोरी मे गेथो नीकळी जेलो से।”<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />अने तीहयी तां गेथी आह़फी ना घोर आवीन देखी ता तीने मालम पड़्‌यु के भुत तीनी सोरी मे गेथो नीकळी जेलो हयलो, अने तीनी सोरी वारु हय्‌न खाटला पोर ह़ुय रेली।<verse eid="MRK 7:30" /></para>
  <para style="s">एक बेरा गुंगा माणेह ने ईसु आरगो करे</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />अळतेण ईसु सुर अने सेदा मुलक मे गेथो दीकापुलीस जीला मे हय्‌न गलील दर्‌यान तां पुग्‌या। <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />अने माणहु एक बेरा ने जे बोबड़ो बी हतो, ईसुन्‌तां लावीन ईसु पांह वीन्‌ती कर्‌या के तारो हात आहया माणेह पोर मेकीन वारु कर। <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />तत्‌यार ईसु गड़दी मे गेथो अगळ ली ज्‌यो, अने आह़फा नी आंगळी बेरा ना कान्‌टा मे घाल्‌यो, अने आह़फा ना आंगळ्‌या पोर थुपीन तीहया आंगळ्‌ये करीन जीप ने छीम्‌यो, <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />अने ह़रग भणी भाळीन ह़ाह़ लीन केदो, “ईफ्‌फत्‌तह” मतलब “उगड़ी जा।”<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />अने तीना कान्‌टा उगड़ी ज्‌या, अने तीनी जीप नी गाठ बी छुटी जी, अने तीहयो चोखोझण बोलवा बाज ज्‌यो। <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />तत्‌यार ईसु माणहु ने हुकम आपीन केदो, आहयी वात कोयने नी केजो, जेतरो तीमने जोर दीन हुकम आप्‌यो तेत्‌रा जादा, तीहया बमदीन आहयी वात नु परच्‌यार करवा बाज ज्‌या। <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />अने तीहया घणा जबर वहराय्‌न वळ-वळीन केवा बाज ज्‌या “तीहयो जे बी कर्‌यो आखु वारलु कर्‌यो; तीहयो बेरा ने ह़मळवा नी, अने गुंगा ने बोलवा नी सक्‌ती आपे।”<verse eid="MRK 7:37" /></para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">ईसु च्‌यार हजार माणहु ने खवाड़वा</para>
  <para style="r">(<ref loc="MAT 15:32-39">मत्‌ती 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />तीहया दाड़ा मे अळी एक माणहु नो मोट्‌लो मेळो ईसुन्‌तां भेळो हयो। अने तीहया माणहु पांह खावा वाटु कंय नी हतु। तां ईसु आह़फा ना चेला ने ह़ाते बोलावीन केदो, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />“मने आहया माणहु ना मेळा पोर दया आवे, काहाके आहया तीन दाड़ा गेथा मारी ह़ाते री र्‌या, अने खावा वाटु ईमनी पांह कंय बी नी हय। <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />ईमनी मे गेथा काना घणा नाम्‌बे गेथा आवला से। कदी ईमने मे भुकला घोर मोकलही, ता आहया थाक जहे, अने वाट्‌येत झामा खाय्‌न पड़ जहे।” <verse eid="MRK 8:3" /><verse number="4" style="v" sid="MRK 8:4" />तीना चेला जपाप आप्‌या, “आञे उजाड़ी बड़ा मे आहया माणहु ने आफरीन खवाड़वा करीन एतरा ढेरका रोट्‌ला कां गेथा लावया?”<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />ईसु चेला ने पुछ्‌यो “तमारी पांह केतरा रोट्‌ला से?” तीहया केदा, “ह़ात रोट्‌ला।”<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />तत्‌यार ईसु माणहु ने भोयमे बह जावो करीन हुकम आप्‌यो, अने तीहयो ह़ात रोट्‌ला हात मे लीन रोट्‌ला वाटु भगवान ने तु घणो वारु से, केदो अने रोट्‌ला ढेरका हय ज्‌या। अने तीहयो माणहु ने वाट देवो करीन रोट्‌ला भांगीन आह़फा ना चेला ने आप्‌तो ज्‌यो, अने चेला माणहु ने वाट्‌ता ज्‌या। <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />तीमनी पांह थोड़ाक झीन्‌ला माछला बी हता; माछला वाटु बी ईसु भगवान ने तु घणो वारु से केदो। अने माछला बी ढेरका हयता ज्‌या। अने आहया माछला बी माणहु ने वाट देवो करीन तीहयो आह़फा ना चेला ने हुकम आपीन केदो। <verse eid="MRK 8:7" /><verse number="8" style="v" sid="MRK 8:8" />ता आखा माणहु खायलीन आफरी ज्‌या, अने चेला बचला रोट्‌ला ना कटका भेळा कर्‌या, ता ह़ात चार्‌या भराय ज्‌या। <verse eid="MRK 8:8" /><verse number="9" style="v" sid="MRK 8:9" />अदमड़ा-अदमड़ा तां ह़ारीक च्‌यारेक हजार हता, अने अळतेण ईसु माणहुम ने वळाय देदो। <verse eid="MRK 8:9" /><verse number="10" style="v" sid="MRK 8:10" />अने तीहयो सोटो आह़फा ना चेला ह़ाते ढुंड्‌या मे बहीन दलमनुता मुलक मे जत र्‌यो।<verse eid="MRK 8:10" /></para>
  <para style="s">ह़रग मे वाळी सेलाणी नी मांग</para>
  <para style="r">(<ref loc="MAT 12:38-42">मत्‌ती 12:38-42</ref>; <ref loc="MAT 16:1-4">16:1-4</ref>; <ref loc="LUK 11:16-29">लुका 11:16-29</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:11 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 12:38">मत्‌ती 12:38</ref>; <ref loc="LUK 11:16">लुका 11:16</ref></char>
    </note>अळतेण फरीसी दलवाळा ईसु ह़ाते वात मे जखड़ी पड़वा बाज ज्‌या, अने तीने पारखवा करीन तीनी पांह ईसम वीन्‌ती कर्‌या “ए ईसु आमने एक एवी जुदा काम नी सेलाणी देखाड़।”<note caller="+" style="x"><char style="xo" closed="false">8:11 </char><char style="xt" closed="false"><ref loc="MAT 12:38">मत्‌ती 12:38</ref>; <ref loc="LUK 11:16">लुका 11:16</ref></char></note> <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" /><note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">मत्‌ती 12:39</ref>; <ref loc="LUK 11:29">लुका 11:29</ref></char></note>ईसु तीमना ढोंगड़ा देखीन आह़फा ना जीव मे डहकाय्‌न केदो, “तमारी ह़रका आहयी पीड़ी ना माणहु हमणे बी जुदा-काम नी सेलाणी काहा ह़ोद र्‌या? मे तमने ह़ाचली केम, तमारी ह़रका आहयी पीड़ी ना माणहु ने कंय बी सेलाणी नी जड़े।”<note caller="+" style="x"><char style="xo" closed="false">8:12 </char><char style="xt" closed="false"><ref loc="MAT 12:39">मत्‌ती 12:39</ref>; <ref loc="LUK 11:29">लुका 11:29</ref></char></note><verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />अने ईसु फरीसी दलवाळा ने सोड़ीन अळी पासो ढुंड्‌या मे बह ज्‌यो, अने ह़ेली धेड़े जवा बाज ज्‌यो।<verse eid="MRK 8:13" /></para>
  <para style="s">फरीसी दलवाळा अने हेरोद राजा नु खमीर</para>
  <para style="r">(<ref loc="MAT 16:5-12">मत्‌ती 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />ईसु अने तीना चेला ढुंड्‌या मे जवा बाज रेला अने तीहया चेला रोट्‌ला लाव्‌वा भुली जेला हता, अने ढुंड्‌या मे तीमनी पांह एकीत रोट्‌लो हतो। <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" /><note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">लुका 12:1</ref></char></note>अने ईसु आह़फा ना चेला ने दाखलान लारे आहयु कीन चेतायो, “फरीसी माणहु ना खमीर अने राजा हेरोद ना खमीर गेथा चेतीन रेवो।”<note caller="+" style="x"><char style="xo" closed="false">8:15 </char><char style="xt" closed="false"><ref loc="LUK 12:1">लुका 12:1</ref></char></note><verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />एतरे चेला आंबा-सांबा वीच्‌यारीन केदा, “आपणु रोट्‌ला नी लाया, करीन ईसु ईसम की र्‌यो।”<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />अने ईसु तीमनी आहयी वात जाणीन तीमने केदो, “तमु आंबा-सांबा अमारी पांह रोट्‌ला नी हय करीन काहा वीच्‌यार करवा बाज र्‌या? हजु बी तमु वण-अकल्‌या से ह़ु? तमने हजु बी आहयी वात नी ह़मजाती ह़ु? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" /><note caller="+" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="MRK 4:12">मरकुस 4:12</ref></char></note>तमारा डोळा से, ते बी देखायतु नी ह़ु? अने कान्‌टा हय्‌न बी ह़मळायतु नी ह़ु?<note caller="+" style="x"><char style="xo" closed="false">8:18 </char><char style="xt" closed="false"><ref loc="JER 5:21">यीरम्‌या 5:21</ref>; <ref loc="EZK 12:2">यहेजकेल 12:2</ref>; <ref loc="MRK 4:12">मरकुस 4:12</ref></char></note> अने तमने आहयी वीतली वात फोम नी हय ह़ु? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />जत्‌यार मे पांच हजार माणहु वाटु पांच रोट्‌ला भांगीन आप्‌लो, ता तमु रोट्‌ला ना टुकड़ा चुटीन केतरा टोपल्‌या भरला?” तीहया केदा, “बारे टोपल्‌या।”<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />जत्‌यार च्‌यार हजार माणहु जुगु ह़ात रोट्‌ला भांगीन आप्‌लो, ता तमु भांगला रोट्‌ला ना टुकड़ा केतरा चार्‌या भरला? तीहया ईसु ने केदा, “ह़ात चार्‌या।”<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />अळतेण ईसु तीमने केदो, “जीवाय नु मतलब तमु हजु तक नी ह़मज्‌या ह़ु?”<verse eid="MRK 8:21" /></para>
  <para style="s">ईसु बेतसेदा मे आंदळु माणेह ने वारु कर्‌यो</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />अने अळतेण ईसु अने तीना चेला बेतसेदा गाम मे पुग्‌या; अने माणहु एक आंदळु ने ईसुन्‌तां लाया, अने ईसु सी वीन्‌ती कर्‌या के “आंदळु ने सीमीन वारु कर दे।” <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />अने ईसु आंदळु नो हात धरीन तीने फळ्‌या मे गेथो बारो ली ज्‌यो, अने तीना डोळा मे थुप्‌यो अने आह़फा ना हात तीना डोळा पोर मेक्‌यो, अने तीने पुछ्‌यो, “तने देखाय ह़ु?”<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />तीहयो उपर भाळीन केदो, “माणहु ने देख र्‌यो पण तीहया मने आसम देखाय जीसम झाटवा चालवा बाज र्‌या हय।”<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />तत्‌यार ईसु अळी तीना डोळा पोर हात मेक्‌यो, अने तीहयो आंदळो आह़फा ना डोळा उगाड़ीन देखवा बाज ज्‌यो। तीहयो पासो आखु आसुझण देखवा बाज ज्‌यो। <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />“अने आहया ह़ेर ना फळ्‌या मे पासो ना जाय, आसम कीन ईसु तीने तीना घोर मोकल्‌यो।”<verse eid="MRK 8:26" /></para>
  <para style="s">भगवान नी लारे टाळलो मसी</para>
  <para style="r">(<ref loc="MAT 16:13-20">मत्‌ती 16:13-20</ref>; <ref loc="LUK 9:18-21">लुका 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />ईसु अने तीना चेला केसर्‌या फीलीपुस ह़ेर धेड़्‌ये वाळा फळ्‌या-फळ्‌या मे हय्‌न जवा बाज रेला; अने वाट्‌ये ईसु चेला ने पुछ्‌यो, “माणहु मारा बारा मे ह़ु की र्‌या?”<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:28 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 6:14">मरकुस 6:14</ref>,<ref loc="MRK 6:15">15</ref>; <ref loc="LUK 9:7">लुका 9:7</ref>,<ref loc="LUK 9:8">8</ref></char>
    </note>तीहया केदा, “काना केय, आहयो ते बपतीस्‌मा आपण्‌यो युहन्‌नो से” पण काना भगवान वगे गेथी वात केण्‌यो एलीया से केय, अने काना भगवान ना वात केण्‌या माणहु मे गेथो कानो बीजो से केय।<note caller="+" style="x"><char style="xo" closed="false">8:28 </char><char style="xt" closed="false"><ref loc="MRK 16:14">मरकुस 16:14</ref>,<ref loc="MRK 16:15">15</ref>; <ref loc="LUK 9:7">लुका 9:7</ref>,<ref loc="LUK 9:8">8</ref></char></note><verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:29 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 6:68">युहन्‌ना 6:68</ref>,<ref loc="JHN 6:69">69</ref></char>
    </note>ईसु तीमने पुछ्‌यो, “पण तमु मने ह़ु केवो?” पतरस केदो, “ह़ाचलीन तु भगवान नो मोकल्‌लो बचाड़न्‌यो मसी से।”<note caller="+" style="x"><char style="xo" closed="false">8:29 </char><char style="xt" closed="false"><ref loc="JHN 6:68">युहन्‌ना 6:68</ref>,<ref loc="JHN 6:69">69</ref></char></note><verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />तत्‌यार तीहयो तीमने आहयु कीन चेतायो, “मारा बारा मे आहयी वात कोयने नी केजो।”<verse eid="MRK 8:30" /></para>
  <para style="s">मोत अने ईसु पासो जीवतो हयवा ना बारा मे केय</para>
  <para style="r">(<ref loc="MAT 16:21-28">मत्‌ती 16:21-28</ref>; <ref loc="LUK 9:22-27">लुका 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />अने तीहयो चेला ने ह़ीकाड़्‌यो, “मे मनख्‌यान सोरो से, मार वाटु नक्‌खी से, के तीहयो घणो जबर वेला करहे, अने पुडार्‌या अने मंदीर ना डायला पुंजारा अने युहदी-धरम ह़ीकाड़न्‌या तीने हेटो ह़मजीन नीकारो करीन मार नाखहे, पण तीने तीन दाड़ा मे पासो जीवतो हय्‌न बठो हयवु से।” <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />तीहयो आहयी वात चोखीझण आह़फा ना चेला ने उजन्‌ती की देदो। आहयु ह़मळीन पतरस ईसु ने सेटो ली जाय्‌न वडवा बाज ज्‌यो। <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />पण ईसु पासो वळीन बीजा चेला भणी भाळ्‌यो अने तीमनी अगळ पतरस ने वडीन केदो, “ए भुतड़ा मारीन्‌तां गेथो सेटो जत रे; तु ते भगवान नी वात पोर नी, पण माणहु नी वात पोर मन लगाड़ीन केवा बाज र्‌यो।”<verse eid="MRK 8:33" /></para>
  <para style="s">ईसु पसळ चालवा नु मतलब</para>
  <para style="r">(<ref loc="MAT 16:24-28">मत्‌ती 16:24-28</ref>; <ref loc="LUK 9:23-27">लुका 9:23-27</ref>)</para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">8:34 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:38">मत्‌ती 10:38</ref>; <ref loc="LUK 14:27">लुका 14:27</ref></char>
    </note>अने तीहयो माणहु ना मेळा अने चेला ने ह़ाते बोलावीन केदो, “जे कोय मारो चेलो बणीन मारी ह़ाते आव्‌वा हीन्‌डे” तीहयो आह़फा नी मरजी नी पण मारी मरजी पुरी करतो जाय्‌न आह़फा नु कुरुस उचलीन मारी ह़ाते आव्‌वा जोवे।<note caller="+" style="x"><char style="xo" closed="false">8:34 </char><char style="xt" closed="false"><ref loc="MAT 10:38">मत्‌ती 10:38</ref>; <ref loc="LUK 14:27">लुका 14:27</ref></char></note> <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" /><note caller="+" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्‌ती 10:39</ref>; <ref loc="LUK 17:33">लुका 17:33</ref>; <ref loc="JHN 12:25">युहन्‌ना 12:25</ref></char></note>काहाके जे कोय आह़फा ना जीव ने बचाड़वा हीन्‌डे, तीहयो आह़फा ना जीव ने खोवहे; पण जे कोय मारी वाटु अने मारी खुस-खबर वाटु आह़फा ना जीव ने खोवहे, तीहयो आह़फा ना जीव ने बचाड़हे।<note caller="+" style="x"><char style="xo" closed="false">8:35 </char><char style="xt" closed="false"><ref loc="MAT 10:39">मत्‌ती 10:39</ref>; <ref loc="LUK 17:33">लुका 17:33</ref>; <ref loc="JHN 12:25">युहन्‌ना 12:25</ref></char></note> <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />कदी माणहु आखी कळजुग ने हात कर लेय, अने ते बी आह़फा नो जीव खोय देय, ता तीने ह़ु फायदो से? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />अने तीहयो आह़फा नो जीव पासो लाव्‌वा करीन आह़फा ना जीव नी अवजी पोर ह़ु आपहे? <verse eid="MRK 8:37" /><verse number="38" style="v" sid="MRK 8:38" />एक दाड़े मे जे मनख्‌या नो सोरो से, ह़रग वाळा चोखला ह़रगदुत ह़ाते अने मारा बाह नी बड़ाय भेळो आवही। तीहयी टेमे मे तीहया माणेह सी हुकारीन मानवा मे लजवाहे, जे आहयी पीड़ीन छीनाळ्‌या अने पापी माणहु नी अगळ मने अने मारी ह़ीकापण ने हुकारीन मानवा मे लजवायहे।<verse eid="MRK 8:38" /></para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />अने ईसु चेला ने अने माणहु ना मेळा ने आहयु बी केदो, “मे तमने ह़ाचलीन केम, जे आञे उबा हय र्‌या, तीमनी मे कोय ईसम से, तीहया तत्‌यार लग नी मरे, जत्‌यार लग भगवान ना राज ने सक्‌ती भेळ आवत्‌लो नी देख लेय।”<verse eid="MRK 9:1" /></para>
  <para style="s">ईसु नो सीको बदलवा</para>
  <para style="r">(<ref loc="MAT 17:1-13">मत्‌ती 17:1-13</ref>; <ref loc="LUK 9:28-36">लुका 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:2 </char>
      <char style="xt" closed="false">
        <ref loc="2PE 1:17">2 पतरस 1:17</ref>,<ref loc="2PE 1:18">18</ref></char>
    </note>छोव दाड़ा हय ज्‌या अने अळतेण ईसु पतरस अने याकुब अने युहन्‌ना ने ह़ाते लीन एक उचला बड़ा पोर ज्‌यो<note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="EXO 24:16">नीरगमन 24:16</ref>; <ref loc="1KI 19:8">1 राजा 19:8</ref>,<ref loc="1KI 19:9">9</ref></char></note>। तां तीहया एखला हता; अने तां ह़ारीक चेला नी अगळ ईसु नो सीक्‌को बदली ज्‌यो। <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />अने तीना लुगड़ा उजळा हय्‌न जोगो-जोगो पपलवा बाज ज्‌या अने एतरा जबर उजळा हय ज्‌या, के धरती पोर कानो बी धोबी एतरा जबर उजळा नी कर सके। <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />अने तीहया चेला ने एलीयो अने मुसो देखाव पड़्‌या; जे पेल्‌ना वारा मे भगवान ना वात केण्‌या हता; अने तीहया ईसु ह़ाते वात करवा बाज ज्‌या। <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />पतरस, ईसु ने केदो, “ए गुरु, आञे रेवा ते आपणी वाटु घण वारु से। आमु आञे ह़ारीक तीन तम्‌बु बणावये। एक तारी वाटु एक मुसा वाटु अने एक एलीया वाटु।” <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />पतरस नी जाणतो हतो के तीहयो ह़ु केय ईनीन करते तीहया घणा बीही ज्‌या।<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 3:17">मत्‌ती 3:17</ref>; <ref loc="MRK 1:11">मरकुस 1:11</ref>; <ref loc="LUK 3:22">लुका 3:22</ref></char>
    </note>तत्‌यार एक वादळु आवीन तीमने टोप लेदु, अने तीहया वादळा मे गेथो आहयो बोल ह़मळायो, “आहयोत मारो मोंगाळ्‌ळो सोरो से; आनी वात मानो।”<note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="MAT 3:17">मत्‌ती 3:17</ref>; <ref loc="MRK 1:11">मरकुस 1:11</ref>; <ref loc="LUK 3:22">लुका 3:22</ref>; <ref loc="2PE 1:17-18">2 पतरस 1:17-18</ref></char></note> <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />ता चेला तत्‌यारुत च्‌यारो-मेर भाळ्‌या, ता तां ह़ारीक ईसु ने सोड़ीन कोय नी देखाव पड़्‌यु।<verse eid="MRK 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 9:9" />बड़ा पोर गेथो उतरतो जीन ईसु तीहया चेला ने आहयो हुकम आप्‌यो, “जत्‌यार लग मे मनख्‌यान सोरो मरला मे गेथो जीवतो हय्‌न बठो नी हये, तत्‌यार लग जे कंय तमु देखला से, तीहयु कोयने नी केजो।”<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />अने तीहया चेला ईसु नी वात मानीन आहयी वात ने आह़फा ना मन मे राख्‌या; ते बी तीहया आंबा-सांबा वीच्‌यार कर्‌या, के “मरला मे गेथो जीवतो हय्‌न बठो हयवान मतलब ह़ु से?” <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" /><note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAT 11:14">मत्‌ती 11:14</ref></char></note>अने मरवा नी वात काटवा करीन चेला ईसु ने आहयु पुछ्‌या, “ईसम हय ता युहदी-धरम ह़ीकाड़न्‌या काहा केय के पेले एलीया नु आव्‌वा टकायलु से?”<note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="MAL 4:5-6">मलाकी 4:5-6</ref>; <ref loc="MAT 11:14">मत्‌ती 11:14</ref></char></note><verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />ईसु तीमने केदो, “होव, खरीत एमेत लीखलु से के एलीया पेले आवीन आखु कंय ह़ुदारीन तीयार करहे। पण मनख्‌या ना सोरा ना बारा मे ईसम काहा खरला सास्‌तर मे लीखलु<note caller="+" style="x"><char style="xo" closed="false">9:12 </char><char style="xt" closed="false"><ref loc="ISA 53">यसाया 53</ref>; <ref loc="PSA 118:22">भजन सहीता 118:22</ref></char></note> से? के तीने घण-जबर दुख झेलवा पड़हे, अने माणहु तीने हेटो ह़मजीन तीनु नामबद्‌दी करहे। <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />पण मे तमने केम, एलीया ते आय लागलो से, अने जत्‌यार तीहयो आयो तत्‌यार माणहु ने जेम पट्‌यु तेमेत तीनी ह़ाते वण-दयाळो वेहवार कर्‌या।<note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="LUK 9:37-43">लुका 9:37-43</ref></char></note> अने तीना बारा मे भगवान ना बोल मे एमेत लीखलु से।<note caller="+" style="x"><char style="xo" closed="false">9:13 </char><char style="xt" closed="false"><ref loc="MAT 12:7">मत्‌ती 12:7</ref>; <ref loc="HOS 6:6">होसे 6:6</ref></char></note>”<verse eid="MRK 9:13" /></para>
  <para style="s">ईसु भुत भरायलु सोरु ने वारु करे</para>
  <para style="r">(<ref loc="MAT 17:14-20">मत्‌ती 17:14-20</ref>; <ref loc="LUK 9:37-43">लुका 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />ईसु तीहया तीन चेला ने लीन बड़े गेथो बीजा चेलान्‌तां पासो ज्‌यो, ता तीहया देख्‌या के बीजा चेला ना च्‌यारो-मेर घणो मोटो मेळो, भेळो हय र्‌यो, अने युहदी-धरम ह़ीकाड़न्‌या तीमनी ह़ाते वात मे जखड़ी पड़ र्‌या। <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />अने उचकाहला ईसु ने देखीन आखा माणहु घणा जबर वहराय ज्‌या। अने तीनु आव-भाव करवा करीन दवड़ीन आया। <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />अने ईसु चेलाम ने पुछ्‌यो, “तमु ईमनी ह़ाते कानी वात मे जखड़ी पड़ र्‌या?”<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />मेळा मे गेथो एक जणो जपाप आप्‌यो, “ए मास्‌तर, मे मारा सोरा ने, तारीन्‌तां लाव्‌वा करीन लावलो, आनी मे भुत भराय र्‌यो, तीहयो बोबड़ो से। <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />अने जा आने भुत चोटी जत्‌लो, तां ह़ारीक आने आहटी देत्‌लो, अने आहया सोरा ना मोडा मे फेह्‌टु आय लागत्‌लु, अने दातु बी ककड़ावतलो, अने अकड़ाय जत्‌लो: अने जत्‌यार मे तारा चेला ने, आनी मे गेथो भुत काड देवो, करीन केदो, तत्‌यार तीमने नी कडायो।”<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />अने तीमने एम केतलो ह़मळीन ईसु तीमने केदो, “ए वण-भरहाय पीड़ी ना माणहु मे कत्‌यार लग तमारी ह़ाते रेही? अने कत्‌यार लग तमारी वेठतो रेही? हीय्‌यु सोरु ने मारीन्‌तां लावो।” <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />तीहया ते सोरु ने ईसुन्‌तां लाया; अने जत्‌यार ईसु तीमने देख्‌यो, ता तेमेत तीहयो भुत ते सोरु ने छोटोत मड़ी देदो, अने तीहयु सोरु भोयमे पड़ ज्‌यु, अने मोडा मे गेथु फेह्‌टु नीकाळ्‌तो जीन गबड़वा बाज ज्‌यो। <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />तत्‌यार ईसु तीहयु सोरु ना बाह ने पुछ्‌यो, “आहयो एवो हयलो, केतरा दाड़ा हय ज्‌या?” अने तीहयो केदो, “नान्‌लो हतो, ता गेथोत से। <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />भुत आने मारवा करीन कंखर आक्‌ठीम अने कंखर पाणी मे नाख देय: कदी तने बणे, ता अमारी पोर गीण करीन अमारु भलु कर।”<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />अने ईसु तीने केदो, “कदीम तने बणे, ता एम मने ह़ु करवा केय? भरहो करवा वाळा वाटु आखु कंय हय सके।”<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />तत्‌यारुत तीहयु सोरु नो बाह कलपतो जीन केदो, “मे भरहो ते करु, ते बी भरहो करवा करीन मारी मदत कर।”<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />माणहु दवड़ीन आवीन गड़दी करवा बाज र्‌या, ईसु आहयु देख्‌यो, ता तीहयो, तीहया वीटळ्‌ळा भुत ने वडीन केदो, “ए बेरा अने गुंगा भुत, मे तने हुकम आपु, आहयु सोरु मे गेथो नकळी जा, अने पासो आनी मे नी भरायजे।”<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />तत्‌यार भुत आड़ीन, अने तीहया सोरा ने घण-जबर मड़ीन नकळी ज्‌यो; अने तीहयु सोरु मरलान तेवु हय ज्‌यु; एतरे ढेरेत माणहु केवा बाज ज्‌या, “आहयु सोरु मर ज्‌यु।” <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />पण ईसु सोरु नो हात धरीन उठाड़्‌यो अने सोरु उबु हय ज्‌यु।<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />अळतेण ईसु घोर आयो, ता ईसु एखलो हतो, ता तीना चेला तीने पुछ्‌या, “आमने तीहयो भुत ह़ु करवा नी नीकळ्‌यो?”<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />अने तीहयो चेला ने केदो, “एवी भुत नी जात भगवान सी वीन्‌ती कर्‌या वगर नी नीकळे।”<verse eid="MRK 9:29" /></para>
  <para style="s">ईसु अळी आह़फा नी मोत ना बारा मे केय</para>
  <para style="r">(<ref loc="MAT 17:22-23">मत्‌ती 17:22-23</ref>; <ref loc="LUK 9:43-45">लुका 9:43-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />अळतेण ईसु अने चेला तां गेथो गलील जीला मे हय्‌न जवा बाज र्‌या हता। तीहयो <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />अने चेलाम ने ह़ीकाड़वा नी टेमे कोय बी अड़चन नी नाखवा जोवे करीन ईसु आह़फा ना चेला ने मनेन आहयी खास वात ह़ीकाड़तो ज्‌यो, “मे मनख्‌यान सोरो मनख्‌यान हात लाग जाय्‌न धरायवा वाळो से अने तीहया माणहु तीने मार नाखहे, पण तीन दाड़ा मे तीहयो पासो जीवतो हय जहे।”<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />पण चेला आहयी वात ने ह़मज्‌या नी, ते बी तीहया, ईसु ने आहयी वात पुसवा बीहता हता।<verse eid="MRK 9:32" /></para>
  <para style="s">ह़रग राज मे मोटु कोय से?</para>
  <para style="r">(<ref loc="MAT 18:1-5">मत्‌ती 18:1-5</ref>; <ref loc="LUK 9:46-48">लुका 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />अळतेण तीहया कफरनहुम ह़ेर मे ज्‌या। जत्‌यार ईसु घोर मे हतो, ता तीहयो तीमने पुछ्‌यो “वाट्‌ये तमु कानी वात मे जखड़ी पड़ र्‌या हता?”<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:34 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 22:24">लुका 22:24</ref>
      </char>
    </note>तीहया आखा होगात हय र्‌या हता, काहाके वाट्‌ये तीहया आहयी वात मे जखड़ी पड़ रेला के अमारी मे कोय मोटु से?<note caller="-" style="fe"><char style="fr" closed="false">9:34 </char><char style="ft" closed="false">लुका 22:24</char></note> <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" /><note caller="+" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26">मत्‌ती 20:26</ref>,<ref loc="MAT 20:27">27</ref>; <ref loc="MAT 23:11">23:11</ref>; <ref loc="MRK 10:43">मरकुस 10:43</ref>,<ref loc="MRK 10:44">44</ref>; <ref loc="LUK 22:26">लुका 22:26</ref></char></note>तत्‌यार ईसु बहीन बारे चेला ने बोलायो अने तीमने केदो, “कदीम कोय मोटु बणवा हींडे, ता तीने आखा गेथो नानो अने आखा नो पावर्‌यो बणवा पड़हे।”<note caller="+" style="x"><char style="xo" closed="false">9:35 </char><char style="xt" closed="false"><ref loc="MAT 20:26-27">मत्‌ती 20:26-27</ref>; <ref loc="MAT 23:11">23:11</ref>; <ref loc="MRK 10:43-44">मरकुस 10:43-44</ref>; <ref loc="LUK 22:26">लुका 22:26</ref></char></note> <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />अने तीहयो एक नान्‌लु सोरु ने बोलावीन तीमनी वच मे उबो कर्‌यो, अने तीने खोळा मे बहाड़ीन तीमने केदो, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" /><note caller="+" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">मत्‌ती 10:40</ref>; <ref loc="LUK 10:16">लुका 10:16</ref>; <ref loc="JHN 13:20">युहन्‌ना 13:20</ref></char></note>“जे कोय मारा नाम सी, एवा नान्‌ला सोरा माय्‌न काना एक नो बी आव-भाव करे; तीहयो मारी आव-भाव कर र्‌यो, अने जे कोय मारी आव-भाव करे, तीहयो मारी एतरो ते नी, पण मने मोकलवा वाळा नो आव-भाव कर र्‌यो।”<note caller="+" style="x"><char style="xo" closed="false">9:37 </char><char style="xt" closed="false"><ref loc="MAT 10:40">मत्‌ती 10:40</ref>; <ref loc="LUK 10:16">लुका 10:16</ref>; <ref loc="JHN 13:20">युहन्‌ना 13:20</ref></char></note><verse eid="MRK 9:37" /></para>
  <para style="s">कोय आपणी वगु से अने कोय आपणी वीरोद से</para>
  <para style="r">(<ref loc="LUK 9:49-50">लुका 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />युहन्‌नो ईसु ने केदो, “ए मास्‌तर, आमु एक माणेह ने तार नामे भुत ने काडत्‌ला देख्‌या अने तीहयो मारी ह़ाते आव्‌वा नी हींडतो हतो, एतरे ता तीने आमु केदा, ईसु ना नामे भुत ने ना काडे।”<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />पण ईसु हुकम आपीन केदो, “तीने ईसु ना नामे भुत ने ना काडे ईसम करीन ना केवो” काहाके एवु कोय नी हय जे मारा नामे जुदा-कामु करीन थोड़ीक वार मे मारो वाक काडतो हय। <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" /><note caller="+" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">मत्‌ती 12:30</ref>; <ref loc="LUK 11:23">लुका 11:23</ref></char></note>काहाके जे कोय आपणी वीरोद मे नी हय, तीहयो आपणी वगो से।<note caller="+" style="x"><char style="xo" closed="false">9:40 </char><char style="xt" closed="false"><ref loc="MAT 12:30">मत्‌ती 12:30</ref>; <ref loc="LUK 11:23">लुका 11:23</ref></char></note> <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" /><note caller="+" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">मत्‌ती 10:42</ref></char></note>तमु ईसु मसी ना चेला से करीन जे कोय तमने एक गीलास पाणी पीवाड़े ता मे ह़ाचलीन केम, तीहयो ईना काम ना बदले भगवान गेथो संयबरकत हात करहेन करहे।<note caller="+" style="x"><char style="xo" closed="false">9:41 </char><char style="xt" closed="false"><ref loc="MAT 10:42">मत्‌ती 10:42</ref></char></note><verse eid="MRK 9:41" /></para>
  <para style="s">बीजा ने पाप मे पाड़वान पारख</para>
  <para style="r">(<ref loc="MAT 18:6-9">मत्‌ती 18:6-9</ref>; <ref loc="LUK 17:1-2">लुका 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />पण जे कोय मारी पोर भरहो करन्‌या आहया नान्‌ला माय्‌न काना वाटु पाप करावे, तीनी वाटु आहयुत वारु से के तीना गळा मे घट्‌टी नो पोड़ बांदीन तीने दर्‌या मे नाख देवा जोवे। <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" /><note caller="+" style="x"><char style="xo" closed="false">9:43 </char><char style="xt" closed="false"><ref loc="MAT 5:30">मत्‌ती 5:30</ref></char></note>कदी तारो हात तने ठोकर खवाड़े, ता तीने वाडीन नाख देवो! काहाके बेम हात भेळ ओलाये नी एवी नरक नी आक्‌ठी मे जवा गेथो, हातटुटो हय्‌न अमरकाय जीवाय हात करीन ह़रग मे जवा वारु से।<note caller="+" style="x"><char style="xo" closed="false">9:43 </char><char style="xt" closed="false"><ref loc="MAT 5:30">मत्‌ती 5:30</ref></char></note> <verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />काहाके नरक-आक्‌ठी मे वाळो कीड़ो कदी नी मरे, अने तां वाळु आक्‌ठु कदी नी ओलाये।<note caller="+" style="f"><char style="fr" closed="false">9:44 </char><char style="ft" closed="false">आहयो बोल पुराना कायदा मे नी हय</char></note> <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />कदी तारो पोग पाप नो जपाप बणीन तने पाप करावे ता, तीहया पोग ने तोड़ीन नाख देवा जोवे। <verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />काहाके बे पोगु भेळो नरक मे नखायवा गेथो, लंगड़ो हय्‌न अमरकाय जीवाय हात करीन ह़रग मे जवा वारु से। काहाके नरक-आक्‌ठी मे वाळो कीड़ो कदी नी मरे, अने तां वाळु आक्‌ठु कदी नी ओलाये। <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" /><note caller="+" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:29">मत्‌ती 5:29</ref></char></note>अने कदीम तारो डोळो पाप नो जपाप बणीन तने पाप करावे, ता तीहया डोळा ने नीकाळीन नाख दे, काहाके बे डोळा भेळे नरक-आक्‌ठी मे नखायवा गेथो, बाडो बणीन भगवान ना राज मे जवा वारु से।<note caller="+" style="x"><char style="xo" closed="false">9:47 </char><char style="xt" closed="false"><ref loc="MAT 5:19">मत्‌ती 5:19</ref></char></note> <verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />काहाके “नरक-आक्‌ठी मे वाळो कीड़ो कदी नी मरे अने तां वाळु आक्‌ठु कदी नी ओलाये।”<note caller="+" style="x"><char style="xo" closed="false">9:48 </char><char style="xt" closed="false"><ref loc="ISA 66:24">यसाया 66:24</ref></char></note><verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />काहाके आखा ने आक्‌ठे करीन खारला बणावहे।<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:50 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:13">मत्‌ती 5:13</ref>; <ref loc="LUK 14:34">लुका 14:34</ref>,<ref loc="LUK 14:35">35</ref></char>
    </note>खारलु मीठु ते वारलु चीज से, बाखीन कदी मे खारलु मीठु मोळ्‌ळु हय जाय अने खारुपण ने खोय देय, ता तीहयु पासु केम करीन खारु हयहे? एतरे तमु आंबा-सांबा हेळी-मेळीन रीन आह़फा नु खारलु मीठु नो ह़वाद ह़माळीन राखो।<note caller="+" style="x"><char style="xo" closed="false">9:50 </char><char style="xt" closed="false"><ref loc="MAT 5:13">मत्‌ती 5:13</ref>; <ref loc="LUK 14:34">लुका 14:34</ref>,<ref loc="LUK 14:35">35</ref></char></note><verse eid="MRK 9:50" /></para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">लाडी सोड़वा ना बारा मे ईसु नी ह़ीकापण</para>
  <para style="r">(<ref loc="MAT 19:1-12">मत्‌ती 19:1-12</ref>; <ref loc="LUK 16:18">लुका 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />अळतेण ईसु कफरनहुम ह़ेर गेथो नीकळीन युहद्‌या देस माय्‌न यरदन नंदी ना ह़ेली धेड़े ज्‌यो, अने अळी मेळो तीनीन्‌तां भेळो हय ज्‌यो, अने तीहयो आह़फा नी रीती ना अनसारे तीमने ह़ीकाड़वा बाज ज्‌यो।<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />तत्‌यार फरीसी दलवाळा तीनीन्‌तां आवीन पारखवा करीन पुछ्‌या, “अदमी वाटु आह़फा नी बयर ने सोड़वा वारु से ह़ु?”<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />तीहयो तीमने जपाप आप्‌यो, “भगवान वगे गेथो वात केण्‌यो मुसो तमने ह़ु हुकम आपलो से?”<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:4 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:31">मत्‌ती 5:31</ref>
      </char>
    </note>फरीसी दलवाळा केदा, “मुसो ते झगड़ो भांगवान चीट्‌ठी लीखीन लाडी ने सोड़वा नो हुकम आपलो से।”<note caller="+" style="x"><char style="xo" closed="false">10:4 </char><char style="xt" closed="false"><ref loc="DEU 24:1-4">वेवस्‌थावीवरन 24:1-4</ref>; <ref loc="MAT 5:31">मत्‌ती 5:31</ref></char></note><verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />ईसु तीमने केदो, “तमारा आड़ा-बुड़ान मन नी ठटाय जाणीन मुसा आहयो हुकम लीखीन आप्‌यो। तमारु मन बी तीमनीन तेम ठटायलु से। <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />पण भगवान कळ घड़्‌यो तां गेथोत तीमने एक बयर अने एक अदमी करीन बणायो।<note caller="+" style="x"><char style="xo" closed="false">10:6 </char><char style="xt" closed="false"><ref loc="GEN 24:1-4">उबजणाय कीताप 24:1-4</ref>; <ref loc="MAT 5:31">मत्‌ती 5:31</ref></char></note> <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />आनी लेदे माणेह आह़फा ना आय्‌ह़-बाह गेथो आंग्‌येत हय्‌न, आह़फा नी बयर ह़ाते जोड़ाय्‌न रेहे, <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />अने तीहया बे जणा एक डील<note caller="+" style="x"><char style="xo" closed="false">10:8 </char><char style="xt" closed="false"><ref loc="GEN 2:24">उबजणाय कीताप 2:24</ref></char></note> बण जहे। एतरे भगवान नी नींगा मे हमणे गेथा तीहया बे डील नी, पण एक डील से। <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />एतरे जीमने भगवान जोड़लो से, तीमने माणहु अलग नी करवा जोवे।”<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />अने जत्‌यार ईसु अने चेला घोर मे पासा ज्‌या ता चेला अळी आहयी वात ना बारा मे ईसु ने पुछ्‌या। <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" /><note caller="+" style="x"><char style="xo" closed="false">10:11 </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्‌ती 5:32</ref>; <ref loc="1CO 7:10">1 कुरन्‌थी 7:10</ref>,<ref loc="1CO 7:11">11</ref></char></note>अने तीहयो तीमने केदो, “जे कोय माणेह पेल्‌नी लाडी ने सोड़ीन बीजी लाडी बणावे, तीहयो पेल्‌नी लाडी ना वीरोद मे बीजी ह़ाते छीनाळु करे, <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />अने कदीम लाडी आह़फी ना लाडा ने सोड़ीन झगड़ो भंगाड़ीन बीजो लाडो करे, ता तीहयी छीनाळु करे।”<note caller="+" style="x"><char style="xo" closed="false">10:12 </char><char style="xt" closed="false"><ref loc="MAT 5:32">मत्‌ती 5:32</ref>; <ref loc="1CO 7:10-11">1 कुरन्‌थी 7:10-11</ref></char></note><verse eid="MRK 10:12" /></para>
  <para style="s">ईसु नान्‌ला सोरा ने संयबरकत आपे</para>
  <para style="r">(<ref loc="MAT 19:13-15">मत्‌ती 19:13-15</ref>; <ref loc="LUK 18:15-17">लुका 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />अळी आय्‌ह़-बाह आह़फा ना सोरा-सोरी ने ईसुन ता लाया; के ईसु सोरा-सोरी पोर आह़फा नो हात मेके, पण चेला तीमने वड्‌या। <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />ईसु चेलाम ने वडत्‌लो देखीन, रीह करीन, अने तीमने हुकम आपीन केदो, “हीमने ना रोको, सोरा-सोरी ने मारीन्‌तां आव्‌वा देवो; काहाके भगवान नु राज हीमनी ह़ारका नु से।” <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" /><note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">मत्‌ती 18:3</ref></char></note>मे तमने ह़ाचलीन केम, “जे कोय भगवान ना राज ने नान्‌ला सोरा-सोरीन तेम भरहो करीन नी रेय, ता तीने भगवान ना राज मे कदी नी जवाये।”<note caller="+" style="x"><char style="xo" closed="false">10:15 </char><char style="xt" closed="false"><ref loc="MAT 18:3">मत्‌ती 18:3</ref></char></note> <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />अने ईसु सोरा ने खोळा मे लेदो अने तीमनी पोर हात मेकीन संयबरकत आप्‌यो।<verse eid="MRK 10:16" /></para>
  <para style="s">मालदार माणेह</para>
  <para style="r">(<ref loc="MAT 19:16-30">मत्‌ती 19:16-30</ref>; <ref loc="LUK 18:18-30">लुका 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />अळतेण जत्‌यार ईसु यरुसलेम भणी जवा करीन वाट्‌ये लाग्‌यो, ता एक माणेह तीनीन्‌तां दवड़ीन आयो, अने तीना पोगे पड़ीन तीने पुछ्‌यो, “ए वारला मास्‌तर, अमरकाय नी जीवाय हात करवा करीन मे ह़ु करु?”<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />अने ईसु तीने केदो, “तु मने वारलो काहा केय?” भगवान ने सोड़ीन कानो बी वारलो नी हय, भगवान एतरोत वारलो से। <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />तु आहया हुकम ते जाणे, खुन नी करजे, छीनाळु नी करजे, चोरी नी करजे, झुटी गवा नी देजे, कोयने नी ठगजे, आह़फा ना आय्‌ह-बाहा नी ईज्‌जत करजे।<note caller="+" style="x"><char style="xo" closed="false">10:19 </char><char style="xt" closed="false"><ref loc="EXO 20:12-16">नीरगमन 20:12-16</ref>; <ref loc="DEU 5:16-20">वेवस्‌थावीवरन 5:16-20</ref></char></note><verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />अने तीहयो ईसु ने केदो, “ए मास्‌तर, आहया आखा हुकम ते मे जुवान हतो तत्‌यार गेथोत मान्‌तो आय र्‌यो।”<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />अने ईसु तीनी भणी घणा मोंग सी भाळ्‌यो, अने तीने केदो, “तारी मे एक वात नी कमी से; जा, जेतरु बी तारु से, तीने वेचीन गरीब ने आखु आप दे, अने अळतेण मारी ह़ाते आवजे। ईसम करही, ता तने ह़रग मे धन जड़हे।” <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />तीहयो माणेह ते घण-जबर मालदार हतो। एतरे ईसु नी वात ह़मळीन तीहयो घण फीकर मे पड़ ज्‌यो, अने दुखी हय्‌न जत र्‌यो।<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />ईसु च्‌यारो-मेर भाळीन आह़फा ना चेला ने ह़मजाड़तो जाय्‌न केदो, “मालदार माणहु ने भगवान ना राज मे भरायवा घणु जबर काठु से।”<verse eid="MRK 10:23" /></para>
  <para style="s">धन नु जखम</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />आहयी वात चेला ह़मळीन वहराय ज्‌या। पण ईसु अळी तीमने केदो, “ए सोरा! भगवान ना राज मे भरायवा घणु काठु से! <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />भगवान ना राज मे मालदार माणेह ने भरायवा गेथु, उटड़ा ने ह़ोय ना डुचा मे भरायवा सरल से।” <figure style="fig" alt="Merchant leading a camel outside a city wall and gate" file="hk00041c.tif" size="col" copy="Horace Knowles ©" ref="10:25">ह़ेर नु भीतड़ु अने झापलान बारा वेपार्‌या उटड़ा ने ली जाय र्‌या </figure><verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />चेला घणा जबर वहराय्‌न आह़फात केवा बाज ज्‌या; “मालदार माणहु ने लग छुटकारो हात करवा काठु से, ता कोयने छुटकारो जड़हे?”<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />ईसु चेला भणी भाळीन केदो, “आसम बचाड़वा माणहु ने नी बणे, पण भगवान वाटु आखु कंय बण जाय।”<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />पतरस ईसु ने केवा बाज ज्‌यो, “देखो आमु ते आखु कंय सोड़ीन तार ह़ाते आय र्‌या।”<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />ईसु केदो, “मे ह़ाचलीन केम, जे कोय मार वाटु अने खुस-खबर ना काम वाटु घोर ने नीता खेतर ने नीता भाय-बेन्‌या ने नीता आय्‌ह-बाह ने नीता सोरा-सोरी ने सोड़ देदो हय, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />तीने आहयी कळी मेत ह़ोव गुणा पासु जड़हे। घोरु भायु अने बेन्‌या अने आय्‌ह-बाहा अने सोरा अने खेतरु पण आहया आखा भेळ माणहुन तेम वेला बी झेलवा पड़हे, ते बी आव्‌वा वाळी कळी मे तीहयो अमरकाय जीवाय बी हात करहे। <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" /><note caller="+" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्‌ती 20:16</ref>; <ref loc="LUK 13:30">लुका 13:30</ref></char></note>ईसम बी फोम राखजो, पण घणा माणहु जे हमणे पेले से, तां तीहया पसळ हय जहे, अने जे हमणे पसळ से, तां तीहया अगळ हय जहे।”<note caller="+" style="x"><char style="xo" closed="false">10:31 </char><char style="xt" closed="false"><ref loc="MAT 20:16">मत्‌ती 20:16</ref>; <ref loc="LUK 13:30">लुका 13:30</ref></char></note><verse eid="MRK 10:31" /></para>
  <para style="s">ईसु तीसरी कावा दुख भुगत्‌वान अने जीवतो हयवान बारा मे केय</para>
  <para style="r">(<ref loc="MAT 20:17-19">मत्‌ती 20:17-19</ref>; <ref loc="LUK 18:31-34">लुका 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />हाव ते ईसु अने तीना चेला यरुसलेम भणी जवा बाज र्‌या हता, ते बी आखा नी अगळ ईसु चालतो हतो। करीन तीना चेला चकरायता हता अने पसळ-पसळ चालन्‌या बीजा माणहु बी बीहवा बाज ज्‌या। एतरे ईसु बारे नेवताळा ने अळी आग्‌ये ली जाय्‌न तीमने आह़फा पोर जे वीतवा वाळु हतु, तीहयो केवा बाज ज्‌यो। <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />“ह़मळो, आपणु यरुसलेम जवा बाज र्‌या, अने मे मनख्‌या नो सोरा ने धरीन मंदीर ना डायला पुंजारा नी अने युहदी-धरम ह़ीकाड़न्‌या ना हात मे आप देहे, अने तीहया तीने गुनाळ्‌ळो ठेरावीन मोत नो डंड आपीन आड़जात्‌या माणहु ना हात मे ह़ोप देहे। <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />अने तीहया तीनी हाही उड़ावह़े, अने तीनी पोर थुपहे, अने तीने ह़ड़का देहे, अने मार देहे, अने अळतेण तीहयो तीन दाड़ा मे मर्‌या-ह़र्‌या मे गेथो पासो जीवतो हय जहे।”<verse eid="MRK 10:34" /></para>
  <para style="s">याकुब अने युहन्‌ना नी वीन्‌ती</para>
  <para style="r">(<ref loc="MAT 20:20-28">मत्‌ती 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />तत्‌यार जब्‌दी ना सोरो याकुब अने युहन्‌ना ईसुन्‌तां आवीन केदो, “ए मास्‌तर, अमारी हेर आहयी से के, जे बी आमु तार पांह मांगहु, तीहयुत आमने आप देजे।”<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />तीहयो तीमने केदो, “तमारी ह़ु हेर से जे मे तमारी वाटु पुरु करु?”<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />तीहया ईसु ने केदा, “जत्‌यार तु तारी बड़ाय भेळ राज करवा करीन, राजगादी पोर बठही, ता अमारी मेनो एक जणो तारी जमणी धेड़े अने एक जणा ने तार डाखरी धेड़े बहाड़जे।”<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:38 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 12:50">लुका 12:50</ref>
      </char>
    </note>पण ईसु तीमने केदो, “तमु जे मांगवा बाज र्‌या तीहयी वात नु मतलब तमने मालम बी नी हय। जे दुख नो पीयालो मे पीवा वाळो से, तीहयो पीयालो तमु पीहु ह़ु? अने जे दुख नो बपतीस्‌मा मे लेवा वाळो से, तीहयु बपतीस्‌मा तमु लेहु ह़ु?”<note caller="+" style="x"><char style="xo" closed="false">10:38 </char><char style="xt" closed="false"><ref loc="LUK 12:50">लुका 12:50</ref></char></note><verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />तीहया तीने केदो, “तु केय तेम आमु करहु।” अने ईसु तीमने केदो, “जे दुख नो पीयालो मे पीवा वाळो से, तीहयो पीयालो तमने बी पीवा पड़हे, होव जे दुख नो बपतीस्‌मा मे लेवा वाळो से, तीहयो बपतीस्‌मा तमने बी लेवा पड़हे <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />पण मारी जमणी धेड़े अने डाखर्‌या धेड़े कोयने बहाड़वा से, आहयी वात मे मारो हक नी हय। पण आहयो जागो तीमने जड़हे, जीमनी वाटु भगवान तीयार करलो से।”<verse eid="MRK 10:40" /></para>
  <para style="s">चाकरी नो भाव</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />याकुब अने युहन्‌ना नी वात ह़मळीन, बीजा दह़ नेवताळा तीमनी पोर रीहवाय पड़्‌या। <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" /><note caller="+" style="x"><char style="xo" closed="false">10:42 </char><char style="xt" closed="false"><ref loc="LUK 22:25">लुका 22:25</ref>,<ref loc="LUK 22:26">26</ref></char></note>ईसु तीमने आखा ने ह़ाते बोलावीन केदो, “तमु जाणो के आखी जाती ना माणहु पोर राज करन्‌यो नामह़ाद्‌यो पुडारी, आह़फा असामी पोर हक जमाड़ीन राज करे, अने तीहया हक जमाड़न्‌या पोर अळी बीजा मोट्‌ला माणहु हक जमाड़े। <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" /><note caller="+" style="x"><char style="xo" closed="false">10:43 </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्‌ती 23:11</ref>; <ref loc="MRK 9:35">मरकुस 9:35</ref>; <ref loc="LUK 22:26">लुका 22:26</ref></char></note>पण तमारी मे एवो हक वाळो कायदो नी रेवा जोवे। जे तमारी मे मोटो हयवा हींडे, तीहयो तमारो पावर्‌यो बणवा जोवे।<note caller="+" style="x"><char style="xo" closed="false">10:43 </char><char style="xt" closed="false"><ref loc="LUK 22:25-26">लुका 22:25-26</ref></char></note> <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />अने जे कोय बी तमारी मेनो आखा नो डायलो बणवा हींडे, तीहयो आखा नो गुलाम पावर्‌यो बणाव्‌वा जोवे। <note caller="+" style="x"><char style="xo" closed="false">10:44 </char><char style="xt" closed="false"><ref loc="MAT 23:11">मत्‌ती 23:11</ref>; <ref loc="MRK 9:35">मरकुस 9:35</ref>; <ref loc="LUK 22:26">लुका 22:26</ref></char></note> <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />काहाके मे मनख्‌या नो सोरो बी आहयी कळी मे आह़फा नी सेवा-चाकरी कराव्‌वा नी, पण आह़फोत सेवा-चाकरी करवा अने ढेरेत जणा नो जीव सोड़ाव्‌वा करीन अने आह़फा नो जीव ह़ाटे करवा आवलो से।”<verse eid="MRK 10:45" /></para>
  <para style="s">आंदळा ने डोळा आपवा</para>
  <para style="r">(<ref loc="MAT 20:29-34">मत्‌ती 20:29-34</ref>; <ref loc="LUK 18:35-43">लुका 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />ईसु अने तीना चेला यरीहो ह़ेर मे पुग ज्‌या; अने जत्‌यार ईसु अने चेला तां गेथा यरुसलेम जवा करीन नीकळ्‌या ता तां गेथो माणहु नो एक मोट्‌लो मेळो बी तीमनी ह़ाते चाल पड़्‌यो। ता तां ह़ारीक एक आंदळो भीकारी रोहा धेड़े बह र्‌यो हतो। तीहयो भीकारी तीमाय नो सोरो बरतीमाय हतो। <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />तीहयो आहयु ह़मळ्‌यो आञे ह़ारीक नासरत गाम वाळो ईसु आव्‌वा बाज र्‌यो, ता तीहयो आंदळो आड़ी-आड़ीन केदो, “ए दावुद नी अवल्‌यात ईसु मार पोर गीण कर।”<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />घणा माणहु तीने होगो रे करीन वडवा बाज ज्‌या, पण तीहयो अळी ज्‌योरेत आड़ीन केवा बाज ज्‌यो, “ए दावुद नी अवल्‌यात, मार पोर गीण कर।”<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />तत्‌यार ईसु उबो रीन हुकम आपीन केदो, “हीने आञे बोलावो” अने माणहु तीने बोलावीन केदा, “हीम्‌मत राख” अने “उठ, तने ईसु बोलावे।”<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />तीहयो आह़फा नु चादरु नाखदीन छोटोत उठ्‌यो, अने ईसुन्‌तां ज्‌यो।<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />ईसु तीने केदो, “तु मारी पांह ह़ु कराव्‌वा हींड र्‌यो?” आंदळो तीने केदो, “ए मास्‌तर, मे अळी देखवा हींड र्‌यो।”<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />ईसु तीने केदो, “जा” तारो भरहो तने वारु कर देदो, अने तीहयो तत्‌यारुत देखवा बाज ज्‌यो, अने वाट्‌ये ईसु पसळ चाल पड़्‌यो।<verse eid="MRK 10:52" /></para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">यरुसलेम मे जीक आवी</para>
  <para style="r">(<ref loc="MAT 21:1-11">मत्‌ती 21:1-11</ref>; <ref loc="LUK 19:28-40">लुका 19:28-40</ref>; <ref loc="JHN 12:12-19">युहन्‌ना 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />अळतेण ईसु अने चेला, अने ह़ाते चालन्‌या माणहु यरुसलेम ह़ेर धेड़े जेतुन नाम ना बड़ा पोर बेतफगे अने बेतन्‌या गाम धेड़े पुग्‌या, ता ईसु आह़फा ना चेला मे गेथो बे चेला ने ईसम कीन मोकल्‌यो, <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />“तमु ह़ेलु ह़ाम्‌बु देखाये, तीना गाम मे जावो, अने गाम मे पुगतेत तमने एक एवु पाठड़ु गदड़ु बांद मेकलु देखाव पड़हे; तीनी पोर हजु लग कोय नी बह्‌यु। तीहयु पाठड़ु गदड़ु ने सोड़ लावो। <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />कदीम कोय तमने पुसे के ईने ह़ु करवा सोड़ र्‌या? ता तमु केजो, मालीक ने आहयु पाठड़ु गदड़ु जोवे; अने मालीक आहयु गदड़ु ने छोटोत पासु ली मोकल्‌हे।”<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />अने तीहया बे चेला जाय्‌न तीहया पाठड़ा गदड़ा ने वाट धेड़े आंगणा नी वाड़ी ना झापला पोर बांद मेकलु देखीन सोड़वा बाज ज्‌या। <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />अने तां उबा हय र्‌या हता, तीमनी माय्‌न काना केवा बाज ज्‌या, “पाठड़ा गदड़ा ने सोड़ीन ह़ु करवा हय र्‌या?”<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />जीसम ईसु तीमने केदलो तेमेत तीमने की देदा; अने तीहया चेला ने पाठड़ु गदड़ु लीजवा देदा <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />अने तीहया बे चेला पाठड़ु गदड़ु ने ईसुन्‌तां ली ज्‌या अने तीहया आह़फा ना लुगड़ा गदड़ु पोर नाख देदा। अने ईसु तीहयु पाठड़ु गदड़ु पोर बह ज्‌यो। <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />अने घणा ढेरका माणहु आह़फा ना लुगड़ा ईसु अगळ वाट पोर आथरी देदा अने बीजा माणहु खेतर ना ह़ेडे गेथा पान्‌टा वाळा डाळ्‌या वाडीन लाया अने आथरी देदा। <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />जे बी ईसु ना अगळ-अगळ अने पसळ-पसळ जता हता, तीहया आड़ी-आड़ीन केता हता, “होसन्‌ना, बरकत वाळो से तीहयो, जे मालीक भगवान ना नामे आवे!<note caller="+" style="x"><char style="xo" closed="false">11:9 </char><char style="xt" closed="false"><ref loc="PSA 118:25">भजन सहीता 118:25</ref>,<ref loc="PSA 118:26">26</ref></char></note> <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />जुगाळो से आपणा डायला बाह दावुद नु राज जे आव्‌वा बाज र्‌यो। आखा मे उचा ह़रग मे होसन्‌ना।”<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />अने ईसु यरुसलेम पुगीन मंदीर मे ज्‌यो; अने च्‌यारो-मेर भाळीन तां वाळु आखु चीज ने देख्‌यो, ता दाहड़ु डुबवात वाळु हतु, एतरे ईसु चेला ह़ाते बेतन्‌या गाम मे जत र्‌यो।<verse eid="MRK 11:11" /></para>
  <para style="s">ईसु गुलर ना झाड़ ने सराप आपे</para>
  <para style="r">(<ref loc="MAT 21:18-19">मत्‌ती 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />बीजा दाड़े ईसु अने चेला बेतन्‌या गाम गेथा नीकळीन यरुसलेम ह़ेर जवा बाज ज्‌या, ता ईसु ने भुक लागी। <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />अने तीहयो नाम्‌बे रीन एक गुलर नाम नु लील्‌लु झाड़ ने देख्‌यो, अने कंखर तीमनी मे खावा करीन एक बे फोळ जड़ जहे, करीन अगो ज्‌यो, पण पान्‌टा ने सोड़ीन कंय नी हतु; काहाके फालवा ना दाड़ा नी हता। <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />तत्‌यार ईसु गुलर ना झाड़ ने हुकम आपीन केदो, “हमणे गेथा जलम लग तारा फोळ नी लागे, अने कोयने बी खावा नी जड़े।” अने ईसु ना चेला ईसु ने सराप देत्‌तलो ह़मळी र्‌या हता।<verse eid="MRK 11:14" /></para>
  <para style="s">ईसु मंदीर मे गेथो लेणु-देणु करवा वाळा ने काडे</para>
  <para style="r">(<ref loc="MAT 21:12-27">मत्‌ती 21:12-27</ref>; <ref loc="LUK 19:45-48">लुका 19:45-48</ref>; <ref loc="JHN 2:13-22">युहन्‌ना 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />अळी ईसु अने चेला यरुसलेम ह़ेर मे ज्‌या, ता ईसु मंदीर मे ज्‌यो, अने तां तीहया लेणु-देणु कर र्‌या हता, तीमने बारथा काडवा बाज ज्‌यो अने पय्‌हान अदला-बदली करन्‌यान टेबल्‌या अने पारवा वेचवा वाळा ने बारथो नीकाळ देदो। <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />अने ईसु मंदीर मे कोयने कंय बी वेचवा नु ह़मान लीन आव्‌वा अने जवा नी देदो। <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />ह़ीकापण आप्‌तो जाय्‌न केदो, “खरला सास्‌तर मे ईसम लीखलु से? के मारु घोर पुरा देस ना माणहु नु वीन्‌ती नु घोर केवायहे<note caller="+" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="ISA 56:7">यसाया 56:7</ref></char></note> पण तमु ते आहया घोर ने चोट्‌टा नु घोर बणाय देदा।”<note caller="+" style="x"><char style="xo" closed="false">11:17 </char><char style="xt" closed="false"><ref loc="JER 7:11">यीरम्‌या 7:11</ref></char></note><verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />यरुसलेम मंदीर ना डायला पुंजारा अने युहदी-धरम ह़ीकाड़न्‌या ईसु जीसम केदो तीहयु आखु ह़मळ्‌या। एतरे तीहया ईसु ने मारवा करीन मोखो ह़ोदवा बाज ज्‌या। पण आखा माणहु ईसु नी ह़ीकापण सी वहराय जता हता, करीन तीहया ईसु सी बीहता हता।<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />अने ह़ांती टेमे ईसु आह़फा ना चेला ने लीन ह़ेर ने सोड़ीन जत र्‌यो।<verse eid="MRK 11:19" /></para>
  <para style="s">ह़ुकला गुलर ना झाड़ नी ह़ीकापण</para>
  <para style="r">(<ref loc="MAT 21:20-22">मत्‌ती 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />ह़वारे अळी तीहया तीहयीत वाट्‌ये जता हता, ता तीहया गुलर ना झाड़ ने मुळ्‌या भेळ ह़ुकलु देख्‌या। <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />अने पतरस ने ईसु नी केदली वात फोम आयी, अने तीहयो ईसु ने केदो, “ए मास्‌तर, देख, आहयु गुलर नु झाड़ जीने तु सराप आपलो, तीहयु ह़ुकाय ज्‌यु।”<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />ईसु तीमने केदो, “भगवान पोर भरहो करो। <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" /><note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">मत्‌ती 17:20</ref>; <ref loc="1CO 13:2">1 कुरन्‌थी 13:2</ref></char></note>मे तमने ह़ाचलीन केम, जे कोय आहया बड़ा ने आहयु केहे; के तु उखड़ीन दर्‌या मे नखाय जा अने आह़फा ना मन मे सण्‌का कर्‌या वगर आहयो भरहो करहे, ता तीनी वाटु तीहयुत हयहे<note caller="+" style="x"><char style="xo" closed="false">11:23 </char><char style="xt" closed="false"><ref loc="MAT 17:20">मत्‌ती 17:20</ref>; <ref loc="1CO 13:2">1 कुरन्‌थी 13:2</ref></char></note> <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />एतरे मे तमने आहयु केम, जे बी तमु वीन्‌ती करीन मांगो, अने भरहो कर लेवो के आमने जड़ ज्‌यु, ता तमारी वाटु तीहयुत हय जहे। <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" /><note caller="+" style="x"><char style="xo" closed="false">11:25 </char><char style="xt" closed="false"><ref loc="MAT 6:14">मत्‌ती 6:14</ref>,<ref loc="MAT 6:15">15</ref></char></note>अने जत्‌यार बी तमु वीन्‌ती करवा करीन उबा हयो, ता तमु तमारा मन मे कोयना वीरोद मे कुहराय र्‌या हय, ता तीने माफ कर देवो; अने तत्‌यार तमारो ह़रग नो बाह बी तमारा पाप नी माफी आपहे।” <verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />अने कदीम तमु बीजा नो गुनो माफ नी करे, ता तमारो बाह तीहयो ह़रग मे से, तमारो गुनो माफ नी करे।<note caller="+" style="f"><char style="fr" closed="false">11:26 </char><char style="ft" closed="false">आहयो बोल पुराना कायदा मे नी हय</char></note><verse eid="MRK 11:26" /></para>
  <para style="s">ईसु ना हक ना बारा मे पुछे</para>
  <para style="r">(<ref loc="MAT 21:23-27">मत्‌ती 21:23-27</ref>; <ref loc="LUK 20:1-8">लुका 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />अने तीहया अळी यरुसलेम मे ज्‌या, अने जत्‌यार ईसु मंदीर मे हींडतो हतो, ता मंदीर ना डायला पुंजारा अने युहदी-धरम ह़ीकाड़न्‌या अने पुडार्‌या तीनीन्‌तां आया, <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />अने तीहया पुछवा बाज ज्‌या, “आहया काम तु काना हक सी करे? अने आहया काम करवान हक तने कोय आप्‌यु?”<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />पण ईसु तीमने केदो, “मे बी तमने एक वात पुछु; आहयी वात नो जपाप आपो; तत्‌यार मे देखाड़ही के आहया काम काना हक सी करु, <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />बपतीस्‌मा आपण्‌या युहन्‌ना ने, बपतीस्‌मा आपवा नो हक भगवान भणी गेथो जड़लो के माणेह पांह गेथो जड़लो? मने जपाप आपो।”<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />अने तत्‌यार तीहया वीच्‌यार काडवा बाज ज्‌या; के “कदीम आपणु केहु, भगवान आपलो, ता हीय्‌यो केहे, ता तमु तीनी पोर भरहो काहा नी कर्‌या? <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />पण कदी आपणु केहु, माणहु ईने हक आपला से, ता आहया मेळा मे वाळा माणहु सी बीहता हता; काहाके आहया आखा माणहु बपतीस्‌मा आपण्‌या युहन्‌ना ने भगवान वगे गेथी वात केण्‌यो माने।” <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />एतरे तीहया ईसु ने ईसम जपाप आप्‌या, “आमने मालम नी हय।” ता ईसु तीमने केदो, “मे बी तमने नी केतो के मे आहया काम काना हक सी करु।”<verse eid="MRK 11:33" /></para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">साजा मे आपली वाड़ी नो दाखलो</para>
  <para style="r">(<ref loc="MAT 21:33-46">मत्‌ती 21:33-46</ref>; <ref loc="LUK 20:9-19">लुका 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />ईसु यरुसलेम वाळा ने दाखला ना लारे केतो ज्‌यो, “एक माणेह अंगुर नी वाड़ी लगाड़्‌यो; अने वाड़ी ना च्‌यारो-मेर वाड़ बांद्‌यो अने अंगुर नो रोह काडवा करीन एक हळावो बणायो, अने अंगुर नी वाड़ी मे एक माळो बणायो अने काना कीरसान ने आह़फा नी वाड़ी साजा मे आपीन, नाम्‌बे वाळा देस मे जत र्‌यो। <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />पण अंगुर ना फालवा ना दाड़ा आया, तीहया खेतर नो मालीक आह़फा ना एक पावोर ने कीरसान ने तां अंगुर नी वाड़ी ना फोळ नो वाटो मांगवा मोकल्‌यो। <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />पण तीहया तीने धरीन ठोक्‌या, अने तीने ठारलोत पासो मोकली देदा। <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />अळी तीहया बीजा पावर्‌या ने मोकल्‌या अने तीहया ते पावोर ना मुंडा मे देदा, अने तीनु नामबद्‌दी कर्‌या। <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />मालीक बीजा पावर्‌या ने मोकल्‌यो, अने तीने तीहया मार नाख्‌या, ता तीहयो अळी ढेरकात पावर्‌या ने मोकल्‌यो तीमनी मे गेथा तीहया काना ने ठोक्‌या; अने काना ने मार नाख्‌या। <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />हाव तीमनीन्‌तां मोकलवा करीन एकीत जणो र्‌यो; तीहयो तीनो मोंगाळ्‌ळो सोरो हतो। तीहया तीनु आव-भाव करहे करीन तीहयो आह़फा ना सोरा ने तीमनीन्‌तां सेल्‌ली कावा मोकल्‌यो। <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />पण तीहया कीरसाण्‌या आह़फा केदा, ‘आहयो ते आहया खेतर नो हकदार्‌यो से; चालो आने बी मार नाखता, तत्‌यार आहयी अंगुर नी वाड़ी आपणी हय जहे।’ <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />अने तीहया तीने धरीन मार नाख्‌या अने अंगुर नी वाड़ी मे गेथो बारो नाख देदा।”<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />ईसु पुछ्‌यो आञे ह़ारीक अंगुर नी वाड़ी नो मालीक ह़ु करहे? तीहयो आवीन तीहया कीरसाण्‌या ने मार नाखहे अने अंगुर नी वाड़ी बीजा ने साजा मे आप देहे। <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />तमु हजु लग खरला भगवान ना बोलु मे आहयो बोल भण्‌या नी ह़ु? जे दगड़ा ने राज-मीस्‌तर्‌या रीकामो ह़मजीन बारो काड देदा, तीहयो दगड़ो ते घोर ना खुणा नो दगड़ो बण ज्‌यो। <verse eid="MRK 12:10" /><verse number="11" style="v" sid="MRK 12:11" />आहयु ते मालीक भगवान नी वगे गेथु हयलु से, आहयु ते अमारी नींगा मे घणु जुदु से।<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />तीहया डायला पुंजारा, युहदी-धरम ह़ीकाड़न्‌या अने पुडार्‌या ह़मजी ज्‌या, के आहयो ते अमारी वीरोद मे दाखलो देखाड़लो से, एतरे तीहया ईसु ने धरवा हींडता हता, पण तीहया मेळा मे वाळा माणहु सी बीहता हता, एतरे ईसु ने रेवा दीन जत र्‌या।<verse eid="MRK 12:12" /></para>
  <para style="s">करजो आपवा ना बारा मे सवाल?</para>
  <para style="r">(<ref loc="MAT 22:15-22">मत्‌ती 22:15-22</ref>; <ref loc="LUK 20:20-26">लुका 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />अळतेण आहया यरुसलेम वाळा डायला पुंजारा, युहदी-धरम ह़ीकाड़न्‌या अने पुडार्‌या ईसु ने वात मे फसाड़वा करीन, थोड़ाक फरीसी दलवाळा ने अने हेरोद राजा नी पाल्‌टी ना माणहु ने ईसुन्‌तां मोकल्‌या। <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />अने तीहया आवीन ईसु ने केदा, “ए मास्‌तर, आमु जाणीया के तु खरलो से, अने कोय नी परवाय नी करे; काहाके तु माणहु ना मोडा भणी भाळीन वात नी करे, पण भगवान नी वाट सच्‌चाय सी देखाड़े। ता रोमी राज ना राजा ने फाळो आपवा ताले से के नी हय? आमु फाळो आपीया के नी आपीया?”<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />तीमना ढोंगड़ा जाणीन ईसु तीमने केदो, “मने काहा पारखवा बाज र्‌या? एक कळदार सीक्‌को मारीन्‌तां लावो, ता मे तीहयो सीक्‌को देखीन देखाड़ही।”<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />अने तीहया एक सीक्‌को लावीन ईसु ने आप्‌या। अने ईसु तीमने सीक्‌को देखाड़ीन केदो, “सीक्‌का पोर कोयनो सीको अने नाम छापलु से?” तीहया केदा, “रोमी राजा नु।”<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />ईसु तीमने केदो, “जे रोमी राजा नु से, तीहयो हक रोमी राजा ने आपीन पुरो करो; जे भगवान नु से, तीहयो हक भगवान ने आपीन पुरो करो।” अने तीहया तीनी वात ह़मळीन घणा जबर वहराय ज्‌या।<verse eid="MRK 12:17" /></para>
  <para style="s">मरला मे गेथा जीवता हयवा अने वेवा</para>
  <para style="r">(<ref loc="MAT 22:23-33">मत्‌ती 22:23-33</ref>; <ref loc="LUK 20:27-40">लुका 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:18 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 23:8">नेवताळा ना काम 23:8</ref>
      </char>
    </note>अळतेण सदुकी दलवाळा, तीहया आहयु माने के माणहु मरला मे गेथा पासा जीवता नी हये, तीहया ईसुन्‌तां आवीन पुछ्‌या, <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />तीहया केदा “ए मास्‌तर, मुसो आपणी जुगु लीखलो से, के कदी कोयनो भाय लाडी बणावीन वण-अवल्‌यात नो मर जाय, अने ता तीनो भाय तीनी रंडायली लाडी ह़ाते वेवा करीन आह़फा भाय जुगु अवल्‌यात पयदा करवा जोवे। <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />एक कावा ईसम हयु; ह़ात भाय हता। आखान मोट्‌लो भाय वेवा करीन वण-अवल्‌यात नो मर ज्‌यो। <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />ता तीहयी रंडायली लाडी ह़ाते बीजो भाय वेवा कर्‌यो; अने तीहयो बी वण-अवल्‌यात नो मर ज्‌यो; अने तीसरो भाय बी तीहयी रंडायली बयर ह़ाते वेवा करीन वण-अवल्‌यात नो मर ज्‌यो, <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />ईसम करीन ह़ातोव भाय ईसमेत तीनी ह़ाते वेवा कर्‌या, अने वण-अवल्‌यात ना मर ज्‌या। अने सेल्‌ली कावा, तीहयी रंडायली बयर बी मर जी। <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />एतरे आखा पासा जीवता हयहे ता तीहयी कोयनी लाडी केवायहे? तीहयी ते ह़ातोव भाय नी लाडी बणली हती।”<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />ईसु तीमने केदो, “तमु चोखली सास्‌तर ने नी ह़मजो अने भगवान नी सक्‌ती ने नी ओळखो। एतरे तमु भुले पड़ र्‌या। <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />मरला माणहु जत्‌यार मरला मे गेथा जीवता हयहे ता, तीमनी मे वेवा नी हये, जीसम ह़रग मे वाळा ह़रगदुत ना बी तीमनीन तेम वेवा नी हये। <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />मरला मे गेथा पासा जीवता हयवा ना बारा मे तमु मुसा नी कीताप मे नी भण्‌या ह़ु? तां ह़ारीक भगवान बी पासा जीवता हयवा नी वात ने धपत्‌ला कटाळ्‌ळा झाटवा मे मुसा नी अगळ देखाड़्‌यो।” अने भगवान मुसा ने आहयु केदो, “मे अब्‌राहम नो भगवान, अने ईसाक नो भगवान अने याकुब नो भगवान से। <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />भगवान नी नींगा मे मुसा ना आड़ा-बुड़ा अब्‌राहम, ईसाक अने याकुब हमणे बी जीवत्‌ला से। एतरे भगवान मोट्‌ला माणहु नो नी हय, पण जीवत्‌ला माणहु नो से; तमु आहयी वात नी जाणता एतरे तमु आखा गलत से।”<verse eid="MRK 12:27" /></para>
  <para style="s">आखा गेथो मोटो हुकम</para>
  <para style="r">(<ref loc="MAT 22:34-40">मत्‌ती 22:34-40</ref>; <ref loc="LUK 10:25-28">लुका 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />युहदी-धरम ह़ीकाड़न्‌यो एक माणेह, सदुकी दलवाळा ईसु ह़ाते वात मे जखड़ी पड़ रेला ह़मळतो हतो ईसु तीने वारु जपाप आप्‌यो आहयु देखीन तीहयो ईसु ना ह़ाते आवीन तीने पुछ्‌यो, “भगवान ना आखा हुकम मे गेथो कानो हुकम मोट्‌लो से?”<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />ईसु तीने केदो, “आखा हुकम मे मोट्‌लो हुकम आहयो से, ‘ए ईस्‌रायल जाती ना माणहु, ह़मळो आपणो मालीक भगवान एकीत मालीक भगवान से।’ <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />तमु आपणा मालीक भगवान ने आपणा आखा मन सी, आखा जीव सी, आखी अक्‌कल सी, आखी सक्‌ती सी मोंग कर। <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />अने बीजो हुकम आहयो से, के तमु, तमारी आड़े-धेड़े वाळा ने आह़फान तेम मोंग करो। बीजा हुकम आहयो बे हुकम सी मोटा नी हय।”<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />तीहयो युहदी-धरम ह़ीकाड़न्‌यो ईसु ने केदो, “ए मास्‌तर, आहयो हुकम ह़ाचलीन नो नीव से! तु ह़ाचलीन केदो, के एकीत भगवान से अने तीने सोड़ीन कोय भगवान नी हय। <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />अने तीहया भगवान ने आह़फा नी आखी अक्‌कल सी, मन, अने आखा जोर सी, अने आखा जीवे मोंग करवा, अने आपणी ह़ाते वाळा ने आह़फान तेम मोंग करवा; आहया हुकम आखा होम नी बादा चड़ाव्‌वा गेथो अने भेट चड़ाव्‌वा गेथो जादा वारु से।”<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:34 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 10:25-28">लुका 10:25-28</ref>
      </char>
    </note>ईसु देख्‌यो के तीहयो ह़मज सी जपाप आप्‌यो, एतरे ईसु केदो, “तु भगवान ना राज गेथो नाम्‌बे नी हय।” अने अळतेण ईसु ने पारखीन पुसवा नी हीमम्‌त कोयनी नी हयी।<verse eid="MRK 12:34" /></para>
  <para style="s">मसी दावुद नो सोरो?</para>
  <para style="r">(<ref loc="MAT 22:41-46">मत्‌ती 22:41-46</ref>; <ref loc="LUK 20:41-44">लुका 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />अळतेण ईसु मंदीर मे ह़ीकाड़तो जाय्‌न आहयु केदो, “युहदी-धरम ह़ीकाड़न्‌या काहा केय, के मसी दावुद नी अवल्‌यात से?” <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />दावुद आह़फो चोखला आत्‌मा सी भराय्‌न केदलो हतो,</para>
  <para style="q1" vid="MRK 12:36">भगवान मालीक, मारा मालीक मसी ने केदो,</para>
  <para style="q2" vid="MRK 12:36">“तु मारी जमणी धेड़े बह, जत्‌यार लग मे तारा वेरी ने, तारा पोग तळे नी कर देम।”<verse eid="MRK 12:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 12:37" />दावुद ते आह़फोत मसी ने मालीक केय, “ता मसी दावुद नी अवल्‌यात कीसम हय सके?” अने ईसु नी आहयी वात माणहु नो मोट्‌लो मेळो खुस हय्‌न ह़मळ र्‌यो हतो।<verse eid="MRK 12:37" /></para>
  <para style="s">युहदी-धरम ह़ीकाड़न्‌या सी चेतीन रेवा</para>
  <para style="r">(<ref loc="MAT 23:1-36">मत्‌ती 23:1-36</ref>; <ref loc="LUK 20:45-47">लुका 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />तीहयो ह़ीकाड़तो जाय्‌न आहयु केदो, “युहदी-धरम ह़ीकाड़न्‌या सी चेतीन रेवो, तीहया ते पोग मे गेथा नामब्‌ला लुगड़ा पेरीन फीरवा, अने हाट मे ‘वारु से के’ पुसीन तीमनी आव-भाव करवा जोवे। <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />अने तीमना भक्‌तीन घोर मे खास जागा पोर बहवा अने पोरणा मे खास जागा पोर बहवा वारु गमे। <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />तीहया रंडायला बयरा ने धोको दीन ठग लेय, अने बीजा ने देखाड़वा करीन जादा वार वीन्‌ती करता रेय। आहया माणहु ने डंड जादा जड़हे।”<verse eid="MRK 12:40" /></para>
  <para style="s">गरीब रंडायली नु दान</para>
  <para style="r">(<ref loc="LUK 21:1-4">लुका 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />अळतेण ईसु मंदीर नी दान-पेटी ना ह़ाम्‌बो बहीन देख र्‌यो हतो के माणहु दान-पेटी मे कीसम पय्‌हा घाल र्‌या, अने घणा ढेरका मालदार, ढेरका पय्‌हा दान-पेटी मे घाल्‌या। <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />अने तां आवीन एक रंडायली बयर बे टका दान करी तीमनी कीमत घणी कम हती। <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />तत्‌यार ईसु आह़फा ना चेला ने बोलावीन केदो, “मे तमने ह़ाचलीन केम मंदीर नी दान-पेटी मे दान करवा वाळा मे आहयी गरीब रंडायली आखा गेथी जादा दान करली से। <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />काहाके आखा तीमना ढेरेत माल-धन मे गेथु दान कर्‌या; पण आहयी रंडायली बयर गरीब हय्‌न बी आह़फी नु आखु कमायलु दान आप देदी।”<verse eid="MRK 12:44" /></para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">मंदीर खत्‌तम हयवा ना बारा मे देखाड़े</para>
  <para style="r">(<ref loc="MAT 24:1-2">मत्‌ती 24:1-2</ref>; <ref loc="LUK 21:5-6">लुका 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />अळतेण ईसु मंदीर मे गेथो नीकळ्‌यो, ता तीनो एक चेलो केदो, “ए मास्‌तर, देख, आहया मंदीर ना बंगला घणा घटाळा से अने आना जमाड़ला दगड़ा घणा मोटा से?”<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />ईसु तीने केदो, “तु ते आहया बंगला ने देखीन वहराय र्‌यो। पण आहयु आखु ओदार नाखहे; आञे लग के आञे ह़ारीक दगड़ा पोर दगड़ो बी नी बचे।”<verse eid="MRK 13:2" /></para>
  <para style="s">ईसु वेला अने दुख देखाड़े</para>
  <para style="r">(<ref loc="MAT 24:3-14">मत्‌ती 24:3-14</ref>; <ref loc="LUK 21:7-19">लुका 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />अळतेण ईसु जेतुन नाम ना बड़ा पोर, बह र्‌यो हतो, तां गेथो मंदीर ह़ाम्‌बो देखायत्‌लो। तत्‌यार पतरस अने याकुब, अने युहन्‌ना अने अंदर्‌यास ईसु ने आंग्‌ये ली जाय्‌न पुछ्‌या, <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />“आमने के तु आहयी वात कत्‌यार पुरी हयहे? अने जे दाड़ा मे आहयी वात पुरी हयवा वाळी से, तीहया दाड़ा ह़ातेत आय र्‌या आहयु ह़मजवा नी सेलाणी ह़ु रेहे?”<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />ईसु तीमने केवा बाज ज्‌यो, “चेतीन रेवो, कोय बी तमने भंगलाड़वा नी जोवे।” <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />घणा ढेरका मारा नामे आवीन केहे, के “मे मसी से” अने घणा ढेरका भंगलाड़ देहे। <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />जत्‌यार तमु लड़ाय अने झगड़ा नु हुकवाड़ो ह़मळो, ता घबरायजो नी, काहाके ईसम ते हयहेन-हयहे। पण आहयुत कळ नी छेव नी हय। <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />काहाके एक जाती ना माणहु बीजी जाती पोर। एक राज्‌य ना माणहु बीजा राज्‌य ना माणहु ह़ाते झुमायहे। जां तां काळ पड़हे। अने जां तां धरती फाट जहे। आहयी ते, आव्‌वा वाळी गरा सुरु हयवा नी सेलाणी से।<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:9 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 10:17-20">मत्‌ती 10:17-20</ref>; <ref loc="LUK 12:11">लुका 12:11</ref>,<ref loc="LUK 12:12">12</ref></char>
    </note>पण तमु आह़फा ना बारा मे चेतीन रेवो; काहाके वेरी माणहु तमने धरहे अने मोट्‌ली पंचु ना अगळ लीजहे; अने तीमना भक्‌ती ना घोर मे तमने ली जाय्‌न ठोकहे; अने मारा नाम सी राजा अने नीयाव करन्‌या अगळ उबा करहे, तीहयी टेमे तमने तीमनी अगळ मारी खुस-खबर ह़मळावा नो मोखो जड़हे। <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />अने कळ खत्‌तम हयवान पेले खुस-खबर नी वात आखी जाती मे परच्‌यार करवा जोवे। <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />जत्‌यार तीहया तमने बंदी बणावीन पंचु अगळ ली जाय, ता पेले गेथात आहयी फीकर नी करजो, के आमु ह़ु केहु, पण जे कंय तमने तीहयी टेम मे भगवान देखाड़हे, तीहयुत केजो; काहाके बोलवा वाळा तमु नी, पण चोखली आत्‌मा से।<note caller="+" style="x"><char style="xo" closed="false">13:11 </char><char style="xt" closed="false"><ref loc="MAT 10:17-20">मत्‌ती 10:17-20</ref>; <ref loc="LUK 12:11">लुका 12:11</ref>,<ref loc="LUK 12:12">12</ref></char></note> <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />तीहया दाड़ा मे भाय आह़फा ना भाय ने अने बाह आह़फा ना सोरा-सोरी ने मारवा करीन धराय देहे, अने सोरा-सोरी आह़फा ना आय्‌ह़-बाहा ना वीरोद मे हय्‌न तीमने मराय नाखहे। <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" /><note caller="+" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्‌ती 10:22</ref></char></note>अने तमु मारा नाम पोर भरहो कर र्‌या करीन आखा माणहु तमारी सी बुराय करहे। पण जे कोय आखरी लग मार पोर भरहो करहे, तीनेत छुटकारो जड़हे।<note caller="+" style="x"><char style="xo" closed="false">13:13 </char><char style="xt" closed="false"><ref loc="MAT 10:22">मत्‌ती 10:22</ref></char></note><verse eid="MRK 13:13" /></para>
  <para style="s">मोट्‌ली वेला अने काळ</para>
  <para style="r">(<ref loc="MAT 24:15-28">मत्‌ती 24:15-28</ref>; <ref loc="LUK 21:20-24">लुका 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />पण जत्‌यार तमु तीहया उजाड़वा वाळी बगड़ली चीज ने जां वारु नी हय तां उबी हयली देखो, भणवा वाळो ह़मजी लेय, तीहया टेमे, जे माणहु युहद्‌या जीला मे हय, तीमने तत्‌यारुत आह़फा ने बचाड़वा करीन बड़ा मे नाह जवा जोवे।<note caller="+" style="x"><char style="xo" closed="false">13:14 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानीयल 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="DAN 12:11">12:11</ref></char></note> <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" /><note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="LUK 17:31">लुका 17:31</ref></char></note>जे घोर नी पडाळ पोर हय, तीहयो आह़फा ना घोर मे गेथु कंय बी ह़मान लीजवा करीन हेटो नी उतरवा जोवे। <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />अने जे खेतर मे हय, तीहयो आह़फा ना लुगड़ा ने लेवा पासो नी आव्‌वा जोवे।<note caller="+" style="x"><char style="xo" closed="false">13:16 </char><char style="xt" closed="false"><ref loc="LUK 17:21">लुका 17:21</ref></char></note> <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />तीहया दाड़ा मे जे बयर भारेपोगे हहे अने सोरु ने धाय धवाड़ती हहे, तीनी जुगु गरा ना दाड़ा केवायहे! <verse eid="MRK 13:17" /><verse number="18-19" style="v" sid="MRK 13:18-19" /><note caller="+" style="x"><char style="xo" closed="false">13:18-19 </char><char style="xt" closed="false"><ref loc="REV 7:14">परकासीतवाक्‌य 7:14</ref></char></note>तीहया दाड़ा घण-जबर गरा ना रेहे। भगवान कळ घड़्‌यो तां गेथी आज तक एतरी मोटी गरा नी आयी हय, एतरी मोटी गरा आवहे। अने अळी एवी गरा कदी नी आवे। एतरे भगवान पांह वीन्‌ती कर्‌या करो ह़ीयाळा ना दाड़ा मे आहयी गरा नी आव्‌वा जोवे।<note caller="+" style="x"><char style="xo" closed="false">13:18-19 </char><char style="xt" closed="false"><ref loc="DAN 12:1">दानीयल 12:1</ref>; <ref loc="REV 7:14">परकासीतवाक्‌य 7:14</ref></char></note> <verse eid="MRK 13:18-19" /><verse number="20" style="v" sid="MRK 13:20" />कदी मालीक पोर भरहो करन्‌या टाळला माणहु घण दाड़ा लग वेला करता नी रेवा जोवे करीन तीहयो तीहया गरा ना दाड़ा कम कर देहे। कदीम मालीक तीहया दाड़ा मे कम नी करे ता एक बी जीव नी बचे।<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21-22" style="v" sid="MRK 13:21-22" />तीहया दाड़ा मे झुटा मसी, अने झुटा भगवान वगे गेथी वात केण्‌या माणहु जां तां आवहे, अने जुदा-कामु सेलाणी ना रुप मे देखाड़हे; हय सके ता भगवान ना टाळला ने बी धोको दीन भंगलाड़वा नी कोसीत करहे। तीहयी टेमे कानो केहे; देखो मसी आञे से, नीता “देखो ह़ेले से” ता तीमनी पोर भरहो नी करजो। <verse eid="MRK 13:21-22" /><verse number="23" style="v" sid="MRK 13:23" />पण तमु जाळवीन रेवो: देखो, मे ते तमने एवु हयवा नी पेलेत आखी वात की र्‌यो।<verse eid="MRK 13:23" /></para>
  <para style="s">ईसु पासो केम आवहे?</para>
  <para style="r">(<ref loc="MAT 24:29-31">मत्‌ती 24:29-31</ref>; <ref loc="LUK 21:25-28">लुका 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:24 </char>
      <char style="xt" closed="false">
        <ref loc="REV 6:12">परकासीतवाक्‌य 6:12</ref>
      </char>
    </note>तीहया दाड़ा मे, आहयु दुख ना बाद दाहड़ु अंदारु डुब हय जहे, अने चांद वीजाळु नी आपे।<note caller="+" style="x"><char style="xo" closed="false">13:24 </char><char style="xt" closed="false"><ref loc="ISA 13:10">यसाया 13:10</ref>; <ref loc="EZK 32:7">यहेजकेल 32:7</ref>; <ref loc="JOL 2:10">योएल 2:10</ref>,<ref loc="JOL 2:31">31</ref>; <ref loc="JOL 3:15">3:15</ref>; <ref loc="REV 6:12">परकासीतवाक्‌य 6:12</ref></char></note> <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" /><note caller="+" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="REV 6:13">परकासीतवाक्‌य 6:13</ref></char></note>ह़रग मे गेथा तारा हेटा पड़वा बाज जहे, अने ह़रग नी आखी सक्‌ती हील पड़हे।<note caller="+" style="x"><char style="xo" closed="false">13:25 </char><char style="xt" closed="false"><ref loc="ISA 34:4">यसाया 34:4</ref>; <ref loc="JOL 2:10">योएल 2:10</ref>; <ref loc="REV 6:13">परकासीतवाक्‌य 6:13</ref></char></note> <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" /><note caller="+" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="REV 1:7">परकासीतवाक्‌य 1:7</ref></char></note>तत्‌यार माणहु, मनख्‌यान सोरा ने आखा मे जोर भरी सक्‌ती अने बड़ाय भेळे वादळा मे आवत्‌लो देखहे।<note caller="+" style="x"><char style="xo" closed="false">13:26 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानीयल 7:13</ref>; <ref loc="REV 1:7">परकासीतवाक्‌य 1:7</ref></char></note> <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />तीहयी टेमे तीहयो, आह़फा ह़रग वाळा ह़रगदुत ने मोकलीन तीमनीन तेम धरती नी आहयी धेड़े गेथो ह़ेली धेड़े लग, अने ह़रग नी आहयी धेड़े गेथो ह़ेली धेड़े लग च्‌यारो-मेर गेथा आह़फा ना टाळला माणहु ने भेळा करहे।<verse eid="MRK 13:27" /></para>
  <para style="s">गुलर ना झाड़ नो दाखलो</para>
  <para style="r">(<ref loc="MAT 24:32-35">मत्‌ती 24:32-35</ref>; <ref loc="LUK 21:29-33">लुका 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />ईसु अगो केतो ज्‌यो, “गुलर नु झाड़ ना दाखलान लारे ह़ीको; जत्‌यार तीना डाळ्‌या मे गेथा ह़ुवाळा डीरा अने पान्‌टा फुटवा बाज जाय, ता तमु जाण लेवो के, उनाळा ना दाड़ा आव्‌वा वाळा से। <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />एमेत जीसम मे तमने केदो तीहयु हयत्‌लु देखो, तत्‌यार जाण लेजो के, जे आव्‌वा वाळो से अने तीहयो झापला पोर से। <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />मे तमने ह़ाचलीन आहयु केम, मे केदलो तीहयी आखी वात पुरी हयहेन-हयहे, अने आहयी पीड़ी ना माणहु मरवा नी पेलेत आहयी वात पुरी हयवा सुरु हयहे। <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />ह़रग अने धरती टळ जहे पण मारी वात कदी नी टळे।”<verse eid="MRK 13:31" /></para>
  <para style="s">चेतीन रेवो</para>
  <para style="r">(<ref loc="MAT 24:36-44">मत्‌ती 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />
    <note caller="+" style="x">
      <char style="xo" closed="false">13:32 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 24:36">मत्‌ती 24:36</ref>
      </char>
    </note>ईसु अगो केतो ज्‌यो, “मारो आव्‌वा नो दाड़ो अने टेम ना बारा मे कोयने मालम नी हय, ह़रगे वाळा ह़रगदुत ने अने मने बी मालम नी हय, आहयो दाड़ो अने टेम भगवान बाह एतरोत जाणे।<note caller="+" style="x"><char style="xo" closed="false">13:32 </char><char style="xt" closed="false"><ref loc="MAT 24:36">मत्‌ती 24:36</ref>; <ref loc="ACT 1:7">नेवताळा ना काम 1:7</ref></char></note> <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />चेतीन रीन वीन्‌ती करता रेवो। काहाके तमने नी मालम के तीहयी टेम कत्‌यार आवहे। <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" /><note caller="+" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 12:36-38">लुका 12:36-38</ref></char></note>आहयु तीहया माणेह ने तेवु से, जे पारका मुलक मे जवा नी टेमे आह़फा ना घोर ने सोड़ीन जाय, अने आह़फा ना पावर्‌या ने हक आपे, अने आखा ने काम देखाड़ीन जाय, अने झापलु रखवाळ्‌या ने चेतीन रीन जागली करवा नो हुकम आपे।<note caller="+" style="x"><char style="xo" closed="false">13:34 </char><char style="xt" closed="false"><ref loc="LUK 2:36-38">लुका 2:36-38</ref></char></note> <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />एतरे तमु बी जागली करता जाय्‌न चेतीन रेवो, काहाके तमु नी जाणो के घोर नो मालीक कत्‌यार आवहे, ह़ांतो के आदी राते, के कुकड़ा वाहरे के ह़वारे। <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />ईसम नी हयवा जोवे के तीहयो उचकाहलोत आय लागे अने तमु ह़ुवत्‌ला तीने देखाव पड़े। <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />अने जे मे तमने केम तीहयुत आखा ने केम, के चेतीन रीन जागला रेवो।”<verse eid="MRK 13:37" /></para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">ईसु ने मार नाखवा नी चाल</para>
  <para style="r">(<ref loc="MAT 26:1-5">मत्‌ती 26:1-5</ref>; <ref loc="LUK 22:1-2">लुका 22:1-2</ref>; <ref loc="JHN 11:45-53">युहन्‌ना 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />बे दाड़ा मे फसह नो तीवार अने खमीर वगर रोट्‌ला बणाव्‌वा नो तीवार आव्‌वा वाळो हतो।<note caller="+" style="x"><char style="xo" closed="false">14:1 </char><char style="xt" closed="false"><ref loc="EXO 12:1-27">नीरगमन 12:1-27</ref></char></note> मंदीर ना डायला पुंजारा अने युहदी-धरम ह़ीकाड़न्‌या, ईसु ने ठगीन धराव्‌वा नो वीच्‌यार काडवा करीन भेळा हया। <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />पण तीहया केता हता, “के तीवार ना दाड़े नी मरावता, कदी ईसम नी हय जाय के माणहु मे दंगो हय जाय।”<verse eid="MRK 14:2" /></para>
  <para style="s">बेतन्‌या मे ईसु ने तेल रेचवीन तीयार करे</para>
  <para style="r">(<ref loc="MAT 26:6-13">मत्‌ती 26:6-13</ref>; <ref loc="JHN 12:1-8">युहन्‌ना 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">14:3 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 7:37">लुका 7:37</ref>,<ref loc="LUK 7:38">38</ref></char>
    </note>जत्‌यार ईसु बेतन्‌या गाम मे सीमोन कुड़ावा ना घोर मे खावा बह र्‌यो हतो, तत्‌यार एक बयर मोगला दगड़ा नी ह़ीही मे पीवर ईत्‌तर लीन आयी; अने ह़ीहो फोड़ीन ईत्‌तर ईसु ना मुंडा पोर रेचवी देदी।<note caller="+" style="x"><char style="xo" closed="false">14:3 </char><char style="xt" closed="false"><ref loc="LUK 7:37">लुका 7:37</ref>,<ref loc="LUK 7:38">38</ref></char></note> <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />पण काना आह़फाम ना मन मे रीहवाय्‌न केवा बाज ज्‌या, “आहयी आहयु ईत्‌तर ने काहा बगाड़ देदी? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />काहाके आहयु ईत्‌तर एक साल नी दाड़की ना पय्‌हा गेथु बी मोगु वेचाय जतु, अने तीहया पय्‌हा गरीब ने वाट देता।” अने तीहया तीनो वाक काडीन वडवा बाज ज्‌या। <figure style="fig" alt="Jars with spikenard" file="hk00117c.tif" size="col" copy="Horace Knowles ©" ref="14:3">ईत्‌तर नी ह़ीही</figure><verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />ईसु हुकम आपीन केदो, “ईने काहा वेला पाड़ र्‌या; रेवा देवो? हीय्‌यी ते मार जुगु वारलुत काम करली से। <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />गरीब ते जलम तमारी ह़ाते रेहे, अने जत्‌यार गमे तत्‌यार तीमनी भलाय करवा नो मोखो तमारी पांह से;<note caller="+" style="x"><char style="xo" closed="false">14:7 </char><char style="xt" closed="false"><ref loc="DEU 15:11">वेवस्‌थावीवरन 15:11</ref>; <ref loc="MAT 26:11">मत्‌ती 26:11</ref>; <ref loc="JHN 12:8">युहन्‌ना 12:8</ref></char></note> पण मे तमारी ह़ाते जलम नी रेम। <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />जे बी बण्‌यु तीहयु, हीय्‌यी करी, हीय्‌यी मारा डील पोर मने मरवान पेले गेथीत ईत्‌तर रेचवीन मने वगे करवा नी तीयारी करली से।” <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />मे तमने ह़ाचलीन केम, “आखी कळी मे जां-जां खुस-खबर नु परच्‌यार हयहे, तां-तां माणहु आना आहया काम ने बी फोम करीन नामल्‌हे।”<verse eid="MRK 14:9" /></para>
  <para style="s">यहुदो ईसु ने धराव्‌वा तीयार हये</para>
  <para style="r">(<ref loc="MAT 26:14-16">मत्‌ती 26:14-16</ref>; <ref loc="LUK 22:3-6">लुका 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />तत्‌यार यहुदा ईस्‌करीयोती जे ईसु ना बारे चेला मेनो एक हतो, आहयोत चेलो मंदीर ना डायला पुंजारान्‌तां जीन केदो के “मे ईसु ने धराव्‌वा मे तमारो सात देही।” <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />ता तीहया तीनी वात ह़मळीन घण-जबर खुस हय ज्‌या, अने तीने आनी बदले पय्‌हा आपवा करीन वायदो कर देदा। अने तीहया ईसु ने धोको दीन धराव्‌वा नो मोखो ह़ोदवा बाज ज्‌या।<verse eid="MRK 14:11" /></para>
  <para style="s">ईसु अने चेला फसह तीवार नी तीयारी</para>
  <para style="r">(<ref loc="MAT 26:17-25">मत्‌ती 26:17-25</ref>; <ref loc="LUK 22:7-14">लुका 22:7-14</ref>,<ref loc="LUK 22:21-23">21-23</ref>; <ref loc="JHN 13:21-30">युहन्‌ना 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />खमीर वगर रोट्‌ला बणाव्‌वा नो तीवार ना पेल्‌ना दाड़े, ते दाड़े तीहया फसह ना तीवार नु गाडरु मारीन बादा चड़ावता हता, ता ईसु ना चेला ईसु ने पुछ्‌या, “तु अमारी ह़ाते फसह तीवार नु खाणु कां ह़ारीक खावा हय र्‌यो, तां ह़ारीक आमु जीया अने फसह तीवार खावा नी तीयारी करीया?”<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />ता ईसु तीहया चेला मेना बे जणा ने आहयु कीन मोकल्‌यो, “ह़ेर मे जावो, अने एक माणेह वटळा मे पाणी भरीन जत्‌लु तमने भेटहे, तीनी ह़ाते जजो।” <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />अने तीहयो जे बी घोर मे जाय, ते घोर ना मालीक ने केजो; “मास्‌तर ईसम पुछ र्‌यो, पोरणा ने खवाड़वा नो कोपरो कां से, तां ह़ारीक मे मारा चेला ह़ाते वण-खमीर रोट्‌ला नो फसह तीवार वाळीन खाणु खाम?” <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />तीहयो तमने घोर नी बीजी मंजली पोर, वारु जमाड़ीन अने आथरीन तीयार करलो एक मोट्‌लो कोपरो देखाड़हे। तां तमु आपणी जुगु खावा नु तीयार करजो।<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />अने तीहया बे चेला ह़ेर मे ज्‌या, अने जीसम तीहयो तीमने केदलो हतो, तेम ने तेम तीमने जड़्‌यु, अने तीहया फसह तीवार नु खाणु तीयार कर्‌या।<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />जत्‌यार ह़ांतु हय ज्‌यु, ता ईसु बारे नेवताळा नी भेळतो तां ह़ारीक ज्‌यो।<verse eid="MRK 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 14:18" />अने जत्‌यार तीहया खावा बाज रेला, ता ईसु आह़फा ना बारे नेवताळा ने केदो, “मे तमने ह़ाचलीन केम, तमारी माय्‌न एक जणो, जे मार ह़ाते खावा बाज र्‌यो, तीहयो मने धरावहे।”<note caller="+" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="PSA 41:9">भजन सहीता 41:9</ref>; <ref loc="MAT 26:23">मत्‌ती 26:23</ref>; <ref loc="LUK 22:21">लुका 22:21</ref>; <ref loc="JHN 13:18">युहन्‌ना 13:18</ref></char></note><verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />अने तीहया आखा ह़ोह़वाय ज्‌या अने एक-एक जणो, “मे नी हय, कनी?” करीन केवा बाज ज्‌या।<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />तीहयो तीमने केदो, “बारे जणा मे गेथो एक जणो से, जे मारी ह़ाते एकीत थाळी मे गेथो हेड़ीन खावा बाज र्‌यो, <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />जीसम तीना बारा मे लीखलु से, मे मनख्‌या नो सोराम ने मरवुत से; पण तीहया अदमी जुगु घणी दुख नी वात से, मनख्‌या ना सोरा ने धरावहे। तीहयो पयदा नी हयतो, ता तीहया अदमी जुगु वारु रेतु।”<verse eid="MRK 14:21" /></para>
  <para style="s">भगवान नु चोखलु खाणु</para>
  <para style="r">(<ref loc="MAT 26:26-30">मत्‌ती 26:26-30</ref>; <ref loc="LUK 22:14-20">लुका 22:14-20</ref>; <ref loc="1CO 11:23-25">1 कुरन्‌थी 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />जत्‌यार तीहया खावा बाज रेला, ता ईसु हात मे रोट्‌लो धर्‌यो, अने रोट्‌ला जुगु भगवान ने, तु घणो वारु से कीन रोट्‌लो भागीन आह़फा ना चेला ने आपतो जीन केदो, “लेवो, आहयो रोट्‌लो खावो, आहयो रोट्‌लो मारु डील से।”<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />आहयी रीते रोट्‌लो खायलीन ईसु अंगुर नो रोह भरला पीयाला जुगु भगवान ने तु घणो वारु से कीन चेला ने आप्‌यो अने तीहया आखा तीनी मे गेथो पीदा। <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />आहयु तीहयो तीमने केदो, “आहयो अंगुर नो रोह नो पीयालो, मारा लोय मे बोली करला नवला वायदा नी सेलाणी से, आहयु लोय मे तमारी जुगु वयाड़वा वाळो से।”<note caller="+" style="x"><char style="xo" closed="false">14:24 </char><char style="xt" closed="false"><ref loc="EXO 24:8">नीरगमन 24:8</ref>; <ref loc="JER 31:31-34">यीरम्‌या 31:31-34</ref></char></note> <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />मे तमने ह़ाचलीन केम, “मे अंगुर नो रोह तीहया दाड़े लग कदी नी पीम जत्‌यार लग भगवान ना राज मे नवलो अंगुर नो रोह नी पी लेम।”<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />अळतेण तीहया भगवान नो भजन गावीन जेतुन नाम ना बड़े जवा बाज ज्‌या।<verse eid="MRK 14:26" /></para>
  <para style="s">पतरस ईसु नो नीकारो करे</para>
  <para style="r">(<ref loc="MAT 26:31-35">मत्‌ती 26:31-35</ref>; <ref loc="LUK 22:31-34">लुका 22:31-34</ref>; <ref loc="JHN 13:36-38">युहन्‌ना 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />तत्‌यार वाट्‌ये ईसु तीमने केदो, “तमु आखा मने सोड़ीन वीरखी जहु, काहाके लीखलु से: ‘मे गुवाळ्‌या ने मार नाखही, अने गाडरा रीवण्‌या-तीवण्‌या हय जहे।’<note caller="+" style="x"><char style="xo" closed="false">14:27 </char><char style="xt" closed="false"><ref loc="ZEC 13:7">जकर्‌याह 13:7</ref></char></note> <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" /><note caller="+" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्‌ती 28:16</ref></char></note>पण मे जीवतो हय्‌न अळतेण तमारी गेथो पेले गलील जीला मे जही।”<note caller="+" style="x"><char style="xo" closed="false">14:28 </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्‌ती 28:16</ref></char></note><verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />पतरस ईसु ने केदो, “आखा तने सोड़ीन भले वीरखाय जाय ता वीरखाय जाय, पण मे कदी नी वीरखायु।”<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />ईसु पतरस ने केदो, “मे तने ह़ाचलीन केम, तु आज राते बे कावा कुकड़ा वाहवा ना पेले, तीन कावा मारो नीकारो करही।”<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />पण पतरस अळी हीमम्‌त करीन केदो, “तारी ह़ाते मने मरवा बी पड़े, ते बी मे तारो नीकारो कदी नी करु।” अने बीजा आखा चेला एमेत हीमम्‌त करीन केदा।<verse eid="MRK 14:31" /></para>
  <para style="s">गतसमनी मे ईसु नी वीन्‌ती</para>
  <para style="r">(<ref loc="MAT 26:36-46">मत्‌ती 26:36-46</ref>; <ref loc="LUK 22:39-46">लुका 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />अळतेण तीहया जेतुन बड़ी पोर गतसमनी नाम नी एक वाड़ी मे पुग ज्‌या, अने तीहयो आह़फा ना चेला ने केदो, “मे वीन्‌ती करीन आवु, तत्‌यार लग तमु आञेत बहजो।” <verse eid="MRK 14:32" /><verse number="33" style="v" sid="MRK 14:33" />अने तीहयो पतरस ने, अने याकुब ने अने युहन्‌ना ने अगो ली ज्‌यो, अने तां जाय्‌न तीहयो घणो दुखी हय्‌न घबरावा बाज ज्‌यो। <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />अने तीहयो तीमने केदो, मारु मन घणु दुखी से; एतरे मारो जीव नीकळवात हींडे, एतरे तमु आञेत रेवो, अने चेतीन रीन जागला रेवो।<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />अने तीहयो जरीक अगो ज्‌यो, अने आह़फोत अगमुह्‌या पड़ ज्‌यो अने कदीम हय सके ता आहयी दुख नी टेम मारी पोर गेथी सेटी हय जवा जोवे करीन तीहयो आहयी वीन्‌ती करवा बाज ज्‌यो, <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />“ओ डायला बाह! ओ बाह! तारी सी आखु कंय हय जाय; एतरे आहया दुख ना पीयाला ने मारीन्‌तां गेथो सेटो कर ले: ते बी मारी मरजीन अनसारे नी पण तारी मरजीन अनसारे हयवा दे।”<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />अळतेण ईसु तीहया तीन चेलान्‌तां पासो ज्‌यो, अने तीमने ह़ुवत्‌ला देखीन सीमोन पतरस ने केदो; “ए सीमोन, तु ह़ुव्‌वा बाज र्‌यो ह़ु? तने जरीक वार लग नी जगायु ह़ु? <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />जीव ते तीयार से, पण डील ते कमजोर से। एतरे तमु पारख मे नी पड़वा जोवे करीन जागता रीन वीन्‌ती करता रेवो।”<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />अने तीहयो एखलो पासो जत र्‌यो, अने तीहयीत वात कीन वीन्‌ती कर्‌यो। <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />अने अळी पासो जीन तीहयो तीन जणा ने ह़ुवत्‌ला देख्‌यो। तीहया ते घणा नींदराळा हता, अने ईसु ने ह़ु केवा अने ह़ु नी? तीहयी वात तीमने ह़मज मे नी आयी।<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />अळी तीसरी कावा बी ईसु पासो तीमनी ह़ाते ज्‌यो, ता ईसु तीमने केदो, “हाव ह़ुवता रेवो अने थाको पीता रेवो बस हेतरुत, हमणे टेम आय जेली से, देखो मे मनख्‌यान सोरो पापी माणहु ना हात मे धराय जही। <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />उठो, आपणु जता, देखो मने धोको दीन बीजा ना ह़ात मे ह़ोपवा वाळो ह़ातेत आय र्‌यो।”<verse eid="MRK 14:42" /></para>
  <para style="s">ईसु ने सीपायड़ा ना हात मे ह़ोपे</para>
  <para style="r">(<ref loc="MAT 26:47-56">मत्‌ती 26:47-56</ref>; <ref loc="LUK 22:47-53">लुका 22:47-53</ref>; <ref loc="JHN 18:3-12">युहन्‌ना 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />ईसु आह़फा ने धराव्‌वा वाळा ना बारा मे आहयु केवात बाज रेलो तीहयीत टेमे यहुदा ईस्‌करीयोती तीहयो बारे चेला मे गेथो एक हतो, तीनी ह़ाते ढेरेत माणहु आया, तीहया तलवार्‌या अने डींगा ली र्‌या हता। ईमने मंदीर ना डायला पुंजारा, अने युहदी-धरम ह़ीकाड़न्‌या अने पुडार्‌या मोकल्‌ला हता। <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />अने ईसु ने धराव्‌वा वाळो यहुदा तीमने आहयी सेलाणी आप्‌लो हतो के “मे जीने कुको देही तीहयोत ईसु से, तीने धरीन चेतीन रीन लीज्‌जो।”<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />तेमेत जत्‌यार तीहया तां पुग्‌या, ता यहुदा ईस्‌करीयोती ईसुन्‌तां छोटोत आवीन तीने केदो, “ए मास्‌तर” अने तीने कुको देदो। <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />अने तत्‌यारुत तीहया ईसु ने धर लेदा। <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />पण ईसु नो एक चेलो<note caller="+" style="x"><char style="xo" closed="false">14:47 </char><char style="xt" closed="false"><ref loc="JHN 18:10">युहन्‌ना 18:10</ref></char></note> तीहयो तां उबो हय र्‌यो हतो तीहयो मीयान मे गेथी तलवार नीकाळीन आखान डायला पुंजारा ना पावर्‌या ने झाटको दीन तीनो कान्‌टो तोड़ देदो। <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />ईसु तीमने केदो, “तमु मने चोट्‌टो ह़मजीन मारी भणी तलवार्‌या अने डींगा लीन आय र्‌या ह़ु? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" /><note caller="+" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">लुका 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char></note>मे ते दाड़ीन मंदीर मे तमारी ह़ाते रीन ह़ीकापण ह़ीकाड़तो हतो, तत्‌यार तमु मने नी धर्‌या,<note caller="+" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="LUK 19:47">लुका 19:47</ref>; <ref loc="LUK 21:37">21:37</ref></char></note> पण हमणे एम करीन धरवा आय र्‌या के मारा बारा मे खरला सास्‌तर मे लीखलु से, तीहयु पुरु हये तेम।”<note caller="+" style="x"><char style="xo" closed="false">14:49 </char><char style="xt" closed="false"><ref loc="ISA 53">यसाया 53</ref>; <ref loc="ZEC 13:7">जकर्‌याह 13:7</ref></char></note><verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />अने अळतेण आखा चेला ईसु ने सोड़ीन नाह पड़्‌या।<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />अने तां ह़ारीक एक जुवान्‌यो आह़फा ना डील पोर लुंगी एतरीत ओडीन ईसु पसळ-पसळ जतो हतो; अने ईसु ने लीजण्‌या माणहु तीने धर पाड़्‌या। <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />पण तीहयो लुंगी तीमना हात मे रेवा दीन नांगरलोत नाह पड़्‌यो।<note caller="+" style="x"><char style="xo" closed="false">14:52 </char><char style="xt" closed="false"><ref loc="AMO 2:16">आमोस 2:16</ref></char></note><verse eid="MRK 14:52" /></para>
  <para style="s">युहदी माणहु नी बठक मे ईसु ने लीजवा</para>
  <para style="r">(<ref loc="MAT 26:57-68">मत्‌ती 26:57-68</ref>; <ref loc="LUK 22:54-55">लुका 22:54-55</ref>,<ref loc="LUK 22:63-71">63-71</ref>; <ref loc="JHN 18:13-14">युहन्‌ना 18:13-14</ref>,<ref loc="JHN 18:19-24">19-24</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />तीहयो ईसु ने मंदीर ना आखान डायला पुंजारा तां ली ज्‌या; अने मंदीर ना बीजा डायला पुंजारा, अने पुडार्‌या, अने युहदी-धरम ह़ीकाड़न्‌या बी तां ह़ारीक भेळा हय ज्‌या। <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />पतरस सेटोत रीन तीनी पसळ-पसळ आखान डायला पुंजारा ना आंगणा मे ज्‌यो, तीहया रखवाळ्‌या पावर्‌या नी ह़ाते बहीन आक्‌ठु तापवा बाज ज्‌यो। <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />मंदीर ना डायला पुंजारा अने युहदी जाती ना आखी पंचु, ईसु ने मारवा करीन गवा-पुरावा ह़ोद्‌ता हता पण तीमने गवा-पुरावा नी जड़्‌या। <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />काहाके घणा ढेरका माणहु ईसु नी वीरोद मे झुटी गवाय देदा, पण तीमनी गवाय एक रंगी नी हती।<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />सेल्‌ली कावा जरीक बीजा माणहु उबा हय्‌न ईसु नी वीरोद मे आहयी गवाय देदा के <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" /><note caller="+" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">युहन्‌ना 2:19</ref></char></note>“आमु आहया ईसु ने केतलो ह़मळला से, माणहु ना हात वेर बणावला आहया मंदीर ने ओदार देही, अने तीन दाड़ा मे बीजो मंदीर बणाय देही, तीहयो हात वेर बणावलु नी रेय।”<note caller="+" style="x"><char style="xo" closed="false">14:58 </char><char style="xt" closed="false"><ref loc="JHN 2:19">युहन्‌ना 2:19</ref></char></note> <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />पण ते बी तीमनी गवाय एक रंगी हय्‌न भेट नी खादी<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />तत्‌यार मंदीर नो आखा नो डायलो पुंजारो वच मे उबो रीन ईसु ने पुछ्‌यो, “आहया माणहु कानी बी गवाय दी र्‌या, तीनु जपाप तु काहा नी आप्‌तो?”<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />पण ते बी ईसु होगो हय र्‌यो, अने कंय बी जपाप नी आप्‌यो आखा नो डायलो पुंजारो अळी तीने पुछ्‌यो, “तु जुगाळा भगवान नो सोरो मसी से ह़ु?”<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />ईसु केदो, “होव मेत से। अने तमु मनख्‌या ना सोरा ने आखाम जोरभर्‌या भगवान ना जमणी धेड़े बह रेलो, अने ह़रग गेथो वादळा मे आवत्‌लो देखहु।”<note caller="+" style="x"><char style="xo" closed="false">14:62 </char><char style="xt" closed="false"><ref loc="DAN 7:13">दानीयल 7:13</ref></char></note><verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />अने तत्‌यार मंदीर नो आखा नो डायलो पुंजारो लुगड़ा फाड़ीन केदो, “तमुत ईने भगवान नु नामबद्‌दी करत्‌लो ह़मळी लेदला से, एतरे हाव आमु ने अळी गवा-पुरावा नी जोवता। <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />तमारो ह़ु वीच्‌यार से।” तीहया आखा ईसु ने गुनाळ्‌ळो ठेरावीन केदा, “आने मोत नो डंड जड़वात जोवे।”<note caller="+" style="x"><char style="xo" closed="false">14:64 </char><char style="xt" closed="false"><ref loc="LEV 24:16">लेव्‌यवेवस्‌था 24:16</ref></char></note><verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />तत्‌यार तीमनी माय्‌न काना ईसु ना मोडा पोर थुप्‌या, अने तीना मोडे पाटो बांदीन, काना ढीक देवा बाज ज्‌या। अने काना तीनी हाही उडाड़ीन केवा बाज ज्‌या “भगवान भणी गेथी वात देखाड़।” अने मंदीर ना रखवाळ्‌या पावर्‌या तीने ली जाय्‌न थपड़ाट्‌या।<verse eid="MRK 14:65" /></para>
  <para style="s">पतरस ईसु नो नीकारो करे</para>
  <para style="r">(<ref loc="MAT 26:69-75">मत्‌ती 26:69-75</ref>; <ref loc="LUK 22:56-62">लुका 22:56-62</ref>; <ref loc="JHN 18:15-18">युहन्‌ना 18:15-18</ref>,<ref loc="JHN 18:25-27">25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />जत्‌यार पतरस हेटो आंगणा मे हतो, ता आखा ना डायला पुंजारा नी एक जुवानाय पावर्‌याण तीनीन्‌तां आवी। <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />अने पतरस ने तापत्‌लो देखीन तीहयी एक डीट्‌याण भाळी अने केदी, “तु बी तीहया ईसु नासरी ह़ाते रेत्‌लो।”<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />पतरस नीकारो करीन केदो, “काय जाणु, तु ह़ु की री, तीहयु मने ह़मज मे नी आवतु।” आहयु कीन तीहयो अळी झापला नी पयड़ी पोर ज्‌यो; अने कुकड़ो वाह देदो।<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />तीहयी जुवानाय पावर्‌याण पतरस ने अळी देखीन, तां उबा हय रेला माणहु ने केदी, “आहयु माणेह बी तीमनी मे गेथो एक जणो से।” <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />पण तीहयो अळी नीकारो कर देदो। जरीक वार मे तां उबा हय रेला माणहु पतरस ने केदा, “ह़ाचलीन तु तीमनी मे गेथो एक से, काहाके तु बी गलील वाळोत से।”<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />तत्‌यार पतरस भगवान नी ह़ाम खाय्‌न केवा बाज ज्‌यो, “मे तीहया माणेह ने जाणु तक नी तीना बारा मे तमु वात कर र्‌या, कदीम मे झुट मेल र्‌यो हय ता मारी पोर गरा आय पड़वा जोवे।”<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />अळतेण तत्‌यारुत बीजी कावा कुकड़ो वाह देदो; तीने तीहयी वात फोम आयी, जे वात ईसु तीने केदलो, के “बे कावा कुकड़ो वाहवा नी पेले, तु मारो नीकारो तीन कावा करही।” अने पतरस आहयी वात ने फोम करीन फुकु-फुकु रड़वा बाज ज्‌यो।<verse eid="MRK 14:72" /></para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">पीलातुस नी अगळ ईसु</para>
  <para style="r">(<ref loc="MAT 2:1-2">मत्‌ती 2:1-2</ref>; <ref loc="MAT 11:14">11:14</ref>; <ref loc="LUK 23:15">लुका 23:15</ref>; <ref loc="JHN 18:28-38">युहन्‌ना 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />ह़वारे वेगीत, मंदीर ना डायला पुंजारा नी, अने पुडार्‌या नी, युहदी-धरम ह़ीकाड़न्‌या, अने आखी पंचु नी बठक हयी, अने तीहया आखा मेळीन वीच्‌यार काड्‌या अने ईसु ने बांदीन पीलातुस ना हात मे ह़ोप देदा। <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />अने पीलातुस ईसु ने पुछ्‌यो, “तु युहदी माणहु नो राजो से ह़ु?” ईसु पीलातुस ने केदो, “तु आह़फोत की र्‌यो।”<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />मंदीर ना डायला पुंजारा तीनी पोर घणी ढेरकी वात कीन गुनो लगाड़ र्‌या हता <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />पीलातुस तीने अळी पुछ्‌यो, “आहया तारी वीरोद मे ढेरेत वात कीन गुनो लगाड़ र्‌या; तने जपाप नी आपवा हय ह़ु?”<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />पण ईसु हजु बी कंय नी जपाप आप्‌यो, एतरे पीलातुस वहराय ज्‌यो!<verse eid="MRK 15:5" /></para>
  <para style="s">ईसु ने मोत नो डंड आपे</para>
  <para style="r">(<ref loc="MAT 27:15-31">मत्‌ती 27:15-31</ref>; <ref loc="LUK 23:13-25">लुका 23:13-25</ref>; <ref loc="JHN 18:39-19:16">युहन्‌ना 18:39–19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />फसह ना तीवार ना दाड़े युहदी माणहु नी मरजीन तेम यहुद्‌या राजवाड़ा ना राज करन्‌यो एक केदड़ा ने छोड़्‌या करतो हतो। <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />बरब्‌बा नाम नो एक माणेह हतो, तीने सीपायड़ा बीजा दंगो करन्‌या हत्‌यारा नी भेळतो जेल मे कुंड देदला। <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />आखी गड़दी ना माणहु पीलातुस ने तां जीन ईसम रावण्‌या करवा बाज ज्‌या, “जीसम तु अमारी वाटु फसह तीवार ना मोखा पोर एक केदड़ा ने सोड़तो आय र्‌यो तेमेत कर।” <verse eid="MRK 15:8" /><verse number="9-10" style="v" sid="MRK 15:9-10" />पीलातुस जाणतो हतो के मंदीर ना डायला पुंजारा ईसु ने कुहराये धरावला से। एतरे पीलातुस तीमने केदो, “मे युहदी माणहु ना राजा ने सोड़ देम, ईसम तमारी मरजी से ह़ु?”<verse eid="MRK 15:9-10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />पण डायला पुंजारा, माणहु ने ईसम कीन जोर वदाड़्‌या, तमु पीलातुस ने ईसम केवो “तु अमारी वाटु बरब्‌बा ने सोड़ दे।” <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />पण आहयु ह़मळीन पीलातुस तीमने पुछ्‌यो, “ता, जीने तमु युहदी माणहु नो राजा केय, तीनु मे ह़ु करु?”<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />तीहया आड़ीन केदा, “तु हीने ते कुरुस पोर चड़ावीन खुटा ठोकाड़ीन मराय दे।”<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />पीलातुस तीमने केदो, “काहा, मराय देम, आहयो कंय गुनो करलो से?” पण तीहया अळी ज्‌योरेत आड़ीन केदा, “हीने कुरुस पोर चड़ावीन खुटा ठोकीन मराय दे।”<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />तत्‌यार पीलातुस माणहु ना मेळा ने खुस करवा करीन, बरब्‌बा ने सोड़ देदो, अने ईसु ने ह़ड़का देवाड़ीन तीने कुरुस पोर चड़ावीन खुटा ठोकाड़वा करीन आह़फा ना सीपायड़ा ना हात मे ह़ोप देदो।<verse eid="MRK 15:15" /></para>
  <para style="s">सीपायड़ा ईसु नी हाही उड़ावे</para>
  <para style="r">(<ref loc="MAT 27:27-31">मत्‌ती 27:27-31</ref>; <ref loc="JHN 19:2">युहन्‌ना 19:2</ref>,<ref loc="JHN 19:3">3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />अने सीपायड़ा ईसु ने तीहया हवेली वाळा कीला ना मोय वाळा आंगणा मे ली ज्‌या, आहया कीला ने प्‌रीटोरीयुन केय, अने तीहया सीपायड़ा आखा बीजा सीपायड़ा ने बोलाय लाया। <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />तीहया ईसु ने जामण्‌या लुगड़ा पेराया अने काटा नु मुळ्‌यु गुथीन तीना मुंडा पोर मेक देदा; <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />अने तीहया ईसु नी हाही उडाड़ीन ईसु ने केदा, “ए युहदी माणहु ना राजा, वारलो से के?” <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />अने तीहया तीना मुंडे वाहण नी ह़ोटी देवा बाज ज्‌या, अने तीनी पोर थुपवा बाज ज्‌या अने तीहया मांड्‌या वळीन ईसु ने वांदवा ना ढोंगड़ा कर्‌या। <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />ईसम करीन तीहया ईसु नी हाही उडाड़ता जीन वारु मजा ली लेदा; अने अळतेण जामण्‌या डगला नीकाळ देदा; अने तीनात डगला पेराया, अने तीने कुरुस पोर चड़ावीन खुटा ठोकीन मारवा करीन बड़े ली ज्‌या।<verse eid="MRK 15:20" /></para>
  <para style="s">ईसु ने कुरुस पोर चड़ाव्‌वा</para>
  <para style="r">(<ref loc="MAT 27:32-44">मत्‌ती 27:32-44</ref>; <ref loc="LUK 23:26-39">लुका 23:26-39</ref>; <ref loc="JHN 19:17-19">युहन्‌ना 19:17-19</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:21 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 16:13">रोमीयो 16:13</ref>
      </char>
    </note>ईसु भारलु कुरुस उचली-उचलीन थाक ज्‌यो। तीहयीत टेमे एक सीमोन नाम नो माणेह तां माय्‌न सरक्‌यो। आहया सीमोन ने सीपायड़ा जबराण धरीन ईसु नु कुरुस उचलाड़्‌या आहयो सीमोन कुरेन ह़ेर वाळो हतो अने आहयो सीकन्‌दर अने रुफुस नो<note caller="+" style="x"><char style="xo" closed="false">15:21 </char><char style="xt" closed="false"><ref loc="ROM 16:13">रोमीयो 16:13</ref></char></note> बाह हतो। <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />अने सीपायड़ा ईसु ने गुलगुता नाम ना जागा मे ली ज्‌या, तीनु मतलब से, “माणहु ना मुंडा नो जागो।” <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />तां तीहया तीने मोर्‌र नाम नी दवा भेसकायलो अंगुर नो रोह पीवाड़वा बाज ज्‌या; पण तीहयो नी पीदो। <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />अने अळतेण तीहया तीने कुरुस पोर चड़ावीन खुटा ठोक्‌या अने तीना लुगड़ा कोयने-कोयने जड़वा जोवे करीन तीहया चीट्‌ठी नाखीन देख्‌या, अने ईसम करीन तीना लुगड़ा वाट लेदा।<note caller="+" style="x"><char style="xo" closed="false">15:24 </char><char style="xt" closed="false"><ref loc="PSA 22:18">भजन सहीता 22:18</ref></char></note> <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />अने तीहया ईसु ने ह़ीराण दाड़े नव बजे कुरुस पोर चड़ावीन खुटा ठोक्‌या। <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />अने तीना वीरोद मे जे झुटो गुनो लगाड़ीन तीना बारा मे एक लाकड़ा नी पट्‌टी पोर लीखीन तीना मुंडा गेथु उपर कुरुस पोर ठोक देदा, तीहयी पट्‌टी पोर लीखलु हतु, “आहयो युहदी माणहु नो राजा से।” <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />अने तीहया ईसु ना आड़े-धेड़े बे चोट्‌टा ने बी कुरुस पोर चड़ावीन खुटा ठोक्‌या, एक तीनी जमणी धेड़े अने एक तीनी डाखरी धेड़े। <verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />ईसम करीन जे बोल खरला सास्‌तर मे लीखलु हतु तीहयु पुरु हय ज्‌यु के “तीहयो पापी ह़ाते गीणायहे।”<verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:29 </char>
      <char style="xt" closed="false">
        <ref loc="MRK 14:58">मरकुस 14:58</ref>; <ref loc="JHN 2:19">युहन्‌ना 2:19</ref></char>
    </note>अने कुरुस धेड़े माय्‌न सरकीन जवा वाळा माणहु मुंडु डोलाड़ी-डोलाड़ीन, तीनो वाक काडीन केता हता, “ओहोय लाला! भगवान ना मंदीर ने ओदारवा वाळा, अने तीन दाड़ा मे बणाव्‌वा वाळा!<note caller="+" style="x"><char style="xo" closed="false">15:29 </char><char style="xt" closed="false"><ref loc="PSA 27:7">भजन सहीता 27:7</ref>; <ref loc="PSA 109:25">109:25</ref>; <ref loc="MRK 14:58">मरकुस 14:58</ref>; <ref loc="JHN 2:9">युहन्‌ना 2:9</ref></char></note> <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />कुरुस पोर गेथो हेटो उतरीन आव, अने आह़फा ने बी बचाड़ ले।”<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />एमेत कीन मंदीर ना डायला पुंजारा, अने युहदी-धरम ह़ीकाड़न्‌या ईसु नी हाही उडाड़ता जीन एक-बीजा ने केदा, “हीय्‌यो बीजा ने बचाड़्‌यो, हाव आह़फा ने नी बचाड़ सके ह़ु? <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />हीय्‌यो ईस्‌रायल नो राजा मसी, हाव कुरुस पोर गेथो उतरीन आवे ता आपणु ईने खरो जाणीन ईनी पोर भरहो करया।” अने जे ईसु ह़ाते आड़े-धेड़े जे कुरुस पोर चड़ावीन खुटा ठोकला हता, तीहया बी तीनी हाही उडाड़ता हता।<verse eid="MRK 15:32" /></para>
  <para style="s">ईसु नु मरवु</para>
  <para style="r">(<ref loc="MAT 27:45-56">मत्‌ती 27:45-56</ref>; <ref loc="LUK 23:44-49">लुका 23:44-49</ref>; <ref loc="JHN 19:28-30">युहन्‌ना 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />अने माथे दाड़े गेथु आखा देस मे मांजणीक दाड़े लग आखी धरती पोर अंदारलु सवायलु र्‌यु। <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />मांजणीक दाड़े ईसु ज्‌योरेत आड़ीन केदो, “एली, एली, लमा सबकतनी?” ईनु मतलब से, “ए मारा भगवान, ए मारा भगवान, तु मने काहा वीहरीन सोड़ देदो?”<note caller="+" style="x"><char style="xo" closed="false">15:34 </char><char style="xt" closed="false"><ref loc="PSA 22:1">भजन सहीता 22:1</ref></char></note><verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />जे धेड़े उबा हय र्‌या हता तीमनी मेना थोड़ाक आहयु ह़मळीन केदा, “देखो आहयो ते भगवान वगे गेथी वात केण्‌या एलीया ने आड़ीन बोलाव्‌वा बाज र्‌यो।” <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />अने एक जणो दवड़ीन जाय्‌न पोतु ने बगड़ला रोह मे डुबाड़्‌यो, अने पोतु ने वाहण ना टोकरा पोर सींडे मेकीन ईसु ने चुहाड़्‌यो<note caller="+" style="x"><char style="xo" closed="false">15:36 </char><char style="xt" closed="false"><ref loc="PSA 69:21">भजन सहीता 69:21</ref></char></note> अने केदो, “हंगा, देखो, एलीया आने उतारवा आवे के नी आवे।” <verse eid="MRK 15:36" /><verse number="37" style="v" sid="MRK 15:37" />अने अळतेण ईसु ज्‌योरेत आड़्‌यो अने तीनो जीव सांड ज्‌यो।<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />अने भगवान नो मंदीर नो पड़दो<note caller="+" style="x"><char style="xo" closed="false">15:38 </char><char style="xt" closed="false"><ref loc="EXO 26:31-33">नीरगमन 26:31-33</ref></char></note> उपर गेथो हेटो लग फाटीन बे टुकड़ा हय ज्‌यो। <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />सीपायड़ा नो एक डायलो, ईसु ना कुरुस अगळ उबो हय र्‌यो हतो, जत्‌यार तीहयो ईसु ने ईसम आड़ीन मरत्‌लो देख्‌यो, ता केदो, “ह़ाचली, आहयो माणेह भगवान नो सोरो हतो।”<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:40 </char>
      <char style="xt" closed="false">
        <ref loc="LUK 8:2">लुका 8:2</ref>,<ref loc="LUK 8:3">3</ref></char>
    </note>थोड़ाक बयरा बी आहयु आखु नाम्‌बे रीन देख र्‌या हता; तीहया बयरा मे मरीयम मगदलीनी, अने नान्‌ला याकुब नी अने योसेस नी आय्‌ह़ मरीयम, अने सलोमी बी हती। <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />जत्‌यार ईसु गलील जीला मे हतो ता आहया बयरा तीनी ह़ाते जाय्‌न तीनी सेवा-चाकरी करता हता। अने तां बीजा ढेरेत बयरा बी हता, जे ईसु ह़ाते गलील जीला मे गेथा यरुसलेम मे आवला हता।<note caller="+" style="x"><char style="xo" closed="false">15:41 </char><char style="xt" closed="false"><ref loc="LUK 8:2-3">लुका 8:2-3</ref></char></note><verse eid="MRK 15:41" /></para>
  <para style="s">ईसु ने मड़ाट्‌या मे मेकीन वगे करे</para>
  <para style="r">(<ref loc="MAT 27:57-61">मत्‌ती 27:57-61</ref>; <ref loc="LUK 23:50-56">लुका 23:50-56</ref>; <ref loc="JHN 19:38-42">युहन्‌ना 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 15:42" />आहयो दाड़ो अराम ना दाड़े गेथो पेले वाळो दाड़ो हतो, जे दाड़ो तीयारी नो दाड़ो केवायतो हतो, अने ह़ांतु हय जेलु हतु। <verse eid="MRK 15:42" /><verse number="43" style="v" sid="MRK 15:43" />अरीमीतीया ह़ेर मे रेवा वाळो युसुफ नाम नो एक माणेह हतो, अने आहयो युहदी जाती ना पंचु नो नामह़ाद्‌यो मेहमर हतो, अने आहयो भगवान ना राज नी वाट जोवतो हतो; आहयो युसुफ हीमम्‌त करीन पीलातुस ने तां ज्‌यो अने ईसु नो धोड़ मांग्‌यो। <verse eid="MRK 15:43" /><verse number="44" style="v" sid="MRK 15:44" />युसुफ नी आहयी वात ह़मळीन, पीलातुस वहराय ज्‌यो के ईसु एतरो छोटो कीसम मर ज्‌यो एतरे तीहयो सीपायड़ा ना डायला ने बोलावीन पुछ्‌यो, “ईसु मरलो ढेरेत टेम हय ज्‌यी ह़ु?” <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />अने पीलातुस सीपायड़ा ना डायला नी लारे ईसु ना बारा मे आखी वात जाण लेदो ता तीनो धोड़ युसुफ ने अपाड़ देदो। <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />तत्‌यार युसुफ लेफड़लु कफन नु लुगड़ु वेचातु लेदो, अने धोड़ ने उतारीन तीहया लुगड़ा मे बांद लेदो, अने एक मड़ाट्‌या मे मेक देदो, जे चाफर्‌या मे खोदलो हतो। अने मड़ाट्‌या ना झापला पोर एक मोट्‌लो दगड़ो ढबळाय देदा। <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />अने मरीयम मगदलीनी अने योसेस नी आय्‌ह मरीयम ईसु ना धोड़ ने मेलत्‌ला देख री हती।<verse eid="MRK 15:47" /></para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">ईसु मर्‌या-ह़र्‌या मे गेथो जीवतो हये</para>
  <para style="r">(<ref loc="MAT 28:1-8">मत्‌ती 28:1-8</ref>; <ref loc="LUK 24:1-12">लुका 24:1-12</ref>; <ref loc="JHN 20:1-10">युहन्‌ना 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />अने अराम नो दाड़ो खत्‌तम हय ज्‌यो, अने ह़ांती टेमे मरीयम मगदलीनी, सलोमी, अने याकुब नी आय्‌ह मरीयम, गंदाण्‌यो मसालो ईसु ना धोड़ पोर चोपड़वा करीन वेचातो लेदी। <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />अने ह़वारे वेगात, हप्‌ता ना पेल्‌ना दाड़े, आहया बयरा दाहड़ु उगतेत मड़ाट्‌यान्‌तां ज्‌या। <verse eid="MRK 16:2" /><verse number="3" style="v" sid="MRK 16:3" />अने बयरा आहयी वात केता-केता जता हता, “के अमारी वाटु मड़ाट्‌या ना झापला पोर लगाड़लो मोट्‌लो दगड़ो कोय ढबळावीन सेटो करहे?” <verse eid="MRK 16:3" /><verse number="4" style="v" sid="MRK 16:4" />जत्‌यार तीहया मड़ाट्‌यान्‌तां पुग्‌या ता तीहया घण मोटा दगड़ा ने मड़ाट्‌या ना झापला पोर गेथो सेटो ढबळाय मेकलो देख्‌या! <verse eid="MRK 16:4" /><verse number="5" style="v" sid="MRK 16:5" />अने जत्‌यार तीहया मड़ाट्‌या मे ज्‌या, ता तीहया ह़रगदुत ने धोळ्‌ळा लुगड़ा मे जुवान्‌या माणेह नी तेम जमणी धेड़े बह रेलो देख्‌या। अने तीहया बीही ज्‌या!<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />तीहयो तीमने केदो; बीहो ना, तमु ते नासरत वाळा ईसु ने ह़ोदवा बाज र्‌या, जीने कुरुस पोर चड़ावला हता! तीहयो पासो जीवतो हय जेलो से; तीहयो आञे नी हय; देखो, तीहयो आहयो जागो से, जां ह़ारीक तीने वगे करला हता। <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" /><note caller="+" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">मत्‌ती 26:32</ref>; <ref loc="MRK 14:28">मरकुस 14:28</ref></char></note>पण तमु हाव जावो अने पतरस ने अने ईसु ना बीजा चेला ने केवो, के तीहयो ईसु तमारी गेथो पेले गलील जीला मे जहे; जीसम तीहयो तमने केदलो हतो, “तीहयो तमने गलील जीला मे भेटहे।”<note caller="+" style="x"><char style="xo" closed="false">16:7 </char><char style="xt" closed="false"><ref loc="MAT 26:32">मत्‌ती 26:32</ref>; <ref loc="MRK 14:28">मरकुस 14:28</ref></char></note><verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />आहयु आखु देखीन अने ह़मळीन, तीहया बयरा घण-जबर बीही ज्‌या, अने तीहया कापता अने घबरायता जीन मड़ाट्‌या मे गेथा नाह ज्‌या, अने वाट्‌ये कोयने कंय नी केदा।<verse eid="MRK 16:8" /></para>
  <para style="s">ईसु मरीयम मगदल्‌नी ने देखाव पड़े</para>
  <para style="r">(<ref loc="MAT 28:9-10">मत्‌ती 28:9-10</ref>; <ref loc="JHN 20:11-18">युहन्‌ना 20:11-18</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 16:9" />हप्‌ता ना पेल्‌ना दाड़े ह़वारे वेगोत ईसु जीवतो हय्‌न मरीयम मगदलीनी ने देखाव पड़्‌यो जीनी मे गेथो तीहयो ह़ात भुत नीकाळ्‌ळो हतो। <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />हाव ईसु ना चेला वीखा मे हय्‌न रड़वा बाज र्‌या हता। तीहयीत टेमे मरीयम मगदल्‌नी तीमनीन्‌ता जीन ईसु जीवतो हय ज्‌यो करीन केदी; <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />पण ईसु जीवत्‌लो से अने तीहयी तीने देखली से, ईसम ह़मळीन बी तीहया भरहो नी कर्‌या।<verse eid="MRK 16:11" /></para>
  <para style="s">ईसु बे चेला ने देखाव पड़े</para>
  <para style="r">(<ref loc="LUK 24:13-35">लुका 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />अळतेण तीहया चेला मेना बे जणा गाम भणी जवा बाज रेला, तत्‌यार ईसु आह़फा नो वेह़ बदलीन तीमने देखाव पड़्‌यो। <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />तीहया बे जणा बीजा चेला ने आहयी वात नी खबर कर्‌या। पण ते बी बीजा, तीमनी वात पोर बी भरहो नी कर्‌या।<verse eid="MRK 16:13" /></para>
  <para style="s">ईसु ग्‌यारे चेला ने देखाव पड़े</para>
  <para style="r">(<ref loc="MAT 28:16-20">मत्‌ती 28:16-20</ref>; <ref loc="LUK 24:36-49">लुका 24:36-49</ref>; <ref loc="JHN 20:19-23">युहन्‌ना 20:19-23</ref>; <ref loc="ACT 1:6-8">नेवताळा ना काम 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />अळतेण जत्‌यार तीहया ग्‌यारे नेवताळा खाणु खावा बाज रेला ता ईसु तीमने बी देखाव पड़्‌यो, अने ईसु तीमनो वण-भरहो अने मन नी ठटाय देखीन वडतो जाय्‌न केदो, “जे मने जीवतो हय्‌न बठो हयलो देखला, तमु तीमनी वात पोर भरहो काहा नी कर्‌या?” <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" /><note caller="+" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">नेवताळा ना काम 1:8</ref></char></note>तत्‌यार ईसु तीमने हुकम आपीन केदो, “तमु आखी कळी मे जाय्‌न, आखा माणहु ने बमदीन खुस-खबर ह़मळावो।<note caller="+" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="ACT 1:8">नेवताळा ना काम 1:8</ref></char></note> <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />जे भरहो करहे अने बपतीस्‌मा नी रीती लेहे तीने पाप ना डंड मे गेथो छुटकारो जड़हे। पण जे भरहो नी करे, तीने भगवान गुनाळ्‌ळो ठेरावीन डंड आपहे। <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />जे मारी पोर भरहो करहे, तीमनी लारे ढेरेत जुदा-काम नी आहयी सेलाणी देखाव पड़हे: तीहया मारा नामे भुतड़ा काडहे, नवली-नवली बोली बोलह़े, <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />कदीम तीहया गड़हा ने उचली लेहे, नीता तीहया भुल सी जेहेर बी पी लेहे, ते बी तीमने कंय बी नुकसान नी हये। तीहया मांदला पोर हात मेकहे अने तीहया वारु हयहे।”<verse eid="MRK 16:18" /></para>
  <para style="s">ईसु नु ह़रग मे उचलायणु</para>
  <para style="r">(<ref loc="LUK 24:50-53">लुका 24:50-53</ref>; <ref loc="ACT 1:9-11">नेवताळा ना काम 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 1:9-11">नेवताळा ना काम 1:9-11</ref>
      </char>
    </note>ईसम करीन मालीक ईसु तीमनी ह़ाते वात कर लेदो, अने अळतेण तीहयो ह़रग मे उचलाय ज्‌यो, अने भगवान नी जमणी धेड़े जाय्‌न बह ज्‌यो।<note caller="+" style="x"><char style="xo" closed="false">16:19 </char><char style="xt" closed="false"><ref loc="ACT 1:9-11">नेवताळा ना काम 1:9-11</ref></char></note> <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />अने अळतेण ईसु ना चेला आखे जाय्‌न ईसु नु परच्‌यार कर्‌या, अने मालीक ईसु तीमनी ह़ाते काम करतो र्‌यो, अने मालीक ईसु ढेरेत जुदा-काम ना सेलाण्‌या नी लारे, आह़फा ना केदला बोल नो पुरावो देतो हतो। आमीन।<verse eid="MRK 16:20" /></para>
  <chapter eid="MRK 16" />
</usx>