<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1CO" style="id">- Paliya</book>
  <para style="h">1 कुरन्‌थी</para>
  <para style="toc3">1 कुरन्‌थी</para>
  <para style="toc2">1 कुरन्‌थी</para>
  <para style="toc1">कुरीन्‌थी ना नाम पोलुस नी पेली चीट्‌ठी</para>
  <para style="mt2">कुरन्‌थियों के नाम पोलुस की पहली पत्री</para>
  <para style="mt1">कुरीन्‌थी ना नाम पोलुस नी पेली चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">पोलुस नी आहयी चीट्‌ठी कुरीन्‌थी मे ईसु ना पयदा हयवा ना 55 साल नी अळतेण लीख्‌यो <char style="xt"><ref loc="1CO 1:1">1:1</ref></char> पोलुस कुरीन्‌थी मे रेवा वाळा माणहु ने जे बे चीट्‌ठी लीख्‌यो तीमनी माय्‌न आहयी पेली चीट्‌ठी से। पोलुस नी हेर हती के मकीदुनीया जही ता जवान पेले अने जवा नी टेमे अने आव्‌वा नी टेमे कुरीन्‌थी मे वाळा ह़ाते मळु, मकीदुनीया नी यात्‌रा नी पेले तीहयो आहयी चीट्‌ठी लीख्‌यो ता तीहयो पोलुस ईफीसुस ह़ेर मे तीनो डेरो हतो <char style="xt"><ref loc="1CO 16:5-9">16:5-9</ref> </char>।</para>
  <para style="ip">पोलुस ने कुरीन्‌थी नी मंडळी मे जे अलग-गलग वेला चाल र्‌यी हती तीना बारा मे तीने खबर जड़ी, गलत कामु नी वेला चाल र्‌यी हती तीहयी खबर नो जपाप आपवा करीन पोलुस आहयी चीट्‌ठी लीख्‌यो। कुरीन्‌थी ह़ेर छीनाळु अने गलत काम मे नामह़ाद्‌यु हतु, एतरे आहयु जरुड़ी से के एवी वेला मंडळी मे भराय ज्‌यी। आहयी पेली कुरीन्‌थी नी चीट्‌ठी मे मोंग ना बारा मे जे नामह़ाद्‌यो पाट से अने आमनी मे आखु से। <char style="xt"><ref loc="1CO 13">13</ref></char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पोलुस नु कुरीन्‌थी मे रेवा वाळा ने आवजो अने आवही की र्‌यो अने तीनी जुगु भगवान ने घणो वारु केय। <char style="ior"><ref loc="1CO 1:1-9">1:1-9</ref> </char></para>
  <para style="io1">2. जे खबर पोलुस कुरीन्‌थी मे रेवा वाळी मंडळी मे हयवा वाळा बेरजाव ना बारा मे जे खबर ह़मळ्‌यो। <char style="ior"><ref loc="1CO 1:10">1:10</ref>; <ref loc="1CO 4:21">4:21</ref></char></para>
  <para style="io1">3. गलत काम अने छीनाळा नी वेला अने एक-बीजा ने कोरट-कचवरी मे लीजवा आहयी वेला ना बारा मे जपाप आपे। <char style="ior"><ref loc="1CO 5-6">5–6</ref></char></para>
  <para style="io1">4. वेवा नी वेला मुरत्‌या पोर चड़ावो, भेळा हय्‌न भक्‌ती करवा आत्‌मा नु दान, अने मरीन पासो जीवतो हयवा। <char style="ior"><ref loc="1CO 7-15">7–15</ref></char></para>
  <para style="io1">5. वेहवार अने माणहु ना बारा मे पोलुस नु ईसु ना बारा मे ह़ला। <char style="ior"><ref loc="1CO 16">16</ref></char></para>
  <chapter number="1" style="c" sid="1CO 1" />
  <para style="s">पोलुस, वारला से के केय</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 1:1" />पोलुस नी भणी गेथा जे भगवान नी ईच्‌छा सी ईसु मसी ना नेवताळा बणवा करीन बोलाया अने भाय सोस्‌थीनेस नी भणी गेथी बी से।<verse eid="1CO 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 1:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:2 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:1">नेवताळा ना काम 18:1</ref>
      </char>
    </note>भगवान नी तीहयी मंडळी ना नामु जे कुरीन्‌थुस मे से, बाखीन तीमना नामु जे ईसु मसी मे चोखला करला से अने चोखला हयवा करीन बोलावला से; अने अळी तीमना आखा ना नामु बी जे आखी जागा मे अमारी ह़ाते अने आपणा अने तीमना मालीक ईसु मसी ना नाम सी वीन्‌ती करत्‌ला से।<verse eid="1CO 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 1:3" />अमारा बाह भगवान अने मालीक ईसु मसी नी भणी गेथी तमने दया अने सांती जड़ती रेय।<verse eid="1CO 1:3" /></para>
  <para style="s">ईसु पोर भरहो करवा सी संयबरकत</para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 1:4" />मे तमारा बारा मे आपणा भगवान ने घणो वारु से हमेसा केम, आनीन करते भगवान नी आहयी दया तमारी पोर मसी ईसु मे हयी। <verse eid="1CO 1:4" /><verse number="5" style="v" sid="1CO 1:5" />पण तमु ईसु मसी मे एक हयवा सी तमु आखी वात मे, अने आखा बोलु अने आखी अक्‌कल मे मालदार करला से, <verse eid="1CO 1:5" /><verse number="6" style="v" sid="1CO 1:6" />अने अमारी लारे देखाड़ली ईसु मसी नी गवाय, तमारी वच मे पाकी हय जी। <verse eid="1CO 1:6" /><verse number="7" style="v" sid="1CO 1:7" />आहयी दया तमने आनीन करते जड़ली से, अने तमने भगवान नी भणी गेथो जड़ला चोखला वाटा मे कानी बी कसर नी हय; जेम के तमु ईसु मसी ने उजन्‌तो हयवा नी वाट जोय र्‌या। <verse eid="1CO 1:7" /><verse number="8" style="v" sid="1CO 1:8" />अने तीहयो तमने आखरी दाड़े लग भरहा मे टेकला राखहे, के तमु ईसु मसी पासो आवहे तीहया दाड़े वण-गुनाळ्‌ळा देखाव पड़ो। <verse eid="1CO 1:8" /><verse number="9" style="v" sid="1CO 1:9" />भगवान भरहो करे एवो से जे तमने आह़फा ना सोरा आपणा मालीक ईसु मसी नी मंडळी मे बोलावलो से।<verse eid="1CO 1:9" /></para>
  <para style="s">ईसु पोर भरहो करवा वाळी मंडळी मे झगड़ा</para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 1:10" />ए भाय-बेन्‌या मे मालीक ईसु मसी ना नाम मे तमु आखा ह़ाते वीन्‌ती करु के तमु आखा मेळीन एकीत वात केवा, अने तमु आंबा-सांबा झगड़ो ना करो; पण आखा एकीत मन सी भेळा रेवो। <verse eid="1CO 1:10" /><verse number="11" style="v" sid="1CO 1:11" />ए भाय-बेन्‌या खलोय नाम ना माणहु मेना मने तमारा बारा मे केदला से के तमु झगड़ो करता आय र्‌या। <verse eid="1CO 1:11" /><verse number="12" style="v" sid="1CO 1:12" /><note caller="+" style="x"><char style="xo" closed="false">1:12 </char><char style="xt" closed="false"><ref loc="ACT 18:24">नेवताळा ना काम 18:24</ref></char></note>मारु केवा नु मतलब आहयु से के तमारी माय्‌न कानो केय के पोलुस मारो मास्‌तर से, अने बीजो केय के अपुल्‌लोस मारो मास्‌तर से, अने बीजो केय के पतरस मारो मास्‌तर से, अने कानो केय के ईसु मसी मारो मास्‌तर से। <verse eid="1CO 1:12" /><verse number="13" style="v" sid="1CO 1:13" />तमारी जुगु मसी वटाय ज्‌यो ह़ु? तमारी जुगु पोलुस ने कुरुस पोर चड़ावीन खुटा ठोक्‌ला ह़ु? के तमने पोलुस ना नाम सी पाणी नो बपतीस्‌मा जड़लो ह़ु?<verse eid="1CO 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 1:14" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:14 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:8">नेवताळा ना काम 18:8</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">नेवताळा ना काम 19:29</ref>; <ref loc="ROM 16:23">रोमीयो 16:23</ref></char>
    </note>मे भगवान ने घणो वारु से केम, के मे कीरीस्‌पुस अने गयुस ने सोड़ीन तमारी माय्‌न कोयने बी पाणी नो बपतीस्‌मा नी आप्‌यो, <verse eid="1CO 1:14" /><verse number="15" style="v" sid="1CO 1:15" />एतरे तमारी माय्‌न कानो माणेह ईसम नी केवा जोवे, के मने पोलुस ना नाम सी बपतीस्‌मा आपला से। <verse eid="1CO 1:15" /><verse number="16" style="v" sid="1CO 1:16" /><note caller="+" style="x"><char style="xo" closed="false">1:16 </char><char style="xt" closed="false"><ref loc="1CO 16:15">1 कुरन्‌थी 16:15</ref></char></note>होव, मे स्‌तीफनुस ना कुटुम ने बी बपतीस्‌मा आपलो से; ईमने सोड़ीन अळी कोयने बपतीस्‌मा नी आप्‌यो, पण ईमने एतरोत बपतीस्‌मा आपलो से। <verse eid="1CO 1:16" /><verse number="17" style="v" sid="1CO 1:17" />एतरे ईसु मसी मने बपतीस्‌मा आपवा नी, पण तीनी खुस-खबर ह़मळावा मोकल्‌लो से। आहयी खुस-खबर माणहु नी अक्‌कल सी ह़मळावा नी मोकल्‌यो, काहाके ईसु मसी नु कुरुस पोर मरनु अमथु नी हयवा जोवे।<verse eid="1CO 1:17" /></para>
  <para style="s">ईसु मसी भगवान नी सक्‌ती अने अक्‌कल से</para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 1:18" />जे माणहु भगवान गेथा अलग हय्‌न खुट र्‌या तीमनी जुगु ईसु नु कुरुस पोर मरनु गंडाय से, पण अमारी जुगु छुटकारो हात करन्‌या जुगु, भगवान नी सक्‌ती से। <verse eid="1CO 1:18" /><verse number="19" style="v" sid="1CO 1:19" />खरला सास्‌तर मे लीखलु से:</para>
  <para style="q1" vid="1CO 1:19">मे अक्‌कल वाळा नी अक्‌कल खत्‌तम कर देही;</para>
  <para style="q2" vid="1CO 1:19">अने ह़मज वाळा नी ह़मज रीकामी कर देही।<verse eid="1CO 1:19" /></para>
  <para style="m">
    <verse number="20" style="v" sid="1CO 1:20" />अक्‌कल वाळो माणेह कां से? युहदी-धरम ह़ीकाड़न्‌या कां से? अने कां से जखड़ी पड़न्‌या? भगवान आहयी कळी ना माणहु नी अक्‌कल ने रीकामी नी बणायो ह़ु?<verse eid="1CO 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 1:21" />भगवान आनीन करते आसम कर्‌यो काहाके भगवान नी अक्‌कल नी अनसारे आहयी कळी ना माणहु आह़फाम नी अक्‌कल ना लारे भगवान ने नी ओळख्‌या। ता भगवान ने आहयुत गमे के जे कुरुस नी काहणी ने माणहु अमथी ह़मजे, तीहयात कुरुस नी काहणी ने परच्‌यार करावीन तीहयी काहणी पोर भरहो करन्‌या ने छुटकारो आपे। <verse eid="1CO 1:21" /><verse number="22" style="v" sid="1CO 1:22" />युहदी माणहु ने सेलाणी जोवे, अने युनानी माणहु ने अक्‌कल जोवे। <verse eid="1CO 1:22" /><verse number="23" style="v" sid="1CO 1:23" />पण आमु ते कुरुस पोर चड़ावीन खुटा ठोकला ईसु मसी नो परच्‌यार करया। आहयो परच्‌यार युहदी माणहु जुगु ठोकर नो कारण से अने जे युहदी नी हय तीहया आड़जात्‌या माणहु जुगु गंडाय से। <verse eid="1CO 1:23" /><verse number="24" style="v" sid="1CO 1:24" />पण आखा टाळला माणहु जुगु ईसु मसी भगवान नी सक्‌ती अने अक्‌कल से भले तीहया युहदी हय, ते बी अने आड़जात्‌या हय ते बी। <verse eid="1CO 1:24" /><verse number="25" style="v" sid="1CO 1:25" />काहाके भगवान नी अक्‌कल, माणहु नी वण-अक्‌कल गेथी वदु अक्‌कल वाळी से, अने भगवान नी लुलखाय, माणहु नी ताखत गेथी वदु जोरभराय से।<verse eid="1CO 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 1:26" />ए भायु, अने बेन्‌या जरीक सोचो, जत्‌यार भगवान तमने बोलायो ता तमारी मे ढेरेत जणा आहयी कळी ना माणहु नी नींगा मे अक्‌कल वाळा अने सक्‌ती वाळा नी हता; अने मोटा घोराणा ना नी हता। <verse eid="1CO 1:26" /><verse number="27" style="v" sid="1CO 1:27" />पण भगवान आहयी कळी ना गांडा ने टाळ लेदो के अक्‌कल वाळा ने लजवाड़ देय, अने लुल्‌ला माणहु ने टाळ लेदो, के सक्‌ती वाळा माणहु ने लजवाड़ देय। <verse eid="1CO 1:27" /><verse number="28" style="v" sid="1CO 1:28" />भगवान आहयी कळी मे तीमने टाळ्‌यो जे हेटा हता, अने तीमनी सी माणहु ह़ीगी करता हता, अने तीमने टाळ्‌यो जे हंजु लग पयदा बी नी हया हता, आहयी कळी मे जे पेले पयदा हय जेला हता तीमने रीकामा करवा करीन तीमने टाळ्‌यो। <verse eid="1CO 1:28" /><verse number="29" style="v" sid="1CO 1:29" />के भगवान अगळ काना बी माणहु मोटाय नी करवा जोवे। <verse eid="1CO 1:29" /><verse number="30" style="v" sid="1CO 1:30" />पण भगवान आपणु ने ईसु मसी मे एक हयवा करीन बोलावलो से, ईसु मसीत भगवान वगे गेथी अक्‌कल आपण्‌यो धरमी बणावण्‌यो‍, चोखला बणावण्‌यो, अने छुटकारो आपण्‌यो से। <verse eid="1CO 1:30" /><verse number="31" style="v" sid="1CO 1:31" />अने जीसम चोखली सास्‌तर मे लीख्‌लु से: “जे कोय बी मोटाय करवा हींडे, ता मालीक ईसु मे मोटाय करवा जोवे।”<verse eid="1CO 1:31" /></para>
  <chapter eid="1CO 1" />
  <chapter number="2" style="c" sid="1CO 2" />
  <para style="s">कुरुस पोर चड़ावीन खुटा ठोकला मसी नी खुस-खबर</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 2:1" />ए भाय-बेन्‌या जत्‌यार मे भगवान नी ह़तायली वात ने ह़मळावतो जाय्‌न, तमारीन्‌तां आयो ता आहयु बोलीन अने माणहु नी अक्‌कल भराय वात देखाड़ीन नी आयो। <verse eid="1CO 2:1" /><verse number="2" style="v" sid="1CO 2:2" />काहाके मे ह़ाचलीन आहयु ठान लेदलो के मे तमारीन्‌तां रीन ईसु मसी नी अने तीने कुरुस पोर चड़ावीन खुटा ठोकवा ना बारा मे एतरोत अने आहयी वात ने सोड़ीन कानी वात नी जाणु। <verse eid="1CO 2:2" /><verse number="3" style="v" sid="1CO 2:3" /><note caller="+" style="x"><char style="xo" closed="false">2:3 </char><char style="xt" closed="false"><ref loc="ACT 18:9">नेवताळा ना काम 18:9</ref></char></note>एतरे मे घण नीरहा मन सी अने बीहीन घबरायतो जाय्‌न तमारीन्‌तां आयो। <verse eid="1CO 2:3" /><verse number="4" style="v" sid="1CO 2:4" />मारा बोलु अने भगवान नी वात ना परच्‌यार मे मनवे एवी वात नी हती, पण तीमनी मे भगवान नी आत्‌मा नी सक्‌ती नी सेलाणी हती। <verse eid="1CO 2:4" /><verse number="5" style="v" sid="1CO 2:5" />आनीन करीन के तमारो भरहो माणहु नी अक्‌कल पोर नी, पण भगवान नी सक्‌ती पोर टेकलो रेवा जोवे।<verse eid="1CO 2:5" /></para>
  <para style="s">भगवान नी अक्‌कल</para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 2:6" />जे बी आत्‌मा मे ह़मजदार से, तीमने आमु अक्‌कल नी वात ह़मळावया: पण आहयी कळी नी वात अने आहयी कळी मे राज करन्‌या मुख्‌या माणहु नी वात नी हय, काहाके आहया ते खत्‌तम हय जवा वाळा से। <verse eid="1CO 2:6" /><verse number="7" style="v" sid="1CO 2:7" />पण आमु ते भगवान नी ह़तायली अक्‌कल अने जे हंजु लग उजन्‌ती नी हयी, तीने उजन्‌ती करया, भगवान आहयी अक्‌कल ने आपणी बड़ाय करवा करीन आहयी कळी नी बणीन पेले गेथोत मेल र्‌यो हतो। <verse eid="1CO 2:7" /><verse number="8" style="v" sid="1CO 2:8" />आहयी कळी ना राज करन्‌या मेना कोय बी आहयी अक्‌कल ने नी जाण्‌या, कदीम तीहया जाण लेता ता ह़ेक भर्‌या मालीक ने लाकड़ान बणला कुरुस पोर चड़ावीन खीळे करीन नी ठोकता। <verse eid="1CO 2:8" /><verse number="9" style="v" sid="1CO 2:9" />पण जीसम लीखलु से:</para>
  <para style="q1" vid="1CO 2:9">“जे चीज डोळा नी देख्‌या, अने कान्‌टा नी ह़मळ्‌या,</para>
  <para style="q2" vid="1CO 2:9">अने जे वात माणहु ना वीच्‌यार मे नी आवी,</para>
  <para style="q2" vid="1CO 2:9">एवी वात ने मालीक भगवान तीहया मोंग करन्‌या जुगु तीयार करलो से।”<verse eid="1CO 2:9" /></para>
  <para style="m">
    <verse number="10" style="v" sid="1CO 2:10" />पण भगवान आह़फा नी आत्‌मा नी लारे आहयी वात ने अमारी पोर उजन्‌ती करलो से, काहाके भगवान नी आत्‌मा आखी वात ने ह़ोदीन काड देय। आञे लग के भगवान नी ह़तायली वात ने बी उजन्‌ती करे। <verse eid="1CO 2:10" /><verse number="11" style="v" sid="1CO 2:11" />ईसम कोय माणेह हहे, तीहयो बीजा माणहु ना मन नी वात जाण लेतो हय? पण तीहया माणहु नी आत्‌मा एतरीत तीहया माणेह ना बारा मे जाणे जे तीनी मे से। आहयी रीते भगवान ना वीच्‌यार बी भगवान नी आत्‌मा एतरीत जाणे। <verse eid="1CO 2:11" /><verse number="12" style="v" sid="1CO 2:12" />पण आमु ने आहयी कळी नी आत्‌मा नी आपलो हय, पण तीहयो चोखली आत्‌मा आपलो से। जे भगवान भणी गेथी से। आहयी चोखली आत्‌मा सी आपणु तीहयी वात ने जाण सकया, जे भगवान आपणु ने आपलो से।<verse eid="1CO 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 2:13" />आहयी वात ने आमु माणहु नी अक्‌कल ना अनसारे नी, पण भगवान नी आत्‌मा नी लारे ह़ीकाड़ली वात नी अनसारे आत्‌मा नी वात ने आत्‌मा नी वात ह़ाते ह़मळावया। <verse eid="1CO 2:13" /><verse number="14" style="v" sid="1CO 2:14" />डील नी अनसारे जीव्‌वा वाळु माणेह भगवान नी आत्‌मा नी वात ने मानीन नी जीवे, काहाके आहयी वात तीने पुरी गंडाय मालम पड़े। अने आहयी वात तीने ह़मज मे नी आवे, काहाके आहयी वात आत्‌मा नी अनसारे परखाये। <verse eid="1CO 2:14" /><verse number="15" style="v" sid="1CO 2:15" />आत्‌मा नी अनसारे जीव्‌वा वाळो माणेह आखी वात ने पारखीन जाणे, पण तीहयो आह़फो बीजा नी लारे नी परखाये। <verse eid="1CO 2:15" /><verse number="16" style="v" sid="1CO 2:16" />जीसम चोखली सास्‌तर मे लीखलु से,</para>
  <para style="q1" vid="1CO 2:16">मालीक ने ह़ीकाड़वा करीन, मालीक नु मन जाण लेदो?</para>
  <para style="q2" vid="1CO 2:16">पण अमारी पांह मालीक मसी नु मन से।<verse eid="1CO 2:16" /></para>
  <chapter eid="1CO 2" />
  <chapter number="3" style="c" sid="1CO 3" />
  <para style="s">भगवान नो चाकर्‌यो अने</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 3:1" />ए भायु-बेन्‌या, मे तमारी ह़ाते वात नी कर सक्‌यो, जीसम आत्‌मा नी अनसारे चालवा वाळा माणहु ह़ाते वात करु। पण मने तमारी ह़ाते ईसम वात करवा पड़ी, जीसम आहयी कळी ना माणहु ह़ाते वात करु, मतलब जे मसी मे पक्‌का नी हया, तीमनी ह़ाते वात करु, तेमेत तमारी ह़ाते वात करवा पड़ी। <verse eid="1CO 3:1" /><verse number="2" style="v" sid="1CO 3:2" /><note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="HEB 5:12">ईब्‌रानीयो 5:12</ref>,<ref loc="HEB 5:13">13</ref></char></note>मे तमने दुद पीवाड़्‌यो, खाणु नी खवाड़्‌यो; काहाके तमु खाणु नी खाय सकता हता, अने हमणे बी नी खाय सकता। <verse eid="1CO 3:2" /><verse number="3" style="v" sid="1CO 3:3" />काहाके तमु हमणे बी डील ना अनसारे जीव र्‌या। हमणे बी तमारी मे डहवाय अने झगड़ा से, अने तमु आहयी कळी ना माणहु नी अनसारे जीव र्‌या ता तमु आहयी कळी ना माणहु नी अनसारे जीव्‌वा वाळा नी हय ह़ु? <verse eid="1CO 3:3" /><verse number="4" style="v" sid="1CO 3:4" /><note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="1CO 1:12">1 कुरन्‌थी 1:12</ref></char></note>तमारी माय्‌न कानो केय, “पोलुस मारो मास्‌तर से” अने कानो केय, “अपुल्‌लोस मारो मास्‌तर से।” एम करीन तमु आहयी कळी ना माणहु नी अनसारे जीव र्‌या?<verse eid="1CO 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 3:5" />ता तमुत केवो, अपुल्‌लोस, अने पोलुस ना बारा मे तमारु ह़ु केणु पड़े? तीहया नीस्‌ता पावर्‌या से। अने तमु अमारी लारेत ईसु पोर भरहो कर्‌या, आमु ते मालीक ह़ोपलु तीहयुत काम करला से। <verse eid="1CO 3:5" /><verse number="6" style="v" sid="1CO 3:6" /><note caller="+" style="x"><char style="xo" closed="false">3:6 </char><char style="xt" closed="false"><ref loc="ACT 18:4-11">नेवताळा ना काम 18:4-11</ref>; </char><char style="xt" closed="false"><ref loc="ACT 18:24-28">नेवताळा ना काम 18:24-28</ref></char></note>मे बीज वेरलो से, अने अपुल्‌लोस पाणी देदलो से, पण भगवान बीज ने उगाड़ीन रोपा ने वदाड़लो से? <verse eid="1CO 3:6" /><verse number="7" style="v" sid="1CO 3:7" />एतरे वेरवा वाळो बी मोटो नी हय, अने पाणी देवा वाळो बी मोटो नी हय, पण मेर ने वदाड़वा वाळो भगवान मोटो से। <verse eid="1CO 3:7" /><verse number="8" style="v" sid="1CO 3:8" />वेरवा वाळा नु अने पाणी देवा वाळा नु एक ह़रकु काम से, पण भगवान आमने जेवु काम करहे तेवीत दाड़की आपहे।<verse eid="1CO 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 3:9" />काहाके आमु भगवान ह़ाते काम करन्‌या साजल्‌या से। तमु भगवान नी मेर वाळु खेतर से। अने भगवान नो बणावलो बंगलो से। <verse eid="1CO 3:9" /><verse number="10" style="v" sid="1CO 3:10" />भगवान मने जेम दया आपलो से, तीनात अनसारे मे एक हुनर ह़ीकलो मीस्‌तरीन तेम नीव नाखलो से, पण तीहया नीव पोर भीतड़ु ते बीजा बांदे। पण आखा माणहु ने चेतीन रेवा जोवे के भीतड़ु कीसम बांदे। <verse eid="1CO 3:10" /><verse number="11" style="v" sid="1CO 3:11" />काहाके ईसु मसी नीव से। अने ईसु ने सोड़ीन बीजो कानो बी पायो नी हय। <verse eid="1CO 3:11" /><verse number="12" style="v" sid="1CO 3:12" />कदीम माणहु आहयी नीव पोर भीतड़ु बणाव्‌वा करीन मोगलो दगड़ो, नीता चांदी, नीता ह़ोनु, नीता लाकड़ु नीता चारो वापरे, <verse eid="1CO 3:12" /><verse number="13" style="v" sid="1CO 3:13" />नीयाव ना दाड़े आखु काम उजन्‌तु हय जहे, काहाके तीहयो नीयाव नो दाड़ो आखु कंय उजन्‌तु कर देहे। तीहयो नीयाव नो दाड़ो आक्‌ठु भेळ उजन्‌तो हयहे; अने तीहयु आक्‌ठु आखा ना कामु ने उजन्‌ता कर देहे। अने देखाड़ देहे के, तीमना कामु केवा से? <verse eid="1CO 3:13" /><verse number="14" style="v" sid="1CO 3:14" />कदी मे जीनु काम तीहया पाया पोर टेकलु रेहे, ता तीहयो टेकलो रेहे। अने तीने ईलाम जड़हे। <verse eid="1CO 3:14" /><verse number="15" style="v" sid="1CO 3:15" />कदी मे कोय नु काम धप जहे ता तीहयो नुकसान झेलहे; पण तीहयो आह़फो धपतो-धपतो बच जहे<verse eid="1CO 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1CO 3:16" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:16 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 6:19">1 कुरन्‌थी 6:19</ref>; <ref loc="2CO 6:16">2 कुरन्‌थी 6:16</ref></char>
    </note>तमु भगवान ना मंदीर से, अने भगवान नी आत्‌मा तमारी मे से आहयी वात तमने मालम नी हय ह़ु। <verse eid="1CO 3:16" /><verse number="17" style="v" sid="1CO 3:17" />कदीम कोय भगवान ना मंदीर ने खुटाड़ देहे, ता भगवान बी तीने खुटाड़ देहे। काहाके भगवान नो मंदीर चोखलो से अने तीहयो मंदीर तमुत से।<verse eid="1CO 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 3:18" />खुद ने धोको ना देवो। कदीम तमारी माय्‌न कानो आह़फा ने आहयी कळी मे अक्‌कल वाळो ह़मजतो हय ता आह़फा ने वण-अकल्‌यो बणाय लेय; आनीन करीन के तीहयो अक्‌कल वाळो बण जाय। <verse eid="1CO 3:18" /><verse number="19" style="v" sid="1CO 3:19" />काहाके भगवान नी नींगा मे आहयी कळी नी अक्‌कल ते वण-अक्‌कल से। जीसम खरला सास्‌तर मे लीखलु बी से, “भगवान अक्‌कल वाळा ने तीमनीत कदर मे फसाड़ देय।” <verse eid="1CO 3:19" /><verse number="20" style="v" sid="1CO 3:20" />अने भगवान मालीक ते आखा माणहु ना वीच्‌यार जाणे, तीनी नींगा मे तीहया वीच्‌यारु वादळान तेम से जे वीसळाय जाय। <verse eid="1CO 3:20" /><verse number="21" style="v" sid="1CO 3:21" />एतरे काना बी माणहु पोर मोटाय नी करवा जोवे, काहाके आहयु आखु तमारुत से; <verse eid="1CO 3:21" /><verse number="22" style="v" sid="1CO 3:22" />भले तीहयो पोलुस हय, भले तीहयो अपुल्‌लोस हय, भले तीहयो पतरस हय, भले आहयी कळ हय, भले जीवाय हय, भले मोत हय, भले आज नी टेम हय, भले आव्‌वा वाळी टेम हय आखु तमारुत से: <verse eid="1CO 3:22" /><verse number="23" style="v" sid="1CO 3:23" />अने तमु ईसु मसी ना से अने ईसु मसी भगवान नो से।<verse eid="1CO 3:23" /></para>
  <chapter eid="1CO 3" />
  <chapter number="4" style="c" sid="1CO 4" />
  <para style="s">मसी ना नेवताळा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 4:1" />माणहु आमु ने ईसु मसी ना पावर्‌या अने भगवान नी ह़तायली वात ने उजन्‌ती करन्‌या ह़मजवा जोवे। <verse eid="1CO 4:1" /><verse number="2" style="v" sid="1CO 4:2" />अने भगवान नी वात ने उजन्‌ती करन्‌या ने भरहो करे एवा रेवा जोवे। <verse eid="1CO 4:2" /><verse number="3" style="v" sid="1CO 4:3" />भले तमु मारो नीयाव करो, ते बी मने आहयी वात नी फीकर नी हय, भले कानो बी माणेह मारो नीयाव कोरट-कचवरी मे करे, ते बी मारी फीकर नी हय, काहाके मे बी मारो नीयाव नी करु। <verse eid="1CO 4:3" /><verse number="4" style="v" sid="1CO 4:4" />काहाके मारु मन मारो वाक नी काडे, ते बी मे वण-गुनाळ्‌ळो नी हय, काहाके मारो नीयाव करवा वाळो मालीक से। <verse eid="1CO 4:4" /><verse number="5" style="v" sid="1CO 4:5" />एतरे नीयाव करन्‌या मालीक ने आवता लग, कोयनो बी नीयाव ना करो: मालीक अंदारला मे ह़तायली वात ने वीजाळा मे उजन्‌ती करहे, अने माणहु नी मन नी वात ने उजन्‌ती करहे। तीहयी टेमे भगवान एकीक जणा ने तु घणो वारु से केहे।<verse eid="1CO 4:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 4:6" />ए भायु, अने बेन्‌या तमु सास्‌तर नी वात ने टाळीन एक जणा नी वगे वळीन, अने बीजा नो वीरोद करीन मोटाय नी करवा जोवे, करीन मे आपणी अने अपुल्‌लोस नी वात कीन एक दाखलो देखाड़लो से। <verse eid="1CO 4:6" /><verse number="7" style="v" sid="1CO 4:7" />कोय केय के तु बीजा गेथो वारु से? तारी पांह तारु ह़ु से, जे तने भगवान नी आप्‌यो हय? जत्‌यार तारी पांह जे कंय से तीहयु आखु भगवान पांह गेथु जड़लु से। ता आहयी वात कीन मोटाय ह़ु करवा करे के मने ते भगवान पांह गेथु जड़्‌यु नी।<verse eid="1CO 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 4:8" />तमु आहयो वीच्‌यार कर र्‌या के जे कंय जोवतु हतु तीहयु आखु अमारी पांह से। तमु हमणे आहयो वीच्‌यार कर र्‌या के तमु मालदार हय ज्‌या। ईसम कीन तमु ते अमारी वगर राजा बण ज्‌या। घण वारु हय जतु जत्‌यार तमु ह़ाचलीन राजा बण जता। ता आमु बी तमारी ह़ाते राज करता। <verse eid="1CO 4:8" /><verse number="9" style="v" sid="1CO 4:9" />काहाके मारो वीच्‌यार से, के भगवान, आमु ने जे ईसु ना नेवताळा से, आहयी कळी मे आखा गेथा पसळ हालर मे उबा कर देदो, तीहया माणहुन तेम जीमने मोत नो डंड आपवा करीन ली जाय। काहाके आमने आखी कळी ना माणहु अने ह़रगदुत बी हाहे। <verse eid="1CO 4:9" /><verse number="10" style="v" sid="1CO 4:10" />आमु ईसु मसी नी करते वण-अकल्‌या बण ज्‌या, पण तमु मसी मे घण अक्‌कल वाळा बण ज्‌या! आमु लुला से, पण तमु ते जोर वाळा से! तमु ते अबरु वाळा से अने आमु ते वण-अबरु वाळा से। <verse eid="1CO 4:10" /><verse number="11" style="v" sid="1CO 4:11" />हजु लग आमु भुकला तरहेला से। अने पेरवा लग लुगड़ा नी हय। आमने माणहु ठोक देय, अने अमारी जुगु रेवा करीन अमारु घोर तक नी हय। <verse eid="1CO 4:11" /><verse number="12" style="v" sid="1CO 4:12" /><note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="ACT 18:3">नेवताळा ना काम 18:3</ref></char></note>आमु घण काठु काम करीया। माणहु आमने गलत केय, पण आमु बरकत आपया; तीहया आमने वेला पाड़े, पण आमु वेठता र्‌या। <verse eid="1CO 4:12" /><verse number="13" style="v" sid="1CO 4:13" />जत्‌यार अमारु नामबद्‌दी करे ता आमु वीन्‌ती कर्‌या। आमु हजु लग आहयी आखी कळी ना माणहु ना मोळ ह़रका से, अने उकड़े नु कचरुन तेवा से।<verse eid="1CO 4:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 4:14" />तमने लाजे पाड़वा करीन नी पण मोंगाळ्‌ळो सोरा ह़मजीन तमने चेतावा करीन लीख र्‌यो। <verse eid="1CO 4:14" /><verse number="15" style="v" sid="1CO 4:15" />काहाके भले तमने ह़ीकाड़वा वाळा मास्‌तर्‌या दह हजार हहे, पण तमारा बाह ते ढेरेत नी हय। काहाके ईसु मसी मे, मे तमने खुस-खबर ह़मळावीन तमारो बाह बण जेलो से। <verse eid="1CO 4:15" /><verse number="16" style="v" sid="1CO 4:16" /><note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="1CO 11:1">1 कुरन्‌थी 11:1</ref>; <ref loc="PHP 3:17">फीलीपीयो 3:17</ref></char></note>एतरे मे तमारी सी वीन्‌ती करु के तमु मारीन तेम जीवो। <verse eid="1CO 4:16" /><verse number="17" style="v" sid="1CO 4:17" />मे आनीन करते तीमुथीयुस ने तमारीन्‌तां मोकल्‌लो से के तमने आहयी फोम करावहे के ईसु मे कीसम जीवो। मसी मे तीमुथीयुस मारो मोंगाळ्‌ळो अने भरहो करे एवो सोरो बण जेलो से। जां-जां ईसु नी मंडळी से तां-तां आहयी वात ह़ीकाड़ु।<verse eid="1CO 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 4:18" />काना ते एतरी जबर मोटाय करीन की र्‌या के हीय्‌यो अमारीन्‌तां आवेत नी। <verse eid="1CO 4:18" /><verse number="19" style="v" sid="1CO 4:19" />पण कदीम मालीक नी मरजी हय, ता मे ह़ाचलीनेत तमारीन्‌तां छोटो आवही, अने मोटाय करन्‌या नी वात ने नी, पण तीमनी सक्‌ती नो पतो लगाड़ लेही। <verse eid="1CO 4:19" /><verse number="20" style="v" sid="1CO 4:20" />काहाके भगवान नु राज वात पोर एतरुत नी, पण जोर पोर टेकलु से। <verse eid="1CO 4:20" /><verse number="21" style="v" sid="1CO 4:21" />तमु केवो, के मे तमारीन्‌तां ह़ु लीन आवु? लाकड़ी लीन डंड आपवा आवु के मोंग अने नीचळे जीव सी आवु?<verse eid="1CO 4:21" /></para>
  <chapter eid="1CO 4" />
  <chapter number="5" style="c" sid="1CO 5" />
  <para style="s">ईसु नी मंडळी मे छीनाळु</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 5:1" />ह़ाचलीनेत, आहयु ह़मळवा मे आयु, के तमारी मे छीनाळु हये। अने ईसम छीनाळु ते जे भगवान ने बी नी जाणता तीहया माणहु मे बी नी हये। कानो ते आह़फा नी आय्‌ह ह़ाते लग छीनाळु करे। <verse eid="1CO 5:1" /><verse number="2" style="v" sid="1CO 5:2" />आहयी वात ने जाणीन तमने दुख बी नी लागतो, अने ईसम छीनाळु करन्‌या ने मंडळी मे गेथा नीकाळवा नो वीच्‌यार बी नी करता। अने मोटाय कर र्‌या। <verse eid="1CO 5:2" /><verse number="3" style="v" sid="1CO 5:3" />मे डील मे ते आञे से पण आत्‌मा मे तमारी वच मे हजुर से। अने ईसम छीनाळु करन्‌या नो नीयाव करीन डंड नो हुकम बी आप देदला से। <verse eid="1CO 5:3" /><verse number="4" style="v" sid="1CO 5:4" />अने जत्‌यार तमु अने मारी आत्‌मा मालीक ईसु मसी ना जोर भेळ अने तीना नाम सी भेळा हयहु, ता ईसम छीनाळु करन्‌या माणहु ने, <verse eid="1CO 5:4" /><verse number="5" style="v" sid="1CO 5:5" />तीना डील भेळ भुतड़ा ना हात मे ह़ोप देहु। ईसम करहु ता तीनु डील ते पाप भेळ खुट जहे, पण तीनी आत्‌मा मालीक ईसु ना आव्‌वा ना दाड़े छुटकारो हात करहे।<verse eid="1CO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 5:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:6 </char>
      <char style="xt" closed="false">
        <ref loc="GAL 5:9">गलातीयो 5:9</ref>
      </char>
    </note>तमारु मोटाय करवा वारु नी हय; तमु आहयो कवाड़ो ते जाणो के “जरीक खमीर आखा कोहण्‌ला लोट ने बी खमीर नी तेम खाटो कर देय।” <verse eid="1CO 5:6" /><verse number="7" style="v" sid="1CO 5:7" />जुन्‌ला खमीर ने नीकाळीन आह़फा ना जीव ने चोखो करो: आनीन करते के तमु नवला कोहण्‌ला लोट ने तेम बण जावो, काहाके आपणा फसह ना तीवार नु गाडरु ते ईसु मसी से, जे बादा ना रुप मे आह़फा ने चड़ाय देदो। <verse eid="1CO 5:7" /><verse number="8" style="v" sid="1CO 5:8" />एतरे आवो आपणु आखा फसह ना तीवार ने कुहराय अने डहवाय ना खमीर भेळ बणला रोट्‌ला नी लारे नी पण हुदा हय्‌न सच्‌चाय सी खमीर वगर ना ताबला रोट्‌ला भेळ वाळता।<verse eid="1CO 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 5:9" />मे तमने मारी चीट्‌ठी मे लीखलो से के तमु छीनाळ्‌या ह़ाते ह़ात-ह़ंगात ना राखो। <verse eid="1CO 5:9" /><verse number="10" style="v" sid="1CO 5:10" />मे ईसम नी केतो के तमु आहयी कळी ना छीनाळ्‌या, हयाळ्‌ळा, लुच्‌चा अने मुर्‌ती पुजण्‌या ह़ाते ह़ात-ह़ंगात ना राखो। काहाके ईसम तत्‌यार ते तमने आहयी कळी ने सोड़वा पड़हे। <verse eid="1CO 5:10" /><verse number="11" style="v" sid="1CO 5:11" />खास वात आहयी से के मे तमने ईसम की र्‌यो के तमु एवा माणहु ह़ाते ह़ात-ह़ंगात ना राखो, जे ईसु मसी मे तमारा भाय हय्‌न बी छीनाळु, लालच्‌यो अने मुर्‌ती पुजण्‌यो, वडवा वाळो, अने दारकुट्‌यो, बुराय करवा वाळो हय। एवा माणहु ह़ाते बहीन खाणु बी ना खावो।<verse eid="1CO 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 5:12" />जे ईसु मसी नी मंडळी मे नी हय, तीमनो नीयाव करवा नु मारु ह़ु काम? जे ईसु नी मंडळी मे से तीमनो नीयाव तमने नी करवा जोवे ह़ु? हाव, करवा जोवे। <verse eid="1CO 5:12" /><verse number="13" style="v" sid="1CO 5:13" />जे ईसु नी मंडळी मे नी हय, तीमनो नीयाव ते भगवान करहे। खरला सास्‌तर मे बी आसम लीखलु से: “पापी माणहु ने तमारी वच मे गेथा नीकाळ देवो।”<verse eid="1CO 5:13" /></para>
  <chapter eid="1CO 5" />
  <chapter number="6" style="c" sid="1CO 6" />
  <para style="s">ईसु नी मंडळी मे ह़मजोतो करवा</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 6:1" />तमु जे ईसु पोर भरहो करन्‌या से। तमारी वच मे झगड़ो हय जाय ता तमारी मे ईसम कोय से, जे नीयाव मांगवा करीन भगवान ना चोखला माणहुन तां जवा रेवा दीन, जे भरहो नी करे तीहया माणहु नी कोरट-कचवरी मे जतो हय? <verse eid="1CO 6:1" /><verse number="2" style="v" sid="1CO 6:2" />भगवान ना चोखला माणहु आखी कळी ना माणहु नो नीयाव करहे। आहयी वात तमने मालम नी हय ह़ु? तमु आखी कळी नो नीयाव करहु ता तमारी वच मे नानोह झगड़ो हय जाय ता तमने नीयाव करते नी बणे ह़ु? <verse eid="1CO 6:2" /><verse number="3" style="v" sid="1CO 6:3" />आपणु ह़रगदुत नो लग नीयाव करहु आहयी वात तमने मालम नी हय ह़ु? ता आहयी कळी मे हयवा वाळो नानोह समजोतो करते नी अवड़े ह़ु? <verse eid="1CO 6:3" /><verse number="4" style="v" sid="1CO 6:4" />तमारी वच मे कंय बी झटा-पटी हय जाय, ता तमु ईसु नी मंडळी मे गेथा नी पण बीजा ने नीयाव कराव्‌वा बहाड़हु ह़ु? तीमनो ईसु नी मंडळी मे जरीक बी जागो नी हय। <verse eid="1CO 6:4" /><verse number="5" style="v" sid="1CO 6:5" />तमने लाजे पाड़वा करीन मे आहयी वात की र्‌यो। तमारी वच मे ह़ाचलीनेत एक बी अक्‌कल वाळो भाय नी हय ह़ु, जे तमारो झगड़ो भांगे ईसम हय। <verse eid="1CO 6:5" /><verse number="6" style="v" sid="1CO 6:6" />तमारी मे भाय-भाय पोर गुनो लगाड़ीन कोरट-कचवरी मे जाय, तीहयी बी जे ईसु पोर भरहो नी करे तीमनी पांह नीयाव मांगवा जाय।<verse eid="1CO 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 6:7" />ह़ाचलीनेत, तमारो मोट्‌लो गुनो आहयो से के तमु आंबा-सांबा एक-बीजा नो वीरोद करीन पेसी लड़ र्‌या। पेसी लड़वान बदले आखी ठगड़ी वात ने वेठीन तमु नुकसान ह़ुका नी झेलता। <verse eid="1CO 6:7" /><verse number="8" style="v" sid="1CO 6:8" />पण तमु ते खुद ना भाय ने ठगीन तीनु नुकसान कर र्‌या। <verse eid="1CO 6:8" /><verse number="9" style="v" sid="1CO 6:9" />पापी माणहु भगवान ना ह़रग राज ना हकदार्‌या नी रेय, आहयी वात तमने मालम नी हय ह़ु? आह़फा ने धोको ना देवो। छीनाळु करन्‌या, मुर्‌ती पुजण्‌या, रंडी अने रंडी ने राखण्‌या, अने अदमी-अदमी सवसार करन्‌या, <verse eid="1CO 6:9" /><verse number="10" style="v" sid="1CO 6:10" />चोट्‌टा, हयाळ्‌ळा, दारकुट्‌टा, गाळ देवा वाळा, बीजा ने ठगवा वाळा माणहु भगवान ना ह़रग राज ना हकदार्‌या नी रेय। <verse eid="1CO 6:10" /><verse number="11" style="v" sid="1CO 6:11" />तमारी माय्‌न ढेरेत जणा पेले एवात हता, पण तमु मालीक ईसु मसी ना नामे, अने अमारा भगवान नी आत्‌मा सी धोवायला से, अने चोखा हय जेला से, अने वारला बण जेला से।<verse eid="1CO 6:11" /></para>
  <para style="s">आह़फा ना डील ने भगवान ना बड़ाय वाटु</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 6:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:12 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 10:23">1 कुरन्‌थी 10:23</ref>
      </char>
    </note>आखी चीज मारी वाटु ताले से, पण आखी चीज नफा नी, नी हय। आखी चीज मारी वाटु ताले से, पण मे कानी बी चीज ना हक मे नी रेम। <verse eid="1CO 6:12" /><verse number="13" style="v" sid="1CO 6:13" />खाणु पेट जुगु से, अने पेट खाणा जुगु से, पण भगवान बेम जणा ने खत्‌तम करहे। अने डील छीनाळु जुगु नी हय, पण मालीक नी चाकरी जुगु से, अने मालीक डील नी देख-भाळ करे। <verse eid="1CO 6:13" /><verse number="14" style="v" sid="1CO 6:14" />जीसम भगवान मालीक ईसु मसी ने मर्‌या-ह़र्‌या मे गेथो पासो जीवतो कर देदो, तेमेत तीहयो आपणु आखा ने मर्‌या-ह़र्‌या मे गेथो तीना जोर नी लारे जीवतो कर देहे।<verse eid="1CO 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 6:15" />तमारु डील ईसु मसी नो आंग से आहयी वात तमने मालम नी हय ह़ु? ता आहया ईसु ना आंग ने रंडी नो आंग बणाव्‌वा जोवे ह़ु? कदी नी। <verse eid="1CO 6:15" /><verse number="16" style="v" sid="1CO 6:16" />जे रंडी ह़ाते छीनाळु करे, तीहया तीनी ह़ाते एक डील बण जाय, आहयी वात तमने नी मालम हय ह़ु? काहाके लीखलु से “तीहया बेम एक डील रेहे।” <verse eid="1CO 6:16" /><verse number="17" style="v" sid="1CO 6:17" />पण जे बी मालीक ह़ाते आत्‌मा मे जोड़ाय जाय, तीहयो तीनी ह़ाते एक आत्‌मा बण जाय।<verse eid="1CO 6:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 6:18" />छीनाळु ना करो। काहाके बीजा जेतरा बी पाप से तीहया आखा डील गेथा बारा हये, पण छीनाळ्‌यो ते आह़फा डील ना वीरोद मे पाप करे। <verse eid="1CO 6:18" /><verse number="19" style="v" sid="1CO 6:19" /><note caller="+" style="x"><char style="xo" closed="false">6:19 </char><char style="xt" closed="false"><ref loc="1CO 3:16">1 कुरन्‌थी 3:16</ref>; <ref loc="2CO 6:16">2 कुरन्‌थी 6:16</ref></char></note>तमारु डील चोखली आत्‌मा नो मंदीर से, आहयी वात तमने मालम नी हय ह़ु? आहयी चोखली आत्‌मा तमु आखा ने भगवान पांह गेथी जड़ली से। <verse eid="1CO 6:19" /><verse number="20" style="v" sid="1CO 6:20" />काहाके भगवान तमारी जुगु दाम आपीन तमने वेचातो ली लेदलो से, एतरे आह़फा ना डील नी लारे भगवान नी बड़ाय उजन्‌ती करो।<verse eid="1CO 6:20" /></para>
  <chapter eid="1CO 6" />
  <chapter number="7" style="c" sid="1CO 7" />
  <para style="s">वेवा ना बारा मे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 7:1" />“अदमड़ा ने वेवा नी करवा वारु से।” आहयी वात तमु लीखीन आपला से। <verse eid="1CO 7:1" /><verse number="2" style="v" sid="1CO 7:2" />पण छीनाळा सी बचवा करीन आखा अदमड़ा नी लाडी रेवा जोवे, अने आखा बयरा नो लाडो रेवा जोवे। <verse eid="1CO 7:2" /><verse number="3" style="v" sid="1CO 7:3" />लाडा ने आह़फा नी लाडी नी हेर पुरी करवा जोवे। अने लाडी ने आह़फा ना लाडा नी हेर पुरी करवा जोवे। <verse eid="1CO 7:3" /><verse number="4" style="v" sid="1CO 7:4" />लाडा ने आह़फा ना डील पोर हक नी हय, पण लाडा ने लाडी ना डील पोर हक से; आहयी रीते लाडा ने बी आह़फा ना डील पोर हक नी हय, पण लाडी ने लाडा ना डील पोर हक से। <verse eid="1CO 7:4" /><verse number="5" style="v" sid="1CO 7:5" />तमु एक-बीजा सी अलग ना रेवो; पण थोड़ीक टेम लग एक-बीजा नी मरजी सी भगवान सी वीन्‌ती करते लग छेटा रेवो। भगवान सी वीन्‌ती करीन अळी भेळा रेवो। आसम नी हयवा जोवे के तमने नी वेठावा सी भुतड़ो तमने पारखे।<verse eid="1CO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 7:6" />मे जे की र्‌यो तीहयी छुट से हुकम नी हय, पण कदीम तमारी मरजी हय ता तमु वेवा कर सको। <verse eid="1CO 7:6" /><verse number="7" style="v" sid="1CO 7:7" />मारी मरजी ते आहयी से के आखा माणहु मारीन तेम छड़ला रेवा जोवे, पण आखा ने मारीन तेम छड़ला नी रेवाये। काहाके भगवान काना ने वेवा करीन लाडा-लाडी बणीन रेवा नो वाटो आपे, अने काना ने वेवा कर्‌या वगर छड़ला रेवा नो वाटो आपे।<verse eid="1CO 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 7:8" />मे छड़ला अने रंडायला ने केम: कदीम तीहया मारीन तेवा रेय, ता आहयु घणु वारु से। <verse eid="1CO 7:8" /><verse number="9" style="v" sid="1CO 7:9" />पण सवसार कर्‌या वगर नी रेवाये, ता तीमने वेवा कर लेवा वारु से; काहाके छीनाळु ना हयाळ्‌ळा बणवा सी वेवा कर लेवा वारु से।<verse eid="1CO 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 7:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">7:10 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:32">मत्‌ती 5:32</ref>; <ref loc="MAT 19:9">19:9</ref>; <ref loc="MRK 10:11">मरकुस 10:11</ref>,<ref loc="MRK 10:12">12</ref>; <ref loc="LUK 16:18">लुका 16:18</ref></char>
    </note>जीमना वेवा हय ज्‌या तीमने हाव मारु आहयु केणु पड़े, आहयी वात मे मारो नी पण मालीक ईसु नो हुकम से के कानी बी लाडी आह़फा ना लाडा ने नी सोड़वा जोवे। <verse eid="1CO 7:10" /><verse number="11" style="v" sid="1CO 7:11" />कदीम तीहयी आह़फी ना लाडा ने सोड़ी बी देय, ता तीने बीजो लाडो कर्‌या वगर रेवा जोवे। नीता पासी जीन आह़फी ना लाडा ह़ाते मेळ कर लेवा जोवे, एमेत कानो बी लाडो आह़फा नी लाडी ने नी सोड़वा जोवे।<verse eid="1CO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 7:12" />बीजा माणहु ने मालीक ईसु नी, पण मेत केम: कदीम भरहो करन्‌या काना भाय पांह, ईसु पोर भरहो नी करवा वाळी लाडी हय, अने तीहयी तीनी ह़ाते रेवा करीन राजी हय, ता तीहयो तीने नी सोड़वा जोवे। <verse eid="1CO 7:12" /><verse number="13" style="v" sid="1CO 7:13" />कदीम ईसु पोर भरहो करवा वाळी कानी बयर नो लाडो ईसु पोर भरहो नी करतो हय, अने तीहयो तीने राखवा करीन राजी हय, ता तीहयी ते लाडा ने नी सोड़वा जोवे। <verse eid="1CO 7:13" /><verse number="14" style="v" sid="1CO 7:14" />काहाके जे ईसु पोर भरहो नी करे तीहयो लाडो, आह़फा नी लाडी नी लारे चोखो हय जाय, अने जे लाडी ईसु पोर भरहो नी करे, तीहयी आह़फा ना लाडा नी लारे चोखी हय जाय। कदीम ईसम नी रेतु ता तमारा सोरा-सोरी वीटळ्‌ळा हयता, पण तीहया हाव वीटळ्‌ळा नी पण चोखला से। <verse eid="1CO 7:14" /><verse number="15" style="v" sid="1CO 7:15" />पण कदीम ईसु पोर भरहो नी करे तीहयो भाय नी ता बेनेह अलग हयवा हय ता अलग हय सके, आनी मे कंय बी रोको नी हय। पण भगवान आपणु ने अलग हयवा नी पण मेळीन रेवा करीन बणावलो से। <verse eid="1CO 7:15" /><verse number="16" style="v" sid="1CO 7:16" />ए लाड्‌या, तमु आहयी वात जाणो ह़ु? के कंखर माय्‌न तमु तमारा लाडा ने बचाड़ लेहु? अने ए लाडा तमु आहयी वात जाणो ह़ु, के कंखर माय्‌न तमु तमारा लाड्‌या ने बचाड़ लेहु?<verse eid="1CO 7:16" /></para>
  <para style="s">जेम से तेमेत रेवो</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 7:17" />भगवान तीने जीसम रेवा करीन टाळलो से, तीने तेमेत रेवा जोवे; अने मे आखी मंडळी मे एमेत ह़ीकाड़ु। <verse eid="1CO 7:17" /><verse number="18" style="v" sid="1CO 7:18" />जीने खतनु करलो बणावलो से, तीने खतनु करलोत रेवा जोवे: अने जे खतनु करलो नी बोलावलो से तीने खतनु करलो नी रेवा जोवे। <verse eid="1CO 7:18" /><verse number="19" style="v" sid="1CO 7:19" />खतनु कराव्‌वा सी कंय फायदो नी हय, अने नी खतनु करलो रेवा सी बी कंय फायदो नी हय, पण भगवान नो हुकम पाळवा आखु कंय से। <verse eid="1CO 7:19" /><verse number="20" style="v" sid="1CO 7:20" />जीने भगवान जीसम रेवा करीन टाळलो से, तेमेत रेवा जोवे। <verse eid="1CO 7:20" /><verse number="21" style="v" sid="1CO 7:21" />कदीम भगवान तने गुलाम चाकर्‌यो से, तीहयी टेमे बोलायो हय ता फीकर ना करे, पण मोखो जड़े ता पावराय सोड़ दे। <verse eid="1CO 7:21" /><verse number="22" style="v" sid="1CO 7:22" />काहाके मालीक नी लारे बोलाव्‌वा नी टेमे जे पावर्‌यो हतो, तीहयो भगवान नी नींगा मे गुलाम पावराय मे गेथो सुट्‌लो से। अने कदीम गुलाम पावराय मे गेथो सुट्‌लो बोलावलो हय ता तु मालीक ईसु मसी नो गुलाम पावर्‌यो से। <verse eid="1CO 7:22" /><verse number="23" style="v" sid="1CO 7:23" />भगवान तमने दाम आपीन सोड़ाय लेदलो से। एतरे माणहु ना गुलाम ना बणो। <verse eid="1CO 7:23" /><verse number="24" style="v" sid="1CO 7:24" />ए भायु अने बेन्‌या, जीसम जीव्‌वा करीन भगवान तमने टाळलो से, तेमेत तमु भगवान अगळ जीवो।<verse eid="1CO 7:24" /></para>
  <para style="s">वेवा करवा ना बारा मे राय लेवा</para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 7:25" />कुवारली ना बारा मे केवा करीन भगवान मने कंय बी हुकम नी आप्‌यो। पण ते बी भगवान नी गीण हात करलो से, अने भगवान ना भरहे तमने मार वगे गेथो केम।<verse eid="1CO 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 7:26" />मार वीच्‌यार सी हाव आहया काठला दाड़ा मे माणेह मारीन तेमेत रेवा जोवे। <verse eid="1CO 7:26" /><verse number="27" style="v" sid="1CO 7:27" />कदीम तारी लाडी हय ता तीने सोड़वान हेर ना करे; अने कदीम तारी लाडी नी हय ता लाडी बणाव्‌वा नी हेर ना करे। <verse eid="1CO 7:27" /><verse number="28" style="v" sid="1CO 7:28" />पण कदीम तु लाडी बी बणावे ता कंय पाप नी हय; अने कदीम छड़्‌ली सोरी वेवा करे ता कंय पाप नी करे; पण जे वेवा करहे तीमना डील मे दुख झेलवा पड़हे, अने मे तमने आहया दुख सी बचाड़वा हींड र्‌यो।<verse eid="1CO 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 7:29" />ए भायु, टेम थोड़ीक बच री एतरे, जीनी लाडी हय तीहयो ईसम रेवा जोवे, के तीनी लाडी नी हय। <verse eid="1CO 7:29" /><verse number="30" style="v" sid="1CO 7:30" />अने रड़वा वाळा ने ईसम रड़वा जोवे के रड़ता नी हय; अने खुसी हयवा वाळा ने ईसम खुस हयवा जोवे के खुस नी हय, अने तीहया चीज वेचातु लेता हय, तीहया ईसम रेवा जोवे के तीमनी पांह कंय नी हय। <verse eid="1CO 7:30" /><verse number="31" style="v" sid="1CO 7:31" />जे बी आहयी कळी नी चीज ने वापरे, तीहयो तीहयी चीज ने आसम ह़मजवा जोवे के आहयी चीज एक दाड़ो खत्‌तम हय जहे। काहाके आहयी कळ एक दाड़ो खत्‌तम हयवा वाळी से।<verse eid="1CO 7:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="1CO 7:32" />मारी आहयीत मरजी से के तमु बेफीकर्‌या रेवो। छड़लो माणेह आहयो वीच्‌यार करीन मालीक नी फीकर करे, के मे मालीक ने केम करीन खुस करु। <verse eid="1CO 7:32" /><verse number="33" style="v" sid="1CO 7:33" />पण वेवा करलो माणेह आहयो वीच्‌यार करीन आहयी कळी नी वात नी फीकर करे के मे मारी लाडी ने केम करीन खुस करु। <verse eid="1CO 7:33" /><verse number="34" style="v" sid="1CO 7:34" />ईसम करीन तीना वीच्‌यार वटाय जाय। अने आहयी छड़्‌ली से, तीहयी मालीक भगवान ने आसम वीच्‌यारीन फीकर करे, के मे मालीक ईसु वाटु डील मे अने जीव आत्‌मा मे चोखली रेम, पण जीनो लाडो से तीहयी आसम वीच्‌यारीन आहयी कळी नी वात नी फीकर करे के मे मारा लाडा ने केम खुस करु।<verse eid="1CO 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 7:35" />मे तमारा फायदा नी करते की र्‌यो, तमने फसाड़वा करीन नी केतो। पण जीसम तालेत हयवा जोवे करीन की र्‌यो, अने तमु एक-मन्‌या हय्‌न मालीक ईसु नी भक्‌ती पुरु मन लगाड़ीन करता रेवो।<verse eid="1CO 7:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 7:36" />कदीम कोय आहयु वीच्‌यार करे के मे मारी छड़्‌ली सोरी ना वेवा नी करावीन तीनो हक हापकी र्‌यो, ता जीसम तीनी मरजी हय तेमेत वेवा कर देवा जोवे। वेवा कराव्‌वा पाप नी हय। <verse eid="1CO 7:36" /><verse number="37" style="v" sid="1CO 7:37" />कदीम तीहयो मन मे वात ठान लेदो हय, अने काठु मन कर लेदो हय के मे छड़्‌ली सोरी सी वेवा करे वगर रेही, ता तीहयो वारु कर र्‌यो। <verse eid="1CO 7:37" /><verse number="38" style="v" sid="1CO 7:38" />एतरे जे छड़्‌ली सोरी ह़ाते वेवा कर लेय, ता तीहयो वारलु करे, अने जे तीहयी ह़ाते वेवा नी करे तीहयो अळी बी वारलुत करे।<verse eid="1CO 7:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 7:39" />जत्‌यार लग कानी बी बयर नो लाडो जीवत्‌लो रेय, तत्‌यार लग तीना जीवत्‌ला लाडा ह़ाते जोड़ायली रेय, पण कदीम तीहयो लाडो मर जाय, तत्‌यार तीहयी काना बी माणेह ह़ाते वेवा कर सके। पण मालीक ईसु ना नाता मे वेवा करवा जोवे। <verse eid="1CO 7:39" /><verse number="40" style="v" sid="1CO 7:40" />पण कदीम तीहयी वेवा कर्‌या वगर रेय, ता जादा खुस रेहे, अने मे ईसम ह़मजु के भगवान नी आत्‌मा मारी मे बी से।<verse eid="1CO 7:40" /></para>
  <chapter eid="1CO 7" />
  <chapter number="8" style="c" sid="1CO 8" />
  <para style="s">मुर्‌ती पोर चड़ावलु खाणु</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 8:1" />मुर्‌ती पोर चड़ावलु खाणु ना बारा मे तमारु ह़ु केवु पड़े: “आमु आखा अक्‌कल वाळा से” आहयी वात नो आहयो जपाप से के अक्‌कल माणहु ने मोटाय करावे। पण मोंग सी आखा नो फायदो हये। <verse eid="1CO 8:1" /><verse number="2" style="v" sid="1CO 8:2" />कानो वीच्‌यार करे के थोड़ाक जणा, जीसम जाणवा जोवे, तेम तीमने हजु लग मालम नी हय। <verse eid="1CO 8:2" /><verse number="3" style="v" sid="1CO 8:3" />पण जे कोय भगवान ने मोंग करे तीने भगवान जाणे।<verse eid="1CO 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 8:4" />एतरे मुर्‌ती पोर चड़ावलु खाणु ना बारा मे आपणु ने मालम से के आहयी कळी मे जीवत्‌ली मुर्‌ती कंखर नी हय, अने एक ने सोड़ीन कानो बी जीवत्‌लो भगवान नी हय। <verse eid="1CO 8:4" /><verse number="5" style="v" sid="1CO 8:5" />माणहु केय के ह़रग अने धरती पोर घणा जादा “देवता” से अने घणा “मालीक” से। <verse eid="1CO 8:5" /><verse number="6" style="v" sid="1CO 8:6" />पण आपणी जुगु ते एकीत भगवान से, जे अमारो बाह से। अने तीनी वगे गेथु जे से तीहयु आखु आवे। अने आपणु तीनीत जुगु जीवया। अने एकीत मालीक से अने तीहयो ईसु मसी से, जीनी लारे आखी चीज घड़ाय अने आपणु तीनीत लारे घड़ायला से।<verse eid="1CO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 8:7" />पण आखा ने आहयी वात मालम नी हय। काना ते हंजु लग मुर्‌ती ने जीवत्‌ली ह़मजी र्‌या, अने तीनी पोर चड़ावलु खाणु ने ह़ाचलीन बरकत वाळु से ह़मजीन खाय। अने तीमनो जीव कमजोर हयवा सी वीटळ जाय। <verse eid="1CO 8:7" /><verse number="8" style="v" sid="1CO 8:8" />पण मुर्‌ती पोर चड़ावली चीज ते आपणु ने भगवान ह़ाते नी ली जाय। कदीम आपणु तीहयु खाणु ने नी खाया ता आपणु कंय बी नुकसान नी हये, अने कदीम खाया, ता कंय बी फायदो नी हय।<verse eid="1CO 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1CO 8:9" />चेतीन रेवो, कंखर माय्‌न तमारो खावा नो हक, भरहा मे कमजोर माणहु ने पाप मे नी पाड़ देय। <verse eid="1CO 8:9" /><verse number="10" style="v" sid="1CO 8:10" />काहाके कदीम कानो तमारी ह़रका अक्‌कल वाळा ने मंदीर मे खाणु खातलो देख लेय, तीने तारीन तेम मंदीर मे चड़ावलु चीज ने खावा नी हीमम्‌त हय जहे? अने ईसम करीन तीहयो मुर्‌ती पोर चड़ावली चीज ने खाय्‌न पाप मे पड़ जहे। <verse eid="1CO 8:10" /><verse number="11" style="v" sid="1CO 8:11" />आहयी रीते तारी अक्‌कल नी लेदे कमजोर मन नो भाय खुट जहे, जीनी जुगु ईसु मसी मर्‌यो। <verse eid="1CO 8:11" /><verse number="12" style="v" sid="1CO 8:12" />ईसम करीन तमु भाय ना वीरोद मे पाप करो अने तीना कमजोर मन ने दुखी करीन ईसु मसी ना वीरोद मे पाप करो। <verse eid="1CO 8:12" /><verse number="13" style="v" sid="1CO 8:13" />एतरे कदीम मारु माह खाणु भाय जुगु पाप नो कारण बणे, ता मे जलम माह नी खाम।<verse eid="1CO 8:13" /></para>
  <chapter eid="1CO 8" />
  <chapter number="9" style="c" sid="1CO 9" />
  <para style="s">चेलाम नो हक अने काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 9:1" />मे सुटलो नी हय ह़ु? मे नेवताळो नी हय ह़ु? मे आपणा मालीक ईसु मसी ने नी देख्‌यो ह़ु? मे भगवान नी वात देखाड़्‌यो करीन तमु ईसु पोर भरहो नी कर्‌या ह़ु? <verse eid="1CO 9:1" /><verse number="2" style="v" sid="1CO 9:2" />भले मे बीजा जुगु ईसु नो नेवताळो नी बी हय, पण तमारी जुगु ते से। काहाके तमुत मारी जुगु मालीक ईसु ना नेवताळा नी ओळखाण से।<verse eid="1CO 9:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 9:3" />जे मने पारखवा हींडे तीमने मारु आहयु केणु पड़े। <verse eid="1CO 9:3" /><verse number="4" style="v" sid="1CO 9:4" />मने अने बरनाबास ने खावा-पीवा नो हक नी हय ह़ु? <verse eid="1CO 9:4" /><verse number="5" style="v" sid="1CO 9:5" />जीसम मालीक ईसु ना भाय अने पतरस ईसु पोर भरहो करवा वाळी लाडी ने ह़ाते लीन हींडे, तेमेत आमने बी ईसु मसी पोर भरहो करन्‌यान बेनेह ह़ाते वेवा करीन ह़ाते लीन हींडवा नो हक नी हय ह़ु? <verse eid="1CO 9:5" /><verse number="6" style="v" sid="1CO 9:6" />बरनाबास ने अने मने मेहनत करीन जीव्‌वा नो हक नी हय ह़ु? <verse eid="1CO 9:6" /><verse number="7" style="v" sid="1CO 9:7" />एवु कोय से जे दाड़की लीया वगर सीपायड़ा नु काम करे? अने ईसम कोय से जे, अंगुर नी वाड़ी लगाड़ीन बी अंगुर ना फोळ नी खाय? अने ईसम कोय से, जे गाडरा ते पाळे पण गाडरा नु दुद नी पीतो हय?<verse eid="1CO 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 9:8" />मे माणहु नी रीती ना अनसारे आहयी वात की र्‌यो ह़ु? <verse eid="1CO 9:8" /><verse number="9" style="v" sid="1CO 9:9" /><note caller="+" style="x"><char style="xo" closed="false">9:9 </char><char style="xt" closed="false"><ref loc="1TI 5:18">1 तीमुथीयुस 5:18</ref></char></note>मुसा ना लारे लीखली सास्‌तर मे लीखलु से, “खळा मे बोळद्‌या ने कंडल्‌या ना बांदो।” ह़ु भगवान बोळद्‌या नी फीकर करीन आसम की र्‌यो <verse eid="1CO 9:9" /><verse number="10" style="v" sid="1CO 9:10" />के आपणी जुगु आसम की र्‌यो? ह़ाचलीनेत! भगवान आपणी जुगु की र्‌यो, आहयु आपणा बारा मे लीखलु से। काहाके कीरसाण आह करीनेत खेतर मे काम करे, अने खळा मे अन महळवा वाळो बी आह करीन खळा मे अन महळे। <verse eid="1CO 9:10" /><verse number="11" style="v" sid="1CO 9:11" /><note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="ROM 15:27">रोमीयो 15:27</ref></char></note>तमारी आत्‌मा जुगु भगवान खुस-खबर ह़मळावीन अमारा डील जुगु कानी बी चीज मांगवा घण मोटी वात से ह़ु? <verse eid="1CO 9:11" /><verse number="12" style="v" sid="1CO 9:12" />कदीम बीजा तीमना डील जुगु कंय चीज मांगवा नो हक राखे? ता अमारो तमारी पांह जादा मांगवा नो हक नी हय ह़ु?</para>
  <para style="p" vid="1CO 9:12">पण आमु तमारी पांह मांगवा नो हक कामे नी लगाड़्‌या। पण आमु घण-जबर वेठ्‌या, आनीन करीन के मसी नी खुस-खबर आखी दुर पुगवा मे कंय बी वांदो नी आव्‌वा जोवे। <verse eid="1CO 9:12" /><verse number="13" style="v" sid="1CO 9:13" />जे भगवान ना मंदीर मे काम करे तीहया मंदीर मे चड़ावे तीहयी चीज ने नी वापरे ह़ु? अने जे वेदी नी सेवा करे तीहया वेदी पोर चड़ावली चीज ने नी वापरे ह़ु? <verse eid="1CO 9:13" /><verse number="14" style="v" sid="1CO 9:14" /><note caller="+" style="x"><char style="xo" closed="false">9:14 </char><char style="xt" closed="false"><ref loc="MAT 10:10">मत्‌ती 10:10</ref>; <ref loc="LUK 10:7">लुका 10:7</ref></char></note>आहयी रीते मालीक भगवान बी कायदो बणावलो से के खुस-खबर नु परच्‌यार करे तीहयो खुस-खबर ह़मळावीन जीवी खाहे?<verse eid="1CO 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 9:15" />पण मे आहया आखा हक मे गेथो एक बी हक वापर्‌यो नी, अने आनीन करते आहयी वात नी लीख्‌यो के मार जुगु तमु कंय ने कंय करो। भले मे मर जही पण मार जुगु कंय ना करो; आनीन करते मे कंय बी लीया वगर जे करु तीहयी वात नी मोटाय मार पांह गेथी कोय बी नी हापकवा जोवे। <verse eid="1CO 9:15" /><verse number="16" style="v" sid="1CO 9:16" />एतरे मे खुस-खबर नो परच्‌यार करु, ता आनी मे कानी बी मोटाय नी हय, काहाके मारी जुगु खुस-खबर नो परच्‌यार करवा जरुड़ी से। अने कदीम मे खुस-खबर नो परच्‌यार नी करु ता मारी जुगु घणी दुख नी वात से। <verse eid="1CO 9:16" /><verse number="17" style="v" sid="1CO 9:17" />कदीम मे मारी मरजी सी खुस-खबर नु काम करतो हय ता मने दाड़की जड़ती, पण मे मारी मरजी सी खुस-खबर ह़मळावा नु काम नी करतो, पण जे मने टाळलो से अने आहयु काम ह़ोपलो से, तीनी मरजी सी आहयु काम कर र्‌यो। <verse eid="1CO 9:17" /><verse number="18" style="v" sid="1CO 9:18" />खुस-खबर नी दाड़की लीया वगर ह़मळावात मारी दाड़की से, खुस-खबर ह़मळावा मे जे बी मारो हक से, तीहया हक ने वापर्‌या वगर परच्‌यार करवा नो मारो हक से।<verse eid="1CO 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 9:19" />भले मे कोयनो गुलाम नी हय, पण ते बी आखा ने भगवान ना राज मे लाव्‌वा करीन आखा नो गुलाम बण ज्‌यो। <verse eid="1CO 9:19" /><verse number="20" style="v" sid="1CO 9:20" />युहदी माणहु नो छुटकारो करवा करीन, मे तीमनी जुगु तीमनीन तेम बण ज्‌यो। भले मे मुसा ना कायदा ना हक मे नी हय, पण जे कायदा ना हक मे से तीमनो छुटकारो करवा करीन मे कायदा ना हक मे वाळान तेम बण ज्‌यो। <verse eid="1CO 9:20" /><verse number="21" style="v" sid="1CO 9:21" />भगवान ना कायदा नी मानवा वाळा नो छुटकारो करवा करीन मे तीमनीन तेम बण ज्‌यो, भले मे भगवान ना कायदा नी मानवा वाळा मे नो नी हय। पण ईसु मसी ना कायदा ना हक मे से। <verse eid="1CO 9:21" /><verse number="22" style="v" sid="1CO 9:22" />मे लुल्‌ला नी करते लुल्‌लो बण्‌यो, के तीने बचाड़ लेम। मे आखा माणहु नी करते आखु कंय बण्‌यो, के जीनी सी मे कानीन कानी रीते ढेरेत माणहु ने बचाड़ लेम।<verse eid="1CO 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 9:23" />बीजा माणहु ह़ाते खुस-खबर नी संयबरकत नो साजल्‌यो बणवा करीन, आहयु आखु मे खुस-खबर जुगु करु।<verse eid="1CO 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 9:24" />दवड़ीन ईलाम जीकवा ना खेल मे ईलाम जीकवा करीन आखा दवड़े; पण ईलाम एकीत जणो हात करे। तमु ईसम दवड़ो के ईलाम हात करो। <verse eid="1CO 9:24" /><verse number="25" style="v" sid="1CO 9:25" />खेल मे खेलवा वाळा ने आखा कायदा पाळीन चालवा पड़े। खेल मे ईलाम हात करन्‌यो पान्‌टान तेम चीमायवा वाळी पागड़ी हात करवा करीन ईसम करे। पण आमु ते तीहयी पागड़ी जुगु जे कदी नी चीमाये। <verse eid="1CO 9:25" /><verse number="26" style="v" sid="1CO 9:26" />आहयी रीते मे ईलाम हात करवा करीन खास ठीया नी नींगा राखीनेत दवड़ु। मे वाहळा मे अमथो ढीक नी देम। <verse eid="1CO 9:26" /><verse number="27" style="v" sid="1CO 9:27" />पण मे मारा डील ने काठी मेहनत करावीन हक मे राखु। कंखर माय्‌न ईसम नी हयवा जोवे, के मे बीजा ने वारु परच्‌यार करीन मेत रीकामो नीकळु।<verse eid="1CO 9:27" /></para>
  <chapter eid="1CO 9" />
  <chapter number="10" style="c" sid="1CO 10" />
  <para style="s">युहदी माणहु नी तेम ना बणो</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 10:1" />ए भाय-बेन्‌या मारी आहयी मरजी से, के तमु आपणा डाहा-डाहा ना बारा मे अंजाण्‌या ना बणो जे वादळा ना साहळे-साहळे चाल्‌या, अने आखा रात्‌ली दर्‌या ने वणकी ज्‌या। <verse eid="1CO 10:1" /><verse number="2" style="v" sid="1CO 10:2" />अने ईसम करीन तीहया वादळा ना साहळा मे अने दर्‌या मे बपतीस्‌मा लीन मुसा ना केवा मे चालवा वाळा बण ज्‌या। <verse eid="1CO 10:2" /><verse number="3" style="v" sid="1CO 10:3" />अने आखा एकीत आत्‌मा नु खाणु खादा। <verse eid="1CO 10:3" /><verse number="4" style="v" sid="1CO 10:4" />अने तीहया आखा आत्‌मा नु पाणी पीदा; काहाके तीहया तीमनी ह़ाते चालवा वाळी आत्‌मा ना ढाट मे गेथा पीता हता। अने तीहयी ढाट मसी हतो। <verse eid="1CO 10:4" /><verse number="5" style="v" sid="1CO 10:5" />पण तीमनी माय्‌न ढेरेत माणहु पोर भगवान खुस नी हतो, एतरे तीहया उजाड़ी जागा मे मरीन खत्‌तम हय ज्‌या।<verse eid="1CO 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1CO 10:6" />आहया आखा माणहु खराब चीज नी हाय कर्‌या, तेमेत आपणु ने हाय नी करवा जोवे, अने आहयी वात आपणी जुगु ह़ीकापण नो दाखलो बण ज्‌यो। <verse eid="1CO 10:6" /><verse number="7" style="v" sid="1CO 10:7" />तमु मुर्‌ती पुजण्‌या ना बणो, जीसम माणहु मे ढेरेत जणा बण ज्‌या। जीसम खरला सास्‌तर मे लीखलु बी से, “माणहु खावा-पीवा बह्‌या अने एक-बीजा ह़ाते गलत काम करवा बाज ज्‌या।” <verse eid="1CO 10:7" /><verse number="8" style="v" sid="1CO 10:8" />एतरे आपणु ने छीनाळु नी करवा हय; जीसम तीहया माणहु मे ढेरेत जणा छीनाळु कर्‌या: अने एकीत दाड़े तेवीस हजार माणहु मर ज्‌या। <verse eid="1CO 10:8" /><verse number="9" style="v" sid="1CO 10:9" />एतरे आपणु ने मालीक ने नी पारखवा जोवे, जीसम ढेरेत जणा भगवान ने पारख्‌या। अने तीमने गड़हा चाय देदा, अने तीहया माणहु मरीन खत्‌तम हय ज्‌या। <verse eid="1CO 10:9" /><verse number="10" style="v" sid="1CO 10:10" />तमने जलम कुर-कुर नी करवा जोवे। तीमनी माय्‌न थोड़ाक कुर-कुर कर्‌या, अने मारवा वाळो दुत आवीन तीमने मार नाख्‌यो।<verse eid="1CO 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 10:11" />अने तीमनी पोर वीतली आहयी वात आपणी जुगु ह़ीकापण नो दाखलो बण ज्‌यो। अने आपणु ने चेतीन रीन जीव्‌वा नी ह़ीकापण आपणी जुगु लीखाय जी। आपणु ते आहयी कळी ना आखरी दाड़ा मे जीव र्‌या।<verse eid="1CO 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 10:12" />जे ईसम वीच्‌यार करे के मे भरहा मे पक्‌को से, तीहयो चेतीन रेवा जोवे, नीता तीहयो कंखर माय्‌न भरहा गेथो सेटो हय जहे। <verse eid="1CO 10:12" /><verse number="13" style="v" sid="1CO 10:13" />तमु आसवी पारख मे नी पड़्‌या, जीने माणहु वेठ नी सके: भगवान भरहो करे एवो से: तीहयो तमने वेठाये नी एवी पारख मे नी पड़वा देय। अने कदीम तमु वेठाये एवी पारख मे पड़ी बी जावो, ते बी तीहयो तमने तीहयी पारख मे गेथो नीकाळ लेहे। आनीन करते के तमु तीहयी पारख ने जीक सको।<verse eid="1CO 10:13" /></para>
  <para style="s">मुर्‌ती पुजा ना बारा मे चेतावणी</para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 10:14" />आनीन करते ए मोंगाळ्‌ळा दोस्‌तीदार्‌या, मुर्‌ती पुजा सी बचीन रेवो। <verse eid="1CO 10:14" /><verse number="15" style="v" sid="1CO 10:15" />मे तमने अक्‌कल वाळा ह़मजीन की र्‌यो, जे मे की र्‌यो तीहयी वात ने पारखो। <verse eid="1CO 10:15" /><verse number="16" style="v" sid="1CO 10:16" /><note caller="+" style="x"><char style="xo" closed="false">10:16 </char><char style="xt" closed="false"><ref loc="MAT 26:26-28">मत्‌ती 26:26-28</ref>; <ref loc="MRK 14:22-24">मरकुस 14:22-24</ref>; <ref loc="LUK 22:19">लुका 22:19</ref>,<ref loc="LUK 22:20">20</ref></char></note>बरकत नो पीयालो, आपणु ने ईसु मसी ना लोय नो साजल्‌यो नी बणावे ह़ु? तीनी जुगु आपणु भगवान ने तु घणो वारु से कीया। जे रोट्‌लो आपणु तोड़या, तीहयो रोट्‌लो ईसु मसी ना डील नो साजल्‌यो नी बणावे ह़ु? तीनी जुगु आपणु भगवान ने तु घणो वारु से कीया। <verse eid="1CO 10:16" /><verse number="17" style="v" sid="1CO 10:17" />रोट्‌लो ते एकीत से; एतरे आपणु बी अलग हय्‌न बी एकीत डील से; काहाके आपणु आखा एकीत रोट्‌ला मे साजल्‌या हय्‌न तीनी मे गेथा खाया।<verse eid="1CO 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 10:18" />तीहया ईस्‌रायली माणहु ना बारा मे वीच्‌यार करो, तीहया भगवान नी वेदी पोर जानवर ने मारीन बादा चड़ावे अने तीहयु माह खाय। तीहया भगवान नी वेदी पोर चड़ावलु माह खावा वाळा, भगवान नी वेदी ना साजल्‌या नी बण्‌या ह़ु? <verse eid="1CO 10:18" /><verse number="19" style="v" sid="1CO 10:19" />भगवान नी वेदी नो दाखलो देखाड़ीन मे आहयु नी केतो के वेदीन तेवी मुर्‌ती कामकी से, अने मुर्‌ती पोर चड़ावलु चीज कामकु से। <verse eid="1CO 10:19" /><verse number="20" style="v" sid="1CO 10:20" />पण मे आहयु केवा हींड र्‌यो के भगवान ने नी जाणवा वाळा माणहु जे बी चीज चड़ावे तीहयु भगवान ने नी चड़ावे पण भुत ने चड़ावे। एतरे भुत ने चड़ावलु खाणु खाय्‌न तीमनी ह़ाते भुत ना साजल्‌या ना बणो। <verse eid="1CO 10:20" /><verse number="21" style="v" sid="1CO 10:21" />मालीक भगवान ना पीयाला मे गेथु, अने भुत ना पीयाला मे गेथु पीवा वारु नी हय। मालीक भगवान नी पंगात मे गेथु, अने भुत नी पंगात मे गेथु खाणु खावा वारु नी हय। <verse eid="1CO 10:21" /><verse number="22" style="v" sid="1CO 10:22" />आपणु मालीक ने रीहवाड़वा हींड र्‌या ह़ु? आपणु मालीक गेथा जादा ताखत वाळा से ह़ु?<verse eid="1CO 10:22" /></para>
  <para style="s">आखु कंय भगवान ना बड़ाय जुगु करो</para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 10:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">10:23 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 6:12">1 कुरन्‌थी 6:12</ref>
      </char>
    </note>थोड़ाक माणहु केय के “आखी चीज वापरवा मारी जुगु ताले ते से” पण मारी जुगु नफा नी, नी हय, “आखी चीज मारी जुगु ताले ते से” पण आखी चीज सी भरहो पक्‌को नी हये। <verse eid="1CO 10:23" /><verse number="24" style="v" sid="1CO 10:24" />खुद नी भलाय ने ना ह़ोदो, पण बीजा नी भलाय ने ह़ोदो।<verse eid="1CO 10:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1CO 10:25" />जे बी माह खाटकड़ान तां वेचाये तीहयु खावो, अने मन नी अक्‌कल नी लेदे कंय बी ना पुछो। <verse eid="1CO 10:25" /><verse number="26" style="v" sid="1CO 10:26" />काहाके चोखली सास्‌तर केय: “आहयी धरती अने जे कंय आहयी धरती पोर से, तीहयु आखु मालीक भगवान नु से।”<verse eid="1CO 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 10:27" />कदीम काना ईसु पोर भरहो नी करे, तीहया तमने बोलावे ता तीमनीन्‌तां जावो अने मन नी अक्‌कल नी लेदे कंय ना पुछो, अने पुछ्‌या वगर जे बी खवाड़े तीहयु खाय लेवो। <verse eid="1CO 10:27" /><verse number="28" style="v" sid="1CO 10:28" />पण कदीम तमने खवाड़वा वाळो ईसम केय के “आहयु मुरत्‌या पोर चड़ावलु से” ता तीहयो की र्‌यो करीन तीनी जुगु अने मन नी अक्‌कल नी लेदे तीहयु खाणु ने ना खावो। <verse eid="1CO 10:28" /><verse number="29" style="v" sid="1CO 10:29" />मारु केवा नु मतलब तारा मन नी लेदे नी पण केवा वाळा ना मन नी लेदे से। मारी खावा नी छुट बीजा ना मन नी लारे परखाय्‌वा वारु नी हय। <verse eid="1CO 10:29" /><verse number="30" style="v" sid="1CO 10:30" />कदीम मे खाणु नी करते भगवान ने घणो वारु से केम अने खाणु खावा बह जाम ता मारो वाक काडवा वारु नी हय।<verse eid="1CO 10:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="1CO 10:31" />एतरे भले तमु खावो, भले तमु पीवो अने भले कंय बी करो, पण तीहयी वात मे भगवान ने बड़ाय जड़वा जोवे। <verse eid="1CO 10:31" /><verse number="32" style="v" sid="1CO 10:32" />तमु युहदी जाती ना माणहु जुगु बी, अने आड़जात्‌या माणहु जुगु बी नी, अने भगवान नी मंडळी जुगु बी पाप नो कारण ना बणो। <verse eid="1CO 10:32" /><verse number="33" style="v" sid="1CO 10:33" />जीसम मे आखी वात मे आखा ने खुस करु, अने आह़फा नु भलु नी ह़ोदु, पण बीजा नु भलु ह़ोदु, आनीन करते के तीमनो छुटकारो हय जाय।<verse eid="1CO 10:33" /></para>
  <chapter eid="1CO 10" />
  <chapter number="11" style="c" sid="1CO 11" />
  <para style="p">
    <verse number="1" style="v" sid="1CO 11:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:1 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:16">1 कुरन्‌थी 4:16</ref>; <ref loc="PHP 3:17">फीलीपीयो 3:17</ref></char>
    </note>मारीन तेम जीवो जेम मे ईसु मसीन तेम जीवु।<verse eid="1CO 11:1" /></para>
  <para style="s">भक्‌ती करती टेमे मुंडु ढाकवा</para>
  <para style="p">
    <verse number="2" style="v" sid="1CO 11:2" />मे तमने वारु केम। काहाके तमु मने जत्‌यार आखी वात मे फोम करो, अने जे ह़ीकापण मे तमने आप्‌यो, तीहयी ह़ीकापण ने मानो अने पाळो। <verse eid="1CO 11:2" /><verse number="3" style="v" sid="1CO 11:3" />पण मे तमने केम के तमु आहयु जाण लेवो के बयर नु मुंडु अदमी से, अने अदमी नु मुंडु ईसु मसी से: अने मसी नु मुंडु भगवान से। <verse eid="1CO 11:3" /><verse number="4" style="v" sid="1CO 11:4" />कानो अदमी मुंडु ढाकीन भगवान सी वीन्‌ती करे, नीता भगवान वगे गेथी वात करे, तीहयी टेमे तीहयो आह़फा मुंडु नो वाक काडे। <verse eid="1CO 11:4" /><verse number="5" style="v" sid="1CO 11:5" />पण जे बयर उगाड़लु मुंडु लीन भगवान सी वीन्‌ती करे, नीता भगवान वगे गेथी वात करे, तीहयी आह़फी नु मुंडु नो वाक काडे। अने तीहयी मुंडु बोड़ली बयर नी तेम से। <verse eid="1CO 11:5" /><verse number="6" style="v" sid="1CO 11:6" />वीन्‌ती करवा नी टेमे नीता भगवान वगे गेथी वात केवा नी टेमे बयर लुगड़ी नी ओडे ता आह़फा ना नीम्‌बाळा कतराय लेवा जोवे; अने बयर ने आह़फा ना नीम्‌बाळा कतराव्‌वा अने बोड़ाव्‌वा लाज आवे ता लुगड़ी ओडवा जोवे। <verse eid="1CO 11:6" /><verse number="7" style="v" sid="1CO 11:7" />पण अदमी ने मुंडु ढाकवा ताले नी हय, काहाके अदमी भगवान नो सीको अने बड़ाय से; पण बयर अदमी नी बड़ाय से। <verse eid="1CO 11:7" /><verse number="8" style="v" sid="1CO 11:8" />काहाके अदमी ने बयर मे गेथो नी बणायो, पण बयर ने अदमी मे गेथी बणावलो से। <verse eid="1CO 11:8" /><verse number="9" style="v" sid="1CO 11:9" />अने अदमी ने बयर जुगु नी घड़्‌यो, पण बयर ने अदमी जुगु घड़लो से। <verse eid="1CO 11:9" /><verse number="10" style="v" sid="1CO 11:10" />एतरे भगवान, जे हक बयर ने आप्‌यो, तीहया हक मे रेवा करीन बयर आह़फी नु मुंडु ह़रगदुत नी लेदे ढाकवा जोवे। <verse eid="1CO 11:10" /><verse number="11" style="v" sid="1CO 11:11" />ते बी मालीक ईसु मे बयर वगर अदमी कंय बी नी हय, अने अदमी वगर बयर बी कंय बी नी हय। <verse eid="1CO 11:11" /><verse number="12" style="v" sid="1CO 11:12" />काहाके जीसम बयर अदमी मे गेथी आवी तेमेत बयर अदमी ने पयदा करे; पण आखी चीज भगवान नी लारे घड़ाये।<verse eid="1CO 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 11:13" />तमु वीच्‌यार करो? बयर ने उगाड़ला मुंडे भगवान सी वीन्‌ती करवा ताले से ह़ु? <verse eid="1CO 11:13" /><verse number="14" style="v" sid="1CO 11:14" />आसम बी कळी ना अनसारे अदमी ने नाम्‌बला नीम्‌बाळा राखवा लाज नी वात से। <verse eid="1CO 11:14" /><verse number="15" style="v" sid="1CO 11:15" />पण बयर ने नाम्‌बला नीम्‌बाळा राखवा तीनी ह़ोबा से; काहाके बयर ना नाम्‌बला नीम्‌बाळा तीनु मुंडु ढाकवा करीन आपला से। <verse eid="1CO 11:15" /><verse number="16" style="v" sid="1CO 11:16" />आना बारा मे कोय बी वात मे जखड़ी पड़वा हींडे ता आहयु जाण लेवो के भगवान नी मंडळी मे आहयी रीती ने सोड़ीन कानी बी रीती नी हय।<verse eid="1CO 11:16" /></para>
  <para style="s">मालीक नी पंगात नु खाणु</para>
  <para style="r">(<ref loc="MAT 26:26-29">मत्‌ती 26:26-29</ref>; <ref loc="MRK 14:22-25">मरकुस 14:22-25</ref>; <ref loc="LUK 22:14-20">लुका 22:14-20</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 11:17" />पण आहयु कीन मे तमने वारु नी केतो काहाके जत्‌यार तमु भेळा हयो ता नुकसान हये। <verse eid="1CO 11:17" /><verse number="18" style="v" sid="1CO 11:18" />काहाके पेले ते मे आहयु ह़मळ्‌ळो के तमु ईसु नी मंडळी मे भेळा हयो, ता तमारी मे बेरजाव पड़ जाय, आहयी वात ह़मळीन मे थोड़ो-थोड़ो ईसम बी भरहो करु के तमारी वच मे आसम हये। <verse eid="1CO 11:18" /><verse number="19" style="v" sid="1CO 11:19" />अने तमारी मे बेरजाव पड़वा जोवे, काहाके आसम हयवा सी तमारी मे जे खरला से अने झुट्‌ला से टळ जाय। <verse eid="1CO 11:19" /><verse number="20" style="v" sid="1CO 11:20" />एतरे तमु जत्‌यार बी भेळा हयो, ता ह़ाचलीन मालीक नी पंगात मे बहीन खावा भेळा नी हयो। <verse eid="1CO 11:20" /><verse number="21" style="v" sid="1CO 11:21" />काहाके तमु खाणु खावा बहो ता कानो पेलेत खाय लेय अने कानो भुकलोत रेय, अने कानो ह़रो पीन छाक जाय। <verse eid="1CO 11:21" /><verse number="22" style="v" sid="1CO 11:22" />तमारी पांह खावा-पीवा जुगु तमारु घोर नी हय ह़ु? तमु भगवान नी मंडळी ने रीकामी ह़मजी र्‌या? तमु ईसम करीन तमु जीनी पांह नी हय तीने लजवाड़वा हय र्‌या ह़ु? मे तमने ह़ु केम? आहयी वात मे तमने वारु केम ह़ु? मे तमने वारु नी केतो।<verse eid="1CO 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 11:23" />आहयी ह़ीकापण ईसुन्‌तां गेथी मारीन्‌तां पुगली से, अने तीहयी ह़ीकापण मे तमारीन्‌तां बी पुगाड़ देदलो से; के जे राते मालीक ईसु धरायो तीहयी टेमे रोट्‌लो लेदो। <verse eid="1CO 11:23" /><verse number="24" style="v" sid="1CO 11:24" />अने रोट्‌ला जुगु भगवान ने तु घणो वारु से कीन रोट्‌लो तोड़्‌यो अने केदो; “आहयु मारु डील से, जे तमारी जुगु आपलो से: मारी फोम करवा नी करते, मे कर्‌यो तेमेत, तमु बी कर्‌या करजो।” <verse eid="1CO 11:24" /><verse number="25" style="v" sid="1CO 11:25" />अने अळतेण ईसु हात मे पीयालो धर्‌यो अने केदो, “आहयो पीयालो मारा लोय नो नवलो कायदो से। अने जत्‌यार बी तमु पीयालो पीवो, ता मने फोम करवा करीन मारीन तेमेत कर्‌या करजो।” <figure style="fig" alt="Jesus eating the Passover meal with his disciples" file="lb00320c.tif" size="span" copy="Horace Knowles ©" ref="11:23">ईसु चेला ह़ाते आखरी खाणु खाय</figure><verse eid="1CO 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 11:26" />एतरे जत्‌यार बी तमु आहया रोट्‌ला ने खावो, अने आहया पीयाला मे गेथा पीवो, ता तमु मालीक ईसु पासो नी आवे, तां लग तीनी मोत नो परच्‌यार करो। <verse eid="1CO 11:26" /><verse number="27" style="v" sid="1CO 11:27" />एतरे जे कोय ईसु नी ईज्‌जत कर्‌या वगर, मालीक ईसु ना रोट्‌ला मे गेथो खाय, अने तीना पीयाला मे गेथो पीये, तीहयो मालीक ना डील नो अने मालीक ना लोय ना वीरोद मे पाप करे। <verse eid="1CO 11:27" /><verse number="28" style="v" sid="1CO 11:28" />एतरे जे कोय आहया रोट्‌ला मे गेथो अने पीयाला मे गेथो पीये तीहयो आह़फा ना मन ने पारखवा जोवे के मारी मे कंय पाप ते नी हय। <verse eid="1CO 11:28" /><verse number="29" style="v" sid="1CO 11:29" />काहाके जे कोय रोट्‌ला मे गेथो खावा नी पेले अने पीयाला मे गेथो पीवा नी पेले मालीक ईसु ना डील ने नी ओळखे तीहयु रोट्‌ला खाय्‌न अने पीयालो पीन आह़फा पोर पाप नो डंड लावे। <verse eid="1CO 11:29" /><verse number="30" style="v" sid="1CO 11:30" />एतरे तमारी मे ढेरेत जणा लुला अने मांदा हय ज्‌या, अने ढेरेत जणा मरी बी ज्‌या। <verse eid="1CO 11:30" /><verse number="31" style="v" sid="1CO 11:31" />कदीम आपणु आह़फाम ना मन ने पारखहु, ता आपणु ने नीयाव नो डंड नी जड़े। <verse eid="1CO 11:31" /><verse number="32" style="v" sid="1CO 11:32" />पण ते बी मालीक आपणु ने डंड आपीन ह़ुदारे, आनीन करते आपणु ने आहयी कळी ना मनख्‌या ह़ाते नीयाव ना दाड़े गुनाळ्‌ळा ठेरावीन डंड नी आपे तेम।<verse eid="1CO 11:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 11:33" />एतरे ए भायु अने बेन्‌या जत्‌यार बी तमु भगवान नु खाणु खावा करीन भेळा हयो, ता एक-बीजा नी वाट जोवो। <verse eid="1CO 11:33" /><verse number="34" style="v" sid="1CO 11:34" />कदीम कोय भुकलु हय, ता आह़फाम ना घोर मे खाय लेवो ईसम करवा सी तमु भेळा हयह़ु तीहयी टेमे तमने नीयाव नो डंड नी जड़े तेम। अने रेली वात ने मे आवीन ह़ुदार देही।<verse eid="1CO 11:34" /></para>
  <chapter eid="1CO 11" />
  <chapter number="12" style="c" sid="1CO 12" />
  <para style="s">चोखली आत्‌मा ना वरदान</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 12:1" />ए भाय-बेन्‌या मारी आहयी मरजी नी हय, के तमु आत्‌मा ना वरदान ना बारा मे अंजाण्‌या रेवो। <verse eid="1CO 12:1" /><verse number="2" style="v" sid="1CO 12:2" />तमने मालम से के जत्‌यार तमु ईसु ने नी मान्‌ता हता ता बोबड़ी मुर्‌ती पसळ जेम चलाड़ता हता तेम चालता हता। <verse eid="1CO 12:2" /><verse number="3" style="v" sid="1CO 12:3" />एतरे मे केम के कोय बी भगवान नी अगवाय वगर आहयु नी केय के ईसु गरा वाळो से। अने चोखली आत्‌मा वगर कोय आहयु नी केय के ईसु मालीक से।<verse eid="1CO 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 12:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:4 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:6-8">रोमीयो 12:6-8</ref>
      </char>
    </note>वरदान ते कंय भातीन से, पण आपवा वाळी चोखली आत्‌मा ते एकीत से। <verse eid="1CO 12:4" /><verse number="5" style="v" sid="1CO 12:5" />सेवा ते ढेरेत भातीन से, पण मालीक ते एकीत से। <verse eid="1CO 12:5" /><verse number="6" style="v" sid="1CO 12:6" />अने कामु ते ढेरेत भात्‌या से, पण भगवान ते एकीत से, जे आखा मे अलग कामु करे। <verse eid="1CO 12:6" /><verse number="7" style="v" sid="1CO 12:7" />पण आखा नी भलाय नी करते भगवान नी चोखली आत्‌मा भात-भातीन वेह मे उजन्‌ती हये। <verse eid="1CO 12:7" /><verse number="8" style="v" sid="1CO 12:8" />काहाके एकीत भगवान नी आत्‌मा नी लारे अक्‌कल नी वात केवा नो हुनर जड़े; अने बीजा ने तीहयी आत्‌मा नी लारे अक्‌कल जड़े। <verse eid="1CO 12:8" /><verse number="9" style="v" sid="1CO 12:9" />अने काना ने तीहयात भगवान नी आत्‌मा नी लारे भरहो करवा नो वाटो जड़े; अने तीहयी आत्‌मा नी लारे काना ने वारु करवा नो वरदान जड़े। <verse eid="1CO 12:9" /><verse number="10" style="v" sid="1CO 12:10" />अने काना ने सक्‌ती ना जुदा-काम करवा नो वाटो जड़े; अने काना ने भगवान वगे गेथी वात केवा नो वाटो जड़े। अने काना ने चोखली आत्‌मा ना वाटा ने पारखवा नो, अने काना ने भात-भातीन बोली नो मतलब देखाड़वा नो वाटो जड़े। <verse eid="1CO 12:10" /><verse number="11" style="v" sid="1CO 12:11" />पण आहया आखा जुदा-कामु एकीत भगवान नी चोखली आत्‌मा करे।<verse eid="1CO 12:11" /></para>
  <para style="s">डील एकीत: आंग ढेरेत</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 12:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">12:12 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 12:4">रोमीयो 12:4</ref>,<ref loc="ROM 12:5">5</ref></char>
    </note>काहाके जीसम डील ते एकीत से, पण तीनी मे आंग ढेरेत से। अने तीहया एक डील ना आखा आंग मेळीन एकीत डील केवाये। तेमेत ईसु मसी नु डील बी से। <verse eid="1CO 12:12" /><verse number="13" style="v" sid="1CO 12:13" />पण आपणु आखा, भले युहदी हय अने आड़जात्‌या हय, गुलाम हय अने सुटला हय, जे बी हय ते, पण एकीत भगवान नी आत्‌मा नी लारे एकीत डील बणवा करीन बपतीस्‌मा लेदला से, अने आपणु आखा ने एकीत भगवान नी आत्‌मा आपली से।<verse eid="1CO 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1CO 12:14" />ते बी डील मे एकीत आंग नी हय, पण ढेरेत आंग से। <verse eid="1CO 12:14" /><verse number="15" style="v" sid="1CO 12:15" />कदीम पोग केय: “मे हात नी हय एतरे मे डील नो नी हय।” ता तीहयो डील नो आंग नी हय ह़ु? <verse eid="1CO 12:15" /><verse number="16" style="v" sid="1CO 12:16" />आहयीत रीते कदीम कान्‌टो केय, “मे डोळो नी हय, एतरे मे डील नो नी हय” ता तीहयो डील नो आंग नी हय ह़ु? <verse eid="1CO 12:16" /><verse number="17" style="v" sid="1CO 12:17" />कदीम आखु डील डोळो रेतु ता केम ह़मळतु? अने कदीम आखु डील कान्‌टो रेतु ता तीहयु केम ह़ुंगतु? <verse eid="1CO 12:17" /><verse number="18" style="v" sid="1CO 12:18" />भगवान आह़फा नी मरजी नी अनसारे आखा आंग ने आपणा डील मे जोड़लो से। <verse eid="1CO 12:18" /><verse number="19" style="v" sid="1CO 12:19" />कदीम डील ना आखा आंग एकीत रेता ता डील केवायतु ह़ु? <verse eid="1CO 12:19" /><verse number="20" style="v" sid="1CO 12:20" />पण हाव आंग ते ढेरेत से, पण डील एकीत से।<verse eid="1CO 12:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 12:21" />डोळा हात ने ईसम नी की सके, के तमु मने नी जोवता, अने मुंडु पोग ने ईसम नी की सके के “तमु मने नी जोवता!” <verse eid="1CO 12:21" /><verse number="22" style="v" sid="1CO 12:22" />पण डील ना जे आंग ने आपणु कमजोर ह़मजया, तीहयु आंग आपणु ने जादा जोवे। <verse eid="1CO 12:22" /><verse number="23" style="v" sid="1CO 12:23" />अने डील ना जे आंग नी वारु देखाय तीने आमु ढाकया, अने जे आंग ह़ोबे नी तीहयुत आंग वारु ह़ोबवा बाज जाय। <verse eid="1CO 12:23" /><verse number="24" style="v" sid="1CO 12:24" />ते बी आपणु ने ह़ोबे एवा आंग अने नी ह़ोबे एसवा आंग नु काम नी हय, पण भगवान आपणा ह़ोबवा वाळा आंग ने आपणा डील मे ईसम मेल देदलो से, अने तीहया आंग ह़ोबे नी तीहया आंग नी जादा ईज्‌जत हये। <verse eid="1CO 12:24" /><verse number="25" style="v" sid="1CO 12:25" />आपणा आहया आंग मे बेरजाव नी पड़वा जोवे, पण एक-बीजा नी फीकर करवा जोवे। <verse eid="1CO 12:25" /><verse number="26" style="v" sid="1CO 12:26" />कदीम एक आंग ने दुख हये, ता तीनी ह़ाते आखा आंग ने दुख हये, अने कदीम एक आंग नी ईज्‌जत हये, ता तीनी ह़ाते आखा आंग खुस हये।<verse eid="1CO 12:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1CO 12:27" />ईसमेत तमु आखा ईसु मसी ना डील से। अने आखा मेळीन तीना आंग से। <verse eid="1CO 12:27" /><verse number="28" style="v" sid="1CO 12:28" /><note caller="+" style="x"><char style="xo" closed="false">12:28 </char><char style="xt" closed="false"><ref loc="EPH 4:11">ईफीसीयो 4:11</ref></char></note>भगवान आह़फा नी मंडळी मे अलग-अलग माणहु ने टाळीन काम ह़ोप देदो, पेले ईसु ना नेवताळा, बीजा भगवान नी वगे गेथा केण्‌या, तीसरा मास्‌तर, अने अळी बीजा ने आरगाय आपण्‌यो वरदान जड़्‌यो, अळतेण बीजा नी मदत करवा वाळा, अळतेण कोयने बी मालम नी हय तीहयी बोली बोलन्‌या टाळ्‌यो। <verse eid="1CO 12:28" /><verse number="29" style="v" sid="1CO 12:29" />आहया आखा नेवताळा से ह़ु? आहया आखा भगवान वगे गेथा केण्‌या से ह़ु? आहया आखा जुदा-काम करन्‌या से ह़ु? <verse eid="1CO 12:29" /><verse number="30" style="v" sid="1CO 12:30" />आखा ने आरगा करवा नो वाटो जड़लो से ह़ु? आखा ने भात-भाती नी बोली बोलवा नो वाटो जड़लो से ह़ु? अने आखा बोली बदल सके ह़ु? <verse eid="1CO 12:30" /><verse number="31" style="v" sid="1CO 12:31" />तमु मोटा-मोटा वाटा नी हेर करो!</para>
  <para style="p" vid="1CO 12:31">पण मे तमने आनी गेथी बी जादा मोटी वाट देखाड़वा हय र्‌यो।<verse eid="1CO 12:31" /></para>
  <chapter eid="1CO 12" />
  <chapter number="13" style="c" sid="1CO 13" />
  <para style="s">मोंग आखा गेथो मोटो से</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 13:1" />कदीम मे माणहु नी आखी बोली बोलवा बाज जाम अने ह़रगदुत नी बोली बी बोल लेम; पण मे बीजा माणहु ने मोंग नी करु ता मे ज्‌योरे अवाज करवा वाळी घंटी अने खळखीच्‌या ह़रको से। <verse eid="1CO 13:1" /><verse number="2" style="v" sid="1CO 13:2" /><note caller="+" style="x"><char style="xo" closed="false">13:2 </char><char style="xt" closed="false"><ref loc="MAT 17:20">मत्‌ती 17:20</ref>; <ref loc="MAT 21:21">21:21</ref>; <ref loc="MRK 11:23">मरकुस 11:23</ref></char></note>अने मे भगवान भणी गेथी वात बी केम, अने ह़तायली वात ने जाण लेम अने आखी भाती नी अक्‌कल हात कर लेम, अने एतरो जादा भरहो हात कर लेम के बड़ा ने बी एकीत बोलु मे छेटा कर देम, पण मोंग नी करु, ता कंय फायदो नी हय! <verse eid="1CO 13:2" /><verse number="3" style="v" sid="1CO 13:3" />मारी पांह जेतरु बी धन से तीहयु आखु गरीब ने वाट देम, अने मारु डील ने धपाड़वा करीन आप देम, पण मे बीजा ने मोंग नी करु; ता कंय फायदो नी हय।<verse eid="1CO 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1CO 13:4" />मोंग गम खाण्‌यो से, मोंग दया वाळो से, अने मोंग कुहराय नी करे, मोंग आह़फा नी बड़ाय नी करे, अने मोटाय नी करे। <verse eid="1CO 13:4" /><verse number="5" style="v" sid="1CO 13:5" />मोंग ह़ोबे नी एवु नी करे, मोंग आह़फा नु भुल हयवा जोवे ईसम हेर नी करे, मोंग नराज नी हये, मोंग बीजा नी कुहराय नो हीसाब नी राखे। <verse eid="1CO 13:5" /><verse number="6" style="v" sid="1CO 13:6" />मोंग पाप करे, ता खुस नी हये। पण सच्‌चाय सी खुस हये। <verse eid="1CO 13:6" /><verse number="7" style="v" sid="1CO 13:7" />मोंग आखी वात ने वेठ लेय, मोंग भरहो करे एवी आखी वात पोर भरहो करे, मोंग आखी वात नी आह करे, मोंग आखी वात मे गम खाय।<verse eid="1CO 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 13:8" />मोंग कदी खुटे नी; भगवान भणी गेथी जे बी वात से, तीहयी बी एक दाड़ो खुट जहे, आखी भाती नी बोली बी खुट जहे; अने अक्‌कल बी खुट जहे। <verse eid="1CO 13:8" /><verse number="9" style="v" sid="1CO 13:9" />काहाके आपणी अक्‌कल बी आदरीती से, अने भगवान भणी गेथी वात केय तीहयी बी आदरीती से। <verse eid="1CO 13:9" /><verse number="10" style="v" sid="1CO 13:10" />पण जत्‌यार भगवान आखु पुरु कर देहे ता अरद्‌लु खुट जहे।<verse eid="1CO 13:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1CO 13:11" />जत्‌यार मे नान्‌लो हतो, ता नान्‌लु सोरुन तेम मारु मन हतु, नान्‌लु सोरुन तेम वीच्‌यार करतो हतो, अने नान्‌लु सोरुन तेम बोलतो हतो, नान्‌लु सोरुन तेम ह़मजतो हतो। पण मे जत्‌यार हुस्‌यार हय ज्‌यो ता सोरुन तेवो वेहवार सोड़ देदो। <verse eid="1CO 13:11" /><verse number="12" style="v" sid="1CO 13:12" />हमणे आपणु ने आरहा मे धुंदळु देखाये, पण तीहयी टेमे आपणु आंबा-सांबा देखहु, आहयी टेमे मारी अक्‌कल आदरीती से; पण तीहयी टेमे भगवान ने वारु ओळखी लेही जीसम तीहयो मने ओळखे।<verse eid="1CO 13:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 13:13" />हमणे ते भरहो, आह अने मोंग तीनोव बराबर से, पण ईमनी माय्‌न मोंगेत मोटो से।<verse eid="1CO 13:13" /></para>
  <chapter eid="1CO 13" />
  <chapter number="14" style="c" sid="1CO 14" />
  <para style="s">चोखली वात ना बारा मे जादा ह़ीकापण</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 14:1" />मोंग नी वाट्‌ये चालीन मोंग सी रेवो। अने तमु चोखला वाटा नी झींग मे रेवो। खास करीन भगवान भणी गेथी वात केवा नी झींग मे रेवो। <verse eid="1CO 14:1" /><verse number="2" style="v" sid="1CO 14:2" />काहाके जे बी चोखली आत्‌मा नी लारे भात-भाती नी बोली बोले; तीहयो माणहु ह़ाते नी पण भगवान नी ह़ाते वात करे; काहाके तीनी वात कोयने ह़मज नी आवे काहाके तीहयी ह़तायली वात भगवान नी चोखली आत्‌मा नी ताखत सी केय। <verse eid="1CO 14:2" /><verse number="3" style="v" sid="1CO 14:3" />पण जे भगवान भणी गेथी वात केय, तीहयो माणहु नी आत्‌मा नो फायदो करे, अने माणहु ने ह़ीकापण अने सांती आपवा वाळी वात केय। <verse eid="1CO 14:3" /><verse number="4" style="v" sid="1CO 14:4" />पण जे चोखला आत्‌मा नी लारे भात-भाती नी बोली बोले तीहयो आह़फा नी आत्‌मा नो फायदो करे। पण जे भगवान भणी गेथी वात केय तीहयो ईसु नी मंडळी मे रेण्‌या नो फायदो करे।<verse eid="1CO 14:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 14:5" />मारी आहयी मरजी से के तमु आखा चोखली आत्‌मा नी लारे भात-भाती नी बोली बोलो। पण तीनी गेथी बी जादा मरजी आहयी से के तमु भगवान भणी गेथी वात केवो: काहाके कदीम चोखली आत्‌मा नी लारे भात-भाती नी बोली बोलन्‌या ईसु नी मंडळी ना माणहु ना फायदा जुगु तीहयी बोली ने बीजी बोली मे नी बदले, ता तीनी गेथो भगवान भणी गेथो केण्‌यो वारु से। <verse eid="1CO 14:5" /><verse number="6" style="v" sid="1CO 14:6" />ए ईसु पोर भरहो करन्‌या भाय-बेन्‌या कदीम मे तमारीन्‌तां आवीन आत्‌मा नी लारे भात-भाती नी बोली बोलु, ता तमने मारी सी ह़ु फायदो हयहे। पण ह़तायली वात, अने अक्‌कल नी वात, अने भगवान भणी गेथी वात नी केम, अने ह़ीकापण नी आपु।<verse eid="1CO 14:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1CO 14:7" />आहयी रीते कदीम वण-जीव्‌या चीज बी जीनी मे अवाज नीकळे। तीनी मे अवाज नु फरक नी हय ता कीसम मालम पड़हे के कानु वाजु वाज र्‌यु। पाहळीन नीता तम्‌बुरा नी रींग मे कंय बी फरक नी हय ता कंय बी फायदो नी हय। <verse eid="1CO 14:7" /><verse number="8" style="v" sid="1CO 14:8" />अने फेपार्‌या नी रींग बी चोखीझण नी हय ता माणहु झुमायवा करीन कोय तीयार हयहे। <verse eid="1CO 14:8" /><verse number="9" style="v" sid="1CO 14:9" />एतरे तमने बीजा नी बोली चोखीझण नी बोलाये तां लग बीजा ने तमु ह़ु की र्‌या तीहयु कीसम ह़मज मे आवहे? अने तीमने ह़मज नी आवे ता तीमने ईसम लागहे के तमु वाहळा ह़ाते वात कर र्‌या। <verse eid="1CO 14:9" /><verse number="10" style="v" sid="1CO 14:10" />ह़ाचलीन आहयी कळी मे घण ढेरकी बोली से, पण तीहयी बोली माय्‌न एक बोली बी रीकामी नी हय। <verse eid="1CO 14:10" /><verse number="11" style="v" sid="1CO 14:11" />जत्‌यार लग मे बोलवा वाळा नी बोली नी ह़मजु तां लग मे तीनी जुगु अंजाणलो रेही अने तीहयो बी मारी जुगु अंजाणलो रेहे। <verse eid="1CO 14:11" /><verse number="12" style="v" sid="1CO 14:12" />एतरे तमु आखा जत्‌यार लग चोखली आत्‌मा नी झींग मे रेवो। तत्‌यार लग एवी कोसीत करो, के तमारा वाटा मे फायदो हये तीहयी टेमे ईसु नी मंडळी ना माणहु नो बी फायदो हये तेम। <figure style="fig" alt="musical instruments" file="hk00188c.tif" size="col" copy="Horace Knowles ©" ref="14:7">भात-भाती नु वाजु</figure><verse eid="1CO 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 14:13" />जे चोखली आत्‌मा नी लारे भात-भाती नी बोली बोलतु हय तीने आहयी बोली नो मतलब ह़मजाड़वा करीन बोली बदल करते बी अवड़वा जोवे। एवी वीन्‌ती भगवान सी करवा जोवे। <verse eid="1CO 14:13" /><verse number="14" style="v" sid="1CO 14:14" />काहाके कदीम मे चोखली आत्‌मा नी लारे भात-भाती नी बोली मे वीन्‌ती करु ता मारी आत्‌मा एतरीत वीन्‌ती करे। पण तीहयी टेमे मारी अक्‌कल काम नी करे। <verse eid="1CO 14:14" /><verse number="15" style="v" sid="1CO 14:15" />एतरे ह़ु करवा जोवे? मे आत्‌मा सी बी वीन्‌ती करही; अने अक्‌कल सी बी वीन्‌ती करही; मे आत्‌मा मे गावही अने अक्‌कल सी बी गावही। <verse eid="1CO 14:15" /><verse number="16" style="v" sid="1CO 14:16" />कदीम तु आत्‌मा सी भगवान ने, तु घणो वारु से कीही तां बह रेलो अंजाण्‌यो माणेह तारी वात ह़मळीन “आमीन” काहा केहे। काहाके तीने ते मालम नी हय के तु ह़ु की र्‌यो? <verse eid="1CO 14:16" /><verse number="17" style="v" sid="1CO 14:17" />तु ते ह़ाचलीनेत तु घणो वारु से केय पण बीजा नो फायदो नी हये ता मे ह़ु करु।<verse eid="1CO 14:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1CO 14:18" />मे तमारी आखा गेथो जादा चोखली आत्‌मा नी लारे भात-भाती नी बोली बोलु। एतरे भगवान ने आहयी वात नी करते तु घणो वारु से केम। <verse eid="1CO 14:18" /><verse number="19" style="v" sid="1CO 14:19" />पण भगवान नी मंडळी मे चोखली आत्‌मा नी लारे भात-भाती नी बोली मे दह हजार वात केवा नी बदले मने अक्‌कल नी वात केवा वारु से। आनीन करते के बीजा ने ह़ीकाड़वा करीन मे अक्‌कल नी पांच वात केवा वारु से।<verse eid="1CO 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 14:20" />ए ईसु पोर भरहो करन्‌या भाय-बेन्‌या ह़मज मे सोरान तेम ना बणो: पण कुहराय मे सोरा नी तेम बणो, अने ह़मज मे हुस्‌यार बणो। <verse eid="1CO 14:20" /><verse number="21" style="v" sid="1CO 14:21" />जीसम मुसा नी लारे लीखला सास्‌तर मे लीखलु से:</para>
  <para style="q1" vid="1CO 14:21">मे बीजी बोली बोलन्‌या नी लारे,</para>
  <para style="q2" vid="1CO 14:21">अने पारका मोडा नी लारे ईसु ना माणहु ह़ाते वात करही,</para>
  <para style="q1" vid="1CO 14:21">ते बी तीहया मारी वात नी ह़मळे।</para>
  <para style="q2" vid="1CO 14:21">मालीक भगवान आहयुत केय।<verse eid="1CO 14:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="1CO 14:22" />एतरे चोखली आत्‌मा नी लारे केदली भात-भाती नी बोली ईसु पोर भरहो नी करे, तीमनी जुगु नी हय, पण ईसु पोर भरहो करे तीमनी जुगु से।<verse eid="1CO 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 14:23" />अने कदीम ईसु नी मंडळी एक जागे भेळी हये, अने तीहयी टेमे आखान-आखा चोखली आत्‌मा नी लारे भात-भाती नी बोली बोले अने तां ह़ारीक बीजा माणहु नीता ईसु पोर भरहो नी करे तीहया आय लागे ता तीहया तमने गांडा नी ह़मजे ह़ु? <verse eid="1CO 14:23" /><verse number="24" style="v" sid="1CO 14:24" />पण तीहयी टेमे आखान-आखा भगवान भणी गेथी वात केवा बाज जाय ता कानो बी अनपड़ नीता ईसु पोर भरहो नी करे तीहयो बी आय लागे, ता आखान-आखा तीने गुनेगार ठेराय देहे अने तीने पारखी लेहे। <verse eid="1CO 14:24" /><verse number="25" style="v" sid="1CO 14:25" />तीना मन नी वात उजन्‌ती हय जहे, तत्‌यार तीहयो पोगु पड़ीन भगवान ने वांदहे। अने आहयु मान लेहे के ह़ाचलीनेत भगवान तमारी वच मे से।<verse eid="1CO 14:25" /></para>
  <para style="s">भक्‌ती जुगु कायदा</para>
  <para style="p">
    <verse number="26" style="v" sid="1CO 14:26" />ए ईसु पोर भरहो करन्‌या भाय-बेन्‌या तमु भेळा हयो ता ह़ु करवा जोवे? तीहयी टेमे आखा ना मन मे गीत नीता ह़ीकापण, नीता चोखली आत्‌मा नी लारे भात-भाती नी बोली बोलवा, नीता तीनी बोली नो मतलब ह़मजाड़वा जोवे। एतरे आखु कंय तमारा मंडळी ना फायदा जुगु हयवा जोवे। <verse eid="1CO 14:26" /><verse number="27" style="v" sid="1CO 14:27" />कदीम चोखली आत्‌मा नी लारे भात-भाती नी बोली मे वात करवा हय ता बे-बे, नीता जादा हय ता तीन-तीन जणा बोलवा जोवे अने एक जणो तीनी बोली ह़मज आवे एवी बोली मे बदलवा जोवे। <verse eid="1CO 14:27" /><verse number="28" style="v" sid="1CO 14:28" />पण कदीम बोली बदल करन्‌यो नी हय, ता चोखली आत्‌मा नी लारे भात-भाती नी बोली बोलन्‌यो ईसु नी मंडळी मे होगो रेवा जोवे, अने आह़फा ना मन मे भगवान ह़ाते वात करवा जोवे। <verse eid="1CO 14:28" /><verse number="29" style="v" sid="1CO 14:29" />भगवान वगे गेथा केण्‌या बे नीता तीन जणा बोलवा जोवे, अने बीजा माणहु तीमना केदला बोलु ने पारखवा जोवे। <verse eid="1CO 14:29" /><verse number="30" style="v" sid="1CO 14:30" />पण कदीम बठवा वाळा माय्‌न कानाह पोर भगवान नी वात उजन्‌ती हयती हय ता पेले बोलन्‌यो होगो री जवा जोवे। <verse eid="1CO 14:30" /><verse number="31" style="v" sid="1CO 14:31" />काहाके तमु आखा एकीक जणा भगवान वगे गेथी वात की सके, आनीन करीन के आखा ने ह़ीकवा जोवे, अने आखा ने मोखो जड़वा जोवे। <verse eid="1CO 14:31" /><verse number="32" style="v" sid="1CO 14:32" />काहाके भगवान वगे गेथी वात केण्‌या माणहु नी आत्‌मा तीमनात हक मे से।<verse eid="1CO 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 14:33" />काहाके भगवान वेरा-वेर करन्‌यो नी हय, पण सांती आपण्‌यो से; जीसम तीहयो चोखला माणहु नी ईसु नी मंडळी ने सांती आपे। <verse eid="1CO 14:33" /><verse number="34" style="v" sid="1CO 14:34" />बयरा मंडळी मे होगा रेवा जोवे, काहाके तीमनो तां ह़ारीक वात करवा नो हुकम नी हय, पण ह़मळीन हक मे रेवा नो हक से: जीसम मुसा नी लारे लीखला सास्‌तर मे लीखलु से। <verse eid="1CO 14:34" /><verse number="35" style="v" sid="1CO 14:35" />कदीम तीहया कंय ह़ीकवा हींडे, ता घोर जाय्‌न आह़फाम ना अदमी ने पुसवा जोवे, अने बयर ने ईसु नी मंडळी मे वात करवा लाज नी वात से।<verse eid="1CO 14:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="1CO 14:36" />ह़ु भगवान नो बोल तमारीन्‌तां गेथो नीकळीन आवलो से ह़ु? अने तमारीन्‌तां एतरोत पुगलो से ह़ु? <verse eid="1CO 14:36" /><verse number="37" style="v" sid="1CO 14:37" />कदीम कानो माणेह आह़फा ने भगवान वगे गेथी वात केण्‌यो माणेह ह़मजतो हय, नीता आत्‌मा नी वात देखाड़न्‌यो ह़मजतो हय, ता तीने आसम बी जाण लेवा जोवे के आहयी वात मे लीख र्‌यो तीहयी वात मालीक ईसु ना हुकम से। <verse eid="1CO 14:37" /><verse number="38" style="v" sid="1CO 14:38" />कदीम तीहयो आहयी वात ने नी माने ता मालीक ईसु ने बी नी माने।<verse eid="1CO 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 14:39" />एतरे ए भाय-बेन्‌या भगवान वगे गेथी वात करवान झींग मे रेवो, अने जे चोखला आत्‌मा नी लारे भात-भाती नी बोली बोले तीमने ना रोको। <verse eid="1CO 14:39" /><verse number="40" style="v" sid="1CO 14:40" />पण आहयु आखु काम वारु रीते अने एक-एक करीन करवा जोवे।<verse eid="1CO 14:40" /></para>
  <chapter eid="1CO 14" />
  <chapter number="15" style="c" sid="1CO 15" />
  <para style="s">ईसु मसी मोत मे गेथो पासो जीव उठे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 15:1" />ए भाय-बेन्‌या मे तमने तीहयी खुस-खबर ह़मळावु, जे तमने मे पेले ह़मळाव देदलो से, अने तमु आहयी खुस-खबर ने हुकारीन मान लेदला से, अने जीनी मे तमु टेकला बी से। <verse eid="1CO 15:1" /><verse number="2" style="v" sid="1CO 15:2" />आहयी खुस-खबर नी लारे तमारो छुटकारो हये, कदीम तमु तीहयी खुस-खबर ने फोम राखहु जे मे तमने ह़मळावलो, तात तमारो छुटकारो हयहे; नीता तमारो भरहो अमथो से।<verse eid="1CO 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1CO 15:3" />एतरे मे आखा नी पेले तमने तीहयी खुस-खबर पुगाड़ देदो, जे मारीन्‌तां पुगली हती, के खरला सास्‌तर ना बोलु नी अनसारे ईसु मसी आपणा पाप नो डंड भुकत्‌वा करीन मर ज्‌यो। <verse eid="1CO 15:3" /><verse number="4" style="v" sid="1CO 15:4" /><note caller="+" style="x"><char style="xo" closed="false">15:4 </char><char style="xt" closed="false"><ref loc="MAT 12:40">मत्‌ती 12:40</ref>; <ref loc="ACT 2:24-32">नेवताळा ना काम 2:24-32</ref></char></note>तीने गाड़ बी देदा; अने खरला सास्‌तर नी अनसारे तीसरा दाड़े जीवतो बी हय ज्‌यो। <verse eid="1CO 15:4" /><verse number="5" style="v" sid="1CO 15:5" /><note caller="+" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="LUK 24:34">लुका 24:34</ref>; </char><char style="xt" closed="false"><ref loc="MAT 28:16">मत्‌ती 28:16</ref>,<ref loc="MAT 28:17">17</ref>; <ref loc="MRK 16:14">मरकुस 16:14</ref>; <ref loc="LUK 24:36">लुका 24:36</ref>; <ref loc="JHN 20:19">युहन्‌ना 20:19</ref></char></note>अने अळतेण तीहयो पतरस ने देखाव पड़्‌यो अळतेण बारे चेला ने बी देखाव पड़्‌यो। <verse eid="1CO 15:5" /><verse number="6" style="v" sid="1CO 15:6" />अने अळतेण पांच ह़ोव गेथा जादा ईसु पोर भरहो करन्‌या भाय-बेन्‌या ने देखाव पड़्‌यो, जीनी मे ढेरेत जणा हमणे बी जीवत्‌ला से, पण ढेरेत जणा मर ज्‌या। <verse eid="1CO 15:6" /><verse number="7" style="v" sid="1CO 15:7" />अळतेण तीहयो याकुब ने देखाव पड़्‌यो, अने अळतेण आखा ईसु ना नेवताळा ने देखाव पड़्‌यो।<verse eid="1CO 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 15:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:8 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 9:3-6">नेवताळा ना काम 9:3-6</ref>
      </char>
    </note>अने आखा नी छेली कावा मने बी देखाव पड़्‌यो, मे ते केदो मे तीहया सोरान तेम से जे आदरीतु पक्‌कु नी हयु अने पेलेत पयदा हय ज्‌यु हय। <verse eid="1CO 15:8" /><verse number="9" style="v" sid="1CO 15:9" /><note caller="+" style="x"><char style="xo" closed="false">15:9 </char><char style="xt" closed="false"><ref loc="ACT 8:3">नेवताळा ना काम 8:3</ref></char></note>काहाके मे ईसु ना नेवताळा माय्‌न आखा नी करते नानो नेवताळो से। एक कीया मे ईसु नो नेवताळो केय एवो बी नी हय, काहाके मे भगवान नी मंडळी ने वेला पाड़लो हतो। <verse eid="1CO 15:9" /><verse number="10" style="v" sid="1CO 15:10" />पण आज मे जे बी बण र्‌यो तीहयु भगवान नी दया नी लारेत बणलो से। तीनी दया वाञेबार नी बगड़ी। मे तीहया ईसु ना नेवताळा नी करते जादा काठी मेहनत करलो से: ते बी आहयी काठी मेहनत मे मारी ज्‌योरे नी कर्‌यो, पण भगवान नी तीहयी दया सीत करलो से। जे दया मारी पोर देखाड़लो से। <verse eid="1CO 15:10" /><verse number="11" style="v" sid="1CO 15:11" />भले तीहया ईसु ना नेवताळा हय, आमु आखा ईसु नी खुस-खबर ने परच्‌यार करला से अने तमु आहयीत ईसु नी खुस-खबर पोर भरहो करला से।<verse eid="1CO 15:11" /></para>
  <para style="s">ईसु पोर भरहो करीन मरन्‌या माणहु नु पासु जीवतु हयणु</para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 15:12" />ईसु मसी ना बारा मे आहयु परच्‌यार हय र्‌यु, के तीहयो मर्‌या-ह़र्‌या मे गेथो जीवतो हय्‌न बठो हय ज्‌यो, ता तमारी मे गेथा ढेरेत जणा आसम काहा केय के मर्‌या-ह़र्‌या मे गेथा माणहु जीवता हय्‌न बठा नी हये। <verse eid="1CO 15:12" /><verse number="13" style="v" sid="1CO 15:13" />कदीम मर्‌या-ह़र्‌या मे गेथु जीवतु हय्‌न बठु हयणु नी हय, ता ते ईसु मसी बी मर्‌या-ह़र्‌या मे गेथो जीवतो हय्‌न बठो नी हयो। <verse eid="1CO 15:13" /><verse number="14" style="v" sid="1CO 15:14" />अने कदीम ईसु मसी मर्‌या-ह़र्‌या मे गेथो जीवतो हय्‌न बठो नी हयो ता ते अमारु परच्‌यार करनु बी अमथु से; अने तमारो ईसु पोर भरहो करनु बी अमथु से। <verse eid="1CO 15:14" /><verse number="15" style="v" sid="1CO 15:15" />एतरुत नी पण आमु ते भगवान ना झुटा गवा केवायहु; काहाके आमु ते भगवान ना बारा मे आहयी गवाय देदला से के भगवान ईसु मसी ने मर्‌या-ह़र्‌या मे गेथो जीवतो करीन तीने बठो कर देदलो से। कदीम ईसु मर्‌या-ह़र्‌या मे गेथो जीवतो हय्‌न बठो नी हयतो ता मरला माणहु बी मर्‌या-ह़र्‌या मे गेथा जीवता हय्‌न बठा नी हयता। <verse eid="1CO 15:15" /><verse number="16" style="v" sid="1CO 15:16" />अने कदीम मरलात बठा हय्‌न जीवता नी हये, ता ईसु मसी बी जीवतो नी हयो जाणजो। <verse eid="1CO 15:16" /><verse number="17" style="v" sid="1CO 15:17" />अने कदीम भगवान ईसु मसी ने मर्‌या-ह़र्‌या मे गेथो जीवतो करीन बठो नी कर्‌यो, ता तमारु ईसु पोर भरहो करवा अमथु से; अने तमु हजु लग पाप मे पड़ला से। <verse eid="1CO 15:17" /><verse number="18" style="v" sid="1CO 15:18" />जे ईसु मसी पोर भरहो करता जाय्‌न मर ज्‌या, तीहया बी मरीन खत्‌तम हय ज्‌या। <verse eid="1CO 15:18" /><verse number="19" style="v" sid="1CO 15:19" />कदीम आपणु आहयी कळी पोर वाळी आहयी जीवाय मे ईसु मसी पोर आह कर र्‌या, ता आपणु आहयी कळी मे आखा गेथा बाफड़ा माणहु से।<verse eid="1CO 15:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 15:20" />पण ईसु मसी ते ह़ाचलीनेत मर्‌या-ह़र्‌या मे गेथो जीवतो हय्‌न बठो हय जेलो से। अने जे मर जेला तीहया माणहु मे आखान पेले मर्‌या-ह़र्‌या मे गेथो जीवतो हयलो से। <verse eid="1CO 15:20" /><verse number="21" style="v" sid="1CO 15:21" />काहाके एक माणेह नी लारे मोत आवी; ता एक माणेह नी लारे मर्‌या-ह़र्‌या मे गेथु जीवतु हय्‌न बठु हयवा नु बी हयु। <verse eid="1CO 15:21" /><verse number="22" style="v" sid="1CO 15:22" />जीसम आदम नी लेदे आखा मर ज्‌या, तेमेत ईसु मसी नी लेदे आखा मर्‌या-ह़र्‌या मे गेथा जीवता हय्‌न बठा हय जहे। <verse eid="1CO 15:22" /><verse number="23" style="v" sid="1CO 15:23" />पण आखा वार्‌ये-वार्‌ये मर्‌या-ह़र्‌या मे गेथा जीवता हय्‌न बठा हयहे। आखान पेले मसी, अळतेण मसी ह़रगे गेथो पासो आवहे ता तीनी पोर भरहो करन्‌या माणहु मर्‌या-ह़र्‌या मे गेथा बठा हय जहे। <verse eid="1CO 15:23" /><verse number="24" style="v" sid="1CO 15:24" />अळतेण कळ खत्‌तम हयवा नी आखरी टेम आय लागहे; तीहयी टेमे मसी आखा राज करन्‌या ने, हक राखण्‌या ने, अने आखा भाती ना जोर ने खत्‌तम कर देहे। अने आखु राज-पाट भगवान बाह ने ह़ोप देहे। <verse eid="1CO 15:24" /><verse number="25" style="v" sid="1CO 15:25" />पण जत्‌यार लग मसी आह़फा ना वेरी ने आह़फा ना पोगु तळे नी ली आवे तां लग तीने राज करवा जरुड़ी से। <verse eid="1CO 15:25" /><verse number="26" style="v" sid="1CO 15:26" />जे वेरी ने आखा नी सेल्‌ली कावा खत्‌तम कर देहे, तीहयो वेरी मोत से। <verse eid="1CO 15:26" /><verse number="27" style="v" sid="1CO 15:27" />काहाके चोखली सास्‌तर केय के भगवान आखु कंय मसी ना पोगु तळे कर देदलो से, पण आनु मतलब से के जे मसी ना पोगु तळे आखु कंय कर देदलो से तीहयो भगवान एतरोत मसी ना पोगु तळे नी हयो। <verse eid="1CO 15:27" /><verse number="28" style="v" sid="1CO 15:28" />जत्‌यार आखु कंय सोरा ना हात मे हय जहे, ता सोरो आह़फोत बाह ना हक मे हय जहे, तीहयो बाह आखु कंय तीना हक मे कर देदलो से। आहयु ईसम करीन हय्‌हे काहाके भगवानेत आखु कंय से।<verse eid="1CO 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="1CO 15:29" />ता जे माणहु मरला माणहु जुगु बपतीस्‌मा लेय, ता तीहया ह़ु करहे? कदीम मर्‌या-ह़र्‌या मे गेथु जीवतो हय्‌न बठु हयवा नु नी हय, ता मरला माणहु जुगु जीवत्‌ला माणहु ने बपतीस्‌मा ह़ुका आपे? <verse eid="1CO 15:29" /><verse number="30" style="v" sid="1CO 15:30" />कदीम मर्‌या-ह़र्‌या मे गेथु पासु जीवतो हय्‌न बठु हयवा नी हय, ता आमु दाड़ीन वेला ह़ुका कर र्‌या? <verse eid="1CO 15:30" /><verse number="31" style="v" sid="1CO 15:31" />ए भायु, अने बेन्‌या मे मालीक ईसु मसी मे मोटाय करीन केम के मे दाड़ीन वेला करीन मर र्‌यो। <verse eid="1CO 15:31" /><verse number="32" style="v" sid="1CO 15:32" />कदीम मर्‌या-ह़र्‌या मे गेथो पासो जीवतो हयवा नु नी रेतु, ता मे ईफीसुस ह़ेर मे माणहुन तेम जंगली जानवरु ह़ाते लड़ाय कर्‌यो ता मारो ह़ु फायदो हयो? कदीम मर्‌या-ह़र्‌या ने भगवान जीवतो करीन पासो बठो नी करे ता ह़ु फायदो “आवो, आपणु खाया-पीया काहाके वाणे ते आपणु ने मरवात से।”<verse eid="1CO 15:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="1CO 15:33" />धोको ना खावो, “गलत संगती वारला माणहु ने बगाड़ देय।” <verse eid="1CO 15:33" /><verse number="34" style="v" sid="1CO 15:34" />वारला वीच्‌यार करो, अने पाप करवा सोड़ देवो; काहाके ढेरेत जणा ईसम से जे भगवान ने नी जाणे, आहयी वात मे तमने लाजे पाड़वा करीन की र्‌यो।<verse eid="1CO 15:34" /></para>
  <para style="s">मरला मे गेथा जीवता हयवान अळतेण नु डील</para>
  <para style="p">
    <verse number="35" style="v" sid="1CO 15:35" />तमारी माय्‌न कोय केहे, “मरला कीकम मर्‌या-ह़र्‌या मे गेथा जीवता हय्‌न पासा बठा हयहे? तीमनी पांह केवु डील रेहे?” <verse eid="1CO 15:35" /><verse number="36" style="v" sid="1CO 15:36" />ए वण-अकल्‌या जरीक वीच्‌यार कर! जे कंय तु वेरे तीहयु जत्‌यार लग नी मरे, तत्‌यार लग तीहयु जीवतु हय्‌न नी उगे। <verse eid="1CO 15:36" /><verse number="37" style="v" sid="1CO 15:37" />अने जे कंय तु वेरे, तीहयु पासु पयदा हयवा वाळु डील नी हय, पण बीज एतरुत से, भले तीहयु गम नो बीज हय, भले काना बी अन नो बीज हय। <verse eid="1CO 15:37" /><verse number="38" style="v" sid="1CO 15:38" />पण भगवान आह़फा नी मरजी नी अनसारे तीहया अन ने तीनु डील आपे; अने एक-एक बीज ने अलग-अलग बीज आपे।<verse eid="1CO 15:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="1CO 15:39" />आखा डील एक ह़ारका नी रेय। माणहु नु डील बीजा भात्‌यु रेय, जानवरु नु डील बीजा भात्‌यु रेय; चड़ा नु डील बीजा भात्‌यु रेय, माछला नु डील बीजा भात्‌यु रेय।<verse eid="1CO 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="1CO 15:40" />जेम धरती पोर वाळु डील से, तेमेत ह़रग मे वाळु बी डील से: पण धरती पोर वाळा डील नो ह़ेक बीजा से अने ह़रग मे वाळा डील नो ह़ेक बीजा भात्‌यो से। <verse eid="1CO 15:40" /><verse number="41" style="v" sid="1CO 15:41" />दाहड़ु नो ह़ेक बीजा भात्‌यो से, अने चांद नो ह़ेक बीजा भात्‌यो से, अने तारा नो ह़ेक बीजा भात्‌यो से। अने एक-एक तारा नो ह़ेक बीजा-बीजा भात्‌यो से।<verse eid="1CO 15:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="1CO 15:42" />मर्‌या-ह़र्‌या मे गेथु पासु जीवतु हयवा नु आसमेत से। मरला माणहु नु जे धोड़ धरती मे बीज ने तेम गाड़ देय। तीहयु डील बगड़वा वाळु से। पण जे डील मर्‌या-ह़र्‌या मे गेथु पाछु जीवतु हयहे, तीहयु जलमकु से कदी नी खुटे। <verse eid="1CO 15:42" /><verse number="43" style="v" sid="1CO 15:43" />मरला माणहु नु धोड़ धरती मे बीज ने तेम गाड़ देय, ता तीनी ईज्‌जत नी हये, पण जत्‌यार तीहयु मर्‌या-ह़र्‌या मे गेथु पाछु जीवतु हयहे, ता जोरभर्‌यु रेहे। <verse eid="1CO 15:43" /><verse number="44" style="v" sid="1CO 15:44" />माणहु ना तीहया मरला धोड़ ने धरती मे बीज नी तेम वाळीन वळावे, तीहयु धोड़ धरती पोर वाळु से, पण तीहयो आत्‌मा नी ताखत भेळ पासु जीवतु हय जाय: ईसम करीन देखे ता बे भाती नु डील से, पेलो धरती पोर वाळु डील से, अने बीजु ह़रग मे वाळी आत्‌मा नु डील से। <verse eid="1CO 15:44" /><verse number="45" style="v" sid="1CO 15:45" />खरला सास्‌तर मे ईसम लीखलु बी से: “पेलो माणेह आदम एक जीवत्‌ला जीव माणेह से।” पण बीजो आदम ते एक जीवाय आपण्‌यो आत्‌मा से। <verse eid="1CO 15:45" /><verse number="46" style="v" sid="1CO 15:46" />पेले आत्‌मा नी आयी, पण धरती पोर वाळा डील नो सीको आयो, अळतेण आत्‌मा आयी। <verse eid="1CO 15:46" /><verse number="47" style="v" sid="1CO 15:47" />पेलो माणेह आदम धरती ना कादा नो बण्‌लो हतो, अने बीजो माणेह ह़रग नो से। <verse eid="1CO 15:47" /><verse number="48" style="v" sid="1CO 15:48" />जीसम आदम धरती ना कादा नो बण्‌लो हतो, तेमेत आपणु बी धरती ना कादा ना बण्‌ला से। अने जीसम ईसु ह़रग नो से, तेमेत जे ईसु पोर भरहो करे तीहया ह़रग ना रेहे। <verse eid="1CO 15:48" /><verse number="49" style="v" sid="1CO 15:49" />जीसम आपणु धरती ना कादा ना बण्‌ला नु डील पेरला से, तेमेत ह़रग वाळु डील ने बी पेरहु।<verse eid="1CO 15:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="1CO 15:50" />ए भायु, अने बेन्‌या मे तमने आहयु केम के माह अने लोय ना माणहु भगवान ना राज ना हकदार्‌या नी हय सके।<verse eid="1CO 15:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="1CO 15:51" />
    <note caller="+" style="x">
      <char style="xo" closed="false">15:51 </char>
      <char style="xt" closed="false">
        <ref loc="1TH 4:15-17">1 थीसलुनीकीयो 4:15-17</ref>
      </char>
    </note>ह़मळो, मे तमने एक ह़तायली वात देखाड़ु: आपणु आखा ईसु आवहे तीहयी टेमे मरजे नी पण आपणु आखा नो सीको बदली जहे। <verse eid="1CO 15:51" /><verse number="52" style="v" sid="1CO 15:52" />अने जरीक वार मे, पापण्‌या पटकारता वार मे, छेलु फेपार्‌यु वागतेत आपणो सीको बदली जहे। काहाके फेपार्‌यु वगाड़हे, अने मर्‌या-ह़र्‌या माणहु, खत्‌तम नी हये एसवा जलमका डील मे, पासा जीवता हय्‌न बठा हयहे, अने आपणु, जे तीहयी टेमे जीवत्‌ला रेहु, ता आपणो सीको बदली जहे। <verse eid="1CO 15:52" /><verse number="53" style="v" sid="1CO 15:53" />काहाके रद्‌दी डील ने खत्‌तम नी हय एसवु डील पेरवानुत से, अने मरला डील ने अमरकायु डील पेरवानुत से। <verse eid="1CO 15:53" /><verse number="54" style="v" sid="1CO 15:54" />अने जत्‌यार आहयु रद्‌दी डील खत्‌तम नी हय एसवु डील पेर लेहे, अने आहयु मरलु डील अमरकाय नु जलमकु डील पेर लेहे, ता खरला सास्‌तर मे लीखलो आहयो बोल पुरो हय जहे: “जीक मोत ने गळ जी।”<verse eid="1CO 15:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="1CO 15:55" />ए मोत तारी जीक कां से?</para>
  <para style="q2" vid="1CO 15:55">ए मोत तारी आळ कां से?<verse eid="1CO 15:55" /></para>
  <para style="m">
    <verse number="56" style="v" sid="1CO 15:56" />मोत नी आळ ते पाप से, अने मुसा ना कायदा सी पाप नो जोर वदे। <verse eid="1CO 15:56" /><verse number="57" style="v" sid="1CO 15:57" />पण मे भगवान ने तु घणो वारु से केम, काहाके भगवान आपणु ने मालीक ईसु मसी नी लारे पाप ने जीकवा नो जोर आपे।<verse eid="1CO 15:57" /></para>
  <para style="p">
    <verse number="58" style="v" sid="1CO 15:58" />एतरे मारा मोंगाळ्‌ळा भायु तमु भरहा मे टणका रेवो, अने मालीक ईसु ना काम मे वद्‌ता जावो, काहाके तमने मालम से के मालीक ईसु मे तमारी मेहनत अमथी नी हय।<verse eid="1CO 15:58" /></para>
  <chapter eid="1CO 15" />
  <chapter number="16" style="c" sid="1CO 16" />
  <para style="s">ईसु पोर भरहो करन्‌या जुगु भेट करवा ना बारा मे</para>
  <para style="p">
    <verse number="1" style="v" sid="1CO 16:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:1 </char>
      <char style="xt" closed="false">
        <ref loc="ROM 15:25">रोमीयो 15:25</ref>,<ref loc="ROM 15:26">26</ref></char>
    </note>हाव, तीहयी भेट ना बारा मे जे भेट ईसु पोर भरहो करन्‌या चोखला माणहु जुगु भेळी करे। आहयी भेट ना बारा मे जीसम मे गलातीया जीला मे वाळी ईसु नी मंडळी ने हुकम आपलो हतो, तेमेत मे तमने बी हुकम आपु। <verse eid="1CO 16:1" /><verse number="2" style="v" sid="1CO 16:2" />हप्‌ता ना पेल्‌ना दाड़े तमु आखा थोड़ु-थोड़ु करीन तमारी कमाय मे गेथु भेळा करता रेवो। आनीन करीन के मे आवु तीहयी टेमे तमने भेट नी करवा पड़े। <verse eid="1CO 16:2" /><verse number="3" style="v" sid="1CO 16:3" />मे तमारीन्‌तां आवही तीहयी टेमे तमु टाळहु तीहया माणेह ने ओळखाण नी चीट्‌ठी लीखीन तमारी भेट भेळ तीने यरुसलेम ह़ेर मोकली देही। <verse eid="1CO 16:3" /><verse number="4" style="v" sid="1CO 16:4" />कदीम मने बी जवा पड़े, ता तीहया मार ह़ाते यरुसलेम आवहे।<verse eid="1CO 16:4" /></para>
  <para style="s">पोलुस नु यात्‌रा नु काम</para>
  <para style="p">
    <verse number="5" style="v" sid="1CO 16:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:5 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:21">नेवताळा ना काम 19:21</ref>
      </char>
    </note>मे मकीदुनीया परगणा मे जही, ता तमारीन्‌तां आवही, काहाके मे मकीदुनीया जवा करीनेत योजना बणावलो से। <verse eid="1CO 16:5" /><verse number="6" style="v" sid="1CO 16:6" />बण जहे ता मे तमारी भेळतो रेही, खास करीन टाड नी टेम मे तमारी ह़ाते रेही, आनीन करीन के तमु मने मे जां ह़ारीक जवा हींडु, तां जवा करीन वळाय सको। <verse eid="1CO 16:6" /><verse number="7" style="v" sid="1CO 16:7" />मे चालु-चालुत तमने भेटवा नी हेर नी करतो, पण मारी आह आहयी से के मालीक ईसु नी मरजी हय, ता मे जरीक वार लग तमारी ह़ाते रेही।<verse eid="1CO 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1CO 16:8" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:8 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:8-10">नेवताळा ना काम 19:8-10</ref>
      </char>
    </note>पण मे पेन्‌तीकुस्‌त तीवार आवता लग ईफीसुस मेत रेही। <verse eid="1CO 16:8" /><verse number="9" style="v" sid="1CO 16:9" />काहाके मने भगवान नु काम करवा करीन मने वारलो मोखो जड़ जेलो से, अने तां ह़ारीक वीरोदी माणहु बी घण-जबर वद जेला से।<verse eid="1CO 16:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1CO 16:10" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:10 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 4:17">1 कुरन्‌थी 4:17</ref>
      </char>
    </note>कदीम तीमुथीयुस आय लागहे, ता तीनो आव-भाव करीन धीयान राखजो काहाके तीहयो बी मारीन तेमेत मालीक ईसु नु काम कर र्‌यो। <verse eid="1CO 16:10" /><verse number="11" style="v" sid="1CO 16:11" />एतरे हीने बी हेटो नी ह़मज्‌जो। पण हीने सांती सी मारीन्‌तां मोकली देजो। काहाके तीहयो ईसु पोर भरहो करन्‌या टाळला भायु नी भेळतो आवहे, करीन मे तीनी वाट जोय र्‌यो।<verse eid="1CO 16:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1CO 16:12" />भाय अपुल्‌लोस ना बारा मे आहयी वात से के मे हीने घण-जबर रावण्‌या करीन तमारीन्‌तां मोकल्‌यो, पण भगवान नी मरजी हती एतरे तीहयो हमणे तमारीन्‌तां नी आयो। एतरे अळतेण मोखो जड़हे, ता मे हीने तमारीन्‌तां मोकली देही।<verse eid="1CO 16:12" /></para>
  <para style="s">आखरी हुकम अने घणो वारु से केम</para>
  <para style="p">
    <verse number="13" style="v" sid="1CO 16:13" />जाळवीन रेवो, ईसु पोर पक्‌को भरहो राखो, हीमम्‌त राखो अने जोराका बणो <verse eid="1CO 16:13" /><verse number="14" style="v" sid="1CO 16:14" />तमु जे बी काम करो तीहयु काम मोंग सी करो।<verse eid="1CO 16:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1CO 16:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:15 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 1:16">1 कुरन्‌थी 1:16</ref>
      </char>
    </note>ए भायु, अने बेन्‌या तमु स्‌तीफनुस ना घोराणा ने जाणो, तीहयो अखाया परगणा मे आखा नी पेले ईसु पोर भरहो करला, अने तमु बी ईसु पोर भरहो करन्‌या चोखला माणहु नी चाकरी करवा जलम तीयार रेवो। <verse eid="1CO 16:15" /><verse number="16" style="v" sid="1CO 16:16" />एतरे मे तमारी सी रावण्‌या करु के तमु एसवी चाकरी करन्‌या नी हक मे रेवो, जे एसवा कामु मे सात देय अने काठी मेहनत करे।<verse eid="1CO 16:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1CO 16:17" />स्‌तीफनुस, फुरतुनातुस, अने अखयकुस आयो करीन मे खुस से। काहाके जे काम तमने नी बण्‌यु तीहयु काम तीहया करीन देखाड़ देदला से। <verse eid="1CO 16:17" /><verse number="18" style="v" sid="1CO 16:18" />तीहया, मारी अने तमारी आत्‌मा ने सुक आपला से। एतरे एसवा माणहु नी तमु ईज्‌जत करो।<verse eid="1CO 16:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1CO 16:19" />
    <note caller="+" style="x">
      <char style="xo" closed="false">16:19 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:2">नेवताळा ना काम 18:2</ref>
      </char>
    </note>आसीया परगणा मे रेवा वाळी ईसु नी मंडळी भणी गेथो मे तमने आवहु अने आवजो केम। अक्‌वीला अने पीरीस्‌कीला ना घोर मे भेळी हयवा वाळी मालीक ईसु नी मंडळी भणी गेथो बी मे तमने पुरा मन सी आवहु अने आवजो केम<verse eid="1CO 16:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1CO 16:20" />ईसु पोर भरहो करन्‌या आखा भायु भणी गेथो मे तमने आवहु अने आवजो केम: मसी ना मोंग सी, तमु आंबा-सांबा, वारला से के? करीन पुछो।<verse eid="1CO 16:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1CO 16:21" />मे पोलुस तमने मारे हाते करीन चीट्‌ठी लीखीन आवही अने आवजो की र्‌यो।<verse eid="1CO 16:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1CO 16:22" />कदीम कोय मालीक ईसु मे एक-बीजा ने मोंग नी करे, तीनी पोर गरा आय पड़े! अमारा मालीक आव!<verse eid="1CO 16:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1CO 16:23" />मालीक ईसु मसी नी दया तमने जड़ती रेवा जोवे।<verse eid="1CO 16:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1CO 16:24" />मारो मोंग ईसु मसी मे तमु आखा मे जलमको रेवा जोवे। आमीन।<verse eid="1CO 16:24" /></para>
  <chapter eid="1CO 16" />
</usx>