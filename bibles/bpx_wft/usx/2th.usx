<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="2TH" style="id">- Paliya</book>
  <para style="h">2 थीसलुनीकीयो</para>
  <para style="toc3">2 थीसलुनीकीयो</para>
  <para style="toc2">2 थीसलुनीकीयो</para>
  <para style="toc1">थीसलुनीकीयो ना नाम पोलुस नी बीजी चीट्‌ठी</para>
  <para style="mt2">थीस्‌सलुनीकियों के नाम पोलुस की दुसरी पत्री</para>
  <para style="mt1">थीसलुनीकीयो ना नामे पोलुस नी बीजी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">थीसलुनीकीयो जुगु पोलुस नेवताळान्‌तां गेथी बीजी चीट्‌ठी। <char style="xt"><ref loc="2TH 1:1">1:1</ref></char> आहयी बीजी थीसलुनीकीयो नी लीखली चीट्‌ठी. पेली चीट्‌ठी लीखवान अळतेण मसी ना पयदा हयवान 51 साल नी आड़े-धेड़े लीख्‌यो, जत्‌यार तीहयो आहयी चीट्‌ठी लीख्‌यो ता तीहयो कुरन्‌थी ह़ेर मे हतो। अने पोलुस बीजी मीसनरी यात्‌रा नी टेमे एक मंडळी बणावलो। <char style="xt"><ref loc="ACT 17:1-10">नेवताळा ना काम 17:1-10</ref></char> आहयी नेवताळा ना काम नी कीताप मे देखाड़े के मंडळी युहदी अने आड़जात्‌या नी बणली हती।</para>
  <para style="ip">आहयी मंडळी ना माणहु आखरी टेम अने मालीक नी बीजी कावा आव्‌वा ना बारा मे घण-जबर पोलुस आह़फा नी बेम चीट्‌ठी मे वात करे, आहयी जे बीजी थीसलुनीकीयो. आहयी चीट्‌ठी नो आदो हीस्‌सो आखरी टेम ना बारा मे से, पोलुस आहयी, अने तीहयो आहयु केय के आखा माणहु आह़फा नु पेट भरवा जुगु काम करे। <char style="xt"><ref loc="2TH 3:6-10">3:6-10</ref></char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पोलुस आह़फा नी अने आह़फा ना ह़ाती नी ओळखाण करे। <char style="ior"><ref loc="2TH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. पोलुस थीसलुनीकीयो नी मंडळी जुगु भगवान ने घणो वारु केय अने तीमनी जुगु वीन्‌ती। <char style="ior"><ref loc="2TH 1:3-12">1:3-12</ref> </char></para>
  <para style="io1">3. आखरी टेम ना बारा मे वात। <char style="ior"><ref loc="2TH 2">2</ref> </char></para>
  <para style="io1">4. ओगज्‌या ना बारा मे अने काम करवा ना बारा मे तीनी ह़ीकापण। <char style="ior"><ref loc="2TH 3:1-15">3:1-15</ref> </char></para>
  <para style="io1">5. पोलुस नु अळी आवजो अने आवही केणु। <char style="ior"><ref loc="2TH 3:16-18">3:16-18</ref> </char></para>
  <chapter number="1" style="c" sid="2TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="2TH 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:1">नेवताळा ना काम 17:1</ref>
      </char>
    </note>मे पोलुस सीलवानुस अने तीमुथीयुस ह़ाते आहयी चीट्‌ठी लीखु, आपणा बाह भगवान अने मालीक ईसु मसी ना माणहु ने जे थीसलुनीकीयो नी मंडळी मे से।<verse eid="2TH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="2TH 1:2" />आपणा बाह भगवान अने मालीक ईसु मसी भणी गेथी तमने दया अने सांती जड़ती रेय।<verse eid="2TH 1:2" /></para>
  <para style="s">नीयाव नो दाड़ो</para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 1:3" />ए भायु, अने बेन्‌या तमारा बारा मे आमने आखी टेमे भगवान ने घणो वारु से केवा जोवे, अने आहयु वारु से। आनीन करते के तमारो भरहो घण-जबर अगो वदतो जाय, अने तमारो आखा नो मोंग आखा तमारी ह़ाते घण-जबर वदतो जाय। <verse eid="2TH 1:3" /><verse number="4" style="v" sid="2TH 1:4" />आञे तक के आमु भगवान नी मंडळी मे तमारा बारा मे मोटाय बी करया के जेतरा दुख अने वेला तमु धीरा रीन झेले, तीमनी आखा मे गम खावा नी सक्‌ती अने भरहो उजन्‌तो हये।<verse eid="2TH 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 1:5" />आहयी भगवान ना खरला नीयाव नी वारु गवा से के तमु भगवान ना राज मे जाय एवा ठेरो, जीनी जुगु तमु दुख बी झेलो। <verse eid="2TH 1:5" /><verse number="6" style="v" sid="2TH 1:6" />भगवान ने तां आहयो नीयाव से जे तमने दुख आपे तीमने बदला मे दुख आपो। <verse eid="2TH 1:6" /><verse number="7" style="v" sid="2TH 1:7" />अने तमु दुख झेलवा वाळा ने अमारी ह़ाते अराम आपो; जत्‌यार मालीक ईसु जोरभर्‌या ह़रगदुत ह़ाते होळो-होळो आक्‌ठु मे गेथो उजन्‌तो आवहे। <verse eid="2TH 1:7" /><verse number="8" style="v" sid="2TH 1:8" />अने जे भगवान ने नी ओळखता अने आपणा ईसु मसी नी खुस-खबर ने नी मान्‌ता तीमनी ह़ाते बदलो लेहे। <verse eid="2TH 1:8" /><verse number="9" style="v" sid="2TH 1:9" />तीहया मालीक नी अगळ गेथा अने तीनी सक्‌ती नु वीजाळु सी सेटा हय जहे अने जलम खुट जवा नो डंड झेलहे। <verse eid="2TH 1:9" /><verse number="10" style="v" sid="2TH 1:10" />अने आहयु तीहया दाड़े हयहे, जत्‌यार तीहयो आह़फा ना चोखला माणहु मे बड़ाय देखवा अने आखा भरहो करवा वाळा माणहु मे वहरायवा नु कारण हयवा मे आवहे, काहाके तमु अमारी गवाय पोर भरहो करला से।<verse eid="2TH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 1:11" />आनीन करते आमु तमारी जुगु दाड़ीन वीन्‌ती बी करया के अमारो भगवान तमने बोलायो तीनी लायक ह़मजे, अने भलाय नी आखी मरजी अने भरहा ना आखा काम ने ताखत भेळ पुरा करे। <verse eid="2TH 1:11" /><verse number="12" style="v" sid="2TH 1:12" />काहाके आपणा भगवान अने मालीक ईसु मसी नी दया नी अनसारे आपणा मालीक ईसु नु नाम तमारी मे बड़ाय देखे, अने तमु तीनी मे देखे।<verse eid="2TH 1:12" /></para>
  <chapter eid="2TH 1" />
  <chapter number="2" style="c" sid="2TH 2" />
  <para style="s">पाप नो अदमी मतलब खत्‌तम हयवा वाळु नो सोरो</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="1TH 4:15-17">1 थीसलुनीकीयो 4:15-17</ref>
      </char>
    </note>ए भायु, अने बेन्‌या, हाव आमु आपणा ईसु मसी ने आव्‌वा ना, अने तीनीन्‌तां एकठा हयवा ना बारा मे तमारी पांह वीन्‌ती करया। <verse eid="2TH 2:1" /><verse number="2" style="v" sid="2TH 2:2" />अने कानी भगवान नी खबर, नीता बोलु, नीता चीट्‌ठी नी लारे मान लेवो जे अमारीन्‌तां गेथी हय अने आहयु ह़मजाड़े के मालीक ना दाड़ा आय ज्‌या ता तमारा मन मे उचकाहलात कमजोर नी हयजो अने नी दुखी हय जो। <verse eid="2TH 2:2" /><verse number="3" style="v" sid="2TH 2:3" />कानी बी रीते कोयना धोका मे नी आवजे, काहाके जत्‌यार तक भगवान ना वीरोद मे आखरी वीरोद नी हये तां तक, अने तीहया वेरी माणहे ने नरक मे नाखीन खत्‌तम नी कर देय, तीहयो उजन्‌तो नी हये। <verse eid="2TH 2:3" /><verse number="4" style="v" sid="2TH 2:4" />तीहयो वेरी भगवान नो भक्‌ती नी चीज नो वीरोद करे, अने आखा माणहु ने चोखलो नीता भगवान केवाड़े, नीता आह़फा ने मोटो बणावे, आञे तक के तीहयो भगवान ना मंदीर मे बहीन आह़फा ने भगवान बणावे।<verse eid="2TH 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 2:5" />ह़ु तमने मालम नी हय, जत्‌यार मे तमारी ह़ाते हतो, ता तमने आहयी वात कीया करतो हतो। <verse eid="2TH 2:5" /><verse number="6" style="v" sid="2TH 2:6" />तमु तीहयी वात ने जाणो। के जे वेरी ने हजु लग आव्‌वा सी उजन्‌तो हयवा सी रोक री। <verse eid="2TH 2:6" /><verse number="7" style="v" sid="2TH 2:7" />काहाके वेरी नी ह़तायली सक्‌ती हमणे बी काम करती जाय री, पण हजु एक रोकवा वाळो से, अने जत्‌यार तक तीहयो सेटो नी हय जाय तीहयो रोकी राखहे। <verse eid="2TH 2:7" /><verse number="8" style="v" sid="2TH 2:8" />ता तीहयो वेरी उजन्‌तो हयहे, पण जत्‌यार ईसु मसी आवहे ता आह़फा ना मोडा नी फुक सी मार नाखहे, अने तीना आव्‌वा ना तेज सी रोखड़ो बणाय देहे। <verse eid="2TH 2:8" /><verse number="9" style="v" sid="2TH 2:9" /><note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="MAT 24:24">मत्‌ती 24:24</ref></char></note>तीहया वेरी नु आवणु भुतड़ा ना काम नी अनसारे आखी भाती नी झुटी ताखत, अने सेलाणी अने घणा जुदा-काम नी ह़ाते; आवहे। <verse eid="2TH 2:9" /><verse number="10" style="v" sid="2TH 2:10" />अने खत्‌तम हयवा वाळा जुगु तीहयो तीमने फसाड़वा करीन वण-धरम ना कामु करहे; काहाके तीहया सच्‌चाय ह़ाते मोंग नी कर्‌या जीनी सी तीमनो छुटकारो हयवा वाळो हतो। <verse eid="2TH 2:10" /><verse number="11" style="v" sid="2TH 2:11" />आनीन करते भगवान तीमनीन्‌तां भटकाड़वा वाळी सक्‌ती ने मोकल्‌हे अने तीहया झुट नी मानहे। <verse eid="2TH 2:11" /><verse number="12" style="v" sid="2TH 2:12" />काहाके जेतरा माणहु सच्‌चाय ने नी माने अने अधरम सी खुस हये, तीमने आखा ने डंड जड़हे।<verse eid="2TH 2:12" /></para>
  <para style="s">वातड़ा रेवो</para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 2:13" />ए भायु, अने बेन्‌या अने मालीक ना मोंगाळ्‌ळा माणहु, आमु तमारा बारा मे जलम भगवान ने घणो वारु से केता रीया, काहाके भगवान सुरु गेथो तमने टाळ लेदलो से; के आत्‌मा नी लारे चोखला बणीन, अने सच्‌चाय ने मानीन छुटकारो हात करो, <verse eid="2TH 2:13" /><verse number="14" style="v" sid="2TH 2:14" />जीनी जुगु तीहयो तमने अमारा खुस-खबर नी लारे बोलावलो से, के तमु मालीक ईसु मसी ना बड़ाय मे साजल्‌या बणो। <verse eid="2TH 2:14" /><verse number="15" style="v" sid="2TH 2:15" />आनीन करते ए भायु, अने बेन्‌या वातड़ा रेवो, अने जे-जे वात अने बोलु नीता अमारी चीट्‌ठी नी लारे ह़ीकला से, तीने मान्‌ता रेवो।<verse eid="2TH 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 2:16" />आपणो मालीक ईसु मसी आह़फोत, अने आपणो बाह भगवान, जे आपणी ह़ाते मोंग कर्‌यो अने दया सी जलम नो बड़ावो अने आखा गेथी वारु आह आपलो से। <verse eid="2TH 2:16" /><verse number="17" style="v" sid="2TH 2:17" />तमारा मन मे बड़ावो आपे अने तमने आखा वारला काम अने भगवान ना बोलु मे वातड़ो करे।<verse eid="2TH 2:17" /></para>
  <chapter eid="2TH 2" />
  <chapter number="3" style="c" sid="2TH 3" />
  <para style="s">वीन्‌ती करवा नो वेहवार</para>
  <para style="p">
    <verse number="1" style="v" sid="2TH 3:1" />आखरी मे भायु, अने बेन्‌या, अमारी जुगु वीन्‌ती कर्‌या करो, के मालीक ना बोलु एतरा सोटा फेले, के ईज्‌जत भेळ माने, जेम तमारी वच मे हयु। <verse eid="2TH 3:1" /><verse number="2" style="v" sid="2TH 3:2" />अने आमु गांडा अने भुतड़ान तेवा माणहु सी बचीन रेवो काहाके आखा माणहु खुस-खबर पोर भरहो नी कर्‌या।<verse eid="2TH 3:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="2TH 3:3" />पण मालीक भरहो करे एवो से, तीहयो तमने वातड़ा करहे, अने तीहया भुतड़ान तेवा माणेह सी ह़माळीन राखहे। <verse eid="2TH 3:3" /><verse number="4" style="v" sid="2TH 3:4" />आमने मालीक मे तमारी पोर भरहो से के जे-जे हुकम आमु तमने आपया, तीमने तमु माने, अने अगा मान्‌ता बी रेहु।<verse eid="2TH 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="2TH 3:5" />मालीक, भगवान ना मोंग अने मसी ना गम भणी तमारा मन नी अगवाय करे।<verse eid="2TH 3:5" /></para>
  <para style="s">ओगज्‌या ने चेतावणी</para>
  <para style="p">
    <verse number="6" style="v" sid="2TH 3:6" />ए भायु, अने बेन्‌या, आमु तमने आपणा मालीक ईसु मसी ना नाम सी हुकम आपया; के आखा एवा भरहो करन्‌या भाय सी अलग रेवो, जे वारु चाल नी चाले, अने जे ह़ीकापण तीहयो अमारी लारे ह़ीकलो अने तीनी अनसारे नी करतो। <verse eid="2TH 3:6" /><verse number="7" style="v" sid="2TH 3:7" />तमु खुद बी जाणो, के कानी बी रीते अमारीन तेवी चाल चालवा जोवे; काहाके आमु तमारी वच मे हता ता ओगज्‌या नी हता। <verse eid="2TH 3:7" /><verse number="8" style="v" sid="2TH 3:8" />अने कोयना बी रोट्‌ला फीरी मे नी खादा; पण वेला अने मेहनत करीन रात-दाड़ो काम धन्‌दो करता हता, के तमारी माय्‌न कोय पोर बी बोज नी पड़े। <verse eid="2TH 3:8" /><verse number="9" style="v" sid="2TH 3:9" />आहयु आना कारण सी नी हय के तमारी पांह मदत मांगवा नो हक नी हय, पण आमु आमने तमारी अगळ वारु ईज्‌जत वाळा देखाया के तमु अमारीन तेवी चाल चालो। <verse eid="2TH 3:9" /><verse number="10" style="v" sid="2TH 3:10" />काहाके जत्‌यार आमु तमारीन्‌तां हता, तत्‌यार बी तमने आहयो हुकम आप्‌ता हता के कोय बी काम करवा नी हींडे ता खावा बी नी जोवे।<verse eid="2TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="2TH 3:11" />आमु ह़मळया के थोड़ाक माणहु तमारी वच मे ओगज्‌या से अने कंय काम नी करता पण बीजा ना काम मे हात नाख्‌या करे। <verse eid="2TH 3:11" /><verse number="12" style="v" sid="2TH 3:12" />एवा माणहु ने आमु मालीक ईसु मसी मे हुकम आपया, अने ह़मजाड़या के होगा-होगा काम करीन आह़फाम ना रोट्‌ला खाया करे।<verse eid="2TH 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="2TH 3:13" />तमु, ए भायु, अने बेन्‌या भलाय करवा मे हीम्‌मत ना सोड़ो। <verse eid="2TH 3:13" /><verse number="14" style="v" sid="2TH 3:14" />कदीम कोय अमारी आहयी चीट्‌ठी नी वात ने नी माने ता तीमने भाळता रेवो, अने तीमनी ह़ाते ना रेवो, जीनी सी तीहया लाजे पड़े। <verse eid="2TH 3:14" /><verse number="15" style="v" sid="2TH 3:15" />ते बी तीमने वेरी ना ह़मजो, पण भरहो करन्‌या भाय जाणीन चेतावो।<verse eid="2TH 3:15" /></para>
  <para style="s">आखरी वात</para>
  <para style="p">
    <verse number="16" style="v" sid="2TH 3:16" />हाव सांती नो मालीक आह़फोत तमने जलम अने आखी भाते सांती आपे। अने मालीक तमारी आखा ह़ाते रेय।<verse eid="2TH 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="2TH 3:17" />मे पोलुस, मारात हात सी आवजो अने आवही करीन लीखु। आखी चीट्‌ठी मे मारी आहयीत सेलाणी से; मे आहयीत रीते लीखु।<verse eid="2TH 3:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="2TH 3:18" />आपणा मालीक ईसु मसी नी दया तमारी आखा पोर हयती रेय।<verse eid="2TH 3:18" /></para>
  <chapter eid="2TH 3" />
</usx>