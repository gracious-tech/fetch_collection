<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JUD" style="id">- Paliya</book>
  <para style="h">यहुदा</para>
  <para style="toc3">यहुदा</para>
  <para style="toc2">यहुदा</para>
  <para style="toc1">यहुदा नी चीट्‌ठी</para>
  <para style="mt2">यहुदा की पत्री</para>
  <para style="mt1">यहुदा नी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">यहुदा नी आहयी चीट्‌ठी नु नाम आना लीखण्‌या ना नाम पोर राखलु से। यहुदा आह़फा ने याकुब, ईसु ना भाय याकुब ना वेह मे ओळखे। आनी लेदे हीयो ईसु ना भायु मे गेथो एक मनायत्‌लो। <char style="xt"><ref loc="JUD 1:1">1</ref></char> आमु नी जाणता केता के आहयी चीट्‌ठी एक खास मंडळी ना लेदे हती अने पुराणा कायदा नी जानकारी ना कारण सी, आहयु हय सके के यहुदा नी चीट्‌ठी ने खास भणन्‌या युहदी हता। पण तीहयी आपणी चीट्‌ठी ना बारा मे देखाड़त्‌लो, तीमने आखा ने जीने बोलावला हता, जीने बाह सी मोंग से अने ईसु मसी नी लेदे राखलु से <char style="xt"><ref loc="JUD 1:1">1</ref></char> आहयी चीट्‌ठी हय सके ईसु मसी ना पयदा हयवा ना 60 साल नी अळतेण लीखली हती।</para>
  <para style="ip">तीनो वीच्‌यार आहयो हतो के तीमने झुटा गुरु ना लारे भटकवा ना वीरोद मे चेतावणी आपे। <char style="xt"><ref loc="JUD 1:4">यहुदा 1:4</ref></char> तीहयो पुराणा कायदा नी वीतली वात अने जेड़ ने तीमना तरीका ने ताखत आपवा नी लेदे लीखत्‌लो से। आहयी चीट्‌ठी 2 पतरस ना ह़ाते झुटा गुरु <char style="xt"><ref loc="JUD 1:4">यहुदा 1:4</ref></char> <char style="xt"><ref loc="2PE 2:1">2 पतरस 2:1</ref></char> ना ह़ाते-ह़ाते ह़रगदुतु अने सदोम अने अमोरा नी वात ना वीरोद मे चेतावणी भेळ कंय वीच्‌यार साजी करत्‌लो से।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. यहुदा पेले आपणा भणवा वाळा ना बारा मे देखाड़े। <char style="ior"><ref loc="JUD 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. तीनीन अळतेण, तीहयो लीखवा नो आह़फा नो कारण आपे। जे तीमने झुटा ह़ीकाड़न्‌या ना वीरोद मे चेतावणी आपे। <char style="ior"><ref loc="JUD 1:3-4">1:3-4</ref></char></para>
  <para style="io1">3. तीनीन अळतेण तीहयो पुराणा कायदा मे माणहु अने वीतली वात ना उदारण आपे। <char style="ior"><ref loc="JUD 1:5-16">1:5-16</ref></char></para>
  <para style="io1">4. अळी तीहयो तीमने देखाड़े के तीमना वीच्‌यार नी चेतावणी ह़ु हयवा जोवे। <char style="ior"><ref loc="JUD 1:17-23">1:17-23</ref></char></para>
  <para style="io1">5. आखरी मे तीहयो भगवान नी भक्‌ती करवा वाळी चीट्‌ठी ने बंद कर देय। <char style="ior"><ref loc="JUD 1:24-25">1:24-25</ref></char></para>
  <chapter number="1" style="c" sid="JUD 1" />
  <para style="p">
    <verse number="1" style="v" sid="JUD 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:55">मत्‌ती 13:55</ref>; <ref loc="MRK 6:3">मरकुस 6:3</ref></char>
    </note>यहुदा भणी गेथो, जे ईसु मसी नो चाकर्‌यो अने याकुब नो भाय से, तीहया बोलाव्‌ला ना नाम जे भगवान बाह मे मोंगाळ्‌ळा अने ईसु मसी नी लेदे बचाड़ला से।<verse eid="JUD 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="JUD 1:2" />मोंग, दया अने सांती तमने ढेरेत जड़ती रेय।<verse eid="JUD 1:2" /></para>
  <para style="s">झुटा मास्‌तर्‌या</para>
  <para style="p">
    <verse number="3" style="v" sid="JUD 1:3" />ए मोंगाळ्‌ळा, भायु-बेन्‌या जत्‌यार मे तमने तीहया छुटकारा ना बारा मे लीखवा मे घणी मेहनत करतो हतो जीनी मे आपणु आखा साजल्‌या से, ता मे तमने आहयु ह़मजाड़वा जरुड़ी जाण्‌यो के तीहया भरहा नी लेदे पुरी मेहनत करो जे चोखला माणहु ने एकीत कावा आखा जुगु आपलु हतु। <verse eid="JUD 1:3" /><verse number="4" style="v" sid="JUD 1:4" />काहाके केतरा एवा माणहु होगात अमारी मे आवीन भेसकायला से, जीनी सी आहया माणहु ना डंड ना बारा मे पेल्‌ना वारा मे पेले गेथुत लीखाय जेलु हतु: आहया वण-भक्‌ती ना से, अने अमारा भगवान नी दया ने लुच्‌चाय मे बदल देत्‌ला से, अने अमारा एकीत मालीक अने मालीक ईसु मसी ने नी मानवा वाळा से।<verse eid="JUD 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JUD 1:5" />पण आनीन लेदे तमु आखी वात एक कावा जाण लेदला से, ते बी मे तमने आहयी वात नी फोम कराव्‌वा हेर करु के मालीक एक ईस्‌रायल ने मीस्‌र देस सी छोड़ाव्‌वान बाद भरहो नी करन्‌या ने खत्‌तम कर देदो। <verse eid="JUD 1:5" /><verse number="6" style="v" sid="JUD 1:6" />अळतेण जे ह़रगदुत आपणा जागा ने टेकलो नी राख्‌यो पण आपणु खास रेवा ना जागा ने सोड़ देदा, तीहयो तीमने बी तीहया काठला दाड़ा ना नीयाव नी लेदे अंदारला मे, जे हमेसा नी लेदे से बांदीन राख्‌यो। <verse eid="JUD 1:6" /><verse number="7" style="v" sid="JUD 1:7" />जीने रीते सदोम अने अमोरा अने तीनी आड़े-धेड़े वाळा ह़ेर जे आमनीन तेम छीनाळ्‌या हय जेला हता, अने बीजा ना डील नी पसळ लाग जेला हता, तीहया आक्‌ठा ना जलम ना डंड मे पड़ीन दाखलो ठेर्‌या।<verse eid="JUD 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JUD 1:8" />तीहयी रीते आहया ह़पनु देखण्‌या बी आपणा-आपणा डील ने बगाड़ देय, अने भगवान ना हक ने तीहया कंय नी जाणे, अने ह़रगदुत ने बुरु-भलु केय। <verse eid="JUD 1:8" /><verse number="9" style="v" sid="JUD 1:9" /><note caller="+" style="x"><char style="xo" closed="false">1:9 </char><char style="xt" closed="false"><ref loc="REV 12:7">परकासीतवाक्‌य 12:7</ref></char></note>पण डायलो ह़रगदुत मीकाईल, जत्‌यार भुतड़ा सी मुसा ना धोड़ ना बारा मे वात कर्‌यो, ता तीने भलु-बुरु कीन गुनो लगाड़वा नी हीम्‌मत नी कर्‌यो पण आहयु केदो, “मालीक तने वडे।” <verse eid="JUD 1:9" /><verse number="10" style="v" sid="JUD 1:10" />पण आहया माणहु तीहयी वातु ने नी जाणता अने तीमने भलु-बुरु केय। अने तीहयी वातु ने जंगली जानवर्‌यान तेवा वेहवार सी, ह़मजत्‌ला, तीनी मे आह़फा ने खुटाड़त्‌ला से। <verse eid="JUD 1:10" /><verse number="11" style="v" sid="JUD 1:11" />तीमनी पोर गरा! काहाके तीहया केन नी तेम चाल्‌या, अने दाड़की नी लेदे बीलाम नी तेम गंडवाय ज्‌या, अने कोरह नी तेम झगड़ो करीन मर ज्‌या। <verse eid="JUD 1:11" /><verse number="12" style="v" sid="JUD 1:12" />आहया तमारी मोंग नी बठक मे तमारी ह़ाते खाय-पीय, दर्‌या मे ह़तायला दगड़ान तेम से, अने आह़फा नु पेट भरवा मे ध्‌यान राखत्‌ला से; तीहया पाणी वगर नु वादळु से, जीने वाहळु उडाड़ ली जाय; आहया आसवा झाड़का से, जे फालवा नी टेम पोर बी नी फाले, जे बे कावा मर जाय, अने मुळ्‌या भेळ उखड़ी ज्‌या, <verse eid="JUD 1:12" /><verse number="13" style="v" sid="JUD 1:13" />आहयी दर्‌या नी जंगली झलक से, जे आपणी वणलाज नी फेण उछाळे; आहया भटकत्‌ला चांदणा से, जीमनी वाटु हमेसा नी लेदे घणु अंदारलु मेकलु से।<verse eid="JUD 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="JUD 1:14" />हनोक बी जे आदम सी ह़ातवी पीड़ी मे हतो, ईमना बारा मे भगवान भणी गेथा वात करन्‌या ईसम केदा, “ह़मळो, मालीक आपणा लाखु चोखला ह़रगदुत ह़ाते आवहे <verse eid="JUD 1:14" /><verse number="15" style="v" sid="JUD 1:15" />के आखाम नो नीयाव करे, अने आखा वण-भक्‌ती ना माणहु ने तीमना आखा बुरा कामु ना बारा मे जे तीहया वण-भकत्‌या हय्‌न करला से, अने तीहयी आखी वातड़ी वातु ना बारा मे जे वण-भक्‌ती ना पापी माणहु तीना वीरोद मे केदला से, गुनाळ्‌ळा ठेरावहे।”<verse eid="JUD 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JUD 1:16" />आहया ते नराज, कुड़कुड़ करवा वाळा, अने आह़फा ना डील नी मरजी ना लारे चालवा वाळा से, अने आपणा मोडा सी घमंड नी वात बोलत्‌ला से, अने फायदा नी लेदे मोडु देखीन ईज्‌जत कर्‌या करत्‌ला से।<verse eid="JUD 1:16" /></para>
  <para style="s">चेतावणी अने परच्‌यार</para>
  <para style="p">
    <verse number="17" style="v" sid="JUD 1:17" />पण ए मोंगाळ्‌ळा, तमु तीहयी वात ने फोम राखो जे अमारा मालीक ईसु मसी ना नेवताळा पेलेत की देदला से। <verse eid="JUD 1:17" /><verse number="18" style="v" sid="JUD 1:18" /><note caller="+" style="x"><char style="xo" closed="false">1:18 </char><char style="xt" closed="false"><ref loc="2PE 3:3">2 पतरस 3:3</ref></char></note>तीहया तमारी सी कीया करता हता, “सेला दाड़ा मे एसवा हाही करवा वाळा हयहे जे आह़फा नी वण-भक्‌ती नी हेर नी लारे चालहे।” <verse eid="JUD 1:18" /><verse number="19" style="v" sid="JUD 1:19" />आहया तीहया से जे बेरजाव पाड़वावाळा से; आहया डील नी मरजी ना अनसारे चालवा वाळा से जीनी मे भगवान नी आत्‌मा नी हय। <verse eid="JUD 1:19" /><verse number="20" style="v" sid="JUD 1:20" />पण ए मोंगाळ्‌ळा, तमु आपणा जबर चोखला भरहा मे वदता जीन अने चोखला आत्‌मा नी सक्‌ती मे वीन्‌ती करता जीन, <verse eid="JUD 1:20" /><verse number="21" style="v" sid="JUD 1:21" />आह़फात ने भगवान ना मोंग मे बणाय्‌न राखो; अने जलम नी जीवाय नी लेदे अमारा मालीक ईसु मसी नी दया नी वाट जोवता रेवो।<verse eid="JUD 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JUD 1:22" />तीमनी पोर जे सण्‌का मे से दया करो। <verse eid="JUD 1:22" /><verse number="23" style="v" sid="JUD 1:23" />अने घणात ने आक्‌ठा मे गेथा नीकाळो; अने तीमनी रखवाळी करो। घणाम नी पोर बीहता जीन दया करो, पण तीमना लुगड़ा सी ह़ीगी करो जे डील नी लारे बगड़ी ज्‌या।<verse eid="JUD 1:23" /></para>
  <para style="s">संयबरकत ना बोलु</para>
  <para style="p">
    <verse number="24" style="v" sid="JUD 1:24" />हाव जे तमने ठोकर खावा सी बचाड़ सकत्‌लो, अने आह़फा ना बड़ाय नी भरपुरी नी अगळ घणु खुस अने वण-गुनाळ्‌ळो करीन उबो कर सकत्‌लो से, <verse eid="JUD 1:24" /><verse number="25" style="v" sid="JUD 1:25" />तीहयो एकीत भगवान अमारो छुटकारो आपण्‌या नी बड़ाय अने ईज्‌जत अने आखा सी जोरभर्‌यो अने हकदार, अमारा मालीक ईसु मसी नी लारे जीसम सुरुवात नी टेम सी से, हमणे बी रेय अने जलमकी रेय। आमीन।<verse eid="JUD 1:25" /></para>
  <chapter eid="JUD 1" />
</usx>