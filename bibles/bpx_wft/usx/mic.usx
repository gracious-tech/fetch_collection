<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MIC" style="id">- Paliya New Testament</book>
  <para style="h">मीका</para>
  <para style="toc3">मीका</para>
  <para style="toc2">मीका</para>
  <para style="toc1">मीका</para>
  <para style="mt2">मीका नी कीताप</para>
  <para style="mt1">मीका</para>
  <para style="imt">जानकारी</para>
  <para style="ip">हेटी लीखली कीताप मे मीका नी भगवान वगे गेथी केदली वातु से। मीका यहुदा ना एक ह़ेर मोरेसेत सी हतो <char style="xt"><ref loc="MIC 1:1">1:1</ref></char> अने <char style="xt"><ref loc="JER 26:18">यीरम्‌या 26:18</ref></char>। तीहयो यहुदा ना राजा योताम, आहाज अने हीजकीय्‌याह ना राज करवा नी टेमे भगवान वगे गेथी वात केदो। आनु मतलब से के तीनी सेवा 750 साल ईसा पेले नी आड़े-धेड़े अने 700 ईसु पेले नी वच मे हती, जे के तीहयीत टेम नी आड़े-धेड़े से जत्‌यार यसाया अने होसे भगवान वगे गेथी वात केदला हता। आहयु मालम नी हय के मीका भगवान वगे गेथी केदली वात लीख्‌यो के तीनो कानो चेलो तीनी जुगु आसम कर्‌यो। काम जे बी हय, आसम लागे के कीताप 700 ईसा पेले अने 608 ईसा पेले नी वच मे लीखली से। काहाके आना बारा मे यीर्‌मयाह नी कीताप मे वात करली से।</para>
  <para style="ip">मीका नी भगवान वगे गेथी केदली वात भगवान ना नीयाव अने तीना छुटकारा नी वच मे अगी-पासी हया करे। तीहयो ईस्‌रायल अने यहुदा पोर गरीबु नी ह़ाते गलत वेहवार करवा अने लालची हयवा नो गुनो लगाड़े <char style="xt"><ref loc="MIC 2:2">2:2</ref></char>। तीहयो तीमना भगवान वगे गेथी वात केवा वाळाम गलत हयवा नो बी गुनो लगाड़े <char style="xt"><ref loc="MIC 2:6">2:6</ref></char>। करीन, भगवान तीमना ह़ेरु ने खत्‌तम कर देहे <char style="xt"><ref loc="MIC 1:6">1:6</ref>; <ref loc="MIC 3:12">3:12</ref></char> अने तीमने ईस्‌रायल गेथो नाम्‌बे अने अळतेण यहुदा गेथो बी गुलामी मे मोकल देहे। पण भगवान आह़फा ना वायदा ने बी फोम राखहे अने थोड़ाक भरहो करन्‌या ने पासो लावहे <char style="xt"><ref loc="MIC 4:6">4:6</ref></char>। भगवान बेतलहम मे गेथो एक अदीकार्‌यो, एक मसी ने मोकलवा नो बी वायदो करलो से, जे ईस्‌रायल पोर अने आखी कळी पोर राज करहे <char style="xt"><ref loc="MIC 5:4">5:4</ref></char>। मीका नी कीताप अब्‌राहम अने याकुब सी भगवान ना वायदा ने फोम करावती जाय्‌न खत्‌तम हये। भगवान नो मोंग अने दया तीनी रीह सी जादा बड़ीन से।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. नीयाव अने छुटकारा नो पेल्‌लो हीस्‌सो से। <char style="ior"><ref loc="MIC 1-2">1–2</ref> </char></para>
  <para style="io1">2. नीयाव अने छुटकारा नो बीजो हीस्‌सो से। <char style="ior"><ref loc="MIC 3-4">3–4</ref> </char></para>
  <para style="io1">3. नीयाव अने छुटकारा नो तीसरो अने आखरी हीस्‌सो से। <char style="ior"><ref loc="MIC 6-7">6–7</ref></char></para>
  <chapter number="1" style="c" sid="MIC 1" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 1:1" />यहोवा नो बोल, जे यहुदा देस ना राजा योताम, आहाज अने हीजकीयाह ना राज करवा ना दाड़ा मे मोरेसेत मे रेवा वाळा मीकान्‌तां पुग्‌यो, जीने तीहयो सामर्‌या ह़ेर अने यरुसलेम ना बारा मे देख्‌यो।<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 15:32-16:20">2 राजा 15:32–16:20</ref>; <ref loc="2KI 18:1-20:21">18:1–20:21</ref>; <ref loc="2CH 27:1-7">2 ईतीहास 27:1-7</ref>; <ref loc="2CH 28:1-32:33">28:1–32:33</ref></char></note><verse eid="MIC 1:1" /></para>
  <para style="s">सामर्‌या अने यरुसलेम नी लेदे दुख</para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 1:2" />ए राज्‌य-राज्‌य ना आखा माणहु ह़मळो, ए धरती अने धरती पोर रेवा वाळा आखा ध्‌यान देवो, मालीक यहोवा तमारा वीरोद मे अने मालीक आह़फा ना चोखला मंदीर मे गेथो तमारी गवाय देहे। <verse eid="MIC 1:2" /><verse number="3" style="v" sid="MIC 1:3" />देख, यहोवा आह़फा ना चोखला जागा मे गेथो बारो नीकळवा बाज र्‌यो, अने तीहयो उतरीन धरती ना उचा जागा पोर चालहे। <verse eid="MIC 1:3" /><verse number="4" style="v" sid="MIC 1:4" />ता बड़ा तीनी तळे गळ जहे, जीसम मोमबत्‌ती आक्‌ठु सी पीगळ जाय, अने घाट्‌या मे आसम वयहे जीसम पाणी घाट्‌या मे गेथु हेटु वये। <verse eid="MIC 1:4" /><verse number="5" style="v" sid="MIC 1:5" />आहयु आखु याकुब ना गुना अने ईस्‌रायल ना घोराणा ना पाप ना कारण हये। याकुब नो गुनो ह़ु से? ह़ु सामर्‌या नी हय? अने यहुदा ना उचा जागा ह़ु से? ह़ु यरुसलेम नी हय? <verse eid="MIC 1:5" /><verse number="6" style="v" sid="MIC 1:6" />मालीक केदो, “आहया कारण सी में सामर्‌या मे रेवा वाळा ने मयदान मेना ढेर बणाय देही, अने अंगुर नी वाड़ी लगाड़ही; अने में तीमना दगड़ा ने खोबारा मे गबड़ाय देही, अने तीमनी नीव उखड़ी देही। <verse eid="MIC 1:6" /><verse number="7" style="v" sid="MIC 1:7" />तीनी आखी बणावली मुरती ने टुकड़ा-टुकड़ा कर देहे; अने जे कंय तीहयो छीनाळु करीन कमायलो से तीने आक्‌ठु सी धपाड़ीन खत्‌तम कर देही, अने तीनी आखी मुरती ने चुरा-चुरा कर देही, काहाके छीनाळा नी कमाय सी तीहयो तीने एक्‌ठु करलो से अने तीहयी अळी छीनाळु नी कमाय ने तेवी हय जहे। <verse eid="MIC 1:7" /><verse number="8" style="v" sid="MIC 1:8" />ता मीका केदो, में आहया कारण सी दुखी हयही अने कलपही। में मारो दुख उजन्‌तो करवा करीन चाट्‌या वगर अने उगाड़लो फीरही। अने में कोल्‌यान तेम आड़ही अने सुतरमुर्‌गान तेम रड़ही। <verse eid="MIC 1:8" /><verse number="9" style="v" sid="MIC 1:9" />सामर्‌या ना घावु वारु नी हवे अने यहुदा बी तीहयीत रीते दुख झेलहे; गरा यरुसलेम ना झापले लग पुग जेली से, जां मारा माणहु रेय।”<verse eid="MIC 1:9" /></para>
  <para style="s">दुस्‌मन नु यरुसलेम भणी बड़नु</para>
  <para style="p">
    <verse number="10" style="v" sid="MIC 1:10" />गत ह़ेर मे अमारा दुस्‌मन ने अमारी हार नी खबर नी करजो; अने ना रड़ो; बेतआपरा ना कादा मे ढबळो। <verse eid="MIC 1:10" /><verse number="11" style="v" sid="MIC 1:11" />ए सापीर नी रेवा वाळी उगाड़ली हय्‌न वण-लाज्‌याण हय्‌न जत रे; सानान नी रेवा वाळी नी नीकळ सक्‌ती; बेतेसेल ना रड़वा-कलपवा ना कारण सी तीनो आसरा नो जागो तमारी पांह गेथो ली लेदलो से। <verse eid="MIC 1:11" /><verse number="12" style="v" sid="MIC 1:12" />काहाके मारोत नी रेवा वाळी वारलु नी वाट जोवती-जोवती घबराय जेली से, काहाके यहोवा भगवान भणी गेथी गरा यरुसलेम ना फाटे तक पुग जेली से। <verse eid="MIC 1:12" /><verse number="13" style="v" sid="MIC 1:13" />ए लाकीस नी रेवा वाळी आह़फा ना घोड़ागाड्‌या मे उतवाळ्‌या चालवा वाळा घोड़ा जोप; तारीन तांत गेथा सीय्‌योन ना माणहु नो पाप सुरु हयो, काहाके ईस्‌रायल ना गुना तारीत मे जड़्‌या। <verse eid="MIC 1:13" /><verse number="14" style="v" sid="MIC 1:14" />आहया कारण सी तु गत ह़ेर ना मोरेसेत ने दान आपीन सेटु कर देहे; अकजीब<note caller="+" style="f"><char style="fr" closed="false">1:14 </char><char style="fq" closed="false">अकजीब </char><char style="ft" closed="false">धोको </char></note> ना घोर सी ईस्‌रायल ना राजा धोकोत खाहे। <verse eid="MIC 1:14" /><verse number="15" style="v" sid="MIC 1:15" />ए मारेसा नी रेवा वाळी मे अळी तारी पोर एक अदीकारी ठेरावही, अने ईस्‌रायल ना नामह़ाद्‌या माणहु ने अदुल्‌लाम नी गुफा मे आव्‌वा पड़हे। <verse eid="MIC 1:15" /><verse number="16" style="v" sid="MIC 1:16" />आह़फाम ना मोंगाळ्‌ळा सोरा जुगु दुख मे आह़फाम ना मुंडे ना नीम्‌बाळा बोड़ावो अने घुवड़ ने तेम भुमळा कर लेवो काहाके तमारा सोरा तमारीन्‌तां गेथा धराय्‌न गुलामी मे जत रेला से।<verse eid="MIC 1:16" /></para>
  <chapter eid="MIC 1" />
  <chapter number="2" style="c" sid="MIC 2" />
  <para style="s">गरीब ने वेला पाड़वा वाळाम नो वाक काडणु</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 2:1" />गरा आय पड़े तीमनी पोर, जे खाट्‌लु पोर पड़ीन बुराय नो वीच्‌यार करे अने गलत काम नी ईच्‌छा करे, अने ताखत वाळो हयवा ना कारण सी ह़वारे वेगोत दाहड़ु उगतेत तीहया तीने पुरा करे। <verse eid="MIC 2:1" /><verse number="2" style="v" sid="MIC 2:2" />तीहया बीजा ना खेतरु नी लालच करीन तीमने हापकी लेय, अने बीजा ना घोरु नी लालच करीन तीमने बी हापकी लेय; अने तीनु घोराणु भेळ अदमी पोर, अने तीना खुद ना वाटा भेळ बीजा माणहु ने दुख देय अने वेला पाड़े। <verse eid="MIC 2:2" /><verse number="3" style="v" sid="MIC 2:3" />आनी लेदे यहोवा केय, में आहया घोराणा पोर गरा लाव्‌वा नी योजना बणाय र्‌यो, अने तमु तीहयी योजना सी बच नी सको। तीहयी टेम काठी रेहे, अने मुंडु उचु करीन चाली नी सको। <verse eid="MIC 2:3" /><verse number="4" style="v" sid="MIC 2:4" />तीहयी टेमे आहयु घणु दुख नु गीत दाखला नी रीती पोर गावहे: “आमु ते खत्‌तम हय ज्‌या; तीहयो मारा माणहु ना वाटा ने बगाड़े; गरा आय पड़े, तीहयो तीने मारी सी केतरो नाम्‌बे कर देय! तीहयो अमारा खेतरु ने धोको करवा वाळा ने आप देय।” <verse eid="MIC 2:4" /><verse number="5" style="v" sid="MIC 2:5" />यहोवा नी मंडळी मे चीट्‌ठी नाखीन अने दोड़ु वेर मापीन जागान वाटवा वाळो कोय नी रेय; अने तमने जागा नो थोड़ोक वाटो बी नी जड़े। <verse eid="MIC 2:5" /><verse number="6" style="v" sid="MIC 2:6" />तीमना भगवान वगे गेथी वात केवा वाळा माणहु केय के आहयी वात ना बारा मे भगवान वगे गेथी वात ना केवो, काहाके आमने नामबद्‌दी वेठवा नी पड़े। <verse eid="MIC 2:6" /><verse number="7" style="v" sid="MIC 2:7" />ए याकुब नु घोराणु, ह़ु आहयु केवा जोवे के यहोवा नी आत्‌मा धीरज नी धरवा वाळी हय जेली से? ह़ु आहया काम तीनीत जुगु हयला से? ह़ु मारा बोलु सी तीनु भलु नी हये जे ह़ुदाय सी चाले? <verse eid="MIC 2:7" /><verse number="8" style="v" sid="MIC 2:8" />पण काले नी वात से के मारा माणहु वेरी बणीन मारा वीरोद मे आवला से; तमु भोळा-भाळा वाट्‌ये चालवा वाळान डील पोर गेथु चादरु हापकी लेवो जे झुमायवा नो वीच्‌यार नी करीन बेफीकर्‌या जत रेय। <verse eid="MIC 2:8" /><verse number="9" style="v" sid="MIC 2:9" />तमु मारा असामी ना बयरा ने सुक-सान्‌ती रेण्‌या घोरु गेथा नीकाळ देदला से, अने तीमना सोरा पांह खास चीज ने सदा ना लेदे हापकी लेवो। <verse eid="MIC 2:9" /><verse number="10" style="v" sid="MIC 2:10" />उठो, जत रेवो! काहाके आहयो तमारो अराम करवा नो जागो नी हय; आनु कारण तीहयु वीटळ्‌ळु से जे काठला दुख नी ह़ाते तमने खत्‌तम करहे। <verse eid="MIC 2:10" /><verse number="11" style="v" sid="MIC 2:11" />कदीम कोय झुटी आत्‌मा मे चालतो जीन झुटी अने फालतु वात केय अने केय के में तमने हमेसा अंगुर नु ह़रु अने ह़रु नी लेदे परच्‌यार ह़मळावतो रेही, ता तीहयोत आहया माणहु नो भगवान भणी गेथी वात केवा वाळो ठेरहे। <verse eid="MIC 2:11" /><verse number="12" style="v" sid="MIC 2:12" />ए याकुब, मे पक्‌को तमु आखाम ने भेळो करही; में ईस्‌रायल ना बचलाम ने पक्‌को एक्‌ठा करही; अळी बोस्‌रा ना गाडरा-बोकड़ाम ने तेम भेळा राखही। तीहया टोळान तेम जे वारला चारा मे रेय, तीहया ढेरेत माणहुम नी करते दंगो करहे। <verse eid="MIC 2:12" /><verse number="13" style="v" sid="MIC 2:13" />तीमनी अगळ-अगळ वाड़ा नो तोड़वा वाळो जेलो से, करीन तीहया बी तीने तोड़ र्‌या, अने झापले माय्‌न नीकळ र्‌या; तीमनो राजा तीमनी अगळ-अगळ ज्‌यो मतलब यहोवा खुद तीमनो अगवाय करन्‌यो से।<verse eid="MIC 2:13" /></para>
  <chapter eid="MIC 2" />
  <chapter number="3" style="c" sid="MIC 3" />
  <para style="s">मीका ईस्‌रायल ना अगवाय करन्‌या नो वाक काडे</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 3:1" />में केदो, “ए याकुब ना मुख्‌या, ए ईस्‌रायल ना घोराणा ना नीयाव करन्‌या, ह़मळो! ह़ु नीयाव नी ह़तायली वात जाणवा तमारु काम नी हय? <verse eid="MIC 3:1" /><verse number="2" style="v" sid="MIC 3:2" />तमु ते भलाय सी ह़ीगी करो अने बुराय सी मोंग करो, तमु मारा जीवत्‌ला माणहु नी खाल उतारो, अने तीमना हाटका पोर नु माह ने नीखवी लेवो। <verse eid="MIC 3:2" /><verse number="3" style="v" sid="MIC 3:3" />एतरुत नी पण तमु मारा माणहु नु माह खाय जावो, अने तीमनी खाल उतार लेवो, अने तीमना हाटका भांग नाखो, अने तीमने हांडलु मेनु माह ने तेम झीनु-झीनु कर देवो। <verse eid="MIC 3:3" /><verse number="4" style="v" sid="MIC 3:4" />तीहयी टेम बी आवहे, के तीहया यहोवा भगवान ने आड़हे, पण तीहयो तीमनु आड़नु ह़मळे नी, पण तीहयी टेमे तीहयो तीमना बुरा कामु ना कारण तीमनी सी आडु भाळ लेहे। <verse eid="MIC 3:4" /><verse number="5" style="v" sid="MIC 3:5" />यहोवा भगवान नो आहयो बोल से के जे भगवान वगे गेथी वात केवा वाळो माणेह मारा असामी ने भटकाड़ देय, अने जत्‌यार तक तीमने खावा नु जड़्‌या करे तत्‌यार तक तीहया सांती” से केय, अने जत्‌यार तीमने खावा नु नी जड़े ता तीहया तीमने झगड़ा नी धमकी देय। <verse eid="MIC 3:5" /><verse number="6" style="v" sid="MIC 3:6" />आना कारण सी तमारी पोर एवी रात आवहे, ता तमने दरसन नी देखाय, अने अंदारला मे तमु अगी हयवा वाळी वात नी देखाड़ सको, भगवान वगे गेथी वात केण्‌या नु दाहड़ु बुड जहे, तमारा दाड़ा अंदारलु मे बदल जहे। <verse eid="MIC 3:6" /><verse number="7" style="v" sid="MIC 3:7" />दरसन देखवा वाळा, अने जे अगी हयवा वाळी वात देखाड़न्‌या तीहया आखा लाजे पड़हे, अने तीहया आखान आखा आह़फाम नु मोडु आनीन करते ढाकहे के भगवान तीमने जपाप नी आपे। <verse eid="MIC 3:7" /><verse number="8" style="v" sid="MIC 3:8" />पण मने यहोवा भगवान आह़फा नी आत्‌मा अने सक्‌ती सी भर देय अने मारी मे नीयाव अने ताखत से अने ईस्‌रायल ना माणहु ने तीमना पापु ना बारा मे देखाड़वा नी हीम्‌मत आपे। <verse eid="MIC 3:8" /><verse number="9" style="v" sid="MIC 3:9" />ए याकुब ना घोराणा ना मुख्‌या, ए ईस्‌रायल ना मुख्‌या, तमु जे नीयाव सी रीह राखो, तमु सच्‌चाय ने गलत मे बदल देवो, अमारी ह़मळो। <verse eid="MIC 3:9" /><verse number="10" style="v" sid="MIC 3:10" />तमु सीय्‌योन ने हत्‌या सी अने यरुसलेम ने ह़ीगी आवे एवा कामु सी मजबुत करो। <verse eid="MIC 3:10" /><verse number="11" style="v" sid="MIC 3:11" />ह़ेर ना मुख्‌या पय्‌हा लीन राज कर र्‌या, अने पुंजारा बी पय्‌हा लीन नेम-कायदा देखाड़ र्‌या; अने भगवान वगे गेथी वात केवा वाळा पय्‌हा लीन अगी हयवा वाळी वात केय; ते बी तीहया आहयु कीन यहोवा भगवान पोर भरहो राखे, “यहोवा भगवान अमारी वचमे से” आनी लेदे कोय गरा “अमारी पोर नी आवे।” <verse eid="MIC 3:11" /><verse number="12" style="v" sid="MIC 3:12" />अने आहयी रीते तारा कारण सी सीय्‌योन ने खेतर ने तेम जोपहे, यरुसलेम ओदरला ढेरु बण जहे, अने मंदीर ना बड़ा जंगल बण जहे।<note caller="+" style="x"><char style="xo" closed="false">3:12 </char><char style="xt" closed="false"><ref loc="JER 26:18">यीरम्‌या 26:18</ref></char></note><verse eid="MIC 3:12" /></para>
  <chapter eid="MIC 3" />
  <chapter number="4" style="c" sid="MIC 4" />
  <para style="s">सांती नु राज्‌य</para>
  <para style="r">(<ref loc="ISA 2:2-4">यसाया 2:2-4</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 4:1" />आखरी दाड़ा मे आसम हयहे के यहोवा भगवान ना घोर नो बड़ो आखा बड़ा सी मजबुत हयहे, अने आखा बड़्‌या गेथो उचो करहे; अने हरेक राज्‌य ना माणहु नंदीन तेम तीनी भणी आवहे। <verse eid="MIC 4:1" /><verse number="2" style="v" sid="MIC 4:2" />अने तीहया माणहु आवीन केहे, आवो, आपणु यहोवा भगवान ना बड़ा पोर चड़ीन ईस्‌रायल ना भगवान ना मंदीर मे जीया। तीहयो आपणु ने तीहयुत ह़ीकाड़हे जे आपणु ने कराव्‌वा चाही र्‌यो; आपणु तीना देखाड़ला रोहा पोर चालहु। काहाके यहोवा भगवान नी ह़ीकापण यरुसलेम गेथी आवे तीहयो सीय्‌योन गेथो आपणा माणहु सी वात करे। <verse eid="MIC 4:2" /><verse number="3" style="v" sid="MIC 4:3" />तीहयो घणा देसु ना माणहु नो नीयाव करहे, अने नाम्‌बे-नाम्‌बे तक ना ताखत वाळा राज्‌य ना झगड़ा ने खत्‌तम कर देहे; आनी लेदे तीहया आह़फाम नी तलवार ने ठोकीन होळ ना कोहला बणावहे अने आह़फाम ना भाला ने दातळा बणावहे, ता एक राज्‌य बीजा राज्‌य पोर हामलो अळतेण कदी नी करे। अने अळतेण हमला नी तीयारी कदी नी करे।<note caller="+" style="x"><char style="xo" closed="false">4:3 </char><char style="xt" closed="false"><ref loc="JOL 3:10">योएल 3:10</ref></char></note> <verse eid="MIC 4:3" /><verse number="4" style="v" sid="MIC 4:4" />तीहया आखा आपणी-आपणी अंगुर नी वाड़ी मे अंजीर ना झाड़ तळे सांती सी बठहे, अळी कोय तीमने नी बीहाड़े; ताखत वाळो यहोवा भगवान आहयो वायदो करलो से।<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="ZEC 3:10">जकर्‌याह 3:10</ref></char></note> <verse eid="MIC 4:4" /><verse number="5" style="v" sid="MIC 4:5" />आखा राज्‌य ना माणहु ते आपणा-आपणा देवता नु नाम लीन चाले, पण आपणु आपणा भगवान यहोवा नु नाम लीन सदा चालता रेहु।<verse eid="MIC 4:5" /></para>
  <para style="s">गुलामी मे गेथु ईस्‌रायल नु छुटणु</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 4:6" />यहोवा भगवान आहयु केय, “तीहयी टेम आय री,” में असामी ना लंगड़ा ने अने जबराण नीकाळ्‌ळा ने अने जीमने में दुख देदलो से तीहया आखा ने एक्‌ठा करही; <verse eid="MIC 4:6" /><verse number="7" style="v" sid="MIC 4:7" />अने लंगड़ा ने में बचाड़ीन राखही, अने सेटा करला ने एक सक्‌ती वाळु राज्‌य बणावही; अने यहोवा भगवान तीमनी पोर सीय्‌योन बड़ा पोर गेथो सदा राज करतो रेहे। <verse eid="MIC 4:7" /><verse number="8" style="v" sid="MIC 4:8" />ए एदेर ना गुम्‌मट, ए सीय्‌योन ना बड़ा, तने पेलेन तेवु राज जड़हे। अने तने यरुसलेम नु राज्‌य जड़े। <verse eid="MIC 4:8" /><verse number="9" style="v" sid="MIC 4:9" />तु एतरा ज्‌योरे काहा आड़े, तु सोरु पयदा करवा वाळी बयर ने तेम दुख झेल र्‌यु, आनो कारण आहयो से के तारी पांह राजो नी हय, तने ह़ला आपण्‌या मर ज्‌या? <verse eid="MIC 4:9" /><verse number="10" style="v" sid="MIC 4:10" />ए यरुसलेम ना माणहु, तमु भारेपोगे बयर ने तेम दुख झेल अने कंजार काहाके हाव तमने ह़ेर छोड़ीन चोवगान रेवा पड़हे, तमने बेबीलोन देस मे जवा पड़हे, पण तां तमने यहोवा भगवान तमारा वेरी-दुस्‌मन सी बचाड़हे। <verse eid="MIC 4:10" /><verse number="11" style="v" sid="MIC 4:11" />घणा राज्‌य तमारी पोर हामलो करवा करीन एक्‌ठा हय र्‌या, तीहया की र्‌या के “सीय्‌योन ने खत्‌तम कर देवो, आपणु आहया ह़ेर ने उजाड़ देखहु।” <verse eid="MIC 4:11" /><verse number="12" style="v" sid="MIC 4:12" />पण आहया नी जाणता, के यहोवा भगवान ना मन मे ह़ु से? तीहया आहयी वात नी ह़मजता के तीमने तीनीन तेम डंड आपवा ना लेदे एक्‌ठा करलो से जीसम खळा मे अन ने महळवा ना लेदे एक्‌ठु करे। <verse eid="MIC 4:12" /><verse number="13" style="v" sid="MIC 4:13" />यहोवा भगवान केय, “यरुसलेम ना माणहु, जावो अने आपणा वेरी ने डंड आपो, में तमने लुहड़ा ना ह़ींगड़ा अने पीतळ ना खुर्‌या वाळा बोळ्‌द्‌यान तेम सक्‌ती वाळा बणावही, तु घणा राज्‌य ने रोंदळी देही, अने जे धन तीहया लुटला से तीने तमु यहोवा भगवान ने ह़ोप देहु।”<verse eid="MIC 4:13" /></para>
  <chapter eid="MIC 4" />
  <chapter number="5" style="c" sid="MIC 5" />
  <para style="p">
    <verse number="1" style="v" sid="MIC 5:1" />यरुसलेम ना माणहु, तमारी फोज एक्‌ठी करो! आपणु ने तीहया घेरवी लेदला से तीहया ईस्‌रायल ना नीयाव करन्‌या ना गाल्‌ये ह़ोटो देहे।<verse eid="MIC 5:1" /></para>
  <para style="s">बेतलहम गेथो एक राजा आव्‌वा नो वायदो</para>
  <para style="p">
    <verse number="2" style="v" sid="MIC 5:2" />यहोवा भगवान केय, “ए एप्‌राता नु बेतलहम, तु यहुदा ना आखा ह़ेर गेथु नान्‌लु से, पण ते बी तारी मे गेथो ईस्‌रायल ना लेदे एक मुख्‌यो अदीकारी बणावही, तीहयो ईस्‌रायल पोर राज करहे तीनु नीकळनु सुरु गेथुत हयतु आय र्‌यु।”<note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 2:6">मत्‌ती 2:6</ref>; <ref loc="JHN 7:42">युहन्‌ना 7:42</ref></char></note> <verse eid="MIC 5:2" /><verse number="3" style="v" sid="MIC 5:3" />आनी लेदे यहोवा भगवान आह़फा ना असामी ने जत्‌यार तक भारेपोगे बयर सोरा ने पयदा नी करे, तत्‌यार तक वेरी-दुस्‌मन ना हात मे छोड़ देहे; ता ईस्‌रायल ना बचला माणहु आपणा भाय-बेन्‌या ह़ाते पासा भेसकाय जहे। <verse eid="MIC 5:3" /><verse number="4" style="v" sid="MIC 5:4" />जत्‌यार तीहयो आवहे, ता मालीक नी आपली सक्‌ती सी अने यहोवा भगवान ना मोट्‌ला नाम सी आपणा माणहु पोर राज करहे। तीहया सुक सी रेहे काहाके हाव तीहयो धरती नी छेव तक मोटो ठेरहे।<verse eid="MIC 5:4" /></para>
  <para style="s">छुटकारो अने डंड</para>
  <para style="p">
    <verse number="5" style="v" sid="MIC 5:5" />तीहयो सांती नो थुड़ रेहे। जत्‌यार अस्‌सुरी सेना अमारा देस पोर हामलो करे, अने अमारा राजवाड़ा मे पोग मेके, ता आमु तीमना वीरोद मे ह़ात गुवाळ्‌या अने आंठ मुख्‌या माणहु उबा करहु; <verse eid="MIC 5:5" /><verse number="6" style="v" sid="MIC 5:6" />तीहया हत्‌यार नी ताखत सी नीम्‌रोद ना देस अस्‌सुर ने जीक लेहे अने जत्‌यार अस्‌सुरी माणहु अमारा देस पोर हामलो करहे, ता तीहया आमने तीमनी सी बचाड़हे।<note caller="+" style="x"><char style="xo" closed="false">5:6 </char><char style="xt" closed="false"><ref loc="GEN 10:8-11">उबजणाय कीताप 10:8-11</ref></char></note> <verse eid="MIC 5:6" /><verse number="7" style="v" sid="MIC 5:7" />ईस्‌रायल ना जे माणहु बचला रेहे तीहया मालीक ना लारे घणा राज्‌य ना लेदे ताबलु पड़लु झाकळुन तेम रेहे अने चारा पोर जीठवड़ी ना पाणीन तेम रेहु, तीहया माणहु पोर नी पण भगवान ना भरहे रेहे। <verse eid="MIC 5:7" /><verse number="8" style="v" sid="MIC 5:8" />याकुब ना बचला माणहु राज्‌य मे अने देस-देस ना माणहु नी वच मे आसम रेहे जेम जंगल ना जानवरु मे नाहर, नीता गाडरा-बोकड़ा ना टोळा मे जुवान नाहर रेय, काहाके जत्‌यार तीहयो तीमनी वच मे माय्‌न जाय, ता रंदळतो अने फाड़तो जहे, अने कोय बचाड़ नी सके। <verse eid="MIC 5:8" /><verse number="9" style="v" sid="MIC 5:9" />तारो हात तारा वेरी पोर पड़े अने तीहया आखा ने खत्‌तम कर देहे। <verse eid="MIC 5:9" /><verse number="10" style="v" sid="MIC 5:10" />यहोवा भगवान केय, तीहयी टेमे में तमारा घोड़ा ने हापकी लेही अने तमारी घोड़ागाडी ने खत्‌तम कर देही। <verse eid="MIC 5:10" /><verse number="11" style="v" sid="MIC 5:11" />में तारा देस ना ह़ेरु ने खत्‌तम करही, अने तारा कीला ने ओदारी देही। <verse eid="MIC 5:11" /><verse number="12" style="v" sid="MIC 5:12" />में तारा जादु-टोना ने खत्‌तम कर देही, अने तारी मे जादु-टोना ने अळी अगो चालीन नी रेय। <verse eid="MIC 5:12" /><verse number="13" style="v" sid="MIC 5:13" />में तमारा मुरत्‌या अने तमारी वचे गेथा तमारा पुंजवा ना दगड़ा ने सेटा कर दीही। अने तमु अळी कदी तमारा हात वेर बणावली चीज नी भक्‌ती नी कर सको। <verse eid="MIC 5:13" /><verse number="14" style="v" sid="MIC 5:14" />में तारी असेरा नाम नी मुरती ने उखड़ी देही, अने तारा ह़ेरु ने खत्‌तम करही। <verse eid="MIC 5:14" /><verse number="15" style="v" sid="MIC 5:15" />अने जे राज्‌य मारो हुकम नी मान्‌ता, तीमनी सी मे घणी-जादा रीह मे बदलो लेही।<verse eid="MIC 5:15" /></para>
  <chapter eid="MIC 5" />
  <chapter number="6" style="c" sid="MIC 6" />
  <para style="s">ईस्‌रायल ना वीरोद मे भगवान ना वात-वीच्‌यार</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 6:1" />जे वात यहोवा भगवान केय, तीने ह़मळो! उठो, बड़ाम नी ह़ाते जखड़ी पड़, अने बड़्‌या बी तारी वात ह़मळवा जोवे। <verse eid="MIC 6:1" /><verse number="2" style="v" sid="MIC 6:2" />ए बड़ा, अने धरती नी सदा नी नीव, यहोवा भगवान नो वात ह़मळो, काहाके यहोवा भगवान आह़फा ना माणहु पोर गुनो लगाड़ र्‌यो अने तीहयो ईस्‌रायल नी ह़ाते वात मे जखड़ी पड़ र्‌यो। <verse eid="MIC 6:2" /><verse number="3" style="v" sid="MIC 6:3" />यहोवा भगवान केय, “ए मारा माणहु, मने देखाड़ो, के कानी वात मे, में तमने दुख देदलो से? में तमारु ह़ु बगाड़लो से? <verse eid="MIC 6:3" /><verse number="4" style="v" sid="MIC 6:4" />में तमने मीस्‌र देस गेथो नीकाळ लायो, में तमने गुलामी गेथो बचाड़्‌यो, में तमारी अगवाय करवा ना लेदे मुसा ने, हारुन ने, अने मरीयम ने मोकल्‌यो।<note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="EXO 4:10-16">नीरगमन 4:10-16</ref>; <ref loc="EXO 12:50">12:50</ref>,<ref loc="EXO 12:51">51</ref>; <ref loc="EXO 15:20">15:20</ref></char></note> <verse eid="MIC 6:4" /><verse number="5" style="v" sid="MIC 6:5" />ए मारा माणहु, फोम करो के मोवाब नो राजो बालाक तमारी ह़ाते ह़ु करवा नी योजना बणावलो हतो, अने बोर नो सोरो बीलाम तीने ह़ु ह़ला आपलो हतो, बेबीलोन ना सीत्‌तीम ह़ेर गेथु गीलगाल ह़ेर तक वाट्‌ये जे कंय हयु तीने फोम करो। जीनी सी तमु यहोवा भगवान ना वारला कामु ने ह़मज सको।”<note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="NUM 22:2-24:25">गीनती 22:2–24:25</ref>; <ref loc="JOS 3:1-4:19">यहोसु 3:1–4:19</ref></char></note><verse eid="MIC 6:5" /></para>
  <para style="s">भगवान ह़ु चाहे</para>
  <para style="p">
    <verse number="6" style="v" sid="MIC 6:6" />में हात मे कानी भेट लीन भगवान यहोवा अगळ आवु। अने ह़रग मे रेवा वाळा भगवान ने वांदु? ह़ु में बादा चड़ाव्‌वा ना लेदे एक साल नु वाछड़ु लीन तीनी अगळ आवु? <verse eid="MIC 6:6" /><verse number="7" style="v" sid="MIC 6:7" />ह़ु यहोवा भगवान हजारु गाडरा चड़ाव्‌वा सी नीता जेतुन ना तेल नी लाखु नंद्‌या नी भेट सी खुस हयहे? ह़ु में आपणा पाप ना पछतावा ना लेदे पेल-खोळ्‌या सोरा ने बादा चड़ावु। <verse eid="MIC 6:7" /><verse number="8" style="v" sid="MIC 6:8" />कदी नी, मालीक आमने देखाड़लो से के ह़ु वारु से तीहयो अमारी सी आहयु चाहे के जे करवा जोवे तीहयुत करे, सदा मोंग देखाड़ो, अने आपणा भगवान ह़ाते भोळा रीन चालो। <verse eid="MIC 6:8" /><verse number="9" style="v" sid="MIC 6:9" />यहोवा भगवान यरुसलेम ह़ेर ने आड़ी र्‌यो, अक्‌कल वाळो माणेह यहोवा भगवान ना नाम नी बीक माने, करीन डंड नी वात पोर धीयान देय, जीनी पांह डंड आपवा नो हक से। <verse eid="MIC 6:9" /><verse number="10" style="v" sid="MIC 6:10" />वेरी माणेह ना घोर मे तीहयु धन रेय जीने तीहया बेमानी करीन हात करला से तीहया झुटा माप-तोल नो वापर करला से आहयी एवी वात से जीनी सी मे ह़ीगी करु। <verse eid="MIC 6:10" /><verse number="11" style="v" sid="MIC 6:11" />में तीहया माणहु ने कीसम माप कर सकु जे झुटी ताकड़ी अने बाट नो वापर करता हय। <verse eid="MIC 6:11" /><verse number="12" style="v" sid="MIC 6:12" />तारा पामत्‌ला माणहु लुट-पाट करे, अने तारा रेवा वाळा झुट मेके अने तीमनी जीप धोको देवा नी वात करे। <verse eid="MIC 6:12" /><verse number="13" style="v" sid="MIC 6:13" />आनी लेदे में तमने ठोकी-ठोकीन घणो घायल कर देही, अने तमारा पापु ना कारण सी तमने उजाड़ देही। <verse eid="MIC 6:13" /><verse number="14" style="v" sid="MIC 6:14" />तमु खाहु पण आफरो नी, भुकलात रेहु, तमु आपणु माल-धन चुट लीजहु पण तीने बचाड़ी नी सको; तमु जे कंय बचाड़हु, तीने में तलवार चलाड़न्‌या ने लुटाड़ देही। <verse eid="MIC 6:14" /><verse number="15" style="v" sid="MIC 6:15" />तमु वेरहु पण फसल नी वाडो, तमु जेतुन नु तेल ते काडहु पण लगाड़ी नी सको, तमु अंगुर नु ह़रु बणावहु पण कदी पी नी सको। <verse eid="MIC 6:15" /><verse number="16" style="v" sid="MIC 6:16" />आसम आनी लेदे हयहे के तमु राजा ओमरी अने अहाब ना कामु पोर चालो; अने तमु तीमनी रीती पोर चालो, आनी लेदे में तमने उजाड़ देही, आहया ह़ेर ना रेवा वाळा माणहु तमारा हाही-ठट्‌टा करहे, अने तमारी मारा माणहु बुराय करहे।<note caller="+" style="x"><char style="xo" closed="false">6:16 </char><char style="xt" closed="false"><ref loc="1KI 16:23-34">1 राजा 16:23-34</ref>; <ref loc="1KI 21:25">21:25</ref>,<ref loc="1KI 21:26">26</ref></char></note><verse eid="MIC 6:16" /></para>
  <chapter eid="MIC 6" />
  <chapter number="7" style="c" sid="MIC 7" />
  <para style="s">ईस्‌रायल नी नीती नु खत्‌तम हयणु</para>
  <para style="p">
    <verse number="1" style="v" sid="MIC 7:1" />गरा मार पोर! काहाके में तीहया माणेह ने तेवो हय ज्‌यो जे उनाळा ना फोळ तोड़ लेय अने उजड़ जाय, ता जाय, नीता अंगुर ने तोड़ लेय अने उजड़ जाय ता जाय, मने ते पाकला अंजीरु नी हेर हती, पण खावा ना लेदे कोय बी गुच्‌छो नी र्‌यो। <verse eid="MIC 7:1" /><verse number="2" style="v" sid="MIC 7:2" />धरती पोर कोय ईमानदार माणेह नी बच्‌यु, भगत माणहु खत्‌तम हय ज्‌या; तीहया आखान आखा हत्‌या करवा नो मोखो ह़ोद र्‌या, हर कोय आपणा भाय ना लेदे जाळ नाख र्‌या। <verse eid="MIC 7:2" /><verse number="3" style="v" sid="MIC 7:3" />तीहया आखा बुराय करवा मे माहीर से, अदीकारी अने नीयाव करन्‌या पय्‌हा मांगत्‌ला अने मोटा माणहु तीमने देखाड़े के अदीकारी ने ह़ु जोवे? आनी लेदे तीहया मेळीन योजना बणावे। <verse eid="MIC 7:3" /><verse number="4" style="v" sid="MIC 7:4" />तीमनी मे गेथा आखा गेथा वारु अने आखा गेथा ईमानदार माणहु बी काटा नी वाड़ गेथा बी फालतु से। तीहयो दाड़ो आय जेलो से जत्‌यार भगवान माणहु ने डंड आपहे, भगवान वगे गेथा केण्‌या माणहु ना लारे चेतावणी आपली हती। <verse eid="MIC 7:4" /><verse number="5" style="v" sid="MIC 7:5" />आपणा ह़ाते वाळा पोर बी भरहो ना करो, आपणा दोस्‌त पोर बी भरहो ना करो; आञे तक के आपणी लाडी सी बी कंय केवा मे ह़मळीन रेवो। <verse eid="MIC 7:5" /><verse number="6" style="v" sid="MIC 7:6" />काहाके सोरा बाह नी बेईज्‌जती करे, अने सोर्‌या आह्‌य नो वीरोद करे, अने ववेह ह़ाहु सी झुमाय; तमारा दुस्‌मन तमारा घोरनात माणहु से।<note caller="+" style="x"><char style="xo" closed="false">7:6 </char><char style="xt" closed="false"><ref loc="MAT 10:35">मत्‌ती 10:35</ref>,<ref loc="MAT 10:36">36</ref>; <ref loc="LUK 12:55">लुका 12:55</ref></char></note> <verse eid="MIC 7:6" /><verse number="7" style="v" sid="MIC 7:7" />पण में यहोवा भगवान भणी देखतो रेही, में मने छुटकारो आपण्‌या भगवान नी वाट जोवतो रेही; मारो भगवान मारी अवाज ह़मळहे।<verse eid="MIC 7:7" /></para>
  <para style="s">छुटकारो भगवान सीत जड़े</para>
  <para style="p">
    <verse number="8" style="v" sid="MIC 7:8" />ए मारा वेरी मने उजड़वा सी खुस ना हये; काहाके मारो उजाड़ हयो ता पासु बणावहे बी; हमणे में अंदारला मे से, पण मालीक मने वीजाळु आपहे। <verse eid="MIC 7:8" /><verse number="9" style="v" sid="MIC 7:9" />में मालीक ना वीरोद मे पाप करलो से, करीन में तीनी रीह ने तीहयी टेम तक वेठतो रेही, पण आखरी मे तीहयो अमारी रखवाळी करहे अने अमारी सी जे गलती हयली से तीने ह़ुदारहे। तीहयो आमने वीजाळा मे लावहे आमु तीने आमने बचाड़त्‌लो देखवा जीवत्‌ला रेहु। <verse eid="MIC 7:9" /><verse number="10" style="v" sid="MIC 7:10" />ता अमारा दुस्‌मन आहयु देखहे अने लाजे पड़हे, तीहयात दुस्‌मन जे आहयु पुसीन ठटाय करता हता के तमारो भगवान यहोवा कां से? आमु तीमने हारत्‌ला अने वाट्‌ये ना कीचड़ ने तेम रंदळत्‌ला देखहु। <verse eid="MIC 7:10" /><verse number="11" style="v" sid="MIC 7:11" />ए यरुसलेम ना माणहु, ह़ेर ना भीतड़ा ने पासा बांदवा नो दाड़ो आवहे। तीहया दाड़े तारी काकड़ बड़ावहे। <verse eid="MIC 7:11" /><verse number="12" style="v" sid="MIC 7:12" />तीहया दाड़े तारा असामी हरेक जागे गेथा उगवणा सी, अस्‌सुर देस गेथा, दखणाव सी, मीस्‌र देस गेथा, फरात नंदी भणी गेथा, अने दर्‌या भणी गेथा, अने बड़ा भणी गेथा पासा आवती रेहे। <verse eid="MIC 7:12" /><verse number="13" style="v" sid="MIC 7:13" />ते बी धरती पोर रेवा वाळाम ना कारण सी अने तीमना बुरा कामु ना फोळ ना कारण उजाड़ेत रेहे।<verse eid="MIC 7:13" /></para>
  <para style="s">ईस्‌रायल पोर भगवान नी दया</para>
  <para style="p">
    <verse number="14" style="v" sid="MIC 7:14" />तारा माणहु नी रखवाळी, अने तारा खुद ना वाटा मे जड़ला टोळा नी रखवाळी आह़फा नी लाकड़ी वेर करजे, जे उजाड़ जागा मे से अने वारला चारो उगाड़न्‌या चरवासा नी वच मे एखला रेय, तीमने पेलेन तेम बासान अने गीलाद ना ईलाका मे चरवा दे। <verse eid="MIC 7:14" /><verse number="15" style="v" sid="MIC 7:15" />ए मालीक, अमारी लेदे मोटा काम कर, जीसम तु तीहया दाड़ा मे करलो हतो जत्‌यार तु आमने मीस्‌र देस गेथो नीकाळ लावलो हतो। <verse eid="MIC 7:15" /><verse number="16" style="v" sid="MIC 7:16" />बीजा राज्‌य ना माणहु आहयु देखहे अने आह़फाम नी आखी सक्‌ती हयवा सी बी आह वगर ना हय जहे, तीहया आह वगर ना हय्‌न आह़फा नु मोडु बंद कर लेहे, आपणा कान्‌टा बंद कर लेहे। <verse eid="MIC 7:16" /><verse number="17" style="v" sid="MIC 7:17" />तीहया गड़हान तेम धुळो चाटहे, तीहया आह़फा ना दोरु मे गेथा कापता अने बीहता जाय्‌न नीकळहे तीहया अमारा भगवान यहोवा नी बीक मानहे। <verse eid="MIC 7:17" /><verse number="18" style="v" sid="MIC 7:18" />ए यहोवा भगवान, तारीन तेवो बीजो कोय देवता नी हय; तु तारा माणहु ना पाप माफ करे, अने आह़फा ना बचला माणहु ना पाप ढाक देय, तु सदा खीजवायलो नी रेय, पण आमने तारो लगातार मोंग देखाड़वा मे मजा लेय। <verse eid="MIC 7:18" /><verse number="19" style="v" sid="MIC 7:19" />तु एक कावा अळी अमारी पोर दया करही, तु अमारा पापु ने पोगु तळे रंदळी देही अने तीमने दर्‌या नी बुंदे नाख देही। <verse eid="MIC 7:19" /><verse number="20" style="v" sid="MIC 7:20" />तु याकुब ना बारा मे तीहयी सच्‌चाय, अने अब्‌राहम ना बारा मे तीहयी दया पुरी करही, जीसम के तु घणो पेले अमारा आड़ा-बुड़ा सी वायदो करलो हतो।<verse eid="MIC 7:20" /></para>
  <chapter eid="MIC 7" />
</usx>