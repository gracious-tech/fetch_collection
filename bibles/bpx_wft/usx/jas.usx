<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="JAS" style="id">- Paliya</book>
  <para style="h">याकुब</para>
  <para style="toc3">याकुब</para>
  <para style="toc2">याकुब</para>
  <para style="toc1">याकुब नी चीट्‌ठी</para>
  <para style="mt2">याकुब की पत्री</para>
  <para style="mt1">याकुब नी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">याकुब कीताप याकुब नाम ना काना माणेह लारे लीखली हती। आहयो ह़ाचलीन ईसु नो भाय याकुब हतो, जे पेल्‌नी मंडळी मे एक अगवो हतो अने यरुसलेम ह़ेर नो वाटो हतो <char style="xt"><ref loc="ACT 15:13">नेवताळा ना काम 15:13</ref></char> नेवताळो पोलुस ने तीने <char style="xt"><ref loc="GAL 2:9">गलातीयो 2:9</ref></char> मे मंडळी नो खम्‌बो बी केदा। डायला-डायला नु मान्‌नु से के याकुब नी कीताप ईसु मसी ना पयदा हयवा ना 50 साल नी अळतेण लीखली हती। मतलब काहाके याकुब यरुसलेम मे मंडळी नो अगवो हतो, आनी लेदे तीहयो तां रेतो जाय्‌न हय सके कीताप लीखी हती।</para>
  <para style="ip">याकुब ते आपणी कीताप ने देसु ना वच मे खोळवीन बारे आड़जात्‌या ना बारा मे देखाड़्‌यो। <char style="xt"><ref loc="JAS 1:1">1:1</ref></char> याकुब नी कीताप आखा ईसु पोर भरहो करन्‌या पोर लागु हयत्‌ली से पण “बारे आड़जात्‌या” बोल नो वापर आहयु देखाड़े के याकुब ह़ुदो युहदी भरहो करन्‌या ने लीख र्‌यो हतो। काहाके आहयी कीताप भणन्‌या ना एक मोट्‌ला टोळा लग पुगाड़वा नी लेदे हती, आञे कंय वातु ना बारा मे देखाड़े। याकुब भरहा ना काम ना वच मे जोड़ पोर ध्‌यान हापकत्‌लो से। खरलो भरहो काम मे देखाय जहे। <char style="xt"><ref loc="JAS 2:17">2:17</ref></char> तीहयो मालदार माणहु <char style="xt"><ref loc="JAS 2:1-4">2:1-4</ref></char> ने भेद-भाव देखाड़वा ना वीरोद मे चेतावणी आपे अने आमने देखाड़े के आमु ह़ु केतला से। <char style="xt"><ref loc="JAS 3:1-12">3:1-12</ref></char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पोलुस आपणा भणवा वाळा ने घण वारु केय। <char style="ior"><ref loc="JAS 1:1">1:1</ref></char></para>
  <para style="io1">2. आनीन अळतेण तीहयो ईसु पोर भरहो करन्‌या ने वेठवा नी लेदे हीम्‌मत आपत्‌लो जत्‌यार तीहया मांदला हता। <char style="ior"><ref loc="JAS 1:2-27">1:2-27</ref></char></para>
  <para style="io1">3. भरहा ने काम ना लारे देखाड़वा जरुड़ी से। <char style="ior"><ref loc="JAS 2:1-26">2:1-26</ref> </char></para>
  <para style="io1">4. तीनीन अळतेण तीहयो केय के एतरा सक्‌ती वाळा बोल कीसम हय सके। <char style="ior"><ref loc="JAS 3:1-12">3:1-12</ref></char></para>
  <para style="io1">5. ता याकुब देखाड़े के कीसम भगवान नो ग्‌यान कळी ना ग्‌यान सी अलग से। <char style="ior"><ref loc="JAS 3:13-4:10">3:13–4:10</ref></char></para>
  <para style="io1">6. अळतेण तीहयो आपणा भणवा वाळा ने मोटाय करवा ना वीरोद मे चेतावणी आपे। <char style="ior"><ref loc="JAS 4:11-5:6">4:11–5:6</ref></char></para>
  <para style="io1">7. याकुब कंय हळकी वात देखाड़ीन आपणी कीताप खत्‌तम करे। <char style="ior"><ref loc="JAS 5:7-20">5:7-20</ref></char></para>
  <chapter number="1" style="c" sid="JAS 1" />
  <para style="s">वारलो से के?</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 13:55">मत्‌ती 13:55</ref>; <ref loc="MRK 6:3">मरकुस 6:3</ref>; <ref loc="ACT 15:13">नेवताळा ना काम 15:13</ref>; <ref loc="GAL 1:19">गलातीयो 1:19</ref></char>
    </note>मे याकुब, भगवान अने मालीक ईसु मसी नो पावर्‌यो। मे तमने आहयी चीट्‌ठी लीखु जे रीवण्‌या-तीवण्‌या हय्‌न आखा देस मे री र्‌या। तमु वारला से के?<verse eid="JAS 1:1" /></para>
  <para style="s">भरहो अने अक्‌कल</para>
  <para style="p">
    <verse number="2" style="v" sid="JAS 1:2" />ए मारा भायु अने बेनेह, जत्‌यार तमु भात-भाती नी वेला मे पड़ो, ता ईने पुरी खुसी नी वात ह़मजो, <verse eid="JAS 1:2" /><verse number="3" style="v" sid="JAS 1:3" />आहयु जाणीन के तमारा भरहा ने परखायवा सी गम पयदा हये। <verse eid="JAS 1:3" /><verse number="4" style="v" sid="JAS 1:4" />तमु धीरज ने तीनु काम पुरु करवा देवो, के तमु पुरा अने चोखला हय जावो; अने तमारी मे कानी बी वारली वात नी कसर नी रेय। <verse eid="JAS 1:4" /><verse number="5" style="v" sid="JAS 1:5" />पण कदी तमारी माय्‌न कोय पांह बी अक्‌कल नी कमी हय ता, भगवान सी मांगो। जे आखा ने मोकळे मन सी अने दया सी आपण्‌यो से; अने तीहयो तमने आपहेन आपहे। <verse eid="JAS 1:5" /><verse number="6" style="v" sid="JAS 1:6" />पण तमु सण्‌का कर्‌या वगर भरहो करीन अक्‌कल मांगजो, काहाके सण्‌का करवा वाळो ते दर्‌या मे आव्‌वा वाळी झलक नी तेम से, जे वाहळा मे एथीन-एथी उछळ्‌या करे। <verse eid="JAS 1:6" /><verse number="7" style="v" sid="JAS 1:7" />तीने कदी बी आहयी आह नी करवा जोवे के मालीक भणी गेथु मने कंय जड़हे। <verse eid="JAS 1:7" /><verse number="8" style="v" sid="JAS 1:8" />भगवान पोर सण्‌का करवा वाळो माणेह ते बे मन वाळो रेय, अने आखी वात मे टेकलो नी रेय।<verse eid="JAS 1:8" /></para>
  <para style="s">गरीब अने मालदार</para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 1:9" />जे गरीब भरहो करन्‌या भाय से, तीहया उचा जागा नी खुसी करे। <verse eid="JAS 1:9" /><verse number="10" style="v" sid="JAS 1:10" />अने मालदार माणेह नी दसा चारा ना फुल नी तेम से। अने तीनु फुल चीमाय्‌न पड़ जाय। <verse eid="JAS 1:10" /><verse number="11" style="v" sid="JAS 1:11" />दाड़ो उगे अने जबर तोप लागे, अने चारो ह़ुक जाय अने तीनु फुल पड़ जाय, अने तीनी ह़ोबा जती रेय; आने रीते मालदार माणेह बी आपणो काम करते-करते कादा मे भेसकाय जहे।<verse eid="JAS 1:11" /></para>
  <para style="s">पारख अने हाय</para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 1:12" />जुगाळो से तीहयो माणेह जे पारख मे बी टेकलो रेय, काहाके खरलो नीकळीन जीवाय नी तीहयी पागड़ी हात करहे, जीनो वायदो भगवान आपणा मोंग करवा वाळा सी करलो से। <verse eid="JAS 1:12" /><verse number="13" style="v" sid="JAS 1:13" />पारख मे पड़े ता आहयु नी केवा जोवे, के “भगवान पारख मारी जीवाय मे लायो।” काहाके भगवान ने कोय बी पाप नी कराड़ सके, अने भगवान बी कोयने नी पारखे। <verse eid="JAS 1:13" /><verse number="14" style="v" sid="JAS 1:14" />पण काना बी माणेह आह़फी लालच नी लारे पड़ीन अने फसीन पारख मे पड़ जाय। <verse eid="JAS 1:14" /><verse number="15" style="v" sid="JAS 1:15" />अळतेण हाय भारेपोगे हय्‌न पाप ने पयदा करे अने पाप वद जाय ता मोत ने पयदा करे।<verse eid="JAS 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="JAS 1:16" />ए मारा मोंगाळ्‌ळा भायु, अने बेन्‌या आह़फा ने धोको ना देवो। <verse eid="JAS 1:16" /><verse number="17" style="v" sid="JAS 1:17" />काहाके आखी वारली चीज अने वारलो वाटो अने एक वारलो दान उपर सी जड़े, वीजाळा ना बाह भणी गेथु जड़े, जीनी मे नी ते कंय बदलाव हय सके, अने नी अदल-बदल ना कारण सी तीनी पोर छाञो पड़े। <verse eid="JAS 1:17" /><verse number="18" style="v" sid="JAS 1:18" />भगवान आह़फा मरजी सी आमने सच्‌चाय ना बोलु नी लारे बणायो, काहाके आमु तीनी बणावली चीज मे सी एक भाती ना पेला फोळ हये।<verse eid="JAS 1:18" /></para>
  <para style="s">ह़मळवा अने करवा</para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 1:19" />ए मारा मोंगाळ्‌ळा भायु अने बेनेह, आहयी वात तमु जाण लेवो, आखा माणहु ह़मळवा नी लेदे तीयार अने बोलवा मे धीरा अने रीह करवा मे धीरा हयो। <verse eid="JAS 1:19" /><verse number="20" style="v" sid="JAS 1:20" />काहाके कोय बी माणेह नी रीह, भगवान ना वारला काम नो नीयाव नी कर सके। <verse eid="JAS 1:20" /><verse number="21" style="v" sid="JAS 1:21" />एतरे आखी मोयाळ्‌ळी वात ने, अने कुहराय ने छेटी कर देवो। अने तीहया बोलु ने आह़फा नी जीवाय मे नीचळा हय्‌न आवरी लेवो; काहाके आहयो खरलो बोल तमारी आत्‌मा ने छुटकारो आप सकत्‌लो।<verse eid="JAS 1:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="JAS 1:22" />बाखीन ह़मळवा वाळा एतरात ना बणो, ता तमु आह़फा ने धोको दी र्‌या, पण तीनी पोर चालवा वाळा बणो। <verse eid="JAS 1:22" /><verse number="23" style="v" sid="JAS 1:23" />जे कोय भगवान ना बोल ते ह़मळे, पण भगवान ना बोलु नी अनसारे नी जीवे; तीहयो तीहया माणहु ह़रकु से, जे आह़फा ना मोडा ने आरहा मे देखे। <verse eid="JAS 1:23" /><verse number="24" style="v" sid="JAS 1:24" />अने आह़फा ना मोडा नो मोळ काडे वगर तत्‌यारुत जत रेय, अने आह़फा ना मोडा नो सीको वीहरी जाय। <verse eid="JAS 1:24" /><verse number="25" style="v" sid="JAS 1:25" />पण जे माणेह, छुटकारा ना चोखला कायदा पोर मन लगाड़तो रेय, तीहयो आह़फा ना काम मे आनी लेदे संयबरकत जड़हे के तीहयो ह़मळीन भुले नी, पण तीसमेत काम करे।<verse eid="JAS 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 1:26" />कदी कानो माणेह भक्‌ती करन्‌यो से ईसम मान लेय, अने आह़फा नी जीप ने आह़फा ना कब्‌जा मे नी राखे, ता तीहयो आह़फा ना मन ने धोको देय, एतरे भक्‌ती करवा फालतु से। <verse eid="JAS 1:26" /><verse number="27" style="v" sid="JAS 1:27" />आपणा बाह भगवान नी अगळ चोखली अने वारली भक्‌ती आहयी से के वीखावाळा अने रंडायला बयरा ना दुख मे, तीमनी खबर लेवो। अने आह़फा ने कळी गेथो वण-गुनाळ्‌ळा राखो।<verse eid="JAS 1:27" /></para>
  <chapter eid="JAS 1" />
  <chapter number="2" style="c" sid="JAS 2" />
  <para style="s">ईसु ना मंडळी वाळा माणहु छीट नी राखवा जोवे</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 2:1" />ए मारा भायु, बड़ाय भर्‌या मालीक ईसु मसी पोर भरहो करवा नी लारे आपणु आखा एक से; एतरे कोयनी बी भेद-भाव नी करवा जोवे। <verse eid="JAS 2:1" /><verse number="2" style="v" sid="JAS 2:2" />मान लेवो, कंखर माय्‌न एक माणेह ह़ोना नी वीटी अने वार घटाळ्‌ळा लुगड़ा पेरीन आवे, अने एक गरीब जीनी पांह कंय बी नी हय, तीहयो बी मोळ वाळा, कोचळायला लुगड़ा पेरीन आवे; <verse eid="JAS 2:2" /><verse number="3" style="v" sid="JAS 2:3" />अने तमु तीहया घटाळ्‌ळा लुगड़ा पेरीन आवण्‌या नु मोडु देखीन केवो के “ए दादा, तु आञे वारला मे बह” अने तीहया गरीब ने केवो के “तु हीञा उबो रे, नीता मारा पोगुन्‌तां बह।” <verse eid="JAS 2:3" /><verse number="4" style="v" sid="JAS 2:4" />ईसम वेहवार करीन तमु ते एक वगा वळीन नाना-मोटा नी छीट राख र्‌या। एसवो वीच्‌यार खोड़लो से ईसम वीच्‌यार करीन तमु माणहुम गरीब अने मालदार नो टाळो पाड़ र्‌या।<verse eid="JAS 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 2:5" />ए मारा भायु, ह़मळो। भगवान आहयी कळी ना गरीब माणहु ने भरहा मे मालदार अने भगवान ना राज ना हकदार्‌या बणाव्‌वा करीन टाळलो से। जे भगवान ने मोंग करे, तीमने तीहयो आह़फा राज नो हकदार्‌यो बणाव्‌वा करीन पेले गेथोत वायदो करलो से। <verse eid="JAS 2:5" /><verse number="6" style="v" sid="JAS 2:6" />पण तमु गरीब नी ह़ाही नी कर्‌या। ह़ु मालदार माणेह तमने वेला नी पाड़्‌यो अने तमने कोरट-कचवरी मे घीहड़ी-घीहड़ीन लीजवा वाळा कोय से? <verse eid="JAS 2:6" /><verse number="7" style="v" sid="JAS 2:7" />ह़ु तीहया वारु नाम नी नामबद्‌दी नी कर्‌या जीना तमु केवायो।<verse eid="JAS 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="JAS 2:8" />भगवान ना खरला सास्‌तर ना आहया बोल नी लारे “तु आह़फा ह़ाते वाळा ने आह़फा नी तेम मोंग कर।” ह़ाचलीन तीहया राज कायदो आखा मे मोटो से करीन आपणो राजा ईसु ह़ीकाड़लो से। कंखर माय्‌न तमु कायदो पाळो ता तमु वारलुत काम कर र्‌या। <verse eid="JAS 2:8" /><verse number="9" style="v" sid="JAS 2:9" />पण कदीम तमु भेद-भाव करता हय ता पाप कर र्‌या, अने कायदो तमने गुनाळ्‌ळा ठेरावलो से। <verse eid="JAS 2:9" /><verse number="10" style="v" sid="JAS 2:10" />काहाके जे कोय आखा कायदा पाळे, पण एकीत वात मे चुक जाय, ता तीहयो आखी वात मे गुनाळ्‌ळो केवाये। <verse eid="JAS 2:10" /><verse number="11" style="v" sid="JAS 2:11" />एतरे के जे “तमु छीनाळु नी करजो” ईसम हुकम आप्‌यो, तीहयोत आहयु हुकम बी आपलो से के “तमु हत्‌या नी करजो।” एतरे तमु छीनाळु ते नी कर्‌या, पण खुन एतरोत कर्‌या, ते बी तमु भगवान ना कायदा ना अनसारे गुनाळ्‌ळा रेहु। <verse eid="JAS 2:11" /><verse number="12" style="v" sid="JAS 2:12" />तमु तीहया माणहु नी तेम बोल बोलो अने काम बी करो, जीनो नीयाव छुटला बी करे अमर जीवाय नी हीसाबे कायदा नी तेम हयहे। <verse eid="JAS 2:12" /><verse number="13" style="v" sid="JAS 2:13" />काहाके जे दया नी कर्‌या, तीमनो नीयाव वण-दया नो हयहे: दया नीयाव पोर जीकली से।<verse eid="JAS 2:13" /></para>
  <para style="s">भरहो अने काम</para>
  <para style="p">
    <verse number="14" style="v" sid="JAS 2:14" />ए भायु, कंखर माय्‌न कोय केय के मे ईसु पोर भरहो करु, पण भलाय नो काम नी करु, ता आनी सी कंय बी फायदो नी हय। एसवो भरहो करन्‌या ने भगवान छुटकारो नी आपे। <verse eid="JAS 2:14" /><verse number="15" style="v" sid="JAS 2:15" />मान लेवो के काना भाय नीता बेन्‌या पांह पेरवा जुगु लुगड़ा नी हय, अने दाड़ीक खावा जुगु खाणु नी हय; <verse eid="JAS 2:15" /><verse number="16" style="v" sid="JAS 2:16" />अने कंखर माय्‌न तमारी माय्‌न कोय तीने केय, “खुस हय्‌न जत रे; अने वारु लुगड़ा पेरजे अने पेट भरीन खाणु खाजे।” पण तीहयो केवा वाळो तीमने डील जुगु जे नी आपे, ता तीना केदला बोलु कंय बी फायदो नी करे <verse eid="JAS 2:16" /><verse number="17" style="v" sid="JAS 2:17" />तेमेत भरहो बी काम वगर नी हय ता भलाय ना काम वगर मरलो से।<verse eid="JAS 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="JAS 2:18" />कंखर माय्‌न कोय पुछ के “भगवान पोर तारो भरहो से ह़ु?” ता मे कीही “होव, मे ते भलाय ना काम नी लारे मारा भरहा नो पुरावो दी र्‌यो। मे तने मारा भरहा ने भलाय ना काम नी लारे देखाड़ही। पण भगवान ना नाम सी भलाय ना काम करे वगर, तु कीसम की सके, के मे भगवान पोर भरहो करु?” <verse eid="JAS 2:18" /><verse number="19" style="v" sid="JAS 2:19" />ए मनख्‌या एकीत भगवान से, ईसम तारो भरहो से ह़ु? पण कुहर्‌या भुत बी भगवान पोर भरहो करे, अने थर-थर कापे। <verse eid="JAS 2:19" /><verse number="20" style="v" sid="JAS 2:20" />ए वण-अकल्‌या माणेह, ह़ु तु आहयु नी जाणतो के भलाय ना काम नी करे, ता तारो भरहो रीकामो से? <verse eid="JAS 2:20" /><verse number="21" style="v" sid="JAS 2:21" />अब्‌राहम ते भगवान ना केणा सी आह़फा सोरा ईसाक ने भगवान जुगु वेदी पोर मारीन चड़ाव्‌वा करीन ली ज्‌यो, ईसम करीन तीहयो भगवान नु हुकम मानीन भगवान ने गमे ईसम काम कर्‌यो करीन भगवान हीयो धरमी से करीन गवा देदो। <verse eid="JAS 2:21" /><verse number="22" style="v" sid="JAS 2:22" />अब्‌राहम नो भगवान पोर एतरो जबर भरहो हतो, के तीहयो जे कंय बी केदो, तीने करवा करीन तीयार हतो, एतरे जे भलाय ना काम अब्‌राहम कर्‌यो, तीनी सी आपणी अगळ आहयी वात उजन्‌ती हय जाय के अब्‌राहम ना भरहा मे कंय बी कसर नी री। <verse eid="JAS 2:22" /><verse number="23" style="v" sid="JAS 2:23" />चोखली सास्‌तर मे ईसम लीखलु से “अब्‌राहम भगवान पोर भरहो कर्‌यो, अने भगवान तीने धरमी गण्‌यो।” सास्‌तर नु आहयु बोल अब्‌राहम ना जीवाय मे पुरु हय ज्‌यु। अने भगवान नो दोस्‌तीदार्‌यो बण ज्‌यो। <verse eid="JAS 2:23" /><verse number="24" style="v" sid="JAS 2:24" />आहयी रीते तमु देख लेदा के माणहु भरहा सी एतरो नी पण तीना भलाय ना कामु सी बी धरमी गीणायहे।<verse eid="JAS 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="JAS 2:25" />पेल्‌ना वारा नी राहाब बेनेह जे रंडी हती, अने जे युहदी माणेह राहाब रेत्‌ली तीहया देस नी खबर लेवा करीन आया, तीमने तीहयी आह़फा ना घोर मे ह़ताड़ देदी, अने अळतेण बीजी वाट्‌ये तीमने मोकली देदी, आहया भलाय ना काम नी लारे भगवान तीने धरमी गण्‌यो।<verse eid="JAS 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="JAS 2:26" />एतरे: जीसम डील आत्‌मा वगर मरलो से, तेमेत भरहो बी भलाय ना काम वगर मरलो से।<verse eid="JAS 2:26" /></para>
  <chapter eid="JAS 2" />
  <chapter number="3" style="c" sid="JAS 3" />
  <para style="s">जीप ने आह़फा कब्‌जा मे राखवा</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 3:1" />ए मारा भायु, बेन्‌या तमारी मे आखा ह़ीकाड़वा वाळा ना बणो, काहाके जाणीया के ह़ीकाड़वा वाळा वदु गुनेगार गीणायहे। <verse eid="JAS 3:1" /><verse number="2" style="v" sid="JAS 3:2" />काहाके आमु आखा घणी कावा हुक जत्‌ला; अने जे बोल बोलवा मे नी हुकत्‌ला तीहया ते खरला माणेह से अने आखा डील ने बी कब्‌जा मे राख सके। <verse eid="JAS 3:2" /><verse number="3" style="v" sid="JAS 3:3" />जत्‌यार आपणु घोड़ा ने कब्‌जा मे करवा करीन तीना मोडा मे लगाम पेराव्‌वा पड़े। तात, घोड़ो बंदाय। अने आपणु तीने, जां लीजवा हय तां ली जाय सकया। <verse eid="JAS 3:3" /><verse number="4" style="v" sid="JAS 3:4" />जरीक वीच्‌यार करो! दर्‌या मे चालन्‌यु ढुंड्‌यु बी घणु मोटु रेय। दर्‌या मे घण-जबर चालवा वाळी आंजी मे तीहयु एथुन-एथु फीर जाय। ते बी एक नान्‌ला हींडल ना लारे ढुंड्‌यु चलाड़न्‌यु आंजी मे ढुंड्‌या ने जां लीजवा हय तां लीत्‌ती रेय।<verse eid="JAS 3:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="JAS 3:5" />तेमेत जीप बी आपणा डील नो नानुह एक अंग से, ते बी मोटी-मोटी वात करवा मे कुहराये नी। पण आहयी जीप नी लेदे, आक्‌ठु ना तीणगा ना बारा मे वीच्‌यार करो! आहया तीणगा नी लारे बड़ा मे हुड़ु-हुड़ु आक्‌ठु लाग जाय। <verse eid="JAS 3:5" /><verse number="6" style="v" sid="JAS 3:6" />होव जीप बी एक आच से, आहयी बुराय नी एक आखी कळी से, आहयी जीप आपणा डील नो एक एवो अंग से जे आखा डील ने बगाड़ देय। अने अमारी आखी जीवाय मे आक्‌ठु लगाड़ देय, आहयी जीप नरक नी आक्‌ठी सी धपती रेय।<verse eid="JAS 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 3:7" />आहयी कळी मे वाळा भात-भाती ना जंगली जानवरु ने, अने पाणी मे चालवा-फीरवा वाळा जानवरु ने, अने भात-भाती ना चड़ा ने, अने धरती पोर घहड़ाय्‌न चालन्‌या भात-भाती ना जानवरु ने माणहु बदाड़ सके, अने घण झाजा जानवरु ने बदाड़ बी लेदला से। <verse eid="JAS 3:7" /><verse number="8" style="v" sid="JAS 3:8" />माणहु नी जीप ने कोय बी माणेह बदाड़ नी सके। जीप मे गेथा नीकळवा वाळा खोड़ला बोलु ते कुहराय ने उबजाड़े। ह़ाचली ने जीप, जीव ली लेय, एसवी जेहर ह़ारकी से। <verse eid="JAS 3:8" /><verse number="9" style="v" sid="JAS 3:9" />आहयी जीप सी आपणु मालीक भगवान बाह नी बड़ाय करीया, अने आहयी जीप सी भगवान ना रुप मे घड़ायला माणहु ने सराप आपीया। <verse eid="JAS 3:9" /><verse number="10" style="v" sid="JAS 3:10" />एकीत मोडाम गेथु आपणु सराप बी आपीया अने भगवान घणु वारु बी कीया। ईसम हयवा वारु से ह़ु? ए मारा भायु अने बेन्‌या ईसम नी केजो। <verse eid="JAS 3:10" /><verse number="11" style="v" sid="JAS 3:11" />एकीत झोर मे गेथु गळ्‌ळु अने खारलु पाणी नकळी सके ह़ु? <verse eid="JAS 3:11" /><verse number="12" style="v" sid="JAS 3:12" />ए मारा भायु! अने बेन्‌या गुलर ना झाड़ पोर जेतुन नो फोळ लाग सके ह़ु? आने रीते खारला पाणी ना झोर मे गेथु गळ्‌ळु पाणी नी नीकळे। <figure style="fig" alt="Rider on a horse" file="lb00035c.tif" size="col" copy="Horace Knowles ©" ref="3:3">घोड़ा पोर बहीन जाय </figure><verse eid="JAS 3:12" /></para>
  <para style="s">बे भाती नी अक्‌कल</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 3:13" />तमारी मे ईसम कोय से, जे आह़फा ने अक्‌कल वाळु अने जाणकार ह़मजे? जे ईसम हय, तीहयो आह़फी खरली अक्‌कल नी लारे पुरावो देणु जोवे। अने आहयी अक्‌कल ने बीजा ह़ाते वारु वेहवार नी अने काम नी लारे उजन्‌ती करवा जोवे। <verse eid="JAS 3:13" /><verse number="14" style="v" sid="JAS 3:14" />पण कंखर माय्‌न तमु आह़फा-आह़फा मन मे खार राखीन कुहराय अने बीजा गेथा मोटा बणवा हींडो, अने आह़फा बारा मे आहयु कीन सच्‌चाय नी वीरोद मे झुट मेक र्‌या के आमु जाणकार अने अक्‌कल वाळा से। एतरे तमु झुट मेकवा सोड़ देवो। <verse eid="JAS 3:14" /><verse number="15" style="v" sid="JAS 3:15" />एसवी अक्‌कल उपर ह़रग गेथी नी आवे, पण आहयी कळी ना माणहु नी से। एसवी अक्‌कल भगवान नी आपे, पण भुतड़ा वगे गेथी आवे। <verse eid="JAS 3:15" /><verse number="16" style="v" sid="JAS 3:16" />जां ह़ारीक माणहु एक-बीजा पोर कुहराये, अने बीजा गेथा मोटा बणवा नी हेर करे, तां ह़ारीक आखी भाती ना कुहरायला कामु अने झगड़ा हये। <verse eid="JAS 3:16" /><verse number="17" style="v" sid="JAS 3:17" />पण जे अक्‌कल भगवान उपर गेथी आपे, तीहयी अक्‌कल खास चोखली से। एतरे जीने आहयी अक्‌कल जड़ली से तीहया माणहु, बीजा ह़ाते मेळाका रेय, अने ह़ुवाळा-ह़याळा रेय, अने बीजा नी वात बी मानवा तीयार रेय। अने बीजा ना भलाय ना काम करता रेय। तीहया ते ढोंगड़ा नी करे, अने कोयनी छीट राखीन कोयनी वगे नी वळे। <verse eid="JAS 3:17" /><verse number="18" style="v" sid="JAS 3:18" />जे मेळ कराव्‌वा वाळा रेय, तीहया बीजा ने बी मेळाका बणाय देय, अने ईसम करीन तीहया आखा मेळीन धरम नो काम करीन जीव्‌वा बाज जाय। जे वारलुत वेरे, अने वारलुत वाडे।<verse eid="JAS 3:18" /></para>
  <chapter eid="JAS 3" />
  <chapter number="4" style="c" sid="JAS 4" />
  <para style="s">कळी ह़ाते दोस्‌तीदारी</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 4:1" />तमारी मे लड़ाय अने झगड़ा कां गेथा आय ज्‌या, के ह़ु आहया तमारी मरजी सी नी आवत्‌ला जे तमारी मोय झगड़ा करता रेय। <verse eid="JAS 4:1" /><verse number="2" style="v" sid="JAS 4:2" />तमु हाय ते करो, अने तमने जड़तु नी; तमु खुन अने डहवाय ते करत्‌ला, अने कंय नी हात कर सकत्‌ला, तमु झुमात्‌ला। तमने आनीन करते नी जड़त्‌लु के तमु भगवान पांह मांगत्‌ला नी। <verse eid="JAS 4:2" /><verse number="3" style="v" sid="JAS 4:3" />तमु मांगत्‌ला से अने जड़े नी, आनीन करीन के गलत मरजी सी मांगत्‌ला से, काहाके आपणी मोज-मस्‌ती मे उड़ाय देय।<verse eid="JAS 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="JAS 4:4" />ए छीनाळ्‌याण, ह़ु तमु नी जाणती के कळी सी दोस्‌ती करवा भगवान सी झगड़ो करवा नु से? एतरे जे कोय कळी नो ह़ाती हयवा हेर करे, तीहयो आह़फा ने भगवान नो वेरी बणावे। <verse eid="JAS 4:4" /><verse number="5" style="v" sid="JAS 4:5" />ह़ु तमु आहयु ह़मजत्‌ला से, के चोखली सास्‌तर अमथीत केय? जे चोखली आत्‌मा ने तीहयो अमारी मोय बहाड़्‌लो से, ह़ु तीहयो आसवी हाय करे, जीनु फोळ डहवाय से। <verse eid="JAS 4:5" /><verse number="6" style="v" sid="JAS 4:6" />तीहयो ते अळी बी दया आपत्‌लो से; आनीन करीन आहयु लीखलु से, “भगवान घमंड करन्‌या नो वीरोद करे, पण भोळा पोर दया करे।”<verse eid="JAS 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 4:7" />एतरे तमु भगवान ना हक मे हय जावो; अने भुतड़ा नी वात नो सामनो करो, ता तीहयो तमारीन्‌तां गेथो नाह जहे। <verse eid="JAS 4:7" /><verse number="8" style="v" sid="JAS 4:8" />भगवान नी ह़ाते आवो, ता तीहयो बी तमारी ह़ाते आवहे। ए पापी, आपणा हात चोखा करो, ए बे मन्‌या माणहु आपणा मन ने चोखलु करो। <verse eid="JAS 4:8" /><verse number="9" style="v" sid="JAS 4:9" />दुखी हय, अने वेला करो, अने रड़ो। तमारी ह़ाही वेला मे अने तमारी घण खुसी होह़टाय मे बदल जाय। <verse eid="JAS 4:9" /><verse number="10" style="v" sid="JAS 4:10" />मालीक नी अगळ ह़ुमाळा बणो, ता तीहयो तमने मोटो बणावहे।<verse eid="JAS 4:10" /></para>
  <para style="s">भायु पोर गुनो लगाड़वा</para>
  <para style="p">
    <verse number="11" style="v" sid="JAS 4:11" />ए भायु, अने बेन्‌या एक-बीजा नी बदनामी ना करो। जे आपणा भाय नी बदनामी करे, नीता भाय पोर गुनो लगाड़े, कायदा नी बदनामी करे, अने कायदा पोर गुनो लगाड़े, अने कदी तु कायदा पोर गुनो लगाड़े ता तु, कायदा पोर चालवा वाळो नी पण तीनी पोर नीयाव करन्‌यो बण ज्‌यो। <verse eid="JAS 4:11" /><verse number="12" style="v" sid="JAS 4:12" />कायदा आपवा वाळो अने नीयाव करन्‌यो ते एकीत से, जे बचाड़वा अने बरबात करवा मे लायक से। जे आपणा ह़ाते वाळा पोर गुनो लगाड़े?<verse eid="JAS 4:12" /></para>
  <para style="s">घमंड ना वीरोद मे चेतावणी</para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 4:13" />ह़मळो, तमु जे, आहयु की र्‌या, के “आज नीता वाणे आमु काना बीजा ह़ेर मे जाय्‌न तां एक साल रेहु, अने वेपारु करीन फायदो कमाहु।” <verse eid="JAS 4:13" /><verse number="14" style="v" sid="JAS 4:14" />तमु आहयु नी जाणता के वाणे ह़ु हयहे। ह़मळी ते लेवो, तमारी जीवाय ह़ु से? तमु ते धुंमरु ह़रकी से, जे थोड़ीक वार देखाव पड़े, अने उलुप हय जतलु। <verse eid="JAS 4:14" /><verse number="15" style="v" sid="JAS 4:15" />एतरे तमने ईसम केवा जोवे के “कंखर माय्‌न मालीक नी मरजी हहे, ता जीवत्‌ला रेहु, अने आहयु काम नीता तीहयु काम करहु।” <verse eid="JAS 4:15" /><verse number="16" style="v" sid="JAS 4:16" />पण हाव तमु मोटाय करत्‌ला, अने मोटी-मोटी वात करत्‌ला, एवी आखी मोटाय गलत से। <figure style="fig" alt="Customer, merchant with his wares" file="hk00172c.tif" size="col" copy="Horace Knowles ©" ref="4:13">लेवा वाळा अने वेपार्‌या आह़फाम ना ह़मान ह़ाते </figure><verse eid="JAS 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="JAS 4:17" />एतरे जे कोय भलाय करवा जाणतो हय अने भलाय नी करे, ता तीहयो पाप कर र्‌यो।<verse eid="JAS 4:17" /></para>
  <chapter eid="JAS 4" />
  <chapter number="5" style="c" sid="JAS 5" />
  <para style="s">मालदार माणहु ने चेताव्‌वा</para>
  <para style="p">
    <verse number="1" style="v" sid="JAS 5:1" />ए मालदार्‌या! मारी वात ह़मळो! तमु आड़ी-आड़ीन रड़ो अने वेला करवा जोवे, काहाके गरा तमारी पोर आय्‌न पड़वा वाळी से। <verse eid="JAS 5:1" /><verse number="2" style="v" sid="JAS 5:2" /><note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 6:19">मत्‌ती 6:19</ref></char></note>तमारो धन बगड़ी जेलु से, अने तमारा लुगड़ा ने कीड़ा खाय जेला से। <verse eid="JAS 5:2" /><verse number="3" style="v" sid="JAS 5:3" />तमारा ह़ोना-चांदी मे कीट लाग जेली से! अने तीहयी कीट तमारी वीरोद मे गवाय देहे, अने आक्‌ठु नी तेम तमारु माह खाय जहे। तमु ते आखरी टेम मे धन भेळु करला से। <verse eid="JAS 5:3" /><verse number="4" style="v" sid="JAS 5:4" />जे दाड़क्‌या तमारा खेतर नी मेर वाड्‌या, अने तमु तीमने दाड़की नी आप्‌या। तीहयी आड़ी री, वाडवा वाळा नी वीन्‌ती ह़रगे वाळा सेना ना मालीक ना कान्‌टा लग पुग जेली से। <verse eid="JAS 5:4" /><verse number="5" style="v" sid="JAS 5:5" />तमु धरती पोर सुक सी जीवीन घण-जबर मजा करला से; अने मरवा ना दाड़ा नी लेदे आह़फा ना मन ने पाळी-पोहीन माता-माता बणाय लेदला से। <verse eid="JAS 5:5" /><verse number="6" style="v" sid="JAS 5:6" />धरमी तमारी वेठीन ह़ाम्‌बो बोल लग नी केदो, तमु तीने गुनाळ्‌ळा से, करीन मार नाख्‌या।<verse eid="JAS 5:6" /></para>
  <para style="s">गम अने वीन्‌ती</para>
  <para style="p">
    <verse number="7" style="v" sid="JAS 5:7" />एतरे ए भायु, मालीक ने पासो आवता लग दम धरो। कीरसाण ने देखीन ह़ीको, तीहयो ते खेतर मे वारु मेर नी आह राखतो जाय्‌न, पेलो अने आखरी पाणी आव्‌वा लग दम धरत्‌लो। <verse eid="JAS 5:7" /><verse number="8" style="v" sid="JAS 5:8" />मालीक ने पासो आव्‌वा नो दाड़ो ह़ाते से। एतरे तमु बी गम खावो, अने मन ने टणको राखो।<verse eid="JAS 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="JAS 5:9" />ए भायु, अने बेन्‌या एक-बीजा पोर गुनो ना लगाड़ो, काहाके तमारी पोर गुनो नी लागे, देखो, नीयाव करन्‌यो झापला पोर उबो हय र्‌यो। <verse eid="JAS 5:9" /><verse number="10" style="v" sid="JAS 5:10" />ए भायु अने बेन्‌या जे वाती माणहु मालीक नी नाम सी वात कर्‌या, तीमने दुख झेलवा अने गम खावा मे एक दाखलो ह़मजो <verse eid="JAS 5:10" /><verse number="11" style="v" sid="JAS 5:11" />देखो, आमु गम खाण्‌या ने जुगाळा से कीया। तमु ते अय्‌युब ना गम ना बारा मे ते ह़मळ्‌ळात से, अने मालीक नी भणी गेथु जे तीने फोळ जड़्‌यो तीने बी जाण लेदो, जीने मालीक नी घणी गीण अने दया उजन्‌ती हयत्‌ली से।<verse eid="JAS 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="JAS 5:12" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:12 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 5:34-37">मत्‌ती 5:34-37</ref>
      </char>
    </note>ए भायु, आखा गेथी मोटी वात आहयी से के तमु ह़ाम नी खाजो, नी ते ह़रग नी, नी ते धरती नी, अने नी कानी बीजा चीज नी, पण तमारी वात आतरीत हये, होव के होव, अने नी के नी हये, के तमु डंड ना लायक नी बणो।<verse eid="JAS 5:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="JAS 5:13" />कदी तमारी मे कोय दुख मे हय, ता तीहयो वीन्‌ती करे। कदी घण खुस हय, ता भजन गावे। <verse eid="JAS 5:13" /><verse number="14" style="v" sid="JAS 5:14" /><note caller="+" style="x"><char style="xo" closed="false">5:14 </char><char style="xt" closed="false"><ref loc="MRK 6:13">मरकुस 6:13</ref></char></note>कदी तमारी मे कोय मांदलु हय, ता मंडळी ना अगळवाण्‌या ने बोलावो, अने तीहया मालीक ना नाम सी तीनी पोर तेल लगाड़ीन तीनी लेदे वीन्‌ती करे, <verse eid="JAS 5:14" /><verse number="15" style="v" sid="JAS 5:15" />अने भरहा नी वीन्‌ती नी लारे मांदलु बच जहे, अने मालीक तीने उठाड़ीन उबो करहे, अने कदी पाप बी कर्‌यो हय, ता तीने माफी बी जड़हे। <verse eid="JAS 5:15" /><verse number="16" style="v" sid="JAS 5:16" />एतरे तमु एक-बीजा नी अगळ आह़फा-आह़फा पाप ने मान लेवो, अने एक-बीजा जुगु वीन्‌ती करो, जीनी सी तमु आरगा हय जावो, धरमी माणहु नी वीन्‌ती सी घणु कंय हय सके <verse eid="JAS 5:16" /><verse number="17" style="v" sid="JAS 5:17" />एलीया बी ते आपणीन तेवो दुख सुक भुगतवा वाळो माणेह हतो, अने तीहयो ईमानदारी सी वीन्‌ती कर्‌यो, के पाणी नी आव्‌वा जोवे, अने साड़ी तीन साल लग पाणी नी पड़्‌यो। <verse eid="JAS 5:17" /><verse number="18" style="v" sid="JAS 5:18" />अळतेण तीहयो वीन्‌ती कर्‌यो, के पाणी आव्‌वा जोवे। अने वादळा मे गेथु पाणी पड़्‌यो, ता धरती पोर मेर पाकी।<verse eid="JAS 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="JAS 5:19" />ए भायु, कदी कोय खरली वाट्‌ये गेथु छेटु हय जाय, अने कोय बीजो तीने पासो लीयावे, <verse eid="JAS 5:19" /><verse number="20" style="v" sid="JAS 5:20" /><note caller="+" style="x"><char style="xo" closed="false">5:20 </char><char style="xt" closed="false"><ref loc="1PE 4:8">1 पतरस 4:8</ref></char></note>ता आहयु जाण लेवो के जे कोय काना भंगलाय्‌ला पापी ने पासो लीयावे, ता तीहयो तीनी आत्‌मा ने मोत सी बचाड़हे अने घणा पाप ढाक देहे।<verse eid="JAS 5:20" /></para>
  <chapter eid="JAS 5" />
</usx>