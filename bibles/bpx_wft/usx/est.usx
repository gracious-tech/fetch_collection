<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EST" style="id">- Paliya New Testament</book>
  <para style="h">एस्‌तर</para>
  <para style="toc3">एस्‌तर</para>
  <para style="toc2">एस्‌तर</para>
  <para style="toc1">एस्‌तर</para>
  <para style="mt1">एस्‌तर नी कीताप</para>
  <para style="imt">जानकारी</para>
  <para style="ip">एस्‌तर नी कीताप देखाड़े के कीकम फारस मे बंदी बणावला ईस्‌रायलीम ने एक एवा दुस्‌मन सी बचाड़्‌या जे तीमने खत्‌तम करवा नी योजना बणाय र्‌यो हतो। एस्‌तर मे भगवान ना नाम ना बारा मे वात नी करली हय, पण आहयु पक्‌कु से के भगवान तीमने तीहयी आखी मारा नी आहयी कोसीत सी बचाड़्‌यो। कोय नी जाणतु के एस्‌तर नी कीताप कोय लीखलु से। वापरली हीब्‌रु भासा ना हीसाब ना आदार पोर, ढेरेत जानकारु ह़ला आपे के एस्‌तर नी कीताप 400 ईसा पेले नी आड़े-धेड़े लीखली हती।</para>
  <para style="ip">एस्‌तर नी कीताप मे ह़मळावली घटना देखाड़े के यहुदी पुरीम ना तीवार ने कीकम वाळे। हामान नाम नो एक अमालेकी यहुदी माणहु ने खत्‌तम करवा नी योजना बणायो। ईस्‌रायली अने अमालेकी तत्‌यार गेथा दुस्‌मन हता जत्‌यार गेथा ईस्‌रायली उजाड़ी बड़ा मे हय्‌न तीहया देस मे पुगला हता जीनो वायदो भगवान तीमनी ह़ाते करलो हतो <char style="xt"><ref loc="EXO 17:8-16">नीरगमन 17:8-16</ref></char>। तीहयी टेम नी आड़े-धेड़े जत्‌यार हामान यहुदीम ने खत्‌तम करवा नी योजना बणाव्‌वा बाज र्‌यो हतो, एस्‌तर जे एक यहुदी हती, फारस नी राणी बण जी। आह़फा ना ह़गला मोर्‌दके नी ह़ला सी, एस्‌तर हामान नी योजना ने रोक सकी। यहुदीम नी लारे आह़फाम ना दुस्‌मनु पोर जीक हात करवान अळतेण <char style="xt"><ref loc="EST 9:20-22">एस्‌तर 9:20-22</ref></char>, मोर्‌दके तीमने आहयी जीक नी खुसी मनाव्‌वा करीन केदो। आहयी रीते यहुदी पुरीम नो तीवार वाळवा सुरु कर्‌या।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. एस्‌तर फारस नी राणी कीकम बणी। <char style="ior"><ref loc="EST 1-2">1–2</ref></char></para>
  <para style="io1">2. हामान यहुदीम ने खत्‌तम करवा नी योजना बणायो अने आसम करवा ना कारण सी तीने मार नाख्‌यो। <char style="ior"><ref loc="EST 3-7">3–7</ref> </char></para>
  <para style="io1">3. यहुदी आह़फा ना दुस्‌मनु ने कीकम हराया अने पुरीम नो तीवार कीकम सुरु कर्‌या। <char style="ior"><ref loc="EST 8-10">8–10</ref></char></para>
  <chapter number="1" style="c" sid="EST 1" />
  <para style="s">वसती राणी राजा सयर्‌स नी बेजती करे</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 1:1" />सयर्‌स नाम ना राजा ना राज ना दाड़ा मे आहयी वात हयी: आहयो तीहयोत सयर्‌स से, जे एक ह़ो सत्‌तावीस देस पोर मतलब भारत देस सी लगाड़ीन कुस देस<note caller="+" style="f"><char style="fr" closed="false">1:1 </char><char style="fq" closed="false">कुस देस </char><char style="ft" closed="false">कुस देस नु पेले ईथीफीया हतु</char></note> तक राज करतो हतो। <verse eid="EST 1:1" /><verse number="2" style="v" sid="EST 1:2" />राजा सयर्‌स ना राज करवा ना दाड़ा मे राजवाड़ु सुसन नाम ना कीला मे हतु तां राजगादी पोर बहीन तीहयो राज करतो हतो।<verse eid="EST 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 1:3" />ता तीहयो आह़फा ना राज करवा ना तीसरा साल मे आह़फा ना अदीकार्‌या ने अने काम करन्‌या ने खाणु खवाड़्‌यो। फारस अने मादे देस ना सीपायड़ा ना मुख्‌या अने देस-देस ना मुख्‌या अने अदीकार्‌या बी तां हता। <verse eid="EST 1:3" /><verse number="4" style="v" sid="EST 1:4" />तीहयो तीमने घणा दाड़ा मतलब छो मयना तक आह़फा ना राजवाड़ा नु माल-धन अने बड़ाय नु कीमती ह़मान देखाड़तो र्‌यो।<verse eid="EST 1:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 1:5" />आहया दाड़ा पुरा हयवान अळतेण राजो आखा नान्‌ला-मोट्‌ला तीहया आखा ने बी जे सुसन नाम ना कीला मे एक्‌ठा हयला हता, राजवाड़ा ना बगीचा नु आंगणु मे ह़ात दाड़ा तक खाणु खवाड़्‌यो। <verse eid="EST 1:5" /><verse number="6" style="v" sid="EST 1:6" />तां ना पड़दा धोळ्‌ळा अने लील्‌ला सुती ना हता, अने हीर अने जामण्‌या रंग नी दोरी वेर चांदी ना छल्‌ला मे, संगमरमर ना खम्‌बा मे लागला हता; अने तां ना बहवा ना पाट्‌ला ह़ोनु-चांदी ना हता; अने रात्‌ली अने धोळ्‌ळी अने पीळ्‌ळी अने काळ्‌ळी संगमरमर नी बणली फरसी पोर मेकला हता <verse eid="EST 1:6" /><verse number="7" style="v" sid="EST 1:7" />तीहया खाणु नी पंगात मे राजा नी लायक अंगुर नु ह़रु भाती-भाती ना ह़ोना ना ठाहरा मे घालीन राजा ना सोक सी घणु जादा पीयाड़्‌या। <verse eid="EST 1:7" /><verse number="8" style="v" sid="EST 1:8" />पीवा ते नेम नी अनसारे हयतु हतु, काहाके राजो आह़फा ना आखा खाणु-पीणु आपवा वाळा ने हुकम आपलो हतो, के जे पोरणु जेम चाहे तेमेत तीनी ह़ाते वेहवार करे।<verse eid="EST 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 1:9" />राणी वसती बी राजा सयर्‌स ना घोर मे बयरा ने खाणु खवाड़ी।<verse eid="EST 1:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 1:10" />ह़ातवा दाड़े, जत्‌यार राजा नु मन अंगुर नु ह़रु मे खुस हतु, ता तीहयो महुमान, बीजता, हर्‌बोना, बीगता, अबगता, जेतेर अने कर्‌कस नाम ना ह़ातोव गतराड़ा ने जे सयर्‌स राजा नी अगळ सेवा-चाकरी कर्‌या करता हता, हुकम आप्‌यो, <verse eid="EST 1:10" /><verse number="11" style="v" sid="EST 1:11" />के राणी वसती ने राज-मुकुट पेरलीत राजा नी अगळ ली आवो; जीनी सी के देस-देस ना माणहु अने अदीकार्‌या अगळ घटाळ्‌ळी देखाय सके; काहाके तीहयी देखायवा मे घटाळ्‌ळी हती। <verse eid="EST 1:11" /><verse number="12" style="v" sid="EST 1:12" />गतराड़ा नी लारे राजा ना आहया हुकम ने ह़मळीन राणी वसती आव्‌वा सी नीकारो कर देदी। आनी पोर राजो घण जबर खीजवाय पड़्‌यो।<verse eid="EST 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 1:13" />ता राजो टेम-टेम ना बारा मे जाणवा वाळा पुंजारा ने पुछ्‌यो, राजो ते नेती अने नीयाव ना आखा अक्‌कल वाळा सी आसमेत कीया करतो हतो। <verse eid="EST 1:13" /><verse number="14" style="v" sid="EST 1:14" />तीनी पांह कर्‌सना, सेतार, अदमाता, तर्‌सीस, मेरेस, मर्‌सना, अने ममुकान नाम ना फारस अने मादे देस ना ह़ात मुख्‌या हता, जे राजा नो दरसन करता हता, अने राज्‌य मे मुख्‌या-मुख्‌या जागा पोर टाळला हता। <verse eid="EST 1:14" /><verse number="15" style="v" sid="EST 1:15" />राजो पुछ्‌यो, “राणी वसती राजा सयर्‌स ना, गतराड़ा नी लारे आपला हुकम ने नी मानी, ता नेम नी अनसारे तीनी ह़ाते ह़ु करवा जोवे?”<verse eid="EST 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 1:16" />ता ममुकान, राजा अने अदीकारी नी अगळ आहयो जपाप आप्‌यो, “राणी वसती जे गलत काम करली से, तीहयु राजा ह़ाते एतरुत नी पण आखा अदीकार्‌या ह़ाते अने तीहया आखा देस ना माणहु ह़ाते बी करली से; जे राजा सयर्‌स ना आखा देस मे रेय। <verse eid="EST 1:16" /><verse number="17" style="v" sid="EST 1:17" />काहाके राणी ना आहया काम नी वात आखा बयरा मे हयहे अने जत्‌यार आहयु केहे, ‘राजो सयर्‌स राणी वसती ने आह़फा अगळ ली आव्‌वा नो हुकम आप्‌यो पण तीहयी नी आवी,’ ता तीहया बी तीमना घोरवाळाम ने हेटा ह़मजवा बाज जहे। <verse eid="EST 1:17" /><verse number="18" style="v" sid="EST 1:18" />आज ना दाड़े फारसी अने मादे देस ना अदीकार्‌या ना लाड्‌या जे राणी नी आहयी वात ह़मळला से, तीहया बी राजा ना आखा अदीकार्‌याम ने आसमेत केवा बाज जहे; आहयी रीते घण-जबर ह़ीगी अने रीह पयदा हयहे। <verse eid="EST 1:18" /><verse number="19" style="v" sid="EST 1:19" />कदीम राजा ने वारु लागे, ता आहयो हुकम नीकाळे, अने फारस अने मादे देस ना नेम मे लीखी बी देय, जीनी सी कदी बी बदल नी सके, के राणी वसती राजा सयर्‌स नी अगळ अळी कदी आव्‌वा नी जोवे, अने राजो पटराणी नो जागो कानी बीजी ने आप देय जे तीनी गेथी वारु हय। <verse eid="EST 1:19" /><verse number="20" style="v" sid="EST 1:20" />जत्‌यार राजा नो आहयो हुकम तीना आखा राज्‌य मे ह़मळावहे, ता आखा लाड्‌या आह़फा-आह़फाम ना घोरवाळा नी ईज्‌जत करहे, भले गरीब हय के अमीर।”<verse eid="EST 1:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 1:21" />आहयी वात राजा ने अने अदीकार्‌या ने गम जी अने राजो ममुकान नी ह़ला ने मान लेदो अने आह़फा ना राज्‌य मे, <verse eid="EST 1:21" /><verse number="22" style="v" sid="EST 1:22" />मतलब आखा देस नी भासा ना आकड़ा मे आखी जाती नी बोली मे चीठ्‌या ली मोकल्‌यो, के आखा अदमी आह़फा-आह़फाम ना घोर मे अदीकार चलाड़े, अने आह़फाम नी जाती नी बोली बोल्‌या करे।<verse eid="EST 1:22" /></para>
  <chapter eid="EST 1" />
  <chapter number="2" style="c" sid="EST 2" />
  <para style="s">एस्‌तर नु राणी बणनु</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 2:1" />आहयी वात हयवान अळतेण जत्‌यार राजो सयर्‌स नी रीह कम हय जी, ता तीहयो राणी वसती नी, अने जे काम तीहयी करली हती, अने तीना बारा मे हुकम नीकाळ्‌ळो हतो तीनी फोम कर्‌यो। <verse eid="EST 2:1" /><verse number="2" style="v" sid="EST 2:2" />ता राजा ना पावर्‌या जे तीनी चाकरी करता हता, केवा बाज ज्‌या, “राजा जुगु घटाळ्‌ळा अने कुवार्‌या सोर्‌या ह़ोदो। <verse eid="EST 2:2" /><verse number="3" style="v" sid="EST 2:3" />अने राजो आह़फा ना आखा देस मे माणहु ने आनीन करते टाळे के तीहया आखा घटाळ्‌ळा कुवार्‌या सोर्‌या ने सुसन नाम ना कीला मे राण्‌या रेवा ना जागा मे एक्‌ठा करे अने राजा जुगु राणी नो जुगाड़ करवा वाळा हेगे ने जे राजा नो गतराड़ो हतो ह़ोप देय; अने ह़ींगारवा नु ह़मान तीमने आप देय। <verse eid="EST 2:3" /><verse number="4" style="v" sid="EST 2:4" />ता तीमनी मे गेथी जे कुवारी राजा नी नींगा मे वारु ठेरे, तीने राणी वसती ना जागा पोर राणी बणावहे।” आहयी वात राजा ने वारु लागी अने तीहयो तेमेत कर्‌यो।<verse eid="EST 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 2:5" />सुसन नाम ना कीला मे मोर्‌दके नाम नो एक यहुदी रेतो हतो, जे कीस नाम ना एक बीन्‌यामीन जाती वाळा नो सोरा ना सोरा नो सोरो, सीमी ना सोरा नो सोरो अने याईर नो सोरो हतो। <verse eid="EST 2:5" /><verse number="6" style="v" sid="EST 2:6" />तीहयो तीहया धरायला माणहु ह़ाते यरुसलेम गेथो धराय्‌न जेलो हतो, जीमने बेबीलोन नो राजो नबुकदनेस्‌सर, यहुदा ना राजा यकोन्‌याह नी ह़ाते बांदीन लीजलो हतो। <verse eid="EST 2:6" /><verse number="7" style="v" sid="EST 2:7" />तीहयो हदस्‌सा नाम नी आह़फा नी बीजी आय्‌ह नी बेनेह ने, जे एस्‌तर बी केवायती हती, पाळलो-पोहलो हतो; काहाके तीना आय्‌ह-बाहा नी हता, अने तीहयी सोरी घटाळ्‌ळी अने सीकाळ्‌ळी हती, अने जत्‌यार तीना आय्‌ह-बाहा मर ज्‌या, ता मोर्‌दके तीने आह़फा नी सोरी करीन पाळ्‌यो।<verse eid="EST 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 2:8" />जत्‌यार राजा ना हुकम अने नेम ह़मळाया, अने घण ढेरका सोर्‌या, सुसनगड़ मे हेगे ना अदीकार मे एक्‌ठी करीन ह़ोप देदा, ता एस्‌तर ने बी राजवाड़ा मे बयरा ना जुगाड़ करवा वाळा हेगे ना अदीकार मे ह़ोप देदी। <verse eid="EST 2:8" /><verse number="9" style="v" sid="EST 2:9" />एस्‌तर तीनी नींगा मे वारु लागी अने तीहयो तीनी सी खुस हयो, ता तीहयो वार लगाड़्‌या वगर तीने राजवाड़ा मे गेथु चोखु करवा नु ह़मान, अने तीनु खाणु, अने तीनी जुगु टाळली ह़ात दोस्‌तीदार्‌याण बी आप्‌या, अने तीने अने तीनी दोस्‌तीदार्‌याण ने राणी ना रेवा ना जागा मे आखा गेथो वारु रेवा नो जागो आप्‌या।<verse eid="EST 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 2:10" />एस्‌तर नी ते आह़फी नु घोराणु ना बारा मे देखाड़ी अने नी आह़फी नो कुळीवेलो, काहाके मोर्‌दके तीने हुकम आपलो हतो के तीने नी देखाड़जे। <verse eid="EST 2:10" /><verse number="11" style="v" sid="EST 2:11" />मोर्‌दके दाड़ीक राणी ना रेवा ना जागा ना आंगणान अगळ माय्‌न आनीन करते सरक्‌या करतो हतो के एस्‌तर केवी से अने तीनी ह़ाते ह़ु हयहे?<verse eid="EST 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 2:12" />जत्‌यार एक-एक सोरी नी वारी आयी, के तीहयी सयर्‌स राजान्‌तां जाय अने आहयु तीहयी टेमे हयु जत्‌यार तीनी ह़ाते बयरा जुगु ठेरावला नेम नी अनसारे बारे मयना तक वेहवार करला हता; मतलब तीमना ह़ींगार करवा ना दाड़ा आहयी रीते वीत ज्‌या के छो मयना गंदायण्‌या रोह नु तेल चोपड़ता हता, अने छो मयना तक गंदायण्‌यो मसालो, अने बयरा ने ह़ींगारवा नु बीजु ह़मान लगाड़ता हता। <verse eid="EST 2:12" /><verse number="13" style="v" sid="EST 2:13" />आहयी रीते तीहया सोर्‌या जत्‌यार राजान्‌तां जता हता, ता जे कंय तीहयी राणी ना रेवा ना जागे गेथु राजवाड़ा मे लीजवा हींडे, तीहयु ह़मान तीने आपता हता। <verse eid="EST 2:13" /><verse number="14" style="v" sid="EST 2:14" />ह़ांती ते तीहयी जती हती अने ह़वारे तीहयी पासी आवीन राणी ना रेवा ना जागा ना बीजा घोर मे जाय्‌न रखेल ना जुगाड़ लगाड़वा वाळा राजा ना गतराड़ा सासगज ना अदीकार मे हय जता हता, अने राजान्‌तां अळी नी जती हती, कदीम राजो तीनी सी खुस हय जतो हतो, ता तीने नाम लीन बोलावता हता।<verse eid="EST 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 2:15" />जत्‌यार मोर्‌दके ना काका अबीहेल नी सोरी एस्‌तर, जीने मोर्‌दके सोरी मानीन पाळलो हतो, तीनी वारी आयी के तीहयी राजान्‌तां जाय, ता जे कंय बयरा नो जुगाड़ लगाड़वा वाळो राजा नो गतराड़ो हेगे तीनी जुगु ठेरावलो हतो, तीनी गेथु जादा तीहयी अळी कंय बी नी मांगी। जेतरा एस्‌तर ने देख्‌या, तीहया आखा तीनी सी खुस हया। <verse eid="EST 2:15" /><verse number="16" style="v" sid="EST 2:16" />एस्‌तर ने राजवाड़ा मे राजा सयर्‌स ने तां तीना राज ना ह़ातवा साल ना तेबेत नाम ना दहवा मयना मे ली ज्‌या, <verse eid="EST 2:16" /><verse number="17" style="v" sid="EST 2:17" />राजो एस्‌तर ने बीजा बयरा गेथो जादा मोंग कर्‌यो, अने बीजा आखा कुवार्‌या सोर्‌या करते बरकत अने दया नी नींगा तीनीत पोर हयी, करीन तीहयो तीना मुंडा पोर राज-मुकुट पेरायो अने तीने वसती ना जागा पोर राणी बणायो। <verse eid="EST 2:17" /><verse number="18" style="v" sid="EST 2:18" />ता राजो आह़फा ना आखा अदीकार्‌या अने काम करवा वाळा ने घणु जादा खाणु खवाड़्‌यो, अने तीने एस्‌तर नु खाणु केदो; अने देस मे छुट्‌टी आप्‌यो अने दया नी लायक ईलाम बी वाट्‌यो।<verse eid="EST 2:18" /></para>
  <para style="s">मोर्‌दके नु राजा नो जीव बचाड़नु</para>
  <para style="p">
    <verse number="19" style="v" sid="EST 2:19" />आहयी टेमे राजो मोर्‌दके ने आह़फा नी सरकारी सेवा करवा टाळ लेदलो हतो, <verse eid="EST 2:19" /><verse number="20" style="v" sid="EST 2:20" />एस्‌तर आह़फी ना माणहु अने कुळ ना बारा मे देखाड़ली नी हती, काहाके मोर्‌दके तीने आसम हुकम आपलो हतो के नी देखाड़जे; अने एस्‌तर मोर्‌दके नी वात आसम मान्‌ती हती जेम के तीनीन्‌तां तीने पाळवा-पोहवा नी टेमे मान्‌ती हती।<verse eid="EST 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="EST 2:21" />तीहयात दाड़ा मे जत्‌यार मोर्‌दके राजा ना राजवाड़ा ना झापले बह्‌या करतो हतो, ता राजा ना गतराड़ा जे झापले पेहरो देण्‌या बी हता, तीमनी मे गेथा बीगतान अने तेरेस नाम ना बे जणा राजा सयर्‌स ह़ाते रीहाय्‌न तीने मारवा नो वीच्‌यार कर्‌या। <verse eid="EST 2:21" /><verse number="22" style="v" sid="EST 2:22" />आहयी वात मोर्‌दके ने मालम हयी, अने तीहयो एस्‌तर राणी ने आहयी वात देखाड़्‌यो, अने एस्‌तर राणी मोर्‌दके नु नाम लीन राजा ने चेताय देदी। <verse eid="EST 2:22" /><verse number="23" style="v" sid="EST 2:23" />ता पुसतास करीन आहयी वात ह़ाचली नीकळी अने तीमने बेम जणा ने झाड़कु पोर टांग देदा, अने आहयी काहणी ने राजा अगळ खांदानी नी कीताप मे लीख लेदा।<verse eid="EST 2:23" /></para>
  <chapter eid="EST 2" />
  <chapter number="3" style="c" sid="EST 3" />
  <para style="s">यहुदी माणहु ने खत्‌तम करवा नी हामान नी लारे चाल</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 3:1" />आहयी वात हयवान अळतेण राजो सयर्‌स अगाग कुळ ना हम्‌मदाता ना सोरा हामान ने तीनी बड़ोत्‌री करीन आखा सी उचो पद आप्‌यो, <verse eid="EST 3:1" /><verse number="2" style="v" sid="EST 3:2" />राजा ना आखा काम करवा वाळा जे राजवाड़ा ना झापले रीया करता हता, तीहया हामान अगळ ढुंगा वळीन वांद्‌या करता हता काहाके राजो तीना बारा मे आसमेत हुकम आपलो हतो; पण मोर्‌दके नी ते ढुंगो वळतो हतो अने नी वांदतो हतो। <verse eid="EST 3:2" /><verse number="3" style="v" sid="EST 3:3" />ता राजा ना काम करन्‌या जे राजवाड़ा ना झापले रीया करता हता, तीहया मोर्‌दके ने पुछ्‌या, “तु राजा ना हुकम ने काहा नी मान्‌तो?” <verse eid="EST 3:3" /><verse number="4" style="v" sid="EST 3:4" />जत्‌यार तीहया दाड़ीन तीने आसमेत केता र्‌या, अने तीहयो तीमनी एक बी वात नी मान्‌यो, ता तीहया आहयु देखवा नी ईच्‌छा सी के मोर्‌दके नी आहयी वात मानहे के नी, करीन हामान ने देखाड़ देदा; तीहयो तीमने देखाड़ देदलो हतो के मे यहुदी से। <verse eid="EST 3:4" /><verse number="5" style="v" sid="EST 3:5" />जत्‌यार हामान देख्‌यो के मोर्‌दके ढुंगो नी वळतो, अने मने नी वांदतो, ता हामान घणो खीजवाय आयो। <verse eid="EST 3:5" /><verse number="6" style="v" sid="EST 3:6" />तीहयो मोर्‌दके ने एतरोत देवा वारु नी ह़मज्‌यो। काहाके तीहया हामान ने की देदला हता के मोर्‌दके कानी जाती नो से, एतरे हामान सयर्‌स ना देस मे रेवा वाळा आखा यहुदीम ने बी मोर्‌दके नी जाती जाणीन, खत्‌तम कर देवा हींडतो हतो।<verse eid="EST 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 3:7" />राजा सयर्‌स ना बारवा साल ना नीसान नाम ना पेल्‌ला मयना मे, हामान अदार नाम ना बारवा मयने तक ना एक-एक दाड़े अने एक-एक मयना जुगु “पुर” मतलब आह़फा अगळ चीट्‌ठी नखाड़्‌यो।<verse eid="EST 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="EST 3:8" />ता हामान राजा सयर्‌स ने केदो, “तारा राज्‌य ना आखा देस मे रेवा वाळा देस-देस ना माणहु नी वचमे अलग-अलग जागे खोळवायला माणहु से, जीना नेम बीजा माणहु ना नेम करते अलग से; अने तीहया राजा ना नेम पोर नी चालता, करीन तीमने रेवा देवा राजा नी करते फायदो नी हय। <verse eid="EST 3:8" /><verse number="9" style="v" sid="EST 3:9" />कदीम राजा ने वारु लागे ता तीमने खत्‌तम करवा नो हुकम लीखे, अने मे राजा ना गोदाम रखवाळ्‌या ना हात मे राजवाड़ा मे पुगाड़वा करीन, दह हजार चांदी ना सीक्‌का आपही।”<verse eid="EST 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 3:10" />ता राजो आह़फा नी वीटी आह़फा नी आंगळी मे गेथी काडीन, अगाग कुळी ना हम्‌मदाता ना सोरा हामान ने, जे यहुदीम नो वेरी हतो आप देदो; <verse eid="EST 3:10" /><verse number="11" style="v" sid="EST 3:11" />अने राजो हामान ने केदो, “आहया माणहु अने तीमना पय्‌हा तारा हात मे से; अने तीमनी ह़ाते जेम तारु मन करे तेवोत वेहवार करे।”<verse eid="EST 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 3:12" />ता तीहयात पेल्‌ला मयना ना तेरवा दाड़े राजा ना लीखण्‌या ने बोलाया, अने हामान ना हुकम नी अनसारे राजा ना आखा मंत्‌री, अने आखा देस ना मुख्‌या, अने देस-देस ना अदीकार्‌या जुगु चीठ्‌या, एक-एक देस ना अक्‌कर मे, अने एक-एक देस ना माणहु नी भासा मे राजा सयर्‌स ना नाम सी लीख्‌या; अने तीनी मे राजा नी वीटी नो सीलटप्‌पो लगाड़ देदा। <verse eid="EST 3:12" /><verse number="13" style="v" sid="EST 3:13" />राज्‌य ना आखा देसु मे आहया नेम ना चीठ्‌या ने, चीठ्‌या लीजवा वाळा नी लारे ली मोकल्‌या के एकीत दाड़ा मे, मतलब अदार नाम ना बारवा मयना ना तेरवा दाड़े, ह़ु जुवान, ह़ु डायला, ह़ु बयरा, ह़ु सोरा, आखा यहुदीम ने मार नाखे, अने तीमने खत्‌तम कर देय; अने तीमना माल-धन ने लुट लेय। <verse eid="EST 3:13" /><verse number="14" style="v" sid="EST 3:14" />तीहया हुकम लीखली चीट्‌ठी ना नकल ने आखा देस मे खुल्‌ला ली मोकल्‌या अने देखाड़्‌या के आखा देस ना माणहु तीहया दाड़ा जुगु तीयार हय जाय।<verse eid="EST 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 3:15" />आहयो हुकम सुसन नाम ना कीला मे आप्‌यो, अने चीट्‌ठी वयवा वाळा राजा ना हुकम सी तत्‌यारुत नीकळ ज्‌या। राजो अने हामान ते पीवा बह ज्‌या, पण सुसन ह़ेर मे घबराट फेल जी।<verse eid="EST 3:15" /></para>
  <chapter eid="EST 3" />
  <chapter number="4" style="c" sid="EST 4" />
  <para style="s">मोर्‌दके नु एस्‌तर पांह मदत मांगणु</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 4:1" />जत्‌यार मोर्‌दके जाण लेदो के ह़ु-ह़ु करलु से ता मोर्‌दके लुगड़ा फाड़ीन, गोंटो ओडीन, रोखड़ो नाखीन, ह़ेर नी वचमे जाय्‌न उचा अने दुख-भरला बोल सी आड़वा बाज ज्‌यो; <verse eid="EST 4:1" /><verse number="2" style="v" sid="EST 4:2" />अने तीहयो राजवाड़ा ना झापला अगळ पुग्‌यो, पण गोंटो ओडीन राजवाड़ा ना झापला नी मोय ते कोय ने बी जवा नो हुकम नी हतो। <verse eid="EST 4:2" /><verse number="3" style="v" sid="EST 4:3" />एक-एक राज्‌य मे, जां-जां राजा नो हुकम अने नेम पुग्‌यो, तां-तां यहुदी माणहु घण-जबर कलपवा अने उपाह पाळवा अने रड़वा बाज ज्‌या; अने घणा ढेरका गोंटा ओडीन अने रोखड़ो नाखीन पड़ र्‌या।<verse eid="EST 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 4:4" />एस्‌तर राणी नी पावर्‌याण अने गतराड़ा जाय्‌न तीने की देदा, ता राणी घणी दुखी हय जी; अने मोर्‌दकेन्‌तां लुगड़ा ली मोकलीन आहयु की मोकली के गोंटो काडीन आमने पेर ले, पण तीहयो लुगड़ा ने नी लेदो। <verse eid="EST 4:4" /><verse number="5" style="v" sid="EST 4:5" />ता एस्‌तर राजा ना गतराड़ा मे गेथा हताक ने जीने राजो तीनी सेवा करवा केदलो हतो, बोलावीन हुकम आपी के मोर्‌दकेन्‌तां जाय्‌न मालम कर ले के ह़ु वात से, अने आनो ह़ु कारण से। <verse eid="EST 4:5" /><verse number="6" style="v" sid="EST 4:6" />ता हताक ह़ेर ना चोवराया पोर, जे राजवाड़ा ना झापला नी अगळ हतो, मोर्‌दकेन्‌तां नीकळ ज्‌यो। <verse eid="EST 4:6" /><verse number="7" style="v" sid="EST 4:7" />मोर्‌दके तीने आखु कंय देखाड़ देदो के मारी पोर ह़ु-ह़ु वीतली से, अने हामान यहुदीम ने खत्‌तम करवा नी छुट मांगवा करीन राजवाड़ा ना गोदाम मे केतरा पय्‌हा आपवा नो वायदो करलो से, तीहयु आखु बी वारु-वारु की देदो। <verse eid="EST 4:7" /><verse number="8" style="v" sid="EST 4:8" />अळतेण यहुदीम ने खत्‌तम करवा नो जे हुकम सुसन मे आपलो हतो, तीनी एक चीट्‌ठी बी तीहयो हताक ना हात मे, एस्‌तर ने देखाड़वा करीन आप्‌यो, अने तीनो आखो हाल देखाड़वा अने आहयो हुकम आपवा केदो, के मोय राजान्‌तां जाय्‌न तारा माणहु जुगु रावण्‌या करीन वीन्‌ती करे। <verse eid="EST 4:8" /><verse number="9" style="v" sid="EST 4:9" />ता हताक, एस्‌तर ने तां जाय्‌न मोर्‌दके नी वात ह़मळायो। <verse eid="EST 4:9" /><verse number="10" style="v" sid="EST 4:10" />ता एस्‌तर हताक ने मोर्‌दके ने आहयु केवा नो हुकम आपी, <verse eid="EST 4:10" /><verse number="11" style="v" sid="EST 4:11" />“राजा ना आखा काम करवा वाळा, अने राजा ना देस ना आखा माणहु ने बी मालम से, के ह़ु अदमी ह़ु बयरा, कोय बी काहा नी हय, जे हुकम वगर मोय आंगणु मे राजान्‌तां जाय तीने मार नाखवा नोत हुकम से; जीनी भणीन राजो ह़ोना नो राज डंड नाम्‌बो करे तीहयोत बचे। पण हमणे मने तीस दाड़ा हय ज्‌या राजान्‌तां नी बोलायी।”<verse eid="EST 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 4:12" />एस्‌तर नी आहयी वात मोर्‌दके ने ह़मळाया। <verse eid="EST 4:12" /><verse number="13" style="v" sid="EST 4:13" />ता मोर्‌दके एस्‌तर ने तां आहयु केवाड़ मोकल्‌यो, “तु मनमेत-मन मे आहयो वीच्‌यार ना करे के मेत राजवाड़ा मे रेवा ना कारण सी बीजा यहुदीम नी मे गेथी बचीन रेही। <verse eid="EST 4:13" /><verse number="14" style="v" sid="EST 4:14" />काहाके जे तु आहयी टेमे होगी रेही, ता अळी कानान काना सादन सी यहुदीम नो छुटकारो अने मदत हय जहे, पण तु तारा बाह ना घोराणा भेळ खत्‌तम हय जही। ह़ु मालम तने आवीत काठली टेम जुगु राजा नो जागो जड़लो हय!”<verse eid="EST 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 4:15" />ता एस्‌तर मोर्‌दकेन्‌तां आहयु की मोकली, <verse eid="EST 4:15" /><verse number="16" style="v" sid="EST 4:16" />“तु जाय्‌न सुसन ना आखा यहुदीम ने एक्‌ठा कर, अने तमु आखा मेळीन मारी जुगु उपाह पाळो, तीन दाड़ा अने तीन रात नी ते कंय खावो अने नी कंय पीवो। मे बी मारी पावर्‌याण नी ह़ाते आहयीत रीते उपाह पाळही; अने मे आसवीत हालत मे नेम ना वीरोद मे राजान्‌तां मोय जही; अने कदीम मे खत्‌तम हय जाम ता हय जाम।”<verse eid="EST 4:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EST 4:17" />ता मोर्‌दके जत र्‌यो अने एस्‌तर ना हुकम नी अनसारे तीहयो कर्‌यो।<verse eid="EST 4:17" /></para>
  <chapter eid="EST 4" />
  <chapter number="5" style="c" sid="EST 5" />
  <para style="s">राजा ने अने हामान ने एस्‌तर नु नेवतु आपणु</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 5:1" />तीसरा दाड़े एस्‌तर आह़फी ना राजवाड़ा ना लुगड़ा पेरीन राजवाड़ा मे मोय आंगणा मे जाय्‌न, राजवाड़ा नी अगळ उबी री जी। राजो राजवाड़ा मे राजगादी पोर राजवाड़ा ना झापला नी अगळ बह र्‌यो हतो; <verse eid="EST 5:1" /><verse number="2" style="v" sid="EST 5:2" />अने जत्‌यार राजो राणी एस्‌तर ने आंगणा मे उबी हय रेली देख्‌यो, ता तीनी सी खुस हय्‌न ह़ोना नो राजा नो डंडो जे तीना हात मे हतो तीनी भणीन नाम्‌बो कर्‌यो। ता एस्‌तर ह़ाते जाय्‌न राजा ना डंडा नु मुंडु छीमी। <verse eid="EST 5:2" /><verse number="3" style="v" sid="EST 5:3" />ता राजो तीने पुछ्‌यो, “ए एस्‌तर राणी, तने ह़ु जोवे? तु ह़ु मांगे? मांग अने तने आदु राज-पाट तक आप देही।”<verse eid="EST 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 5:4" />एस्‌तर केदी, “कदीम राजा ने वारु लागे, ता आज हामान ने ह़ाते लीन तीहयु खाणु जुगु आवे, जे मे राजा जुगु तीयार करली से।”<verse eid="EST 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 5:5" />ता राजो हुकम आप्‌यो, “हामान ने तत्‌यारुत ली आवो, के एस्‌तर नु नेवतु ने मान लीया।” अने राजो अने हामान एस्‌तर नु तीयार करलु खाणु जुगु आया। <verse eid="EST 5:5" /><verse number="6" style="v" sid="EST 5:6" />खाणु नी टेमे जत्‌यार अंगुर नु ह़रु पीता हता, ता राजो एस्‌तर ने केदो, “तारी ह़ु वीन्‌ता से? तीने पुरी कर देही। तु ह़ु मांगे? मांग, अने आदु राज तक तने आप देही।” <verse eid="EST 5:6" /><verse number="7" style="v" sid="EST 5:7" />एस्‌तर जपाप आपी, “मारी वीन्‌ता अने मे जे मांगु तीहयु आहयु से, <verse eid="EST 5:7" /><verse number="8" style="v" sid="EST 5:8" />के कदीम राजो मारी सी खुस हय अने मारी वीन्‌ता ह़मळवा अने जे मे मांगु तीहयुत राजो आपवा राजी हये, ता राजो अने हामान वाहणे तीहयु खाणु मे आवे जीने मे तीमनी जुगु तीयार करही, अने वाहणे मे राजा ना आहया बोल नी अनसारे करही।”<verse eid="EST 5:8" /></para>
  <para style="s">हामान नी मोर्‌दके ने मार नाखवा नी चाल</para>
  <para style="p">
    <verse number="9" style="v" sid="EST 5:9" />तीहया दाड़े हामान खुस हय्‌न अने मन मे घणी खुसी भेळ बाहर ज्‌यो। पण जत्‌यार तीहयो मोर्‌दके ने राजवाड़ा ना झापला पोर देख्‌यो, के तीहयो तीनी अगळ नी ते उबो हयो अने नी बीह्‌यो हयो, ता तीहयो मोर्‌दके ना वीरोद मे खीजवाय पड़्‌यो। <verse eid="EST 5:9" /><verse number="10" style="v" sid="EST 5:10" />ते बी तीहयो आह़फा ने रोकी राखीन आह़फा ना घोर ज्‌यो; अने आह़फा ना दोस्‌तीदार्‌या ने अने आह़फा नी लाडी जेरेस ने बोलावो मोकलो। <verse eid="EST 5:10" /><verse number="11" style="v" sid="EST 5:11" />ता हामान तीमने आह़फा नु धन नी बड़ाय, अने आह़फा ना सोरा नी बड़ोत्‌री अने राजो तीने कीकम-कीकम बड़ायो, अने बीजा अदीकार्‌या अने आह़फा ना आखा काम करन्‌या गेथो उचो पद आपलो हतो, आहयु आखु ना बारा मे वात देखाड़्‌यो। <verse eid="EST 5:11" /><verse number="12" style="v" sid="EST 5:12" />हामान आहयु बी केदो, “एस्‌तर राणी बी मने छोड़ीन अळी बीजा कोय ने बी राजा नी ह़ाते, तीनु खाणु मे आव्‌वा नी देदी; अने वाहणे जुगु बी राजा नी ह़ाते तीहयी मनेत नेवतु आपली से। <verse eid="EST 5:12" /><verse number="13" style="v" sid="EST 5:13" />ते बी जत्‌यार-जत्‌यार मने तीहयो यहुदी मोर्‌दके राजवाड़ा ना झापले बह रेलो देखाव पड़े, ता-ता आहयु आखु मारी नींगा मे रीकामु लागे।”<verse eid="EST 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EST 5:14" />तीनी लाडी जेरेस अने तीना आखा दोस्‌तीदार्‌या तीने केदा, “पचाह हात<note caller="+" style="f"><char style="fr" closed="false">5:14 </char><char style="fq" closed="false">पचाह हात </char><char style="ft" closed="false">वीह़ मीटर</char></note> उचो एक फासी नो एक खम्‌बो बणाव, अने ह़वारे राजा ने केजे के तीनी पोर मोर्‌दके ने टांग देवो; ता राजा ह़ाते खुसी भेळ खाणु खावा जजे।” आहयी वात सी खुस हय्‌न हामान तेमेत फासी नो एक खम्‌बो बणायो।<verse eid="EST 5:14" /></para>
  <chapter eid="EST 5" />
  <chapter number="6" style="c" sid="EST 6" />
  <para style="s">राजा नी लारे मोर्‌दके नी ईज्‌जत करनु</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 6:1" />तीहयी राते राजा ने नींदर नी आयी, करीन तीना हुकम सी खांदानी नी कीताप ने लाया, अने भणीन राजा ने ह़मळाया। <verse eid="EST 6:1" /><verse number="2" style="v" sid="EST 6:2" />तीनी मे आहयु लीखलु जड़्‌यु, के जत्‌यार राजा सयर्‌स ना अदीकार्‌या जे झापले पेहरो देण्‌या बी हता, तीमनी मे गेथा बीगतान अने तेरेस नाम ना बे जणा तीने मारवा नी वात करला हता तीने मोर्‌दके उजन्‌तो करलो हतो।<note caller="+" style="x"><char style="xo" closed="false">6:2 </char><char style="xt" closed="false"><ref loc="EST 2:12">एस्‌तर 2:12</ref>,<ref loc="EST 2:22">22</ref></char></note> <verse eid="EST 6:2" /><verse number="3" style="v" sid="EST 6:3" />ता राजो पुछ्‌यो, “आनी बदले मोर्‌दके ने ह़ु बड़ाय अने ईलाम आप्‌या?” राजा ना जे पावर्‌या तीनी सेवा-चाकरी करता हता, तीहया तीने जपाप आप्‌या, “तीनी जुगु कंय बी नी कर्‌या।”<verse eid="EST 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EST 6:4" />राजो पुछ्‌यो, “आंगणा मे कोय से?” तीहयीत टेमे हामान राजवाड़ा ना आंगणा मे आहयी हेर करीन आवलो हतो के जे खम्‌बो तीहयो मोर्‌दके जुगु तीयार करावलो हतो, तीनी पोर तीने टांग देवा नी वात राजा ह़ाते करे। <verse eid="EST 6:4" /><verse number="5" style="v" sid="EST 6:5" />ता राजा नो पावर्‌यो तीने केदो, “आंगणा मे ते हामान उबो हय र्‌यो।” राजो केदो, “तीने मोय बोलाय लावो।”<verse eid="EST 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 6:6" />जत्‌यार हामान मोय आयो, ता राजो तीने पुछ्‌यो, “जे माणेह नी राजो बड़ाय करवा हींडे ता तीनी जुगु ह़ु करवा वारु रेहे?” हामान आहयु सोचीन के मारी गेथी जादा राजो कोय नी बड़ाय करवा हींडे। <verse eid="EST 6:6" /><verse number="7" style="v" sid="EST 6:7" />तीहयो राजा ने जपाप आप्‌यो, “जे माणेह नी बड़ाय राजो करवा हींडे, <verse eid="EST 6:7" /><verse number="8" style="v" sid="EST 6:8" />तीनी जुगु राजा ना लुगड़ा लावे, जे राजो पेरे, अने एक घोड़ो बी, जीनी पोर राजो बहे, अने तीना मुंडा पोर राज-मुकुट मेके तीहयु बी लावे। <verse eid="EST 6:8" /><verse number="9" style="v" sid="EST 6:9" />अळतेण तीहया लुगड़ा, अने तीहयो घोड़ो राजा ना काना मोट्‌ला अदीकार्‌या ने ह़ोपे, अने जीनी बड़ाय राजो करवा हींडे, तीने तीहया लुगड़ा पेरावे, अने तीहया घोड़ा पोर बहाड़ीन ह़ेर ना चोवराया पोर तीने फीरावे; अने तीनी अगळ-अगळ आहयु परच्‌यार करे, ‘जीनी बड़ाय राजो करवा हींडे, तीनी ह़ाते आसमेत करहे।’”<verse eid="EST 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 6:10" />राजो हामान ने केदो, “उतवाळ करीन तु केदो तीनी अनसारे तीहया लुगड़ा अने घोड़ा ने लीन, तीहया यहुदी मोर्‌दके ह़ाते जे राजवाड़ा ना झापला पोर बह्‌या करे, तेमेत कर। जेम तु केदलो से तीनी मे कंय बी कमी नी रेवा जोवे।”<verse eid="EST 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 6:11" />ता हामान तीहया लुगड़ा, अने तीहया घोड़ा ने लीन, मोर्‌दके ने पेरायो, अने तीने घोड़ा पोर बहाड़ीन, ह़ेर ना चोवराया पोर आहयी रीते आड़तो जाय्‌न फीरायो, “जीनी बड़ाय राजो करवा हींडे आसमेत करहे।”<verse eid="EST 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="EST 6:12" />ता मोर्‌दके ते राजवाड़ा ना झापले पासो जत र्‌यो पण हामान दुखी हय्‌न मुंडु ढाकीन साटोत आह़फा ना घोर ज्‌यो, <verse eid="EST 6:12" /><verse number="13" style="v" sid="EST 6:13" />हामान तीनी लाडी अने तीना आखा दोस्‌तीदार्‌या ने तीहयु आखु जे तीनी ह़ाते हयु देखाड़्‌यो। ता तीना अक्‌कल वाळा दोस्‌तीदार्‌या अने तीनी लाडी जेरेस तीने केदा, “मोर्‌दके जीने तु नीचो देखाड़वा हींडे, कदीम तीहयो यहुदीम नी कुळी मे नो से, ता तु तीने हराय नी सके तीनी सी पुरी रीते हारीत जही।”<verse eid="EST 6:13" /></para>
  <para style="s">हामान नी मोत</para>
  <para style="p">
    <verse number="14" style="v" sid="EST 6:14" />तीहया तीनी ह़ाते वात करवात बाज र्‌या हता के राजा ना गतराड़ा आवीन हामान ने एस्‌तर नु खाणु जुगु उतवाळ करीन ली जती र्‌या।<verse eid="EST 6:14" /></para>
  <chapter eid="EST 6" />
  <chapter number="7" style="c" sid="EST 7" />
  <para style="p">
    <verse number="1" style="v" sid="EST 7:1" />राजो अने हामान एस्‌तर राणी नु खाणु जुगु आय लाग्‌या। <verse eid="EST 7:1" /><verse number="2" style="v" sid="EST 7:2" />राजो बीजा दाड़े ह़रु पीतो-पीतो एस्‌तर ने अळी पुछ्‌यो, “ए एस्‌तर राणी! तारी ह़ु वीन्‌ती से? तीहयी पुरी हय जहे। तु ह़ु मांगे? मांग, अने आदु राज तक तने आप देही।”<verse eid="EST 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 7:3" />एस्‌तर राणी जपाप आपी, “ए राजा! कदीम तु मारी सी खुस हय, अने राजा ने वारु लागे, ता मारी वीन्‌ती सी मने, अने मारा मांगवा सी मारा माणहु ने दया करीन जीवत्‌ला रेवा दे। <verse eid="EST 7:3" /><verse number="4" style="v" sid="EST 7:4" />काहाके मने अने मारा आखा माणहु ने वेच नाखला से, अने आमने आखा ने खत्‌तम करवा अने मारवा वाळा से। कदीम आमने पावर्‌या ना रुप वेच देता ता मे होगी रेती; भले तीहयी हालत मे आमने वेचवा सी राजा नु नुकसान नी जागे फायदोत हयतो।”<verse eid="EST 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="EST 7:5" />ता राजो सयर्‌स एस्‌तर राणी ने पुछ्‌यो, “तीहयु कोय से, अने कां से, जे आवु काम करवा नी हीम्‌मत करलु से?”<verse eid="EST 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 7:6" />एस्‌तर जपाप आपी, “तीहयो वीरोदी अने वेरी आहयोत दुस्‌मन हामान से!” ता हामान राजा अने राणी अगळ वहराय पड़्‌यो। <verse eid="EST 7:6" /><verse number="7" style="v" sid="EST 7:7" />राजो खीजवाय्‌न, अंगुर नु ह़रु पीतो-पीतो उठीन, राजवाड़ा नी वाड़ी मे जत र्‌यो; अने हामान आहयु देखीन के राजो मारु नुकसान करवा ठान लेदलो से, एस्‌तर राणी पांह मने जीवत्‌लो रेवा दे करीन उबो हयो। <verse eid="EST 7:7" /><verse number="8" style="v" sid="EST 7:8" />जत्‌यार राजो राजवाड़ा नी वाड़ी मे गेथो अंगुर नु ह़रु पीवा ना जागे पासो आयो ता देख्‌यो के हामान उच्‌ला पाटला पोर जीनी पोर एस्‌तर बह री ढुंगो वळ र्‌यो; अने राजो केदो, “ह़ु आहयात घोर मे मारी अगळ राणी नी ईज्‌जत लुटवा हींडे?” राजो मोडे गेथो आहयो बोल नीकाळलो एतरोत हतो, के पावर्‌या हामान नु मोडु ढाक देदा। <verse eid="EST 7:8" /><verse number="9" style="v" sid="EST 7:9" />ता राजा अगळ रेवा वाळा गतराड़ा मे गेथा हर्‌बोना नाम नो एक जणो राजा ने केदो, “हामान ने तां एक पचाह हात उचो फासी आपवा नो खम्‌बो उबो से, जे तीहयो मोर्‌दके जुगु बणावलो से, जे राजा नी भलाय नी वात केदलो हतो।” राजो केदो, “तीने तीनीत पोर टांग देवो।”<verse eid="EST 7:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="EST 7:10" />ता हामान ने तीहयात खम्‌बा पोर जे तीहयो मोर्‌दके जुगु तीयार करावलो हतो, तीने तां टांग देदा। आनी पोर राजा नी रीह कम हय जी।<verse eid="EST 7:10" /></para>
  <chapter eid="EST 7" />
  <chapter number="8" style="c" sid="EST 8" />
  <para style="s">यहुदी माणहु ने आह़फाम नी रखवाळी करवा नो हक जड़नु</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 8:1" />तीहयात दाड़े राजो सयर्‌स यहुदी ना वीरोदी हामान नु घोरबार एस्‌तर राणी ने आप देदो। मोर्‌दके राजा अगळ आयो, काहाके एस्‌तर राजा ने देखाड़ली हती, के तीनी ह़ाते तीनु ह़ु नातु से। <verse eid="EST 8:1" /><verse number="2" style="v" sid="EST 8:2" />ता राजो आह़फा नी तीहयी वीटी जे तीहयो हामान पांह गेथी ली लेदलो हतो, नीकाळीन मोर्‌दके ने आप देदो। एस्‌तर मोर्‌दके ने हामान ना घोरबार नो अदीकारी बणाय देदी।<verse eid="EST 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EST 8:3" />अळतेण एस्‌तर बीजी काव राजा ने केदी; अने तीना पोगु मे पड़ीन, आहवा पाड़ी-पाड़ीन वीन्‌ती करी के अगागी कुळी ना हामान नी बुराय अने यहुदीम ना वीरोद मे नुकसान नी चाल ने खत्‌तम कर दे। <verse eid="EST 8:3" /><verse number="4" style="v" sid="EST 8:4" />ता राजो एस्‌तर भणीन ह़ोना नो राजा नो डंडो नाम्‌बो कर्‌यो। ता एस्‌तर बठी हय्‌न राजा अगळ उबी हयी; <verse eid="EST 8:4" /><verse number="5" style="v" sid="EST 8:5" />अने केवा बाज जी, “कदीम राजा ने गमे अने मारी सी खुस हय अने आहयी वात तीने वारु मालम पड़े, अने मे बी तीने वारु लागु, ता जे चीठ्‌या अगागी कुळी ना हम्‌मदाता नो सोरो हामान राजा ना आखा देस यहुदीम ने खत्‌तम करवा नी चाल चालीन लीखाड़ली हती, तीने बदलवा करीन नवली चीट्‌ठी लीखे। <verse eid="EST 8:5" /><verse number="6" style="v" sid="EST 8:6" />काहाके मे मारा घोराणा अने मारा माणहु पोर आव्‌वा वाळी तीहयी गरा ने कीकम देख सकही? मे मारा भायु ने खत्‌तम हयते केम देख सकही?”<verse eid="EST 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EST 8:7" />ता राजो सयर्‌स एस्‌तर राणी ने अने यहुदी मोर्‌दके ने केदो, “मे हामान नु घोरबार ते एस्‌तर ने आप देदलो से, अने तीने फासी ना खम्‌बा पोर टांग देदला से, आनीन करते के तीहयो यहुदीम ने मारवा हींडतो हतो, <verse eid="EST 8:7" /><verse number="8" style="v" sid="EST 8:8" />हाव तमु तमारी ह़मज नी अनसारे राजा ना नाम सी यहुदीम नी जुगु लीखो, अने राजा नी वीटी नो सीलटप्‌पो बी लगाड़ो; काहाके जे चीट्‌ठी राजा ना नाम सी लीखे, अने तीनी पोर तीनी वीटी नो सीलटप्‌पो लगाड़े, तीने कोय बी बदली नी सके।”<verse eid="EST 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EST 8:9" />तीहयीत टेमे मतलब सीवान नाम ना तीसरा मयना ना तेवीसवा दाड़े राजा ना लीखवा वाळा ने बोलाया, अने जे-जे वात नो हुकम मोर्‌दके तीमने आपलो हतो तीने यहुदी मुख्‌या अदीकार्‌या अने भारत गेथा लगाड़ीन कुस देस तक, जे एक ह़ो सत्‌तावीस देस से, तीहया आखा ना मुख्‌या अदीकार्‌या अने अदीकार्‌या ने एक-एक देस ना अक्‌सर मे अने एक-एक देस नी भासा मे अने यहुदीम ने ईमना अक्‌सर अने भासा मे लीख्‌या। <verse eid="EST 8:9" /><verse number="10" style="v" sid="EST 8:10" />मोर्‌दके राजा सयर्‌स ना नाम सी चीठ्‌या लीखीन, अने तीमनी पोर राजा नी वीटी नो सीलटप्‌पो लगाड़ीन, उतवाळ्‌या चालवा वाळा सरकारी घोड़ा पोर बहवा वाळाम नी लारे चीठ्‌या ली मोकल्‌या।<verse eid="EST 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 8:11" />आहया चीठ्‌या मे आखा ह़ेर ना यहुदीम ने राजा भणीन गेथो हुकम आप्‌या, के तीहया एक्‌ठा हये अने आह़फा-आह़फाम नो जीव बचाड़वा करीन तीयार हय्‌न, जे देस ना माणहु वेला पाड़ीन तीमने नीता तीमना बयरा ने अने सोरा ने दुख देवा हींडे तीमने मारे अने खत्‌तम करे, अने तीमनु माल-धन लुट लेय। <verse eid="EST 8:11" /><verse number="12" style="v" sid="EST 8:12" />अने आहयु राजा सयर्‌स ना आखा देस मे एकीत दाड़े करे, मतलब अदार नाम ना बारवा मयना ना तेरवा दाड़े। <verse eid="EST 8:12" /><verse number="13" style="v" sid="EST 8:13" />आहया हुकम ना चीठ्‌या ना नकल, आखा देस ना माणहुन्‌तां खुल्‌ला ली मोकलहे; आनीन करते के यहुदी तीहया दाड़े आह़फाम ना वेरी ह़ाते बदलो लेवा करीन तीयार रेय। <verse eid="EST 8:13" /><verse number="14" style="v" sid="EST 8:14" />चीठ्‌या लीजवा वाळा उतवाळ्‌या चालवा वाळा घोड़ा पोर बहीन, राजा ना हुकम सी उतवाळ करीन साटात जत र्‌या, अने आहयो हुकम सुसन नाम ना कीला मे आप्‌यो।<verse eid="EST 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EST 8:15" />ता मोर्‌दके नीळ्‌ळा अने धोळ्‌ळा रंग ना राजा ना लुगड़ा पेरीन अने मुंडा पोर ह़ोना नु मोट्‌लु मुकुट मेकीन अने पातळ्‌ळु सुती नु बणावलु कापड़ु अने जामण्‌या रंग नु पोग मे गेथु डगलु पेरीन, राजा अगळ गेथो नीकळ्‌यो, अने सुसन ह़ेर ना माणहु खुसी सी कुर्‌राटवा बाज ज्‌या। <verse eid="EST 8:15" /><verse number="16" style="v" sid="EST 8:16" />यहुदी माणहु ने खुसी अने घणु-वारु लाग्‌यु अने तीमने घणी ईज्‌जत जड़ी। <verse eid="EST 8:16" /><verse number="17" style="v" sid="EST 8:17" />अने जे-जे देस, अने जे-जे ह़ेर मे, जां कंय बी राजा नो हुकम अने नेम पुग्‌या, तां-तां यहुदीम ने खुसी अने घणु-वारु लाग्‌यु, अने तीहया खाणु रांदीन तीहया दाड़ा ने खुसी नो दाड़ो मान्‌या। अने तीहया देस ना माणहु मे गेथा घणा माणहु यहुदी बण ज्‌या, काहाके तीमना मन मे यहुदीम नी बीक भराय जी।<verse eid="EST 8:17" /></para>
  <chapter eid="EST 8" />
  <chapter number="9" style="c" sid="EST 9" />
  <para style="s">यहुदी माणहु नु आह़फाम ना वेरीम ने खत्‌तम करनु</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 9:1" />अदार नाम ना बारवा मयना ना तेरवा दाड़े, जे दाड़े राजा नो हुकम अने नेम पुरा हयवा वाळा हता, अने यहुदीम ना वेरी तीमने अदीकार मे करवा नी आह राखता हता, पण आने छोड़ीन यहुदी आह़फा ना वेरीम ने नी मान्‌या; <verse eid="EST 9:1" /><verse number="2" style="v" sid="EST 9:2" />तीहया दाड़े यहुदी माणहु राजा सयर्‌स ना आखा देस मे आह़फा-आह़फाम ना ह़ेर मे एक्‌ठा हया, के जे ईमनु नुकसान करवा नी कोसीत करे, तीमने ठोके। काहाके तीमनी बीक देस-देस ना आखा माणहु ना मन मे भराय जेली हती। <verse eid="EST 9:2" /><verse number="3" style="v" sid="EST 9:3" />अने देस ना आखा अदीकार्‌या अने मुख्‌या अदीकार्‌या अने मुख्‌या अने राजा ना काम करन्‌या यहुदी माणहु नी मदत कर्‌या, काहाके तीमना मन मे मोर्‌दके नी बीक भराय जेली हती। <verse eid="EST 9:3" /><verse number="4" style="v" sid="EST 9:4" />मोर्‌दके ते राजान्‌तां घणो नामह़ाद्‌यो हतो, अने तीनु काम आखा देस मे फेल ज्‌यु; अने तीहया अदमी मोर्‌दके नी बड़ाय वदती जत री। <verse eid="EST 9:4" /><verse number="5" style="v" sid="EST 9:5" />अने यहुदी आह़फाम ना आखा वेरीम ने तलवार वेर मारीन खत्‌तम कर देदा, अने आह़फाम ना वेरीम नी ह़ाते तीमनी मरजी नी अनसारे वेहवार कर्‌या।<verse eid="EST 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EST 9:6" />सुसन नाम ना कीला मे यहुदी पांच ह़ो माणहु ने मारीन खत्‌तम कर्‌या। <verse eid="EST 9:6" /><verse number="7" style="v" sid="EST 9:7" />तीहया पर्‌सन्‌दाता, दल्‌पोन, अस्‌पाता, <verse eid="EST 9:7" /><verse number="8" style="v" sid="EST 9:8" />पोराता, अदल्‌या, अरीदाता, <verse eid="EST 9:8" /><verse number="9" style="v" sid="EST 9:9" />पर्‌मसता, अरीसे, अरीदे अने वेजाता, <verse eid="EST 9:9" /><verse number="10" style="v" sid="EST 9:10" />मतलब हम्‌मदाता ना सोरा यहुदीम ना वीरोदी हामान ना दहोव सोरा ने बी मार नाख्‌या; पण तीमना धन ने नी लुट्‌या।<verse eid="EST 9:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EST 9:11" />तीहयात दाड़े सुसन नाम ना कीला मे मारला नी गीनती राजा ने ह़मळाया। <verse eid="EST 9:11" /><verse number="12" style="v" sid="EST 9:12" />ता राजो एस्‌तर राणी ने केदो, “यहुदी माणहु सुसन नाम ना कीला मेत पांच ह़ो माणहु अने हामान ना दह सोरा ने बी मार नाखला से; अळी राज्‌य ना बीजा देस मे तीहया मालम ने ह़ु-ह़ु कर्‌या हहे! हाव आनी सी जादा तारी वीन्‌ती ह़ु से? तीने बी पुरी कर देही। तु ह़ु मांगे? तीहयु बी तने जड़ जहे।”<verse eid="EST 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EST 9:13" />एस्‌तर राणी केदी, “कदीम राजा ने गमे ता सुसन ह़ेर मे वाळा यहुदीम ने आज ने तेम वाहणे बी करवा नो हुकम आपे, अने हामान ना दहोव सोरा ने फासी पोर टांग देय।” <verse eid="EST 9:13" /><verse number="14" style="v" sid="EST 9:14" />राजो केदो, “आसमेत करे” आहयो हुकम सुसन ह़ेर मे आप्‌या, अने हामान ना दहोव सोरा ने टांग देदा। <verse eid="EST 9:14" /><verse number="15" style="v" sid="EST 9:15" />सुसन ह़ेर मे वाळा यहुदी अदार मयना ना चोवदवा दाड़े बी एक्‌ठा हय्‌न सुसन मे तीन ह़ो माणहु ने मार नाख्‌या, पण धन ने नी लुट्‌या।<verse eid="EST 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="EST 9:16" />राज्‌य ना बीजा देस ना यहुदी एक्‌ठा हय्‌न आह़फा-आह़फाम नो जीव बचाड़वा करीन उबा हया, अने आह़फाम ना वेरीम नी मे गेथा पीचोतर हजार माणहु ने मारीन आह़फाम ना वेरी सी अराम हात कर्‌या; पण धन ने नी लुट्‌या।<verse eid="EST 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="EST 9:17" />आहयु काम अदार मयना ना तेरवा दाड़े कर्‌या, अने चोवदवा दाड़े तीहया अराम करीन खाणु खादा अने खुसी नो दाड़ो ठेराया। <verse eid="EST 9:17" /><verse number="18" style="v" sid="EST 9:18" />पण सुसन ह़ेर ना यहुदी अदार मयना ना तेरवा दाड़े, अने तीहयात मयना ना चोवदवा दाड़े एक्‌ठा हया, अने तीहयात मयना ना पंदरवा दाड़े तीहया अराम करीन खाणु नो अने खुसी नो दाड़ो ठेराया। <verse eid="EST 9:18" /><verse number="19" style="v" sid="EST 9:19" />आहया कारण सी गाम मे रेवा वाळा यहुदी जे भीतड़ु वगर ना फळ्‌या मे रेता हता, तीहया अदार मयना ना चोवदवा दाड़ा ने खुसी अने खाणु अने छुट्‌टीन दाड़ो माने, अने तीहया दाड़े एक-बीजा ने खाणु नु ह़मान नी भेट आपता हता।<verse eid="EST 9:19" /></para>
  <para style="s">पुरीम तीवार नी सुरुवात</para>
  <para style="p">
    <verse number="20" style="v" sid="EST 9:20" />आहयी वात नी काहणी लीखीन, मोर्‌दके राजा सयर्‌स ना आखा देस मे, ह़ाते अने नाम्‌बे रेवा वाळा आखा यहुदीम ने तां चीठ्‌या ली मोकल्‌यो <verse eid="EST 9:20" /><verse number="21" style="v" sid="EST 9:21" />अने आहयो हुकम आप्‌यो, के अदार मयना ना चोवदवा दाड़े अने पंदरवा दाड़े साल डीट तीवार वाळजो। <verse eid="EST 9:21" /><verse number="22" style="v" sid="EST 9:22" />जे दाड़ा मे यहुदी आह़फाम ना वेरीम नी सी अराम हात कर्‌या, अने आहयो मयनो जीनी मे दुख आनन्‌द मे, अने कलपवु खुसी मे बदल ज्‌यु; मान्‌या करे अने तीहया दाड़ा ने खाणु ना अने आनन्‌द ना अने एक बीजान्‌तां खावा नु ह़मान ली मोकलवा अने गरीब ने दान आपवा ना दाड़ा माने।<verse eid="EST 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EST 9:23" />यहुदी माणहु जेम सुरु करला हता, अने जेम मोर्‌दके तीमनी जुगु लीखलो हतो, तेमेत करता रेवा पक्‌कु कर लेदा।<verse eid="EST 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="EST 9:24" />काहाके अगागी कुळी नो हम्‌मदाता नो सोरो हामान जे आखा यहुदीम नो वीरोदी हतो, तीहयो यहुदीम ने खत्‌तम करवा नी चाल चाल्‌यो, अने तीमने मीटाड़ नाखवा अने मारवा करीन “पुर” मतलब चीट्‌ठी नाखलो हतो। <verse eid="EST 9:24" /><verse number="25" style="v" sid="EST 9:25" />पण जत्‌यार राजो आहयु जाण लेदो, ता तीहयो हुकम आप्‌यो अने लीखाड़्‌यो के हामान यहुदीम ना वीरोद मे गलत चाल चाललो हतो तीहयु तीनीत ह़ाते हयु, ता तीने अने तीना सोरा ने फासी ना खम्‌बा पोर टांग देदा। <verse eid="EST 9:25" /><verse number="26" style="v" sid="EST 9:26" />आहया कारण सी तीहया दाड़ा नु नाम पुर बोल सी पुरीम राख देदा। आहयी चीट्‌ठी नी आखी वात ना कारण सी, अने जे कंय तीहया आहया बारा मे देख्‌या अने जे कंय तीमनी पोर वीतलु हतु, तीना कारण बी <verse eid="EST 9:26" /><verse number="27" style="v" sid="EST 9:27" />यहुदी आह़फा-आह़फाम नी जुगु अने आह़फाम नी अवल्‌यात जुगु, अने तीहया आखा जुगु बी जे तीमनी ह़ाते भेसकाय जेला हता आहयो पक्‌को वायदो कर्‌यो, के तीहयु लीखलु नी अनसारे साल डीट तीनी ठेरावली टेम मे तीहया आहया बेम दाड़ा ने मनावहे; <verse eid="EST 9:27" /><verse number="28" style="v" sid="EST 9:28" />अने पीड़ी-पीड़ी मे, कुळी-कुळी मे, देस-देस मे, अने ह़ेर-ह़ेर मे आहया दाड़ा ने फोम करहे अने मनावहे, अने पुरीम नाम ना दाड़ा यहुदी मे कदी नी मीटे अने तीने तीमनी जाती मे कदी नी भुले।<verse eid="EST 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="EST 9:29" />अळतेण अबीहेल नी सोरी एस्‌तर राणी, अने मोर्‌दके यहुदी पुरीम ना बारा मे आहयी बीजी चीट्‌ठी मोटा अदीकार भेळ लीख्‌या। <verse eid="EST 9:29" /><verse number="30" style="v" sid="EST 9:30" />आना नकल मोर्‌दके, सयर्‌स ना राज्‌य ना एक ह़ो सत्‌तावीस देस ना आखा यहुदीम ने तां सांती आपवा वाळी अने खरली वात भेळ आहयी चीट्‌ठी ली मोकल्‌यो, <verse eid="EST 9:30" /><verse number="31" style="v" sid="EST 9:31" />के पुरीम ना तीहया दाड़ा नी खास ठेरावली टेम मे मोर्‌दके यहुदी अने एस्‌तर राणी ना हुकम नी अनसारे, अने जे यहुदी आह़फा नी अने आह़फाम नी अवल्‌यात जुगु ठान लेदला हता, तीनी अनसारे बी उपाह पाळे अने दुखी हये। <verse eid="EST 9:31" /><verse number="32" style="v" sid="EST 9:32" />पुरीम ना बारा मे नो आहयो नेम एस्‌तर राणी ना हुकम सी बी पक्‌को कर देदा, अने आना बारा मे कीताप मे बी लीख्‌या।<verse eid="EST 9:32" /></para>
  <chapter eid="EST 9" />
  <chapter number="10" style="c" sid="EST 10" />
  <para style="s">राजा सयर्‌स अने मोर्‌दके नी बड़ाय</para>
  <para style="p">
    <verse number="1" style="v" sid="EST 10:1" />राजो सयर्‌स देस अने दर्‌या ना टापु पोर फाळो लेवा चालु कर्‌यो। <verse eid="EST 10:1" /><verse number="2" style="v" sid="EST 10:2" />तीना मोटा अने हीम्‌मत ना काम, अने मोर्‌दके नी तीहयी बड़ाय नो पुरो वारतो, जे राजो तीनो करलो हतो, ह़ु तीहयो मादे अने फारस देस ना राजाम नी खांदानी नी कीताप मे नी लीखलो हय? <verse eid="EST 10:2" /><verse number="3" style="v" sid="EST 10:3" />यहुदी मोर्‌दके, सयर्‌स राजा सी हेटोत हतो, अने यहुदीम नी नींगा मे मोटो हतो, अने तीना आखा भाय तीनी सी खुस हता, काहाके तीहयो तीना माणहु नी भलाय करवा मे लागलो रेतो हतो अने आह़फा ना आखा माणहु ह़ाते सांती नी वात कीया करतो हतो।<verse eid="EST 10:3" /></para>
  <chapter eid="EST 10" />
</usx>