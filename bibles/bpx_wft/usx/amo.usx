<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">आमोस</book>
  <para style="ide">AMO - Paliya New Testament</para>
  <para style="h">आमोस</para>
  <para style="toc3">आमोस</para>
  <para style="toc2">आमोस</para>
  <para style="toc1">आमोस नी कीताप</para>
  <para style="mt2">आमोस नी कीताप</para>
  <para style="mt1">आमोस नी कीताप</para>
  <para style="imt1">जानकारी</para>
  <para style="ip">आहयी कीताप मे आमोस नी अगी हयवा वाळी वात नी खबर से। आमोस एक गुवाळ्‌यो <char style="xt"><ref loc="AMO 1:1">1:1</ref></char> अने एक कीरसाण <char style="xt"><ref loc="AMO 7:14">7:14</ref></char> हतो। तत्‌यार भगवान तीने आह़फा नो अगी हयवा वाळी वात केवा वाळो बणवा करीन बोलायो। आमोस तकोवा ह़ेर वाळो हतो, जे यहुदा ना दखणाव वाळा राज्‌य मे हतु। पण तीनी जादातर खबर धुराव ना ईस्‌रायल राज्‌य ना लेदे हती, जत्‌यार उजीयाह यहुदा नो राजा हतो तत्‌यार आमोस अगी हयवा वाळी वात कर्‌यो। अने यारोबाम बीजा ईस्‌रायल नो राजा हतो। आहयु 750 ईस्‌वी नी आड़े-धेड़े नी वात से।</para>
  <para style="ip">आमोस पेले ना बे पाट मे कंय देसु ना वीरोद मे नीयाव नी अगी हयवा वाळी वात कर्‌यो पण तीनी जादातर खबर ईस्‌रायल राज्‌य ना लेदे हती। आहयु ईस्‌रायल ना लेदे बड़वा नी टेम हती। तीहयी बड़वा नी टेम मे तीहया भगवान ने भुल ज्‌या अने गरीब ह़ाते बुरो वेहवार कर्‌या <char style="xt"><ref loc="AMO 2:6">2:6</ref></char>। करीन भगवान नो नीयाव तीमने बंदी बणावीन लीजवा नो हतो <char style="xt"><ref loc="AMO 7:17">7:17</ref></char>। ते बी भगवान वायदो कर्‌यो के तीहयो ईस्‌रायल ना माणहु ने अळी बीजा आखा देसु पोर जीक हात करवा मे मदत करहे, जीनी पोर तीहया पेले राज करला हता <char style="xt"><ref loc="AMO 9:12">9:12</ref></char>।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. आमोस आह़फा ना बारा मे जानकारी देखाड़े। <char style="ior"><ref loc="AMO 1:1">1:1</ref></char></para>
  <para style="io1">2. तीहयो कंय देसु ना बारा मे फेसलो ह़मळावे। <char style="ior"><ref loc="AMO 1-2">1–2</ref> </char></para>
  <para style="io1">3. ईस्‌रायल नो नीयाव अने गुलामी ना बारा मे वात करलो से। <char style="ior"><ref loc="AMO 3:9-11">3:9-11</ref></char></para>
  <para style="io1">4. आखरी मे भगवान बचला भरहो करन्‌या ने ईस्‌रायल मे पासा लाव्‌वा नो वायदो करे। <char style="ior"><ref loc="AMO 9:12-15">9:12-15</ref> </char></para>
  <chapter number="1" style="c" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />तकोवा मे रेवा वाळो आमोस जे गाडरा-बोकड़ा ना गुवाळ्‌या मे गेथो हतो, तीना आहया बोल से जे तीहयो यहुदा ना राजा उजीयाह ना, अने योवास ना सोरा ईस्‌रायल ना राजा यारोबाम ना दाड़ा मे, भुकम्‌प सी बे साल पेले, ईस्‌रायल ना बारा मे दरसन देखीन केदो: <verse eid="AMO 1:1" /><verse number="2" style="v" sid="AMO 1:2" />“यहोवा सीय्‌योन बड़े गेथो गाजहे, अने यरुसलेम गेथो आह़फा ना सब्‌द ह़मळावहे; ता चारवा वाळान चारवा नो जागो दुखी हयहे, अने कार्‌मेल बड़ा नी चोट्ली ह़ुक जहे।”<verse eid="AMO 1:2" /></para>
  <para style="s">ईस्‌रायल ना ह़ाते वाळा राज्‌य नो नीयाव</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 1:3" />यहोवा आसम केय: “दमीस्‌क ना तीन ह़ु, पण च्‌यार गुना ना कारण में तीनो डंड नी छोड़ु; काहाके तीहया गीलाद ह़ेर ने महळवा वाळा अवज्‌यार सी रंदळला से। <verse eid="AMO 1:3" /><verse number="4" style="v" sid="AMO 1:4" />करीन में हजाएल ना राजा ना कीला मे आक्‌ठु धपाड़ही, अने तीनी सी बेन्‌हदद ना राजा ना कीला बी धप जहे। <verse eid="AMO 1:4" /><verse number="5" style="v" sid="AMO 1:5" />में दमीस्‌क ना डांडा ने तोड़ दीही, अने आवेन नाम नी घाटी मे रेवा वाळा ने अने बेतएदेन ना घोर मे रेवा वाळा अदीकारीम ने खत्‌तम करही; अने अराम ना माणहु धराय्‌न कीर मे जहे यहोवा नो आहयोत बोल से।”<verse eid="AMO 1:5" /></para>
  <para style="s">पलीस्‌तीया</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 1:6" />यहोवा आसम केय: “गाजा ना वळ-वळीन करला गुना ना कारण सी तीन ह़ु, पण च्‌यार गुना ना कारण सी में तीनो डंड नी छोड़ु; काहाके तीहया माणहु ने धरीन ली ज्‌या के तीमने एदोम राज्‌य ना हक मे कर देय। <verse eid="AMO 1:6" /><verse number="7" style="v" sid="AMO 1:7" />करीन मे गाजा ना कीला नु भीतड़ु मे आक्‌ठु धपाड़ही अने तीनी सी तीना कीला धप जहे। <verse eid="AMO 1:7" /><verse number="8" style="v" sid="AMO 1:8" />में असदोद ना रेवा वाळा ने अने अस्‌कलोन ना अदीकारीम ने बी खत्‌तम करही; में मारो हात एक्‌रोन ना वीरोद मे उचो करही, अने बचला पलीस्‌ती माणहु खत्‌तम हय जहे,” भगवान यहोवा नो आहयोत बोल से।<verse eid="AMO 1:8" /></para>
  <para style="s">सोर</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 1:9" />यहोवा आसम केय: “सोर ना तीन ह़ु पण च्‌यार गुना ना कारण सी में तीनो डंड नी छोड़ु; काहाके तीहया आखा माणहु ने धरीन एदोम ना हक मे कर देदा अने भाय ह़ाते करला वायदा ने फोम नी कर्‌या। <verse eid="AMO 1:9" /><verse number="10" style="v" sid="AMO 1:10" />करीन में सोर ह़ेर नु भीतड़ु पोर आक्‌ठु धपाड़ही, अने तीनी सी तीना कीला बी धप जहे।”<verse eid="AMO 1:10" /></para>
  <para style="s">एदोम</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 1:11" />यहोवा आसम केय: “एदोम ना तीन ह़ु, पण च्‌यार गुना ना कारण सी में तीनो डंड नी छोड़ु, काहाके तीहयु आह़फा ना भाय ने तलवार लीन दवड़ावलु अने कंय बी दया नी कर्‌यु, पण रीह मे तीमने लगातार फाड़तु र्‌यु, अने आह़फा नी रीह ने जलम नी लेदे बणाय र्‌यु। <verse eid="AMO 1:11" /><verse number="12" style="v" sid="AMO 1:12" />करीन में तेमान मे आक्‌ठु धपाड़ही, अने तीनी वेर बोस्‌रा ह़ेर ना कीला धप जहे।”<verse eid="AMO 1:12" /></para>
  <para style="s">अम्‌मोन</para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 1:13" />यहोवा आसम केय: “अम्‌मोन ना वळ-वळीन करला गुना ना कारण सी तीन ह़ु, पण च्‌यार गुना ना कारण सी में तीनो डंड नी छोड़ु काहाके तीहया आह़फाम नी काकड़ वदाड़वा नी करते गीलाद ना ईलाका ना भारेपोगे बयरा ना पेट चीर देदा। <verse eid="AMO 1:13" /><verse number="14" style="v" sid="AMO 1:14" />करीन में रब्‌बा ना भीतड़ा मे आक्‌ठु धपाड़ही, अने तीनी सी तीना कीला बी धप जहे। तीहयी लड़ाय ना दाड़ा मे कुर्‌राटा हयहे, तीहयो आंजी मतलब भुत्‌या नो दाड़ो रेहे; <verse eid="AMO 1:14" /><verse number="15" style="v" sid="AMO 1:15" />अने तीमनो राजो तीना अदीकार्‌या भेळ गुलामी मे जहे,” यहोवा नो आहयोत बोल से।<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" sid="AMO 2" />
  <para style="s">मोवाब</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 2:1" />यहोवा आसम केय: “मोवाब राज्‌य ना वळ-वळीन करला गुना ना कारण सी तीन ह़ु, पण च्‌यार गुना ना कारण सी, में तीनो डंड नी छोड़ु; काहाके तीहयु एदोम ना राजा ना हाड़का ने धपाड़ीन रोखड़ो बणाय देदु। <verse eid="AMO 2:1" /><verse number="2" style="v" sid="AMO 2:2" />करीन में मोवाब राज्‌य मे आक्‌ठु धपाड़ही, अने तीनी सी करीयोत ह़ेर ना कीला धप जहे; अने मोवाब राज्‌य मे हुल्‌लड़ अने कचाट, अने फेपार्‌या नी अवाज हयते-हयते मर जहे। <verse eid="AMO 2:2" /><verse number="3" style="v" sid="AMO 2:3" />में तीनी वचे मे गेथा नीयाव करन्‌या ने खत्‌तम करही, अने तीनी ह़ाते-ह़ाते तीना आखा अदीकार्‌या ने मारही,” यहोवा नो आहयोत बोल से।<verse eid="AMO 2:3" /></para>
  <para style="s">यहुदा</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 2:4" />यहोवा आसम केय: “यहुदा ना वळ-वळीन करवा गुना ना कारण सी तीन ह़ु, पण च्‌यार गुना ना कारण, में तीनो डंड नी छोड़ु; काहाके तीहया यहोवा ना नेम ने नी मान्‌या; अने मारी रीती ने नी मान्‌या; अने आह़फाम ना झुटा देवताम ना कारण सी जीमनी पसळ तीना आड़ा-बुड़ा चालता हता, तीहया बी भटक जेला से। <verse eid="AMO 2:4" /><verse number="5" style="v" sid="AMO 2:5" />करीन में यहुदा मे आक्‌ठु धपाड़ही, अने तीनी सी यरुसलेम ना कीला धप जहे।”<verse eid="AMO 2:5" /></para>
  <para style="s">ईस्‌रायल नो नीयाव</para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 2:6" />यहोवा आसम केय: “ईस्‌रायल ना वळ-वळीन करला गुना ना कारण सी तीन ह़ु, पण च्‌यार गुना ना कारण, में तीनो डंड नी छोड़ु; काहाके तीहया वण-गुनाळ्‌ळा ने पय्‌हा जुगु अने कमजोर ने एक जोड़ी खाहड़ा जुगु वेच देदला से। <verse eid="AMO 2:6" /><verse number="7" style="v" sid="AMO 2:7" />तीहया गरीबु ना मुंडा पोर ना कादा नी बी लालच करे, अने ह़ुदला माणहु ने वाट्‌ये गेथा भटकाड़ देय; अने बाह-बेटा बेम एकीत कुवारीन्‌तां जाय, जीनी सी मारु चोखलु नाम ने वीटळ्‌ळु ठेराया। <verse eid="AMO 2:7" /><verse number="8" style="v" sid="AMO 2:8" />तीहया आखी वेदीन्‌तां गीरवे राखला लुगड़ा पोर ह़ुवे, अने डंड ना पय्‌हा वेर वेचातु लेदलु ह़रु तीमना देवता ना घोर मे पी लेय।<verse eid="AMO 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 2:9" />“में तीमनी अगळ गेथा एमोरीम ने खत्‌तम करलो हतो, जीमनी लम्‌बाय देवदारु झाड़का ह़रकी, अने जीमनी ताखत वांज्‌या झाड़ ह़रकी हती; ते बी में उपर गेथा तीना फोळ, अने हेटा गेथा तीना मुळ्‌या खत्‌तम कर्‌यो। <verse eid="AMO 2:9" /><verse number="10" style="v" sid="AMO 2:10" />में तमने मीस्‌र देस मे गेथो नीकाळ लायो, अने उजाड़ी जागा मे चाळीह साल तक लीन फीरतो र्‌यो, के तमु एमोरीम ना देस ना हकदार्‌या बण जावो। <verse eid="AMO 2:10" /><verse number="11" style="v" sid="AMO 2:11" />में तमारा सोरा मे गेथो भगवान वगे गेथी वात केवा वाळा बणवा करीन अने तमारा थोड़ाक जुवान मे गेथा नाजीर<note caller="+" style="f"><char style="fr" closed="false">2:11 </char><char style="fq" closed="false">नाजीर </char><char style="ft" closed="false">मतलब, जे नान्‌ला गेथा भगवान ने ह़ोपला से </char></note> बणवा करीन ठेरायो। ए ईस्‌रायली, ह़ु आहयु आखु ह़ाचली नी हय?” यहोवा आहयु केदलो से। <verse eid="AMO 2:11" /><verse number="12" style="v" sid="AMO 2:12" />पण तमु नाजीर ने ह़रु पीयाड़्‌या, अने भगवान वगे गेथी वात केवा वाळा ने हुकम आप्‌या के भगवान वगे गेथी वात नी केय। <verse eid="AMO 2:12" /><verse number="13" style="v" sid="AMO 2:13" />“देखो, में तमने आसम डाबही, जेम पुळा सी भरली गाडी ने हेटी डाबे। <verse eid="AMO 2:13" /><verse number="14" style="v" sid="AMO 2:14" />आनीन करते उतवाळ्‌या नाह जवा वाळा ने नाहवा नो जागो नी जड़े, अने ताखत वाळा नी ताखत कंय बी काम नी देय; अने वारलो झुमायण्‌यो बी आह़फा नो जीव नी बचाड़ सके; <verse eid="AMO 2:14" /><verse number="15" style="v" sid="AMO 2:15" />वारलो धंदली देण्‌यो उबो नी री सके, अने उतवाळ्‌यो दवड़वा वाळो नी बचे; घोड़ा पोर बहण्‌यो बी आह़फा नो जीव नी बचाड़ सके; <verse eid="AMO 2:15" /><verse number="16" style="v" sid="AMO 2:16" />अने वारला झुमायण्‌या मे जे जादा टेकवा वाळो हय, तीहयो बी तीहया दाड़े नांगरो<note caller="+" style="f"><char style="fr" closed="false">2:16 </char><char style="fq" closed="false">नांगरो </char><char style="ft" closed="false">हत्‌यार वगर नो,</char></note> हय्‌न नाह जहे,” यहोवा आसम केय।<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />ए ईस्‌रायली, आहयो बोल ह़मळो जे यहोवा तमारा बारा मे मतलब तीहया आखा कुळ ना बारा मे केदलो से जीने में मीस्‌र देस मे गेथो लावलो से: <verse eid="AMO 3:1" /><verse number="2" style="v" sid="AMO 3:2" />“धरती ना आखा कुळ मे गेथो में तमारी पोर एतरोत मन लगाड़लो से, आहया कारण सी में तमारा आखा पापु नो डंड आपही।<verse eid="AMO 3:2" /></para>
  <para style="s">भगवान वगे गेथी वात केवा वाळा नु काम</para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 3:3" />“कदीम बे माणेह पुरा राजी नी हय; ता ह़ु तीहया भेळा चाल सकहे ह़ु? <verse eid="AMO 3:3" /><verse number="4" style="v" sid="AMO 3:4" />ह़ु नाहर सीकार हात कर्‌या वगर जंगल मे डोखारे ह़ु? जुवान नाहर कंय बी धर्‌या वगर आह़फा ना दोर मे रीन गुंगारे? <verse eid="AMO 3:4" /><verse number="5" style="v" sid="AMO 3:5" />ह़ु चड़ा फांद मेक्‌या वगर फसहे? ह़ु कंय बी फस्‌या वगर जाळ ने ह़ेमटे? <verse eid="AMO 3:5" /><verse number="6" style="v" sid="AMO 3:6" />ह़ु काना बी ह़ेर मे फेपार्‌यु वगाड़वा पोर माणहु थोरो-थोरो नी कापे? ह़ु यहोवान मोकल्‌या वगर काना बी ह़ेर मे कानी गरा आवहे? <verse eid="AMO 3:6" /><verse number="7" style="v" sid="AMO 3:7" />आहयीत भात्‌ये मालीक यहोवा आह़फा ना चाकर्‌या भगवान वगे गेथी वात केवा वाळा पोर आह़फा नी ह़तायली वात उजन्‌ती कर्‌या वगर कंय बी नी करे। <verse eid="AMO 3:7" /><verse number="8" style="v" sid="AMO 3:8" />नाहर गुंगारे; कोय नी बीहे? अने भगवान यहोवा केदो; कोय से जे भगवान भणी गेथी वात नी केय?”<verse eid="AMO 3:8" /></para>
  <para style="s">सामर्‌या राज्‌य नु खत्‌तम हयणु</para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 3:9" />असदोद ना घोर अने मीस्‌र देस ना राजा ना कीला मे परच्‌यार करीन केवो: “सामर्‌या ना बड़ा पोर एक्‌ठा हय्‌न देखो के तीनी मे केवी घणी कचाट अने तीनी वच मे केवा वेला पाड़वा ना काम हय र्‌या!”<verse eid="AMO 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 3:10" />यहोवा आसम केय, “जे माणहु आह़फाम ना कीला मे वेला पाड़ीन अने लुट-पाट नु धन एक्‌ठु करीन राखे, तीहया भलाय सी काम करवा जाणेत नी।” <verse eid="AMO 3:10" /><verse number="11" style="v" sid="AMO 3:11" />आहया कारण सी भगवान यहोवा आसम केय: “देस ने घेरव्‌वा वाळो दुस्‌मन रेहे, अने तीहयो तारी ताखत ने तोड़हे, अने तारा कीला लुटाय जहे।”<verse eid="AMO 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />यहोवा आसम केय: “जे भात्‌ये चारवा वाळो नाहर ना मोडा मे गेथो बे पोगु नीता कान्‌टा नो एक टुकड़ो छोड़ावे, तेमेत ईस्‌रायली माणहु, जे सामर्‌या मे गोदड़ु ना एक खुणे नीता रेसमी गादी पोर बह्‌या करे, तीमने बी छोड़ाय लेहे।” <verse eid="AMO 3:12" /><verse number="13" style="v" sid="AMO 3:13" />सेनाम नो भगवान, मालीक यहोवा आसम केय, “देखो, अने याकुब ना घोराणा ना वीरोद मे आहयी वात चेतावीन केवो: <verse eid="AMO 3:13" /><verse number="14" style="v" sid="AMO 3:14" />जे टेमे में ईस्‌रायल ने तीना गुना नो डंड आपही, तीहयीत टेमे में बेतेल नी वेदीम ने बी डंड आपही, अने वेदीम ना ह़ींगड़ा टुटीन भोयमे पड़ जहे। <verse eid="AMO 3:14" /><verse number="15" style="v" sid="AMO 3:15" />में टाड ना घोर ने अने उनाळा ना घोर, बेम ने ओदारही; अने हाती ना दात वेर बणला घोर बी खत्‌तम हयहे, अने मोटा-मोटा घोर खत्‌तम हय जहे,” यहोवा आहयु केदलो से।<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" sid="AMO 4" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 4:1" />“ए सामरी राज्‌य ना मालदार बयरा<note caller="+" style="f"><char style="fr" closed="false">4:1 </char><char style="fq" closed="false">मालदार बयरा </char><char style="ft" closed="false">मुल मे, ए बासान नी गायु</char></note>, आहयो बोल ह़मळो, तमु जे सामर्‌या बड़ा पोर से, जे गरीब ने वेला पाड़े, अने कमजोर ने रंदळ देवो, अने आह़फा-आह़फाम ना धणी ने केवो, ‘लाव, आप आमु पीया!’ <verse eid="AMO 4:1" /><verse number="2" style="v" sid="AMO 4:2" />भगवान यहोवा आह़फा ना चोखलापणा नी ह़ाम खाय्‌न केय, देखो, तमारी पोर एवा दाड़ा आव्‌वा वाळा से, के तमु काटा सी, अने तमारी अवल्‌यात ने माछला नी गळी सी हापक लेहे। <verse eid="AMO 4:2" /><verse number="3" style="v" sid="AMO 4:3" />तमु आखा वाड़ा ना नाके हय्‌न ह़ुदा नीकळ जहु अने तमने हरमोन ना बड़ा मे नाख देहे,” यहोवा नो आहयोत बोल से।<verse eid="AMO 4:3" /></para>
  <para style="s">ईस्‌रायली ह़ुदर नी सक्‌या</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 4:4" />“बेतेल मे आवीन गुनो करो, अने गीलगाल मे आवीन घणा गुना करो; तमारी भेट ह़वारे-ह़वारे, अने तमारो दहवो वाटो हर तीसरा दाड़े ली आया करो; <verse eid="AMO 4:4" /><verse number="5" style="v" sid="AMO 4:5" />वारलो से के केवा नी भेट खमीर भेसकीन चड़ावो, अने आह़फाम नी मरजी नी बली नी वात करीन तीमनो परच्‌यार करो; काहाके ए ईस्‌रायली, आसम करवा तमने गमे,” भगवान यहोवा नो आहयोत बोल से। <verse eid="AMO 4:5" /><verse number="6" style="v" sid="AMO 4:6" />“में ते तमारा आखा ह़ेरु मे काळ मोकल्‌यो अने तमारा आखा जागा मे खाणु नी कमी करलो से, ते बी तमु मारी भणी फीरीन नी आया,” यहोवा नो आहयोत बोल से। <verse eid="AMO 4:6" /><verse number="7" style="v" sid="AMO 4:7" />“जत्‌यार वाडणी ना तीन मयना री ज्‌या, ता में तमारी जुगु पाणी नी पाड़्‌यो; में एक ह़ेर मे पाणी पाड़ीन बीजा मे नी पाड़्‌यो; एक खेतर मे पाणी पड़्‌यो, अने बीजु खेतर जीनी मे नी पड़्‌यो, तीहयु ह़ुक ज्‌यु। <verse eid="AMO 4:7" /><verse number="8" style="v" sid="AMO 4:8" />करीन माणहु पाणी पीवा करीन एक जागे गेथा बीजा जागे भटकता-फीरता आया, पण आफर्‌या नी; ते बी तमु मारी भणीन नी फीर्‌या,” यहोवा नो आहयोत बोल से।<verse eid="AMO 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 4:9" />“में तमने झाळ अने गेरुय नाम ना कीड़ा सी मारलो से; अने जत्‌यार तमारा वाड़ग्‌या अने अंगुर ना वाड़्‌या, अने अंजीर अने जेतुन ना झाड़का घणा हय ज्‌या, ता टीड्‌या तीमने खाय ज्‌या; ते बी तमु मारी भणी फीरीन नी आया,” यहोवा नो आहयोत बोल से।<verse eid="AMO 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 4:10" />“में तमारी वच मे मीस्‌र देस नी गरान तेवी गरा फेलायो; में तमारा घोड़ा ने हपकाड़ीन तमारा जुवान ने तलवार सी मराय नाख्‌यो; अने तमारा पड़ावा नी गंद तमारीन्‌तां पुगाड़्‌यो; ते बी तमु मारी भणी फीरीन नी आया,” यहोवा नो आहयोत बोल से।<verse eid="AMO 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 4:11" />“में तमारी मे गेथा ढेरेत जणा ने उलट-फुलट कर देदो, जेम भगवान सदोम अने अमोरा ने उलट-फुलट कर देदलो हतो, अने तमु आक्‌ठु मे गेथु नीकाळलु लाकड़ु ह़रका ठेर्‌या; ते बी तमु मारी भणी फीरीन नी आया,” यहोवा आसमेत केय। <verse eid="AMO 4:11" /><verse number="12" style="v" sid="AMO 4:12" />“आहया कारण सी, ए ईस्‌रायल, में तारी ह़ाते आसमेत करही, अने आनीन करते के में तारी मे आहयु काम करवा पोर से, ए ईस्‌रायल, आह़फा ना भगवान नी अगळ आव्‌वा करीन तीयार हय जा!” <verse eid="AMO 4:12" /><verse number="13" style="v" sid="AMO 4:13" />देख, बड़ा ने बणाव्‌वा वाळो अने वाहळु ने बणाव्‌वा वाळो, अने माणहु ने तीमना मन ना वीच्‌यार देखाड़वा वाळो अने परगण फाटे ने अंदारलु करवा वाळो, अने जे धरती ना उचा जागा पोर चालवा वाळो से, तीनुत नाम सेनाम नो भगवान यहोवा से!<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" sid="AMO 5" />
  <para style="s">पछतावो करवा नो बोलावो</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />ए ईस्‌रायल ना घोराणा, आहया दुख ना गीत ना बोल ह़मळ जे में तारा बारा मे केम: <verse eid="AMO 5:1" /><verse number="2" style="v" sid="AMO 5:2" />“ईस्‌रायल देस एक कुवारी सोरी से जे पड़ जी, अने अळी उठ नी सके; तीने तीनीत जागा मे नाख देदा, अने तीने उठाड़वा वाळु कोय नी हय।” <verse eid="AMO 5:2" /><verse number="3" style="v" sid="AMO 5:3" />काहाके भगवान यहोवा आसम केय: “जे ह़ेर मे हजार नीकळता हता, तीनी मे ईस्‌रायल ना घोराणा ना ह़ोवेत बचला रेहे, अने जीनी मे गेथा ह़ोव नीकळता हता, तीनी मे दह बचीन रेहे।”<verse eid="AMO 5:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 5:4" />यहोवा, ईस्‌रायल ना घोराणा ने आसम केय: मने ह़ोदवाळ्‌या पड़ो, ता जीवत्‌ला रेहु।<verse eid="AMO 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="AMO 5:5" />बेतेल ना ह़ोदवाळ्‌या ना पड़ो, ना गीलगाल मे भरायो, अने ना बेर्‌सेबा मे जावो; काहाके गीलगाल पक्‌कु गुलामी मे जहे, अने बेतेल ह़ुनु पड़हे।<verse eid="AMO 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 5:6" />यहोवा ना ह़ोदवाळ्‌या पड़ो, ता जीवत्‌ला रेहु, नीता तीहयो युसुफ ना घोराणा पोर आक्‌ठुन तेम पड़वा बाज जहे, अने तीहयु तीमने धपाड़हे, अने बेतेल मे तीने कोय ओलव्‌वा वाळु नी रेय। <verse eid="AMO 5:6" /><verse number="7" style="v" sid="AMO 5:7" />ए नीयाव ने बगाड़वा वाळा अने सच्‌चाय ने कादा मे भेसकवा वाळा! <verse eid="AMO 5:7" /><verse number="8" style="v" sid="AMO 5:8" />जे कचपचीया<note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="fq" closed="false">कचपचीया </char><char style="ft" closed="false">झीन्‌ला तारा नो टोळो</char></note> अने मरगसीरा<note caller="+" style="f"><char style="fr" closed="false">5:8 </char><char style="fq" closed="false">मरगसीरा </char><char style="ft" closed="false">ह़रग मे तारा सी बणली हयणी</char></note> ने बणाव्‌वा वाळो से, जे घणु अंदारलु ने ह़वारे नु वीजाळु बणावे, जे दाड़ा ने अंदारु करीन रात बणाय देय, अने दर्‌या नु पाणी धरती नी उपर वयाड़ देय, तीनु नाम यहोवा से। <verse eid="AMO 5:8" /><verse number="9" style="v" sid="AMO 5:9" />तीहयो तत्‌यारुत ताखत वाळा ने खत्‌तम कर देय, अने कीला ने बी उजाड़ बणाय देय।<verse eid="AMO 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 5:10" />जे माणेह कोरट-कचवरी मे सच्‌चाय सी नीयाव करे, तीनी सी तमु ह़ीगी करो; अने जे ह़ाचली केय, तीनी पोर कुहरायो। <verse eid="AMO 5:10" /><verse number="11" style="v" sid="AMO 5:11" />तमु जे गरीब ने रोंदळो, अने भेट कीन तीमनी पांह अन नो फाळो ली लेवो, करीन जे घोर तमु घड़ला दगड़ा ना बणावला से, तीमनी मे री नी सको; अने जे मनगमता अंगुर ना वाड़्‌या तमु लगाड़ला से, तीमनो ह़रु नी पी सको। <verse eid="AMO 5:11" /><verse number="12" style="v" sid="AMO 5:12" />काहाके में जाणु के तमारा गुना घणा जुदा से, तमु खरलाम ने वेला पाड़ो अने पय्‌हा मांगो, अने कमजोर माणहु नो कोरट-कचवरी ना फाटा पोर नीयाव बगाड़ो। <verse eid="AMO 5:12" /><verse number="13" style="v" sid="AMO 5:13" />करीन जे अक्‌कल वाळो हय, तीहयो एवी टेमे होगो रेय, काहाके टेम गांडी से।<verse eid="AMO 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 5:14" />ए माणहु, बुराय ने नी, भलाय ने ह़ोदो, के तमु जीवत्‌ला रेवो; अने मालीक यहोवा ह़ाचली तमारी ह़ाते रेहे, जेम तमु केवो। <verse eid="AMO 5:14" /><verse number="15" style="v" sid="AMO 5:15" />बुराय सी दुस्‌मनी अने भलाय सी मोंग राखो, अने कोरट-कचवरी ना फाटा पोर नीयाव ने बणाय्‌न राखो; ह़ु मालम सेनाम नो भगवान यहोवा युसुफ ना बचला पोर दया करे।<verse eid="AMO 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="AMO 5:16" />आहया कारण सी सेनाम नो भगवान, मालीक यहोवा आसम केय, “आखा चोवराया मे रड़वु-कलपवु हयहे; अने आखी ह़ड़कु मे माणहु हाय, हाय, करहे! तीहया कीरसाणु ने कलपवा जुगु, अने जे माणहु कलपवा मे वारला से, तीमने रड़वा-कलपवा बोलावहे; <verse eid="AMO 5:16" /><verse number="17" style="v" sid="AMO 5:17" />अने आखी अंगुर नी वाड़ी मे रड़वु-कलपवु हयहे,” काहाके यहोवा आसम केय, “में तमारी वच मे हय्‌न जही।”<verse eid="AMO 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="AMO 5:18" />गरा आय पड़े तमारी पोर, तमु यहोवा ना दाड़ा नी हेर करो! यहोवा ना दाड़ा सी तमारो ह़ु फायदो हयहे? तीहयो ते वीजाळु नो नी, पण अंदारलु नो दाड़ो रेहे। <verse eid="AMO 5:18" /><verse number="19" style="v" sid="AMO 5:19" />जीसम कानो नाहर सी नाहे अने तीने रीछड़ु भेटे! नीता घोर मे आवीन भीतड़ु पोर हात टेकवे अने गड़हो तीने चाय देय! <verse eid="AMO 5:19" /><verse number="20" style="v" sid="AMO 5:20" />ह़ु आहयु ह़ाचली नी हय के यहोवा नो दाड़ो वीजाळु नो नी, पण अंदारलु नोत रेहे? होव, एवु घणु अंदारलु नो जीनी मे कंय बी चमक नी हय।<verse eid="AMO 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="AMO 5:21" />“में तमारा तीवार सी ह़ीगी करु, अने तीमने रीकामा जाणु, अने तमारी मोट्‌ली पंचु सी में खुस नी हय। <verse eid="AMO 5:21" /><verse number="22" style="v" sid="AMO 5:22" />भले तमु मारी जुगु होम बादा अने अनबादा चड़ावो, ते बी में खुस नी हयु, अने तमारा पाळला जानवरुम नी मेल-मीलाप नी बादा भणी नींगा नी नाखु। <verse eid="AMO 5:22" /><verse number="23" style="v" sid="AMO 5:23" />तमारा गीतु नी कचाट मारी गेथी सेटी करो; तमारा रणथा नी रींग मे नी ह़मळु। <verse eid="AMO 5:23" /><verse number="24" style="v" sid="AMO 5:24" />पण नीयाव ने नंदीन तेम, अने सच्‌चाय ने सदा वयवा वाळु कोतड़ुन तेम वयवा देवो।<verse eid="AMO 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />“ए ईस्‌रायल ना घोराणा, तमु ह़ुनहान जागा मे चाळीह साल तक जानवरु नी बादा अने अनबादा ह़ु मनेत चड़ावता र्‌या? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />तमु ते तमारा राजा नु तम्‌बु, अने आह़फाम ना मुरत्‌यान, अने आह़फाम ना देवता ना तारा ने लीन फीरता र्‌या। <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />आहया कारण सी में तमु ने दमीस्‌क नी ह़ेली पार गुलामी मे कर दीही, सेनाम नो भगवान यहोवा नो आहयोत बोल से।<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" sid="AMO 6" />
  <para style="s">ईस्‌रायल नु खत्‌तम हयणु</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 6:1" />“गरा तीमनी पोर जे सीय्‌योन ना चोखला जागा मे सुख सी रेय, अने तीमनी पोर गरा जे सामर्‌या ना मोट्‌ला बड़ा पोर बेफीकर्‌या रेय, तीहया जे वारला राज्‌य मे नामह़ाद्‌या से, जीमनी पांह ईस्‌रायल नु घोराणु आवे। <verse eid="AMO 6:1" /><verse number="2" style="v" sid="AMO 6:2" />कलने ह़ेर ने जाय्‌न देखो, अने तां गेथा हमात नाम ना मोट्‌ला ह़ेर मे जावो; अळतेण पलीस्‌तीम ना गत ह़ेर मे जावो। ह़ु आहयु तमारा बे राज्‌य सी वारु से? ह़ु तीमनी काकड़ तमारी काकड़ गेथी मोटी से? <verse eid="AMO 6:2" /><verse number="3" style="v" sid="AMO 6:3" />तमु बुरा दाड़ा ने सेटो कर देवो, अने बुराय नी गादी ने ह़ाते ली आवो।<verse eid="AMO 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 6:4" />“तमु हाती दात ना पलंगु पोर ह़ुवो, अने आह़फा-आह़फाम ना गोदड़ा पोर पोगु नाम्‌बा करीन ह़ुवो, अने गाडरा-बोकड़ा मे गेथा गाडरा अने ढुरु मे गेथा वाछड़ा ने खावो। <verse eid="AMO 6:4" /><verse number="5" style="v" sid="AMO 6:5" />तमु फेपार्‌या नी ह़ाते गीत गावो, अने दावुद ने तेम भाती-भाती नी वाजा नी अवाज अक्‌कल सी नीकाळो? <verse eid="AMO 6:5" /><verse number="6" style="v" sid="AMO 6:6" />अने कटवरा मे गेथो अंगुर नो माणलो रोह पीवो, अने वारु-वारु तेल लगड़ो, पण युसुफ पोर आव्‌वा वाळी गरा ना बारा मे ह़मळीन बी दुखी नी हयो। <verse eid="AMO 6:6" /><verse number="7" style="v" sid="AMO 6:7" />आहया कारण सी तीमने पेले आह़फाम ना देस मे गेथा नीकाळ देहे, अने जे पोग नाम्‌बा करीन ह़ुवता हता, तीमनी मोटाय जत रेहे।”<verse eid="AMO 6:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="AMO 6:8" />भगवान यहोवा आह़फा नीत ह़ाम खाय्‌न केदलो से: “जीनी पोर याकुब घमंड करे, तीनी सी में ह़ीगी, अने तीमना राजाम ना घोरु सी दुस्‌मनी राखु; अने में आहया ह़ेर ने तीहया आखा भेळ जे तीनी मे से, दुस्‌मन ना हक मे कर दीही।”<verse eid="AMO 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />कदीम काना घोर मे दह अदमी जीवत्‌ला बचला रेय, ते बी तीहया मर जहे। <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />जत्‌यार कोयनो काको, जे तीने धपाड़वा वाळो हय, तीना धोड़ ने घोर मे गेथो नीकाळवा करीन उचलहे, अने जे घोर ना खुणा मे ह़तायलो तीने पुछे, “ह़ु तारी पांह कोय अळी से?” तत्‌यार तीहयो केहे, “कोय नी हय,” तत्‌यार तीहयो केहे, “होगो रे। आपणु ने यहोवा नु नाम नी लेवा जोवे।”<verse eid="AMO 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 6:11" />काहाके यहोवा ना हुकम सी मोट्‌लु घोर ओदरी जहे, अने नान्‌ला घोर मे चीह पड़ जहे। <verse eid="AMO 6:11" /><verse number="12" style="v" sid="AMO 6:12" />ह़ु घोड़ा चाफर्‌या पोर दवड़े? ह़ु कानो आसवा जागा मे बोळद्‌या वेर जोपे जां तमु नीयाव ने जेहेर मे, अने सच्‌चाय ना फोळ ने कड़वला फोळ मे बदली देदला से?<verse eid="AMO 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 6:13" />तमु आसवी चीज ना कारण खुसी मनावो जे फालतु से; अने केवो, “ह़ु आपणु आपणीत ताखत सी करनीम ह़ेर ने नी जीक्‌या?”<verse eid="AMO 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 6:14" />आहया कारण सेनाम ना भगवान यहोवा नो आहयो बोल से, “ए ईस्‌रायल ना घोराणा देख, में तमारा वीरोद मे एक आसवु देस उबु करही, जे हमात नी घाटी गेथा अराबा नी नंदी लग तमने वेला मे नाखहे।”<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" sid="AMO 7" />
  <para style="s">खत्‌तम हयवा ना तीन दरसन</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />भगवान यहोवा मने आहयु देखाड़्‌यो: अने ह़ु देखु के तीहयो पासलो चारो उगवा ना सुरु मे टीड्‌या पयदा कर्‌यो; अने तीहयो राजा नी वाडणी नो बाद नो पासलो चारो हतो। <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />जत्‌यार तीहया चारो खाय लेदा, तत्‌यार में केदो, “ए भगवान यहोवा, माफ कर! नीता याकुब कीसम टेकलो री सकहे? तीहयो केतरो कमजोर से।”<verse eid="AMO 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="AMO 7:3" />आना बारा मे यहोवा पसतायो, अने केदो, “आसवी वात हाव नी हये।”<verse eid="AMO 7:3" /></para>
  <para style="s">आक्‌ठु</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />भगवान यहोवा मने आहयु देखाड़्‌यो: अने ह़ु देखु के भगवान यहोवा आक्‌ठु नी लारे मुकदमो लड़वा करीन आड़्‌यो, अने तीहयु आक्‌ठु सी मोट्‌ली दर्‌या ह़ुक जी, अने देस बी रोखड़ो हयवा बाज ज्‌यु। <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />तत्‌यार में केदो, “ए भगवान यहोवा, उबो री जा। नीता याकुब कीसम टेकलो री सकहे? तीहयो केवो कमजोर से।”<verse eid="AMO 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="AMO 7:6" />आना ना बारा मे बी यहोवा पसतायो; अने भगवान यहोवा केदो, “आसवी वात अळी नी हये।”<verse eid="AMO 7:6" /></para>
  <para style="s">सावळ</para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />तीहयो मने आहयु बी देखाड़्‌यो: में देख्‌यो के मालीक सावळ लगाड़ीन बणावलु कानु भीतड़ु पोर उबो हय र्‌यो, अने तीना हात मे सावळ से। <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />यहोवा मने केदो, “ए आमोस, तने ह़ु देखाव पड़े?” में केदो, “एक सावळ,” ता मालीक केदो, “में मारा माणहु ईस्‌रायल ना वच मे सावळ लगाड़ही। हाव में तीमने डंड आप्‌या वगर नी छोड़ु। <verse eid="AMO 7:8" /><verse number="9" style="v" sid="AMO 7:9" />ईसाक ना उचला जागा उजाड़ हय जहे, अने ईस्‌रायल ना चोखला जागा ह़ुनह़ान हय जहे, अळी में यारोबाम ना घोराणा पोर तलवार लीन हमलो करही।”<verse eid="AMO 7:9" /></para>
  <para style="s">आमोस अने अमस्‌याह</para>
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />तत्‌यार बेतेल नो पुंजारो अमस्‌याह ईस्‌रायल ना राजा यारोबाम ने तां खबर मोकल्‌यो, “आमोस ईस्‌रायल ना घोराणा ना वच मे तमारी सी लड़ाय करवा नी लेदे योजना बणाय र्‌यो। तीना आखा बोलु ने देस नी वेठ सकतु। <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />काहाके आमोस आसम केदो, ‘यारोबाम ने तलवार सी मार नाखहे, अने ईस्‌रायल ना माणहु ने बंदी बणावीन तीमना देस गेथा बारा ली जहे।’”<verse eid="AMO 7:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />तत्‌यार अमस्‌याह आमोस ने केदो, “ए दरसन देखण्‌या, आञे गेथो नीकळीन यहुदा देस मे नाह जा, अने तांत रेजे अने तांत रोट्‌ला खाजे, अने तांत भगवान वगे गेथी वात कीया कर; <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />पण बेतेल मे अळी कारु बी भगवान वगे गेथी वात नी करजे, काहाके आहयो राजा नो चोखलो जागो अने ईस्‌रायल नो मंदीर से।”<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />आमोस जपाप आपतो जीन अमस्‌याह ने केदो, “में नी ते भगवान वगे गेथी वात केण्‌यो हतो, अने नी भगवान वगे गेथी वात केण्‌या नो सोरो हतो; में ते ढुरु चारवा वाळो गुवाळ्‌यो हतो, अने में गुलर ना फोळु भेळा करीन वेचतो हतो। <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />अने यहोवा मने गाडरा-बोकड़ाम नी पछळ-पछळ फीरवा सी बोलावीन केदो, ‘जा मारा ईस्‌रायल ना माणहु ने भगवान वगे गेथी वात के।’ <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />आनीन करते हाव तु यहोवा ना बोल ह़मळ, तु केय, ईस्‌रायल ना वीरोद मे भगवान वगे गेथी वात ना करे; अने ईस्‌रायल ना घोराणा ना वीरोद मे वळ-वळीन बोल ना ह़मळावे। <verse eid="AMO 7:16" /><verse number="17" style="v" sid="AMO 7:17" />आहया कारण सी यहोवा आसम केय: ‘तारी बयर ह़ेर मे रंडी बण जहे, अने तारा सोरा-सोरी ने तलवार वेर मार नाखहे तारी जागा दोरी वेर मापीन वाट लेहे; अने तु वीटळ्‌ळा देस मे मरही, अने ईस्‌रायल आह़फा नी जागा मे गेथु पक्‌कु गुलामी मे जहे।’”<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" sid="AMO 8" />
  <para style="s">फोळु सी भरली टोपलीन दरसन</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />भगवान यहोवा मने आसम देखाड़्‌यो: के उनाळा ना दाड़ा ना फोळु सी भरली एक टोपली से। <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />यहोवा केदो, “ए आमोस, तने ह़ु देखाव पड़े?” में केदो, “उनाळा ना दाड़ा ना फोळु सी भरली एक टोपली।” तत्‌यार यहोवा मने केदो, “मारा ईस्‌रायल ना माणहु नु खत्‌तम हयणु आय ज्‌यु; में तीने अळी नी छोड़ु।” <verse eid="AMO 8:2" /><verse number="3" style="v" sid="AMO 8:3" />भगवान यहोवा ना आहया बोल से, “तीहया दाड़े मंदीर ना गीतु दुख मे बदली जहे, धोड़ु नो मोट्‌लो ढेर लागहे; अने तीमने आखा जागा मे होगात नाख देहे।”<verse eid="AMO 8:3" /></para>
  <para style="s">ईस्‌रायल नु खत्‌तम हयणु</para>
  <para style="p">
    <verse number="4" style="v" sid="AMO 8:4" />आहयु ह़मळो, तमु जे गरीब माणहु ने लुटवा अने देस ना भोळा माणहु ने खत्‌तम करवा हींड र्‌या, <verse eid="AMO 8:4" /><verse number="5" style="v" sid="AMO 8:5" />तमु केवो, “नवलो चांद कत्‌यार जहे के आमु अन वेच सकया? अराम नो दाड़ो कत्‌यार जहे, के आमु अन ना मोहट्‌या खोलीन बाट<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="fq" closed="false">बाट </char><char style="ft" closed="false">एपा</char></note> ने नानो अने ताकड़ी<note caller="+" style="f"><char style="fr" closed="false">8:5 </char><char style="fq" closed="false">ताकड़ी </char><char style="ft" closed="false">सेकेल</char></note> ने भारी कर दीया, अने धोका ना माप सी ठगीया, <verse eid="AMO 8:5" /><verse number="6" style="v" sid="AMO 8:6" />के आमु गरीबु ने पय्‌हा आपीन, अने कमजोर ने एक जोड़ी मोजड़्‌या नी कीमत मे वेचाता ली लीया, अने तमु बगड़लु अन वेेचे?”<verse eid="AMO 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="AMO 8:7" />यहोवा, जीनी पोर याकुब ने घमंड करवा वारु से, तीहयो आह़फा नी ह़ाम खाय्‌न केय, “में तमारा काम ने कदी नी भुलु। <verse eid="AMO 8:7" /><verse number="8" style="v" sid="AMO 8:8" />ह़ु आहया कारण धरती नी कापे? ह़ु तीनी पोर ना रेवा वाळा रावण्‌या नी करे? आहयु देस आखुन आखु मीस्‌र नी नील नंदीन तेम हयहे, जे वदु हये, अने लेहर आवे, अने कम हय जाय।” <verse eid="AMO 8:8" /><verse number="9" style="v" sid="AMO 8:9" />भगवान यहोवा ना आहया बोल से, “तीहयी टेमे में दाहड़ु ने बोपरी वळे डुबाड़ दीही, अने आहया देस ने दीहुत अंदारु कर दीही। <verse eid="AMO 8:9" /><verse number="10" style="v" sid="AMO 8:10" />में तमारा तीवारु नी खुसी ने छेटी करीन वेला करावही, अने तमारा आखा गीतु ने छेटा करीन दुख ना गीतु गवाड़ही; में तमने आखा ने दुख ना लुगड़ा पेरावही, अने तमारा आखा ना मुंडा ने बोड़ावही, अने एवो दुख करावही जेम एक-खोळ्‌या नी लेदे हये, अने तीनु खत्‌तम हयणु काठला दुख ना दाड़ान तेम हयहे।”<verse eid="AMO 8:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 8:11" />भगवान यहोवा ना आहया बोल से, “देखो, एवा दाड़ा आवे, जत्‌यार में आहया देस मे काळ पाड़ही, तीहया काळ मे नी ते अन नी भुक अने नी पाणी नी तहरे लागे, पण यहोवा ना बोलु ने ह़मळवा नीत भुक अने तहरे रेहे। <verse eid="AMO 8:11" /><verse number="12" style="v" sid="AMO 8:12" />माणहु यहोवा ना बोलु ने ह़ोदवाळ्‌या एक दर्‌या गेथा बीजी दर्‌या लग अने धुराव गेथा उगवणा तक मार्‌या-मार्‌या फीरहे, पण तीने नी हात कर सके।<verse eid="AMO 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 8:13" />“तीहयी टेमे घटाळा सोर्‌या अने जुवान अदमी बेम तहरे नी करते झमळाय पड़हे। <verse eid="AMO 8:13" /><verse number="14" style="v" sid="AMO 8:14" />जे माणहु सामर्‌या ना पापमुल देवता नी ह़ाम खाय, अने जे केय, दान ना देवता नी ह़ाम खाय, अने बेर्‌सेबा ना देवता नी ह़ाम खाय, तीहया आखा पड़ जहे, अने पासा नी उठे।”<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" sid="AMO 9" />
  <para style="s">भगवान नो नीयाव</para>
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />में मालीक ने वेदी नी उपर उबो हयलो देख्‌यो, अने तीहयो केदो: “खम्‌बा ना काना पोर दे जीनी सी पयड़्या हीले, अने तीमने आखा माणहु ना मुंडा पोर पाड़ीन टुकड़ा-टुकड़ा कर, अने जे खत्‌तम हयवा सी बचे, तीमने में तलवार सी मार दीही; तीमनी मे सी एक बी नी नाहे, अने जे आह़फा ने बचाड़े, तीहयो नी बचे। <verse eid="AMO 9:1" /><verse number="2" style="v" sid="AMO 9:2" />काहाके चाहे तीहया खोदीन पताळ मे उतरी जाय, ता तां गेथो में हात बड़ावीन तीमने लावही, चाहे तीहया ह़रग पोर चड़ जाय, ता तां गेथो में तीमने उतार लावही। <verse eid="AMO 9:2" /><verse number="3" style="v" sid="AMO 9:3" />चाहे तीहया कार्‌मेल बड़ा नी चोट्‌ली मे ह़ताय जाय, पण तां बी मे तीमने ह़ोदी-ह़ोदीन धर लेही, अने चाहे तीहया दर्‌या ना बुंदे मारी नजर सी आडोळ हय, तां बी में गड़हा ने तीमने चाव्‌वा नो हुकम आपही। <verse eid="AMO 9:3" /><verse number="4" style="v" sid="AMO 9:4" />चाहे दुस्‌मन तीमने गेरीन गुलामी मे ली जाय, तां बी मे हुकम आपीन तलवार सी तीमने मरावही; अने में तीमनी पोर भलाय करवा नी लेदे नी, पण बुरायेत करवा नी लेदे नजर नाखही।” <verse eid="AMO 9:4" /><verse number="5" style="v" sid="AMO 9:5" />सेनाम ना भगवान यहोवा ना छीमवा सी धरती पीगळे, अने तीनी पोर आखा रेवा वाळा दुखी हये; अने तीहया आखान आखा मीस्‌र नी नंदीन ह़रका हय जाय, जे बड़े अने लेहर आवे, अने कम हय जाय। <verse eid="AMO 9:5" /><verse number="6" style="v" sid="AMO 9:6" />जे ह़रग मे आह़फा नु घोर बणावे, अने आह़फा ना आखा ह़रग नी नीव धरती पोर नाखे, अने आह़फा ना हुकम सी दर्‌या नु पाणी धरती पोर वयाड़ देय, तीनुत नाम यहोवा से। <verse eid="AMO 9:6" /><verse number="7" style="v" sid="AMO 9:7" />“ए ईस्‌रायल ना माणहु,” यहोवा ना आहया बोल से, “ह़ु तमु मारी लेदे कुसीयो ह़रका नी हय? ह़ु में ईस्‌रायल ने मीस्‌र देस गेथो अने पलीस्‌तीम ने कप्‌तोर सी नी नीकाळ्‌यो? अने अराम मे रेण्‌या ने कीर गेथो नी लायो? <verse eid="AMO 9:7" /><verse number="8" style="v" sid="AMO 9:8" />देखो, मालीक यहोवा नी नजर आहया पाप वाळा राज्‌य पोर लागली से, अने में आने धरती पोर गेथो खत्‌तम करही; ते बी में पुरी रीती सी याकुब ना घोराणा ने खत्‌तम नी करु,” यहोवा ना आहयात बोल से।<verse eid="AMO 9:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="AMO 9:9" />“मारा हुकम सी ईस्‌रायल नु घोराणु आखा देसु मे आसम जत रेहे जीसम अन चाळनी मे जाय, पण तीनो एक बी वारलो दाणो भोय्‌मे नी पड़े। <verse eid="AMO 9:9" /><verse number="10" style="v" sid="AMO 9:10" />मारा माणहु मे वाळा आखा पापी जे केय, ‘तीहयी गरा अमारी पोर नी पड़े, अने नी आमने घेरवे,’ तीहया आखा तलवार सी मरहे।<verse eid="AMO 9:10" /></para>
  <para style="s">ईस्‌रायल ने पासु बणावणु</para>
  <para style="p">
    <verse number="11" style="v" sid="AMO 9:11" />“तीहयी टेमे में दावुद नी ओदरली छापरी ने उबी करही, अने तीना वाड़ा ना फाटाम ने ह़ुदारही, अने तीना ओदरला घोरु ने पासु बणावही, अने जीसम तीहयु पेल्‌ना वारा मे हतु, तीने तेमेत बणाय देही; <verse eid="AMO 9:11" /><verse number="12" style="v" sid="AMO 9:12" />जीनी सी तीहया बचला एदोम मे रेवा वाळा ने नी पण आखा राज्‌य ने जे मारा केवाये, आह़फाम ना हक मे लेय,” अने यहोवा जे आहयु काम पुरु करे, तीना आहया बोल से।<verse eid="AMO 9:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="AMO 9:13" />यहोवा ना आहया बी बोल से, “देखो, आसवा दाड़ा आवे, होळ जोपवा वाळो वाडवा वाळा ने अने अंगुर ने रंदळवा वाळो बीज वेरवा वाळा ने हात कर लेहे; अने बड़ा मे गेथो अंगुर नो रोह टपकवा बाज जहे, अने आखा बड़्‌या तीनी मे डुब जहे। <verse eid="AMO 9:13" /><verse number="14" style="v" sid="AMO 9:14" />में मारा माणहु ईस्‌रायल ना गुलामी मे वाळा ने पासो ली आवही, अने तीहया उजड़ला ह़ेरु ने पासा ह़ुदारीन तीनी मे रेहे; तीहया अंगुर नी वाड़ी लगाड़ीन अंगुर नो रोह पीहे, अने बगीचो लगाड़ीन तीनो फोळ खाहे। <verse eid="AMO 9:14" /><verse number="15" style="v" sid="AMO 9:15" />में तीमने, तीमनीत जागा मे वेरही, अने तीहया आह़फाम नी जागा मे गेथा जे में तीमने आपलो से अळी कदी नी उखड़े,” तमारा भगवान नो आहयो बोल से।<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>