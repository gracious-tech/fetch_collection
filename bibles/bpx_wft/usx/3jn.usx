<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="3JN" style="id">- Paliya</book>
  <para style="h">3 युहन्‌ना</para>
  <para style="toc3">3 युहन्‌ना</para>
  <para style="toc2">3 युहन्‌ना</para>
  <para style="toc1">युहन्‌ना नी तीसरी चीट्‌ठी</para>
  <para style="mt2">युहन्‌ना की तीसरी पत्री</para>
  <para style="mt1">युहन्‌ना नी तीसरी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">3 युहन्‌ना नी चीट्‌ठी नेवताळो युहन्‌नो ईसुन पयदा हयवान 50-100 साल नी वच मे लीख्‌यो, युहन्‌नो आह़फा ने लीखण्‌यो नी केवाड़तो पण डायलो <char style="xt"><ref loc="3JN 1:1">1:1</ref></char> अने केय। युहन्‌ना नी अनसारे खुस-खबर नी वात 2 युहन्‌ना नी वात ने तेवीत से। <char style="xt"><ref loc="2JN 1:1">2 युहन्‌ना 1:1</ref></char> आहयु उजन्‌तु से के जीसम तीहयो एक-बीजा ने मोंग करवा नी लेदे ईसु ना हुकम आपे, अने जीसम तीहयो तीना हुकम ने मानीन ईसु सी मोंग करे। आहयु माने के युहन्‌ना नी लारे खुस-खबर नी कीताप युहन्‌ना लीखली से, अने ईफीसुस मे रीन तीन चीट्‌ठी लीखलो से, 1 युहन्‌ना 2 युहन्‌ना 3 युहन्‌ना।</para>
  <para style="ip">युहन्‌नो आहयी चीट्‌ठी ने गयुस नाम ना भरहो करन्‌या माणहे ने लीखलो से, तीहयो गयुस ने एक दोस्‌तीदार ना रुप मे देखाड़तो हतो। अने तीने तीहयो तीना ह़ेर मे जवा बाज रेला भरहो करन्‌या भायु बेन्‌यान तां पोरणा हयवा नो हुकम आपे।</para>
  <para style="iot">रुपरेख</para>
  <para style="io1">1. युहन्‌नो तीनी चीट्‌ठी लीख्‌यो। <char style="ior"><ref loc="3JN 1:1">1:1</ref></char></para>
  <para style="io1">2. तीहयो गयुस ने अळी खुस करे, अने भायु ने पोरणा से देखाड़वा नो हुकम आपे। <char style="ior"><ref loc="3JN 1:2-8">1:2-8</ref></char></para>
  <para style="io1">3. तीहया बे बीजा माणहु दीयुत्‌रेफेस अने दीमेत्‌रीयुस नी वात करे। <char style="ior"><ref loc="3JN 1:9-12">1:9-12</ref></char></para>
  <para style="io1">4. आखरी मे तीहयो तीनी चीट्‌ठी नो ह़ारो नीकाळ्‌यो। <char style="ior"><ref loc="3JN 1:13-14">1:13-14</ref></char></para>
  <chapter number="1" style="c" sid="3JN 1" />
  <para style="s">वारला से के केम</para>
  <para style="p">
    <verse number="1" style="v" sid="3JN 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 19:29">नेवताळा ना काम 19:29</ref>; <ref loc="ROM 16:23">रोमीयो 16:23</ref>; <ref loc="1CO 1:14">1 कुरन्‌थी 1:14</ref></char>
    </note>मे डायलान तां गेथी मोंगाळ्‌ळा गयुस ना नामे, जीनी सी मे खरलो मोंग करु।<verse eid="3JN 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="3JN 1:2" />ए मोंगाळ्‌ळा, मारी आहयी वीन्‌ती से; जेम तु आत्‌मा मे वद र्‌यो, तेमेत बीजा कामु मे बी वदता जावो अने वारला रेवो। <verse eid="3JN 1:2" /><verse number="3" style="v" sid="3JN 1:3" />काहाके जत्‌यार भरहो करन्‌या भाय-बेन्‌या आवीन तारी तीहयी सच्‌चाय नी गवाय देदा जीनी पोर तु ह़ाचलीन चाले ता मे घण-जबर खुस हयो। <verse eid="3JN 1:3" /><verse number="4" style="v" sid="3JN 1:4" />मने आनी गेथी मोटी अळी कानी बी खुसी नी हय, के मे ह़मळु, के मारा सोरा-सोरी सच्‌चाय पोर चालत्‌ला।<verse eid="3JN 1:4" /></para>
  <para style="s">गयुस नी बड़ाय</para>
  <para style="p">
    <verse number="5" style="v" sid="3JN 1:5" />ए मोंगाळ्‌ळा, जे कंय तु तीहया भायु ह़ाते करत्‌लो, जे अंजाण्‌या बी से, तीने ईमानदारी सी कर र्‌यो। <verse eid="3JN 1:5" /><verse number="6" style="v" sid="3JN 1:6" />तीहया मंडळी नी अगळ तारा मोंग नी गवाय देदला से: कदीम तु तीमने तीनीन तेम वळावही जेम भगवान ना माणहु जुगु वारु से। ता वारु रेहे। <verse eid="3JN 1:6" /><verse number="7" style="v" sid="3JN 1:7" />काहाके तीहया ते मसी ना नाम नी लेदे नीकळला से, अने आड़जात्‌या माणहु पांह कंय नी लेय। <verse eid="3JN 1:7" /><verse number="8" style="v" sid="3JN 1:8" />एतरे आमु भरहो करन्‌या एवा माणहु नी मदत करवा जोवे, जीनी सी आमु बी सच्‌चाय नी सेवा मे साजल्‌या बणया।<verse eid="3JN 1:8" /></para>
  <para style="s">दीयुत्‌रेफेस अने दीमेत्‌रीयुस</para>
  <para style="p">
    <verse number="9" style="v" sid="3JN 1:9" />मे मंडळी ने चीट्‌ठी लीखलो हतो, पण दीयुत्‌रेफेस जे तीमनी मे मोटो बणवा हींडतो हतो, अमारी वात नी मान्‌तो हतो। <verse eid="3JN 1:9" /><verse number="10" style="v" sid="3JN 1:10" />एतरे मे जत्‌यार आवही ता तीना कामु नी जे तीहयो कर र्‌यो, फोम करावही, के तीहयो अमारा बारा मे गलत-गलत वात केय; अने आनी पोर बी राजी नी रीन आह़फोत भायु ने नी अवरे, अने जे तीमने जे अवरवा हींडे तीमने रोके अने मंडळी सी नीकाळ देय।<verse eid="3JN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="3JN 1:11" />मोंगाळ्‌ळा माणहु, बुराय ने तेवी नी पण भलाय नी चाल चालो काहाके भलाय भगवान नी से; अने जे बुराय करवा वाळो से तीहयो भगवान ने नी देख्‌यो।<verse eid="3JN 1:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="3JN 1:12" />दीमेत्‌रीयुस ना बारा मे आखा अने सच्‌चाय बी आह़फीत गवाय देदी, अने आमु बी गवाय दीया अने तमु जाणे के अमारी गवाय खरली से।<verse eid="3JN 1:12" /></para>
  <para style="s">आखरी काव वारला से के केम</para>
  <para style="p">
    <verse number="13" style="v" sid="3JN 1:13" />मने तारी जुगु घणु लीखवा नु हतु, पण संय अने पेम सी लीखवा नी हींडतो हतो। <verse eid="3JN 1:13" /><verse number="14" style="v" sid="3JN 1:14" />पण मारी आह से के मे तारी ह़ाते घण छोटो भेटीन आंबा-सांबा हय्‌न वात करही।<verse eid="3JN 1:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="3JN 1:15" />तने सांती जड़े आञे ना ह़ाती तने आवजे अने आवही केय, अने तां वाळा एक-एक ह़ाती ने नाम ली-लीन आवही अने आवजे की देजे।<verse eid="3JN 1:15" /></para>
  <chapter eid="3JN 1" />
</usx>