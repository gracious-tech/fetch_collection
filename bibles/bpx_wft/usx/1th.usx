<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TH" style="id">- Paliya</book>
  <para style="h">1 थीसलुनीकीयो</para>
  <para style="toc3">1 थीसलुनीकीयो</para>
  <para style="toc2">1 थीसलुनीकीयो</para>
  <para style="toc1">थीसलुनीकीयो ना नाम पोलुस नी पेली चीट्‌ठी</para>
  <para style="mt2">थीस्‌सलुनीकियों के नाम प्रेरित पोलुस की पहली पत्री</para>
  <para style="mt1">थीसलुनीकीयो ना नाम पोलुस नी पेली चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">थीसलुनीकीयो ना नामे नेवताळा पोलुस नी पेली चीट्‌ठी आहयी चीट्‌ठी जे पोलुस लीखलो हतो। <char style="xt"><ref loc="1TH 1:1">1:1</ref></char> आहयी चीट्‌ठी जे पोलुस लीखलो जे पेली चोखली सास्‌तर नो हीस्‌सो बणी, अने मसी ना पयदा हयवान 51 साल नी अळतेण लीखली से अने जत्‌यार पोलुस आहयी चीट्‌ठी लीख्‌यो ता तीहयो कुरन्‌थी ह़ेर मे हतो, थीसलुनीकीयो नी मंडळी ने जे तीहयो आहयी चीट्‌ठी बीजी मीसनरी यात्‌रा नी टेमे मंडळी बणायो, <char style="xt"><ref loc="ACT 17:1-10">नेवताळा ना काम 17:1-10</ref></char> नेवताळा ना काम नी आहयी कीताप मे आहयु देखाड़े के आहयी मंडळी युहद्‌या अने आड़जात्‌या नी बणली हती।</para>
  <para style="ip">थीसलुनीकीयो नी मंडळी ने बणाव्‌वान अळतेण पोलुस थीसलुनीकीयो मे जादा दाड़ा लग नी री सक्‌यो, एतरे तीहयो आहयी चीट्‌ठी लीखीन भरहो करवा वाळा ने बड़ावो आपे, आहयी चीट्‌ठी मे ढेरेत वात ना बारा मे वात कर्‌या के मसी मे केम रेवा जोवे। पोलुस मसीन बीजी कावा आव्‌वा ना बारा मे बी लीखे, करीन आनीन करते के थीसलुनीकीयो नी मंडळी मे जे रेवा वाळा भरहो करन्‌या ने ह़मळावा मे घणी हेर हती, पोलुस ईसुन बीजी कावा आव्‌वा ना बारा मे लीखीन बड़ावो अने एवी जीवाय जीव्‌वा करीन बड़ावो आपे के जीनी सी भगवान खुस हये <char style="xt"><ref loc="1TH 5:6-8">5:6-8</ref></char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. मंडळी ने आवजो अने आवही केवा अने भगवान ने घणो वारु केवा। <char style="ior"><ref loc="1TH 1">1</ref></char></para>
  <para style="io1">2. पोलुस आह़फा ना काम ना बारा मे अने जे तीमुथीयुस जे वात लायो तीहयी वात बारा मे वात। <char style="ior"><ref loc="1TH 2-3">2–3</ref></char></para>
  <para style="io1">3. ईसुन बीजी कावा पासो आव्‌वा नी तीयारी करवा करीन मसी माणहु केवी जीवाय जीव्‌वा जोवे। <char style="ior"><ref loc="1TH 4:1-5:15">4:1–5:15</ref> </char></para>
  <para style="io1">4. पोलुस नु मंडळी ने आवजो अने आवही केणु अने मंडळी ना आखा आहयी चीट्‌ठी ने भणवा जोवे तीना बारा मे वीन्‌ती, <char style="ior"><ref loc="1TH 5:16-28">5:16-28</ref></char></para>
  <chapter number="1" style="c" sid="1TH 1" />
  <para style="p">
    <verse number="1" style="v" sid="1TH 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:1">नेवताळा ना काम 17:1</ref>
      </char>
    </note>पोलुस अने सीलवानुस अने तीमुथीयुस नी भणी गेथी थीसलुनीकीयो नी मंडळी ना नाम जे भगवान बाह अने ईसु मसी मे से: संयबरकत अने सांती तमने जड़ती रेय।<verse eid="1TH 1:1" /></para>
  <para style="s">थीसलुनीकीयो नो भरहो</para>
  <para style="p">
    <verse number="2" style="v" sid="1TH 1:2" />आमु अमारी वीन्‌ती मे तमने फोम करतला अने जलम तमु आखा ना बारा मे भगवान ने घणो वारु केतला। <verse eid="1TH 1:2" /><verse number="3" style="v" sid="1TH 1:3" />अने आपणा भगवान बाह नी अगळ तमारा भरहा ना काम, अने मोंग नी मेहनत, अने आपणा मालीक ईसु मसी मे आह नी धीरज ने लगातार फोम करता रीया। <verse eid="1TH 1:3" /><verse number="4" style="v" sid="1TH 1:4" />अने ए भायु, अने बेन्‌या, भगवान ना मोंगाळ्‌ळा माणहु आमने मालम से, के तमु तीनी लारे टाळला से। <verse eid="1TH 1:4" /><verse number="5" style="v" sid="1TH 1:5" />अमारी खुस-खबर तमारीन्‌तां बोलु सी एतरीत नी पण ताखत, अने चोखली आत्‌मा सी अने पुरी सच्‌चाय भेळ पुगली से, जेम तमु जाणो बी के जत्‌यार आमु तमारी वच मे हता ता तमारी जुगु तमारी वच मे केवा बण जेला से। <verse eid="1TH 1:5" /><verse number="6" style="v" sid="1TH 1:6" /><note caller="+" style="x"><char style="xo" closed="false">1:6 </char><char style="xt" closed="false"><ref loc="ACT 17:5-9">नेवताळा ना काम 17:5-9</ref></char></note>अने तमु घणी वेला मे चोखली आत्‌मा नी खुसी भेळ भगवान ना बोलु ने अवरीन अमारी अने मालीक ने तेवी चाल चालवा बाज ज्‌या। <verse eid="1TH 1:6" /><verse number="7" style="v" sid="1TH 1:7" />आञे तक के मकीदुनीया अने अखाया जीला ना आखा ईसु पोर भरहो करवा वाळा जुगु तमु ईज्‌जत बण्‌या। <verse eid="1TH 1:7" /><verse number="8" style="v" sid="1TH 1:8" />काहाके तमारीन्‌तां गेथा नी पण मकीदुनीया अने अखाया मे मालीक ना बोलु ह़मळाया, पण तमारा भरहा नी जे भगवान पोर कर र्‌या, आखी जागे एवी वात फेली जी, के आमने केवा नी कंय जरवत नी हय। <verse eid="1TH 1:8" /><verse number="9" style="v" sid="1TH 1:9" />काहाके तीहयात माणहु अमारा बारा मे देखाड़े के अमारु आवणु तमारीन्‌तां कीकम हयु; अने तमु कीकम मुरत्‌या भणी गेथा भगवान भणी वळ्‌या के जीवत्‌ला अने खरला भगवान नी सेवा करो। <verse eid="1TH 1:9" /><verse number="10" style="v" sid="1TH 1:10" />अने भगवान ना सोरा ईसु मसी नी जे ह़रगे गेथो आव्‌वा वाळो से वाट जोवता रेवो, जीने तीहयो मरला मे गेथो जीवतो करलो से, जे आमने आव्‌वा वाळी गरा सी बचाड़े।<verse eid="1TH 1:10" /></para>
  <chapter eid="1TH 1" />
  <chapter number="2" style="c" sid="1TH 2" />
  <para style="s">पोलुस नु परच्‌यार नु काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 2:1" />मोंगाळ्‌ळा भायु, अने बेन्‌या तमने खुद नेत मालम से के अमारु तमारीन्‌तां आवणु रीकामु नी हयु। <verse eid="1TH 2:1" /><verse number="2" style="v" sid="1TH 2:2" /><note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="ACT 16:19-24">नेवताळा ना काम 16:19-24</ref>; </char><char style="xt" closed="false"><ref loc="ACT 17:1-9">नेवताळा ना काम 17:1-9</ref></char></note>तमारीन्‌तां थीसलुनीकीयो मे आव्‌वान पेले तमने मालम से के आमु फीलीपी मे दुख अने वेला वेठ्‌या तां घण-जबर वीरोद हतो ते बी आमु तमने भगवान नी खुस-खबर ह़मळाया। <verse eid="1TH 2:2" /><verse number="3" style="v" sid="1TH 2:3" />काहाके अमारी ह़ीकापण सण्‌का सी नी हय अने नी गलत काम सी नी हय, अने नी ते चलाकी सी हय। <verse eid="1TH 2:3" /><verse number="4" style="v" sid="1TH 2:4" />पण जेम भगवान आमने बणावलो से अने खुस-खबर ह़ोप्‌यो, आमु तेमेत बोलया; अने आञे माणहु ने नी; पण भगवान ने जे अमारा मन ने जाचे, तीने खुस करया। <verse eid="1TH 2:4" /><verse number="5" style="v" sid="1TH 2:5" />काहाके तमु जाणो, के आमु नी ते कदी मन वाळवा नी वात करया, अने नी लालच जुगु बोनु करया, भगवान गवा से। <verse eid="1TH 2:5" /><verse number="6" style="v" sid="1TH 2:6" />अने मसी ना चेला हयवा ना नाता सी आमु तमारी पोर बोजो नाख सकता हता, ते बी आमु माणहु ने अने तमने ईज्‌जत नी करावता हता, अने नी बीजा माणहु ने।<verse eid="1TH 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1TH 2:7" />भले आमु मसी ना नेवताळा हयवा ना नाते आमु तमारी पांह मांग सकता हता, पण जेम आय्‌ह़ आह़फी ना सोरा ने पाळे-पोहे, तेमेत आमु बी तमारी ह़ाते रीन भोळाय देखाड़ला से। <verse eid="1TH 2:7" /><verse number="8" style="v" sid="1TH 2:8" />अने तेमेत आमु तमारी हेर करता जाय्‌न, नी पण भगवान नी खुस-खबर ह़मळावता जाय्‌न अमारो जीव बी तमने आपवा तीयार हता, आनीन करते के तमु अमारा मोंगाळ्‌ळा बण जेला हता। <verse eid="1TH 2:8" /><verse number="9" style="v" sid="1TH 2:9" />ए मोंगाळ्‌ळा भायु, अने बेन्‌या तमु अमारी मेहनत अने दुख ने फोम राखे, आनीन करते के आमु रात-दाड़ो काम-धंदो करता जाय्‌न तमने भगवान नी खुस-खबर ह़मळाया के तमारी मे गेथा कोय पोर बी बोज नी पड़वा जोवे।<verse eid="1TH 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="1TH 2:10" />तमु आहयी वात ना गवा से, अने तेमेत भगवान बी से, के आमु तमारी आखा ईसु पोर भरहो करन्‌या माणहु ह़ाते चोखलो, खरलो, अने वण-गुनाळ्‌ळो वेहवार कर्‌या। <verse eid="1TH 2:10" /><verse number="11" style="v" sid="1TH 2:11" />जेम तमु जाणे, के आमु तमारी ह़ाते तेमेत वेहवार करया जेम बाह आह़फा ना सोरा ह़ाते करे। तेमेत आमु बी तमने आखा ने ह़ीकापण आपया, अने सांती आपया, अने ह़मजाड़या। <verse eid="1TH 2:11" /><verse number="12" style="v" sid="1TH 2:12" />के तमारी चाल-चलण भगवान ने गमती रेय, जे तमने आह़फा ना राज अने बड़ाय मे बोलावे।<verse eid="1TH 2:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 2:13" />एम करीन आमु बी भगवान ने घणो वारु से केता, री र्‌या; काहाके जत्‌यार अमारी लारे भगवान नी खुस-खबर ना बोलु तमारीन्‌तां पुग्‌या, ता तमु तीने माणहु ना नी, पण भगवान ना बोलु ह़मजीन मान्‌या: अने ह़ाचलीन आहयु आसमेत से। अने तीहया तमारी मे जे भरहो राख र्‌या, काम बी करे। <verse eid="1TH 2:13" /><verse number="14" style="v" sid="1TH 2:14" /><note caller="+" style="x"><char style="xo" closed="false">2:14 </char><char style="xt" closed="false"><ref loc="ACT 17:5">नेवताळा ना काम 17:5</ref></char></note>करीन तमु, ए भायु, अने बेन्‌या, भगवान नी तीहयी मंडळीन तेवी चाल चालवा बाज ज्‌या जे युहदी जीला मे मसी ईसु मे से, काहाके तमु बी तमारा माणहु नी लारे तेवोत दुख झेल्‌या, जेम तीहया युहदी नी लारे झेल्‌या। <verse eid="1TH 2:14" /><verse number="15" style="v" sid="1TH 2:15" /><note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="ACT 9:23">नेवताळा ना काम 9:23</ref>,<ref loc="ACT 9:29">29</ref>; <ref loc="ACT 13:45">13:45</ref>,<ref loc="ACT 13:50">50</ref>; <ref loc="ACT 14:2">14:2</ref>,<ref loc="ACT 14:5">5</ref>,<ref loc="ACT 14:19">19</ref>; <ref loc="ACT 17:5">17:5</ref>,<ref loc="ACT 17:13">13</ref>; <ref loc="ACT 18:12">18:12</ref></char></note>जे ईसु मसी ने अने ह़रगे गेथा केवा वाळा माणहु ने बी मार नाख्‌या अने आमने बी वेला पाड़्‌या। जे भगवान ने नराज करे; अने तीहया आखा माणहु नो वीरोद करे। <verse eid="1TH 2:15" /><verse number="16" style="v" sid="1TH 2:16" />अने तीहया आड़जात्‌या ह़ाते तीमना छुटकारा नी वात करवा सी आमने रोके के तीहया तीमना पाप नो घड़ो भरता रेय, पण तीमनी पोर मोट्‌ली गरा आय पड़ली से।<verse eid="1TH 2:16" /></para>
  <para style="s">पोलुस नी मंडळी ने पासो भेटवा नी हेर</para>
  <para style="p">
    <verse number="17" style="v" sid="1TH 2:17" />ए भायु अने बेन्‌या, आमु थोड़ीक वार लग तमारी गेथा मन मे नी, पण डील सी सेटा हय जेला। एतरे आमु तमने देखवा करीन घण-जबर हेर कर रेला। <verse eid="1TH 2:17" /><verse number="18" style="v" sid="1TH 2:18" />एतरे आमु तमारीन्‌तां पासा आव्‌वा कर रेला, खास करीन मे पोलुस, एक कावा नी पण कंय कावा आव्‌वा करलो पण भुतड़ो रोक देदलो। <verse eid="1TH 2:18" /><verse number="19" style="v" sid="1TH 2:19" />अमारी आह, नीता खुसी नीता बड़ाय नी पागड़ी ह़ु से? ह़ु आपणा मालीक ईसु मसी अगळ तीहयो आवहे तीहयी टेमे, तमुत नी बणो ह़ु? <verse eid="1TH 2:19" /><verse number="20" style="v" sid="1TH 2:20" />ह़ाचलीनेत, अमारी बड़ाय अने खुसी तमुत से।<verse eid="1TH 2:20" /></para>
  <chapter eid="1TH 2" />
  <chapter number="3" style="c" sid="1TH 3" />
  <para style="s">तीमुथीयुस ने मोकलनु</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 3:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 17:15">नेवताळा ना काम 17:15</ref>
      </char>
    </note>काहाके आमु अळी वाट नी जोय सकता हता करीन आमु अथेंस ह़ेर मे एखला रेवा करीन ठाण लेदा। <verse eid="1TH 3:1" /><verse number="2" style="v" sid="1TH 3:2" />अने आमु तीमुथीयुस ने जे मसी नी खुस-खबर मे अमारो भाय अने भगवान नो चाकर्‌यो से आनीन करते मोकल्‌या के तीहयो तमने वातड़ा करे अने तमने भरहा ना बारा मे ह़मजाड़े। <verse eid="1TH 3:2" /><verse number="3" style="v" sid="1TH 3:3" />के आहया दुख ना कारण सी कोय बी वचकवा नी जोवे काहाके तमु ते जाणो के आमु आनीत जुगु ठेरावला से। <verse eid="1TH 3:3" /><verse number="4" style="v" sid="1TH 3:4" />काहाके पेलेत जत्‌यार आमु तमारीन्‌तां हता ता आमु तमने की देदला के आपणु ने दुख झेलवा पड़हे अने एमेत हयवा बाज र्‌यु जीसम तमु जाणो बी। <verse eid="1TH 3:4" /><verse number="5" style="v" sid="1TH 3:5" />करीन जत्‌यार मने अळी वाट नी जोवायु ता तमारा भरहा ना बारा मे जाणवा करीन तीमुथीयुस ने मोकल्‌यो के कंय माय्‌न आसम नी हय जाय के भुतड़ो तमने पारखे अने अमारी मेहनत वांयेबार जत रेय।<verse eid="1TH 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TH 3:6" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:6 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:5">नेवताळा ना काम 18:5</ref>
      </char>
    </note>पण हाव तीमुथीयुस जे तमारीन्‌तां गेथो अमारीन्‌तां आवलो से, तमारा भरहा अने मोंग नी खुस-खबर ह़मळायो अने आहयी वात बी ह़मळायो के तमु सदा मोंग भेळ आमने फोम करत्‌ला अने जेम आमु तमने देखवा नी हेर करया तेमेत तमु बी करे। <verse eid="1TH 3:6" /><verse number="7" style="v" sid="1TH 3:7" />एतरे ए भायु, अने बेन्‌या, आमने अमारा आखा दुख अने वेला मे तमारा भरहा सी सांती जड़ी। <verse eid="1TH 3:7" /><verse number="8" style="v" sid="1TH 3:8" />काहाके हाव तमु मालीक मे वातड़ा रेहु ता आमु जीवत्‌ला से। <verse eid="1TH 3:8" /><verse number="9" style="v" sid="1TH 3:9" />अने जेवी खुसी आमने तमारा कारण सी आपणा भगवान नी अगळ से, तीना बदला मे आमु कानी रीते भगवान ने घणो वारु से कीया। <verse eid="1TH 3:9" /><verse number="10" style="v" sid="1TH 3:10" />आमु रात-दाड़ो घण-जबर वीन्‌ती करता र्‌या के तमारा मोडा देखया अने भरहा नी कमी ने पुरी करया।<verse eid="1TH 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TH 3:11" />हाव आपणो भगवान बाह आह़फोत अने मालीक ईसु तमारीन्‌तां आव्‌वा करीन अमारी अगवाय करे। <verse eid="1TH 3:11" /><verse number="12" style="v" sid="1TH 3:12" />अने मालीक आसम करे के जेम आमु तमारी ह़ाते मोंग राखया तेमेत तमारो मोंग बी तमारी वच मे अने आखा माणहु नी ह़ाते वदे, अने बड़तो जाय। <verse eid="1TH 3:12" /><verse number="13" style="v" sid="1TH 3:13" />काहाके तीहयो तमारा मन ने काठा करे अने जत्‌यार आपणो मालीक ईसु आह़फा ना चोखला माणहु ह़ाते आवे ता तीहया आपणा बाह भगवान नी हजरी मे चोखलापणा मे वण-गुनाळ्‌ळा ठेरे।<verse eid="1TH 3:13" /></para>
  <chapter eid="1TH 3" />
  <chapter number="4" style="c" sid="1TH 4" />
  <para style="s">भगवान ने खुस करवा वाळी जीवाय</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 4:1" />ए भायु, अने बेन्‌या, आमु तमारी पांह रावण्‌या करया अने तमने मालीक ईसु मे ह़मजाड़या के जेम तमु आमने देखीन गमे एवी चाल चालवा अने भगवान ने खुस करवा ह़ीक्‌या अने जेम तमु चाली बी र्‌या तेमेत अळी बी अगा चालता रेवो। <verse eid="1TH 4:1" /><verse number="2" style="v" sid="1TH 4:2" />काहाके तमु जाणो के आमु मालीक ईसु भणी गेथा तमारीन्‌तां काना-काना हुकम पुगाड़ला। <verse eid="1TH 4:2" /><verse number="3" style="v" sid="1TH 4:3" />काहाके भगवान नी आहयी मरजी से के तमु पुरा चोखला बणो अने छीनाळा सी बचीन रेवो। <verse eid="1TH 4:3" /><verse number="4" style="v" sid="1TH 4:4" />अने तमारी माय्‌न आखा आह़फा नी लाडी ने चोखलापणा मे अने ईज्‌जत भेळ लाव्‌वा जाणे। <verse eid="1TH 4:4" /><verse number="5" style="v" sid="1TH 4:5" />अने आहयु काम लालच सी नी, अने नी ते तीहया आड़जात्‌यान तेम जे भगवान ने नी जाणे, <verse eid="1TH 4:5" /><verse number="6" style="v" sid="1TH 4:6" />के आहयी वात मे कोय बी आह़फा ना भाय ने नी ठगे, अने नी तीने फसाड़वा जोवे, काहाके मालीक आहयी आखी वात नो बदलो लेवा वाळो से, जेम आमु तमने पेलेत केदला अने चेतावणी बी आपला हता। <verse eid="1TH 4:6" /><verse number="7" style="v" sid="1TH 4:7" />काहाके भगवान आपणु ने वीटळ्‌ळा हयवा करीन नी, पण चोखा हयवा करीन बोलावलो से। <verse eid="1TH 4:7" /><verse number="8" style="v" sid="1TH 4:8" />एतरे जे बी आने हेटी ह़मजे, तीहयो माणेह ने नी पण भगवान ने ह़मजे, जे आह़फा नी चोखली आत्‌मा तमने आपे।<verse eid="1TH 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TH 4:9" />भाय बेन्‌या मोंग ना बारा मे तमने लीखवा जरुड़ी नी हय, काहाके भगवान सी तमु आह़फात आंबा-सांबा मोंग करवा ह़ीकला से। <verse eid="1TH 4:9" /><verse number="10" style="v" sid="1TH 4:10" />अने मकीदुनीया ना आखा भाय-बेन्‌या नी ह़ाते आसम करता बी रेवो। पण ए भायु, अने बेन्‌या, आमु तमने ह़मजाड़या के अळी बी अगा वदता जावो, <verse eid="1TH 4:10" /><verse number="11" style="v" sid="1TH 4:11" />अने जेम आमु तमने हुकम आपला, तेमेत होगा रीन अने आपणु-आपणु काम-काज करवा ध्‌यान देवो अने आपणा-आपणा हातु सी कमायवा नी कोसीत करो। <verse eid="1TH 4:11" /><verse number="12" style="v" sid="1TH 4:12" />अने बाहर वाळा पांह ईज्‌जत हात करो, अने तमने कानी बी चीज नी कमी नी रेवा जोवे।<verse eid="1TH 4:12" /></para>
  <para style="s">ईसु नु पासु आवणु</para>
  <para style="p">
    <verse number="13" style="v" sid="1TH 4:13" />ए भायु, अने बेन्‌या आमु आसम नी करवा हींडता के तमु तीमना बारा मे जे मर जेला से, वण-अकल्‌या रेवो; अने आसम नी हय जाय के तमु बीजान तेम रड़ो कलपो जीमने आह नी हय। <verse eid="1TH 4:13" /><verse number="14" style="v" sid="1TH 4:14" />कदीम आमु भरहो करया के ईसु मर्‌यो अने पासो जीव उठ्‌यो, ता तेमेत भगवान तीमने बी जे मसी मे मर जेला से, तीनी ह़ाते ली आवहे।<verse eid="1TH 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1TH 4:15" />
    <note caller="+" style="x">
      <char style="xo" closed="false">4:15 </char>
      <char style="xt" closed="false">
        <ref loc="1CO 15:51">1 कुरन्‌थी 15:51</ref>,<ref loc="1CO 15:52">52</ref></char>
    </note>काहाके आमु मालीक ना बोलु नी अनसारे तमने आहयु कीया के आमु जे जीवत्‌ला से अने मालीक ने आवते तक बचला रेहु, जे पेले मर जेला से तीमनी गेथा कदी अगळ नी हय सकया। <verse eid="1TH 4:15" /><verse number="16" style="v" sid="1TH 4:16" />अने मालीक आह़फोत ह़रगे गेथो उतरहे; तीहयी टेमे कुर्‌रो, अने मोट्‌ला ह़रगे वाळा खबर लावण्‌या नी अवाज ह़मळायह़े, अने भगवान नु फेपार्‌यु वगाड़हे, अने मसी मे मर जेला से, पेले जीवता हय जहे। <verse eid="1TH 4:16" /><verse number="17" style="v" sid="1TH 4:17" />तत्‌यार आमु जे जीवत्‌ला रेहु अने बचला रेहु तीमनी ह़ाते वादळा मे उचलाय जहु काहाके वाहळु मे मालीक ने भेटया; अने आहयी रीते जलम तक मालीक ह़ाते रेहु। <verse eid="1TH 4:17" /><verse number="18" style="v" sid="1TH 4:18" />आहयी वातु नी लारे एक-बीजा ने सांती आप्‌या करो।<verse eid="1TH 4:18" /></para>
  <chapter eid="1TH 4" />
  <chapter number="5" style="c" sid="1TH 5" />
  <para style="s">ईसु पासो आवहे एतरे तीयार रेवो</para>
  <para style="p">
    <verse number="1" style="v" sid="1TH 5:1" />हाव ए भायु, अने बेन्‌या आहयी वात नी जरवत नी हय के टेम अने दाड़ा ना बारा मे तमारी जुगु अळी लीखु। <verse eid="1TH 5:1" /><verse number="2" style="v" sid="1TH 5:2" /><note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="MAT 24:43">मत्‌ती 24:43</ref>; <ref loc="LUK 12:39">लुका 12:39</ref>; <ref loc="2PE 3:10">2 पतरस 3:10</ref></char></note>काहाके तमु आह़फा बी वारु जाणो के जेम राते चोट्‌टु आवे, तेमेत मालीक नो दाड़ो आव्‌वा वाळो से। <verse eid="1TH 5:2" /><verse number="3" style="v" sid="1TH 5:3" />जत्‌यार माणहु केहे, “वारला से, अने कंय बी बीक नी हय” ता तीमनी पोर एक वाहराय गरा आय पड़हे, जेम भारेपोगे बयर पोर आय पड़े, अने तीहया कानी बी रीते नी बचे। <verse eid="1TH 5:3" /><verse number="4" style="v" sid="1TH 5:4" />पण ए भायु, अने बेन्‌या तमु ते अंदारला मे नी हय के तीहया दाड़ा तमारी पोर चोट्‌टान तेम आय पड़े। <verse eid="1TH 5:4" /><verse number="5" style="v" sid="1TH 5:5" />काहाके तमु आखा वीजाळु नी अने दाड़ा नी अवल्‌यात से, आपणु नी ते रात हय अने नी ते अंदारलु ना हय। <verse eid="1TH 5:5" /><verse number="6" style="v" sid="1TH 5:6" />आनीन करते आपणु आखा बीजा नी तेम ह़ुवता ना रेवो, पण जागता अने चेतीन रेवो। <verse eid="1TH 5:6" /><verse number="7" style="v" sid="1TH 5:7" />काहाके जे ह़ुवे तीहया आखा रातेत ह़ुवे, अने जे छाके तीहया रातेत छाके। <verse eid="1TH 5:7" /><verse number="8" style="v" sid="1TH 5:8" /><note caller="+" style="x"><char style="xo" closed="false">5:8 </char><char style="xt" closed="false"><ref loc="EPH 6:13-17">ईफीसीयो 6:13-17</ref></char></note>पण जे आपणु दाड़ा ना से, भरहा अने मोंग नी ढाळ पेरीन अने छुटकारा नी आह नी टोपी पेरीन चेतीन रेवो। <verse eid="1TH 5:8" /><verse number="9" style="v" sid="1TH 5:9" />काहाके भगवान आपणु ने रीह जुगु नी, पण आनी लेदे बणावलो से के आपणु आपणा मालीक ईसु मसी नी लारे छुटकारो हात करया। <verse eid="1TH 5:9" /><verse number="10" style="v" sid="1TH 5:10" />ईसु आपणी जुगु आहया कारण सी मर्‌यो के आपणु जत्‌यार बी मरया अने जीवया, ता आखा मेळीन तीनीत ह़ाते रीया। <verse eid="1TH 5:10" /><verse number="11" style="v" sid="1TH 5:11" />एम करीन एक-बीजा ने सांती आपो, अने एक-बीजा नी लेदे फायदा नो कारण बणो, जेम तमु करी बी र्‌या।<verse eid="1TH 5:11" /></para>
  <para style="s">मंडळी ने ह़ीकापण</para>
  <para style="p">
    <verse number="12" style="v" sid="1TH 5:12" />ए भायु, अने बेन्‌या आमु तमारी पांह रावण्‌या करया के मालीक मे जे तमारा अगवाय करन्‌या से, अने तमने ह़ीकापण आपे, तीमनी ईज्‌जत करो। <verse eid="1TH 5:12" /><verse number="13" style="v" sid="1TH 5:13" />अने तीमना काम नी लेदे मोंग भेळ तीमने घण-जबर ईज्‌जत करो। अने तमु आखा हेळी-मेळीन रेवो।<verse eid="1TH 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1TH 5:14" />ए भायु, अने बेन्‌या तमने ह़मजाड़या के जे वारु चाल नी चाले तीमने ह़मजाड़ो, ओगज्‌या ने चेतावो, कमजोर ने ह़माळो, अने आखा ह़ाते टेकीन रेवा नी ताखत देखाड़ो, <verse eid="1TH 5:14" /><verse number="15" style="v" sid="1TH 5:15" />अने चेतीन रेवो! कोय बी कोय ह़ाते बुराय ना बदले बुराय ना करो; पण जलम भलाय करवा तीयार रेवो, आपणु आखा अने बीजा ह़ाते बी भलाय नी वात करो।<verse eid="1TH 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1TH 5:16" />जलम खुसी मे रेवो। <verse eid="1TH 5:16" /><verse number="17" style="v" sid="1TH 5:17" />आखी टेमे वीन्‌ती करता रेवो। <verse eid="1TH 5:17" /><verse number="18" style="v" sid="1TH 5:18" />आखी वात मे घणा वारु से केता रेवो; काहाके तमारी जुगु ईसु मसी मे भगवान नी आहयीत मरजी से।<verse eid="1TH 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1TH 5:19" />आत्‌मा ने ना ओलवो। <verse eid="1TH 5:19" /><verse number="20" style="v" sid="1TH 5:20" />भगवान वगे गेथी केदली वात ने गलत ना ह़मजो। <verse eid="1TH 5:20" /><verse number="21" style="v" sid="1TH 5:21" />आखी वात ने पारखो; जे वारु से तीने ह़मळता रेवो। <verse eid="1TH 5:21" /><verse number="22" style="v" sid="1TH 5:22" />आखी भाती नी कुहराय सी बचीन रेवो।<verse eid="1TH 5:22" /></para>
  <para style="s">आखरी बरकत</para>
  <para style="p">
    <verse number="23" style="v" sid="1TH 5:23" />सांती नो भगवान आह़फोत पुरी रीती सी तमने चोखो करे; अने तमारी आत्‌मा ने जीव अने डील आपणा मालीक ईसु मसी ने आवते तक पुरा-पुरा वण-गुनाळ्‌ळा अने बचीन रेवो। <verse eid="1TH 5:23" /><verse number="24" style="v" sid="1TH 5:24" />तमारो बोलाव्‌वा वाळो भरहो करे एवो से, अने तीहयो एमेत करहे।<verse eid="1TH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="1TH 5:25" />ए भायु, अने बेन्‌या, अमारी जुगु वीन्‌ती करो।<verse eid="1TH 5:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1TH 5:26" />आखा भाय-बेन्‌या, ने आवही अने आवजो केवो।<verse eid="1TH 5:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="1TH 5:27" />मे तमने मालीक ना हक सी केम, के आहयी चीट्‌ठी आखा भरहो करन्‌या भाय-बेन्‌या ने ह़मळावजो।<verse eid="1TH 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1TH 5:28" />आपणा मालीक ईसु मसी नी दया तमारी ह़ाते रेय।<verse eid="1TH 5:28" /></para>
  <chapter eid="1TH 5" />
</usx>