<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1JN" style="id">- Paliya</book>
  <para style="h">1 युहन्‌ना</para>
  <para style="toc3">1 युहन्‌ना</para>
  <para style="toc2">1 युहन्‌ना</para>
  <para style="toc1">युहन्‌ना नी पेली चीट्‌ठी</para>
  <para style="mt2">युहन्‌ना की पहली पत्री</para>
  <para style="mt1">युहन्‌ना नी पेली चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">1 युहन्‌ना नी चीट्‌ठी नेवताळा युहन्‌ना नी लारे ईसु मसी पयदा हयवान 50-100 साल नी वच मे लीखलो हतो। युहन्‌नो खुद ने लीखण्‌या ना रुप मे नी देखाड़े, पण पेल्‌ना पाट मे आहयु देखाड़े के तीहयो ईसु नी जीवाय अने पासो आव्‌वा ना बारा मे गवा से। <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref></char> 1 युहन्‌ना मे युहन्‌ना नी लारे लीखली लीखावट खुस-खबर ने तेवी से, आहयु माने के युहन्‌ना नी लारे खुस-खबर लीखलो से, तीहयी तीन चीट्‌ठी ईफीसुस मे रीन लीखलो से, 1 युहन्‌ना 2 युहन्‌ना 3 युहन्‌ना से।</para>
  <para style="ip">युहन्‌नो एकीत टेमे आखा ईसु वाळा ने आहयी चीट्‌ठी लीखलो हतो, जत्‌यार मंडळी ना माणहु ने नोस्‌टीक नाम ना मेळा सी वेला पड़ री हती, आहया माणहु नु मानवु हतु के ईसु पुरी रीते भगवान हतो, पण तीहयो कळी मे माह अने लोय नु डील भेळ ह़ाचलीन माणहे नी हतो, आहयात कारण सी युहन्‌नो ईसु ना जीवाय ना बारा मे उजन्‌तु लीखलो से अने केय के मारा हातु सी ईसु ने छीमलो से। <char style="xt"><ref loc="1JN 1:1-3">1:1-3</ref> </char>आहयी चीट्‌ठी ने लीखवा नो मतलब तीनी खुसी ने पुरी करवु हतु। <char style="xt"><ref loc="1JN 1:4">1 युहन्‌ना 1:4</ref></char> भरहो करन्‌या ने पाप करवा सी रोकवा करीन <char style="xt"><ref loc="1JN 2:1">1 युहन्‌ना 2:1</ref></char> झुटी ह़ीकापण सी भरहो करवा वाळा नी रखवाळी करीन<char style="xt"><ref loc="1JN 2:26">1 युहन्‌ना 2:26</ref></char> पुरो भरहो करावजे के तीहया टाळला से। <char style="xt"><ref loc="1JN 5:13">5:13</ref></char></para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. युहन्‌नो तीनी चीट्‌ठी लीख्‌यो, अने मकसत आप्‌यो <char style="ior"><ref loc="1JN 1:1-4">1:1-4</ref></char></para>
  <para style="io1">2. अळतेण तीहयो देखाड़े के भगवान केवो वीजाळु से अने आमने ईसु ना रुप मे जीवाय जीव्‌वा जोवे। <char style="ior"><ref loc="1JN 1:5-3:10">1:5–3:10</ref></char></para>
  <para style="io1">3. आनीन अळतेण तीहयो आमने एक-बीजा ह़ाते मोंग करवा ना हुकम नी फोम करावे। <char style="ior"><ref loc="1JN 3:11-5:12">3:11–5:12</ref></char></para>
  <para style="io1">4. तीहयो तीनी चीट्‌ठी खत्‌तम करे <char style="ior"><ref loc="1JN 5:13-21">5:13-21</ref></char></para>
  <chapter number="1" style="c" sid="1JN 1" />
  <para style="s">जीवाय नो बोल</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:1">युहन्‌ना 1:1</ref>
      </char>
    </note>तीहयी जीवाय ना बोल ना बारा मे तमने लीख्‌यो जे सुरु गेथो हतो, जीने आमु ह़मळ्‌या, अने जीने आमु धीयान सी देखला, अने हात वेर छीम्‌या, <verse eid="1JN 1:1" /><verse number="2" style="v" sid="1JN 1:2" /><note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="JHN 1:14">युहन्‌ना 1:14</ref></char></note>आहयी जीवाय उजन्‌ती हयी, अने आमु तीने देख्‌या, अने तीनी गवाय दीया, अने तमने तीहयी अमर जीवाय नी खुस-खबर आपया जे बाह ह़ाते हती अने अमारी पोर उजन्‌ती हयी। <verse eid="1JN 1:2" /><verse number="3" style="v" sid="1JN 1:3" />जे कंय आमु देख्‌या अने ह़मळ्‌या तीनी खबर तमने बी आपया, आनीन करते के तमु बी अमारी ह़ाते साजल्‌या बणो; अने आपणु भगवान बाह ह़ाते अने तीना सोरा ईसु मसी ह़ाते साजल्‌या से। <verse eid="1JN 1:3" /><verse number="4" style="v" sid="1JN 1:4" />अने आमु आहयी वात आनीन करते लीखया के अमारी खुसी पुरी हय जाय।<verse eid="1JN 1:4" /></para>
  <para style="s">भगवान वीजाळु से</para>
  <para style="p">
    <verse number="5" style="v" sid="1JN 1:5" />जे खबर आमु तीना सोरा नी लारे ह़मळ्‌या अने तमने ह़मळावया, तीहयी आहयी से के भगवान वीजाळु से अने तीनी मे कंय बी अंदारलु नी हय। <verse eid="1JN 1:5" /><verse number="6" style="v" sid="1JN 1:6" />कदीम आमु कीया के तीनी ह़ाते आमु साजल्‌या से अने अळतेण अंदारला मे चालया, ता आमु झुटा से अने सच्‌चाय पोर नी चालता। <verse eid="1JN 1:6" /><verse number="7" style="v" sid="1JN 1:7" />पण कदीम जेम भगवान वीजाळा मे से, तेमेत आपणु बी वीजाळा मे चालो, ता एक-बीजा ह़ाते साजल्‌या बणहु, अने तीना सोरा ईसु मसी नु लोय आपणु ने आखा पाप सी चोखा करे।<verse eid="1JN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1JN 1:8" />कदीम आमु कीया के अमारी मे कंय बी पाप नी हय, ता आह़फा ने धोको दी र्‌या, अने आपणी मे सच्‌चाय नी हय। <verse eid="1JN 1:8" /><verse number="9" style="v" sid="1JN 1:9" />कदीम आपणु आपणा पाप ने मान लीया, ता भगवान आपणा पाप ने माफ करवा मे अने आपणु ने आखा पापु सी चोखा करवा मे भरहा नी लायक अने नीयाव करन्‌यो से। <verse eid="1JN 1:9" /><verse number="10" style="v" sid="1JN 1:10" />कदीम आपणु कीया के आमु पाप नी कर्‌या, ता भगवान ने झुटो ठेरावया, अने तीनो बोल आपणी मे नी हय।<verse eid="1JN 1:10" /></para>
  <chapter eid="1JN 1" />
  <chapter number="2" style="c" sid="1JN 2" />
  <para style="s">मसी आपणो मदत करवा वाळो</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 2:1" />ए मारा सोरा, मे आहयी वात तमारी जुगु आनीन करते लीखु के तमु पाप नी करो; अने कदीम कोय पाप करे, ता बाह ने तां एक आपणो मदत करवा वाळो से, जे नीयाव करन्‌यो से तीहयो ईसु मसी से; <verse eid="1JN 2:1" /><verse number="2" style="v" sid="1JN 2:2" />तीहयोत आपणा पापु ने माफ करे, अने आपणा पाप ने एतरोत नी पण आखी कळी ना पापु ने माफ करे।<verse eid="1JN 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1JN 2:3" />कदीम आपणु तीना हुकम ने मानहु, ता आनी सी आपणु जाण लेहु के आपणु तीने जाण ज्‌या। <verse eid="1JN 2:3" /><verse number="4" style="v" sid="1JN 2:4" />जे कोय आहयु केय, “मे तीने जाण लेदो” अने तीना हुकम ने नी मान्‌तो, तीहयो झुटो से तीनी मे सच्‌चाय नी हय; <verse eid="1JN 2:4" /><verse number="5" style="v" sid="1JN 2:5" />पण जे कोय तीना बोलु पोर चाले, तीनी मे ह़ाचलीन भगवान नो मोंग उजन्‌तो हयलो से। आनी सी आमु जाणया के आमु तीनी मे एक से: <verse eid="1JN 2:5" /><verse number="6" style="v" sid="1JN 2:6" />जे कोय आहयु केय के मे भगवान मे बणीन रेम, ता तीने बी तेमेत चालवा जोवे जेम ईसु मसी चाले।<verse eid="1JN 2:6" /></para>
  <para style="s">नवलो हुकम</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 2:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:7 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:34">युहन्‌ना 13:34</ref>
      </char>
    </note>ए मोंगाळ्‌ळा, मे तमने नवलो हुकम नी लीखतो, पण जे तीहयात जुन्‌ला हुकम जे तमने सुरु गेथा जड़ला से; आहयो जुन्‌लो हुकम तीहयो बोल से जीने तु ह़मळलो से। <verse eid="1JN 2:7" /><verse number="8" style="v" sid="1JN 2:8" />ते बी मे तमने नवलो हुकम लीखु, अने आहयो मसी मे अने तमारी मे खरली ठेरे; काहाके अंदारलु मीटतु जाय र्‌यु अने सच्‌चाय नु वीजाळु हाव भबळवा बाज जेलु से।<verse eid="1JN 2:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 2:9" />जे कोय आहयु केय के मे वीजाळु मे से अने आह़फा ना भाय ह़ाते वेर राखे, ता तीहयो हजु तक अंदारलात मे से। <verse eid="1JN 2:9" /><verse number="10" style="v" sid="1JN 2:10" />जे कोय आह़फा ना भाय ह़ाते मोंग राखे तीहयो वीजाळा मे रेय, अने कोयनो ठोकर नो कारण नी बण सके। <verse eid="1JN 2:10" /><verse number="11" style="v" sid="1JN 2:11" />पण जे बी आह़फा ना भाय ह़ाते वेर राखे तीहयो अंदारला मे से अने अंदारलात मे चाले, अने नी जाणे के कां जवा बाज र्‌यो, काहाके अंदारलु तीना डोळा आंदळा कर देदलु से।<verse eid="1JN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="1JN 2:12" />ए सोरा, मे तमारी जुगु आनीन करते लीखु के मसी ना नाम सी तमारा पाप माफ हयला से। <verse eid="1JN 2:12" /><verse number="13" style="v" sid="1JN 2:13" />ए बाहु, मे तमारी जुगु आनीन करते लीखु के जे सुरु गेथो से तीने तमु जाणो। ए जुवान्‌या, मे तमारी जुगु आनीन करते लीखु के तमु तीहया वेरी सी जीक जेला से। ए सोरा, मे तमारी जुगु आनीन करते लीखु के तमु बाह ने ओळखी लेदला से।<verse eid="1JN 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="1JN 2:14" />ए बाहु, मे तमारी जुगु आनीन करते लीखलो से के जे सुरु गेथो से तमु तीने ओळखी लेदला से। ए जुवान्‌या, मे तमारी जुगु आनीन करते लीखलो से के तमु ताखत वाळा से, अने भगवान नो बोल तमारी मे बण्‌लो रेत्‌लो, अने तमु तीहया वेरी सी जीक जेला से।<verse eid="1JN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="1JN 2:15" />तमु नी ते कळी सी अने नी ते कळी नी चीज सी मोंग राखो। कदीम कोय कळी सी मोंग राखे, ता तीनी मे बाह नो मोंग नी हय। <verse eid="1JN 2:15" /><verse number="16" style="v" sid="1JN 2:16" />काहाके जे कंय कळी मे से, मतलब डील नी लालच अने डोळा नी लालच अने जीवाय नी मोटाय, तीहया बाह ने तां गेथी नी पण कळी भणी गेथी से। <verse eid="1JN 2:16" /><verse number="17" style="v" sid="1JN 2:17" />कळी अने तीनी हेर बेम खत्‌तम हयता जाय, पण जे भगवान नी मरजी पोर चाले तीहयो जलमको बणलो रेहे।<verse eid="1JN 2:17" /></para>
  <para style="s">मसी ना वीरोदी</para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 2:18" />ए सोरा, आहयी आखरी टेम से; अने जेम तमु ह़मळला से के मसी नो वीरोदी आव्‌वा वाळो से, तीनी अनसारे हाव बी घण-जबर मसी वीरोदी बठा हय ज्‌या; आनी सी आमु जाणया के आहयी आखरी टेम से। <verse eid="1JN 2:18" /><verse number="19" style="v" sid="1JN 2:19" />तीहया नीकळ्‌या ते अमारी मे गेथा, पण अमारी मेना नी हता; काहाके कदीम तीहया अमारी मेना हता, ता अमारी ह़ाते रेता; पण नीकळी आनीन करते ज्‌या के आहयु उजन्‌तु हये के तीहया आखा अमारी मेना नी हय।<verse eid="1JN 2:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 2:20" />पण तमु ते चोखली आत्‌मा मे से, चोखला मसी मे से, जीने तमु जाणो। <verse eid="1JN 2:20" /><verse number="21" style="v" sid="1JN 2:21" />मे तमने आनीन करते नी लीख्‌यो के तमु सच्‌चाय ने नी जाणता, पण आनीन करते के तमु जाणो, अने आनीन करते के कानु झुट, सच्‌चाय भणी गेथु नी हय।<verse eid="1JN 2:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="1JN 2:22" />झुटु कोय से? तीहयोत जे केय के ईसु मसी नी हय; अने जे मसी नो वीरोदी से, जे कोय बाह अने सोरा नो नीकारो करे। <verse eid="1JN 2:22" /><verse number="23" style="v" sid="1JN 2:23" />जे कोय सोरा नो नीकारो करे तीनी पांह बाह बी नी हय: अने जे सोरा ने मान लेय, तीनी पांह बाह बी से।<verse eid="1JN 2:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1JN 2:24" />जे खबर तमु सुरु गेथा ह़मळला से, तीहयुत तमारी मे बणलु रेय, जे तमु सुरु गेथा ह़मळला से, कदीम तीहयी तमारी मे बणलु रेय ता तमु बी सोरा मे अने बाह मे बणला रेहु। <verse eid="1JN 2:24" /><verse number="25" style="v" sid="1JN 2:25" />अने जीनी तीहयो अमारी पांह वायदो करलो से तीहयी अमर जीवाय से।<verse eid="1JN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="1JN 2:26" />मे आहयी वात तमारी जुगु तीमना बारा मे लीखलो से, जे तमने भटकाड़े। <verse eid="1JN 2:26" /><verse number="27" style="v" sid="1JN 2:27" />तमने जे चोखली आत्‌मा मसी भणी गेथी जड़ली से, तीहयी तमारी बणीन रेय, करीन तमने अळी बीजा मास्‌तर नी जरवत नी हय। तीहयी तमने आखु कंय ह़ीकाड़े। तीनी ह़ीकापण खरली से, तमु तीहयी ह़ीकापण नी लारे मसी मे बणला रेवो।<verse eid="1JN 2:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="1JN 2:28" />हाव ए सोरा, तीमनी मे एक बणीन रेवो के जत्‌यार तीहयो उजन्‌तो हये ता अमारी पांह हीम्‌मत रेय अने आमु तीना आव्‌वा सी तीनी अगळ लाजे नी पड़या। <verse eid="1JN 2:28" /><verse number="29" style="v" sid="1JN 2:29" />कदीम तमु जाणे, के तीहयो धरमी से, ता आहयु बी जाणो के जे कोय धरम नु काम करे तीहयो भगवान मे गेथो पयदा हयलो से।<verse eid="1JN 2:29" /></para>
  <chapter eid="1JN 2" />
  <chapter number="3" style="c" sid="1JN 3" />
  <para style="p">
    <verse number="1" style="v" sid="1JN 3:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:1 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:12">युहन्‌ना 1:12</ref>
      </char>
    </note>देखो बाह आपणी ह़ाते केवो मोंग करलो से, के आपणु भगवान नी अवल्‌यात केवाड़या, अने आपणु से बी: एम करीन आहयी कळी ना माणहु आपणु ने नी ओळखता, काहाके तीहया भगवान ने बी नी ओळख्‌या। <verse eid="1JN 3:1" /><verse number="2" style="v" sid="1JN 3:2" />ए मोंगाळ्‌ळा, हाव आपणु भगवान नी अवल्‌यात से, अने हजु तक आहयु उजन्‌तु नी हयु, के आमु केवा रेहु! पण आतरुत मालम से, के जत्‌यार तीहयो उजन्‌तो हयहे ता आपणु बी तीनी ह़रका रेहु, काहाके तीने तेवोत देखहु जेवो तीहयो से। <verse eid="1JN 3:2" /><verse number="3" style="v" sid="1JN 3:3" />अने जे कोय बी तीनी पोर आहयी आह राखे, तीहयो आह़फा ने तेमेत चोखलो बणावे, जेम मसी चोखलो से।<verse eid="1JN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 3:4" />जे कोय पाप करे, तीहयो कायदा नो वीरोद करे; अने पाप ते कायदा नो वीरोद से। <verse eid="1JN 3:4" /><verse number="5" style="v" sid="1JN 3:5" /><note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="JHN 1:29">युहन्‌ना 1:29</ref></char></note>अने तमने ते मालम से, मसी ईसु नु उजन्‌तु हयवा आनीन करते हयु के तीहयो पाप ने खत्‌तम कर देय अने तीनी मे जरीक बी पाप नी हय। <verse eid="1JN 3:5" /><verse number="6" style="v" sid="1JN 3:6" />जे बी तीनी मे बणीन रेय, तीहयो पाप नी करे: जे कोय पाप करे, तीहयो नी ते तीने देख्‌यो, अने नी ते तीने ओळख्‌यो।<verse eid="1JN 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 3:7" />ए सोरा, कोय बी तमने भटकाड़वा नी जोवे, जे धरमी काम करे, तीहयोत मसीन तेम धरमी से। <verse eid="1JN 3:7" /><verse number="8" style="v" sid="1JN 3:8" />जे कोय पाप करे तीहयो भुतड़ा भणी गेथो से, काहाके भुतड़ो सुरु गेथोत पाप करतो आय र्‌यो: भगवान नो सोरो आनीन करते उजन्‌तो हयो, के भुतड़ा ना कामु ने खत्‌तम कर देय।<verse eid="1JN 3:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1JN 3:9" />जे कोय भगवान सी पयदा हयलो से तीहयो पाप नी करे; काहाके भगवान नो बीज तीनी मे बणलो रेय: अने तीहयो कदी पाप करी नी सके, काहाके भगवान सी पयदा हयलो से। <verse eid="1JN 3:9" /><verse number="10" style="v" sid="1JN 3:10" />आनीत सी भगवान नी अवल्‌यात, अने भुतड़ा नी अवल्‌यात ओळखाय जाय; जे कोय धरम नु काम नी करे, तीहयो भगवान सी नी हय, अने नी ते तीहयो जे आह़फा ना भाय ह़ाते मोंग नी राखे।<verse eid="1JN 3:10" /></para>
  <para style="s">एक-बीजा ने मोंग करो</para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 3:11" />
    <note caller="+" style="x">
      <char style="xo" closed="false">3:11 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 13:34">युहन्‌ना 13:34</ref>
      </char>
    </note>काहाके जे खबर तमु सुरु गेथा ह़मळला से, तीहयी आहयी से, के आमु एक-बीजा ह़ाते मोंग करया। <verse eid="1JN 3:11" /><verse number="12" style="v" sid="1JN 3:12" />अने केन ने तेवा ना बणो जे तीहया वेरी मे गेथो हतो, अने जे आह़फा ना भाय ने मार नाखलो। अने तीहयो तीने ह़ुका मार नाखलो? आनीन करते के तीना काम गलत हता, अने तीना भाय ना काम वारु हता।<verse eid="1JN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 3:13" />ए भाय-बेन्‌या कदीम आखी कळी ना माणहु तमारी ह़ाते वेर राखे ता वहरायजो नी। <verse eid="1JN 3:13" /><verse number="14" style="v" sid="1JN 3:14" /><note caller="+" style="x"><char style="xo" closed="false">3:14 </char><char style="xt" closed="false"><ref loc="JHN 5:24">युहन्‌ना 5:24</ref></char></note>आमु जाणया, के आमु मोत सी पार हय्‌न जीवाय मे पुग जेला से; काहाके आमु भाय-बेन्‌या ह़ाते मोंग करया: जे मोंग नी करे, तीहयो मोत नी हालत मे रेय। <verse eid="1JN 3:14" /><verse number="15" style="v" sid="1JN 3:15" />जे कोय आह़फा ना भाय-बेन्‌या ह़ाते वेर राखे, तीहयो हत्‌यारो से; अने तमु जाणे ते खरा, के काना बी हत्‌यारा मे अमर जीवाय नी रेय। <verse eid="1JN 3:15" /><verse number="16" style="v" sid="1JN 3:16" />आपणु मोंग आनीत सी जाण्‌या के तीहयो आपणी जुगु आह़फा नो जीव आप देदो; अने आपणु ने बी भाय-बेन्‌या जुगु जीव आपवा जोवे। <verse eid="1JN 3:16" /><verse number="17" style="v" sid="1JN 3:17" />पण जे कोय पांह बी कळी नु धन हय अने तीहयो आह़फा ना भाय ने गरीब देखीन तीनी पोर दया नी करवा हींडे, ता तीनी मे भगवान नो मोंग कीसम बणीन रेहे? <verse eid="1JN 3:17" /><verse number="18" style="v" sid="1JN 3:18" />ए सोरा, भगवान नो बोल अने जीप सी नी, पण काम अने सच्‌चाय नी लारे बी मोंग करे।<verse eid="1JN 3:18" /></para>
  <para style="s">मोंग नी अगळ हीम्‌मत</para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 3:19" />आनीत सी आपणु जाणहु, के आमु सच्‌चाय ना से; अने जत्‌यार बी आपणु मन आपणु ने गुनो लगाड़हे, तीना बारा मे आपणु तीनी अगळ आपणा-आपणा मन ने हीम्‌मत आप सकहु। <verse eid="1JN 3:19" /><verse number="20" style="v" sid="1JN 3:20" />कदीम आपणु मन आपणो वाक काडे, ता आमु जाणया के भगवान आपणा मन गेथो मोटो से; अने आखु कंय जाणे। <verse eid="1JN 3:20" /><verse number="21" style="v" sid="1JN 3:21" />ए मोंगाळ्‌ळा, कदीम आपणु मन आपणु ने गुनो नी लगाड़े, ता आपणु ने भगवान नी अगळ हीम्‌मत जड़े। <verse eid="1JN 3:21" /><verse number="22" style="v" sid="1JN 3:22" />अने जे कंय आमु मांगया, तीहयु आमने तीनी पांह गेथु जड़े; काहाके आपणु तीना हुकम ने मानया; अने जे तीने गमे तीहयु करया। <verse eid="1JN 3:22" /><verse number="23" style="v" sid="1JN 3:23" /><note caller="+" style="x"><char style="xo" closed="false">3:23 </char><char style="xt" closed="false"><ref loc="JHN 13:34">युहन्‌ना 13:34</ref>; <ref loc="JHN 15:12">15:12</ref>,<ref loc="JHN 15:17">17</ref></char></note>अने तीना हुकम आहया से के आमु तीना सोरा ईसु मसी ना नाम पोर भरहो करया अने जेम तीहयो आपणु ने हुकम आपलो से तीनात अनसारे आखा ह़ाते मोंग राखे। <verse eid="1JN 3:23" /><verse number="24" style="v" sid="1JN 3:24" />अने जे भगवान ना हुकम ने माने, तीहयो भगवान मे, अने भगवान तीनी मे बणीन रेय: अने आनी सी, मतलब तीहयी आत्‌मा सी जे तीहयो आपणु ने आपलो से, आपणु जाणया, के तीहयो आपणी मे बणीन रेय।<verse eid="1JN 3:24" /></para>
  <chapter eid="1JN 3" />
  <chapter number="4" style="c" sid="1JN 4" />
  <para style="s">भगवान नी आत्‌मा अने वीटळ्‌ळी आत्‌मा</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 4:1" />ए मोंगाळ्‌ळा भायु, आखी आत्‌मा पोर भरहो ना करो: पण आखी आत्‌मा ने पारखो, के तीहयी भगवान ने तां गेथी से के नी हय; काहाके ढेरेत झुटा भगवान वगे गेथी वात केण्‌या माणहु कळी मे नीकळ पड़ला से। <verse eid="1JN 4:1" /><verse number="2" style="v" sid="1JN 4:2" />भगवान नी आत्‌मा तमु आहयी रीते ओळख सकत्‌ला, के जे कोय आत्‌मा मान लेय, के ईसु मसी डील मे हय्‌न आवलो से तीहयी भगवान ने तां गेथी से। <verse eid="1JN 4:2" /><verse number="3" style="v" sid="1JN 4:3" />अने जे कोय आत्‌मा ईसु ने नी माने, तीहयी भगवान ने तां गेथी नी हय; अने तीहयीत ते मसी ना वीरोद नी आत्‌मा से; जीना बारा मे तमु ह़मळी र्‌या, के तीहयो आव्‌वा वाळो से: अने हमणे बी आहयी कळी मे से।<verse eid="1JN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="1JN 4:4" />ए सोरा, तमु भगवान ना से: अने तमु तीनी पोर जीक जेला से; काहाके जे तमारी मे से तीहयु तीनी सी जे कळी मे से, मोटो से। <verse eid="1JN 4:4" /><verse number="5" style="v" sid="1JN 4:5" />तीहया आहयी कळी ना से, करीन तीहया आहयी कळी नी वात बोले, अने कळी ना माणहु तीमनी ह़मळे। <verse eid="1JN 4:5" /><verse number="6" style="v" sid="1JN 4:6" />आमु भगवान ना से: जे भगवान ने जाणे, तीहया आपणी ह़मळे; अने जे भगवान ने नी जाणे तीहया आपणी नी ह़मळे; आहयीत रीते आपणु सच्‌चाय नी आत्‌मा ने अने भटकाड़वा वाळी आत्‌मा ने ओळख लीया।<verse eid="1JN 4:6" /></para>
  <para style="s">भगवान मोंग से</para>
  <para style="p">
    <verse number="7" style="v" sid="1JN 4:7" />ए मोंगाळ्‌ळा, आपणु एक-बीजा ह़ाते मोंग राखो; काहाके मोंग भगवान भणी गेथो से: अने जे कोय मोंग करे, तीहयो भगवान सी पयदा हयलो से; अने भगवान ने जाणे। <verse eid="1JN 4:7" /><verse number="8" style="v" sid="1JN 4:8" />जे मोंग नी करे, तीहयो भगवान ने नी जाणतो, काहाके भगवान मोंग से। <verse eid="1JN 4:8" /><verse number="9" style="v" sid="1JN 4:9" />जे मोंग भगवान आपणी ह़ाते कर र्‌यो, तीहयु आनी सी उजन्‌तु हयु, के भगवान आह़फा ना एक-खोळ्‌या सोरा ने आहयी कळी मे मोकल्‌लो से, के आमु तीनी लारे जीवाय हात करया। <verse eid="1JN 4:9" /><verse number="10" style="v" sid="1JN 4:10" />मोंग आनी सी नी के आमु भगवान ह़ाते मोंग कर्‌या, बाखीन आनी मे से के भगवान अमारी सी मोंग कर्‌यो, अने अमारा पापु ना पछतावा ना जुगु आह़फा ना सोरा ने मोकल्‌यो।<verse eid="1JN 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1JN 4:11" />ए मोंगाळ्‌ळा, जत्‌यार भगवान आपणी सी एवो मोंग कर्‌यो, ता आपणु ने बी एक-बीजा ने मोंग करवा जोवे। <verse eid="1JN 4:11" /><verse number="12" style="v" sid="1JN 4:12" /><note caller="+" style="x"><char style="xo" closed="false">4:12 </char><char style="xt" closed="false"><ref loc="JHN 1:18">युहन्‌ना 1:18</ref></char></note>भगवान ने कारु बी कोय नी देख्‌यु; कदीम आपणु एक-बीजा ह़ाते मोंग करया, ता भगवान आपणी मे बणीन रेय; अने तीनो मोंग आपणी मे पुरो हय जेलो से।<verse eid="1JN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 4:13" />आनी सी आपणु जाणया, के आपणु तीनी मे बणीन रीया, अने तीहयो आपणी मे, काहाके तीहयो तीनी आत्‌मा आपणु ने आप देदलो से। <verse eid="1JN 4:13" /><verse number="14" style="v" sid="1JN 4:14" />अने आपणु देख बी लेदा अने गवाय दीया, के बाह बेटा ने आहयी कळी नो छुटकारो आपवा वाळो बणावीन मोकल्‌लो से। <verse eid="1JN 4:14" /><verse number="15" style="v" sid="1JN 4:15" />जे कोय आहयु मान लेय, के ईसु भगवान नो सोरो से: भगवान तीनी मे बणीन रेय, अने तीहयो भगवान मे बणीन रेय।<verse eid="1JN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 4:16" />अने जे मोंग भगवान आपणी सी करे, तीने आपणु जाण ज्‌या, अने आमने तीनो भरहो से; भगवान मोंग से: जे मोंग मे बणीन रेय, तीहयो भगवान मे बणीन रेय; अने भगवान तीनी मे बणीन रेय। <verse eid="1JN 4:16" /><verse number="17" style="v" sid="1JN 4:17" />आनी सी मोंग आपणी मे पुरु हयु, के आमु नीयाव ना दाड़े हीम्‌मत राख सकया; काहाके जेम मसी से तेमेत आमु बी आहयी कळी मे से। <verse eid="1JN 4:17" /><verse number="18" style="v" sid="1JN 4:18" />मोंग मे बीक नी रेय, पण पुरो मोंग बीक ने सेटो कर देय, काहाके बीक सी डंड नी सण्‌का रेय, अने जे बीहे, तीहयो मोंग मे पक्‌को नी हयो।<verse eid="1JN 4:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 4:19" />आमु आनीन करते मोंग करया, के पेले तीहयो आपणी ह़ाते मोंग कर्‌यो। <verse eid="1JN 4:19" /><verse number="20" style="v" sid="1JN 4:20" />कदीम कोय केय, के मे भगवान सी मोंग करु; अने आह़फा ना भाय सी वेर राखे; ता तीहयो झुटो से: काहाके जे आह़फा ना भाय सी जीने तीहयो देखलो से, मोंग नी करे, ता तीहयो भगवान सी बी जीने तीहयो नी देख्‌यो, मोंग नी कर सकतो। <verse eid="1JN 4:20" /><verse number="21" style="v" sid="1JN 4:21" />करीन आपणु ने मसी सी आहयो हुकम जड़लो से, के जे कोय भगवान सी मोंग करे, तीहयो आह़फा ना भाय सी बी मोंग करे।<verse eid="1JN 4:21" /></para>
  <chapter eid="1JN 4" />
  <chapter number="5" style="c" sid="1JN 5" />
  <para style="s">कळी पोर जीक</para>
  <para style="p">
    <verse number="1" style="v" sid="1JN 5:1" />जीनो आहयो भरहो से के ईसुत मसी से, तीहयो भगवान सी पयदा हयलो से; अने जे कोय पयदा करवा वाळा सी मोंग राखे, तीहयो तीनी ह़ाते बी मोंग राखे जे तीनी सी पयदा हयलो से। <verse eid="1JN 5:1" /><verse number="2" style="v" sid="1JN 5:2" />जत्‌यार आमु भगवान सी मोंग करया, अने तीना हुकम ने मानया, ता आनी सी आमु जाणया, के भगवान नी अवल्‌यात सी मोंग करया। <verse eid="1JN 5:2" /><verse number="3" style="v" sid="1JN 5:3" /><note caller="+" style="x"><char style="xo" closed="false">5:3 </char><char style="xt" closed="false"><ref loc="JHN 14:15">युहन्‌ना 14:15</ref></char></note>अने भगवान नो मोंग आहयो से, के आमु तीना हुकम ने मानया; अने तीना हुकम काठा नी हय। <verse eid="1JN 5:3" /><verse number="4" style="v" sid="1JN 5:4" />काहाके जे कंय भगवान सी पयदा हयलु से, तीहयो कळी ने जीक लेय; अने तीहयी जीक जीनी सी कळी ने जीक लेय तीहयो अमारो भरहो से। <verse eid="1JN 5:4" /><verse number="5" style="v" sid="1JN 5:5" />कळी ने जीकवा वाळो कोय से? तीहयोत के जीनो आहयो भरहो से के ईसु, भगवान नो सोरो से।<verse eid="1JN 5:5" /></para>
  <para style="s">ईसु मसी ना बारा मे गवाय</para>
  <para style="p">
    <verse number="6" style="v" sid="1JN 5:6" />आहयोत से तीहयो, जे पाणी अने लोय नी लारे आवलो; मतलब ईसु मसी: तीहयो पाणी नी लारे नी, पण पाणी अने लोय बेम नी लारे आवलो से; अने आहयी आत्‌मा से, जे गवाय देय काहाके आत्‌मा खरली से। <verse eid="1JN 5:6" /><verse number="7" style="v" sid="1JN 5:7" />अने जे गवाय देय, तीहयी आत्‌मा से; काहाके आत्‌मा खरली से। <verse eid="1JN 5:7" /><verse number="8" style="v" sid="1JN 5:8" />अने गवाय देवा वाळा तीन से; आत्‌मा, पाणी, अने लोय; अने तीनोव एक वात पोर राजी से। <verse eid="1JN 5:8" /><verse number="9" style="v" sid="1JN 5:9" />जत्‌यार आमु माणहु नी गवाय मान लीया, ता भगवान नी गवाय तीनी गेथी बड़ीन से; अने भगवान नी गवाय आहयी से, के तीहयो आह़फा ना सोरा ना बारा मे गवाय देदलो से। <verse eid="1JN 5:9" /><verse number="10" style="v" sid="1JN 5:10" />जे भगवान ना सोरा पोर भरहो करे, तीहयो आह़फा ना मन मे गवाय राखे; जे भगवान पोर भरहो नी करे, तीहयो तीने झुटो ठेरावलो से; काहाके तीहयो ते गवाय पोर भरहो नी कर्‌यो, जे गवाय भगवान आह़फा ना सोरा ना बारा मे देदलो से। <verse eid="1JN 5:10" /><verse number="11" style="v" sid="1JN 5:11" /><note caller="+" style="x"><char style="xo" closed="false">5:11 </char><char style="xt" closed="false"><ref loc="JHN 3:36">युहन्‌ना 3:36</ref></char></note>अने तीहयी गवाय आहयी से, के भगवान आपणु ने अमर जीवाय आपलो से: अने आहयी जीवाय तीना सोरा ईसु मसी मे से। <verse eid="1JN 5:11" /><verse number="12" style="v" sid="1JN 5:12" />जीनी पांह ईसु से, तीनी पांह जीवाय से; अने जीनी पांह भगवान नो सोरो ईसु मसी नी हय तीनी पांह जीवाय बी नी हय।<verse eid="1JN 5:12" /></para>
  <para style="s">अमर जीवाय</para>
  <para style="p">
    <verse number="13" style="v" sid="1JN 5:13" />मे तमारी जुगु, जे भगवान ना सोरा ना नाम पोर भरहो कर र्‌या, आनीन करते लीख र्‌यो; के तमु जाण जावो, के अमर जीवाय तमारी से। <verse eid="1JN 5:13" /><verse number="14" style="v" sid="1JN 5:14" />भगवान ना बारा मे अमारो भरहो आहयो से: जत्‌यार आमु तीनी मरजी नी अनसारे कंय मांगया, ता तीहयो तीने ह़मळे। <verse eid="1JN 5:14" /><verse number="15" style="v" sid="1JN 5:15" />अने जत्‌यार आमु जाणया, के जे कंय आमु मांगया तीहयो अमारी ह़मळी लेय, ता आमु आहयु बी जाणया के जे कंय आमु तीनी सी मांग्‌या तीहयु आमने जड़ ज्‌यु।<verse eid="1JN 5:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="1JN 5:16" />कदीम कोय आह़फा ना भाय अने बेनेह ने आसम पाप करते देखे, जीनो फोळ मोत नी हय, ता वीन्‌ती करो, अने भगवान तीने तीनी जुगु जे एवो पाप करला से जीनो फोळ मोत नी हय, जीवाय आपहे: पाप एवो बी रेय जीनो फोळ मोत से। तीना बारा मे मे वीन्‌ती करवा नी केतो <verse eid="1JN 5:16" /><verse number="17" style="v" sid="1JN 5:17" />आखी भाती नो अधरम ते पाप से, पण एवो पाप बी से, जीनो फोळ मोत नी हय।<verse eid="1JN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1JN 5:18" />आमने मालम से, के जे भगवान सी पयदा हयला से, तीहया पाप नी करे; जे भगवान सी पयदा हयला से, तीने तीहयो बचाड़ीन राखे: अने तीहयो वेरी तीने छीमी नी सके।<verse eid="1JN 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="1JN 5:19" />आमने मालम से, के आमु भगवान भणी गेथा से, अने आखी कळ तीहया वेरी ना हक मे पड़ र्‌यी।<verse eid="1JN 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1JN 5:20" />अने आहयु बी जाणया, के भगवान नो सोरो आय लागलो से अने तीहयो आमने ह़मज आपलो से, के आमु तीहया खरला भगवान ने ओळख्‌या, अने आमु तीनी मे से जे खरलो भगवान से, मतलब भगवान ना सोरा ईसु मसी मे रीया: खरलो भगवान अने अमर जीवाय आहयोत से।<verse eid="1JN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1JN 5:21" />ए सोरा, आह़फाम ने मुरत्‌या सी बचाड़ीन राखो।<verse eid="1JN 5:21" /></para>
  <chapter eid="1JN 5" />
</usx>