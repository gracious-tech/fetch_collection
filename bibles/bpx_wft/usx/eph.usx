<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="EPH" style="id">- Paliya</book>
  <para style="h">ईफीसीयो</para>
  <para style="toc3">ईफीसीयो</para>
  <para style="toc2">ईफीसीयो</para>
  <para style="toc1">ईफीसीयो ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="mt2">ईफीसीयों के नाम पोलुस की पत्री</para>
  <para style="mt1">ईफीसीयो ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">मसी ना पयदा हयवा ना 60 साल पेले आहयी ईफीसीयो नी चीट्‌ठी कुलुसीयो नी चीट्‌ठी ह़ाते लीखली हती। पोलुस आहयी ओळखाण आपे के आहयी चीट्‌ठी नो लीखवा वाळो से। <char style="xt"><ref loc="EPH 1:1">1:1</ref></char> कुलुसीयो नी चीट्‌ठी नी तेम आहयी चीट्‌ठी मे हरेक नी रखवाळी नी हये, ते बी ढेरेत जानकार नु आहयु मान्‌नु से के पोलुसेत आहयी चीट्‌ठी लीखी होहे। आहया कारण सी परदेस नी अलग-अलग मंडळी मे आहयी चीट्‌ठी फीरवीन भणे, आहयु पोलुस नु वीच्‌यार हय सके। जत्‌यार तीहयो आहयी चीट्‌ठी लीख्‌यो ता पोलुस देखाड़े के तीहयो ता जेल मे हतो। <char style="xt"><ref loc="EPH 3:1">3:1</ref>; <ref loc="EPH 4:1">4:1</ref>; <ref loc="EPH 6:20">6:20</ref></char> तुखीकुस ईफीसीयो नी मंडळी ने मळवा ईफीसुस जवा बाज र्‌यो हतो ता आहयी चीट्‌ठी पोलुस तीना हात सी ली मोकल्‌यो <char style="xt"><ref loc="EPH 6:21-22">6:21-22</ref></char>।</para>
  <para style="ip">ईफीसीयो घणु मोटु ह़ेर हतु, तीहयी टेमे एसीयामायनर नी राजधानी हती। तीहया ह़ेर मे अरतीमीस नाम नु देवता हतु जीनी कारण सी ईफीसीयो सी तीने घणी ईज्‌जत जड़ी <char style="xt"><ref loc="ACT 19:23-31">नेवताळा ना काम 19:23-31</ref></char> आहयी ईफीसीयो नी मंडळी घणी ज्‌योरे सुरु हयी पण अळतेण तीहयी कमजोर हयती देखाव पड़ी <char style="xt"><ref loc="REV 2:1-7">परकासीतवाक्‌य 2:1-7</ref></char> भगवान आपणा माणहु ने नेवाड़ीन मसी ईसु नी लारे कीसम तीमना पापु सी सोड़ायो आहयु पोलुस चीट्‌ठी ना पेला वाटा मे उजन्‌तो करे। तीहयी मंडळी नी बराबरी तीहया डील सी करतलो से जीनो मुंडु मसी से, अने तीहयी हवेली सी करे जीना खुणा नो दगड़ो मसी से। चीट्‌ठी ना बीजा वाटा मे पोलुस मसी जीवाय कीसम जीव्‌वा जोवे तीना बारा मे ह़ीकाड़े।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पोलुस खुद ना बारा मे देखाड़ीन ईफीसीयो ने वारला से के केय। <char style="ior"><ref loc="EPH 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. अळतेण तीहयो मंडळी नो रीस्‌तो मसी सी कीसम हयवा जोवे उजन्‌तु करे। <char style="ior"><ref loc="EPH 1:3">1:3</ref>; <ref loc="EPH 3:21">3:21</ref></char></para>
  <para style="io1">3. अळतेण पोलुस मसी माणहु कीकम जीवे तीनी वाट देखाड़े। <char style="ior"><ref loc="EPH 4:1-6:20">4:1–6:20</ref></char></para>
  <para style="io1">4. पोलुस आखरी बोल कीन चीट्‌ठी बंद करे। <char style="ior"><ref loc="EPH 6:21-24">6:21-24</ref></char></para>
  <chapter number="1" style="c" sid="EPH 1" />
  <para style="p">
    <verse number="1" style="v" sid="EPH 1:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:1 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 18:19-21">नेवताळा ना काम 18:19-21</ref>; <ref loc="ACT 19:1">19:1</ref></char>
    </note>पोलुस ने तां गेथी जे भगवान नी मरजी सी ईसु मसी नो नेवताळो से, तीहया चोखला अने मसी ईसु मे भरहो करवा वाळा माणहु ना नामे जे ईफीसुस ह़ेर मे से:<verse eid="EPH 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="EPH 1:2" />अमारा बाह भगवान अने मालीक ईसु मसी नी भणी गेथा तमने संयबरकत अने सांती जड़ती रेय।<verse eid="EPH 1:2" /></para>
  <para style="s">मसी मे आत्‌मा नी बरकत</para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 1:3" />अमारा मालीक ईसु मसी ना भगवान अने बाह ने घणो वारु से केम के तीहयो आमने मसी मे ह़रग वाळी आखा भाती नी आत्‌मा नी बरकत आपलो से। <verse eid="EPH 1:3" /><verse number="4" style="v" sid="EPH 1:4" />जीसम तीहयो आपणु ने कळी ने बणाव्‌वा नी पेले तीनी मे आपणु ने टाळ लेदलो के आपणु तीनी ह़ाते मोंग मे चोखला अने वण-गुनाळ्‌ळा रीया। <verse eid="EPH 1:4" /><verse number="5" style="v" sid="EPH 1:5" />अने आह़फा नी मरजी ना भला मकसत नी अनसारे आमु ने आह़फा जुगु पेले गेथो टाळ्‌यो के ईसु मसी नी लारे आमु तीना सोरा बणवा करीन टाळलो से। <verse eid="EPH 1:5" /><verse number="6" style="v" sid="EPH 1:6" />के तीनी तीहयी संयबरकत नी बड़ाय नी बड़ाय हये, जीने तीहयो आमने तीना मोंगाळ्‌ळा सोरा नी लारे घण-जबर आप्‌यो। <verse eid="EPH 1:6" /><verse number="7" style="v" sid="EPH 1:7" /><note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 1:14">कुलुस्‌यो 1:14</ref></char></note>आमने तीनी मे तीना लोय नी लारे छुटकारो, मतलब गुना नी माफी, तीनी तीहयी संयबरकत ना धन नी अनसारे जड़ली से,<note caller="+" style="x"><char style="xo" closed="false">1:7 </char><char style="xt" closed="false"><ref loc="COL 1:14">कुलुस्‌यो 1:14</ref></char></note> <verse eid="EPH 1:7" /><verse number="8" style="v" sid="EPH 1:8" />जीने तीहयो आखी अक्‌कल अने ह़मज भेळ अमारी पोर घण-जबर कर्‌यो। <verse eid="EPH 1:8" /><verse number="9" style="v" sid="EPH 1:9" />काहाके तीहयो आह़फा नी मरजी नी ह़तायली वात तीहया भली मरजी नी अनसारे आमने देखाड़्‌यो, जीने तीहयो आह़फा मे ठान लेदलो हतो। <verse eid="EPH 1:9" /><verse number="10" style="v" sid="EPH 1:10" />भगवान नी योजना नी अनसारे, टेम पुरी हयवा पोर, जे कंय ह़रग मे अने जे कंय धरती पोर ना जागा मे से, आखु कंय तीहयु मसी मे एकठु करे।<verse eid="EPH 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 1:11" />मसी मे आमु बी तीनीत <verse eid="EPH 1:11" /><verse number="12" style="v" sid="EPH 1:12" />के आमु, जे मसी पोर पेले गेथा आह लगाड़ र्‌या हता, तीना बड़ाय ना बड़ाय नो कारण हये।<verse eid="EPH 1:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="EPH 1:13" />अने तीनी मे तमारी पोर बी, जत्‌यार तमु सच्‌चाय नो बोल ह़मळ्‌या जे तमारा छुटकारा नी खुस-खबर से अने जीनी पोर तमु भरहो कर्‌या, वायदो करली चोखली आत्‌मा नो सीलटप्‌पो लाग्‌यो। <verse eid="EPH 1:13" /><verse number="14" style="v" sid="EPH 1:14" />आत्‌मा आहयी वात नी गारन्‌टी से के आमने तीहयी जड़हे जे भगवान आपणा माणहु सी वायदो करलो से, अने आहयु आमने भरहो करावे के भगवान तीहया माणहु ने पुरो छुटकारो आपहे जे तीना से। के आमु तीना बड़ाय नी बड़ाय करया।<verse eid="EPH 1:14" /></para>
  <para style="s">पोलुस नी वीन्‌ती</para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 1:15" />आहया कारण सी, मे बी तीहया भरहा नी खुस-खबर ह़मळीन जे तमारी मे मालीक ईसु पोर से<note caller="+" style="f"><char style="fr" closed="false">1:15 </char><char style="ft" closed="false">नीता तमारो मोंग जे आखा चोखला माणहु ह़ाते से</char></note> अने आखा चोखला माणहु पोर मोंग उजन्‌तो से, <verse eid="EPH 1:15" /><verse number="16" style="v" sid="EPH 1:16" />तमारी जुगु भगवान ने घणो वारु से केवा नी सोड़तो, अने मारी वीन्‌ती मे तमने फोम कर्‌या करु। <verse eid="EPH 1:16" /><verse number="17" style="v" sid="EPH 1:17" />के अमारो मालीक ईसु मसी नो भगवान जे बड़ाय नो बाह से, तीहयो तमने आह़फा नी ओळखाण नी अने अक्‌कल नी आत्‌मा आप सके के तमु तीने अळी वारु रीती सी जाण सको। <verse eid="EPH 1:17" /><verse number="18" style="v" sid="EPH 1:18" />अने तमारा मन ना डोळा चोखला हये के तमु जाण लेवो के तीनी बोलाव्‌वा नी आह ह़ु से, अने भगवान ना माणहु मे तीनी पंगात ना बड़ाय नु धन केवु से। <verse eid="EPH 1:18" /><verse number="19" style="v" sid="EPH 1:19" />अने तीनी ताखत अमारी मे जे भरहो करे, केतरी मोटी से, तीनी सक्‌ती ना बदलाव ना तीहया काम नी अनसारे से। <verse eid="EPH 1:19" /><verse number="20" style="v" sid="EPH 1:20" />जे तीहयो मसी मे कर्‌यो के तीने मरला मे गेथो जीवाड़ीन ह़रग ना जागा मे जमणी ह़ोड़<note caller="+" style="x"><char style="xo" closed="false">1:20 </char><char style="xt" closed="false"><ref loc="PSA 110:1">भजन सहीता 110:1</ref></char></note> बहाड़ र्‌यो। <verse eid="EPH 1:20" /><verse number="21" style="v" sid="EPH 1:21" />मसी आखा ह़रग वाळा मुखी, हकदार्‌या, ताखत, अने डायला पोर राज करे; जे नी नीस्‌तो आहयी कळी मे पण आव्‌वा वाळी कळी मे बी तीनु नाम लेहे। <verse eid="EPH 1:21" /><verse number="22" style="v" sid="EPH 1:22" /><note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="COL 1:18">कुलुस्‌यो 1:18</ref></char></note>अने आखु कंय तीना पोगु तळे कर देदो;<note caller="+" style="x"><char style="xo" closed="false">1:22 </char><char style="xt" closed="false"><ref loc="PSA 8:6">भजन सहीता 8:6</ref> </char></note> अने तीने आखी चीज पोर डायलो ठेरावीन मंडळी मे आप देदो, <verse eid="EPH 1:22" /><verse number="23" style="v" sid="EPH 1:23" />आहयी मंडळी तीनु डील से, अने तीनुत आखु कंय से, अने जे आखु मे आखु कंय पुरु करे।<note caller="+" style="x"><char style="xo" closed="false">1:23 </char><char style="xt" closed="false"><ref loc="COL 1:18">कुलुस्‌यो 1:18</ref> </char></note><verse eid="EPH 1:23" /></para>
  <chapter eid="EPH 1" />
  <chapter number="2" style="c" sid="EPH 2" />
  <para style="s">मोत भणी गेथा जीवाय भणी</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 2:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">2:1 </char>
      <char style="xt" closed="false">
        <ref loc="COL 2:13">कुलुस्‌यो 2:13</ref>
      </char>
    </note>तीहयो तमने बी जीवाड़्‌यो, तमु आह़फा पाप अने गुना मे मरला हता, <verse eid="EPH 2:1" /><verse number="2" style="v" sid="EPH 2:2" />जीनी मे तमु पेले आहयी कळी नी रीती पोर, अने वादळा ना हकदार ना डायला मतलब तीहयी आत्‌मा नी अनसारे चालता हता, जे हजु बी हुकम नी मानवा वाळा मे काम करे। <verse eid="EPH 2:2" /><verse number="3" style="v" sid="EPH 2:3" />आमनी मे आपणु बी आखान-आखा पेले आपणा डील नी लालच मे दाड़ा काडता हता, अने डील अने मन नी मरजी पुरी करता हता, अने बीजा माणहुन तेवा वेहवार सीत रीह नी अवल्‌यात हता।<verse eid="EPH 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 2:4" />पण भगवान जे दया नो धनी से, आह़फा ना तीहया मोट्‌ला मोंग ना कारण सी तीहयो अमारी पोर मोंग कर्‌यो, <verse eid="EPH 2:4" /><verse number="5" style="v" sid="EPH 2:5" />जत्‌यार आमु गुना ना कारण सी मरला हता ता आमने मसी ह़ाते जीवाड़्‌यो दया सीत तमारो छुटकारो हयलो से।<note caller="+" style="x"><char style="xo" closed="false">2:5 </char><char style="xt" closed="false"><ref loc="COL 2:13">कुलुस्‌यो 2:13</ref> </char></note> <verse eid="EPH 2:5" /><verse number="6" style="v" sid="EPH 2:6" />अने मसी ईसु मे तीनी ह़ाते बठो कर्‌यो, अने ह़रग ना जागा मे तीनी ह़ाते बहाड़्‌यो। <verse eid="EPH 2:6" /><verse number="7" style="v" sid="EPH 2:7" />के तीहयो आह़फा नी तीहयी दया सी जे मसी ईसु मे अमारी पोर से, आव्‌वा वाळी टेम मे आपणी दया नु गणाय नी एतरु धन देखाड़ सके। <verse eid="EPH 2:7" /><verse number="8" style="v" sid="EPH 2:8" />काहाके भरहा ना लारे दया सीत तमु बचला से, काहाके तमारी लारे नी हयु, पण आहयु भगवान नो ईलाम से, <verse eid="EPH 2:8" /><verse number="9" style="v" sid="EPH 2:9" />अने आहयु तमारा कामु नो फोळ नी हय, के कोय मोटाय करे। <verse eid="EPH 2:9" /><verse number="10" style="v" sid="EPH 2:10" />काहाके आमु तीना बणावला से, अने मसी ईसु मे तीहया भलाय ना कामु ने लेदे बणावला जीने भगवान पेले गेथो आमु करहु करीन तीयार करलो से।<verse eid="EPH 2:10" /></para>
  <para style="s">मसी मे एक</para>
  <para style="p">
    <verse number="11" style="v" sid="EPH 2:11" />करीन फोम करो के तमु जे डील नी रीती सी आड़जात्‌या से; अने जे माणहु डील मे हात वेर करला खतना सी खतना वाळा केवाड़े, तीहया तमने खतना वगर ना केय। <verse eid="EPH 2:11" /><verse number="12" style="v" sid="EPH 2:12" />तमु तीहयी टेमे मसी सी अलग, अने ईस्‌रायली नी पाल्‌टी ना वाटा ना जागा सी अलग करला, अने वायदा नी बोली वगर हता, आह वगर हता अने कळी मे भगवान वगर हता। <verse eid="EPH 2:12" /><verse number="13" style="v" sid="EPH 2:13" />पण हाव मसी ईसु मे तमु जे पेले सेटा हता, मसी ना लोय नी लारे ह़ाते हय जेला से। <verse eid="EPH 2:13" /><verse number="14" style="v" sid="EPH 2:14" />काहाके तीहयोत अमारो मेळ से, जे बेम ने एक कर लेदो अने अलग करवा वाळु भीतड़ु ने जे वच मे हतु ढबळाय नाख्‌यो। <verse eid="EPH 2:14" /><verse number="15" style="v" sid="EPH 2:15" />अने आह़फा ना डील मे वेरी, मतलब तीहया कायदा, जीना हुकम नेम नी रीती पोर हता, मीटाड़ नाख्‌यो के बेम सी आह़फा मे एक नवलु माणहे ने उबजाड़ीन मेळ कराय देय,<note caller="+" style="x"><char style="xo" closed="false">2:15 </char><char style="xt" closed="false"><ref loc="COL 2:14">कुलुस्‌यो 2:14</ref></char></note> <verse eid="EPH 2:15" /><verse number="16" style="v" sid="EPH 2:16" />अने ईसु कुरुस पोर आंबा-सांबा झगड़ा नी खार ने खत्‌तम करीन आनी लारे बेम ने एक डील बणावीन भगवान ह़ाते भेटाड़्‌यो।<note caller="+" style="x"><char style="xo" closed="false">2:16 </char><char style="xt" closed="false"><ref loc="COL 1:20">कुलुस्‌यो 1:20</ref></char></note> <verse eid="EPH 2:16" /><verse number="17" style="v" sid="EPH 2:17" />तीहयो आवीन तमने जे सेटा हता अने तीमने जे ह़ाते हता, बेमोव ने सांती नी खुस-खबर ह़मळायो अने बेमोव ने सांती जड़ी।<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="ISA 57:19">यसाया 57:19</ref></char></note> <verse eid="EPH 2:17" /><verse number="18" style="v" sid="EPH 2:18" />काहाके तीनीत लारे आपणु बेम जणा ह़ाते एक आत्‌मा नी लारे बाह अमारीन्‌तां पुग्‌यो।<verse eid="EPH 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="EPH 2:19" />करीन तमु हाव बीजा देस वाळा अने अंजाण्‌या नी र्‌या, पण चोखला माणहु नी ह़ाते तीना देस वाळा अने भगवान ना घोराणा ना माणहु बण जेला से। <verse eid="EPH 2:19" /><verse number="20" style="v" sid="EPH 2:20" />तमु बी नेवताळा अने भगवान वगे गेथा खबर लावण्‌या नी नीव पोर बणला से, जीना खुणा नो दगड़ो खुद मसी ईसु से। <verse eid="EPH 2:20" /><verse number="21" style="v" sid="EPH 2:21" />जीनी मे आखु बणावणु मेळीन मालीक नी जुगु चोखलो मंदीर हयवा नी करते बड़ता जाय। <verse eid="EPH 2:21" /><verse number="22" style="v" sid="EPH 2:22" />जीनी मे तमु बी आत्‌मा नी लारे भगवान नो रेवा नो जागो बणवा करीन एक्‌ठा बणावला से।<verse eid="EPH 2:22" /></para>
  <chapter eid="EPH 2" />
  <chapter number="3" style="c" sid="EPH 3" />
  <para style="s">आड़जात्‌या मे पोलुस नी सेवा</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 3:1" />आना कारण सी मे पोलुस जे तमु आड़जात्‌या जुगु मसी ईसु नो धरायलो से <verse eid="EPH 3:1" /><verse number="2" style="v" sid="EPH 3:2" />कदीम तमु भगवान नी तीहयी संयबरकत नी जुगाड़ नी खुस-खबर ह़मळ्‌या हय, जे तमारी जुगु मने आपली से, <verse eid="EPH 3:2" /><verse number="3" style="v" sid="EPH 3:3" />मतलब आहयु के तीहयी ह़तायली वात मारी पोर वीजाळु नी लारे उजन्‌ती हयी, जीसम मे पेलेत कम करीन लीख नाखलो से, <verse eid="EPH 3:3" /><verse number="4" style="v" sid="EPH 3:4" /><note caller="+" style="x"><char style="xo" closed="false">3:4 </char><char style="xt" closed="false"><ref loc="COL 1:26">कुलुस्‌यो 1:26</ref>,<ref loc="COL 1:27">27</ref></char></note>जीनी सी तमु भणीन जाण सकत्‌ला के मे मसी नी तीहयी ह़तायली वात कां तक ह़मजु। <verse eid="EPH 3:4" /><verse number="5" style="v" sid="EPH 3:5" />वीतली टेम मे माणहु ने आहयी खास वात नी देखाड़लु हतु, पण भगवान आत्‌मा नी लारे हाव तीना चोखला नेवताळा अने भगवान वगे गेथा खबर लावण्‌या पोर उजन्‌तो करलो से। <verse eid="EPH 3:5" /><verse number="6" style="v" sid="EPH 3:6" />खास वात आहयी से के मसी ईसु मे खुस-खबर नी लारे आड़जात्‌या माणहु भगवान नी बरकत मे युहदी माणहु ह़ाते अने वायदा ना साजल्‌या से।<note caller="+" style="f"><char style="fr" closed="false">3:6 </char><char style="ft" closed="false">कुलुसीयो 1:26,27 </char></note><verse eid="EPH 3:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 3:7" />मे भगवान नी तीहयी संयबरकत ना दान नी अनसारे, जे तीनी ताखत ना बदलाव नी अनसारे मने आपलो से, तीहयी खुस-खबर नो चाकर्‌यो बण्‌यो। <verse eid="EPH 3:7" /><verse number="8" style="v" sid="EPH 3:8" />मारी पोर जे आखा चोखला माणहु मे सी नान्‌ला मे सी नान्‌लो से, आहयी संयबरकत हयी के मे आड़जात्‌या ने मसी नु वीणछेव्‌यु धन नी खुस-खबर ह़मळावु, <verse eid="EPH 3:8" /><verse number="9" style="v" sid="EPH 3:9" />अने आखा पोर आहयी वात उजन्‌ती करु के तीहयी ह़तायली योजना ने कीसम लागु करवा। जे आखा नो बणाव्‌वा वाळो भगवान से, तीहयो हमेसा नी योजना गेथोत खास वात ने ह़ताड़ीन राखलो से। <verse eid="EPH 3:9" /><verse number="10" style="v" sid="EPH 3:10" />के हाव मंडळी नी लारे, भगवान नी भात-भाती नी अक्‌कल ने तीहया मुख्‌या अने हकदार्‌या पोर जे ह़रग ना जागा मे से, तीमने देखाड़ सको। <verse eid="EPH 3:10" /><verse number="11" style="v" sid="EPH 3:11" />हमेसा नी योजना ना अनसारे आसम कर्‌यो, जे तीहयो आपणा मालीक ईसु मसी मे टाकलो हतो। <verse eid="EPH 3:11" /><verse number="12" style="v" sid="EPH 3:12" />जीनी मे आमने तीनी पोर भरहो करवा सी हीम्‌मत अने भरहो भेळ भगवान नी ह़ाते जवा नो हक से। <verse eid="EPH 3:12" /><verse number="13" style="v" sid="EPH 3:13" />करीन मे रावण्‌या करु के जे दुख तमारी जुगु मने हय र्‌या, तीमना कारण सी हीम्‌मत ना सोड़ो, काहाके तीमनी मे बड़ाय तमारी से।<verse eid="EPH 3:13" /></para>
  <para style="s">मसी नो मोंग</para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 3:14" />मे आहयात कारण सी तीहया बाह अगळ मांडा टेकु, <verse eid="EPH 3:14" /><verse number="15" style="v" sid="EPH 3:15" />जीनी सी ह़रग अने धरती पोर ना जागा मे, एक-एक<note caller="+" style="f"><char style="fr" closed="false">3:15 </char><char style="ft" closed="false">नीता आखा</char></note> घोराणा ना नाम पाड़े, <verse eid="EPH 3:15" /><verse number="16" style="v" sid="EPH 3:16" />मे वीन्‌ती करु के तीहयो आह़फा ना बड़ाय ना धन ना अनसारे तमने आहयु दान आपे के तमु तीनी आत्‌मा सी आपणा मोय वाळा माणेह मे ताखत हात करीन जोरभर्‌या हयता जावो; <verse eid="EPH 3:16" /><verse number="17" style="v" sid="EPH 3:17" />अने भरहा नी लारे मसी तमारा मन मे वहे। अने मे वीन्‌ती करु के तमु मोंग मे जेड़ धरीन अने नीव नाखीन, <verse eid="EPH 3:17" /><verse number="18" style="v" sid="EPH 3:18" />आखा चोखला माणहु ह़ाते आखी भाते ह़मजवा नी सक्‌ती हात करो के तीनी चवड़ाय, अने लम्‌बाय, अने उचाय, अने उन्‌डाय केतरी से। <verse eid="EPH 3:18" /><verse number="19" style="v" sid="EPH 3:19" />के तमु मसी ना तीहया मोंग ने जाण सको जे अमारी ह़मज सी बाहर से, अने एतरे तमने पुरी रीती सी भगवान ना सोभाव सी भराय्‌न रेवु जोवे।<verse eid="EPH 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 3:20" />हाव जे एवो ताखत वाळो से के अमारी वीन्‌ती अने ह़मज सी कंय जादा काम कर सके, तीहयी ताखत ना अनसारे जे अमारी मे काम करे, <verse eid="EPH 3:20" /><verse number="21" style="v" sid="EPH 3:21" />मंडळी मे अने मसी ईसु मे तीनी बड़ाय जलमकी हयती रेय। आमीन।<verse eid="EPH 3:21" /></para>
  <chapter eid="EPH 3" />
  <chapter number="4" style="c" sid="EPH 4" />
  <para style="s">मसी ना डील मे एक्‌को</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 4:1" />एतरे मे जे मालीक जुगु धराय र्‌यो अने तमने देखाड़ु के जे बोलाव्‌वा सी तमने बोलावला से, तीनी लायक जीवाय जीवो। <verse eid="EPH 4:1" /><verse number="2" style="v" sid="EPH 4:2" /><note caller="+" style="x"><char style="xo" closed="false">4:2 </char><char style="xt" closed="false"><ref loc="COL 3:12">कुलुस्‌यो 3:12</ref>,<ref loc="COL 3:13">13</ref></char></note>मतलब आखी नीचळाय अने भोळाय भेळ, अने धीरज सी मोंग मे एक-बीजा नी वेठ लेवो।<note caller="+" style="f"><char style="fr" closed="false">4:2 </char><char style="ft" closed="false">कुलुसीयो 3:12,13</char></note> <verse eid="EPH 4:2" /><verse number="3" style="v" sid="EPH 4:3" />अने मेळ ना जोड़ मे आत्‌मा नो एक्‌को बणाय्‌न राखवा नी कोसीत करो। <verse eid="EPH 4:3" /><verse number="4" style="v" sid="EPH 4:4" />एक डील, अने एक आत्‌मा; जीसम तमने बोलाव्‌वा नी एक आह से। <verse eid="EPH 4:4" /><verse number="5" style="v" sid="EPH 4:5" />एकीत मालीक से, एकीत भरहो, अने एकीत बपतीस्‌मा; <verse eid="EPH 4:5" /><verse number="6" style="v" sid="EPH 4:6" />अने आखा नो एकीत बाह भगवान से, जे आखा पोर अने आखा नी वच मे अने आखा मे से।<verse eid="EPH 4:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="EPH 4:7" />पण अमारी माय्‌न एक-एक जणा ने मसी ना दान ना फोळ नी अनसारे संयबरकत जड़ली से। <verse eid="EPH 4:7" /><verse number="8" style="v" sid="EPH 4:8" />जीसम चोखली सास्‌तर केय:</para>
  <para style="q1" vid="EPH 4:8">“तीहयो उचाय पोर चड़ ज्‌यो,</para>
  <para style="q2" vid="EPH 4:8">ता तीहयो कंय बंदायला ने ली ज्‌यो,</para>
  <para style="q2" vid="EPH 4:8">अने आपणा माणहु ने ईलाम आप्‌यो।”<note caller="+" style="f"><char style="fr" closed="false">4:8 </char><char style="ft" closed="false">भजन सहीता 68:18</char></note><verse eid="EPH 4:8" /></para>
  <para style="m">
    <verse number="9" style="v" sid="EPH 4:9" />“तीनु चड़वानु” आनु ह़ु मतलब से? आनु आहयु के पेले तीहयो धरती ना आखा सी हेटला जागा मे उतर्‌यो। <verse eid="EPH 4:9" /><verse number="10" style="v" sid="EPH 4:10" />ता जे हेटो उतर्‌यो आहयो तीहयोत से जे आखा वादळा गेथो उप्‌पर चड़ ज्‌यो के तीनी हजरी सी आखा ह़रग ने भरवा ना लेदे। <verse eid="EPH 4:10" /><verse number="11" style="v" sid="EPH 4:11" />तीहयो थोड़ाक ने नेवताळा, अने थोड़ाक ने भगवान वगे गेथी वात केण्‌या, अने थोड़ाक ने खुस-खबर ह़मळाव्‌वा वाळा, अने थोड़ाक ने रखवाळ्‌या अने मास्‌तर्‌या टाळीन ह़ोप देदो। <verse eid="EPH 4:11" /><verse number="12" style="v" sid="EPH 4:12" />जीनी सी भगवान ना माणहु अळी चोखला हय जाय अने सेवा नु काम करे अने मसी ना डील नी बड़ोत्‌री हय सके, <verse eid="EPH 4:12" /><verse number="13" style="v" sid="EPH 4:13" />जत्‌यार तक के आमु आखान-आखा भरहा अने भगवान ना सोरा नी ओळखाण मे एक नी हय जीया, अने एक नामह़ाद्‌यो माणहे नी बण जीया अने मसी ना पुरा डील-डोल तक नी पुग जीया। <verse eid="EPH 4:13" /><verse number="14" style="v" sid="EPH 4:14" />के आमु अगा सोरा नी तेवा नी रीया, जे दर्‌या नी झलक नी तेम एथान-एथा उसळे अने नखाय जाय अने माणहु ना धोका नी आंजी अने चतराय ना लारे वय जाय। <verse eid="EPH 4:14" /><verse number="15" style="v" sid="EPH 4:15" />पण मोंग मे सच्‌चाय सी चालता जाय्‌न आखी वातु मे जे मुंडु से, मतलब मसी मे वदता जावो, <verse eid="EPH 4:15" /><verse number="16" style="v" sid="EPH 4:16" /><note caller="+" style="x"><char style="xo" closed="false">4:16 </char><char style="xt" closed="false"><ref loc="COL 2:19">कुलुस्‌यो 2:19</ref></char></note>जीनी मे आखु डील, एक-एक जोड़ नी मदत सी एक्‌ठा मेळीन, अने एक्‌ठा हय्‌न, तीहया बदलाव नी अनसारे जे एक-एक डील ना वाटा ना वारु-वारु काम करवा नी लारे तीनी मे हये, आखु डील अगु बड़े अने मोंग नी लारे आह़फु ने बणावे।<verse eid="EPH 4:16" /></para>
  <para style="s">मसी मे नवली जीवाय</para>
  <para style="p">
    <verse number="17" style="v" sid="EPH 4:17" />मालीक ना नाम सी, अळी, मे तमने चेतावणी आपु; के तमु आड़जात्‌या नी तेम ना जीवो, तीमना वीच्‌यार बगड़ला से। <verse eid="EPH 4:17" /><verse number="18" style="v" sid="EPH 4:18" />अने तीमना मन अंदारला हय जेला से। तीमनी पांह कोय जीवाय नी हय जे भगवान आपे, काहाके तीहया पुरी रीती सी वण-अकल्‌या अने जखड़ी पड़न्‌या से। <verse eid="EPH 4:18" /><verse number="19" style="v" sid="EPH 4:19" />अने तीहया मन बेरा हय्‌न लुच्‌चाय करवा मे लाग जेला से के आखा भाती ना वीटळ्‌ळा कामु हेर सी कर्‌या करे।<verse eid="EPH 4:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="EPH 4:20" />पण तमने मसी ना बारा मे आवी ह़ीकापण नी आपली हती। <verse eid="EPH 4:20" /><verse number="21" style="v" sid="EPH 4:21" />पण तमु ह़ाचली तीनीत ह़मळ्‌या, अने जीसम ईसु मे सच्‌चाय से, तीनीत मे तमने ह़ीकाड़्‌या बी, <verse eid="EPH 4:21" /><verse number="22" style="v" sid="EPH 4:22" /><note caller="+" style="x"><char style="xo" closed="false">4:22 </char><char style="xt" closed="false"><ref loc="COL 3:9">कुलुस्‌यो 3:9</ref></char></note>के तमु पुराणा चाल-चलण ने नीकाळ देवो, जे भटकाड़वा वाळी चीज नी हेर नी अनसारे मीटतो जाय।<note caller="+" style="f"><char style="fr" closed="false">4:22 </char><char style="ft" closed="false">कुलुसीयो 3:9</char></note> <verse eid="EPH 4:22" /><verse number="23" style="v" sid="EPH 4:23" />अने आपणी आत्‌मा ना वेहवार मे नवला बणता ना लेदे, <verse eid="EPH 4:23" /><verse number="24" style="v" sid="EPH 4:24" /><note caller="+" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="COL 3:10">कुलुस्‌यो 3:10</ref></char></note>अने नवला माणहे ने पेरवा नी लेदे, सच्‌चाय ना धरमीपणा मे अने चोखलापणा मे भगवान ने तेम बणवा करीन।<note caller="+" style="f"><char style="fr" closed="false">4:24 </char><char style="ft" closed="false">उबजणाय कीताप 1:26; कुलुसीयो 3:10</char></note><verse eid="EPH 4:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 4:25" />झुट मेकवा सोड़ीन एक-एक आपणा ह़ाते वाळा ने ह़ाचली केवो, काहाके आमु आखा एक डील ना वाटा से।<note caller="+" style="f"><char style="fr" closed="false">4:25 </char><char style="ft" closed="false">जकर्‌याह 8:16</char></note> <verse eid="EPH 4:25" /><verse number="26" style="v" sid="EPH 4:26" />रीह ते करो, पण पाप ना करो; अने दाहड़ु बुड्‌ये तक तमारी रीह नी रेवा जोवे।<note caller="+" style="f"><char style="fr" closed="false">4:26 </char><char style="ft" closed="false">भजन सहीता 4:4 </char></note> <verse eid="EPH 4:26" /><verse number="27" style="v" sid="EPH 4:27" />अने भुतड़ा<note caller="+" style="f"><char style="fr" closed="false">4:27 </char><char style="ft" closed="false">ईबलीस</char></note> ने मोखो ना आपो। <verse eid="EPH 4:27" /><verse number="28" style="v" sid="EPH 4:28" />चोरी करवा वाळो पासो चोरी नी करवा जोवे, पण वारला काम करवा मे आह़फा ना हातु सी मेहनत करे, आनीन करते के तमु ईमानदार जीवाय जीव सको अने गरीब नी मदत कर सको। <verse eid="EPH 4:28" /><verse number="29" style="v" sid="EPH 4:29" />नुकसान करवा वाळा बोलु ने ना वापरो, पण नीस्‌ता भलाय करन्‌या बोलु ने वापरो, के बीजा ना लेदे संयबरकत नो कारण अने ह़मळवा वाळा ना लेदे भलु हये। <verse eid="EPH 4:29" /><verse number="30" style="v" sid="EPH 4:30" />भगवान नी चोखली आत्‌मा ने दुखी ना करो, जीनी सी<note caller="+" style="f"><char style="fr" closed="false">4:30 </char><char style="ft" closed="false">मे </char></note> तमारी पोर छुटकारा ना दाड़ा जुगु सीलटप्‌पो लगाड़ मेक्‌यो। <verse eid="EPH 4:30" /><verse number="31" style="v" sid="EPH 4:31" />आखी भाती नी कड़वाहट, बुरी लालच, रीह, लड़ाय-झगड़ा अने वाक काडवा ना आखा काम तमारा वच मे गेथा सेटा करो। <verse eid="EPH 4:31" /><verse number="32" style="v" sid="EPH 4:32" /><note caller="+" style="x"><char style="xo" closed="false">4:32 </char><char style="xt" closed="false"><ref loc="COL 3:13">कुलुस्‌यो 3:13</ref></char></note>एक-बीजा पोर दया करवा वाळा अने ह़ुमाळा बणीन रेवो, अने जेम भगवान मसी ना लारे तमारा गुना ने माफ कर्‌यो, तेमेत तमु बी एक-बीजा ना गुना ने माफ करो।<note caller="+" style="f"><char style="fr" closed="false">4:32 </char><char style="ft" closed="false">कुलुसीयो 3:13</char></note><verse eid="EPH 4:32" /></para>
  <chapter eid="EPH 4" />
  <chapter number="5" style="c" sid="EPH 5" />
  <para style="s">वीजाळु नी अवल्‌यात बणो</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 5:1" />करीन मोंगाळ्‌ळा सोरान तेम भगवान पसळ चालवा वाळा बणो, <verse eid="EPH 5:1" /><verse number="2" style="v" sid="EPH 5:2" />अने मोंग मे चालो जीसम मसी बी तमारी ह़ाते मोंग कर्‌यो, अने तीहयो अमारी जुगु भगवान अगळ आह़फा ने ह़वादली गंद ना वेह मे भेट अने बादा चड़ाय नाख्‌यो जे भगवान ने खुस करे।<note caller="+" style="f"><char style="fr" closed="false">5:2 </char><char style="ft" closed="false">नीरगमन 19:18; भजन सहीता 40:6</char></note><verse eid="EPH 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="EPH 5:3" />जीसम के चोखला माणहु जुगु वारु से, तेमेत तमारी मे छीनाळु अने काना भाती ना वीटळ्‌ळा कामु अने लालच नी वात लग नी हयवु जोवे। <verse eid="EPH 5:3" /><verse number="4" style="v" sid="EPH 5:4" />अने नी वण-लाज्‌याण, नी वण-अकल्‌याण वात कर्‌या, नी उपाह़ पाळ्‌या, काहाके आहयी वात ह़ोबा नी देय, पण भगवान ने वारु केवु जोवे। <verse eid="EPH 5:4" /><verse number="5" style="v" sid="EPH 5:5" />काहाके तमु आहयु जाणो के काना बी छीनाळ्‌या, वीटळ्‌ळा माणहु, अने लालच्‌या से, जे मुर्‌ती पुजा करवा वाळा बराबर से तीमने कदी बी मसी अने भगवान ना राज मे वाटो नी जड़े।<verse eid="EPH 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="EPH 5:6" />कोय बी तमने फाल्‌तु वातु मे धोको नी देवा जोवे, काहाके आहयात कामु ना कारण सी हुकम नी मानवा वाळा पोर भगवान नी रीह आवे। <verse eid="EPH 5:6" /><verse number="7" style="v" sid="EPH 5:7" />करीन तमु तीमना साजल्‌या ना बणो। <verse eid="EPH 5:7" /><verse number="8" style="v" sid="EPH 5:8" />काहाके तमु पेले अंदारला मे हता पण हाव मालीक मे वीजाळु से, ता तमु वीजाळु नी अवल्‌यात ने तेम चालो। <verse eid="EPH 5:8" /><verse number="9" style="v" sid="EPH 5:9" />काहाके वीजाळु <note caller="+" style="f"><char style="fr" closed="false">5:9 </char><char style="ft" closed="false">काना-काना कीताप्‌या मे आत्‌मा बोल आवलु से</char></note>नो फोळ आखी भाती नी भलाय, अने धरमपणु, अने सच्‌चाय से। <verse eid="EPH 5:9" /><verse number="10" style="v" sid="EPH 5:10" />अने आहयो पतो लगाड़ो के मालीक ने ह़ु खुस करे। <verse eid="EPH 5:10" /><verse number="11" style="v" sid="EPH 5:11" />अंदारलु ना फाल्‌तु कामु ना साजल्‌या ना बणो, पण तीमनी बुराय ने उजन्‌ती करो। <verse eid="EPH 5:11" /><verse number="12" style="v" sid="EPH 5:12" />तीमना कामु ना बारा मे ते वात करवा बी लजवायवा नी वात से, जे हुकम नी पाळवा वाळा ह़ताय्‌न करे। <verse eid="EPH 5:12" /><verse number="13" style="v" sid="EPH 5:13" />अने जत्‌यार आखा चीजु ने वीजाळा मे लावे, ता तीनो खास सोभाव पुरी रीती सी उजन्‌तो हय जाय; <verse eid="EPH 5:13" /><verse number="14" style="v" sid="EPH 5:14" />पुरी रीती सी उजन्‌ती हयवा वाळी चीज खुद वीजाळु बण जाय। आहया कारण सी तीहयो केय,</para>
  <para style="q1" vid="EPH 5:14">“ए ह़ुव्‌वा वाळा जागो,</para>
  <para style="q2" vid="EPH 5:14">अने मरला मे गेथा जीवी उठो;</para>
  <para style="q2" vid="EPH 5:14">ता मसी नु वीजाळु तमारी पोर पपलहे।”<verse eid="EPH 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="EPH 5:15" />करीन ध्‌यान सी देखो, के केवी चाल, चाल र्‌या: वण-अकल्‌या नी तेम नी पण अक्‌कल वाळा नी तेम चालो। <verse eid="EPH 5:15" /><verse number="16" style="v" sid="EPH 5:16" /><note caller="+" style="x"><char style="xo" closed="false">5:16 </char><char style="xt" closed="false"><ref loc="COL 4:5">कुलुस्‌यो 4:5</ref></char></note>आखा मोखा नो जादा सी जादा फायदो उठावो काहाके आहया दाड़ा काठला से।<note caller="+" style="f"><char style="fr" closed="false">5:16 </char><char style="ft" closed="false">कुलुसीयो 4:5</char></note> <verse eid="EPH 5:16" /><verse number="17" style="v" sid="EPH 5:17" />एतरे वण-अकल्‌या ना बणो, पण ध्‌यान सी ह़मजो के मालीक नी मरजी ह़ुं से।<verse eid="EPH 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="EPH 5:18" />ह़रु सी ना छाको, जे तमने नीस्‌तु बरबात करहे, पण चोखली आत्‌मा सी भराय जावो। <verse eid="EPH 5:18" /><verse number="19" style="v" sid="EPH 5:19" /><note caller="+" style="x"><char style="xo" closed="false">5:19 </char><char style="xt" closed="false"><ref loc="COL 3:16">कुलुस्‌यो 3:16</ref>,<ref loc="COL 3:17">17</ref></char></note>आत्‌मा सी गीत अने भजन अने बड़ाय ना गीतु सी एक-बीजा ह़ाते वात कर्‌या करो। अने आपणा मन मे मालीक ना लेदे गावता अने बड़ाय करता रेवो। <verse eid="EPH 5:19" /><verse number="20" style="v" sid="EPH 5:20" />अने हमेसा आखी चीज ना लेदे आपणा मालीक ईसु मसी ना नाम सी भगवान बाह ने घणो वारु कीया करो।<note caller="+" style="f"><char style="fr" closed="false">5:20 </char><char style="ft" closed="false">कुलुसीयो 13:16,17</char></note> <verse eid="EPH 5:20" /><verse number="21" style="v" sid="EPH 5:21" />मसी नी बीक ना कारण सी एक-बीजा नी ह़ाते रेवो।<verse eid="EPH 5:21" /></para>
  <para style="s">मसी घोराणा ना लेदे कायदा</para>
  <para style="p">
    <verse number="22" style="v" sid="EPH 5:22" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:22 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:18">कुलुस्‌यो 3:18</ref>; <ref loc="1PE 3:1">1 पतरस 3:1</ref></char>
    </note>ए लाड्‌या, आह़फा ना लाडा ने खुद ने तीसमेत ह़ोपो जीसम तमु मालीक ने ह़ोपो।<note caller="+" style="f"><char style="fr" closed="false">5:22 </char><char style="ft" closed="false">कुलुसीयो 3:18; पतरस 3:1</char></note> <verse eid="EPH 5:22" /><verse number="23" style="v" sid="EPH 5:23" />काहाके घोरवाळो घोरवाळी नु मुंडु से जीसम के मसी मंडळी नु मुंडु से अने आह़फोत डील नो छुटकारो आपण्‌यो से। <verse eid="EPH 5:23" /><verse number="24" style="v" sid="EPH 5:24" />पण मंडळी जीसम मसी ने ह़ोपे, तीसमेत लाड्‌या बी आखी वात मे खुद ना लाडा ने ह़ोपवा जोवे।<verse eid="EPH 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="EPH 5:25" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:25 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:19">कुलुस्‌यो 3:19</ref>; <ref loc="1PE 3:7">1 पतरस 3:7</ref></char>
    </note>ए लाडा, खुद नी लाडी सी मोंग करो जीसम मसी बी मंडळी सी मोंग कर्‌यो अने आह़फा ने तीना लेदे आप देदो।<note caller="+" style="f"><char style="fr" closed="false">5:25 </char><char style="ft" closed="false">कुलुसीयो 3:19; 1 पतरस 3:7</char></note> <verse eid="EPH 5:25" /><verse number="26" style="v" sid="EPH 5:26" />तीहयो आह़फा ना बोल सी मंडळी ने भगवान ना ह़ात मे ह़ोपवा ना लेदे बोल ना पाणी वेर धोय्‌न पाप गेथो अलग करीन चोखो कर देदो। <verse eid="EPH 5:26" /><verse number="27" style="v" sid="EPH 5:27" />काहाके तीहयो एक आसवी मंडळी आह़फा अगळ उबी करवा हींडतो हतो जे घटाळी हय, जीनी मे नी डाग हय, नी चीमायली अने नी कोय बीजो गुनो हय, पण जे चोखली अने वण-गुनाळ्‌ळी हय। <verse eid="EPH 5:27" /><verse number="28" style="v" sid="EPH 5:28" />के लाडा ने खुद नी लाडी सी तीसमेत मोंग करवु जोवे। जीसम तीहयो आह़फा ना डील ने करे। एक अदमी जे खुद नी लाडी ने मोंग करे तीहयो आह़फा सी मोंग करे। <verse eid="EPH 5:28" /><verse number="29" style="v" sid="EPH 5:29" />काहाके काना बी आह़फा ना डील ह़ाते रीह नी राखे पण तीने पाळे-पोहे, जीसम मसी बी मंडळी ह़ाते करे। <verse eid="EPH 5:29" /><verse number="30" style="v" sid="EPH 5:30" />आनीन करते के आमु तीना डील नो वाटो से। <verse eid="EPH 5:30" /><verse number="31" style="v" sid="EPH 5:31" />“जीसम के सास्‌तर केय, अदमी आह़फा ना आय्‌ह-बाहा ने सोड़ीन आह़फा नी घोरवाळी ह़ाते मेळीन रेहे, अने तीहया बेम एक डील हय जहे।”<note caller="+" style="f"><char style="fr" closed="false">5:31 </char><char style="ft" closed="false">उबजणाय कीताप 2:24</char></note> <verse eid="EPH 5:31" /><verse number="32" style="v" sid="EPH 5:32" />आहयी ते घण-जबर खास वात से, पण मे आञे मसी अने मंडळी ना बारा मे वात केम। <verse eid="EPH 5:32" /><verse number="33" style="v" sid="EPH 5:33" />पण तमारी मे गेथो एक-एक जणो तमारी लाडी सी आह़फा नी तेम मोंग करवु जोवे, अने हरेक लाडी ने बी आह़फा ना लाडा नी ईज्‌जत करवु जोवे।<verse eid="EPH 5:33" /></para>
  <chapter eid="EPH 5" />
  <chapter number="6" style="c" sid="EPH 6" />
  <para style="s">आय्‌ह-बाहा अने सोरा</para>
  <para style="p">
    <verse number="1" style="v" sid="EPH 6:1" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:1 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:20">कुलुस्‌यो 3:20</ref>
      </char>
    </note>ए सोरा, मालीक मे आह़फाम ना आय्‌ह-बाहा ना हुकम ने मानवा वाळा बणो, काहाके आहयु घणु वारु से।<note caller="+" style="f"><char style="fr" closed="false">6:1 </char><char style="ft" closed="false">कुलुसीयो 3:20 </char></note> <verse eid="EPH 6:1" /><verse number="2" style="v" sid="EPH 6:2" />“आह़फा ना आय्‌ह-बाहा नी ईज्‌जत करो” आहयो पेलो हुकम से जीनी ह़ाते वायदो बी से <verse eid="EPH 6:2" /><verse number="3" style="v" sid="EPH 6:3" />“के तारु भलु हये, अने तु धरती पोर ना जागा मे घणा दाड़ा लग जीवत्‌लो री सके।”<note caller="+" style="f"><char style="fr" closed="false">6:3 </char><char style="ft" closed="false">नीरगमन 20:12; वेवस्‌थावीवरण </char></note><verse eid="EPH 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="EPH 6:4" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:4 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:21">कुलुस्‌यो 3:21</ref>
      </char>
    </note>ए आय्‌ह-बाहा, आह़फाम ना सोरा ने नराज ना करो, पण मालीक नी ह़ीकापण अने चेतावणी आप्‌ता जाय्‌न तीमने पाळो-पोहो।<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="ft" closed="false">कुलुसीयो 3:21</char></note><verse eid="EPH 6:4" /></para>
  <para style="s">मालीक अने चाकर्‌यो</para>
  <para style="p">
    <verse number="5" style="v" sid="EPH 6:5" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:5 </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:22-25">कुलुस्‌यो 3:22-25</ref>
      </char>
    </note>ए चाकर्‌या, जे माणहु तमारा आहयी कळी मे मास्‌तर से, आह़फाम ना ह़ुदा मन सी बीहता अने कापता जाय्‌न, जीसम मसी नो हुकम माने तेमेत तीमनो बी मानो <verse eid="EPH 6:5" /><verse number="6" style="v" sid="EPH 6:6" />माणहु ने खुस करवा वाळान तेम देखाड़वा नी सेवा ना करो, पण मसी ना चाकर्‌या नी तेम मन सी भगवान नी मरजी पोर चालो, <verse eid="EPH 6:6" /><verse number="7" style="v" sid="EPH 6:7" />अने तीहयी सेवा ने माणहु नी पण मालीक नी ह़मजीन खरला मन सी करो। <verse eid="EPH 6:7" /><verse number="8" style="v" sid="EPH 6:8" />काहाके तमु जाणो के जे कोय वारला काम करहे, भले चाकर्‌यो हय के नी चाकर्‌यो हय, अमारी मे जे वारला काम करहे, तीने मालीक ईलाम आपहे।<note caller="+" style="f"><char style="fr" closed="false">6:8 </char><char style="ft" closed="false">कुलुसीयो 3:22-25</char></note><verse eid="EPH 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="EPH 6:9" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:9 </char>
      <char style="xt" closed="false">
        <ref loc="COL 4:1">कुलुस्‌यो 4:1</ref>; </char>
      <char style="xt" closed="false">
        <ref loc="COL 3:25">कुलुस्‌यो 3:25</ref>
      </char>
    </note>ए मालक्‌या, तमु बी धमकी आपवा सोड़ीन तीमनी ह़ाते तेवोत वेहवार करो; काहाके तमु जाणो के तीमनो अने तमारो बेम नो मालीक ह़रग मे से, तीहयो कोयनो भेद-भाव नी करे।<note caller="+" style="f"><char style="fr" closed="false">6:9 </char><char style="ft" closed="false">वेवस्‌थावीवरण 10:7; कुलुसीयो 3:25; 4:1</char></note><verse eid="EPH 6:9" /></para>
  <para style="s">भगवान नी ढाल</para>
  <para style="p">
    <verse number="10" style="v" sid="EPH 6:10" />करीन मालीक मे अने तीनी सक्‌ती ना बदलाव मे ताखत वाळा बणो। <verse eid="EPH 6:10" /><verse number="11" style="v" sid="EPH 6:11" />भगवान ना आखा हत्‌यार बांद लेवो के तमु भुतड़ा नी <note caller="+" style="f"><char style="fr" closed="false">6:11 </char><char style="ft" closed="false">ईबलीस</char></note> बुरी-चाल अगळ उबा री सको। <verse eid="EPH 6:11" /><verse number="12" style="v" sid="EPH 6:12" />काहाके अमारो आहयो झगड़ो, लोय अने माह सी नी हय, पण मुख्‌या ह़ाते अने अदीकार्‌या ह़ाते से, अने आहयी कळी ना अंदारलु ना डायला ह़ाते से, अने तीहया भुत नी आत्‌मा ना मेळा ह़ाते से जे वादळा मे से। <verse eid="EPH 6:12" /><verse number="13" style="v" sid="EPH 6:13" />करीन भगवान ना आखा हत्‌यार बांद लेवो के तमु गांडा दाड़ा नो वीरोद कर सको, अने आखु कंय पुरु करीन टेकला री सको। <figure style="fig" alt="Roman soldier" file="lb00196c.tif" size="col" copy="Horace Knowles ©" ref="6:10">रोमी सीपायड़ु</figure><verse eid="EPH 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="EPH 6:14" />करीन सच्‌चाय सी काठी केड़ बांदीन, अने धरम नी ढाल पेरीन,<note caller="+" style="f"><char style="fr" closed="false">6:14 </char><char style="ft" closed="false">यसाया 11: 5; 59:17 </char></note> <verse eid="EPH 6:14" /><verse number="15" style="v" sid="EPH 6:15" />अने पोगु मे मेळ नी खुस-खबर ने लागु करवा नी तीयारी ना खाहड़ा पेरीन।<note caller="+" style="f"><char style="fr" closed="false">6:15 </char><char style="ft" closed="false">यसाया 52:7</char></note> <verse eid="EPH 6:15" /><verse number="16" style="v" sid="EPH 6:16" />अने आहया आखाम नी ह़ाते भरहा नी ढाल लीन टेकला रेवो जीनी सी तमु तीहया वेरी ना आखा धपत्‌ला बीलखा ने ओलवी सको। <verse eid="EPH 6:16" /><verse number="17" style="v" sid="EPH 6:17" />अने छुटकारा ने टोपीन तेम पेर लेवो, अने भगवान ना बोल ने तलवार नी तेम जे आत्‌मा तमने आपे।<note caller="+" style="f"><char style="fr" closed="false">6:17 </char><char style="ft" closed="false">यसाया 59:17</char></note> <verse eid="EPH 6:17" /><verse number="18" style="v" sid="EPH 6:18" />आखी टेमे अने आत्‌मा मे वीन्‌ती, अने रावण्‌या करता रेवो, जागता रेवो अने हार ना मानो अने भगवान ना चोखला माणहु ना लेदे वीन्‌ती कर्‌या करो। <verse eid="EPH 6:18" /><verse number="19" style="v" sid="EPH 6:19" />अने मारी जुगु बी वीन्‌ती कर्‌या करो के मारी बोलवा नी टेमे एवो ताखत वाळो बोल आपे के मे हीम्‌मत सी खुस-खबर नी ह़तायली वात ने देखाड़ सकु। <verse eid="EPH 6:19" /><verse number="20" style="v" sid="EPH 6:20" />जीनी जुगु मे ह़ाकळ मे बंदायलो राजदुत से। अने आहयु बी के मे तीना बारा मे जेम मने जोवे हीम्‌मत सी बोल सकु।<verse eid="EPH 6:20" /></para>
  <para style="s">आखरी काव आवही अने आवजो केय</para>
  <para style="p">
    <verse number="21" style="v" sid="EPH 6:21" />
    <note caller="+" style="x">
      <char style="xo" closed="false">6:21 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 20:4">नेवताळा ना काम 20:4</ref>; <ref loc="2TI 4:12">2 तीमुथीयुस 4:12</ref>; <ref loc="COL 4:7">कुलुस्‌यो 4:7</ref>,<ref loc="COL 4:8">8</ref></char>
    </note>तुखीकुस जे मोंगाळ्‌ळो भाय अने मालीक नो ह़मजदार चाकर्‌यो से, तमने आखी वात देखाड़हे के तमु बी मारी हालत जाणो के मे कीकम रेम। <verse eid="EPH 6:21" /><verse number="22" style="v" sid="EPH 6:22" />ईने मे तमारीन्‌तां आनीन करते मोकल्‌लो से, के तमु मारी हालत जाणो, अने तीहयो तमारा मन ने सांती आपे।<verse eid="EPH 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="EPH 6:23" />बाह भगवान अने मास्‌तर ईसु मसी नी भणी गेथी भायु ने सांती अने भरहा भेळ मोंग जड़े। <verse eid="EPH 6:23" /><verse number="24" style="v" sid="EPH 6:24" />जे आपणा मास्‌तर ईसु मसी ने मोंग करे, तीहया आखा पोर दया हयती रेय।<verse eid="EPH 6:24" /></para>
  <chapter eid="EPH 6" />
</usx>