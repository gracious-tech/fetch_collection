<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="DAN" style="id">- Paliya New Testament</book>
  <para style="h">दानीयल</para>
  <para style="toc3">दानीयल</para>
  <para style="toc2">दानीयल</para>
  <para style="toc1">दानीयल</para>
  <para style="mt2">दानीयल की कीताप</para>
  <para style="mt1">दानीयल नी कीताप</para>
  <para style="imt">जानकारी</para>
  <para style="ip">दानीयल नी कीताप बेबीलोन मे ईस्‌रायली माणहु गुलामी मे हता ते टेमे भगवान वगे गेथी वात केवा वाळा दानीयल नी जीवाय अने अगी हयवा वाळी वात सी जोड़ायली से। आहयी दानीयल अने तीना दोस्‌तीदार नी ईमानदारी भेळ-भेळ देस अने कळी ना बारा मे भगवान वगे गेथी केदली वात ना बारा मे देखाड़े। आहयी कीताप एक अंजाद सी 605 गेथी 535 नी आड़े-धेड़े ईसा पेले नी टेम मे देखाड़े, जां ह़ारीक दानीयल बेबीलोन ना च्‌यार अलग-अलग राजाम ना राज्‌य नी टेम मे सेवा करलो हतो। आखाम नु माननु आहयु से के दानीयल खुद आहयी टेम मे बेबीलोन मे कीताप लीखलो हतो, पण ढेरेत हमणे ना बीजा जानकारुम नु केणु से के आहयी अळतेण ईसा पेले बीजी सताब्‌दी नी टेमे ईस्‌रायल मे लीखली हती। बीजाम नु माननु से के कीताप मे ना ढेरेत हीस्‌सा अलग-अलग टेमे लीखला हता।</para>
  <para style="ip">दानीयल नी कीताप गुलामी मे री र्‌या ईस्‌रायली माणहु नी ह़ाते-ह़ाते काठली टेम आव्‌वा पोर आव्‌वा वाळी पीड़ी ने हीम्‌मत आपवा करीन लीखली से। दानीयल नी जीवाय नी हयली वात अने अगी हयवा वाळी वात नी लारे भगवान, राजा अने देसु पोर आह़फा नी सक्‌ती देखाड़े। बायबल नी अनसारे आहया नवला नेम मे भगवान ना राज्‌य ने ह़मजवा मे मदत करे। <char style="xt"><ref loc="DAN 7:13-14">दानीयल 7:13-14</ref></char> मसी सी भगवान वगे गेथी वात केदली से, आखरी टेम ना बारा मे दानीयल ना दरसन नो खुलासो ईसु मसी नी लारे करलो से <char style="xt"><ref loc="MAT 24:15">मत्‌ती 24:15</ref>; <ref loc="MRK 13:14">मरकुस 13:14</ref></char> अने युहन्‌ना नी ह़तायली वात ना बारा मे से। दानीयल यीरम्‌या नी भगवान वगे गेथी केदली वातु पोर बी देखाड़े <char style="xt"><ref loc="DAN 9:1-3">दानीयल 9:1-3</ref></char>।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. नबुकदनेस्‌सर नी राज करवा नी टेमे बेबीलोन मे दानीयल अने तीना ह़ाती ना बारा मे देखाड़े <char style="ior"><ref loc="DAN 1:4">1:4</ref></char>।</para>
  <para style="io1">2. राजा बेलसस्‌सर ना दरसन मे दानीयल नी आखी वात ना बारा मे खुलीन देखाड़े <char style="ior"><ref loc="DAN 5">5</ref></char>।</para>
  <para style="io1">3. दारा राजा ना राज करवा नी टेम मे नाहर ना दोर मे दानीयल ना बारा मे देखाड़े <char style="ior"><ref loc="DAN 6">6</ref></char>।</para>
  <para style="io1">4. अगी हयवा वाळी वात ना बारा मे भगवान गेथा दानीयल तक ना खुलासा से <char style="ior"><ref loc="DAN 7-12">7–12</ref></char></para>
  <para style="io1">(क) दानीयल अगी हयवा वाळी वात ना बारा मे अने बे दरसन ना बारा मे खुलासो करे <char style="ior"><ref loc="DAN 7-8">7–8</ref></char></para>
  <para style="io1">(ब) दानीयल आह़फा ना माणहु नी करते वीन्‌ता करे अने ह़रगदुत जीब्‌राएल नी लारे तीनो जपाप जड़े <char style="ior"><ref loc="DAN 9">9</ref></char>।</para>
  <para style="io1">(स) जीब्‌राएल आखरी टेम भेळ अगी हयवा वाळी वात ना बारा मे खुलासो करे। <char style="ior"><ref loc="DAN 12">12</ref></char></para>
  <chapter number="1" style="c" sid="DAN 1" />
  <para style="s">दानीयल अने तीना ह़ाती</para>
  <para style="r">(<ref loc="DAN 1:1-6:28">दानीयल 1:1–6:28</ref>)</para>
  <para style="s">च्‌यार अदमी नबुकदनेस्‌सर नी राज्‌यसभा मे</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 1:1" />यहुदा ना राजा यहोयाकीम ना राज्‌य ना तीसरा साल मे बेबीलोन नो राजा नबुकदनेस्‌सर यरुसलेम पोर हमलो करीन तीने घेर लेदो।<note caller="+" style="x"><char style="xo" closed="false">1:1 </char><char style="xt" closed="false"><ref loc="2KI 24:1">2 राजा 24:1</ref>; <ref loc="2CH 36:5-7">2 ईतीहास 36:5-7</ref></char></note> <verse eid="DAN 1:1" /><verse number="2" style="v" sid="DAN 1:2" />तत्‌यार मालीक भगवान यहुदा ना राजा यहोयाकीम ने भगवान ना मंदीर ना ढेरेत ठाहरा भेळ नबुकदनेस्‌सर ना हात मे ह़ोप देदो। अने तीहयो तीहया ठाहराम ने सीनार देस मे आह़फा ना देवता ना मंदीर मे ली जाय्‌न, आह़फा ना देवता ना ह़मान मेकवा नु घोर मे मेल देदो।<note caller="+" style="x"><char style="xo" closed="false">1:2 </char><char style="xt" closed="false"><ref loc="2KI 20:17-18">2 राजा 20:17-18</ref>; <ref loc="2KI 24:10-16">24:10-16</ref>; <ref loc="2CH 36:10">2 ईतीहास 36:10</ref>; <ref loc="ISA 39:7-8">यसाया 39:7-8</ref></char></note><verse eid="DAN 1:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 1:3" />तत्‌यार तीहयो राजा आह़फा ना मुख्‌या नीयाव करवा वाळा असपनज ने हुकम आप्‌यो के ईस्‌रायल देस ना राजा ना घोराणा ना अने मोट्‌ला घोराणाम ना माणहु मे गेथा कंय जुवान्‌याम ने लाव, <verse eid="DAN 1:3" /><verse number="4" style="v" sid="DAN 1:4" />तीहया वण-गुनाळ्‌ळा, घटाळा अने आखी भाती नी अक्‌कल मे ह़मजदार, अने ह़ीकापण सी भरला अने ताखत वाळा, अने राजा ना राजवाड़ा मे सेवा करवा नी लायक हय; अने तीमने कसदी माणहु नी भणवा-लीखवा नी अने भासा नी ह़ीकापण आपो।<note caller="+" style="x"><char style="xo" closed="false">1:4 </char><char style="xt" closed="false"><ref loc="2KI 20:17">2 राजा 20:17</ref>,<ref loc="2KI 20:18">18</ref>; <ref loc="2KI 24:10-16">24:10-16</ref>; <ref loc="2CH 36:10">2 ईतीहास 36:10</ref>; <ref loc="ISA 39:7">यसाया 39:7</ref>,<ref loc="ISA 39:8">8</ref></char></note> <verse eid="DAN 1:4" /><verse number="5" style="v" sid="DAN 1:5" />राजा हुकम आप्‌यो के तीमनु खाणु अने पीवा ना अंगुर नो माणलो रोह मे गेथु तीमने दाड़ीक खावा-पीवा आपो। आहयी रीते तीन साल तक तीमनो पाळण-पोसण हयतो रेय; तत्‌यार तीनी बाद तीमने राजा नी अगळ सेवा मे हजुर करजो। <verse eid="DAN 1:5" /><verse number="6" style="v" sid="DAN 1:6" />तीमनी मे यहुदा नी अवल्‌यात मे गेथा टाळला दानीयल, हनन्‌याह, मीसायेल, अने अजर्‌याह नाम ना यहुदी हता। <verse eid="DAN 1:6" /><verse number="7" style="v" sid="DAN 1:7" />मुख्‌यो खोजो<note caller="+" style="f"><char style="fr" closed="false">1:7 </char><char style="fq" closed="false">खोजो </char><char style="ft" closed="false">गतराड़ो</char></note> असपनज तीमना बीजा नाम पाड़्‌यो; मतलब दानीयल नु नाम तीहयो बेलतसस्‌सर, हनन्‌याह नु सद्‌रक, मीसायेल नु मेसक, अने अजर्‌याह नु नाम अबेदनगो पाड़्‌यो।<verse eid="DAN 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 1:8" />पण दानीयल आह़फा ना मन मे ठान लेदो के तीहयो राजा नु खाणु खाय्‌न, अने तीमना पीवा ना अंगुर ना माणला रोह ने पीन नी वीटळे; करीन तीहयो खोजा ना मुख्‌या पांह वीन्‌ती कर्‌यो के तीने वीटळवा नी पड़े। <verse eid="DAN 1:8" /><verse number="9" style="v" sid="DAN 1:9" />भगवान मुख्‌या खोजा ना मन मे दानीयल ना लेदे गीण अने दया भर देदो। <verse eid="DAN 1:9" /><verse number="10" style="v" sid="DAN 1:10" />असपनज दानीयल ने केदो, “मे मारा मालीक राजा सी बीहु, काहाके तमारु खावा-पीवा नु तीहयोत ठेरावलो से, कंय माय्‌न आसम नी हय जाय के तीहयो तारु मोडु तारा ह़ाते वाळा जुवान्‌या गेथु उतरलु अने नराज देखे अने मारु मुंडु ने तोड़ नाखे।”<verse eid="DAN 1:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 1:11" />मुख्‌यो खोजा असपनज, दानीयल, हनन्‌याह, मीसायेल, अने अजर्‌याह नु खाणु नी जुगाड़ करवा करीन एक मुख्‌या ने टाळलो हतो, दानीयल तीहया मुख्‌या ने केदो, <verse eid="DAN 1:11" /><verse number="12" style="v" sid="DAN 1:12" />“में तारी पांह वीन्‌ती करु, के तारा चाकर्‌या ने दह दाड़ा तक भाजी-पालो खावा अने पीवा करीन पाणी आपीन पारख। <verse eid="DAN 1:12" /><verse number="13" style="v" sid="DAN 1:13" />ता दह दाड़ा अळतेण अमारा मोडा ने अने जे जुवान्‌या राजा नु खाणु खाय तीमना मोडा ने देखजे, अने जीसम तने देखाव पड़े, तीनी अनसारे आह़फा ना पावर्‌या ह़ाते वेहवार करजे।”<verse eid="DAN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 1:14" />तीमनी आहयी वात तीहयो मान लेदो, अने दह दाड़ा लग तीमने पारखतो र्‌यो। <verse eid="DAN 1:14" /><verse number="15" style="v" sid="DAN 1:15" />दह दाड़ान अळतेण राजा नु खाणु खावा वाळा आखा जुवान्‌या गेथु तीमनु मोडु वारु अने तीहया माता देखाव पड़्‌या। <verse eid="DAN 1:15" /><verse number="16" style="v" sid="DAN 1:16" />तत्‌यार तीहयो खाणु नो जुगाड़ करवा वाळो मुख्‌यो तीमनी जुगु खावा अने पीवा जुगु ठेरावलो अंगुर नो रोह, बेम छोड़ीन, तीमने भाजी-पालो आपवा बाज ज्‌यो।<verse eid="DAN 1:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 1:17" />भगवान तीहया च्‌यारोव जुवान्‌याम ने आखा भणवा-लीखवा अने आखी भाती ना ग्‌यान मे अक्‌कल अने हुनर आप्‌यो; अने दानीयल आखा भाती ना दरसन अने ह़पना नु मतलब बी ह़मजवा बाज ज्‌यो।<verse eid="DAN 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 1:18" />राजो नबुकदनेस्‌सर आहयो हुकम आपलो हतो के ईस्‌रायल माणहु मे गेथा आखा जुवान तीन साल नी अळतेण तीनी अगळ राजवाड़ा मे हजुर करे। जत्‌यार आहयी टेम पुरी हयी ता मुख्‌यो खोजा असपनज तीमने राजवाड़ा मे लीज्‌यो। अने तीहयो तीमने राजा नी अगळ हजुर कर्‌यो। <verse eid="DAN 1:18" /><verse number="19" style="v" sid="DAN 1:19" />राजो तीमनी ह़ाते वात कर्‌यो; अने दानीयल, हनन्‌याह, मीसायेल, अने अजर्‌याह नी बराबर तीमनी मे गेथो कोय नी ठेर्‌यु; एतरे राजा तीमने आह़फा नी सेवा कराव्‌वा करीन टाळ लेदो। <verse eid="DAN 1:19" /><verse number="20" style="v" sid="DAN 1:20" />अक्‌कल अने आखी भाती नी ह़मज ना बारा मे जे कंय राजा तीमने पुसतो हतो तीनी मे तीहया पुरा राज्‌य ना आखा जानकारु अने जादु-टोना करन्‌या गेथा दह गुणा हुस्‌यार ठेरता हता। <verse eid="DAN 1:20" /><verse number="21" style="v" sid="DAN 1:21" />दानीयल बेबीलोन ना राजवाड़ा मे कुस्‌रु राजा ना राज्‌य नी टेम ना पेल्‌ला साल तक बणीन र्‌यो।<verse eid="DAN 1:21" /></para>
  <chapter eid="DAN 1" />
  <chapter number="2" style="c" sid="DAN 2" />
  <para style="s">नबुकदनेस्‌सर राजा नु ह़पनु</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 2:1" />आह़फा ना राज ना बीजा साल मे नबुकदनेस्‌सर एवु ह़पनु देख्‌यो जीनी सी तीनु मन घणु दुखी हय ज्‌यु अने तीने नींदर नी आयी। <verse eid="DAN 2:1" /><verse number="2" style="v" sid="DAN 2:2" />तत्‌यार राजो हुकम आप्‌यो, के जानकारु, बड़वा, जादु-टोना करन्‌या अने कसदी महाराजु ने बोलावे के राजा ने तीनु ह़पनु नु मतलब देखाड़े; करीन तीहया आया अने राजा अगळ हजुर हया। <verse eid="DAN 2:2" /><verse number="3" style="v" sid="DAN 2:3" />तत्‌यार राजा तीमने केदो, “मे एक ह़पनु देखलो से, अने मारु मन दुखी से के ह़पनु ने कीकम ह़मजु।”<verse eid="DAN 2:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 2:4" />तत्‌यार कसदी माणहु, राजा ने अरामी भासा मे केदा, “ए राजा, तु हमेसा जीवतो रेय! आह़फा ना चाकर्‌याम ने ह़पनु देखाड़, अने आमु तीनु मतलब देखाड़हु।” <verse eid="DAN 2:4" /><verse number="5" style="v" sid="DAN 2:5" />राजा कसदी माणहु ने जपाप आप्‌यो, “मे आहयो हुकम आप देदलो से के कदीम तमु मारा ह़पना नु मतलब नी देखाड़ो ता तमु पक्‌का जाण लेवो के तमारा टुकड़ा-टुकड़ा कर देहे, अने तमारा घोरु उजाड़ देहे। <verse eid="DAN 2:5" /><verse number="6" style="v" sid="DAN 2:6" />पण कदीम तमु ह़पनु ने मतलब भेळ देखाड़ देवो ता मारी पांह गेथा भाती-भाती ना भेट, ईलाम अने घणी जादा ईज्‌जत जड़हे। करीन तमु मने ह़पनु अने तीनु मतलब देखाड़ो।”<verse eid="DAN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 2:7" />तीहया बीजी काव केदा, “ए राजा, ह़पनु तारा चाकर्‌याम ने देखाड़, अने आमु तीनु मतलब ह़मजाड़ देहु।”<verse eid="DAN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 2:8" />राजा जपाप आप्‌यो, “मे पक्‌को जाणु के तमु आहयी वात टेम पुरी करवा करीनेत की र्‌या; काहाके तमु जाणो के मारो आहयो वायदो टळ नी सके। <verse eid="DAN 2:8" /><verse number="9" style="v" sid="DAN 2:9" />करीन कदीम तमु मारु ह़पनु मने नी देखाड़ो, ता तमारी जुगु मोत नो डंड पक्‌को से। तमु एक-बीजा नी ह़ाते आहयी वात मे एक-मन्‌या हय जेला से के तीहयी टेम लग तमु मने झुट मेको, जत्‌यार लग मारो धीयान सेटो नी हय जाय। करीन हाव साटात मारु ह़पनु देखाड़ो जीनी सी मने मालम हय के तमु मने तीनु मतलब बी देखाड़ सको।”<verse eid="DAN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 2:10" />कसदी महाराज माणहु राजा ने केदा, “आखी धरती पोर एवु कोय माणेह नी हय जे राजा ना मन नी वात ने देखाड़ सके; अने नी कोय एवो राजा, नी ते मुख्‌यो, नी ते अदीकारी हयो जे काना जानकारु, बड़वा अने कसदी महाराज ने आसवी वात पुछ्‌यो हय। <verse eid="DAN 2:10" /><verse number="11" style="v" sid="DAN 2:11" />जे वात राजो आमने पुछ र्‌यो, तीहयी काठी से, अने देवता एतरात राजा ने तीनु ह़पनु देखाड़ सके। पण देवता ते माणहु नी वचे नी रेय।”<verse eid="DAN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 2:12" />आहयी वात पोर राजा नराज हय्‌न, अने घणो खीजवाय्‌न, बेबीलोन ना आखा जानकारु ने मारवा नो हुकम आप देदो। <verse eid="DAN 2:12" /><verse number="13" style="v" sid="DAN 2:13" />आहयो राजा नो हुकम पुरा देस मे पुगाड़ दे दो के राजा ना आखा जानकारुम ने मार नाखो। करीन सीपायड़ा दानीयल अने तीना ह़ातीम ने ह़ोदवा बाज र्‌या हता।<verse eid="DAN 2:13" /></para>
  <para style="s">भगवान नी लारे दानीयल पोर ह़पना नु मतलब उजन्‌तु करवा</para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 2:14" />तत्‌यार दानीयल सीपायड़ा ना मुख्‌या अर्‌योक ने, जे बेबीलोन ना जानकारु ने मारवा करीन आवलो हतो, तीनी ह़ाते सोची-समजीन अने अक्‌कल सी वात कर्‌यो। <verse eid="DAN 2:14" /><verse number="15" style="v" sid="DAN 2:15" />अने दानीयल राजा ना मुख्‌या अर्‌योक ने पुसवा बाज ज्‌यो, “आहयो काठो हुकम राजा भणी गेथो एतरो उतवाळ्‌यो ह़ुका नीकळ्‌यो?” तत्‌यार अर्‌योक दानीयल ने आनो कारण देखाड़ देदो।<verse eid="DAN 2:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 2:16" />तत्‌यार दानीयल राजा ना राजवाड़ा मे ज्‌यो, अने राजा पांह रावण्‌या कर्‌यो, के तीनी जुगु कोय पक्‌की टेम ठेरावे, काहाके तीहयो राजा ना ह़पना नु मतलब देखाड़ सके।<verse eid="DAN 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 2:17" />तत्‌यार दानीयल आह़फा ना घोर जीन, आह़फा ना ह़ाती हनन्‌याह, मीसायेल, अने अजर्‌याह ने आहयी वात देखाड़्‌यो, <verse eid="DAN 2:17" /><verse number="18" style="v" sid="DAN 2:18" />आहयी ह़तायली वात ना बारा मे ह़रग ना भगवान नी दया नी लेदे आहयु कीन वीन्‌ता करो, के बेबीलोन ना अने आखा जानकारुम नी ह़ाते, दानीयल अने तीना ह़ातीम ने बी खत्‌तम नी करे। <verse eid="DAN 2:18" /><verse number="19" style="v" sid="DAN 2:19" />तत्‌यार तीहयी ह़तायली वात दानीयल ने रात नी टेमे दरसन नी लारे उजन्‌ती हयी। तत्‌यार दानीयल ह़रग ना भगवान ने आहयु कीन तु घणो वारु से केदो, <verse eid="DAN 2:19" /><verse number="20" style="v" sid="DAN 2:20" />“भगवान नु नाम जलमकु जुगाळु से; काहाके अक्‌कल अने सक्‌ती तीनीत से। <verse eid="DAN 2:20" /><verse number="21" style="v" sid="DAN 2:21" />तीहयोत से जे टेम अने सीजन ने बदले; तीहयो राजाम ने गादी पोर गेथा सेटा करीन बीजाम ने गादी पोर बहाड़े; अक्‌कल वाळा ने अक्‌कल अने ह़मजवाळा ने ह़मज आपे। <verse eid="DAN 2:21" /><verse number="22" style="v" sid="DAN 2:22" />भगवानेत ढकायली अने ह़तायली वात ने उजन्‌ती करे; तीहयो अंदारला मे ह़तायली वात ने जाणे, अने तीनी ह़ाते वीजाळु से। <verse eid="DAN 2:22" /><verse number="23" style="v" sid="DAN 2:23" />ए मारा आड़ा-बुड़ा ना भगवान, में तने जुगाळो से केम अने तारी भक्‌ती करु, काहाके तु मने अक्‌कल अने सक्‌ती आपलो से, अने जे ह़तायली वात ने आमु उजन्‌ती हयवा करीन देखाड़वा केदला, तीने तु मारी पोर उजन्‌ती करलो से, तु आमने राजा नी वात देखाड़लो से।”<verse eid="DAN 2:23" /></para>
  <para style="s">राजा ने ह़पनु अने तीनु मतलब देखाड़नु</para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 2:24" />तत्‌यार दानीयल अर्‌योक ने तां मोय ज्‌यो, जीने राजो बेबीलोन ना जानकारु ने मारवा करीन ठेरावलो हतो तीने केदो, “बेबीलोन ना जानकारुम ने ना मारे, मने राजा नी अगळ लीन चाल, मे ह़पना नु मतलब देखाड़ही।”<verse eid="DAN 2:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 2:25" />तत्‌यार अर्‌योक दानीयल ने राजा नी अगळ साटोत मोय ली जाय्‌न तीने केदो, “यहुदी केदड़ा मे गेथो एक माणेह मने जड़लो से, जे राजा ना ह़पना नु मतलब देखाड़हे।”<verse eid="DAN 2:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 2:26" />राजा, दानीयल ने, जीनु नाम बेलतसस्‌सर बी हतु, पुछ्‌यो, “ह़ु तारी मे एतरी सक्‌ती से के जे ह़पनु मे देखलो से, तीने मतलब भेळ मने देखाड़े?” <verse eid="DAN 2:26" /><verse number="27" style="v" sid="DAN 2:27" />दानीयल राजा ने जपाप आप्‌यो, “जे ह़तायली वात राजो पुछ र्‌यो, तीहयी वात ने नी ते महाराज, नी ते जादु-टोना करन्‌यो, नी ते जानकार, नी ते ह़ारो देखवा वाळो देखाड़ सके, <verse eid="DAN 2:27" /><verse number="28" style="v" sid="DAN 2:28" />पण ह़तायली वातु ने देखाड़वा वाळो भगवान ह़रग मे से; अने तीहयोत नबुकदनेस्‌सर राजा ने देखाड़लो से के आव्‌वा वाळा दाड़ा मे ह़ु-ह़ु हयवा वाळु से। तारु ह़पनु अने जे कंय तु खाट्‌लु पोर ह़ुवतो जीन देख्‌यो, तीहयु आहयु से:<verse eid="DAN 2:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 2:29" />“ए राजा, जत्‌यार तने खाट्‌ला पोर ह़ुवतो जीन आहयो वीच्‌यार आयो के आहयी जीवाय मे ह़ु-ह़ु हयवा वाळु से, तत्‌यार ह़तायली वात ने उजन्‌ती करवा वाळो तने देखाड़्‌यो के ह़ु-ह़ु हयवा वाळु से। <verse eid="DAN 2:29" /><verse number="30" style="v" sid="DAN 2:30" />मारी पोर आहयी ह़तायली वात आहया कारण नी उजन्‌ती हयी के मे अळी बीजा जीवत्‌ला माणहु गेथो जादा अक्‌कल वाळो से, पण आहयात कारण सी उजन्‌ती हयली से के ह़पना नु मतलब राजा ने देखाड़ सकु, अने तु आह़फा ना मन ना वीच्‌यार ह़मज सके।<verse eid="DAN 2:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 2:31" />“ए राजा, जत्‌यार तु देखवा बाज र्‌यो हतो, तत्‌यार तने एक मोट्‌ली मुर्‌ती देखाव पड़ी, अने तीहयी मुर्‌ती जे तारी ह़ामने उबी हती, तीहयी नाम्‌बी चवड़ी हती; अने घणी पपलवा बाज री हती, अने तीनो रुप जुदोत हतो। <verse eid="DAN 2:31" /><verse number="32" style="v" sid="DAN 2:32" />तीहयी मुर्‌ती नु मुंडु चोखलु ह़ोनु नु हतु, तीनी छाती अने हातु चांदी ना हता, तीनु पेट अने ह़ातळ्‌या पीतळ ना हता, <verse eid="DAN 2:32" /><verse number="33" style="v" sid="DAN 2:33" />तीना पोग लुहड़ा ना अने तीना पोगु थोड़ाक ते लुहड़ा ना अने थोड़ाक कादा ना हता। <verse eid="DAN 2:33" /><verse number="34" style="v" sid="DAN 2:34" />अळतेण देखते-देखते, तु ह़ु देख्‌यो, के एक दगड़ो, कोय बी खोद्‌या वगर, आह़फोत उखड़ीन तीहयी मुर्‌ती ना पोगु पोर पड़ीन जे लुहड़ा ना अने कादा ना हता, तीमने चुरा-चुरा कर नाख्‌यो। <verse eid="DAN 2:34" /><verse number="35" style="v" sid="DAN 2:35" />तत्‌यार लुहड़ु, कादु, पीतळ, चांदी अने ह़ोनु बी आखु चुरा-चुरा हय ज्‌यु, अने उनाळा मे ना खळा ना भुसान तेम वाहळा मे आसम उड ज्‌या के तीमनो कंय पतो नी लाग्‌यो; अने जे दगड़ो मुर्‌ती ने लागलो हतो, तीहयो मोट्‌लो बड़ो बणीन आखी कळी मे फेल ज्‌यो।<verse eid="DAN 2:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 2:36" />“ह़पनु ते आहयुत से; अने हाव आपणु तीनु मतलब राजा ने ह़मजाड़ दीया। <verse eid="DAN 2:36" /><verse number="37" style="v" sid="DAN 2:37" />ए राजा, तु ते राजाम नो राजा से, काहाके ह़रग नो भगवान तने राज्‌य, घणी जुदी सक्‌ती, ताखत अने बड़ाय आपलो से, <verse eid="DAN 2:37" /><verse number="38" style="v" sid="DAN 2:38" />भगवान तारा हात मे धरती पोर ना आखा माणहु, जानवरु अने चड़ा ह़ोपलो से। अने तने तीमनो आखाम नो अदीकारी ठेरावलो से। आहयु ह़ोना नु मुंडु तुत से। <verse eid="DAN 2:38" /><verse number="39" style="v" sid="DAN 2:39" />तारीन अळतेण एक राज्‌य अळी उबजहे जे तारी गेथु नानु रेहे; अळतेण एक अळी तीसरु पीतळ ने तेवु राज्‌य उबजहे जे आखी धरती पोर राज करहे। <verse eid="DAN 2:39" /><verse number="40" style="v" sid="DAN 2:40" />चोवथु राज्‌य लुहड़ान तेम मजबुत रेहे; जीसम लुहड़ु आखी चीज ने चुरा-चुरा कर नाखे, अने दळ देय; तेमेत आहयु राज्‌य आहया आखाम ने टुकड़ा-टुकड़ा करहे अने दळ देहे। <verse eid="DAN 2:40" /><verse number="41" style="v" sid="DAN 2:41" />ए राजा, जीसम के तु मुर्‌ती ना पोगु अने तीमना आंगळ्‌या ने देख्‌यो जे थोड़ीक कुमार ना कादा नी अने थोड़ीक लुहड़ा नी बणली हती। आहयी रीते आहयु चोवथु राज्‌य अलग-अलग वटायलु रेहे। जीसम तु देखलो के लुहड़ा मे चीकणलु कादु भेसकायलु हतु, तेमेत तीनी मे बी लुहड़ान तेम मजबुती रेहे। <verse eid="DAN 2:41" /><verse number="42" style="v" sid="DAN 2:42" />जीसम पोगु ना आंगळ्‌या थोड़ाक ते लुहड़ा ना हता अने थोड़ाक कादा ना हता, आनु मतलब आहयु से, के तीहयु राज्‌य थोड़ुक ते मजबुत अने थोड़ुक कमजोर हयहे। <verse eid="DAN 2:42" /><verse number="43" style="v" sid="DAN 2:43" />तु जे लुहड़ु ने कुमार ना कादा नी ह़ाते भेसकायलु देख्‌यो, आनु मतलब आहयु से, के तीहया राज्‌य ना माणहु एक बीजा माणहु मे रेहे, पण जीसम लुहड़ु कादा ह़ाते मेळ नी खाय, तेमेत तीहया बी एक बणीन नी रेय। <verse eid="DAN 2:43" /><verse number="44" style="v" sid="DAN 2:44" />तीहया राजाम ना राज्‌य नी टेमे ह़रग नो भगवान, एक एवु राज्‌य उबजाड़हे जे कळ नी छेव लग नी खत्‌तम हये, अने नी तीहयु काना बीजा राज्‌य ना हात मे हये। पण तीहयु ते आखा राज्‌य ने चुरा-चुरा कर देहे, अने खत्‌तम कर देहे; अने तीहयु आह़फु हमेसा टेकलु रेहे। <verse eid="DAN 2:44" /><verse number="45" style="v" sid="DAN 2:45" />राजा जीसम तु देख्‌यो के एक दगड़ो कोयना बी हात लगाड़्‌या वगर बड़ा पोर गेथो उखड़्‌यो, अने तीहयो लुहड़ा, पीतळ, कादा, चांदी, अने ह़ोनु ने टुकड़ा-टुकड़ा कर देदो, आहयी रीते मोट्‌लो भगवान राजा ने देखाड़लो से के आनीन अळतेण ह़ु-ह़ु हयवा वाळु से। राजा, तारु ह़पनु खरलु अने तीनु मतलब बी पक्‌कु से।”<verse eid="DAN 2:45" /></para>
  <para style="s">राजा नी लारे दानीयल नी ईज्‌जत</para>
  <para style="p">
    <verse number="46" style="v" sid="DAN 2:46" />आहयु ह़मळीन नबुकदनेस्‌सर राजा मोडा ना भरहे पड़ीन दानीयल ने वांद्‌यो, अने हुकम आप्‌यो के हीने भेट चड़ावो, अने हीनी अगळ वारु गंदायण्‌यान चीज धपाड़ो। <verse eid="DAN 2:46" /><verse number="47" style="v" sid="DAN 2:47" />अळतेण राजा दानीयल ने केदो, “ह़ाचली ते आहयु से के तमारो भगवान, देवताम नो भगवान, राजाम नो राजा अने ह़तायली वातु ने उजन्‌ती करवा वाळो से, करीनेत तु आहयी ह़तायली वात ने उजन्‌ती कर सक्‌यो।” <verse eid="DAN 2:47" /><verse number="48" style="v" sid="DAN 2:48" />तत्‌यार राजा दानीयल नो पद उचो कर्‌यो, अने तीने मोटा-मोटा भेट आप्‌यो; अने आहयो हुकम आप्‌यो के तीहयो बेबीलोन देस ना आखा राज्‌य पोर मुख्‌यो अने महाराजु पोर मुख्‌यो बणाय देय। <verse eid="DAN 2:48" /><verse number="49" style="v" sid="DAN 2:49" />तत्‌यार दानीयल केदो करीन राजो सद्‌रक, मेसक अने अबेदनगो ने बेबीलोन ना आखा राज्‌य ना कामु करवा करीन ठेराय देदो; पण दानीयल आह़फो राजा ना राजवाड़ा मे रेतो हतो।<verse eid="DAN 2:49" /></para>
  <chapter eid="DAN 2" />
  <chapter number="3" style="c" sid="DAN 3" />
  <para style="s">ह़ोना नी मुर्‌ती ने वांदवा नो हुकम</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 3:1" />नबुकदनेस्‌सर राजो ह़ोना नी एक मुर्‌ती बनाड़्‌यो, जीनी उचाय साट हात, अने चवड़ाय छोव हात नी हती। राजो तीने बेबीलोन देस ना दुरा नाम ना चोवगान मे उबी करायो। <verse eid="DAN 3:1" /><verse number="2" style="v" sid="DAN 3:2" />तत्‌यार नबुकदनेस्‌सर राजो अदीकार्‌याम ना मुख्‌याम ने, नीयाव करवा वाळा ना मुख्‌या ने, लेखो-जोखो करवा वाळा ने, नीयाव करवा वाळाम ने, जीला ना अदीकारी अने कंय राज्‌य-राज्‌य ना अदीकार्‌याम ने बोलावो मोकल्‌यो के तीहया ते मुर्‌ती पुजा मे आवे जे तीहयो उबी करावलो से। <verse eid="DAN 3:2" /><verse number="3" style="v" sid="DAN 3:3" />तत्‌यार अदीकार्‌याम ना मुख्‌या, राज करवा वाळा, राज्‌य ना मुख्‌या अदीकार्‌या, नीयाव करवा वाळा ना मुख्‌या, लेखो-जोखो करवा वाळा, नीयाव करवा वाळा, जीला ना अदीकार्‌या अने ढेरेत राज्‌य-राज्‌य ना अदीकार्‌या नबुकदनेस्‌सर राजा नी उबी करावली मुर्‌ती पुजा नी लेदे भेळा हया, अने तीहयी मुर्‌ती नी अगळ उबा हया। <verse eid="DAN 3:3" /><verse number="4" style="v" sid="DAN 3:4" />तत्‌यार चोकीदार ज्‌योरेत आड़ीन केदो, “ए देस-देस ना अने राज्‌य-राज्‌य ना माणहु, अने अलग-अलग भासा बोलवा वाळा, तमु ने आहयो हुकम ह़मळावु के, <verse eid="DAN 3:4" /><verse number="5" style="v" sid="DAN 3:5" />जे टेमे तमु सींगा, पीहा, तम्‌बुरा, रणथा, झुणगा अने फेपार्‌या आहया आखा भाती ना वाजा नी अवाज ह़मळो, तमु तीहयीत टेमे ढुंगा वळीन नबुकदनेस्‌सर राजा नी उबी करली ह़ोना नी मुर्‌ती ने वांदजो। <verse eid="DAN 3:5" /><verse number="6" style="v" sid="DAN 3:6" />जे कोय ढुंगो वळीन नी वांदे तीने तीहयीत टेमे होळो-होळो धपत्‌लु आक्‌ठु ना भाटा नी वचे नाख देहे।” <verse eid="DAN 3:6" /><verse number="7" style="v" sid="DAN 3:7" />आहया कारण तीहयी टेमे जेमेत आखा माणहु ने, सींगा, पीहा, तम्‌बुरा, रणथा, झुणगा अने फेपार्‌या आहया आखा भाती ना वाजा नी अवाज ह़मळाय पड़ी, तेमेत देस-देस अने राज्‌य-राज्‌य ना आखा माणहु अने अलग-अलग भासा बोलवा वाळा ढुंगा वळीन तीहयी ह़ोना नी मुर्‌ती ने, जे नबुकदनेस्‌सर राजो उबी करावलो हतो, वांद्‌या।<verse eid="DAN 3:7" /></para>
  <para style="s">दानीयल ना तीनोव ह़ाती पोर हुकम नी मानवा नो गुनो</para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 3:8" />तीहयी टेमे थोड़ाक कसदी माणहु राजान्‌तां ज्‌या, अने दगा सी यहुदीम नी चुगली कर्‌या। <verse eid="DAN 3:8" /><verse number="9" style="v" sid="DAN 3:9" />तीहया नबुकदनेस्‌सर राजा ने केवा बाज ज्‌या, “ए राजा, तु जलमको जीवत्‌लो रेय। <verse eid="DAN 3:9" /><verse number="10" style="v" sid="DAN 3:10" />ए राजा, तु ते आहयो हुकम आपलो से के जे माणेह सींगा, पीहा, तम्‌बुरा, रणथा, झुणगा अने फेपार्‌या आहया आखा भाती ना वाजा नी अवाज ह़मळे, तीहयो पड़ीन तीहयी ह़ोना नी मुर्‌ती ने वांदे; <verse eid="DAN 3:10" /><verse number="11" style="v" sid="DAN 3:11" />अने जे कोय पड़ीन नी वांदे तीने होळो-होळो धपत्‌लु आक्‌ठु ना भाटा मे नाख देहे। <verse eid="DAN 3:11" /><verse number="12" style="v" sid="DAN 3:12" />देख सद्‌रक, मेसक, अने अबेदनगो नाम ना थोड़ाक माणहु से, जीमने तु बेबीलोन देस ना कामु पोर अदीकारी ठेरावलो से। तीहया माणहु, ए राजा, तारा हुकम नी कंय बी फीकर नी कर्‌या; तीहया तारा देवता नी भक्‌ती नी करता, अने जे ह़ोना नी मुर्‌ती तु उबो करावलो से, तीने नी वांदता।”<verse eid="DAN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 3:13" />तत्‌यार नबुकदनेस्‌सर राजो खीजवाय्‌न हुकम आप्‌यो के सद्‌रक, मेसक अने अबेदनगो ने लावो। तत्‌यार सीपायड़ा तीहया माणहुम ने राजा अगळ हजुर कर्‌या। <verse eid="DAN 3:13" /><verse number="14" style="v" sid="DAN 3:14" />नबुकदनेस्‌सर राजो तीमने पुछ्‌यो, “ए सद्‌रक, मेसक अने अबेदनगो, तमु जे मारा देवता नी भक्‌ती नी करता, अने मारी उबी करली ह़ोना नी मुर्‌ती ने वांदता नी, ता ह़ु तमु जाण बुजीन आसम कर र्‌या? <verse eid="DAN 3:14" /><verse number="15" style="v" sid="DAN 3:15" />कदीम तमु हाव तीयार से, के जत्‌यार सींगा, पीहा, तम्‌बुरा, रणथा, झुणगा अने फेपार्‌या आहया आखा भाती ना वाजा नी अवाज ह़मळो, अने तीहयीत टेमे ढुंगा वळीन मारी बणावली मुर्‌ती ने वांदो, ता बचहु; अने कदीम तमु वांदो नी ता आहयीत टेमे तमने होळो-होळो धपत्‌लु आक्‌ठु ना भाटा नी वचे नाख देहे; अळतेण एवो कानो देवता से, जे तमु ने मारा हात मे गेथो बचाड़ सके?”<verse eid="DAN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 3:16" />सद्‌रक, मेसक अने अबेदनगो राजा ने केदा, “ए नबुकदनेस्‌सर राजा, आना बारा मे तने जपाप आपवा नी आमने कंय बी जरवत नी हय ह़मजया। <verse eid="DAN 3:16" /><verse number="17" style="v" sid="DAN 3:17" />अमारो भगवान, जीनी आमु भक्‌ती करया तीहयो आमने तीहया होळो-होळो धपत्‌लु आक्‌ठु ना भाटा ना आक्‌ठा मे गेथो बचाड़वा नी सक्‌ती राखे; ए राजा, तीहयो आमने तारा हात मे गेथो बी छोड़ाय सके। <verse eid="DAN 3:17" /><verse number="18" style="v" sid="DAN 3:18" />पण कदीम तीहयो नी बी बचाड़े, ते बी ए राजा, तने मालम रेय, के आमु तारा देवता नी भक्‌ती नी करया, अने नी तारी उबी करावली ह़ोना नी मुर्‌ती ने वांदया।”<verse eid="DAN 3:18" /></para>
  <para style="s">दानीयल ना तीनोव ह़ातीम ने भाटा मे नाखणु</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 3:19" />तत्‌यार नबुकदनेस्‌सर राजा खीजवाय पड़्‌यो, अने तीना मोडा नो रंग सद्‌रक, मेसक अने अबेदनगो नी लेदे बदली ज्‌यो। तीहयो हुकम आप्‌यो के भाटा नु आक्‌ठु ने ह़ात गुणा जादा होळो-होळो कर देवो। <verse eid="DAN 3:19" /><verse number="20" style="v" sid="DAN 3:20" />अळतेण आह़फा नी सेना मे ना थोड़ाक ताखत वाळा माणहु ने तीहयो हुकम आप्‌यो, के सद्‌रक, मेसक अने अबेदनगो ने बांदीन तीमने हुड़ु-हुड़ु धपत्‌ला आक्‌ठु ना भाटा मे नाख देवो। <verse eid="DAN 3:20" /><verse number="21" style="v" sid="DAN 3:21" />तत्‌यार तीहया माणहुम ने तीमना पायजमा, कुड़ता, टोपी अने बीजा लुगड़ा भेळ बांदीन, तीहया हुड़ु-हुड़ु धपत्‌ला आक्‌ठु ना भा‌टा मे नाख देदा। <verse eid="DAN 3:21" /><verse number="22" style="v" sid="DAN 3:22" />तीहयो भाटो ते राजा ना मोट्‌ला हुकम ना कारण जादात हुड़ु-हुड़ु धपाड़लो हतो, आहया कारण जे अदमी सद्‌रक, मेसक अने अबेदनगो ने नाखवा उचल्‌या तीहयात आक्‌ठा नी आच सी धपीन मर ज्‌या। <verse eid="DAN 3:22" /><verse number="23" style="v" sid="DAN 3:23" />अने तीहया हुड़ु-हुड़ु धपत्‌ला आक्‌ठा ना भाटा नी वचे तीहया तीनोव अदमी, सद्‌रक, मेसक अने अबेदनगो, ने बांदलात नाख देदा।<verse eid="DAN 3:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 3:24" />तत्‌यार नबुकदनेस्‌सर राजा वहराय ज्‌यो अने घबराय्‌न उबो हय ज्‌यो, अने आह़फा ना मंतरीम ने पुछवा बाज ज्‌यो, “ह़ु आमु तीहयु आक्‌ठु नी वचे तीनेत अदमी बांदला नी नखाड़्‌या?” तीहया राजा ने जपाप आप्‌या, “होव राजा, ह़ाचली वात से।”<verse eid="DAN 3:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 3:25" />अळतेण तीहयो केदो, “हाव मे च्‌यार अदमीम ने आक्‌ठा नी वचे छुटला फीरत्‌लो देखवा बाज र्‌यो, अने तीमने कंय बी नुकसान नी हयु; अने चोवथा अदमी नो सीको देवता ना सोरान तेवो से।”<verse eid="DAN 3:25" /></para>
  <para style="s">दानीयल ना तीनोव ह़ातीम नी ईज्‌जत करवु</para>
  <para style="p">
    <verse number="26" style="v" sid="DAN 3:26" />अळतेण नबुकदनेस्‌सर तीहया हुड़ु-हुड़ु धपत्‌ला आक्‌ठु ना भाटा ना झापला नी ह़ाते जीन केवा बाज ज्‌यो, “ए सद्‌रक, मेसक अने अबेदनगो, ए आखा मे जोरभर्‌या भगवान ना चाकर्‌या, नीकळीन आञे आवो!” आहयु ह़मळीन सद्‌रक, मेसक अने अबेदनगो आक्‌ठा नी वचे गेथा नीकळीन आया। <verse eid="DAN 3:26" /><verse number="27" style="v" sid="DAN 3:27" />जत्‌यार आखाम नो अदीकारी, राज्‌यपाल, राज्‌य मंत्‌री अने राजा ना मंत्‌री जे भेळा हयला हता, तीहया अदमीम नी भणी भाळ्‌या, तत्‌यार तीमना डील मे आक्‌ठा नी कंय बी आच नी लागी; अने तीमना मुंडा ना नीम्‌बाळा बी नी धप्‌या, तीमना पायजमा बी नी बगड़्‌या, अने तीमनी मे धपवा नी गंद बी नी आवी।<verse eid="DAN 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 3:28" />नबुकदनेस्‌सर केवा बाज ज्‌यो, “जुगाळो से सद्‌रक, मेसक अने अबेदनगो नो भगवान, जे आह़फा नो दुत मोकलीन आह़फा ना आहया चाकर्‌याम ने आनीन करते बचाड़्‌यो, काहाके आहया राजा ना हुकम ने नी मानीन, तारी पोर भरहो कर्‌या, अने आहयु सोचीन आह़फाम नु डील बी ह़ोप देदा, के आमु अमारा भगवान ने छोड़ीन, काना देवता नी भक्‌ती नी करया नीता नी वांदया।<verse eid="DAN 3:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 3:29" />“करीन हाव मे आहयो हुकम आपु के देस-देस अने राज्‌य-राज्‌य ना माणहु, अने अलग-अलग भासा बोलवा वाळा माणहु मे गेथा जे कोय सद्‌रक, मेसक अने अबेदनगो ना भगवान नी बुराय करहे, तीने टुकड़ा-टुकड़ा कर देहे, अने तीनु घोर उजाड़ बणाय देहे; काहाके आवो कोय देवता नी हय जे आहयी रीते बचाड़ सके।”<verse eid="DAN 3:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="DAN 3:30" />तत्‌यार राजा बेबीलोन देस मे सद्‌रक, मेसक अने अबेदनगो नो पद अळी मोटो कर्‌यो।<verse eid="DAN 3:30" /></para>
  <chapter eid="DAN 3" />
  <chapter number="4" style="c" sid="DAN 4" />
  <para style="s">नबुकदनेस्‌सर नु बीजु ह़पनु</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 4:1" />नबुकदनेस्‌सर राजा भणी गेथी देस-देस अने राज्‌य-राज्‌य ना माणहु, अने अलग-अलग भासा बोलवा वाळा जेतरा आखा धरती पोर रेय, तीहया आखा ने आहयी खबर जड़ी: “तमने घणी सांती जड़े। <verse eid="DAN 4:1" /><verse number="2" style="v" sid="DAN 4:2" />मने आहयु वारु लाग्‌यु, के आखा मे मुख्‌यो भगवान मने जे सेलाणी अने चमत्‌कार देखाड़लो से, तीमने उजन्‌ता करु। <verse eid="DAN 4:2" /><verse number="3" style="v" sid="DAN 4:3" />तीनी देखाड़ली सेलाणी केतरी मोटी, अने तीना चमत्‌कारु मे केतरी मोटी सक्‌ती उजन्‌ती हये! तीनु राज्‌य सदा नु अने तीनु राज-पाट पीड़ी सी पीड़ी तक बणीन रेय।<verse eid="DAN 4:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 4:4" />“में, नबुकदनेस्‌सर, मारा रेवा ना जागा मे सुख सी अने घणो खुसी मे रेतो हतो। <verse eid="DAN 4:4" /><verse number="5" style="v" sid="DAN 4:5" />में एवु ह़पनु देख्‌यो जीना कारण सी में बीह ज्‌यो; अने खाटला पोर पड़्‌या-पड़्‌या जे वीच्‌यार मारा मन मे आया अने जे वातु मे देख्‌यो, तीमना कारण मे घबराय जेलो हतो। <verse eid="DAN 4:5" /><verse number="6" style="v" sid="DAN 4:6" />तत्‌यार में हुकम आप्‌यो के बेबीलोन ना आखा जानकारु ने मारा ह़पना नु मतलब मने देखाड़वा नी लेदे मारी अगळ हजुर करे। <verse eid="DAN 4:6" /><verse number="7" style="v" sid="DAN 4:7" />जत्‌यार जानकारु, जादु-टोना करन्‌या, कसदी माणहु अने ह़ारो देखवा वाळा मोय आया, ता में तीमने मारु ह़पनु देखाड़्‌यो, पण तीहया तीनु मतलब नी देखाड़ सक्‌या। <verse eid="DAN 4:7" /><verse number="8" style="v" sid="DAN 4:8" />आखरी मे दानीयल मारी ह़ाते आयो, जीनु नाम मारा देवता ना नाम ना कारण बेलतसस्‌सर पाड़लु हतु, अने जीनी मे चोखला देवताम नी आत्‌मा रेय; अने में तीने मारु ह़पनु आहयु कीन देखाड़ देदो: <verse eid="DAN 4:8" /><verse number="9" style="v" sid="DAN 4:9" />ए बेलतसस्‌सर, तु ते आखा जानकारु नो मुख्‌यो से, मे जाणु के तारी मे चोखला देवताम नी आत्‌मा रेय, अने तु कानी बी वात ना कारण सी ना घबराये; करीन जे ह़पनु में देखलो से तीने मतलब भेळ देखाड़ीन ह़मजाड़ दे।<verse eid="DAN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 4:10" />“जे दरसन मे खाटला पोर रीन देखलो से तीहयो आहयो से: में देख्‌यो, के धरती नी वचा-वच एक झाड़ से; तीहयु घणु उचु से। <verse eid="DAN 4:10" /><verse number="11" style="v" sid="DAN 4:11" />तीहयु झाड़ मोटु हय्‌न मजबुत हय ज्‌यु, अने तीनी उचाय ह़रग लग पुग जी। अने तीहयु धरती नी आखी काकड़ लग देखाव पड़तु हतु। <verse eid="DAN 4:11" /><verse number="12" style="v" sid="DAN 4:12" />तीना पान्‌टा घटाळा, अने तीनी मे ढेरेत फोळ हता, आञे लग के तीनी मे आखा नी लेदे खाणु हतु। तीनी तळे चोवगान ना आखा जानवरु ने साहळो जड़तो हतो, अने तीना डाळ्‌या मे ह़रग ना आखा चड़ा रेता हता, अने आखा जीवु ने तीनी सी खाणु जड़तु हतु।<verse eid="DAN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 4:13" />“में खाटला पोर दरसन देखतो जीन ह़ु देख्‌यो, के एक चोखलो ह़रगदुत ह़रगे गेथो हेटो उतर्‌यो। <verse eid="DAN 4:13" /><verse number="14" style="v" sid="DAN 4:14" />तीहयो ज्‌योरेत आड़ीन केदो, ‘झाड़ ने बी वाड देवो, तीना डाल्‌या वाड देवो; अने तीना पान्‌टा झाड़ देवो अने फोळ ने वेरवी देवो; अने जानवरु तीनी हेटा सी छेटा हय जाय, अने चड़ा तीना डाल्‌या पोर गेथा उड जाय। <verse eid="DAN 4:14" /><verse number="15" style="v" sid="DAN 4:15" />ते बी तीना थुड़ ने मुळ्‌या भेळ जागा पोर छोड़ देवो, अने तीने लुहड़ा नी अने पीतळ नी ह़ाकळ वेर बांदीन चोवगान ना लील्‌ला चारा नी वचे रेवा देवो। तीहयु ह़रग नी धुवरी सी भीग्‌या करे अने जानवरु ने तेम लील्‌लो चारो खाय। <verse eid="DAN 4:15" /><verse number="16" style="v" sid="DAN 4:16" />तीनु मन बदली जाय अने माणहुन तेवु नी रेय, पण जानवरुन तेवु बण जाय; अने तीहयो ह़ात साल तक आहयीत हालत मे रेय। <verse eid="DAN 4:16" /><verse number="17" style="v" sid="DAN 4:17" />आहयो हुकम पेहरो देवा वाळा ह़रगदुत ना फेसला सी, अने आहयी वात चोखला ह़रगदुत ना बोल सी नीकळी, के जे जीवत्‌ला से तीहया जाण लेय के आखा मे मुख्‌यो भगवान माणहु ना राज्‌य पोर राज करे, अने तीहयु राज्‌य ने जीने गमे तीने आप देय, अने तीहयो नाना मे गेथा नाना माणेह ने बी तीनी पोर अदीकारी बणाय देय।’<verse eid="DAN 4:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 4:18" />“में राजा नबुकदनेस्‌सर आहयुत ह़पनु देख्‌यो। करीन ए बेलतसस्‌सर, तु आनु मतलब देखाड़, काहाके मारा राज्‌य मे बीजो कोय जानकार आनु मतलब मने ह़मजाड़ नी सकतो, पण तारी मे ते चोखला देवताम नी आत्‌मा रेय, आहया कारण सी तु तीने ह़मजाड़ सके।”<verse eid="DAN 4:18" /></para>
  <para style="s">दानीयल नी लारे ह़पना नु मतलब देखाड़वु</para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 4:19" />तत्‌यार दानीयल जीनु नाम बेलतसस्‌सर बी हतु, थोड़ीक वार घबरायतो र्‌यो, अने सोचतो-सोचतो दुखी हय ज्‌यो। ता राजो केवा बाज ज्‌यो, “ए बेलतसस्‌सर, आहयु ह़पनु सी नीता आना मतलब सी तु दुखी ना हये।” बेलतसस्‌सर केदो, ए मारा मालीक, वारु रेय के आहयु ह़पनु तारा वेरी जुगु रेय। अने आनु मतलब तारा दुस्‌मन पोर पड़े! <verse eid="DAN 4:19" /><verse number="20" style="v" sid="DAN 4:20" />जे झाड़ ने तु देख्‌यो, जे मोटु हय्‌न टणकु हय ज्‌यु, अने जीनी उचाय ह़रग लग पुग जी अने जे धरती नी छेव लग देखाव पड़े, <verse eid="DAN 4:20" /><verse number="21" style="v" sid="DAN 4:21" />जीना पान्‌टा घटाळा अने फोळ ढेरेत हता, अने जीनी मे आखा नी लेदे खाणु हतु; जीना साहळा मे चोवगान ना आखा जानवरु रेता हता, अने तीना डाळ्‌या पोर ह़रग ना चड़ा रेता हता।<verse eid="DAN 4:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 4:22" />ए राजा, तीहयु झाड़ तुत से। तु मोटो अने ताखत वाळो हय ज्‌यो, तारी बड़ाय वदी अने ह़रग लग पुग जी, अने तारु राज धरती नी छेव लग पुगलु से। <verse eid="DAN 4:22" /><verse number="23" style="v" sid="DAN 4:23" />ए राजा, तु जे एक चोखला पेहरो देण्‌या ने ह़रग गेथो उतरते अने आहयु केते देख्‌यो के झाड़ ने वाड देवो अने तीने खत्‌तम करो, अने थुड़ ने मुळ्‌या भेळ धरती पोर रेवा देवो, अने आने लुहड़ा नी अने पीतळ नी ह़ाकळ वेर बांदीन चोवगान ना लील्‌ला चारा नी वचे रेवा देवो, काहाके तीहयु ह़रग नु झाकळु सी भीग्‌या करे, अने तीने चोवगान ना जानवरु नी ह़ाते चारो चरे; अने सात साल लग आहयु आसवी हालत मे रेय।<verse eid="DAN 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 4:24" />ए राजा, आनु मतलब आहयु से के आखा मे मुख्‌यो भगवान ठान लेदलो से के राजा तारी जीवाय मे हये, तीहयु आहयु से: <verse eid="DAN 4:24" /><verse number="25" style="v" sid="DAN 4:25" />के तने माणहु नी वचे गेथो नीकाळ देहे, अने चोवगान ना जानवरु नी ह़ाते रेही; तु बोळद्‌या नी तेम चारो चरही; अने ह़रग नु झाकळु सी भीग्‌या करही; अळी सात साल लग तारी हालत आसवी रेहे, जत्‌यार लग तु नी जाण लेय के माणहु ना राज पोर आखा मे मुख्‌यो भगवानेत राज करे, अने जीने गमे तीने तीहयो आप देय। <verse eid="DAN 4:25" /><verse number="26" style="v" sid="DAN 4:26" />चोखलो ह़रगदुत आहयो हुकम आपलो हतो के थुड़ ने मुळ्‌या भेळ छोड़ देवो, आनु मतलब आहयु से के तारु राज्‌य तारी जुगु बणीन रेहे; अने जत्‌यार तु जाण लेही के आखी कळी नो मालीक ह़रग मेत से, तत्‌यार तु अळी राज करही। <verse eid="DAN 4:26" /><verse number="27" style="v" sid="DAN 4:27" />आनीन करते, ए राजा, मारी आहयी वात मान ले, के कदीम तु पाप सोड़ीन गरीब माणहु पोर दया करे, ता पक्‌कु से के आसम करवा सी तारी सुक-सांती बणीन रेहे।<verse eid="DAN 4:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 4:28" />आहयु आखु कंय नबुकदनेस्‌सर राजा पोर हय ज्‌यु। <verse eid="DAN 4:28" /><verse number="29" style="v" sid="DAN 4:29" />बारे मयना वीतवान अळतेण जत्‌यार तीहयो बेबीलोन ना राजा ना बंगला नी छत पोर फीरवा बाज रेलो हतो, तत्‌यार तीहयो केवा बाज ज्‌यो, <verse eid="DAN 4:29" /><verse number="30" style="v" sid="DAN 4:30" />तत्‌यार मे वीच्‌यार कर्‌यो, “ह़ु आहयु मोट्‌लु बेबीलोन ह़ेर नी हय? जीने मे मारी मोट्‌ली ताखत सी बणावलो से, काहाके आहयु मारी राजधानी बणे अने आनी लारे मारा राज-पाट नी बड़ाय हये।”<verse eid="DAN 4:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="DAN 4:31" />आहया बोल मारा मोडा मेत हता के ह़रगे गेथी अवाज ह़मळायी: “ए राजा नबुकदनेस्‌सर, तारा बारा मे आहयो हुकम नीकळलो से: राज्‌य तारा हात मे गेथु नीकळी ज्‌यु। <verse eid="DAN 4:31" /><verse number="32" style="v" sid="DAN 4:32" />अने तने माणहुम नी वचे गेथो नीकाळ देहे, अने चोवगान मे जानवरु नी ह़ाते रेही; अने बोळद्‌यान तेम चारो चरही, सात साल तक तारी आहयीत हालत रेहे। तीनीन अळतेण तने मालम पड़हे के आखा मे मुख्‌यो भगवानेत माणहु ना राज्‌य मे राज करे, अने तीने जे गमे तीने आहयु राज्‌य आप देय।”<verse eid="DAN 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="DAN 4:33" />तीहयीत टेमे आहयो बोल नबुकदनेस्‌सर ना बारा मे पुरो हयो। मने माणहु नी वचे गेथा नीकाळ देदा। में बोळद्‌यान तेम चारो खादो। मारु डील ह़रग नु झाकळु वेर भीगतु हतु। मारा नीम्‌बाळा घुवड़ ना पाखड़ान तेम नाम्‌बा हय ज्‌या अने मारा नखड़्‌या चड़ा ना पोगु ना नखड़्‌यान तेम नाम्‌बा हय ज्‌या।<verse eid="DAN 4:33" /></para>
  <para style="s">नबुकदनेस्‌सर नी लारे भगवान नी बड़ाय</para>
  <para style="p">
    <verse number="34" style="v" sid="DAN 4:34" />ह़ात साल वीतवान अळतेण नबुकदनेस्‌सर ह़रग भणी गरबाय सी डोळा उचा कर्‌यो, अने मारी अक्‌कल पासी आय जी। में आखा मे मुख्‌या भगवान ने जुगाळो केम, जे अमरकायो से। तीनी बड़ाय आहयु कीन करवा बाज ज्‌यो। तीनु राज हमेसा नु से, अने तीनु राज्‌य पीड़ी सी पीड़ी लग बणीन रेय। <verse eid="DAN 4:34" /><verse number="35" style="v" sid="DAN 4:35" />धरती ना आखा रेवा वाळा तीनी अगळ कंय बी नी हय, अने तीहयो ह़रग नी सेना अने धरती ना रेवा वाळा जीव नी वचे, आह़फा नी मरजी नी अनसारे काम करे; अने तीने कोय रोकीन आसम नी की सकत्‌लो के “तु आहयु ह़ु कर्‌यो?”<verse eid="DAN 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 4:36" />तीहयीत टेमे मारी अक्‌कल जेम हती तेम हयजी; अने मारा राज नी बड़ाय नी लेदे मारो ह़ेक अने पागड़ी पासी आय जी। मारा मंत्‌री अने मुख्‌या माणहु मने भेट करवा नी लेदे आव्‌वा बाज ज्‌या, अने में मारा राज्‌य मे राजा ना रुप मे गणाय ज्‌यो; अने मारी अळी जादा बड़ाय हयवा बाज जी।<verse eid="DAN 4:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="DAN 4:37" />“हाव में नबुकदनेस्‌सर ह़रग ना राजा ना गुण गावु; अने तीनी भक्‌ती अने बड़ाय करु, काहाके तीना आखा काम खरला, अने तीना आखा वेहवार नीयाव ना से; अने जे माणहु घमंड सी चाले, तीमने तीहयो नीचा कर सके।”<verse eid="DAN 4:37" /></para>
  <chapter eid="DAN 4" />
  <chapter number="5" style="c" sid="DAN 5" />
  <para style="s">बेलस्‌ससर नी लारे खाणु</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 5:1" />एक दाड़े राजा बेलसस्‌सर आह़फा ना एक हजार मुख्‌या ने मोट्‌ली पंगात मे खावा बोलायो, अने तीहयो तीमनी ह़ाते अंगुर नो माणलो रोह पीदो। <verse eid="DAN 5:1" /><verse number="2" style="v" sid="DAN 5:2" />अंगुर नो माणलो रोह पीतो-पीतो बेलसस्‌सर हुकम आप्‌यो, के ह़ोना-चांदी ना जे ठाहरा तीनो बाह नबुकदनेस्‌सर यरुसलेम ना मंदीर मे गेथो नीकाळ्‌ळो हतो, तीमने लावो अने आह़फा ना मुख्‌या, अने राण्‌या, अने पावर्‌याण भेळ तीमनी मे पीय। <verse eid="DAN 5:2" /><verse number="3" style="v" sid="DAN 5:3" />तत्‌यार जे ह़ोना ना ठाहरा यरुसलेम मे भगवान ना मंदीर मे गेथा नीकाळला हता, तीहया लाया; अने राजा आह़फा ना मुख्‌या अने राण्‌या, अने पावर्‌याण भेळ तीमनी मे पीवा बाज ज्‌यो। <verse eid="DAN 5:3" /><verse number="4" style="v" sid="DAN 5:4" />तीहया अंगुर नो माणलो रोह पी-पीन ह़ोना-चांदी, पीतळ, लुहड़ान, लाकड़ान, अने दगड़ा ना देवताम नी भक्‌ती करवा बाज ज्‌या।<verse eid="DAN 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 5:5" />तीहयी टेमे माणेह ना हात ना आंगळ्‌या ह़रका आंगळ्‌या नीकळीन दीवलाय नी ह़ामने राजमंदीर नु भीतड़ु ना चुना पोर कंय लीखवा बाज ज्‌या; अने हात नो जे हीस्‌सो लीखवा बाज र्‌यो हतो, तीहयो राजा ने देखाव पड़्‌यो। <verse eid="DAN 5:5" /><verse number="6" style="v" sid="DAN 5:6" />तीने देखीन राजो घबराय ज्‌यो, अने तीहयो मन मे मन मेत घबराय पड़्‌यो, अने तीनी केड़ ना जोड़ ढीला पड़ ज्‌या, अने कापता-कापता तीना घोटणा एक-बीजा ह़ाते टकरायवा बाज ज्‌या। <verse eid="DAN 5:6" /><verse number="7" style="v" sid="DAN 5:7" />तत्‌यार राजा ज्‌योरेत आड़ीन बड़वा, कसदी अने बीजा ह़ारो देखवा वाळा ने हजुर कराव्‌वा नो हुकम आप्‌यो। जत्‌यार बेबीलोन ना जानकारु ह़ाते आया, ता राजो तीमने केवा बाज ज्‌यो, “जे कोय ह़ेलु लीखलु ने भणीन तीनु मतलब मने ह़मजाड़े तीने जामण्‌या रंग नु लुगड़ु, अने तीना गळा मे ह़ोना नी ह़ाकळ पेरावही; अने तीहयो मारा राज्‌य नो तीसरो मुख्‌यो अदीकार्‌यो रेहे।” <verse eid="DAN 5:7" /><verse number="8" style="v" sid="DAN 5:8" />तत्‌यार राजा ना आखा जानकार माणहु मोय आया, पण तीहयु लीखलु ने नी भण सक्‌या अने राजा ने तीनु मतलब नी देखाड़ सक्‌या। <verse eid="DAN 5:8" /><verse number="9" style="v" sid="DAN 5:9" />तत्‌यार बेलसस्‌सर राजा घणो घबराय ज्‌यो अने तीना मोडा नो रंग बदली ज्‌यो; तीना मुख्‌या बी घण-जबर वहराय ज्‌या।<verse eid="DAN 5:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 5:10" />राजा अने मुख्‌या नी अवाज ह़मळीन, राणी खाणु खावा ना घोर मे आयी अने केवा बाज जी, “ए राजा, तु जलमको जीवत्‌लो रेय, आह़फा ना मन मे ना घबराये अने ना दुखी हये। <verse eid="DAN 5:10" /><verse number="11" style="v" sid="DAN 5:11" />तारा राज्‌य मे एक दानीयल नाम नु माणेह से, जीनु नाम तारो बाह बेलतसस्‌सर पाड़लो हतो, तीनी मे चोखला देवताम नी आत्‌मा रेय, अने तीहया राजा ना दाड़ा मे तीनी मे वीजाळु, ह़मजदार अने भगवान ने तेवी ह़मज से। ए राजा, तारो बाह जे राजो हतो, तीहयो तीने आखा जानकारु, महाराजु, कसदी अने ह़ारो देखवा वाळाम नो मुख्‌यो ठेरावलो हतो, <verse eid="DAN 5:11" /><verse number="12" style="v" sid="DAN 5:12" />काहाके तीनी मे वारली आत्‌मा, अक्‌कल अने ह़मज हती अने ह़पना नु मतलब देखाड़तो हतो अने दाखलाम ने ह़मजाड़ सकतो हतो, अने ने सेटी करवा नी सक्‌ती जड़ली हती, करीन हाव दानीयल ने बोलावो, अने तीहयो आहयु लीखलु नु मतलब देखाड़हे।”<verse eid="DAN 5:12" /></para>
  <para style="s">दानीयल नी लारे लीखलु नु मतलब देखाड़नु</para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 5:13" />तत्‌यार दानीयल ने राजा नी अगळ मोय बोलाया। राजो दानीयल ने पुछवा बाज ज्‌यो, “ह़ु तु तीहयो दानीयल से जे मारा बाह नबुकदनेस्‌सर राजा नी लारे यहुदा देस गेथो गुलामी मे लावलो से। <verse eid="DAN 5:13" /><verse number="14" style="v" sid="DAN 5:14" />में तारा बारा मे ह़मळ्‌ळो से के भगवान नी आत्‌मा तारी मे रेय; अने अक्‌कल, ह़मज अने वारलो ग्‌यान तारी मे जड़े। <verse eid="DAN 5:14" /><verse number="15" style="v" sid="DAN 5:15" />देख, हमणे जानकारु अने बड़वा माणहु मारी अगळ आनीन करते लावला हता के आहयु लीखलु ने भणे अने ईनु मतलब मने देखाड़े, पण तीहया तीहयी वात नु मतलब नी ह़मजाड़ सक्‌या। <verse eid="DAN 5:15" /><verse number="16" style="v" sid="DAN 5:16" />पण मे तारा बारा मे ह़मळ्‌ळो से के दानीयल ह़पना नु मतलब देखाड़ सके अने सण्‌का ने सेटी कर सके। करीन हाव कदीम तु तीहयु लीखलु ने भण सके अने तीनु मतलब मने ह़मजाड़ सके, ता तने जामण्‌या रंग ना लुगड़ा, अने तारा गळा मे ह़ोना नी ह़ाकळ पेरावही, अने राज्‌य मे तीसरो मुख्‌यो बणाय देही।”<verse eid="DAN 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 5:17" />दानीयल राजा ने केदो, “आह़फा नु दान तारीत पांह राख, अने जे ईलाम तु आपवा करी र्‌यो, तीहयु बीजा ने आप दे; तीहयी लीखली वात में राजा ने भणीन ह़मळावही, अने तीनु मतलब बी तने ह़मजाड़ही।<verse eid="DAN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 5:18" />“ए राजा, आखा मे मुख्‌यो भगवान तारा बाह नबुकदनेस्‌सर ने राज्‌य, बड़ाय ईज्‌जत अने ह़ेक आपलो से। <verse eid="DAN 5:18" /><verse number="19" style="v" sid="DAN 5:19" />अने तीहयी बड़ाय ना कारण सी जे तीहयो तीने आपलो हतो, देस-देस अने राज्‌य-राज्‌य ना आखा माणहु, अने भाती-भाती नी भासा बोलवा वाळा तीनी अगळ कापता अने थतरता हता; जीने तीहयो चाहतो हतो तीने तीहयो मारतो हतो, अने जीने तीहयो चाहतो हतो तीने तीहयो जीवत्‌लो राखतो हतो; जीने तीहयो चाहतो हतो तीने तीहयो उचो पद आपतो हतो, अने जीने तीहयो चाहतो हतो तीने तीहयो पद सी हेटो उतार देतो हतो। <verse eid="DAN 5:19" /><verse number="20" style="v" sid="DAN 5:20" />पण जत्‌यार तीनु मन घमंड सी भराय ज्‌यु, अने तीनी आत्‌मा वातड़ी हय जी, आञे तक के तीहयो मोटाय करवा बाज ज्‌यो, ता भगवान तीने राजगादी पोर गेथो उतार्‌यो, अने तीनी बड़ाय ने हापक लेदो। <verse eid="DAN 5:20" /><verse number="21" style="v" sid="DAN 5:21" />तीने माणहु मे गेथो नीकाळ देदो, अने तीनु मन जानवरुन तेवु हय ज्‌यु, अने तीनु रेवा नु जंगली गदड़ाम नी वचे हय ज्‌यु; तीहयो बोळद्‌यान तेम चारो चरतो हतो, अने तीनु डील वादळा नु झाकळु सी भीग्‌या करतु हतु, जत्‌यार तक के तीहयो जाण नी लेदो के आखा मे जोर-भर्‌यो भगवान माणहु ना राज्‌य मे राज करे अने जीने चाहे तीनेत तीनी पोर अदीकारी ठेरावे।<verse eid="DAN 5:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="DAN 5:22" />“ते बी, ए बेलसस्‌सर, तु जे तीनो सोरो से, अने आहयु आखु जाणतो हतो, ते बी तारु मन नीचळु नी हयु। <verse eid="DAN 5:22" /><verse number="23" style="v" sid="DAN 5:23" />पण तु ह़रग ना मालीक ना वीरोद मे मुंडु उचु करीन मंदीर ना ठाहरा मंगाड़ीन आह़फा नी अगळ मेकाड़ लेदो, अने आह़फा ना मुख्‌या अने राण्‌या अने पावर्‌याण भेळ तु तीमनी मे अंगुर नो माणलो रोह पीदो; अने ह़ोना-चांदी, पीतळ, लुहड़ा, लाकड़ा अने दगड़ा ना देवता, जे नी देखे नी ह़मळे, अने नी कंय जाणे, तीमनी ते भक्‌ती कर्‌यो पण भगवान, जीना हात मे तारो जीव से, अने जीना हक मे तारु आखु चालनु-फीरनु से, तीनी ईज्‌जत तु नी कर्‌यो।<verse eid="DAN 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 5:24" />“तात आहयो हात नो एक हीस्‌सो तीनीत भणी गेथो मोकल्‌लो से अने आहया सब्‌द लीखला से।<verse eid="DAN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 5:25" />“जे सब्‌द लीखला से तीहया आहया से: मने, मने, तकेल, अने उपर्‌सीन। <verse eid="DAN 5:25" /><verse number="26" style="v" sid="DAN 5:26" />आहयु लीखलु नु मतलब आहयु से: मने, मतलब भगवान तारा राज्‌य ना दाड़ा गणीन तीने खत्‌तम कर देदो। <verse eid="DAN 5:26" /><verse number="27" style="v" sid="DAN 5:27" />तकेल, मतलब तने ताकड़ी मे तोल्‌या पण तारो भार कम नीकळ्‌यो। <verse eid="DAN 5:27" /><verse number="28" style="v" sid="DAN 5:28" />परेस, मतलब तारा राज्‌य ने वाटीन मादीम ने अने फारसीम ने आप देदा।”<verse eid="DAN 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 5:29" />तत्‌यार बेलसस्‌सर हुकम आप्‌यो, अने दानीयल ने जामण्‌या रंग ना लुगड़ा अने तीना गळा मे ह़ोना नी ह़ाकळ पेराया; अने चोकीदार्‌या तीना बारा मे आड़्‌या के राज्‌य नो तीसरो मुख्‌यो अदीकार्‌यो दानीयल से। <verse eid="DAN 5:29" /><verse number="30" style="v" sid="DAN 5:30" />तीहयीत राते कसदीम ना राजा बेलसस्‌सर ने कोय मार नाख्‌यु। <verse eid="DAN 5:30" /><verse number="31" style="v" sid="DAN 5:31" />अने तीनु राज दारा नाम ना माणेह ने जे मादी घोराणा नो हतो जड़्‌यु। तीहयी टेमे दारा नी उमर बासट साल नी आड़े-धेड़े हती।<verse eid="DAN 5:31" /></para>
  <chapter eid="DAN 5" />
  <chapter number="6" style="c" sid="DAN 6" />
  <para style="s">दानीयल नाहर ना खाडा मे</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 6:1" />दारा ने आहयु वारु लाग्‌यु के आह़फा ना राज्‌य नी उपर एक ह़ोव वीह अदीकार्‌या ठेरायो, जे पुरा राज्‌य पोर हक राखे। <verse eid="DAN 6:1" /><verse number="2" style="v" sid="DAN 6:2" />अने तीमनी पोर तीहयो तीन मुख्‌या बणायो, जीनी मे गेथो दानीयल एक हतो, अने तीहया अदीकार्‌या लेखो-जोखो ईमने आप्‌या करता हता, आहयी रीते राजा नु कंय बी नुकसान नी हयतु हतु। <verse eid="DAN 6:2" /><verse number="3" style="v" sid="DAN 6:3" />जत्‌यार आहयु देख्‌या के दानीयल मे वारली आत्‌मा रेय, तत्‌यार तीने मुख्‌या अने अदीकार्‌या गेथी जादा ईज्‌जत जड़ी; अने राजा तीने पुरा राज्‌य पोर अदीकार्‌यो बणाव्‌वा चाह्‌यो। <verse eid="DAN 6:3" /><verse number="4" style="v" sid="DAN 6:4" />तत्‌यार मुख्‌या अने अदीकार्‌या राज्‌य ना काम ना बारा मे दानीयल ना वीरोद मे गुनो ह़ोदवा बाज ज्‌या; पण तीहयो भरहा लायक हतो, अने तीना काम मे कोय भुल नीता गुनो नी नीकळ्‌यो, अने तीहया नी ह़ोद सक्‌या। <verse eid="DAN 6:4" /><verse number="5" style="v" sid="DAN 6:5" />तत्‌यार तीहया माणहु केवा बाज ज्‌या, “आपणु तीहया दानीयल ना भगवान ना कायदा ने छोड़ीन, अळी बीजुन बारा मे तीना वीरोद मे कोय गुनो नी ह़ोद सकया।”<verse eid="DAN 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 6:6" />तत्‌यार तीहया मुख्‌या अने अदीकार्‌या राजान्‌तां साटात आया, अने तीने केदा, “ए राजा दारा, तु जलम जीवत्‌लो रेय। <verse eid="DAN 6:6" /><verse number="7" style="v" sid="DAN 6:7" />राज्‌य ना आखा अदीकार्‌या, मुख्‌या, मंतरी, जीला ना अदीकारी, अने मुख्‌या अदीकार्‌या एक-मन्‌या हय्‌न आहयो फेसलो लेदला से के राजा ने आहयी ह़ला आपया के राजा एवो हुकम नीकाळे, के तीस दाड़ा तक जे कोय, ए राजा, तने छोड़ीन काना बीजा माणेह नीता देवता पांह वीन्‌ती करे, तीने नाहर ना खाडा मे नाख देय। <verse eid="DAN 6:7" /><verse number="8" style="v" sid="DAN 6:8" />करीन ए राजा, हाव आसवो हुकम आप, अने आहयी चीट्‌ठी पोर साईन कर दे, जीनी सी आहयी वात, मादी अने फारसीम ना कायदा नी अनसारे, बदली नी सके।” <verse eid="DAN 6:8" /><verse number="9" style="v" sid="DAN 6:9" />तत्‌यार राजा दारा तीहयी हुकम नी चीट्‌ठी पोर साईन कर देदो।<verse eid="DAN 6:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 6:10" />जत्‌यार दानीयल ने आहयु मालम हयु के चीट्‌ठी पोर राजा दारा साईन कर देदलो से, तत्‌यार तीहयो आह़फा ना घोर मे ज्‌यो, तीना घोर नी उपरली मंजली नी खीड़की यरुसलेम ह़ेर भणी उगड़ली रेती हती। अने आह़फा नी रीती नी अनसारे तीहयो भगवान पांह दाड़ा मे तीन वार मांडा टेकीन वीन्‌ता करतो हतो अने घणो वारु से केतो हतो, तेमेत तीहयो तत्‌यार बी करतो र्‌यो।<verse eid="DAN 6:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 6:11" />तत्‌यार तीहया अदमी एक-मन्‌या हय्‌न आवीन दानीयल ने आह़फा ना भगवान नी ह़ामने वीन्‌ता करते अने रावण्‌या करते हात कर्‌या। <verse eid="DAN 6:11" /><verse number="12" style="v" sid="DAN 6:12" />हाव तीहया राजान्‌तां जीन, तीना राज हुकम ना बारा मे तीने केवा बाज ज्‌या, “ए राजा, ह़ु तु आसवो हुकम नी चीट्‌ठी पोर साईन नी कर्‌यो के जे माणेह तीस दाड़ा नी टेम मे तने छोड़ीन काना बीजा देवता नीता माणेह पांह वीन्‌ता करे, ता तीने नाहर ना खाडा मे नाख देय?” राजा जपाप आप्‌यो, “होव, मादी अने फारसी ना पक्‌का कायदा नी अनसारे आहयी वात पक्‌की से।”<verse eid="DAN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 6:13" />तत्‌यार तीहया राजा ने केदा, “यहुदी केदड़ा मे गेथो जे दानीयल से, तीहयो, ए राजा, नी ते तारी भणी धीयान देदो, अने नी तारा हुकम आपली चीट्‌ठी पोर; अने तीहयो दाड़ा मे तीन वार भगवान पांह वीन्‌ता कर्‌या करे।”<verse eid="DAN 6:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 6:14" />आहयी वात ह़मळीन राजा घणो नराज हय ज्‌यो, अने दानीयल ने बचाड़वा करीन वात सोचवा बाज ज्‌यो; अने दाड़ु ने बुडते लग तीने बचाड़वा नी कोसीत करतो र्‌यो। <verse eid="DAN 6:14" /><verse number="15" style="v" sid="DAN 6:15" />तत्‌यार तीहया माणहु राजान्‌तां उतवाळ्‌या आवीन केवा बाज ज्‌या, “ए राजा, आहयु जान ले के मादी अने फारसीम नी मे आहयो कायदो से के जे हुकम राजा ठेराय देय तीने कोय नी बदल सकतो।”<verse eid="DAN 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="DAN 6:16" />तत्‌यार राजा हुकम आप्‌यो, अने दानीयल ने लावीन नाहर ना खाडा मे नाख देदा। तीहयी टेमे राजा दानीयल ने केदो, “तारो भगवान, जीनी तु हमेसा भक्‌ती करे, तीहयोत तने वचाड़े।” <verse eid="DAN 6:16" /><verse number="17" style="v" sid="DAN 6:17" />तत्‌यार एक मोट्‌लो दगड़ो लावीन तीहया खाडा ना मोडा पोर मेक देदा, अने राजा तीनी पोर आह़फा नी वीटीन छाप लगाड़ देदो के दानीयल ना बारा मे कंय नी बदलवा जोवे। <verse eid="DAN 6:17" /><verse number="18" style="v" sid="DAN 6:18" />तत्‌यार राजा आह़फा ना कीला मे जत र्‌यो, अने तीहयी राते तीहयो खाणु नी खादो अने खेल-नाटक नी देख्‌यो अने तीने नींदर नी आयी।<verse eid="DAN 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 6:19" />ह़वारे परगड़ फाटतेत दारा राजो उठ्‌यो अने नाहर ना खाडा भणी साटोत जत र्‌यो। <verse eid="DAN 6:19" /><verse number="20" style="v" sid="DAN 6:20" />जत्‌यार राजो खाडा नी ह़ाते आयो, तत्‌यार दुखी हय्‌न आड़वा बाज ज्‌यो अने दानीयल ने केदो, “ए दानीयल, ए जीवत्‌ला भगवान ना चाकर्‌या, ह़ु तारो भगवान जीनी तु जलम भक्‌ती करे, तने नाहर सी बचाड़ लेदो?”<verse eid="DAN 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 6:21" />तत्‌यार दानीयल राजा ने केदो, “ए राजा, तु हमेसा जीवत्‌लो रेय। <verse eid="DAN 6:21" /><verse number="22" style="v" sid="DAN 6:22" />मारो भगवान आह़फा ना ह़रगदुत ने मोकलीन नाहर ना मोडा ने आसम बंद कर देदो के तीहया मारु कंय बी नुकसान नी कर्‌या; आनो कारण आहयो से के में तीनी अगळ वण-गुनाळ्‌ळो हतो; अने ए राजा, में तारी ह़ामने बी कंय भुल नी कर्‌यो।”<verse eid="DAN 6:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 6:23" />तत्‌यार राजो घणो खुस हय्‌न, दानीयल ने खाडा मे गेथो नीकाळवा नो हुकम आप्‌यो। तत्‌यार दानीयल ने खाडा मे गेथो नीकाळ्‌या। तीना डील पोर एक घाव तक नी लाग्‌यो, काहाके तीहयो आह़फा ना भगवान पोर भरहो करतो हतो। <verse eid="DAN 6:23" /><verse number="24" style="v" sid="DAN 6:24" />तत्‌यार राजा हुकम आप्‌यो के जे अदमी दानीयल पोर गुनो लगाड़ला हता, तीमने आह़फा-आह़फाम ना सोरा-सोरी अने बयरा भेळ लावीन नाहर ना खाडा मे नाख देवो; अने तीहया खाडा ना बुंदे तक बी नी ज्‌या अने नाहर तीमने उपरेत झेलीन हाटका भेळ खाय ज्‌या।<verse eid="DAN 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 6:25" />तत्‌यार दारा आखी धरती पोर रेवा वाळा देस-देस अने राज्‌य-राज्‌य ना आखा माणहु, अने अलग-अलग भासा बोलवा वाळा माणहु नी जुगु आहयु लीख्‌यो, “तमारी सुक-सांती रात-दाड़ो बड़ती जाय! <verse eid="DAN 6:25" /><verse number="26" style="v" sid="DAN 6:26" />में आहयो हुकम आपु के जां-जां मारा राज्‌य नो हक से, तां वाळा माणहु दानीयल ना भगवान नी ह़ामने कापता अने बीहता रेहे, काहाके जीवत्‌लो अने हमेसा रेवा वाळो भगवान तीहयोत से; तीनु राज्‌य कदी नी खत्‌तम हये अने तीनु राज हमेसा रेहे। <verse eid="DAN 6:26" /><verse number="27" style="v" sid="DAN 6:27" />जे दानीयल ने नाहर सी बचाड़लो से, तीहयोत बचाड़वा अने छोड़ाव्‌वा वाळो से; अने ह़रग मे अने धरती पोर सेलाणी अने चमत्‌कारु ने उजन्‌ता करवा वाळो से।”<verse eid="DAN 6:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 6:28" />आहयी रीते दानीयल, दारा अने कुस्‌रु फारसी, बेम ना राज्‌य ना दाड़ा मे सुख सी र्‌यो।<verse eid="DAN 6:28" /></para>
  <chapter eid="DAN 6" />
  <chapter number="7" style="c" sid="DAN 7" />
  <para style="s">दानीयल नी लारे दरसन ना बारा मे देखाड़नु</para>
  <para style="r">(<ref loc="DAN 7:1-12:13">दानीयल 7:1–12:13</ref>)</para>
  <para style="s">च्‌यार जानवर</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 7:1" />बेबीलोन ना राजा बेलसस्‌सर ना पेल्‌ला साल मे, दानीयल खाट्‌लु पोर ह़ुवतो जीन एक ह़पनु अने दरसन देख्‌यो। तत्‌यार तीहयो ते ह़पनु ने लीख्‌यो, अने ह़पनु नो ह़ारो देखाड़्‌यो। <verse eid="DAN 7:1" /><verse number="2" style="v" sid="DAN 7:2" />दानीयल आहयु केदो, में राते आहयु ह़पनु देख्‌यो के मोट्‌ली दर्‌या पोर ह़रग नी च्‌यारो-मेर गेथी आंजी आव्‌वा बाज जी। <verse eid="DAN 7:2" /><verse number="3" style="v" sid="DAN 7:3" />तत्‌यार दर्‌या मे च्‌यार मोटा-मोटा जीव नीकळ्‌या, जे एक बीजा गेथा अलग हता।<note caller="+" style="x"><char style="xo" closed="false">7:3 </char><char style="xt" closed="false"><ref loc="REV 13:1">परकासीतवाक्‌य 13:1</ref>; <ref loc="REV 17:8">17:8</ref></char></note> <verse eid="DAN 7:3" /><verse number="4" style="v" sid="DAN 7:4" />पेल्‌लो जीव नाहर ने तेवो हतो, अने तीना पाखड़ा घुवड़ ने तेवा हता। जत्‌यार में तीने देखवा बाज र्‌यो हतो ता तीना पाखड़ा उखड़ देदा, तीने भोयमे गेथा चुट्‌या अने माणहुन तेम पोगु पोर उबो कर्‌या; अने तीने माणहुन दील आप्‌या।<verse eid="DAN 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 7:5" />अळतेण में एक अळी जीव देख्‌यो जे रीछड़ान तेवो हतो, अने पाछला पोगु ना भरहे उबो हतो, अने तीहयो एक ह़ोड़ तणाय्‌न उबो हयो। तीना दातु नी वचे तीन पाहळी हती, “अने माणहु तीने केवा बाज र्‌या हता, उठीन ढेरेत मांह खा।”<verse eid="DAN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="DAN 7:6" />आनीन अळतेण मे नींगा कर्‌यो अने देख्‌यो, के चीतान तेवो एक जीव से जीना वाहां पोर चड़ान तेवा च्‌यार पाखड़ा से; अने तीहया जीव ना च्‌यार मुंडा हता। अने तीने राज करवा नो हक आप्‌या।<verse eid="DAN 7:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 7:7" />अळी आनीन अळतेण में ह़पना मे देख्‌यो के एक चोवथु जानवर से जे जुदु मोटु अने बीहाड़े एवु अने ताखत वाळु से; अने तीना मोडा मे लुहड़ा ना मोटा-मोटा दात से; तीहयु आखु कंय खाय जाय अने कटका-कटका कर देतु हतु, अने जे बच जाय तीने पोगु तळे रोंदळी देय। तीहयु आखा पेल्‌ना जानवरु गेथु अलग से; अने तीना दह ह़ींगड़ा हता।<note caller="+" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="REV 12:3">परकासीतवाक्‌य 12:3</ref>; <ref loc="REV 13:1">13:1</ref> </char></note> <verse eid="DAN 7:7" /><verse number="8" style="v" sid="DAN 7:8" />में तीहया ह़ींगड़ा ने ध्‌यान सी देखवा बाज र्‌यो हतो ता ह़ु देख्‌यो के तीमनी वचे एक नान्‌लु ह़ींगड़ु नीकळ्‌यु जीना कारण तीन ह़ींगड़ा उखड़ी ज्‌या; अळतेण मे देख्‌यो के आहयु ह़ींगड़ु मे माणहु ना डोळान तेवा डोळा हता, अने तीनी मे मोडु बी हतु जे मोटी-मोटी वात करतु हतु।<note caller="+" style="x"><char style="xo" closed="false">7:8 </char><char style="xt" closed="false"><ref loc="REV 13:5-6">परकासीतवाक्‌य 13:5-6</ref></char></note><verse eid="DAN 7:8" /></para>
  <para style="s">जलम रेवा वाळान दरसन</para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 7:9" />मे देखतो-देखतो आखरी मे ह़ु देख्‌यो, के राजगादी ने मेक देदा, अने एक पेल्‌ना वारा नो माणेह बह्‌यो। तीना लुगड़ा बरप ने तेवा धोळ्‌ळा उजळा हता, अने मुंडा ना नीम्‌बाळा पीवर हीर ने तेवा अने तीनी राजगादी आक्‌ठुन तेवी अने तीना चाकटा हुड़ु-हुड़ु धपत्‌लु आक्‌ठुन तेवा देखाव पड़ता हता।<note caller="+" style="x"><char style="xo" closed="false">7:9 </char><char style="xt" closed="false"><ref loc="REV 20:4">परकासीतवाक्‌य 20:4</ref>; <ref loc="REV 1:14">1:14</ref></char></note> <verse eid="DAN 7:9" /><verse number="10" style="v" sid="DAN 7:10" />तीहया पेल्‌ना वारा ना माणेह नी अगळ गेथी आक्‌ठु नी धार नीकळीन वयवा बाज री हती; अळतेण हजारु-हजारु माणहु तीनी चाकरी करवा बाज र्‌या हता। अने लाखो-लाखो माणहु तीनी अगळ हजुर हता; अळतेण नीयाव करन्‌या बह्‌या, अने कीताप्‌या उगाड़्‌या।<note caller="+" style="x"><char style="xo" closed="false">7:10 </char><char style="xt" closed="false"><ref loc="REV 5:11">परकासीतवाक्‌य 5:11</ref>; <ref loc="REV 20:12">20:12</ref></char></note><verse eid="DAN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 7:11" />तीहयी टेमे तीहया ह़ींगड़ा नी मोटी-मोटी वात ह़मळीन मे देखतो र्‌यो, अने देखते-देखते आखरी मे देख्‌यो के तीहयु जानवर ने मार नाख्‌या, अने तीनु डील ने आक्‌ठा मे धपाड़ीन खत्‌तम कर देदा। <verse eid="DAN 7:11" /><verse number="12" style="v" sid="DAN 7:12" />बचला जानवरु नो हक हापकी लेदा, पण तीमनो जीव थोड़ाक दाड़ान करते बचाड़ लेदा।<verse eid="DAN 7:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 7:13" />में राते दरसन देख्‌यो, अने आहयु देख्‌यो के ह़रग ना वादळा भेळ माणेह ना सोरान तेम कोय आव्‌वा बाज र्‌यु हतु, अने तीहयु तीहया पेल्‌ना वारा ना माणेह ने तां पुग्‌यु, अने तीने तीहया तीनी ह़ाते लाया।<note caller="+" style="x"><char style="xo" closed="false">7:13 </char><char style="xt" closed="false"><ref loc="MAT 24:30">मत्‌ती 24:30</ref>; <ref loc="MAT 26:64">26:64</ref>; <ref loc="MRK 13:26">मरकुस 13:26</ref>; <ref loc="MRK 14:62">14:62</ref>; <ref loc="LUK 21:27">लुका 21:27</ref>; <ref loc="REV 1:7">परकासीतवाक्‌य 1:7</ref>,<ref loc="REV 1:13">13</ref>; <ref loc="REV 14:14">14:14</ref> </char></note> <verse eid="DAN 7:13" /><verse number="14" style="v" sid="DAN 7:14" />तत्‌यार तीने एवो हक, बड़ाय अने राज्‌य आप्‌या, के देस-देस अने राज्‌य-राज्‌य ना माणहु अने अलग-अलग भासा बोलवा वाळा आखा तीना हक मे हये; तीनु राज कदी नी खत्‌तम हयवा वाळु राज्‌य ठेर्‌यु।<note caller="+" style="x"><char style="xo" closed="false">7:14 </char><char style="xt" closed="false"><ref loc="REV 11:15">परकासीतवाक्‌य 11:15</ref></char></note><verse eid="DAN 7:14" /></para>
  <para style="s">दरसन नु मतलब</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 7:15" />में दानीयल नु मन फीकर मे पड़ ज्‌यु, अने जे कंय में देखलो हतो तीना कारण सी मे घबराय ज्‌यो। <verse eid="DAN 7:15" /><verse number="16" style="v" sid="DAN 7:16" />तत्‌यार जे माणहु ह़ाते उबा हय र्‌या हता, तीमनी मे गेथा एक ने तां जीन में तीहया आखा दरसन ना बारा मे पुछ्‌यो, तीहयो आहयु कीन मने तीहयी वात ना बारा नु मतलब देखाड़्‌यो। <verse eid="DAN 7:16" /><verse number="17" style="v" sid="DAN 7:17" />“तीहया च्‌यार मोट्‌ला जानवरु नु मतलब च्‌यार राजा से, जे धरती पोर उबजहे। <verse eid="DAN 7:17" /><verse number="18" style="v" sid="DAN 7:18" />पण आखा मे मुख्‌या भगवान ना चोखला माणहुत राज्‌य हात करहे, अने जलम तक तीना अदीकारी बणीन रेहे।”<note caller="+" style="x"><char style="xo" closed="false">7:18 </char><char style="xt" closed="false"><ref loc="REV 22:5">परकासीतवाक्‌य 22:5</ref> </char></note><verse eid="DAN 7:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="DAN 7:19" />तत्‌यार मारा मन मे आहयी ईच्‌छा हयी के तीहया चोवथा जानवर ना बारा मे बी जाण लेम जे बीजा तीन जानवरु गेथु अलग अने घणु जुदु हतु अने तीना दात लुहड़ा ना अने नखड़्‌या पीतळ ना हता; तीहयु आखु कंय खाय जतु हतु, अने चुरा-चुरा करतु हतु अने बचला ने पोगु वेर रोंदळी नाखतु हतु। <verse eid="DAN 7:19" /><verse number="20" style="v" sid="DAN 7:20" />अळतेण तीना मुंडा मे दह ह़ींगड़ा नी ह़तायली वात, अने जे नवला ह़ींगड़ा ने नीकळवा सी तीन ह़ींगड़ा पड़ ज्‌या, मतलब जे ह़ींगड़ा ना डोळा अने मोटा बोल बोलवा वाळु मोडु अने आखा बीजा ह़ींगड़ा गेथा जादा घणु जुदु हतु, तीनी बी ह़तायली वात ना बारा मे जाणवा नी मने ईच्‌छा हयी।<verse eid="DAN 7:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 7:21" />अळतेण में देखलो हतो के तीहयु ह़ींगड़ु तीहया चोखला माणहु नी ह़ाते लड़ाय करीन तीमनी पोर तीहयी टेमे तक भारी पड़्‌यु।<note caller="+" style="x"><char style="xo" closed="false">7:21 </char><char style="xt" closed="false"><ref loc="REV 13:7">परकासीतवाक्‌य 13:7</ref></char></note> <verse eid="DAN 7:21" /><verse number="22" style="v" sid="DAN 7:22" />जत्‌यार तक तीहयो घणो पेल्‌ना वारा नो अदमी नी आयो, अने आखा मे मुख्‌या भगवान ना चोखला माणहु नीयाव करन्‌या नी ठेर्‌या, अने नी तीहया चोखला माणहु नी राज्‌य ना अदीकारी हयवा नी टेम आय लागी।<note caller="+" style="x"><char style="xo" closed="false">7:22 </char><char style="xt" closed="false"><ref loc="REV 20:4">परकासीतवाक्‌य 20:4</ref></char></note><verse eid="DAN 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 7:23" />“तीहयो केदो, तीहया चोवथा जानवर नु मतलब, एक चोवथु राज्‌य से, जे धरती पोर उबजहे, अने आखा राज्‌य गेथु अलग रेहे, अने आखी धरती ने खत्‌तम करहे, अने दळीन चुरा-चुरा करहे। <verse eid="DAN 7:23" /><verse number="24" style="v" sid="DAN 7:24" />तीहया दह़ ह़ींगड़ा नु मतलब आहयु से, के तीहया राज्‌य मे गेथा दह़ राजा नीकळहे, अने तीमनी बाद तीहया पेल्‌नाम नी गेथो अलग एक अळी राजो नीकळहे, जे तीन राजाम ने पाड़ देहे,<note caller="+" style="x"><char style="xo" closed="false">7:24 </char><char style="xt" closed="false"><ref loc="REV 17:1">परकासीतवाक्‌य 17:1</ref></char></note> <verse eid="DAN 7:24" /><verse number="25" style="v" sid="DAN 7:25" />अने तीहयो आखा मे मुख्‌या भगवान ना वीरोद मे वातु केहे, अने आखा मे मुख्‌या ना माणहु ने दळ देहे, अने तीवार अने नेम ने बदल देवा नी आह करहे, अने साड़ी तीन साल तक तीहया आखा ने तीना हक मे कर देहे। <verse eid="DAN 7:25" /><verse number="26" style="v" sid="DAN 7:26" />पण, तत्‌यार आखा मे जोर-भर्‌यो भगवान नीयाव करवा बठहे, अने तीनो हक हापकीन खत्‌तम करीन मीटाड़ देहे; आञे लग के तीहयु पुरु खत्‌तम हय जहे। <verse eid="DAN 7:26" /><verse number="27" style="v" sid="DAN 7:27" />तत्‌यार राज्‌य, हक अने धरती पोर ना राज्‌य नी बड़ाय, ने आखा मे मुख्‌या भगवान ना माणहु मतलब चोखला माणहु ने आपहे, तीनु राज्‌य हमेसा नु राज्‌य से, अने आखा राज करवा वाळा तीना हक मे हयहे अने तीनो हुकम मानहे।”<note caller="+" style="x"><char style="xo" closed="false">7:27 </char><char style="xt" closed="false"><ref loc="REV 20:4">परकासीतवाक्‌य 20:4</ref>; <ref loc="REV 22:5">22:5</ref></char></note><verse eid="DAN 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="DAN 7:28" />“आहयी वात में हाव देखाड़ देदो, पण मारा मन मे घबरायलो र्‌यो, अने में बीह ज्‌यो; अने आहयी वात ने मे मारा मन मे राख्‌यो।”<verse eid="DAN 7:28" /></para>
  <chapter eid="DAN 7" />
  <chapter number="8" style="c" sid="DAN 8" />
  <para style="s">एक गाडरान अने एक बोकड़ान दरसन</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 8:1" />बेलसस्‌सर राजा ना राज्‌य ना तीसरा साल मे तीहया पेल्‌ना दरसन नी बाद एक अळी वात मने दानीयल ने दरसन नी लारे देखाव पड़ी। <verse eid="DAN 8:1" /><verse number="2" style="v" sid="DAN 8:2" />जत्‌यार में एलाम देस मे सुसन नाम ना कीला मे रेतो हतो, तत्‌यार में दरसन मे देख्‌यो के में उले नंदी नी काठे से। <verse eid="DAN 8:2" /><verse number="3" style="v" sid="DAN 8:3" />अळतेण में डोळा उचा करीन देख्‌यो, के तीहयी नंदी नी अगळ बे ह़ींगड़ा वाळु एक गाडरु उबु हय र्‌यु, तीना बेम ह़ींगड़ा मोट्‌ला से, पण तीनी मे गेथु एक जादा मोटु से, अने जे मोटु से, तीहयु नान्‌लु ह़ींगड़ुन अळतेण नीकळलु हतु। <verse eid="DAN 8:3" /><verse number="4" style="v" sid="DAN 8:4" />में देख्‌यो के गाडरु बुडवणु, दखणाव अने धुराव भणीन ह़ींगड़ु देय, अने कोय जानवर तीनी अगळ उबु नी री सकतु हतु, अने तीना हात मे गेथु कानो कोयने नी बचाड़ सकत्‌लो; तीहयु आह़फा नीत मरजी नी अनसारे काम करीन बड़तु जतु हतु।<verse eid="DAN 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 8:5" />में सोचवात बाज र्‌यो हतो, ता में ह़ु देख्‌यो के एक बोकड़ो बुडवणो भणी गेथो नीकळीन आखी धरती पोर आसम फीर्‌यो के चालती वखत भोय्‌मे पोग नी टेकव्‌यो अने तीहया बोकड़ा ना बेम डोळा नी वचे एक देखवा लायक ह़ींगड़ु हतु। <verse eid="DAN 8:5" /><verse number="6" style="v" sid="DAN 8:6" />तीहयो तीहया बे ह़ींगड़ा वाळा गाडरान्‌तां जीन, जीने में नंदी ना काठे देखलो हतो, तीने आहयो खीजवाय्‌न पुरी ताखत सी घोदो देदो। <verse eid="DAN 8:6" /><verse number="7" style="v" sid="DAN 8:7" />में देख्‌यो के तीहयो गाडरा नी ह़ाते आवीन तीनी पोर खीजवायो; अने गाडरा ने ठोकीन तीना बेम ह़ींगड़ा ने तोड़ नाख्‌यो; अने गाडरा मे एतरी ताखत नी री के तीनी ह़ामने टेक सके। ता बोकड़ो तीने भोयमे पाड़ीन रोंदळी नाख्‌यो; अने गाडरा ने तीना हात मे गेथु छोड़ाव्‌वा वाळु कोय नी जड़्‌यु।<verse eid="DAN 8:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 8:8" />तत्‌यार बोकड़ो घणो घमंड करवा बाज ज्‌यो, अने जत्‌यार तीहयो ताखत वाळो हयो ता तीनु ह़ींगड़ु टुट ज्‌यु, अने तीनी बदले देखवा लायक च्‌यार ह़ींगड़ा नीकळीन ह़रग मे च्‌यारो-मेर वदवा बाज ज्‌या।<verse eid="DAN 8:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 8:9" />अळतेण आहया च्‌यार ह़ींगड़ा मे गेथु एक ह़ींगड़ु मे एक अळी नान्‌लु ह़ींगड़ु नीकळ आयु। तीहयु नान्‌लु ह़ींगड़ु मोटु हयवा बाज ज्‌यु, अने मोटु हयतु-हयतु घणु मोटु हय ज्‌यु। आहयु ह़ींगड़ु दखणाव, उगवणी ह़ोड़ बड़वा बाज ज्‌यु अने आहयु ह़ींगड़ु घटाळ्‌ळी धरती भणीन अगु बड़्‌यु। <verse eid="DAN 8:9" /><verse number="10" style="v" sid="DAN 8:10" />तीहयु ह़रग नी सेना लग पुग ज्‌यु; अने तीहयु तारामंडळी मे गेथा कंय ताराम ने धरती पोर पाड़ नाख्‌यु।<note caller="+" style="x"><char style="xo" closed="false">8:10 </char><char style="xt" closed="false"><ref loc="REV 12:4">परकासीतवाक्‌य 12:4</ref></char></note> <verse eid="DAN 8:10" /><verse number="11" style="v" sid="DAN 8:11" />तीहयु ह़रग नी सेना ना मुख्‌या लग पुग ज्‌यु, अने तीनी हमेसा नी होम बादा बंद कर देदु; अने तीनो चोखलो रेवा नो जागो बी हेटो पाड़ देदु। <verse eid="DAN 8:11" /><verse number="12" style="v" sid="DAN 8:12" />अने माणहु ना गुना ना कारण सी हमेसा नी होम बादा नी भेळे सेना ने बी तीना हात मे कर देदा, अने तीहयु ह़ींगड़ु सच्‌चाय ने कादा मे भेसकी देदु, अने तीहयु काम करते-करते पुरु हय ज्‌यु।<verse eid="DAN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 8:13" />तत्‌यार में एक चोखला माणेह ने बोलते ह़मळ्‌यो; अळतेण एक अळी चोखलु माणेह तीहया पेल्‌ना बोलवा वाळा ने पुछ्‌यु, “हमेसा नी होम बादा अने उजाड़वा वाळा गुना ना बारा मे जे कंय दरसन देखलो से, तीहयो कारु तक पुरो हयहे; मतलब चोखला जागा ने अने सेना ने बेम ने रोंदळवा नु कारु तक हयतु रेहे?”<verse eid="DAN 8:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 8:14" />तत्‌यार तीहयो मने केदो, “जत्‌यार लग ह़ांतु अने ह़वारे बे हजार तीन ह़ोव वार लग नी हये, तत्‌यार लग तीहयु हयतु रेहे; तत्‌यार चोखलो जागो चोखो करहे।”<verse eid="DAN 8:14" /></para>
  <para style="s">जीब्‌राएल ह़रगदुत नी लारे दरसन ने देखाड़नु</para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 8:15" />आहयी वात दरसन मे देखीन, में दानीयल, आने ह़मजवा नी कोसीत करवा बाज ज्‌यो; एतरा मे माणेह नो रुप लीन कानु मारी अगळ उबु हय रेलु देखाव पड़्‌यु। <verse eid="DAN 8:15" /><verse number="16" style="v" sid="DAN 8:16" />तत्‌यार मने उले नंदी नी वचे एक माणेह नो बोल ह़मळाय पड़्‌यो, जे आड़ीन केतो हतो, “ए जीब्‌राएल, हीय्‌या माणेह ने तीनी देखली वात ह़मजाड़ दे।”<note caller="+" style="x"><char style="xo" closed="false">8:16 </char><char style="xt" closed="false"><ref loc="LUK 1:19">लुका 1:19</ref>,<ref loc="LUK 1:26">26</ref></char></note> <verse eid="DAN 8:16" /><verse number="17" style="v" sid="DAN 8:17" />तत्‌यार जां में उबो हतो, तां तीहयो मारी ह़ाते आयो; अने तीनी आवतेत में घबराय ज्‌यो; अने मोडा ना भरहे पड़ ज्‌यो। ता तीहयो मने केदो, “ए माणेह नी अवल्‌यात, तीहयी देखली वात ने ह़मज ले, काहाके तीमनु मतलब आखरीत नी टेम मे पुरु हयहे।” <verse eid="DAN 8:17" /><verse number="18" style="v" sid="DAN 8:18" />जत्‌यार तीहयो मार ह़ाते वात करवा बाज र्‌यो हतो, तत्‌यार में मारु मोडु धरती भणी करीन घणी नींदर मे पड़ र्‌यो हतो, पण तीहयो मने सीमीन ह़ुदो उबो कर्‌यो। <verse eid="DAN 8:18" /><verse number="19" style="v" sid="DAN 8:19" />तत्‌यार तीहयो केदो, रीह ना आखरी ना दाड़ा मे जे कंय हयहे, तीहयु में देखाड़ु; काहाके आखरी नी ठेरावली टेम मे तीहयु आखु पुरु हय जहे।<verse eid="DAN 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 8:20" />“जे बे ह़ींगड़ा वाळु गाडरु तु देखलो से, तीनु मतलब मादी अने फारसीम ना बे राज्‌य से। <verse eid="DAN 8:20" /><verse number="21" style="v" sid="DAN 8:21" />अने तीहयो रोवार बोकड़ो युनान नु राज्‌य से; अने तीना डोळा नी वचे जे मोट्‌लु ह़ींगड़ु नीकळलु से, तीहयु पेल्‌लो राजा से। <verse eid="DAN 8:21" /><verse number="22" style="v" sid="DAN 8:22" />तीहयु ह़ींगड़ु जे टुट जेलु अने तीनी बदले जे च्‌यार ह़ींगड़ा नीकळला, तीनु मतलब आहयु से के तीहयु राज्‌य सी च्‌यार राज्‌य बणहे, पण तीमनी ताखत पेल्‌नान तेम नी रेय।<verse eid="DAN 8:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="DAN 8:23" />“आहया च्‌यारोव राज्‌य ना आखरी दाड़ा मे, जत्‌यार तीमना पापु नो घड़ो भराय जहे, ता एक राजो पयदा हयहे। तीहयो घणो हटाळ्‌ळो अने गलत वेहवार अने धोको देवा वाळो राजा रेहे। <verse eid="DAN 8:23" /><verse number="24" style="v" sid="DAN 8:24" />तीनी सक्‌ती वदु बड़हे, पण तीहया पेल्‌ला राजान तेवो नी हये; अने तीहयो वहराड़ नाखे एवी रीते माणहु ने खत्‌तम करहे, अने अगो बड़तो जाय्‌न काम करतो जहे, ताखत वाळा अने चोखला माणहु ना टोळा ने खत्‌तम करहे। <verse eid="DAN 8:24" /><verse number="25" style="v" sid="DAN 8:25" />तीनी आह़फा नी चलाकी ना कारण तीनी चलाकी अगी बड़हे, अने तीहयो मन मे घमंड सी बीह्‌या वगर घणा माणहु ने मारहे। तीहयो आखा अदीकार्‌या ना अदीकारी ना वीरोद मे बी उबो हयहे; पण आखरी मे तीहयो कोय ना हात सी मार खाया वगर खत्‌तम हय जहे। <verse eid="DAN 8:25" /><verse number="26" style="v" sid="DAN 8:26" />ह़ांतु अने ह़वारे ना बारा मे जे कंय तु देखलो अने ह़मळलो से तीहयु खरलु से; पण जे कंय तु दरसन मे देखलो से तीने बंद राख, काहाके तीहयु ढेरेत दाड़ा नी अळतेण हयहे।”<verse eid="DAN 8:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="DAN 8:27" />तत्‌यार दानीयल आहयो दरसन देखीन एतरो कमजोर हय ज्‌यो के मांदो पड़लो र्‌यो, जत्‌यार में वारलो हयो ता में उठीन पासो राजा नु काम-काज करवा बाज ज्‌यो; पण जे कंय में देखलो हतो तीनी सी में वहरायलो र्‌यो, काहाके तीने कोय ह़मजाड़वा वाळु नी हतु।<verse eid="DAN 8:27" /></para>
  <chapter eid="DAN 8" />
  <chapter number="9" style="c" sid="DAN 9" />
  <para style="s">आह़फा ना माणहु नी लेदे दानीयल नी वीन्‌ता</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 9:1" />मादी सयर्‌स नो सोरो दारा, जीने कसदीयो ना देस पोर राजा बणावला हता, <verse eid="DAN 9:1" /><verse number="2" style="v" sid="DAN 9:2" />तीना राज्‌य ना पेल्‌ला साल मे, में दानीयल चोखली सास्‌तर नी लारे ह़मज लेदो के यरुसलेम नी उजड़ली हालत यहोवा ना तीहया बोल नी अनसारे जे यीरम्‌या भगवान वगे गेथी वात केवा वाळान्‌तां पुगलो हतो, कंय साल वीतवा पोर मतलब सत्‌तर साल नी बाद पुरी हय जहे।<note caller="+" style="x"><char style="xo" closed="false">9:2 </char><char style="xt" closed="false"><ref loc="JER 25:11">यीरम्‌या 25:11</ref>; <ref loc="JER 29:10">29:10</ref></char></note> <verse eid="DAN 9:2" /><verse number="3" style="v" sid="DAN 9:3" />तत्‌यार में मारा मालीक भगवान भणीन मोडु करीन पछतावो उजन्‌तो करवा करीन गोंटा ना लुगड़ा पेरीन, अने मारा मुंडा पोर रोखड़ो नाख्‌यो। में उपाह पाळ्‌यो। में भगवान नी गीण-दया हात करवा करीन रावण्‌या अने वीन्‌ती करवा बाज ज्‌यो। <verse eid="DAN 9:3" /><verse number="4" style="v" sid="DAN 9:4" />में मारा यहोवा भगवान पांह आहयी रीते वीन्‌ता कर्‌यो अने पाप ने मान लेदो, “ए मालीक, तु मोटो अने बीक मानवा लायक भगवान से, जे आह़फा ना मोंग राखवा अने हुकम मानवा वाळा ह़ाते आह़फा ना वायदा ने पुरो करे अने दया करे।<verse eid="DAN 9:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 9:5" />“आमु ते पाप, गलत काम, डहवाय अने गंडाय करला से, अने तारा हुकम ने अने नेम ने नी मान्‌या। <verse eid="DAN 9:5" /><verse number="6" style="v" sid="DAN 9:6" />तारा जे चाकर्‌या भगवान वगे गेथी वात केवा वाळा माणहु, अमारा राजा, अमारी पोर राज करन्‌या, आड़ा-बुड़ा अने आखा माणहु ह़ाते तारा नाम नी वात करता हता, तीमनी आमु नी ह़मळ्‌या। <verse eid="DAN 9:6" /><verse number="7" style="v" sid="DAN 9:7" />ए मालीक, तु खरलो से, पण आमु ने आज ना दाड़े लाजे पड़वा पड़े, मतलब यरुसलेम मे रेवा वाळा आखा यहुदीम ने, ह़ु ह़ाते, ह़ु नाम्‌बे वाळा आखा ईस्‌रायली माणहुम ने, जीमने तु तीहया धोका ना कारण सी जे तीहया तारी ह़ाते करला हता, देस-देस मे रीवण्‌या-तीवण्‌या कर देदलो से, तीहया आखा ने लाजे पड़वा पड़े। <verse eid="DAN 9:7" /><verse number="8" style="v" sid="DAN 9:8" />ए यहोवा, आमु अमारा राजा, अदीकार्‌या अने आड़ा-बुड़ाम नी ह़ाते तारा वीरोद मे पाप करला से, करीन आमने लाजे पड़वा पड़े। <verse eid="DAN 9:8" /><verse number="9" style="v" sid="DAN 9:9" />पण ए मालीक अमारा भगवान आमु तारा वीरोद मे काम करला हता, ते बी तु दयाळ्‌ळो अने माफ करन्‌यो से। <verse eid="DAN 9:9" /><verse number="10" style="v" sid="DAN 9:10" />अने आमु भगवान ना नेम नी अनसारे नी चाल्‌या, जे तु तारा चाकर्‌या भगवान वगे गेथी वात केवा वाळा नी लारे आमने देखाड़लो हतो। मालीक, आहयी रीते आमु अमारा मालीक भगवान नी वात नी ह़मळ्‌या। <verse eid="DAN 9:10" /><verse number="11" style="v" sid="DAN 9:11" />आखा ईस्‌रायली माणहु तारा कायदा ने नी मान्‌या, अने आसम सेटा हय ज्‌या के तारी नी ह़मळ्‌या। आहया कारण सी जे सराप नी वात भगवान ना चाकर्‌या मुसा नी कीताप मे लीखली से, तीहयो सराप अमारी पोर पुरो हय ज्‌यो, काहाके आमु तीना वीरोद मे पाप करला से।<note caller="+" style="x"><char style="xo" closed="false">9:11 </char><char style="xt" closed="false"><ref loc="DEU 27:15-26">वेवस्‌थावीवरन 27:15-26</ref></char></note> <verse eid="DAN 9:11" /><verse number="12" style="v" sid="DAN 9:12" />करीन तीहयो अमारा अने नीयाव करन्‌या ना बारा मे जे बोलु केदलो हतो, तीमने अमारी पोर मोट्‌ली गरा नाखीन पुरा करलो से; आञे तक के जेवी गरा यरुसलेम पोर आवली से, तेवी आखी धरती पोर अळी बीजे नी आयी। <verse eid="DAN 9:12" /><verse number="13" style="v" sid="DAN 9:13" />जीसम मुसा ना कायदा मे लीखलु से, तेमेत आहयी आखी गरा अमारी पोर आय पड़ली से, ते बी आमु आपणा भगवान यहोवा ने मनाड़वा नी लेदे नी ते आपणा गलत कामु सी फीर्‌या, अने नी तारी खरली वात पोर ध्‌यान देदा। <verse eid="DAN 9:13" /><verse number="14" style="v" sid="DAN 9:14" />आहया कारण यहोवा सोची-समजीन अमारी पोर गरा नाखलो से; काहाके अमारो भगवान यहोवा जेतरा काम करे तीहया आखा मे खरलो ठेरे; पण आमु तीनी नी मान्‌या।<verse eid="DAN 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 9:15" />“हाव, ए अमारा भगवान, ए मालीक, तु तारा माणहु ने मीस्‌र देस मे गेथो, ताखत वाळा हात वेर नीकाळ लावलो से अने आह़फा नु नाम आसम मोटु करलो, जे आज लग नामह़ाद्‌यु से, पण आमु पाप कर्‌या अने डहवाय बी कर्‌या। <verse eid="DAN 9:15" /><verse number="16" style="v" sid="DAN 9:16" />ए मालीक, अमारा पापु अने अमारा आड़ा-बुड़ा ना गलत कामु ना कारण यरुसलेम नी अने तारा माणहु नी, अमारी आड़े-धेड़े ना आखा माणहु मे नामबद्‌दी हय री; ते बी तु तारा आखा धरम ना कामु ना कारण सी आह़फा नी रीह अने खीज ने आह़फा ना ह़ेर पोर गेथी सेटी कर दे, जे तारा चोखला बड़ा पोर वहलु से। <verse eid="DAN 9:16" /><verse number="17" style="v" sid="DAN 9:17" />ए अमारा भगवान, आह़फा ना चाकर्‌या नी रावण्‌या अने वीन्‌ता ह़मळीन, आह़फा ना उजड़ला चोखला जागा पोर आह़फा ना मोडा नु वीजाळु भबळाव; ए मालीक, आह़फा ना नाम ना कारण सी आहयु कर। <verse eid="DAN 9:17" /><verse number="18" style="v" sid="DAN 9:18" />ए मारा भगवान, मारी वीन्‌ता भणीन आह़फा ना कान्‌टा लगाड़ अने तीने ह़मळ, डोळा उगाड़ीन अमारी उजड़ली हालत अने तीहया ह़ेर ने बी देख जे तारु केवाय; काहाके आमु जे तारी अगळ रावण्‌या करीन वीन्‌ता करया, तीहया अमारा धरम ना कामु पोर नी, पण तारी घणी दया नात कामु पोर भरहो राखीन करया। <verse eid="DAN 9:18" /><verse number="19" style="v" sid="DAN 9:19" />ए मालीक, अमारी वीन्‌ती ह़मळ ले; ए मालीक, अमारा पाप माफ कर; ए मालीक, धीयान सी जे करवा नु से तीने कर, वार ना लगाड़े; ए मारा भगवान, तारु ह़ेर अने तारा माणहु तारात केवाय; करीन तारा नाम ना कारण आसमेत कर।”<verse eid="DAN 9:19" /></para>
  <para style="s">जीब्‌राएल नु भगवान वगे गेथी वात ह़मजाड़नु</para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 9:20" />आहयी रीते में वीन्‌ती करु, अने मारा अने मारा ईस्‌रायली भायुम ना पापु ने मान्‌तो जाय्‌न, मारा भगवान यहोवा नी अगळ तीना चोखला बड़ा नी करते रावण्‌या करीन वीन्‌ता करतोत हतो, <verse eid="DAN 9:20" /><verse number="21" style="v" sid="DAN 9:21" />तत्‌यार तीहयो अदमी जीब्‌राएल जीने में तीहयी टेमे देखलो जत्‌यार में पेल्‌लो दरसन देखलो हतो, तीहयो उतवाळ्‌यो उडवा नो हुकम हात करीन, ह़ांत्‌ली टेमे नी अनबादा नी टेमे मने छीम लेदो; अने मने ह़मजाड़ीन मारी ह़ाते वात करवा बाज ज्‌यो।<note caller="+" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LUK 1:19">लुका 1:19</ref>,<ref loc="LUK 1:26">26</ref></char></note> <verse eid="DAN 9:21" /><verse number="22" style="v" sid="DAN 9:22" />तीहयो मने केदो, “ए दानीयल, में तने अक्‌कल अने ह़मज आपवा नीकळी आवलो से। <verse eid="DAN 9:22" /><verse number="23" style="v" sid="DAN 9:23" />जत्‌यार तु रावण्‌या करीन वीन्‌ता करवा बाज ज्‌यो, तत्‌यारुत आनो हुकम नीकळ्‌यो, करीन में तने देखाड़वा आवलो से, काहाके तु घणो मोंगाळ्‌ळो ठेरलो से; एतरे तीना बारा मे ह़मज ले अने दरसन नी वात नु मतलब जाण ले।<verse eid="DAN 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="DAN 9:24" />“तारा माणहु अने तारा चोखला ह़ेर नी लेदे सत्‌तर हप्‌ता ठेरावला से के तीने खत्‌तम हयते लग गुना हयवा बंद हये, अने पापु नु खत्‌तम अने अधरम नो पछतावो करे, अने जलम-जलम नी धारमीक्‌ता उजन्‌ती हये; अने दरसन नी वात पोर अने भगवान वगे गेथी केदली वात पोर छाप लगाड़े, अने आखा मे चोखला नु अभीसेक करे। <verse eid="DAN 9:24" /><verse number="25" style="v" sid="DAN 9:25" />करीन तु आहयी वात जाण अने आने ह़मज ले, के यरुसलेम ह़ेर ने पासु वह़ाड़वा ना हुकम ने नीकळवा सी लगाड़ीन अभीसेक करला मुख्‌या नी टेमे तक ह़ात हप्‌ता वीतहे। अळतेण बासट हप्‌ता वीतवा पोर चोवराया अने खोबारा भेळ तीहयु ह़ेर वेला नी टेम मे पासु वहाड़हे। <verse eid="DAN 9:25" /><verse number="26" style="v" sid="DAN 9:26" />तीहया बासट हप्‌ता पुरा हयवा पोर अभीसेक करला माणेह ने मार देहे: अने तीना हात मे कंय बी नी लागे; अने आव्‌वा वाळा मुख्‌या ना माणहु ह़ेर अने चोखला जागाम ने उजाड़ ते करहे। पण तीहया मुख्‌या नु खत्‌तम हयणु आसम हयहे जेम आंजी सी हये; ते बी आखरी तक लड़ाय हयती रेहे काहाके तीनु उजड़नु पक्‌कु हय जेलु से। <verse eid="DAN 9:26" /><verse number="27" style="v" sid="DAN 9:27" />तीहयो मुख्‌यो एक हप्‌तान करते घणा ह़ाते मजबुत वायदो करहे, पण आदोत हप्‌तो हयते तीहयो मेलबादा अने अनबादा ने बंद करहे; अने मुंदर पोर उजाड़वा वाळी ह़ीगी आवे एवी चीज देखाव पड़हे अने पक्‌की ठाणली वात ने खत्‌तम हयते तक भगवान नी रीह उजाड़वा वाळा पोर रेहे।”<note caller="+" style="x"><char style="xo" closed="false">9:27 </char><char style="xt" closed="false"><ref loc="DAN 11:31">दानीयल 11:31</ref>; <ref loc="DAN 12:11">12:11</ref>; <ref loc="MAT 24:15">मत्‌ती 24:15</ref>; <ref loc="MRK 13:14">मरकुस 13:14</ref></char></note><verse eid="DAN 9:27" /></para>
  <chapter eid="DAN 9" />
  <chapter number="10" style="c" sid="DAN 10" />
  <para style="s">दानीयल ने नंदी धेड़े दरसन जड़्‌यो</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 10:1" />फारस देस ना राजा कुस्‌रु ना राज्‌य ना तीसरा साल मे दानीयल पोर, जे बेलतसस्‌सर बी केवाये, एक वात उजन्‌ती कर्‌यो। तीहयी वात खरली हती के मोट्‌ली लड़ाय हयहे। तीहयो आहयी वात ने जाण लेदो, अने तीने आहयी देखली वात ह़मज आय जी।<verse eid="DAN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 10:2" />तीहया दाड़ा मे, दानीयल, तीन हप्‌ता लग दुखी हयतो र्‌यो। <verse eid="DAN 10:2" /><verse number="3" style="v" sid="DAN 10:3" />तीहया तीन हप्‌ता पुरा हयते लग, में नी ते ह़वादु खाणु खादो अने नी मांह खादो नी ते अंगुर नो माणलो रोह पीदो, अने नी मारा मुंडे तेल लगाड़्‌यो।<verse eid="DAN 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 10:4" />अळतेण पेल्‌ला मयना ना चोव्‌वीसवा दाड़े जत्‌यार मे हीदकेल नाम नी नंदी नी धेड़े हतो, <verse eid="DAN 10:4" /><verse number="5" style="v" sid="DAN 10:5" />तत्‌यार में डोळा उचा करीन देख्‌यो, के सुती ना लुगड़ा पेरीन, अने उफाज देस नु ह़ोनु नु फटकु वेर केड़ बांदीन एक अदमी उबो हय र्‌यो। से।<note caller="+" style="x"><char style="xo" closed="false">10:5 </char><char style="xt" closed="false"><ref loc="REV 1:13-15">परकासीतवाक्‌य 1:13-15</ref>; <ref loc="REV 2:18">2:18</ref>; <ref loc="REV 19:12">19:12</ref></char></note> <verse eid="DAN 10:5" /><verse number="6" style="v" sid="DAN 10:6" />तीनु डील फीरोजा नाम ना मोगला दगड़ान तेवु, तीनु मोडु वीजळीन तेवु, तीना डोळा धपत्‌ला दीवान तेवा, तीना हात अने पोग पपल्‌तलु पीतळ ने तेवा, अने तीना बोल भीड़ नी अवाज ने तेवा हता।<verse eid="DAN 10:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 10:7" />तीने में दानीयल एतरोत देख्‌यो, अने मारा ह़ाती माणहु तीनो कंय बी दरसन नी देख्‌या; पण तीहया घणा कापवा बाज ज्‌या, अने ह़तायवा करीन नाहवा बाज ज्‌या। <verse eid="DAN 10:7" /><verse number="8" style="v" sid="DAN 10:8" />तत्‌यार मे एखलो रीन आहयु जुदु दरसन देखतो र्‌यो, आनी सी मारी ताखत कम हय जी; मारो चमकत्‌लो सीको बीक नी करते ह़ुक ज्‌यो, अने मारी मे कंय बी ताखत नी री। <verse eid="DAN 10:8" /><verse number="9" style="v" sid="DAN 10:9" />ते बी में तीहया अदमी ना बोल ने ह़मळतो र्‌यो, अने जत्‌यार तीहयो मने ह़मळाय पड़्‌यो, तत्‌यार में मोडा ना भरहे पड़्‌यो अने घणी नींदर मे भोय्‌मे उन्‌दा मोडे पड़ र्‌यो। <verse eid="DAN 10:9" /><verse number="10" style="v" sid="DAN 10:10" />ता काना नो एक हात मने छीम्‌यो अने मारा थतरत्‌ला डील ने मारी हतळी अने मांडा ना भरहे उबो कर देदो।<verse eid="DAN 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 10:11" />तत्‌यार तीहयो मने केदो, “ए दानीयल, ए घणा मोंगाळ्‌ळा अदमी, जे बोल में तने केम तीने ह़मज ले, अने ह़ुदो उबो हय, काहाके मने हमणे तारीन्‌तां मोकल्‌ला से।” जत्‌यार तीहयो मने आहयो बोल केदो, तत्‌यार में उबो ते हय ज्‌यो पण थतरतो र्‌यो।<verse eid="DAN 10:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="DAN 10:12" />अळतेण तीहयो मने केदो, “ए दानीयल, ना बीहे, काहाके पेल्‌ला दाड़े जत्‌यार तु ह़मजवा नी लेदे मन लगाड़्‌यो अने आह़फा ना भगवान नी ह़ामने आह़फा ने नानो कर्‌यो, तीहयात दाड़े तारा बोल ह़मळ्‌यो, अने में तारा बोलु ना कारण आय लागलो से। <verse eid="DAN 10:12" /><verse number="13" style="v" sid="DAN 10:13" />फारस राज्‌य नो मुख्‌यो ईक्‌कीस दाड़ा लग मारी ह़ाते झुमायतो र्‌यो; पण मीकाएल जे आखा मे मुख्‌यो से, तीहयो मारी मदत नी लेदे आयो, करीन में फारस ना राजान्‌तां र्‌यो,<note caller="+" style="x"><char style="xo" closed="false">10:13 </char><char style="xt" closed="false"><ref loc="REV 12:7">परकासीतवाक्‌य 12:7</ref></char></note> <verse eid="DAN 10:13" /><verse number="14" style="v" sid="DAN 10:14" />अळी हाव में तने ह़मजाड़वा आवलो से, के आखरी दाड़ा मे तारा माणहु नी ह़ु हालत हयहे। काहाके जे दरसन तु देखलो से तीहयो थोड़ाक दाड़ान अळतेण पुरो हयहे।”<verse eid="DAN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="DAN 10:15" />जत्‌यार तीहयो अदमी मने आहयी वात की देदो, तत्‌यार में हेटु मोडु कर्‌यो अने होगो री ज्‌यो। <verse eid="DAN 10:15" /><verse number="16" style="v" sid="DAN 10:16" />तत्‌यार माणेह नी अवल्‌यात ने तेवो कानो मारा होट्‌या छीम्‌यो, अने में मोडु खोलीन बोलवा बाज ज्‌यो। जे मारी ह़ामने उबो हतो, तीन में केदो, “ए मारा मालीक, दरसन नी वात ना कारण सी में दुख उठायो, अने मारी मे कंय बी ताखत नी री। <verse eid="DAN 10:16" /><verse number="17" style="v" sid="DAN 10:17" />करीन मालीक नो चाकर्‌यो, आह़फा ना मालीक नी ह़ाते कीसम वात कर सके? काहाके मारा डील मे नी ते कंय ताखत री, अने नी कंय ह़ाह़ बचली हय।”<verse eid="DAN 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="DAN 10:18" />तत्‌यार तीहयो जे माणेह ने तेवो देखायतो हतो अळी मने छीम्‌यो अने मने ताखत आप्‌यो। <verse eid="DAN 10:18" /><verse number="19" style="v" sid="DAN 10:19" />अने तीहयो केदो, “ए भगवान ना घणा मोंगाळ्‌ळा अदमी, ना बीहे, तने सांती जड़े; तु ताखत वाळो रेय अने तारी हीम्‌मत बणीन रेय।” जत्‌यार तीहयो आहयु केदो, तत्‌यार में हीम्‌मत करीन केदो, “ए मारा मालीक, हाव के, काहाके तु मने हीम्‌मत आपलो से।”<verse eid="DAN 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 10:20" />तत्‌यार तीहयो केदो, “ह़ु तु जाणे के में काना कारण तारीन्‌तां आवलो से? हाव में फारस ना मुख्‌या ह़ाते झुमायवा करीन पासो जही; अने जत्‌यार में जही, ता ग्‌रीस नो मुख्‌यो आवहे। <verse eid="DAN 10:20" /><verse number="21" style="v" sid="DAN 10:21" />अळतेण जे वात खरला सास्‌तर मे लीखली से, तीहयी में तने देखाड़ु; तीहया मुख्‌या ना वीरोद मे, तमारा मुख्‌या मीकाएल ह़रगदुत ने छोड़ीन मारी ह़ाते उबो रेवा वाळो अळी बीजो कोय नी हय।<verse eid="DAN 10:21" /></para>
  <chapter eid="DAN 10" />
  <chapter number="11" style="c" sid="DAN 11" />
  <para style="p">
    <verse number="1" style="v" sid="DAN 11:1" />“दारा नाम ना मादी राजा ना राज्‌य ना पेल्‌ला साल मे तीने मदत करवा अने ताखत आपवा नी लेदे मेंत उबो हय ज्‌यो।<verse eid="DAN 11:1" /></para>
  <para style="s">मीस्‌र अने सीरीया देस ना राज्‌य</para>
  <para style="p">
    <verse number="2" style="v" sid="DAN 11:2" />“हाव में तने खरली वात देखाड़ु। देख, फारस ना राज्‌य मे हाव तीन अळी राजा उबजहे; अने चोवथो राजा तीमनी गेथो जादा पोमतो हय्‌हे; अने जत्‌यार तीहयो धन ना कारण सी ताखत वाळो हय्‌हे, तत्‌यार आखा माणहु ने ग्‌रीस ना राज्‌य ना वीरोद मे उबा हय्‌हे।<verse eid="DAN 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="DAN 11:3" />“आनीन अळतेण एक अळी ताखत वाळो राजा पयदा हयहे, जे मोटी सक्‌ती सी राज करहे; अने तीने जे वारु लागहे तीहयुत करहे। <verse eid="DAN 11:3" /><verse number="4" style="v" sid="DAN 11:4" />जत्‌यार तीहयु मोटु हयहे, तत्‌यार तीनु राज्‌य टुटीन च्‌यारोव ह़ोड़ वटाय्‌न अलग-अलग हय जहे। आहयु राज तीनी अवल्‌यात ने नी जड़े अने नी तीनी सक्‌ती नो फरक तीहया राज पोर पड़े, काहाके तीनु राज तीनी पांह गेथु हापकीन काना बीजा ने आप देहे।<verse eid="DAN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 11:5" />“तत्‌यार दखणाव ना मीस्‌र देस नो राजा ताखत वाळो बणहे। पण तीनो एक अदीकारी तीनी गेथो बी जादा ताखत वाळो बणीन राज करहे; आञे लग के तीनु राज्‌य राजा गेथु बी मोटु हय जहे। <verse eid="DAN 11:5" /><verse number="6" style="v" sid="DAN 11:6" />ढेरेत साल वीतवा अळतेण, आहया बेम भेळा हयहे, अने दखणाव ना मीस्‌र देस ना राजा नी सोरी धुराव ना सीरीया देस ना राजा ह़ाते वेवा करहे। पण तां राजा नी सोरी नी ताखत हमेसा नी चाले, अने नी तीहया राजा नु अने नी तीनु नाम चाले, पण तीहयी बयर ने पुगाड़वा वाळा अने तीनो बाह अने राखवा वाळ भेळ आखा ने मार नाखहे।<verse eid="DAN 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 11:7" />“तत्‌यार तीहयी सोरी ना घोराणा नो एक जणो तीना जागा पोर उठ पड़हे। तीहयो धुराव ना सीरीया देस ना राजा नी सेना पोर हमलो करहे, अने तीना कीला मे मोय भरायहे अने तीहयो तीमनी ह़ाते झुमायहे अने जीकहे। <verse eid="DAN 11:7" /><verse number="8" style="v" sid="DAN 11:8" />तत्‌यार तीहयो तीमना देवताम नी बणावली मुर्‌ती, अने ह़ोना-चांदी ना मोगला ठाहराम ने हापकीन मीस्‌र मे लीत्‌ती रेहे; आनीन अळतेण तीहयो कंय साल लग सीरीया देस ना राजा पोर हमलो नी करे। <verse eid="DAN 11:8" /><verse number="9" style="v" sid="DAN 11:9" />तत्‌यार तीहयो राजा दखणाव ना मीस्‌र देस ना राजान्‌तां हमलो करवा आवहे, पण हारवा नी बीक सी आह़फा ना देस मे पासो जत रेहे।<verse eid="DAN 11:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="DAN 11:10" />“अने तीना सोरा झुमायवा नी तीयारी करवा करीन एक मोट्‌ली सेना एक्‌ठी करहे, जे कोय नी रोक सके एवी आंजीन तेम साटीत अगी बड़हे अने लड़ाय ने तीना कीला तक लीजहे। <verse eid="DAN 11:10" /><verse number="11" style="v" sid="DAN 11:11" />तत्‌यार दखणाव ना मीस्‌र देस नो राजा खीजवाय्‌न आवहे, अने धुराव ना सीरीया देस ना राजा सी लड़ाय करहे, अने तीहयो राजा लड़ाय करवा नी लेदे एक मोट्‌ली सेना भेळी करहे, पण तीहयी सेना दखवरा देस ना राजा ना हात मे कर देहे। <verse eid="DAN 11:11" /><verse number="12" style="v" sid="DAN 11:12" />जत्‌यार दखणाव देस नो राजा तीनी सेना ने हरावहे, तत्‌यार तीनु मन घमंड सी भराय जहे, तीहयो लाखु माणहु ने मारहे, पण जीक नी सके।<verse eid="DAN 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 11:13" />“काहाके सीरीया देस नो राजा एक बीजी सेना बणाय लेहे जे तीनी पेल्‌नी सेना गेथी मोटी रेहे, अने कंय साल नी बाद, तीहयो पुरी तीयारी भेळ एक मोट्‌ली सेना ने लीन अगो बड़हे।<verse eid="DAN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="DAN 11:14" />“तीहया दाड़ा मे घणा माणहु दखणाव ना मीस्‌र देस ना राजा ना वीरोद मे आवहे; तारा माणहु मे गेथा बी कंय माणहु गलत करन्‌या नीकळहे, जीनी से आहया दरसन नी वात पुरी हय जहे; पण तीहया ठोकर खाय्‌न पड़हे। <verse eid="DAN 11:14" /><verse number="15" style="v" sid="DAN 11:15" />तत्‌यार तीहयो जे तीमना वीरोद मे आवहे, तीहयो जेम चाहे तेम करहे, अने कोय बी तीनी अगळ टेक नी सके। तीहयो आह़फा ने तीहया घटाळ्‌ळा देस मे उबो करहे, अने तीनी पांह तीने खत्‌तम करवा नी सक्‌ती रेहे। <verse eid="DAN 11:15" /><verse number="16" style="v" sid="DAN 11:16" />तत्‌यार तीहयो जे तीमना वीरोद मे आवहे, तीहयो जेम करवा चाहे तेम करहे, अने कोय बी तीनी ह़ामने टेक नी सके। तीहयो आह़फा ने तीहया घटाळा देस मे उबो करहे, अने तीनी पांह तीने खत्‌तम करवा नी सक्‌ती रेहे।<verse eid="DAN 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="DAN 11:17" />“तत्‌यार तीहयो आह़फा राज्‌य नी आखी ताखत भेळ, थोड़ाक वारला माणहु ने ह़ाते लीन आवहे, अने आह़फा नी मरजी नी अनसारे काम कर्‌या करहे। तीहयो तीनी ह़ाते आह़फा नी सोरी ह़ाते वेवा बी कराय देहे, ते बी तीनी आहयी योजना पुरी नी हये अने तीनो कंय बी फायदो नी हये। <verse eid="DAN 11:17" /><verse number="18" style="v" sid="DAN 11:18" />तत्‌यार तीहयो आह़फा नो धीयान दर्‌या नी काठे लगाड़हे अने तीमनी मे गेथा घणा राज्‌य ने आह़फा ना हक मे कर लेहे, पण एक सेना नो मुख्‌यो तीनी रीह ने खत्‌तम कर देहे; अने तीनी रीह नी अनसारे तीनी सी बदलो लेहे। <verse eid="DAN 11:18" /><verse number="19" style="v" sid="DAN 11:19" />तत्‌यार तीहयो आह़फा ना देस ना कीला भणी पासो जवा करहे। पण तीहयो वाट्‌ये ठोकर खाय्‌न पड़हे, अने तीहयो खत्‌तम हय जहे।<verse eid="DAN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="DAN 11:20" />“तत्‌यार तीना जागा पोर कोय आसवो राजा आवहे; जे राज-पाट नी बड़ाय ने बणावीन राखवा करीन फाळो एक्‌ठो करवा वाळो मोकलहे। पण तीहयो रीह नीता झुमाया वगरेत मरीन खत्‌तम हय जहे।”<verse eid="DAN 11:20" /></para>
  <para style="s">सीरीया देस नो वेरी राजो</para>
  <para style="p">
    <verse number="21" style="v" sid="DAN 11:21" />“तीना जागा मे एक बुरो माणेह उबो हयहे तीहयो राजगादी पोर बठहे पण तीहयो तीनी लायक नी रेय, ते बी तीहयो तीनी वारु-वारु वात करीन राज्‌य हात कर लेहे। <verse eid="DAN 11:21" /><verse number="22" style="v" sid="DAN 11:22" />तत्‌यार सेना तीनी अगळ पुरी खत्‌तम हय जहे, अने अमारा वायदा नो मुख्‌यो माणेह बी खत्‌तम हय जहे। <verse eid="DAN 11:22" /><verse number="23" style="v" sid="DAN 11:23" />काहाके तीहयो तीनी ह़ाते वायदो करवा पोर बी धोको देहे, अने थोड़ाकेत माणहु ने ह़ाते लीन सक्‌ती भेळ राज्‌य पोर राज करहे। <verse eid="DAN 11:23" /><verse number="24" style="v" sid="DAN 11:24" />जत्‌यार पोमत्‌ला राज्‌य ने आखु वारलु से लागहे, तत्‌यारुत तीहयो तीमनी पोर हमलो करहे; अने एवी जीक हात करहे, जेवी नी ते तीना बाह ना बाह अने नी आड़ा-बुड़ा करला हता। तीहयो लुटलु अने हापकलु ह़मान अने धन ने तीना माणहु मे वाट देहे। तीहयो कीलाम ने जीकवा करीन योजना बणावहे; पण थोड़ीकेत वार जुगु।<verse eid="DAN 11:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="DAN 11:25" />“तीनीन अळतेण तीहयो आह़फा नी ताखत अने हीम्‌मत ना कारण उतवाळ्‌यो हय्‌न एक मोट्‌ली सेना ने लीन दखणाव ना मीस्‌र देस पोर हमलो कर देहे। दखणाव ना मीस्‌र देस नो राजा बी तीनी ह़ाते मोट्‌ली सेना लीन हमलो ते करहे, पण तीनी अगळ टेक नी सके, काहाके माणहु तीना वीरोद मे योजना बणावहे। <verse eid="DAN 11:25" /><verse number="26" style="v" sid="DAN 11:26" />आञे तक के राजा नी लारे आपलु खाणु ने खाता हता, तीहयात माणहु तीने खत्‌तम करवा नी कोसीत करहे; तीनी सेना ने नहाड़ देहे, अने घणा ढेरका माणहु ने झुमायहे ता मार देहे। <verse eid="DAN 11:26" /><verse number="27" style="v" sid="DAN 11:27" />तत्‌यार तीहया बेम राजाम ना मन बुराय करवा मे लाग जहे, आञे लग के तीहया एक्‌ठा बहीन खाणु खावा नी टेमे बी झुट मेकहे, पण आनी सी कंय फायदो नी हये; काहाके ठेरावली टेम पोर आहयु आखु हयवा वाळु से। <verse eid="DAN 11:27" /><verse number="28" style="v" sid="DAN 11:28" />तत्‌यार धुराव देस नो राजा जादा लुटलु धन लीन आह़फा ना देस पासो जत रेहे, अने तीनु मन चोखला वायदा ना वीरोद मे हयहे, अने तीहयो आह़फा नी मरजी पुरी करीन आह़फा ना देस मे पासो जत रेहे।<verse eid="DAN 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="DAN 11:29" />“ठेरावली टेमे तीहयो पासो दखणाव ना मीस्‌र देस भणी आवहे, पण तीहयी पाछली वार ने तेम आहयी वार तीनो अदीकार नी चाले। <verse eid="DAN 11:29" /><verse number="30" style="v" sid="DAN 11:30" />काहाके कीत्‌तीयो ना मोट्‌ला ढुन्‌ड्‌या तीना वीरोद मे आवहे, अने तीहयो बीहीन पासो जत रेहे, अने चोखला वायदा पोर खीजवाय्‌न आह़फा नी मरजी पुरी करहे। तीहयो पासो जीन चोखला वायदा ने तोड़वा वाळा नी खबर लेहे। <verse eid="DAN 11:30" /><verse number="31" style="v" sid="DAN 11:31" />तत्‌यार सेना ना टोळा उबा हयहे, अने मजबुत चोखला जागा ने वीटाळहे, अने हमेसा नी होम बादा ने बंद कर देहे। तीहया ते ह़ीगी आवे एवी चीज ने चड़ावहे जे उजाड़ कराय देय;<note caller="+" style="x"><char style="xo" closed="false">11:31 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानीयल 9:27</ref>; <ref loc="DAN 12:11">12:11</ref>; <ref loc="MAT 24:15">मत्‌ती 24:15</ref>; <ref loc="MRK 13:14">मरकुस 13:14</ref></char></note> <verse eid="DAN 11:31" /><verse number="32" style="v" sid="DAN 11:32" />अने जे माणहे गांडा हय्‌न तीहया वायदा ने तोड़हे, तीमने तीहयो वारु-वारु वात कीन भटकाड़ देहे। पण जे माणहु भगवान ने जाणता हहे तीहया हीम्‌मत करीन काम करहे। <verse eid="DAN 11:32" /><verse number="33" style="v" sid="DAN 11:33" />जे माणहु ह़मजदार से, तीहया बीजा माणहु ने ह़मजाड़हे, ते बी तीहया ढेरेत दाड़ा लग तलवार वेर मरीन अने आक्‌ठा मे धपीन, अने गुलामी मे जाय्‌न अने लुटाय्‌न, घणा दुख मे पड़ रेहे। <verse eid="DAN 11:33" /><verse number="34" style="v" sid="DAN 11:34" />जत्‌यार तीहया दुख मे पड़हे तत्‌यार थोड़ीक मदत जड़हे, पण ढेरेत माणहु वारु-वारु वात करीन तीमनी ह़ाते भेसकाय जहे। <verse eid="DAN 11:34" /><verse number="35" style="v" sid="DAN 11:35" />अने थोड़ाक ह़मजदार माणहु बी वायदा सी पड़ जहे, तीहया आनीन करते भटक जहे के भरहा नी लेदे जाचहे अने पारखहे, तीहया तीमना भरहा मे चोखा अने उजळा करे। आहयी हालत आखरी टेम लग बणीन रेहे, काहाके आहयी आखी वात नु खत्‌तम हयणु ठेरावली टेम मे पुरु हयहे।<verse eid="DAN 11:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="DAN 11:36" />“तत्‌यार तीहयो सीरीया नो राजा आह़फा नी मरजी नी अनसारे काम करहे, अळी आह़फा ने आखा देवता गेथो उचो अने मोटो ठेरावहे; अने आखा देवताम ना भगवान ना वीरोद मे अलग वात केहे। जत्‌यार लग भगवान नी रीह कम नी हये तत्‌यार लग तीहया राजा नु काम पुरु हयहे; काहाके जे कंय पक्‌कु करीन ठान लेय तीहयु पक्‌कुत पुरु हयवा वाळु से।<note caller="+" style="x"><char style="xo" closed="false">11:36 </char><char style="xt" closed="false"><ref loc="2TH 2:3">2 थीसलुनीकीयो 2:3</ref>,<ref loc="2TH 2:4">4</ref>; <ref loc="REV 13:5">परकासीतवाक्‌य 13:5</ref>,<ref loc="REV 13:6">6</ref> </char></note> <verse eid="DAN 11:36" /><verse number="37" style="v" sid="DAN 11:37" />तीहयो नी ते आह़फा ना आड़ा-बुड़ा ना भगवान नो धीयान करे, अने नी बयरा नी, अने नी काना देवताम नी लालच करे; काहाके तीहयो आह़फा ने आखा गेथो घणो मोटो ह़मजहे। <verse eid="DAN 11:37" /><verse number="38" style="v" sid="DAN 11:38" />तीहयो राजा आड़ा-बुड़ा ना देवताम नी ईज्‌जत करवा छोड़ीन कीला मे वाळा देवताम नी ईज्‌जत करहे, जीमने तीना आड़ा-बुड़ा बी नी जाणे; तीमने तीहयो ह़ोनु-चांदी मोगली मणी अने मोगला भेट चड़ावीन ईज्‌जत करहे। <verse eid="DAN 11:38" /><verse number="39" style="v" sid="DAN 11:39" />तीहयो, तीहया बीजा देवताम नी मदत सी कीला पोर हमलो करहे, अने जे कोय तीने माने तीहयो तीने मोटी ईज्‌जत आपहे। आसवा माणहु ने तीहयो ढेरेत नी उपर राज करन्‌यो बणावहे, अने आह़फा ना फायदा नी लेदे आह़फा ना देस नी जागा ने वाट देहे।<verse eid="DAN 11:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="DAN 11:40" />“आखरी टेम मे दखणाव ना मीस्‌र देस नो राजा तीनी पोर हमलो करहे। पण धुराव ना सीरीया देस नो राजा तीनी पोर भुत्‌यान तेम ढेरेत घोड़ागाड्‌या चलाड़न्‌या अने मोट्‌लु ढुन्‌ड्यु लीन हमलो करहे; आहयी रीती सी तीहयो ढेरेत देसु मे फेल जहे, अने तीमनी मे गेथो नीकळी आवहे। <verse eid="DAN 11:40" /><verse number="41" style="v" sid="DAN 11:41" />तीहयो अमारा घटाळा देस मे बी आवहे, अने ढेरेत देस उजड़ी जहे, पण एदोमी, मोवाबी अने मुख्‌या-मुख्‌या अम्‌मोनी माणहु ना देस तीनी हात सी बच जहे। <verse eid="DAN 11:41" /><verse number="42" style="v" sid="DAN 11:42" />तीहयो बीजा देसु पोर बी अदीकार करवा करीन हमलो करहे अने मीस्‌र देस तीना हात सी बच नी सके <verse eid="DAN 11:42" /><verse number="43" style="v" sid="DAN 11:43" />तीहयो मीस्‌र ना ह़ोना-चांदी ना खजाना अने आखी मोगली चीजु नो मालीक बण जहे; अने लुबी अने कुस<note caller="+" style="f"><char style="fr" closed="false">11:43 </char><char style="fq" closed="false">कुस </char><char style="ft" closed="false">ईब्‌रानी मे कुस देस, नील नंदी ना पेल्‌ला झोर ना दखणाव मे मोट्‌ला ईलाका नु जुन्‌लु नाम से। युनानी रोम नी टेम मे आहया ईलाका ने ईथोपीया केता हता, अने आनी काकड़ मे नवला सुदान नो ढेरेत वाटो अने हमणे ना ईथोपीया (एबीसीनीया) नो थोड़ोक वाटो हतो।</char></note> देस ना माणहु बी तीना हक मे हय जहे। <verse eid="DAN 11:43" /><verse number="44" style="v" sid="DAN 11:44" />तीहयी टेमे तीहयो उगण अने दखणाव भणी गेथी खबर ह़मळीन चीन्‌ता मे पड़ जहे, अने खीजवाय्‌न ढेरेत जणा ने खत्‌तम करवा करीन नीकळहे। <verse eid="DAN 11:44" /><verse number="45" style="v" sid="DAN 11:45" />तीहयो तीनु राज-पाट नु तम्‌बु दर्‌या अने घटाळ्‌ळा चोखला बड़ा नी वच मे उबु करहे। ते बी तीहयो खत्‌तम हय जहे; अने कोय बी तीनी मदत करवा करीन नी आवे।<verse eid="DAN 11:45" /></para>
  <chapter eid="DAN 11" />
  <chapter number="12" style="c" sid="DAN 12" />
  <para style="s">आखरी टेम</para>
  <para style="p">
    <verse number="1" style="v" sid="DAN 12:1" />“तीहयी टेमे मुख्‌यो ह़रगदुत मीकाएल, जे तारा माणहु नी रखवाळी करवा उबो रेय, तीहयो उठहे, तत्‌यार एवी वेला नी टेम आवहे, जेवी काना देस ने बणवा गेथी हजु लग नी आयी, अने नी हये; पण तीहयी टेमे तारा माणहु मे जेतरा नु नाम भगवान नी कीताप मे लीखलु हहे, तीहया बच नीकळहे।<note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="MAT 24:21">मत्‌ती 24:21</ref>; <ref loc="MRK 13:19">मरकुस 13:19</ref>; <ref loc="REV 7:14">परकासीतवाक्‌य 7:14</ref>; <ref loc="REV 12:7">12:7</ref></char></note> <verse eid="DAN 12:1" /><verse number="2" style="v" sid="DAN 12:2" />जे धरती मे हेटा मड़ाट्‌या मे ह़ुय र्‌या तीमनी मे गेथा ढेरेत माणहु जाग उठहे कंय ते हमेसा नी जीवाय नी लेदे, अने कंय ने बदनामी अने हमेसा नी ह़ीगी नी लेदे ठेरहे।<note caller="+" style="x"><char style="xo" closed="false">12:2 </char><char style="xt" closed="false"><ref loc="ISA 26:19">यसाया 26:19</ref>; <ref loc="MAT 25:46">मत्‌ती 25:46</ref>; <ref loc="JHN 5:29">युहन्‌ना 5:29</ref></char></note> <verse eid="DAN 12:2" /><verse number="3" style="v" sid="DAN 12:3" />तत्‌यार जे ह़मजदार रेहे तीहया चमकवा वाळी तारामंडळीन तेम अने जे ढेरेत ने धरमी बणावे, तीहया हमेसा तारान तेम भबळहे।”<verse eid="DAN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="DAN 12:4" />“पण ए दानीयल, तु आहयी कीताप पोर सीलठप्‌पो लगाड़ीन आहया बोलु ने आखरी टेम नी लेदे बचाड़ीन राख। ढेरेत माणहु पुसतास अने ह़ोद करहे, अने आह़फाम नी अक्‌कल वदाड़हे।”<note caller="+" style="x"><char style="xo" closed="false">12:4 </char><char style="xt" closed="false"><ref loc="REV 22:10">परकासीतवाक्‌य 22:10</ref> </char></note><verse eid="DAN 12:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="DAN 12:5" />आहयु आखु ह़मळीन, में दानीयल जत्‌यार देख्‌यो, तां मने बे अदमी देखाव पड़्‌या, एक नंदी नी आहयी धेड़, अने एक नंदी नी ह़ेली धेड़े। <verse eid="DAN 12:5" /><verse number="6" style="v" sid="DAN 12:6" />तत्‌यार जे अदमी सुती ना लुगड़ु पेरीन नंदी ना पाणी नी उपर हतो, तीने तीहया अदमी मे गेथो एक जणो पुछ्‌यो, “आहया वहराड़न्‌या कामु कारु पुरा हयहे?”<verse eid="DAN 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="DAN 12:7" />तत्‌यार जे अदमी सुती ना लुगड़ा पेरीन नंदी ना पाणी नी उपर हतु, तीहयो मारी ह़मळते जमण्‌यो अने डाखर्‌यो हात ह़रग भणी उचो करीन, हमेसा जीवत्‌ला रेवा वाळा भगवान नी ह़ाम खाय्‌न केदो, “आहयी हालत साड़ी तीन साल लग रेहे। अने जत्‌यार चोखला माणहु नी ताखत टुटते-टुटते खत्‌तम हय जहे, तत्‌यार आहयी आखी वात पुरी हयहे।”<verse eid="DAN 12:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="DAN 12:8" />आहयी वात में ह़मळतो ते हतो पण कंय बी नी ह़मज्‌यो, ता मे केदो, “ए मारा मालीक, आहयी वात नी आखरी हालत ह़ु हयहे?”<verse eid="DAN 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="DAN 12:9" />तीहयो केदो, “ए दानीयल जत रे; काहाके आहयी वात आखरी टेम नी लेदे सीलठप्‌पो लगाड़ीन बंद करली से। <verse eid="DAN 12:9" /><verse number="10" style="v" sid="DAN 12:10" />ढेरेत माणहु ते आह़फा-आह़फाम ने वारु अने चोखा करहे, अने वारु हय जहे; पण गलत माणहु गलतेत करता रेहे; अने गलत माणहु मे कोय आहयी वात नी ह़मजे; पण जे अक्‌कल वाळा से तीहयात ह़मजहे।<note caller="+" style="x"><char style="xo" closed="false">12:10 </char><char style="xt" closed="false"><ref loc="REV 22:11">परकासीतवाक्‌य 22:11</ref></char></note><verse eid="DAN 12:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="DAN 12:11" />“जे दाड़े चोखला मंदीर मे दाड़ीक नी होम बादा चड़ाव्‌वा बंद हय जहे, अने ह़ीगी आवे एवी चीज ने तीहया जागा पोर वहाड़हे, जे खत्‌तम हयवा नो कारण रेहे, तांह तक बारे ह़ोव नब्‌बे दाड़ा वीत जहे।<note caller="+" style="x"><char style="xo" closed="false">12:11 </char><char style="xt" closed="false"><ref loc="DAN 9:27">दानीयल 9:27</ref>; <ref loc="DAN 11:31">11:31</ref>; <ref loc="MAT 24:15">मत्‌ती 24:15</ref>; <ref loc="MRK 13:14">मरकुस 13:14</ref></char></note> <verse eid="DAN 12:11" /><verse number="12" style="v" sid="DAN 12:12" />जुगाळो से तीहयो माणेह, जे धीरज धरीन एक हजार तीन ह़ोव पंयतीस दाड़ा पुरा करहे।<verse eid="DAN 12:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="DAN 12:13" />“दानीयल हाव तु जा। अने आह़फा नी जीवाय नी आखरी टेम लग तारी वाट्‌ये चालतो रे अने तने अराम जड़हे। अने आखरी मे तने तारो हीस्‌सो जड़हे।”<verse eid="DAN 12:13" /></para>
  <chapter eid="DAN 12" />
</usx>