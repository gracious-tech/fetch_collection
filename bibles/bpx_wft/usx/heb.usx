<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="HEB" style="id">- Paliya</book>
  <para style="h">ईब्‌रानीयो</para>
  <para style="toc3">ईब्‌रानीयो</para>
  <para style="toc2">ईब्‌रानीयो</para>
  <para style="toc1">ईब्‌रानीयो ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="mt2">ईब्‌रानीयों के नाम पोलुस की पत्री</para>
  <para style="mt1">ईब्‌रानीयो ना नाम पोलुस नी चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">तीहयी ईब्‌रानीयो नी कीताप एक हीम्‌मत आपवा वाळी चीट्‌ठी से, जीनी मे आहयु देखाड़लु से के कीकम ईसु कंय जुन्‌ला कायदा नी भगवान वगे गेथी केदली वात ने पुरी कर्‌यो। आहयी कीताप एक परच्‌यार ने तेम लीखली से। ईब्‌रानीयो नी कीताप मे जुन्‌ला कायदा नी 60 गेथी जादा सेलाणी से जे उजन्‌ती देखाड़े के कीकम ईसु भगवान वगे गेथी केदली वात अने डायला पुंजारा नी जपापदारी ने पुरी कर्‌यो। करीन आहयी कीताप युहदी ईसु पोर भरहो करन्‌या जुगु हीम्‌मत आपवा वाळी हती। ईब्‌रानीयो नी कीताप मे आहयु देखाड़े के कीकम ईसु कायदा ने पुरा कर्‌यो के पुंजारा ने अळी वळ-वळीन बादा चड़ाव्‌वा नी जरवत नी पड़े। ईसु आखा पापु नी जुगु, एक वार अने जलमको बादा चड़्‌यो। अमारी टेम ना ईसु पोर भरहो करन्‌या हीम्‌मत हात कर सके। आहयी कीताप सी आमने आसम ह़मज मे आवे के, ईसु मसी, आपणु ने भगवान पोर भरहो करवा करीन तीयार करे <char style="xt"><ref loc="HEB 12:2">12:2</ref></char>।</para>
  <para style="ip">आहयीत रीते आहयी कळी ना आमु ईसु पोर भरहो करन्‌या जुगु आहयी कीताप मे घणी जादा हीम्‌मत जड़े। आमने तीनी पोर टेकला रेवा जोवे। ईब्‌रानीयो नी चीट्‌ठी कोय लीखलु से कोयने मालम नी हय, पण जाणकार माणहु नेवताळो पोलुस, लुको, अने बरनाबास ने एवा लीखला से देखाड़े। आहयीत रीते आहयी कीताप कारु लीखली से आहयु बी आमने मालम नी हय। पण ढेरेत जाणकार आसम माने के, आहयी कीताप मसीन पयदा हयवान 70 साल ने अळतेण लीखी हहे। आनो कारण आहयो से के, जत्‌यार यरुसलेम ह़ेर 70 वा साल मे खत्‌तम हय ज्‌यु ते बी आहयी कीताप मे यरुसलेम ना बारा मे वात आसम हयी के, जीसम तीहयु खत्‌तम नी हयु। आहयी कीताप ने ढेरेत मंडळी मे भण्‌या हहे। अने आहयी कीताप रोमीयो ह़ेर मे लीखली से <char style="xt"><ref loc="HEB 13:24">13:24</ref></char>।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. लीखवा वाळो आसम देखाड़े के, ईसु आहया भगवान ना आखा भगवान वगे गेथा केण्‌या माणहु अने ह़रगदुत सी मोटो से। <char style="ior"><ref loc="HEB 1:1-4:13">1:1–4:13</ref></char></para>
  <para style="io1">2. अळतेण तीहयो आहयु लीखे के, जे पुंजारो यरुसलेम मंदीर मे सेवा-चाकरी करतो हतो तीनी सी बी ईसु मोटो से। <char style="ior"><ref loc="HEB 4:14-7:28">4:14–7:28</ref></char></para>
  <para style="io1">3. मुसा ने आपला हुकम नी लारे जे जुन्‌ला कायदा मे भगवान आह़फा ना माणहु ह़ाते करलो तीमनी सी बी ईसु नी सेवा मोटी से <char style="ior"><ref loc="HEB 8:1-10:31">8:1–10:31</ref></char></para>
  <para style="io1">4. ईसु आखी वात मे आखा सी वारु से आहयु पक्‌कु करवान अळतेण लीखण्‌यो ढेरेत दाड़ीन ना काम ना वेहवार ना बारा मे ह़ला करे। <char style="ior"><ref loc="HEB 10:32-13:17">10:32–13:17</ref></char></para>
  <para style="io1">5. आखरी मे लीखण्‌यो बड़ावो आपीन अने वारला से के कीन चीट्‌ठी ने खत्‌तम करे। <char style="ior"><ref loc="HEB 13:18-25">13:18-25</ref></char></para>
  <chapter number="1" style="c" sid="HEB 1" />
  <para style="s">ईसु मसी नी लारे भगवान ना बोलु</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 1:1" />पेल्‌ना वारा मे भगवान आह़फा ना वात केण्‌या माणहु नी लारे अमारा आड़ा-बुड़ा नी ह़ाते दाखला देखाड़ीन वात करे, <verse eid="HEB 1:1" /><verse number="2" style="v" sid="HEB 1:2" />आहया आखरी दाड़ा मे तीहयो अमारी सी सोरा नी लारे वात कर्‌यो, जीने तीहयो आखी चीज नो हकदार्‌यो बणावलो से अने तीनीत लारे भगवान आखी धरती ने बणायो। <verse eid="HEB 1:2" /><verse number="3" style="v" sid="HEB 1:3" />तीहयो भगवान नी बड़ाय नु वीजाळु अने तीना रुप नी पक्‌की छाप से, अने आखी चीज ने तीनी सक्‌ती ना बोल सी ह़माळत्‌लो से। तीहयो आखा माणहु ना पापु ने माफ करीन जोरभर्‌या भगवान नी जमणी धेड़े जाय्‌न बह्‌यो।<verse eid="HEB 1:3" /></para>
  <para style="s">भगवान ना सोरा नी बड़ाय</para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 1:4" />अने ह़रगदुत सी एतरोत वारु केवायो, जेतरो तीहयो तीमनी गेथा मोटा जागा नो हकदार्‌यो हय्‌न तीमनी सी वारु नाम हात कर्‌यो। <verse eid="HEB 1:4" /><verse number="5" style="v" sid="HEB 1:5" />काहाके ह़रगदुत मे गेथा भगवान कोयने बी कत्‌यार कोय सी केदो,</para>
  <para style="q1" vid="HEB 1:5">“तु मारो सोरो से,</para>
  <para style="q2" vid="HEB 1:5">आज तु मार सी पयदा हयलो?”</para>
  <para style="b" vid="HEB 1:5" />
  <para style="m" vid="HEB 1:5">अने अळी आहयु,</para>
  <para style="q1" vid="HEB 1:5">“मे तीनो बाह हयही,</para>
  <para style="q2" vid="HEB 1:5">अने तीहयो मारो सोरो हयहे?”<verse eid="HEB 1:5" /></para>
  <para style="b" />
  <para style="m">
    <verse number="6" style="v" sid="HEB 1:6" />अने जत्‌यार भगवान एक-खोळ्‌या ने कळी मे लावे ता केय,</para>
  <para style="q2" vid="HEB 1:6">“भगवान ना आखा ह़रगदुत हीने वांदे।”<verse eid="HEB 1:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 1:7" />पण भगवान ह़रगदुत ना बारा मे आहयु केय,</para>
  <para style="q1" vid="HEB 1:7">“तीहयो आह़फा ना दुत नी लारे</para>
  <para style="q2" vid="HEB 1:7">अने आह़फा ना चाकर्‌या ने हुड़ु-हुड़ु आक्‌ठु बणावलो से।”<verse eid="HEB 1:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="HEB 1:8" />पण भगवान सोरा ना बारा मे केय,</para>
  <para style="q1" vid="HEB 1:8">“ए भगवान, तारु राज जलमकु रेहे:</para>
  <para style="q2" vid="HEB 1:8">अने तारु राज तारा माणहु पोर नीयाव नी ह़ाते रेहे।<verse eid="HEB 1:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 1:9" />तु ते सच्‌चाय सी मोंग अने बुराय सी ह़ीगी राख्‌यो;</para>
  <para style="q1" vid="HEB 1:9">आनीन करते भगवान, तारो भगवान,</para>
  <para style="q2" vid="HEB 1:9">खुसी ना तेल सी चोखो करवा नी लारे तारा</para>
  <para style="q2" vid="HEB 1:9">ह़ाती सी बड़ीन टाळ्‌यो।”<verse eid="HEB 1:9" /></para>
  <para style="b" />
  <para style="m">
    <verse number="10" style="v" sid="HEB 1:10" />अने तीहयो आहयु बी केय,</para>
  <para style="q1" vid="HEB 1:10">“ए मालीक, सुरु मे तु ते धरती नी नीव नाख्‌यो,</para>
  <para style="q2" vid="HEB 1:10">अने ह़रग तारा हात नी कारीगरी से।<verse eid="HEB 1:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 1:11" />तीहया ते खत्‌तम हय जहे, पण तु बणीन रेही;</para>
  <para style="q2" vid="HEB 1:11">अने तीहया आखा लुगड़ान तेम जुना हय जहे,<verse eid="HEB 1:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 1:12" />अने तु तीने चादरान तेम गुचवी लेही,</para>
  <para style="q2" vid="HEB 1:12">अने तीहया लुगड़ान तेम बदली जहे:</para>
  <para style="q1" vid="HEB 1:12">पण तु तीहयोत से</para>
  <para style="q2" vid="HEB 1:12">अने तारी जीवाय बी खत्‌तम नी हये।”<verse eid="HEB 1:12" /></para>
  <para style="b" />
  <para style="m">
    <verse number="13" style="v" sid="HEB 1:13" />अने ह़रगदुत मे गेथा भगवान कोयने बी कदी नी केदो:</para>
  <para style="q1" vid="HEB 1:13">“तु मारी जमणी धेड़े बह,</para>
  <para style="q2" vid="HEB 1:13">जत्‌यार तक के मे तारा वेरी ने</para>
  <para style="q2" vid="HEB 1:13">तारा पोगु नी तळे नो पाटलो नी बणाय देम?”<verse eid="HEB 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 1:14" />ह़ु तीहया ह़रगदुत भगवान नी सेवा करवा वाळी आत्‌मा ते नी हय, जे छुटकारो हात करवा नी करते सेवा करवा करीन मोकले?<verse eid="HEB 1:14" /></para>
  <chapter eid="HEB 1" />
  <chapter number="2" style="c" sid="HEB 2" />
  <para style="s">मोटो छुटकारो</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 2:1" />आनीन करते जरुड़ी से के आमु तीहयी सच्‌चाय नी वात पोर जे आमु ह़मळला से, अळी बी मन लगाड़ो, आसम नी हयवा जोवे के वीरखीन तीमनी गेथा सेटा जत रेय। <verse eid="HEB 2:1" /><verse number="2" style="v" sid="HEB 2:2" />जे खबर ह़रगदुत नी लारे आपणा आड़ा-बुड़ा ने जड़ी तीहयी खरली हती, जे कोय तीहया हुकम ने नी पाळे अने जे कोय हुकम ने तोड़ीन पाप कर्‌यो तीमने आखा ने डंड जड़्‌यो। <verse eid="HEB 2:2" /><verse number="3" style="v" sid="HEB 2:3" />कदीम आमु एतरा मोटा छुटकारा पोर धीयान नी दीया, ता आमु कीकम बचहु? मालीक आखा सी पेले आहया छुटकारा नी वात कर्‌यो, अने जे तीने ह़मळ्‌या तीहयु अमारी जुगु साबीत हयु के आहयु ह़ाचली से। <verse eid="HEB 2:3" /><verse number="4" style="v" sid="HEB 2:4" />अने ह़ातेत भगवान बी आह़फा नी मरजी नी लारे सेलाणी, अने जुदा-कामु, अने आखा भाती नी सक्‌ती ना कामु, अने चोखली आत्‌मा ना वाटाम ने वाटवा नी लारे आनी गवाय आपतो र्‌यो।<verse eid="HEB 2:4" /></para>
  <para style="s">छुटकारा नी वाट देखाड़न्‌यो</para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 2:5" />भगवान तीहयी आव्‌वा वाळी कळी ने जीना बारा मे आमु कर र्‌या, ह़रगदुत ना हक मे नी कर्‌या। <verse eid="HEB 2:5" /><verse number="6" style="v" sid="HEB 2:6" />पण चोखली सास्‌तर मे कानो आहयी गवाय देदलो से,</para>
  <para style="q1" vid="HEB 2:6">“माणेह ह़ु से के तु तीनी फोम करे?</para>
  <para style="q2" vid="HEB 2:6">अने माणेह नो सोरो ह़ु से के तु तीनी फीकर करे?<verse eid="HEB 2:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 2:7" />तु तीने ह़रगदुतु गेथो थोड़ुक कम कर्‌यो;</para>
  <para style="q2" vid="HEB 2:7">तु तीनी पोर बड़ाय अने ईज्‌जत नी पागड़ी मेकलो से,<verse eid="HEB 2:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 2:8" />अने तीने आह़फा ना हात ना कामु पोर हक आपलो से। तु आखु कंय तीना पोगु ना तळे कर देदलो।”</para>
  <para style="m" vid="HEB 2:8">एतरे जत्‌यार तीहयो आखु कंय तीना हक मे कर देदलो, ता तीहयो कंय बी नी मेल्‌यो जे तीनी हक मे नी हय। पण आमु हमणे आखु कंय तीना हक मे नी देखीया। <verse eid="HEB 2:8" /><verse number="9" style="v" sid="HEB 2:9" />पण आमु ईसु ने जे ह़रगदुतु गेथो थोड़ुक कम करलु हतु, मोत नो दुख झेलवा नी करते बड़ाय अने ईज्‌जत नी पागड़ी पेरली देखत्‌ला से, काहाके भगवान नी बरकत सी तीहयो आखा माणहु जुगु मरे। <verse eid="HEB 2:9" /><verse number="10" style="v" sid="HEB 2:10" />आहयु भगवान जुगु संय हतु जे आखी वातु ने बणायो अने ह़माळीन राख्‌यो, ईसु ने बी दुख नी लारे पुरोन-पुरो बणाव्‌वा जोवे, काहाके ढेरेत अवल्‌यात तीनी बड़ाय मे भेसकाय सके। काहाके ईसुत तीहयो एक से जे तीमने छुटकारा भणी ली जाय।<verse eid="HEB 2:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 2:11" />तीहयो माणहु ने तीमना पापु सी चोखो करे अने तीहया बेम तीहया अने चोखला करला, आखा नो बाह एकीत से; आनीन करते ईसु तीमने आपणा घोरल्‌या केवा सी नी लजवायतो हतो। <verse eid="HEB 2:11" /><verse number="12" style="v" sid="HEB 2:12" />तीहयो केय,</para>
  <para style="q1" vid="HEB 2:12">“मे तारु नाम मारा भाय-बेन्‌या ने ह़मळावही;</para>
  <para style="q2" vid="HEB 2:12">मंडळी ना वच मे, मे तारु भजन गावही।”<verse eid="HEB 2:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 2:13" />अने अळी आहयु केय, “मे तीनी पोर भरहो राखही।” अने अळी आहयु बी केय, “देख, मे तीहया सोराम नी भेळतो जीने भगवान मने आपलो से।”<verse eid="HEB 2:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 2:14" />एतरे जत्‌यार सोरा माह अने लोय ना साजल्‌या से, ता तीहयो आह़फो बी तीमनीन तेम तीमना साजल्‌या हय ज्‌या, काहाके मोत नी लारे तीने जीने मोत पोर सक्‌ती जड़ली हती, काहाके भुतड़ा ने रीकामा कर देय; <verse eid="HEB 2:14" /><verse number="15" style="v" sid="HEB 2:15" />आहयीत रीते जेतरा मोत नी बीक नी करते जलम नी जीवाय मे गुलामी मे फस ज्‌या, तीमने छोड़ाय लेय। <verse eid="HEB 2:15" /><verse number="16" style="v" sid="HEB 2:16" />काहाके आहयु उजन्‌तु से के तीहयो ह़रगदुत नी, नी पण अब्‌राहम नी अवल्‌यात नी मदत करे। <verse eid="HEB 2:16" /><verse number="17" style="v" sid="HEB 2:17" />आनीन करते तीने जोवतु हतु, के आखी वातु मे आह़फाम ना भायुन तेम बणे; जीनी सी तीहयो तीहयी वातु मे जे भगवान सी नातु राखे, एक दया वाळो अने भरहो करे एवु डायलो पुंजारो बणे काहाके माणहु ना पापु ने माफ कर सके। <verse eid="HEB 2:17" /><verse number="18" style="v" sid="HEB 2:18" />काहाके जत्‌यार तीहयो पारख नी टेम मे दुख झेल्‌यो, ता तीहयो तीमनी बी मदत कर सकत्‌लो जीमनी पारख हये।<verse eid="HEB 2:18" /></para>
  <chapter eid="HEB 2" />
  <chapter number="3" style="c" sid="HEB 3" />
  <para style="s">ईसु मुसा गेथो बी मोटो से</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 3:1" />ए मारा चोखला भाय अने बेन्‌या तमु जे भगवान नी लारे बोलावला से तमु तमारो धीयान ईसु पोर लगाड़ीन राखो जीने भगवान डायलो पुंजारो बणवा करीन मोकल्‌लो से, तीने जीनी पोर आमु कबुल्‌या। <verse eid="HEB 3:1" /><verse number="2" style="v" sid="HEB 3:2" />तीहयो जे तीने टाळ्‌यो तीहया भगवान नी करते भरहा नी लायक हतो, तेमेत जेम मने मुसो आपणा काम नी करते भगवान ना घोर मे भरहो करे एवो हतो। <verse eid="HEB 3:2" /><verse number="3" style="v" sid="HEB 3:3" />जेम घोर बणाव्‌वा वाळो एक माणेह घोर गेथो जादा खुद ईज्‌जत नी लायक रेय, आहयीत रीते ईसु बी मुसा करते जादा ईज्‌जत नी लायक मनायो। <verse eid="HEB 3:3" /><verse number="4" style="v" sid="HEB 3:4" />काहाके हर एक घोर नो कोयने कोय बणाव्‌वा वाळो रेय। पण भगवान ते आखी चीज ने बणाव्‌वा वाळो से। <verse eid="HEB 3:4" /><verse number="5" style="v" sid="HEB 3:5" />मुसो ते भगवान ना घोर मे चाकर्‌यान तेम भरहा नी लायक हतो, तीहयो तीहयी वात केदो जे अगी हयवा वाळी वात भगवान नी लारे केवा वाळी हती। <verse eid="HEB 3:5" /><verse number="6" style="v" sid="HEB 3:6" />पण मसी सोरा नी रुप भगवान ना घोर मे भरहा नी लायक से। अने तीनु घोर आपणु से, कदीम आमु अमारी हीम्‌मत अने जीनी पोर आमु मोटाय करया तीहयी आह पोर वातड़ा रीन टेकला रीया।<verse eid="HEB 3:6" /></para>
  <para style="s">भगवान ना माणहु नी जुगु अराम नो दाड़ो</para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 3:7" />एतरे जीसम चोखली आत्‌मा केय,</para>
  <para style="q1" vid="HEB 3:7">“कदीम आज तमु भगवान नी अवाज ह़मळो,<verse eid="HEB 3:7" /></para>
  <para style="q2">
    <verse number="8" style="v" sid="HEB 3:8" />ता आह़फाम ना मन ने वातड़ु ना करो,</para>
  <para style="q2" vid="HEB 3:8">जीसम के तमारा आड़ा-बुड़ा जत्‌यार रीह देवाड़वा नी टेमे अने पारख ना दाड़ा मे बड़ा मे करला हता।<verse eid="HEB 3:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 3:9" />भगवान केय तां तीहया मारी पारख कर्‌या अने पारख्‌या।</para>
  <para style="q2" vid="HEB 3:9">अने मारा कामु ने देख्‌या जीने मे चाळीह साल तक करतो र्‌यो।<verse eid="HEB 3:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 3:10" />आनीन करते मे तीहयी टेम ना माणहु सी</para>
  <para style="q2" vid="HEB 3:10">रीहवायतो र्‌यो, अने केदो,</para>
  <para style="q2" vid="HEB 3:10">ईमना मन सदा भटकता रेता हता, अने मारा हुकम ने नी मान्‌या।<verse eid="HEB 3:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 3:11" />तत्‌यार मे रीहवाय्‌न ह़ाम खादो,</para>
  <para style="q2" vid="HEB 3:11">‘तीहया मारा अराम ना जागा मे अळतेण कदी भराय नी सके।’”<verse eid="HEB 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 3:12" />ए भायु, अने बेन्‌या, चेतीन रेवो के तमारी मे गेथु कोय नु बुरु अने भरहो नी करवा वाळु मन नी रेवा जोवे, जे तमने जीवता भगवान सी सेटु कर देय। <verse eid="HEB 3:12" /><verse number="13" style="v" sid="HEB 3:13" />पण आनी बदले जत्‌यार तक आहयो “आज नो दाड़ो” केवाये तमु दाड़ीन एक-बीजा ने धीरज आपता रेवो के तमारी माय्‌न कोय बी पाप मे भटके नी अने वातड़ा हय जाय। <verse eid="HEB 3:13" /><verse number="14" style="v" sid="HEB 3:14" />कदीम आमु आखरी तक वातड़ा रीन आपणा सुरुवात ना आत्‌मा ना भरहा मे बणीन रेय ता आमु मसी ना साजल्‌या बण जीया।<verse eid="HEB 3:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 3:15" />जीसम सास्‌तर केय,</para>
  <para style="q1" vid="HEB 3:15">“कदीम आज तमु भगवान नो बोल ह़मळो,</para>
  <para style="q2" vid="HEB 3:15">ता आह़फाम ना मन ने वातड़ा ना करो,</para>
  <para style="q2" vid="HEB 3:15">जीसम के भगवान सी वीरोद कर्‌या ते दाड़ा मे तमारा आड़ा-बुड़ा करला हता।”<verse eid="HEB 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 3:16" />तीहया काना माणहु हता जे भगवान नी अवाज ह़मळ्‌या अने तीना खीलाप मे वीरोद कर्‌या? ह़ु तीहया ते माणहु नी हता जे मुसो मीसर देस मे गेथा बचाड़ीन नीकळलो हतो? <verse eid="HEB 3:16" /><verse number="17" style="v" sid="HEB 3:17" />अने भगवान चाळीह साल तक काना माणहु सी रीहवाय्‌न र्‌यो? ह़ु तीमनी पोर नी जे पाप करला हता, अने जीमना धोड़ बड़ा मे पड़ र्‌या हता? <verse eid="HEB 3:17" /><verse number="18" style="v" sid="HEB 3:18" />अने भगवान काना माणहु जुगु ह़ाम खादलो के तमु अराम ना जागा मे नी भराय सको? ह़ु आहया तीहया ते नी हय, जे तीनो हुकम नी मान्‌या? <verse eid="HEB 3:18" /><verse number="19" style="v" sid="HEB 3:19" />पण आमु देखीया के तीहया भरहो नी हयवा नी करते भराय नी सके।<verse eid="HEB 3:19" /></para>
  <chapter eid="HEB 3" />
  <chapter number="4" style="c" sid="HEB 4" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 4:1" />एतरे जत्‌यार तीना अराम मे भरायवा नो वायदो हमणे तक से, ता आमने बीहवा जोवे ईसम नी हय जाय के तमारी मे गेथो कानो माणहे तीनी मे जवा नी लायक नी जड़्‌यो। <verse eid="HEB 4:1" /><verse number="2" style="v" sid="HEB 4:2" />काहाके आमु खुस-खबर ह़मळ्‌या जेम तीहया ह़मळला हता, पण जे खबर तीहया ह़मळला हता तीमनी जुगु तीनी कोय कीमत नी हती। काहाके जत्‌यार तीहया ह़मळ्‌या तीहया तीने भरहा भेळ नी मान्‌या। <verse eid="HEB 4:2" /><verse number="3" style="v" sid="HEB 4:3" />आमु जे भरहो करन्‌या से, तीहया अराम ने जीनो वायदो भगवान करलो हतो, तीने हात करया। जेम भगवान केदलो,</para>
  <para style="q1" vid="HEB 4:3">“मे रीह मे आनी पोर ह़ाम खाय्‌न केदो,</para>
  <para style="q2" vid="HEB 4:3">तीहया कारु बी मारा अराम मे भेसकाय नी सके।</para>
  <para style="m" vid="HEB 4:3">तीहयो आहयु केदलो हतो के जत्‌यार कळी ने बणाव्‌वान बाद तीनु काम पुरु हय जेलु हतु।” <verse eid="HEB 4:3" /><verse number="4" style="v" sid="HEB 4:4" />काहाके ह़ातवा दाड़ा ना बारा मे कंखर ते सास्‌तर मे केदलु से, “अने अळी ह़ातवा दाड़े भगवान आह़फा ना आखा कामु सी अराम कर्‌यो।” <verse eid="HEB 4:4" /><verse number="5" style="v" sid="HEB 4:5" />अने आना बारा मे तीहयो अळी आहयु केय, “तीहया मारा अराम ना जागा मे अळतेण कदी भराय नी सके।” <verse eid="HEB 4:5" /><verse number="6" style="v" sid="HEB 4:6" />जे पेले खुस-खबर ह़मळ्‌या तीहया ते अराम ने हात नी कर सक्‌या, काहाके तीहया भरहो नी कर्‌या। पण बीजाम नी जुगु अराम नु झापलु हमणे बी उगड़लु से। <verse eid="HEB 4:6" /><verse number="7" style="v" sid="HEB 4:7" />भगवान अळी एक खास दाड़ो ठेरायो अने तीनु नाम पाड़्‌यो, “आज नो दाड़ो” कंय साल बाद दावुद नी लारे भगवान तीहया दाड़ा ना बारा मे सास्‌तर मे देखाड़लो हतो, जीना बारा मे सास्‌तर पेलेत देखाड़े,</para>
  <para style="q1" vid="HEB 4:7">“कदीम आज तमु तीनी अवाज ह़मळह़ु,</para>
  <para style="q2" vid="HEB 4:7">ता आह़फाम ना मन ने वातड़ा ना करो।”<verse eid="HEB 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 4:8" />कदीम यहोसु तीमने अराम मे लीन जेलो हतो जीनो वायदो भगवान करलो हतो, ता भगवान अळतेण कदी अळी बीजा दाड़ा ना बारा मे नी केतो। <verse eid="HEB 4:8" /><verse number="9" style="v" sid="HEB 4:9" />ता जे बी हय, जेम भगवान ह़ातवा दाड़े अराम करे, तेमेत भगवान ना माणहु नी जुगु एक अराम री र्‌यो। <verse eid="HEB 4:9" /><verse number="10" style="v" sid="HEB 4:10" />काहाके जे कोय बी भगवान ना वायदा करला अराम मे जाय, तीहयो आह़फा ना काम सी अराम हात करहे, तेमेत जेम भगवान आह़फा ना कामु सी अराम कर्‌यो। <verse eid="HEB 4:10" /><verse number="11" style="v" sid="HEB 4:11" />ता आवो आपणु बी तीहया अराम ने हात करवा करीन आपणी पुरी रीती सी कोसीत करया, के भरहो नी करवा वाळा अमारा वच मे गेथु कोय बी तीने हात करवा मे वण-भरह्‌यो नी रेवा जोवे।<verse eid="HEB 4:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 4:12" />काहाके भगवान नो बोल जीवत्‌लो, अने काम करवा लायक, अने कानी बे धार वाळी तलवार गेथो बी वेताळो से; अने जीव अळी आत्‌मा ने अने गाठ-गाठ अने गुदा-गुदा ने अलग करीन आर-पार डुचो पाड़ देय अने मन नी ईच्‌छा अने वीच्‌यार नो नीयाव करे। <verse eid="HEB 4:12" /><verse number="13" style="v" sid="HEB 4:13" />कळी नी कानी बी चीज भगवान नी नींगा सी ह़तायली नी हय तीना डोळा अगळ जीने आमने हीसाप आपवा नो से, आखी चीज कानी बी चीज सी ढकायली नी पण उगाड़ली से।<verse eid="HEB 4:13" /></para>
  <para style="s">ईसु मोट्‌लो पुंजारो</para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 4:14" />आनीन करते जत्‌यार अमारो एवो मोट्‌लो पुंजारो से जे ह़रग मे हतीन जेलो से मतलब भगवान नो सोरो ईसु मसी, ता आपणु आपणा भरहा ने जीने आपणु हात करला से टणकाय सी धरीन रीया। <verse eid="HEB 4:14" /><verse number="15" style="v" sid="HEB 4:15" />काहाके अमारी पांह जे डायलो पुंजारो से तीहयो एवो नी हय के जे अमारी कमजोरी मे दुखी नी हय सके, तीने आखी भाते तेमेत पारख्‌या जेम आमने पारख्‌या पण तीहयो जलम वण-पापी नीकळ्‌यो। <verse eid="HEB 4:15" /><verse number="16" style="v" sid="HEB 4:16" />ता एतरे आवो, खुद पोर भरहो राखीन बरकत हात करवा भगवान नी राजगादी नी जाय के आनीन करते के जरवत पड़वा पोर आपणी मदत नी जुगु आमु दया अने बरकत ने हात कर सकया।<verse eid="HEB 4:16" /></para>
  <chapter eid="HEB 4" />
  <chapter number="5" style="c" sid="HEB 5" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 5:1" />काहाके आखा मोट्‌ला पुंजारा माणहु मे गेथात टाळे, अने माणहु नी लेदे, तीहयी वात ना बारा मे जे भगवान सी नातु राखे। पक्‌कु कर देय के भेट अने पाप नी बादा चड़ाया करे। <verse eid="HEB 5:1" /><verse number="2" style="v" sid="HEB 5:2" />काहाके तीहयो खुद बी घण-जबर कमजोर नी हक मे से। करीन तीहयो वण-अकल्‌या अने भुले पड़ला नी ह़ाते भोळाय सी वेहवार कर सकत्‌लो। <verse eid="HEB 5:2" /><verse number="3" style="v" sid="HEB 5:3" />आनीन करते तीने जोवे के जीसम माणहु नी लेदे तेमेत आपणी लेदे बी पाप नी बादा चड़ाया करो। <verse eid="HEB 5:3" /><verse number="4" style="v" sid="HEB 5:4" />अने आहयो डायला पुंजारा नो जागो कोय बी आह़फोत टाळीन नी लेय, जत्‌यार तक हारुन ने तेम भगवान ठेराय नी देय।<verse eid="HEB 5:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 5:5" />तेमेत मसी बी खुद मोट्‌लो पुंजारो बणवा नी बड़ाय नी कर्‌यो, पण हीने भगवान आप्‌यो, जे हीने केदलो हतो,</para>
  <para style="q1" vid="HEB 5:5">“तु मारो सोरो से,</para>
  <para style="q2" vid="HEB 5:5">आज मे तारो बाह बणलो से।”<verse eid="HEB 5:5" /></para>
  <para style="m">
    <verse number="6" style="v" sid="HEB 5:6" />आहयीत रीते तीहयो बीजा जागे बी केय,</para>
  <para style="q1" vid="HEB 5:6">“तु मलकीसीदक नी रीती पोर</para>
  <para style="q2" vid="HEB 5:6">जलम नी लेदे पुंजारो से।” <figure style="fig" alt="High priest with his priestly clothes and censer" file="hk00267c.tif" size="col" copy="Horace Knowles ©" ref="5:5">डायलो पुंजारो, पुंजारा ना लुगड़ा अने धुपदानी ह़ाते </figure><verse eid="HEB 5:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 5:7" />
    <note caller="+" style="x">
      <char style="xo" closed="false">5:7 </char>
      <char style="xt" closed="false">
        <ref loc="MAT 26:36-46">मत्‌ती 26:36-46</ref>; <ref loc="MRK 14:32-42">मरकुस 14:32-42</ref>; <ref loc="LUK 22:39-46">लुका 22:39-46</ref></char>
    </note>ईसु आह़फा ना डील मे रेवा ना दाड़ा मे उची अवाज सी आड़ी-आड़ीन अने आहवा पाड़ी-पाड़ीन तीनी सी जे तीने मोत सी बचाड़ सकतो हतो, रावण्‌या करीन वीन्‌ती कर्‌यो, अने भक्‌ती ना कारण सी भगवान तीनी ह़मळ्‌यो। <verse eid="HEB 5:7" /><verse number="8" style="v" sid="HEB 5:8" />पण ह़ाचलीन तीहयो भगवान नो सोरो हतो, ते बी तीहयो दुख झेलतो जाय्‌न हुकम मानवा ह़ीक्‌यो। <verse eid="HEB 5:8" /><verse number="9" style="v" sid="HEB 5:9" />अळी चोखो बण जवा पोर, आखा हुकम मानवा वाळा नी लेदे अमर छुटकारा नो झोर बण ज्‌यो, <verse eid="HEB 5:9" /><verse number="10" style="v" sid="HEB 5:10" />अने तीने भगवान भणी गेथो मलकीसीदक नी रीती पोर तीने डायलो पुंजारो बणाया।<verse eid="HEB 5:10" /></para>
  <para style="s">भरहा ने सोड़वा नी चेतावणी</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 5:11" />आना बारा मे आमने ढेरेत वात केवा नी से, पण तीहयी वात ह़मजाड़वा बी काठु से, काहाके तमु ह़मळवा मे घणा धीरा से। <verse eid="HEB 5:11" /><verse number="12" style="v" sid="HEB 5:12" /><note caller="+" style="x"><char style="xo" closed="false">5:12 </char><char style="xt" closed="false"><ref loc="1CO 3:2">1 कुरन्‌थी 3:2</ref></char></note>ह़ाचली मे आहयी टेमे तक तमने मास्‌तर बण जवु हतु, ते बी आहयु जरुड़ी हय जेलु से के कोय तमने भगवान ना बोलु नी ह़ीकापण अळी ह़ीकाड़े। तमु ते ईसम हय जेला से के तमने अन ना बदले हमणे तक तमने दुदेत जोवे। <verse eid="HEB 5:12" /><verse number="13" style="v" sid="HEB 5:13" />काहाके जे दुद पीवा वाळा सोरा ने ते धरम ना बोल नी ओळखाण नी हये, काहाके तीहयो सोरो से। <verse eid="HEB 5:13" /><verse number="14" style="v" sid="HEB 5:14" />पण दाणा जुवान्‌या नी लेदे से, जीमनी अक्‌कल सी भलु अने बुरा नो फेसलो करवा मे ह़ीक लेदा।<verse eid="HEB 5:14" /></para>
  <chapter eid="HEB 5" />
  <chapter number="6" style="c" sid="HEB 6" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 6:1" />एतरे आवो आपणु मसी नी सुरुवात नी ह़ीकापण ने ह़ीकीन अळी अगा बड़ता जीया जे वात ह़ीक लेदा तीने पासी ह़ीकवा जरुड़ी नी हय जीसम पाप भणी गेथा मन फीरव्‌वा नी ह़ीकापण अळी भगवान पोर भरहो करवा नी ह़ीकापण, <verse eid="HEB 6:1" /><verse number="2" style="v" sid="HEB 6:2" />अने बपतीस्‌मा नी ह़ीकापण अने हात उपर मेलवा, अने मरला मे गेथा जीव उठवा, अने आखरी दाड़ा ना नीयाव नी ह़ीकापण नी नीव ना नाखो। <verse eid="HEB 6:2" /><verse number="3" style="v" sid="HEB 6:3" />कदीम भगवान ने गमे ता आपणु आहयुत करहु।<verse eid="HEB 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 6:4" />काहाके जे माणहु आह़फा ना भरहा ने सोड़ देय तीमने फीर सी मन फीरव्‌वा करीन कीकम लावया? तीहया एक कावा भगवान नु वीजाळु मे हता। जे ह़रग ना वाटा नो ह़वाद चाख लेदला से अने चोखली आत्‌मा नो आपणो वाटो हात करला से, <verse eid="HEB 6:4" /><verse number="5" style="v" sid="HEB 6:5" />अने तीहया भगवान ना बोल ने जाणता हता के भगवान नो बोल केतरो वारु से। अने आव्‌वा वाळी कळी नी सक्‌ती नी जानकारी ली चुक्‌या। <verse eid="HEB 6:5" /><verse number="6" style="v" sid="HEB 6:6" />कदीम तीहया भरहा सी भटकी जाय ता तीमने अळी मन फीराव्‌वा नी लेदे पासा लाव्‌वा काठु से; काहाके तीहया भगवान ना सोरा ने अळी कुरुस पोर चड़ावे अने आखा नी अगळ नामबद्‌दी नी वात बणावे।<verse eid="HEB 6:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 6:7" />जे धरती जलमको पड़वा वाळा पाणी ने चुह लेय, अने जोपवा अने ओरवा नी लेदे काम लायक मेर आपे अने तीहयी भगवान गेथी संयबरकत हात करे। <verse eid="HEB 6:7" /><verse number="8" style="v" sid="HEB 6:8" />पण कदीम तीहयी धरती कटाळस्‌या झाटवा अने गोखरा काटा उगाड़े, ता तीहयी रीकामी से, अने भगवान सी सरापीत हयवा नी बीक से, अने तीने आखरी मे धपाड़ देहे।<verse eid="HEB 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="HEB 6:9" />ए मोंगाळ्‌ळा, भले आमु आहयी रीते ने वात कीया पण तमारा बारा मे आमने आनी सी बी वारु वातु नो खुद पोर भरहो से। तीहयी वात जे तमारा छुटकारा सी जोड़ायली से। <verse eid="HEB 6:9" /><verse number="10" style="v" sid="HEB 6:10" />तमु भगवान ना चोखला माणहु नी लगत मदत करता जाय्‌न जे मोंग देखाड़ला से, तीने अने तमारा बीजा कामु ने भगवान कदी नी भुले, तीहयु गलत नी हय। <verse eid="HEB 6:10" /><verse number="11" style="v" sid="HEB 6:11" />पण अमारी घणी ईच्‌छा आहयी से के, तमारी माय्‌न एक-एक जणो आखरी लग काठी मेहनत करता रेय। के तमु तीने पक्‌को तमु तीने हात कर लेहु जीनी तमु आह कर र्‌या। <verse eid="HEB 6:11" /><verse number="12" style="v" sid="HEB 6:12" />काहाके आमु नी चाहता के तमु ओगज्‌या बण जावो, पण तमु तीमनीन तेवा बणो जे भरहा पोर हीम्‌मत नी ह़ाते जे चीज ने हात कर र्‌या जीनो वायदो भगवान करलो हतो।<verse eid="HEB 6:12" /></para>
  <para style="s">भगवान नो नी टळवा वाळो वायदो</para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 6:13" />जत्‌यार भगवान अब्‌राहम सी वायदो करलो हतो, ता खुद तीनी सी मोटु कोय अळी नी हतु जीनी ह़ाम खाय सके, करीन आह़फा नी ह़ाम खाय्‌न, <verse eid="HEB 6:13" /><verse number="14" style="v" sid="HEB 6:14" />तीहयो केदो, “मे तने ह़ाचलीन ढेरेत संयबरकत आपही, अने तने ढेरेत अवल्‌यात आपही।” <verse eid="HEB 6:14" /><verse number="15" style="v" sid="HEB 6:15" />अने आहयी रीते अब्‌राहम दम धरीन भगवान नो वायदो करली वात हात कर लेदो। <verse eid="HEB 6:15" /><verse number="16" style="v" sid="HEB 6:16" />माणेह ते आह़फा गेथा काना मोटा नी ह़ाम खाय, अने तीमना ह़ाम आखा झगड़ा खत्‌तम करीन जे कंय केय तीने पक्‌कु कर देय। <verse eid="HEB 6:16" /><verse number="17" style="v" sid="HEB 6:17" />भगवान आने तीहया माणहु नी जुगु पुरी रीती सी आसुझण कर देवा हींडतो हतो, के तीहयो तीना मकसत ने कदी नी बदले। आनी करते तीहयो आह़फा ना वायदा ने ह़ाम ह़ाते जोड़ देदो। <verse eid="HEB 6:17" /><verse number="18" style="v" sid="HEB 6:18" />आञे बे वात से तीनो वायदो अने तीनी ह़ाम जे कदी नी बदली सके अने जीना बारा मे भगवान कदी झुट नी की सकतो। करीन आमु जे भगवान नी ह़ाते रखवाळी हात करवा करीन आवला से अने जे आह तीहयो आपणु ने आपलो से तीने धरीन, घण जादा होह मे से। <verse eid="HEB 6:18" /><verse number="19" style="v" sid="HEB 6:19" />तीहयी आह अमारा जीव नी लेदे एसवा ढुंड्‌यु रोकवा ना हेकड़ान तेवी से जे टेकली अने मजबुत से, जे मंदीर ना पड़दा नी मोय लग पुगली से,<note caller="+" style="f"><char style="fr" closed="false">6:19 </char><char style="ft" closed="false">ढुंड्‌यु ने रोकवा करीन ह़ाकळ वेर बांदीन मोट्‌ला दगड़ा ने पाणी मे नाखे तीने मांजरी केतला।</char></note> <verse eid="HEB 6:19" /><verse number="20" style="v" sid="HEB 6:20" />जां ईसु अमारी भणी गेथो अमारी सी पेले भरायो, तीहयो मलकीसीदक नी रीती मे जलमको डायलो पुंजारो बण ज्‌यो।<verse eid="HEB 6:20" /></para>
  <chapter eid="HEB 6" />
  <chapter number="7" style="c" sid="HEB 7" />
  <para style="s">मलकीसीदक नो पुंजारो</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 7:1" />आहयो मलकीसीदक सालोम नो राजा हतो, अने डायला भगवान नो पुंजारो हतो, जत्‌यार अब्‌राहम च्‌यार राजाम ने हरावीन पासो आव्‌वा बाज र्‌यो हतो, ता मलकीसीदक अब्‌राहम ने भेट्‌यो अने संयबरकत आप्‌यो। <verse eid="HEB 7:1" /><verse number="2" style="v" sid="HEB 7:2" />अने अब्‌राहम तीने तीहयु आखु मे गेथु जे तीहयो लड़ाय मे जीकलो हतो तीनो दसवो वाटो आप्‌यो। मलकीसीदक ना नाम नु पेलु मतलब से, “धरम नो राजो” अने अळी तीनु आहयु बी मतलब से, “सालोम नो राजो” मतलब “सांती नो राजा।” <verse eid="HEB 7:2" /><verse number="3" style="v" sid="HEB 7:3" />तीना बाह, अने आय्‌ह, अने आड़ा-बुड़ा नी कोय जानकारी नी जड़ती, तीनी पयदावारी अने मोत नी बी जानकारी नी हय, पण भगवान ना सोरान तेमेत जलमको पुंजारो बणीन रेय।<verse eid="HEB 7:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 7:4" />हाव वीच्‌यार करो के तीहयो केतरो मोटो हतो, जे कंय अब्‌राहम झगड़ा मे हात कर्‌यो तीनो दसवो वाटो आप्‌यो। <verse eid="HEB 7:4" /><verse number="5" style="v" sid="HEB 7:5" />लेवी नी अवल्‌यात मे गेथा जे पुंजारा नो जागो हात करे, तीमने कायदा नी अनसारे हुकम जड़लो से के ईस्‌रायल ना माणहु सी, मतलब आह़फाम ना माणहु सी, दसवो वाटो लेय, अळतेण तीहया अब्‌राहम नी अवल्‌यात बी काहा नी रेय। <verse eid="HEB 7:5" /><verse number="6" style="v" sid="HEB 7:6" />पण मलकीसीदक, जे तीमना घोराणा नो बी नी हतो, अब्‌राहम सी दसवो वाटो लेदो, अने जीमने वायदा जड़ला हता तीमने बरकत आप्‌यो। <verse eid="HEB 7:6" /><verse number="7" style="v" sid="HEB 7:7" />जा तक लेवीयो नो सवाल से आनी मे सण्‌का नी हय के नानलो मोट्‌ला पांह गेथो बरकत हात करे। <verse eid="HEB 7:7" /><verse number="8" style="v" sid="HEB 7:8" />अने आञे ते मरवा वाळा माणहु दसवो वाटो लेय, पण तां तेत लेत्‌ला से जीमनी गवाय देखाड़े के तीहया जीवत्‌ला से। <verse eid="HEB 7:8" /><verse number="9" style="v" sid="HEB 7:9" />ता आपणु आहयु बी की सकत्‌ला के लेवी बी, जे दसवो वाटो से, अब्‌राहम नी लारे दसवो वाटो आपला से। <verse eid="HEB 7:9" /><verse number="10" style="v" sid="HEB 7:10" />काहाके जत्‌यार मलकीसीदक अब्‌राहम ने भेटलो, ता लेवी पयदा बी नी हयो, तीहयो ते तीमना आड़ा-बुड़ा ना डील मेत हतो।<verse eid="HEB 7:10" /></para>
  <para style="s">मलकीसीदक नी तेम बीजो पुंजारो</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 7:11" />कदीम लेवी पुंजारा नी रीती नी लारे पुरुत कर लेय ता काना बीजा पुंजारा नी आव्‌वा नी जरवत ह़ु हती? काहाके आना आधार पोर माणहु ने कायदा बी आपला हता, एक एवा पुंजारा नी ह़ु जरवत हती जे मलकीसीदक नी रीती नो, नी पण हारुन नी रीती नो। <verse eid="HEB 7:11" /><verse number="12" style="v" sid="HEB 7:12" />काहाके जत्‌यार पुंजारा नो जागो बदली देय, ता कायदा नो जागो बी बदलवा नी जरवत से। <verse eid="HEB 7:12" /><verse number="13" style="v" sid="HEB 7:13" />काहाके जीनी बारा मे आहयी वात केय के आहयो बीजी जाती नो से, जीनी मे सी कोय बी वेदी नी चाकरी नी कर्‌यो। <verse eid="HEB 7:13" /><verse number="14" style="v" sid="HEB 7:14" />तां उजन्‌तु से के अमारो मालीक यहुदा नी जाती मे गेथो पयदा हयलो से अने आहयी जाती ना बारा मे मुसो पुंजारा ना जागा ना बारा मे कंय वात नी कर्‌यो।<verse eid="HEB 7:14" /></para>
  <para style="s">मलकीसीदक ने तेवो बीजो पुंजारो</para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 7:15" />अमारो दावो अळी बी वारु चोखो उजन्‌तो हय जाय, जत्‌यार मलकीसीदक ने तेवो एक अळी पुंजारो पयदा हय जाय, <verse eid="HEB 7:15" /><verse number="16" style="v" sid="HEB 7:16" />जे आहयी कळी ना कायदा ना अनसारे नी, पण खत्‌तम नी हयवा वाळी जीवाय नी सक्‌ती ना लारे पुंजारो बणलो से। <verse eid="HEB 7:16" /><verse number="17" style="v" sid="HEB 7:17" />काहाके तीना बारा मे आहयी गवाय देदलो से, “तु मलकीसीदक नी रीती पोर जलम-जलम नो पुंजारो से।” <verse eid="HEB 7:17" /><verse number="18" style="v" sid="HEB 7:18" />पेल्‌नो कायदा आनीन करते खत्‌तम कर देदा काहाके तीहयो कमजोर अने रीकामो हतो। <verse eid="HEB 7:18" /><verse number="19" style="v" sid="HEB 7:19" />आनीन करीन के मुसा ना कायदा कानी बी वात ने पुरी चोखी नी कर्‌यो, अने तीना जागा पोर एक एवी वारु आह मेकली से जीनी लारे आपणु भगवान ना ह़ाते जाय सकत्‌ला।<verse eid="HEB 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 7:20" />मसी ने टाळे वगर ह़ाम नी हयी, <verse eid="HEB 7:20" /><verse number="21" style="v" sid="HEB 7:21" />पण ईसु एक ह़ाम सी पुंजारो बणलो जत्‌यार भगवान तीने केदलो,</para>
  <para style="q1" vid="HEB 7:21">“मालीक ह़ाम खादो,</para>
  <para style="q2" vid="HEB 7:21">अने तीहयो आह़फा नु मन कदी नी बदले:</para>
  <para style="q1" vid="HEB 7:21">तु जलम-जलम नो पुंजारो बणीन रेही।”<verse eid="HEB 7:21" /></para>
  <para style="m">
    <verse number="22" style="v" sid="HEB 7:22" />आहयी ह़ाम ना कारण ईसु एक अळी वारु वायदा नी जामनी रेण्‌यो बण ज्‌यो।<verse eid="HEB 7:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 7:23" />तीहया घण ढेरका पुंजारा बणता आया, पण तीमनी मोत आह़फा ना पुंजारा ना जागा पोर जलम टेकला रेवा नी देती हती; <verse eid="HEB 7:23" /><verse number="24" style="v" sid="HEB 7:24" />काहाके ईसु अमर से, आहयात कारण सी तीनो डायला पुंजारा नो जागो जलम बण्‌लो रेय। <verse eid="HEB 7:24" /><verse number="25" style="v" sid="HEB 7:25" />एतरे जे तीनी लारे भगवान पांह आवत्‌ला से, तीहयो तीमनु पुरी रीती सी छुटकारो कर सकत्‌लो से, काहाके तीहयो तीमनी जुगु रावण्‌या करवा जलम जीवत्‌लो से।<verse eid="HEB 7:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 7:26" />अने ईसु, एवो मोट्लो पुंजारो से, जे अमारी जरवत ने पुरी कर सके, तीहयो चोखलो अने वण-गुनाळ्‌ळो दगो नी करन्‌यो अने ह़ुवाळो, अने पापी माणहु सी अलग, अने ह़रग गेथु बी उचु करलु से। <verse eid="HEB 7:26" /><verse number="27" style="v" sid="HEB 7:27" />अने तीहया बीजा पुंजारान तेम तीने जरवत ना हरेक दाड़े पेले आह़फा ना पाप अने माणहु ना पाप नी लेदे बली चड़ावे काहाके तीहयो आह़फा ने बली चड़ावीन जलम नी भेट आप देदो। <verse eid="HEB 7:27" /><verse number="28" style="v" sid="HEB 7:28" />मुसा ना कायदा ते पुरी रीती सी लुल्‌ला से, तीहया माणहे ने डायलो पुंजारो बणावे, पण भगवान नो वायदो तीनी ह़ाम खाय्‌न कर्‌यो तीहयो वायदो कायदान बाद आवलो से अने आहयो वायदो खास पुंजारा ना रुप मे सोरा ने टाळ्‌यो जे जलमको पुरोन-पुरो बण ज्‌यो।<verse eid="HEB 7:28" /></para>
  <chapter eid="HEB 7" />
  <chapter number="8" style="c" sid="HEB 8" />
  <para style="s">ईसु अमारो पुंजारो</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 8:1" />हमणे जे वात आमु की र्‌या तीमनी मे गेथी मोटी वात आहयी से के अमारो ईसम डायलो पुंजारो से, जे ह़रग पोर मोट्‌ला भगवान नी राजगादी ना जमणी धेड़े जाय्‌न बह ज्‌यो, <verse eid="HEB 8:1" /><verse number="2" style="v" sid="HEB 8:2" />अने चोखला जागा मे मतलब, खरला तम्‌बु नो चाकर्‌यो बण्‌यो जीने कानो माणेह नी, पण भगवान उबो करलो से।<verse eid="HEB 8:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 8:3" />काहाके आखा मोट्‌ला पुंजारा भेट अने बादा चड़ाव्‌वा करीन ठेरावत्‌ला से, आनीन करीन जरुड़ी से के आहया पुंजारा पांह बी कंय चड़ाव्‌वा नी लेदे हय। <verse eid="HEB 8:3" /><verse number="4" style="v" sid="HEB 8:4" />कदीम तीहयो धरती पोर रेतो ता कदी पुंजारो नी रेतो, काहाके तां पेले गेथात आवा पुंजारा से जे युहदी कायदा नी अनसारे भेट चड़ावे। <verse eid="HEB 8:4" /><verse number="5" style="v" sid="HEB 8:5" />जे पुंजारा नु काम तीहया करे तीहया जे ह़रग मे से तीनो एक साहळो जे तीनीन तेवो से। आहयु आहयी रीते से जत्‌यार मुसो चोखला तम्‌बु ने बणाव्‌वा वाळो हतो, ता भगवान तीने केदलो हतो, “ध्‌यान रेय के तु आखी चीज वारु तीहयीत रीते बणावे जे तने बड़ा पोर देखाड़ली हती।” <verse eid="HEB 8:5" /><verse number="6" style="v" sid="HEB 8:6" />पण हाव जे पुंजारा नी सेवा ईसु ने जड़ली से तीहया तीमना सेवा ना कामु सी वारु से, काहाके तीहयो जे वायदा नी वचमे से तीहयो जुन्‌ला वायदा गेथा वारु से। काहाके आहयु वारली चीज ना वायदा पोर टेकलो से।<verse eid="HEB 8:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 8:7" />काहाके पेल्‌ना वायदा मे कानी बी गलती नी हय, ता बीजा वायदा नी जरवत नी हती। <verse eid="HEB 8:7" /><verse number="8" style="v" sid="HEB 8:8" />पण भगवान माणहु पोर गुनो लगाड़ीन की र्‌यो, “मालीक केवा बाज र्‌यो, देखो, तीहया दाड़ा आव्‌वा बाज र्‌या”</para>
  <para style="q1" vid="HEB 8:8">“मे ईस्‌रायल ना घोराणा नी ह़ाते,</para>
  <para style="q2" vid="HEB 8:8">अने यहुदा ना माणहु ह़ाते नवलो वायदो बांदही।<verse eid="HEB 8:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="HEB 8:9" />आहयी ह़ेली बोलीन तेवी नी हये,</para>
  <para style="q2" vid="HEB 8:9">जे मे ईमना आड़ा-बुड़ा नी ह़ाते तीहयी टेमे बांदली हती,</para>
  <para style="q1" vid="HEB 8:9">जत्‌यार मे ईमनो हात धरीन ईमने मीसर देस सी नीकाळ लायो;</para>
  <para style="q2" vid="HEB 8:9">काहाके हीय्‌या वायदा पोर भरहा नी लायक नी र्‌या, एम करीन मे ते ईमनी खबर नी लेदो, भगवान बी आहयुत केवा बाज र्‌यो<verse eid="HEB 8:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="HEB 8:10" />अळी भगवान केवा बाज र्‌यो,</para>
  <para style="q2" vid="HEB 8:10">जे वायदो मे तीहया दाड़ान बाद ईस्‌रायल ना घोराणा नी ह़ाते बांदही;</para>
  <para style="q1" vid="HEB 8:10">तीहयो आहयो से के मे मारो कायदो तीमना मन मे नाखही,</para>
  <para style="q2" vid="HEB 8:10">अळी मे ईमनो भगवान बणही</para>
  <para style="q1" vid="HEB 8:10">अने हीय्‌या मारा माणहु बणहे।<verse eid="HEB 8:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="HEB 8:11" />अने कोय आह़फा ना दोस्‌तीदार्‌या ने</para>
  <para style="q2" vid="HEB 8:11">अने आह़फा ह़ाते वाळा ने आहयी ह़ीकापण नी आपे,</para>
  <para style="q2" vid="HEB 8:11">के तु मालीक ने ओळख,</para>
  <para style="q1" vid="HEB 8:11">काहाके नान्‌ला गेथा मोट्‌ला तक आखा मने जाण लेहे।<verse eid="HEB 8:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="HEB 8:12" />काहाके मे तीमना पाप ने माफ कर देही,</para>
  <para style="q2" vid="HEB 8:12">अने तीमना पाप ने मे अळी फोम नी करु।”<verse eid="HEB 8:12" /></para>
  <para style="m">
    <verse number="13" style="v" sid="HEB 8:13" />आहया वायदा ने नवलो कीन पेल्‌ना वायदा ने जुनो कर देदो, अने जे चीज जुनी अने जरजर हय जाय तीहयु छोटुत खत्‌तम हय जाय।<verse eid="HEB 8:13" /></para>
  <chapter eid="HEB 8" />
  <chapter number="9" style="c" sid="HEB 9" />
  <para style="s">धरती अने ह़रगे नी बड़ाय</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 9:1" />तीहयी पेल्‌नी बोली मे बी उपाह़ पाळवा ना कायदा हता, अने ईसम चोखलो जागो हतो जे आहयी कळी नो हतो। <verse eid="HEB 9:1" /><verse number="2" style="v" sid="HEB 9:2" />एक तम्‌बु बणावला हता, जीना पेल्‌ना कोपरा मे दीवलाय अने भगवान ने भेट करवा ना रोट्‌ला हता; अने तीहयो चोखलो जागो केवायतो हतो। <verse eid="HEB 9:2" /><verse number="3" style="v" sid="HEB 9:3" />बीजा पड़दा पसळ एक अळी कोपरो हतो, जे घणो वारु चोखलो जागो केवात्‌लो हतो। <verse eid="HEB 9:3" /><verse number="4" style="v" sid="HEB 9:4" />आनी मे वारु गंदायण्‌या धुप नी लेदे ह़ोना नी वेदी, अने च्‌यारो-मेर ह़ोना सी बणलु पेटारु हतु आहया पेटारा मे मन्‌ना सी भरलु ह़ोना नु ठाहरु हतु अने हारुन नी लाकड़ी जीनी मे डीरा नकळ्‌ळा हता अने बे दगड़ा जीनी पोर बे हुकम लीखला हता। <verse eid="HEB 9:4" /><verse number="5" style="v" sid="HEB 9:5" />तीमनी उपर बेम भबळवा वाळा ह़रगदुत हता, जे पाप नी माफी ना जागा पोर साहळो करला हता; ईमनु एक-एक करीन देखाड़वा नी टेम नी हय। <figure style="fig" alt="Interior of tabernacle" file="bk00278c.tif" size="span" copy="Horace Knowles ©" ref="9:2">भक्‌ती ना घोर नो मोय नो हीस्‌सो</figure><verse eid="HEB 9:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="HEB 9:6" />आखु कंय आनी रीते तीयार हय जवान बाद पुंजारो पेल्‌ना कोपरा मे दाड़ीनेत भराय्‌न आह़फा नु सेवा-चाकरी नु काम करवा जता हता। <verse eid="HEB 9:6" /><verse number="7" style="v" sid="HEB 9:7" />पण पड़दा ना मोय ना बीजा कोपरा मे खास पुंजारो साल मे एकीत कावा भरायतो हतो। अने तीहयो लोय वगर मोय कदी नी भरायतो हतो जीने तीहयो खुद आह़फा नी लारे अने माणहु नी लारे अंजाण्‌या मे करला पापु नी जुगु भगवान ने भेट चड़ावतो हतो। <verse eid="HEB 9:7" /><verse number="8" style="v" sid="HEB 9:8" />आनी लारे चोखली आत्‌मा वारु रीती सी आहयु ह़ीकाड़े के जत्‌यार तक बाहरलु तम्‌बु उबु हयलु से, तत्‌यार तक चोखला जागा नी वाट उगड़ली नी हये। <verse eid="HEB 9:8" /><verse number="9" style="v" sid="HEB 9:9" />आहयु एक तम्‌बु से जे हमणे नी टेम नी लेदे एक सेलाणी से; जीनी मे एक एवी भेट अने बादा चड़ाव्‌वान बाद बड़ाय करवा वाळा ना जीव चोखा नी हय सकता। <verse eid="HEB 9:9" /><verse number="10" style="v" sid="HEB 9:10" />तीहया ते बस खावा-पीवा अने अलग-अलग चोखा करवा ना जागा ना बाहरला कायदा से, अने भगवान ना नवला कायदा बणाव्‌वा नी टेम नी जुगुत लागु हये।<verse eid="HEB 9:10" /></para>
  <para style="s">मसी ना लोय नी सक्‌ती</para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 9:11" />पण जे वात पेले गेथीत आञे से एवी वारली चीज नो मसी पेले गेथोत खास पुंजारो बणीन आवलो से। तीहयु तम्‌बु जीनी मे तीहयो सेवा करे तीहयु घणु वारु अने आखी भाते पुरु हयलु तम्‌बु से। तीहयु माणहु ना हातु सी बणावलु तम्‌बु नी हय, अने आहयी कळी नु नी हय। <verse eid="HEB 9:11" /><verse number="12" style="v" sid="HEB 9:12" />अने बोकड़ा अने वाछड़ा ना लोय नी लारे नी पण आह़फा ना लोय नी लारे, मसी एकीत कावा तम्‌बु मे हय्‌न मोट्‌ला चोखला जागा मे भरायो, अने अमारी जुगु जलम नो छुटकारो हात कर्‌यो। <verse eid="HEB 9:12" /><verse number="13" style="v" sid="HEB 9:13" />काहाके जत्‌यार बोकड़ा अने बोळद्‌या नु लोय अने धपाड़ला केवड़्‌या नो रोखड़ो वीटळ्‌ळा माणहु पोर छाटवा सी तीहया चोखा हय जता हता, <verse eid="HEB 9:13" /><verse number="14" style="v" sid="HEB 9:14" />जत्‌यार आहयु ह़ाचली से ता मसी नु लोय केतरु आखा पोर राज करे एवु हहे, तीहयो अमरकाय आत्‌मा नी लारे आह़फा ने एक आखी बादान तेम भगवान ने आप देदा। ता तीनु लोय अमारी ह़मज ने तीहया कामु सी छुटकारो अपाड़हे जे मोत बणीन ली जाय, के आमु जीवत्‌ला भगवान नी सेवा कर सकया।<verse eid="HEB 9:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 9:15" />आहयात कारण सी मसी नवला कायदा नो वचे से, काहाके जीने भगवान लारे बोलावला से तीहया भगवान मे वायदो करला अमरकाय नी संयबरकत नो हकदार्‌यो हय सके, पेल्‌ना वायदा ना हक मे करला पापु सी तीमने छुटकारो करवा करीन बदला ना रुप मे तीहयो आह़फा नो जीव आप देदलो से।<verse eid="HEB 9:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="HEB 9:16" />जां तक मरजी नी चीट्‌ठी नो सवाल से तीनी जुगु जे तीने बणायो तीनी मोत नो पुरावो देवा बी जरुड़ी से। <verse eid="HEB 9:16" /><verse number="17" style="v" sid="HEB 9:17" />काहाके मरवान बाद वारीस नी चीट्‌ठी पाकी हये जत्‌यार तक वारीसदार जीवत्‌लो रेय तां तक वारीसदार नी चीट्‌ठी कामकी नी हय। <verse eid="HEB 9:17" /><verse number="18" style="v" sid="HEB 9:18" />एतरे पेल्‌नो वायदो बी लोय वगर नी करलो हतो। <verse eid="HEB 9:18" /><verse number="19" style="v" sid="HEB 9:19" />पेले मुसो जत्‌यार कायदा ना आखा हुकम ने आखा माणहु ने खबर कर देदो ता तीहयो पाणी नी ह़ाते बोकड़ा नु अने वाछड़ा नु लोय ने रात्‌लु हीर अने हीस्‌सप नी डाळ्‌या सी चामड़ा ना चीट्‌ठ्‌या अने कायदा नी कीताप पोर अने आखा माणहु पोर छाट देदलो हतो। <verse eid="HEB 9:19" /><verse number="20" style="v" sid="HEB 9:20" />अने तीहयो केदो, “आहयु तीहया वायदा नु लोय से, जीनो हुकम भगवान तमारी जुगु आपलो से।” <verse eid="HEB 9:20" /><verse number="21" style="v" sid="HEB 9:21" />अने आहयी रीते तम्‌बु अने सेवा नु आखु ह़मान पोर लोय छाट्‌यो<note caller="+" style="x"><char style="xo" closed="false">9:21 </char><char style="xt" closed="false"><ref loc="LEV 8:15">लेव्‌यवेवस्‌था 8:15</ref> </char></note> <verse eid="HEB 9:21" /><verse number="22" style="v" sid="HEB 9:22" />ह़ाचलीन मे कायदा नी लारे लोय सी लग-भग आखी चीज चोखी हये; अने लोय वयाड़्‌या वगर माफी नी हये।<verse eid="HEB 9:22" /></para>
  <para style="s">मसी नी बादा नी लारे पाप नी माफी</para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 9:23" />
    <note caller="+" style="x">
      <char style="xo" closed="false">9:23 </char>
      <char style="xt" closed="false">
        <ref loc="LEV 17:11">लेव्‌यवेवस्‌था 17:11</ref>
      </char>
    </note>ता आहयु जरुड़ी से के ह़रगे वाळी चीज ने तेम जानवरु ना बादा सी चोखी करे, पण ह़रग नी चीज आनी सी बी जादा वारु बादा सी चोखी करवा नी हेर करे। <verse eid="HEB 9:23" /><verse number="24" style="v" sid="HEB 9:24" />काहाके मसी मे माणहु ना हात ना बणावला चोखला जागा मे जे खरला अने चोखला जागान तेम से, भरायो नी, पण ह़रग मेत भरायो, काहाके अमारी जुगु हाव भगवान नी अगळ देखाव पड़े। <verse eid="HEB 9:24" /><verse number="25" style="v" sid="HEB 9:25" />आहयु नी के तीहयो आह़फा ने वळ-वळीन चड़ावे, जीसम के डायलो पुंजारो हर साल जानवरु नु लोय लीन चोखला जागा मे जीया करे। <verse eid="HEB 9:25" /><verse number="26" style="v" sid="HEB 9:26" />नीता कळी नी सुरुवात सी लीन मसी ने वळ-वळीन दुख झेलवा पड़तु; पण हाव कळी ना आखरी मे तीहयो एक कावा आखा नी जुगु उजन्‌तो हयलो से, काहाके आपणात बादा नी लारे पाप ने सेटो कर देय। <verse eid="HEB 9:26" /><verse number="27" style="v" sid="HEB 9:27" />अने जीसम माणहु नी लेदे एक कावा मरवा अने तीनी बाद नीयाव नु हयणु से जरुड़ी से। <verse eid="HEB 9:27" /><verse number="28" style="v" sid="HEB 9:28" />तेमेत मसी बी ढेरेत ना पापु ने उचल लेवा नी लेदे एक कावा बादा चड़्‌यो। अने जे माणहु तीनी वाट जोय रेत्‌ला, तीमना छुटकारा नी लेदे बीजी कावा वण-पापी देखाव पड़हे।<verse eid="HEB 9:28" /></para>
  <chapter eid="HEB 9" />
  <chapter number="10" style="c" sid="HEB 10" />
  <para style="p">
    <verse number="1" style="v" sid="HEB 10:1" />कायदो, ते आव्‌वा वाळी वारली वात नो साहळो एतरोत से, पण तीहया ते खरली वातु मे अने भरहा नी लायक ईज्‌जत नी हय। करीन तीहयात बादा नी लारे जीमने लगातार हर साल कदी नी खत्‌तम हये तीनीन तेम आपे। बड़ाय नी जुगु ह़ाते आव्‌वा वाळा ने जलमको पुरुन-पुरु चोखो नी कर सकता। <verse eid="HEB 10:1" /><verse number="2" style="v" sid="HEB 10:2" />कदीम आसम हय सकतु ता तीमनु बादा चड़ाव्‌वा नु बंद नी हय जतु? काहाके अळतेण ते उपाह़ पाळवा वाळा एक कावा मे जलमका चोखा हय जता, अने आह़फाम ना पापु नी लेदे खुद ने कदी पापी नी ह़मजता। <verse eid="HEB 10:2" /><verse number="3" style="v" sid="HEB 10:3" />पण हर साल चड़ाव्‌वा वाळी बादा माणहु ने तीमना पापु फोम करावे। <verse eid="HEB 10:3" /><verse number="4" style="v" sid="HEB 10:4" />काहाके बोळद्‌या अने बोकड़ा नु लोय पाप ने छेटु कर देय, आहयु हय नी सके।<verse eid="HEB 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 10:5" />एतरे जत्‌यार ईसु मसी आहयी कळी मे आव्‌वा वाळो हतो ता तीहयो केदलो हतो,</para>
  <para style="q1" vid="HEB 10:5">“तु कोय भेट अने बादा नी चाहतो,</para>
  <para style="q2" vid="HEB 10:5">पण तु मारी जुगु एक डील तीयार करलो से।<verse eid="HEB 10:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 10:6" />तु होम-बादा अने पाप नी बादा सी तु</para>
  <para style="q2" vid="HEB 10:6">खुस नी हयो।<verse eid="HEB 10:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="HEB 10:7" />तत्‌यार अळतेण मे केदो,</para>
  <para style="q2" vid="HEB 10:7">‘अने जेम कायदा नी कीताप मे बी लीखलु से, मे आञे से,</para>
  <para style="q2" vid="HEB 10:7">ए भगवान तारी ईच्‌छा पुरी करवा करीन आवलो से।’”<verse eid="HEB 10:7" /></para>
  <para style="m">
    <verse number="8" style="v" sid="HEB 10:8" />तीहयो पेले केदलो हतो, “बादा अने भेट अने होम-बादा अने पाप नी बादा तु नी चाहतो, अने तु तीनी सी खुस नी हयो।” ते बी कायदा आहयु चाहे के आहयु चड़ावे। <verse eid="HEB 10:8" /><verse number="9" style="v" sid="HEB 10:9" />अने अळतेण आहयु बी केय, “मे आञे से, मे तारी मरजी पुरी करवा आवलो से” ता तीहया पेल्‌ना कायदा ने खत्‌तम करवा करीन, बीजा कायदा ने तीयार करे। <verse eid="HEB 10:9" /><verse number="10" style="v" sid="HEB 10:10" />भगवान नी मरजी सी आपणु ईसु मसी ना डील ना एकीत कावा बादा चड़ाव्‌वा नी लारे चोखला करला से। <figure style="fig" alt="Burnt offering on an altar" file="hk00256c.tif" size="col" copy="Horace Knowles ©" ref="10:10">वेदी पोर बादा चड़ाव्‌वा</figure><verse eid="HEB 10:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 10:11" />एक-एक पुंजारो ते उबो हय्‌न दाड़ीन आह़फा ना धरमी वायदा पुरा करे, अने एकीत भातीन बादा ने जे पाप ने कदी बी सेटो नी कर सके, वळी-वळीन चड़ावे। <verse eid="HEB 10:11" /><verse number="12" style="v" sid="HEB 10:12" />पण मसी ते पुंजारा ना रुप मे पापु नी जुगु, जलमको एकीत बादा चड़ावीन भगवान नी जमणी ह़ोड़ जाय्‌न बह ज्‌यो। <verse eid="HEB 10:12" /><verse number="13" style="v" sid="HEB 10:13" />अने तीहयी टेमे सी आह़फा ना वीरोदी ने भगवान नी लारे तीना पुगु तळे नो पाटलो बणाय देवा नी वाट जोय र्‌यो। <verse eid="HEB 10:13" /><verse number="14" style="v" sid="HEB 10:14" />काहाके तीहयी एकीत भेट नी लारे तीमने जे चोखला करला से, हमेसा नी लेदे चोखो कर देदला से।<verse eid="HEB 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="HEB 10:15" />अने चोखली आत्‌मा बी आपणु ने आहयी गवाय देय; के तीहयो पेले केदलो हतो,<verse eid="HEB 10:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="HEB 10:16" />“मालीक केय के जे वायदो मे तीहया दाड़ान बाद</para>
  <para style="q2" vid="HEB 10:16">तीमनी सी करही तीहयो आहयो से के</para>
  <para style="q1" vid="HEB 10:16">मे आपणा कायदा ने तीमना मन पोर लीखही</para>
  <para style="q2" vid="HEB 10:16">अने मे तीमनी मे बहाड़ही।”<verse eid="HEB 10:16" /></para>
  <para style="m">
    <verse number="17" style="v" sid="HEB 10:17" />अळतेण तीहयो आहयु केय, “मे तीमना पाप ने तीमना बुरा कामु ने अळी कदी फोम नी करु।” <verse eid="HEB 10:17" /><verse number="18" style="v" sid="HEB 10:18" />अने कदीम जत्‌यार ईमनी माफी हय जेली से, ता पाप नी बादा नी री।<verse eid="HEB 10:18" /></para>
  <para style="s">आवो आपणु भगवान नी ह़ाते जीया</para>
  <para style="p">
    <verse number="19" style="v" sid="HEB 10:19" />एतरे ए भायु, अने बेन्‌या काहाके ईसु ना लोय नी लारे तीहया मोट्‌ला चोखला जागा मे भराय्‌वा नी खुद पोर भरहो अने हीम्‌मत से, <verse eid="HEB 10:19" /><verse number="20" style="v" sid="HEB 10:20" />जीने तीहयो पड़दा नी लारे मतलब आह़फा ना डील नी लारे एक नवली अने जीवत्‌ली वाट नी लारे उगाड़ देदलो से। <verse eid="HEB 10:20" /><verse number="21" style="v" sid="HEB 10:21" />अने एतरे अमारो एसवो मोट्‌लो पुंजारो से, जे भगवान ना घोर नो हकदार्‌यो से, <verse eid="HEB 10:21" /><verse number="22" style="v" sid="HEB 10:22" />ता आवो, आपणु खरला मन अने पुरा पक्‌का भरहा नी ह़ाते, अने मन ना गुना नी ईच्‌छा ने सेटी करवा करीन मन पोर लोय छीटीन, अने डील ने चोखला पाणी सी धोवाड़ीन भगवान ह़ाते जावो। <verse eid="HEB 10:22" /><verse number="23" style="v" sid="HEB 10:23" />आवो आपणु आपणी आह ने मानीन वातड़ा धरीन रेवो, काहाके जे वायदो करलो से, तीहयो ह़ाचो से; <verse eid="HEB 10:23" /><verse number="24" style="v" sid="HEB 10:24" />अने आवो, आमु धीयान राखया के मोंग अने भला कामु नी जुगु एक-बीजा ने बड़ावो आप सकया। <verse eid="HEB 10:24" /><verse number="25" style="v" sid="HEB 10:25" />अने एक-बीजा नी ह़ाते एकठा हयवा नी सोड़े, जीसम के केतरा नी रीती से, पण एक-बीजा ने ह़मजाड़ता रेवो; अने जीसम-जीसम तीहया दाड़ा ने ह़ाते आवत्‌लो देखो तीसम-तीसम अळी बी जादा आहयु कर्‌या करो।<verse eid="HEB 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="HEB 10:26" />काहाके सच्‌चाय नी ओळखाण ह़ात करवान बाद कदी आपणु जाण बुजीन पाप करता रीया, ता पाप नी लेदे अळी कानी बादा नी री। <verse eid="HEB 10:26" /><verse number="27" style="v" sid="HEB 10:27" />पण अळतेण ते आव्‌वा वाळा नीयाव घण-जबर आक्‌ठु नी बीक नी ह़ाते वाट जोव्‌वात बच जाय जे भगवान ना वीरोदी ने खत्‌तम कर देहे। <verse eid="HEB 10:27" /><verse number="28" style="v" sid="HEB 10:28" />जे कोय मुसा ना कायदा ने माने तीने दया देखाड़्‌या वगर बे नीता तीन माणहु नी गवाय पोर मार देय। <verse eid="HEB 10:28" /><verse number="29" style="v" sid="HEB 10:29" />ता सोच लेवो के तीहयो केतरा अळी भारी डंड नी लायक ठेरहे, जे भगवान ना सोरा ने अने वायदा नु लोय ने, नीकारो करे जीनी लारे तीहयो चोखो हयलो से, अने गीण-दया नी आत्‌मा नो वाक काडे। <verse eid="HEB 10:29" /><verse number="30" style="v" sid="HEB 10:30" />काहाके आमु तीने जाणया, जे केदलो हतो, “बदलो लेवा मारु काम से, मेत बदलो लेही।” अने अळी, “मालीक आह़फा ना माणहु नो नीयाव करहे।” <verse eid="HEB 10:30" /><verse number="31" style="v" sid="HEB 10:31" />जीवत्‌ला भगवान ना हात मे पड़ जवा एक घणी मोटी वात से।<verse eid="HEB 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 10:32" />पण तीहया पाछला दाड़ा ने फोम करो, जीमनी मे तमु भगवान नु वीजाळु हात करीन काठी मेहनत टणकाय सी टेकीन र्‌या, <verse eid="HEB 10:32" /><verse number="33" style="v" sid="HEB 10:33" />तत्‌यार कदी ते आखा माणहु नी अगळ नामबद्‌दी कर्‌या अने वेला पाड़्‌या अने कदी जीमनी ह़ाते एवो वेहवार करता हता तमु तीमनो सात देदा। <verse eid="HEB 10:33" /><verse number="34" style="v" sid="HEB 10:34" />काहाके तमु केदड़ा ना दुख मे साजल्‌या बण्‌या, अने खुद नु धन बी खुसी से लुटवा देदा; आहयु जाणीन के तमारी पांह एक अळी वारु अने जलमकु रेवा वाळु धन से। <verse eid="HEB 10:34" /><verse number="35" style="v" sid="HEB 10:35" />एतरे खुद नी हीम्‌मत ना सोड़ो काहाके हीनु फोळ मोटु से। <verse eid="HEB 10:35" /><verse number="36" style="v" sid="HEB 10:36" />काहाके तमने गम राखवा जरुड़ी से, काहाके तमु भगवान नी मरजी ने पुरी कर सको, अने जे वायदो तीहयो करलो से तीने तमु हात कर सको।<verse eid="HEB 10:36" /></para>
  <para style="q1">
    <verse number="37" style="v" sid="HEB 10:37" />काहाके जेम सास्‌तर केय,</para>
  <para style="q2" vid="HEB 10:37">“थोड़ीकेत टेम मे जे आव्‌वा वाळो से तीहयो आवहे।</para>
  <para style="q2" vid="HEB 10:37">तीहयो वार नी लगाड़े।<verse eid="HEB 10:37" /></para>
  <para style="q1">
    <verse number="38" style="v" sid="HEB 10:38" />पण मारा धरमी माणहु भरहा सी जीवत्‌ला रेहे,</para>
  <para style="q2" vid="HEB 10:38">अने कदी तीमनी माय्‌न कोय पाछु ह़रकी जाय</para>
  <para style="q2" vid="HEB 10:38">ता मे तीमनी सी खुस नी हयु।”<verse eid="HEB 10:38" /></para>
  <para style="m">
    <verse number="39" style="v" sid="HEB 10:39" />पण आमु पासा पड़वा वाळा नी हय के खत्‌तम हय जाय, पण तीमनी माय्‌न से जे भरहो करे अने जीव ने बचाड़ लेय।<verse eid="HEB 10:39" /></para>
  <chapter eid="HEB 10" />
  <chapter number="11" style="c" sid="HEB 11" />
  <para style="s">भरहो</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 11:1" />भरहा नु मतलब से, जीनी आमु आह करया जीनी जुगु पक्‌कु हयवा अने कानी चीज आमु भले देख नी सकता तीना हजुर हयवा नी आह करली चीज खरली से। <verse eid="HEB 11:1" /><verse number="2" style="v" sid="HEB 11:2" />आहयीत रीते पेल्‌ना वारा ना माणहु ने तीमना भरहा नी लारे भगवान नी राजी जड़ी।<verse eid="HEB 11:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 11:3" />
    <note caller="+" style="x">
      <char style="xo" closed="false">11:3 </char>
      <char style="xt" closed="false">
        <ref loc="JHN 1:3">युहन्‌ना 1:3</ref>
      </char>
    </note>भरहा सीत आमु जाण जीया के आखी धरती भगवान नात बोलु ना लारे बणली से। एतरे जे बणावली चीज देखाये, तीहयी देखायवा वाळी चीज सी नी बणी।<verse eid="HEB 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 11:4" />भरहा सीत हाबील केन सी वारलु भेट भगवान जुगु चड़ावलो, अने तीनीत लारे तीहयो धरमी हयवा नी गवाय बी देदलो से, भगवान तीनी भेट ना बारा मे गवाय देदो; अने तीनीत लारे तीहयो मरवान बाद बी हजु लग वात करे।<verse eid="HEB 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 11:5" />भरहा सीत हनोक उचलाय ज्‌यो के मोत ने नी देखे, अने तीने कोय ह़ोद नी सक्‌यु, काहाके भगवान तीने उपर उचल लेदलो हतो, अने तीने उचलवान पेले तीना बारा मे सास्‌तर आहयी गवाय देय, के हनोक उपर उचलाय जवान पेले तीहयो भगवान ने खुस कर्‌यो। <verse eid="HEB 11:5" /><verse number="6" style="v" sid="HEB 11:6" />अने भरहा वगर भगवान ने खुस नी कर सकत्‌ला, काहाके भगवान नी तां आव्‌वा वाळा ने भरहो करवा जोवे, के तीहयो से; अने तीने फोळ आपे जे तीने ह़ोदे।<verse eid="HEB 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 11:7" />भरहा ना कारण सीत नुहा ने जत्‌यार अगी हयवा वाळी वात नी भगवान चेतावणी आप्‌यो जे तीहयो देख्‌यो ता तीहयो चोखली बीक भेळ आह़फा ना घोरल्‌या ने बचाड़वा करीन एक ढुंड्‌यु ने बणावलो हतो। जे हयु तीना भरहा नी लारेत आहयी कळी ने गुनाळ्‌ळी ठेरायो, अने भरहा नी लारे भगवान भणी गेथी आव्‌वा वाळी धारमीक्‌ता ने हात कर्‌यो।<verse eid="HEB 11:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="HEB 11:8" />भरहा सीत जत्‌यार अब्‌राहम ने भगवान बोलावलो ता हुकम मानीन एवा जागा मे नीकळ ज्‌यो जीने हक मे लेवा वाळो हतो; अने आहयु नी जाणतो हतो मे कां जवा बाज र्‌यो, ते बी नीकळ ज्‌यो। <verse eid="HEB 11:8" /><verse number="9" style="v" sid="HEB 11:9" />भरहा सीत वायदो करला देस मे बीजा देस मे अंजाण्‌यान तेम, रीन ईसाक अने याकुब भेळ, जे तीनी ह़ाते तीहयात वायदा ना हकदार्‌या हता, तम्‌बु मे र्‌या। <verse eid="HEB 11:9" /><verse number="10" style="v" sid="HEB 11:10" />काहाके तीहयो ते तीहयी टेकली नीव वाळा ह़ेर नी वाट जोवतो हतो, जीने घड़न्‌यो अने बणावण्‌यो भगवान से।<verse eid="HEB 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="HEB 11:11" />भरहा ना कारण सीत अब्‌राहम जे घणो डायलो हय जेलो हतो अने सारा जे खुद वांज्‌याण हती भगवान पोर भरहो कर्‌या के तीहयो तीनो वायदो पुरो करे, अने अब्‌राहम बाह बण ज्‌यो। <verse eid="HEB 11:11" /><verse number="12" style="v" sid="HEB 11:12" />आनीन करते एकीत जणा सी जे, मरलान तेवो हतो, वादळा ना तारा अने दर्‌या नी बालु रेत ने तेम गणाये नी एतरी अवल्‌यात पयदा हयी।<verse eid="HEB 11:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="HEB 11:13" />आहया आखा भरहा नात हाल मे मर्‌या; अने तीहया वायदो करली चीज ने नी हात कर्‌या, पण तीने सेटात रीन देखीन खुस हया अने तीहया मान लेदा के आमु धरती पोर अंजाण्‌या अने बाहर वाळा से। <verse eid="HEB 11:13" /><verse number="14" style="v" sid="HEB 11:14" />तीहया माणहु जे एवी वात केय तीहया उजन्‌तु करे, तीहया आह़फाम नात देस ना ह़ोदवाळ्‌या से। <verse eid="HEB 11:14" /><verse number="15" style="v" sid="HEB 11:15" />अने जे देस तीहया सोड़ला से तीना बारा मे तीहया सोचता नी रेय, कदीम सोचता रेता ता तीमनो पासो आव्‌वा नो मोखो रेतो। <verse eid="HEB 11:15" /><verse number="16" style="v" sid="HEB 11:16" />पण तीहया एक वारलु देस मतलब ह़रग ना देस ने ह़ोदवा मे लाग र्‌या हता, एतरे भगवान तीमनो भगवान केवायवा मे नी लजवात्‌लो, काहाके तीहयो तीमनी लेदे एक ह़ेर तीयार करलो से।<verse eid="HEB 11:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 11:17" />भरहा सीत अब्‌राहम, पारख नी टेम मे, आह़फा ना सोरा ईसाक ने भेट ना रुप मे चड़ायो; अने जे वायदा ने ह़ाचली मान्‌लो हतो तीहयो आह़फा ना एक-खोळ्‌या सोरा ने भेट चड़ाव्‌वा तीयार हय ज्‌यो। <verse eid="HEB 11:17" /><verse number="18" style="v" sid="HEB 11:18" />अने ता तीने भगवान केदलो हतो, “ईसाक सीत तारी अवल्‌यात वदहे।” <verse eid="HEB 11:18" /><verse number="19" style="v" sid="HEB 11:19" />काहाके तीहयो मान लेदो, के भगवान ताखत वाळो से के तीने मरला मे गेथो जीवाड़े; अने तीमनीत मे गेथा दाखला नी रीती पोर तीहयो तीने अळी जड़्‌यो।<verse eid="HEB 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 11:20" />भरहा सीत ईसाक याकुब अने एसाव ने आव्‌वा वाळी वात ना बारा मे बरकत आपलो।<verse eid="HEB 11:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="HEB 11:21" />भरहा सीत याकुब मरती घड़ी युसुफ ना बेम सोरा मे सी एकीक ने बरकत आप्‌यो, अने आह़फा नी लाकड़ी नो टेको लीन भगवान नी बड़ाय कर्‌यो।<verse eid="HEB 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 11:22" />भरहा सीत युसुफ, जत्‌यार तीहयो मरवा वाळो हतो, ता ईस्‌रायली ने मीसर मे गेथा नीकळ जवा नी वात कर्‌यो, अने आह़फा ना हाकटा नी ह़ाते ह़ु करवा तीना बारा मे हुकम आप्‌यो।<verse eid="HEB 11:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="HEB 11:23" />भरहा सीत मुसा ना आय्‌ह-बाहा तीने, पयदा हयवान बाद तीन मयना लग ह़ताड़ीन राख्‌या, काहाके तीहया देख्‌या के सोरु घटाळु से, अने तीहया राजा ना हुकम तोड़वा सी नी बीह्‌या।<verse eid="HEB 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 11:24" />भरहा सीत मुसो मोटो हय्‌न फीरोन नी सोरी नो सोरो से केवायवा सी मना कर नाख्‌यो। <verse eid="HEB 11:24" /><verse number="25" style="v" sid="HEB 11:25" />आनीन करते के पाप मे थोड़ाक दाड़ा लग सुक लेवा सी वारु भगवान ना माणहु ह़ाते दुख झेलवा अळी बी वारु लाग्‌यु। <verse eid="HEB 11:25" /><verse number="26" style="v" sid="HEB 11:26" />अने ईसु मसी ना लेदे बेईज्‌जत्‌यो हयवा ने मीसर ना धन सी मोटु धन ह़मज्‌यो काहाके तीना डोळा ईलाम लेवा नी भणी लागला हता।<verse eid="HEB 11:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="HEB 11:27" />भरहा सीत राजा नी रीह सी नी बीहीन तीहयो मीसर देस सोड़ देदो, काहाके तीहयो वण-देख्‌या ने मानो देखतो जाय्‌न काठो र्‌यो। <verse eid="HEB 11:27" /><verse number="28" style="v" sid="HEB 11:28" />भरहा सीत तीहयो फसह नो तीवार अने झापला पोर लोय साटवा नी रीती ने मान्‌यो, के मोत नो दुत ईस्‌रायली नी पयदा हयली पेली अवल्‌यात ने नी मार सके।<verse eid="HEB 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="HEB 11:29" />भरहा सीत ईस्‌रायली माणहु रात्‌ली दर्‌या ना ह़ेली धेड़ आसम उतर ज्‌या, जीसम ह़ुकला जागा पोर सी उतरे; अने जत्‌यार मीसरी माणहु तीसमेत करवा चाह्‌या, ता आखा पाणी मे डुबीन मर ज्‌या।<verse eid="HEB 11:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="HEB 11:30" />भरहा सीत यरीहो नु भीतड़ु, जत्‌यार ईस्‌रायली ह़ात दाड़ा लग तीना च्‌यारो-मेर चक्‌कर लगाड़ देदा ता तीहयु भीतड़ु ओदरी ज्‌यु। <verse eid="HEB 11:30" /><verse number="31" style="v" sid="HEB 11:31" />भरहा सीत राहाब छीनाळ्‌याण भगवान ना हुकम नी मानवा वाळा ह़ाते खत्‌तम नी हयी, आनीन करते के तीहयी ईस्‌रायली ने वारु राखली हती।<verse eid="HEB 11:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="HEB 11:32" />हाव अळी मे वदु ह़ु केम? काहाके टेम नी री के गीदोन ना, अने बाराक, सीमसोन, यीफतह, दावुद, समुएल ना अने भगवान वगे गेथा केण्‌या माणहु ना बारा वात करु। <verse eid="HEB 11:32" /><verse number="33" style="v" sid="HEB 11:33" />तीहया भरहात सी राज्‌य ने जीक लेदा; धरम ना काम कर्‌या; अने भगवान वायदो करलो तीने हात कर्‌या; अने तीहया नाहर ना मोडा बंद कर देदा; <verse eid="HEB 11:33" /><verse number="34" style="v" sid="HEB 11:34" />आक्‌ठु नी आच ने टाडी कर देदा; तलवार नी धार सी बच ज्‌या; कमजोर मे गेथा ताखत वाळा हया; झुमायवा मे आखा गेथा हुस्‌यार नकळ्‌या, बाहर देस वाळा ना सीपायड़ा ने हराय नाख्‌या।<verse eid="HEB 11:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="HEB 11:35" />भरहा नी लारे बयरा ते आह़फाम ना मर जेला ह़गाय वाळा ने पासा जीवत्‌ला देख्‌या; केतरा ते मार खाता-खाता मर ज्‌या, अने सुटवा नी चाह्‌या, आनी लेदे के वारलु मरीन पासु जीवतु हयवा नु हात हये। <verse eid="HEB 11:35" /><verse number="36" style="v" sid="HEB 11:36" />भरहो करन्‌या माणहु नी हाही-ठट्‌टा उडाड़्‌या, अने ह़ड़काट्‌या, अने थोड़ाक ने ह़ाकळ्‌या वेर बांदीन जेल ने कुंड देदा। <verse eid="HEB 11:36" /><verse number="37" style="v" sid="HEB 11:37" />कंय माणहु ते दगड़ा वेते मार देदा; आरा वेते चीर देदा; तीमनो पारख कर्‌या; तलवार वेते मार देदा; तीहया गरबाय मे, अने वेला मे, अने दुख झेल्‌ता जाय्‌न, बोकड़ा अने गाडरा नी खाल ओडीन एथान-एथा मरला ह़रका फीर्‌या; <verse eid="HEB 11:37" /><verse number="38" style="v" sid="HEB 11:38" />अने उजाड़ी, बड़ा, अने मोट्‌ला दोरु मे, अने धरती नी चीह मे भटकता फीर्‌या। कळी तीमनी लायक नी हती।<verse eid="HEB 11:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="HEB 11:39" />तीमना भरहा ना कारण सीत आहया आखाम नो लेखो-जोखो राख्‌या, ते बी भगवान नो वायदो करली चीज तीमने नी जड़ी। <verse eid="HEB 11:39" /><verse number="40" style="v" sid="HEB 11:40" />काहाके भगवान अमारी जुगु पेले गेथोत एक वरली वात ठेरावलो से, के तीहया अमारी वगर चोखलापणा मे नी पुगे।<verse eid="HEB 11:40" /></para>
  <chapter eid="HEB 11" />
  <chapter number="12" style="c" sid="HEB 12" />
  <para style="s">गम धीरज नो बोलावो</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 12:1" />जां तक आमु गवाय ना एतरा मोटा वादळा सी घेरवाय र्‌या ता अळतेण आवो रोकावट नाखवा वाळी आखी चीज ने अने तीहया पाप ने आमने भुले पाड़ देय तीने नाख दे, अने तीहयी दवड़ ने जे आमने दवड़वा नी से तीने धीरज सी दवड़े। <verse eid="HEB 12:1" /><verse number="2" style="v" sid="HEB 12:2" />अमारा भरहा ने बणावण्‌या अने चोखला करवा वाळा ईसु भणी भाळया। जे आपणी अगळ हजुर खुसी नी लेदे कुरुस ना दुख झेल्‌यो, तीनी लजवायवा नी कोय चीन्‌ता नी हय के भगवान नी राजगादी नी जमणी ह़ोड़ जाय्‌न बह ज्‌यो।<verse eid="HEB 12:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="HEB 12:3" />आनीन करते तीनी पोर धीयान लगाड़ो, जे आह़फा ना वीरोद मे पापी नो एतरो सेड़साड़ वेठ लेदो के तमु ह़ोह़वाय्‌न भरहो नी सोड़ देवो। <verse eid="HEB 12:3" /><verse number="4" style="v" sid="HEB 12:4" />तमु ते पाप सी झुमाता जाय्‌न तीनी सी आसम जखड़ी नी कर्‌या, के तमारु लोय वयु हय। <verse eid="HEB 12:4" /><verse number="5" style="v" sid="HEB 12:5" />अने तमु तीहयी ह़ीकापण ने जे तमने सोरान तेम ह़मजीन आपली से, ह़ु तमु तीने भुल ज्‌या?</para>
  <para style="q1" vid="HEB 12:5">ए मारा सोरा, मालीक ईसु नी वेला ने हळकी वात ना जाणो,</para>
  <para style="q2" vid="HEB 12:5">अने जत्‌यार तीहयो तमने डंड आपे ता हीम्‌मत ना हारो।<verse eid="HEB 12:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="HEB 12:6" />काहाके मालीक ईसु, जीने मोंग करे, तीने दुख बी आपे,</para>
  <para style="q2" vid="HEB 12:6">अने जीने सोरो बणाय लेय, तीने ह़ोटी दीन बी ह़ुदारे।<verse eid="HEB 12:6" /></para>
  <para style="m">
    <verse number="7" style="v" sid="HEB 12:7" />तमु दुख ने डाट ह़मजीन वेठ लेवो; भगवान तमारी ह़ाते सोरो जाणीन वेहवार करे। तीहयो कानो सोरो से बाह नी लारे डंड हात करे? <verse eid="HEB 12:7" /><verse number="8" style="v" sid="HEB 12:8" />कदीम तीहया डंड जीना साजल्‌या आखा रीया, तमारो नी हय, ता तमु तीना सोरा नी हय, पण छीनाळ्‌या नी अवल्‌यात ठेर्‌या। <verse eid="HEB 12:8" /><verse number="9" style="v" sid="HEB 12:9" />अने अमारो धरती पोर वाळो बाह बी आपणु ने डंड आप्‌या करे अने आमु तीनी ईज्‌जत कर्‌या, ता ह़ु आत्‌मा ना बाह ह़ाते अळी बी कब्‌जा मे रीन जीवत्‌ला रेवो। <verse eid="HEB 12:9" /><verse number="10" style="v" sid="HEB 12:10" />तीहया ते आह़फा-आह़फा नी ह़मज नी अनसारे थोड़ाक दाड़ा जुगु डंड आप्‌या करता हता, पण तीहयो ते अमारा फायदा जुगु करे, के आमु बी तीना चोखलापण ना साजल्‌या हय जीया। <verse eid="HEB 12:10" /><verse number="11" style="v" sid="HEB 12:11" />हमणे आखी भाती नी डाट खुसी नी, पण दुख नीत वात देखाय पड़े; ते बी जे आने वेठता-वेठता पक्‌का हय जेला से, अळतेण तीमने अराम भेळ धरम नी जीवाय अने सांती नो फोळ जड़े।<verse eid="HEB 12:11" /></para>
  <para style="s">हुकम अने चेतावणी</para>
  <para style="p">
    <verse number="12" style="v" sid="HEB 12:12" />एतरे ढील्‌ला हातु ने उचा करो, अने कमजोर मांडा ने टणका करो, <verse eid="HEB 12:12" /><verse number="13" style="v" sid="HEB 12:13" />अने आपणा पोगु ना लेदे ह़ुदी वाट बणावो, के लंगड़ो भटके नी, पण वारु आरगो हय जाय।<verse eid="HEB 12:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="HEB 12:14" />आखा ह़ाते सांती सी रेवो, अने तीहया चोखलापण ना ह़ोदवाळ्‌या बणो जीनी वगर कोय मालीक ईसु ने कदी नी देख सके। <verse eid="HEB 12:14" /><verse number="15" style="v" sid="HEB 12:15" />अने धीयान सी देखता रेवो, आसम नी हये, के कोय भगवान नी दया सी सुटीन री जाय, नीता कोय कड़वली जेड़ फुटीन दुख आपे, अने तीनी लारे घणात माणहु बगड़्‌ला हय जाय। <verse eid="HEB 12:15" /><verse number="16" style="v" sid="HEB 12:16" />आसम नी हयवु जोवे, के कोय छीनाळ्‌यु, नीता एसाव नी तेम वण-धरमी हये, जे एक वार नु खाणु ना बदले आपणा पेलखोळ्‌या सोरा ना वेह मे आह़फा नो हक वेच नाख्‌यो। <verse eid="HEB 12:16" /><verse number="17" style="v" sid="HEB 12:17" />तमु ते जाणत्‌ला से, के अळतेण जत्‌यार तीहयो बरकत लेवा चाह्‌यो, पण तीहयो तीनी लायक नी ह़मजायो, अने आंह़वा वयाड़ी-वयाड़ीन ह़ोदवा सी बी मन फीराव्‌वा नो मोखो तीने नी जड़्‌यो।<verse eid="HEB 12:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 12:18" />तमु आक्‌ठु सी धपत्‌ला सीनाय बड़ान तां नी आया जीने छीम सकता हता, अने काळ्‌ळा वादळा, अने अंदारु, अने मोट्‌ला भुत्‌यान तां। <verse eid="HEB 12:18" /><verse number="19" style="v" sid="HEB 12:19" />अने फेपार्‌या नो अवाज, अने बोलवा वाळा ना एवा बोलु नी ह़ाते नी आया, जीने ह़मळवा वाळा रावण्‌या कर्‌या, के अळी वात अमारी सी नी करे। <verse eid="HEB 12:19" /><verse number="20" style="v" sid="HEB 12:20" />काहाके तीहया ते हुकम ने नी वेठ सक्‌या: “कदीम कानु जानवर बी बड़ा ने छीमे ता तीहयु दगड़ा सी मराय जहे।” <verse eid="HEB 12:20" /><verse number="21" style="v" sid="HEB 12:21" />अने तीहयो दरसन एतरो बीहाड़े एवो हतो के मुसो केदो, “मे घणो बीहु अने कापु।”<verse eid="HEB 12:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 12:22" />पण तमु सीयोन ना बड़ा, अने जीवत्‌ला भगवान ना ह़ेर, ह़रग ना यरुसलेम मे आय लागला से अने हजारु-हजारु ह़रगदुतु ना टोळा मे आय लागला से। <verse eid="HEB 12:22" /><verse number="23" style="v" sid="HEB 12:23" />तु भगवान सी पेन्‌ला पयदा हयला जीमना नाम ह़रग मे लीखला से, तीमना टोळा मे पुग जेला से। तमु तीहया भगवान ने तां आवला से जे आखा माणहु नो नीयाव करवा वाळो से, अने धरमी माणहु जे पाका हयला तीमनी आत्‌मा।<note caller="+" style="f"><char style="fr" closed="false">12:23 </char><char style="ft" closed="false">भजन सहीता 50:6, कुलुस्‌यो 1:12</char></note> <verse eid="HEB 12:23" /><verse number="24" style="v" sid="HEB 12:24" />अने एक नवला वायदा नी लारे ईसु अने छीटला तीहया लोय नी धेड़े आय लागला से जे हाबील ना लोय सी वारु वात केय।<verse eid="HEB 12:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 12:25" />चेतीन रेवो, अने तीहया केवा वाळा सी मोडु ना फीरवो, काहाके तीहया माणहु जत्‌यार धरती पोर ना चेतावणी आपण्‌या सी नकारो करीन नी बच सक्‌या, ता आमु ह़रग पोर गेथो चेतावणी आपण्‌या सी मोडु फीरवीन कीकम बच सकह़ुं? <verse eid="HEB 12:25" /><verse number="26" style="v" sid="HEB 12:26" />तीहयी टेमे ते तीना बोलु धरती ने हीलाय देदो, पण हाव तीहयो आहयो वायदो करलो से, “एक वार अळी मे धरती एतरो नी, पण वादळु ने बी हीलाय देही।” <verse eid="HEB 12:26" /><verse number="27" style="v" sid="HEB 12:27" />आहयो बोल “एक वार अळी” आहयी चीज ने उजन्‌ती करे, जे वात बणावली तीहयी हीलाय देहे टेकली नी रेय, अने टळ जहे, के जे वात ने हीलाय नी सकता, तीहयी टेकली रेहे।<verse eid="HEB 12:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="HEB 12:28" />अने जत्‌यार एक एवु राज जड़ र्‌यु जीने हीलाय नी सकता, ता आवो आमु घणा वारु से केण्‌या बणया अने ईज्‌जत भेळ बीक नी ह़ाते भगवान नी उपाह़ पाळया के भगवान तीने हुकारे। <verse eid="HEB 12:28" /><verse number="29" style="v" sid="HEB 12:29" />काहाके अमारो भगवान खत्‌तम करवा वाळु आक्‌ठु से।<verse eid="HEB 12:29" /></para>
  <chapter eid="HEB 12" />
  <chapter number="13" style="c" sid="HEB 13" />
  <para style="s">आमु भगवान ने कीसम खुस करीया?</para>
  <para style="p">
    <verse number="1" style="v" sid="HEB 13:1" />एक-बीजा मे भरहो करन्‌या भायु नो मोंग बणलो रेय। <verse eid="HEB 13:1" /><verse number="2" style="v" sid="HEB 13:2" />अंजाण्‌या माणहु नो आह़फाम ना घोर आव-भाव करवा ना भुलो, काहाके आनी लारे कंय माणहु ते अंजाण्‌या ह़रगदुतु नो आव-भाव करला से। <verse eid="HEB 13:2" /><verse number="3" style="v" sid="HEB 13:3" />केदड़ा नी आसम खबर लेवो, के मानो तीमनी ह़ाते तमु बी केद मे हय; अने जीमनी ह़ाते बुरो वेहवार हये, तीमने आहयी रीते फोम करो जेम मानो तमु खुद दुखी हय र्‌या हय।<verse eid="HEB 13:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="HEB 13:4" />आपणा वचमे वेवा आखी भात्‌ये ईज्‌जत सी हयवा जोवे, अने लाडी अने लाडा ने एक-बीजा पोर एदराय नी करवा जोवे, काहाके भगवान छीनाळ्‌या नो, अने बीजी बयर राखण्‌या नो नीयाव करहे।<verse eid="HEB 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="HEB 13:5" />तमु धन नी लालच नी करजो। अने जे तमारी पांह से तीनी मे खुस रेवो; काहाके भगवान खुद केदो, मे तने कदी नी सोड़ु, अने नी भुलु। <verse eid="HEB 13:5" /><verse number="6" style="v" sid="HEB 13:6" />एतरे आमु भरहा सीत कीया,</para>
  <para style="q1" vid="HEB 13:6">मालीक ईसु मारी मदत करत्‌लो</para>
  <para style="q2" vid="HEB 13:6">से मे नी बीहु,</para>
  <para style="q1" vid="HEB 13:6">माणेह मारु ह़ुं कर सके?<verse eid="HEB 13:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="HEB 13:7" />जे तमारा अगवाय करन्‌या से, अने जे तमने भगवान नो बोल ह़मळावला से, तीमने फोम राखो; के तीहया कीसम चाले, मरे, अने जीवे अने तीमना भरहा नी तेम चालवा नु करो। <verse eid="HEB 13:7" /><verse number="8" style="v" sid="HEB 13:8" />ईसु मसी आज अने काल जलम-जलम एक ह़रको से। <verse eid="HEB 13:8" /><verse number="9" style="v" sid="HEB 13:9" />आखी भाती नी अंजाण्‌यान ह़ीकापण सी ना भटको, आपणी जुगु आहयु वारु से के तीहया मन नी दया नी लारे मजबुत बणया, नी के खावा-पीवान तेवा कायदा ने मानवा सी जीनी सी तीमनो कंय फायदो नी हयो जे तीने मान्‌या।<verse eid="HEB 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="HEB 13:10" />अमारी एक आसवी वेदी से, जीनी पोर सी खावा नो हक तीहया पुंजारा ने नी, जे तम्‌बु नी चाकरी करत्‌ला से। <verse eid="HEB 13:10" /><verse number="11" style="v" sid="HEB 13:11" />काहाके जे जानवर नु लोय मोट्‌ला पुंजारा, पाप नी बादा नी लेदे चोखला जागा मे ली जाय्‌न, तीमनु डील ने मांडवा ना बारथु धपाड़त्‌ला। <verse eid="HEB 13:11" /><verse number="12" style="v" sid="HEB 13:12" />आनी कारण, ईसु बी माणहु ने आपणा लोय नी लारे चोखला करवा नी लेदे झापला ना बारथो दुख उठायो। <verse eid="HEB 13:12" /><verse number="13" style="v" sid="HEB 13:13" />ता एतरे, आवो तीनीन्‌तां मांडवान तां जीया अने तीनी बुराय मे साजल्‌या बणया। <verse eid="HEB 13:13" /><verse number="14" style="v" sid="HEB 13:14" />काहाके आञे धरती पोर अमारु कोय टेकलु रेवा वाळु ह़ेर नी हय, पण आमु एक आव्‌वा वाळा ह़ेर नी वाट जोय र्‌या। <verse eid="HEB 13:14" /><verse number="15" style="v" sid="HEB 13:15" />चालो आवो आपणु ईसु नी लारे भगवान ने बड़ाय ना रुप मे बादा चड़ावया जे तीहया होट्‌या नु फोळ से जे तीना नाम ने मान लेदा। <verse eid="HEB 13:15" /><verse number="16" style="v" sid="HEB 13:16" />भलाय करवा अने एक-बीजा नी मदत करवा ना भुलो, काहाके भगवान आसवी बादा सी खुस हये।<verse eid="HEB 13:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="HEB 13:17" />आपणा अगवाय करन्‌या ना हुकम मानो अने तीना हुकम पोर चालो, काहाके तीहया अराम कर्‌या वगर तमारा जीव नी लेदे तमारी पोर एवी चोकसी राखे जीमने आह़फाम नो लेखो-जोखो भगवान ने आपवा पड़हे<verse eid="HEB 13:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="HEB 13:18" />अमारी जुगु वीन्‌ती करता रेवो, काहाके आमने पक्‌कु से, के अमारु मन चोखलु से, अने आमु आखी वातु मे वारली चाल चालवा हींडत्‌ला। <verse eid="HEB 13:18" /><verse number="19" style="v" sid="HEB 13:19" />मे अगवाय करु के तमु वीन्‌ती कर्‌या करो के तमारीन्‌तां छोटोत आय सकु।<verse eid="HEB 13:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="HEB 13:20" />जे गाडरा ना मोट्‌ला गुवाळ्‌या अमारा मालीक ईसु ना लोय नी लारे तीहया जलमका वायदा पोर सीलटप्‌पो लगाड़ीन जीवाड़ उठाड़्‌यो, तीहयो सांती आपण्‌यो भगवान, <verse eid="HEB 13:20" /><verse number="21" style="v" sid="HEB 13:21" />तमने आखा वारला सादन आपीन पुरो करे, जीनी सी तमु तीनी मरजी पुरी कर सको, अने ईसु मसी नी लारे तीहयो अमारी मोय तीहयु आखु ने तीयार करे जे तीने गमे। जलम-जलम तक मसी नी बड़ाय हयती रेय। आमीन।<verse eid="HEB 13:21" /></para>
  <para style="s">आखरी सब्‌द</para>
  <para style="p">
    <verse number="22" style="v" sid="HEB 13:22" />ए भायु, अने बेन्‌या मे तमारी सी वीन्‌ती करु, के आहयी ह़ीकापण नी वात ने धीरारीन ह़मळो, काहाके मेत तमने घणु कमतु चीट्‌ठी मे लीखलो से। <verse eid="HEB 13:22" /><verse number="23" style="v" sid="HEB 13:23" />मे चाहु के तमने आहयु मालम हये के तीमुथीयुस अमारो भाय सुट जेलो से। अने कदी तीहयो ममार आय लागहे, ता मे तीनी ह़ाते तमने भेटवा आवही।<verse eid="HEB 13:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="HEB 13:24" />आपणा आखा अगवाय करन्‌या ने अने आखा भगवान ना चोखला माणहु ने वारला से के केजो। ईटली वाळा भरहो करन्‌या तमने वारला से के केय।<verse eid="HEB 13:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="HEB 13:25" />तमु आखा पोर भगवान नी दया हयती रेय। आमीन।<verse eid="HEB 13:25" /></para>
  <chapter eid="HEB 13" />
</usx>