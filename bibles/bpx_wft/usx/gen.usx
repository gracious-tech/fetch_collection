<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="GEN" style="id">- Paliya Project</book>
  <para style="h">उबजणाय कीताप</para>
  <para style="toc3">उबजणाय कीताप</para>
  <para style="toc2">उबजणाय कीताप</para>
  <para style="toc1">उबजणाय कीताप</para>
  <para style="mt1">उबजणाय कीताप</para>
  <para style="imt">जानकारी</para>
  <para style="ip">उबजवा सब्‌द नु मतलब से “सुरुवात” अने आहयी बायबल नी पुराना नेम नी पेल्‌ली कीताप से, मुल हीब्‌रु भासा नी सुरुवात बी आहया सब्‌द सी हये। सुरु मे आहयु देखाड़े के आखु कंय कां गेथु आयु अने खास करीन माणहु ह़ाते भगवान नो वेहवार कीकम सुरु हयो। आज जानकारुम नी पांह तीहया माणेह नीता माणहु ना बारा मे कंय मकसत से जे उबजणाय कीताप लीख्‌या अने आहयु बी के आने कारु लीखला हता। कंय माणहु नु माननु से के आने 5-6 वी सताब्‌दी ईसु पयदा हयवान पेले पुराणा कागजात सी एक्‌ठा कर्‌या हहे। बेबीलोन मे आड़जात्‌या माणहु पेले गेथी करता आय र्‌या तीहयी रीती-भाती ने माने के मुसो 1300 नीता 1400 साल पेले उबजणाय कीताप, अने अळी नीरगमन नी कीताप, लेव्‌यवेवस्‌था नी कीताप, अळी गीनती नी कीताप, अने वेवस्‌थावीवरण नी कीताप लीखलो हतो।</para>
  <para style="ip">उबजणाय कीताप मे खास जानकारी से जे ईसु वाळा ने बायबल नी बचला हीस्‌सा, पुराणा अने नवला नेम बेम ने ह़मजवा मे मदत करे। आहयु आमने देखाड़े के पाप कळी मे कीकम आयो अने माणहु ने एक छुटकारो आपण्‌या नी जरवत से। आहयी माणहु ने बचाड़वा नी भगवान नी योजना ने बी उजन्‌ती करे। आने ईसु ना बारा मे पेल्‌ली भगवान वगे गेथी केदली वात (<char style="xt" closed="false"><ref loc="GEN 1">उबजणाय कीताप</ref> </char><char style="xt"><ref loc="GEN 3:15">3:15</ref></char>) अने अब्‌राहम सी धरती पोर आखा राज्‌य ने बरकत आपवा ना भगवान ना वायदा सी देख सकत्‌ला (<char style="xt" closed="false"><ref loc="GEN 1">उबजणाय कीताप</ref> </char><char style="xt"><ref loc="GEN 12:3">12:3</ref></char>)</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. भगवान कळी अने आदम अने हवा ने बणायो। <char style="ior"><ref loc="GEN 1-2">1–2</ref></char></para>
  <para style="io1">2. आदम अने हवा, तीमना पाप अने तीमना कुळ ना बारा मे। <char style="ior"><ref loc="GEN 3-5">3–5</ref></char></para>
  <para style="io1">3. नुह अने मुसळ-धार्‌यो पाणी ना बारा मे देखाड़े। <char style="ior"><ref loc="GEN 6-9">6–9</ref></char></para>
  <para style="io1">4. नुह नी टेम अने अब्‌राहम नी टेम नी वच मे ह़ु हयु, जीनी मे बाबेल नो मीनार बी से। <char style="ior"><ref loc="GEN 10-11">10–11</ref></char></para>
  <para style="io1">5. अब्‌राहम अने तीना घोराणा ना अने ईस्‌रायल राज्‌य नी सुरुवात ना बारा मे से। <char style="ior"><ref loc="GEN 12-50">12–50</ref></char></para>
  <para style="io1">6. अब्‌राहम अने तीनी लाडी सारा नी जीवाय। <char style="ior"><ref loc="GEN 12-25">12–25</ref></char></para>
  <para style="io1">ईसाक अने तीनी लाडी रीबीका नी जीवाय, <char style="ior"><ref loc="GEN 21-28">21–28</ref> </char>अने तीनी मोत ना बारा मे । <char style="ior"><ref loc="GEN 35">35</ref></char></para>
  <para style="io1">7. याकुब अने तीना सोराम नी जीवाय अने कनान गेथो मीस्‌र तक जेलो तीना बारा मे। <char style="ior"><ref loc="GEN 20-50">20–50</ref></char></para>
  <para style="io1">8. याकुब ना मोंगाळ्‌ळा सोरा युसुफ नी जीवाय ना बारा मे देखाड़े अने आहयु बी देखाड़े के तीहयो कीकम मीस्‌र देस नो अदीकार्‌यो बण्‌यो। <char style="ior"><ref loc="GEN 37-50">37–50</ref></char></para>
  <chapter number="1" style="c" sid="GEN 1" />
  <para style="s">धरती ने बणावणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 1:1" />भगवान सुरुवात मे धरती अने ह़रग ने बणायो। <verse eid="GEN 1:1" /><verse number="2" style="v" sid="GEN 1:2" />धरती उबड़-खाबड़ अने ह़ुनह़ान हती, अने उंडला पाणी पोर अंदारलु हतु; अने भगवान नी आत्‌मा पाणी पोर फीरती हती। <verse eid="GEN 1:2" /><verse number="3" style="v" sid="GEN 1:3" />जत्‌यार भगवान केदो, “वीजाळु हय,” ता वीजाळु हय ज्‌यु। <verse eid="GEN 1:3" /><verse number="4" style="v" sid="GEN 1:4" />अने भगवान वीजाळा ने देख्‌यो के वारु से; अने भगवान वीजाळा ने अंदारु सी अलग कर्‌यो। <verse eid="GEN 1:4" /><verse number="5" style="v" sid="GEN 1:5" />अने भगवान वीजाळु ने दाड़ो अने अंदारु ने रात केदो। अने ह़ांतु हयु अळी ह़वारे हयु। आहयी रीते पेलो दाड़ो हय ज्‌यो।<verse eid="GEN 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 1:6" />अळी भगवान केदो, “पाणी ना वच मे एक एवो फरक हये के पाणी बे भाग हय जाय।” <verse eid="GEN 1:6" /><verse number="7" style="v" sid="GEN 1:7" />तत्‌यार भगवान एक फरक बणावीन हेट्‌लु पाणी ने अने उपर ना पाणी ने अलग-गलग कर्‌यो; अने तेमेत हय ज्‌यु। <verse eid="GEN 1:7" /><verse number="8" style="v" sid="GEN 1:8" />अने भगवान तीहया फरक ने ह़रग केदो। अने ह़ांतु हयु अळी ह़वारे हयु। आहयी रीते बीजो दाड़ो हय ज्‌यो।<verse eid="GEN 1:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 1:9" />अळी भगवान केदो, “ह़रग ने हेटलु पाणी एक जागा मे एकठु हय जाय अने ह़ुकली जागा देखाव पड़े,” अने तेमेत हय ज्‌यु। <verse eid="GEN 1:9" /><verse number="10" style="v" sid="GEN 1:10" />भगवान ह़ुकला जागा ने धरती केदो, अने जे पाणी एकठु हयु तीने तीहयो दर्‌या केदो: अने भगवान देख्‌यो के वारु से। <verse eid="GEN 1:10" /><verse number="11" style="v" sid="GEN 1:11" />अळी भगवान केदो, “धरती सी लील्‌लो चारो, अने बीज वाळा नाना-नाना झाड़, अने फोळ आपवा वाळा झाड़ बी जीमना बीज तीमनी मे एक-एक नी जाती ना अनसारे से, धरती पोर उगे,” अने तेमेत हय ज्‌यु। <verse eid="GEN 1:11" /><verse number="12" style="v" sid="GEN 1:12" />आहयी रीते धरती पोर लील्‌लो चारो अने नाना-नाना झाड़का जीमना जाती ना अनसारे बीज रेय, अने फोळ वाळा झाड़का जीमना जाती ना अनसारे फोळ मे बीज रेय उग्‌या: अने भगवान देख्‌यो के वारु से। <verse eid="GEN 1:12" /><verse number="13" style="v" sid="GEN 1:13" />अने ह़ांतु हयु अने ह़वारे हयु। आहयी रीते तीसरो दाड़ो हय ज्‌यो।<verse eid="GEN 1:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 1:14" />अळी भगवान केदो, “दाड़ा ने रात सी अलग करवा नी लेदे ह़रग ना वचमे वीजाळा उबजी जाय; अने तीहया सीजन, दाड़ा अने सालु नी सेलाण्‌या बणे। <verse eid="GEN 1:14" /><verse number="15" style="v" sid="GEN 1:15" />अने तीहया वीजाळा ह़रग ना वचमे धरती पोर वीजाळु आप्‌या करो,” अने तेमेत हय ज्‌यु। <verse eid="GEN 1:15" /><verse number="16" style="v" sid="GEN 1:16" />तत्‌यार भगवान बे मोट्‌ला वीजाळा बणायो; तीमनी मे सी मोट्‌ला वीजाळा ने दाड़ा पोर राज करवा नी लेदे अने नान्‌ला वीजाळा ने रात पोर राज करवा नी लेदे बणायो; अने तारागण ने बी बणायो। <verse eid="GEN 1:16" /><verse number="17" style="v" sid="GEN 1:17" />भगवान तीमने ह़रग ना फरक मे आनीन करते राख्‌यो के तीहया धरती पोर वीजाळु आपे, <verse eid="GEN 1:17" /><verse number="18" style="v" sid="GEN 1:18" />अने दाड़ा पोर अने रात पोर राज करे, अने वीजाळु ने अंदारु सी अलग करे: अने भगवान देख्‌यो के वारु से। <verse eid="GEN 1:18" /><verse number="19" style="v" sid="GEN 1:19" />अने ह़ांतु हयु अने ह़वारे हयु। आहयी रीते चोवथो दाड़ो हय ज्‌यो।<verse eid="GEN 1:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 1:20" />अळी भगवान केदो, “पाणी जीवत्‌ला जीवु सी घणु भराय जाय, अने चड़ा धरतीन उपर ह़रग नी वच मे उडे।” <verse eid="GEN 1:20" /><verse number="21" style="v" sid="GEN 1:21" />करीन भगवान जाती-जाती ना मोटा-मोटा पाणी ना जीवु ने, अने तीहया आखा जीवत्‌ला जीवु ने बी बणायो जे चाले-फीरे, अने एक-एक जाती ना उडवा वाळा चड़ा ने बी बणायो: अने भगवान देख्‌यो के वारु से। <verse eid="GEN 1:21" /><verse number="22" style="v" sid="GEN 1:22" />अने भगवान आहयु कीन तीमने बरकत आप्‌यो, “फुलो-फालो, अने दर्‌या ना पाणी मे भराय जावो, अने चड़ा धरती पोर वदे।” <verse eid="GEN 1:22" /><verse number="23" style="v" sid="GEN 1:23" />अने ह़ांतु हयु अळी ह़वारे हयु। आहयी रीते पांचवो दाड़ो हय ज्‌यो।<verse eid="GEN 1:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 1:24" />अळी भगवान केदो, “धरती सी एक-एक जाती ना जीवत्‌ला जीव, मतलब घोर पाळन्‌या जानवरु, अने घीहाय्‌न चालन्‌या जीव-जन्‌तु, अने धरती ना जंगली जानवरु, जाती-जाती ना अनसारे उबजे,” अने तेमेत हय ज्‌यु। <verse eid="GEN 1:24" /><verse number="25" style="v" sid="GEN 1:25" />आहयी रीते भगवान धरती ना जाती-जाती ना जंगली जानवरु ने, अने जाती-जाती ना घोर पाळन्‌या जानवरु ने, अने जाती-जाती ना धरती पोर आखा घीहाय्‌न चालन्‌या जीव-जन्‌तु ने बणायो: अने भगवान देख्‌यो के वारु से।<verse eid="GEN 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 1:26" />अळी भगवान केदो, “आपणु माणेह जात ने आपणा सीका मे, आपणीन तेम बणावया; अने तीहया दर्‌या ना माछला पोर, अने ह़रग ना चड़ा पोर, अने घोर पाळन्‌या जानवरु पोर, अने आखी धरती पोर, अने धरती पोर घीहाय्‌न चालन्‌या जीव-जन्‌तु पोर, हक राखे।”<note caller="+" style="x"><char style="xo" closed="false">1:26 </char><char style="xt" closed="false"><ref loc="1CO 11:7">1 कुरन्‌थी 11:7</ref></char></note> <verse eid="GEN 1:26" /><verse number="27" style="v" sid="GEN 1:27" />तत्‌यार भगवान माणेह ने आह़फा ना सीका मे घड़्‌यो, भगवान तीमने आह़फा नात सीका मे घड़्‌यो; आसम करीन तीहयो अदमी अने बयर ने घड़्‌यो।<note caller="+" style="x"><char style="xo" closed="false">1:27 </char><char style="xt" closed="false"><ref loc="MAT 19:4">मत्‌ती 19:4</ref>; <ref loc="MRK 10:6">मरकुस 10:6</ref></char></note> <verse eid="GEN 1:27" /><verse number="28" style="v" sid="GEN 1:28" />अने भगवान तीमने बरकत आप्‌यो अने तीमने केदो, “फुलो-फालो, अने धरती पोर भराय जावो, अने तीने आपणा हक मे कर लेवो; अने दर्‌या ना माछला पोर, अने ह़रग ना चड़ा पोर, अने धरती पोर घीहाय्‌न चालन्‌या आखा जीव-जन्‌तु पोर हक राखो।” <verse eid="GEN 1:28" /><verse number="29" style="v" sid="GEN 1:29" />अळी भगवान तीमने केदो, “ह़मळो, जेतरा बीज वाळा नाना-नाना झाड़ आखी धरती पोर से अने जेतरा झाड़ मे बीज वाळा फोळ रेय, तीहया आखा में तमने आपलो से; तीहया तमारा खाणा जुगु से। <verse eid="GEN 1:29" /><verse number="30" style="v" sid="GEN 1:30" />अने जेतरा धरती ना जानवरु, अने ह़रग ना चड़ा, अने धरती पोर घीहाय्‌न चालन्‌या जीव-जन्‌तु से, जीनी मे जीवाय नो जीव से, तीहया आखा जुगु में खावा करीन लील्‌ला झाड़-झाटवा आपलो से,” अने तेमेत हय ज्‌यु। <verse eid="GEN 1:30" /><verse number="31" style="v" sid="GEN 1:31" />तत्‌यार भगवान जे कंय बणावलो हतो तीहयु आखु ने देखीन केदो, आहयु घणु वारु से। अने ह़ांतु हयु अने ह़वारे हयु। आहयी रीते छटवो दाड़ो हय ज्‌यो।<verse eid="GEN 1:31" /></para>
  <chapter eid="GEN 1" />
  <chapter number="2" style="c" sid="GEN 2" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 2:1" />आहयी रीते ह़रग अने धरती अने जे कंय तीनी मे से तीमने बणावणु खत्‌तम हय ज्‌यु। <verse eid="GEN 2:1" /><verse number="2" style="v" sid="GEN 2:2" />अने भगवान आह़फा नु काम जीने तीहयो करतो हतो ह़ातवा दाड़े पुरु कर्‌यो, अने तीहयो आह़फा ना करला आखा काम सी ह़ातवा दाड़े अराम कर्‌यो।<note caller="+" style="x"><char style="xo" closed="false">2:2 </char><char style="xt" closed="false"><ref loc="HEB 4:4">ईब्‌रानीयो 4:4</ref>,<ref loc="HEB 4:10">10</ref></char></note> <verse eid="GEN 2:2" /><verse number="3" style="v" sid="GEN 2:3" />अने भगवान ह़ातवा दाड़ा ने बरकत आप्‌यो अने चोखलो ठेरायो; काहाके तीहया दाड़े तीहयो धरती बणाव्‌वा ना आह़फा ना आखा कामु सी नवराय्‌न अराम करलो।<verse eid="GEN 2:3" /></para>
  <para style="s">माणहु नु घड़ायणु</para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 2:4" />ह़रग अने धरती उबजवा ना बारा मे आहयु से के जत्‌यार तीहया उबज्‌या मतलब जे दाड़े यहोवा भगवान धरती अने ह़रग ने बणायो: <verse eid="GEN 2:4" /><verse number="5" style="v" sid="GEN 2:5" />तत्‌यार धरती पोर कानु बी झाड़ नी हतु, अने धरती ना जागा मे हतु, काहाके यहोवा भगवान धरती पोर पाणी नी पाड़्‌यो हतो, अने धरती पोर खेती करवा नी लेदे माणेह बी नी हतु; <verse eid="GEN 2:5" /><verse number="6" style="v" sid="GEN 2:6" />ते बी धुवरु धरती पोर गेथु उडतु हतु जीनी सी आखी जागा भीगी जती हती।<verse eid="GEN 2:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 2:7" />तत्‌यार यहोवा भगवान माणेह<note caller="+" style="f"><char style="fr" closed="false">2:7 </char><char style="ft" closed="false">माणेह</char></note> ने धरती ना कादा सी बणायो, अने तीना नखरा मे जीवाय नी ह़ाह़ फुक देदो; अने तीहयो माणेह एक जीवत्‌लो माणेह बण ज्‌यो।<note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="1CO 15:45">1 कुरन्‌थी 15:45</ref>,<ref loc="1CO 15:47">47</ref></char></note><verse eid="GEN 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 2:8" />अने यहोवा भगवान उगवणु अदन मे एक बगीचो लगाड़्‌यो, अने तां आदम ने जीने तीहयो बणावलो हतो, मेक देदो। <verse eid="GEN 2:8" /><verse number="9" style="v" sid="GEN 2:9" />अने यहोवा भगवान धरती सी आखा भाती ना झाड़, जे देखवा मे घटाळा अने जीना फोळ खावा मे वारु से, उगाड़्‌यो, अने बगीचा ना वच मे जीवाय ना झाड़ ने अने भला अने बुरा ग्‌यान नु झाड़ बी लगाड़्‌यो।<verse eid="GEN 2:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 2:10" />तीहया बगीचा मे पाणी देवा नी लेदे एक मोट्‌ली नंदी अदन सी नीकळी अने तां गेथी अगी जाय्‌न च्‌यार नंदी मे वटाय जी।<note caller="+" style="x"><char style="xo" closed="false">2:10 </char><char style="xt" closed="false"><ref loc="EZK 47:11">यहेजकेल 47:11</ref></char></note> <verse eid="GEN 2:10" /><verse number="11" style="v" sid="GEN 2:11" />पेली नंदी नु नाम पीसोन से; आहयी तीहयी से जे हवीला नाम ना आखा देस ने घेरवी री, जां ह़ोनु जड़े।<verse eid="GEN 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 2:12" />तीहया देस नु ह़ोनु चोखु रेय; तां मोती अने सुलेमानी दगड़ा बी जड़े। <verse eid="GEN 2:12" /><verse number="13" style="v" sid="GEN 2:13" />बीजी नंदी नु नाम गीहोन से; आहयी तीहयी से जे कुस ना आखा देस ने घेरवी री। <verse eid="GEN 2:13" /><verse number="14" style="v" sid="GEN 2:14" />तीसरी नंदी नु नाम हीदकेल से; आहयी तीहयी से जे अस्‌सुर नी उगवणी ह़ोड़ वये। अने चोवथी नंदी नु नाम फरात से।<verse eid="GEN 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 2:15" />तत्‌यार यहोवा भगवान माणेह ने लीन अदन ना बगीचा मे मेल देदो, के तीहयो तीनी मे काम करे अने तीनी रखवाळी करे। <verse eid="GEN 2:15" /><verse number="16" style="v" sid="GEN 2:16" />अने यहोवा भगवान माणेह ने आहयो हुकम आप्‌यो, “तु बगीचा ना आखा झाड़ ना फोळ ने सण्‌का कर्‌या वगर खाय सके, <verse eid="GEN 2:16" /><verse number="17" style="v" sid="GEN 2:17" />पण भला नीता बुरा ग्‌यान नु जे झाड़ से तीनो फोळ तु नी खाजे; काहाके जे दाड़े तु हीनो फोळ खाही, ते दाड़े तु पक्‌को मर जही।”<note caller="+" style="x"><char style="xo" closed="false">2:17 </char><char style="xt" closed="false"><ref loc="ROM 6:23">रोमीयो 6:23</ref></char></note><verse eid="GEN 2:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 2:18" />अळतेण यहोवा भगवान केदो, “माणेह नु एखलु रेवा वारु नी हय; मे हीनी जुगु एक एवो मदत करन्‌यो बणावही जे हीनी सी मेळ खाय।” <verse eid="GEN 2:18" /><verse number="19" style="v" sid="GEN 2:19" />अने यहोवा भगवान धरती मे गेथा आखा जाती ना बणला जानवरु, अने ह़रग ना आखी भाती ना चड़ा ने बणावीन माणेह ने तां ली आयो अने देखे के तीहयो तीमनु ह़ु-ह़ु नाम पाड़े; अने जे-जे जीवत्‌ला जानवरु नु जे-जे नाम माणेह पाड़्‌यो तीहयुत तीमनु नाम हय ज्‌यु।<note caller="+" style="x"><char style="xo" closed="false">2:19 </char><char style="xt" closed="false"><ref loc="PSA 8:6">भजन सहीता 8:6</ref></char></note> <verse eid="GEN 2:19" /><verse number="20" style="v" sid="GEN 2:20" />अने आदम आखी जाती ना घोर ना जानवरु, अने ह़रग ना चड़ा, अने आखी जाती ना बणला जानवरु नु नाम पाड़्‌यो; पण आदम जुगु कोय ईसम मदत करवा वाळु नी जड़्‌यु जे तीनी सी मेळ खाय सके। <verse eid="GEN 2:20" /><verse number="21" style="v" sid="GEN 2:21" />तत्‌यार यहोवा भगवान आदम ने भारी नींदर मे ह़ुवाड़ देदो, अने जत्‌यार तीहयो ह़ुय ज्‌यो तत्‌यार तीहयो तीनी पाहळी नकाळीन तीनी जागा पोर माह भर देदो। <verse eid="GEN 2:21" /><verse number="22" style="v" sid="GEN 2:22" />अने यहोवा भगवान तीहयी पाहळी ने जीने आदम मे गेथी नीकाळ्‌ळी हती, बयर बणाय देदो; अने तीने आदम ने तां ली आयो। <verse eid="GEN 2:22" /><verse number="23" style="v" sid="GEN 2:23" />तत्‌यार आदम केदो, “हाव आहयी मारा हाकटा मे नी हाटकी अने मारा माह नु माह से; एतरे आहयी बयर केवायहे; काहाके आहयी माणेह मे गेथी नीकाळ्‌ळी से।”<note caller="+" style="x"><char style="xo" closed="false">2:23 </char><char style="xt" closed="false"><ref loc="GEN 29:14">उबजणाय कीताप 29:14</ref>; <ref loc="2SA 5:1">2 समुवेल 5:1</ref>; <ref loc="1CO 11:8">1 कुरन्‌थी 11:8</ref>; <ref loc="1TI 2:13">1 तीमुथीयुस 2:13</ref> </char></note> <verse eid="GEN 2:23" /><verse number="24" style="v" sid="GEN 2:24" />एतरे माणेह आह़फा आह्‌य-बाह ने छोड़ीन आह़फा नी लाडी ह़ाते रेहे, अने तीहया एकीत डील बणीन रेहे।<note caller="+" style="x"><char style="xo" closed="false">2:24 </char><char style="xt" closed="false"><ref loc="MAT 19:5">मत्‌ती 19:5</ref>; <ref loc="1CO 6:16">1 कुरन्‌थी 6:16</ref>; <ref loc="EPH 5:31">ईफीसीयो 5:31</ref></char></note> <verse eid="GEN 2:24" /><verse number="25" style="v" sid="GEN 2:25" />आदम अने तीनी लाडी बेम नांगरला हता, पण लजवायता नी हता।<verse eid="GEN 2:25" /></para>
  <chapter eid="GEN 2" />
  <chapter number="3" style="c" sid="GEN 3" />
  <para style="s">माणेह भगवान नो हुकम नी माने</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 3:1" />यहोवा भगवान जेतरा जंगली जानवरु बणावलो हतो, तीमनी आखा मे गड़हो चलाक हतो; तीहयो बयर ने केदो, “ह़ु ह़ाचलीन भगवान केदलो से के तमु बगीचा ना काना बी झाड़ नो फोळ नी खाजो?”<note caller="+" style="x"><char style="xo" closed="false">3:1 </char><char style="xt" closed="false"><ref loc="REV 12:9">परकासीतवाक्‌य 12:9</ref>; <ref loc="JOL 2:24">योएल 2:24</ref>; <ref loc="REV 20:2">परकासीतवाक्‌य 20:2</ref></char></note><verse eid="GEN 3:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 3:2" />बयर गड़हा ने जपाप आपी, आमु बगीचा ना झाड़ नु फोळ खाय सकीया। <verse eid="GEN 3:2" /><verse number="3" style="v" sid="GEN 3:3" />“पण भगवान केदलो से, बगीचा ना वचे लागला झाड़ नु फोळ नी खाजो, अने नी छीमजो, नीता तमु मर जहु।”<verse eid="GEN 3:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 3:4" />तत्‌यार गड़हो बयर ने केदो, तमु पक्‌का नी मरो। <verse eid="GEN 3:4" /><verse number="5" style="v" sid="GEN 3:5" />भगवान जाणे के जे दाड़े तमु तीनो फोळ खाहु तत्‌यार तमारा डोळा उगड़ी जहे, अने तमु भला अने बुरा ग्‌यान ने जाणीन भगवान ने तेवा बण जहु।<note caller="+" style="x"><char style="xo" closed="false">3:5 </char><char style="xt" closed="false"><ref loc="EZK 28:2">यहेजकेल 28:2</ref></char></note><verse eid="GEN 3:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 3:6" />एतरे जत्‌यार बयर देखी के तीहया झाड़ नु फोळ खावा जुगु वारु से, अने देखवा मे मन गमता, अने अक्‌कल आपवा जुगु चाहवा लायक बी से, तत्‌यार तीहयी तीनु फोळ तोड़ी, अने तीने खादी, अने आह़फी ना लाडा ने बी आपी, अने तीहयो बी खादो। <verse eid="GEN 3:6" /><verse number="7" style="v" sid="GEN 3:7" />तत्‌यार बेम जणा ना डोळा उगड़ी ज्‌या, अने तीमने मालम पड़्‌यु के तीहया नांगरला से; एतरे तीहया अंजीर ना पान्‌टा ह़ीवीन कस्‌टु बणाय लेदा।<verse eid="GEN 3:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 3:8" />जत्‌यार ह़ांत्‌ली टेमे तीहया बगीचा मे यहोवा भगवान ने चालतो-फीरतो ह़मळ्‌या ता आदम अने तीनी लाडी बगीचा ना झाड़ु ना वचे ह़ताय ज्‌या। <verse eid="GEN 3:8" /><verse number="9" style="v" sid="GEN 3:9" />तत्‌यार यहोवा भगवान आदम ने आड़ीन पुछ्‌यो, तु कां से?<verse eid="GEN 3:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 3:10" />तीहयो केदो, मे बगीचा मे तारी अवाज ह़मळीन बीह ज्‌यो, काहाके मे नांगरलो हतो; एतरे मे ह़ताय ज्‌यो।<verse eid="GEN 3:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 3:11" />“तीहयो केदो, कोय तने देखाड़्‌यु के तु नांगरलो से? जे झाड़ नु फोळ मे तने नी खावा करीन केदलो, ह़ु तु तीनु फोळ खादलो से?”<verse eid="GEN 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 3:12" />आदम केदो, “जे बयर ने तु मारी ह़ाते रेवा करीन आपलो से, तीहयीत तीहया झाड़ नु फोळ मने आपी, अने मे खादो।”<verse eid="GEN 3:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 3:13" />तत्‌यार यहोवा भगवान बयर ने केदो, तु आहयु ह़ु करी? बयर केदी, गड़हो मने बहकाड़ देदो, ता मे खादी।<verse eid="GEN 3:13" /></para>
  <para style="s">भगवान नो नीयाव</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 3:14" />तत्‌यार यहोवा भगवान गड़हा ने केदो, तु जे आहयु करलो से एतरे तु आखा घोर ना जानवरु, अने आखा जंगली जानवरु सी जादा सरापीत से, तु पेट ना भरहे चाल्‌या करही, अने हमेसा कादो चाटतो रेही: <verse eid="GEN 3:14" /><verse number="15" style="v" sid="GEN 3:15" />अने मे तारा अने आहयी बयर ना वचमे, अने तारी अवल्‌यात अने आनी अवल्‌यात ना वचमे झगड़ो पयदा करही; तीहयो तारा मुंडा ने कचरी देहे, अने तु तीना पोग नी पाटली ने डसही।<note caller="+" style="x"><char style="xo" closed="false">3:15 </char><char style="xt" closed="false"><ref loc="REV 12:17">परकासीतवाक्‌य 12:17</ref></char></note><verse eid="GEN 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 3:16" />अळी बयर ने भगवान केदो, “में तारी वेला अने तारा भारेपोगे हयवा ना दुख ने ढेरेत वदाड़ देही; तु मांदी हय्‌न सोरु पयदा करही; अने तारी मरजी तारा लाडा भणी हयहे, अने तीहयो तारी पोर हक करहे।”<verse eid="GEN 3:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 3:17" />अने आदम सी भगवान केदो, “तु जे आह़फा नी लाडी नी वात ह़मळ्‌यो, अने जे झाड़ ना फोळ ना बारा मे तमने मे हुकम आपलो हतो के तु तीने नी खाजे, तीने तु खादलो से एतरे धरती तारा कारण गरा वाळी से। तु तीनु अन जलम दुख ह़ाते खाया करही; <verse eid="GEN 3:17" /><verse number="18" style="v" sid="GEN 3:18" />अने तीहयी तारी जुगु काटा अने गोखरा काटा उगाड़हे, अने तु खेतर नु अन खाही; <verse eid="GEN 3:18" /><verse number="19" style="v" sid="GEN 3:19" />अने आपणा पसीना ना रोट्‌ला खाया करही, अने आखरी मे कादा मे भेसकाय जही काहाके तु तीनी मे गेथो पयदा हयलो से; तु कादो ते से अने कादा मे पासो भेसकाय जही।”<verse eid="GEN 3:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 3:20" />आदम आह़फा नी लाडी नु नाम हव्‌वा पाड़्‌यो; काहाके जेतरा माणेह जीवत्‌ला से तीहया आखा नी सुरु नी आह्‌य तीहयी हयी। <verse eid="GEN 3:20" /><verse number="21" style="v" sid="GEN 3:21" />अने यहोवा भगवान आदम अने तीनी लाडी नी लेदे चामड़ा ना लुगड़ा बणावीन तीमने पेराय देदो।<verse eid="GEN 3:21" /></para>
  <para style="s">आदम अने हव्‌वा ने बगीचा मे गेथु नीकाळणु</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 3:22" />अळी यहोवा भगवान केदो, “माणेह भला अने बुरा नो ग्‌यान हात करीन अमारी मे एक ने तेम बण जेलो से: एतरे हाव ईसम नी हये के तीहयो हात बड़ावीन जीवाय ना झाड़ नु फोळ बी तोड़ीन खाय लेय अने जलम जीवत्‌लो रेय।” <verse eid="GEN 3:22" /><verse number="23" style="v" sid="GEN 3:23" />एतरे यहोवा भगवान आदम ने अदन ना बगीचा मे गेथो नीकाळ देदो के तीहयो तीहयी जागा मे खेती करे, जीनी मे गेथो तीने बणावलो हतो। <verse eid="GEN 3:23" /><verse number="24" style="v" sid="GEN 3:24" />एतरे आदम ने भगवान नीकाळ देदो अने जीवाय ना झाड़ नी वाट नी रखवाळी करवा करीन अदन ना बगीचा नी उगवणी वखे करुबाम<note caller="+" style="f"><char style="fr" closed="false">3:24 </char><char style="fq" closed="false">करुबाम </char><char style="ft" closed="false">खास भाती नो ह़रगदुत, मतलब जीना पाखड़ा रेय</char></note> ने, अने च्‌यारो मेर फीरवा वाळी होळो-होळो धपत्‌ली तलवार ने टाळ्‌यो।<note caller="+" style="x"><char style="xo" closed="false">3:24 </char><char style="xt" closed="false"><ref loc="EZK 28:16">यहेजकेल 28:16</ref></char></note><verse eid="GEN 3:24" /></para>
  <chapter eid="GEN 3" />
  <chapter number="4" style="c" sid="GEN 4" />
  <para style="s">केन अने हाबील</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 4:1" />जत्‌यार आदम आह़फा नी लाडी हव्‌वा नी ह़ाते ज्‌यो ता तीहयी भारेपोगे हय्‌न केन ने पयदा करी अने केदी, “मे यहोवा नी मदत सी एक सोरु हात कर लेदी।” <verse eid="GEN 4:1" /><verse number="2" style="v" sid="GEN 4:2" />अळी तीहयी एक सोरा ने पयदा करी जीनु नाम हाबील हतु, हाबील ते गाडरा-बोकड़ा नो गुवाळ्‌यो बण ज्‌यो, पण केन धरती पोर खेती करवा वाळो कीरसाण बण ज्‌यो। <verse eid="GEN 4:2" /><verse number="3" style="v" sid="GEN 4:3" />थोड़ाक दाड़ान अळतेण केन यहोवा ने तां आह़फा ना खेतर नी थोड़ीक मेर भेट करवा करीन लायो। <verse eid="GEN 4:3" /><verse number="4" style="v" sid="GEN 4:4" />अने हाबील बी आह़फा ना गाडरा अने बोकड़ा ना पेला बच्‌चा ने भेट चड़ाव्‌वा करीन लीन आयो अने वारलो हीस्‌सो भेट चड़ायो; तत्‌यार यहोवा हाबील अने तीनी भेट ने ते आवरी लेदो,<note caller="+" style="x"><char style="xo" closed="false">4:4 </char><char style="xt" closed="false"><ref loc="EXO 34:19">नीरगमन 34:19</ref>; <ref loc="HEB 11:4">ईब्‌रानीयो 11:4</ref></char></note> <verse eid="GEN 4:4" /><verse number="5" style="v" sid="GEN 4:5" />पण केन अने तीनी भेट ने तीहयो नी अवर्‌यो। तत्‌यार केन घणो खीजवाय ज्‌यो, अने तीहयो ह़ोह़वाय ज्‌यो। <verse eid="GEN 4:5" /><verse number="6" style="v" sid="GEN 4:6" />तत्‌यार यहोवा केन सी केदो, “तु ह़ुका खीजवायो? अने ह़ुका ह़ोह़वाय र्‌यो।? <verse eid="GEN 4:6" /><verse number="7" style="v" sid="GEN 4:7" />कदी तु भलु करे, ता तारी भेट काहा नी आवरे? अने कदी तु भलु नी करे, ता तारा झापला पोर पाप उबो हय र्‌यो। तीहयो तारी हेर कर र्‌यो, अने तीनी पोर तने राज करवा से।”<verse eid="GEN 4:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 4:8" />तत्‌यार केन आह़फा ना भाय हाबील ने कंय केदो; अने जत्‌यार तीहया खेतर मे हता, ता केन आह़फा ना भाय हाबील ने जोर करीन अने मार नाख्‌यो।<note caller="+" style="x"><char style="xo" closed="false">4:8 </char><char style="xt" closed="false"><ref loc="MAT 23:35">मत्‌ती 23:35</ref>; <ref loc="JOL 3:12">योएल 3:12</ref>; <ref loc="REV 10:3">परकासीतवाक्‌य 10:3</ref></char></note><verse eid="GEN 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 4:9" />तत्‌यार यहोवा भगवान केन ने पुछ्‌यो, “तारो भाय हाबील कां से?” तीहयो केदो; “मने नी मालम; मे मारा भाय नो रखवाळ्‌यो से ह़ु?”<verse eid="GEN 4:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 4:10" />तत्‌यार यहोवा केदो, “तु ह़ु करलो से? तारा भाय नो लोय धरती मे सी मार भणी आड़ीन केवा बाज र्‌यो।<note caller="+" style="x"><char style="xo" closed="false">4:10 </char><char style="xt" closed="false"><ref loc="HEB 12:24">ईब्‌रानीयो 12:24</ref></char></note> <verse eid="GEN 4:10" /><verse number="11" style="v" sid="GEN 4:11" />एतरे हाव धरती जे तारा भाय नु लोय तारा हात सी पीवा करीन आह़फा नु मोडु खुल्‌लु से, तीनी भणी गेथु तु गरा वाळो से। <verse eid="GEN 4:11" /><verse number="12" style="v" sid="GEN 4:12" />कदी तु धरती पोर खेती करे, ते बी तीनी आखी मेर तने नी जड़े, अने तु धरती पोर भटकवा वाळो अने आये गेथो बीजे जागे जवा वाळो हयही।”<verse eid="GEN 4:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 4:13" />तत्‌यार केन यहोवा सी केदो, “मारी जुगु आहयो डंड घणो काठो से। <verse eid="GEN 4:13" /><verse number="14" style="v" sid="GEN 4:14" />देख, तु आज ना दाड़े मने जागा मे गेथो नीकाळ्‌ळो से अने मे तारी नींगा गेथो छेटो रेही अने धरती पोर भटकवा वाळा अने वण-घोर्‌यो रेही; अने जे कोय मने ह़ोदहे, तीहयो मने मार नाखहे।”<verse eid="GEN 4:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 4:15" />आनी लेदे यहोवा तीने केदो, “जे कोय केन ने मारहे तीनी सी ह़ात गुणा बदलो लेहे।” अने यहोवा केन जुगु एक सेलाणी ठेरायो ईसम नी हये के कोय तीने मार नाखे।<verse eid="GEN 4:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 4:16" />तत्‌यार यहोवा केन नी ह़ाते गेथो छेटो जत र्‌यो, अने नोद<note caller="+" style="f"><char style="fr" closed="false">4:16 </char><char style="fq" closed="false">नोद </char><char style="ft" closed="false">वण-घोर्‌यो</char></note> नाम ना देस मे, जे अदन नी उगवणी भणी से, रेवा बाज ज्‌यो।<verse eid="GEN 4:16" /></para>
  <para style="s">केन नो कुळी वेलो</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 4:17" />जत्‌यार केन आह़फा नी लाडी ह़ाते ज्‌यो ता तीहयी भारेपोगे हयी अने हनोक ने पयदा करी; अळी केन एक ह़ेर वहाड़्‌यो अने तीहया ह़ेर नु नाम आह़फा ना सोरा ना नाम पोर हनोक पाड़्‌यो। <verse eid="GEN 4:17" /><verse number="18" style="v" sid="GEN 4:18" />हनोक सी ईराद पयदा हयो अने ईराद सी महुयाएल पयदा हयो अने महुयाएल सी मतुसाएल, अने मतुसाएल सी लेमेक पयदा हयो। <verse eid="GEN 4:18" /><verse number="19" style="v" sid="GEN 4:19" />लेमेक नी बे लाडी हती, एक नु नाम आदा अने बीजी नु नाम सील्‌ला हतु। <verse eid="GEN 4:19" /><verse number="20" style="v" sid="GEN 4:20" />आदा याबाल ने पयदा करी। तीहयो ते माणहु नु बाह हतो जे तम्‌बु मे रेता हता अने जानवरु ने पाळता हता अने आह़फु जीवाय चलाड़ता हता। <verse eid="GEN 4:20" /><verse number="21" style="v" sid="GEN 4:21" />तीना भाय नु नाम युबाल हतु: तीहयो ते माणहु नो बाह हतो जे तम्‌बुरो अने पाहळी वगाड़ता हता। <verse eid="GEN 4:21" /><verse number="22" style="v" sid="GEN 4:22" />अने सील्‌ला बी तुबल-केन नाम ना एक सोरा ने पयदा करी: तीहयो पीतळ अने लुहड़ा ना आखा धार वाळा हत्‌यार बणाव्‌वा वाळो हतो। अने तुबल-केन नी बेनेह नामा हती।<verse eid="GEN 4:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 4:23" />लेमेक आह़फा नी लाडी सी केदो, “ए आदा अने ए सील्‌ला मारी ह़मळो; मारी वात पोर कांटा लगाड़ो: मे एक माणेह ने जे मने देतो हतो, तीने मे मार नाखलो से। <verse eid="GEN 4:23" /><verse number="24" style="v" sid="GEN 4:24" />जत्‌यार केन नो बदलो ह़ात गुणा लेहे। ता लेमेक नो बदलो सतोत्‌तर गुणा लेहे।”<note caller="+" style="x"><char style="xo" closed="false">4:24 </char><char style="xt" closed="false"><ref loc="MAT 18:22">मत्‌ती 18:22</ref></char></note><verse eid="GEN 4:24" /></para>
  <para style="s">सेत अने एनोस</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 4:25" />आदम आह़फी लाडीन्‌तां अळी ज्‌यो; अने तीहयी एक अळी सोरा ने पयदा करी अने तीनु नाम आहयु कीन सेत पाड़ी के “भगवान मारी जुगु हाबील ना बदले, जीने केन मार नाखलो हतो, एक अळी सोरो आप्‌यो।” <verse eid="GEN 4:25" /><verse number="26" style="v" sid="GEN 4:26" />अने सेत नु बी एक सोरु पयदा हयु अने तीहयी तीनु नाम एनोस पाड़ी। तीहयीत टेमे सी माणहु यहोवा नी भक्‌ती करवा बाज ज्‌या।<verse eid="GEN 4:26" /></para>
  <chapter eid="GEN 4" />
  <chapter number="5" style="c" sid="GEN 5" />
  <para style="s">आदम नो कुळी वेलो</para>
  <para style="r">(<ref loc="1CH 1:1-4">1 ईतीहास 1:1-4</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 5:1" />आदम नी पीड़ी आहयी से। जत्‌यार भगवान माणेह ने बणायो तत्‌यार आह़फा ना रुप मे तीने बणायो।<note caller="+" style="x"><char style="xo" closed="false">5:1 </char><char style="xt" closed="false"><ref loc="GEN 1:27">उबजणाय कीताप 1:27</ref></char></note> <verse eid="GEN 5:1" /><verse number="2" style="v" sid="GEN 5:2" />तीहयो अदमी अने बयर करीन माणेह ने बणायो अने तीमने संयबरकत आप्‌यो, अने तीमने बणाव्‌वा ना दाड़े तीमनु नाम आदम पाड़्‌यो।<note caller="+" style="x"><char style="xo" closed="false">5:2 </char><char style="xt" closed="false"><ref loc="GEN 1:27-28">उबजणाय कीताप 1:27-28</ref></char></note> <verse eid="GEN 5:2" /><verse number="3" style="v" sid="GEN 5:3" />जत्‌यार आदम एक ह़ोव तीस साल नो हयो, तत्‌यार तीनी लारे तीनीन तेम तीना सीका मे तीनी लारे एक सोरो पयदा हयो। तीहयो तीनु नाम सेत पाड़्‌यो। <verse eid="GEN 5:3" /><verse number="4" style="v" sid="GEN 5:4" />अने सेत ने पयदा हयवान बाद आदम आंठ ह़ोव साल जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा-सोरी पयदा हया। <verse eid="GEN 5:4" /><verse number="5" style="v" sid="GEN 5:5" />आहयी रीते आदम ना आखा साल नव ह़ोव तीस साल हया, अळतेण तीहयो मर ज्‌यो।<verse eid="GEN 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 5:6" />जत्‌यार सेत एक ह़ो पांच साल नो हयो, तत्‌यार तीनी सी एनोस पयदा हयो। <verse eid="GEN 5:6" /><verse number="7" style="v" sid="GEN 5:7" />एनोस ना पयदा हयवान बाद सेत आंठ ह़ोव ह़ात साल जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा-सोरी पयदा हया। <verse eid="GEN 5:7" /><verse number="8" style="v" sid="GEN 5:8" />आसम करीन सेत ना आखा मेळीन नव ह़ोव बारे साल हया, अळतेण तीहयो मर ज्‌यो।<verse eid="GEN 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 5:9" />जत्‌यार एनोस नब्‌बे साल नो हयो, तत्‌यार तीनी सी केनान पयदा हयो। <verse eid="GEN 5:9" /><verse number="10" style="v" sid="GEN 5:10" />केनान ना पयदा हयवान बाद एनोस आंठ ह़ोव पंदरे साल जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा-सोरी पयदा हया। <verse eid="GEN 5:10" /><verse number="11" style="v" sid="GEN 5:11" />आहयी रीते एनोस ना आखा मेळीन नव ह़ोव पांच साल हया; अळतेण तीहयो मर ज्‌यो।<verse eid="GEN 5:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 5:12" />जत्‌यार केनान सत्‌तर साल नो हयो, तत्‌यार तीनी सी महलेल पयदा हयो। <verse eid="GEN 5:12" /><verse number="13" style="v" sid="GEN 5:13" />महलेल ने पयदा हयवान बाद केनान आंठ ह़ोव चाळीह साल जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा-सोरी पयदा हया। <verse eid="GEN 5:13" /><verse number="14" style="v" sid="GEN 5:14" />आहयी रीते केनान नी आखी मेळीन उमर नव ह़ोव दह साल नी हयी; अळतेण तीहयो मर ज्‌यो।<verse eid="GEN 5:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 5:15" />जत्‌यार महलेल पंयसट साल नो हयो, तत्‌यार तीनी सी येरेद पयदा हयो। <verse eid="GEN 5:15" /><verse number="16" style="v" sid="GEN 5:16" />येरेद ने पयदा हयवान बाद महलेल आंठ ह़ोव तीस साल जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा-सोरी पयदा हया। <verse eid="GEN 5:16" /><verse number="17" style="v" sid="GEN 5:17" />आहयी रीते महलेल नी उमर आखी मेळीन आंठ ह़ोव पींच्‌यानु साल नी हयी; अळतेण तीहयो मर ज्‌यो।<verse eid="GEN 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 5:18" />जत्‌यार येरेद एक ह़ोव बासठ साल नो हयो, जत्‌यार तीहयो हनोक ने पयदा कर्‌यो। <verse eid="GEN 5:18" /><verse number="19" style="v" sid="GEN 5:19" />हनोक ने पयदा हयवान बाद येरेद आंठ ह़ोव साल जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा-सोरी पयदा हया। <verse eid="GEN 5:19" /><verse number="20" style="v" sid="GEN 5:20" />आहयी रीते येरेद नी आखा मेळीन नव ह़ोव बासठ साल जीवत्‌लो र्‌यो; अळतेण तीहयो मर ज्‌यो।<verse eid="GEN 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 5:21" />जत्‌यार हनोक पंयसट साल नो हयो, तत्‌यार तीनी सी मतुसेलह पयदा हयो। <verse eid="GEN 5:21" /><verse number="22" style="v" sid="GEN 5:22" />मतुसेलह ना पयदा हयवान बाद हनोक तीन ह़ोव साल तक भगवान ह़ाते–ह़ाते चालतो र्‌यो, अने तीना अळी बी सोरा-सोरी पयदा हया। <verse eid="GEN 5:22" /><verse number="23" style="v" sid="GEN 5:23" />आहयी रीते हनोक आखा मेळीन तीन ह़ोव पंयसट साल जीवत्‌लो र्‌यो। <verse eid="GEN 5:23" /><verse number="24" style="v" sid="GEN 5:24" />हनोक भगवान नी ह़ाते-ह़ाते चालतो हतो; अळतेण तीहयो गायप हय ज्‌यो काहाके भगवान तीने उपर हाकली लेदो।<note caller="+" style="x"><char style="xo" closed="false">5:24 </char><char style="xt" closed="false"><ref loc="HEB 11:5">ईब्‌रानीयो 11:5</ref>; <ref loc="JHN 14">युहन्‌ना 14</ref>; <ref loc="REV 4:10">परकासीतवाक्‌य 4:10</ref>; <ref loc="2KI 2:11">2 राजा 2:11</ref></char></note><verse eid="GEN 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 5:25" />जत्‌यार मतुसेलह एक ह़ोव सत्‌यासी साल नो हयो, तत्‌यार तीनी सी लेमेक पयदा हयो। <verse eid="GEN 5:25" /><verse number="26" style="v" sid="GEN 5:26" />लेमेक ने पयदा हयवान अळतेण मतुसेलह ह़ात ह़ोव बय्‌यासी साल जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा-सोरी पयदा हया। <verse eid="GEN 5:26" /><verse number="27" style="v" sid="GEN 5:27" />आहयी रीते मतुसेलह नी आखी जीवाय नव ह़ोव उन्‌सत्‌तर साल नी हयी; अळतेण तीहयो मर ज्‌यो।<verse eid="GEN 5:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 5:28" />जत्‌यार लेमेक एक ह़ोव बय्‌यासी साल नो हयो, तत्‌यार तीनी सी एक सोरु पयदा हयु। <verse eid="GEN 5:28" /><verse number="29" style="v" sid="GEN 5:29" />लेमेक आहयु कीन तीनु नाम नुह<note caller="+" style="f"><char style="fr" closed="false">5:29 </char><char style="fq" closed="false">नुह </char><char style="ft" closed="false">नुहा नु मतलब अराम आपवा वाळो केदलु से। </char></note> पाड़्‌यो, के “यहोवा जे धरती ने सराप आपलो से, तीना बारा मे आहयु सोरु अमारु काम करहे, अने तीहयी काठी मेहनत मे जे आमु कर्‌या, आमने सांती आपे।” <verse eid="GEN 5:29" /><verse number="30" style="v" sid="GEN 5:30" />नुह ना पयदा हयवान बाद लेमेक पांच ह़ोव पींच्‌यानु साल जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा-सोरी पयदा हया। <verse eid="GEN 5:30" /><verse number="31" style="v" sid="GEN 5:31" />आहयी रीते लेमेक नी आखी जीवाय ह़ात ह़ोव सतोत्‌तर साल नी हयी; अळतेण तीहयो मर ज्‌यो।<verse eid="GEN 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 5:32" />अने नुह पांच ह़ोव साल नो हयो; अने नुह सी सेम, हाम अने येपेत पयदा हया।<verse eid="GEN 5:32" /></para>
  <chapter eid="GEN 5" />
  <chapter number="6" style="c" sid="GEN 6" />
  <para style="s">माणहु जाती ना भुंडला काम</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 6:1" />अळी जत्‌यार माणहु धरती नी उपर घणा वदवा बाज ज्‌या, अने तीना बी सोर्‌या पयदा हया। <verse eid="GEN 6:1" /><verse number="2" style="v" sid="GEN 6:2" />तत्‌यार भगवान ना सोरा माणहु ना सोर्‌याम ने देख्‌या, के तीहया घटाळा से, अने तीहया जीने-जीने गम्‌या तीने-तीने वेवा कर लेदा। <verse eid="GEN 6:2" /><verse number="3" style="v" sid="GEN 6:3" />तत्‌यार यहोवा केदो, “मारी आत्‌मा माणहु मे हमेसा नी रेय, काहाके माणेह बी डीलत से; तीनी आखी जीवाय एक ह़ोव वीह साल नी हयी।” <verse eid="GEN 6:3" /><verse number="4" style="v" sid="GEN 6:4" /><note caller="+" style="x"><char style="xo" closed="false">6:4 </char><char style="xt" closed="false"><ref loc="NUM 13:33">गीनती 13:33</ref></char></note>तीहया दाड़ा मे धरती पोर राकस<note caller="+" style="f"><char style="fr" closed="false">6:4 </char><char style="fq" closed="false">राकस </char><char style="ft" closed="false">नपेली माणहु</char></note> रेता हता; अने आनीन अळतेण जत्‌यार भगवान ना सोरा माणहु नी सोर्‌याम नी ह़ाते ज्‌या तत्‌यार तीमनी लारे जे सोरा पयदा हया, तीहया सोरा ताखत वाळा हयता हता, जे वेगला वारा सीत नामह़ाद्‌या अने आखी दुर तीमनु नाम हयतु हतु।<verse eid="GEN 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 6:5" />यहोवा भगवान देख्‌यो के माणहु नी बुराय धरती पोर बड़ जेली से, अने तीमना मन ना वीच्‌यार मे जे कंय पयदा हये तीहयु हमेसा बुरु हये।<note caller="+" style="x"><char style="xo" closed="false">6:5 </char><char style="xt" closed="false"><ref loc="MAT 24:37">मत्‌ती 24:37</ref>; <ref loc="LUK 17:26">लुका 17:26</ref>; <ref loc="1PE 3:20">1 पतरस 3:20</ref></char></note> <verse eid="GEN 6:5" /><verse number="6" style="v" sid="GEN 6:6" />अने यहोवा धरती पोर माणेह ने बणाव्‌वा सी पसतायो, अने तीहयो मन मे घणो दुखी हयो। <verse eid="GEN 6:6" /><verse number="7" style="v" sid="GEN 6:7" />तत्‌यार यहोवा केदो, “मे माणेह ने जीने मे बणायो धरती पोर सी खत्‌तम कर देही; ह़ु माणहे, ह़ु जानवरु, ह़ु घीहाय्‌न चालन्‌या जीव-जन्‌तु, ह़ु ह़रग मे ना चड़ा, आखाम ने खुटाड़ देही, काहाके मे हीमने बणाव्‌वा सी पछताय र्‌यो।” <verse eid="GEN 6:7" /><verse number="8" style="v" sid="GEN 6:8" />पण यहोवा नी दया नी नींगा नुह पोर बणीन री।<verse eid="GEN 6:8" /></para>
  <para style="s">नुह</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 6:9" />नुह नो कुळी वेलो आहयो से। नुह धरमी माणेह अने आपणी टेम ना माणहु मे खरलो हतो; अने नुह भगवान नी ह़ाते-ह़ाते चालतो हतो। <verse eid="GEN 6:9" /><verse number="10" style="v" sid="GEN 6:10" />अने नुह सी सेम, अने हाम, अने येपेत नाम ना, तीन सोरा पयदा हया। <verse eid="GEN 6:10" /><verse number="11" style="v" sid="GEN 6:11" />तीहयी टेमे धरती भगवान नी नींगा मे बगड़ी जेली हती, अने बुराय सी भराय जेली हती। <verse eid="GEN 6:11" /><verse number="12" style="v" sid="GEN 6:12" />अने भगवान धरती भणी नींगा नाख्‌यो ता ह़ु देख्‌या के तीहयी बगड़ी जेली से; काहाके आखा जीव धरती पोर आह़फा-आह़फाम नी चाल-चलण ने बगाड़ लेदला हता।<verse eid="GEN 6:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 6:13" />तत्‌यार भगवान नुह ने केदो, “आखा जीव ने मारवा नो सवाल मारी अगळ आय जेलो से; काहाके हीमना कारण सी धरती बुराय सी भराय जी, करीन मे हीमने धरती भेळ खत्‌तम कर देही। <verse eid="GEN 6:13" /><verse number="14" style="v" sid="GEN 6:14" />करीन तु गोपेर झाड़ नी लाकड़ी नु एक ढुंड्‌यु बणाय ले, तीनी मे कोपरा बणावजे, अने मोय अने बारो डमर्‌यु लगाड़जे। <verse eid="GEN 6:14" /><verse number="15" style="v" sid="GEN 6:15" />आहयी रीते तु तीने बणावजे: ढुंड्‌यु नी लम्‌बाय तीन ह़ोव हात, चवड़ाय पचाह हात, अने उचाय तीस हात नी हय। <verse eid="GEN 6:15" /><verse number="16" style="v" sid="GEN 6:16" />ढुंड्‌यु मे एक खीड़की बणावजे, अने तीनी एक हात उपर सी आनी छत बणावजे, अने ढुंड्‌यु नी एक धेड़े एक झापलु राखजे; अने ढुंड्‌यु मे पेलो, बीजो, तीसरो भाग बणावजे। <verse eid="GEN 6:16" /><verse number="17" style="v" sid="GEN 6:17" />अने ह़मळ, मे आह़फो धरती पोर मुसळ-धार्‌यो पाणी आखा जीव ने, जीमनी मे जीवाय नी ह़ाह़ से, ह़रग नी हेटु गेथो खत्‌तम करवा वाळो से; अने आखा जे धरती पोर से मर जहे। <verse eid="GEN 6:17" /><verse number="18" style="v" sid="GEN 6:18" />पण मे तारी ह़ाते वायदो करु, करीन तु आह़फा सोरा, सोरी अने ववेह भेळ ढुंड्‌यु मे भराय जजो। <verse eid="GEN 6:18" /><verse number="19" style="v" sid="GEN 6:19" />अने आखा जीवत्‌ला माणहु मे सी, तु एक-एक जाती ना बे-बे मतलब एक-एक नर अने एक नारी ढुंड्‌यु मे ली जाय्‌न आपणी ह़ाते जीवत्‌लो राखजे <verse eid="GEN 6:19" /><verse number="20" style="v" sid="GEN 6:20" />एक-एक जाती ना चड़ा, अने एक-एक जाती ना जानवरु, अने एक-एक जाती ना धरती पोर घीहाय्‌न चालन्‌या जीव-जन्‌तु, अने आखा मे गेथा बे-बे तारीन्‌तां आवहे, के तु तीमने जीवत्‌ला राखे। <verse eid="GEN 6:20" /><verse number="21" style="v" sid="GEN 6:21" />अने भाती-भातीन खावा नु खाणु जे खाय, तीने तु लीन तारीन्‌तां एक्‌ठु करीन राखजे; जे तारी जुगु अने तीमनी जुगु खावा नु रेहे।” <verse eid="GEN 6:21" /><verse number="22" style="v" sid="GEN 6:22" />भगवान ना आहया हुकम ना लारे नुह कर्‌यो।<note caller="+" style="x"><char style="xo" closed="false">6:22 </char><char style="xt" closed="false"><ref loc="HEB 11:7">ईब्‌रानीयो 11:7</ref></char></note><verse eid="GEN 6:22" /></para>
  <chapter eid="GEN 6" />
  <chapter number="7" style="c" sid="GEN 7" />
  <para style="s">मुसळ-धार्‌यो पाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 7:1" />तत्‌यार यहोवा नुह सी केदो, “तु आह़फा ना आखा घोराणा भेळ मोट्‌लु ढुन्‌ड्‌ये मे जा; काहाके मे आहयी टेम ना माणहे मे मारी नींगा मे तु एतरोत खरलो जड़्‌यो। <verse eid="GEN 7:1" /><verse number="2" style="v" sid="GEN 7:2" />आखी जाती मे चोखला जानवरु मे सी तु ह़ात-ह़ात जोड़ा, मतलब नर अने नारी लेजे: पण जे जानवरु चोखला नी हय, तीमनी मे गेथा बे-बे जानवरु लेजे, मतलब नर अने नारी;<note caller="+" style="x"><char style="xo" closed="false">7:2 </char><char style="xt" closed="false"><ref loc="LEV 11">लेव्‌यवेवस्‌था 11</ref></char></note> <verse eid="GEN 7:2" /><verse number="3" style="v" sid="GEN 7:3" />अने ह़रग मे ना चड़ा मे सी बी ह़ात-ह़ात जोड़ा, मतलब नर अने नारी लेजे, के तीमनी अवल्‌यात सी आखी धरती भराय जाय। <verse eid="GEN 7:3" /><verse number="4" style="v" sid="GEN 7:4" />काहाके हाव ह़ात दाड़ा अळी हयवा पोर मे धरती पोर चाळीह दाड़ा अने चाळीह रात तक मे पाणी पाड़तो रेही; अने जेतरा माणेह मे बणावलो से तीहया आखाम ने धरती पोर गेथा खत्‌तम कर देही।” <verse eid="GEN 7:4" /><verse number="5" style="v" sid="GEN 7:5" />यहोवा ना आहया हुकम नी लारे नुह कर्‌यो।<verse eid="GEN 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 7:6" />नुह नी उमर छोव ह़ोव साल नी हती, जत्‌यार धरती पोर मुसळ-धार्‌यो पाणी धरती पोर पड़्‌यो। <verse eid="GEN 7:6" /><verse number="7" style="v" sid="GEN 7:7" />नुह आह़फा ना सोरा, लाडी अने ववेह भेळ, मुसळ-धार्‌यो पाणी सी बचवा करीन ढुंड्‌या मे ज्‌या।<note caller="+" style="x"><char style="xo" closed="false">7:7 </char><char style="xt" closed="false"><ref loc="MAT 24:38">मत्‌ती 24:38</ref>,<ref loc="MAT 24:39">39</ref>; <ref loc="LUK 17:27">लुका 17:27</ref></char></note> <verse eid="GEN 7:7" /><verse number="8" style="v" sid="GEN 7:8" />चोखला अने वण-चोखला बेम भातीन जानवरु मे सी, चड़ा, <verse eid="GEN 7:8" /><verse number="9" style="v" sid="GEN 7:9" />अने धरती पोर पेट ना भरहे चालवा वाळा मे सी बी, बे-बे, मतलब नर अने नारी, ढुंड्‌या मे नुहन्‌तां ज्‌या, जीने रीते भगवान नुह ने हुकम आपलो हतो। <verse eid="GEN 7:9" /><verse number="10" style="v" sid="GEN 7:10" />ह़ात दाड़ा नी अळतेण मुसळ-धार्‌यो पाणी धरती पोर आव्‌वा बाज ज्‌यो।<verse eid="GEN 7:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 7:11" />जत्‌यार नुह नी उमर ना छोव ह़ोव साल ना बीजा मयना ना ह़त्‌रे दाड़ा मे; तीहया दाड़े उंडला दर्‌या ना आखा झोर वय नकळ्‌या अने ह़रग नु वादळु उगड़ी ज्‌यु।<note caller="+" style="x"><char style="xo" closed="false">7:11 </char><char style="xt" closed="false"><ref loc="2PE 3:6">2 पतरस 3:6</ref></char></note> <verse eid="GEN 7:11" /><verse number="12" style="v" sid="GEN 7:12" />अने पाणी चाळीह दाड़ा अने चाळीह रात लगातार धरती पोर पड़तो र्‌यो। <verse eid="GEN 7:12" /><verse number="13" style="v" sid="GEN 7:13" />ठेरावला तीहया दाड़े नुह आह़फा सोरा, सेम, हाम, येपेत, अने आह़फा नी लाडी अने तीन ववेह भेळ, <verse eid="GEN 7:13" /><verse number="14" style="v" sid="GEN 7:14" />अने तीमनी भेळ एक-एक जाती ना आखा जंगली जानवरु, अने एक-एक जाती ना आखा पाळला जानवरु, अने एक-एक जाती ना आखा धरती पोर घीहाय्‌न चालन्‌या जीव-जन्‌तु, अने एक-एक जाती ना आखा उडवा वाळा चड़ा, मोट्‌लु ढुन्‌ड्यु मे ज्‌या। <verse eid="GEN 7:14" /><verse number="15" style="v" sid="GEN 7:15" />जेतरा जानवरु मे जीवाय नु जीव हतु तीमनी आखी जाती मे सी बे-बे नुह नी तां ढुंड्‌या मे ज्‌या। <verse eid="GEN 7:15" /><verse number="16" style="v" sid="GEN 7:16" />अने जे ज्‌या, तीहया भगवान ना हुकम नी लारे आखा जाती ना जानवरु मे सी नर अने नारी ज्‌या। तत्‌यार यहोवा भगवान मोट्‌लु ढुन्‌ड्यु नु झापलु दी देदो।<verse eid="GEN 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 7:17" />धरती पोर चाळीह दाड़ा तक मुसळ-धार्‌यो पाणी पड़तो र्‌यो; अने पाणी घणु बड़तु र्‌यु, जीनी सी ढुंड्‌यु उपर उचलायवा बाज ज्‌यु, अने तीहयु धरती पोर गेथु उचु उचलाय ज्‌यु। <verse eid="GEN 7:17" /><verse number="18" style="v" sid="GEN 7:18" />पाणी बड़तु-बड़तु धरती पोर घणुत बड़ ज्‌यु, अने ढुंड्‌यु पाणी ना उपर-उपर झेपतु र्‌यु। <verse eid="GEN 7:18" /><verse number="19" style="v" sid="GEN 7:19" />पाणी धरती पोर घणु बड़ ज्‌यु, आञे तक के आखी धरती पोर जेतरा मोटा-मोटा बड़ा हता, तीहया आखा डुब ज्‌या। <verse eid="GEN 7:19" /><verse number="20" style="v" sid="GEN 7:20" />पाणी ते पन्‌द्‌रे हात उपर बड़ ज्‌यु, अने बड़ा बी डुब ज्‌या। <verse eid="GEN 7:20" /><verse number="21" style="v" sid="GEN 7:21" />अने ह़ु चड़ा, ह़ु पाळला जानवरु, ह़ु जंगली जानवरु, अने धरती पोर चालवा वाळा जानवरु, अने जेतरा जीव धरती पोर भराय जेला हता, तीहया आखा माणेह मर ज्‌या। <verse eid="GEN 7:21" /><verse number="22" style="v" sid="GEN 7:22" />जे-जे धरती पोर हता तीमनी मे सी जेतराम ना नखरा मे जीवाय नी ह़ाह़ हती, आखा मर ज्‌या। <verse eid="GEN 7:22" /><verse number="23" style="v" sid="GEN 7:23" />अने ह़ु माणेह, ह़ु जानवरु, घीहाय्‌न चालन्‌या जीव-जन्‌तु, ह़ु ह़रग ना चड़ा, जे-जे धरती पोर हता, आखा धरती पोर गेथा खत्‌तम हय ज्‌या; नुह एतरोत, अने जेतरा तीनी भेळ ढुंड्‌या मे हता, तीहयात बच ज्‌या। <verse eid="GEN 7:23" /><verse number="24" style="v" sid="GEN 7:24" />अने पाणी धरती पोर एक ह़ोव पचाह दाड़ा तक बणीन र्‌यो।<verse eid="GEN 7:24" /></para>
  <chapter eid="GEN 7" />
  <chapter number="8" style="c" sid="GEN 8" />
  <para style="s">मुसळ-धार्‌यो पाणी खत्‌तम हये</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 8:1" />भगवान नुह अने जेतरा जंगली जानवरु अने पाळला जानवरु तीनी भेळ मोट्‌लु ढुन्‌ड्‌यु मे हता, तीमनी आखा नी खबर लेदो: अने भगवान धरती पोर वाहळु बड़ायो, अने पाणी कम हयवा बाज ज्‌यु। <verse eid="GEN 8:1" /><verse number="2" style="v" sid="GEN 8:2" />उंडला दर्‌या नो झोर अने ह़रग नु वादळु बंद हय ज्‌यु; अने तीनी सी जे पाणी पड़तु हतु तीहयु बी बंद हय ज्‌यु। <verse eid="GEN 8:2" /><verse number="3" style="v" sid="GEN 8:3" />अने एक ह़ोव पचाह दाड़ा नी अळतेण पाणी धरती पोर सी लगातार कम हयतु ज्‌यु। <verse eid="GEN 8:3" /><verse number="4" style="v" sid="GEN 8:4" />ह़ातवा मयना ना ह़तरे दाड़ा मे, मोट्‌लु ढुन्‌ड्यु अरारात नाम ना बड़ा पोर टेक ज्‌यु। <verse eid="GEN 8:4" /><verse number="5" style="v" sid="GEN 8:5" />अने पाणी दसवा मयने तक घटतु जत र्‌यु, अने दहवा मयना ना पेला दाड़े, बड़ा नी चोटली देखाव पड़ी।<verse eid="GEN 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 8:6" />अळी आसम हयु के चाळीह दाड़ा नी अळतेण नुह आह़फा बणावला मोट्‌लु ढुन्‌ड्यु नी खीड़की खोलीन, <verse eid="GEN 8:6" /><verse number="7" style="v" sid="GEN 8:7" />एक ढान्‌ड्‌यो उडाड़ देदो: जत्‌यार तक पाणी धरती पोर सी सुख नी ज्‌यु, तां तक ढांड्‌या जींखर-तींखर फीरतु र्‌यु। <verse eid="GEN 8:7" /><verse number="8" style="v" sid="GEN 8:8" />अळी तीहयु आह़फी पां गेथु एक पारवी ने बी उडाड़ देदो के देखे के पाणी धरती पोर गेथु कम हयु के नी। <verse eid="GEN 8:8" /><verse number="9" style="v" sid="GEN 8:9" />तीहयी पारवी ने आह़फा पोगु टेकवा जुगु कोय जागो नी जड़्‌यो, ता तीहयी तीनी पां मोट्‌लु ढुंड्‌यु मे पासी आवती री: काहाके आखी धरती नी उपर पाणीत-पाणी फीरलु हतु तत्‌यार तीहयो हात बड़ावीन तीने आह़फान्‌तां ढुंड्‌या मे ली लेदो। <verse eid="GEN 8:9" /><verse number="10" style="v" sid="GEN 8:10" />तत्‌यार अळी ह़ात दाड़ा तक वाट जोवीन, तीहयो तीहयी पारवी ने मोट्‌लु ढुंड्‌यु मे सी अळी उडाड़ देदो। <verse eid="GEN 8:10" /><verse number="11" style="v" sid="GEN 8:11" />अने पारवी ह़ांती टेमे तीनी पांह आवती री, ता ह़ु देख्‌यो के तीना चोण मे जेतुन झाड़ नु एक नवलु पान्‌टु से; आनी सी नुह जाण लेदो, के पाणी धरती पोर कम हय जेलु से। <verse eid="GEN 8:11" /><verse number="12" style="v" sid="GEN 8:12" />अळी तीहयो ह़ात दाड़ा अळी वाट जोवीन तीहयी पारवी ने उडाड़ देदो; अने तीहयी तीनी पांह कदी पाछी नी आवी।<verse eid="GEN 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 8:13" />नुह नी उमर ना छोव ह़ोव साल ना पेले दाड़े पाणी धरती पोर सी सुख ज्‌यु। तत्‌यार नुह मोट्‌लु ढुन्‌ड्यु नी छत उगाड़ीन ह़ु देख्‌यो के धरती सुख जेली से। <verse eid="GEN 8:13" /><verse number="14" style="v" sid="GEN 8:14" />अने बीजा मयना ना सत्‌तावीसवा दाड़े धरती आखी रीते सुख जी।<verse eid="GEN 8:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 8:15" />तत्‌यार भगवान नुह सी केदो, <verse eid="GEN 8:15" /><verse number="16" style="v" sid="GEN 8:16" />“तु आह़फा सोरा, लाडी अने ववेह भेळ मोट्‌लु ढुन्‌ड्यु मे गेथो नकळीन आव। <verse eid="GEN 8:16" /><verse number="17" style="v" sid="GEN 8:17" />ह़ु चड़ा, ह़ु जानवरु, ह़ु आखी भाती ना पेट ना भरहे चालवा वाळा जीव जे धरती पोर आड़े; जेतरा डील वाळा जीव-जन्‌तु तारी ह़ाते से, तीहया आखाम ने आह़फी ह़ाते नीकाळीन लीन आव के धरती पोर तीमनी सी घणा सोरा पयदा हये; अने तीहया फुले-फाले, अने धरती पोर फीर जाय।” <verse eid="GEN 8:17" /><verse number="18" style="v" sid="GEN 8:18" />तत्‌यार नुह अने तीना सोरा अने लाडी अने ववेह, नकळी आया। <verse eid="GEN 8:18" /><verse number="19" style="v" sid="GEN 8:19" />अने आखा च्‌यारपोग्‌या, घीहाय्‌न चालन्‌या जीव-जन्‌तु, अने चड़ा, अने जेतरा जीव-जन्‌तु धरती पोर चालत्‌ला-फीरत्‌ला से, आखा भाती-भाती ना मोट्‌लु ढुन्‌ड्‌यु मे गेथा नीकळी आया।<verse eid="GEN 8:19" /></para>
  <para style="s">नुह नी लारे होम बादा चड़ाव्‌वा</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 8:20" />तत्‌यार नुह यहोवा जुगु एक वेदी बणायो, अने आखा चोखला जानवरु, अने आखा चोखला चड़ा मे गेथा, कंय-कंय लीन वेदी पोर होम बादा चड़ाया। <verse eid="GEN 8:20" /><verse number="21" style="v" sid="GEN 8:21" />आनी पोर यहोवा वारु गंदायण्‌यो गंद हात करीन सोच्‌यो, “माणहे नी कारण मे कदी बी धरती ने सराप नी आलु, कदी माणेह ना मन मे पयदावारी सी कंय पयदा हये तीहयु बुरुत हये; ते बी जीसम मे आखा जीव ने मारलो से, तेमेत तीमने अळी नी मारु। <verse eid="GEN 8:21" /><verse number="22" style="v" sid="GEN 8:22" />हाव गेथी जत्‌यार तक धरती बणीन रेहे, तत्‌यार तक वेरवा अने वाडवा नी टेम, टाड अने तपवा, उनाळो अने ह़ीयाळो, दाड़ो अने रात, हमेसा हयता रेहे।”<verse eid="GEN 8:22" /></para>
  <chapter eid="GEN 8" />
  <chapter number="9" style="c" sid="GEN 9" />
  <para style="s">भगवान नी ह़ाते नुह नो वायदो करनु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 9:1" />अळतेण भगवान नुह ने अने तीना सोरा ने बरकत आप्‌यो अने तीमने केदो, “फुलो-फालो अने वदो अने धरती मे भराय जावो।<note caller="+" style="x"><char style="xo" closed="false">9:1 </char><char style="xt" closed="false"><ref loc="GEN 1:28">उबजणाय कीताप 1:28</ref></char></note> <verse eid="GEN 9:1" /><verse number="2" style="v" sid="GEN 9:2" />तमारी बीक अने सक्‌ती धरती ना आखा जानवरु, अने ह़रग ना आखा चड़ा, अने धरती पोर ना आखा पेट ना भरहे चालवा वाळा जीव, अने दर्‌या ना आखा माछला पोर बणीन रेहे तीहया आखा तारा हक मे कर देम। <verse eid="GEN 9:2" /><verse number="3" style="v" sid="GEN 9:3" />आखा चालवा वाळा जीव तमारु खाणु हयहे; जीसम तमने लील्‌ला-लील्‌ला नाना झाड़ आपला हता, तेमेत तमुने आखु कंय आपु। <verse eid="GEN 9:3" /><verse number="4" style="v" sid="GEN 9:4" />पण मांह ने जीव भेळ मतलब लोय भेळ नी खाजो।<note caller="+" style="x"><char style="xo" closed="false">9:4 </char><char style="xt" closed="false"><ref loc="LEV 19:26">लेव्‌यवेवस्‌था 19:26</ref>; <ref loc="DEU 12:16">वेवस्‌थावीवरन 12:16</ref>,<ref loc="DEU 12:23">23</ref>; <ref loc="DEU 15:23">15:23</ref>; <ref loc="GEN 17:10">उबजणाय कीताप 17:10</ref>,<ref loc="GEN 17:14">14</ref></char></note> <verse eid="GEN 9:4" /><verse number="5" style="v" sid="GEN 9:5" />अने पक्‌को मे तमारा लोय नो मतलब जीव नो बदलो लेही: आखा जानवरु, अने माणहु, बेम सी मे लेही; माणेह ना जीव नो बदलो मे एक-एक माणहु सी लेही। <verse eid="GEN 9:5" /><verse number="6" style="v" sid="GEN 9:6" />जे कोय माणेह नु लोय वयाड़हे तीनु लोय माणेह सी वयाड़हे काहाके भगवान माणेह ने आह़फा सीका नी लारे बणावलो से।<note caller="+" style="x"><char style="xo" closed="false">9:6 </char><char style="xt" closed="false"><ref loc="GEN 1:26">उबजणाय कीताप 1:26</ref>; <ref loc="EXO 20:3">नीरगमन 20:3</ref></char></note><verse eid="GEN 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 9:7" />“अने तमु ते फुलो-फालो अने वदो अने धरती पोर ढेरेत सोरा पयदा करीन तीनी मे भराय जावो।”<note caller="+" style="x"><char style="xo" closed="false">9:7 </char><char style="xt" closed="false"><ref loc="GEN 1:28">उबजणाय कीताप 1:28</ref></char></note><verse eid="GEN 9:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 9:8" />अळी भगवान नुह अने तीना सोरा ने केदो, <verse eid="GEN 9:8" /><verse number="9" style="v" sid="GEN 9:9" />“ह़मळो, मे तमारी ह़ाते अने तमारी अळतेण जे तमारी अवल्‌यात हयहे, तीमनी ह़ाते बी वायदो करु। <verse eid="GEN 9:9" /><verse number="10" style="v" sid="GEN 9:10" />अने आखा जीवत्‌ला जानवरु ह़ाते बी जे तमारी ह़ाते से, ह़ु चड़ा ह़ु पाळला जानवरु, ह़ु धरती ना आखा जंगली जानवरु, धरती ना जेतरा जीव-जन्‌तु मोट्‌लु ढुन्‌ड्यु मे गेथा नीकळला से। <verse eid="GEN 9:10" /><verse number="11" style="v" sid="GEN 9:11" />अने मे तमारी ह़ाते मारो आहयो वायदो करु के आखा जानवरु अळी मुसळ-धार्‌या पाणी सी खत्‌तम नी हये अने धरती ने खत्‌तम करवा करीन अळी मुसळ-धार्‌यो पाणी नी हये।” <verse eid="GEN 9:11" /><verse number="12" style="v" sid="GEN 9:12" />अळी भगवान केदो, “जे वायदो मे तमारी ह़ाते, अने जेतरा जीवत्‌ला जानवरु तमारी ह़ाते से तीहया आखाम नी ह़ाते बी हमेसा-हमेसा नी पीड़ी जुगु करु, तीनी आहयी सेलाणी से: <verse eid="GEN 9:12" /><verse number="13" style="v" sid="GEN 9:13" />के मे वादळा मे मारो बाम मेकलो से, तीहयो मारी अने धरती ना वचमे वायदा नी सेलाणी हयहे। <verse eid="GEN 9:13" /><verse number="14" style="v" sid="GEN 9:14" />अने जत्‌यार मे धरती पोर वादळु फेलावु तत्‌यार वादळा मे बाम देखाव पड़हे। <verse eid="GEN 9:14" /><verse number="15" style="v" sid="GEN 9:15" />तत्‌यार मारो जे वायदो तमारी अने आखा जीवत्‌ला डीलवाळा जानवरु नी ह़ाते करलो से; तीने मे फोम करही, तत्‌यार एवु मुसळ-धार्‌यो पाणी अळी नी हये जीनी सी आखा जानवरु खत्‌तम हये। <verse eid="GEN 9:15" /><verse number="16" style="v" sid="GEN 9:16" />वादळा मे जे बाम हयहे मे तीने देखीन आहयु हमेसा नो वायदो फोम करही, जे भगवान अने धरती पोर ना आखा जीवत्‌ला डीलवाळा जानवरु ना वचे करलो से।” <verse eid="GEN 9:16" /><verse number="17" style="v" sid="GEN 9:17" />अळी भगवान नुह ने केदो, “जे वायदा मे धरती पोर ना आखा जानवरु नी ह़ाते करलु से, तीनी सेलाणी आहयीत से।”<verse eid="GEN 9:17" /></para>
  <para style="s">नुह अने तीना सोरा</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 9:18" />नुह ना जे सोरा मोट्‌लु ढुन्‌ड्यु मे गेथा नीकळ्‌या, तीहया सेम, हाम अने येपेत हता; अने हाम कनान नो बाह बण्‌यो। <verse eid="GEN 9:18" /><verse number="19" style="v" sid="GEN 9:19" />नुह ना तीन सोरा आहयात से अने ईमनी अवल्‌यात आखी धरती पोर फेल जी।<verse eid="GEN 9:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 9:20" />नुह जे कीरसाण हतो अंगुर नी वाड़ी लगाड़वा वाळो पेल्‌लो माणेह हतो। <verse eid="GEN 9:20" /><verse number="21" style="v" sid="GEN 9:21" />अने तीहयो अंगुर नो रोह पीन छाक ज्‌यो; अने आह़फा तम्‌बु मे मोय नांगरलो हय ज्‌यो। <verse eid="GEN 9:21" /><verse number="22" style="v" sid="GEN 9:22" />तत्‌यार कनान नो बाह हाम, आह़फा बाह ने नांगरलो देख्‌यो, अने बारो आवीन आह़फा ना बेम भाय ने की देदो।<note caller="+" style="x"><char style="xo" closed="false">9:22 </char><char style="xt" closed="false"><ref loc="LEV 20:13">लेव्‌यवेवस्‌था 20:13</ref></char></note> <verse eid="GEN 9:22" /><verse number="23" style="v" sid="GEN 9:23" />तत्‌यार सेम अने येपेत बेम लुगड़ु लीन आह़फा ना खबा पोर मेक्‌यो अने पाछो फीरीन अने उल्‌टो चालीन आह़फा ना बाह ना नांगरला डील ने ढाक देदो अने तीहया आह़फा नु मोडु पाछु करला हता करीन तीहया आह़फा बाह ने नांगरलो नी देख्‌या। <verse eid="GEN 9:23" /><verse number="24" style="v" sid="GEN 9:24" />जत्‌यार नुह नो नस्‌यो उतरी ज्‌यो, तत्‌यार तीहयो जान लेदो के तीनो नानलो सोरो तीनी हाते ह़ु कर्‌यो। <verse eid="GEN 9:24" /><verse number="25" style="v" sid="GEN 9:25" />करीन तीहयो केदो, “कनान सरापीत हये: तीहयो आह़फा ना भाय ना पावर्‌या नो पावर्‌यो हयही।” <verse eid="GEN 9:25" /><verse number="26" style="v" sid="GEN 9:26" />अळी तीहयो केदो, “सेम नो यहोवा भगवान जुगाळो से, अने कनान सेम नो पावोर हये। <verse eid="GEN 9:26" /><verse number="27" style="v" sid="GEN 9:27" />भगवान येपेत नी अवल्‌यात ने वदाड़्‌यो; अने तीहयो सेम ना तम्‌बु मे वह्‌या, अने कनान तीनो पावर्‌यो हये।”<verse eid="GEN 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 9:28" />मुसळ-धार्‌या पाणीन अळतेण नुह तीन ह़ोव पचाह साल जीवत्‌लो र्‌यो। <verse eid="GEN 9:28" /><verse number="29" style="v" sid="GEN 9:29" />आहयी रीते नुह नी आखी उमर नव ह़ोव पचाह साल नी हयी; अळतेण तीहयो मर ज्‌यो।<verse eid="GEN 9:29" /></para>
  <chapter eid="GEN 9" />
  <chapter number="10" style="c" sid="GEN 10" />
  <para style="s">नुह ना सोरा नो कुळीवेलो</para>
  <para style="r">(<ref loc="1CH 1:5-23">1 ईतीहास 1:5-23</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 10:1" />नुह ना सोरा सेम, हाम, अने येपेत हता; तीमना सोरा मुसळ-धार्‌या पाणी नी अळतेण पयदा हया: तीमनो कुळीवेलो आहयो से।<verse eid="GEN 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 10:2" />येपेत ना सोरा: गोमेर मागोग, मादे, यावान, तुबल, मेसेक, अने तीरास हया। <verse eid="GEN 10:2" /><verse number="3" style="v" sid="GEN 10:3" />गोमेर ना सोरा: असकनज, रीपत, अने तोगर्‌मा हया। <verse eid="GEN 10:3" /><verse number="4" style="v" sid="GEN 10:4" />अने यावान नी अवल्‌यात मे एलीसा अने तर्‌सीस, अने कीत्‌ती, अने दोदानी माणहु हया। <verse eid="GEN 10:4" /><verse number="5" style="v" sid="GEN 10:5" />ईमनी अवल्‌यात आड़जात्‌या ना बरप ना बड़ा ना देसु मे ईसम वटाय ज्‌या के तीहया भाती-भाती नी बोली मे, कुळीम, अने राज्‌य नी लारे अलग-अलग हय ज्‌या।<verse eid="GEN 10:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 10:6" />अळी हाम ना सोरा: कुस, मीस्‌र, पुत अने कनान हया। <verse eid="GEN 10:6" /><verse number="7" style="v" sid="GEN 10:7" />अने कुस ना सोरा सबा, हवीला, सबता, रामा अने सबुतका हया। अने रामा ना सोरा सबा, अने ददान हया। <verse eid="GEN 10:7" /><verse number="8" style="v" sid="GEN 10:8" />कुस नी अवल्‌यात मे नीम्‌रोद बी हयो; धरती पोर पेल्‌लो ताखत वाळो जीकवा वाळो तीहयोत हयो। <verse eid="GEN 10:8" /><verse number="9" style="v" sid="GEN 10:9" />तीहयो यहोवा नी नींगा मे ताखत वाळो सीकार खेलवा वाळो बण्‌यो, आनी सी आहयु कवाड़ो चाल्‌यो। “नीम्‌रोद नी अगळ यहोवा नी नींगा मे ताखत वाळो सीकार खेलवा वाळो।” <verse eid="GEN 10:9" /><verse number="10" style="v" sid="GEN 10:10" />तीना राज्‌य नी सुरुवात सीनार देस मे बेबीलोन, एरेख, अक्‌कद, अने कलने सी हयी। <verse eid="GEN 10:10" /><verse number="11" style="v" sid="GEN 10:11" />तीहया देस सी तीहयो नकळीन अस्‌सुर देस भणी ज्‌यो, अने नीनवे, रहोबोतीर अने कालह ने, <verse eid="GEN 10:11" /><verse number="12" style="v" sid="GEN 10:12" />अने नीनवे अने कालह नी वचे जे रेसेन से, तीने बी वहाड़्‌यो; मोट्‌लु ह़ेर आहयुत से।<verse eid="GEN 10:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 10:13" />मीस्‌र नी अवल्‌यात मे लुदी, अनामी, लहाबी, नप्‌तुही, <verse eid="GEN 10:13" /><verse number="14" style="v" sid="GEN 10:14" />अने पत्‌रुसी, कसलुही, अने कप्‌तोरी माणहु हया, कसलुहीयो मे सी ते पलीस्‌ती माणहु नीकळ्‌या।<verse eid="GEN 10:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 10:15" />कनान नी अवल्‌यात मे मोट्लो सोरो सीदोन, तत्‌यार हीत्‌त, <verse eid="GEN 10:15" /><verse number="16" style="v" sid="GEN 10:16" />यबुसी, एमोरी, गीर्‌गासी, <verse eid="GEN 10:16" /><verse number="17" style="v" sid="GEN 10:17" />हीव्‌वी, अर्‌की, सीनी, <verse eid="GEN 10:17" /><verse number="18" style="v" sid="GEN 10:18" />अर्‌वदी, समारी, अने हमाती माणहु बी हया; अळी कनानीयो नी अवल्‌यात बी फेल ज्‌यी। <verse eid="GEN 10:18" /><verse number="19" style="v" sid="GEN 10:19" />अने कनानीयो नी काकड़ सीदोन सी लीन गरार नी वाट सी हय्‌न गाजा तक अने अळी सदोम अने अमोरा अने अदमा अने सबोयीम नी वाट सी हय्‌न लासा तक हयु। <verse eid="GEN 10:19" /><verse number="20" style="v" sid="GEN 10:20" />हाम नी अवल्‌यात मे आहयात हया; अने आहया अलग-अलग घोराणा, बोली मे, देसु, अने जातीम नी अनसारे अलग-अलग हय ज्‌या।<verse eid="GEN 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 10:21" />अळी सेम, जे आखा एबेर नी अवल्‌यात नो मुख्‌यो माणेह हयो, अने जे येपेत नो मोट्लो भाय हतो, तीना बी सोरा पयदा हया। <verse eid="GEN 10:21" /><verse number="22" style="v" sid="GEN 10:22" />सेम ना सोरा: एलाम, अस्‌सुर, अर्‌पक्‌सद, लुद अने अराम हया। <verse eid="GEN 10:22" /><verse number="23" style="v" sid="GEN 10:23" />अराम ना सोरा: उस, हुल, गेतेर अने मस हया। <verse eid="GEN 10:23" /><verse number="24" style="v" sid="GEN 10:24" />अने अर्‌पक्‌सद सेलह ने अने सेलह एबेर ने पयदा कर्‌यो। <verse eid="GEN 10:24" /><verse number="25" style="v" sid="GEN 10:25" />अने एबेर ना बे सोरा पयदा हया, एक नु नाम पेलेग आहया कारण पाड़्‌या के तीना दाड़ा मे धरती वटाय जी, अने तीना भाय नु नाम योक्‌तान हतु। <verse eid="GEN 10:25" /><verse number="26" style="v" sid="GEN 10:26" />अने योक्‌तान अल्‌मोदाद, सेलेप, हसरमावेत, येरह, <verse eid="GEN 10:26" /><verse number="27" style="v" sid="GEN 10:27" />हदोराम, उजाल, दीक्‌ला, <verse eid="GEN 10:27" /><verse number="28" style="v" sid="GEN 10:28" />ओबाल, अबीमाएल, सबा, <verse eid="GEN 10:28" /><verse number="29" style="v" sid="GEN 10:29" />ओपीर, हवीला, अने योबाब ने पयदा कर्‌यो: आहयात आखा योक्‌तान ना सोरा हया। <verse eid="GEN 10:29" /><verse number="30" style="v" sid="GEN 10:30" />ईमनो रेवा नो जागो मेसा गेथो लगाड़ीन सपारा, जे उगवणु एक बड़ा वाळु देस से, तीनी वाट्‌ये तक हयु। <verse eid="GEN 10:30" /><verse number="31" style="v" sid="GEN 10:31" />सेम ना सोरा आहयात हया; अने आहया अलग-अलग घोराणा, भासाम, देसु अने राज्‌य नी लारे अलग-अलग हय ज्‌या।<verse eid="GEN 10:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 10:32" />नुह ना सोराम ना घोरु आहयात से: अने तीमनु राज्‌य नी लारे तीमनो कुळीवेलो आहयोत से; अने मुसळ-धार्‌या पाणीन अळतेण धरती पोर नु राज्‌य ईमनीत मे सी हय्‌न वटाय ज्‌यु।<verse eid="GEN 10:32" /></para>
  <chapter eid="GEN 10" />
  <chapter number="11" style="c" sid="GEN 11" />
  <para style="s">भासा मे गरबड़ी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 11:1" />आखी धरती पोर एकीत भासा, अने एकीत बोली हती। <verse eid="GEN 11:1" /><verse number="2" style="v" sid="GEN 11:2" />तीहयी टेमे माणहु उगवणा भणी चालता-चालता सीनार देस मे एक चोवगान देखीन तीनी मे वह ज्‌या। <verse eid="GEN 11:2" /><verse number="3" style="v" sid="GEN 11:3" />ता तीहया आह़फा मे केवा बाज ज्‌या, “आवो, आपणु ईटड़ा बणावी-बणावीन वारु रीते आक्‌ठा मे पकाड़्‌या।” अने तीहया दगड़ा ना जागा पोर ईटड़ा सी, अने चुना ना जागा पोर कादा ना गारा सी काम कर्‌या। <verse eid="GEN 11:3" /><verse number="4" style="v" sid="GEN 11:4" />अळी तीहया केदा, “आवो, आपणु एक ह़ेर अने एक मीनार बणाय लीया, जीनी चोटी ह़रग सी वात करे, आहयी रीती सी आखा आपणु नाम करे, आसम नी हये के आपणु ने आखी धरती पोर फेलवा पड़े।”<verse eid="GEN 11:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 11:5" />जत्‌यार माणहु ह़ेर अने एक मीनार बणाव्‌वा लाग्‌या; ता तीमने देखवा करीन यहोवा उतरी आयो। <verse eid="GEN 11:5" /><verse number="6" style="v" sid="GEN 11:6" />अने यहोवा केदो, “मे ह़ु देखु, के आखा एकीत टोळा ना से अने भासा बी तीमनी आखा नी एकीत से, अने तीहया एवुत काम बी सुरु कर्‌या; अने हाव जे कंय ते करवा नी कोसीत करहे; तीमनी मे सी कंय बी तीमनी जुगु काठु नी हये। <verse eid="GEN 11:6" /><verse number="7" style="v" sid="GEN 11:7" />करीन आवो, आपणु उतरीन ईमनी भासा मे मोटी गरबड़ी करया, के तीहया एक बीजा नी बोली नी ह़मज सके।” <verse eid="GEN 11:7" /><verse number="8" style="v" sid="GEN 11:8" />आहयी रीते यहोवा तीमने तां गेथो आखी धरती नी उपर फेलाड़ देदो; अने तीहया ते ह़ेर ने बणाव्‌वा छोड़ देदा। <verse eid="GEN 11:8" /><verse number="9" style="v" sid="GEN 11:9" />आहया कारण तीहया ह़ेर नु नाम बेबीलोन<note caller="+" style="f"><char style="fr" closed="false">11:9 </char><char style="fq" closed="false">बेबीलोन </char><char style="ft" closed="false">गरबड़ी</char></note> पड़्‌यु; काहाके आखी धरती नी भासा मे जे गरबड़ी से, तीहयी यहोवा तांत नाख्‌यो, अने तांत गेथी यहोवा माणहु ने आखी धरती पोर फेलाड़ देदो।<verse eid="GEN 11:9" /></para>
  <para style="s">सेम नो कुळी वेलो</para>
  <para style="r">(<ref loc="1CH 1:24-27">1 ईतीहास 1:24-27</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 11:10" />सेम नी अवल्‌यात आहयी से। मुसळ-धार्‌या पाणी ना बे साल नी अळतेण जत्‌यार सेम एक ह़ोव साल नो हयो, ता तीनी सी अर्‌पक्‌सद पयदा हयो। <verse eid="GEN 11:10" /><verse number="11" style="v" sid="GEN 11:11" />अने अर्‌पक्‌सद ना पयदा हयवा नी अळतेण सेम पांच ह़ोव साल जीवत्‌लो र्‌यो; अने तीना अळी बी सोरा-सोरी पयदा हया।<verse eid="GEN 11:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 11:12" />जत्‌यार अर्‌पक्‌सद पंयतीस साल नो हयो, तत्‌यार तीना सी सेलह पयदा हयो; <verse eid="GEN 11:12" /><verse number="13" style="v" sid="GEN 11:13" />अने सेलह ना पयदा हयवा नी अळतेण अर्‌पक्‌सद च्‌यार ह़ोव साल अळी जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा सोरी पयदा हया।<verse eid="GEN 11:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 11:14" />जत्‌यार सेलह तीस साल नो हयो, तत्‌यार तीनी लारे एबेर पयदा हयो; <verse eid="GEN 11:14" /><verse number="15" style="v" sid="GEN 11:15" />अने एबेर ना पयदा हयवा नी अळतेण सेलह च्‌यार ह़ोव तीन साल अळी जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा सोरी पयदा हया।<verse eid="GEN 11:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 11:16" />जत्‌यार एबेर चोवतीस साल नो हयो, तत्‌यार तीनी लारे पेलेग पयदा हयो; <verse eid="GEN 11:16" /><verse number="17" style="v" sid="GEN 11:17" />अने पेलेग ना पयदा हयवा नी अळतेण एबेर च्‌यार ह़ोव तीस साल अळी जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा सोरी पयदा हया।<verse eid="GEN 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 11:18" />जत्‌यार पेलेग तीस साल नो हयो, तत्‌यार तीनी लारे रु पयदा हयो; <verse eid="GEN 11:18" /><verse number="19" style="v" sid="GEN 11:19" />अने रु ना पयदा हयवा नी अळतेण पेलेग बे ह़ोव नव साल अळी जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा सोरी पयदा हया।<verse eid="GEN 11:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 11:20" />जत्‌यार रु बत्‌तीस साल नो हयो, तत्‌यार तीनी लारे सरुग पयदा हयो; <verse eid="GEN 11:20" /><verse number="21" style="v" sid="GEN 11:21" />अने सरुग ना पयदा हयवान बाद, रु बे ह़ोव ह़ात साल अळी जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा सोरी पयदा हया।<verse eid="GEN 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 11:22" />जत्‌यार सरुग तीस साल नो हयो, तत्‌यार तीनी लारे नाहोर पयदा हयो; <verse eid="GEN 11:22" /><verse number="23" style="v" sid="GEN 11:23" />अने नाहोर ना पयदा हयवा नी अळतेण सरुग बे ह़ोव साल अळी जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा सोरी पयदा हया।<verse eid="GEN 11:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 11:24" />जत्‌यार नाहोर उन्‌तीस साल नो हयो तत्‌यार तीनी लारे तेरह पयदा हयो; <verse eid="GEN 11:24" /><verse number="25" style="v" sid="GEN 11:25" />अने तेरह ना पयदा हयवा नी अळतेण नाहोर एक ह़ोव उन्‌नीस साल अळी जीवत्‌लो र्‌यो, अने तीना अळी बी सोरा सोरी पयदा हया।<verse eid="GEN 11:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 11:26" />जत्‌यार तक तेरह सत्‌तर साल नो हयो, तत्‌यार तीनी लारे अब्‌राम अने नाहोर अने हारान पयदा हया।<verse eid="GEN 11:26" /></para>
  <para style="s">तेरह नो कुळी वेलो</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 11:27" />तेरह ना अवल्‌यात आहया से: तेरह सी अब्‌राम, अने नाहोर, अने हारान पयदा हया; अने हारान सी लुत पयदा हयो। <verse eid="GEN 11:27" /><verse number="28" style="v" sid="GEN 11:28" />अने हारान आह़फा ना बाह नी अगळेत, कसदीयो ना उर नाम ना ह़ेर मे, जे तीनी पयदावारी नो जागो हतो मर ज्‌यो। <verse eid="GEN 11:28" /><verse number="29" style="v" sid="GEN 11:29" />अब्‌राम अने नाहोर बेम जणा वेवा कर्‌या। अब्‌राम नी लाडी नु नाम सारे, अने नाहोर नी लाडी नु नाम मील्‌का हतु। आहयी तीहया हारान नी सोरी हती, जे मील्‌का अने यीस्‌का बेम नो बाह हतो। <verse eid="GEN 11:29" /><verse number="30" style="v" sid="GEN 11:30" />सारे वांज्‌याण हती; तीनी एक बी अवल्‌यात नी हयी।<verse eid="GEN 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 11:31" />अने तेरह आह़फा सोरा अब्‌राम, अने आह़फा सोरान सोरो लुत, जे हारान नो सोरो हतो, अने आपणी ववेह सारे, जे तीना सोरा अब्‌राम नी लाडी हती, आहया आखाम ने लीन कसदीयो ना उर ह़ेर मे गेथो नीकळीन कनान देस जवा करीन चाल्‌यो; पण हारान नाम ना देस मे पुगीन तांत रेवा बाज ज्‌या। <verse eid="GEN 11:31" /><verse number="32" style="v" sid="GEN 11:32" />जत्‌यार तेरह बे ह़ोव पांच साल नो हयो, तत्‌यार तीहयो हारान देस मे मर ज्‌यो।<verse eid="GEN 11:32" /></para>
  <chapter eid="GEN 11" />
  <chapter number="12" style="c" sid="GEN 12" />
  <para style="s">भगवान भणी गेथु अब्‌राम ने बोलावणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 12:1" />यहोवा अब्‌राम सी केदो, “आह़फा देस, अने आह़फा कुटुम, अने आह़फा बाह ना घोर ने छोड़ीन ह़ेला देस मे जत रे जे मे तने देखाड़ही।<note caller="+" style="x"><char style="xo" closed="false">12:1 </char><char style="xt" closed="false"><ref loc="ACT 7:2">नेवताळा ना काम 7:2</ref>,<ref loc="ACT 7:3">3</ref>; <ref loc="HEB 11:8">ईब्‌रानीयो 11:8</ref></char></note> <verse eid="GEN 12:1" /><verse number="2" style="v" sid="GEN 12:2" />अने मे तारी लारे एक मोटु राज्‌य बणावही, अने तने संयबरकत आलही, अने तारु नाम मोटु करही, अने तु संयबरकत मे मुख्‌यो हयही। <verse eid="GEN 12:2" /><verse number="3" style="v" sid="GEN 12:3" />अने जे तने बरकत आले, तीमने मे संयबरकत आलही; अने जे तारी बुराय करे, तीमने मे सराप आलही अने धरती ना आखा कुळ तारी लारे संयबरकत हात करहे।”<note caller="+" style="x"><char style="xo" closed="false">12:3 </char><char style="xt" closed="false"><ref loc="GAL 3:8">गलातीयो 3:8</ref></char></note><verse eid="GEN 12:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 12:4" />यहोवा ना आहया बोल नी लारे अब्‌राम चाल्‌यो; अने लुत बी तीनी ह़ाते चाल्‌यो; अने अब्‌राम हारान देम सी नकळ्‌यो तीहयी टेमे तीहयो पीचोत्‌तर साल नो हतो। <verse eid="GEN 12:4" /><verse number="5" style="v" sid="GEN 12:5" />आहयी रीते अब्‌राम आह़फा नी लाडी सारे, अने आह़फा भतरेजा लुत ने, अने जे धन तीहया एकठा करला हता, अने जे जानवरु तीहया हारान मे हात करला हता, आखाम ने लीन कनान देस मे जावा करीन चाल पड़्‌यो, अने तीहया कनान देस मे पुग ज्‌या। <verse eid="GEN 12:5" /><verse number="6" style="v" sid="GEN 12:6" />तीहया देस ना वचमे सी जता जीन अब्‌राम सकेम मे, जां मोरे नु चोखलु वांज्‌यु झाड़ से तां पुग्‌या। तीहयी टेमे तीहया देस मे कनानी माणहु रेता हता। <verse eid="GEN 12:6" /><verse number="7" style="v" sid="GEN 12:7" />तत्‌यार यहोवा अब्‌राम ने दर्‌सन आपीन केदो, “आहयु देस मे तारी अवल्‌यात ने आपही।” अने तीहयो तां यहोवा वाटु एक वेदी बणायो, जे तीने दर्‌सन मे आपलो हतो।<note caller="+" style="x"><char style="xo" closed="false">12:7 </char><char style="xt" closed="false"><ref loc="GAL 3:17">गलातीयो 3:17</ref>; <ref loc="ACT 7:5">नेवताळा ना काम 7:5</ref></char></note> <verse eid="GEN 12:7" /><verse number="8" style="v" sid="GEN 12:8" />अळी तां गेथो अगो जीन, तीहयो ते बड़ा पोर आयो, जे बेतेल ह़ेर नी उगवणी भणी से; अने आह़फु तम्‌बु तीहया जागा मे उबो कर्‌यो जीनी बुडवणी भणी बेतेल, अने उगवणी भणी ए से; अने तां बी यहोवा जुगु एक वेदी बणायो: अने यहोवा नी भक्‌ती कर्‌यो। <verse eid="GEN 12:8" /><verse number="9" style="v" sid="GEN 12:9" />अने अब्‌राम अगो जीन कनान ना नेगेब देस भणी जत र्‌यो।<verse eid="GEN 12:9" /></para>
  <para style="s">मीस्‌र देस मे अब्‌राम</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 12:10" />तीना देस मे काळ पड़्‌यो: करीन अब्‌राम मीस्‌र देस मे जत र्‌यो के तां परदेसी बणीन रेय काहाके देस मे घणो काळ पड़लो हतो। <verse eid="GEN 12:10" /><verse number="11" style="v" sid="GEN 12:11" />अळतेण आसम हयु के मीस्‌र देस नी ह़ाते पुगीन, तीहयो आह़फी लाडी सारे ने केदो, “ह़मळ, मने मालम से, के तु एक घटाळी बयर से; <verse eid="GEN 12:11" /><verse number="12" style="v" sid="GEN 12:12" />अने जत्‌यार मीस्‌री माणहु तने देक्‌खे, तत्‌यार केहे, ‘आहयी ह़ेला नी लाडी से,’ करीन तीहया मने ते मार नाखहे, पण तने जीवत्‌ली राख लेहे। <verse eid="GEN 12:12" /><verse number="13" style="v" sid="GEN 12:13" />पण तु आहयु केजे, ‘मे हीनी बेनेह से,’ जीनी सी तारीन करते मारु वारु हये अने मारो जीव तारीन करते बचे।”<note caller="+" style="x"><char style="xo" closed="false">12:13 </char><char style="xt" closed="false"><ref loc="GEN 20:2-26:7">उबजणाय कीताप 20:2–26:7</ref></char></note> <verse eid="GEN 12:13" /><verse number="14" style="v" sid="GEN 12:14" />अळतेण आसम हयु के जत्‌यार अब्‌राम मीस्‌र देस मे आयो, तत्‌यार मीस्‌री माणहु तीनी लाडी ने देख्‌या के आहयी घणी घटाळी से। <verse eid="GEN 12:14" /><verse number="15" style="v" sid="GEN 12:15" />अने मीस्‌र नो राजा फीरोन ना मुख्‌या तीने देखीन फीरोन नी अगळ तीनी बड़ाय कर्‌या: करीन तीहयी बयर फीरोन नी हवेली मे पुगाड़ देदा। <verse eid="GEN 12:15" /><verse number="16" style="v" sid="GEN 12:16" />अने फीरोन तीनीन कारण अब्‌राम नी भलाय कर्‌यो; अने तीने गाडरा-बोकड़ा, गाय-बोळद्‌या, पावर-पावर्‌याण, गदड़ा-गदड़ी, अने उटड़ा जड़्‌या।<verse eid="GEN 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 12:17" />तत्‌यार यहोवा अब्‌राम नी लाडी सारे नी कारण फीरोन अने तीना घोराणा पोर मोटी-मोटी गरा नाख्‌यो। <verse eid="GEN 12:17" /><verse number="18" style="v" sid="GEN 12:18" />तत्‌यार फीरोन अब्‌राम ने बोलावीन केदो, “तु मार ह़ाते आहयु ह़ु कर्‌यो? तु मने ह़ुका नी देखाड़्‌यो के तीहयी तारी लाडी से? <verse eid="GEN 12:18" /><verse number="19" style="v" sid="GEN 12:19" />तु ह़ुका केदो के तीहयी तारी बेनेह से? मे हीने मारी लाडी बणाव्‌वा करीन लायो; पण हाव आह़फी लाडी ने लीन आञे गेथो जतरे।” <verse eid="GEN 12:19" /><verse number="20" style="v" sid="GEN 12:20" />अने फीरोन आह़फा माणहु ने तीनी बारा मे हुकम आप्‌यो अने तीने अने तीनी लाडी ने, आखा धन भेळ जे तीनु हतु, मोकली देदो।<verse eid="GEN 12:20" /></para>
  <chapter eid="GEN 12" />
  <chapter number="13" style="c" sid="GEN 13" />
  <para style="s">अब्‌राम अने लुत ना अलग हयवा ना बारा मे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 13:1" />तत्‌यार अब्‌राम आह़फी लाडी, अने आह़फा नु आखु धन लीन, लुत ने बी ह़ाते लीन, मीस्‌र ने छोड़ीन कनान ना दखणाव देस ना नेगेब ईलाका मे आयो। <verse eid="GEN 13:1" /><verse number="2" style="v" sid="GEN 13:2" />अब्‌राम गाडरा अने बोकड़ा, गाय अने बोळद्‌या, अने ह़ोनु अने चांदी नो मोटो मालदार हतो। <verse eid="GEN 13:2" /><verse number="3" style="v" sid="GEN 13:3" />अळतेण तीहयो दखणाव देस ना नेगेब ईलाका गेथो चालीन, बेतेल नी ह़ाते तीहया जागा मे पुग्‌या, जां पेले तीहयो करलो हतो, जा पेले तीहयो रेलो हतो तेल अने ए नी वचमे से। <verse eid="GEN 13:3" /><verse number="4" style="v" sid="GEN 13:4" />आहयो जागो तीनी वेदी नो से, जीने तीहयो पेले बणावलो हतो, अने तां अब्‌राम अळी यहोवा नी भक्‌ती कर्‌यो।<verse eid="GEN 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 13:5" />लुत नी पांह बी, जे अब्‌राम नी ह़ाते चालतो हतो, गाडरा अने बोकड़ा, गाय अने बोळद्‌या, अने तम्‌बु हतु। <verse eid="GEN 13:5" /><verse number="6" style="v" sid="GEN 13:6" />करीन तीहया देस मे तीहया बेम जणा नी जुगु वारलो चारवा नो जागो नी हतो के तीहया एक्‌ठा रेय काहाके तीमनी पांह ढेरेत धन हतु करीन तीहया एक्‌ठा नी री सक्‌या। <verse eid="GEN 13:6" /><verse number="7" style="v" sid="GEN 13:7" />अब्‌राम, अने लुत ना गाडरा अने बोकड़ा, अने गाय अने बोळद्‌या ना गुवाळ्‌या मे झगड़ो हयो। तीहयी टेमे कनानी, अने परीज्‌जी माणहु, तीहया देस मे रेता हता।<verse eid="GEN 13:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 13:8" />तत्‌यार अब्‌राम लुत सी केवा बाज ज्‌यो, “मारा अने तारा वचे, अने मारा अने तारा गुवाळ्‌या ना वचमे झगड़ो नी हयवा जोवे; काहाके आमु भाय्‌हु से। <verse eid="GEN 13:8" /><verse number="9" style="v" sid="GEN 13:9" />ह़ु आखु देस तारी अगळ नी हय? करीन तु मारी गेथो अलग हयजा; कदी तु जमणी वखे जाय ता में डाखर्‌ये वखे जही; अने कदी तु डाखर्‌ये वखे जाय, ता मे जमणी वखे जही।”<verse eid="GEN 13:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 13:10" />तत्‌यार लुत डोळा उचा करीन, यरदन नंदी नी धेड़े वाळी आखी हेटली जागा ने देख्‌यो के तीहयी आखी पीवत से। जत्‌यार तक यहोवा सदोम अने अमोरा ने खत्‌तम नी कर्‌यो हतो, तांह तक सोवर ना वाट्‌ये तक तीहयी हेटली जागा यहोवा नो बगीचो, अने मीस्‌र देस नी तेम फोळ आपवा वाळी हती।<note caller="+" style="x"><char style="xo" closed="false">13:10 </char><char style="xt" closed="false"><ref loc="GEN 2:10">उबजणाय कीताप 2:10</ref></char></note> <verse eid="GEN 13:10" /><verse number="11" style="v" sid="GEN 13:11" />लुत आह़फी जुगु यरदन नी आखी हेटली जागा ने टाळ्‌यो अने उगवणो चाल्‌यो, अने तीहया एक बीजा सी अलग हय ज्‌या। <verse eid="GEN 13:11" /><verse number="12" style="v" sid="GEN 13:12" />अब्‌राम ते कनान देस मे र्‌यो, पण लुत तीहयी हेटली ह़ेर वाळा जागा मे रेवा बाज ज्‌यो; अने आह़फा नु तम्‌बु सदोम नी ह़ाते उबो कर्‌यो। <verse eid="GEN 13:12" /><verse number="13" style="v" sid="GEN 13:13" />सदोम ना माणहु यहोवा नी नींगा मे घणा बुरा अने पापी हता।<verse eid="GEN 13:13" /></para>
  <para style="s">अब्‌राम नु हेब्‌रोन मे जाणु</para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 13:14" />जत्‌यार लुत अब्‌राम सी अलग हय ज्‌यो ता तीनी अळतेण यहोवा अब्‌राम सी केदो, “डोळा उगाड़ीन जे जागा पोर तु से तां गेथी धुराव गेथी दखणाव, अने उगवणु गेथु बुडवणु, च्‌यारो मेर नींगा कर। <verse eid="GEN 13:14" /><verse number="15" style="v" sid="GEN 13:15" />काहाके जेतरी जागा तने देखाव पड़े, तीहयी आखी ने मे तने अने तारी अवल्‌यात ने हमेसा-हमेसा नी लेदे आप देही।<note caller="+" style="x"><char style="xo" closed="false">13:15 </char><char style="xt" closed="false"><ref loc="ACT 7:5">नेवताळा ना काम 7:5</ref></char></note> <verse eid="GEN 13:15" /><verse number="16" style="v" sid="GEN 13:16" />अने मे तारा अवल्‌यात ने धरती ना कादा ना काकरा ने गीण सकहे तीहयोत तारा अवल्‌यात ने बी गीण सकहे। <verse eid="GEN 13:16" /><verse number="17" style="v" sid="GEN 13:17" />उठ, आहया देस नी लम्‌बाय अने चवड़ाय चाल अळी; काहाके मे तीने तनेत आपही।” <verse eid="GEN 13:17" /><verse number="18" style="v" sid="GEN 13:18" />आनी बाद अब्‌राम आह़फा नु तम्‌बु उखड़ीन, मम्‌रे ना चोखला वांज्‌या झाड़ु ना वचे जे हेब्‌रोन मे हता, जाय्‌न रेवा बाज ज्‌या; अने तां बी यहोवा जुगु एक वेदी बणाया।<verse eid="GEN 13:18" /></para>
  <chapter eid="GEN 13" />
  <chapter number="14" style="c" sid="GEN 14" />
  <para style="s">अब्‌राम नु लुत ने छोड़ावणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 14:1" />सीनार नो राजा अम्‌रापेल, अने एल्‌लासार नो राजा अर्‌योक, अने एलाम नो राजा कदोर्‌लाओमेर, अने गोयीम नो राजा तीदाल ना दाड़ा मे आसम हयु, <verse eid="GEN 14:1" /><verse number="2" style="v" sid="GEN 14:2" />के तीहया सदोम ना राजा बेरा, अने अमोरा ना राजा बीर्‌सा, अने अदमा ना राजा सीनाब, अने सबोयीम ना राजा समेबेर, अने बेला जे सोवर बी केवात्‌लो से, आहया राजाम ना वीरोद लड़ाय कर्‌या। <verse eid="GEN 14:2" /><verse number="3" style="v" sid="GEN 14:3" />आहया पांचोव सीद्‌दीम नाम ना हेटला जागा मे, जे मरला दर्‌या नी ह़ाते से, एको कर्‌या। <verse eid="GEN 14:3" /><verse number="4" style="v" sid="GEN 14:4" />बारे साल तक ते आहया कदोर्‌लाओमेर ना हक मे र्‌या; पण तेरवा साल मे तीना वीरोद मे हय ज्‌या। <verse eid="GEN 14:4" /><verse number="5" style="v" sid="GEN 14:5" />चोवदवा साल मे कदोर्‌लाओमेर, अने तीना ह़ाती राजा आया, अने अस्‌तारोत्‌कनम मे रपाईयो ना, अने हाम मे जुजीयो ने, अने सावेकीर्‌यातेम मे एमीयो ने, <verse eid="GEN 14:5" /><verse number="6" style="v" sid="GEN 14:6" />अने सेईर नाम ना बड़ा मे होरीयो माणहु ने, ठोकता-ठोकता तीहया एल्‌पारान तक जे जंगल नी ह़ाते से, पुग ज्‌या। <verse eid="GEN 14:6" /><verse number="7" style="v" sid="GEN 14:7" />तां सी तीहया पासा आवीन एन्‌मीसपात मे आया, जे कादेस बी केवायत्‌लो से, अने अमालेकीयो ना आखा देस ने, अने तीहया एमोरीयो ने बी जीक लेदा, जे हसासोन्‌तामार मे रेता हता।<verse eid="GEN 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 14:8" />तत्‌यार सदोम, अमोरा, अदमा, सबोयीम, अने बेला जे सोवर बी केवायत्‌लो से, ईमनो राजा नीकळ्‌यो, अने सीद्‌दीम नाम ना हेटला जागा मे, तीमनी ह़ाते लड़ाय करवा करीन हालर बणायो: <verse eid="GEN 14:8" /><verse number="9" style="v" sid="GEN 14:9" />एलाम नो राजा कदोर्‌लाओमेर, गोयीम नो राजा तीदाल, सीनार नो राजा अम्‌रापेल, अने एल्‌लासार नो राजा अर्‌योक, आहया च्‌यारो ना वीरोद मे तीहया पांचोव हालर बणाया। <verse eid="GEN 14:9" /><verse number="10" style="v" sid="GEN 14:10" />सीद्‌दीम नाम ना हेटला जागा मे जां चीकण्‌ला कादा ना खाडात-खाडा हता; सदोम अने अमोरा ना राजा नाहता-नाहता तीमनी मे घेरवाय ज्‌या, अने जे बच्‌या तीहया बड़ा पोर नाह ज्‌या। <verse eid="GEN 14:10" /><verse number="11" style="v" sid="GEN 14:11" />तत्‌यार तीहया सदोम अने अमोरा ना आखा धन अने खावा नी चीज ने लुट-पाट करीन जत र्‌या। <verse eid="GEN 14:11" /><verse number="12" style="v" sid="GEN 14:12" />अने अब्‌राम नो भतरेजो लुत, जे सदोम मे रेतो हतो; तीने बी धन भेळ तीहया लीन जत र्‌या।<verse eid="GEN 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 14:13" />तत्‌यार एक जणो जे नाहीन बच नीकळ्‌यो हतो तीहयो ज्‌यान ईब्‌रानी अब्‌राम ने खबर आल्‌यो; अब्‌राम ते एमोरी मम्‌रे, जे एसकोल अने आनेर नो भाय हतो, तीहयो चोखला वांज्‌या झाड़ु नी वचमे रेतो हतो; अने आहया माणहु अब्‌राम नी ह़ाते वायदो करला हता। <verse eid="GEN 14:13" /><verse number="14" style="v" sid="GEN 14:14" />आहयु ह़मळीन के तीनो भतरेजो तीमनी केद मे धराय जेलो से, अब्‌राम आपणा तीन ह़ोव अठ्‌ठारे वारु ह़ीकला, लड़ाय करवा मे पक्‌का पावर्‌याम ने लीन जे तीना घोराणा मे पयदा हयला हता, आखु हत्‌यार लीन दान ह़ेर तक पसळ ज्‌या। <verse eid="GEN 14:14" /><verse number="15" style="v" sid="GEN 14:15" />अने आह़फा पावर्‌याम ने अलग-गलक टोळा बणावीन राते तीमनी पोर हमलो करीन तीमने मार देदा अने होबा तक, जे दमीस्‌क ना धुराव भणी से, तीमनी पसळ ज्‌या। <verse eid="GEN 14:15" /><verse number="16" style="v" sid="GEN 14:16" />जत्‌यार तीहया आखा धन ने, अने आह़फा ना भतरेजा लुत ने, अने तीना धन ने, अने बयरा ने, अने आखा केदीम ने, पासा ली आया।<verse eid="GEN 14:16" /></para>
  <para style="s">मलकीसेदक अब्‌राम ने बरकत आपे</para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 14:17" />कदोर्‌लाओमेर अने तीमना ह़ाती राजाम ने जीतीन पासो लीन आवतो हतो ता सदोम नो राजा सावे नाम ना हेटला जागा मे, जे राजा नो हेटलु जागो बी केवायत्‌लो से, तीनी सी भेट करवा आयो। <verse eid="GEN 14:17" /><verse number="18" style="v" sid="GEN 14:18" />तत्‌यार सालोम नो राजा मलकीसीदक, जे डाहला मुख्‌या भगवान नो पुंजारो हतो, रोट्‌ला अने मोद लीन आयो।<note caller="+" style="x"><char style="xo" closed="false">14:18 </char><char style="xt" closed="false"><ref loc="HEB 7:1-10">ईब्‌रानीयो 7:1-10</ref>; <ref loc="PSA 110:4">भजन सहीता 110:4</ref></char></note> <verse eid="GEN 14:18" /><verse number="19" style="v" sid="GEN 14:19" />अने तीहयो अब्‌राम ने आहयु बरकत आप्‌यो, “डाहला मुख्‌या भगवान भणी गेथा, जे ह़रग अने धरती नो अदीकार्‌यो से, तु जुगाळो से। <verse eid="GEN 14:19" /><verse number="20" style="v" sid="GEN 14:20" />अने जुगाळो से डाहलो मुख्‌यो भगवान, जे तारा वेरीम ने तारा हक मे कर देदलो से।” तत्‌यार अब्‌राम तीना आखा धन नु दसवो वाटो आप्‌यो।<verse eid="GEN 14:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 14:21" />तत्‌यार सदोम नो राजा अब्‌राम सी केदो, “माणहु ने ते मने आल, अने धन ने तारी पांह राख।”<verse eid="GEN 14:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 14:22" />अब्‌राम सदोम ना राजा सी केदो, “डाहला मुख्‌या भगवान यहोवा, जे ह़रग अने धरती नो हकदार्‌यो से, <verse eid="GEN 14:22" /><verse number="23" style="v" sid="GEN 14:23" />तीनी मे आहयी ह़ाम खाम, के जे कंय तारु से तीनी मे सी नीता एक सुत, अने नी खाहड़ा नु बोंद, नी कानी अळी चीज लेही; के तु ईसम नी केवा जोवे, के अब्‌राम मारीत कारण मातभर हयु। <verse eid="GEN 14:23" /><verse number="24" style="v" sid="GEN 14:24" />पण जे कंय आहया जुवान्‌या खाय लेदला से अने तीमनी वाटु जे मार ह़ाते आवला हता; मतलब आनेर, एसकोल, अने मम्‌रे मे नी पासु नी आलु तीहया ते आपणु-आपणु वाटु राख लेदा।”<verse eid="GEN 14:24" /></para>
  <chapter eid="GEN 14" />
  <chapter number="15" style="c" sid="GEN 15" />
  <para style="s">अब्‌राम नी ह़ाते यहोवा नो वायदो करवा ना बारा मे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 15:1" />आहयी वातु नी अळतेण यहोवा नो आहयो बोल दर्‌सन मे अब्‌राम नी पांह पुग्‌यो “ए अब्‌राम, ना बीहे; मे तारी ढाळ अने तारु घणु मोटु फोळ से।”<verse eid="GEN 15:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 15:2" />अब्‌राम केदो, “ए यहोवा, मे ते वांज्‌यो से, अने मारा घोर नो वारीसदार आहयो दमीस्‌क वाळो एलीएजेर हयहे, पण तु मने ह़ु आपही?” <verse eid="GEN 15:2" /><verse number="3" style="v" sid="GEN 15:3" />अळी अब्‌राम केदो, “मने ते तु अवल्‌यात नी आप्‌यो, अने ह़ु देखु, के मारा घोर मे पयदा हयो एक जणो मारो वारीसदार हयहे।”<verse eid="GEN 15:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 15:4" />तत्‌यार यहोवा नु आहयो बोल तीनी पांह पुग्‌यो, “आहयो तारो वारीसदार नी हये, तारो जे सोरो हयहे, तीहयोत तारो वारीसदार हयहे।” <verse eid="GEN 15:4" /><verse number="5" style="v" sid="GEN 15:5" />अने तीहयो तीमने बारथो ली जाय्‌न केदो, “ह़रग भणी नींगा करीन तारामंडळी ने गीण, ह़ु तु हीमने गीण सके?” अळतेण तीहयो तीने केदो, “तारी अवल्‌यात आसमेत हयहे।”<note caller="+" style="x"><char style="xo" closed="false">15:5 </char><char style="xt" closed="false"><ref loc="ROM 4:18">रोमीयो 4:18</ref>; <ref loc="HEB 11:22">ईब्‌रानीयो 11:22</ref></char></note><verse eid="GEN 15:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 15:6" />तीहयो यहोवा भगवान पोर भरहो कर्‌यो; अने यहोवा आहयी वात ने तीनी कीताप मे खरलो गण्‌यो।<note caller="+" style="x"><char style="xo" closed="false">15:6 </char><char style="xt" closed="false"><ref loc="ROM 4:3">रोमीयो 4:3</ref>; <ref loc="GAL 3:6">गलातीयो 3:6</ref>; <ref loc="JAS 2:23">याकुब 2:23</ref></char></note><verse eid="GEN 15:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 15:7" />अने तीहयो तीने केदो, “मे तीहयोत यहोवा से जे तु कसदीयो ना उर ह़ेर सी बारथो ली आयो, के तने आहया देस नो हक आपु।”<verse eid="GEN 15:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 15:8" />तीहयो केदो, “ए मालीक यहोवा मे कीसम जाणु के मे आनो अदीकार्‌यो हयही?”<verse eid="GEN 15:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 15:9" />यहोवा तीने केदो, “मारी जुगु तीन साल नी एक वाछड़ी, अने तीन साल नी एक बोकड़ी, अने तीन साल नु एक गाडरो, अने एक हुली अने पारवा नु बच्‌चु ली ले।” <verse eid="GEN 15:9" /><verse number="10" style="v" sid="GEN 15:10" />अने आहया आखाम ने लीन, तीहयो वचे सी बे कटका कर देदो अने कटका ने आमने-अगळ मेल देदो पण चड़ाम ने तीहयो कटका नी कर्‌यो। <verse eid="GEN 15:10" /><verse number="11" style="v" sid="GEN 15:11" />जत्‌यार मांह खाण्‌या चड़ा मांह पोर झपट्‌या, ता अब्‌राम तीमने उडाड़ देदो।<verse eid="GEN 15:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 15:12" />जत्‌यार दाहड़ो बुडवा बाज ज्‌यो, ता अब्‌राम ने घणी नींदर आवी; अने देखो, घणी बीक अने मोट्‌लु अंदारलु तीने घेरवी लेदु।<note caller="+" style="x"><char style="xo" closed="false">15:12 </char><char style="xt" closed="false"><ref loc="JOB 4:13">अय्‌युब 4:13</ref>,<ref loc="JOB 4:14">14</ref></char></note> <verse eid="GEN 15:12" /><verse number="13" style="v" sid="GEN 15:13" />तत्‌यार यहोवा अब्‌राम सी केदो, “आहयु पक्‌को जाण के तारा अवल्‌यात बीजा देस मे अंजाणला हय्‌न रेहे, अने तीहया देस ना माणहु ना पावर्‌या हय जहे; अने तीहया तीमने च्‌यार ह़ोव साल तक दुख देहे; <note caller="+" style="x"><char style="xo" closed="false">15:13 </char><char style="xt" closed="false"><ref loc="EXO 1:1-14">नीरगमन 1:1-14</ref>; <ref loc="ACT 7:6">नेवताळा ना काम 7:6</ref> </char></note> <verse eid="GEN 15:13" /><verse number="14" style="v" sid="GEN 15:14" />अळतेण जीना देस ना तीहया पावर्‌या हयहे तीमने मे डंड आपही: अने तीनीन अळतेण तीहया ढेरकु धन तां गेथा लीन नीकळी आवहे।<note caller="+" style="x"><char style="xo" closed="false">15:14 </char><char style="xt" closed="false"><ref loc="EXO 12:40">नीरगमन 12:40</ref>,<ref loc="EXO 12:41">41</ref>; <ref loc="ACT 7:7">नेवताळा ना काम 7:7</ref></char></note> <verse eid="GEN 15:14" /><verse number="15" style="v" sid="GEN 15:15" />तु तारा मरला आड़ा-बुड़ा मे सांती सी भेसकाय जही; तने डाहवारा मे मरहे ता कादा मे गाड़ देहे। <verse eid="GEN 15:15" /><verse number="16" style="v" sid="GEN 15:16" />पण तीहया च्‌यार पीड़ी मे आञे पासा आवहे: काहाके हमणे तक एमोरी पाप करवा बंद नी कर्‌या।”<verse eid="GEN 15:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 15:17" />अने आसम हयु के जत्‌यार दाहड़ो बुड ज्‌यो अने घणु अंदारु हय ज्‌यु, ता एक वीटी जीनी मे सी धुकरो नीकळतो हतो अने एक धपत्‌लु कंदील देखाव पड़्‌यु जे तीहया कटका ना वचमे सी हय्‌न नीकळी जी। <verse eid="GEN 15:17" /><verse number="18" style="v" sid="GEN 15:18" />तीहया दाहड़े यहोवा अब्‌राम नी ह़ाते आहयो वायदो कर्‌यो, “मीस्‌र नी मोट्‌ली नंदी सी लीन फरात नाम नी मोट्‌ली नंदी तक जेतरा देस से,<note caller="+" style="x"><char style="xo" closed="false">15:18 </char><char style="xt" closed="false"><ref loc="ACT 7:8">नेवताळा ना काम 7:8</ref></char></note> <verse eid="GEN 15:18" /><verse number="19" style="v" sid="GEN 15:19" />मतलब, केनीयो, कनीज्‌जीयो, कदमोनीयो, <verse eid="GEN 15:19" /><verse number="20" style="v" sid="GEN 15:20" />हीत्‌तीयो, परीज्‌जीयो, रपाईयो, <verse eid="GEN 15:20" /><verse number="21" style="v" sid="GEN 15:21" />एमोरीयो, कनानीयो, गीर्‌गासीयो अने यबुसीयो ना देस, मे तारा अवल्‌यात ने आपलो से।”<verse eid="GEN 15:21" /></para>
  <chapter eid="GEN 15" />
  <chapter number="16" style="c" sid="GEN 16" />
  <para style="s">हाजीरा अने ईस्‌माएल</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 16:1" />अब्‌राम नी लाडी सारे नी कोय अवल्‌यात नी हती: अने तीनी हाजीरा नाम नी एक मीस्‌र नी पावर्‌याण हती। <verse eid="GEN 16:1" /><verse number="2" style="v" sid="GEN 16:2" />सारे अब्‌राम ने केदी, “देख, यहोवा ते मारी कोख बंद कर र्‌यो करीन मे तार सी वीन्‌ती करु के तु मारी पावर्‌याण नी पांह जा; कंखर माय्‌न मारु घोर तीनी लारे अगु वदे।” सारे नी आहयी वात अब्‌राम मान लेदो। <verse eid="GEN 16:2" /><verse number="3" style="v" sid="GEN 16:3" />करीन जत्‌यार अब्‌राम ने कनान देस मे रेता दह साल वीत ज्‌या ता तीनी बयर सारे आह़फी मीस्‌र नी पावर्‌याण हाजीरा ने लीन आह़फा घोरवाळा अब्‌राम ने आपी, के तीहयी तीनी लाडी बणे। <verse eid="GEN 16:3" /><verse number="4" style="v" sid="GEN 16:4" />तीहयो हाजीरा नी पांह ज्‌यो, अने तीहयी भारेपोगे हयी; जत्‌यार तीहयी जाणी के मे भारेपोगे से, ता तीहयी आह़फी नी सेटाणी ने गलत नींगा सी देखवा बाज जी।<verse eid="GEN 16:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 16:5" />तत्‌यार सारे अब्‌राम सी केदी, “जे मार पोर वेला हयली से तीहयी तारात मुंडा पोर हये। मे ते आपणी पावर्‌याण ने तारी लाडी बणाय देदी; पण जत्‌यार तीहयी जाणी के तीहयी भारेपोगे से, ता तीहयी मने गलत ह़मजवा बाज जी, करीन यहोवा मारी अने तारी वचमे नीयाव कर।”<verse eid="GEN 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 16:6" />अब्‌राम सारे ने केदो, “देख, तारी पावर्‌याण तारा हक मे से; जीसम तने भलु लागे तीसमेत तीनी ह़ाते कर।” ता सारे तीने दुख देवा बाज जी अने तीहयी तीनी अगळ गेथी नाह जी।<verse eid="GEN 16:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 16:7" />तत्‌यार यहोवा नु दुत तीने बड़ा मे सुर ना वाट्‌ये पाणी ना एक झोर नी तां देखीन तीने केदो, <verse eid="GEN 16:7" /><verse number="8" style="v" sid="GEN 16:8" />“ए सारे नी पावर्‌याण हाजीरा, तु कां गेथी आवे अने कां जाय?” तीहयी केदी, “में मारी सेटाणी सारे नी तां गेथी नाहीन आवली से।”<verse eid="GEN 16:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 16:9" />यहोवा नो दुत तीने केदो, “तारी सेटाणीन्‌तां पासी जत रे अने तीना हक मे रे।” <verse eid="GEN 16:9" /><verse number="10" style="v" sid="GEN 16:10" />अने यहोवा नो दुत तीने केदो, “मे तारा अवल्‌यात ने घणो वदाड़ही, आञे तक के ढेरेत जणा नी कारण तीमनी गीणती नी हय सकहे।” <verse eid="GEN 16:10" /><verse number="11" style="v" sid="GEN 16:11" />अने यहोवा नो दुत तीने केदो, “देख तु भारेपोगे से, अने सोरो पयदा करही; तु तीनु नाम ईस्‌माएल पाड़जे; काहाके यहोवा तारा दुख नु हाल ह़मळी लेदलु से। <verse eid="GEN 16:11" /><verse number="12" style="v" sid="GEN 16:12" />अने तीहयो माणेह जंगली गदड़ा नी तेम हयहे, अने तीहयो आखा ना वीरोद मे उबो हयहे, अने आखा तीना खीलाप हय जहे; अने तीहयो आपणा ह़गाय वाळा नी वचे वहलो रेहे।”<verse eid="GEN 16:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 16:13" />तत्‌यार तीहयो यहोवा नु नाम जीनी सी तीहयो वात करलो हतो, भगवान देखवा वाळो से पाड़ीन केदी, “ह़ु मे आञे बी तीने जत्‌लो देखी अने देखवा नी अळतेण बी जीवत्‌ली री?” <verse eid="GEN 16:13" /><verse number="14" style="v" sid="GEN 16:14" />आहया कारण सी तीहया कुवा नु नाम लहेरोय<note caller="+" style="f"><char style="fr" closed="false">16:14 </char><char style="fq" closed="false">लहेरोय </char><char style="ft" closed="false">जीवत्‌लाम नो कुवो जे मने देखे</char></note> कुवो पड़्‌यो; तीहयो ते कादेस अने बेरेद ना वचमे से। <verse eid="GEN 16:14" /><verse number="15" style="v" sid="GEN 16:15" />हाजीरा ने अब्‌राम नी लारे एक सोरो हयो; अने अब्‌राम आपणा सोरा नु नाम, ईस्‌माएल पाड़्‌यो।<note caller="+" style="x"><char style="xo" closed="false">16:15 </char><char style="xt" closed="false"><ref loc="GAL 4:22">गलातीयो 4:22</ref></char></note> <verse eid="GEN 16:15" /><verse number="16" style="v" sid="GEN 16:16" />जत्‌यार हाजीरा अब्‌राम नी लारे ईस्‌माएल ने पयदा करी तीहयी टेमे अब्‌राम छीयासी साल नो हतो।<verse eid="GEN 16:16" /></para>
  <chapter eid="GEN 16" />
  <chapter number="17" style="c" sid="GEN 17" />
  <para style="s">खतनु अने वाचा नी सेलाणी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 17:1" />जत्‌यार अब्‌राम नीन्‌यान्‌नु साल नो हय ज्‌यो, तत्‌यार यहोवा तीने दरसन आपीन केदो, “मे आखा गेथो जोर-भर्‌यो भगवान से; मारी हजुरी मे चाल अने पक्‌को हयतो जा। <verse eid="GEN 17:1" /><verse number="2" style="v" sid="GEN 17:2" />मे तारी ह़ाते वायदो करही, अने तारी अवल्‌यात ने ढेरेत वदाड़ही।” <verse eid="GEN 17:2" /><verse number="3" style="v" sid="GEN 17:3" />तत्‌यार अब्‌राम मोडा ना भरहे पड़्‌यो अने भगवान तीनी सी आहयी वात करतो ज्‌यो, <verse eid="GEN 17:3" /><verse number="4" style="v" sid="GEN 17:4" />“देख, मारो वायदो तारी ह़ाते बांदलो रेहे, एतरे तु राज्‌य ना टोळा नो मुख्‌यो बाह हय जही। <verse eid="GEN 17:4" /><verse number="5" style="v" sid="GEN 17:5" />एतरे हाव सी तारु नाम अब्‌राम नी रेय पण तारु नाम अब्‌राहम रेहे, काहाके मे तने राज्‌य ना टोळा नो मुख्‌यो बाह बणाय देदलो से।<note caller="+" style="x"><char style="xo" closed="false">17:5 </char><char style="xt" closed="false"><ref loc="ROM 4:17">रोमीयो 4:17</ref></char></note> <verse eid="GEN 17:5" /><verse number="6" style="v" sid="GEN 17:6" />मे तने ढेरेत फोळ वाळो करही, अने तने राज्‌य-राज्‌य नो मुख्‌यो बणाय देही, अळी तारी अवल्‌यात मे राजा पयदा हयहे।<verse eid="GEN 17:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 17:7" />“अने मे तारी ह़ाते, अने तारीन अळतेण पीड़ी-पीड़ी तक तारी अवल्‌यात नी ह़ाते बी आहया मरजी सी के हमेसा-हमेसा नी वायदो बांदु, के तारी अने तारीन अळतेण तारी अवल्‌यात नो बी भगवान रेही।<note caller="+" style="x"><char style="xo" closed="false">17:7 </char><char style="xt" closed="false"><ref loc="LUK 1:55">लुका 1:55</ref></char></note> <verse eid="GEN 17:7" /><verse number="8" style="v" sid="GEN 17:8" />अने मे तने, अने तारीन अळतेण तारी अवल्‌यात ने बी, आहयु आखु कनान देस, जीनी मे तु अंजाणलो हय्‌न रेय, आहयी रीती सी आपही के तीहयी हमेसा-हमेसा तीमनी आह़फी जागा रेहे, अने मे तीमनो भगवान रेही।” <note caller="+" style="x"><char style="xo" closed="false">17:8 </char><char style="xt" closed="false"><ref loc="ACT 7:5">नेवताळा ना काम 7:5</ref></char></note><verse eid="GEN 17:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 17:9" />अळतेण भगवान अब्‌राहम ने केदो, “तु बी मारी ह़ाते करला वायदा ने पाळजे; तु अने तारीन अळतेण तारी अवल्‌यात बी आपणी-आपणी पीड़ी मे तीने पाळ्‌या करे। <verse eid="GEN 17:9" /><verse number="10" style="v" sid="GEN 17:10" />मारी ह़ाते करलो वायदो, जीने पाळवा तने अने तारीन अळतेण तारी अवल्‌यात ने पड़हे, तीहयो आहयो से: तमारी मे सी एक-एक अदमी नु खतनु हये।<note caller="+" style="x"><char style="xo" closed="false">17:10 </char><char style="xt" closed="false"><ref loc="ROM 4:11">रोमीयो 4:11</ref>; <ref loc="ACT 7:8">नेवताळा ना काम 7:8</ref></char></note> <verse eid="GEN 17:10" /><verse number="11" style="v" sid="GEN 17:11" />तमु आपणी-आपणी फतरी नु खतनु कर लेजो: जे वायदो मारी अने तमारी वचमे से, तीनी आहयी सेलाणी हयहे। <verse eid="GEN 17:11" /><verse number="12" style="v" sid="GEN 17:12" />पीड़ी-पीड़ी मे तारी अवल्‌यात ना एतरात माणहु नी पण तारा घोर मे पयदा हयलो हय, नीता परदेसी ने रुप्‌या आपीन वेचातु लेदला, एसवा आखा माणहु बी जत्‌यार आंठ दाहड़ा ना हय जाय, तत्‌यार तीमनु बी खतनु करे। <verse eid="GEN 17:12" /><verse number="13" style="v" sid="GEN 17:13" />जे तारा घोर मे पयदा हये, नीता तारा रुप्‌या वेर वेचातु लेदलु हय, तीमनु खतनु हयवात जोवे; आहयी रीते मारो वायदो जीनी सेलाणी तारा डील मे हयहे तीहयी हमेसा-हमेसा रेहे। <verse eid="GEN 17:13" /><verse number="14" style="v" sid="GEN 17:14" />जे अदमी वण-खतना नो रेय, मतलब जीनी फतरी नु खतनु नी हये, तीहयो माणेह आपणा माणहु मे गेथो खत्‌तम करे, काहाके तीहयो मारी ह़ाते करला वायदा ने पुरो नी कर्‌यो।”<verse eid="GEN 17:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 17:15" />अळी भगवान अब्‌राहम सी केदो, “तारी जे लाडी सारे से, तीने तु हाव सारे नी केजे, तीनु नाम सारा<note caller="+" style="f"><char style="fr" closed="false">17:15 </char><char style="fq" closed="false">सारा </char><char style="ft" closed="false">डाहली आय्‌ह</char></note> रेहे। <verse eid="GEN 17:15" /><verse number="16" style="v" sid="GEN 17:16" />मे तीने संयबरकत आपही, अने तने तीनी लारे एक सोरो आपही; अने मे तीने एसवी संयबरकत आपही, के तीहयी जाती-जाती नी डाहली आय्‌ह बण जहे; अन तीनी अवल्‌यात मे राज्‌य-राज्‌य ना राजा पयदा हयहे।”<verse eid="GEN 17:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 17:17" />तत्‌यार अब्‌राहम मोडा ना भरहे पड़्‌यो अने हाह्‌यो, अने मन-मन मे केवा बाज ज्‌यो, “ह़ु ह़ोव साल ना अदमी ने बी सोरा हयहे अने ह़ु सारा जे नब्‌बे साल नी से सोरो पयदा करहे?” <verse eid="GEN 17:17" /><verse number="18" style="v" sid="GEN 17:18" />अने अब्‌राहम भगवान सी केदो, “ईस्‌माएल तारी नींगा बणीन रेय! आहयुत ढेरेत से।”<verse eid="GEN 17:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 17:19" />तत्‌यार भगवान केदो, ह़ाचलीन तारी लाडी सारा नो तारी लारे एक सोरो पयदा हयहे; अने तु तीनु नाम ईसाक<note caller="+" style="f"><char style="fr" closed="false">17:19 </char><char style="fq" closed="false">ईसाक </char><char style="ft" closed="false">तीहयो हाहे</char></note> राखजे; अने मे तीनी ह़ाते आसवो वायदो करही जे तीनीन अळतेण तीनी अवल्‌यात नी जुगु हमेसा-हमेसा ना वायदा हयहे। <verse eid="GEN 17:19" /><verse number="20" style="v" sid="GEN 17:20" />ईस्‌माएल ना बारा मे बी मे तारी ह़मळो से; मे तीने बी संयबरकत आपही, अने तीने फोळ वाळो करही अने ढेरेत वदाड़ही। तीनी सी बारे मुख्‌या पयदा हयहे, अने में तीने एक मोट्‌लु राज्‌य बणावही। <verse eid="GEN 17:20" /><verse number="21" style="v" sid="GEN 17:21" />पण मे मारो वायदो ईसाक नीत ह़ाते करही जे सारा नी लारे अगला साल नी आहयी टाकली टेम मे पयदा हयहे। <verse eid="GEN 17:21" /><verse number="22" style="v" sid="GEN 17:22" />तत्‌यार भगवान अब्‌राहम सी वात करवा बंद कर्‌यो अने तीनीन तांह गेथो उपर जत र्‌यो।<verse eid="GEN 17:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 17:23" />तत्‌यार अब्‌राहम आह़फा सोरा ईस्‌माएल ने बोलायो अने, तीना घोर मे जेतरा पयदा हयला हता, अने जेतरा तीना रुप्‌या सी वेचाता लेदला हता, मतलब तीना घोर मे जेतरा अदमी हता, तीहया आखाम नी बोलावीन तीहया दाहड़े भगवान ना बोल ना अनसारे तीमनी फतरी नु खतनु कर्‌यो। <verse eid="GEN 17:23" /><verse number="24" style="v" sid="GEN 17:24" />जत्‌यार अब्‌राहम नी फतरी नु खतनु हयु ता तीहयो नीन्‌यान्‌नु साल नो हतो। <verse eid="GEN 17:24" /><verse number="25" style="v" sid="GEN 17:25" />अने जत्‌यार तीना सोरा ईस्‌माएल नी फतरी नु खतनु हयु ता तीहयो तेरे साल नो हतो। <verse eid="GEN 17:25" /><verse number="26" style="v" sid="GEN 17:26" />अब्‌राहम अने तीना सोरा ईस्‌माएल बेम नु खतनु एकीत दाड़े हयु। <verse eid="GEN 17:26" /><verse number="27" style="v" sid="GEN 17:27" />अने तीना घोर मे जेतरा अदमी हता जे घोर मे पयदा हया, बाखीन जे परदेसी ना हात सी पय्‌हा वेर वेचाता लेदला हता, आखाम नु खतनु तीमनी ह़ाते हयु।<verse eid="GEN 17:27" /></para>
  <chapter eid="GEN 17" />
  <chapter number="18" style="c" sid="GEN 18" />
  <para style="s">ईसाक ना पयदा हयवा नो वायदो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 18:1" />अब्‌राहम मम्‌रे ना चोखला वांज्‌या झाड़ु नी वचमे वीजी-वीजी तोप नी टेमे तम्‌बु ना झापला पोर बह र्‌यो हतो, तत्‌यार यहोवा भगवान तीने दर्‌सन आप्‌यो: <verse eid="GEN 18:1" /><verse number="2" style="v" sid="GEN 18:2" />तीहयो डोळा उचा करीन नजर नाख्‌यो ता ह़ु देख्‌यो, के तीन अदमी तीनी अगळ उबा हय र्‌या। जत्‌यार तीहयो तीमने देख्‌यो ता तीहयो तीमनी सी भेट करवा करीन तम्‌बु ना झापले गेथो दवड़्‌यो, अने भुय्‌मे पड़ीन वांद्‌यो अने केवा बाज ज्‌यो,<note caller="+" style="x"><char style="xo" closed="false">18:2 </char><char style="xt" closed="false"><ref loc="HEB 13:2">ईब्‌रानीयो 13:2</ref></char></note> <verse eid="GEN 18:2" /><verse number="3" style="v" sid="GEN 18:3" />“ए मालीक, कदीम मारी पोर तारी दया नी नींगा से ता मे वीन्‌ती करु, के आह़फा पावर्‌या नी ह़ाते गेथो जती नी रेजे। <verse eid="GEN 18:3" /><verse number="4" style="v" sid="GEN 18:4" />मे थोड़ुक पाणी लावु अने तु आह़फा पोगु धोवीन आहया झाड़ ना साहळे आराम करे। <verse eid="GEN 18:4" /><verse number="5" style="v" sid="GEN 18:5" />अळतेण मे एक कटको रोट्‌लो ली आवु, अने तीने तमु खाय्‌न तारा जीव ने ठंडो करे; ता तीनीन अळतेण अगा जत रेजो काहाके तमु आह़फा पावर्‌या नी तांह आवला से।” तीहया केदा, “जीसम तु केय तेमेत कर।”<verse eid="GEN 18:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 18:6" />तत्‌यार अब्‌राहम ममार तम्‌बु मे सारान्‌तां ज्‌यो अने केदो, “दह कीलो मेदो लीन कुहण ले अने तीना रोट्‌ला बणाय ले।” <verse eid="GEN 18:6" /><verse number="7" style="v" sid="GEN 18:7" />अळतेण अब्‌राहम गाय अने बोळद्‌या ना टोळा मे दवड़ीन ज्‌यो, अने एक नानु अने वारु वाछड़ु लावीन आह़फा पावर्‌या ने आप्‌यो, अने तीहयो तीने ममार रांद्‌यो। <verse eid="GEN 18:7" /><verse number="8" style="v" sid="GEN 18:8" />तत्‌यार तीहयो दुद, अने आखरलु दुद, अने वाछड़ा नु रांदलु माह, लावीन तीमनी अगळ मेल देदो; अने आह़फो तीमने ह़ाते खाता लग झाड़ नी हेटो उबो र्‌यो।<verse eid="GEN 18:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 18:9" />तीहया तीने पुछ्‌या, “तारी लाडी सारा कां से?” तीहयो केदो, “तीहयी ते तम्‌बु मे से।”<verse eid="GEN 18:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 18:10" />तीहयो केदो, “में आज गेथो नव मयना बाद तारीन तां अळी आवही; अने तारी लाडी सारा नो एक सोरो पयदा हयहे।” सारा तम्‌बु ना झापला पोर जे अब्‌राहम ना पसळ हती ह़मळी री हती।<note caller="+" style="x"><char style="xo" closed="false">18:10 </char><char style="xt" closed="false"><ref loc="ROM 9:9">रोमीयो 9:9</ref></char></note> <verse eid="GEN 18:10" /><verse number="11" style="v" sid="GEN 18:11" />अब्‌राहम अने सारा बेम घणा डाया हता; अने सारा नो मयनो आव्‌वा नु बी बंद हय जेलु हतु। <verse eid="GEN 18:11" /><verse number="12" style="v" sid="GEN 18:12" />करीन सारा मन मे मुरखाय्‌न आहयु केवा बाज जी, “मे ते डोकरी से, अने मारो धणी बी डोकरो से, ता ह़ु में हाव बी सवसार नो मजो ली सकु?”<note caller="+" style="x"><char style="xo" closed="false">18:12 </char><char style="xt" closed="false"><ref loc="1PE 3:6">1 पतरस 3:6</ref></char></note><verse eid="GEN 18:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 18:13" />तत्‌यार यहोवा अब्‌राहम सी केदो, “सारा आहयु कीन काहा ह़ाही, के ह़ु मारा, जे मे आसवी डायली हय जेली से, ह़ाचलीन एक सोरो पयदा हयहे? <verse eid="GEN 18:13" /><verse number="14" style="v" sid="GEN 18:14" />ह़ु यहोवा जुगु काना काम काठु से? ठेरावली टेम मे, मतलब आज गेथो नव मयनान अळतेण, मे तारीन्‌तां अळी आवही, अने सारा नो सोरो पयदा हयहे।”<note caller="+" style="x"><char style="xo" closed="false">18:14 </char><char style="xt" closed="false"><ref loc="LUK 1:37">लुका 1:37</ref></char></note><verse eid="GEN 18:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 18:15" />तत्‌यार सारा आह़फी वात सी नीकारो करी; काहाके तीहयी बीह जी हती। तीहयी केदी “में नी ह़ाही।” मालीक केदो, “नी तु हाहली ते हती।”<verse eid="GEN 18:15" /></para>
  <para style="s">अब्‌राहम सदोम ह़ेर जुगु वीन्‌ती करे</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 18:16" />अळतेण तीहया अदमी तां गेथा चालीन, सदोम भणी भाळ्‌या; अने अब्‌राहम तीमने वळाव्‌वा करीन तीमनी ह़ाते-ह़ाते चाल्‌यो। <verse eid="GEN 18:16" /><verse number="17" style="v" sid="GEN 18:17" />तत्‌यार यहोवा केदो, “आहयु जे मे करत्‌लो से तीने ह़ु अब्‌राहम सी ह़ताड़ीन राखु? <verse eid="GEN 18:17" /><verse number="18" style="v" sid="GEN 18:18" />अब्‌राहम नी लारे ते ह़ाचलीन एक मोट्‌लु जोर-भर्‌यु राज्‌य उबजहे, अने धरती ना आखा राज्‌य तीनी लारे संयबरकत ह़ात करहे। <verse eid="GEN 18:18" /><verse number="19" style="v" sid="GEN 18:19" />मे तीने टाळलो से के तीहयो आह़फा ना सोराम अने घोरल्‌याम ने, जे तीनीन अळतेण रेहे, ह़ीकापण आले के धरमपणा अने नीयाव ना काम करे अने मारा यहोवा नी वाट्‌ये चालता रेय। तत्‌यार मे तीहया बोल ने पुरो करही जे मे अब्‌राहम सी करलो से।”<verse eid="GEN 18:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 18:20" />यहोवा केदो, “सदोम अने अमोरा ना वीरोद मे आड़वा बड़ जेलु से, अने तीमना पाप घणा जादा हय जेला से। <verse eid="GEN 18:20" /><verse number="21" style="v" sid="GEN 18:21" />करीन मे उतरीन देखही, के तीहया आड़वा नी लारे काम हयु के नी हयु, जे मारीन तांह तक पुगली से। कदीम नी कर्‌या हय ता मे जान लेही।”<verse eid="GEN 18:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 18:22" />तत्‌यार तीहया अदमी तां गेथा पासा सदोम नी भणी जत र्‌या; पण अब्‌राहम यहोवा नी ह़ाते उबो र्‌यो। <verse eid="GEN 18:22" /><verse number="23" style="v" sid="GEN 18:23" />तत्‌यार अब्‌राहम तीनी ह़ाते जाय्‌न केवा बाज ज्‌यो, “ह़ु तु ह़ाचलीन वेरी ह़ाते धरमी ने बी खत्‌तम करही? <verse eid="GEN 18:23" /><verse number="24" style="v" sid="GEN 18:24" />कदी तीहया ह़ेर मे पचाह धरमी हय ता ह़ु तु ह़ाचलीन तीहया जागा ने खत्‌तम करही अने तीहया पचाह धरमीम ना कारण जे तां से नी माफ करे? <verse eid="GEN 18:24" /><verse number="25" style="v" sid="GEN 18:25" />आहयी रीते ना काम करवा तारी सेटा रेय के वेरी ह़ाते धरमी ने बी मार नाखे अने धरम अने वेरी बेम नी हालत हये। आहयु तार सी सेटु रेय। ह़ु आखी धरती नो नीयाव करवा वाळो नीयाव नी करे?”<verse eid="GEN 18:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 18:26" />यहोवा भगवान केदो, “कदी मने सदोम ह़ेर मे पचाह धरमी माणेह जड़्‌या, ता तीमनी कारण सी तीहया आखा जागा ने छोड़ देही।”<verse eid="GEN 18:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 18:27" />अळतेण अब्‌राहम केदो, “ए मालीक, ह़मळ मे ते कादो अने रोखड़ो से; ता मे बी एतरी हीम्‌मत कर्‌यो की तार ह़ाते वात करु। <verse eid="GEN 18:27" /><verse number="28" style="v" sid="GEN 18:28" />कदी तीहया पचाह धरमी मे पांच कम हय जाय; ता ह़ु तु पांचेत कम हयवा ना कारण तीहया आखा ह़ेर ने खत्‌तम करही?” मालीक केदो, “कदी मने तीमनी मे पेतालीस बी जड़्‌या, ता बी तीमने खत्‌तम नी करु।”<verse eid="GEN 18:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 18:29" />अळतेण अब्‌राहम केदो, “कदी तां चाळीह जड़्‌या ता।” ता तीहयो केदो, “ता मे चाळीह ना कारण बी ईसम नी करु।”<verse eid="GEN 18:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 18:30" />अब्‌राहम अळी केदो, ए मालीक, रीह ना करे, ता मे कंय अळी केम: “कदी तां तीस जड़्‌या ता।” ता तीहयो केदो, “कदी मने तां तीस बी जड़्‌या ता, ता बी ईसम नी करु।”<verse eid="GEN 18:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 18:31" />अब्‌राहम केदो, “ए मालीक ह़मळ, मे एतरी हीम्‌मत ते कर्‌यो के तार ह़ाते वात करु: कदी तीमनी मे वीह जड़्‌या ता।” तीहयो केदो, “मे वीह नी कारण बी तीमने खत्‌तम नी करु।”<verse eid="GEN 18:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 18:32" />तत्‌यार अब्‌राहम केदो, “ए मालीक, रीह ना करे, मे एकीत वार अळी केही: कदी तीमनी मे दह जड़्‌या ता।” तीहयो केदो, “ता मे दह ना कारण बी तीमने खत्‌तम नी करु।” <verse eid="GEN 18:32" /><verse number="33" style="v" sid="GEN 18:33" />जत्‌यार यहोवा अब्‌राहम सी वात कर लेदो, तत्‌यार जत र्‌यो: अने अब्‌राहम आह़फा ना घोर जत र्‌यो।<verse eid="GEN 18:33" /></para>
  <chapter eid="GEN 18" />
  <chapter number="19" style="c" sid="GEN 19" />
  <para style="s">सदोम ना भुंडला कामु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 19:1" />ह़ांती वेळा तीहया बे दुत सदोम नी तां आया; अने लुत सदोम ना झापला ह़ाते बह र्‌यो हतो। तीमने देखीन तीहयो तीमनी सी भेट करवा करीन उठ्‌यो; अने मोडा ना भरहे ढुंगो वळीन वांदीन केदो; <verse eid="GEN 19:1" /><verse number="2" style="v" sid="GEN 19:2" />“ए मारा मालक्‌या, आह़फा पावर्‌या ना घोर मे आव, अने आखी रात अराम कर, अने आह़फा ना पोगे धोव, अळतेण ह़वारे उठीन आह़फा ना वाट्‌ये जजे।” तीहया केदा, “आमु चोवराया मेत रात वीताड़हु।”<verse eid="GEN 19:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 19:3" />अने तीहयो तीमनी सी घणी वीन्‌ती करीन तीमने राजी कर्‌यो; करीन तीहया तीनी ह़ाते चालीन तीना घोर मे आया; अने तीहयो तीमनी जुगु खाणु तीयार कर्‌यो, अने वण-खमीर ना रोट्‌ला बणावीन तीमने खवाड़्‌यो।<verse eid="GEN 19:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 19:4" />तीमने ह़ुव्‌वा नी सी पेले, सदोम ह़ेर ना माणहु, जवान सी लीन डायला लग, अने च्‌यारो-मेर ना आखा माणहु आवीन तीहया घोर ने घेरवी लेदा; <verse eid="GEN 19:4" /><verse number="5" style="v" sid="GEN 19:5" />अने लुत ने आड़ीन केवा बाज ज्‌या, “जे माणेह आज राते तारीन्‌तां आवला से तीहया कां से? तीमने अमारीन्‌तां बारथो लीन आव, के आमु तीमनी सी सीनाळु करीया।”<note caller="+" style="x"><char style="xo" closed="false">19:5 </char><char style="xt" closed="false"><ref loc="JDG 19:22">न्‌यायीयो 19:22</ref>,<ref loc="JDG 19:24">24</ref></char></note><verse eid="GEN 19:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 19:6" />तत्‌यार लुत तीमनी ह़ाते झापला नो बारो ज्‌यो, अने झापला ना आपणी पसळ बंद करीन केदो, <verse eid="GEN 19:6" /><verse number="7" style="v" sid="GEN 19:7" />“ए मारा भाय्‌हु, मे तमारी सी हात जोड़ु। आवु बुरु काम ना करो। <verse eid="GEN 19:7" /><verse number="8" style="v" sid="GEN 19:8" />ह़मळो, मारी बे सोरी से जे हमणे तक अदमी नु मुंडु नी देखी, मरजी हय ता मे तीमने तमारीन्‌तां बारी लीन आवु, अने तमने जीसम वारु लागे तेम वेहवार तीमनी सी करो: पण आहया अदमीम ने कंय नी करो; काहाके आहया मारी छत तळे आवला से।”<verse eid="GEN 19:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 19:9" />तीहया केदा, “सेटो हय जा!” अळतेण तीहया केवा बाज ज्‌या, “तु एक परदेसी हय्‌न आञे रेवा करीन आवलो पण हाव नीयाव करन्‌यो बण जेलो से; करीन हाव आमु तीमनी सी बी जादा तार ह़ाते बुराय करहु।” अने तीहया ते अदमी लुत ने घणा दबाव देवा बाज ज्‌या, अने झापलु तोड़वा करीन ह़ाते आया। <verse eid="GEN 19:9" /><verse number="10" style="v" sid="GEN 19:10" />तत्‌यार तीहया पोरणा हात अगा करीन लुत ने तीमनी ह़ाते घोर मे मोय हापकी लेदा, अने झापला ने बंद कर देदा। <verse eid="GEN 19:10" /><verse number="11" style="v" sid="GEN 19:11" />अने तीहया ह़ु नान्‌ला, ह़ु मोट्‌ला, आखा अदमीम ने जे घोर ना झापला पोर हता आंदळा कर देदा, पण तीहया झापलु ह़ोदता-ह़ोदता थाक ज्‌या।<verse eid="GEN 19:11" /></para>
  <para style="s">लुत नु सदोम सी बचीन नीकळणु</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 19:12" />अळतेण तीहया पोरणा लुत ने पुछ्‌या, “आञे तारु अळी कोय-कोय से? जमाय, सोरा, सोर्‌या, अने ह़ेर मे तारु जे कोय हय, तीहया आखाम ने लीन आहया जागा मे सी नीकळीन जत रे। <verse eid="GEN 19:12" /><verse number="13" style="v" sid="GEN 19:13" />काहाके आमु आहया जागा ने खत्‌तम करवा वाळा से, काहाके के आनी बुराय यहोवा नी तां पुग जेली से; अने यहोवा आमु ने आने खत्‌तम करवा करीन मोकल्‌लो से।”<verse eid="GEN 19:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 19:14" />तत्‌यार लुत आह़फा घोर सी नीकळीन आह़फाम ना जमाय ने, जीमनी ह़ाते तीनी सोर्‌याम नी ह़गाय हय जेली हती, ह़मजाड़ीन केदो, “उठो, आहया जागा मे सी नीकळीन चालो; काहाके यहोवा आहया ह़ेर ने खत्‌तम करवा वाळा से।” पण तीमना जमाय ह़मज्‌या के आहयो मजाक कर र्‌यो।<verse eid="GEN 19:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 19:15" />जत्‌यार परगड़ फाटवा बाज ज्‌यु, तत्‌यार दुत लुत सी ममार जावो करीन केदो अने केदो, “उठ, तारी लाडी अने बेम सोर्‌याम ने जे आञे से ली जा: नी ता तु बी आहया ह़ेर नी बुराय ह़ाते खत्‌तम हय जही।” <verse eid="GEN 19:15" /><verse number="16" style="v" sid="GEN 19:16" />पण तीहयो वार लगाड़तो र्‌यो, ता तीहया अदमी तीनो अने तीनी लाडी, अने बेम सोर्‌याम ना हात धर्‌या; अने तीमने नीकाळीन ह़ेर सी बारा कर देदा: काहाके यहोवा नी दया तीमनी पोर हती।<note caller="+" style="x"><char style="xo" closed="false">19:16 </char><char style="xt" closed="false"><ref loc="2PE 2:7">2 पतरस 2:7</ref></char></note> <verse eid="GEN 19:16" /><verse number="17" style="v" sid="GEN 19:17" />अने आसम हयु के जत्‌यार तीहया तीमने बारा नीकाळ्‌या, तत्‌यार तीमने केदो, “आह़फा नो जीव लीन नाह जा; पासो फीरीन नी भाळजे, अने घाटी मे नी उबो रेजे; ह़ेला बड़ा पोर नाह जजे, नी ता तु बी खत्‌तम हय जही।”<verse eid="GEN 19:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 19:18" />लुत तीमने केदो, “ए मालीक, ईसम ना करे! <verse eid="GEN 19:18" /><verse number="19" style="v" sid="GEN 19:19" />देख, तारा पावर्‌या पोर तारी बरकत हयली से, अने तारी आनी मे ढेरेत दया देखाड़लो से, के मारा जीव ने बचाड़लो से; पण मे बड़ा पोर नाही नी सकतो, कंखर ईसम नी हये, के कानी वेला मारी पोर आय पड़े, अने मे मर जाम। <verse eid="GEN 19:19" /><verse number="20" style="v" sid="GEN 19:20" />देख, ह़ेलु ह़ेर ईसम ह़ाते से के मे तां जी सकत्‌लो, अने तीहयु नानु बी से। मने तां नाह जवा दे, ह़ु तीहयु ह़ेर नानु नी हय? अने मारो जीव बच जहे।”<verse eid="GEN 19:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 19:21" />दुत लुत ने केदो, “देख, आहया बारा मे बी तारा रावण्‌या मान्‌लो से, के जीना ह़ेर नी वात तु करलो से, तीने मे खत्‌तम नी करु। <verse eid="GEN 19:21" /><verse number="22" style="v" sid="GEN 19:22" />ममार तां नाह जा; काहाके जत्‌यार तक तु तां नी पुगे तत्‌यार तक मे कंय नी कर सकु।” आहया कारण सी तीहया ह़ेर नु नाम सोवर <note caller="+" style="f"><char style="fr" closed="false">19:22 </char><char style="fq" closed="false">सोवर </char><char style="ft" closed="false">नानलो</char></note>पड़्‌यु।<verse eid="GEN 19:22" /></para>
  <para style="s">सदोम अने अमोरा नु खत्‌तम हयणु</para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 19:23" />लुत ने सोवर नी धेड़े पुगतेत दाहड़ु धरती पोर नीकळी आयु। <verse eid="GEN 19:23" /><verse number="24" style="v" sid="GEN 19:24" />तत्‌यार यहोवा आह़फी भणी गेथो सदोम अने अमोरा पोर ह़रग सी बारुद अने आक्‌ठु पाड़्‌यो;<note caller="+" style="x"><char style="xo" closed="false">19:24 </char><char style="xt" closed="false"><ref loc="MAT 10:15">मत्‌ती 10:15</ref>; <ref loc="LUK 10:12">लुका 10:12</ref>; <ref loc="2PE 2:6">2 पतरस 2:6</ref></char></note> <verse eid="GEN 19:24" /><verse number="25" style="v" sid="GEN 19:25" />अने तीहया ह़ेरु ने आखी वारली जागा ने, अने ह़ेरु मे रेवा वाळा आखा माणहु ने, धरती नी आखी मेर भेळ खत्‌तम कर देदो। <verse eid="GEN 19:25" /><verse number="26" style="v" sid="GEN 19:26" />लुत नी लाडी जे तीनी पसळ हती पासी फीरीन भाळी, अने तीहयी खारलु मीठु नो खम्‌बो बण जी।<note caller="+" style="x"><char style="xo" closed="false">19:26 </char><char style="xt" closed="false"><ref loc="LUK 17:32">लुका 17:32</ref></char></note><verse eid="GEN 19:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 19:27" />ह़वारे अब्‌राहम उठीन तीहया जागा मे ज्‌यो, जां तीहयो यहोवा नी ह़ाते उबो हतो; <verse eid="GEN 19:27" /><verse number="28" style="v" sid="GEN 19:28" />अने सदोम, अने अमोरा, अने तीहया वारला जागा ना आखा देस नी भणी डोळा उचा करीन ह़ु देख्‌यो के तीहया देस मे सी धपत्‌ली भाटी ना धुकरान तेम उड र्‌यो। <verse eid="GEN 19:28" /><verse number="29" style="v" sid="GEN 19:29" />अने ईसम हयु के जत्‌यार भगवान तीहया वारला जागा ना ह़ेरु ने, जीमनी मे लुत रेतो हतो, उलट-पुलट करीन खत्‌तम कर्‌यो, तत्‌यार तीहयो अब्‌राहम ने फोम करीन लुत ने तीहयी घटना सी बचाड़ लेदो।<verse eid="GEN 19:29" /></para>
  <para style="s">मोआबी अने अम्‌मोनी नी पयदावारी</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 19:30" />लुत सोवर ने सोड़ देदो, अने बड़ा पोर आह़फा नी बेम सोरी भेळ रेवा बाज ज्‌यो; काहाके तीहयो सोवर मे रेवा सी बीहतो हतो; करीन तीहयो अने बेम सोर्‌या तां एक गुफा मे रेवा बाज ज्‌या। <verse eid="GEN 19:30" /><verse number="31" style="v" sid="GEN 19:31" />तत्‌यार मोट्‌ली सोरी नान्‌ली सोरी ने केदी, “अमारो बाह डायलो से, अने आखी धरती पोर कोय एवो अदमी नी हय जे कळी नी रीती नी अनसारे आपणी ह़ाते आवे अने सोरा पयदा करे। <verse eid="GEN 19:31" /><verse number="32" style="v" sid="GEN 19:32" />करीन आव, आपणु आपणा बाह ने अंगुर नो रोह पीवाड़ीन, तीनी ह़ाते ह़ुवया, जीनी सी आपणु आपणा बाह ना कुळ ने बचाड़ीन राखया।” <verse eid="GEN 19:32" /><verse number="33" style="v" sid="GEN 19:33" />अने तीहया तेत दाड़े रात नी टेमे आह़फा ना बाह ने अंगुर नो रोह पीवाड़्‌या, तत्‌यार मोट्‌ली सोरी तीना बाह ह़ाते जाय्‌न ह़ुय जी; पण तीहयो नी जाण्‌यो, के तीहयी कत्‌यार ह़ुयी, अने कत्‌यार उठ जी।<verse eid="GEN 19:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 19:34" />अने ईसम हयु के बीजा दाड़े मोट्‌ली सोरी नान्‌ली सोरी ने केदी, “देख, काले राते मे आपणा बाह ह़ाते ह़ुयी; करीन आज बी राते आपणु आपणा बाह ने अंगुर नो रोह पीवाड़या; तत्‌यार तु जाय्‌न तीनी ह़ाते ह़ुवजे के आपणु आपणा बाह नी लारे अवल्‌यात पयदा करया।” <verse eid="GEN 19:34" /><verse number="35" style="v" sid="GEN 19:35" />तत्‌यार तीहया ते दाड़े बी रात नी टेमे आह़फाम ना बाह ने अंगुर नो रोह पीवाड़्‌या, अने नान्‌ली सोरी जाय्‌न बाह ह़ाते ह़ुय जी; पण तीने तीनु बी ह़ुव्‌वा अने उठवा ना बारा मे पतो नी हतो। <verse eid="GEN 19:35" /><verse number="36" style="v" sid="GEN 19:36" />आहयी रीते लुत ना बेम सोर्‌या आह़फाम ना बाह सी भारेपोगे हयी। <verse eid="GEN 19:36" /><verse number="37" style="v" sid="GEN 19:37" />मोट्‌ली सोरी एक सोरो जणी अने तीनु नाम मोवाब पाड़्‌या; तीहयो मोआब<note caller="+" style="f"><char style="fr" closed="false">19:37 </char><char style="fq" closed="false">मोआब </char><char style="ft" closed="false">आह़फा ना बाह सी</char></note> नाम नी जाती नो जे आज तक से डायलो बाह हयो। <verse eid="GEN 19:37" /><verse number="38" style="v" sid="GEN 19:38" />अने नान्‌ली सोरी बी एक सोरो जणी, अने तीनु नाम बेनम्‌मी<note caller="+" style="f"><char style="fr" closed="false">19:38 </char><char style="fq" closed="false">बेनम्‌मी </char><char style="ft" closed="false">मारो ह़गाय वाळा नो सोरो</char></note> पाड़्‌या; तीहयो अम्‌मोन जातीम नो जे आज तक से डायलो बाह हयो।<verse eid="GEN 19:38" /></para>
  <chapter eid="GEN 19" />
  <chapter number="20" style="c" sid="GEN 20" />
  <para style="s">अब्‌राहम अने अबीमेलेक</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 20:1" />अळतेण अब्‌राहम तां गेथो नीकळीन कनान ना दखणाव देस ना नेगेब ईलाका मे आवीन कादेस अने सुर ना वच मे उबो र्‌यो, अने गरार मे रेवा बाज ज्‌यो। <verse eid="GEN 20:1" /><verse number="2" style="v" sid="GEN 20:2" />अने अब्‌राहम आह़फा नी लाडी सारा ना बारा मे केवा बाज ज्‌यो, “तीहयी मारी बेनेह से,” करीन गरार नो राजा अबीमेलेक दुत ने मोकलीन सारा ने बोलाय लेदो।<note caller="+" style="x"><char style="xo" closed="false">20:2 </char><char style="xt" closed="false"><ref loc="GEN 12:13">उबजणाय कीताप 12:13</ref>; <ref loc="GEN 26:7">26:7</ref></char></note> <verse eid="GEN 20:2" /><verse number="3" style="v" sid="GEN 20:3" />राते भगवान ह़पना मे अबीमेलेक ने तां आवीन केदो, “ह़मळ, जे बयर ने तु राख लेदलो से, तीना कारण सी तु मर जही, काहाके तीना वेवा पेले हय जेला से।”<verse eid="GEN 20:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 20:4" />पण अबीमेलेक हमणे तक सारान्‌तां नी जेलो हतो; एतरे तीहयो केदो, “ए मालीक ह़ु तु वण-गुनाळ्‌ळा माणेह ने बी मार नाखही? <verse eid="GEN 20:4" /><verse number="5" style="v" sid="GEN 20:5" />ह़ु अब्‌राहम आह़फो मने नी केदो, ‘तीहयी मारी बेनेह से?’ अने ‘तीहयी बयर बी आह़फी मने केदी, तीहयो मारो भाय से,’ मे ते आपणा मन नी खराय अने आपणा वेहवार नी सच्‌चाय सी आहयु काम करलो से।”<verse eid="GEN 20:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 20:6" />भगवान तीना ह़पना मे केदो, “होव मे बी जाणु के तु तारा मन नी खराय सी तु आहयु काम करलो से अने मे तने रोक बी राख्‌यो के तु मारा वीरोद मे पाप नी करे; आहया कारण मे तने तीने सीमवा बी नी देदो। <verse eid="GEN 20:6" /><verse number="7" style="v" sid="GEN 20:7" />एतरे हाव तीहया अदमी नी लाडी ने तीने पासी आल दे; काहाके तीहयो भगवान वगे गेथी वात केवा वाळो से, अने तारी जुगु वीन्‌ती करहे, अने तु जीवतो रेही पण तु तीने पासी नी आले ता जाण ले, के तु, अने तारा जेतरा माणहु से, आखा ह़ाचलीन मर जहे।”<verse eid="GEN 20:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 20:8" />अबीमेलेक ह़वारे वेगोत उठीन आह़फा ना आखा अदीकार्‌या ने बोलावीन आहयी आखी वात ह़मळायो; अने तीहया माणहु घणा बीह ज्‌या। <verse eid="GEN 20:8" /><verse number="9" style="v" sid="GEN 20:9" />तत्‌यार अबीमेलेक अब्‌राहम ने बोलावीन केदो, “तु अमारी ह़ाते आहयु ह़ु कर्‌यो? अने मे तारु ह़ु बगाड़लो हतो के तु मारी अने मारा राज्‌य उपर एसवो मोट्‌लो पाप नाख देदो? तु मारी ह़ाते तीहयु काम कर्‌यो जे वारु नी हतु।” <verse eid="GEN 20:9" /><verse number="10" style="v" sid="GEN 20:10" />अळी अबीमेलेक अब्‌राहम ने पुछ्‌यो, “तु ह़ु ह़मजीन एसवु काम करलो?”<verse eid="GEN 20:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 20:11" />अब्‌राहम केदो, “मे आहयु सोचलो हतो के आहया जागा मे भगवान नी कंय बी बीक नी हहे; एतरे आहया माणहु मारी लाडी ना कारण सी मने मार नाखहे। <verse eid="GEN 20:11" /><verse number="12" style="v" sid="GEN 20:12" />अने ह़ाचलीन तीहयी मारी बेनेह से, तीहयी मार बाह नी सोरी ते से पण मारी आह्‌य नी सोरी नी हय; अळतेण तीहयी मारी लाडी बण जी। <verse eid="GEN 20:12" /><verse number="13" style="v" sid="GEN 20:13" />अने ईसम हयु के जत्‌यार भगवान मने मारा बाह नु घोर सोड़ीन नीकळवा नो हुकम आप्‌यो, ता मे तीने केदो, ‘तु एतरी दया मार पोर करजे के आमु बेम जां-जां जीया तां-तां तु अमारा बारा मे केजे के आहयो मारो भाय से’।”<verse eid="GEN 20:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 20:14" />तत्‌यार अबीमेलेक गाडरा अने बोकड़ा, गाय अने बोळद्‌या, अने पावर अने पावर्‌याण ने लीन अब्‌राहम ने आप्‌यो अने तीनी लाडी सारा ने बी तीने पासी आप देदो। <verse eid="GEN 20:14" /><verse number="15" style="v" sid="GEN 20:15" />अने अबीमेलेक केदो, “देख, मारु देस तार अगळ से; जां तने गमे तां रे।” <verse eid="GEN 20:15" /><verse number="16" style="v" sid="GEN 20:16" />अने सारा ने तीहयो केदो, “देख, मे तारा भाय ने एक हजार चांदी ना सीक्‌का आपलो से। आनी सी तु तारा माणहु मे वण-गुनाळ्‌ळी गणायही, अने जे आखा तारी ह़ाते से जाणहे के तु कंय बी गलत काम नी करी।”<verse eid="GEN 20:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 20:17" />तत्‌यार अब्‌राहम यहोवा पांह वीन्‌ती कर्‌यो, अने यहोवा अबीमेलेक, अने तीनी लाडी, अने पावर्‌याण ने वारु कर्‌यो अने तीमना बी सोरा पयदा हयवा बाज ज्‌या।<verse eid="GEN 20:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 20:18" />काहाके यहोवा अब्‌राहम नी लाडी सारा ना कारण सी अबीमेलेक ना घोर ना आखा बयरा नी कोख पुरी रीती सी बंद कर देदलो हतो।<verse eid="GEN 20:18" /></para>
  <chapter eid="GEN 20" />
  <chapter number="21" style="c" sid="GEN 21" />
  <para style="s">ईसाक नी पयदावारी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 21:1" />यहोवा सारा ने संयबरकत आप्‌यो, जीसम के तीहयो वायदो करलो हतो। <verse eid="GEN 21:1" /><verse number="2" style="v" sid="GEN 21:2" />सारा अब्‌राहम सी भारेपोगे हय्‌न तीना डायावारा मे तीहयी टेम पोर जे भगवान ठेरावलो हतो, एक सोरो पयदा हयो।<note caller="+" style="x"><char style="xo" closed="false">21:2 </char><char style="xt" closed="false"><ref loc="HEB 11:11">ईब्‌रानीयो 11:11</ref></char></note> <verse eid="GEN 21:2" /><verse number="3" style="v" sid="GEN 21:3" />अब्‌राहम आह़फा ना सोरा नु नाम जे सारा सी पयदा हयलो हतो ईसाक पाड़्‌यो। <verse eid="GEN 21:3" /><verse number="4" style="v" sid="GEN 21:4" />अने जत्‌यार तीनो सोरु ईसाक आंठ दाड़ा नो हयो, ता तीहयो भगवान ना हुकम ना अनसारे तीनु खतनु कर्‌यो।<note caller="+" style="x"><char style="xo" closed="false">21:4 </char><char style="xt" closed="false"><ref loc="GEN 1:12">उबजणाय कीताप 1:12</ref>; <ref loc="ACT 7:8">नेवताळा ना काम 7:8</ref></char></note> <verse eid="GEN 21:4" /><verse number="5" style="v" sid="GEN 21:5" />जत्‌यार अब्‌राहम नो सोरो ईसाक पयदा हयो ता तीहयो एक ह़ोव साल नो हतो। <verse eid="GEN 21:5" /><verse number="6" style="v" sid="GEN 21:6" />अने सारा केदी, “भगवान मने खुसी अने हाही आपलो से। जे बी आना बारा मे ह़मळहे तीहयो मार ह़ाते हाह्‌हे।” <verse eid="GEN 21:6" /><verse number="7" style="v" sid="GEN 21:7" />अळतेण तीहयो आहयु बी केदो, “ह़ु कोय कदी अब्‌राहम सी की सकतु हतु, के सारा सोराम ने दुद पीवाड़हे? पण देखो, मारी सी तीना डायावारा मे एक सोरु पयदा हयु।”<verse eid="GEN 21:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 21:8" />अने तीहयु सोरु मोटु हयु अने तीनु दुद सोड़ाया; अने ईसाक ने दुद सोड़ाव्‌वा ना दाड़े अब्‌राहम माणहु ने वारु खाणु खवाड़्‌यो।<verse eid="GEN 21:8" /></para>
  <para style="s">हाजीरा अने ईस्‌माएल ने नीकाळणु</para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 21:9" />तत्‌यार सारा ने मीस्‌र नी हाजीरा नो सोरो, जे अब्‌राहम सी पयदा हयलो हतो, ईसाक ह़ाते रमत्‌लो देखाव पड़्‌यो। <verse eid="GEN 21:9" /><verse number="10" style="v" sid="GEN 21:10" />आहया कारण सी सारा अब्‌राहम ने केदी, “आहयी पावर्‌याण अने हीना सोरा भेळ नीकाळ दे: काहाके आहयी बयर ना सोरा ने तारा धन मे गेथो कंय बी वाटो नी जड़वा जोवे, मारा सोरा ईसाक ने जे तारो वारीसदार से जड़वा जोवे।”<note caller="+" style="x"><char style="xo" closed="false">21:10 </char><char style="xt" closed="false"><ref loc="GAL 4:29-30">गलातीयो 4:29-30</ref></char></note> <verse eid="GEN 21:10" /><verse number="11" style="v" sid="GEN 21:11" />आहयी वात अब्‌राहम ने आह़फा ना सोरा ना कारण वारु नी लागी। <verse eid="GEN 21:11" /><verse number="12" style="v" sid="GEN 21:12" />तत्‌यार भगवान अब्‌राहम ने केदो, “हीय्‌या सोरो अने तारी पावर्‌याण ना कारण तने बुरु नी लागे; जे वात सारा तने केय, तीने मान, काहाके जे तारी अवल्‌यात केवायहे तीहयी ईसाक सीत चालहे। <note caller="+" style="x"><char style="xo" closed="false">21:12 </char><char style="xt" closed="false"><ref loc="ROM 9:7">रोमीयो 9:7</ref></char></note> <verse eid="GEN 21:12" /><verse number="13" style="v" sid="GEN 21:13" />पावर्‌याण ना सोरा नी लारे बी मे एक राज्‌य पयदा करही काहाके तीहयो बी तारी अवल्‌यात से।” <verse eid="GEN 21:13" /><verse number="14" style="v" sid="GEN 21:14" />एतरे अब्‌राहम ह़वारे वेगोत उठीन रोट्‌ला अने पाणी सी भरली चामड़ा नी ठेली हाजीरा ने आप्‌यो, अने तीना खांदा पोर मेक्‌यो, अने तीना सोरा ने बी खांदे बहाड़्‌यो अने मोकल्‌यो। तीहया जत र्‌या अने बेर्‌सेबा ना जंगल मे फीरता र्‌या। <verse eid="GEN 21:14" /><verse number="15" style="v" sid="GEN 21:15" />जत्‌यार ठेली मे नु पाणी खुट ज्‌यु, ता तीहयी सोरा ने एक झाड़ नी तळे सोड़ देदी। <verse eid="GEN 21:15" /><verse number="16" style="v" sid="GEN 21:16" />अने आह़फीत तीनी सी एक ह़ोव मीटर<note caller="+" style="f"><char style="fr" closed="false">21:16 </char><char style="ft" closed="false">बीलखी देय अने पड़े एतराक नाम्‌बे</char></note> सेटी जाय्‌न तीनी अगळ आहयु सोचीन बह जी, “मने सोरा नी मोत देखवा नी पड़े।” ता तीहयी तीनी भणी मोडु फीरवीन बहीन आड़ी-आड़ीन रड़वा बाज जी।<verse eid="GEN 21:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 21:17" />भगवान तीहयु सोरु नी रड़वा नी अवाज ह़मळ्‌यो; अने तीनो दुत ह़रग मे गेथो हाजीरा ने आड़ीन केदो, “ए हाजीरा तने ह़ु हयु? ना बीहे; काहाके जां तारो सोरो से तां गेथी तीनी अवाज भगवान ह़मळी लेदलो से। <verse eid="GEN 21:17" /><verse number="18" style="v" sid="GEN 21:18" />उठ तारु सोरु ने उठाड़ अने तीने भाळ; काहाके मे तीनी लारे एक मोट्‌लु राज्‌य बणावही।” <verse eid="GEN 21:18" /><verse number="19" style="v" sid="GEN 21:19" />तत्‌यार भगवान तीना डोळा उगाड़ देदो, अने तीने एक कुवो देखाव पड़्‌यो; ता तीहयी जाय्‌न ठेली पाणी भरीन सोरु ने पीयाड़ी। <verse eid="GEN 21:19" /><verse number="20" style="v" sid="GEN 21:20" />अने भगवान तीहयु सोरु ह़ाते र्‌यो; अने जत्‌यार तीहयु मोटु हयु, ता तीहयु परान नाम ना उजाड़ी बड़ा मे रेतु हतु अने एक वारु सीकारी बण ज्‌यु। <verse eid="GEN 21:20" /><verse number="21" style="v" sid="GEN 21:21" />तीहयो पारान नाम ना जंगल मे रेतो हतो। अने तीनी आह्‌य तीनी जुगु मीस्‌र देस गेथी एक बयर मंगाड़ी।<verse eid="GEN 21:21" /></para>
  <para style="s">अब्‌राहम अने अबीमेलक नी वच मे वायदो</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 21:22" />तीहया दाड़ा मे ईसम हयु के अबीमेलेक आह़फा नी सेना ना मुख्‌या पीकोल ने ह़ाते लीन अब्‌राहम ने केवा बाज ज्‌यो, “जे कंय तु करे तीनी मे भगवान तारा ह़ाते रेय;<note caller="+" style="x"><char style="xo" closed="false">21:22 </char><char style="xt" closed="false"><ref loc="GEN 26:26">उबजणाय कीताप 26:26</ref></char></note> <verse eid="GEN 21:22" /><verse number="23" style="v" sid="GEN 21:23" />एतरे हाव मारी ह़ाते आञे आहया बारा मे भगवान नी ह़ाम खा के तु नी ते मार ह़ाते धोको करे, अने नी कदी मारी अवल्‌यात ह़ाते करे, पण जीसम दया मे तार पोर करलो से, तेमेत तु मार पोर अने आहया देस पोर बी, जीनी मे तु रेय, करही।”<verse eid="GEN 21:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 21:24" />अब्‌राहम केदो “मे ह़ाम खाम।”<verse eid="GEN 21:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 21:25" />अने अब्‌राहम अबीमेलेक ने एक कुवा ना बारा मे जे तीना पावर्‌या कब्‌जो कर लेदला हता, तीना बारा मे केदो। <verse eid="GEN 21:25" /><verse number="26" style="v" sid="GEN 21:26" />तत्‌यार अबीमेलेक केदो, “मे नी जाणतो के कोय आहयु काम कर्‌यु; अने तु बी मने नी देखाड़्‌यो, अने नी ते मे बी आज सी पेले आना बारा मे कंय ह़मळ्‌यो।” <verse eid="GEN 21:26" /><verse number="27" style="v" sid="GEN 21:27" />तत्‌यार अब्‌राहम गाडरा अने बोकड़ा, अने गाय अने बोळद्‌या अबीमेलेक ने आप्‌यो; अने तीहया बेम जणा एक-बीजा ह़ाते वायदो कर्‌या। <verse eid="GEN 21:27" /><verse number="28" style="v" sid="GEN 21:28" />अब्‌राहम गाडरा ना ह़ात गाडरी बच्‌चा ने टोळा मे गेथो अलग करीन राख्‌यो। <verse eid="GEN 21:28" /><verse number="29" style="v" sid="GEN 21:29" />तत्‌यार अबीमेलेक अब्‌राहम ने पुछ्‌यो, “आहया ह़ात बच्‌चा ने, जे तु अलग करीन मेकलो से, ह़ु मतलब से?”<verse eid="GEN 21:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 21:30" />तीहयो केदो, “तु आहया ह़ात बच्‌चा ने आहयी वात नो गवा जाणीन मारा हात सी ली ले के मे आहयो कुवो खोदलो से।” <verse eid="GEN 21:30" /><verse number="31" style="v" sid="GEN 21:31" />तीहया बेम जणा तीहया जागा मे एक बीजा ह़ाते ह़ाम खादा, आहया कारण सी तीनु नाम बेर्‌सेबा<note caller="+" style="f"><char style="fr" closed="false">21:31 </char><char style="fq" closed="false">बेर्‌सेबा </char><char style="ft" closed="false">गाडरा नो कुवो मतलब ह़ाम नो कुवो</char></note> पड़्‌यु।<verse eid="GEN 21:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 21:32" />जत्‌यार तीहया बेर्‌सेबा मे आहयो वायदो कर्‌या, तत्‌यार अबीमेलेक अने तीनी सेना नो मुख्‌यो पीकोल, तां गेथा उठीन पलीस्‌तीयो ना देस पासा जत र्‌या। <verse eid="GEN 21:32" /><verse number="33" style="v" sid="GEN 21:33" />तत्‌यार अब्‌राहम बेर्‌सेबा मे एक झाव नु झाड़<note caller="+" style="f"><char style="fr" closed="false">21:33 </char><char style="fq" closed="false">झाव नु झाड़ </char><char style="ft" closed="false">एसेल, आमली नु झाड़ ने तेवु देखायण्‌यु</char></note> चोप्‌यो, अने तां यहोवा पांह जे जलमको भगवान से नी भक्‌ती कर्‌यो।<note caller="+" style="x"><char style="xo" closed="false">21:33 </char><char style="xt" closed="false"><ref loc="ISA 40:28">यसाया 40:28</ref>; <ref loc="1TI 1:17">1 तीमुथीयुस 1:17</ref></char></note> <verse eid="GEN 21:33" /><verse number="34" style="v" sid="GEN 21:34" />अब्‌राहम पलीस्‌तीयो ना देस मे ढेरेत दाड़ा तक परदेसी बणीन र्‌यो।<verse eid="GEN 21:34" /></para>
  <chapter eid="GEN 21" />
  <chapter number="22" style="c" sid="GEN 22" />
  <para style="s">अब्‌राहम नु पारख मे पड़वा ना बारा मे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 22:1" />आहयी वात हयवान अळतेण आसम हयु के भगवान, अब्‌राहम ने आहयु कीन तीनी पारख कर्‌यो, “ए अब्‌राहम!” तीहयो केदो, “ए मालीक ह़ु केय, मे आञे से।”<note caller="+" style="x"><char style="xo" closed="false">22:1 </char><char style="xt" closed="false"><ref loc="HEB 11:17">ईब्‌रानीयो 11:17</ref>,<ref loc="HEB 11:19">19</ref>; <ref loc="GEN 31:11">उबजणाय कीताप 31:11</ref>; <ref loc="EXO 3:4">नीरगमन 3:4</ref></char></note><verse eid="GEN 22:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 22:2" />तीहयो केदो, “आह़फा ना सोरा ने मतलब एक खोल्‌या सोरा ईसाक ने, जीने तु मोंग करे, ह़ाते लीन मोरीय्‌या देस मे जतरे, अने तां तीने एक बड़ा नी उपर जे मे तने देखाड़ही होम बादा करीन चड़ावजे।”<note caller="+" style="x"><char style="xo" closed="false">22:2 </char><char style="xt" closed="false"><ref loc="2CH 3:1">2 ईतीहास 3:1</ref></char></note><verse eid="GEN 22:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 22:3" />तत्‌यार अब्‌राहम ह़वारे वेगोत उठ्‌यो अने आह़फा नु गदड़ु पोर लाकड़ा बांदीन आह़फा ना बे पावर्‌या, अने आह़फा ना सोरा ईसाक ने ह़ाते लेदो, अने होम बादा नी लेदे लाकड़ा फोड़ लेदो; तत्‌यार नीकळीन तीहया जागा भणी चाल्‌यो, जीनी वात भगवान तीनी ह़ाते करलो हतो। <verse eid="GEN 22:3" /><verse number="4" style="v" sid="GEN 22:4" />तीसरा दाड़े अब्‌राहम डोळा उचा करीन तीहया जागा ने नाम्‌बे रीन देख्‌यो। <verse eid="GEN 22:4" /><verse number="5" style="v" sid="GEN 22:5" />अने तीहयो आह़फा ना पावर्‌याम ने केदो, “गदड़ा नी ह़ाते आञे उबा रेजो; आहयो सोरो अने मे ह़ेले तक जीन, अने वांदीन, अळी पासा आवती रेहु।”<verse eid="GEN 22:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 22:6" />तत्‌यार अब्‌राहम होम बादा ना लाकड़ा लेदो अने आह़फा ना सोरा ईसाक ना खांदा पोर मेल्‌यो, अने आक्‌ठु अने छुर्‌रो आह़फा ना हात मे लेदो; अने तीहया बेम एक्‌ठा चाल पड़्‌या। <verse eid="GEN 22:6" /><verse number="7" style="v" sid="GEN 22:7" />ईसाक आह़फा ना बाह अब्‌राहम ने केदो, “ए मारा बाह,” “तीहयो केदो, ए मारा सोरा, ह़ु वात से?” तीहयो केदो, “देख, आक्‌ठु अने लाकड़ा ते से; पण होम बादा जुगु गाडरु कां से?”<verse eid="GEN 22:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 22:8" />अब्‌राहम केदो, “ए मारा सोरा, भगवान होम बादा नु गाडरु ने आह़फोत ह़ोदहे।” अने तीहया बेम ह़ाते-ह़ाते अगा चालता ज्‌या।<verse eid="GEN 22:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 22:9" />जत्‌यार तीहया ते जागे जीने भगवान तीमने देखाड़लो हतो पुग्‌या; तत्‌यार अब्‌राहम तां वेदी बणावीन लाकड़ा टाळी-टाळीन मेल्‌यो, अने आह़फा सोरा ईसाक ने बांदीन वेदी पोर मेकला लाकड़ा नी उपर मेल देदो।<note caller="+" style="x"><char style="xo" closed="false">22:9 </char><char style="xt" closed="false"><ref loc="JAS 2:21">याकुब 2:21</ref></char></note> <verse eid="GEN 22:9" /><verse number="10" style="v" sid="GEN 22:10" />अळतेण अब्‌राहम हात अगो करीन छुर्‌रो ली लेदो के आह़फा ना सोरा ने बादा चड़ावे। <verse eid="GEN 22:10" /><verse number="11" style="v" sid="GEN 22:11" />तत्‌यार यहोवा नो दुत ह़रग सी तीने आड़ीन केदो, “ए अब्‌राहम, ए अब्‌राहम!” तीहयो केदो, “ए मालीक ह़ु केय, मे आञे से।”<verse eid="GEN 22:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 22:12" />तीहयो केदो, “तीहया सोरु भणीन हात ना बड़ावे, अने नी हीने कंय करे; काहाके तु जे मारी ह़ाते आह़फा ना सोरा, अने आह़फा ना एक-खोळ्‌या सोरा ने बी, नी छोड़्‌यो; आनी सी मे जाण ज्‌यो के तु भगवान नी बीक माने।”<verse eid="GEN 22:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 22:13" />ता अब्‌राहम डोळा उचा कर्‌यो, अने ह़ु देख्‌यो, के तीनी पसळ एक गाडरो आह़फा ना ह़ींगड़ा वेर एक झाटवा मे फसलो से; तत्‌यार अब्‌राहम जाय्‌न तीहया गाडरा ने लायो, अने आह़फा ना सोरा ना जागा पोर तीने होम बादा करीन चड़ायो। <verse eid="GEN 22:13" /><verse number="14" style="v" sid="GEN 22:14" />अब्‌राहम तीहया जागा नु नाम यहोवा यीरे<note caller="+" style="f"><char style="fr" closed="false">22:14 </char><char style="fq" closed="false">यहोवा यीरे </char><char style="ft" closed="false">यहोवा जुगाड़ करे</char></note> पाड़्‌यो, आनी अनसारे आज तक बी केय, “के यहोवा ना बड़ा पोर जड़त्‌लु से।”<verse eid="GEN 22:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 22:15" />अळी यहोवा नो दुत बीजी वार ह़रग मे गेथो अब्‌राहम ने आड़ीन केदो, <verse eid="GEN 22:15" /><verse number="16" style="v" sid="GEN 22:16" />“यहोवा नी आहयी अवाज से के मे मारीत ह़ाम खाम के तु जे आहयु काम करलो से के आह़फा ना सोरा, पण एक-खोळ्‌या सोरा ने बी, नी छोड़्‌यो;<note caller="+" style="x"><char style="xo" closed="false">22:16 </char><char style="xt" closed="false"><ref loc="HEB 6:13">ईब्‌रानीयो 6:13</ref>,<ref loc="HEB 6:14">14</ref></char></note> <verse eid="GEN 22:16" /><verse number="17" style="v" sid="GEN 22:17" />आहया कारण मे पक्‌को तने बरकत आलही; अने पक्‌को तारी अवल्‌यात ने ह़रग ना तारामंडळी, अने दर्‌या धेड़े ना रेळतुन तेम गीणाये नी एतरा करही, अने तारी अवल्‌यात तारा दुस्‌मन ना ह़ेर नो अदीकारी हय्‌हे;<note caller="+" style="x"><char style="xo" closed="false">22:17 </char><char style="xt" closed="false"><ref loc="HEB 11:12">ईब्‌रानीयो 11:12</ref></char></note> <verse eid="GEN 22:17" /><verse number="18" style="v" sid="GEN 22:18" />अने धरती ना आखा देस तारी अवल्‌यात नी लारे मारी सी बरकत हात करहे; काहाके तु मारु हुकम मानीन तीनु पालन कर्‌या।”<note caller="+" style="x"><char style="xo" closed="false">22:18 </char><char style="xt" closed="false"><ref loc="GAL 3:16">गलातीयो 3:16</ref>; <ref loc="ACT 3:25">नेवताळा ना काम 3:25</ref></char></note> <verse eid="GEN 22:18" /><verse number="19" style="v" sid="GEN 22:19" />तत्‌यार अब्‌राहम आह़फा ना पावर्‌यान्‌तां पासो आयो, अने तीहया आखा बेर्‌सेबा ह़ाते-ह़ाते ज्‌या; अने अब्‌राहम बेर्‌सेबा मे रेवा बाज ज्‌यो।<verse eid="GEN 22:19" /></para>
  <para style="s">नाहोर नो कुळीवेलो</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 22:20" />आहयी वात नी बाद आसम हयु के अब्‌राहम ने आहयी खबर जड़ी, “मील्‌का ने तारा भाय नाहोर सी सोरो पयदा हयलो से।” <verse eid="GEN 22:20" /><verse number="21" style="v" sid="GEN 22:21" />मील्‌का ना सोरा ते आहया हया, मतलब तीनो मोट्‌लो सोरो उस, अने उस नो भाय बुज, अने कमुएल, जे अराम नो बाह हयो। <verse eid="GEN 22:21" /><verse number="22" style="v" sid="GEN 22:22" />अळतेण केसेद, हजो, पील्‌दास यीद्‌लाप, अने बतुएल। <verse eid="GEN 22:22" /><verse number="23" style="v" sid="GEN 22:23" />आहया आंठोव ने मील्‌का अब्‌राहम ना भाय नाहोर ना लारे पयदा करी। अने बतुएल सी रीबका पयदा हयी। <verse eid="GEN 22:23" /><verse number="24" style="v" sid="GEN 22:24" />अळी नाहोर नी रुमा नाम नी एक पावर्‌याण हती तीने तीहयो राख र्‌यो हतो; जीनी सी तेबह, गहम, तहस, अने माका पयदा हया।<verse eid="GEN 22:24" /></para>
  <chapter eid="GEN 22" />
  <chapter number="23" style="c" sid="GEN 23" />
  <para style="s">सारा नी मोत अने गाड़वा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 23:1" />सारा ते एक ह़ोव सत्‌तावीस वरहु नी उमर हय जी; अने जत्‌यार सारा नी आतरी उमर हयी; <verse eid="GEN 23:1" /><verse number="2" style="v" sid="GEN 23:2" />तत्‌यार तीहयी कीर्‌यतर्‌बा मे मर जी। आहयु ते कनान देस मे से, अने हेब्‌रोन बी केवाये। एतरे अब्‌राहम सारा नी लेदे रड़वा-कलपवा तां ज्‌यो।<verse eid="GEN 23:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 23:3" />ता अब्‌राहम धोड़ नी ह़ाते तां गेथो उठीन हीत्‌तीम ने केवा बाज ज्‌यो, <verse eid="GEN 23:3" /><verse number="4" style="v" sid="GEN 23:4" />“मे तमारी वचमे पोरणो अने अंजाणलो से; मने तमारी वचमे मड़ाट्‌या नी आसवी जागा आलो जे मारी हय जाय, के मे मारी लाडी ना धोड़ ने गाड़ीन मारा डोळा गेथी छेटी करु।”<note caller="+" style="x"><char style="xo" closed="false">23:4 </char><char style="xt" closed="false"><ref loc="HEB 11:9">ईब्‌रानीयो 11:9</ref>,<ref loc="HEB 11:13">13</ref>; <ref loc="ACT 7:16">नेवताळा ना काम 7:16</ref></char></note><verse eid="GEN 23:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 23:5" />हीत्‌ती माणहु अब्‌राहम ने केदो, <verse eid="GEN 23:5" /><verse number="6" style="v" sid="GEN 23:6" />“ए अमारा मालीक, अमारी वात ह़मळ; तु अमारी वचमे मोट्‌लो मुख्‌या से। अमारा मड़ाट्‌या मे जे तने गमे तीनी मे तारी लाडी ने गाड़; अमारी मे सी कोय बी तने अमारा मड़ाट्‌या लेवा सी नी रोके, के तु तारी लाडी ने गाड़ नी सके।”<verse eid="GEN 23:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 23:7" />तत्‌यार अब्‌राहम उबो हयो, अने हीत्‌तीयो नी अगळ, जे तीहया देस ना रेवा वाळा हता, पोगे पड़ीन केवा बाज ज्‌यो, <verse eid="GEN 23:7" /><verse number="8" style="v" sid="GEN 23:8" />“कदीम तमारी आहयी मरजी हय के मे मारी लाडी ने गाड़ीन मारा डोळा सी छेटी करु, ता मारी वीन्‌ती से के सोहर ना सोरा एप्‌रोन सी मारी लेदे रावण्‌या करो, <verse eid="GEN 23:8" /><verse number="9" style="v" sid="GEN 23:9" />के तीहयो खुद नो मकपेला वाळो दोर, जे तीनी जागा नी काकड़ पोर से; तीनो पुरो दाम लीन मने आल देय, के तीहयी तमारी वचमे मड़ाट्‌या नी लेदे मारी जागा हय जाय।”<verse eid="GEN 23:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 23:10" />एप्‌रोन ते तां हीत्‌तीयो नी वचे बह र्‌यो हतो, एतरे जेतरा हीत्‌ती तीना ह़ेर ना झापले हय्‌न मोय जता हता, तीहया आखाम नी अगळ तीहयो अब्‌राहम ने जपाप आप्‌यो, <verse eid="GEN 23:10" /><verse number="11" style="v" sid="GEN 23:11" />“ए मारा मालीक, ईसम नी, मारी ह़मळ; तीहयी जागा मे तने आलु, अने तीनी मे जे दोर से, तीहयी बी मे तने आलु; आञे मारा माणहु नी अगळ मे तीने तने आल देम; काहाके तु तारी लाडी ने मड़ाट्‌या मे गाड़ सके।”<verse eid="GEN 23:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 23:12" />तत्‌यार अब्‌राहम तीहया देस ना हीत्‌ती माणहु ना अगळ पोगे पड़ीन वांद्‌यो। <verse eid="GEN 23:12" /><verse number="13" style="v" sid="GEN 23:13" />अने तीमने ह़मळतेत एप्‌रोन ने केदो, “कदी तु आसम चाहे, ता मारी ह़मळ तीहयी जागा नो जे दाम हय, तीहयो मे आपवा हींड र्‌यो; तीने मार सी ली ले, ता मे मारी मरली लाडी ना धोड़ ने मे तां गाड़ही।”<verse eid="GEN 23:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 23:14" />एप्‌रोन अब्‌राहम ने आहयो जपाप आप्‌यो, <verse eid="GEN 23:14" /><verse number="15" style="v" sid="GEN 23:15" />“ए मारा मालीक, मारी वात ह़मळ; तीहयी जागा नु दाम ते च्‌यार ह़ोव चांद ना सीक्‌का से; पण मारी अने तारी वच मे ह़ु से? तु धोड़ ने गाड़ दे।” <verse eid="GEN 23:15" /><verse number="16" style="v" sid="GEN 23:16" />अब्‌राहम एप्‌रोन नी मानीन तीने तेतरा सीक्‌का तोल देदो, जेतरु तीहयो हीत्‌तीयो नी ह़मळते केदलो हतो, मतलब च्‌यार ह़ोव चांदी ना सीक्‌का जे वेपारु करे तीमना मापे तोलीन आप्‌यो।<verse eid="GEN 23:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 23:17" />आहयी रीते एप्‌रोन नी जागा, जे मम्‌रे नी ह़ाते मकपेला मे हती, तीहया दोर भेळ, अने तीहया आखा झाड़ु भेळ जे तीनी मे अने तीना च्‌यारो-मेर अने काकड़ पोर हता, <verse eid="GEN 23:17" /><verse number="18" style="v" sid="GEN 23:18" />जेतरा हीत्‌ती तीना ह़ेर ना झापले सी हय्‌न मोय जता हता, तीहया आखाम नी अगळ अब्‌राहम ना हक मे पक्‌की कर देदा।<verse eid="GEN 23:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 23:19" />आनीन बाद अब्‌राहम आह़फा नी लाडी सारा ने तीहयी मकपेला वाळी जागा मे ना मोट्‌ला दोर मे जे मम्‌रे ना मतलब हेब्‌रोन नी अगळ कनान देस मे से, गाड़ देदो। <verse eid="GEN 23:19" /><verse number="20" style="v" sid="GEN 23:20" />आहयी रीते तीहयी जागा मोट्‌ला दोर भेळ, जे तीनी मे हती, हीत्‌तीयो नी भणी गेथी मड़ाट्‌या नी लेदे अब्‌राहम ना हक मे पक्‌की आय जी।<verse eid="GEN 23:20" /></para>
  <chapter eid="GEN 23" />
  <chapter number="24" style="c" sid="GEN 24" />
  <para style="s">ईसाक ना वेवा ना बारा मे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 24:1" />अब्‌राहम हाव डायलो हय जेलो हतो अने तीनी उमर ढेरेत हती अने यहोवा आखी वात मे तीने बरकत आपलो हतो। <verse eid="GEN 24:1" /><verse number="2" style="v" sid="GEN 24:2" />अब्‌राहम आह़फा ना तीहया पावर्‌या सी, जे तीना घोर मे डायलो अने तीना आखा माल-धन पोर हक राखवा वाळो हतो, केदो, “तारो हात मारा ह़ातळ्‌या पोर<note caller="+" style="f"><char style="fr" closed="false">24:2 </char><char style="fq" closed="false">ह़ातळ्‌या पोर </char><char style="ft" closed="false">आव्‌वा वाळी पीड़ी ने ह़ाम मे बांदवा अने कदी नी टळवा वाळी ह़ाम खावा करीन आसम करता हता। </char></note> मेक;<note caller="+" style="x"><char style="xo" closed="false">24:2 </char><char style="xt" closed="false"><ref loc="GEN 47:29">उबजणाय कीताप 47:29</ref></char></note> <verse eid="GEN 24:2" /><verse number="3" style="v" sid="GEN 24:3" />अने मारी सी ह़रग अने धरती ना मालीक यहोवा भगवान नी आना बारा मे ह़ाम खा, के तु मारा सोरा नी लेदे कनानीयो नी सोरी मे गेथी, जीमनी वचमे मे रेय, कोयने बी नी लावजे। <verse eid="GEN 24:3" /><verse number="4" style="v" sid="GEN 24:4" />पण तु मारा देस मे मारात कुटुम वाळान्‌तां जाय्‌न मारा सोरा ईसाक नी लेदे एक लाडी लीयावजे।”<verse eid="GEN 24:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 24:5" />पावर्‌यो तीने केदो, “कदीम तीहयी बयर आहया देस मे मारी ह़ाते आव्‌वा नी हींडे; ता ह़ु मने तारा सोरा ने तीहया देस मे जां गेथो तु आवलो से लीन जवा पड़हे?”<verse eid="GEN 24:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 24:6" />अब्‌राहम तीने केदो, “चेतीन रे, मारा सोरा ने तां कदी नी लीज्‌जे। <verse eid="GEN 24:6" /><verse number="7" style="v" sid="GEN 24:7" />ह़रग नो भगवान यहोवा, जे मने मार बाह ना घोर सी अने मे पयदा हयलो तीहयी जागा सी लीन आवीन मारी सी ह़ाम खाय्‌न केदो, के मे आहयु देस तारी अवल्‌यात ने आपही; तीहयोत भगवान आह़फा ना दुत ने तारी अगळ-अगळ मोकलहे, के तु मारा सोरा नी लेदे एक बयर लीन आवे। <verse eid="GEN 24:7" /><verse number="8" style="v" sid="GEN 24:8" />अने कदी तीहयी बयर तार ह़ाते आव्‌वा नी हींडे ता तु आहयी ह़ाम सी छुट जही; पण मारा सोरा ने तां नी लीज्‌जे।” <verse eid="GEN 24:8" /><verse number="9" style="v" sid="GEN 24:9" />तत्‌यार तीहयो पावर्‌यो आह़फा ना मालीक अब्‌राहम ना ह़ातळ्‌या पोर आह़फा नो हात मेकीन तीनी सी आना बारा मे ह़ाम खादो।<verse eid="GEN 24:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 24:10" />तत्‌यार तीहयो पावर्‌यो आह़फा ना मालीक ना उटड़ा मे गेथो दह उटड़ा टाळीन तीना आखा वारली-वारली चीजु मे गेथु कय-कय लीन चाल्‌यो; अने दखवरा मेसोपोटामीया मे नाहोर ना ह़ेर नी ह़ाते पुग्‌यो। <verse eid="GEN 24:10" /><verse number="11" style="v" sid="GEN 24:11" />अने तीहयो उटड़ा ने ह़ेर नी बारो एक कुवा नी ह़ाते बहाड़्‌यो। तीहयी ह़ांतली टेम हती, जे टेमे बयरा पाणी भरवा आवता। <verse eid="GEN 24:11" /><verse number="12" style="v" sid="GEN 24:12" />तीहयो केवा बाज ज्‌यो, “ए मारा मालीक अब्‌राहम ना भगवान यहोवा, आज मारा काम ने पुरु कर, अने मारा मालीक अब्‌राहम पोर दया कर। <verse eid="GEN 24:12" /><verse number="13" style="v" sid="GEN 24:13" />देख, मे पाणी ना आहया कुवान्‌तां उबो हय र्‌यो; अने ह़ेर वाळाम ना सोर्‌या पाणी भरवा नी लेदे नीकळीन आवे। <verse eid="GEN 24:13" /><verse number="14" style="v" sid="GEN 24:14" />आनीन करते आसम हयवा दे के जे सोरी ने मे केम, तारो वटळो मार भणी हेटो कर, के मे पाणी पीम, अने तीहयी केय, ‘ले, पी ले, अळतेण मे तारा उटड़ा ने बी पाणी पीवाड़ही,’ आहयी तीहयीत हय जे तु आह़फा ना पावर्‌या ईसाक नी लेदे टावलो से; आहयी रीते मे जाण लेही के तु मारा मालीक पोर दया करलो से।”<verse eid="GEN 24:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 24:15" />अने आसम हयु के जत्‌यार तीहयो वीन्‌ता करवात बाज र्‌यो हतो के तत्‌यारुत रीबका, जे अब्‌राहम ना भाय नाहोर नी लारे पयदा हयला मील्‌का ना सोरा, बतुएल नी सोरी हती, तीहयी खांदा पोर वटळो लीन आवी। <verse eid="GEN 24:15" /><verse number="16" style="v" sid="GEN 24:16" />तीहयी घणी घटाळी, अने कुवारली हती, अने हजु तक तीना वेवा नी हयला हता। तीहयी कुवा मे उतरी जी, अने आह़फी नो वटळो भरी अने पासी उपर आवती री। <verse eid="GEN 24:16" /><verse number="17" style="v" sid="GEN 24:17" />तत्‌यार तीहयो पावर्‌यो तीने भेट करवा करीन दवड़्‌यो, अने केदो, “तारा वटळा मे गेथु थोड़ुक पाणी मने पीवाड़ दे।”<verse eid="GEN 24:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 24:18" />तीहयी केदी, “ए मारा मालीक, ले, पी ले,” अने तीहयी उतवाळ्‌याण वटळो उतारीन हात मे लीनेत तीने पाणी पीवाड़ देदी। <verse eid="GEN 24:18" /><verse number="19" style="v" sid="GEN 24:19" />जत्‌यार तीहयी तीने पीवाड़ देदी, ता केदी, “मे तारा उटड़ा जुगु बी तत्‌यार तक पाणी भर-भरीन लावही, जत्‌यार तक तीहया पी नी लेय।” <verse eid="GEN 24:19" /><verse number="20" style="v" sid="GEN 24:20" />तत्‌यार तीहयी उतवाळ्‌याण आह़फी ना वटळा मे नु पाणी ने हळावा मे रेड़ीन अळी कुवा पोर पाणी भरवा दवड़ीन जी; अने तीना आखा उटड़ा जुगु पाणी भर देदी। <verse eid="GEN 24:20" /><verse number="21" style="v" sid="GEN 24:21" />अने तीहयो अदमी तीनी भणी होगो हय्‌न वहराय्‌न भाळतो जीन आहयु सोचतो हतो के यहोवा मारी यात्‌रा पुरी करलो से के नी।<verse eid="GEN 24:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 24:22" />जत्‌यार उटड़ा पाणी पी लेदा, ता तीहयो अदमी आदा तोला नी ह़ोना नी नथनी नीकाळीन तीने आल देदो, अने दह तोला ना ह़ोना ना वाळा तीना हात मे पेराय देदो; <verse eid="GEN 24:22" /><verse number="23" style="v" sid="GEN 24:23" />अने पुछ्‌यो, “आहयु मने देखाड़, के तु कोय नी सोरी से? ह़ु तारा बाह ना घोर मे अमारी जुगु रेवा नी लेदे जागो से?”<verse eid="GEN 24:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 24:24" />तीहयी जपाप आपी, “मे ते नाहोर अने मील्‌का ना सोरा बतुएल नी सोरी से।” <verse eid="GEN 24:24" /><verse number="25" style="v" sid="GEN 24:25" />अळतेण तीहयी केदी, “अमारी पांह पुळा अने चारो ढेरेत से, अने रेवा जुगु जागो बी से।”<verse eid="GEN 24:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 24:26" />तत्‌यार तीहयु माणेह ढुंगो वळीन यहोवा नी बड़ाय कर्‌यो अने केदो, <verse eid="GEN 24:26" /><verse number="27" style="v" sid="GEN 24:27" />“जुगाळो से मारो मालीक अब्‌राहम नो भगवान यहोवा, जे दया अने सच्‌चाय ने मारा मालीक पोर सी छेटी नी कर्‌यो: भगवान मने वारली वाट्‌ये चलाड़ीन मारा मालीक ना भाय-बोंदु ना घोर पुगाड़ देदलो से।”<verse eid="GEN 24:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 24:28" />तत्‌यार तीहयी सोरी दवड़ीन जीन आह़फी नी आय्‌ह ना घोर मे आहयी आखी वात ना बारा मे देखाड़ देदी। <verse eid="GEN 24:28" /><verse number="29" style="v" sid="GEN 24:29" />तत्‌यार लाबान जे रीबका नो भाय हतो, बारो कुवा भणीन दवड़ीन ज्‌यो जां अब्‌राहम नो पावर्‌यो हतो। <verse eid="GEN 24:29" /><verse number="30" style="v" sid="GEN 24:30" />अने आसम हयु के जत्‌यार तीहयो नथनी अने आह़फा नी बेनेह रीबका ना हातु मे तीहया वाळा बी देख्‌यो, अने तीनी आहयी वात बी ह़मळ्‌यो के तीहयो अदमी मारी सी आसम वात केदो; तत्‌यार तीहयो ते अदमीन्‌तां ज्‌यो; अने ह़ु देख्‌यो, के तीहयो कुवा धेड़े उटड़ान्‌तां उबो हय र्‌यो। <verse eid="GEN 24:30" /><verse number="31" style="v" sid="GEN 24:31" />लाबान तीने केदो, “ए यहोवा ना जुगाळा माणेह घोर मे आव तु बारो ह़ु का उबो हय र्‌यो? मे घोर ने, अने उटड़ा जुगु बी जागो तीयार करलो से।”<verse eid="GEN 24:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 24:32" />ता तीहयो अदमी घोर मे ज्‌यो; अने लाबान उटड़ा ना लाकड़ा छोड़ीन पुळा अने चारो घाल्‌यो; अने तीना अने तीना ह़ातीम ना पोग धोव्‌वा जुगु पाणी आल्‌यो। <verse eid="GEN 24:32" /><verse number="33" style="v" sid="GEN 24:33" />तत्‌यार अब्‌राहम ना पावर्‌या जुगु खावा करीन खाणु आप्‌या; पण तीहयो केदो “मे जत्‌यार तक मने ह़ु केवा नु से नी की देम, तांह तक कंय बी नी खाम।” लाबान केदो, “की दे।”<verse eid="GEN 24:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 24:34" />तत्‌यार पावर्‌यो केदो, मे ते अब्‌राहम नो पावर्‌यो से। <verse eid="GEN 24:34" /><verse number="35" style="v" sid="GEN 24:35" />यहोवा मारा मालीक ने ढेरेत बरकत आल्‌लो से, एतरे तीहयो मोट्लो माणेह बण ज्‌यो; अने तीहयो तीने गाडरा-बोकड़ा, गाय-बोळद्‌या, ह़ोनु-चांदी, पावर-पावर्‌याण, उटड़ा अने गदड़ा आपलो से। <verse eid="GEN 24:35" /><verse number="36" style="v" sid="GEN 24:36" />अने मारा मालीक नी लाडी सारा नो डाहवारा मे एक सोरो पयदा हयलो से; अने तीहया सोरा ने अब्‌राहम आह़फा नु आखु आप देदलो से। <verse eid="GEN 24:36" /><verse number="37" style="v" sid="GEN 24:37" />मारो मालीक मने आहयी ह़ाम खवाड़लो से के मे तीना सोरा जुगु कनानी सोर्‌या मे गेथो जे देस मे तीहयो रेय, कानी बयर नी लावे। <verse eid="GEN 24:37" /><verse number="38" style="v" sid="GEN 24:38" />मे तीना बाह ना घोर, अने तीना घोराणा ना माणहुन्‌तां जाय्‌न तीना सोरा जुगु एक बयर ली आवही। <verse eid="GEN 24:38" /><verse number="39" style="v" sid="GEN 24:39" />तत्‌यार मे मारा मालीक ने केदो, कदीम तीहयी बयर मारी ह़ाते नी आवे। <verse eid="GEN 24:39" /><verse number="40" style="v" sid="GEN 24:40" />तत्‌यार तीहयो मने केदो, यहोवा, जीनी अगळ मे चालतो आवलो से, तीहयो तार ह़ाते तीना दुत ने मोकलीन तारी यात्‌रा ने पुरी करहे; अने तु मारा माणहु, अने मारा बाह ना घोराणा मे गेथी मारा सोरा जुगु एक लाडी ली आवही। <verse eid="GEN 24:40" /><verse number="41" style="v" sid="GEN 24:41" />तु तत्‌यारुत मारी ह़ाम सी छुटही, जत्‌यार तु मारा कुळ ना माणहुन्‌तां पुगही; अने कदी तीहया तने बयर नी आले, ता तु मारी ह़ाम सी छुटही। <verse eid="GEN 24:41" /><verse number="42" style="v" sid="GEN 24:42" />“एतरे मे आज तीहया कुवा नी ह़ाते आवीन केवा बाज ज्‌यो, ए मालीक अब्‌राहम ना भगवान यहोवा, कदी तु मारी आहयी यात्‌रा ने पुरी करतो हय; <verse eid="GEN 24:42" /><verse number="43" style="v" sid="GEN 24:43" />ता देख मे पाणी ना आहया कुवा नी ह़ाते उबो हय र्‌यो, अने आसम हये, के जे कुवारली पाणी भरवा करीन आवे, अने मे तीने केम, आह़फा ना वटळा मे गेथु थोड़ुक पाणी मने पीवाड़, <verse eid="GEN 24:43" /><verse number="44" style="v" sid="GEN 24:44" />अने तीहयी मने केय, पी ले, अने मे तारा उटड़ा जुगु पीवा नु पाणी भर देही, तीहयी तेत बयर हय जीने तु मारा मालीक ना सोरा जुगु ठेरावलो से। <verse eid="GEN 24:44" /><verse number="45" style="v" sid="GEN 24:45" />मे मन-मन मे आहयु केवात बाज र्‌यो हतो, के देख रीबका खांदा पोर वटळो लीन नीकळी आवी; अळतेण तीहयी कुवा मे हेटी उतरीन पाणी भरवा बाज जी। मे तीने केदो, मने पाणी पीवाड़ दे। <verse eid="GEN 24:45" /><verse number="46" style="v" sid="GEN 24:46" />अने तीहयी ममार आह़फा ना वटळा ने खांदा पोर गेथी उतारीन केदी, ले, पी ले, अळतेण मे तारा उटड़ा ने बी पाणी पीवाड़ही, आहयी रीते मे पी लेदो, अने तीहयी उटड़ा ने बी पीवाड़ देदी। <verse eid="GEN 24:46" /><verse number="47" style="v" sid="GEN 24:47" />तत्‌यार मे तीने पुछ्‌यो, तु कोय नी सोरी से? अने तीहयी केदी, मे ते नाहोर सी पयदा हयली मील्‌का ना सोरा बतुएल नी बेटी से, ता मे तीनु नखरु मे नथनी, अने तीना हातु मे कामळ्‌या पेराय देदो। <verse eid="GEN 24:47" /><verse number="48" style="v" sid="GEN 24:48" />अळतेण मे ढुंगो वळीन मे यहोवा नी भक्‌ती कर्‌यो, अने मारा मालीक अब्‌राहम ना भगवान यहोवा ने जुगाळो केदो, काहाके तीहयो मने वारली वाट सी पुगाड़्‌यो के मे मारा मालीक ना सोरा जुगु कुटुम्‌ब नी सोरी ने ली आवु। <verse eid="GEN 24:48" /><verse number="49" style="v" sid="GEN 24:49" />एतरे हाव, कदीम तमु मारा मालीक नी ह़ाते दया अने सच्‌चाय नो वेहवार करवा हींडता हय, ता मने केवो; अने कदी नी चाहे; ता बी मने की देवो; जीनी सी मे फेसलो कर सकु के मने ह़ु करवा जोवे।”<verse eid="GEN 24:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 24:50" />तत्‌यार लाबान अने बतुएल जपाप आप्‌या, “आहयी वात यहोवा भणी गेथी हयली से; एतरे आमु आखा माणहु तने नी ते भलु की सकता अने नी बुरु। <verse eid="GEN 24:50" /><verse number="51" style="v" sid="GEN 24:51" />देख, रीबका तारी अगळ से, तीने ली जा, अने तीहयी यहोवा ना बोल ना अनसारे, तारा मालीक ना सोरा नी लाडी हय जाय।” <verse eid="GEN 24:51" /><verse number="52" style="v" sid="GEN 24:52" />तीमनी आहयी वात ह़मळीन, अब्‌राहम नो पावर्‌यो भोयमे पड़ीन यहोवा नी भक्‌ती कर्‌यो <verse eid="GEN 24:52" /><verse number="53" style="v" sid="GEN 24:53" />अळतेण तीहयो पावर्‌यो ह़ोना-चांदी नु वजन, अने लुगड़ा नीकाळीन रीबका ने आप्‌यो; अने तीना भाय अने आह्‌य ने बी तीहयो मोंगली-मोंगली चीज आप्‌यो।<verse eid="GEN 24:53" /></para>
  <para style="p">
    <verse number="54" style="v" sid="GEN 24:54" />तत्‌यार तीहयो आह़फा ना ह़ाती भेळ खाणु खादो, अने रात तांत वीताड़्‌यो। तीहयो वेगोत उठीन केदो, “मने मारा मालीक ने तां जवा करीन वळावणी करो।”<verse eid="GEN 24:54" /></para>
  <para style="p">
    <verse number="55" style="v" sid="GEN 24:55" />रीबका नो भाय अने आह्‌य केदा, “सोरी ने अमारी ह़ाते कम सी कम दह़ दाड़ा रेवा देवो; अळतेण ते तीहयी जत रेहे।”<verse eid="GEN 24:55" /></para>
  <para style="p">
    <verse number="56" style="v" sid="GEN 24:56" />तीहयो तीमने केदो, “यहोवा जे मारी यात्‌रा ने पुरी कर्‌यो; एतरे तमु मने ना रोको मने वाट्‌ये लगाड़ देवो, के मे मारा मालीक ने तां जत रेम।”<verse eid="GEN 24:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="GEN 24:57" />तीहया केदा, “आमु सोरी ने बोलावीन पुछ्‌या, अने देखहु, के तीहयी ह़ु केय।” <verse eid="GEN 24:57" /><verse number="58" style="v" sid="GEN 24:58" />अने तीहया रीबका ने बोलावीन तीने पुछ्‌या, “ह़ु तु आहया माणेह ह़ाते जही?” तीहयी केदी, “होव मे जही।”<verse eid="GEN 24:58" /></para>
  <para style="p">
    <verse number="59" style="v" sid="GEN 24:59" />तत्‌यार तीहया आह़फा नी बेनेह रीबका, अने तीनी पावर्‌याण अने अब्‌राहम ना पावर, अने तीना ह़ाती आखाम ने वाट्‌ये लगाड़्‌या। <verse eid="GEN 24:59" /><verse number="60" style="v" sid="GEN 24:60" />अने तीहया रीबका ने बरकत आपीन केदा, “ए अमारी बेनेह। तु हजारु लाखु माणहु नी पेल्‌ली आय्‌ह हये, अने तारी अवल्‌यात आह़फाम ना वेरीम ना ह़ेरु ना अदीकारी हये।” <verse eid="GEN 24:60" /><verse number="61" style="v" sid="GEN 24:61" />तत्‌यार रीबका आह़फाम ना ह़ातीम नी भेळ चाली; अने उटड़ा पोर चड़ीन तीहया माणेह पछळ हय जी। आहयी रीते तीहयो पावर्‌यो रीबका ने ह़ाते लीन चाल पड़्‌यो।<verse eid="GEN 24:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="GEN 24:62" />ईसाक जे कनान ना दखणाव देस ना नेगेब ईलाका मे रेतो हतो, लहेरोय नाम ना कुवान्‌तां माय्‌न उजाड़ी बड़ा मे हय्‌न चालीन आवतो हतो। <verse eid="GEN 24:62" /><verse number="63" style="v" sid="GEN 24:63" />ह़ांती टेमे तीहयो चोवगान मे ध्‌यान करवा करीन नीकळलो हतो; अने तीहयो डोळा उचा करीन ह़ु देख्‌यो, के उटड़ा चालीन आव्‌वा बाज र्‌या। <verse eid="GEN 24:63" /><verse number="64" style="v" sid="GEN 24:64" />रीबका बी डोळा उचा करीन ईसाक ने देखी, अने देखतेत उटड़ा पोर गेथी उतर पड़ी। <verse eid="GEN 24:64" /><verse number="65" style="v" sid="GEN 24:65" />तत्‌यार तीहयी पावर्‌या ने पुछी, “जे माणेह चोवगान मे आमने भेटवा चालीन आव्‌वा बाज र्‌यो, तीहयो कोय से?” पावर्‌यो केदो, “तीहयो ते मारो मालीक से।” तत्‌यार रीबका लुगड़ु ओडीन आह़फी नु मोडु ने ढाक लेदी।<verse eid="GEN 24:65" /></para>
  <para style="p">
    <verse number="66" style="v" sid="GEN 24:66" />पावर्‌यो ईसाक ने तीनी ह़ाते जे हयु तीहयु आखु देखाड़ देदो। <verse eid="GEN 24:66" /><verse number="67" style="v" sid="GEN 24:67" />तत्‌यार ईसाक रीबका ने आह़फा नी आह्‌य सारा ना तम्‌बु मे ली आयो, अने तीनी ह़ाते वेवा करीन तीने मोंग कर्‌यो। आहयी रीते ईसाक ने आह्‌य नी मोत नी बाद सांती जड़ी।<verse eid="GEN 24:67" /></para>
  <chapter eid="GEN 24" />
  <chapter number="25" style="c" sid="GEN 25" />
  <para style="s">अब्‌राहम नो अळी बीजो कुळीवेलो</para>
  <para style="r">(<ref loc="1CH 1:32-33">1 ईतीहास 1:32-33</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 25:1" />तत्‌यार अब्‌राहम एक अळी लाडी ली आयो जीनु नाम कतुरा हतु। <verse eid="GEN 25:1" /><verse number="2" style="v" sid="GEN 25:2" />तीनी सी जीम्‌रान, योक्‌सान, मदना, मीद्‌यान, यीसबाक, अने सुह पयदा हया। <verse eid="GEN 25:2" /><verse number="3" style="v" sid="GEN 25:3" />योक्‌सान सी सबा अने ददान पयदा हया; अने ददान नी अवल्‌यात मे अस्‌सुरी, लतुसी, अने लुम्‌मी माणहु हया। <verse eid="GEN 25:3" /><verse number="4" style="v" sid="GEN 25:4" />मीद्‌यान ना सोरा एपा, एपेर, हनोक, अबीदा, अने एल्‌दा हया, आहया आखा कतुरा ना सोरा हया।<verse eid="GEN 25:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 25:5" />ईसाक ने ते अब्‌राहम आह़फा नु आखु कंय आप्‌यो। <verse eid="GEN 25:5" /><verse number="6" style="v" sid="GEN 25:6" />पण आह़फा नी पावर्‌याण ने तीने राख र्‌यो हतो <note caller="+" style="f"><char style="fr" closed="false">25:6 </char><char style="fq" closed="false">पावर्‌याण ने तीने राख र्‌यो हतो </char><char style="ft" closed="false">हाजीरा अने कतुरा</char></note> ना सोराम ने, कंय-कंय आपीन आह़फा ना जीवते आह़फा ना सोरा ईसाक ने तां गेथा उगवणा देस मे मोकली देदो।<verse eid="GEN 25:6" /></para>
  <para style="s">अब्‌राहम नी मोत</para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 25:7" />अब्‌राहम नी आखी उमर एक ह़ोव पीचोत्‌तर साल नी हयी। <verse eid="GEN 25:7" /><verse number="8" style="v" sid="GEN 25:8" />अब्‌राहम नी ढेरेत उमर हयवा ना कारण पुरा डायावारा नी टेम मे मर ज्‌यो; अने तीहयो तीमना मरला माणहु मे जीन भेसकाय ज्‌यो। <verse eid="GEN 25:8" /><verse number="9" style="v" sid="GEN 25:9" />तीना सोरा ईसाक अने ईस्‌माएल, हीत्‌ती सोहर ना सोरा एप्‌रोन नी मम्‌रे नी उगणली धेड़ वाळी जागा मे, जे मकपेला नो मोट्लो दोर हतो, तीनी मे तीने गाड़ देदा। <verse eid="GEN 25:9" /><verse number="10" style="v" sid="GEN 25:10" />मतलब जे जागा अब्‌राहम हीत्‌तीयो नी पांह वेचाती लेदलो हतो; तीनी मे अब्‌राहम, अने तीनी लाडी सारा, बेम ने गाड़ देदा।<note caller="+" style="x"><char style="xo" closed="false">25:10 </char><char style="xt" closed="false"><ref loc="GEN 23:16">उबजणाय कीताप 23:16</ref></char></note> <verse eid="GEN 25:10" /><verse number="11" style="v" sid="GEN 25:11" />अब्‌राहम ने मरवा नी अळतेण भगवान तीना सोरा ईसाक ने जे लहेरोय नाम ना कुवान्‌तां रेतो हतो, बरकत आप्‌यो।<verse eid="GEN 25:11" /></para>
  <para style="s">ईस्‌माएल नो कुळी वेलो</para>
  <para style="r">(<ref loc="1CH 1:28-31">1 ईतीहास 1:28-31</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 25:12" />अब्‌राहम नो सोरो ईस्‌माएल जे सारा नी मीस्‌री पावर्‌याण हाजीरा सी पयदा हयलो हतो, तीनो कुळी वेलो आहयो से। <verse eid="GEN 25:12" /><verse number="13" style="v" sid="GEN 25:13" />ईस्‌माएल ना सोराम ना नाम अने कुळी वेलो आहयो से: मतलब ईस्‌माएल नो मोट्‌लो सोरो नबायोत, अळतेण केदार, अदबेल, मीबसाम, <verse eid="GEN 25:13" /><verse number="14" style="v" sid="GEN 25:14" />मीस्‌मा, दुमा, मस्‌सा, <verse eid="GEN 25:14" /><verse number="15" style="v" sid="GEN 25:15" />हदद, तेमा, यतुर, नापीस, अने केदमा। <verse eid="GEN 25:15" /><verse number="16" style="v" sid="GEN 25:16" />ईस्‌माएल ना आहयात सोरा हया, अने ईमना नामु नी लारे ईमना गामु, अने पड़ावा नु नाम बी पड़्‌या; अने आहयात बारे आह़फा-आह़फाम ना कुळी ना मुख्‌या बण्‌या। <verse eid="GEN 25:16" /><verse number="17" style="v" sid="GEN 25:17" />ईस्‌माएल नी आखी उमर एक ह़ोव संयतीस साल नी हयी; तत्‌यार तीहयो मर ज्‌यो, अने तीहयो आह़फा ना मरला आड़ा-बुड़ा माणहु मे जीन भेसकाय ज्‌यो। <verse eid="GEN 25:17" /><verse number="18" style="v" sid="GEN 25:18" />अने तीनी अवल्‌यात हवीला गेथी सुर तक, जे मीस्‌री नी उगवणी धेड़ अस्‌सुर नी वाट्‌ये से, वह ज्‌या; अने तीमनो वाटो तीमना आखा भाय-बोंदुम नी ह़ाते पड़्‌यो।<verse eid="GEN 25:18" /></para>
  <para style="s">याकुब अने एसाव नी पयदावारी</para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 25:19" />अब्‌राहम ना सोरा ईसाक नी कुळी वेलो आहयो से: अब्‌राहम सी ईसाक पयदा हयो; <verse eid="GEN 25:19" /><verse number="20" style="v" sid="GEN 25:20" />अने ईसाक चाळीह साल नो हय्‌न रीबका ने, जे पदनराम ना रेवा वाळा, अरामी बतुएल नी सोरी, अने अरामी कुळ ना लाबान नी बेनेह हती, वेवा कर लेदो। <verse eid="GEN 25:20" /><verse number="21" style="v" sid="GEN 25:21" />ईसाक नी लाडी ते वांज्‌याण हती, एतरे ईसाक तीनी लाडी जुगु यहोवा पांह रावण्‌या कर्‌यो; अने यहोवा तीनी रावण्‌या ह़मळी लेदो, आहयी रीते तीनी लाडी रीबका भारेपोगे हयी। <verse eid="GEN 25:21" /><verse number="22" style="v" sid="GEN 25:22" />सोरा तीनी गरब मे आह़फा चोटाय्‌न एक बीजा ने देवा बाज ज्‌या। ता तीहयी केदी, “मारी जे आसमेत हालत रेहे ता मे कीसम जीवत्‌लो रेही?” अने तीहयी यहोवा मरजी पुछवा जी।<verse eid="GEN 25:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 25:23" />तत्‌यार यहोवा तीने केदो, “तारा गरब मे बे जाती से, अने तारी कोख गेथा नीकळतेत बे राज्‌य ना माणहु अलग हयहे, अने एक राज्‌य ना माणहु बीजा सी जादा सक्‌ती वाळा हयहे अने मोट्‌लो सोरो नान्‌ला ना हक मे हयहे।”<note caller="+" style="x"><char style="xo" closed="false">25:23 </char><char style="xt" closed="false"><ref loc="ROM 9:12">रोमीयो 9:12</ref></char></note><verse eid="GEN 25:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 25:24" />जत्‌यार तीना सोरा पयदा हयवा नी टेम आवी, ता ह़ु उजन्‌तु हयु, के तीना गरब मे जोवळ्‌या सोरा से। <verse eid="GEN 25:24" /><verse number="25" style="v" sid="GEN 25:25" />पेलो जे पयदा हयो तीहयो रात्‌लो नीकळ्‌यो, अने तीनु आखु डील चादरान तेम रुह वाळु हतु; एतरे तीनु नाम एसाव पाड़्‌या। <verse eid="GEN 25:25" /><verse number="26" style="v" sid="GEN 25:26" />पछळ तीनो भाय आह़फा ना हात सी एसाव ना पोग नो पोट धरीन पयदा हयो; अने तीनु नाम याकुब पाड़्‌या। जत्‌यार रीबका तीमने पयदा करी ता ईसाक<note caller="+" style="f"><char style="fr" closed="false">25:26 </char><char style="fq" closed="false">ईसाक </char><char style="ft" closed="false">बीजा ने सेटो करीन हक राखवा वाळो</char></note> साट साल नो हतो।<verse eid="GEN 25:26" /></para>
  <para style="s">एसाव नी लारे पेलो हयवा नो हक वेचणु</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 25:27" />अळतेण सोरा मोटा हयवा बाज ज्‌या अने एसाव ते बड़ा मे रेवा वाळो एक हुस्‌यार सीकारी बण्‌यो, पण याकुब ह़ुदलो माणेह हतो, अने तम्‌बु मे रेतो हतो। <verse eid="GEN 25:27" /><verse number="28" style="v" sid="GEN 25:28" />ईसाक एसाव ना सीकार नु माह खाया करतो हतो, एतरे तीहयो तीने मोंग करतो हतो; पण रीबका याकुब ने मोंग करती हती।<verse eid="GEN 25:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 25:29" />एक दाड़े याकुब खावा करीन थोड़ीक दाळ रांदतो हतो; अने एसाव बड़ा मे गेथो थाकलो आयो। <verse eid="GEN 25:29" /><verse number="30" style="v" sid="GEN 25:30" />ता एसाव याकुब ने केदो, “ह़ेली जे रात्‌ली चीज से, तीहयी चीज मे गेथु मने कंय खवाड़, काहाके मे थाकलो से।” आहया कारण तीनु नाम एदोम बी पड़्‌यु।<verse eid="GEN 25:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 25:31" />याकुब केदो, “तारो पेल्‌लो हयवा नो हक आज मारा हात मे वेच दे।”<verse eid="GEN 25:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 25:32" />एसाव केदो, “देख, मे ते हाव मरवा पोर से एतरे पेल्‌लो हयवा सी मारो ह़ु फायदो हयहे?”<verse eid="GEN 25:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 25:33" />याकुब केदो, “मार सी हमणे ह़ाम खा,” ता: तीहयो तीनी सी ह़ाम खादो, अने आह़फा नो मोट्‌लो हयवा नो हक याकुब ना हात मे वेच देदो।<note caller="+" style="x"><char style="xo" closed="false">25:33 </char><char style="xt" closed="false"><ref loc="HEB 12:16">ईब्‌रानीयो 12:16</ref></char></note> <verse eid="GEN 25:33" /><verse number="34" style="v" sid="GEN 25:34" />आनी पोर याकुब एसाव ने रोटा अने रांदली मसुर नी दाळ आप्‌यो; अने तीहयो खादो पीदो, ता उठीन जत र्‌यो। आहयी रीते एसाव आह़फा नो पेल्‌लो हयवा नो हक कंय नी ह़मज्‌यो।<verse eid="GEN 25:34" /></para>
  <chapter eid="GEN 25" />
  <chapter number="26" style="c" sid="GEN 26" />
  <para style="s">ईसाक नु गरार मे रेणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 26:1" />तीहया देस मे काळ पड़्‌यो, आहयो तीहया पेल्‌ला काळ गेथो अलग हतो जे अब्‌राहम ना दाड़ा मे पड़लो हतो। एतरे ईसाक गरार ना पलीस्‌तीयो ना राजा अबीमेलेक नी तां ज्‌यो। <verse eid="GEN 26:1" /><verse number="2" style="v" sid="GEN 26:2" />तां यहोवा तीने दरसन आपीन केदो, “मीस्‌र मे ना जाय; जे देस मे तने देखाड़ही तीहया देस मे रेजे। <verse eid="GEN 26:2" /><verse number="3" style="v" sid="GEN 26:3" />तु आहया देस मे रे, अने मे तारी ह़ाते रेही, अने तने बरकत आलही; अने आहया आखा देस मे तने अने तारी अवल्‌यात ने आपही; अने जे ह़ाम ने तारा बाह अब्‌राहम ह़ाते खादलो हतो, तीने मे पुरी करही।<note caller="+" style="x"><char style="xo" closed="false">26:3 </char><char style="xt" closed="false"><ref loc="GEN 22:16">उबजणाय कीताप 22:16</ref>,<ref loc="GEN 22:18">18</ref></char></note> <verse eid="GEN 26:3" /><verse number="4" style="v" sid="GEN 26:4" />मे तारी अवल्‌यात ने ह़रग ना तारान तेम बड़ावही; अने मे तारी अवल्‌यात ने आहया आखा देस आपही, अने धरती पोर ना आखा माणहु तारी अवल्‌यात ना कारण आह़फाम ने जुगाळा मानहे। <verse eid="GEN 26:4" /><verse number="5" style="v" sid="GEN 26:5" />काहाके अब्‌राहम मारी मान्‌यो, अने जे मे तीने ह़ोपलो हतो तीने अने मारा हुकम, रीती अने कायदा नो पालन कर्‌यो।”<verse eid="GEN 26:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 26:6" />एतरे ईसाक गरार मे री ज्‌यो। <verse eid="GEN 26:6" /><verse number="7" style="v" sid="GEN 26:7" />जत्‌यार तां वाळा माणहु तीनी लाडी ना बारा मे पुछ्‌या, ता तीहयो आहयु सोचीन बीहतो हतो के कदी मे हीने मारी लाडी केही ता आञे वाळा माणहु रीबका ना कारण जे घणी घटाळी से मने मार नाक्‌खे, ता तीहयो जपाप आप्‌यो, “तीहयी ते मारी बेनेह से।”<note caller="+" style="x"><char style="xo" closed="false">26:7 </char><char style="xt" closed="false"><ref loc="GEN 12:13">उबजणाय कीताप 12:13</ref>; <ref loc="GEN 20:2">20:2</ref></char></note> <verse eid="GEN 26:7" /><verse number="8" style="v" sid="GEN 26:8" />जत्‌यार तीने तां रेत्‌लो ढेरेत दाड़ा वीत ज्‌या, ता एक दाड़ो पलीस्‌तीयो नो राजा अबीमेलेक खीड़की मे सी छापीन ह़ु देख्‌यो के ईसाक आह़फी लाडी रीबका ह़ाते मोंग करवा बाज र्‌यो। <verse eid="GEN 26:8" /><verse number="9" style="v" sid="GEN 26:9" />तत्‌यार अबीमेलेक ईसाक ने बोलावीन केदो, “ह़ेली ते पक्‌की तारी लाडी से; ता तु ह़ु का तीने तारी बेनेह केदो?” ईसाक जपाप आप्‌यो, “मे वीच्‌यार करलो हतो के आसम नी हये के हीना कारण मारी मोत हये।”<verse eid="GEN 26:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 26:10" />“अबीमेलेक केदो, तु अमारी ह़ाते आहयु ह़ु कर्‌यो? ईसम ते माणहु मे कोय बी तारी लाडी ह़ाते आराम सी गलत काम कर सके, अने तु आमने पाप मे फसाड़े।” <verse eid="GEN 26:10" /><verse number="11" style="v" sid="GEN 26:11" />एतरे अबीमेलेक आह़फा ना आखा माणहु ने हुकम आप्‌यो, “जे कोय ह़ेला माणेह ने नीता ह़ेली बयर ने छीमहे, तीने पक्‌को मार नाक्‌खे।”<verse eid="GEN 26:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 26:12" />अळतेण ईसाक तीहया देस मे खेतर मे अनाज वेर्‌यो, अने तीहया साल मे ह़ोव गुणा मेर पाकी; अने यहोवा तीने बरकत आप्‌यो, <verse eid="GEN 26:12" /><verse number="13" style="v" sid="GEN 26:13" />अने तीनु धन वद्‌यु अने तीनी बड़ोत्‌री हयती जत री, आञे तक के तीहयो घणो मोटो माणेह बण ज्‌यो। <verse eid="GEN 26:13" /><verse number="14" style="v" sid="GEN 26:14" />जत्‌यार तीना गाडरा-बोकड़ा, गाय-बोळद्‌या, अने ढेरेत पावर-पावर्‌याण हयी; ता पलीस्‌ती माणहु तीनी ह़ाते डहवाय करवा बाज ज्‌या। <verse eid="GEN 26:14" /><verse number="15" style="v" sid="GEN 26:15" />एतरे जेतरा कुवा तीना बाह अब्‌राहम ना पावर्‌या अब्‌राहम ने जीवत्‌लो रेते खोदला हता, तीमने पलीस्‌ती कादा सी भर देदा।<verse eid="GEN 26:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 26:16" />ता अबीमेलेक ईसाक ने केदो, “अमारी ह़ाते गेथो जत रे; काहाके तु अमारी गेथो जादा पोमतो हय ज्‌यो।” <verse eid="GEN 26:16" /><verse number="17" style="v" sid="GEN 26:17" />एतरे ईसाक तां गेथो जत र्‌यो, अने गरार ना बड़ा मे आह़फा नु तम्‌बु उबो करीन रेवा बाज ज्‌यो। <verse eid="GEN 26:17" /><verse number="18" style="v" sid="GEN 26:18" />तत्‌यार जे कुवा तीना बाह अब्‌राहम ना मरवान अळतेण पलीस्‌ती भर देदला हता, तीमने ईसाक अळी खोदाड़्‌यो; अने तीमना तेत नाम पाड़्‌यो, जे तीनो बाह पाड़लो हतो।<verse eid="GEN 26:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 26:19" />अळतेण ईसाक ना पावर्‌याम ने बड़ा मे खोदते-खोदते वयत्‌लु पाणी नो एक कुवो जड़्‌यो। <verse eid="GEN 26:19" /><verse number="20" style="v" sid="GEN 26:20" />ता गरार ना गुवाळ्‌या ईसाक ना गुवाळ्‌या ह़ाते झगड़ो कर्‌या अने केदा, “आहयु पाणी अमारु से।” एतरे ईसाक तीहया कुवा नु नाम एसेक<note caller="+" style="f"><char style="fr" closed="false">26:20 </char><char style="fq" closed="false">एसेक </char><char style="ft" closed="false">झगड़ा नो</char></note> पाड़्‌यो; काहाके तीहया तीनी ह़ाते झुमायता हता।<verse eid="GEN 26:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 26:21" />अळतेण तीहया बीजो कुवो खोद्‌या, अने तीहया तीनी लेदे बी झगड़ो कर्‌या; एतरे ईसाक तीनु नाम सीत्‌रा<note caller="+" style="f"><char style="fr" closed="false">26:21 </char><char style="fq" closed="false">सीत्‌रा </char><char style="ft" closed="false">वीरोदी नो</char></note> पाड़्‌यो। <verse eid="GEN 26:21" /><verse number="22" style="v" sid="GEN 26:22" />ता तीहयो तां गेथो नीकळीन एक अळी कुवो खोदाड़्‌यो अने तीनी जुगु तीहया झगड़ो नी कर्‌या; एतरे तीहयो तीनु नाम आहयु कीन रहोबोत<note caller="+" style="f"><char style="fr" closed="false">26:22 </char><char style="fq" closed="false">रहोबोत </char><char style="ft" closed="false">चवड़ो जागो</char></note> पाड़्‌यो, “हाव ते यहोवा अमारी जुगु ढेरेत जागो आपलो से, अने आमु आहया देस मे वदता-बड़ता जहु।”<verse eid="GEN 26:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 26:23" />तां गेथो ईसाक बेर्‌सेबा ज्‌यो। <verse eid="GEN 26:23" /><verse number="24" style="v" sid="GEN 26:24" />अने तेत दाड़े यहोवा राते तीने दरसन दीन केदो, “मे तारा बाह अब्‌राहम नो भगवान से, ना बीहे, काहाके मे तार ह़ाते से, अने मारा पावर्‌या अब्‌राहम ना कारण तने बरकत आपही, अने तारी अवल्‌यात ने बड़ावही।” <verse eid="GEN 26:24" /><verse number="25" style="v" sid="GEN 26:25" />ता तीहयो तां एक वेदी बणायो, अने यहोवा नी बड़ाय कर्‌यो, अने आह़फा नु तम्‌बु तांत उबो कर्‌यो; अने तां ईसाक ना पावर्‌या एक कुवो खोद्‌या।<verse eid="GEN 26:25" /></para>
  <para style="s">ईसाक अने अबीमेलेक नी वचे वायदो</para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 26:26" />तत्‌यार अबीमेलेक आह़फा ना मंतरी अहुज्‌जत अने आह़फा ना सेना ना डायला पीकोल ने ह़ाते लीन, गरार गेथो तीनीन तां ज्‌यो।<note caller="+" style="x"><char style="xo" closed="false">26:26 </char><char style="xt" closed="false"><ref loc="GEN 21:22">उबजणाय कीताप 21:22</ref></char></note> <verse eid="GEN 26:26" /><verse number="27" style="v" sid="GEN 26:27" />ईसाक तीने केदो, “तमु मार ह़ाते झगड़ो करीन आह़फाम नी वचमे गेथा नीकाळ देदला हता, हाव मारीन्‌तां ह़ुका आय र्‌या।”<verse eid="GEN 26:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 26:28" />तीहया केदा, “आमु ते चोखुझण देखला से के यहोवा तार ह़ाते रेय; एतरे आमु वीच्‌यार कर्‌या के तु ते यहोवा भणी गेथो जुगाळो से, एतरे: अमारी अने तारी वच मे ह़ाम खावो, अने आमु तार पांह आना बारा मे वायदो करावया, <verse eid="GEN 26:28" /><verse number="29" style="v" sid="GEN 26:29" />के जीसम आमु तने नी छीम्‌या, पण तारी ह़ाते नीस्‌ती भलायेत करला से, अने तने सांती सी वळावणी कर्‌या, तीनी लारे तु बी अमारी ह़ाते कंय बुराय नी करजे; हाव तु मालीक नी बरकत हात करलो माणेह से।” <verse eid="GEN 26:29" /><verse number="30" style="v" sid="GEN 26:30" />तत्‌यार तीहयो तीमने खाणु आप्‌यो अने तीहया खादा-पीदा। <verse eid="GEN 26:30" /><verse number="31" style="v" sid="GEN 26:31" />ह़वारे तीहया आखा वेगात उठीन एक बीजा ह़ाते ह़ाम खादा; तत्‌यार ईसाक तीमने वळायो, अने तीहया सांती सी तीमनीन्‌तां गेथा जत र्‌या।<verse eid="GEN 26:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 26:32" />तेत दाड़े ईसाक ना पावर्‌या आवीन आपणा तीहया खोदला कुवा ना बारा मे ह़मळावीन केदा, “आमु ने पाणी नो एक झोर जड़लो से।” <verse eid="GEN 26:32" /><verse number="33" style="v" sid="GEN 26:33" />तत्‌यार ईसाक तीनु नाम सीबा<note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="fq" closed="false">सीबा </char><char style="ft" closed="false">ह़ाम</char></note> पाड़्‌यो; आहयात कारण सी तीहया ह़ेर नु नाम आज तक बेर्‌सेबा <note caller="+" style="f"><char style="fr" closed="false">26:33 </char><char style="fq" closed="false">बेर्‌सेबा </char><char style="ft" closed="false">ह़ाम नो कुवो</char></note>पड़लु से।<verse eid="GEN 26:33" /></para>
  <para style="s">एसाव ना बीजा देस ना लाड्‌या</para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 26:34" />जत्‌यार एसाव चाळीह साल नो हयो, ता तीहयो हीत्‌ती बेरी नी सोरी यहुदीत, अने हीत्‌ती एलोन नी सोरी बासमत ह़ाते वेवा कर लेदो; <verse eid="GEN 26:34" /><verse number="35" style="v" sid="GEN 26:35" />अने आहया बयराम ना कारण सी ईसाक अने रीबका ना मन ने दुख लाग्‌यु।<verse eid="GEN 26:35" /></para>
  <chapter eid="GEN 26" />
  <chapter number="27" style="c" sid="GEN 27" />
  <para style="s">ईसाक नु याकुब ने बरकत आपणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 27:1" />जत्‌यार ईसाक डायो हय ज्‌यो, अने तीना डोळा आसम धुंदळा पड़ ज्‌या के तीने देखायतु नी हतु, तत्‌यार तीहयो तीना मोट्‌ला सोरा एसाव ने बोलावीन केदो, “ए मारा सोरा एसाव,” एसाव जपाप आप्‌यो, “बाह, ह़ु वात से।”<verse eid="GEN 27:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 27:2" />तीहयो केदो, “ह़मळ, मे डायो हय जेलो से, अने नी जाणतो के मारी मोत नो दाड़ो कत्‌यार हयहे: <verse eid="GEN 27:2" /><verse number="3" style="v" sid="GEN 27:3" />एतरे हाव तु तारी धंदली अने बीलखी लीन बड़ा मे जा, अने मार जुगु सीकार करीन लाव। <verse eid="GEN 27:3" /><verse number="4" style="v" sid="GEN 27:4" />तत्‌यार मने गमे एवु ह़वादु खाणु बणावीन मारीन्‌तां ली आवजे, के मे तीने खाय्‌न मरवा सी पेले जीव भरीन बरकत आपु।”<verse eid="GEN 27:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 27:5" />तत्‌यार एसाव सीकार करवा करीन बड़ा मे ज्‌यो। जत्‌यार ईसाक एसाव ह़ाते आहयी वात करवा बाज र्‌यो हतो, तत्‌यार रीबका ह़मळवा बाज री हती। <verse eid="GEN 27:5" /><verse number="6" style="v" sid="GEN 27:6" />एतरे तीहयी आह़फा ना सोरा याकुब ने केदी, “ह़मळ, मे तारा बाह ने तारा भाय एसाव ने आहयु केते ह़मळली से <verse eid="GEN 27:6" /><verse number="7" style="v" sid="GEN 27:7" />तु मारी जुगु सीकार करीन तीनु ह़वादु खाणु बणाव, के तीने खाय्‌न अने मरवा सी पेले यहोवा नी अगळ तने बरकत आलु। <verse eid="GEN 27:7" /><verse number="8" style="v" sid="GEN 27:8" />एतरे हाव, ए मारा सोरा, मारी वात ह़मळ, अने आहयो हुकम मान, <verse eid="GEN 27:8" /><verse number="9" style="v" sid="GEN 27:9" />के तु बोकड़ा ना वाड़ा मे जा अने बोकड़ा ना वारु-वारु बे बच्‌चा लीन आव; अने मे तारा बाह जुगु तीनु गमतु बच्‌चा नु माह नु खाणु रांदही। <verse eid="GEN 27:9" /><verse number="10" style="v" sid="GEN 27:10" />तत्‌यार तु तीने तारा बाह ने ता लीज्‌जे, के तीहयो तीने खाय्‌न मरवा सी पेले तने बरकत आले।”<verse eid="GEN 27:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 27:11" />याकुब आह़फा नी आह्‌य रीबका ने केदो, “ह़मळ, मारो भाय एसाव ते रुह वाळो माणेह से, अने मे रुह वाळो माणेह नी हय। <verse eid="GEN 27:11" /><verse number="12" style="v" sid="GEN 27:12" />कदीम मारो बाह मने पुपाळहे, ता मे तीनी नींगा मे झुटो ठेरही; अने संयबरकत नी बदले सराप कमायही।”<verse eid="GEN 27:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 27:13" />तीनी आह्‌य तीने केदी, “ए मारा सोरा, सराप तारी पोर नी पण मारी पोर पड़े, तु मारीत मारी ह़मळ, अने जाय्‌न ह़ेला बच्‌चा मारी पांह लीन आव।” <verse eid="GEN 27:13" /><verse number="14" style="v" sid="GEN 27:14" />तत्‌यार याकुब जाय्‌न गाडरु आह़फा नी आह्‌य ने तां ली आयो, अने आह्‌य तीना बाह ने गमे तीनी लारे ह़वादु खाणु बणाय देदी। <verse eid="GEN 27:14" /><verse number="15" style="v" sid="GEN 27:15" />तत्‌यार रीबका आह़फा ना पेल्‌ला सोरा एसाव ना घटाळा लुगड़ा, जे तीनी पांह घोर मे हता, लावीन तीना नान्‌ला सोरा याकुब ने पेराय देदी; <verse eid="GEN 27:15" /><verse number="16" style="v" sid="GEN 27:16" />अने बोकड़ा ना बच्‌चा नी खालु ने तीना हातु मे अने तीना गळा मे वीटाळ देदी; <verse eid="GEN 27:16" /><verse number="17" style="v" sid="GEN 27:17" />अने तीहयु ह़वादु खाणु अने तीना रांदला रोट्‌ला बी आह़फा ना सोरा याकुब ना हात मे आप देदी।<verse eid="GEN 27:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 27:18" />तत्‌यार तीहयो आह़फा ना बाह ने तां ज्‌यो अने केदो, “ए मारा बाह,” तीहयो केदो, “ह़ु वात से? ए मारा सोरा, तु कोय से?”<verse eid="GEN 27:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 27:19" />याकुब आह़फा ना बाह ने केदो, मे तारो मोट्‌लो सोरो एसाव से। मे तारा हुकम नी लारे करलो से; एतरे उठ अने मारा सीकार ना माह मे गेथु खा, के तु तारी पुरा मन सी मने बरकत आले।<verse eid="GEN 27:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 27:20" />ईसाक आह़फा ना सोरा ने केदो, “ए मारा सोरा, ह़ु कारण से के सीकार तने साटोत जड़ ज्‌यो?” तीहयो जपाप आप्‌यो, “तारो भगवान यहोवा तीने मारी अगळ कर देदो।”<verse eid="GEN 27:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 27:21" />अळी ईसाक याकुब ने केदो, “ए मारा सोरा, ह़ाते आव, मे तने पुपाळीन जाणु के तु ह़ाचलीन मारो सोरो एसाव से के नी।” <verse eid="GEN 27:21" /><verse number="22" style="v" sid="GEN 27:22" />तत्‌यार याकुब आह़फा ना बाह ईसाक नी ह़ाते ज्‌यो, अने तीनो बाह तीने पुपाळीन केदो, “तारु बोल ते याकुब नी तेवो से, पण तारा हात ते एसाव ना हात नी तेवात से।” <verse eid="GEN 27:22" /><verse number="23" style="v" sid="GEN 27:23" />अने तीहयो तीने नी ओळख्‌यो, काहाके तीना हात तीना भाय एसाव ने तेवा रुह वाळा हता; एतरे तीहयो तीने बरकत आल्‌यो। <verse eid="GEN 27:23" /><verse number="24" style="v" sid="GEN 27:24" />अने तीहयो पुछ्‌यो, “ह़ु तु ह़ाचलीन मारो सोरो एसाव से?” तीहयो केदो, “होव, मेत से।”<verse eid="GEN 27:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 27:25" />तत्‌यार ईसाक ने केदो, “खाणु मने खावा आप, मे मारा सोरा ना सीकार ना माह मे गेथु खाय्‌न, तने मारा पुरा मन सी बरकत आपु।” ता तीहयो तीने खाणु खावा आप्‌यो, अने तीहयो खादो; अने तीहयो तीनीन्‌तां अंगुर नो रोह बी लायो, अने तीहयो पीदो। <verse eid="GEN 27:25" /><verse number="26" style="v" sid="GEN 27:26" />तत्‌यार तीनो बाह ईसाक तीने केदो, “ए मारा सोरा, ह़ाते आवीन मने गोळो आप।” <verse eid="GEN 27:26" /><verse number="27" style="v" sid="GEN 27:27" />तीहयो ह़ाते जाय्‌न तीने गोळो देदो; अने तीहयो तीना लुगड़ा नी गंद गंदीन तीने आहयी बरकत आप्‌यो, “देख, सोरा नी गंद जे आसवा खेतर नी से जीनी पोर यहोवा संयबरकत आपलो हय; <verse eid="GEN 27:27" /><verse number="28" style="v" sid="GEN 27:28" />भगवान तने ह़रग सी धुवरु, अने धरती नी वारु सी वारु मेर अने ढेरेत दाणा अने नवलो अंगुर नो रोह आपे। <verse eid="GEN 27:28" /><verse number="29" style="v" sid="GEN 27:29" />राज्‌य-राज्‌य ना माणहु तारा हक मे हय, अने देस-देस ना माणहु तने वांद्‌या करे। तु आह़फा ना भायु नो मालीक हये, अने तारी आय्‌ह ना सोरा तने वांद्‌या करे। जे तने सराप आपे तीहया आह़फात सरापीत हये, अने जे तने बरकत आपे तीहया संयबरकत हात करे।”<note caller="+" style="x"><char style="xo" closed="false">27:29 </char><char style="xt" closed="false"><ref loc="GEN 12:3">उबजणाय कीताप 12:3</ref></char></note><verse eid="GEN 27:29" /></para>
  <para style="s">बरकत नी लेदे एसाव ना रावण्‌या</para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 27:30" />जेमेत आहयी बरकत ईसाक याकुब ने आप देदो, अने याकुब आह़फा ना बाह ईसाक नी अगळ गेथो नीकळ्‌ळोत हतो के एसाव सीकार लीन आय पुग्‌यो। <verse eid="GEN 27:30" /><verse number="31" style="v" sid="GEN 27:31" />तत्‌यार तीहयो बी ह़वादु खाणु बणावीन आह़फा ना बाह ने तां ली आयो, अने तीने केदो, “ए मारा बाह, उठीन आह़फा ना सोरा नु सीकार नु माह खा, काहाके मने तारा पुरा मन सी बरकत आपे।”<verse eid="GEN 27:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="GEN 27:32" />“तीनो बाह ईसाक पुछ्‌यो, तु कोय से?” तीहयो केदो, “मे तारो मोट्लो सोरो एसाव से।”<verse eid="GEN 27:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 27:33" />तत्‌यार ईसाक घणो थर-थर कापतो जीन केदो, “ता तीहयो कोय हतो जे सीकार करीन मारी पांह लीन आवलो हतो, अने मे तने आव्‌वा पेले आखु मे गेथु कंय-कंय खाय लेदो अने तीने बरकत आप्‌यो? हाव तीने संयबरकत लागली बी रेहे।”<verse eid="GEN 27:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 27:34" />आह़फा ना बाह नी आहयी वात ह़मळतेत एसाव घणो ज्‌योरेत अने दुखी हय्‌न आड़ीन आह़फा ना बाह ने केदो, “ए मारा बाह, मने बी बरकत आप।”<verse eid="GEN 27:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 27:35" />ईसाक केदो, “तारो भाय चलाकी सी आयो, अने तारी बरकत ने लीन जत र्‌यो।”<verse eid="GEN 27:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 27:36" />एसाव केदो, “ह़ु तीनु नाम याकुब वारुत पाड़लु हतु? तीहयो मने बे कावा रोक लगाड़्‌यो। मारो पेल्‌लो हयवा नो हक ते लीत लेदलो हतो; अने हाव देख, तीहयो मारी बरकत बी ली लेदलो से। अळी तीहयो केदो, ह़ु तु मारी लेदे बी कंय बरकत बचाड़ीन नी राख्‌यो?”<verse eid="GEN 27:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 27:37" />ईसाक एसाव ने जपाप आपीन केदो, “ह़मळ, मे तीने तारो मालीक ठेरावलो से, अने अळतेण आखा भायु ने तीना हक मे कर देदो, अने दाणा अने नवलो अंगुर नो रोह आपीन तीने पक्‌को बणाय देदलो से। एतरे हाव, ए मारा सोरा, मे तारी जुगु ह़ु करु?”<verse eid="GEN 27:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 27:38" />एसाव आह़फा ना बाह ने केदो, “ए मारा बाह, ह़ु तारा मन मे एकीत बरकत से? ए मारा बाह, मने बी बरकत आप,” अने आसम कीन कल्‌पी-कल्‌पीन रड़वा बाज ज्‌यो।<note caller="+" style="x"><char style="xo" closed="false">27:38 </char><char style="xt" closed="false"><ref loc="HEB 12:17">ईब्‌रानीयो 12:17</ref></char></note><verse eid="GEN 27:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="GEN 27:39" />तीनो बाह ईसाक तीने केदो, “ह़मळ, तारु रेणु मेर वाळी जागा सी नाम्‌बे हय, अने उपर गेथी ह़रग नी धुवरी तीनी पोर नी पड़े। <verse eid="GEN 27:39" /><verse number="40" style="v" sid="GEN 27:40" />तु तारी तलवार नी ताखत सी जीवत्‌लो रेही, अने आह़फा ना भाय ना हक मे ते रेय; पण जत्‌यार तु तारा भाय ना हक मे गेथो छुटवा झुमायही, ता तीना वळा ने आह़फा ना खांदा पोर गेथो तोड़ नाखे।”<note caller="+" style="x"><char style="xo" closed="false">27:40 </char><char style="xt" closed="false"><ref loc="GEN 36:8">उबजणाय कीताप 36:8</ref>; <ref loc="2KI 8:20">2 राजा 8:20</ref></char></note><verse eid="GEN 27:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 27:41" />एसाव याकुब सी आह़फा ना बाह नी लारे आपला बरकत ना कारण दुस्‌मनी राख्‌यो; अने तीहयो सोच्‌यो, “मारा बाह ना मरवा ना दाड़ा ह़ातेत से, बाद मे मारा भाय याकुब ने मारही।”<verse eid="GEN 27:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="GEN 27:42" />जत्‌यार रीबका ने तीना पेला सोरा एसाव नी आहयी वात मालम पड़ी, तत्‌यार तीहयी आह़फा ना नान्‌ला सोरा याकुब ने बोलावीन केदी, “ह़मळ, तारो भाय एसाव तने मारवा करीन आह़फा ना मन मे ठान र्‌यो। <verse eid="GEN 27:42" /><verse number="43" style="v" sid="GEN 27:43" />एतरे हाव, ए मारा सोरा ह़मळ, अने हारान मे मारा भाय लाबान ने तां नाह जा; <verse eid="GEN 27:43" /><verse number="44" style="v" sid="GEN 27:44" />अने थोड़ाक दाड़ा तक तारा भाय नी रीह नी ओलाये तांह तक तीनीन तां रेजे। <verse eid="GEN 27:44" /><verse number="45" style="v" sid="GEN 27:45" />अळतेण जत्‌यार तारा भाय नी रीह तार पोर सी उतरे, अने जे काम तु तीनी ह़ाते करलो से तीहयो तीने भुल जाय; तत्‌यार मे तने तां गेथो बोलाव्‌वा मोकलही। ईसम ह़ुका हये के एकीत दाड़े मे तमु बेम जणा ने खोय देम?”<verse eid="GEN 27:45" /></para>
  <para style="s">याकुब नु लाबान ने तां जाणु</para>
  <para style="p">
    <verse number="46" style="v" sid="GEN 27:46" />अळतेण रीबका ईसाक ने केदी, “हीत्‌ती जाती नी ववेह नी करते मारो जीव घबराय ज्‌यो; कदी याकुब बी आहयी ववेह ने तेम आहया देस नी कानी हीत्‌ती जाती नी सोरी सी वेवा कर लेय ता मने आहया जीवाय सी ह़ु फायदो? मे मर जही।”<verse eid="GEN 27:46" /></para>
  <chapter eid="GEN 27" />
  <chapter number="28" style="c" sid="GEN 28" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 28:1" />तत्‌यार ईसाक याकुब ने बोलावीन बरकत आप्‌यो, अने हुकम आप्‌यो, “तु कानी कनानी सोरी ह़ाते वेवा नी करजे। <verse eid="GEN 28:1" /><verse number="2" style="v" sid="GEN 28:2" />पदनराम<note caller="+" style="f"><char style="fr" closed="false">28:2 </char><char style="fq" closed="false">पदनराम </char><char style="ft" closed="false">मेसोपोटामीया</char></note> मे तारा डायला बाह बतुएल ना घोर जीन, तां आह़फा ना मामा लाबान नी सोरी ह़ाते वेवा कर लेजे। <verse eid="GEN 28:2" /><verse number="3" style="v" sid="GEN 28:3" />आखा मे जोर-भर्‌यो भगवान तने संयबरकत आपे, अने तारा सोरा बड़ता जाय, अने तु राज्‌य-राज्‌य नी मंडळी नो मुख्‌यो हये। <verse eid="GEN 28:3" /><verse number="4" style="v" sid="GEN 28:4" />तीहयो तने अने तारी अवल्‌यात ने बी अब्‌राहम ने तेम संयबरकत आले, के तु आहया देस जीनी मे तु परदेसी हय्‌न रेय, अने जीने भगवान अब्‌राहम ने आपलो हतो, तीनो अदीकारी हय जाय।”<note caller="+" style="x"><char style="xo" closed="false">28:4 </char><char style="xt" closed="false"><ref loc="GEN 17:4-8">उबजणाय कीताप 17:4-8</ref></char></note> <verse eid="GEN 28:4" /><verse number="5" style="v" sid="GEN 28:5" />अने ईसाक याकुब ने वळायो, अने तीहयो पदनराम ने अरामी बतुएल ना सोरा लाबान ने तां जत र्‌यो, जे याकुब अने एसाव नी आह्‌य रीबका ना भाय हतो।<verse eid="GEN 28:5" /></para>
  <para style="s">एसाव ना एक अळी वेवा</para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 28:6" />एसाव देख्‌यो के ईसाक याकुब ने बरकत आपीन पदनराम एलाका मे मोकल्‌यो, के तीहयो तां गेथी लाडी लावे, अने तीने बरकत आपवा नी टेमे आहयो हुकम बी आप्‌यो, “तु कानी कनानी सोरी ह़ाते वेवा नी कर लेजे,” <verse eid="GEN 28:6" /><verse number="7" style="v" sid="GEN 28:7" />अने याकुब आह्‌य-बाह नी मानीन पदनराम एलाका भणी चाल देदो। <verse eid="GEN 28:7" /><verse number="8" style="v" sid="GEN 28:8" />तत्‌यार एसाव आहयु आखु देखीन अने आहयु बी सोचीन के कनानी सोर्‌या मारा बाह ईसाक ने बुरी लागे, <verse eid="GEN 28:8" /><verse number="9" style="v" sid="GEN 28:9" />अब्‌राहम ना सोरा ईस्‌माएल ने तां ज्‌यो, अने ईस्‌माएल नी सोरी महलत ने, जे नबायोत नी बेनेह हती, वेवा करीन आह़फा नी लाडीम नी मे भेसकी लेदो।<verse eid="GEN 28:9" /></para>
  <para style="s">बेतेल मे याकुब नु ह़पनु</para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 28:10" />याकुब बेर्‌सेबा गेथो नीकळीन हारान भणी चाल्‌यो। <verse eid="GEN 28:10" /><verse number="11" style="v" sid="GEN 28:11" />अने तीहयो काना जागा मे पुगीन रात तांत रेवा नो वीच्‌यार कर्‌यो, काहाके दाड़ु डुब जेलु हतु; एतरे तीहयो ते जागा मे दगड़ा मे नो एक दगड़ो लीन आह़फा नु तक्‌यु बणावीन मेक्‌यो, अने तीहया जागा मे ह़ुय ज्‌यो। <verse eid="GEN 28:11" /><verse number="12" style="v" sid="GEN 28:12" />ता तीहयो ह़पनु मे ह़ु देख्‌यो, के एक नीहरण धरती पोर उबी हय री, अने तीनो सीरो ह़रग लग पुगलो से; अने भगवान ना दुत तीनी पोर गेथा चड़े-उतरे।<note caller="+" style="x"><char style="xo" closed="false">28:12 </char><char style="xt" closed="false"><ref loc="JHN 1:51">युहन्‌ना 1:51</ref></char></note> <verse eid="GEN 28:12" /><verse number="13" style="v" sid="GEN 28:13" />अने यहोवा तीनी पोर उबो हय्‌न केय, “मे यहोवा, तारा डायला बाह अब्‌राहम नो भगवान, अने ईसाक नो बी भगवान से; जे जागा पोर तु ह़ुय र्‌यो, तीने मे तने अने तारी अवल्‌यात ने आपही।<note caller="+" style="x"><char style="xo" closed="false">28:13 </char><char style="xt" closed="false"><ref loc="GEN 13:14">उबजणाय कीताप 13:14</ref>,<ref loc="GEN 13:15">15</ref></char></note> <verse eid="GEN 28:13" /><verse number="14" style="v" sid="GEN 28:14" />अने तारी अवल्‌यात धरती ना कादा नु कचरुन तेम ढेरेत हयहे। अने उगण बुडण, दखणाव, धुराव, च्‌यारो-मेर फेलती जहे: अने तारी अवल्‌यात नी लारे धरती ना आखा कुळ संयबरकत ह़ात करहे।<note caller="+" style="x"><char style="xo" closed="false">28:14 </char><char style="xt" closed="false"><ref loc="GEN 12:3">उबजणाय कीताप 12:3</ref>; <ref loc="GEN 22:18">22:18</ref></char></note> <verse eid="GEN 28:14" /><verse number="15" style="v" sid="GEN 28:15" />अने ह़मळ मे तार ह़ाते रेही, अने जां कंय तु जाय तां तारी रखवाळी करही, अने तने आहया देस मे पाछो लावही: मे मारा केदला बोलु ने जत्‌यार लग पुरो नी कर लेम तां लग तने नी छोड़ु।”<note caller="+" style="x"><char style="xo" closed="false">28:15 </char><char style="xt" closed="false"><ref loc="ISA 41:10">यसाया 41:10</ref></char></note><verse eid="GEN 28:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 28:16" />तत्‌यार याकुब जाग उठ्‌यो अने केवा बाज ज्‌यो, पक्‌को आहयी जागा मे यहोवा से; अने मे आहयी वात ने नी जाणतो हतो <verse eid="GEN 28:16" /><verse number="17" style="v" sid="GEN 28:17" />अने बीहतो जीन केदो, “आहयो जागो ह़ु ज्‌योरेत से! आहयु ते भगवान ना मंदीर ने छोड़ीन अळी कंय नी हय सके; पण आहयु ह़रग नु झापलुत हहे।”<verse eid="GEN 28:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 28:18" />ह़वारे याकुब उठ्‌यो, अने आह़फा ना तक्‌या ना दगड़ा ने लीन तीनो खम्‌बो उबो कर्‌यो, अने तीना मुंडा पोर तेल रेड़ देदो। <verse eid="GEN 28:18" /><verse number="19" style="v" sid="GEN 28:19" />तीहयो ते जागा नु नाम बेतेल<note caller="+" style="f"><char style="fr" closed="false">28:19 </char><char style="fq" closed="false">बेतेल </char><char style="ft" closed="false">भगवान नु घोर</char></note> पाड़्‌यो; पण तीहया जागा नु नाम पेले लुज हतु। <verse eid="GEN 28:19" /><verse number="20" style="v" sid="GEN 28:20" />तत्‌यार याकुब आहयी मान-बादा लेदो, “कदी भगवान मारी ह़ाते रीन आहयी यात्‌रा मे मारी रखवाळी करे, अने मने खावा नी लेदे रोट्‌ला, अने पेरवा नी लेदे लुगड़ु आपे, <verse eid="GEN 28:20" /><verse number="21" style="v" sid="GEN 28:21" />अने मे मारा बाह ना घोर सांती सी पाछो जत रेम; ता यहोवा मारो भगवान ठेरहे। <verse eid="GEN 28:21" /><verse number="22" style="v" sid="GEN 28:22" />अने आहयो दगड़ो, जीनो मे खम्‌बो उबो करलो से, भगवान नो मंदीर ठेरहे: अने जे कंय तु मने आपे तीनो दसवो वाटो मे पक्‌कोत तने आप्‌या करही।”<verse eid="GEN 28:22" /></para>
  <chapter eid="GEN 28" />
  <chapter number="29" style="c" sid="GEN 29" />
  <para style="s">याकुब नु लाबान ने भेटणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 29:1" />अळतेण याकुब आह़फा नी वाट्‌ये लाग्‌यो, अने उगवणा देस मे आयो। <verse eid="GEN 29:1" /><verse number="2" style="v" sid="GEN 29:2" />तीहयो नींगा करीन ह़ु देख्‌यो के चोवगान मे एक कुवो से, अने तीनी ह़ाते गाडरा-बोकड़ा ना तीन टोळा बह र्‌या; काहाके जे दगड़ो तीहया कुवा ना मोडा पोर मेकलो रेतो हतो, जीनी मे सी टोळाम ने पाणी पीवाड़ता हता, तीहयो भारो हतो। <verse eid="GEN 29:2" /><verse number="3" style="v" sid="GEN 29:3" />अने जत्‌यार आखा टोळा तां एक्‌ठा हय ता गुवाळ्‌या तीहया दगड़ा ने कुवा ना मोडा पोर सी ढबळावीन गाडरा-बोकड़ाम ने पाणी पीवाड़त्‌ला, अने बाद मे दगड़ा ने कुवा ना मुंडा पोर जेम हतो तेम मेल देता हता।<verse eid="GEN 29:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 29:4" />पण याकुब गुवाळ्‌या ने पुछ्‌यो, “ए मारा भायु, तमु का वाळा से?” तीहया केदा, “आमु हारान ह़ेर ना से।”<verse eid="GEN 29:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 29:5" />तत्‌यार तीहयो तीमने पुछ्‌यो, “ह़ु तमु नाहोर ना सोरा ना सोरा लाबान ने जाणो?” तीहया केदा, “होव, आमु तीने जाणया।”<verse eid="GEN 29:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 29:6" />अळतेण तीहयो तीमने पुछ्‌यो, “ह़ु तीहयो वारलो से?” तीहया केदा, “होव, वारलो से” अने ह़ेली “देख तीनी बेटी राहेल गाडरा अने बोकड़ाम ने लीन आव्‌वा बाज री।”<verse eid="GEN 29:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 29:7" />याकुब केदो, “हजु ते दाड़ु ढेरेत से, जानवरु ने एक्‌ठा हयवा नी टेम नी हय; एतरे गाडरा अने बोकड़ाम ने पाणी पीवाड़ीन अळी ली जाय्‌न चारो।”<verse eid="GEN 29:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 29:8" />तीहया केदा, “आमु हमणे ईसम नी कर सकता, जत्‌यार आखा टोळा एक्‌ठा हये ता दगड़ा ने कुवा ना मोडा पोर गेथो ढबळाय देत्‌ला से, अने तत्‌यार आमु गाडरा अने बोकड़्‌या ने पाणी पीवाड़त्‌ला।”<verse eid="GEN 29:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 29:9" />तीमनी आहयी वात हय री हती के राहेल, जे जानवरु चार्‌या करती हती, आह़फा ना बाह ना गाडरा अने बोकड़ा ने लीन आय लागी, <verse eid="GEN 29:9" /><verse number="10" style="v" sid="GEN 29:10" />याकुब आह़फा ना मामा लाबान नी सोरी राहेल ने, अने तीना गाडरा-बोकड़ा ने देखीन कुवा नी ह़ाते ज्‌यो, अने तीना मोडा पोर मेकला मोट्‌ला दगड़ा ने ढबळाय देदो अने आह़फा ना मामा लाबान ना गाडराम ने पाणी पीवाड़्‌यो। <verse eid="GEN 29:10" /><verse number="11" style="v" sid="GEN 29:11" />तत्‌यार याकुब राहेल ने गोळो देदो, अने ज्‌योरेत रड़्‌यो। <verse eid="GEN 29:11" /><verse number="12" style="v" sid="GEN 29:12" />अने याकुब राहेल ने देखाड़्‌यो के तीहयो तीना बाह ना कुम नो रीबका नो सोरो से। ता राहेल दवड़ीन जीन आह़फा बाह ने केदी। <verse eid="GEN 29:12" /><verse number="13" style="v" sid="GEN 29:13" />आह़फा भाणजे याकुब नी खबर जड़तेत लाबान तीने भेटवा करीन दवड़ीन ज्‌यो, अने तीने गळे लगाड़ीन गोळो देदो, अळतेण तीने आह़फा ना घोर लीन आयो। अने याकुब तीने आह़फी आखी वात ह़मळायो। <verse eid="GEN 29:13" /><verse number="14" style="v" sid="GEN 29:14" />तत्‌यार लाबान याकुब ने केदो, “तु ते ह़ाचलीनेत मारी हाटकी अने मांह से।” अने याकुब एक मयनो तीनी ह़ाते र्‌यो।<verse eid="GEN 29:14" /></para>
  <para style="s">राहेल अने लीया जुगु याकुब नी सेवा</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 29:15" />तत्‌यार लाबान याकुब ने केदो, “कुटुम वाळो हयवा ना कारण तने फीरी मे काम कराव्‌वा मारी वाटु वारु नी हय; आनीन करीन तु के चाकरी नी बदले मे तने ह़ु आपु?” <verse eid="GEN 29:15" /><verse number="16" style="v" sid="GEN 29:16" />लाबान नी बे सोरी हती, तीमनी मे सी मोट्‌ली नु नाम लीवा अने नान्‌ली नु नाम राहेल हतु। <verse eid="GEN 29:16" /><verse number="17" style="v" sid="GEN 29:17" />लीवा ना ते धुदळा डोळा हता, पण राहेल रुपाळी अने घटाळी हती।<verse eid="GEN 29:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 29:18" />एतरे याकुब, जे राहेल सी मोंग करतो हतो, केदो, “मे तारी नान्‌ली सोरी राहेल नी लेदे सात साल तारी चाकरी करही।”<verse eid="GEN 29:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 29:19" />लाबान केदो, “तीने बीजा अदमी ने आपवा सी तने आपवा वारु हयहे; एतरे मारी पांह रे।” <verse eid="GEN 29:19" /><verse number="20" style="v" sid="GEN 29:20" />याकुब राहेल नी लेदे सात साल चाकरी कर्‌यो; अने तीहया तीने राहेल ना मोंग ना कारण थोड़ाक दाड़ा नी बराबर लाग्‌या।<verse eid="GEN 29:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 29:21" />तत्‌यार याकुब लाबान ने केदो, “मारी लाडी मने आप, अने मे तीनी ह़ाते जही, काहाके मारी टेम पुरी हय जेली से।” <verse eid="GEN 29:21" /><verse number="22" style="v" sid="GEN 29:22" />तत्‌यार लाबान तीहया जागा ना आखा माणहुम ने बोलावीन एक्‌ठो कर्‌यो, अने तीमने वेवा नु खाणु खवाड़्‌यो। <verse eid="GEN 29:22" /><verse number="23" style="v" sid="GEN 29:23" />ह़ांती वेळा तीहयो आह़फा नी सोरी लीवा ने याकुब ने तां ली ज्‌यो, अने तीहयो तीनीन्‌तां ज्‌यो। <verse eid="GEN 29:23" /><verse number="24" style="v" sid="GEN 29:24" />लाबान तीनी सोरी लीवा ने तीनी पावर्‌याण हयवा नी लेदे आह़फा नी पावर्‌याण जील्‌पा ने आप्‌यो। <verse eid="GEN 29:24" /><verse number="25" style="v" sid="GEN 29:25" />ह़वारे मालम हयु के आहयी ते लीवा से, एतरे तीहयो लाबान ने केदो, “आहयु तु मार ह़ाते ह़ु करलो से? मे तार ह़ाते रीन जे तारी चाकरी कर्‌यो, ता ह़ु राहेल नी लेदे नी कर्‌यो? तत्‌यार तु मार सी ह़ुका आसम धोको करलो से?”<verse eid="GEN 29:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 29:26" />लाबान केदो, “अमारीन्‌तां आवी रीती नी हय, के मोट्‌ली सी पेले बीजी ना वेवा कर देय। <verse eid="GEN 29:26" /><verse number="27" style="v" sid="GEN 29:27" />आनो हप्‌तो ते पुरो कर; अळतेण बीजी बी तने तीहयी चाकरी नी लेदे जड़हे जे तु मार ह़ाते रीन अळी सात साल लग करही।”<verse eid="GEN 29:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 29:28" />याकुब आसमेत कर्‌यो, अने लीवा ना हप्‌ता ने पुरो कर्‌यो; तत्‌यार लाबान तीने आह़फा नी सोरी राहेल बी आप्‌यो, के तीहयी तीनी लाडी हये। <verse eid="GEN 29:28" /><verse number="29" style="v" sid="GEN 29:29" />लाबान आह़फा नी सोरी राहेल नी पावर्‌याण हयवा नी लेदे आह़फा नी पावर्‌याण बील्‌हा ने आप्‌यो <verse eid="GEN 29:29" /><verse number="30" style="v" sid="GEN 29:30" />तत्‌यार याकुब राहेल नी ह़ाते बी ज्‌यो, अने तीनो मोंग लीवा सी जादा तीनी पोर हयो, अने तीहयो लाबान नी ह़ाते रीन सात साल अळी तीनी चाकरी कर्‌यो।<verse eid="GEN 29:30" /></para>
  <para style="s">याकुब नी अवल्‌यात</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 29:31" />जत्‌यार यहोवा देख्‌यो के लीवा सी कम मोंग करे, तत्‌यार तीहयो तीनी कोख खोल्‌यो, पण राहेल वांज्‌याण री। <verse eid="GEN 29:31" /><verse number="32" style="v" sid="GEN 29:32" />तत्‌यार लीवा भारेपोगे हयी, अने तीनु एक सोरु पयदा हयु, अने तीहयी आहयु कीन तीनु नाम रुबेन पाड़ी, “यहोवा मारा दुख पोर नींगा करलो से, हाव मारो घोरवाळो ह़ाते मोंग करहे।” <verse eid="GEN 29:32" /><verse number="33" style="v" sid="GEN 29:33" />अळतेण तीहयी अळी भारेपोगे हयी अने तीनो एक सोरो पयदा हयो; तत्‌यार तीहयी आहयु केदी, “आहयु ह़मळीन के मने कम मोंग करे यहोवा मने आहयो बी सोरो आप्‌यो।” एतरे तीहयी तीनु नाम सीमोन<note caller="+" style="f"><char style="fr" closed="false">29:33 </char><char style="fq" closed="false">सीमोन </char><char style="ft" closed="false">ह़मळवा वाळो</char></note> पाड़ी। <verse eid="GEN 29:33" /><verse number="34" style="v" sid="GEN 29:34" />अळतेण तीहयी अळी भारेपोगे हयी अने तीने एक अळी सोरु पयदा हयु; अळी तीहयी केदी, “हाव ते मारो घोरवाळो मार सी मोंग करहे, काहाके तीनी सी मारा तीन सोरा पयदा हया।” एतरे तीनु नाम लेवी पाड़्‌या। <verse eid="GEN 29:34" /><verse number="35" style="v" sid="GEN 29:35" />अने अळी तीहयी भारेपोगे हयी अने तीनु एक अळी सोरु पयदा हयु; अळी तीहयी केदी, “हाव नी वार ते मे यहोवा ने घणो वारु केही।” एतरे तीहयी तीनु नाम यहुदा पाड़ी; तत्‌यार तीनी कोख बंद हय जी।<verse eid="GEN 29:35" /></para>
  <chapter eid="GEN 29" />
  <chapter number="30" style="c" sid="GEN 30" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 30:1" />जत्‌यार राहेल देखी के याकुब नी लेदे मारी सी कोय अवल्‌यात नी हयती, ता तीहयी आह़फी नी बेनेह सी डहवाय करवा बाज जी अने याकुब सी केदी, “मने बी अवल्‌यात आप, नीता मे मर जही।”<verse eid="GEN 30:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 30:2" />तत्‌यार याकुब राहेल ने खीजवाय्‌न केदो, “ह़ु मे भगवान से? तारी कोख ते तीहयोत बंद कर र्‌यो।”<verse eid="GEN 30:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 30:3" />राहेल केदी, “वारु, मारी पावर्‌याण बील्‌हा हजुर से; तीनीन्‌तां जा, तीहयी मारा मांडा पोर सोरु पयदा करहे, अने तीनी लारे मारु बी घोर वह्‌हे।” <verse eid="GEN 30:3" /><verse number="4" style="v" sid="GEN 30:4" />तत्‌यार तीहयी तीने आह़फी नी पावर्‌याण बील्‌हा ने आपी के तीहयी तीनी लाडी हये; अने याकुब तीनी ह़ाते ज्‌यो। <verse eid="GEN 30:4" /><verse number="5" style="v" sid="GEN 30:5" />अने बील्‌हा भारेपोगे हयी अने याकुब सी तीने एक सोरो पयदा हयो। <verse eid="GEN 30:5" /><verse number="6" style="v" sid="GEN 30:6" />तत्‌यार राहेल केदी, “भगवान मारो नीयाव कर्‌यो अने मारी ह़मळीन मने एक सोरो आप्‌यो।” एतरे तीहयी तीनु नाम दान<note caller="+" style="f"><char style="fr" closed="false">30:6 </char><char style="fq" closed="false">दान </char><char style="ft" closed="false">नीयाव करवा वाळो</char></note> पाड़ी। <verse eid="GEN 30:6" /><verse number="7" style="v" sid="GEN 30:7" />राहेल नी पावर्‌याण बील्‌हा अळी भारेपोगे हयी अने याकुब सी एक सोरो अळी पयदा हयो। <verse eid="GEN 30:7" /><verse number="8" style="v" sid="GEN 30:8" />तत्‌यार राहेल केदी, “मे मारी बेनेह नी ह़ाते घणी मेहनत करीन मोडे-मोडे लड़ायवा मे अने हाव मे जीक जी।” तत्‌यार तीहयी तीनु नाम नप्‌ताली<note caller="+" style="f"><char style="fr" closed="false">30:8 </char><char style="fq" closed="false">नप्‌ताली </char><char style="ft" closed="false">मारी मेहनत</char></note> पाड़ी।<verse eid="GEN 30:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 30:9" />जत्‌यार लीवा देखी के मारा सोरा पयदा हयवा बंद हय जेला से, ता तीहयी आह़फी नी पावर्‌याण जील्‌पा ने लीन याकुब नी लाडी हयवा करीन आप देदी। <verse eid="GEN 30:9" /><verse number="10" style="v" sid="GEN 30:10" />अने लीवा नी पावर्‌याण जील्‌पा नु बी याकुब सी एक सोरु पयदा हयु। <verse eid="GEN 30:10" /><verse number="11" style="v" sid="GEN 30:11" />ता लीवा केदी, “ओहो मारो कीस्‌मत!” एतरे तीहयी तीनु नाम गाद<note caller="+" style="f"><char style="fr" closed="false">30:11 </char><char style="fq" closed="false">गाद </char><char style="ft" closed="false">वारलो कीस्‌मत</char></note> पाड़ी। <verse eid="GEN 30:11" /><verse number="12" style="v" sid="GEN 30:12" />अळतेण लीवा नी पावर्‌याण जील्‌पा ना याकुब सी एक अळी सोरु पयदा हयु। <verse eid="GEN 30:12" /><verse number="13" style="v" sid="GEN 30:13" />तत्‌यार लीवा केदी, “मे जुगाळी से; पक्‌का बयरा मने जुगाळी केहे।” एतरे तीहयी तीनु नाम आसेर<note caller="+" style="f"><char style="fr" closed="false">30:13 </char><char style="fq" closed="false">आसेर </char><char style="ft" closed="false">जुगाळी</char></note> पाड़ी।<verse eid="GEN 30:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 30:14" />गम ना काटवा ना दाड़ा मे रुबेन ने चोवगान मे दुदाफोळ<note caller="+" style="f"><char style="fr" closed="false">30:14 </char><char style="fq" closed="false">दुदाफोळ </char><char style="ft" closed="false">दुदाफोळ खावा सी भारेपोगे हयवा नी ताखत जड़े</char></note> जड़्‌या, अने तीहयो तीने आह़फी आह्‌य लीवा नी तां ली ज्‌यो। तत्‌यार राहेल लीया ने केदी, “आह़फा ना सोरा ना दुदाफळु मे सी थोड़ाक मने आप दे।”<verse eid="GEN 30:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 30:15" />तीहयो तीमने केदो, “तु जे मारा लाडा ने ली लेदली से ह़ु आहयी नान्‌ली वात से? हाव ह़ु तु मारा सोरा ना दुदाफोळ बी लेवा हींड री?” राहेल केदी, “वारु, तारा सोरा ना दुदाफळु ना बदले तीहयो आज राते तार ह़ाते ह़ुवहे।”<verse eid="GEN 30:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 30:16" />ह़ांती टेमे जत्‌यार याकुब चोवगान मे गेथो आव्‌वा बाज र्‌यो हतो, ता लीवा तीनी सी भेट करवा नीकळी, अने केदी, “तने मारीन्‌तां आवा पड़हे, काहाके मे मारा सोरा ना दुदाफोळ आपीन तने ह़ाचलीन वेचातो लेदी।” तत्‌यार तीहयो ते राते तीनी ह़ाते ह़ुयो।<verse eid="GEN 30:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 30:17" />तत्‌यार भगवान लीवा नी ह़मळ्‌यो, अने तीहयी भारेपोगे हयी अने याकुब सी तीनो पांचवो सोरो पयदा हयो। <verse eid="GEN 30:17" /><verse number="18" style="v" sid="GEN 30:18" />तत्‌यार लीवा केदी, “में जे मारा घोरवाळा ने मारी पावर्‌याण आपली से, करीन भगवान मने मारी दाड़की आपलो से।” करीन तीहयी तीनु नाम ईस्‌साकार पाड़ी <verse eid="GEN 30:18" /><verse number="19" style="v" sid="GEN 30:19" />लीवा अळी भारेपोगे हयी अने याकुब सी तीनो छटवो सोरो पयदा हयो। <verse eid="GEN 30:19" /><verse number="20" style="v" sid="GEN 30:20" />तत्‌यार लीवा केदी, “भगवान मने वारलु दान आपलो से; हाव मारो घोरवाळो मारी ह़ाते रेहे, काहाके तीनी सी मारा छोव सोरा पयदा हयला से।” करीन तीहयो तीनु नाम जबुलुन पाड़्‌यो। <verse eid="GEN 30:20" /><verse number="21" style="v" sid="GEN 30:21" />तीनी बाद तीनो एक सोरी बी हयी, अने तीहयी तीनु नाम दीना पाड़ी।<verse eid="GEN 30:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 30:22" />भगवान राहेल नी बी खबर लेदो, अने तीनी वीन्‌ता ह़मळ्‌यो अने तीनी बी कोख खोल देदो। <verse eid="GEN 30:22" /><verse number="23" style="v" sid="GEN 30:23" />एतरे तीहयी भारेपोगे हयी अने तीहयी एक सोरा ने पयदा करी, अने “भगवान मारी बुराय करवा सेटी कर्‌यो। <verse eid="GEN 30:23" /><verse number="24" style="v" sid="GEN 30:24" />एतरे तीहयी आहयु कीन तीनु नाम युसुफ<note caller="+" style="f"><char style="fr" closed="false">30:24 </char><char style="fq" closed="false">युसुफ </char><char style="ft" closed="false">अळी बी आपहे </char><char style="fp" closed="false" /></note> पाड़ी, मालीक मने एक सोरो अळी बी आपहे।”<verse eid="GEN 30:24" /></para>
  <para style="s">याकुब नो लाबान ह़ाते ह़मजोतो</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 30:25" />जत्‌यार राहेल सी युसुफ पयदा हयु, तत्‌यार याकुब लाबान ने केदो, “मने वळाय दे के मे मारा देस अने मारा घोर जाम। <verse eid="GEN 30:25" /><verse number="26" style="v" sid="GEN 30:26" />मारा बयरा अने मारा सोरा, जीमनी लेदे मे तारी चाकरी करलो से, तीमने मने आल दे के मे जत रेम; तु ते जाणे के मे तारी कीसम चाकरी करलो से।”<verse eid="GEN 30:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 30:27" />लाबान तीने केदो, “कदी तारी नींगा मे में दया हात करलो से, ता आञे री जा; काहाके मने मालम पड़ जेलु से के यहोवा तारा कारण सी मने बरकत आपलो से।” <verse eid="GEN 30:27" /><verse number="28" style="v" sid="GEN 30:28" />अळी तीहयो केदो, “तु वारु वात देखाड़ के मे तने ह़ु आपु, अने मे तीने आपही।”<verse eid="GEN 30:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 30:29" />याकुब तीने केदो, “तु जाणे के मे तारी कीसम चाकरी कर्‌यो, अने तारा जानवरु मारी पांह कानी रीते र्‌या। <verse eid="GEN 30:29" /><verse number="30" style="v" sid="GEN 30:30" />मारी आव्‌वा सी पेले तीहया केतरा हता, अने हाव केतरा हय जेला से; अळी यहोवा मारा आव्‌वा पोर तने बरकत आपलो से। पण मे अमारा घोर नु काम कत्‌यार करही?”<verse eid="GEN 30:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 30:31" />लाबान अळी केदो, “मे तने ह़ु आलु?” याकुब केदो, “तु मने कंय ना आपे; कदी तु मारी लेदे एक काम करे, ता मे अळी तारा गाडरा अने बोकड़्‌याम ने चारही, अने तीमनी रखवाळी करही। <verse eid="GEN 30:31" /><verse number="32" style="v" sid="GEN 30:32" />मे आज तारा आखा गाडरा अने बोकड़्‌या ना वचे हय्‌न नीकळही, अने जे गाडरु नीता बोकड़ी चीत्‌रा वाळी नीता चीतकाबरी हय, अने जे गाडरु काळु हय, अने जे बोकड़ी चीतकाबरी अने चीत्‌रा वाळी हय, तीमने मे अलग करीन मेकही; अने मारी दाड़की मे तीहयात ठेरहे। <verse eid="GEN 30:32" /><verse number="33" style="v" sid="GEN 30:33" />अने जत्‌यार अगी मारी दाड़की नी वात हये, तत्‌यार धरम नी आहयी गवा हयहे; बोकड़्‌याम मे सी जे कानी नीता चीत्‌रा वाळी नी चीतकाबरी हय, अने गाडराम मे सी जे कानी काळ्‌ळी नी हय, कदी मार पांह नीकळे, ता चोरी नी ठेरहे।”<verse eid="GEN 30:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="GEN 30:34" />तत्‌यार लाबान केदो, “तारा केवा नी अनसारे हये।” <verse eid="GEN 30:34" /><verse number="35" style="v" sid="GEN 30:35" />तत्‌यार तीहयो ते दाड़े आखा रेहटाळ्‌या अने चीतकाबर्‌या बोकड़ा, अने आखी चीत्‌रा वाळी अने चीतकाबरी बोकड़्‌याम ने, मतलब तीमनी मे कंय धोळ्‌ळा टीप्‌का हता, तीमने अने आखी काळ्‌ळा गाडराम ने बी अलग करीन आह़फा ना सोराम ना हात मे ह़ोप देदो। <verse eid="GEN 30:35" /><verse number="36" style="v" sid="GEN 30:36" />अळी तीहयो आह़फा अने याकुब नी वच मे तीन दाड़ा नी चाल नो गाळो राख्‌यो; अने याकुब लाबान ना गाडरा अने बोकड़्‌याम ने चारवा बाज ज्‌यो।<verse eid="GEN 30:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 30:37" />तत्‌यार याकुब चीनार, अने बदाम, अने अर्‌मोन झाड़ नी लील्‌ली-लील्‌ली ह़ोटी लीन, तीमना पोपड़ा कंय-कंय हेड़ीन तीमने तीखला बणाय देदो, आसवा के तीहया ह़ोट्‌या धोळ्‌ळा देखाव पड़े। <verse eid="GEN 30:37" /><verse number="38" style="v" sid="GEN 30:38" />अने तत्‌यार छोतरा हेड़ली ह़ोटीम ने गाडरा अने बोकड़्‌याम नी अगळ तीमना पाणी पीवा ना चाठड़ा मे उबो कर्‌यो; अने जत्‌यार तीहया पाणी पीवा करीन आया तत्‌यार गाबणा हय ज्‌या। <verse eid="GEN 30:38" /><verse number="39" style="v" sid="GEN 30:39" />ह़ोटीम नी अगळ गाबणा हय्‌न, गाडरा अने बोकड़्‌या, रेहटाळ्‌या, चीत्‌रा वाळा, अने चीतकाबर्‌या बच्‌चा जणी।<verse eid="GEN 30:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 30:40" />तत्‌यार याकुब गाडराम ना बच्‌चा ने अलग-गलक कर्‌यो, अने लाबान ना गाडरा अने बोकड़्‌या ना मोडा चीत्‌रा वाळा अने आखा काळ्‌ळा बच्‌चा भणी कर देदो; अने आह़फा ना टोळाम ने तीमनी गेथा अलग राख्‌यो, अने लाबान ना गाडरा अने बोकड़्‌याम नी मे भेसकायवा नी देदो।<verse eid="GEN 30:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="GEN 30:41" />अने जत्‌यार-जत्‌यार जबरा गाडरा अने बोकड़्‌या गाबणा हयता हता, तत्‌यार-तत्‌यार याकुब तीहयी ह़ोटीम ने चाठड़ा मे तीमनी अगळ मेल देतो हतो; जीनी सी तीहया ह़ोटीम ने देखता जाय्‌न गाबणा हय जाय। <verse eid="GEN 30:41" /><verse number="42" style="v" sid="GEN 30:42" />पण जत्‌यार हारला गाडरा अने बोकड़्‌या गाबणा हयता हता, तत्‌यार तीहयो तीमनी अगळ नी मेल्‌तो हतो। आनी सी हारली-हारली लाबान नी री, अने मात्‌ली-मात्‌ली याकुब नी हय जी। <verse eid="GEN 30:42" /><verse number="43" style="v" sid="GEN 30:43" />आहयी रीते तीहयो माणेह घणो मालदार हय ज्‌यो, अने तीना ढेरेत गाडरा अने बोकड़्‌या, अने पावर अने पावर्‌याण अने उटड़ा अने गदड़ा हय ज्‌या।<verse eid="GEN 30:43" /></para>
  <chapter eid="GEN 30" />
  <chapter number="31" style="c" sid="GEN 31" />
  <para style="s">याकुब नु लाबान ने तां गेथु नाहवु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 31:1" />अळतेण लाबान ना सोराम नी आहयी वात याकुब ने ह़मळवा मे आयी, “याकुब अमारा बाह नु आखु कंय हापकी लेदलो से, अने अमारा बाह ना धन ना कारण सी तीनी आहयी ईज्‌जत से।” <verse eid="GEN 31:1" /><verse number="2" style="v" sid="GEN 31:2" />अने याकुब लाबान ना मोडा पोर नींगा कर्‌यो अने देख लेदो के तीहयो तीनी लेदे पेलेन तेम दया वाळो नी र्‌यो। <verse eid="GEN 31:2" /><verse number="3" style="v" sid="GEN 31:3" />तत्‌यार यहोवा याकुब ने केदो, “आह़फा ना आड़ा-बुड़ा ना देस अने जां तु पयदा हयलो तां पासो जत रे, अने मे तारी ह़ाते रेही।”<verse eid="GEN 31:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 31:4" />तत्‌यार याकुब राहेल अने लीवा ने चोवगान मे आह़फा ना गाडरा अने बोकड़ाम ने तां बोलावीन केदो, <verse eid="GEN 31:4" /><verse number="5" style="v" sid="GEN 31:5" />तमारा बाह ना मोडा सी, “मने ह़मज पड़े के तीहयो मने पेलेन तेम हाव दया वाळो नी देखायतो; पण मारा बाह नो भगवान मार ह़ाते से। <verse eid="GEN 31:5" /><verse number="6" style="v" sid="GEN 31:6" />तमु बी जाणो के मे पुरी ताखत सी तमारा बाह नी सेवा करलो से। <verse eid="GEN 31:6" /><verse number="7" style="v" sid="GEN 31:7" />ते बी तमारो बाह मारी ह़ाते धोको करीन मारी दाड़की ने दह वार बदल देदो; पण भगवान तीने मारु नुकसान नी करवा देदो। <verse eid="GEN 31:7" /><verse number="8" style="v" sid="GEN 31:8" />जत्‌यार तीहयो केदो, ‘काबर्‌या बच्‌चा तारा दाड़की हयहे,’ तत्‌यार आखा गाडरा अने बोकड़्‌या काबर्‌या बच्‌चा जणवा बाज जी; अने जत्‌यार तीहयो केदो, ‘रेहटाळ्‌या बच्‌चा तारी दाड़की हयहे,’ तत्‌यार आखा गाडरा अने बोकड़्‌या रेहटाळ्‌या बच्‌चा जणवा बाज जी। <verse eid="GEN 31:8" /><verse number="9" style="v" sid="GEN 31:9" />आहयी रीते भगवान तमारा बाह ना जानवरु लीन मने आल देदो।<verse eid="GEN 31:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 31:10" />“गाडरा अने बोकड़्‌या गाबणा हयवा नी टेमे मे ह़पनु मे ह़ु देख्‌यो के जे बोकड़ा बोकड़्‌या पोर कुदवा बाज र्‌या हता, तीहया रेहटाळ्‌या, चीतर्‌या, अने टीपकाळ्‌या से। <verse eid="GEN 31:10" /><verse number="11" style="v" sid="GEN 31:11" />तत्‌यार भगवान ना दुत ह़पनु मे मने केदा, ‘ए याकुब,’ मे केदो, ‘ह़ु हुकम।’ <verse eid="GEN 31:11" /><verse number="12" style="v" sid="GEN 31:12" />तीहयो केदो, ‘डोळा उपर करीन तीहया आखा बोकड़ा ने जे बोकड़्‌या पोर कुद र्‌या देख, के तीहया रेहटाळ्‌याण, काबर्‌या-चीतर्‌याण, अने टीपकाळ्‌याण से; काहाके जे कंय लाबान तारी ह़ाते कर र्‌यो तीहयु मे देखलो से। <verse eid="GEN 31:12" /><verse number="13" style="v" sid="GEN 31:13" />मे तीहया बेतेल नो भगवान से, जां तु एक दगड़ा नो खम्‌बो उबो करलो हतो अने तीनी पोर तेल नाखलो हतो, अने मारी मान-बादा लेदलो हतो। हाव चाल, आहया देस मे गेथो नीकळीन तु पयदा हयलो तां पासो जत रे।’”<note caller="+" style="x"><char style="xo" closed="false">31:13 </char><char style="xt" closed="false"><ref loc="GEN 28:18-22">उबजणाय कीताप 28:18-22</ref></char></note><verse eid="GEN 31:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 31:14" />तत्‌यार राहेल अने लीवा तीने केदी, “ह़ु अमारा बाह ना घोर मे हाव बी अमारो कंय वाटो नीता थोड़ुक बचलु से? <verse eid="GEN 31:14" /><verse number="15" style="v" sid="GEN 31:15" />ह़ु आमु तीनी नींगा मे बीजा नी ठेर्‌या? देख, हीय्‌यो आमु ने ते वेच नाख्‌यो, अने अमारा रुप्‌या ने खाय्‌न बहलो से। <verse eid="GEN 31:15" /><verse number="16" style="v" sid="GEN 31:16" />एतरे भगवान अमारा बाह नु जेतरु धन हतु ली लेदलो से, तीहयु अमारु अने अमारा सोरा नु से; हाव जे कंय भगवान तने केदलो से, तीहयुत कर।”<verse eid="GEN 31:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 31:17" />तत्‌यार याकुब आह़फा ना सोराम ने अने बयराम ने उटड़ा पोर बहाड़्‌यो; <verse eid="GEN 31:17" /><verse number="18" style="v" sid="GEN 31:18" />अने जेतरा जानवरु ने तीहयो पदनराम मे भेळा करीन धन वाळो हय जेलो हतो, आखा ने कनान मे आह़फा ना बाह ईसाक ने तां जवा ना वीच्‌यार सी, ह़ाते ली ज्‌यो। <verse eid="GEN 31:18" /><verse number="19" style="v" sid="GEN 31:19" />लाबान आह़फा ना गाडरा ना नीम्‌बाळा कातरवा करीन जत रेलो हतो, अने राहेल आह़फा ना बाह ना घोर ना देवताम ने चोरीन लीत्‌ती री। <verse eid="GEN 31:19" /><verse number="20" style="v" sid="GEN 31:20" />याकुब लाबान अरामी ना घोर गेथो चोराये जत र्‌यो, तीने नी केदो के मे नाहीन जवा बाज र्‌यो। <verse eid="GEN 31:20" /><verse number="21" style="v" sid="GEN 31:21" />तीहयो आह़फा नु आखु कंय लीन नाह्‌यो, अने मोट्‌ली नंदी<note caller="+" style="f"><char style="fr" closed="false">31:21 </char><char style="fq" closed="false">मोट्‌ली नंदी </char><char style="ft" closed="false">फरात नंदी</char></note> नी पार उतरीन आह़फा नु मोडु गीलाद ना बड़ा ना देस भणी कर्‌यो।<verse eid="GEN 31:21" /></para>
  <para style="s">लाबान याकुब नी पछळ पड़े</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 31:22" />तीसरा दाड़े लाबान ने खबर जड़ी के याकुब नाह जेलो से। <verse eid="GEN 31:22" /><verse number="23" style="v" sid="GEN 31:23" />एतरे तीहयो आह़फा ना भायु ने ह़ाते लीन सात दाड़ा तक तीनी पछळ पड़्‌यो, अने गीलाद ना बड़ा ना देस मे जाय्‌न तीने हात कर लेदो। <verse eid="GEN 31:23" /><verse number="24" style="v" sid="GEN 31:24" />पण भगवान राते ना ह़पनु मे अरामी लाबान ने तां आवीन केदो, “चेतीन रे, तु याकुब ने नी ते भलो केजे अने नी बुरु।” <verse eid="GEN 31:24" /><verse number="25" style="v" sid="GEN 31:25" />अने याकुब आह़फा नु तम्‌बु गीलाद नाम ना बड़ा ना देस मे उबु कर र्‌यो हतो अने लाबान बी तीना भायु भेळ तीहयात बड़ा वाळा देस मे तम्‌बु उबो कर्‌यो।<verse eid="GEN 31:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 31:26" />तत्‌यार लाबान याकुब ने केवा बाज ज्‌यो, “तु आहयु ह़ु कर्‌यो के मारीन्‌तां गेथो चोराये आवती र्‌यो, अने मारी सोरीम ने आसम ली आयो, जीसम कोय तलवार नी ताखत पोर कुंडीन राख र्‌या हय? <verse eid="GEN 31:26" /><verse number="27" style="v" sid="GEN 31:27" />तु ह़ुका होगोत नाह आयो, अने मने कंय कीया वगर मारीन्‌तां गेथो चोराये नाहीन आवती र्‌यो; नीता मे तने खुसी सी ढाक अने तम्‌बुरो वगाड़तो, अने गीत गवाड़तो जीन मोकलतो। <verse eid="GEN 31:27" /><verse number="28" style="v" sid="GEN 31:28" />तु ते मने मारा सोरा-सोरी ने गोळो लग नी देवा देदो? तु गंडाय करलो से। <verse eid="GEN 31:28" /><verse number="29" style="v" sid="GEN 31:29" />तमारु नुकसान करवा नी ताखत मारा हात मे ते से; पण तमारा बाह नो भगवान ज्‌यी राते केदो, चेतीन रेजे, याकुब ने नी ते भलु केजे अने नी बुरु। <verse eid="GEN 31:29" /><verse number="30" style="v" sid="GEN 31:30" />भलु, हाव तु आह़फा ना बाह ना घोर नी हेर करीन ते आवती र्‌यो, पण मारा देवताम ने तु ह़ुका चोरी करीन ली आवलो से?”<verse eid="GEN 31:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 31:31" />याकुब लाबान ने जपाप आप्‌यो, “मे आहयु सोचीन बीह जेलो हतो के कंखर माय्‌न तु तारी सोरीम ने मारी पांह गेथी हापकी नी लेय। <verse eid="GEN 31:31" /><verse number="32" style="v" sid="GEN 31:32" />जे कोय नी पांह तु आह़फा ना देवताम ह़ोद लेय, तीहयु जीवत्‌लु नी बचहे। मारी पांह तारु जे कंय नीकळे, तीने भाय-बोंदुम नी अगळ ओळखीन ली ले।” काहाके याकुब नी जाणतो हतो के राहेल घोर ना देवता चोरी कर लावली से।<verse eid="GEN 31:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 31:33" />आहयु ह़मळीन लाबान, याकुब अने लीवा अने बेम पावर्‌याण ना तम्‌बु मे ज्‌यो, अने कंय नी जड़्‌यु। ता लीवा ना तम्‌बु मे गेथो नीकळीन राहेल ना तम्‌बु मे ज्‌यो। <verse eid="GEN 31:33" /><verse number="34" style="v" sid="GEN 31:34" />राहेल ते घोर ना देवताम ने उटड़ा नी काठी मे मेलीन तीनी पोर बह री हती। लाबान तीना आखा तम्‌बु मे भाळवा पोर बी तीहया नी जड़्‌या। <verse eid="GEN 31:34" /><verse number="35" style="v" sid="GEN 31:35" />राहेल आह़फा ना बाह ने केदी, “ए मार मालीक; आनी सी रीहायजे नी के मे तारी अगळ नी उठी; काहाके मे मयना सी से।” लाबान ने ह़ोदवा पोर बी घोर ना देवता तीने नी जड़्‌या।<verse eid="GEN 31:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 31:36" />तत्‌यार याकुब खीजवाय्‌न लाबान ह़ाते झगड़ो करवा बाज ज्‌यो, अने केदो, “मारो ह़ु गुनो से?” मारो “ह़ु पाप से के तु एतरो खीजवाय्‌न मारी पसळ पड़्‌यो? <verse eid="GEN 31:36" /><verse number="37" style="v" sid="GEN 31:37" />तु जे मारी आखी चीज ने धरी-धरीन देख्‌यो, ता तने अमारा घोर नी आखी चीज मे गेथु ह़ु जड़्‌यु? कंय जड़्‌यु हय ता तीने आञे तारा अने मारा भाय-बोंदु नी अगळ मेल दे, अने तीहयी आपणु बेम जणा नी वचे नीयाव करे। <verse eid="GEN 31:37" /><verse number="38" style="v" sid="GEN 31:38" />आहया वीह साल लग मे तारी ह़ाते र्‌यो; आमनी मे नी ते तारा गाडरा अने बोकड़्‌या नु काचलु गीदल्‌यु तक नी पड़्‌यु, अने तारा गाडरा नु माह मे कदी नी खादो। <verse eid="GEN 31:38" /><verse number="39" style="v" sid="GEN 31:39" />जीने जंगली जानवरु मार नाखे तीने मे तारी पांह नी लावतो हतो ह़ु, तीनु नुकसान मेत झेलतो हतो; भले दीहु चोरी हय जाय नी ता राते, तु मार पांह गेथु तीने ली लेतो हतो। <verse eid="GEN 31:39" /><verse number="40" style="v" sid="GEN 31:40" />मारी आसवी हालत हती के दीहु नो तोप अने रात नी टाड सी मे मर जतो हतो। मारी नींदर मारा डोळा मे गेथी नाह जती हती। <verse eid="GEN 31:40" /><verse number="41" style="v" sid="GEN 31:41" />मे वीह साल लग तारा घोर मे र्‌यो; चोवदे साल ते मे तारी बेम सोरीम नी करते, अने छोव साल तारा गाडरा अने बोकड़ाम नी लेदे सेवा कर्‌यो; अने तु मारी दाड़की ने दह कावा बदली देदो। <verse eid="GEN 31:41" /><verse number="42" style="v" sid="GEN 31:42" />मारा बाह नो भगवान, मतलब अब्‌राहम नो भगवान, जीनी बीक ईसाक बी माने, कदी मारी ह़ाते नी हतो ता पक्‌को तु हाव मने ठारला हाते जवा देतो। मारा दुख अने मारा हात नी मेहनत ने देखीन भगवान वीती रात मे तने वड्‌यो।”<verse eid="GEN 31:42" /></para>
  <para style="s">याकुब अने लाबान नी वचे समजोतो</para>
  <para style="p">
    <verse number="43" style="v" sid="GEN 31:43" />लाबान याकुब ने केदो, “आहया सोर्‌या ते मारात से, अने आहया सोरा बी मारात से, अने आहया गाडरा अने बोकड़ा बी मारात से, अने जे कंय तने देखाव पड़े तीहयु आखु मारुत से। पण हाव मे मारा आहया सोर्‌या, अने आमनी अवल्‌यात ह़ाते ह़ु कर सकु? <verse eid="GEN 31:43" /><verse number="44" style="v" sid="GEN 31:44" />हाव आव, मे अने तु बेम एक बीजा ह़ाते वायदो करया, अने तीहयो वायदो मारी अने तारी वचे फोम रेय करीन आमु एक दगड़ा नो एक खम्‌बो बणावया।”<verse eid="GEN 31:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="GEN 31:45" />तत्‌यार याकुब एक दगड़ो लीन तीनो खम्‌बो उबो कर्‌यो। <verse eid="GEN 31:45" /><verse number="46" style="v" sid="GEN 31:46" />तत्‌यार याकुब आह़फा ना भाय-बोंदु ने केदो, “दगड़ा एक्‌ठा करो।” आहयु ह़मळीन तीहया दगड़ा एक्‌ठा करीन ढेर लगाड़्‌या, अने तीहयात ढेर ने तां तीहया खाणु खादा। <verse eid="GEN 31:46" /><verse number="47" style="v" sid="GEN 31:47" />तीहया ढेर नु नाम लाबान ते यज्‌रसहादुथा<note caller="+" style="f"><char style="fr" closed="false">31:47 </char><char style="fq" closed="false">यज्‌रसहादुथा </char><char style="ft" closed="false">मतलब अरामी भासा मे, गवा नो ढेर</char></note> पाड़्‌यो, पण याकुब गीलीयाद <note caller="+" style="f"><char style="fr" closed="false">31:47 </char><char style="fq" closed="false">गीलीयाद </char><char style="ft" closed="false">मतलब, ईब्‌रानी भासा मे, गवा नो ढेर</char></note>पाड़्‌यो। <verse eid="GEN 31:47" /><verse number="48" style="v" sid="GEN 31:48" />लाबान केदो, “आहयो ढेर मारी अने तारी वचे गवाय रेहे।” आहया कारण तीनु नाम गीलीयाद पाड़्‌यो, <verse eid="GEN 31:48" /><verse number="49" style="v" sid="GEN 31:49" />अने मीस्‌पा <note caller="+" style="f"><char style="fr" closed="false">31:49 </char><char style="fq" closed="false">मीस्‌पा </char><char style="ft" closed="false">जां रीन देख-भाळ हये</char></note>बी; काहाके तीहयो केदो, “जत्‌यार आमु एक बीजा सी सेटा रेय” तत्‌यार यहोवा मारी अने तारी देख-भाळ करतो रेय। <verse eid="GEN 31:49" /><verse number="50" style="v" sid="GEN 31:50" />कदी तु मारी सोरीम ने वेला पाड़े, “नीता तीमने रेवा दीन बीजा बयरा ह़ाते वेवा करे, ता आपणी ह़ाते कोय माणेह ते नी रेय; पण देख मारी अने तारी वच मे भगवान गवा रेहे। <verse eid="GEN 31:50" /><verse number="51" style="v" sid="GEN 31:51" />अळतेण लाबान याकुब ने केदो, आहया ढेर ने देख अने आहया खम्‌बा ने बी देख, जीने मे मारी अने तारी वचमे उबो करलो से। <verse eid="GEN 31:51" /><verse number="52" style="v" sid="GEN 31:52" />आहयो ढेर अने आहयो खम्‌बो बेम आहयी वात नो गवा रेय के नुकसान करवा ना वीच्‌यार सी, नी ते मे आहया ढेर ने पार करीन तारीन्‌तां आवु, नी ते तु आहया ढेर अने आहया खम्‌बा ने पार करीन मारीन्‌तां आवजे। <verse eid="GEN 31:52" /><verse number="53" style="v" sid="GEN 31:53" />अब्‌राहम अने नाहोर अने तीनो बाह; तीनोव नो जे भगवान से, तीहयोत आपणु बेम जणा नी वचे नीयाव करहे।” तत्‌यार याकुब तीनी ह़ाम खादो जीनी बीक तीनो बाह ईसाक मान्‌तो हतो; <verse eid="GEN 31:53" /><verse number="54" style="v" sid="GEN 31:54" />अने याकुब तीहया बड़ा पोर एक जानवर नी बादा चड़ायो, अने आह़फा ना भाय-बंदुम ने खाणु खावा करीन बोलायो; तत्‌यार तीहया खाणु खाय्‌न बड़ा पोरेत र्‌या। <verse eid="GEN 31:54" /><verse number="55" style="v" sid="GEN 31:55" />ह़वारे लाबान उठ्‌यो अने आह़फा ना सोरा-सोरीम ने गोळो दीन अने बरकत आपीन चाल पड़्‌यो, अने आह़फा ना जागे पासो आवती र्‌यो।<verse eid="GEN 31:55" /></para>
  <chapter eid="GEN 31" />
  <chapter number="32" style="c" sid="GEN 32" />
  <para style="s">याकुब नी एसाव ने भेटवा नी तीयारी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 32:1" />याकुब बी आह़फा नी वाट्‌ये लाग्‌यो अने भगवान ना दुत तीने आय भेट्‌या। <verse eid="GEN 32:1" /><verse number="2" style="v" sid="GEN 32:2" />तीमने देखतेत याकुब केदो, “आहयो ते भगवान नो टोळो से।” एतरे तीहयो ते जागा नु नाम महनेम<note caller="+" style="f"><char style="fr" closed="false">32:2 </char><char style="fq" closed="false">महनेम </char><char style="ft" closed="false">बे टोळा</char></note> पाड़्‌यो।<verse eid="GEN 32:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 32:3" />तत्‌यार याकुब सेईर देस मे, मतलब एदोम देस मे, आह़फा ना भाय एसाव ने तां आह़फा नी अगळ दुत ने मोकल्‌यो, <verse eid="GEN 32:3" /><verse number="4" style="v" sid="GEN 32:4" />अने तीहयो तीमने आहयो हुकम आप्‌यो, “मारा मालीक एसाव ने आहयु केजो: तारो पावर याकुब तने आहयु केय, के मे लाबान ने तां परदेसी हय्‌न हजु तक र्‌यो; <verse eid="GEN 32:4" /><verse number="5" style="v" sid="GEN 32:5" />अने मारी पांह गाय-बोळद्‌या, गदड़ा, गाडरा अने बोकड़ा, अने पावर-पावर्‌याण से अने मे मारा मालीक पांह आनीन करते खबर पुगाड़्‌यो के तारी दया नी नींगा मारी पोर हये।”<verse eid="GEN 32:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 32:6" />तीहया दुत याकुब पांह पाछा आवीन केवा बाज ज्‌या, “आमु तारा भाय एसाव पांह जेला हता, अने तीहयो बी तने भेटवा करी च्‌यार ह़ोव अदमी लीन आव्‌वा बाज र्‌यो।” <verse eid="GEN 32:6" /><verse number="7" style="v" sid="GEN 32:7" />तत्‌यार याकुब घणो बीह ज्‌यो, अने वेला मे पड़्‌यो: अने आहयु सोचीन, आह़फा ना ह़ातीम ना, अने गाडरा अने बोकड़ाम, अने गाय-बोळद्‌या, अने उटड़ाम ना बी अलग-गलक बे टोळा कर लेदो, <verse eid="GEN 32:7" /><verse number="8" style="v" sid="GEN 32:8" />के एसाव आवीन पेला टोळा ने मारवा हींडे, ता बीजो टोळो नाहीन बच जहे।<verse eid="GEN 32:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 32:9" />अळतेण याकुब केदो, “ए यहोवा, ए मारा डायला बाह अब्‌राहम ना भगवान ए मारा बाह ईसाक ना भगवान, तु ते मने केदलो हतो के आह़फा ना देस अने जा पयदा हयलो तां पासो जत रे, अने मे तारी भलाय करही: <verse eid="GEN 32:9" /><verse number="10" style="v" sid="GEN 32:10" />तु जे-जे काम आह़फा नी दया अने सच्‌चाय सी आह़फा ना पावर नी ह़ाते करलो से, के मे जे मारी लाकड़ीत लीन आहयी यरदन नंदी नी पार उतरीन आयो, अने हाव मारा बे टोळा हय जेला से, तारा आसम-आसम कामु मे सी मे एक नी बी लायक नी हय। <verse eid="GEN 32:10" /><verse number="11" style="v" sid="GEN 32:11" />मारा रावण्‌या ह़मळीन मने मारा भाय एसाव ना हात सी बचाड़ मे ते हीनी सी बीहु, कंखर आसम नी हय के तीहयो आवीन मने अने आह्‌य भेळ सोराम ने बी मार नाखे। <verse eid="GEN 32:11" /><verse number="12" style="v" sid="GEN 32:12" />तु ते केदलो से, के पक्‌को तारी भलाय करही, अने तारी अवल्‌यात ने दर्‌या ना बालु रेत नी तेम ढेरेत करही, जे ढेरेत हयवा नी कारण गीणाये नी।”<note caller="+" style="x"><char style="xo" closed="false">32:12 </char><char style="xt" closed="false"><ref loc="GEN 22:17">उबजणाय कीताप 22:17</ref></char></note><verse eid="GEN 32:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 32:13" />तीहयो ते दाड़े नी रात तांत वीताड़्‌यो; अने जे कंय तीनी पांह हतु तीनी मे सी आह़फा ना भाय एसाव नी भेट नी लेदे टाळी-टाळीन नीकाळ्‌यो; <verse eid="GEN 32:13" /><verse number="14" style="v" sid="GEN 32:14" />मतलब बे ह़ोव बोकड़्‌या, अने वीह बोकड़ा, अने बे ह़ोव गाडर्‌या, अने वीह गाडरा, <verse eid="GEN 32:14" /><verse number="15" style="v" sid="GEN 32:15" />अने बच्‌चा भेळ दुत आपवा वाळी तीस उटड़ी, अने चाळीह गायु, अने दह बोळद्‌या, अने वीह गदड़ी अने दह गदड़ा। <verse eid="GEN 32:15" /><verse number="16" style="v" sid="GEN 32:16" />ईमने तीहयो टोळा-टोळा करीन, आह़फा ना पावर्‌याम ने ह़ोपीन तीमने केदो, “मार गेथा अगळ जावो; अने टोळाम ना वचे-वचे गाळो राखो।” <verse eid="GEN 32:16" /><verse number="17" style="v" sid="GEN 32:17" />अळतेण तीहयो अगला टोळा ना रखवाळ्‌या ने हुकम आप्‌यो, जत्‌यार मारो भाय एसाव तने भेटे, अने पुछे, तु कोयनो पावर से, अने अळी केय, अने आहया जे तारी अगळ-अगळ से, ते कोयना जानवर से? <verse eid="GEN 32:17" /><verse number="18" style="v" sid="GEN 32:18" />तत्‌यार केजे, “आहया तारा पावर याकुब ना से। ए मारा मालीक एसाव, आहयी भेट तने आपवा नी लेदे तारी पांह ली मोकल्‌ला से, अने तीहयो बी अमारी पछळ-पछळ आव्‌वा बाज र्‌यो।” <verse eid="GEN 32:18" /><verse number="19" style="v" sid="GEN 32:19" />अने तीहयो बीजा अने तीसरा रखवाळ्‌या ने बी, “पण तीहया आखा ने जे टोळा ना पछळ-पछळ हता आसमेत हुकम आप्‌यो के जत्‌यार एसाव तीमने भेटे ता आहयी रीते तीने केजो। <verse eid="GEN 32:19" /><verse number="20" style="v" sid="GEN 32:20" />अने आहयु बी केजो, ‘तारो पावर याकुब अमारी पछळ-पछळ आव्‌वा बाज र्‌यो।’” काहाके तीहयो आहयो वीच्‌यार कर्‌यो के आहयी भेट जे मारी अगळ-अगळ जाय, आनी लारे “मे तीनी रीह ने होगी करीन तत्‌यार तीनो दरसन करही; हय सके तीहयो मारी सी खुस हय जाय।” <verse eid="GEN 32:20" /><verse number="21" style="v" sid="GEN 32:21" />एतरे तीहयी आखी भेट नो टोळो याकुब गेथो पेले पार जत र्‌यो, अने याकुब आह़फोत ते रात पड़ावा मे र्‌यो।<verse eid="GEN 32:21" /></para>
  <para style="s">याकुब नी कुस्‌ती नी लड़ाय</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 32:22" />तीहयीत राते तीहयो उठ्‌यो अने आह़फा नी बेम लाडी, अने बेम पावर्‌याण, अने ग्‌यारे सोराम ने ह़ाते लीन बड़ा पोर गेथो यब्‌बोक नंदी नी पार उतरी ज्‌यो। <verse eid="GEN 32:22" /><verse number="23" style="v" sid="GEN 32:23" />तीहयो तीमने तीहयी नंदी नी पार उतार देदो, अळी आह़फा नु आखु पार उतार देदो। <verse eid="GEN 32:23" /><verse number="24" style="v" sid="GEN 32:24" />अने याकुब आह़फो एखलो री ज्‌यो; तत्‌यार कानो अदमी परगड़ फाटते लग तीनी सी कुस्‌ती लड़तो र्‌यो। <verse eid="GEN 32:24" /><verse number="25" style="v" sid="GEN 32:25" />जत्‌यार तीहयो देख्‌यो के मे याकुब पोर भारी नी पड़तो, तत्‌यार तीनी ह़ातळ्‌या नी नेह ने छीम्‌यो; अने याकुब नी ह़ातळ्‌या नी नेह तीने कुस्‌ती लड़ते लड़तेत अकड़ाय जी। <verse eid="GEN 32:25" /><verse number="26" style="v" sid="GEN 32:26" />तत्‌यार तीहयो केदो, “मने जवा दे, काहाके ह़वारे हयवा वाळु से,” याकुब केदो, “जत्‌यार लग तु मने बरकत नी आले, तांह लग मे तने जवा नी देम।”<verse eid="GEN 32:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 32:27" />अने तीहयो याकुब ने पुछ्‌यो, “तारु नाम ह़ु से?” तीहयो केदो, “याकुब।”<verse eid="GEN 32:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 32:28" />तीहयो केदो, “तारु नाम याकुब नी, पण ईस्‌रायल <note caller="+" style="f"><char style="fr" closed="false">32:28 </char><char style="fq" closed="false">ईस्‌रायल </char><char style="ft" closed="false">भगवान ह़ाते झुमायवा वाळो</char></note>हयहे, काहाके तु भगवान ह़ाते अने माणहु ह़ाते बी लड़ाय करीन जीक जेलो से।”<note caller="+" style="x"><char style="xo" closed="false">32:28 </char><char style="xt" closed="false"><ref loc="GEN 35:10">उबजणाय कीताप 35:10</ref></char></note><verse eid="GEN 32:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 32:29" />याकुब केदो, “मे रावण्‌या करु, मने आह़फा नु नाम देखाड़।” तीहयो केदो, “तु मारु नाम ह़ुका पुछे।” तत्‌यार तीहयो तीने तांत बरकत आप्‌यो।<note caller="+" style="x"><char style="xo" closed="false">32:29 </char><char style="xt" closed="false"><ref loc="JDG 11:17">न्‌यायीयो 11:17</ref>,<ref loc="JDG 11:18">18</ref></char></note><verse eid="GEN 32:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 32:30" />तत्‌यार “याकुब आहयु कीन तीहया जागा नु नाम पनीएल <note caller="+" style="f"><char style="fr" closed="false">32:30 </char><char style="fq" closed="false">पनीएल </char><char style="ft" closed="false">भगवान नु मोडु</char></note>पाड़्‌यो; भगवान ने आम्‌बो-साम्‌बो देखवा पोर बी मे जीवत्‌लो से।” <verse eid="GEN 32:30" /><verse number="31" style="v" sid="GEN 32:31" />पनीएल ने तां गेथो चालते-चालते दाड़ु उग ज्‌यु, अने तीहयो ह़ातळ्‌या नी नेह ना कारण सी लंगड़ायतो हतो। <verse eid="GEN 32:31" /><verse number="32" style="v" sid="GEN 32:32" />ईस्‌रायली माणहु जे जानवरु ना कुला नी नेह ने, आज तक बी नी खाय; काहाके तीहयो माणेह याकुब ना ह़ातळ्‌या नी नेह ने छीमलो हतो।<verse eid="GEN 32:32" /></para>
  <chapter eid="GEN 32" />
  <chapter number="33" style="c" sid="GEN 33" />
  <para style="s">याकुब नु एसाव ने भेटवु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 33:1" />याकुब डोळा उचा करीन आहयु देख्‌यो, के एसाव चार ह़ोव अदमी ह़ाते लीन चालीन आव्‌वा बाज र्‌यो। तत्‌यार तीहयो सोराम ने अलग-गलक वाटीन लीवा अने राहेल अने बेम पावर्‌याण ने आप देदो। <verse eid="GEN 33:1" /><verse number="2" style="v" sid="GEN 33:2" />अने तीहयो आखान अगळ बेम पावर्‌याण अने तीमना सोराम ने, तीमनी पछळ लीवा ने तीना सोराम ने, अने आखान पछळ राहेल अने युसुफ ने मेक्‌यो, <verse eid="GEN 33:2" /><verse number="3" style="v" sid="GEN 33:3" />अने आह़फो तीमनी आखा अगळ बड़्‌यो अने सात वार भोयमे पड़ीन वांद्‌यो, अने आह़फा ना भाय ने तां पुग्‌यो। <verse eid="GEN 33:3" /><verse number="4" style="v" sid="GEN 33:4" />तत्‌यार एसाव तीने भेट करवा करीन दवड़्‌यो, अने तीने बाथ मे धरीन गळे लगाड़ीन गोळो देदो, अळतेण बेम जणा रड़ पड़्‌या। <verse eid="GEN 33:4" /><verse number="5" style="v" sid="GEN 33:5" />तत्‌यार तीहयो डोळा उचा करीन बयराम ने अने सोराम ने देख्‌यो; अने पुछ्‌यो, “आहया जे तारी ह़ाते से कोय से?” तीहयो केदो, “आहया तारा पावर ना सोरा से, जीमने भगवान दया करीन मने आपलो से।” <verse eid="GEN 33:5" /><verse number="6" style="v" sid="GEN 33:6" />तत्‌यार सोराम नी भेळ पावर्‌याण ह़ाते आवीन वांद्‌या। <verse eid="GEN 33:6" /><verse number="7" style="v" sid="GEN 33:7" />अळतेण सोराम नी भेळ लीवा ह़ाते आवी, अने तीहया बी एसाव ने वांद्‌या; आखरी मे युसुफ अने राहेल बी ह़ाते आवीन वांदी।<verse eid="GEN 33:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 33:8" />तत्‌यार तीहयो पुछ्‌यो, “तारो आहयो मोट्‌लो टोळो मने भेट्‌यो, तीनु ह़ु मतलब से?” तीहयो केदो, “आहयु के मारा मालीक नी दया नी नींगा मार पोर हये।”<verse eid="GEN 33:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 33:9" />एसाव केदो, “ए मारा भाय, मारी पांह ते रेट से; जे कंय तारु से तीने तारीत पांह रेवा दे।”<verse eid="GEN 33:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 33:10" />याकुब केदो, “नी-नी, कदीम तारी दया मार पोर हय, ता मारी भेट आवरी ले: काहाके मे तारो दरसन हात करीन, मानो भगवान नो दरसन कर्‌यो, अने तु मारी सी खुस हयलो से। <verse eid="GEN 33:10" /><verse number="11" style="v" sid="GEN 33:11" />एतरे आहयी भेट, जे तने आपली से, आवरी ले; काहाके भगवान मने बरकत आपलो से, अने मारी पांह ढेरेत से।” जत्‌यार तीहयो तीने ढेरेत कावा केदो, तत्‌यार तीहयो भेट आवरी लेदो।<verse eid="GEN 33:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 33:12" />अळतेण एसाव केदो, “आव, आपणु अगा बड़या: अने मे तारी अगळ-अगळ चालही।”<verse eid="GEN 33:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 33:13" />याकुब केदो, “ए मारा मालीक, तु जाणे के मार ह़ाते घटाळा सोरा, अने दुद आपवा वाळा गाडरा अने बोकड़्‌या से अने गायु से; कदी आसवा जानवरु एक दाड़ो बी जादा चालहे, ता आखान-आखा मर जहे। <verse eid="GEN 33:13" /><verse number="14" style="v" sid="GEN 33:14" />एतरे मारा मालीक मार गेथो अगो जत रे, अने मे आहया जानवरु नी चाल नी अनसारे जे मारी अगळ से, अने सोराम नी चाल नी अनसारे धीरो-धीरो चालीन सेईर ह़ेर मे मारा मालीक ने तां पुगही।”<verse eid="GEN 33:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 33:15" />एसाव केदो, “ता मारा ह़ातीम मे गेथा थोड़ाक ने तारी ह़ाते रेवा देम।” तीहयो केदो, “आहयु ह़ुका? एतरुत ढेरेत से के मारा मालीक नी दया नी नींगा मार पोर बणीन रेय।” <verse eid="GEN 33:15" /><verse number="16" style="v" sid="GEN 33:16" />तत्‌यार एसाव तेत दाड़े सेईर ह़ेर जवा करीन आह़फा नी वाट्‌ये लाग्‌यो। <verse eid="GEN 33:16" /><verse number="17" style="v" sid="GEN 33:17" />पण याकुब तां गेथो नीकळीन सुक्‌कोत भणी ज्‌यो, अने तां आह़फा जुगु एक घोर, अने जानवरु नी लेदे खोपड़्या बणायो। आहया कारण तीहया जागा नु नाम सुक्‌कोत<note caller="+" style="f"><char style="fr" closed="false">33:17 </char><char style="fq" closed="false">सुक्‌कोत </char><char style="ft" closed="false">खोपड़्‌या नु घोर</char></note> पड़्‌यु।<verse eid="GEN 33:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 33:18" />याकुब जे पदनराम गेथो आवलो हतो, तीहयो कनान देस ना सकेम ह़ेर नी ह़ाते कुसल सेम सी पुगीन हेर नी अगळ पड़ावा उबा कर्‌यो। <verse eid="GEN 33:18" /><verse number="19" style="v" sid="GEN 33:19" />अने धरती ना जे जागा पोर तीहयो आह़फा नु तम्‌बु उबो कर्‌यो, तीने तीहयो सकेम ना बाह हमोर ना सोरा पांह गेथी चांदी ना सीक्‌का मे वेचातु लेदो।<note caller="+" style="x"><char style="xo" closed="false">33:19 </char><char style="xt" closed="false"><ref loc="JHN 4:5">युहन्‌ना 4:5</ref></char></note> <verse eid="GEN 33:19" /><verse number="20" style="v" sid="GEN 33:20" />अने तां तीहयो एक वेदी बणावीन तीनु नाम “एल-एलोहे” पाड़्‌यो मतलब ईस्‌रायल नो भगवान।<verse eid="GEN 33:20" /></para>
  <chapter eid="GEN 33" />
  <chapter number="34" style="c" sid="GEN 34" />
  <para style="s">दीना नी ईज्‌जत लेवा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 34:1" />एक दाड़ो लीवा नी सोरी दीना, जे याकुब सी पयदा हयली हती, तीहया देस ना सोर्‌याम ने भेटवा करीन जी। <verse eid="GEN 34:1" /><verse number="2" style="v" sid="GEN 34:2" />तत्‌यार तीहया देस ना मुख्‌या हीव्‌वी हमोर नो सोरो सकेम तीने देख्‌यो, अने तीने ली जाय्‌न तीनी ह़ाते छीनाळु करीन तीनी ईज्‌जत ली लेदो। <verse eid="GEN 34:2" /><verse number="3" style="v" sid="GEN 34:3" />तत्‌यार तीनु मन याकुब नी सोरी दीना सी लाग ज्‌यु, अने तीहयो तीहयी सोरी सी मोंग नी वातु कर्‌यो, अने तीनी सी मोंग करवा बाज ज्‌यो। <verse eid="GEN 34:3" /><verse number="4" style="v" sid="GEN 34:4" />जत्‌यार सकेम आह़फा ना बाह हमोर ने केदो, “मने आहयी सोरी ने मारी लाडी बणवा करीन अपाड़ दे।”<verse eid="GEN 34:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 34:5" />अने याकुब ह़मळ्‌यो के सकेम मारी सोरी दीना नी ईज्‌जत ली लेदलो से, पण तीना सोरा तीहयी टेमे जानवरु ह़ाते चोवगान मे हता, एतरे तीहयो तीमने आवते लग होगो र्‌यो। <verse eid="GEN 34:5" /><verse number="6" style="v" sid="GEN 34:6" />तत्‌यार सकेम नो बाह हमोर आवीन याकुब ह़ाते वात करवा करीन तीनीन्‌तां ज्‌यो। <verse eid="GEN 34:6" /><verse number="7" style="v" sid="GEN 34:7" />याकुब ना सोरा आहयु ह़मळतेत चोवगान मे गेथा घणा नराज हया अने खीजवाय्‌न पड़्‌या; काहाके सकेम याकुब नी सोरी नी ह़ाते छीनाळु करीन ईस्‌रायल ना घोराणा सी गंडाय नु आसवु काम करलो हतो, जीनु करवु वारु नी हतु। <verse eid="GEN 34:7" /><verse number="8" style="v" sid="GEN 34:8" />हमोर तीहया आखाम ने केदो, “मारा सोरा सकेम नु मन तमारी सोरी पोर घणु लागलु से, एतरे तीने तीनी लाडी हयवा नी लेदे तीने आप देवो। <verse eid="GEN 34:8" /><verse number="9" style="v" sid="GEN 34:9" />अने अमारी ह़ाते वेवा कर्‌या करो; तमारी सोरीम ने आमु ने आप्‌या करो, अने अमारी सोरीम ने तमु लीया करो। <verse eid="GEN 34:9" /><verse number="10" style="v" sid="GEN 34:10" />अने अमारी ह़ाते वहीन रेवो; अने आहयु देस तमारी अगळ पड़ र्‌यु; आनी मे रीन लेन-देन करो, अने आनी जागा ने तमारी जुगु ली लेवो।”<verse eid="GEN 34:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 34:11" />अने सकेम बी दीना ना बाह अने भायु ने केदो, “कदी मारी पोर तमारी दया नी नींगा हय, ता जे कंय तमु मने केवो, तीहयु मे आपही। <verse eid="GEN 34:11" /><verse number="12" style="v" sid="GEN 34:12" />तमु मारी पांह केतरु बी देजु ह़ुका नी मांगो, ते बी मे तमु केय तीनी अनसारे आपही; पण ह़ेली सोरी ने मारी लाडी हयवा करीन मने आपो।”<verse eid="GEN 34:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 34:13" />तत्‌यार आहयो वीच्‌यारीन के सकेम अमारी बेनेह दीना नी ईज्‌जत ली लेदलो से, याकुब ना सोरा सकेम अने तीना बाह हमोर ने चलाकी सी आहयो जपाप आप्‌या, <verse eid="GEN 34:13" /><verse number="14" style="v" sid="GEN 34:14" />“आमु ईसम काम नी कर सकया के काना वण-खतना वाळा अदमी ने अमारी बेनेह आपया; काहाके आनी सी अमारो वाक नीकळहे। <verse eid="GEN 34:14" /><verse number="15" style="v" sid="GEN 34:15" />आहयी वात पोर ते आमु तमारी मान लेहु के अमारीन तेम तमारी मे गेथा आखा अदमी नु खतनु करे। <verse eid="GEN 34:15" /><verse number="16" style="v" sid="GEN 34:16" />तत्‌यार आमु अमारा सोर्‌याम ने तमने आलहु, अने तमारा सोर्‌याम ने लावहु, अने तमारी ह़ाते वहीन बी रेहु, अने आपणु बेम एकीत घोराणा ना माणहु हय जहु। <verse eid="GEN 34:16" /><verse number="17" style="v" sid="GEN 34:17" />पण कदी तमु अमारी वात नी मानीन आह़फाम नु खतनु नी करो, ता आमु अमारा सोर्‌याम ने लीन आञे गेथा जत रेहु।”<verse eid="GEN 34:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 34:18" />तीनी आहयी वात पोर हमोर अने तीनो सोरो सकेम खुस हया। <verse eid="GEN 34:18" /><verse number="19" style="v" sid="GEN 34:19" />अने तीहयो जुवान्‌यो जे याकुब नी सोरी ने घणो मोंग करतो हतो, आहया काम ने करवा मे तीहयो वार नी लगाड़्‌यो। तीहयो ते आह़फा ना बाह ना आखा घोराणा मे ढेरेत ईज्‌जत वाळो हतो।<verse eid="GEN 34:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 34:20" />एतरे हमोर अने तीनो सोरो सकेम आह़फा ना ह़ेर ना झापला नी ह़ाते जाय्‌न ह़ेर वाळाम ने ह़मजाड़वा बाज ज्‌यो; <verse eid="GEN 34:20" /><verse number="21" style="v" sid="GEN 34:21" />“तीहया माणहु ते अमारी ह़ाते मेळ सी रेवा हींड र्‌या; एतरे तीमने आहया देस मे रीन लेन-देन करवा देवो; देखो, आहयु देस तीमनी जुगु बी ढेरेत से; तत्‌यार आमु तीमनी सोर्‌याम ने वेवा करीन लावे, अने आपणी सोर्‌याम ने आप्‌या करे। <verse eid="GEN 34:21" /><verse number="22" style="v" sid="GEN 34:22" />तीहया माणहु नीस्‌ता आहयी वात पोर अमारी ह़ाते रेवा अने एकीत घोराणा ना माणहु हय जवा करीन खुस से के तीमनीन तेम अमारा माणहु नु बी खतनु करे। <verse eid="GEN 34:22" /><verse number="23" style="v" sid="GEN 34:23" />ह़ु तीमना गाडरा अने बोकड़्‌या, अने गाय अने बोळद्‌या अने तीमना आखा जानवरु अने धन-दवलत आपणु नी हय जाय? आतरुत करे के आपणु आखा तीमनी वात मान लेय, ता तीहया आपणी ह़ाते रेहे।” <verse eid="GEN 34:23" /><verse number="24" style="v" sid="GEN 34:24" />एतरे जेतरा तीहया ह़ेर ना झापले गेथा नीकळता हता, तीहया आखा हमोर नी अने तीना सोरा सकेम नी वात मान्‌या; अने आखा अदमी नु खतनु कर्‌या, जेतरा तीहया ह़ेर ना झापले गेथा नीकळता हता।<verse eid="GEN 34:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 34:25" />तीसरे दाड़े, जत्‌यार तीहया माणहु मांदला पड़ र्‌या हता, तत्‌यार आसम हयु के सीमोन अने लेवी नाम ना याकुब ना बे सोरा, जे दीना ना भाय हता, आपणी-आपणी तलवार लीन तीहया ह़ेर मे बीह्‌या वगर भराय्‌न आखा अदमी ने मार नाख्‌या। <verse eid="GEN 34:25" /><verse number="26" style="v" sid="GEN 34:26" />हमोर अने तीना सोरा सकेम ने तीहया तलवार वेर मार नाख्‌या, अने दीना ने सकेम ना घोर मे गेथी नीकाळ ली ज्‌या। <verse eid="GEN 34:26" /><verse number="27" style="v" sid="GEN 34:27" />याकुब ना सोरा आखाम ने मार नाखवा पोर बी हमलो करीन ह़ेर ने आनीन करते लुट लेदा के तीनी मे तीमनी बेनेह नी ईज्‌जत ली लेदा हता। <verse eid="GEN 34:27" /><verse number="28" style="v" sid="GEN 34:28" />तीहया गाडरा अने बोकड़्‌या, अने गाय अने बोळद्‌या, अने गदड़ा, अने ह़ेर अने चोवगान मे जेतरु धन हतु ली लेदा। <verse eid="GEN 34:28" /><verse number="29" style="v" sid="GEN 34:29" />तीहया आखाम ने, अने तीमना बाळ-बच्‌चा, अने बयराम ने बी हापकी ली ज्‌या, अने घोर-घोर मे जे कंय हतु, तीने बी तीहया लुट लेदा।<verse eid="GEN 34:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 34:30" />तत्‌यार याकुब सीमोन अने लेवी ने केदो, “तमु जे आहया देस मे रेवा वाळा कनानीयो अने परीज्‌जीयो ना मन मे मारीन करते वेर पयदा करावला से, आनी सी तमु मने वेला मे नाख देदला से, काहाके मार ह़ाते थोड़ाक माणहु से, एतरे हाव तीहया एकठा हय्‌न मारी पोर हमलो करहे, अने मने मार नाक्‌खे, ता मे मारा घोराणा भेळ खत्‌तम हय जही।”<verse eid="GEN 34:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 34:31" />तीहया केदा, “ह़ु तीहया अमारी बेनेह नी ह़ाते रंडीन तेम वेहवार करे?”<verse eid="GEN 34:31" /></para>
  <chapter eid="GEN 34" />
  <chapter number="35" style="c" sid="GEN 35" />
  <para style="s">बेतेल मे भगवान याकुब ने बरकत आपे</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 35:1" />तत्‌यार भगवान याकुब ने केदो, “आञे गेथो नीकळीन बेतेल जा, अने तांत रेजे; अने भगवान नी लेदे वेदी बणाव, जे तने तीहयी टेमे दरसन आपलो, जत्‌यार तु आह़फा ना भाय एसाव नी बीक ना कारण सी नाह जेलो हतो।”<note caller="+" style="x"><char style="xo" closed="false">35:1 </char><char style="xt" closed="false"><ref loc="GEN 28:11-17">उबजणाय कीताप 28:11-17</ref></char></note><verse eid="GEN 35:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="GEN 35:2" />तत्‌यार याकुब आह़फा नु घोराणु ने, अने तीहया आखाम ने जे तीनी ह़ाते हता, केदो, “तमारी वच मे जे बीजो देवता से, तीने नीकाळ नाखो; अने आह़फा-आह़फाम ने चोखा करो, अने आह़फाम ना लुगड़ा बदली देवो; <verse eid="GEN 35:2" /><verse number="3" style="v" sid="GEN 35:3" />अने आवो, आमु आञे गेथा नीकळीन बेतेल जजे; तां मे भगवान जुगु एक वेदी बणावही, जे वेला ना दाड़ा मे मारी ह़मळ लेदो, अने जे वाट्‌ये मे चालतो हतो, तीनी मे मारी ह़ाते र्‌यो।” <verse eid="GEN 35:3" /><verse number="4" style="v" sid="GEN 35:4" />एतरे जेतरा बीजा देवता तीनी पांह हता, अने जेतरा गोखरा तीना कांटा मे हता, तीहया आखाम ने याकुब ने आप्‌या; अने तीहयो तीमने तीहया वांज्‌या झाड़ तळे, जे सकेम नी पांह हतु गाड़ देदो।<verse eid="GEN 35:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 35:5" />तत्‌यार तीहया चाल पड़्‌या; अने तीमनी च्‌यारो-मेर ना ह़ेर मे रेवा वाळाम ना मन मे भगवान भणी गेथी आसम बीक बह जी, के तीहया याकुब ना सोराम नी पछळ नी पड़्‌या। <verse eid="GEN 35:5" /><verse number="6" style="v" sid="GEN 35:6" />याकुब तीहया आखा भेळ, जे तीनी ह़ाते हता, कनान देस ना लुज ह़ेर मे आयो तीहयु ह़ेर बेतेल बी केवायत्‌लु। <verse eid="GEN 35:6" /><verse number="7" style="v" sid="GEN 35:7" />तां तीहयो एक वेदी बणायो, अने तीहया जागा नु नाम एलबेतेल <note caller="+" style="f"><char style="fr" closed="false">35:7 </char><char style="fq" closed="false">एलबेतेल </char><char style="ft" closed="false">बेतेल नो भगवान</char></note>पाड़्‌यो; काहाके जत्‌यार तीहयो आह़फा ना भाय नी बीक ना कारण सी नाहीन जतो हतो तत्‌यार भगवान तीनी पोर तांत उजन्‌तो हयलो हतो। <verse eid="GEN 35:7" /><verse number="8" style="v" sid="GEN 35:8" />अने रीबका नी दुद पीवाड़वा वाळी पावर्‌याण दबोरा मर जी, अने बेतेल ना वांज्‌या झाड़ नु नाम अल्‌लोनबक्‌कुत<note caller="+" style="f"><char style="fr" closed="false">35:8 </char><char style="fq" closed="false">अल्‌लोनबक्‌कुत </char><char style="ft" closed="false">रड़ाव्‌वा वाळु झाड़</char></note> पाड़ देदो।<verse eid="GEN 35:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 35:9" />अळतेण याकुब पदनराम गेथो आव्‌वान अळतेण भगवान तीने बीजी कावा दरसन आपीन बरकत आप्‌यो। <verse eid="GEN 35:9" /><verse number="10" style="v" sid="GEN 35:10" />अने भगवान तीने केदो, “हाव लग ते तारु नाम याकुब र्‌यु; पण अगु तारु नाम याकुब नी रेय, तु ईस्‌रायल केवायही।” आहयी रीते तीहयो तीनु नाम ईस्‌रायल पाड़्‌या।<note caller="+" style="x"><char style="xo" closed="false">35:10 </char><char style="xt" closed="false"><ref loc="GEN 32:28">उबजणाय कीताप 32:28</ref></char></note> <verse eid="GEN 35:10" /><verse number="11" style="v" sid="GEN 35:11" />अळी भगवान तीने केदो, “मे आखा मे जोर-भर्‌यो भगवान से। तु फुले-फाले अने वदे; अने तारी लारे एक राज्‌य नी पण राज्‌य नी मोट्‌ली मंडळी बी पयदा हये, अने तारी अवल्‌यात मे राजा पयदा हयहे।<note caller="+" style="x"><char style="xo" closed="false">35:11 </char><char style="xt" closed="false"><ref loc="GEN 17:4">उबजणाय कीताप 17:4</ref>,<ref loc="GEN 17:8">8</ref></char></note> <verse eid="GEN 35:11" /><verse number="12" style="v" sid="GEN 35:12" />अने जे देस मे अब्‌राहम अने ईसाक ने आपलो से, तीहयुत देस तने आपु, अने तारी पछळ तारी अवल्‌यात ने बी आलही।” <verse eid="GEN 35:12" /><verse number="13" style="v" sid="GEN 35:13" />तत्‌यार भगवान तीहया जागा मे, जां तीहयो याकुब ह़ाते वात कर्‌यो, तीनीन्‌तां गेथो उपर चड़ ज्‌यो। <verse eid="GEN 35:13" /><verse number="14" style="v" sid="GEN 35:14" />अने जे जागा मे भगवान याकुब ह़ाते वातु कर्‌यो, तां याकुब दगड़ा नो एक खम्‌बो उबो कर्‌यो, अने तीनी पोर अंगुर नो रोह अने जेतुन नु तेल नाख्‌यो। <verse eid="GEN 35:14" /><verse number="15" style="v" sid="GEN 35:15" />जां भगवान याकुब ह़ाते वात कर्‌यो, तीहया जागा नु नाम तीहयो बेतेल पाड़्‌यो।<verse eid="GEN 35:15" /></para>
  <para style="s">राहेल नी मोत</para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 35:16" />अळतेण तीहया बेतेल गेथा चाल पड़या; अने एप्‌राता ह़ेर थोड़ोक नाम्‌बे री र्‌यु हतु के राहेल ने सोरु हयवा नी करते दुखवा बाज ज्‌यु। <verse eid="GEN 35:16" /><verse number="17" style="v" sid="GEN 35:17" />जत्‌यार तीने जादा-जादा दुखतु हतु ता ह़ोयाणी तीने केदी, “ना बीहे; हाव बी तारो सोरोत हयहे।” <verse eid="GEN 35:17" /><verse number="18" style="v" sid="GEN 35:18" />तत्‌यार आसम हयु के तीहयी सोरु जणी ने मर जी, अने जीव नीकळते-नीकळते तीहयी ते सोरा नु नाम बेनोनी<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="fq" closed="false">बेनोनी </char><char style="ft" closed="false">मारा दुख नो सोरो</char></note> पाड़ी; पण तीनो बाह तीनु नाम बीन्‌यामीन<note caller="+" style="f"><char style="fr" closed="false">35:18 </char><char style="fq" closed="false">बीन्‌यामीन </char><char style="ft" closed="false">मारा जमण्‌या हात नो सोरो</char></note> पाड़्‌यो।<verse eid="GEN 35:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 35:19" />अने राहेल मर जी, अने एप्‌राता मतलब बेतलहम नी वाट्‌ये, तीने गाड़ देदा। <verse eid="GEN 35:19" /><verse number="20" style="v" sid="GEN 35:20" />अने याकुब तीना मड़ाट्‌या पोर एक खम्‌बो उबो कर्‌यो: राहेल नो मड़ाट्‌या नो खम्‌बो आज लग उबलोत से। <verse eid="GEN 35:20" /><verse number="21" style="v" sid="GEN 35:21" />अळतेण ईस्‌रायल अगो चाल पड़्‌यो, अने एदेर नाम ना गुम्‌मट नी अगळ आह़फा नु तम्‌बु उबो कर्‌यो।<verse eid="GEN 35:21" /></para>
  <para style="s">याकुब ना सोरा</para>
  <para style="r">(<ref loc="1CH 2:1">1 ईतीहास 2:1</ref>,<ref loc="1CH 2:2">2</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 35:22" />जत्‌यार ईस्‌रायल तीहया देस मे वहलो हतो, तत्‌यार एक दाड़े आसम हयु के रुबेन जाय्‌न आह़फा ना बाह नी बील्‌हा नाम नी पावर्‌याण हती तीने राख र्‌यो हतो तीनी ह़ाते छीनाळु कर्‌यो, अने आहयी वात याकुब ने मालम पड़ जी। याकुब ना बारे सोरा हया। <verse eid="GEN 35:22" /><verse number="23" style="v" sid="GEN 35:23" />तीमनी मे गेथा लीवा ना सोरा आहया हता; याकुब नो मोट्लो सोरो रुबेन, अळतेण सीमोन, लेवी, यहुदा, ईस्‌साकार अने जबुलुन। <verse eid="GEN 35:23" /><verse number="24" style="v" sid="GEN 35:24" />अने राहेल ना सोरा आहया हता; युसुफ अने बीन्‌यामीन। <verse eid="GEN 35:24" /><verse number="25" style="v" sid="GEN 35:25" />अने राहेल नी पावर्‌याण बील्‌हा ना सोरा आहया हता; दान, अने नप्‌ताली। <verse eid="GEN 35:25" /><verse number="26" style="v" sid="GEN 35:26" />अने लीवा नी पावर्‌याण जील्‌पा ना सोरा आहया हता; गाद, अने आसेर। याकुब ना एतरात सोरा हया, जे तीनी सी पदनराम मे पयदा हया।<verse eid="GEN 35:26" /></para>
  <para style="s">ईसाक नी मोत</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 35:27" />अने याकुब मम्‌रे मे, जे कीर्‌यतर्‌बा, मतलब हेब्‌रोन से, जां अब्‌राहम अने ईसाक परदेसी हय्‌न रेला हता, आह़फा ना बाह ईसाक पांह आयो। <verse eid="GEN 35:27" /><verse number="28" style="v" sid="GEN 35:28" />ईसाक नी उमर एक ह़ोव अस्‌सी साल नी हयी।<note caller="+" style="x"><char style="xo" closed="false">35:28 </char><char style="xt" closed="false"><ref loc="GEN 13:18">उबजणाय कीताप 13:18</ref></char></note> <verse eid="GEN 35:28" /><verse number="29" style="v" sid="GEN 35:29" />अने ईसाक नो जीव नीकळी ज्‌यो, अने तीहयो मर ज्‌यो, अने तीहयो डायो अने पुरी उमर नो हय्‌न आह़फा ना माणहु मे जाय्‌न भेसकाय ज्‌यो; अने तीना सोरा एसाव अने याकुब तीने गाड़ देदा।<verse eid="GEN 35:29" /></para>
  <chapter eid="GEN 35" />
  <chapter number="36" style="c" sid="GEN 36" />
  <para style="s">एसाव नो कुळी वेलो</para>
  <para style="r">(<ref loc="1CH 1:34-37">1 ईतीहास 1:34-37</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 36:1" />एसाव जे एदोम बी केवाये, तीनो आहयो कुळी वेलो से। <verse eid="GEN 36:1" /><verse number="2" style="v" sid="GEN 36:2" />एसाव ते कनानी सोर्‌याम सी वेवा कर्‌यो; आहया तीना बयरा हता: हीत्‌ती एलोन नी सोरी आदा ने, अने ओहोलीबामा ने जे अना नी सोरी, अने हीव्‌वी सीबोन ना सोरी नी सोरी नी सोरी हती।<note caller="+" style="x"><char style="xo" closed="false">36:2 </char><char style="xt" closed="false"><ref loc="1CH 1:34-37">1 ईतीहास 1:34-37</ref></char></note> <verse eid="GEN 36:2" /><verse number="3" style="v" sid="GEN 36:3" />अळतेण तीहयो ईस्‌माएल नी सोरी बासमत ने बी, जे नबायोत नी बेनेह हती, वेवा कर लेदो।<note caller="+" style="x"><char style="xo" closed="false">36:3 </char><char style="xt" closed="false"><ref loc="GEN 28:9">उबजणाय कीताप 28:9</ref> </char></note> <verse eid="GEN 36:3" /><verse number="4" style="v" sid="GEN 36:4" />आदा एसाव नी लारे एलीपज ने, अने बासमत रुएल ने पयदा करी। <verse eid="GEN 36:4" /><verse number="5" style="v" sid="GEN 36:5" />अने ओहोलीबामा ने युस, अने यालाम, अने कोरह ने पयदा करी। एसाव ना आहयात सोरा कनान देस मे पयदा हया।<verse eid="GEN 36:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 36:6" />तत्‌यार एसाव आह़फा नी लाड्‌यु ने, अने सोरा-सोरीम ने, अने घोर ना आखा जानवरुम, अने गाडरा अने बोकड़्‌या, अने गाय-बोळद्‌या अने आखा जानवरु, अने आह़फी आखी धन-दवलत ने, जे तीहयो कनान देस मे भेळी करलो हतो, लीन आह़फा भाय याकुब नी पांह गेथो बीजा देस जत र्‌यो। <verse eid="GEN 36:6" /><verse number="7" style="v" sid="GEN 36:7" />काहाके तीनी धन-दवलत एतरी हय जी हती, के तीहया एकठा नी री सक्‌या; अने जानवरु ढेरेत हयवा नी कारण तीहया देस मे, जां तीहया परदेसी हय्‌न रेता हता, ते एकठा नी री सक्‌या। <verse eid="GEN 36:7" /><verse number="8" style="v" sid="GEN 36:8" />एसाव जे एदोम बी केवाये, सेईर नाम ना बड़ा वाळा देस मे रेवा लाग्‌यो।<verse eid="GEN 36:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 36:9" />सेईर नाम ना बड़ा ना देस मे रेवा वाळा एदोमीया ना मुख्‌या अदमी एसाव नी पीड़ी आहयी से। <verse eid="GEN 36:9" /><verse number="10" style="v" sid="GEN 36:10" />एसाव ना सोराम ना नाम आहया से; एसाव नी लाडी आदा नो सोरो एलीपज, अने तीहयात एसाव नी लाडी बासमत नो सोरो रुएल। <verse eid="GEN 36:10" /><verse number="11" style="v" sid="GEN 36:11" />अने एलीपज ना सोरा हया; तेमान, ओमार, सपो, गाताम, अने कनज। <verse eid="GEN 36:11" /><verse number="12" style="v" sid="GEN 36:12" />एसाव ना सोरा एलीपज नी तीम्‌ना नाम नी एक पावर्‌याण हती तीने तीहयो राखी र्‌यो हतो; जे एलीपज नी लारे अमालेक ने पयदा करी: एसाव नी लाडी आदा नी अवल्‌यात मे आहयात हया। <verse eid="GEN 36:12" /><verse number="13" style="v" sid="GEN 36:13" />रुएल ना आहया सोरा हया; नहत, जेरह, सम्‌मा, अने मीज्‌जा एसाव नी लाडी बासमत नी अवल्‌यात मे आहयात हया।<verse eid="GEN 36:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 36:14" />ओहोलीबामा जे एसाव नी लाडी, अने सीबोन नी सोरा नी सोरी अने अना नी सोरी, हती तीना आहया सोरा हया: तीहयी एसाव नी लारे युस, यालाम अने कोरह ने पयदा करी।<verse eid="GEN 36:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 36:15" />एसाव ना घोराणा ना मुख्‌या आहया हया: एसाव नो मोट्‌लो सोरो एलीपज नी अवल्‌यात मे सी ते तेमान मुख्‌यो, ओमार मुख्‌यो, सपो मुख्‌यो, कनज मुख्‌यो, <verse eid="GEN 36:15" /><verse number="16" style="v" sid="GEN 36:16" />कोरह मुख्‌यो, गाताम मुख्‌यो, अमालेक मुख्‌यो एलीपज अवल्‌यात मे सी, एदोम देस मे आहयात मुख्‌या हया: अने आहयात आदा ना अवल्‌यात हया।<verse eid="GEN 36:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 36:17" />एसाव ना सोरा रुएल नी अवल्‌यात मे आहया हया; नहत मुख्‌यो, जेरह मुख्‌यो, सम्‌मा मुख्‌यो, मीज्‌जा मुख्‌यो रुएल ना घोराणा मे सी, एदोम देस मे आहयात मुख्‌या हया; अने आहयात एसाव नी लाडी बासमत नी अवल्‌यात मे हया।<verse eid="GEN 36:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 36:18" />एसाव नी लाडी ओहोलीबामा नी अवल्‌यात मे आहया हया; युस मुख्‌यो, यालाम मुख्‌यो, कोरह मुख्‌यो, अना नी सोरी ओहोलीबामा जे एसाव नी लाडी हती तीनी अवल्‌यात मे आहयात हया। <verse eid="GEN 36:18" /><verse number="19" style="v" sid="GEN 36:19" />एसाव जे एदोम बी केवायत्‌लो से, तीनी अवल्‌यात आहयात से, अने तीमना मुख्‌या बी आहयात हया।<verse eid="GEN 36:19" /></para>
  <para style="s">सेईर नो कुळी वेलो</para>
  <para style="r">(<ref loc="1CH 1:38-42">1 ईतीहास 1:38-42</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 36:20" />सेईर जे होरी नाम नी जाती नो हतो, तीना आहया सोरा तीहया देस मे पेले सी रेता हता; लोतान, सोबाल, सीबोन, अना, <verse eid="GEN 36:20" /><verse number="21" style="v" sid="GEN 36:21" />दीसोन एसेर, अने दीसान: एदोम देस मे सेईर ना आहयात होरी जाती ना मुख्‌या हया।<verse eid="GEN 36:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 36:22" />लोतान ना सोरा, होरी अने हेमाम हया; अने लोतान नी बेनेह तीम्‌ना हती।<verse eid="GEN 36:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 36:23" />सोबाल ना आहया सोरा हया: आल्‌वान, मानहत, एबाल, सपो, अने ओनाम।<verse eid="GEN 36:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 36:24" />अने सीदोन ना आहया सोरा हया: अय्‌या, अने अना; आहयी तेत अना से जीने उजाड़ी बड़ा मे आह़फा ना बाह सीबोन ना गदड़ा ने चारते-चारते उन्‌ला पाणी ना झोर जड़्‌या। <verse eid="GEN 36:24" /><verse number="25" style="v" sid="GEN 36:25" />अने अना नो दीसोन नाम नो सोरो हयो, अने तीहयी अना नो ओहोलीबामा नाम नी सोरी हयी। <verse eid="GEN 36:25" /><verse number="26" style="v" sid="GEN 36:26" />दीसोन ना आहया सोरा हया: हेमदान, एसबान, यीत्‌रान, अने करान।<verse eid="GEN 36:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 36:27" />एसेर ना आहया सोरा हया: बील्‌हान, जावन, अने अकान।<verse eid="GEN 36:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 36:28" />दीसान ना आहया सोरा हया: उस, अने अरान।<verse eid="GEN 36:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 36:29" />होरीयो ना मुख्‌या आहया हया: लोतान मुख्‌यो, सोबाल मुख्‌यो, सीबोन मुख्‌यो, अना मुख्‌यो, <verse eid="GEN 36:29" /><verse number="30" style="v" sid="GEN 36:30" />दीसोन मुख्‌यो, एसेर मुख्‌यो, दीसान मुख्‌यो; सेईर देस मे होरी जाती वाळा आहयात मुख्‌या हया।<verse eid="GEN 36:30" /></para>
  <para style="s">एदोम नो राजा</para>
  <para style="r">(<ref loc="1CH 1:43-54">1 ईतीहास 1:43-54</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 36:31" />अळतेण जत्‌यार ईस्‌रायली माणहु पोर कानो बी राजा राज्‌य नी करलो हतो, तत्‌यार बी एदोम ना देस मे आहया राजा हया; <verse eid="GEN 36:31" /><verse number="32" style="v" sid="GEN 36:32" />बोर नो सोरो बेला एदोम मे राज्‌य कर्‌यो, अने तीनी राजधानी नु नाम दीन्‌हाबा से। <verse eid="GEN 36:32" /><verse number="33" style="v" sid="GEN 36:33" />बेला ने मरवा बाद, बोस्‌रा मे रेवा वाळो जेरह नो सोरो योबाब तीना जागा पोर राजा बण्‌यो। <verse eid="GEN 36:33" /><verse number="34" style="v" sid="GEN 36:34" />योबाब ने मरवा बाद, तेमानीयो ना देस मे रेवा वाळो हुसाम तीनी जागा पोर राजा बण्‌यो। <verse eid="GEN 36:34" /><verse number="35" style="v" sid="GEN 36:35" />अळतेण हुसाम ने मरवा बाद, बदद नो सोरो हदद तीनी जागा पोर राजा बण्‌यो आहयो तेत से जे मीद्‌यानीयो ने मोवाब ना देस मे हराय देदो, अने तीनी राजधानी नु नाम अबीत से। <verse eid="GEN 36:35" /><verse number="36" style="v" sid="GEN 36:36" />हदद ने मरवा नी बाद, मस्‌रेका ह़ेर मे रेवा वाळो सम्‌ला तीनी जागा पोर राजा बण्‌यो। <verse eid="GEN 36:36" /><verse number="37" style="v" sid="GEN 36:37" />अळतेण सम्‌ला ने मरवा नी बाद साउल जे मोट्‌ली नंदी नी धेड़े वाळा रहोबोत ह़ेर नो हतो, तीहयो तीनी जागा पोर राजा बण्‌यो। <verse eid="GEN 36:37" /><verse number="38" style="v" sid="GEN 36:38" />साउल ने मरवा नी बाद, अकबोर नो सोरो बाल्‌हानान तीनी जागा पोर राजा बण्‌यो। <verse eid="GEN 36:38" /><verse number="39" style="v" sid="GEN 36:39" />अकबोर ना सोरा बाल्‌हानान ने मरवा नी बाद, हदर तीनी जागा पोर राजा बण्‌यो अने तीनी राजधानी नु नाम पाउ से; अने तीनी लाडी नु नाम महेतबेल से, जे मेजाहब नी सोरा नी सोरी से अने मत्‌रेद नी सोरी हती।<verse eid="GEN 36:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="GEN 36:40" />अळतेण एसाव ना घोराणा ना मुख्‌याम ना घोराणाम, अने जागा नी अनसारे तीमना नाम आहया से तीम्‌ना मुख्‌यो, अल्‌वा मुख्‌यो, यतेत मुख्‌यो, <verse eid="GEN 36:40" /><verse number="41" style="v" sid="GEN 36:41" />ओहोलीबामा मुख्‌यो, एला मुख्‌यो, पीनोन मुख्‌यो, <verse eid="GEN 36:41" /><verse number="42" style="v" sid="GEN 36:42" />कनज मुख्‌यो, तेमान मुख्‌यो, मीबसार मुख्‌यो, <verse eid="GEN 36:42" /><verse number="43" style="v" sid="GEN 36:43" />मग्‌दीएल मुख्‌यो, ईराम मुख्‌यो एदोम मे रेवा वाळा जे देस ने आपणु कर लेदला हता, तीमना रेवा वाळा जागा मे आहयात मुख्‌या हया; अने एदोमी जाती नो डायलो बाह एसाव से।<verse eid="GEN 36:43" /></para>
  <chapter eid="GEN 36" />
  <chapter number="37" style="c" sid="GEN 37" />
  <para style="s">युसुफ अने तीना भाय</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 37:1" />याकुब ते कनान देस मे रेतो हतो, जां तीनो बाह परदेसी हय्‌न रेतो हतो। <verse eid="GEN 37:1" /><verse number="2" style="v" sid="GEN 37:2" />अने याकुब नी अवल्‌यात ना बारा मे आहयु से: युसुफ ह़त्‌रे साल नो हय्‌न आह़फा भायु नी ह़ाते गाडरा अने बोकड़ाम ने चारतो हतो; अने तीहयो सोरो आह़फा नी बाह नी लाडी बील्‌हा, अने जील्‌पा ना सोराम नी ह़ाते रीया करतो हतो; अने तीमनी गंडाय नी खबर आह़फा ना बाह ने पां पुगाड़्‌या करतो हतो।<verse eid="GEN 37:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 37:3" />अने ईस्‌रायल आह़फा आखा सोराम सी बड़ीन युसुफ सी मोंग करतो हतो, काहाके तीहयो तीना डायावारा नो सोरो हतो: अने तीहयो तीनी जुगु हात वाळु डगलु बणावलो हतो। <verse eid="GEN 37:3" /><verse number="4" style="v" sid="GEN 37:4" />पण जत्‌यार तीना भायु देख्‌या के अमारो बाह आमु आखा भायु सी जादा तीनी सी मोंग राखे, तत्‌यार तीहया तीनी सी वेर करवा बाज ज्‌या अने तीनी ह़ाते वारु वात बी नी करता हता।<verse eid="GEN 37:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 37:5" />युसुफ एक ह़पनु देख्‌यो, अने आह़फा ना भायुम ने तीनी बारा मे केदो; तत्‌यार तीहया तीनी सी अळी बी जादा बुराय करवा बाज ज्‌या। <verse eid="GEN 37:5" /><verse number="6" style="v" sid="GEN 37:6" />युसुफ तीमने केदो, “जे ह़पनु मे देखलो से, तीने ह़मळो। <verse eid="GEN 37:6" /><verse number="7" style="v" sid="GEN 37:7" />आपणु आखा खेतर मे पुळा बांदवा बाज र्‌या, अने ह़ु देख्‌यो के मारो पुळो उठीन ह़ुदो उबो हय ज्‌यो; तत्‌यार तमारा पुळा मारा पुळा ने च्‌यारो-मेर सी घेरवी लेदा अने तीने वांद्‌या।”<verse eid="GEN 37:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 37:8" />तत्‌यार तीना भायु तीने केदा, “ह़ु ह़ाचलीन तु अमारी उपर राज करही?” नीता ह़ु ह़ाचलीन तु अमारी पोर हक जमाड़ही? एतरे तीहया तीना ह़पना अने तीनी वातु नी कारण तीनी सी अळी बी जादा वेर करवा बाज ज्‌या।<verse eid="GEN 37:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 37:9" />अळतेण तीहयो एक अळी ह़पनु देख्‌यो, अने आह़फा ना भायु सी तीनु बी आहयु देखाड़्‌यो, “ह़मळो, मे एक अळी ह़पनु देखलो से, के दाहड़ो अने चांद, अने ग्‌यारे तारा मने वांदवा बाज र्‌या।”<verse eid="GEN 37:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 37:10" />आहया ह़पना ने तीहयो आह़फा बाह अने भायु सी केदो; तत्‌यार तीनो बाह तीने दाक्‌तर केदो, “आहयु कीसम ह़पनु से जे तु देखलो से? ह़ु ह़ाचलीन मे अने तारी आह्‌य अने तारा भाय आखा जाय्‌न तारी अगळ भोयमे पड़ीन वांदह़ु?” <verse eid="GEN 37:10" /><verse number="11" style="v" sid="GEN 37:11" />तीना भाय ते तीनी सी डहवाय करता हता; पण तीनो बाह तीनी आखी वात ने फोम राख्‌यो।<note caller="+" style="x"><char style="xo" closed="false">37:11 </char><char style="xt" closed="false"><ref loc="ACT 7:9">नेवताळा ना काम 7:9</ref></char></note><verse eid="GEN 37:11" /></para>
  <para style="s">युसुफ ने वेचवा</para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 37:12" />युसुफ ना भाय आह़फा बाह ना गाडरा अने बोकड़ाम ने चारवा करीन सकेम ह़ेर मे ज्‌या। <verse eid="GEN 37:12" /><verse number="13" style="v" sid="GEN 37:13" />तत्‌यार ईस्‌रायल युसुफ ने केदो, “तारा भाय सकेम मेत गाडरा अने बोकड़ाम ने चारता हहे, एतरे जा, मे तने तीमनी पांह मोकलु।” तीहयो तीने केदो, “जे हुकम मे हजुर से।”<verse eid="GEN 37:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 37:14" />याकुब युसुफ सी केदो, “जा, आह़फा भायुम अने गाडरा अने बोकड़ाम नु हाल चाल देखीन आव के तीहया वारला ते से, बाद मे मारी पांह खबर लीन आव।” तत्‌यार तीहयो तीने हेब्‌रोन नी वारली जागा मे वळाय देदा, अने तीहयो सकेम मे ज्‌यो। <verse eid="GEN 37:14" /><verse number="15" style="v" sid="GEN 37:15" />अने कानो अदमी तीने चोवगान मे जींखर-तींखर फीरत्‌लो देखीन तीने पुछ्‌या, “तु ह़ु ह़ोदवा बाज र्‌यो?”<verse eid="GEN 37:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 37:16" />तीहयो केदो, “मे ते मारा भायुम ने ह़ोदवा बाज र्‌यो दया करीन मने देखाड़ के तीहया गाडरा अने बोकड़ाम ने कां चारवा बाज र्‌या?”<verse eid="GEN 37:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 37:17" />तीहयो माणेह केदो, “तीहया ते आञे गेथा जत र्‌या; अने मे तीमने आहयु केते ह़मळ्‌यो, ‘आवु, आपणु दोतान ह़ेर भणी जता’।” एतरे युसुफ आह़फा भायुम नी पछळ चाल पड़्‌यो, अने तीमने दोतान ह़ेर मे हात कर्‌यो।<verse eid="GEN 37:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 37:18" />जीसमेत तीहया तीने नाम्‌बे आवत्‌लो देख्‌या, ता तीन ह़ाते आव्‌वा सी पेले तीने मार नाखवा नी योजना बणाया। <verse eid="GEN 37:18" /><verse number="19" style="v" sid="GEN 37:19" />अने तीहया आह़फा केवा बाज ज्‌या, “देखो, ह़ेलो ह़पनु देखवा वाळो आवा बाज र्‌यो। <verse eid="GEN 37:19" /><verse number="20" style="v" sid="GEN 37:20" />एतरे आवो, आपणु हीने मारीन काना खाडा मे नाख दीया, अने आहयु की देहु, के कानो जंगली जानवर तीने खाय ज्‌यो। अळतेण आपणु देक्‌खु के हीना ह़पनाम नु ह़ु फोळ हयहे।”<verse eid="GEN 37:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 37:21" />आहयु ह़मळीन रुबेन तीने तीमना हात सी बचाड़वा ना वीच्‌यार सी केदो, “आपणु हीने मारया एतरा नी।” <verse eid="GEN 37:21" /><verse number="22" style="v" sid="GEN 37:22" />अळी रुबेन तीमनी सी केदो, “लोय ना वयाड़ो, हीने जंगल ना आहया खाडा मे नाख देवो, अने हीने देजो नी।” तीहयो तीने तीमना हात सी छोड़ावीन बाह नी पांह अळी पुगाड़वा हींडतो हतो। <verse eid="GEN 37:22" /><verse number="23" style="v" sid="GEN 37:23" />एतरे आसम हयु के जत्‌यार युसुफ आह़फा भायुम नी पांह पुग्‌यो ता तीहया तीनु ह़जाड़ीन घटाळु डगलु, जीने तीहयो पेरी र्‌यो हतो नीकाळ लेदा। <verse eid="GEN 37:23" /><verse number="24" style="v" sid="GEN 37:24" />अने युसुफ ने उचलीन खाडा मे नाख देदा। तीहयो खाडो ह़ुकलो हतो अने तीनी मे कंय पाणी नी हतु।<verse eid="GEN 37:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 37:25" />तत्‌यार तीहया रोट्‌ला खावा बह ज्‌या; अने डोळा उचा करीन ह़ु देख्‌या के ईस्‌माएली माणहु नु एक टोळो उटड़ा पोर गंदायण्‌यु तेल, बलसान, अने गंदायण्‌यो रस मेकीन, गीलाद सी मीस्‌र देस भणी जवा बाज र्‌यो। <verse eid="GEN 37:25" /><verse number="26" style="v" sid="GEN 37:26" />तत्‌यार यहुदा आह़फा भाय सी केदो, “आपणा भाय ने मारवा अने तीनु लोय ह़ताड़वा सी ह़ु फायदो हयहे? <verse eid="GEN 37:26" /><verse number="27" style="v" sid="GEN 37:27" />आवु, आपणु हीने ईस्‌माएली माणहु नी हात मे वेच देता, अने आपणु तीने नी देता, काहाके तीहयो आपणो भाय अने अमारा हाटका अने मांह से।” अने तीना भाय तीनी मान लेदा। <verse eid="GEN 37:27" /><verse number="28" style="v" sid="GEN 37:28" />तत्‌यार मीद्‌यानी वेपारी एथा गेथा तीमनीन तां पुग्‌या। युसुफ ना भायु तीने तीहया खाडा मे गेथो हापकीन बारो नीकाळ्‌या, अने ईस्‌माएली माणहु ना हात मे चांदी ना वीह सीक्‌का मे वेच देदा; अने तीहया युसुफ ने मीस्‌र देस ली ज्‌या।<verse eid="GEN 37:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 37:29" />रुबेन खाडा पोर पाछो आवीन ह़ु देख्‌यो के युसुफ खाडा मे नी हय; एतरे तीहयो आह़फा ना लुगड़ा फाड़्‌यो, <verse eid="GEN 37:29" /><verse number="30" style="v" sid="GEN 37:30" />अने आह़फा ना भायुम नी पांह पाछो जीन केवा बाज ज्‌यो, “सोरो ते नी हय; हाव मे कंखर जाम?”<verse eid="GEN 37:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 37:31" />तत्‌यार तीहया युसुफ नु ह़जाड़लु डगलु लेदा, अने एक बोकड़ा ने मारीन तीना लोय मे तीने डुबाड़ देदा। <verse eid="GEN 37:31" /><verse number="32" style="v" sid="GEN 37:32" />अने तीहया ते हात वाळा डगला ने लीन आह़फा ना बाह पांह खबर मोकल्‌यो, “आहयु आमने जड़लु से, देखीन ओळखी लेय के आहयु तारा सोरा नु हात डगलु से के नी हय?”<verse eid="GEN 37:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 37:33" />तीहयो तीने ओळखी लेदो अने केदो, “होव, आहयु मारात सोरा नु डगलु से; कानो जंगली जानवर तीने खाय जेलु से; कंय सण्‌का नी हय के युसुफ ने कटका कर नाख्‌यु हय।” <verse eid="GEN 37:33" /><verse number="34" style="v" sid="GEN 37:34" />तत्‌यार याकुब आह़फा ना लुगड़ा फाड़्‌यो अने केड़्‌या मे चचर्‌यो ठेलो लपट्‌यो, अने आह़फा सोरा नी लेदे ढेरेत दाड़ा लग दुखी हयतो र्‌यो। <verse eid="GEN 37:34" /><verse number="35" style="v" sid="GEN 37:35" />अने तीना आखा सोरा सोर्‌या तीने सांती आपवा नी कोसीत करता र्‌या; पण तीने सांती नी जड़ी; अने तीहयो आहयु केतो र्‌यो, “मे ते वेला करतो जाय्‌न मारा सोरा नी तां मरला माणहु नी कळ मे जत रेही।” आहयी रीते तीनो बाह तीनी लेदे रड़तोत र्‌यो।<verse eid="GEN 37:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="GEN 37:36" />एथा मीद्‌यानी माणहु युसुफ ने मीस्‌र मे ली जाय्‌न पोतीपर नाम ना, फीरोन ना एक अदीकारी, अने रखवाळी करन्‌या मुख्‌या, ना हात मे वचे देदा।<verse eid="GEN 37:36" /></para>
  <chapter eid="GEN 37" />
  <chapter number="38" style="c" sid="GEN 38" />
  <para style="s">यहुदा अने तीनी ववेह तामार</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 38:1" />तीहया दाड़ा मे आसम हयु के यहुदा आह़फा ना भायुम नी पांह सी जत र्‌यो, अने हीरा नाम नी एक अदुल्‌लाम मे रेवा वाळा अदमी नी तां पड़ावो नाख्‌यो। <verse eid="GEN 38:1" /><verse number="2" style="v" sid="GEN 38:2" />तां यहुदा सुवा नाम ना एक कनानी अदमी नी सोरी ने देख्‌यो; अने तीनी सी वेवा करीन तीनी पांह ज्‌यो। <verse eid="GEN 38:2" /><verse number="3" style="v" sid="GEN 38:3" />तीहयी भारेपोगे हयी अने तीहयी एक सोरु ने पयदा करी। यहुदा तीनु नाम एर पाड़्‌यो। <verse eid="GEN 38:3" /><verse number="4" style="v" sid="GEN 38:4" />तीहयी अळी भारेपोगे हयी, अने तीनु एक अळी सोरु पयदा हयु। आह्‌य तीनु नाम ओनान पाड़ी। <verse eid="GEN 38:4" /><verse number="5" style="v" sid="GEN 38:5" />अळतेण तीहयी एक अळी सोरु ने पयदा करी। आह्‌य तीनु नाम सेला पाड़ी। अने जीनी टेमे आहयु पयदा हयु तीहयी टेमे यहुदा कजीब ह़ेर मे रेतो हतो।<verse eid="GEN 38:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 38:6" />अने यहुदा तामार नाम नी एक बयर सी आह़फा ना मोट्‌ला सोरा एर ना वेवा कर देदो। <verse eid="GEN 38:6" /><verse number="7" style="v" sid="GEN 38:7" />पण यहुदा नो मोट्‌लो सोरो एर यहोवा नींगा बुरो अदमी हतो, एतरे यहोवा तीने मार नाख्‌यो। <verse eid="GEN 38:7" /><verse number="8" style="v" sid="GEN 38:8" />तत्‌यार यहुदा ओनान सी केदो, “तु आह़फा ना भाय नी लाडी ह़ाते सहवास कर, अने देवरु नु धरम पुरु करीन आह़फा ना भाय नी लेदे सोरो पयदा कर।” <verse eid="GEN 38:8" /><verse number="9" style="v" sid="GEN 38:9" />ओनान ते आहयी वात जाणतो हतो के सोरो मारो नी केवाये; एतरे आसम हयु के जत्‌यार तीहयो आह़फा भाय नी लाडी सी सहवास कर्‌यो ता पाणी ने भुय्‌मे पाड़ देदो जीनी सी तीहयो आह़फा मरला भाय जुगु अवल्‌यात अगी नी वदे। <verse eid="GEN 38:9" /><verse number="10" style="v" sid="GEN 38:10" />आहयु काम जे तीहयो कर्‌यो आनी सी यहोवा खुस नी हयो अने भगवान तीने बी मार नाख्‌यो। <verse eid="GEN 38:10" /><verse number="11" style="v" sid="GEN 38:11" />तत्‌यार यहुदा आहयी बीक नी करते के कंखर आसम नी हय के आह़फा भायुम नी तेम सेला बी मरे, आह़फी ववेह तामार सी केदो, “जत्‌यार लग मारो सोरो सेला जवान नी हय जाय ता लग आह़फा बाह ना घोर मे रंडायलीत रेजे।” एतरे तामार आह़फा बाह ना घोर मे जाय्‌न रेवा बाज जी।<verse eid="GEN 38:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 38:12" />ढेरेत दाहड़ा वीतवा बाद यहुदा नी लाडी जे सुवा नी सोरी हती, तीहयी मर जी; अळतेण यहुदा दुख ना दाड़ा वीतवान बाद आह़फा ह़ाती हीरा अदुल्‌लाम भेळ आह़फा गाडरा अने बोकड़ाम ना नीम्‌बाळा वाडवा वाळाम नी पांह तीम्‌नाह ज्‌यो। <verse eid="GEN 38:12" /><verse number="13" style="v" sid="GEN 38:13" />अने तामार ने आहयी खबर जड़ी, “तारो ह़ाहरो आह़फा गाडरा अने बोकड़ाम ना नीम्‌बाळा कतराव्‌वा नी लेदे तीम्‌नाह ह़ेर जवा बाज र्‌यो।” <verse eid="GEN 38:13" /><verse number="14" style="v" sid="GEN 38:14" />तत्‌यार तीहयी आहयु वीच्‌यारीन के सेला जुवान ते हय ज्‌यो पण मे हीनी बयर नी हयी; ता तीहयी रंडायली ना लुगड़ा नीकाळ देदी अने बीजा लुगड़ा पेरीन लुगड़ु ओडीन आह़फी ढकाय जी, अने एनेम ह़ेर ना झापला नी ह़ाते, जे तीम्‌नाह ह़ेर नी वाट्‌ये से, जाय्‌न बह जी।<verse eid="GEN 38:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 38:15" />जत्‌यार यहुदा तीने देख्‌यो, तीहयो तीने रंडी ह़मज्‌यो; काहाके तीहयी आह़फी नु मोडु ढाक री हती। <verse eid="GEN 38:15" /><verse number="16" style="v" sid="GEN 38:16" />तीहयो वाट्‌ये तीनी भणी ज्‌यो, अने तीने केवा बाज ज्‌यो, “मने तारीन्‌तां आव्‌वा दे,” काहाके तीने मालम नी हतु के तीहयी हीनी ववेह से। अने तीहयी केवा बाज जी, “कदी मे तने मारी ह़ाते सहवास करवा देम, ता तु मने ह़ु आलही?”<verse eid="GEN 38:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 38:17" />तीहयो केदो, “मे मारी बोकड़्‌याम नी मे गेथी बोकड़ी नु एक बच्‌चु तारी पांह पुगाड़ देही।” ता तीहयी केदी, “भलु तीने मोकलते लग ह़ु तु मारी पांह गीरवी रेवा जोवे करीन मेकही?”<verse eid="GEN 38:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 38:18" />यहुदा पुछ्‌यो, “मे ह़ु सेलाणी तारी पांह मेल जाम?” तीहयी केदी, “तारो सीलठप्‌पो, अने गळाम नी दोरी, अने आह़फा ना हात नी लाकड़ी।” तत्‌यार तीहयो तीने तीहयी चीज आप देदो, अने तीनी ह़ाते सहवास कर्‌यो, अने तीनी सी तामार भारेपोगे हयी। <verse eid="GEN 38:18" /><verse number="19" style="v" sid="GEN 38:19" />तत्‌यार तीहयी जत री, अने आह़फी नु लुगड़ु छेटु करीन आह़फा ना रंडायली ना लुगड़ा अळी पेर लेदी।<verse eid="GEN 38:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 38:20" />तत्‌यार यहुदा बोकड़ी नु बच्‌चु आह़फा ह़ाती तीहया अदुल्‌लाम ना हात मे मोकली देदो के तीहयी सेलाणी चीज तीहयी बयर ना हात सी छोड़ाय लेय; पण तीहयी बयर तीने नी जड़ी। <verse eid="GEN 38:20" /><verse number="21" style="v" sid="GEN 38:21" />तत्‌यार तीहयो तां वाळा माणहु सी पुछ्‌यो, “तीहयी रंडी जे एनेम नी वाट्‌ये एक धेड़े बह री हती, कां से?” तीहया केदा, “आञे ते कोय रंडी नी हती।”<verse eid="GEN 38:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 38:22" />एतरे तीहयो यहुदा नी तां पाछो जाय्‌न केदो, “मने तीहयी नी जड़ी; अने तीहया जागे वाळा माणहु केदा, आञे ते कोय रंडी नी हती।” <verse eid="GEN 38:22" /><verse number="23" style="v" sid="GEN 38:23" />तत्‌यार यहुदा केदो, “वारु, सेलाणी नु ह़मान तीनी पांह रेवा दे, नी ता आपणु गांडा गणायहु; देख, मे बोकड़ी नो आहयु बच्‌चु मोकली देदलो हतो, पण तीहयी तने नी जड़ी।”<verse eid="GEN 38:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 38:24" />लग-भग तीन मयना नी बाद यहुदा ने आहयी खबर जड़ी, “तारी ववेह तामार छीनाळु करली से; अने तीहयी छीनाळु सी भारेपोगे बी हय जेली से।” तत्‌यार यहुदा केदो, “तीने बारी ली आवो के तीने धपाड़ दीया।”<verse eid="GEN 38:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 38:25" />जत्‌यार तीने बारी नीकाळवा बाज रेला हता, तत्‌यार तीहयी, आह़फा ह़ाह़रा नी पांह आहयु केवाड़ मोकली, जीना अदमी नी आहयी चीज से, तीना सी मे भारेपोगे से, अळी तीहयी आहयु बी केवाड़ी, “ओळख ते खरो के आहयो सीलठप्‌पो, अने गळाम नी दोरी अने हात मे नी लाकड़ी कोयनी से।”<verse eid="GEN 38:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 38:26" />यहुदा तीने ओळखीन केदो, “तीहयी ते मार गेथी बी कम गुनाळ्‌ळी से; काहाके मे तीनु मारा सोरा सेला सी वेवा नी कर्‌यो” अने तीहयो तीनी सी कदी सहवास नी कर्‌यो।<verse eid="GEN 38:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 38:27" />जत्‌यार तीनु पोखड़ायवा नी टेम आयी, तत्‌यार आहयु मालम पड़्‌यु के ईना गरब मे जोवळ्‌या सोरा से। <verse eid="GEN 38:27" /><verse number="28" style="v" sid="GEN 38:28" />अने जत्‌यार तीहयी पोखड़ायवा बाज जी तत्‌यार एक सोरा नु हात बारु आयु, अने ह़ोयाणी रात्‌लो सुत लीन तीना हात आहयु केती जाय्‌न बांद देदी, “पेले आहयु पयदा हयु।” <verse eid="GEN 38:28" /><verse number="29" style="v" sid="GEN 38:29" />जत्‌यार तीहयो हात पाछो लीत्‌ती र्‌यो, तत्‌यार तीनु भाय पयदा हय ज्‌यु। तत्‌यार ह़ोयाणी केदी, “तु ह़ुका छाटोत नीकळी आयो?” एतरे तीनु नाम पेरेस<note caller="+" style="f"><char style="fr" closed="false">38:29 </char><char style="fq" closed="false">पेरेस </char><char style="ft" closed="false">नीकळवा नी वाट</char></note> पाड़्‌या।<note caller="+" style="x"><char style="xo" closed="false">38:29 </char><char style="xt" closed="false"><ref loc="MAT 1:3">मत्‌ती 1:3</ref></char></note> <verse eid="GEN 38:29" /><verse number="30" style="v" sid="GEN 38:30" />पसळ तीनो भाय जीना हात मे रात्‌लो सुत बांदलो हतो पयदा हयो, अने तीनु नाम जेरह <note caller="+" style="f"><char style="fr" closed="false">38:30 </char><char style="fq" closed="false">जेरह </char><char style="ft" closed="false">रात्‌लो नीता चमक</char></note>पाड़्‌या।<verse eid="GEN 38:30" /></para>
  <chapter eid="GEN 38" />
  <chapter number="39" style="c" sid="GEN 39" />
  <para style="s">युसुफ अने पोतीपर नी लाडी</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 39:1" />जत्‌यार युसुफ ने मीस्‌र देस पुगाड़ देदा, तत्‌यार पोतीपर नाम नो एक मीस्‌री, जे फीरोन नो अदीकारी अने सीपायड़ा नो मुख्‌यो हतो, तीने ईस्‌माएली माणहु ना हात सी जे तीने तां लीजला हता, वेचातो लेदो। <verse eid="GEN 39:1" /><verse number="2" style="v" sid="GEN 39:2" />युसुफ आह़फा ना मीस्‌री मालीक ना घोर मे रेतो हतो, अने यहोवा तीनी ह़ाते हतो; एतरे तीहयो कीस्‌मत वाळो अदमी हय ज्‌यो<note caller="+" style="x"><char style="xo" closed="false">39:2 </char><char style="xt" closed="false"><ref loc="ACT 7:9">नेवताळा ना काम 7:9</ref></char></note> <verse eid="GEN 39:2" /><verse number="3" style="v" sid="GEN 39:3" />अने युसुफ नो मालीक देख्‌यो, के यहोवा तीनी ह़ाते रेय, अने जे काम तीहयो करे तीने यहोवा तीना हात सी पुरु कर देय। <verse eid="GEN 39:3" /><verse number="4" style="v" sid="GEN 39:4" />तत्‌यार तीनी दया नी नींगा तीनी पोर हयी, अने तीहयो तीनी सेवा चाकरी करवा करीन ठेरायो; अळतेण तीहयो तीने आह़फा घोर नो अदीकारी बणावीन आह़फा नु आखु कंय तीना हात मे ह़ोप देदा। <verse eid="GEN 39:4" /><verse number="5" style="v" sid="GEN 39:5" />जत्‌यार गेथो तीने आह़फा घोर नो अने आह़फी आखी धन-दवलत नो अदीकारी बणायो, तत्‌यार गेथो यहोवा युसुफ नी कारण तीहया मीस्‌री ना घोर पोर संयबरकत आपवा बाज ज्‌यो; अने ह़ु घोर मे, ह़ु खेतर मे, तीनु जे कंय हतु, आखा पोर यहोवा नी संयबरकत हयवा बाज जी। <verse eid="GEN 39:5" /><verse number="6" style="v" sid="GEN 39:6" />एतरे तीहयो आह़फा नु आखु कंय युसुफ ना हात मे आञे लग छोड़ देदो के आह़फा खावा ना रोट्‌ला ने छोड़ीन, तीहयो आह़फी धन-दवलत नु हाल कंय नी जाणता हतो। युसुफ घटाळो अने रुपाळो हतो। <verse eid="GEN 39:6" /><verse number="7" style="v" sid="GEN 39:7" />आहयी वात नी अळतेण आसम हयु, के तीना मालीक नी लाडी युसुफ भणी भाळी अने केदी, “मार ह़ाते ह़ुव।” <verse eid="GEN 39:7" /><verse number="8" style="v" sid="GEN 39:8" />पण तीहयो नीकारो करतो जाय्‌न आह़फा ना मालीक नी लाडी ने केदो, “ह़मळ, जे कंय आहया घोर मे मारा हात मे से; तीने मारो मालीक कंय नी जाणतो, अने तीहयो आह़फा नु आखु कंय मारा हात मे ह़ोप देदलो से। <verse eid="GEN 39:8" /><verse number="9" style="v" sid="GEN 39:9" />आहया घोर मे मार गेथो मोटो कोय बी नी हय; अने तीहयो तने छोड़ीन, जे तीनी लाडी से; मार सी कंय नी ह़ताड़ीन मेक्‌यो; एतरे भलो, मे आसवो मोटो गुनो करीन भगवान नो गुनाळ्‌ळो ह़ुका बणु?” <verse eid="GEN 39:9" /><verse number="10" style="v" sid="GEN 39:10" />अने आसम हयु के तीहयी दाड़ीक युसुफ सी वात करती री, पण तीहयो तीनी नी मान्‌यो के तीनी ह़ाते ह़ुवे नीता तीनी ह़ाते रेय।<verse eid="GEN 39:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 39:11" />एक दाड़े ह़ु हयु के युसुफ आह़फा नु काम-काज करवा करीन घोर मे ज्‌यो, अने घोर ना पावर्‌या मे सी कोय बी घोर ना मोय नी हतो। <verse eid="GEN 39:11" /><verse number="12" style="v" sid="GEN 39:12" />तत्‌यार तीहयी बयर तीनु लुगड़ु धरीन केदी, “मार ह़ाते ह़ुव,” पण तीहयो आह़फा नु लुगड़ु तीना हात मे रेवा दीन नाह्‌यो, अने बारो नीकळी ज्‌यो। <verse eid="GEN 39:12" /><verse number="13" style="v" sid="GEN 39:13" />आहयु देखीन के तीहयो आह़फा नु लुगड़ु मार हात मे रेवा दीन बारो नाह ज्‌यो, <verse eid="GEN 39:13" /><verse number="14" style="v" sid="GEN 39:14" />तीहयी बयर आह़फा घोर ना पावर्‌याम ने बोलावीन केदी, “देखो, तीहयो एक ईब्‌रानी माणेह ने मने बदनाम करवा करीन अमारी पांह ली आवलो से। तीहयो ते मारी ह़ाते ह़ुव्‌वा ना मतलब सी मारीन्‌तां मोय आवलो हतो अने मे ज्‌योरेत आड़ी पड़ी। <verse eid="GEN 39:14" /><verse number="15" style="v" sid="GEN 39:15" />अने मने ज्‌योरेत आड़त्‌ली ह़मळीन तीहयो आह़फा नु लुगड़ु मारी पांह रेवा दीन नाह ज्‌यो, अने बारो नीकळी ज्‌यो।”<verse eid="GEN 39:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 39:16" />अने तीहयी तीनु लुगड़ु तीना मालीक ने घोर आवते लग आह़फी पांह राखी। <verse eid="GEN 39:16" /><verse number="17" style="v" sid="GEN 39:17" />तत्‌यार तीहयी तीना सी आहयी रीते वात केदी, “तीहयो ईब्‌रानी पावर जीने तु आपणीन तां ली आवलो से, तीहयो मार सी ह़ाही करवा करीन मारी पांह आवलो हतो; <verse eid="GEN 39:17" /><verse number="18" style="v" sid="GEN 39:18" />जत्‌यार मे ज्‌योरेत आड़ी पड़ी, तत्‌यार तीहयो आह़फा नु लुगड़ु मारी पांह रेवा दीन बारो नाह ज्‌यो।”<verse eid="GEN 39:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 39:19" />आह़फी लाडी नी आहयी वातु ह़मळीन के तारो पावर मारी सी आसम-आसम काम कर्‌यो, युसुफ ना मालीक नी रीह वद जी। <verse eid="GEN 39:19" /><verse number="20" style="v" sid="GEN 39:20" />अने युसुफ नो मालीक तीने धरीन जेलखाना मे जां राजा ना केदड़ा बंद हता, नखाड़ देदो; बाद मे तीहयो तीहया जेलखाना मे र्‌यो।<note caller="+" style="x"><char style="xo" closed="false">39:20 </char><char style="xt" closed="false"><ref loc="PSA 105:18">भजन सहीता 105:18</ref></char></note> <verse eid="GEN 39:20" /><verse number="21" style="v" sid="GEN 39:21" />पण यहोवा युसुफ नी ह़ाते-ह़ाते र्‌यो, अने तीना पोर दया नी, अने जेलखाना ना मुख्‌या सीपायड़ा नी दया नी नींगा तीनी पोर हयी।<note caller="+" style="x"><char style="xo" closed="false">39:21 </char><char style="xt" closed="false"><ref loc="ACT 7:9">नेवताळा ना काम 7:9</ref></char></note> <verse eid="GEN 39:21" /><verse number="22" style="v" sid="GEN 39:22" />एतरे जेलखाना नु मुख्‌यु सीपायड़ु तीहया आखा केदड़ा ने, जे जेलखाना मे हता, युसुफ ना हात मे ह़ोप देदु; अने जे-जे काम तीहया तां करता हता, तीहयु तीना हुकम सी हयतु हतु। <verse eid="GEN 39:22" /><verse number="23" style="v" sid="GEN 39:23" />युसुफ ना हक मे जे कंय हतु तीनी मे सी जेलखाना ना मुख्‌या सीपायड़ा ने कानी बी चीज देखवा नी पड़ती हती; काहाके यहोवा युसुफ नी ह़ाते हतो; अने जे कंय तीहयो करतो हतो, यहोवा तीने तीनी मे पुरु करतो हतो।<verse eid="GEN 39:23" /></para>
  <chapter eid="GEN 39" />
  <chapter number="40" style="c" sid="GEN 40" />
  <para style="s">केदड़ाम ना ह़पनु नु मतलब देखाड़वा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 40:1" />आहयी वातु नी बाद ईसम हयु, के मीस्‌र ना राजा ना पीवाड़वा वाळो अने रांदवा वाळो आह़फा मालीक ना वीरोद कंय गुनो कर्‌यो। <verse eid="GEN 40:1" /><verse number="2" style="v" sid="GEN 40:2" />तत्‌यार फीरोन राजा आह़फा बेम अदीकार्‌या, मतलब पीवाड़वा वाळा ना मुख्‌या, अने रांदवा वाळा ना मुख्‌या, पोर खीजवाय्‌न <verse eid="GEN 40:2" /><verse number="3" style="v" sid="GEN 40:3" />तीमने धरीन करावीन माणहु नी रखवाळी ना मुख्‌या ना घोर ना तीना जेल मे, जां युसुफ केद मे हतो, तां बंद कर देदा। <verse eid="GEN 40:3" /><verse number="4" style="v" sid="GEN 40:4" />तत्‌यार माणहु नी रखवाळी करन्‌यो मुख्‌यो तीमने युसुफ ना हात मे ह़ोप्‌यो, अने तीहयो तीमनी सेवा-चाकरी करवा बाज ज्‌यो; पण तीहया थोड़ाक दाड़ा लग जेल मे र्‌या।<verse eid="GEN 40:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 40:5" />मीस्‌र ना राजा नो पीवाड़वा वाळो अने रांदवा वाळो, जेल मे बंद हतो, तीहया बेम जणा एकीत रात मे, आह़फा–आह़फा हुनर नी लारे ह़पनु देख्‌या। <verse eid="GEN 40:5" /><verse number="6" style="v" sid="GEN 40:6" />ह़वारे जत्‌यार युसुफ तीमनी पांह मोय ज्‌यो, तत्‌यार तीमनी पोर तीहयो जेम नजर नाखीन देख्‌यो ता ह़ु देख्‌यो के तीहया नराज से। <verse eid="GEN 40:6" /><verse number="7" style="v" sid="GEN 40:7" />एतरे तीहयो फीरोन राजा ना तीहया अदीकार्‌याम सी, जे तीमनी ह़ाते तीमना मालीक ना घोर ना जेल मे हता, पुछ्‌यो, “आज तमारा मोडा ह़ुका नराज से?”<verse eid="GEN 40:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 40:8" />तीहया तीने केदा, “आमु बेम जणा ह़पनु देखला से, अने तीमना बारा मे देखाड़वा वाळु कोय बी नी हय।” युसुफ तीमने केदो, “ह़ु ह़पना बारा मे केवा भगवान नु काम नी हय? मने आपणु-आपणु ह़पनु देखाड़ो।”<verse eid="GEN 40:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 40:9" />तत्‌यार पीवाड़वा वाळाम नो मुख्‌यो आह़फा नु ह़पनु युसुफ ने आसम देखाड़वा लाग्‌यो: “मे ह़पना मे देख्‌यो के मार अगळ एक अंगुर नो वेलो से; <verse eid="GEN 40:9" /><verse number="10" style="v" sid="GEN 40:10" />अने तीहया अंगुर ना वेला मे तीन डाळ्‌या से; अने तीमनी मे डीरा फुट्‌या; अने तीमनी मे फुल लाग्‌या अने तीहया फुल मे अंगुर ना घुड़का फालीन पाक ज्‌या। <verse eid="GEN 40:10" /><verse number="11" style="v" sid="GEN 40:11" />फीरोन राजा नो वाटवा मार हात मे हतु; अने मे तीहया अंगुर ने लीन फीरोन ना वाटका मे नीचव्‌यो, अने वाटका ने फीरोन ना हात मे आप्‌यो।”<verse eid="GEN 40:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 40:12" />तत्‌यार युसुफ तीने केदो, “आनु मतलब आहयु से: तीन डाळ्‌या नु मतलब तीन दाड़ा से; <verse eid="GEN 40:12" /><verse number="13" style="v" sid="GEN 40:13" />एतरे हमणे सी तीन दाड़ा ना मोय फीरोन तारु मुंडु उचु करहे, अने फीर सी तारा जागा पोर तने ठेरावहे, अने तु पेले नी तेम फीरोन नो पीवाड़वा वाळो बणीन तीनो कटवरो तीना हात मे अळी आप्‌या करही। <verse eid="GEN 40:13" /><verse number="14" style="v" sid="GEN 40:14" />जत्‌यार तारु भलु हय जाय तत्‌यार मने फोम करजे, अने मारी पोर दया करीन फीरोन सी मारी वात करजे, अने आहया जेलखाना सी मने छोड़ाय देजे। <verse eid="GEN 40:14" /><verse number="15" style="v" sid="GEN 40:15" />काहाके ह़ाचलीन ईब्‌रानीयो ना देस सी मने चोरी करीन लावला से। अने आञे बी मे कोय आसवु काम नी कर्‌यो, जीनी कारण मे आहया जेलखाना मे नाखे।”<verse eid="GEN 40:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 40:16" />आहयु देखीन के तीना ह़पना नु मतलब वारु नीकळ्‌यु, रांदवा वाळा नो मुख्‌यो युसुफ सी केदो, “मे बी ह़पनु देखलो से, तीहयु आहयु से: मे देख्‌यो के मारा मोडा पोर धोळ्‌ळा रोट्‌ला ना तीन टोपल्‌या से। <verse eid="GEN 40:16" /><verse number="17" style="v" sid="GEN 40:17" />अने उपर नी टोपली मे फीरोन नी लेदे आखा भातीन रांदली चीज से; अने चड़ा मारा मुंडा पोर नी टोपली मे सी तीहयी चीज ने खावा बाज र्‌या।”<verse eid="GEN 40:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 40:18" />युसुफ केदो, “आनु फोळ आहयु से: तीन टोपल्‌या नु मतलब तीन दाड़ा से। <verse eid="GEN 40:18" /><verse number="19" style="v" sid="GEN 40:19" />हाव सी तीन दाड़ा नी मोय फीरोन राजा तारा मुंडा ने वडाड़ीन तने एक झाड़ पोर टंगाड़ देहे, अने चड़ा तारा माह ने तातड़ी-तातड़ीन खाहे।”<verse eid="GEN 40:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 40:20" />अने तीसरे दाड़े फीरोन राजा नो पयदा हयवा नो दाड़ो हतो, तीहयो आह़फा आखा अदीकारीम ने खावा आप्‌यो, अने तीमनी मे सी पीवाड़वा वाळा ना मुख्‌या, अने रांदवा वाळा ना मुख्‌या बेम जणा ने जेलखाना सी नीकाळ्‌या। <verse eid="GEN 40:20" /><verse number="21" style="v" sid="GEN 40:21" />पीवाड़वा वाळा नो मुख्‌यो ने ते पीवाड़वा वाळा ना जाग पोर पाछो बहाड़्‌यो, अने तीहयो फीरोन ना हात मे कटवरो आपवा बाज ज्‌यो। <verse eid="GEN 40:21" /><verse number="22" style="v" sid="GEN 40:22" />पण रांदवा वाळा ना मुख्‌या ने टंगाड़ देदो, जीसम के युसुफ तीना ह़पना नु मतलब तीने केदलो हतो। <verse eid="GEN 40:22" /><verse number="23" style="v" sid="GEN 40:23" />ता बी पीवाड़वा वाळा नो मुख्‌यो युसुफ ने फोम नी राख्‌यो; पण तीने भुल ज्‌यो।<verse eid="GEN 40:23" /></para>
  <chapter eid="GEN 40" />
  <chapter number="41" style="c" sid="GEN 41" />
  <para style="s">फीरोन राजा नु ह़पनु नो मतलब देखाड़े</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 41:1" />पुरा बे साल वीतवा पोर फीरोन राजा आहयु ह़पनु देख्‌यो के तीहयो नील नंदी नी धेड़े उबो से। <verse eid="GEN 41:1" /><verse number="2" style="v" sid="GEN 41:2" />अने तीहयी नंदी मे सी ह़ात घटाळी अने जबरी-जबरी गायु नीकळीन नंदी नी धेड़े नो चारो चरवा बाज जी। <verse eid="GEN 41:2" /><verse number="3" style="v" sid="GEN 41:3" />अने ह़ु देख्‌या के तीनी पछळ अळी ह़ात गायु, जे मांदली अने लुल्‌ली से, नील नंदी मे गेथी नीकळी; अने बीजी गायुम नी ह़ाते नंदी नी धेड़े जाय्‌न उबी हय जी। <verse eid="GEN 41:3" /><verse number="4" style="v" sid="GEN 41:4" />तत्‌यार आहयी मांदली अने लुल्‌ली गायु तीहयी ह़ात घटाळी अने जबरी-जबरी गायुम ने खाय जी। तत्‌यार फीरोन जाग उठ्‌यो। <verse eid="GEN 41:4" /><verse number="5" style="v" sid="GEN 41:5" />अने तीहयो अळी ह़ुय ज्‌यो अने बीजु ह़पनु देख्‌यो के एक डांडळा मे सी ह़ात मोटा अने वारु-वारु उंब्‌या नीकळ्‌या। <verse eid="GEN 41:5" /><verse number="6" style="v" sid="GEN 41:6" />अने ह़ु देख्‌यो के तीनी पछळ ह़ात उंब्‌या पातळी अने उगणली झाळ सी चीमायली नीकळी। <verse eid="GEN 41:6" /><verse number="7" style="v" sid="GEN 41:7" />अने आहया पातळ्‌ळा उंब्‌या तीहया ह़ांत जाडा अने दाणा सी भरायला उंब्‌याम ने गळ ज्‌या। तत्‌यार फीरोन राजा जाग्‌यो, अने तीने मालम हयु के आहयु ह़पनुत हतु। <verse eid="GEN 41:7" /><verse number="8" style="v" sid="GEN 41:8" />ह़वारे फीरोन नु मन घबरायलु हतु; अने तीहयो मीस्‌र ना आखा अक्‌कल वाळा, अने बड़वा ने बोलाव्‌वा मोकल्‌यो; अने तीमने आह़फा ह़पना देखाड़्‌यो; पण तीमनी मे सी कोय बी तीमनु फोळ फीरोन राजा ने नी देखाड़ सक्‌यो।<note caller="+" style="x"><char style="xo" closed="false">41:8 </char><char style="xt" closed="false"><ref loc="DAN 2:2">दानीयल 2:2</ref></char></note><verse eid="GEN 41:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 41:9" />तत्‌यार पीवाड़वा वाळा नो मुख्‌यो फीरोन राजा सी केदो, “मारा गुना आज मने फोम आया: <verse eid="GEN 41:9" /><verse number="10" style="v" sid="GEN 41:10" />जत्‌यार फीरोन राजा आह़फा पावर्‌याम नी सी खीजवायलो हतो, अने मने अने रांदवा वाळा ना मुख्‌या ने धरावीन रखवाळी करन्‌या सीपायड़ा ना मुख्‌या ना घोर ना जेलखाना मे बंद कराय देदो हतो, <verse eid="GEN 41:10" /><verse number="11" style="v" sid="GEN 41:11" />तत्‌यार आमु बेम जणा एकीत राते मे, आह़फा-आह़फाम ना हुनर नी अनसारे ह़पनु देख्‌या; <verse eid="GEN 41:11" /><verse number="12" style="v" sid="GEN 41:12" />अने तां अमारी ह़ाते एक ईब्‌रानी जुवान्‌यो हतो, जे रखवाळी करन्‌या सीपायड़ा ना मुख्‌या नो पावर हतो; तत्‌यार आमु तीने देखाड़्‌या, अने तीहयो अमारा ह़पनाम नो फोळ अमारी सी केदो, अमारी मे सी एक-एक नु ह़पना नु मतलब तीहयो देखाड़ देदो। <verse eid="GEN 41:12" /><verse number="13" style="v" sid="GEN 41:13" />अने जीसम-जीसम मतलब तीहयो आमने केदो हतो, तेमेत हयु बी, मतलब मने ते मारो जागो अळी जड़्‌यो, पण तीने ते फासी पोर टांग देदा।”<verse eid="GEN 41:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 41:14" />तत्‌यार फीरोन राजा युसुफ ने बोलाय्‌न लाव्‌वा मोकल्‌यो। अने तीने छाटोत जेलखाना सी बारो नीकाळ्‌या, अने नीम्‌बाळा कतराय्‌न, अने लुगड़ा बदलीन फीरोन राज नी अगळ आयो। <verse eid="GEN 41:14" /><verse number="15" style="v" sid="GEN 41:15" />फीरोन युसुफ सी केदो, “मे एक ह़पनु देखलो से, अने तीनु मतलब देखाड़वा वाळु कोय बी नी हय; अने मे तारा बारा मे ह़मळ्‌ळो से, के तु ह़पनु ह़मळतेत तीनु मतलब देखाड़ सकत्‌लो।”<verse eid="GEN 41:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 41:16" />युसुफ फीरोन सी केदो, “मे ते कंय नी जाणतो: भगवानेत फीरोन राजा नी लेदे वारु बोल आलहे।”<verse eid="GEN 41:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 41:17" />अळतेण फीरोन राजा युसुफ सी केवा बाज ज्‌यो, “मे मारा ह़पना मे देख्‌यो, के मे नील नंदी नी धेड़े उबो से। <verse eid="GEN 41:17" /><verse number="18" style="v" sid="GEN 41:18" />अळी, ह़ु देख्‌यो, के नील नंदी मे गेथी ह़ात जबरी अने घटाळी-घटाळी गायु नीकळीन नंदी नी धेड़े वाळो नो चारो चरवा बाज जी। <verse eid="GEN 41:18" /><verse number="19" style="v" sid="GEN 41:19" />बाद मे, ह़ु देख्‌यो, के तीमनी पछळ ह़ात अळी गायु नीकळी, जे हारली, अने ढेरेत मांदली, अने लुल्‌ली से; मे ते आखा मीस्‌र देस मे आसवी खोड़ली गायु कदी नी देख्‌यो। <verse eid="GEN 41:19" /><verse number="20" style="v" sid="GEN 41:20" />आहयी लुल्‌ली अने खोड़ली गायु पेली ह़ातोव जबरी-जबरी गायु ने खाय जी। <verse eid="GEN 41:20" /><verse number="21" style="v" sid="GEN 41:21" />अने जत्‌यार तीहयी तीमने खाय जी तत्‌यार आहयु मालम नी पड़तु हतु के तीहयी तीमने खाय जी, काहाके तीहयी पेलेन तेम जीसम के तीसम खोड़ली री। तत्‌यार मे जाग उठ्‌यो। <verse eid="GEN 41:21" /><verse number="22" style="v" sid="GEN 41:22" />अळतेण मे बीजो ह़पनु देख्‌यो, के एकीत डांडळा मे ह़ात वारु-वारु अने दाणा सी भरला उंब्‌या नीकळी। <verse eid="GEN 41:22" /><verse number="23" style="v" sid="GEN 41:23" />अळतेण ह़ु देख्‌यो, के तीमनी पछळ अळी ह़ात उंब्‌या पातळी अने उगवणु वाहळा सी चीमायली नीकळी। <verse eid="GEN 41:23" /><verse number="24" style="v" sid="GEN 41:24" />अने आहयी पातळी उंब्‌या तीहयी ह़ात वारु-वारु उंब्‌या ने गळ जी। अने मे बड़वा ने देखाड़्‌यो, पण आने ह़मजाड़वा वाळो कोय नी जड़्‌यो।”<verse eid="GEN 41:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 41:25" />तत्‌यार युसुफ फीरोन राजा सी केदो, “फीरोन राजा नु ह़पनु ह़रकु से, भगवान जे काम करवा हींडे, तीने फीरोन राजा पोर उजन्‌तु करलो से। <verse eid="GEN 41:25" /><verse number="26" style="v" sid="GEN 41:26" />तीहयी ह़ात वारु-वारु गायु ह़ात साल से; अने तीहयी ह़ात वारु-वारु उंब्‌या बी ह़ात साल से; ह़पना ह़रकुत से। <verse eid="GEN 41:26" /><verse number="27" style="v" sid="GEN 41:27" />अळतेण तीनी पछळ जे लुल्‌ली अने खोड़ली गायु नीकळी, अने जे ह़ात पातळी अने उगवणु वाहळु सी चीमायली उंब्‌या नीकळी, तीहया काळ ना ह़ात साल हयहे। <verse eid="GEN 41:27" /><verse number="28" style="v" sid="GEN 41:28" />आहयी तीहयीत वात से जे मे फीरोन राजा सी की चुक्‌यो, के भगवान जे काम करवा हींड र्‌यो, तीने तीहयो फीरोन राजा ने देखाड़लो से। <verse eid="GEN 41:28" /><verse number="29" style="v" sid="GEN 41:29" />ह़मळ, आखा मीस्‌र देस मे ह़ात वरहु ते ढेरेत दाणा पाकहे। <verse eid="GEN 41:29" /><verse number="30" style="v" sid="GEN 41:30" />तीनी बाद ह़ात वरहु काळ ना आवहे, अने आखा मीस्‌र देस मे माणहु आहयी आखी मेर ने वीहरी जहे; अने काळ सी देस खत्‌तम हय जहे। <verse eid="GEN 41:30" /><verse number="31" style="v" sid="GEN 41:31" />अने काळ घणो जुदो पड़हे के वारली मेर अने फसल कोय ने फोम नी रेय। <verse eid="GEN 41:31" /><verse number="32" style="v" sid="GEN 41:32" />अने फीरोन जे आहयु ह़पनु बे वार देखलो से आनु मतलब आहयुत से के आहयी वात भगवान भणी गेथी पक्‌की हय जेली से, अने भगवान आने ममार पुरो करहे।<verse eid="GEN 41:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="GEN 41:33" />“एतरे हाव फीरोन राजा काना ह़मजदार अने अक्‌कल वाळा माणेह ने ह़ोदीन तीने मीस्‌र देस नो मुख्‌यो मंत्‌री ठेरावे। <verse eid="GEN 41:33" /><verse number="34" style="v" sid="GEN 41:34" />फीरोन राजा आहयु करे के देस पोर अदीकार्‌या पक्‌का करे, अने जत्‌यार लग वारली मेर ना ह़ात वरहु रेय तत्‌यार लग तीहयो मीस्‌र देस नी मेर नो पांचवो वाटो लीया करे। <verse eid="GEN 41:34" /><verse number="35" style="v" sid="GEN 41:35" />अने तीहयो आहया वारला वरहु मे आखा भाती नी खावा नी चीज एकठी करे, अने ह़ेर-ह़ेर मे गोदाम घोर खाणा नी लेदे, फीरोन ना हक मे करीन तीनी रखवाळी करे। <verse eid="GEN 41:35" /><verse number="36" style="v" sid="GEN 41:36" />अने तीहयी खावा नी चीज काळ ना तीहया ह़ात वरहु नी लेदे रेय, जे मीस्‌र देस मे आवहे, देस ने खावा नी लेदे मेकली रेय, जीनी सी देस तीहया काळ सी खत्‌तम नी हये।”<verse eid="GEN 41:36" /></para>
  <para style="s">युसुफ ने मुख्‌यो मंतरी बणाव्‌वा</para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 41:37" />आहयी वात फीरोन राजा अने तीना आखा अदीकार्‌या ने वारु लागी। <verse eid="GEN 41:37" /><verse number="38" style="v" sid="GEN 41:38" />एतरे फीरोन आह़फाम अदीकार्‌या ने केदो, “ह़ु आमने आसवो माणेह, जीसम आहयु से, जीनी मे भगवान नी आत्‌मा रेत्‌ली से, जड़ सके ह़ु?” <verse eid="GEN 41:38" /><verse number="39" style="v" sid="GEN 41:39" />अळी फीरोन युसुफ सी केदो, “भगवान तने जे एतरु ग्‌यान आपलो से, के तारीन तेवो कोय ह़मजदार अने अक्‌कल वाळो नी हय, <verse eid="GEN 41:39" /><verse number="40" style="v" sid="GEN 41:40" />आहया कारण तु मारा घोर नो अदीकारी हयही, अने तारा हुकम नी अनसारे मारी आखी असामी चालहे, नीस्‌तो राजगादी ना वारा मे तार सी मोटो ठेरही।<note caller="+" style="x"><char style="xo" closed="false">41:40 </char><char style="xt" closed="false"><ref loc="ACT 7:10">नेवताळा ना काम 7:10</ref></char></note> <verse eid="GEN 41:40" /><verse number="41" style="v" sid="GEN 41:41" />अळी फीरोन राज युसुफ सी केदो, ह़मळ, मे तने मीस्‌र ना आखा देस नी उपर अदीकार्‌यो ठेराय देम।”<note caller="+" style="x"><char style="xo" closed="false">41:41 </char><char style="xt" closed="false"><ref loc="PSA 105:21">भजन सहीता 105:21</ref>; <ref loc="ACT 7:40">नेवताळा ना काम 7:40</ref></char></note> <verse eid="GEN 41:41" /><verse number="42" style="v" sid="GEN 41:42" />तत्‌यार फीरोन आह़फा ना हाते गेथी सील-टप्‌पा वाळी वीटी नीकाळीन युसुफ ना हात मे पेराय देदो; अने तीने वारु लेफड़्‌या लुगड़ा पेराड़ मांग्‌यो, अने तीना गळा मे ह़ोना नी ह़ाकळ पेराय देदो;<note caller="+" style="x"><char style="xo" closed="false">41:42 </char><char style="xt" closed="false"><ref loc="DAN 5:29">दानीयल 5:29</ref></char></note> <verse eid="GEN 41:42" /><verse number="43" style="v" sid="GEN 41:43" />अने तीने आह़फा नी बीजी घोड़ागाड़ी पोर चड़ाय मांग्‌यो; अने माणहु तीनी अगळ-अगळ आहयु परच्‌यार करता चाल्‌या, के मांडा टेकीन वांद्‌या करो अने तीहयो तीने मीस्‌र देस पोर डाहलो मंतरी ठेरायो। <verse eid="GEN 41:43" /><verse number="44" style="v" sid="GEN 41:44" />अळी फीरोन राजा युसुफ सी केदो, “फीरोन राजा ते मे से, अने आखा मीस्‌र देस मे कोय बी तारा हुकम वगर ह़ात अने पोग नी हीलावे।” <verse eid="GEN 41:44" /><verse number="45" style="v" sid="GEN 41:45" />फीरोन राजा युसुफ नु नाम सापनत्‌पानेह<note caller="+" style="f"><char style="fr" closed="false">41:45 </char><char style="fq" closed="false">सापनत्‌पानेह </char><char style="ft" closed="false">भगवान केय तमु जीवत्‌ला रेवो</char></note> पाड़्‌यो। अने ओन ह़ेर ना पुंजारा पोतीपेरा नी सोरी आसनत सी तीना वेवा कराय देदो। अने युसुफ आखा मीस्‌र देस मे फीरवा बाज ज्‌यो। <verse eid="GEN 41:45" /><verse number="46" style="v" sid="GEN 41:46" />जत्‌यार युसुफ मीस्‌र ना राजा फीरोन नी ह़ाते उबो हयो, तत्‌यार तीहयो तीस साल नो हतो। तीहयो फीरोन राजा नी ह़ाते सी नीकळीन आखा मीस्‌र देस मे फीरवा बाज ज्‌यो। <verse eid="GEN 41:46" /><verse number="47" style="v" sid="GEN 41:47" />वारला ह़ांत वरहु मे धरती ढेरेत अन पयदा करती री, <verse eid="GEN 41:47" /><verse number="48" style="v" sid="GEN 41:48" />अने युसुफ तीहया ह़ात वरहु मे आखा भातीन खावा नी चीजु, जे मीस्‌र देस मे हयती हती, एकठी करीन ह़ेर मे मेल्‌तो ज्‌यो, अने हरेक ह़ेर नी च्‌यारो मेर ना खेतर नी खावा नी चीज ने तीहयात ह़ेर मे एक्‌ठो करतो ज्‌यो। <verse eid="GEN 41:48" /><verse number="49" style="v" sid="GEN 41:49" />आहयी रीते युसुफ मेर ने दर्‌या नी रेत नी तेम घणी ढेरकी भेळी कर्‌यो, आञे लग के तीहयो तीमने गीणवा छोड़ देदो; काहाके तीहया गीणाये नी एतरु हय ज्‌यी।<verse eid="GEN 41:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="GEN 41:50" />काळ ना पेल्‌ना साल ने आव्‌वा सी पेले युसुफ ना बे सोरा हया, ओन ह़ेर ना पुंजारा पोतीपेरा नी सोरी आसनत सी पयदा हया। <verse eid="GEN 41:50" /><verse number="51" style="v" sid="GEN 41:51" />अने युसुफ आह़फा ना मोट्‌ला सोरा नु नाम आहयु कीन मनस्‌से<note caller="+" style="f"><char style="fr" closed="false">41:51 </char><char style="fq" closed="false">मनस्‌से </char><char style="ft" closed="false">भुलाड़वा वाळो</char></note> पाड़्‌यो, के “भगवान मार पांह सी मारु आखु दुख, अने मारा बाह नु आखु घोराणा” वीहराड़ देदलो से। <verse eid="GEN 41:51" /><verse number="52" style="v" sid="GEN 41:52" />बीजा नु नाम तीहयो आहयु कीन एप्‌रेम<note caller="+" style="f"><char style="fr" closed="false">41:52 </char><char style="fq" closed="false">एप्‌रेम </char><char style="ft" closed="false">फोळ वाळो</char></note> पाड़्‌यो, के मने दुख झेलवा ना देस मे भगवान मने फोळ आपलो से।<verse eid="GEN 41:52" /></para>
  <para style="p">
    <verse number="53" style="v" sid="GEN 41:53" />अने मीस्‌र देस ना वारली मेर पाकवा ना ह़ात वरहु खत्‌तम हय ज्‌या। <verse eid="GEN 41:53" /><verse number="54" style="v" sid="GEN 41:54" />अने युसुफ नी केवा नी अनसारे ह़ात वरहु नो काळ सुरु हय ज्‌यो। आखा देस मे युसुफ केदलो तीनी अनसारे काळ पड़वा बाज ज्‌यो; पण आखा मीस्‌र देस अन हतु। <note caller="+" style="x"><char style="xo" closed="false">41:54 </char><char style="xt" closed="false"><ref loc="ACT 7:11">नेवताळा ना काम 7:11</ref></char></note> <verse eid="GEN 41:54" /><verse number="55" style="v" sid="GEN 41:55" />जत्‌यार मीस्‌र नु आखु देस भुकलु मरवा बाज ज्‌यु; तत्‌यार माणहु फीरोन राजा सी आड़ी-आड़ीन खाणु मांगवा बाज ज्‌या; अने तीहयो आखा मीस्‌र ना माणहु सी कीया करतो हतो, “युसुफ ने तां जावो; अने जे कंय तीहयो तमारी सी केय, तीहयुत करो।” <verse eid="GEN 41:55" /><verse number="56" style="v" sid="GEN 41:56" />एतरे काळ आखी धरती पोर फेल ज्‌यु, अने मीस्‌र देस मे काळ घणु जुदु हय ज्‌यु, तत्‌यार युसुफ आखा गोदाम खोल-खोलीन मीस्‌र ना माणहु ने अन वेचवा बाज ज्‌यो। <verse eid="GEN 41:56" /><verse number="57" style="v" sid="GEN 41:57" />एतरे आखी धरती ना माणहु मीस्‌र देस मे अन वेचातु लेवा नी लेदे युसुफ ने तां आव्‌वा बाज ज्‌या, काहाके आखी धरती पोर घणो-जुदो काळ पड़ र्‌यो हतो।<verse eid="GEN 41:57" /></para>
  <chapter eid="GEN 41" />
  <chapter number="42" style="c" sid="GEN 42" />
  <para style="s">युसुफ ना भायुम नु मीस्‌र देस मे आवणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 42:1" />जत्‌यार याकुब ह़मळ्‌यो के मीस्‌र देस मे अन से, तत्‌यार तीहयो आह़फा ना सोराम ने केदो, “तमु एक बीजा नु मोडु ह़ुका देख र्‌या।” <verse eid="GEN 42:1" /><verse number="2" style="v" sid="GEN 42:2" />अळतेण तीहयो केदो, “मे ह़मळ्‌ळो से के मीस्‌र देस मे अन से; एतरे तमु तां जाय्‌न अमारी लेदे अन वेचातु ली आवो, जीनी सी आपणु नी मरया, पण जीवत्‌ला रेय।”<note caller="+" style="x"><char style="xo" closed="false">42:2 </char><char style="xt" closed="false"><ref loc="ACT 7:12">नेवताळा ना काम 7:12</ref></char></note> <verse eid="GEN 42:2" /><verse number="3" style="v" sid="GEN 42:3" />तत्‌यार युसुफ ना दह भाय अन लेवा करीन मीस्‌र देस ज्‌या। <verse eid="GEN 42:3" /><verse number="4" style="v" sid="GEN 42:4" />पण युसुफ ना भाय बीन्‌यामीन ने याकुब आहयो वीच्‌यार करीन भायुम नी ह़ाते नी मोकल्‌यो के कंखर आसम नी हये के तीनी पोर कोय वेला आय पड़े।<verse eid="GEN 42:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 42:5" />आहयी रीते जे माणहु अन वेचातु लेवा आया तीमनी ह़ाते याकुब ना सोरा बी आया; काहाके कनान देस मे बी भारी काळ हतु। <verse eid="GEN 42:5" /><verse number="6" style="v" sid="GEN 42:6" />युसुफ ते मीस्‌र देस नो मुख्‌यो मंतरी हतो, अने तीहया देस ना आखा माणहुम ने तां अन वेचतो हतो; एतरे जत्‌यार युसुफ ना भाय आया ता भोय्‌मे मोडा ना भरहे पड़ीन वांद्‌या। <verse eid="GEN 42:6" /><verse number="7" style="v" sid="GEN 42:7" />तीमने देखीन युसुफ ओळखी ते लेदो, पण तीमनी अगळ भोळो बणीन वातड़ो रीन तीमने पुछ्‌यो, तमु का गेथा आय र्‌या? तीहया केदा, “आमु ते कनान देस सी अन वेचातु लेवा नी लेदे आवला से।”<verse eid="GEN 42:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 42:8" />युसुफ आह़फा ना भायुम ने ओळखी लेदो, पण तीहया तीन नी ओळख्‌या। <verse eid="GEN 42:8" /><verse number="9" style="v" sid="GEN 42:9" />तत्‌यार युसुफ आह़फा ना तीहया ह़पनाम ने फोम करीन जे तीहयो तीमना वारा मे देखलो हतो, तीमने केवा बाज ज्‌यो, “तमु होगा-होगा देस ना बारा मे जाणवा वाळा से; अने मीस्‌र देस नी केवी हालत से देखवा करीन आवला से।”<note caller="+" style="x"><char style="xo" closed="false">42:9 </char><char style="xt" closed="false"><ref loc="GEN 37:5-10">उबजणाय कीताप 37:5-10</ref></char></note><verse eid="GEN 42:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 42:10" />तीहया तीने केदा, “नी, नी,” ए मालीक “तारा पावर्‌या खावा नी चीज वेचाती लेवा करीन आवला से। <verse eid="GEN 42:10" /><verse number="11" style="v" sid="GEN 42:11" />आमु आखा एकीत बाह ना सोरा से, आमु ह़ुदला माणहु से, तारा पावर्‌या ह़ताय्‌न देस ना बारा मे जाणवा वाळा नी हय।”<verse eid="GEN 42:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 42:12" />युसुफ तीमने केदो, “नी, नी, तमु आहया देस नी हालत देखवात आवला से।”<verse eid="GEN 42:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 42:13" />तीहया केदा, “आमु तारा पावर्‌या बारे भाय से, अने कनान देस मे रेवा वाळा एकीत अदमी ना सोरा से, अने नान्‌लो आहयी टेमे अमारा बाह पांह से, अने एक मर जेलो से।”<verse eid="GEN 42:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 42:14" />“तत्‌यार युसुफ केदो,” मे ते तमारी सी की देदो, के “तमु होगात ह़ेर ना बारा मे पतो लगाड़वा वाळा से। <verse eid="GEN 42:14" /><verse number="15" style="v" sid="GEN 42:15" />ता आहयी रीते तमारी पारख हयहे, फीरोन ना जीवाय नी ह़ाम, जत्‌यार लग तमारो नान्‌लो भाय आञे नी आवे तत्‌यार लग तमु आञे सी नी जाय सकता। <verse eid="GEN 42:15" /><verse number="16" style="v" sid="GEN 42:16" />एतरे आह़फाम नी मे सी काना एक ने मोकली देवो के तीहयो तमारा भाय ने ली आवे, अने तत्‌यार लग तमु केद मे रेहु; आहयी रीते तमारी वात पारखी जहे के तमु खरला से के नी हय। कदी खरला नी ठेर्‌या तत्‌यार ते फीरोन ना जीवाय नी ह़ाम तमु पक्‌का होगात ह़ेर ना बारा मे पतो लगाड़वा वाळा ह़मजी जहु।” <verse eid="GEN 42:16" /><verse number="17" style="v" sid="GEN 42:17" />तत्‌यार युसुफ तीमने तीन दाहड़ा लग जेलखाना मे राख्‌यो।<verse eid="GEN 42:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 42:18" />तीसरे दाड़े युसुफ तीमने केदो, “एक काम करो ता जीवत्‌ला रेहु; काहाके में भगवान नी बीक मानु; <verse eid="GEN 42:18" /><verse number="19" style="v" sid="GEN 42:19" />कदी तमु ह़ुदला माणेह हय, ता तमु आखा भायुम मे सी एक जणो आहया जेलखाना मे केद रेय; अने तमु आह़फाम ना घोरवाळाम नी भुक मीटाड़वा नी लेदे अन ली जावो। <verse eid="GEN 42:19" /><verse number="20" style="v" sid="GEN 42:20" />अने आह़फा ना नान्‌ला भाय ने मारी पांह ली आवो; आहयी रीते तमारी वात खरली ठेरहे, अने तमु मरवा सी बच जावो।” तत्‌यार तीहया तेमेत कर्‌या। <verse eid="GEN 42:20" /><verse number="21" style="v" sid="GEN 42:21" />तीहया आह़फा केदा, “कंय सण्‌का नी हय आपणु आपणा भाय युसुफ ना वारा मे गुनाळ्‌ळा से, काहाके जत्‌यार तीहयो अमारी सी आड़ी आड़ीन रावण्‌या कर्‌यो, ता बी आमु आहयु देखीन, के तीनी जीवाय कीसम वेला मे पड़ली से, तीनी नी ह़मळ्‌या; आहया कारण आमु बी हाव आहयी वेला मे पड़ र्‌या।”<verse eid="GEN 42:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 42:22" />रुबेन तीमने केदो, “ह़ु मे तमारी सी नी केदलो हतो के सोरा ना गुनाळ्‌ळा ना बणो? पण तमु नी ह़मळ्‌या। देखो, हाव तीना लोय नो बदलो अमारी सी लेय।”<note caller="+" style="x"><char style="xo" closed="false">42:22 </char><char style="xt" closed="false"><ref loc="GEN 37:21">उबजणाय कीताप 37:21</ref>,<ref loc="GEN 37:22">22</ref></char></note> <verse eid="GEN 42:22" /><verse number="23" style="v" sid="GEN 42:23" />युसुफ अने तीमनी वात-चीत बे भासा ह़मजवा वाळा नी लारे हयती हती; आनी सी तीमने मालम नी हयु के युसुफ तीमनी बोली ह़मजे। <verse eid="GEN 42:23" /><verse number="24" style="v" sid="GEN 42:24" />तत्‌यार युसुफ तीमनी ह़ाते गेथो छेटो हय्‌न रड़वा बाज ज्‌यो; अळी तीमनी पांह पाछो आवीन वात करीन तीमनी मे सी सीमोन ने टाळ लेदो अने तीमनी अगळ केद कर लेदो।<verse eid="GEN 42:24" /></para>
  <para style="s">युसुफ ना भायुम नु कनान पाछा आवणु</para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 42:25" />तत्‌यार युसुफ हुकम आप्‌यो, के तीमना ठेला अन सी भर देवो अने एक-एक जणा ना ठेला मे तीमना रुप्‌या बी मेल देवो, अळतेण तीमने वाट्‌ये खावा करीन खाणु बी आपो। अने तीमनी ह़ाते आसमेत कर्‌या। <verse eid="GEN 42:25" /><verse number="26" style="v" sid="GEN 42:26" />तत्‌यार तीहया आह़फाम नु अन ना ठेला तीमना गदड़ा पोर बांदीन तां सी चाल देदा। <verse eid="GEN 42:26" /><verse number="27" style="v" sid="GEN 42:27" />धरम साहळा मे जत्‌यार एक जणो आह़फा ना गदड़ा ने चारो घालवा नी लेदे आह़फा नो ठेलो छोड़्‌यो, तत्‌यार तीना रुप्‌या ठेला ना मोडा पोर मेकला देखाव पड़्‌यो। <verse eid="GEN 42:27" /><verse number="28" style="v" sid="GEN 42:28" />तत्‌यार तीहयो आह़फा भायुम सी केदो, “मारा रुप्‌या ते पाछा आप देदला से, देखो, आहया मारा ठेला मे से,” तत्‌यार तीमना जीव मे जीव नी र्‌यो, अने तीहया एक बीजा भणी बीक सी भाळवा बाज ज्‌या, अने केदा, “भगवान अमारी ह़ाते ह़ु करलो से?”<verse eid="GEN 42:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 42:29" />तत्‌यार तीहया कनान देस मे आह़फा बाह याकुब नी तां आया, अने आपणी आखी वात आहयी रीते देखाड़ देदा: <verse eid="GEN 42:29" /><verse number="30" style="v" sid="GEN 42:30" />“जे अदमी तीहया देस नो मालीक से, तीहयो अमारी सी वातड़ो रीन वात कर्‌यो, अने आमने देस ना पतो लगाड़वा वाळा केदो। <verse eid="GEN 42:30" /><verse number="31" style="v" sid="GEN 42:31" />तत्‌यार आमु तीनी सी केदा, ‘आमु ह़ुदा माणहु से पतो लगाड़वा वाळा नी। <verse eid="GEN 42:31" /><verse number="32" style="v" sid="GEN 42:32" />आमु बारे भाय एकीत बाह ना सोरा से, एक भाय ते मर ज्‌यो, पण नानलो आहयी टेमे कनान देस मे अमारा बाह ने तां से।’ <verse eid="GEN 42:32" /><verse number="33" style="v" sid="GEN 42:33" />तत्‌यार तीहयो अदमी, जे मीस्‌र देस नो मालीक से, अमारी सी केदो, ‘आनी सी मालम हय जहे के तमु ह़ुदा मानहु से; तमु आह़फाम मे सी एक ने मारी पांह मेकीन आह़फाम ना घोरवाळाम नी भुक मीटाड़वा नी लेदे कंय ली जावो, <verse eid="GEN 42:33" /><verse number="34" style="v" sid="GEN 42:34" />अने आह़फाम ना नान्‌ला भाय ने मारी पांह ली आवो। तत्‌यार मने भरहो हय जहे के तमु पतो लगाड़वा वाळा नी हय, ह़ुदला माणहु से। अळतेण मे तमारा भाय ने तमने ह़ोप देही, अने तमु आहया देस मे लेन-देन कर सकहु’।”<verse eid="GEN 42:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="GEN 42:35" />आहयु कीन तीहया आह़फा-आह़फा ठेला मे सी अन नीकाळवा बाज ज्‌या, तत्‌यार ह़ु देखया, के एक-एक जणा ना रुप्‌या नी ठेली तीहया ठेला मे मेकली से। तत्‌यार रुप्‌या नी ठेली देखीन तीहया अने तीमनो बाह घणा बीह ज्‌या। <verse eid="GEN 42:35" /><verse number="36" style="v" sid="GEN 42:36" />तत्‌यार तीमनो बाह याकुब तीमने केदो, “मने तमु वण-अवल्‌यात नो कर देदा, देखो, युसुफ बी नी र्‌यो, सीमोन बी नी आयो, अने हाव तमु बीन्‌यामीन ने बी लीजवा हींड र्‌या। आहयी आखी वेला मारी उपर आय पड़ली से।”<verse eid="GEN 42:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="GEN 42:37" />रुबेन आह़फा ना बाह सी केदो, “कदी मे बीन्‌यामीन ने पाछो नी लावु, ता मारा बेम सोरा ने मार नाखजे; तु हीने मार हात मे ह़ोप दे, मे हीने पाछो तारा हात मे पुगाड़ देही।”<verse eid="GEN 42:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="GEN 42:38" />याकुब केदो, “मारो सोरो बीन्‌यामीन तारी ह़ाते नी जाय; काहाके हीनो भाय युसुफ ते मर जेलो से, अने हाव तीहयो एखलो री र्‌यो: एतरे जे वाट्‌ये तु जही, तीनी मे कदी तीना पोर कानी वेला आय पड़े, तत्‌यार ते मे तमारी कारण आहया डायावारा नी हालत मे दुख भेळ मरला नी कळी मे रेही।”<verse eid="GEN 42:38" /></para>
  <chapter eid="GEN 42" />
  <chapter number="43" style="c" sid="GEN 43" />
  <para style="s">बीन्‌यामीन नी ह़ाते मीस्‌र देस जवा</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 43:1" />कनान देस मे काळ अळी बी घणु-जुदु हय ज्‌यु। <verse eid="GEN 43:1" /><verse number="2" style="v" sid="GEN 43:2" />जत्‌यार तीहयु अन जे मीस्‌र देस सी लावलु हतु, खुट ज्‌यु तत्‌यार तीमनो बाह तीमने केदो, “अळी जाय्‌न अमारी लेदे खावा नु कंय अळी अन वेचातु ली आवो।”<verse eid="GEN 43:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 43:3" />तत्‌यार यहुदा तीनी सी केदो, “तीहयो अदमी आमु ने चेतावणी आपीन केदो, कदी तमारो भाय तमारी ह़ाते नी आयो, ता तमु मारी अगळ नी आय सकता। <verse eid="GEN 43:3" /><verse number="4" style="v" sid="GEN 43:4" />एतरे कदी तु अमारा भाय ने अमारी ह़ाते मोकले, तत्‌यार ते आमु जाय्‌न तारी जुगु खावा नु अन वेचातु ली आवहु; <verse eid="GEN 43:4" /><verse number="5" style="v" sid="GEN 43:5" />पण कदी तीने नी मोकले, ता आमु नी जीया, काहाके तीहयो अदमी अमारी सी केदो, कदी तमारो भाय तमारी ह़ाते नी हय, ता तमु मारीन्‌तां नी आय सको।”<verse eid="GEN 43:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 43:6" />तत्‌यार याकुब केदो, “तमु तीहया अदमी ने आहयु देखाड़ीन के अमारो एक अळी भाय से, ह़ुका मार ह़ाते गलत कर्‌या?”<verse eid="GEN 43:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 43:7" />तीहया केदा, “जत्‌यार तीहयो अदमी अमारी अने अमारा कुटुम नी हालत ना बारा मे आहयी रीती सी पुछ्‌यो, ‘ह़ु तमारो बाह हाव लग जीवत्‌लो से? ह़ु तमारा कोय अळी भाय से? तत्‌यार आमु आहयी वात नी अनसारे तीने जपाप आप्‌यो, बाद मे ह़ु जाणता हता के तीहयो केहे, आह़फा भाय ने आञे ली आव’।”<verse eid="GEN 43:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 43:8" />अळतेण यहुदा आह़फा बाह याकुब सी केदो, “सोरा ने मार ह़ाते मोकल दे, के आमु जत रीया; आनी सी आमु, अने तु, अने अमारा सोरा-सोरी मरे नी, पण जीवत्‌ला रेहे। <verse eid="GEN 43:8" /><verse number="9" style="v" sid="GEN 43:9" />मे बीन्‌यामीन नो जामनी से; मारात हात सी तु हीने पाछो लेजे। कदी मे हीने तारीन्‌तां पुगाड़ीन अगळ नी उबो कर देम, तत्‌यार ते मे हमेसा नी लेदे तारो गुनाळ्‌ळो ठेरही। <verse eid="GEN 43:9" /><verse number="10" style="v" sid="GEN 43:10" />कदी आमु वार नी लगाड़ता, ता हजु लग बे कावा पाछा आवती रेता।”<verse eid="GEN 43:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="GEN 43:11" />तत्‌यार तीनो बाह याकुब तीमने केदो, “कदी ह़ाचलीन आसवी वात से, ता आहयु करो; आहया देस नी वारु-वारु चीज मे गेथु कंय-कंय आह़फाम ना ठेला मे तीहया अदमी जुगु भेट ली जावो: जीसम के थोड़ोक चीक, अने थोड़ुक मोद, अने गंदायण्‌यु तेल, पीस्‌ता, बदाम। <verse eid="GEN 43:11" /><verse number="12" style="v" sid="GEN 43:12" />अळी आह़फा-आह़फाम नी ह़ाते दुणा रुप्‌या ली जावो; अने जे रुप्‌या तमारा ठेला ना मोडा पोर मेकीन पाछा कर देदला हता, तीहया बी लेता जावो; कंखर माय्‌न आहयु भुल सी हयु हय। <verse eid="GEN 43:12" /><verse number="13" style="v" sid="GEN 43:13" />आह़फाम ना भाय ने बी ह़ाते लीन तीहया अदमीन्‌तां अळी जावो, <verse eid="GEN 43:13" /><verse number="14" style="v" sid="GEN 43:14" />अने आखा मे जोर-भर्‌यो भगवान तीहया अदमी ने तमारी पोर दयाळ्‌ळो करहे, जीनी सी के तीहयो तमारा बीजा भाय ने अने बीन्‌यामीन ने बी आव्‌वा देय: अने कदी मे वण-अवल्‌यात नो हयु ता हयवा देवो।”<verse eid="GEN 43:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 43:15" />तत्‌यार तीहया माणहु तीहयी भेट, अने दुणा रुप्‌या, अने बीन्‌यामीन ने बी ह़ाते लीन, चाल देदा अने मीस्‌र मे पुगीन युसुफ नी अगळ उबा हया, <verse eid="GEN 43:15" /><verse number="16" style="v" sid="GEN 43:16" />तीमनी ह़ाते बीन्‌यामीन ने देखीन युसुफ आह़फा ना घोर ना अदीकारी सी केदो, “ह़ेला माणहुम ने घोर मे पुगाड़ दे, अने जानवर ने मारीन खाणु तीयार करो; काहाके हीय्‌या माणहु बोपरी वळे मार ह़ाते खाणु खाहे।” <verse eid="GEN 43:16" /><verse number="17" style="v" sid="GEN 43:17" />तत्‌यार तीहयो अदीकारी माणेह युसुफ ना केवा नी अनसारे तीहया माणहुम ने युसुफ ना घोर मे ली ज्‌यो।<verse eid="GEN 43:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 43:18" />जत्‌यार तीहया युसुफ ना घोर पुगाड़ देदा तत्‌यार तीहया आह़फा-आह़फा बीहीन केवा बाज ज्‌या, “जे रुप्‌या पेली वार अमारा ठेला मे पाछा कर देदला हता, तीहया कारण सी आमु ने मोय पुगाड़ देदा; जीनी सी के तीहयो माणेह अमारी पोर गुनो लगाड़े, अने आमने हक मे करीन आह़फा ना पावर बणावे, अने अमारा गदड़ाम ने बी हापकी लेय।” <verse eid="GEN 43:18" /><verse number="19" style="v" sid="GEN 43:19" />तत्‌यार तीहया युसुफ ना घोर ना अदीकारी नी ह़ाते जाय्‌न घोर ना झापला पोर आहयी रीते केवा बाज ज्‌या, <verse eid="GEN 43:19" /><verse number="20" style="v" sid="GEN 43:20" />“ए अमारा मालीक, जत्‌यार आमु पेली वार अन वेचातु लेवा आवला हता, <verse eid="GEN 43:20" /><verse number="21" style="v" sid="GEN 43:21" />तत्‌यार आमु घोर जता हता ता वाट्‌ये धरम साहळा मे पुगीन अमारा ठेला छोड़्‌या, ता ह़ु देख्‌या के एक-एक जणा ना पुरा-पुरा रुप्‌या तीना ठेला ना मोडा पोर मेकला हता; एतरे आमु तीने अमारी ह़ाते अळी लेता आवला से। <verse eid="GEN 43:21" /><verse number="22" style="v" sid="GEN 43:22" />अने बीजा रुप्‌या बी खावा नु अन वेचातु लेवा नी लेदे लावला से; आमु नी जाणता के अमारा रुप्‌या अमारा ठेला मे कोय मेल देदलु हतु।”<verse eid="GEN 43:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 43:23" />अदीकारी केदो, “तमारु वारु हये, ना बीहो: तमारो भगवान, जे तमारा बाह नो बी भगवान से, तीहयोत तमने तमारा ठेला मे धन आप्‌यो हहे, तमारा रुप्‌या ते मने जड़ जेला हता।” अळतेण तीहयो सीमोन ने नीकाळीन तीमनी ह़ाते कर देदो।<verse eid="GEN 43:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 43:24" />तत्‌यार तीहयो अदीकारी तीहया माणहुम ने युसुफ ना घोर मे ली जाय्‌न पाणी आप्‌यो, तत्‌यार तीहया आह़फाम ना पोगु धोया; बाद मे तीहयो गदड़ा नी लेदे चारो आप्‌यो। <verse eid="GEN 43:24" /><verse number="25" style="v" sid="GEN 43:25" />तत्‌यार आहयु ह़मळीन, के आज आमु ने आञेत खाणु खावा पड़हे, तीहया युसुफ ने आव्‌वा नी टेम लग, मतलब बोपरी वळे लग, तीहयी भेट ने आपवा करीन एक्‌ठी करीन मेक्‌या। <verse eid="GEN 43:25" /><verse number="26" style="v" sid="GEN 43:26" />जत्‌यार युसुफ घोर आयो तत्‌यार तीहया ते भेट ने, जे तीमना हात मे हती, तीनी अगळ घोर मे ली ज्‌या, अने भोयमे पड़ीन तीने वांद्‌या। <verse eid="GEN 43:26" /><verse number="27" style="v" sid="GEN 43:27" />युसुफ तीमने वारु से के पुछ्‌यो अने केदो, “ह़ु तमारो डायलो बाह, जीनी तमु वात करला हता तीहयो वारलो से? ह़ु तीहयो हजु लग जीवत्‌लो से?”<verse eid="GEN 43:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 43:28" />तीहया केदा, “होव तारो पावर अमारो बाह वारलो से अने हजु लग जीवत्‌लो से।” तत्‌यार तीहया मुंडु हेटु करीन अळी वांद्‌या।<verse eid="GEN 43:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 43:29" />तत्‌यार तीहयो डोळा उचा करीन आह़फा सग्‌गा भाय बीन्‌यामीन ने देखीन पुछ्‌यो, “ह़ु आहयो तमारो नानलो भाय से जीनी वात तमु मार सी करला हता, आहयोत से? तीहयो बीन्‌यामीन सी केदो, ए मारा सोरा, भगवान तारी पोर दया करे।” <verse eid="GEN 43:29" /><verse number="30" style="v" sid="GEN 43:30" />तत्‌यार आह़फा ना भाय ना मोंग सी मन भरायवा नी कारण अने आहयु सोचीन के में कां जाय्‌न रड़ु, युसुफ ममार आह़फा ना कोपरा मे ज्‌यो, अने तां रड़ पड़्‌यो। <verse eid="GEN 43:30" /><verse number="31" style="v" sid="GEN 43:31" />बाद मे आह़फु मोडु धोवीन नीकळी आयो, अने आह़फा ने होगो करीन केदो, “खाणु आपो।” <verse eid="GEN 43:31" /><verse number="32" style="v" sid="GEN 43:32" />तत्‌यार तीहया तीनी जुगु ते अलग, अने भायुम नी लेदे बी अलग, अने जे मीस्‌री माणहु तीनी ह़ाते खाता हता, तीमनी लेदे बी अलग, खाणु आप्‌या; आनीन करते के मीस्‌री माणहु ईब्‌रानी माणहु ह़ाते खाणु नी खाय सकत्‌ला, मीस्‌री आसम करवा गलत ह़मजता हता। <verse eid="GEN 43:32" /><verse number="33" style="v" sid="GEN 43:33" />युसुफ ना भाय तीनी अगळ, मोट्‌ला-मोट्‌ला पेले, अने नान्‌ला-नान्‌ला पछळ, आपणी-आपणी उमर नी अनसारे, लाय्‌न सी बहाड़्‌या; आहयु देखीन तीहया वहराय ज्‌या अने एक बीजा भणी देखवा बाज ज्‌या। <verse eid="GEN 43:33" /><verse number="34" style="v" sid="GEN 43:34" />तत्‌यार युसुफ आह़फा अगळ गेथु खाणु चुटी-चुटीन तीमनी पांह मोकलवा बाज ज्‌यो, अने बीन्‌यामीन ने आह़फा भायुम नी गेथी पांच गुना खाणु जड़्‌यु। अने तीहया तीनी ह़ाते मन-भावतु खादा-पीदा।<verse eid="GEN 43:34" /></para>
  <chapter eid="GEN 43" />
  <chapter number="44" style="c" sid="GEN 44" />
  <para style="s">चांदी नो कटवरो</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 44:1" />तत्‌यार युसुफ आह़फा ना घोर ना अदीकारी ने हुकम आप्‌यो, “आहया माणहुम ना ठेला मे जेतरु खावा नु अन ह़माय सके तेतरु भर दे, अने एक-एक जणा ना रुप्‌या ने तीमना ठेला ना मोडा पोर मेक दे। <verse eid="GEN 44:1" /><verse number="2" style="v" sid="GEN 44:2" />अने मारो चांदी नो कटवरो नान्‌ला भाय ना ठेला ना मोडा पोर तीना अन ना रुप्‌या भेळ मेक दे।” युसुफ ना आहया हुकम नी लारे तीहयो कर्‌यो। <verse eid="GEN 44:2" /><verse number="3" style="v" sid="GEN 44:3" />ह़वारे वीजाळु हयतेत तीहया माणहु आह़फाम ना गदड़ा भेळ वळाय देदा। <verse eid="GEN 44:3" /><verse number="4" style="v" sid="GEN 44:4" />तीहया ह़ेर सी नीकळलात हता, अने नाम्‌बे नी जेला हता के युसुफ आह़फा ना घोर ना अदीकारी ने केदो, “तीहया माणहु नी पछळ जा, अने तीमने हात करीन तीमने के, तमु भलाय नी बदले बुराय ह़ुका कर्‌या? काहा तमु मारा मालीक नो चांदी नो कटवरो चोरी कर्‌या? <verse eid="GEN 44:4" /><verse number="5" style="v" sid="GEN 44:5" />ह़ु आहयी तीहयी चीज नी हय जीनी मे मारो मालीक पाणी पीतो हतो अने ह़तायली वात ने करतो हतो? जे काम तमु कर्‌या, तीहयु बुरु काम से।”<verse eid="GEN 44:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 44:6" />तत्‌यार तीहयो तीमने जाय्‌न धर लेदो, अने तीहयो युसुफ ना भायुम ने तीहयी वात केदो। <verse eid="GEN 44:6" /><verse number="7" style="v" sid="GEN 44:7" />तीहया तीने केदा, “ए अमारा मालीक तु आसवी वातु ह़ुका केय? आमु ह़ाम खाया के आसवु काम आमु नी कर्‌या। <verse eid="GEN 44:7" /><verse number="8" style="v" sid="GEN 44:8" />देख जे रुप्‌या अमारा ठेला ना मोडा पोर मेकला जड़ला हता, तीने आमु कनान देस सी तारी पांह पाछा लावला हता। तत्‌यार ह़ुका आमु तारा मालीक ना घोर मे सी ह़ोना नीता चांदी नी चीज चोरी कर सकया? <verse eid="GEN 44:8" /><verse number="9" style="v" sid="GEN 44:9" />तारा पावर्‌याम मे सी जीनी पांह बी तीहयु नीकळे, तीने मार नाखजे, अने आमु बी आपणा तीहया मालीक ना पावर्‌या बण जहु।”<verse eid="GEN 44:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 44:10" />घोर नो अदीकारी तीमने केदो, “तमारुत केवु संय से, जीनी पांह तीहयो कटवरो नीकळे ते मारो पावर हयहे; अने तमु वण-गुनाळ्‌ळा ठेरहु।” <verse eid="GEN 44:10" /><verse number="11" style="v" sid="GEN 44:11" />तीहया ममार आह़फा-आह़फाम ना ठेला भोय्‌मे उतार्‌या अने तीने छोड़वा बाज ज्‌या। <verse eid="GEN 44:11" /><verse number="12" style="v" sid="GEN 44:12" />तत्‌यार घोर नो अदीकारी ह़ोदवा बाज ज्‌यो, अने मोट्‌ला ना ठेला सी लीन नान्‌ला ना ठेला लग ह़ोद्‌यो: अने कटवरो बीन्‌यामीन ना ठेला मे जड़्‌यो। <verse eid="GEN 44:12" /><verse number="13" style="v" sid="GEN 44:13" />तत्‌यार तीहया आह़फा-आह़फाम ना लुगड़ा फाड़ीन दुखी हया, अने गदड़ा पोर ठेला मेकीन ह़ेर भणी पाछा ज्‌या।<verse eid="GEN 44:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="GEN 44:14" />जत्‌यार यहुदा अने तीना भाय युसुफ ना घोर पुग्‌या, ता युसुफ तांत हतो, तत्‌यार तीहया तीनी अगळ भुय्‌मे पड़्‌या। <verse eid="GEN 44:14" /><verse number="15" style="v" sid="GEN 44:15" />युसुफ तीमने केदो, “तमु आहयु केवु काम करला से? ह़ु तमु नी जाणता हता के मारीन तेवु माणेह ह़तायली वात बी जाण सके?”<verse eid="GEN 44:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 44:16" />यहुदा केदो, “आमु आपणा मालीक सी ह़ु कीया? आमु ह़ु कीन आह़फाम ने वण गुनाळ्‌ळा ठेरावया? भगवान तारा पावर्‌याम ना गलत काम ने धर लेदलो से। आमु, अने जीनी पांह कटवरो नीकळ्‌ळो तीहयो बी, आमु आखान आखा आपणा मालीक ना पावर्‌यात से।” <verse eid="GEN 44:16" /><verse number="17" style="v" sid="GEN 44:17" />युसुफ केदो, “आसम करवा मारी सी नाम्‌बे रेय, जे माणेह पांह कटवरो नीकळ्‌ळु से, तीहयोत मारो पावर हयहे; अने तमु आह़फा बाह नी तां सांती सी जत रेवो।”<verse eid="GEN 44:17" /></para>
  <para style="s">बीन्‌यामीन नी लेदे यहुदा नी वीन्‌ती</para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 44:18" />तत्‌यार यहुदा तीनी पांह जाय्‌न केवा बाज ज्‌यो, “ए मारा मालीक, तारा पावर ने आपणा मालीक सी एक वात केवा नो हुकम हये, अने तारी रीह तारा पावर पोर नी हये; काहाके तु फीरोन राजा नी तेवो से। <verse eid="GEN 44:18" /><verse number="19" style="v" sid="GEN 44:19" />मारो मालीक आह़फा पावर्‌याम सी पुछलो हतो, ‘ह़ु तमारो बाह नीता भाय से?’ <verse eid="GEN 44:19" /><verse number="20" style="v" sid="GEN 44:20" />अने आमु आपणा मालीक सी केदा, ‘ह़ोव, अमारो डायलो बाह से, अने तीना डायावारा नो एक नानलो सोरो बी से, पण तीनो भाय मर जेलो से, एतरे तीहयो हाव आह़फी आय्‌ह नो एखलोत री जेलो से, अने तीनो बाह तीनी सी मोंग राखत्‌लो से।’ <verse eid="GEN 44:20" /><verse number="21" style="v" sid="GEN 44:21" />तत्‌यार तु आह़फा पावर्‌याम सी केदलो हतो, ‘तीने मारीन्‌तां ली आवो, जीनी सी मे तीने देखु।’ <verse eid="GEN 44:21" /><verse number="22" style="v" sid="GEN 44:22" />तत्‌यार आमु आपणा मालीक सी केदला हता, ‘ह़ेलो सोरो आह़फा बाह ने नी छोड़ सकतो; नी ता तीनो बाह मर जहे।’ <verse eid="GEN 44:22" /><verse number="23" style="v" sid="GEN 44:23" />अने तु आह़फा पावर्‌याम सी केदो, ‘कदी तमारो नानलो भाय तमारी ह़ाते नी आवे, ता तमु मारी अगळ अळी नी आय सकत्‌ला।’<verse eid="GEN 44:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="GEN 44:24" />“एतरे जत्‌यार आमु अमारा बाह तारा पावर नी तां ज्‌या, तत्‌यार आमु तीनी सी आपणा मालीक नी वात केदा। <verse eid="GEN 44:24" /><verse number="25" style="v" sid="GEN 44:25" />तत्‌यार अमारो बाह केदो, ‘अळी जाय्‌न अमारी लेदे थोड़ुक खावा नु अन वेचातु ली आवो।’ <verse eid="GEN 44:25" /><verse number="26" style="v" sid="GEN 44:26" />आमु केदा, ‘आमु नी जाय सकत्‌ला, ह़ोव, कदी अमारो नानलो भाय अमारी ह़ाते जाय, तत्‌यार आमु जहु; काहाके कदी अमारो नानलो भाय अमारी ह़ाते नी रेय, ता आमु तीहया अदमी ना अगळ नी जाय सकत्‌ला।’ <verse eid="GEN 44:26" /><verse number="27" style="v" sid="GEN 44:27" />तत्‌यार तारो पावर मारो बाह अमारी सी केदो, ‘तमु ते जाणत्‌ला से के मारी बयर सी बे सोरा पयदा हया। <verse eid="GEN 44:27" /><verse number="28" style="v" sid="GEN 44:28" />अने तीनी मे सी एक ते मने छोड़ीत देदो, अने मे पक्‌को कर लेदो, के तीने फाड़ देदा हहे; अने तत्‌यार सी मे तीनु मुख नी देख सक्‌यो। <verse eid="GEN 44:28" /><verse number="29" style="v" sid="GEN 44:29" />कदी तमु आने बी मारा डोळा गेथा छेटा ली जावो, अने कानी वेला आनी पोर पड़े, ता तमारी कारण मे आहया डायावारा नी हालत मे दुख भेळ मरला नी कळी मे जत रेही।’<verse eid="GEN 44:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="GEN 44:30" />“एतरे जत्‌यार मे आपणा बाह तारा पावर नी तां पुग्‌यो, अने आहयो सोरो ह़ाते नी रेय, तत्‌यार तीनो जीव जे आनी पोर अटकी रेय, <verse eid="GEN 44:30" /><verse number="31" style="v" sid="GEN 44:31" />आहया कारण, आहयु देखीन के सोरु नी हय, तीहयो तेतरीत घड़ी मर जहे। तत्‌यार तारा पावर्‌याम नी कारण तारो पावर अमारो बाह, जे डायावारा नी हालत मे से, दुख भेळ मरला नी कळी मे जत रेहे। <verse eid="GEN 44:31" /><verse number="32" style="v" sid="GEN 44:32" />अळी तारा पावर आह़फा बाह नी तां आहयु कीन आहया सोरा नु जामनी रेलो से, ‘कदी मे आने तारी पांह नी पुगाड़ु, तत्‌यार ते मे हमेसा नी लेदे तारो गुनाळ्‌ळो ठेरही।’ <verse eid="GEN 44:32" /><verse number="33" style="v" sid="GEN 44:33" />एतरे हाव तारो पावर आहया सोरा नी बदले आपणा मालीक नो पावर हय्‌न रेवा नु हुकम मांगे, अने आहयु सोरु आह़फा भायुम नी ह़ाते जवा देय। <verse eid="GEN 44:33" /><verse number="34" style="v" sid="GEN 44:34" />काहाके सोरा वगर मे कीसम अमारा बाह नी पांह जाय सकही; आसम नी हये के मारा बाह पोर जे दुख पड़े तीहयु मने देखवा पड़े।”<verse eid="GEN 44:34" /></para>
  <chapter eid="GEN 44" />
  <chapter number="45" style="c" sid="GEN 45" />
  <para style="s">युसुफ आह़फा ना भायु ने आह़फा ना बारा मे देखाड़े</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 45:1" />तत्‌यार युसुफ तीहया आखाम नी अगळ, जे तीनी आड़े-धेड़े उबा हता, आह़फा ने अळी रोक नी सक्‌यो; अने आड़ीन केदो, “मारी आड़े-धेड़े ना आखा माणहु ने बारो कर दे।”<note caller="+" style="x"><char style="xo" closed="false">45:1 </char><char style="xt" closed="false"><ref loc="ACT 7:13">नेवताळा ना काम 7:13</ref></char></note> भायुम नी अगळ आह़फा ने उजन्‌तु करवा नी टेमे युसुफ नी ह़ाते अळी कोय नी हतु। <verse eid="GEN 45:1" /><verse number="2" style="v" sid="GEN 45:2" />तत्‌यार तीहयो आड़ी-आड़ीन रड़वा बाज ज्‌यो; अने मीस्‌री माणहु ह़मळ्‌या, अने फीरोन ना घोर ना माणहु ने बी खबर जड़ी। <verse eid="GEN 45:2" /><verse number="3" style="v" sid="GEN 45:3" />तत्‌यार युसुफ आह़फा ना भायुम सी केवा बाज ज्‌यो, “मे युसुफ से, ह़ु मारो बाह हाव लग जीवत्‌लो से?” आनो जपाप तीना भाय नी आप सक्‌या; काहाके तीहया तीनी अगळ घबराय जेला हता। <verse eid="GEN 45:3" /><verse number="4" style="v" sid="GEN 45:4" />अळतेण युसुफ आह़फा ना भायुम ने केदो, “मार ह़ाते आवो।” आहयु ह़मळीन तीहया ह़ाते ज्‌या। अळतेण तीहयो केदो, “मे तमारो भाय युसुफ से, जीने तमु आव्‌वा वाळा मीस्‌री माणहु ना हात मे वेच देदला हता। <verse eid="GEN 45:4" /><verse number="5" style="v" sid="GEN 45:5" />हाव तमु ना पसतायो, अने तमु जे मने आये वेच देदला, आनी सी नराज ना हयो; काहाके भगवान तमारा जीव ने बचाड़वा नी लेदे मने तमारी अगळ मोकल देदलो से। <verse eid="GEN 45:5" /><verse number="6" style="v" sid="GEN 45:6" />काहाके हाव बे साल सी आहयु देस मे काळ से; अने हाव सी पांच वरहु अळी आसवात हयहे के तीमनी मे नी ता होळ चालहे अने नी मेर वाडे। <verse eid="GEN 45:6" /><verse number="7" style="v" sid="GEN 45:7" />एतरे भगवान मने तमारी अगळ आनीन करते मोकल्‌यो के तमु धरती पोर जीवत्‌ला रेवो, अने तमारो जीव बचवा सी तमारी अवल्‌यात वदे। <verse eid="GEN 45:7" /><verse number="8" style="v" sid="GEN 45:8" />आहयी रीते हाव मने आये मोकलवा वाळा तमु नी हय, भगवानेत ठेर्‌यो; अने तीहयोत मने फीरोन ना बाह ने तेवो, अने तीना आखा घोर नो मालीक, अने आखा मीस्‌र देस नो मुख्‌यो अदीकारी ठेराय देदलो से।<verse eid="GEN 45:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 45:9" />“हाव ममार मारा बाहन्‌तां जाय्‌न केवो, ‘तारो सोरो युसुफ आहयु केय, के भगवान मने आखा मीस्‌र देस नो मुख्‌यो अदीकारी बणावलो से; एतरे वार लगाड़्‌या वगर मारीन तां आवती रेवो।<note caller="+" style="x"><char style="xo" closed="false">45:9 </char><char style="xt" closed="false"><ref loc="ACT 7:14">नेवताळा ना काम 7:14</ref></char></note> <verse eid="GEN 45:9" /><verse number="10" style="v" sid="GEN 45:10" />अने तारो रेवा नो जागो गोसेन देस मे रेहे, अने तु सोरा, सोरा ना सोरा, गाडरा अने बोकड़्‌या, गाय अने बोळद्‌या, अने आह़फा नु आखु भेळ मारीन्‌तां रेही। <verse eid="GEN 45:10" /><verse number="11" style="v" sid="GEN 45:11" />अने काळ ना जे पांच वरहु अळी हयहे, तीमनी मे तां तारु पालन-पोसण करही; आसम नी हये के तु, अने तारु घोराणु, अने जेतरा तारा से, तीहया भुकला मरे।’”<verse eid="GEN 45:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 45:12" />अने तमु तमारा डोळा सी देखला से, “अने मारो भाय बीन्‌यामीन बी आह़फा ना डोळे देखलो से के जे अमारी सी वात कर र्‌यो तीहयो युसुफ से। <verse eid="GEN 45:12" /><verse number="13" style="v" sid="GEN 45:13" />तमु मारी आखी ईज्‌जत ने, जे मीस्‌र मे से अने जे कंय तमु देखला से, तीहयु आखु मारा बाह सी केजो; अने ममार मारा बाह ने आञे ली आवजो।” <verse eid="GEN 45:13" /><verse number="14" style="v" sid="GEN 45:14" />अने तीहयो आह़फा ना भाय बीन्‌यामीन ना गळे लागीन रड़्‌यो; अने बीन्‌यामीन बी तीने गळे लागीन रड़्‌यो। <verse eid="GEN 45:14" /><verse number="15" style="v" sid="GEN 45:15" />तीहयो आह़फा ना आखा भायुम ने गोळो दीन रड़्‌यो अने आनी बाद तीना भाय तीनी सी वात करवा बाज ज्‌या।<verse eid="GEN 45:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 45:16" />आहयी वात नी खबर के युसुफ ना भाय आय र्‌या, फीरोन ना महल लग पुग जी, अने आनी सी फीरोन राजा अने तीना काम करवा वाळा माणहु खुस हया। <verse eid="GEN 45:16" /><verse number="17" style="v" sid="GEN 45:17" />एतरे फीरोन युसुफ सी केदो, “आह़फा ना भायुम ने के, के एक काम करो: आह़फाम ना गदड़ा पोर अन मेकीन कनान देस मे जत रेवो। <verse eid="GEN 45:17" /><verse number="18" style="v" sid="GEN 45:18" />अने आह़फाम ना बाह अने आह़फा-आह़फाम ना घोर ना माणहुम ने लीन मारीन्‌तां आवो; अने मीस्‌र देस मे जे कंय वारु सी वारु से तीहयु मे तमने आलही, अने तमने देस ना वारु सी वारु खाणु खावा जड़हे। <verse eid="GEN 45:18" /><verse number="19" style="v" sid="GEN 45:19" />अने तने हुकम आपु तमु एक काम करो के मीस्‌र देस सी आह़फाम ना सोरा-सोरी अने बयराम नी लेदे गाड्‌या ली जावो, अने आह़फाम ना बाह ने ली आवो। <verse eid="GEN 45:19" /><verse number="20" style="v" sid="GEN 45:20" />अने आह़फाम ना ह़मान नी फीकर नी करजो; काहाके आखा मीस्‌र देस मे जे कंय वारु सी वारु से तीहयु आखु तमारु से।”<verse eid="GEN 45:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 45:21" />याकुब ना सोरा तेमेत कर्‌या; अने युसुफ फीरोन ना हुकम नी अनसारे तीमने गाड्‌या आप्‌यो, अने वाट्‌ये जुगु खावा नु ह़मान बी आप्‌या। <verse eid="GEN 45:21" /><verse number="22" style="v" sid="GEN 45:22" />युसुफ तीमने एक-एक जणा ने ते तीहयो एक-एक जोड़ी लुगड़ा बी आप्‌यो; अने बीन्‌यामीन ने तीन ह़ोव चांदी ना सीक्‌का अने पांच जोड़ी लुगड़ा आप्‌यो। <verse eid="GEN 45:22" /><verse number="23" style="v" sid="GEN 45:23" />आह़फा ना बाह ने तां तीहयो जे ली मोकल्‌यो आहयु से, मीस्‌र देस नी वारली चीजु सी भरला दह गदड़ा, अने अन अने रोट्‌ला अने तीना बाह नी लेदे वाट्‌ये नु खाणु सी भरली दह गदड़ी मोकल्‌यो। <verse eid="GEN 45:23" /><verse number="24" style="v" sid="GEN 45:24" />तत्‌यार तीहयो आह़फा भायुम ने वळाय देदो, अने तीहया चाल पड़्‌या; अने तीहयो तीमने केदो, “वाट्‌ये कंखर झगड़ो नी करजो।”<verse eid="GEN 45:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 45:25" />मीस्‌र देस सी चालीन तीहया कनान देस मे आह़फा बाह ने तां पुग्‌या। <verse eid="GEN 45:25" /><verse number="26" style="v" sid="GEN 45:26" />अने तीनी सी आहयु आखु केदा, “युसुफ हजु लग जीवत्‌लो से, अने आखा मीस्‌र देस पोर राज तीहयोत करे।” पण तीहयो तीमनी वात पोर भरहो नी कर्‌यो, अने तीहयो होस मे नी र्‌यो।<verse eid="GEN 45:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 45:27" />तत्‌यार तीहया आह़फा ना बाह याकुब ने युसुफ नी आखी वात, जे तीहयो तीमने केदली हती, की देदो; जत्‌यार तीहयो तीहयी गाडीम ने देख्‌यो, जे युसुफ तीमने लीन आव्‌वा नी लेदे मोकल्‌लो हतो, तत्‌यार तीना मन ने सांती जड़ी। <verse eid="GEN 45:27" /><verse number="28" style="v" sid="GEN 45:28" />अने याकुब केदो, “हेतरुत, मारो सोरो युसुफ हाव लग जीवत्‌लो से; मे मारी मोत सी पेले जाय्‌न तीने देखही।”<verse eid="GEN 45:28" /></para>
  <chapter eid="GEN 45" />
  <chapter number="46" style="c" sid="GEN 46" />
  <para style="s">याकुब नु आखा घोरबाल्‌या भेळ मीस्‌र मे जाणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 46:1" />तत्‌यार याकुब आह़फा नु आखु कंय लीन बेर्‌सेबा ज्‌यो, अने तां आह़फा ना बाह ईसाक ना भगवान ने बादा चड़ायो। <verse eid="GEN 46:1" /><verse number="2" style="v" sid="GEN 46:2" />तत्‌यार भगवान याकुब सी राते दरसन मे केदो, “ए याकुब ए याकुब।” तीहयो केदो, “ह़ु हुकम।”<verse eid="GEN 46:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="GEN 46:3" />तीहयो केदो, “मे भगवान तारा बाह नो भगवान से, तु मीस्‌र मे जवा सी ना बीहे; काहाके मे तारी सी तां एक मोट्‌लु राज्‌य बणावही। <verse eid="GEN 46:3" /><verse number="4" style="v" sid="GEN 46:4" />मे तारी ह़ाते-ह़ाते मीस्‌र आवही; अने मे तने तां सी अळी पक्‌को ली आवही; अने युसुफ आह़फा ना हात सी तारा डोळा ने बंद करहे।”<verse eid="GEN 46:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 46:5" />तत्‌यार याकुब बेर्‌सेबा गेथो ज्‌यो; अने जे गाड्‌या फीरोन याकुब ने लाव्‌वा नी लेदे मोकल्‌लो हतो, तीमनी मे याकुब ना सोरा तीमनो बाह याकुब, अने आह़फा ना सोरा-सोरी, अने बयराम ने बहाड़्‌या अने लीन ज्‌या। <verse eid="GEN 46:5" /><verse number="6" style="v" sid="GEN 46:6" />तीहया आह़फा ना गाडरा अने बोकड़्‌या, गाय अने बोळद्‌या, अने कनान देस मे आह़फा नु एकठु करलु आखु धन ने लीन मीस्‌र देस मे आया।<note caller="+" style="x"><char style="xo" closed="false">46:6 </char><char style="xt" closed="false"><ref loc="ACT 7:15">नेवताळा ना काम 7:15</ref></char></note> <verse eid="GEN 46:6" /><verse number="7" style="v" sid="GEN 46:7" />अने याकुब आह़फा ना सोरा-सोरी, अने तीमना सोरा-सोर्‌याम ना सोराम ने, अने आह़फा ना आखा घोराणा ने आह़फा ह़ाते मीस्‌र देस मे ली आयो।<verse eid="GEN 46:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 46:8" />याकुब ह़ाते जे ईस्‌रायली, मतलब तीमना सोरा, अने तीमना सोरा-सोरी आखा मीस्‌र देस मे आया, तीमना नाम आहया से याकुब नो मोट्लो सोरो रुबेन हतो। <verse eid="GEN 46:8" /><verse number="9" style="v" sid="GEN 46:9" />अने रुबेन नो सोरो हनोक, पल्‌लु हेस्‌रोन, अने कर्‌मी हता। <verse eid="GEN 46:9" /><verse number="10" style="v" sid="GEN 46:10" />सीमोन ना सोरा, यमुएल, यामीन, ओहद, याकीन, सोहर, अने एक कनानी बयर सी पयदा हयलो साउल बी हतो। <verse eid="GEN 46:10" /><verse number="11" style="v" sid="GEN 46:11" />लेवी ना सोरा गेर्‌सोन, कहात, अने मरारी हता। <verse eid="GEN 46:11" /><verse number="12" style="v" sid="GEN 46:12" />यहुदा ना सोरा एर, ओनान, सेला, पेरेस, अने जेरह नाम ना सोरा हयला ते हता; पण एर अने ओनान कनान देस मे मर जेला हता; अने पेरेस ना सोरा, हेस्‌रोन अने हामुल हता। <verse eid="GEN 46:12" /><verse number="13" style="v" sid="GEN 46:13" />ईस्‌साकार ना सोरा, तोला, पुव्‌वा, योब अने सीम्‌रोन हता। <verse eid="GEN 46:13" /><verse number="14" style="v" sid="GEN 46:14" />जबुलुन ना सोरा, सेरेद, एलोन, अने यहलेल हता। <verse eid="GEN 46:14" /><verse number="15" style="v" sid="GEN 46:15" />लीवा ना सोरा, जे याकुब सी पदनराम पयदा हयलो हतो, तीमना सोरा अळी तीमना सोरा आहयात से, अने आनी गेथो जादा तीहयो एक सोरी दीना ने बी पयदा कर्‌यो। आञे लग ते याकुब नी आखी पीड़ी तयतीस माणहु हया।<verse eid="GEN 46:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 46:16" />अळी गाद ना सोरा, सपोन हाग्‌गी, सुनी, एसबोन, एरी, अरोदी, अने अरेली हता। <verse eid="GEN 46:16" /><verse number="17" style="v" sid="GEN 46:17" />आसेर ना सोरा, यीम्‌ना, यीस्‌वा, यीस्‌वी, अने बरीवा, हता, अने तीमनी बेनेह सेरह हती; अने बरीवा ना सोरा, हेबेर अने मल्‌कीएल हता। <verse eid="GEN 46:17" /><verse number="18" style="v" sid="GEN 46:18" />जील्‌पा, जीने लाबान आह़फी सोरी लीवा ने आपलो हतो, तीमना सोरा अने तीमना सोरा आहयात हता; अने तीनी लारे याकुब ना ह़ोळ्‌ळे माणहु पयदा हया।<verse eid="GEN 46:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 46:19" />अळतेण याकुब नी लाडी राहेल ना सोरा युसुफ अने बीन्‌यामीन हता। <verse eid="GEN 46:19" /><verse number="20" style="v" sid="GEN 46:20" />अने मीस्‌र देस मे ओन ह़ेर ना पुंजारा पोतीपेरा नी सोरी आसनत सी युसुफ ना आहया सोरा मनस्‌से अने एप्‌रेम पयदा हया।<note caller="+" style="x"><char style="xo" closed="false">46:20 </char><char style="xt" closed="false"><ref loc="GEN 41:50-52">उबजणाय कीताप 41:50-52</ref></char></note> <verse eid="GEN 46:20" /><verse number="21" style="v" sid="GEN 46:21" />बीन्‌यामीन ना सोरा, बेला, बेकेर, अस्‌बेल, गेरा, नामान, एही, रोस, मप्‌पीम, हुप्‌पीम, अने अर्‌द हता। <verse eid="GEN 46:21" /><verse number="22" style="v" sid="GEN 46:22" />राहेल ना सोरा याकुब सी पयदा हयला तीहया आहयात सोरा हता; तीमना आहया आखा सोरा अने तीमना सोरा चोवदे माणहु हया।<verse eid="GEN 46:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="GEN 46:23" />अळतेण दान नो सोरो हुसीम हतो। <verse eid="GEN 46:23" /><verse number="24" style="v" sid="GEN 46:24" />नप्‌ताली ना सोरा, यहसेल, गुनी, सेसेर, अने सील्‌लेम हता। <verse eid="GEN 46:24" /><verse number="25" style="v" sid="GEN 46:25" />बील्‌हा पावर्‌याण, जीने लाबान आह़फी सोरी राहेल ने आप्‌यो, तीमना सोरा अने तीमना सोरा आहयात से; तीनी लारे याकुब नी अवल्‌यात मे सात माणहु हया।<verse eid="GEN 46:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="GEN 46:26" />याकुब नी अवल्‌यात ना आखा माणहु, जे तीमनी ह़ाते मीस्‌र देस मे आवला हता, याकुब नी आखी ववेह़ ने छोड़ीन, आखा छीयासठ माणहु हता। <verse eid="GEN 46:26" /><verse number="27" style="v" sid="GEN 46:27" />अळी युसुफ ना सोरा, जे मीस्‌र मे तीनी से पयदा हया, तीहया बे माणहु हता; आहयी रीते याकुब ना घोराणा ना जे माणहु मीस्‌र देस मे आया तीहया आखा मेळीन सत्‌तर हया।<note caller="+" style="x"><char style="xo" closed="false">46:27 </char><char style="xt" closed="false"><ref loc="ACT 7:14">नेवताळा ना काम 7:14</ref></char></note><verse eid="GEN 46:27" /></para>
  <para style="s">याकुब अने तीनु घोराणु मीस्‌र देस मे पुगे</para>
  <para style="p">
    <verse number="28" style="v" sid="GEN 46:28" />अळतेण याकुब यहुदा ने आह़फा अगळ युसुफ नी पांह मोकल देदो के तीहयो तीमने गोसेन नी वाट देखाड़े; अने तीहया गोसेन देस मे आया। <verse eid="GEN 46:28" /><verse number="29" style="v" sid="GEN 46:29" />तत्‌यार युसुफ आह़फा नी घोड़ागाडी जोपाड़ीन आह़फा ना बाह याकुब सी भेट करवा नी लेदे गोसेन देस मे ज्‌यो, अने तीनी सी भेट करीन तीने गळे लाग्‌यो, अने ढेरेत वार लग तीने गळे लागीन रड़तो र्‌यो। <verse eid="GEN 46:29" /><verse number="30" style="v" sid="GEN 46:30" />तत्‌यार याकुब, युसुफ सी केदो, “मे हाव मरवा सी बी खुस से, काहाके तने जीवत्‌लो देख्‌यो अने हाव तारु मोडु देख लेदो।”<verse eid="GEN 46:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 46:31" />तत्‌यार युसुफ आह़फा ना भायु सी अने आह़फा ना बाह ना घोराणा सी केदो, “मे जाय्‌न फीरोन ने आहयी खबर आपही, ‘मारा भाय अने मारा बाह ना आखा घोराणा ना माणहु जे कनान देस मे रेता हता, तीहया मारी पांह आय जेला से; <verse eid="GEN 46:31" /><verse number="32" style="v" sid="GEN 46:32" />अने तीहया माणहु गुवाळ्‌या से, काहाके तीहया जानवरु ने पाळता आय र्‌या; एतरे तीहया आह़फा गाडरा अने बोकड़्‌या, गाय अने बोळद्‌या, अने जे कंय तीमनु से, आखा ली आवला से।’ <verse eid="GEN 46:32" /><verse number="33" style="v" sid="GEN 46:33" />जत्‌यार फीरोन तमने बोलावीन पुछे, ‘तमारु ह़ु काम से?’ <verse eid="GEN 46:33" /><verse number="34" style="v" sid="GEN 46:34" />तत्‌यार आहयु केजो, तारा पावर, आमु, अने अमारा आड़ा-बुड़ा नान्‌ला ने हजु लग जानवरु पाळता आवला से, जीनी सी तमु गोसेन देस मे री सको।” काहाके मीस्‌र ना माणहु गुवाळ्‌या सी ह़ीगी करे।<verse eid="GEN 46:34" /></para>
  <chapter eid="GEN 46" />
  <chapter number="47" style="c" sid="GEN 47" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 47:1" />तत्‌यार युसुफ फीरोन नी पांह जाय्‌न आहयी खबर आप्‌यो, “मारो बाह अने मारा भाय, अने तीमना गाडरा अने बोकड़्‌या, गाय अने बोळद्‌या अने जे कंय तीमनु से, आखा कनान देस सी आय जेला से; अने हमणे ते तीहया गोसेन देस मे से।” <verse eid="GEN 47:1" /><verse number="2" style="v" sid="GEN 47:2" />अळतेण तीहयो आह़फा भायुम मे सी पांच जणा ने लीन फीरोन नी अगळ उबो कर देदो। <verse eid="GEN 47:2" /><verse number="3" style="v" sid="GEN 47:3" />फीरोन युसुफ ना भायुम ने पुछ्‌यो, “तमारु काम ह़ु से?” तीहया फीरोन ने केदा, “तारा पावर्‌या गुवाळ्‌या से, अने अमारा आड़ा-बुड़ा बी गुवाळ्‌या हता।” <verse eid="GEN 47:3" /><verse number="4" style="v" sid="GEN 47:4" />अळतेण तीहया फीरोन सी केदा, “आमु आहया देस मे परदेसीन तेम रेवा नी लेदे आवला से; काहाके कनान देस मे जुदो काळ हयवा नी कारण तारा पावर्‌याम ना गाडरा अने बोकड़्‌याम नी लेदे चारो नी र्‌यो; एतरे आह़फाम ना पावर्‌याम ने गोसेन देस मे रेवा नो हुकम आप।” <verse eid="GEN 47:4" /><verse number="5" style="v" sid="GEN 47:5" />तत्‌यार फीरोन राजा युसुफ सी केदो, “तारो बाह अने तारा भाय तारी पांह आवला से, <verse eid="GEN 47:5" /><verse number="6" style="v" sid="GEN 47:6" />अने मीस्‌र देस तारी अगळ से; आहया देस नो जे आखा गेथो वारु जागो हय, तीनी मे आह़फा ना बाह अने भायुम ने वहाड़ दे; नीता तीमने गोसेन देस मेत रेवा दे; अने कदी तु जाणतो हय, के तीमनी मे मेहनती माणहु हय, ता तीमने मारा जानवरु ना अदीकारी ठेराय दे।”<verse eid="GEN 47:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 47:7" />तत्‌यार युसुफ आह़फा ना बाह ने फीरोन नी अगळ उबो कर्‌यो; अने याकुब फीरोन ने बरकत आप्‌यो। <verse eid="GEN 47:7" /><verse number="8" style="v" sid="GEN 47:8" />तत्‌यार फीरोन याकुब सी पुछ्‌यो, “तारी उमर केतरी से?”<verse eid="GEN 47:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 47:9" />याकुब फीरोन सी केदो, “मे ते एक ह़ोव तीस वरहु परदेसी हय्‌न मारी जीवाय जीव लेदलो से; मारी जीवाय ना दाड़ा थोड़ाक दुख सी बी भरला हता, अने मारा आड़ा-बुड़ा परदेसी हय्‌न जेतरा दाड़ा लग जीवत्‌ला र्‌या तेतरा दाड़ा नो मे बी हजु नी हयो।” <verse eid="GEN 47:9" /><verse number="10" style="v" sid="GEN 47:10" />अने याकुब फीरोन ने बरकत आपीन तीनी अगळ सी जत र्‌यो। <verse eid="GEN 47:10" /><verse number="11" style="v" sid="GEN 47:11" />तत्‌यार युसुफ आह़फा ना भायुम ने वहाड़ देदो, अने फीरोन ना हुकम नी अनसारे मीस्‌र देस ना वारु सी वारु जागा मे, मतलब रामसेस नाम ना ह़ेर मे जागो आपीन तीमने ह़ोप देदो। <verse eid="GEN 47:11" /><verse number="12" style="v" sid="GEN 47:12" />अने युसुफ आह़फा ना बाह नी, अने आह़फा ना भायुम नी, अने बाह ना आखा घोराणा नी, एक-एक ना सोरा सोरी नी गीनती नी अनसारे, खाणु अपाड़ी-अपाड़ीन तीमनु पालन-पोसण करवा बाज ज्‌यो।<verse eid="GEN 47:12" /></para>
  <para style="s">काळ</para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 47:13" />तीहया आखा देस मे खावा नी लेदे कंय नी र्‌यु; काहाके काळ घणु भारी हतु, अने काळ नी कारण मीस्‌र अने कनान बेम देस खत्‌तम हय ज्‌या हता। <verse eid="GEN 47:13" /><verse number="14" style="v" sid="GEN 47:14" />अने जेतरा रुप्‌या मीस्‌र अने कनान देस मे हता, आखाम ने युसुफ तीहया अन ना बदले, जे तां रेवा वाळा वेचातु लेता हता एक्‌ठु करीन फीरोन ना घोर मे पुगाड़ देदो। <verse eid="GEN 47:14" /><verse number="15" style="v" sid="GEN 47:15" />जत्‌यार मीस्‌र अने कनान देस ना रुप्‌या खत्‌तम हय ज्‌या, तत्‌यार आखा मीस्‌र ना माणहु युसुफ नी पांह आवीन केवा बाज ज्‌या, “आमने खावा नु अन आप, ह़ु आमु रुप्‌या नी रेवा सी तारा रेते मर जीया?”<verse eid="GEN 47:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="GEN 47:16" />युसुफ केदो, “कदी रुप्‌या नी हय ता आह़फाम ना जानवरु आपो, अने मे तीमनी बदले तमने अन आलही।” <verse eid="GEN 47:16" /><verse number="17" style="v" sid="GEN 47:17" />तत्‌यार तीहया आह़फाम ना जानवरु युसुफ पांह ली आया; अने युसुफ तीमने घोड़ा, गाडरा अने बोकड़्‌या, गायु अने बोळद्‌या अने गदड़ा नी बदले अन आपवा बाज ज्‌यो। तीहया साल मे तीहयो आखा जाती ना जानवरु नी बदले अन आपीन तीमनो पालन-पोसण करतो र्‌यो।<verse eid="GEN 47:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 47:18" />तीहयो साल ते जत र्‌यो; तत्‌यार अगला साल मे तीहया तीमनी पांह आवीन केदा, “आमु अमारा मालीक सी आहयी वात ह़ताड़ नी सकता के अमारा रुप्‌या खत्‌तम हय जेला से, अने अमारा आखा भाती ना जानवरु अमारा मालीक ना हय जेला से; एतरे हाव अमारा मालीक नी अगळ अमारो डील अने जागा छोड़ीन अळी कंय नी र्‌यु। <verse eid="GEN 47:18" /><verse number="19" style="v" sid="GEN 47:19" />आमु अने अमारा खेतर तारी रेते ह़ुका खत्‌तम हये? आमने अने अमारी जागा ने अन नी बदले वेचाता ली ले, के आमु अमारी जागा भेळ फीरोन ना पावर्‌या हय जाय अने आमने बीज आप, के आमु मरीया नी, पण जीवत्‌ला रीया, अने जागा नी उजड़े।”<verse eid="GEN 47:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 47:20" />तत्‌यार युसुफ मीस्‌र देस नी आखी जागा ने फीरोन नी लेदे वेचाती लेदो; काहाके तीहया घणो काळ पड़वा सी मीस्‌र ना माणहु ने आह़फा-आह़फा खेतरु वेच देदा आहयी रीते आखी जागा फीरोन नी हय जी। <verse eid="GEN 47:20" /><verse number="21" style="v" sid="GEN 47:21" />अने मीस्‌र देस नी एक काकड़ सी बीजी काकड़ लग जे माणहु रेता हता, युसुफ तीमने ह़ेरु मे वहाड़ लेदो। <verse eid="GEN 47:21" /><verse number="22" style="v" sid="GEN 47:22" />पण पुंजाराम नी जागा तीहयो वेचाती नी लेदो; काहाके पुंजाराम नी लेदे फीरोन नी पांह गेथु दाड़ीन अन जड़तु हतु, अने फीरोन जे अन दाड़ीन आपतो हतो तीहयुत खाता हता; आहया कारण तीमने आह़फाम जागा वेचवा नी पड़ी। <verse eid="GEN 47:22" /><verse number="23" style="v" sid="GEN 47:23" />तत्‌यार युसुफ माणहुम सी केदो, “ह़मळो, मे आज तमने अने तमारी जागा ने फीरोन नी लेदे वेचाता लेदलो से; देखो, तमारी जुगु आञे बीज से, अने खेतरु मे वेरो। <verse eid="GEN 47:23" /><verse number="24" style="v" sid="GEN 47:24" />अने जे कंय पाके तीनो पांचवो वाटो फीरोन ने आपजो, बीजा चार वाटा तमारा रेहे के तमु आह़फाम ना खेतर मे वेरो, अने आह़फा-आह़फाम ना सोरा-सोरी अने घोर ना बीजा माणहु ह़ाते खाया करो।”<verse eid="GEN 47:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="GEN 47:25" />तीहया केदा, “तु आमने बचाड़ लेदो; अमारा मालीक नी दया नी नींगा अमारी पोर बणीन रेय, अने आमु फीरोन ना पावर्‌या बणीन रेहु।” <verse eid="GEN 47:25" /><verse number="26" style="v" sid="GEN 47:26" />आहयी रीते युसुफ मीस्‌र देस नी जागा ना वारा मे आसम नेम ठेरायो, जे आज ना दाड़े लग चालतो आय र्‌यो के पांचवो वाटो फीरोन ने जड़्‌या करे; पण पुंजारा नी जागा एतरी फीरोन नी, नी हयी।<verse eid="GEN 47:26" /></para>
  <para style="s">याकुब नी आखरी ईच्‌छा</para>
  <para style="p">
    <verse number="27" style="v" sid="GEN 47:27" />ईस्‌रायल ना माणहु मीस्‌र ना गोसेन परदेस मे रेवा बाज ज्‌या; अने तां नी जागा तीमना हक मे हती, अने तीहया फाल्‌या-फुल्‌या अने वदता ज्‌या। <verse eid="GEN 47:27" /><verse number="28" style="v" sid="GEN 47:28" />मीस्‌र देस मे याकुब सत्‌तर साल जीवत्‌लो र्‌यो आहयी रीते याकुब नी आखी उमर एक ह़ोव संयताळीस साल नी हयी। <verse eid="GEN 47:28" /><verse number="29" style="v" sid="GEN 47:29" />जत्‌यार याकुब ने मरवा ना दाड़ा हाते आया, तत्‌यार तीहयो आह़फा ना सोरा युसुफ ने ह़ाते बोलावीन केदो, “कदी तारी दया मारी पोर से, ता आह़फा नु हात मारा ह़ातळ्‌या नी हेटो मेलीन ह़ाम खा, के तु मार ह़ाते दया अने खरलो काम करही, के मने मीस्‌र देस मे नी गाड़जे।<note caller="+" style="x"><char style="xo" closed="false">47:29 </char><char style="xt" closed="false"><ref loc="GEN 49:29-32">उबजणाय कीताप 49:29-32</ref>; <ref loc="GEN 50:6">50:6</ref></char></note> <verse eid="GEN 47:29" /><verse number="30" style="v" sid="GEN 47:30" />जत्‌यार मे मारा आड़ा-बुड़ा नी ह़ाते ह़ुय जही, ता तु मने मीस्‌र देस सी उचलीन तीमनात मड़ाट्‌या मे गाड़जे।” तत्‌यार युसुफ केदो, “मे तारा बोल नी अनसारे करही।”<verse eid="GEN 47:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="GEN 47:31" />अळतेण तीहयो केदो, “मार सी ह़ाम खा।” तत्‌यार युसुफ याकुब सी ह़ाम खादो। तत्‌यार याकुब खाट्‌लु ना मुंडा भणी मुंडु हेटु करीन वीन्‌ती कर्‌यो।<verse eid="GEN 47:31" /></para>
  <chapter eid="GEN 47" />
  <chapter number="48" style="c" sid="GEN 48" />
  <para style="s">याकुब नु मनस्‌से अने एप्‌रेम ने बरकत आपणु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 48:1" />आहयी वात नी अळतेण कानो युसुफ ने केदो, “ह़मळ तारो बाह मांदलो से।” तत्‌यार तीहयो मनस्‌से अने एप्‌रेम नाम ना बेम सोराम ने ह़ाते लीन तीनी पांह जत र्‌यो। <verse eid="GEN 48:1" /><verse number="2" style="v" sid="GEN 48:2" />कानो याकुब ने की देदो, के तारो सोरो युसुफ तारीन्‌तां आव्‌वा बाज र्‌यो, तत्‌यार याकुब आह़फा ने ह़माळीन खाटलु पोर बह ज्‌यो। <verse eid="GEN 48:2" /><verse number="3" style="v" sid="GEN 48:3" />अने याकुब युसुफ सी केदो, “आखा मे जोर-भर्‌यो भगवान कनान देस ना लुज ह़ेर नी पांह मने दरसन आपीन बरकत आप्‌यो,<note caller="+" style="x"><char style="xo" closed="false">48:3 </char><char style="xt" closed="false"><ref loc="GEN 28:13">उबजणाय कीताप 28:13</ref>,<ref loc="GEN 28:14">14</ref></char></note> <verse eid="GEN 48:3" /><verse number="4" style="v" sid="GEN 48:4" />अने केदो, ‘ह़मळ, मे तने ढेरेत सोरा आपीन वदाड़ही, अने तने राज्‌य-राज्‌य नी पीड़ी नो मुख्‌यो बणावही, अने तारीन अळतेण तारी अवल्‌यात ने आहयु देस आपही, जीनी सी के तीहयी हमेसा लग तीमनी खुद नी जागा बणीन रेहे।’”<verse eid="GEN 48:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="GEN 48:5" />“अने हाव तारा बेम सोरा, जे मीस्‌र देस मे मारी आव्‌वा सी पेले पयदा हयला से, तीहया मारात ठेरहे; जे रीते रुबेन अने सीमोन मारा से, तीहयी रीती सी एप्‌रेम अने मनस्‌से बी मारा ठेरहे। <verse eid="GEN 48:5" /><verse number="6" style="v" sid="GEN 48:6" />अने तीमनी बाद तारा जे बी सोरा पयदा हये, तीहया तारा ते ठेरहे; पण वाटो पाड़वा नी टेम तीहया आह़फाम ना भायुम ना घोराणा मे गीणायहे। <verse eid="GEN 48:6" /><verse number="7" style="v" sid="GEN 48:7" />जत्‌यार में पद्‌दान सी आव्‌वा बाज र्‌यो हतो, तत्‌यार एप्‌राता पुगवा सी थोड़ुक नाम्‌बे हतु ने पेले राहेल कनान देस मे, वाट्‌ये, मार अगळ मर जी; अने मे तीने तांत, एप्‌राता जे बेतलहम बी केवाये, तीहयीत वाट्‌ये मे गाड़ देदो।” <note caller="+" style="x"><char style="xo" closed="false">48:7 </char><char style="xt" closed="false"><ref loc="GEN 35:16-19">उबजणाय कीताप 35:16-19</ref></char></note><verse eid="GEN 48:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="GEN 48:8" />तत्‌यार याकुब ने युसुफ ना सोरा देखाव पड़्‌या, अने तीहयो पुछ्‌यो, “आहया कोयना सोरा से?”<verse eid="GEN 48:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="GEN 48:9" />युसुफ आह़फा ना बाह सी केदो, “आहया मारा सोरा से, जे भगवान मने आञे आपलो से।” तीहयो केदो, “हीमने मारी पांह ली आवो के मे तीमने बरकत आपु।” <verse eid="GEN 48:9" /><verse number="10" style="v" sid="GEN 48:10" />याकुब ना डोळा डायावारा ना कारण धुंदळा हय जेला हता, आञे लग के तीने कम देखातु हतु। तत्‌यार युसुफ तीमने तीनी पांह ली ज्‌यो; अने याकुब तीमने गोळो दीन गळे लगाड़ लेदो। <verse eid="GEN 48:10" /><verse number="11" style="v" sid="GEN 48:11" />तत्‌यार याकुब युसुफ सी केदो, “मने हेर नी हती, के मे तारु मुख अळी देखही: पण देख, भगवान मने तारी अवल्‌यात बी देखाड़लो से।” <verse eid="GEN 48:11" /><verse number="12" style="v" sid="GEN 48:12" />तत्‌यार युसुफ तीमने आह़फा बाह ना मांडा ना वचे गेथो छेटा करीन आह़फो ढुंगो वळीन वांद्‌यो।<verse eid="GEN 48:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="GEN 48:13" />तत्‌यार युसुफ तीहया बेम ने लीन, एप्‌रेम ने आह़फा ना जमणा हात सी, के तीहयो याकुब ना डाखर्‌या हात भणी पड़े, अने मनस्‌से ने आह़फा ना डाखर्‌या हात सी, के याकुब ना जमणी हात भणी पड़े, तीमने तीनी पांह ली ज्‌यो। <verse eid="GEN 48:13" /><verse number="14" style="v" sid="GEN 48:14" />तत्‌यार याकुब आह़फा नो जमण्‌यो हात अगो करीन एप्‌रेम ना मुंडा पोर जे नानलो हतो, अने आह़फा नो डाखर्‌यो हात अगो करीन मनस्‌से ना मुंडा पोर मेक्‌यो; तीहयो ते जाण बुजीन आसम कर्‌यो; नीता मोट्‌लो मनस्‌सेत हतो। <verse eid="GEN 48:14" /><verse number="15" style="v" sid="GEN 48:15" />बाद मे तीहयो युसुफ ने बरकत आपीन केदो, “भगवान जीनी अगळ मारा आड़ा-बुड़ा अब्‌राहम अने ईसाक चालता हता तीहयोत भगवान मारी पयदावारी सी लीन आज ना दाड़े लग मारो गुवाळ्‌यो बणीन र्‌यो। <verse eid="GEN 48:15" /><verse number="16" style="v" sid="GEN 48:16" />के तीहयोत दुत मने आखी बुराय सी छोड़ावतो आय र्‌यो, तीहयीत हाव आहया सोरा ने बरकत आपे; अने आहया मारा अने मारा आड़ा-बुड़ा अब्‌राहम अने ईसाक ना केवाये; अने धरती पोर जादा सी जादा वदे।”<verse eid="GEN 48:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="GEN 48:17" />जत्‌यार युसुफ देख्‌यो के मारो बाह आह़फा नो जमण्‌यो हात एप्‌रेम ना मुंडा पोर मेकलो से, तत्‌यार आहयी वात तीने बुरी लागी; एतरे तीहयो आह़फा ना बाह नो हात आहया वीच्‌यार सी धर लेदो, के एप्‌रेम ना मुंडा पोर सी चुटीन मनस्‌से ना मुंडा पोर मेल देय। <verse eid="GEN 48:17" /><verse number="18" style="v" sid="GEN 48:18" />अने युसुफ आह़फा ना बाह सी केदो, “ए बाह, आसम नी; काहाके मोट्लो आहयोत से; आह़फा नो जमण्‌यो हात आना मुंडा पोर मेक।”<verse eid="GEN 48:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 48:19" />तीनो बाह केदो, “नी, ह़मळ, ए मारा सोरा, मे आहयी वात ने वारुत जाणु आनी सी बी माणहुम नी एक पीड़ी पयदा हयहे, अने आहयो बी मोटो हय जहे, ता बी आनो नान्‌लो भाय आनी सी जादा मोटो हय जहे, अने आनी अवल्‌यात सी ढेरेत राज्‌य नीकळहे।”<verse eid="GEN 48:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="GEN 48:20" />अळतेण तीहयो ते दाड़े आहयु कीन तीमने बरकत आप्‌यो, “ईस्‌रायली माणहु तारु नाम ली लीन आसम बरकत आप्‌या करहे, ‘भगवान तने एप्‌रेम अने मनस्‌से नी तेम बणाय देय,’” अने तीहयो मनस्‌से सी पेले एप्‌रेम नु नाम लेदो।<verse eid="GEN 48:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="GEN 48:21" />तत्‌यार याकुब युसुफ सी केदो, “देख, मे ते मरवा पोर से पण भगवान तमारी ह़ाते रेहे, अने तमने तमारा आड़ा-बुड़ा ना देस मे पाछो पुगाड़ देहे। <verse eid="GEN 48:21" /><verse number="22" style="v" sid="GEN 48:22" />अळी मे तमने तारा भायुम गेथो जादा जागा नो वाटो आपु, जीने मे एमोरीम ना हात मे गेथो मारी तलवार अने धंदली नी ताखत सी ली लेदलो से।”<verse eid="GEN 48:22" /></para>
  <chapter eid="GEN 48" />
  <chapter number="49" style="c" sid="GEN 49" />
  <para style="s">याकुब ना आखरी बोलु</para>
  <para style="p">
    <verse number="1" style="v" sid="GEN 49:1" />तत्‌यार याकुब आह़फा ना सोराम ने बोलावीन तीमने केदो, एकठा हय जावो, मे तमने देखाड़ही के आखरी दाड़ा मे तमारी पोर ह़ु-ह़ु हयहे:<verse eid="GEN 49:1" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="2" style="v" sid="GEN 49:2" />ए याकुब ना सोरा एकठा हय्‌न ह़मळो,</para>
  <para style="q2" vid="GEN 49:2">तमारा बाह याकुब<note caller="+" style="f"><char style="fr" closed="false">49:2 </char><char style="fq" closed="false">याकुब </char><char style="ft" closed="false">जीनु नाम ईस्‌रायल हतु</char></note> भणी कांटा लगाड़ो।<verse eid="GEN 49:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="GEN 49:3" />ए रुबेन, तु मारो मोट्लो सोरो,</para>
  <para style="q2" vid="GEN 49:3">मारी ताखत अने माणेह हयवा ना नाते पेलो फोळ से;</para>
  <para style="q1" vid="GEN 49:3">तु मोटाय नो धनी,</para>
  <para style="q2" vid="GEN 49:3">अने सक्‌ती नो बी वारु वाटो से।<verse eid="GEN 49:3" /></para>
  <para style="q1">
    <verse number="4" style="v" sid="GEN 49:4" />तु जे पाणीन तेम उकळवा वाळो से,</para>
  <para style="q2" vid="GEN 49:4">एतरे बीजा सी वारु नी रेही;</para>
  <para style="q1" vid="GEN 49:4">काहाके तु मारी पावर्‌याण लाडी ह़ाते ह़ुयो,</para>
  <para style="q2" vid="GEN 49:4">तत्‌यार तु तीने वीटाळ देदो;</para>
  <para style="q2" vid="GEN 49:4">तीहयो मारा आथरणा पोर चड़्‌यो।<verse eid="GEN 49:4" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="5" style="v" sid="GEN 49:5" />सीमोन अने लेवी ते भाय-भाय से,</para>
  <para style="q2" vid="GEN 49:5">तीमनी तलवार मारवा वाळी हत्‌यार से।<verse eid="GEN 49:5" /></para>
  <para style="q1">
    <verse number="6" style="v" sid="GEN 49:6" />ए मारा जीव, तीमना पल्‌ला मे ना पड़,</para>
  <para style="q2" vid="GEN 49:6">ए मारी बड़ाय, हीमनी बठक मे ना जाय;</para>
  <para style="q1" vid="GEN 49:6">काहाके रीह सी माणेह ने मार नाख्‌या,</para>
  <para style="q2" vid="GEN 49:6">अने आह़फीत मरजी पोर चालीन,</para>
  <para style="q2" vid="GEN 49:6">बोळद्‌याम ने लंगड़ो बणाया।<verse eid="GEN 49:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="GEN 49:7" />गरा तीमनी रीह ने, जे घणी मोटी हती;</para>
  <para style="q2" vid="GEN 49:7">अने तीमनी रीह ने, जे वण-दयाळ्‌ळो हतो;</para>
  <para style="q1" vid="GEN 49:7">मे तीमने याकुब सी अलग-अलग,</para>
  <para style="q2" vid="GEN 49:7">अने ईस्‌रायल मे तीतर-बीतर कर देही।<verse eid="GEN 49:7" /></para>
  <para style="q1">
    <verse number="8" style="v" sid="GEN 49:8" />ए यहुदा तारा भाय तने वारु से केहे,</para>
  <para style="q2" vid="GEN 49:8">तारो हात मारा वेरी नी बोची पोर पड़हे;</para>
  <para style="q2" vid="GEN 49:8">तारा बाह ना सोरा तने वांदहे।<verse eid="GEN 49:8" /></para>
  <para style="q1">
    <verse number="9" style="v" sid="GEN 49:9" />यहुदा नाहर ना बच्‌चा से। ए मारा सोरा,</para>
  <para style="q2" vid="GEN 49:9">तु सीकार करीन दोर मे जेलो से,</para>
  <para style="q1" vid="GEN 49:9">तीहयो नाहार नीता नाहार ने तेम ह़ताय्‌न बह ज्‌यो;</para>
  <para style="q2" vid="GEN 49:9">बाद मे कोय हीने टुचलीन उठाड़ सकत्‌लो।<note caller="+" style="x"><char style="xo" closed="false">49:9 </char><char style="xt" closed="false"><ref loc="REV 5:5">परकासीतवाक्‌य 5:5</ref>; <ref loc="NUM 24:9">गीनती 24:9</ref></char></note><verse eid="GEN 49:9" /></para>
  <para style="q1">
    <verse number="10" style="v" sid="GEN 49:10" />जत्‌यार लग सीलो नी आवे,</para>
  <para style="q2" vid="GEN 49:10">तत्‌यार लग नी ते यहुदा सी राजगादी छुटे,</para>
  <para style="q1" vid="GEN 49:10">नी ते तीनी अवल्‌यात सी कायदो आपवा वाळो अलग हयहे;</para>
  <para style="q2" vid="GEN 49:10">अने राज्‌य-राज्‌य ना माणहु तीना हक मे हय जहे।<verse eid="GEN 49:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="GEN 49:11" />तीहयो आह़फा ना जवान गदड़ा ने अंगुर ना वेला मे,</para>
  <para style="q2" vid="GEN 49:11">अने आह़फी गदड़ी ना बच्‌चा ने,</para>
  <para style="q1" vid="GEN 49:11">वारली जाती ना अंगुर ना फोळ मे बांद्‌या करहे;</para>
  <para style="q2" vid="GEN 49:11">तीहयो आह़फा ना लुगड़ा अंगुर ना रोह<note caller="+" style="f"><char style="fr" closed="false">49:11 </char><char style="fq" closed="false">अंगुर ना रोह </char><char style="ft" closed="false">लोय</char></note> मे,</para>
  <para style="q2" vid="GEN 49:11">अने आह़फी पागड़ी अंगुर ना रोह मे धोया करहे।<verse eid="GEN 49:11" /></para>
  <para style="q1">
    <verse number="12" style="v" sid="GEN 49:12" />तीना डोळा अंगुर ना रोह ने तेम राता,</para>
  <para style="q2" vid="GEN 49:12">अने तीना दात दुद सी धोळा रेहे।<verse eid="GEN 49:12" /></para>
  <para style="q1">
    <verse number="13" style="v" sid="GEN 49:13" />जबुलुन दर्‌या धेड़े रीया करहे,</para>
  <para style="q2" vid="GEN 49:13">तीहयो ढुंड्‌या नी लेदे रेवा नो जागो बणहे,</para>
  <para style="q2" vid="GEN 49:13">अने तीनी काकड़ सीदोन देस लग पुगहे।<verse eid="GEN 49:13" /></para>
  <para style="q1">
    <verse number="14" style="v" sid="GEN 49:14" />ईस्‌साकार एक मोट्लो अने ताखत वाळो गदड़ो से,</para>
  <para style="q2" vid="GEN 49:14">जे जानवरु ना वाड़ा मे ह़ताय्‌न रेय।<verse eid="GEN 49:14" /></para>
  <para style="q1">
    <verse number="15" style="v" sid="GEN 49:15" />तीहयो एक अराम नो जागो देखीन,</para>
  <para style="q2" vid="GEN 49:15">के वारु से, अने देस वारु से,</para>
  <para style="q1" vid="GEN 49:15">आह़फा ना खबा ने भार उचलवा नी लेदे हेटो कर्‌यो,</para>
  <para style="q2" vid="GEN 49:15">अने पावर नु काम करवा गुलाम बण ज्‌यो।<verse eid="GEN 49:15" /></para>
  <para style="q1">
    <verse number="16" style="v" sid="GEN 49:16" />दान ईस्‌रायल नो एक कुळ हय्‌न</para>
  <para style="q2" vid="GEN 49:16">आह़फा ना जाती भायुम नो नीयाव करहे।<verse eid="GEN 49:16" /></para>
  <para style="q1">
    <verse number="17" style="v" sid="GEN 49:17" />दान वाट्‌ये नो एक गड़हो,</para>
  <para style="q2" vid="GEN 49:17">अने ह़ड़क मे नो एक फेण वाळो गड़हो हयहे,</para>
  <para style="q1" vid="GEN 49:17">जे घोड़ा ना पोगु ने चाय देय,</para>
  <para style="q2" vid="GEN 49:17">जीनी सी तीनी पोर बहण्‌यो पासली ह़ोड़ पड़ जाय।<verse eid="GEN 49:17" /></para>
  <para style="q1">
    <verse number="18" style="v" sid="GEN 49:18" />ए यहोवा, मे तारी सी छुटकारो हात करवा करीन</para>
  <para style="q2" vid="GEN 49:18">वाट जोवतो आय र्‌यो।<verse eid="GEN 49:18" /></para>
  <para style="q1">
    <verse number="19" style="v" sid="GEN 49:19" />गाद पोर एक टोळो हमलो करहे;</para>
  <para style="q2" vid="GEN 49:19">पण तीहयो तीहया टोळा पोर पछळ गेथो हमलो करहे।<verse eid="GEN 49:19" /></para>
  <para style="q1">
    <verse number="20" style="v" sid="GEN 49:20" />“आसेर सी जे अन पाकहे तीहयु वारु हयहे,</para>
  <para style="q2" vid="GEN 49:20">अने तीहयो राजान तेम ह़वादु खाणु खवाड़्‌या करहे।<verse eid="GEN 49:20" /></para>
  <para style="q1">
    <verse number="21" style="v" sid="GEN 49:21" />नप्‌ताली एक सुटली हयणी से;</para>
  <para style="q2" vid="GEN 49:21">तीहयो घटाळी वात केय।<verse eid="GEN 49:21" /></para>
  <para style="q1">
    <verse number="22" style="v" sid="GEN 49:22" />युसुफ फालवा वाळी डाळ से,</para>
  <para style="q2" vid="GEN 49:22">तीहयो झोर ने तां लागली फोळ वाळी एक डाळ से;</para>
  <para style="q2" vid="GEN 49:22">तीनी डाळ्‌या भीतड़ा पोर चड़ीन फेल जाय।<verse eid="GEN 49:22" /></para>
  <para style="q1">
    <verse number="23" style="v" sid="GEN 49:23" />धंदली वाळा माणहु तीनी ह़ाते घणा झुमाया,</para>
  <para style="q2" vid="GEN 49:23">अने तीना पोर बीलखा देदा,</para>
  <para style="q2" vid="GEN 49:23">अने तीनी पछळ पड़ला से।<verse eid="GEN 49:23" /></para>
  <para style="q1">
    <verse number="24" style="v" sid="GEN 49:24" />पण तीनी धंदली वातड़ी री,</para>
  <para style="q2" vid="GEN 49:24">अने तीना खबा अने हात याकुब ना</para>
  <para style="q1" vid="GEN 49:24">तीहया जोरभर्‌या भगवान ना हात ना लारे उतवाळ्‌या हया,</para>
  <para style="q2" vid="GEN 49:24">जीनी पांह सी तीहयो गुवाळ्‌यो आवहे,</para>
  <para style="q2" vid="GEN 49:24">जे ईस्‌रायली माणहु जुगु चाफर्‌यो ठेरहे।<verse eid="GEN 49:24" /></para>
  <para style="q1">
    <verse number="25" style="v" sid="GEN 49:25" />आहयु तारा बाह ना तीहया भगवान नु काम से,</para>
  <para style="q2" vid="GEN 49:25">जे तारी मदत करहे, आखा मे जोर-भर्‌या भगवान नी लारे,</para>
  <para style="q1" vid="GEN 49:25">जे तने उपर सी ह़रग नी बरकत,</para>
  <para style="q2" vid="GEN 49:25">अने हेटो मोट्‌ला दर्‌या नी बरकत,</para>
  <para style="q2" vid="GEN 49:25">अने धायुम अने गरब नी बरकत आपहे।<verse eid="GEN 49:25" /></para>
  <para style="q1">
    <verse number="26" style="v" sid="GEN 49:26" />तारा बाह नी बरकत मारा आड़ा-बुड़ा नी बरकत सी</para>
  <para style="q2" vid="GEN 49:26">जादा बड़ जेली से</para>
  <para style="q1" vid="GEN 49:26">अने पेल्‌ना वारा ना बड़ाम नी चीजु नी तेम बणीन रेहे</para>
  <para style="q2" vid="GEN 49:26">तीहया युसुफ ना मुंडा पोर,</para>
  <para style="q1" vid="GEN 49:26">जे आह़फा भायुम सी अलग करला हता,</para>
  <para style="q2" vid="GEN 49:26">तीनात मुंडा नी पागड़ी पोर फुलहे-फालहे।<verse eid="GEN 49:26" /></para>
  <para style="b" />
  <para style="q1">
    <verse number="27" style="v" sid="GEN 49:27" />“बीन्‌यामीन फाड़वा वाळो लेंड्‌यो से,</para>
  <para style="q2" vid="GEN 49:27">ह़वारे ते तीहयो सीकार ने फाड़हे,</para>
  <para style="q2" vid="GEN 49:27">अने ह़ांती वेळा लुट नो माल वाट लेहे।”<verse eid="GEN 49:27" /></para>
  <para style="b" />
  <para style="p">
    <verse number="28" style="v" sid="GEN 49:28" />ईस्‌रायल ना बारा कुळ आहयात से अने ईमनो बाह जे-जे बोली सी तीमने बरकत आप्‌यो, तीहया आहयात से; एक-एक ने तीमना बरकत नी अनसारे बरकत आप्‌यो।<verse eid="GEN 49:28" /></para>
  <para style="s">याकुब नी मोत अने वगे करनु</para>
  <para style="p">
    <verse number="29" style="v" sid="GEN 49:29" />तत्‌यार तीहयो तीमने आहयु कीन हुकम आप्‌यो, “मे आपणा आड़ा-बुड़ा मे जाय्‌न भेस्‌कायवा वाळो से: एतरे मने हीत्‌ती एप्‌रोन नी जागा वाळा दोर मे मारा आड़ा-बुड़ा नी ह़ाते गाड़ देजो, <verse eid="GEN 49:29" /><verse number="30" style="v" sid="GEN 49:30" />मने तीहया दोर मे जे कनान देस मे मम्‌रे नी अगळ वाळी मकपेला नी जागा मे से; तीहयी जागा ने अब्‌राहम हीत्‌ती एप्‌रोन ना हात सी आनीन करे वेचाती लेदो हतो, के तीहयो मड़ाट्‌या जुगु तीनी आह़फी जागा हये।<note caller="+" style="x"><char style="xo" closed="false">49:30 </char><char style="xt" closed="false"><ref loc="ACT 23:3-20">नेवताळा ना काम 23:3-20</ref></char></note> <verse eid="GEN 49:30" /><verse number="31" style="v" sid="GEN 49:31" />तां अब्‌राहम अने तीनी लाडी सारा ने गाड़ला हता; अने तांत ईसाक अने तीनी लाडी रीबका ने बी गाड़ला हता; अने तांत मे लीवा ने बी गाड़लो।<note caller="+" style="x"><char style="xo" closed="false">49:31 </char><char style="xt" closed="false"><ref loc="GEN 35:29">उबजणाय कीताप 35:29</ref></char></note> <verse eid="GEN 49:31" /><verse number="32" style="v" sid="GEN 49:32" />तीहयी जागा अने तीनो मोट्लो दोर हीत्‌तीम नी हात सी वेचाती लेदली।” <verse eid="GEN 49:32" /><verse number="33" style="v" sid="GEN 49:33" />याकुब जत्‌यार आह़फा ना सोराम ने आहयु हुकम आप देदलो हतो, तत्‌यार आह़फा पोग खाटली पोर करीन जीव छोड़ देदो, अने आह़फा ना आड़ा-बुड़ा मे जाय्‌न भेसकाय ज्‌यो।<note caller="+" style="x"><char style="xo" closed="false">49:33 </char><char style="xt" closed="false"><ref loc="ACT 7:15">नेवताळा ना काम 7:15</ref></char></note><verse eid="GEN 49:33" /></para>
  <chapter eid="GEN 49" />
  <chapter number="50" style="c" sid="GEN 50" />
  <para style="p">
    <verse number="1" style="v" sid="GEN 50:1" />तत्‌यार युसुफ आह़फा ना बाह ना मोडा पोर पड़ीन रड़्‌यो अने तीना बाह ने गोळो देदा। <verse eid="GEN 50:1" /><verse number="2" style="v" sid="GEN 50:2" />अने युसुफ तीहया दाक्‌तर्‌या ने, जे तीना चाकर्‌या हता, हुकम आप्‌यो के तीना बाह ना धोड़ पोर गंदायण्‌यु तेल लगाड़े; तत्‌यार दाकतर्‌या याकुब ना धोड़ पोर गंदायण्‌यु तेल लगाड़ देदा। <verse eid="GEN 50:2" /><verse number="3" style="v" sid="GEN 50:3" />अने तीना चाळीह दाड़ा पुरा हया, काहाके जीना धोड़ पोर गंदायण्‌यु तेल लगाड़े तीमने एतरा दाड़ा पुरात लागे; अने मीस्‌र ना माणहु तीनी जुगु सत्‌तर दाड़ा लग दुखी हयता र्‌या।<verse eid="GEN 50:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="GEN 50:4" />जत्‌यार तीना दुख ना दाड़ा वीत ज्‌या, तत्‌यार युसुफ फीरोन राजा ना घोराणा ना माणहु सी केवा बाज ज्‌यो, “कदी तमारी दया नी नींगा मारी पोर हय ता मारी आहयी खबर फीरोन राजा ने ह़मळावो, <verse eid="GEN 50:4" /><verse number="5" style="v" sid="GEN 50:5" />मारो बाह आहयु कीन, ‘देख मे मरवा पोर से, मने आहयी ह़ाम खवाड़्‌या, जे मड़ाट्‌यु में मारी लेदे कनान देस मे खोदाड़लो से तीनी मे तु मने गाड़ देजे। एतरे हाव मने तां जाय्‌न आह़फा बाह ने गाड़वा नु हुकम आप, अळतेण मे पाछो आवती रेही।’”<note caller="+" style="x"><char style="xo" closed="false">50:5 </char><char style="xt" closed="false"><ref loc="GEN 47:29-31">उबजणाय कीताप 47:29-31</ref></char></note><verse eid="GEN 50:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="GEN 50:6" />तत्‌यार फीरोन राजा केदो, “जाय्‌न आह़फा नी बाह नी खवाड़ली ह़ाम नी अनसारे तीने गाड़ दे।”<verse eid="GEN 50:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="GEN 50:7" />एतरे युसुफ आह़फा ना बाह ने गाड़वा करीन चाल्‌यो, अने फीरोन ना आखा काम करवा वाळा, तीना घोर ना मुख्‌या, अने मीस्‌र देस ना आखा मुख्‌या तीनी ह़ाते चाल्‌या। <verse eid="GEN 50:7" /><verse number="8" style="v" sid="GEN 50:8" />अने युसुफ ना घोर ना आखा माणहु, अने तीना भाय, अने तीना बाह ना घोर ना आखा माणहु बी ह़ाते ज्‌या; पण तीहया आह़फा सोरा सोरीम, अने गाडरा अने बोकड़्‌या, अने गाय अने बोळद्‌याम ने गोसेन मे छोड़ ज्‌या। <verse eid="GEN 50:8" /><verse number="9" style="v" sid="GEN 50:9" />अने तीनी ह़ाते घोड़ागाडी अने घोड़ा पोर बहण्‌या बी ज्‌या, आहयी रीते टोळो ढेरेत मोटो हय ज्‌यो।<verse eid="GEN 50:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="GEN 50:10" />जत्‌यार तीहया यरदन नंदी नी धेड़े आताद नाम ना जागा ना खळान्‌तां पुग्‌या, तत्‌यार तां तीहया घणात रड़ीन दुखी हया, अने युसुफ आह़फा ना बाह जुगु ह़ात दाड़ा लग दुखी र्‌यो। <verse eid="GEN 50:10" /><verse number="11" style="v" sid="GEN 50:11" />हाव तीहया ह़ेर मे रेवा वाळा कनानी माणहु आताद ना खळा मे माणहुम ने दुखी हयत्‌ला देख्‌यो तत्‌यार केदो, “आहयो ते मीस्‌र मे रेवा वाळाम नो भारी दुख से।” आहया कारण तीहया जागा नु नाम आबेल मीस्‌रेम<note caller="+" style="f"><char style="fr" closed="false">50:11 </char><char style="fq" closed="false">आबेल मीस्‌रेम </char><char style="ft" closed="false">मीस्‌री माणहु नो दुख</char></note> पड़्‌यु अने तीहयु यरदन नंदी नी ह़ेली पार से।<verse eid="GEN 50:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="GEN 50:12" />जीसम याकुब तीमने हुकम आपलो हतो, तेमेत तीना सोरा कर्‌या। <verse eid="GEN 50:12" /><verse number="13" style="v" sid="GEN 50:13" />तीमना सोरा तीना धोड़ ने कनान देस मे लाया अने तीने मम्‌रे नी उगवणी भणी मकपेला नी जागा मे से तीहया दोर मे गाड़्‌या जीने आह़फा नु मड़ाट्‌यु बणाव्‌वा करीन अब्‌राहम हीत्‌ती जातीन एप्‌रोन सी जागा भेळ वेचाती लेदो हतो।<note caller="+" style="x"><char style="xo" closed="false">50:13 </char><char style="xt" closed="false"><ref loc="ACT 7:16">नेवताळा ना काम 7:16</ref> </char></note> <verse eid="GEN 50:13" /><verse number="14" style="v" sid="GEN 50:14" />युसुफ आह़फा बाह ने गाड़वा नी बाद आह़फा भायुम अने तीहया आखाम नी ह़ाते जे मीस्‌र देस गेथा तीना बाह ने गाड़वा आवला हता तीमनी ह़ाते पाछो आवती र्‌यो।<verse eid="GEN 50:14" /></para>
  <para style="s">युसुफ नु आह़फा भायुम ने दीलासो आपवा</para>
  <para style="p">
    <verse number="15" style="v" sid="GEN 50:15" />जत्‌यार युसुफ ना भाय देख्‌या के अमारो बाह मर जेलो से, तत्‌यार केवा बाज ज्‌या, “मालम पड़े युसुफ हाव अमारी सी वेर करे, अने जेतरी बुराय आमु हीनी सी करला हता, तीहयी आखी बुराय नो बदलो लेहे।” <verse eid="GEN 50:15" /><verse number="16" style="v" sid="GEN 50:16" />एतरे तीहया युसुफ ने तां आहयु केवाड़ मोकल्‌या, “तारो बाह मरवा सी पेले आमने आहयो हुकम आपलो हतो <verse eid="GEN 50:16" /><verse number="17" style="v" sid="GEN 50:17" />तमु युसुफ सी केजो के तीहयो दया करीन आह़फा भायुम ना गुना अने पाप माफ करे; काहाके आमु तारी सी बुराय करला हता, पण हाव आह़फा बाह ना भगवान ना पावर्‌याम ना गुना माफ कर।” तीमनी आहयी वात ह़मळीन युसुफ रड़ पड़्‌यो।<verse eid="GEN 50:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="GEN 50:18" />अने तीना भाय बी जाय्‌न तीनी अगळ पड़ीन केदा, “देख, आमु तारा पावर्‌या से।”<verse eid="GEN 50:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="GEN 50:19" />युसुफ तीमने केदो, “ना बीहो, ह़ु मे भगवान ना जागा पोर से? <verse eid="GEN 50:19" /><verse number="20" style="v" sid="GEN 50:20" />तमु मारी लेदे बुराय नो वीच्‌यार करला हता; पण भगवान तीहयी वात नी लेदे भलाय नो वीच्‌यार करलो से, के तीना माणहु जीवत्‌ला बचे, जीसम के तीहया आज बी जीवत्‌ला से। <verse eid="GEN 50:20" /><verse number="21" style="v" sid="GEN 50:21" />एतरे हाव ना बीहो: मे तमारो अने तमारी सोरा सोरी नो पाळण-पोसण करतो रेही।” आहयी रीते तीहयो तीमने ह़मजाड़ीन सांती आप्‌यो।<verse eid="GEN 50:21" /></para>
  <para style="s">युसुफ नी मोत</para>
  <para style="p">
    <verse number="22" style="v" sid="GEN 50:22" />युसुफ आह़फाम ना बाह ना घोरवाळा नी भेळ मीस्‌र देस मे र्‌यो, अने युसुफ एक ह़ोव दह वरहु जीवत्‌लो र्‌यो। <verse eid="GEN 50:22" /><verse number="23" style="v" sid="GEN 50:23" />अने युसुफ एप्‌रेम ना सोरा ना सोरा ने बी देख्‌यो अने मनस्‌से ना सोरा ना सोरा ने, जे माकीर ना सोरा हता, तीहया पयदा हया अने युसुफ तीमने खोळा मे लेदो। <verse eid="GEN 50:23" /><verse number="24" style="v" sid="GEN 50:24" />युसुफ आह़फा भायुम ने केदो, “मे ते मरवा पोर से; पण भगवान तमारी खबर लेहे, अने तमने आहया देस सी नीकाळीन तीहया देस मे ली जहे, जीनी ह़ाम तीहयो अब्‌राहम, ईसाक, अने याकुब नी ह़ाते खादलो हतो।” <verse eid="GEN 50:24" /><verse number="25" style="v" sid="GEN 50:25" />अळतेण युसुफ ईस्‌रायली माणहुम सी आहयु केदो के भगवान पक्‌को तमारी खबर लेहे, “तीमने आहया वारा मे ह़ाम खवाड़्‌यो के आमु तारा हाटका ने आञे गेथा ह़ेला देस मे ली जाय।”<note caller="+" style="x"><char style="xo" closed="false">50:25 </char><char style="xt" closed="false"><ref loc="HEB 11:22">ईब्‌रानीयो 11:22</ref>; <ref loc="JOS 24:32">यहोसु 24:32</ref></char></note> <verse eid="GEN 50:25" /><verse number="26" style="v" sid="GEN 50:26" />आहयी रीते युसुफ एक ह़ोव दह साल नो हय्‌न मर ज्‌यो: अने तीना धोड़ पोर गंदायण्‌यु तेल लगाड़्‌या, अने तीहया धोड़ ने मीस्‌र मे एक धोड़ नी पेटी मे मेक देदा।<verse eid="GEN 50:26" /></para>
  <chapter eid="GEN 50" />
</usx>