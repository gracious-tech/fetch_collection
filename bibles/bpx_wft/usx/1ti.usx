<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="1TI" style="id">- Paliya</book>
  <para style="h">1 तीमुथीयुस</para>
  <para style="toc3">1 तीमुथीयुस</para>
  <para style="toc2">1 तीमुथीयुस</para>
  <para style="toc1">तीमुथीयुस ना नाम पोलुस नी पेली चीट्‌ठी</para>
  <para style="mt2">तीमुथियुस के नाम पोलुस की पहली पत्री</para>
  <para style="mt1">तीमुथीयुस ना नाम पोलुस नी पेली चीट्‌ठी</para>
  <para style="imt">जानकारी</para>
  <para style="ip">पेली तीमुथीयुस नी कीताप आहयी एक चीट्‌ठी से जे नेवताळो पोलुस तीना चेला तीमुथीयुस ने लीखलो से, तीमुथीयुस आहयी चीट्‌ठी मसी ना पयदा हयवान अळतेण 62-64 साल नी आड़े-धेड़े लीखलो से, आहयी तीहयी टेम हती जत्‌यार पोलुस नी मरवा नी टेम ह़ाते आय री हती, पोलुस अने तीमुथीयुस नी वच मे घण-जबर ह़गाय हती अने तीमुथीयुस ने वळ-वळीन सोरा ना रुप मे मोकल्‌यो। <char style="xt"><ref loc="PHP 2:22">फीलीपीयो 2:22</ref></char> <char style="xt"><ref loc="1TI 1:2">1 तीमुथीयुस 1:2</ref></char> <char style="xt"><ref loc="1TI 1:18">1:18</ref> </char>।</para>
  <para style="ip">आहयी तीहया च्‌यार चीट्‌ठी माय्‌न एक से, जे एक माणेह ने सोड़ीन एक मंडळी ने लीख्‌यो, तीहयी च्‌यार कीताप माय्‌न बीजी तीन कीताप आहयी से, 2 तीमुथीयुस, तीतुस, अने फीलेमोन। 1 तीमुथीयुस नी चीट्‌ठी मे मंडळी नी भक्‌ती <char style="xt"><ref loc="1TI 2:1-15">2:1-15</ref></char> मंडळी ना पुडारी ना गुण <char style="xt"><ref loc="1TI 3:1-13">3:1-13</ref></char> अने झुटा मास्‌तार्‌या ना वीरोद मे चेतावणी <char style="xt"><ref loc="1TI 1:3-11">1:3-11</ref></char> <char style="xt"><ref loc="1TI 4:1-5">4:1-5</ref></char> <char style="xt"><ref loc="1TI 6:2-5">6:2-5</ref></char> आहयु देखाड़े के कीसम पोलुस तीमुथीयुस ने डायलो बणाव्‌वा ह़ीकापण आपतो हतो। 1 तीमुथीयुस मे कंय पाट से जे अमारी जागे वाळी मंडळी ने मदत कर सके।</para>
  <para style="iot">रुपरेखा</para>
  <para style="io1">1. पोलुस तीमुथीयुस ने वारलो से के केय। <char style="ior"><ref loc="1TI 1:1-2">1:1-2</ref></char></para>
  <para style="io1">2. पोलुस तीमुथीयुस ने झुटा ह़ीकाड़न्‌या ना बारा मे चेतावणी आपे <char style="ior"><ref loc="1TI 1:3-11">1:3-11</ref></char></para>
  <para style="io1">3. पोलुस ईसु मसी नी जुगु केतरो घणो वारु केण्‌यो से। <char style="ior"><ref loc="1TI 1:12-19">1:12-19</ref> </char></para>
  <para style="io1">4. अळतेण तीहयो तीमुथीयुस ने पुजा अने मंडळी ना पुडार्‌या ना बारा मे हुकम आपे। <char style="ior"><ref loc="1TI 2-3">2–3</ref> </char></para>
  <para style="io1">5. पोलुस तीमुथीयुस ने थोड़ाक आखरी हुकम आपीन आह़फा नी चीट्‌ठी पुरी करे। <char style="ior"><ref loc="1TI 4-6">4–6</ref></char></para>
  <chapter number="1" style="c" sid="1TI 1" />
  <para style="s">वारला से के केम</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 1:1" />भगवान आपणो छुटकारो अने आपणी आह मसी ईसु नो हुकम नी अनसारे ईसु मसी ना नेवताळा पोलुस भणी गेथी।<verse eid="1TI 1:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="1TI 1:2" />
    <note caller="+" style="x">
      <char style="xo" closed="false">1:2 </char>
      <char style="xt" closed="false">
        <ref loc="ACT 16:1">नेवताळा ना काम 16:1</ref>
      </char>
    </note>भरहा मे मारा खरला सोरा तीमुथीयुस ने: बाह भगवान अने आपणा मालीक ईसु मसी भणी गेथी संयबरकत, दया अने सांती जड़ती रेय।<verse eid="1TI 1:2" /></para>
  <para style="s">झुटा मास्‌तर्‌या ना वीरोद मे चेतावणी</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 1:3" />मे मकीदुनीया देस जवा नी टेमे तमारी पांह वीन्‌ती करलो के तमु ईफीसुस ह़ेर मेत री जावो अने थोड़ाक देखाड़ला माणहु ने चेतावणी आपो के तीहया झुटी ह़ीकापण नी आपे, <verse eid="1TI 1:3" /><verse number="4" style="v" sid="1TI 1:4" />तीमने आसम केजो के जुन्‌ली काहणी अने खत्‌तम नी हयवा वाळा घोराणा पोर मन ना लगाड़ो। जीनी सी झगड़ा हये, अने भगवान ना ठेरावला कामु नी अनसारे नी, पण जे भरहा पोर टेकलु से। <verse eid="1TI 1:4" /><verse number="5" style="v" sid="1TI 1:5" />हुकम नो ह़ारो आहयो से के चोखला अने वारला मन सी, अने दगो नी करवा वाळा भरहा सी मोंग पयदा हये। <verse eid="1TI 1:5" /><verse number="6" style="v" sid="1TI 1:6" />थोड़ाक से, जे मोंग ना हुकम ने सोड़ीन भटकीन रीकामी वात मे फस जेला से। <verse eid="1TI 1:6" /><verse number="7" style="v" sid="1TI 1:7" />तीहया मुसा नी लारे लीखला सास्‌तर ना कायदा ह़ीकाड़न्‌या बणवा ते हींडे, पण जे वात हीम्‌मत सी केय, तीहयी वात ने खुद बी नी ह़मजे।<verse eid="1TI 1:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 1:8" />आपणु जाणया के मुसा नी लारे लीखला सास्‌तर ना कायदा ते वारला से; पण तीहया कायदा ने वारु रीती सी ह़ीकाड़े तात वारु से। <verse eid="1TI 1:8" /><verse number="9" style="v" sid="1TI 1:9" />आमु आहयु जाणीये के कायदा धरमी माणहु जुगु नी, पण जे भगवान नी भक्‌ती नी करे, जे माणहु नु आबरु नी राखे, जे कायदा वगर जीवे, जे कुहराय अने पाप करे, अने वीटळ्‌ळा से, अने जे आय्‌ह-बाहा ने लग मार देय। <verse eid="1TI 1:9" /><verse number="10" style="v" sid="1TI 1:10" />जे छीनाळु करे, अने जे अदमी-अदमी अने बयरा-बयरा सवसार करे, जे पावर्‌या ने वेचे, अने जे झुटी ह़ाम खाय, तीहया आखा जुगु तीमना पाप ना बारा मे अने डंड ना बारा मे ह़मजाड़वा करीन आहया कायदा भगवान आपलो से। <verse eid="1TI 1:10" /><verse number="11" style="v" sid="1TI 1:11" />भगवान जे आखा मे जुगाळो से, तीहयो आह़फा नी बड़ाय वाळी खुस-खबर बीजा ने ह़मळाव्‌वा नु काम मने ह़ोपलो से।<verse eid="1TI 1:11" /></para>
  <para style="s">पोलुस पोर भगवान नी दया</para>
  <para style="p">
    <verse number="12" style="v" sid="1TI 1:12" />मे, आपणा ईसु मसी ने घणो वारु से केम। जे मने सक्‌ती आपलो से, अने मने ईमानदार ह़मजीन, आह़फा ना सेवा ना काम नी लेदे ठेरायो। <verse eid="1TI 1:12" /><verse number="13" style="v" sid="1TI 1:13" /><note caller="+" style="x"><char style="xo" closed="false">1:13 </char><char style="xt" closed="false"><ref loc="ACT 8:3">नेवताळा ना काम 8:3</ref>; <ref loc="ACT 9:4">9:4</ref>,<ref loc="ACT 9:5">5</ref></char></note>मे ते पेले तीनु वाक काडत्‌लो, अने वेला पाड़त्‌लो, अने तीमनी पोर दया बी नी करत्‌लो, पेले मे ईसु मसी पोर भरहो नी करत्‌लो, अने तीहयी टेमे मने मालम नी हतु, के मे ह़ु करवा बाज र्‌यो, करीन तीहयो मारी पोर गीण कर्‌यो। <verse eid="1TI 1:13" /><verse number="14" style="v" sid="1TI 1:14" />अने मालीक नी दया घण-जबर जड़ी, अने तीहयो भरहो अने मोंग बी जड़्‌यो जे मसी ईसु मे से। <verse eid="1TI 1:14" /><verse number="15" style="v" sid="1TI 1:15" />आहयी वात ह़ाची अने आखी भाते भरहो करे एवी से, के मसी ईसु पापी माणहु ने पाप मे गेथो बचाड़वा करीन, आहयी कळी मे आवलो से। अने आखा गेथो जादा पाप करवा वाळो मेत से। <verse eid="1TI 1:15" /><verse number="16" style="v" sid="1TI 1:16" />मारी पोर आनीन करते दया हयी के मे आखा गेथा मोटा पापी मे ईसु मसी पुरी दया देखाड़्‌यो, के जे माणहु तीनी पोर अमरकाय जीवाय हात करवा जुगु भरहो करहे, तीमनी जुगु मे ईज्‌जत बणु। <verse eid="1TI 1:16" /><verse number="17" style="v" sid="1TI 1:17" />हाव जलमका राजा मतलब खत्‌तम नी हयवा वाळा अने वण-देख्‌या भगवान नी ईज्‌जत अने बड़ाय जलमकी हयती रेय आमीन।<verse eid="1TI 1:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="1TI 1:18" />ए मारा बेटा तीमुथीयुस, जे तारा बारा मे बोलु भगवान भणी गेथा तने केदला हता, आहया बोलु ने हत्‌यार ना रुप मे वापरीन अळी वारु लड़ाय लड़तो रे। <verse eid="1TI 1:18" /><verse number="19" style="v" sid="1TI 1:19" />भरहा अने वारला मन पोर टेकलो रे जीने नी मानवा ना कारण सी कंय जणा ना भरहा रुपी ढुंड्‌या डुब ज्‌या। <verse eid="1TI 1:19" /><verse number="20" style="v" sid="1TI 1:20" />तीमनी माय्‌न हुमीनयुस अने सीकंदर से जीमने मे भुतड़ा ने ह़ोप देदो, के तीहया ह़ीके के बीजा नो वाक काडवा सोड़ देय।<verse eid="1TI 1:20" /></para>
  <chapter eid="1TI 1" />
  <chapter number="2" style="c" sid="1TI 2" />
  <para style="s">भक्‌ती ना बारा मे ह़ला</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 2:1" />अने मे आखा सी पेले आहयी अगवाय करु, के रावण्‌या, वीन्‌ती अने आखा ने केम के आखा माणहु नी करते भगवान ने घणो वारु से केवा जोवे। <verse eid="1TI 2:1" /><verse number="2" style="v" sid="1TI 2:2" />राजा अने आखा उचा पद वाळा अदीकार्‌या ह़ाते आनीन करते के आपणु सांती अने अराम भेळ भगवान नी ईज्‌जत करता जाय्‌न चोखलापण नी जीवाय जीवया। <verse eid="1TI 2:2" /><verse number="3" style="v" sid="1TI 2:3" />आहयु वारु बी से अने आपणा छुटकारो आपवा वाळा भगवान ने खुस करे। <verse eid="1TI 2:3" /><verse number="4" style="v" sid="1TI 2:4" />तीनी आहयी मरजी से, के आखा माणहु नो छुटकारो हये; अने तीहया सच्‌चाय ने आखा भाते जाण लेय। <verse eid="1TI 2:4" /><verse number="5" style="v" sid="1TI 2:5" />काहाके भगवान एकीत से: अने भगवान अने माणहु नी वच मे बी एकीत वचा-वच से, अने आहयो मसी ईसु जे माणेह से। <verse eid="1TI 2:5" /><verse number="6" style="v" sid="1TI 2:6" />तीहयो आह़फोत आह़फा ने आखा ना छुटकारा जुगु दाम मे आह़फा ने चड़ाय देदो; अने तीनी गवाय वारु टेमे देदा। <verse eid="1TI 2:6" /><verse number="7" style="v" sid="1TI 2:7" /><note caller="+" style="x"><char style="xo" closed="false">2:7 </char><char style="xt" closed="false"><ref loc="2TI 1:11">2 तीमुथीयुस 1:11</ref></char></note>अने भगवान मने आहयी सच्‌चाय ना बारा मे, होव ईसु नी गवा देवा करीनेत ईसु नो नेवताळो अने परच्‌यार करन्‌यो; अने आड़जात्‌या माणहु ने आहयी सच्‌चाय नी अनसारे भरहो करवा ना बारा मे ह़ीकाड़न्‌यो बणावलो से।<verse eid="1TI 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 2:8" />मारी मरजी से के, मंडळी मे माणहु वीन्‌ती नी टेमे वीन्‌ती करे अने आह़फाम ना हात उचा करीन वाक काडीन नी पण मन लगाड़ीन वीन्‌ती करे। <verse eid="1TI 2:8" /><verse number="9" style="v" sid="1TI 2:9" /><note caller="+" style="x"><char style="xo" closed="false">2:9 </char><char style="xt" closed="false"><ref loc="1PE 3:3">1 पतरस 3:3</ref></char></note>मारी मरजी आहयी बी से के बयरा आपणा लुगड़ा ह़ोबे एवा पेरे। अने नीम्‌बाळा ने छुट्‌ला नी राखे अने ह़ोना, मोती, अने घणा मोगा लुगड़ा सी नी। <verse eid="1TI 2:9" /><verse number="10" style="v" sid="1TI 2:10" />पण भला कामु सी, काहाके भगवान नी भक्‌ती करवा वाळा बयरा जुगु आहयुत वारु से <verse eid="1TI 2:10" /><verse number="11" style="v" sid="1TI 2:11" />बयरा ने सांती सी अने हक मे रीन ह़मळवा अने ह़ीकवा जोवे। <verse eid="1TI 2:11" /><verse number="12" style="v" sid="1TI 2:12" />मे केम, के बयरा नी ह़ीकाड़वा जोवे, अने नी अदमड़ा पोर हक जमाड़वा जोवे, पण होगा हय रेवा जोवे। <verse eid="1TI 2:12" /><verse number="13" style="v" sid="1TI 2:13" />काहाके भगवान पेले आदम ने बणायो, अने अळतेण हवा ने बणायो। <verse eid="1TI 2:13" /><verse number="14" style="v" sid="1TI 2:14" />अने आदम नी ठगायो, पण बयर हवा ठगाय जी अने गुनाळ्‌ळी हयी, अने भगवान ना कायदा ने तोड़ी। <verse eid="1TI 2:14" /><verse number="15" style="v" sid="1TI 2:15" />ते बी बयर सोरा पयदा करवा नी लारे छुटकारो हात करहे, कदीम तीहयी गम सी भरहा, मोंग, अने चोखलापणा मे टेकली रेय।<verse eid="1TI 2:15" /></para>
  <chapter eid="1TI 2" />
  <chapter number="3" style="c" sid="1TI 3" />
  <para style="s">ईसु मसी ना पुडार्‌या ना गुण</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 3:1" />आहयी वात ते ह़ाचली से, के जे पुडार्‌या बणवा हींडे, तीहयो भला काम नी हेर करे। <verse eid="1TI 3:1" /><verse number="2" style="v" sid="1TI 3:2" /><note caller="+" style="x"><char style="xo" closed="false">3:2 </char><char style="xt" closed="false"><ref loc="TIT 1:6-9">तीतुस 1:6-9</ref></char></note>आहयु जरुड़ी से के डायलो वण-गुनाळ्‌ळो, अने एकीत बयर नो घोरवाळो, अने आह़फा ने कब्‌जा मे राखण्‌यो, ह़ोयाळ्‌ळो वेहवार करवा वाळो, अने पोरणा नी आव-भाव करवा वाळो, अने हुनर सी ह़ीकाड़वा वाळो रेवा जोवे। <verse eid="1TI 3:2" /><verse number="3" style="v" sid="1TI 3:3" />छाकवा वाळो नीता ठोकवा वाळो नी रेवा जोवे; पण भोळो हय, अने नी झगड़ो करवा वाळो, अने नी धन नो लालच्‌यो हय। <verse eid="1TI 3:3" /><verse number="4" style="v" sid="1TI 3:4" />तीहयो आह़फा ना घोरल्‌या नी वारु देख-रेख करतो हय, अने तीना सोरा-सोरी तीनी वात मानीन तीना हक मे रेता हय। <verse eid="1TI 3:4" /><verse number="5" style="v" sid="1TI 3:5" />जत्‌यार कोय आह़फात ना घोर नो जुगाड़ करवा नी जाणतो हय, ता भगवान नी मंडळी नी रखवाळी कीकम करहे? <verse eid="1TI 3:5" /><verse number="6" style="v" sid="1TI 3:6" />तीहयो भरहा मे पक्‌को रेवा जोवे, नीता घमंड आय जहे ता भुतड़ान तेम डंड जड़े। <verse eid="1TI 3:6" /><verse number="7" style="v" sid="1TI 3:7" />अने बाहर वाळा मे बी नामह़ाद्‌यो हये आसम नी हयवा जोवे के तीहयो वकाळ्‌ळो हय्‌न अने तीहयो भुतड़ा ना फंदा मे फस जाय।<verse eid="1TI 3:7" /></para>
  <para style="s">मंडळी ना चाकर्‌या</para>
  <para style="p">
    <verse number="8" style="v" sid="1TI 3:8" />तेमेत भगवान ना चाकर्‌या ने बी नामह़ाद्‌या रेवा जोवे, ह़ोवकारला, अने छाकवा वाळा, अने रीकामी कमाय ना लालच्‌या नी रेवा जोवे। <verse eid="1TI 3:8" /><verse number="9" style="v" sid="1TI 3:9" />तीहयो चोखलु मन मे भरहा नी सच्‌चाय नी वात ने बचाड़ीन राखे। <verse eid="1TI 3:9" /><verse number="10" style="v" sid="1TI 3:10" />अने आहया आखा ने बी पेले पारखो, कदीम वण-गुनाळ्‌ळा नीकळे ता चाकर्‌या नु काम करे। <verse eid="1TI 3:10" /><verse number="11" style="v" sid="1TI 3:11" />आखा बयरा पुरी रीती सी होगा रेवा जोवे, गुनो लगाड़वा वाळी नी रेवा जोवे, पण जाळवीन अने आखी वाते भरहा ना लायक रेवा जोवे। <verse eid="1TI 3:11" /><verse number="12" style="v" sid="1TI 3:12" />चाकर्‌यो एकीत बयर नो लाडो रेवा जोवे, अने सोरा-सोरी ने अने आह़फा ना घोरल्‌या जुगु वारु जुगाड़ करवा वाळो रेवा जोवे। <verse eid="1TI 3:12" /><verse number="13" style="v" sid="1TI 3:13" />काहाके जे बी चाकर्‌या नु काम वारु रीती सी पुरु करला से, तीहया आह़फाम नी जुगु ते एक वारु जागो हात करहे, अने तीहया भरहा मे जे मसी ईसु पोर से, अळी बी जादा हीम्‌मत जड़ जहे।<verse eid="1TI 3:13" /></para>
  <para style="s">मोटी ह़तायली वात</para>
  <para style="p">
    <verse number="14" style="v" sid="1TI 3:14" />मे तारीन्‌तां छोटोत आव्‌वा नी आह कर र्‌यो, ते बी आहयी चीट्‌ठी तार जुगु आनीन करते लीखु, <verse eid="1TI 3:14" /><verse number="15" style="v" sid="1TI 3:15" />के कदीम मारी आव्‌वा मे वार हय, ता तु आहयी चीट्‌ठी सी जाण लेजे, के भगवान ना घोरल्‌या मे जे जीवत्‌ला भगवान नी मंडळी से अने सच्‌चाय नो खम्‌बो अने नीव से, तु जाण लेजे के केवो वेहवार करवा जोवे। <verse eid="1TI 3:15" /><verse number="16" style="v" sid="1TI 3:16" />आनी मे कंय बी सणक्‌या नी हय, के आहयी भक्‌ती नी ह़तायली वात घणी जुदी से,</para>
  <para style="q1" vid="1TI 3:16">मसी ईसु डील मे उजन्‌तो हयो,</para>
  <para style="q2" vid="1TI 3:16">अने आत्‌मा मे धरमी ठेर्‌यो,</para>
  <para style="q2" vid="1TI 3:16">ह़रगदुत ने देखाव पड़्‌यो,</para>
  <para style="q1" vid="1TI 3:16">आखा देसु ना माणहु मे तीनु परच्‌यार हयो,</para>
  <para style="q2" vid="1TI 3:16">आहयी कळी मे माणहु तीनी पोर भरहो कर्‌या,</para>
  <para style="q2" vid="1TI 3:16">अने तीहयो बड़ाय भेळ ह़रग मे उचलाय ज्‌यो।<verse eid="1TI 3:16" /></para>
  <chapter eid="1TI 3" />
  <chapter number="4" style="c" sid="1TI 4" />
  <para style="s">झुटा मास्‌तर्‌या</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 4:1" />पण चोखली आत्‌मा घण वारु केय के आव्‌वा वाळी टेम मे केतरा माणहु भटकाड़वा वाळी आत्‌मा अने भुत नी ह़ीकापण पोर मन लगाड़ीन भरहो करीन भटक जहे। <verse eid="1TI 4:1" /><verse number="2" style="v" sid="1TI 4:2" />आहयु तीहया झुटा ढोंगड़ा करन्‌या माणहु ना कारण सी हयहे, जीमनु मन मर जेलु से के धपत्‌लु लुहड़ु वेर डामलु हय। <verse eid="1TI 4:2" /><verse number="3" style="v" sid="1TI 4:3" />आहया माणहु वेवा करवा सी रोके, अने खावा नी थोड़ीक चीज गेथा सेटा रेवा नो हुकम आपे; जीने भगवान आनी लेदे बणायो के भरहो करन्‌या माणहु, अने सच्‌चाय ने ओळखवा वाळा भगवान ने घणो वारु से कीन अने वीन्‌ती करीन खाय। <verse eid="1TI 4:3" /><verse number="4" style="v" sid="1TI 4:4" />काहाके भगवान नी बणावली आखी बी चीज वारली से: कानी बी चीज नीकारो करे एवी नी हय; पण आसम के भगवान ने घणो वारु कीन खावा जोवे। <verse eid="1TI 4:4" /><verse number="5" style="v" sid="1TI 4:5" />काहाके भगवान ना बोलु सी अने वीन्‌ती करवा सी आखु खावा नु चीज चोखु हय जाय।<verse eid="1TI 4:5" /></para>
  <para style="s">मसी ईसु ना वारला चाकर्‌या</para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 4:6" />कदीम तु आखा भरहो करन्‌या भायु ने आहयी वात नी फोम करावतो रेही, ता मसी ईसु नो वारलो चाकर्‌यो ठेरही: अने जे भरहा, अने जे वारली ह़ीकापण नी वात सी, जे तु मान्‌तो आय र्‌यो, तारो पाळण-पोसण हयतो रेहे। <verse eid="1TI 4:6" /><verse number="7" style="v" sid="1TI 4:7" />पण वीटळ्‌ळी अने डोकर्‌या नी काहणी सी अलग रे; अने भक्‌ती करवा ह़ीक। <verse eid="1TI 4:7" /><verse number="8" style="v" sid="1TI 4:8" />काहाके डील सी ह़ीकाड़वा सी कम फायदो हये, पण भक्‌ती आखी वाते फायदो करवा वाळी से, काहाके आहयी टेमे नी जीवाय अने आव्‌वा वाळी जीवाय ना बी वायदा आनीत करते से। <verse eid="1TI 4:8" /><verse number="9" style="v" sid="1TI 4:9" />आहयी वात ह़ाचली अने भरहो करे एवी अने आखी भाते माने एवी से। <verse eid="1TI 4:9" /><verse number="10" style="v" sid="1TI 4:10" />काहाके आपणु काठु काम आनीन करते करया, के आपणी आह तीहया जीवत्‌ला भगवान पोर से; जे आखा माणहु नो, अने खास करीन आखा भरहो करन्‌या माणहु नो छुटकारो आपण्‌यो से।<verse eid="1TI 4:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 4:11" />तु आहयी आखी वात नो हुकम आप, अने तु ह़ीकाड़तो रे। <verse eid="1TI 4:11" /><verse number="12" style="v" sid="1TI 4:12" />कोय बी तारी जुवानी ने हेटी नी ह़मजवा जोवे; भगवान ना बोल, चाल-चलण, मोंग भरहा, अने चोखलापणा मे भरहो करवा वाळा जुगु ईज्‌जत बण जा। <verse eid="1TI 4:12" /><verse number="13" style="v" sid="1TI 4:13" />मने आवते लग तु पाट भणवा अने ह़मजाड़तो रे, अने ह़ीकाड़वा मे लागलो रे। <verse eid="1TI 4:13" /><verse number="14" style="v" sid="1TI 4:14" />तीहयो आत्‌मा ना ईलाम सी अंजाणो ना बणे, जे तारी मे से, अने मंडळी ना आखा पुडार्‌या हात मेकवा नी टेमे तने भगवान वगे गेथो जड़लो से। <verse eid="1TI 4:14" /><verse number="15" style="v" sid="1TI 4:15" />तीहयी आखी वात ने सोच मे राख, अने तीनी मे तारो आखो धीयान लगाड़, काहाके तारी बड़ोत्‌री आखा पोर उजन्‌ती हये। <verse eid="1TI 4:15" /><verse number="16" style="v" sid="1TI 4:16" />अने आह़फा नी अने आपणी ह़ीकापण नी रखवाळी कर। आहयी आखी वात पोर टेकलो रे, काहाके कदीम तु आसम करतो रेही, ता तु अने तारी ह़मळवा वाळा बी तारा कारण सी छुटकारो हात करहे।<verse eid="1TI 4:16" /></para>
  <chapter eid="1TI 4" />
  <chapter number="5" style="c" sid="1TI 5" />
  <para style="s">भरहो करवा वाळा जुगु काम</para>
  <para style="p">
    <verse number="1" style="v" sid="1TI 5:1" />काना बी डायला माणेह ने ना वडे, पण तीने बाह जाणीन ह़मजाड़ दे, अने जुवान्‌या ह़ाते भाय जाणीन वेहवार कर। <verse eid="1TI 5:1" /><verse number="2" style="v" sid="1TI 5:2" />अने डायली बयर ने आय्‌ह़ जाणीन ह़मजाड़ दे; अने जुवान्‌याण बयर ने पुरो चोखलापणा मे रीन बेनेह ह़मजीन ह़मजाड़ दे।<verse eid="1TI 5:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 5:3" />जे रंडायला से तीमनी ईज्‌जत कर। <verse eid="1TI 5:3" /><verse number="4" style="v" sid="1TI 5:4" />कदीम काना रंडायला बयरा ना सोरा-सोरी हय, नीता सोरा ना सोरा हय, ता तीहया आह़फा ना घोराणा ह़ाते ईज्‌जत भेळ वेहवार करजो, अने आह़फा ना आय्‌ह-बाहा अने बीजाम ने तीमनो हक आपवा ह़ीको, काहाके भगवान ने आहयुत गमे <verse eid="1TI 5:4" /><verse number="5" style="v" sid="1TI 5:5" />जे ह़ाचली रंडायली से, अने तीनु कोय नी हय; तीहयी भगवान पोर आह राखे, अने रात-दाड़ो रावण्‌या करीन वीन्‌ती करवा मे झींगे पड़ रेय। <verse eid="1TI 5:5" /><verse number="6" style="v" sid="1TI 5:6" />पण जे वारु सुके जीवीन घण-जबर मजा करे, तीहयी जीवत्‌ली हय्‌न बी मरला मुजुक से। <verse eid="1TI 5:6" /><verse number="7" style="v" sid="1TI 5:7" />अने आहयी आखी वात नो बी हुकम आप्‌या कर, काहाके तीहया आखा वण-गुनाळ्‌ळा रेय। <verse eid="1TI 5:7" /><verse number="8" style="v" sid="1TI 5:8" />पण कदीम कोय आह़फा ना ह़गाय, अने खास करीन आह़फात ना घोरल्‌या नी फीकर करीन मदत नी करे, ता तीहयो ईसु ना भरहा गेथो सेटो हय ज्‌यो, अने जे ईसु पोर भरहो नी करे, तीमनी गेथो बी जादा खोड़लो बण जेलो से।<verse eid="1TI 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="1TI 5:9" />तीहयीत रंडायली बयर नु नाम लीखवा जोवे, जे साट साल गेथी जादा उमर वाळी हय, अने एकीत अदमी नी लाडी री हय। <verse eid="1TI 5:9" /><verse number="10" style="v" sid="1TI 5:10" />अने भला काम मे नामह़ाद्‌याण हय, जे सोरा-सोरी नु पाळण-पोसण करी हय; अने पोरणा नी सेवा करी हय, चोखला माणहु ना पोगु धोयी हय, अने दुखी माणहु नी मदत करी हय, अने भात-भाती ना भला कामु मे मन लगाड़ी हय।<verse eid="1TI 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 5:11" />पण जुवान रंडायला बयरा नु नाम नी लीखजो, काहाके मोज-मजा मे पड़ीन मसी सी सेटी हय जाय अने वेवा करवा हींडे। <verse eid="1TI 5:11" /><verse number="12" style="v" sid="1TI 5:12" />अने गुनाळ्‌ळी बण जाय, काहाके तीहयीत तीना पेल्‌ना वायदा ने तोड़ देय। <verse eid="1TI 5:12" /><verse number="13" style="v" sid="1TI 5:13" />अने अळी बीजा ना घोर-घोर जाय्‌न ओगज्‌याण ह़ीके, अने एतरुत नी, पण तीहयी बक-बक करती रेय अने बीजा ना काम मे अड़चन नाखे अने गलत-गलत वात करे। <verse eid="1TI 5:13" /><verse number="14" style="v" sid="1TI 5:14" />एतरे मारु आहयु केणु से, के जे जुवान्‌या बयरा रंडाय जेला से, तीहया बयरा वेवा अने सोरा नी आय्‌ह बणे अने घोरबार ह़माळे, अने वीरोदी ने नामबद्‌दी करवा नो मोखो ना आपो। <verse eid="1TI 5:14" /><verse number="15" style="v" sid="1TI 5:15" />काहाके एवा कंय भटकीन भुतड़ा पसळ चालन्‌या बण जेला से। <verse eid="1TI 5:15" /><verse number="16" style="v" sid="1TI 5:16" />कदीम कानी बी भरहो करन्‌याण बयर ना घोर रंडायली बयर हय, ता तीनी मदत तीहयीत करे, काहाके मंडळी पोर बोजो नी पड़े, अने मंडळी जे बीजा रंडायला बयरा नी मदत कर सके।<verse eid="1TI 5:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 5:17" />जे डायला वारु जुगाड़ करे, खास करीन, जे भगवान ना बोलु ह़मळाव्‌वा मे अने ह़मजाड़वा मे काठु काम करे, तीमने बे गुणा दाड़की जड़वा जोवे। <verse eid="1TI 5:17" /><verse number="18" style="v" sid="1TI 5:18" /><note caller="+" style="x"><char style="xo" closed="false">5:18 </char><char style="xt" closed="false"><ref loc="MAT 10:10">मत्‌ती 10:10</ref>; <ref loc="LUK 10:7">लुका 10:7</ref></char></note>चोखली सास्‌तर मे बी लीखलु से, खळा मे जोपला बोळद्‌या ना मोडे कंडल्‌यो ना बांदो, काहाके दाड़क्‌यो तीनी दाड़की नो हकदार्‌यो से। <verse eid="1TI 5:18" /><verse number="19" style="v" sid="1TI 5:19" />कोय बी गुनो काना डायला पोर लगाड़े ता बे नीता तीन गवाय ह़मळ्‌या वगर तीनी पोर भरहो ना करो। <verse eid="1TI 5:19" /><verse number="20" style="v" sid="1TI 5:20" />पाप करवा वाळा ने वडीन आखा अगळ ह़मजाड़ दे, काहाके बीजा माणहु बी पाप करवा सी बीहे।<verse eid="1TI 5:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 5:21" />भगवान, अने ईसु मसी, अने ह़रगदुत अगळ तीमने हजुर जाणीन मे तने हुकम आपु, के तु मन लगाड़ीन आहयी वात ने मान्‌या कर, अने आहयु काम भेद-भाव सी ना करे। <verse eid="1TI 5:21" /><verse number="22" style="v" sid="1TI 5:22" />कोय पोर बी छोटोत हात नी मेकजे, अने बीजा ना पाप मे तु नी भेसकायजे: तु आह़फा ने चोखलो राखजे।<verse eid="1TI 5:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="1TI 5:23" />तारु पेट वळ-वळीन दुख्‌या करे, अने तु मांदो हया करे, करीन आव्‌वा वाळा दाड़ा मे पाणी एतरोत नी, पण अंगुर नो रोह बी पीया कर।<verse eid="1TI 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="1TI 5:24" />केतरा माणहु ना पाप उजन्‌ता हय जाय, अने नीयाव नी करते पेलेत दवड़ीन आय लागे, पण थोड़ाक माणहु ना पाप पसळ गेथा उजन्‌ता हये। <verse eid="1TI 5:24" /><verse number="25" style="v" sid="1TI 5:25" />आहयीत रीते केतरा भला काम बी उजन्‌ता हये, जे आसवा नी रेय, तीहया बी ह़ताय नी सके।<verse eid="1TI 5:25" /></para>
  <chapter eid="1TI 5" />
  <chapter number="6" style="c" sid="1TI 6" />
  <para style="p">
    <verse number="1" style="v" sid="1TI 6:1" />जेतरा माणहु, बीजा माणहु ना पावर्‌या बण र्‌या, तीहया आह़फाम ना मालीक नी ईज्‌जत करवा जोवे, काहाके भगवान ना नाम नो अने ह़ीकापण नो वाक नी नीकळवा जोवे। <verse eid="1TI 6:1" /><verse number="2" style="v" sid="1TI 6:2" />अने जीमना मालीक भरहो करन्‌या से, तीमने तीहया भाय जाणीन हेटो नी ह़मजवा जोवे; पण तीमनी अळी बी जादा सेवा करवा जोवे, काहाके जे बी ईनो फायदो हात करे, तीहयो भरहो करन्‌यो अने मोंगाळ्‌ळो माणेह से: आहयी आखी वात ह़ीकाड़तो रे अने परच्‌यार करतो रे।<verse eid="1TI 6:2" /></para>
  <para style="s">झुटी ह़ीकापण धन नी लालच</para>
  <para style="p">
    <verse number="3" style="v" sid="1TI 6:3" />अने कदीम कोय बीजीत भाती नी ह़ीकापण आपतो हय, अने खरली वात ने, अने आपणा ईसु मसी नी वात ने अने ह़ीकापण ने नी माने, जे भक्‌ती ना अनसारे से, <verse eid="1TI 6:3" /><verse number="4" style="v" sid="1TI 6:4" />ता तीहयो मोटाय करन्‌यो बण ज्‌यो, तीने खरली भक्‌ती ना बारा मे कंय बी मालम नी हय; तीहयो जखड़ी पड़वा अने रीकामी बोलु नी लेदे झुमायवा, अने वाक काडवा, बेरजाव, नामबद्‌दी, अने गलत-गलत सणक्‌या करवा वाळो, <verse eid="1TI 6:4" /><verse number="5" style="v" sid="1TI 6:5" />अने तीहया माणहु मे रीकामी झगड़ा-रगड़ा उबजे। अने तीहया सच्‌चाय गेथा सेटा हय ज्‌या, अने तीहया सोचे के भक्‌ती करवा कमाय नु झापलु से।<verse eid="1TI 6:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="1TI 6:6" />पण नीहरा रीन भक्‌ती करवात आखा गेथी मोटी कमाय से। <verse eid="1TI 6:6" /><verse number="7" style="v" sid="1TI 6:7" />काहाके आपणु नी ते आहयी कळी मे कंय लाया, अने नी कंय लीजया, <verse eid="1TI 6:7" /><verse number="8" style="v" sid="1TI 6:8" />कदीम आपणी पांह खावा जुगु, अने पेरवा जुगु लुगड़ा हय, ता एतरीत चीज मे नीरहा रेवा जोवे। <verse eid="1TI 6:8" /><verse number="9" style="v" sid="1TI 6:9" />पण जे मालदार हयवा नी हेर करे, तीहया एवी पारख मे, अने फंदा मे अने घण-जबर रीकामी अने नुकसान करवा वाळी लालच मे फस जाय, जे माणहु ने बगाड़ देय अने खत्‌तम कर देवा वाळी दर्‌या मे डुबाड़ देय। <verse eid="1TI 6:9" /><verse number="10" style="v" sid="1TI 6:10" />धन नी हाय आखी भाती नी कुहराय ना मुळ्‌या से; ढेरेत जणा धन हात करवा नी हेर करते-करते भरहा गेथा वीरखाय जेला से, अने तीहया आह़फात भात-भाती नी मंदवाड़ मे पड़ ज्‌या।<verse eid="1TI 6:10" /></para>
  <para style="s">तीमुथीयुस ने एखला ने ह़ला</para>
  <para style="p">
    <verse number="11" style="v" sid="1TI 6:11" />पण ए भगवान ना माणेह, तु आहयी आखी वात गेथो सेटो नाह; अने धरम, भक्‌ती, भरहा, मोंग, गम, अने नीचळाय नी वात पसळ पड़। <verse eid="1TI 6:11" /><verse number="12" style="v" sid="1TI 6:12" />भरहा नी एक वारली दवड़, दवड़ अने तीहयी अमरकाय जीवाय ने हात कर ले, जीनी जुगु तने भगवान बोलावलो से, अने ढेरेत गवा नी अगळ तु मानी बी लेदलो से। <verse eid="1TI 6:12" /><verse number="13" style="v" sid="1TI 6:13" /><note caller="+" style="x"><char style="xo" closed="false">6:13 </char><char style="xt" closed="false"><ref loc="JHN 18:37">युहन्‌ना 18:37</ref></char></note>मे तने भगवान ने जे आखा ने जीवत्‌ला राखे, अने ईसु मसी ने गवा राखीन जे पुन्‌तीयुस पीलातुस नी अगळ मान लेदलो, आहयो हुकम आपु। <verse eid="1TI 6:13" /><verse number="14" style="v" sid="1TI 6:14" />के आपणा ईसु मसी ने पासो उजन्‌तो आवते लग, वण-गुनाळ्‌ळो अने चोखलो रे। <verse eid="1TI 6:14" /><verse number="15" style="v" sid="1TI 6:15" />जीने तीहयो वारु टेम मे देखाड़हे, आपणो भगवान, आखा गेथो जुगाळो अने मोटो से, अने तीहयो राजा नो राजा, अने, मालीक नो मालीक से। <verse eid="1TI 6:15" /><verse number="16" style="v" sid="1TI 6:16" />अने तीहयो एतरोत अमर से, अने तीहयो आच ने तेवा वीजाळा मे रेय, अने तीने कानु बी माणेह नी देख्‌यु, अने कानु बी माणेह आह़फा नी ज्‌योरे नी देख सके; तीने जलमकी ईज्‌जत जड़ती रेहे, अने तीनुत राज जलमकु रेहे। आमीन।<verse eid="1TI 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="1TI 6:17" />आहयी कळी मे वाळा मालदार माणहु ने हुकम आप, के तीहयो आहयी कळी मे साटुत खुट जवा वाळु धन पोर मोटाय अने आह नी करवा जोवे; पण भगवान पोर जे आपणा सुक नी लेदे आखु कंय घण जबर आपे। <verse eid="1TI 6:17" /><verse number="18" style="v" sid="1TI 6:18" />तीमने हुकम आप के तीहया भलाय करे, बीजा ने सात देवा मे उतवाळ्‌या रेवा जोवे, अने भलाय नात काम मे मालदार बणवा जोवे। <verse eid="1TI 6:18" /><verse number="19" style="v" sid="1TI 6:19" />अने अगला दाड़ा जुगु एक वारली नीव नाखीन तीयार कर रेय, अने सच्‌चाय नी जीवाय ने हक मे कर लेय।<verse eid="1TI 6:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="1TI 6:20" />ए तीमुथीयुस, जे वात मे तने केदलो से, तीहयी वात ने एक खजानान तेम रखवाळी कर। अने जे तीहयी अक्‌कल ना वीटळ्‌ळी एवा रीकामी वात सी अने वीरोद नी वात गेथो सेटो रे।<verse eid="1TI 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="1TI 6:21" />काय केतरा माणहु आहयी अक्‌कल ने मानीन, भरहा गेथा भटकी जेला से। तमारी पोर दया हयती रेय।<verse eid="1TI 6:21" /></para>
  <chapter eid="1TI 6" />
</usx>