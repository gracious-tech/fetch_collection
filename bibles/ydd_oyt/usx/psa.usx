<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="PSA" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">תְּהִלִּים</para>
  <para style="toc2">תְּהִלִּים</para>
  <para style="toc1">תְּהִלִּים</para>
  <para style="mt1">תְּהִלִּים</para>
  <chapter number="1" style="c" pubnumber="א" sid="PSA 1" />
  <para style="ms">ערשטער סֵפֿר</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 1:1" />װױל צו דעם מענטשן װאָס איז נישט געגאַנגען</para>
  <para style="q" vid="PSA 1:1">אין דער עצה פֿון די רשעים.</para>
  <para style="q" vid="PSA 1:1">און אױף דעם װעג פֿון די זינדיקע, איז ער נישט געשטאַנען,</para>
  <para style="q" vid="PSA 1:1">און אין דער זיצונג פֿון די שפּעטער איז ער נישט געזעסן.<verse eid="PSA 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 1:2" />נײַערט צו דער תּורה פֿון ה׳ איז זײַן באַגער,</para>
  <para style="q" vid="PSA 1:2">און אָן זײַן תּורה טראַכט ער טאָג און נאַכט.<verse eid="PSA 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 1:3" />און ער װעט זײַן װי אַ בױם געפֿלאַנצט בײַ בעכן װאַסער,</para>
  <para style="q" vid="PSA 1:3">װאָס גיט זײַן פֿרוכט אין זײַן צײַט,</para>
  <para style="q" vid="PSA 1:3">און זײַן בלאַט װערט נישט פֿאַרװעלקט;</para>
  <para style="q" vid="PSA 1:3">און אין אַלץ װאָס ער טוט װעט ער באַגליקן.<verse eid="PSA 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 1:4" />נישט אַזױ זײַנען די רשעים;</para>
  <para style="q" vid="PSA 1:4">נײַערט װי דער שפּרײ װאָס אַ װינט פֿאַריאָגט אים,<verse eid="PSA 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 1:5" />דערום װעלן די רשעים נישט באַשטײן פֿאַרן משפּט,</para>
  <para style="q" vid="PSA 1:5">און די זינדיקע אין דער עדה פֿון די צדיקים,<verse eid="PSA 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 1:6" />װאָרעם ה׳ מערקט דעם װעג פֿון די צדיקים,</para>
  <para style="q" vid="PSA 1:6">און דער װעג פֿון די רשעים װעט אונטערגײן.<verse eid="PSA 1:6" /></para>
  <chapter eid="PSA 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="PSA 2" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 2:1" />פֿאַר װאָס רודערן די פֿעלקער,</para>
  <para style="q" vid="PSA 2:1">און די אומות טוען ברומען אומנישט?<verse eid="PSA 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 2:2" />די מלכים פֿון דער ערד שטעלן זיך אױף,</para>
  <para style="q" vid="PSA 2:2">און די פֿירשטן עצהן זיך אין אײנעם</para>
  <para style="q" vid="PSA 2:2">אױף ה׳ און אױף זײַן געזאַלבטן:<verse eid="PSA 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 2:3" />לאָמיר צערײַסן זײערע בינד,</para>
  <para style="q" vid="PSA 2:3">און אַראָפּװאַרפֿן פֿון אונדז זײערע שטריק.<verse eid="PSA 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 2:4" />דער װאָס זיצט אין הימל לאַכט,</para>
  <para style="q" vid="PSA 2:4">אֲדֹנָי טוט שפּעטן פֿון זײ.<verse eid="PSA 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 2:5" />דענצמאָל װעט ער רעדן צו זײ אין זײַן כּעס,</para>
  <para style="q" vid="PSA 2:5">און אין זײַן גרימצאָרן װעט ער זײ דערשרעקן:<verse eid="PSA 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 2:6" />דאָס האָב איך דאָך אױפֿגעשטעלט מײַן מלך</para>
  <para style="q" vid="PSA 2:6">אױף צִיוֹן מײַן הײליקן באַרג.<verse eid="PSA 2:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 2:7" />לאָמיר דערצײלן פֿון דער באַשערונג:</para>
  <para style="q" vid="PSA 2:7">ה׳ האָט מיר געזאָגט:</para>
  <para style="q" vid="PSA 2:7">מײַן זון ביסטו,</para>
  <para style="q" vid="PSA 2:7">איך האָב הײַנט דיך געבאָרן.<verse eid="PSA 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 2:8" />בעט בײַ מיר, און איך װעל געבן פֿעלקער פֿאַר דײַן אַרב,</para>
  <para style="q" vid="PSA 2:8">און פֿאַר דײַן אײגנטום די עקן פֿון דער ערד.<verse eid="PSA 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 2:9" />װעסט זײ צעברעכן מיט אַן אײַזערנער רוט,</para>
  <para style="q" vid="PSA 2:9">װי אַ טעפּערגעפֿעס זײ צעפּיצלען.<verse eid="PSA 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 2:10" />און אַצונד, איר מלכים, באַטראַכט,</para>
  <para style="q" vid="PSA 2:10">לאָזט אײַך לערנען, איר ריכטער פֿון דער ערד.<verse eid="PSA 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 2:11" />דינט ה׳ מיט מורא,</para>
  <para style="q" vid="PSA 2:11">און שױדערט אין ציטערניש.<verse eid="PSA 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 2:12" />קישט דעם זון, כּדי ער זאָל נישט צערענען,</para>
  <para style="q" vid="PSA 2:12">און איר װעט אומקומען פֿון דעם װעג,</para>
  <para style="q" vid="PSA 2:12">אַז זײַן כּעס װעט זיך אָנצינדן באַלד;</para>
  <para style="b" vid="PSA 2:12" />
  <para style="q" vid="PSA 2:12">װױל איז צו אַלע װאָס שיצן זיך אין אים.<verse eid="PSA 2:12" /></para>
  <chapter eid="PSA 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="PSA 3" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 3:1" />אַ מיזמור פֿון דָוִדן, װען ער איז אַנטלאָפֿן פֿון זײַן זון אַבֿשָלומען.<verse eid="PSA 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 3:2" /> ה׳, װי פֿיל זײַנען מײַנע פֿײַנט!</para>
  <para style="q" vid="PSA 3:2">פֿיל די װאָס שטײען אָן אױף מיר!<verse eid="PSA 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 3:3" /> פֿיל זאָגן אױף מײַן זעל:</para>
  <para style="q" vid="PSA 3:3">נישטאָ פֿאַר אים קײן הילף בײַ אלֹקים. סֶלָה.<verse eid="PSA 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 3:4" /> אָבער דו ה׳ ביסט אַ שילד פֿאַר מיר,</para>
  <para style="q" vid="PSA 3:4">מײַן כּבֿוד און דער דערהײבער פֿון מײַן קאָפּ.<verse eid="PSA 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 3:5" /> מיט מײַן קֹול טו איך רופֿן צו ה׳,</para>
  <para style="q" vid="PSA 3:5">און ער ענטפֿערט מיר פֿון זײַן הײליקן באַרג. סֶלָה.<verse eid="PSA 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 3:6" /> איך לײג זיך און שלאָף אײַן,</para>
  <para style="q" vid="PSA 3:6">איך װאַך אױף, װײַל ה׳ לענט מיך אונטער.<verse eid="PSA 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 3:7" /> איך האָב נישט מורא פֿאַר צענטױזנטן פֿאָלק,</para>
  <para style="q" vid="PSA 3:7">װאָס האָבן רונד אַרום זיך אָנגעזעצט אױף מיר.<verse eid="PSA 3:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 3:8" /> שטײ אױף, ה׳, העלף מיך מײַן ג-ט,</para>
  <para style="q" vid="PSA 3:8">װאָרעם האָסט געשלאָגן אַלע מײַנע פֿײַנט אױף דער באַק,</para>
  <para style="q" vid="PSA 3:8">די צײן פֿון די רשעים האָסטו צעבראָכן.<verse eid="PSA 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 3:9" /> בײַ ה׳ איז די הילף;</para>
  <para style="q" vid="PSA 3:9">זאָל קומען דײַן ברכה אױף דײַן פֿאָלק! סֶלָה.<verse eid="PSA 3:9" /></para>
  <chapter eid="PSA 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="PSA 4" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 4:1" />פֿאַר דעם געזאַנגמײַסטער, מיט סטרונעשפּיל; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 4:2" /> אַז איך רוף, ענטפֿער מיר, דו ג-ט פֿון מײַן גערעכטער;</para>
  <para style="q" vid="PSA 4:2">אין ענגעניש זאָלסטו מיר דערברײטערן;</para>
  <para style="q" vid="PSA 4:2">לײַטזעליק מיך, און הער צו מײַן תּפֿילה.<verse eid="PSA 4:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 4:3" /> איר מענטשנקינדער,</para>
  <para style="q" vid="PSA 4:3">ביז װאַנען װעט מײַן כּבֿוד צו שאַנד זײַן,</para>
  <para style="q" vid="PSA 4:3">װעט איר ליב האָבן נישטיקײט,</para>
  <para style="q" vid="PSA 4:3">װעט איר זוכן ליגן? סֶלָה.<verse eid="PSA 4:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 4:4" /> אָבער זײַט װיסן, אַז ה׳ שײדט אָפּ זײַן פֿרומען,</para>
  <para style="q" vid="PSA 4:4">ה׳ װעט הערן אַז איך װעל רופֿן צו אים.<verse eid="PSA 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 4:5" /> ציטערט און איר זאָלט נישט זינדיקן,</para>
  <para style="q" vid="PSA 4:5">באַקלערט אין אײַער האַרצן אױף אײַער געלעגער,</para>
  <para style="q" vid="PSA 4:5">און װערט אַנטשװיגן. סֶלָה.<verse eid="PSA 4:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 4:6" /> שלאַכט שלאַכטאָפּפֿער פֿון גערעכטיקײט,</para>
  <para style="q" vid="PSA 4:6">און פֿאַרזיכערט אײַך אױף ה׳.<verse eid="PSA 4:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 4:7" /> פֿיל זאָגן: װער װעט אונדז װײַזן גוטס?</para>
  <para style="q" vid="PSA 4:7">ה׳, הײב דאָס ליכט פֿון דײַן פּנים אױף אונדז.<verse eid="PSA 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 4:8" /> האָסט מיר געגעבן מער שׂימחה אין האַרצן,</para>
  <para style="q" vid="PSA 4:8">װי בעת זײער תּבֿואה און זײער װײַן זײַנען פֿיל.<verse eid="PSA 4:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 4:9" /> בשלום װי איך לײג זיך אַזױ שלאָף איך אײַן,</para>
  <para style="q" vid="PSA 4:9">װאָרעם דו ה׳ מאַכסט מיך װױנען באַזונדער אין זיכערקײט.<verse eid="PSA 4:9" /></para>
  <chapter eid="PSA 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="PSA 5" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 5:1" />פֿאַר דעם געזאַנגמײַסטער אױף נחילות; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 5:2" /> פֿאַרנעם מײַנע װערטער, ה׳.</para>
  <para style="q" vid="PSA 5:2">מערק מײַן זיפֿצעניש.<verse eid="PSA 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 5:3" /> האָרך צום קֹול פֿון מײַן געשרײ, מײַן קיניג און מײַן ג-ט,</para>
  <para style="q" vid="PSA 5:3">װאָרעם צו דיר טו איך בעטן.<verse eid="PSA 5:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 5:4" /> ה׳, פֿרימאָרגנס הער צו מײַן קֹול,</para>
  <para style="q" vid="PSA 5:4">פֿרימאָרגנס טענה איך צו דיר, און קוק אױס.<verse eid="PSA 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 5:5" /> װאָרעם נישט אַן אֵל װאָס װיל אומרעכט ביסטו,</para>
  <para style="q" vid="PSA 5:5">בײַ דיר קען נישט װײַלן קײן שלעכטס.<verse eid="PSA 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 5:6" /> פּראָלער קענען נישט שטײן פֿאַר דײַנע אױגן,</para>
  <para style="q" vid="PSA 5:6">האָסט פֿײַנט אַלע טוער פֿון אומרעכט.<verse eid="PSA 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 5:7" /> ברענגסט אונטער די װאָס רעדן ליגן;</para>
  <para style="q" vid="PSA 5:7">דעם מאַן פֿון בלוט און באַטרוג פֿאַראומװערדיקט ה׳.<verse eid="PSA 5:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 5:8" /> אָבער איך װעל קומען</para>
  <para style="q" vid="PSA 5:8">אין דײַן הױז דורך דײַן גרױס גענאָד,</para>
  <para style="q" vid="PSA 5:8">איך װעל מיך בוקן אין דײַן הײליקן הֵיכל</para>
  <para style="q" vid="PSA 5:8">צװישן דײַנע פֿאָרכטער.<verse eid="PSA 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 5:9" /> ה׳, פֿיר מיך אין דײַן גערעכטיקײט</para>
  <para style="q" vid="PSA 5:9">פֿון װעגן מײַנע לױערער,</para>
  <para style="q" vid="PSA 5:9">מאַך גלײַך דײַן װעג פֿאַר מיר.<verse eid="PSA 5:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 5:10" /> װאָרעם נישטאָ אין זײער מױל קײן ריכטיקײט,</para>
  <para style="q" vid="PSA 5:10">זײער אינגעװײד איז אַן אונטערגאַנג,</para>
  <para style="q" vid="PSA 5:10">אַן אָפֿענער קבֿר איז זײער קעל;</para>
  <para style="q" vid="PSA 5:10">זײער צונג מאַכן זײ גלאַט.<verse eid="PSA 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 5:11" /> פֿאַרמשפּט זײ אלֹקים,</para>
  <para style="q" vid="PSA 5:11">זאָלן זײ פֿאַלן דורך זײערע באַראָטן;</para>
  <para style="q" vid="PSA 5:11">פֿאַרשטױס זײ פֿאַר זײערע פֿיל פֿאַרברעכן,</para>
  <para style="q" vid="PSA 5:11">װײַל זײ האָבן װידערשפּעניקט אָן דיר.<verse eid="PSA 5:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 5:12" /> און אַלע װאָס שיצן זיך אין דיר, װעלן זיך פֿרײען,</para>
  <para style="q" vid="PSA 5:12">אײביק װעלן זײ זינגען, װאָרעם װעסט זײ באַשירעמען,</para>
  <para style="q" vid="PSA 5:12">און די ליבהאָבער פֿון דײַן נאָמען</para>
  <para style="q" vid="PSA 5:12">װעלן זײַן לוסטיק מיט דיר.<verse eid="PSA 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 5:13" /> װאָרעם דו בענטשסט דעם צדיק, ה׳,</para>
  <para style="q" vid="PSA 5:13">װי אַ שילד מיט גוטװיליקײט רינגלסטו אים אַרום.<verse eid="PSA 5:13" /></para>
  <chapter eid="PSA 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="PSA 6" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 6:1" />פֿאַר דעם געזאַנגמײַסטער, מיט סטרונעשפּיל, אױף שמינית; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 6:2" /> נישט אין דײַן כּעס זאָלסטו מיך מוסרן, ה׳,</para>
  <para style="q" vid="PSA 6:2">און נישט אין דײַן גרימצאָרן זאָלסטו מיך שטראָפֿן.<verse eid="PSA 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 6:3" /> לײַטזעליק מיך, ה׳,</para>
  <para style="q" vid="PSA 6:3">װאָרעם איך װער פֿאַרשניטן,</para>
  <para style="q" vid="PSA 6:3">הײל מיך, ה׳,</para>
  <para style="q" vid="PSA 6:3">װאָרעם מײַנע בײנער זײַנען דערשראָקן,<verse eid="PSA 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 6:4" /> און מײַן זעל איז דערשראָקן זײער,</para>
  <para style="q" vid="PSA 6:4">און דו ה׳, ביז װאַנען?<verse eid="PSA 6:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 6:5" /> קער זיך אום, ה׳, דערלײז מײַן זעל,</para>
  <para style="q" vid="PSA 6:5">העלף מיך פֿון װעגן דײַן גענאָד.<verse eid="PSA 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 6:6" /> װאָרעם נישטאָ אין טױט דײַן דערמאָנונג,</para>
  <para style="q" vid="PSA 6:6">אין שְׁאֹול װער װעט דיך לױבן?<verse eid="PSA 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 6:7" /> איך בין מיד פֿון מײַן זיפֿצן,</para>
  <para style="q" vid="PSA 6:7">איך באַװאַש אַלע נאַכט מײַן געלעגער,</para>
  <para style="q" vid="PSA 6:7">איך מאַך צעגײן אין מײַנע טרערן מײַן בעט.<verse eid="PSA 6:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 6:8" /> מאַט געװאָרן פֿון קומער איז מײַן אױג,</para>
  <para style="q" vid="PSA 6:8">אַלט געװאָרן פֿון װעגן אַלע מײַנע פֿײַנט.<verse eid="PSA 6:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 6:9" /> קערט אײַך אָפּ פֿון מיר, אַלע טוער פֿון אומרעכט,</para>
  <para style="q" vid="PSA 6:9">װאָרעם ה׳ האָט געהערט דעם קֹול פֿון מײַן געװײן.<verse eid="PSA 6:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 6:10" /> ה׳ האָט געהערט מײַן געבעט,</para>
  <para style="q" vid="PSA 6:10">ה׳ נעמט אָן מײַן תּפֿילה.<verse eid="PSA 6:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 6:11" /> פֿאַרשעמט און דערשראָקן זײער</para>
  <para style="q" vid="PSA 6:11">װעלן װערן אַלע מײַנע פֿײַנט;</para>
  <para style="q" vid="PSA 6:11">זײ װעלן אָפּטרעטן פֿאַרשעמט אין אַ רגע.<verse eid="PSA 6:11" /></para>
  <chapter eid="PSA 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="PSA 7" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 7:1" />אַ שִגָעון פֿון דָוִדן, װאָס ער האָט געזונגען צו ה׳ פֿון װעגן כּוּש דעם בנימינער.<verse eid="PSA 7:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 7:2" /> ה׳ מײַן ג-ט, אין דיר האָב איך מיך געשיצט,</para>
  <para style="q" vid="PSA 7:2">העלף מיך פֿון אַלע מײַנע נאָכיאָגער, און זײַ מיך מציל,<verse eid="PSA 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 7:3" /> מע זאָל נישט פֿאַרצוקן װי אַ לײב מײַן זעל, צערײַסן,</para>
  <para style="q" vid="PSA 7:3">און קײנער זאָל נישט מציל זײַן.<verse eid="PSA 7:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 7:4" /> ה׳ מײַן ג-ט, אױב איך האָב אַזױ װאָס געטאָן,</para>
  <para style="q" vid="PSA 7:4">אױב אומרעכט איז דאָ אין מײַנע הענט,<verse eid="PSA 7:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 7:5" /> אױב איך האָב געטאָן בײז מײַן גוטן פֿרײַנט,</para>
  <para style="q" vid="PSA 7:5">אָדער באַרױבט צו מאָל מײַן אומזיסטיקן פֿײַנט,<verse eid="PSA 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 7:6" /> זאָל דער שׂונא מיך נאָכיאָגן און דערגרײכן,</para>
  <para style="q" vid="PSA 7:6">און טרעטן צו דער ערד מײַן לעבן,</para>
  <para style="q" vid="PSA 7:6">און מײַן כּבֿוד אין שטױב לײגן.</para>
  <para style="q" vid="PSA 7:6">סֶלָה.<verse eid="PSA 7:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 7:7" /> שטײ אױף, ה׳, אין דײַן כּעס,</para>
  <para style="q" vid="PSA 7:7">דערהײב דיך אין גרימצאָרן קעגן מײַנע פֿײַנט,</para>
  <para style="q" vid="PSA 7:7">און דערװעק פֿאַר מיר דעם משפּט װאָס דו האָסט אָנגעזאָגט.<verse eid="PSA 7:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 7:8" /> און װי די עדה פֿון די פֿעלקער דיך רינגלט אַרום,</para>
  <para style="q" vid="PSA 7:8">קער זיך אום איבער איר צו דער הײך.<verse eid="PSA 7:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 7:9" /> ה׳, װאָס משפּטסט די פֿעלקער,</para>
  <para style="q" vid="PSA 7:9">משפּט מיך, ה׳, לױט מײַן גערעכטיקײט</para>
  <para style="q" vid="PSA 7:9">און לױט מײַן ערלעכקײט אין מיר.<verse eid="PSA 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 7:10" /> זאָל שױן זיך עקן דאָס בײז פֿון די רשעים,</para>
  <para style="q" vid="PSA 7:10">און דו זאָלסט אױפֿריכטן דעם צדיק;</para>
  <para style="q" vid="PSA 7:10">װאָרעם דו פּרוּװסט די הערצער און נירן, אלֹקים דו גערעכטער.<verse eid="PSA 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 7:11" /> מײַן באַשיץ איז אױף אלֹקים;</para>
  <para style="q" vid="PSA 7:11">ער העלפֿט די רעכטפֿאַרטיקע הערצער.<verse eid="PSA 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 7:12" /> אלֹקים איז אַ גערעכטער ריכטער,</para>
  <para style="q" vid="PSA 7:12">און אַ צערנדיקער אֵל אַלע טאָג.<verse eid="PSA 7:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 7:13" /> פֿאַר װאָר, ער שלײַפֿט נאָכאַנאַנד זײַן שװערד,</para>
  <para style="q" vid="PSA 7:13">ער שפּאַנט זײַן בױגן און שטעלט אים אָן.<verse eid="PSA 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 7:14" /> און ער גרײט זיך אָן געצײַג פֿון טױט,</para>
  <para style="q" vid="PSA 7:14">ער מאַכט ברענעדיק שאַרף זײַנע פֿײַלן.<verse eid="PSA 7:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 7:15" /> זע, ער אַנטפֿאַנגט אומרעכט,</para>
  <para style="q" vid="PSA 7:15">און ער טראָגט אומגליק, און געבערט ליגן.<verse eid="PSA 7:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 7:16" /> ער גראָבט אַ גרוב און הױלט זי אױס,</para>
  <para style="q" vid="PSA 7:16">און פֿאַלט אין דעם אָפּגרונט װאָס ער מאַכט,<verse eid="PSA 7:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 7:17" /> זײַן אומרעכט װעט זיך אומקערן אױף זײַן קאָפּ,</para>
  <para style="q" vid="PSA 7:17">און אױף זײַן שאַרבן װעט נידערן זײַן פֿאַרברעך.<verse eid="PSA 7:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 7:18" /> איך װעל לױבן ה׳ לױט זײַן גערעכטיקײט,</para>
  <para style="q" vid="PSA 7:18">און באַזינגען דעם נאָמען פֿון ה׳ דעם עליון.<verse eid="PSA 7:18" /></para>
  <chapter eid="PSA 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="PSA 8" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 8:1" />פֿאַר דעם געזאַנגמײַסטער, אױף גִתּית; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 8:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 8:2" /> ה׳ אונדזער האַר,</para>
  <para style="q" vid="PSA 8:2">װי פּראַכטיק איז דײַן נאָמען אױף דער גאַנצער ערד,</para>
  <para style="q" vid="PSA 8:2">אַז דער לױב פֿון דײַן גלאַנץ איז איבער די הימלען!<verse eid="PSA 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 8:3" /> פֿון דעם מױל פֿון עופֿעלעך און זױגעדיקע</para>
  <para style="q" vid="PSA 8:3">האָסטו באַפֿעסטיקט דײַן מאַכט;</para>
  <para style="q" vid="PSA 8:3">פֿון װעגן דײַנע פֿײַנט –</para>
  <para style="q" vid="PSA 8:3">כּדי שטיל צו מאַכן דעם שׂונא און ראַכענעמער.<verse eid="PSA 8:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 8:4" /> אַז איך זע די הימלען, דאָס װערק פֿון דײַנע פֿינגער,</para>
  <para style="q" vid="PSA 8:4">די לבֿנה און שטערן װאָס דו האָסט אױפֿגעשטעלט –<verse eid="PSA 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 8:5" /> װאָס איז אַ מענטש, אַז דו זאָלסט אים געדענקען?</para>
  <para style="q" vid="PSA 8:5">און אַ מענטשנקינד, אַז דו זאָלסט אים דערמאָנען?<verse eid="PSA 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 8:6" /> װאָרעם האָסט אים געמאַכט שיר נישט מינער פֿון אלֹקים,</para>
  <para style="q" vid="PSA 8:6">און מיט כּבֿוד און שײנקײט באַקרײנסטו אים.<verse eid="PSA 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 8:7" /> מאַכסט אים געװעלטיקן איבער די װערק פֿון דײַנע הענט,</para>
  <para style="q" vid="PSA 8:7">אַלצדינג האָסטו געלײגט אונטער זײַנע פֿיס;<verse eid="PSA 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 8:8" /> שאָף און רינדער אַלע,</para>
  <para style="q" vid="PSA 8:8">און אַפֿילו חיות פֿון פֿעלד;<verse eid="PSA 8:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 8:9" /> דעם פֿױגל פֿון הימל, און די פֿישן פֿון ים –</para>
  <para style="q" vid="PSA 8:9">װאָס נאָר עס ציט דורך די שטעגן פֿון ימען.<verse eid="PSA 8:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 8:10" /> ה׳ אונדזער האַר,</para>
  <para style="q" vid="PSA 8:10">װי פּראַכטיק איז דײַן נאָמען אױף דער גאַנצער ערד!<verse eid="PSA 8:10" /></para>
  <chapter eid="PSA 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="PSA 9" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 9:1" />פֿאַר דעם געזאַנגמײַסטער, אױף מות-לַבֵן; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 9:2" /> איך װעל לױבן ה׳ מיט מײַן גאַנצן האַרצן,</para>
  <para style="q" vid="PSA 9:2">איך װעל דערצײלן אַלע דײַנע װוּנדער.<verse eid="PSA 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 9:3" /> איך װעל זיך פֿרײען און לוסטיק זײַן מיט דיר,</para>
  <para style="q" vid="PSA 9:3">איך װעל באַזינגען דײַן נאָמען, דו עליון;<verse eid="PSA 9:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 9:4" /> װען מײַנע פֿײַנט קערן זיך אַהינטער,</para>
  <para style="q" vid="PSA 9:4">װערן געשטרױכלט און גײען אונטער פֿאַר דיר,<verse eid="PSA 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 9:5" /> װאָרעם האָסט געטאָן מײַן משפּט און מײַן רעכט,</para>
  <para style="q" vid="PSA 9:5">האָסט זיך געזעצט אױפֿן טראָן, דו ריכטער גערעכטער.<verse eid="PSA 9:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 9:6" /> האָסט אָנגעשריִען אױף די פֿעלקער,</para>
  <para style="q" vid="PSA 9:6">האָסט אונטערגעבראַכט דעם רשע,</para>
  <para style="q" vid="PSA 9:6">זײער נאָמען האָסטו אױסגעמעקט אױף אײביק און שטענדיק.<verse eid="PSA 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 9:7" /> דו פֿײַנט, פֿאַרלענדט זײַנען די חורבֿות אױף תּמיד;</para>
  <para style="q" vid="PSA 9:7">און שטעט האָסטו אױסגעריסן,</para>
  <para style="q" vid="PSA 9:7">זײער זָכר איז אונטערגעגאַנגען,<verse eid="PSA 9:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 9:8" /> אָבער ה׳ װעט אײביק בלײַבן,</para>
  <para style="q" vid="PSA 9:8">ער שטעלט אױף צום משפּט זײַן טראָן;<verse eid="PSA 9:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 9:9" /> און ער װעט משפּטן די װעלט מיט גערעכטיקײט,</para>
  <para style="q" vid="PSA 9:9">ער װעט דָן זײַן די פֿעלקער מיט יושר.<verse eid="PSA 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 9:10" /> און ה׳ װעט זײַן אַ פֿעסטונג דעם געדריקטן,</para>
  <para style="q" vid="PSA 9:10">אַ פֿעסטונג אין צײַטן פֿון נױט.<verse eid="PSA 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 9:11" /> און פֿאַרזיכערן װעלן זיך אױף דיר די װאָס קענען דײַן נאָמען,</para>
  <para style="q" vid="PSA 9:11">װאָרעם דו פֿאַרלאָזט נישט די װאָס זוכן דיך, ה׳.<verse eid="PSA 9:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 9:12" /> זינגט צו ה׳, באַװױנער פֿון צִיוֹן,</para>
  <para style="q" vid="PSA 9:12">דערצײלט צװישן די פֿעלקער זײַנע מעשׂים.<verse eid="PSA 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 9:13" /> װאָרעם דער אױפֿמאָנער פֿון בלוט געדענקט זײ,</para>
  <para style="q" vid="PSA 9:13">ער פֿאַרגעסט נישט דאָס געשרײ פֿון די פֿאַרליטענע.<verse eid="PSA 9:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 9:14" /> לײַטזעליק מיך, ה׳,</para>
  <para style="q" vid="PSA 9:14">זע מײַן פּײַן פֿון מײַנע פֿײַנט,</para>
  <para style="q" vid="PSA 9:14">מײַן דערהײבער פֿון די טױערן פֿון טױט;<verse eid="PSA 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 9:15" /> כּדי איך זאָל דערצײלן אַל דײַן לױב,</para>
  <para style="q" vid="PSA 9:15">אין די טױערן פֿון טאָכטער צִיוֹן מיך פֿרײען מיט דײַן הילף.<verse eid="PSA 9:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 9:16" /> אײַנגעזונקען זײַנען די פֿעלקער,</para>
  <para style="q" vid="PSA 9:16">אין דער גרוב װאָס זײ האָבן געמאַכט,</para>
  <para style="q" vid="PSA 9:16">אין דער נעץ װאָס זײ האָבן באַהאַלטן</para>
  <para style="q" vid="PSA 9:16">איז באַצװוּנגען זײער פֿוס.<verse eid="PSA 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 9:17" /> ה׳ איז באַװוּסט געװאָרן, ער האָט אַ משפּט געטאָן –</para>
  <para style="q" vid="PSA 9:17">אין דעם װערק פֿון זײַנע הענט איז געשטרױכלט געװאָרן דער רשע.</para>
  <para style="q" vid="PSA 9:17">הִגָיון סֶלָה.<verse eid="PSA 9:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 9:18" /> די רשעים װעלן אָנקומען אין שְׁאֹול –</para>
  <para style="q" vid="PSA 9:18">אַלע פֿעלקער װאָס פֿאַרגעסן אָן אלֹקים.<verse eid="PSA 9:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 9:19" /> װאָרעם נישט שטענדיק װעט פֿאַרגעסן זײַן דער אבֿיון,</para>
  <para style="q" vid="PSA 9:19">די האָפֿענונג פֿון די אָרימע װעט נישט פֿאַרלאָרן זײַן אױף אײביק.<verse eid="PSA 9:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 9:20" /> שטײ אױף, ה׳, זאָל דער מענטש נישט פֿאַרשײַט זײַן,</para>
  <para style="q" vid="PSA 9:20">זאָלן געמשפּט װערן די פֿעלקער פֿאַר דיר.<verse eid="PSA 9:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 9:21" /> טו, ה׳, אַ מורא אױף זײ;</para>
  <para style="q" vid="PSA 9:21">זאָלן װיסן די פֿעלקער אַז זײ זײַנען נאָר מענטשן.</para>
  <para style="q" vid="PSA 9:21">סֶלָה.<verse eid="PSA 9:21" /></para>
  <chapter eid="PSA 9" />
  <chapter number="10" style="c" pubnumber="י" sid="PSA 10" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 10:1" />פֿאַר װאָס, ה׳, שטײסטו פֿון דער װײַטן,</para>
  <para style="q" vid="PSA 10:1">פֿאַרהױלסטו זיך אין צײַטן פֿון נױט?<verse eid="PSA 10:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 10:2" />מיט גאװה פֿון רשע יאָגט מען דעם אָרעמאַן;</para>
  <para style="q" vid="PSA 10:2">זאָלן זײ געכאַפּט װערן אין די פּלענער װאָס זײ האָבן אױסגעקלערט!<verse eid="PSA 10:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 10:3" />װאָרעם דער רשע פּראָלט אין דער תּאװה פֿון זײַן זעל,</para>
  <para style="q" vid="PSA 10:3">און דער גײציקער רימט זיך: ער שפּאָט פֿון ה׳.<verse eid="PSA 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 10:4" />דער רשע זאָגט אין דעם שטאָלץ פֿון זײַן פּנים: מע מאָנט נישט;</para>
  <para style="q" vid="PSA 10:4">נישטאָ קײן אלֹקים, זײַנען אַלע זײַנע טראַכטונגען.<verse eid="PSA 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 10:5" />זײַנע װעגן באַגליקן צו יעטװעדער צײַט,</para>
  <para style="q" vid="PSA 10:5">װײַט איבער אים זײַנען דײַנע משפּטים;</para>
  <para style="q" vid="PSA 10:5">אַלע זײַנע פֿײַנט – ער בלאָזט אױף זײ.<verse eid="PSA 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 10:6" />ער זאָגט אין זײַן האַרצן: איך װעל נישט אומפֿאַלן,</para>
  <para style="q" vid="PSA 10:6">אױף דור-דורות נישט זײַן אין קײן בײז.<verse eid="PSA 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 10:7" />מיט קללות איז פֿול זײַן מױל, און מיט באַטרוג און דריקונג,</para>
  <para style="q" vid="PSA 10:7">אונטער זײַן צונג איז אומרעכט און פֿאַרברעכן.<verse eid="PSA 10:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 10:8" />ער זיצט אין לױער פֿון די געהעפֿטן,</para>
  <para style="q" vid="PSA 10:8">אין פֿאַרבאָרגענישן הרגעט ער דעם אומשולדיקן;</para>
  <para style="q" vid="PSA 10:8">זײַנע אױגן לאָקערן אױפֿן אומגליקלעכן.<verse eid="PSA 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 10:9" />ער לױערט אין פֿאַרבאָרגעניש װי אַ לײב אין זײַן צודעק,</para>
  <para style="q" vid="PSA 10:9">ער לױערט צו כאַפּן דעם אָרעמאַן;</para>
  <para style="q" vid="PSA 10:9">ער כאַפּט דעם אָרעמאַן, אַז ער ציט אים אין זײַן נעץ.<verse eid="PSA 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 10:10" />ער דריקט זיך, ער בײגט זיך,</para>
  <para style="q" vid="PSA 10:10">ביז די אומגליקלעכע פֿאַלן אין זײַנע קלױען.<verse eid="PSA 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 10:11" />ער זאָגט אין זײַן האַרצן: פֿאַרגעסן האָט אֵל;</para>
  <para style="q" vid="PSA 10:11">ער האָט פֿאַרבאָרגן זײַן פּנים, ער װעט אױף אײביק נישט זען.<verse eid="PSA 10:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 10:12" />שטײ אױף ה׳, אֵל, הײב אױף דײַן האַנט,</para>
  <para style="q" vid="PSA 10:12">זאָלסט נישט פֿאַרגעסן די געדריקטע.<verse eid="PSA 10:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 10:13" />פֿאַר װאָס לעסטערט דער רשע אלֹקים,</para>
  <para style="q" vid="PSA 10:13">זאָגט אין זײַן האַרצן: דו מאָנסט נישט?<verse eid="PSA 10:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 10:14" />דו האָסט געזען; װאָרעם דו קוקסט צו לײַד און קומער,</para>
  <para style="q" vid="PSA 10:14">כּדי זײ צו פֿאַרגלעטן מיט דײַן האַנט.</para>
  <para style="q" vid="PSA 10:14">אױף דיר פֿאַרלאָזט זיך דער אומגליקלעכער,</para>
  <para style="q" vid="PSA 10:14">דעם עלנדן ביסט דו געװען אַ העלפֿער.<verse eid="PSA 10:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 10:15" />צעברעך דעם אָרעם פֿון דעם רשע,</para>
  <para style="q" vid="PSA 10:15">און בײַם שלעכטן זאָלסטו זוכן זײַן בײז</para>
  <para style="q" vid="PSA 10:15">ביז װעסט מער נישט געפֿינען.<verse eid="PSA 10:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 10:16" />ה׳ איז אַ מלך אײביק און שטענדיק,</para>
  <para style="q" vid="PSA 10:16">די פֿעלקער גײען אונטער פֿון זײַן לאַנד.<verse eid="PSA 10:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 10:17" />דאָס קרעכצן פֿון די פֿאַרליטענע האָסטו צוגעהערט, ה׳;</para>
  <para style="q" vid="PSA 10:17">פֿעסטיקסט זײער האַרץ, נײַגסט צו דײַן אױער;<verse eid="PSA 10:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 10:18" />צו טאָן רעכט דעם יתום און דעם געדריקטן;</para>
  <para style="q" vid="PSA 10:18">אַז קײן מענטש פֿון דער ערד זאָל מער נישט שרעקן.<verse eid="PSA 10:18" /></para>
  <chapter eid="PSA 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="PSA 11" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 11:1" />פֿאַר דעם געזאַנגמײַסטער, פֿון דָוִדן.</para>
  <para style="q" vid="PSA 11:1">
    <char style="va">1</char>אין ה׳ טו איך מיך שיצן;</para>
  <para style="q" vid="PSA 11:1">װי קענט איר זאָגן צו מײַן זעל:</para>
  <para style="q" vid="PSA 11:1">אַנטלױף! צו אײַער באַרג, איר פֿױגלען?<verse eid="PSA 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 11:2" />װאָרעם זע, די רשעים שפּאַנען דעם בױגן,</para>
  <para style="q" vid="PSA 11:2">זײ האָבן אָנגעשטעלט זײער פֿײַל אױפֿן שטריקל,</para>
  <para style="q" vid="PSA 11:2">צו שיסן אין דער פֿינצטער די רעכטפֿאַרטיקע הערצער<verse eid="PSA 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 11:3" />אַז די גרונטזײַלן װערן צעשטערט,</para>
  <para style="q" vid="PSA 11:3">װאָס קענען די צדיקים טאָן?<verse eid="PSA 11:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 11:4" />ה׳ איז אין זײַן הײליקן הֵיכל,</para>
  <para style="q" vid="PSA 11:4">ה׳ – זײַן טראָן איז אין הימל;</para>
  <para style="q" vid="PSA 11:4">זײַנע אױגן זעען,</para>
  <para style="q" vid="PSA 11:4">זײַנע ברעמען פּרוּװן די מענטשנקינדער.<verse eid="PSA 11:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 11:5" />ה׳ פּרוּװט דעם צדיק,</para>
  <para style="q" vid="PSA 11:5">אָבער דער רשע און דעם װאָס האָט ליב רױב,</para>
  <para style="q" vid="PSA 11:5">האָט פֿײַנט זײַן זעל.<verse eid="PSA 11:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 11:6" />ער װעט מאַכן רעגענען אױף די רשעים</para>
  <para style="q" vid="PSA 11:6">קױלן, פֿײַער, און שװעבל;</para>
  <para style="q" vid="PSA 11:6">און אַ ברענעדיקער װינט</para>
  <para style="q" vid="PSA 11:6">איז זײער צוגעטײלטער כָּוס.<verse eid="PSA 11:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 11:7" />װאָרעם גערעכט איז ה׳, די רעכטפֿאַרטיקע װעלן זען זײַן פּנים.<verse eid="PSA 11:7" /></para>
  <chapter eid="PSA 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="PSA 12" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 12:1" />פֿאַר דעם געזאַנגמײַסטער, אױף שמינית; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 12:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 12:2" /> העלף, ה׳, װאָרעם געענדיקט האָבן זיך די פֿרומע,</para>
  <para style="q" vid="PSA 12:2">װאָרעם אױסגעגאַנגען זײַנען די געטרײַע פֿון די מענטשנקינדער.<verse eid="PSA 12:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 12:3" /> פֿאַלש רעדן זײ אײנער מיטן אַנדערן,</para>
  <para style="q" vid="PSA 12:3">מיט אַ גלאַטער ליפּ, מיט אַ צװײיִקן האַרצן רעדן זײ.<verse eid="PSA 12:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 12:4" /> ה׳ זאָל פֿאַרשנײַדן אַלע גלאַטע ליפּן,</para>
  <para style="q" vid="PSA 12:4">די צונג װאָס רעדט גרױס!<verse eid="PSA 12:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 12:5" /> די װאָס זאָגן: מיט אונדזער צונג זײַנען מיר שטאַרק,</para>
  <para style="q" vid="PSA 12:5">אונדזערע ליפּן זײַנען מיט אונדז, װער איז אונדז אַ האַר?<verse eid="PSA 12:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 12:6" /> פֿון װעגן דער באַרױבונג פֿון די אָרימע,</para>
  <para style="q" vid="PSA 12:6">פֿון װעגן דעם קרעכצן פֿון די באַדערפֿטיקע,</para>
  <para style="q" vid="PSA 12:6">אַצונד װעל איך אױפֿשטײן, זאָגט ה׳;</para>
  <para style="q" vid="PSA 12:6">איך װעל באַשערן מיט הילף דעם װאָס מע בלאָזט אױף אים.<verse eid="PSA 12:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 12:7" /> די װערטער פֿון ה׳ זײַנען רײנע װערטער,</para>
  <para style="q" vid="PSA 12:7">זילבער געשמאָלצן אין אַ טיגל אױף דער ערד,</para>
  <para style="q" vid="PSA 12:7">זיבן מאָל געלײַטערט.<verse eid="PSA 12:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 12:8" /> דו ה׳ װעסט זײ היטן,</para>
  <para style="q" vid="PSA 12:8">װעסט זײ אײביק באַהיטן פֿון דאָזיקן דור.<verse eid="PSA 12:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 12:9" /> אומעטום גײען אום די רשעים,</para>
  <para style="q" vid="PSA 12:9">װען געמײנקײט װערט דערהױבן בײַ די מענטשנקינדער.<verse eid="PSA 12:9" /></para>
  <chapter eid="PSA 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="PSA 13" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 13:1" />פֿאַר דעם געזאַנגמײַסטער; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 13:2" /> ביז װאַנען, ה׳, װעסטו מיך תּמיד פֿאַרגעסן?</para>
  <para style="q" vid="PSA 13:2">ביז װאַנען װעסטו פֿאַרבאָרגן דײַן פּנים פֿון מיר?<verse eid="PSA 13:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 13:3" /> ביז װאַנען װעל איך האַלטן עצות בײַ זיך,</para>
  <para style="q" vid="PSA 13:3">מיט קומער אין מײַן האַרצן דורכן טאָג?</para>
  <para style="q" vid="PSA 13:3">ביז װאַנען װעט מײַן פֿײַנט זיך דערהײבן אױף מיר?<verse eid="PSA 13:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 13:4" /> קוק-צו, ענטפֿער מיר, ה׳ מײַן ג-ט,</para>
  <para style="q" vid="PSA 13:4">דערלײַכט מײַנע אױגן, איך זאָל נישט אײַנשלאָפֿן צום טױט;<verse eid="PSA 13:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 13:5" /> מײַן פֿײַנט זאָל נישט זאָגן:</para>
  <para style="q" vid="PSA 13:5">איך בין אים בײַגעקומען;</para>
  <para style="q" vid="PSA 13:5">מײַנע שָׂונאים זאָלן זיך נישט פֿרײען,</para>
  <para style="q" vid="PSA 13:5">אַז איך װעל אומפֿאַלן.<verse eid="PSA 13:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 13:6" /> אָבער איך פֿאַרזיכער מיך אױף דײַן חֶסֶד;</para>
  <para style="q" vid="PSA 13:6">מײַן האַרץ װעט זיך פֿרײען מיט דײַן הילף;</para>
  <para style="q" vid="PSA 13:6">
    <char style="va">6</char> איך װעל זינגען צו ה׳,</para>
  <para style="q" vid="PSA 13:6">װאָס ער האָט מיר גוטס געטאָן.<verse eid="PSA 13:6" /></para>
  <chapter eid="PSA 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="PSA 14" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 14:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון דָוִדן.</para>
  <para style="q" vid="PSA 14:1">
    <char style="va">1</char>דער נאַר זאָגט אין זײַן האַרצן: נישטאָ קײן אלֹקים!</para>
  <para style="q" vid="PSA 14:1">פֿאַרדאָרבן זײַנען זײ, אומװערדיק באַגײען זײ זיך,</para>
  <para style="q" vid="PSA 14:1">קײנער טוט נישט קײן גוטס.<verse eid="PSA 14:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 14:2" />ה׳ האָט פֿון הימל געלוגט אױף די מענטשנקינדער,</para>
  <para style="q" vid="PSA 14:2">צו זען אױב פֿאַראַן אַ פֿאַרשטאַנדיקער װאָס זוכט אלֹקים.<verse eid="PSA 14:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 14:3" />איטלעכער איז אָפּגעקערט, אַלע זײַנען זײ פֿאַרדאָרבן,</para>
  <para style="q" vid="PSA 14:3">קײנער טוט נישט קײן גוטס, נישט צו מאָל אײנער.<verse eid="PSA 14:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 14:4" />פֿאַר װאָר, דערשפּירן װעלן אַלע טוער פֿון אומרעכט,</para>
  <para style="q" vid="PSA 14:4">די װאָס עסן מײַן פֿאָלק װי מע עסט ברױט,</para>
  <para style="q" vid="PSA 14:4">די װאָס רופֿן נישט ה׳.<verse eid="PSA 14:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 14:5" />אָן אַנגסטן זײ אין אַנגסט,</para>
  <para style="q" vid="PSA 14:5">װאָרעם אלֹקים איז מיט דעם גערעכטן דור.<verse eid="PSA 14:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 14:6" />די טראַכטונג פֿון אָרעמאַן מאַכט איר צו שאַנד,</para>
  <para style="q" vid="PSA 14:6">אָבער ה׳ איז זײַן באַשיצונג.<verse eid="PSA 14:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 14:7" />װען קומט פֿון צִיוֹן די ישועה פֿון יִשׂרָאֵל!</para>
  <para style="q" vid="PSA 14:7">װען ה׳ קערט אום די געפֿאַנגענשאַפֿט פֿון זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 14:7">װעט לוסטיק זײַן יעקבֿ, װעט זיך פֿרײען יִשׂרָאֵל.<verse eid="PSA 14:7" /></para>
  <chapter eid="PSA 14" />
  <chapter number="15" style="c" pubnumber="טו" sid="PSA 15" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 15:1" />אַ מיזמור פֿון דָוִדן.</para>
  <para style="q" vid="PSA 15:1">
    <char style="va">1</char> ה׳, װער קען װױנען אין דײַן געצעלט?</para>
  <para style="q" vid="PSA 15:1">װער קען רוען אױף דײַן הײליקן באַרג?<verse eid="PSA 15:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 15:2" />דער װאָס גײט ערלעך און טוט גערעכטיקײט,</para>
  <para style="q" vid="PSA 15:2">און רעדט אמת אין זײַן האַרצן;<verse eid="PSA 15:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 15:3" />נישט געטראָגן קײן רכילות אױף זײַן צונג,</para>
  <para style="q" vid="PSA 15:3">נישט געטאָן זײַן חבֿר קײן רָעה,</para>
  <para style="q" vid="PSA 15:3">און נישט טראָגן קײן שאַנד אױף זײַן נאָנטן;<verse eid="PSA 15:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 15:4" />דער ניבֿזה איז פֿאַראַכט אין זײַנע אױגן,</para>
  <para style="q" vid="PSA 15:4">און די יראי ה׳ גיט ער כּבֿוד;</para>
  <para style="q" vid="PSA 15:4">ער האָט געשװאָרן זיך צום בײזן, און ענדערט נישט;<verse eid="PSA 15:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 15:5" />זײַן געלט האָט ער נישט געגעבן אױף צינדזן,</para>
  <para style="q" vid="PSA 15:5">און שוחד קעגן אַן אומשולדיקן נישט גענומען;</para>
  <para style="b" vid="PSA 15:5" />
  <para style="q" vid="PSA 15:5">דער װאָס טוט דאָס װעט קײן מאָל נישט אומפֿאַלן.<verse eid="PSA 15:5" /></para>
  <chapter eid="PSA 15" />
  <chapter number="16" style="c" pubnumber="טז" sid="PSA 16" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 16:1" />אַ מִכתָּם פֿון דָוִדן.</para>
  <para style="q" vid="PSA 16:1">
    <char style="va">1</char> באַהיט מיך, אֵל,</para>
  <para style="q" vid="PSA 16:1">װאָרעם איך האָב מיך באַשיצט אין דיר.<verse eid="PSA 16:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 16:2" />האָסט געזאָגט צו ה׳: אֲדֹנָי ביסטו,</para>
  <para style="q" vid="PSA 16:2">מײַן גוטס איז בלױז בײַ דיר.<verse eid="PSA 16:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 16:3" />די הײליקע װאָס זײַנען אױף דער ערד,</para>
  <para style="q" vid="PSA 16:3">זײ זײַנען די פֿירשטן װאָס אַל מײַן באַגער איז צו זײ.<verse eid="PSA 16:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 16:4" />זאָלן מערן זײערע געצן די װאָס אײַלן צו אַן אַנדערן;</para>
  <para style="q" vid="PSA 16:4">איך װעל נישט גיסן זײערע גיסאָפּפֿער פֿון בלוט,</para>
  <para style="q" vid="PSA 16:4">און נישט נעמען זײערע נעמען אױף מײַנע ליפּן.<verse eid="PSA 16:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 16:5" />ה׳ איז מײַן באַשערטער טײל און מײַן בעכער;</para>
  <para style="q" vid="PSA 16:5">דו האַלטסט אױף מײַן גורל.<verse eid="PSA 16:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 16:6" />חלקים זײַנען מיר צוגעפֿאַלן ליבלעכע,</para>
  <para style="q" vid="PSA 16:6">יאָ, אַ שײנע נחלה איז מיר אָנגעקומען.<verse eid="PSA 16:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 16:7" />איך לױב ה׳, װאָס ער האָט מיר געראָטן,</para>
  <para style="q" vid="PSA 16:7">יאָ, אין די נעכט האָבן מיך מײַנע נירן געלערנט.<verse eid="PSA 16:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 16:8" />איך האַלט ה׳ פֿאַר מיר תּמיד,</para>
  <para style="q" vid="PSA 16:8">װאָרעם אַז ער איז בײַ מײַן רעכטער האַנט, װעל איך נישט אומפֿאַלן.<verse eid="PSA 16:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 16:9" />דערום איז פֿרײלעך מײַן האַרץ, און לוסטיק מײַן זעל,</para>
  <para style="q" vid="PSA 16:9">אױך מײַן לײַב רוט אין זיכערקײט.<verse eid="PSA 16:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 16:10" />װאָרעם דו װעסט נישט איבערלאָזן מײַן נפֿש אין דעס שְׁאֹול,</para>
  <para style="q" vid="PSA 16:10">דו װעסט נישט לאָזן דײַן חָסִיד</para>
  <para style="q" vid="PSA 16:10">זען די פֿאַרדאָרבנקײט.<verse eid="PSA 16:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 16:11" />װעסט מיך מאַכן װיסן דעם װעג פֿון לעבן;</para>
  <para style="q" vid="PSA 16:11">אַ זעטיקײט פֿון פֿרײדן איז פֿאַר דײַן פּנים,</para>
  <para style="q" vid="PSA 16:11">תּענוגים אין דײַן רעכטער האַנט אײביק.<verse eid="PSA 16:11" /></para>
  <chapter eid="PSA 16" />
  <chapter number="17" style="c" pubnumber="יז" sid="PSA 17" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 17:1" />אַ תּפֿילה פֿון דָוִדן.</para>
  <para style="q" vid="PSA 17:1">
    <char style="va">1</char> הער צו, ה׳, גערעכטיקײט,</para>
  <para style="q" vid="PSA 17:1">האָרך צו מײַן געשרײ,</para>
  <para style="q" vid="PSA 17:1">פֿאַרנעם מײַן תּפֿילה פֿון ליפּן אָן פֿאַלשקײט.<verse eid="PSA 17:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 17:2" />פֿון פֿאַר דיר זאָל מײַן משפּט אַרױסגײן,</para>
  <para style="q" vid="PSA 17:2">דײַנע אױגן זאָלן זען די ריכטיקײט.<verse eid="PSA 17:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 17:3" />האָסט געפּרוּװט מײַן האַרץ,</para>
  <para style="q" vid="PSA 17:3">האָסט נאָכגעזוכט בײַ נאַכט,</para>
  <para style="q" vid="PSA 17:3">האָסט מיך געלײַטערט, און נישט געפֿונען</para>
  <para style="q" vid="PSA 17:3">איך זאָל טראַכטן װאָס דאַרף נישט אַריבער מײַן מױל.<verse eid="PSA 17:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 17:4" />אין מעשׂים פֿון מענטשן,</para>
  <para style="q" vid="PSA 17:4">האָב איך, לױטן װאָרט פֿון דײַנע ליפּן,</para>
  <para style="q" vid="PSA 17:4">מיך געהיט פֿון די װעגן פֿון דעם פֿאַרשײַטן.<verse eid="PSA 17:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 17:5" />מײַנע טריט האָבן זיך געהאַלטן אָן דײַנע שטעגן,</para>
  <para style="q" vid="PSA 17:5">נישט אױסגעגליטשט האָבן זיך מײַנע פֿיס.<verse eid="PSA 17:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 17:6" />איך האָב דיך גערופֿן, װאָרעם דו װעסט מיר ענטפֿערן, אֵל;</para>
  <para style="q" vid="PSA 17:6">נײַג דײַן אױער צו מיר, הער צו מײַן װאָרט.<verse eid="PSA 17:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 17:7" />מאַך װוּנדערלעך דײַנע חסדים,</para>
  <para style="q" vid="PSA 17:7">דו װאָס העלפֿסט די װאָס שיצן זיך</para>
  <para style="q" vid="PSA 17:7">פֿון אָנפֿאַלער אין דײַן רעכטער האַנט.<verse eid="PSA 17:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 17:8" />היט מיך װי אַ שװאַרצאַפּל פֿון אױג,</para>
  <para style="q" vid="PSA 17:8">אין שאָטן פֿון דײַנע פֿליגלען זאָלסטו מיך פֿאַרבאָרגן<verse eid="PSA 17:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 17:9" />פֿון די רשעים װאָס באַרױבן מיך,</para>
  <para style="q" vid="PSA 17:9">מײַנע שָׂונאים אום לעבן װאָס רינגלען מיך אַרום.<verse eid="PSA 17:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 17:10" />זײער פֿעט האַרץ האָבן זײ פֿאַרשלאָסן,</para>
  <para style="q" vid="PSA 17:10">מיט זײער מױל רעדן זײ האָפֿערדיק.<verse eid="PSA 17:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 17:11" />אױף אונדזער טריט האָבן זײ אַצונד אונדז אַרומגערינגלט,</para>
  <para style="q" vid="PSA 17:11">זײערע אױגן שטעלן זײ אָן אונדז צו נײַגן צו דער ערד.<verse eid="PSA 17:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 17:12" />ער איז געגליכן צו אַ לײב װאָס גלוסט צו פֿאַרצוקן,</para>
  <para style="q" vid="PSA 17:12">און צו אַ יונגלײב װאָס זיצט אין פֿאַרבאָרגענישן.<verse eid="PSA 17:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 17:13" />שטײ אױף, ה׳, גײ אים אַקעגן, װאַרף אים אַנידער,</para>
  <para style="q" vid="PSA 17:13">מאַך אַנטרינען מײַן זעל פֿון דעם רשע מיט דײַן שװערד,<verse eid="PSA 17:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 17:14" />פֿון מענטשן, ה׳, מיט דײַן האַנט –</para>
  <para style="q" vid="PSA 17:14">פֿון מענטשן פֿון דער װעלט, װאָס זײער חלק איז בײַם לעבן,</para>
  <para style="q" vid="PSA 17:14">און מיט דײַן שאַץ פֿילסטו אָן זײער בױך;</para>
  <para style="q" vid="PSA 17:14">זאַט זײַנען זײערע קינדער,</para>
  <para style="q" vid="PSA 17:14">און זײ לאָזן זײער שפֿע צו זײערע יונגע.<verse eid="PSA 17:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 17:15" />איך אָבער װעל זען דײַן פּנים אין גערעכטיקײט,</para>
  <para style="q" vid="PSA 17:15">איך װעל מיך זעטן אױפֿן װאַכן אין דײַן געשטאַלט.<verse eid="PSA 17:15" /></para>
  <chapter eid="PSA 17" />
  <chapter number="18" style="c" pubnumber="יח" sid="PSA 18" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 18:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון דעם קנעכט פֿון ה׳, פֿון דָוִדן, װאָס האָט גערעדט צו ה׳ די װערטער פֿון דעם דאָזיקן געזאַנג אין דעם טאָג װאָס ה׳ האָט אים מציל געװען פֿון דער האַנט פֿון אַלע זײַנע פֿײַנט, און פֿון דער מאַכט פֿון שָאולן. <verse eid="PSA 18:1" /><verse number="2" style="v" sid="PSA 18:2" />און ער האָט געזאָגט:</para>
  <para style="q" vid="PSA 18:2">
    <char style="va">1</char> איך האָב דיך ליב, ה׳ מײַן שטאַרקײט;<verse eid="PSA 18:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 18:3" /> ה׳ איז מײַן פֿעלדז און מײַן פֿעסטונג,</para>
  <para style="q" vid="PSA 18:3">און דער װאָס מאַכט מיך אַנטרינען.</para>
  <para style="q" vid="PSA 18:3">מײַן אֵל איז מײַן פֿעלדז װאָס איך שיץ מיך אין אים,</para>
  <para style="q" vid="PSA 18:3">מײַן שילד און דער האָרן פֿון מײַן הילף, מײַן טורעם.<verse eid="PSA 18:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 18:4" /> איך רוף: ברוך ה׳!</para>
  <para style="q" vid="PSA 18:4">און פֿון מײַנע פֿײַנט װער איך געהאָלפֿן.<verse eid="PSA 18:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 18:5" /> אַרומגערינגלט האָבן מיך שטריק פֿון שְׁאֹול,</para>
  <para style="q" vid="PSA 18:5">און טײַכן פֿון אונטערגאַנג האָבן מיך געשראָקן.<verse eid="PSA 18:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 18:6" /> שטריק פֿון אונטערערד האָבן מיך אַרומגעקניפּט,</para>
  <para style="q" vid="PSA 18:6">אַקעגנגעקומען זײַנען מיר נעצן פֿון טױט.<verse eid="PSA 18:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 18:7" /> האָב איך אין מײַן נױט גערופֿן צו ה׳,</para>
  <para style="q" vid="PSA 18:7">און צו מײַן ג-ט האָב איך געשריִען;</para>
  <para style="q" vid="PSA 18:7">האָט ער געהערט פֿון זײַן הֵיכל מײַן קֹול,</para>
  <para style="q" vid="PSA 18:7">און מײַן געשרײ פֿאַר אים איז געקומען אין זײַנע אױערן.<verse eid="PSA 18:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 18:8" /> און געשאָקלט און געװאַקלט האָט זיך די ערד,</para>
  <para style="q" vid="PSA 18:8">און די גרונטפֿעסטן פֿון די בערג האָבן געציטערט;</para>
  <para style="q" vid="PSA 18:8">זיך געשאָקלט, װײַל ער האָט געצערנט.<verse eid="PSA 18:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 18:9" /> אַ רױך איז אױפֿגעגאַנגען אין זײַן נאָז,</para>
  <para style="q" vid="PSA 18:9">און פֿון זײַן מױל האָט אַ פֿײַער פֿאַרצערט;</para>
  <para style="q" vid="PSA 18:9">קױלן האָבן געברענט פֿון אים.<verse eid="PSA 18:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 18:10" /> און ער האָט גענײגט דעם הימל און גענידערט,</para>
  <para style="q" vid="PSA 18:10">מיט אַ נעבל אונטער זײַנע פֿיס.<verse eid="PSA 18:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 18:11" /> און ער איז געריטן אױף אַ כּרובֿ און געפֿלױגן,</para>
  <para style="q" vid="PSA 18:11">און געשװעבט אױף פֿליגלען פֿון װינט.<verse eid="PSA 18:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 18:12" /> ער האָט געמאַכט פֿינצטערניש זײַן באַהעלטעניש,</para>
  <para style="q" vid="PSA 18:12">זײַן בײַדל אַרום אים –</para>
  <para style="q" vid="PSA 18:12">אַ חושך פֿון װאַסערן, װאָלקנס געדיכטע.<verse eid="PSA 18:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 18:13" /> פֿון דעם שימער פֿאַר אים זײַנען זײַנע װאָלקנס צעגאַנגען</para>
  <para style="q" vid="PSA 18:13">אין האָגל און פֿײַערקױלן.<verse eid="PSA 18:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 18:14" /> און געדונערט אין הימל האָט ה׳,</para>
  <para style="q" vid="PSA 18:14">און דער עליון האָט אַרױסגעלאָזט זײַן קֹול,</para>
  <para style="q" vid="PSA 18:14">מיט האָגל און פֿײַערקױלן.<verse eid="PSA 18:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 18:15" /> און ער האָט אַרױסגעשיקט זײַנע פֿײַלן און זײ צעשפּרײט,</para>
  <para style="q" vid="PSA 18:15">און בליצן געשאָסן, און זײ פֿאַרטומלט.<verse eid="PSA 18:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 18:16" /> און די גראָבנס פֿון װאַסערן האָבן זיך באַװיזן,</para>
  <para style="q" vid="PSA 18:16">און די גרונטפֿעסטן פֿון דער װעלט זײַנען אַנטפּלעקט געװאָרן,</para>
  <para style="q" vid="PSA 18:16">פֿון דײַן אָנגעשרײ, ה׳,</para>
  <para style="q" vid="PSA 18:16">פֿון דעם אָטעמבלאָז פֿון דײַן נאָז.<verse eid="PSA 18:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 18:17" /> ער האָט אױסגעשטרעקט פֿון דער הײך און מיך גענומען,</para>
  <para style="q" vid="PSA 18:17">מיך אַרױסגעצױגן פֿון װאַסערן גרױסע.<verse eid="PSA 18:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 18:18" /> ער האָט מיך מציל געװען פֿון מײַן מאַכטיקן פֿײַנט,</para>
  <para style="q" vid="PSA 18:18">און פֿון מײַנע שָׂונאים,</para>
  <para style="q" vid="PSA 18:18">װען זײ זײַנען געװען שטאַרקער פֿון מיר.<verse eid="PSA 18:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 18:19" /> זײ זײַנען מיר אַקעגנגעקומען אין טאָג פֿון מײַן בראָך,</para>
  <para style="q" vid="PSA 18:19">אָבער ה׳ איז מיר צום אָנלען געװען.<verse eid="PSA 18:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 18:20" /> און ער האָט מיך אַרױסגעפֿירט אין דערברײטערניש,</para>
  <para style="q" vid="PSA 18:20">מיך אַרױסגעצױגן, װײַל ער האָט מיך באַגערט.<verse eid="PSA 18:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 18:21" /> ה׳ האָט מיר פֿאַרגאָלטן לױט מײַן גערעכטיקײט,</para>
  <para style="q" vid="PSA 18:21">לױט דער רײנקײט פֿון מײַנע הענט האָט ער מיר אומגעקערט.<verse eid="PSA 18:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 18:22" /> װאָרעם איך האָב געהיט די װעגן פֿון ה׳,</para>
  <para style="q" vid="PSA 18:22">און נישט פֿאַרבראָכן אַקעגן מײַן ג-ט.<verse eid="PSA 18:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 18:23" /> װאָרעם אַלע זײַנע געזעצן זײַנען פֿאַר מיר,</para>
  <para style="q" vid="PSA 18:23">און זײַנע חוקים טו איך נישט אָפּ פֿון מיר.<verse eid="PSA 18:23" /></para>
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 18:24" /> און איך בין געװען צו אים גאַנץ,</para>
  <para style="q" vid="PSA 18:24">און האָב מיך געהיט פֿון מײַן זינדיקײט.<verse eid="PSA 18:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 18:25" /> דערום האָט מיר ה׳ אומגעקערט לױט מײַן גערעכטיקײט,</para>
  <para style="q" vid="PSA 18:25">לױט דער רײנקײט פֿון מײַנע הענט פֿאַר זײַנע אױגן.<verse eid="PSA 18:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 18:26" /> מיט דעם גענאָדיקן װײַזטו זיך גענאָדיק,</para>
  <para style="q" vid="PSA 18:26">מיט דעם ערלעכן מאַן װײַזטו זיך ערלעך.<verse eid="PSA 18:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 18:27" /> מיט דעם רײנעם װײַזטו זיך רײן,</para>
  <para style="q" vid="PSA 18:27">און מיט דעם קרומען װײַזטו זיך פֿאַרדרײט.<verse eid="PSA 18:27" /></para>
  <para style="q">
    <verse number="28" style="v" altnumber="27" sid="PSA 18:28" /> װאָרעם דאָס אָרימע פֿאָלק טוסטו העלפֿן,</para>
  <para style="q" vid="PSA 18:28">און הױכע אױגן דערנידערסטו.<verse eid="PSA 18:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="28" sid="PSA 18:29" /> װאָרעם דו מאַכסט לײַכטן מײַן ליכט;</para>
  <para style="q" vid="PSA 18:29">ה׳ מײַן ג-ט באַשײַנט מײַן פֿינצטערניש.<verse eid="PSA 18:29" /></para>
  <para style="q">
    <verse number="30" style="v" altnumber="29" sid="PSA 18:30" /> װאָרעם מיט דיר לױף איך קעגן אַ מחנה,</para>
  <para style="q" vid="PSA 18:30">און מיט מײַן ג-ט שפּרינג איך אַ מױער אַריבער.<verse eid="PSA 18:30" /></para>
  <para style="q">
    <verse number="31" style="v" altnumber="30" sid="PSA 18:31" /> הָאֵל – זײַן װעג איז גאַנץ;</para>
  <para style="q" vid="PSA 18:31">דאָס װאָרט פֿון ה׳ איז געלײַטערט;</para>
  <para style="q" vid="PSA 18:31">ער איז אַ שילד פֿאַר אַלע װאָס שיצן זיך אין אים.<verse eid="PSA 18:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" altnumber="31" sid="PSA 18:32" /> װאָרעם װער איז אֱלוֹהַּ אױסער ה׳?</para>
  <para style="q" vid="PSA 18:32">און װער אַ פֿעלדז אַחוץ אלוקינו?<verse eid="PSA 18:32" /></para>
  <para style="q">
    <verse number="33" style="v" altnumber="32" sid="PSA 18:33" /> הָאֵל װאָס באַגורט מיך מיט שטאַרקײט,</para>
  <para style="q" vid="PSA 18:33">און מאַכט גלײַך מײַן װעג.<verse eid="PSA 18:33" /></para>
  <para style="q">
    <verse number="34" style="v" altnumber="33" sid="PSA 18:34" /> ער מאַכט מײַנע פֿיס גלײַך װי די הינדן,</para>
  <para style="q" vid="PSA 18:34">און אױף מײַנע הײכן טוט ער מיך שטעלן.<verse eid="PSA 18:34" /></para>
  <para style="q">
    <verse number="35" style="v" altnumber="34" sid="PSA 18:35" /> ער לערנט מײַנע הענט צו מלחמה,</para>
  <para style="q" vid="PSA 18:35">און אַ קופּערנעם בױגן בײגן אַראָפּ מײַנע אָרעמס.<verse eid="PSA 18:35" /></para>
  <para style="q">
    <verse number="36" style="v" altnumber="35" sid="PSA 18:36" /> און האָסט מיר געגעבן דעם שילד פֿון דײַן הילף,</para>
  <para style="q" vid="PSA 18:36">און דײַן רעכטע האַנט לענט מיך אונטער,</para>
  <para style="q" vid="PSA 18:36">און דײַן מילדקײט טוט מיך גרײסן.<verse eid="PSA 18:36" /></para>
  <para style="q">
    <verse number="37" style="v" altnumber="36" sid="PSA 18:37" /> האָסט דערברײטערט מײַן טריט אונטער מיר,</para>
  <para style="q" vid="PSA 18:37">און נישט אױסגעגליטשט האָבן זיך מײַנע קנעכלעך.<verse eid="PSA 18:37" /></para>
  <para style="q">
    <verse number="38" style="v" altnumber="37" sid="PSA 18:38" /> איך האָב געיאָגט מײַנע פֿײַנט און זײ דערגרײכט,</para>
  <para style="q" vid="PSA 18:38">און זיך נישט אומגעקערט ביז איך האָב זײ פֿאַרלענדט.<verse eid="PSA 18:38" /></para>
  <para style="q">
    <verse number="39" style="v" altnumber="38" sid="PSA 18:39" /> איך האָב זײ צעהאַקט, אַז זײ קענען נישט אױפֿשטײן;</para>
  <para style="q" vid="PSA 18:39">זײ זײַנען געפֿאַלן אונטער מײַנע פֿיס.<verse eid="PSA 18:39" /></para>
  <para style="q">
    <verse number="40" style="v" altnumber="39" sid="PSA 18:40" /> און האָסט מיך באַגורט מיט שטאַרקײט פֿאַר מלחמה,</para>
  <para style="q" vid="PSA 18:40">האָסט געבײגט מײַנע קעגנשטײער אונטער מיר.<verse eid="PSA 18:40" /></para>
  <para style="q">
    <verse number="41" style="v" altnumber="40" sid="PSA 18:41" /> און מײַנע פֿײַנט האָסטו געמאַכט מיטן נאַקן צו מיר,</para>
  <para style="q" vid="PSA 18:41">און מײַנע שָׂונאים, זײ האָב איך פֿאַרשניטן.<verse eid="PSA 18:41" /></para>
  <para style="q">
    <verse number="42" style="v" altnumber="41" sid="PSA 18:42" /> זײ האָבן געשריִען, און קײן העלפֿער איז נישט געװען,</para>
  <para style="q" vid="PSA 18:42">צו ה׳ – און ער האָט זײ נישט געענטפֿערט.<verse eid="PSA 18:42" /></para>
  <para style="q">
    <verse number="43" style="v" altnumber="42" sid="PSA 18:43" /> און איך האָב זײ צעריבן װי שטױב פֿאַרן װינט,</para>
  <para style="q" vid="PSA 18:43">װי גאַסנקױט זײ אַרױסגעװאָרפֿן.<verse eid="PSA 18:43" /></para>
  <para style="b" />
  <para style="q">
    <verse number="44" style="v" altnumber="43" sid="PSA 18:44" /> האָסט מיך געמאַכט אַנטרינען פֿון די קריג פֿון פֿאָלק,</para>
  <para style="q" vid="PSA 18:44">האָסט מיך געמאַכט פֿאַר דעם קאָפּ פֿון די אומות;</para>
  <para style="q" vid="PSA 18:44">אַ פֿאָלק װאָס איך קען נישט טוט מיר דינען,<verse eid="PSA 18:44" /></para>
  <para style="q">
    <verse number="45" style="v" altnumber="44" sid="PSA 18:45" /> פֿון הערן מיטן אױער געהאָרכן זײ מיר;</para>
  <para style="q" vid="PSA 18:45">די קינדער פֿון פֿרעמדן גײען אײַן פֿאַר מיר.<verse eid="PSA 18:45" /></para>
  <para style="q">
    <verse number="46" style="v" altnumber="45" sid="PSA 18:46" />די קינדער פֿון דעם פֿרעמדן װערן פֿאַרװעלקט,</para>
  <para style="q" vid="PSA 18:46">און זײ קומען ציטערנדיק אַרױס פֿון זײערע פֿעסטונגען.<verse eid="PSA 18:46" /></para>
  <para style="b" />
  <para style="q">
    <verse number="47" style="v" altnumber="46" sid="PSA 18:47" />עס לעבט ה׳, און געלױבט איז מײַן פֿעלדז,</para>
  <para style="q" vid="PSA 18:47">און דערהױבן איז דער אלֹקים פֿון מײַן הילף;<verse eid="PSA 18:47" /></para>
  <para style="q">
    <verse number="48" style="v" altnumber="47" sid="PSA 18:48" /> הָאֵל װאָס גיט מיר נקמות</para>
  <para style="q" vid="PSA 18:48">און אונטערטעניקט די אומות אונטער מיר.<verse eid="PSA 18:48" /></para>
  <para style="q">
    <verse number="49" style="v" altnumber="48" sid="PSA 18:49" /> ער מאַכט מיך אַנטרינען פֿון מײַנע פֿײַנט;</para>
  <para style="q" vid="PSA 18:49">יאָ, איבער מײַנע קעגנשטײער דערהײבסטו מיך,</para>
  <para style="q" vid="PSA 18:49">פֿון דעם רױבמענטשן ביסטו מיך מציל.<verse eid="PSA 18:49" /></para>
  <para style="q">
    <verse number="50" style="v" altnumber="49" sid="PSA 18:50" /> דערום לױב איך דיך, ה׳, צװישן די פֿעלקער,</para>
  <para style="q" vid="PSA 18:50">און צו דײַן נאָמען טו איך זינגען.<verse eid="PSA 18:50" /></para>
  <para style="q">
    <verse number="51" style="v" altnumber="50" sid="PSA 18:51" /> ער גרײסט די ישועות פֿון זײַן מלך,</para>
  <para style="q" vid="PSA 18:51">און ער טוט חֶסֶד מיט זײַן געזאַלבטן,</para>
  <para style="q" vid="PSA 18:51">מיט דָוִדן און מיט זײַן זאָמען ביז אײביק.<verse eid="PSA 18:51" /></para>
  <chapter eid="PSA 18" />
  <chapter number="19" style="c" pubnumber="יט" sid="PSA 19" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 19:1" />פֿאַר דעם געזאַנגמײַסטער; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 19:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 19:2" /> די הימלען דערצײלן דעם כּבֿוד פֿון אֵל,</para>
  <para style="q" vid="PSA 19:2">און די װערק פֿון זײַנע הענט זאָגט דער הימלװעלב אָן.<verse eid="PSA 19:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 19:3" /> אַ טאָג צו אַ טאָג רעדט אַ װאָרט,</para>
  <para style="q" vid="PSA 19:3">און אַ נאַכט צו אַ נאַכט גיט צו װיסן,<verse eid="PSA 19:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 19:4" /> נישטאָ אַ װאָרט און נישטאָ קײן געשעענישן,</para>
  <para style="q" vid="PSA 19:4">װוּ זײער װידער-קֹול װערט נישט געהערט;<verse eid="PSA 19:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 19:5" /> איבער דער גאַנצער ערד גײט אַרױס זײער קלאַנג,</para>
  <para style="q" vid="PSA 19:5">און ביז עק װעלט זײערע רײד.</para>
  <para style="q" vid="PSA 19:5">פֿאַר דער זון האָט ער געמאַכט אַ געצעלט אין זײ;<verse eid="PSA 19:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 19:6" /> און ער גײט אַרױס װי אַ חתן פֿון זײַן קאַמער.</para>
  <para style="q" vid="PSA 19:6">ער פֿרײט זיך װי אַ גיבור צו לױפֿן דעם װעג.<verse eid="PSA 19:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 19:7" /> פֿון עק פֿון די הימלען איז זײַן אױסגאַנג,</para>
  <para style="q" vid="PSA 19:7">און זײַן אַרומדרײ איז ביז זײערע עקן,</para>
  <para style="q" vid="PSA 19:7">און נישטאָ קײן פֿאַרבאָרגנס פֿון זײַן היץ.<verse eid="PSA 19:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 19:8" /> די תּורה פֿון ה׳ איז גאַנץ,</para>
  <para style="q" vid="PSA 19:8">זי באַקערט די נשמה;</para>
  <para style="q" vid="PSA 19:8">דער צײגנים פֿון ה׳ איז זיכער,</para>
  <para style="q" vid="PSA 19:8">ער מאַכט קלוג דעם נאַרן.<verse eid="PSA 19:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 19:9" /> די באַפֿעלן פֿון ה׳ זײַנען רעכטפֿאַרטיק,</para>
  <para style="q" vid="PSA 19:9">זײ דערפֿרײען דאָס האַרץ;</para>
  <para style="q" vid="PSA 19:9">דאָס געבאָט פֿון ה׳ איז לױטער,</para>
  <para style="q" vid="PSA 19:9">עס מאַכט ליכטיק די אױגן.<verse eid="PSA 19:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 19:10" /> די מורא פֿאַר ה׳ איז רײן,</para>
  <para style="q" vid="PSA 19:10">זי באַשטײט אױף אײביק;</para>
  <para style="q" vid="PSA 19:10">די משפּטים פֿון ה׳ זײַנען אמת,</para>
  <para style="q" vid="PSA 19:10">זײ זײַנען אַלע גערעכט;<verse eid="PSA 19:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 19:11" /> זײ זײַנען גלוסטיקער פֿון גאָלד,</para>
  <para style="q" vid="PSA 19:11">און פֿון גינגאָלד אַ סך,</para>
  <para style="q" vid="PSA 19:11">און זיסער פֿון האָניק, און טריפֿהאָניק.<verse eid="PSA 19:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 19:12" /> אױך דײַן קנעכט װערט געװאָרנט אין זײ;</para>
  <para style="q" vid="PSA 19:12">אין היטן זײ איז גרױס שׂכַר פֿאַראַן.<verse eid="PSA 19:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 19:13" /> פֿאַרזעען װער קען מערקן?</para>
  <para style="q" vid="PSA 19:13">פֿון פֿאַרבאָרגענע טו מיך רײניקן.<verse eid="PSA 19:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 19:14" /> אױך פֿאַרמײַד דײַן קנעכט פֿון מוטװיליקע,</para>
  <para style="q" vid="PSA 19:14">זײ זאָלן נישט געװעלטיקן איבער מיר;</para>
  <para style="q" vid="PSA 19:14">דענצמאָל װעל איך גאַנץ זײַן,</para>
  <para style="q" vid="PSA 19:14">און װעל רײן זײַן פֿון פֿאַרברעך אַ סך.<verse eid="PSA 19:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 19:15" /> זאָלן זײַן צו באַװיליקונג די װערטער פֿון מײַן מױל,</para>
  <para style="q" vid="PSA 19:15">און די טראַכטונג פֿון מײַן האַרצן פֿאַר דיר,</para>
  <para style="q" vid="PSA 19:15">ה׳ מײַן פֿעלדז, און מײַן דערלײזער.<verse eid="PSA 19:15" /></para>
  <chapter eid="PSA 19" />
  <chapter number="20" style="c" pubnumber="כ" sid="PSA 20" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 20:1" />פֿאַר דעם געזאַנגמײַסטער; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 20:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 20:2" /> ה׳ װעט דיר ענטפֿערן אין טאָג פֿון נױט,</para>
  <para style="q" vid="PSA 20:2">דיך װעט שטאַרקן דער נאָמען פֿון אלוקי יעקבֿ.<verse eid="PSA 20:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 20:3" /> ער װעט שיקן דײַן הילף פֿון הײליקטום,</para>
  <para style="q" vid="PSA 20:3">און פֿון צִיוֹן װעט ער דיך אונטערלענען.<verse eid="PSA 20:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 20:4" /> ער װעט אַכטן אױף אַלע דײַנע שפּײַזאָפּפֿער,</para>
  <para style="q" vid="PSA 20:4">און דאָס פֿעטס פֿון דײַן בראַנדאָפּפֿער װעט ער אָננעמען.</para>
  <para style="q" vid="PSA 20:4">סֶלָה.<verse eid="PSA 20:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 20:5" /> ער װעט דיר געבן לױט דײַן האַרצן,</para>
  <para style="q" vid="PSA 20:5">און דײַן יעטװעדער באַראָט װעט ער דערפֿילן.<verse eid="PSA 20:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 20:6" /> מיר װעלן זינגען אין דײַן ישועה,</para>
  <para style="q" vid="PSA 20:6">און אין נאָמען פֿון אלוקינו װעלן מיר אַ פֿאָן הײבן;</para>
  <para style="q" vid="PSA 20:6">ה׳ װעט דערפֿילן אַלע דײַנע פֿאַרלאַנגען.<verse eid="PSA 20:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 20:7" /> אַצונד װײס איך אַז ה׳ העלפֿט זײַן געזאַלבטן,</para>
  <para style="q" vid="PSA 20:7">ער װעט אים ענטפֿערן פֿון זײַן הײליקן הימל,</para>
  <para style="q" vid="PSA 20:7">מיט די באַהילפֿיקע גבֿורות פֿון זײַן רעכטער האַנט.<verse eid="PSA 20:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 20:8" /> די מיט רײַטװעגן, און די מיט פֿערד,</para>
  <para style="q" vid="PSA 20:8">אָבער מיר װעלן דערמאָנען דעם נאָמען פֿון ה׳ אלוקינו.<verse eid="PSA 20:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 20:9" /> זײ בײגן זיך און פֿאַלן,</para>
  <para style="q" vid="PSA 20:9">און מיר הײבן זיך און שטעלן זיך װידער.<verse eid="PSA 20:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 20:10" /> העלף דו, ה׳!</para>
  <para style="q" vid="PSA 20:10">זאָל דער קיניג אונדז ענטפֿערן אין טאָג װאָס מיר רופֿן.<verse eid="PSA 20:10" /></para>
  <chapter eid="PSA 20" />
  <chapter number="21" style="c" pubnumber="כא" sid="PSA 21" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 21:1" />פֿאַר דעם געזאַנגמײַסטער; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 21:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 21:2" /> ה׳, מיט דײַן שטאַרקײט פֿרײט זיך דער מלך,</para>
  <para style="q" vid="PSA 21:2">און מיט דײַן הילף װי זײער לוסטיק איז ער!<verse eid="PSA 21:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 21:3" /> דעם באַגער פֿון זײַן האַרצן האָסטו אים געגעבן,</para>
  <para style="q" vid="PSA 21:3">און דעם פֿאַרלאַנג פֿון זײַנע ליפּן האָסטו נישט פֿאַרמיטן.</para>
  <para style="q" vid="PSA 21:3">סֶלָה.<verse eid="PSA 21:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 21:4" /> װאָרעם דו טראָגסט אים אַנטקעגן ברכות פֿון גוטס,</para>
  <para style="q" vid="PSA 21:4">טוסט אָן אױף זײַן קאָפּ פֿון גינגאָלד אַ קרױן.<verse eid="PSA 21:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 21:5" /> לעבן האָט ער געבעטן בײַ דיר, האָסטו אים געגעבן;</para>
  <para style="q" vid="PSA 21:5">אַריכת-ימים אױף אײביק און שטענדיק.<verse eid="PSA 21:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 21:6" /> גרױס איז זײַן כּבֿוד דורך דײַן הילף,</para>
  <para style="q" vid="PSA 21:6">גלאַנץ און שײנקײט טוסטו אױף אים אַרױף.<verse eid="PSA 21:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 21:7" /> װאָרעם דו מאַכסט אים פֿאַר אַ בענטשונג אױף אײביק,</para>
  <para style="q" vid="PSA 21:7">דערפֿרײסט אים מיט שׂימחה פֿאַר דײַן פּנים.<verse eid="PSA 21:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 21:8" /> װאָרעם דער מלך פֿאַרזיכערט זיך אױף ה׳,</para>
  <para style="q" vid="PSA 21:8">און דורך דעם חֶסֶד פֿון עליון װעט ער נישט אומפֿאַלן.<verse eid="PSA 21:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 21:9" /> דײַן האַנט װעט דערגרײכן אַלע דײַנע פֿײַנט,</para>
  <para style="q" vid="PSA 21:9">דײַן רעכטע װעט דערגרײכן דײַנע שָׂונאים.<verse eid="PSA 21:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 21:10" /> װעסט זײ מאַכן װי אַ פֿײַעראױװן אין צײַט פֿון דײַן צאָרן;</para>
  <para style="q" vid="PSA 21:10">ה׳ װעט זײ אומברענגען אין זײַן כּעס,</para>
  <para style="q" vid="PSA 21:10">און אַ פֿײַער װעט זײ פֿאַרצערן.<verse eid="PSA 21:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 21:11" /> זײער פֿרוכט װעסטו אונטערברענגען פֿון דער ערד,</para>
  <para style="q" vid="PSA 21:11">און זײער זאָמען פֿון מענטשנקינדער.<verse eid="PSA 21:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 21:12" /> װאָרעם זײ האָבן אָנגעצױגן שלעכטס קעגן דיר;</para>
  <para style="q" vid="PSA 21:12">זײ האָבן געטראַכט בײזע געדאַנקען, װעלן זײ נישט אױספֿירן.<verse eid="PSA 21:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 21:13" /> װאָרעם װעסט זײ מאַכן אומקערן דעם רוקן,</para>
  <para style="q" vid="PSA 21:13">מיט דײַנע בױגנשטריק װעסטו צילן אױף זײער פּנים.<verse eid="PSA 21:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 21:14" /> דערהײב דיך, ה׳, אין דײַן שטאַרקײט;</para>
  <para style="q" vid="PSA 21:14">מיר װעלן זינגען און לױבן דײַן גבֿורה.<verse eid="PSA 21:14" /></para>
  <chapter eid="PSA 21" />
  <chapter number="22" style="c" pubnumber="כב" sid="PSA 22" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 22:1" />פֿאַר דעם געזאַנגמײַסטער; אױף אַיֶלֶת-הַשַחַר. אַ מיזמור פֿון דָוִדן.<verse eid="PSA 22:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 22:2" /> מײַן אֵל, מײַן אֵל, פֿאַר װאָס האָסטו מיך פֿאַרלאָזן?</para>
  <para style="q" vid="PSA 22:2">װײַט פֿון מײַן הילף זײַנען די װערטער פֿון מײַן געשרײ.<verse eid="PSA 22:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 22:3" />אָ מײַן ג-ט, איך רוף בײַ טאָג, און דו ענטפֿערסט נישט,</para>
  <para style="q" vid="PSA 22:3">און בײַ נאַכט און אױך איז קײן שטילונג צו מיר.<verse eid="PSA 22:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 22:4" />דו ביסט דאָך דער הײליקער,</para>
  <para style="q" vid="PSA 22:4">װאָס טראָנט אױף די לױבגעזאַנגען פֿון יִשׂרָאֵל.<verse eid="PSA 22:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 22:5" />אױף דיר האָבן זיך פֿאַרזיכערט אונדזערע עלטערן,</para>
  <para style="q" vid="PSA 22:5">זיך פֿאַרזיכערט, און דו האָסט זײ דערלײזט.<verse eid="PSA 22:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 22:6" />צו דיר האָבן זײ געשריִען, און אַנטרונען געװאָרן,</para>
  <para style="q" vid="PSA 22:6">אױף דיר זיך פֿאַרזיכערט, און נישט פֿאַרשעמט געװאָרן.<verse eid="PSA 22:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 22:7" />אָבער איך בין אַ װאָרעם און נישט קײן מענטש,</para>
  <para style="q" vid="PSA 22:7">אַ חרפּה פֿאַר לײַט, און פֿאַראַכט פֿון פֿאָלק.<verse eid="PSA 22:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 22:8" />אַלע װאָס זעען מיך, לאַכן פֿון מיר,</para>
  <para style="q" vid="PSA 22:8">זײ ציִען מיט דער ליפּ, זײ שאָקלען דעם קאָפּ:<verse eid="PSA 22:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 22:9" />זאָל ער זיך אַרױפֿלײגן אױף ה׳, ער זאָל אים דערלײזן,</para>
  <para style="q" vid="PSA 22:9">אים מציל זײַן, אױב ער טוט אים באַגערן.<verse eid="PSA 22:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 22:10" />פֿאַר װאָר, דו האָסט מיך אַרױסגעצױגן פֿון מוטערלײַב,</para>
  <para style="q" vid="PSA 22:10">מיך פֿאַרזיכערט אױף מײַן מוטערס ברוסט.<verse eid="PSA 22:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 22:11" />אױף דיר בין איך אַרױפֿגעװאָרפֿן פֿון געבערמוטער אָן,</para>
  <para style="q" vid="PSA 22:11">פֿון מײַן מוטערלײַב אָן ביסט דו מײַן אֵל.<verse eid="PSA 22:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 22:12" />נישט דערװײַטער זיך פֿון מיר, װאָרעם די נױט איז נאָנט,</para>
  <para style="q" vid="PSA 22:12">װאָרעם נישטאָ װער זאָל העלפֿן.<verse eid="PSA 22:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 22:13" />אַרומגערינגלט האָבן מיך אָקסן פֿיל,</para>
  <para style="q" vid="PSA 22:13">בולן פֿון בָשָן זײַנען מיך באַפֿאַלן אַרום.<verse eid="PSA 22:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 22:14" />זײ האָבן אױפֿגעשפּאַרט זײער מױל אױף מיר,</para>
  <para style="q" vid="PSA 22:14">װי אַ לײב װאָס פֿאַרצוקט און ברומט.<verse eid="PSA 22:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 22:15" />װי װאַסער בין איך צערונען געװאָרן,</para>
  <para style="q" vid="PSA 22:15">און אַלע מײַנע בײנער האָבן זיך צעשאָטן;</para>
  <para style="q" vid="PSA 22:15">מײַן האַרץ איז געװאָרן װי װאַקס,</para>
  <para style="q" vid="PSA 22:15">צעגאַנגען אין מײַנע אינגעװײד.<verse eid="PSA 22:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 22:16" />אױסגעטריקנט װי אַ שאַרבן איז מײַן כּוֹח,</para>
  <para style="q" vid="PSA 22:16">און מײַן צונג איז צוגעקלעפּט צו מײַן גומען;</para>
  <para style="q" vid="PSA 22:16">און אין דעם שטױב פֿון טױט טוסטו מיך לײגן.<verse eid="PSA 22:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 22:17" />װאָרעם אַרומגערינגלט האָבן מיך הינט,</para>
  <para style="q" vid="PSA 22:17">אַ באַנדע שלעכטסטוער האָט מיך אַרומגענומען,</para>
  <para style="q" vid="PSA 22:17">זײ האָבן מײַנע הענט און מײַנע פֿיס דורכגעשטאָכן.<verse eid="PSA 22:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 22:18" />איך קען איבערצײלן אַלע מײַנע בײנער;</para>
  <para style="q" vid="PSA 22:18">זײ גלאָצן, זײ קוקן אױף מיר.<verse eid="PSA 22:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 22:19" />זײ צעטײלן מײַנע בגדים צװישן זיך,</para>
  <para style="q" vid="PSA 22:19">און אױף מײַן מלבוש װאַרפֿן זײ גורל.<verse eid="PSA 22:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 22:20" />אָבער דו ה׳, זאָלסט זיך נישט דערװײַטערן,</para>
  <para style="q" vid="PSA 22:20">מײַן שטאַרקײט, אײַל מיר צו הילף.<verse eid="PSA 22:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 22:21" />זײַ מציל פֿון שװערד מײַן זעל,</para>
  <para style="q" vid="PSA 22:21">פֿון דער מאַכט פֿון הונט מײַן אײנאײנציקע.<verse eid="PSA 22:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 22:22" />העלף מיך פֿון דעם לײבס מױל,</para>
  <para style="q" vid="PSA 22:22">און פֿון די הערנער פֿון װיזלטירן. זאָלסטו מיר ענטפֿערן.<verse eid="PSA 22:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 22:23" />איך װעל דערצײלן דײַן נאָמען צו מײַנע ברידער,</para>
  <para style="q" vid="PSA 22:23">אין געזעמל װעל איך דיך לױבן:<verse eid="PSA 22:23" /></para>
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 22:24" />איר יראי ה׳, הַלְלוּ יָהּ,</para>
  <para style="q" vid="PSA 22:24">אַל דער זאָמען פֿון יעקבֿ, גיט אים כּבֿוד,</para>
  <para style="q" vid="PSA 22:24">און האָט מורא פֿאַר אים, אַל דער זאָמען פֿון יִשׂרָאֵל.<verse eid="PSA 22:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 22:25" />װאָרעם ער פֿאַראַכט נישט</para>
  <para style="q" vid="PSA 22:25">און פֿאַראומװערדיקט נישט די פּײַן פֿון אָרעמאַן,</para>
  <para style="q" vid="PSA 22:25">און ער פֿאַרבאָרגט נישט זײַן פּנים פֿון אים,</para>
  <para style="q" vid="PSA 22:25">און אַז ער שרײַט צו אים, הערט ער צו.<verse eid="PSA 22:25" /></para>
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 22:26" />פֿון דיר װעט זײַן מײַן לױב אין אַ גרױס געזעמל;</para>
  <para style="q" vid="PSA 22:26">איך װעל באַצאָלן מײַנע נדרים אַנטקעגן פֿאַר זײַנע פֿאָרכטער.<verse eid="PSA 22:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 22:27" />עסן װעלן די געדריקטע און זאַט זײַן,</para>
  <para style="q" vid="PSA 22:27">לױבן װעלן ה׳ די װאָס זוכן אים;</para>
  <para style="q" vid="PSA 22:27">זאָל אױפֿלעבן אײַער האַרץ אױף אײביק!<verse eid="PSA 22:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" altnumber="27" sid="PSA 22:28" />באַקלערן װעלן זיך, און זיך אומקערן צו ה׳,</para>
  <para style="q" vid="PSA 22:28">אַלע עקן פֿון דער ערד;</para>
  <para style="q" vid="PSA 22:28">און בוקן װעלן זיך פֿאַר דיר</para>
  <para style="q" vid="PSA 22:28">אַלע משפּחות פֿון די פֿעלקער.<verse eid="PSA 22:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="28" sid="PSA 22:29" />װאָרעם די מלוכה איז ה׳ס,</para>
  <para style="q" vid="PSA 22:29">און ער געװעלטיקט איבער די פֿעלקער.<verse eid="PSA 22:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" altnumber="29" sid="PSA 22:30" />עסן אַלע פֿעטסן פֿון לאַנד,</para>
  <para style="q" vid="PSA 22:30">און זיך בוקן, קניִען פֿאַר אים,</para>
  <para style="q" vid="PSA 22:30">װעלן אַלע װאָס האָבן אין שטױב גענידערט,</para>
  <para style="q" vid="PSA 22:30">און זײער זעל נישט דערהאַלטן געקענט.<verse eid="PSA 22:30" /></para>
  <para style="q">
    <verse number="31" style="v" altnumber="30" sid="PSA 22:31" />אַ זאָמען װעלן אים דינען,</para>
  <para style="q" vid="PSA 22:31">פֿון אֲדֹנָי װעט דערצײלט װערן דעם קומעדיקן דור.<verse eid="PSA 22:31" /></para>
  <para style="q">
    <verse number="32" style="v" altnumber="31" sid="PSA 22:32" />מע װעט קומען און אָנזאָגן זײַן גערעכטיקײט,</para>
  <para style="q" vid="PSA 22:32">דעם פֿאָלק װאָס װעט געבאָרן װערן – אַז ער האָט עס געטאָן.<verse eid="PSA 22:32" /></para>
  <chapter eid="PSA 22" />
  <chapter number="23" style="c" pubnumber="כג" sid="PSA 23" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 23:1" />אַ מיזמור פֿון דָוִדן.</para>
  <para style="q" vid="PSA 23:1">
    <char style="va">1</char> ה׳ איז מײַן פּאַסטוך,</para>
  <para style="q" vid="PSA 23:1">מיר װעט נישט פֿעלן.<verse eid="PSA 23:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 23:2" />אױף גראָזיקע פֿיטערפּלעצער מאַכט ער מיך לײגן,</para>
  <para style="q" vid="PSA 23:2">בײַ רויִקע װאַסערן טוט ער מיך פֿירן.<verse eid="PSA 23:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 23:3" />ער דערקװיקט מײַן זעל;</para>
  <para style="q" vid="PSA 23:3">ער פֿירט מיך אין ריכטיקע שטעגן</para>
  <para style="q" vid="PSA 23:3">פֿון װעגן זײַן נאָמען.<verse eid="PSA 23:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 23:4" />אַפֿילו אַז איך גײ אין טאָל פֿון טױטשאָטן,</para>
  <para style="q" vid="PSA 23:4">האָב איך נישט מורא פֿאַר בײז,</para>
  <para style="q" vid="PSA 23:4">װאָרעם דו ביסט מיט מיר;</para>
  <para style="q" vid="PSA 23:4">דײַן רוּט און דײַן שטעקן, זײ טוען מיך טרײסטן.<verse eid="PSA 23:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 23:5" />דו גרײטסט פֿאַר מיר אַ טיש</para>
  <para style="q" vid="PSA 23:5">אַנטקעגן מײַנע פֿײַנט;</para>
  <para style="q" vid="PSA 23:5">האָסט באַזאַלבט מיט אײל מײַן קאָפּ,</para>
  <para style="q" vid="PSA 23:5">מײַן כָּוס לױפֿט אַריבער.<verse eid="PSA 23:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 23:6" />נאָר גוטס און גענאָד װעלן מיר נאָכגײן</para>
  <para style="q" vid="PSA 23:6">אַלע טעג פֿון מײַן לעבן,</para>
  <para style="q" vid="PSA 23:6">און איך װעל זיצן אין ה׳ס הױז</para>
  <para style="q" vid="PSA 23:6">אױף לאַנגע טעג.<verse eid="PSA 23:6" /></para>
  <chapter eid="PSA 23" />
  <chapter number="24" style="c" pubnumber="כד" sid="PSA 24" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 24:1" />פֿון דָוִדן אַ מיזמור.</para>
  <para style="q" vid="PSA 24:1">
    <char style="va">1</char>ה׳ס איז די ערד און איר פֿולקײט,</para>
  <para style="q" vid="PSA 24:1">די װעלט און די װױנער אין איר.<verse eid="PSA 24:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 24:2" />װאָרעם ער האָט זי אױף ימען געגרונטפֿעסט,</para>
  <para style="q" vid="PSA 24:2">און האָט זי אױף טײַכן געשטעלט.<verse eid="PSA 24:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 24:3" />װער קען אַרױפֿגײן אױף דעם באַרג פֿון ה׳?</para>
  <para style="q" vid="PSA 24:3">און װער קען שטײן אין זײַן הײליקן אָרט?<verse eid="PSA 24:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 24:4" />דער װאָס האָט רײנע הענט און אַ לױטער האַרץ,</para>
  <para style="q" vid="PSA 24:4">װאָס האָט מיך נישט דערמאָנט צום פֿאַלשן,</para>
  <para style="q" vid="PSA 24:4">און נישט געשװאָרן מיט באַטרוג.<verse eid="PSA 24:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 24:5" />ער װעט קריגן אַ ברכה פֿון ה׳,</para>
  <para style="q" vid="PSA 24:5">און גענאָד פֿון דעם אלֹקים פֿון זײַן הילף.<verse eid="PSA 24:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 24:6" />דאָס איז דער דור פֿון די װאָס פֿאָרשן אים,</para>
  <para style="q" vid="PSA 24:6">װאָס זוכן דײַן פּנים אָ יעקבֿ.</para>
  <para style="q" vid="PSA 24:6">סֶלָה.<verse eid="PSA 24:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 24:7" />הײבט אױף, איר טױערן, אײַערע קעפּ, און הײבט אײַך אױף, איר</para>
  <para style="q" vid="PSA 24:7">אײביקע טירן,</para>
  <para style="q" vid="PSA 24:7">און זאָל אַרײַנגײן דער קיניג פֿון פּראַכט.<verse eid="PSA 24:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 24:8" />װער איז דער קיניג פֿון פּראַכט?</para>
  <para style="q" vid="PSA 24:8">ה׳ דער שטאַרקער און דער גיבור,</para>
  <para style="q" vid="PSA 24:8">ה׳ דער גיבור פֿון מלחמה.<verse eid="PSA 24:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 24:9" />הײבט אױף, איר טױערן, אײַערע קעפּ,</para>
  <para style="q" vid="PSA 24:9">און הײבט אױף, איר אײביקע טירן,</para>
  <para style="q" vid="PSA 24:9">און זאָל אַרײַנגײן דער קיניג פֿון פּראַכט.<verse eid="PSA 24:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 24:10" />װער איז דער קיניג פֿון פּראַכט?</para>
  <para style="q" vid="PSA 24:10">ה׳ צבָֿאוֹת, ער איז דער קיניג פֿון פּראַכט.</para>
  <para style="q" vid="PSA 24:10">סֶלָה.<verse eid="PSA 24:10" /></para>
  <chapter eid="PSA 24" />
  <chapter number="25" style="c" pubnumber="כה" sid="PSA 25" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 25:1" />פֿון דָוִדן.</para>
  <para style="q" vid="PSA 25:1">
    <char style="va">1</char> צו דיר, ה׳, הײב איך אױף מײַן זעל.<verse eid="PSA 25:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 25:2" />מײַן ג-ט, אױף דיר פֿאַרזיכער איך מיך,</para>
  <para style="q" vid="PSA 25:2">לאָמיך נישט פֿאַרשעמט װערן,</para>
  <para style="q" vid="PSA 25:2">זאָלן נישט קװעלן אױף מיר מײַנע פֿײַנט.<verse eid="PSA 25:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 25:3" />יאָ, אַלע װאָס האָפֿן אױף דיר זאָלן נישט פֿאַרשעמט װערן;</para>
  <para style="q" vid="PSA 25:3">פֿאַרשעמט װערן זאָלן די װאָס פֿעלשן פֿאַר גאָרנישט.<verse eid="PSA 25:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 25:4" />דײַנע װעגן, ה׳, מאַך מיך װיסן,</para>
  <para style="q" vid="PSA 25:4">דײַנע שטעגן לערן מיך.<verse eid="PSA 25:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 25:5" />פֿיר מיך אין דײַן אמת, און לערן מיך,</para>
  <para style="q" vid="PSA 25:5">װאָרעם דו ביסט דער אלֹקים פֿון מײַן הילף;</para>
  <para style="q" vid="PSA 25:5">צו דיר האָב איך געהאָפֿט אַ גאַנצן טאָג.<verse eid="PSA 25:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 25:6" />דערמאָן, ה׳, דײַן דערבאַרעמונג און דײַנע חסדים,</para>
  <para style="q" vid="PSA 25:6">װאָרעם זײ זײַנען פֿון אײביק אָן.<verse eid="PSA 25:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 25:7" />די זינד פֿון מײַן יוגנט און מײַנע פֿאַרברעכן</para>
  <para style="q" vid="PSA 25:7">זאָלסטו נישט דערמאָנען;</para>
  <para style="q" vid="PSA 25:7">לױט דײַן חֶסֶד דערמאָן זיך דו אָן מיר,</para>
  <para style="q" vid="PSA 25:7">פֿון װעגן דײַן גוטסקײט, ה׳.<verse eid="PSA 25:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 25:8" />גוט און רעכטפֿאַרטיק איז ה׳,</para>
  <para style="q" vid="PSA 25:8">דערום אױסלערנט ער די זינדיקע דעם װעג.<verse eid="PSA 25:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 25:9" />ער פֿירט די שטילע אין גערעכטיקײט,</para>
  <para style="q" vid="PSA 25:9">און לערנט די שטילע זײַן װעג.<verse eid="PSA 25:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 25:10" />אַלע װעגן פֿון ה׳ זײַנען חֶסֶד און טרײַשאַפֿט</para>
  <para style="q" vid="PSA 25:10">צו די װאָס היטן זײַן ברית און זײַנע צײגנים.<verse eid="PSA 25:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 25:11" />פֿון װעגן דײַן נאָמען, ה׳,</para>
  <para style="q" vid="PSA 25:11">זאָלסטו פֿאַרגעבן מײַן זינד, װאָרעם זי איז גרױס.<verse eid="PSA 25:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 25:12" />װער נאָר אַ מאַן װאָס פֿאָרכט ה׳,</para>
  <para style="q" vid="PSA 25:12">װעט ער אים װײַזן דעם װעג װאָס ער זאָל װײלן.<verse eid="PSA 25:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 25:13" />זײַן זעל װעט רוען אין גוטס,</para>
  <para style="q" vid="PSA 25:13">און זײַן זאָמען װעט אַרבן דאָס לאַנד.<verse eid="PSA 25:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 25:14" />ה׳ס פֿאַרטרױטקײט איז מיט די װאָס פֿאָרכטן אים,</para>
  <para style="q" vid="PSA 25:14">און זײַן ברית, כּדי זײ צו לערנען.<verse eid="PSA 25:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 25:15" />מײַנע אױגן זײַנען תּמיד צו ה׳,</para>
  <para style="q" vid="PSA 25:15">װאָרעם ער ציט אַרױס פֿון נעץ מײַנע פֿיס.<verse eid="PSA 25:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 25:16" />קער זיך צו מיר, און לײַטזעליק מיך,</para>
  <para style="q" vid="PSA 25:16">װאָרעם עלנד און אָרים בין איך.<verse eid="PSA 25:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 25:17" />די צרות פֿון מײַן האַרצן האָבן זיך אױסגעברײט,</para>
  <para style="q" vid="PSA 25:17">פֿון מײַנע דריקענישן ציִ מיך אַרױס.<verse eid="PSA 25:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 25:18" />זע מײַן פּײַן און מײַן מאַטערניש,</para>
  <para style="q" vid="PSA 25:18">און פֿאַרגיב אַלע מײַנע זינד.<verse eid="PSA 25:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 25:19" />זע װי מײַנע שָׂונאים זײַנען פֿיל,</para>
  <para style="q" vid="PSA 25:19">און די אומגערעכטע פֿײַנטשאַפֿט װאָס זײ האָבן מיך פֿײַנט.<verse eid="PSA 25:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 25:20" />היט מײַן זעל און זײַ מיך מציל,</para>
  <para style="q" vid="PSA 25:20">לאָמיך נישט פֿאַרשעמט װערן, װײַל איך שיץ מיך אין דיר.<verse eid="PSA 25:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 25:21" />זאָל ערלעכקײט און רעכטפֿאַרטיקײט מיך באַהיטן,</para>
  <para style="q" vid="PSA 25:21">װאָרעם איך טו האָפֿן צו דיר.<verse eid="PSA 25:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 25:22" />דערלײז, אלֹקים, יִשׂרָאֵל</para>
  <para style="q" vid="PSA 25:22">פֿון אַלע זײַנע צרות.<verse eid="PSA 25:22" /></para>
  <chapter eid="PSA 25" />
  <chapter number="26" style="c" pubnumber="כו" sid="PSA 26" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 26:1" />פֿון דָוִדן.</para>
  <para style="q" vid="PSA 26:1">
    <char style="va">1</char>טו מיר רעכט, ה׳,</para>
  <para style="q" vid="PSA 26:1">װאָרעם איך בין געגאַנגען אין מײַן ערלעכקײט,</para>
  <para style="q" vid="PSA 26:1">און איך האָב מיך פֿאַרזיכערט אױף ה׳, זיך נישט געװאַקלט.<verse eid="PSA 26:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 26:2" />פּרוּװ מיך, ה׳, און פּרוביר מיך,</para>
  <para style="q" vid="PSA 26:2">לײַטער מײַנע נירן און מײַן האַרץ.<verse eid="PSA 26:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 26:3" />װאָרעם דײַן חֶסֶד איז פֿאַר מײַנע אױגן,</para>
  <para style="q" vid="PSA 26:3">און איך גײ אין דײַן אמת.<verse eid="PSA 26:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 26:4" />איך בין נישט געזעסן מיט פֿאַלשע מענטשן,</para>
  <para style="q" vid="PSA 26:4">און מיט פֿאַרשטעלטע קום איך נישט צונױף.<verse eid="PSA 26:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 26:5" />איך האָב פֿײַנט דאָס געזעמל פֿון שלעכטסטוער,</para>
  <para style="q" vid="PSA 26:5">און מיט רשעים טו איך נישט זיצן.<verse eid="PSA 26:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 26:6" />איך װאַש אין רײנקײט מײַנע הענט,</para>
  <para style="q" vid="PSA 26:6">און איך גײ אַרום דײַן מזבח, ה׳,<verse eid="PSA 26:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 26:7" />צו לאָזן הערן אַ קֹול פֿון דאַנק,</para>
  <para style="q" vid="PSA 26:7">און צו דערצײלן אַלע דײַנע װוּנדער.<verse eid="PSA 26:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 26:8" />ה׳, איך האָב ליב די װױנונג פֿון דײַן הױז,</para>
  <para style="q" vid="PSA 26:8">און דעם אָרט פֿון דער רוּונג פֿון דײַן כּבֿוד.<verse eid="PSA 26:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 26:9" />זאָלסט נישט אײַנטאָן מיט זינדיקע מײַן זעל,</para>
  <para style="q" vid="PSA 26:9">און מיט בלוטיקע לײַט מײַן לעבן,<verse eid="PSA 26:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 26:10" />װאָס אין זײערע הענט איז ליסטיקײט,</para>
  <para style="q" vid="PSA 26:10">און זײער רעכטע איז פֿול שוחד.<verse eid="PSA 26:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 26:11" />אָבער איך גײ אין מײַן ערלעכקײט;</para>
  <para style="q" vid="PSA 26:11">לײז מיך אױס, און לײַטזעליק מיך.<verse eid="PSA 26:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 26:12" />װען מײַן פֿוס שטײט אױף גלײַכן,</para>
  <para style="q" vid="PSA 26:12">װעל איך אין געזעמלען לױבן ה׳.<verse eid="PSA 26:12" /></para>
  <chapter eid="PSA 26" />
  <chapter number="27" style="c" pubnumber="כז" sid="PSA 27" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 27:1" />פֿון דָוִדן.</para>
  <para style="q" vid="PSA 27:1">
    <char style="va">1</char>ה׳ איז מײַן ליכט און מײַן הילף,</para>
  <para style="q" vid="PSA 27:1">פֿאַר װעמען זאָל איך מורא האָבן?</para>
  <para style="q" vid="PSA 27:1">ה׳ איז די פֿעסטונג פֿון מײַן לעבן,</para>
  <para style="q" vid="PSA 27:1">פֿאַר װעמען זאָל איך אַנגסטן?<verse eid="PSA 27:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 27:2" />אַז די שלעכטסטוער גענענען צו מיר</para>
  <para style="q" vid="PSA 27:2">צו עסן מײַן פֿלײש –</para>
  <para style="q" vid="PSA 27:2">מײַנע דריקער און מײַנע פֿײַנט –</para>
  <para style="q" vid="PSA 27:2">װערן זײ געשטרױכלט און פֿאַלן.<verse eid="PSA 27:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 27:3" />אַז אַ מחנה זאָל לאַגערן אױף מיר,</para>
  <para style="q" vid="PSA 27:3">װעט נישט מורא האָבן מײַן האַרץ;</para>
  <para style="q" vid="PSA 27:3">אַז אַ מלחמה זאָל אָנשטײן אױף מיר,</para>
  <para style="q" vid="PSA 27:3">בין איך פֿון דעסט װעגן זיכער.<verse eid="PSA 27:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 27:4" />אײנס האָב איך פֿאַרלאַנגט פֿון ה׳,</para>
  <para style="q" vid="PSA 27:4">דאָס טו איך בעטן:</para>
  <para style="q" vid="PSA 27:4">איך זאָל זיצן אין הױז פֿון ה׳</para>
  <para style="q" vid="PSA 27:4">אַלע טעג פֿון מײַן לעבן,</para>
  <para style="q" vid="PSA 27:4">צו זען די ליבלעכקײט פֿון ה׳,</para>
  <para style="q" vid="PSA 27:4">און זיך צו פֿעדערן אין זײַן הֵיכל.<verse eid="PSA 27:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 27:5" />װאָרעם ער באַהאַלט מיך אין זײַן בײַדל,</para>
  <para style="q" vid="PSA 27:5">אין דעם טאָג פֿון בײז,</para>
  <para style="q" vid="PSA 27:5">ער פֿאַרבאָרגט מיך אין דער פֿאַרבאָרגעניש פֿון זײַן געצעלט,</para>
  <para style="q" vid="PSA 27:5">אױף אַ פֿעלדז טוט ער מיך דערהײבן.<verse eid="PSA 27:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 27:6" />און אַצונד װעט זיך הײבן מײַן קאָפּ</para>
  <para style="q" vid="PSA 27:6">איבער מײַנע פֿײַנט רונד אַרום מיר,</para>
  <para style="q" vid="PSA 27:6">און איך װעל שלאַכטן אין זײַן געצעלט שלאַכטאָפּפֿער מיט געשאַל,</para>
  <para style="q" vid="PSA 27:6">איך װעל זינגען און שפּילן צו ה׳.<verse eid="PSA 27:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 27:7" />הער, ה׳, מײַן קֹול – טו איך רופֿן –</para>
  <para style="q" vid="PSA 27:7">און לײַטזעליק מיך, און ענטפֿער מיר.<verse eid="PSA 27:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 27:8" />מײַן האַרץ זאָגט פֿאַר דיר: זוכט מײַן פּנים!</para>
  <para style="q" vid="PSA 27:8">דײַן פּנים, ה׳, טו איך זוכן.<verse eid="PSA 27:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 27:9" />זאָלסט נישט פֿאַרבאָרגן דײַן פּנים פֿון מיר,</para>
  <para style="q" vid="PSA 27:9">זאָלסט נישט אָפּנײַגן אין צאָרן דײַן קנעכט;</para>
  <para style="q" vid="PSA 27:9">ביסט מײַן הילף געװען, זאָלסט מיך נישט אַװעקװאַרפֿן,</para>
  <para style="q" vid="PSA 27:9">און זאָלסט מיך נישט פֿאַרלאָזן, אלֹקים פֿון מײַן ישועה.<verse eid="PSA 27:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 27:10" />אַפֿילו מײַן פֿאָטער און מײַן מוטער זאָלן מיך פֿאַרלאָזן,</para>
  <para style="q" vid="PSA 27:10">װעט אָבער ה׳ מיך אַרײַננעמען.<verse eid="PSA 27:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 27:11" />װײַז מיר, ה׳, דײַן װעג,</para>
  <para style="q" vid="PSA 27:11">און פֿיר מיך אין גלײַכן שטעג,</para>
  <para style="q" vid="PSA 27:11">פֿון װעגן מײַנע לױערער.<verse eid="PSA 27:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 27:12" />זאָלסט מיך נישט געבן אױף דעם באַראָט פֿון מײַנע פֿײַנט;</para>
  <para style="q" vid="PSA 27:12">װאָרעם פֿאַלשע עדות זײַנען אױפֿגעשטאַנען קעגן מיר,</para>
  <para style="q" vid="PSA 27:12">און דער װאָס אָטעמט מיט אומרעכט.<verse eid="PSA 27:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 27:13" />װען איך װאָלט נישט געגלױבט צו זען דאָס גוטס פֿון ה׳,</para>
  <para style="q" vid="PSA 27:13">אין לאַנד פֿון די לעבעדיקע! –<verse eid="PSA 27:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 27:14" />האָף צו ה׳, זײַ שטאַרק,</para>
  <para style="q" vid="PSA 27:14">און זאָל פֿעסט זײַן דײַן האַרץ;</para>
  <para style="q" vid="PSA 27:14">יאָ, האָף צו ה׳.<verse eid="PSA 27:14" /></para>
  <chapter eid="PSA 27" />
  <chapter number="28" style="c" pubnumber="כח" sid="PSA 28" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 28:1" />פֿון דָוִדן.</para>
  <para style="q" vid="PSA 28:1">
    <char style="va">1</char> צו דיר, ה׳, טו איך רופֿן; מײַן פֿעלדז,</para>
  <para style="q" vid="PSA 28:1">זאָלסט נישט טױב זײַן צו מיר,</para>
  <para style="q" vid="PSA 28:1">װאָרעם אַז דו װעסט שװײַגן צו מיר,</para>
  <para style="q" vid="PSA 28:1">װעל איך זײַן געגליכן צו די גענידערטע אין גרוב.<verse eid="PSA 28:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 28:2" />הער דעם קֹול פֿון מײַן געבעט, אַז איך שרײַ צו דיר,</para>
  <para style="q" vid="PSA 28:2">אַז איך הײב אױף מײַנע הענט</para>
  <para style="q" vid="PSA 28:2">צו דײַן הײליקן הֵיכל.<verse eid="PSA 28:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 28:3" />זאָלסט מיך נישט אַװעקציִען מיט די רשעים,</para>
  <para style="q" vid="PSA 28:3">און מיט די טוער פֿון אומרעכט,</para>
  <para style="q" vid="PSA 28:3">װאָס רעדן שלום מיט זײערע חבֿרים,</para>
  <para style="q" vid="PSA 28:3">און בײז איז אין זײער האַרצן.<verse eid="PSA 28:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 28:4" />גיב זײ לױט זײער װערק,</para>
  <para style="q" vid="PSA 28:4">און לױט דער שלעכטיקײט פֿון זײערע מעשׂים;</para>
  <para style="q" vid="PSA 28:4">לױט דער טוּונג פֿון זײערע הענט גיב זײ,</para>
  <para style="q" vid="PSA 28:4">קער זײ אום זײער פֿאַרגעלטונג.<verse eid="PSA 28:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 28:5" />װײַל זײ אַכטן נישט אױף די װערק פֿון ה׳,</para>
  <para style="q" vid="PSA 28:5">און אױף דער טוּונג פֿון זײַנע הענט,</para>
  <para style="q" vid="PSA 28:5">װעט ער זײ צעשטערן און זײ נישט אױפֿבױען.<verse eid="PSA 28:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 28:6" />ברוך ה׳,</para>
  <para style="q" vid="PSA 28:6">װאָרן ער האָט געהערט דעם קֹול פֿון מײַנע געבעטן.<verse eid="PSA 28:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 28:7" />ה׳ איז מײַן שטאַרקײט און מײַן שילד,</para>
  <para style="q" vid="PSA 28:7">אױף אים האָט זיך פֿאַרזיכערט מײַן האַרץ,</para>
  <para style="q" vid="PSA 28:7">און איך בין געהאָלפֿן געװאָרן.</para>
  <para style="q" vid="PSA 28:7">דערום איז לוסטיק מײַן האַרץ,</para>
  <para style="q" vid="PSA 28:7">און מיט מײַן געזאַנג טו איך אים דאַנקען.<verse eid="PSA 28:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 28:8" />ה׳ איז זײ אַ שטאַרקײט,</para>
  <para style="q" vid="PSA 28:8">און אַ פֿעסטונג פֿון הילף איז ער זײַן געזאַלבטן.<verse eid="PSA 28:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 28:9" />העלף דײַן פֿאָלק, און בענטש דײַן אַרב,</para>
  <para style="q" vid="PSA 28:9">און פֿיטער זײ, און טראָג זײ אױף אײביק.<verse eid="PSA 28:9" /></para>
  <chapter eid="PSA 28" />
  <chapter number="29" style="c" pubnumber="כט" sid="PSA 29" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 29:1" />אַ מיזמור פֿון דָוִדן.</para>
  <para style="q" vid="PSA 29:1">
    <char style="va">1</char> גיט צו ה׳, איר מאַכטיקע,</para>
  <para style="q" vid="PSA 29:1">גיט צו ה׳ כּבֿוד און שטאַרקײט,<verse eid="PSA 29:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 29:2" />גיט צו ה׳ דעם כּבֿוד פֿון זײַן נאָמען,</para>
  <para style="q" vid="PSA 29:2">בוקט זיך צו ה׳ מיט הײליקן אָפּשײַ.<verse eid="PSA 29:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 29:3" />דער קֹול פֿון ה׳ איז אױף די װאַסערן,</para>
  <para style="q" vid="PSA 29:3">דער אֵל פֿון פּראַכט טוט דונערן,</para>
  <para style="q" vid="PSA 29:3">ה׳ – אױף װאַסערן גרױסע.<verse eid="PSA 29:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 29:4" />דער קֹול פֿון ה׳ איז מיט מאַכט,</para>
  <para style="q" vid="PSA 29:4">דער קֹול פֿון ה׳ איז מיט שײנקײט,<verse eid="PSA 29:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 29:5" />דער קֹול פֿון ה׳ צעברעכט צעדערן,</para>
  <para style="q" vid="PSA 29:5">און ה׳ צעברעכט די צעדערן פֿון לבֿנוֹן.<verse eid="PSA 29:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 29:6" />און ער מאַכט זײ שפּרינגען װי אַ קאַלב,</para>
  <para style="q" vid="PSA 29:6">לבֿנוֹן און שִׂריוֹן, װי אַ יונג װיזלטיר.<verse eid="PSA 29:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 29:7" />דער קֹול פֿון ה׳ האַקט אױס פֿלאַמען פֿײַער.<verse eid="PSA 29:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 29:8" />דער קֹול פֿון ה׳ מאַכט ציטערן דעם מדבר,</para>
  <para style="q" vid="PSA 29:8">ה׳ מאַכט ציטערן דעם מדבר פֿון קָדֵש.<verse eid="PSA 29:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 29:9" />דער קֹול פֿון ה׳ מאַכט הינדינס געבערן</para>
  <para style="q" vid="PSA 29:9">און טוט װעלדער אַנטבלױזן;</para>
  <para style="q" vid="PSA 29:9">און אין זײַן הֵיכל זאָגט איטלעכער: פּראַכטיק!<verse eid="PSA 29:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 29:10" />ה׳ האָט בײַם מבול געטראָנט,</para>
  <para style="q" vid="PSA 29:10">און ה׳ טראָנט װי אַ מלך אױף אײביק.<verse eid="PSA 29:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 29:11" />ה׳ װעט זײַן פֿאָלק געבן שטאַרקײט,</para>
  <para style="q" vid="PSA 29:11">ה׳ װעט בענטשן זײַן פֿאָלק מיט שלום.<verse eid="PSA 29:11" /></para>
  <chapter eid="PSA 29" />
  <chapter number="30" style="c" pubnumber="ל" sid="PSA 30" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 30:1" />אַ מיזמור; אַ געזאַנג צו דער באַנײַונג פֿון הֵיכל פֿון דָוִדן.<verse eid="PSA 30:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 30:2" /> איך דערהײב דיך, ה׳, װאָרעם האָסט מיך אױפֿגעריכט,</para>
  <para style="q" vid="PSA 30:2">און נישט דערפֿרײט מײַנע פֿײַנט איבער מיר.<verse eid="PSA 30:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 30:3" /> ה׳ מײַן ג-ט, איך האָב געשריִען צו דיר,</para>
  <para style="q" vid="PSA 30:3">און האָסט מיך געהײלט.<verse eid="PSA 30:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 30:4" /> ה׳, האָסט אַרױפֿגעבראַכט פֿון שְׁאֹול מײַן זעל,</para>
  <para style="q" vid="PSA 30:4">האָסט מיך אױפֿגעלעבט, איך זאָל נישט נידערן אין גרוב.<verse eid="PSA 30:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 30:5" /> זינגט צו ה׳, זײַנע פֿרומע,</para>
  <para style="q" vid="PSA 30:5">און דאַנקט זײַן הײליקער געדעכעניש.<verse eid="PSA 30:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 30:6" /> װאָרעם אַ רגע איז זײַן צאָרן,</para>
  <para style="q" vid="PSA 30:6">אַ לעבן זײַן גוטװיליקײט.</para>
  <para style="q" vid="PSA 30:6">איבער נאַכט בלײַבט געװײן,</para>
  <para style="q" vid="PSA 30:6">און פֿרימאָרגנס איז געזאַנג.<verse eid="PSA 30:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 30:7" /> און איך האָב געװעסט געזאָגט אין מײַן שלװה:</para>
  <para style="q" vid="PSA 30:7">איך װעל נישט אומפֿאַלן קײן מאָל.<verse eid="PSA 30:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 30:8" /> אין דײַן גוטװיליקײט, ה׳,</para>
  <para style="q" vid="PSA 30:8">האָסטו געהאַט אױפֿגעשטעלט פֿעסט מײַן באַרג –</para>
  <para style="q" vid="PSA 30:8">האָסטו פֿאַרבאָרגן דײַן פּנים,</para>
  <para style="q" vid="PSA 30:8">און איך בין דערשראָקן געװאָרן.<verse eid="PSA 30:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 30:9" /> צו דיר, ה׳, פֿלעג איך רופֿן,</para>
  <para style="q" vid="PSA 30:9">און צו אֲדֹנָי פֿלעג איך בעטן:<verse eid="PSA 30:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 30:10" /> װאָסער געװין איז אין מײַן בלוט,</para>
  <para style="q" vid="PSA 30:10">אַז איך װעל נידערן אין גרוב?</para>
  <para style="q" vid="PSA 30:10">קען דיך לױבן דער שטױב?</para>
  <para style="q" vid="PSA 30:10">קען ער דערצײלן דײַן אמת?<verse eid="PSA 30:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 30:11" /> הער, ה׳, און לײַטזעליק מיך,</para>
  <para style="q" vid="PSA 30:11">ה׳, זײַ מיר אַ העלפֿער.<verse eid="PSA 30:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 30:12" /> האָסטו מיר פֿאַרקערט מײַן קלאָג אין טאַנץ,</para>
  <para style="q" vid="PSA 30:12">האָסט אָפּגעבונדן מײַן זאַקקלײד,</para>
  <para style="q" vid="PSA 30:12">און מיך אָנגעגורט מיט פֿרײד;<verse eid="PSA 30:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 30:13" /> דערום װעט דיך באַזינגען די זעל, און נישט שװײַגן.</para>
  <para style="q" vid="PSA 30:13">ה׳ מײַן ג-ט, אײביק װעל איך דיר דאַנקען.<verse eid="PSA 30:13" /></para>
  <chapter eid="PSA 30" />
  <chapter number="31" style="c" pubnumber="לא" sid="PSA 31" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 31:1" />פֿאַר דעם געזאַנגמײַסטער; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 31:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 31:2" /> אין דיר, ה׳, טו איך מיך שיצן,</para>
  <para style="q" vid="PSA 31:2">לאָמיך נישט פֿאַרשעמט װערן קײן מאָל;</para>
  <para style="q" vid="PSA 31:2">אין דײַן גערעכטיקײט מאַך מיך אַנטרינען.<verse eid="PSA 31:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 31:3" /> נײַג צו דײַן אױער צו מיר,</para>
  <para style="q" vid="PSA 31:3">זײַ מיך מציל געשװינט;</para>
  <para style="q" vid="PSA 31:3">זײַ מיר פֿאַר אַ פֿעלדז פֿון באַשיצונג,</para>
  <para style="q" vid="PSA 31:3">פֿאַר אַ באַפֿעסטיקט הױז מיך צו העלפֿן.<verse eid="PSA 31:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 31:4" /> װאָרעם דו ביסט מײַן פֿעלדז און מײַן פֿעסטונג,</para>
  <para style="q" vid="PSA 31:4">און פֿון דײַן נאָמען װעגן זאָלסטו מיך פֿירן און מיך באַלײטן.<verse eid="PSA 31:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 31:5" /> זאָלסט מיך אַרױסציען פֿון דער נעץ</para>
  <para style="q" vid="PSA 31:5">װאָס זײ האָבן מיר אונטערגעלײגט,</para>
  <para style="q" vid="PSA 31:5">װאָרעם דו ביסט מײַן באַשיצונג,<verse eid="PSA 31:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 31:6" /> אין דײַן האַנט גיב איך איבער מײַן גײַסט;</para>
  <para style="q" vid="PSA 31:6">װעסט מיך אױסלײזן, ה׳, דו אֵל געטרײַער.<verse eid="PSA 31:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 31:7" /> איך האָב פֿײַנט די װאָס האַלטן זיך אָן פֿאַלשע נישטיקײטן,</para>
  <para style="q" vid="PSA 31:7">װאָרעם איך האָב מיך אױף ה׳ פֿאַרזיכערט.<verse eid="PSA 31:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 31:8" /> איך פֿרײ זיך און בין לוסטיק מיט דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 31:8">װאָרעם האָסט געזען מײַן פּײַן,</para>
  <para style="q" vid="PSA 31:8">האָסט געמערקט די צרות פֿון מײַן זעל.<verse eid="PSA 31:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 31:9" /> און האָסט מיך נישט איבערגעענטפֿערט</para>
  <para style="q" vid="PSA 31:9">אין דער האַנט פֿונעם פֿײַנט;</para>
  <para style="q" vid="PSA 31:9">האָסט געשטעלט מײַנע פֿיס אין דערברײטערניש.<verse eid="PSA 31:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 31:10" /> לײַטזעליק מיך, ה׳, װאָרעם מיר איז ענג,</para>
  <para style="q" vid="PSA 31:10">מאַט געװאָרן פֿון ערגערניש איז מײַן אױג,</para>
  <para style="q" vid="PSA 31:10">מײַן זעל און מײַן לײַב.<verse eid="PSA 31:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 31:11" /> װאָרעם פֿאַרגאַנגען איז אין קומער מײַן לעבן,</para>
  <para style="q" vid="PSA 31:11">און מײַנע יאָרן אין זיפֿצעניש;</para>
  <para style="q" vid="PSA 31:11">אָפּגעפֿאַלן פֿון װעגן מײַנע זינד איז מײַן כּוֹח,</para>
  <para style="q" vid="PSA 31:11">און מײַנע בײנער זײַנען מאַט געװאָרן.<verse eid="PSA 31:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 31:12" /> פֿון װעגן אַלע מײַנע פֿײַנט בין איך געװאָרן צו חרפּה,</para>
  <para style="q" vid="PSA 31:12">און בײַ מײַנע שכנים, ביז גאָר,</para>
  <para style="q" vid="PSA 31:12">און אַ גרױל בײַ מײַנע באַקאַנטע;</para>
  <para style="q" vid="PSA 31:12">די װאָס זעען מיך אין גאַס, װײַכן פֿון מיר.<verse eid="PSA 31:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 31:13" /> איך בין פֿאַרגעסן געװאָרן װי אַ טױטער אױסן האַרצן,</para>
  <para style="q" vid="PSA 31:13">איך בין געװאָרן װי אַ פֿאַרדאָרבן געפֿעס.<verse eid="PSA 31:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 31:14" /> װאָרעם איך האָב געהערט דאָס גערײד פֿון פֿיל –</para>
  <para style="q" vid="PSA 31:14">אַ שרעק רונד אַרום;</para>
  <para style="q" vid="PSA 31:14">אַז זײ עֵצהן זיך מיט אַנאַנדער אױף מיר,</para>
  <para style="q" vid="PSA 31:14">טראַכטן זײ מײַן לעבן צו נעמען.<verse eid="PSA 31:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 31:15" /> אָבער איך פֿאַרזיכער מיך אױף דיר, ה׳,</para>
  <para style="q" vid="PSA 31:15">איך זאָג: מײַן ג-ט ביסט דו.<verse eid="PSA 31:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 31:16" /> אין דײַן האַנט זײַנען מײַנע צײַטן,</para>
  <para style="q" vid="PSA 31:16">זײַ מיך מציל פֿון דער האַנט פֿון מײַנע פֿײַנט,</para>
  <para style="q" vid="PSA 31:16">און פֿון מײַנע נאָכיאָגער.<verse eid="PSA 31:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 31:17" /> דערלײַכט דײַן פּנים אױף דײַן קנעכט,</para>
  <para style="q" vid="PSA 31:17">העלף מיך אין דײַן גענאָד.<verse eid="PSA 31:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 31:18" /> ה׳, נישט לאָמיך פֿאַרשעמט װערן,</para>
  <para style="q" vid="PSA 31:18">װאָרעם איך האָב דיך גערופֿן;</para>
  <para style="q" vid="PSA 31:18">זאָלן פֿאַרשעמט װערן די רשעים,</para>
  <para style="q" vid="PSA 31:18">זאָלן זײ אַנטשװיגן װערן אין שְׁאֹול.<verse eid="PSA 31:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 31:19" /> זאָלן שטום װערן די ליפּן פֿון ליגן,</para>
  <para style="q" vid="PSA 31:19">װאָס רעדן אױפֿן צדיק פֿאַרשײַט,</para>
  <para style="q" vid="PSA 31:19">מיט גאװה און פֿאַראַכטעניש.<verse eid="PSA 31:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 31:20" /> װי גרױס איז דײַן גוטס,</para>
  <para style="q" vid="PSA 31:20">װאָס דו האָסט באַהאַלטן פֿאַר די װאָס פֿאָרכטן דיך,</para>
  <para style="q" vid="PSA 31:20">געמאַכט פֿאַר די װאָס שיצן זיך אין דיר</para>
  <para style="q" vid="PSA 31:20">אַקעגן די מענטשנקינדער!<verse eid="PSA 31:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 31:21" /> פֿאַרבאָרגסט זײ אין דער פֿאַרבאָרגעניש פֿון דײַן פּנים,</para>
  <para style="q" vid="PSA 31:21">פֿון די באַנדעס מענטשן;</para>
  <para style="q" vid="PSA 31:21">באַהאַלטסט זײ אין אַ בײַדל,</para>
  <para style="q" vid="PSA 31:21">פֿון דעם קריג פֿון די צינגער.<verse eid="PSA 31:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 31:22" /> ברוך ה׳, װאָס האָט װוּנדערלעך באַװיזן</para>
  <para style="q" vid="PSA 31:22">זײַן חֶסֶד צו מיר אין דער באַלעגערטער שטאָט.<verse eid="PSA 31:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 31:23" /> און איך האָב געװעסט געזאָגט אין מײַן האַסט:</para>
  <para style="q" vid="PSA 31:23">איך בין פֿאַרשניטן פֿון קעגן דײַנע אױגן.</para>
  <para style="q" vid="PSA 31:23">אָבער האָסט געהערט דעם קֹול פֿון מײַנע געבעטן,</para>
  <para style="q" vid="PSA 31:23">אַז איך האָב געשריִען צו דיר.<verse eid="PSA 31:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 31:24" /> האָט ליב ה׳, איר אַלע זײַנע פֿרומע;</para>
  <para style="q" vid="PSA 31:24">די געטרײַע טוט אָפּהיטן ה׳,</para>
  <para style="q" vid="PSA 31:24">און באַצאָלט מיט אַן איבערמאָס דעם װאָס טוט האָפֿערדיק.<verse eid="PSA 31:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 31:25" /> זײַט שטאַרק, און זאָל פֿעסט זײַן אײַער האַרץ,</para>
  <para style="q" vid="PSA 31:25">איר אַלע װאָס האָפֿט צו ה׳.<verse eid="PSA 31:25" /></para>
  <chapter eid="PSA 31" />
  <chapter number="32" style="c" pubnumber="לב" sid="PSA 32" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 32:1" />פֿון דָוִדן אַ באַטראַכטונג.</para>
  <para style="q" vid="PSA 32:1">
    <char style="va">1</char>װױל צו דעם װאָס זײַן פֿאַרברעך איז פֿאַרגעבן,</para>
  <para style="q" vid="PSA 32:1">װאָס זײַן חטא װערט פֿאַרדעקט.<verse eid="PSA 32:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 32:2" />װױל צו דעם מענטשן װאָס ה׳ רעכנט אים נישט קײן זינד,</para>
  <para style="q" vid="PSA 32:2">און אין זײַן גײַסט איז נישטאָ קײן באַטרוג.<verse eid="PSA 32:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 32:3" />אַז איך האָב געשװיגן, האָבן מײַנע בײנער געפֿױלט,</para>
  <para style="q" vid="PSA 32:3">פֿון מײַן קרעכצן אַ גאַנצן טאָג.<verse eid="PSA 32:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 32:4" />װאָרעם טאָג און נאַכט פֿלעגט שװער זײַן אױף מיר דײַן האַנט,</para>
  <para style="q" vid="PSA 32:4">מײַן זאַפֿט איז פֿאַרביטן געװאָרן װי אין פֿאַרטריקנטע זומעראױפּס.</para>
  <para style="q" vid="PSA 32:4">סֶלָה.<verse eid="PSA 32:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 32:5" />האָב איך דיך געלאָזט װיסן מײַן חטא,</para>
  <para style="q" vid="PSA 32:5">און מײַן זינד האָב איך נישט פֿאַרדעקט.</para>
  <para style="q" vid="PSA 32:5">איך האָב געזאָגט: איך װעל זיך מודה זײַן אױף מײַנע</para>
  <para style="q" vid="PSA 32:5">פֿאַרברעכן צו ה׳;</para>
  <para style="q" vid="PSA 32:5">און דו האָסט פֿאַרגעבן די שולד פֿון מײַן זינד. סֶלָה.<verse eid="PSA 32:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 32:6" />אױף דעם זאָל איטלעכער פֿרומער מתפּלל זײַן צו דיר,</para>
  <para style="q" vid="PSA 32:6">אין דער צײַט װאָס מע קען דיך געפֿינען:</para>
  <para style="q" vid="PSA 32:6">אַז די גרױסע װאַסערן פֿלײצן איבער,</para>
  <para style="q" vid="PSA 32:6">זאָלן זײ צו אים אָבער נישט דערגרײכן.<verse eid="PSA 32:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 32:7" />דו ביסט מײַן פֿאַרבאָרגעניש,</para>
  <para style="q" vid="PSA 32:7">פֿון דעם פֿײַנט באַהיטסטו מיך;</para>
  <para style="q" vid="PSA 32:7">מיט געזאַנגען פֿון אַנטרינונג</para>
  <para style="q" vid="PSA 32:7">רינגלסטו מיך אַרום. סֶלָה.<verse eid="PSA 32:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 32:8" />איך װעל דיך קלוג מאַכן</para>
  <para style="q" vid="PSA 32:8">און דיר װײַזן דעם װעג װאָס דו זאָלסט גײן,</para>
  <para style="q" vid="PSA 32:8">איך װעל האַלטן מײַן אױג אױף דיר.<verse eid="PSA 32:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 32:9" />איר זאָלט נישט זײַן װי אַ פֿערד, װי אַ מױלאײזל, אָן פֿאַרשטאַנד,</para>
  <para style="q" vid="PSA 32:9">װאָס מיט צאַם און געביס מוז מען אײַנהאַלטן זײַן אימפּעט,</para>
  <para style="q" vid="PSA 32:9">אַז מע זאָל נישט קענען גענענען צו דיר.<verse eid="PSA 32:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 32:10" />פֿיל װײטאָגן האָט דער רשע,</para>
  <para style="q" vid="PSA 32:10">אָבער דער װאָס פֿאַרזיכערט זיך אױף ה׳,</para>
  <para style="q" vid="PSA 32:10">אים װעט אַרומרינגלען גענאָד.<verse eid="PSA 32:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 32:11" />פֿרײט זיך מיט ה׳, און זײַט לוסטיק, צדיקים,</para>
  <para style="q" vid="PSA 32:11">און זינגט, אַלע רעכטפֿאַרטיקע הערצער.<verse eid="PSA 32:11" /></para>
  <chapter eid="PSA 32" />
  <chapter number="33" style="c" pubnumber="לג" sid="PSA 33" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 33:1" />פֿרײט זיך צדיקים, מיט ה׳,</para>
  <para style="q" vid="PSA 33:1">שײן פֿאַר די רעכטפֿאַרטיקע איז לױבונג.<verse eid="PSA 33:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 33:2" />גיט אַ דאַנק צו ה׳ אױף אַ האַרף,</para>
  <para style="q" vid="PSA 33:2">אױף אַ גיטאַר פֿון צען סטרונעס שפּילט צו אים.<verse eid="PSA 33:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 33:3" />זינגט צו אים אַ נײַ געזאַנג,</para>
  <para style="q" vid="PSA 33:3">שפּילט װױל מיט געשאַל.<verse eid="PSA 33:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 33:4" />װאָרעם רעכטפֿאַרטיק איז דאָס װאָרט פֿון ה׳</para>
  <para style="q" vid="PSA 33:4">און זײַן יעטװעדער טוּונג איז מיט טרײַשאַפֿט.<verse eid="PSA 33:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 33:5" />ער האָט ליב רעכט און גערעכטיקײט,</para>
  <para style="q" vid="PSA 33:5">מיט דעם חֶסֶד פֿון ה׳ איז פֿול די ערד.<verse eid="PSA 33:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 33:6" />דורך דעם װאָרט פֿון ה׳ זײַנען די הימלען געמאַכט געװאָרן,</para>
  <para style="q" vid="PSA 33:6">און דורך דעם רוּחַ פֿון זײַן מױל זײער גאַנצער חיל.<verse eid="PSA 33:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 33:7" />ער זאַמלט װי אַ סטױג די װאַסערן פֿון ים,</para>
  <para style="q" vid="PSA 33:7">ער טוט אַרײַן אין שפּײַכלערס די תּהומען.<verse eid="PSA 33:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 33:8" />מורא פֿאַר ה׳ האָט די גאַנצע ערד,</para>
  <para style="q" vid="PSA 33:8">פֿאַר אים פֿאָרכטן אַלע באַװױנער פֿון דער װעלט.<verse eid="PSA 33:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 33:9" />װאָרעם ער זאָגט, און עס געשעט,</para>
  <para style="q" vid="PSA 33:9">ער באַפֿעלט, און עס באַשטײט.<verse eid="PSA 33:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 33:10" />ה׳ פֿאַרשטערט דעם באַראָט פֿון די פֿעלקער,</para>
  <para style="q" vid="PSA 33:10">ער פֿאַרװערט די מחשבֿות פֿון די אומות.<verse eid="PSA 33:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 33:11" />דער באַראָט פֿון ה׳ װעט אױף אײביק באַשטײן,</para>
  <para style="q" vid="PSA 33:11">די טראַכטונגען פֿון זײַן האַרצן אױף דור-דורות.<verse eid="PSA 33:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 33:12" />װױל צו דעם פֿאָלק װאָס ה׳ איז זײַן ג-ט,</para>
  <para style="q" vid="PSA 33:12">צו דער אומה װאָס ער האָט געװײלט זיך צום אַרב.<verse eid="PSA 33:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 33:13" />פֿון הימל לוגט ה׳,</para>
  <para style="q" vid="PSA 33:13">ער זעט אַלע מענטשנקינדער;<verse eid="PSA 33:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 33:14" />פֿון דעם אָרט פֿון זײַן װױנונג</para>
  <para style="q" vid="PSA 33:14">באַטראַכט ער אַלע באַװױנער פֿון דער ערד;<verse eid="PSA 33:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 33:15" />ער װאָס פֿורעמט זײער אַלעמענס האַרץ,</para>
  <para style="q" vid="PSA 33:15">װאָס פֿאַרשטײט אַלע זײערע מעשׂים.<verse eid="PSA 33:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 33:16" />אַ מלך װערט נישט געהאָלפֿן דורך פֿיל חיל,</para>
  <para style="q" vid="PSA 33:16">אַ גיבור װערט נישט ניצול דורך גרױס כּוֹח;<verse eid="PSA 33:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 33:17" />אַן אָפּנאַר איז דער פֿערד פֿאַר הילף,</para>
  <para style="q" vid="PSA 33:17">און מיט זײַן גרױס כּוֹח װעט ער נישט מאַכן אַנטרינען.<verse eid="PSA 33:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 33:18" />זע, דאָס אױג פֿון ה׳ איז אױף די װאָס פֿאָרכטן אים,</para>
  <para style="q" vid="PSA 33:18">אױף די װאָס האָפֿן צו זײַן חֶסֶד,<verse eid="PSA 33:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 33:19" />מציל צו זײַן פֿון טױט זײער זעל,</para>
  <para style="q" vid="PSA 33:19">און זײ צו דערהאַלטן אין הונגער.<verse eid="PSA 33:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 33:20" />אונדזער זעל האָט געהאַרט אױף ה׳,</para>
  <para style="q" vid="PSA 33:20">אונדזער הילף און אונדזער שילד איז ער.<verse eid="PSA 33:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 33:21" />װאָרעם מיט אים פֿרײט זיך אונדזער האַרץ,</para>
  <para style="q" vid="PSA 33:21">װאָרעם אױף זײַן הײליקן נאָמען האָבן מיר זיך פֿאַרזיכערט.<verse eid="PSA 33:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 33:22" />זאָל דײַן חֶסֶד, ה׳, זײַן אױף אונדז,</para>
  <para style="q" vid="PSA 33:22">אַזױ װי מיר האָבן געהאָפֿט צו דיר.<verse eid="PSA 33:22" /></para>
  <chapter eid="PSA 33" />
  <chapter number="34" style="c" pubnumber="לד" sid="PSA 34" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 34:1" />פֿון דָוִדן; װען ער האָט געביטן זײַן שׂכל פֿאַר אַבֿימֶלֶכן, און ער האָט אים אַרױסגעטריבן, און ער איז אַװעק.<verse eid="PSA 34:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 34:2" /> איך בענטש ה׳ אין יעטװעדער צײַט,</para>
  <para style="q" vid="PSA 34:2">תּמיד איז זײַן לױב אין מײַן מױל.<verse eid="PSA 34:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 34:3" /> מיט ה׳ רימט זיך מײַן זעל;</para>
  <para style="q" vid="PSA 34:3">די געדריקטע װעלן הערן און זיך פֿרײען.<verse eid="PSA 34:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 34:4" /> גרײסט ה׳ מיט מיר,</para>
  <para style="q" vid="PSA 34:4">און לאָמיר דערהײבן זײַן נאָמען אין אײנעם.<verse eid="PSA 34:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 34:5" /> איך האָב געזוכט ה׳, און ער האָט מיר געענטפֿערט,</para>
  <para style="q" vid="PSA 34:5">און פֿון אַלע מײַנע שרעקענישן האָט ער מיך מציל געװען.<verse eid="PSA 34:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 34:6" /> זײ האָבן געקוקט צו אים, און האָבן אױפֿגעלוכטן,</para>
  <para style="q" vid="PSA 34:6">און זײערע פּנימער װעלן נישט פֿאַרשעמט װערן.<verse eid="PSA 34:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 34:7" /> אָט האָט אַן אָרעמאַן גערופֿן, און ה׳ האָט צוגעהערט,</para>
  <para style="q" vid="PSA 34:7">און פֿון אַלע זײַנע צרות אים געהאָלפֿן.<verse eid="PSA 34:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 34:8" /> דער מלאך פֿון ה׳ לאַגערט אַרום זײַנע פֿאָרכטער,</para>
  <para style="q" vid="PSA 34:8">און ער טוט זײ דערלײזן.<verse eid="PSA 34:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 34:9" /> באַטראַכט און זעט אַז ה׳ איז גוט;</para>
  <para style="q" vid="PSA 34:9">װױל צו דעם מאַן װאָס שיצט זיך אין אים.<verse eid="PSA 34:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 34:10" /> פֿאָרכט ה׳, איר זײַנע הײליקע,</para>
  <para style="q" vid="PSA 34:10">װאָרעם זײַנע פֿאָרכטער װעט נישט פֿעלן.<verse eid="PSA 34:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 34:11" /> יונגלײבן דאַרן און הונגערן,</para>
  <para style="q" vid="PSA 34:11">אָבער די װאָס זוכן ה׳ פֿעלט נישט כָּל-טובֿ.<verse eid="PSA 34:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 34:12" /> קומט, קינדער, הערט מיר צו,</para>
  <para style="q" vid="PSA 34:12">מורא פֿאַר ה׳ װעל איך אײַך לערנען.<verse eid="PSA 34:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 34:13" /> װער נאָר אַ מאַן װאָס װיל לעבן,</para>
  <para style="q" vid="PSA 34:13">װאָס גאַרט טעג צו זען גוטס,<verse eid="PSA 34:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 34:14" /> היט דײַן צונג פֿון שלעכטס,</para>
  <para style="q" vid="PSA 34:14">און דײַנע ליפּן פֿון רעדן באַטרוג.<verse eid="PSA 34:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 34:15" /> קער זיך אָפּ פֿון שלעכטס, און טו גוטס,</para>
  <para style="q" vid="PSA 34:15">זוך שלום און יאָג זיך נאָך אים.<verse eid="PSA 34:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 34:16" /> די אױגן פֿון ה׳ זײַנען אױף די צדיקים,</para>
  <para style="q" vid="PSA 34:16">און זײַנע אױערן אױף זײער געשרײ.<verse eid="PSA 34:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 34:17" /> דער פּנים פֿון ה׳ איז קעגן די שלעכטסטוער.</para>
  <para style="q" vid="PSA 34:17">צו פֿאַרשנײַדן פֿון דער ערד זײער געדעכעניש.<verse eid="PSA 34:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 34:18" /> זײ האָבן געשריִען, און ה׳ האָט זײ צוגעהערט,</para>
  <para style="q" vid="PSA 34:18">און פֿון אַלע זײערע צרות זײ מציל געװען.<verse eid="PSA 34:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 34:19" /> ה׳ איז נאָנט צו די צעבראָכענע הערצער,</para>
  <para style="q" vid="PSA 34:19">און די דערשלאָגענע געמיטער טוט ער העלפֿן.<verse eid="PSA 34:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 34:20" /> פֿיל זײַנען די אומגליקן פֿון צדיק,</para>
  <para style="q" vid="PSA 34:20">אָבער פֿון זײ אַלע װעט אים מציל זײַן ה׳.<verse eid="PSA 34:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 34:21" /> ער היט אָפּ אַלע זײַנע בײנער,</para>
  <para style="q" vid="PSA 34:21">נישט אַן אײנציקער פֿון זײ װערט צעבראָכן.<verse eid="PSA 34:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 34:22" /> דעם רשע װעט טײטן דאָס בײז,</para>
  <para style="q" vid="PSA 34:22">און די שָׂונאים פֿון צדיק װעלן פֿאַרװיסט װערן.<verse eid="PSA 34:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 34:23" /> ה׳ לײזט אױס די זעל פֿון זײַנע קנעכט,</para>
  <para style="q" vid="PSA 34:23">און נישט פֿאַרװיסט װערן װעלן אַלע װאָס שיצן זיך אין אים.<verse eid="PSA 34:23" /></para>
  <chapter eid="PSA 34" />
  <chapter number="35" style="c" pubnumber="לה" sid="PSA 35" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 35:1" />פֿון דָוִדן.</para>
  <para style="q" vid="PSA 35:1">
    <char style="va">1</char>קריג, ה׳, מיט מײַנע קריגער,</para>
  <para style="q" vid="PSA 35:1">שטרײַט מיט מײַנע שטרײַטער.<verse eid="PSA 35:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 35:2" />נעם אָן אַ שילד און אַ קלײן שילד,</para>
  <para style="q" vid="PSA 35:2">און שטײ אױף מיר צו הילף.<verse eid="PSA 35:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 35:3" />און צי אַרױס דעם שפּיז און די האַק</para>
  <para style="q" vid="PSA 35:3">אַקעגן מײַנע נאָכיאָגער;</para>
  <para style="q" vid="PSA 35:3">זאָג צו מײַן זעל:</para>
  <para style="q" vid="PSA 35:3">דײַן ישועה בין איך.<verse eid="PSA 35:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 35:4" />זאָלן פֿאַרשעמט און צו שאַנד װערן</para>
  <para style="q" vid="PSA 35:4">די װאָס זוכן מײַן לעבן;</para>
  <para style="q" vid="PSA 35:4">זאָלן אָפּטרעטן אַהינטער און זיך שעמען</para>
  <para style="q" vid="PSA 35:4">די װאָס טראַכטן מיר בײז.<verse eid="PSA 35:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 35:5" />זאָלן זײ זײַן װי שפּרײ פֿאַרן װינט,</para>
  <para style="q" vid="PSA 35:5">און דער מלאך פֿון ה׳ זאָל זײ שטױסן.<verse eid="PSA 35:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 35:6" />זאָל זײער װעג זײַן חושך און גליטשיק,</para>
  <para style="q" vid="PSA 35:6">און דער מלאך פֿון ה׳ זאָל זײ יאָגן.<verse eid="PSA 35:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 35:7" />װאָרעם פֿאַר אומזיסט האָבן זײ מיר אונטערגעלײגט</para>
  <para style="q" vid="PSA 35:7">זײער נעץ פֿון אונטערגאַנג,</para>
  <para style="q" vid="PSA 35:7">פֿאַר אומזיסט האָבן זײ געגראָבן אױף מײַן זעל.<verse eid="PSA 35:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 35:8" />זאָל קומען אױף אים אַ בראָך אומגעריכט,</para>
  <para style="q" vid="PSA 35:8">און זײַן נעץ װאָס ער האָט אונטערגעלײגט זאָל אים באַצװינגען;</para>
  <para style="q" vid="PSA 35:8">מיט שטורעם זאָל ער פֿאַלן דערין.<verse eid="PSA 35:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 35:9" />און מײַן זעל װעט זיך פֿרײען מיט ה׳,</para>
  <para style="q" vid="PSA 35:9">זי װעט לוסטיק זײַן מיט זײַן ישועה.<verse eid="PSA 35:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 35:10" />אַלע מײַנע בײנער װעלן זאָגן:</para>
  <para style="q" vid="PSA 35:10">װער אַזױ װי דו, ה׳,</para>
  <para style="q" vid="PSA 35:10">איז מציל דעם אָרעמאַן פֿון דעם שטאַרקערן פֿון אים,</para>
  <para style="q" vid="PSA 35:10">יאָ, דעם אָרעמאַן און דעם אבֿיון פֿון דעם װאָס באַגזלט אים.<verse eid="PSA 35:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 35:11" />פֿאַלשע עדות שטײען אױף,</para>
  <para style="q" vid="PSA 35:11">װאָס איך װײס נישט פֿרעגן זײ מיך.<verse eid="PSA 35:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 35:12" />זײ צאָלן מיר אַ רָעה פֿאַר אַ טובֿה,</para>
  <para style="q" vid="PSA 35:12">פֿאַריתומט איז מײַן זעל.<verse eid="PSA 35:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 35:13" />און איך, אַז זײ זײַנען קראַנק געװען,</para>
  <para style="q" vid="PSA 35:13">איז מײַן אָנקלײד געװען זאַק,</para>
  <para style="q" vid="PSA 35:13">איך האָב געפּײַניקט מיט פֿאַסטן מײַן לײַב;</para>
  <para style="q" vid="PSA 35:13">און מײַן תּפֿילה – זאָל עס אָנקומען אין מײַן בוזעם!<verse eid="PSA 35:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 35:14" />װי בײַ אַ חבֿר, װי בײַ אַ ברודער מײַנעם,</para>
  <para style="q" vid="PSA 35:14">בין איך אַרומגעגאַנגען,</para>
  <para style="q" vid="PSA 35:14">װי אין טרױער נאָך אַ מאַמען,</para>
  <para style="q" vid="PSA 35:14">פֿינצטער געבױגן בין איך געװען.<verse eid="PSA 35:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 35:15" />אָבער אַז איך פֿאַל, פֿרײען זײ זיך, און קלײַבן זיך אױף;</para>
  <para style="q" vid="PSA 35:15">עס קלײַבן זיך אַרום מיר שלעגער װאָס איך קען נישט;</para>
  <para style="q" vid="PSA 35:15">זײ רײַסן און הערן נישט אױף.<verse eid="PSA 35:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 35:16" />מיט פֿאַלשע רכילות-געשפּעטן</para>
  <para style="q" vid="PSA 35:16">קריצן זײ אױף מיר זײערע צײן.<verse eid="PSA 35:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 35:17" />אֲדֹנָי, װי לאַנג װעסטו צוזען?</para>
  <para style="q" vid="PSA 35:17">נעם אַװעק מײַן זעל פֿון זײערע פֿאַרװיסטונגען,</para>
  <para style="q" vid="PSA 35:17">פֿון די יונגלײבן מײַן אײנאײנציקע.<verse eid="PSA 35:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 35:18" />איך װעל דיר דאַנקען אין אַ גרױס געזעמל,</para>
  <para style="q" vid="PSA 35:18">אין פֿיל פֿאָלק װעל איך דיך לױבן.<verse eid="PSA 35:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 35:19" />זאָלן זיך נישט פֿרײען איבער מיר</para>
  <para style="q" vid="PSA 35:19">די װאָס זײַנען מיר פֿײַנט פֿאַר גאָרנישט;</para>
  <para style="q" vid="PSA 35:19">מײַנע אומזיסטיקע שָׂונאים</para>
  <para style="q" vid="PSA 35:19">װאָס װינקען מיטן אױג.<verse eid="PSA 35:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 35:20" />װאָרעם אומשָלום רעדן זײ,</para>
  <para style="q" vid="PSA 35:20">און קעגן די שטילע פֿון דער ערד</para>
  <para style="q" vid="PSA 35:20">טראַכטן זײ אױס פֿאַלשע שטיק.<verse eid="PSA 35:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 35:21" />און זײ עפֿענען ברײט זײער מױל אױף מיר;</para>
  <para style="q" vid="PSA 35:21">זײ זאָגן: אַהאַ! אַהאַ! אונדזער אױג האָט דערלעבט.<verse eid="PSA 35:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 35:22" />דו האָסט געזען, ה׳, זאָלסטו נישט פֿאַרשװײַגן;</para>
  <para style="q" vid="PSA 35:22">אֲדֹנָי, זאָלסט זיך נישט דערװײַטערן פֿון מיר.<verse eid="PSA 35:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 35:23" />דערװעק דיך און װאַך אױף צו מײַן משפּט,</para>
  <para style="q" vid="PSA 35:23">צו מײַן קריג, מײַן ג-ט און אֲדֹנָי.<verse eid="PSA 35:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 35:24" />משפּט מיך לױט דײַן גערעכטיקײט, ה׳ מײַן ג-ט,</para>
  <para style="q" vid="PSA 35:24">און זאָלן זײ זיך נישט פֿרײען איבער מיר.<verse eid="PSA 35:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 35:25" />זאָלן זײ נישט זאָגן אין זײער האַרצן:</para>
  <para style="q" vid="PSA 35:25">אַהאַ! אונדזער באַגער!</para>
  <para style="q" vid="PSA 35:25">זאָלן זײ נישט זאָגן:</para>
  <para style="q" vid="PSA 35:25">מיר האָבן אים אײַנגעשלונגען!<verse eid="PSA 35:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 35:26" />זאָלן פֿאַרשעמט און צו שאַנד װערן אין אײנעם</para>
  <para style="q" vid="PSA 35:26">די װאָס פֿרײען זיך אױף מײַן אומגליק;</para>
  <para style="q" vid="PSA 35:26">זאָלן באַקלײדט װערן מיט בושה און שמאַך</para>
  <para style="q" vid="PSA 35:26">די װאָס גרײסן זיך איבער מיר.<verse eid="PSA 35:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 35:27" />זאָלן זינגען און זיך פֿרײען</para>
  <para style="q" vid="PSA 35:27">די װאָס באַגערן מײַן גערעכטיקײט;</para>
  <para style="q" vid="PSA 35:27">און זאָלן זײ תּמיד זאָגן: געגרײסט זאָל זײַן ה׳,</para>
  <para style="q" vid="PSA 35:27">װאָס באַגערט דעם פֿריד פֿון זײַן קנעכט.<verse eid="PSA 35:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 35:28" />און מײַן צונג װעט רעדן דײַן גערעכטיקײט,</para>
  <para style="q" vid="PSA 35:28">אַ גאַנצן טאָג דײַן לױב.<verse eid="PSA 35:28" /></para>
  <chapter eid="PSA 35" />
  <chapter number="36" style="c" pubnumber="לו" sid="PSA 36" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 36:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון דעם קנעכט פֿון ה׳, פֿון דָוִדן.<verse eid="PSA 36:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 36:2" /> די זינד רעדט צום רשע – קלער איך אין האַרצן;</para>
  <para style="q" vid="PSA 36:2">נישטאָ ג-טס מורא פֿאַר זײַנע אױגן.<verse eid="PSA 36:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 36:3" /> װאָרעם צו פֿיל חַנפֿעט זי אים אין זײַנע אױגן,</para>
  <para style="q" vid="PSA 36:3">אַז ער זאָל קענען פֿײַנט האָבן זײַן פֿאַרברעך.<verse eid="PSA 36:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 36:4" /> די װערטער פֿון זײַן מױל זײַנען אומרעכט און באַטרוג,</para>
  <para style="q" vid="PSA 36:4">ער האָט אױפֿגעהערט פֿאַרשטײן צו טאָן גוטס.<verse eid="PSA 36:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 36:5" /> אומרעכט טראַכט ער אױף זײַן געלעגער,</para>
  <para style="q" vid="PSA 36:5">ער שטײט אױפֿן נישט גוטן װעג,</para>
  <para style="q" vid="PSA 36:5">דאָס בײז װערט אים נישט נמאס.<verse eid="PSA 36:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 36:6" /> ה׳, ביז אין די הימלען איז דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 36:6">דײַן טרײַשאַפֿט ביז די װאָלקן.<verse eid="PSA 36:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 36:7" /> דײַן גערעכטיקײט איז װי די מאַכטיקע בערג,</para>
  <para style="q" vid="PSA 36:7">דײַנע משפּטים װי דער גרױסער תּהום;</para>
  <para style="q" vid="PSA 36:7">מענטשן און בהמות טוסטו העלפֿן, ה׳.<verse eid="PSA 36:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 36:8" /> װי טײַער איז דײַן חֶסֶד, אלֹקים,</para>
  <para style="q" vid="PSA 36:8">און די מענטשנקינדער שיצן זיך</para>
  <para style="q" vid="PSA 36:8">אין שאָטן פֿון דײַנע פֿליגלען.<verse eid="PSA 36:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 36:9" /> זײ זעטן זיך מיט דער פֿעטקײט פֿון דײַן הױז,</para>
  <para style="q" vid="PSA 36:9">און פֿון דעם טײַך פֿון דײַנע תּענוגים טרינקסטו זײ אָן.<verse eid="PSA 36:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 36:10" /> װאָרעם בײַ דיר איז דער קװאַל פֿון לעבן,</para>
  <para style="q" vid="PSA 36:10">אין דײַן ליכט זעען מיר ליכטיקײט.<verse eid="PSA 36:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 36:11" /> צי אױס דײַן חֶסֶד צו די װאָס קענען דיך,</para>
  <para style="q" vid="PSA 36:11">און דײַן גערעכטיקײט צו די רעכטפֿאַרטיקע הערצער.<verse eid="PSA 36:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 36:12" /> זאָל נישט צוקומען צו מיר דער פֿוס פֿון גאװה,</para>
  <para style="q" vid="PSA 36:12">און די האַנט פֿון רשעים זאָל מיך נישט פֿאַרװאָגלען.<verse eid="PSA 36:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 36:13" /> אָן זײַנען געפֿאַלן די טוער פֿון אומרעכט,</para>
  <para style="q" vid="PSA 36:13">זײ זײַנען אַנידערגעשטױסן, און קענען נישט אױפֿשטײן.<verse eid="PSA 36:13" /></para>
  <chapter eid="PSA 36" />
  <chapter number="37" style="c" pubnumber="לז" sid="PSA 37" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 37:1" />פֿון דָוִדן.</para>
  <para style="q" vid="PSA 37:1">
    <char style="va">1</char>זאָלסט זיך נישט ערגערן װעגן די שלעכטסטוער,</para>
  <para style="q" vid="PSA 37:1">זאָלסט נישט מקנא זײַן די װאָס טוען אומרעכט.<verse eid="PSA 37:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 37:2" />װאָרעם גיך װי גראָז װעלן זײ פֿאַרשניטן װערן,</para>
  <para style="q" vid="PSA 37:2">און װי גרינע קרײַטעכץ װעלן זײ פֿאַרװעלקט װערן.<verse eid="PSA 37:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 37:3" />פֿאַרזיכער זיך אױף ה׳, און טו גוטס,</para>
  <para style="q" vid="PSA 37:3">זיץ רויִק אין לאַנד, און היט אָפּ װאָרהאַפֿטיקײט,<verse eid="PSA 37:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 37:4" />און קװיק זיך מיט ה׳,</para>
  <para style="q" vid="PSA 37:4">און ער װעט דיר געבן די פֿאַרלאַנגען פֿון דײַן האַרצן.<verse eid="PSA 37:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 37:5" />פֿאַרלאָז אױף ה׳ דײַן װעג,</para>
  <para style="q" vid="PSA 37:5">און פֿאַרזיכער זיך אױף אים, און ער װעט טאָן.<verse eid="PSA 37:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 37:6" />און ער װעט אַרױסברענגען װי דאָס ליכט דײַן גערעכטיקײט,</para>
  <para style="q" vid="PSA 37:6">און דײַן משפּט װי דער מיטן טאָג.<verse eid="PSA 37:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 37:7" />האַר צו ה׳, און האָף צו אים,</para>
  <para style="q" vid="PSA 37:7">זאָלסט זיך נישט ערגערן װעגן דעם װאָס איז מצליח אױף זײַן װעג,</para>
  <para style="q" vid="PSA 37:7">װעגן דעם מאַן װאָס טוט ליסטיקײטן.<verse eid="PSA 37:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 37:8" />לאָז אָפּ פֿון כּעס, און פֿאַרלאָז גרימצאָרן;</para>
  <para style="q" vid="PSA 37:8">זאָלסט זיך נישט ערגערן; דאָס פֿירט בלױז צום בײזן.<verse eid="PSA 37:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 37:9" />װאָרעם די שלעכטסטוער װעלן פֿאַרשניטן װערן,</para>
  <para style="q" vid="PSA 37:9">און די װאָס האָפֿן צו ה׳, זײ װעלן אַרבן דאָס לאַנד.<verse eid="PSA 37:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 37:10" />און נאָך אַ קלײן װײַלע, און דער רשע װעט נישט זײַן,</para>
  <para style="q" vid="PSA 37:10">און װעסט זיך אומקוקן אױף זײַן אָרט, און ער איז נישטאָ.<verse eid="PSA 37:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 37:11" />אָבער די געדריקטע װעלן אַרבן דאָס לאַנד,</para>
  <para style="q" vid="PSA 37:11">און װעלן זיך קװיקן מיט גרױס פֿריד.<verse eid="PSA 37:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 37:12" />דער רשע טראַכט בײז קעגן צדיק,</para>
  <para style="q" vid="PSA 37:12">און ער קריצט אױף אים זײַנע צײן.<verse eid="PSA 37:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 37:13" />אֲדֹנָי לאַכט פֿון אים,</para>
  <para style="q" vid="PSA 37:13">װאָרעם ער זעט אַז זײַן טאָג װעט קומען.<verse eid="PSA 37:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 37:14" />די רשעים ציִען אַרױס די שװערד,</para>
  <para style="q" vid="PSA 37:14">און שפּאַנען זײער בױגן,</para>
  <para style="q" vid="PSA 37:14">צו מאַכן פֿאַלן דעם אָרעמאַן און דעם אבֿיון,</para>
  <para style="q" vid="PSA 37:14">צו שעכטן די װאָס זײער װעג איז גלײַך.<verse eid="PSA 37:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 37:15" />װעט זײער שװערד אַרײַן אין זײער האַרצן,</para>
  <para style="q" vid="PSA 37:15">און זײערע בױגנס װעלן צעבראָכן װערן.<verse eid="PSA 37:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 37:16" />בעסער דאָס ביסל בײַם צדיק,</para>
  <para style="q" vid="PSA 37:16">אײדער די שפֿע פֿון פֿיל רשעים.<verse eid="PSA 37:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 37:17" />װאָרעם די אָרעמס פֿון די רשעים װעלן צעבראָכן װערן,</para>
  <para style="q" vid="PSA 37:17">אָבער די צדיקים לענט אונטער ה׳.<verse eid="PSA 37:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 37:18" />ה׳ מערקט די טעג פֿון די אומשולדיקע,</para>
  <para style="q" vid="PSA 37:18">און זײער אַרב װעט זײַן אױף אײביק.<verse eid="PSA 37:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 37:19" />זײ װעלן נישט פֿאַרשעמט װערן אין צײַט פֿון בײז,</para>
  <para style="q" vid="PSA 37:19">און אין טעג פֿון הונגער װעלן זײ זאַט זײַן.<verse eid="PSA 37:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 37:20" />װאָרעם די רשעים װעלן אונטערגײן,</para>
  <para style="q" vid="PSA 37:20">און די פֿײַנט פֿון ה׳</para>
  <para style="q" vid="PSA 37:20">אַזױ װי קעסטלעכע פֿעטע שאָף;</para>
  <para style="q" vid="PSA 37:20">זײ פֿאַרגײען, אין רױך פֿאַרגײען זײ.<verse eid="PSA 37:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 37:21" />דער רשע לײַט און באַצאָלט נישט,</para>
  <para style="q" vid="PSA 37:21">און דער צדיק לײַטזעליקט און גיט.<verse eid="PSA 37:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 37:22" />װאָרעם זײַנע געבענטשטע אַרבן דאָס לאַנד,</para>
  <para style="q" vid="PSA 37:22">און זײַנע פֿאַרשאָלטענע װערן פֿאַרשניטן.<verse eid="PSA 37:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 37:23" />פֿון ה׳ װערן אָנגעשטעלט די טריט פֿון מענטשן,</para>
  <para style="q" vid="PSA 37:23">און ער באַװיליקט זײַן װעג.<verse eid="PSA 37:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 37:24" />אַז ער פֿאַלט, בלײַבט ער נישט ליגן,</para>
  <para style="q" vid="PSA 37:24">װאָרעם ה׳ לענט אונטער זײַן האַנט.<verse eid="PSA 37:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PSA 37:25" />איך בין יונג געװען און בין אַלט געװאָרן,</para>
  <para style="q" vid="PSA 37:25">און איך האָב נישט געזען אַ צדיק פֿאַרלאָזן,</para>
  <para style="q" vid="PSA 37:25">און זײַן זאָמען בעטלענדיק ברױט.<verse eid="PSA 37:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 37:26" />אַ גאַנצן טאָג איז ער לײַטזעליק און אַנטלײַט,</para>
  <para style="q" vid="PSA 37:26">און זײַן זאָמען איז אַ בענטשונג.<verse eid="PSA 37:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 37:27" />קער זיך אָפּ פֿון שלעכטס, און טו גוטס,</para>
  <para style="q" vid="PSA 37:27">און בלײַב רוען אױף אײביק.<verse eid="PSA 37:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 37:28" />װאָרעם ה׳ האָט ליב גערעכטיקײט,</para>
  <para style="q" vid="PSA 37:28">און פֿאַרלאָזט נישט זײַנע פֿרומע;</para>
  <para style="q" vid="PSA 37:28">אײביק װערן זײ אָפּגעהיט,</para>
  <para style="q" vid="PSA 37:28">אָבער דער זאָמען פֿון די רשעים װערט פֿאַרשניטן.<verse eid="PSA 37:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 37:29" />די צדיקים װעלן אַרבן דאָס לאַנד,</para>
  <para style="q" vid="PSA 37:29">און װעלן װױנען דערױף שטענדיק.<verse eid="PSA 37:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" sid="PSA 37:30" />דאָס מױל פֿון דעם צדיק לאָזט אַרױס חכמה,</para>
  <para style="q" vid="PSA 37:30">און זײַן צונג רעדט גערעכטיקײט.<verse eid="PSA 37:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 37:31" />די תּורה פֿון זײַן ג-ט איז אין זײַן האַרצן,</para>
  <para style="q" vid="PSA 37:31">זײַנע טריט גליטשן זיך נישט אױס.<verse eid="PSA 37:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 37:32" />דער רשע קוקט אױס אױפֿן צדיק,</para>
  <para style="q" vid="PSA 37:32">און זוכט אים צו טײטן.<verse eid="PSA 37:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 37:33" />ה׳ װעט אים נישט איבערלאָזן אין זײַן האַנט,</para>
  <para style="q" vid="PSA 37:33">און נישט לאָזן אים שולדיק מאַכן, אַז ער װערט געמשפּט.<verse eid="PSA 37:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="PSA 37:34" />האָף צו ה׳, און היט זײַן װעג,</para>
  <para style="q" vid="PSA 37:34">און ער װעט דיך דערהײבן צו אַרבן דאָס לאַנד;</para>
  <para style="q" vid="PSA 37:34">װעסט צוזען װי די רשעים װערן פֿאַרשניטן.<verse eid="PSA 37:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" sid="PSA 37:35" />איך האָב געזען דעם רשע מאַכטיק,</para>
  <para style="q" vid="PSA 37:35">און צעשפּרײט װי אַ צװײַגהאַפֿטיקער אַלטגעזעסענער בױם;<verse eid="PSA 37:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 37:36" />אָבער מע איז פֿאַרבײַגעגאַנגען,</para>
  <para style="q" vid="PSA 37:36">ערשט ער איז נישטאָ,</para>
  <para style="q" vid="PSA 37:36">און איך האָב אים געזוכט,</para>
  <para style="q" vid="PSA 37:36">און ער איז נישט געװען צו געפֿינען.<verse eid="PSA 37:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="PSA 37:37" />באַטראַכט דעם אומשולדיקן, און זע דעם רעכטפֿאַרטיקן,</para>
  <para style="q" vid="PSA 37:37">אַז דער סוף פֿון איטלעכן איז אַ גליקלעכער.<verse eid="PSA 37:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 37:38" />און די פֿאַרברעכער װערן פֿאַרטיליקט אין אײנעם,</para>
  <para style="q" vid="PSA 37:38">דער סוף פֿון די רשעים װערט פֿאַרשניטן.<verse eid="PSA 37:38" /></para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" sid="PSA 37:39" />אָבער די הילף פֿון די צדיקים איז פֿון ה׳,</para>
  <para style="q" vid="PSA 37:39">זײער פֿעסטונג אין צײַט פֿון נױט.<verse eid="PSA 37:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 37:40" />און ה׳ שטײט זײ בײַ, און מאַכט זײ אַנטרינען,</para>
  <para style="q" vid="PSA 37:40">ער מאַכט זײ אַנטרינען פֿון די רשעים, און העלפֿט זײ,</para>
  <para style="q" vid="PSA 37:40">װײַל זײ האָבן זיך געשיצט אין אים.<verse eid="PSA 37:40" /></para>
  <chapter eid="PSA 37" />
  <chapter number="38" style="c" pubnumber="לח" sid="PSA 38" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 38:1" />אַ מיזמור פֿון דָוִדן, אױף אַ דערמאָנונג.<verse eid="PSA 38:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 38:2" /> נישט אין דײַן כּעס, ה׳, זאָלסטו מיך מוסרן,</para>
  <para style="q" vid="PSA 38:2">און אין דײַן גרימצאָרן זאָלסטו מיך שטראָפֿן.<verse eid="PSA 38:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 38:3" /> װאָרעם דײַנע פֿײַלן האָבן גענידערט אין מיר,</para>
  <para style="q" vid="PSA 38:3">און אױף מיר האָט גענידערט דײַן האַנט.<verse eid="PSA 38:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 38:4" /> נישטאָ קײן גאַנץ גליד אין מײַן לײַב</para>
  <para style="q" vid="PSA 38:4">פֿון װעגן דײַן צאָרן,</para>
  <para style="q" vid="PSA 38:4">נישטאָ קײן פֿריד אין מײַנע בײנער</para>
  <para style="q" vid="PSA 38:4">פֿון װעגן מײַן חטא.<verse eid="PSA 38:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 38:5" /> װאָרעם מײַנע זינד גײען איבער מײַן קאָפּ,</para>
  <para style="q" vid="PSA 38:5">װי אַ שװערע משׂא זײַנען זײ צו שװער פֿאַר מיר.<verse eid="PSA 38:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 38:6" /> עס פֿױלן, עס אײַטערן מײַנע װוּנדן</para>
  <para style="q" vid="PSA 38:6">פֿון װעגן מײַן נאַרישקײט;<verse eid="PSA 38:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 38:7" /> איך בין צעקרימט, איך בין געבױגן ביז גאָר,</para>
  <para style="q" vid="PSA 38:7">אַ גאַנצן טאָג גײ איך אום פֿינצטער.<verse eid="PSA 38:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 38:8" /> װאָרעם מײַנע לענדן זײַנען פֿול מיט בראַנד,</para>
  <para style="q" vid="PSA 38:8">און נישטאָ קײן גאַנץ גליד אין מײַן לײַב.<verse eid="PSA 38:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 38:9" /> איך בין באַנומען און דערשלאָגן ביז גאָר,</para>
  <para style="q" vid="PSA 38:9">איך שרײַ פֿון דער ברומונג פֿון מײַן האַרצן.<verse eid="PSA 38:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 38:10" /> אֲדֹנָי, אַל מײַן קרעכצן איז פֿאַר דיר,</para>
  <para style="q" vid="PSA 38:10">און מײַן זיפֿצן איז פֿון דיר נישט פֿאַרבאָרגן.<verse eid="PSA 38:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 38:11" /> מײַן האַרץ שװינדלט,</para>
  <para style="q" vid="PSA 38:11">מײַן כּוֹח האָט מיך פֿאַרלאָזט;</para>
  <para style="q" vid="PSA 38:11">און דאָס ליכט פֿון מײַנע אױגן,</para>
  <para style="q" vid="PSA 38:11">דאָס אױך איז בײַ מיר מער נישטאָ.<verse eid="PSA 38:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 38:12" /> מײַנע גוטע פֿרײַנט און מײַנע חבֿרים</para>
  <para style="q" vid="PSA 38:12">שטײען אַװעק פֿון מײַן פּלאָג,</para>
  <para style="q" vid="PSA 38:12">און מײַנע נאָנטע שטײען פֿון דער װײַטן.<verse eid="PSA 38:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 38:13" /> און נעצן לײגן די װאָס זוכן מײַן לעבן,</para>
  <para style="q" vid="PSA 38:13">און די װאָס זײַנען מיר אױסן בײז רעדן אומגליקן,</para>
  <para style="q" vid="PSA 38:13">און באַטרוגן טראַכטן זײ אַ גאַנצן טאָג.<verse eid="PSA 38:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 38:14" /> און איך בין װי אַ טױבער, איך הער נישט,</para>
  <para style="q" vid="PSA 38:14">און װי אַ שטומער װאָס עפֿנט נישט זײַן מױל.<verse eid="PSA 38:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 38:15" /> יאָ, איך בין װי אַ מענטש װאָס הערט נישט,</para>
  <para style="q" vid="PSA 38:15">און אין זײַן מױל זײַנען קײן טענות נישטאָ.<verse eid="PSA 38:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 38:16" /> װאָרעם צו דיר, ה׳, טו איך האָפֿן;</para>
  <para style="q" vid="PSA 38:16">דו װעסט ענטפֿערן, אֲדֹנָי מײַן ג-ט.<verse eid="PSA 38:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 38:17" /> װאָרעם איך זאָג:</para>
  <para style="q" vid="PSA 38:17">זאָלן זײ נישט דערפֿרײט װערן איבער מיר;</para>
  <para style="q" vid="PSA 38:17">אַז מײַן פֿוס גליטשט זיך אױס,</para>
  <para style="q" vid="PSA 38:17">גרײסן זײ זיך איבער מיר.<verse eid="PSA 38:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 38:18" /> װאָרעם איך בין אָנגעברײט צום פֿאַלן,</para>
  <para style="q" vid="PSA 38:18">און מײַן װײטאָג איז אַנטקעגן מיר תּמיד.<verse eid="PSA 38:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 38:19" /> װאָרעם איך גיב צו מײַן זינד,</para>
  <para style="q" vid="PSA 38:19">איך בין באַקומערט װעגן מײַן חטא.<verse eid="PSA 38:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 38:20" /> און מײַנע פֿײַנט אום לעבן זײַנען שטאַרק,</para>
  <para style="q" vid="PSA 38:20">און פֿיל מײַנע שָׂונאים פֿאַר גאָרנישט.<verse eid="PSA 38:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 38:21" /> און די װאָס באַצאָלן אַ רָעה פֿאַר אַ טובֿה,</para>
  <para style="q" vid="PSA 38:21">פֿײַנטן מיך פֿאַר מײַן נאָכיאָגן גוטס.<verse eid="PSA 38:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 38:22" /> נישט פֿאַרלאָזן זאָלסטו מיך, ה׳,</para>
  <para style="q" vid="PSA 38:22">נישט דערװײַטערן זאָלסטו זיך פֿון מיר, מײַן ג-ט.<verse eid="PSA 38:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 38:23" /> אײַל מיר צו הילף,</para>
  <para style="q" vid="PSA 38:23">אֲדֹנָי מײַן ישועה.<verse eid="PSA 38:23" /></para>
  <chapter eid="PSA 38" />
  <chapter number="39" style="c" pubnumber="לט" sid="PSA 39" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 39:1" />פֿאַר דעם געזאַנגמײַסטער, פֿאַר ידותון; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 39:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 39:2" /> איך האָב געזאָגט: איך װעל היטן מײַנע װעגן</para>
  <para style="q" vid="PSA 39:2">פֿון צו זינדיקן מיט מײַן צונג;</para>
  <para style="q" vid="PSA 39:2">איך װעל האַלטן אַ שלאָס אױף מײַן מױל,</para>
  <para style="q" vid="PSA 39:2">בעת דער רשע איז פֿאַר מיר.<verse eid="PSA 39:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 39:3" /> איך בין שטיל אַנטשטומט געװען,</para>
  <para style="q" vid="PSA 39:3">איך האָב געשװיגן, אָן גוטס,</para>
  <para style="q" vid="PSA 39:3">און מײַן װײטאָג איז געװען אײַנגעהאַלטן.<verse eid="PSA 39:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 39:4" /> איז מײַן האַרץ אין מיר הײס געװאָרן,</para>
  <para style="q" vid="PSA 39:4">האָט אין מײַן געמיט זיך אַ פֿײַער צעברענט;</para>
  <para style="q" vid="PSA 39:4">האָב איך גערעדט מיט מײַן צונג:<verse eid="PSA 39:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 39:5" /> לאָז מיך װיסן, ה׳, מײַן סוף,</para>
  <para style="q" vid="PSA 39:5">און די מאָס פֿון מײַנע טעג, װאָס זי איז,</para>
  <para style="q" vid="PSA 39:5">לאָמיך װיסן װי פֿאַרגײיִק איך בין.<verse eid="PSA 39:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 39:6" /> זע, װי אַ שפּאַן האָסטו געמאַכט מײַנע טעג,</para>
  <para style="q" vid="PSA 39:6">און מײַן געדױער איז װי גאָרנישט קעגן דיר;</para>
  <para style="q" vid="PSA 39:6">פֿאַר װאָר, אַ בלױזער הױך װאָס באַשטײט איז איטלעכער מענטש.</para>
  <para style="q" vid="PSA 39:6">סֶלָה.<verse eid="PSA 39:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 39:7" /> בלױז װי אַן אָפּדוכט גײט אום דער מענטש,</para>
  <para style="q" vid="PSA 39:7">בלױז אומנישט טומלען זײ;</para>
  <para style="q" vid="PSA 39:7">ער קלײַבט, און ער װײס נישט װער דאָס װעט אײַנזאַמלען.<verse eid="PSA 39:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 39:8" /> און אַצונד, װאָס זאָל איך האָפֿן, אָ אֲדֹנָי?</para>
  <para style="q" vid="PSA 39:8">מײַנע האָפֿענונג איז צו דיר.<verse eid="PSA 39:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 39:9" /> זײַ מיך מציל פֿון אַלע מײַנע פֿאַרברעכן;</para>
  <para style="q" vid="PSA 39:9">זאָלסט מיך נישט מאַכן צום שפּאָט פֿון דעם נידערטרעכטיקן.<verse eid="PSA 39:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 39:10" /> איך בין שטום, איך עפֿן נישט מײַן מױל,</para>
  <para style="q" vid="PSA 39:10">װאָרעם דו האָסט עס געטאָן.<verse eid="PSA 39:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 39:11" /> טו אָפּ פֿון מיר דײַן פּלאָג,</para>
  <para style="q" vid="PSA 39:11">פֿון דעם שטרײַט פֿון דײַן האַנט װער איך פֿאַרלענדט.<verse eid="PSA 39:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 39:12" /> װאָלסטו מיט שטראָפֿרײד געמוסרט דעם מענטשן פֿאַר זינד!</para>
  <para style="q" vid="PSA 39:12">אָבער מאַכסט צעקריכן װי מאָיל זײַן שײנקײט.</para>
  <para style="q" vid="PSA 39:12">בלױז אַ הױך איז איטלעכער מענטש.</para>
  <para style="q" vid="PSA 39:12">סֶלָה.<verse eid="PSA 39:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 39:13" /> הער צו מײַן תּפֿילה, ה׳, און מײַן געשרײ פֿאַרנעם;</para>
  <para style="q" vid="PSA 39:13">אױף מײַן טרער זאָלסטו נישט שװײַגן;</para>
  <para style="q" vid="PSA 39:13">װאָרעם אַ פֿרעמדער בין איך בײַ דיר,</para>
  <para style="q" vid="PSA 39:13">אַן אײַנגעװאַנדערטער װי אַלע מײַנע עלטערן.<verse eid="PSA 39:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 39:14" /> קוק אַװעק פֿון מיר, און לאָמיך זיך אױפֿמונטערן,</para>
  <para style="q" vid="PSA 39:14">אײדער איך װעל אַװעקגײן און מער נישט זײַן.<verse eid="PSA 39:14" /></para>
  <chapter eid="PSA 39" />
  <chapter number="40" style="c" pubnumber="מ" sid="PSA 40" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 40:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון דָוִדן אַ מיזמור.<verse eid="PSA 40:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 40:2" /> האָפֿן געהאָפֿט האָב איך אױף ה׳,</para>
  <para style="q" vid="PSA 40:2">און ער האָט זיך גענײגט צו מיר,</para>
  <para style="q" vid="PSA 40:2">און צוגעהערט מײַן געשרײ.<verse eid="PSA 40:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 40:3" /> און ער האָט מיך אַרױפֿגעבראַכט פֿון דער װיסטער גרוב,</para>
  <para style="q" vid="PSA 40:3">פֿון דעם זומפּיקן לײם,</para>
  <para style="q" vid="PSA 40:3">און ער האָט געשטעלט אױף אַ פֿעלדז מײַנע פֿיס,</para>
  <para style="q" vid="PSA 40:3">ער האָט באַפֿעסטיקט מײַנע טריט.<verse eid="PSA 40:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 40:4" /> און ער האָט געגעבן אין מײַן מױל אַ נײַ געזאַנג,</para>
  <para style="q" vid="PSA 40:4">אַ לױב צו אלוקינו.</para>
  <para style="q" vid="PSA 40:4">פֿיל װעלן זען און װעלן פֿאָרכטן,</para>
  <para style="q" vid="PSA 40:4">און װעלן זיך פֿאַרזיכערן אױף ה׳.<verse eid="PSA 40:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 40:5" /> געבענטשט איז דער מענטש װאָס האָט געמאַכט ה׳ זײַן פֿאַרזיכערונג,</para>
  <para style="q" vid="PSA 40:5">און זיך נישט געװענדט צו די האָפֿערדיקע,</para>
  <para style="q" vid="PSA 40:5">און צו די װאָס קערן זיך אָפּ צו פֿאַלשקײט.<verse eid="PSA 40:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 40:6" /> פֿיל האָסטו אױפֿגעטאָן, ה׳ מײַן ג-ט –</para>
  <para style="q" vid="PSA 40:6">דײַנע װוּנדער און דײַנע טראַכטונגען</para>
  <para style="q" vid="PSA 40:6">פֿון אונדזערט װעגן;</para>
  <para style="q" vid="PSA 40:6">נישטאָ קײן גלײַכן צו דיר.</para>
  <para style="q" vid="PSA 40:6">זאָל איך דערצײלן און זאָגן,</para>
  <para style="q" vid="PSA 40:6">זײַנען זײ צו פֿיל אױסצורעכענען.<verse eid="PSA 40:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 40:7" /> שלאַכטאָפּפֿער און שפּײַזאָפּפֿער האָסט דו נישט פֿאַרלאַנגט,</para>
  <para style="q" vid="PSA 40:7">אָבער מײַנע אױערן האָסטו דו אױפֿגעמאַכט –</para>
  <para style="q" vid="PSA 40:7">בראַנדאָפּפֿער און זינדאָפּפֿער פֿאַרלאַנגסטו נישט.<verse eid="PSA 40:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 40:8" /> דערום האָב איך געזאָגט: זע, איך בין געקומען,</para>
  <para style="q" vid="PSA 40:8">אין די מגלה פֿון דעם סֵפֿר איז װעגן מיר געשריבן.<verse eid="PSA 40:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 40:9" /> צו טאָן דײַן רָצון, מײַן ג-ט, האָב איך באַגערט,</para>
  <para style="q" vid="PSA 40:9">און דײַן תּורה איז אין מײַנע אינגעװײד.<verse eid="PSA 40:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 40:10" /> איך האָב מבֿשׂר זײַן גערעכטיקײט אין אַ גרױס געזעמל;</para>
  <para style="q" vid="PSA 40:10">זע, מײַנע ליפּן טו איך נישט פֿאַרמײַדן;</para>
  <para style="q" vid="PSA 40:10">ה׳, דו װײסט דאָך.<verse eid="PSA 40:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 40:11" /> דײַן גערעכטיקײט האָב איך נישט פֿאַרדעקט אין מײַן האַרצן,</para>
  <para style="q" vid="PSA 40:11">דײַן טרײַשאַפֿט און דײַן הילף האָב איך דערצײלט;</para>
  <para style="q" vid="PSA 40:11">איך האָב נישט פֿאַרהױלן דײַן גענאָד</para>
  <para style="q" vid="PSA 40:11">און דײַן אמת פֿאַרן גרױסן געזעמל.<verse eid="PSA 40:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 40:12" /> נישט פֿאַרמײַדן זאָלסטו דו, ה׳, דײַן דערבאַרעמונג פֿון מיר,</para>
  <para style="q" vid="PSA 40:12">דײַן גענאָד און דײַן אמת זאָלן מיך תּמיד באַהיטן.<verse eid="PSA 40:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 40:13" /> װאָרעם אַרומגערינגלט האָבן מיך בײזן אַזש אָן צאָל,</para>
  <para style="q" vid="PSA 40:13">דערגרײכט האָבן מיך מײַנע זינד,</para>
  <para style="q" vid="PSA 40:13">אַז איך קען נישט זען;</para>
  <para style="q" vid="PSA 40:13">זײ זײַנען מער װי די האָר פֿון מײַן קאָפּ,</para>
  <para style="q" vid="PSA 40:13">און מײַן האַרץ האָט מיך פֿאַרלאָזן.<verse eid="PSA 40:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 40:14" /> באַװיליק, ה׳, מיך מציל צו זײַן,</para>
  <para style="q" vid="PSA 40:14">ה׳, אײַל מיר צו הילף.<verse eid="PSA 40:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 40:15" /> זאָל פֿאַרשעמט און צו שאַנד װערן אין אײנעם</para>
  <para style="q" vid="PSA 40:15">די װאָס זוכן מײַן לעבן, עס אומצוברענגען;</para>
  <para style="q" vid="PSA 40:15">זאָלן אָפּטרעטן אַהינטער און זיך שעמען</para>
  <para style="q" vid="PSA 40:15">די װאָס װינטשן מיר בײז.<verse eid="PSA 40:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 40:16" /> זאָלן באַנומען װערן פֿון װעגן זײער שאַנד</para>
  <para style="q" vid="PSA 40:16">די װאָס זאָגן אױף מיר: אַהאַ! אַהאַ!<verse eid="PSA 40:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 40:17" /> זאָלן זײַן לוסטיק און זיך פֿרײען מיט דיר</para>
  <para style="q" vid="PSA 40:17">אַלע װאָס זוכן דיך;</para>
  <para style="q" vid="PSA 40:17">זאָלן תּמיד זאָגן: געגרײסט זאָל זײַן ה׳!</para>
  <para style="q" vid="PSA 40:17">די װאָס האָבן ליב דײַן ישועה.<verse eid="PSA 40:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 40:18" /> און איך אָרימער און באַדערפֿטיקער –</para>
  <para style="q" vid="PSA 40:18">זאָל אֲדֹנָי דאָס מיר צורעכענען.</para>
  <para style="q" vid="PSA 40:18">דו ביסט מײַן הילף, און דער װאָס מאַכט מיך אַנטרינען;</para>
  <para style="q" vid="PSA 40:18">אָ מײַן ג-ט, זאָלסט זיך נישט זאַמען.<verse eid="PSA 40:18" /></para>
  <chapter eid="PSA 40" />
  <chapter number="41" style="c" pubnumber="מא" sid="PSA 41" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 41:1" />פֿאַר דעם געזאַנגמײַסטער; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 41:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 41:2" /> װױל צו דעם װאָס גיט אַכט אױפֿן אָרעמאַן!</para>
  <para style="q" vid="PSA 41:2">אין טאָג פֿון בײז װעט אים ה׳ מאַכן אַנטרינען.<verse eid="PSA 41:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 41:3" /> ה׳ װעט אים באַהיטן און אים לאָזן לעבן,</para>
  <para style="q" vid="PSA 41:3">און ער װעט זײַן באַגליקט אין לאַנד;</para>
  <para style="q" vid="PSA 41:3">און װעסט אים נישט איבערגעבן</para>
  <para style="q" vid="PSA 41:3">אױף דעם באַראָט פֿון זײַנע פֿײַנט.<verse eid="PSA 41:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 41:4" /> ה׳ װעט אים אונטערלענען אױפֿן קראַנקן בעט;</para>
  <para style="q" vid="PSA 41:4">די גאַנצע צײַט פֿון זײַן ליגן פֿאַרנעמסטו זיך מיט זײַן קראַנקשאַפֿט.<verse eid="PSA 41:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 41:5" /> איך זאָג: ה׳, לײַטזעליק מיך,</para>
  <para style="q" vid="PSA 41:5">הײל מײַן זעל, װאָרעם איך האָב געזינדיקט צו דיר.<verse eid="PSA 41:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 41:6" /> מײַנע פֿײַנט רעדן שלעכטס װעגן מיר:</para>
  <para style="q" vid="PSA 41:6">װען װעט ער שטאַרבן, און זײַן נאָמען זאָל אונטערגײן!<verse eid="PSA 41:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 41:7" /> און אַז עמעצער קומט זען, רעדט ער פֿאַלש,</para>
  <para style="q" vid="PSA 41:7">זײַן האַרץ זאַמלט אָן אין זיך בײז;</para>
  <para style="q" vid="PSA 41:7">גײט ער אַרױס אין גאַס, רעדט ער דערפֿון.<verse eid="PSA 41:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 41:8" /> אין אײנעם סוֹדען זיך אױף מיר אַלע מײַנע שָׂונאים,</para>
  <para style="q" vid="PSA 41:8">זײ טראַכטן װעגן מיר בײז קעגן מיר:<verse eid="PSA 41:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 41:9" /> אַ בײזע זאַך איז אױסגעגאָסן אױף אים,</para>
  <para style="q" vid="PSA 41:9">און װי ער האָט זיך געלײגט, װעט ער מער נישט אױפֿשטײן.<verse eid="PSA 41:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 41:10" /> אַפֿילו מײַן גוטער פֿרײַנט װאָס איך האָב מיך פֿאַרזיכערט אױף אים,</para>
  <para style="q" vid="PSA 41:10">דער װאָס עסט מײַן ברױט, הײבט אױף אַ פֿוס אױף מיר.<verse eid="PSA 41:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 41:11" /> אָבער דו ה׳ לײַטזעליק מיך,</para>
  <para style="q" vid="PSA 41:11">און ריכט מיך אױף, און לאָמיך זײ אָפּצאָלן.<verse eid="PSA 41:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 41:12" /> דערמיט װעל איך װיסן אַז דו באַגערסט מיך,</para>
  <para style="q" vid="PSA 41:12">װאָס נישט שאַלן װעט מײַן פֿײַנט איבער מיר.<verse eid="PSA 41:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 41:13" /> און איך – אין מײַן ערלעכקײט װעסטו מיך אױפֿהאַלטן,</para>
  <para style="q" vid="PSA 41:13">און װעסטו מיך לאָזן שטײן פֿאַר דיר אײביק.<verse eid="PSA 41:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 41:14" /> ברוך ה׳ אלוקי יִשׂרָאֵל</para>
  <para style="q" vid="PSA 41:14">פֿון אײביק און ביז אײביק.</para>
  <para style="q" vid="PSA 41:14">אָמן און אָמן!<verse eid="PSA 41:14" /></para>
  <chapter eid="PSA 41" />
  <chapter number="42" style="c" pubnumber="מב" sid="PSA 42" />
  <para style="ms">צװײטער סֵפֿר</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 42:1" />פֿאַר דעם געזאַנגמײַסטער; אַ באַטראַכטונג פֿון די קינדער פֿון קֹרַח.<verse eid="PSA 42:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 42:2" /> װי אַ הינד לעכצט נאָך בעכן װאַסער,</para>
  <para style="q" vid="PSA 42:2">אַזױ לעכצט מײַן זעל נאָך דיר, אלֹקים.<verse eid="PSA 42:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 42:3" /> מײַן זעל טוט דאָרשטן נאָך אלֹקים,</para>
  <para style="q" vid="PSA 42:3">נאָך דעם לעבעדיקן אֵל:</para>
  <para style="q" vid="PSA 42:3">װען װעל איך קומען, און זיך װײַזן פֿאַר אלֹקים?<verse eid="PSA 42:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 42:4" /> מײַן טרער איז געװאָרן מײַן שפּײַז טאָג און נאַכט,</para>
  <para style="q" vid="PSA 42:4">אַז מע זאָגט מיר אַ גאַנצן טאָג:</para>
  <para style="q" vid="PSA 42:4">װוּ איז דײַן ג-ט?<verse eid="PSA 42:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 42:5" /> דאָס טו איך דערמאָנען,</para>
  <para style="q" vid="PSA 42:5">און גיס אױס מײַן זעל אין מיר:</para>
  <para style="q" vid="PSA 42:5">װי איך פֿלעג דורכגײן מיט אַן עולם,</para>
  <para style="q" vid="PSA 42:5">זײ פֿירן צום הױז פֿון אלֹקים</para>
  <para style="q" vid="PSA 42:5">מיט אַ קֹול פֿון געזאַנג און לױב,</para>
  <para style="q" vid="PSA 42:5">אַ יוֹם-טובֿדיק געזעמל.<verse eid="PSA 42:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 42:6" /> װאָס ביסטו געבױגן מײַן זעל,</para>
  <para style="q" vid="PSA 42:6">און טוסט ברומען אין מיר?</para>
  <para style="q" vid="PSA 42:6">האָף צו אלֹקים, װאָרעם איך װעל אים נאָך לױבן</para>
  <para style="q" vid="PSA 42:6">פֿאַר דער הילף פֿון זײַן פּנים.<verse eid="PSA 42:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 42:7" /> מײַן ג-ט, מײַן זעל איז געבױגן אין מיר,</para>
  <para style="q" vid="PSA 42:7">װאָרעם איך טו דיך דערמאָנען,</para>
  <para style="q" vid="PSA 42:7">פֿון יַרדן-לאַנד און די חֶרמוֹנס,</para>
  <para style="q" vid="PSA 42:7">פֿון דעם באַרג מִצעָר.<verse eid="PSA 42:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 42:8" /> תּהום צו תּהום טוט רופֿן</para>
  <para style="q" vid="PSA 42:8">אין דעם קֹול פֿון דײַנע װאַסערפֿאַלן;</para>
  <para style="q" vid="PSA 42:8">אַלע דײַנע אינדן און דײַנע װעלן</para>
  <para style="q" vid="PSA 42:8">זײַנען אַריבער אױף מיר.<verse eid="PSA 42:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 42:9" /> בײַ טאָג באַפֿעלט ה׳ זײַן חֶסֶד,</para>
  <para style="q" vid="PSA 42:9">און בײַ נאַכט איז זײַן געזאַנג מיט מיר,</para>
  <para style="q" vid="PSA 42:9">אַ תּפֿילה צו דעם אֵל פֿון מײַן לעבן.<verse eid="PSA 42:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 42:10" /> איך זאָג צו אֵל מײַן פֿעלדז:</para>
  <para style="q" vid="PSA 42:10">פֿאַר װאָס האָסטו מיך פֿאַרגעסן?</para>
  <para style="q" vid="PSA 42:10">פֿאַר װאָס מוז איך פֿינצטער אומגײן</para>
  <para style="q" vid="PSA 42:10">פֿון װעגן דער דריקונג פֿון שׂונא?<verse eid="PSA 42:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 42:11" /> מיט רציחה אַזש אין מײַנע בײנער</para>
  <para style="q" vid="PSA 42:11">לעסטערן מיך מײַנע פֿײַנט,</para>
  <para style="q" vid="PSA 42:11">אַז זײ זאָגן צו מיר אַ גאַנצן טאָג:</para>
  <para style="q" vid="PSA 42:11">װוּ איז דײַן ג-ט?<verse eid="PSA 42:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 42:12" /> װאָס ביסטו געבױגן מײַן זעל,</para>
  <para style="q" vid="PSA 42:12">און װאָס טוסטו ברומען אין מיר?</para>
  <para style="q" vid="PSA 42:12">האָף צו אלֹקים, װאָרעם איך װעל אים נאָך לױבן –</para>
  <para style="q" vid="PSA 42:12">די הילף פֿון מײַן פּנים, און מײַן ג-ט.<verse eid="PSA 42:12" /></para>
  <chapter eid="PSA 42" />
  <chapter number="43" style="c" pubnumber="מג" sid="PSA 43" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 43:1" />טו מיר רעכט, אלֹקים,</para>
  <para style="q" vid="PSA 43:1">און קריג מײַן קריג קעגן פֿאָלק אומדערבאַרעמדיק;</para>
  <para style="q" vid="PSA 43:1">פֿון דעם מאַן פֿון באַטרוג און אומרעכט</para>
  <para style="q" vid="PSA 43:1">זאָלסטו מיך מאַכן אַנטרינען.<verse eid="PSA 43:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 43:2" />דו ביסט דאָך דער אלֹקים פֿון מײַן שטאַרקײט,</para>
  <para style="q" vid="PSA 43:2">פֿאַר װאָס האָסטו מיך פֿאַרלאָזן?</para>
  <para style="q" vid="PSA 43:2">פֿאַר װאָס מוז איך פֿינצטער אומגײן</para>
  <para style="q" vid="PSA 43:2">פֿון װעגן דער דריקונג פֿון שׂונא?<verse eid="PSA 43:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 43:3" />שיק דײַן ליכט און דײַן אמת,</para>
  <para style="q" vid="PSA 43:3">זײ זאָלן מיך פֿירן;</para>
  <para style="q" vid="PSA 43:3">זײ זאָלן מיך ברענגען צו דײַן הײליקן באַרג,</para>
  <para style="q" vid="PSA 43:3">און צו די װױנונגען דײַנע.<verse eid="PSA 43:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 43:4" />און לאָמיך קומען צום מזבח פֿון אלֹקים,</para>
  <para style="q" vid="PSA 43:4">צו אֵל, דער פֿרײד פֿון מײַן לוסטיקײט;</para>
  <para style="q" vid="PSA 43:4">און לאָמיך דיך לױבן אױף אַ האַרף,</para>
  <para style="q" vid="PSA 43:4">אלֹקים מײַן ג-ט.<verse eid="PSA 43:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 43:5" />װאָס ביסטו געבױגן מײַן זעל,</para>
  <para style="q" vid="PSA 43:5">און װאָס טוסטו ברומען אין מיר?</para>
  <para style="q" vid="PSA 43:5">האָף צו אלֹקים, װאָרעם איך װעל אים נאָך לױבן –</para>
  <para style="q" vid="PSA 43:5">די הילף פֿון מײַן פּנים, און מײַן ג-ט.<verse eid="PSA 43:5" /></para>
  <chapter eid="PSA 43" />
  <chapter number="44" style="c" pubnumber="מד" sid="PSA 44" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 44:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון די קינדער פֿון קֹרַח אַ באַטראַכטונג.<verse eid="PSA 44:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 44:2" /> אלֹקים, מיט אונדזערע אױערן האָבן מיר געהערט,</para>
  <para style="q" vid="PSA 44:2">אונדזערע עלטערן האָבן אונדז דערצײלט,</para>
  <para style="q" vid="PSA 44:2">די טוּונג װאָס דו האָסט געטאָן אין זײערע טעג,</para>
  <para style="q" vid="PSA 44:2">אין די טעג פֿון פֿאַרצײַטן.<verse eid="PSA 44:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 44:3" /> דו מיט דײַן האַנט האָסט פֿעלקער פֿאַרטריבן,</para>
  <para style="q" vid="PSA 44:3">און זײ האָסטו אײַנגעפֿלאַנצט,</para>
  <para style="q" vid="PSA 44:3">האָסט צעבראָכן אומות,</para>
  <para style="q" vid="PSA 44:3">און זײ האָסט דו אַװעקגעשיקט.<verse eid="PSA 44:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 44:4" /> װאָרעם נישט מיט זײער שװערד האָבן זײ געאַרבט דאָס לאַנד,</para>
  <para style="q" vid="PSA 44:4">און נישט זײער אָרעם האָט זײ געהאָלפֿן,</para>
  <para style="q" vid="PSA 44:4">נאָר דײַן רעכטע האַנט און דײַן אָרעם,</para>
  <para style="q" vid="PSA 44:4">און דאָס ליכט פֿון דײַן פּנים,</para>
  <para style="q" vid="PSA 44:4">װײַל דו האָסט זײ באַװיליקט.<verse eid="PSA 44:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 44:5" /> דו ביסט מײַן קיניג, אלֹקים;</para>
  <para style="q" vid="PSA 44:5">באַפֿעל די ישועה פֿון יעקבֿ.<verse eid="PSA 44:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 44:6" /> מיט דיר שטױסן מיר אונדזערע פֿײַנט,</para>
  <para style="q" vid="PSA 44:6">מיט דײַן נאָמען צעטרעטן מיר אונדזערע קעגנשטײער.<verse eid="PSA 44:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 44:7" /> װאָרעם נישט אױף מײַן בױגן פֿאַרזיכער איך מיך,</para>
  <para style="q" vid="PSA 44:7">און מײַן שװערד קען מיך נישט העלפֿן.<verse eid="PSA 44:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 44:8" /> נײַערט דו האָסט אונדז געהאָלפֿן פֿון אונדזערע פֿײַנט,</para>
  <para style="q" vid="PSA 44:8">און אונדזערע שָׂונאים צו שאַנד געמאַכט.<verse eid="PSA 44:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 44:9" /> מיט אלֹקים האָבן מיר זיך גערימט אַ גאַנצן טאָג,</para>
  <para style="q" vid="PSA 44:9">און דײַן נאָמען לױבן מיר אײביק.</para>
  <para style="q" vid="PSA 44:9">סֶלָה.<verse eid="PSA 44:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 44:10" /> אָבער האָסט פֿאַרלאָזן און פֿאַרשעמט אונדז,</para>
  <para style="q" vid="PSA 44:10">און גײַסט נישט אַרױס מיט אונדזערע מחנות.<verse eid="PSA 44:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 44:11" /> מאַכסט אונדז צוריקגײן פֿאַרן פֿײַנט,</para>
  <para style="q" vid="PSA 44:11">און אונדזערע שָׂונאים רױבן זיך אָן.<verse eid="PSA 44:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 44:12" /> האָסט אונדז אָפּגעגעבן װי שאָף צום עסן,</para>
  <para style="q" vid="PSA 44:12">און צװישן די פֿעלקער האָסטו אונדז צעשפּרײט.<verse eid="PSA 44:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 44:13" /> האָסט פֿאַרקױפֿט דײַן אומה פֿאַר שפּאָטגעלט,</para>
  <para style="q" vid="PSA 44:13">און האָסט נישט הױך געשטעלט זײער מקח.<verse eid="PSA 44:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 44:14" /> מאַכסט אונדז צו חרפּה בײַ אונדזערע שכנים,</para>
  <para style="q" vid="PSA 44:14">אַ געלעכטער און אַ שפּאָט בײַ אונדזערע אַרומיקע.<verse eid="PSA 44:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 44:15" /> מאַכסט אונדז פֿאַר אַ שפּריכװאָרט צװישן די פֿעלקער,</para>
  <para style="q" vid="PSA 44:15">אַ קאָפּשאָקלעניש צװישן די אומות.<verse eid="PSA 44:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 44:16" /> אַ גאַנצן טאָג איז מײַן שאַנד אַנטקעגן מיר,</para>
  <para style="q" vid="PSA 44:16">און די בושה פֿון מײַן פּנים האָט מיך באַדעקט,<verse eid="PSA 44:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 44:17" /> פֿון קֹול פֿון דעם לעסטערער און שענדער,</para>
  <para style="q" vid="PSA 44:17">פֿון װעגן דעם פֿײַנט און דעם ראַכענעמער.<verse eid="PSA 44:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 44:18" /> דאָס אַלץ איז געקומען אױף אונדז,</para>
  <para style="q" vid="PSA 44:18">אָבער מיר האָבן נישט פֿאַרגעסן אָן דיר,</para>
  <para style="q" vid="PSA 44:18">און נישט געלײקנט אָן דײַן ברית.<verse eid="PSA 44:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 44:19" /> נישט אָפּגעקערט אַהינטער האָט זיך אונדזער האַרץ,</para>
  <para style="q" vid="PSA 44:19">אַז אונדזערע טריט זאָלן זיך אָפּנײַגן פֿון דײַן שטעג;<verse eid="PSA 44:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 44:20" /> הגם דו האָסט אונדז פֿאַרשטױסן אין אַן אָרט פֿון שאַקאַלן,</para>
  <para style="q" vid="PSA 44:20">און אונדז איבערגעדעקט מיט טױטשאָטן.<verse eid="PSA 44:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 44:21" /> אױב מיר װאָלטן פֿאַרגעסן אָן דעם נאָמען פֿון אלוקינו,</para>
  <para style="q" vid="PSA 44:21">און אױסגעשפּרײט אונדזערע הענט צו אַ פֿרעמדן ג-ט,<verse eid="PSA 44:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 44:22" /> װאָלט דען אלֹקים דאָס נישט אױספֿאָרשן?</para>
  <para style="q" vid="PSA 44:22">װאָרעם ער װײס די פֿאַרבאָרגענישן פֿון האַרצן.<verse eid="PSA 44:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 44:23" /> יאָ, איבער דיר װערן מיר געהרגעט אַ גאַנצן טאָג,</para>
  <para style="q" vid="PSA 44:23">מיר װערן גערעכנט װי שאָף צו דער שחיטה.<verse eid="PSA 44:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 44:24" /> דערװעק דיך, פֿאַר װאָס שלאָפֿסטו, אָ אֲדֹנָי?</para>
  <para style="q" vid="PSA 44:24">װאַך אױף, זאָלסט אונדז נישט פֿאַרלאָזן אױף אײביק.<verse eid="PSA 44:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 44:25" /> פֿאַר װאָס פֿאַרבאָרגסטו דײַן פּנים,</para>
  <para style="q" vid="PSA 44:25">פֿאַרגעסט אונדזער פּײַן און אונדזער קלעם?<verse eid="PSA 44:25" /></para>
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 44:26" /> װאָרעם געבױגן צום שטױב איז אונדזער זעל,</para>
  <para style="q" vid="PSA 44:26">באַהעפֿט צו דער ערד איז אונדזער לײַב.<verse eid="PSA 44:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 44:27" /> שטײ אױף אונדז צו הילף,</para>
  <para style="q" vid="PSA 44:27">און לײז אונדז אױס פֿון װעגן דײַן גענאָד.<verse eid="PSA 44:27" /></para>
  <chapter eid="PSA 44" />
  <chapter number="45" style="c" pubnumber="מה" sid="PSA 45" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 45:1" />פֿאַר דעם געזאַנגמײַסטער; אױף שוֹשַנים, פֿון די קינדער פֿון קֹרַח; אַ באַטראַכטונג, אַ געזאַנג פֿון ליבשאַפֿט.<verse eid="PSA 45:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 45:2" /> עס ייִרט מײַן האַרץ מיטן שײנעם װאָרט,</para>
  <para style="q" vid="PSA 45:2">איך װעל פֿירזאָגן מײַנע לידער צום מלך;</para>
  <para style="q" vid="PSA 45:2">מײַן צונג איז די פּען</para>
  <para style="q" vid="PSA 45:2">פֿון אַ שרײַבער אַ פֿלינקן.<verse eid="PSA 45:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 45:3" /> ביסט שענער פֿון אַלע מענטשנקינדער,</para>
  <para style="q" vid="PSA 45:3">חן איז אױסגעגאָסן אױף דײַנע ליפּן,</para>
  <para style="q" vid="PSA 45:3">װײַל אלֹקים האָט דיך געבענטשט אױף אײביק.<verse eid="PSA 45:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 45:4" /> גורט אָן דײַן שװערד אױפֿן לענד, דו גיבור,</para>
  <para style="q" vid="PSA 45:4">דײַן גלאַנץ און דײַן פּראַכט.<verse eid="PSA 45:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 45:5" /> און אין דײַן פּראַכט באַגליק, רײַט אַרױס,</para>
  <para style="q" vid="PSA 45:5">פֿון װעגן אמת און מילדקײט און גערעכטיקײט,</para>
  <para style="q" vid="PSA 45:5">און זאָל דיר דײַן רעכטע האַנט פֿאָרכטיקס באַװײַזן.<verse eid="PSA 45:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 45:6" /> דײַנע פֿײַלן געשאַרפֿטע –</para>
  <para style="q" vid="PSA 45:6">פֿעלקער זאָלן פֿאַלן אונטער דיר –</para>
  <para style="q" vid="PSA 45:6">אין האַרצן פֿון מלכס פֿײַנט!<verse eid="PSA 45:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 45:7" /> דײַן טראָן, אָ אלֹקים,</para>
  <para style="q" vid="PSA 45:7">איז אױף אײביק און שטענדיק,</para>
  <para style="q" vid="PSA 45:7">אַ צעפּטער פֿון יושר</para>
  <para style="q" vid="PSA 45:7">איז דער צעפּטער פֿון דײַן מלוכה.<verse eid="PSA 45:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 45:8" /> האָסט ליב געהאַט גערעכטיקײט, און פֿײַנט געהאַט אומרעכט,</para>
  <para style="q" vid="PSA 45:8">דערום האָט דיך אלֹקים, דײַן ג-ט, געזאַלבט</para>
  <para style="q" vid="PSA 45:8">מיט אײל פֿון פֿרײד, איבער דײַנע חבֿרים.<verse eid="PSA 45:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 45:9" /> מירע און אַלאָען, קאַנײלן זײַנען אַלע דײַנע קלײדער,</para>
  <para style="q" vid="PSA 45:9">פֿון העלפֿאַנדבײן-פּאַלאַצן דערפֿרײען דיך סטרונעס.<verse eid="PSA 45:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 45:10" /> טעכטער פֿון מלכים זײַנען צװישן דײַנע געליבטע,</para>
  <para style="q" vid="PSA 45:10">דיר צו רעכטס שטײט</para>
  <para style="q" vid="PSA 45:10">די מלכּה אין גינגאָלד פֿון אוֹפֿיר.<verse eid="PSA 45:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 45:11" /> הער, טאָכטער, און זע, און נײַג צו דײַן אױער,</para>
  <para style="q" vid="PSA 45:11">און פֿאַרגעס דײַן פֿאָלק, און דאָס הױז פֿון דײַן פֿאָטער,<verse eid="PSA 45:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 45:12" /> און דער מלך װעט גלוסטן דײַן שײנקײט;</para>
  <para style="q" vid="PSA 45:12">װאָרעם ער איז דײַן האַר, דערום בוק זיך צו אים.<verse eid="PSA 45:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 45:13" /> און, טאָכטער פֿון צוֹר, די רײַכסטע פֿון פֿאָלק</para>
  <para style="q" vid="PSA 45:13">װעלן בעטן דײַן לײַטזעליקײט מיט מִנְחָה.<verse eid="PSA 45:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 45:14" /> לױטער פּראַכט איז די בת-מלכּה אינעװײניק אין פּאַלאַץ,</para>
  <para style="q" vid="PSA 45:14">פֿון געקעסטלטן גאָלדװעב איר מלבוש.<verse eid="PSA 45:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 45:15" /> אױף געשטיקטע געװאַנטן װערט זי צום מלך געפֿירט;</para>
  <para style="q" vid="PSA 45:15">הינטער איר יונגפֿרױען, חבֿרטעס אירע, װערן דיר געבראַכט.<verse eid="PSA 45:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 45:16" /> זײ װערן געפֿירט מיט פֿרײדן און לוסטיקײט,</para>
  <para style="q" vid="PSA 45:16">זײ קומען אין פּאַלאַץ פֿון מלך.<verse eid="PSA 45:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 45:17" /> אַנשטאָט דײַנע פֿאָטערס װעלן זײַן דײַנע זין;</para>
  <para style="q" vid="PSA 45:17">װעסט זײ אױפֿזעצן פֿאַר האַרן אין גאַנצן לאַנד.<verse eid="PSA 45:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 45:18" /> איך װעל מאַכן דערמאָנען דײַן נאָמען אױף אַלע דור-דורות,</para>
  <para style="q" vid="PSA 45:18">דערום װעלן פֿעלקער דיך לױבן אױף אײביק און שטענדיק.<verse eid="PSA 45:18" /></para>
  <chapter eid="PSA 45" />
  <chapter number="46" style="c" pubnumber="מו" sid="PSA 46" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 46:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון די קינדער פֿון קֹרַח; אױף עַלָמות; אַ ליד.<verse eid="PSA 46:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 46:2" /> אלֹקים איז אונדז אַ באַשיצונג און אַ שטאַרקײט,</para>
  <para style="q" vid="PSA 46:2">אַ הילף אין צרות, גרינג צו געפֿינען.<verse eid="PSA 46:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 46:3" /> דערום װעלן מיר נישט מורא האָבן,</para>
  <para style="q" vid="PSA 46:3">װען די ערד זאָל זיך בײַטן,</para>
  <para style="q" vid="PSA 46:3">און װען די בערג זאָלן אומפֿאַלן</para>
  <para style="q" vid="PSA 46:3">אין האַרצן פֿון ים.<verse eid="PSA 46:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 46:4" /> מעגן ברומען, מעגן שױמען זײַנע װאַסערן,</para>
  <para style="q" vid="PSA 46:4">מעגן ציטערן די בערג פֿאַר זײַן הױכקײט.</para>
  <para style="q" vid="PSA 46:4">סֶלָה.<verse eid="PSA 46:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 46:5" /> אַ טײַך איז דאָ, װאָס זײַנע שטראָמען דערפֿרײען די שטאָט פֿון אלֹקים,</para>
  <para style="q" vid="PSA 46:5">די הײליקסטע װױנונג פֿון עליון.<verse eid="PSA 46:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 46:6" /> אלֹקים איז אין איר מיטן, זי װעט נישט אומפֿאַלן,</para>
  <para style="q" vid="PSA 46:6">אלֹקים װעט זי העלפֿן אַקעגן פֿרימאָרגן.<verse eid="PSA 46:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 46:7" /> פֿעלקער האָבן געטומלט, קיניגרײַכן זײַנען אומגעפֿאַלן;</para>
  <para style="q" vid="PSA 46:7">ער האָט אַרױסגעלאָזט זײַן קֹול, טוט זיך װאַקלען די ערד.<verse eid="PSA 46:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 46:8" /> מיט אונדז איז ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="PSA 46:8">אַ פֿעסטונג איז אונדז דער אלוקי יעקבֿ.</para>
  <para style="q" vid="PSA 46:8">סֶלָה.<verse eid="PSA 46:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 46:9" /> גײט זעט די אױפֿטוען פֿון ה׳,</para>
  <para style="q" vid="PSA 46:9">װאָס האָט געמאַכט פֿאַרװיסטונגען אין לאַנד.<verse eid="PSA 46:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 46:10" /> ער מאַכט אױפֿהערן מלחמות ביזן עק פֿון דער ערד,</para>
  <para style="q" vid="PSA 46:10">דעם בױגן צעברעכט ער, און טוט צעהאַקן דעם שפּיז;</para>
  <para style="q" vid="PSA 46:10">רײַטװעגן פֿאַרברענט ער אין פֿײַער.<verse eid="PSA 46:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 46:11" /> לאָזט אָפּ, און זײַט װיסן אַז איך בין אלֹקים,</para>
  <para style="q" vid="PSA 46:11">איך בין דערהױבן צװישן די פֿעלקער,</para>
  <para style="q" vid="PSA 46:11">דערהױבן אױף דער ערד.<verse eid="PSA 46:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 46:12" /> ה׳ צבָֿאוֹת איז מיט אונדז,</para>
  <para style="q" vid="PSA 46:12">אַ פֿעסטונג איז אונדז דער אלוקי יעקבֿ.</para>
  <para style="q" vid="PSA 46:12">סֶלָה.<verse eid="PSA 46:12" /></para>
  <chapter eid="PSA 46" />
  <chapter number="47" style="c" pubnumber="מז" sid="PSA 47" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 47:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון די קינדער פֿון קֹרַח אַ מיזמור.<verse eid="PSA 47:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 47:2" /> קלאַפּט די הענט, אַלע פֿעלקער,</para>
  <para style="q" vid="PSA 47:2">שאַלט צו אלֹקים מיט אַ קֹול פֿון געזאַנג.<verse eid="PSA 47:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 47:3" /> װאָרעם ה׳ דער עליון איז פֿאָרכטיק,</para>
  <para style="q" vid="PSA 47:3">אַ גרױסער מלך איבער דער גאַנצער ערד.<verse eid="PSA 47:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 47:4" /> ער אונטערטעניקט פֿעלקער אונטער אונדז,</para>
  <para style="q" vid="PSA 47:4">און אומות אונטער אונדזערע פֿיס.<verse eid="PSA 47:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 47:5" /> ער װײלט אונדז אױס אונדזער נחלה,</para>
  <para style="q" vid="PSA 47:5">דעם הערליכקײט פֿון יעקבֿ װאָס ער האָט ליב.</para>
  <para style="q" vid="PSA 47:5">סֶלָה.<verse eid="PSA 47:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 47:6" /> אלֹקים איז אױפֿגעגאַנגען מיט שאַלונג,</para>
  <para style="q" vid="PSA 47:6">ה׳ מיט קֹול פֿון שופֿר.<verse eid="PSA 47:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 47:7" /> זינגט צו אלֹקים, זינגט,</para>
  <para style="q" vid="PSA 47:7">זינגט צו אונדזער מלך, זינגט.<verse eid="PSA 47:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 47:8" /> װאָרעם אלֹקים איז דער מלך פֿון דער גאַנצער ערד;</para>
  <para style="q" vid="PSA 47:8">זינגט מיט באַטראַכט.<verse eid="PSA 47:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 47:9" /> אלֹקים קיניגט איבער די פֿעלקער,</para>
  <para style="q" vid="PSA 47:9">אלֹקים זיצט אױף זײַן הײליקן טראָן.<verse eid="PSA 47:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 47:10" /> די פֿירשטן פֿון די אומות האָבן זיך אײַנגעזאַמלט,</para>
  <para style="q" vid="PSA 47:10">דאָס פֿאָלק פֿון דעם אלֹקים פֿון אבֿרהם;</para>
  <para style="q" vid="PSA 47:10">װאָרעם צו אלֹקים זײַנען די שילדן פֿון דער ערד,</para>
  <para style="q" vid="PSA 47:10">ער איז זײער דערהױבן.<verse eid="PSA 47:10" /></para>
  <chapter eid="PSA 47" />
  <chapter number="48" style="c" pubnumber="מח" sid="PSA 48" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 48:1" />אַ געזאַנג; אַ מיזמור פֿון די קינדער פֿון קֹרַח.<verse eid="PSA 48:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 48:2" /> גרױס איז ה׳,</para>
  <para style="q" vid="PSA 48:2">און זײער געלױבט אין דער שטאָט פֿון אלוקינו,</para>
  <para style="q" vid="PSA 48:2">אױף זײַן הײליקן באַרג.<verse eid="PSA 48:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 48:3" /> שײן דערהײכט, די פֿרײד פֿון דער גאַנצער ערד,</para>
  <para style="q" vid="PSA 48:3">איז דער באַרג צִיוֹן אין די עקן פֿון צפֿון,</para>
  <para style="q" vid="PSA 48:3">די שטאָט פֿון דעם גרױסן מלך.<verse eid="PSA 48:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 48:4" /> אלֹקים אין אירע ציטאַדעלן</para>
  <para style="q" vid="PSA 48:4">איז באַקאַנט פֿאַר אַ פֿעסטונג.<verse eid="PSA 48:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 48:5" /> װאָרעם זע, מלכים האָבן זיך אײַנגעזאַמלט,</para>
  <para style="q" vid="PSA 48:5">זײ זײַנען אַריבערגעקומען אין אײנעם.<verse eid="PSA 48:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 48:6" /> װי זײ האָבן געזען, אַזױ האָבן זײ געגאַפֿט,</para>
  <para style="q" vid="PSA 48:6">דערשראָקענע האָבן זײ אַװעקגעאײַלט.<verse eid="PSA 48:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 48:7" /> אַ ציטערניש האָט זײ אָנגענומען דאָרטן,</para>
  <para style="q" vid="PSA 48:7">אַ װײעניש װי אַ געװינערין.<verse eid="PSA 48:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 48:8" /> מיט אַ מזרח-װינט האָסטו צעבראָכן</para>
  <para style="q" vid="PSA 48:8">די שיפֿן פֿון תַּרְשִיש.<verse eid="PSA 48:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 48:9" /> װי מיר האָבן געהערט, אַזױ האָבן מיר געזען,</para>
  <para style="q" vid="PSA 48:9">אין דער שטאָט פֿון ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="PSA 48:9">אין דער שטאָט פֿון אלוקינו;</para>
  <para style="q" vid="PSA 48:9">אלֹקים זאָל זי אױפֿהאַלטן ביז אײביק.</para>
  <para style="q" vid="PSA 48:9">סֶלָה.<verse eid="PSA 48:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 48:10" /> מיר האָבן געטראַכט, אלֹקים, אָן דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 48:10">אין דער מיטן פֿון דײַן הֵיכל.<verse eid="PSA 48:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 48:11" /> אַזױ װי דײַן נאָמען, אלֹקים,</para>
  <para style="q" vid="PSA 48:11">אַזױ איז דײַן לױב ביז די עקן פֿון דער ערד;</para>
  <para style="q" vid="PSA 48:11">פֿול מיט גערעכטיקײט איז דײַן רעכטע האַנט.<verse eid="PSA 48:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 48:12" /> זאָל זיך פֿרײען דער באַרג צִיוֹן,</para>
  <para style="q" vid="PSA 48:12">זאָלן לוסטיק זײַן די טעכטערשטעט פֿון יהוּדה,</para>
  <para style="q" vid="PSA 48:12">פֿון װעגן דײַנע משפּטים.<verse eid="PSA 48:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 48:13" /> גײט אַרום צִיוֹן, און רינגלט זי אַרום,</para>
  <para style="q" vid="PSA 48:13">צײלט איבער אירע טורעמס.<verse eid="PSA 48:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 48:14" /> טוט אַכט אױף אירע מױער,</para>
  <para style="q" vid="PSA 48:14">גײט דורך אירע פּאַלאַצן;</para>
  <para style="q" vid="PSA 48:14">כּדי איר זאָלט דערצײלן דעם שפּעטערדיקן דור,<verse eid="PSA 48:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 48:15" /> אַז דאָס איז אלֹקים, אלוקינו, אײביק און שטענדיק;</para>
  <para style="q" vid="PSA 48:15">ער װעט אונדז פֿירן ביז אײביקײט.<verse eid="PSA 48:15" /></para>
  <chapter eid="PSA 48" />
  <chapter number="49" style="c" pubnumber="מט" sid="PSA 49" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 49:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון די קינדער פֿון קֹרַח; אַ מיזמור.<verse eid="PSA 49:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 49:2" /> הערט דאָס צו, אַלע פֿעלקער,</para>
  <para style="q" vid="PSA 49:2">פֿאַרנעמט, אַלע באַװױנער פֿון דער װעלט,<verse eid="PSA 49:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 49:3" /> סײַ אַזױ מענטשן, סײַ אָנגעזעענע לײַט,</para>
  <para style="q" vid="PSA 49:3">רײַך און אָרים אין אײנעם.<verse eid="PSA 49:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 49:4" /> מײַן מױל װעט רעדן חכמה,</para>
  <para style="q" vid="PSA 49:4">און די טראַכטונג פֿון מײַן האַרצן װעט זײַן פֿאַרשטאַנדיקײט.<verse eid="PSA 49:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 49:5" /> איך װעל נײַגן צו אַ משל מײַן אױער,</para>
  <para style="q" vid="PSA 49:5">איך װעל אָנהײבן מיט אַ האַרף מײַן רעטעניש.<verse eid="PSA 49:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 49:6" /> פֿאַר װאָס זאָל איך מורא האָבן אין די טעג פֿון בײז,</para>
  <para style="q" vid="PSA 49:6">װען די זינד פֿון מײַנע טרעטער רינגלט מיך אַרום?<verse eid="PSA 49:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 49:7" /> די װאָס פֿאַרזיכערן זיך אױף זײער פֿאַרמעג,</para>
  <para style="q" vid="PSA 49:7">און מיט זײער גרױס עשירות רימען זײ זיך.<verse eid="PSA 49:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 49:8" /> נישט אױסקױפֿן אַ ברודער קען אַ מענטש אױסקױפֿן,</para>
  <para style="q" vid="PSA 49:8">נישט געבן אלֹקים אַן אױסלײז פֿאַר זיך;<verse eid="PSA 49:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 49:9" /> און װי װערדיק עס זאָל זײַן דער אױסקױף פֿאַר זײער זעל,</para>
  <para style="q" vid="PSA 49:9">איז אױף אײביק פֿאַרמײַדן,<verse eid="PSA 49:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 49:10" /> װאָס ער זאָל שטענדיק אַלץ לעבן,</para>
  <para style="q" vid="PSA 49:10">ער זאָל נישט אָנזען די גרוב.<verse eid="PSA 49:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 49:11" /> װאָרעם מע זעט אַז חכמים שטאַרבן,</para>
  <para style="q" vid="PSA 49:11">אַזױ װי דער נאַר און דער פֿאַרגרעבטער גײען אונטער,</para>
  <para style="q" vid="PSA 49:11">און זײ לאָזן איבער צו אַנדערע זײער פֿאַרמעג.<verse eid="PSA 49:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 49:12" /> זײ טראַכטן בײַ זיך,</para>
  <para style="q" vid="PSA 49:12">זײערע הײַזער זײַנען אױף אײביק,</para>
  <para style="q" vid="PSA 49:12">זײערע װױנונגען אױף דור-דורות;</para>
  <para style="q" vid="PSA 49:12">זײ רופֿן לענדער אױף זײערע נעמען.<verse eid="PSA 49:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 49:13" /> אָבער דער מענטש בלײַבט נישט אין גדוּלה,</para>
  <para style="q" vid="PSA 49:13">ער איז געגליכן צו בהמות װאָס װערן פֿאַרשניטן.<verse eid="PSA 49:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 49:14" /> דאָס איז דער װעג פֿון די װאָס זײַנען בטוח בײַ זיך,</para>
  <para style="q" vid="PSA 49:14">און פֿון זײערע נאָכגײער װאָס קװעלן פֿון זײערע רײד.</para>
  <para style="q" vid="PSA 49:14">סֶלָה.<verse eid="PSA 49:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 49:15" /> מע לײגט זײ װי שאָף אין דער שְׁאֹול,</para>
  <para style="q" vid="PSA 49:15">דער טױט טוט זײ פֿיטערן;</para>
  <para style="q" vid="PSA 49:15">און אײן פֿרימאָרגן – טרעטן די רעכטפֿאַרטיקע איבער זײ;</para>
  <para style="q" vid="PSA 49:15">און זײער געשטאַלט איז פֿאַר דער שְׁאֹול צום פֿאַרפֿױלן,</para>
  <para style="q" vid="PSA 49:15">נישטאָ קײן װױנונג פֿאַר איר.<verse eid="PSA 49:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 49:16" /> אָבער אלֹקים װעט אױסלײזן מײַן זעל פֿון דער מאַכט פֿון שְׁאֹול,</para>
  <para style="q" vid="PSA 49:16">װאָרעם ער װעט מיך אַרױסנעמען.</para>
  <para style="q" vid="PSA 49:16">סֶלָה.<verse eid="PSA 49:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 49:17" /> זאָלסט נישט מורא האָבן אַז עמעצער װערט אַן עושר,</para>
  <para style="q" vid="PSA 49:17">אַז די רײַכקײט פֿון זײַן הױז װערט געמערט,<verse eid="PSA 49:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 49:18" /> װאָרעם בײַ זײַן טױט װעט ער גאָרנישט מיטנעמען,</para>
  <para style="q" vid="PSA 49:18">זײַן רײַכקײט װעט נישט נידערן נאָך אים.<verse eid="PSA 49:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 49:19" /> הגם בײַ זײַן לעבן פֿלעגט ער אײַנרעדן זײַן זעל:</para>
  <para style="q" vid="PSA 49:19">מע װעט דיך נאָך לױבן אַז דו װעסט זיך װױלטאָן.<verse eid="PSA 49:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 49:20" /> זי װעט אָנקומען צו דעם דור פֿון זײַנע עלטערן,</para>
  <para style="q" vid="PSA 49:20">װאָס װעלן אױף אײביק נישט אָנזען דעם שײַן.<verse eid="PSA 49:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 49:21" /> אַ מענטש אין גדוּלה װאָס פֿאַרשטײט נישט,</para>
  <para style="q" vid="PSA 49:21">איז געגליכן צו בהמות װאָס װערן פֿאַרשניטן.<verse eid="PSA 49:21" /></para>
  <chapter eid="PSA 49" />
  <chapter number="50" style="c" pubnumber="נ" sid="PSA 50" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 50:1" />אַ מיזמור פֿון אָסָפֿן.</para>
  <para style="q" vid="PSA 50:1">דער אֵל פֿון ג‑טער, ה׳, האָט גערעדט און גערופֿן די ערד,</para>
  <para style="q" vid="PSA 50:1">פֿון אױפֿגאַנג פֿון דער זון ביז איר אונטערגאַנג.<verse eid="PSA 50:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 50:2" />פֿון צִיוֹן דער קרױן פֿון שײנקײט,</para>
  <para style="q" vid="PSA 50:2">האָט אַרױסגעשײַנט אלֹקים.<verse eid="PSA 50:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 50:3" />אלוקינו קומט, און ער שװײַגט נישט,</para>
  <para style="q" vid="PSA 50:3">אים פֿאַרױס פֿאַרצערט אַ פֿײַער,</para>
  <para style="q" vid="PSA 50:3">און אַרום אים טוט שטורעמען געװאַלטיק.<verse eid="PSA 50:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 50:4" />ער רופֿט צו די הימלען פֿון אױבן,</para>
  <para style="q" vid="PSA 50:4">און צו דער ערד, כּדי צו משפּטן זײַן פֿאָלק:<verse eid="PSA 50:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 50:5" />זאַמלט מיר אײַן מײַנע פֿרומע,</para>
  <para style="q" vid="PSA 50:5">די װאָס שליסן מײַן ברית איבער שלאַכטאָפּפֿער.<verse eid="PSA 50:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 50:6" />און די הימלען זאָגן אָן זײַן גערעכטיקײט,</para>
  <para style="q" vid="PSA 50:6">װאָרעם אלֹקים, ער איז אַ ריכטער.</para>
  <para style="q" vid="PSA 50:6">סֶלָה.<verse eid="PSA 50:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 50:7" />הער מײַן פֿאָלק, און איך װעל רעדן,</para>
  <para style="q" vid="PSA 50:7">יִשׂרָאֵל, און איך װעל דיך װאָרענען:</para>
  <para style="q" vid="PSA 50:7">אלֹקים דײַן ג-ט בין איך.<verse eid="PSA 50:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 50:8" />נישט אום דײַנע שלאַכטאָפּפֿער װעל איך דיך שטראָפֿן;</para>
  <para style="q" vid="PSA 50:8">דײַנע בראַנדאָפּפֿער זײַנען דאָך תּמיד פֿאַר מיר.<verse eid="PSA 50:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 50:9" />איך װיל נישט נעמען פֿון דײַן הױז קײן אָקס,</para>
  <para style="q" vid="PSA 50:9">פֿון דײַנע שטאַלן קײן בעק.<verse eid="PSA 50:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 50:10" />װאָרעם מײַן איז יעטװעדער חיה פֿון װאַלד,</para>
  <para style="q" vid="PSA 50:10">די בהמות אױף טױזנט בערג.<verse eid="PSA 50:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 50:11" />איך קען יעטװעדער פֿױגל פֿון די בערג,</para>
  <para style="q" vid="PSA 50:11">און די װידמענונג פֿון פֿעלד איז בײַ מיר.<verse eid="PSA 50:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 50:12" />אַז איך זאָל הונגעריק זײַן, װעל איך דיר נישט זאָגן,</para>
  <para style="q" vid="PSA 50:12">װאָרעם מײַן איז די װעלט און איר פֿולקײט.<verse eid="PSA 50:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 50:13" />צי עס איך דאָס פֿלײש פֿון אָקסן?</para>
  <para style="q" vid="PSA 50:13">אָדער דאָס בלוט פֿון בעק טו איך טרינקען?<verse eid="PSA 50:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 50:14" />שלאַכט צו אלֹקים אַ דאַנקאָפּפֿער,</para>
  <para style="q" vid="PSA 50:14">און באַצאָל עליון אױבערשטער דײַנע נדרים.<verse eid="PSA 50:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 50:15" />און רוף מיך אין טאָג פֿון נױט,</para>
  <para style="q" vid="PSA 50:15">װעל איך דיך דערלײזן, און דו װעסט מיך ערלעכן.<verse eid="PSA 50:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 50:16" />און צום רשע האָט אלֹקים געזאָגט:</para>
  <para style="q" vid="PSA 50:16">װי קומסטו צו דערצײלן מײַנע געזעצן,</para>
  <para style="q" vid="PSA 50:16">און נעמען מײַן ברית אױף דײַן מױל?<verse eid="PSA 50:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 50:17" />אַז דו האָסט פֿײַנט מוסר,</para>
  <para style="q" vid="PSA 50:17">און האָסט געװאָרפֿן מײַנע װערטער הינטער דיר.<verse eid="PSA 50:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 50:18" />אַז דו האָסט געזען אַ גנבֿ,</para>
  <para style="q" vid="PSA 50:18">האָסטו זיך געפֿרײַנטלט מיט אים,</para>
  <para style="q" vid="PSA 50:18">און מיט נוֹאפֿים איז געװען דײַן טײל.<verse eid="PSA 50:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 50:19" />דײַן מױל האָסטו לױז געלאָזט צום בײזן,</para>
  <para style="q" vid="PSA 50:19">און דײַן צונג פֿלעכט באַטרוג.<verse eid="PSA 50:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 50:20" />זיצסטו, באַרעדסטו דײַן ברודער,</para>
  <para style="q" vid="PSA 50:20">דעם זון פֿון דײַן מוטער באַנַװלסטו.<verse eid="PSA 50:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 50:21" />דאָס האָסטו געטאָן, און איך האָב געזאָלט שװײַגן?</para>
  <para style="q" vid="PSA 50:21">האָסטו געדאַכט, זײַן װי דו װעל איך זײַן;</para>
  <para style="q" vid="PSA 50:21">װעל איך דיך שטראָפֿן, און דיר לײגן פֿאַר דײַנע אױגן.<verse eid="PSA 50:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 50:22" />מערקט דאָס אַקאָרשט, איר װאָס פֿאַרגעסט אָן אֱלוֹהַּ,</para>
  <para style="q" vid="PSA 50:22">כּדי איך זאָל נישט פֿאַרצוקן, און קײנער װעט נישט מציל זײַן.<verse eid="PSA 50:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 50:23" />דער װאָס שלאַכט אַ דאַנקאָפּפֿער, ערלעכט מיך,</para>
  <para style="q" vid="PSA 50:23">אָבער דעם װאָס באַטראַכט דעם װעג,</para>
  <para style="q" vid="PSA 50:23">אים װעל איך װײַזן די ישועה פֿון אלֹקים.<verse eid="PSA 50:23" /></para>
  <chapter eid="PSA 50" />
  <chapter number="51" style="c" pubnumber="נא" sid="PSA 51" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 51:1" />פֿאַר דעם געזאַנגמײַסטער; אַ מיזמור פֿון דָוִדן, <verse eid="PSA 51:1" /><verse number="2" style="v" sid="PSA 51:2" />װען נָתָן דער נבֿיא איז געקומען צו אים, נאָך דעם װי ער איז געקומען צו בַת-שֶבֿען.<verse eid="PSA 51:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="1" sid="PSA 51:3" /> לײַטזעליק מיך, אלֹקים, לױט דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 51:3">לױט דײַן גרױס דערבאַרעמונג מעק אָפּ מײַנע פֿאַרברעכן.<verse eid="PSA 51:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="2" sid="PSA 51:4" /> װאַש מיך אָפּ אין גאַנצן פֿון מײַן זינד,</para>
  <para style="q" vid="PSA 51:4">און פֿון מײַן חטא טו מיך רײניקן.<verse eid="PSA 51:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="3" sid="PSA 51:5" /> װאָרעם איך װײס מײַנע פֿאַרברעכן,</para>
  <para style="q" vid="PSA 51:5">און מײַן חטא איז מיר תּמיד אַנטקעגן.<verse eid="PSA 51:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="4" sid="PSA 51:6" /> צו דיר אַלײן האָב איך געזינדיקט,</para>
  <para style="q" vid="PSA 51:6">און װאָס איז שלעכט אין דײַנע אױגן האָב איך געטאָן;</para>
  <para style="q" vid="PSA 51:6">דערום ביסטו רעכטפֿאַרטיק אין דײַן רעדן,</para>
  <para style="q" vid="PSA 51:6">ביסטו גערעכט אין דײַן משפּטן.<verse eid="PSA 51:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="5" sid="PSA 51:7" /> זע, אין זינד בין איך געבאָרן געװאָרן,</para>
  <para style="q" vid="PSA 51:7">און אין חטא האָט מיך מײַנע מוטער פֿאַרשװענגערן.<verse eid="PSA 51:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="6" sid="PSA 51:8" /> אמת באַגערסטו דאָך אין די נירן,</para>
  <para style="q" vid="PSA 51:8">טאָ לערן מיך חכמה װוּ עס איז פֿאַרהױלן.<verse eid="PSA 51:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="7" sid="PSA 51:9" /> זאָלסט מיך רײניקן מיט אֵזוֹבֿ-גראָז,</para>
  <para style="q" vid="PSA 51:9">אַז איך זאָל רײן װערן,</para>
  <para style="q" vid="PSA 51:9">זאָלסט מיך װאַשן,</para>
  <para style="q" vid="PSA 51:9">ביז װײַסער פֿון שנײ זאָל איך װערן.<verse eid="PSA 51:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="8" sid="PSA 51:10" /> זאָלסט מיך מאַכן הערן פֿרײד און לוסטיקײט;</para>
  <para style="q" vid="PSA 51:10">זאָלן דערפֿרײט װערן די בײנער װאָס דו האָסט צעדריקט.<verse eid="PSA 51:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="9" sid="PSA 51:11" /> פֿאַרבאָרג דײַן פּנים פֿון מײַנע חטאָים,</para>
  <para style="q" vid="PSA 51:11">און אַלע מײַנע זינד פֿאַרמעק.<verse eid="PSA 51:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="10" sid="PSA 51:12" /> אַ רײן האַרץ באַשאַף אין מיר, אָ אלֹקים,</para>
  <para style="q" vid="PSA 51:12">און אַ פֿעסט גײַסט באַנײַ אין מיר.<verse eid="PSA 51:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="11" sid="PSA 51:13" /> זאָלסט מיך נישט אַװעקװאַרפֿן פֿון דיר,</para>
  <para style="q" vid="PSA 51:13">און דײַן רוּחַ הקדש זאָלסטו נישט אַװעקנעמען פֿון מיר.<verse eid="PSA 51:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="12" sid="PSA 51:14" /> קער מיר אום די פֿרײד פֿון דײַן הילף,</para>
  <para style="q" vid="PSA 51:14">און אַ פֿרײַ גײַסט זאָלסטו מיר שענקען.<verse eid="PSA 51:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" altnumber="13" sid="PSA 51:15" /> איך װעל לערנען פֿאַרברעכער דײַנע װעגן,</para>
  <para style="q" vid="PSA 51:15">און זינדיקע װעלן זיך אומקערן צו דיר.<verse eid="PSA 51:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="14" sid="PSA 51:16" /> זײַ מיך מציל פֿון בלוטיקײט,</para>
  <para style="q" vid="PSA 51:16">אלֹקים, דו אלֹקים פֿון מײַן הילף;</para>
  <para style="q" vid="PSA 51:16">זאָל מײַן צונג זינגען דײַן גערעכטיקײט.<verse eid="PSA 51:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="15" sid="PSA 51:17" /> אָ אֲדֹנָי, מײַנע ליפּן זאָלסטו עפֿענען,</para>
  <para style="q" vid="PSA 51:17">און זאָל מײַן מױל דערצײלן דײַן לױב.<verse eid="PSA 51:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="16" sid="PSA 51:18" /> װאָרעם באַגערסט נישט אַ שלאַכטאָפּפֿער אַז איך זאָל געבן,</para>
  <para style="q" vid="PSA 51:18">אַ בראַנדאָפּפֿער װילסטו נישט.<verse eid="PSA 51:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="17" sid="PSA 51:19" /> די שלאַכטאָפּפֿער פֿון אלֹקים זײַנען אַ צעבראָכן גײַסט,</para>
  <para style="q" vid="PSA 51:19">אַ צעבראָכן און דערשלאָגן האַרץ, אלֹקים, פֿאַראַכטסטו נישט.<verse eid="PSA 51:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="18" sid="PSA 51:20" /> באַגיטיק אין דײַן באַװיליקונג צִיוֹן,</para>
  <para style="q" vid="PSA 51:20">בױען זאָלסטו די מױערן פֿון ירושָלַיִם.<verse eid="PSA 51:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="19" sid="PSA 51:21" /> דענצמאָל װעסטו באַגערן שלאַכטאָפּפֿער פֿון גערעכטיקײט,</para>
  <para style="q" vid="PSA 51:21">בראַנדאָפּפֿער און גאַנצאָפּפֿער;</para>
  <para style="q" vid="PSA 51:21">דענצמאָל װעט מען אױפֿברענגען אָקסן אױף דײַן מזבח.<verse eid="PSA 51:21" /></para>
  <chapter eid="PSA 51" />
  <chapter number="52" style="c" pubnumber="נב" sid="PSA 52" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 52:1" />פֿאַר דעם געזאַנגמײַסטער; אַ באַטראַכטונג פֿון דָוִדן, <verse eid="PSA 52:1" /><verse number="2" style="v" sid="PSA 52:2" />װען דוֹאֵג דער אַדוֹמי איז געקומען, און האָט דערצײלט שָאולן, און אים אָנגעזאָגט: דָוִד איז געקומען אין אַחימֶלֶכס הױז.<verse eid="PSA 52:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="1" sid="PSA 52:3" /> װאָס פּראָלסטו זיך מיט בײז, דו מאַכטיקער?</para>
  <para style="q" vid="PSA 52:3">דער חֶסֶד פֿון אֵל איז אַלע טאָג.<verse eid="PSA 52:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="2" sid="PSA 52:4" /> אומגליקן טראַכט דײַן צונג,</para>
  <para style="q" vid="PSA 52:4">װי אַ שאַרפֿער גאָלמעסער װאָס אַרבעט פֿאַלש.<verse eid="PSA 52:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="3" sid="PSA 52:5" /> האָסט ליב בײז מער װי גוטס,</para>
  <para style="q" vid="PSA 52:5">ליגן אײדער רעדן גערעכטיקײט.</para>
  <para style="q" vid="PSA 52:5">סֶלָה.<verse eid="PSA 52:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="4" sid="PSA 52:6" /> האָסט ליב אַלע גערײד פֿון צעשטערונג,</para>
  <para style="q" vid="PSA 52:6">דו צונג פֿון באַטרוג.<verse eid="PSA 52:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="5" sid="PSA 52:7" /> װעט אױך אֵל דיך צעברעכן אױף אײביק,</para>
  <para style="q" vid="PSA 52:7">דיך אַרױסשאַרן און אַרױסרײַסן פֿון געצעלט,</para>
  <para style="q" vid="PSA 52:7">און דיך אױסװאָרצלען פֿון לאַנד פֿון די לעבעדיקע.</para>
  <para style="q" vid="PSA 52:7">סֶלָה.<verse eid="PSA 52:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="6" sid="PSA 52:8" /> און די צדיקים װעלן זען און װעלן פֿאָרכטן,</para>
  <para style="q" vid="PSA 52:8">און זײ װעלן לאַכן איבער אים:<verse eid="PSA 52:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="7" sid="PSA 52:9" /> אָן איז דער מאַן װאָס האָט נישט געמאַכט אלֹקים פֿאַר זײַן פֿעסטונג,</para>
  <para style="q" vid="PSA 52:9">און האָט זיך פֿאַרזיכערט אױף זײַן גרױס עשירות;</para>
  <para style="q" vid="PSA 52:9">װאָס איז פֿאַרשײַט געװען אין זײַן געריקײט.<verse eid="PSA 52:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="8" sid="PSA 52:10" /> אָבער איך בין װי אַ צװײַגהאַפֿטיקער אײלבערטבױם</para>
  <para style="q" vid="PSA 52:10">אין דעם הױז פֿון אלֹקים,</para>
  <para style="q" vid="PSA 52:10">איך פֿאַרזיכער מיך אױף ג-טס חֶסֶד אײביק און שטענדיק.<verse eid="PSA 52:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="9" sid="PSA 52:11" /> איך װעל אײביק דיר דאַנקען, װאָס דו האָסט זיך אײַנגעשטעלט,</para>
  <para style="q" vid="PSA 52:11">און איך װעל האָפֿן צו דײַן נאָמען װײַל ער איז גוט,</para>
  <para style="q" vid="PSA 52:11">אַנטקעגן פֿאַר דײַנע פֿרומע.<verse eid="PSA 52:11" /></para>
  <chapter eid="PSA 52" />
  <chapter number="53" style="c" pubnumber="נג" sid="PSA 53" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 53:1" />פֿאַר דעם געזאַנגמײַסטער; אױף מַחלַת; אַ באַטראַכטונג פֿון דָוִדן.<verse eid="PSA 53:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 53:2" /> דער נאַר זאָגט אין זײַן האַרצן: נישטאָ קײן אלֹקים!</para>
  <para style="q" vid="PSA 53:2">פֿאַרדאָרבן זײַנען זײ, און מיאוסע אומרעכט טוען זײ;</para>
  <para style="q" vid="PSA 53:2">קײנער טוט נישט קײן גוטס.<verse eid="PSA 53:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 53:3" /> אלֹקים האָט פֿון הימל געלוגט אױף די מענטשנקינדער,</para>
  <para style="q" vid="PSA 53:3">צו זען אױב פֿאַראַן אַ פֿאַרשטאַנדיקער װאָס זוכט אלֹקים.<verse eid="PSA 53:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 53:4" /> איטלעכער איז אָפּגעפֿאַלן, אַלע זײַנען זײ פֿאַרדאָרבן,</para>
  <para style="q" vid="PSA 53:4">קײנער טוט נישט קײן גוטס, נישט צו מאָל אײנער.<verse eid="PSA 53:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 53:5" /> פֿאַר װאָר, האָט דען קײנער נישט פֿאַרשטאַנען פֿון די װאָס טאָן אומרעכט,</para>
  <para style="q" vid="PSA 53:5">װעלכע עסן מײַן פֿאָלק אַזױ װי זײ עסן ברױט, און רופֿן נישט צו אלֹקים?<verse eid="PSA 53:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 53:6" /> אָן אַנגסטן זײ אין אַנגסט, װוּ קײן אַנגסט איז נישט געװען,</para>
  <para style="q" vid="PSA 53:6">װאָרעם אלֹקים האָט צעשאָטן די בײנער פֿון דײַן באַלעגערער;</para>
  <para style="q" vid="PSA 53:6">האָסט זײ געמאַכט צו שאַנד, װײַל אלֹקים האָט זײ פֿאַראַכט.<verse eid="PSA 53:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 53:7" /> װען קומט פֿון צִיוֹן די ישועה פֿון יִשׂרָאֵל?</para>
  <para style="q" vid="PSA 53:7">װען אלֹקים קערט אום די געפֿאַנגענשאַפֿט פֿון זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 53:7">װעט לוסטיק זײַן יעקבֿ, װעט זיך פֿרײען יִשׂרָאֵל.<verse eid="PSA 53:7" /></para>
  <chapter eid="PSA 53" />
  <chapter number="54" style="c" pubnumber="נד" sid="PSA 54" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 54:1" />פֿאַר דעם געזאַנגמײַסטער, מיט סטרונעשפּיל; אַ באַטראַכטונג פֿון דָוִדן, <verse eid="PSA 54:1" /><verse number="2" style="v" sid="PSA 54:2" />װען די זיפֿער זײַנען געקומען, און האָבן געזאָגט צו שָאולן: פֿאַר װאָר, דָוִד באַהאַלט זיך בײַ אונדז.<verse eid="PSA 54:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="1" sid="PSA 54:3" /> אלֹקים, מיט דײַן נאָמען טו מיך העלפֿן,</para>
  <para style="q" vid="PSA 54:3">און מיט דײַן גבֿורה זאָלסטו זיך אָננעמען פֿאַר מיר.<verse eid="PSA 54:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="2" sid="PSA 54:4" /> אלֹקים, הער צו מײַן תּפֿילה,</para>
  <para style="q" vid="PSA 54:4">פֿאַרנעם די װערטער פֿון מײַן מױל.<verse eid="PSA 54:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="3" sid="PSA 54:5" /> װאָרעם פֿרעמדע זײַנען אָנגעשטאַנען אױף מיר,</para>
  <para style="q" vid="PSA 54:5">און געװאַלטטוער זוכן מײַן לעבן;</para>
  <para style="q" vid="PSA 54:5">זײ האַלטן נישט אלֹקים אַנטקעגן זיך.</para>
  <para style="q" vid="PSA 54:5">סֶלָה.<verse eid="PSA 54:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="4" sid="PSA 54:6" /> זע, אלֹקים איז מיר אַ העלפֿער,</para>
  <para style="q" vid="PSA 54:6">אֲדֹנָי איז דער אונטערלענער פֿון מײַן נפֿש.<verse eid="PSA 54:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="5" sid="PSA 54:7" /> זאָל ער אומקערן דאָס בײז אױף מײַנע לױערער;</para>
  <para style="q" vid="PSA 54:7">אין דײַן טרײַשאַפֿט פֿאַרשנײַד זײ.<verse eid="PSA 54:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="6" sid="PSA 54:8" /> מיט װיליקײט װעל איך שלאַכטן צו דיר,</para>
  <para style="q" vid="PSA 54:8">װעל לױבן דײַן נאָמען, ה׳, װאָרעם ער איז גוט.<verse eid="PSA 54:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="7" sid="PSA 54:9" /> װאָרעם פֿון יעטװעדער צרה האָט ער מיך מציל געװען,</para>
  <para style="q" vid="PSA 54:9">און מײַן אױג האָט זיך אָנגעזען אױף מײַנע פֿײַנט.<verse eid="PSA 54:9" /></para>
  <chapter eid="PSA 54" />
  <chapter number="55" style="c" pubnumber="נה" sid="PSA 55" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 55:1" />פֿאַר דעם געזאַנגמײַסטער, מיט סטרונעשפּיל; אַ באַטראַכטונג פֿון דָוִדן.<verse eid="PSA 55:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 55:2" /> פֿאַרנעם, אלֹקים, מײַן תּפֿילה,</para>
  <para style="q" vid="PSA 55:2">און זאָלסט זיך נישט פֿאַרהױלן פֿון מײַן געבעט.<verse eid="PSA 55:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 55:3" /> האָרך צו מיר, און ענטפֿער מיר;</para>
  <para style="q" vid="PSA 55:3">איך לױף אום אין מײַן קלאָג, און איך ברום,<verse eid="PSA 55:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 55:4" /> פֿון דעם קֹול פֿון דעם פֿײַנט,</para>
  <para style="q" vid="PSA 55:4">פֿון װעגן דער דריקונג פֿון דעם רשע;</para>
  <para style="q" vid="PSA 55:4">װאָרעם זײ ברענגען אױף מיר אומגליק,</para>
  <para style="q" vid="PSA 55:4">און מיט צאָרן טוען זײ מיך פֿײַנטן.<verse eid="PSA 55:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 55:5" /> מײַן האַרץ צאַפּלט אין מיר,</para>
  <para style="q" vid="PSA 55:5">און טױטשרעקן זײַנען אָנגעפֿאַלן אױף מיר.<verse eid="PSA 55:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 55:6" /> אַ מורא און אַ ציטערניש קומט אױף מיר,</para>
  <para style="q" vid="PSA 55:6">און אַ שױדער האָט מיך באַדעקט.<verse eid="PSA 55:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 55:7" /> און איך זאָג: װער גיט מיר פֿליגלען װי אַ טױב,</para>
  <para style="q" vid="PSA 55:7">איך װאָלט אַװעקגעפֿלױגן און גערוט.<verse eid="PSA 55:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 55:8" /> אָט װאָלט איך אַװעקגעװאָגלט װײַט,</para>
  <para style="q" vid="PSA 55:8">איך װאָלט געװײַלט אין דער מדבר.</para>
  <para style="q" vid="PSA 55:8">סֶלָה.<verse eid="PSA 55:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 55:9" /> איך װאָלט מיר געאײַלט צו אַן אַנטרינונג</para>
  <para style="q" vid="PSA 55:9">פֿון רײַסיקן װינט, פֿונעם שטורעם.<verse eid="PSA 55:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 55:10" /> צעמיש, אֲדֹנָי, צעטײל זײער שפּראַך,</para>
  <para style="q" vid="PSA 55:10">װאָרעם איך האָב געזען רױב און קריג אין שטאָט.<verse eid="PSA 55:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 55:11" /> טאָג און נאַכט רינגלען זײ זי אַרום אױף אירע מױערן,</para>
  <para style="q" vid="PSA 55:11">און אומרעכט און אומגליק איז אין איר מיטן.<verse eid="PSA 55:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 55:12" /> פֿאַרברעכן זײַנען אין איר מיטן,</para>
  <para style="q" vid="PSA 55:12">און פֿון איר מאַרק טוט זיך נישט אָפּ דריקונג און באַטרוג.<verse eid="PSA 55:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 55:13" /> װאָרעם נישט אַ פֿײַנט טוט מיך לעסטערן –</para>
  <para style="q" vid="PSA 55:13">דאָס װאָלט איך פֿאַרטראָגן;</para>
  <para style="q" vid="PSA 55:13">נישט מײַן שׂונא האָט זיך געגרײסט איבער מיר –</para>
  <para style="q" vid="PSA 55:13">פֿון אים װאָלט איך מיך פֿאַרבאָרגן;<verse eid="PSA 55:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 55:14" /> נאָר דו, אַ מענטש מײַן גלײַכן,</para>
  <para style="q" vid="PSA 55:14">מײַן חבֿר און מײַן באַקענטער,<verse eid="PSA 55:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 55:15" /> װאָס בײַנאַנד פֿלעגן מיר זיס זיך סוֹדען,</para>
  <para style="q" vid="PSA 55:15">גײן אין דעם הױז פֿון אלֹקים מיט געזעמל.<verse eid="PSA 55:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 55:16" /> זאָל ער אָנרײצן דעם טױט אױף זײ,</para>
  <para style="q" vid="PSA 55:16">זאָלן זײ נידערן לעבעדיקערהײט אין שְׁאֹול!</para>
  <para style="q" vid="PSA 55:16">װאָרעם בײז איז אין זײער װױנונג, צװישן זײ.<verse eid="PSA 55:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 55:17" /> איך װעל רופֿן צו אלֹקים,</para>
  <para style="q" vid="PSA 55:17">און ה׳ װעט מיך העלפֿן.<verse eid="PSA 55:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 55:18" /> אָװנט און פֿרימאָרגן און מיטן טאָג</para>
  <para style="q" vid="PSA 55:18">װעל איך קלאָגן און װעל ברומען,</para>
  <para style="q" vid="PSA 55:18">און ער טוט הערן מײַן קֹול.<verse eid="PSA 55:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 55:19" /> ער טוט אױסלײזן בשלום מײַן זעל,</para>
  <para style="q" vid="PSA 55:19">מע זאָל נישט גענענען צו מיר,</para>
  <para style="q" vid="PSA 55:19">הגם זײ זײַנען פֿיל קעגן מיר.<verse eid="PSA 55:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 55:20" /> אֵל װעט הערן און װעט זײ אונטערטעניק מאַכן –</para>
  <para style="q" vid="PSA 55:20">דער װאָס טראָנט פֿון אײביק אָן.</para>
  <para style="q" vid="PSA 55:20">סֶלָה.</para>
  <para style="q" vid="PSA 55:20">װאָרעם נישטאָ קײן אָפּבײַט בײַ זײ,</para>
  <para style="q" vid="PSA 55:20">און זײ האָבן נישט מורא פֿאַר אלֹקים.<verse eid="PSA 55:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 55:21" /> ער שטרעקט אױס זײַנע הענט</para>
  <para style="q" vid="PSA 55:21">אױף די װאָס זײַנען אין שלום מיט אים,</para>
  <para style="q" vid="PSA 55:21">ער פֿאַרשװעכט זײַן ברית.<verse eid="PSA 55:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 55:22" /> גלאַט זײַנען די שמאַנטיקע רײד פֿון זײַן מױל,</para>
  <para style="q" vid="PSA 55:22">און זײַן האַרץ איז מלחמה;</para>
  <para style="q" vid="PSA 55:22">װײכער פֿון בױמל זײַנען זײַנע װערטער,</para>
  <para style="q" vid="PSA 55:22">אָבער זײ זײַנען שװערדן בלױזע.<verse eid="PSA 55:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 55:23" /> װאַרף אױף ה׳ דײַן לאַסט,</para>
  <para style="q" vid="PSA 55:23">און ער װעט דיך פֿאַרזאָרגן;</para>
  <para style="q" vid="PSA 55:23">ער װעט קײן מאָל נישט לאָזן פֿאַלן דעם צדיק.<verse eid="PSA 55:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 55:24" /> אָבער דו אלֹקים װעסט זײ נידערן אין קבֿר-גרוב,</para>
  <para style="q" vid="PSA 55:24">די לײַט פֿון בלוט און באַטרוג</para>
  <para style="q" vid="PSA 55:24">װעלן נישט אױסלעבן האַלב זײערע טעג;</para>
  <para style="q" vid="PSA 55:24">און איך װעל מיך פֿאַרזיכערן אױף דיר.<verse eid="PSA 55:24" /></para>
  <chapter eid="PSA 55" />
  <chapter number="56" style="c" pubnumber="נו" sid="PSA 56" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 56:1" />פֿאַר דעם געזאַנגמײַסטער, אױף יוֹנהס אֵלֶם רחוֹקים; פֿון דָוִדן אַ מִכתָּם, װען די פּלִשתּים האָבן אים געכאַפּט אין גַת.<verse eid="PSA 56:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 56:2" /> לײַטזעליק מיך, אלֹקים,</para>
  <para style="q" vid="PSA 56:2">װאָרעם אײַנשלינגען װיל מיך אַ מענטש;</para>
  <para style="q" vid="PSA 56:2">אַ גאַנצן טאָג דריקט ער מיך שטרײַטנדיק.<verse eid="PSA 56:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 56:3" /> אײַנשלינגען װילן מיך מײַנע לױערער אַ גאַנצן טאָג,</para>
  <para style="q" vid="PSA 56:3">יאָ פֿיל, דו העכסטער, שטרײַטן אױף מיר.<verse eid="PSA 56:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 56:4" /> דעם טאָג װאָס איך האָב מורא</para>
  <para style="q" vid="PSA 56:4">פֿאַרזיכער איך מיך אױף דיר.<verse eid="PSA 56:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 56:5" /> אױף אלֹקים װאָס זײַן װאָרט טו איך לױבן,</para>
  <para style="q" vid="PSA 56:5">אױף אלֹקים האָב איך מיך פֿאַרזיכערט,</para>
  <para style="q" vid="PSA 56:5">איך האָב נישט קײן מורא;</para>
  <para style="q" vid="PSA 56:5">װאָס קען אַ בשׂר-ודם מיר טאָן?<verse eid="PSA 56:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 56:6" /> אַ גאַנצן טאָג קריװדען זײ מײַנע טענות,</para>
  <para style="q" vid="PSA 56:6">אַלע זײערע מחשבֿות זײַנען צום בײזן אױף מיר.<verse eid="PSA 56:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 56:7" /> זײ קלײַבן זיך אױף, זײ באַהאַלטן זיך,</para>
  <para style="q" vid="PSA 56:7">זײ היטן מײַנע פֿוסטריט,</para>
  <para style="q" vid="PSA 56:7">אַזױ װי זײ קוקן אױס אױף מײַן זעל.<verse eid="PSA 56:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 56:8" /> פֿאַר דעם אומרעכט שלײַדער זײ אַרױס,</para>
  <para style="q" vid="PSA 56:8">אין צאָרן די פֿעלקער װאַרף אַנידער, אלֹקים.<verse eid="PSA 56:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 56:9" /> האָסט פֿאַרצײכנט מײַן װאָגלעניש,</para>
  <para style="q" vid="PSA 56:9">טו אַרײַן מײַן טרער אין דײַן לאָגל;</para>
  <para style="q" vid="PSA 56:9">פֿאַר װאָר, זײ זײַנען אין דײַן בוך.<verse eid="PSA 56:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 56:10" /> דענצמאָל װעלן מײַנע פֿײַנט זיך אומקערן אַהינטער</para>
  <para style="q" vid="PSA 56:10">אין דעם טאָג װאָס איך װעל רופֿן;</para>
  <para style="q" vid="PSA 56:10">דאָס װײס איך אַז אלֹקים איז פֿאַר מיר.<verse eid="PSA 56:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 56:11" /> אױף אלֹקים װאָס זײַן װאָרט טו איך לױבן,</para>
  <para style="q" vid="PSA 56:11">אױף ה׳ װאָס זײַן װאָרט טו איך לױבן,<verse eid="PSA 56:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 56:12" /> אױף אלֹקים האָב איך מיך פֿאַרזיכערט,</para>
  <para style="q" vid="PSA 56:12">איך האָב נישט קײן מורא;</para>
  <para style="q" vid="PSA 56:12">װאָס קען אַ מענטש מיר טאָן?<verse eid="PSA 56:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 56:13" /> איך נעם אױף מיר, אלֹקים, נדרים צו דיר,</para>
  <para style="q" vid="PSA 56:13">איך װעל אָפּצאָלן דאַנקאָפּפֿער צו דיר;<verse eid="PSA 56:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 56:14" /> װאָרעם האָסט מציל געװען מײַן זעל פֿון טױט,</para>
  <para style="q" vid="PSA 56:14">פֿאַר װאָר, מײַנע פֿיס פֿון שטרױכלונג,</para>
  <para style="q" vid="PSA 56:14">כּדי אַרומצוגײן פֿאַר אלֹקים</para>
  <para style="q" vid="PSA 56:14">אין דעם ליכט פֿון לעבן.<verse eid="PSA 56:14" /></para>
  <chapter eid="PSA 56" />
  <chapter number="57" style="c" pubnumber="נז" sid="PSA 57" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 57:1" />פֿאַר דעם געזאַנגמײַסטער; אַל-תַּשחֵת; פֿון דָוִדן אַ מִכתָּם, װען ער איז אַנטלאָפֿן פֿון שָאולן אין דער הײל.<verse eid="PSA 57:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 57:2" /> לײַטזעליק מיך, אלֹקים, לײַטזעליק מיך,</para>
  <para style="q" vid="PSA 57:2">װאָרעם אין דיר האָט זיך געשיצט מײַן זעל,</para>
  <para style="q" vid="PSA 57:2">און אין שאָטן פֿון דײַנע פֿליגלען װעל איך מיך שיצן</para>
  <para style="q" vid="PSA 57:2">ביז די אומגליקן װעלן אַריבער.<verse eid="PSA 57:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 57:3" /> איך װעל רופֿן צו אלֹקים עליון אױבערשטער,</para>
  <para style="q" vid="PSA 57:3">צו אֵל װאָס פֿירט אױס פֿאַר מיר.<verse eid="PSA 57:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 57:4" /> ער װעט שיקן פֿון הימל, און מיך העלפֿן,</para>
  <para style="q" vid="PSA 57:4">מעג לעסטערן דער װאָס װיל מיך אײַנשלינגען,</para>
  <para style="q" vid="PSA 57:4">סֶלָה;</para>
  <para style="q" vid="PSA 57:4">אלֹקים װעט שיקן זײַן חֶסֶד און זײַן טרײַשאַפֿט.<verse eid="PSA 57:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 57:5" /> מײַן זעל איז צװישן לײבן,</para>
  <para style="q" vid="PSA 57:5">איך ליג צװישן מענטשנקינדער לָהוטע;</para>
  <para style="q" vid="PSA 57:5">זײערע צײן זײַנען שפּיזן און פֿײַלן,</para>
  <para style="q" vid="PSA 57:5">און זײער צונג אַ שװערד אַ שאַרפֿע.<verse eid="PSA 57:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 57:6" /> דערהײב דיך איבער די הימלען, אלֹקים,</para>
  <para style="q" vid="PSA 57:6">איבער דער גאַנצער ערד זאָל זײַן דײַן כּבֿוד.<verse eid="PSA 57:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 57:7" /> אַ נעץ האָבן זײ אָנגעברײט פֿאַר מײַנע טריט,</para>
  <para style="q" vid="PSA 57:7">מע האָט אײַנגעבױגן מײַן זעל;</para>
  <para style="q" vid="PSA 57:7">זײ האָבן געגראָבן פֿאַר מיר אַ גרוב,</para>
  <para style="q" vid="PSA 57:7">זײַנען זײ אַלײן אַרײַנגעפֿאַלן אין איר.</para>
  <para style="q" vid="PSA 57:7">סֶלָה.<verse eid="PSA 57:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 57:8" /> פֿעסט איז מײַן האַרץ, אלֹקים, פֿעסט איז מײַן האַרץ,</para>
  <para style="q" vid="PSA 57:8">איך װעל זינגען און שפּילן.<verse eid="PSA 57:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 57:9" /> דערװעק דיך, מײַן זעל,</para>
  <para style="q" vid="PSA 57:9">דערװעק דיך, גיטאַר און האַרף;</para>
  <para style="q" vid="PSA 57:9">לאָמיך אױפֿװעקן דעם באַגינען.<verse eid="PSA 57:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 57:10" /> איך װעל דיך לױבן צװישן די פֿעלקער, אָ אֲדֹנָי,</para>
  <para style="q" vid="PSA 57:10">איך װעל דיך באַזינגען צװישן די אומות.<verse eid="PSA 57:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 57:11" /> װאָרעם גרױס ביז די הימלען איז דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 57:11">און ביז די װאָלקן דײַן טרײַשאַפֿט.<verse eid="PSA 57:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 57:12" /> דערהײב דיך איבער די הימלען, אלֹקים,</para>
  <para style="q" vid="PSA 57:12">איבער דער גאַנצער ערד זאָל זײַן דײַן כּבֿוד.<verse eid="PSA 57:12" /></para>
  <chapter eid="PSA 57" />
  <chapter number="58" style="c" pubnumber="נח" sid="PSA 58" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 58:1" />פֿאַר דעם געזאַנגמײַסטער; אַל-תַּשחֵת; פֿון דָוִדן אַ מִכתָּם.<verse eid="PSA 58:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 58:2" /> זענט איר ניט שטום דעם איר זאָלט פֿון גערעכטיקײט רעדן?</para>
  <para style="q" vid="PSA 58:2">אין אמת משפּטים טוט איר, מענטשנקינדער?<verse eid="PSA 58:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 58:3" /> יאָ, אין האַרצן אַרבעט איר אױס פֿאַרברעכן,</para>
  <para style="q" vid="PSA 58:3">אױף דער ערד פֿירט איר דורך דאָס אומרעכט פֿון אײַערע הענט.<verse eid="PSA 58:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 58:4" /> די רשעים זײַנען אָפּגעקערט פֿון טראַכט אָן,</para>
  <para style="q" vid="PSA 58:4">פֿון מוטערלײַב אָן בלאָנדזשען די ליגנזאָגערס.<verse eid="PSA 58:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 58:5" /> אַ גיפֿט איז בײַ זײ גלײַך װי גיפֿט פֿון אַ שלאַנג;</para>
  <para style="q" vid="PSA 58:5">װי דער טױבער נאָטער װאָס פֿאַרשטאָפּט זײַן אױער,<verse eid="PSA 58:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 58:6" /> װאָס הערט נישט צו דעם קֹול פֿון באַשװערער,</para>
  <para style="q" vid="PSA 58:6">פֿון דעם קליגסטן שפּרעכער פֿון שפּרוכן.<verse eid="PSA 58:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 58:7" /> אלֹקים, צעברעך זײערע צײן אין זײער מױל,</para>
  <para style="q" vid="PSA 58:7">די באַקצײן פֿון די יונגלײבן האַק אױס, ה׳.<verse eid="PSA 58:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 58:8" /> זאָלן זײ צעגײן װי װאַסער װאָס צעלױפֿט זיך;</para>
  <para style="q" vid="PSA 58:8">שפּאַנט ער זײַנע פֿײַלן, זאָלן זײ װי אָפּגעשניטן װערן.<verse eid="PSA 58:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 58:9" /> װי אַ צעקראָכענע שנעק זאָל ער פֿאַרגײן,</para>
  <para style="q" vid="PSA 58:9">װי אַ מפּיל, װי אַ קראָט, װאָס האָבן די זון נישט געזען.<verse eid="PSA 58:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 58:10" /> אײדער אײַערע טעפּ װעלן דערשפּירן די דערנער,</para>
  <para style="q" vid="PSA 58:10">זאָל ער עס אַװעקשטורעמען, דאָס רױע װי דאָס צוגעברענטע.<verse eid="PSA 58:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 58:11" /> דער צדיק װעט זיך פֿרײען, אַז ער זעט נקמה,</para>
  <para style="q" vid="PSA 58:11">זײַנע טריט װעט ער װאַשן אין בלוט פֿון דעם רשע.<verse eid="PSA 58:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 58:12" /> און מענטשן װעלן זאָגן: יאָ, עס איז דאָ אַ פֿרוכט פֿאַרן צדיק;</para>
  <para style="q" vid="PSA 58:12">יאָ, פֿאַראַן אַ אלֹקים װאָס משפּט אױף דער ערד.<verse eid="PSA 58:12" /></para>
  <chapter eid="PSA 58" />
  <chapter number="59" style="c" pubnumber="נט" sid="PSA 59" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 59:1" />פֿאַר דעם געזאַנגמײַסטער; אַל-תַּשחֵת; פֿון דָוִדן אַ מִכתָּם, װען שָאול האָט געשיקט, און מע האָט געהיט דאָס הױז, כּדי אים צו טײטן.<verse eid="PSA 59:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 59:2" /> זײַ מיך מציל פֿון מײַנע פֿײַנט, מײַן ג-ט,</para>
  <para style="q" vid="PSA 59:2">פֿון די װאָס שטײען אָן אױף מיר זאָלסטו מיך באַשיצן.<verse eid="PSA 59:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 59:3" /> זײַ מיך מציל פֿון די װאָס טוען אומרעכט,</para>
  <para style="q" vid="PSA 59:3">און פֿון בלוטיקע לײַט טו מיך העלפֿן.<verse eid="PSA 59:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 59:4" /> װאָרעם זע, זײ האָבן געלױערט אױף מײַן זעל;</para>
  <para style="q" vid="PSA 59:4">עס קלײַבן זיך די פֿאַרשײַטע אױף מיר;</para>
  <para style="q" vid="PSA 59:4">נישט פֿאַר מײַן פֿאַרברעך און נישט פֿאַר מײַן חטא, ה׳.<verse eid="PSA 59:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 59:5" /> אָן אַ זינד פֿון מיר, לױפֿן זײ און ברײטן זיך אָן;</para>
  <para style="q" vid="PSA 59:5">דערװעק זיך מיר אַנטקעגן, און זע.<verse eid="PSA 59:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 59:6" /> דו ביסט דאָך ה׳ אלֹקים צבָֿאוֹת,</para>
  <para style="q" vid="PSA 59:6">אלוקי יִשׂרָאֵל,</para>
  <para style="q" vid="PSA 59:6">װאַך אױף זיך צו רעכענען מיט אַלע פֿעלקער;</para>
  <para style="q" vid="PSA 59:6">נישט לײַטזעליקן זאָלסטו אַלע אומגערעכטע פֿעלשער.</para>
  <para style="q" vid="PSA 59:6">סֶלָה.<verse eid="PSA 59:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 59:7" /> אַלע אָװנט קומען זײ װידער,</para>
  <para style="q" vid="PSA 59:7">זײ װױען װי אַ הונט,</para>
  <para style="q" vid="PSA 59:7">און דרײען זיך אום אין שטאָט.<verse eid="PSA 59:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 59:8" /> זע, זײ גײַװערען מיט זײער מױל;</para>
  <para style="q" vid="PSA 59:8">שװערדן זײַנען אין זײערע ליפּן;</para>
  <para style="q" vid="PSA 59:8">װאָרעם: װער הערט דען?<verse eid="PSA 59:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 59:9" /> אָבער דו ה׳ טוסט לאַכן פֿון זײ,</para>
  <para style="q" vid="PSA 59:9">טוסט שפּאָטן פֿון אַלע פֿעלקער.<verse eid="PSA 59:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 59:10" /> מײַן שטאַרקײט, אױף דיר װעל איך װאַרטן;</para>
  <para style="q" vid="PSA 59:10">װאָרעם אלֹקים איז מײַן פֿעסטונג.<verse eid="PSA 59:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 59:11" /> דער ג-ט פֿון מײַן גענאָד װעט מיר אַנטקעגן קומען,</para>
  <para style="q" vid="PSA 59:11">אלֹקים װעט מיך לאָזן זען אױף מײַנע לױערער.<verse eid="PSA 59:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 59:12" /> נישט הרגען זאָלסטו זײ, כּדי מײַן פֿאָלק זאָל נישט פֿאַרגעסן;</para>
  <para style="q" vid="PSA 59:12">צעטרײסל זײ מיט דײַן מאַכט, און װאַרף זײ אַנידער,</para>
  <para style="q" vid="PSA 59:12">אָ אֲדֹנָי אונדזער שילד.<verse eid="PSA 59:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 59:13" /> פֿאַר דער זינד פֿון זײער מױל, דעם גערײד פֿון זײערע ליפּן,</para>
  <para style="q" vid="PSA 59:13">זאָלן זײ באַצװוּנגען װערן אין זײער גאװה,</para>
  <para style="q" vid="PSA 59:13">און פֿאַר די קללות און פֿאַר די ליגנס װאָס זײ רעדן.<verse eid="PSA 59:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 59:14" /> פֿאַרלענד אין גרימצאָרן,</para>
  <para style="q" vid="PSA 59:14">פֿאַרלענד אַז זײ זאָלן מער נישט זײַן,</para>
  <para style="q" vid="PSA 59:14">און זאָל מען װיסן אַז אלֹקים געװעלטיקט אין יעקבֿ,</para>
  <para style="q" vid="PSA 59:14">ביז די עקן פֿון דער ערד.</para>
  <para style="q" vid="PSA 59:14">סֶלָה.<verse eid="PSA 59:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 59:15" /> יאָ, אַלע אָװנט קומען זײ װידער,</para>
  <para style="q" vid="PSA 59:15">זײ װױען װי אַ הונט,</para>
  <para style="q" vid="PSA 59:15">און דרײען זיך אום אין שטאָט.<verse eid="PSA 59:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 59:16" /> זײ װאַנדערן אַרום צו פֿאַרצערן,</para>
  <para style="q" vid="PSA 59:16">און בלײַבן אַ גאַנצע נאַכט ביז זײ װערן נישט זאַט.<verse eid="PSA 59:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 59:17" /> אָבער איך װעל באַזינגען דײַן שטאַרקײט,</para>
  <para style="q" vid="PSA 59:17">און װעל שאַלן פֿרימאָרגנס דײַן חֶסֶד.</para>
  <para style="q" vid="PSA 59:17">װאָרעם דו ביסט מיר געװען אַ פֿעסטונג,</para>
  <para style="q" vid="PSA 59:17">און אַן אַנטרינונג אין טאָג פֿון מײַן נױט.<verse eid="PSA 59:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 59:18" /> מײַן שטאַרקײט, צו דיר װעל איך זינגען,</para>
  <para style="q" vid="PSA 59:18">װאָרעם אלֹקים איז מײַן פֿעסטונג, דער אלֹקים פֿון מײַן גענאָד.<verse eid="PSA 59:18" /></para>
  <chapter eid="PSA 59" />
  <chapter number="60" style="c" pubnumber="ס" sid="PSA 60" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 60:1" />פֿאַר דעם געזאַנגמײַסטער; אױף שושַן-עדות; אַ מִכתָּם פֿון דָוִדן פֿאַר אַ לערנונג, <verse eid="PSA 60:1" /><verse number="2" style="v" sid="PSA 60:2" />װען ער האָט מלחמה געהאַלטן מיט אַרַם-נַהרַיִם און אַרָם פֿון צוֹבֿה, און יוֹאָבֿ האָט זיך אומגעקערט, און האָט געשלאָגן פֿון אֶדוֹם אין טאָל פֿון זאַלץ צװעלף טױזנט.<verse eid="PSA 60:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="1" sid="PSA 60:3" /> אלֹקים, האָסט אונדז פֿאַרלאָזט, האָסט אונדז צעבראָכן;</para>
  <para style="q" vid="PSA 60:3">האָסט געצערנט אױף אונדז, זאָלסטו אונדז װידער אױפֿריכטן.<verse eid="PSA 60:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="2" sid="PSA 60:4" /> האָסט אױפֿגעשטורעמט די ערד, האָסט זי צעשפּאָלטן;</para>
  <para style="q" vid="PSA 60:4">הײל אירע בראָכן, װאָרעם זי װאַקלט זיך.<verse eid="PSA 60:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="3" sid="PSA 60:5" /> האָסט געמאַכט זען דײַן פֿאָלק שװערע לײַדן,</para>
  <para style="q" vid="PSA 60:5">האָסט אונדז אָנגעטרונקען מיט װײַן פֿון פֿאַרטומלעניש.<verse eid="PSA 60:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="4" sid="PSA 60:6" /> גיב דײַנע פֿאָרכטער אַ פֿאָן,</para>
  <para style="q" vid="PSA 60:6">זיך אײַנצוזאַמלען פֿאַרן אמת.</para>
  <para style="q" vid="PSA 60:6">סֶלָה.<verse eid="PSA 60:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="5" sid="PSA 60:7" /> כּדי דײַנע באַליבטע זאָלן דערלײזט װערן,</para>
  <para style="q" vid="PSA 60:7">העלף מיט דײַן רעכטער האַנט, און ענטפֿער מיר.<verse eid="PSA 60:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="6" sid="PSA 60:8" /> אלֹקים האָט גערעדט אין זײַן הײליקײט,</para>
  <para style="q" vid="PSA 60:8">אַז איך װעל דערפֿרײט װערן;</para>
  <para style="q" vid="PSA 60:8">איך װעל צעטײלן שכֶם,</para>
  <para style="q" vid="PSA 60:8">און דעם טאָל סוכּוֹת װעל איך אױסמעסטן.<verse eid="PSA 60:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="7" sid="PSA 60:9" /> מײַן איז גִלעָד, און מײַן איז מנַשֶה,</para>
  <para style="q" vid="PSA 60:9">און אפֿרים איז דער קיװער פֿון מײַן קאָפּ;</para>
  <para style="q" vid="PSA 60:9">יהוּדה איז מײַן צעפּטער.<verse eid="PSA 60:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="8" sid="PSA 60:10" /> מוֹאָבֿ איז מײַן װאַשטאָפּ;</para>
  <para style="q" vid="PSA 60:10">אױף אֶדוֹם װאַרף איך מײַן שוך;</para>
  <para style="q" vid="PSA 60:10">איבער מיר, פּלֶשֶת, װעסטו שרײַען.<verse eid="PSA 60:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="9" sid="PSA 60:11" /> װער ברענגט מיך צו דער באַפֿעסטיקטער שטאָט?</para>
  <para style="q" vid="PSA 60:11">װער טוט מיך פֿירן קײן אֶדוֹם?<verse eid="PSA 60:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="10" sid="PSA 60:12" /> פֿאַר װאָר, דו אלֹקים האָסט אונדז פֿאַרלאָזט,</para>
  <para style="q" vid="PSA 60:12">און גײַסט נישט אַרױס, אלֹקים, מיט אונדזערע מחנות.<verse eid="PSA 60:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="11" sid="PSA 60:13" /> גיב אונדז הילף קעגן דעם פֿײַנט,</para>
  <para style="q" vid="PSA 60:13">װאָרעם נישטיק איז די ישועה פֿון אַ מענטשן.<verse eid="PSA 60:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="12" sid="PSA 60:14" /> מיט אלֹקים װעלן מיר אױפֿטאָן גבֿורות,</para>
  <para style="q" vid="PSA 60:14">און ער װעט צעטרעטן אונדזערע פֿײַנט.<verse eid="PSA 60:14" /></para>
  <chapter eid="PSA 60" />
  <chapter number="61" style="c" pubnumber="סא" sid="PSA 61" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 61:1" />פֿאַר דעם געזאַנגמײַסטער, אױף סטרונעשפּיל; פֿון דָוִדן.<verse eid="PSA 61:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 61:2" /> הער צו, אלֹקים, מײַן געשרײ,</para>
  <para style="q" vid="PSA 61:2">פֿאַרנעם מײַן תּפֿילה.<verse eid="PSA 61:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 61:3" /> פֿון עק פֿון דער ערד רוף איך צו דיר,</para>
  <para style="q" vid="PSA 61:3">װען מײַן האַרץ פֿאַרגײט;</para>
  <para style="q" vid="PSA 61:3">אױף דעם פֿעלדז װאָס איז צו הױך פֿאַר מיר,</para>
  <para style="q" vid="PSA 61:3">זאָלסטו מיך אַרױפֿפֿירן.<verse eid="PSA 61:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 61:4" /> װאָרעם דו ביסט מיר געװען אַ באַשיצונג,</para>
  <para style="q" vid="PSA 61:4">אַ טורעם פֿון שטאַרקײט אַקעגן דעם פֿײַנט.<verse eid="PSA 61:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 61:5" /> איך װעל אײביק װױנען אין דײַן געצעלט.</para>
  <para style="q" vid="PSA 61:5">איך װעל מיך שיצן אין דער פֿאַרבאָרגעניש פֿון דײַנע פֿליגלען.</para>
  <para style="q" vid="PSA 61:5">סֶלָה.<verse eid="PSA 61:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 61:6" /> װאָרעם דו, אלֹקים, האָסט צוגעהערט צו מײַנע נדרים;</para>
  <para style="q" vid="PSA 61:6">האָסט געגעבן די אַרב</para>
  <para style="q" vid="PSA 61:6">פֿון די װאָס פֿאָרכטן דײַן נאָמען.<verse eid="PSA 61:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 61:7" /> טעג צו די טעג פֿון דעם מלך זאָלסטו צולײגן,</para>
  <para style="q" vid="PSA 61:7">זײַנע יאָרן זאָלן זײַן װי אַ דור אױף אַ דור.<verse eid="PSA 61:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 61:8" /> טראָנען זאָל ער אײביק פֿאַר אלֹקים;</para>
  <para style="q" vid="PSA 61:8">גענאָד און טרײַשאַפֿט באַשער, זײ זאָלן אים היטן.<verse eid="PSA 61:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 61:9" /> אַזױ װעל איך באַזינגען דײַן נאָמען אױף אײביק,</para>
  <para style="q" vid="PSA 61:9">װען איך באַצאָל מײַנע נדרים טאָגטעגלעך.<verse eid="PSA 61:9" /></para>
  <chapter eid="PSA 61" />
  <chapter number="62" style="c" pubnumber="סב" sid="PSA 62" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 62:1" />פֿאַר דעם געזאַנגמײַסטער, פֿאַר ידותון; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 62:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 62:2" /> נאָר צו אלֹקים טוט האַרן מײַן זעל,</para>
  <para style="q" vid="PSA 62:2">פֿון אים איז מײַן הילף.<verse eid="PSA 62:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 62:3" /> נאָר ער איז מײַן פֿעלדז און מײַן הילף,</para>
  <para style="q" vid="PSA 62:3">מײַן פֿעסטונג, איך זאָל זיך נישט אױסגליטשן שטאַרק.<verse eid="PSA 62:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 62:4" /> ביז װאַנען װעט איר אָנפֿאַלן אױף אַ מענטשן?</para>
  <para style="q" vid="PSA 62:4">איר אַלע טוט הרגען</para>
  <para style="q" vid="PSA 62:4">װי אַ װאַנט אַן אײַנגעבױגענע,</para>
  <para style="q" vid="PSA 62:4">װי אַ מױער אַן אומגעפֿאַלענע.<verse eid="PSA 62:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 62:5" /> רַק זײ עֵצהן זיך פֿון זײַן הױכקײט אים אַראָפּצושטױסן;</para>
  <para style="q" vid="PSA 62:5">זײ האָבן הנאה פֿון ליגן;</para>
  <para style="q" vid="PSA 62:5">מיט זײער מױל בענטשן זײ,</para>
  <para style="q" vid="PSA 62:5">און אין זיך שילטן זײ.</para>
  <para style="q" vid="PSA 62:5">סֶלָה.<verse eid="PSA 62:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 62:6" /> נאָר צו אלֹקים, טו האַרן, מײַן זעל,</para>
  <para style="q" vid="PSA 62:6">װאָרעם פֿון אים איז מײַן האָפֿונג.<verse eid="PSA 62:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 62:7" /> נאָר ער איז מײַן פֿעלדז און מײַן הילף,</para>
  <para style="q" vid="PSA 62:7">מײַן פֿעסטונג, איך זאָל זיך נישט אױסגליטשן.<verse eid="PSA 62:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 62:8" /> בײַ אלֹקים איז מײַן הילף און מײַן כּבֿוד;</para>
  <para style="q" vid="PSA 62:8">דער פֿעלדז פֿון מײַן שטאַרקײט, מײַן באַשיצונג איז אין אלֹקים.<verse eid="PSA 62:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 62:9" /> פֿאַרזיכערט אײַך אױף אים אין יעטװעדער צײַט, איר פֿאָלק,</para>
  <para style="q" vid="PSA 62:9">גיסט אױס פֿאַר אים אײַער האַרץ;</para>
  <para style="q" vid="PSA 62:9">אלֹקים איז אונדז אַ באַשיצונג.</para>
  <para style="q" vid="PSA 62:9">סֶלָה.<verse eid="PSA 62:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 62:10" /> בלױז אַ הױך זײַנען די מענטשנקינדער,</para>
  <para style="q" vid="PSA 62:10">אַן אָפּנאַר די אָנגעזעענע לײַט;</para>
  <para style="q" vid="PSA 62:10">װען מע זאָל אױף אַ װאָגשאָל אַרױפֿלײגן,</para>
  <para style="q" vid="PSA 62:10">זײַנען זײ אין אײנעם אַ הױך.<verse eid="PSA 62:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 62:11" /> איר זאָלט אײַך נישט פֿאַרזיכערן אױף רױב,</para>
  <para style="q" vid="PSA 62:11">און נישט נאַרן אױף גזלה זאָלט איר אײַך.</para>
  <para style="q" vid="PSA 62:11">אַז דער פֿאַרמעג װאַקסט,</para>
  <para style="q" vid="PSA 62:11">זאָלט איר נישט לײגן קײן אַכט.<verse eid="PSA 62:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 62:12" /> אײן מאָל האָט אלֹקים גערעדט,</para>
  <para style="q" vid="PSA 62:12">צװײ מאָל האָב איך דאָס געהערט,</para>
  <para style="q" vid="PSA 62:12">אַז שטאַרקײט איז בײַ אלֹקים.<verse eid="PSA 62:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 62:13" /> און בײַ דיר, אָ אֲדֹנָי, איז גענאָד,</para>
  <para style="q" vid="PSA 62:13">װאָרעם דו באַצאָלסט איטלעכן לױט זײַנע מעשׂים.<verse eid="PSA 62:13" /></para>
  <chapter eid="PSA 62" />
  <chapter number="63" style="c" pubnumber="סג" sid="PSA 63" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 63:1" />אַ מיזמור פֿון דָוִדן, װען ער איז געװען אין דער מדבר פֿון יהוּדה.<verse eid="PSA 63:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 63:2" /> אלֹקים, דו ביסט אֵלי,</para>
  <para style="q" vid="PSA 63:2">דיך טו איך זוכן;</para>
  <para style="q" vid="PSA 63:2">נאָך דיר דאָרשט מײַן זעל,</para>
  <para style="q" vid="PSA 63:2">צו דיר געלוסט מײַן לײַב,</para>
  <para style="q" vid="PSA 63:2">אין אַ לאַנד פֿון טריקעניש,</para>
  <para style="q" vid="PSA 63:2">און אַ פֿאַרשמאַכטער אָן װאַסער.<verse eid="PSA 63:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 63:3" /> אַזױ האָב איך אױסגעקוקט אױף דיר,</para>
  <para style="q" vid="PSA 63:3">אין הײליקטום צו זען דײַן שטאַרקײט און דײַן כּבֿוד.<verse eid="PSA 63:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 63:4" /> װאָרעם דײַן חֶסֶד איז בעסער פֿון לעבן;</para>
  <para style="q" vid="PSA 63:4">מײַנע ליפּן װעלן דיך לױבן.<verse eid="PSA 63:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 63:5" /> אַזױ װעל איך דיך בענטשן דורך מײַן לעבן;</para>
  <para style="q" vid="PSA 63:5">אין דײַן נאָמען װעל איך אױפֿהײבן מײַנע הענט.<verse eid="PSA 63:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 63:6" /> װי מיט פֿעטס און מאַרך איז זאַט מײַן זעל,</para>
  <para style="q" vid="PSA 63:6">און מיט זינגעדיקע ליפּן טוט לױבן מײַן מױל,<verse eid="PSA 63:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 63:7" /> אַז איך דערמאָן דיך אױף מײַן געלעגער,</para>
  <para style="q" vid="PSA 63:7">אַז איך טראַכט אָן דיר אין די װאַכן פֿון דער נאַכט.<verse eid="PSA 63:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 63:8" /> װאָרעם ביסט מיר אַ הילף געװען,</para>
  <para style="q" vid="PSA 63:8">און אין שאָטן פֿון דײַנע פֿליגלען טו איך זינגען.<verse eid="PSA 63:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 63:9" /> מײַן זעל איז באַהעפֿט נאָך דיר;</para>
  <para style="q" vid="PSA 63:9">דײַן רעכטע האַנט לענט מיך אונטער.<verse eid="PSA 63:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 63:10" /> און די װאָס זוכן מײַן זעל אױף אומצוברענגען,</para>
  <para style="q" vid="PSA 63:10">װעלן אַרײַן אין די טיפֿענישן פֿון דער ערד.<verse eid="PSA 63:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 63:11" /> מע װעט זײ שלײַדערן אין מאַכט פֿון דער שװערד;</para>
  <para style="q" vid="PSA 63:11">דער חלק פֿון פֿיקס װעלן זײ זײַן.<verse eid="PSA 63:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 63:12" /> אָבער דער מלך װעט זיך פֿרײען מיט אלֹקים;</para>
  <para style="q" vid="PSA 63:12">רימען װעט זיך איטלעכער װאָס שװערט בײַ אים;</para>
  <para style="q" vid="PSA 63:12">װאָרעם פֿאַרשטאָפּט װערן װעט דאָס מױל פֿון די ליגנזאָגער.<verse eid="PSA 63:12" /></para>
  <chapter eid="PSA 63" />
  <chapter number="64" style="c" pubnumber="סד" sid="PSA 64" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 64:1" />פֿאַר דעם געזאַנגמײַסטער; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 64:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 64:2" /> הער צו, אלֹקים, מײַן קֹול אין מײַן קלאָג;</para>
  <para style="q" vid="PSA 64:2">פֿון דער אַנגסט פֿון פֿײַנט זאָלסטו באַהיטן מײַן לעבן.<verse eid="PSA 64:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 64:3" /> זאָלסט מיך פֿאַרבאָרגן פֿון דעם באַראָט פֿון די שלעכטסטוער,</para>
  <para style="q" vid="PSA 64:3">פֿון דעם טומל פֿון די װאָס װערקן אומרעכט;<verse eid="PSA 64:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 64:4" /> װאָס האָבן געשאַרפֿט װי אַ שװערד זײער צונג,</para>
  <para style="q" vid="PSA 64:4">געשפּאַנט זײער פֿײַל – אַ גיפֿטיק װאָרט,<verse eid="PSA 64:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 64:5" /> צו שיסן אין פֿאַרבאָרגענישן דעם אומשולדיקן;</para>
  <para style="q" vid="PSA 64:5">פּלוצלינג שיסן זײ אים, און האָבן נישט מורא.<verse eid="PSA 64:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 64:6" /> זײ שטאַרקן אײנאַנדער אין דער בײזער זאַך;</para>
  <para style="q" vid="PSA 64:6">זײ רעדן אָפּ אונטערצולײגן נעצן;</para>
  <para style="q" vid="PSA 64:6">זײ זאָגן, װער קען זײ זען.<verse eid="PSA 64:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 64:7" /> זײ זוכן אױס פֿאַרברעכן,</para>
  <para style="q" vid="PSA 64:7">זײ האָבן דורכגעמאַכט אַ גרונטיקע זוכעניש;</para>
  <para style="q" vid="PSA 64:7">און די אינעװײניקײט פֿון איטלעכן און דאָס האַרץ איז טיף.<verse eid="PSA 64:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 64:8" /> אָבער אלֹקים שיסט אױף זײ פּלוצלינג אַ פֿײַל;</para>
  <para style="q" vid="PSA 64:8">עס געשעען זײערע שלעק.<verse eid="PSA 64:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 64:9" /> און מע מאַכט זײער צונג אַ שטרױכלונג פֿאַר זײ אַלײן;</para>
  <para style="q" vid="PSA 64:9">אױפֿגעטרײסלט װערן אַלע װאָס קוקן אױף זײ.<verse eid="PSA 64:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 64:10" /> און אַלע מענטשן האָבן מורא,</para>
  <para style="q" vid="PSA 64:10">און דערצײלן דאָס װערק פֿון אלֹקים,</para>
  <para style="q" vid="PSA 64:10">און זײַן טוּונג פֿאַרשטײען זײ.<verse eid="PSA 64:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 64:11" /> דער צדיק פֿרײט זיך מיט ה׳, און טוט זיך שיצן אין אים,</para>
  <para style="q" vid="PSA 64:11">און עס רימען זיך אַלע רעכטפֿאַרטיקע הערצער.<verse eid="PSA 64:11" /></para>
  <chapter eid="PSA 64" />
  <chapter number="65" style="c" pubnumber="סה" sid="PSA 65" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 65:1" />פֿאַר דעם געזאַנגמײַסטער; אַ מיזמור; פֿון דָוִדן אַ געזאַנג.<verse eid="PSA 65:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 65:2" /> אױף דיר, אלֹקים, האַרט לױב אין צִיוֹן,</para>
  <para style="q" vid="PSA 65:2">און צו דיר װערן נדרים געצאָלט.<verse eid="PSA 65:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 65:3" /> דו װאָס הערסט צו אַ תּפֿילה,</para>
  <para style="q" vid="PSA 65:3">צו דיר קומען אַלע לײַבער.<verse eid="PSA 65:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 65:4" /> די זינדיקע מעשׂים זײַנען צו שטאַרק פֿאַר מיר;</para>
  <para style="q" vid="PSA 65:4">אונדזערע פֿאַרברעכן, זײ זאָלסט דו מכַפּר זײַן.<verse eid="PSA 65:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 65:5" /> װױל צו דעם װאָס דו װײלסט</para>
  <para style="q" vid="PSA 65:5">און דערנענטערסט,</para>
  <para style="q" vid="PSA 65:5">ער זאָל רוען אין דײַנע הױפֿן.</para>
  <para style="q" vid="PSA 65:5">לאָמיר זיך זעטן מיט דעם גוטס פֿון דײַן הױז,</para>
  <para style="q" vid="PSA 65:5">מיט דער הײליקײט פֿון דײַן הֵיכל.<verse eid="PSA 65:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 65:6" /> מיט פֿאָרכטיקע װוּנדער ענטפֿערסטו אונדז אין גערעכטיקײט,</para>
  <para style="q" vid="PSA 65:6">דו אלֹקים פֿון אונדזער הילף,</para>
  <para style="q" vid="PSA 65:6">דו פֿאַרזיכערונג פֿון אַלע עקן ערד,</para>
  <para style="q" vid="PSA 65:6">און פֿון ימען װײַטע;<verse eid="PSA 65:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 65:7" /> דער װאָס באַפֿעסטיקט די בערג מיט זײַן כּוֹח,</para>
  <para style="q" vid="PSA 65:7">דער װאָס איז באַגורט מיט גבֿורה;<verse eid="PSA 65:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 65:8" /> דער װאָס שטילט אײַן די ברומונג פֿון די ימען,</para>
  <para style="q" vid="PSA 65:8">די ברומונג פֿון זײערע אינדן, און דעם טומל פֿון די פֿעלקער,<verse eid="PSA 65:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 65:9" /> ביז די באַװױנער פֿון װײַטע עקן האָבן מורא פֿאַר דײַנע צײכנס;</para>
  <para style="q" vid="PSA 65:9">די אַרױסגענג פֿון פֿרימאָרגן און אָװנט מאַכסטו זינגען.<verse eid="PSA 65:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 65:10" /> דערמאָנסט זיך אָן דער ערד און באַװאַסערסט זי,</para>
  <para style="q" vid="PSA 65:10">מאַכסט זי שֶפֿעדיק רײַך,</para>
  <para style="q" vid="PSA 65:10">פֿון דעם טײַך פֿון אלֹקים פֿול מיט װאַסער;</para>
  <para style="q" vid="PSA 65:10">ברײטסט אָן זײער קאָרן, װאָרעם ברײטסט זי צו ריכטיק;<verse eid="PSA 65:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 65:11" /> טרינקסט אָן אירע בײטן,</para>
  <para style="q" vid="PSA 65:11">זעצסט אַראָפּ אירע גרודעס,</para>
  <para style="q" vid="PSA 65:11">מאַכסט זי װײך מיט שפּרײרעגן,</para>
  <para style="q" vid="PSA 65:11">בענטשסט איר שפּראָצונג.<verse eid="PSA 65:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 65:12" /> האָסט געקרײנט דאָס יאָר מיט דײַן גוטס,</para>
  <para style="q" vid="PSA 65:12">און דײַנע שטעגן טריפֿן מיט פֿעטקײט.<verse eid="PSA 65:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 65:13" /> עס טריפֿן די פֿיטערפּלעצער פֿון מדבר,</para>
  <para style="q" vid="PSA 65:13">און פֿרײד גורטן אָן די הײכן.<verse eid="PSA 65:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 65:14" /> די לאָנקעס באַקלײדן זיך מיט שאָף,</para>
  <para style="q" vid="PSA 65:14">און די טאָלן װיקלען זיך אין תּבֿואה;</para>
  <para style="q" vid="PSA 65:14">זײ שאַלן און זײ זינגען.<verse eid="PSA 65:14" /></para>
  <chapter eid="PSA 65" />
  <chapter number="66" style="c" pubnumber="סו" sid="PSA 66" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 66:1" />פֿאַר דעם געזאַנגמײַסטער; אַ געזאַנג, אַ מיזמור.</para>
  <para style="q" vid="PSA 66:1">
    <char style="va">1</char> שאַלט צו אלֹקים, די גאַנצע ערד,<verse eid="PSA 66:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 66:2" />באַזינגט די פּראַכט פֿון זײַן נאָמען,</para>
  <para style="q" vid="PSA 66:2">מאַכט פּראַכטיק זײַן לױב.<verse eid="PSA 66:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 66:3" />זאָגט צו אלֹקים: װי פֿאָרכטיק איז דײַן װערק!</para>
  <para style="q" vid="PSA 66:3">דורך דײַן גרױס שטאַרקײט גײען אײַן פֿאַר דיר דײַנע פֿײַנט.<verse eid="PSA 66:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 66:4" />די גאַנצע ערד זאָל זיך בוקן צו דיר</para>
  <para style="q" vid="PSA 66:4">און זינגען צו דיר;</para>
  <para style="q" vid="PSA 66:4">זײ זאָלן באַזינגען דײַן נאָמען.</para>
  <para style="q" vid="PSA 66:4">סֶלָה.<verse eid="PSA 66:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 66:5" />קומט און זעט די מעשׂים פֿון אלֹקים;</para>
  <para style="q" vid="PSA 66:5">ער איז פֿאָרכטיק אין טוּונג פֿאַר די מענטשנקינדער.<verse eid="PSA 66:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 66:6" />ער האָט פֿאַרקערט דעם ים אין יבשה,</para>
  <para style="q" vid="PSA 66:6">צו פֿוס זײַנען זײ אַריבער דעם טײַך;</para>
  <para style="q" vid="PSA 66:6">דענצמאָל האָבן מיר זיך געפֿרײט מיט אים.<verse eid="PSA 66:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 66:7" />ער געװעלטיקט מיט זײַן גבֿורה אײביק,</para>
  <para style="q" vid="PSA 66:7">זײַנע אױגן קוקן אױף די פֿעלקער;</para>
  <para style="q" vid="PSA 66:7">זאָלן די אָפּקערער זיך נישט דערהײבן.</para>
  <para style="q" vid="PSA 66:7">סֶלָה.<verse eid="PSA 66:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 66:8" />לױבט, איר פֿעלקער, אלוקינו,</para>
  <para style="q" vid="PSA 66:8">און לאָזט הערן דעם קֹול פֿון זײַן לױב;<verse eid="PSA 66:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 66:9" />דער װאָס דערהאַלט אונדזער זעל בײַם לעבן,</para>
  <para style="q" vid="PSA 66:9">און האָט נישט געלאָזט זיך אױסגליטשן אונדזער פֿוס.<verse eid="PSA 66:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 66:10" />װאָרעם האָסט אונדז געפּרוּװט, אלֹקים;</para>
  <para style="q" vid="PSA 66:10">האָסט אונדז געלײַטערט װי מע לײַטערט זילבער.<verse eid="PSA 66:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 66:11" />האָסט אונדז געבראַכט אין אַ פֿעסטונג נעץ,</para>
  <para style="q" vid="PSA 66:11">האָסט אַרױפֿגעטאָן אַ דריקונג אױף אונדזערע לענדן.<verse eid="PSA 66:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 66:12" />האָסט געלאָזט רײַטן אַ מענטשן אױף אונדזער קאָפּ,</para>
  <para style="q" vid="PSA 66:12">מיר זײַנען געקומען אין פֿײַער און אין װאַסער,</para>
  <para style="q" vid="PSA 66:12">אָבער דו האָסט אונדז אַרױסגעצױגן אין זעטיקײט.<verse eid="PSA 66:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 66:13" />איך װעל קומען אין דײַן הױז מיט בראַנדאָפּפֿער,</para>
  <para style="q" vid="PSA 66:13">איך װעל דיר באַצאָלן מײַנע נדרים,<verse eid="PSA 66:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 66:14" />װאָס מײַנע ליפּן האָבן אַרױסגעלאָזט,</para>
  <para style="q" vid="PSA 66:14">און מײַן מױל האָט צוגעזאָגט אין מײַן נױט.<verse eid="PSA 66:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 66:15" />פֿעטע בראַנדאָפּפֿער װעל איך דיר אױפֿברענגען,</para>
  <para style="q" vid="PSA 66:15">מיט דעמפֿונג פֿון װידערס;</para>
  <para style="q" vid="PSA 66:15">איך װעל מאַכן רינדער מיט בעק.</para>
  <para style="q" vid="PSA 66:15">סֶלָה.<verse eid="PSA 66:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 66:16" />קומט הערט, אַלע יראי ה׳,</para>
  <para style="q" vid="PSA 66:16">און איך װעל דערצײלן װאָס ער האָט געטאָן צו מײַן זעל.<verse eid="PSA 66:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 66:17" />איך האָב גערופֿן צו אים מיט מײַן מױל,</para>
  <para style="q" vid="PSA 66:17">און ער איז געװען דערהױבן אױף מײַן צונג.<verse eid="PSA 66:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 66:18" />װען איך װאָלט אױסגעװײלט אומרעכט אין מײַן האַרצן,</para>
  <para style="q" vid="PSA 66:18">װאָלט נישט צוגעהערט אֲדֹנָי.<verse eid="PSA 66:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 66:19" />אָבער אלֹקים האָט צוגעהערט,</para>
  <para style="q" vid="PSA 66:19">ער האָט פֿאַרנומען דעם קֹול פֿון מײַן תּפֿילה.<verse eid="PSA 66:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 66:20" />געלױבט איז אלֹקים װאָס ער האָט נישט אָפּגעטאָן מײַן תּפֿילה,</para>
  <para style="q" vid="PSA 66:20">און זײַן חֶסֶד פֿון מיר.<verse eid="PSA 66:20" /></para>
  <chapter eid="PSA 66" />
  <chapter number="67" style="c" pubnumber="סז" sid="PSA 67" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 67:1" />פֿאַר דעם געזאַנגמײַסטער, מיט סטרונעשפּיל; אַ מיזמור, אַ געזאַנג.<verse eid="PSA 67:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 67:2" /> אלֹקים זאָל אונדז לײַטזעליקן און אונדז בענטשן,</para>
  <para style="q" vid="PSA 67:2">ער זאָל דערלײַכטן זײַן פּנים אױף אונדז,</para>
  <para style="q" vid="PSA 67:2">סֶלָה,<verse eid="PSA 67:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 67:3" /> כּדי מע זאָל װיסן אױף דער ערד דײַן װעג,</para>
  <para style="q" vid="PSA 67:3">צװישן אַלע פֿעלקער דײַן ישועה.<verse eid="PSA 67:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 67:4" /> לױבן װעלן דיך די פֿעלקער, אָ אלֹקים,</para>
  <para style="q" vid="PSA 67:4">לױבן װעלן דיך די פֿעלקער אַלע.<verse eid="PSA 67:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 67:5" /> זיך פֿרײען און זינגען װעלן די אומות,</para>
  <para style="q" vid="PSA 67:5">װאָרעם דו משפּטסט די פֿעלקער מיט יושר,</para>
  <para style="q" vid="PSA 67:5">און די אומות, זײ פֿירסטו אױף דער ערד.</para>
  <para style="q" vid="PSA 67:5">סֶלָה.<verse eid="PSA 67:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 67:6" /> לױבן װעלן דיך די פֿעלקער, אָ אלֹקים,</para>
  <para style="q" vid="PSA 67:6">לױבן װעלן דיך די פֿעלקער אַלע.<verse eid="PSA 67:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 67:7" /> די ערד גיט איר פֿרוכט,</para>
  <para style="q" vid="PSA 67:7">בענטשן װעט אונדז אלֹקים אלוקינו,<verse eid="PSA 67:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 67:8" /> בענטשן װעט אונדז אלֹקים</para>
  <para style="q" vid="PSA 67:8">און אים װעלן פֿאָרכטן אַלע עקן פֿון דער ערד.<verse eid="PSA 67:8" /></para>
  <chapter eid="PSA 67" />
  <chapter number="68" style="c" pubnumber="סח" sid="PSA 68" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 68:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון דָוִדן אַ מיזמור, אַ געזאַנג.<verse eid="PSA 68:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 68:2" /> אלֹקים װעט אױפֿשטײן, װעלן צעשפּרײט װערן זײַנע פֿײַנט,</para>
  <para style="q" vid="PSA 68:2">און זײַנע שָׂונאים װעלן אַנטלױפֿן פֿאַר אים.<verse eid="PSA 68:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 68:3" /> װי רױך װערט צעטריבן, װעסטו זײ צעטרײַבן;</para>
  <para style="q" vid="PSA 68:3">װי װאַקס צעגײט פֿאַר פֿײַער,</para>
  <para style="q" vid="PSA 68:3">װעלן אונטערגײן די רשעים פֿאַר אלֹקים.<verse eid="PSA 68:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 68:4" /> און די צדיקים װעלן זיך פֿרײען;</para>
  <para style="q" vid="PSA 68:4">זײ װעלן זײַן לוסטיק פֿאַר אלֹקים,</para>
  <para style="q" vid="PSA 68:4">און קװעלן מיט שׂימחה.<verse eid="PSA 68:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 68:5" /> זינגט צו אלֹקים, באַזינגט זײַן נאָמען,</para>
  <para style="q" vid="PSA 68:5">דערהײבט דעם װאָס רײַט דורך די הימלען –</para>
  <para style="q" vid="PSA 68:5">ה׳ איז זײַן נאָמען –</para>
  <para style="q" vid="PSA 68:5">און פֿרײט זיך פֿאַר אים.<verse eid="PSA 68:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 68:6" /> דער פֿאָטער פֿון יתומים, און דער ריכטער פֿון אַלמנות,</para>
  <para style="q" vid="PSA 68:6">איז אלֹקים אין זײַן הײליקער װױנונג.<verse eid="PSA 68:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 68:7" /> אלֹקים באַזעצט די עלנדע אין אַ הײם,</para>
  <para style="q" vid="PSA 68:7">ער ברענגט אַרױס די געפֿאַנגענע אין גליק;</para>
  <para style="q" vid="PSA 68:7">נאָר די אָפּקערער בלײַבן אין טריקעניש.<verse eid="PSA 68:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 68:8" /> אלֹקים, אַז דו ביסט אַרױסגעגאַנגען פֿאַרױס פֿאַר דײַן פֿאָלק,</para>
  <para style="q" vid="PSA 68:8">אַז דו האָסט געשפּרײַזט דורך דער װיסטעניש,</para>
  <para style="q" vid="PSA 68:8">סֶלָה,<verse eid="PSA 68:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 68:9" /> האָט די ערד געציטערט, אױך די הימלען האָבן געטריפֿט פֿאַר אלֹקים;</para>
  <para style="q" vid="PSA 68:9">דער דאָזיקער סינַי – פֿאַר אלֹקים, אלוקי יִשׂרָאֵל.<verse eid="PSA 68:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 68:10" /> אַ רעגן פֿון שפֿע האָסטו אַראָפּגעזיפּט, אלֹקים,</para>
  <para style="q" vid="PSA 68:10">אַז דײַן נחלה איז פֿאַרשמאַכט געװען, האָסטו זי אױפֿגעריכט.<verse eid="PSA 68:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 68:11" /> דײַן סטאַדע האָט זיך באַזעצט דערין;</para>
  <para style="q" vid="PSA 68:11">האָסטו אין דײַן גוטסקײט, אלֹקים, אָנגעברײט פֿאַר די אָרימע.<verse eid="PSA 68:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 68:12" /> אֲדֹנָי האָט געגעבן דאָס װאָרט –</para>
  <para style="q" vid="PSA 68:12">מבֿשׂרות אַ גרױסע מחנה.<verse eid="PSA 68:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 68:13" /> מלכים פֿון מחנות לױפֿן-אַנטלױפֿן,</para>
  <para style="q" vid="PSA 68:13">און די שטובזיצערין טײלט רױב.<verse eid="PSA 68:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 68:14" /> צי װילט איר ליגן צװישן די שאָפֿגעהעפֿטן?</para>
  <para style="q" vid="PSA 68:14">די פֿליגלען פֿון דער טױב זײַנען מיט זילבער באַדעקט,</para>
  <para style="q" vid="PSA 68:14">און אירע פֿלעדערן מיט גלענצענדיק גאָלד.<verse eid="PSA 68:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 68:15" /> אַז שַדַי האָט צעשפּרײט די מלכים אין איר,</para>
  <para style="q" vid="PSA 68:15">האָט עס געשנײט אױף צלמון.<verse eid="PSA 68:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 68:16" /> אַ באַרג פֿון אלֹקים איז באַרג בָשָן,</para>
  <para style="q" vid="PSA 68:16">אַ באַרג פֿון שפּיצן איז באַרג בָשָן.<verse eid="PSA 68:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 68:17" /> װאָס קוקט איר קרום, איר פֿילשפּיציקע בערג,</para>
  <para style="q" vid="PSA 68:17">אױף דעם באַרג װאָס אלֹקים האָט פֿאַר זײַן װױנונג געגלוסט,</para>
  <para style="q" vid="PSA 68:17">װוּ ה׳ װעט אױך רוען אױף אײביק?<verse eid="PSA 68:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 68:18" /> די רײַטװעגן פֿון אלֹקים זײַנען צענטױזנטן,</para>
  <para style="q" vid="PSA 68:18">טױזנטן אױף טױזנטן;</para>
  <para style="q" vid="PSA 68:18">אֲדֹנָי איז צװישן זײ װי אױף סינַי אין הײליקײט.<verse eid="PSA 68:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 68:19" /> ביסט אַרױפֿגעגאַנגען אין דער הײך,</para>
  <para style="q" vid="PSA 68:19">האָסט געפֿאַנגען אַ געפֿאַנג,</para>
  <para style="q" vid="PSA 68:19">האָסט גענומען מתָּנות אין מענטשן;</para>
  <para style="q" vid="PSA 68:19">אַז אױך צװישן די אָפּקערער זאָל רוען ה׳ אלֹקים.<verse eid="PSA 68:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 68:20" /> געלױבט איז אֲדֹנָי,</para>
  <para style="q" vid="PSA 68:20">טאָג פֿאַר טאָג טוט ער אונדז טראָגן;</para>
  <para style="q" vid="PSA 68:20">אֵל איז אונדזער ישועה.</para>
  <para style="q" vid="PSA 68:20">סֶלָה.<verse eid="PSA 68:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 68:21" /> הָאֵל איז אונדז אַן אֵל פֿון ישועות,</para>
  <para style="q" vid="PSA 68:21">און בײַ ה׳ אֲדֹנָי זײַנען די אױסװעגן פֿון טױט.<verse eid="PSA 68:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 68:22" /> פֿאַר װאָר, אלֹקים װעט צעלעכערן דעם קאָפּ פֿון זײַנע פֿײַנט,</para>
  <para style="q" vid="PSA 68:22">דעם האָריקן שאַרבן פֿון דעם װאָס גײט אין זײַנע זינד.<verse eid="PSA 68:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 68:23" /> אֲדֹנָי זאָגט: פֿון בָשָן װעל איך אומקערן,</para>
  <para style="q" vid="PSA 68:23">איך װעל אומקערן פֿון די טיפֿענישן פֿון ים;<verse eid="PSA 68:23" /></para>
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 68:24" /> כּדי זאָלסט טונקען אין בלוט דײַן פֿוס,</para>
  <para style="q" vid="PSA 68:24">די צונג פֿון דײַנע הינט זאָל האָבן איר חלק פֿון די פֿײַנט.<verse eid="PSA 68:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 68:25" /> מע קוקט-צו דײַנע גײונגען, אלֹקים,</para>
  <para style="q" vid="PSA 68:25">די גײונגען צו מײַן אֵל, מײַן קיניג, אין הײליקטום.<verse eid="PSA 68:25" /></para>
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 68:26" /> פֿאַרױס גײען די זינגער, נאָך דעם די שפּילער,</para>
  <para style="q" vid="PSA 68:26">אין מיטן פֿון יונגפֿרױען װאָס פּױקלען.<verse eid="PSA 68:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 68:27" /> אין געזעמלען לױבט אלֹקים,</para>
  <para style="q" vid="PSA 68:27">לױבט דעם האַר ה׳, איר פֿון קװאַל פֿון יִשׂרָאֵל.<verse eid="PSA 68:27" /></para>
  <para style="q">
    <verse number="28" style="v" altnumber="27" sid="PSA 68:28" /> אָן איז בנימין דער ייִנגסטער, זײער געװעלטיקער,</para>
  <para style="q" vid="PSA 68:28">די האַרן פֿון יהוּדה מיט זײער מחנה,</para>
  <para style="q" vid="PSA 68:28">די האַרן פֿון זבֿולון, די האַרן פֿון נַפֿתָּלי.<verse eid="PSA 68:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="28" sid="PSA 68:29" /> דײַן ג-ט זאָל באַפֿעלן דײַן שטאַרקײט;</para>
  <para style="q" vid="PSA 68:29">שטאַרק זיך, אלֹקים, דו װאָס האָסט געטאָן פֿאַר אונדז.<verse eid="PSA 68:29" /></para>
  <para style="q">
    <verse number="30" style="v" altnumber="29" sid="PSA 68:30" /> פֿון דײַן הֵיכל אין ירושָלַיִם;</para>
  <para style="q" vid="PSA 68:30">זאָלן מלכים דיר ברענגען מתָּנות.<verse eid="PSA 68:30" /></para>
  <para style="q">
    <verse number="31" style="v" altnumber="30" sid="PSA 68:31" /> שרײַ אָן אױף דער חיה פֿונעם װאַסערראָר,</para>
  <para style="q" vid="PSA 68:31">אױפֿן געזעמל אָקסן מיט די קעלבער-פֿעלקער,</para>
  <para style="q" vid="PSA 68:31">זײ זאָלן זיך צו די פֿיס װאַרפֿן מיט זילבערשטיקער;</para>
  <para style="q" vid="PSA 68:31">ער זאָל צעשפּרײטן די אומות װאָס באַגערן מלחמות.<verse eid="PSA 68:31" /></para>
  <para style="q">
    <verse number="32" style="v" altnumber="31" sid="PSA 68:32" /> שׂרָרות זאָלן קומען פֿון מִצרַיִם,</para>
  <para style="q" vid="PSA 68:32">כּוּש זאָל אױסשטרעקן אירע הענט צו אלֹקים.<verse eid="PSA 68:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" altnumber="32" sid="PSA 68:33" /> איר קיניגרײַכן פֿון דער ערד, זינגט צו אלֹקים,</para>
  <para style="q" vid="PSA 68:33">שפּילט צו אֲדֹנָי,</para>
  <para style="q" vid="PSA 68:33">סֶלָה;<verse eid="PSA 68:33" /></para>
  <para style="q">
    <verse number="34" style="v" altnumber="33" sid="PSA 68:34" /> צו דעם װאָס רײַט אױף די אוראַלטע הימלען פֿון די הימלען;</para>
  <para style="q" vid="PSA 68:34">זע, ער לאָזט אַרױס זײַן קֹול, אַ מאַכטיקן קֹול.<verse eid="PSA 68:34" /></para>
  <para style="q">
    <verse number="35" style="v" altnumber="34" sid="PSA 68:35" /> גיט שטאַרקײט צו אלֹקים;</para>
  <para style="q" vid="PSA 68:35">איבער יִשׂרָאֵל איז זײַן גרױסקײט,</para>
  <para style="q" vid="PSA 68:35">און זײַן שטאַרקײט אין די װאָלקנס.<verse eid="PSA 68:35" /></para>
  <para style="q">
    <verse number="36" style="v" altnumber="35" sid="PSA 68:36" /> אלֹקים איז פֿאָרכטיק פֿון דײַנע הײליקטומען;</para>
  <para style="q" vid="PSA 68:36">אֵל פֿון יִשׂרָאֵל, ער גיט שטאַרקײט און מאַכט צום פֿאָלק;</para>
  <para style="q" vid="PSA 68:36">געלױבט איז אלֹקים.<verse eid="PSA 68:36" /></para>
  <chapter eid="PSA 68" />
  <chapter number="69" style="c" pubnumber="סט" sid="PSA 69" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 69:1" />פֿאַר דעם געזאַנגמײַסטער, אױף שוֹשַנים; פֿון דָוִדן.<verse eid="PSA 69:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 69:2" /> העלף מיך, אלֹקים,</para>
  <para style="q" vid="PSA 69:2">װאָרעם דאָס װאַסער איז געקומען ביז דער האַלדז.<verse eid="PSA 69:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 69:3" /> איך בין אײַנגעזונקען אין אַ טיפֿן זומפּ,</para>
  <para style="q" vid="PSA 69:3">און נישטאָ קײן באַשטאַנד;</para>
  <para style="q" vid="PSA 69:3">איך בין געקומען אין טיפֿע װאַסערן,</para>
  <para style="q" vid="PSA 69:3">און דער שטראָם האָט מיך פֿאַרפֿלײצט.<verse eid="PSA 69:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 69:4" /> איך בין מיד פֿון מײַן רופֿן,</para>
  <para style="q" vid="PSA 69:4">מײַן קעל איז פֿאַרטריקנט,</para>
  <para style="q" vid="PSA 69:4">די אױגן גײען מיר אױס האַרנדיק אױף מײַן ג-ט.<verse eid="PSA 69:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 69:5" /> מער װי די האָר פֿון מײַן קאָפּ</para>
  <para style="q" vid="PSA 69:5">זײַנען מײַנע אומזיסטיקע שָׂונאים;</para>
  <para style="q" vid="PSA 69:5">שטאַרק זײַנען מײַנע פֿאַרטיליקער, מײַנע פֿײַנט פֿאַר גאָרנישט;</para>
  <para style="q" vid="PSA 69:5">װאָס איך האָב נישט געגזלט</para>
  <para style="q" vid="PSA 69:5">מוז איך דערום אָפּגעבן.<verse eid="PSA 69:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 69:6" /> אלֹקים, דו װײסט מײַן נאַרישקײט,</para>
  <para style="q" vid="PSA 69:6">און מײַנע פֿאַרשולדיקונגען זײַנען פֿון דיר נישט פֿאַרהױלן.<verse eid="PSA 69:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 69:7" /> זאָלן נישט אין ביוש בלײַבן דורך מיר דײַנע האָפֿער,</para>
  <para style="q" vid="PSA 69:7">דו אֲדֹנָי ה׳ צבָֿאוֹת;</para>
  <para style="q" vid="PSA 69:7">זאָלן נישט פֿאַרשעמט װערן דורך מיר דײַנע זוכער,</para>
  <para style="q" vid="PSA 69:7">אלוקי יִשׂרָאֵל.<verse eid="PSA 69:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 69:8" /> װאָרעם פֿון דײַנעט װעגן האָב איך געליטן חרפּה,</para>
  <para style="q" vid="PSA 69:8">אַ שאַנד האָט באַדעקט מײַן פּנים.<verse eid="PSA 69:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 69:9" /> פֿאַרפֿרעמדט בין איך געװאָרן צו מײַנע ברידער,</para>
  <para style="q" vid="PSA 69:9">און װילדפֿרעמד צו די זין פֿון מײַן מוטער.<verse eid="PSA 69:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 69:10" /> װאָרעם דער צאָרן פֿאַר דײַן הױז האָט מיך געגעסן,</para>
  <para style="q" vid="PSA 69:10">און די לעסטערונגען פֿון דײַנע לעסטערער זײַנען געפֿאַלן אױף מיר.<verse eid="PSA 69:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 69:11" /> און האָב איך אױסגעװײנט אין פֿאַסטן מײַן זעל,</para>
  <para style="q" vid="PSA 69:11">איז דאָס מיר צו לעסטערונג געװאָרן.<verse eid="PSA 69:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 69:12" /> און האָב איך געמאַכט זאַק מײַן קלײד,</para>
  <para style="q" vid="PSA 69:12">בין איך בײַ זײ צום שפּריכװאָרט געװאָרן.<verse eid="PSA 69:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 69:13" /> עס רעדן פֿון מיר די טױערזיצער,</para>
  <para style="q" vid="PSA 69:13">און איך בין דאָס געזאַנג פֿון די װײַנטרינקער.<verse eid="PSA 69:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 69:14" /> אָבער איך – מײַן תּפֿילה צו דיר, ה׳, איז:</para>
  <para style="q" vid="PSA 69:14">אַ שעה פֿון באַװיליקונג;</para>
  <para style="q" vid="PSA 69:14">אלֹקים, אין דײַן גרױס גענאָד</para>
  <para style="q" vid="PSA 69:14">ענטפֿער מיר מיט דײַן אמתער ישועה.<verse eid="PSA 69:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 69:15" /> זײַ מיך מציל פֿון דעם לײם,</para>
  <para style="q" vid="PSA 69:15">אַז איך זאָל נישט אײַנגעזונקען װערן;</para>
  <para style="q" vid="PSA 69:15">לאָמיך ניצול װערן פֿון מײַנע פֿײַנט,</para>
  <para style="q" vid="PSA 69:15">און פֿון די טיפֿע װאַסערן.<verse eid="PSA 69:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 69:16" /> לאָז מיך נישט פֿאַרפֿלײצן דער שטראָם װאַסער,</para>
  <para style="q" vid="PSA 69:16">און לאָז מיך נישט אײַנשלינגען די טיפֿעניש,</para>
  <para style="q" vid="PSA 69:16">און לאָז נישט צומאַכן די גרוב איר מױל איבער מיר.<verse eid="PSA 69:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 69:17" /> ענטפֿער מיר, ה׳, װאָרעם גוט איז דײַן חֶסֶד;</para>
  <para style="q" vid="PSA 69:17">לױט דײַן גרױס דערבאַרעמונג קער זיך צו מיר.<verse eid="PSA 69:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 69:18" /> און זאָלסט נישט פֿאַרבאָרגן דײַן פּנים פֿון דײַן קנעכט,</para>
  <para style="q" vid="PSA 69:18">װאָרעם מיר איז ענג; ענטפֿער מיר גיך.<verse eid="PSA 69:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 69:19" /> גענען צו מײַן זעל, לײז זי אױס,</para>
  <para style="q" vid="PSA 69:19">קױף מיך אױס פֿון װעגן מײַנע פֿײַנט.<verse eid="PSA 69:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 69:20" /> דו װײסט מײַן חרפּה און מײַן בושה און מײַן שאַנד,</para>
  <para style="q" vid="PSA 69:20">פֿאַר דיר זײַנען אַלע מײַנע דריקער.<verse eid="PSA 69:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 69:21" /> אַ חרפּה צעברעכט מײַן האַרץ, און איך בין חרובֿ;</para>
  <para style="q" vid="PSA 69:21">און איך האָב געהאָפֿט אױף באַדױער, און נישטאָ,</para>
  <para style="q" vid="PSA 69:21">און אױף טרײסטער, און נישט געפֿונען.<verse eid="PSA 69:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 69:22" /> און זײ האָבן אַרײַנגעטאָן גיפֿט אין מײַן שפּײַז,</para>
  <para style="q" vid="PSA 69:22">און פֿאַר מײַן דאָרשט גיבן זײ מיר טרינקען עסיק.<verse eid="PSA 69:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 69:23" /> זאָל זײער טיש װאָס פֿאַר זײ, װערן פֿאַר אַ נעץ,</para>
  <para style="q" vid="PSA 69:23">און אין מיטן פֿון פֿריד, פֿאַר אַ פּאַסטקע.<verse eid="PSA 69:23" /></para>
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 69:24" /> זאָלן זײערע אױגן פֿינצטער װערן נישט צו זען,</para>
  <para style="q" vid="PSA 69:24">און זײערע לענדן מאַך װאַקלען תּמיד.<verse eid="PSA 69:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 69:25" /> גיס אױס אױף זײ דײַן כּעס,</para>
  <para style="q" vid="PSA 69:25">און דײַן גרימצאָרן זאָל זײ דערגרײכן.<verse eid="PSA 69:25" /></para>
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 69:26" /> זאָל זײער ישובֿ זײַן פֿאַרװיסט,</para>
  <para style="q" vid="PSA 69:26">אין זײערע געצעלטן זאָל נישט זײַן קײן באַװױנער.<verse eid="PSA 69:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 69:27" /> װאָרעם דעם װאָס דו האָסט געשלאָגן רודפֿן זײ,</para>
  <para style="q" vid="PSA 69:27">און פֿון דעם װײטאָג פֿון דײַנע פֿאַרװוּנדטע דערצײלן זײ זיך.<verse eid="PSA 69:27" /></para>
  <para style="q">
    <verse number="28" style="v" altnumber="27" sid="PSA 69:28" /> לײג צו זינד אױף זײער זינד,</para>
  <para style="q" vid="PSA 69:28">און זאָלן זײ נישט צוקומען צו דײַן גערעכטיקײט.<verse eid="PSA 69:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="28" sid="PSA 69:29" /> זאָלן זײ אױסגעמעקט װערן פֿון בוך פֿון די לעבעדיקע,</para>
  <para style="q" vid="PSA 69:29">און מיט די גערעכטע זאָלן זײ נישט פֿאַרשריבן װערן.<verse eid="PSA 69:29" /></para>
  <para style="b" />
  <para style="q">
    <verse number="30" style="v" altnumber="29" sid="PSA 69:30" /> אָבער איך בין אָרים און צעװײטאָקט,</para>
  <para style="q" vid="PSA 69:30">זאָל דײַן הילף, אלֹקים, מיך דערהײכן.<verse eid="PSA 69:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" altnumber="30" sid="PSA 69:31" /> איך װעל רימען דעם נאָמען פֿון אלֹקים מיט געזאַנג,</para>
  <para style="q" vid="PSA 69:31">און װעל אים גרײסן מיט לױב.<verse eid="PSA 69:31" /></para>
  <para style="q">
    <verse number="32" style="v" altnumber="31" sid="PSA 69:32" /> און דאָס װעט זײַן בעסער בײַ ה׳</para>
  <para style="q" vid="PSA 69:32">װי אַן אָקס אָדער יונגער אָקס באַהאָרנט, באַקלױט.<verse eid="PSA 69:32" /></para>
  <para style="q">
    <verse number="33" style="v" altnumber="32" sid="PSA 69:33" /> זאָלן זען די געדריקטע, און זיך פֿרײען;</para>
  <para style="q" vid="PSA 69:33">איר װאָס זוכט אלֹקים, זאָל אױפֿלעבן אײַער האַרץ!<verse eid="PSA 69:33" /></para>
  <para style="q">
    <verse number="34" style="v" altnumber="33" sid="PSA 69:34" /> װאָרעם ה׳ הערט צו די באַדערפֿטיקע,</para>
  <para style="q" vid="PSA 69:34">און זײַנע געפֿאַנגענע טוט ער נישט פֿאַראַכטן.<verse eid="PSA 69:34" /></para>
  <para style="b" />
  <para style="q">
    <verse number="35" style="v" altnumber="34" sid="PSA 69:35" /> לױבן װעלן אים הימל און ערד,</para>
  <para style="q" vid="PSA 69:35">די ימען און אַלץ װאָס װידמענט אין זײ.<verse eid="PSA 69:35" /></para>
  <para style="q">
    <verse number="36" style="v" altnumber="35" sid="PSA 69:36" /> װאָרעם אלֹקים װעט העלפֿן צִיוֹן,</para>
  <para style="q" vid="PSA 69:36">און װעט בױען די שטעט פֿון יהוּדה,</para>
  <para style="q" vid="PSA 69:36">און זײ װעלן זיך דאָרטן באַזעצן, און זי יַרשען.<verse eid="PSA 69:36" /></para>
  <para style="q">
    <verse number="37" style="v" altnumber="36" sid="PSA 69:37" /> און דער זאָמען פֿון זײַנע קנעכט װעט זי אַרבן,</para>
  <para style="q" vid="PSA 69:37">און די ליבהאָבער פֿון זײַן נאָמען װעלן װױנען אין איר.<verse eid="PSA 69:37" /></para>
  <chapter eid="PSA 69" />
  <chapter number="70" style="c" pubnumber="ע" sid="PSA 70" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 70:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון דָוִדן, אױף אַ דערמאָנונג.<verse eid="PSA 70:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 70:2" /> אלֹקים, מיך מציל צו זײַן,</para>
  <para style="q" vid="PSA 70:2">ה׳, צו מײַן הילף, טו אײַלן.<verse eid="PSA 70:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 70:3" /> זאָלן פֿאַרשעמט און צו שאַנד װערן</para>
  <para style="q" vid="PSA 70:3">די װאָס זוכן מײַן לעבן;</para>
  <para style="q" vid="PSA 70:3">זאָלן אָפּטרעטן אַהינטער און זיך שעמען</para>
  <para style="q" vid="PSA 70:3">די װאָס װינטשן מיר בײז.<verse eid="PSA 70:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 70:4" /> זאָלן זיך צוריקקערן פֿון װעגן זײער שאַנד</para>
  <para style="q" vid="PSA 70:4">די װאָס זאָגן: אַהאַ! אַהאַ!<verse eid="PSA 70:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 70:5" /> זאָלן לוסטיק זײַן און זיך פֿרײען מיט דיר</para>
  <para style="q" vid="PSA 70:5">אַלע װאָס זוכן דיך.</para>
  <para style="q" vid="PSA 70:5">און זאָלן תּמיד זאָגן: געגרײסט זאָל זײַן ג-ט!</para>
  <para style="q" vid="PSA 70:5">די װאָס האָבן ליב דײַן ישועה.<verse eid="PSA 70:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 70:6" /> אָבער איך בין אָרים און באַדערפֿטיק,</para>
  <para style="q" vid="PSA 70:6">אלֹקים, טו אײַלן צו מיר;</para>
  <para style="q" vid="PSA 70:6">דו ביסט מײַן הילף, און דער װאָס מאַכט מיך אַנטרינען;</para>
  <para style="q" vid="PSA 70:6">ה׳, זאָלסט זיך נישט זאַמען.<verse eid="PSA 70:6" /></para>
  <chapter eid="PSA 70" />
  <chapter number="71" style="c" pubnumber="עא" sid="PSA 71" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 71:1" />אין דיר, ה׳, טו איך מיך שיצן,</para>
  <para style="q" vid="PSA 71:1">לאָמיך קײן מאָל נישט פֿאַרשעמט װערן.<verse eid="PSA 71:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 71:2" />אין דײַן גערעכטיקײט זאָלסטו מיך מציל זײַן,</para>
  <para style="q" vid="PSA 71:2">און מיך מאַכן אַנטרינען;</para>
  <para style="q" vid="PSA 71:2">נײַג צו דײַן אױער צו מיר, און העלף מיך.<verse eid="PSA 71:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 71:3" />זײַ מיר פֿאַר אַ פֿעלדז פֿון באַשיצונג</para>
  <para style="q" vid="PSA 71:3">װוּהין תּמיד צו קומען;</para>
  <para style="q" vid="PSA 71:3">באַשער מיר צו העלפֿן,</para>
  <para style="q" vid="PSA 71:3">װאָרעם דו ביסט מײַן פֿעלדז און מײַן פֿעסטונג.<verse eid="PSA 71:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 71:4" />מײַן ג-ט, מאַך מיך אַנטרינען פֿון דער האַנט פֿון רשע,</para>
  <para style="q" vid="PSA 71:4">פֿון פֿױסט פֿון דעם פֿאַרברעכער און דריקער.<verse eid="PSA 71:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 71:5" />װאָרעם דו ביסט מײַן האָפֿענונג, ה׳ אֲדֹנָי,</para>
  <para style="q" vid="PSA 71:5">מײַן פֿאַרזיכערונג פֿון מײַן יוגנט אָן.<verse eid="PSA 71:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 71:6" />אױף דיר האָב איך זיך אָנגעלענט פֿון מוטערלײַב,</para>
  <para style="q" vid="PSA 71:6">פֿון מײַן מוטערס אינגעװײד האָסט דו מיך אַרױסגעצױגן;</para>
  <para style="q" vid="PSA 71:6">מײַן לױב איז תּמיד פֿון דיר.<verse eid="PSA 71:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 71:7" />װי אַ בײזװוּנדער בין איך געװאָרן בײַ פֿיל,</para>
  <para style="q" vid="PSA 71:7">אָבער דו ביסט מײַן שטאַרקע באַשיצונג.<verse eid="PSA 71:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 71:8" />מײַן מױל איז אָנגעפֿילט מיט דײַן לױב,</para>
  <para style="q" vid="PSA 71:8">אַ גאַנצן טאָג מיט דײַן רימונג.<verse eid="PSA 71:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 71:9" />זאָלסט מיך נישט אַװעקװאַרפֿן אין צײַט פֿון זִקנה,</para>
  <para style="q" vid="PSA 71:9">אַז מײַנע כּוחות גײען אױס, זאָלסטו מיך נישט פֿאַרלאָזן.<verse eid="PSA 71:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 71:10" />װאָרעם מײַנע פֿײַנט רעדן װעגן מיר,</para>
  <para style="q" vid="PSA 71:10">און די לױערער אױף מײַן זעל עֵצהן זיך אין אײנעם,<verse eid="PSA 71:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 71:11" />אַזױ צו זאָגן: אלֹקים האָט אים פֿאַרלאָזן;</para>
  <para style="q" vid="PSA 71:11">יאָגט נאָך און כאַפּט אים,</para>
  <para style="q" vid="PSA 71:11">װאָרעם נישטאָ װער זאָל מציל זײַן.<verse eid="PSA 71:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 71:12" />אלֹקים, זאָלסט זיך נישט דערװײַטערן פֿון מיר;</para>
  <para style="q" vid="PSA 71:12">מײַן ג-ט, אײַל מיר צו הילף.<verse eid="PSA 71:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 71:13" />זאָלן פֿאַרשעמט װערן, זאָלן אױסגײן</para>
  <para style="q" vid="PSA 71:13">די שָׂונאים פֿון מײַן לעבן;</para>
  <para style="q" vid="PSA 71:13">זאָלן באַדעקט װערן מיט חרפּה און שאַנד</para>
  <para style="q" vid="PSA 71:13">די װאָס זוכן מיר בײז.<verse eid="PSA 71:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 71:14" />אָבער איך װעל תּמיד האָפֿן,</para>
  <para style="q" vid="PSA 71:14">און װעל נאָך צולײגן צו אַל דײַן לױב.<verse eid="PSA 71:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 71:15" />מײַן מױל װעט דערצײלן דײַן גערעכטיקײט,</para>
  <para style="q" vid="PSA 71:15">אַ גאַנצן טאָג דײַן הילף;</para>
  <para style="q" vid="PSA 71:15">װאָרעם איך קען נישט אױסדערצײלן.<verse eid="PSA 71:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 71:16" />איך װעל קומען מיט די גבֿורות פֿון אֲדֹנָי ה׳,</para>
  <para style="q" vid="PSA 71:16">איך װעל דערמאָנען דײַן גערעכטיקײט, דײַנע אַלײן.<verse eid="PSA 71:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 71:17" />אלֹקים, האָסט מיך געלערנט פֿון מײַן יוגנט אָן,</para>
  <para style="q" vid="PSA 71:17">און ביז אַהער דערצײל איך דײַנע װוּנדער.<verse eid="PSA 71:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 71:18" />און אױך ביז זִקנה און גראָער עלטער, אלֹקים,</para>
  <para style="q" vid="PSA 71:18">זאָלסטו מיך נישט פֿאַרלאָזן,</para>
  <para style="q" vid="PSA 71:18">ביז איך װעל דערצײלן דײַן מאַכט צום אַנדערן דור,</para>
  <para style="q" vid="PSA 71:18">צו איטלעכן װאָס װעט קומען, דײַן גבֿורה.<verse eid="PSA 71:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 71:19" />יאָ, דײַן גערעכטיקײט, אלֹקים, איז ביזן הימל,</para>
  <para style="q" vid="PSA 71:19">דו װאָס האָסט אױפֿגעטאָן גרױס.</para>
  <para style="q" vid="PSA 71:19">אלֹקים, װער איז דײַן גלײַכן?<verse eid="PSA 71:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 71:20" />דו װאָס האָסט מיך געלאָזט זען פֿיל צרות און בײזן,</para>
  <para style="q" vid="PSA 71:20">װעסט װידער מיך אױפֿלעבן,</para>
  <para style="q" vid="PSA 71:20">און פֿון די תּהומען פֿון דער ערד</para>
  <para style="q" vid="PSA 71:20">װעסטו װידער מיך אױפֿברענגען.<verse eid="PSA 71:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 71:21" />װעסט מערן מײַן גדוּלה,</para>
  <para style="q" vid="PSA 71:21">און װעסט װידער מיך טרײסטן.<verse eid="PSA 71:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 71:22" />דרומעך װעל איך דיך לױבן אױף אַ גיטאַר –</para>
  <para style="q" vid="PSA 71:22">דײַן געטרײַשאַפֿט, מײַן ג-ט;</para>
  <para style="q" vid="PSA 71:22">איך װעל שפּילן צו דיר אױף אַ האַרף,</para>
  <para style="q" vid="PSA 71:22">דו הײליקער פֿון יִשׂרָאֵל.<verse eid="PSA 71:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 71:23" />מײַנע ליפּן װעלן זינגען,</para>
  <para style="q" vid="PSA 71:23">אַז איך װעל שפּילן צו דיר,</para>
  <para style="q" vid="PSA 71:23">און מײַן זעל װאָס דו האָסט אױסגעלײזט.<verse eid="PSA 71:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 71:24" />אױך מײַן צונג אַ גאַנצן טאָג</para>
  <para style="q" vid="PSA 71:24">װעט רעדן דײַן גערעכטיקײט,</para>
  <para style="q" vid="PSA 71:24">װאָרעם פֿאַרשעמט, װאָרעם צו שאַנד װערן</para>
  <para style="q" vid="PSA 71:24">די װאָס זוכן מיר בײז.<verse eid="PSA 71:24" /></para>
  <chapter eid="PSA 71" />
  <chapter number="72" style="c" pubnumber="עב" sid="PSA 72" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 72:1" />פֿון שלמהן.</para>
  <para style="q" vid="PSA 72:1">
    <char style="va">1</char> אלֹקים, גיב דײַנע משפּטים צום מלך,</para>
  <para style="q" vid="PSA 72:1">און דײַן גערעכטיקײט צום מלכס זון;<verse eid="PSA 72:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 72:2" />ער זאָל משפּטן דײַן פֿאָלק מיט רעכטפֿאַרטיקײט,</para>
  <para style="q" vid="PSA 72:2">און דײַנע אָרימע לױט רעכט.<verse eid="PSA 72:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 72:3" />די בערג זאָלן טראָגן שלום צום פֿאָלק,</para>
  <para style="q" vid="PSA 72:3">און די הײכן – דורך גערעכטיקײט.<verse eid="PSA 72:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 72:4" />ער זאָל משפּטן די אָרימע פֿון פֿאָלק,</para>
  <para style="q" vid="PSA 72:4">ער זאָל העלפֿן די קינדער פֿון אבֿיון,</para>
  <para style="q" vid="PSA 72:4">און צעדריקן דעם רױבער.<verse eid="PSA 72:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 72:5" />מע זאָל דיך פֿאָרכטן װי לאַנג די זון װעט זײַן,</para>
  <para style="q" vid="PSA 72:5">און אַזױ װי די לבֿנה, אױף דור-דורות.<verse eid="PSA 72:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 72:6" />ער זאָל נידערן װי רעגן אױף געשניטן גראָז,</para>
  <para style="q" vid="PSA 72:6">װי שפּרײרעגן װאָס באַגיסט די ערד.<verse eid="PSA 72:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 72:7" />בליִען אין זײַנע טעג זאָל דער צדיק,</para>
  <para style="q" vid="PSA 72:7">און אַ שפֿע פֿון פֿריד ביז די לבֿנה װעט מער נישט זײַן.<verse eid="PSA 72:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 72:8" />און ער זאָל געװעלטיקן פֿון ים ביז ים,</para>
  <para style="q" vid="PSA 72:8">און פֿון דעם טײַך ביז די עקן פֿון דער ערד.<verse eid="PSA 72:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 72:9" />פֿאַר אים זאָלן קניִען די מדבר-לײַט,</para>
  <para style="q" vid="PSA 72:9">און זײַנע פֿײַנט זאָלן לעקן דעם שטױב.<verse eid="PSA 72:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 72:10" />די מלכים פֿון תַּרְשִיש און די אינדזלען זאָלן מִנְחָה ברענגען,</para>
  <para style="q" vid="PSA 72:10">די מלכים פֿון שבֿאָ און סבֿאָ זאָלן מתָּנות ברענגען.<verse eid="PSA 72:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 72:11" />און בוקן זאָלן זיך פֿאַר אים אַלע מלכים,</para>
  <para style="q" vid="PSA 72:11">אַלע פֿעלקער זאָלן אים דינען.<verse eid="PSA 72:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 72:12" />װאָרעם ער װעט מציל זײַן דעם אבֿיון װאָס שרײַט,</para>
  <para style="q" vid="PSA 72:12">און דעם אָרעמאַן װאָס האָט נישט קײן העלפֿער.<verse eid="PSA 72:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 72:13" />ער װעט זיך דערבאַרעמען אױפֿן אָרעמאַן און אבֿיון,</para>
  <para style="q" vid="PSA 72:13">און די נפֿשות פֿון די אבֿיוֹנים װעט ער העלפֿן.<verse eid="PSA 72:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 72:14" />פֿון דריקונג און פֿון רױב װעט ער אױסלײזן זײער זעל,</para>
  <para style="q" vid="PSA 72:14">און טײַער װעט זײַן זײער בלוט אין זײַנע אױגן.<verse eid="PSA 72:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 72:15" />דערום זאָל ער לעבן,</para>
  <para style="q" vid="PSA 72:15">און מע זאָל אים געבן פֿון דעם גאָלד פֿון שבֿאָ;</para>
  <para style="q" vid="PSA 72:15">און מע זאָל מתפּלל זײַן פֿאַר אים תּמיד,</para>
  <para style="q" vid="PSA 72:15">אַ גאַנצן טאָג זאָל מען אים בענטשן.<verse eid="PSA 72:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 72:16" />ער זאָל זײַן װי אַ גערעטעניש פֿון תּבֿואה אין לאַנד,</para>
  <para style="q" vid="PSA 72:16">אױף די שפּיץ בערג זאָל רױשן װי דער לבֿנוֹן זײַן פֿרוכט;</para>
  <para style="q" vid="PSA 72:16">און זײ זאָלן שפּראָצן פֿון דער שטאָט</para>
  <para style="q" vid="PSA 72:16">אַזױ װי גראָז פֿון דער ערד.<verse eid="PSA 72:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 72:17" />זײַן נאָמען זאָל זײַן אײביק,</para>
  <para style="q" vid="PSA 72:17">אַזױ לאַנג װי די זון זאָל בליִען זײַן נאָמען,</para>
  <para style="q" vid="PSA 72:17">און מע זאָל זיך בענטשן מיט אים;</para>
  <para style="q" vid="PSA 72:17">אַלע פֿעלקער זאָלן אים רימען.<verse eid="PSA 72:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 72:18" />ברוך ה׳ אלֹקים, אלוקי יִשׂרָאֵל,</para>
  <para style="q" vid="PSA 72:18">װאָס ער אַלײן טוט װוּנדער;<verse eid="PSA 72:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 72:19" />און געלױבט זײַן פּראַכטיקער נאָמען אױף אײביק;</para>
  <para style="q" vid="PSA 72:19">און די גאַנצע ערד זאָל אָנגעפֿילט װערן מיט זײַן פּראַכט.</para>
  <para style="q" vid="PSA 72:19">אָמן און אָמן!<verse eid="PSA 72:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 72:20" />געענדיקט די תּפֿילות פֿון דָוִד דעם זון פֿון יִשַין.<verse eid="PSA 72:20" /></para>
  <chapter eid="PSA 72" />
  <chapter number="73" style="c" pubnumber="עג" sid="PSA 73" />
  <para style="ms">דריטער סֵפֿר</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 73:1" />אַ מיזמור פֿון אָסָפֿן.</para>
  <para style="q" vid="PSA 73:1">
    <char style="va">1</char> פֿאַר װאָר, אלֹקים איז גוט צו יִשׂרָאֵל,</para>
  <para style="q" vid="PSA 73:1">צו די װאָס האָבן אַ רײן האַרץ.<verse eid="PSA 73:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 73:2" />און איך – מײַנע פֿיס האָבן כּמעט זיך געבײגט,</para>
  <para style="q" vid="PSA 73:2">שיִער זיך נישט אױסגעגליטשט האָבן מײַנע טריט.<verse eid="PSA 73:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 73:3" />װאָרעם איך האָב מקנא געװען די מוטװיליקע,</para>
  <para style="q" vid="PSA 73:3">אַז דאָס גליק פֿון די רשעים פֿלעג איך זען.<verse eid="PSA 73:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 73:4" />װאָרעם זײ האָבן נישט קײן יסורים,</para>
  <para style="q" vid="PSA 73:4">און זײער לײַב איז געזונט.<verse eid="PSA 73:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 73:5" />די מאַטערניש פֿון לײַטן האָבן זײ נישט,</para>
  <para style="q" vid="PSA 73:5">און זײ װערן נישט געפּלאָגט אַזױ װי מענטשן.<verse eid="PSA 73:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 73:6" />דערום איז גאװה זײער האַלדזבאַנד,</para>
  <para style="q" vid="PSA 73:6">װי אַן אָנטועכץ װיקלט זײ אײַן אומרעכט.<verse eid="PSA 73:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 73:7" />פֿון פֿעטס קריכן אַרױס זײערע אױגן,</para>
  <para style="q" vid="PSA 73:7">די פֿאַרװעלענישן פֿון האַרצן לױפֿן איבער.<verse eid="PSA 73:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 73:8" />זײ שפּעטן און רעדן מיט בײזקײט רױב,</para>
  <para style="q" vid="PSA 73:8">פֿון אױבן אַראָפּ רעדן זײ.<verse eid="PSA 73:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 73:9" />זײ שטעלן אָן קעגן הימל זײער מױל,</para>
  <para style="q" vid="PSA 73:9">און זײער צונג גײט אום אױף דער ערד.<verse eid="PSA 73:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 73:10" />דערום קערט זיך זײַן פֿאָלק אַהין צו,</para>
  <para style="q" vid="PSA 73:10">װאָרעם װאַסער פֿון שפֿע װערט געזופּט בײַ זײ.<verse eid="PSA 73:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 73:11" />און זײ זאָגן: װי קען אֵל װיסן?</para>
  <para style="q" vid="PSA 73:11">און: איז דען דאָ װיסן בײַם עליון אױבערשטער?<verse eid="PSA 73:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 73:12" />זע, דאָס זײַנען די רשעים,</para>
  <para style="q" vid="PSA 73:12">און אײביק בשלװה, מערן זײ גוטס.<verse eid="PSA 73:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 73:13" />בלױז אומנישט האָב איך געלײַטערט מײַן האַרץ,</para>
  <para style="q" vid="PSA 73:13">און געװאַשן אין רײנקײט מײַנע הענט;<verse eid="PSA 73:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 73:14" />װאָרעם איך בין געװען געפּלאָגט אַ גאַנצן טאָג,</para>
  <para style="q" vid="PSA 73:14">און אַלע פֿרימאָרגן איז געװען מײַן שטראָף.<verse eid="PSA 73:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 73:15" />אַז איך װאָלט געזאָגט: איך װעל רעדן אַזױ,</para>
  <para style="q" vid="PSA 73:15">װאָלט איך דאָך אָן דעם דור פֿון דײַנע קינדער געפֿעלשט.<verse eid="PSA 73:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 73:16" />אָבער אַז איך האָב זיך פֿאַרטראַכט דאָס צו פֿאַרשטײן,</para>
  <para style="q" vid="PSA 73:16">איז דאָס געװען אומרעכט אין מײַנע אױגן.<verse eid="PSA 73:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 73:17" />ביז איך בין געקומען אין די הײליקטומען פֿון אֵל:</para>
  <para style="q" vid="PSA 73:17">האָב איך פֿאַרשטאַנען זײער סוף.<verse eid="PSA 73:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 73:18" />פֿאַר װאָר, אױף אַ גליטש שטעלסטו זײ,</para>
  <para style="q" vid="PSA 73:18">װאַרפֿסט זײ אַראָפּ צום אונטערגאַנג.<verse eid="PSA 73:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 73:19" />װי װערן זײ צו װיסט אין אַ רגע!</para>
  <para style="q" vid="PSA 73:19">זײ עקן זיך, זײ װערן פֿאַרלענדט פֿון שרעקענישן.<verse eid="PSA 73:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 73:20" />װי אַ חלום אַז מע כאַפּט זיך אױף,</para>
  <para style="q" vid="PSA 73:20">אַזױ, אֲדֹנָי, װאַכנדיק, פֿאַראַכטסטו זײער בילד.<verse eid="PSA 73:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 73:21" />יאָ, מײַן האַרץ פֿלעגט זײַן פֿאַרזױערט,</para>
  <para style="q" vid="PSA 73:21">און אין די נירן פֿלעגט מיר שטעכן;<verse eid="PSA 73:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 73:22" />װײַל איך בין געװען פֿאַרגרעבט, און פֿלעג נישט װיסן;</para>
  <para style="q" vid="PSA 73:22">װי אַ בהמה בין איך געװען פֿאַר דיר.<verse eid="PSA 73:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 73:23" />אָבער איך בין תּמיד בײַ דיר,</para>
  <para style="q" vid="PSA 73:23">דו האַלטסט מיך בײַ דער רעכטער האַנט.<verse eid="PSA 73:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 73:24" />מיט דײַן עצה װעסטו מיך פֿירן,</para>
  <para style="q" vid="PSA 73:24">און צו כּבֿוד װעסטו מיך ברענגען.<verse eid="PSA 73:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 73:25" />װעמען נאָך האָב איך אין הימל?</para>
  <para style="q" vid="PSA 73:25">און צו דיר באַגער איך נישט קײנעם אױף דער ערד.<verse eid="PSA 73:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 73:26" />מײַן לײַב און מײַן האַרץ גײט אױס,</para>
  <para style="q" vid="PSA 73:26">דער פֿעלדז פֿון מײַן האַרצן און מײַן חלק איז אײביק אלֹקים.<verse eid="PSA 73:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 73:27" />װאָרעם, זע, די װײַטע פֿון דיר װעלן אונטערגײן,</para>
  <para style="q" vid="PSA 73:27">דו פֿאַרשנײַדסט איטלעכן װאָס קערט זיך אָפּ פֿון דיר פֿאַר הורדום.<verse eid="PSA 73:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 73:28" />אָבער איך – די נאָנטקײט פֿון אלֹקים איז מײַן גוטס,</para>
  <para style="q" vid="PSA 73:28">איך האָב געמאַכט אין אֲדֹנָי ה׳ מײַן באַשיצונג,</para>
  <para style="q" vid="PSA 73:28">כּדי צו דערצײלן װעגן אַלע דײַנע װערק.<verse eid="PSA 73:28" /></para>
  <chapter eid="PSA 73" />
  <chapter number="74" style="c" pubnumber="עד" sid="PSA 74" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 74:1" />אַ באַטראַכטונג פֿון אָסָפֿן.</para>
  <para style="q" vid="PSA 74:1">
    <char style="va">1</char> פֿאַר װאָס, אלֹקים, האָסטו אונדז פֿאַרלאָזן אױף אײביק?</para>
  <para style="q" vid="PSA 74:1">פֿאַר װאָס ברענט דײַן צאָרן אױף די שאָף פֿון דײַן פֿיטערונג?<verse eid="PSA 74:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 74:2" />דערמאָן זיך אָן דײַן עדה װאָס דו האָסט אױסגעקױפֿט אַ מאָל,</para>
  <para style="q" vid="PSA 74:2">װאָס דו האָסט אױסגעלײזט צום שבֿט פֿון דײַן אַרב;</para>
  <para style="q" vid="PSA 74:2">אָן דעם באַרג צִיוֹן װאָס דו האָסט אױף אים גערוט.<verse eid="PSA 74:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 74:3" />הײב אױף דײַנע טריט צו די אײביקע חורבֿות;</para>
  <para style="q" vid="PSA 74:3">אַלץ האָט צעבראָכן דער שׂונא אין הײליקטום.<verse eid="PSA 74:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 74:4" />דײַנע פֿײַנט האָבן געברילט אין מיטן פֿון דײַן זאַמלאָרט,</para>
  <para style="q" vid="PSA 74:4">זײערע צײכנס האָבן זײ אױפֿגעשטעלט פֿאַר צײכנס.<verse eid="PSA 74:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 74:5" />עס האָט זיך געדאַכט, װי מע װאָלט אױפֿהײבן אין דער הײך</para>
  <para style="q" vid="PSA 74:5">העק אױפֿן געצװײַג פֿון אַ בױם.<verse eid="PSA 74:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 74:6" />און אָט האָבן זײ אירע געשניצן מיט אַנאַנדער,</para>
  <para style="q" vid="PSA 74:6">מיט אַ ברעכאײַזן און האַמערס צעהאַקט.<verse eid="PSA 74:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 74:7" />זײ האָבן אָנגעצונדן אין פֿײַער דײַן מִקדָש,</para>
  <para style="q" vid="PSA 74:7">צו דער ערד האָבן זײ פֿאַרשװעכט די װױנונג פֿון דײַן נאָמען.<verse eid="PSA 74:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 74:8" />זײ האָבן געזאָגט אין זײער האַרצן:</para>
  <para style="q" vid="PSA 74:8">לאָמיר זײ פֿאַרטיליקן אין אײנעם;</para>
  <para style="q" vid="PSA 74:8">זײ האָבן פֿאַרברענט אַלע זאַמלערטער פֿון אֵל אין לאַנד.<verse eid="PSA 74:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 74:9" />אונדזערע צײכנס זעען מיר נישט,</para>
  <para style="q" vid="PSA 74:9">נישטאָ מער קײן נבֿיא,</para>
  <para style="q" vid="PSA 74:9">און נישטאָ בײַ אונדז װער זאָל װיסן ביז װאַנען.<verse eid="PSA 74:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 74:10" />ביז װאַנען, אלֹקים, װעט לעסטערן דער פֿײַנט?</para>
  <para style="q" vid="PSA 74:10">װעט שענדן דער שׂונא דײַן נאָמען נאָכאַנאַנד?<verse eid="PSA 74:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 74:11" />פֿאַר װאָס האַלטסטו צוריק דײַן האַנט, דײַן רעכטע?</para>
  <para style="q" vid="PSA 74:11">צי זי אַרױס פֿון דײַן בוזעם, פֿאַרלענד.<verse eid="PSA 74:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 74:12" />אלֹקים איז דאָך מײַן קיניג פֿון אײביק אָן,</para>
  <para style="q" vid="PSA 74:12">ער טוט ישועות אין לאַנד.<verse eid="PSA 74:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 74:13" />דו האָסט צעברעקלט מיט דײַן שטאַרקײט דעם ים,</para>
  <para style="q" vid="PSA 74:13">האָסט צעבראָכן די קעפּ פֿון די שלענג אױפֿן װאַסער.<verse eid="PSA 74:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 74:14" />דו האָסט צעהאַקט די קעפּ פֿון לִויָתן,</para>
  <para style="q" vid="PSA 74:14">אים געגעבן פֿאַר שפּײַז צום פֿאָלק, צו מדבר-לײַט.<verse eid="PSA 74:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 74:15" />דו האָסט געשפּאָלטן קװאַלן און טײַכן,</para>
  <para style="q" vid="PSA 74:15">דו האָסט אױסגעטריקנט מאַכטיקע שטראָמען.<verse eid="PSA 74:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 74:16" />דײַן איז דער טאָג, דײַן אױך די נאַכט,</para>
  <para style="q" vid="PSA 74:16">דו האָסט אָנגעברײט לבֿנה און זון.<verse eid="PSA 74:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 74:17" />דו האָסט אױפֿגעשטעלט אַלע געמאַרקן פֿון דער ערד;</para>
  <para style="q" vid="PSA 74:17">זומער און װינטער, זײ האָסט דו באַשאַפֿן.<verse eid="PSA 74:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="PSA 74:18" />דערמאָן זיך אָן דעם, װי דער פֿײַנט האָט געלעסטערט ה׳,</para>
  <para style="q" vid="PSA 74:18">און דאָס נידערטרעכטיקע פֿאָלק האָט געשענדט דײַן נאָמען.<verse eid="PSA 74:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 74:19" />זאָלסט נישט איבערגעבן צו אַ חיה די זעל פֿון דײַן טורטלטױב,</para>
  <para style="q" vid="PSA 74:19">זאָלסט נישט פֿאַרגעסן אױף אײביק דאָס לעבן פֿון דײַנע אָרימע.<verse eid="PSA 74:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 74:20" />קוק זיך אום אױף דעם ברית,</para>
  <para style="q" vid="PSA 74:20">װאָרעם די פֿינצטערע װינקלען פֿון דער ערד</para>
  <para style="q" vid="PSA 74:20">זײַנען פֿול מיט װױנונגען פֿון רױב.<verse eid="PSA 74:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 74:21" />זאָל דער געשלאָגענער זיך נישט אומקערן פֿאַרשעמט,</para>
  <para style="q" vid="PSA 74:21">זאָל דער אָרעמאַן און דער אבֿיון לױבן דײַן נאָמען.<verse eid="PSA 74:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="PSA 74:22" />שטײ אױף, אלֹקים, קריג דײַן קריג,</para>
  <para style="q" vid="PSA 74:22">געדענק דײַן לעסטערונג פֿון דעם נידערטרעכטיקן אַ גאַנצן טאָג.<verse eid="PSA 74:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 74:23" />זאָלסט נישט פֿאַרגעסן דעם ליאַרעם פֿון דײַנע פֿײַנט,</para>
  <para style="q" vid="PSA 74:23">דעם טומל פֿון דײַנע קעגנשטײער װאָס גײט אױף נאָכאַנאַנד.<verse eid="PSA 74:23" /></para>
  <chapter eid="PSA 74" />
  <chapter number="75" style="c" pubnumber="עה" sid="PSA 75" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 75:1" />פֿאַר דעם געזאַנגמײַסטער; אַל-תַּשחֵת; אַ מיזמור פֿון אָסָפֿן, אַ געזאַנג.<verse eid="PSA 75:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 75:2" /> מיר לױבן דיך, אלֹקים, מיר לױבן,</para>
  <para style="q" vid="PSA 75:2">און נאָנט איז דײַן נאָמען;</para>
  <para style="q" vid="PSA 75:2">מע דערצײלט דײַנע װוּנדער.<verse eid="PSA 75:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 75:3" /> אַז איך נעם אַ צײַט,</para>
  <para style="q" vid="PSA 75:3">טו איך משפּטן מיט יושר.<verse eid="PSA 75:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 75:4" /> מעגן זיך װאַקלען די ערד און אַלע אירע באַװױנער,</para>
  <para style="q" vid="PSA 75:4">איך טו באַפֿעסטיקן אירע זײַלן.</para>
  <para style="q" vid="PSA 75:4">סֶלָה.<verse eid="PSA 75:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 75:5" /> איך זאָג צו די מוטװיליקע: איר זאָלט נישט מוטװיליקן,</para>
  <para style="q" vid="PSA 75:5">און צו די רשעים: איר זאָלט נישט אױפֿהײבן דעם האָרן.<verse eid="PSA 75:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 75:6" /> איר זאָלט נישט אױפֿהײבן אין דער הײך אײַער האָרן,</para>
  <para style="q" vid="PSA 75:6">נישט רעדן מיט אַ פֿאַרשײַטן האַלדז.<verse eid="PSA 75:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 75:7" /> װאָרעם נישט פֿון מזרח אָדער פֿון מערבֿ,</para>
  <para style="q" vid="PSA 75:7">און נישט פֿון מדבר, קומט דערהײכונג.<verse eid="PSA 75:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 75:8" /> נאָר אלֹקים איז דער ריכטער:</para>
  <para style="q" vid="PSA 75:8">דעם דערנידערט ער, און דעם דערהײכט ער.<verse eid="PSA 75:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 75:9" /> װאָרעם אַ כָּוס איז אין דער האַנט פֿון ה׳,</para>
  <para style="q" vid="PSA 75:9">מיט װײַן װאָס שױמט, מיט מישגעטראַנק פֿול,</para>
  <para style="q" vid="PSA 75:9">און ער גיסט אָן דערפֿון;</para>
  <para style="q" vid="PSA 75:9">בלױז די הײװן דערפֿון זופּן-טרינקען</para>
  <para style="q" vid="PSA 75:9">אַלע רשעים פֿון דער ערד.<verse eid="PSA 75:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 75:10" /> אָבער איך װעל אײביק דערצײלן,</para>
  <para style="q" vid="PSA 75:10">איך װעל זינגען צום אלוקי יעקבֿ.<verse eid="PSA 75:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 75:11" /> און אַלע הערנער פֿון די רשעים װעל איך אָפּהאַקן;</para>
  <para style="q" vid="PSA 75:11">דערהײכט װעלן װערן די הערנער פֿון די צדיקים.<verse eid="PSA 75:11" /></para>
  <chapter eid="PSA 75" />
  <chapter number="76" style="c" pubnumber="עו" sid="PSA 76" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 76:1" />פֿאַר דעם געזאַנגמײַסטער, מיט סטרונעשפּיל; אַ מיזמור פֿון אָסָפֿן, אַ געזאַנג.<verse eid="PSA 76:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 76:2" /> באַקאַנט אין יהוּדה איז אלֹקים,</para>
  <para style="q" vid="PSA 76:2">גרױס איז זײַן נאָמען אין יִשׂרָאֵל.<verse eid="PSA 76:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 76:3" /> און אין שָלֵם איז זײַן בײַדל,</para>
  <para style="q" vid="PSA 76:3">און זײַן װױנונג אין צִיוֹן.<verse eid="PSA 76:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 76:4" /> דאָרטן האָט ער צעבראָכן די בליציקע פֿײַלן פֿון בױגן,</para>
  <para style="q" vid="PSA 76:4">דעם שילד און די שװערד און מלחמה.</para>
  <para style="q" vid="PSA 76:4">סֶלָה.<verse eid="PSA 76:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 76:5" /> ליכטיק ביסטו, מאַכטיקער,</para>
  <para style="q" vid="PSA 76:5">פֿון די בערג פֿון פֿאַרצוקונג;<verse eid="PSA 76:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 76:6" /> די שטאַרק-האַרציקע זענען באַרױבט,</para>
  <para style="q" vid="PSA 76:6">זײ האָבן אײַנגעשלאָפֿן אין זײער שלאָף;</para>
  <para style="q" vid="PSA 76:6">און אַלע העלדן האָבן נישט געקענט געפֿינען זײערע הענט.<verse eid="PSA 76:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 76:7" /> פֿון דײַן אָנגעשרײ, אלוקי יעקבֿ,</para>
  <para style="q" vid="PSA 76:7">איז אַנטשלומערט געװאָרן אי רײַטער אי פֿערד.<verse eid="PSA 76:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 76:8" /> דו ביסט פֿאָרכטיק, דו,</para>
  <para style="q" vid="PSA 76:8">און װער קען באַשטײן פֿאַר דיר,</para>
  <para style="q" vid="PSA 76:8">װי באַלד דו ביסט אין כּעס?<verse eid="PSA 76:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 76:9" /> פֿון הימל האָסטו געלאָזט הערן אַ דין,</para>
  <para style="q" vid="PSA 76:9">די ערד האָט מורא געקריגן און איז שטיל געװאָרן,<verse eid="PSA 76:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 76:10" /> אַז אלֹקים איז אױפֿגעשטאַנען צום משפּט,</para>
  <para style="q" vid="PSA 76:10">צו העלפֿן אַלע געדריקטע פֿון דער ערד.</para>
  <para style="q" vid="PSA 76:10">סֶלָה.<verse eid="PSA 76:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 76:11" /> פֿאַר װאָר, די גרימצאָרנדיקע װעלן דיך לױבן,</para>
  <para style="q" vid="PSA 76:11">דעם איבערבלײַב פֿון גרימצאָרן װעסטו אײַנצאַמען.<verse eid="PSA 76:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 76:12" /> טוט אַ נדר און באַצאָלט צו ה׳ אלוקיכם;</para>
  <para style="q" vid="PSA 76:12">אַלע אַרום אים זאָלן ברענגען מתָּנות צום געפֿאָרכטן.<verse eid="PSA 76:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 76:13" /> ער האַלט אײַן דאָס געמיט פֿון פֿירשטן,</para>
  <para style="q" vid="PSA 76:13">ער איז פֿאָרכטיק פֿאַר אַלע מלכים פֿון דער ערד.<verse eid="PSA 76:13" /></para>
  <chapter eid="PSA 76" />
  <chapter number="77" style="c" pubnumber="עז" sid="PSA 77" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 77:1" />פֿאַר דעם געזאַנגמײַסטער, פֿאַר ידותון; פֿון אָסָפֿן אַ מיזמור.<verse eid="PSA 77:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 77:2" /> מײַן קֹול איז צו אלֹקים, און איך שרײַ,</para>
  <para style="q" vid="PSA 77:2">מײַן קֹול איז צו אלֹקים, און פֿאַרנעם צו מיר.<verse eid="PSA 77:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 77:3" /> אין טאָג פֿון מײַן נױט זוך איך אֲדֹנָי,</para>
  <para style="q" vid="PSA 77:3">מײַן האַנט איז אױסגעשטרעקט בײַ נאַכט אָן אױפֿהער,</para>
  <para style="q" vid="PSA 77:3">מײַן זעל װיל זיך נישט טרײסטן.<verse eid="PSA 77:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 77:4" /> אַז איך דערמאָן זיך, אלֹקים, טו איך ברומען,</para>
  <para style="q" vid="PSA 77:4">איך קלאָג, און מײַן גײַסט פֿאַרגײט זיך.</para>
  <para style="q" vid="PSA 77:4">סֶלָה.<verse eid="PSA 77:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 77:5" /> דו האַלטסט צו די ברעמען פֿון מײַנע אױגן;</para>
  <para style="q" vid="PSA 77:5">איך בין צערודערט און קען נישט רעדן.<verse eid="PSA 77:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 77:6" /> איך טראַכט אָן די טעג פֿון אַ מאָל,</para>
  <para style="q" vid="PSA 77:6">אָן די יאָרן פֿון פֿאַרצײַטן.<verse eid="PSA 77:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 77:7" /> איך דערמאָן זיך מײַן געזאַנג בײַ נאַכט,</para>
  <para style="q" vid="PSA 77:7">איך רעד מיט מײַן האַרצן,</para>
  <para style="q" vid="PSA 77:7">און עס פֿאָרשט מײַן גײַסט:<verse eid="PSA 77:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 77:8" /> װעט אױף אײביק אֲדֹנָי פֿאַרלאָזן,</para>
  <para style="q" vid="PSA 77:8">און װעט מער נישט באַװיליקן װידער?<verse eid="PSA 77:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 77:9" /> איז אױסגעגאַנגען אױף אײביק זײַן חֶסֶד?</para>
  <para style="q" vid="PSA 77:9">איז דער צוזאָג געענדיקט אױף דור-דורות?<verse eid="PSA 77:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 77:10" /> האָט פֿאַרגעסן צו לײַטזעליקן אֵל?</para>
  <para style="q" vid="PSA 77:10">צי האָט ער אין צאָרן פֿאַרשלאָסן זײַן רַחמָנות?</para>
  <para style="q" vid="PSA 77:10">סֶלָה.<verse eid="PSA 77:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 77:11" /> דאָך האָב איך געזאָגט: דאָס איז מײַן צרה,</para>
  <para style="q" vid="PSA 77:11">אָבער עס קענען זיך ענדערן די יאָרן פֿון דער רעכטער האַנט פֿונעם העכסטן.<verse eid="PSA 77:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 77:12" /> איך דערמאָן די אױפֿטוען פֿון ה׳,</para>
  <para style="q" vid="PSA 77:12">יאָ, איך דערמאָן דײַנע װוּנדער פֿון פֿאַרצײַטן.<verse eid="PSA 77:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 77:13" /> און איך טראַכט אָן אַל דײַן װערק,</para>
  <para style="q" vid="PSA 77:13">און אָן דײַנע טוּונגען טו איך קלערן.<verse eid="PSA 77:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 77:14" /> אלֹקים, אין הײליקײט איז דײַן װעג;</para>
  <para style="q" vid="PSA 77:14">װער איז אַ גרױסער אֵל װי אלֹקים?<verse eid="PSA 77:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 77:15" /> דו ביסט הָאֵל װאָס טוט װוּנדער,</para>
  <para style="q" vid="PSA 77:15">האָסט געלאָזט װיסן צװישן די פֿעלקער דײַן שטאַרקײט.<verse eid="PSA 77:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 77:16" /> האָסט אױסגעלײזט מיטן אָרעם דײַן פֿאָלק,</para>
  <para style="q" vid="PSA 77:16">די קינדער פֿון יעקבֿ און יוֹסף.</para>
  <para style="q" vid="PSA 77:16">סֶלָה.<verse eid="PSA 77:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 77:17" /> געזען האָבן דיך די װאַסערן, אלֹקים,</para>
  <para style="q" vid="PSA 77:17">געזען האָבן דיך די װאַסערן, האָבן זײ װײען געקריגן,</para>
  <para style="q" vid="PSA 77:17">און געציטערט האָבן די תּהומען.<verse eid="PSA 77:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 77:18" /> געפֿלײצט װאַסער האָבן די װאָלקנס,</para>
  <para style="q" vid="PSA 77:18">אַ קֹול האָבן אַרױסגעלאָזט די הימלען,</para>
  <para style="q" vid="PSA 77:18">און דײַנע פֿײַלן זײַנען אומגעלאָפֿן.<verse eid="PSA 77:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 77:19" /> דער קֹול פֿון דײַן דונער איז געװען אין דעם װירבל-װינט,</para>
  <para style="q" vid="PSA 77:19">בליצן האָבן באַלוכטן די װעלט,</para>
  <para style="q" vid="PSA 77:19">געציטערט און געשטורעמט האָט די ערד.<verse eid="PSA 77:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 77:20" /> דורכן ים איז געװען דײַן װעג,</para>
  <para style="q" vid="PSA 77:20">און דײַן שטעג דורך װאַסערן גרױסע,</para>
  <para style="q" vid="PSA 77:20">און דײַנע טריט זײַנען נישט געמערקט געװאָרן.<verse eid="PSA 77:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 77:21" /> האָסט געפֿירט אַזױ װי שאָף דײַן פֿאָלק,</para>
  <para style="q" vid="PSA 77:21">דורך דער האַנט פֿון משהן און אַהרֹנען.<verse eid="PSA 77:21" /></para>
  <chapter eid="PSA 77" />
  <chapter number="78" style="c" pubnumber="עח" sid="PSA 78" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 78:1" />אַ באַטראַכטונג פֿון אָסָפֿן.</para>
  <para style="q" vid="PSA 78:1">
    <char style="va">1</char> פֿאַרנעם, מײַן פֿאָלק, מײַן לערנונג,</para>
  <para style="q" vid="PSA 78:1">נײַגט אײַער אױער צו די װערטער פֿון מײַן מױל.<verse eid="PSA 78:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 78:2" />איך װעל עפֿענען מיט אַ משל מײַן מױל,</para>
  <para style="q" vid="PSA 78:2">איך װעל רעדן רעטענישן פֿון פֿאַרצײַטן.<verse eid="PSA 78:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 78:3" />װאָס מיר האָבן געהערט און מיר װײסן,</para>
  <para style="q" vid="PSA 78:3">און אונדזערע עלטערן האָבן אונדז דערצײלט,<verse eid="PSA 78:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 78:4" />װעלן מיר נישט פֿאַרהױלן פֿון זײערע קינדער;</para>
  <para style="q" vid="PSA 78:4">דערצײלנדיק דעם שפּעטערדיקן דור</para>
  <para style="q" vid="PSA 78:4">די לױבן פֿון ה׳ און זײַן שטאַרקײט,</para>
  <para style="q" vid="PSA 78:4">און זײַנע װוּנדער װאָס ער האָט געטאָן.<verse eid="PSA 78:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 78:5" />װאָרעם ער האָט אױפֿגעשטעלט אַ צײגנים אין יעקבֿ,</para>
  <para style="q" vid="PSA 78:5">און אַ תּורה געמאַכט אין יִשׂרָאֵל,</para>
  <para style="q" vid="PSA 78:5">װאָס ער האָט באַפֿױלן אונדזערע עלטערן,</para>
  <para style="q" vid="PSA 78:5">זײ צו מאַכן װיסן זײערע קינדער;<verse eid="PSA 78:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 78:6" />כּדי װיסן זאָל דער שפּעטערדיקער דור,</para>
  <para style="q" vid="PSA 78:6">די קינדער װאָס װעלן געבאָרן װערן;</para>
  <para style="q" vid="PSA 78:6">זײ זאָלן אױפֿשטײן און דערצײלן זײערע קינדער.<verse eid="PSA 78:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 78:7" />און זײ זאָלן לײגן אױף אלֹקים זײער בטחון,</para>
  <para style="q" vid="PSA 78:7">און נישט פֿאַרגעסן די אױפֿטוען פֿון אֵל,</para>
  <para style="q" vid="PSA 78:7">און זײַנע געבאָט זאָלן זײ היטן;<verse eid="PSA 78:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 78:8" />און זײ זאָלן נישט זײַן װי זײערע עלטערן,</para>
  <para style="q" vid="PSA 78:8">אַ דור אָפּגעקערט און װידערשפּעניק,</para>
  <para style="q" vid="PSA 78:8">אַ דור װאָס האָט נישט געפֿעסטיקט זײַן האַרץ,</para>
  <para style="q" vid="PSA 78:8">און נישט געטרײַ געװען איז זײַן גײַסט צו אֵל.<verse eid="PSA 78:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 78:9" />די קינדער פֿון אפֿרים, באַװאָפֿנטע בױגן-שיסער,</para>
  <para style="q" vid="PSA 78:9">האָבן זיך אומגעקערט אין טאָג פֿון מלחמה.<verse eid="PSA 78:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 78:10" />זײ האָבן נישט געהיט דעם ברית פֿון אלֹקים,</para>
  <para style="q" vid="PSA 78:10">און אין זײַן תּורה נישט געװאָלט גײן.<verse eid="PSA 78:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 78:11" />און זײ האָבן פֿאַרגעסן זײַנע טוּונגען,</para>
  <para style="q" vid="PSA 78:11">און זײַנע װוּנדער װאָס ער האָט זײ באַװיזן.<verse eid="PSA 78:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 78:12" />אַנטקעגן פֿאַר זײערע עלטערן האָט ער געטאָן װוּנדער,</para>
  <para style="q" vid="PSA 78:12">אין לאַנד מִצרַיִם, אין פֿעלד פֿון צוֹעַן.<verse eid="PSA 78:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 78:13" />ער האָט געשפּאָלטן דעם ים, און זײ אַריבערגעפֿירט,</para>
  <para style="q" vid="PSA 78:13">און אױפֿגעשטעלט די װאַסערן װי אַ סטױג.<verse eid="PSA 78:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 78:14" />און ער האָט זײ געפֿירט מיט אַ װאָלקן בײַ טאָג,</para>
  <para style="q" vid="PSA 78:14">און די גאַנצע נאַכט מיט אַ פֿײַערדיקן ליכט.<verse eid="PSA 78:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 78:15" />ער האָט געשפּאָלטן פֿעלדזן אין מדבר,</para>
  <para style="q" vid="PSA 78:15">און זײ אָנגעטרונקען זאַט װי פֿון תּהומען.<verse eid="PSA 78:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 78:16" />און ער האָט אַרױסגעצױגן פֿלוסן פֿון פֿעלדז,</para>
  <para style="q" vid="PSA 78:16">און געמאַכט נידערן װאַסער װי שטראָמען.<verse eid="PSA 78:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 78:17" />אָבער זײ האָבן נאָך װײַטער געזינדיקט צו אים,</para>
  <para style="q" vid="PSA 78:17">צו װידערשפּעניקן דעם עליון אױבערשטער אין דער װיסטע.<verse eid="PSA 78:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 78:18" />און זײ האָבן געפּרוּװט אֵל אין זײער האַרצן,</para>
  <para style="q" vid="PSA 78:18">צו פֿאַרלאַנגען עסן פֿאַר זײער געלוסט.<verse eid="PSA 78:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 78:19" />און זײ האָבן גערעדט קעגן אלֹקים,</para>
  <para style="q" vid="PSA 78:19">געזאָגט: קען אֵל גרײטן אַ טיש אין דער מדבר?<verse eid="PSA 78:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 78:20" />יאָ, ער האָט געשלאָגן דעם פֿעלדז, און װאַסער איז געפֿלאָסן,</para>
  <para style="q" vid="PSA 78:20">און טײַכן האָבן געפֿלײצט,</para>
  <para style="q" vid="PSA 78:20">װעט ער אױך קענען ברױט געבן?</para>
  <para style="q" vid="PSA 78:20">צי װעט ער אָנברײטן פֿלײש פֿאַר זײַן פֿאָלק?<verse eid="PSA 78:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 78:21" />דערום האָט ה׳ געהערט, און איז אין כּעס געװאָרן,</para>
  <para style="q" vid="PSA 78:21">און אַ פֿײַער האָט זיך אָנגעצונדן אין יעקבֿ,</para>
  <para style="q" vid="PSA 78:21">און פֿאַר װאָר, אַ צאָרן איז אױפֿגעגאַנגען אין יִשׂרָאֵל;<verse eid="PSA 78:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 78:22" />װײַל זײ האָבן נישט געגלױבט אין אלֹקים,</para>
  <para style="q" vid="PSA 78:22">און זיך נישט פֿאַרזיכערט אױף זײַן הילף.<verse eid="PSA 78:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 78:23" />און ער האָט באַפֿױלן די װאָלקנס פֿון אױבן,</para>
  <para style="q" vid="PSA 78:23">און די טירן פֿון הימל געעפֿנט.<verse eid="PSA 78:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 78:24" />און ער האָט געמאַכט רעגענען אױף זײ מַן צום עסן,</para>
  <para style="q" vid="PSA 78:24">און הימל-תּבֿואה זײ געגעבן.<verse eid="PSA 78:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 78:25" />ברױט פֿון מלאָכים האָט איטלעכער געגעסן,</para>
  <para style="q" vid="PSA 78:25">שפּײַז צו זאַט האָט ער זײ אַראָפּגעשיקט.<verse eid="PSA 78:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 78:26" />ער האָט געמאַכט ציִען דעם מזרח-װינט אין הימל,</para>
  <para style="q" vid="PSA 78:26">און געטריבן מיט זײַן שטאַרקײט דעם דָרום-װינט.<verse eid="PSA 78:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 78:27" />און ער האָט געמאַכט רעגענען אױף זײ פֿלײש װי שטױב,</para>
  <para style="q" vid="PSA 78:27">און װי זאַמד פֿון די ימען פֿױגלען געפֿליגלטע.<verse eid="PSA 78:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 78:28" />און ער האָט עס געלאָזט פֿאַלן אין מיטן פֿון זײער לאַגער,</para>
  <para style="q" vid="PSA 78:28">רונד אַרום זײערע װױנונגען.<verse eid="PSA 78:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 78:29" />און זײ האָבן געגעסן, און זײַנען איבערזאַט געװאָרן,</para>
  <para style="q" vid="PSA 78:29">און זײער תּאװה האָט ער זײ געבראַכט.<verse eid="PSA 78:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 78:30" />נאָך האָבן זײ זיך נישט געהאַט אָפּגעעקלט פֿון זײער תּאװה,</para>
  <para style="q" vid="PSA 78:30">זײער שפּײַז איז נאָך געװען אין זײער מױל,<verse eid="PSA 78:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 78:31" />און דער צאָרן פֿון אלֹקים איז אױפֿגעגאַנגען קעגן זײ,</para>
  <para style="q" vid="PSA 78:31">און ער האָט געהרגעט פֿון זײערע שטאַרקסטע,</para>
  <para style="q" vid="PSA 78:31">און די יונגעלײַט פֿון יִשׂרָאֵל אַנידערגעלײגט.<verse eid="PSA 78:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PSA 78:32" />בײַ אַלעם דעם האָבן זײ װידער געזינדיקט,</para>
  <para style="q" vid="PSA 78:32">און נישט געגלױבט אין זײַנע װוּנדער.<verse eid="PSA 78:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 78:33" />און ער האָט פֿאַרלענדט װי אַ הױך זײערע טעג,</para>
  <para style="q" vid="PSA 78:33">און זײערע יאָרן אין אַ בהלה.<verse eid="PSA 78:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 78:34" />אַז ער האָט זײ געהרגעט, פֿלעגן זײ אים זוכן,</para>
  <para style="q" vid="PSA 78:34">און פֿלעגן זיך אומקערן, און פֿאָרשן אֵל.<verse eid="PSA 78:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 78:35" />און זײ האָבן זיך דערמאָנט אַז אלֹקים איז זײער פֿעלדז,</para>
  <para style="q" vid="PSA 78:35">און אֵל עליון איז זײער אױסלײזער.<verse eid="PSA 78:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 78:36" />און זײ האָבן אים איבערגעבעטן מיט זײער מױל,</para>
  <para style="q" vid="PSA 78:36">און מיט זײער צונג פֿלעגן זײ אים ליגן זאָגן.<verse eid="PSA 78:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 78:37" />אָבער זײער האַרץ איז נישט געװען פֿעסט מיט אים,</para>
  <para style="q" vid="PSA 78:37">און זײ זײַנען נישט געטרײַ געװען אין זײַן ברית.<verse eid="PSA 78:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 78:38" />נאָר ער איז אַ דערבאַרעמער,</para>
  <para style="q" vid="PSA 78:38">ער איז מכַפּר אױף זינד, און ברענגט נישט אום,</para>
  <para style="q" vid="PSA 78:38">און ער האַלט אַ סך אָפּ זײַן כּעס,</para>
  <para style="q" vid="PSA 78:38">און דערװעקט נישט זײַן גאַנצן גרימצאָרן.<verse eid="PSA 78:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 78:39" />און ער האָט זיך דערמאָנט אַז זײ זײַנען פֿלײש,</para>
  <para style="q" vid="PSA 78:39">אַ הױך װאָס פֿאַרגײט, און קערט נישט אום.<verse eid="PSA 78:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 78:40" />װיפֿל מאָל האָבן זײ אים װידערשפּעניקט אין מדבר,</para>
  <para style="q" vid="PSA 78:40">אים געקרענקט אין דער װיסטע!<verse eid="PSA 78:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 78:41" />און װידער האָבן זײ געפּרוּװט אֵל,</para>
  <para style="q" vid="PSA 78:41">און דעם הײליקן פֿון יִשׂרָאֵל געערגערט.<verse eid="PSA 78:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 78:42" />זײ האָבן נישט געדאַכט אָן זײַן האַנט,</para>
  <para style="q" vid="PSA 78:42">אָן דעם טאָג װאָס ער האָט זײ אױסגעלײזט פֿון פֿײַנט<verse eid="PSA 78:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 78:43" />װי ער האָט געמאַכט זײַנע צײכנס אין מִצרַיִם,</para>
  <para style="q" vid="PSA 78:43">און זײַנע װוּנדער אין פֿעלד פֿון צוֹעַן;<verse eid="PSA 78:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 78:44" />און פֿאַרקערט אין בלוט זײערע טײַכן,</para>
  <para style="q" vid="PSA 78:44">און זײערע פֿלוסן, זײ זאָלן נישט קענען טרינקען.<verse eid="PSA 78:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 78:45" />ער האָט אָנגעשיקט אױף זײ אַ שװאָרעם פֿליגן</para>
  <para style="q" vid="PSA 78:45">װאָס האָט זײ אױפֿגעגעסן,</para>
  <para style="q" vid="PSA 78:45">און די פֿראָש װאָס האָט זײ פֿאַרװיסט.<verse eid="PSA 78:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 78:46" />און ער האָט איבערגעגעבן צום גריל זײער געװעקס,</para>
  <para style="q" vid="PSA 78:46">און זײער מי צום הײשעריק.<verse eid="PSA 78:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 78:47" />ער האָט געטײט מיט האָגל זײער װײַנשטאָק,</para>
  <para style="q" vid="PSA 78:47">און זײערע װילדע פֿײַגנבײמער מיט פֿראָסט.<verse eid="PSA 78:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 78:48" />און ער האָט איבערגעענטפֿערט צום האָגל זײער פֿיך,</para>
  <para style="q" vid="PSA 78:48">און זײערע סטאַדעס צו בליצן.<verse eid="PSA 78:48" /></para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 78:49" />ער האָט אָנגעשיקט אױף זײ דעם בראַנד פֿון זײַן צאָרן,</para>
  <para style="q" vid="PSA 78:49">כּעס און גרימצאָרן און לײַד,</para>
  <para style="q" vid="PSA 78:49">אַן אָנשיקעניש פֿון בײזע שלוחים.<verse eid="PSA 78:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 78:50" />ער האָט געמאַכט אַ װעג פֿאַר זײַן צאָרן,</para>
  <para style="q" vid="PSA 78:50">ער האָט נישט פֿאַרמיטן פֿון טױט זײער זעל,</para>
  <para style="q" vid="PSA 78:50">און ער האָט איבערגעענטפֿערט זײער לעבן צו פּעסט.<verse eid="PSA 78:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 78:51" />און ער האָט געשלאָגן יעטװעדער בכוֹר אין מִצרַיִם,</para>
  <para style="q" vid="PSA 78:51">די ערשטלינגען פֿון קראַפֿט, אין די געצעלטן פֿון חָם.<verse eid="PSA 78:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 78:52" />און ער האָט געמאַכט ציִען װי שאָף זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 78:52">און זײ געפֿירט װי אַ סטאַדע אין מדבר.<verse eid="PSA 78:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 78:53" />און ער האָט זײ באַלײט אין זיכערקײט, און זײ האָבן נישט געאַנגסט,</para>
  <para style="q" vid="PSA 78:53">און זײערע פֿײַנט האָט צוגעדעקט דער ים.<verse eid="PSA 78:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 78:54" />און ער האָט זײ געבראַכט צו זײַן הײליקן געמאַרק,</para>
  <para style="q" vid="PSA 78:54">צו דעם באַרג װאָס זײַן רעכטע האַנט האָט זיך געקױפֿט.<verse eid="PSA 78:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 78:55" />און ער האָט פֿאַרטריבן פֿון פֿאַר זײ פֿעלקער,</para>
  <para style="q" vid="PSA 78:55">און זײ אױסגעװאָרפֿן מיט אַ מעסטשנור פֿאַר אַ נחלה;</para>
  <para style="q" vid="PSA 78:55">און געמאַכט רוען אין זײערע געצעלטן</para>
  <para style="q" vid="PSA 78:55">די שבֿטים פֿון יִשׂרָאֵל.<verse eid="PSA 78:55" /></para>
  <para style="b" />
  <para style="q">
    <verse number="56" style="v" sid="PSA 78:56" />אָבער זײ האָבן געפּרוּװט און װידערשפּעניקט אלֹקים דעם עליון,</para>
  <para style="q" vid="PSA 78:56">און זײַנע צײגנים האָבן זײ נישט געהיט.<verse eid="PSA 78:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 78:57" />און זײ האָבן זיך אָפּגעקערט און געפֿעלשט װי זײערע עלטערן,</para>
  <para style="q" vid="PSA 78:57">זײ זײַנען פֿאַרקערט געװאָרן װי אַ פֿאַלשער בױגן.<verse eid="PSA 78:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 78:58" />און זײ האָבן אים דערצערנט מיט קִנְאָה מיט זײערע בָמות,</para>
  <para style="q" vid="PSA 78:58">און מיט זײערע געצן אים דערבײזערט מיט קינאה.<verse eid="PSA 78:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 78:59" />האָט אלֹקים געהערט און איז אין כּעס געװאָרן,</para>
  <para style="q" vid="PSA 78:59">און ער האָט זײער פֿאַראַכט יִשׂרָאֵל.<verse eid="PSA 78:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 78:60" />און ער האָט אַװעקגעװאָרפֿן דעם מישכּן פֿון שילוֹ,</para>
  <para style="q" vid="PSA 78:60">דאָס געצעלט װאָס ער האָט געמאַכט רוען צװישן מענטשן.<verse eid="PSA 78:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 78:61" />און ער האָט געגעבן אין געפֿאַנגענשאַפֿט זײַן שטאַרקײט,</para>
  <para style="q" vid="PSA 78:61">און זײַן פּראַכט אין דער האַנט פֿון פֿײַנט.<verse eid="PSA 78:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 78:62" />און ער האָט איבערגעענטפֿערט צום שװערד זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 78:62">און האָט אױף זײַן נחלה געצערנט.<verse eid="PSA 78:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 78:63" />זײערע בחורים האָט פֿאַרצערט אַ פֿײַער,</para>
  <para style="q" vid="PSA 78:63">און זײערע יונגפֿרױען זײַנען געבליבן אָן אַ חתונה-ליד.<verse eid="PSA 78:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 78:64" />זײערע כּהנים זײַנען געפֿאַלן דורכן שװערד,</para>
  <para style="q" vid="PSA 78:64">און זײערע אַלמנות פֿלעגן צו מאָל נישט באַװײנען.<verse eid="PSA 78:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 78:65" />אָבער אֲדֹנָי האָט אױפֿגעװאַכט װי אַ שלאָפֿעדיקער,</para>
  <para style="q" vid="PSA 78:65">אַזױ װי אַ גיבור װאָס ניכטערט זיך אױס פֿון װײַן.<verse eid="PSA 78:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 78:66" />און ער האָט צוריקגעשלאָגן זײַנע פֿײַנט;</para>
  <para style="q" vid="PSA 78:66">אַן אײביקע שאַנד האָט ער זײ געגעבן.<verse eid="PSA 78:66" /></para>
  <para style="b" />
  <para style="q">
    <verse number="67" style="v" sid="PSA 78:67" />אָבער ער האָט פֿאַראַכט דאָס געצעלט פֿון יוֹסף,</para>
  <para style="q" vid="PSA 78:67">און דעם שבֿט אפֿרים נישט אױסדערװײלט;<verse eid="PSA 78:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 78:68" />נאָר אױסדערװײלט דעם שבֿט יהוּדה,</para>
  <para style="q" vid="PSA 78:68">דעם באַרג צִיוֹן װאָס ער האָט ליב.<verse eid="PSA 78:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 78:69" />און ער האָט געבױט װי די הימלען זײַן מִקדָש,</para>
  <para style="q" vid="PSA 78:69">װי די ערד װאָס ער האָט געגרונטפֿעסט אױף אײביק.<verse eid="PSA 78:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 78:70" />און ער האָט אױסדערװײלט דָוִד זײַן קנעכט,</para>
  <para style="q" vid="PSA 78:70">און אים גענומען פֿון די שאָפֿגעהעפֿטן.<verse eid="PSA 78:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 78:71" />פֿון הינטער די מילכשעפּסן האָט ער אים געבראַכט</para>
  <para style="q" vid="PSA 78:71">צו פֿיטערן יעקבֿ זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 78:71">און יִשׂרָאֵל זײַן אַרב.<verse eid="PSA 78:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 78:72" />ער האָט זײ געפֿיטערט לױט דער ערלעכקײט פֿון זײַן האַרצן,</para>
  <para style="q" vid="PSA 78:72">און מיט דער פֿאַרשטאַנדיקײט פֿון זײַנע הענט זײ געפֿירט.<verse eid="PSA 78:72" /></para>
  <chapter eid="PSA 78" />
  <chapter number="79" style="c" pubnumber="עט" sid="PSA 79" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 79:1" />אַ מיזמור פֿון אָסָפֿן.</para>
  <para style="q" vid="PSA 79:1">
    <char style="va">1</char> אלֹקים, פֿעלקער זײַנען געקומען אין דײַן אַרב;</para>
  <para style="q" vid="PSA 79:1">זײ האָבן פֿאַראומרײניקט דײַן הײליקן הֵיכל,</para>
  <para style="q" vid="PSA 79:1">זײ האָבן געמאַכט ירושָלַיִם פֿאַר הױפֿנס.<verse eid="PSA 79:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 79:2" />זײ האָבן געגעבן די טױטע לײַבער פֿון דײַנע קנעכט</para>
  <para style="q" vid="PSA 79:2">פֿאַר שפּײַז צו דעם פֿױגל פֿון הימל,</para>
  <para style="q" vid="PSA 79:2">דאָס פֿלײש פֿון דײַנע פֿרומע צו דער חיה פֿון דער ערד.<verse eid="PSA 79:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 79:3" />זײ האָבן פֿאַרגאָסן זײער בלוט אַזױ װי װאַסער, אַרום ירושָלַיִם,</para>
  <para style="q" vid="PSA 79:3">און נישט געװען קײן באַגרעבער.<verse eid="PSA 79:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 79:4" />מיר זײַנען געװאָרן אַ חרפּה בײַ אונדזערע שכנים,</para>
  <para style="q" vid="PSA 79:4">אַ געלעכטער און אַ שפּאָט בײַ אונדזערע אַרומיקע.<verse eid="PSA 79:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 79:5" />ביז װען ה׳ װעסטו צערענען אױף אײביק?</para>
  <para style="q" vid="PSA 79:5">װעט ברענען װי פֿײַער דײַן קִנְאָה צאָרן?<verse eid="PSA 79:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 79:6" />גיס אױס דײַן גרימצאָרן אױף די פֿעלקער</para>
  <para style="q" vid="PSA 79:6">װאָס קענען דיך נישט,</para>
  <para style="q" vid="PSA 79:6">און אױף די קיניגרײַכן</para>
  <para style="q" vid="PSA 79:6">װאָס רופֿן נישט דײַן נאָמען.<verse eid="PSA 79:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 79:7" />װאָרעם מע האָט אױפֿגעגעסן יעקבֿ,</para>
  <para style="q" vid="PSA 79:7">און זײַן װױנונג האָבן זײ פֿאַרװיסט.<verse eid="PSA 79:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 79:8" />זאָלסט אונדז נישט דערמאָנען די זינד פֿון די פֿריִערדיקע,</para>
  <para style="q" vid="PSA 79:8">גיך זאָל אונדז אַנטקעג? קומען דײַן דערבאַרעמונג,</para>
  <para style="q" vid="PSA 79:8">װאָרעם מיר זײַנען געפֿאַלן זײער.<verse eid="PSA 79:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 79:9" />שטײ אונדז בײַ, אלֹקים פֿון אונדזער הילף,</para>
  <para style="q" vid="PSA 79:9">צוליב דעם כּבֿוד פֿון דײַן נאָמען,</para>
  <para style="q" vid="PSA 79:9">און זײַ אונדז מציל, און זײַ מכַפּר אױף אונדזערע זינד,</para>
  <para style="q" vid="PSA 79:9">פֿון װעגן דײַן נאָמען.<verse eid="PSA 79:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 79:10" />נאָך װאָס זאָלן זאָגן די פֿעלקער: װוּ איז זײער ג-ט?</para>
  <para style="q" vid="PSA 79:10">זאָל באַװוּסט װערן צװישן די פֿעלקער פֿאַר אונדזערע אױגן</para>
  <para style="q" vid="PSA 79:10">די נקמה פֿאַר דעם פֿאַרגאָסענעם בלוט פֿון דײַנע קנעכט.<verse eid="PSA 79:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 79:11" />זאָל קומען פֿאַר דיר דאָס קרעכצן פֿון געפֿאַנגענעם,</para>
  <para style="q" vid="PSA 79:11">לױט דער גרױסקײט פֿון דײַן אָרעם</para>
  <para style="q" vid="PSA 79:11">לאָז לעבן די אָנגעברײטע צום טױט,<verse eid="PSA 79:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 79:12" />און קער אום אונדזערע שכנים זיבנפֿאַכיק אין זײער בוזעם,</para>
  <para style="q" vid="PSA 79:12">זײער לעסטערונג װאָס זײ האָבן דיך געלעסטערט, אֲדֹנָי.<verse eid="PSA 79:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 79:13" />און מיר, דײַן פֿאָלק, און די שאָף פֿון דײַן פֿיטערונג,</para>
  <para style="q" vid="PSA 79:13">װעלן דיר דאַנקען אױף אײביק,</para>
  <para style="q" vid="PSA 79:13">אױף דור-דורות װעלן מיר דערצײלן דײַן לױב.<verse eid="PSA 79:13" /></para>
  <chapter eid="PSA 79" />
  <chapter number="80" style="c" pubnumber="פּ" sid="PSA 80" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 80:1" />פֿאַר דעם געזאַנגמײַסטער, אױף שוֹשַנים-עדות; פֿון אָסָפֿן אַ מיזמור.<verse eid="PSA 80:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 80:2" /> דו פּאַסטוך פֿון יִשׂרָאֵל, פֿאַרנעם;</para>
  <para style="q" vid="PSA 80:2">דו װאָס פֿירסט אַזױ װי שאָף יוֹסף,</para>
  <para style="q" vid="PSA 80:2">דו װאָס זיצסט איבער די כּרובֿים, שײַן אַרױס.<verse eid="PSA 80:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 80:3" /> פֿאַרױס פֿאַר אפֿרים און בנימין און מנַשֶה</para>
  <para style="q" vid="PSA 80:3">דערװעק דײַן גבֿורה, און קום אונדז צו הילף.<verse eid="PSA 80:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 80:4" /> אלֹקים, ריכט אונדז װידער אױף,</para>
  <para style="q" vid="PSA 80:4">און דערלײַכט דײַן פּנים, אַז מיר זאָלן געהאָלפֿן װערן.<verse eid="PSA 80:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 80:5" /> ה׳ דו אלֹקים צבָֿאוֹת,</para>
  <para style="q" vid="PSA 80:5">ביז װאַנען װעסטו צערענען אױף דער תּפֿילה פֿון דײַן פֿאָלק?<verse eid="PSA 80:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 80:6" /> האָסט זײ געשפּײַזט מיט ברױט פֿון טרערן,</para>
  <para style="q" vid="PSA 80:6">און זײ געמאַכט טרינקען עמערסװײַז טרערן.<verse eid="PSA 80:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 80:7" /> מאַכסט אונדז צום שטרײַט בײַ אונדזערע שכנים,</para>
  <para style="q" vid="PSA 80:7">און אונדזערע שָׂונאים לאַכן זיך אָן.<verse eid="PSA 80:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 80:8" /> אלֹקים פֿון צבָֿאוֹת, ריכט אונדז װידער אױף,</para>
  <para style="q" vid="PSA 80:8">און דערלײַכט דײַן פּנים, אַז מיר זאָלן געהאָלפֿן װערן.<verse eid="PSA 80:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 80:9" /> אַ װײַנשטאָק האָסטו אַרױסגעצױגן פֿון מִצרַיִם,</para>
  <para style="q" vid="PSA 80:9">האָסט פֿאַרטריבן פֿעלקער, און אים אײַנגעפֿלאַנצט.<verse eid="PSA 80:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 80:10" /> האָסט אָפּגעראַמט פֿאַר אים,</para>
  <para style="q" vid="PSA 80:10">און ער האָט אײַנגעװאָרצלט זײַנע װאָרצלען,</para>
  <para style="q" vid="PSA 80:10">און אָנגעפֿילט דאָס לאַנד.<verse eid="PSA 80:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 80:11" /> די בערג זײַנען פֿאַרדעקט געװאָרן פֿון זײַן שאָטן,</para>
  <para style="q" vid="PSA 80:11">און זײַנע צװײַגן זײַנען געװען צעדערן פֿון אֵל.<verse eid="PSA 80:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 80:12" /> ער האָט אַרױסגעלאָזט זײַנע ריטער ביז צום ים,</para>
  <para style="q" vid="PSA 80:12">און ביז צום טײַך זײַנע שפּראָצן.<verse eid="PSA 80:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 80:13" /> פֿאַר װאָס האָסטו צעבראָכן זײַנע צאַמען,</para>
  <para style="q" vid="PSA 80:13">אַז אַלע װעגגײער זאָלן אים אַרומקלײַבן?<verse eid="PSA 80:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 80:14" /> דער חזר פֿון װאַלד פֿרעסט אים אָפּ,</para>
  <para style="q" vid="PSA 80:14">און די װידמענונג פֿון פֿעלד פֿיטערט זיך אױף אים.<verse eid="PSA 80:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 80:15" /> אלֹקים פֿון צבָֿאוֹת, קער זיך אום, איך בעט דיך,</para>
  <para style="q" vid="PSA 80:15">לוג פֿון הימל און זע, און גיב אַכט אױפֿן דאָזיקן װײַנשטאָק,<verse eid="PSA 80:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 80:16" /> און באַפֿעסטיק דאָס װאָס דײַן רעכטע האָט אײַנגעפֿלאַנצט,</para>
  <para style="q" vid="PSA 80:16">און דערהײב דעם צװײַג װאָס דו האָסט דיר שטאַרק געמאַכט.<verse eid="PSA 80:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 80:17" /> ער איז פֿון פֿײַער פֿאַרברענט, ער איז אָפּגעשניטן;</para>
  <para style="q" vid="PSA 80:17">פֿון דעם בײזער פֿון דײַן פּנים גײען זײ אונטער.<verse eid="PSA 80:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 80:18" /> זאָל דײַן האַנט זײַן אױף דעם מאַן פֿון דײַן רעכטער האַנט,</para>
  <para style="q" vid="PSA 80:18">אױף דעם מענטשנקינד װאָס דו האָסט דיר שטאַרק געמאַכט,<verse eid="PSA 80:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 80:19" /> אַז מיר זאָלן זיך נישט אָפּקערן פֿון דיר;</para>
  <para style="q" vid="PSA 80:19">זאָלסט אונדז אױפֿלעבן, אַז מיר רופֿן דײַן נאָמען.<verse eid="PSA 80:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 80:20" /> ה׳ דו אלֹקים פֿון צבָֿאוֹת, ריכט אונדז װידער אױף,</para>
  <para style="q" vid="PSA 80:20">דערלײַכט דײַן פּנים, אַז מיר זאָלן געהאָלפֿן װערן.<verse eid="PSA 80:20" /></para>
  <chapter eid="PSA 80" />
  <chapter number="81" style="c" pubnumber="פּא" sid="PSA 81" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 81:1" />פֿאַר דעם געזאַנגמײַסטער, אױף גִתּית; פֿון אָסָפֿן.<verse eid="PSA 81:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 81:2" /> זינגט צו אלֹקים אונדזער שטאַרקײט,</para>
  <para style="q" vid="PSA 81:2">שאַלט צו דעם אלוקי יעקבֿ.<verse eid="PSA 81:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 81:3" /> הײבט אױף אַ געזאַנג, און שפּילט אױף אַ פּױק,</para>
  <para style="q" vid="PSA 81:3">אױף אַ זיסער האַרף מיט אַ גיטאַר.<verse eid="PSA 81:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 81:4" /> בלאָזט אַ שופֿר אום ראָש-חודש,</para>
  <para style="q" vid="PSA 81:4">אין פֿולער לבֿנה צו אונדזער יוֹם-טובֿ.<verse eid="PSA 81:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 81:5" /> װאָרעם דאָס איז אַ חוק פֿאַר יִשׂרָאֵל,</para>
  <para style="q" vid="PSA 81:5">אַ געזעץ פֿון דעם אלוקי יעקבֿ.<verse eid="PSA 81:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 81:6" /> אַן צײגנים אין יוֹסף האָט ער עס געמאַכט,</para>
  <para style="q" vid="PSA 81:6">אַז װען ער איז אַרױס אױף לאַנד מִצרַיִם,</para>
  <para style="q" vid="PSA 81:6">האָב איך אַ שפּראַך מיר אומבאַקאַנט געהערט.<verse eid="PSA 81:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 81:7" /> איך האָב אָפּגעטאָן זײַן רוקן פֿון לאַסט,</para>
  <para style="q" vid="PSA 81:7">זײַנע הענט זאָלן אַװעק פֿון דעם טראָגקאָרב.<verse eid="PSA 81:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 81:8" /> האָסט גערופֿן אין נױט, און איך האָב דיך אַרױסגעצױגן,</para>
  <para style="q" vid="PSA 81:8">איך האָב דיר געענטפֿערט פֿון דער פֿאַרבאָרגעניש פֿון דונער.</para>
  <para style="q" vid="PSA 81:8">איך האָב דיך געפּרוּװט בײַ די װאַסערן פֿון מריבֿה. סֶלָה.<verse eid="PSA 81:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 81:9" /> הער, מײַן פֿאָלק, און איך װעל דיך װאָרענען,</para>
  <para style="q" vid="PSA 81:9">יִשׂרָאֵל, װען דו זאָלסט מיר צוהערן!<verse eid="PSA 81:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 81:10" /> קײן אֵל זָר זאָל נישט זײַן בײַ דיר,</para>
  <para style="q" vid="PSA 81:10">און זאָלסט זיך נישט בוקן צו קײן פֿרעמדן ג-ט.<verse eid="PSA 81:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 81:11" /> איך בין ה׳ דײַן ג-ט,</para>
  <para style="q" vid="PSA 81:11">װאָס האָט דיך אױפֿגעבראַכט פֿון לאַנד מִצרַיִם;</para>
  <para style="q" vid="PSA 81:11">מאַך אױף ברײט דײַן מױל און איך װעל עס אָנפֿילן.<verse eid="PSA 81:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 81:12" /> אָבער מײַן פֿאָלק האָט נישט צוגעהערט צו מײַן קֹול,</para>
  <para style="q" vid="PSA 81:12">און יִשׂרָאֵל האָט נישט אײַנגעװיליקט צו מיר.<verse eid="PSA 81:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 81:13" /> און איך האָב אים פֿרײַ געלאָזט</para>
  <para style="q" vid="PSA 81:13">אין דער אײַנגעשפּאַרטקײט פֿון זײַן האַרצן,</para>
  <para style="q" vid="PSA 81:13">זײ זאָלן גײן לױט זײערע באַראָטן.<verse eid="PSA 81:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 81:14" /> װען מײַן פֿאָלק װאָלט צוהערן צו מיר,</para>
  <para style="q" vid="PSA 81:14">װען יִשׂרָאֵל װאָלט אין מײַנע װעגן גײן!<verse eid="PSA 81:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 81:15" /> איך װאָלט גיך אונטערטעניקט זײערע פֿײַנט,</para>
  <para style="q" vid="PSA 81:15">און אױף זײערע דריקער געקערט מײַן האַנט.<verse eid="PSA 81:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 81:16" /> די שָׂונאים פֿון ה׳ װאָלטן אײַנגעגאַנגען פֿאַר אים,</para>
  <para style="q" vid="PSA 81:16">און זײער שטראָף װאָלט געװען אײביק.<verse eid="PSA 81:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 81:17" /> און אים װאָלט מען געשפּײַזט מיט דעם פֿעטס פֿון װײץ;</para>
  <para style="q" vid="PSA 81:17">און פֿון פֿעלדז דיך װאָלט איך מיט האָניק געזעטיקט.<verse eid="PSA 81:17" /></para>
  <chapter eid="PSA 81" />
  <chapter number="82" style="c" pubnumber="פּב" sid="PSA 82" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 82:1" />אַ מיזמור פֿון אָסָפֿן.</para>
  <para style="q" vid="PSA 82:1">
    <char style="va">1</char> אלֹקים שטײט אין דער עדה פֿון אֵל,</para>
  <para style="q" vid="PSA 82:1">אין דער מיטן פֿון די אלֹקים משפּט ער.<verse eid="PSA 82:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 82:2" />ביז װאַנען װעט איר משפּטן אומגערעכט,</para>
  <para style="q" vid="PSA 82:2">און שױנען דעם פּנים פֿון די רשעים?</para>
  <para style="q" vid="PSA 82:2">סֶלָה.<verse eid="PSA 82:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 82:3" />טוט רעכט דעם אָרעמאַן און דעם יתום,</para>
  <para style="q" vid="PSA 82:3">דעם געדריקטן און דעם באַדערפֿטיקן מאַכט גערעכט.<verse eid="PSA 82:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 82:4" />מאַכט אַנטרינען דעם אָרעמאַן און דעם אבֿיון,</para>
  <para style="q" vid="PSA 82:4">פֿון דער האַנט פֿון די רשעים זײַט מציל.<verse eid="PSA 82:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 82:5" />זײ װײסן נישט, און זײ פֿאַרשטײען נישט,</para>
  <para style="q" vid="PSA 82:5">אין פֿינצטערניש גײען זײ אום;</para>
  <para style="q" vid="PSA 82:5">אַלע גרונטפֿעסטן פֿון דער ערד פֿאַלן אום.<verse eid="PSA 82:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 82:6" />איך װאָלט געזאָגט, אלֹקים זײַט איר,</para>
  <para style="q" vid="PSA 82:6">און זין פֿון דעם עליון זײַט איר אַלע.<verse eid="PSA 82:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 82:7" />אָבער אַזױ װי אַ מענטש װעט איר שטאַרבן,</para>
  <para style="q" vid="PSA 82:7">און װי אײנער פֿון די האַרן װעט איר פֿאַלן.<verse eid="PSA 82:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 82:8" />שטײ אױף, אלֹקים, משפּט די ערד,</para>
  <para style="q" vid="PSA 82:8">װאָרעם אַלע פֿעלקער זײַנען דײַן אַרב.<verse eid="PSA 82:8" /></para>
  <chapter eid="PSA 82" />
  <chapter number="83" style="c" pubnumber="פּג" sid="PSA 83" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 83:1" />אַ געזאַנג, אַ מיזמור פֿון אָסָפֿן.<verse eid="PSA 83:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 83:2" /> אלֹקים, נישט זײַ שטיל,</para>
  <para style="q" vid="PSA 83:2">זאָלסט נישט פֿאַרשװײַגן און נישט רוען, אֵל.<verse eid="PSA 83:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 83:3" /> װאָרעם זע, דײַנע פֿײַנט טומלען,</para>
  <para style="q" vid="PSA 83:3">און דײַנע שָׂונאים הײבן אױף דעם קאָפּ.<verse eid="PSA 83:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 83:4" /> אַקעגן דײַן פֿאָלק סוֹדען זײ זיך ליסטיק,</para>
  <para style="q" vid="PSA 83:4">און זײ עֵצהן זיך אַקעגן דײַנע באַשיצטע.<verse eid="PSA 83:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 83:5" /> זײ האָבן געזאָגט: קומט,</para>
  <para style="q" vid="PSA 83:5">און לאָמיר זײ פֿאַרטיליקן פֿון זײַן אַ פֿאָלק,</para>
  <para style="q" vid="PSA 83:5">אַז מער זאָל נישט געדאַכט װערן דער נאָמען יִשׂרָאֵל.<verse eid="PSA 83:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 83:6" /> װאָרעם זײ האָבן געהאַלטן אַן עצה מיט אײן האַרצן,</para>
  <para style="q" vid="PSA 83:6">קעגן דיר אַ ברית טוען זײ שליסן.<verse eid="PSA 83:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 83:7" /> די געצעלטן פֿון אֶדוֹם, און די יִשמָעֵאלים,</para>
  <para style="q" vid="PSA 83:7">מוֹאָבֿ, און די הַגרים;<verse eid="PSA 83:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 83:8" /> גבֿל, און עַמוֹן, און עַמָלֵק,</para>
  <para style="q" vid="PSA 83:8">פּלֶשֶת מיט די באַװױנער פֿון צוֹר.<verse eid="PSA 83:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 83:9" /> אױך אשור האָט זיך באַהעפֿט מיט זײ;</para>
  <para style="q" vid="PSA 83:9">זײ זײַנען אַן אָרעם צו די קינדער פֿון לוֹט.</para>
  <para style="q" vid="PSA 83:9">סֶלָה.<verse eid="PSA 83:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 83:10" /> טו צו זײ אַזױ װי צו מִדיָן,</para>
  <para style="q" vid="PSA 83:10">װי צו סיסראן, װי צו יבֿינען בײַם טײַך קישון,<verse eid="PSA 83:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 83:11" /> װאָס זײַנען פֿאַרטיליקט געװאָרן אין עֵין-דֹאר,</para>
  <para style="q" vid="PSA 83:11">געװאָרן װי מיסט אױף דער ערד.<verse eid="PSA 83:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 83:12" /> מאַך זײערע אַדללײַט װי עוֹרֵבֿ און װי זאבֿ,</para>
  <para style="q" vid="PSA 83:12">און װי זֶבַֿח און װי צלמונע, אַלע זײערע פֿירשטן;<verse eid="PSA 83:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 83:13" /> די װאָס זאָגן: לאָמיר יַרשען פֿאַר אונדז</para>
  <para style="q" vid="PSA 83:13">די װױנונגען פֿון אלֹקים.<verse eid="PSA 83:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 83:14" /> מײַן ג-ט, מאַך זײ װי װירבלשטױב,</para>
  <para style="q" vid="PSA 83:14">װי שפּרײ פֿאַרן װינט.<verse eid="PSA 83:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 83:15" /> װי אַ פֿײַער װאָס פֿאַרברענט אַ װאַלד,</para>
  <para style="q" vid="PSA 83:15">און װי אַ פֿלאַם װאָס צעפֿלאַקערט די בערג,<verse eid="PSA 83:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 83:16" /> אַזױ זאָלסטו זײ נאָכיאָגן מיט דײַן שטורעם,</para>
  <para style="q" vid="PSA 83:16">און מיט דײַן געװיטער זײ דערשרעקן.<verse eid="PSA 83:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 83:17" /> פֿיל זײער פּנים מיט שאַנד,</para>
  <para style="q" vid="PSA 83:17">אַז זײ זאָלן זוכן דײַן נאָמען, ה׳.<verse eid="PSA 83:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 83:18" /> זאָלן זײ פֿאַרשעמט און דערשראָקן װערן אױף אײביק,</para>
  <para style="q" vid="PSA 83:18">און זאָלן זײ צו שאַנד װערן און אונטערגײן.<verse eid="PSA 83:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 83:19" /> און זאָלן זײ װיסן אַז דו אַלײן װאָס דײַן נאָמען איז ה׳,</para>
  <para style="q" vid="PSA 83:19">ביסט דער עליון איבער דער גאַנצער ערד.<verse eid="PSA 83:19" /></para>
  <chapter eid="PSA 83" />
  <chapter number="84" style="c" pubnumber="פּד" sid="PSA 84" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 84:1" />פֿאַר דעם געזאַנגמײַסטער, אױף גִתּית; פֿון די קינדער פֿון קֹרַח אַ מיזמור.<verse eid="PSA 84:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 84:2" /> װי ליבלעך זײַנען דײַנע װױנונגען,</para>
  <para style="q" vid="PSA 84:2">ה׳ צבָֿאוֹת!<verse eid="PSA 84:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 84:3" /> מײַן זעל גאַרט און גײט אױס</para>
  <para style="q" vid="PSA 84:3">נאָך די הױפֿן פֿון ה׳;</para>
  <para style="q" vid="PSA 84:3">מײַן האַרץ און מײַן לײַב זינגען</para>
  <para style="q" vid="PSA 84:3">צום לעבעדיקן אֵל.<verse eid="PSA 84:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 84:4" /> אַפֿילו אַ שפּערל געפֿינט אַ הײם,</para>
  <para style="q" vid="PSA 84:4">און אַ שװאַלב אַ נעסט פֿאַר זיך,</para>
  <para style="q" vid="PSA 84:4">װוּ זי טוט אַהין אירע יונגע,</para>
  <para style="q" vid="PSA 84:4">בײַ דײַנע מזבחות, ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="PSA 84:4">מײַן קיניג און מײַן ג-ט.<verse eid="PSA 84:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 84:5" /> װױל צו די װאָס זיצן אין דײַן הױז;</para>
  <para style="q" vid="PSA 84:5">תּמיד װעלן זײ דיך לױבן.</para>
  <para style="q" vid="PSA 84:5">סֶלָה.<verse eid="PSA 84:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 84:6" /> װױל צו די מענטשן װאָס זײער שטאַרקײט איז אין דיר,</para>
  <para style="q" vid="PSA 84:6">װאָס דײַנע װעגן זײַנען אין זײער האַרצן.<verse eid="PSA 84:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 84:7" /> דורכגײענדיק דעם טאָל בָכאָ,</para>
  <para style="q" vid="PSA 84:7">מאַכן זײ אים פֿאַר אַ קװאַל;</para>
  <para style="q" vid="PSA 84:7">יאָ, אַ פֿרירעגן באַקלײדט אים מיט ברכות.<verse eid="PSA 84:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 84:8" /> זײ גײען פֿון שטאַרקײט צו שטאַרקײט,</para>
  <para style="q" vid="PSA 84:8">זײ װײַזן זיך פֿאַר אלֹקים אין צִיוֹן.<verse eid="PSA 84:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 84:9" /> ה׳ דו אלֹקים פֿון צבָֿאוֹת, הער צו מײַן תּפֿילה,</para>
  <para style="q" vid="PSA 84:9">פֿאַרנעם, דו אלוקי יעקבֿ.</para>
  <para style="q" vid="PSA 84:9">סֶלָה.<verse eid="PSA 84:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 84:10" /> אלֹקים אונדזער שילד, זע,</para>
  <para style="q" vid="PSA 84:10">און קוק אױף דעם פּנים פֿון דײַן געזאַלבטן.<verse eid="PSA 84:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 84:11" /> װאָרעם בעסער אַ טאָג אין דײַנע הױפֿן</para>
  <para style="q" vid="PSA 84:11">אײדער טױזנט;</para>
  <para style="q" vid="PSA 84:11">איך װאָלט אױסגעװײלט שטײן בײַם שװעל אין הױז פֿון מײַן ג-ט,</para>
  <para style="q" vid="PSA 84:11">אײדער װױנען אין געצעלטן פֿון אומרעכט.<verse eid="PSA 84:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 84:12" /> װאָרעם אַ זון און אַ שילד איז ה׳ אלֹקים,</para>
  <para style="q" vid="PSA 84:12">חן און כּבֿוד גיט ה׳;</para>
  <para style="q" vid="PSA 84:12">ער פֿאַרמײַדט נישט קײן גוטס</para>
  <para style="q" vid="PSA 84:12">פֿון די װאָס גײען אין ערלעכקײט.<verse eid="PSA 84:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 84:13" /> ה׳ צבָֿאוֹת, װױל צו דעם מענטשן</para>
  <para style="q" vid="PSA 84:13">װאָס פֿאַרזיכערט זיך אױף דיר.<verse eid="PSA 84:13" /></para>
  <chapter eid="PSA 84" />
  <chapter number="85" style="c" pubnumber="פּה" sid="PSA 85" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 85:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון די קינדער פֿון קֹרַח אַ מיזמור.<verse eid="PSA 85:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 85:2" /> האָסט באַװיליקט, ה׳, דײַן לאַנד,</para>
  <para style="q" vid="PSA 85:2">האָסט אומגעקערט די געפֿאַנגענשאַפֿט פֿון יעקבֿ.<verse eid="PSA 85:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 85:3" /> האָסט פֿאַרגעבן די זינד פֿון דײַן פֿאָלק,</para>
  <para style="q" vid="PSA 85:3">האָסט פֿאַרדעקט זײערע אַלע חטאָים.</para>
  <para style="q" vid="PSA 85:3">סֶלָה.<verse eid="PSA 85:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 85:4" /> האָסט אײַנגעטאָן אַל דײַן רוגז,</para>
  <para style="q" vid="PSA 85:4">האָסט זיך אָפּגעקערט פֿון דײַן גרימצאָרן.<verse eid="PSA 85:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 85:5" /> ריכט אונדז װידער אױף, אלֹקים פֿון אונדזער הילף,</para>
  <para style="q" vid="PSA 85:5">און פֿאַרשטער דײַן כּעס קעגן אונדז.<verse eid="PSA 85:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 85:6" /> צי אױף אײביק װעסטו צערענען אױף אונדז?</para>
  <para style="q" vid="PSA 85:6">װעסטו ציִען דײַן כּעס אױף דור-דורות?<verse eid="PSA 85:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 85:7" /> צי װעסטו אונדז נישט אױפֿלעבן װידער,</para>
  <para style="q" vid="PSA 85:7">אַז דײַן פֿאָלק זאָל זיך פֿרײען מיט דיר?<verse eid="PSA 85:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 85:8" /> װײַז אונדז, ה׳, דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 85:8">און דײַן הילף זאָלסטו אונדז געבן.<verse eid="PSA 85:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 85:9" /> איך הער װאָס הָאֵל ה׳ רעדט;</para>
  <para style="q" vid="PSA 85:9">פֿאַר װאָר, ער רעדט פֿריד פֿאַר זײַן פֿאָלק און פֿאַר זײַנע פֿרומע;</para>
  <para style="q" vid="PSA 85:9">נאָר זײ זאָלן זיך נישט אומקערן צו נאַרישקײט.<verse eid="PSA 85:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 85:10" /> גאָר נאָנט צו זײַנע פֿאָרכטער איז זײַן ישועה,</para>
  <para style="q" vid="PSA 85:10">כּדי כּבֿוד זאָל רוען אין אונדזער לאַנד.<verse eid="PSA 85:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 85:11" /> גענאָד און אמת האָבן זיך באַגעגענט,</para>
  <para style="q" vid="PSA 85:11">גערעכטיקײט און שלום האָבן זיך צעקושט.<verse eid="PSA 85:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 85:12" /> אמת שפּראָצט פֿון דער ערד,</para>
  <para style="q" vid="PSA 85:12">און גערעכטיקײט לוגט פֿון הימל.<verse eid="PSA 85:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 85:13" /> יאָ, ה׳ װעט געבן גוטס,</para>
  <para style="q" vid="PSA 85:13">און אונדזער לאַנד װעט געבן איר פֿרוכט.<verse eid="PSA 85:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 85:14" /> גערעכטיקײט װעט גײן אים פֿאַרױס,</para>
  <para style="q" vid="PSA 85:14">און קירעװען אין װעג זײַנע טריט.<verse eid="PSA 85:14" /></para>
  <chapter eid="PSA 85" />
  <chapter number="86" style="c" pubnumber="פּו" sid="PSA 86" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 86:1" />אַ תּפֿילה פֿון דָוִדן.</para>
  <para style="q" vid="PSA 86:1">
    <char style="va">1</char> נײַג צו, ה׳, דײַן אױער, ענטפֿער מיר,</para>
  <para style="q" vid="PSA 86:1">װאָרעם אָרים און באַדערפֿטיק בין איך.<verse eid="PSA 86:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 86:2" />באַהיט מײַן זעל װאָרעם איך בין פֿרום,</para>
  <para style="q" vid="PSA 86:2">העלף, דו מײַן ג-ט, דײַן קנעכט װאָס פֿאַרזיכערט זיך אױף דיר.<verse eid="PSA 86:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 86:3" />לײַטזעליק מיך, אֲדֹנָי,</para>
  <para style="q" vid="PSA 86:3">װאָרעם צו דיר רוף איך אַ גאַנצן טאָג.<verse eid="PSA 86:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 86:4" />דערפֿרײ די זעל פֿון דײַן קנעכט,</para>
  <para style="q" vid="PSA 86:4">װאָרעם צו דיר, אֲדֹנָי, הײב איך אױף מײַן נפֿש.<verse eid="PSA 86:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 86:5" />װאָרעם דו, אֲדֹנָי, ביסט גוט און פֿאַרגעביק,</para>
  <para style="q" vid="PSA 86:5">און פֿילגענאָדיק צו אַלע װאָס רופֿן דיך.<verse eid="PSA 86:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 86:6" />פֿאַרנעם, ה׳, מײַן תּפֿילה,</para>
  <para style="q" vid="PSA 86:6">און האָרך צו דעם קֹול פֿון מײַנע געבעטן.<verse eid="PSA 86:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 86:7" />אין טאָג פֿון נױט רוף איך דיך,</para>
  <para style="q" vid="PSA 86:7">װאָרעם דו װעסט מיר ענטפֿערן.<verse eid="PSA 86:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 86:8" />נישטאָ אַזאַ װי דו, אֲדֹנָי, צװישן די ג‑טער,</para>
  <para style="q" vid="PSA 86:8">און נישטאָ אַזױ װי דײַנע מעשׂים.<verse eid="PSA 86:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 86:9" />אַלע פֿעלקער װאָס דו האָסט געמאַכט,</para>
  <para style="q" vid="PSA 86:9">װעלן קומען און זיך בוקן פֿאַר דיר, אֲדֹנָי,</para>
  <para style="q" vid="PSA 86:9">און געבן כּבֿוד צו דײַן נאָמען.<verse eid="PSA 86:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 86:10" />װאָרעם גרױס ביסטו, און טוסט װוּנדער,</para>
  <para style="q" vid="PSA 86:10">דו אלֹקים אַלײן.<verse eid="PSA 86:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 86:11" />לערן מיך, ה׳, דײַן װעג,</para>
  <para style="q" vid="PSA 86:11">איך זאָל גײן אין דײַן אמת,</para>
  <para style="q" vid="PSA 86:11">אײנציק מײַן האַרץ צו פֿאָרכטן דײַן נאָמען.<verse eid="PSA 86:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 86:12" />איך װעל דיך לױבן, אֲדֹנָי מײַן ג-ט, מיט מײַן גאַנצן האַרצן,</para>
  <para style="q" vid="PSA 86:12">און ערלעכן דײַן נאָמען אױף אײביק.<verse eid="PSA 86:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 86:13" />װאָרעם גרױס איז דײַן חֶסֶד צו מיר,</para>
  <para style="q" vid="PSA 86:13">און האָסט מציל געװען מײַן זעל פֿון דער טיפֿער שְׁאֹול.<verse eid="PSA 86:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 86:14" />אלֹקים, מוטװיליקע זײַנען אָנגעשטאַנען אױף מיר,</para>
  <para style="q" vid="PSA 86:14">און אַ באַנדע געװאַלטטוער זוכן מײַן לעבן,</para>
  <para style="q" vid="PSA 86:14">און זײ האַלט דיך נישט אַנטקעגן זיך.<verse eid="PSA 86:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 86:15" />אָבער דו, אֲדֹנָי, ביסט אַ דערבאַרעמדיקער און לײַטזעליקער אֵל,</para>
  <para style="q" vid="PSA 86:15">אײַנגעהאַלטן אין צאָרן און רײַך אין גענאָד און טרײַשאַפֿט.<verse eid="PSA 86:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 86:16" />קער זיך צו מיר, און לײַטזעליק מיך,</para>
  <para style="q" vid="PSA 86:16">גיב דײַן שטאַרקײט צו דײַן קנעכט,</para>
  <para style="q" vid="PSA 86:16">און העלף דעם זון פֿון דײַן דינסט.<verse eid="PSA 86:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 86:17" />מאַך מיר אַ צײכן צום גוטן,</para>
  <para style="q" vid="PSA 86:17">און זאָלן זען מײַנע שָׂונאים און פֿאַרשעמט װערן,</para>
  <para style="q" vid="PSA 86:17">אַז דו ה׳ האָסט מיך געהאָלפֿן און מיך געטרײסט.<verse eid="PSA 86:17" /></para>
  <chapter eid="PSA 86" />
  <chapter number="87" style="c" pubnumber="פּז" sid="PSA 87" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 87:1" />פֿון די קינדער פֿון קֹרַח אַ מיזמור; אַ ליד.</para>
  <para style="q" vid="PSA 87:1">
    <char style="va">1</char> זײַן גרונטפֿעסט איז אױף די הײליקע בערג.<verse eid="PSA 87:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 87:2" />ה׳ האָט ליב די טױערן פֿון צִיוֹן</para>
  <para style="q" vid="PSA 87:2">מער פֿון אַלע װױנונגען פֿון יעקבֿ.<verse eid="PSA 87:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 87:3" />פּראַכטיקס װערט גערעדט פֿון דיר,</para>
  <para style="q" vid="PSA 87:3">דו שטאָט פֿון אלֹקים.</para>
  <para style="q" vid="PSA 87:3">סֶלָה.<verse eid="PSA 87:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 87:4" />איך דערמאָן רַהַבֿ און בָבֿל פֿאַר מײַנע באַקענטע;</para>
  <para style="q" vid="PSA 87:4">אָט איז פּלֶשֶת, און צוֹר מיט כּוּש:</para>
  <para style="q" vid="PSA 87:4">דער דאָזיקער איז אין איר געבאָרן געװאָרן.<verse eid="PSA 87:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 87:5" />אָבער פֿון צִיוֹן װערט געזאָגט:</para>
  <para style="q" vid="PSA 87:5">דער און יענער איז דאָרטן געבאָרן געװאָרן,</para>
  <para style="q" vid="PSA 87:5">און דער עליון אַלײן באַפֿעסטיקט זי.<verse eid="PSA 87:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 87:6" />ה׳ צײלט בײַם פֿאַרשרײַבן די פֿעלקער:</para>
  <para style="q" vid="PSA 87:6">דער דאָזיקער איז דאָרטן געבאָרן געװאָרן.</para>
  <para style="q" vid="PSA 87:6">סֶלָה.<verse eid="PSA 87:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 87:7" />יאָ, אַזױ װי די זינגער װי אַזױ אױך די טענצער זאָגן;</para>
  <para style="q" vid="PSA 87:7">אַלע מײַנע ברונעם זענען אין דיר צִיוֹן.<verse eid="PSA 87:7" /></para>
  <chapter eid="PSA 87" />
  <chapter number="88" style="c" pubnumber="פּח" sid="PSA 88" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 88:1" />אַ געזאַנג; אַ מיזמור פֿון די קינדער פֿון קֹרַח; פֿאַר דעם געזאַנגמײַסטער, אױף מַחלַת לעַנות; אַ באַטראַכטונג פֿון הֵימָן דעם אֶזרָחי.<verse eid="PSA 88:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 88:2" /> ה׳ דו אלֹקים פֿון מײַן הילף,</para>
  <para style="q" vid="PSA 88:2">בעת איך שרײַ בײַ נאַכט פֿאַר דיר,<verse eid="PSA 88:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 88:3" /> זאָל קומען מײַן תּפֿילה פֿאַר דיר;</para>
  <para style="q" vid="PSA 88:3">נײַג דײַן אױער צו מײַן רוף.<verse eid="PSA 88:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 88:4" /> װאָרעם זאַט מיט אומגליקן איז מײַן זעל,</para>
  <para style="q" vid="PSA 88:4">און מײַן לעבן האָט צו דער שְׁאֹול דערגרײכט.<verse eid="PSA 88:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 88:5" /> איך װער גערעכנט מיט גענידערטע אין גרוב,</para>
  <para style="q" vid="PSA 88:5">איך בין געװאָרן װי אַ מענטש אָן כּוֹח,<verse eid="PSA 88:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 88:6" /> אַן אָפּגעזונדערטער צװישן מתים;</para>
  <para style="q" vid="PSA 88:6">װי דערשלאָגענע װאָס ליגן אין קבֿר,</para>
  <para style="q" vid="PSA 88:6">װאָס דו דערמאָנסט זײ נישט מער,</para>
  <para style="q" vid="PSA 88:6">און זײ זײַנען פֿון דײַן האַנט אָפּגעשניטן.<verse eid="PSA 88:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 88:7" /> האָסט מיך אַרײַנגעטאָן אין דער אונטערשטער גרוב.</para>
  <para style="q" vid="PSA 88:7">אין פֿינצטערנישן, אין טיפֿענישן.<verse eid="PSA 88:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 88:8" /> אױף מיר האָט זיך אָנגעלײגט דײַן גרימצאָרן,</para>
  <para style="q" vid="PSA 88:8">און אַלע דײַנע אינדן דריקסטו אױף מיר.</para>
  <para style="q" vid="PSA 88:8">סֶלָה.<verse eid="PSA 88:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 88:9" /> האָסט דערװײַטערט מײַנע באַקענטע פֿון מיר,</para>
  <para style="q" vid="PSA 88:9">האָסט מיך געמאַכט אַן אומװערדיקײט בײַ זײ;</para>
  <para style="q" vid="PSA 88:9">איך בין אײַנגעשפּאַרט און קען נישט אַרױסגײן.<verse eid="PSA 88:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 88:10" /> מײַן אױג שמאַכט פֿון פּײַן;</para>
  <para style="q" vid="PSA 88:10">איך האָב דיך גערופֿן, ה׳, אַלע טאָג,</para>
  <para style="q" vid="PSA 88:10">איך האָב אױסגעשפּרײט צו דיר מײַנע הענט.<verse eid="PSA 88:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 88:11" /> װעסטו פֿאַר מתים טאָן װוּנדער?</para>
  <para style="q" vid="PSA 88:11">צי די טױטע װעלן אױפֿשטײן דיך לױבן?</para>
  <para style="q" vid="PSA 88:11">סֶלָה.<verse eid="PSA 88:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 88:12" /> װעט דערצײלט װערן אין קבֿר דײַן חֶסֶד?</para>
  <para style="q" vid="PSA 88:12">דײַן טרײַשאַפֿט אין אונטערגאַנג?<verse eid="PSA 88:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 88:13" /> װעלן באַקאַנט װערן אין דער פֿינצטערניש דײַנע װוּנדער?</para>
  <para style="q" vid="PSA 88:13">און דײַן גערעכטיקײט אין לאַנד פֿון פֿאַרגעסונג?<verse eid="PSA 88:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 88:14" /> אָבער איך, צו דיר, ה׳, שרײַ איך,</para>
  <para style="q" vid="PSA 88:14">און אין פֿרימאָרגן קומט פֿאַר דיר מײַן תּפֿילה.<verse eid="PSA 88:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 88:15" /> פֿאַר װאָס פֿאַרלאָזסטו, ה׳, מײַן זעל?</para>
  <para style="q" vid="PSA 88:15">פֿאַרבאָרגסטו דײַן פּנים פֿון מיר?<verse eid="PSA 88:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 88:16" /> איך בין געדריקט און גײ אײַן פֿון יוגנט אָן,</para>
  <para style="q" vid="PSA 88:16">איך טראָג דײַן אימה, איך בין צעדולט.<verse eid="PSA 88:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 88:17" /> איבער מיר איז דײַן גרימצאָרן אַריבער,</para>
  <para style="q" vid="PSA 88:17">דײַנע שרעקענישן האָבן מיך פֿאַרשניטן.<verse eid="PSA 88:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 88:18" /> זײ האָבן מיך אַרומגערינגלט װי אַ װאַסער אַ גאַנצן טאָג,</para>
  <para style="q" vid="PSA 88:18">זײ האָבן אין אײנעם מיך אַרומגענומען.<verse eid="PSA 88:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 88:19" /> האָסט דערװײַטערט פֿון מיר אַ גוטן פֿרײַנט און אַ חבֿר,</para>
  <para style="q" vid="PSA 88:19">מײַן באַקענטשאַפֿט איז די פֿינצטערניש.<verse eid="PSA 88:19" /></para>
  <chapter eid="PSA 88" />
  <chapter number="89" style="c" pubnumber="פּט" sid="PSA 89" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 89:1" />אַ באַטראַכטונג פֿון אֵיתָן דעם אֶזרָחי.<verse eid="PSA 89:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 89:2" /> די חסדים פֿון ה׳ װעל איך אײביק זינגען,</para>
  <para style="q" vid="PSA 89:2">אױף דור-דורות װעל איך באַקאַנט מאַכן</para>
  <para style="q" vid="PSA 89:2">דײַן טרײַשאַפֿט מיט מײַן מױל.<verse eid="PSA 89:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 89:3" /> װאָרעם איך זאָג: אױף אײביק געבױט איז די גענאָד,</para>
  <para style="q" vid="PSA 89:3">די הימלען, אין זײ האָסטו באַפֿעסטיקט דײַן טרײַשאַפֿט:<verse eid="PSA 89:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 89:4" /> איך האָב געשלאָסן אַ ברית צו מײַן אױסדערװײלטן,</para>
  <para style="q" vid="PSA 89:4">איך האָב געשװאָרן צו דָוִד מײַן קנעכט:<verse eid="PSA 89:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 89:5" /> אױף אײביק װעל איך אױפֿשטעלן דײַן זאָמען,</para>
  <para style="q" vid="PSA 89:5">און אױף דור-דורות װעל איך אױפֿבױען דײַן טראָן.</para>
  <para style="q" vid="PSA 89:5">סֶלָה.<verse eid="PSA 89:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 89:6" /> און די הימלען לױבן דײַנע װוּנדער, ה׳,</para>
  <para style="q" vid="PSA 89:6">אױך דײַן טרײַשאַפֿט אין דער אײַנזאַמלונג פֿון די הײליקע.<verse eid="PSA 89:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 89:7" /> װאָרעם װער אין הימל קען זיך גלײַכן צו ה׳?</para>
  <para style="q" vid="PSA 89:7">װער איז געגליכן צו ה׳ צװישן די מאַכטיקע?<verse eid="PSA 89:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 89:8" /> אֵל איז פֿאָרכטיק זײער אין דעם באַראָט פֿון די הײליקע,</para>
  <para style="q" vid="PSA 89:8">און מוראדיק פֿאַר אַלע זײַנע אַרומיקע.<verse eid="PSA 89:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 89:9" /> ה׳ דו אלוקי צבָֿאוֹת,</para>
  <para style="q" vid="PSA 89:9">װער איז אַזױ שטאַרק װי דו, ג-ט?</para>
  <para style="q" vid="PSA 89:9">און דײַנע געטרײַע זײַנען רונד אַרום דיר.<verse eid="PSA 89:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 89:10" /> דו געװעלטיקסט איבער דער שטאָלצן ים,</para>
  <para style="q" vid="PSA 89:10">אַז זײַנע װעלן הײבן זיך, טוסט דו זײ אײַנשטילן.<verse eid="PSA 89:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 89:11" /> דו האָסט צעדריקט װי אַ דערשלאָגענעם, רַהַבֿ,</para>
  <para style="q" vid="PSA 89:11">מיט דײַן שטאַרקן אָרעם האָסטו צעשפּרײט דײַנע פֿײַנט.<verse eid="PSA 89:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 89:12" /> דײַן איז דער הימל, דײַן אױך די ערד;</para>
  <para style="q" vid="PSA 89:12">די װעלט און איר פֿולקײט, זײ האָסט דו געגרונטפֿעסט.<verse eid="PSA 89:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 89:13" /> צפֿון און דָרום – זײ האָסט דו באַשאַפֿן,</para>
  <para style="q" vid="PSA 89:13">תָּבֿוֹר און חֶרמוֹן זינגען פֿון דײַן נאָמען.<verse eid="PSA 89:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 89:14" /> דו האָסט אַן אָרעם מיט גבֿורה,</para>
  <para style="q" vid="PSA 89:14">דײַן האַנט איז שטאַרק, דײַן רעכטע איז דערהױבן.<verse eid="PSA 89:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 89:15" /> רעכט און גערעכטיקײט זײַנען דאָס געשטעל פֿון דײַן טראָן,</para>
  <para style="q" vid="PSA 89:15">גענאָד און אמת זײַנען פֿאַר דײַן פּנים.<verse eid="PSA 89:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 89:16" /> װױל צו דעם פֿאָלק װאָס װײס דײַן לײַטזעליקײט,</para>
  <para style="q" vid="PSA 89:16">װאָס גײען, ה׳, אין ליכט פֿון דײַן פּנים.<verse eid="PSA 89:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 89:17" /> מיט דײַן נאָמען פֿרײען זײ זיך אַ גאַנצן טאָג,</para>
  <para style="q" vid="PSA 89:17">און דורך דײַן גערעכטיקײט װערן זײ דערהױבן.<verse eid="PSA 89:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 89:18" /> װאָרעם דו ביסט די פּראַכט פֿון זײער שטאַרקײט,</para>
  <para style="q" vid="PSA 89:18">און דורך דײַן גוטװיליקײט װערט דערהױבן אונדזער האָרן.<verse eid="PSA 89:18" /></para>
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 89:19" /> װאָרעם ה׳, ער איז אונדזער שילד,</para>
  <para style="q" vid="PSA 89:19">און דער הײליקער פֿון יִשׂרָאֵל, ער איז אונדזער קיניג.<verse eid="PSA 89:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 89:20" /> האָסט אַ מאָל אין אַ זעונג גערעדט צו דײַנע פֿרומע,</para>
  <para style="q" vid="PSA 89:20">און האָסט געזאָגט: איך האָב אַרױפֿגעטאָן הילף אױף אַ גיבור,</para>
  <para style="q" vid="PSA 89:20">איך האָב דערהױבן אַן אױסדערװײלטן פֿון פֿאָלק.<verse eid="PSA 89:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 89:21" /> איך האָב געפֿונען דָוִד מײַן קנעכט,</para>
  <para style="q" vid="PSA 89:21">איך האָב מיט מײַן הײליקן אײל אים געזאַלבט;<verse eid="PSA 89:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 89:22" /> אַז מײַן האַנט זאָל זײַן פֿעסט מיט אים,</para>
  <para style="q" vid="PSA 89:22">און מײַן אָרעם זאָל אים שטאַרקן.<verse eid="PSA 89:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 89:23" /> קײן פֿײַנט זאָל נישט מאָנען פֿון אים,</para>
  <para style="q" vid="PSA 89:23">און קײן באַעװלער זאָל אים נישט פּײַניקן.<verse eid="PSA 89:23" /></para>
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 89:24" /> און איך װעל צעשטױסן זײַנע דריקער פֿון פֿאַר אים,</para>
  <para style="q" vid="PSA 89:24">און זײַנע שָׂונאים װעל איך שלאָגן.<verse eid="PSA 89:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 89:25" /> און מײַן טרײַשאַפֿט און מײַן חֶסֶד װעלן זײַן מיט אים,</para>
  <para style="q" vid="PSA 89:25">און דורך מײַן נאָמען װעט דערהױבן װערן זײַן האָרן.<verse eid="PSA 89:25" /></para>
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 89:26" /> און איך װעל אַרױפֿטאָן אױפֿן ים זײַן האַנט,</para>
  <para style="q" vid="PSA 89:26">און אױף די טײַכן זײַן רעכטע.<verse eid="PSA 89:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 89:27" /> ער װעט מיך רופֿן: מײַן פֿאָטער ביסטו,</para>
  <para style="q" vid="PSA 89:27">מײַן ג-ט, און דער פֿעלדז פֿון מײַן הילף;<verse eid="PSA 89:27" /></para>
  <para style="q">
    <verse number="28" style="v" altnumber="27" sid="PSA 89:28" /> אױך איך װעל אים מאַכן פֿאַרן בכוֹר,</para>
  <para style="q" vid="PSA 89:28">פֿאַרן אױבערשטער איבער די מלכים פֿון דער ערד.<verse eid="PSA 89:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="28" sid="PSA 89:29" /> אױף אײביק װעל איך אים היטן מײַן חֶסֶד,</para>
  <para style="q" vid="PSA 89:29">און מײַן ברית װעט אים בלײַבן געטרײַ.<verse eid="PSA 89:29" /></para>
  <para style="q">
    <verse number="30" style="v" altnumber="29" sid="PSA 89:30" /> און איך װעל אָנהאַלטן שטענדיק זײַן זאָמען,</para>
  <para style="q" vid="PSA 89:30">און זײַן טראָן װי די טעג פֿון די הימלען.<verse eid="PSA 89:30" /></para>
  <para style="q">
    <verse number="31" style="v" altnumber="30" sid="PSA 89:31" /> אַז זײַנע קינדער װעלן פֿאַרלאָזן מײַן תּורה,</para>
  <para style="q" vid="PSA 89:31">און אין מײַנע געזעצן װעלן זײ נישט גײן;<verse eid="PSA 89:31" /></para>
  <para style="q">
    <verse number="32" style="v" altnumber="31" sid="PSA 89:32" /> אַז מײַנע חוקים װעלן זײ פֿאַרשװעכן,</para>
  <para style="q" vid="PSA 89:32">און מײַנע געבאָט װעלן זײ נישט היטן;<verse eid="PSA 89:32" /></para>
  <para style="q">
    <verse number="33" style="v" altnumber="32" sid="PSA 89:33" /> װעל איך שטראָפֿן מיט אַ רוט זײער פֿאַרברעך,</para>
  <para style="q" vid="PSA 89:33">און מיט פּלאָגן זײער זינד.<verse eid="PSA 89:33" /></para>
  <para style="q">
    <verse number="34" style="v" altnumber="33" sid="PSA 89:34" /> אָבער מײַן חֶסֶד װעל איך נישט פֿאַרשטערן פֿון אים,</para>
  <para style="q" vid="PSA 89:34">און נישט פֿעלשן אָן מײַן טרײַשאַפֿט.<verse eid="PSA 89:34" /></para>
  <para style="q">
    <verse number="35" style="v" altnumber="34" sid="PSA 89:35" /> איך װעל נישט פֿאַרשװעכן מײַן ברית,</para>
  <para style="q" vid="PSA 89:35">און דעם אַרױסלאָז פֿון מײַנע ליפּן װעל איך נישט בײַטן.<verse eid="PSA 89:35" /></para>
  <para style="q">
    <verse number="36" style="v" altnumber="35" sid="PSA 89:36" /> אײן מאָל האָב איך געשװאָרן אין מײַן הײליקײט:</para>
  <para style="q" vid="PSA 89:36">אױב איך װעל פֿעלשן אָן דָוִדן!<verse eid="PSA 89:36" /></para>
  <para style="q">
    <verse number="37" style="v" altnumber="36" sid="PSA 89:37" /> זײַן זאָמען זאָל זײַן אײביק,</para>
  <para style="q" vid="PSA 89:37">און זײַן טראָן װי די זון פֿאַר מיר.<verse eid="PSA 89:37" /></para>
  <para style="q">
    <verse number="38" style="v" altnumber="37" sid="PSA 89:38" /> אַזױ װי די לבֿנה זאָל ער אײביק באַשטײן,</para>
  <para style="q" vid="PSA 89:38">און װי אַ געטרײַער עדות אין הימל.</para>
  <para style="q" vid="PSA 89:38">סֶלָה.<verse eid="PSA 89:38" /></para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" altnumber="38" sid="PSA 89:39" /> אָבער דו האָסט פֿאַרלאָזן און פֿאַראַכט,</para>
  <para style="q" vid="PSA 89:39">האָסט זיך פֿאַרצאָרנט אױף דײַן געזאַלבטן.<verse eid="PSA 89:39" /></para>
  <para style="q">
    <verse number="40" style="v" altnumber="39" sid="PSA 89:40" /> האָסט אַװעקגעװאָרפֿן דעם ברית פֿון דײַן קנעכט,</para>
  <para style="q" vid="PSA 89:40">האָסט פֿאַרשװעכט צו דער ערד זײַן קרױן.<verse eid="PSA 89:40" /></para>
  <para style="q">
    <verse number="41" style="v" altnumber="40" sid="PSA 89:41" /> האָסט צעבראָכן אַלע זײַנע צאַמען,</para>
  <para style="q" vid="PSA 89:41">האָסט געמאַכט פֿון זײַנע פֿעסטונגען אַ תּעל.<verse eid="PSA 89:41" /></para>
  <para style="q">
    <verse number="42" style="v" altnumber="41" sid="PSA 89:42" /> צערױבט האָבן אים אַלע װעגגײער,</para>
  <para style="q" vid="PSA 89:42">ער איז געװאָרן אַ חרפּה בײַ זײַנע שכנים.<verse eid="PSA 89:42" /></para>
  <para style="q">
    <verse number="43" style="v" altnumber="42" sid="PSA 89:43" /> האָסט דערהױבן די רעכטע האַנט פֿון זײַנע דריקער,</para>
  <para style="q" vid="PSA 89:43">האָסט דערפֿרײט אַלע זײַנע פֿײַנט.<verse eid="PSA 89:43" /></para>
  <para style="q">
    <verse number="44" style="v" altnumber="43" sid="PSA 89:44" /> אױך האַלטסטו צוריק דעם שאַרף פֿון זײַן שװערד</para>
  <para style="q" vid="PSA 89:44">און האָסט אים נישט געלאָזט אױפֿשטײן אין מלחמה.<verse eid="PSA 89:44" /></para>
  <para style="q">
    <verse number="45" style="v" altnumber="44" sid="PSA 89:45" /> האָסט פֿאַרשטערט זײַן לױטערקײט,</para>
  <para style="q" vid="PSA 89:45">און געשלײַדערט זײַן טראָן צו דער ערד.<verse eid="PSA 89:45" /></para>
  <para style="q">
    <verse number="46" style="v" altnumber="45" sid="PSA 89:46" /> האָסט געקירצט די טעג פֿון זײַן יוגנט,</para>
  <para style="q" vid="PSA 89:46">האָסט אים מיט בושה באַדעקט.</para>
  <para style="q" vid="PSA 89:46">סֶלָה.<verse eid="PSA 89:46" /></para>
  <para style="b" />
  <para style="q">
    <verse number="47" style="v" altnumber="46" sid="PSA 89:47" /> ביז װאַנען, ה׳, װעסטו זיך פֿאַרבאָרגן נאָכאַנאַנד?</para>
  <para style="q" vid="PSA 89:47">װעט ברענען װי אַ פֿײַער דײַן גרימצאָרן?<verse eid="PSA 89:47" /></para>
  <para style="q">
    <verse number="48" style="v" altnumber="47" sid="PSA 89:48" /> געדענק, װאָס איז מײַן געדױער;</para>
  <para style="q" vid="PSA 89:48">צו װאָס פֿאַר נישטיקײט דו האָסט באַשאַפֿן אַלע מענטשנקינדער.<verse eid="PSA 89:48" /></para>
  <para style="q">
    <verse number="49" style="v" altnumber="48" sid="PSA 89:49" /> װאָסער מענטש קען לעבן און נישט זען דעם טױט?</para>
  <para style="q" vid="PSA 89:49">מאַכן אַנטרינען זײַן זעל פֿון דער האַנט פֿון דער שְׁאֹול?</para>
  <para style="q" vid="PSA 89:49">סֶלָה.<verse eid="PSA 89:49" /></para>
  <para style="b" />
  <para style="q">
    <verse number="50" style="v" altnumber="49" sid="PSA 89:50" /> װוּ זײַנען דײַנע פֿריִערדיקע חסדים, אֲדֹנָי,</para>
  <para style="q" vid="PSA 89:50">װאָס דו האָסט געשװאָרן דָוִדן אין דײַן טרײַשאַפֿט?<verse eid="PSA 89:50" /></para>
  <para style="q">
    <verse number="51" style="v" altnumber="50" sid="PSA 89:51" /> געדענק, אֲדֹנָי, די לעסטערונג פֿון דײַנע קנעכט,</para>
  <para style="q" vid="PSA 89:51">װאָס איך טראָג אין מײַן בוזעם פֿון אַל די פֿיל פֿעלקער;<verse eid="PSA 89:51" /></para>
  <para style="q">
    <verse number="52" style="v" altnumber="51" sid="PSA 89:52" /> װאָס דײַנע פֿײַנט, ה׳, לעסטערן,</para>
  <para style="q" vid="PSA 89:52">װאָס זײ לעסטערן די טריט פֿון דײַן געזאַלבטן.<verse eid="PSA 89:52" /></para>
  <para style="b" />
  <para style="q">
    <verse number="53" style="v" altnumber="52" sid="PSA 89:53" /> ברוך ה׳ אײביק,</para>
  <para style="q" vid="PSA 89:53">אָמן און אָמן!<verse eid="PSA 89:53" /></para>
  <chapter eid="PSA 89" />
  <chapter number="90" style="c" pubnumber="צ" sid="PSA 90" />
  <para style="ms">פֿירטער סֵפֿר</para>
  <para style="d">
    <verse number="1" style="v" sid="PSA 90:1" />אַ תּפֿילה פֿון משה דעם מאַן פֿון ג-ט.</para>
  <para style="q" vid="PSA 90:1">
    <char style="va">1</char> אֲדֹנָי, דו ביסט אונדז געװען באַשיצונג אין אַלע דורות.<verse eid="PSA 90:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 90:2" />אײדער די בערג זײַנען געבאָרן געװאָרן,</para>
  <para style="q" vid="PSA 90:2">און דו האָסט באַשאַפֿן די ערד און די װעלט,</para>
  <para style="q" vid="PSA 90:2">און פֿון אײביקײט ביז אײביקײט,</para>
  <para style="q" vid="PSA 90:2">ביסט דו אֵל.<verse eid="PSA 90:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 90:3" />ברענגסט דעם מענטשן ביז דערשלאָגנקײט,</para>
  <para style="q" vid="PSA 90:3">און זאָגסט: טוט תּשובֿה, איר מענטשנקינדער.<verse eid="PSA 90:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 90:4" />װאָרעם טױזנט יאָר איז אין דײַנע אױגן</para>
  <para style="q" vid="PSA 90:4">װי דער נעכטיקער טאָג, װען ער איז פֿאַרגאַנגען,</para>
  <para style="q" vid="PSA 90:4">און װי אַ װאַך אין דער נאַכט.<verse eid="PSA 90:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 90:5" />שטראָמסט זײ אַװעק,</para>
  <para style="q" vid="PSA 90:5">װי אַ דרעמל װערן זײ;</para>
  <para style="q" vid="PSA 90:5">אין פֿרימאָרגן װי גראָז געװאַקסן,<verse eid="PSA 90:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 90:6" />אין פֿרימאָרגן געבליט און געװאַקסן –</para>
  <para style="q" vid="PSA 90:6">צום אָװנט אָפּגעשניטן און פֿאַרדאַרט.<verse eid="PSA 90:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 90:7" />װאָרעם מיר װערן פֿאַרלענדט אין דײַן כּעס,</para>
  <para style="q" vid="PSA 90:7">און אין דײַן גרימצאָרן װערן מיר פֿאַרכאַפּט.<verse eid="PSA 90:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 90:8" />האַלטסט אונדזערע זינד אַנטקעגן דיר,</para>
  <para style="q" vid="PSA 90:8">אונדזערע פֿאַרבאָרגענישן פֿאַרן ליכט פֿון דײַן פּנים.<verse eid="PSA 90:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 90:9" />װאָרעם אַלע אונדזערע טעג פֿאַרגײען אין דײַן גרימצאָרן,</para>
  <para style="q" vid="PSA 90:9">מיר ענדיקן אונדזערע יאָרן אַזױ װי אַ הױך.<verse eid="PSA 90:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 90:10" />די טעג פֿון אונדזערע יאָרן, זײ זײַנען זיבעציק יאָר,</para>
  <para style="q" vid="PSA 90:10">און אַז אין גבֿורה, איז אַכציק יאָר;</para>
  <para style="q" vid="PSA 90:10">און זײער שטאָלץ איז מאַטערניש און אומגליק;</para>
  <para style="q" vid="PSA 90:10">װאָרעם גיך פֿאַרגײט עס, און מיר פֿליִען אַװעק.<verse eid="PSA 90:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 90:11" />װער פֿאַרשטײט די מאַכט פֿון דײַן כּעס,</para>
  <para style="q" vid="PSA 90:11">אַז װי דײַן מוֹראדיקײט אַזױ איז דײַן גרימצאָרן?<verse eid="PSA 90:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 90:12" />לערן אונדז ריכטיק צו צײלן אונדזערע טעג,</para>
  <para style="q" vid="PSA 90:12">כּדי מיר זאָלן קריגן אַ האַרץ פֿון חכמה.<verse eid="PSA 90:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 90:13" />קער זיך אום, ה׳ – װי לאַנג נאָך? –</para>
  <para style="q" vid="PSA 90:13">און דערבאַרים זיך אױף דײַנע קנעכט.<verse eid="PSA 90:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 90:14" />זעטיק אונדז אין פֿרימאָרגן מיט דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 90:14">כּדי מיר זאָלן זינגען און זײַן פֿרײלעך אין אַלע אונדזערע טעג.<verse eid="PSA 90:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 90:15" />דערפֿרײ אונדז װי די טעג װאָס דו האָסט אונדז געפּײַניקט,</para>
  <para style="q" vid="PSA 90:15">די יאָרן װאָס מיר האָבן געזען בײז.<verse eid="PSA 90:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 90:16" />זאָל באַװיזן װערן דײַן טוּונג צו דײַנע קנעכט,</para>
  <para style="q" vid="PSA 90:16">און דײַן פּראַכט אױף זײערע קינדער.<verse eid="PSA 90:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 90:17" />און זאָל די ליבלעכקײט פֿון אֲדֹנָי אלוקינו זײַן אױף אונדז;</para>
  <para style="q" vid="PSA 90:17">און באַפֿעסטיק פֿאַר אונדז דאָס װערק פֿון אונדזערע הענט,</para>
  <para style="q" vid="PSA 90:17">יאָ, דאָס װערק פֿון אונדזערע הענט, באַפֿעסטיק עס.<verse eid="PSA 90:17" /></para>
  <chapter eid="PSA 90" />
  <chapter number="91" style="c" pubnumber="צא" sid="PSA 91" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 91:1" />דו װאָס זיצסט אין דער פֿאַרבאָרגעניש פֿון עליון,</para>
  <para style="q" vid="PSA 91:1">װאָס אין שאָטן פֿון שַדַי װײַלסטו,<verse eid="PSA 91:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 91:2" />איך זאָג אױף ה׳, מײַן באַשיצונג און מײַן פֿעסטונג</para>
  <para style="q" vid="PSA 91:2">מײַן ג-ט װאָס איך פֿאַרזיכער זיך אױף אים,<verse eid="PSA 91:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 91:3" />אַז ער װעט דיך מציל זײַן פֿון פֿױגלפֿאַנגערס נעץ,</para>
  <para style="q" vid="PSA 91:3">פֿון דער פּעסט פֿון פֿאַרטיליקונג.<verse eid="PSA 91:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 91:4" />מיט זײַן פֿלעדער װעט ער דיך באַשירעמען,</para>
  <para style="q" vid="PSA 91:4">און אונטער זײַנע פֿליגלען װעסטו זיך שיצן;</para>
  <para style="q" vid="PSA 91:4">אַ שילד און אַ שילד איז זײַן טרײַשאַפֿט.<verse eid="PSA 91:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 91:5" />װעסט נישט מורא האָבן פֿאַר אַ שרעק פֿון דער נאַכט,</para>
  <para style="q" vid="PSA 91:5">פֿאַר אַ פֿײַל װאָס פֿליט בײַ טאָג;<verse eid="PSA 91:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 91:6" />פֿאַר אַ פּעסט װאָס גײט אום אין דער פֿינצטער,</para>
  <para style="q" vid="PSA 91:6">פֿאַר אַ מגפֿה װאָס פֿאַרװיסט אין מיטן טאָג.<verse eid="PSA 91:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 91:7" />דיר פֿון זײַט װעלן פֿאַלן טױזנט,</para>
  <para style="q" vid="PSA 91:7">און צען טױזנט פֿון דײַן רעכטער האַנט,</para>
  <para style="q" vid="PSA 91:7">צו דיר װעט עס נישט גענענען.<verse eid="PSA 91:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 91:8" />בלױז מיט דײַנע אױגן װעסטו אָנקוקן,</para>
  <para style="q" vid="PSA 91:8">און די באַצאָלונג פֿון די רשעים װעסטו זען.<verse eid="PSA 91:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 91:9" />װײַל דו האָסט געזאָגט: ה׳ איז מײַן באַשיצונג,</para>
  <para style="q" vid="PSA 91:9">געמאַכט דעם עליון פֿאַר דײַן באַשירעמונג.<verse eid="PSA 91:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 91:10" />דיך װעט נישט טרעפֿן קײן בײז,</para>
  <para style="q" vid="PSA 91:10">און קײן פּלאָג װעט נישט גענענען צו דײַן געצעלט.<verse eid="PSA 91:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 91:11" />װאָרעם זײַנע מלאָכים װעט ער באַפֿעלן װעגן דיר,</para>
  <para style="q" vid="PSA 91:11">דיך צו היטן אין אַלע דײַנע װעגן.<verse eid="PSA 91:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 91:12" />אױף די הענט װעלן זײ דיך טראָגן,</para>
  <para style="q" vid="PSA 91:12">טאָמער װעסטו אָפּשלאָגן אָן אַ שטײן דײַן פֿוס.<verse eid="PSA 91:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 91:13" />אױף לײבן און פּיפּערנאָטערס װעסטו שפּרײַזן,</para>
  <para style="q" vid="PSA 91:13">װעסט צעטרעטן יונגלײבן און שלאַנג.<verse eid="PSA 91:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 91:14" />װײַל ער האָט געגלוסט צו מיר, װעל איך אים מאַכן אַנטרינען;</para>
  <para style="q" vid="PSA 91:14">איך װעל אים דערהײכן, װײַל ער קען מײַן נאָמען.<verse eid="PSA 91:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 91:15" />ער װעט מיך רופֿן, און איך װעל אים ענטפֿערן,</para>
  <para style="q" vid="PSA 91:15">איך װעל זײַן מיט אים אין אַ צרה,</para>
  <para style="q" vid="PSA 91:15">איך װעל אים דערלײזן, און אים ברענגען צו כּבֿוד.<verse eid="PSA 91:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 91:16" />מיט לאַנגע יאָרן װעל איך אים זעטן,</para>
  <para style="q" vid="PSA 91:16">און װעל אים װײַזן מײַן הילף.<verse eid="PSA 91:16" /></para>
  <chapter eid="PSA 91" />
  <chapter number="92" style="c" pubnumber="צב" sid="PSA 92" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 92:1" />אַ מיזמור; אַ געזאַנג פֿאַר דעם טאָג פֿון שבת.<verse eid="PSA 92:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 92:2" /> גוט איז צו לױבן ה׳,</para>
  <para style="q" vid="PSA 92:2">און זינגען צו דײַן נאָמען, דו עליון;<verse eid="PSA 92:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 92:3" /> צו דערצײלן אין פֿרימאָרגן דײַן חֶסֶד</para>
  <para style="q" vid="PSA 92:3">און דײַן טרײַשאַפֿט אין די נעכט,<verse eid="PSA 92:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 92:4" /> אױף אַ צענסטרונע און אױף אַ גיטאַר,</para>
  <para style="q" vid="PSA 92:4">מיט פֿאַרטראַכטונג אױף דער האַרף.<verse eid="PSA 92:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 92:5" /> װאָרעם האָסט מיך דערפֿרײט, ה׳, מיט דײַן װערק,</para>
  <para style="q" vid="PSA 92:5">איך זינג װעגן די מעשׂים פֿון דײַנע הענט.<verse eid="PSA 92:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 92:6" /> װי גרױס זײַנען דײַנע מעשׂים, ה׳!</para>
  <para style="q" vid="PSA 92:6">טיף ביז גאָר זײַנען דײַנע טראַכטונגען.<verse eid="PSA 92:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 92:7" /> דער בהֵמישער מענטש װײס נישט,</para>
  <para style="q" vid="PSA 92:7">און דער נאַר פֿאַרשטײט דאָס נישט.<verse eid="PSA 92:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 92:8" /> אַז די רשעים שפּראָצן װי גראָז,</para>
  <para style="q" vid="PSA 92:8">און עס בליִען אַלע טוער פֿון אומרעכט,</para>
  <para style="q" vid="PSA 92:8">איז דאָס כּדאי זײ זאָלן פֿאַרטיליקט װערן אױף אײביק.<verse eid="PSA 92:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 92:9" /> אָבער דו ביסט דערהױבן אױף אײביק, ה׳.<verse eid="PSA 92:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 92:10" /> װאָרעם אָט דײַנע פֿײַנט, ה׳,</para>
  <para style="q" vid="PSA 92:10">װאָרעם אָט דײַנע פֿײַנט װעלן אונטערגײן,</para>
  <para style="q" vid="PSA 92:10">צעשפּרײט װעלן װערן אַלע טוער פֿון אומרעכט.<verse eid="PSA 92:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 92:11" /> און האָסט דערהײכט װי בײַ אַ װיזלטיר מײַן האָרן;</para>
  <para style="q" vid="PSA 92:11">איך האָב מיך באַזאַלבט מיט פֿרישן אײל.<verse eid="PSA 92:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 92:12" /> און מײַן אױג האָט זיך אָנגעזען אױף מײַנע לױערער;</para>
  <para style="q" vid="PSA 92:12">אױף די שלעכטסטוער װאָס שטײען אָן אױף מיר,</para>
  <para style="q" vid="PSA 92:12">הערן מײַנע אױערן זיך אָן.<verse eid="PSA 92:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 92:13" /> דער צדיק װעט בליִען װי אַ טײטלבױם,</para>
  <para style="q" vid="PSA 92:13">װי אַ צעדערבױם אין לבֿנוֹן װעט ער װאַקסן.<verse eid="PSA 92:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 92:14" /> אײַנגעפֿלאַנצט אין הױז פֿון ה׳,</para>
  <para style="q" vid="PSA 92:14">אין די הױפֿן פֿון אלוקינו װעלן זײ בליִען.<verse eid="PSA 92:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 92:15" /> זײ װעלן נאָך שפּראָצן אין גראָער עלטער,</para>
  <para style="q" vid="PSA 92:15">פֿעט און זאַפֿטיק װעלן זײ זײַן;<verse eid="PSA 92:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 92:16" /> צו דערצײלן אַז ה׳ איז רעכטפֿאַרטיק,</para>
  <para style="q" vid="PSA 92:16">מײַן פֿעלדז װאָס קײן אומרעכט איז אין אים נישטאָ.<verse eid="PSA 92:16" /></para>
  <chapter eid="PSA 92" />
  <chapter number="93" style="c" pubnumber="צג" sid="PSA 93" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 93:1" />ה׳ טוט קיניגן;</para>
  <para style="q" vid="PSA 93:1">ער האָט זיך מיט גרױסקײט באַקלײדט;</para>
  <para style="q" vid="PSA 93:1">ה׳ האָט זיך אָנגעקלײדט,</para>
  <para style="q" vid="PSA 93:1">מיט שטאַרקײט זיך אָנגעגורט;</para>
  <para style="q" vid="PSA 93:1">אױך איז באַפֿעסטיקט די װעלט,</para>
  <para style="q" vid="PSA 93:1">זי זאָל זיך נישט װאַקלען.<verse eid="PSA 93:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 93:2" />פֿעסט שטײט דײַן טראָן פֿון אַ מאָל,</para>
  <para style="q" vid="PSA 93:2">פֿון אײביק אָן ביסטו.<verse eid="PSA 93:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 93:3" />די טײַכן, ה׳, האָבן אױפֿגעהױבן,</para>
  <para style="q" vid="PSA 93:3">די טײַכן האָבן אױפֿגעהױבן זײער קֹול;</para>
  <para style="q" vid="PSA 93:3">די טײַכן הײבן אױף זײער גערױש.<verse eid="PSA 93:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 93:4" />מער פֿון די קוֹלות פֿון װאַסערן גרױסע,</para>
  <para style="q" vid="PSA 93:4">פֿון מאַכטיקע אינדן פֿון ים,</para>
  <para style="q" vid="PSA 93:4">איז מאַכטיק ה׳ אין דער הײך.<verse eid="PSA 93:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 93:5" />דײַנע צײגנים זײַנען זיכער ביז גאָר;</para>
  <para style="q" vid="PSA 93:5">פֿאַר דײַן הױז פּאַסט זיך הײליקײט, ה׳,</para>
  <para style="q" vid="PSA 93:5">אױף אײביקע טעג.<verse eid="PSA 93:5" /></para>
  <chapter eid="PSA 93" />
  <chapter number="94" style="c" pubnumber="צד" sid="PSA 94" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 94:1" />ה׳ דו אֵל פֿון נקמות,</para>
  <para style="q" vid="PSA 94:1">ה׳ פֿון נקמות, שײַן אַרױס!<verse eid="PSA 94:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 94:2" />דערהײב זיך, דו ריכטער פֿון דער ערד,</para>
  <para style="q" vid="PSA 94:2">קער אום פֿאַרגעלטונג צו די שטאָלצע.<verse eid="PSA 94:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 94:3" />ביז װאַנען װעלן די רשעים, ה׳,</para>
  <para style="q" vid="PSA 94:3">ביז װאַנען װעלן די רשעים זיך פֿרײען?<verse eid="PSA 94:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 94:4" />זײ גאַװערן, זײ רעדן פֿאַרשײַט,</para>
  <para style="q" vid="PSA 94:4">זײ רימען זיך, אַלע טוער פֿון אומרעכט.<verse eid="PSA 94:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 94:5" />דײַן פֿאָלק, ה׳, צעדריקן זײ,</para>
  <para style="q" vid="PSA 94:5">און זײ פּײַניקן דײַן אַרב.<verse eid="PSA 94:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 94:6" />די אַלמנה און דעם פֿרעמדן הרגען זײ,</para>
  <para style="q" vid="PSA 94:6">און יתומים טײטן זײ.<verse eid="PSA 94:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 94:7" />און זײ זאָגן: ה׳ װעט נישט זען,</para>
  <para style="q" vid="PSA 94:7">און דער אלוקי יעקבֿ װעט נישט מערקן.<verse eid="PSA 94:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 94:8" />באַטראַכט, איר פֿאַרגרעבטע אין פֿאָלק,</para>
  <para style="q" vid="PSA 94:8">און איר נאַרן, װען װעט איר קלוג װערן?<verse eid="PSA 94:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 94:9" />דער װאָס פֿלאַנצט דאָס אױער, צי װעט ער נישט הערן?</para>
  <para style="q" vid="PSA 94:9">דער װאָס פֿורעמט דאָס אױג, צי װעט ער נישט זען?<verse eid="PSA 94:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 94:10" />דער װאָס װאָרנט די פֿעלקער, צי װעט ער נישט שטראָפֿן?</para>
  <para style="q" vid="PSA 94:10">ער װאָס לערנט דעם מענטשן װיסן.<verse eid="PSA 94:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 94:11" />ה׳ װײס די מחשבֿות פֿון דעם מענטשן,</para>
  <para style="q" vid="PSA 94:11">אַז זײ זײַנען נישטיק.<verse eid="PSA 94:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 94:12" />װױל איז דעם מאַן װאָס ה׳ שטראָפֿט,</para>
  <para style="q" vid="PSA 94:12">און פֿון דײַן תּורה טוסטו אים לערנען;<verse eid="PSA 94:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 94:13" />כּדי אים צו באַרוען אין טעג פֿון בײז,</para>
  <para style="q" vid="PSA 94:13">ביז אַ גרוב װעט געגראָבן װערן פֿאַרן רשע.<verse eid="PSA 94:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 94:14" />װאָרעם ה׳ װעט נישט אַװעקװאַרפֿן זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 94:14">און זײַן אַרב נישט פֿאַרלאָזן.<verse eid="PSA 94:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 94:15" />װאָרעם צום גערעכטן װעט זיך אומקערן דאָס רעכט,</para>
  <para style="q" vid="PSA 94:15">און נאָך אים װעלן גײן אַלע רעכטפֿאַרטיקע הערצער.<verse eid="PSA 94:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 94:16" />װער װעט אױפֿשטײן פֿאַר מיר אַקעגן די שלעכטסטוער?</para>
  <para style="q" vid="PSA 94:16">װער װעט זיך שטעלן פֿאַר מיר אַקעגן די טוער פֿון אומרעכט?<verse eid="PSA 94:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 94:17" />װען נישט ה׳ װאָלט מיר אַ הילף געװען,</para>
  <para style="q" vid="PSA 94:17">װאָלט שיר גערוט אין שטילן קבֿר מײַן זעל.<verse eid="PSA 94:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 94:18" />װען איך זאָג: מײַן פֿוס גליטשט זיך אױס,</para>
  <para style="q" vid="PSA 94:18">לענט מיך אונטער, ה׳, דײַן חֶסֶד.<verse eid="PSA 94:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 94:19" />בײַ מײַנע פֿיל זאָרגענישן אין מיר,</para>
  <para style="q" vid="PSA 94:19">קװיקן דײַנע טרײסטונגען מײַן זעל.<verse eid="PSA 94:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 94:20" />קען זיך חבֿרן צו דיר דער טראָן פֿון פֿאַרברעכן,</para>
  <para style="q" vid="PSA 94:20">װאָס פֿורעמט אומגליק דורך געזעץ?<verse eid="PSA 94:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 94:21" />זײ קלײַבן זיך אױף דעם נפֿש פֿון צדיק,</para>
  <para style="q" vid="PSA 94:21">און אומשולדיק בלוט פֿאַרמשפּטן זײ.<verse eid="PSA 94:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 94:22" />אָבער ה׳ איז מיר געװען פֿאַר אַ פֿעסטונג,</para>
  <para style="q" vid="PSA 94:22">און מײַן ג-ט צום פֿעלדז פֿון מײַן באַשיצונג.<verse eid="PSA 94:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 94:23" />און ער האָט אומגעקערט אױף זײ זײער אומרעכט,</para>
  <para style="q" vid="PSA 94:23">און דורך זײער בײז טוט ער זײ פֿאַרשנײַדן;</para>
  <para style="q" vid="PSA 94:23">פֿאַרשנײַדן טוט זײ ה׳ אלוקינו.<verse eid="PSA 94:23" /></para>
  <chapter eid="PSA 94" />
  <chapter number="95" style="c" pubnumber="צה" sid="PSA 95" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 95:1" />קומט, לאָמיר זינגען צו ה׳,</para>
  <para style="q" vid="PSA 95:1">לאָמיר שאַלן צום פֿעלדז פֿון אונדזער הילף.<verse eid="PSA 95:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 95:2" />לאָמיר קומען פֿאַר זײַן פּנים מיט דאַנק,</para>
  <para style="q" vid="PSA 95:2">מיט געזאַנגען לאָמיר שאַלן צו אים.<verse eid="PSA 95:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 95:3" />װאָרעם אַ גרױסער אֵל איז ה׳,</para>
  <para style="q" vid="PSA 95:3">און אַ גרױסער מלך איבער אַלע ג‑טער,<verse eid="PSA 95:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 95:4" />װאָס אין זײַן האַנט זײַנען די גרונטן פֿון דער ערד,</para>
  <para style="q" vid="PSA 95:4">און די הײכן פֿון די בערג זײַנען זײַנע;<verse eid="PSA 95:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 95:5" />װאָס דער ים איז זײַנער, און ער האָט אים געמאַכט;</para>
  <para style="q" vid="PSA 95:5">און די יבשה האָבן געפֿורעמט זײַנע הענט.<verse eid="PSA 95:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 95:6" />קומט, לאָמיר זיך בוקן און בײגן,</para>
  <para style="q" vid="PSA 95:6">לאָמיר קניִען פֿאַר ה׳ אונדזער באַשעפֿער.<verse eid="PSA 95:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 95:7" />װאָרעם ער איז אלוקינו,</para>
  <para style="q" vid="PSA 95:7">און מיר דאָס פֿאָלק פֿון זײַן פֿיטערונג,</para>
  <para style="q" vid="PSA 95:7">און די שאָף פֿון זײַן האַנט;</para>
  <para style="q" vid="PSA 95:7">װען איר װאָלט הײַנט צוהערן צו זײַן קֹול!<verse eid="PSA 95:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 95:8" />מאַכט נישט האַרט אײַער האַרץ װי בײַ מריבֿה,</para>
  <para style="q" vid="PSA 95:8">װי אין טאָג פֿון מַסָה אין דער מדבר,<verse eid="PSA 95:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 95:9" />בעת אײַערע עלטערן האָבן מיך געפּרוּװט,</para>
  <para style="q" vid="PSA 95:9">מיך פּראָבירט, הגם זײ האָבן געזען מײַן װערק.<verse eid="PSA 95:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 95:10" />פֿערציק יאָר האָב איך מיך געעקלט מיטן דור,</para>
  <para style="q" vid="PSA 95:10">און האָב געזאָגט: אַ פֿאָלק מיט פֿאַרפֿירטע הערצער זײַנען זײ,</para>
  <para style="q" vid="PSA 95:10">און זײ װײסן נישט מײַנע װעגן;<verse eid="PSA 95:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 95:11" />װאָס דערום האָב איך געשװאָרן אין מײַן צאָרן,</para>
  <para style="q" vid="PSA 95:11">אױב זײ װעלן קומען אין מײַן רוּונג!<verse eid="PSA 95:11" /></para>
  <chapter eid="PSA 95" />
  <chapter number="96" style="c" pubnumber="צו" sid="PSA 96" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 96:1" />זינגט צו ה׳ אַ נײַ געזאַנג,</para>
  <para style="q" vid="PSA 96:1">זינגט צו ה׳, די גאַנצע ערד.<verse eid="PSA 96:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 96:2" />זינגט צו ה׳, בענטשט זײַן נאָמען,</para>
  <para style="q" vid="PSA 96:2">זײט מבֿשׂר פֿון טאָג צו טאָג זײַן ישועה.<verse eid="PSA 96:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 96:3" />דערצײלט צװישן די פֿעלקער זײַן כּבֿוד,</para>
  <para style="q" vid="PSA 96:3">צװישן אַלע אומות זײַנע װוּנדער.<verse eid="PSA 96:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 96:4" />װאָרעם גרױס איז ה׳, און זײער געלױבט,</para>
  <para style="q" vid="PSA 96:4">ער איז פֿאָרכטיק איבער אַלע ג‑טער;<verse eid="PSA 96:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 96:5" />װאָרעם די ג‑טער פֿון אַלע פֿעלקער זײַנען נישטיק,</para>
  <para style="q" vid="PSA 96:5">און ה׳ האָט די הימלען געמאַכט.<verse eid="PSA 96:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 96:6" />גלאַנץ און שײנקײט זײַנען פֿאַר זײַן פּנים,</para>
  <para style="q" vid="PSA 96:6">שטאַרקײט און פּראַכט אין זײַן מִקדָש.<verse eid="PSA 96:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 96:7" />גיט צו ה׳, איר משפּחות פֿון די פֿעלקער,</para>
  <para style="q" vid="PSA 96:7">גיט צו ה׳ כּבֿוד און שטאַרקײט.<verse eid="PSA 96:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 96:8" />גיט צו ה׳ דעם כּבֿוד פֿון זײַן נאָמען,</para>
  <para style="q" vid="PSA 96:8">ברענגט אַ מִנְחָה, און קומט אין זײַנע הױפֿן.<verse eid="PSA 96:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 96:9" />בוקט זיך צו ה׳ מיט הײליקן אָפּשײַ,</para>
  <para style="q" vid="PSA 96:9">ציטערט פֿאַר אים, די גאַנצע ערד.<verse eid="PSA 96:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 96:10" />זאָגט צװישן די פֿעלקער: ה׳ טוט קיניגן;</para>
  <para style="q" vid="PSA 96:10">אױך איז באַפֿעסטיקט די װעלט, זי זאָל זיך נישט װאַקלען,</para>
  <para style="q" vid="PSA 96:10">ער װעט משפּטן די פֿעלקער מיט יושר.<verse eid="PSA 96:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 96:11" />זאָלן זיך פֿרײען די הימלען, און זאָל לוסטיק זײַן די ערד,</para>
  <para style="q" vid="PSA 96:11">זאָל דונערן דער ים מיט זײַן פֿולקײט.<verse eid="PSA 96:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 96:12" />זאָל פֿרײלעך זײַן דאָס פֿעלד און אַלץ װאָס דערין;</para>
  <para style="q" vid="PSA 96:12">דענצמאָל זאָלן זינגען אַלע בײמער פֿון װאַלד;<verse eid="PSA 96:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 96:13" />פֿאַר ה׳, װאָרעם ער קומט,</para>
  <para style="q" vid="PSA 96:13">װאָרעם ער קומט משפּטן די ערד;</para>
  <para style="q" vid="PSA 96:13">ער װעט משפּטן די װעלט מיט גערעכטיקײט,</para>
  <para style="q" vid="PSA 96:13">און די פֿעלקער מיט זײַן װאָרהאַפֿטיקײט.<verse eid="PSA 96:13" /></para>
  <chapter eid="PSA 96" />
  <chapter number="97" style="c" pubnumber="צז" sid="PSA 97" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 97:1" />ה׳ טוט קיניגן, זאָל לוסטיק זײַן די ערד,</para>
  <para style="q" vid="PSA 97:1">זאָלן זיך פֿרײען די פֿיל אינדזלען.<verse eid="PSA 97:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 97:2" />װאָלקן און נעבל זײַנען אַרום אים,</para>
  <para style="q" vid="PSA 97:2">רעכט און גערעכטיקײט דאָס געשטעל פֿון זײַן טראָן.<verse eid="PSA 97:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 97:3" />אַ פֿײַער גײט אים פֿאַרױס,</para>
  <para style="q" vid="PSA 97:3">און פֿאַרברענט רונד אַרום זײַנע פֿײַנט.<verse eid="PSA 97:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 97:4" />זײַנע בליצן באַלײַכטן די װעלט;</para>
  <para style="q" vid="PSA 97:4">עס זעט די ערד, און זי ציטערט.<verse eid="PSA 97:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 97:5" />די בערג צעגײען װי װאַקס פֿאַר ה׳,</para>
  <para style="q" vid="PSA 97:5">פֿאַר דעם האַר פֿון דער גאַנצער ערד.<verse eid="PSA 97:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 97:6" />די הימלען דערצײלן זײַן גערעכטיקײט,</para>
  <para style="q" vid="PSA 97:6">און אַלע פֿעלקער זעען זײַן כּבֿוד.<verse eid="PSA 97:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 97:7" />צו שאַנד װערן אַלע געצנדינער,</para>
  <para style="q" vid="PSA 97:7">װאָס רימען זיך מיט נישטיקײטן;</para>
  <para style="q" vid="PSA 97:7">עס בוקן זיך צו אים אַלע ג‑טער.<verse eid="PSA 97:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 97:8" />צִיוֹן הערט און זי פֿרײט זיך,</para>
  <para style="q" vid="PSA 97:8">און לוסטיק זײַנען די טעכטערשטעט פֿון יהוּדה,</para>
  <para style="q" vid="PSA 97:8">פֿון װעגן דײַנע משפּטים, ה׳.<verse eid="PSA 97:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 97:9" />װאָרעם דו ה׳ ביסט דער עליון איבער דער גאַנצער ערד,</para>
  <para style="q" vid="PSA 97:9">הױך דערהױבן איבער אַלע ג‑טער.<verse eid="PSA 97:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 97:10" />איר ליבהאָבער פֿון ה׳, האָט פֿײַנט שלעכטס!</para>
  <para style="q" vid="PSA 97:10">ער היט די נפֿשות פֿון זײַנע פֿרומע,</para>
  <para style="q" vid="PSA 97:10">פֿון דער האַנט פֿון רשעים איז ער זײ מציל.<verse eid="PSA 97:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 97:11" />אַ ליכט איז פֿאַרזײט פֿאַרן צדיק,</para>
  <para style="q" vid="PSA 97:11">און פֿאַר די רעכטפֿאַרטיקע הערצער אַ פֿרײד.<verse eid="PSA 97:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 97:12" />פֿרײט זיך, איר צדיקים, מיט ה׳,</para>
  <para style="q" vid="PSA 97:12">און דאַנקט זײַן הײליקער געדעכעניש.<verse eid="PSA 97:12" /></para>
  <chapter eid="PSA 97" />
  <chapter number="98" style="c" pubnumber="צח" sid="PSA 98" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 98:1" />אַ מיזמור.</para>
  <para style="q" vid="PSA 98:1">
    <char style="va">1</char> זינגט צו ה׳ אַ נײַ געזאַנג,</para>
  <para style="q" vid="PSA 98:1">װאָרעם װוּנדער האָט ער געטאָן;</para>
  <para style="q" vid="PSA 98:1">זײַן רעכטע האַנט האָט אים געהאָלפֿן,</para>
  <para style="q" vid="PSA 98:1">און זײַן הײליקער אָרעם.<verse eid="PSA 98:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 98:2" />ה׳ האָט געלאָזט װיסן זײַן ישועה,</para>
  <para style="q" vid="PSA 98:2">פֿאַר די אױגן פֿון פֿעלקער</para>
  <para style="q" vid="PSA 98:2">האָט ער אַנטפּלעקט זײַן גערעכטיקײט.<verse eid="PSA 98:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 98:3" />ער האָט געדאַכט אָן זײַן חֶסֶד</para>
  <para style="q" vid="PSA 98:3">און זײַן טרײַשאַפֿט צו דעם הױז פֿון יִשׂרָאֵל;</para>
  <para style="q" vid="PSA 98:3">אַלע עקן פֿון דער ערד האָבן געזען</para>
  <para style="q" vid="PSA 98:3">די ישועה פֿון אלוקינו.<verse eid="PSA 98:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 98:4" />שאַלט צו ה׳, די גאַנצע ערד,</para>
  <para style="q" vid="PSA 98:4">ברעכט אױס און זינגט און שפּילט.<verse eid="PSA 98:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 98:5" />שפּילט צו ה׳ אױף אַ האַרף,</para>
  <para style="q" vid="PSA 98:5">אױף אַ האַרף מיט אַ קֹול פֿון געזאַנג.<verse eid="PSA 98:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 98:6" />מיט טרומײטן און אַ קֹול פֿון שופֿר</para>
  <para style="q" vid="PSA 98:6">שאַלט פֿאַר ה׳ דעם מלך.<verse eid="PSA 98:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 98:7" />זאָל דונערן דער ים מיט זײַן פֿולקײט,</para>
  <para style="q" vid="PSA 98:7">די װעלט און די װױנער אין איר.<verse eid="PSA 98:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 98:8" />די טײַכן זאָלן קלאַפּן די הענט,</para>
  <para style="q" vid="PSA 98:8">די בערג זאָלן זינגען אין אײנעם;<verse eid="PSA 98:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 98:9" />פֿאַר ה׳, װאָרעם ער קומט משפּטן די ערד;</para>
  <para style="q" vid="PSA 98:9">ער װעט משפּטן די װעלט מיט גערעכטיקײט,</para>
  <para style="q" vid="PSA 98:9">און די פֿעלקער מיט יושר.<verse eid="PSA 98:9" /></para>
  <chapter eid="PSA 98" />
  <chapter number="99" style="c" pubnumber="צט" sid="PSA 99" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 99:1" />ה׳ טוט קיניגן,</para>
  <para style="q" vid="PSA 99:1">זאָלן ציטערן די פֿעלקער;</para>
  <para style="q" vid="PSA 99:1">ער טראָנט איבער די כּרובֿים,</para>
  <para style="q" vid="PSA 99:1">זאָל זיך װאַקלען די ערד.<verse eid="PSA 99:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 99:2" />ה׳ איז גרױס אין צִיוֹן,</para>
  <para style="q" vid="PSA 99:2">און ער איז דערהױבן איבער אַלע פֿעלקער.<verse eid="PSA 99:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 99:3" />זאָלן זײ לױבן דײַן גרױסן און פֿאָרכטיקן נאָמען</para>
  <para style="q" vid="PSA 99:3">– הײליק איז ער! –<verse eid="PSA 99:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 99:4" />און די שטאַרקײט פֿון דעם מלך װאָס האָט ליב גערעכטיקײט.</para>
  <para style="q" vid="PSA 99:4">דו האָסט אױפֿגעשטעלט יושר,</para>
  <para style="q" vid="PSA 99:4">רעכט און גערעכטיקײט האָסטו אין יעקבֿ געטאָן.<verse eid="PSA 99:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 99:5" />דערהײבט ה׳ אלוקינו,</para>
  <para style="q" vid="PSA 99:5">און בוקט זיך צו זײַן פֿוסבענקל – הײליק איז ער!<verse eid="PSA 99:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 99:6" />משה און אַהרֹן זײַנען געװען צװישן זײַנע כּהנים,</para>
  <para style="q" vid="PSA 99:6">און שמוּאֵל צװישן די װאָס רופֿן זײַן נאָמען;</para>
  <para style="q" vid="PSA 99:6">זײ פֿלעגן רופֿן צו ה׳,</para>
  <para style="q" vid="PSA 99:6">און ער פֿלעגט זײ ענטפֿערן.<verse eid="PSA 99:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 99:7" />אין אַ װאָלקנזײַל פֿלעגט ער רעדן צו זײ;</para>
  <para style="q" vid="PSA 99:7">זײ האָבן געהיט זײַנע צײגנים,</para>
  <para style="q" vid="PSA 99:7">און דאָס געזעץ װאָס ער האָט זײ געגעבן.<verse eid="PSA 99:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 99:8" />ה׳ אלוקינו, דו האָסט זײ געענטפֿערט:</para>
  <para style="q" vid="PSA 99:8">אַ פֿאַרגעביקער אֵל ביסטו זײ געװען,</para>
  <para style="q" vid="PSA 99:8">און האָסט זיך נוקם געװען פֿון זײערע װעגן.<verse eid="PSA 99:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 99:9" />דערהײבט ה׳ אלוקינו,</para>
  <para style="q" vid="PSA 99:9">און בוקט זיך צו זײַן הײליקן באַרג,</para>
  <para style="q" vid="PSA 99:9">װאָרעם הײליק איז ה׳ אלוקינו.<verse eid="PSA 99:9" /></para>
  <chapter eid="PSA 99" />
  <chapter number="100" style="c" pubnumber="ק" sid="PSA 100" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 100:1" />אַ מיזמור פֿון דאַנקגעבונג.</para>
  <para style="q" vid="PSA 100:1">
    <char style="va">1</char> שאַלט צו ה׳, די גאַנצע ערד.<verse eid="PSA 100:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 100:2" />דינט ה׳ מיט שׂימחה,</para>
  <para style="q" vid="PSA 100:2">קומט פֿאַר אים מיט געזאַנג.<verse eid="PSA 100:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 100:3" />װײסט אַז ה׳, ער איז אלֹקים;</para>
  <para style="q" vid="PSA 100:3">ער האָט אונדז באַשאַפֿן, און זײַנע זײַנען מיר,</para>
  <para style="q" vid="PSA 100:3">זײַן פֿאָלק, און די שאָף פֿון זײַן פֿיטערונג.<verse eid="PSA 100:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 100:4" />קומט אין זײַנע טױערן מיט דאַנק,</para>
  <para style="q" vid="PSA 100:4">אין זײַנע הױפֿן מיט לױב;</para>
  <para style="q" vid="PSA 100:4">גיט אַ דאַנק צו אים, בענטשט זײַן נאָמען.<verse eid="PSA 100:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 100:5" />װאָרעם ה׳ איז גוט,</para>
  <para style="q" vid="PSA 100:5">אױף אײביק איז זײַן חֶסֶד,</para>
  <para style="q" vid="PSA 100:5">און ביז דור-דורות זײַן טרײַשאַפֿט.<verse eid="PSA 100:5" /></para>
  <chapter eid="PSA 100" />
  <chapter number="101" style="c" pubnumber="קא" sid="PSA 101" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 101:1" />אַ מיזמור פֿון דָוִדן.</para>
  <para style="q" vid="PSA 101:1">
    <char style="va">1</char> גענאָד און גערעכטיקײט װעל איך באַזינגען,</para>
  <para style="q" vid="PSA 101:1">צו דיר ה׳ װעל איך זינגען.<verse eid="PSA 101:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 101:2" />איך אַכט אױפֿן ערלעכן װעג;</para>
  <para style="q" vid="PSA 101:2">װען װעסטו קומען צו מיר?</para>
  <para style="q" vid="PSA 101:2">איך גײ אום אין מײַן הױז</para>
  <para style="q" vid="PSA 101:2">אין דער ערלעכקײט פֿון מײַן האַרצן.<verse eid="PSA 101:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 101:3" />איך האַלט נישט פֿאַר מײַנע אױגן</para>
  <para style="q" vid="PSA 101:3">אַ נידערטרעכטיקע זאַך;</para>
  <para style="q" vid="PSA 101:3">דאָס טאָן פֿון די אָפּקערערס האָב איך פֿײַנט,</para>
  <para style="q" vid="PSA 101:3">עס טוט זיך נישט באַהעפֿטן אָן מיר.<verse eid="PSA 101:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 101:4" />אַ קרום האַרץ איז אָפּגעטאָן פֿון מיר,</para>
  <para style="q" vid="PSA 101:4">פֿון שלעכטיקײט װײס איך נישט.<verse eid="PSA 101:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 101:5" />דער װאָס באַרעדט אין פֿאַרבאָרגעניש זײַן חבֿר,</para>
  <para style="q" vid="PSA 101:5">אים האַק איך אָפּ;</para>
  <para style="q" vid="PSA 101:5">דער װאָס האָט האָפֿערדיקע אױגן און אַ שטאָלץ האַרץ,</para>
  <para style="q" vid="PSA 101:5">אים קען איך נישט לײַדן.<verse eid="PSA 101:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 101:6" />מײַנע אױגן זײַנען אױף די געטרײַע פֿון לאַנד,</para>
  <para style="q" vid="PSA 101:6">זײ זאָלן זיצן מיט מיר;</para>
  <para style="q" vid="PSA 101:6">דער װאָס גײט אױפֿן װעג פֿון ערלעכקײט,</para>
  <para style="q" vid="PSA 101:6">ער איז אין מײַן דינסט.<verse eid="PSA 101:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 101:7" />אין מײַן הױז טאָר נישט זיצן</para>
  <para style="q" vid="PSA 101:7">דער װאָס באַגײט באַטרוג; דער װאָס רעדט ליגנס</para>
  <para style="q" vid="PSA 101:7">דער װאָס רעדט ליגנס</para>
  <para style="q" vid="PSA 101:7">קען נישט באַשטײן פֿאַר מײַנע אױגן.<verse eid="PSA 101:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 101:8" />אַלע פֿרימאָרגן פֿאַרשנײַד איך</para>
  <para style="q" vid="PSA 101:8">אַלע רשעים פֿון לאַנד,</para>
  <para style="q" vid="PSA 101:8">כּדי צו פֿאַרשנײַדן פֿון ה׳ס שטאָט</para>
  <para style="q" vid="PSA 101:8">אַלע טוער פֿון אומרעכט.<verse eid="PSA 101:8" /></para>
  <chapter eid="PSA 101" />
  <chapter number="102" style="c" pubnumber="קב" sid="PSA 102" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 102:1" />אַ תּפֿילה פֿאַר דעם געדריקטן װען ער פֿאַרגײט זיך, און ער גיסט אױס פֿאַר ה׳ זײַן קלאָג.<verse eid="PSA 102:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 102:2" /> ה׳, הער צו מײַן תּפֿילה,</para>
  <para style="q" vid="PSA 102:2">און מײַן געשרײ זאָל קומען צו דיר.<verse eid="PSA 102:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 102:3" /> זאָלסט נישט פֿאַרבאָרגן דײַן פּנים פֿון מיר,</para>
  <para style="q" vid="PSA 102:3">אין טאָג פֿון מײַן נױט נײַג דײַן אױער צו מיר,</para>
  <para style="q" vid="PSA 102:3">אין טאָג װאָס איך רוף, ענטפֿער מיר גיך.<verse eid="PSA 102:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 102:4" /> װאָרעם אַזױ װי רױך פֿאַרגײען מײַנע טעג,</para>
  <para style="q" vid="PSA 102:4">און מײַנע בײנער זײַנען װי אַן אױװן צעברענט.<verse eid="PSA 102:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 102:5" /> צעקלאַפּט װי גראָז און פֿאַרטריקנט איז מײַן האַרץ,</para>
  <para style="q" vid="PSA 102:5">װאָרעם איך פֿאַרגעס צו עסן מײַן ברױט.<verse eid="PSA 102:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 102:6" /> פֿון װעגן די קוֹלות פֿון מײַן קרעכצן</para>
  <para style="q" vid="PSA 102:6">איז מײַן געבײן צוגעקלעפּט צו מײַן הױט.<verse eid="PSA 102:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 102:7" /> איך בין געגליכן צו אַ פּעליקאַן פֿון מדבר,</para>
  <para style="q" vid="PSA 102:7">איך בין געװאָרן װי אַן אײַל פֿון די חורבֿות.<verse eid="PSA 102:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 102:8" /> איך בין װאַך נאָכאַנאַנד און בין געװאָרן</para>
  <para style="q" vid="PSA 102:8">װי אַן עלנדער פֿױגל אױף אַ דאַך.<verse eid="PSA 102:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 102:9" /> אַ גאַנצן טאָג לעסטערן מיך מײַנע פֿײַנט,</para>
  <para style="q" vid="PSA 102:9">די װאָס װילדעװען קעגן מיר, שילטן זיך מיט מיר.<verse eid="PSA 102:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 102:10" /> װאָרעם אַש האָב איך אַזױ װי ברױט געגעסן,</para>
  <para style="q" vid="PSA 102:10">און מײַנע געטראַנקען האָב איך מיט געװײן געמישט.<verse eid="PSA 102:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 102:11" /> פֿון װעגן דײַן כּעס און דײַן צאָרן;</para>
  <para style="q" vid="PSA 102:11">װאָרעם האָסט מיך אױפֿגעהױבן און מיך אַװעקגעשלײַדערט.<verse eid="PSA 102:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 102:12" /> מײַנע טעג זײַנען װי אַ שאָטן װאָס נײַגט זיך,</para>
  <para style="q" vid="PSA 102:12">און אַזױ װי גראָז טריקן איך אײַן.<verse eid="PSA 102:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 102:13" /> אָבער דו ה׳ טראָנסט אױף אײביק,</para>
  <para style="q" vid="PSA 102:13">און דײַן געדעכעניש איז אױף דור-דורות.<verse eid="PSA 102:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 102:14" /> דו װעסט אױפֿשטײן און זיך דערבאַרעמען אױף צִיוֹן,</para>
  <para style="q" vid="PSA 102:14">װאָרעם עס איז צײַט זי צו לײַטזעליקן,</para>
  <para style="q" vid="PSA 102:14">װאָרעם געקומען איז די שעה.<verse eid="PSA 102:14" /></para>
  <para style="q">
    <verse number="15" style="v" altnumber="14" sid="PSA 102:15" /> װאָרעם דײַנע קנעכט גאַרן נאָך אירע שטײנער,</para>
  <para style="q" vid="PSA 102:15">און איר שטױב האָבן זײ ליב.<verse eid="PSA 102:15" /></para>
  <para style="q">
    <verse number="16" style="v" altnumber="15" sid="PSA 102:16" /> און די פֿעלקער װעלן פֿאָרכטן דעם נאָמען פֿון ה׳,</para>
  <para style="q" vid="PSA 102:16">און אַלע מלכים פֿון דער ערד דײַן פּראַכט,<verse eid="PSA 102:16" /></para>
  <para style="q">
    <verse number="17" style="v" altnumber="16" sid="PSA 102:17" /> װען ה׳ האָט אױפֿגעבױט צִיוֹן,</para>
  <para style="q" vid="PSA 102:17">זיך באַװיזן אין זײַן פּראַכט;<verse eid="PSA 102:17" /></para>
  <para style="q">
    <verse number="18" style="v" altnumber="17" sid="PSA 102:18" /> זיך געקערט צו דער תּפֿילה פֿון דעם עלנדן,</para>
  <para style="q" vid="PSA 102:18">און נישט פֿאַראַכט זײער תּפֿילה.<verse eid="PSA 102:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" altnumber="18" sid="PSA 102:19" /> דאָס װעט פֿאַרשריבן װערן פֿאַרן שפּעטערדיקן דור,</para>
  <para style="q" vid="PSA 102:19">און דאָס פֿאָלק װאָס װעט באַשאַפֿן װערן, װעט לױבן ה׳.<verse eid="PSA 102:19" /></para>
  <para style="q">
    <verse number="20" style="v" altnumber="19" sid="PSA 102:20" /> װאָרעם ער האָט אַראָפּגעקוקט פֿון זײַן הײליקער הײך;</para>
  <para style="q" vid="PSA 102:20">ה׳ האָט פֿון הימל געלוגט אױף דער ערד,<verse eid="PSA 102:20" /></para>
  <para style="q">
    <verse number="21" style="v" altnumber="20" sid="PSA 102:21" /> צו הערן דאָס קרעכצן פֿון געפֿאַנגענעם,</para>
  <para style="q" vid="PSA 102:21">פֿרײַ צו מאַכן די אָנגעברײטע צום טױט.<verse eid="PSA 102:21" /></para>
  <para style="q">
    <verse number="22" style="v" altnumber="21" sid="PSA 102:22" /> כּדי מע זאָל דערצײלן אין צִיוֹן ה׳ס נאָמען,</para>
  <para style="q" vid="PSA 102:22">און זײַן לױב אין ירושָלַיִם,<verse eid="PSA 102:22" /></para>
  <para style="q">
    <verse number="23" style="v" altnumber="22" sid="PSA 102:23" /> װען די פֿעלקער זאַמלען זיך אײַן אין אײנעם,</para>
  <para style="q" vid="PSA 102:23">און די קיניגרײַכן צו דינען ה׳.<verse eid="PSA 102:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" altnumber="23" sid="PSA 102:24" /> ער האָט אָפּגעשלאַפֿט אין װעג מײַן כּוֹח,</para>
  <para style="q" vid="PSA 102:24">ער האָט געקירצט מײַנע טעג.<verse eid="PSA 102:24" /></para>
  <para style="q">
    <verse number="25" style="v" altnumber="24" sid="PSA 102:25" /> איך זאָג: מײַן ג-ט,</para>
  <para style="q" vid="PSA 102:25">זאָלסט מיך נישט אַװעקנעמען אין העלפֿט פֿון מײַנע טעג,</para>
  <para style="q" vid="PSA 102:25">דו װאָס אױף דור-דורות זײַנען דײַנע יאָרן.<verse eid="PSA 102:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" altnumber="25" sid="PSA 102:26" /> לאַנג צוריק האָסטו די ערד געגרונטפֿעסט,</para>
  <para style="q" vid="PSA 102:26">און דאָס װערק פֿון דײַנע הענט זײַנען די הימלען.<verse eid="PSA 102:26" /></para>
  <para style="q">
    <verse number="27" style="v" altnumber="26" sid="PSA 102:27" /> זײ װעלן אונטערגײן, און דו װעסט באַשטײן,</para>
  <para style="q" vid="PSA 102:27">יאָ, זײ אַלע װעלן װי אַ בגד צעקריכן,</para>
  <para style="q" vid="PSA 102:27">װי אַ מלבוש װעסטו זײ בײַטן, און זײ װעלן פֿאַרגײן;<verse eid="PSA 102:27" /></para>
  <para style="q">
    <verse number="28" style="v" altnumber="27" sid="PSA 102:28" /> אָבער דו ביסט דער אײגענער,</para>
  <para style="q" vid="PSA 102:28">און דײַנע יאָרן װעלן זיך נישט ענדיקן.<verse eid="PSA 102:28" /></para>
  <para style="q">
    <verse number="29" style="v" altnumber="28" sid="PSA 102:29" /> די קינדער פֿון דײַנע קנעכט װעלן בלײַבן,</para>
  <para style="q" vid="PSA 102:29">און זײער זאָמען װעט שטײן פֿעסט פֿאַר דיר.<verse eid="PSA 102:29" /></para>
  <chapter eid="PSA 102" />
  <chapter number="103" style="c" pubnumber="קג" sid="PSA 103" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 103:1" />פֿון דָוִדן.</para>
  <para style="q" vid="PSA 103:1">
    <char style="va">1</char> לױב, מײַן זעל, ה׳,</para>
  <para style="q" vid="PSA 103:1">און אַלע מײַנע אינגעװײד, זײַן הײליקן נאָמען.<verse eid="PSA 103:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 103:2" />לױב ה׳, מײַן זעל,</para>
  <para style="q" vid="PSA 103:2">און זאָלסט נישט פֿאַרגעסן אַלע זײַנע טובֿות;<verse eid="PSA 103:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 103:3" />דער װאָס פֿאַרגיט אַל די זינד דײַנע,</para>
  <para style="q" vid="PSA 103:3">װאָס הײלט אַלע קראַנקשאַפֿטן דײַנע;<verse eid="PSA 103:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 103:4" />װאָס לײזט אױס פֿון גרוב דײַן לעבן,</para>
  <para style="q" vid="PSA 103:4">װאָס קרײנט דיך מיט גענאָד און דערבאַרעמונג;<verse eid="PSA 103:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 103:5" />װאָס זעטיקט מיט גוטס דײַן עלטער,</para>
  <para style="q" vid="PSA 103:5">װי אַן אָדלער באַנײַט זיך די יוגנט דײַנע.<verse eid="PSA 103:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 103:6" />ה׳ טוט גערעכטיקײטן,</para>
  <para style="q" vid="PSA 103:6">און רעכט צו אַלע געדריקטע.<verse eid="PSA 103:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 103:7" />ער האָט געלאָזט װיסן משהן זײַנע װעגן,</para>
  <para style="q" vid="PSA 103:7">די קינדער פֿון יִשׂרָאֵל זײַנע מעשׂים.<verse eid="PSA 103:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 103:8" />ה׳ איז דערבאַרעמדיק און לײַטזעליק,</para>
  <para style="q" vid="PSA 103:8">אײַנגעהאַלטן אין צאָרן און רײַך אין גענאָד.<verse eid="PSA 103:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 103:9" />נישט שטענדיק װעט ער קריגן,</para>
  <para style="q" vid="PSA 103:9">און נישט אײביק װעט ער האַלטן אַ כּעס.<verse eid="PSA 103:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 103:10" />נישט לױט אונדזערע חטאָים האָט ער אונדז געטאָן,</para>
  <para style="q" vid="PSA 103:10">און נישט לױט אונדזערע זינד האָט ער אונדז פֿאַרגאָלטן.<verse eid="PSA 103:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 103:11" />װאָרעם װי דער הימל איז הױך איבער דער ערד,</para>
  <para style="q" vid="PSA 103:11">אַזױ איז שטאַרק זײַן חֶסֶד צו די װאָס פֿאָרכטן אים.<verse eid="PSA 103:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 103:12" />װי מזרח איז װײַט פֿון מערבֿ,</para>
  <para style="q" vid="PSA 103:12">אַזױ האָט ער דערװײַטערט פֿון אונדז אונדזערע פֿאַרברעכן.<verse eid="PSA 103:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 103:13" />װי אַ פֿאָטער דערבאַרעמט זיך אױף זײַנע קינדער,</para>
  <para style="q" vid="PSA 103:13">אַזױ דערבאַרעמט זיך ה׳ אױף די װאָס פֿאָרכטן אים.<verse eid="PSA 103:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 103:14" />װאָרעם ער װײס אונדזער באַשאַפֿונג,</para>
  <para style="q" vid="PSA 103:14">ער געדענקט אַז מיר זײַנען שטױב.<verse eid="PSA 103:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 103:15" />דער מענטש – אַזױ װי גראָז זײַנען זײַנע טעג,</para>
  <para style="q" vid="PSA 103:15">װי אַ שפּראָצונג פֿון פֿעלד, אַזױ שפּראָצט ער.<verse eid="PSA 103:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 103:16" />װאָרעם אַ װינט גײט אַריבער אױף אים, און ער איז נישטאָ,</para>
  <para style="q" vid="PSA 103:16">און זײַן אָרט דערקענט אים נישט מער.<verse eid="PSA 103:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 103:17" />אָבער דער חֶסֶד פֿון ה׳ איז פֿון אײביק ביז אײביק</para>
  <para style="q" vid="PSA 103:17">אױף די װאָס פֿאָרכטן אים,</para>
  <para style="q" vid="PSA 103:17">און זײַן גערעכטיקײט צו קינדס-קינדער;<verse eid="PSA 103:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 103:18" />צו די װאָס היטן זײַן ברית</para>
  <para style="q" vid="PSA 103:18">און צו די װאָס געדענקען זײַנע באַפֿעלן זײ צו טאָן.<verse eid="PSA 103:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 103:19" />ה׳ האָט אין הימל אױפֿגעשטעלט זײַן טראָן,</para>
  <para style="q" vid="PSA 103:19">און זײַן מלוכה געװעלטיקט איבער אַלץ.<verse eid="PSA 103:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="PSA 103:20" />לױבט ה׳, זײַנע מלאָכים,</para>
  <para style="q" vid="PSA 103:20">איר שטאַרקע גיבוֹרים װאָס טוט זײַן װאָרט,</para>
  <para style="q" vid="PSA 103:20">בײַם הערן דעם קֹול פֿון זײַן װאָרט.<verse eid="PSA 103:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 103:21" />לױבט ה׳, אַלע זײַנע חײלות,</para>
  <para style="q" vid="PSA 103:21">זײַנע משרתים װאָס טוט זײַן רָצון.<verse eid="PSA 103:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 103:22" />לױבט ה׳, אַלע זײַנע װערק,</para>
  <para style="q" vid="PSA 103:22">אין אַלע ערטער פֿון זײַן געװעלטיקײט;</para>
  <para style="q" vid="PSA 103:22">לױב ה׳, מײַן זעל.<verse eid="PSA 103:22" /></para>
  <chapter eid="PSA 103" />
  <chapter number="104" style="c" pubnumber="קד" sid="PSA 104" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 104:1" />לױב ה׳, מײַן זעל;</para>
  <para style="q" vid="PSA 104:1">ה׳ מײַן ג-ט, ביסט גרױס ביז גאָר,</para>
  <para style="q" vid="PSA 104:1">אין גלאַנץ און שײנקײט ביסטו אָנגעקלײדט.<verse eid="PSA 104:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 104:2" />דער װאָס װיקלט זיך אין ליכט װי אין אַ מאַנטל,</para>
  <para style="q" vid="PSA 104:2">װאָס שפּרײט אױס די הימלען װי אַ פֿאָרהאַנג.<verse eid="PSA 104:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 104:3" />װאָס באַלקנט מיט װאַסער זײַנע אײבערשטובן;</para>
  <para style="q" vid="PSA 104:3">װאָס מאַכט װאָלקנס פֿאַר זײַן רײַטװאָגן,</para>
  <para style="q" vid="PSA 104:3">װאָס גײט אױף די פֿליגלען פֿון װינט.<verse eid="PSA 104:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 104:4" />װאָס מאַכט זײַנע שלוחים די װינטן,</para>
  <para style="q" vid="PSA 104:4">זײַנע משרתים – פֿלאַקעריק פֿײַער.<verse eid="PSA 104:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 104:5" />ער האָט געגרונטפֿעסט די ערד אױף אירע געשטעלן,</para>
  <para style="q" vid="PSA 104:5">זי זאָל זיך נישט װאַקלען, אײביק און שטענדיק.<verse eid="PSA 104:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 104:6" />דעם תּהום, אים האָסטו װי אַ קלײד איבערגעדעקט;</para>
  <para style="q" vid="PSA 104:6">איבער די בערג זײַנען געשטאַנען די װאַסערן.<verse eid="PSA 104:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 104:7" />פֿון דײַן אָנגעשרײ זײַנען זײ אַנטלאָפֿן,</para>
  <para style="q" vid="PSA 104:7">פֿון קֹול פֿון דײַן דונער האָבן זײ אַװעקגעאײַלט –<verse eid="PSA 104:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 104:8" />בערג האָבן זיך אױפֿגעהױבן,</para>
  <para style="q" vid="PSA 104:8">טאָלן האָבן גענידערט –</para>
  <para style="q" vid="PSA 104:8">צו דעם אָרט װאָס דו האָסט געגרונטפֿעסט פֿאַר זײ.<verse eid="PSA 104:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 104:9" />האָסט געמאַכט אַ גבֿול װאָס זײ זאָלן נישט אַריבערגײן,</para>
  <para style="q" vid="PSA 104:9">כּדי זײ זאָלן נישט װידער באַדעקן די ערד.<verse eid="PSA 104:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 104:10" />ער איז דער װאָס שיקט קװאַלן אין די טאָלן,</para>
  <para style="q" vid="PSA 104:10">זײ זאָלן גײן צװישן די בערג.<verse eid="PSA 104:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 104:11" />זײ טרינקען אָן אַלע חיות פֿון פֿעלד,</para>
  <para style="q" vid="PSA 104:11">די װאַלדאײזלען שטילן זײער דאָרשט.<verse eid="PSA 104:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 104:12" />לעבן זײ רוען די פֿױגלען פֿון הימל,</para>
  <para style="q" vid="PSA 104:12">פֿון צװישן די צװײַגן גיבן זײ אַרױס אַ קֹול.<verse eid="PSA 104:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 104:13" />ביסט דער װאָס טרינקט אָן די בערג פֿון זײַנע אײבערשטובן;</para>
  <para style="q" vid="PSA 104:13">פֿון דער פֿרוכט פֿון דײַנע טוּונגען װערט געזעטיקט די ערד.<verse eid="PSA 104:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 104:14" />ער מאַכט שפּראָצן גראָז פֿאַר דער בהמה,</para>
  <para style="q" vid="PSA 104:14">און הײ פֿאַר די אַרבעטפֿי פֿון דעם מענטשן,</para>
  <para style="q" vid="PSA 104:14">כּדי אַרױסצוציען ברױט פֿון דער ערד;<verse eid="PSA 104:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 104:15" />און װײַן װאָס דערפֿרײט דעם מענטשנס האַרץ,</para>
  <para style="q" vid="PSA 104:15">צו מאַכן גלאַנצן דעם פּנים מער װי אײל;</para>
  <para style="q" vid="PSA 104:15">און ברױט װאָס לענט אונטער דעם מענטשנס האַרץ.<verse eid="PSA 104:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 104:16" />די בײמער פֿון ה׳ זעטן זיך אָן,</para>
  <para style="q" vid="PSA 104:16">די צעדערן פֿון לבֿנוֹן װאָס ער האָט געפֿלאַנצט,<verse eid="PSA 104:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 104:17" />װאָס דאָרטן נעסטן די פֿױגלען;</para>
  <para style="q" vid="PSA 104:17">דער שטאָרך, זײַן הױז זײַנען ציפּרעסן.<verse eid="PSA 104:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 104:18" />די הױכע בערג זײַנען פֿאַר די שטײנבעק,</para>
  <para style="q" vid="PSA 104:18">די פֿעלדזן אַ באַשיצונג פֿאַר די קיניגלס.<verse eid="PSA 104:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 104:19" />ער האָט געמאַכט די לבֿנה פֿאַר די צײַטן;</para>
  <para style="q" vid="PSA 104:19">די זון װײס איר אונטערגאַנג.<verse eid="PSA 104:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 104:20" />מאַכסט פֿינצטערניש, און עס װערט נאַכט,</para>
  <para style="q" vid="PSA 104:20">אין איר װידמענען זיך אַלע חיות פֿון פֿעלד.<verse eid="PSA 104:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 104:21" />די יונגלײבן ברילן נאָך רױב,</para>
  <para style="q" vid="PSA 104:21">און בעטן פֿון אֵל זײער שפּײַז.<verse eid="PSA 104:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 104:22" />גײט אױף די זון, װערן זײ אײַנגעטאָן,</para>
  <para style="q" vid="PSA 104:22">און זײ הױערן אין זײערע נאָרעס.<verse eid="PSA 104:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 104:23" />גײט אַרױס דער מענטש צו זײַן װערק,</para>
  <para style="q" vid="PSA 104:23">און צו זײַן אַרבעט ביז אָװנט.<verse eid="PSA 104:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PSA 104:24" />װי פֿיל זײַנען דײַנע װערק, ה׳!</para>
  <para style="q" vid="PSA 104:24">זײ אַלע האָסטו מיט חכמה געמאַכט;</para>
  <para style="q" vid="PSA 104:24">די גאַנצע ערד איז פֿול מיט דײַן אײגנס.<verse eid="PSA 104:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 104:25" />אָן איז דער ים, גרױס און ברײט,</para>
  <para style="q" vid="PSA 104:25">דאָרט איז אַ װידמענונג אָן אַ צאָל,</para>
  <para style="q" vid="PSA 104:25">חיות גרױסע מיט קלײנע.<verse eid="PSA 104:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 104:26" />דאָרט גײען אום שיפֿן;</para>
  <para style="q" vid="PSA 104:26">דער לִויָתן װאָס דו האָסט באַשאַפֿן זיך צו שפּילן דערין.<verse eid="PSA 104:26" /></para>
  <para style="b" />
  <para style="q">
    <verse number="27" style="v" sid="PSA 104:27" />זײ אַלע קוקן אױס צו דיר,</para>
  <para style="q" vid="PSA 104:27">צו געבן זײער שפּײַז אין איר צײַט.<verse eid="PSA 104:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 104:28" />גיסטו זײ, קלײַבן זײ אױף,</para>
  <para style="q" vid="PSA 104:28">עפֿנסט דײַן האַנט, זעטן זײ זיך מיט גוטס.<verse eid="PSA 104:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 104:29" />פֿאַרבאָרגסטו דײַן פּנים, װערן זײ פֿאַרכאַפּט,</para>
  <para style="q" vid="PSA 104:29">טוסט אײַן זײער אָטעם, פֿאַרגײען זײ,</para>
  <para style="q" vid="PSA 104:29">און קערן זיך אום צו זײער שטױב.<verse eid="PSA 104:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 104:30" />דו שיקסט אַרױס דײַן רוּחַ, אַזױ װערן זײ באַשאַפֿן,</para>
  <para style="q" vid="PSA 104:30">און דו באַנײַסט דעם פּנים פֿון דער ערד.<verse eid="PSA 104:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="PSA 104:31" />זאָל דער כּבֿוד פֿון ה׳ זײַן אױף אײביק!</para>
  <para style="q" vid="PSA 104:31">זאָל ה׳ זיך פֿרײען מיט זײַנע װערק!<verse eid="PSA 104:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 104:32" />דער װאָס קוקט אָן די ערד, און זי ציטערט,</para>
  <para style="q" vid="PSA 104:32">װאָס רירט אָן די בערג, און זײ רײכערן.<verse eid="PSA 104:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 104:33" />איך װעל זינגען צו ה׳ כּל-זמן איך לעב,</para>
  <para style="q" vid="PSA 104:33">איך װעל שפּילן צו מײַן ג-ט װי לאַנג איך בין.<verse eid="PSA 104:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 104:34" />זאָל אים געזיסט זײַן מײַן רעדן;</para>
  <para style="q" vid="PSA 104:34">איך פֿרײ זיך מיט ה׳.<verse eid="PSA 104:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 104:35" />זאָלן די זינדיקע פֿאַרלענדט װערן פֿון דער ערד,</para>
  <para style="q" vid="PSA 104:35">און די רשעים זאָלן מער נישט זײַן.</para>
  <para style="q" vid="PSA 104:35">לױב ה׳, מײַן זעל,</para>
  <para style="q" vid="PSA 104:35">הַלְלוּ יָהּ.<verse eid="PSA 104:35" /></para>
  <chapter eid="PSA 104" />
  <chapter number="105" style="c" pubnumber="קה" sid="PSA 105" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 105:1" />גיט אַ דאַנק צו ה׳, רופֿט זײַן נאָמען,</para>
  <para style="q" vid="PSA 105:1">לאָזט װיסן צװישן די פֿעלקער זײַנע טוּונגען.<verse eid="PSA 105:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 105:2" />זינגט צו אים, שפּילט צו אים,</para>
  <para style="q" vid="PSA 105:2">רעדט פֿון אַלע זײַנע װוּנדער.<verse eid="PSA 105:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 105:3" />רימט אײַך מיט זײַן הײליקן נאָמען;</para>
  <para style="q" vid="PSA 105:3">זאָל זיך פֿרײען דאָס האַרץ פֿון די װאָס זוכן ה׳.<verse eid="PSA 105:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 105:4" />פֿאָרשט ה׳ און זײַן שטאַרקײט,</para>
  <para style="q" vid="PSA 105:4">זוכט זײַן פּנים תּמיד.<verse eid="PSA 105:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 105:5" />דערמאָנט זײַנע װוּנדער װאָס ער האָט געטאָן,</para>
  <para style="q" vid="PSA 105:5">זײַנע צײכנס, און די משפּטים פֿון זײַן מױל,<verse eid="PSA 105:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 105:6" />איר זאָמען פֿון אבֿרהם זײַן קנעכט,</para>
  <para style="q" vid="PSA 105:6">איר קינדער פֿון יעקבֿ, זײַנע אױסדערװײלטע.<verse eid="PSA 105:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 105:7" />ער איז ה׳ אלוקינו,</para>
  <para style="q" vid="PSA 105:7">איבער דער גאַנצער ערד זײַנען זײַנע משפּטים.<verse eid="PSA 105:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 105:8" />ער געדענקט אײביק זײַן ברית,</para>
  <para style="q" vid="PSA 105:8">דאָס װאָרט װאָס ער האָט באַפֿױלן אױף טױזנט דורות;<verse eid="PSA 105:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 105:9" />װאָס ער האָט געשלאָסן מיט אבֿרהמען,</para>
  <para style="q" vid="PSA 105:9">און זײַן שבֿועה צו יצחקן.<verse eid="PSA 105:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 105:10" />און ער האָט עס אױפֿגעשטעלט פֿאַר אַ חוק צו יעקבֿ,</para>
  <para style="q" vid="PSA 105:10">פֿאַר אַן אײביקן ברית צו יִשׂרָאֵל,<verse eid="PSA 105:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 105:11" />אַזױ צו זאָגן: דיר װעל איך געבן דאָס לאַנד כּנַעַן,</para>
  <para style="q" vid="PSA 105:11">דעם טײל פֿון אײַער נחלה.<verse eid="PSA 105:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 105:12" />אַז איר זײַט געװען מענטשן געצײלטע,</para>
  <para style="q" vid="PSA 105:12">װינציק און פֿרעמדע דערין,<verse eid="PSA 105:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 105:13" />און זײ זײַנען אומגעגאַנגען פֿון פֿאָלק צו פֿאָלק,</para>
  <para style="q" vid="PSA 105:13">און פֿון אײן קיניגרײַך צו אַן אַנדער אומה,<verse eid="PSA 105:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 105:14" />האָט ער נישט געלאָזן אַ מענטשן זײ דריקן,</para>
  <para style="q" vid="PSA 105:14">און האָט געשטראָפֿט מלכים װעגן זײ:<verse eid="PSA 105:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 105:15" />איר זאָלט נישט אָנרירן מײַנע געזאַלבטע,</para>
  <para style="q" vid="PSA 105:15">און מײַנע נבֿיאים זאָלט איר נישט בײז טאָן.<verse eid="PSA 105:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 105:16" />און ער האָט גערופֿן אַ הונגער אױפֿן לאַנד,</para>
  <para style="q" vid="PSA 105:16">יעטװעדער אונטערלען פֿון ברױט האָט ער צעבראָכן.<verse eid="PSA 105:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 105:17" />ער האָט זײ פֿאַרױס געשיקט אַ מאַן:</para>
  <para style="q" vid="PSA 105:17">פֿאַר אַ קנעכט איז פֿאַרקױפֿט געװאָרן יוֹסף.<verse eid="PSA 105:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 105:18" />מע האָט געפּײַניקט אין קײטן זײַן פֿוס,</para>
  <para style="q" vid="PSA 105:18">אין אײַזן איז אַרײַנגעטאָן געװאָרן זײַן נשמה;<verse eid="PSA 105:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 105:19" />ביז דער צײַט װאָס זײַן װאָרט איז געשען,</para>
  <para style="q" vid="PSA 105:19">האָט דער באַפֿעל פֿון ה׳ אים געפּרוּװט.<verse eid="PSA 105:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 105:20" />דער מלך האָט געשיקט און אים לױז געלאָזט,</para>
  <para style="q" vid="PSA 105:20">דער געװעלטיקער פֿון פֿעלקער – און אים פֿרײַ געמאַכט.<verse eid="PSA 105:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 105:21" />ער האָט אים געמאַכט פֿאַר אַ האַר איבער זײַן הױז,</para>
  <para style="q" vid="PSA 105:21">און פֿאַר אַ געװעלטיקער איבער זײַן גאַנצן אײגנס,<verse eid="PSA 105:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 105:22" />צו בינדן זײַנע האַרן לױט זײַן באַראָט,</para>
  <para style="q" vid="PSA 105:22">און זײַנע עלטסטע זאָל ער קליגן.<verse eid="PSA 105:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 105:23" />און יִשׂרָאֵל איז געקומען קײן מִצרַיִם.</para>
  <para style="q" vid="PSA 105:23">און יעקבֿ האָט זיך אױפֿגעהאַלטן אין לאַנד חָם.<verse eid="PSA 105:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 105:24" />און ער האָט זײער געפֿרוכפּערט זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 105:24">און זײ געמאַכט שטאַרקער פֿון זײערע דריקער.<verse eid="PSA 105:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 105:25" />ער האָט פֿאַרקערט זײער האַרץ פֿײַנט צו האָבן זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 105:25">זיך צו קליגן אַקעגן זײַנע קנעכט.<verse eid="PSA 105:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 105:26" />ער האָט געשיקט משה זײַן קנעכט,</para>
  <para style="q" vid="PSA 105:26">אַהרֹנען װעמען ער האָט אױסדערװײלט.<verse eid="PSA 105:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 105:27" />האָבן זײ געמאַכט צװישן זײ די זאַכן פֿון זײַנע צײכנס,</para>
  <para style="q" vid="PSA 105:27">און װוּנדער אין לאַנד פֿון חָם.<verse eid="PSA 105:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 105:28" />ער האָט אָנגעשיקט פֿינצטערניש און פֿינצטער געמאַכט;</para>
  <para style="q" vid="PSA 105:28">און זײ האָבן נישט װידערשפּעניקט זײַן װאָרט.<verse eid="PSA 105:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 105:29" />ער האָט פֿאַרקערט זײערע װאַסערן אין בלוט,</para>
  <para style="q" vid="PSA 105:29">און האָט געטײט זײערע פֿיש.<verse eid="PSA 105:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 105:30" />זײער לאַנד האָט געװידמעט פֿרעש,</para>
  <para style="q" vid="PSA 105:30">ביז אין די קאַמערן פֿון זײערע מלכים.<verse eid="PSA 105:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 105:31" />ער האָט געהײסן, און אַ געמיש פֿליגן איז געקומען,</para>
  <para style="q" vid="PSA 105:31">אומגעציפֿער אין זײער גאַנצן געמאַרק.<verse eid="PSA 105:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 105:32" />ער האָט געגעבן אַנשטאָט זײערע רעגנס האָגל,</para>
  <para style="q" vid="PSA 105:32">אַ פֿלאַמפֿײַער אין זײער לאַנד.<verse eid="PSA 105:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 105:33" />און ער האָט אײַנגעשלאָגן זײער װײַנשטאָק און זײער פֿײַגנבױם,</para>
  <para style="q" vid="PSA 105:33">און אױסגעבראָכן די בײמער פֿון זײער געמאַרק.<verse eid="PSA 105:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 105:34" />ער האָט געהײסן, און אַ הײשעריק איז געקומען,</para>
  <para style="q" vid="PSA 105:34">און אַ גראָזפֿרעסער אַזש אָן אַ צאָל;<verse eid="PSA 105:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 105:35" />און ער האָט אױפֿגעגעסן יעטװעדער קרײַטעכץ אין זײער לאַנד,</para>
  <para style="q" vid="PSA 105:35">און אױפֿגעגעסן די פֿרוכט פֿון זײער ערד.<verse eid="PSA 105:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 105:36" />און ער האָט געשלאָגן יעטװעדער בכוֹר אין זײער לאַנד,</para>
  <para style="q" vid="PSA 105:36">די ערשטלינגען פֿון אַל זײער קראַפֿט.<verse eid="PSA 105:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="PSA 105:37" />און האָט זײ אַרױסגעצױגן מיט זילבער און גאָלד;</para>
  <para style="q" vid="PSA 105:37">און נישט געװען צװישן זײַנע שבֿטים אַ שטרױכלער.<verse eid="PSA 105:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 105:38" />מִצרַיִם האָט זיך געפֿרײט מיט זײער אַרױסגײן,</para>
  <para style="q" vid="PSA 105:38">װאָרעם זײער שרעק איז געפֿאַלן אױף זײ.<verse eid="PSA 105:38" /></para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" sid="PSA 105:39" />ער האָט פֿאַרשפּרײט אַ װאָלקן צום צודעק,</para>
  <para style="q" vid="PSA 105:39">און אַ פֿײַער צו לײַכטן בײַ נאַכט.<verse eid="PSA 105:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 105:40" />מע האָט פֿאַרלאַנגט, און ער האָט געבראַכט װאַכטלפֿױגלען,</para>
  <para style="q" vid="PSA 105:40">און מיט ברױט פֿון הימל פֿלעגט ער זײ זעטן.<verse eid="PSA 105:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 105:41" />ער האָט געעפֿנט אַ צוּר, און װאַסער איז פּליוכען,</para>
  <para style="q" vid="PSA 105:41">געגאַנגען װי אַ טײַך דורך די טריקענישן.<verse eid="PSA 105:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 105:42" />װאָרעם ער האָט געדאַכט אָן זײַן הײליקן צוזאָג</para>
  <para style="q" vid="PSA 105:42">צו אבֿרהם זײַן קנעכט.<verse eid="PSA 105:42" /></para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" sid="PSA 105:43" />און ער האָט אַרױסגעצױגן זײַן פֿאָלק מיט פֿרײד,</para>
  <para style="q" vid="PSA 105:43">מיט געזאַנג זײַנע אױסדערװײלטע.<verse eid="PSA 105:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 105:44" />און ער האָט זײ געגעבן די לענדער פֿון די פֿעלקער,</para>
  <para style="q" vid="PSA 105:44">און די מי פֿון די אומות האָבן זײ געיַרשעט;<verse eid="PSA 105:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 105:45" />כּדי זײ זאָלן האַלטן זײַנע געזעצן,</para>
  <para style="q" vid="PSA 105:45">און זײַנע לערנונגען זאָלן זײ היטן.</para>
  <para style="q" vid="PSA 105:45">הַלְלוּ יָהּ.<verse eid="PSA 105:45" /></para>
  <chapter eid="PSA 105" />
  <chapter number="106" style="c" pubnumber="קו" sid="PSA 106" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 106:1" />הַלְלוּ יָהּ.</para>
  <para style="q" vid="PSA 106:1">גיט אַ דאַנק צו ה׳, װאָרעם ער איז גוט,</para>
  <para style="q" vid="PSA 106:1">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 106:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 106:2" />װער קען אױסרעדן די גבֿורות פֿון ה׳?</para>
  <para style="q" vid="PSA 106:2">מאַכן הערן זײַן גאַנצן לױב?<verse eid="PSA 106:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 106:3" />װױל צו די װאָס היטן גערעכטיקײט,</para>
  <para style="q" vid="PSA 106:3">צו דעם װאָס טוט רעכט אין יעטװעדער צײַט.<verse eid="PSA 106:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 106:4" />געדענק מיך, ה׳, װען דו באַװיליקסט דײַן פֿאָלק,</para>
  <para style="q" vid="PSA 106:4">דערמאָן מיך אין דײַן הילף;<verse eid="PSA 106:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 106:5" />כּדי איך זאָל זען דאָס גוטס פֿון דײַנע אױסדערװײלטע,</para>
  <para style="q" vid="PSA 106:5">זיך פֿרײען אין דער פֿרײד פֿון דײַן פֿאָלק,</para>
  <para style="q" vid="PSA 106:5">זיך רימען אין אײנעם מיט דײַן אַרב.<verse eid="PSA 106:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 106:6" />מיר האָבן געזינדיקט אַזױ װי אונדזערע עלטערן,</para>
  <para style="q" vid="PSA 106:6">מיר האָבן פֿאַרבראָכן, מיר האָבן שלעכטס געטאָן.<verse eid="PSA 106:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 106:7" />אונדזערע עלטערן אין מִצרַיִם האָבן נישט באַטראַכט דײַנע װוּנדער,</para>
  <para style="q" vid="PSA 106:7">זײ האָבן נישט געדאַכט אָן דײַנע פֿיל חסדים,</para>
  <para style="q" vid="PSA 106:7">און האָבן װידערשפּעניקט בײַם ים, בײַם ים-סוףֿ.<verse eid="PSA 106:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 106:8" />אָבער ער האָט זײ געהאָלפֿן פֿון זײַן נאָמען װעגן,</para>
  <para style="q" vid="PSA 106:8">כּדי צו לאָזן װיסן זײַן גבֿורה.<verse eid="PSA 106:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 106:9" />און ער האָט אָנגעשריִען אױפֿן ים-סוףֿ, און ער איז געװאָרן טרוקן,</para>
  <para style="q" vid="PSA 106:9">און ער האָט זײ געפֿירט דורך די תּהומען װי דורך אַ סטעפּ.<verse eid="PSA 106:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 106:10" />און ער האָט זײ געהאָלפֿן פֿון דעם שׂונאס האַנט,</para>
  <para style="q" vid="PSA 106:10">און זײ אױסגעלײזט פֿון דער האַנט פֿון פֿײַנט.<verse eid="PSA 106:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 106:11" />און די װאַסערן האָבן צוגעדעקט זײערע דריקער,</para>
  <para style="q" vid="PSA 106:11">נישט אַן אײנציקער פֿון זײ איז געבליבן.<verse eid="PSA 106:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 106:12" />און זײ האָבן געגלױבט אין זײַנע װערטער,</para>
  <para style="q" vid="PSA 106:12">זײ האָבן געזונגען זײַן לױב.<verse eid="PSA 106:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 106:13" />גיך האָבן זײ פֿאַרגעסן זײַנע טוּונגען;</para>
  <para style="q" vid="PSA 106:13">זײ האָבן נישט געהאַרט אױף זײַן עצה.<verse eid="PSA 106:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 106:14" />און זײ האָבן געגלוסט אַ גלוסטונג אין דער מדבר,</para>
  <para style="q" vid="PSA 106:14">און געפּרוּװט אֵל אין דער װיסטע.<verse eid="PSA 106:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 106:15" />און ער האָט זײ געגעבן זײער פֿאַרלאַנג,</para>
  <para style="q" vid="PSA 106:15">אָבער ער האָט געשיקט אַ מאָגערקײט אין זײער נשמות.<verse eid="PSA 106:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 106:16" />און זײ האָבן זיך מקנא געװען אָן משהן אין לאַגער,</para>
  <para style="q" vid="PSA 106:16">און אָן אַהרֹן דעם הײליקן פֿון ה׳.<verse eid="PSA 106:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 106:17" />האָט די ערד זיך געעפֿנט, און אײַנגעשלונגען דָתָנען,</para>
  <para style="q" vid="PSA 106:17">און צוגעדעקט דאָס געזעמל פֿון אַבֿירָמען.<verse eid="PSA 106:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 106:18" />און אַ פֿײַער האָט זיך אָנגעצונדן אין זײער געזעמל,</para>
  <para style="q" vid="PSA 106:18">אַ פֿלאַם האָט פֿאַרברענט די רשעים.<verse eid="PSA 106:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 106:19" />זײ האָבן געמאַכט אַ קאַלב אין חוֹרֵבֿ,</para>
  <para style="q" vid="PSA 106:19">און זיך געבוקט צו אַ געגאָסענעם געץ.<verse eid="PSA 106:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 106:20" />און זײ האָבן פֿאַרביטן זײער כּבֿוד אױף דער געשטאַלט</para>
  <para style="q" vid="PSA 106:20">פֿון אַן אָקס װאָס עסט גראָז.<verse eid="PSA 106:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 106:21" />זײ האָבן פֿאַרגעסן אָן אֵל זײער העלפֿער,</para>
  <para style="q" vid="PSA 106:21">װאָס האָט געטאָן גרױסע זאַכן אין מִצרַיִם,<verse eid="PSA 106:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 106:22" />װוּנדער אין לאַנד פֿון חָם,</para>
  <para style="q" vid="PSA 106:22">פֿאָרכטיקע זאַכן בײַם ים-סוףֿ.<verse eid="PSA 106:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 106:23" />און ער האָט געװאָלט זײ פֿאַרטיליקן,</para>
  <para style="q" vid="PSA 106:23">װען נישט משה זײַן אױסדערװײלטער</para>
  <para style="q" vid="PSA 106:23">װאָלט זיך געשטעלט פֿאַר אים אין דעם בראָך,</para>
  <para style="q" vid="PSA 106:23">אָפּצוהאַלטן זײַן גרימצאָרן פֿון אומברענגען.<verse eid="PSA 106:23" /></para>
  <para style="b" />
  <para style="q">
    <verse number="24" style="v" sid="PSA 106:24" />און זײ האָבן פֿאַראַכט דאָס גלוסטיקע לאַנד,</para>
  <para style="q" vid="PSA 106:24">נישט געגלױבט אין זײַן װאָרט.<verse eid="PSA 106:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 106:25" />און זײ האָבן געמורמלט אין זײערע געצעלטן,</para>
  <para style="q" vid="PSA 106:25">נישט צוגעהערט צו דעם קֹול פֿון ה׳.<verse eid="PSA 106:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 106:26" />און ער האָט אױפֿגעהױבן זײַן האַנט װעגן זײ,</para>
  <para style="q" vid="PSA 106:26">זײ צו מאַכן פֿאַלן אין דער מדבר,<verse eid="PSA 106:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 106:27" />און צעװאַרפֿן זײער זאָמען צװישן די פֿעלקער,</para>
  <para style="q" vid="PSA 106:27">און זײ צעשפּרײטן אין די לענדער.<verse eid="PSA 106:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PSA 106:28" />און זײ האָבן זיך באַהעפֿט אָן דעם בַעַל פֿון פּעוֹר,</para>
  <para style="q" vid="PSA 106:28">און געגעסן שלאַכטאָפּפֿער צו טױטע.<verse eid="PSA 106:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 106:29" />און זײ האָבן דערכּעסט מיט זײערע מעשׂים,</para>
  <para style="q" vid="PSA 106:29">און אַ מגפֿה האָט אױסגעבראָכן צװישן זײ.<verse eid="PSA 106:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 106:30" />און פּינְחס איז אױפֿגעשטאַנען, און האָט אַ משפּט געטאָן,</para>
  <para style="q" vid="PSA 106:30">און די מגפֿה איז פֿאַרהאַלטן געװאָרן.<verse eid="PSA 106:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 106:31" />און עס איז אים גערעכנט געװאָרן צו גערעכטיקײט,</para>
  <para style="q" vid="PSA 106:31">אױף דור-דורות ביז אײביק.<verse eid="PSA 106:31" /></para>
  <para style="b" />
  <para style="q">
    <verse number="32" style="v" sid="PSA 106:32" />און זײ האָבן דערצערנט בײַ די װאַסערן פֿון מריבֿה,</para>
  <para style="q" vid="PSA 106:32">און משהן איז געשען בײז פֿון װעגן זײ;<verse eid="PSA 106:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 106:33" />װאָרעם זײ האָבן פֿאַרביטערט זײַן רוּחַ,</para>
  <para style="q" vid="PSA 106:33">און ער האָט זיך אַרױסגערעדט מיט זײַנע ליפּן.<verse eid="PSA 106:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="PSA 106:34" />זײ האָבן נישט פֿאַרטיליקט די פֿעלקער,</para>
  <para style="q" vid="PSA 106:34">אַזױ װי ה׳ האָט זײ אָנגעזאָגט.<verse eid="PSA 106:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 106:35" />און זײ האָבן זיך געמישט מיט די פֿעלקער,</para>
  <para style="q" vid="PSA 106:35">און זיך אָפּגעלערנט זײערע מעשׂים.<verse eid="PSA 106:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 106:36" />און זײ האָבן געדינט זײערע געצנבילדער,</para>
  <para style="q" vid="PSA 106:36">װאָס זײַנען געװאָרן אַ שטרױכלונג פֿאַר זײ.<verse eid="PSA 106:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 106:37" />און זײ האָבן געשלאַכט זײערע זין</para>
  <para style="q" vid="PSA 106:37">און זײערע טעכטער צו די שֵדים,<verse eid="PSA 106:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 106:38" />און האָבן פֿאַרגאָסן אומשולדיק בלוט,</para>
  <para style="q" vid="PSA 106:38">דאָס בלוט פֿון זײערע זין און זײערע טעכטער,</para>
  <para style="q" vid="PSA 106:38">װאָס זײ האָבן געשלאַכט צו די געצנבילדער פֿון כּנַעַן;</para>
  <para style="q" vid="PSA 106:38">און דאָס לאַנד איז זינדיק געװאָרן דורך בלוט.<verse eid="PSA 106:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 106:39" />און זײ זײַנען געװאָרן אומרײן דורך זײערע מעשׂים,</para>
  <para style="q" vid="PSA 106:39">און פֿאַרפֿירט געװאָרן אין זײערע טוּונגען.<verse eid="PSA 106:39" /></para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" sid="PSA 106:40" />און דער צאָרן פֿון ה׳ האָט געגרימט אױף זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 106:40">און ער האָט פֿאַראומװערדיקט זײַן אַרב.<verse eid="PSA 106:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 106:41" />און ער האָט זײ געגעבן אין דער האַנט פֿון די פֿעלקער,</para>
  <para style="q" vid="PSA 106:41">און זײערע שָׂונאים האָבן געװעלטיקט איבער זײ.<verse eid="PSA 106:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 106:42" />און זײערע פֿײַנט האָבן זײ געדריקט,</para>
  <para style="q" vid="PSA 106:42">און זײ זײַנען אונטערטעניק געװאָרן אונטער זײער האַנט.<verse eid="PSA 106:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 106:43" />פֿיל מאָל פֿלעגט ער זײ מציל זײַן,</para>
  <para style="q" vid="PSA 106:43">אָבער זײ פֿלעגן װידערשפּעניקן אין זײער באַראָט,</para>
  <para style="q" vid="PSA 106:43">און זײַנען אַראָפּגעקומען דורך זײער זינד.<verse eid="PSA 106:43" /></para>
  <para style="b" />
  <para style="q">
    <verse number="44" style="v" sid="PSA 106:44" />און ער האָט צוגעזען זײער נױט,</para>
  <para style="q" vid="PSA 106:44">אַז ער האָט געהערט זײער געשרײ.<verse eid="PSA 106:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 106:45" />און ער האָט זײ געדענקט זײַן ברית,</para>
  <para style="q" vid="PSA 106:45">און זיך באַדאַכט לױט זײַן גרױס גענאָד.<verse eid="PSA 106:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 106:46" />און ער האָט זײ געגעבן דערבאַרעמונג</para>
  <para style="q" vid="PSA 106:46">בײַ אַלע זײערע פֿאַנגער.<verse eid="PSA 106:46" /></para>
  <para style="b" />
  <para style="q">
    <verse number="47" style="v" sid="PSA 106:47" />העלף אונדז, ה׳ אלוקינו,</para>
  <para style="q" vid="PSA 106:47">און זאַמל אונדז אײַן פֿון די פֿעלקער,</para>
  <para style="q" vid="PSA 106:47">צו דאַנקען דײַן הײליקן נאָמען,</para>
  <para style="q" vid="PSA 106:47">זיך צו רימען מיט דײַן לױב.<verse eid="PSA 106:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 106:48" />ברוך ה׳ אלוקי יִשׂרָאֵל</para>
  <para style="q" vid="PSA 106:48">פֿון אײביקײט און ביז אײביקײט,</para>
  <para style="q" vid="PSA 106:48">און זאָל דאָס גאַנצע פֿאָלק זאָגן: אָמן!</para>
  <para style="q" vid="PSA 106:48">הַלְלוּ יָהּ.<verse eid="PSA 106:48" /></para>
  <chapter eid="PSA 106" />
  <chapter number="107" style="c" pubnumber="קז" sid="PSA 107" />
  <para style="ms">פֿינפֿטער סֵפֿר</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 107:1" />גיט אַ דאַנק צו ה׳, װאָרעם ער איז גוט,</para>
  <para style="q" vid="PSA 107:1">װאָרעם אױף אײביק איז זײַן חֶסֶד,<verse eid="PSA 107:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 107:2" />זאָלן זאָגן די אױסגעלײזטע פֿון ה׳,</para>
  <para style="q" vid="PSA 107:2">װאָס ער האָט זײ אױסגעלײזט פֿון דער האַנט פֿון פֿײַנט,<verse eid="PSA 107:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 107:3" />און פֿון די לענדער זײ אײַנגעזאַמלט,</para>
  <para style="q" vid="PSA 107:3">פֿון מזרח און פֿון מערבֿ,</para>
  <para style="q" vid="PSA 107:3">פֿון צפֿון און פֿון ים.<verse eid="PSA 107:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 107:4" />זײ האָבן געבלאָנדזשעט אין מדבר אױף אַ װיסטן װעג,</para>
  <para style="q" vid="PSA 107:4">קײן שטאָט פֿון יִשובֿ נישט געפֿונען.<verse eid="PSA 107:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 107:5" />הונגעריקע און דאָרשטיקע,</para>
  <para style="q" vid="PSA 107:5">איז זײער זעל געװען פֿאַרחלשט אין זײ.<verse eid="PSA 107:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 107:6" />האָבן זײ געשריִען צו ה׳ אין זײער נױט,</para>
  <para style="q" vid="PSA 107:6">און ער האָט זײ מציל געװען פֿון זײער קלעם.<verse eid="PSA 107:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 107:7" />און ער האָט זײ געפֿירט אױף אַ גלײַכן װעג,</para>
  <para style="q" vid="PSA 107:7">צו קומען צו אַ שטאָט פֿון יִשובֿ.<verse eid="PSA 107:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 107:8" />זײ דאַרפֿן דאַנקען ה׳ פֿאַר זײַן חֶסֶד,</para>
  <para style="q" vid="PSA 107:8">און פֿאַר זײַנע װוּנדער צו די מענטשנקינדער.<verse eid="PSA 107:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 107:9" />װאָרעם ער האָט געזעטיקט די פֿאַרשמאַכטע זעל,</para>
  <para style="q" vid="PSA 107:9">און די הונגעריקע זעל האָט ער אָנגעפֿילט מיט גוטס.<verse eid="PSA 107:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 107:10" />די װאָס זײַנען געזעסן אין פֿינצטערניש און טױטשאָטן,</para>
  <para style="q" vid="PSA 107:10">געקײט אין פּײַן און אײַזן –<verse eid="PSA 107:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 107:11" />װײַל זײ האָבן װידערשפּעניקט די װערטער פֿון אֵל,</para>
  <para style="q" vid="PSA 107:11">און די עצה פֿון דעם עליון געלעסטערט;<verse eid="PSA 107:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 107:12" />און ער האָט אונטערטעניקט מיט לײַד זײער האַרץ;</para>
  <para style="q" vid="PSA 107:12">זײ זײַנען געשטרױכלט געװאָרן, און נישט געװען קײן העלפֿער –<verse eid="PSA 107:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 107:13" />האָבן זײ געשריִען צו ה׳ אין זײער נױט,</para>
  <para style="q" vid="PSA 107:13">און ער האָט זײ געהאָלפֿן פֿון זײער קלעם.<verse eid="PSA 107:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 107:14" />ער האָט זײ אַרױסגעצױגן פֿון פֿינצטערניש און טױטשאָטן,</para>
  <para style="q" vid="PSA 107:14">און זײערע בינדשטריק האָט ער צעריסן.<verse eid="PSA 107:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 107:15" />זײ דאַרפֿן דאַנקען ה׳ פֿאַר זײַן חֶסֶד,</para>
  <para style="q" vid="PSA 107:15">און פֿאַר זײַנע װוּנדער צו די מענטשנקינדער.<verse eid="PSA 107:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 107:16" />װאָרעם ער האָט צעבראָכן די קופּערנע טירן,</para>
  <para style="q" vid="PSA 107:16">און די אײַזערנע ריגלען צעהאַקט.<verse eid="PSA 107:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 107:17" />נאַרן האָבן פֿאַר זײער זינדיקן װעג</para>
  <para style="q" vid="PSA 107:17">און פֿאַר זײערע פֿאַרברעכן געליטן;<verse eid="PSA 107:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 107:18" />זײער זעל האָט זיך געעקלט מיט איטלעכער שפּײַז,</para>
  <para style="q" vid="PSA 107:18">און זײ האָבן דערגרײכט ביז די טױערן פֿון טױט.<verse eid="PSA 107:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 107:19" />האָבן זײ געשריִען צו ה׳ אין זײער נױט,</para>
  <para style="q" vid="PSA 107:19">און ער האָט זײ געהאָלפֿן פֿון זײער קלעם.<verse eid="PSA 107:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 107:20" />ער האָט געשיקט זײַן װאָרט און זײ געהײלט,</para>
  <para style="q" vid="PSA 107:20">און געמאַכט אַנטרינען פֿון זײערע קבֿרים.<verse eid="PSA 107:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 107:21" />זײ דאַרפֿן דאַנקען ה׳ פֿאַר זײַן חֶסֶד,</para>
  <para style="q" vid="PSA 107:21">און פֿאַר זײַנע װוּנדער צו די מענטשנקינדער.<verse eid="PSA 107:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 107:22" />און זײ דאַרפֿן שלאַכטן דאַנקאָפּפֿער,</para>
  <para style="q" vid="PSA 107:22">און דערצײלן זײַנע מעשׂים מיט געזאַנג.<verse eid="PSA 107:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 107:23" />די װאָס נידערן אין שיפֿן אױפֿן ים,</para>
  <para style="q" vid="PSA 107:23">די װאָס טוען מסחר אױף גרױסע װאַסערן,<verse eid="PSA 107:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 107:24" />זײ האָבן געזען די מעשׂים פֿון ה׳,</para>
  <para style="q" vid="PSA 107:24">און זײַנע װוּנדער אױף דער טיפֿעניש.<verse eid="PSA 107:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 107:25" />װאָרעם ער האָט געהײסן</para>
  <para style="q" vid="PSA 107:25">און געמאַכט אױפֿשטײן אַ שטורעמװינט,</para>
  <para style="q" vid="PSA 107:25">װאָס האָט אױפֿגעהױבן זײַנע אינדן.<verse eid="PSA 107:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 107:26" />זײ זײַנען אַרױף ביזן הימל,</para>
  <para style="q" vid="PSA 107:26">גענידערט ביז די תּהומען,</para>
  <para style="q" vid="PSA 107:26">זײער זעל איז צעגאַנגען פֿון אַנגסט.<verse eid="PSA 107:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 107:27" />זײ האָבן זיך געדרײט און געװאָרפֿן װי אַ שיכּורער,</para>
  <para style="q" vid="PSA 107:27">און זײער גאַנצע חכמה איז צעמישט געװאָרן.<verse eid="PSA 107:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 107:28" />האָבן זײ געשריִען צו ה׳ אין זײער נױט,</para>
  <para style="q" vid="PSA 107:28">און ער האָט זײ אַרױסגעצױגן פֿון זײער קלעם.<verse eid="PSA 107:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 107:29" />ער האָט אײַנגעשטעלט דעם שטורעם אין שטילקײט,</para>
  <para style="q" vid="PSA 107:29">און אַנטשװיגן געװאָרן זײַנען די אינדן.<verse eid="PSA 107:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 107:30" />און זײ האָבן זיך געפֿרײט װאָס זײ זײַנען אײַנגעשטילט,</para>
  <para style="q" vid="PSA 107:30">און ער האָט זײ געפֿירט צו דעם באָרטן פֿון זײער באַגער.<verse eid="PSA 107:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 107:31" />זײ דאַרפֿן דאַנקען ה׳ פֿאַר זײַן חֶסֶד,</para>
  <para style="q" vid="PSA 107:31">און פֿאַר זײַנע װוּנדער צו די מענטשנקינדער.<verse eid="PSA 107:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 107:32" />און זײ דאַרפֿן אים דערהײבן אין דער אײַנזאַמלונג פֿון פֿאָלק,</para>
  <para style="q" vid="PSA 107:32">און אין דער זיצונג פֿון די עלטסטע אים לױבן.<verse eid="PSA 107:32" /></para>
  <para style="b" />
  <para style="q">
    <verse number="33" style="v" sid="PSA 107:33" />ער מאַכט שטראָמען פֿאַר אַ מדבר,</para>
  <para style="q" vid="PSA 107:33">און אױסגאַנגען װאַסער פֿאַר אַ דאָרשטעניש;<verse eid="PSA 107:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 107:34" />אַ פֿרוכטיק לאַנד פֿאַר אַ זאַלצװיסטעניש,</para>
  <para style="q" vid="PSA 107:34">פֿון װעגן דער שלעכטיקײט פֿון די װױנער אין איר.<verse eid="PSA 107:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 107:35" />ער מאַכט אַ מדבר פֿאַר אַ טײַך װאַסער,</para>
  <para style="q" vid="PSA 107:35">און אַ טרוקן לאַנד פֿאַר אױסגאַנגען װאַסער.<verse eid="PSA 107:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 107:36" />און ער באַזעצט דאָרטן די הונגעריקע,</para>
  <para style="q" vid="PSA 107:36">און זײ שטעלן אױף אַ שטאָט פֿון יִשובֿ.<verse eid="PSA 107:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 107:37" />און זײ פֿאַרזײען פֿעלדער, און פֿלאַנצן װײַנגערטנער,</para>
  <para style="q" vid="PSA 107:37">װאָס ברענגען פֿרוכט צום אײַנקום.<verse eid="PSA 107:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 107:38" />און ער בענטשט זײ, און זײ מערן זיך זײער,</para>
  <para style="q" vid="PSA 107:38">און ער לאָזט נישט זײערע בהמות זײַן װינציק.<verse eid="PSA 107:38" /></para>
  <para style="b" />
  <para style="q">
    <verse number="39" style="v" sid="PSA 107:39" />און אַנדערע װערן געמינערט און געבױגן,</para>
  <para style="q" vid="PSA 107:39">פֿון דער דריקעניש פֿון אומגליק און קומער.<verse eid="PSA 107:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 107:40" />ער גיסט אױס פֿאַראַכטונג אױף פֿירשטן,</para>
  <para style="q" vid="PSA 107:40">און מאַכט זײ בלאָנדזשען אין אַ װיסטע אָן אַ װעג.<verse eid="PSA 107:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 107:41" />און ער הײבט אױף דעם אבֿיון פֿון אָרימקײט,</para>
  <para style="q" vid="PSA 107:41">און מאַכט װי שאָף זײַנע משפּחות.<verse eid="PSA 107:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 107:42" />די רעכטפֿאַרטיקע זעען און פֿרײען זיך,</para>
  <para style="q" vid="PSA 107:42">און איטלעך אומרעכט מאַכט צו צומאַכן זײַן מױל.<verse eid="PSA 107:42" /></para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" sid="PSA 107:43" />װער עס איז קלוג, זאָל מערקן דאָס דאָזיקע,</para>
  <para style="q" vid="PSA 107:43">און זאָלן זײ באַטראַכטן די חסדים פֿון ה׳.<verse eid="PSA 107:43" /></para>
  <chapter eid="PSA 107" />
  <chapter number="108" style="c" pubnumber="קח" sid="PSA 108" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 108:1" />אַ געזאַנג, אַ מיזמור פֿון דָוִדן.<verse eid="PSA 108:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 108:2" /> פֿעסט איז מײַן האַרץ, אלֹקים,</para>
  <para style="q" vid="PSA 108:2">איך װעל זינגען און שפּילן,</para>
  <para style="q" vid="PSA 108:2">יאָ, מיט מײַן זעל.<verse eid="PSA 108:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 108:3" /> דערװעק דיך, גיטאַר און האַרף;</para>
  <para style="q" vid="PSA 108:3">לאָמיך אױפֿװעקן דעם באַגינען.<verse eid="PSA 108:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 108:4" /> איך װעל דיך לױבן, ה׳, צװישן די פֿעלקער,</para>
  <para style="q" vid="PSA 108:4">און דיך באַזינגען צװישן די אומות.<verse eid="PSA 108:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 108:5" /> װאָרעם גרױס איבער די הימלען איז דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 108:5">און ביז די װאָלקן דײַן טרײַשאַפֿט.<verse eid="PSA 108:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 108:6" /> דערהײב דיך איבער די הימלען, אלֹקים,</para>
  <para style="q" vid="PSA 108:6">און איבער דער גאַנצער ערד זאָל זײַן דײַן כּבֿוד.<verse eid="PSA 108:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 108:7" /> כּדי דײַנע באַליבטע זאָלן דערלײזט װערן,</para>
  <para style="q" vid="PSA 108:7">העלף מיט דײַן רעכטער האַנט, און ענטפֿער מיר.<verse eid="PSA 108:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 108:8" /> אלֹקים האָט גערעדט אין זײַן הײליקײט,</para>
  <para style="q" vid="PSA 108:8">אַז איך װעל דערפֿרײט װערן;</para>
  <para style="q" vid="PSA 108:8">איך װעל צעטײלן שכֶם,</para>
  <para style="q" vid="PSA 108:8">און דעם טאָל סוכּוֹת װעל איך אױסמעסטן.<verse eid="PSA 108:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 108:9" /> מײַן איז גִלעָד, מײַן איז מנַשֶה,</para>
  <para style="q" vid="PSA 108:9">און אפֿרים איז דער קיװער פֿון מײַן קאָפּ;</para>
  <para style="q" vid="PSA 108:9">יהוּדה איז מײַן צעפּטער.<verse eid="PSA 108:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 108:10" /> מוֹאָבֿ איז מײַן װאַשטאָפּ,</para>
  <para style="q" vid="PSA 108:10">אױף אֶדוֹם װאַרף איך מײַן שוך,</para>
  <para style="q" vid="PSA 108:10">איבער פּלֶשֶת טו איך שאַלן.<verse eid="PSA 108:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 108:11" /> װער ברענגט מיך צו דער באַפֿעסטיקטער שטאָט,</para>
  <para style="q" vid="PSA 108:11">װער פֿירט מיך קײן אֶדוֹם?<verse eid="PSA 108:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 108:12" /> פֿאַר װאָר, אלֹקים, האָסט אונדז פֿאַרלאָזט,</para>
  <para style="q" vid="PSA 108:12">און גײסט נישט אַרױס, אלֹקים, מיט אונדזערע מחנות.<verse eid="PSA 108:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 108:13" /> גיב אונדז הילף קעגן דעם פֿײַנט,</para>
  <para style="q" vid="PSA 108:13">װאָרעם נישטיק איז די ישועה פֿון אַ מענטשן.<verse eid="PSA 108:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 108:14" /> מיט אלֹקים װעלן מיר אױפֿטאָן גבֿורות,</para>
  <para style="q" vid="PSA 108:14">און ער װעט צעטרעטן אונדזערע פֿײַנט.<verse eid="PSA 108:14" /></para>
  <chapter eid="PSA 108" />
  <chapter number="109" style="c" pubnumber="קט" sid="PSA 109" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 109:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון דָוִדן אַ מיזמור.</para>
  <para style="q" vid="PSA 109:1">
    <char style="va">1</char>אלֹקים פֿון מײַן לױב, זאָלסט נישט שװײַגן.<verse eid="PSA 109:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 109:2" />װאָרעם אַ בײז מױל און אַ מױל פֿון באַטרוג</para>
  <para style="q" vid="PSA 109:2">האָבן זײ געעפֿנט אױף מיר;</para>
  <para style="q" vid="PSA 109:2">זײ האָבן גערעדט צו מיר מיט אַ צונג פֿון ליגן.<verse eid="PSA 109:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 109:3" />און מיט רײד פֿון שׂינאה האָבן זײ מיך אַרומגערינגלט,</para>
  <para style="q" vid="PSA 109:3">און געשטריטן קעגן מיר פֿאַר אומזיסט,<verse eid="PSA 109:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 109:4" />פֿאַר מײַן ליבשאַפֿט פֿײַנטן זײ מיך,</para>
  <para style="q" vid="PSA 109:4">בעת איך בין לױטער געבעט.<verse eid="PSA 109:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 109:5" />און זײ האָבן מיר אָפּגעטאָן אַ רָעה פֿאַר אַ טובֿה,</para>
  <para style="q" vid="PSA 109:5">און שׂינאה פֿאַר מײַן ליבשאַפֿט.<verse eid="PSA 109:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 109:6" />זעץ אָן אױף אים אַ רשע,</para>
  <para style="q" vid="PSA 109:6">און אַן אָנקלאָגער זאָל שטײן בײַ זײַן רעכטער זײַט.<verse eid="PSA 109:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 109:7" />אַז ער װערט געמשפּט, זאָל ער אַרױסגײן שולדיק,</para>
  <para style="q" vid="PSA 109:7">און זײַן תּפֿילה זאָל װערן צו זינד.<verse eid="PSA 109:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 109:8" />זײַנע טעג זאָלן זײַן װינציק,</para>
  <para style="q" vid="PSA 109:8">זײַן אָפּגעשפּאָרטס זאָל צונעמען אַן אַנדערער.<verse eid="PSA 109:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 109:9" />זײַנע קינדער זאָלן װערן יתומים,</para>
  <para style="q" vid="PSA 109:9">און זײַן װײַב אַן אַלמנה.<verse eid="PSA 109:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 109:10" />און װאָגלען זאָלן װאָגלען זײַנע קינדער, און בעטלען,</para>
  <para style="q" vid="PSA 109:10">און זוכן ברױט פֿון זײערע חורבֿות אַרױס.<verse eid="PSA 109:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 109:11" />פֿאַרנעמען זאָל אַ בַעַל-חובֿ אַלץ װאָס ער האָט,</para>
  <para style="q" vid="PSA 109:11">און פֿרעמדע זאָלן אַװעקרױבן זײַן מי.<verse eid="PSA 109:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 109:12" />קײנער זאָל נישט נײַגן צו אים גענאָד,</para>
  <para style="q" vid="PSA 109:12">און קײנער זאָל נישט לײַטזעליקן זײַנע יתומים.<verse eid="PSA 109:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 109:13" />זײַן נאָכקום זאָל פֿאַרשניטן װערן;</para>
  <para style="q" vid="PSA 109:13">אין אַנדער דור זאָל זײער נאָמען זײַן אױסגעמעקט.<verse eid="PSA 109:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 109:14" />זאָל די זינד פֿון זײַנע פֿאָטערס דערמאָנט װערן פֿאַר ה׳,</para>
  <para style="q" vid="PSA 109:14">און דער חטא פֿון זײַן מוטער זאָל נישט פֿאַרמעקט װערן;<verse eid="PSA 109:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 109:15" />זײ זאָלן זײַן אַנטקעגן ה׳ תּמיד,</para>
  <para style="q" vid="PSA 109:15">און ער זאָל פֿאַרשנײַדן פֿון דער ערד זײער געדעכעניש.<verse eid="PSA 109:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 109:16" />פֿאַר װאָס ער האָט נישט געדאַכט צו טאָן חֶסֶד,</para>
  <para style="q" vid="PSA 109:16">און ער האָט גערודפֿט דעם אָרעמאַן און דעם אבֿיון,</para>
  <para style="q" vid="PSA 109:16">און דעם װאָס זײַן האַרץ איז באַטריבט, צו טײטן.<verse eid="PSA 109:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 109:17" />יאָ, ער האָט ליב געהאַט די קללה,</para>
  <para style="q" vid="PSA 109:17">טאָ זאָל זי אים אָנקומען;</para>
  <para style="q" vid="PSA 109:17">און ער האָט נישט געװוּנטשן קײן ברכה,</para>
  <para style="q" vid="PSA 109:17">טאָ זאָל זי װײַט זײַן פֿון אים.<verse eid="PSA 109:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 109:18" />און ער האָט אָנגעטאָן די קללה װי זײַן קלײד,</para>
  <para style="q" vid="PSA 109:18">טאָ זאָל זי אַרײַן װי װאַסער אין זײַנע אינגעװײד,</para>
  <para style="q" vid="PSA 109:18">און װי אײל אין זײַנע בײנער.<verse eid="PSA 109:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 109:19" />זאָל זי אים זײַן װי אַ בגד װאָס ער טוט אָן,</para>
  <para style="q" vid="PSA 109:19">און פֿאַר אַ גאַרטל זאָל ער עס אָנגורטן תּמיד.<verse eid="PSA 109:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 109:20" />דאָס זאָל זײַן דער לױן פֿון ה׳ צו מײַנע שָׂונאים,</para>
  <para style="q" vid="PSA 109:20">און צו די װאָס רעדן בײז אַקעגן מײַן זעל.<verse eid="PSA 109:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 109:21" />און דו ה׳ אֲדֹנָי, טו מיט מיר פֿון דײַן נאָמען װעגן,</para>
  <para style="q" vid="PSA 109:21">װײַל דײַן חֶסֶד איז גוט, זײַ מיך מציל.<verse eid="PSA 109:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 109:22" />װאָרעם אָרים און באַדערפֿטיק בין איך,</para>
  <para style="q" vid="PSA 109:22">און מײַן האַרץ איז צעלעכערט אין מיר.<verse eid="PSA 109:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 109:23" />אַזױ װי אַ שאָטן װען ער נײַגט זיך, פֿאַרגײ איך,</para>
  <para style="q" vid="PSA 109:23">איך בין אָפּגעטרײסלט געװאָרן װי אַ הײשעריק.<verse eid="PSA 109:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 109:24" />מײַנע קני שטרױכלען פֿון פֿאַסטן,</para>
  <para style="q" vid="PSA 109:24">און מײַן לײַב איז אָפּגעצערט, אָן פֿעטקײט.<verse eid="PSA 109:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 109:25" />און איך בין געװאָרן אַ חרפּה בײַ זײ,</para>
  <para style="q" vid="PSA 109:25">אַז זײ זעען מיך, שאָקלען זײ זײער קאָפּ.<verse eid="PSA 109:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 109:26" />שטײ מיר בײַ, ה׳ מײַן ג-ט,</para>
  <para style="q" vid="PSA 109:26">העלף מיך לױט דײַן גענאָד.<verse eid="PSA 109:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 109:27" />און זאָלן זײ װיסן אַז דאָס איז דײַן האַנט,</para>
  <para style="q" vid="PSA 109:27">אַז דו, ה׳, האָסט דאָס געטאָן.<verse eid="PSA 109:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 109:28" />זאָלן זײ שילטן, און דו זאָלסט בענטשן;</para>
  <para style="q" vid="PSA 109:28">אַז זײ שטײען אױף, זאָלן זײ פֿאַרשעמט װערן,</para>
  <para style="q" vid="PSA 109:28">און דײַן קנעכט זאָל זיך פֿרײען.<verse eid="PSA 109:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 109:29" />זאָלן מײַנע פֿײַנט זיך באַקלײדן מיט שאַנד,</para>
  <para style="q" vid="PSA 109:29">און אָנטאָן װי אַ מאַנטל זײער בושה.<verse eid="PSA 109:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 109:30" />איך װעל געבן גרױס דאַנק צו ה׳ מיט מײַן מױל,</para>
  <para style="q" vid="PSA 109:30">און צװישן פֿיל מענטשן װעל איך אים לױבן.<verse eid="PSA 109:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 109:31" />װאָרעם ער שטײט בײַ דער רעכטער האַנט פֿון באַדערפֿטיקן,</para>
  <para style="q" vid="PSA 109:31">צו העלפֿן פֿון די װאָס פֿאַרמשפּטן זײַן זעל.<verse eid="PSA 109:31" /></para>
  <chapter eid="PSA 109" />
  <chapter number="110" style="c" pubnumber="קי" sid="PSA 110" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 110:1" />פֿון דָוִדן אַ מיזמור.</para>
  <para style="q" vid="PSA 110:1">
    <char style="va">1</char>ה׳ זאָגט צו מײַן האַר:</para>
  <para style="q" vid="PSA 110:1">זיץ בײַ מײַן רעכטער האַנט,</para>
  <para style="q" vid="PSA 110:1">ביז איך װעל מאַכן דײַנע פֿײַנט</para>
  <para style="q" vid="PSA 110:1">פֿאַר אַ בענקל צו דײַנע פֿיס.<verse eid="PSA 110:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 110:2" />דעם צעפּטער פֿון דײַן מאַכט</para>
  <para style="q" vid="PSA 110:2">װעט ה׳ אױסשטרעקן פֿון צִיוֹן;</para>
  <para style="q" vid="PSA 110:2">געװעלטיק צװישן דײַנע פֿײַנט.<verse eid="PSA 110:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 110:3" />דײַן פֿאָלק באָט זיך אָן אין טאָג פֿון דײַן מלחמה;</para>
  <para style="q" vid="PSA 110:3">אין הײליקער שײנקײט,</para>
  <para style="q" vid="PSA 110:3">פֿון טראַכט פֿון באַגינען,</para>
  <para style="q" vid="PSA 110:3">קומט דיר דער טױ פֿון דײַן יוגנט.<verse eid="PSA 110:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 110:4" />ה׳ האָט געשװאָרן, און װעט נישט חרטה האָבן:</para>
  <para style="q" vid="PSA 110:4">ביסט אַ כּהן אױף אײביק,</para>
  <para style="q" vid="PSA 110:4">אױפֿן שטײגער פֿון מַלכּי-צֶדֶק.<verse eid="PSA 110:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 110:5" />אֲדֹנָי בײַ דײַן רעכטער האַנט</para>
  <para style="q" vid="PSA 110:5">צעהאַקט מלכים אין טאָג פֿון זײַן צאָרן.<verse eid="PSA 110:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 110:6" />ער װעט טאָן אַ משפּט צװישן די פֿעלקער;</para>
  <para style="q" vid="PSA 110:6">ער פֿילט אָן מיט טױטע לײַבער;</para>
  <para style="q" vid="PSA 110:6">ער צעהאַקט קעפּ אױף אַ ברײטן לאַנד.<verse eid="PSA 110:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 110:7" />פֿון באַך אױפֿן װעג װעט ער טרינקען;</para>
  <para style="q" vid="PSA 110:7">דערום װעט ער אױפֿהײבן דעם קאָפּ.<verse eid="PSA 110:7" /></para>
  <chapter eid="PSA 110" />
  <chapter number="111" style="c" pubnumber="קיא" sid="PSA 111" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 111:1" />הַלְלוּ יָהּ.</para>
  <para style="q" vid="PSA 111:1">איך װעל לױבן ה׳ מיטן גאַנצן האַרצן,</para>
  <para style="q" vid="PSA 111:1">אין אַ געזעמל פֿון רעכטפֿאַרטיקע און אַן עדה.<verse eid="PSA 111:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 111:2" />די װערק פֿון ה׳ זײַנען גרױס,</para>
  <para style="q" vid="PSA 111:2">זײ װערן געפֿאָרשט פֿון אַלע װאָס גאַרן זײ.<verse eid="PSA 111:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 111:3" />פּראַכט און שײנקײט איז זײַן טוּונג,</para>
  <para style="q" vid="PSA 111:3">און זײַן גערעכטיקײט באַשטײט אױף אײביק.<verse eid="PSA 111:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 111:4" />ער האָט געמאַכט אַן אָנדענק פֿאַר זײַנע װוּנדער;</para>
  <para style="q" vid="PSA 111:4">ה׳ איז דערבאַרעמדיק און לײַטזעליק.<verse eid="PSA 111:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 111:5" />ער גיט שפּײַז צו די װאָס פֿאָרכטן אים,</para>
  <para style="q" vid="PSA 111:5">ער געדענקט אױף אײביק זײַן ברית.<verse eid="PSA 111:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 111:6" />די שטאַרקײט פֿון זײַנע װערק האָט ער געװיזן זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 111:6">כּדי זײ צו געבן די אַרב פֿון די פֿעלקער.<verse eid="PSA 111:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 111:7" />די װערק פֿון זײַנע הענט זײַנען אמת און גערעכטיקײט,</para>
  <para style="q" vid="PSA 111:7">זיכער זײַנען אַלע זײַנע באַפֿעלן;<verse eid="PSA 111:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 111:8" />אױפֿגעהאַלטן אױף אײביק און שטענדיק,</para>
  <para style="q" vid="PSA 111:8">געמאַכט מיט אמת און יושר.<verse eid="PSA 111:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 111:9" />אַן אױסלײזונג האָט ער געשיקט צו זײַן פֿאָלק;</para>
  <para style="q" vid="PSA 111:9">ער האָט באַפֿױלן אױף אײביק זײַן ברית;</para>
  <para style="q" vid="PSA 111:9">הײליק און פֿאָרכטיק איז זײַן נאָמען.<verse eid="PSA 111:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 111:10" />דער אָנהײב פֿון חכמה איז מורא פֿאַר ה׳;</para>
  <para style="q" vid="PSA 111:10">װױלפֿאַרשטאַנדיקײט איז בײַ אַלע װאָס טוען דאָס.</para>
  <para style="q" vid="PSA 111:10">זײַן לױב באַשטײט אײביק.<verse eid="PSA 111:10" /></para>
  <chapter eid="PSA 111" />
  <chapter number="112" style="c" pubnumber="קיב" sid="PSA 112" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 112:1" />הַלְלוּ יָהּ.</para>
  <para style="q" vid="PSA 112:1">װױל צו דעם מאַן װאָס האָט מורא פֿאַר ה׳,</para>
  <para style="q" vid="PSA 112:1">װאָס נאָך זײַנע געבאָט טוט ער גאַרן זײער.<verse eid="PSA 112:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 112:2" />מאַכטיק אין לאַנד װעט זײַן זײַן קינדער;</para>
  <para style="q" vid="PSA 112:2">דער דור פֿון די רעכטפֿאַרטיקע װעט זײַן געבענטשט.<verse eid="PSA 112:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 112:3" />גוטס און עשירות איז בײַ אים אין הױז,</para>
  <para style="q" vid="PSA 112:3">און זײַן גערעכטיקײט באַשטײט אױף אײביק.<verse eid="PSA 112:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 112:4" />ער שײַנט פֿאַר די רעכטפֿאַרטיקע װי אַ ליכט אין דער פֿינצטער,</para>
  <para style="q" vid="PSA 112:4">ער איז לײַטזעליק און דערבאַרעמדיק און גערעכט.<verse eid="PSA 112:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 112:5" />גוט איז דער מאַן װאָס איז לײַטזעליק און לײַט,</para>
  <para style="q" vid="PSA 112:5">װאָס פֿירט זײַנע זאַכן מיט גערעכטיקײט.<verse eid="PSA 112:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 112:6" />װאָרעם ער װעט קײן מאָל נישט אומפֿאַלן;</para>
  <para style="q" vid="PSA 112:6">צו אײביקער געדעכעניש װעט זײַן דער צדיק.<verse eid="PSA 112:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 112:7" />פֿאַר אַ בײזער בשׂורה האָט ער נישט מורא,</para>
  <para style="q" vid="PSA 112:7">פֿעסט איז זײַן האַרץ, ער איז בטוח אױף ה׳.<verse eid="PSA 112:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 112:8" />זיכער איז זײַן האַרץ, ער האָט נישט קײן מורא,</para>
  <para style="q" vid="PSA 112:8">ביז ער זעט זיך אָן אױף זײַנע פֿײַנט.<verse eid="PSA 112:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 112:9" />ער טײלט פֿונאַנדער, ער גיט די באַדערפֿטיקע,</para>
  <para style="q" vid="PSA 112:9">זײַן צדקה באַשטײט אױף אײביק;</para>
  <para style="q" vid="PSA 112:9">זײַן האָרן װעט דערהױבן זײַן אין כּבֿוד.<verse eid="PSA 112:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 112:10" />דער רשע װעט זען און זיך ערגערן,</para>
  <para style="q" vid="PSA 112:10">זײַנע צײן װעט ער קריצן און װעט צעגאַנגען װערן;</para>
  <para style="q" vid="PSA 112:10">דער באַגער פֿון די רשעים װעט אונטערגײן.<verse eid="PSA 112:10" /></para>
  <chapter eid="PSA 112" />
  <chapter number="113" style="c" pubnumber="קיג" sid="PSA 113" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 113:1" />הַלְלוּ יָהּ.</para>
  <para style="q" vid="PSA 113:1">לױבט, איר קנעכט פֿון ה׳,</para>
  <para style="q" vid="PSA 113:1">לױבט דעם נאָמען פֿון ה׳.<verse eid="PSA 113:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 113:2" />זאָל געבענטשט זײַן דער נאָמען פֿון ה׳</para>
  <para style="q" vid="PSA 113:2">פֿון אַצונד און ביז אײביק.<verse eid="PSA 113:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 113:3" />פֿון אױפֿגאַנג פֿון דער זון ביז איר אונטערגאַנג</para>
  <para style="q" vid="PSA 113:3">װערט געלױבט דער נאָמען פֿון ה׳.<verse eid="PSA 113:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 113:4" />ה׳ איז דערהױבן איבער אַלע פֿעלקער,</para>
  <para style="q" vid="PSA 113:4">איבער די הימלען איז זײַן פּראַכט.<verse eid="PSA 113:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 113:5" />װער איז װי ה׳ אלוקינו,</para>
  <para style="q" vid="PSA 113:5">װאָס טראָנט אין דער הײך?<verse eid="PSA 113:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 113:6" />װאָס קוקט אַראָפּ טיף</para>
  <para style="q" vid="PSA 113:6">אױף די הימלען און אױף דער ערד.<verse eid="PSA 113:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 113:7" />ער שטעלט אױף פֿון שטױב דעם אָרעמאַן,</para>
  <para style="q" vid="PSA 113:7">פֿון מיסטן דערהײבט ער דעם אבֿיון,<verse eid="PSA 113:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 113:8" />צו זעצן מיט פֿירשטן,</para>
  <para style="q" vid="PSA 113:8">מיט די פֿירשטן פֿון זײַן פֿאָלק.<verse eid="PSA 113:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 113:9" />ער מאַכט די עקרה זיצן אין הױז</para>
  <para style="q" vid="PSA 113:9">אַ פֿרײלעכע מוטער פֿון קינדער.</para>
  <para style="q" vid="PSA 113:9">הַלְלוּ יָהּ.<verse eid="PSA 113:9" /></para>
  <chapter eid="PSA 113" />
  <chapter number="114" style="c" pubnumber="קיד" sid="PSA 114" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 114:1" />אַז יִשׂרָאֵל איז אַרױס פֿון מִצרַיִם,</para>
  <para style="q" vid="PSA 114:1">דאָס הױז פֿון יעקבֿ פֿון אַ װילדשפּראַכיקן פֿאָלק,<verse eid="PSA 114:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 114:2" />איז יהוּדה געװאָרן פֿאַר זײַן הײליקטום,</para>
  <para style="q" vid="PSA 114:2">יִשׂרָאֵל זײַן געװעלטיקונג.<verse eid="PSA 114:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 114:3" />דער ים האָט דערזען און איז אַנטלאָפֿן,</para>
  <para style="q" vid="PSA 114:3">דער יַרדן האָט אָפּגעטראָטן אַהינטער.<verse eid="PSA 114:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 114:4" />די בערג זײַנען געשפּרונגען װי װידערס,</para>
  <para style="q" vid="PSA 114:4">די הײכן װי יונגע שאָף.<verse eid="PSA 114:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 114:5" />װאָס איז דיר, ים, װאָס דו לױפֿסט?</para>
  <para style="q" vid="PSA 114:5">דו יַרדן, װאָס דו טרעטסט אָפּ אַהינטער?<verse eid="PSA 114:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 114:6" />איר בערג, װאָס איר שפּרינגט װי װידערס?</para>
  <para style="q" vid="PSA 114:6">איר הײכן – װי יונגע שאָף?<verse eid="PSA 114:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 114:7" />פֿאַר אָדוֹן, טו ציטערן, ערד,</para>
  <para style="q" vid="PSA 114:7">פֿאַר דעם אֱלוֹהַּ פֿון יעקבֿ,<verse eid="PSA 114:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 114:8" />װאָס פֿאַרקערט דעם פֿעלדז אין אַ טײַך װאַסער,</para>
  <para style="q" vid="PSA 114:8">קיזלשטײן אין אַ װאַסערקװאַל.<verse eid="PSA 114:8" /></para>
  <chapter eid="PSA 114" />
  <chapter number="115" style="c" pubnumber="קטו" sid="PSA 115" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 115:1" />נישט אונדז, ה׳, נישט אונדז,</para>
  <para style="q" vid="PSA 115:1">נײַערט דײַן נאָמען גיב כּבֿוד,</para>
  <para style="q" vid="PSA 115:1">פֿון װעגן דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 115:1">פֿון װעגן דײַן טרײַשאַפֿט.<verse eid="PSA 115:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="PSA 115:2" />פֿאַר װאָס זאָלן זאָגן די פֿעלקער:</para>
  <para style="q" vid="PSA 115:2">װוּ אַקאָרשט איז זײער ג-ט?<verse eid="PSA 115:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 115:3" />אָבער אלוקינו איז אין הימל,</para>
  <para style="q" vid="PSA 115:3">אַלץ װאָס ער באַגערט, טוט ער.<verse eid="PSA 115:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 115:4" />זײערע געצנבילדער זײַנען זילבער און גאָלד,</para>
  <para style="q" vid="PSA 115:4">דאָס װערק פֿון אַ מענטשנס הענט.<verse eid="PSA 115:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 115:5" />זײ האָבן אַ מױל און רעדן נישט,</para>
  <para style="q" vid="PSA 115:5">זײ האָבן אױגן און זעען נישט;<verse eid="PSA 115:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 115:6" />זײ האָבן אױערן און הערן נישט,</para>
  <para style="q" vid="PSA 115:6">זײ האָבן אַ נאָז און שמעקן נישט;<verse eid="PSA 115:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 115:7" />הענט בײַ זײ, אָבער זײ קענען נישט אָנטאַפּן,</para>
  <para style="q" vid="PSA 115:7">פֿיס בײַ זײ, אָבער זײ גײען נישט;</para>
  <para style="q" vid="PSA 115:7">זײ טוען נישט אַ הױך מיט זײער קעל.<verse eid="PSA 115:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 115:8" />זאָלן װערן װי זײ די װאָס מאַכן זײ,</para>
  <para style="q" vid="PSA 115:8">איטלעכער װאָס פֿאַרזיכערט זיך אױף זײ.<verse eid="PSA 115:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 115:9" />יִשׂרָאֵל, פֿאַרזיכער זיך אױף ה׳.</para>
  <para style="q" vid="PSA 115:9">ער איז זײער הילף און זײער שילד.<verse eid="PSA 115:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 115:10" />הױז פֿון אַהרֹן, פֿאַרזיכערט אײַך אױף ה׳.</para>
  <para style="q" vid="PSA 115:10">ער איז זײער הילף און זײער שילד.<verse eid="PSA 115:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 115:11" />איר פֿאָרכטער פֿון ה׳, פֿאַרזיכערט אײַך אױף ה׳.</para>
  <para style="q" vid="PSA 115:11">ער איז זײער הילף און זײער שילד.<verse eid="PSA 115:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 115:12" />ה׳ האָט געדאַכט אָן אונדז, ער װעט בענטשן,</para>
  <para style="q" vid="PSA 115:12">ער װעט בענטשן דאָס הױז פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="PSA 115:12">ער װעט בענטשן דאָס הױז פֿון אַהרֹן.<verse eid="PSA 115:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 115:13" />ער װעט בענטשן די װאָס פֿאָרכטן ה׳,</para>
  <para style="q" vid="PSA 115:13">די קלײנע אַזױ װי די גרױסע.<verse eid="PSA 115:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 115:14" />ה׳ װעט אײַך מערן,</para>
  <para style="q" vid="PSA 115:14">אײַך און אײַערע קינדער.<verse eid="PSA 115:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 115:15" />געבענטשט זאָלט איר זײַן פֿון ה׳,</para>
  <para style="q" vid="PSA 115:15">דעם באַשעפֿער פֿון הימל און ערד.<verse eid="PSA 115:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="PSA 115:16" />די הימלען זײַנען די הימלען פֿון ה׳,</para>
  <para style="q" vid="PSA 115:16">אָבער די ערד האָט ער געגעבן צו די מענטשנקינדער.<verse eid="PSA 115:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 115:17" />נישט די טױטע װעלן לױבן ה׳,</para>
  <para style="q" vid="PSA 115:17">און נישט די אַלע װאָס נידערן אין שטילן קבֿר.<verse eid="PSA 115:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 115:18" />אָבער מיר װעלן בענטשן ה׳,</para>
  <para style="q" vid="PSA 115:18">פֿון אַצונד און ביז אײביק.</para>
  <para style="q" vid="PSA 115:18">הַלְלוּ יָהּ.<verse eid="PSA 115:18" /></para>
  <chapter eid="PSA 115" />
  <chapter number="116" style="c" pubnumber="קטז" sid="PSA 116" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 116:1" />איך ליב ה׳</para>
  <para style="q" vid="PSA 116:1">װײַל ער האט געהערט מײַן קֹול און מײַנע געבעטן.<verse eid="PSA 116:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 116:2" />װײַל ער האָט גענײגט זײַן אױער צו מיר,</para>
  <para style="q" vid="PSA 116:2">דערום אין מײַנע טעג װעל איך אים רופֿן.<verse eid="PSA 116:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 116:3" />אַרומגערינגלט האָבן מיך די שטריק פֿון טױט,</para>
  <para style="q" vid="PSA 116:3">און אַנגסטן פֿון שְׁאֹול האָבן מיך געטראָפֿן;</para>
  <para style="q" vid="PSA 116:3">לײַד און קומער האָב איך געטראָפֿן.<verse eid="PSA 116:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 116:4" />האָב איך דעם נאָמען פֿון ה׳ גערופֿן:</para>
  <para style="q" vid="PSA 116:4">איך בעט דיך, ה׳, מאַך אַנטרינען מײַן זעל.<verse eid="PSA 116:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 116:5" />לײַטזעליק איז ה׳ און גערעכט,</para>
  <para style="q" vid="PSA 116:5">און אלוקינו איז דערבאַרעמדיק.<verse eid="PSA 116:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 116:6" />ה׳ פֿאַרהיט די אומגעניטע;</para>
  <para style="q" vid="PSA 116:6">איך בין געװען געפֿאַלן, און ער האָט מיך געהאָלפֿן.<verse eid="PSA 116:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 116:7" />קער זיך אום, מײַן זעל, צו דײַן רויִקײט.</para>
  <para style="q" vid="PSA 116:7">װאָרעם ה׳ האָט דיר גוטס געטאָן.<verse eid="PSA 116:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 116:8" />װאָרעם האָסט אַרױסגעצױגן מײַן זעל פֿון טױט,</para>
  <para style="q" vid="PSA 116:8">פֿון טרערן מײַן אױג,</para>
  <para style="q" vid="PSA 116:8">מײַן פֿוס פֿון שטרױכלונג.<verse eid="PSA 116:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 116:9" />איך װעל אומגײן פֿאַר ה׳</para>
  <para style="q" vid="PSA 116:9">אין די לענדער פֿון די לעבעדיקע.<verse eid="PSA 116:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 116:10" />איך האָב געגלױבט, װען איך האָב גערעדט:</para>
  <para style="q" vid="PSA 116:10">איך בין געפּלאָגן געװען זײער.<verse eid="PSA 116:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 116:11" />איך האָב געזאָגט אין מײַן אַנגסט:</para>
  <para style="q" vid="PSA 116:11">אַלע מענטשן זײַנען פֿאַלש.<verse eid="PSA 116:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 116:12" />װי זאָל איך אָפּצאָלן ה׳</para>
  <para style="q" vid="PSA 116:12">אַלע זײַנע טובֿות צו מיר?<verse eid="PSA 116:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 116:13" />דעם כָּוס פֿון ישועות װעל איך אױפֿהײבן,</para>
  <para style="q" vid="PSA 116:13">און דעם נאָמען פֿון ה׳ װעל איך רופֿן,<verse eid="PSA 116:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 116:14" />מײַנע נדרים צו ה׳ װעל איך באַצאָלן</para>
  <para style="q" vid="PSA 116:14">אַנטקעגן פֿאַר זײַן גאַנצן פֿאָלק.<verse eid="PSA 116:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 116:15" />שװער אין די אױגן פֿון ה׳</para>
  <para style="q" vid="PSA 116:15">איז דער טױט פֿון זײַנע פֿרומע.<verse eid="PSA 116:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 116:16" />איך בעט דיך, ה׳, װאָרעם איך בין דײַן קנעכט,</para>
  <para style="q" vid="PSA 116:16">איך בין דײַן קנעכט, דער זון פֿון דײַן דינסט;</para>
  <para style="q" vid="PSA 116:16">האָסט לױזגעמאַכט מײַנע בינדשטריק.<verse eid="PSA 116:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 116:17" />איך װעל שלאַכטן צו דיר אַ דאַנקאָפּפֿער,</para>
  <para style="q" vid="PSA 116:17">און דעם נאָמען פֿון ה׳ װעל איך רופֿן.<verse eid="PSA 116:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 116:18" />מײַנע נדרים צו ה׳ װעל איך באַצאָלן</para>
  <para style="q" vid="PSA 116:18">אַנקעגן פֿאַר זײַן גאַנצן פֿאָלק,<verse eid="PSA 116:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 116:19" />אין די הױפֿן פֿון ה׳ס הױז,</para>
  <para style="q" vid="PSA 116:19">אין מיטן פֿון דיר, ירושָלַיִם.</para>
  <para style="q" vid="PSA 116:19">הַלְלוּ יָהּ.<verse eid="PSA 116:19" /></para>
  <chapter eid="PSA 116" />
  <chapter number="117" style="c" pubnumber="קיז" sid="PSA 117" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 117:1" />לױבט ה׳, אַלע פֿעלקער,</para>
  <para style="q" vid="PSA 117:1">גיט אַ שבֿח צו אים, אַלע אומות,<verse eid="PSA 117:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 117:2" />װאָרעם שטאַרק איז זײַן חֶסֶד אױף אונדז,</para>
  <para style="q" vid="PSA 117:2">און די טרײַשאַפֿט פֿון ה׳ איז אױף אײביק.</para>
  <para style="q" vid="PSA 117:2">הַלְלוּ יָהּ.<verse eid="PSA 117:2" /></para>
  <chapter eid="PSA 117" />
  <chapter number="118" style="c" pubnumber="קיח" sid="PSA 118" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 118:1" />גיט אַ דאַנק צו ה׳, װאָרעם ער איז גוט,</para>
  <para style="q" vid="PSA 118:1">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 118:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 118:2" />זאָל נון זאָגן יִשׂרָאֵל:</para>
  <para style="q" vid="PSA 118:2">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 118:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 118:3" />זאָל נון זאָגן דאָס הױז פֿון אַהרֹן:</para>
  <para style="q" vid="PSA 118:3">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 118:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 118:4" />זאָלן נון זאָגן די װאָס פֿאָרכטן ה׳:</para>
  <para style="q" vid="PSA 118:4">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 118:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 118:5" />פֿון ענגעניש האָב איך גערופֿן ה׳,</para>
  <para style="q" vid="PSA 118:5">האָט ה׳ מיר געענטפֿערט מיט דער ברײטערניש.<verse eid="PSA 118:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 118:6" />ה׳ איז מיט מיר, איך האָב נישט קײן מורא,</para>
  <para style="q" vid="PSA 118:6">װאָס קען אַ מענטש מיר טאָן?<verse eid="PSA 118:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 118:7" />ה׳ איז מיר מײַן העלפֿער,</para>
  <para style="q" vid="PSA 118:7">און איך װעל זען אױף מײַנע שָׂונאים.<verse eid="PSA 118:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 118:8" />בעסער זיך באַשיצן אין ה׳,</para>
  <para style="q" vid="PSA 118:8">אײדער זיך פֿאַרזיכערן אױף אַ מענטשן.<verse eid="PSA 118:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 118:9" />בעסער זיך באַשיצן אין ה׳,</para>
  <para style="q" vid="PSA 118:9">אײדער זיך פֿאַרזיכערן אױף פֿירשטן.<verse eid="PSA 118:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 118:10" />אַלע פֿעלקער האָבן מיך אַרומגערינגלט;</para>
  <para style="q" vid="PSA 118:10">מיט דעם נאָמען פֿון ה׳ אָבער װעל איך זײ פֿאַרשנײַדן.<verse eid="PSA 118:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 118:11" />זײ האָבן מיך אַרומגערינגלט, יאָ אַרומגערינגלט האָבן זײ מיך;</para>
  <para style="q" vid="PSA 118:11">מיט דעם נאָמען פֿון ה׳ אָבער װעל איך זײ פֿאַרשנײַדן.<verse eid="PSA 118:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 118:12" />זײ האָבן מיך אַרומגערינגלט װי בינען;</para>
  <para style="q" vid="PSA 118:12">זײ זײַנען פֿאַרלאָשן געװאָרן װי פֿײַער פֿון דערנער;</para>
  <para style="q" vid="PSA 118:12">פֿאַר װאָר, מיט דעם נאָמען פֿון ה׳ װעל איך זײ פֿאַרשנײַדן.<verse eid="PSA 118:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 118:13" />שטױסן האָסטו מיך געשטױסן צום פֿאַלן,</para>
  <para style="q" vid="PSA 118:13">אָבער ה׳ האָט מיך געהאָלפֿן.<verse eid="PSA 118:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 118:14" />מײַן שטאַרקײט און געזאַנג איז ה׳,</para>
  <para style="q" vid="PSA 118:14">און ער איז מיר געװען אַ ישועה.<verse eid="PSA 118:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 118:15" />אַ קֹול פֿון געזאַנג און ישועה</para>
  <para style="q" vid="PSA 118:15">איז אין די געצעלטן פֿון די צדיקים;</para>
  <para style="q" vid="PSA 118:15">די רעכטע האַנט פֿון ה׳ טוט גבֿורות.<verse eid="PSA 118:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 118:16" />די רעכטע האַנט פֿון ה׳ איז דערהױבן,</para>
  <para style="q" vid="PSA 118:16">די רעכטע האַנט פֿון ה׳ טוט גבֿורות.<verse eid="PSA 118:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 118:17" />איך װעל נישט שטאַרבן נאָר לעבן,</para>
  <para style="q" vid="PSA 118:17">און דערצײלן די מעשׂים פֿון ה׳.<verse eid="PSA 118:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 118:18" />שטראָפֿן געשטראָפֿט האָט מיך ה׳,</para>
  <para style="q" vid="PSA 118:18">אָבער צום טױט האָט ער מיך נישט געגעבן.<verse eid="PSA 118:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 118:19" />עפֿנט מיר די טױערן פֿון גערעכטיקײט,</para>
  <para style="q" vid="PSA 118:19">איך װעל אַרײַנגײן אין זײ, איך װעל דאַנקען ה׳.<verse eid="PSA 118:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 118:20" />דאָס איז דער טױער פֿון ה׳,</para>
  <para style="q" vid="PSA 118:20">די גערעכטע זאָלן אַרײַנגײן אין אים.<verse eid="PSA 118:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 118:21" />איך דאַנק דיר, װאָרעם האָסט מיר געענטפֿערט,</para>
  <para style="q" vid="PSA 118:21">און ביסט מיר געװען אַ ישועה.<verse eid="PSA 118:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 118:22" />דער שטײן װאָס די בױמײַנסטערס האָבן פֿאַרװאַרפֿן,</para>
  <para style="q" vid="PSA 118:22">איז געװאָרן צום הױפּט פֿונעם װינקל.<verse eid="PSA 118:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 118:23" />פֿון ה׳ איז דאָס געשען,</para>
  <para style="q" vid="PSA 118:23">װוּנדערלעך איז עס אין אונדזערע אױגן.<verse eid="PSA 118:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 118:24" />דאָס איז דער טאָג װאָס ה׳ האָט געמאַכט,</para>
  <para style="q" vid="PSA 118:24">לאָמיר לוסטיק זײַן און זיך פֿרײען אין אים.<verse eid="PSA 118:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="PSA 118:25" />איך בעט דיך, ה׳, העלף אַנטקעגנקומען!</para>
  <para style="q" vid="PSA 118:25">איך בעט דיך, ה׳, באַגליק נון!<verse eid="PSA 118:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 118:26" />געבענטשט דער װאָס קומט אין נאָמען פֿון ה׳!</para>
  <para style="q" vid="PSA 118:26">מיר בענטשן אײַך פֿון ה׳ס הױז.<verse eid="PSA 118:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 118:27" />ה׳ איז אֵל, און ער האָט אונדז דערלוכטן;</para>
  <para style="q" vid="PSA 118:27">פֿלעכט אַ טאַנץ מיט צװײַגן</para>
  <para style="q" vid="PSA 118:27">ביז די הערנער פֿון מזבח.<verse eid="PSA 118:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="PSA 118:28" />מײַן ג-ט ביסטו, און איך װעל דיר דאַנקען;</para>
  <para style="q" vid="PSA 118:28">מײַן ג-ט – װעל איך דיך דערהײבן.<verse eid="PSA 118:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 118:29" />גיט אַ דאַנק צו ה׳, װאָרעם ער איז גוט,</para>
  <para style="q" vid="PSA 118:29">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 118:29" /></para>
  <chapter eid="PSA 118" />
  <chapter number="119" style="c" pubnumber="קיט" sid="PSA 119" />
  <para style="qa">אַ</para>
  <para style="q">
    <verse number="1" style="v" sid="PSA 119:1" />װױל צו די װאָס זײער װעג איז ערלעך,</para>
  <para style="q" vid="PSA 119:1">װאָס גײען אין דער תּורה פֿון ה׳.<verse eid="PSA 119:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 119:2" />װױל צו די װאָס היטן זײַנע צײגנים,</para>
  <para style="q" vid="PSA 119:2">װאָס זוכן אים מיטן גאַנצן האַרצן,<verse eid="PSA 119:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 119:3" />און זײ טוען נישט קײן אומרעכט,</para>
  <para style="q" vid="PSA 119:3">זײ גײען אין זײַנע װעגן.<verse eid="PSA 119:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 119:4" />האָסט געבאָטן דײַנע באַפֿעלן,</para>
  <para style="q" vid="PSA 119:4">זײ אָפּצוהיטן זײער.<verse eid="PSA 119:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 119:5" />הלװאַי זאָלן פֿעסט זײַן מײַנע װעגן,</para>
  <para style="q" vid="PSA 119:5">צו היטן דײַנע געזעצן!<verse eid="PSA 119:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 119:6" />דענצמאָל װעל איך זיך נישט שעמען.</para>
  <para style="q" vid="PSA 119:6">װען איך קוק אױף אַלע דײַנע געבאָט.<verse eid="PSA 119:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 119:7" />איך װעל דיך לױבן מיט רעכטפֿאַרטיקײט פֿון האַרצן,</para>
  <para style="q" vid="PSA 119:7">װען איך לערן דײַנע גערעכטע משפּטים.<verse eid="PSA 119:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 119:8" />דײַנע געזעצן װעל איך היטן;</para>
  <para style="q" vid="PSA 119:8">זאָלסט מיך נישט פֿאַרלאָזן ביז גאָר.<verse eid="PSA 119:8" /></para>
  <para style="qa">ב</para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 119:9" />מיט װאָס קען אַ יונגער מענטש האַלטן רײן זײַן װעג?</para>
  <para style="q" vid="PSA 119:9">צו זײַן אָפּגעהיט לױט דײַן װאָרט.<verse eid="PSA 119:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 119:10" />מיט מײַן גאַנצן האַרצן האָב איך דיך געזוכט;</para>
  <para style="q" vid="PSA 119:10">לאָז מיך נישט אַװעקבלאָנדזשען פֿון דײַנע געבאָט.<verse eid="PSA 119:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 119:11" />אין מײַן האַרצן האָב איך באַהאַלטן דײַן װאָרט,</para>
  <para style="q" vid="PSA 119:11">כּדי איך זאָל נישט זינדיקן צו דיר.<verse eid="PSA 119:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 119:12" />געלױבט ביסטו, ה׳;</para>
  <para style="q" vid="PSA 119:12">לערן מיך דײַנע געזעצן.<verse eid="PSA 119:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 119:13" />מיט מײַנע ליפּן האָב איך דערצײלט</para>
  <para style="q" vid="PSA 119:13">אַלע משפּטים פֿון דײַן מױל.<verse eid="PSA 119:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 119:14" />מיט דעם װעג פֿון דײַנע צײגנים האָב איך מיך געפֿרײט</para>
  <para style="q" vid="PSA 119:14">װי מיט אַלע עשירות.<verse eid="PSA 119:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 119:15" />איך טראַכט אָן דײַנע באַפֿעלן,</para>
  <para style="q" vid="PSA 119:15">און איך קוק אױף דײַנע װעגן.<verse eid="PSA 119:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 119:16" />מיט דײַנע געזעצן קװיק איך מיך,</para>
  <para style="q" vid="PSA 119:16">איך פֿאַרגעס נישט דײַן װאָרט.<verse eid="PSA 119:16" /></para>
  <para style="qa">ג</para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 119:17" />באַשער דײַן קנעכט, איך זאָל לעבן,</para>
  <para style="q" vid="PSA 119:17">און איך װעל היטן דײַן װאָרט.<verse eid="PSA 119:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 119:18" />אַנטפּלעק מײַנע אױגן, איך זאָל זען</para>
  <para style="q" vid="PSA 119:18">די װוּנדער פֿון דײַן תּורה.<verse eid="PSA 119:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 119:19" />אַ פֿרעמדער בין איך אױף דער ערד;</para>
  <para style="q" vid="PSA 119:19">נישט פֿאַרבאָרג פֿון מיר דײַנע געבאָט.<verse eid="PSA 119:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 119:20" />צעבראָכן איז מײַן זעל פֿון גלוסטעניש</para>
  <para style="q" vid="PSA 119:20">נאָך דײַנע משפּטים אין יעטװעדער צײַט.<verse eid="PSA 119:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 119:21" />שרײַסט אָן אױף די פֿאַרשאָלטענע מוטװיליקע,</para>
  <para style="q" vid="PSA 119:21">װאָס בלאָנדזשען אַװעק פֿון דײַנע געבאָט.<verse eid="PSA 119:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 119:22" />קײַקל אַראָפּ פֿון מיר שאַנד און בזיון,</para>
  <para style="q" vid="PSA 119:22">װאָרעם דײַנע צײגנים האָב איך געהיט.<verse eid="PSA 119:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 119:23" />הגם האַרן זיצן און רעדן קעגן מיר,</para>
  <para style="q" vid="PSA 119:23">טראַכט דײַן קנעכט אָן דײַנע געזעצן,<verse eid="PSA 119:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 119:24" />יאָ, דײַנע צײגנים זײַנען מײַן קװיקונג,</para>
  <para style="q" vid="PSA 119:24">די עצה-געבער מײַנע.<verse eid="PSA 119:24" /></para>
  <para style="qa">ד</para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 119:25" />באַהעפֿט צום שטױב איז מײַן זעל;</para>
  <para style="q" vid="PSA 119:25">לעב מיך אױף לױט דײַן װאָרט.<verse eid="PSA 119:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="PSA 119:26" />איך האָב דערצײלט מײַנע װעגן,</para>
  <para style="q" vid="PSA 119:26">און דו האָסט מיר געענטפֿערט.</para>
  <para style="q" vid="PSA 119:26">לערן מיך דײַנע געזעצן.<verse eid="PSA 119:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="PSA 119:27" />דעם װעג פֿון דײַנע באַפֿעלן מאַך מיך פֿאַרשטײן,</para>
  <para style="q" vid="PSA 119:27">און איך װעל רעדן פֿון דײַנע װוּנדער.<verse eid="PSA 119:27" /></para>
  <para style="q">
    <verse number="28" style="v" sid="PSA 119:28" />מײַן זעל טרערט פֿון קומער;</para>
  <para style="q" vid="PSA 119:28">ריכט מיך אױף לױט דײַן װאָרט.<verse eid="PSA 119:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="PSA 119:29" />דעם װעג פֿון ליגן טו אָפּ פֿון מיר,</para>
  <para style="q" vid="PSA 119:29">און מיט דײַן תּורה לײַטזעליק מיך.<verse eid="PSA 119:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="PSA 119:30" />דעם דרך אמוּנה האָב איך אױסגעװײלט,</para>
  <para style="q" vid="PSA 119:30">דײַנע משפּטים האָב איך געהאַלטן פֿאַר מיר.<verse eid="PSA 119:30" /></para>
  <para style="q">
    <verse number="31" style="v" sid="PSA 119:31" />איך בין באַהעפֿט אָן דײַנע צײגנים;</para>
  <para style="q" vid="PSA 119:31">ה׳, זאָלסט מיך נישט פֿאַרשעמען.<verse eid="PSA 119:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="PSA 119:32" />אין דעם װעג פֿון דײַנע געבאָט טו איך לױפֿן,</para>
  <para style="q" vid="PSA 119:32">װאָרעם דו דערברײטערסט מײַן האַרץ.<verse eid="PSA 119:32" /></para>
  <para style="qa">ה</para>
  <para style="q">
    <verse number="33" style="v" sid="PSA 119:33" />לערן מיך, ה׳, דעם װעג פֿון דײַנע געזעצן,</para>
  <para style="q" vid="PSA 119:33">און איך װעל אים היטן ביז לעצט.<verse eid="PSA 119:33" /></para>
  <para style="q">
    <verse number="34" style="v" sid="PSA 119:34" />מאַך מיך פֿאַרשטײן, כּדי איך זאָל היטן דײַן תּורה,</para>
  <para style="q" vid="PSA 119:34">און זי האַלטן מיטן גאַנצן האַרצן.<verse eid="PSA 119:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="PSA 119:35" />פֿיר מיך אין דעם שטעג פֿון דײַנע געבאָט,</para>
  <para style="q" vid="PSA 119:35">װאָרעם נאָך אים האָב איך געגאַרט.<verse eid="PSA 119:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="PSA 119:36" />נײַג מײַן האַרץ צו דײַנע צײגנים,</para>
  <para style="q" vid="PSA 119:36">און נישט צו גײַציקײט.<verse eid="PSA 119:36" /></para>
  <para style="q">
    <verse number="37" style="v" sid="PSA 119:37" />נעם אַװעק מײַנע אױגן פֿון קוקן אױף נישטיקײט;</para>
  <para style="q" vid="PSA 119:37">אין דײַנע װעגן לעב מיך אױף.<verse eid="PSA 119:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="PSA 119:38" />זײַ מקײם צו דײַן קנעכט דײַן צוזאָג</para>
  <para style="q" vid="PSA 119:38">װאָס צו דײַנע פֿאָרכטער.<verse eid="PSA 119:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="PSA 119:39" />טו אָפּ מײַן שאַנד װאָס איך שרעק מיך דערפֿאַר,</para>
  <para style="q" vid="PSA 119:39">װאָרעם דײַנע משפּטים זײַנען גוט.<verse eid="PSA 119:39" /></para>
  <para style="q">
    <verse number="40" style="v" sid="PSA 119:40" />זע, איך האָב געשמאַכט נאָך דײַנע באַפֿעלן;</para>
  <para style="q" vid="PSA 119:40">אין דײַן גערעכטיקײט לעב מיך אױף.<verse eid="PSA 119:40" /></para>
  <para style="qa">ו</para>
  <para style="q">
    <verse number="41" style="v" sid="PSA 119:41" />און זאָלן קומען דײַנע חסדים אױף מיר, ה׳,</para>
  <para style="q" vid="PSA 119:41">דײַן הילף לױט דײַן צוזאָג,<verse eid="PSA 119:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="PSA 119:42" />אַז איך זאָל קענען ענטפֿערן מײַן לעסטערער אַ װאָרט;</para>
  <para style="q" vid="PSA 119:42">װאָרעם איך האָב מיך פֿאַרזיכערט אױף דײַן װאָרט.<verse eid="PSA 119:42" /></para>
  <para style="q">
    <verse number="43" style="v" sid="PSA 119:43" />און זאָלסט נישט אָפּרײַסן אין גאַנצן</para>
  <para style="q" vid="PSA 119:43">פֿון מײַן מױל דאָס װאָרט פֿון אמת,</para>
  <para style="q" vid="PSA 119:43">װאָרעם אױף דײַנע משפּטים האָב איך געהאַרט.<verse eid="PSA 119:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="PSA 119:44" />און איך װעל תּמיד היטן דײַן תּורה,</para>
  <para style="q" vid="PSA 119:44">אױף אײביק און שטענדיק.<verse eid="PSA 119:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="PSA 119:45" />און לאָמיך אומגײן אין דערברײטערניש</para>
  <para style="q" vid="PSA 119:45">װאָרעם דײַנע באַפֿעלן האָב איך געזוכט.<verse eid="PSA 119:45" /></para>
  <para style="q">
    <verse number="46" style="v" sid="PSA 119:46" />און איך װעל רעדן פֿון דײַנע צײגנים פֿאַר מלכים,</para>
  <para style="q" vid="PSA 119:46">און איך װעל מיך נישט שעמען.<verse eid="PSA 119:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="PSA 119:47" />און איך װעל מיך קװיקן מיט דײַנע געבאָט</para>
  <para style="q" vid="PSA 119:47">װאָס איך האָב ליב.<verse eid="PSA 119:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="PSA 119:48" />און איך װעל אױפֿהײבן מײַנע הענט צו דײַנע געבאָט</para>
  <para style="q" vid="PSA 119:48">װאָס איך האָב ליב,</para>
  <para style="q" vid="PSA 119:48">און איך װעל טראַכטן אָן דײַנע געזעצן.<verse eid="PSA 119:48" /></para>
  <para style="qa">ז</para>
  <para style="q">
    <verse number="49" style="v" sid="PSA 119:49" />געדענק דאָס װאָרט צו דײַן קנעכט,</para>
  <para style="q" vid="PSA 119:49">װעדליק דו האָסט מיך געמאַכט האָפֿן.<verse eid="PSA 119:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="PSA 119:50" />דאָס איז מײַן טרײסט אין מײַן פּײַן,</para>
  <para style="q" vid="PSA 119:50">װאָס דײַן צוזאָג לעבט מיך אױף.<verse eid="PSA 119:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="PSA 119:51" />די מוטװיליקע האָבן געשפּעט פֿון מיר זײער –</para>
  <para style="q" vid="PSA 119:51">פֿון דײַן תּורה האָב איך זיך נישט אָפּגענײגט.<verse eid="PSA 119:51" /></para>
  <para style="q">
    <verse number="52" style="v" sid="PSA 119:52" />איך האָב געדאַכט, ה׳, אָן דײַנע משפּטים פֿון אײביק אָן,</para>
  <para style="q" vid="PSA 119:52">און איך האָב מיך געטרײסט.<verse eid="PSA 119:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="PSA 119:53" />אַ ברענעדיקער צאָרן האָט מיך אָנגענומען,</para>
  <para style="q" vid="PSA 119:53">פֿון װעגן די רשעים װאָס פֿאַרלאָזן דײַן תּורה.<verse eid="PSA 119:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="PSA 119:54" />געזאַנגען זײַנען מיר געװען דײַנע געזעצן</para>
  <para style="q" vid="PSA 119:54">אין הױז פֿון מײַן פֿאַרפֿרעמדטקײט.<verse eid="PSA 119:54" /></para>
  <para style="q">
    <verse number="55" style="v" sid="PSA 119:55" />איך האָב דערמאָנט בײַ נאַכט דײַן נאָמען, ה׳,</para>
  <para style="q" vid="PSA 119:55">און איך האָב געהיט דײַן תּורה.<verse eid="PSA 119:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="PSA 119:56" />דאָס האָב איך געהאַט:</para>
  <para style="q" vid="PSA 119:56">װאָס איך האָב געהאַלטן דײַנע באַפֿעלן.<verse eid="PSA 119:56" /></para>
  <para style="qa">ח</para>
  <para style="q">
    <verse number="57" style="v" sid="PSA 119:57" />מײַן טײל, ה׳, האָב איך געזאָגט,</para>
  <para style="q" vid="PSA 119:57">איז צו היטן דײַנע װערטער.<verse eid="PSA 119:57" /></para>
  <para style="q">
    <verse number="58" style="v" sid="PSA 119:58" />איך האָב געבעטן בײַ דיר מיטן גאַנצן האַרצן:</para>
  <para style="q" vid="PSA 119:58">לײַטזעליק מיך לױט דײַן צוזאָג.<verse eid="PSA 119:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="PSA 119:59" />איך האָב באַרעכנט מײַנע װעגן,</para>
  <para style="q" vid="PSA 119:59">און געקערט מײַנע פֿיס צו דײַנע צײגנים.<verse eid="PSA 119:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="PSA 119:60" />איך האָב זיך געאײַלט און נישט געזאַמט</para>
  <para style="q" vid="PSA 119:60">צו היטן דײַנע געבאָט.<verse eid="PSA 119:60" /></para>
  <para style="q">
    <verse number="61" style="v" sid="PSA 119:61" />די שטריק פֿון די רשעים האָבן מיך אַרומגעקניפּט –</para>
  <para style="q" vid="PSA 119:61">דײַן תּורה האָב איך נישט פֿאַרגעסן.<verse eid="PSA 119:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="PSA 119:62" />האַלבע נאַכט שטײ איך אױף דיר צו דאַנקען</para>
  <para style="q" vid="PSA 119:62">פֿאַר דײַנע גערעכטע משפּטים.<verse eid="PSA 119:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="PSA 119:63" />אַ חבֿר בין איך צו אַלע װאָס פֿאָרכטן דיך,</para>
  <para style="q" vid="PSA 119:63">און צו די װאָס היטן דײַנע באַפֿעלן.<verse eid="PSA 119:63" /></para>
  <para style="q">
    <verse number="64" style="v" sid="PSA 119:64" />דײַן חֶסֶד, ה׳, איז פֿול די ערד;</para>
  <para style="q" vid="PSA 119:64">לערן מיך דײַנע געזעצן.<verse eid="PSA 119:64" /></para>
  <para style="qa">ט</para>
  <para style="q">
    <verse number="65" style="v" sid="PSA 119:65" />האָסט געטאָן גוטס מיט דײַן קנעכט, ה׳,</para>
  <para style="q" vid="PSA 119:65">לױט דײַן װאָרט.<verse eid="PSA 119:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="PSA 119:66" />װױלפֿאַרשטאַנדיקײט און װיסן לערן מיך,</para>
  <para style="q" vid="PSA 119:66">װאָרעם איך גלױב אין דײַנע געבאָט.<verse eid="PSA 119:66" /></para>
  <para style="q">
    <verse number="67" style="v" sid="PSA 119:67" />אײדער איך האָב געליטן פֿלעג איך פֿאַרזען,</para>
  <para style="q" vid="PSA 119:67">אָבער אַצונד טו איך היטן דײַן װאָרט.<verse eid="PSA 119:67" /></para>
  <para style="q">
    <verse number="68" style="v" sid="PSA 119:68" />אַ גוטער ביסטו און אַ באַגיטיקער;</para>
  <para style="q" vid="PSA 119:68">לערן מיך דײַנע געזעצן.<verse eid="PSA 119:68" /></para>
  <para style="q">
    <verse number="69" style="v" sid="PSA 119:69" />די מוטװיליקע האָבן אָנגעשמירט אױף מיר ליגן;</para>
  <para style="q" vid="PSA 119:69">איך היט מיטן גאַנצן האַרצן דײַנע באַפֿעלן.<verse eid="PSA 119:69" /></para>
  <para style="q">
    <verse number="70" style="v" sid="PSA 119:70" />פֿאַרשטאָפּט װי פֿעטס איז זײער האַרץ;</para>
  <para style="q" vid="PSA 119:70">איך האָב מיך געקװיקט מיט דײַן תּורה.<verse eid="PSA 119:70" /></para>
  <para style="q">
    <verse number="71" style="v" sid="PSA 119:71" />װױל איז צו מיר װאָס איך בין געפּײַניקט געװאָרן,</para>
  <para style="q" vid="PSA 119:71">כּדי איך זאָל לערנען דײַנע געזעצן.<verse eid="PSA 119:71" /></para>
  <para style="q">
    <verse number="72" style="v" sid="PSA 119:72" />מיר איז בעסער די תּורה פֿון דײַן מױל</para>
  <para style="q" vid="PSA 119:72">אײדער טױזנטן גאָלד און זילבער.<verse eid="PSA 119:72" /></para>
  <para style="qa">י</para>
  <para style="q">
    <verse number="73" style="v" sid="PSA 119:73" />דײַנע הענט האָבן מיך געשאַפֿן און מיך געפֿורעמט;</para>
  <para style="q" vid="PSA 119:73">מאַך מיך פֿאַרשטײן, כּדי איך זאָל לערנען דײַנע געבאָט.<verse eid="PSA 119:73" /></para>
  <para style="q">
    <verse number="74" style="v" sid="PSA 119:74" />דײַנע פֿאָרכטער װעלן מיך זען און זיך פֿרײען,</para>
  <para style="q" vid="PSA 119:74">װאָרעם אױף דײַן װאָרט האָב איך געהאַרט.<verse eid="PSA 119:74" /></para>
  <para style="q">
    <verse number="75" style="v" sid="PSA 119:75" />איך װײס, ה׳, אַז גערעכט זײַנען דײַנע משפּטים,</para>
  <para style="q" vid="PSA 119:75">און אױס טרײַשאַפֿט האָסטו מיך געפּײַניקט.<verse eid="PSA 119:75" /></para>
  <para style="q">
    <verse number="76" style="v" sid="PSA 119:76" />זאָל זײַן, איך בעט דיך, דײַן חֶסֶד מיך צו טרײסטן,</para>
  <para style="q" vid="PSA 119:76">אַזױ װי דײַן צוזאָג צו דײַן קנעכט.<verse eid="PSA 119:76" /></para>
  <para style="q">
    <verse number="77" style="v" sid="PSA 119:77" />זאָל קומען אױף מיר דײַן דערבאַרעמונג, כּדי איך זאָל לעבן,</para>
  <para style="q" vid="PSA 119:77">װאָרעם דײַן תּורה איז מײַן קװיקונג.<verse eid="PSA 119:77" /></para>
  <para style="q">
    <verse number="78" style="v" sid="PSA 119:78" />זאָלן פֿאַרשעמט װערן די מוטװיליקע,</para>
  <para style="q" vid="PSA 119:78">װײַל זײ האָבן מיך געקריװדעט אומנישט;</para>
  <para style="q" vid="PSA 119:78">איך װעל טראַכטן אָן דײַנע באַפֿעלן.<verse eid="PSA 119:78" /></para>
  <para style="q">
    <verse number="79" style="v" sid="PSA 119:79" />זאָלן זיך קערן צו מיר די װאָס פֿאָרכטן דיך,</para>
  <para style="q" vid="PSA 119:79">און די װאָס װײסן דײַנע צײגנים.<verse eid="PSA 119:79" /></para>
  <para style="q">
    <verse number="80" style="v" sid="PSA 119:80" />זאָל מײַן האַרץ זײַן גאַנץ אין דײַנע געזעצן,</para>
  <para style="q" vid="PSA 119:80">כּדי איך זאָל נישט פֿאַרשעמט װערן.<verse eid="PSA 119:80" /></para>
  <para style="qa">כ</para>
  <para style="q">
    <verse number="81" style="v" sid="PSA 119:81" />מײַן זעל גײט אױס נאָך דײַן הילף,</para>
  <para style="q" vid="PSA 119:81">אױף דײַן װאָרט טו איך האַרן.<verse eid="PSA 119:81" /></para>
  <para style="q">
    <verse number="82" style="v" sid="PSA 119:82" />מײַנע אױגן גײען אױס נאָך דײַן צוזאָג,</para>
  <para style="q" vid="PSA 119:82">אַזױ צו זאָגן: װען װעסטו מיך טרײסטן?<verse eid="PSA 119:82" /></para>
  <para style="q">
    <verse number="83" style="v" sid="PSA 119:83" />הגם איך בין געװאָרן װי אַ לאָגל אין רױך,</para>
  <para style="q" vid="PSA 119:83">האָב איך דײַנע געזעצן נישט פֿאַרגעסן.<verse eid="PSA 119:83" /></para>
  <para style="q">
    <verse number="84" style="v" sid="PSA 119:84" />װי פֿיל זײַנען די טעג פֿון דײַן קנעכט?</para>
  <para style="q" vid="PSA 119:84">װען װעסטו אַ משפּט טאָן אױף מײַנע נאָכיאָגער?<verse eid="PSA 119:84" /></para>
  <para style="q">
    <verse number="85" style="v" sid="PSA 119:85" />די מוטװיליקע האָבן מיר געגראָבן גריבער,</para>
  <para style="q" vid="PSA 119:85">װאָס איז נישט לױט דײַן תּורה.<verse eid="PSA 119:85" /></para>
  <para style="q">
    <verse number="86" style="v" sid="PSA 119:86" />אַלע דײַנע געבאָט זײַנען װאָרהאַפֿטיק;</para>
  <para style="q" vid="PSA 119:86">אומנישט האָבן זײ מיך גערודפֿט; העלף מיך.<verse eid="PSA 119:86" /></para>
  <para style="q">
    <verse number="87" style="v" sid="PSA 119:87" />זײ האָבן מיך שיר פֿאַרלענדט אױף דער ערד,</para>
  <para style="q" vid="PSA 119:87">אָבער איך האָב נישט פֿאַרלאָזן דײַנע באַפֿעלן.<verse eid="PSA 119:87" /></para>
  <para style="q">
    <verse number="88" style="v" sid="PSA 119:88" />לעב מיך אױף לױט דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 119:88">און איך װעל היטן דעם צײגנים פֿון דײַן מױל.<verse eid="PSA 119:88" /></para>
  <para style="qa">ל</para>
  <para style="q">
    <verse number="89" style="v" sid="PSA 119:89" />אױף אײביק, ה׳,</para>
  <para style="q" vid="PSA 119:89">באַשטײט דײַן װאָרט אין הימל.<verse eid="PSA 119:89" /></para>
  <para style="q">
    <verse number="90" style="v" sid="PSA 119:90" />אױף דור-דורות איז דײַן טרײַשאַפֿט;</para>
  <para style="q" vid="PSA 119:90">האָסט באַפֿעסטיקט די ערד, און זי שטײט.<verse eid="PSA 119:90" /></para>
  <para style="q">
    <verse number="91" style="v" sid="PSA 119:91" />לױט דײַנע געזעצן שטײען זײ הײַנט,</para>
  <para style="q" vid="PSA 119:91">װאָרעם אַלע זאַכן זײַנען דײַנע קנעכט.<verse eid="PSA 119:91" /></para>
  <para style="q">
    <verse number="92" style="v" sid="PSA 119:92" />װען נישט דײַן תּורה איז מײַן קװיקונג,</para>
  <para style="q" vid="PSA 119:92">װאָלט איך אונטערגעגאַנגען אין מײַן פּײַן.<verse eid="PSA 119:92" /></para>
  <para style="q">
    <verse number="93" style="v" sid="PSA 119:93" />איך װעל אײביק נישט פֿאַרגעסן דײַנע באַפֿעלן,</para>
  <para style="q" vid="PSA 119:93">װאָרעם מיט זײ האָסטו מיך אױפֿגעלעבט.<verse eid="PSA 119:93" /></para>
  <para style="q">
    <verse number="94" style="v" sid="PSA 119:94" />דײַנער בין איך, העלף מיך,</para>
  <para style="q" vid="PSA 119:94">װאָרעם דײַנע באַפֿעלן האָב איך געפֿאָרשט.<verse eid="PSA 119:94" /></para>
  <para style="q">
    <verse number="95" style="v" sid="PSA 119:95" />די רשעים האָבן אױסגעקוקט אױף מיר, מיך אונטערצוברענגען;</para>
  <para style="q" vid="PSA 119:95">איך קליג מיך אין דײַנע צײגנים.<verse eid="PSA 119:95" /></para>
  <para style="q">
    <verse number="96" style="v" sid="PSA 119:96" />צו יעטװעדער שטרעבונג האָב איך געזען אַן ענד –</para>
  <para style="q" vid="PSA 119:96">דײַנע געבאָט זײַנען ברײט ביז גאָר.<verse eid="PSA 119:96" /></para>
  <para style="qa">מ</para>
  <para style="q">
    <verse number="97" style="v" sid="PSA 119:97" />װי ליב איך האָב דײַן תּורה!</para>
  <para style="q" vid="PSA 119:97">אַ גאַנצן טאָג איז זי מײַן טראַכטונג.<verse eid="PSA 119:97" /></para>
  <para style="q">
    <verse number="98" style="v" sid="PSA 119:98" />קליגער פֿון מײַנע פֿײַנט מאַכן מיך דײַנע געבאָט,</para>
  <para style="q" vid="PSA 119:98">װאָרעם זײ זײַנען אײביק בײַ מיר.<verse eid="PSA 119:98" /></para>
  <para style="q">
    <verse number="99" style="v" sid="PSA 119:99" />פֿון אַלע מײַנע לערער בין איך פֿאַרשטאַנדיקער,</para>
  <para style="q" vid="PSA 119:99">װאָרעם דײַנע צײגנים זײַנען מײַן טראַכטונג.<verse eid="PSA 119:99" /></para>
  <para style="q">
    <verse number="100" style="v" sid="PSA 119:100" />מער פֿון זקנים פֿאַרשטײ איך,</para>
  <para style="q" vid="PSA 119:100">װײַל דײַנע באַפֿעלן האָב איך געהאַלטן.<verse eid="PSA 119:100" /></para>
  <para style="q">
    <verse number="101" style="v" sid="PSA 119:101" />פֿון יעטװעדער בײזן װעג פֿאַרמײַד איך מײַנע פֿיס,</para>
  <para style="q" vid="PSA 119:101">כּדי איך זאָל היטן דײַן װאָרט.<verse eid="PSA 119:101" /></para>
  <para style="q">
    <verse number="102" style="v" sid="PSA 119:102" />פֿון דײַנע געזעצן האָב איך נישט אָפּגעקערט,</para>
  <para style="q" vid="PSA 119:102">װאָרעם דו האָסט מיך געלערנט.<verse eid="PSA 119:102" /></para>
  <para style="q">
    <verse number="103" style="v" sid="PSA 119:103" />װי זיס זײַנען דײַנע װערטער צו מײַן גומען,</para>
  <para style="q" vid="PSA 119:103">מער פֿון האָניק פֿאַר מײַן מױל!<verse eid="PSA 119:103" /></para>
  <para style="q">
    <verse number="104" style="v" sid="PSA 119:104" />פֿון דײַנע באַפֿעלן װער איך פֿאַרשטאַנדיק,</para>
  <para style="q" vid="PSA 119:104">דערום האָב איך פֿײַנט יעטװעדער װעג פֿון ליגן.<verse eid="PSA 119:104" /></para>
  <para style="qa">נ</para>
  <para style="q">
    <verse number="105" style="v" sid="PSA 119:105" />אַ ליכט פֿאַר מײַן פֿוס איז דײַן װאָרט,</para>
  <para style="q" vid="PSA 119:105">און אַ ליכטיקײט פֿאַר מײַן שטעג.<verse eid="PSA 119:105" /></para>
  <para style="q">
    <verse number="106" style="v" sid="PSA 119:106" />איך האָב געשװאָרן, און האָב מקײם געװען,</para>
  <para style="q" vid="PSA 119:106">צו היטן דײַנע גערעכטע משפּטים.<verse eid="PSA 119:106" /></para>
  <para style="q">
    <verse number="107" style="v" sid="PSA 119:107" />איך בין געדריקט ביז גאָר,</para>
  <para style="q" vid="PSA 119:107">ה׳, לעב מיך אױף לױט דײַן װאָרט.<verse eid="PSA 119:107" /></para>
  <para style="q">
    <verse number="108" style="v" sid="PSA 119:108" />די פֿרײַגאָבן פֿון מײַן מױל באַװיליק, איך בעט דיך, ה׳,</para>
  <para style="q" vid="PSA 119:108">און דײַנע משפּטים לערן מיך.<verse eid="PSA 119:108" /></para>
  <para style="q">
    <verse number="109" style="v" sid="PSA 119:109" />מײַן נפֿש איז תּמיד אין מײַן האַנט,</para>
  <para style="q" vid="PSA 119:109">אָבער דײַן תּורה האָב איך נישט פֿאַרגעסן.<verse eid="PSA 119:109" /></para>
  <para style="q">
    <verse number="110" style="v" sid="PSA 119:110" />די רשעים האָבן מיר אַ פּאַסטקע געשטעלט,</para>
  <para style="q" vid="PSA 119:110">אָבער פֿון דײַנע באַפֿעלן האָב איך נישט אַװעקגעבלאָנדזשעט.<verse eid="PSA 119:110" /></para>
  <para style="q">
    <verse number="111" style="v" sid="PSA 119:111" />איך האָב געמאַכט דײַנע צײגנים פֿאַר מײַן אײביקער אַרב,</para>
  <para style="q" vid="PSA 119:111">װאָרעם זײ זײַנען די פֿרײד פֿון מײַן האַרצן.<verse eid="PSA 119:111" /></para>
  <para style="q">
    <verse number="112" style="v" sid="PSA 119:112" />איך האָב גענײגט מײַן האַרץ צו טאָן דײַנע געזעצן</para>
  <para style="q" vid="PSA 119:112">תּמיד ביז לעצט.<verse eid="PSA 119:112" /></para>
  <para style="qa">ס</para>
  <para style="q">
    <verse number="113" style="v" sid="PSA 119:113" />צװײפֿלער האָב איך פֿײַנט,</para>
  <para style="q" vid="PSA 119:113">נאָר דײַן תּורה האָב איך ליב.<verse eid="PSA 119:113" /></para>
  <para style="q">
    <verse number="114" style="v" sid="PSA 119:114" />מײַן פֿאַרבאָרגעניש און מײַן שילד ביסטו,</para>
  <para style="q" vid="PSA 119:114">אױף דײַן װאָרט טו איך האַרן.<verse eid="PSA 119:114" /></para>
  <para style="q">
    <verse number="115" style="v" sid="PSA 119:115" />קערט אײַך אָפּ פֿון מיר, איר שלעכטסטוער,</para>
  <para style="q" vid="PSA 119:115">כּדי איך זאָל היטן די געבאָט פֿון מײַן ג-ט.<verse eid="PSA 119:115" /></para>
  <para style="q">
    <verse number="116" style="v" sid="PSA 119:116" />האַלט מיך אױף לױט דײַן צוזאָג, כּדי איך זאָל לעבן,</para>
  <para style="q" vid="PSA 119:116">און לאָז מיך נישט פֿאַרשעמט װערן אין מײַן האָפֿענונג.<verse eid="PSA 119:116" /></para>
  <para style="q">
    <verse number="117" style="v" sid="PSA 119:117" />לען מיך אונטער, און לאָמיך געהאָלפֿן װערן,</para>
  <para style="q" vid="PSA 119:117">און איך װעל מיך תּמיד פֿאַרנעמען מיט דײַנע געזעצן.<verse eid="PSA 119:117" /></para>
  <para style="q">
    <verse number="118" style="v" sid="PSA 119:118" />פֿאַראַכטסט אַלע װאָס בלאָנדזשען אַװעק פֿון דײַנע געזעצן,</para>
  <para style="q" vid="PSA 119:118">װאָרעם אומזיסט איז זײער אָפּנאַרעניש.<verse eid="PSA 119:118" /></para>
  <para style="q">
    <verse number="119" style="v" sid="PSA 119:119" />װי פּסולת שאַפֿסטו אָפּ אַלע רשעים פֿון דער ערד,</para>
  <para style="q" vid="PSA 119:119">דערום האָב איך ליב דײַנע צײגנים.<verse eid="PSA 119:119" /></para>
  <para style="q">
    <verse number="120" style="v" sid="PSA 119:120" />מײַן לײַב שױדערט פֿון אַנגסט פֿאַר דיר,</para>
  <para style="q" vid="PSA 119:120">און פֿאַר דײַנע משפּטים האָב איך מורא.<verse eid="PSA 119:120" /></para>
  <para style="qa">ע</para>
  <para style="q">
    <verse number="121" style="v" sid="PSA 119:121" />איך האָב געטאָן רעכט און גערעכטיקײט;</para>
  <para style="q" vid="PSA 119:121">זאָלסט מיך נישט איבערלאָזן צו מײַנע דריקער.<verse eid="PSA 119:121" /></para>
  <para style="q">
    <verse number="122" style="v" sid="PSA 119:122" />שטעל זיך אײַן פֿאַר דײַן קנעכט צום גוטן,</para>
  <para style="q" vid="PSA 119:122">אַז מיך זאָלן נישט דריקן די מוטװיליקע.<verse eid="PSA 119:122" /></para>
  <para style="q">
    <verse number="123" style="v" sid="PSA 119:123" />מײַנע אױגן גײען אױס נאָך דײַן הילף,</para>
  <para style="q" vid="PSA 119:123">און נאָך דעם װאָרט פֿון דײַן גערעכטיקײט.<verse eid="PSA 119:123" /></para>
  <para style="q">
    <verse number="124" style="v" sid="PSA 119:124" />טו מיט דײַן קנעכט לױט דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 119:124">און דײַנע געזעצן לערן מיך.<verse eid="PSA 119:124" /></para>
  <para style="q">
    <verse number="125" style="v" sid="PSA 119:125" />דײַן קנעכט בין איך; מאַך מיך פֿאַרשטײן,</para>
  <para style="q" vid="PSA 119:125">כּדי איך זאָל װיסן דײַנע צײגנים.<verse eid="PSA 119:125" /></para>
  <para style="q">
    <verse number="126" style="v" sid="PSA 119:126" />עס איז צײַט פֿאַר ה׳ צו טאָן;</para>
  <para style="q" vid="PSA 119:126">זײ האָבן פֿאַרשטערט דײַן תּורה.<verse eid="PSA 119:126" /></para>
  <para style="q">
    <verse number="127" style="v" sid="PSA 119:127" />פֿאַר װאָר, איך האָב ליב דײַנע געבאָט,</para>
  <para style="q" vid="PSA 119:127">מער פֿון גאָלד און פֿון גינגאָלד.<verse eid="PSA 119:127" /></para>
  <para style="q">
    <verse number="128" style="v" sid="PSA 119:128" />דערום האַלט איך פֿאַר ריכטיק אַלע כּלערלײ באַפֿעלן;</para>
  <para style="q" vid="PSA 119:128">יעטװעדער װעג פֿון ליגן האָב איך פֿײַנט.<verse eid="PSA 119:128" /></para>
  <para style="qa">פֿ</para>
  <para style="q">
    <verse number="129" style="v" sid="PSA 119:129" />װוּנדערלעך זײַנען דײַנע צײגנים,</para>
  <para style="q" vid="PSA 119:129">דערום היט זײ מײַן זעל.<verse eid="PSA 119:129" /></para>
  <para style="q">
    <verse number="130" style="v" sid="PSA 119:130" />די אַנטפּלעקונג פֿון דײַנע װערטער מאַכט ליכטיק,</para>
  <para style="q" vid="PSA 119:130">זי מאַכט פֿאַרשטאַנדיק דעם נאַרן.<verse eid="PSA 119:130" /></para>
  <para style="q">
    <verse number="131" style="v" sid="PSA 119:131" />איך האָב אױפֿגעשפּאַרט מײַן מױל און געלעכצט,</para>
  <para style="q" vid="PSA 119:131">װאָרעם נאָך דײַנע געבאָט האָב איך געגאַרט.<verse eid="PSA 119:131" /></para>
  <para style="q">
    <verse number="132" style="v" sid="PSA 119:132" />קער זיך צו מיר, און לײַטזעליק מיך,</para>
  <para style="q" vid="PSA 119:132">װי עס איז רעכט צו די װאָס האָבן ליב דײַן נאָמען.<verse eid="PSA 119:132" /></para>
  <para style="q">
    <verse number="133" style="v" sid="PSA 119:133" />פֿעסטיק מײַנע טריט מיט דײַן װאָרט,</para>
  <para style="q" vid="PSA 119:133">און לאָז נישט געװעלטיקן איבער מיר קײן אומרעכט.<verse eid="PSA 119:133" /></para>
  <para style="q">
    <verse number="134" style="v" sid="PSA 119:134" />לײז מיך אױס פֿון דער דריקונג פֿון מענטשן,</para>
  <para style="q" vid="PSA 119:134">כּדי איך זאָל היטן דײַנע באַפֿעלן.<verse eid="PSA 119:134" /></para>
  <para style="q">
    <verse number="135" style="v" sid="PSA 119:135" />דערלײַכט דײַן פּנים אױף דײַן קנעכט,</para>
  <para style="q" vid="PSA 119:135">און לערן מיך דײַנע געזעצן.<verse eid="PSA 119:135" /></para>
  <para style="q">
    <verse number="136" style="v" sid="PSA 119:136" />בעכן װאַסער האָבן פֿאַרגאָסן מײַנע אױגן,</para>
  <para style="q" vid="PSA 119:136">איבער די װאָס האָבן נישט געהיט דײַן תּורה.<verse eid="PSA 119:136" /></para>
  <para style="qa">צ</para>
  <para style="q">
    <verse number="137" style="v" sid="PSA 119:137" />גערעכט ביסטו, ה׳,</para>
  <para style="q" vid="PSA 119:137">און רעכטפֿאַרטיק זײַנען דײַנע משפּטים.<verse eid="PSA 119:137" /></para>
  <para style="q">
    <verse number="138" style="v" sid="PSA 119:138" />האָסט באַפֿױלן מיט גערעכטיקײט דײַנע צײגנים,</para>
  <para style="q" vid="PSA 119:138">און מיט געטרײַשאַפֿט ביז גאָר.<verse eid="PSA 119:138" /></para>
  <para style="q">
    <verse number="139" style="v" sid="PSA 119:139" />מיך האָט אומגעבראַכט מײַן ערגערניש</para>
  <para style="q" vid="PSA 119:139">װײַל מײַנע פֿײַנט האָבן פֿאַרגעסן דײַנע װערטער.<verse eid="PSA 119:139" /></para>
  <para style="q">
    <verse number="140" style="v" sid="PSA 119:140" />געלײַטערט איז דײַן װאָרט ביז גאָר,</para>
  <para style="q" vid="PSA 119:140">און דײַן קנעכט האָט עס ליב.<verse eid="PSA 119:140" /></para>
  <para style="q">
    <verse number="141" style="v" sid="PSA 119:141" />קלײן בין איך און פֿאַראַכט –</para>
  <para style="q" vid="PSA 119:141">דײַנע באַפֿעלן האָב איך נישט פֿאַרגעסן.<verse eid="PSA 119:141" /></para>
  <para style="q">
    <verse number="142" style="v" sid="PSA 119:142" />דײַן גערעכטיקײט איז אײביק גערעכט,</para>
  <para style="q" vid="PSA 119:142">און דײַן תּורה איז אמת.<verse eid="PSA 119:142" /></para>
  <para style="q">
    <verse number="143" style="v" sid="PSA 119:143" />נױט און אַנגסט האָבן מיך געטראָפֿן –</para>
  <para style="q" vid="PSA 119:143">דײַנע געבאָט זײַנען מײַנע קװיקונגען.<verse eid="PSA 119:143" /></para>
  <para style="q">
    <verse number="144" style="v" sid="PSA 119:144" />גערעכט זײַנען דײַנע צײגנים אױף אײביק;</para>
  <para style="q" vid="PSA 119:144">מאַך מיך פֿאַרשטײן, כּדי איך זאָל לעבן.<verse eid="PSA 119:144" /></para>
  <para style="qa">ק</para>
  <para style="q">
    <verse number="145" style="v" sid="PSA 119:145" />איך האָב גערופֿן מיטן גאַנצן האַרצן;</para>
  <para style="q" vid="PSA 119:145">ענטפֿער מיר, ה׳; דײַנע געזעצן װעל איך האַלטן.<verse eid="PSA 119:145" /></para>
  <para style="q">
    <verse number="146" style="v" sid="PSA 119:146" />איך רוף דיך, העלף מיך,</para>
  <para style="q" vid="PSA 119:146">און איך װעל היטן דײַנע צײגנים.<verse eid="PSA 119:146" /></para>
  <para style="q">
    <verse number="147" style="v" sid="PSA 119:147" />איך האָב מיך געפֿעדערט באַגינען און געשריִען;</para>
  <para style="q" vid="PSA 119:147">אױף דײַן װאָרט האָב איך געהאַרט.<verse eid="PSA 119:147" /></para>
  <para style="q">
    <verse number="148" style="v" sid="PSA 119:148" />מײַנע אױגן זײַנען פֿאַרױסגעלאָפֿן די נאַכטװאַכן,</para>
  <para style="q" vid="PSA 119:148">צו טראַכטן אָן דײַן װאָרט.<verse eid="PSA 119:148" /></para>
  <para style="q">
    <verse number="149" style="v" sid="PSA 119:149" />הער צו מײַן קֹול לױט דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 119:149">ה׳, לעב מיך אױף אַזױ װי דײַן שטײגער.<verse eid="PSA 119:149" /></para>
  <para style="q">
    <verse number="150" style="v" sid="PSA 119:150" />עס גענענען די װאָס יאָגן זיך נאָך שענדלעכקײט;</para>
  <para style="q" vid="PSA 119:150">פֿון דײַן תּורה זײַנען זײ װײַט.<verse eid="PSA 119:150" /></para>
  <para style="q">
    <verse number="151" style="v" sid="PSA 119:151" />דו ביסט נאָנט, ה׳,</para>
  <para style="q" vid="PSA 119:151">און אַלע דײַנע געבאָט זײַנען אמת.<verse eid="PSA 119:151" /></para>
  <para style="q">
    <verse number="152" style="v" sid="PSA 119:152" />פֿון לאַנג אָן האָב איך געװוּסט פֿון דײַנע צײגנים,</para>
  <para style="q" vid="PSA 119:152">אַז דו האָסט זײ אױף אײביק געגרונטפֿעסט.<verse eid="PSA 119:152" /></para>
  <para style="qa">ר</para>
  <para style="q">
    <verse number="153" style="v" sid="PSA 119:153" />זע מײַן פּײַן, און דערלײז מיך,</para>
  <para style="q" vid="PSA 119:153">װאָרעם דײַן תּורה האָב איך נישט פֿאַרגעסן.<verse eid="PSA 119:153" /></para>
  <para style="q">
    <verse number="154" style="v" sid="PSA 119:154" />קריג מײַן קריג, און לײז מיך אױס,</para>
  <para style="q" vid="PSA 119:154">לױט דײַן צוזאָג לעב מיך אױף.<verse eid="PSA 119:154" /></para>
  <para style="q">
    <verse number="155" style="v" sid="PSA 119:155" />װײַט איז פֿון רשעים הילף,</para>
  <para style="q" vid="PSA 119:155">װײַל דײַנע געזעצן זוכן זײ נישט.<verse eid="PSA 119:155" /></para>
  <para style="q">
    <verse number="156" style="v" sid="PSA 119:156" />דײַן דערבאַרעמונג איז גרױס, ה׳;</para>
  <para style="q" vid="PSA 119:156">לעב מיך אױף אַזױ װי דײַן געזעצן.<verse eid="PSA 119:156" /></para>
  <para style="q">
    <verse number="157" style="v" sid="PSA 119:157" />פֿיל זײַנען מײַנע נאָכיאָגער און מײַנע דריקער –</para>
  <para style="q" vid="PSA 119:157">פֿון דײַנע צײגנים האָב איך זיך נישט אָפּגענײגט.<verse eid="PSA 119:157" /></para>
  <para style="q">
    <verse number="158" style="v" sid="PSA 119:158" />איך האָב געזען די פֿעלשער און איך האָב געהאַט אַן עקל צו זײ,</para>
  <para style="q" vid="PSA 119:158">װאָס האָבן דײַן װאָרט נישט געהיט.<verse eid="PSA 119:158" /></para>
  <para style="q">
    <verse number="159" style="v" sid="PSA 119:159" />זע אַז דײַנע באַפֿעלן האָב איך ליב;</para>
  <para style="q" vid="PSA 119:159">ה׳, לעב מיך אױף לױט דײַן חֶסֶד.<verse eid="PSA 119:159" /></para>
  <para style="q">
    <verse number="160" style="v" sid="PSA 119:160" />דער עיקר פֿון דײַן װאָרט איז אמת,</para>
  <para style="q" vid="PSA 119:160">און אױף אײביק איז אַל דײַן גערעכטער משפּט.<verse eid="PSA 119:160" /></para>
  <para style="qa">ש</para>
  <para style="q">
    <verse number="161" style="v" sid="PSA 119:161" />האַרן האָבן מיך גערודפֿט פֿאַר אומזיסט,</para>
  <para style="q" vid="PSA 119:161">אָבער פֿאַר דײַנע װערטער האָט געאַנגסט מײַן האַרץ.<verse eid="PSA 119:161" /></para>
  <para style="q">
    <verse number="162" style="v" sid="PSA 119:162" />איך פֿרײ זיך איבער דײַן װאָרט,</para>
  <para style="q" vid="PSA 119:162">װי אײנער װאָס געפֿינט אַ סך רױב.<verse eid="PSA 119:162" /></para>
  <para style="q">
    <verse number="163" style="v" sid="PSA 119:163" />ליגן האָב איך פֿײַנט און פֿאַראומװערדיק,</para>
  <para style="q" vid="PSA 119:163">דײַן תּורה האָב איך ליב.<verse eid="PSA 119:163" /></para>
  <para style="q">
    <verse number="164" style="v" sid="PSA 119:164" />זיבן מאָל אַ טאָג לױב איך דיך</para>
  <para style="q" vid="PSA 119:164">פֿאַר דײַנע גערעכטע משפּטים.<verse eid="PSA 119:164" /></para>
  <para style="q">
    <verse number="165" style="v" sid="PSA 119:165" />גרױס פֿריד איז פֿאַר די ליבהאָבער פֿון דײַן תּורה,</para>
  <para style="q" vid="PSA 119:165">און נישטאָ פֿאַר זײ קײן שטרױכלונג.<verse eid="PSA 119:165" /></para>
  <para style="q">
    <verse number="166" style="v" sid="PSA 119:166" />איך האָב אױסגעקוקט אױף דײַן הילף, ה׳,</para>
  <para style="q" vid="PSA 119:166">און דײַנע געבאָט האָב איך געטאָן.<verse eid="PSA 119:166" /></para>
  <para style="q">
    <verse number="167" style="v" sid="PSA 119:167" />מײַן זעל האָט געהיט דײַנע צײגנים,</para>
  <para style="q" vid="PSA 119:167">און איך האָב זײ ליב זײער.<verse eid="PSA 119:167" /></para>
  <para style="q">
    <verse number="168" style="v" sid="PSA 119:168" />איך האָב געהיט דײַנע באַפֿעלן און דײַנע צײגנים,</para>
  <para style="q" vid="PSA 119:168">װאָרעם אַלע מײַנע װעגן זײַנען פֿאַר דיר.<verse eid="PSA 119:168" /></para>
  <para style="qa">ת</para>
  <para style="q">
    <verse number="169" style="v" sid="PSA 119:169" />זאָל גענענען מײַן געשרײ פֿאַר דיר, ה׳;</para>
  <para style="q" vid="PSA 119:169">מאַך מיך פֿאַרשטײן, לױט דײַן װאָרט.<verse eid="PSA 119:169" /></para>
  <para style="q">
    <verse number="170" style="v" sid="PSA 119:170" />זאָל קומען מײַן געבעט פֿאַר דיר;</para>
  <para style="q" vid="PSA 119:170">זײַ מיך מציל לױט דײַן צוזאָג.<verse eid="PSA 119:170" /></para>
  <para style="q">
    <verse number="171" style="v" sid="PSA 119:171" />מײַנע ליפּן װעלן שטראָמען מיט לױב,</para>
  <para style="q" vid="PSA 119:171">אַז דו װעסט מיך לערנען דײַנע געזעצן.<verse eid="PSA 119:171" /></para>
  <para style="q">
    <verse number="172" style="v" sid="PSA 119:172" />מײַן צונג װעט זינגען דײַן װאָרט,</para>
  <para style="q" vid="PSA 119:172">װאָרעם אַלע דײַנע געבאָט זײַנען גערעכטיקײט.<verse eid="PSA 119:172" /></para>
  <para style="q">
    <verse number="173" style="v" sid="PSA 119:173" />זאָל דײַן האַנט זײַן מיר צו הילף,</para>
  <para style="q" vid="PSA 119:173">װאָרעם דײַנע באַפֿעלן האָב איך אױסדערװײלט.<verse eid="PSA 119:173" /></para>
  <para style="q">
    <verse number="174" style="v" sid="PSA 119:174" />איך האָב געשמאַכט נאָך דײַן ישועה, ה׳,</para>
  <para style="q" vid="PSA 119:174">און דײַן תּורה איז מײַן קװיקונג.<verse eid="PSA 119:174" /></para>
  <para style="q">
    <verse number="175" style="v" sid="PSA 119:175" />זאָל לעבן מײַן זעל, און דיך לױבן,</para>
  <para style="q" vid="PSA 119:175">און זאָלן דײַנע משפּטים מיך העלפֿן.<verse eid="PSA 119:175" /></para>
  <para style="q">
    <verse number="176" style="v" sid="PSA 119:176" />איך האָב געבלאָנדזשעט װי אַ פֿאַרלאָרענע שאָף;</para>
  <para style="q" vid="PSA 119:176">זוך אױף דײַן קנעכט, װאָרעם דײַנע געבאָט האָב איך נישט פֿאַרגעסן.<verse eid="PSA 119:176" /></para>
  <chapter eid="PSA 119" />
  <chapter number="120" style="c" pubnumber="קכ" sid="PSA 120" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 120:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען.</para>
  <para style="q" vid="PSA 120:1">
    <char style="va">1</char> אין מײַן נױט האָב איך גערופֿן צו ה׳,</para>
  <para style="q" vid="PSA 120:1">און ער האָט מיר געענטפֿערט.<verse eid="PSA 120:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 120:2" />ה׳, זײַ מציל מײַן זעל פֿון דער ליפּ פֿון ליגן,</para>
  <para style="q" vid="PSA 120:2">פֿון דער צונג פֿון באַטרוג.<verse eid="PSA 120:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 120:3" />װאָס װעט מען דיר געבן, און װאָס װעט מען דיר צולײגן,</para>
  <para style="q" vid="PSA 120:3">דו צונג פֿון באַטרוג?<verse eid="PSA 120:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 120:4" />שאַרפֿע גיבור-פֿײַלן,</para>
  <para style="q" vid="PSA 120:4">מיט קױלן פֿון בעזעמבײמלעך.<verse eid="PSA 120:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 120:5" />װײ מיר, װאָס איך האַלט זיך אױף אין מֶשֶך,</para>
  <para style="q" vid="PSA 120:5">װאָס איך װױן בײַ די געצעלטן פֿון קֵדָר.<verse eid="PSA 120:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 120:6" />לאַנג האָט זיך אָנגעװױנט מײַן זעל</para>
  <para style="q" vid="PSA 120:6">בײַ דעם שׂונא פֿון שלום.<verse eid="PSA 120:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 120:7" />איך בין לױטער שלום,</para>
  <para style="q" vid="PSA 120:7">אָבער אַז איך רעד, זײַנען זײ פֿאַר מלחמה.<verse eid="PSA 120:7" /></para>
  <chapter eid="PSA 120" />
  <chapter number="121" style="c" pubnumber="קכא" sid="PSA 121" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 121:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען.</para>
  <para style="q" vid="PSA 121:1">
    <char style="va">1</char> איך הײב אױף מײַנע אױגן צו די בערג:</para>
  <para style="q" vid="PSA 121:1">פֿון װאַנען װעט קומען מײַן הילף?<verse eid="PSA 121:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 121:2" />מײַן הילף איז פֿון ה׳,</para>
  <para style="q" vid="PSA 121:2">דעם באַשעפֿער פֿון הימל און ערד.<verse eid="PSA 121:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 121:3" />נישט לאָזן װעט ער זיך אױסגליטשן דײַן פֿוס;</para>
  <para style="q" vid="PSA 121:3">נישט שלומערן װעט דײַן היטער.<verse eid="PSA 121:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 121:4" />זע, עס שלומערט נישט און שלאָפֿט נישט</para>
  <para style="q" vid="PSA 121:4">דער היטער פֿון יִשׂרָאֵל.<verse eid="PSA 121:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 121:5" />ה׳ איז דײַן היטער,</para>
  <para style="q" vid="PSA 121:5">ה׳ איז דײַן שאָטן בײַ דײַן רעכטער האַנט;<verse eid="PSA 121:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 121:6" />בײַ טאָג װעט די זון דיך נישט שלאָגן,</para>
  <para style="q" vid="PSA 121:6">און נישט בײַ נאַכט די לבֿנה.<verse eid="PSA 121:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 121:7" />ה׳ װעט דיך באַהיטן פֿון אַלעם בײז,</para>
  <para style="q" vid="PSA 121:7">ער װעט באַהיטן דײַן זעל.<verse eid="PSA 121:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 121:8" />ה׳ װעט היטן דײַן גײן און דײַן קומען,</para>
  <para style="q" vid="PSA 121:8">פֿון אַצונד און ביז אײביק.<verse eid="PSA 121:8" /></para>
  <chapter eid="PSA 121" />
  <chapter number="122" style="c" pubnumber="קכב" sid="PSA 122" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 122:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען; פֿון דָוִדן.</para>
  <para style="q" vid="PSA 122:1">
    <char style="va">1</char> איך פֿרײ זיך אַז מע זאָגט מיר:</para>
  <para style="q" vid="PSA 122:1">לאָמיר גײן אין הױז פֿון ה׳.<verse eid="PSA 122:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 122:2" />אונדזערע פֿיס שטײען</para>
  <para style="q" vid="PSA 122:2">אין דײַנע טױערן, ירושָלַיִם.<verse eid="PSA 122:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 122:3" />ירושָלַיִם װאָס איז אױפֿגעבױט װי אַ שטאָט</para>
  <para style="q" vid="PSA 122:3">װאָס איז זיך באַהעפֿט אין אײנעם;<verse eid="PSA 122:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 122:4" />װאָס אַהין גײען אַרױף די שבֿטים,</para>
  <para style="q" vid="PSA 122:4">די שבֿטים פֿון ה׳,</para>
  <para style="q" vid="PSA 122:4">פֿאַר אַן צײגנים צו יִשׂרָאֵל,</para>
  <para style="q" vid="PSA 122:4">צו דאַנקען דעם נאָמען פֿון ה׳.<verse eid="PSA 122:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 122:5" />װאָרעם דאָרטן שטײען טראָנען פֿון משפּט,</para>
  <para style="q" vid="PSA 122:5">די טראָנען פֿון דָוִדס הױז.<verse eid="PSA 122:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 122:6" />בעט פֿאַר דעם שלום פֿון ירושָלַיִם;</para>
  <para style="q" vid="PSA 122:6">זאָלן אין שלװה זײַן אַלע דײַנע ליבהאָבער.<verse eid="PSA 122:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 122:7" />זאָל זײַן שלום אין דײַן מױער,</para>
  <para style="q" vid="PSA 122:7">שלװה אין דײַנע פּאַלאַצן.<verse eid="PSA 122:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 122:8" />פֿון װעגן מײַנע ברידער און מײַנע חבֿרים</para>
  <para style="q" vid="PSA 122:8">לאָמיך זאָגן: שלום אין דיר!<verse eid="PSA 122:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 122:9" />פֿון װעגן דעם הױז פֿון ה׳ אלוקינו</para>
  <para style="q" vid="PSA 122:9">װינטש איך דיר גוטס.<verse eid="PSA 122:9" /></para>
  <chapter eid="PSA 122" />
  <chapter number="123" style="c" pubnumber="קכג" sid="PSA 123" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 123:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען.</para>
  <para style="q" vid="PSA 123:1">
    <char style="va">1</char> צו דיר הײב איך אױף מײַנע אױגן,</para>
  <para style="q" vid="PSA 123:1">דו װאָס טראָנסט אין די הימלען.<verse eid="PSA 123:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 123:2" />זע, װי די אױגן פֿון קנעכט צו דער האַנט פֿון זײער האַר,</para>
  <para style="q" vid="PSA 123:2">װי די אױגן פֿון אַ דינסט צו דער האַנט פֿון איר האַרינטע,</para>
  <para style="q" vid="PSA 123:2">אַזױ זײַנען אונדזערע אױגן צו ה׳ אלוקינו,</para>
  <para style="q" vid="PSA 123:2">ביז ער װעט אונדז לײַטזעליקן.<verse eid="PSA 123:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 123:3" />לײַטזעליק אונדז, ה׳, לײַטזעליק אונדז,</para>
  <para style="q" vid="PSA 123:3">װאָרעם איבערזאַט זײַנען מיר מיט פֿאַראַכטונג.<verse eid="PSA 123:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 123:4" />איבערזאַט איז אונדזער זעל</para>
  <para style="q" vid="PSA 123:4">מיט דעם געשפּעט פֿון די רויִקע,</para>
  <para style="q" vid="PSA 123:4">מיט דער פֿאַראַכטונג פֿון די האָפֿערדיקע דריקער.<verse eid="PSA 123:4" /></para>
  <chapter eid="PSA 123" />
  <chapter number="124" style="c" pubnumber="קכד" sid="PSA 124" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 124:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען; פֿון דָוִדן.</para>
  <para style="q" vid="PSA 124:1">
    <char style="va">1</char> װען נישט ה׳ װאָס איז געװען מיט אונדז –</para>
  <para style="q" vid="PSA 124:1">זאָל נון זאָגן יִשׂרָאֵל –<verse eid="PSA 124:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 124:2" />װען נישט ה׳ װאָס איז געװען מיט אונדז,</para>
  <para style="q" vid="PSA 124:2">בעת מענטשן זײַנען אױפֿגעשטאַנען אױף אונדז,<verse eid="PSA 124:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 124:3" />דענצמאָל װאָלטן זײ אונדז לעבעדיקערהײט אײַנגעשלונגען,</para>
  <para style="q" vid="PSA 124:3">װען זײער צאָרן האָט געגרימט אױף אונדז;<verse eid="PSA 124:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 124:4" />דענצמאָל װאָלטן אונדז די װאַסערן פֿאַרפֿלײצט,</para>
  <para style="q" vid="PSA 124:4">דער טײַך װאָלט אַריבערגעגאַנגען איבער אונדזער זעל;<verse eid="PSA 124:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 124:5" />דענצמאָל װאָלטן אַריבער איבער אונדזער זעל</para>
  <para style="q" vid="PSA 124:5">די מוטװיליקע װאַסערן.<verse eid="PSA 124:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 124:6" />ברוך ה׳,</para>
  <para style="q" vid="PSA 124:6">װאָס ער האָט אונדז נישט געגעבן</para>
  <para style="q" vid="PSA 124:6">פֿאַר רױב צו זײערע צײן.<verse eid="PSA 124:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 124:7" />אונדזער זעל איז אַנטרונען געװאָרן װי אַ פֿױגל</para>
  <para style="q" vid="PSA 124:7">פֿון די פֿאַנגערס פּאַסטקע;</para>
  <para style="q" vid="PSA 124:7">די פּאַסטקע איז צעבראָכן געװאָרן,</para>
  <para style="q" vid="PSA 124:7">און מיר זײַנען אַנטרונען געװאָרן.<verse eid="PSA 124:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 124:8" />אונדזער הילף איז אין נאָמען פֿון ה׳,</para>
  <para style="q" vid="PSA 124:8">דעם באַשעפֿער פֿון הימל און ערד.<verse eid="PSA 124:8" /></para>
  <chapter eid="PSA 124" />
  <chapter number="125" style="c" pubnumber="קכה" sid="PSA 125" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 125:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען.</para>
  <para style="q" vid="PSA 125:1">
    <char style="va">1</char> די װאָס פֿאַרזיכערן זיך אױף ה׳</para>
  <para style="q" vid="PSA 125:1">זײַנען אַזױ װי באַרג צִיוֹן, װאָס רירט זיך נישט;</para>
  <para style="q" vid="PSA 125:1">אײביק פֿאַרבלײַבט ער.<verse eid="PSA 125:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 125:2" />ירושָלַיִם – אַרום איר זײַנען בערג,</para>
  <para style="q" vid="PSA 125:2">און ה׳ איז אַרום זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 125:2">פֿון אַצונד און ביז אײביק.<verse eid="PSA 125:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 125:3" />װאָרעם דער שטעקן פֿון שלעכטיקײט װעט נישט רוען</para>
  <para style="q" vid="PSA 125:3">אױף דעם גורל פֿון די גערעכטע,</para>
  <para style="q" vid="PSA 125:3">כּדי די גערעכטע זאָלן נישט אױסשטעקן</para>
  <para style="q" vid="PSA 125:3">אין אומגערעכטיקײט זײערע הענט.<verse eid="PSA 125:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 125:4" />באַגיטיק, ה׳, די גוטע,</para>
  <para style="q" vid="PSA 125:4">און די װאָס זײַנען רעכטפֿאַרטיק אין זײערע הערצער.<verse eid="PSA 125:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 125:5" />אָבער די װאָס נײַגן זיך אױף זײערע קרומע װעגן,</para>
  <para style="q" vid="PSA 125:5">זײ װעט ה׳ אַװעקפֿירן מיט די טוער פֿון אומרעכט.</para>
  <para style="q" vid="PSA 125:5">שלום אױף יִשׂרָאֵל!<verse eid="PSA 125:5" /></para>
  <chapter eid="PSA 125" />
  <chapter number="126" style="c" pubnumber="קכו" sid="PSA 126" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 126:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען.</para>
  <para style="q" vid="PSA 126:1">
    <char style="va">1</char> אַז ה׳ האָט אומגעקערט די אומקערונג פֿון צִיוֹן,</para>
  <para style="q" vid="PSA 126:1">זײַנען מיר געװען װי אין חלום.<verse eid="PSA 126:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 126:2" />דענצמאָל איז פֿול געװאָרן אונדזער מױל מיט געלעכטער,</para>
  <para style="q" vid="PSA 126:2">און אונדזער צונג מיט געזאַנג;</para>
  <para style="q" vid="PSA 126:2">דענצמאָל האָט מען געזאָגט צװישן די פֿעלקער:</para>
  <para style="q" vid="PSA 126:2">גרױס געטאָן האָט ה׳ מיט די דאָזיקע.<verse eid="PSA 126:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 126:3" />גרױס געטאָן האָט ה׳ מיט אונדז,</para>
  <para style="q" vid="PSA 126:3">מיר זײַנען דערפֿרײט געװאָרן.<verse eid="PSA 126:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 126:4" />ברענג צוריק, ה׳, אונדזער געפֿאַנגענשאַפֿט,</para>
  <para style="q" vid="PSA 126:4">װי שטראָמען אין טרוקענעם לאַנד.<verse eid="PSA 126:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 126:5" />די װאָס זײען מיט טרערן,</para>
  <para style="q" vid="PSA 126:5">זאָלן שנײַדן מיט געזאַנג.<verse eid="PSA 126:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 126:6" />גײן גײט און װײנט</para>
  <para style="q" vid="PSA 126:6">דער װאָס טראָגט דעם אױסשיט פֿון זריעה,</para>
  <para style="q" vid="PSA 126:6">אָבער קומען זאָל קומען מיט געזאַנג</para>
  <para style="q" vid="PSA 126:6">דער װאָס טראָגט זײַנע גאַרבן.<verse eid="PSA 126:6" /></para>
  <chapter eid="PSA 126" />
  <chapter number="127" style="c" pubnumber="קכז" sid="PSA 127" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 127:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען; פֿון שלמהן.</para>
  <para style="q" vid="PSA 127:1">
    <char style="va">1</char> אַז ה׳ בױט נישט אַ הױז,</para>
  <para style="q" vid="PSA 127:1">אומזיסט מיִען זיך זײַנע בױערס אױף אים;</para>
  <para style="q" vid="PSA 127:1">אַז ה׳ היט נישט אַ שטאָט,</para>
  <para style="q" vid="PSA 127:1">אומזיסט װאַכט דער שומר.<verse eid="PSA 127:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 127:2" />אומזיסט אײַך, איר װאָס פֿעדערט אײַך אױפֿצושטײן,</para>
  <para style="q" vid="PSA 127:2">װאָס זיצט-אױף שפּעט,</para>
  <para style="q" vid="PSA 127:2">װאָס עסט ברױט מיט מאַטערניש;</para>
  <para style="q" vid="PSA 127:2">אַזױ װאָס גיט ער זײַן באַליבטן אין שלאָף.<verse eid="PSA 127:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 127:3" />זע, די אַרב פֿון ה׳ זײַנען קינדער,</para>
  <para style="q" vid="PSA 127:3">דער *שׂכַר איז פֿרוכט פֿון לײַב.<verse eid="PSA 127:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 127:4" />װי פֿײַלן אין דער האַנט פֿון גיבור,</para>
  <para style="q" vid="PSA 127:4">אַזױ זײַנען קינדער פֿון דער יוגנט.<verse eid="PSA 127:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 127:5" />װױל צו דעם מאַן</para>
  <para style="q" vid="PSA 127:5">װאָס האָט אָנגעפֿילט זײַן פֿײַלבײַטל מיט זײ!</para>
  <para style="q" vid="PSA 127:5">זײ װעלן נישט פֿאַרשעמט װערן,</para>
  <para style="q" vid="PSA 127:5">אַז זײ װעלן רעדן מיט די פֿײַנט אין טױער.<verse eid="PSA 127:5" /></para>
  <chapter eid="PSA 127" />
  <chapter number="128" style="c" pubnumber="קכח" sid="PSA 128" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 128:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען.</para>
  <para style="q" vid="PSA 128:1">
    <char style="va">1</char> װױל צו איטלעכן װאָס פֿאָרכט ה׳,</para>
  <para style="q" vid="PSA 128:1">װאָס גײט אין זײַנע װעגן.<verse eid="PSA 128:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 128:2" />די מי פֿון דײַנע הענט אַז דו עסט,</para>
  <para style="q" vid="PSA 128:2">װױל איז צו דיר, און גוט איז צו דיר.<verse eid="PSA 128:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 128:3" />דײַן װײַב װי אַ פֿרוכטיקער װײַנשטאָק,</para>
  <para style="q" vid="PSA 128:3">אין די װינקלען פֿון דײַן הױז;</para>
  <para style="q" vid="PSA 128:3">דײַנע קינדער װי אײלבערטפֿלאַנצן,</para>
  <para style="q" vid="PSA 128:3">רונד אַרום דײַן טיש.<verse eid="PSA 128:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 128:4" />יאָ, אָט אַזױ װערט געבענטשט</para>
  <para style="q" vid="PSA 128:4">דער מאַן װאָס פֿאָרכט ה׳.<verse eid="PSA 128:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 128:5" />ה׳ זאָל דיך בענטשן פֿון צִיוֹן,</para>
  <para style="q" vid="PSA 128:5">און זע דאָס גוטס פֿון ירושָלַיִם</para>
  <para style="q" vid="PSA 128:5">אַלע טעג פֿון דײַן לעבן;<verse eid="PSA 128:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 128:6" />און זע קינדער בײַ דײַנע קינדער.</para>
  <para style="q" vid="PSA 128:6">שלום אױף יִשׂרָאֵל!<verse eid="PSA 128:6" /></para>
  <chapter eid="PSA 128" />
  <chapter number="129" style="c" pubnumber="קכט" sid="PSA 129" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 129:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען.</para>
  <para style="q" vid="PSA 129:1">
    <char style="va">1</char> פֿיל האָבן זײ מיך געדריקט פֿון מײַן יוגנט –</para>
  <para style="q" vid="PSA 129:1">זאָל נון זאָגן יִשׂרָאֵל –<verse eid="PSA 129:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 129:2" />פֿיל האָבן זײ מיך געדריקט פֿון מײַן יוגנט,</para>
  <para style="q" vid="PSA 129:2">און האָבן מיך נישט בײַגעקומען.<verse eid="PSA 129:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 129:3" />אױף מײַן רוקן האָבן אַקערער געאַקערט,</para>
  <para style="q" vid="PSA 129:3">זײ האָבן לאַנג געמאַכט זײערע בײטן.<verse eid="PSA 129:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 129:4" />ה׳ דער גערעכטער</para>
  <para style="q" vid="PSA 129:4">האָט דורכגעהאַקט די שטריק פֿון די רשעים.<verse eid="PSA 129:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 129:5" />זיך שעמען און אָפּטרעטן אַהינטער</para>
  <para style="q" vid="PSA 129:5">װעלן אַלע שָׂונאים פֿון צִיוֹן.<verse eid="PSA 129:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 129:6" />זײ װעלן זײַן װי גראָז פֿון דעכער,</para>
  <para style="q" vid="PSA 129:6">װאָס אײדער עס איז אַרױס, איז עס פֿאַרטריקנט;<verse eid="PSA 129:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 129:7" />װאָס דער שניטער פֿילט נישט דערמיט זײַן האַנט,</para>
  <para style="q" vid="PSA 129:7">און דער גאַרבנבינדער זײַן בוזעם;<verse eid="PSA 129:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 129:8" />און די פֿאַרבײַגײער זאָגן נישט:</para>
  <para style="q" vid="PSA 129:8">ג-טס ברכה אױף אײַך!</para>
  <para style="q" vid="PSA 129:8">מיר בענטשן אײַך אין נאָמען פֿון ה׳.<verse eid="PSA 129:8" /></para>
  <chapter eid="PSA 129" />
  <chapter number="130" style="c" pubnumber="קל" sid="PSA 130" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 130:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען.</para>
  <para style="q" vid="PSA 130:1">
    <char style="va">1</char> פֿון די טיפֿענישן רוף איך דיך, ה׳.<verse eid="PSA 130:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 130:2" />אֲדֹנָי, הער צו מײַן קֹול;</para>
  <para style="q" vid="PSA 130:2">זאָלן דײַנע אױערן זײַן פֿאַרנעמיק</para>
  <para style="q" vid="PSA 130:2">צו דעם קֹול פֿון מײַנע געבעטן.<verse eid="PSA 130:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 130:3" />אַז דו, ה׳, זאָלסט אַכטן אױף זינד,</para>
  <para style="q" vid="PSA 130:3">װער, אֲדֹנָי, קען באַשטײן?<verse eid="PSA 130:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 130:4" />װאָרעם בײַ דיר איז פֿאַרגעבונג,</para>
  <para style="q" vid="PSA 130:4">דערום װערסטו געפֿאָרכט.<verse eid="PSA 130:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 130:5" />איך האָב געהאָפֿט אױף ה׳,</para>
  <para style="q" vid="PSA 130:5">געהאָפֿט האָט מײַן זעל,</para>
  <para style="q" vid="PSA 130:5">און אױף זײַן װאָרט האָב איך געהאַרט.<verse eid="PSA 130:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 130:6" />מײַן נפֿש קוקט אױס אױף אֲדֹנָי</para>
  <para style="q" vid="PSA 130:6">מער װי װעכטער אױף פֿרימאָרגן,</para>
  <para style="q" vid="PSA 130:6">װעכטער אױפֿן פֿרימאָרגן.<verse eid="PSA 130:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 130:7" />אָ ישׂראל האָף אױף ה׳,</para>
  <para style="q" vid="PSA 130:7">װאָרעם בײַ ה׳ איז גענאָד,</para>
  <para style="q" vid="PSA 130:7">און בײַ אים איז גרױס אױסלײזונג.<verse eid="PSA 130:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 130:8" />און ער װעט אױסלײזן יִשׂרָאֵל</para>
  <para style="q" vid="PSA 130:8">פֿון אַלע זײַנע זינד.<verse eid="PSA 130:8" /></para>
  <chapter eid="PSA 130" />
  <chapter number="131" style="c" pubnumber="קלא" sid="PSA 131" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 131:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען; פֿון דָוִדן.</para>
  <para style="q" vid="PSA 131:1">
    <char style="va">1</char> ה׳, נישט האָפֿערדיק איז מײַן האַרץ,</para>
  <para style="q" vid="PSA 131:1">און נישט דערהױבן זײַנען מײַנע אױגן,</para>
  <para style="q" vid="PSA 131:1">און איך בין נישט אומגעגאַנגען מיט זאַכן</para>
  <para style="q" vid="PSA 131:1">צו גרױס און פֿאַרהױלן פֿון מיר.<verse eid="PSA 131:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 131:2" />פֿאַר װאָר, איך האָב באַרוט און אײַנגעשטילט מײַן זעל</para>
  <para style="q" vid="PSA 131:2">אַזױ װי אַן אַנטװױנטער בײַ זײַן מוטער;</para>
  <para style="q" vid="PSA 131:2">אַזױ װי אַן אַנטװױנטער איז בײַ מיר מײַן זעל.<verse eid="PSA 131:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 131:3" />האַר, יִשׂרָאֵל, אױף ה׳</para>
  <para style="q" vid="PSA 131:3">פֿון אַצונד און ביז אײביק.<verse eid="PSA 131:3" /></para>
  <chapter eid="PSA 131" />
  <chapter number="132" style="c" pubnumber="קלב" sid="PSA 132" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 132:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען.</para>
  <para style="q" vid="PSA 132:1">
    <char style="va">1</char> געדענק, ה׳, דָוִדן אַל זײַן פּלאָגן זיך.<verse eid="PSA 132:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 132:2" />װי ער האָט געשװאָרן צו ה׳,</para>
  <para style="q" vid="PSA 132:2">אַ נדר געטאָן צום מאַכטיקן פֿון יעקבֿ:<verse eid="PSA 132:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 132:3" />אױב איך װעל קומען אין געצעלט פֿון מײַן הױז,</para>
  <para style="q" vid="PSA 132:3">אױב איך װעל אַרױף אױף דעם בעט פֿון מײַן געלעגער,<verse eid="PSA 132:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 132:4" />אױב איך װעל געבן שלאָף צו מײַנע אױגן,</para>
  <para style="q" vid="PSA 132:4">צו מײַנע ברעמען שלומער,<verse eid="PSA 132:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 132:5" />ביז איך װעל געפֿינען אַן אָרט פֿאַר ה׳,</para>
  <para style="q" vid="PSA 132:5">אַ װױנונג פֿאַר דעם מאַכטיקן פֿון יעקבֿ!<verse eid="PSA 132:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="PSA 132:6" />זע, מיר האָבן געהערט אַז עס איז אין אֶפֿרָת,</para>
  <para style="q" vid="PSA 132:6">מיר האָבן עס געפֿונען אין פֿעלד פֿון יַעַר.<verse eid="PSA 132:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 132:7" />לאָמיר קומען צו זײַן װױנונג,</para>
  <para style="q" vid="PSA 132:7">לאָמיר זיך בוקן צו זײַן פֿוסבענקל.<verse eid="PSA 132:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 132:8" />שטײ אױף, ה׳, צו דײַן רו,</para>
  <para style="q" vid="PSA 132:8">דו און דער אָרון פֿון דײַן שטאַרקײט.<verse eid="PSA 132:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 132:9" />דײַנע כּהנים זאָלן זיך אָנקלײדן אין גערעכטיקײט,</para>
  <para style="q" vid="PSA 132:9">און דײַנע פֿרומע זאָלן זינגען.<verse eid="PSA 132:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 132:10" />פֿון װעגן דָוִדן דײַן קנעכט,</para>
  <para style="q" vid="PSA 132:10">זאָלסט נישט אָפּשטױסן דעם פּנים פֿון דײַן געזאַלבטן.<verse eid="PSA 132:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 132:11" />ה׳ האָט אמת געשװאָרן צו דָוִדן,</para>
  <para style="q" vid="PSA 132:11">ער װעט זיך נישט אָפּקערן דערפֿון:</para>
  <para style="q" vid="PSA 132:11">פֿון דער פֿרוכט פֿון דײַן לײַב</para>
  <para style="q" vid="PSA 132:11">װעל איך זעצן אױף דײַן טראָן.<verse eid="PSA 132:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 132:12" />אױב דײַנע זין װעלן היטן מײַן ברית,</para>
  <para style="q" vid="PSA 132:12">און מײַן צײגנים װאָס איך װעל זײ לערנען,</para>
  <para style="q" vid="PSA 132:12">װעלן אױך זײערע זין ביז אײביק זיצן אױף דײַן טראָן.<verse eid="PSA 132:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 132:13" />װאָרעם ה׳ האָט אױסדערװײלט צִיוֹן,</para>
  <para style="q" vid="PSA 132:13">זי געגלוסט פֿאַר זײַן װױנונג:<verse eid="PSA 132:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 132:14" />דאָס איז מײַן רוּונג ביז אײביק,</para>
  <para style="q" vid="PSA 132:14">דאָ װעל איך זיצן, װײַל איך גלוסט זי.<verse eid="PSA 132:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 132:15" />בענטשן װעל איך בענטשן איר שפּײַז,</para>
  <para style="q" vid="PSA 132:15">אירע באַדערפֿטיקע װעל איך זעטן מיט ברױט.<verse eid="PSA 132:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 132:16" />און אירע כּהנים װעל איך אָנקלײדן אין הילף,</para>
  <para style="q" vid="PSA 132:16">און זינגען װעלן זינגען אירע פֿרומע.<verse eid="PSA 132:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 132:17" />דאָרטן װעל איך מאַכן שפּראָצן אַ האָרן פֿאַר דָוִדן,</para>
  <para style="q" vid="PSA 132:17">איך האָב אָנגעברײט אַ ליכט פֿאַר מײַן געזאַלבטן.<verse eid="PSA 132:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 132:18" />זײַנע פֿײַנט װעל איך אָנקלײדן אין שאַנד,</para>
  <para style="q" vid="PSA 132:18">און אױף אים װעט שײַנען זײַן קרױן.<verse eid="PSA 132:18" /></para>
  <chapter eid="PSA 132" />
  <chapter number="133" style="c" pubnumber="קלג" sid="PSA 133" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 133:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען; פֿון דָוִדן</para>
  <para style="q" vid="PSA 133:1">
    <char style="va">1</char> זע, װי גוט און װי ליב</para>
  <para style="q" vid="PSA 133:1">איז דאָס זיצן פֿון ברידער בײַנאַנד.<verse eid="PSA 133:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 133:2" />אַזױ װי טײַער אײל אױפֿן קאָפּ,</para>
  <para style="q" vid="PSA 133:2">װאָס נידערט אַראָפּ אױף דער באָרד –</para>
  <para style="q" vid="PSA 133:2">אױף דער באָרד פֿון אַהרֹנען,</para>
  <para style="q" vid="PSA 133:2">װאָס נידערט אױפֿן קאָלנער פֿון זײַנע קלײדער;<verse eid="PSA 133:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 133:3" />אַזױ װי דער חֶרמוֹן-טױ װאָס נידערט</para>
  <para style="q" vid="PSA 133:3">אױף די בערג פֿון צִיוֹן;</para>
  <para style="q" vid="PSA 133:3">װאָרעם דאָרטן האָט ה׳ באַפֿױלן אַ ברכה,</para>
  <para style="q" vid="PSA 133:3">לעבן ביז אײביק.<verse eid="PSA 133:3" /></para>
  <chapter eid="PSA 133" />
  <chapter number="134" style="c" pubnumber="קלד" sid="PSA 134" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 134:1" />אַ געזאַנג פֿון די אַרױפֿגאַנגען.</para>
  <para style="q" vid="PSA 134:1">
    <char style="va">1</char> פֿאַר װאָר, בענטשט ה׳, אַלע קנעכט פֿון ה׳,</para>
  <para style="q" vid="PSA 134:1">װאָס שטײט אין ה׳ס הױז אין די נעכט.<verse eid="PSA 134:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 134:2" />הײבט אױף אײַערע הענט צום הײליקטום,</para>
  <para style="q" vid="PSA 134:2">און בענטשט ה׳.<verse eid="PSA 134:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 134:3" />בענטשן זאָל דיך פֿון צִיוֹן ה׳,</para>
  <para style="q" vid="PSA 134:3">דער באַשעפֿער פֿון הימל און ערד.<verse eid="PSA 134:3" /></para>
  <chapter eid="PSA 134" />
  <chapter number="135" style="c" pubnumber="קלה" sid="PSA 135" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 135:1" />הַלְלוּ יָהּ.</para>
  <para style="q" vid="PSA 135:1">
    <char style="va">1</char> לױבט דעם נאָמען פֿון ה׳,</para>
  <para style="q" vid="PSA 135:1">לױבט, איר קנעכט פֿון ה׳,<verse eid="PSA 135:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 135:2" />איר װאָס שטײט אין דעם הױז פֿון ה׳,</para>
  <para style="q" vid="PSA 135:2">אין די הױפֿן פֿון דעם בֵית הַמִקדָש פֿון אלוקינו.<verse eid="PSA 135:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 135:3" />לױבט ה׳, װאָרעם ה׳ איז גוט,</para>
  <para style="q" vid="PSA 135:3">זינגט צו זײַן נאָמען, װאָרעם ער איז ליב.<verse eid="PSA 135:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 135:4" />װאָרעם ה׳ האָט אױסדערװײלט פֿאַר זיך יעקבֿ,</para>
  <para style="q" vid="PSA 135:4">יִשׂרָאֵל פֿאַר זײַן באַזונדער אײגנס.<verse eid="PSA 135:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 135:5" />װאָרעם איך װײס אַז ה׳ איז גרױס,</para>
  <para style="q" vid="PSA 135:5">און אונדזער האַר איבער אַלע ג‑טער.<verse eid="PSA 135:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 135:6" />אַלץ װאָס ה׳ באַגערט, טוט ער,</para>
  <para style="q" vid="PSA 135:6">אין הימל און אױף דער ערד,</para>
  <para style="q" vid="PSA 135:6">אין די ימען און אַלע תּהומען.<verse eid="PSA 135:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 135:7" />ער ברענגט אױף װאָלקנס פֿון עק ערד,</para>
  <para style="q" vid="PSA 135:7">ער מאַכט בליצן צום רעגן,</para>
  <para style="q" vid="PSA 135:7">ער ציט אַרױס פֿון זײַנע שפּײַכלערס דעם װינט.<verse eid="PSA 135:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 135:8" />ער איז דער װאָס האָט געשלאָגן די בכוֹרים פֿון מִצרַיִם,</para>
  <para style="q" vid="PSA 135:8">פֿון אַ מענטשן ביז אַ בהמה.<verse eid="PSA 135:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 135:9" />האָט געשיקט צײכנס און װוּנדער צװישן דיר, מִצרַיִם,</para>
  <para style="q" vid="PSA 135:9">אױף פַּרעהן און אױף אַלע זײַנע קנעכט.<verse eid="PSA 135:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 135:10" />ער איז דער װאָס האָט געשלאָגן פֿיל פֿעלקער,</para>
  <para style="q" vid="PSA 135:10">און געהרגעט מאַכטיקע מלכים:<verse eid="PSA 135:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 135:11" />סיחון דעם מלך פֿון אֶמוֹרי,</para>
  <para style="q" vid="PSA 135:11">און עוֹג דעם מלך פֿון בָשָן,</para>
  <para style="q" vid="PSA 135:11">און אַלע קיניגרײַכן פֿון כּנַעַן;<verse eid="PSA 135:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 135:12" />און געגעבן זײער לאַנד פֿאַר אַ נחלה,</para>
  <para style="q" vid="PSA 135:12">אַ נחלה פֿאַר יִשׂרָאֵל זײַן פֿאָלק.<verse eid="PSA 135:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 135:13" />ה׳, דײַן נאָמען איז אױף אײביק,</para>
  <para style="q" vid="PSA 135:13">ה׳, דײַן געדעכעניש איז אױף דור-דורות.<verse eid="PSA 135:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 135:14" />װאָרעם ה׳ װעט זיך אָננעמען פֿאַר זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 135:14">און אױף זײַנע קנעכט װעט ער זיך דערבאַרעמען.<verse eid="PSA 135:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="PSA 135:15" />די געצנבילדער פֿון די פֿעלקער זײַנען זילבער און גאָלד,</para>
  <para style="q" vid="PSA 135:15">דאָס װערק פֿון אַ מענטשנס הענט.<verse eid="PSA 135:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 135:16" />זײ האָבן אַ מױל און רעדן נישט,</para>
  <para style="q" vid="PSA 135:16">זײ האָבן אױגן און זעען נישט;<verse eid="PSA 135:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 135:17" />זײ האָבן אױערן און הערן נישט;</para>
  <para style="q" vid="PSA 135:17">נישטאָ צו מאָל אַן אָטעם אין זײער מױל.<verse eid="PSA 135:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 135:18" />זאָל װערן װי זײ די װאָס מאַכן זײ,</para>
  <para style="q" vid="PSA 135:18">איטלעכער װאָס פֿאַרזיכערט זיך אױף זײ.<verse eid="PSA 135:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 135:19" />הױז פֿון יִשׂרָאֵל, לױבט ה׳;</para>
  <para style="q" vid="PSA 135:19">הױז פֿון אַהרֹן, לױבט ה׳;<verse eid="PSA 135:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 135:20" />הױז פֿון לֵוִי, לױבט ה׳;</para>
  <para style="q" vid="PSA 135:20">איר יראי ה׳, לױבט ה׳.<verse eid="PSA 135:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 135:21" />ברוך ה׳ פֿון צִיוֹן,</para>
  <para style="q" vid="PSA 135:21">װאָס רוט אין ירושָלַיִם.</para>
  <para style="q" vid="PSA 135:21">הַלְלוּ יָהּ.<verse eid="PSA 135:21" /></para>
  <chapter eid="PSA 135" />
  <chapter number="136" style="c" pubnumber="קלו" sid="PSA 136" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 136:1" />גיט אַ דאַנק צו ה׳, װאָרעם ער איז גוט,</para>
  <para style="qr" vid="PSA 136:1">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 136:2" />גיט אַ דאַנק צו אלֹקים פֿון די ג‑טער,</para>
  <para style="qr" vid="PSA 136:2">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 136:3" />גיט אַ דאַנק צום האַר פֿון די האַרן,</para>
  <para style="qr" vid="PSA 136:3">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 136:4" />צו דעם װאָס טוט אַלײן גרױסע װוּנדער,</para>
  <para style="qr" vid="PSA 136:4">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 136:5" />צו דעם װאָס האָט געמאַכט די הימלען מיט פֿאַרשטאַנדיקײט,</para>
  <para style="qr" vid="PSA 136:5">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 136:6" />צו דעם װאָס האָט אױסגעשפּרײט די ערד איבער די װאַסערן,</para>
  <para style="qr" vid="PSA 136:6">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 136:7" />צו דעם װאָס האָט געמאַכט די גרױסע ליכטער,</para>
  <para style="qr" vid="PSA 136:7">װאָרעם אױף אײביק איז זײַן חֶסֶד;<verse eid="PSA 136:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 136:8" />די זון פֿאַר געװעלטיקונג בײַ טאָג,</para>
  <para style="qr" vid="PSA 136:8">װאָרעם אױף אײביק איז זײַן חֶסֶד;<verse eid="PSA 136:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 136:9" />די לבֿנה און שטערן פֿאַר געװעלטיקונגען בײַ נאַכט,</para>
  <para style="qr" vid="PSA 136:9">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 136:10" />צו דעם װאָס האָט געשלאָגן מִצרַיִם אין זײערע בכוֹרים,</para>
  <para style="qr" vid="PSA 136:10">װאָרעם אױף אײביק איז זײַן חֶסֶד;<verse eid="PSA 136:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 136:11" />און אַרױסגעצױגן יִשׂרָאֵל פֿון צװישן זײ,</para>
  <para style="qr" vid="PSA 136:11">װאָרעם אױף אײביק איז זײַן חֶסֶד;<verse eid="PSA 136:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 136:12" />מיט אַ שטאַרקער האַנט און מיט אַן אױסגעשטרעקטן אָרעם,</para>
  <para style="qr" vid="PSA 136:12">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 136:13" />צו דעם װאָס האָט צעשניטן דעם ים-סוףֿ אין שטיקער,</para>
  <para style="qr" vid="PSA 136:13">װאָרעם אױף אײביק איז זײַן חֶסֶד;<verse eid="PSA 136:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 136:14" />און דורכגעפֿירט יִשׂרָאֵל אין מיטן,</para>
  <para style="qr" vid="PSA 136:14">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 136:15" />און אַרײַנגעטרײסלט פַּרעהן און זײַן חיל אין ים-סוףֿ,</para>
  <para style="qr" vid="PSA 136:15">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 136:16" />צו דעם װאָס האָט געפֿירט זײַן פֿאָלק אין דער מדבר,</para>
  <para style="qr" vid="PSA 136:16">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="PSA 136:17" />צו דעם װאָס האָט געשלאָגן גרױסע מלכים,</para>
  <para style="qr" vid="PSA 136:17">װאָרעם אױף אײביק איז זײַן חֶסֶד;<verse eid="PSA 136:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 136:18" />און געהרגעט שטאַרקע מלכים,</para>
  <para style="qr" vid="PSA 136:18">װאָרעם אױף אײביק איז זײַן חֶסֶד;<verse eid="PSA 136:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 136:19" />סיחון דער מלך פֿון אֶמוֹרי,</para>
  <para style="qr" vid="PSA 136:19">װאָרעם אױף אײביק איז זײַן חֶסֶד;<verse eid="PSA 136:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 136:20" />און עוֹג דעם מלך פֿון בָשָן,</para>
  <para style="qr" vid="PSA 136:20">װאָרעם אױף אײביק איז זײַן חֶסֶד;<verse eid="PSA 136:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 136:21" />און געגעבן זײער לאַנד פֿאַר אַ נחלה,</para>
  <para style="qr" vid="PSA 136:21">װאָרעם אױף אײביק איז זײַן חֶסֶד;<verse eid="PSA 136:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 136:22" />אַ נחלה פֿאַר יִשׂרָאֵל זײַן קנעכט,</para>
  <para style="qr" vid="PSA 136:22">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:22" /></para>
  <para style="b" />
  <para style="q">
    <verse number="23" style="v" sid="PSA 136:23" />צו דעם װאָס האָט אין אונדזער דערנידערונג געדאַכט אָן אונדז,</para>
  <para style="qr" vid="PSA 136:23">װאָרעם אױף אײביק איז זײַן חֶסֶד;<verse eid="PSA 136:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 136:24" />און אונדז אױסגעלײזט פֿון אונדזערע דריקער,</para>
  <para style="qr" vid="PSA 136:24">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:24" /></para>
  <para style="q">
    <verse number="25" style="v" sid="PSA 136:25" />װאָס גיט ברױט צו יעטװעדער באַשעפֿעניש,</para>
  <para style="qr" vid="PSA 136:25">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:25" /></para>
  <para style="b" />
  <para style="q">
    <verse number="26" style="v" sid="PSA 136:26" />גיט אַ דאַנק צום אֵל פֿון די הימלען,</para>
  <para style="qr" vid="PSA 136:26">װאָרעם אױף אײביק איז זײַן חֶסֶד.<verse eid="PSA 136:26" /></para>
  <chapter eid="PSA 136" />
  <chapter number="137" style="c" pubnumber="קלז" sid="PSA 137" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 137:1" />בײַ די טײַכן פֿון בָבֿל,</para>
  <para style="q" vid="PSA 137:1">דאָרטן זײַנען מיר געזעסן און געװײנט,</para>
  <para style="q" vid="PSA 137:1">אַז מיר האָבן זיך דערמאָנט אָן צִיוֹן.<verse eid="PSA 137:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 137:2" />אױף די װערבעס װאָס אין איר</para>
  <para style="q" vid="PSA 137:2">האָבן מיר אױפֿגעהאַנגען אונדזערע האַרפֿן;<verse eid="PSA 137:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 137:3" />װאָרעם דאָרטן האָבן אונדזערע פֿאַנגער</para>
  <para style="q" vid="PSA 137:3">פֿאַרלאַנגט פֿון אונדז װערטער פֿון געזאַנג,</para>
  <para style="q" vid="PSA 137:3">און אונדזערע פּײַניקער, פֿרײלעכקײט:</para>
  <para style="q" vid="PSA 137:3">זינגט אונדז פֿון דעם געזאַנג פֿון צִיוֹן.<verse eid="PSA 137:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 137:4" />װי זאָלן מיר זינגען דאָס געזאַנג פֿון ה׳</para>
  <para style="q" vid="PSA 137:4">אױף פֿרעמדער ערד?<verse eid="PSA 137:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 137:5" />אױב איך װעל דיך פֿאַרגעסן, ירושָלַיִם,</para>
  <para style="q" vid="PSA 137:5">זאָל מײַן רעכטע האַנט זיך פֿאַרגעסן צו רירן.<verse eid="PSA 137:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 137:6" />זאָל צוגעקלעפּט װערן מײַן צונג צו מײַן גומען,</para>
  <para style="q" vid="PSA 137:6">אױב איך װעל דיך נישט געדענקען,</para>
  <para style="q" vid="PSA 137:6">אױב איך װעל נישט דערמאָנען ירושָלַיִם</para>
  <para style="q" vid="PSA 137:6">אױף מײַן העכסטער שׂימחה.<verse eid="PSA 137:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 137:7" />געדענק, ה׳, די קינדער פֿון אֶדוֹם</para>
  <para style="q" vid="PSA 137:7">דעם טאָג פֿון ירושָלַיִם;</para>
  <para style="q" vid="PSA 137:7">די װאָס האָבן געזאָגט: װאַרפֿט אײַן,</para>
  <para style="q" vid="PSA 137:7">װאַרפֿט אײַן ביז צום גרונט אין איר.<verse eid="PSA 137:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 137:8" />טאָכטער בָבֿל, דו אָנגעברײטע צו פֿאַרװיסטונג,</para>
  <para style="q" vid="PSA 137:8">װױל צו דעם װאָס װעט דיר אָפּצאָלן</para>
  <para style="q" vid="PSA 137:8">דײַן טוּונג װאָס דו האָסט אונדז געטאָן;<verse eid="PSA 137:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 137:9" />װױל צו דעם װאָס װעט אָננעמען און צעהאַקן</para>
  <para style="q" vid="PSA 137:9">דײַנע קלײנע קינדער אָן פֿעלדז.<verse eid="PSA 137:9" /></para>
  <chapter eid="PSA 137" />
  <chapter number="138" style="c" pubnumber="קלח" sid="PSA 138" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 138:1" />פֿון דָוִדן.</para>
  <para style="q" vid="PSA 138:1">
    <char style="va">1</char> איך װעל דיך לױבן מיט מײַן גאַנצן האַרצן,</para>
  <para style="q" vid="PSA 138:1">פֿאַר די מאַכטיקע װעל איך דיך באַזינגען.<verse eid="PSA 138:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 138:2" />איך װעל זיך בוקן צו דײַן הײליקן הֵיכל,</para>
  <para style="q" vid="PSA 138:2">און איך װעל לױבן דײַן נאָמען,</para>
  <para style="q" vid="PSA 138:2">פֿאַר דײַן חֶסֶד און פֿאַר דײַן טרײַשאַפֿט;</para>
  <para style="q" vid="PSA 138:2">װאָרעם איבער אַל דײַן נאָמען</para>
  <para style="q" vid="PSA 138:2">האָסטו געגרײסט דײַן צוזאָג.<verse eid="PSA 138:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 138:3" />אין טאָג װאָס איך האָב גערופֿן האָסטו מיר געענטפֿערט,</para>
  <para style="q" vid="PSA 138:3">האָסט מיר געמוטיקט מיט שטאַרקײט מײַן זעל.<verse eid="PSA 138:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 138:4" />לױבן װעלן דיך, ה׳, אַלע מלכים פֿון דער ערד,</para>
  <para style="q" vid="PSA 138:4">װאָרעם זײ האָבן געהערט די װערטער פֿון דײַן מױל.<verse eid="PSA 138:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 138:5" />און זײ װעלן זינגען פֿון די װעגן פֿון ה׳,</para>
  <para style="q" vid="PSA 138:5">װאָרעם גרױס איז דער כּבֿוד פֿון ה׳.<verse eid="PSA 138:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 138:6" />כאָטש ה׳ איז דערהײכט, דאָך זעט ער אָן דעם נידעריקן,</para>
  <para style="q" vid="PSA 138:6">אָבער דעם שטאָלצן קען ער פֿון װײַטן.<verse eid="PSA 138:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 138:7" />אַז איך גײ אין דער מיט פֿון נױט,</para>
  <para style="q" vid="PSA 138:7">לעבסטו מיך אױף;</para>
  <para style="q" vid="PSA 138:7">צו להכעיס מײַנע פֿײַנט שטרעקסטו אױס דײַן האַנט,</para>
  <para style="q" vid="PSA 138:7">און דײַן רעכטע האַנט העלפֿט מיך.<verse eid="PSA 138:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 138:8" />ה׳ פֿירט אױס פֿאַר מיר;</para>
  <para style="q" vid="PSA 138:8">ה׳, דײַן חֶסֶד איז אױף אײביק;</para>
  <para style="q" vid="PSA 138:8">די װערק פֿון דײַנע הענט זאָלסטו נישט פֿאַרלאָזן.<verse eid="PSA 138:8" /></para>
  <chapter eid="PSA 138" />
  <chapter number="139" style="c" pubnumber="קלט" sid="PSA 139" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 139:1" />פֿאַר דעם געזאַנגמײַסטער; פֿון דָוִדן אַ מיזמור.</para>
  <para style="q" vid="PSA 139:1">
    <char style="va">1</char> ה׳, דו האָסט מיך אױסגעפֿאָרשט, און קענסט מיך.<verse eid="PSA 139:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 139:2" />דו װײסט מײַן זיצן און מײַן אױפֿשטײן,</para>
  <para style="q" vid="PSA 139:2">פֿאַרשטײסט מײַן טראַכטונג פֿון דער װײַטן.<verse eid="PSA 139:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 139:3" />מײַן גײן און מײַן ליגן זיפּסטו דורך,</para>
  <para style="q" vid="PSA 139:3">און אין אַלע מײַנע װעגן ביסטו באַהאַװנט.<verse eid="PSA 139:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 139:4" />װאָרעם דאָס װאָרט איז נאָך צו מאָל נישט אױף מײַן צונג,</para>
  <para style="q" vid="PSA 139:4">װײסטו עס דאָך, ה׳, שױן אין גאַנצן.<verse eid="PSA 139:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 139:5" />הינטן און פֿאָרנט האָסטו מיך באַלעגערט,</para>
  <para style="q" vid="PSA 139:5">און אַרױפֿגעטאָן אױף מיר דײַן האַנט.<verse eid="PSA 139:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 139:6" />צו װוּנדערלעך איז דאָס פֿאַר מיר צו פֿאַרשטײן,</para>
  <para style="q" vid="PSA 139:6">צו הױך, איך קען עס נישט באַנעמען.<verse eid="PSA 139:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 139:7" />װוּהין זאָל איך אַװעקגײן פֿון דײַן גײַסט?</para>
  <para style="q" vid="PSA 139:7">און װוּהין זאָל איך פֿון דײַן פּנים אַנטלױפֿן?<verse eid="PSA 139:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 139:8" />זאָל איך אַרױפֿגײן אין הימל, ביסטו דאָרטן,</para>
  <para style="q" vid="PSA 139:8">און זאָל איך מיר אױסבעטן אין שְׁאֹול, ערשט ביסט דאָ.<verse eid="PSA 139:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 139:9" />זאָל איך נעמען די פֿליגלען פֿון באַגינען,</para>
  <para style="q" vid="PSA 139:9">זאָל איך רוען אין עק פֿון ים,<verse eid="PSA 139:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 139:10" />װעט אױך דאָרטן מיך פֿירן דײַן האַנט,</para>
  <para style="q" vid="PSA 139:10">און מיך װעט האַלטן דײַן רעכטע.<verse eid="PSA 139:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 139:11" />און זאָל איך זאָגן: לױטער פֿינצטערניש זאָל מיך באַדעקן,</para>
  <para style="q" vid="PSA 139:11">און נאַכט זאָל דאָס ליכט פֿאַר מיר װערן,<verse eid="PSA 139:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 139:12" />איז אױך פֿינצטערניש נישט פֿינצטער פֿאַר דיר,</para>
  <para style="q" vid="PSA 139:12">און נאַכט טוט אַזױ װי דער טאָג לײַכטן;</para>
  <para style="q" vid="PSA 139:12">אַזױ פֿינצטערקײט אַזױ ליכטיקײט.<verse eid="PSA 139:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 139:13" />װאָרעם דו האָסט געפֿאַרמאָגן מײַנע נירן,</para>
  <para style="q" vid="PSA 139:13">האָסט מיך געװעבט אין לײַב פֿון מײַן מוטער.<verse eid="PSA 139:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 139:14" />איך לױב דיך, װאָרעם מוראדיק װוּנדערלעך בין איך געמאַכט;</para>
  <para style="q" vid="PSA 139:14">װוּנדערלעך זײַנען דײַנע װערק,</para>
  <para style="q" vid="PSA 139:14">און מײַן זעל װײס דאָס װױל.<verse eid="PSA 139:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 139:15" />נישט פֿאַרהױלן איז געװען מײַן געבײן פֿאַר דיר,</para>
  <para style="q" vid="PSA 139:15">װען איך בין געמאַכט געװאָרן אין פֿאַרבאָרגעניש,</para>
  <para style="q" vid="PSA 139:15">געשטריקט געװאָרן אין טיפֿענישן פֿון דער ערד.<verse eid="PSA 139:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 139:16" />מײַן אומגעפֿורעמט לײַב האָבן געזען דײַנע אױגן;</para>
  <para style="q" vid="PSA 139:16">יאָ, אין דײַן בוך װערן זײ אַלע אָנגעשריבן,</para>
  <para style="q" vid="PSA 139:16">די טעג װען מע זאָל באַשאַפֿן װערן,</para>
  <para style="q" vid="PSA 139:16">און אײנער צװישן זײ איז געװען פֿאַר אים.<verse eid="PSA 139:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 139:17" />און װי האַרב פֿאַר מיר זײַנען דײַנע טראַכטונגען, אֵל,</para>
  <para style="q" vid="PSA 139:17">װי געװאַלטיק איז זײער מיספּר!<verse eid="PSA 139:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 139:18" />זאָל איך זײ צײלן, זײַנען זײ מער פֿון זאַמד,</para>
  <para style="q" vid="PSA 139:18">זאָל איך דערגײן צום סוף, דאַרף מײַן דױער זײַן װי דײַנער.<verse eid="PSA 139:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="PSA 139:19" />װען דו, אֱלוֹהַּ, װאָלסט טײטן דעם רשע!</para>
  <para style="q" vid="PSA 139:19">און איר בלוטיק לײַט, טוט זיך אָפּ פֿון מיר!<verse eid="PSA 139:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 139:20" />די װאָס רעדן דיך אַרױס מיט אַ בײזער כּװנה,</para>
  <para style="q" vid="PSA 139:20">דײַנע פֿײַנט װאָס דערמאָנען דיך צום פֿאַלשן.<verse eid="PSA 139:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="PSA 139:21" />פֿאַר װאָר, דײַנע פֿײַנט, ה׳, האָב איך פֿײַנט,</para>
  <para style="q" vid="PSA 139:21">און מיט דײַנע קעגנשטײער טו איך קריגן.<verse eid="PSA 139:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="PSA 139:22" />פֿײַנט ביז גאָר האָב איך זײ פֿײַנט,</para>
  <para style="q" vid="PSA 139:22">שָׂונאים זײַנען זײ בײַ מיר.<verse eid="PSA 139:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="PSA 139:23" />פֿאָרש מיך, אֵל, און דערקען מײַן האַרץ,</para>
  <para style="q" vid="PSA 139:23">פּרוּװ מיך, און װײס מײַנע געדאַנקען;<verse eid="PSA 139:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="PSA 139:24" />און זע אױב אין מיר איז דאָ אַ פֿאַרדראָסיקער װעג,</para>
  <para style="q" vid="PSA 139:24">און פֿיר מיך אין דעם אײביקן װעג.<verse eid="PSA 139:24" /></para>
  <chapter eid="PSA 139" />
  <chapter number="140" style="c" pubnumber="קמ" sid="PSA 140" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 140:1" />פֿאַר דעם געזאַנגמײַסטער; אַ מיזמור פֿון דָוִדן.<verse eid="PSA 140:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 140:2" /> דערלײז מיך, ה׳, פֿון דעם שלעכטן מענטשן,</para>
  <para style="q" vid="PSA 140:2">פֿון דעם רױבמענטשן זאָלסטו מיך באַהיטן;<verse eid="PSA 140:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 140:3" /> די װאָס טראַכטן בײז אין האַרצן,</para>
  <para style="q" vid="PSA 140:3">אַלע טאָג העצן זײ מלחמות.<verse eid="PSA 140:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 140:4" /> זײ שאַרפֿן זײער צונג װי אַ שלאַנג,</para>
  <para style="q" vid="PSA 140:4">גיפֿט פֿון אַן אָטערשלאַנג איז אונטער זײערע ליפּן.</para>
  <para style="q" vid="PSA 140:4">סֶלָה.<verse eid="PSA 140:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 140:5" /> היט מיך, ה׳, פֿון די הענט פֿון דעם רשע,</para>
  <para style="q" vid="PSA 140:5">פֿון דעם רױבמענטשן זאָלסטו מיך באַהיטן;</para>
  <para style="q" vid="PSA 140:5">די װאָס טראַכטן אומצושטױסן מײַנע טריט.<verse eid="PSA 140:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 140:6" /> די האָפֿערדיקע האָבן מיר אַ פּאַסטקע אונטערגעלײגט, און שטריק,</para>
  <para style="q" vid="PSA 140:6">זײ האָבן אױסגעשפּרײט אַ נעץ לעבן שטעג,</para>
  <para style="q" vid="PSA 140:6">שטרױכלונגען האָבן זײ מיר געשטעלט.</para>
  <para style="q" vid="PSA 140:6">סֶלָה.<verse eid="PSA 140:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 140:7" /> איך זאָג צו ה׳: מײַן ג-ט ביסט דו;</para>
  <para style="q" vid="PSA 140:7">פֿאַרנעם, ה׳, דעם קֹול פֿון מײַנע געבעטן.<verse eid="PSA 140:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 140:8" /> ה׳ דו אֲדֹנָי, די שטאַרקײט פֿון מײַן הילף,</para>
  <para style="q" vid="PSA 140:8">האָסט באַשירעמט מײַן קאָפּ אין טאָג פֿון באַװאָפֿענונג;<verse eid="PSA 140:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="PSA 140:9" /> זאָלסט נישט געבן, ה׳, די באַגערן פֿון דעם רשע,</para>
  <para style="q" vid="PSA 140:9">זײַן כּװנה זאָלסטו נישט לאָזן אױספֿירן,</para>
  <para style="q" vid="PSA 140:9">אַז זײ זאָלן זיך דערהײבן.</para>
  <para style="q" vid="PSA 140:9">סֶלָה.<verse eid="PSA 140:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="PSA 140:10" /> דאָס גיפֿט פֿון מײַנע אַרומרינגלער,</para>
  <para style="q" vid="PSA 140:10">דאָס אומגליק פֿון זײערע ליפּן זאָל זײ אַלײן צודעקן.<verse eid="PSA 140:10" /></para>
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="PSA 140:11" /> זאָלן פֿאַלן אױף זײ קױלן,</para>
  <para style="q" vid="PSA 140:11">אין פֿײַער זאָל ער זײ װאַרפֿן,</para>
  <para style="q" vid="PSA 140:11">אין גריבער, אַז זײ זאָלן נישט אױפֿשטײן.<verse eid="PSA 140:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="PSA 140:12" /> דער צונגמענטש זאָל נישט באַשטײן אױף דער ערד,</para>
  <para style="q" vid="PSA 140:12">דעם בײזן רױבמענטשן, אים זאָל ער יאָגן צו פֿאַרשטױסונג.<verse eid="PSA 140:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="PSA 140:13" /> איך װײס אַז ה׳ װעט טאָן דאָס רעכט פֿון דעם אָרעמאַן,</para>
  <para style="q" vid="PSA 140:13">די גערעכטיקײט פֿון די באַדערפֿטיקע.<verse eid="PSA 140:13" /></para>
  <para style="q">
    <verse number="14" style="v" altnumber="13" sid="PSA 140:14" /> פֿאַר װאָר, די צדיקים װעלן דאַנקען דײַן נאָמען,</para>
  <para style="q" vid="PSA 140:14">די רעכטפֿאַרטיקע װעלן זיצן פֿאַר דײַן פּנים.<verse eid="PSA 140:14" /></para>
  <chapter eid="PSA 140" />
  <chapter number="141" style="c" pubnumber="קמא" sid="PSA 141" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 141:1" />אַ מיזמור פֿון דָוִדן.</para>
  <para style="q" vid="PSA 141:1">
    <char style="va">1</char> ה׳, איך רוף דיך, אײַל צו מיר,</para>
  <para style="q" vid="PSA 141:1">פֿאַרנעם מײַן קֹול, אַז איך רוף צו דיר.<verse eid="PSA 141:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 141:2" />זאָל באַשטײן מײַן תּפֿילה װי װײַרעך פֿאַר דיר,</para>
  <para style="q" vid="PSA 141:2">די אױפֿהײבונג פֿון מײַנע הענט װי דער אָװנט-קָרבָּן.<verse eid="PSA 141:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 141:3" />מאַך, ה׳, אַ היטונג אױף מײַן מױל,</para>
  <para style="q" vid="PSA 141:3">גיב אַכט אױף דער טיר פֿון מײַנע ליפּן.<verse eid="PSA 141:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 141:4" />זאָלסט נישט פֿאַרנײגן מײַן האַרץ צו אַ בײזער זאַך,</para>
  <para style="q" vid="PSA 141:4">צו טאָן טוּונגען אין שלעכטיקײט</para>
  <para style="q" vid="PSA 141:4">מיט לײַט װאָס װערקן אומרעכט;</para>
  <para style="q" vid="PSA 141:4">און לאָמיך נישט עסן פֿון זײערע זיסע שפּײַזן;<verse eid="PSA 141:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 141:5" />זאָל מיך שלאָגן דער צדיק אױס גינציקײט,</para>
  <para style="q" vid="PSA 141:5">און מיך שטראָפֿן;</para>
  <para style="q" vid="PSA 141:5">מײַן קאָפּ װעט נישט אָפּשטױסן דאָס טײַערע אײל –</para>
  <para style="q" vid="PSA 141:5">װאָרעם תּמיד איז מײַן תּפֿילה אַקעגן זײערע בײזן.<verse eid="PSA 141:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 141:6" />זאָלן געשלײַדערט װערן אָן אַ פֿעלדז זײערע ריכטער;</para>
  <para style="q" vid="PSA 141:6">און מע זאָל הערן מײַנע װערטער אַז זײ זײַנען ליבלעך.<verse eid="PSA 141:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 141:7" />אַזױ װי װען מע שפּאַלט און ברעכט אױף די ערד,</para>
  <para style="q" vid="PSA 141:7">זײַנען צעשאָטן אונדזערע בײנער בײַם מױל פֿון שְׁאֹול.<verse eid="PSA 141:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 141:8" />װאָרעם אױף דיר, ה׳ דו אֲדֹנָי, זײַנען מײַנע אױגן;</para>
  <para style="q" vid="PSA 141:8">אין דיר שיץ איך מיך, זאָלסט נישט אױסגיסן מײַן זעל.<verse eid="PSA 141:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 141:9" />היט מיך פֿון דער פּאַסטקע װאָס זײ האָבן מיר געשטעלט,</para>
  <para style="q" vid="PSA 141:9">און פֿון די שטרױכלונגען פֿון די אומרעכטטוער.<verse eid="PSA 141:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 141:10" />זאָלן אַרײַנפֿאַלן אין זײערע נעצן די רשעים,</para>
  <para style="q" vid="PSA 141:10">בעת איך אַלײן װעל אַריבערגײן.<verse eid="PSA 141:10" /></para>
  <chapter eid="PSA 141" />
  <chapter number="142" style="c" pubnumber="קמב" sid="PSA 142" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 142:1" />אַ באַטראַכטונג פֿון דָוִדן, װען ער איז געװען אין דער הײל; אַ תּפֿילה.<verse eid="PSA 142:1" /></para>
  <para style="q">
    <verse number="2" style="v" altnumber="1" sid="PSA 142:2" /> מיט מײַן קֹול שרײַ איך צו ה׳,</para>
  <para style="q" vid="PSA 142:2">מיט מײַן קֹול בעט איך צו ה׳.<verse eid="PSA 142:2" /></para>
  <para style="q">
    <verse number="3" style="v" altnumber="2" sid="PSA 142:3" /> איך גיס אױס פֿאַר אים מײַן קלאָג,</para>
  <para style="q" vid="PSA 142:3">מײַן נױט דערצײל איך פֿאַר אים.<verse eid="PSA 142:3" /></para>
  <para style="q">
    <verse number="4" style="v" altnumber="3" sid="PSA 142:4" /> װען מײַן געמיט פֿאַרגײט אין מיר,</para>
  <para style="q" vid="PSA 142:4">דו װײסט דאָך מײַן שטעג –</para>
  <para style="q" vid="PSA 142:4">אױף דעם װעג װאָס איך גײ,</para>
  <para style="q" vid="PSA 142:4">האָבן זײ מיר אַ פּאַסטקע באַהאַלטן.<verse eid="PSA 142:4" /></para>
  <para style="q">
    <verse number="5" style="v" altnumber="4" sid="PSA 142:5" /> קוק רעכטס, און זע,</para>
  <para style="q" vid="PSA 142:5">אַז איך האָב נישט קײן באַקענטן;</para>
  <para style="q" vid="PSA 142:5">פֿאַרלאָרן איז אַנטרינונג פֿון מיר,</para>
  <para style="q" vid="PSA 142:5">קײנער פֿרעגט נישט אױף מײַן זעל.<verse eid="PSA 142:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="PSA 142:6" /> איך שרײַ צו דיר, ה׳,</para>
  <para style="q" vid="PSA 142:6">איך זאָג: ביסט מײַן באַשיצונג,</para>
  <para style="q" vid="PSA 142:6">מײַן טײל אין דעם לאַנד פֿון די לעבעדיקע.<verse eid="PSA 142:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="PSA 142:7" /> פֿאַרנעם מײַן געשרײ,</para>
  <para style="q" vid="PSA 142:7">װאָרעם איך בין געפֿאַלן זײער;</para>
  <para style="q" vid="PSA 142:7">זײַ מיך מציל פֿון מײַנע נאָכיאָגער,</para>
  <para style="q" vid="PSA 142:7">װאָרעם זײ זײַנען שטאַרקער פֿון מיר.<verse eid="PSA 142:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="PSA 142:8" /> צי אַרױס פֿון פֿעסטונג מײַן זעל, צו לױבן דײַן נאָמען;</para>
  <para style="q" vid="PSA 142:8">דורך מיר װעלן די צדיקים זיך קרײנען,</para>
  <para style="q" vid="PSA 142:8">אַז דו װעסט מיר גוטס טאָן.<verse eid="PSA 142:8" /></para>
  <chapter eid="PSA 142" />
  <chapter number="143" style="c" pubnumber="קמג" sid="PSA 143" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 143:1" />אַ מיזמור פֿון דָוִדן.</para>
  <para style="q" vid="PSA 143:1">
    <char style="va">1</char>ה׳, הער מײַן תּפֿילה, פֿאַרנעם מײַנע געבעטן,</para>
  <para style="q" vid="PSA 143:1">אין דײַן טרײַשאַפֿט ענטפֿער מיר, אין דײַן גערעכטיקײט.<verse eid="PSA 143:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 143:2" />און זאָלסט נישט גײן אין משפּט מיט דײַן קנעכט,</para>
  <para style="q" vid="PSA 143:2">װאָרעם קײן לעבעדיקער קען נישט גערעכט זײַן פֿאַר דיר.<verse eid="PSA 143:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 143:3" />װאָרעם דער פֿײַנט האָט גערודפֿט מײַן זעל,</para>
  <para style="q" vid="PSA 143:3">ער האָט צוגעדריקט צו דער ערד מײַן לעבן,</para>
  <para style="q" vid="PSA 143:3">ער האָט מיך אַרײַנגעזעצט אין פֿינצטערנישן,</para>
  <para style="q" vid="PSA 143:3">װי געשטאָרבענע פֿון לאַנג אָן.<verse eid="PSA 143:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 143:4" />און מײַן געמיט פֿאַרגײט אין מיר,</para>
  <para style="q" vid="PSA 143:4">מײַן האַרץ װערט באַנומען אין מיר.<verse eid="PSA 143:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 143:5" />איך האָב זיך דערמאָנט די טעג פֿון אַ מאָל,</para>
  <para style="q" vid="PSA 143:5">איך האָב געטראַכט אָן אַל דײַן טוּונג;</para>
  <para style="q" vid="PSA 143:5">אָן דעם װערק פֿון דײַנע הענט טו איך קלערן.<verse eid="PSA 143:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 143:6" />איך האָב אױסגעשפּרײט מײַנע הענט צו דיר,</para>
  <para style="q" vid="PSA 143:6">מײַן זעל װי אַ פֿאַרשמאַכט לאַנד צו דיר.</para>
  <para style="q" vid="PSA 143:6">סֶלָה.<verse eid="PSA 143:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 143:7" />ענטפֿער מיר גיך, ה׳, מײַן געמיט גײט אױס;</para>
  <para style="q" vid="PSA 143:7">זאָלסט נישט פֿאַרבאָרגן דײַן פּנים פֿון מיר,</para>
  <para style="q" vid="PSA 143:7">אַזיסט װעל איך געגליכן זײַן צו די גענידערטע אין גרוב.<verse eid="PSA 143:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 143:8" />לאָז מיך הערן אין פֿרימאָרגן דײַן חֶסֶד,</para>
  <para style="q" vid="PSA 143:8">װאָרעם אױף דיר האָב איך מיך פֿאַרזיכערט.</para>
  <para style="q" vid="PSA 143:8">לאָז מיך װיסן דעם װעג װאָס איך זאָל גײן,</para>
  <para style="q" vid="PSA 143:8">װאָרעם צו דיר האָב איך אױפֿגעהױבן מײַן זעל.<verse eid="PSA 143:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 143:9" />זײַ מיך מציל, ה׳, פֿון מײַנע פֿײַנט;</para>
  <para style="q" vid="PSA 143:9">בײַ דיר האָב איך מיך פֿאַרבאָרגן.<verse eid="PSA 143:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 143:10" />לערן מיך צו טאָן דײַן רָצון,</para>
  <para style="q" vid="PSA 143:10">װאָרעם דו ביסט מײַן ג-ט;</para>
  <para style="q" vid="PSA 143:10">דײַן גוטער גײַסט זאָל מיך פֿירן אױף אַ גלײַכן לאַנד.<verse eid="PSA 143:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="PSA 143:11" />פֿון דײַן נאָמען װעגן, ה׳, זאָלסטו מיך אױפֿלעבן,</para>
  <para style="q" vid="PSA 143:11">אין דײַן גערעכטיקײט זאָלסטו אַרױסציען פֿון נױט מײַן זעל.<verse eid="PSA 143:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 143:12" />און אין דײַן חֶסֶד זאָלסטו פֿאַרשנײַדן מײַנע פֿײַנט,</para>
  <para style="q" vid="PSA 143:12">און אונטערברענגען אַלע װאָס דריקן מײַן זעל,</para>
  <para style="q" vid="PSA 143:12">װאָרעם איך בין דײַן קנעכט.<verse eid="PSA 143:12" /></para>
  <chapter eid="PSA 143" />
  <chapter number="144" style="c" pubnumber="קמד" sid="PSA 144" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 144:1" />פֿון דָוִדן.</para>
  <para style="q" vid="PSA 144:1">
    <char style="va">1</char> ברוך ה׳ מײַן פֿעלדז,</para>
  <para style="q" vid="PSA 144:1">װאָס לערנט מײַנע הענט צו קריג,</para>
  <para style="q" vid="PSA 144:1">מײַנע פֿינגער צו מלחמה.<verse eid="PSA 144:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 144:2" />מײַן גענאָד און מײַן פֿעסטונג,</para>
  <para style="q" vid="PSA 144:2">מײַן טורעם און דער װאָס מאַכט מיך אַנטרינען:</para>
  <para style="q" vid="PSA 144:2">מײַן שילד און דער װאָס איך שיץ מיך אין אים,</para>
  <para style="q" vid="PSA 144:2">דער װאָס אונטערטעניקט מײַן פֿאָלק אונטער מיר.<verse eid="PSA 144:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 144:3" />ה׳, װאָס איז דער מענטש, אַז דו זאָלסט זיך קימערן אום אים?</para>
  <para style="q" vid="PSA 144:3">און אַ מענטשנקינד, אַז דו זאָלסט אַכטן אױף אים?<verse eid="PSA 144:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 144:4" />אַ מענטש איז געגליכן צו אַ הױך,</para>
  <para style="q" vid="PSA 144:4">זײַנע טעג זײַנען װי אַ שאָטן װאָס פֿאַרגײט.<verse eid="PSA 144:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 144:5" />ה׳, נײַג דײַנע הימלען און זאָלסט אַראָפּנידערן,</para>
  <para style="q" vid="PSA 144:5">ריר אָן די בערג, און זײ זאָלן רײכערן.<verse eid="PSA 144:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 144:6" />בליץ אַרױס אַ בליץ, און זאָלסט זײ צעשפּרײטן,</para>
  <para style="q" vid="PSA 144:6">שיק דײַנע פֿײַלן, און פֿאַרטומל זײ.<verse eid="PSA 144:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 144:7" />שטרעק אױס דײַנע הענט פֿון דער הײך,</para>
  <para style="q" vid="PSA 144:7">רײַס מיך אַרױס און זײַ מיך מציל פֿון װאַסערן גרױסע,</para>
  <para style="q" vid="PSA 144:7">פֿון דער האַנט פֿון פֿרעמדגעבאָרענע,<verse eid="PSA 144:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 144:8" />װאָס זײער מױל רעדט פֿאַלשקײט,</para>
  <para style="q" vid="PSA 144:8">און זײער רעכטע האַנט איז אַ רעכטע האַנט פֿון ליגן.<verse eid="PSA 144:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="PSA 144:9" />אלֹקים, אַ נײַ געזאַנג װעל איך דיר זינגען,</para>
  <para style="q" vid="PSA 144:9">אױף אַ גיטאַר פֿון צען סטרונעס װעל איך שפּילן צו דיר,<verse eid="PSA 144:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 144:10" />װאָס גיסט הילף צו די מלכים,</para>
  <para style="q" vid="PSA 144:10">װאָס רײַסט אַרױס דָוִד זײַן קנעכט פֿון דער בײזער שװערד.<verse eid="PSA 144:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 144:11" />רײַס מיך אַרױס און זײַ מיך מציל</para>
  <para style="q" vid="PSA 144:11">פֿון דער האַנט פֿון פֿרעמדגעבאָרענע,</para>
  <para style="q" vid="PSA 144:11">װאָס זײער מױל רעדט פֿאַלשקײט,</para>
  <para style="q" vid="PSA 144:11">און זײער רעכטע האַנט איז אַ רעכטע האַנט פֿון ליגן.<verse eid="PSA 144:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 144:12" />װאָס אונדזערע זין זײַנען װי אױפֿגעװאַקסענע פֿלאַנצן אין זײער יוגנט;</para>
  <para style="q" vid="PSA 144:12">אונדזערע טעכטער װי װינקלזײַלן</para>
  <para style="q" vid="PSA 144:12">געשניצט לױט דעם בױ פֿון אַ הֵיכל;<verse eid="PSA 144:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 144:13" />אונדזערע שפּײַכלערס פֿול,</para>
  <para style="q" vid="PSA 144:13">אַרױסגעבנדיק אַלערלײ מינים;</para>
  <para style="q" vid="PSA 144:13">אונדזערע שאָף אין טױזנטן,</para>
  <para style="q" vid="PSA 144:13">אין צענטױזנטן, אױף אונדזערע פֿעלדער;<verse eid="PSA 144:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 144:14" />אונדזערע אָקסן באַלאָדן;</para>
  <para style="q" vid="PSA 144:14">קײן בראָך, און קײן מינערונג,</para>
  <para style="q" vid="PSA 144:14">און קײן װײגעשרײ אין אונדזערע גאַסן –<verse eid="PSA 144:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 144:15" />װױל צו דעם פֿאָלק װאָס בײַ אים איז אַזױ,</para>
  <para style="q" vid="PSA 144:15">װױל צו דעם פֿאָלק װאָס ה׳ איז זײַן ג-ט.<verse eid="PSA 144:15" /></para>
  <chapter eid="PSA 144" />
  <chapter number="145" style="c" pubnumber="קמה" sid="PSA 145" />
  <para style="d">
    <verse number="1" style="v" sid="PSA 145:1" />אַ לױבונג פֿון דָוִדן.</para>
  <para style="q" vid="PSA 145:1">
    <char style="va">1</char> איך װעל דיך דערהײבן, מײַן ג-ט דער קיניג,</para>
  <para style="q" vid="PSA 145:1">און בענטשן דײַן נאָמען אײביק און שטענדיק.<verse eid="PSA 145:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 145:2" />אַלע טאָג װעל איך דיך בענטשן,</para>
  <para style="q" vid="PSA 145:2">און רימען דײַן נאָמען אײביק און שטענדיק.<verse eid="PSA 145:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 145:3" />גרױס איז ה׳ און זײער גערימט,</para>
  <para style="q" vid="PSA 145:3">און זײַן גרױסקײט איז נישט צו דערפֿאָרשן.<verse eid="PSA 145:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 145:4" />אַ דור צו אַ דור װעט לױבן דײַנע מעשׂים,</para>
  <para style="q" vid="PSA 145:4">און דײַנע גבֿורות װעלן זײ אָנזאָגן.<verse eid="PSA 145:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 145:5" />די פּראַכטיקע שײנקײט פֿון דײַן גלאַנץ,</para>
  <para style="q" vid="PSA 145:5">און די מעשׂיות פֿון דײַנע װוּנדער װעל איך דערצײלן.<verse eid="PSA 145:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 145:6" />און פֿון דער שטאַרקײט פֿון דײַנע פֿאָרכטיקע אױפֿטוען װעט מען רעדן,</para>
  <para style="q" vid="PSA 145:6">און דײַן גרױסקײט, זי װעל איך פֿאַרצײלן.<verse eid="PSA 145:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 145:7" />די דערמאָנונג פֿון דײַן גרױס גוטסקײט װעט מען אַרױסזאָגן,</para>
  <para style="q" vid="PSA 145:7">און דײַן גערעכטיקײט װעט מען באַזינגען.<verse eid="PSA 145:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="PSA 145:8" />לײַטזעליק און דערבאַרעמדיק איז ה׳,</para>
  <para style="q" vid="PSA 145:8">אײַנגעהאַלטן אין צאָרן און גרױס אין גענאָד.<verse eid="PSA 145:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 145:9" />גוט איז ה׳ צו אַלעמען,</para>
  <para style="q" vid="PSA 145:9">און זײַן רַחמָנות איז אױף אַלע זײַנע װערק.<verse eid="PSA 145:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 145:10" />דיך װעלן לױבן, ה׳, אַלע דײַנע װערק,</para>
  <para style="q" vid="PSA 145:10">און דײַנע פֿרומע װעלן דיך בענטשן.<verse eid="PSA 145:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 145:11" />די פּראַכט פֿון דײַן מלוכה װעלן זײ דערצײלן,</para>
  <para style="q" vid="PSA 145:11">און פֿון דײַן גבֿורה װעלן זײ רעדן;<verse eid="PSA 145:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 145:12" />צו לאָזן װיסן די מענטשנקינדער זײַנע גבֿורות,</para>
  <para style="q" vid="PSA 145:12">און די פּראַכטיקע שײנקײט פֿון זײַן מלוכה.<verse eid="PSA 145:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 145:13" />דײַן מלוכה איז די מלוכה פֿון אַלע אײביקײטן,</para>
  <para style="q" vid="PSA 145:13">און דײַן געװעלטיקונג איז אין אַלע דור-דורות.<verse eid="PSA 145:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="PSA 145:14" />ה׳ לענט אונטער אַלע געפֿאַלענע,</para>
  <para style="q" vid="PSA 145:14">און שטעלט אױף אַלע געבױגענע.<verse eid="PSA 145:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 145:15" />די אױגן פֿון אַלעמען קוקן אױס אױף דיר,</para>
  <para style="q" vid="PSA 145:15">און דו גיסט זײ זײער עסן אין זײַן צײַט.<verse eid="PSA 145:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 145:16" />עפֿנסט דײַן האַנט,</para>
  <para style="q" vid="PSA 145:16">און זעטיקסט יעטװעדער לעבעדיקן מיט גוטװיליקײט.<verse eid="PSA 145:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 145:17" />גערעכט איז ה׳ אין אַלע זײַנע װעגן,</para>
  <para style="q" vid="PSA 145:17">און גענאָדיק אין אַלע זײַנע מעשׂים.<verse eid="PSA 145:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 145:18" />ה׳ איז נאָנט צו אַלע װאָס רופֿן אים,</para>
  <para style="q" vid="PSA 145:18">צו אַלע װאָס רופֿן אים מיט אמת.<verse eid="PSA 145:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 145:19" />ער טוט דעם רָצון פֿון די װאָס פֿאָרכטן אים,</para>
  <para style="q" vid="PSA 145:19">און זײער געשרײ הערט ער צו, און העלפֿט זײ.<verse eid="PSA 145:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 145:20" />ה׳ באַהיט אַלע װאָס האָבן אים ליב,</para>
  <para style="q" vid="PSA 145:20">און אַלע רשעים װעט ער פֿאַרטיליקן.<verse eid="PSA 145:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="PSA 145:21" />דעם לױב פֿון ה׳ זאָל רעדן מײַן מױל,</para>
  <para style="q" vid="PSA 145:21">און יעטװעדער לײַב זאָל בענטשן זײַן הײליקן נאָמען</para>
  <para style="q" vid="PSA 145:21">אײביק און שטענדיק.<verse eid="PSA 145:21" /></para>
  <chapter eid="PSA 145" />
  <chapter number="146" style="c" pubnumber="קמו" sid="PSA 146" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 146:1" />הַלְלוּ יָהּ.</para>
  <para style="q" vid="PSA 146:1">לױב ה׳, מײַן זעל;<verse eid="PSA 146:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 146:2" />איך װעל לױבן ה׳ כּל-זמן איך לעב,</para>
  <para style="q" vid="PSA 146:2">איך װעל זינגען צו ה׳ װי לאַנג איך בין.<verse eid="PSA 146:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 146:3" />איר זאָלט אײַך נישט פֿאַרזיכערן אױף פֿירשטן,</para>
  <para style="q" vid="PSA 146:3">אױף אַ מענטשנקינד װאָס נישטאָ בײַ אים קײן הילף.<verse eid="PSA 146:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 146:4" />גײט אױס זײַן אָטעם, קערט ער זיך אום צו זײַן שטױב;</para>
  <para style="q" vid="PSA 146:4">אין יענעם טאָג גײען אונטער זײַנע טראַכטונגען.<verse eid="PSA 146:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="PSA 146:5" />װױל צו דעם װאָס דער אֵל פֿון יעקבֿ איז זײַן הילף,</para>
  <para style="q" vid="PSA 146:5">װאָס זײַן אױסקוק איז אױף ה׳ זײַן ג-ט,<verse eid="PSA 146:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 146:6" />װאָס האָט געמאַכט דעם הימל און די ערד,</para>
  <para style="q" vid="PSA 146:6">דעם ים, און אַלץ װאָס אין זײ;</para>
  <para style="q" vid="PSA 146:6">דער װאָס היט טרײַשאַפֿט אױף אײביק;<verse eid="PSA 146:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 146:7" />װאָס טוט רעכט צו די געדריקטע,</para>
  <para style="q" vid="PSA 146:7">װאָס גיט ברױט צו די הונגעריקע.</para>
  <para style="q" vid="PSA 146:7">ה׳ בינדט אָפּ די געבונדענע,<verse eid="PSA 146:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 146:8" />ה׳ מאַכט זעעדיק די בלינדע,</para>
  <para style="q" vid="PSA 146:8">ה׳ שטעלט אױף די געבױגענע,</para>
  <para style="q" vid="PSA 146:8">ה׳ האָט ליב די גערעכטע.<verse eid="PSA 146:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 146:9" />ה׳ באַהיט די פֿרעמדע;</para>
  <para style="q" vid="PSA 146:9">דעם יתום און די אַלמנה ריכט ער אױף,</para>
  <para style="q" vid="PSA 146:9">און דעם װעג פֿון די רשעים פֿאַרדרײט ער.<verse eid="PSA 146:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="PSA 146:10" />ה׳ װעט קיניגן אױף אײביק,</para>
  <para style="q" vid="PSA 146:10">דײַן ג-ט, צִיוֹן, אױף דור-דורות.</para>
  <para style="q" vid="PSA 146:10">הַלְלוּ יָהּ.<verse eid="PSA 146:10" /></para>
  <chapter eid="PSA 146" />
  <chapter number="147" style="c" pubnumber="קמז" sid="PSA 147" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 147:1" />הַלְלוּ יָהּ;</para>
  <para style="q" vid="PSA 147:1">װאָרעם גוט איז זינגען צו אלוקינו,</para>
  <para style="q" vid="PSA 147:1">װאָרעם עס איז ליבלעך;</para>
  <para style="q" vid="PSA 147:1">שײן איז דאָס לױבן.<verse eid="PSA 147:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 147:2" />ה׳ בױט ירושָלַיִם,</para>
  <para style="q" vid="PSA 147:2">די פֿאַרשטױסענע פֿון יִשׂרָאֵל װעט ער אײַנזאַמלען;<verse eid="PSA 147:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 147:3" />דער װאָס הײלט די צעבראָכענע הערצער,</para>
  <para style="q" vid="PSA 147:3">און פֿאַרבינדט זײערע װוּנדן.<verse eid="PSA 147:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 147:4" />ער צײלט דעם מיספּר פֿון די שטערן,</para>
  <para style="q" vid="PSA 147:4">זײ אַלע מיט נעמען רופֿט ער אָן.<verse eid="PSA 147:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 147:5" />גרױס איז אונדזער האַר און מאַכטיק אין כּוֹח,</para>
  <para style="q" vid="PSA 147:5">נישטאָ קײן שיעור צו זײַן פֿאַרשטאַנדיקײט.<verse eid="PSA 147:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 147:6" />ה׳ ריכט אױף די געדריקטע,</para>
  <para style="q" vid="PSA 147:6">ער דערנידערט די רשעים ביז דער ערד.<verse eid="PSA 147:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 147:7" />זינגט צו ה׳ מיט לױב-געזאַנג,</para>
  <para style="q" vid="PSA 147:7">שפּילט צו אלוקינו אױף דער האַרף.<verse eid="PSA 147:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 147:8" />דער װאָס באַדעקט דעם הימל מיט װאָלקנס,</para>
  <para style="q" vid="PSA 147:8">װאָס ברײט אָן רעגן פֿאַר דער ערד,</para>
  <para style="q" vid="PSA 147:8">װאָס באַשפּראָצט די בערג מיט גראָז.<verse eid="PSA 147:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 147:9" />ער גיט דער בהמה איר שפּײַז,</para>
  <para style="q" vid="PSA 147:9">די קינדער פֿון ראָב װאָס רופֿן.<verse eid="PSA 147:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 147:10" />נישט די גבֿורה פֿון דעם פֿערד באַגערט ער,</para>
  <para style="q" vid="PSA 147:10">נישט די שענקלען פֿון דעם מאַן װיל ער.<verse eid="PSA 147:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 147:11" />ה׳ װיל די װאָס פֿאָרכטן אים,</para>
  <para style="q" vid="PSA 147:11">די װאָס האַרן אױף זײַן חֶסֶד.<verse eid="PSA 147:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="PSA 147:12" />גיב אַ שבֿח צו ה׳, ירושָלַיִם,</para>
  <para style="q" vid="PSA 147:12">לױב דײַן ג-ט, צִיוֹן.<verse eid="PSA 147:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="PSA 147:13" />װאָרעם ער האָט געשטאַרקט די ריגלען פֿון דײַנע טױערן,</para>
  <para style="q" vid="PSA 147:13">ער האָט געבענטשט דײַנע קינדער אין דיר;<verse eid="PSA 147:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 147:14" />דער װאָס גיט דײַן געמאַרק שלום,</para>
  <para style="q" vid="PSA 147:14">דיך זעטיקט מיט פֿעטס פֿון װײץ;<verse eid="PSA 147:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="PSA 147:15" />דער װאָס שיקט זײַן אָנזאָג אױף דער ערד –</para>
  <para style="q" vid="PSA 147:15">אױף גיך לױפֿט זײַן װאָרט;<verse eid="PSA 147:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="PSA 147:16" />דער װאָס גיט שנײ אַזױ װי װאָל,</para>
  <para style="q" vid="PSA 147:16">פֿראָסט װי אַש טוט ער שפּרײטן.<verse eid="PSA 147:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="PSA 147:17" />ער װאַרפֿט זײַן אײַז אַזױ װי ברעקלעך;</para>
  <para style="q" vid="PSA 147:17">פֿאַר זײַן קעלט, װער קען באַשטײן?<verse eid="PSA 147:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="PSA 147:18" />ער שיקט זײַן װאָרט, און מאַכט זײ צעגײן;</para>
  <para style="q" vid="PSA 147:18">ער מאַכט בלאָזן זײַן װינט, רינען װאַסערן.<verse eid="PSA 147:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="PSA 147:19" />ער זאָגט זײַנע װערטער צו יעקבֿ,</para>
  <para style="q" vid="PSA 147:19">זײַנע חוקים און זײַנע געזעצן צו יִשׂרָאֵל.<verse eid="PSA 147:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="PSA 147:20" />ער האָט אַזױ נישט געטאָן צו קײן פֿאָלק,</para>
  <para style="q" vid="PSA 147:20">און געזעצן, דערפֿון װײסן זײ נישט.</para>
  <para style="q" vid="PSA 147:20">הַלְלוּ יָהּ.<verse eid="PSA 147:20" /></para>
  <chapter eid="PSA 147" />
  <chapter number="148" style="c" pubnumber="קמח" sid="PSA 148" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 148:1" />הַלְלוּ יָהּ.</para>
  <para style="q" vid="PSA 148:1">לױבט ה׳, פֿון די הימלען,</para>
  <para style="q" vid="PSA 148:1">לױבט אים אין די הײכן.<verse eid="PSA 148:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 148:2" />לױבט אים, אַלע זײַנע מלאָכים;</para>
  <para style="q" vid="PSA 148:2">לױבט אים, אַלע זײַנע חילות.<verse eid="PSA 148:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 148:3" />לױבט אים, זון און לבֿנה;</para>
  <para style="q" vid="PSA 148:3">לױבט אים, אַלע ליכטיקע שטערן.<verse eid="PSA 148:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="PSA 148:4" />לױבט אים, די הימלען פֿון די הימלען,</para>
  <para style="q" vid="PSA 148:4">און די װאַסערן װאָס איבער די הימלען.<verse eid="PSA 148:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 148:5" />זאָלן זײ לױבן דעם נאָמען פֿון ה׳,</para>
  <para style="q" vid="PSA 148:5">װאָרעם ער האָט באַפֿױלן, און זײ זײַנען באַשאַפֿן געװאָרן.<verse eid="PSA 148:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 148:6" />און ער האָט זײ אױפֿגעשטעלט אױף שטענדיק, אױף אײביק;</para>
  <para style="q" vid="PSA 148:6">ער האָט געשטעלט אַ געזעץ װאָס זאָל נישט פֿאַרגײן.<verse eid="PSA 148:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="PSA 148:7" />לױבט ה׳, פֿון דער ערד,</para>
  <para style="q" vid="PSA 148:7">איר ים-חיות און אַלע תּהומען;<verse eid="PSA 148:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 148:8" />פֿײַער און האָגל, שנײ און נעבל;</para>
  <para style="q" vid="PSA 148:8">דער שטורעמװינט װאָס טוט זײַן װאָרט;<verse eid="PSA 148:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 148:9" />בערג און אַלע הײכן,</para>
  <para style="q" vid="PSA 148:9">פֿרוכטבײמער און אַלע צעדערן;<verse eid="PSA 148:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="PSA 148:10" />חיות און אַלע בהמות,</para>
  <para style="q" vid="PSA 148:10">שרצים און געפֿליגלטע פֿױגלען;<verse eid="PSA 148:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="PSA 148:11" />מלכים פֿון דער ערד און אַלע פֿעלקער,</para>
  <para style="q" vid="PSA 148:11">האַרן און אַלע ריכטער פֿון דער ערד;<verse eid="PSA 148:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="PSA 148:12" />בחורים און אױך יונגפֿרױען,</para>
  <para style="q" vid="PSA 148:12">זקנים מיט ייִנגלעך.<verse eid="PSA 148:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="PSA 148:13" />זײ זאָלן לױבן דעם נאָמען פֿון ה׳,</para>
  <para style="q" vid="PSA 148:13">װאָרעם זײַן נאָמען אַלײן איז דערהױבן;</para>
  <para style="q" vid="PSA 148:13">זײַן גלאַנץ איבער ערד און הימל.<verse eid="PSA 148:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="PSA 148:14" />און ער האָט דערהײכט דעם האָרן פֿון זײַן פֿאָלק –</para>
  <para style="q" vid="PSA 148:14">אַ לױב פֿאַר אַלע זײַנע פֿרומע,</para>
  <para style="q" vid="PSA 148:14">פֿאַר די קינדער פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="PSA 148:14">דעם פֿאָלק װאָס איז אים נאָנט.</para>
  <para style="q" vid="PSA 148:14">הַלְלוּ יָהּ.<verse eid="PSA 148:14" /></para>
  <chapter eid="PSA 148" />
  <chapter number="149" style="c" pubnumber="קמט" sid="PSA 149" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 149:1" />הַלְלוּ יָהּ.</para>
  <para style="q" vid="PSA 149:1">זינגט צו ה׳ אַ נײַ געזאַנג,</para>
  <para style="q" vid="PSA 149:1">זײַן לױב אין דער אײַנזאַמלונג פֿון די פֿרומע.<verse eid="PSA 149:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 149:2" />זאָל זיך פֿרײען יִשׂרָאֵל מיט זײַן באַשעפֿער,</para>
  <para style="q" vid="PSA 149:2">די קינדער פֿון צִיוֹן זאָלן לוסטיק זײַן מיט זײער מלך.<verse eid="PSA 149:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="PSA 149:3" />זאָלן זײ לױבן זײַן נאָמען מיט טאַנץ,</para>
  <para style="q" vid="PSA 149:3">מיט פּױק און האַרף זאָלן זײ שפּילן צו אים.<verse eid="PSA 149:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 149:4" />װאָרעם ה׳ באַװיליקט זײַן פֿאָלק,</para>
  <para style="q" vid="PSA 149:4">ער באַשײנט די געדריקטע מיט הילף.<verse eid="PSA 149:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 149:5" />זאָלן די פֿרומע זיך פֿרײען אין כּבֿוד,</para>
  <para style="q" vid="PSA 149:5">זאָלן זײ זינגען אױף זײערע געלעגערס.<verse eid="PSA 149:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 149:6" />דער הײבונגען פֿון אֵל אין זײער מױל,</para>
  <para style="q" vid="PSA 149:6">און אַ צװײשאַרפֿיקע שװערד אין זײער האַנט,<verse eid="PSA 149:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="PSA 149:7" />צו טאָן אַ נקמה אָן די פֿעלקער,</para>
  <para style="q" vid="PSA 149:7">שטראָפֿונגען אױף די אומות;<verse eid="PSA 149:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="PSA 149:8" />צו שמידן זײערע מלכים אין קײטן,</para>
  <para style="q" vid="PSA 149:8">און זײערע אָנגעזעענע אין אײַזערנע רינגען;<verse eid="PSA 149:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="PSA 149:9" />צו טאָן אױף זײ דעם אָנגעשריבענעם משפּט.</para>
  <para style="q" vid="PSA 149:9">שײן װעט דאָס זײַן פֿאַר אַלע זײַנע פֿרומע.</para>
  <para style="q" vid="PSA 149:9">הַלְלוּ יָהּ.<verse eid="PSA 149:9" /></para>
  <chapter eid="PSA 149" />
  <chapter number="150" style="c" pubnumber="קנ" sid="PSA 150" />
  <para style="q">
    <verse number="1" style="v" sid="PSA 150:1" />הַלְלוּ יָהּ.</para>
  <para style="q" vid="PSA 150:1">לױבט ה׳ אין זײַן הײליקטום,</para>
  <para style="q" vid="PSA 150:1">לױבט אים אין זײַן מאַכטיקן הימל.<verse eid="PSA 150:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="PSA 150:2" />לױבט אים װעגן זײַנע גבֿורות,</para>
  <para style="q" vid="PSA 150:2">לױבט אים לױט זײַן פֿיל גרױסקײט.<verse eid="PSA 150:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="PSA 150:3" />לױבט אים מיט בלאָזונג פֿון שופֿר,</para>
  <para style="q" vid="PSA 150:3">לױבט אים מיט גיטאַר און האַרף.<verse eid="PSA 150:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="PSA 150:4" />לױבט אים מיט פּױק און טאַנץ,</para>
  <para style="q" vid="PSA 150:4">לױבט אים מיט סטרונעס און פֿלײט.<verse eid="PSA 150:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="PSA 150:5" />לױבט אים מיט קלינגעדיקע צימבלען,</para>
  <para style="q" vid="PSA 150:5">לױבט אים מיט הילכיקע צימבלען.<verse eid="PSA 150:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="PSA 150:6" />אַלץ װאָס אָטעמט זאָל לױבן ג-ט.</para>
  <para style="q" vid="PSA 150:6">הַלְלוּ יָהּ.<verse eid="PSA 150:6" /></para>
  <chapter eid="PSA 150" />
</usx>