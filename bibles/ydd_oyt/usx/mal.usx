<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MAL" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">מַלאָכי</para>
  <para style="toc2">מַלאָכי</para>
  <para style="toc1">מַלאָכִי</para>
  <para style="mt1">מַלאָכי</para>
  <chapter number="1" style="c" pubnumber="א" sid="MAL 1" />
  <para style="p">
    <verse number="1" style="v" sid="MAL 1:1" />די נבֿואה פֿון ה׳ס װאָרט צו יִשׂרָאֵל דורך מַלאָכין:<verse eid="MAL 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="MAL 1:2" />איך האָב אײַך ליב געהאַט, זאָגט ה׳.</para>
  <para style="q" vid="MAL 1:2">און איר זאָגט: מיט װאָס האָסטו אונדז ליב געהאַט?</para>
  <para style="q" vid="MAL 1:2">איז נישט עֵשָׂו יעקבֿס אַ ברודער? זאָגט ה׳,</para>
  <para style="q" vid="MAL 1:2">פֿון דערװעגן האָב איך יעקבֿן ליב געהאַט,<verse eid="MAL 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MAL 1:3" />און עֵשָׂון האָב איך פֿײַנט געהאַט,</para>
  <para style="q" vid="MAL 1:3">און געמאַכט זײַנע בערג אַ װיסטעניש,</para>
  <para style="q" vid="MAL 1:3">און זײַן נחלה פֿאַר מדבר-שאַקאַלן.<verse eid="MAL 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAL 1:4" />אױב אֶדוֹם זאָגט:</para>
  <para style="q" vid="MAL 1:4">מיר זײַנען צעשטערט געװאָרן,</para>
  <para style="q" vid="MAL 1:4">אָבער מיר װעלן װידער אָפּבױען די חורבֿות,</para>
  <para style="q" vid="MAL 1:4">האָט ה׳ צבָֿאוֹת אַזױ געזאָגט:</para>
  <para style="q" vid="MAL 1:4">זײ װעלן בױען, און איך װעל צעשטערן,</para>
  <para style="q" vid="MAL 1:4">און מע װעט זײ רופֿן דער געמאַרק פֿון שלעכטיקײט,</para>
  <para style="q" vid="MAL 1:4">און דאָס פֿאָלק װאָס ה׳ האָט פֿאַרשאָלטן אױף אײביק.<verse eid="MAL 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAL 1:5" />און אײַערע אױגן װעלן זען,</para>
  <para style="q" vid="MAL 1:5">און איר װעט זאָגן:</para>
  <para style="q" vid="MAL 1:5">ה׳ איז גרױס אַריבער דעם געמאַרק פֿון יִשׂרָאֵל.<verse eid="MAL 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="MAL 1:6" />אַ זון גיט כּבֿוד אַ פֿאָטער,</para>
  <para style="q" vid="MAL 1:6">און אַ קנעכט זײַן האַר;</para>
  <para style="q" vid="MAL 1:6">איז אױב איך בין אַ פֿאָטער,</para>
  <para style="q" vid="MAL 1:6">װוּ איז מײַן כּבֿוד?</para>
  <para style="q" vid="MAL 1:6">און אױב איך בין אַ האַר,</para>
  <para style="q" vid="MAL 1:6">װוּ איז די מורא פֿאַר מיר?</para>
  <para style="q" vid="MAL 1:6">זאָגט ה׳ צבָֿאוֹת צו אײַך, כּהנים,</para>
  <para style="q" vid="MAL 1:6">װאָס זײַט מבֿזה מײַן נאָמען.</para>
  <para style="q" vid="MAL 1:6">און איר זאָגט: מיט װאָס זײַנען מיר מבֿזה דײַן נאָמען?<verse eid="MAL 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAL 1:7" />איר ברענגט אױף מײַן מזבח אומװערדיקע שפּײַז.</para>
  <para style="q" vid="MAL 1:7">און איר זאָגט: מיט װאָס האָבן מיר דיך פֿאַראומװערדיקט?</para>
  <para style="q" vid="MAL 1:7">מיט אײַער זאָגן: דער טיש פֿון ה׳ איז נימאס.<verse eid="MAL 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAL 1:8" />און אַז איר ברענגט אַ בלינדס קָרבָּן צו שלאַכטן,</para>
  <para style="q" vid="MAL 1:8">איז קײן בײז נישט!</para>
  <para style="q" vid="MAL 1:8">און אַז איר ברענגט אַ הינקעדיקס און אַ קראַנקס,</para>
  <para style="q" vid="MAL 1:8">איז קײן בײז נישט!</para>
  <para style="q" vid="MAL 1:8">גענען עס אַקאָרשט צו דײַן פֿירשט,</para>
  <para style="q" vid="MAL 1:8">צי ער װעט דיך באַװיליקן,</para>
  <para style="q" vid="MAL 1:8">אָדער װעט דיך אױפֿנעמען?</para>
  <para style="q" vid="MAL 1:8">זאָגט ה׳ צבָֿאוֹת.<verse eid="MAL 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAL 1:9" />און אַצונד בעט אַקאָרשט בײַ אֵל,</para>
  <para style="q" vid="MAL 1:9">ער זאָל אונדז לײַטזעליקן!</para>
  <para style="q" vid="MAL 1:9">דורך אײַער האַנט איז דאָס געשען;</para>
  <para style="q" vid="MAL 1:9">קען ער אױפֿנעמען דעם פּנים פֿון עמיצן פֿון אײַך?</para>
  <para style="q" vid="MAL 1:9">זאָגט ה׳ צבָֿאוֹת.<verse eid="MAL 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="MAL 1:10" />װאָלט גאָר װער פֿון אײַך צושליסן די טירן,</para>
  <para style="q" vid="MAL 1:10">און איר זאָלט נישט אָנצינדן פֿײַער אױף מײַן מזבח אומזיסט!</para>
  <para style="q" vid="MAL 1:10">איך װיל אײַך נישט האָבן,</para>
  <para style="q" vid="MAL 1:10">זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="MAL 1:10">און װעל נישט באַװיליקן קײן קָרבָּן פֿון אײַער האַנט.<verse eid="MAL 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MAL 1:11" />װאָרעם פֿון אױפֿגאַנג פֿון דער זון און ביז איר אונטערגאַנג</para>
  <para style="q" vid="MAL 1:11">איז מײַן נאָמען גרױס צװישן די פֿעלקער,</para>
  <para style="q" vid="MAL 1:11">און אין איטלעכן אָרט װערט װײַרעך געבראַכט צו מײַן נאָמען</para>
  <para style="q" vid="MAL 1:11">און שפּײַזאָפּפֿער רײנע;</para>
  <para style="q" vid="MAL 1:11">װײַל מײַן נאָמען איז גרױס צװישן די פֿעלקער,</para>
  <para style="q" vid="MAL 1:11">זאָגט ה׳ צבָֿאוֹת.<verse eid="MAL 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MAL 1:12" />און איר פֿאַרשװעכט אים מיט אײַער זאָגן:</para>
  <para style="q" vid="MAL 1:12">דער טיש פֿון אֲדֹנָי איז אומװערדיק,</para>
  <para style="q" vid="MAL 1:12">און זײַן פֿרוכט, זײַן שפּײַז, איז נימאס.<verse eid="MAL 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="MAL 1:13" />און איר זאָגט: זע, װאָס פֿאַר אַ טירחא!</para>
  <para style="q" vid="MAL 1:13">און איר בלאָזט דערױף,</para>
  <para style="q" vid="MAL 1:13">זאָגט ה׳ צבָֿאוֹת;</para>
  <para style="q" vid="MAL 1:13">און איר ברענגט אַ געגזלט,</para>
  <para style="q" vid="MAL 1:13">און אַ הינקעדיקס און אַ קראַנקס;</para>
  <para style="q" vid="MAL 1:13">און אַז איר ברענגט דעם קָרבָּן,</para>
  <para style="q" vid="MAL 1:13">זאָל איך אים באַװיליקן פֿון אײַער האַנט?</para>
  <para style="q" vid="MAL 1:13">זאָגט ה׳.<verse eid="MAL 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MAL 1:14" />און פֿאַרשאָלטן זאָל זײַן דער ליסטיקער,</para>
  <para style="q" vid="MAL 1:14">װאָס אין זײַן סטאַדע איז דאָ אַ זָכר,</para>
  <para style="q" vid="MAL 1:14">און ער איז מנדר און שלאַכט אַ געפֿעלערטס צו אֲדֹנָי;</para>
  <para style="q" vid="MAL 1:14">װאָרעם אַ גרױסער קיניג בין איך,</para>
  <para style="q" vid="MAL 1:14">זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="MAL 1:14">און מײַן נאָמען איז פֿאָרכטיק צװישן די פֿעלקער.<verse eid="MAL 1:14" /></para>
  <chapter eid="MAL 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="MAL 2" />
  <para style="p">
    <verse number="1" style="v" sid="MAL 2:1" />און אַצונד, צו אײַך איז דער דאָזיקער אָנזאָג, איר כּהנים:<verse eid="MAL 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="MAL 2:2" />אױב איר װעט נישט צוהערן,</para>
  <para style="q" vid="MAL 2:2">און אױב איר װעט נישט אַרײַננעמען אין האַרצן,</para>
  <para style="q" vid="MAL 2:2">צו געבן כּבֿוד צו מײַן נאָמען,</para>
  <para style="q" vid="MAL 2:2">זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="MAL 2:2">װעל איך אָנשיקן אױף אײַך אַ קללה,</para>
  <para style="q" vid="MAL 2:2">און איך װעל פֿאַרשילטן אײַערע גערעטענישן,</para>
  <para style="q" vid="MAL 2:2">יאָ, איך טו זײ פֿאַרשילטן,</para>
  <para style="q" vid="MAL 2:2">װײַל איר נעמט נישט צום האַרצן.<verse eid="MAL 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MAL 2:3" />זעט, איך װעל אָנשרײַען בײַ אײַך אױף דער זריעה;</para>
  <para style="q" vid="MAL 2:3">און איך װעל צעשיטן מיסט אױף אײַערע פּנימער,</para>
  <para style="q" vid="MAL 2:3">דעם מיסט פֿון אײַערע יוֹם-טובֿ-קָרְבֳנוֹת;</para>
  <para style="q" vid="MAL 2:3">און מע װעט אײַך אַװעקטראָגן מיט אים.<verse eid="MAL 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAL 2:4" />און איר װעט װיסן</para>
  <para style="q" vid="MAL 2:4">אַז איך האָב אײַך געשיקט דעם דאָזיקן אָנזאָג,</para>
  <para style="q" vid="MAL 2:4">כּדי מײַן ברית זאָל בלײַבן מיט לֵוִי,</para>
  <para style="q" vid="MAL 2:4">זאָגט ה׳ צבָֿאוֹת.<verse eid="MAL 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAL 2:5" />מײַן ברית איז מיט אים געװען אױף לעבן און פֿריד,</para>
  <para style="q" vid="MAL 2:5">און איך האָב זײ אים געגעבן,</para>
  <para style="q" vid="MAL 2:5">אױף מורא, און ער האָט פֿאַר מיר מורא געהאַט,</para>
  <para style="q" vid="MAL 2:5">און פֿאַר מײַן נאָמען האָט ער געאַנגסט.<verse eid="MAL 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="MAL 2:6" />די תּורה פֿון אמת איז געװען אין זײַן מױל,</para>
  <para style="q" vid="MAL 2:6">און קײן אומרעכט האָט זיך נישט געפֿונען אױף זײַנע ליפּן;</para>
  <para style="q" vid="MAL 2:6">אין פֿריד און אין רעכטפֿאַרטיקײט איז ער מיט מיר געגאַנגען,</para>
  <para style="q" vid="MAL 2:6">און פֿיל האָט ער אָפּגעקערט פֿון זינד.<verse eid="MAL 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAL 2:7" />װאָרעם די ליפּן פֿון כּהן דאַרפֿן היטן קענשאַפֿט,</para>
  <para style="q" vid="MAL 2:7">און די תּורה דאַרף מען זוכן פֿון זײַן מױל,</para>
  <para style="q" vid="MAL 2:7">װײַל דער שליח פֿון ה׳ צבָֿאוֹת איז ער.<verse eid="MAL 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAL 2:8" />אָבער איר האָט זיך אָפּגעקערט פֿון װעג,</para>
  <para style="q" vid="MAL 2:8">איר האָט געמאַכט שטרױכלען פֿיל אין דער תּורה,</para>
  <para style="q" vid="MAL 2:8">איר האָט פֿאַרדאָרבן דעם ברית פֿון לֵוִי,</para>
  <para style="q" vid="MAL 2:8">זאָגט ה׳ צבָֿאוֹת.<verse eid="MAL 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAL 2:9" />דערום האָב איך אױך אײַך געמאַכט</para>
  <para style="q" vid="MAL 2:9">ניבֿזה און שָפֿל בײַ דעם גאַנצן פֿאָלק,</para>
  <para style="q" vid="MAL 2:9">װעדליק װי איר היט נישט מײַנע װעגן,</para>
  <para style="q" vid="MAL 2:9">און שאַנעװעט מענטשן אין געזעץ.<verse eid="MAL 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="MAL 2:10" />איז נישט אײן פֿאָטער בײַ אונדז אַלעמען?</para>
  <para style="q" vid="MAL 2:10">האָט אונדז נישט אײן אֵל באַשאַפֿן?</para>
  <para style="q" vid="MAL 2:10">פֿאַר װאָס זאָלן מיר פֿעלשן אײנער אָן אַנדערן,</para>
  <para style="q" vid="MAL 2:10">צו פֿאַרשװעכן דעם ברית פֿון אונדזערע עלטערן?<verse eid="MAL 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MAL 2:11" />געפֿעלשט האָט יהוּדה,</para>
  <para style="q" vid="MAL 2:11">און אומװערדיקײט איז געטאָן געװאָרן</para>
  <para style="q" vid="MAL 2:11">אין יִשׂרָאֵל און אין ירושָלַיִם,</para>
  <para style="q" vid="MAL 2:11">װאָרעם פֿאַרשװעכט האָט יהוּדה</para>
  <para style="q" vid="MAL 2:11">די הײליקײט פֿון ה׳ װאָס ער האָט ליב געהאַט,</para>
  <para style="q" vid="MAL 2:11">און האָט באַמאַנט די טאָכטער פֿון אַ פֿרעמדן ג-ט.<verse eid="MAL 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MAL 2:12" />ה׳ װעט פֿאַרשנײַדן בײַ דעם מאַן װאָס טוט דאָס,</para>
  <para style="q" vid="MAL 2:12">אַ רופֿער און אַן ענטפֿערער פֿון די געצעלטן פֿון יעקבֿ,</para>
  <para style="q" vid="MAL 2:12">און דעם װאָס ברענגט אַ קָרבָּן צו ה׳ צבָֿאוֹת.<verse eid="MAL 2:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="MAL 2:13" />און צװײטנס טוט איר אָט װאָס:</para>
  <para style="q" vid="MAL 2:13">איר באַדעקט דעם מזבח פֿון ה׳ מיט טרערן.</para>
  <para style="q" vid="MAL 2:13">מיט געװײן און מיט זיפֿצעניש,</para>
  <para style="q" vid="MAL 2:13">ביז ער קען זיך מער נישט קערן צום קָרבָּן,</para>
  <para style="q" vid="MAL 2:13">און אים אָננעמען מיט באַװיליקונג פֿון אײַער האַנט.<verse eid="MAL 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MAL 2:14" />און איר זאָגט: פֿאַר װאָס? –</para>
  <para style="q" vid="MAL 2:14">װײַל ה׳ איז עדות</para>
  <para style="q" vid="MAL 2:14">צװישן דיר און דער װײַב פֿון דײַן יוגנט,</para>
  <para style="q" vid="MAL 2:14">װאָס דו האָסט געפֿעלשט אָן איר,</para>
  <para style="q" vid="MAL 2:14">הגם זי איז דײַן חבֿרטע,</para>
  <para style="q" vid="MAL 2:14">און די װײַב פֿון דײַן ברית.<verse eid="MAL 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAL 2:15" />און קײן אײנער װעט דאָס נישט טאָן</para>
  <para style="q" vid="MAL 2:15">װאָס האָט אַן איבערבלײַב פֿון גײַסט.</para>
  <para style="q" vid="MAL 2:15">װאָרעם װאָס פֿאַרלאַנגט יעטװעדער אײנער?</para>
  <para style="q" vid="MAL 2:15">אַ זאָמען פֿון אלֹקים.</para>
  <para style="q" vid="MAL 2:15">דערום זאָלט איר זײַן אָפּגעהיט אין אײַער גײַסט,</para>
  <para style="q" vid="MAL 2:15">און אָן דער װײַב פֿון זײַן יוגנט זאָל מען נישט פֿעלשן.<verse eid="MAL 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="MAL 2:16" />װאָרעם איך האָב פֿײַנט שײדונג,</para>
  <para style="q" vid="MAL 2:16">זאָגט ה׳ אלוקי יִשׂרָאֵל,</para>
  <para style="q" vid="MAL 2:16">און דעם װאָס באַדעקט זײַן קלײד מיט אומרעכט,</para>
  <para style="q" vid="MAL 2:16">זאָגט ה׳ צבָֿאוֹת;</para>
  <para style="q" vid="MAL 2:16">דערום זאָלט איר זײַן אָפּגעהיט אין אײַער גײַסט,</para>
  <para style="q" vid="MAL 2:16">אַז איר זאָלט נישט פֿעלשן.<verse eid="MAL 2:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="MAL 2:17" />איר האָט מיד געמאַכט ה׳ מיט אײַערע רײד,</para>
  <para style="q" vid="MAL 2:17">און איר זאָגט: מיט װאָס האָבן מיר מיד געמאַכט?</para>
  <para style="q" vid="MAL 2:17">מיט אײַער זאָגן: איטלעכער װאָס טוט בײז,</para>
  <para style="q" vid="MAL 2:17">איז גוט אין די אױגן פֿון ה׳,</para>
  <para style="q" vid="MAL 2:17">און זײ װיל ער האָבן;</para>
  <para style="q" vid="MAL 2:17">אָדער, װוּ איז דער אלֹקים פֿון גערעכטיקײט?<verse eid="MAL 2:17" /></para>
  <chapter eid="MAL 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="MAL 3" />
  <para style="q">
    <verse number="1" style="v" sid="MAL 3:1" />זע, איך שיק מײַן שליח,</para>
  <para style="q" vid="MAL 3:1">און ער װעט אָפּראַמען דעם װעג פֿאַר מיר,</para>
  <para style="q" vid="MAL 3:1">און פּלוצלינג װעט קומען צו זײַן הֵיכל</para>
  <para style="q" vid="MAL 3:1">הָאָדוֹן װעמען איר זוכט;</para>
  <para style="q" vid="MAL 3:1">און דער שליח פֿון ברית װעמען איר באַגערט,</para>
  <para style="q" vid="MAL 3:1">אָט קומט ער, זאָגט ה׳ צבָֿאוֹת.<verse eid="MAL 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="MAL 3:2" />און װער קען אױסהאַלטן דעם טאָג פֿון זײַן קומען?</para>
  <para style="q" vid="MAL 3:2">און װער איז דער װאָס קען באַשטײן, װען ער באַװײַזט זיך?</para>
  <para style="q" vid="MAL 3:2">װאָרעם ער איז װי פֿײַער פֿון דעם שמעלצער,</para>
  <para style="q" vid="MAL 3:2">און װי לױג פֿון װעשער.<verse eid="MAL 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="MAL 3:3" />און ער װעט זיצן װי אַ שמעלצער און אַ רײניקער פֿון זילבער,</para>
  <para style="q" vid="MAL 3:3">און װעט רײניקן די קינדער פֿון לֵוִי,</para>
  <para style="q" vid="MAL 3:3">און זײ לײַטערן װי גאָלד און װי זילבער;</para>
  <para style="q" vid="MAL 3:3">און זײ װעלן ברענגען צו ה׳</para>
  <para style="q" vid="MAL 3:3">קָרְבֳנוֹת אין גערעכטיקײט.<verse eid="MAL 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="MAL 3:4" />און אָנגעלײגט װעט זײַן בײַ ה׳</para>
  <para style="q" vid="MAL 3:4">דער קָרבָּן פֿון יהוּדה און ירושָלַיִם,</para>
  <para style="q" vid="MAL 3:4">װי אין די טעג פֿון אַמאָל,</para>
  <para style="q" vid="MAL 3:4">און װי אין פֿאַרצײַטיקע יאָרן.<verse eid="MAL 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="MAL 3:5" />און איך װעל גענענען צום משפּט אױף אײַך,</para>
  <para style="q" vid="MAL 3:5">און איך װעל זײַן אַ שנעלער עדות,</para>
  <para style="q" vid="MAL 3:5">אַקעגן די מכשפֿים, און אַקעגן די נוֹאפֿים,</para>
  <para style="q" vid="MAL 3:5">און אַקעגן די װאָס שװערן פֿאַלש,</para>
  <para style="q" vid="MAL 3:5">און אַקעגן די װאָס רױבן דעם לױנאַרבעטער פֿון זײַן לױן,</para>
  <para style="q" vid="MAL 3:5">די אַלמנה און דעם יתום,</para>
  <para style="q" vid="MAL 3:5">און קריװדען דעם פֿרעמדן,</para>
  <para style="q" vid="MAL 3:5">און האָבן נישט קײן מורא פֿאַר מיר,</para>
  <para style="q" vid="MAL 3:5">זאָגט ה׳ צבָֿאוֹת.<verse eid="MAL 3:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="MAL 3:6" />אָבער איך ה׳ ענדער זיך נישט,</para>
  <para style="q" vid="MAL 3:6">און איר קינדער פֿון יעקבֿ װעט נישט פֿאַרלענדט װערן.<verse eid="MAL 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="MAL 3:7" />פֿון די טעג פֿון אײַערע עלטערן אָן</para>
  <para style="q" vid="MAL 3:7">האָט איר זיך אָפּגעקערט פֿון מײַנע געזעצן,</para>
  <para style="q" vid="MAL 3:7">און זײ נישט געהיט;</para>
  <para style="q" vid="MAL 3:7">קערט אײַך אום צו מיר, און איך װעל זיך אומקערן צו אײַך,</para>
  <para style="q" vid="MAL 3:7">זאָגט ה׳ צבָֿאוֹת.</para>
  <para style="q" vid="MAL 3:7">אָבער איר זאָגט: װעגן װאָס זאָלן מיר זיך אומקערן?<verse eid="MAL 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="MAL 3:8" />צי דאַרף אַ מענטש באַרױבן אלֹקים,</para>
  <para style="q" vid="MAL 3:8">װאָס איר באַרױבט מיך?</para>
  <para style="q" vid="MAL 3:8">און איר זאָגט: אין װאָס באַרױבן מיר דיך?</para>
  <para style="q" vid="MAL 3:8">אין דעם מעשׂר און דער אָפּשײדונג.<verse eid="MAL 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="MAL 3:9" />איר זײַט מיט אַ קללה פֿאַרשאָלטן,</para>
  <para style="q" vid="MAL 3:9">פֿון דעסט װעגן באַרױבט איר מיך,</para>
  <para style="q" vid="MAL 3:9">דאָס גאַנצע פֿאָלק.<verse eid="MAL 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="MAL 3:10" />ברענגט דעם גאַנצן מעשׂר אין שאַצהױז,</para>
  <para style="q" vid="MAL 3:10">און זאָל זײַן שפּײַז אין מײַן הױז,</para>
  <para style="q" vid="MAL 3:10">און פּרוּװט מיך אַקאָרשט דערמיט,</para>
  <para style="q" vid="MAL 3:10">זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="MAL 3:10">אױב איך װעל אײַך נישט עפֿענען די פֿענצטער פֿון הימל,</para>
  <para style="q" vid="MAL 3:10">און װעל אײַך נישט אַראָפּגיסן אַ ברכה</para>
  <para style="q" vid="MAL 3:10">ביז איבער גענוג.<verse eid="MAL 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="MAL 3:11" />און איך װעל אָנשרײַען פֿון אײַערטװעגן אױף דעם פֿאַרצערער,</para>
  <para style="q" vid="MAL 3:11">און ער װעט אײַך נישט פֿאַרװיסטן די פֿרוכט פֿון דער ערד,</para>
  <para style="q" vid="MAL 3:11">און אײַער װײַנשטאָק װעט נישט פֿאַרװאַרפֿן אין פֿעלד,</para>
  <para style="q" vid="MAL 3:11">זאָגט ה׳ צבָֿאוֹת.<verse eid="MAL 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="MAL 3:12" />און אַלע פֿעלקער װעלן אײַך שאַצן גליקלעך,</para>
  <para style="q" vid="MAL 3:12">װאָרעם איר װעט זײַן אַ געװינטשט לאַנד,</para>
  <para style="q" vid="MAL 3:12">זאָגט ה׳ צבָֿאוֹת.<verse eid="MAL 3:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="MAL 3:13" />פֿאַרשײַט זײַנען אײַערע רײד קעגן מיר,</para>
  <para style="q" vid="MAL 3:13">זאָגט ה׳. און איר זאָגט:</para>
  <para style="q" vid="MAL 3:13">װאָס האָבן מיר גערעדט אַקעגן דיר?<verse eid="MAL 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="MAL 3:14" />איר האָט געזאָגט: אומזיסט איז דינען אלֹקים,</para>
  <para style="q" vid="MAL 3:14">און װאָס קומט אַרױס אַז מיר האָבן געהיט זײַן היטונג,</para>
  <para style="q" vid="MAL 3:14">און אַז מיר זײַנען אומגעגאַנגען פֿינצטער</para>
  <para style="q" vid="MAL 3:14">פֿון װעגן ה׳ צבָֿאוֹת?<verse eid="MAL 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="MAL 3:15" />איז, אַצונד שאַצן מיר גליקלעך די מוטװיליקע;</para>
  <para style="q" vid="MAL 3:15">יאָ, אױפֿגעריכט געװאָרן זײַנען די װאָס טוען שלעכטס,</para>
  <para style="q" vid="MAL 3:15">יאָ, זײ האָבן געפּרוּװט אלֹקים, און זײַנען אַנטרונען געװאָרן.<verse eid="MAL 3:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="MAL 3:16" />דענס מאָל האָבן די פֿאָרכטיקע פֿון ה׳</para>
  <para style="q" vid="MAL 3:16">גערעדט אײנער צום אַנדערן,</para>
  <para style="q" vid="MAL 3:16">און ג-ט האָט פֿאַרנומען און צוגעהערט,</para>
  <para style="q" vid="MAL 3:16">און אַ בוך פֿון דערמאָנונג איז אָנגעשריבן געװאָרן בײַ אים,</para>
  <para style="q" vid="MAL 3:16">פֿאַר די װאָס פֿאָרכטן ה׳,</para>
  <para style="q" vid="MAL 3:16">און טראַכטן אָן זײַן נאָמען.<verse eid="MAL 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="MAL 3:17" />און זײ װעלן מיר זײַן אַ טײַער אײגנס,</para>
  <para style="q" vid="MAL 3:17">זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="MAL 3:17">אין דעם טאָג װאָס איך באַשער;</para>
  <para style="q" vid="MAL 3:17">און איך װעל זיך דערבאַרעמען אױף זײ,</para>
  <para style="q" vid="MAL 3:17">װי אַ מאַן דערבאַרעמט זיך אױף זײַן זון װאָס דינט אים.<verse eid="MAL 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="MAL 3:18" />און איר װעט װידער אײַנזען</para>
  <para style="q" vid="MAL 3:18">צװישן דעם צדיק און דעם רשע,</para>
  <para style="q" vid="MAL 3:18">צװישן דעם װאָס דינט אלֹקים,</para>
  <para style="q" vid="MAL 3:18">און דער װאָס דינט אים נישט.<verse eid="MAL 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" pubnumber="4.1" sid="MAL 3:19" /> װאָרעם זע, דער טאָג קומט,</para>
  <para style="q" vid="MAL 3:19">ער ברענט װי אַן אױװן,</para>
  <para style="q" vid="MAL 3:19">און אַלע מוטװיליקע און אַלע װאָס טוען שלעכטס</para>
  <para style="q" vid="MAL 3:19">װעלן זײַן שטרױ,</para>
  <para style="q" vid="MAL 3:19">און אָנצינדן װעט זײ דער טאָג װאָס קומט,</para>
  <para style="q" vid="MAL 3:19">זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="MAL 3:19">אַז ער װעט זײ נישט איבערלאָזן</para>
  <para style="q" vid="MAL 3:19">אַ װאָרצל אָדער אַ צװײַג.<verse eid="MAL 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" pubnumber="4.2" sid="MAL 3:20" /> אָבער אײַך, װאָס האָט מורא פֿאַר מײַן נאָמען,</para>
  <para style="q" vid="MAL 3:20">װעט אױפֿגײן די זון פֿון גערעכטיקײט</para>
  <para style="q" vid="MAL 3:20">מיט הײלונג אין אירע פֿליגלען;</para>
  <para style="q" vid="MAL 3:20">און איר װעט אַרױסגײן</para>
  <para style="q" vid="MAL 3:20">און װעט שפּרינגען װי קעלבער פֿון שטאַל.<verse eid="MAL 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" pubnumber="4.3" sid="MAL 3:21" /> און איר װעט צודריקן די רשעים,</para>
  <para style="q" vid="MAL 3:21">װאָרעם זײ װעלן זײַן אַש אונטער אײַערע פֿוסטריט</para>
  <para style="q" vid="MAL 3:21">אין דעם טאָג װאָס איך באַשער,</para>
  <para style="q" vid="MAL 3:21">זאָגט ה׳ צבָֿאוֹת.<verse eid="MAL 3:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" pubnumber="4.4" sid="MAL 3:22" /> געדענקט די תּורה פֿון מײַן קנעכט משהן,</para>
  <para style="q" vid="MAL 3:22">װאָס איך האָב אים באַפֿױלן אין חוֹרֵבֿ פֿאַר גאַנץ יִשׂרָאֵל,</para>
  <para style="q" vid="MAL 3:22">חוקים און געזעצן.<verse eid="MAL 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" pubnumber="4.5" sid="MAL 3:23" /> זעט, איך שיק צו אײַך אֵלִיָהו הנבֿיא,</para>
  <para style="q" vid="MAL 3:23">אײדער עס קומט דער טאָג פֿון ה׳,</para>
  <para style="q" vid="MAL 3:23">דער גרױסער און דער מוֹראדיקער.<verse eid="MAL 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" pubnumber="4.6" sid="MAL 3:24" /> און ער װעט אומקערן דאָס האַרץ פֿון די אָבֹות צו די קינדער,</para>
  <para style="q" vid="MAL 3:24">און דאָס האַרץ פֿון די קינדער צו זײערע אָבֹות,</para>
  <para style="q" vid="MAL 3:24">כּדי איך זאָל נישט קומען,</para>
  <para style="q" vid="MAL 3:24">און שלאָגן די ערד מיט אַ חרם.<verse eid="MAL 3:24" /></para>
  <chapter eid="MAL 3" />
  <chapter number="4" style="c" sid="MAL 4" />
  <chapter eid="MAL 4" />
</usx>