<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="AMO" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">עָמוֹס</para>
  <para style="toc2">עָמוֹס</para>
  <para style="toc1">עָמוֹס</para>
  <para style="mt1">עָמוֹס</para>
  <chapter number="1" style="c" pubnumber="א" sid="AMO 1" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 1:1" />די װערטער פֿון עָמוֹסן, װאָס איז געװען פֿון די שאָפֿלײַט פֿון תּקוֹעַ; װאָס ער האָט געזען אױף יִשׂרָאֵל אין די טעג פֿון עוּזִיָה דעם מלך פֿון יהוּדה, און אין די טעג פֿון יָרָבֿעָם דעם זון פֿון יוֹאָשן, דעם מלך פֿון יִשׂרָאֵל, צװײ יאָר פֿאַר דער ערדציטערניש.<verse eid="AMO 1:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 1:2" />און ער האָט געזאָגט:</para>
  <para style="b" vid="AMO 1:2" />
  <para style="q" vid="AMO 1:2">ה׳ װעט ברילן פֿון צִיוֹן,</para>
  <para style="q" vid="AMO 1:2">און פֿון ירושָלַיִם װעט ער אַרױסלאָזן זײַן קֹול,</para>
  <para style="q" vid="AMO 1:2">און די פֿיטערפּלעצער פֿון די פּאַסטוכער װעלן טרױערן,</para>
  <para style="q" vid="AMO 1:2">און דער שפּיץ כַּרמֶל װעט פֿאַרטריקנט װערן.<verse eid="AMO 1:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="AMO 1:3" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="b" vid="AMO 1:3" />
  <para style="q" vid="AMO 1:3">פֿאַר דרײַ פֿאַרברעכן פֿון דַמֶשֶׂק,</para>
  <para style="q" vid="AMO 1:3">יאָ, פֿאַר פֿיר, װעל איך עס נישט אָפּהאַלטן:</para>
  <para style="q" vid="AMO 1:3">פֿאַר זײער דרעשן גִלעָד מיט אײַזערנע דרעששליטנס.<verse eid="AMO 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 1:4" />און איך װעל שיקן אַ פֿײַער אױף דעם הױז פֿון חַזָאֵל,</para>
  <para style="q" vid="AMO 1:4">און עס װעט פֿאַרצערן די פּאַלאַצן פֿון בֶן-הַדַד.<verse eid="AMO 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 1:5" />און איך װעל צעברעכן דעם ריגל פֿון דַמֶשֶׂק,</para>
  <para style="q" vid="AMO 1:5">און װעל פֿאַרשנײַדן אַ באַװױנער פֿון בקעַת-אָוֶן,</para>
  <para style="q" vid="AMO 1:5">און דעם װאָס האַלט אַ צעפּטער פֿון בֵית-עֶדֶן;</para>
  <para style="q" vid="AMO 1:5">און דאָס פֿאָלק פֿון אַרָם װעט אין גלות גײן קײן קיר, זאָגט ה׳.<verse eid="AMO 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 1:6" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="b" vid="AMO 1:6" />
  <para style="q" vid="AMO 1:6">פֿאַר דרײַ פֿאַרברעכן פֿון עַזָה,</para>
  <para style="q" vid="AMO 1:6">יאָ, פֿאַר פֿיר, װעל איך עס נישט אָפּהאַלטן:</para>
  <para style="q" vid="AMO 1:6">פֿאַר זײער פֿאַרטרײַבן אַ גאַנצע געפֿאַנגענשאַפֿט,</para>
  <para style="q" vid="AMO 1:6">כּדי איבערצוענטפֿערן צו אֶדוֹם.<verse eid="AMO 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 1:7" />און איך װעל שיקן אַ פֿײַער אױף דער מױער פֿון עַזָה,</para>
  <para style="q" vid="AMO 1:7">און עס װעט פֿאַרצערן אירע פֿעסטונגען.<verse eid="AMO 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 1:8" />און איך װעל פֿאַרשנײַדן אַ באַװױנער פֿון אַשדוֹד,</para>
  <para style="q" vid="AMO 1:8">און דעם װאָס האַלט אַ צעפּטער פֿון אַשקלוֹן;</para>
  <para style="q" vid="AMO 1:8">און איך װעל קערן מײַן האַנט אױף עֶקרוֹן,</para>
  <para style="q" vid="AMO 1:8">און דער איבערבלײַב פֿון די פּלִשתּים װעט אונטערגײן,</para>
  <para style="q" vid="AMO 1:8">זאָגט אֲדֹנָי ה׳.<verse eid="AMO 1:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 1:9" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="b" vid="AMO 1:9" />
  <para style="q" vid="AMO 1:9">פֿאַר דרײַ פֿאַרברעכן פֿון צוֹר,</para>
  <para style="q" vid="AMO 1:9">יאָ, פֿאַר פֿיר, װעל איך עס נישט אָפּהאַלטן:</para>
  <para style="q" vid="AMO 1:9">פֿאַר װאָס זײ האָבן איבערגעענטפֿערט אַ גאַנצע געפֿאַנגענשאַפֿט צו אֶדוֹם,</para>
  <para style="q" vid="AMO 1:9">און נישט געדאַכט אָן דעם ברית פֿון ברידער.<verse eid="AMO 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 1:10" />און איך װעל שיקן אַ פֿײַער אױף דער מױער פֿון צוֹר,</para>
  <para style="q" vid="AMO 1:10">און עס װעט פֿאַרצערן אירע פּאַלאַצן.<verse eid="AMO 1:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 1:11" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="b" vid="AMO 1:11" />
  <para style="q" vid="AMO 1:11">פֿאַר דרײַ פֿאַרברעכן פֿון אֶדוֹם,</para>
  <para style="q" vid="AMO 1:11">יאָ, פֿאַר פֿיר, װעל איך עס נישט אָפּהאַלטן:</para>
  <para style="q" vid="AMO 1:11">פֿאַר װאָס ער האָט נאָכגעיאָגט זײַן ברודער מיטן שװערד,</para>
  <para style="q" vid="AMO 1:11">און דערשטיקט זײַן רחמנות,</para>
  <para style="q" vid="AMO 1:11">און זײַן כּעס האָט שטענדיק פֿאַרצוקט,</para>
  <para style="q" vid="AMO 1:11">און ער האָט אײביק געהאַלטן זײַן גרימצאָרן.<verse eid="AMO 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 1:12" />און איך װעל שיקן אַ פֿײַער אױף תֵּימָן,</para>
  <para style="q" vid="AMO 1:12">און עס װעט פֿאַרצערן די פּאַלאַצן פֿון בָצרָה.<verse eid="AMO 1:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="AMO 1:13" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="b" vid="AMO 1:13" />
  <para style="q" vid="AMO 1:13">פֿאַר דרײַ פֿאַרברעכן פֿון די קינדער פֿון עַמוֹן,</para>
  <para style="q" vid="AMO 1:13">יאָ, פֿאַר פֿיר, װעל איך עס נישט אָפּהאַלטן:</para>
  <para style="q" vid="AMO 1:13">פֿאַר זײער אױפֿשפּאַלטן די טראָגעדיקע פֿון גִלעָד,</para>
  <para style="q" vid="AMO 1:13">כּדי צו דערברײטערן זײער געמאַרק.<verse eid="AMO 1:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 1:14" />און איך װעל אָנצינדן אַ פֿײַער אױף דער מױער פֿון רַבָה,</para>
  <para style="q" vid="AMO 1:14">און עס װעט פֿאַרצערן אירע פּאַלאַצן,</para>
  <para style="q" vid="AMO 1:14">מיט שאַלונג אין טאָג פֿון מלחמה,</para>
  <para style="q" vid="AMO 1:14">מיט שטורעם אין טאָג פֿון געװיטער.<verse eid="AMO 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 1:15" />און זײער מלך װעט גײן אין גלות,</para>
  <para style="q" vid="AMO 1:15">ער און זײַנע האַרן אין אײנעם,</para>
  <para style="q" vid="AMO 1:15">זאָגט ה׳.<verse eid="AMO 1:15" /></para>
  <chapter eid="AMO 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="AMO 2" />
  <para style="q">
    <verse number="1" style="v" sid="AMO 2:1" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="b" vid="AMO 2:1" />
  <para style="q" vid="AMO 2:1">פֿאַר דרײַ פֿאַרברעכן פֿון מוֹאָבֿ,</para>
  <para style="q" vid="AMO 2:1">יאָ, פֿאַר פֿיר, װעל איך עס נישט אָפּהאַלטן:</para>
  <para style="q" vid="AMO 2:1">פֿאַר זײַן פֿאַרברענען די בײנער</para>
  <para style="q" vid="AMO 2:1">פֿון דעם מלך פֿון אֶדוֹם אױף קאַלך.<verse eid="AMO 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 2:2" />און איך װעל שיקן אַ פֿײַער אױף מוֹאָבֿ,</para>
  <para style="q" vid="AMO 2:2">און עס װעט פֿאַרצערן די פּאַלאַצן פֿון קריוֹת,</para>
  <para style="q" vid="AMO 2:2">און שטאַרבן מיט געטומל װעט מוֹאָבֿ,</para>
  <para style="q" vid="AMO 2:2">מיט שאַלונג און אַ קֹול פֿון שופֿר.<verse eid="AMO 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 2:3" />און איך װעל פֿאַרשנײַדן אַ ריכטער פֿון איר מיט,</para>
  <para style="q" vid="AMO 2:3">און אַלע אירע האַרן װעל איך הרגען מיט אים,</para>
  <para style="q" vid="AMO 2:3">זאָגט ה׳.<verse eid="AMO 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="AMO 2:4" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="b" vid="AMO 2:4" />
  <para style="q" vid="AMO 2:4">פֿאַר דרײַ פֿאַרברעכן פֿון יהוּדה,</para>
  <para style="q" vid="AMO 2:4">יאָ, פֿאַר פֿיר, װעל איך עס נישט אָפּהאַלטן:</para>
  <para style="q" vid="AMO 2:4">פֿאַר װאָס זײ האָבן פֿאַראַכט די תּורה פֿון ה׳,</para>
  <para style="q" vid="AMO 2:4">און זײַנע געזעצן נישט געהיט;</para>
  <para style="q" vid="AMO 2:4">און זײערע ליגנס האָבן זײ פֿאַרפֿירט,</para>
  <para style="q" vid="AMO 2:4">די װאָס זײערע עלטערן זײַנען נאָכגעגאַנגען נאָך זײ.<verse eid="AMO 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 2:5" />און איך װעל שיקן אַ פֿײַער אױף יהוּדה,</para>
  <para style="q" vid="AMO 2:5">און עס װעט פֿאַרצערן די פּאַלאַצן פֿון ירושָלַיִם.<verse eid="AMO 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 2:6" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="b" vid="AMO 2:6" />
  <para style="q" vid="AMO 2:6">פֿאַר דרײַ פֿאַרברעכן פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="AMO 2:6">יאָ, פֿאַר פֿיר, װעל איך עס נישט אָפּהאַלטן:</para>
  <para style="q" vid="AMO 2:6">פֿאַר זײער פֿאַרקױפֿן פֿאַר געלט דעם גערעכטן,</para>
  <para style="q" vid="AMO 2:6">און דעם אבֿיון פֿאַר אַ פּאָר שיך.<verse eid="AMO 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 2:7" />זײ, װאָס װילן צעטרעטן אױף דעם שטױב ערד</para>
  <para style="q" vid="AMO 2:7">אױפֿן קאָפּ פֿון די אָרימע,</para>
  <para style="q" vid="AMO 2:7">און דעם װעג פֿון די געדריקטע פֿאַרדרײען זײ;</para>
  <para style="q" vid="AMO 2:7">און אַ מאַן און זײַן פֿאָטער גײען צו אײן מײדל,</para>
  <para style="q" vid="AMO 2:7">כּדי צו פֿאַרשװעכן מײַן הײליקן נאָמען.<verse eid="AMO 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 2:8" />און אױף פֿאַרמשכּונטע קלײדער</para>
  <para style="q" vid="AMO 2:8">ציען זײ זיך אױס לעבן איטלעכן מזבח,</para>
  <para style="q" vid="AMO 2:8">און װײַן פֿון באַשטראָפֿטע</para>
  <para style="q" vid="AMO 2:8">טרינקען זײ אין הױז פֿון זײער ג-ט.<verse eid="AMO 2:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 2:9" />און איך האָב פֿאַרטיליקט פֿאַר זײ דעם אֶמוֹרי,</para>
  <para style="q" vid="AMO 2:9">װאָס װי די הײך פֿון צעדערן איז געװען זײַן הײך,</para>
  <para style="q" vid="AMO 2:9">און שטאַרק איז ער געװען װי אײכנבײמער;</para>
  <para style="q" vid="AMO 2:9">און איך האָב פֿאַרטיליקט זײַן פֿרוכט פֿון אױבן,</para>
  <para style="q" vid="AMO 2:9">און זײַנע װאָרצלען פֿון אונטן.<verse eid="AMO 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 2:10" />און איך האָב אײַך אױפֿגעבראַכט פֿון לאַנד מִצרַיִם,</para>
  <para style="q" vid="AMO 2:10">און אײַך געפֿירט אין דער מדבר פֿערציק יאָר,</para>
  <para style="q" vid="AMO 2:10">צו אַרבן דאָס לאַנד פֿון אֶמוֹרי.<verse eid="AMO 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 2:11" />און איך האָב אױפֿגעשטעלט פֿון אײַערע זין פֿאַר נבֿיאים,</para>
  <para style="q" vid="AMO 2:11">און פֿון אײַערע יונגעלײַט פֿאַר נזירים;</para>
  <para style="q" vid="AMO 2:11">צי איז דאָס נישט אַזױ, קינדער פֿון יִשׂרָאֵל?</para>
  <para style="q" vid="AMO 2:11">זאָגט ה׳.<verse eid="AMO 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 2:12" />אָבער איר האָט געמאַכט טרינקען די נזירים װײַן,</para>
  <para style="q" vid="AMO 2:12">און די נבֿיאים האָט איר באַפֿױלן אַזױ צו זאָגן:</para>
  <para style="q" vid="AMO 2:12">איר זאָלט נישט נבֿיאות זאָגן.<verse eid="AMO 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 2:13" />זעט, איך דריק אײַך אַרונטער</para>
  <para style="q" vid="AMO 2:13">װי עס דריקט דער װאָגן פֿול מיט גאַרבן.<verse eid="AMO 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 2:14" />און אַנטרינונג װעט פֿאַרלאָרן זײַן פֿון דעם פֿלינקן,</para>
  <para style="q" vid="AMO 2:14">און דער שטאַרקער װעט נישט אָנהאַלטן זײַן כּוֹח,</para>
  <para style="q" vid="AMO 2:14">און דער גיבור װעט נישט ראַטעװען זײַן נפֿש.<verse eid="AMO 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 2:15" />און דער בױגנהאַלטער װעט נישט באַשטײן,</para>
  <para style="q" vid="AMO 2:15">און דער פֿלינקער אױף זײַנע פֿיס װעט זיך נישט ראַטעװען,</para>
  <para style="q" vid="AMO 2:15">און דער רײַטער אױף אַ פֿערד װעט נישט ראַטעװען זײַן נפֿש.<verse eid="AMO 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="AMO 2:16" />און דער שטאַרקהאַרציקער צװישן די גיבוֹרים</para>
  <para style="q" vid="AMO 2:16">װעט אַ נאַקעטער אַנטלױפֿן אין יענעם טאָג,</para>
  <para style="q" vid="AMO 2:16">זאָגט ה׳.<verse eid="AMO 2:16" /></para>
  <chapter eid="AMO 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="AMO 3" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 3:1" />הערט דאָס דאָזיקע װאָרט װאָס ה׳ האָט גערעדט אױף אײַך, קינדער פֿון יִשׂרָאֵל – אױף דער גאַנצער משפּחה װאָס איך האָב אױפֿגעבראַכט פֿון לאַנד מִצרַיִם, אַזױ צו זאָגן:<verse eid="AMO 3:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="AMO 3:2" />נאָר אײַך האָב איך דערקענט פֿון אַלע משפּחות פֿון דער ערד,</para>
  <para style="q" vid="AMO 3:2">דערום װעל איך זיך רעכענען מיט אײַך פֿאַר אַלע אײַערע זינד.<verse eid="AMO 3:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="AMO 3:3" />גײען צװײ באַנאַנדער,</para>
  <para style="q" vid="AMO 3:3">אַחוץ אַז זײ האָבן אָפּגערעדט?<verse eid="AMO 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 3:4" />ברילט אַ לײב אין װאַלד, װוּ ער האָט נישט קײן רױב?</para>
  <para style="q" vid="AMO 3:4">לאָזט אַ יונגלײב אַרױס זײַן קֹול פֿון זײַן נאָרע,</para>
  <para style="q" vid="AMO 3:4">אַחוץ אַז ער האָט עפּעס געכאַפּט?<verse eid="AMO 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 3:5" />פֿאַלט אַ פֿױגל אין פּאַסטקע אױף דער ערד,</para>
  <para style="q" vid="AMO 3:5">װוּ זי האָט נישט קײן שטרױכלונג?</para>
  <para style="q" vid="AMO 3:5">שפּרינגט-אױף אַ פּאַסטקע פֿון דער ערד,</para>
  <para style="q" vid="AMO 3:5">װוּ כאַפּן זאָל זי נישט האָבן געכאַפּט?<verse eid="AMO 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 3:6" />צי װערט אַ שופֿר געבלאָזן אין שטאָט,</para>
  <para style="q" vid="AMO 3:6">און דאָס פֿאָלק זאָל נישט ציטערן?</para>
  <para style="q" vid="AMO 3:6">צי געשעט אַן אומגליק אין שטאָט,</para>
  <para style="q" vid="AMO 3:6">װוּ ה׳ האָט דאָס נישט געטאָן?<verse eid="AMO 3:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="AMO 3:7" />פֿאַר װאָר, אֲדֹנָי ה׳ טוט נישט קײן זאַך,</para>
  <para style="q" vid="AMO 3:7">סײַדן ער האָט אַנטפּלעקט זײַן סָוד</para>
  <para style="q" vid="AMO 3:7">צו זײַנע קנעכט די נבֿיאים.<verse eid="AMO 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 3:8" />אַ לײב האָט געברילט,</para>
  <para style="q" vid="AMO 3:8">װער זאָל נישט מורא האָבן?</para>
  <para style="q" vid="AMO 3:8">אֲדֹנָי ה׳ האָט גערעדט,</para>
  <para style="q" vid="AMO 3:8">װער קען נישט נבֿיאות זאָגן?<verse eid="AMO 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 3:9" />מאַכט הערן אױף די פּאַלאַצן אין אַשדוֹד,</para>
  <para style="q" vid="AMO 3:9">און אױף די פּאַלאַצן אין לאַנד מִצרַיִם,</para>
  <para style="q" vid="AMO 3:9">און זאָגט: זאַמלט אײַך אײַן אױף די בערג פֿון שוֹמרוֹן,</para>
  <para style="q" vid="AMO 3:9">און זעט די גרױסע מהומות דערין,</para>
  <para style="q" vid="AMO 3:9">און די דריקונגען אין איר מיט.<verse eid="AMO 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 3:10" />װאָרעם זײ װײסן נישט צו טאָן רעכט, זאָגט ה׳,</para>
  <para style="q" vid="AMO 3:10">זײ װאָס זאַמלען גזלה און רױב אין זײערע פּאַלאַצן.<verse eid="AMO 3:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 3:11" />דערום האָט אֲדֹנָי ה׳ אַזױ געזאָגט:</para>
  <para style="q" vid="AMO 3:11">אַ פֿײַנט, און רונד אַרום לאַנד!</para>
  <para style="q" vid="AMO 3:11">און ער װעט נידערן פֿון דיר דײַן שטאַרקײט,</para>
  <para style="q" vid="AMO 3:11">און דײַנע פּאַלאַצן װעלן צערױבט װערן.<verse eid="AMO 3:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="AMO 3:12" />אַזױ האָט ה׳ געזאָגט: אַזױ װי אַ פּאַסטוך איז מציל פֿון דעם לײבס מױל אַ פּאָר קני, אָדער אַ לעפּל פֿון אַן אױער, אַזױ װעלן די קינדער פֿון יִשׂרָאֵל, װאָס זיצן אין שוֹמרוֹן, זיך מציל זײַן מיט אַ װינקל פֿון אַ שלאָפֿבאַנק, און מיט אַ פֿוס פֿון אַ בעט.<verse eid="AMO 3:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="AMO 3:13" />הערט און װאָרנט דעם הױז פֿון יעקבֿ,</para>
  <para style="q" vid="AMO 3:13">זאָג אֲדֹנָי ה׳, אלוקי צבָֿאוֹת.<verse eid="AMO 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 3:14" />װאָרעם אין דעם טאָג װאָס איך רעכן זיך</para>
  <para style="q" vid="AMO 3:14">פֿאַר די פֿאַרברעכן פֿון יִשׂרָאֵל מיט אים,</para>
  <para style="q" vid="AMO 3:14">װעל איך זיך רעכענען פֿאַר די מזבחות פֿון בֵית-אֵל,</para>
  <para style="q" vid="AMO 3:14">און די הערנער פֿון מזבח װעלן אָפּגעהאַקט װערן,</para>
  <para style="q" vid="AMO 3:14">און װעלן אַנידערפֿאַלן צו דער ערד.<verse eid="AMO 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 3:15" />און איך װעל שלאָגן דאָס װינטערהױז מיט דעם זומערהױז,</para>
  <para style="q" vid="AMO 3:15">און די הײַזער פֿון עלפֿנבײן װעלן אונטערגײן,</para>
  <para style="q" vid="AMO 3:15">און די גרױסע הײַזער װעלן פֿאַרלענדט װערן,</para>
  <para style="q" vid="AMO 3:15">זאָגט ה׳.<verse eid="AMO 3:15" /></para>
  <chapter eid="AMO 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="AMO 4" />
  <para style="q">
    <verse number="1" style="v" sid="AMO 4:1" />הערט דאָס דאָזיקע װאָרט, איר בָשָן-קי</para>
  <para style="q" vid="AMO 4:1">װאָס אױפֿן באַרג שוֹמרוֹן, די װאָס באַרױבן די אָרימע,</para>
  <para style="q" vid="AMO 4:1">װאָס דריקן די אבֿיוֹנים, װאָס זאָגן צו זײערע האַרן:</para>
  <para style="q" vid="AMO 4:1">ברענג מיר זאָלן טרינקען.<verse eid="AMO 4:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 4:2" />אֲדֹנָי ה׳ האָט געשװאָרן בײַ זײַן הײליקײט, אַז,</para>
  <para style="q" vid="AMO 4:2">זע, טעג קומען אױף אײַך,</para>
  <para style="q" vid="AMO 4:2">און מע װעט אײַך אַװעקנעמען מיט האָקן,</para>
  <para style="q" vid="AMO 4:2">און אײַער איבערבלײַב מיט פֿישערשטאַנגען.<verse eid="AMO 4:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 4:3" />און דורך מױערבראָכן װעט איר אַרױסגײן,</para>
  <para style="q" vid="AMO 4:3">איטלעכע אַקעגן זיך,</para>
  <para style="q" vid="AMO 4:3">און איר װעט פֿאַרװאָרפֿן געװאָרן אױף די בערג חֶרמוֹן,</para>
  <para style="q" vid="AMO 4:3">זאָגט ה׳.<verse eid="AMO 4:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="AMO 4:4" />קומט קײן בֵית-אֵל און פֿאַרברעכט,</para>
  <para style="q" vid="AMO 4:4">קײן גִלגָל, און מערט פֿאַרברעכן,</para>
  <para style="q" vid="AMO 4:4">און ברענגט צום פֿרימאָרגן אײַערע שלאַכטאָפּפֿער,</para>
  <para style="q" vid="AMO 4:4">אױפֿן דריטן טאָג אײַערע מעשׂרס;<verse eid="AMO 4:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 4:5" />און איר זענט מקריבֿ אַ דאַנקאָפּפֿער מיט חמץ,</para>
  <para style="q" vid="AMO 4:5">און רופֿט אױס פֿרײַװיליקע גאָבן, מאַכט הערן,</para>
  <para style="q" vid="AMO 4:5">װאָרעם אַזױ האָט איר ליב, איר קינדער פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="AMO 4:5">זאָגט אֲדֹנָי ה׳.<verse eid="AMO 4:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 4:6" />און איך אױך האָב אײַך געגעבן</para>
  <para style="q" vid="AMO 4:6">לײדיקע צײן אין אַלע אײַערע שטעט,</para>
  <para style="q" vid="AMO 4:6">און איר האָט זיך נישט אומגעקערט צו מיר,</para>
  <para style="q" vid="AMO 4:6">זאָגט ה׳.<verse eid="AMO 4:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="AMO 4:7" />און איך האָב אױך פֿאַרמיטן פֿון אײַך דעם רעגן,</para>
  <para style="q" vid="AMO 4:7">װען נאָך דרײַ חדשים צום שניט,</para>
  <para style="q" vid="AMO 4:7">און איך האָב געלאָזט רעגענען אױף אײן שטאָט,</para>
  <para style="q" vid="AMO 4:7">און אױף אײן שטאָט פֿלעג איך נישט לאָזן רעגענען;</para>
  <para style="q" vid="AMO 4:7">אײן שטיק פֿלעגט באַרעגנט װערן,</para>
  <para style="q" vid="AMO 4:7">און דאָס שטיק װאָס דערױף פֿלעגט נישט רעגענען, פֿלעגט פֿאַרטריקנט װערן.<verse eid="AMO 4:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 4:8" />און צװײ דרײַ שטעט האָבן געװאַנדערט צו אײן שטאָט,</para>
  <para style="q" vid="AMO 4:8">צו טרינקען װאַסער, און פֿלעגן נישט קריגן צו זאַט,</para>
  <para style="q" vid="AMO 4:8">און איר האָט זיך נישט אומגעקערט צו מיר,</para>
  <para style="q" vid="AMO 4:8">זאָגט ה׳.<verse eid="AMO 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 4:9" />איך האָב אײַך געפּלאָגט מיט קאָרנבראַנד און מיט װעלקעניש;</para>
  <para style="q" vid="AMO 4:9">די מערסטע פֿון אײַערע גערטנער און אײַערע װײַנגערטנער</para>
  <para style="q" vid="AMO 4:9">און אײַערע פֿײַגנבײמער און אײַערע אײלבערטבײמער</para>
  <para style="q" vid="AMO 4:9">עסט דער הײשעריק אױף,</para>
  <para style="q" vid="AMO 4:9">און איר האָט זיך נישט אומגעקערט צו מיר,</para>
  <para style="q" vid="AMO 4:9">זאָגט ה׳.<verse eid="AMO 4:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="AMO 4:10" />איך האָב אָנגעשיקט אױף אײַך אַ פּעסט, אױפֿן שטײגער פֿון מִצרַיִם,</para>
  <para style="q" vid="AMO 4:10">איך האָב געהרגעט מיטן שװערד אײַערע יונגעלײַט,</para>
  <para style="q" vid="AMO 4:10">דערצו געפֿאַנגענשאַפֿט פֿון אײַערע פֿערד.</para>
  <para style="q" vid="AMO 4:10">און איך האָב געלאָזט אױפֿגײן דעם געשטאַנק</para>
  <para style="q" vid="AMO 4:10">פֿון אײַערע מחנות אין אײַער נאָז,</para>
  <para style="q" vid="AMO 4:10">און איר האָט זיך נישט אומגעקערט צו מיר,</para>
  <para style="q" vid="AMO 4:10">זאָגט ה׳.<verse eid="AMO 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 4:11" />איך האָב איבערגעקערט צװישן אײַך,</para>
  <para style="q" vid="AMO 4:11">אַזױ װי ג-טס איבערקערעניש פֿון סדוֹם און עַמוֹרָה,</para>
  <para style="q" vid="AMO 4:11">און איר זײַט געבליבן װי אַ שײַט אַרױסגעריסן פֿון אַ שׂרפֿה,</para>
  <para style="q" vid="AMO 4:11">און איר האָט זיך נישט אומגעקערט צו מיר,</para>
  <para style="q" vid="AMO 4:11">זאָגט ה׳.<verse eid="AMO 4:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="AMO 4:12" />דערום װעל איך אַזױ טאָן צו דיר, יִשׂרָאֵל: –</para>
  <para style="q" vid="AMO 4:12">װײַל איך װעל דאָס דאָזיקע טאָן צו דיר,</para>
  <para style="q" vid="AMO 4:12">ברײט זיך אָן אַנטקעגן דײַן ג-ט, יִשׂרָאֵל.<verse eid="AMO 4:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 4:13" />װאָרעם זע, ער פֿורעמט די בערג, און באַשאַפֿט דעם װינט,</para>
  <para style="q" vid="AMO 4:13">און ער זאָגט דעם מענטשן װאָס זײַן טראַכטונג איז;</para>
  <para style="q" vid="AMO 4:13">ער מאַכט פֿון פֿרימאָרגן פֿינצטערניש,</para>
  <para style="q" vid="AMO 4:13">און ער טרעט אױף די הײכן פֿון דער ערד;</para>
  <para style="q" vid="AMO 4:13">ה׳ אלוקי צבָֿאוֹת איז זײַן נאָמען.<verse eid="AMO 4:13" /></para>
  <chapter eid="AMO 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="AMO 5" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 5:1" />הערט דאָס דאָזיקע װאָרט װאָס איך הײב אױף פֿאַר אַ קלאָגליד אױף אײַך, איר הױז פֿון יִשׂרָאֵל:<verse eid="AMO 5:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="AMO 5:2" />געפֿאַלן נישט מער אױפֿצושטײן</para>
  <para style="q" vid="AMO 5:2">איז די יונגפֿרױ יִשׂרָאֵל.</para>
  <para style="q" vid="AMO 5:2">זי ליגט אַנידערגעװאָרפֿן אױף איר ערד,</para>
  <para style="q" vid="AMO 5:2">נישטאָ װער זאָל זי אױפֿשטעלן.<verse eid="AMO 5:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="AMO 5:3" />װאָרעם אַזױ האָט געזאָגט אֲדֹנָי ה׳:</para>
  <para style="q" vid="AMO 5:3">די שטאָט װאָס פֿלעגט אַרױס מיט טױזנט,</para>
  <para style="q" vid="AMO 5:3">װעט בלײַבן בײַ הונדערט,</para>
  <para style="q" vid="AMO 5:3">און די װאָס פֿלעגט אַרױס מיט הונדערט,</para>
  <para style="q" vid="AMO 5:3">װעט בלײַבן בײַ צען, פֿון דעם הױז פֿון יִשׂרָאֵל.<verse eid="AMO 5:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="AMO 5:4" />װאָרעם אַזױ האָט ה׳ געזאָגט צום הױז פֿון יִשׂרָאֵל:</para>
  <para style="q" vid="AMO 5:4">זוכט מיך, און לעבט;<verse eid="AMO 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 5:5" />און איר זאָלט נישט זוכן בֵית-אֵל,</para>
  <para style="q" vid="AMO 5:5">און קײן גִלגָל זאָלט איר נישט קומען,</para>
  <para style="q" vid="AMO 5:5">און קײן באֵר-שֶבַֿע זאָלט איר נישט אַריבערגײן;</para>
  <para style="q" vid="AMO 5:5">װאָרעם גִלגָל װעט אין גלות גײן,</para>
  <para style="q" vid="AMO 5:5">און בֵית-אֵל װעט צו נישט װערן.<verse eid="AMO 5:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="AMO 5:6" />זוכט ה׳, און לעבט;</para>
  <para style="q" vid="AMO 5:6">כּדי ער זאָל נישט אױסברעכן װי אַ פֿײַער אין הױז פֿון יוֹסף,</para>
  <para style="q" vid="AMO 5:6">און עס װעט פֿאַרצערן, אַז קײן לעשער װעט נישט זײַן פֿאַר בֵית-אֵל;<verse eid="AMO 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 5:7" />די װאָס פֿאַרקערן גערעכטיקײט אין װערמוט,</para>
  <para style="q" vid="AMO 5:7">און רעכטפֿאַרטיקײט לײגן זײ צו דער ערד.<verse eid="AMO 5:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="AMO 5:8" />דעם װאָס מאַכט דעם זיבנשטערן און דעם אָריאָנשטערן,</para>
  <para style="q" vid="AMO 5:8">און פֿאַרקערט טױטשאָטן אין פֿרימאָרגן,</para>
  <para style="q" vid="AMO 5:8">און פֿאַרפֿינצטערט טאָג אין נאַכט;</para>
  <para style="q" vid="AMO 5:8">דעם װאָס רופֿט די װאַסערן פֿון ים,</para>
  <para style="q" vid="AMO 5:8">און גיסט זײ אױס אױפֿן געזיכט פֿון דער ערד,</para>
  <para style="q" vid="AMO 5:8">ה׳ איז זײַן נאָמען;<verse eid="AMO 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 5:9" />דעם װאָס בליצט אַרױס אַ בראָך אױפֿן שטאַרקן,</para>
  <para style="q" vid="AMO 5:9">און אַ בראָך קומט אױף דער פֿעסטונג.<verse eid="AMO 5:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="AMO 5:10" />זײ האָבן פֿײַנט דעם װאָס מוסרט אין טױער,</para>
  <para style="q" vid="AMO 5:10">און דעם װאָס רעדט ערלעך פֿאַראומװערדיקן זײ.<verse eid="AMO 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="AMO 5:11" />דערום, װײַל איר טרעט אױפֿן אָרעמאַן,</para>
  <para style="q" vid="AMO 5:11">און אָפּגאָב פֿון תּבֿואה נעמט איר פֿון אים,</para>
  <para style="q" vid="AMO 5:11">האָט איר הײַזער פֿון געהאַקטע שטײנער געבױט,</para>
  <para style="q" vid="AMO 5:11">און װעט אין זײ נישט װױנען;</para>
  <para style="q" vid="AMO 5:11">האָט איר גלוסטיקע װײַנגערטנער געפֿלאַנצט,</para>
  <para style="q" vid="AMO 5:11">און װעט נישט טרינקען זײער װײַן.<verse eid="AMO 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 5:12" />װאָרעם איך װײס, אײַערע פֿאַרברעכן זײַנען פֿיל,</para>
  <para style="q" vid="AMO 5:12">און שטאַרק אײַערע זינד,</para>
  <para style="q" vid="AMO 5:12">איר, װאָס דריקט דעם גערעכטן, װאָס נעמט שוחד,</para>
  <para style="q" vid="AMO 5:12">און קריװדעט די אבֿיוֹנים אין טױער.<verse eid="AMO 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 5:13" />דערום שװײַגט דער פֿאַרשטאַנדיקער אין אַזאַ צײַט,</para>
  <para style="q" vid="AMO 5:13">װאָרעם אַ בײזע צײַט איז דאָס.<verse eid="AMO 5:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="AMO 5:14" />זוכט גוטס און נישט שלעכטס,</para>
  <para style="q" vid="AMO 5:14">כּדי איר זאָלט לעבן,</para>
  <para style="q" vid="AMO 5:14">און ה׳, אלוקי צבָֿאוֹת, װעט זײַן מיט אײַך,</para>
  <para style="q" vid="AMO 5:14">אַזױ װי איר פֿאַרלאַנגט.<verse eid="AMO 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 5:15" />האָט פֿײַנט שלעכטס, און האָט ליב גוטס,</para>
  <para style="q" vid="AMO 5:15">און שטעלט אױף אין טױער גערעכטיקײט,</para>
  <para style="q" vid="AMO 5:15">אפֿשר װעט ה׳, אלוקי צבָֿאוֹת,</para>
  <para style="q" vid="AMO 5:15">לײַטזעליקן דעם איבערבלײַב פֿון יוֹסף.<verse eid="AMO 5:15" /></para>
  <para style="b" />
  <para style="m">
    <verse number="16" style="v" sid="AMO 5:16" />פֿאַר װאָר, אַזױ האָט געזאָגט ה׳, אלוקי צבָֿאוֹת, אֲדֹנָי:</para>
  <para style="b" vid="AMO 5:16" />
  <para style="q" vid="AMO 5:16">אין אַלע מערק װעט זײַן אַ קלאָג,</para>
  <para style="q" vid="AMO 5:16">און אין אַלע גאַסן װעט מען זאָגן: אָי! אָי!</para>
  <para style="q" vid="AMO 5:16">און מע װעט רופֿן דעם אַקערמאַן צו טרױער,</para>
  <para style="q" vid="AMO 5:16">און צו קלאָג די געניטע אין יאָמערן.<verse eid="AMO 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="AMO 5:17" />און אין אַלע װײַנגערטנער װעט זײַן אַ קלאָג,</para>
  <para style="q" vid="AMO 5:17">אַז איך װעל דורכגײן צװישן דיר, זאָגט ה׳.<verse eid="AMO 5:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="AMO 5:18" />װײ, די װאָס באַגערן דעם טאָג פֿון ה׳!</para>
  <para style="q" vid="AMO 5:18">צו װאָס טױג אײַך דען דער טאָג פֿון ה׳?</para>
  <para style="q" vid="AMO 5:18">ער איז פֿינצטער און נישט ליכטיק.<verse eid="AMO 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="AMO 5:19" />אַזױ װי װען אַ מענטש אַנטלױפֿט פֿון אַ לײב,</para>
  <para style="q" vid="AMO 5:19">און אים באַגעגענט אַ בער,</para>
  <para style="q" vid="AMO 5:19">און ער קומט אין הױז,</para>
  <para style="q" vid="AMO 5:19">און לענט זײַן האַנט אָן דער װאַנט,</para>
  <para style="q" vid="AMO 5:19">און אַ שלאַנג בײַסט אים אײַן.<verse eid="AMO 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="AMO 5:20" />פֿאַר װאָר, חוֹשך איז דער טאָג פֿון ה׳, און נישט ליכטיק,</para>
  <para style="q" vid="AMO 5:20">און פֿינצטער און אָן אַ שימער אין אים.<verse eid="AMO 5:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="AMO 5:21" />איך האָב פֿײַנט, איך פֿאַראַכט אײַערע יוֹם-טובֿים,</para>
  <para style="q" vid="AMO 5:21">און איך קען נישט שמעקן אײַערע אײַנזאַמלונגען.<verse eid="AMO 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="AMO 5:22" />אַפֿילו אַז איר ברענגט מיר אױף בראַנדאָפּפֿער</para>
  <para style="q" vid="AMO 5:22">און אײַערע שפּײַזאָפּפֿער, באַװיליק איך נישט,</para>
  <para style="q" vid="AMO 5:22">און אײַערע געשטאָפּטע פֿרידאָפּפֿער קוק איך נישט אָן.<verse eid="AMO 5:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="AMO 5:23" />טו אָפּ פֿון מיר די ברומונג פֿון דײַנע געזאַנגען,</para>
  <para style="q" vid="AMO 5:23">און דאָס שפּיל פֿון דײַנע גיטאַרן לאָמיך נישט הערן.<verse eid="AMO 5:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="AMO 5:24" />נאָר לאָז קװעלן װי װאַסער גערעכטיקײט,</para>
  <para style="q" vid="AMO 5:24">און רעכטפֿאַרטיקײט װי אַ שטראָם אַ שטאַרקער.<verse eid="AMO 5:24" /></para>
  <para style="b" />
  <para style="p">
    <verse number="25" style="v" sid="AMO 5:25" />האָט איר מיר שלאַכטאָפּפֿער און שפּײַזאָפּפֿער געבראַכט אין דער מדבר, פֿאַר די פֿערציק יאָר, איר הױז פֿון יִשׂרָאֵל? <verse eid="AMO 5:25" /><verse number="26" style="v" sid="AMO 5:26" />דערום װעט איר טראָגן סִכּות אײַער קיניג, און כִּיאָן, אײַערע געצנבילדער, אײַער שטערנג‑ט װאָס איר האָט אײַך געמאַכט. <verse eid="AMO 5:26" /><verse number="27" style="v" sid="AMO 5:27" />און איך װעל אײַך פֿאַרטרײַבן פֿון יענער זײַט דַמֶשֶׂק, זאָגט ה׳ – אלוקי צבָֿאוֹת איז זײַן נאָמען.<verse eid="AMO 5:27" /></para>
  <chapter eid="AMO 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="AMO 6" />
  <para style="q">
    <verse number="1" style="v" sid="AMO 6:1" />װײ, די רואיקע אין צִיוֹן,</para>
  <para style="q" vid="AMO 6:1">און די זיכערע אױפֿן באַרג שוֹמרוֹן,</para>
  <para style="q" vid="AMO 6:1">די באַרופֿענע פּער פֿון די פֿעלקער,</para>
  <para style="q" vid="AMO 6:1">װאָס צו זײ קומט דאָס הױז פֿון יִשׂרָאֵל!<verse eid="AMO 6:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="AMO 6:2" />גײט אַריבער קײן כַּלנֵה, און זעט,</para>
  <para style="q" vid="AMO 6:2">און גײט פֿון דאָרט קײן גרױס חַמָת,</para>
  <para style="q" vid="AMO 6:2">און נידערט אין גַת פֿון די פּלִשתּים;</para>
  <para style="q" vid="AMO 6:2">איז זײ בעסער פֿון די דאָזיקע קיניגרײַכן?</para>
  <para style="q" vid="AMO 6:2">צי איז זײער געמאַרק גרעסער פֿון אײַער געמאַרק?<verse eid="AMO 6:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 6:3" />איר װאָס שטױסט אָפּ דעם בײזן טאָג,</para>
  <para style="q" vid="AMO 6:3">און רוקט צו דעם טראָן פֿון רױב!<verse eid="AMO 6:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 6:4" />די װאָס ליגן אױף בעטן פֿון עלפֿנבײן,</para>
  <para style="q" vid="AMO 6:4">און אױסגעצױגן אױף זײערע געלעגערס,</para>
  <para style="q" vid="AMO 6:4">און עסן לעמער פֿון די שאָף,</para>
  <para style="q" vid="AMO 6:4">און קעלבער פֿון שטאַל;<verse eid="AMO 6:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 6:5" />די װאָס צימבלען אױף דער גיטאַר –</para>
  <para style="q" vid="AMO 6:5">אַזױ װי דָוִד האָבן זײ זיך אױסגעטראַכט כּלֵי-זֶמֶר;<verse eid="AMO 6:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 6:6" />די װאָס טרינקען אין שפּרענגבעקנס װײַן,</para>
  <para style="q" vid="AMO 6:6">און מיט די בעסטע אײַלן זאַלבן זײ זיך,</para>
  <para style="q" vid="AMO 6:6">און קימערן זיך נישט אום דעם בראָך פֿון יוֹסף.<verse eid="AMO 6:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="AMO 6:7" />דערום װעלן זײ אַצונד פֿאַרטריבן װערן</para>
  <para style="q" vid="AMO 6:7">פֿאַרױס פֿון אַלע פֿאַרטריבענע,</para>
  <para style="q" vid="AMO 6:7">און אָפּגעטאָן װעט װערן דער ליאַרעם פֿון די אױסגעצױגענע.<verse eid="AMO 6:7" /></para>
  <para style="b" />
  <para style="m">
    <verse number="8" style="v" sid="AMO 6:8" />אֲדֹנָי ה׳ האָט געשװאָרן בײַ זיך אַלײן, זאָגט ה׳ אלוקי צבָֿאוֹת:</para>
  <para style="b" vid="AMO 6:8" />
  <para style="q" vid="AMO 6:8">איך פֿאַראומװערדיק דעם שטאָלץ פֿון יעקבֿ,</para>
  <para style="q" vid="AMO 6:8">און זײַנע פּאַלאַצן האָב איך פֿײַנט געקראָגן.</para>
  <para style="q" vid="AMO 6:8">און איך װעל איבערענטפֿערן די שטאָט מיט איר פֿולקײט!<verse eid="AMO 6:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="AMO 6:9" />און עס װעט זײַן, אױב עס װעלן איבערבלײַבן צען מענטשן אין אײן הױז, װעלן זײ שטאַרבן. <verse eid="AMO 6:9" /><verse number="10" style="v" sid="AMO 6:10" />און אַז עמיצנס פֿעטער, און דער װאָס דאַרף אים פֿאַרברענען, װעט אים אױפֿהײבן כּדי אַרױסצוטראָגן דאָס געבײן פֿון הױז, װעט ער זאָגן צו דעם װאָס אין װינקל פֿון הױז: איז נאָך װער דאָ מיט דיר? און אַז יענער װעט זאָגן: נײַן, נישטאָ; און ער װעט זאָגן: שאַ! װאָרעם מע טאָר נישט דאַכטן, בײַם נאָמען פֿון ה׳.<verse eid="AMO 6:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 6:11" />װאָרעם זע, ה׳ באַפֿעלט,</para>
  <para style="q" vid="AMO 6:11">און מע װעט צעהאַקן דאָס גרױסע הױז אין שטיקער,</para>
  <para style="q" vid="AMO 6:11">און דאָס קלײנע הױז אױף שפּענדלעך.<verse eid="AMO 6:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 6:12" />לױפֿן דען פֿערד איבער אַ פֿעלדז!</para>
  <para style="q" vid="AMO 6:12">צי אַקערט מען אים מיט רינדער?</para>
  <para style="q" vid="AMO 6:12">װאָס איר האָט פֿאַרקערט גערעכטיקײט אין ביטערקרױט,</para>
  <para style="q" vid="AMO 6:12">און פֿרוכט פֿון רעכטפֿאַריקײט אין װערמוט;<verse eid="AMO 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="AMO 6:13" />איר װאָס פֿרײט זיך אום גאָרנישט,</para>
  <para style="q" vid="AMO 6:13">װאָס זאָגט: פֿאַר װאָר, מיט אונדזער שטאַרקײט</para>
  <para style="q" vid="AMO 6:13">האָבן מיר זיך גענומען קַרְנַיִם.<verse eid="AMO 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 6:14" />פֿאַר װאָר, זע, איך שטעל אָן אױף אײַך אַ פֿאָלק,</para>
  <para style="q" vid="AMO 6:14">איר הױז פֿון יִשׂרָאֵל, זאָגט ה׳, אלוקי צבָֿאוֹת,</para>
  <para style="q" vid="AMO 6:14">און זײ װעלן אײַך דריקן פֿון װוּ מע קומט קײן חַמָת</para>
  <para style="q" vid="AMO 6:14">ביז דעם טײַך פֿון דעם פּלױן.<verse eid="AMO 6:14" /></para>
  <chapter eid="AMO 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="AMO 7" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 7:1" />אַזױ האָט מיר אֲדֹנָי ה׳ געװיזן: ערשט ער האָט באַשאַפֿן אַ הײשעריק אין אָנהײב אױפֿגײן פֿון דער שפּעט-תּבֿואה, און זע, דאָס איז געװען די שפּעט-תּבֿואה נאָך דעם מלכס שניט. <verse eid="AMO 7:1" /><verse number="2" style="v" sid="AMO 7:2" />און עס איז געװען, אַז ער האָט געענדיקט אױפֿעסן דאָס גראָז פֿון לאַנד, האָב איך געזאָגט:</para>
  <para style="b" vid="AMO 7:2" />
  <para style="q" vid="AMO 7:2">װי, ה׳ דו אֲדֹנָי, פֿאַרגיב, איך בעט דיך;</para>
  <para style="q" vid="AMO 7:2">װי קען באַשטײן יעקבֿ, אַז ער איז אַזױ קלײן?<verse eid="AMO 7:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 7:3" />האָט ה׳ חרטה געהאַט דערױף:</para>
  <para style="q" vid="AMO 7:3">דאָס װעט נישט געשען, האָט ה׳ געזאָגט.<verse eid="AMO 7:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="AMO 7:4" />אַזױ האָט מיר אֲדֹנָי ה׳ געװיזן: ערשט אֲדֹנָי ה׳ האָט אױסגערופֿן אַ קריג דורך פֿײַער, און עס האָט פֿאַרצערט דעם גרױסן תּהום, און װאָלט פֿאַרצערט דאָס לאַנד. <verse eid="AMO 7:4" /><verse number="5" style="v" sid="AMO 7:5" />האָב איך געזאָגט:</para>
  <para style="b" vid="AMO 7:5" />
  <para style="q" vid="AMO 7:5">ה׳ דו אֲדֹנָי, הער אױף, איך בעט דיך;</para>
  <para style="q" vid="AMO 7:5">װי קען באַשטײן יעקבֿ, אַז ער איז אַזױ קלײן?<verse eid="AMO 7:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 7:6" />האָט ה׳ חרטה געהאַט דערױף:</para>
  <para style="q" vid="AMO 7:6">דאָס אױך װעט נישט געשען, האָט אֲדֹנָי ה׳ געזאָגט.<verse eid="AMO 7:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="AMO 7:7" />אַזױ האָט ער מיר געװיזן: ערשט אֲדֹנָי שטײט אױף אַ שנורגלײַכער מױער, און אין זײַן האַנט איז אַ װאָגשנור. <verse eid="AMO 7:7" /><verse number="8" style="v" sid="AMO 7:8" />און ה׳ האָט צו מיר געזאָגט: װאָס זעסטו, עָמוֹס? האָב איך געזאָגט: אַ װאָגשנור. האָט אֲדֹנָי געזאָגט:</para>
  <para style="b" vid="AMO 7:8" />
  <para style="q" vid="AMO 7:8">זע, איך צי אַ װאָגשנור</para>
  <para style="q" vid="AMO 7:8">צװישן מײַן פֿאָלק יִשׂרָאֵל,</para>
  <para style="q" vid="AMO 7:8">איך װעל אים מער װידער נישט פֿאַרגעבן.<verse eid="AMO 7:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="AMO 7:9" />און די בָמות פֿון יצחק װעלן פֿאַרװיסט װערן,</para>
  <para style="q" vid="AMO 7:9">און די הײליקטומען פֿון יִשׂרָאֵל װעלן חרובֿ װערן,</para>
  <para style="q" vid="AMO 7:9">און איך װעל אױפֿשטײן אױפֿן הױז פֿון יָרָבֿעָם מיטן שװערד.<verse eid="AMO 7:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="AMO 7:10" />און אַמַציָה דער כּהן פֿון בֵית-אֵל האָט געשיקט צו יָרָבֿעָם דעם מלך פֿון יִשׂרָאֵל, אַזױ צו זאָגן: עָמוֹס האָט געמאַכט אַ בונט אױף דיר צװישן די קינדער פֿון יִשׂרָאֵל; דאָס לאַנד קען נישט אױסהאַלטן אַלע זײַנע רײד. <verse eid="AMO 7:10" /><verse number="11" style="v" sid="AMO 7:11" />װאָרעם עָמוֹס האָט אַזױ געזאָגט:</para>
  <para style="q" vid="AMO 7:11">דורכן שװערד װעט שטאַרבן יָרָבֿעָם,</para>
  <para style="q" vid="AMO 7:11">און יִשׂרָאֵל װעט אין גלות</para>
  <para style="q" vid="AMO 7:11">אַװעק פֿון זײַן ערד.<verse eid="AMO 7:11" /></para>
  <para style="b" />
  <para style="p">
    <verse number="12" style="v" sid="AMO 7:12" />און אַמַציָה האָט געזאָגט צו עָמוֹסן: זעער, גײ אַנטלױף דיר קײן לאַנד יהוּדה, און עס דאָרטן ברױט, און דאָרטן זאָלסטו נבֿיאות זאָגן. <verse eid="AMO 7:12" /><verse number="13" style="v" sid="AMO 7:13" />אָבער אין בֵית-אֵל זאָלסטו מער װידער נבֿיאות נישט זאָגן װאָרעם עס איז אַ מלכס הײליקטום, און עס איז אַ הױז פֿון מלוכה.<verse eid="AMO 7:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="AMO 7:14" />האָט געענטפֿערט עָמוֹס און האָט געזאָגט צו אַמַציָהן: נישט קײן נבֿיא בין איך, און נישט קײן זון פֿון אַ נבֿיא בין איך, נײַערט אַ פּאַסטוך פֿון רינדער בין איך, און אַ צוריכטער פֿון װילדע פֿײַגן. <verse eid="AMO 7:14" /><verse number="15" style="v" sid="AMO 7:15" />און ה׳ האָט מיך גענומען פֿון הינטער די שאָף, און ה׳ האָט צו מיר געזאָגט: גײ זאָג נבֿיאות צו מײַן פֿאָלק יִשׂרָאֵל. <verse eid="AMO 7:15" /><verse number="16" style="v" sid="AMO 7:16" />און אַצונד הער דאָס װאָרט פֿון ה׳:</para>
  <para style="p" vid="AMO 7:16">דו זאָגסט: זאָלסט נישט נבֿיאות זאָגן אױף יִשׂרָאֵל, און נישט דַרשען אױף דעם הױז פֿון יצחק.<verse eid="AMO 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="AMO 7:17" />דערום האָט ה׳ אַזױ געזאָגט:</para>
  <para style="b" vid="AMO 7:17" />
  <para style="q" vid="AMO 7:17">דײַן װײַב װעט אין שטאָט אַ זוֹנה זײַן,</para>
  <para style="q" vid="AMO 7:17">און דײַנע זין און דײַנע טעכטער װעלן פֿאַלן דורכן שװערד,</para>
  <para style="q" vid="AMO 7:17">און דײַן ערד װעט מיט אַ שנור צעטײלט װערן,</para>
  <para style="q" vid="AMO 7:17">און דו װעסט שטאַרבן אױף אומרײנער ערד,</para>
  <para style="q" vid="AMO 7:17">און יִשׂרָאֵל װעט אין גלות אַװעק פֿון זײַן ערד.<verse eid="AMO 7:17" /></para>
  <chapter eid="AMO 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="AMO 8" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 8:1" />אַזױ האָט מיר אֲדֹנָי ה׳ געװיזן: ערשט אַ קאָרב זומעראױבס. <verse eid="AMO 8:1" /><verse number="2" style="v" sid="AMO 8:2" />און ער האָט צו מיר געזאָגט: װאָס זעסטו, עָמוֹס? האָב איך געזאָגט: אַ קאָרב זומעראױבס. האָט ה׳ צו מיר געזאָגט:</para>
  <para style="b" vid="AMO 8:2" />
  <para style="q" vid="AMO 8:2">געקומען איז דער סוף אױף מײַן פֿאָלק יִשׂרָאֵל,</para>
  <para style="q" vid="AMO 8:2">איך װעל אים מער װידער נישט פֿאַרגעבן.<verse eid="AMO 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 8:3" />און יאָמערן װעלן די געזאַנגען פֿון פּאַלאַץ אין יענעם טאָג,</para>
  <para style="q" vid="AMO 8:3">זאָגט אֲדֹנָי ה׳;</para>
  <para style="q" vid="AMO 8:3">פּגרים װעלן זײַן פֿיל,</para>
  <para style="q" vid="AMO 8:3">אין יעטװעדער אָרט װעט זײַן אָנגעװאָרפֿן אַ שטילקײט.<verse eid="AMO 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 8:4" />הערט דאָס צו, איר װאָס װילט אײַנשלינגען דעם אבֿיון,</para>
  <para style="q" vid="AMO 8:4">און פֿאַרטיליקן די אָרימע פֿון לאַנד,<verse eid="AMO 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="AMO 8:5" />אַזױ צו זאָגן: װען װעט אַריבער ראָש-חודש,</para>
  <para style="q" vid="AMO 8:5">אַז מיר זאָלן פֿאַרקױפֿן תּבֿואה,</para>
  <para style="q" vid="AMO 8:5">און שבת, אַז מיר זאָלן עפֿענען קאָרן,</para>
  <para style="q" vid="AMO 8:5">צו פֿאַרקלענערן די אֵיפֿה, און צו פֿאַרגרעסערן דעם שֶקל,</para>
  <para style="q" vid="AMO 8:5">און צו פֿאַרדרײען מיט פֿאַלשע װאָגשאָלן;<verse eid="AMO 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 8:6" />כּדי צו קױפֿן פֿאַר געלט די אָרימע,</para>
  <para style="q" vid="AMO 8:6">און דעם אבֿיון פֿאַר אַ פּאָר שיך,</para>
  <para style="q" vid="AMO 8:6">און דעם אָפּפֿאַל פֿון קאָרן זאָלן מיר פֿאַרקױפֿן.<verse eid="AMO 8:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="AMO 8:7" />ה׳ האָט געשװאָרן בײַ דעם שטאָלץ פֿון יעקבֿ:</para>
  <para style="q" vid="AMO 8:7">אױב איך װעל אײביק פֿאַרגעסן אַלע זײערע מעשׂים!<verse eid="AMO 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 8:8" />זאָל איבער דעם נישט ציטערן די ערד,</para>
  <para style="q" vid="AMO 8:8">און טרױערן איטלעכער װאָס װױנט אױף איר?</para>
  <para style="q" vid="AMO 8:8">יאָ, זי װעט זיך אױפֿהײבן אין גאַנצן װי דער טײַך,</para>
  <para style="q" vid="AMO 8:8">און צערודערט װערן און זיך אַראָפּזעצן</para>
  <para style="q" vid="AMO 8:8">װי דער טײַך פֿון מִצרַיִם.<verse eid="AMO 8:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 8:9" />און עס װעט זײַן אין יענעם טאָג,</para>
  <para style="q" vid="AMO 8:9">זאָגט אֲדֹנָי ה׳,</para>
  <para style="q" vid="AMO 8:9">װעל איך מאַכן אונטערגײן די זון אין מיטן טאָג,</para>
  <para style="q" vid="AMO 8:9">און פֿינצטער מאַכן די ערד אין העלן טאָג.<verse eid="AMO 8:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 8:10" />און איך װעל פֿאַרקערן אײַערע יוֹם-טובֿים אין טרױער,</para>
  <para style="q" vid="AMO 8:10">און אַלע אײַערע געזאַנגען אין אַ קלאָג,</para>
  <para style="q" vid="AMO 8:10">און איך װעל אַרױפֿברענגען אױף אַלע לענדן זאַק,</para>
  <para style="q" vid="AMO 8:10">און אױף איטלעכן קאָפּ אַ פּליך,</para>
  <para style="q" vid="AMO 8:10">און איך װעל עס מאַכן װי דער טרױער נאָך אַן אײנאײנציקן,</para>
  <para style="q" vid="AMO 8:10">און איר סוף, װי אַ ביטערן טאָג.<verse eid="AMO 8:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 8:11" />זע, טעג קומען, זאָגט אֲדֹנָי ה׳,</para>
  <para style="q" vid="AMO 8:11">און איך װעל שיקן אַ הונגער אין לאַנד,</para>
  <para style="q" vid="AMO 8:11">נישט אַ הונגער נאָך ברױט, און נישט אַ דאָרשט נאָך װאַסער,</para>
  <para style="q" vid="AMO 8:11">נײַערט צו הערן די װערטער פֿון ג-ט.<verse eid="AMO 8:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 8:12" />און זײ װעלן װאָגלען פֿון ים צו ים,</para>
  <para style="q" vid="AMO 8:12">און פֿון צָפֿוֹן ביז מזרח;</para>
  <para style="q" vid="AMO 8:12">זײ װעלן אומװאַנדערן צו זוכן ה׳ס װאָרט,</para>
  <para style="q" vid="AMO 8:12">און זײ װעלן נישט געפֿינען.<verse eid="AMO 8:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="AMO 8:13" />אין יענעם טאָג װעלן חלשן די שײנע יונגפֿרױען</para>
  <para style="q" vid="AMO 8:13">און די בחורים פֿון דאָרשט.<verse eid="AMO 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 8:14" />די װאָס שװערן בײַ דער זינד פֿון שוֹמרוֹן,</para>
  <para style="q" vid="AMO 8:14">און זאָגן: אַזױ װי עס לעבט דײַן ג-ט, דָן!</para>
  <para style="q" vid="AMO 8:14">און: אַזױ װי עס לעבט דער װעג באֵר-שֶבַֿע!</para>
  <para style="q" vid="AMO 8:14">און זײ װעלן פֿאַלן, און װעלן מער נישט אױפֿשטײן.<verse eid="AMO 8:14" /></para>
  <chapter eid="AMO 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="AMO 9" />
  <para style="p">
    <verse number="1" style="v" sid="AMO 9:1" />איך האָב געזען אֲדֹנָי שטײן אױפֿן מזבח, און ער האָט געזאָגט:</para>
  <para style="b" vid="AMO 9:1" />
  <para style="q" vid="AMO 9:1">שלאָג די זײַלנקעפּ, אַז די בײַשטידלעך זאָלן ציטערן,</para>
  <para style="q" vid="AMO 9:1">און צעברעך זײ איבער זײערע אַלעמענס קעפּ;</para>
  <para style="q" vid="AMO 9:1">און זײער איבערבלײַב װעל איך הרגען מיטן שװערד;</para>
  <para style="q" vid="AMO 9:1">נישט אַנטלױפֿן װעט פֿון זײ אַן אַנטלאָפֿענער,</para>
  <para style="q" vid="AMO 9:1">און נישט ראַטעװען װעט זיך פֿון זײ אַן אַנטרונענער.<verse eid="AMO 9:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="AMO 9:2" />אַז זײ װעלן זיך פֿאַרגראָבן אין שְׁאֹול,</para>
  <para style="q" vid="AMO 9:2">װעט זײ פֿון דאָרטן אַרױסנעמען מײַן האַנט,</para>
  <para style="q" vid="AMO 9:2">און אַז זײ װעלן אַרױפֿגײן אין הימל,</para>
  <para style="q" vid="AMO 9:2">װעל איך זײ פֿון דאָרטן אַראָפּנידערן.<verse eid="AMO 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="AMO 9:3" />און אַז זײ װעלן זיך באַהאַלטן אױפֿן שפּיץ כַּרמֶל,</para>
  <para style="q" vid="AMO 9:3">װעל איך פֿון דאָרטן אױפֿזוכן און זײ צונעמען,</para>
  <para style="q" vid="AMO 9:3">און אַז זײ װעלן זיך פֿאַרבאָרגן</para>
  <para style="q" vid="AMO 9:3">פֿון פֿאַר מײַנע אױגן אױפֿן גרונט פֿון ים,</para>
  <para style="q" vid="AMO 9:3">װעל איך דאָרטן באַפֿעלן דער שלאַנג,</para>
  <para style="q" vid="AMO 9:3">און זי װעט זײ אײַנבײַסן.<verse eid="AMO 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="AMO 9:4" />און אַז זײ װעלן גײן אין געפֿאַנגענשאַפֿט פֿאַר זײערע פֿײַנט,</para>
  <para style="q" vid="AMO 9:4">װעל איך דאָרטן באַפֿעלן דער שװערד, און זי װעט זײ הרגען,</para>
  <para style="q" vid="AMO 9:4">און איך װעל טאָן אױף זײ מײַן אױג</para>
  <para style="q" vid="AMO 9:4">צום בײזן און נישט צום גוטן.<verse eid="AMO 9:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="AMO 9:5" />װאָרעם אֲדֹנָי ה׳ פֿון צבָֿאוֹת</para>
  <para style="q" vid="AMO 9:5">איז דער װאָס רירט אָן די ערד און זי װאַקלט זיך,</para>
  <para style="q" vid="AMO 9:5">און אַלע װױנער אױף איר טרױערן;</para>
  <para style="q" vid="AMO 9:5">און זי הײבט זיך אױף אין גאַנצן װי דער טײַך,</para>
  <para style="q" vid="AMO 9:5">און זעצט זיך אַראָפּ װי דער טײַך פֿון מִצרַיִם.<verse eid="AMO 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="AMO 9:6" />דער װאָס בױט אין הימל זײַנע אײבערקאַמערן,</para>
  <para style="q" vid="AMO 9:6">און גרונטפֿעסט זײַן געװעלב אױף דער ערד;</para>
  <para style="q" vid="AMO 9:6">װאָס רופֿט די װאַסערן פֿון ים,</para>
  <para style="q" vid="AMO 9:6">און גיסט זײ אױס אױפֿן געזיכט פֿון דער ערד;</para>
  <para style="q" vid="AMO 9:6">ה׳ איז זײַן נאָמען.<verse eid="AMO 9:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="AMO 9:7" />פֿאַר װאָר, אַזױ װי די קינדער פֿון כּוּשים זײַט איר מיר,</para>
  <para style="q" vid="AMO 9:7">קינדער פֿון יִשׂרָאֵל, זאָגט ה׳.</para>
  <para style="q" vid="AMO 9:7">פֿאַר װאָר, איך האָב אױפֿגעבראַכט יִשׂרָאֵל פֿון לאַנד מִצרַיִם,</para>
  <para style="q" vid="AMO 9:7">און די פּלִשתּים פֿון כַּפֿתּוֹר,</para>
  <para style="q" vid="AMO 9:7">און אַרָם פֿון קיר.<verse eid="AMO 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="AMO 9:8" />זע, די אױגן פֿון אֲדֹנָי ה׳</para>
  <para style="q" vid="AMO 9:8">זײַנען אױף דעם זינדיקן קיניגרײַך,</para>
  <para style="q" vid="AMO 9:8">און איך פֿאַרטיליק עס פֿון געזיכט פֿון דער ערד,</para>
  <para style="q" vid="AMO 9:8">אָבער פֿאַרטיליקן װעל איך נישט פֿאַרטיליקן דאָס הױז פֿון יעקבֿ,</para>
  <para style="q" vid="AMO 9:8">זאָגט ה׳.<verse eid="AMO 9:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="AMO 9:9" />װאָרעם זע, איך באַפֿעל און װעל לאָזן שאָקלען</para>
  <para style="q" vid="AMO 9:9">דאָס הױז פֿון יִשׂרָאֵל צװישן אַלע פֿעלקער,</para>
  <para style="q" vid="AMO 9:9">אַזױ װי עס װערט געשאָקלט אין אַ זיפּ;</para>
  <para style="q" vid="AMO 9:9">אָבער נישט אַ קערנדל װעט פֿאַלן צו דער ערד.<verse eid="AMO 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="AMO 9:10" />דורכן שװערד װעלן שטאַרבן אַלע זינדיקע פֿון מײַן פֿאָלק,</para>
  <para style="q" vid="AMO 9:10">װאָס זאָגן: נישט גענענען און זיך פֿעדערן אױף אונדז װעט דאָס בײז.<verse eid="AMO 9:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="AMO 9:11" />אין יענעם טאָג װעל איך אױפֿשטעלן</para>
  <para style="q" vid="AMO 9:11">דאָס אײַנגעפֿאַלענע בײַדל פֿון דָוִד,</para>
  <para style="q" vid="AMO 9:11">און איך װעל פֿאַרמױערן אירע בראָכן,</para>
  <para style="q" vid="AMO 9:11">און זײַנע חורבֿות װעל איך אױפֿשטעלן,</para>
  <para style="q" vid="AMO 9:11">און װעל עס אױפֿבױען װי אין אַמאָליקע טעג;<verse eid="AMO 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="AMO 9:12" />כּדי עס זאָלן אַרבן דעם איבערבלײַב פֿון אֶדוֹם און אַלע פֿעלקער</para>
  <para style="q" vid="AMO 9:12">די װאָס מײַן נאָמען װערט גערופֿן אױף זײ,</para>
  <para style="q" vid="AMO 9:12">זאָגט ה׳, דער װאָס טוט דאָס דאָזיקע.<verse eid="AMO 9:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="AMO 9:13" />זע, טעג קומען, זאָגט ה׳,</para>
  <para style="q" vid="AMO 9:13">און דער אַקערער װעט זיך אָנשטױסן אָן דעם שניטער,</para>
  <para style="q" vid="AMO 9:13">און דער טרױבנטרעטער אָן דעם זריעה-װאַרפֿער;</para>
  <para style="q" vid="AMO 9:13">און די בערג װעלן טריפֿן זאַפֿט,</para>
  <para style="q" vid="AMO 9:13">און אַלע הײכן װעלן צעגײן.<verse eid="AMO 9:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="AMO 9:14" />און איך װעל אומקערן די געפֿאַנגענשאַפֿט פֿון מײַן פֿאָלק יִשׂרָאֵל,</para>
  <para style="q" vid="AMO 9:14">און זײ װעלן אָפּבױען פֿאַרװיסטע שטעט און זיך באַזעצן,</para>
  <para style="q" vid="AMO 9:14">און פֿלאַנצן װײַנגערטנער און טרינקען זײער װײַן,</para>
  <para style="q" vid="AMO 9:14">און מאַכן גערטנער און עסן זײער פֿרוכט.<verse eid="AMO 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="AMO 9:15" />און איך װעל זײ אײַנפֿלאַנצן אױף זײער ערד,</para>
  <para style="q" vid="AMO 9:15">און זײ װעלן מער נישט אױסגעריסן װערן</para>
  <para style="q" vid="AMO 9:15">פֿון דער ערד װאָס איך האָב זײ געגעבן,</para>
  <para style="q" vid="AMO 9:15">זאָגט ה׳ דײַן ג-ט.<verse eid="AMO 9:15" /></para>
  <chapter eid="AMO 9" />
</usx>