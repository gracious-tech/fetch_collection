<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="LAM" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">אֵיכָה</para>
  <para style="toc2">אֵיכָה</para>
  <para style="toc1">אֵיכָה</para>
  <para style="mt1">אֵיכָה</para>
  <chapter number="1" style="c" pubnumber="א" sid="LAM 1" />
  <para style="q">
    <verse number="1" style="v" sid="LAM 1:1" />װי איז געבליבן זיצן אַלײן</para>
  <para style="q" vid="LAM 1:1">די שטאָט פֿון פֿיל פֿאָלק;</para>
  <para style="q" vid="LAM 1:1">געװאָרן װי אַן אַלמנה</para>
  <para style="q" vid="LAM 1:1">די פֿירשטן צװישן די אומות;</para>
  <para style="q" vid="LAM 1:1">די האַרינטע צװישן די מדינות</para>
  <para style="q" vid="LAM 1:1">געװאָרן צו צינדז!<verse eid="LAM 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="LAM 1:2" />װײנען טוט זי װײנען בײַ נאַכט,</para>
  <para style="q" vid="LAM 1:2">און איר טרער איז אױף איר באַק;</para>
  <para style="q" vid="LAM 1:2">זי האָט נישט קײן טרײסטער פֿון אַלע אירע ליבהאָבער;</para>
  <para style="q" vid="LAM 1:2">אַלע אירע גוטע פֿרײַנט האָבן געפֿעלשט אָן איר,</para>
  <para style="q" vid="LAM 1:2">זײ זײַנען איר שָׂונאים געװאָרן.<verse eid="LAM 1:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="LAM 1:3" />יהוּדה איז אין גלות אַװעק</para>
  <para style="q" vid="LAM 1:3">אין פּײַן און אין גרױס קנעכטשאַפֿט;</para>
  <para style="q" vid="LAM 1:3">זי זיצט צװישן די פֿעלקער,</para>
  <para style="q" vid="LAM 1:3">זי געפֿינט נישט קײן רו;</para>
  <para style="q" vid="LAM 1:3">אַלע אירע נאָכיאָגערס</para>
  <para style="q" vid="LAM 1:3">האָבן זי דערגרײכט צװישן די ענגענישן.<verse eid="LAM 1:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 1:4" />די װעגן פֿון צִיוֹן טרױערן,</para>
  <para style="q" vid="LAM 1:4">װײַל נישטאָ די װאָס קומען אױף יוֹם-טובֿ;</para>
  <para style="q" vid="LAM 1:4">אַלע אירע טױערן זײַנען װיסט,</para>
  <para style="q" vid="LAM 1:4">אירע כּהנים זיפֿצן,</para>
  <para style="q" vid="LAM 1:4">אירע יונגפֿרױען זײַנען פֿאַראומערט,</para>
  <para style="q" vid="LAM 1:4">און זי, ביטער איז איר.<verse eid="LAM 1:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="LAM 1:5" />אירע פֿײַנט זײַנען געװאָרן די קעפּ,</para>
  <para style="q" vid="LAM 1:5">אירע שָׂונאים זײַנען אין שלװה;</para>
  <para style="q" vid="LAM 1:5">װאָרעם ה׳ האָט זי פֿאַראומערט,</para>
  <para style="q" vid="LAM 1:5">פֿאַר די פֿיל פֿאַרברעכן אירע;</para>
  <para style="q" vid="LAM 1:5">אירע קלײנע קינדער זײַנען אַװעק</para>
  <para style="q" vid="LAM 1:5">אין געפֿאַנגענשאַפֿט פֿאַרױס פֿאַרן פֿײַנט.<verse eid="LAM 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="LAM 1:6" />און אַרױס איז פֿון טאָכטער צִיוֹן</para>
  <para style="q" vid="LAM 1:6">דער גאַנצער גלאַנץ אירער;</para>
  <para style="q" vid="LAM 1:6">אירע האַרן זײַנען געװאָרן װי די הינדן,</para>
  <para style="q" vid="LAM 1:6">װאָס געפֿינען נישט קײן פֿיטערונג,</para>
  <para style="q" vid="LAM 1:6">און זײ זײַנען געגאַנגען אָן כּוֹח</para>
  <para style="q" vid="LAM 1:6">פֿאַר דעם נאָכיאָגער.<verse eid="LAM 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 1:7" />ירושָלַיִם דערמאָנט זיך</para>
  <para style="q" vid="LAM 1:7">אין די טעג פֿון איר פּײַן און אירע װאָגלענישן,</para>
  <para style="q" vid="LAM 1:7">אַלע גלוסטיקײטן װאָס זי האָט געהאַט</para>
  <para style="q" vid="LAM 1:7">אין די טעג פֿון אַ מאָל.</para>
  <para style="q" vid="LAM 1:7">װען איר פֿאָלק איז געפֿאַלן פֿון דער האַנט פֿון פֿײַנט,</para>
  <para style="q" vid="LAM 1:7">און זי האָט נישט קײן העלפֿער געהאַט,</para>
  <para style="q" vid="LAM 1:7">האָבן די פֿײַנט געקוקט אױף איר,</para>
  <para style="q" vid="LAM 1:7">געלאַכט אױף איר אונטערגאַנג.<verse eid="LAM 1:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="LAM 1:8" />זינד געזינדיקט האָט ירושָלַיִם,</para>
  <para style="q" vid="LAM 1:8">דערום איז זי פֿאַר אַן אומרײנער געװאָרן;</para>
  <para style="q" vid="LAM 1:8">אַלע װאָס האָבן זי געאַכט, פֿאַראַכטן זי,</para>
  <para style="q" vid="LAM 1:8">װײַל זײ האָבן געזען איר שאַנד;</para>
  <para style="q" vid="LAM 1:8">יאָ, זי אַלײן טוט זיפֿצן, און קערט זיך אַהינטער.<verse eid="LAM 1:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="LAM 1:9" />איר אומרײניקײט איז געװען אין אירע ברעגן,</para>
  <para style="q" vid="LAM 1:9">זי האָט נישט געדאַכט אָן איר סוף;</para>
  <para style="q" vid="LAM 1:9">דערום האָט זי װוּנדערלעך גענידערט,</para>
  <para style="q" vid="LAM 1:9">זי האָט נישט קײן טרײסטער.</para>
  <para style="q" vid="LAM 1:9">זע, ה׳, מײַן פּײַן,</para>
  <para style="q" vid="LAM 1:9">װאָרעם דער שׂונא טוט זיך גרײסן.<verse eid="LAM 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 1:10" />דער פֿײַנט האָט אױסגעשפּרײט זײַן האַנט</para>
  <para style="q" vid="LAM 1:10">אױף אַלע אירע גלוסטיקײטן;</para>
  <para style="q" vid="LAM 1:10">װאָרעם זי האָט געזען װי די פֿעלקער</para>
  <para style="q" vid="LAM 1:10">זײַנען געקומען אין איר הײליקטום,</para>
  <para style="q" vid="LAM 1:10">די װאָס דו האָסט באַפֿױלן,</para>
  <para style="q" vid="LAM 1:10">זײ זאָלן אין דײַן עדה נישט קומען.<verse eid="LAM 1:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="LAM 1:11" />דאָס גאַנצע פֿאָלק אירס זיפֿצט, זײ זוכן ברױט;</para>
  <para style="q" vid="LAM 1:11">זײערע גלוסטיקײטן האָבן זײ אַװעקגעגעבן פֿאַר שפּײַז,</para>
  <para style="q" vid="LAM 1:11">דעם נפֿש צו דערקװיקן.</para>
  <para style="q" vid="LAM 1:11">זע, ה׳, און קוק</para>
  <para style="q" vid="LAM 1:11">װי נידעריק איך בין געװאָרן.<verse eid="LAM 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="LAM 1:12" />נישט געשען זאָל עס אײַך, אַלע װעגגײער!</para>
  <para style="q" vid="LAM 1:12">טוט אַ קוק, און זעט,</para>
  <para style="q" vid="LAM 1:12">צי איז דאָ אַ װײטאָג װי מײַן װײטאָג,</para>
  <para style="q" vid="LAM 1:12">װאָס איז מיר אָנגעטאָן געװאָרן,</para>
  <para style="q" vid="LAM 1:12">װען ה׳ האָט מיך פֿאַראומערט,</para>
  <para style="q" vid="LAM 1:12">אין טאָג פֿון זײַן גרימצאָרן.<verse eid="LAM 1:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 1:13" />פֿון דער הײך האָט ער אַראָפּגעשיקט אַ פֿײַער</para>
  <para style="q" vid="LAM 1:13">אין מײַנע בײנער, און זײ באַװעלטיקט;</para>
  <para style="q" vid="LAM 1:13">ער האָט פֿאַרשפּרײט אַ נעץ פֿאַר מײַנע פֿיס,</para>
  <para style="q" vid="LAM 1:13">ער האָט מיך אַהינטער געקערט;</para>
  <para style="q" vid="LAM 1:13">װיסט האָט ער מיך געמאַכט, קראַנק אַ גאַנצן טאָג.<verse eid="LAM 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="LAM 1:14" />פֿאַרקניפּט מיט זײַן האַנט איז דער יאָך פֿון מײַנע זינד;</para>
  <para style="q" vid="LAM 1:14">זײ פֿלעכטן זיך, זײ לײגן זיך אַרױף אױף מײַן האַלדז;</para>
  <para style="q" vid="LAM 1:14">ער האָט געמאַכט שטרױכלען מײַן כּוֹח;</para>
  <para style="q" vid="LAM 1:14">אֲדֹנָי האָט מיך געגעבן אין הענט,</para>
  <para style="q" vid="LAM 1:14">אַז איך קען נישט אױפֿשטײן.<verse eid="LAM 1:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="LAM 1:15" />אֲדֹנָי האָט געמאַכט צונישט</para>
  <para style="q" vid="LAM 1:15">אַלע מײַנע גיבוֹרים אין מיר;</para>
  <para style="q" vid="LAM 1:15">ער האָט גערופֿן אױף מיר אַן אײַנזאַמלונג,</para>
  <para style="q" vid="LAM 1:15">צו צעברעכן מײַנע יונגעלײַט;</para>
  <para style="q" vid="LAM 1:15">װי אַ קעלטער האָט אֲדֹנָי געטרעטן,</para>
  <para style="q" vid="LAM 1:15">די יונגפֿרױ טאָכטער יהוּדה.<verse eid="LAM 1:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 1:16" />דערױף טו איך װײנען,</para>
  <para style="q" vid="LAM 1:16">מײַן אױג, מײַן אױג רינט װאַסער;</para>
  <para style="q" vid="LAM 1:16">װאָרעם װײַט איז אַ טרײסטער פֿון מיר,</para>
  <para style="q" vid="LAM 1:16">װאָס זאָל דערקװיקן מײַן זעל;</para>
  <para style="q" vid="LAM 1:16">מײַנע קינדער זײַנען פֿאַרװיסט,</para>
  <para style="q" vid="LAM 1:16">װאָרעם דער שׂונא האָט איבערגעשטאַרקט.<verse eid="LAM 1:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="LAM 1:17" />צִיוֹן צעשפּרײט אירע הענט,</para>
  <para style="q" vid="LAM 1:17">זי האָט נישט קײן טרײסטער;</para>
  <para style="q" vid="LAM 1:17">ה׳ האָט באַפֿױלן אַקעגן יעקבֿ</para>
  <para style="q" vid="LAM 1:17">רונד אַרום אים זײַנע פֿײַנט;</para>
  <para style="q" vid="LAM 1:17">ירושָלַיִם איז געװאָרן פֿאַר אַן אומרײנער צװישן זײ.<verse eid="LAM 1:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="LAM 1:18" />ה׳ איז גערעכט,</para>
  <para style="q" vid="LAM 1:18">װאָרעם איך האָב װידערשפּעניקט זײַן מױל;</para>
  <para style="q" vid="LAM 1:18">הערט, אַלע פֿעלקער, איך בעט אײַך,</para>
  <para style="q" vid="LAM 1:18">און זעט צו מײַן װײטאָג:</para>
  <para style="q" vid="LAM 1:18">מײַנע בחורים און מײַנע מײדלעך</para>
  <para style="q" vid="LAM 1:18">זײַנען אַװעק אין געפֿאַנגענשאַפֿט.<verse eid="LAM 1:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 1:19" />איך האָב גערופֿן מײַנע ליבהאָבער,</para>
  <para style="q" vid="LAM 1:19">האָבן זײ מיך אָפּגענאַרט;</para>
  <para style="q" vid="LAM 1:19">מײַנע כּהנים און מײַנע עלטסטע</para>
  <para style="q" vid="LAM 1:19">זײַנען אױסגעגאַנגען אין שטאָט,</para>
  <para style="q" vid="LAM 1:19">װען זײ האָבן שפּײַז זיך געזוכט,</para>
  <para style="q" vid="LAM 1:19">זײ זאָלן זײער נפֿש דערקװיקן.<verse eid="LAM 1:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="LAM 1:20" />זע, ה׳, װי מיר איז ענג,</para>
  <para style="q" vid="LAM 1:20">מײַנע אינגעװײד ברענען,</para>
  <para style="q" vid="LAM 1:20">מײַן האַרץ קערט זיך איבער אין מיר,</para>
  <para style="q" vid="LAM 1:20">װײַל װידערשפּעניקן האָב איך װידערשפּעניקט;</para>
  <para style="q" vid="LAM 1:20">דרױסן נעמט אַװעק די שװערד,</para>
  <para style="q" vid="LAM 1:20">אין הױז איז װי דער טױט.<verse eid="LAM 1:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="LAM 1:21" />זײ האָבן געהערט װי איך זיפֿץ,</para>
  <para style="q" vid="LAM 1:21">אָבער איך האָב נישט קײן טרײסטער;</para>
  <para style="q" vid="LAM 1:21">אַלע מײַנע שָׂונאים האָבן געהערט מײַן אומגליק,</para>
  <para style="q" vid="LAM 1:21">זײ פֿרײען זיך װאָס דו האָסט דאָס געטאָן,</para>
  <para style="q" vid="LAM 1:21">ברענג דעם טאָג װאָס דו האָסט אָנגעזאָגט,</para>
  <para style="q" vid="LAM 1:21">און זאָלן זײ װערן װי איך!<verse eid="LAM 1:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 1:22" />זאָל קומען אַל זײער בײז פֿאַר דיר,</para>
  <para style="q" vid="LAM 1:22">און טו צו זײ</para>
  <para style="q" vid="LAM 1:22">אַזױ װי דו האָסט צו מיר געטאָן,</para>
  <para style="q" vid="LAM 1:22">פֿאַר אַלע מײַנע זינד;</para>
  <para style="q" vid="LAM 1:22">װאָרעם פֿיל זײַנען מײַנע זיפֿצן,</para>
  <para style="q" vid="LAM 1:22">און מײַן האַרץ איז קראַנק.<verse eid="LAM 1:22" /></para>
  <chapter eid="LAM 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="LAM 2" />
  <para style="q">
    <verse number="1" style="v" sid="LAM 2:1" />װי האָט אֲדֹנָי אין זײַן כּעס</para>
  <para style="q" vid="LAM 2:1">פֿאַרװאָלקנט די טאָכטער צִיוֹן!</para>
  <para style="q" vid="LAM 2:1">אַראָפּגעװאָרפֿן פֿון הימל צו דער ערד</para>
  <para style="q" vid="LAM 2:1">די שײנקײט פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="LAM 2:1">און נישט געדאַכט אָן זײַן פֿוסבענקל</para>
  <para style="q" vid="LAM 2:1">אין טאָג פֿון זײַן כּעס!<verse eid="LAM 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="LAM 2:2" />אֲדֹנָי האָט אומגעבראַכט אָן רחמנות</para>
  <para style="q" vid="LAM 2:2">אַלע װױנונגען פֿון יעקבֿ;</para>
  <para style="q" vid="LAM 2:2">צעשטערט אין זײַן צאָרן</para>
  <para style="q" vid="LAM 2:2">די פֿעסטונגען פֿון טאָכטער יהוּדה,</para>
  <para style="q" vid="LAM 2:2">זײ געבראַכט צו דער ערד;</para>
  <para style="q" vid="LAM 2:2">פֿאַרשװעכט דאָס קיניגרײַך און זײַנע האַרן!<verse eid="LAM 2:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="LAM 2:3" />ער האָט אָפּגעהאַקט מיט גרימצאָרן</para>
  <para style="q" vid="LAM 2:3">דעם גאַנצן האָרן פֿון יִשׂרָאֵל;</para>
  <para style="q" vid="LAM 2:3">ער האָט צוריקגעצױגן זײַן רעכטע האַנט</para>
  <para style="q" vid="LAM 2:3">פֿון פֿאַרן שׂונא,</para>
  <para style="q" vid="LAM 2:3">און געברענט אין יעקבֿ װי אַ פֿלאַמפֿײַער</para>
  <para style="q" vid="LAM 2:3">װאָס פֿאַרצערט רונד אַרום.<verse eid="LAM 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 2:4" />ער האָט געשפּאַנט זײַן בױגן װי אַ שׂונא,</para>
  <para style="q" vid="LAM 2:4">זיך געשטעלט מיט זײַן רעכטער האַנט װי אַ פֿײַנט,</para>
  <para style="q" vid="LAM 2:4">און געהרגעט אַלע גלוסטיקע פֿון אױג;</para>
  <para style="q" vid="LAM 2:4">אין געצעלט פֿון טאָכטער צִיוֹן</para>
  <para style="q" vid="LAM 2:4">האָט ער אױסגעגאָסן װי אַ פֿײַער זײַן גרימצאָרן.<verse eid="LAM 2:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="LAM 2:5" />אֲדֹנָי איז געװאָרן װי אַ שׂונא,</para>
  <para style="q" vid="LAM 2:5">ער האָט אומגעבראַכט יִשׂרָאֵל;</para>
  <para style="q" vid="LAM 2:5">אומגעבראַכט אַלע אירע פּאַלאַצן,</para>
  <para style="q" vid="LAM 2:5">צעשטערט זײַנע פֿעסטונגען,</para>
  <para style="q" vid="LAM 2:5">און געמערט בײַ טאָכטער יהוּדה קלאָגעניש און קלאָג.<verse eid="LAM 2:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="LAM 2:6" />און ער האָט אָפּגעפֿליקט</para>
  <para style="q" vid="LAM 2:6">װי אַ גאָרטן זײַן בײַדל,</para>
  <para style="q" vid="LAM 2:6">ער האָט צעשטערט זײַן זאַמלאָרט;</para>
  <para style="q" vid="LAM 2:6">ה׳ האָט געמאַכט פֿאַרגעסן אין צִיוֹן</para>
  <para style="q" vid="LAM 2:6">אַ יוֹם-טובֿ און אַ שבת,</para>
  <para style="q" vid="LAM 2:6">און פֿאַראַכט אין זײַן גרימצאָרן</para>
  <para style="q" vid="LAM 2:6">דעם מלך און דעם כּהן.<verse eid="LAM 2:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 2:7" />אֲדֹנָי האָט פֿאַרלאָזט זײַן מזבח,</para>
  <para style="q" vid="LAM 2:7">אַװעקגעװאָרפֿן זײַן מִקדָש;</para>
  <para style="q" vid="LAM 2:7">איבערגעענטפֿערט אין האַנט פֿון דעם שׂונא</para>
  <para style="q" vid="LAM 2:7">די מױערן פֿון אירע פּאַלאַצן;</para>
  <para style="q" vid="LAM 2:7">זײ האָבן קוֹלות געמאַכט אין הױז פֿון ה׳,</para>
  <para style="q" vid="LAM 2:7">אַזױ װי אין אַ יוֹם-טובֿ.<verse eid="LAM 2:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="LAM 2:8" />ה׳ האָט געטראַכט צו צעשטערן</para>
  <para style="q" vid="LAM 2:8">די מױער פֿון טאָכטער צִיוֹן;</para>
  <para style="q" vid="LAM 2:8">ער האָט געצױגן אַ מעסטשנור,</para>
  <para style="q" vid="LAM 2:8">ער האָט נישט אָפּגעהאַלטן זײַן האַנט פֿון אומצוברענגען,</para>
  <para style="q" vid="LAM 2:8">און געמאַכט טרױערן די פֿעסטונג און די מױער;</para>
  <para style="q" vid="LAM 2:8">אין אײנעם זײַנען זײ פֿאַרשניטן געװאָרן.<verse eid="LAM 2:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="LAM 2:9" />אײַנגעזונקען אין דער ערד זײַנען אירע טױערן,</para>
  <para style="q" vid="LAM 2:9">ער האָט צעשטערט און צעבראָכן אירע ריגלען;</para>
  <para style="q" vid="LAM 2:9">איר מלך און אירע האַרן זײַנען צװישן די פֿעלקער,</para>
  <para style="q" vid="LAM 2:9">נישטאָ מער קײן תּורה;</para>
  <para style="q" vid="LAM 2:9">אַפֿילו אירע נבֿיאים געפֿינען נישט אַ זעונג פֿון ה׳.<verse eid="LAM 2:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 2:10" />זײ זיצן אױף דער ערד און שװײַגן,</para>
  <para style="q" vid="LAM 2:10">די עלטסטע פֿון טאָכטער צִיוֹן,</para>
  <para style="q" vid="LAM 2:10">זײ האָבן אַרױפֿגעטאָן שטױב אױף זײער קאָפּ,</para>
  <para style="q" vid="LAM 2:10">זײ האָבן אָנגעגורט זאַק;</para>
  <para style="q" vid="LAM 2:10">אַראָפּגעלאָזט זײערע קעפּ צו דער ערד</para>
  <para style="q" vid="LAM 2:10">האָבן די יונגפֿרױען פֿון ירושָלַיִם.<verse eid="LAM 2:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="LAM 2:11" />מײַנע אױגן גײען אױס פֿון טרערן,</para>
  <para style="q" vid="LAM 2:11">מײַנע אינגעװײד ברענען,</para>
  <para style="q" vid="LAM 2:11">מײַן לעבער איז אױסגעגאָסן אױף דער ערד,</para>
  <para style="q" vid="LAM 2:11">אױף דעם בראָך פֿון דער טאָכטער מײַן פֿאָלק;</para>
  <para style="q" vid="LAM 2:11">װײַל קלײנע קינדער און זױגעדיקע</para>
  <para style="q" vid="LAM 2:11">חלשן אין די גאַסן פֿון שטאָט.<verse eid="LAM 2:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="LAM 2:12" />זײ זאָגן צו זײערע מוטערס:</para>
  <para style="q" vid="LAM 2:12">װוּ איז קאָרן און װײַן?</para>
  <para style="q" vid="LAM 2:12">װען זײ חלשן װי דערשלאָגענע</para>
  <para style="q" vid="LAM 2:12">אין די גאַסן פֿון שטאָט,</para>
  <para style="q" vid="LAM 2:12">װען זײער זעל גיסט זיך אױס</para>
  <para style="q" vid="LAM 2:12">אױף דער ברוסט פֿון זײערע מוטערס.<verse eid="LAM 2:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 2:13" />װאָס זאָל איך דיר עדותן?</para>
  <para style="q" vid="LAM 2:13">װאָס זאָל איך צו דיר גלײַכן, טאָכטער ירושָלַיִם?</para>
  <para style="q" vid="LAM 2:13">װאָס זאָל איך פֿאַרגלײַכן צו דיר, און דיך טרײסטן,</para>
  <para style="q" vid="LAM 2:13">יונגפֿרױ טאָכטער צִיוֹן?</para>
  <para style="q" vid="LAM 2:13">אַז גרױס װי דער ים איז דײַן בראָך –</para>
  <para style="q" vid="LAM 2:13">װער קען דיך הײלן?<verse eid="LAM 2:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="LAM 2:14" />דײַנע נבֿיאים האָבן דיר געזען</para>
  <para style="q" vid="LAM 2:14">פֿאַלשקײט און אָפּנאַרעניש,</para>
  <para style="q" vid="LAM 2:14">און זײ האָבן נישט אַנטפּלעקט דײַן זינד,</para>
  <para style="q" vid="LAM 2:14">אומצוקערן דײַן געפֿאַנגענשאַפֿט;</para>
  <para style="q" vid="LAM 2:14">און זײ האָבן דיר געזען נבֿואות</para>
  <para style="q" vid="LAM 2:14">פֿון פֿאַלשקײט און פֿאַרפֿירענישן.<verse eid="LAM 2:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="LAM 2:15" />אַלע פֿאַרבײַגײער פּאַטשן אױף דיר מיט די הענט,</para>
  <para style="q" vid="LAM 2:15">זײ שמוצערן, און שאָקלען זײער קאָפּ אױף טאָכטער ירושָלַיִם:</para>
  <para style="q" vid="LAM 2:15">איז דאָס די שטאָט װאָס מע האָט גערופֿן</para>
  <para style="q" vid="LAM 2:15">די קרױן פֿון שײנקײט,</para>
  <para style="q" vid="LAM 2:15">די פֿרײד פֿון דער גאַנצער ערד?<verse eid="LAM 2:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 2:16" />געעפֿנט זײער מױל אױף דיר האָבן אַלע דײַנע שָׂונאים;</para>
  <para style="q" vid="LAM 2:16">זײ שמוצערן, און קריצן די צײן;</para>
  <para style="q" vid="LAM 2:16">זײ זאָגן: מיר האָבן זי אײַנגעשלונגען;</para>
  <para style="q" vid="LAM 2:16">פֿאַר װאָר, דאָס איז דער טאָג װאָס מיר האָבן געהאָפֿט אױף אים,</para>
  <para style="q" vid="LAM 2:16">מיר האָבן דערגרײכט, מיר האָבן דערלעבט.<verse eid="LAM 2:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="LAM 2:17" />ה׳ האָט געטאָן װאָס ער האָט געטראַכט,</para>
  <para style="q" vid="LAM 2:17">ער האָט אױסגעפֿירט זײַן װאָרט</para>
  <para style="q" vid="LAM 2:17">װאָס ער האָט אָנגעזאָגט פֿון אַמאָליקע טעג;</para>
  <para style="q" vid="LAM 2:17">ער האָט צעשטערט אָן רחמנות,</para>
  <para style="q" vid="LAM 2:17">און דערפֿרײט דעם שׂונא איבער דיר,</para>
  <para style="q" vid="LAM 2:17">דערהײכט דעם האָרן פֿון דײַנע פֿײַנט.<verse eid="LAM 2:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="LAM 2:18" />זײער האַרץ האָט געשריען צו אֲדֹנָי:</para>
  <para style="q" vid="LAM 2:18">מױער פֿון טאָכטער צִיוֹן,</para>
  <para style="q" vid="LAM 2:18">לאָז רינען טרערן װי אַ טײַך, טאָג און נאַכט;</para>
  <para style="q" vid="LAM 2:18">זאָלסט זיך נישט געבן קײן אָפּרו,</para>
  <para style="q" vid="LAM 2:18">נישט שטילן זאָל זיך דײַן אױגאַפּל.<verse eid="LAM 2:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 2:19" />שטײ אױף, שרײַ אין דער נאַכט,</para>
  <para style="q" vid="LAM 2:19">אין אָנהײב פֿון די נאַכטװאַכן;</para>
  <para style="q" vid="LAM 2:19">גיס אױס װי װאַסער דײַן האַרץ,</para>
  <para style="q" vid="LAM 2:19">פֿאַר דעם פּנים פֿון אֲדֹנָי;</para>
  <para style="q" vid="LAM 2:19">הײב אױף דײַנע הענט צו אים,</para>
  <para style="q" vid="LAM 2:19">פֿאַר די נפֿשות פֿון דײַנע קלײנע קינדער</para>
  <para style="q" vid="LAM 2:19">װאָס חלשן פֿון הונגער אין אַלע עק גאַסן.<verse eid="LAM 2:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="LAM 2:20" />זע, ה׳, און קוק</para>
  <para style="q" vid="LAM 2:20">װעמען דו האָסט אַזױנס געטאָן!</para>
  <para style="q" vid="LAM 2:20">דאַרפֿן װײַבער עסן זײער פֿרוכט,</para>
  <para style="q" vid="LAM 2:20">קינדער געצערטלטע?</para>
  <para style="q" vid="LAM 2:20">דאַרף געטײט װערן אין הײליקטום פֿון אֲדֹנָי</para>
  <para style="q" vid="LAM 2:20">דער כּהן און דער נבֿיא?<verse eid="LAM 2:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="LAM 2:21" />אױף דער ערד אין די גאַסן</para>
  <para style="q" vid="LAM 2:21">ליגן אַלט און יונג;</para>
  <para style="q" vid="LAM 2:21">מײַנע מײדלעך און מײַנע בחורים</para>
  <para style="q" vid="LAM 2:21">זײַנען געפֿאַלן פֿון שװערד;</para>
  <para style="q" vid="LAM 2:21">האָסט געהרגעט אין טאָג פֿון דײַן צאָרן,</para>
  <para style="q" vid="LAM 2:21">געשאָכטן אָן רחמנות.<verse eid="LAM 2:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="LAM 2:22" />האָסט גערופֿן װי אױף אַ יוֹם-טובֿ</para>
  <para style="q" vid="LAM 2:22">מײַנע שרעקענישן פֿון אַרום;</para>
  <para style="q" vid="LAM 2:22">און נישט געװען אין טאָג פֿון ה׳ס צאָרן</para>
  <para style="q" vid="LAM 2:22">קײן אַנטרונענער און געבליבענער;</para>
  <para style="q" vid="LAM 2:22">די װאָס איך האָב געצערטלט און אױפֿגעבראַכט</para>
  <para style="q" vid="LAM 2:22">זײ האָט מײַן שׂונא פֿאַרלענדט.<verse eid="LAM 2:22" /></para>
  <chapter eid="LAM 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="LAM 3" />
  <para style="q">
    <verse number="1" style="v" sid="LAM 3:1" />איך בין דער מאַן װאָס האָט אָנגעזען פּײַן</para>
  <para style="q" vid="LAM 3:1">דורך דער רוט פֿון זײַן צאָרן.<verse eid="LAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 3:2" />ער האָט מיך געפֿירט און געמאַכט גײן</para>
  <para style="q" vid="LAM 3:2">אין פֿינצטערניש און נישט ליכטיקײט.<verse eid="LAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 3:3" />פֿאַר װאָר, קעגן מיר װידער און װידער</para>
  <para style="q" vid="LAM 3:3">קערט ער זײַן האַנט אַ גאַנצן טאָג.<verse eid="LAM 3:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 3:4" />ער האָט אָפּגעצערט מײַן פֿלײש און מײַן הױט,</para>
  <para style="q" vid="LAM 3:4">ער האָט צעבראָכן מײַנע בײנער.<verse eid="LAM 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 3:5" />ער האָט מיך באַבױט, און אַרומגערינגלט</para>
  <para style="q" vid="LAM 3:5">מיט גיפֿט און מיט מאַטערניש.<verse eid="LAM 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 3:6" />ער האָט מיך אַרײַנגעזעצט אין חושכנישן,</para>
  <para style="q" vid="LAM 3:6">װי מתים פֿון לאַנג אָן.<verse eid="LAM 3:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 3:7" />ער האָט מיך פֿאַרצאַמט, אַז איך קען נישט אַרױסגײן,</para>
  <para style="q" vid="LAM 3:7">ער האָט שװער געמאַכט מײַן קײט.<verse eid="LAM 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 3:8" />אַפֿילו װען איך שרײַ און רוף,</para>
  <para style="q" vid="LAM 3:8">פֿאַרשפּאַרט ער מײַן תּפֿילה.<verse eid="LAM 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 3:9" />ער האָט פֿאַרצאַמט מײַנע װעגן מיט שטײנער,</para>
  <para style="q" vid="LAM 3:9">ער האָט מײַנע שטעגן פֿאַרקרימט.<verse eid="LAM 3:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 3:10" />אַ לױערדיקער בער איז ער מיר,</para>
  <para style="q" vid="LAM 3:10">אַ לײב אין פֿאַרבאָרגעניש.<verse eid="LAM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 3:11" />ער האָט אָפּגעקערט מײַנע װעגן, און מיך צעריסן,</para>
  <para style="q" vid="LAM 3:11">װיסט האָט ער מיך געמאַכט.<verse eid="LAM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 3:12" />ער האָט געשפּאַנט זײַן בױגן,</para>
  <para style="q" vid="LAM 3:12">און מיך געשטעלט פֿאַר אַ ציל צו דער פֿײַל.<verse eid="LAM 3:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 3:13" />ער האָט אַרײַנגעלאָזט אין מײַנע נירן,</para>
  <para style="q" vid="LAM 3:13">די זין פֿון זײַן פֿײַלבײַטל.<verse eid="LAM 3:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 3:14" />איך בין געװאָרן אַ געלעכטער בײַ מײַן גאַנצן פֿאָלק,</para>
  <para style="q" vid="LAM 3:14">זײער שפּאָטליד אַ גאַנצן טאָג.<verse eid="LAM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 3:15" />ער האָט מיך אָנגעזעט מיט ביטערנישן,</para>
  <para style="q" vid="LAM 3:15">מיך געזעטיקט מיט װערמוט.<verse eid="LAM 3:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 3:16" />און ער האָט צעבראָכן מיט שטײנדלעך מײַנע צײן,</para>
  <para style="q" vid="LAM 3:16">ער האָט מיך געװעלגערט אין אַש.<verse eid="LAM 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 3:17" />און מײַן זעל איז פֿאַרשטױסן פֿון פֿריד,</para>
  <para style="q" vid="LAM 3:17">איך האָב פֿאַרגעסן אָן גוטס.<verse eid="LAM 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 3:18" />און איך זאָג: פֿאַרלאָרן איז מײַן שטאַרקײט,</para>
  <para style="q" vid="LAM 3:18">און מײַן האָפֿענונג פֿון ה׳.<verse eid="LAM 3:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 3:19" />די דערמאָנונג פֿון מײַן פּײַן און מײַן װאָגלעניש,</para>
  <para style="q" vid="LAM 3:19">איז װערמוט און ביטערקרױט.<verse eid="LAM 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 3:20" />דערמאָנען דערמאָנט זיך מײַן זעל,</para>
  <para style="q" vid="LAM 3:20">און זי בײגט זיך אין מיר.<verse eid="LAM 3:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 3:21" />דאָס ענטפֿער איך צו מײַן האַרצן,</para>
  <para style="q" vid="LAM 3:21">דערום טו איך האַרן:<verse eid="LAM 3:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="LAM 3:22" />אַז די חסָדים פֿון ה׳ זײַנען נישט אױסגעגאַנגען,</para>
  <para style="q" vid="LAM 3:22">אַז נישט געענדיקט האָט זיך זײַן רחמנות;<verse eid="LAM 3:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="LAM 3:23" />זײ זײַנען נײַ אַלע פֿרימאָרגן;</para>
  <para style="q" vid="LAM 3:23">גרױס איז דײַן טרײַשאַפֿט.<verse eid="LAM 3:23" /></para>
  <para style="q">
    <verse number="24" style="v" sid="LAM 3:24" />ה׳ איז מײַן חלק, זאָגט מײַן זעל,</para>
  <para style="q" vid="LAM 3:24">דערום האָף איך צו אים.<verse eid="LAM 3:24" /></para>
  <para style="b" />
  <para style="q">
    <verse number="25" style="v" sid="LAM 3:25" />גוט איז ה׳ צו די װאָס האַרן אױף אים,</para>
  <para style="q" vid="LAM 3:25">צו דער זעל װאָס טוט אים זוכן.<verse eid="LAM 3:25" /></para>
  <para style="q">
    <verse number="26" style="v" sid="LAM 3:26" />גוט איז מע זאָל האַרן אַ פֿאַרשװיגענער</para>
  <para style="q" vid="LAM 3:26">אױף דער ישועה פֿון ה׳.<verse eid="LAM 3:26" /></para>
  <para style="q">
    <verse number="27" style="v" sid="LAM 3:27" />גוט איז פֿאַר אַ מענטשן,</para>
  <para style="q" vid="LAM 3:27">אַז ער זאָל טראָגן דעם יאָך אין זײַן יוגנט;<verse eid="LAM 3:27" /></para>
  <para style="b" />
  <para style="q">
    <verse number="28" style="v" sid="LAM 3:28" />ער זאָל זיצן אַלײן און שװײַגן,</para>
  <para style="q" vid="LAM 3:28">װען מע האָט אַרױפֿגעלײגט אױף אים;<verse eid="LAM 3:28" /></para>
  <para style="q">
    <verse number="29" style="v" sid="LAM 3:29" />ער זאָל לײגן אין אַש זײַן מױל,</para>
  <para style="q" vid="LAM 3:29">אפֿשר איז אַ האָפֿענונג פֿאַראַן;<verse eid="LAM 3:29" /></para>
  <para style="q">
    <verse number="30" style="v" sid="LAM 3:30" />ער זאָל געבן די באַק צו זײַן שלעגער,</para>
  <para style="q" vid="LAM 3:30">ער זאָל זיך זעטן מיט שאַנד.<verse eid="LAM 3:30" /></para>
  <para style="b" />
  <para style="q">
    <verse number="31" style="v" sid="LAM 3:31" />װאָרעם נישט אױף אײביק פֿאַרלאָזט אֲדֹנָי;<verse eid="LAM 3:31" /></para>
  <para style="q">
    <verse number="32" style="v" sid="LAM 3:32" />װאָרעם אױב ער האָט פֿאַראומערט,</para>
  <para style="q" vid="LAM 3:32">דערבאַרעמט ער אָבער לױט זײַנע גרױסע חסָדים.<verse eid="LAM 3:32" /></para>
  <para style="q">
    <verse number="33" style="v" sid="LAM 3:33" />װאָרעם נישט פֿון זײַן האַרצן פּײַניקט ער,</para>
  <para style="q" vid="LAM 3:33">און פֿאַראומערט די מענטשנקינדער.<verse eid="LAM 3:33" /></para>
  <para style="b" />
  <para style="q">
    <verse number="34" style="v" sid="LAM 3:34" />צו דריקן אונטער זײַנע פֿיס</para>
  <para style="q" vid="LAM 3:34">אַלע געפֿאַנגענע פֿון דער ערד,<verse eid="LAM 3:34" /></para>
  <para style="q">
    <verse number="35" style="v" sid="LAM 3:35" />צו פֿאַרבײגן דעם משפּט פֿון אַ מאַן,</para>
  <para style="q" vid="LAM 3:35">איז דערװידער דעם פּנים פֿון דעם עליון;<verse eid="LAM 3:35" /></para>
  <para style="q">
    <verse number="36" style="v" sid="LAM 3:36" />צו קריװדען אַ מענטשן אין זײַן קריג,</para>
  <para style="q" vid="LAM 3:36">דאָס װיל אֲדֹנָי נישט זען.<verse eid="LAM 3:36" /></para>
  <para style="b" />
  <para style="q">
    <verse number="37" style="v" sid="LAM 3:37" />װער איז דער װאָס קען הײסן, און עס זאָל געשען,</para>
  <para style="q" vid="LAM 3:37">אַז אֲדֹנָי האָט נישט באַפֿױלן?<verse eid="LAM 3:37" /></para>
  <para style="q">
    <verse number="38" style="v" sid="LAM 3:38" />קומט נישט פֿון אױבערשטערס מױל אַרױס</para>
  <para style="q" vid="LAM 3:38">דאָס שלעכטס און דאָס גוטס?<verse eid="LAM 3:38" /></para>
  <para style="q">
    <verse number="39" style="v" sid="LAM 3:39" />װאָס קען זיך באַקלאָגן אַ לעבעדיקער מענטש?</para>
  <para style="q" vid="LAM 3:39">אַ מאַן בײַ אַלע זײַנע זינד?<verse eid="LAM 3:39" /></para>
  <para style="b" />
  <para style="q">
    <verse number="40" style="v" sid="LAM 3:40" />לאָמיר נאָכזוכן און פֿאָרשן אונדזערע װעגן,</para>
  <para style="q" vid="LAM 3:40">און לאָמיר זיך אומקערן צו ה׳.<verse eid="LAM 3:40" /></para>
  <para style="q">
    <verse number="41" style="v" sid="LAM 3:41" />לאָמיר אױפֿהײבן אונדזער האַרץ אױף די הענט</para>
  <para style="q" vid="LAM 3:41">צו אֵל אין הימל.<verse eid="LAM 3:41" /></para>
  <para style="q">
    <verse number="42" style="v" sid="LAM 3:42" />מיר האָבן פֿאַרבראָכן און װידערשפּעניקט;</para>
  <para style="q" vid="LAM 3:42">װילסט דו נישט פֿאַרגעבן?<verse eid="LAM 3:42" /></para>
  <para style="b" />
  <para style="q">
    <verse number="43" style="v" sid="LAM 3:43" />האָסט זיך באַדעקט מיט צאָרן, און אונדז נאָכגעיאָגט,</para>
  <para style="q" vid="LAM 3:43">האָסט געהרגעט אָן רחמנות;<verse eid="LAM 3:43" /></para>
  <para style="q">
    <verse number="44" style="v" sid="LAM 3:44" />האָסט זיך באַדעקט מיט אַ װאָלקן,</para>
  <para style="q" vid="LAM 3:44">אַז קײן תּפֿילה זאָל נישט דורכגײן.<verse eid="LAM 3:44" /></para>
  <para style="q">
    <verse number="45" style="v" sid="LAM 3:45" />קױט און מיסט האָסטו אונדז געמאַכט</para>
  <para style="q" vid="LAM 3:45">צװישן די פֿעלקער.<verse eid="LAM 3:45" /></para>
  <para style="b" />
  <para style="q">
    <verse number="46" style="v" sid="LAM 3:46" />געעפֿנט האָבן זײער מױל אױף אונדז</para>
  <para style="q" vid="LAM 3:46">אַלע אונדזערע שָׂונאים.<verse eid="LAM 3:46" /></para>
  <para style="q">
    <verse number="47" style="v" sid="LAM 3:47" />אַ גרױל און אַ גרוב איז געקומען אױף אונדז,</para>
  <para style="q" vid="LAM 3:47">אַ פֿאַרװיסטונג און אַ בראָך.<verse eid="LAM 3:47" /></para>
  <para style="q">
    <verse number="48" style="v" sid="LAM 3:48" />בעכן װאַסער טוט רינען מײַן אױג</para>
  <para style="q" vid="LAM 3:48">אױף דעם בראָך פֿון דער טאָכטער מײַן פֿאָלק.<verse eid="LAM 3:48" /></para>
  <para style="b" />
  <para style="q">
    <verse number="49" style="v" sid="LAM 3:49" />מײַן אױג גיסט, און װיל זיך נישט שטילן,</para>
  <para style="q" vid="LAM 3:49">אָן אַן אױפֿהער,<verse eid="LAM 3:49" /></para>
  <para style="q">
    <verse number="50" style="v" sid="LAM 3:50" />ביז ה׳ פֿון הימל װעט לוגן און זען.<verse eid="LAM 3:50" /></para>
  <para style="q">
    <verse number="51" style="v" sid="LAM 3:51" />מײַן אױג טוט װײ מײַן זעל,</para>
  <para style="q" vid="LAM 3:51">אום אַלע טעכטער פֿון מײַן שטאָט.<verse eid="LAM 3:51" /></para>
  <para style="b" />
  <para style="q">
    <verse number="52" style="v" sid="LAM 3:52" />יאָגן װי אַ פֿױגל האָבן מיך געיאָגט</para>
  <para style="q" vid="LAM 3:52">מײַנע אומזיסטיקע שָׂונאים.<verse eid="LAM 3:52" /></para>
  <para style="q">
    <verse number="53" style="v" sid="LAM 3:53" />זײ האָבן פֿאַרשניטן אין גרוב מײַן לעבן,</para>
  <para style="q" vid="LAM 3:53">און שטײנער האָבן זײ געװאָרפֿן אױף מיר.<verse eid="LAM 3:53" /></para>
  <para style="q">
    <verse number="54" style="v" sid="LAM 3:54" />װאַסערן האָבן געפֿלײצט אױף מײַן קאָפּ,</para>
  <para style="q" vid="LAM 3:54">איך האָב געזאָגט: איך בין אָפּגעשניטן.<verse eid="LAM 3:54" /></para>
  <para style="b" />
  <para style="q">
    <verse number="55" style="v" sid="LAM 3:55" />איך האָב גערופֿן דײַן נאָמען, ה׳,</para>
  <para style="q" vid="LAM 3:55">פֿון דער אונטערשטער גרוב.<verse eid="LAM 3:55" /></para>
  <para style="q">
    <verse number="56" style="v" sid="LAM 3:56" />האָסט געהערט מײַן קֹול,</para>
  <para style="q" vid="LAM 3:56">זאָלסטו נישט פֿאַרהױלן דײַן אױער פֿון מײַן זיפֿץ,</para>
  <para style="q" vid="LAM 3:56">פֿון מײַן געשרײ.<verse eid="LAM 3:56" /></para>
  <para style="q">
    <verse number="57" style="v" sid="LAM 3:57" />האָסט גענענט אין טאָג װאָס איך פֿלעג דיך רופֿן,</para>
  <para style="q" vid="LAM 3:57">האָסט געזאָגט: זאָלסט נישט מורא האָבן.<verse eid="LAM 3:57" /></para>
  <para style="b" />
  <para style="q">
    <verse number="58" style="v" sid="LAM 3:58" />האָסט זיך אָנגענומען, אֲדֹנָי, די קריג פֿון מײַן זעל,</para>
  <para style="q" vid="LAM 3:58">האָסט אױסגעלײזט מײַן לעבן.<verse eid="LAM 3:58" /></para>
  <para style="q">
    <verse number="59" style="v" sid="LAM 3:59" />האָסט געזען, ה׳, מײַן קריװדע,</para>
  <para style="q" vid="LAM 3:59">משפּט מײַן משפּט.<verse eid="LAM 3:59" /></para>
  <para style="q">
    <verse number="60" style="v" sid="LAM 3:60" />האָסט געזען זײער גאַנצע נקמה,</para>
  <para style="q" vid="LAM 3:60">אַלע זײערע מחשבֿות אױף מיר.<verse eid="LAM 3:60" /></para>
  <para style="b" />
  <para style="q">
    <verse number="61" style="v" sid="LAM 3:61" />האָסט געהערט זײער לעסטערונג, ה׳,</para>
  <para style="q" vid="LAM 3:61">אַלע זײערע מחשבֿות אַקעגן מיר;<verse eid="LAM 3:61" /></para>
  <para style="q">
    <verse number="62" style="v" sid="LAM 3:62" />די ליפּן פֿון מײַנע פֿײַנט</para>
  <para style="q" vid="LAM 3:62">און זײער טראַכטן אַקעגן מיר אַ גאַנצן טאָג.<verse eid="LAM 3:62" /></para>
  <para style="q">
    <verse number="63" style="v" sid="LAM 3:63" />זע זײער זיצן און זײער שטײן –</para>
  <para style="q" vid="LAM 3:63">איך בין זײער שפּאָטליד.<verse eid="LAM 3:63" /></para>
  <para style="b" />
  <para style="q">
    <verse number="64" style="v" sid="LAM 3:64" />זאָלסט זײ אומקערן, ה׳, אַ פֿאַרגעלטונג</para>
  <para style="q" vid="LAM 3:64">לױט די מעשׂים פֿון זײערע הענט.<verse eid="LAM 3:64" /></para>
  <para style="q">
    <verse number="65" style="v" sid="LAM 3:65" />זאָלסט זײ געבן האַרצדולעניש, דײַן קללה אױף זײ!<verse eid="LAM 3:65" /></para>
  <para style="q">
    <verse number="66" style="v" sid="LAM 3:66" />זאָלסט זײ יאָגן מיט צאָרן,</para>
  <para style="q" vid="LAM 3:66">און זײ פֿאַרטיליקן פֿון אונטער די הימלען פֿון ה׳.<verse eid="LAM 3:66" /></para>
  <chapter eid="LAM 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="LAM 4" />
  <para style="q">
    <verse number="1" style="v" sid="LAM 4:1" />װי איז פֿאַרטונקלט דאָס גאָלד,</para>
  <para style="q" vid="LAM 4:1">פֿאַרביטן דאָס טײַערע פֿײַנגאָלד;</para>
  <para style="q" vid="LAM 4:1">די הײליקע שטײנער צעשאָטן אין אַלע עק גאַסן!<verse eid="LAM 4:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="LAM 4:2" />די טײַערע קינדער פֿון צִיוֹן,</para>
  <para style="q" vid="LAM 4:2">מיט גינגאָלד געװױגן –</para>
  <para style="q" vid="LAM 4:2">װי זײַנען זײ גערעכנט פֿאַר לײמענע קריג,</para>
  <para style="q" vid="LAM 4:2">געמאַכט פֿון אַ טעפּערס הענט!<verse eid="LAM 4:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="LAM 4:3" />אַפֿילו שאַקאַלן ציען אױס די ברוסט,</para>
  <para style="q" vid="LAM 4:3">גיבן זױגן זײערע יונגע,</para>
  <para style="q" vid="LAM 4:3">די טאָכטער מײַן פֿאָלק איז אַן אַכזר געװאָרן,</para>
  <para style="q" vid="LAM 4:3">אַזױ װי שטרױספֿױגלען אין דער מדבר.<verse eid="LAM 4:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" sid="LAM 4:4" />די צונג פֿון דעם זױגעדיקן איז צוגעקלעפּט</para>
  <para style="q" vid="LAM 4:4">צו זײַן גומען פֿון דאָרשטיקײט;</para>
  <para style="q" vid="LAM 4:4">קלײנע קינדער בעטן ברױט,</para>
  <para style="q" vid="LAM 4:4">און קײנער ברעכט זײ נישט אָפּ.<verse eid="LAM 4:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="LAM 4:5" />די װאָס פֿלעגן עסן טײַערע שפּײַזן,</para>
  <para style="q" vid="LAM 4:5">זײַנען װיסט אין די גאַסן;</para>
  <para style="q" vid="LAM 4:5">די דערצױגענע אין װערמילרױט</para>
  <para style="q" vid="LAM 4:5">טוליען זיך צו מיסטהױפֿנס.<verse eid="LAM 4:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="LAM 4:6" />װאָרעם די זינד פֿון דער טאָכטער מײַן פֿאָלק</para>
  <para style="q" vid="LAM 4:6">איז גרעסער װי דער חטא פֿון סדוֹם,</para>
  <para style="q" vid="LAM 4:6">װאָס איז איבערגעקערט געװאָרן װי אין אַ רגע,</para>
  <para style="q" vid="LAM 4:6">און קײן הענט זענען נישט געפֿאַלן אױף איר.<verse eid="LAM 4:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="LAM 4:7" />אירע פֿירשטן זײַנען געװען לױטערער פֿון שנײ,</para>
  <para style="q" vid="LAM 4:7">װײַסער פֿון מילך,</para>
  <para style="q" vid="LAM 4:7">גערױטלטער אױפֿן לײַב פֿון קאַרעלן;</para>
  <para style="q" vid="LAM 4:7">סאַפּירשטײן זײער געשטאַלט.<verse eid="LAM 4:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="LAM 4:8" />פֿינצטערער פֿון קױל איז זײער אױסזען,</para>
  <para style="q" vid="LAM 4:8">זײ זײַנען נישט צו דערקענען אױף דער גאַס;</para>
  <para style="q" vid="LAM 4:8">זײער הױט איז צוגעקלעפּט צו זײערע בײנער,</para>
  <para style="q" vid="LAM 4:8">אײַנגעדאַרט װי האָלץ איז זי געװאָרן.<verse eid="LAM 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="LAM 4:9" />בעסער איז די דערשלאָגענע פֿון שװערד,</para>
  <para style="q" vid="LAM 4:9">װי די דערשלאָגענע פֿון הונגער,</para>
  <para style="q" vid="LAM 4:9">װאָס זײ גײען אױס דורכגענומענע,</para>
  <para style="q" vid="LAM 4:9">אָן אַ פֿרוכט פֿון פֿעלד.<verse eid="LAM 4:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="LAM 4:10" />די הענט פֿון דערבאַרעמדיקע מוטערס</para>
  <para style="q" vid="LAM 4:10">האָבן געקאָכט זײערע קינדער;</para>
  <para style="q" vid="LAM 4:10">זײ זײַנען זײ צום שפּײַז געװען,</para>
  <para style="q" vid="LAM 4:10">אין דעם בראָך פֿון דער טאָכטער מײַן פֿאָלק.<verse eid="LAM 4:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="LAM 4:11" />ה׳ האָט אױסגעלאָזט זײַן כּעס,</para>
  <para style="q" vid="LAM 4:11">אױסגעגאָסן זײַן גרימצאָרן;</para>
  <para style="q" vid="LAM 4:11">און ער האָט אָנגעצונדן אַ פֿײַער אין צִיוֹן,</para>
  <para style="q" vid="LAM 4:11">און עס האָט פֿאַרצערט אירע גרונטפֿעסטן.<verse eid="LAM 4:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="LAM 4:12" />נישט געגלױבט האָבן די מלכים פֿון דער ערד,</para>
  <para style="q" vid="LAM 4:12">און אַלע באַװױנער פֿון דער װעלט,</para>
  <para style="q" vid="LAM 4:12">אַז אַ דריקער און אַ שׂונא װעט קומען</para>
  <para style="q" vid="LAM 4:12">אין די טױערן פֿון ירושָלַיִם;<verse eid="LAM 4:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="LAM 4:13" />פֿון װעגן די זינד פֿון אירע נבֿיאים,</para>
  <para style="q" vid="LAM 4:13">די פֿאַרברעכן פֿון אירע כּהנים,</para>
  <para style="q" vid="LAM 4:13">װאָס האָבן בלוט פֿון גערעכטע</para>
  <para style="q" vid="LAM 4:13">פֿאַרגאָסן אין איר.<verse eid="LAM 4:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="LAM 4:14" />זײ װאָגלען װי בלינדע אין די גאַסן,</para>
  <para style="q" vid="LAM 4:14">זײ זײַנען אײַנגעריכט אין בלוט,</para>
  <para style="q" vid="LAM 4:14">ביז מע קען זיך נישט אָנרירן אָן די קלײדער זײערע.<verse eid="LAM 4:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="LAM 4:15" />קערט אײַך אָפּ! טמא!</para>
  <para style="q" vid="LAM 4:15">רופֿט מען צו זײ,</para>
  <para style="q" vid="LAM 4:15">קערט אײַך אָפּ! קערט אײַך אָפּ! איר זאָלט זיך נישט אָנרירן!</para>
  <para style="q" vid="LAM 4:15">בעת זײ פֿליען און װאָגלען; מע זאָגט צװישן די פֿעלקער:</para>
  <para style="q" vid="LAM 4:15">זײ טאָרן זיך מער נישט אױפֿהאַלטן.<verse eid="LAM 4:15" /></para>
  <para style="b" />
  <para style="q">
    <verse number="16" style="v" sid="LAM 4:16" />דער צאָרן פֿון ה׳ האָט זײ צעטײלט,</para>
  <para style="q" vid="LAM 4:16">ער װיל זײ מער נישט אָנקוקן;</para>
  <para style="q" vid="LAM 4:16">כּהנים האָט מען נישט געשױנט,</para>
  <para style="q" vid="LAM 4:16">זקנים האָט מען נישט געלײַטזעליקט.<verse eid="LAM 4:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="LAM 4:17" />אונדזערע אױגן גײען נאָך אַלץ אױס</para>
  <para style="q" vid="LAM 4:17">נאָך אונדזער נישטיקער הילף;</para>
  <para style="q" vid="LAM 4:17">אין אונדזער אױסקוק האָבן מיר אױסגעקוקט</para>
  <para style="q" vid="LAM 4:17">אױף אַ פֿאָלק װאָס קען נישט העלפֿן.<verse eid="LAM 4:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="LAM 4:18" />מע שפּירט נאָך אונדזערע טריט,</para>
  <para style="q" vid="LAM 4:18">אַז מיר קענען נישט גײן אױף אונדזערע גאַסן;</para>
  <para style="q" vid="LAM 4:18">נאָנט איז אונדזער סוף, פֿול זײַנען אונדזערע טעג;</para>
  <para style="q" vid="LAM 4:18">יאָ, געקומען איז אונדזער סוף.<verse eid="LAM 4:18" /></para>
  <para style="b" />
  <para style="q">
    <verse number="19" style="v" sid="LAM 4:19" />פֿלינקער זײַנען אונדזערע נאָכיאָגער</para>
  <para style="q" vid="LAM 4:19">װי די אָדלערס פֿון הימל;</para>
  <para style="q" vid="LAM 4:19">אױף די בערג האָבן זײ אונדז געיאָגט,</para>
  <para style="q" vid="LAM 4:19">אין מדבר האָבן זײ געלױערט אױף אונדז.<verse eid="LAM 4:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="LAM 4:20" />דער אָטעם פֿון אונדזער נאָז, דער געזאַלבטער פֿון ה׳,</para>
  <para style="q" vid="LAM 4:20">איז געפֿאַנגען געװאָרן אין זײערע גריבער;</para>
  <para style="q" vid="LAM 4:20">דער, װאָס מיר האָבן געזאָגט: אין זײַן שאָטן</para>
  <para style="q" vid="LAM 4:20">װעלן מיר לעבן צװישן די פֿעלקער.<verse eid="LAM 4:20" /></para>
  <para style="b" />
  <para style="q">
    <verse number="21" style="v" sid="LAM 4:21" />קװעל אָן און פֿרײ זיך, טאָכטער אֶדוֹם,</para>
  <para style="q" vid="LAM 4:21">דו װאָס װױנסט אין לאַנד עוץ;</para>
  <para style="q" vid="LAM 4:21">צו דיר אױך װעט אַריבער דער כָּוס,</para>
  <para style="q" vid="LAM 4:21">װעסט שיכּור װערן, און זיך אָפּדעקן.<verse eid="LAM 4:21" /></para>
  <para style="b" />
  <para style="q">
    <verse number="22" style="v" sid="LAM 4:22" />געענדיקט איז דײַן זינד, טאָכטער צִיוֹן,</para>
  <para style="q" vid="LAM 4:22">ער װעט דיך מער נישט פֿאַרטרײַבן;</para>
  <para style="q" vid="LAM 4:22">ער װעט דערמאָנען דײַן פֿאַרברעך, טאָכטער אֶדוֹם,</para>
  <para style="q" vid="LAM 4:22">ער װעט אַנטפּלעקן דײַנע זינד.<verse eid="LAM 4:22" /></para>
  <chapter eid="LAM 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="LAM 5" />
  <para style="q">
    <verse number="1" style="v" sid="LAM 5:1" />געדענק, ה׳, װאָס איז געשען צו אונדז,</para>
  <para style="q" vid="LAM 5:1">קוק און זע אונדזער שאַנד.<verse eid="LAM 5:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="LAM 5:2" />אונדזער נחלה איז איבערגעגאַנגען צו פֿרעמדע,</para>
  <para style="q" vid="LAM 5:2">אונדזערע הײַזער צו אַנדערע.<verse eid="LAM 5:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="LAM 5:3" />מיר זײַנען יתומים געװאָרן אָן אַ פֿאָטער,</para>
  <para style="q" vid="LAM 5:3">אונדזערע מוטערס װי אַלמנות.<verse eid="LAM 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="LAM 5:4" />אונדזער װאַסער טרינקען מיר פֿאַר געלט,</para>
  <para style="q" vid="LAM 5:4">אונדזער האָלץ קומט אונדז אָן פֿאַר געצאָלט.<verse eid="LAM 5:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="LAM 5:5" />אױף אונדזער נאַקן װערן מיר געיאָגט,</para>
  <para style="q" vid="LAM 5:5">מיר זײַנען מיד, און אונדז װערט נישט באַרוט.<verse eid="LAM 5:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="LAM 5:6" />צו מִצרַיִם האָבן מיר אַ האַנט אױסגעשטרעקט,</para>
  <para style="q" vid="LAM 5:6">צו אשור – זיך מיט ברױט צו זעטן.<verse eid="LAM 5:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="LAM 5:7" />אונדזערע עלטערן האָבן געזינדיקט, און זײַנען מער נישטאָ,</para>
  <para style="q" vid="LAM 5:7">און מיר טראָגן זײערע פֿאַרברעכן.<verse eid="LAM 5:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="LAM 5:8" />קנעכט געװעלטיקן איבער אונדז,</para>
  <para style="q" vid="LAM 5:8">נישטאָ קײן אױסלײזער פֿון זײער האַנט.<verse eid="LAM 5:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="LAM 5:9" />מיט אונדזער לעבן קריגן מיר אונדזער ברױט,</para>
  <para style="q" vid="LAM 5:9">פֿון װעגן דער שװערד פֿון מדבר.<verse eid="LAM 5:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="LAM 5:10" />אונדזער הױט גליט װי אַן אױװן,</para>
  <para style="q" vid="LAM 5:10">פֿון װעגן די ברענונגען פֿון הונגער.<verse eid="LAM 5:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="LAM 5:11" />װײַבער האָט מען געפּײַניקט אין צִיוֹן,</para>
  <para style="q" vid="LAM 5:11">יונגפֿרױען אין די שטעט פֿון יהוּדה.<verse eid="LAM 5:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="LAM 5:12" />האַרן זײַנען געהאַנגען געװאָרן פֿון זײער האַנט;</para>
  <para style="q" vid="LAM 5:12">פּנימער פֿון זקנים זײַנען נישט געשױנט געװאָרן.<verse eid="LAM 5:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="LAM 5:13" />יונגעלײַט האָבן מילשטײנער געטראָגן,</para>
  <para style="q" vid="LAM 5:13">און ייִנגלעך האָבן אונטער האָלץ געשטרױכלט.<verse eid="LAM 5:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="LAM 5:14" />זקנים האָבן פֿון טױער אױפֿגעהערט,</para>
  <para style="q" vid="LAM 5:14">יונגעלײַט פֿון זײער געזאַנג.<verse eid="LAM 5:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="LAM 5:15" />אױפֿגעהערט האָט די פֿרײד פֿון אונדזער האַרצן,</para>
  <para style="q" vid="LAM 5:15">פֿאַרקערט איז אין טרױער אונדזער טאַנץ.<verse eid="LAM 5:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="LAM 5:16" />געפֿאַלן איז די קרױן פֿון אונדזער קאָפּ;</para>
  <para style="q" vid="LAM 5:16">װײ אונדז! װאָרעם מיר האָבן געזינדיקט.<verse eid="LAM 5:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="LAM 5:17" />דערפֿאַר איז קראַנק אונדזער האַרץ,</para>
  <para style="q" vid="LAM 5:17">איבער דעם זײַנען פֿינצטער אונדזערע אױגן:<verse eid="LAM 5:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="LAM 5:18" />איבער דעם באַרג צִיוֹן װאָס איז װיסט –</para>
  <para style="q" vid="LAM 5:18">פֿיקס גײען אום אױף אים.<verse eid="LAM 5:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="LAM 5:19" />דו, ה׳, טראָנסט אײביק,</para>
  <para style="q" vid="LAM 5:19">דײַן טראָן איז אױף דור-דורות,<verse eid="LAM 5:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="LAM 5:20" />פֿאַר װאָס פֿאַרגעסטו אונדז אױף שטענדיק,</para>
  <para style="q" vid="LAM 5:20">פֿאַרלאָזט אונדז אױף לאַנגע טעג?<verse eid="LAM 5:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="LAM 5:21" />קער אונדז אום צו דיר, ה׳,</para>
  <para style="q" vid="LAM 5:21">און לאָמיר זיך אומקערן;</para>
  <para style="q" vid="LAM 5:21">באַנײַ אונדזערע טעג װי אַמאָל;<verse eid="LAM 5:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="LAM 5:22" />װאָרעם אױב פֿאַראַכטן האָסטו אונדז פֿאַראַכט,</para>
  <para style="q" vid="LAM 5:22">האָסטו אָבער געצערנט אױף אונדז ביז גאָר.<verse eid="LAM 5:22" /></para>
  <para style="b" />
  <chapter eid="LAM 5" />
</usx>