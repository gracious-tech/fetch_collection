<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="NAM" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">נַחום</para>
  <para style="toc2">נַחום</para>
  <para style="toc1">נַחום</para>
  <para style="mt1">נַחום</para>
  <chapter number="1" style="c" pubnumber="א" sid="NAM 1" />
  <para style="p">
    <verse number="1" style="v" sid="NAM 1:1" />די נבֿואה אױף נינוֵה; דאָס בוך פֿון דער זעונג פֿון נַחום דעם אֶלקוֹשי.<verse eid="NAM 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="NAM 1:2" />אַ ג-ט אַן אֵל קַנֹּוא און אַ ראַכענעמער איז ה׳,</para>
  <para style="q" vid="NAM 1:2">ה׳ איז אַ ראַכענעמער און פֿול מיט גרימצאָרן,</para>
  <para style="q" vid="NAM 1:2">ה׳ איז זיך נוקם אָן זײַנע פֿײַנט,</para>
  <para style="q" vid="NAM 1:2">און ער האַלט דעם כּעס צו זײַנע שָׂונאים.<verse eid="NAM 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 1:3" />ה׳ איז אײַנגעהאַלטן אין צאָרן,</para>
  <para style="q" vid="NAM 1:3">און גרױס אין מאַכט,</para>
  <para style="q" vid="NAM 1:3">ער לאָזט נישט פֿרײַ, ער װעט זיכער נישט לאָזן די שולדיקע אומבאַשטראָפֿט.</para>
  <para style="q" vid="NAM 1:3">ה׳ – מיט װינט און מיט שטורעם איז זײַן װעג,</para>
  <para style="q" vid="NAM 1:3">און װאָלקן דער שטױב פֿון זײַנע פֿיס.<verse eid="NAM 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 1:4" />ער שרײַט אָן אױפֿן ים, און טריקנט אים אױס,</para>
  <para style="q" vid="NAM 1:4">און אַלע טײַכן מאַכט ער טרוקן;</para>
  <para style="q" vid="NAM 1:4">פֿאַרװעלקט װערט דער בָשָן און כַּרמֶל,</para>
  <para style="q" vid="NAM 1:4">און די בליִונג פֿון לבֿנוֹן װערט פֿאַרװעלקט.<verse eid="NAM 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="NAM 1:5" />די בערג ציטערן פֿאַר אים,</para>
  <para style="q" vid="NAM 1:5">און די טאָלן טוען זיך װאַקלען,</para>
  <para style="q" vid="NAM 1:5">און די ערד װערט אױפֿגעטרײסלט פֿון זײַן פּנים,</para>
  <para style="q" vid="NAM 1:5">אי די װעלט אי אַלע װױנער אין איר.<verse eid="NAM 1:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="NAM 1:6" />פֿאַר זײַן כּעס װער קען זיך שטעלן?</para>
  <para style="q" vid="NAM 1:6">און װער קען באַשטײן אין זײַן גרימצאָרן?</para>
  <para style="q" vid="NAM 1:6">זײַן צאָרן גיסט זיך אױס װי פֿײַער,</para>
  <para style="q" vid="NAM 1:6">און די פֿעלדזן װערן צעשטױסן פֿאַר אים.<verse eid="NAM 1:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 1:7" />גוט איז ה׳,</para>
  <para style="q" vid="NAM 1:7">פֿאַר אַ פֿעסטונג אין טאָג פֿון נױט;</para>
  <para style="q" vid="NAM 1:7">און ער װײס די װאָס שיצן זיך אין אים.<verse eid="NAM 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="NAM 1:8" />אָבער מיט אַ שטראָמיקער פֿלײצונג</para>
  <para style="q" vid="NAM 1:8">װעט ער מאַכן אַ פֿאַרלענדונג פֿון איר אָרט,</para>
  <para style="q" vid="NAM 1:8">און זײַנע פֿײַנט װעט נאָכיאָגן פֿינצטערניש.<verse eid="NAM 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 1:9" />װאָס טראַכט איר אַקעגן ה׳?</para>
  <para style="q" vid="NAM 1:9">אַ פֿאַרלענדונג װעט ער מאַכן,</para>
  <para style="q" vid="NAM 1:9">די צרה װעט נישט אױפֿשטײן אַ צװײט מאָל.<verse eid="NAM 1:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 1:10" />װאָרעם בעת זײ זײַנען װי דערנער אײַנגעפֿלאָכטענע,</para>
  <para style="q" vid="NAM 1:10">און װי זײ שיכּורן פֿאַרשיכּורטע,</para>
  <para style="q" vid="NAM 1:10">װעלן זײ אין גאַנצן פֿאַרצערט װערן װי טרוקענע שטרױ.<verse eid="NAM 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 1:11" />פֿון דיר איז אַרױסגעקומען</para>
  <para style="q" vid="NAM 1:11">דער װאָס טראַכט בײז אַקעגן ה׳,</para>
  <para style="q" vid="NAM 1:11">װאָס באַראָט נידערטרעכטיקײט.<verse eid="NAM 1:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="NAM 1:12" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="q" vid="NAM 1:12">װי געזונט און אַזױ פֿיל װי זײ זײַנען,</para>
  <para style="q" vid="NAM 1:12">אַזױ װעלן זײ פֿאַרשניטן װערן און פֿאַרגײן;</para>
  <para style="q" vid="NAM 1:12">הגם איך האָב דיך געפּײַניקט,</para>
  <para style="q" vid="NAM 1:12">װעל איך מער דיך נישט פּײַניקן.<verse eid="NAM 1:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 1:13" />און אַצונד װעל איך צעברעכן זײַן יאָכשטאַנג פֿון דיר,</para>
  <para style="q" vid="NAM 1:13">און דײַנע בינדשטריק װעל איך צערײַסן.<verse eid="NAM 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="NAM 1:14" />און ה׳ האָט באַפֿױלן װעגן דיר,</para>
  <para style="q" vid="NAM 1:14">אַז פֿון דײַן נאָמען זאָל מער קײן זאָמען נישט זײַן;</para>
  <para style="q" vid="NAM 1:14">פֿון הױז פֿון דײַן ג‑טס װעל איך פֿאַרשנײַדן</para>
  <para style="q" vid="NAM 1:14">געשניצטע און געגאָסענע ג‑צן;</para>
  <para style="q" vid="NAM 1:14">איך װעל דיר אַ קבֿר מאַכן,</para>
  <para style="q" vid="NAM 1:14">װײַל דו ביסט צו שאַנד געװאָרן.<verse eid="NAM 1:14" /></para>
  <chapter eid="NAM 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="NAM 2" />
  <para style="q">
    <verse number="1" style="v" pubnumber="1.15" sid="NAM 2:1" /> זע אױף די בערג די פֿיס פֿון דעם מבֿשׂר</para>
  <para style="q" vid="NAM 2:1">װאָס מאַכט הערן שלום!</para>
  <para style="q" vid="NAM 2:1">פֿײַער, יהוּדה, דײַנע פֿײַערטעג,</para>
  <para style="q" vid="NAM 2:1">באַצאָל דײַנע נדרים,</para>
  <para style="q" vid="NAM 2:1">װאָרעם מער װעט נישט דורכגײן אין דיר דער נידערטרעכטיקער,</para>
  <para style="q" vid="NAM 2:1">ער איז אין גאַנצן פֿאַרשניטן.<verse eid="NAM 2:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" pubnumber="2.1" sid="NAM 2:2" /> אַ צעברעכער גײט אַרױף אַקעגן דיר;</para>
  <para style="q" vid="NAM 2:2">היט די פֿעסטונג. קוק אױס אױפֿן װעג,</para>
  <para style="q" vid="NAM 2:2">פֿעסטיק די לענדן, שטאַרק זײער דײַן כּוֹח. –<verse eid="NAM 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" pubnumber="2.2" sid="NAM 2:3" /> װאָרעם ה׳ קערט אום דעם שטאָלץ פֿון יעקבֿ</para>
  <para style="q" vid="NAM 2:3">װי דעם שטאָלץ פֿון יִשׂרָאֵל;</para>
  <para style="q" vid="NAM 2:3">װאָרעם אױסלײדיקער האָבן זײ אױסגעלײדיקט,</para>
  <para style="q" vid="NAM 2:3">און זײערע צװײַגן פֿאַרדאָרבן.<verse eid="NAM 2:3" /></para>
  <para style="b" />
  <para style="q">
    <verse number="4" style="v" pubnumber="3" sid="NAM 2:4" /> דער שילד פֿון זײַנע גיבוֹרים איז גערױטיקט,</para>
  <para style="q" vid="NAM 2:4">די קריגסלײַט אין װערמילפֿאַרב,</para>
  <para style="q" vid="NAM 2:4">אין פֿײַערדיקן שטאָל די רײַטװעגן,</para>
  <para style="q" vid="NAM 2:4">אין טאָג פֿון זײער צוגרײטונג;</para>
  <para style="q" vid="NAM 2:4">און די ציפּרעסשפּיזן װערן געפֿאָכט.<verse eid="NAM 2:4" /></para>
  <para style="q">
    <verse number="5" style="v" pubnumber="4" sid="NAM 2:5" /> דורך די גאַסן װילדעװען די רײַטװעגן,</para>
  <para style="q" vid="NAM 2:5">זײ שטורעמען דורך די מערק,</para>
  <para style="q" vid="NAM 2:5">זײער אָנבליק איז װי פֿלאַמען,</para>
  <para style="q" vid="NAM 2:5">װי די בליצן לױפֿן זײ אום.<verse eid="NAM 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" altnumber="5" sid="NAM 2:6" /> ער טראַכט אָן זײַנע מאַכטיקע,</para>
  <para style="q" vid="NAM 2:6">אָבער זײ װערן געשטרױכלט אין זײער גאַנג;</para>
  <para style="q" vid="NAM 2:6">מע אײַלט צו דער מױער,</para>
  <para style="q" vid="NAM 2:6">און צוגעגרײט װערט דער שירעמדאַך.<verse eid="NAM 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" altnumber="6" sid="NAM 2:7" /> די טױערן פֿון די טײַכן זײַנען געעפֿנט,</para>
  <para style="q" vid="NAM 2:7">און דער פּאַלאַץ װערט צערונען.<verse eid="NAM 2:7" /></para>
  <para style="q">
    <verse number="8" style="v" altnumber="7" sid="NAM 2:8" /> און די מלכּה װערט אַן אָפּגעדעקטע אַװעקגענומען,</para>
  <para style="q" vid="NAM 2:8">און אירע דינסטן קלאָגן אַזױ װי דער קֹול פֿון טױבן,</para>
  <para style="q" vid="NAM 2:8">זיך קלאַפּנדיק אױף די הערצער.<verse eid="NAM 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" altnumber="8" sid="NAM 2:9" /> און נינוֵה איז װי אַ טײַך װאַסער</para>
  <para style="q" vid="NAM 2:9">פֿון זינט די טעג װאָס זי איז;</para>
  <para style="q" vid="NAM 2:9">אָבער זײ אַנטלױפֿן: שטײט! שטײט!</para>
  <para style="q" vid="NAM 2:9">אָבער קײנער קערט זיך נישט אום.<verse eid="NAM 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" altnumber="9" sid="NAM 2:10" /> רױבט זילבער, רױבט גאָלד,</para>
  <para style="q" vid="NAM 2:10">נישטאָ קײן שיעור צו דעם אױסשטאַט,</para>
  <para style="q" vid="NAM 2:10">אַ רײַכטום פֿון אַלע גלוסטיקע זאַכן.<verse eid="NAM 2:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" altnumber="10" sid="NAM 2:11" /> זי װערט פּוסט און װיסט און פֿאַרװיסט,</para>
  <para style="q" vid="NAM 2:11">און דאָס האַרץ װערט צעגאַנגען,</para>
  <para style="q" vid="NAM 2:11">און אַ װאַקלעניש פֿון קני,</para>
  <para style="q" vid="NAM 2:11">און אַ ציטערניש אין אַלע לענדן;</para>
  <para style="q" vid="NAM 2:11">און זײערע אַלעמענס פּנימער נעמען אָן אַ פֿינצטערניש.<verse eid="NAM 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" altnumber="11" sid="NAM 2:12" /> װוּ איז די װױנונג פֿון די לײבן,</para>
  <para style="q" vid="NAM 2:12">װאָס איז געװען דער פֿיטערפּלאַץ פֿאַר יונגלײבן,</para>
  <para style="q" vid="NAM 2:12">װאָס דאָרטן איז אומגעגאַנגען דער לײב, די לײבינטע,</para>
  <para style="q" vid="NAM 2:12">דאָס קלײנע לײבל, און קײנער האָט נישט געשראָקן?<verse eid="NAM 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" altnumber="12" sid="NAM 2:13" /> דער לײב פֿלעגט פֿאַרצוקן גענוג פֿאַר זײַנע יונגע,</para>
  <para style="q" vid="NAM 2:13">און װערגן פֿאַר זײַנע לײבינטעס,</para>
  <para style="q" vid="NAM 2:13">און האָט אָנגעפֿילט מיט פֿאַרצוקונג זײַנע לעכער,</para>
  <para style="q" vid="NAM 2:13">און זײַנע װױנונגען מיט פֿאַרצוקטע.<verse eid="NAM 2:13" /></para>
  <para style="b" />
  <para style="p">
    <verse number="14" style="v" altnumber="13" sid="NAM 2:14" /> זע, איך װעל קומען אױף דיר, זאָגט ה׳ צבָֿאוֹת, און איך װעל פֿאַרברענען אױף רױך אירע רײַטװעגן, און דײַנע יונגלײבן װעט פֿאַרצערן די שװערד; און איך װעל פֿאַרשנײַדן פֿון דער ערד דײַן רױב, און מער װעט נישט געהערט װערן דער קֹול פֿון דײַנע שלוחים.<verse eid="NAM 2:14" /></para>
  <chapter eid="NAM 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="NAM 3" />
  <para style="q">
    <verse number="1" style="v" sid="NAM 3:1" />װײ די בלוטיקע שטאָט,</para>
  <para style="q" vid="NAM 3:1">אין גאַנצן מיט פֿאַלשקײט, מיט רױב, אָנגעפֿילט!</para>
  <para style="q" vid="NAM 3:1">עס טוט זיך נישט אָפּ די פֿאַרצוקונג.<verse eid="NAM 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="NAM 3:2" />אַ קנאַל פֿון בײַטשן,</para>
  <para style="q" vid="NAM 3:2">און אַ רַעַש-געפּילדער פֿון רעדער,</para>
  <para style="q" vid="NAM 3:2">און פֿערד יאָגן,</para>
  <para style="q" vid="NAM 3:2">און רײַטװעגן שפּרינגען;<verse eid="NAM 3:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="NAM 3:3" />רײַטער שטורעמען אַרױף,</para>
  <para style="q" vid="NAM 3:3">און פֿלאַם פֿון שװערד, און בליץ פֿון שפּיז,</para>
  <para style="q" vid="NAM 3:3">און אַ סך דערשלאָגענע, און אַ הױפֿן פּגרים,</para>
  <para style="q" vid="NAM 3:3">און אָן שיעור טױטע לײַבער;</para>
  <para style="q" vid="NAM 3:3">און זײ שטרױכלען אָן זײערע טױטע לײַבער.<verse eid="NAM 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="NAM 3:4" />פֿון װעגן די פֿיל זנותן פֿון דער װױל-חנעװדיקער זוֹנה,</para>
  <para style="q" vid="NAM 3:4">דער מײַנסטערין פֿון כּישוף,</para>
  <para style="q" vid="NAM 3:4">װאָס פֿאַרקױפֿט פֿעלקער מיט אירע זנותן,</para>
  <para style="q" vid="NAM 3:4">און משפּחות מיט אירע כּישופֿן.<verse eid="NAM 3:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="NAM 3:5" />זע, איך קום צו דיר, זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="NAM 3:5">און איך װעל אױפֿדעקן דײַנע ברעגן אױף דײַן פּנים,</para>
  <para style="q" vid="NAM 3:5">און װעל װײַזן די פֿעלקער דײַן נאַקעטקײט,</para>
  <para style="q" vid="NAM 3:5">און די קיניגרײַכן דײַן שאַנד.<verse eid="NAM 3:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="NAM 3:6" />און איך װעל אַרױפֿװאַרפֿן אױף דיר אומװערדיקײטן,</para>
  <para style="q" vid="NAM 3:6">און װעל דיך פֿאַרמיױסן, און דיך מאַכן װי מיסט.<verse eid="NAM 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="NAM 3:7" />און עס װעט זײַן, אַלע װאָס זעען דיך,</para>
  <para style="q" vid="NAM 3:7">װעלן װײַכן פֿון דיר, און זאָגן:</para>
  <para style="q" vid="NAM 3:7">פֿאַרװיסט געװאָרן איז נינוֵה; װער קען זי באַקלאָגן?</para>
  <para style="q" vid="NAM 3:7">פֿון װאַנען זאָל איך זוכן טרײסטער פֿאַר דיר?<verse eid="NAM 3:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="NAM 3:8" />ביסטו דען בעסער פֿון נוֹא-אָמוֹן,</para>
  <para style="q" vid="NAM 3:8">װאָס איז געזעסן צװישן טײַכן, מיט װאַסער אַרום איר;</para>
  <para style="q" vid="NAM 3:8">װאָס איר פֿעסטונג איז געװען דער ים,</para>
  <para style="q" vid="NAM 3:8">פֿון ים איז געװען איר מױער?<verse eid="NAM 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="NAM 3:9" />כּוּש איז געװען אַ שטאַרקײט, און מִצרַיִם אָן שיעור,</para>
  <para style="q" vid="NAM 3:9">פּוּט און לובֿים זײַנען געװען דיר צו הילף.<verse eid="NAM 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="NAM 3:10" />אָבער אױך זי איז אין גלות,</para>
  <para style="q" vid="NAM 3:10">אין געפֿאַנגענשאַפֿט איז זי געגאַנגען;</para>
  <para style="q" vid="NAM 3:10">אױך אירע קלײנע קינדער זײַנען צעהאַקט געװאָרן</para>
  <para style="q" vid="NAM 3:10">אין אַלע עק גאַסן;</para>
  <para style="q" vid="NAM 3:10">און אױף אירע נִכבדים האָט מען גורל געװאָרפֿן,</para>
  <para style="q" vid="NAM 3:10">און אַלע אירע גרױסע לײַט זײַנען אין קײטן געשמידט געװאָרן.<verse eid="NAM 3:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="NAM 3:11" />דו אױך װעסט שיכּור װערן, װעסט זײַן אַ געחלשטע,</para>
  <para style="q" vid="NAM 3:11">דו אױך װעסט זוכן אַ באַשיצונג פֿון פֿײַנט.<verse eid="NAM 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="NAM 3:12" />אַלע דײַנע פֿעסטונגען װעלן זײַן װי פֿײַגנבײמער מיט ערשטפֿײַגן:</para>
  <para style="q" vid="NAM 3:12">װאָס אַז זײ װערן געטרײסלט,</para>
  <para style="q" vid="NAM 3:12">פֿאַלן זײ דעם עסער אין מױל.<verse eid="NAM 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="NAM 3:13" />זע, דײַן פֿאָלק אין דיר זײַנען װײַבער,</para>
  <para style="q" vid="NAM 3:13">אָפֿן געעפֿנט געװאָרן פֿאַר דײַנע פֿײַנט</para>
  <para style="q" vid="NAM 3:13">זײַנען די טױערן פֿון דײַן לאַנד,</para>
  <para style="q" vid="NAM 3:13">פֿאַרצערט האָט אַ פֿײַער דײַנע ריגלען.<verse eid="NAM 3:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="NAM 3:14" />װאַסער פֿאַר באַלעגערונג שעפּ דיר אָן,</para>
  <para style="q" vid="NAM 3:14">פֿאַרשטאַרק דײַנע פֿעסטונגען,</para>
  <para style="q" vid="NAM 3:14">גײ אין לײם און טרעט װאַפּנע,</para>
  <para style="q" vid="NAM 3:14">נעם אָן די ציגלפֿורעם.<verse eid="NAM 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="NAM 3:15" />דענצמאָל װעט דיך אַ פֿײַער פֿאַרצערן,</para>
  <para style="q" vid="NAM 3:15">אַ שװערד װעט דיך פֿאַרשנײַדן;</para>
  <para style="q" vid="NAM 3:15">זי װעט דיך אױפֿעסן װי דער הײשעריק;</para>
  <para style="q" vid="NAM 3:15">מעגסט זיך מערן װי דער הײשעריק,</para>
  <para style="q" vid="NAM 3:15">מעגסט זיך מערן װי דער גריל.<verse eid="NAM 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="NAM 3:16" />האָסט געמערט דײַנע האַנדלסלײַט מײַן פֿון די שטערן פֿון הימל –</para>
  <para style="q" vid="NAM 3:16">האָט דער הײשעריק זיך אױסגעשפּרײט און איז אַװעקגעפֿלױגן.<verse eid="NAM 3:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="NAM 3:17" />דײַנע געקרױנטע זײַנען װי גרילן,</para>
  <para style="q" vid="NAM 3:17">און דײַנע קאָמאַנדיר װי אַ מחנה הײשעריקן,</para>
  <para style="q" vid="NAM 3:17">װאָס לאַגערן אױף די פּלױטן אין אַ קאַלטן טאָג;</para>
  <para style="q" vid="NAM 3:17">גײט אױף די זון, אַזױ פֿליען זײ אַװעק,</para>
  <para style="q" vid="NAM 3:17">און מע װײסט נישט זײער אָרט װוּ זײ זײַנען.<verse eid="NAM 3:17" /></para>
  <para style="b" />
  <para style="q">
    <verse number="18" style="v" sid="NAM 3:18" />אײַנגעשלאָפֿן זײַנען דײַנע פּאַסטוכער, מלך פֿון אשור,</para>
  <para style="q" vid="NAM 3:18">עס רוען דײַנע מאַכטיקע,</para>
  <para style="q" vid="NAM 3:18">צעשפּרײט אױף די בערג איז דײַן פֿאָלק,</para>
  <para style="q" vid="NAM 3:18">און נישטאָ װער זאָל אײַנזאַמלען.<verse eid="NAM 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="NAM 3:19" />נישטאָ קײן לינדערונג פֿאַר דײַן בראָך,</para>
  <para style="q" vid="NAM 3:19">שװער איז דײַן װוּנד;</para>
  <para style="q" vid="NAM 3:19">אַלע װאָס הערן דײַן הערונג,</para>
  <para style="q" vid="NAM 3:19">קלאַפּן מיט די הענט אױף דיר,</para>
  <para style="q" vid="NAM 3:19">װאָרעם אױף װעמען איז נישט אַריבער תּמיד דײַן בײז?<verse eid="NAM 3:19" /></para>
  <chapter eid="NAM 3" />
</usx>