<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEC" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">זְכַרְיָה</para>
  <para style="toc2">זכַריָה</para>
  <para style="toc1">זְכַרְיָה</para>
  <para style="mt1">זְכַרְיָה</para>
  <chapter number="1" style="c" pubnumber="א" sid="ZEC 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEC 1:1" />אין אַכטן חודש, אין צװײטן יאָר פֿון דָריָוֶשן, איז דאָס װאָרט פֿון ה׳ געװען צו זכַריָה, דעם זון פֿון ברֶכיָה, דעם זון פֿון עִדוֹן, דעם נבֿיא, אַזױ צו זאָגן: <verse eid="ZEC 1:1" /><verse number="2" style="v" sid="ZEC 1:2" />ה׳ האָט געצערנט אױף אײַערע עלטערן אַ צערענונג. <verse eid="ZEC 1:2" /><verse number="3" style="v" sid="ZEC 1:3" />דערום זאָלסטו זאָגן צו זײ:</para>
  <para style="b" vid="ZEC 1:3" />
  <para style="q" vid="ZEC 1:3">אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 1:3">קערט אײַך אום צו מיר, זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ZEC 1:3">און איך װעל זיך אומקערן צו אײַך,</para>
  <para style="q" vid="ZEC 1:3">זאָגט ה׳ צבָֿאוֹת.<verse eid="ZEC 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEC 1:4" />איר זאָלט נישט זײַן אַזױ װי אײַערע עלטערן,</para>
  <para style="q" vid="ZEC 1:4">װאָס די פֿריִערדיקע נבֿיאים האָבן צו זײ גערופֿן,</para>
  <para style="q" vid="ZEC 1:4">אַזױ צו זאָגן: אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 1:4">קערט אײַך אום פֿון אײַערע שלעכטע װעגן</para>
  <para style="q" vid="ZEC 1:4">און אײַערע שלעכטע מעשׂים.</para>
  <para style="q" vid="ZEC 1:4">און זײ האָבן נישט געהערט</para>
  <para style="q" vid="ZEC 1:4">און נישט צוגעהאָרכט צו מיר, זאָגט ה׳.<verse eid="ZEC 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEC 1:5" />אײַערע עלטערן, װוּ זײַנען זײ?</para>
  <para style="q" vid="ZEC 1:5">און די נבֿיאים, לעבן זײ דען אײביק!<verse eid="ZEC 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEC 1:6" />אָבער מײַנע װערטער און מײַנע משפּטים</para>
  <para style="q" vid="ZEC 1:6">װאָס איך האָב אָנגעזאָגט מײַנע קנעכט די נבֿיאים,</para>
  <para style="q" vid="ZEC 1:6">פֿאַר װאָר, זײ זײַנען אָנגעקומען אײַערע עלטערן,</para>
  <para style="q" vid="ZEC 1:6">און זײ האָבן תּשובֿה געטאָן, און האָבן געזאָגט:</para>
  <para style="q" vid="ZEC 1:6">אַזױ װי ה׳ צבָֿאוֹת האָט געטראַכט צו טאָן צו אונדז,</para>
  <para style="q" vid="ZEC 1:6">לױט אונדזערע װעגן און לױט אונדזערע מעשׂים,</para>
  <para style="q" vid="ZEC 1:6">אַזױ האָט ער מיט אונדז געטאָן.<verse eid="ZEC 1:6" /></para>
  <para style="b" />
  <para style="p">
    <verse number="7" style="v" sid="ZEC 1:7" />אין פֿיר און צװאַנציקסטן טאָג פֿון עלפֿטן חודש, דאָס איז חודש שבֿט, אין צװײטן יאָר פֿון דָריָוֶשן, איז דאָס װאָרט פֿון ה׳ געװען צו זכַריָה, דעם זון פֿון ברֶכיָהו, דעם זון פֿון עִדוֹאן, דעם נבֿיא, אַזױ צו זאָגן:<verse eid="ZEC 1:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="ZEC 1:8" />איך האָב געזען בײַ נאַכט, ערשט אַ מאַן רײַט אױף אַ רױטן פֿערד, און ער שטײט צװישן די מירטן װאָס אין דער טיפֿעניש, און הינטער אים זײַנען געװען רױטע, געלרױטע, און װײַסע פֿערד. <verse eid="ZEC 1:8" /><verse number="9" style="v" sid="ZEC 1:9" />האָב איך געזאָגט: װאָס זײַנען די דאָזיקע, מײַן האַר? האָט צו מיר געזאָגט דער מלאך װאָס האָט מיט מיר גערעדט: איך װעל דיר װײַזן װאָס די דאָזיקע זײַנען. <verse eid="ZEC 1:9" /><verse number="10" style="v" sid="ZEC 1:10" />און דער מאַן װאָס איז געשטאַנען צװישן די מירטן, האָט זיך אָפּגערופֿן און האָט געזאָגט: דאָס זײַנען די װאָס ה׳ האָט געשיקט אַרומצוגײן אױף דער ערד. <verse eid="ZEC 1:10" /><verse number="11" style="v" sid="ZEC 1:11" />און זײ האָבן זיך אָפּגערופֿן צו דעם מלאך פֿון ה׳ װאָס איז געשטאַנען צװישן די מירטן, און האָבן געזאָגט: מיר זײַנען אַרומגעגאַנגען אױף דער ערד, ערשט די גאַנצע ערד זיצט רואיק. <verse eid="ZEC 1:11" /><verse number="12" style="v" sid="ZEC 1:12" />האָט זיך אָפּגערופֿן דער מלאך פֿון ה׳ און האָט געזאָגט: ה׳ צבָֿאוֹת, ביז װאַנען װעסטו זיך נישט דערבאַרעמען אױף ירושָלַיִם, און אױף די שטעט פֿון יהוּדה, װאָס דו האָסט שױן זיבעציק יאָר צערענען? <verse eid="ZEC 1:12" /><verse number="13" style="v" sid="ZEC 1:13" />און ה׳ האָט געענטפֿערט דעם מלאך װאָס האָט מיט מיר גערעדט, גוטע װערטער, טרײסטװערטער. <verse eid="ZEC 1:13" /><verse number="14" style="v" sid="ZEC 1:14" />און דער מלאך װאָס האָט מיט מיר גערעדט, האָט געזאָגט צו מיר: רוף אױס אַזױ צו זאָגן:</para>
  <para style="b" vid="ZEC 1:14" />
  <para style="q" vid="ZEC 1:14">אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 1:14">איך בין מקנא פֿאַר ירושָלַיִם</para>
  <para style="q" vid="ZEC 1:14">און װעגן צִיוֹן מיט אַ גרױס קִנְאָה.<verse eid="ZEC 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEC 1:15" />און אַ גרױס צאָרן צערן איך אױף די רואיקע פֿעלקער,</para>
  <para style="q" vid="ZEC 1:15">װאָרעם איך האָב בלױז געצערנט אַ ביסל,</para>
  <para style="q" vid="ZEC 1:15">און זײ האָבן אונטערגעהאָלפֿן צום בײזן.<verse eid="ZEC 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEC 1:16" />דערום האָט ה׳ אַזױ געזאָגט:</para>
  <para style="q" vid="ZEC 1:16">איך קער זיך אום צו ירושָלַיִם מיט דערבאַרעמונג;</para>
  <para style="q" vid="ZEC 1:16">מײַן הױז װעט געבױט װערן אין איר,</para>
  <para style="q" vid="ZEC 1:16">זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ZEC 1:16">און אַ בױשנור װעט געצױגן װערן אױף ירושָלַיִם.<verse eid="ZEC 1:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEC 1:17" />װײַטער רוף אױס אַזױ צו זאָגן:</para>
  <para style="q" vid="ZEC 1:17">אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 1:17">מײַנע שטעט װעלן װידער איבערפֿלײצן מיט גוטס,</para>
  <para style="q" vid="ZEC 1:17">און ה׳ װעט נאָך טרײסטן צִיוֹן,</para>
  <para style="q" vid="ZEC 1:17">און װעט װידער אױסדערװײלן ירושָלַיִם.<verse eid="ZEC 1:17" /></para>
  <chapter eid="ZEC 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="ZEC 2" />
  <para style="p">
    <verse number="1" style="v" pubnumber="1.18" sid="ZEC 2:1" /> און איך האָב אױפֿגעהױבן מײַנע אױגן און האָב געזען, ערשט פֿיר הערנער. <verse eid="ZEC 2:1" /><verse number="2" style="v" pubnumber="1.19" sid="ZEC 2:2" /> האָב איך געזאָגט צו דעם מלאך װאָס האָט מיט מיר גערעדט: װאָס זײַנען די דאָזיקע? האָט ער צו מיר געזאָגט: דאָס זײַנען די הערנער װאָס האָבן צעשפּרײט יהוּדה, יִשׂרָאֵל, און ירושָלַיִם.<verse eid="ZEC 2:2" /></para>
  <para style="p">
    <verse number="3" style="v" pubnumber="1.20" sid="ZEC 2:3" /> און ה׳ האָט מיר געװיזן פֿיר מײַנסטערס. <verse eid="ZEC 2:3" /><verse number="4" style="v" pubnumber="1.21" sid="ZEC 2:4" /> האָב איך געזאָגט: װאָס קומען די דאָזיקע טאָן? האָט ער געזאָגט אַזױ צו זאָגן: יענע זײַנען די הערנער װאָס האָבן צעשפּרײט יהוּדה, אַזױ אַז קײנער האָט נישט געקענט אױפֿהײבן אַ קאָפּ, און די דאָזיקע זײַנען געקומען אױף זײ אַ שרעק אָנצוּװאַרפֿן, אָפּצוהאַקן די הערנער פֿון די פֿעלקער װאָס האָבן אױפֿגעהױבן דעם האָרן קעגן לאַנד יהוּדה, כּדי עס צו צעשפּרײטן.<verse eid="ZEC 2:4" /></para>
  <para style="p">
    <verse number="5" style="v" pubnumber="2.1" sid="ZEC 2:5" /> און איך האָב אױפֿגעהױבן מײַנע אױגן און האָב געזען, ערשט אַ מאַן, און אין זײַן האַנט אַ מעסטשנור. <verse eid="ZEC 2:5" /><verse number="6" style="v" pubnumber="2.2" sid="ZEC 2:6" /> האָב איך געזאָגט: װוּהין גײסטו? האָט ער צו מיר געזאָגט: צו מעסטן ירושָלַיִם, כּדי צו זען װיפֿל איז איר ברײט, און װיפֿל איר לענג. <verse eid="ZEC 2:6" /><verse number="7" style="v" pubnumber="2.3" sid="ZEC 2:7" /> ערשט דער מלאך װאָס האָט מיט מיר גערעדט איז אַרױסגעגאַנגען, און אַן אַנדער מלאך איז אַרױסגעגאַנגען אים אַנטקעגן. <verse eid="ZEC 2:7" /><verse number="8" style="v" pubnumber="2.4" sid="ZEC 2:8" /> און ער האָט געזאָגט: לױף זאָג צו יענעם יונגמאַן אַזױ צו זאָגן:</para>
  <para style="b" vid="ZEC 2:8" />
  <para style="q" vid="ZEC 2:8">אָפֿן אָן װענט װעט ירושָלַיִם זײַן באַזעצט,</para>
  <para style="q" vid="ZEC 2:8">פֿון פֿיל מענטשן און בהמות אין איר.<verse eid="ZEC 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" pubnumber="2.5" sid="ZEC 2:9" /> און איך װעל איר זײַן, זאָגט ה׳,</para>
  <para style="q" vid="ZEC 2:9">אַ מױער פֿון פֿײַער רונד אַרום,</para>
  <para style="q" vid="ZEC 2:9">און פֿאַר אַ כּבֿוד װעל איך זײַן אין איר מיט.<verse eid="ZEC 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" pubnumber="2.6" sid="ZEC 2:10" /> העי, העי! און אַנטלױפֿט</para>
  <para style="q" vid="ZEC 2:10">פֿון דעם לאַנד פֿון צפֿון, זאָגט ה׳,</para>
  <para style="q" vid="ZEC 2:10">װאָרעם אַזױ װי די פֿיר װינטן פֿון הימל</para>
  <para style="q" vid="ZEC 2:10">האָב איך אײַך צעשפּרײט, זאָגט ה׳.<verse eid="ZEC 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" pubnumber="2.7" sid="ZEC 2:11" /> העי צִיוֹן, אַנטרין,</para>
  <para style="q" vid="ZEC 2:11">דו װאָס װױנסט בײַ טאָכטער בָבֿל.<verse eid="ZEC 2:11" /></para>
  <para style="q">
    <verse number="12" style="v" pubnumber="2.8" sid="ZEC 2:12" /> װאָרעם אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 2:12">נאָך דעם כּבֿוד האָט ער מיך געשיקט</para>
  <para style="q" vid="ZEC 2:12">צו די פֿעלקער װאָס באַרױבן אײַך:</para>
  <para style="q" vid="ZEC 2:12">פֿאַר װאָר, דער װאָס רירט אײַך אָן</para>
  <para style="q" vid="ZEC 2:12">רירט אָן דעם שװאַרצאַפּל פֿון זײַן אױג.<verse eid="ZEC 2:12" /></para>
  <para style="q">
    <verse number="13" style="v" pubnumber="2.9" sid="ZEC 2:13" /> װאָרעם זע, איך פֿאָך מײַן האַנט אױף זײ,</para>
  <para style="q" vid="ZEC 2:13">און זײ װעלן װערן אַ רױב צו די װאָס האָבן זײ געדינט,</para>
  <para style="q" vid="ZEC 2:13">און איר װעט װיסן אַז ה׳ צבָֿאוֹת האָט מיך געשיקט.<verse eid="ZEC 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" pubnumber="2.10" sid="ZEC 2:14" /> זינג און פֿרײ זיך, טאָכטער צִיוֹן,</para>
  <para style="q" vid="ZEC 2:14">װאָרעם זע, איך קום,</para>
  <para style="q" vid="ZEC 2:14">און װעל רוען צװישן דיר, זאָגט ה׳.<verse eid="ZEC 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" pubnumber="2.11" sid="ZEC 2:15" /> און פֿיל פֿעלקער װעלן זיך באַהעפֿטן אָן ג-ט אין יענעם טאָג,</para>
  <para style="q" vid="ZEC 2:15">און זײ װעלן מיר זײַן צום פֿאָלק,</para>
  <para style="q" vid="ZEC 2:15">און איך װעל רוען אין דײַן מיט;</para>
  <para style="q" vid="ZEC 2:15">און װעסט װיסן אַז ה׳ צבָֿאוֹת האָט מיך געשיקט צו דיר.<verse eid="ZEC 2:15" /></para>
  <para style="q">
    <verse number="16" style="v" pubnumber="2.12" sid="ZEC 2:16" /> און ה׳ װעט אַרבן יהוּדה פֿאַר זײַן חלק,</para>
  <para style="q" vid="ZEC 2:16">אױף דער הײליקער ערד,</para>
  <para style="q" vid="ZEC 2:16">און װעט װידער אױסדערװײלן ירושָלַיִם.<verse eid="ZEC 2:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" pubnumber="2.13" sid="ZEC 2:17" /> שטיל יעטװעדער לײַב פֿאַר ה׳,</para>
  <para style="q" vid="ZEC 2:17">װאָרעם ער װעקט זיך פֿון זײַן הײליקער װױנונג.<verse eid="ZEC 2:17" /></para>
  <chapter eid="ZEC 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="ZEC 3" />
  <para style="p">
    <verse number="1" style="v" sid="ZEC 3:1" />און ער האָט מיר געװיזן יְהוֹשועַ דעם כּהן-גָדול װי ער שטײט פֿאַר דעם מלאך פֿון ה׳, און דער שׂטן שטײט אױף זײַן רעכטער זײַט, אים צו פֿאַרקלאָגן. <verse eid="ZEC 3:1" /><verse number="2" style="v" sid="ZEC 3:2" />האָט ה׳ געזאָגט צום שׂטן: ג-ט שרײַט אָן אױף דיר, שׂטן, יאָ, ג-ט װאָס האָט אױסדערװײלט ירושָלַיִם, שרײַט אָן אױף דיר; איז נישט דער דאָזיקער אַ שײַט אַרױסגעריסן פֿון פֿײַער? <verse eid="ZEC 3:2" /><verse number="3" style="v" sid="ZEC 3:3" />און יְהוֹשועַ איז געװען אָנגעטאָן אין קױטיקע בגדים, און איז געשטאַנען פֿאַרן מלאך. <verse eid="ZEC 3:3" /><verse number="4" style="v" sid="ZEC 3:4" />האָט ער זיך אָפּגערופֿן און האָט געזאָגט צו די װאָס זײַנען געשטאַנען פֿאַר אים, אַזױ צו זאָגן: טוט אױס פֿון אים די קױטיקע בגדים. און צו אים האָט ער געזאָגט: זע, איך האָב אָפּגעטאָן פֿון דיר דײַנע זינד, און װעל דיר אָנטאָן מלבושים. <verse eid="ZEC 3:4" /><verse number="5" style="v" sid="ZEC 3:5" />האָב איך געזאָגט: זאָל מען אים אָנטאָן אַ רײנע הױב אױפֿן קאָפּ. און זײ האָבן אים אָנגעטאָן די רײנע הױב אױפֿן קאָפּ, און האָבן אים אָנגעקלײדט בגדים; און דער מלאך פֿון ה׳ איז געשטאַנען דערבײַ. <verse eid="ZEC 3:5" /><verse number="6" style="v" sid="ZEC 3:6" />און דער מלאך פֿון ה׳ האָט געװאָרנט יְהוֹשועַן, אַזױ צו זאָגן:<verse eid="ZEC 3:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ZEC 3:7" />אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 3:7">אױב אין מײַנע װעגן װעסטו גײן,</para>
  <para style="q" vid="ZEC 3:7">און אױב מײַן היטונג װעסטו היטן,</para>
  <para style="q" vid="ZEC 3:7">און דו װעסט אױך משפּטן מײַן הױז,</para>
  <para style="q" vid="ZEC 3:7">און װעסט אױך היטן מײַנע הױפֿן,</para>
  <para style="q" vid="ZEC 3:7">װעל איך דיר געבן צוטריט</para>
  <para style="q" vid="ZEC 3:7">צװישן די דאָזיקע װאָס שטײען דאָ.<verse eid="ZEC 3:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEC 3:8" />הער נאָר צו, יְהוֹשועַ כּהן-גָדול,</para>
  <para style="q" vid="ZEC 3:8">דו און דײַנע חבֿרים װאָס זיצן פֿאַר דיר –</para>
  <para style="q" vid="ZEC 3:8">װאָרעם פֿאַר אַ צײכן מענטשן זײַנען זײ –</para>
  <para style="q" vid="ZEC 3:8">װאָרעם זע, איך ברענג מײַן קנעכט דעם צמח.<verse eid="ZEC 3:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEC 3:9" />װאָרעם אָט איז דער שטײן װאָס איך האָב געלײגט פֿאַר יְהוֹשועַן</para>
  <para style="q" vid="ZEC 3:9">אױף דעם אײן שטײן זײַנען זיבן אױגן.</para>
  <para style="q" vid="ZEC 3:9">זע, איך קריץ אױס זײַן אױסקריצונג,</para>
  <para style="q" vid="ZEC 3:9">זאָגט ה׳ צבָֿאוֹת;</para>
  <para style="q" vid="ZEC 3:9">און איך װעל אָפּטאָן די זינד פֿון דעם דאָזיקן לאַנד</para>
  <para style="q" vid="ZEC 3:9">אין אײן טאָג.<verse eid="ZEC 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEC 3:10" />אין יענעם טאָג, זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ZEC 3:10">װעט איר רופֿן אײנער דעם אַנדערן</para>
  <para style="q" vid="ZEC 3:10">אונטער אַ װײַנשטאָק און אונטער אַ פֿײַגנבױם.<verse eid="ZEC 3:10" /></para>
  <chapter eid="ZEC 3" />
  <chapter number="4" style="c" pubnumber="ד" sid="ZEC 4" />
  <para style="p">
    <verse number="1" style="v" sid="ZEC 4:1" />און דער מלאך װאָס האָט גערעדט מיט מיר, האָט זיך אומגעקערט, און ער האָט מיך אױפֿגעװעקט, אַזױ װי אַ מענטש װערט אױפֿגעװעקט פֿון זײַן שלאָף. <verse eid="ZEC 4:1" /><verse number="2" style="v" sid="ZEC 4:2" />און ער האָט צו מיר געזאָגט: װאָס זעסטו? האָב איך געזאָגט: איך האָב געזען, ערשט אַ מנוֹרה, אין גאַנצן פֿון גאָלד, און אױבן בײַ איר אַ בעקן, און אירע זיבן לעמפּלעך אױף איר, מיט זיבן, יאָ זיבן רערן צו די לעמפּלעך װאָס בײַ איר אױבן. <verse eid="ZEC 4:2" /><verse number="3" style="v" sid="ZEC 4:3" />און צװײ אײלבערטבײמער לעבן איר, אײנער פֿון דער רעכטער זײַט פֿון דעם בעקן, און אײנער פֿון זײַן לינקער זײַט. <verse eid="ZEC 4:3" /><verse number="4" style="v" sid="ZEC 4:4" />און איך האָב זיך אָפּגערופֿן און האָב געזאָגט צו דעם מלאך װאָס האָט מיט מיר גערעדט, אַזױ צו זאָגן: װאָס זײַנען די דאָזיקע, מײַן האַר? <verse eid="ZEC 4:4" /><verse number="5" style="v" sid="ZEC 4:5" />האָט געענטפֿערט דער מלאך װאָס האָט מיט מיר גערעדט, און האָט געזאָגט צו מיר: װײסטו נישט װאָס די דאָזיקע זײַנען? האָב איך געזאָגט: נײן, מײַן האַר. <verse eid="ZEC 4:5" /><verse number="6" style="v" sid="ZEC 4:6" />האָט ער זיך אָפּגערופֿן און האָט געזאָגט צו מיר, אַזױ צו זאָגן: דאָס איז דאָס װאָרט פֿון ה׳ צו זרובבֿלן, אַזױ צו זאָגן:</para>
  <para style="b" vid="ZEC 4:6" />
  <para style="q" vid="ZEC 4:6">נישט מיט חיל און נישט מיט כּוֹח,</para>
  <para style="q" vid="ZEC 4:6">נאָר מיט מײַן גײַסט, זאָגט ה׳ צבָֿאוֹת.<verse eid="ZEC 4:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEC 4:7" />װער ביסטו, גרױסער באַרג?</para>
  <para style="q" vid="ZEC 4:7">פֿאַר זרובבֿלן װעסטו װערן אַ גלײַכער פּלאַץ;</para>
  <para style="q" vid="ZEC 4:7">און ער װעט אַרױסברענגען דעם קאָפּשטײן מיט געשרײען:</para>
  <para style="q" vid="ZEC 4:7">חן, חן צו אים!<verse eid="ZEC 4:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="ZEC 4:8" />און דאָס װאָרט פֿון ה׳ איז געװען צו מיר, אַזױ צו זאָגן:<verse eid="ZEC 4:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ZEC 4:9" />די הענט פֿון זרובבֿלן האָבן געגרונטפֿעסט דאָס דאָזיקע הױז,</para>
  <para style="q" vid="ZEC 4:9">און זײַנע הענט װעלן עס ענדיקן,</para>
  <para style="q" vid="ZEC 4:9">און װעסט װיסן אַז ה׳ צבָֿאוֹת</para>
  <para style="q" vid="ZEC 4:9">האָט מיך געשיקט צו אײַך.<verse eid="ZEC 4:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEC 4:10" />װאָרעם װער נאָר עס האָט פֿאַראַכט</para>
  <para style="q" vid="ZEC 4:10">דעם טאָג פֿון קלײנע אָנהײבן,</para>
  <para style="q" vid="ZEC 4:10">זײ װעלן זיך פֿרײען אַז זײ װעלן זען</para>
  <para style="q" vid="ZEC 4:10">דאָס בלײַשנור אין זרובבֿלס האַנט.</para>
  <para style="q" vid="ZEC 4:10">די דאָזיקע זיבן דאָס זײַנען די אױגן פֿון ה׳</para>
  <para style="q" vid="ZEC 4:10">װאָס װאַנדערן איבער דער גאַנצער ערד.<verse eid="ZEC 4:10" /></para>
  <para style="b" />
  <para style="p">
    <verse number="11" style="v" sid="ZEC 4:11" />האָב איך זיך אָפּגערופֿן און האָב צו אים געזאָגט: װאָס זײַנען די דאָזיקע צװײ אײלבערטבײמער אױף דער רעכטער זײַט פֿון דער מנוֹרה און אױף איר לינקער זײַט? <verse eid="ZEC 4:11" /><verse number="12" style="v" sid="ZEC 4:12" />און איך האָב זיך אָפּגערופֿן אַ צװײט מאָל און האָב געזאָגט צו אים: װאָס זײַנען די צװײ אײלבערטצװײַגן װאָס לעבן די צװײ גילדערנע גיסרערן װאָס לײדיקן אַרױס פֿון זיך דאָס גילדערנע בױמל? <verse eid="ZEC 4:12" /><verse number="13" style="v" sid="ZEC 4:13" />האָט ער געזאָגט צו מיר, אַזױ צו זאָגן: װײסטו נישט װאָס די דאָזיקע זײַנען? האָב איך געזאָגט: נײן, מײַן האַר. <verse eid="ZEC 4:13" /><verse number="14" style="v" sid="ZEC 4:14" />האָט ער געזאָגט: דאָס זײַנען די צװײ געזאַלבטע װאָס שטײען לעבן דעם האַר פֿון דער גאַנצער ערד.<verse eid="ZEC 4:14" /></para>
  <chapter eid="ZEC 4" />
  <chapter number="5" style="c" pubnumber="ה" sid="ZEC 5" />
  <para style="p">
    <verse number="1" style="v" sid="ZEC 5:1" />און איך האָב װידער אױפֿגעהױבן מײַנע אױגן און האָב געזען, ערשט אַ פֿליעדיקע מגילה. <verse eid="ZEC 5:1" /><verse number="2" style="v" sid="ZEC 5:2" />האָט ער צו מיר געזאָגט: װאָס זעסטו? האָב איך געזאָגט: איך זע אַ פֿליעדיקע מגילה; איר לענג צװאַנציק אײַלן, און איר ברײט צען אײַלן. <verse eid="ZEC 5:2" /><verse number="3" style="v" sid="ZEC 5:3" />האָט ער צו מיר געזאָגט:</para>
  <para style="b" vid="ZEC 5:3" />
  <para style="q" vid="ZEC 5:3">דאָס איז די קללה װאָס גײט אַרױס</para>
  <para style="q" vid="ZEC 5:3">איבער דעם געזיכט פֿון דער גאַנצער ערד;</para>
  <para style="q" vid="ZEC 5:3">װאָרעם איטלעכער װאָס גנבֿעט,</para>
  <para style="q" vid="ZEC 5:3">װערט פֿון דאַנען אַװעקגעראַמט לױט איר,</para>
  <para style="q" vid="ZEC 5:3">און איטלעכער װאָס שװערט פֿאַלש,</para>
  <para style="q" vid="ZEC 5:3">װערט פֿון דאַנען אַװעקגעראַמט לױט איר.<verse eid="ZEC 5:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEC 5:4" />איך האָב זי אַרױסגעלאָזט, זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ZEC 5:4">און זי װעט קומען אין הױז פֿון דעם גנבֿ,</para>
  <para style="q" vid="ZEC 5:4">און אין הױז פֿון דעם װאָס שװערט בײַ מײַן נאָמען צום פֿאַלשן,</para>
  <para style="q" vid="ZEC 5:4">און זי װעט בלײַבן אין זײַן הױז,</para>
  <para style="q" vid="ZEC 5:4">און זי װעט עס פֿאַרלענדן</para>
  <para style="q" vid="ZEC 5:4">מיט זײַנע האָלצן און מיט זײַנע שטײנער.<verse eid="ZEC 5:4" /></para>
  <para style="b" />
  <para style="p">
    <verse number="5" style="v" sid="ZEC 5:5" />און דער מלאך װאָס האָט גערעדט מיט מיר, איז אַרױסגעגאַנגען, און האָט צו מיר געזאָגט: הײב אַקאָרשט אױף דײַנע אױגן, און זע װאָס איז דאָס דאָזיקע װאָס גײט אַרױס? <verse eid="ZEC 5:5" /><verse number="6" style="v" sid="ZEC 5:6" />האָב איך געזאָגט: װאָס איז דאָס? האָט ער געזאָגט: דאָס איז די אֵיפֿה װאָס גײט אַרױס. און ער האָט געזאָגט: דאָס איז זײער אָנבליק אין גאַנצן לאַנד – <verse eid="ZEC 5:6" /><verse number="7" style="v" sid="ZEC 5:7" />ערשט אַ רונד שטיק בלײַ האָט זיך אױפֿגעהױבן – און דאָס איז אַ פֿרױ װאָס זיצט אין דער אֵיפֿה. <verse eid="ZEC 5:7" /><verse number="8" style="v" sid="ZEC 5:8" />און ער האָט געזאָגט: דאָס איז די שלעכטיקײט. און ער האָט זי אַרײַנגעװאָרפֿן אין דער אֵיפֿה, און האָט אַרױפֿגעװאָרפֿן דאָס שטיק בלײַ אױף איר עפֿענונג.<verse eid="ZEC 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 5:9" />און איך האָב אױפֿגעהױבן מײַנע אױגן און האָב געזען, ערשט צװײ װײַבער גײען אַרױס, און אַ װינט איז אין זײערע פֿליגלען, און די פֿליגלען בײַ זײ זײַנען װי די פֿליגלען פֿון אַ שטאָרך; און זײ האָבן געטראָגן די אֵיפֿה צװישן ערד און הימל. <verse eid="ZEC 5:9" /><verse number="10" style="v" sid="ZEC 5:10" />האָב איך געזאָגט צו דעם מלאך װאָס האָט גערעדט מיט מיר: װוּהין טראָגן זײ די אֵיפֿה? <verse eid="ZEC 5:10" /><verse number="11" style="v" sid="ZEC 5:11" />האָט ער געזאָגט צו מיר: איר צו בױען אַ הױז אין לאַנד שִנעָר; און אַז עס װעט צוגעברײט װערן, װעט זי דאָרטן אַנידערגעשטעלט װערן אױף איר אָרט.<verse eid="ZEC 5:11" /></para>
  <chapter eid="ZEC 5" />
  <chapter number="6" style="c" pubnumber="ו" sid="ZEC 6" />
  <para style="p">
    <verse number="1" style="v" sid="ZEC 6:1" />און איך האָב װידער אױפֿגעהױבן מײַנע אױגן און האָב געזען, ערשט פֿיר רײַטװעגן גײען אַרױס פֿון צװישן צװײ בערג, און די בערג זײַנען קופּערנע בערג. <verse eid="ZEC 6:1" /><verse number="2" style="v" sid="ZEC 6:2" />אין ערשטן רײַטװאָגן רױטע פֿערד, און אין צװײטן רײַטװאָגן שװאַרצע פֿערד, <verse eid="ZEC 6:2" /><verse number="3" style="v" sid="ZEC 6:3" />און אין דריטן רײַטװאָגן װײַסע פֿערד, און אין פֿירטן רײַטװאָגן געשפּרענקלטע ברױנע פֿערד. <verse eid="ZEC 6:3" /><verse number="4" style="v" sid="ZEC 6:4" />האָב איך זיך אָפּגערופֿן און האָב געזאָגט צו דעם מלאך װאָס האָט מיט מיר גערעדט: װאָס זײַנען די דאָזיקע, מײַן האַר? <verse eid="ZEC 6:4" /><verse number="5" style="v" sid="ZEC 6:5" />האָט דער מלאך געענטפֿערט און האָט געזאָגט צו מיר: די דאָזיקע זײַנען די פֿיר װינטן פֿון הימל, נאָך דעם װי זײ האָבן זיך געשטעלט פֿאַר דעם האַר פֿון דער גאַנצער ערד. <verse eid="ZEC 6:5" /><verse number="6" style="v" sid="ZEC 6:6" />דער װאָס אין אים זײַנען די שװאַרצע פֿערד גײט אַרױס צום לאַנד פֿון צפֿון, און די װײַסע זײַנען אַרױסגעגאַנגען נאָך זײ, און די געשפּרענקלטע זײַנען אַרױסגעגאַנגען צום לאַנד פֿון דָרום. <verse eid="ZEC 6:6" /><verse number="7" style="v" sid="ZEC 6:7" />אױך די ברױנע זײַנען אַרױסגעגאַנגען, און זײ האָבן געװאָלט גײן אומװאַנדערן איבער דער ערד; האָט ער געזאָגט: גײט װאַנדערט אום איבער דער ערד. און זײ האָבן אומגעװאַנדערט איבער דער ערד. <verse eid="ZEC 6:7" /><verse number="8" style="v" sid="ZEC 6:8" />און ער האָט צוגעשריען צו מיר, און האָט גערעדט צו מיר, אַזױ צו זאָגן: זע, די װאָס זײַנען אַרױסגעגאַנגען צום לאַנד פֿון צפֿון, האָבן באַרוט מײַן רוּחַ אין לאַנד פֿון צפֿון.<verse eid="ZEC 6:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 6:9" />און דאָס װאָרט פֿון ה׳ איז געװען צו מיר, אַזױ צו זאָגן: <verse eid="ZEC 6:9" /><verse number="10" style="v" sid="ZEC 6:10" />נעם פֿון די גלות-לײַט, פֿון כֶלדַין, פֿון טוֹבֿיָהן, און פֿון ידַעְיָהן, װאָס זײַנען געקומען פֿון בָבֿל, און זאָלסט גײן אין דעם אײגענעם טאָג, און קומען אין הױז פֿון יֹאשִיָה דעם זון פֿון צפַֿניָהן – <verse eid="ZEC 6:10" /><verse number="11" style="v" sid="ZEC 6:11" />זאָלסט נעמען זילבער און גאָלד, און מאַכן קרױנען, און אָנטאָן אױפֿן קאָפּ פֿון יְהוֹשועַ דעם זון פֿון יהוֹצָדָקן, דעם כּהן-גָדול. <verse eid="ZEC 6:11" /><verse number="12" style="v" sid="ZEC 6:12" />און זאָלסט זאָגן צו אים, אַזױ צו זאָגן:</para>
  <para style="b" vid="ZEC 6:12" />
  <para style="q" vid="ZEC 6:12">אַזױ האָט געזאָגט ה׳ צבָֿאוֹת, אַזױ צו זאָגן:</para>
  <para style="q" vid="ZEC 6:12">אָט איז דעם מאַן װאָס זײַן נאָמען איז צֶמַח,</para>
  <para style="q" vid="ZEC 6:12">און װאָס װעט אַרױסשפּראָצן פֿון זײַן אָרט,</para>
  <para style="q" vid="ZEC 6:12">און ער װעט בױען דעם הֵיכל פֿון ה׳.<verse eid="ZEC 6:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEC 6:13" />יאָ, ער װעט בױען דעם הֵיכל פֿון ה׳,</para>
  <para style="q" vid="ZEC 6:13">און ער װעט טראָגן דעם גלאַנץ,</para>
  <para style="q" vid="ZEC 6:13">און װעט זיצן און געװעלטיקן אױף זײַן טראָן,</para>
  <para style="q" vid="ZEC 6:13">און אַ כּהן װעט זײַן בײַ זײַן טראָן;</para>
  <para style="q" vid="ZEC 6:13">און אַ פֿרידלעכע באַראָטונג װעט זײַן צװישן זײ בײדן.<verse eid="ZEC 6:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEC 6:14" />און די קרױנען זאָלן זײַן חֵלֶמען, און טוֹבֿיָהן,</para>
  <para style="q" vid="ZEC 6:14">און ידַעְיָהן, און *חֵן דעם זון פֿון צפַֿניָהן,</para>
  <para style="q" vid="ZEC 6:14">פֿאַר אַ געדעכעניש אין דעם הֵיכל פֿון ה׳.<verse eid="ZEC 6:14" /></para>
  <para style="b" />
  <para style="q">
    <verse number="15" style="v" sid="ZEC 6:15" />און װײַטע װעלן קומען,</para>
  <para style="q" vid="ZEC 6:15">און װעלן בױען אין דעם הֵיכל פֿון ה׳;</para>
  <para style="q" vid="ZEC 6:15">און איר װעט װיסן אַז ה׳ צבָֿאוֹת</para>
  <para style="q" vid="ZEC 6:15">האָט מיך געשיקט צו אײַך.</para>
  <para style="q" vid="ZEC 6:15">און עס װעט זײַן, אױב הערן װעט איר צוהערן</para>
  <para style="q" vid="ZEC 6:15">צו דעם קֹול פֿון ה׳ אלוקיכם.<verse eid="ZEC 6:15" /></para>
  <chapter eid="ZEC 6" />
  <chapter number="7" style="c" pubnumber="ז" sid="ZEC 7" />
  <para style="p">
    <verse number="1" style="v" sid="ZEC 7:1" />און עס איז געװען אין פֿירטן יאָר פֿון מלך דָריָוֶש, איז דאָס װאָרט פֿון ה׳ געװען צו זכַריָהן אין פֿירטן טאָג פֿון נײַנטן חודש, אין כִּסלֵו, <verse eid="ZEC 7:1" /><verse number="2" style="v" sid="ZEC 7:2" />װען בֵית-אֵל, שַׂראֶצֶר, און רֶגֶם-מֶלֶך און זײַנע מענטשן, האָבן געשיקט צו בעטן פֿאַר ה׳, <verse eid="ZEC 7:2" /><verse number="3" style="v" sid="ZEC 7:3" />און צו זאָגן צו די כּהנים װאָס אין הױז פֿון ה׳ צבָֿאוֹת, און צו די נבֿיאים, אַזױ צו זאָגן: זאָל איך װײנען אין דעם פֿינפֿטן חודש אָפּגעזונדערטערהײט, אַזױ װי איך האָב געטאָן שױן פֿון כַּמֶה יאָרן? <verse eid="ZEC 7:3" /><verse number="4" style="v" sid="ZEC 7:4" />איז דאָס װאָרט פֿון ה׳ צבָֿאוֹת געװען צו מיר, אַזױ צו זאָגן: <verse eid="ZEC 7:4" /><verse number="5" style="v" sid="ZEC 7:5" />זאָג צו דעם גאַנצן פֿאָלק פֿון לאַנד, און צו די כּהנים, אַזױ צו זאָגן: אַז איר האָט געפֿאַסט און געקלאָגט אין פֿינפֿטן און אין זיבעטן חודש שױן זיבעציק יאָר, האָט איר פֿאַסטן דען מיר געפֿאַסט? <verse eid="ZEC 7:5" /><verse number="6" style="v" sid="ZEC 7:6" />און אַז איר עסט, און אַז איר טרינקט, זײַט איר נישט די װאָס עסט, און איר די װאָס טרינקט? <verse eid="ZEC 7:6" /><verse number="7" style="v" sid="ZEC 7:7" />דאָס זײַנען דאָך די װערטער װאָס ה׳ האָט גערופֿן דורך די פֿריִערדיקע נבֿיאים, װען ירושָלַיִם איז געװען באַזעצט און בשלװה, מיט אירע שטעט רונד אַרום איר, און דער דָרום און די נידערונג זײַנען געװען באַזעצט.<verse eid="ZEC 7:7" /></para>
  <para style="b" />
  <para style="p">
    <verse number="8" style="v" sid="ZEC 7:8" />און דאָס װאָרט פֿון ה׳ איז געװען צו זכַריָהן, אַזױ צו זאָגן:<verse eid="ZEC 7:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ZEC 7:9" />אַזױ האָט געהאַט געזאָגט ה׳ צבָֿאוֹת, אַזױ צו זאָגן:</para>
  <para style="q" vid="ZEC 7:9">משפּט אַן אמתן משפּט,</para>
  <para style="q" vid="ZEC 7:9">און טוט חֶסֶד און דערבאַרעמונג אײנער מיטן אַנדערן,<verse eid="ZEC 7:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEC 7:10" />און אַן אַלמנה און אַ יתום,</para>
  <para style="q" vid="ZEC 7:10">אַ פֿרעמדן און אַן אָרעמאַן,</para>
  <para style="q" vid="ZEC 7:10">זאָלט איר נישט דריקן,</para>
  <para style="q" vid="ZEC 7:10">און אײנער דעם אַנדערנס רעה</para>
  <para style="q" vid="ZEC 7:10">זאָלט איר נישט טראַכטן אין אײַער האַרצן.<verse eid="ZEC 7:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEC 7:11" />אָבער זײ האָבן נישט געװאָלט האָרכן,</para>
  <para style="q" vid="ZEC 7:11">און זײ האָבן געקערט אַ װידערשפּעניקן רוקן,</para>
  <para style="q" vid="ZEC 7:11">און זײערע אױערן האָבן זײ פֿאַרשטאָפּט נישט צו הערן.<verse eid="ZEC 7:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEC 7:12" />און זײער האַרץ האָבן זײ געמאַכט אַזױ װי דימענטשטײן,</para>
  <para style="q" vid="ZEC 7:12">נישט צו הערן די תּורה און די װערטער</para>
  <para style="q" vid="ZEC 7:12">װאָס ה׳ צבָֿאוֹת האָט געשיקט מיט זײַן רוּחַ</para>
  <para style="q" vid="ZEC 7:12">דורך די פֿריִערדיקע נבֿיאים;</para>
  <para style="q" vid="ZEC 7:12">דערום איז געװאָרן אַ גרױסער צאָרן פֿון ה׳ צבָֿאוֹת.<verse eid="ZEC 7:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEC 7:13" />און עס איז געװען:</para>
  <para style="q" vid="ZEC 7:13">אַזױ װי ער האָט גערופֿן, און זײ האָבן נישט צוגעהערט,</para>
  <para style="q" vid="ZEC 7:13">אַזױ װעלן זײ רופֿן, און איך װעל נישט צוהערן,</para>
  <para style="q" vid="ZEC 7:13">האָט געזאָגט ה׳ צבָֿאוֹת.<verse eid="ZEC 7:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEC 7:14" />און איך װעל זײ צעשטורעמען איבער אַלע פֿעלקער</para>
  <para style="q" vid="ZEC 7:14">װאָס זײ האָבן זײ נישט געקענט.</para>
  <para style="q" vid="ZEC 7:14">אַזױ איז דאָס לאַנד װיסט געװאָרן נאָך זײ,</para>
  <para style="q" vid="ZEC 7:14">אָן אַ גײער און אָן אַ קומער;</para>
  <para style="q" vid="ZEC 7:14">און זײ האָבן געמאַכט דאָס גלוסטיקע לאַנד אַ װיסטעניש.<verse eid="ZEC 7:14" /></para>
  <chapter eid="ZEC 7" />
  <chapter number="8" style="c" pubnumber="ח" sid="ZEC 8" />
  <para style="p">
    <verse number="1" style="v" sid="ZEC 8:1" />און דאָס װאָרט פֿון ה׳ צבָֿאוֹת איז געװען אַזױ צו זאָגן:<verse eid="ZEC 8:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ZEC 8:2" />אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 8:2">איך בין מקנא פֿאַר צִיוֹן אַ גרױס קִנְאָה,</para>
  <para style="q" vid="ZEC 8:2">און מיט גרױס גרימצאָרן איך בין מקנא פֿאַר איר.<verse eid="ZEC 8:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEC 8:3" />אַזױ האָט ה׳ געזאָגט:</para>
  <para style="q" vid="ZEC 8:3">איך קער זיך אום קײן צִיוֹן,</para>
  <para style="q" vid="ZEC 8:3">און איך װעל רוען אין ירושָלַיִם,</para>
  <para style="q" vid="ZEC 8:3">און ירושָלַיִם װעט גערופֿן װערן די שטאָט פֿון אמת,</para>
  <para style="q" vid="ZEC 8:3">און דער באַרג פֿון ה׳ צבָֿאוֹת, דער הײליקער באַרג.<verse eid="ZEC 8:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEC 8:4" />אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 8:4">עס װעלן נאָך זיצן זקנים און זקנות אין די גאַסן פֿון ירושָלַיִם,</para>
  <para style="q" vid="ZEC 8:4">איטלעכער מיט זײַן שטעקן אין זײַן האַנט, פֿון גרױס עלטער.<verse eid="ZEC 8:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEC 8:5" />און די גאַסן פֿון דער שטאָט</para>
  <para style="q" vid="ZEC 8:5">װעלן זײַן פֿול מיט ייִנגלעך און מײדלעך</para>
  <para style="q" vid="ZEC 8:5">װאָס שפּילן זיך אין אירע גאַסן.<verse eid="ZEC 8:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEC 8:6" />אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 8:6">אױב דאָס װעט זײַן װוּנדערלעך אין די אױגן</para>
  <para style="q" vid="ZEC 8:6">פֿון דעם איבערבלײַב פֿון דעם דאָזיקן פֿאָלק אין יענע טעג,</para>
  <para style="q" vid="ZEC 8:6">זאָל עס אױך אין מײַנע אױגן זײַן װוּנדערלעך?</para>
  <para style="q" vid="ZEC 8:6">זאָגט ה׳ צבָֿאוֹת.<verse eid="ZEC 8:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEC 8:7" />אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 8:7">זע, איך העלף מײַן פֿאָלק, פֿון דעם לאַנד פֿון זונאױפֿגאַנג,</para>
  <para style="q" vid="ZEC 8:7">און פֿון דעם לאַנד פֿון זון-אונטערגאַנג.<verse eid="ZEC 8:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEC 8:8" />און איך װעל זײ ברענגען,</para>
  <para style="q" vid="ZEC 8:8">און זײ װעלן װױנען אין ירושָלַיִם,</para>
  <para style="q" vid="ZEC 8:8">און זײ װעלן זײַן מײַן פֿאָלק,</para>
  <para style="q" vid="ZEC 8:8">און איך װעל זײַן זײער אלֹקים,</para>
  <para style="q" vid="ZEC 8:8">מיט אמת און מיט גערעכטיקײט.<verse eid="ZEC 8:8" /></para>
  <para style="b" />
  <para style="p">
    <verse number="9" style="v" sid="ZEC 8:9" />אַזױ האָט געזאָגט ה׳ צבָֿאוֹת: זאָלן געשטאַרקט זײַן אײַערע הענט, איר װאָס הערט אײַן אין די דאָזיקע טעג די דאָזיקע װערטער פֿון דעם מױל פֿון די נבֿיאים װאָס זײַנען געװען אין דעם טאָג װאָס דאָס הױז פֿון ה׳ צבָֿאוֹת, דער הֵיכל, איז געגרונטפֿעסט געװאָרן געבױט צו װערן. <verse eid="ZEC 8:9" /><verse number="10" style="v" sid="ZEC 8:10" />װאָרעם פֿאַר יענע טעג איז קײן לױן פֿאַרן מענטשן נישט געװען, און קײן לױן פֿאַר דער בהמה איז נישט געװען, און פֿאַר דעם אַרױסגײער און פֿאַר דעם אַרײַנגײער איז נישט געװען קײן זיכערקײט פֿון דעם פֿײַנט, און איך פֿלעג אָנשיקן אַלע מענטשן אײנעם אױפֿן אַנדערן. <verse eid="ZEC 8:10" /><verse number="11" style="v" sid="ZEC 8:11" />אָבער אַצונד װעל איך נישט זײַן צו דעם איבערבלײַב פֿון דעם דאָזיקן פֿאָלק אַזױ װי אין די פֿריִערדיקע טעג, זאָגט ה׳ צבָֿאוֹת.<verse eid="ZEC 8:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ZEC 8:12" />װאָרעם דער זאָמען פֿון שלום װעט זײַן,</para>
  <para style="q" vid="ZEC 8:12">אַז דער װײַנשטאָק װעט געבן זײַן פֿרוכט,</para>
  <para style="q" vid="ZEC 8:12">און די ערד װעט געבן איר געװעקס,</para>
  <para style="q" vid="ZEC 8:12">און די הימלען װעלן געבן זײער טױ;</para>
  <para style="q" vid="ZEC 8:12">און איך װעל דעם איבערבלײַב פֿון דעם דאָזיקן פֿאָלק,</para>
  <para style="q" vid="ZEC 8:12">מאַכן אַרבן אַל דאָס דאָזיקע.<verse eid="ZEC 8:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEC 8:13" />און עס װעט זײַן,</para>
  <para style="q" vid="ZEC 8:13">אַזױ װי איר זײַט געװען אַ קללה צװישן די פֿעלקער,</para>
  <para style="q" vid="ZEC 8:13">איר הױז פֿון יהוּדה און הױז פֿון יִשׂרָאֵל,</para>
  <para style="q" vid="ZEC 8:13">אַזױ װעל איך אײַך העלפֿן,</para>
  <para style="q" vid="ZEC 8:13">און איר װעט װערן אַ ברכה;</para>
  <para style="q" vid="ZEC 8:13">איר זאָלט נישט מורא האָבן; זאָלן געשטאַרקט זײַן אײַערע הענט.<verse eid="ZEC 8:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEC 8:14" />װאָרעם אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 8:14">אַזױ װי איך האָב באַדאַכט אײַך שלעכטס צו טאָן,</para>
  <para style="q" vid="ZEC 8:14">װען אײַערע עלטערן האָבן מיך דערצערנט,</para>
  <para style="q" vid="ZEC 8:14">זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ZEC 8:14">און איך האָב נישט חרטה געהאַט,<verse eid="ZEC 8:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEC 8:15" />אַזױ האָב איך װידער באַדאַכט אין די דאָזיקע טעג</para>
  <para style="q" vid="ZEC 8:15">צו באַגיטיקן ירושָלַיִם און דאָס הױז פֿון יהוּדה;</para>
  <para style="q" vid="ZEC 8:15">איר זאָלט נישט מורא האָבן.<verse eid="ZEC 8:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEC 8:16" />דאָס זײַנען די זאַכן װאָס איר זאָלט טאָן:</para>
  <para style="q" vid="ZEC 8:16">רעדט אמת אײנער מיטן אַנדערן,</para>
  <para style="q" vid="ZEC 8:16">אמת און אַ פֿרידלעכן משפּט</para>
  <para style="q" vid="ZEC 8:16">טוט משפּטן אין אײַערע טױערן.<verse eid="ZEC 8:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEC 8:17" />און אײנער דעם אַנדערנס רעה</para>
  <para style="q" vid="ZEC 8:17">זאָלט איר נישט טראַכטן אין אײַער האַרצן,</para>
  <para style="q" vid="ZEC 8:17">און קײן פֿאַלשע שבֿועה זאָלט איר נישט ליב האָבן,</para>
  <para style="q" vid="ZEC 8:17">װאָרעם דאָס אַלץ איז װאָס איך האָב פֿײַנט,</para>
  <para style="q" vid="ZEC 8:17">זאָגט ה׳.<verse eid="ZEC 8:17" /></para>
  <para style="b" />
  <para style="p">
    <verse number="18" style="v" sid="ZEC 8:18" />און דאָס װאָרט פֿון ה׳ צבָֿאוֹת איז געװען צו מיר, אַזױ צו זאָגן: <verse eid="ZEC 8:18" /><verse number="19" style="v" sid="ZEC 8:19" />אַזױ האָט געזאָגט ה׳ צבָֿאוֹת: דער תָּענית פֿון פֿירטן חודש, און דער תָּענית פֿון פֿינפֿטן, און דער תָּענית פֿון זיבעטן, און דער תָּענית פֿון צענטן, װעט זײַן דעם הױז פֿון יהוּדה פֿאַר אַ פֿרײד און פֿאַר אַ שׂימחה, און פֿאַר יוֹם-טובֿים; נאָר האָט ליב אמת און שלום.<verse eid="ZEC 8:19" /></para>
  <para style="b" />
  <para style="q">
    <verse number="20" style="v" sid="ZEC 8:20" />אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 8:20">עס װעט נאָך געשען,</para>
  <para style="q" vid="ZEC 8:20">אַז קומען װעלן פֿעלקער</para>
  <para style="q" vid="ZEC 8:20">און באַװױנער פֿון פֿיל שטעט;<verse eid="ZEC 8:20" /></para>
  <para style="q">
    <verse number="21" style="v" sid="ZEC 8:21" />און די באַװױנער פֿון אײן שטאָט</para>
  <para style="q" vid="ZEC 8:21">װעלן גײן צו דער אַנדערער, אַזױ צו זאָגן:</para>
  <para style="q" vid="ZEC 8:21">גײן לאָמיר גײן צו בעטן פֿאַר ה׳,</para>
  <para style="q" vid="ZEC 8:21">און צו זוכן דעם ה׳ צבָֿאוֹת;</para>
  <para style="q" vid="ZEC 8:21">איך װיל אױך גײן.<verse eid="ZEC 8:21" /></para>
  <para style="q">
    <verse number="22" style="v" sid="ZEC 8:22" />און קומען װעלן פֿיל אומות און מאַכטיקע פֿעלקער</para>
  <para style="q" vid="ZEC 8:22">צו זוכן ה׳ צבָֿאוֹת אין ירושָלַיִם,</para>
  <para style="q" vid="ZEC 8:22">און צו בעטן פֿאַר ג-ט.<verse eid="ZEC 8:22" /></para>
  <para style="q">
    <verse number="23" style="v" sid="ZEC 8:23" />אַזױ האָט געזאָגט ה׳ צבָֿאוֹת:</para>
  <para style="q" vid="ZEC 8:23">אין יענע טעג װעט געשען,</para>
  <para style="q" vid="ZEC 8:23">אַז אָננעמען װעלן צען מענטשן</para>
  <para style="q" vid="ZEC 8:23">פֿון אַלערלײ לשוֹנות פֿון די פֿעלקער –</para>
  <para style="q" vid="ZEC 8:23">אָננעמען דעם ברעג קלײד פֿון אַ ייִדן,</para>
  <para style="q" vid="ZEC 8:23">אַזױ צו זאָגן: לאָמיר גײן מיט אײַך,</para>
  <para style="q" vid="ZEC 8:23">װאָרעם מיר האָבן געהערט אַז אלֹקים איז מיט אײַך.<verse eid="ZEC 8:23" /></para>
  <chapter eid="ZEC 8" />
  <chapter number="9" style="c" pubnumber="ט" sid="ZEC 9" />
  <para style="p">
    <verse number="1" style="v" sid="ZEC 9:1" />די נבֿואה פֿון ה׳ס װאָרט:</para>
  <para style="q" vid="ZEC 9:1">אין לאַנד חדרָך און דַמֶשֶׂק</para>
  <para style="q" vid="ZEC 9:1">װעט זײַן זײַן לאַגערונג –</para>
  <para style="q" vid="ZEC 9:1">װאָרעם צו ג-ט איז דאָס אױג פֿון מענטשן,</para>
  <para style="q" vid="ZEC 9:1">װי פֿון אַלע שבֿטים פֿון יִשׂרָאֵל –<verse eid="ZEC 9:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEC 9:2" />און אױך אין חַמָת װאָס גרענעצט זיך דערמיט,</para>
  <para style="q" vid="ZEC 9:2">און אין צוֹר און צידון װי זײער קלוג זי איז.<verse eid="ZEC 9:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEC 9:3" />און צוֹר האָט זיך אַ פֿעסטונג געבױט,</para>
  <para style="q" vid="ZEC 9:3">און אָנגעקליבן זילבער װי שטױב,</para>
  <para style="q" vid="ZEC 9:3">און גינגאָלד װי קױט פֿון די גאַסן.<verse eid="ZEC 9:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEC 9:4" />זע, אֲדֹנָי װעט זי פֿאַראָרימען,</para>
  <para style="q" vid="ZEC 9:4">און ער װעט שלײַדערן אין ים איר מאַכט,</para>
  <para style="q" vid="ZEC 9:4">און זי װעט אין פֿײַער פֿאַרצערט װערן.<verse eid="ZEC 9:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEC 9:5" />אַשקלוֹן װעט זען און װעט מורא האָבן,</para>
  <para style="q" vid="ZEC 9:5">און עַזָה – און זי װעט ציטערן זײער,</para>
  <para style="q" vid="ZEC 9:5">און עֶקרוֹן – װײַל צו שאַנד געװאָרן איז איר אױסקוק;</para>
  <para style="q" vid="ZEC 9:5">און אונטערגײן װעט אַ מלך פֿון עַזָה,</para>
  <para style="q" vid="ZEC 9:5">און אַשקלוֹן װעט זײַן נישט באַװױנט.<verse eid="ZEC 9:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEC 9:6" />און אַ ממזר-פֿאָלק װעט זיצן אין אַשדוֹד,</para>
  <para style="q" vid="ZEC 9:6">און איך װעל פֿאַרשנײַדן דעם שטאָלץ פֿון די פּלִשתּים.<verse eid="ZEC 9:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEC 9:7" />און איך װעל אָפּטאָן זײַן בלוט פֿון זײַן מױל,</para>
  <para style="q" vid="ZEC 9:7">און זײַנע אומװערדיקײטן פֿון צװישן זײַנע צײן,</para>
  <para style="q" vid="ZEC 9:7">און ער אױך װעט בלײַבן בײַ אלוקינו;</para>
  <para style="q" vid="ZEC 9:7">און ער װעט זײַן װי אַ פֿירשט אין יהוּדה,</para>
  <para style="q" vid="ZEC 9:7">און עֶקרוֹן װעט זײַן װי דער יבֿוסי.<verse eid="ZEC 9:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEC 9:8" />און איך װעל לאַגערן אַרום מײַן הױז אַקעגן חיל,</para>
  <para style="q" vid="ZEC 9:8">אַקעגן גײער און אַקעגן קומער,</para>
  <para style="q" vid="ZEC 9:8">און מער װעט נישט דורכגײן דורך זײ קײן דריקער;</para>
  <para style="q" vid="ZEC 9:8">װאָרעם אַצונד האָב איך געזען מיט מײַנע אױגן.<verse eid="ZEC 9:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ZEC 9:9" />פֿרײ זיך זײער, טאָכטער צִיוֹן,</para>
  <para style="q" vid="ZEC 9:9">שאַל, טאָכטער ירושָלַיִם,</para>
  <para style="q" vid="ZEC 9:9">זע, דײַן מלך װעט קומען צו דיר,</para>
  <para style="q" vid="ZEC 9:9">אַ גערעכטער און אַ זיגער איז ער;</para>
  <para style="q" vid="ZEC 9:9">אַן ענװ, און רײַט אױף אַן אײזל,</para>
  <para style="q" vid="ZEC 9:9">אױף אַ יונגן זון פֿון אַן אײזעלין.<verse eid="ZEC 9:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEC 9:10" />און איך װעל פֿאַרשנײַדן אַ רײַטװאָגן פֿון אפֿרים,</para>
  <para style="q" vid="ZEC 9:10">און אַ פֿערד פֿון ירושָלַיִם,</para>
  <para style="q" vid="ZEC 9:10">און פֿאַרשניטן װעט װערן דער בױגן פֿון מלחמה;</para>
  <para style="q" vid="ZEC 9:10">און ער װעט רעדן שלום צו די פֿעלקער,</para>
  <para style="q" vid="ZEC 9:10">און זײַן געװעלטיקונג װעט זײַן פֿון ים ביז ים,</para>
  <para style="q" vid="ZEC 9:10">און פֿון טײַך ביז די עקן פֿון דער ערד.<verse eid="ZEC 9:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEC 9:11" />יאָ דו – פֿאַר דעם בלוט פֿון דײַן ברית,</para>
  <para style="q" vid="ZEC 9:11">לאָז איך אַרױס דײַנע געפֿאַנגענע</para>
  <para style="q" vid="ZEC 9:11">פֿון דער גרוב אָן װאַסער דרינען.<verse eid="ZEC 9:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEC 9:12" />קערט אײַך אום צו באַפֿעסטיקײט,</para>
  <para style="q" vid="ZEC 9:12">איר געפֿאַנגענע פֿון האָפֿענונג;</para>
  <para style="q" vid="ZEC 9:12">נאָך הײַנט זאָג איך אָן:</para>
  <para style="q" vid="ZEC 9:12">טאָפּל װעל איך דיר אומקערן.<verse eid="ZEC 9:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEC 9:13" />װאָרעם איך שפּאַן מיר אָן יהוּדה,</para>
  <para style="q" vid="ZEC 9:13">װי אַ בױגן צי איך אָן אפֿרים,</para>
  <para style="q" vid="ZEC 9:13">און איך װעל דערװעקן דײַנע קינדער, צִיוֹן,</para>
  <para style="q" vid="ZEC 9:13">אױף דײַנע קינדער, יָוָן,</para>
  <para style="q" vid="ZEC 9:13">און איך װעל דיך מאַכן װי די שװערד פֿון אַ גיבור.<verse eid="ZEC 9:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ZEC 9:14" />און ה׳ װעט זיך באַװײַזן איבער זײ,</para>
  <para style="q" vid="ZEC 9:14">און אַרױסגײן װי אַ בליץ װעט זײַן פֿײַל;</para>
  <para style="q" vid="ZEC 9:14">און אֲדֹנָי ה׳ װעט בלאָזן אין שופֿר,</para>
  <para style="q" vid="ZEC 9:14">און װעט קומען מיט שטורעמס פֿון דָרום.<verse eid="ZEC 9:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEC 9:15" />ה׳ צבָֿאוֹת װעט זײ באַשירעמען,</para>
  <para style="q" vid="ZEC 9:15">און זײ װעלן פֿאַרצערן, און צעטרעטן די שלײַדער-שטײנער,</para>
  <para style="q" vid="ZEC 9:15">און זײ װעלן טרינקען און טומלען װי פֿון װײַן,</para>
  <para style="q" vid="ZEC 9:15">און זײ װעלן פֿול זײַן װי די בעקנס,</para>
  <para style="q" vid="ZEC 9:15">װי די װינקלען פֿון מזבח.<verse eid="ZEC 9:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEC 9:16" />און ה׳ זײער ג-ט װעט זײ העלפֿן אין יענעם טאָג,</para>
  <para style="q" vid="ZEC 9:16">װי שאָף – זײַן פֿאָלק;</para>
  <para style="q" vid="ZEC 9:16">װאָרעם װי קרױנשטײנער גלאַנציקע</para>
  <para style="q" vid="ZEC 9:16">װעלן זײ זײַן אױף זײַן ערד.<verse eid="ZEC 9:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEC 9:17" />פֿאַר װאָר, װאָס פֿאַר אַ װױלקײט װעט זײַן זײערס!</para>
  <para style="q" vid="ZEC 9:17">און װאָס פֿאַר אַ שײנקײט װעט זײַן זײערס!</para>
  <para style="q" vid="ZEC 9:17">װי קאָרן די בחורים,</para>
  <para style="q" vid="ZEC 9:17">װי װײַן װאָס טוט ייִרן די יונגפֿרױען.<verse eid="ZEC 9:17" /></para>
  <chapter eid="ZEC 9" />
  <chapter number="10" style="c" pubnumber="י" sid="ZEC 10" />
  <para style="q">
    <verse number="1" style="v" sid="ZEC 10:1" />בעט בײַ ה׳ רעגן אין דער צײַט פֿון שפּעטרעגן,</para>
  <para style="q" vid="ZEC 10:1">בײַ ה׳ װאָס מאַכט בליצן;</para>
  <para style="q" vid="ZEC 10:1">און ער װעט זײ געבן אַ גוסרעגן,</para>
  <para style="q" vid="ZEC 10:1">איטלעכן – גראָז אױפֿן פֿעלד.<verse eid="ZEC 10:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEC 10:2" />װאָרעם די תּרָפֿים האָבן גערעדט נישטיקײט,</para>
  <para style="q" vid="ZEC 10:2">און די װאָרזאָגער האָבן געזען ליגן,</para>
  <para style="q" vid="ZEC 10:2">און די חלומות רעדן פֿאַלש,</para>
  <para style="q" vid="ZEC 10:2">נישטיק טוען זײ טרײסטן.</para>
  <para style="q" vid="ZEC 10:2">דערום האָבן זײ אומגעװאַנדערט אַזױ װי שאָף,</para>
  <para style="q" vid="ZEC 10:2">זײ פּלאָגן זיך, װײַל קײן פּאַסטוך איז נישטאָ.<verse eid="ZEC 10:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ZEC 10:3" />אױף די פּאַסטוכער גרימט מײַן צאָרן,</para>
  <para style="q" vid="ZEC 10:3">און מיט די בעק װעל איך זיך אָפּרעכענען;</para>
  <para style="q" vid="ZEC 10:3">װאָרעם ה׳ צבָֿאוֹת האָט געדאַכט אָן זײַן סטאַדע,</para>
  <para style="q" vid="ZEC 10:3">דעם הױז פֿון יהוּדה,</para>
  <para style="q" vid="ZEC 10:3">און מאַכט זײ װי זײַן פּראַכטפֿערד אין מלחמה.<verse eid="ZEC 10:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEC 10:4" />פֿון אים דער װינקלשטײן,</para>
  <para style="q" vid="ZEC 10:4">פֿון אים דאָס פֿלעקל,</para>
  <para style="q" vid="ZEC 10:4">פֿון אים דער בױגן פֿון מלחמה,</para>
  <para style="q" vid="ZEC 10:4">פֿון אים װעט אַרױסגײן יעטװעדער געװעלטיקער באַגלײַך.<verse eid="ZEC 10:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEC 10:5" />און זײ װעלן זײַן װי גיבוֹרים</para>
  <para style="q" vid="ZEC 10:5">װאָס טרעטן דעם קױט פֿון די גאַסן אין מלחמה,</para>
  <para style="q" vid="ZEC 10:5">און זײ װעלן בײַקומען, װאָרעם ה׳ װעט זײַן מיט זײ,</para>
  <para style="q" vid="ZEC 10:5">און די רײַטער אױף פֿערד װעלן פֿאַרשעמט װערן.<verse eid="ZEC 10:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEC 10:6" />און איך װעל שטאַרקן דאָס הױז פֿון יהוּדה,</para>
  <para style="q" vid="ZEC 10:6">און דאָס הױז פֿון יוֹסף װעל איך העלפֿן,</para>
  <para style="q" vid="ZEC 10:6">און איך װעל זײ אומקערן, װאָרעם איך טו זײ דערבאַרעמען;</para>
  <para style="q" vid="ZEC 10:6">און זײ װעלן זײַן װי איך װאָלט זײ קײן מאָל נישט פֿאַרלאָזט,</para>
  <para style="q" vid="ZEC 10:6">װאָרעם איך בין ה׳ זײער ג-ט, און װעל זײ ענטפֿערן.<verse eid="ZEC 10:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEC 10:7" />און אפֿרים װעט זײַן װי אַ גיבור,</para>
  <para style="q" vid="ZEC 10:7">און זײער האַרץ װעט זײַן פֿרײלעך װי פֿון װײַן;</para>
  <para style="q" vid="ZEC 10:7">און זײערע זין װעלן זען און זיך פֿרײען,</para>
  <para style="q" vid="ZEC 10:7">זײער האַרץ װעט זײַן לוסטיק מיט ה׳.<verse eid="ZEC 10:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ZEC 10:8" />איך װעל שמוצערן צו זײ, און װעל זײ אײַנזאַמלען,</para>
  <para style="q" vid="ZEC 10:8">װאָרעם איך טו זײ אױסלײזן;</para>
  <para style="q" vid="ZEC 10:8">און זײ װעלן זיך מערן װי זײ האָבן זיך געמערט.<verse eid="ZEC 10:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEC 10:9" />יאָ, איך װעל זײ צעזײען צװישן די פֿעלקער,</para>
  <para style="q" vid="ZEC 10:9">אָבער אין די װײַטענישן װעלן זײ מיך דערמאָנען,</para>
  <para style="q" vid="ZEC 10:9">און זײ װעלן דערלעבן מיט זײערע קינדער,</para>
  <para style="q" vid="ZEC 10:9">און װעלן זיך אומקערן.<verse eid="ZEC 10:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEC 10:10" />און איך װעל זײ אומקערן פֿון לאַנד מִצרַיִם,</para>
  <para style="q" vid="ZEC 10:10">און פֿון אשור װעל איך זײ אײַנזאַמלען;</para>
  <para style="q" vid="ZEC 10:10">און קײן לאַנד גִלעָד און לבֿנוֹן װעל איך זײ ברענגען,</para>
  <para style="q" vid="ZEC 10:10">און עס װעט זײ נישט קלעקן.<verse eid="ZEC 10:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEC 10:11" />און אַן אַנגסט װעט אַריבערגײן איבערן ים,</para>
  <para style="q" vid="ZEC 10:11">און ער װעט שלאָגן װעלן אױפֿן ים,</para>
  <para style="q" vid="ZEC 10:11">און אױסגעטריקנט װעלן װערן אַלע טיפֿענישן פֿון נילוס,</para>
  <para style="q" vid="ZEC 10:11">און גענידערט װעט װערן דער שטאָלץ פֿון אשור,</para>
  <para style="q" vid="ZEC 10:11">און דער צעפּטער פֿון מִצרַיִם װעט אָפּגעטאָן װערן.<verse eid="ZEC 10:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEC 10:12" />און איך װעל זײ שטאַרקן מיט ה׳,</para>
  <para style="q" vid="ZEC 10:12">און אין זײַן נאָמען װעלן זײ גײן, זאָגט ה׳.<verse eid="ZEC 10:12" /></para>
  <chapter eid="ZEC 10" />
  <chapter number="11" style="c" pubnumber="יא" sid="ZEC 11" />
  <para style="q">
    <verse number="1" style="v" sid="ZEC 11:1" />עפֿן, לבֿנוֹן, דײַנע טירן,</para>
  <para style="q" vid="ZEC 11:1">און זאָל אַ פֿײַער פֿאַרצערן דײַנע צעדערן;<verse eid="ZEC 11:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEC 11:2" />יאָמער, ציפּרעס, װאָרעם דער צעדער איז געפֿאַלן,</para>
  <para style="q" vid="ZEC 11:2">װײַל די מאַכטיקע זײַנען פֿאַרװיסט געװאָרן;</para>
  <para style="q" vid="ZEC 11:2">יאָמערט, אײכנבײמער פֿון בָשָן,</para>
  <para style="q" vid="ZEC 11:2">װאָרעם דער פֿעסטער װאַלד איז גענידערט.<verse eid="ZEC 11:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEC 11:3" />האָרך! אַ יללה פֿון די פּאַסטוכער,</para>
  <para style="q" vid="ZEC 11:3">װאָרעם פֿאַרװיסט געװאָרן איז זײער פּראַכט.</para>
  <para style="q" vid="ZEC 11:3">האָרך! אַ געבריל פֿון יונגלײבן,</para>
  <para style="q" vid="ZEC 11:3">װאָרעם פֿאַרװיסט געװאָרן איז דאָס געװעלד פֿון יַרדן.<verse eid="ZEC 11:3" /></para>
  <para style="b" />
  <para style="p">
    <verse number="4" style="v" sid="ZEC 11:4" />אַזױ האָט געזאָגט ה׳ מײַן ג-ט: פֿיטער די שאָף פֿון טײטונג, <verse eid="ZEC 11:4" /><verse number="5" style="v" sid="ZEC 11:5" />װאָס זײערע קױפֿער טײטן זײ, און װערן נישט שולדיק, און זײערע פֿאַרקױפֿער זאָגן: ברוך ה׳, װאָרעם איך װער רײַך; און זײערע פּאַסטוכער דערבאַרעמען זיך נישט אױף זײ. <verse eid="ZEC 11:5" /><verse number="6" style="v" sid="ZEC 11:6" />װאָרעם איך װעל זיך נישט מער דערבאַרעמען אױף די באַװױנער פֿון לאַנד, זאָגט ה׳, און זע, איך ענטפֿער איבער דעם מענטשן, איטלעכן אין דער האַנט פֿון זײַן חבֿר, און אין דער האַנט פֿון זײַן מלך, און זײ װעלן צעשטױסן דאָס לאַנד, און איך װעל נישט מציל זײַן פֿון זײער האַנט.<verse eid="ZEC 11:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 11:7" />און איך האָב געפֿיטערט די שאָף פֿון טײטונג, פֿאַר װאָר, די אָרימסטע פֿון די שאָף, און איך האָב מיר גענומען צװײ שטעקנס, אײנעם האָב איך גערופֿן חֵן, און אײנעם האָב איך גערופֿן פֿאַרבינדונג, און איך האָב געפֿיטערט די שאָף. <verse eid="ZEC 11:7" /><verse number="8" style="v" sid="ZEC 11:8" />און איך האָב פֿאַרטיליקט די דרײַ פּאַסטוכער אין אײן חודש. און מײַן זעל איז געװאָרן אומגעדולדיק מיט זײ, און אױך זײער זעל האָט זיך געעקלט מיט מיר. <verse eid="ZEC 11:8" /><verse number="9" style="v" sid="ZEC 11:9" />און איך האָב געזאָגט:</para>
  <para style="b" vid="ZEC 11:9" />
  <para style="q" vid="ZEC 11:9">איך װעל אײַך נישט פֿיטערן;</para>
  <para style="q" vid="ZEC 11:9">די װאָס שטאַרבט, זאָל שטאַרבן,</para>
  <para style="q" vid="ZEC 11:9">און די װאָס װערט פֿאַרטיליקט, זאָל פֿאַרטיליקט װערן,</para>
  <para style="q" vid="ZEC 11:9">און די איבעריקע זאָלן עסן אײנע דער אַנדערנס פֿלײש.<verse eid="ZEC 11:9" /></para>
  <para style="b" />
  <para style="p">
    <verse number="10" style="v" sid="ZEC 11:10" />און איך האָב גענומען מײַן שטעקן חֵן, און האָב אים צעהאַקט, כּדי צו פֿאַרשטערן מײַן ברית װאָס איך האָב געשלאָסן מיט אַלע פֿעלקער. <verse eid="ZEC 11:10" /><verse number="11" style="v" sid="ZEC 11:11" />און ער איז פֿאַרשטערט געװאָרן אין יענעם טאָג, און די אָרימסטע פֿון שאָף װאָס האָבן זיך געהאַלטן אָן מיר, האָבן געװוּסט זיכער אַז דאָס איז דאָס װאָרט פֿון ה׳. <verse eid="ZEC 11:11" /><verse number="12" style="v" sid="ZEC 11:12" />און איך האָב צו זײ געזאָגט: אױב עס איז גוט אין אײַערע אױגן, גיט מיר מײַן לױן, און אױב נישט, פֿאַרמײַדט אײַך. האָבן זײ אָפּגעװױגן מײַן לױן דרײַסיק זילבערשטיק. <verse eid="ZEC 11:12" /><verse number="13" style="v" sid="ZEC 11:13" />האָט ג-ט געזאָגט צו מיר: װאַרף אים אַרײַן אין דער שאַצקאַמער, דעם שײנעם װערט װאָס איך בין װערט בײַ זײ. און איך האָב גענומען די דרײַסיק זילבערשטיק, און האָב עס אַרײַנגעװאָרפֿן אין הױז פֿון ה׳, אין דער שאַצקאַמער. <verse eid="ZEC 11:13" /><verse number="14" style="v" sid="ZEC 11:14" />און איך האָב צעהאַקט מײַן צװײטן שטעקן, פֿאַרבינדונג, כּדי צו פֿאַרשטערן די ברידערשאַפֿט צװישן יהוּדה און צװישן יִשׂרָאֵל.<verse eid="ZEC 11:14" /></para>
  <para style="b" />
  <para style="p">
    <verse number="15" style="v" sid="ZEC 11:15" />און ה׳ האָט צו מיר געזאָגט: נעם דיר נאָך די כּלים פֿון אַ נאַרישן פּאַסטוך. <verse eid="ZEC 11:15" /><verse number="16" style="v" sid="ZEC 11:16" />װאָרעם זע, איך שטעל אױף אַ פּאַסטוך אין לאַנד, װאָס אום די פֿאַרטיליקטע װעט ער זיך נישט קימערן; די יונגע װעט ער נישט אױפֿזוכן, און די צעבראָכענע װעט ער נישט הײלן, די געזונטע װעט ער נישט שפּײַזן, און דאָס פֿלײש פֿון דער פֿעטער װעט ער אױפֿעסן, און זײערע קלױען װעט ער צעקנאַקן.<verse eid="ZEC 11:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ZEC 11:17" />װײ צו דעם נישטיקן פּאַסטוך,</para>
  <para style="q" vid="ZEC 11:17">װאָס פֿאַרלאָזט די שאָף!</para>
  <para style="q" vid="ZEC 11:17">אַ שװערד אױף זײַן אָרעם,</para>
  <para style="q" vid="ZEC 11:17">און אױף זײַן רעכטן אױג!</para>
  <para style="q" vid="ZEC 11:17">זײַן אָרעם זאָל דאַרן אײַנגעדאַרט װערן,</para>
  <para style="q" vid="ZEC 11:17">און זײַן רעכט אױג זאָל טונקל פֿאַרטונקלט װערן!<verse eid="ZEC 11:17" /></para>
  <chapter eid="ZEC 11" />
  <chapter number="12" style="c" pubnumber="יב" sid="ZEC 12" />
  <para style="p">
    <verse number="1" style="v" sid="ZEC 12:1" />די נבֿואה פֿון ה׳ס װאָרט אױף יִשׂרָאֵל:</para>
  <para style="b" vid="ZEC 12:1" />
  <para style="p" vid="ZEC 12:1">אַזױ זאָגט ה׳, װאָס האָט אױסגעשפּרײט די הימלען, און געגרונטפֿעסט די ערד, און געפֿורעמט דעם גײַסט פֿון מענטשן אין אים. <verse eid="ZEC 12:1" /><verse number="2" style="v" sid="ZEC 12:2" />זע, איך מאַך ירושָלַיִם פֿאַר אַ בעכער פֿון פֿאַרטומלעניש פֿאַר אַלע אומות רונד אַרום; און אױך יהוּדה װעט מוזן זײַן אין באַלעגערונג אױף ירושָלַיִם. <verse eid="ZEC 12:2" /><verse number="3" style="v" sid="ZEC 12:3" />און עס װעט זײַן אין יענעם טאָג, װעל איך מאַכן ירושָלַיִם אַ לאַסטשטײן פֿאַר אַלע אומות, אַלע װאָס לאָדן זי אױף זיך װעלן זיך װוּנדן אָנרײַסן; און אײַנזאַמלען װעלן זיך אַקעגן איר אַלע פֿעלקער פֿון דער ערד. <verse eid="ZEC 12:3" /><verse number="4" style="v" sid="ZEC 12:4" />אין יענעם טאָג, זאָגט ה׳, װעל איך שלאָגן איטלעך פֿערד מיט צעדולטקײט, און זײַן רײַטער מיט משוגעת; און אױף דעם הױז פֿון יהוּדה װעל איך האַלטן אָפֿן מײַנע אױגן. און איטלעך פֿערד פֿון די אומות װעל איך שלאָגן מיט בלינדקײט. <verse eid="ZEC 12:4" /><verse number="5" style="v" sid="ZEC 12:5" />און די פֿירשטן פֿון יהוּדה װעלן זאָגן אין זײער האַרצן: אַ שטאַרקײט זײַנען צו מיר די באַװױנער פֿון ירושָלַיִם, דורך ה׳ צבָֿאוֹת זײער ג-ט.<verse eid="ZEC 12:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 12:6" />אין יענעם טאָג װעל איך מאַכן די פֿירשטן פֿון יהוּדה װי אַ פֿײַערטאָפּ צװישן האָלץ, און װי אַ בראַנדהאָלץ צװישן גאַרבן, און זײ װעלן פֿאַרצערן אױף רעכטס און אױף לינקס אַלע אומות רונד אַרום; און ירושָלַיִם װעט װידער זיצן אױף איר אָרט – אין ירושָלַיִם.<verse eid="ZEC 12:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="ZEC 12:7" />און ה׳ װעט העלפֿן די געצעלטן פֿון יהוּדה צום ערשטן, כּדי די פּראַכט פֿון דעם הױז פֿון דָוִד, און די פּראַכט פֿון די באַװױנער פֿון ירושָלַיִם, זאָל זיך נישט גרײסן איבער יהוּדה. <verse eid="ZEC 12:7" /><verse number="8" style="v" sid="ZEC 12:8" />אין יענעם טאָג װעט ה׳ באַשירעמען די באַװױנער פֿון ירושָלַיִם, און דער געפֿאַלענער צװישן זײ װעט אין יענעם טאָג זײַן װי דָוִד, און דאָס הױז פֿון דָוִד װי אלֹקים, און װי דער מלאך פֿון ה׳ פֿאַר זײ. <verse eid="ZEC 12:8" /><verse number="9" style="v" sid="ZEC 12:9" />און עס װעט זײַן אין יענעם טאָג, װעל איך זוכן צו פֿאַרטיליקן אַלע פֿעלקער װאָס קומען אױף ירושָלַיִם.<verse eid="ZEC 12:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 12:10" />און איך װעל אױסגיסן אױף דעם הױז פֿון דָוִד, און אױף די באַװױנער פֿון ירושָלַיִם, דעם רוּחַ פֿון חֵן און געבעטן, און זײ װעלן אױף מיר קוקן װעמען זײ האָבן דורכגעשטאָכן, און זײ װעלן איבער אים קלאָגן אַזױ װי מע קלאָגט איבער אַן אײנאײנציקן, און זײ װעלן זײַן אין ביטערקײט איבער אים, אַזױ װי מע איז אין ביטערקײט װעגן אַ בכור. <verse eid="ZEC 12:10" /><verse number="11" style="v" sid="ZEC 12:11" />אין יענעם טאָג װעט גרױס זײַן די קלאָג אין ירושָלַיִם, אַזױ װי די קלאָג פֿון הַדַד-רִמוֹן אין טאָל מגִדוֹן. <verse eid="ZEC 12:11" /><verse number="12" style="v" sid="ZEC 12:12" />און דאָס לאַנד װעט קלאָגן משפּחות משפּחות באַזונדער; די משפּחות פֿון דעם הױז פֿון דָוִד באַזונדער, און זײערע װײַבער באַזונדער; די משפּחה פֿון דעם הױז פֿון נָתָן באַזונדער, און זײערע װײַבער באַזונדער; <verse eid="ZEC 12:12" /><verse number="13" style="v" sid="ZEC 12:13" />די משפּחה פֿון דעם הױז פֿון לֵוִי באַזונדער, און זײערע װײַבער באַזונדער; די משפּחה פֿון די שִמעִים באַזונדער, און זײערע װײַבער באַזונדער; <verse eid="ZEC 12:13" /><verse number="14" style="v" sid="ZEC 12:14" />אַלע משפּחות װאָס זײַנען געבליבן, משפּחות משפּחות באַזונדער, און זײערע װײַבער באַזונדער.<verse eid="ZEC 12:14" /></para>
  <chapter eid="ZEC 12" />
  <chapter number="13" style="c" pubnumber="יג" sid="ZEC 13" />
  <para style="q">
    <verse number="1" style="v" sid="ZEC 13:1" />אין יענעם טאָג װעט זיך עפֿענען אַ קװאַל</para>
  <para style="q" vid="ZEC 13:1">פֿאַר דעם הױז פֿון דָוִד, און פֿאַר די באַװױנער פֿון ירושָלַיִם,</para>
  <para style="q" vid="ZEC 13:1">פֿאַר זינד און פֿון װאָס איז אומרײן.<verse eid="ZEC 13:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEC 13:2" />און עס װעט זײַן אין יענעם טאָג,</para>
  <para style="q" vid="ZEC 13:2">זאָגט ה׳ צבָֿאוֹת,</para>
  <para style="q" vid="ZEC 13:2">װעל איך פֿאַרשנײַדן די נעמען פֿון די געצנבילדער, פֿון לאַנד,</para>
  <para style="q" vid="ZEC 13:2">און זײ װעלן מער נישט געדאַכט װערן;</para>
  <para style="q" vid="ZEC 13:2">און אױך די נבֿיאים און דעם גײַסט פֿון אומרײנקײט</para>
  <para style="q" vid="ZEC 13:2">װעל איך אָפּשאַפֿן פֿון לאַנד.<verse eid="ZEC 13:2" /></para>
  <para style="b" />
  <para style="p">
    <verse number="3" style="v" sid="ZEC 13:3" />און עס װעט זײַן, אַז עמיצער װעט נאָך אַלץ נבֿיאות זאָגן, װעלן זאָגן צו אים זײַן פֿאָטער און זײַן מוטער װאָס האָבן אים געבאָרן: טאָרסט נישט בלײַבן לעבן, װאָרעם ליגן האָסטו געזאָגט אין נאָמען פֿון ה׳; און זײַן פֿאָטער און זײַן מוטער װאָס האָבן אים געבאָרן, װעלן אים שטעכן, אַז ער װעט נבֿיאות זאָגן. <verse eid="ZEC 13:3" /><verse number="4" style="v" sid="ZEC 13:4" />און עס װעט זײַן אין יענעם טאָג, װעלן זיך די נבֿיאים שעמען איטלעכער מיט זײַן זעונג, װען ער װעט נבֿיאות זאָגן; און זײ װעלן נישט אָנטאָן אַ האָריקן מאַנטל כּדי צו נאַרן. <verse eid="ZEC 13:4" /><verse number="5" style="v" sid="ZEC 13:5" />און ער װעט זאָגן: נישט קײן נבֿיא בין איך, איך בין אַ פּויער, װאָרעם מען האָט מיך געלערנט בהמות צו היטן פֿון מײַן יוגנט אָן. <verse eid="ZEC 13:5" /><verse number="6" style="v" sid="ZEC 13:6" />און אַז מע װעט זאָגן צו אים: װאָס זײַנען די דאָזיקע װוּנדן צװישן דײַנע הענט? װעט ער זאָגן: דאָס האָב איך געקריגן געשלאָגן אין הױז פֿון מײַנע גוטע פֿרײַנט.<verse eid="ZEC 13:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ZEC 13:7" />דערװעק זיך, שװערד, אױף מײַן פּאַסטוך,</para>
  <para style="q" vid="ZEC 13:7">און אױף דעם מאַן װאָס איך האָב מיר צוגעחבֿרט!</para>
  <para style="q" vid="ZEC 13:7">זאָגט ה׳ צבָֿאוֹת;</para>
  <para style="q" vid="ZEC 13:7">שלאָג דעם פּאַסטוך, און די שאָף זאָלן צעשפּרײט װערן;</para>
  <para style="q" vid="ZEC 13:7">און איך װעל קערן מײַן האַנט אױף די יונגען.<verse eid="ZEC 13:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEC 13:8" />און עס װעט געשען אין גאַנצן לאַנד, זאָגט ה׳;</para>
  <para style="q" vid="ZEC 13:8">צװײ טײלן דערין װעלן פֿאַרשניטן װערן און פֿאַרגײן,</para>
  <para style="q" vid="ZEC 13:8">און אַ דריט-חלק װעט בלײַבן דערין.<verse eid="ZEC 13:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEC 13:9" />און איך װעל ברענגען דעם דריט-חלק אין פֿײַער,</para>
  <para style="q" vid="ZEC 13:9">און װעל זײ לײַטערן װי מע לײַטערט זילבער,</para>
  <para style="q" vid="ZEC 13:9">און װעל זײ פּרוּװן װי מע פּרוּװט גאָלד;</para>
  <para style="q" vid="ZEC 13:9">ער װעט רופֿן מײַן נאָמען, און איך װעל אים ענטפֿערן;</para>
  <para style="q" vid="ZEC 13:9">איך זאָג: ער איז מײַן פֿאָלק,</para>
  <para style="q" vid="ZEC 13:9">און ער װעט זאָגן: ה׳ איז מײַן ג-ט.<verse eid="ZEC 13:9" /></para>
  <chapter eid="ZEC 13" />
  <chapter number="14" style="c" pubnumber="יד" sid="ZEC 14" />
  <para style="p">
    <verse number="1" style="v" sid="ZEC 14:1" />זע, אַ טאָג קומט בײַ ה׳, און דײַן רױב װעט צעטײלט װערן אין דיר. <verse eid="ZEC 14:1" /><verse number="2" style="v" sid="ZEC 14:2" />און איך װעל אײַנזאַמלען אַלע פֿעלקער קײן ירושָלַיִם אױף מלחמה; און די שטאָט װעט באַצװוּנגען װערן, און די הײַזער װעלן צערױבט װערן, און די װײַבער װעלן געשענדט װערן; און אַ האַלבע שטאָט װעט אין גלות אַװעק, אָבער דער רעשט פֿון דעם פֿאָלק װעט נישט פֿאַרשניטן װערן פֿון שטאָט. <verse eid="ZEC 14:2" /><verse number="3" style="v" sid="ZEC 14:3" />און ה׳ װעט אַרױסגײן, און װעט מלחמה האַלטן מיט יענע פֿעלקער, װי בעת זײַן מלחמה האַלטן אין טאָג פֿון שטרײַט. <verse eid="ZEC 14:3" /><verse number="4" style="v" sid="ZEC 14:4" />און זײַנע פֿיס װעלן שטײן אין יענעם טאָג אױפֿן הַר-הַזֵיתים, װאָס פֿאַר ירושָלַיִם פֿון מזרח, און דער הַר-הַזֵיתים װעט זיך שפּאַלטן איבער העלפֿט, צו מזרח און צו מערבֿ, אױף זײער אַ גרױסן טאָל; און אַ העלפֿט באַרג װעט זיך אַװעקרוקן קײן צפֿון, און אַ העלפֿט פֿון אים קײן דָרום. <verse eid="ZEC 14:4" /><verse number="5" style="v" sid="ZEC 14:5" />און איר װעט אַנטלױפֿן צום טאָל פֿון די בערג, װאָרעם דער טאָל פֿון די בערג װעט גרײכן ביז אָצַל; און איר װעט לױפֿן װי איר זײַט געלאָפֿן פֿון דער ערדציטערניש אין די טעג פֿון עוּזִיָה דעם מלך פֿון יהוּדה; און ה׳ מײַן ג-ט װעט קומען, און אַלע הײליקע מיט דיר.<verse eid="ZEC 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="ZEC 14:6" />און עס װעט זײַן: אין יענעם טאָג װעט נישט זײַן קײן ליכטיקײט, נײַערט אַ שװערקײט און פֿאַרגליװערטקײט. <verse eid="ZEC 14:6" /><verse number="7" style="v" sid="ZEC 14:7" />און עס װעט זײַן אײן לאַנגער טאָג, װאָס װעט זײַן באַװוּסט װי ה׳ס טאָג, נישט טאָג און נישט נאַכט; אָבער עס װעט זײַן, צו אָװנטצײַט װעט װערן ליכטיק.<verse eid="ZEC 14:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="ZEC 14:8" />און עס װעט זײַן אין יענעם טאָג, װעלן אַרױסגײן לעבעדיקע װאַסערן פֿון ירושָלַיִם, העלפֿט פֿון זײ צום פֿעדערשטן ים, און העלפֿט פֿון זײ צום הינטערשטן ים; אום זומער און אום װינטער װעט עס זײַן.<verse eid="ZEC 14:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="ZEC 14:9" />און ה׳ װעט זײַן צום מלך איבער דער גאַנצער ערד; אין יענעם טאָג װעט זײַן אײן ה׳, און זײַן נאָמען אײנער.<verse eid="ZEC 14:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="ZEC 14:10" />דאָס גאַנצע לאַנד װעט פֿאַרקערט װערן װי דער פּלױן, פֿון גֶבַֿע ביז רִמוֹן, אין דָרום פֿון ירושָלַיִם; און זי װעט זיצן דערהױבן אױף איר אָרט, פֿון דעם טױער פֿון בנימין ביז דעם אָרט פֿון ערשטן טױער, ביז דעם װינקלטױער, און פֿון דעם טורעם פֿון חַנַנאֵל ביז דעם מלכס קעלטערן. <verse eid="ZEC 14:10" /><verse number="11" style="v" sid="ZEC 14:11" />און זײ װעלן זיצן דערין, און קײן פֿאַרװיסטונג װעט מער נישט זײַן, און ירושָלַיִם װעט זיצן אין זיכערקײט.<verse eid="ZEC 14:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="ZEC 14:12" />און דאָס װעט זײַן די פּלאָג װאָס ה׳ װעט פּלאָגן אַלע אומות װאָס זײַנען אַרױס אין קריג אױף ירושָלַיִם: זײער פֿלײש װעט צעקריכן װי זײ שטײען אױף זײערע פֿיס, און זײערע אױגן װעלן צעקריכן אין זײערע לעכער, און זײער צונג װעט צעקריכן אין זײער מױל.<verse eid="ZEC 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="ZEC 14:13" />און עס װעט זײַן אין יענעם טאָג, װעט װערן אױף זײ אַ גרױסע מהומה פֿון ה׳, און זײ װעלן אָנכאַפּן אײנער דעם אַנדערנס האַנט, און אײנעמס האַנט װעט זיך אױפֿהײבן קעגן אַנדערנס האַנט. <verse eid="ZEC 14:13" /><verse number="14" style="v" sid="ZEC 14:14" />און אױך יהוּדה װעט מלחמה האַלטן אױף ירושָלַיִם; און אײַנגעזאַמלט װעט װערן דער פֿאַרמעג פֿון אַלע פֿעלקער רונד אַרום, גאָלד און זילבער און קלײדער זײער פֿיל. <verse eid="ZEC 14:14" /><verse number="15" style="v" sid="ZEC 14:15" />און אַזױ אױך װעט זײַן די פּלאָג פֿונעם פֿערד, פֿונעם מױלאײזל, פֿונעם קעמל, און פֿונעם אײזל, און פֿון איטלעכער בהמה װאָס װעט זײַן אין יענע מחנות – אַזױ װי די דאָזיקע פּלאָג.<verse eid="ZEC 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="ZEC 14:16" />און עס װעט זײַן, איטלעכער װאָס איז געבליבן פֿון אַלע פֿעלקער װאָס זײַנען געקומען אױף ירושָלַיִם, װעט אַרױפֿגײן יאָר פֿאַר יאָר זיך צו בוקן צו דעם קיניג, ה׳ צבָֿאוֹת, און צו האַלטן דעם יוֹם-טובֿ פֿון סוכּוֹת. <verse eid="ZEC 14:16" /><verse number="17" style="v" sid="ZEC 14:17" />און עס װעט זײַן, װער פֿון די משפּחות פֿון דער ערד עס װעט נישט אַרױפֿגײן קײן ירושָלַיִם זיך צו בוקן צו דעם קיניג, ה׳ צבָֿאוֹת, װעט אױף זײ נישט זײַן קײן רעגן; <verse eid="ZEC 14:17" /><verse number="18" style="v" sid="ZEC 14:18" />און אױב די משפּחה פֿון מִצרַיִם װעט נישט אַרױפֿגײן, און קומט נישט, װעט אױף זײ װעלן נישט באַקומען קײן רעגן; דאָס װעט זײַן די פּלאָג װאָס ה׳ װעט פּלאָגן די פֿעלקער װאָס װעלן נישט אַרױפֿגײן צו האַלטן דעם יוֹם-טובֿ פֿון סוכּוֹת. <verse eid="ZEC 14:18" /><verse number="19" style="v" sid="ZEC 14:19" />דאָס װעט זײַן די שטראָף פֿון מִצרַיִם, און די שטראָף פֿון אַלע פֿעלקער װאָס װעלן נישט אַרױפֿגײן צו האַלטן דעם יוֹם-טובֿ פֿון סוכּוֹת.<verse eid="ZEC 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="ZEC 14:20" />אין יענעם טאָג װעט אױף די גלעקלעך פֿון די פֿערד שטײן הײליק צו ג-ט; און די טעפּ אין ה׳ס הױז װעלן זײַן אַזױ װי די שפּרענגבעקנס װאָס פֿאַרן מזבח. <verse eid="ZEC 14:20" /><verse number="21" style="v" sid="ZEC 14:21" />און יעטװעדער טאָפּ אין ירושָלַיִם און אין יהוּדה װעט זײַן הײליק צו ה׳ צבָֿאוֹת, און אַלע װאָס ברענגען אַ שלאַכטאָפּפֿער װעלן קומען און נעמען פֿון זײ, און קאָכן אין זײ; און עס װעט מער נישט זײַן קײן הענדלער אין הױז פֿון ה׳ צבָֿאוֹת אין יענעם טאָג.<verse eid="ZEC 14:21" /></para>
  <chapter eid="ZEC 14" />
</usx>