<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="ZEP" style="id">- Orthodox Yiddish TaNaCH 2023</book>
  <para style="h">צפַֿניָה</para>
  <para style="toc2">צפַֿניָה</para>
  <para style="toc1">צפַֿניָה</para>
  <para style="mt1">צפַֿניָה</para>
  <chapter number="1" style="c" pubnumber="א" sid="ZEP 1" />
  <para style="p">
    <verse number="1" style="v" sid="ZEP 1:1" />דאָס װאָרט פֿון ה׳ װאָס איז געװען צו צפַֿניָה דעם זון פֿון כּוּשי, דעם זון פֿון גדַליָה, דעם זון פֿון אַמַריָה, דעם זון פֿון חִזקִיָהן, אין די טעג פֿון יֹאשִיָהו דעם זון פֿון אָמוֹנען, דעם מלך פֿון יהוּדה.<verse eid="ZEP 1:1" /></para>
  <para style="b" />
  <para style="q">
    <verse number="2" style="v" sid="ZEP 1:2" />פֿאַרלענדן װעל איך פֿאַרלענדן אַלצדינג</para>
  <para style="q" vid="ZEP 1:2">פֿון דעם געזיכט פֿון דער ערד,</para>
  <para style="q" vid="ZEP 1:2">זאָגט ה׳.<verse eid="ZEP 1:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 1:3" />איך װעל פֿאַרלענדן מענטשן און בהמות,</para>
  <para style="q" vid="ZEP 1:3">איך װעל פֿאַרלענדן די פֿױגלען פֿון הימל,</para>
  <para style="q" vid="ZEP 1:3">און די פֿישן פֿון ים,</para>
  <para style="q" vid="ZEP 1:3">און די שטרױכלונגען אין אײנעם מיט די רשעים;</para>
  <para style="q" vid="ZEP 1:3">און איך װעל פֿאַרשנײַדן דעם מענטשן פֿון געזיכט פֿון דער ערד,</para>
  <para style="q" vid="ZEP 1:3">זאָגט ה׳.<verse eid="ZEP 1:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 1:4" />און איך װעל אױסשטרעקן מײַן האַנט אױף יהוּדה,</para>
  <para style="q" vid="ZEP 1:4">און אױף אַלע באַװױנער פֿון ירושָלַיִם,</para>
  <para style="q" vid="ZEP 1:4">און איך װעל פֿאַרשנײַדן פֿון דעם דאָזיקן אָרט</para>
  <para style="q" vid="ZEP 1:4">דעם איבערבלײַב פֿון בַעַל,</para>
  <para style="q" vid="ZEP 1:4">דעם נאָמען פֿון די פּריסטער מיט די כּהנים;<verse eid="ZEP 1:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 1:5" />און די װאָס בוקן זיך אױף די דעכער</para>
  <para style="q" vid="ZEP 1:5">צו דעם חיל פֿון הימל,</para>
  <para style="q" vid="ZEP 1:5">און די װאָס אי זײ בוקן זיך און שװערן צו ה׳,</para>
  <para style="q" vid="ZEP 1:5">אי זײ שװערן בײַ מַלכָּם;<verse eid="ZEP 1:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 1:6" />און די װאָס טרעטן אָפּ פֿון הינטער ה׳,</para>
  <para style="q" vid="ZEP 1:6">און װאָס זוכן נישט ה׳,</para>
  <para style="q" vid="ZEP 1:6">און פֿרעגן זיך נישט אױף אים.<verse eid="ZEP 1:6" /></para>
  <para style="b" />
  <para style="q">
    <verse number="7" style="v" sid="ZEP 1:7" />שטיל פֿאַר אֲדֹנָי ה׳!</para>
  <para style="q" vid="ZEP 1:7">װאָרעם נאָנט איז דער טאָג פֿון ה׳,</para>
  <para style="q" vid="ZEP 1:7">װאָרעם ג-ט האָט אָנגעברײט אַ שלאַכטונג,</para>
  <para style="q" vid="ZEP 1:7">פֿאַרבעטן זײַנע גערופֿענע.<verse eid="ZEP 1:7" /></para>
  <para style="q">
    <verse number="8" style="v" sid="ZEP 1:8" />און עס װעט זײַן אין דעם טאָג פֿון ה׳ס שלאַכטונג,</para>
  <para style="q" vid="ZEP 1:8">װעל איך זיך רעכענען מיט די האַרן,</para>
  <para style="q" vid="ZEP 1:8">און מיט דעם מלכס זין,</para>
  <para style="q" vid="ZEP 1:8">און מיט אַלע װאָס קלײדן זיך אין פֿרעמדלענדישע קלײדער.<verse eid="ZEP 1:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 1:9" />און איך װעל זיך רעכענען אין יענעם טאָג</para>
  <para style="q" vid="ZEP 1:9">מיט אַלע װאָס שפּרינגען איבערן שװעל,</para>
  <para style="q" vid="ZEP 1:9">װאָס פֿילן אָן דאָס הױז פֿון זײער האַר</para>
  <para style="q" vid="ZEP 1:9">מיט אומרעכט און באַטרוג.<verse eid="ZEP 1:9" /></para>
  <para style="b" />
  <para style="q">
    <verse number="10" style="v" sid="ZEP 1:10" />און אין יענעם טאָג, זאָגט ה׳,</para>
  <para style="q" vid="ZEP 1:10">װעט זײַן אַ קֹול פֿון געשרײ פֿון דעם פֿישטױער,</para>
  <para style="q" vid="ZEP 1:10">און אַ יללה פֿון צװײטן שטאָטפֿערטל,</para>
  <para style="q" vid="ZEP 1:10">און אַ גרױסער בראָך פֿון די בערג.<verse eid="ZEP 1:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 1:11" />יאָמערט, איר באַװױנער פֿון מַכתֵּש,</para>
  <para style="q" vid="ZEP 1:11">װאָרעם אומגעקומען איז דאָס גאַנצע האַנדלפֿאָלק,</para>
  <para style="q" vid="ZEP 1:11">פֿאַרשניטן געװאָרן אַלע אָנגעלאָדענע מיט זילבער.<verse eid="ZEP 1:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 1:12" />און עס װעט זײַן אין יענער צײַט,</para>
  <para style="q" vid="ZEP 1:12">װעל איך דורכזוכן ירושָלַיִם מיט ליכט,</para>
  <para style="q" vid="ZEP 1:12">און איך װעל זיך רעכענען מיט די לײַט</para>
  <para style="q" vid="ZEP 1:12">װאָס גליװערן אױף זײערע הײװן,</para>
  <para style="q" vid="ZEP 1:12">װאָס זאָגן אין זײער האַרצן:</para>
  <para style="q" vid="ZEP 1:12">נישט גוטס טאָן קען ה׳ און נישט שלעכטס טאָן.<verse eid="ZEP 1:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ZEP 1:13" />און זײער פֿאַרמעג װעט זײַן צו רױב,</para>
  <para style="q" vid="ZEP 1:13">און זײערע הײַזער צו װיסט;</para>
  <para style="q" vid="ZEP 1:13">און זײ װעלן בױען הײַזער, און נישט באַװױנען,</para>
  <para style="q" vid="ZEP 1:13">און פֿלאַנצען װײַנגערטנער, און נישט טרינקען זײער װײַן.<verse eid="ZEP 1:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ZEP 1:14" />נאָנט איז דער גרױסער טאָג פֿון ה׳,</para>
  <para style="q" vid="ZEP 1:14">נאָנט און געשװינט זײער;</para>
  <para style="q" vid="ZEP 1:14">האָרך! דער טאָג פֿון ה׳!</para>
  <para style="q" vid="ZEP 1:14">ביטער שרײַט דענצמאָל דער גיבור.<verse eid="ZEP 1:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 1:15" />אַ טאָג פֿון צאָרן איז יענער טאָג,</para>
  <para style="q" vid="ZEP 1:15">אַ טאָג פֿון נױט און קלעם,</para>
  <para style="q" vid="ZEP 1:15">אַ טאָג פֿון װיסטקײט און פֿאַרװיסטונג,</para>
  <para style="q" vid="ZEP 1:15">אַ טאָג פֿון חושך און פֿינצטערניש,</para>
  <para style="q" vid="ZEP 1:15">אַ טאָג פֿון װאָלקן און נעבל,<verse eid="ZEP 1:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 1:16" />אַ טאָג פֿון שופֿר און שאַלונג</para>
  <para style="q" vid="ZEP 1:16">אַקעגן די באַפֿעסטיקטע שטעט,</para>
  <para style="q" vid="ZEP 1:16">און אַקעגן די הױכע טורעמס.<verse eid="ZEP 1:16" /></para>
  <para style="b" />
  <para style="q">
    <verse number="17" style="v" sid="ZEP 1:17" />און איך װעל ענג מאַכן די מענטשן,</para>
  <para style="q" vid="ZEP 1:17">און זײ װעלן אומגײן װי בלינדע,</para>
  <para style="q" vid="ZEP 1:17">װײַל זײ האָבן צו ה׳ געזינדיקט;</para>
  <para style="q" vid="ZEP 1:17">און זײער בלוט װעט פֿאַרגאָסן װערן װי שטױב,</para>
  <para style="q" vid="ZEP 1:17">און זײער פֿלײש װי מיסט.<verse eid="ZEP 1:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEP 1:18" />אַפֿילו זײער זילבער, אַפֿילו זײער גאָלד,</para>
  <para style="q" vid="ZEP 1:18">װעט זײ נישט קענען מציל זײַן</para>
  <para style="q" vid="ZEP 1:18">אין טאָג פֿון ה׳ס צאָרן;</para>
  <para style="q" vid="ZEP 1:18">און אין דעם פֿײַער פֿון זײַן קִנְאָה</para>
  <para style="q" vid="ZEP 1:18">װעט פֿאַרצערט װערן די גאַנצע ערד,</para>
  <para style="q" vid="ZEP 1:18">װאָרעם אַ פֿאַרלענדונג אַזש אַ שרעקלעכע,</para>
  <para style="q" vid="ZEP 1:18">װעט ער מאַכן פֿון אַלע באַװױנער פֿון דער ערד.<verse eid="ZEP 1:18" /></para>
  <chapter eid="ZEP 1" />
  <chapter number="2" style="c" pubnumber="ב" sid="ZEP 2" />
  <para style="q">
    <verse number="1" style="v" sid="ZEP 2:1" />זאַמלט אײַך אײַן און פֿאַרזאַמלט אײַך,</para>
  <para style="q" vid="ZEP 2:1">איר אומפֿאַרשעמט פֿאָלק,<verse eid="ZEP 2:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 2:2" />אײדער דער גזר װערט געבאָרן</para>
  <para style="q" vid="ZEP 2:2">װי שפּרײ פֿאַרגײט דער טאָג</para>
  <para style="q" vid="ZEP 2:2">אײדער עס קומט אױף אײַך דער גרימצאָרן פֿון ה׳,</para>
  <para style="q" vid="ZEP 2:2">אײדער עס קומט אױף אײַך דער טאָג פֿון ה׳ס כּעס.<verse eid="ZEP 2:2" /></para>
  <para style="q">
    <verse number="3" style="v" sid="ZEP 2:3" />זוכט ה׳, איר אַלע פֿאַרליטענע פֿון לאַנד,</para>
  <para style="q" vid="ZEP 2:3">װאָס האָט געטאָן זײַן געזעץ;</para>
  <para style="q" vid="ZEP 2:3">זוכט גערעכטיקײט, זוכט עניװת,</para>
  <para style="q" vid="ZEP 2:3">אפֿשר װעט איר פֿאַרבאָרגן װערן אין טאָג פֿון ה׳ס כּעס.<verse eid="ZEP 2:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 2:4" />װאָרעם עַזָה װעט אַ פֿאַרלאָזענע זײַן,</para>
  <para style="q" vid="ZEP 2:4">און אַשקלוֹן אַ װיסטעניש;</para>
  <para style="q" vid="ZEP 2:4">אַשדוֹד, זי װעט מען אין מיטן טאָג אַרױסטרײַבן,</para>
  <para style="q" vid="ZEP 2:4">און עֶקרוֹן װעט אױסגעריסן װערן.<verse eid="ZEP 2:4" /></para>
  <para style="b" />
  <para style="q">
    <verse number="5" style="v" sid="ZEP 2:5" />װײ, איר באַװױנער פֿון דער ים-געגנט,</para>
  <para style="q" vid="ZEP 2:5">איר פֿאָלק פֿון כּרֵתים!</para>
  <para style="q" vid="ZEP 2:5">דאָס װאָרט פֿון ה׳ איז אױף אײַך,</para>
  <para style="q" vid="ZEP 2:5">כּנַעַן, דו לאַנד פֿון די פּלִשתּים;</para>
  <para style="q" vid="ZEP 2:5">און איך װעל דיך אונטערברענגען</para>
  <para style="q" vid="ZEP 2:5">אַז קײן באַװױנער זאָל נישט זײַן.<verse eid="ZEP 2:5" /></para>
  <para style="q">
    <verse number="6" style="v" sid="ZEP 2:6" />און די געגנט פֿון ים װעט זײַן פֿיטערפּלעצער,</para>
  <para style="q" vid="ZEP 2:6">לאָנקעס פֿאַר פּאַסטוכער, און געהעפֿטן פֿאַר שאָף,<verse eid="ZEP 2:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 2:7" />און עס װעט זײַן אַ חלק</para>
  <para style="q" vid="ZEP 2:7">פֿאַר דעם איבערבלײַב פֿון דעם הױז פֿון יהוּדה;</para>
  <para style="q" vid="ZEP 2:7">זײ װעלן זיך דערױף פֿיטערן;</para>
  <para style="q" vid="ZEP 2:7">אין די הײַזער פֿון אַשקלוֹן װעלן זײ הױערן אין אָװנט;</para>
  <para style="q" vid="ZEP 2:7">װאָרעם ה׳ זײער ג-ט װעט זיך דערמאָנען אָן זײ,</para>
  <para style="q" vid="ZEP 2:7">און װעט אומקערן זײער געפֿאַנגענשאַפֿט.<verse eid="ZEP 2:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ZEP 2:8" />איך האָב געהערט די לעסטערונג פֿון מוֹאָבֿ,</para>
  <para style="q" vid="ZEP 2:8">און די זידלערײַען פֿון די קינדער פֿון עַמוֹן,</para>
  <para style="q" vid="ZEP 2:8">װאָס זײ האָבן געלעסטערט מײַן פֿאָלק,</para>
  <para style="q" vid="ZEP 2:8">און זיך געגרײסט אַקעגן זײער געמאַרק.<verse eid="ZEP 2:8" /></para>
  <para style="q">
    <verse number="9" style="v" sid="ZEP 2:9" />דערום אַזױ װי איך לעב,</para>
  <para style="q" vid="ZEP 2:9">זאָגט ה׳ צבָֿאוֹת, אלוקי יִשׂרָאֵל:</para>
  <para style="q" vid="ZEP 2:9">אַז מוֹאָבֿ װעט װי סדוֹם װערן,</para>
  <para style="q" vid="ZEP 2:9">און די קינדער פֿון עַמוֹן װי עַמוֹרָה,</para>
  <para style="q" vid="ZEP 2:9">אַ װירטשאַפֿט פֿון דערנער, און אַן אױסגראָבונג פֿון זאַלץ,</para>
  <para style="q" vid="ZEP 2:9">און אַ װיסטעניש אױף אײביק;</para>
  <para style="q" vid="ZEP 2:9">דער איבערבלײַב פֿון מײַן אומה װעט זײ צערױבן,</para>
  <para style="q" vid="ZEP 2:9">און דער רעשט פֿון מײַן פֿאָלק װעט זײ אַרבן.<verse eid="ZEP 2:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 2:10" />דאָס װעט זײ זײַן פֿאַר זײער שטאָלץ,</para>
  <para style="q" vid="ZEP 2:10">װאָס זײ האָבן געלעסטערט, און זיך געגרײסט</para>
  <para style="q" vid="ZEP 2:10">קעגן דער אומה פֿון ה׳ צבָֿאוֹת.<verse eid="ZEP 2:10" /></para>
  <para style="q">
    <verse number="11" style="v" sid="ZEP 2:11" />מוראדיק איז ה׳ אַקעגן זײ,</para>
  <para style="q" vid="ZEP 2:11">װאָרעם ער מאַכט אײַנגײן אַלע אָפּגעטער פֿון דער ערד,</para>
  <para style="q" vid="ZEP 2:11">און בוקן װעלן זיך צו אים, איטלעכער פֿון זײַן אָרט,</para>
  <para style="q" vid="ZEP 2:11">אַלע אינדזלען פֿון די פֿעלקער.<verse eid="ZEP 2:11" /></para>
  <para style="b" />
  <para style="q">
    <verse number="12" style="v" sid="ZEP 2:12" />אױך איר כּוּשים,</para>
  <para style="q" vid="ZEP 2:12">װעט זײַן דערשלאָגענע פֿון מײַן שװערד.<verse eid="ZEP 2:12" /></para>
  <para style="b" />
  <para style="q">
    <verse number="13" style="v" sid="ZEP 2:13" />און ער װעט אױסשטרעקן זײַן האַנט אַקעגן צפֿון,</para>
  <para style="q" vid="ZEP 2:13">און װעט אונטערברענגען אשור,</para>
  <para style="q" vid="ZEP 2:13">און מאַכן נינוֵה פֿאַר אַ װיסטעניש,</para>
  <para style="q" vid="ZEP 2:13">אַ טריקעניש אַזױ װי אַ מדבר.<verse eid="ZEP 2:13" /></para>
  <para style="q">
    <verse number="14" style="v" sid="ZEP 2:14" />און הױערן אין איר װעלן סטאַדעס,</para>
  <para style="q" vid="ZEP 2:14">חיות פֿון יעטװעדער מין;</para>
  <para style="q" vid="ZEP 2:14">אי דער פּעליקאַן אי דער זומפּבושל</para>
  <para style="q" vid="ZEP 2:14">װעלן נעכטיקן אױף אירע זײַלנקעפּ;</para>
  <para style="q" vid="ZEP 2:14">קוֹלות װעלן זינגען אין פֿענצטער,</para>
  <para style="q" vid="ZEP 2:14">אַ חורבֿן װעט זײַן אױף דער שװעל,</para>
  <para style="q" vid="ZEP 2:14">װאָרעם איר צעדערװערק דעקט מען אָפּ.<verse eid="ZEP 2:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 2:15" />דאָס איז די לוסטיקע שטאָט װאָס איז געזעסן אין זיכערקײט,</para>
  <para style="q" vid="ZEP 2:15">װאָס האָט געזאָגט אין איר האַרצן:</para>
  <para style="q" vid="ZEP 2:15">איך, און אַחוץ מיר איז מער נישטאָ.</para>
  <para style="q" vid="ZEP 2:15">װי איז זי געװאָרן צו װיסט,</para>
  <para style="q" vid="ZEP 2:15">אַ הױעראָרט פֿאַר חיות!</para>
  <para style="q" vid="ZEP 2:15">איטלעכער װאָס גײט איר פֿאַרבײַ,</para>
  <para style="q" vid="ZEP 2:15">װעט שמוצערן, װעט װיגן זײַן האַנט.<verse eid="ZEP 2:15" /></para>
  <chapter eid="ZEP 2" />
  <chapter number="3" style="c" pubnumber="ג" sid="ZEP 3" />
  <para style="q">
    <verse number="1" style="v" sid="ZEP 3:1" />װײ, די קױטיקע און אומװערדיקע,</para>
  <para style="q" vid="ZEP 3:1">די דריקערישע שטאָט!<verse eid="ZEP 3:1" /></para>
  <para style="q">
    <verse number="2" style="v" sid="ZEP 3:2" />זי האָט נישט צוגעהערט דעם קֹול,</para>
  <para style="q" vid="ZEP 3:2">זי האָט נישט גענומען קײן מוסר,</para>
  <para style="q" vid="ZEP 3:2">זי האָט זיך נישט פֿאַרזיכערט אױף ה׳,</para>
  <para style="q" vid="ZEP 3:2">זי האָט זיך נישט דערנענטערט צו איר ג-ט.<verse eid="ZEP 3:2" /></para>
  <para style="b" />
  <para style="q">
    <verse number="3" style="v" sid="ZEP 3:3" />אירע האַרן אין איר זײַנען לײבן ברומיקע,</para>
  <para style="q" vid="ZEP 3:3">אירע ריכטער זײַנען אָװנטװעלף,</para>
  <para style="q" vid="ZEP 3:3">זײ לאָזן נישט אַ בײן ביז פֿרימאָרגן.<verse eid="ZEP 3:3" /></para>
  <para style="q">
    <verse number="4" style="v" sid="ZEP 3:4" />אירע נבֿיאים זײַנען לױזגעלאָזט, מענטשן אומגעטרײַע;</para>
  <para style="q" vid="ZEP 3:4">אירע כּהנים פֿאַרשװעכן די הײליקײט,</para>
  <para style="q" vid="ZEP 3:4">פֿאַרברעכן אַקעגן דער תּורה.<verse eid="ZEP 3:4" /></para>
  <para style="q">
    <verse number="5" style="v" sid="ZEP 3:5" />ה׳ דער גערעכטער איז אין איר מיט,</para>
  <para style="q" vid="ZEP 3:5">ער טוט נישט קײן אומרעכט;</para>
  <para style="q" vid="ZEP 3:5">פֿרימאָרגן אין פֿרימאָרגן לאָזט ער אַרױס</para>
  <para style="q" vid="ZEP 3:5">זײַן גערעכטיקײט אין ליכט, נישט פֿאַרפֿעלט;</para>
  <para style="q" vid="ZEP 3:5">אָבער דער פֿאַרברעכער װײס נישט פֿון קײן בושה.<verse eid="ZEP 3:5" /></para>
  <para style="b" />
  <para style="q">
    <verse number="6" style="v" sid="ZEP 3:6" />איך האָב פֿאַרשניטן פֿעלקער,</para>
  <para style="q" vid="ZEP 3:6">פֿאַרװיסט געװאָרן זײַנען זײערע װינקלען;</para>
  <para style="q" vid="ZEP 3:6">איך האָב חרובֿ געמאַכט זײערע גאַסן,</para>
  <para style="q" vid="ZEP 3:6">אַז קײנער גײט נישט דורך;</para>
  <para style="q" vid="ZEP 3:6">צעשטערט זײַנען זײערע שטעט,</para>
  <para style="q" vid="ZEP 3:6">אָן אַ מענטשן, אָן אַ באַװױנער.<verse eid="ZEP 3:6" /></para>
  <para style="q">
    <verse number="7" style="v" sid="ZEP 3:7" />האָב איך געטראַכט: װעסט געװיס מורא האָבן פֿאַר מיר,</para>
  <para style="q" vid="ZEP 3:7">װעסט אַ מוסר נעמען;</para>
  <para style="q" vid="ZEP 3:7">כּדי איר װױנונג זאָל נישט פֿאַרשניטן װערן,</para>
  <para style="q" vid="ZEP 3:7">לױט אַלץ װאָס איך האָב באַפֿױלן װעגן איר;</para>
  <para style="q" vid="ZEP 3:7">אָבער זײ האָבן זיך געפֿעדערט</para>
  <para style="q" vid="ZEP 3:7">פֿאַרדאָרבן צו זײַן אין אַלע זײערע מעשׂים.<verse eid="ZEP 3:7" /></para>
  <para style="b" />
  <para style="q">
    <verse number="8" style="v" sid="ZEP 3:8" />דערום ריכט זיך אױף מיר, זאָגט ה׳,</para>
  <para style="q" vid="ZEP 3:8">אױף דעם טאָג װאָס איך שטײ אױף צום רױב,</para>
  <para style="q" vid="ZEP 3:8">װאָרעם מײַן משפּט איז אײַנצוזאַמלען די פֿעלקער</para>
  <para style="q" vid="ZEP 3:8">איך זאָל אױפֿקלײַבן די קיניגרײַכן,</para>
  <para style="q" vid="ZEP 3:8">אױסצוגיסן אױף זײ מײַן כּעס,</para>
  <para style="q" vid="ZEP 3:8">מײַן גאַנצן גרימצאָרן;</para>
  <para style="q" vid="ZEP 3:8">װאָרעם אין דעם פֿײַער פֿון מײַן קִנְאָה</para>
  <para style="q" vid="ZEP 3:8">װעט פֿאַרצערט װערן די גאַנצע ערד.<verse eid="ZEP 3:8" /></para>
  <para style="b" />
  <para style="q">
    <verse number="9" style="v" sid="ZEP 3:9" />װאָרעם דענצמאָל װעל איך איבערמאַכן די פֿעלקער</para>
  <para style="q" vid="ZEP 3:9">אַ ליפּ אַ רײנע, אַז זײ זאָלן אַלע רופֿן צום נאָמען ה׳,</para>
  <para style="q" vid="ZEP 3:9">אים צו דינען אַזױ װי אײן מאַן.<verse eid="ZEP 3:9" /></para>
  <para style="q">
    <verse number="10" style="v" sid="ZEP 3:10" />פֿון יענער זײַט טײַכן פֿון כּוּש</para>
  <para style="q" vid="ZEP 3:10">װעלן זײ ברענגען מײַנע בעטער,</para>
  <para style="q" vid="ZEP 3:10">די טאָכטער פֿון מײַנע צעשפּרײַטע, אַ מתּנה צו מיר.<verse eid="ZEP 3:10" /></para>
  <para style="b" />
  <para style="q">
    <verse number="11" style="v" sid="ZEP 3:11" />אין יענעם טאָג װעסטו זיך מער נישט שעמען</para>
  <para style="q" vid="ZEP 3:11">װעגן אַלע דײַנע מעשׂים, װאָס דו האָסט פֿאַרבראָכן קעגן מיר,</para>
  <para style="q" vid="ZEP 3:11">װאָרעם דענצמאָל װעל איך אָפּטאָן</para>
  <para style="q" vid="ZEP 3:11">פֿון צװישן דיר דײַנע שטאָלצלוסטיקע,</para>
  <para style="q" vid="ZEP 3:11">און װעסט זיך מער װידער נישט גרײסן,</para>
  <para style="q" vid="ZEP 3:11">אױף מײַן הײליקן באַרג.<verse eid="ZEP 3:11" /></para>
  <para style="q">
    <verse number="12" style="v" sid="ZEP 3:12" />און איך װעל איבערלאָזן אין דיר</para>
  <para style="q" vid="ZEP 3:12">דאָס געדריקטע און אָרימע פֿאָלק,</para>
  <para style="q" vid="ZEP 3:12">און זײ װעלן זיך באַשיצן אין דעם נאָמען ה׳.<verse eid="ZEP 3:12" /></para>
  <para style="q">
    <verse number="13" style="v" sid="ZEP 3:13" />דער איבערבלײַב פֿון יִשׂרָאֵל װעט נישט טאָן קײן אומרעכט,</para>
  <para style="q" vid="ZEP 3:13">און נישט רעדן קײן ליגן,</para>
  <para style="q" vid="ZEP 3:13">און אין זײער מױל װעט זיך נישט געפֿינען</para>
  <para style="q" vid="ZEP 3:13">אַ צונג פֿון באַטרוג;</para>
  <para style="q" vid="ZEP 3:13">יאָ, זײ װעלן זיך פֿיטערן און הױערן,</para>
  <para style="q" vid="ZEP 3:13">און קײנער װעט נישט שרעקן.<verse eid="ZEP 3:13" /></para>
  <para style="b" />
  <para style="q">
    <verse number="14" style="v" sid="ZEP 3:14" />זינג, טאָכטער צִיוֹן,</para>
  <para style="q" vid="ZEP 3:14">טוט שאַלן, יִשׂרָאֵל;</para>
  <para style="q" vid="ZEP 3:14">פֿרײ זיך און זײַ לוסטיק פֿון גאַנצן האַרצן,</para>
  <para style="q" vid="ZEP 3:14">טאָכטער ירושָלַיִם.<verse eid="ZEP 3:14" /></para>
  <para style="q">
    <verse number="15" style="v" sid="ZEP 3:15" />ה׳ טוט אָפּ דײַנע משפּטים,</para>
  <para style="q" vid="ZEP 3:15">ער ראַמט אָפּ דײַנע פֿײַנט;</para>
  <para style="q" vid="ZEP 3:15">דער קיניג פֿון יִשׂרָאֵל, ה׳, איז צװישן דיר,</para>
  <para style="q" vid="ZEP 3:15">זאָלסט מער נישט מורא האָבן פֿאַר בײז.<verse eid="ZEP 3:15" /></para>
  <para style="q">
    <verse number="16" style="v" sid="ZEP 3:16" />אין יענעם טאָג װעט געזאָגט װערן צו ירושָלַיִם:</para>
  <para style="q" vid="ZEP 3:16">זאָלסט נישט מורא האָבן;</para>
  <para style="q" vid="ZEP 3:16">צִיוֹן, נישט שלאַף װערן זאָלן דײַנע הענט.<verse eid="ZEP 3:16" /></para>
  <para style="q">
    <verse number="17" style="v" sid="ZEP 3:17" />ה׳ דײַן ג-ט איז צװישן דיר,</para>
  <para style="q" vid="ZEP 3:17">אַ גיבור װאָס העלפֿט;</para>
  <para style="q" vid="ZEP 3:17">ער װעט זיך פֿרײען מיט שׂימחה אױף דיר,</para>
  <para style="q" vid="ZEP 3:17">ער װעט פֿאַרשװײַגן אין זײַן ליבשאַפֿט,</para>
  <para style="q" vid="ZEP 3:17">ער װעט זיך פֿרײען אױף דיר מיט געזאַנג.<verse eid="ZEP 3:17" /></para>
  <para style="q">
    <verse number="18" style="v" sid="ZEP 3:18" />איך זאַמל אײַן די דערװײַטערטע פֿון אַ יוֹם-טובֿ –</para>
  <para style="q" vid="ZEP 3:18">די װאָס זײַנען אַװעק פֿון דיר,</para>
  <para style="q" vid="ZEP 3:18">װאָס דו האָסט געטראָגן װעגן דעם שאַנד.<verse eid="ZEP 3:18" /></para>
  <para style="q">
    <verse number="19" style="v" sid="ZEP 3:19" />זע, איך רעכן זיך מיט אַלע דײַנע פּײַניקער, אין יענער צײַט,</para>
  <para style="q" vid="ZEP 3:19">און איך װעל העלפֿן די װאָס איז הינקעדיק,</para>
  <para style="q" vid="ZEP 3:19">און די פֿאַרשטױסענע װעל איך אײַנזאַמלען;</para>
  <para style="q" vid="ZEP 3:19">און איך װעל זײ מאַכן פֿאַר אַ לױב און פֿאַר אַ שם,</para>
  <para style="q" vid="ZEP 3:19">די װאָס איבער דער גאַנצער ערד איז געװען זײער שאַנד.<verse eid="ZEP 3:19" /></para>
  <para style="q">
    <verse number="20" style="v" sid="ZEP 3:20" />אין יענער צײַט װעל איך אײַך ברענגען,</para>
  <para style="q" vid="ZEP 3:20">און אין יענער צײַט טו איך אײַך אײַנזאַמלען;</para>
  <para style="q" vid="ZEP 3:20">װאָרעם איך װעל אײַך מאַכן פֿאַר אַ שם און פֿאַר אַ לױב</para>
  <para style="q" vid="ZEP 3:20">צװישן אַלע פֿעלקער פֿון דער ערד,</para>
  <para style="q" vid="ZEP 3:20">װען איך קער אום אײַער געפֿאַנגענשאַפֿט</para>
  <para style="q" vid="ZEP 3:20">פֿאַר אײַערע אױגן, זאָגט ה׳.<verse eid="ZEP 3:20" /></para>
  <chapter eid="ZEP 3" />
</usx>