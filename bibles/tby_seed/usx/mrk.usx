<?xml version="1.0" encoding="utf-8"?>
<usx version="3.0">
  <book code="MRK" style="id">TOBMRK NT TOBARU MARK CHP. 01 YOSIAS, INDONESIA</book>
  <para style="h">'O MARKUS</para>
  <para style="toc3">Mrk.</para>
  <para style="toc3">Mrk.</para>
  <para style="toc3">Mrk.</para>
  <para style="toc3">Mrk.</para>
  <para style="toc3">Mrk.</para>
  <para style="toc3">Mrk.</para>
  <para style="toc3">Mrk.</para>
  <para style="toc2">'O Markus</para>
  <para style="toc1">'O Habari ma Owa gee 'o Markus Wositotara</para>
  <para style="mt1">'O HABARI MA OWA GEE</para>
  <para style="mt1">'O MARKUS WOSITOTARA</para>
  <para style="imt">'O Habari ma Owa gee 'o Markus Wositota-totara ma Dumutu</para>
  <para style="ip">Moteke 'o nyawa yongaku-ngaku ma sirasi, yongose 'ato 'o buku ne'ena 'o Markus ma sirete wolefo. 'O Markus 'una ge'ena womote-moteke 'o Petrus 'awi do-dagioka wositotara 'o Habari ma Owa. So 'okia naga gee wo'isenino 'o Petrusoka ge'enau walefo ma buku ma dodaka ne'ena.</para>
  <para style="ip">Nako ngone pabaca ma buku ne'ena, ngone 'asa panako 'okia 'o Yesus wadiai de 'okia wodotoko 'awi do-domoteika. 'O Yesus wositotara 'o Habari ma Owa wongose 'ato ma Jo'oungu ma Dutu wacobou wopareta ma ngale wokoana 'o duniaka ne'ena (Mrk. 1:14-15). 'Una wokuasa wosi'aiki 'o nyawa manga panyake de woginiiki 'o tokata gee 'o nyawaka yakido-dongosamuku. 'O Yahudioka ma balu-balusu wiitomo de yomaka'aturu ma ngale wito'oma (Mrk. 3:6).</para>
  <para style="ip">Ma 'o Yesus kowoowaruwa so kawosidemosirali 'ato 'una 'asa wito'oma (Mrk. 8:31; Mrk. 9:31; Mrk. 10:33-34), de ka 'una wi singina wotagi 'o Yerusalemuka sababu womau womasisarakani wito'oma ma ngale watuusu 'o nyawa manga sowono (Mrk. 10:45). Wito'omaka de womomikokali.</para>
  <para style="ip">'O Markus wolefo ma buku ne'ena, ma ngale wosiwaiti 'ato 'o Yesus 'una ge'ena ma Koana 'o Nyawa Wosilaha-laha gee ma Jo'oungu ma Dutu wojajiokau 'ato dua woboa, de ma Jo'oungu ma Dutu 'awi Ngowaka (Mrk. 1:1; Mrk. 1:24; Mrk. 3:11; Mrk. 5:7; Mrk. 8:29; Mrk. 9:7; Mrk. 14:61-62; Mrk. 15:39). Mita wonasigaro powimoteke 'o Yesus ngaro 'okia naga bato 'inadutuku (Mrk. 8:34-38; Mrk. 10:29-31).</para>
  <chapter number="1" style="c" sid="MRK 1" />
  <para style="s">'O Yohanes Wo'osi-'osiki 'awi do-dotoko</para>
  <para style="r">(<ref loc="MAT 3:1-12">Mat. 3:1-12</ref>; <ref loc="LUK 3:1-18">Luk. 3:1-18</ref>; <ref loc="JHN 1:19-28">Yoh. 1:19-28</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 1:1" />Ne'ena ge'ena 'o Habari ma Owa ma ngale ma Yesus Kristus, ma Jo'oungu ma Dutu wi Ngowaka. <verse eid="MRK 1:1" /><verse number="2" style="v" sid="MRK 1:2" />Ma Habari ma Owa ge'ena 'ikurue 'isoka ma Nabii Yesaya wosilefokau konee,</para>
  <para style="q1" vid="MRK 1:2">&lt;&lt;Ma Jo'oungu ma Dutu wongose, &lt;Nu'una to ngoi 'ai su-suloko;</para>
  <para style="q2" vid="MRK 1:2">ngoi towisuloko 'una wosirano 'asa de ngona,</para>
  <para style="q2" vid="MRK 1:2">la 'una wosikurue 'ani ngekomo.&gt;<verse eid="MRK 1:2" /></para>
  <para style="q1">
    <verse number="3" style="v" sid="MRK 1:3" />'O nyawa moi naga 'o tonaka 'ika-kakasaka wosigaso-gasoko wongose 'ato,</para>
  <para style="q2" vid="MRK 1:3">&lt;Niosikadiai ma Jou 'awi ngekomo,</para>
  <para style="q2" vid="MRK 1:3">niosikaboooto ma Jou wi tapaki la waboa!&gt; &gt;&gt;<verse eid="MRK 1:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 1:4" />'Isoka 'isilefokau gee, koge'enali mita 'o Yohanes woboano 'o tonaka 'ika-kakasaka. 'Una 'o nyawa waki'osiki de wositotara 'o habari ma Jo'oungu ma Dutuno. Wongose 'ato, &lt;&lt;Salingou niomaogoro 'o sowono niodiai de salingou ni'osiki la ma Jo'oungu ma Dutu kowosi-singinawau 'ania so-sowono.&gt;&gt; <verse eid="MRK 1:4" /><verse number="5" style="v" sid="MRK 1:5" />'O Yudea ma nyawa de 'o Yerusalem ma kota moi yobootoka yotagi 'o Yohanes wi do-dotoko yosigisene. 'Ona yomangaku manga sowono de waki'osiki 'o Yordan ma 'akeroka.<verse eid="MRK 1:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 1:6" />'O Yohanes 'awi baju 'o unta ma gogo, 'awi bulu 'o haewani ma kai, de 'awi 'inomo 'o kakasoso de 'o madu 'o bonganika. <verse eid="MRK 1:6" /><verse number="7" style="v" sid="MRK 1:7" />'Una wosidemo 'o habari ne'ena, &lt;&lt;Dua ngoioka de wimoioli woboa, 'ifoloi woamoko ngaro de de ngoi ma. Ngoi ka 'awi tarupa ma gumini tomarukuku tasose ma koyadaenuwa. <verse eid="MRK 1:7" /><verse number="8" style="v" sid="MRK 1:8" />Ngoi tinisi'osiki de 'o 'akere, ma 'una dua winisi'osiki de 'o Ngomasa 'Itebi-tebini.&gt;&gt;<verse eid="MRK 1:8" /></para>
  <para style="s">'O Yohanes 'o Yesus wi'osiki</para>
  <para style="r">(<ref loc="MAT 3:13-17">Mat. 3:13-17</ref>; <ref loc="LUK 3:21-22">Luk. 3:21-22</ref>)</para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 1:9" />Ma 'orasi ge'ena 'o Yesus woboa 'o Nazaretino 'o Galilea ma daeraano de 'o Yohanes wi'osiki 'o Yordan ma 'akeroka. <verse eid="MRK 1:9" /><verse number="10" style="v" sid="MRK 1:10" />'O Yesus waie womabaoro de wamake 'o diwanga 'ipelenga de ma Jo'oungu ma Dutu wi Ngomasa dakuuku widuguti 'isoka 'o pombo. <verse eid="MRK 1:10" /><verse number="11" style="v" sid="MRK 1:11" />Ge'enaka de yo'isene ma Jo'oungu ma Dutu wi 'ilingi, 'ingose 'ato, &lt;&lt;Ngona to ngoi 'ai Ngowaka tonisiboso-bosono, ngona 'ai singina nasanangi.&gt;&gt;<verse eid="MRK 1:11" /></para>
  <para style="s">'O Yesus 'o Tokata ma Koana witaili</para>
  <para style="r">(<ref loc="MAT 4:1-11">Mat. 4:1-11</ref>; <ref loc="LUK 4:1-13">Luk. 4:1-13</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 1:12" />Kage'ena 'ipasa de ma Jo'oungu ma Dutu wi Ngomasa ge'ena wi'asakau 'o tonaka 'ika-kakasaka.<note caller="a" style="f"><char style="fr" closed="false">1:12: </char><char style="ft" closed="false">'O tonaka 'ika-kakasaka ge'ena la 'o tonaka gee 'idudungu 'ifoloi de kokiawa 'i'oo ge'enaka.</char></note> <verse eid="MRK 1:12" /><verse number="13" style="v" sid="MRK 1:13" />'O wange nagi soatino 'una ge'enaka, 'o Tokata ma Koana witaili. 'O haewani kopapi-piarawa mita ge'enaka. De 'o mala'ekati wileleani.<verse eid="MRK 1:13" /></para>
  <para style="s">'O Yesus waki'asoko 'o naoko yotago-tagoko yaruata</para>
  <para style="r">(<ref loc="MAT 4:12-22">Mat. 4:12-22</ref>; <ref loc="LUK 4:14-15">Luk. 4:14-15</ref>, <ref loc="LUK 5:1-11">5:1-11</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 1:14" />Gee 'o Yohanes wibuika, 'o Yesus 'una wotagi 'o Galileaka de wositotara 'o Habari ma Owa ma Jo'oungu ma Dutuno ge'enaka doka. <verse eid="MRK 1:14" /><verse number="15" style="v" sid="MRK 1:15" />Wongose 'ato, &lt;&lt;Ma Jo'oungu ma Dutu wacobou wopareta. So niomaogoro 'o sowono niodiai de niolio ma Jo'oungu ma Dutuka, de niongaku 'o Habari ma Owaka gee ma Jo'oungu ma Dutuno!&gt;&gt;<verse eid="MRK 1:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 1:16" />Gee 'o Yesus waboa 'o Galilea ma talaga ma batingino, de wakimake yosoma-soma yamididi ge'ena la 'o Simon de ma dodoto 'o Andreas 'o naoko yosoma ma gu-gudaioka ge'ena ma talagaka. <verse eid="MRK 1:16" /><verse number="17" style="v" sid="MRK 1:17" />De 'o Yesus kawongosekau 'onaka, &lt;&lt;Nou, nimoteke ngoi! Ngoi 'asa tinidotoko 'o nyawa niasoma.&gt;&gt; <verse eid="MRK 1:17" /><verse number="18" style="v" sid="MRK 1:18" />Ge'enaka de ka manga soma yamada de yomoteokau 'o Yesusika.<verse eid="MRK 1:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 1:19" />'O Yesus wogila-gilali de wakimake 'o riaka dodoto yamididioli, ge'ena la 'o Yakobus de 'o Yohanes 'o Zebedeus wi ngowa-ngowaka. 'Ona 'o ngo'otiri ma dodaka manga soma yosidiai ma gu-gudaioka. <verse eid="MRK 1:19" /><verse number="20" style="v" sid="MRK 1:20" />'O Yesus kawoboa de waki'asokokau, de 'ona mita ka manga dea wimada 'o ngo'otiroka de mita gee yoma-manarama yakisewa-sewa go'ona, de yotagiokau 'o Yesus wimoteke.<verse eid="MRK 1:20" /></para>
  <para style="s">'O nyawa gee 'o tokata wido-dongosamuku</para>
  <para style="r">(<ref loc="LUK 4:31-37">Luk. 4:31-37</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 1:21" />'O Yesus de wi do-domoteke 'o Kapernaum ma soanoka yototarika. Pomaoma-omasa ma Wangekali de 'o Yesus wowosama 'o lo-lomu ma woaka de wodotoko. <verse eid="MRK 1:21" /><verse number="22" style="v" sid="MRK 1:22" />'O nyawa yosigise-gisene gee yoherangi wodotoko ma jako. Sababu 'una wodotoko de ma kumatioka 'isoka 'o 'agamakawa yodoto-dotoko.<verse eid="MRK 1:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 1:23" />Ma 'orasi ge'ena 'o nyawa wimoi witoka-tokata gee 'o lo-lomu ma woaka wowosamika, de woma'orese, <verse eid="MRK 1:23" /><verse number="24" style="v" sid="MRK 1:24" />&lt;&lt;Ee Yesus, 'o Nazaretoka ma nyawa, minido'oau ngomino? Naino minitorouou? Ngoi toninako ngona nagu'una; ngona ge'ena ma Jo'oungu ma Dutu wi Su-suloko Notebi-tebini!&gt;&gt;<verse eid="MRK 1:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 1:25" />'O Yesus wodorofu ma tokatika, &lt;&lt;Nomariidi, nosupuoka 'o nyawaka nu'una!&gt;&gt;<verse eid="MRK 1:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 1:26" />So ma tokata ge'ena 'o nyawa gu'una wisikagiwi yakua-kuatino deika 'isupu 'unaka ma de 'ima'orese. <verse eid="MRK 1:26" /><verse number="27" style="v" sid="MRK 1:27" />'O nyawa yoodumu kayoki-kiliri, so yomakadongose 'ato, &lt;&lt;Tei, 'okia ne'ena? Ne'ena 'o do-dotoko ma sungi moi! De wi kumati de wi kuasa wasuloko 'o tokata 'isupu, de widomoteke!&gt;&gt;<verse eid="MRK 1:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 1:28" />So 'o Yesus wi habari 'isidagi ma japatioka 'ena 'o Galilea yasuluunukou.<verse eid="MRK 1:28" /></para>
  <para style="s">'O Yesus wosi'aiki 'o nyawa gudai manga panyake</para>
  <para style="r">(<ref loc="MAT 8:14-17">Mat. 8:14-17</ref>; <ref loc="LUK 4:38-41">Luk. 4:38-41</ref>)</para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 1:29" />'O Yesus woma'aiki 'o lo-lomu ma woaka ge'ena, de wotagi 'o Simon de 'o Andreas manga woaka. 'O Yakobus de 'o Yohanes mita yomasidatagi de de 'una. <verse eid="MRK 1:29" /><verse number="30" style="v" sid="MRK 1:30" />'O Simon ma toroa 'o dangiroka moma'iduoka sababu migogamuku. So gee 'o Yesus de wi do-domoteke yowosanga ma woaka ge'ena, de 'o Yesusika yosidemo ma habari ge'ena. <verse eid="MRK 1:30" /><verse number="31" style="v" sid="MRK 1:31" />So waika 'ami giamika wa'ao de womiriwo momomiki. So momomikie 'ena mi panyake 'i'aiokau so muna mita makileleani.<verse eid="MRK 1:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 1:32" />'Itarusou de 'o nyawa yopa-panyake de 'o tokata yakido-dongosamuku yakikoki'asa 'o Yesusino. <verse eid="MRK 1:32" /><verse number="33" style="v" sid="MRK 1:33" />'O nyawa rekeni 'iodumu ma kotaka ge'ena yomalomuno ma woa ge'ena ma bionino. <verse eid="MRK 1:33" /><verse number="34" style="v" sid="MRK 1:34" />Ge'enaka de 'o Yesus wosi'aiki to 'ona manga panyake 'ini-'inioka de woginiiki 'o tokata 'o gudai. 'Una kowosidabiwa 'o tokata ge'ena 'ibicara sababu 'ena mita yanako 'o Yesus 'una ge'ena ma kia.<verse eid="MRK 1:34" /></para>
  <para style="s">'O Yesus wodotoko 'o Galileaka</para>
  <para style="r">(<ref loc="LUK 4:42-44">Luk. 4:42-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 1:35" />Ma wangede de 'o Yesus kawotarusoka wotagi 'o ngii 'irii-riidoka 'o kota ma dudunoka, ge'enaka doka wolahidoa. <verse eid="MRK 1:35" /><verse number="36" style="v" sid="MRK 1:36" />Ma 'o Simon de wi ma-manai wisidu'uru winonu. <verse eid="MRK 1:36" /><verse number="37" style="v" sid="MRK 1:37" />Gee wimakeno de yongoseu, &lt;&lt; 'O nyawa 'iodumu nirinonu 'Aba.&gt;&gt;<verse eid="MRK 1:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 1:38" />Ma 'o Yesus kawosangokau, &lt;&lt;Nou, nanga do-dagi posigila 'o kota 'iregu-reguka ne'enaka naga. Ngoi salingou todotoko ge'enaka naga mita, sababu ge'enau 'ai dumutu so taino ne'ena 'o duniano.&gt;&gt;<verse eid="MRK 1:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 1:39" />Ge'enau so 'o Yesus wodakadagi 'o Galilea wakilolituku de wobobita 'o lo-lomu ma woa-woaka, de mita 'o tokata woginiiki.<verse eid="MRK 1:39" /></para>
  <para style="s">'O Yesus wosi'aiki wimoi wipado-pado</para>
  <para style="r">(<ref loc="MAT 8:1-4">Mat. 8:1-4</ref>; <ref loc="LUK 5:12-16">Luk. 5:12-16</ref>)</para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 1:40" />Wimoi wipado-pado waino 'o Yesusino, wotalibukuku de kawongosekau, &lt;&lt; 'Abae! Nako nomodeke, de 'ai panyake ne'ena nosi'aiki!&gt;&gt;<verse eid="MRK 1:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 1:41" />'O Yesus wi singina 'o nyawa gu'una so wi'ao de wongose 'ato, &lt;&lt;Ngoi tomodeke, so ni panyake ge'ena 'i'aiki!&gt;&gt; <verse eid="MRK 1:41" /><verse number="42" style="v" sid="MRK 1:42" />Kage'ena ma 'orasi de wi pado ge'ena 'i'aiokau. <verse eid="MRK 1:42" /><verse number="43" style="v" sid="MRK 1:43" />Ge'enaka de 'o Yesus wosuloko wolio de wisibesesongo koneda, <verse eid="MRK 1:43" /><verse number="44" style="v" sid="MRK 1:44" />&lt;&lt;Tonidongose, 'uwa nosikademo ka moika ma, duga 'o 'imamika notagi la noga'asoko ma 'imam wosiputusu 'ato ni pado 'i'aiokau. Ma ngale ge'ena 'ani sukuru nokula moteke 'o Musa wosulokokau ma nyo-nyata 'o nyawa-nyawaka 'ato ma gou-goungu 'ani pado 'i'aiokau.&gt;&gt;<verse eid="MRK 1:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 1:45" />Ma 'o nyawa gu'una wotagika de wosikajarita kiaka naga bato 'okia naga 'idadiokau ge'ena, sigado 'o Yesus koidadiwau wowosama 'o kotaka kawomasitaiwangekou. 'Una ka 'o kota ma dudunokau 'o ngii 'irii-riidoka womanoa. Duga 'o nyawa kiano naga bato koitoa-toakuwa yaino 'unano.<verse eid="MRK 1:45" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 1" />
  <chapter number="2" style="c" sid="MRK 2" />
  <para style="s">Wolugu-lugu wimoi 'o Yesus wisi'aiki</para>
  <para style="r">(<ref loc="MAT 9:1-8">Mat. 9:1-8</ref>; <ref loc="LUK 5:17-26">Luk. 5:17-26</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 2:1" />Ge'ena 'ipasa 'o wange muruo naga de 'o Yesus wolio 'o Kapernaumika. So wigi'isene 'ato naga 'una 'o woaka. <verse eid="MRK 2:1" /><verse number="2" style="v" sid="MRK 2:2" />Ge'enaka de manga gudai yoboa. 'Ona yomalomuno ge'enaka yapai-paili monga. 'O ngorana ma yape-pe'etoro mongau. Ge'enaka de 'o Yesus wakisitotara 'o habari ma Jo'oungu ma Dutuno. <verse eid="MRK 2:2" /><verse number="3" style="v" sid="MRK 2:3" />Wobicara ma gu-gudaioka, de wolugu-lugu wimoi yaruata wirimokude wi'asa 'o Yesusino. <verse eid="MRK 2:3" /><verse number="4" style="v" sid="MRK 2:4" />Ma 'o nyawa kaifoloi yokudai so koidadiwa wisitotara 'o Yesusino. So 'o katu ya'aiki daku 'o Yesus wi dekude, deika wisiguti wolugu-lugu gu'una de wi kokowaka. <verse eid="MRK 2:4" /><verse number="5" style="v" sid="MRK 2:5" />Gee 'o Yesus wakimake manga ngo-ngaku ma guatoka, de kawongosekau wolugu-luguka gee, &lt;&lt; 'Ai ngowaka, 'ani so-sowono ta'ikirokau.&gt;&gt;<verse eid="MRK 2:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 2:6" />'O 'agamaka yodoto-dotoko yamuruo naga ge'enaka yogoge-gogerie ka manga singinaka, <verse eid="MRK 2:6" /><verse number="7" style="v" sid="MRK 2:7" />&lt;&lt; 'Etei 'una womoroini ma sala koge'ena wongose! Komoiwa moi 'idadi 'o so-sowono pa'ikiri, duga ka ma Jo'oungu ma Dutu. So 'una ka ma Jo'oungu ma Dutu wisiti-tingoono!&gt;&gt;<verse eid="MRK 2:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 2:8" />Ma 'orasi ge'ena 'o Yesus wanako to 'ona manga di-dibangi. Ge'enaka de kawongosekau 'onaka, &lt;&lt; 'Ido'oa so nia singina ma dodaka niosano-sano koge'ena? <verse eid="MRK 2:8" /><verse number="9" style="v" sid="MRK 2:9" />Ka'ena 'ifoloi 'igapangi tongose wolugu-luguka, &lt; 'Ani so-sowono tosi'aikokau!&gt; bolo, &lt;Nomomiki, 'ani kokowa na'aiki la notagiou!&gt;? <verse eid="MRK 2:9" /><verse number="10" style="v" sid="MRK 2:10" />Ma ne'ena dua tosidumutu nginika 'ato 'o duniaka ne'ena ngoi 'o Nyawa ma Ngowaka tokuasa 'o so-sowono ta'ikiri.&gt;&gt; Ge'enaka de 'o Yesus kawongosekau wolugu-luguka gee, <verse eid="MRK 2:10" /><verse number="11" style="v" sid="MRK 2:11" />&lt;&lt;Nomomiki! 'Ani kokowa nagoraka la noliou!&gt;&gt;<verse eid="MRK 2:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 2:12" />De kawomomikokau de wi kokowa wagoraka de wosupu 'o nyawa yoodumu wilega-lega. 'O nyawa ge'enaka gee yoherangi so ma Jo'oungu ma Dutu wisiarene yongose 'ato, &lt;&lt;Koma'iwasi pamake 'o no-nako 'ihera-herangi kone'ena!&gt;&gt;<verse eid="MRK 2:12" /></para>
  <para style="s">'O Yesus 'o Lewika wi'asoko</para>
  <para style="r">(<ref loc="MAT 9:9-13">Mat. 9:9-13</ref>; <ref loc="LUK 5:27-32">Luk. 5:27-32</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 2:13" />'O Yesus wainoli 'o Galilea ma talaga ma batingino, de 'o nyawa manga gudai yaino 'unano so wakidotoko. <verse eid="MRK 2:13" /><verse number="14" style="v" sid="MRK 2:14" />'O Yesus wotagi-tagioko ge'enaka de wimake 'o pajaki woga-ga'asoko wimoi wi ronga 'o Lewi, 'o Alfeus wi ngowaka, wogogerie 'o balasitengi ma kantoroka. De 'o Yesus wongose 'unaka, &lt;&lt;Nou, noimoteke ngoi.&gt;&gt; So 'o Lewi ma kawoma'oko de wimoteke 'o Yesus.<verse eid="MRK 2:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 2:15" />'O Yesus wo'odomo ma gu-gudaioka 'o Lewi wi woaka, de 'o balasitengi yoga-ga'asoko de 'o nyawa gee 'o kawasa yakimakeka 'o nyawa ma do-dorou manga gudai yoboa de 'ona mita yomasido'odomo de 'o Yesus de wi do-domoteke. Sababu 'onaka manga gudai 'o Yesus wimoteke. <verse eid="MRK 2:15" /><verse number="16" style="v" sid="MRK 2:16" />'O 'agamaka yodoto-dotoko 'o Farisino yakimake 'o Yesus de 'o balasitengi yoga-ga'asoko de mita 'o nyawa gee 'o kawasa yakimakeka 'o nyawa ma do-dorou, de yosano 'o Yesus wi do-domoteika, &lt;&lt; 'Ido'oa so nia guru womasido'odomo de 'o balasitengi yoga-ga'asoko de 'o nyawa ma do-dorou go'ona?&gt;&gt;<verse eid="MRK 2:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 2:17" />'O Yesus wogi'isene manga sa-sano ge'ena so wosango, wongose 'ato, &lt;&lt; 'O nyawa gee kayosa-sanangi koyoparaluuwa 'o dotere; ma 'ena gee yopa-panyake. Ngoi toboa ge'ena kotaki'asokuwa 'o nyawa gee yoma-maoku yaowa-owau, ma 'ena gee 'o nyawa yosowo-sowono.&gt;&gt;<verse eid="MRK 2:17" /></para>
  <para style="s">'O Yesus wodotoko kokia 'o nyawa yopuasa</para>
  <para style="r">(<ref loc="MAT 9:14-17">Mat. 9:14-17</ref>; <ref loc="LUK 5:33-39">Luk. 5:33-39</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 2:18" />Ma moi ge'ena 'o Yohanes Wo'osi-'osiki wi do-domoteke de 'o Farisioka yopuasaka. De 'o nyawa yaino yosano 'o Yesusino, &lt;&lt; 'Aba! 'Ido'oa so 'o Yohanes wimote-moteke de 'o Farisioka yopuasa de to ngona ni do-domoteke ko'uwa?&gt;&gt;<verse eid="MRK 2:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 2:19" />'O Yesus wosango de wosi'ade-'ade, &lt;&lt;Nako 'o modoka posi'odomo de nanga woa ma gikiri naga yopuasaka? nako womo-modoka ge'enakasi de de 'ona 'o rame ma dodaka ge'ena? Ma raiokau dua yo'odomo. <verse eid="MRK 2:19" /><verse number="20" style="v" sid="MRK 2:20" />Ma gee dua ma 'orasi ya'adono womo-modoka gu'una wi'esekau, 'asa de 'ona koyo'odomuwa.<verse eid="MRK 2:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 2:21" />Komoiwa 'o mosa ma siraka de ma sungi yosipata, sababu ma ba-bata ge'ena dua 'isikaino 'itingoono de yatobaka so 'ifoloi 'iracanga. <verse eid="MRK 2:21" /><verse number="22" style="v" sid="MRK 2:22" />De mita komoiwa 'o 'anggur ma sungi de yodarisi ma ngii<note caller="b" style="f"><char style="fr" closed="false">2:22: </char><char style="ft" closed="false">'O Yahudioka manga 'anggur ma ngii, ge'ena 'o haewani ma kai yadiaiku.</char></note> ma siraku. Sababu dua ma ngii ma sira ge'ena 'isidobooteke so 'ipoaka, ma rai ma 'anggur de ma ngii ge'ena dua koi'iwau. 'O 'anggur ma sungi salingou podarisi ma ngii ma sungikoli!&gt;&gt;<verse eid="MRK 2:22" /></para>
  <para style="s">Yodasano Pomaoma-omasa ma Wange</para>
  <para style="r">(<ref loc="MAT 12:1-8">Mat. 12:1-8</ref>; <ref loc="LUK 6:1-5">Luk. 6:1-5</ref>)</para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 2:23" />Ma moi ge'ena Pomaomasa ma Wangeka, 'o Yesus de wi do-domoteke yaboa 'o gandum ma bairino, de wi do-domoteke yokurue 'o gandum yo'utuku. <verse eid="MRK 2:23" /><verse number="24" style="v" sid="MRK 2:24" />Ge'enaka de 'o Farisioka yongose, &lt;&lt;Ee! 'Ido'oa so 'ani do-domoteke yaparene to ngone nanga 'agama ma besesongo? 'Ona yadiai gee koidadiwa padiai Pomaoma-omasa ma Wangeka.&gt;&gt;<verse eid="MRK 2:24" /></para>
  <para style="p">
    <verse number="25-26" style="v" sid="MRK 2:25-26" />'O Yesus wosango, &lt;&lt;Koniabacawasi? 'okia naga 'o Dautu wodiai, gee ma 'orasi 'o Abyatar wodadi 'o 'Imam ma Amoko? Gee 'o Dautu de wi nyawa-nyawa yakisawinuku de manga 'inomo koi'iwa, 'una wowosanga ma Jou wi Woaka de wa'odomo 'o roti gee 'isisuba-subakau ma Jo'oungu ma Dutuka. De ma roti ge'ena wakikula mita 'awi nyawa-nyawaka. 'Ena momongo moteke nanga 'agama ma besesongo, ka 'o 'imam duga 'idadi ya'odomo.&gt;&gt;<verse eid="MRK 2:25-26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 2:27" />De 'o Yesus wongoseli 'onaka, &lt;&lt;Pomaoma-omasa ma Wange ma Jo'oungu ma Dutu wosidadiku ge'ena ma ngale koinasisangisarawa ma ma dumutu 'inariwo. <verse eid="MRK 2:27" /><verse number="28" style="v" sid="MRK 2:28" />So ngoi 'o Nyawa ma Ngowaka tapareta Pomaoma-omasa ma Wange mita.&gt;&gt;<verse eid="MRK 2:28" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 2" />
  <chapter number="3" style="c" sid="MRK 3" />
  <para style="s">'O nyawa wimoi wi giama ma songona 'isonge-songene</para>
  <para style="r">(<ref loc="MAT 12:9-14">Mat. 12:9-14</ref>; <ref loc="LUK 6:6-11">Luk. 6:6-11</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 3:1" />Ma moi ge'ena 'o Yesus waikali 'o lo-lomu ma woaka, de ge'enaka wimake wimoi wi giama ma songona 'isonge-songene. <verse eid="MRK 3:1" /><verse number="2" style="v" sid="MRK 3:2" />Ge'enaka dau yoboano mita 'o nyawa gee yosinonu-nonu 'o Yesus wi sowono la 'idadi wikalaki. So 'ona kawisilega dua nako la wisouru 'o nyawa gu'una Pomaoma-omasa ma Wangeka. <verse eid="MRK 3:2" /><verse number="3" style="v" sid="MRK 3:3" />'O Yesus kawongosekau wi giama ma songona 'isonge-songenika, &lt;&lt;Nou, nongoka ma bionoka noma'okode.&gt;&gt; <verse eid="MRK 3:3" /><verse number="4" style="v" sid="MRK 3:4" />Ge'enaka de 'o Yesus kawosanokau 'onaka, &lt;&lt;Moteke to ngone nanga 'agama, 'okia 'idadi padiai Pomaoma-omasa ma Wangeka? 'O barangi ma owa bolo ma dorou? 'O nyawa pakisilaha bolo pakito'oma?&gt;&gt;</para>
  <para style="p" vid="MRK 3:4">Ma 'ona kayomarii-riidika. <verse eid="MRK 3:4" /><verse number="5" style="v" sid="MRK 3:5" />'O Yesus witu'uduuku wakilega-lega gee wisigi-gilolitino ma de wi singina 'i'ogu sababu 'ona kaifoloi manga singina 'i'opini. Ge'enaka de kawongosekau wi giama 'isonge-songenika, &lt;&lt; 'Ani giama naboootika.&gt;&gt; 'O nyawa gu'una wi giama waboooto, de wi giama ge'ena koisongenuawau. <verse eid="MRK 3:5" /><verse number="6" style="v" sid="MRK 3:6" />So ma rai 'o Farisioka yamada ma lo-lomu ma woaka ge'ena, de yomasikadibangi de yamuruo naga gee 'o Herodes wimote-moteke, la 'o Yesus wito'oma.<verse eid="MRK 3:6" /></para>
  <para style="s">'O nyawa manga gudaioka 'o talaga ma batingoka</para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 3:7" />'O Yesus de wi do-domoteke yotagi yomatingaka 'o Galilea ma talagaka. De 'o Galilea ma nyawa manga gudai yotagi 'o Yesus wimoteke. Manga gudai mita yoboano 'o Yudeano, <verse eid="MRK 3:7" /><verse number="8" style="v" sid="MRK 3:8" />'o Yerusalemuno, 'o Idumea ma daeraano, 'o Yordan ma songonasa dina ma daeraano, de 'o Tirus de 'o Sidon ma kota ma kakadate-dateoka ma daeraano. 'Ona yoodumu yaino 'o Yesusino, sababu yo'isene 'okia sonaa wokadiaiokau gee. <verse eid="MRK 3:8" /><verse number="9" style="v" sid="MRK 3:9" />'O nyawa go'ona kaifoloi yokudaioka, so ma rai 'o Yesus wosuloko wi do-domoteke widakalari 'o ngo'otiri, 'uwa sigado 'o nyawa go'ona wisibe'eto. <verse eid="MRK 3:9" /><verse number="10" style="v" sid="MRK 3:10" />'O nyawa manga gudai wakisi'aiki, so ma rai yopa-panyake yoodumu yomasikasisu yomau yomasisori 'unaka la 'idadi wi'ao. <verse eid="MRK 3:10" /><verse number="11" style="v" sid="MRK 3:11" />De 'o nyawa gee 'o tokata yakido-dongosamuku wimake 'isinoimi yosubaku wi bionoka de yomapoaka, &lt;&lt;Ngona ne'ena ma Jo'oungu ma Dutu wi Ngowaka!&gt;&gt;<verse eid="MRK 3:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 3:12" />Ma 'o Yesus ka ma eta ma kowosidabiwa 'o tokata ge'ena 'isikademo 'ato 'una ge'ena nagu'una.<verse eid="MRK 3:12" /></para>
  <para style="s">'O Yesus wakiiriki 'awi do-domoteke yamogiooko de modidi</para>
  <para style="r">(<ref loc="MAT 10:1-4">Mat. 10:1-4</ref>; <ref loc="LUK 6:12-16">Luk. 6:12-16</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 3:13" />Ge'enaka de 'o Yesus wosau 'o gigiede, de waki'asoko 'o nyawa gee moteke to 'una wi mau. De 'ona mita yaika 'unaka. <verse eid="MRK 3:13" /><verse number="14" style="v" sid="MRK 3:14" />Wakiiriki yamogiooko de modidi de kawongosekau, &lt;&lt;Ngoi tiniiriki la nimoteke ngoi, ma ngale tinisuloko niosidagi 'o Habari ma Owa ma Jo'oungu ma Dutuno, <verse eid="MRK 3:14" /><verse number="15" style="v" sid="MRK 3:15" />de ngini 'asa tinikula 'o kuasa de 'o pareta ma ngale 'o tokata nioginiiki.&gt;&gt;<verse eid="MRK 3:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 3:16" />Yamogiooko de modidi gee yakiiri-iriki yodadi su-suloko manga ronga-ronga koneda: 'O Simon, (gee wisironga-ronga mita 'o Petrus), <verse eid="MRK 3:16" /><verse number="17" style="v" sid="MRK 3:17" />'o Yakobus de ma dodoto 'o Yohanes, 'o Zebedeus wi ngowa-ngowaka, ('ona yakisironga 'o Boanerges, ma ngale &lt;&lt; 'o duturu ma ngowaka&gt;&gt;), <verse eid="MRK 3:17" /><verse number="18" style="v" sid="MRK 3:18" />mita 'o Andreas, 'o Filipus, 'o Bartolomeus, 'o Matius, 'o Tomas, 'o Yakobus 'o Alfeus wi ngowaka, 'o Tadeus, 'o Simon 'o Zelot ma nyawa,<note caller="c" style="f"><char style="fr" closed="false">3:18: </char><char style="ft" closed="false">'O Zelot ma nyawa ge'ena la 'o Yahudioka 'o paratei moi gee yomariwo-riwo 'o Romaka yakiginiiki.</char></note> <verse eid="MRK 3:18" /><verse number="19" style="v" sid="MRK 3:19" />de 'o Yudas Iskariot gee woba-badingaka 'o Yesusika.<verse eid="MRK 3:19" /></para>
  <para style="s">'O Yesus de 'o Tokata ma Koana gee yosironga 'o Beelzebul</para>
  <para style="r">(<ref loc="MAT 12:22-32">Mat. 12:22-32</ref>; <ref loc="LUK 11:14-23">Luk. 11:14-23</ref>, <ref loc="LUK 12:10">12:10</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 3:20" />Ge'enaka de 'o Yesus wolio 'o woaka. Ma 'o nyawa manga gudai yoboa yomatoomuoli, sigado 'o Yesus de wi do-domoteke kayo'odomo ma koidadiwa. <verse eid="MRK 3:20" /><verse number="21" style="v" sid="MRK 3:21" />'O nyawa kayongosekau, &lt;&lt; 'Una witogosangukou!&gt;&gt; De gee 'awi 'esa moi yo'isenoka 'o demo ge'ena, de yaika wi'ese.<verse eid="MRK 3:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 3:22" />'O 'agamaka yodoto-dotoko 'o Yerusalemino yoboano de kayongosekau, &lt;&lt; 'Una 'o Beelzebul widongosamuku! 'Enau wikulaka 'o kuasa ma ngale woginiiki 'o tokata.&gt;&gt;<verse eid="MRK 3:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 3:23" />So 'o Yesus waki'asokino de wakidajarita 'o 'ade-'ade ngai muruo naga. Kawongosekau, &lt;&lt;Kokia 'idadi 'o tokata de 'o tokata 'imakaginiiki. <verse eid="MRK 3:23" /><verse number="24" style="v" sid="MRK 3:24" />Nako 'o Koana moi 'awi pareta ma sigoronaka 'o bolu yamo-moi yomatingaka yomaka'aku'uwa, ge'ena dua 'awi pareta ge'ena kaipiakoroka. <verse eid="MRK 3:24" /><verse number="25" style="v" sid="MRK 3:25" />Koge'enali mita nako 'o giabereki moi la koyomarimoiwa, de manga woa ma dodaku yomakadu'uduku ge'ena dua yomakati-tingaoka. <verse eid="MRK 3:25" /><verse number="26" style="v" sid="MRK 3:26" />So nako 'o tokata de to 'ena ma balusu 'imakaparangi, ge'ena dua ma raiokau koito'ingokawa de ma pareta kaitorouoka.<verse eid="MRK 3:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 3:27" />Komoiwa moi 'idadi yowosanga wimoi wokua-kuata wi woaka de wi harataa ya'ora, nako 'o nyawa gu'una kowipusukuawasi. So salingou wipusuokasi 'asa de ya'ora 'awi harataa ge'ena.<verse eid="MRK 3:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 3:28" />Bika niosigisene! Nako 'o nyawa yosowono de yobi-bicara yositi-tingoono, ge'ena manga sowono kai'ikirokasi. <verse eid="MRK 3:28" /><verse number="29" style="v" sid="MRK 3:29" />Ma nako yositi-tingoono 'o Ngomasa 'Itebi-tebini, ge'ena manga sowono koi'ikiruawau. Sababu yositi-tingoono 'o Ngomasa 'Itebi-tebini, ge'ena 'o sowono kaisi'ado-'adonika.&gt;&gt; (<verse eid="MRK 3:29" /><verse number="30" style="v" sid="MRK 3:30" />'O Yesus koge'ena wongose, sababu naga 'o nyawa yongose 'ato 'o Yesus 'o tokata widongosamuku.)<verse eid="MRK 3:30" /></para>
  <para style="s">'O Yesus ma 'esa de wi riaka dodoto</para>
  <para style="r">(<ref loc="MAT 12:46-50">Mat. 12:46-50</ref>; <ref loc="LUK 8:19-21">Luk. 8:19-21</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 3:31" />Ge'ena 'iduangino de 'o Yesus ma 'esa de wi riaka dodoto yoboa. 'Ona yota-tamaa ma dudunoka, de yosuloko 'o nyawaka 'o Yesus wi'asoko. <verse eid="MRK 3:31" /><verse number="32" style="v" sid="MRK 3:32" />Ma 'orasi ge'ena 'o nyawa manga gudaioka yogogerie 'o Yesus wisibululunino. 'Ona yongose 'unaka, &lt;&lt; 'Aba, 'ani 'esa de ni riaka dodoto doka ma dudunoka. 'Ona ninonu ngona 'Aba.&gt;&gt;<verse eid="MRK 3:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 3:33" />'O Yesus kawosangokau, &lt;&lt;Nagumuna to ngoi 'ai 'esa? De nago'ona to ngoi 'ai riaka dodoto?&gt;&gt; <verse eid="MRK 3:33" /><verse number="34" style="v" sid="MRK 3:34" />Ge'enaka de wakilega-lega 'o nyawa wisigi-gilolitino gee de kawongosekau, &lt;&lt;No'ona to ngoi 'ai 'esa de 'ai riaka dodoto! <verse eid="MRK 3:34" /><verse number="35" style="v" sid="MRK 3:35" />'O nyawa gee ma Jo'oungu ma Dutu 'awi mau yamote-moteke, 'ona ge'ena to ngoi 'ai riaka dodoto, 'ai 'esa biranga de 'ai 'esa.&gt;&gt;<verse eid="MRK 3:35" /></para>
  <para style="rem">Penyunting : Ning 18-7-2008</para>
  <chapter eid="MRK 3" />
  <chapter number="4" style="c" sid="MRK 4" />
  <para style="s">'O 'ade-'ade moi 'o nyawa 'awi fini wopiakoro</para>
  <para style="r">(<ref loc="MAT 13:1-9">Mat. 13:1-9</ref>; <ref loc="LUK 8:4-8">Luk. 8:4-8</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 4:1" />'O Yesus wodotokoli 'o Galilea ma talaga ma batingoka. 'O nyawa kayokudaiokali widoomuno, so waika 'o ngo'otiri moioka wogogeruku gee 'imatapu-tapuku 'o 'akeroka, de yoku-kudai 'ona yoma'okode 'o talaga ma batingoka. <verse eid="MRK 4:1" /><verse number="2" style="v" sid="MRK 4:2" />Ge'enaka de 'o Yesus wakisidotoko 'okia sonaa 'o gudai, wopake 'o 'ade-'ade. Konedau wakidotoko:<verse eid="MRK 4:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 4:3" />&lt;&lt;Bika niosigisene! Wopai-pairi wimoi wotagi 'o fini wopiakoro. <verse eid="MRK 4:3" /><verse number="4" style="v" sid="MRK 4:4" />Gee wopiakoro, de munuka 'itotaka 'o ngekomuku. Ge'enaka de 'o namoro 'iboa so ya'odomo yabootoka. <verse eid="MRK 4:4" /><verse number="5" style="v" sid="MRK 4:5" />Munuka 'itotaka 'o tonaka 'ikakatetoku gee ma tonaka ka ma etaka. Ma fini ge'ena ma japatioka 'igo'oo, sababu ma tonaka koikipirinuwa, <verse eid="MRK 4:5" /><verse number="6" style="v" sid="MRK 4:6" />ma gee 'o wange yodasauku de ma fini 'igo-go'oode ge'ena 'imaai deika 'i'osaka, so 'isongene sababu 'imasingutuku koikurutukuwa. <verse eid="MRK 4:6" /><verse number="7" style="v" sid="MRK 4:7" />Mita munuka 'itotaka 'o sisika ma gu-gudaiku, de ma sisika ge'ena 'ifero so ma fini ma go'oo ge'ena yapilatu so kaisowokuwa. <verse eid="MRK 4:7" /><verse number="8" style="v" sid="MRK 4:8" />Ma naga mita 'itotaka 'o tonaka 'iro-roromoku. Ge'ena 'igo'oo de 'ifero so 'isowoko munuka 'iliono 'o nagi sa'angeka, munuka 'o nagi butangaka, munuka 'o ratusu moika.&gt;&gt;<verse eid="MRK 4:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 4:9" />Wakidajarita 'iduanga 'o 'ade-'ade ge'ena de kawongosekau, &lt;&lt;De nia ngaukoka so nio'isenika!&gt;&gt;<verse eid="MRK 4:9" /></para>
  <para style="s">'Ido'oa so 'o Yesus wopake 'o 'ade-'ade</para>
  <para style="r">(<ref loc="MAT 13:10-17">Mat. 13:10-17</ref>; <ref loc="LUK 8:9-10">Luk. 8:9-10</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 4:10" />Ma 'orasi 'o Yesus kawomatengoka, de 'o nyawa gee yo'ise-'isenokau 'awi do-dotoko, de mita 'awi do-domoteke yamogiooko de modidi yaino 'unano. 'Ona yoga'asoko wosiwaiti 'o 'ade-'ade ge'ena ma ngale. <verse eid="MRK 4:10" /><verse number="11" style="v" sid="MRK 4:11" />So 'o Yesus kawongosekau 'onaka, &lt;&lt;Ngini nikulakau 'o co-catu ma ngale niosikanako kokia ma Jo'oungu ma Dutu wopareta gee 'o nyawa 'iregu koyanakowasi. Ma 'o nyawa 'iregu takidotoko de 'o 'ade-'ade. <verse eid="MRK 4:11" /><verse number="12" style="v" sid="MRK 4:12" />La 'itiai moteke ma demo konaneda:</para>
  <para style="q1" vid="MRK 4:12">&lt;La ngaro 'ona kayodiriidokau</para>
  <para style="q2" vid="MRK 4:12">ma koyanakowa 'okia 'idadi;</para>
  <para style="q1" vid="MRK 4:12">'ona 'asa koyomaogoruwa yosigisene</para>
  <para style="q2" vid="MRK 4:12">ma koyasahewa,</para>
  <para style="q1" vid="MRK 4:12">la 'uwa yamake de yasahe</para>
  <para style="q2" vid="MRK 4:12">de 'uwa yoboa ma Jo'oungu ma Dutuka</para>
  <para style="q2" vid="MRK 4:12">de wakisilaha.&gt; &gt;&gt;<verse eid="MRK 4:12" /></para>
  <para style="s">'O Yesus wosiwaiti 'o 'ade-'ade gee 'o nyawa wimoi 'o fini wopiakoro ma ngale</para>
  <para style="r">(<ref loc="MAT 13:18-23">Mat. 13:18-23</ref>; <ref loc="LUK 8:11-15">Luk. 8:11-15</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 4:13" />Ge'enaka de 'o Yesus kawongosekau 'onaka, &lt;&lt;Nako koniasahewa 'o 'ade-'ade ge'ena, kokia 'idadi niasahe 'o 'ade-'ade 'iregu-regu? <verse eid="MRK 4:13" /><verse number="14" style="v" sid="MRK 4:14" />Wopai-pairi wimoi ge'ena 'o nyawa gee yosidagi-dagi ma Jo'oungu ma Dutu 'awi demo. <verse eid="MRK 4:14" /><verse number="15" style="v" sid="MRK 4:15" />'O fini gee 'itotaka 'o ngekomuku, ge'ena 'isoka 'o nyawa gee yo'isenokau ma Jo'oungu ma Dutu 'awi demo. Gee yo'isenoka de 'o Tokata ma Koana 'iboa de ya'eseka ma Jo'oungu ma Dutu wi demo gee manga singinakau. <verse eid="MRK 4:15" /><verse number="16" style="v" sid="MRK 4:16" />'O fini gee 'itotaka 'o tonaka 'iteto-tetoku, ge'ena 'isoka 'o nyawa gee yo'isenoka ma demo ge'ena de yadawongokau kayomore-morene. <verse eid="MRK 4:16" /><verse number="17" style="v" sid="MRK 4:17" />Ma 'o demo ge'ena koimasingutukuwa manga singinaka, so kaito'ingokawa. Ka gee yosangisara bolo yakisikisaa sababu 'o demo ge'ena, de yamadakau. <verse eid="MRK 4:17" /><verse number="18" style="v" sid="MRK 4:18" />'O fini gee 'itotaka 'o sisika ma dodaku, ge'ena 'isoka 'o nyawa gee yo'isenokau 'o demo ge'ena, <verse eid="MRK 4:18" /><verse number="19" style="v" sid="MRK 4:19" />ma yododato ma ngale manga 'ahu, de yomau kayokorago, de manga singina ma dodaka 'okia sonaa 'i'ini-'inioka yonyafisuu. So yape'etoro 'o demo ma Jo'oungu ma Dutuno so koisowokuwa. <verse eid="MRK 4:19" /><verse number="20" style="v" sid="MRK 4:20" />De 'o fini gee 'itotaka 'o tonaka 'iro-roromoku, ge'ena kaimatero de 'o nyawa gee yo'isenoka 'o demo ge'ena de yadawongo. 'Ona yakidosowoko ma giliono munuka 'o nagi sa'angeka, munuka 'o nagi butangaka de munuka 'o ratusu moika.&gt;&gt;<verse eid="MRK 4:20" /></para>
  <para style="s">'O poci 'o pa'udi 'isitamunuku</para>
  <para style="r">(<ref loc="LUK 8:16-18">Luk. 8:16-18</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 4:21" />Ge'enaka de 'o Yesus wongoseli, &lt;&lt;Komoiwa 'o silo yatuuika de 'o pa'udi yositamunuku, bolo yanoaku 'o dangiri ma timioka. Ma raiokau yatamide ma silo ma ngiioka. <verse eid="MRK 4:21" /><verse number="22" style="v" sid="MRK 4:22" />Koi'iwa gee 'o nyawa koyanako-nakowasi dua koisupuwa, de koi'iwa gee koisidumu-dumutuawasi 'asa koiwaituwa. <verse eid="MRK 4:22" /><verse number="23" style="v" sid="MRK 4:23" />Sababu ge'ena, nio'isenika nako de nia ngaukoka!&gt;&gt;<verse eid="MRK 4:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 4:24" />Ge'enaka de kawongosekauoli, &lt;&lt;Niatagoko niosidi-diai 'okia naga nio'isene! 'O du-duga gee kiaka ngini niapake niakisituga 'o nyawaka koge'enali mita ma Jo'oungu ma Dutu winisituga nginika. <verse eid="MRK 4:24" /><verse number="25" style="v" sid="MRK 4:25" />Sababu to nago'ona de ma 'enau, ge'ena dua 'ifoloiosi 'ikudai yakikula; ma gee to nago'ona koi'iwa, ge'ena gee ma etakasi 'onaka ma 'asa ya'eseka mita.&gt;&gt;<verse eid="MRK 4:25" /></para>
  <para style="s">'O 'ade-'ade 'o fini 'i'oo</para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 4:26" />'O Yesus wosidowangoli 'awi bicara, &lt;&lt;Nako ma Jo'oungu ma Dutu wopareta ma ngale wokoana, ge'ena ma jako 'idadi 'isi'ade-'ade 'isoka 'o nyawa wimoi 'o fini wopiakoro wi bairoka. <verse eid="MRK 4:26" /><verse number="27" style="v" sid="MRK 4:27" />'O obiri woma'idu de 'o wange womomiki; 'ena wi fini ge'ena kayaika-ikaka 'ifero sigado 'iamoko. Ma kokia ma do-dagi 'awi fini ge'ena 'igo'oo de 'ifero, 'una kowanakowa. <verse eid="MRK 4:27" /><verse number="28" style="v" sid="MRK 4:28" />'O tonakou ma sirete 'isisupu ma hasili ge'ena; ma si-siraka ma bosono, 'asa de 'isooboto, 'asa deika 'iti'imono. <verse eid="MRK 4:28" /><verse number="29" style="v" sid="MRK 4:29" />De nako ma joro ge'ena 'i'umuokau, ge'ena 'o nyawa gu'una wokurueu wo'utuku sababu 'o gutuku ma 'orasi ya'adonokau.&gt;&gt;<verse eid="MRK 4:29" /></para>
  <para style="s">'O 'ade-'ade 'o sawi<note caller="d" style="f"><char style="fr" closed="false">4:30-34: </char><char style="ft" closed="false">'O sawi 'o Palestinaka ge'ena ma gurutie poilia sigado 'o meteri sa'ange.</char></note> ma doda</para>
  <para style="r">(<ref loc="MAT 13:31-34">Mat. 13:31-34</ref>; <ref loc="LUK 13:18-19">Luk. 13:18-19</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 4:30" />'O Yesus wosanoli, &lt;&lt;Nako ma Jo'oungu ma Dutu wopareta, de 'okia 'idadi posikatero? De 'okia posi'ade-'ade la posiwaiti? <verse eid="MRK 4:30" /><verse number="31" style="v" sid="MRK 4:31" />Ma Jo'oungu ma Dutu wopareta ge'ena 'isoka 'o 'ade-'ade ne'ena: 'O nyawa wimoi 'o sawi ma doda 'o muhi moi wa'ese de watuduku. 'O sawi ma doda ge'ena 'ifoloi 'itingoono de 'o joro 'iregu-iregu ma doda 'o duniaka. <verse eid="MRK 4:31" /><verse number="32" style="v" sid="MRK 4:32" />Ma nako 'i'oodeu ge'ena 'ena 'ifoloi 'iamokie de 'o joro 'iregu-regu. Ma sago-sago 'ikudaioka so 'o namoro yokadi'igutu ge'enaka.&gt;&gt;<verse eid="MRK 4:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 4:33" />'O Yesus 'o nyawa wakidotoko de 'o 'ade-'ade 'o gudai bekoge'ena, de kogee kayasaheka de koge'ena. <verse eid="MRK 4:33" /><verse number="34" style="v" sid="MRK 4:34" />'O Yesus nako wakidotoko 'o nyawa go'ona, ge'ena kaitaurika wopake 'o 'ade-'ade. Ma nako ka 'una de wi do-domoteke, ge'ena 'iodumu kawakisiti-tiaika.<verse eid="MRK 4:34" /></para>
  <para style="s">'O Yesus 'o rato wosiogoro</para>
  <para style="r">(<ref loc="MAT 8:23-27">Mat. 8:23-27</ref>; <ref loc="LUK 8:22-25">Luk. 8:22-25</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 4:35" />Kage'ena ma wange maatuku mita, de 'o Yesus kawongosekau 'awi do-domoteika, &lt;&lt;Nou, ngone posidete 'o talaga ma songonaka.&gt;&gt;<verse eid="MRK 4:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 4:36" />So 'o Yesus de wi do-domoteke yokokiparenokau ka 'o ngo'otiri moi, de 'o nyawa yoku-kudai 'ona ge'ena 'o talaga ma batingoka yakimadakou. 'O ngo'otiri 'iregu-regu de ma 'ena mita ge'enaka. Ge'enaka de 'o Yesus de wi do-domoteke yosidete. <verse eid="MRK 4:36" /><verse number="37" style="v" sid="MRK 4:37" />Koito'ingowa de yakidarato de manga ngo'otiri 'o moku-moku yapoka de 'o 'akere 'iwosama ya'omangou, so tanu 'ilutuou. <verse eid="MRK 4:37" /><verse number="38" style="v" sid="MRK 4:38" />'Ena 'o Yesus woma'iduoka ge'ena 'o ngo'otiri ma aseroka 'awi saeke wapanginie. De 'awi do-domoteke witomanga, kayongosekau, &lt;&lt;Ee 'Aba Guru, konokalesanguawa ngone pobodito?&gt;&gt;<verse eid="MRK 4:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 4:39" />'O Yesus womomiki de wodorofu 'o ratoka, wongose 'ato, &lt;&lt;Nomaogoro!&gt;&gt; de 'o talagaka wongose 'ato, &lt;&lt;Nomariidi!&gt;&gt; So 'o rato ma 'imaogorokau de ma talaga ma 'isoka 'o gooorou patarisie. <verse eid="MRK 4:39" /><verse number="40" style="v" sid="MRK 4:40" />Ge'enaka de wakidongose 'awi do-domoteika, &lt;&lt;Tei! 'Ido'oa so nimodongo? 'Ido'oa so koningakuwa?&gt;&gt;<verse eid="MRK 4:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 4:41" />So 'ona yakimodongo ma de yoherangi, de yomakadongose, &lt;&lt; 'Una ne'ena nagu'una so 'o rato de 'o moku-moku wisingounu?&gt;&gt;<verse eid="MRK 4:41" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 4" />
  <chapter number="5" style="c" sid="MRK 5" />
  <para style="s">'O Yesus 'o tokata woginiiki 'o nyawaka widongosamuku</para>
  <para style="r">(<ref loc="MAT 8:28-34">Mat. 8:28-34</ref>; <ref loc="LUK 8:26-39">Luk. 8:26-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 5:1" />Ge'enaka de 'o Yesus de wi do-domoteke yototara 'o Galilea ma talaga ma songonaka, 'o Gerasa ma tonaoka. <verse eid="MRK 5:1" /><verse number="2" style="v" sid="MRK 5:2" />Gee 'o Yesus wo'uti 'o ngo'otiroka, de wimoi waino 'o Yesusino 'o bo'osuku ma li'ateno wosupu. <verse eid="MRK 5:2" /><verse number="3" style="v" sid="MRK 5:3" />'Una 'o tokata widongosamuku so wi ngii ka 'o bo'osuku ma li'ateka. 'Una koidadiwau wipusuku ngaro ka de 'o ranteu ma. <verse eid="MRK 5:3" /><verse number="4" style="v" sid="MRK 5:4" />'Ijaga wi dou de wi giama yaranteka ma ka ma noimi kawatoaoka, de 'o besi gee wi douoka yosipi-pilatuno ma kawa'oguoka. 'Una kaifoloi wokuata sigado komoiwa moi wi'akunu. <verse eid="MRK 5:4" /><verse number="5" style="v" sid="MRK 5:5" />'O wange de 'o obiri kawodagi-dagi 'o bo'osuoka de 'o diko-dikoka naga kawomasa-sagaga, de 'o teto 'idoto-doto womasikaluiti wi roesie.<verse eid="MRK 5:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 5:6" />'O gurutikasi 'ena wimakekau 'o Yesus woboa, de woowa-owaroko wosubaku 'o Yesus wi bionoka. <verse eid="MRK 5:6" /><verse number="7" style="v" sid="MRK 5:7" />De waamo-amokie womapoaka, wongose 'ato, &lt;&lt;Ee Yesus ma Jo'oungu ma Dutu gee 'ifoloi wodaduie wi Ngowaka! Dua noido'oau ngoino? Ma Jo'oungu ma Dutu wi bionoka, ngoi toga'asoko 'uwa noisikisaa!&gt;&gt; (<verse eid="MRK 5:7" /><verse number="8" style="v" sid="MRK 5:8" />'O nyawa gu'una koge'ena wongose sababu 'o Yesus wongose 'unaka, &lt;&lt;Ee tokata, nosupuka 'o nyawaka nu'una!&gt;&gt;)<verse eid="MRK 5:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 5:9" />De 'o Yesus wosano 'enaka, &lt;&lt;To ngona ni ronga 'okia?&gt;&gt;</para>
  <para style="p" vid="MRK 5:9">De 'ena 'isango, &lt;&lt;To ngoi 'ai ronga, &lt; 'O Kudai&gt; -- sababu ngomi ne'ena 'ena miagudaioka!&gt;&gt; <verse eid="MRK 5:9" /><verse number="10" style="v" sid="MRK 5:10" />De 'isigali-gali 'imaga'asoko 'o Yesusika la 'uwa wakiniiki ge'ena ma daeraaka.<verse eid="MRK 5:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 5:11" />Ge'ena ma daeraa ma dateoka 'o juku 'o gudaioka 'iti-timiono ma 'inomo 'imadononu 'o gigie ma agaroka. <verse eid="MRK 5:11" /><verse number="12" style="v" sid="MRK 5:12" />So 'o tokata 'imaga'asoko 'o Yesusika 'ingose 'ato, &lt;&lt;Nako yaowa de nosuloko la ngomi miowosanga 'o juku 'iku-kudaika.&gt;&gt; <verse eid="MRK 5:12" /><verse number="13" style="v" sid="MRK 5:13" />De 'o Yesus wosidabi so gee 'isupu 'o nyawaka gu'una de 'iwosanga 'o jukuka. So ma rai 'o juku poilia 'o caana modidi ge'ena 'iowara de daukuku 'o talagaku 'imatebulu so 'ikokilutuoka.<verse eid="MRK 5:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 5:14" />'O juku yoso-sowohi go'ona mita yoowaroka de yosikademo ma hali ge'ena 'o kotaka de 'o soa-soanika ge'ena ma daeraa ma date-dateoka, so 'o nyawa-nyawa yokokiboa yalega 'okia naga 'idadiokau gee. <verse eid="MRK 5:14" /><verse number="15" style="v" sid="MRK 5:15" />'Ona yaika 'o Yesusika de wimake 'o nyawa gee kangano 'o tokata wido-dongosamuku wogogerie ge'enaka, womabajukou de wi singina mita 'itiaiokau, so 'ona yoodumu yakimodongo de kayoki-kiliri. <verse eid="MRK 5:15" /><verse number="16" style="v" sid="MRK 5:16" />'O nyawa gee 'ona ma sirete yamake-makekau 'okia naga 'idadi 'o nyawaka gu'una de 'o jukuoka, yosijarita gee 'idadi-dadiokau ge'ena. <verse eid="MRK 5:16" /><verse number="17" style="v" sid="MRK 5:17" />Ge'enau so 'o daeraa ma dutu go'ona yotiliwoso 'o Yesusika la wamadakau ma daeraa ge'ena.<verse eid="MRK 5:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 5:18" />Gee 'o Yesus woparenoli 'o ngo'otiruku, de ko kangano 'o tokata wido-dongosamuku gee womasibaja 'o Yesusika 'ato 'una mita womoteke.<verse eid="MRK 5:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 5:19" />Ma 'o Yesus kowosidabiwa so kawisuloko wongose 'ato, &lt;&lt;Noliou ni woaka, naika de nosidemo 'ani 'esa moika 'okia naga gee ma Jou wodiaiokau ngonaka de wi singina 'isure ma sala ngonaka.&gt;&gt;<verse eid="MRK 5:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 5:20" />So 'o nyawa gu'una wolio 'o Kota Mogiooko ma daeraaka de wosihabari 'ato 'una 'o Yesus wisi'aikokau, de gee yo'ise-'isene go'ona kayoki-kiliri.<verse eid="MRK 5:20" /></para>
  <para style="s">'O Yairus 'awi ngowaka 'o ngeweka de mimoi gee 'o Yesus 'awi bajuka matigi</para>
  <para style="r">(<ref loc="MAT 9:18-26">Mat. 9:18-26</ref>; <ref loc="LUK 8:40-56">Luk. 8:40-56</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 5:21" />'O Yesus wolioli 'o talaga ma songonaka. De 'o nyawa manga gudai yaino yomatoomu 'o Yesus wisibululunino ge'ena ma talaga ma batingoka. <verse eid="MRK 5:21" /><verse number="22" style="v" sid="MRK 5:22" />De wimoi woboa wi ronga 'o Yairus. 'Una 'o lo-lomu ma woa ma balusu ge'ena ma kotaka. Gee wimakeka 'o Yesus de waino so wi bionoka womatalibukuku, <verse eid="MRK 5:22" /><verse number="23" style="v" sid="MRK 5:23" />de wobaja 'o Yesusika, wongose 'ato, &lt;&lt; 'Aba, 'ai ngowaka 'o ngeweka mopanyake 'itubuso so tanu noboa moni'aosi la 'ami panyake 'i'aiki! Tooluku sigado mositorou!&gt;&gt;<verse eid="MRK 5:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 5:24" />Ge'enaka de kayotagiokau 'o Yairus wi woaka de 'o nyawa manga gudai yomoteke kiano naga bato, sigado 'o Yesus wisikabilatu.<verse eid="MRK 5:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 5:25" />Ge'enaka dau mimoi 'o ngeweka ma panyake midaene de mi 'aunu 'itagi 'o taunu mogiooko de modidinou. <verse eid="MRK 5:25" /><verse number="26" style="v" sid="MRK 5:26" />Ma gudaiou momasibau yosou-sourika, duga sioko! 'ami panyake ge'ena koi'aikuwa so kaifoloi monga. 'Ena 'ami harataa ma 'ibootokau mosibakau yosou-sourika. <verse eid="MRK 5:26" /><verse number="27" style="v" sid="MRK 5:27" />'O ngeweka gumuna 'o gudaiou mokagi-gi'isene ma ngale 'o Yesus. So ge'ena ma nyawa yoku-kudaioka dau momasisori 'o Yesus wi dudunino, <verse eid="MRK 5:27" /><verse number="28" style="v" sid="MRK 5:28" />sababu matibangi 'ato, &lt;&lt;Ngaro ka wi jubaka ma eta tatigi ma dua 'ai panyake 'i'aiki!&gt;&gt;<verse eid="MRK 5:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 5:29" />Matigioka de mi 'aunu koitagiwau. De momasimao 'ami panyake ge'ena 'i'aiokau. <verse eid="MRK 5:29" /><verse number="30" style="v" sid="MRK 5:30" />Ma 'orasi ge'ena mita 'o Yesus wamao 'awi guata 'isupu 'awi roesoka. So womapulutuoko wokasano 'o nyawa yoku-kudaika, &lt;&lt;Nago'ona 'ai jubaka yatigi?&gt;&gt;<verse eid="MRK 5:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 5:31" />De 'awi do-domoteke kayongosekau, &lt;&lt; 'Aba, ngona ma sirete namake 'o nyawa kayotuonou, de nosanosi nago'ona 'ani jubaka yatigi?&gt;&gt;<verse eid="MRK 5:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 5:32" />Ma 'o Yesus kowomaogoruwa womadutumu 'o gubali de 'o giniraka ma ngale wanonu nago'ona 'awi jubaka yatigi. <verse eid="MRK 5:32" /><verse number="33" style="v" sid="MRK 5:33" />'O ngeweka gumuna gee mamaokau 'okia naga 'idadiokau munaka, de mimodongo motirineka mosubaku 'o Yesus 'awi bionoka de mosidemo 'iodumu ge'ena. <verse eid="MRK 5:33" /><verse number="34" style="v" sid="MRK 5:34" />Ge'enaka de 'o Yesus kawongosekau munaka, &lt;&lt;Ee biranga, sababu noingaku so 'ani panyake ma dubuso koge'ena ma, 'i'aiokau! Notagiou de ni singina 'isa-sanangi. Ngona nosanangi 'itiaiokau!&gt;&gt;<verse eid="MRK 5:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 5:35" />'O Yesus kawobicarasi, de 'o Yairus wi ro-riwo yamuruo naga yoboa yosibusukino 'o Yairusika yongose 'ato, &lt;&lt;Bereki, ngaro 'uwau wonisikadangono wodoto-dotoko gu'una sababu 'ani ngowaka gumuna mosongenokau.&gt;&gt;<verse eid="MRK 5:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 5:36" />Ma 'o Yesus kawokalesangikawa so wongose 'o Yairusika, &lt;&lt; 'Uwa ni singina 'i'ogu, kanoingaku bato!&gt;&gt; <verse eid="MRK 5:36" /><verse number="37" style="v" sid="MRK 5:37" />Ge'enaka de 'o Yesus kawogila-gila 'o Yairus wi woaka, ma 'o nyawa ma somoa ka moi ma kowakisidabiwa yomoteke, duga ka 'o Petrus, de 'o riaka dodoto yamididi ge'ena la 'o Yohanes de 'o Yakobus. <verse eid="MRK 5:37" /><verse number="38" style="v" sid="MRK 5:38" />Gee ya'adonika de 'o Yesus wakilega-lega 'ena manga gudaioka yaika yaino kasagarika, yogaribetongo de yoto-tora. <verse eid="MRK 5:38" /><verse number="39" style="v" sid="MRK 5:39" />Ge'enaka de 'o Yesus wowosangika de kawongosekau 'onaka, &lt;&lt; 'Ido'oa so niokoya de nio'ari? 'O ngowaka numuna komosongenuwa, kamonisuoka!&gt;&gt;<verse eid="MRK 5:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 5:40" />Ma 'ona yoodumu kawisi'iete 'o Yesusika. So wakisuloko 'ona yoodumu yosupuoka de waki'asa 'o ngowaka gumuna mi 'esa de mi dea de to 'una 'awi do-domoteke yaruange yowosanga 'o ngowaka gumuna 'ami ngiika. <verse eid="MRK 5:40" /><verse number="41" style="v" sid="MRK 5:41" />De 'o Yesus wa'ao 'ami giamika de wongose munaka, &lt;&lt;Talita kum!&gt;&gt; Ngone tanu, &lt;&lt;Ee biranga, nomomiki!&gt;&gt;<verse eid="MRK 5:41" /></para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 5:42" />Ge'enaka de 'o mosolese gumuna momomiki so motagi-tagi. So yoodumu gee yamake-make 'idadiokau ge'ena posironga kayoki-kiliri. Muna 'ami 'umuru 'o taunu mogiooko de modidiou. <verse eid="MRK 5:42" /><verse number="43" style="v" sid="MRK 5:43" />Ma 'o Yesus ka ma eta ma kowakisidabiwa yosikademo ma hali ge'ena nago'onaka bato. De 'ami balusika wongose, &lt;&lt;Bika 'o 'inomo minikula la mo'odomo.&gt;&gt;<verse eid="MRK 5:43" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 5" />
  <chapter number="6" style="c" sid="MRK 6" />
  <para style="s">'O Yesus de 'awi do-domoteke yolio 'o Nazaretika</para>
  <para style="r">(<ref loc="MAT 13:53-58">Mat. 13:53-58</ref>; <ref loc="LUK 4:16-30">Luk. 4:16-30</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 6:1" />Ge'enaka de 'o Yesus de 'awi do-domoteke yoma'aiki ge'enaka, de yolio 'o Yesus 'awi soanika. <verse eid="MRK 6:1" /><verse number="2" style="v" sid="MRK 6:2" />Pomaoma-omasa ma Wangeka, 'una wokurue wodotoko 'o lo-lomu ma woaka, ge'enaka dau 'o nyawa manga gudaioka. Gee yo'isenoka 'o Yesus 'awi do-dotoko ge'ena, de yoherangi ma sala. 'Ona kayongosekau, &lt;&lt; 'O nyawa nu'una kiano womadamakeno ne'ena 'iodumu? 'Okia ma barija kone'ena ma rupa 'unaka ne'ena? Kokia so 'una 'idadi wodiai 'okia sonaa 'ihera-herangi? <figure style="fig" file="LB00244.tif" size="span" ref="(6:2)">'O Yahudioka manga lo-lomu ma woa ma dodaka</figure> <verse eid="MRK 6:2" /><verse number="3" style="v" sid="MRK 6:3" />Cedeke! 'Una ka 'o woa wodi-diai, 'o ngo Maria mi ngowaka, 'awi dodo-dodoto ge'ena 'o Yakobus, 'o Yoses, 'o Yudas de 'o Simon. De 'awi bira-biranga mita ne'enaka yogogere so pomasisoanuku.&gt;&gt; Ge'enau so 'ona kowiduakuwa.<verse eid="MRK 6:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 6:4" />Ge'enaka de 'o Yesus wongose 'onaka, &lt;&lt; 'O nabii moi ge'ena yakihoromati kiaka naga bato, duga nako ka 'o soana ma dodaku, de ka 'o 'esa moi, bolo ka 'o riaka dodoto, ge'ena koyakisingounuwa.&gt;&gt;<verse eid="MRK 6:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 6:5" />So ge'enaka dau 'o no-nako 'ihera-herangi ka moi ma kowodiaiwa, duga ka 'o nyawa yopa-panyake yamuruo naga 'awi giama wakidatami so manga panyake 'i'aiki. <verse eid="MRK 6:5" /><verse number="6a" style="v" sid="MRK 6:6a" />'Una woherangi 'ona koyongakuwa.<verse eid="MRK 6:6a" /></para>
  <para style="s">'O Yesus 'awi do-domoteke wakisuloko</para>
  <para style="r">(<ref loc="MAT 10:5-15">Mat. 10:5-15</ref>; <ref loc="LUK 9:1-6">Luk. 9:1-6</ref>)</para>
  <para style="p">
    <verse number="6b" style="v" sid="MRK 6:6b" />Ge'enaka de 'o Yesus wotagi 'o soana wanoi-noimi wodotoko. <verse eid="MRK 6:6b" /><verse number="7" style="v" sid="MRK 6:7" />'Una waki'asoko 'awi do-domoteke yamogiooko de modidi, wakisuloko yotagi yami-mididi, de wakikula 'o kuasa ma ngale 'o tokata yoginiiki. <verse eid="MRK 6:7" /><verse number="8" style="v" sid="MRK 6:8" />'Asa de wakisibesesongo 'onaka konee, &lt;&lt;Nia do-dagi ma sigoronaka, 'uwa nimadahoma bolo 'o pipi ma ngii nio'asa bolo 'o pipi, duga ka 'o papadi. <verse eid="MRK 6:8" /><verse number="9" style="v" sid="MRK 6:9" />Nia tarupa niomasinoade, ma nia baju duga ka nia roesoka.&gt;&gt; <verse eid="MRK 6:9" /><verse number="10" style="v" sid="MRK 6:10" />Deika wakisidemoli, &lt;&lt;Nako la nimasido-dogumika 'o woa moioka, ge'ena ge'enakau nimanoa sigado ma soana ge'ena niamada. <verse eid="MRK 6:10" /><verse number="11" style="v" sid="MRK 6:11" />Duga nako 'o ngii moioka niaika la konidawonguwa, de konisigisenuwa, ge'ena niamadaka ma ngii ge'ena. 'Asa de nia dou ma kakawo niodabarisuku ma ngale niakisingano-nganono 'onaka 'ato dua ma du'uruku 'o kianikia yamake ge'ena 'onau ma sirete yamoku.&gt;&gt;<verse eid="MRK 6:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 6:12" />Ge'enaka de 'o Yesus 'awi do-domoteke yamogiooko de modidi go'ona yotagi. 'Ona yotagi yosihabari 'ato, 'o nyawa 'iodumu salingou yotoba de yomatoduba la 'uwau 'o sowono yodiaioli. <verse eid="MRK 6:12" /><verse number="13" style="v" sid="MRK 6:13" />'O Yesus 'awi do-domoteke go'ona 'o tokata 'o gudai yoginiiki, de yopa-panyakeka gee 'o zaitun ma goooro yakisidausu so manga panyake 'i'aiki.<verse eid="MRK 6:13" /></para>
  <para style="s">'O Yohanes Wo'osi-'osiki wito'oma</para>
  <para style="r">(<ref loc="MAT 14:1-12">Mat. 14:1-12</ref>; <ref loc="LUK 9:7-9">Luk. 9:7-9</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 6:14" />'Okia naga 'idadi-dadiokau ge'ena 'iodumu ma Koana 'o Herodes mita wogi'isenokau, sababu 'o Yesus wi ronga ge'ena kiaka naga bato yakokinakokau. Naga munuka yongose bari, &lt;&lt; 'O Yohanes Wo'osi-'osiki womomikieu! Ge'enau so to 'una 'awi kuasa de ma 'ena wodiai 'o no-nako 'ihera-herangi.&gt;&gt;<verse eid="MRK 6:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 6:15" />Ma 'o nyawa 'iregu-regu yongose 'ato, &lt;&lt; 'Una ma Nabii Elia.&gt;&gt;</para>
  <para style="p" vid="MRK 6:15">Mita munuka yongose bari, &lt;&lt; 'Una 'o nabii moi 'isoka 'o nabii-nabii ma sirasi.&gt;&gt;<verse eid="MRK 6:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 6:16" />Gee 'o Herodes wo'isenoka ge'ena de kawongosekau, &lt;&lt;Ma raiokau 'una 'o Yohanes Wo'osi-'osiki gee ma sira tosuloko 'awi saeke ya'oguokau, ne'ena womomikieli!&gt;&gt;<verse eid="MRK 6:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 6:17" />Sababu ma goungu 'o Herodes wosulokokau 'o Yohanes witagoko de wisingosama 'o buika. 'O Herodes koge'ena wodiai sababu ngo Herodias 'o Filipus ma wekata womi'esenou. 'O Filipus ge'ena 'o Herodes wi dodoto ma dutu. <verse eid="MRK 6:17" /><verse number="18" style="v" sid="MRK 6:18" />De ma ngale ma hali ge'ena, 'o Yohanes wosidawanono 'o Herodesika wongose ato, &lt;&lt;Koidadiwa moni'ese 'ani moli gumuna!&gt;&gt;<verse eid="MRK 6:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 6:19" />Ge'enau so ngo Herodias mi singinaka momadonoaku 'o Yohanesika de momau mito'oma ma koidadiwasi sababu 'o Herodes wosikangelo. <verse eid="MRK 6:19" /><verse number="20" style="v" sid="MRK 6:20" />Ngano 'o Herodes wosulokokau 'o Yohanes wijaga yosidi-diai la 'uwa sigado wosongene 'o buioka, sababu 'una widomodongo 'o Yohanesika. 'Una wanakokau 'o Yohanes ge'ena 'o nyawa ma owa ma Jo'oungu ma Dutu wisingou-ngounu. De ma goungu nako 'o Yohanes wobicara, 'o Herodes woduaka mita wosigisene ngaro 'awi singina 'isusa ma.<verse eid="MRK 6:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 6:21" />Ma duanguku ngo Herodias 'o ngekomo momadamake ma 'orasi 'o Herodes 'awi wange ma gilio ya'adono. Ma 'orasi ge'ena 'o Herodes 'o rame wodiai ma ngale 'awi nyawa yola-laagomo de 'awi kapita de 'o Galileaka ma balu-balusu mita. <verse eid="MRK 6:21" /><verse number="22" style="v" sid="MRK 6:22" />Ma rameka ge'ena 'o ngo Herodias mi ngowaka 'o mosolese mimoi mowosangika de manga bionoko moroge-roge, de 'o Herodes de waki'aso-'asokino manga singina yadaene. So 'o Herodes kawongosekau munaka, &lt;&lt; 'O kianikia noduaka ge'ena kanoga'asoko bato, 'asa tonikula.&gt;&gt; <verse eid="MRK 6:22" /><verse number="23" style="v" sid="MRK 6:23" />Ge'enaka de 'o Herodes wojajiokau munaka sigado wosasi koneda, &lt;&lt; 'Okia naga bato noga'asoko dua 'asa tonikula, ngaro 'ai pareta de 'ai harataa ma songona ma katonikula!&gt;&gt;<verse eid="MRK 6:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 6:24" />So ma mosolese gumuna mosupu de mosano ma 'esaka, &lt;&lt; 'Eme ee! Yaowa 'okia toga'asoko?&gt;&gt; De ma 'esa mosango, &lt;&lt; 'O Yohanes Wo'osi-'osiki wi saeke.&gt;&gt;<verse eid="MRK 6:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 6:25" />Ge'enaka de 'o mosolese gumuna mosijai-jai mowosamokauoli de kamongosekau, &lt;&lt;Ngoi togaasoko ka kone'enasi nikulano 'o Yohanes Wo'osi-'osiki 'awi saeke 'o bobilanguoka 'isileotie!&gt;&gt;<verse eid="MRK 6:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 6:26" />'O Herodes wo'isenoka 'ami ga-ga'asoko ge'ena de 'awi singina 'isusa ma sala, ma koidadiwa wooluku, sababu 'awi nyawa-nyawa manga bionoka wosasiokau. <verse eid="MRK 6:26" /><verse number="27" style="v" sid="MRK 6:27" />Ge'enaka de wosuloko 'awi solodado wimoi wotagi 'o Yohanes wi saeke wa'ese. So ma rai 'o solodado gu'una wotagi 'o buika de 'o Yohanes wi saeke wa'ogu. <verse eid="MRK 6:27" /><verse number="28" style="v" sid="MRK 6:28" />Ge'enaka de 'o Yohanes wi saeke ge'ena wa'asa 'o bobilanguoka 'isileotie de wokula 'o mosolesika gumuna. 'Asa de munali mokula ma 'esaka. <verse eid="MRK 6:28" /><verse number="29" style="v" sid="MRK 6:29" />'O Yohanes wi do-domoteke yogi'isenoka ge'ena, de yaika ya'ese ma Yohanes wi songene so yapoosuku.<verse eid="MRK 6:29" /></para>
  <para style="s">'O Yesus wakisi'odomo 'o nyawa yacaana motoaka</para>
  <para style="r">(<ref loc="MAT 14:13-21">Mat. 14:13-21</ref>; <ref loc="LUK 9:10-17">Luk. 9:10-17</ref>; <ref loc="JHN 6:1-14">Yoh. 6:1-14</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 6:30" />'O Yesus wi su-suloko gee wakisulo-suloko yolionoli, ge'enaka de yomalomuoli de 'o Yesus. 'Ona yositotara 'unaka 'okia naga 'iodumu gee yadiaiokau de yosidotokokau. <verse eid="MRK 6:30" /><verse number="31" style="v" sid="MRK 6:31" />De 'una kawongosekau 'onaka, &lt;&lt;Nou! 'O ngii 'irii-riidika potagi pomatingaikasi la 'idadi pomaomasosi ma eta.&gt;&gt; Koge'ena wongose sababu 'o nyawa manga gudai yoboa de yolio kayomakatagali, sigado kayo'odomo ma koidadiwa. <verse eid="MRK 6:31" /><verse number="32" style="v" sid="MRK 6:32" />So 'ona yotagi yongo'otiri yosikaika 'o ngii 'irii-riidika.<verse eid="MRK 6:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 6:33" />Ma 'o kawasa manga gudai yakimakekau yotagi de yakinako, so 'o soa-soanoka ge'ena ma daeraaka gee 'o nyawa manga gudai yakiniiki yoowa-owara yomatisira. <verse eid="MRK 6:33" /><verse number="34" style="v" sid="MRK 6:34" />Gee 'o Yesus wo'uti 'o ngo'otiroka, de wakimake 'o nyawa yoku-kudai go'ona. 'Una wakidora sababu 'ona 'isoka 'o dombau gee komoiwau yasowohi. So 'una wokurue wakisidotoko 'okia sonaa 'o gudai. <verse eid="MRK 6:34" /><verse number="35" style="v" sid="MRK 6:35" />Ma wange 'i'aloku de 'awi do-domoteke kayongosekau 'unaka, &lt;&lt; 'Iobirou de 'o ngii ne'ena 'itingakino 'irii-riidoka. <verse eid="MRK 6:35" /><verse number="36" style="v" sid="MRK 6:36" />So yaowa, 'Aba, nakisuloko yoku-kudai go'ona yoliou la 'idadi 'o 'inomo yomadi'ija 'o soa-soanika ne'ena ma date-dateoka.&gt;&gt;<verse eid="MRK 6:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 6:37" />Ma 'o Yesus wosango, &lt;&lt;Ka nginiou niakisi'odomo.&gt;&gt;</para>
  <para style="p" vid="MRK 6:37">De 'awi do-domoteke go'ona kayongosekau, &lt;&lt; 'Etei 'ato ngomi salingou miotagi 'o roti mio'ija ma pipi 'o saaka 'o ratusu modidi ma ngale miakisi'odomo 'o nyawa-nyawa no'ona?&gt;&gt;<verse eid="MRK 6:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 6:38" />Ge'enaka de 'o Yesus wosano, &lt;&lt;Nia roti 'o ngai muruoka naga? Bika nialega!&gt;&gt;</para>
  <para style="p" vid="MRK 6:38">Yalegaka de yosidemo, &lt;&lt; 'O ngai motoaka, de 'o naoko 'o ngai modidioka mita.&gt;&gt;<verse eid="MRK 6:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 6:39" />Ge'enaka de wosuloko go'ona manga gudai gee 'o jela-jelaka yogogeruku 'o bolu yamo-moi. <verse eid="MRK 6:39" /><verse number="40" style="v" sid="MRK 6:40" />So 'o nyawa-nyawa go'ona yogogere yomasi'atu-'aturu 'o bolu-bolu muruoka naga. Munuka 'o bolu moi yaratusu moioka, munuka yanagi motoaka. <verse eid="MRK 6:40" /><verse number="41" style="v" sid="MRK 6:41" />Ge'enaka de 'o roti de ma naoko ge'ena wa'eseno, de womatagade 'o diwangie de wongose 'ato, &lt;&lt; 'Alele! 'O 'inomo nokulakau ngomino!&gt;&gt; Ge'enaka de ma roti waeta-eta de wi giama, 'asa de wokula 'awi do-domoteika la yosibula-bula 'o nyawa yoku-kudaika. De ma naoko 'o ngai modidi mita yakisibula-bula yoodumika. <verse eid="MRK 6:41" /><verse number="42" style="v" sid="MRK 6:42" />So ge'enaka dau yo'odomo sigado yosibunu-bunusu. <verse eid="MRK 6:42" /><verse number="43" style="v" sid="MRK 6:43" />'Iduangino de ma baili 'o do-domoteke yapoluno 'ena 'o pa'udi mogiooko de modidioka. <verse eid="MRK 6:43" /><verse number="44" style="v" sid="MRK 6:44" />Ge'enaka dau yo'odomo ka 'o nau-naurosi 'ena yacaana motoakau. 'Ena 'o ngeweka de 'o ngowa-ngowaka koyakidoimuwasi.<verse eid="MRK 6:44" /></para>
  <para style="s">'O Yesus 'o 'akere ma dekuoko wotagi-tagi</para>
  <para style="r">(<ref loc="MAT 14:22-33">Mat. 14:22-33</ref>; <ref loc="JHN 6:16-21">Yoh. 6:16-21</ref>)</para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 6:45" />Ge'ena 'iduanga de 'o Yesus wakisuloko 'awi do-domoteika yoparene 'o ngo'otiruku la yosirau doka 'o talaga ma songonaka 'o Betsaidaka. 'Ena 'o nyawa yoku-kudai go'ona ma wakisuloko yoliou. <verse eid="MRK 6:45" /><verse number="46" style="v" sid="MRK 6:46" />Gee yoku-kudai wakisuloko yolioka 'una wosau daku 'o gigie ma dekude, ge'enaka de wolahidoa ma Deade. <verse eid="MRK 6:46" /><verse number="47" style="v" sid="MRK 6:47" />'Iobirukou so 'o Yesus 'awi do-domoteke 'o talaga ma goronakau yaika 'ena 'o Yesus ka 'o dudungokasi. <verse eid="MRK 6:47" /><verse number="48" style="v" sid="MRK 6:48" />'Una wakimakeku yokangelakou yooru sababu 'o dadoko yakitomo. So 'isorika 'ibibini de wakisidu'uru ma kawotagi-tagi 'o 'akere ma dekuoko de kawogila-gila 'isoka wakipasau. <verse eid="MRK 6:48" /><verse number="49" style="v" sid="MRK 6:49" />Gee 'ona wimake 'una wotagi-tagi 'o 'akere ma dekuoko, de 'ona yongose ka 'o tokata, <verse eid="MRK 6:49" /><verse number="50" style="v" sid="MRK 6:50" />so 'ona yokoya sababu yakimodongo. Ngano 'ona yoodumu wimake so yakitodokana ma sala.</para>
  <para style="p" vid="MRK 6:50">Ge'enaka de 'o Yesus kawongosekau, &lt;&lt;Niomarii-riidi! Ka ngoi, so 'uwa nimodongo!&gt;&gt; <verse eid="MRK 6:50" /><verse number="51" style="v" sid="MRK 6:51" />Ge'enaka de 'una woparenokau to 'ona manga ngo'otirie, de ma dadoko ma 'iriidokau. 'O Yesus 'awi do-domoteke yoherangi ma sala. <verse eid="MRK 6:51" /><verse number="52" style="v" sid="MRK 6:52" />'O no-nako 'ihera-herangi 'o roti ngai motoa 'idadi-dadiokau gee, 'ona koyasahewasi mita. 'Ona ge'ena manga singina 'i'opini so 'isusa yasahe.<verse eid="MRK 6:52" /></para>
  <para style="s">'O Yesus wakisi'aiki 'o nyawa yopa-panyake 'o Genesaretioka</para>
  <para style="r">(<ref loc="MAT 14:34-36">Mat. 14:34-36</ref>)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 6:53" />Gee yototarika doka 'o talaga ma songonaka 'o Genesaret ma dowongioka, <verse eid="MRK 6:53" /><verse number="54" style="v" sid="MRK 6:54" />de 'asa kayo'uti 'o ngo'otiroka, 'ena 'o nyawa yanakokau 'ato 'o Yesus woboa. <verse eid="MRK 6:54" /><verse number="55" style="v" sid="MRK 6:55" />De yoowa-owara yosikademo kiaka naga bato ge'ena ma daeraaka, so ma rai yopa-panyake manga gudai de manga kokowaka yakisida-da'asa 'o Yesus wisinonu kiaka naga bato waika. <verse eid="MRK 6:55" /><verse number="56" style="v" sid="MRK 6:56" />Kiaka naga bato 'o liunu de 'o soana de 'o kota wanga-ngaimoi de yopa-panyake yakinoaku 'o nyawa yomalomu-lomu ma ngii ma dateoka. De yoga'asoko 'iti ka wi baju ma barenika ngaro ma yatigiosi la manga panyake 'i'aiki. Nago'ona la yatigiokau ge'ena, ma rai 'i'aiokau.<verse eid="MRK 6:56" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 6" />
  <chapter number="7" style="c" sid="MRK 7" />
  <para style="s">'O edete de 'o dotumu manga 'adati</para>
  <para style="r">(<ref loc="MAT 15:1-9">Mat. 15:1-9</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 7:1" />'O Farisioka 'o bolu moi de 'o 'agamaka yodoto-dotoko yamuruo naga 'o Yerusalemino, yaino 'o Yesusino. <verse eid="MRK 7:1" /><verse number="2" style="v" sid="MRK 7:2" />'Ona yakimake 'o Yesus wi do-domoteke yamuruo naga manga giama koya'isokuwa de kayo'odomou. 'Ena moteke 'o 'agama ma 'atorangi, salingou 'isira nanga giama pa'isokokasi.<verse eid="MRK 7:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 7:3" />'O Farisioka de mita 'o Yahudioka yoodumu, yamoteke ma gou-goungu manga edete de manga dotumu manga 'adati. 'Ona yooluku yo'odomo nako manga giama koya'isokuawasi moteke kokia naga 'isitatapuokau. <verse eid="MRK 7:3" /><verse number="4" style="v" sid="MRK 7:4" />'O kianikia gee yo'ijano 'o pasarioka, nako koya'isokuwasi ge'ena koya'odomuwa. De 'o 'atorangi 'iregu 'o gudaiosi yaga-gaono gee manga edete de manga dotumoka, 'isoka manga galasi de manga sawoko yo'isoko ma 'atorangi, de mita manga kia sonaa gee 'o tambaga.<verse eid="MRK 7:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 7:5" />Ge'enau so 'o Farisioka de 'o 'agamaka yodoto-dotoko go'ona yosano 'o Yesusika, &lt;&lt; 'Ido'oa so 'ani do-domoteke 'ona manga giama koya'isokuawau de kayo'odomou? 'Okia ma sababu so 'ona yooluku yamoteke to ngone nanga dotumu de 'o edete manga 'adati?&gt;&gt;<verse eid="MRK 7:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 7:6" />De 'una kawakisangokau, &lt;&lt;Ngini nioelu-eluku! Posironga yadaenoka 'o Yesaya wosidemosirakau ma ngale ngini ge'ena la:</para>
  <para style="q1" vid="MRK 7:6">&lt;Koneda ma Jo'oungu ma Dutu wongose:</para>
  <para style="q1" vid="MRK 7:6">'O nyawa-nyawa no'ona 'isuba ngoino duga ka manga 'uru ma kaioka,</para>
  <para style="q2" vid="MRK 7:6">ma manga singina 'ikurutu ngoioka.<verse eid="MRK 7:6" /></para>
  <para style="q1">
    <verse number="7" style="v" sid="MRK 7:7" />Ma faedaa koi'iwa 'ona yosuba ngoino,</para>
  <para style="q2" vid="MRK 7:7">sababu 'ona yosidotoko ka 'o nyawa ma 'atorangi</para>
  <para style="q2" vid="MRK 7:7">de yadiai 'isoka to ngoi 'ai 'atorangi!&gt;<verse eid="MRK 7:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 7:8" />Ma Jo'oungu ma Dutu 'awi pareta koniosigisenuwa, so niaga-gao ka 'o nyawa ma 'atorangi.&gt;&gt;<verse eid="MRK 7:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 7:9" />Ge'enaka de 'o Yesus kawongosekau, &lt;&lt;Ma goungu niobarija ma sala niaitomo ma Jo'oungu ma Dutu wi besesongo, la niosikuata ka to ngini ma sirete nia do-dotoko. <verse eid="MRK 7:9" /><verse number="10" style="v" sid="MRK 7:10" />'O Musa wokulakau 'o besesongo naneda: &lt;Niakihoromati nia dea de nia 'esa de nago'ona yakisibobeto manga dea de manga 'esaka, salingou yakihukumu yakiso-songene.&gt; <verse eid="MRK 7:10" /><verse number="11" style="v" sid="MRK 7:11" />Ma ngini niosidotoko 'ato kaidadi 'o nyawa manga balusika yongose, &lt; 'Okia naga gee salingou tinikula ma ngale tinileleani, tosisubakau ma Jo'oungu ma Dutuka.&gt; <verse eid="MRK 7:11" /><verse number="12" style="v" sid="MRK 7:12" />So ngini niakisidabi 'o nyawa koyakikalesanguwa manga balusika. <verse eid="MRK 7:12" /><verse number="13" style="v" sid="MRK 7:13" />So de to ngini ma sirete nia do-dotoko gee niosidoto-dotoko 'o nyawaka, ngini niaisanga ma Jo'oungu ma Dutu 'awi demo. De 'o gudaiosi niadiai 'isoka koge'ena.&gt;&gt;<verse eid="MRK 7:13" /></para>
  <para style="s">'Okia sonaa gee 'o nyawa yakisimediri</para>
  <para style="r">(<ref loc="MAT 15:10-20">Mat. 15:10-20</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 7:14" />Ge'enaka de 'o Yesus wakitoomuoli 'o nyawa yoku-kudai go'ona de wakidongose 'onaka, &lt;&lt;Niosigisene la niasahe! <verse eid="MRK 7:14" /><verse number="15" style="v" sid="MRK 7:15" />Koi'iwa 'o kianikia moi gee 'iwosanga 'o nyawa manga dodaku de yakisimediri. Ma 'ena gee 'isupu 'o nyawaka, ge'enau yakisimediri ma Jo'oungu ma Dutu wi bionoka. [<verse eid="MRK 7:15" /><verse number="16" style="v" sid="MRK 7:16" />So ngini de nia ngaukoka so tanu nio'isenika.]&gt;&gt;<verse eid="MRK 7:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 7:17" />Gee 'o Yesus wakimada 'o nyawa yoku-kudai go'ona so wowosanga 'o woaka de wi do-domoteke yosano, &lt;&lt; 'O 'ade-'ade ge'ena ma ngale 'okia?&gt;&gt; <verse eid="MRK 7:17" /><verse number="18" style="v" sid="MRK 7:18" />Ge'enaka de wosango kawongosekau 'onaka, &lt;&lt;So ngini ma koniasahewasi? Konianakowa 'ato 'okia naga po'odomo ge'ena koinasimediruwa? <verse eid="MRK 7:18" /><verse number="19" style="v" sid="MRK 7:19" />Sababu ge'ena ko 'o singinakuwa, 'ena ka 'o pokoruku so kaisupuokali.&gt;&gt; De 'o Yesus 'awi demo-demo ge'ena, 'isinyata 'ato 'o 'inomo 'iodumu kaidadi pa'odomo.<verse eid="MRK 7:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 7:20" />Ge'enaka de 'o Yesus kawongosekauoli, &lt;&lt;Gee 'isupu 'o nyawa manga singinano, ge'enau yakisimediri. <verse eid="MRK 7:20" /><verse number="21" style="v" sid="MRK 7:21" />Sababu 'o singinanou ge'ena 'ibaoro 'o di-dibangi 'ito-torou gee ma duanguku yomakapake kaitimaronga, yotosiki de yoto'oma, <verse eid="MRK 7:21" /><verse number="22" style="v" sid="MRK 7:22" />yosongou, yosikahaga, yosigurubungu, de yadiai 'okia sonaa moi-moi 'ito-torou, yomadengo-dengoka, yopakisani, yotaleana, yomaie, de 'isusa yakidotoko. <verse eid="MRK 7:22" /><verse number="23" style="v" sid="MRK 7:23" />'Iodumu 'ito-torou gee 'ibaoro 'o singinano, de ge'enau 'o nyawa yakisimediri.&gt;&gt;<verse eid="MRK 7:23" /></para>
  <para style="s">'O ngeweka mimoi 'ami ngo-ngaku</para>
  <para style="r">(<ref loc="MAT 15:21-28">Mat. 15:21-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 7:24" />Ge'enaka de 'o Yesus woma'aiki ge'enaka dau, de wosikaoko 'o Tirus ma kota ma dateoko. 'O woa moioka womasido-dogumika ma womau 'o nyawa yoku-kudai 'uwa yanako, 'ena kayanakoka 'ato naga woboano. <verse eid="MRK 7:24" /><verse number="25" style="v" sid="MRK 7:25" />So mimoi gee 'ami ngowaka 'o tokata yodo-dongosamuku migi'isenoka 'o Yesus, de maika 'o Yesusika de mosubaku 'awi bionoka, <verse eid="MRK 7:25" /><verse number="26" style="v" sid="MRK 7:26" />de moga'asoko la 'o Yesus woginiiki 'o tokata gee 'ami ngowakoka. 'O ngeweka gumuna ko 'o Yahudiokawa, muna molahiri 'o Fenisia ma daeraaka 'o Siriaka. <verse eid="MRK 7:26" /><verse number="27" style="v" sid="MRK 7:27" />Ge'enaka de 'o Yesus kawomicaguluokau, &lt;&lt;Madakau ngaro, la ka 'o ngowa-ngowakosi yo'odomo, sababu koyadaenuwa 'o ngowaka manga 'inomo de ka 'o kaso positowoka.&gt;&gt;<verse eid="MRK 7:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 7:28" />'O ngeweka gumuna mosango, &lt;&lt;Ma goungu 'Aba, ma 'o kaso 'o meja ma timioka mita ya'odomo 'o ngowa-ngowaka manga 'inomo ma dota-dotaka!&gt;&gt;<verse eid="MRK 7:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 7:29" />Ge'enaka de 'o Yesus wongose munaka, &lt;&lt;Sababu 'ani sa-sango ge'ena, kanoliou ngaro, 'o tokata ge'ena 'imagoraokau 'ani ngowakoka!&gt;&gt;<verse eid="MRK 7:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 7:30" />So 'o ngeweka gumuna molio de mi woaka maika 'ena 'ami ngowaka gumuna moma'iduokau 'o dangiroka, de ma tokata ma 'isupuokau munaka.<verse eid="MRK 7:30" /></para>
  <para style="s">'O nyawa wimoi wito-topongono de womou-mou 'o Yesus wisilaha</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 7:31" />Ge'enaka de 'o Yesus womagoraka 'o Tirusoka de wosikaie 'o Galilea ma talagade waboa 'o Sidonie. 'Una watoaka 'o Kota Mogiooko ma daeraade. <verse eid="MRK 7:31" /><verse number="32" style="v" sid="MRK 7:32" />Ge'enaka dau 'o nyawa wimoi wito-topongono de womou-mou wi'asano 'o Yesusoka. De yo'ota-'otaka go'ona yoga'asoko la 'o Yesus wi giama widatamiosi womou-mouku gu'una. <verse eid="MRK 7:32" /><verse number="33" style="v" sid="MRK 7:33" />So ma rai 'o nyawa gu'una 'o Yesus wisitingaika 'o nyawa yoku-kudaioka de wi ngauku ngai modidi ma sukonoka wi ra-raga wosisumuka 'asa de wakibiti, deika 'awi nga-ngaemikali wa'ao. <verse eid="MRK 7:33" /><verse number="34" style="v" sid="MRK 7:34" />Ge'enaka de 'o Yesus womatagadesi de woomasa watoomude 'asa deika kawongosekau 'unaka, &lt;&lt;Efata!&gt;&gt; ma ngale, &lt;&lt; 'Ipelenga!&gt;&gt;<verse eid="MRK 7:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 7:35" />Kage'ena de womasi'isenokau de wi demo-demo mita 'i'osakinokau, 'awi nga-ngaeme 'ipalitangokau so. <verse eid="MRK 7:35" /><verse number="36" style="v" sid="MRK 7:36" />Ge'enaka de 'o Yesus kowakisidabiwa 'ona yoodumu yosijarita nago'onaka naga bato. Ma gee de wotawanono monga, de kayodofoloi monga yosikajarita. <verse eid="MRK 7:36" /><verse number="37" style="v" sid="MRK 7:37" />De yoodumu yo'ise-'isene go'ona yoherangi ma sala. Sigado kayongosekau, &lt;&lt; 'Etei! 'Okia sonaa 'iodumu wodiai de kaisureli so! Yakito-topongono ma 'idadi yomasi'isene, de yomou-mou ma 'idadi yobicara!&gt;&gt;<verse eid="MRK 7:37" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 7" />
  <chapter number="8" style="c" sid="MRK 8" />
  <para style="s">'O Yesus wakisi'odomo 'o nyawa yacaana soatoka</para>
  <para style="r">(<ref loc="MAT 15:32-39">Mat. 15:32-39</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 8:1" />Ge'ena 'ipasa koito'ingowa de 'o nyawa 'o bolu moi manga gudai yaino yomalomunoli 'o Yesusoka. Ma to 'ona manga 'inomo koi'iwau so 'o Yesus 'awi do-domoteke waki'asoko de wongose, <verse eid="MRK 8:1" /><verse number="2" style="v" sid="MRK 8:2" />&lt;&lt;Sioko! Ngoi takisingina 'o nyawa manga gudai ne'ena, sababu 'ona 'o wange sa'angeu de de ngoi, de ne'ena to 'ona manga 'inomo koi'iwau. <verse eid="MRK 8:2" /><verse number="3" style="v" sid="MRK 8:3" />Nako ngoi takisuloko 'ona yolio de manga sawinoka, dua 'o ngekomo ma soaka naga de kayopusa. 'Ifoloiosi naga munuka gee ma gurutoka yaino.&gt;&gt;<verse eid="MRK 8:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 8:4" />Ma 'o Yesus 'awi do-domoteke yosango, &lt;&lt; 'Aba, 'o ngii ne'ena 'imatinga-tingakino, de 'o 'inomo kiano pamake la 'o nyawa 'iodumu ne'ena pakisi'odomo sigado yakipunusu?&gt;&gt;<verse eid="MRK 8:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 8:5" />De 'o Yesus wosano 'onaka, &lt;&lt;Naga nia roti 'o ngai muruoka?&gt;&gt;</para>
  <para style="p" vid="MRK 8:5">De 'awi do-domoteke yosango, &lt;&lt;Ngai tumudiingoka.&gt;&gt;<verse eid="MRK 8:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 8:6" />Ge'enaka de 'o Yesus wosuloko 'o nyawa yoku-kudai go'ona, yoodumu 'o tonaoka yogogeruku. Yogogeruku de 'o roti ngai tumudiingi ge'ena wa'ese so wi 'amalaha wositedene ma Jo'oungu ma Dutude. Ge'enaka de ma roti ge'ena waeta-eta de wi giama, deika wokula 'awi do-domoteika ma ngale yosibula-bula 'o nyawa-nyawaka. So 'awi do-domoteke yosibula-bula. <verse eid="MRK 8:6" /><verse number="7" style="v" sid="MRK 8:7" />To 'ona manga naoko ma di-dingoono 'o ngai muruoka naga mita. 'O Yesus wosi'amalahakasi ma Jo'oungu ma Dutude ma naoko ge'ena, deika wosuloko 'awi do-domoteke yosibula-bula. <verse eid="MRK 8:7" /><verse number="8-9" style="v" sid="MRK 8:8-9" />So 'ona yo'odomo yosibunu-bunusu, poilia yacaana soatoka. Ge'enaka de 'o Yesus wi do-domoteke yatoomuno ma 'inomo ma baili ge'ena 'o pa'udi tumudiingokasi. Ge'enaka de 'o nyawa yoku-kudai go'ona wakisuloko 'ato ngaro yokokilio. <verse eid="MRK 8:8-9" /><verse number="10" style="v" sid="MRK 8:10" />De 'una de 'awi do-domoteke ma ka 'o ngo'otiruku yoparene de yotagiokau 'o Dalmanuta ma tonaika.<verse eid="MRK 8:10" /></para>
  <para style="s">'O Farisioka yoga'asoko 'o Yesus wodiai 'o no-nako 'ihera-herangi</para>
  <para style="r">(<ref loc="MAT 16:1-4">Mat. 16:1-4</ref>)</para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 8:11" />'O Dalmanuta ma tonaoka yototarika de 'o Farisioka yamuruo naga yaino 'o Yesusino de yomakasango sababu yomau wisiotaka. 'Ona yoga'asoko 'o no-nako 'ila-laagomo wodiai la 'isidumutu 'ato 'una ge'ena ma Jo'oungu ma Dutuno. <verse eid="MRK 8:11" /><verse number="12" style="v" sid="MRK 8:12" />'O Yesus wotaianoka de wosango, &lt;&lt;Tei! Ngini ma du'urude ne'ena kaitaurika niosuloko 'o no-nako 'ihera-herangi tosidumutu. Ma tooluku tinisidumutu!&gt;&gt;<verse eid="MRK 8:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 8:13" />Ge'enaka de 'o Yesus wakimadakau 'ona de woparenokau 'o ngo'otiruku so 'una de 'awi do-domoteke yomasingo'otirokau ge'ena ma talaga ma songonaka doka.<verse eid="MRK 8:13" /></para>
  <para style="s">'O 'ade-'ade 'o ragi gee 'o Yesus 'awi do-domoteke koyasahewasi</para>
  <para style="r">(<ref loc="MAT 16:5-12">Mat. 16:5-12</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 8:14" />'O Yesus 'awi do-domoteke yamongoroka 'o roti yo'asa sigado yakidugaka. To 'ona manga roti 'o ngo'otiroka duga ka 'o ngai moioka. <verse eid="MRK 8:14" /><verse number="15" style="v" sid="MRK 8:15" />'O Yesus wongose 'onaka, &lt;&lt;Nimasitiari 'o Farisioka de 'o Herodes manga ragika.&gt;&gt;<verse eid="MRK 8:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 8:16" />So ge'enaka de 'o Yesus 'awi do-domoteke yomasikademo-demo yongose 'ato, &lt;&lt; 'Una koge'ena wongose sababu to ngone nanga roti koi'iwa.&gt;&gt;<verse eid="MRK 8:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 8:17" />'O Yesus wanako 'okia 'ona yatiba-tibangi. Sababu ge'ena 'una kawongosekau 'onaka, &lt;&lt;Tei, 'ido'oa so ngini niatiba-tibangi ka nia roti koi'iwa? Ngini mita konianakowasi? De koniasahewasi? Nia di-dibangi koge'enau ma be'etoro? <verse eid="MRK 8:17" /><verse number="18" style="v" sid="MRK 8:18" />To ngini de nia akoka de 'ido'oa so koniamakewa? De to ngini de nia ngaukoka de 'ido'oa so konio'isenuwa? <verse eid="MRK 8:18" /><verse number="19" style="v" sid="MRK 8:19" />Niamongorokau? 'o roti ngai motoa gee takide-deetaku 'o nyawa yacaana motoa? De ngini ma sirete niatoomu ma baili 'o pa'udi muruoka?&gt;&gt;</para>
  <para style="p" vid="MRK 8:19">De 'ona yosango, &lt;&lt; 'O pa'udi mogiooko de modidioka.&gt;&gt;<verse eid="MRK 8:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 8:20" />&lt;&lt;De mita gee 'o roti 'o ngai tumudiingi taeta-etaku, takisi'odomo 'o nyawa yacaana soatoka. Ge'ena ngini niatoomuno ma baili 'o pa'udi muruoka?&gt;&gt;</para>
  <para style="p" vid="MRK 8:20">De 'ona yosango, &lt;&lt; 'O pa'udi tumudiingoka.&gt;&gt;<verse eid="MRK 8:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 8:21" />De wongoseli, &lt;&lt;Ngini koniosahewasi mita?&gt;&gt;<verse eid="MRK 8:21" /></para>
  <para style="s">'O Yesus wosi'aiki worau-rau wimoi 'o Betsaidaka</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 8:22" />'O Yesus de 'awi do-domoteke ya'adonika 'o Betsaidaka, de wopilo-piloko wimoi 'o nyawa wituda 'o Yesusino, de yoga'asoko wi'aosi worau-rau gu'una la wisi'aiki. <verse eid="MRK 8:22" /><verse number="23" style="v" sid="MRK 8:23" />So 'o Yesus wa'ao worau-rau wi giamika de wituda ge'ena ma kota ma dudunika wisisupu. Ge'enaka de 'o Yesus wakibiti worau-rau gu'una wi akoka, 'asa de wa'aoka de wosano 'unaka, &lt;&lt;Ne'ena namakekau 'o kianikia?&gt;&gt;<verse eid="MRK 8:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 8:24" />'O nyawa gu'una womalega 'awi daarika de kawongosekau, &lt;&lt;Ia, takimake 'o nyawa yokakadagi, ma takimakeka 'isoka 'o gota de ma utu-utuoka!&gt;&gt;<verse eid="MRK 8:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 8:25" />Ge'enaka de 'o Yesus wa'aoli 'o nyawa gu'una 'awi akoka. Ne'ena ma moi 'o nyawa gu'una wosigou-goungu womalega-lega womau womasimake 'itiai. Ge'enaka de koworauwau. So 'o sagala moi-moi wamake 'iwaitokau. <verse eid="MRK 8:25" /><verse number="26" style="v" sid="MRK 8:26" />Ge'enaka de 'o Yesus wosuloko 'unaka, &lt;&lt;Tagi noliou! Ma 'uwau naboa ma kotaka ge'ena.&gt;&gt;<verse eid="MRK 8:26" /></para>
  <para style="s">'O Petrus wongaku 'ato 'o Yesus 'una ge'ena 'o Koana ma Jo'oungu ma Dutu wosijajiokau</para>
  <para style="r">(<ref loc="MAT 16:13-20">Mat. 16:13-20</ref>; <ref loc="LUK 9:18-21">Luk. 9:18-21</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 8:27" />'O Yesus de 'awi do-domoteke yotagi 'o soa-soanika 'o Kaisarea Filipi ma date-dateoka. Naga manga do-dagi ma sigoronaka de wakisano, &lt;&lt;Moteke 'o nyawa yongose, ngoi ne'ena nagu'una?&gt;&gt;<verse eid="MRK 8:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 8:28" />'Ona yosango, &lt;&lt;Munuka yongose 'ato 'o Yohanes Wo'osi-'osiki; munuka yongose 'o Elia, 'o nabii ma sirasi; 'asa de munukali yongose 'o nabii wimoi.&gt;&gt;<verse eid="MRK 8:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 8:29" />Ge'enaka de wosanoli 'onaka, &lt;&lt;Ma nako ngini ma sirete, ngoi ne'ena nagu'una?&gt;&gt;</para>
  <para style="p" vid="MRK 8:29">'O Petrus wosango, &lt;&lt; 'Aba! Ngona ge'ena 'o Koana 'o Nyawa Nosilaha-laha gee ma Jo'oungu ma Dutu Woniiri-iriki!&gt;&gt;<verse eid="MRK 8:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 8:30" />Ge'enaka de wakisitiari 'onaka, &lt;&lt;Nako de, ka 'o nyawa moika ma 'uwasi niosikademo.&gt;&gt;<verse eid="MRK 8:30" /></para>
  <para style="s">'O Yesus wosidemo 'ato dua wosangisara de wosongene</para>
  <para style="r">(<ref loc="MAT 16:21-28">Mat. 16:21-28</ref>; <ref loc="LUK 9:22-27">Luk. 9:22-27</ref>)</para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 8:31" />Ge'enaka de 'o Yesus wokurue wakidongose 'awi do-domoteika, &lt;&lt;Ngoi 'o Nyawa ma Ngowaka dua ma gudai tosangisara, de dua 'o Yahudioka ma balu-balusu, 'o 'imam-'imam ma saeke de 'o 'agamaka yodoto-dotoko 'iitomo. Dua 'ito'oma, ma 'o wange sa'angeka de tomomikokali.&gt;&gt; <verse eid="MRK 8:31" /><verse number="32" style="v" sid="MRK 8:32" />Ma hali ge'ena wosidemo wositi-tiaika 'awi do-domoteika. So 'o Petrus 'o Yesus witobakino wi gagaroka de wotawanono 'unaka. <verse eid="MRK 8:32" /><verse number="33" style="v" sid="MRK 8:33" />Ma 'o Yesus womalega wi do-domoteika, de wotawanono 'o Petrusika, &lt;&lt;Ee, ngona matero ka 'o Tokata ma Koana gee de! Noma'aikika ne'enaka! Sababu 'ani di-dibangi ge'ena ka 'o nyawa ma di-dibangi; ko to ma Jo'oungu ma Dutuwa!&gt;&gt;<verse eid="MRK 8:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 8:34" />Deika 'o Yesus waki'asoko 'o nyawa yoku-kudai de mita 'awi do-domoteke, de wakisidemo wongose 'ato, &lt;&lt;Nago'ona yomau 'imoteke ngoi, salingou 'uwa yamoteke ka to 'ona ma sirete manga mau, de salingou yamoku 'o salip<note caller="e" style="f"><char style="fr" closed="false">8:34: </char><char style="ft" closed="false">Ma ngale: yotahani yosangisara.</char></note> de tatapu yomoteke de de ngoi. <verse eid="MRK 8:34" /><verse number="35" style="v" sid="MRK 8:35" />Sababu 'o nyawa gee yo'ahu ka de 'o dunia ma sanangi de yooluku yamada, dua 'ona manga 'ahu 'ika-kakali 'iisanga. Ma 'o nyawa gee yamada yo'ahu ka de 'o dunia ma sanangi sababu yomoteke ngoi de 'o Habari ma Owa ma Jo'oungu ma Dutuno, 'asa yamake 'o 'ahu 'ika-kakali. <verse eid="MRK 8:35" /><verse number="36" style="v" sid="MRK 8:36" />'Okia ma faedaa, nako wimoi 'o dunia de ma doda 'iodumu ne'ena ka to 'una ma 'awi 'ahu 'ika-kakali 'iisanga? <verse eid="MRK 8:36" /><verse number="37" style="v" sid="MRK 8:37" />Kaidadi 'o 'ahu ge'ena positagali de 'o kianikia?<verse eid="MRK 8:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 8:38" />Nago'ona yakimaeke yongose 'ato 'ona ge'ena 'ingaku-ngaku ngoi de 'ai do-dotoika ma 'orasi 'o nyawa 'o dorou yodi-diai manga sigoronaka ne'ena, ngoi 'o Nyawa ma Ngowaka mita 'asa tongose 'onaka 'ato, &lt;Ngoi kotininakowa&gt;, gee dua ma 'orasi dua toboa de 'ai Dea 'awi kuasa 'imoteke 'o mala'ekati 'itebi-tebini 'o gudai.&gt;&gt;<verse eid="MRK 8:38" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 8" />
  <chapter number="9" style="c" sid="MRK 9" />
  <para style="p">
    <verse number="1" style="v" sid="MRK 9:1" />'O Yesus wongose, &lt;&lt;Niosi-singina! Naga nginioka ne'ena, dua de ma 'ena koyosongenuwa nako koyamakewasi ma Jo'oungu ma Dutu wopareta de wi kuasa!&gt;&gt;<verse eid="MRK 9:1" /></para>
  <para style="s">'O Yesus 'awi jako 'ingali</para>
  <para style="r">(<ref loc="MAT 17:1-13">Mat. 17:1-13</ref>; <ref loc="LUK 9:28-36">Luk. 9:28-36</ref>)</para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 9:2" />'O wange butanga de 'o Yesus waki'asa 'o Petrus de 'o Yakobus de 'awi dodoto 'o Yohanes, yotagi ka 'ona 'o gigie moi 'ikuru-kurutieka. To 'ona manga bionoka de 'o Yesus 'awi jako 'ingali. <verse eid="MRK 9:2" /><verse number="3" style="v" sid="MRK 9:3" />'Awi baju 'imadadi 'i'arese daungie 'iletongo. Yoma'uju-'uju 'o duniaka ne'ena komoiwa moi 'idadi yoma'uju 'isoka koge'ena ma garese. <verse eid="MRK 9:3" /><verse number="4" style="v" sid="MRK 9:4" />Ge'enaka de 'awi do-domoteke yaruange go'ona yakimake 'o Yesus de 'o Elia de 'o Musa yomabi-bicara. <verse eid="MRK 9:4" /><verse number="5" style="v" sid="MRK 9:5" />So 'o Petrus kawongosekau 'o Yesusika, &lt;&lt; 'Aba Guru, 'ena ma sanangioka ngone ne'enaka. Yaowa 'o da-darusu 'o ngai sa'ange miodiai; ngai moi to ngona 'Aba, ngai moi to Musa, de ngai moioli to Elia.&gt;&gt; <verse eid="MRK 9:5" /><verse number="6" style="v" sid="MRK 9:6" />'O Petrus wongose koge'ena ngano kowosidongoowa 'okia salingou wongose, sababu 'una de 'awi manai yamididi posironga yakimodongoka.<verse eid="MRK 9:6" /></para>
  <para style="p">
    <verse number="7" style="v" sid="MRK 9:7" />Ge'enaka de 'o sauramo yakisaoka de ma sauramono doka yo'isene 'o 'ilingi 'ingose, &lt;&lt;Nu'una to ngoi 'ai Ngowaka towisiboso-bosono. 'Unaka nio'isene!&gt;&gt; <verse eid="MRK 9:7" /><verse number="8" style="v" sid="MRK 9:8" />De yosijai-jai yomakadutumu manga date-dateika, 'ena yamididi koyaki'iwau ge'enaka duga ka 'o Yesusou. <verse eid="MRK 9:8" /><verse number="9" style="v" sid="MRK 9:9" />Gee 'ona yo'uti ge'ena ma gigieku daku, de 'o Yesus wakidongose 'onaka, &lt;&lt; 'Uwa niosikademo ka moika ma 'okia naga gee kangano niamakekau, nako ngoi 'o Nyawa ma Ngowaka kotomomikuawasi 'o songenoka!&gt;&gt;<verse eid="MRK 9:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 9:10" />'Ona yamoteke 'o besesongo ge'ena, duga 'ona ma sireteka yomakadongose 'ato 'o Yesus 'awi dumutu 'okia ma ngale wowangoli wosongenokau de. <verse eid="MRK 9:10" /><verse number="11" style="v" sid="MRK 9:11" />So ma rai yosano 'o Yesusika, &lt;&lt; 'Ido'oa so 'o 'agamaka yodoto-dotoko yongose 'ato salingou 'o Elia wosirano woboa 'asa de ma Jo'oungu ma Dutu Wiiri-iriki gu'una?&gt;&gt;<verse eid="MRK 9:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 9:12" />So 'o Yesus wosango, &lt;&lt;Ma goungu 'o Elia wosirano woboa, ma ngale wosikadiai 'o sagala moi-moi. Duga kokia de gee 'o Buku 'Itebi-tebinoka 'isilefoku ma ngale 'o Nyawa ma Ngowaka 'ato 'una 'asa ma gudai wosangisara de 'o nyawa wisito-torou? <verse eid="MRK 9:12" /><verse number="13" style="v" sid="MRK 9:13" />Ma ngoi tinidongose nginika, 'o Elia woboakau, de 'o nyawa-nyawa wikadiai moteke to 'ona manga mau. Ge'ena 'imakadaene de gee 'isilefokau 'o Buku 'Itebi-tebinoka ma ngale 'una.&gt;&gt;<verse eid="MRK 9:13" /></para>
  <para style="s">'O Yesus wosi'aiki 'o ngowaka 'o tokata yodo-dongosamuku</para>
  <para style="r">(<ref loc="MAT 17:14-21">Mat. 17:14-21</ref>; <ref loc="LUK 9:37-43">Luk. 9:37-43</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 9:14" />Gee 'o Yesus de 'awi do-domoteke yaruange yomatoomunoli de to 'una 'awi do-domoteke 'iregu, 'ona yakimake 'o nyawa manga gudaioka ge'enaka. De 'o 'agamaka yodoto-dotoko yamuruo naga yomakasango de 'o Yesus 'awi do-domoteke. <verse eid="MRK 9:14" /><verse number="15" style="v" sid="MRK 9:15" />'O nyawa yoku-kudai 'o Yesus wimake de yakitodokana so wido-doowara widajai-jai. <verse eid="MRK 9:15" /><verse number="16" style="v" sid="MRK 9:16" />Ge'enaka de 'o Yesus wosano 'awi do-domoteika, &lt;&lt; 'Okiali nimakaba-baili de 'o 'agamaka yodoto-dotoko?&gt;&gt;<verse eid="MRK 9:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 9:17" />De 'o nyawa yoku-kudaioka go'ona wimoi wosango, &lt;&lt; 'Aba Guru, 'ai ngowaka towi'asa ngonano. 'Una womou sababu 'o tokata widongosama. <verse eid="MRK 9:17" /><verse number="18" style="v" sid="MRK 9:18" />Nako la 'o tokata wikaruahe, ge'ena 'awi roese wosiwako-wako 'o tonauku de mita 'awi 'uru ma 'i'abo, wi 'ingiri 'iboriti de wi roese 'ipatilangoka. So ngoi togaasoko 'ani do-domoteika la yoginiiki 'o tokata ge'ena, duga 'ona koya'akunuwa!&gt;&gt;<verse eid="MRK 9:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 9:19" />So 'o Yesus kawongosekau 'onaka, &lt;&lt;Tei ngini ne'ena bolo! Ngini ma gou-goungu koniongaku-ngakuwa. Sigado kokiasi ma do'ingo ngoi tomanoa de de ngini de tosabari nginika? 'O ngowaka ge'ena nia'asano!&gt;&gt; <verse eid="MRK 9:19" /><verse number="20" style="v" sid="MRK 9:20" />So 'ona mita 'o ngowaka ge'ena ya'asa 'o Yesusino.</para>
  <para style="p" vid="MRK 9:20">Gee 'o tokata ge'ena 'o Yesus wimake, de 'o ngowaka ge'ena yadiai ma roese 'ipatilangoka so wirubaku wilolo-loloko 'o tonaoka wi 'uru ma 'i'abo. <verse eid="MRK 9:20" /><verse number="21" style="v" sid="MRK 9:21" />Ge'enaka de 'o Yesus wosano ma ngowaka ma deaka, &lt;&lt; 'Ito'ingou 'una kone'ena?&gt;&gt;</para>
  <para style="p" vid="MRK 9:21">Ma dea wongose 'ato, &lt;&lt;Kawoti-tingooninosi! <verse eid="MRK 9:21" /><verse number="22" style="v" sid="MRK 9:22" />Ma tokata ge'ena 'ijaga 'imau yaso-songenou 'o ngowaka ge'ena, so ya'umo 'o 'ukuku bolo 'o 'akeruku. Ma nako 'Aba ngona na'akunu miniriwo, tanu minidoranosi de miniriwonosi 'Aba!&gt;&gt;<verse eid="MRK 9:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 9:23" />'O Yesus wosango, &lt;&lt; 'Okia nongose? Nako 'Aba na'akunu? 'Iodumu kaidadi, 'itilai 'o nyawa yongaku!&gt;&gt;<verse eid="MRK 9:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 9:24" />De ma dea kawaporoongie woma'orese, &lt;&lt;Jou, ngoi toningaku, ma 'ai ngo-ngaku ka ma etaka. So noiriwo la 'ifoloiosi tongaku!&gt;&gt;<verse eid="MRK 9:24" /></para>
  <para style="p">
    <verse number="25" style="v" sid="MRK 9:25" />Gee 'o Yesus wakimake 'o nyawa manga gudai 'ikurue yoboa widolomu, de wodorofu 'o tokatika ge'ena wongose, &lt;&lt; 'O dopongono de 'o mou ma tokata, ngoi tonisuloko nosupu 'o ngowakoka ne'ena de koidadiwau wonidongosamoli!&gt;&gt;<verse eid="MRK 9:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 9:26" />'O tokata ge'ena 'ima'orese, ge'enaka de yadiai 'o ngowaka ma roese ge'ena 'ipatilanga, 'asa de 'isupu 'o ngowaoka ge'ena. So 'o ngowaka ge'ena 'isoka 'isongenukou, sigado 'o nyawa 'iodumu yongose 'ato, &lt;&lt; 'Una wosongenukou!&gt;&gt; <verse eid="MRK 9:26" /><verse number="27" style="v" sid="MRK 9:27" />Ma gee 'o Yesus wa'ao wi giamika de wimomiki, de 'una mita woma'oko.<verse eid="MRK 9:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 9:28" />Gee 'o Yesus 'o woakau, de 'awi do-domoteke yaika ka 'onaka de yosano, &lt;&lt; 'Ido'oa so ngomi koidadiwa mioginiiki 'o tokata ge'ena?&gt;&gt;<verse eid="MRK 9:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 9:29" />De 'o Yesus wosango, &lt;&lt; 'O tokata koge'ena ge'ena ngone poginiiki kopa'akunuwa ma ngekomo 'okia naga bato, duga ka de 'o lahidoa.&gt;&gt;<verse eid="MRK 9:29" /></para>
  <para style="s">'O Yesus wosidemoli ma ngale dua wosongene</para>
  <para style="r">(<ref loc="MAT 17:22-23">Mat. 17:22-23</ref>; <ref loc="LUK 9:43b-45">Luk. 9:43b-45</ref>)</para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 9:30" />Ge'enaka de 'o Yesus de 'awi do-domoteke yomagoraka ge'enaka dau so yogila-gila 'o Galileaka yaboa. Duga 'o Yesus womau wooluku wigi'isene 'una kiaka waika, <verse eid="MRK 9:30" /><verse number="31" style="v" sid="MRK 9:31" />sababu wakidotokosi to 'una 'awi do-domoteke konee, &lt;&lt;Ngoi 'o Nyawa ma Ngowaka 'asa 'idukula yopa-pareta manga giama ma soatika, de 'asa 'ito'oma, duga 'o wange sa'angeka de tomomiokau!&gt;&gt;<verse eid="MRK 9:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 9:32" />'O Yesus 'awi do-domoteke koyasahewa ge'ena, ma 'ona koyomoroinuwa yosano 'unaka.<verse eid="MRK 9:32" /></para>
  <para style="s">Nago'ona 'ifoloi yoamoko</para>
  <para style="r">(<ref loc="MAT 18:1-5">Mat. 18:1-5</ref>; <ref loc="LUK 9:46-48">Luk. 9:46-48</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 9:33" />'O Yesus de 'awi do-domoteke ya'adonika 'o Kapernaumoka 'o woa moioka, de wosano 'awi do-domoteika, &lt;&lt;Kangano 'okia nimakaba-baili 'o ngekomino?&gt;&gt;<verse eid="MRK 9:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 9:34" />'Ona koyosangowa sababu manga do-dagi ma sigoronaka 'ona yomakaba-baili ma ngale nago'ona 'ifoloi yoamoko gee 'onaka. <verse eid="MRK 9:34" /><verse number="35" style="v" sid="MRK 9:35" />So 'o Yesus wogogeruku de wakitoomuno de wongose 'onaka, &lt;&lt;Nago'ona yomau 'ifoloi yoamoko, 'ona salingou yomadadi 'ifoloi yotingoono, yodadi 'o nyawa 'iodumu manga ro-riwo.&gt;&gt; <verse eid="MRK 9:35" /><verse number="36" style="v" sid="MRK 9:36" />Ge'enaka de 'o Yesus 'o ngowaka ma dingoono moi wa'eseno so wa'okode to 'ona manga bionoka deika wakoooku de wongose 'awi do-domoteika, <verse eid="MRK 9:36" /><verse number="37" style="v" sid="MRK 9:37" />&lt;&lt; 'O nyawa gee yosibosono 'o ngowaka moi 'isoka ne'ena sababu 'imoteke ngoi, ge'ena kaimatero de 'ona mita 'isibosono ngoi. De nago'ona 'isibosono ngoi, 'ona wisibosono mita 'una gee woisulo-suloko.&gt;&gt;<verse eid="MRK 9:37" /></para>
  <para style="s">Nago'ona koinaributuwa, 'ona de de ngone</para>
  <para style="r">(<ref loc="LUK 9:49-50">Luk. 9:49-50</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 9:38" />Ge'enaka de 'o Yohanes wongose 'o Yesusika, &lt;&lt; 'Aba Guru, ngomi mimake 'o nyawa wimoi 'o tokata woginiiki de to ngona 'ani ronga 'Aba. So ngomi komiosidabiwa sababu 'una ko de de ngonewa.&gt;&gt;<verse eid="MRK 9:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 9:39" />Ma 'o Yesus wongose, &lt;&lt; 'Uwa koniosidabiwa, sababu komoiwa 'o no-nako 'ihera-herangi yodiai de to ngoi 'ai ronga, de kage'enaka de 'isito-torou ngoino. <verse eid="MRK 9:39" /><verse number="40" style="v" sid="MRK 9:40" />Sababu 'o nyawa koinadu-du'udukuwa ge'ena ma ngale 'ona ngoneno. <verse eid="MRK 9:40" /><verse number="41" style="v" sid="MRK 9:41" />Niosi-singina! 'O nyawa gee nisi'okere 'o 'akere sababu ngini ma Koana 'o Nyawa Wosilaha-laha 'awi do-domoteke, 'ona ma raiokau yamake ma parasengi.&gt;&gt;<verse eid="MRK 9:41" /></para>
  <para style="s">'Okia sonaa gee ma duanguku 'o nyawa yosowono</para>
  <para style="r">(<ref loc="MAT 18:6-9">Mat. 18:6-9</ref>; <ref loc="LUK 17:1-2">Luk. 17:1-2</ref>)</para>
  <para style="p">
    <verse number="42" style="v" sid="MRK 9:42" />&lt;&lt;Nago'ona yodiai sigado moi yoti-tingoono no'ona koyongakuwau ngoino, yaowa nako 'o tapu yosipusuika manga tomaroka de yaki'umo 'o ngootuku. <verse eid="MRK 9:42" /><verse number="43" style="v" sid="MRK 9:43" />Nako de ni giama ma songona 'o sowono nodiai, ni giama ge'ena na'oguka! Yaowa ngona no'ahu de ma Jo'oungu ma Dutu, de ni giama ka ma songonaka. 'Uwa sigado de 'ani giama 'itoto-totomo nowosanga 'o narakaka, ge'ena la 'o 'uku koisonge-songenuawau kaisi'ado-'adonika. [<verse eid="MRK 9:43" /><verse number="44" style="v" sid="MRK 9:44" />Ge'enaka doka 'o 'uku koisonge-songenuwa, de 'o ga'aili mita kaisongenuwa.] <verse eid="MRK 9:44" /><verse number="45" style="v" sid="MRK 9:45" />De nako de ni dou ma songona 'o sowono nodiai, 'ani dou ge'ena na'oguka! Yaowa ngona no'ahu de ma Jo'oungu ma Dutu de ni dou ka ma songonaka, 'uwa sigado de 'ani dou 'itoto-totomo de ni'umo 'o narakaka. [<verse eid="MRK 9:45" /><verse number="46" style="v" sid="MRK 9:46" />Ge'enaka doka 'o 'uku koisonge-songenuwa, de 'o ga'aili mita 'isongenuwa.] <verse eid="MRK 9:46" /><verse number="47" style="v" sid="MRK 9:47" />Nako de ni ako ma songona 'o sowono nodiai, napeleurika ni ako ge'ena! Yaowa ngona nowosanga ma Jo'oungu ma Dutu 'awi Dunia ma Sungika ni ako ka ma songonaka, 'uwa sigado 'ani ako ngai modidioka de ni'umo 'o narakaka. [<verse eid="MRK 9:47" /><verse number="48" style="v" sid="MRK 9:48" />Ge'enaka doka 'o 'uku koisonge-songenuwa de 'o ga'aili mita 'isongenuwa.]<verse eid="MRK 9:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 9:49" />'O nyawa moi-moi 'asa yakisitebini de 'o 'uku, 'isoka 'o su-suba 'o haewani 'isitebini de 'o gasi la ma Jo'oungu ma Dutu woduaka.<verse eid="MRK 9:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 9:50" />'O gasi ge'ena yaowa, ma nako koiosawau, kaidadiosi padiai 'iosali? So ngini 'o duniaka ne'ena salingou 'isoka 'o gasi yaowa-owa, ge'ena la ngini nio'ahu nimakalega moi de moi.&gt;&gt;<verse eid="MRK 9:50" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 9" />
  <chapter number="10" style="c" sid="MRK 10" />
  <para style="s">'O Gangoluku</para>
  <para style="r">(<ref loc="MAT 19:1-12">Mat. 19:1-12</ref>; <ref loc="LUK 16:18">Luk. 16:18</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 10:1" />Ge'enaka de 'o Yesus woma'aiki ge'enaka, de wotagi 'o Yudea ma daeraaka de 'o Yordan ma 'akere ma songonasa. 'O nyawa manga gudai yaino 'o Yesus widolomuoli. Ge'enaka de 'o Yesus wodotokoli 'isoka biasau.<verse eid="MRK 10:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 10:2" />'O Farisioka yamuruo naga mita yoboano 'o Yesus wi sala yosinonu-nonu. 'Ona kayongosekau, &lt;&lt;Moteke nanga 'agama ma do-dotoko, kaidadi 'o nyawa manga wekata yaoluku?&gt;&gt;<verse eid="MRK 10:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 10:3" />'O Yesus wosango, &lt;&lt; 'O Musa 'okia wosuloko nginika?&gt;&gt;<verse eid="MRK 10:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 10:4" />De 'ona yosango, &lt;&lt; 'O Musa wongose kaidadi 'o nyawa manga wekata yaoluku, 'itilai 'isira 'o gangoluku ma surati yolefokasi.&gt;&gt;<verse eid="MRK 10:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 10:5" />'O Yesus wongose 'onaka, &lt;&lt; 'O Musa wolefo koge'ena, sababu to ngini 'ania singina 'i'opini. <verse eid="MRK 10:5" /><verse number="6" style="v" sid="MRK 10:6" />Duga ka ma gurue gee ma Jo'oungu ma Dutu 'o nyawa wosidadi, ge'ena 'o nauru de 'o ngeweka. <verse eid="MRK 10:6" /><verse number="7" style="v" sid="MRK 10:7" />Ge'enau so 'o nauru 'asa yamada manga 'esa de manga dea de yomarimoi de manga wekata. <verse eid="MRK 10:7" /><verse number="8" style="v" sid="MRK 10:8" />So yamididi go'ona yodadi ka moiou, koyamididiwau. <verse eid="MRK 10:8" /><verse number="9" style="v" sid="MRK 10:9" />Ma ngale ge'ena 'okia naga ma Jo'oungu ma Dutu wosikatoomuokau, ngone 'o nyawa koidadiwa posikati-tingaka!&gt;&gt;<verse eid="MRK 10:9" /></para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 10:10" />Gee 'o Yesus de wi do-domoteke yowosangika 'o woaka, de 'awi do-domoteke yodasano 'o Yesusika ma hali ge'ena. <verse eid="MRK 10:10" /><verse number="11" style="v" sid="MRK 10:11" />'O Yesus wongose 'onaka, &lt;&lt;Nagu'una wi wekata waoluoka de womodoka de 'o ngeweka mimoioli, 'una wosongou 'awi wekata ma siraka. <verse eid="MRK 10:11" /><verse number="12" style="v" sid="MRK 10:12" />Koge'enali mita mimoi mi rokata maoluoka de momodoka de wimoioli, muna ge'ena mosongou.&gt;&gt;<verse eid="MRK 10:12" /></para>
  <para style="s">'O Yesus wakisibarakati 'o ngowa-ngowaka</para>
  <para style="r">(<ref loc="MAT 19:13-15">Mat. 19:13-15</ref>; <ref loc="LUK 18:15-17">Luk. 18:15-17</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 10:13" />Ma moi ge'ena, 'o nyawa manga ngowa-ngowaka yaki'asa 'o Yesusino, la waki'ao de wakisibarakati. Duga 'awi do-domoteke yakingamo 'onaka! <verse eid="MRK 10:13" /><verse number="14" style="v" sid="MRK 10:14" />'O Yesus wakimake wi do-domoteke yodiai koge'ena, de wakingamo kawongosekau, &lt;&lt;Niakimadaka 'o ngowaka go'ona yaino ngoino. 'Uwa koniakisidabiwa, sababu 'o nyawa gee yadawongo ma Jo'oungu ma Dutu 'awi pareta 'isoka 'o ngowa-ngowaka, 'ona yodadi ma Jo'oungu ma Dutu 'awi kawasa.<note caller="f" style="f"><char style="fr" closed="false">10:14: </char><char style="ft" closed="false">Bolo: &lt;&lt;...sababu 'o nyawa 'isoka no'ona ge'ena yodadi ma Jo'oungu ma Dutu 'awi kawasa.&gt;&gt;</char></note> <verse eid="MRK 10:14" /><verse number="15" style="v" sid="MRK 10:15" />Niosi-singina! 'O nyawa salingou yoboa ma Jo'oungu ma Dutuka 'isoka 'o ngowaka moi ne'ena; nako ko'uwa, 'ona koyodadiwa ma Jo'oungu ma Dutu 'awi kawasa.&gt;&gt; <verse eid="MRK 10:15" /><verse number="16" style="v" sid="MRK 10:16" />'O Yesus koge'ena wongoseka de wakikooono de wi giama wakikokidatami, de wakisibarakati.<verse eid="MRK 10:16" /></para>
  <para style="s">'O nyawa wokaya-kaya</para>
  <para style="r">(<ref loc="MAT 19:16-30">Mat. 19:16-30</ref>; <ref loc="LUK 18:18-30">Luk. 18:18-30</ref>)</para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 10:17" />Gee 'o Yesus 'awi do-dagi wadowangoli de 'o nyawa wimoi waino 'o Yesusino wido-doowarino. 'O nyawa gu'una wotalibukuku wosuba 'o Yesusika, de wosano, &lt;&lt; 'Aba Guru, 'ani singina 'isure-sure, ngoi salingou 'okia tadiai la tamake 'o 'ahu ma dutu 'ika-kakali?&gt;&gt;<verse eid="MRK 10:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 10:18" />'O Yesus wosano, &lt;&lt; 'Ido'oa so nongose ngoi 'ai singina 'isure? Komoiwa manga singina 'isure, duga ka ma Jo'oungu ma Dutu womatengo. <verse eid="MRK 10:18" /><verse number="19" style="v" sid="MRK 10:19" />Ngona ma sirete ma rai nanakokau ma Jo'oungu ma Dutu 'awi besesongo koneda: &lt; 'Uwa noto'oma, 'uwa nosongou, 'uwa notosiki, 'uwa nodadi 'o sakisii ma ngeluku, 'uwa noforiki, de nakihoromati 'ani 'esa de ni dea.&gt; &gt;&gt;<verse eid="MRK 10:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 10:20" />De 'una wongosekau, &lt;&lt; 'Aba Guru, 'o besesongo 'iodumu ge'ena tamotekokau katomadogu'urunosi.&gt;&gt;<verse eid="MRK 10:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 10:21" />'O Yesus widi-diriidi ma de wi singina 'o nyawa gu'una so kawongosekau, &lt;&lt;Duga 'o ngai moiosi konadiaiwasi. Notagi 'ani harataa nakokiwukunu; de ma pipi 'o nyawa yosusa-susaka nosibula, de ngona 'asa namake 'o harataa 'o sorogaaka. Ge'ena 'ipasa 'asa naino la noimoteke ngoi.&gt;&gt; <verse eid="MRK 10:21" /><verse number="22" style="v" sid="MRK 10:22" />Wokaya-kaya gu'una wo'isenoka 'o Yesus koge'ena wongose, de 'awi singina 'i'ogu, so woma'aiki ge'enaka dau 'ena 'awi singina 'isusaku sababu 'una wokaya ma sala.<verse eid="MRK 10:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 10:23" />So 'o Yesus wakidi-diriidi 'awi do-domoteika de kawongosekau 'onaka, &lt;&lt; 'Ena ma susaka 'o nyawa yokaya-kaya yodadi ma Jo'oungu ma Dutu 'awi 'umati!&gt;&gt;<verse eid="MRK 10:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 10:24" />'O Yesus 'awi do-domoteke yoherangi yo'isenoka 'o Yesus 'awi demo ge'ena. Duga wakisidaduroli, wongose 'onaka, &lt;&lt; 'Ai ngowa-ngowaka, ma goungu 'isusa 'o nyawa yodadi ma Jo'oungu ma Dutu 'awi 'umati. <verse eid="MRK 10:24" /><verse number="25" style="v" sid="MRK 10:25" />'Ifoloi 'igapangi 'o 'onta ngai moi 'iwosanga 'o daiti ma sukonika, positero de 'o nyawa yokaya-kaya moi yowosanga ma Jo'oungu ma Dutu 'awi paretaka.&gt;&gt;<verse eid="MRK 10:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 10:26" />'O Yesus 'awi demo ge'ena 'awi do-domoteke yoherangi, sigado yomakadongose moi de moi, &lt;&lt;Nako koge'ena, de dua nago'ona 'idadi yamake 'o laha?&gt;&gt;<verse eid="MRK 10:26" /></para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 10:27" />'O Yesus wakidi-diriidi de kawongosekau, &lt;&lt;Nako ka 'o nyawa manga manarama ge'ena koidadiwa, ma nako de ma Jo'oungu ma Dutu, ge'ena kaidadi. Sababu 'una ge'ena 'iodumu kaidadi.&gt;&gt;<verse eid="MRK 10:27" /></para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 10:28" />Ge'enaka de 'o Petrus kawongosekau, &lt;&lt;Minimake ngomi ne'ena mia kia sonaa 'iodumu miamadakau ma ngale minimoteke ngona 'Aba.&gt;&gt;<verse eid="MRK 10:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 10:29" />'O Yesus wongose, &lt;&lt;Tinisidemo, nago'ona manga woa yamada, bolo manga riaka dodoto, bolo manga 'esa biranga, bolo manga 'esa de manga dea, bolo manga ngowa-ngowaka bolo manga bairi sababu ngoi de 'o Habari ma Owa ma Jo'oungu ma Dutuno, <verse eid="MRK 10:29" /><verse number="30" style="v" sid="MRK 10:30" />'ona 'asa yamake 'ifoloi 'ikudai ma 'orasi ne'ena. Manga woa 'asa 'idadi yamake sigado 'o ratusu moi, bolo manga riaka dodoto, manga 'esa biranga, manga 'esa, manga ngowa-ngowaka, manga bairi de 'o sangisara mita. De ma 'orasi ma du'uruoka dua 'ona yamake 'o 'ahu 'ika-kakali. <verse eid="MRK 10:30" /><verse number="31" style="v" sid="MRK 10:31" />Ma 'o nyawa manga gudai gee ma 'orasi ne'ena yakimakeka 'o nyawa ma amoko, dua yodadi yotingoono, de gee ma 'orasi ne'ena yakimakeka yoti-tingoono, dua 'asa yodadi amoko.&gt;&gt;<verse eid="MRK 10:31" /></para>
  <para style="s">'O Yesus wosidemo wosigali ma sa'ange ma ngale wosongene</para>
  <para style="r">(<ref loc="MAT 20:17-19">Mat. 20:17-19</ref>; <ref loc="LUK 18:31-34">Luk. 18:31-34</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 10:32" />'O Yesus de 'awi do-domoteke manga do-dagi ma sigoronaka yosikaie 'o Yerusalemude. 'O Yesus wosira-sira, de 'awi do-domoteke yoodumu yamao manga singina 'itubuso. De 'o nyawa-nyawa gee yotu-tu'uru manga dudunino mita yamao yakimodongo. Ge'enaka de 'o Yesus waki'asokoli 'awi do-domoteke so yomatingaika ka 'onaka de wakisidemo 'okia naga gee dua 'idadi 'unaka. <verse eid="MRK 10:32" /><verse number="33" style="v" sid="MRK 10:33" />'O Yesus wongose 'onaka, &lt;&lt;Bika niosigisene! Ngone ne'ena posikaie 'o Yerusalemude. Dua kadaku paie de ngoi 'o Nyawa ma Ngowaka 'isisarakani 'o 'imam ma sae-saekika de 'o 'agamaka yodoto-dotoika. Ngoi 'asa 'ihukumu 'iso-songene, ge'enaka de 'idukulali ko 'o Yahudiwa ma nyawaka. <verse eid="MRK 10:33" /><verse number="34" style="v" sid="MRK 10:34" />'Ona 'asa 'isisasaru, 'ikibiti, 'isikisaa, de 'isidele 'o salipoka. Ma 'o wange sa'angeka de tomomikokau.&gt;&gt;<verse eid="MRK 10:34" /></para>
  <para style="s">'O Yakobus de 'o Yohanes manga ga-ga'asoko</para>
  <para style="r">(<ref loc="MAT 20:20-28">Mat. 20:20-28</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 10:35" />Ge'enaka de 'o Yakobus de 'o Yohanes 'o Zebedeus wi ngowa-ngowaka yaino 'o Yesusino de kayongosekau, &lt;&lt; 'Aba Guru, tanu 'o kianikia moi nodiaiosi ngomino!&gt;&gt;<verse eid="MRK 10:35" /></para>
  <para style="p">
    <verse number="36" style="v" sid="MRK 10:36" />De 'o Yesus wosano, &lt;&lt; 'Okia niomau todiai nginika?&gt;&gt;<verse eid="MRK 10:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 10:37" />'Ona yosango, &lt;&lt;Ngomi miomau miogogere 'ani giniraoka de ni gubalioka 'Aba, dua gee ma 'orasi nokoana de ni kumati.&gt;&gt;<verse eid="MRK 10:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 10:38" />Ge'enaka de 'o Yesus wongose 'onaka, &lt;&lt;Ngini konianakowa 'okia nioga'asoko. Nia'akunoka? nia'okere gee dua ngoi ta'okere-'okere? Nia'akunoka? niamoku 'o susa de 'o sangisara gee dua ngoi tamoku?&gt;&gt;<verse eid="MRK 10:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 10:39" />'Ona yosango, &lt;&lt;Mia'akunu!&gt;&gt;</para>
  <para style="p" vid="MRK 10:39">So 'o Yesus kawongosekauoli 'onaka, &lt;&lt;Ma goungu ngini 'asa nia'okere 'o sawokoka, gee dua ngoi ta'okere. De 'asa niamoku 'o susa de 'o sangisara 'isoka ngoioli. <verse eid="MRK 10:39" /><verse number="40" style="v" sid="MRK 10:40" />Duga nago'ona 'asa yogogere 'ai giniraoka bolo 'ai gubalioka, ge'ena ko to ngoiwa 'ai kuasa tositatapu. Ma Jo'oungu ma Dutu wositatapu nago'ona 'asa yogogere ge'enaka.&gt;&gt;<verse eid="MRK 10:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 10:41" />'O do-domoteke yamogiooko go'ona yogi'isene ge'ena de yongamo 'o Yakobus de 'o Yohanesika. <verse eid="MRK 10:41" /><verse number="42" style="v" sid="MRK 10:42" />So 'o Yesus wakitoomuno 'ona yoodumu de kawongosekau 'onaka, &lt;&lt;Ngini nianakokau yopa-pareta gee kowinako-nakowa ma Jo'oungu ma Dutu, manga kawasa yakido-doko so manga 'ahu 'isangisara. De 'o nyawa yola-laagomo yakisihaga manga kawasaka. <verse eid="MRK 10:42" /><verse number="43" style="v" sid="MRK 10:43" />Ma ngini koidadiwa koge'ena. Nago'ona yomau yoamoko nginioka ne'ena, salingou yole-leleani nginika. <verse eid="MRK 10:43" /><verse number="44" style="v" sid="MRK 10:44" />De nago'ona yomau yodaduie naga nginioka, salingou yodadi 'o ro-riwo 'o nyawa 'iodumika. <verse eid="MRK 10:44" /><verse number="45" style="v" sid="MRK 10:45" />Sababu ngoi 'o Nyawa ma Ngowaka mita toboano ma ngale koileleaniwa. Ngoi taino ma ngale toleleani de tokula 'ai 'ahu ma ngale takituusu 'o nyawa manga gudai.&gt;&gt;<verse eid="MRK 10:45" /></para>
  <para style="s">'O Yesus wisi'aiki 'o Bartimeus worau-rau</para>
  <para style="r">(<ref loc="MAT 20:29-34">Mat. 20:29-34</ref>; <ref loc="LUK 18:35-43">Luk. 18:35-43</ref>)</para>
  <para style="p">
    <verse number="46" style="v" sid="MRK 10:46" />'Ona ya'adonika 'o Yerikhoka. So gee 'o Yesus de 'awi do-domoteke de mita 'o nyawa yoku-kudai go'ona yamada ma soana ge'ena de worau-rau wimoi wogogerie 'o ngekomo ma gagaroka womaga-ga'asoko, 'awi ronga 'o Bartimeus, 'o Timeus 'awi ngowaka. <verse eid="MRK 10:46" /><verse number="47" style="v" sid="MRK 10:47" />Gee wo'isene 'ato naga ge'enano wotoaka ge'ena 'o Yesus 'o Nazaretino, de 'una womasigasoko, &lt;&lt;Ee Yesus 'o Dautu 'awi Ngowaka, tanu ngoi noidoranosi!&gt;&gt;<verse eid="MRK 10:47" /></para>
  <para style="p">
    <verse number="48" style="v" sid="MRK 10:48" />De 'o nyawa yoku-kudai wiringamo kayongosekau, &lt;&lt;Nomaogoro!&gt;&gt; Ma 'una kawodaamoko monga womapoaka, &lt;&lt;Ee Dautu wi Ngowaka, sioko noidoranosi!&gt;&gt;<verse eid="MRK 10:48" /></para>
  <para style="p">
    <verse number="49" style="v" sid="MRK 10:49" />Ge'enaka de 'o Yesus womaogoro de kawongosekau, &lt;&lt;Tagi wini'asoko.&gt;&gt;</para>
  <para style="p" vid="MRK 10:49">So 'ona wi'asoko 'o nyawa worau-rau gu'una. 'Ona kayongosekau, &lt;&lt;Nomarii-riidi, to ngona 'ani duga yaowa sigado 'o Yesus woni'asoko, so noma'okodeu!&gt;&gt;<verse eid="MRK 10:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 10:50" />Ge'enaka de worau-rau gu'una 'awi baju ma kawosiwakoku de wosijai-jai woma'oko so wotagi 'o Yesusika.<verse eid="MRK 10:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 10:51" />'O Yesus wosano 'o nyawa worau-rauka, &lt;&lt; 'Okia nomau todiai ngonaka?&gt;&gt;</para>
  <para style="p" vid="MRK 10:51">De 'una wosango, &lt;&lt; 'Aba Guru, ngoi tomau tomasimake!&gt;&gt;<verse eid="MRK 10:51" /></para>
  <para style="p">
    <verse number="52" style="v" sid="MRK 10:52" />Kage'ena de 'o Yesus wongose, &lt;&lt;Notagiou, sababu nongaku so ge'enau nisilaha.&gt;&gt;</para>
  <para style="p" vid="MRK 10:52">Ka ma 'orasi ge'ena de worau-rau womasimakekau de wotagi 'o Yesus wimoteke 'o ngekomika.<verse eid="MRK 10:52" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 10" />
  <chapter number="11" style="c" sid="MRK 11" />
  <para style="s">'O Yesus 'o Yerusalemika wowosanga 'isoka ma Koana wo'uti</para>
  <para style="r">(<ref loc="MAT 21:1-11">Mat. 21:1-11</ref>; <ref loc="LUK 19:28-40">Luk. 19:28-40</ref>; <ref loc="JHN 12:12-19">Yoh. 12:12-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 11:1" />Gee 'o Yerusalem yodomoorika, 'o Betfage de 'o Betania ma soanoka, 'o Zaitun ma diko ma agaroka. Ge'enaka de 'o Yesus 'awi do-domoteke yamididi wakisuloko yotagi yosira. <figure style="fig" file="HK00367.pcx" size="span" ref="(11:1)">Betania ma kota</figure> <verse eid="MRK 11:1" /><verse number="2" style="v" sid="MRK 11:2" />'Una kawongosekau, &lt;&lt;Niotagi dokaika 'o soana poda-daarika gee, dua gee niowosanga ma soanika ge'ena de niamake 'o keledai ma ngowaka moi 'isipusuika, 'o keledai ma ngowaka ge'ena komoiwasi yapake. Ma keledai ge'ena niasose la nia'asano ne'enano. <verse eid="MRK 11:2" /><verse number="3" style="v" sid="MRK 11:3" />De nako 'o nyawa yosano 'ido'oa so 'o keledai ge'ena nia'ese, ge'ena niongose 'ato ma Jou womau wapake ma dua koito'ingowa de wosigiliokau.&gt;&gt;<verse eid="MRK 11:3" /></para>
  <para style="p">
    <verse number="4" style="v" sid="MRK 11:4" />'O Yesus 'awi do-domoteke yamididi go'ona yotagi, de yamake 'o keledai ma ngowaka 'isipusuika 'o woa ma daarino 'o ngekomo ma dateoka. So 'ona yasose ma keledai ma bu-busuku ge'ena. <verse eid="MRK 11:4" /><verse number="5" style="v" sid="MRK 11:5" />'O nyawa yoma'oko-'okode ge'enaka yosano 'onaka, &lt;&lt;Ee! 'Okia niodo'oa ge'ena? 'Ido'oa so 'o keledai ma ngowaka ge'ena niasose?&gt;&gt;<verse eid="MRK 11:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 11:6" />'Ona yosango 'isoka kokia naga 'o Yesus wosidemokau 'onaka. So 'o nyawa yoma'oko-'okode go'ona kayosimadaka ya'asa 'o keledai ge'ena. <verse eid="MRK 11:6" /><verse number="7" style="v" sid="MRK 11:7" />Gee ya'adono 'o Yesusika de manga baju yaawene so yosinao 'o keledai ma poretuku, ge'enaka de 'o Yesus wodoa womatamide ma poretoka. <verse eid="MRK 11:7" /><verse number="8" style="v" sid="MRK 11:8" />'O nyawa manga gudai manga juba yosinao 'o ngekomoka, de munuka 'o gota ma sago ma di-dingoono ya'eseno so yosinao 'o tapaki ma goronako. <verse eid="MRK 11:8" /><verse number="9" style="v" sid="MRK 11:9" />'O nyawa yoku-kudai gee 'o Yesus wimote-moteke 'awi bionisa de wi dudunoko yoodumu yosigaso-gasoko yongose, &lt;&lt; 'Alele! Nou, powisiarene ma Jo'oungu ma Dutu! Tanu ma Jo'oungu ma Dutu wisibarakati 'una gee woboa de ma Jou 'awi kuasa. <verse eid="MRK 11:9" /><verse number="10" style="v" sid="MRK 11:10" />De kaisureli 'awi pareta 'ikua-kuata 'asa 'iboa, to ma Koana 'o Dautu 'awi pareta to ngone nanga edete! Powisiarene ma Jo'oungu ma Dutu gee wi kumati ko 'okiawa positero.&gt;&gt;<verse eid="MRK 11:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 11:11" />Koge'enau ma do-dagi sigado 'o Yesus wa'adono 'o Yerusalemika, deika wowosanga ma Jo'oungu ma Dutu 'awi Woaka. Ge'enaka 'una wolega-lega moi-moi ma dodaka 'iodumu, duga 'itarusokau rekeni so 'una de 'awi do-domoteke yamogiooko de modidi yotagi 'o Betania ma soanika.<verse eid="MRK 11:11" /></para>
  <para style="s">'O Yesus wosibobeto 'o gota ma ronga 'o 'ara</para>
  <para style="r">(<ref loc="MAT 21:18-19">Mat. 21:18-19</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 11:12" />Ma bibinoka gee 'ona yoma'aiki 'o Betaniaka so manga do-dagi ma sigoronaka de 'o Yesus wamao wisawini. <verse eid="MRK 11:12" /><verse number="13" style="v" sid="MRK 11:13" />'O gurutikasi 'ena wamakekau 'o 'ara 'o utu moi ma soka 'irubu-rubu. So waika walega ma de ma sowoko kanikia. Ma waika 'ena ka moi ma koi'iwa so ka ma soka duga. Sababu ma 'orasi ge'ena 'o 'ara ko ma 'orasuwasi 'isowoko. <verse eid="MRK 11:13" /><verse number="14" style="v" sid="MRK 11:14" />Ge'enaka de 'o Yesus kawongosekau 'o 'ara ma utuka, &lt;&lt; 'Ikurue ma 'orasi ne'ena, dua konosowokuawau so komoiwau ya'odomo to ngona 'ani sowoko!&gt;&gt;</para>
  <para style="p" vid="MRK 11:14">'Awi do-domoteke yo'isene 'o demo ge'ena.<verse eid="MRK 11:14" /></para>
  <para style="s">'O Yesus wowosanga ma Jou 'awi Woaka</para>
  <para style="r">(<ref loc="MAT 21:12-17">Mat. 21:12-17</ref>; <ref loc="LUK 19:45-48">Luk. 19:45-48</ref>; <ref loc="JHN 2:13-22">Yoh. 2:13-22</ref>)</para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 11:15" />'Ona ya'adonika 'o Yerusalemuoka, de 'o Yesus wotagioli ma Jo'oungu ma Dutu 'awi Woaka. De wakikokiginiiki gee yomawuku-wukunu ge'enaka dau. 'O pipi yosita-tagali manga meja de 'o pombo yowuku-wukunu manga go-gogere waleoto pagara. <verse eid="MRK 11:15" /><verse number="16" style="v" sid="MRK 11:16" />De ka moi ma kowakisidabiwa 'o kianikia ya'asa ge'ena ma Jou 'awi Woa ma ginitarino. <verse eid="MRK 11:16" /><verse number="17" style="v" sid="MRK 11:17" />Ge'enaka de 'o Yesus wakidotoko 'o nyawa ge'enaka dau. Kawongosekau, &lt;&lt; 'O Buku 'Itebi-tebini ma dodaka 'isilefoku: Ma Jo'oungu ma Dutu wongose koneda: &lt;To ngoi 'ai Woa ne'ena 'asa yosironga 'o sagala nyawa manga lahidoa ma ngii.&gt; Ma ngini niadiai nia go'ora ma ngii!&gt;&gt;<verse eid="MRK 11:17" /></para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 11:18" />'O 'imam ma sae-saeke de 'o 'agamaka yodoto-dotoko yo'isene 'o demo ge'ena so 'o ngekomo yononu la wito'oma. Ma 'ona kayododatoka 'unaka sababu 'o nyawa yoku-kudai kayoki-kiliri yoduaka yosigisene to 'una 'awi do-dotoko.<verse eid="MRK 11:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 11:19" />'Iobirou de 'o Yesus de 'awi do-domoteke yoma'aiki ge'ena ma kotaka.<verse eid="MRK 11:19" /></para>
  <para style="s">'O do-dotoko 'o 'ara ma utuno de 'o Yesus wonasidotoko ma ngale polahidoa</para>
  <para style="r">(<ref loc="MAT 21:20-22">Mat. 21:20-22</ref>)</para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 11:20" />Ma bibinoka 'o ngoru-ngorumika gee yoboa ge'ena ma 'ara ma gotano, 'ena ma 'ara ma utu ge'ena 'i'osaukou sigado ma ngutu-ngutuuku. <verse eid="MRK 11:20" /><verse number="21" style="v" sid="MRK 11:21" />Ge'enaka de 'o Petrus wonganonie 'okia naga gee 'idadiokau ka'uginika. So 'o Petrus wongose 'o Yesusika, &lt;&lt; 'Aba Guru, bika nalega 'o 'ara ma utu nosilahi-lahi gee 'isongenukou!&gt;&gt;<verse eid="MRK 11:21" /></para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 11:22" />'O Yesus wosango, &lt;&lt;Winingaku ma Jo'oungu ma Dutuka! <verse eid="MRK 11:22" /><verse number="23" style="v" sid="MRK 11:23" />Ma gou-goungu ngini 'idadi niongose 'o gigieka ne'ena, &lt;Noma'umo de notumunu 'o ngootuku!&gt; de dua 'asa 'idadi 'itilai 'uwa nia singina 'itingoono, de niongaku 'ato gee niongosekau ge'ena dua 'idadi. <verse eid="MRK 11:23" /><verse number="24" style="v" sid="MRK 11:24" />Sababu ge'ena tinisidemo: Nako ngini nimalahidoa bolo 'o kianikia nimaga'asoko, niongakukau 'ato ma Jo'oungu ma Dutu winikulakau 'okia naga gee nioga'asoko, de ngini 'asa nimadamake. <verse eid="MRK 11:24" /><verse number="25" style="v" sid="MRK 11:25" />De nako ngini nimalahidoa ma nia singina koisanangiwa 'o nyawa 'ireguka, ge'ena salingou 'isira koniosi-singinawau 'o nyawa go'ona manga so-sowono, la nia Dea 'o sorogaaka mita kowosi-singinawau to ngini 'ania sowono. [<verse eid="MRK 11:25" /><verse number="26" style="v" sid="MRK 11:26" />Nako ngini nia singinaka nimadonoaku 'o nyawa 'iregu manga sowono, dua nia Dea 'o sorogaaka mita kowinisipidiluwa to ngini nia sowono.]&gt;&gt;<verse eid="MRK 11:26" /></para>
  <para style="s">Yodasano 'o Yesus 'awi pareta</para>
  <para style="r">(<ref loc="MAT 21:23-27">Mat. 21:23-27</ref>; <ref loc="LUK 20:1-8">Luk. 20:1-8</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 11:27" />'O Yesus de 'awi do-domoteke yaikali 'o Yerusalemuka. De gee 'o Yesus wotagi wakiloliti ge'ena ma Jo'oungu ma Dutu 'awi Woa ma dodaka, de 'o 'imam ma saeke de 'o 'agamaka yodoto-dotoko de mita 'o Yahudioka manga balu-balusu yaino 'o Yesusino. <verse eid="MRK 11:27" /><verse number="28" style="v" sid="MRK 11:28" />De yosano, &lt;&lt;Nago'ona nisuloko nokadiai 'iodumu ne'ena? De nago'ona 'o pareta nikulaka?&gt;&gt;<verse eid="MRK 11:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 11:29" />'O Yesus wosango, &lt;&lt;Ngoi mita tomau tosano nginika, so niosango la ngoi mita 'asa tinisidemo 'o pareta de 'o kuasa nago'onano ngoi todiai moi-moi ne'ena. <verse eid="MRK 11:29" /><verse number="30" style="v" sid="MRK 11:30" />'O Yohanes 'o nyawa wo'osiki ge'ena nago'onano 'o pareta wikula, 'o nyawano bolo ma Jo'oungu ma Dutuno?&gt;&gt;<verse eid="MRK 11:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 11:31" />Ge'enaka de 'o 'imam ma sae-saeke de 'o Yahudioka manga balu-balusu yokurue yomasikadibangi. 'Ona kayongosekau, &lt;&lt;Nako ngone pongose 'ato ma Jo'oungu ma Dutuno, dua 'una wongose 'ato, &lt;De 'ido'oa so ngini koniongakuwa 'o Yohanesika?&gt; <verse eid="MRK 11:31" /><verse number="32" style="v" sid="MRK 11:32" />Ma 'isusa mita nako pongose 'o nyawano.&gt;&gt; Sababu 'ona yakimodongo 'o nyawa yoku-kudaika, ngano 'o nyawa 'iodumu yanako 'o Yohanes ge'ena 'o nabii moi. <verse eid="MRK 11:32" /><verse number="33" style="v" sid="MRK 11:33" />So 'ona yosango, &lt;&lt;Ngomi komianakowa.&gt;&gt;</para>
  <para style="p" vid="MRK 11:33">Ge'enaka de 'o Yesus kawongosekau 'onaka, &lt;&lt;Nako koge'ena, ngoi mita tooluku tinisidemo 'o pareta de 'o kuasa nago'onano ngoi todiai 'iodumu ne'ena.&gt;&gt;<verse eid="MRK 11:33" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 11" />
  <chapter number="12" style="c" sid="MRK 12" />
  <para style="s">'O 'ade-'ade 'o 'anggur ma bairoka yoma-manarama</para>
  <para style="r">(<ref loc="MAT 21:33-46">Mat. 21:33-46</ref>; <ref loc="LUK 20:9-19">Luk. 20:9-19</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 12:1" />Ge'enaka de 'o Yesus wokurue wobicara de 'o 'ade-'ade 'o 'imam ma sae-saekika de 'o 'agamaka yodo-dotoika de mita 'o Yahudioka manga balu-balusika go'ona, kawongosekau, &lt;&lt;Naga wimoi wi bairoka 'o 'anggur wotuduku, de ma batingino 'o hisa wosikilolitoka. Ge'enaka de 'o sukono wodiai ma ngale 'o 'anggur 'ide-deteo, 'asa de wosigoko mita ma bairi ma ja-jaga manga ngii. 'Iduangoka 'iodumu de 'o 'anggur ma bairi ge'ena wosisewakau yoma-manaramika yamuruo naga, ge'enaka de 'una wotagiokau 'o daeraa 'ireguka. <verse eid="MRK 12:1" /><verse number="2" style="v" sid="MRK 12:2" />Ma 'orasi ya'adono 'o 'anggur ma sowoko ya'utuku, 'o nyawa gu'una wosidingoto 'awi ro-riwo wimoi 'o bairi yoma-manaramika, ma ngale wa'ese to 'una 'awi bula. <verse eid="MRK 12:2" /><verse number="3" style="v" sid="MRK 12:3" />Ma yoma-manarama go'ona witagoko 'o bairi ma dutu wi ro-riwo gu'una, ge'enaka de wipesana de wisuloko wolio kawomamurue. <verse eid="MRK 12:3" /><verse number="4" style="v" sid="MRK 12:4" />Ge'enaka de 'o bairi ma dutu gu'una wosidingotoli wi ro-riwo wimoioli. Ma yoma-manarama go'ona wipesanoli 'o ro-riwo gu'una wi saeika, ge'enaka de wiginiiki ma de wi doana. <verse eid="MRK 12:4" /><verse number="5" style="v" sid="MRK 12:5" />'O bairi ma dutu gu'una wosidingotoli 'awi ro-riwo wimoioli, ma 'ona wito'omaka 'o ro-riwo gu'una. De koge'enau 'ona yakidiai 'o ro-riwo 'iregu yoku-kudaika mita; naga munuka yakipesana, de munuka yakito'oma. <verse eid="MRK 12:5" /><verse number="6" style="v" sid="MRK 12:6" />'O bairi ma dutu gu'una nago'onasi 'idadi wakisidingoto 'awi bairika ma 'orasi ne'ena? Kawomatengokau, ge'ena la to 'una ma sirete 'awi ngowaka wisiboso-bosono. So ma du'uruku 'una wosidingoto 'awi ngowaka gu'una yoma-manaramika. 'Una watibangi 'ato, &lt; 'Ai ngowaka ge'ena ma raiokau wi'isene.&gt; <verse eid="MRK 12:6" /><verse number="7" style="v" sid="MRK 12:7" />Duga yoma-manarama go'ona yomakadongose moi de moi, yongose 'ato, &lt;Nu'unau ma warisi ma dutu. Nou ngone powito'oma, la ngone pamake to 'una 'awi warisi!&gt; <verse eid="MRK 12:7" /><verse number="8" style="v" sid="MRK 12:8" />So 'o ngowaka gu'una witagoko de wito'omaka. De 'awi songene ya'umo ge'ena ma bairi ma dudunika.&gt;&gt;<verse eid="MRK 12:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 12:9" />Ge'enaka de 'o Yesus wosano, &lt;&lt; 'Okia dua wodiai 'o bairi ma dutu gu'una? Ma raiokau dua 'una waino de wakito'omaka yoma-manarama go'ona. Deika 'o bairi ge'ena wosisewali yoma-manarama 'ireguka. <verse eid="MRK 12:9" /><verse number="10" style="v" sid="MRK 12:10" />Ngini ma raiokau niabacakau ma bo-bula naneda 'o Buku 'Itebi-tebini ma dodaka:</para>
  <para style="q1" vid="MRK 12:10">&lt; 'O teto gee kaya'umokou 'o woa yodi-diai,</para>
  <para style="q2" vid="MRK 12:10">'idadi ma ba-bangini ma guata.<verse eid="MRK 12:10" /></para>
  <para style="q1">
    <verse number="11" style="v" sid="MRK 12:11" />Ne'ena ge'ena ma Jou wodiai;</para>
  <para style="q2" vid="MRK 12:11">duru de 'i'ofioka!&gt; &gt;&gt;<verse eid="MRK 12:11" /></para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 12:12" />So 'o Yahudioka manga balu-balusu gee yo'ise-'isene 'o 'ade-'ade ge'ena, yomau 'o Yesus witagoko sababu 'ona yanako 'o 'ade-'ade ge'ena 'o Yesus wositago-tago 'onaka. Duga 'ona yakidomodongo 'o nyawa yoku-kudaika, so 'ona yotagi 'o Yesus kawimadaka.<verse eid="MRK 12:12" /></para>
  <para style="s">Ma ngale 'o balasitengi pofangu</para>
  <para style="r">(<ref loc="MAT 22:15-22">Mat. 22:15-22</ref>; <ref loc="LUK 20:20-26">Luk. 20:20-26</ref>)</para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 12:13" />'O Farisioka yamuruo naga de gee 'o Herodes wimote-moteke yamuruo naga yakisuloko 'o Yesusika wibole ma timi-timi de 'o sa-sano. <verse eid="MRK 12:13" /><verse number="14" style="v" sid="MRK 12:14" />'Ona yoboa 'o Yesusika de kayongosekau, &lt;&lt; 'Aba Guru, ngomi mianako ngona 'o nyawa 'iloa-loa moi, de ngona konosigisenuwa nago'ona bato manga di-dibangi. Ma ngona 'Aba nodotoko kanositi-tiaikau ma ngale ma Jo'oungu ma Dutu 'awi mau 'o nyawaka, sababu ngona konosikairi-irikuwa 'o nyawa. So bika nosidemo ngomino. Moteke to ngone nanga 'agama ma besesongo, kaidadi 'o balasitengi pofangu 'o Kaisarika bolo koidadiwa? Salingou pofangu 'o pajaki ge'ena bolo koidadiwa?&gt;&gt;<verse eid="MRK 12:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 12:15" />'O Yesus wanako to 'ona manga ngeluku ge'ena. So kawongosekau 'onaka, &lt;&lt; 'Ido'oa so niomau nitaili? Bika nisidumutino 'o pipi 'o saaka ngai moi.&gt;&gt;<verse eid="MRK 12:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 12:16" />So 'ona ya'asano 'o pipi 'o saaka ngai moi. So 'o Yesus wosano 'onaka, &lt;&lt;To nagu'una wi dulada de wi ronga ne'ena?&gt;&gt;</para>
  <para style="p" vid="MRK 12:16">De 'ona yosango, &lt;&lt;To Kaisar.&gt;&gt;<verse eid="MRK 12:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 12:17" />'O Yesus wongose, &lt;&lt;Nako koge'ena, niokula 'o Kaisarika 'okia naga gee to Kaisar de ma Jo'oungu ma Dutuka 'okia naga gee to ma Jo'oungu ma Dutu.&gt;&gt;</para>
  <para style="p" vid="MRK 12:17">'Ona yoherangi yo'isene 'awi sa-sango.<verse eid="MRK 12:17" /></para>
  <para style="s">Yosonge-songenokau yakisimomikoli</para>
  <para style="r">(<ref loc="MAT 22:23-33">Mat. 22:23-33</ref>; <ref loc="LUK 20:27-40">Luk. 20:27-40</ref>)</para>
  <para style="p">
    <verse number="18" style="v" sid="MRK 12:18" />'O Sadukioka yamuruo naga yaika 'o Yesusika. ('Ona ge'ena yongose 'ato 'o nyawa yosongenokau ge'ena dua koyomomikuawau.) <verse eid="MRK 12:18" /><verse number="19" style="v" sid="MRK 12:19" />'Ona kayongosekau, &lt;&lt; 'Aba Guru, 'o Musa wolefo to ngone nanga besesongo naneda: &lt;Nako 'o nauru wimoi wosongene 'ena wi ngowaka koi'iwa, ge'ena 'awi dodoto salingou womingaamoko 'o bao-bao<note caller="g" style="f"><char style="fr" closed="false">12:19: </char><char style="ft" closed="false">'O bao-bao ge'ena kaimatero de 'o ba-bao.</char></note> gumuna la 'o ngowaka yamake de 'o ngowaka ge'ena wisitesongo ma riaka wosonge-songene 'awi waata.&gt; <verse eid="MRK 12:19" /><verse number="20" style="v" sid="MRK 12:20" />'Idadiokau naga 'o riaka dodoto yatumudiingoka. 'O riaka womodokano 'awi ngowaka koi'iwasi de wosongenokau. <verse eid="MRK 12:20" /><verse number="21" style="v" sid="MRK 12:21" />Ge'enaka de ma dodotoli womimodoka 'o bao-bao gumuna, ma 'una mita 'awi ngowaka koi'iwasi de wosongenokau. Koge'ena mita 'idadi sigado yaruange, <verse eid="MRK 12:21" /><verse number="22" style="v" sid="MRK 12:22" />de 'isigila sigado yatumudiingi. De ma do-dogumuku 'o ngeweka gumuna mita mosongene. <verse eid="MRK 12:22" /><verse number="23" style="v" sid="MRK 12:23" />Gee ma 'orasi 'o nyawa yosonge-songenoka yomomiki, to nagu'una wi wekata 'o ngeweka gumuna? Sababu yatumudiingi go'ona yoodumu mingaamokokau!&gt;&gt;<verse eid="MRK 12:23" /></para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 12:24" />'O Yesus wosango, &lt;&lt;Ngini nia di-dibangi 'isowono ma sala. Sababu ngini koniasahewa 'o Buku 'Itebi-tebini de ma Jo'oungu ma Dutu 'awi kuasa. <verse eid="MRK 12:24" /><verse number="25" style="v" sid="MRK 12:25" />Sababu nako 'o nyawa yosonge-songenoka yomomikie, ge'ena koyongaamokuawau, ma dua 'ona yo'ahu 'isoka 'o mala'ekati 'o sorogaaka. <verse eid="MRK 12:25" /><verse number="26" style="v" sid="MRK 12:26" />De mita ma ngale 'o nyawa yosonge-songenoka yosimomikoli, koniabacawasi 'o Musa 'awi bukuoka gee 'o 'ubutu 'iluru-lurusu? Ge'ena dau ma bo-bulaka 'isilefoku ma Jo'oungu ma Dutu kawongosekau 'o Musaka, &lt;Ngoi ne'ena ma Jo'oungu ma Dutu gee 'o Abraham, 'o Ishak, de 'o Yakub 'isuba-suba.&gt; <verse eid="MRK 12:26" /><verse number="27" style="v" sid="MRK 12:27" />Ma Jo'oungu ma Dutu gu'una ge'ena koyosonge-songenuwa manga Jou. 'Una ge'ena 'o nyawa yo'ahu-'ahu wisuba-suba. Ngini nia di-dibangi 'isowono ma sala!&gt;&gt;<verse eid="MRK 12:27" /></para>
  <para style="s">'O besesongo ma lamo-lamo</para>
  <para style="r">(<ref loc="MAT 22:34-40">Mat. 22:34-40</ref>; <ref loc="LUK 10:25-28">Luk. 10:25-28</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 12:28" />Ge'enaka de 'o 'agamaka wodoto-dotoko wimoi waino wosigisene 'o Yesus de 'o Sadukioka yomabi-bicara. 'O 'agamaka wodoto-dotoko gu'una wolega-lega 'ena 'o Sadukioka manga bicara 'iodumu 'o Yesus wasangokau ma sureka, so 'una wosano 'o Yesusika, &lt;&lt; 'O besesongo 'iodumu ge'ena ka'ena 'ifoloi ma dekuoka?&gt;&gt;<verse eid="MRK 12:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 12:29" />'O Yesus wosango, &lt;&lt; 'O besesongo ma di-disiraka de ma dekuoka ge'ena la: &lt;Ee, Israel ma nyawa! Ma Jo'oungu ma Dutu gee powisuba-suba, 'una ge'ena ma Jou womatengo-tengoka. <verse eid="MRK 12:29" /><verse number="30" style="v" sid="MRK 12:30" />Winidora ma Jo'oungu ma Dutu gee winisuba-suba de nia singina ma gou-goungu, de nia 'ahu, de nia 'akali, de nia guata 'iodumu.&gt; <verse eid="MRK 12:30" /><verse number="31" style="v" sid="MRK 12:31" />'O besesongo modidi gee ma dekuokali ge'ena la: &lt;Niakidora 'o nyawaka 'isoka ngini ma sirete nimadora!&gt; Koi'iwau 'o besesongo 'iregu 'ifoloi 'idaduie de 'o besesongo ngai modidi ge'ena.&gt;&gt;<verse eid="MRK 12:31" /></para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 12:32" />Ge'enaka de 'o 'agamaka wodoto-dotoko gu'una kawongosekau 'o Yesusika, &lt;&lt;Posironga yadaenoka 'Aba Guru! Nongose 'ato ma Jouou gu'una ma Jo'oungu ma Dutu womatengo-tengoka, de koi'iwau 'o jo'oungu ma dutu 'iregu. <verse eid="MRK 12:32" /><verse number="33" style="v" sid="MRK 12:33" />De 'o nyawa salingou widora ma Jo'oungu ma Dutuka de manga singina ma gou-goungu, de manga 'akali de manga guata 'iodumu. De salingou yakidora 'o nyawaka, 'isoka 'onali ma sirete yomadora. Ge'ena 'ifoloi yaowa de gee yosisuba 'o su-suba yatuu-tuuku de 'o su-suba 'iregu-regu gee yosisuba ma Jo'oungu ma Dutuka.&gt;&gt;<verse eid="MRK 12:33" /></para>
  <para style="p">
    <verse number="34" style="v" sid="MRK 12:34" />'O Yesus wimake 'o 'agamaka wodoto-dotoko gu'una 'awi sa-sango 'ena ma sureka, de kawongosekau 'unaka, &lt;&lt;Ngona rekeni nowosangoka ma Jo'oungu ma Dutu 'awi pareteka.&gt;&gt;</para>
  <para style="p" vid="MRK 12:34">Ge'ena 'ipasa de komoiwau yomoroini yosano 'o Yesusika.<verse eid="MRK 12:34" /></para>
  <para style="s">Ma ngale 'o Koana 'o Nyawa Wosilaha-laha</para>
  <para style="r">(<ref loc="MAT 22:41-46">Mat. 22:41-46</ref>; <ref loc="LUK 20:41-44">Luk. 20:41-44</ref>)</para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 12:35" />'O Yesus wodotoko ma gu-gudaioka ma Jo'oungu ma Dutu 'awi Woa 'isure-sureka de wosano, &lt;&lt;Kokia so 'o 'agamaka yodoto-dotoko yongose 'ato ma Koana Wosilaha-laha ge'ena 'awi 'asali 'o Dautino? <verse eid="MRK 12:35" /><verse number="36" style="v" sid="MRK 12:36" />'Ena momongo 'o Dautu ma sirete 'o Ngomasa 'Itebi-tebini wikuasano so kawongosekau,</para>
  <para style="q1" vid="MRK 12:36">&lt;Ma Jou wongose 'ai Jouka:</para>
  <para style="q2" vid="MRK 12:36">Tonigoraka nodadi Koana la nopareta de de ngoi,</para>
  <para style="q1" vid="MRK 12:36">sigado nisa-saturuu takidiai yo'isene ngonaka.&gt;<verse eid="MRK 12:36" /></para>
  <para style="m">
    <verse number="37" style="v" sid="MRK 12:37" />So nako 'o Dautu ma Koana wosilaha-lahaka wisironga &lt; 'Ai Jou&gt;, kokia so 'una 'awi 'asali 'o Dautino?&gt;&gt; 'O nyawa manga gudai yoduaka ma sala yosigisene to 'una 'awi do-dotoko.<verse eid="MRK 12:37" /></para>
  <para style="s">'Inasinganono la pomasitiari 'o 'agamaka yodoto-dotoika</para>
  <para style="r">(<ref loc="MAT 23:1-36">Mat. 23:1-36</ref>; <ref loc="LUK 20:45-47">Luk. 20:45-47</ref>)</para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 12:38" />De 'una wodotokoli 'onaka wongose 'ato, &lt;&lt;Nimasitiari 'o 'agamaka yodoto-dotoika. 'Ona yoduaka yotagi-tagi de manga juba 'ikaku-kakuruku yomasinoaku de yoduaka yakihoromati 'o pasarioka. <verse eid="MRK 12:38" /><verse number="39" style="v" sid="MRK 12:39" />'Ona yoduaka yogogere ma bionuku nako 'o lo-lomu ma woaka bolo 'o rameka la 'o nyawa yakimake. <verse eid="MRK 12:39" /><verse number="40" style="v" sid="MRK 12:40" />'Ona yakisihaga 'o bao-baoka, de yakikaeluku so manga woa ma ya'oraka. Ma ngale yomadidumu manga di-diai 'ito-torou ge'ena, 'ona yolahidoa yato-to'ingoka. To 'ona manga hukumani dua 'itubuso!&gt;&gt;<verse eid="MRK 12:40" /></para>
  <para style="s">'O bao-bao mimoi 'ami sadakaa</para>
  <para style="r">(<ref loc="LUK 21:1-4">Luk. 21:1-4</ref>)</para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 12:41" />Gee 'o Yesus wogogeruku 'o su-suba ma ngiiku ma dateoka ma Jo'oungu ma Dutu 'awi Woa 'isure-sureka, de wolega-lega 'o nyawa 'o pipi yodonoa ge'ena ma ngiiku. Manga gudai yokaya-kaya 'o pipi yodonoa ma amoko. <verse eid="MRK 12:41" /><verse number="42" style="v" sid="MRK 12:42" />Ge'enaka 'o bao-bao mimoi mosusa-susa mita moboa. Muna mita maino 'ami su-suba mo'otaka, sioko mi pipi ge'ena ka 'o gobangi modidioka so ma ngale ka ma etaka. <verse eid="MRK 12:42" /><verse number="43" style="v" sid="MRK 12:43" />So 'o Yesus wi do-domoteke waki'asokino de kawongosekau 'onaka, &lt;&lt;Niolega-lega ne'ena: 'O bao-bao mosusa-susa gumuna 'ifoloi 'iamoko modonoa 'o petiku nako posikatero de 'iregu-regu yoodumu. <verse eid="MRK 12:43" /><verse number="44" style="v" sid="MRK 12:44" />Sababu 'ona yokula ge'ena manga harataa 'ifoloiku. Ma 'o bao-bao gumuna ngaro mosaigalere ma sala, ma gee munaka 'iodumu mosidukulaka -- 'ena ge'enau maparaluu ma ngale mi 'ahu.&gt;&gt;<verse eid="MRK 12:44" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 12" />
  <chapter number="13" style="c" sid="MRK 13" />
  <para style="s">'O Yesus wobi-bicara ma ngale ma Jou 'awi Woa 'ipiakoro</para>
  <para style="r">(<ref loc="MAT 24:1-2">Mat. 24:1-2</ref>; <ref loc="LUK 21:5-6">Luk. 21:5-6</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 13:1" />Gee 'o Yesus womagoraka ma Jou 'awi Woaka, de 'awi do-domoteke wimoi kawongosekau, &lt;&lt; 'Aba Guru, bika nakokilega ma Jo'oungu ma Dutu 'awi Woa ne'ena, de nalega nosidi-diai ma teto 'isikaretene, tei de kaisureli so!&gt;&gt;<verse eid="MRK 13:1" /></para>
  <para style="p">
    <verse number="2" style="v" sid="MRK 13:2" />'O Yesus wosango, &lt;&lt;Ngona namakekau ma woa 'isure-sure ge'ena! Ma dua 'o woa ge'ena ma teto ka 'o ngai moi ma kaimakareteniewau. 'Iodumu 'asa 'iturukaka.&gt;&gt;<verse eid="MRK 13:2" /></para>
  <para style="s">'O susa de 'o badingaka</para>
  <para style="r">(<ref loc="MAT 24:3-14">Mat. 24:3-14</ref>; <ref loc="LUK 21:7-19">Luk. 21:7-19</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 13:3" />Ge'enaka de 'o Yesus wotagi 'o Zaitun ma gigieka de wogogerie ma dekuoka gee 'imasidaarino de ma Jo'oungu ma Dutu wi Woa. De 'o Petrus, 'o Yohanes, 'o Yakobus de 'o Andreas yaika 'unaka ma ngale yomabi-bicara ka 'ona duga. <verse eid="MRK 13:3" /><verse number="4" style="v" sid="MRK 13:4" />'Ona kayongosekau 'unaka, &lt;&lt; 'Aba, bika minisidemo muruoka de 'iodumu gee nongose-ngosekau ge'ena 'idadi. De minisidumutu ma no-nako 'okia nako ma 'orasi ya'adonokau.&gt;&gt;<verse eid="MRK 13:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 13:5" />'O Yesus wosango, &lt;&lt;Nimasitiari, 'uwa sigado 'o nyawa nisihaga. <verse eid="MRK 13:5" /><verse number="6" style="v" sid="MRK 13:6" />'O nyawa manga gudai dua yoboa yopake 'ai ronga de yongose, &lt;Ngoi ne'ena 'unau!&gt; Ge'enaka de yakisihaga 'o nyawa manga gudai. <verse eid="MRK 13:6" /><verse number="7" style="v" sid="MRK 13:7" />So nako la nio'isene 'o nyawa yokoya de yoto-tora sababu 'o gudoti bolo 'o gudoti ma habari, 'uwa nimodongo. Ma hali ge'ena salingou 'idadi, ma ge'ena ko ma ngalewa 'ato 'o dunia ma do-dogumu ma 'orasi ya'adonokau. <verse eid="MRK 13:7" /><verse number="8" style="v" sid="MRK 13:8" />'O suku de 'o suku, 'o negara de 'o negara 'asa 'imakakudoti. Kiaka naga bato 'asa 'idadi 'o 'osu de 'o baulaco. 'Iodumu ge'ena 'asa ka ma gurue, 'isoka 'o ngeweka mimoi 'ikurue mosiri ma ngale momaku'arenou.<verse eid="MRK 13:8" /></para>
  <para style="p">
    <verse number="9" style="v" sid="MRK 13:9" />Ngini salingou nimasitiari sababu ngini dua nitagoko de ni'asa 'o 'agama ma balu-balusika. Ngini 'asa nipesana 'o lo-lomu ma woa-woaka. De ngini 'asa nisitaari yopa-paretaka de 'o koa-koanika sababu ngini to ngoi 'ai do-domoteke. De ge'enau to ngini nia 'orasi ma ngale ngoi nisisakisii 'onaka. <verse eid="MRK 13:9" /><verse number="10" style="v" sid="MRK 13:10" />Ma 'o Habari ma Owa ma Jo'oungu ma Dutuno salingou 'isidagiokasi 'isira 'o soana 'iodumika. <verse eid="MRK 13:10" /><verse number="11" style="v" sid="MRK 13:11" />De nako ngini nitagoko de ni'asa 'o hakimika, 'uwa nimodongo ma ngale 'okia salingou ngini niosango. Nako ma 'orasiou niobicara, kaniosidemo 'okia naga gee nisidemoka 'o Ngomasa 'Itebi-tebini ma 'orasi ya'adono de. Sababu 'o demo-demo gee ngini niosibicara ge'ena ko to nginiwa ma sirete 'ania demo-demo, so 'ena 'iboa 'o Ngomasa 'Itebi-tebinino. <verse eid="MRK 13:11" /><verse number="12" style="v" sid="MRK 13:12" />'O nyawa manga dodoto ma dutu 'asa yakikada'akali la yakito'oma. Koge'enali mita 'asa 'idadi 'o dea de 'o ngowaoka. 'O ngowa-ngowaka 'asa yakilawani manga dea de manga 'esaka, de yakisisarakani 'o nyawaka la yakito'oma. <verse eid="MRK 13:12" /><verse number="13" style="v" sid="MRK 13:13" />Ngini 'asa 'o nyawa 'iodumu nidu'uduku sababu ngini to ngoi 'ai do-domoteke. Duga nago'ona yotongosono sigado ma do-dogumika, 'ona ge'ena 'asa yakisilaha.&gt;&gt;<verse eid="MRK 13:13" /></para>
  <para style="s">'O Dorou 'Isiba-bahaya</para>
  <para style="r">(<ref loc="MAT 24:15-28">Mat. 24:15-28</ref>; <ref loc="LUK 21:20-24">Luk. 21:20-24</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 13:14" />&lt;&lt;Ngini 'asa niamake &lt; 'O Dorou gee 'Isito-torou&gt; 'ima'okode 'o ngii gee koisidabi-dabiwa 'enaka. ('Isidemo yobaca-bacaka: Nialega ma diai 'okia ma ngale!) Ma 'orasi ge'ena 'o nyawa gee 'o Yudeaka salingou yoowara 'o gigiede. <verse eid="MRK 13:14" /><verse number="15" style="v" sid="MRK 13:15" />So 'o nyawa daku manga woa ma dekuoka 'uwa yo'uti dau manga woa ma dodaku ma ngale manga kianikia ya'ese. <verse eid="MRK 13:15" /><verse number="16" style="v" sid="MRK 13:16" />'O nyawa gee naga 'o bairoka 'uwa yolio manga baju ya'ese. <verse eid="MRK 13:16" /><verse number="17" style="v" sid="MRK 13:17" />Ge'ena ma wange posironga manga 'alu 'itongaka 'o nge-ngeweka gee yotu-tubusou de gee manga ngowaka kayasusuosi! <verse eid="MRK 13:17" /><verse number="18" style="v" sid="MRK 13:18" />Nimalahidoa la ge'ena 'uwa 'idadi ma 'orasi 'o besa-besaka. <verse eid="MRK 13:18" /><verse number="19" style="v" sid="MRK 13:19" />Ma 'orasi ge'ena 'asa 'idadi 'o sangisara gee koma'iwasi 'idadi ka ma 'orasi ma Jo'oungu ma Dutu 'o dunia wosidadi sigado ne'ena, de mita dua koidadiwau. <verse eid="MRK 13:19" /><verse number="20" style="v" sid="MRK 13:20" />Nako 'iso ma Jo'oungu ma Dutu kowositipokowa 'o sangisara ma 'orasi ge'ena, tanu 'o nyawa komoiwa yakisilaha. Ma ngano 'awi 'umati, so wositipoko ma 'orasi ge'ena.<verse eid="MRK 13:20" /></para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 13:21" />Ma 'orasi ge'ena nako 'o nyawa yongose nginika, &lt;Ee, 'o Koana 'o Nyawa Wosilaha-laha ma Jo'oungu ma Dutu Wiiri-iriki, 'una nongoka!&gt; Bolo, &lt; 'Una ge'enaka!&gt; Ge'ena 'uwa niakingaku 'o nyawa go'ona. <verse eid="MRK 13:21" /><verse number="22" style="v" sid="MRK 13:22" />Sababu 'o nyawa yosilaha-laha ma ngeluku de 'o nabii ma ngeluku 'asa yoboa. 'Ona 'asa yodiai 'o hali 'ila-laagomo de 'o no-nako 'ihera-herangi ma ngale yosiliba nako ya'akunu, ma Jo'oungu ma Dutu 'awi 'umati mita. <verse eid="MRK 13:22" /><verse number="23" style="v" sid="MRK 13:23" />So salingou nimasitiari yaowa, 'iodumu ge'ena tinisidemokau koidadiwasi 'ena!&gt;&gt;<verse eid="MRK 13:23" /></para>
  <para style="s">'O Nyawa ma Ngowaka woboali</para>
  <para style="r">(<ref loc="MAT 24:29-31">Mat. 24:29-31</ref>; <ref loc="LUK 21:25-28">Luk. 21:25-28</ref>)</para>
  <para style="p">
    <verse number="24" style="v" sid="MRK 13:24" />&lt;&lt; 'O sangisara ma 'orasi 'ipasaka, 'o wange ma ako 'asa 'itarusu, de 'o mede koisiwaruawau. <verse eid="MRK 13:24" /><verse number="25" style="v" sid="MRK 13:25" />'O sagala ngoma 'asa 'itotaka daku 'o diwanguku, de 'o ngawa-ngawaka ma pareta 'asa 'iruahe. <verse eid="MRK 13:25" /><verse number="26" style="v" sid="MRK 13:26" />Ma 'orasi ge'ena dua ngoi 'o Nyawa ma Ngowaka 'imake toboa 'o kakamoro ma dodaka de 'ai kuasa ma amoko de 'ai kumati. <verse eid="MRK 13:26" /><verse number="27" style="v" sid="MRK 13:27" />'Una 'asa wasuloko 'awi mala'ekatika yakitoomu 'o nyawa wakiiri-iriki kiano naga bato 'o duniaka 'iodumu.&gt;&gt;<verse eid="MRK 13:27" /></para>
  <para style="s">'O do-dotoko 'o 'ara ma gotano</para>
  <para style="r">(<ref loc="MAT 24:32-35">Mat. 24:32-35</ref>; <ref loc="LUK 21:29-33">Luk. 21:29-33</ref>)</para>
  <para style="p">
    <verse number="28" style="v" sid="MRK 13:28" />&lt;&lt;Nia'ese 'o do-dotoko 'o 'ara ma gotano. Nako ma sago-sago 'iboboko de 'ito'ori, ngini nianako 'ato 'o ngogoro ma 'orasi 'isoriokau. <verse eid="MRK 13:28" /><verse number="29" style="v" sid="MRK 13:29" />Koge'enali mita nako ngini niamake 'o susa de 'o sangisara gee tosidemo-demokau 'iodumu la 'idadi, ge'ena ngini 'asa nianako ma 'orasi ge'ena 'isori ma foloiokau. <verse eid="MRK 13:29" /><verse number="30" style="v" sid="MRK 13:30" />Tinisidemo! Ma hali ge'ena 'idadi dua gee 'o nyawa yo'ahu-'ahu ma 'orasi ne'ena koyobootuawasi yosongene. <verse eid="MRK 13:30" /><verse number="31" style="v" sid="MRK 13:31" />'O diwanga de 'o dunia 'asa 'iisanga, ma 'ai demo-demo dua kaisi'ado-'adonika.&gt;&gt;<verse eid="MRK 13:31" /></para>
  <para style="s">Komoiwa yosikanako ma wange de ma takoro</para>
  <para style="r">(<ref loc="MAT 24:36-44">Mat. 24:36-44</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 13:32" />&lt;&lt;Ngaro koge'ena ma, ka moi ma koyanakowa to ngoi 'ai bo-boa ma wange bolo ma 'orasi. 'O mala'ekati 'o sorogaaka mita koyanakowa, de ngoi ma Jo'oungu ma Dutu 'awi Ngowaka ma sirete mita kotanakowa, ka 'ai Dea duga wanako. <verse eid="MRK 13:32" /><verse number="33" style="v" sid="MRK 13:33" />So salingou niongano-nganono de nimasitiari sababu ngini koniosidongoowa muruoka toboa. <verse eid="MRK 13:33" /><verse number="34" style="v" sid="MRK 13:34" />Ge'ena 'isi'ade-'ade 'isoka 'o nyawa wimoi wi woaka wamada de wotagi 'o daeraa 'ikuru-kurutika. 'Una 'awi ro-riwoka wakisuloko wi woa yojaga, de wakikula to 'ona moi-moi manga manarama. Gee 'o ngorana ma ja-jagaka wobesesongo 'ato wojaga wosidi-diai. <verse eid="MRK 13:34" /><verse number="35" style="v" sid="MRK 13:35" />So ngini salingou nimajaga-jaga, sababu ngini konianakokawa muruoka de 'o woa ma dutu gu'una woboa. Poilia 'o wange maata, bolo 'o utu gorona, bolo 'isori 'ibibini, bolo 'o ngoru-ngorumika. <verse eid="MRK 13:35" /><verse number="36" style="v" sid="MRK 13:36" />'Uwa sigado 'una woboa kawomasoobotino 'ena ngini nionisuoka. <verse eid="MRK 13:36" /><verse number="37" style="v" sid="MRK 13:37" />'Okia naga gee tosidemo nginika, tosidemo mita 'o nyawa 'iodumika: Nimajaga-jaga!&gt;&gt;<verse eid="MRK 13:37" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 13" />
  <chapter number="14" style="c" sid="MRK 14" />
  <para style="s">Manga singina 'itorou 'o Yesusika</para>
  <para style="r">(<ref loc="MAT 26:1-5">Mat. 26:1-5</ref>; <ref loc="LUK 22:1-2">Luk. 22:1-2</ref>; <ref loc="JHN 11:45-53">Yoh. 11:45-53</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 14:1" />'O wange modidiosi de 'o Israeloka Yakisisupu ma Wange ma Amoko, de 'o Roti Koiragi-ragiwa ma Rame. 'O 'imam ma saeke de 'o 'agamaka yodoto-dotoko 'o ngekomo yononu la 'o Yesus witagoko de wito'oma kayomasibongonino. <verse eid="MRK 14:1" /><verse number="2" style="v" sid="MRK 14:2" />Duga 'ona yongose 'ato, &lt;&lt;Ma 'uwa podiai 'o rame ma 'orasuku, sababu dua 'iruahe.&gt;&gt;<verse eid="MRK 14:2" /></para>
  <para style="s">'O Yesus 'o goooro ma bounu yaowa-owa widarisi</para>
  <para style="r">(<ref loc="MAT 26:6-13">Mat. 26:6-13</ref>; <ref loc="JHN 12:1-8">Yoh. 12:1-8</ref>)</para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 14:3" />Ma 'orasi 'o Yesus 'o Betania ma soanoka 'o Simon wi woaka gee ma sira wi panyake 'isoka 'o pado, de 'o ngeweka mimoi maino 'o goooro ma bounu 'isure-sure de 'ihali-hali 'o botoli moi mo'asa. 'O goooro ge'ena 'o gota ma ngutuku ma bounu yaowa-owa yadiaiku. Gee 'o Yesus wogogeruku wo'odomo ma gu-gudaioka de ma botoli ma tomarino ma'ogu so ma goooro ge'ena modarisi 'o Yesus wi saeuku. <verse eid="MRK 14:3" /><verse number="4" style="v" sid="MRK 14:4" />'O nyawa yamuruo naga ge'enaka dau yakito'otasa so yomakadongose moi de moi, &lt;&lt; 'Okia ma ngale 'o goooro ma bounu 'isure-sure ge'ena ma halebiru? <verse eid="MRK 14:4" /><verse number="5" style="v" sid="MRK 14:5" />'O goooro ge'ena nako la mawukunu ge'ena ma 'ija 'o saaka 'o ratusu sa'ange 'ipailoka, de ma pipi 'o nyawa yosusa-susaka makikula.&gt;&gt; So 'ona yongamo munaka.<verse eid="MRK 14:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 14:6" />Ma 'o Yesus kawongosekau, &lt;&lt;Minimadaka! 'Ido'oa so 'ami singina niasusa? Muna modiai 'isure-sure ngoino. <verse eid="MRK 14:6" /><verse number="7" style="v" sid="MRK 14:7" />'O nyawa yosusa-susa naga kaitaurika de de ngini. So nako niomau, de 'idadi niakiriwo 'o 'orasi 'isinoimi. Ma ngoi koisi'ado-'adonikawa de de ngini. <verse eid="MRK 14:7" /><verse number="8" style="v" sid="MRK 14:8" />'O ngeweka gumuna modiaiokau 'okia naga gee muna ma'akunu madiai. Muna moidudu-duangou 'o goooro ma bounu yaowa-owa ma ngale 'ipo'osuku, ngaro ma 'orasi koya'adonuawasi ma. <verse eid="MRK 14:8" /><verse number="9" style="v" sid="MRK 14:9" />Tinisidemo ne'ena, 'o duniaka ne'ena gee kiaka naga bato 'o Habari ma Owa ma Jo'oungu ma Dutuno 'isitotara, 'o ngeweka numuna 'ami di-diai dua 'asa kayosija-jarita mita, de kamingano-nganono.&gt;&gt;<verse eid="MRK 14:9" /></para>
  <para style="s">'O Yudas wosimoteke 'o Yesus wibadingaka</para>
  <para style="r">(<ref loc="MAT 26:14-16">Mat. 26:14-16</ref>; <ref loc="LUK 22:3-6">Luk. 22:3-6</ref>)</para>
  <para style="p">
    <verse number="10" style="v" sid="MRK 14:10" />Ge'enaka de 'o Yudas Iskariot gee 'o Yesus 'awi do-domoteke yamogiooko de modidino wimoi, wi singina 'itorou so wotagi 'o 'imam ma sae-saekika la wosidemo ma ngale 'o Yesus wiwukunu. <verse eid="MRK 14:10" /><verse number="11" style="v" sid="MRK 14:11" />So 'ona ka manga morenoka de yojaji 'o pipi yokula 'o Yudasika. So 'o Yudas mita wokurue wononu 'o 'orasi yaowa-owa ma ngale wiwukunu 'o Yesus.<verse eid="MRK 14:11" /></para>
  <para style="s">'O Yesus de 'awi do-domoteke yo'odomo Wakisisupu ma Wange ma Amoko ma ngodomo</para>
  <para style="r">(<ref loc="MAT 26:17-25">Mat. 26:17-25</ref>; <ref loc="LUK 22:7-14">Luk. 22:7-14</ref>, <ref loc="LUK 21-23">21-23</ref>; <ref loc="JHN 13:21-30">Yoh. 13:21-30</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 14:12" />Ma wange ma di-disiraka 'o Roti Koiragi-ragiwa ma Rame, ma 'orasi ge'ena Wakisisupu ma Wange ma domba yotoaka. 'O Yesus 'awi do-domoteke yosano 'unaka, &lt;&lt; 'Aba, kiaka ngona nomau ngomi miosidaoto 'o 'inomo ma ngale Wakisisupu ma Wange ma ngodomo?&gt;&gt;<verse eid="MRK 14:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 14:13" />Ge'enaka de 'o Yesus wi do-domoteke yamididi wakisuloko, &lt;&lt;Niotagi dokaika 'o soanika, dua nimakadaene de wimoi 'o botoli de ma 'akeroka wo'asa. Winimoteke 'unaka <verse eid="MRK 14:13" /><verse number="14" style="v" sid="MRK 14:14" />'o woa kiaka naga gee wodongosama de niosidemo ma woa ge'ena ma dutuka, &lt;Ma 'Aba Guru wosano, kiaka ma ngii 'una de 'awi do-domoteke dua mio'odomo Wakisisupu ma Wange ma ngodomo?&gt; <verse eid="MRK 14:14" /><verse number="15" style="v" sid="MRK 14:15" />Ma woa ma dutu 'asa winisidumutu 'o ngii moi 'ingoa-ngoatika 'o lotengoka. 'O ngii ge'ena 'isi'aturu 'idua-duangou, de ma kia sonaa 'iodumu 'itoto-totomo. Ge'enakau doka ninasidaoto ngone poodumu.&gt;&gt;<verse eid="MRK 14:15" /></para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 14:16" />Ge'enaka de 'o Yesus 'awi do-domoteke yamididi go'ona yotagi 'o soanika doka, kadoka de yakokimake 'isoka 'o Yesus wosidemo-demokau. So 'ona mita yosidaoto Wakisisupu ma Wange ma ngodomo ge'ena.<verse eid="MRK 14:16" /></para>
  <para style="p">
    <verse number="17" style="v" sid="MRK 14:17" />'Iobiruku de 'o Yesus de 'awi do-domoteke yamogiooko de modidi yaika. <verse eid="MRK 14:17" /><verse number="18" style="v" sid="MRK 14:18" />De gee yogogerie yo'odomo de 'o Yesus wongoseu, &lt;&lt;Tinisidemo ne'ena: Nginioka naga wimoi gee mimari'odomuku de de ngoi dua 'asa woiwukunu.&gt;&gt;<verse eid="MRK 14:18" /></para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 14:19" />'O Yesus 'awi do-domoteke yogi'isenoka 'o demo ge'ena de manga singina 'isusa so moi-moi yomadasano 'o Yesusika, &lt;&lt; 'Aba, 'ani dumutu ko ngoinowa?&gt;&gt;<verse eid="MRK 14:19" /></para>
  <para style="p">
    <verse number="20" style="v" sid="MRK 14:20" />'O Yesus wosango, &lt;&lt; 'Una ge'ena naga ngini nimogiooko de modidi nia sigoronaka, gee wi roti wositubuku 'ai sawokuku. <verse eid="MRK 14:20" /><verse number="21" style="v" sid="MRK 14:21" />Ma gou-goungu ngoi 'o Nyawa ma Ngowaka 'asa tosongene 'isoka kokia naga 'isilefokau 'o Buku 'Itebi-tebini ma dodaka. Duga posironga wotorouoka nagu'una gee woiwuku-wukunu ngoi 'o Nyawa ma Ngowaka ne'ena! 'Ifoloi yaowa nako 'o nyawa gu'una koma'iwa wisingowauku!&gt;&gt;<verse eid="MRK 14:21" /></para>
  <para style="s">Ma Jou 'awi Ngodomo 'Itebi-tebini</para>
  <para style="r">(<ref loc="MAT 26:26-30">Mat. 26:26-30</ref>; <ref loc="LUK 22:14-20">Luk. 22:14-20</ref>; <ref loc="1CO 11:23-25">1Kor. 11:23-25</ref>)</para>
  <para style="p">
    <verse number="22" style="v" sid="MRK 14:22" />Gee 'ona yo'odomo ma gu-gudaioka de 'o Yesus 'o roti wa'ese de wosilahidoa ma Jo'oungu ma Dutude. Ge'enaka de ma roti ge'ena wapela-pelaka de wi giama, deika 'awi do-domoteika wakisibula de kawongosekau, &lt;&lt;Nia'ese de nia'odomo, ne'ena to ngoi 'ai roese.&gt;&gt;<verse eid="MRK 14:22" /></para>
  <para style="p">
    <verse number="23" style="v" sid="MRK 14:23" />Ge'ena 'iduanga de wa'ese 'o 'anggur ma sawoko, de wolahidoa ma Jo'oungu ma Dutude 'asa de ma sawoko ge'ena wokula 'awi do-domoteika. Ge'enaka de 'ona yoodumu ya'okere ma 'anggur ge'ena. <verse eid="MRK 14:23" /><verse number="24" style="v" sid="MRK 14:24" />Ya'okeroka de 'o Yesus kawongosekau, &lt;&lt;Ne'ena ge'ena to ngoi 'ai 'aunu gee 'isitatapu ma Jo'oungu ma Dutu 'awi jaji. 'O 'aunu gee 'ipoa ma ngale 'o nyawa manga gudai manga sowono yatuusu. <verse eid="MRK 14:24" /><verse number="25" style="v" sid="MRK 14:25" />Tinisidemo: Ngoi dua kota'okeruawau 'o 'anggur ne'ena, sigado dua ngoi de de ngini pa'okere 'o 'anggur ma sungi 'ai Dea 'awi pareta ma sigoronaka.&gt;&gt;<verse eid="MRK 14:25" /></para>
  <para style="p">
    <verse number="26" style="v" sid="MRK 14:26" />Ge'enaka de 'ona yonyanyi wisiarene ma Jo'oungu ma Dutuka, so 'iduanga de yosupu yosikaika 'o Zaitun ma gigieka.<verse eid="MRK 14:26" /></para>
  <para style="s">'O Yesus wosidemo dua 'o Petrus womadidumu</para>
  <para style="r">(<ref loc="MAT 26:31-35">Mat. 26:31-35</ref>; <ref loc="LUK 22:31-34">Luk. 22:31-34</ref>; <ref loc="JHN 13:36-38">Yoh. 13:36-38</ref>)</para>
  <para style="p">
    <verse number="27" style="v" sid="MRK 14:27" />Ge'enaka yaika de 'o Yesus wongose 'awi do-domoteika, &lt;&lt;Ngini nioodumu ne'ena dua nia ngo-ngaku 'iruahe so dua nisidamadaku. Sababu naga 'o Buku 'Itebi-tebini ma dodaka 'isilefoku, &lt;Ma Jo'oungu ma Dutu 'asa wapesana 'awi domba ma so-sowohi, so ma domba ge'ena 'iowara 'imakati-tingaoka.&gt; <verse eid="MRK 14:27" /><verse number="28" style="v" sid="MRK 14:28" />Ma gee dua tomomikieli, ngoi 'asa tomatisirakau de ngini 'o Galileaka.&gt;&gt;<verse eid="MRK 14:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 14:29" />De 'o Petrus kawongosekau, &lt;&lt;Ngaro 'ai ma-manai 'ona nidoowara 'Aba, ma ngoi dua ka ma eta ma ko'uwa.&gt;&gt;<verse eid="MRK 14:29" /></para>
  <para style="p">
    <verse number="30" style="v" sid="MRK 14:30" />De 'o Yesus wongose 'o Petrusika, &lt;&lt;Nomasisingina! 'O obiri ne'ena 'o namoro 'isorene ko ma modidiwasi 'ena nomadidumu ma gilio ma sa'angeu nongose 'ato konoinakowa!&gt;&gt;<verse eid="MRK 14:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 14:31" />'O Petrus wosango, &lt;&lt;Ngaro ngoi tosongene de de ngona, ma dua ngoi kotongosewa 'ato kotoninakowa 'Aba!&gt;&gt;</para>
  <para style="p" vid="MRK 14:31">De 'o do-domoteke 'iregu mita koge'ena yongose.<verse eid="MRK 14:31" /></para>
  <para style="s">'O Yesus womalahidoa 'o Getsemani ma bairoka</para>
  <para style="r">(<ref loc="MAT 26:36-46">Mat. 26:36-46</ref>; <ref loc="LUK 22:39-46">Luk. 22:39-46</ref>)</para>
  <para style="p">
    <verse number="32" style="v" sid="MRK 14:32" />'Ona ya'adonika 'o bairi moioka ma ronga 'o Getsemani, de 'o Yesus kawongosekau 'awi do-domoteika, &lt;&lt;Niogogerukosi ne'enaka ngoi totagi tomalahidoasi.&gt;&gt;<verse eid="MRK 14:32" /></para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 14:33" />De 'o Yesus wakisigaro 'o Petrus de 'o Yakobus de 'o Yohanes yotagi de de 'una. De 'una wamao wi singina 'isusa de wi 'alu 'itonga. <verse eid="MRK 14:33" /><verse number="34" style="v" sid="MRK 14:34" />Ge'enaka de kawongosekau 'onaka, &lt;&lt; 'Ai singina 'isusa ma sala, tamao 'isoka tosongenou. Ngini ne'enaka ne'enakasi de nimajaga-jaga.&gt;&gt;<verse eid="MRK 14:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 14:35" />'O Yesus womatingaika ma etasi 'ikurutika de 'o tonaoka womabukuku de womalahidoa. 'Awi lahidoa ma dodaka, woga'asoko nako 'idadi de 'o sangisara ma 'orasi ne'ena 'uwa wisidaene. <verse eid="MRK 14:35" /><verse number="36" style="v" sid="MRK 14:36" />De wongose, &lt;&lt;Ee 'Aba, ma ngale ngona, 'Aba, ko 'okiawa moi koidadiwa. Noisipidili 'o sangisara ne'ena. Ma 'uwa namoteke to ngoi 'ai singina ma mau, ma moteke to ngona 'Aba 'ani singina ma mau.&gt;&gt;<verse eid="MRK 14:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 14:37" />Ge'enaka de 'o Yesus wainoli 'ena 'ona yonisuoka de kawongose 'o Petrusika, &lt;&lt;Ee Simon, noma'iduoka? Ka 'o takoro moi ma konia'akunuawa niomajaga?&gt;&gt; <verse eid="MRK 14:37" /><verse number="38" style="v" sid="MRK 14:38" />Ge'enaka de 'o Yesus kawongosekau 'onaka, &lt;&lt;Nimajaga-jaga de nimalahidoa la 'uwa nitaili. Ma goungu ngini nia singinaka niomau niadiai yaowa, ma ngini niolamahani.&gt;&gt;<verse eid="MRK 14:38" /></para>
  <para style="p">
    <verse number="39" style="v" sid="MRK 14:39" />'O Yesus ma moioli wotagi womalahidoa ma betongo ka koge'enali. <verse eid="MRK 14:39" /><verse number="40" style="v" sid="MRK 14:40" />'Iduanga de waino 'awi do-domotekino 'ena 'ona kayoma'iduokasi sababu 'ona kaifoloi yonisuku. So 'ona koyosimakewa 'okia salingou yongose 'o Yesusika.<verse eid="MRK 14:40" /></para>
  <para style="p">
    <verse number="41" style="v" sid="MRK 14:41" />Gee 'o Yesus wainoli 'onano ma sa'angeu, de kawongosekau, &lt;&lt;Kanima'iduosi de kanimaomasosi? Yaowakau! Ma 'orasi ya'adonokau, ngoi 'o Nyawa ma Ngowaka 'idukula 'o nyawa yosowo-sowono manga giama ma soatika. <verse eid="MRK 14:41" /><verse number="42" style="v" sid="MRK 14:42" />Niomomikieu, nou potagiou. Winimake, 'o nyawa gee woiwuku-wukunu woboakau!&gt;&gt;<verse eid="MRK 14:42" /></para>
  <para style="s">'O Yesus witagoko</para>
  <para style="r">(<ref loc="MAT 26:47-56">Mat. 26:47-56</ref>; <ref loc="LUK 22:47-53">Luk. 22:47-53</ref>; <ref loc="JHN 18:3-12">Yoh. 18:3-12</ref>)</para>
  <para style="p">
    <verse number="43" style="v" sid="MRK 14:43" />'O Yesus kawobicarasi, de 'o Yudas woboa. 'O Yudas ge'ena 'o Yesus 'awi do-domoteke gee yamogiooko de modidino wimoi. Manga gudai mita yomasidoboa de 'o Yudas, yo'asa 'o samarangi de 'o be-besana. 'Ona yoboa sababu 'o 'imam ma sae-saeke de 'o 'agamaka yodoto-dotoko de 'o Yahudioka ma balu-balusu yakisuloko. <verse eid="MRK 14:43" /><verse number="44" style="v" sid="MRK 14:44" />'O nyawa gee 'o Yesus wisisa-sarakani<note caller="h" style="f"><char style="fr" closed="false">14:44: </char><char style="ft" closed="false">'O nyawa gee 'o Yesus wisisa-sarakani ge'ena la 'o Yudas.</char></note> wakisidemokau 'ato, &lt;&lt; 'O nyawa gee towiame, ge'ena gu'unau, so winitagoko de wini'asa winijaga niosidi-diai!&gt;&gt;<verse eid="MRK 14:44" /></para>
  <para style="p">
    <verse number="45" style="v" sid="MRK 14:45" />'O Yudas woboa de kawogila-gilaka 'o Yesusika de kawongosekau, &lt;&lt; 'Aba Guru!&gt;&gt; Deika wiame 'o Yesusika. <verse eid="MRK 14:45" /><verse number="46" style="v" sid="MRK 14:46" />Ge'enaka de 'o nyawa-nyawa gee yomasido-doboa de 'o Yudas, 'o Yesus witagoko de wipusuku. <verse eid="MRK 14:46" /><verse number="47" style="v" sid="MRK 14:47" />Ma ge'enaka dau wimoi 'awi wase ma sarumoka watobaka de wo'oto ma 'Imam ma Amoko 'awi ro-riwoka so wi ngauku ma watoaoka. <verse eid="MRK 14:47" /><verse number="48" style="v" sid="MRK 14:48" />Ge'enaka de 'o Yesus wongose 'onaka, &lt;&lt;Ngoi ne'ena toti-tingkai? so ngini nioboa nidagasa 'o samarangi de 'o be-besana la nitagoko? <verse eid="MRK 14:48" /><verse number="49" style="v" sid="MRK 14:49" />'O wange 'isinoi-noimi ngoi tinidotoko ma Jo'oungu ma Dutu wi Woaka, de 'ido'oa so konitagokuwa? Ma 'ena salingou koge'enau 'idadi, la 'imatiai 'isoka gee 'isilefokau 'o Buku 'Itebi-tebinoka.&gt;&gt;<verse eid="MRK 14:49" /></para>
  <para style="p">
    <verse number="50" style="v" sid="MRK 14:50" />Ge'enaka de 'awi do-domoteke yoodumu yokokiowara so 'o Yesus widoowaruku.<verse eid="MRK 14:50" /></para>
  <para style="p">
    <verse number="51" style="v" sid="MRK 14:51" />'O dogu'uru wimoi kawomasalewanino wotagi 'o Yesus wimoteke. De 'o nyawa yoku-kudai yaika witagoko, <verse eid="MRK 14:51" /><verse number="52" style="v" sid="MRK 14:52" />duga wi mosa wapidili so woowara kawiwatonokau.<verse eid="MRK 14:52" /></para>
  <para style="s">'O Yesus 'o 'Agamaka ma Hakimi manga bionoka</para>
  <para style="r">(<ref loc="MAT 26:57-68">Mat. 26:57-68</ref>; <ref loc="LUK 22:54-55">Luk. 22:54-55</ref>, <ref loc="LUK 22:63-71">22:63-71</ref>; <ref loc="JHN 18:13-14">Yoh. 18:13-14</ref>, 19-24)</para>
  <para style="p">
    <verse number="53" style="v" sid="MRK 14:53" />'O Yesus wi'asa 'o 'Imam ma Amokika. Ge'enaka dau de 'o 'imam ma saeke de 'o Yahudioka manga balu-balusu de mita 'o 'agamaka yodoto-dotoko yomatoomu. <verse eid="MRK 14:53" /><verse number="54" style="v" sid="MRK 14:54" />'O Petrus wotu-tu'uru 'o Yesus wi dudunino 'o gurutika, sigado wowosama ma 'Imam ma Amoko 'awi woa ma ginitarika. Ge'enaka dau wogogerie womaraukika 'o 'uku ma dateoka de gee 'o Yesus wijaga-jaga. <verse eid="MRK 14:54" /><verse number="55" style="v" sid="MRK 14:55" />'O 'Agamaka ma Hakimi 'ona ge'ena la 'o 'imam ma sae-saeke de 'o 'agama ma balu-balusu yoodumu yosikanonu 'o Yesus wi sowono la wihukumu wiso-songene. Ma ka 'o ngai moi ma koyodamakewa. <verse eid="MRK 14:55" /><verse number="56" style="v" sid="MRK 14:56" />Manga gudai yosa-sakisii yaki'asokino ma ngale yosidemo manga sakisii ma ngeluku, ma manga demo 'imamo-moika.<verse eid="MRK 14:56" /></para>
  <para style="p">
    <verse number="57" style="v" sid="MRK 14:57" />Ge'enaka de yamuruo naga yoma'okode yosidemo manga sakisii ma ngeluku konee: <verse eid="MRK 14:57" /><verse number="58" style="v" sid="MRK 14:58" />&lt;&lt;Ngomi mio'isene 'o nyawa nu'una wongose 'ato, &lt;Ngoi 'asa taruba ma Jo'oungu ma Dutu 'awi Woa gee 'o nyawa yodiaiku. De 'o wange sa'ange ma dodaka ngoi 'asa tosigokoli moioli gee ko 'o nyawawa yodiai!&gt; &gt;&gt; <verse eid="MRK 14:58" /><verse number="59" style="v" sid="MRK 14:59" />Ma 'o nyawa yosa-sakisii go'ona mita manga sakisii koimakadaenuwa.<verse eid="MRK 14:59" /></para>
  <para style="p">
    <verse number="60" style="v" sid="MRK 14:60" />So ma 'Imam ma Amoko woma'okode 'ona yoodumu manga bionoka de wosano 'o Yesusika wongose 'ato, &lt;&lt;Konosangowa 'iodumu nika-kalaki ge'ena?&gt;&gt;<verse eid="MRK 14:60" /></para>
  <para style="p">
    <verse number="61" style="v" sid="MRK 14:61" />Ma 'o Yesus kawomarii-riidika ka ma eta ma kowasangowa. Ge'enaka de ma 'Imam ma Amoko wosanoli 'unaka, &lt;&lt;Ma goungu? ngona ma Koana 'o Nyawa Wosilaha-laha, ma Jo'oungu ma Dutu 'awi kuasa ma batingi koi'iwa-'iwa wi Ngowaka?&gt;&gt;<verse eid="MRK 14:61" /></para>
  <para style="p">
    <verse number="62" style="v" sid="MRK 14:62" />'O Yesus wosango, &lt;&lt;Ia, ngoiou. Ngini 'asa nimake ngoi 'o Nyawa ma Ngowaka topareta de ma Jo'oungu ma Dutu gee 'awi kuasa 'ifoloi 'iamoko de toboa daku 'o diwanguku 'o kakamoro 'isaono!&gt;&gt;<verse eid="MRK 14:62" /></para>
  <para style="p">
    <verse number="63" style="v" sid="MRK 14:63" />So ma 'Imam ma Amoko 'awi baju waracanga de kawongosekau, &lt;&lt;Ngaro 'uwau ma sakisii! <verse eid="MRK 14:63" /><verse number="64" style="v" sid="MRK 14:64" />Ngini ma sirete nio'isene 'awi demo-demo ma Jo'oungu ma Dutu wisiti-tingoono. So ne'ena ma butusangi kokia moteke ngini?&gt;&gt;</para>
  <para style="p" vid="MRK 14:64">'Ona yoodumu yongose 'ato 'o Yesus wosowono, so salingou powihukumu powiso-songene.<verse eid="MRK 14:64" /></para>
  <para style="p">
    <verse number="65" style="v" sid="MRK 14:65" />Ge'enaka de yamuruo naga 'o Yesus wikibiti de wi ako yapusuoko 'asa de wipa'asana, de yosano, &lt;&lt;Bika nopasi nago'ona nipesana?&gt;&gt; Yojaga-jaga mita yopesana 'o Yesusika.<verse eid="MRK 14:65" /></para>
  <para style="s">'O Petrus womadidumu 'o Yesusika</para>
  <para style="r">(<ref loc="MAT 26:69-75">Mat. 26:69-75</ref>; <ref loc="LUK 22:56-62">Luk. 22:56-62</ref>; <ref loc="JHN 18:15-18">Yoh. 18:15-18</ref>, <ref loc="JHN 18:25-27">18:25-27</ref>)</para>
  <para style="p">
    <verse number="66" style="v" sid="MRK 14:66" />'O Petrus ka 'o ginitarokasi de 'o ngeweka mimoi ma 'Imam ma Amoko 'awi ro-riwo maino ge'enano. <verse eid="MRK 14:66" /><verse number="67" style="v" sid="MRK 14:67" />'O Petrus womaraukika 'o 'uku ma datekoka, de 'o ngeweka gumuna kamodiriidokau 'o Petrus 'awi biono de kamongosekau, &lt;&lt;Ko ngonawa bika nimasida-da'asa de 'o Yesus 'o Nazaretino gu'una?&gt;&gt;<verse eid="MRK 14:67" /></para>
  <para style="p">
    <verse number="68" style="v" sid="MRK 14:68" />Duga 'o Petrus womadidumu so wongose munaka, &lt;&lt;Ngoi kotanakowa de kotasahewa 'okia 'ani dumutu.&gt;&gt; Ge'enaka de 'o Petrus wosikaika ma 'Imam ma Amoko 'awi ngorana ma amokika. [Ma 'orasi ge'ena 'o namoro 'isorene.]<verse eid="MRK 14:68" /></para>
  <para style="p">
    <verse number="69" style="v" sid="MRK 14:69" />'O ro-riwo gumuna maika milegali 'o Petrus de kamongosekauoli 'o nyawa-nyawaka ge'enaka dau gee, &lt;&lt;Nu'una ma goungu 'onano!&gt;&gt; <verse eid="MRK 14:69" /><verse number="70" style="v" sid="MRK 14:70" />Ma 'o Petrus womadidumoli.</para>
  <para style="p" vid="MRK 14:70">Koito'ingowa de 'o nyawa ge'enaka dau gee kayongosekauoli 'o Petrusika, &lt;&lt;Koidadiwau nomadidumu ngona ge'ena 'onano, sababu ngona 'o Galileano!&gt;&gt;<verse eid="MRK 14:70" /></para>
  <para style="p">
    <verse number="71" style="v" sid="MRK 14:71" />Ge'enaka de 'o Petrus wacobokau womasibobeto de wosasi wongose 'ato, &lt;&lt; 'Ania dumutu 'o nyawa gu'una gee ngoi kotowinakowa!&gt;&gt;<verse eid="MRK 14:71" /></para>
  <para style="p">
    <verse number="72" style="v" sid="MRK 14:72" />Kage'ena ma 'orasi mita de 'o namoro 'isorene ma ngale ma modidiou. De 'o Petrus wonganonie 'ato 'o Yesus wongosekau 'unaka 'ato, &lt;&lt; 'O namoro 'isorene ko ma modidiwasi 'ena nomadidumu ma sa'angeu.&gt;&gt; So 'o Petrus wo'ari kawidomo-domo.<verse eid="MRK 14:72" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 14" />
  <chapter number="15" style="c" sid="MRK 15" />
  <para style="s">'O Yesus 'o Pilatus 'awi bionoka</para>
  <para style="r">(<ref loc="MAT 27:1-2">Mat. 27:1-2</ref>, <ref loc="MAT 11-14">11-14</ref>; <ref loc="LUK 23:1-5">Luk. 23:1-5</ref>; <ref loc="JHN 18:28-38">Yoh. 18:28-38</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 15:1" />Kayaika 'ibibini de 'o 'Agamaka ma Hakimi 'iodumu, ge'enaka dau 'o 'imam ma sae-saeke de 'o Yahudioka ma balu-balusu, de 'o 'agamaka yodoto-dotoko, yosijai-jai yomaka'aturu. 'Ona 'o Yesus wipusuku de wi'asa 'o Pilatusika. <verse eid="MRK 15:1" /><verse number="2" style="v" sid="MRK 15:2" />'O Pilatus wosano 'o Yesusika, &lt;&lt;Ma goungu ngona 'o Yahudioka manga Koana?&gt;&gt;</para>
  <para style="p" vid="MRK 15:2">'O Yesus wosango, &lt;&lt;Ia, 'isoka to ngona 'ani demo.&gt;&gt;<verse eid="MRK 15:2" /></para>
  <para style="p">
    <verse number="3" style="v" sid="MRK 15:3" />Deika 'o 'imam ma sae-saeke 'o Yesus wikalaki ka 'o gudai. <verse eid="MRK 15:3" /><verse number="4" style="v" sid="MRK 15:4" />Ge'enaka de 'o Pilatus wosanoli 'o Yesusika, &lt;&lt;Nooluku nomadasango? Bika nakimake koge'ena ma gudai nikalaki!&gt;&gt;<verse eid="MRK 15:4" /></para>
  <para style="p">
    <verse number="5" style="v" sid="MRK 15:5" />Ma 'O Yesus ka ma eta ma kowosangowau, so 'o Pilatus woherangi.<verse eid="MRK 15:5" /></para>
  <para style="s">'O Yesus widubutusu wihukumu wiso-songene</para>
  <para style="r">(<ref loc="MAT 27:15-26">Mat. 27:15-26</ref>; <ref loc="LUK 23:13-25">Luk. 23:13-25</ref>; <ref loc="JHN 18:39-19:16">Yoh. 18:39-19:16</ref>)</para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 15:6" />Wakisisupu ma Wange 'isinoimi 'o Pilatus biasa wosisupu 'o bui ma nyawa moi moteke 'o kawasa manga mau. <verse eid="MRK 15:6" /><verse number="7" style="v" sid="MRK 15:7" />'O buioka yakisingosa-ngosamika 'o nyawa gee yosiru-ruahe de yoto-to'oma gee ma 'orasi 'iruahe, ge'enaka dau wimoi wi ronga 'o Barabas. <verse eid="MRK 15:7" /><verse number="8" style="v" sid="MRK 15:8" />'O kawasa yomatoomu de yoga'asoko 'o Pilatusika la wosisupu 'o bui ma nyawa wimoi 'isoka biasau 'una wodiai. <verse eid="MRK 15:8" /><verse number="9" style="v" sid="MRK 15:9" />'O Pilatus wakisano 'onaka, &lt;&lt;Niomodeke 'o Yahudioka manga Koana gu'una towisisupu nginika?&gt;&gt; <verse eid="MRK 15:9" /><verse number="10" style="v" sid="MRK 15:10" />Sababu 'o Pilatus wanako 'ato 'o 'imam ma saeke witaleana 'o Yesusika, sigado wi'otaka 'unano.<verse eid="MRK 15:10" /></para>
  <para style="p">
    <verse number="11" style="v" sid="MRK 15:11" />Ma 'o 'imam ma sae-saeke yosahu 'o kawasaka la yoga'asoko 'o Pilatusika 'ato 'o Barabas wisisupu 'onaka. <verse eid="MRK 15:11" /><verse number="12" style="v" sid="MRK 15:12" />So 'o Pilatus kawongosekau 'onaka, &lt;&lt;Nako koge'ena de 'o nyawa gee winisironga 'o Yahudioka manga Koana gu'una kokia towidiai?&gt;&gt;<verse eid="MRK 15:12" /></para>
  <para style="p">
    <verse number="13" style="v" sid="MRK 15:13" />De 'ona yoodumu yoma'orese, &lt;&lt;Winisidele 'o salipoka!&gt;&gt;<verse eid="MRK 15:13" /></para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 15:14" />Duga 'o Pilatus wosanoli 'onaka, &lt;&lt;Kokia 'awi sowono?&gt;&gt;</para>
  <para style="p" vid="MRK 15:14">Ma 'ifoloisi 'iamokie yomapoaka, &lt;&lt;Winisidele 'o salipoka!&gt;&gt;<verse eid="MRK 15:14" /></para>
  <para style="p">
    <verse number="15" style="v" sid="MRK 15:15" />'O Pilatus womau 'o nyawa yoku-kudai go'ona manga singina 'isanangi, so 'o Barabas wisisupu 'onaka. De 'awi solodado wosuloko 'o Yesus wipesana, 'asa de wosarakani wi'asa ma ngale wisidele 'o salipoka.<verse eid="MRK 15:15" /></para>
  <para style="s">'O solodado 'o Yesus wisisasaru</para>
  <para style="r">(<ref loc="MAT 27:27-31">Mat. 27:27-31</ref>; <ref loc="JHN 19:2-3">Yoh. 19:2-3</ref>)</para>
  <para style="p">
    <verse number="16" style="v" sid="MRK 15:16" />'O solodado 'o Yesus wi'asa ma Koana wi kadato ma ginitarika. Ge'enaka de 'o solodado go'ona yaki'asoko yomalomu. <figure style="fig" file="LB00196.tif" size="col" ref="(15:16)">'O Roma ma nyawa manga solodado</figure> <verse eid="MRK 15:16" /><verse number="17" style="v" sid="MRK 15:17" />Deika 'o baju ma nikoto ya'ungu-'ungu 'isoka 'o Koana ma baju wisinoaku, de 'o gota ma da'ara 'ido-dodowoko yadiai 'o tuala so 'o Yesus wi saeoka yosinoaku. <verse eid="MRK 15:17" /><verse number="18" style="v" sid="MRK 15:18" />Ge'ena 'iduanga de yotabea 'unaka, kayongosekau, &lt;&lt;Suba Jou, 'o Yahudioka manga Koana!&gt;&gt; <verse eid="MRK 15:18" /><verse number="19" style="v" sid="MRK 15:19" />'Ona wi saeoko yapapadi, deika wikibiti 'asa de yosuba 'awi bionoka. <verse eid="MRK 15:19" /><verse number="20" style="v" sid="MRK 15:20" />Wisisasaru 'iduanga de 'awi baju ya'ungu-'ungu ge'ena ya'aiki de yositagali to 'una ma sirete 'awi baju. Ge'enaka de wi'asa wisisupu 'o kota ma dudunika ma ngale wisidele 'o salipoka.<verse eid="MRK 15:20" /></para>
  <para style="s">'O Yesus wisidele</para>
  <para style="r">(<ref loc="MAT 27:32-44">Mat. 27:32-44</ref>; <ref loc="LUK 23:26-43">Luk. 23:26-43</ref>; <ref loc="JHN 19:17-27">Yoh. 19:17-27</ref>)</para>
  <para style="p">
    <verse number="21" style="v" sid="MRK 15:21" />'O ngekomo ma goronaka de wimoi wipakisaa 'o Yesus 'awi salip wamoku. 'O nyawa gu'una 'imakadaene 'o soanino 'asa kawoboa so wowosangou 'o kotaka. ('Awi ronga 'o Simon, 'awi 'asali 'o Kireneno. 'Una 'o Aleksander de 'o Rufus manga dea.) <verse eid="MRK 15:21" /><verse number="22" style="v" sid="MRK 15:22" />'O Yesus wi'asa 'o ngii moi ma ronga 'o Golgota, ngone tanu, &lt;&lt; 'O Saeke ma Kobongo ma Ngii.&gt;&gt; <verse eid="MRK 15:22" /><verse number="23" style="v" sid="MRK 15:23" />Ge'enaka yaika de 'o 'anggur gee 'isiganu-ganuku 'o gota ma tigono ma bounu yaowa-owa posironga 'o mur, yomau wikula 'o Yesusika ma waoluku. <verse eid="MRK 15:23" /><verse number="24" style="v" sid="MRK 15:24" />Ge'enaka de wisidele 'o salipoka, de 'awi pakeangi yomasibula-bula yodu'undi ma ngale nago'ona yamake. <verse eid="MRK 15:24" /><verse number="25" style="v" sid="MRK 15:25" />'O takoro siwo 'o ngoru-ngorumika de wisidele 'o salipoka. <verse eid="MRK 15:25" /><verse number="26" style="v" sid="MRK 15:26" />'Awi salip ma saekie 'idadu 'isilefoka wi kalaki ma demo, 'ingose, &lt;&lt; 'O Yahudioka manga Koana.&gt;&gt; <verse eid="MRK 15:26" /><verse number="27" style="v" sid="MRK 15:27" />De 'o Yesus yakisidisidele yamididi yo'ora-'ora, wimoi wi giniraoka, de wimoi wi gubalioka. [<verse eid="MRK 15:27" /><verse number="28" style="v" sid="MRK 15:28" />De koge'ena, 'idadiokau 'isoka 'isilefokau 'o Buku 'Itebi-tebinoka ge'ena la, &lt;&lt; 'Una wisido-doimi 'o nyawa yoti-tingkai mita.&gt;&gt;]<verse eid="MRK 15:28" /></para>
  <para style="p">
    <verse number="29" style="v" sid="MRK 15:29" />'O nyawa gee yaboa ge'enano ge'ena kayomagiwi-giwi ma de wisiti-tingoono 'o Yesusika. 'Ona kayongosekau 'unaka, &lt;&lt;Ee ngonau gee nomau ma Jo'oungu ma Dutu 'awi Woa naruba deika nosigokoli ka 'o wange sa'ange ma dodaka. <verse eid="MRK 15:29" /><verse number="30" style="v" sid="MRK 15:30" />Bika no'uti ge'ena 'o salipoka, de nomasilaha!&gt;&gt;<verse eid="MRK 15:30" /></para>
  <para style="p">
    <verse number="31" style="v" sid="MRK 15:31" />'O 'imam ma sae-saeke de 'o 'agamaka yodoto-dotoko mita 'o Yesusika wisiti-tingoono. 'Ona yomakadongose moi de moi, &lt;&lt; 'Una 'idadi wakisilaha 'o nyawa 'iregu, ma 'una ma sirete kowa'akunuwa womasilaha! <verse eid="MRK 15:31" /><verse number="32" style="v" sid="MRK 15:32" />Nako ma gou-goungu 'una 'o Israeloka manga Koana, ma Koana 'o Nyawa Wosilaha-laha ma Jo'oungu ma Dutu Wiiri-iriki, ge'ena 'ifoloi yaowa kone'ena de wo'uti 'o salipoka la ngomi mimake de miongaku 'unaka!&gt;&gt;</para>
  <para style="p" vid="MRK 15:32">De yamididi gee yakisidisidelika de 'o Yesus mita wisimae-maeke.<verse eid="MRK 15:32" /></para>
  <para style="s">'O Yesus wosongene</para>
  <para style="r">(<ref loc="MAT 27:45-56">Mat. 27:45-56</ref>; <ref loc="LUK 23:44-49">Luk. 23:44-49</ref>; <ref loc="JHN 19:28-30">Yoh. 19:28-30</ref>)</para>
  <para style="p">
    <verse number="33" style="v" sid="MRK 15:33" />'O wange 'ikoronako de 'o Palestina ma daeraa ge'ena 'itarusu kayasorogaku, ma do'ingo 'o takoro sa'ange. <verse eid="MRK 15:33" /><verse number="34" style="v" sid="MRK 15:34" />De 'o takoro sa'ange de 'o Yesus womapoaka waamo-amokie, &lt;&lt;Eloi, Eloi lama sabakhtani!&gt;&gt; Ngone tanu, &lt;&lt;Jo'oungu ma Dutu, Jo'oungu ma Dutu, 'ido'oa so noimadaka?&gt;&gt;<verse eid="MRK 15:34" /></para>
  <para style="p">
    <verse number="35" style="v" sid="MRK 15:35" />Yamuruo naga ge'enaka gee yo'isene womapoaka de kayongosekau, &lt;&lt;Bika niosigisenosi, 'una wo'asoko ma Nabii Eliaka!&gt;&gt; <verse eid="MRK 15:35" /><verse number="36" style="v" sid="MRK 15:36" />De wimoi 'onaka gee wosijai-jai 'o spons wa'ese so wodawaruokasi 'o daluku ma cuka, ge'enaka de wosibilatuka 'o gotaka de wodutubo 'o Yesus wi 'urude. De kawongosekau, &lt;&lt;Nou poda-damaasi polega-legasi, dua 'o Elia woboa wisiguti bolo ko'uwa ge'ena 'o salipoka.&gt;&gt;<verse eid="MRK 15:36" /></para>
  <para style="p">
    <verse number="37" style="v" sid="MRK 15:37" />Ge'enaka de 'o Yesus womapoaka de wi ngomasa 'ipidili.<verse eid="MRK 15:37" /></para>
  <para style="p">
    <verse number="38" style="v" sid="MRK 15:38" />Ma 'orasi ge'ena ma Jo'oungu ma Dutu ma sirete 'awi Ngii<note caller="i" style="f"><char style="fr" closed="false">15:38: </char><char style="ft" closed="false">Ma Jo'oungu ma Dutu ma sirete wi Ngii ma ngale 'o Ngii moi 'Itebi-tebini 'awi Woaka 'o Yerusalemuoka.</char></note> ma da-datoko 'iracanga 'itaga modidioka kadaku de 'isikauku sigado daukukuka. <verse eid="MRK 15:38" /><verse number="39" style="v" sid="MRK 15:39" />'O solodado ma balusu gee woma'okode ge'ena 'o salip ma daarioka, wamake kokia 'o Yesus wosongene. De kawongosekau, &lt;&lt;Ma goungu 'o nyawa nu'una ma Jo'oungu ma Dutu wi Ngowaka!&gt;&gt;<verse eid="MRK 15:39" /></para>
  <para style="p">
    <verse number="40" style="v" sid="MRK 15:40" />'O nge-ngeweka yamuruo naga mita yomatingaika yolega-lega 'iodumu ge'ena. 'Ona ge'ena ngo Salome, ngo Maria Magdalena, de ngo Maria 'o Yakobus ka 'o dogu'uruosi de 'o Yoses manga 'esa. <verse eid="MRK 15:40" /><verse number="41" style="v" sid="MRK 15:41" />'Onau ge'ena gee 'o Yesus wiriwo-riwo de wimote-moteke ma 'orasi 'o Yesus ka 'o Galileakasi. De manga gudaiosi 'o nge-ngeweka 'iregu-regu ge'enaka dau gee yoboanou de 'o Yesus 'o Yerusalemuoka.<verse eid="MRK 15:41" /></para>
  <para style="s">'O Yesus wipo'osuku</para>
  <para style="r">(<ref loc="MAT 27:57-61">Mat. 27:57-61</ref>; <ref loc="LUK 23:50-56">Luk. 23:50-56</ref>; <ref loc="JHN 19:38-42">Yoh. 19:38-42</ref>)</para>
  <para style="p">
    <verse number="42-43" style="v" sid="MRK 15:42-43" />'Iobirou, de 'o Arimatea ma nyawa wimoi wi ronga 'o Yusuf woboa. 'Una ge'ena 'o 'Agamaka ma Hakimi gee 'o nyawa wi'ise-'isene. 'Una mita womada-damaa ma 'orasi ma Jo'oungu ma Dutu wopareta ma ngale wokoana. Ma wange ge'ena, 'o durunga ma wange, ge'ena la ma bibinie de Pomaoma-omasa ma Wange. Sababu ge'ena 'o Yusuf kawomo-moroini waika 'o Pilatusika woga'asoko 'o Yesus 'awi songene. <verse eid="MRK 15:42-43" /><verse number="44" style="v" sid="MRK 15:44" />'O Pilatus woherangi wo'isenoka 'ato 'o Yesus wosongenokau de. So wosuloko 'o solodado ma balusu wi'asoko de wosano, &lt;&lt; 'O Yesus wosongene kanganosi?&gt;&gt; <verse eid="MRK 15:44" /><verse number="45" style="v" sid="MRK 15:45" />Gee 'o solodado ma balusu gu'una wositotaroka 'o Pilatusika so wo'isenoka de wosidabi 'o Yusuf wa'ese 'o Yesus 'awi songene. <verse eid="MRK 15:45" /><verse number="46" style="v" sid="MRK 15:46" />Ge'enaka de 'o Yusuf 'o songene ma sa-sao 'isure-sure wo'ija, so gee 'o Yesus wi songene ge'ena wosigutiku, de ma mosa ge'ena wosisao. Ge'enaka de ma songene ge'ena wa'asa, so 'o bo'osuku ma sungi moi 'o tetoka yodosonotoika ge'enaka wodonoaka, de 'o teto moi wodololoika ma ngoranoka wositatokino. <verse eid="MRK 15:46" /><verse number="47" style="v" sid="MRK 15:47" />Ma 'orasi ge'ena ngo Maria Magdalena de ngo Maria 'o Yoses ma 'esa yolega-lega kiaka 'o Yesus wipo'osuku.<verse eid="MRK 15:47" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008 Edit Koreksi Penterjemah: Ning 23-7-2008</para>
  <chapter eid="MRK 15" />
  <chapter number="16" style="c" sid="MRK 16" />
  <para style="s">'O Yesus womomiki</para>
  <para style="r">(<ref loc="MAT 28:1-8">Mat. 28:1-8</ref>; <ref loc="LUK 24:1-12">Luk. 24:1-12</ref>; <ref loc="JHN 20:1-10">Yoh. 20:1-10</ref>)</para>
  <para style="p">
    <verse number="1" style="v" sid="MRK 16:1" />Pomaoma-omasa ma Wange 'ipasakau de ngo Maria Magdalena, ngo Maria 'o Yakobus ma 'esa, de ngo Salome yotagi 'okia sonaa ma bounu yaowa-owa yo'ija ma ngale yosidausu 'o Yesus wi songene. <verse eid="MRK 16:1" /><verse number="2" style="v" sid="MRK 16:2" />Kayaika 'ikinitara 'o wange ma di-disiraka ma 'Ahadi ge'ena, de 'ona yotagi 'o bo'osuika. <verse eid="MRK 16:2" /><verse number="3-4" style="v" sid="MRK 16:3-4" />'O ngekomika de yomakadongose 'ato, &lt;&lt;Nago'ona dua 'inariwo 'o teto 'o bo'osuku ma ngoranoka 'isitato-tatokino yaloloko?&gt;&gt; sababu 'o teto ge'ena ko ma dingoonuwa. Ma ge'enaka yototarika 'ena ma teto ge'ena 'ilolokokau. <verse eid="MRK 16:3-4" /><verse number="5" style="v" sid="MRK 16:5" />Ge'enaka de yowosanga ma bo'osuku ma dodaka, de yomalega 'o giniraika 'ena 'o dogu'uru wimoi wi baju 'i'are-'arese wogogerie, so yakitodokana.<verse eid="MRK 16:5" /></para>
  <para style="p">
    <verse number="6" style="v" sid="MRK 16:6" />'O dogu'uru gu'una kawongosekau, &lt;&lt; 'Uwa nimodongo!Ngoi tanako ngini wininonu 'o Yesus 'o Nazaretino, gee wisidelokau 'o salipoka. 'Una kowi'iwau ne'enaka. 'Una womomiokau! Ngaro nialega gee winoa-noaka. <verse eid="MRK 16:6" /><verse number="7" style="v" sid="MRK 16:7" />Kone'enasi niotagiou, niositotara 'o habari ne'ena to 'una wi do-domoteika, ge'ena la 'o Petrusika mita. Niosidemo 'ato, &lt; 'Una wosirakau 'o Galileaka, so kadoka 'asa deika winimake 'una, 'isoka gee wosidemokau nginika.&gt; &gt;&gt;<verse eid="MRK 16:7" /></para>
  <para style="p">
    <verse number="8" style="v" sid="MRK 16:8" />So 'ona yokokisupu de yoowara, sababu yakitodokana de yakimodongo. So koyosikademowa ka moika ma sababu yakimodongo ma sala.</para>
  <para style="ms" vid="MRK 16:8">'O HABARI MA OWA 'O MARKUS WOLEFO-LEFO MA DU-DU'URUOKA MOTEKE 'ILEFO-LEFOKU MA SIRASI</para>
  <para style="s" vid="MRK 16:8">'O Yesus womasidumutu 'o ngo Mariaka gee 'o Magdalenano</para>
  <para style="r" vid="MRK 16:8">(<ref loc="MAT 28:9-10">Mat. 28:9-10</ref>; <ref loc="JHN 20:11-18">Yoh. 20:11-18</ref>)</para>
  <para style="p" vid="MRK 16:8">[<verse eid="MRK 16:8" /><verse number="9" style="v" sid="MRK 16:9" />'O 'Ahadi ma wange kaitaru-tarusikasi 'ena 'o Yesus womomiokau 'o songenoka, de womasidumutu 'isira ngo Mariaka gee 'o Magdalenano. (Ngo Maria gumunau gee 'o Yesus wosisupuokau 'o tokata 'o ngai tumudiingi.) <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />So ngo Maria motagi mositotara 'okia naga 'idadiokau ge'ena, 'o Yesus 'awi ma-manaika gee yobalisaku de yo'ariku. <verse eid="MRK 16:10" /><verse number="11" style="v" sid="MRK 16:11" />Gee yo'isenoka 'ato 'o Yesus wowangokau de ngo Maria mimakekau, ma koyongakuwasi.<verse eid="MRK 16:11" /></para>
  <para style="s">'O Yesus womasidumutu 'awi do-domoteke yamididika</para>
  <para style="r">(<ref loc="LUK 24:13-35">Luk. 24:13-35</ref>)</para>
  <para style="p">
    <verse number="12" style="v" sid="MRK 16:12" />Ge'ena 'iduangino, de 'o Yesus womasidumutu 'awi do-domoteke yamididika, ma lugo 'ireguoli. Ge'ena 'idadi ma 'orasi 'o do-domoteke yamididi go'ona yotagi 'o soana moika. <verse eid="MRK 16:12" /><verse number="13" style="v" sid="MRK 16:13" />So 'ona yolio de yosidemo manga ma-manaika, ma 'ona koyongakuwasi.<verse eid="MRK 16:13" /></para>
  <para style="s">'O Yesus womasidumutu 'awi do-domoteika gee yamogiooko de moika</para>
  <para style="r">(<ref loc="MAT 28:16-20">Mat. 28:16-20</ref>; <ref loc="LUK 24:36-49">Luk. 24:36-49</ref>; <ref loc="JHN 20:19-23">Yoh. 20:19-23</ref>; <ref loc="ACT 1:6-8">Sulo. 1:6-8</ref>)</para>
  <para style="p">
    <verse number="14" style="v" sid="MRK 16:14" />'O Yesus womasidumutu ma du-du'uruokau ge'ena 'awi do-domoteke yamogiooko de moika, ma 'orasi 'ona yo'odomo. 'Una wakitawanono sababu 'ona manga ngo-ngaku koikuatuwa de kaifoloi yo'opini so ngaro 'o nyawa gee 'ona ma sirete wimakekau 'ato 'o Yesus wowangokau, ma 'ona koyongakuwa. <verse eid="MRK 16:14" /><verse number="15" style="v" sid="MRK 16:15" />Ge'enaka de 'o Yesus kawongosekau 'onaka, &lt;&lt;Niotagi 'o dunia niakiloliti, niositotara 'o Habari ma Owa ma Jo'oungu ma Dutuno ge'ena 'o nyawa 'iodumika. <verse eid="MRK 16:15" /><verse number="16" style="v" sid="MRK 16:16" />'O nyawa gee koyongakuwa 'asa yakihukumu. Ma 'o nyawa gee yongaku-ngaku de yaki'osiki, 'asa yakisilaha. <verse eid="MRK 16:16" /><verse number="17" style="v" sid="MRK 16:17" />Ma nyo-nyata 'ato 'ona ge'ena yongaku, 'ona 'asa 'o tokata yoginiiki de to ngoi 'ai ronga; 'ona 'asa yobi-bicara de 'o demo-demo gee 'ona koyanakowa. <verse eid="MRK 16:17" /><verse number="18" style="v" sid="MRK 16:18" />De ngaro 'o ngia ya'ao bolo 'o bo-bokusu ya'okere, ma koyoboditowa, de mita nako yaki'ao 'o nyawa yopa-panyakeka, ge'ena dua manga panyake 'i'aiki.&gt;&gt;<verse eid="MRK 16:18" /></para>
  <para style="s">'O Yesus 'o sorogaade wisidoa</para>
  <para style="r">(<ref loc="LUK 24:50-53">Luk. 24:50-53</ref>; <ref loc="ACT 1:9-11">Sulo. 1:9-11</ref>)</para>
  <para style="p">
    <verse number="19" style="v" sid="MRK 16:19" />Ma Jou Yesus wobicara 'iduanga, de wisidoa 'o sorogaade. Ge'enaka 'una wopareta de wokuasa de ma Jo'oungu ma Dutu. <verse eid="MRK 16:19" /><verse number="20" style="v" sid="MRK 16:20" />So 'awi do-domoteke yotagi yositotara 'o habari ma Jo'oungu ma Dutuno kiaka naga bato. De ma Jou mita womanarama de de 'ona, de ma nyo-nyata 'ato yositota-totara ge'ena ma goungu, ge'ena la 'o no-nako 'ihera-herangi.]</para>
  <para style="s" vid="MRK 16:20">'O LE-LEFO MA DU-DU'URUOKA 'IREGUOLI GEE MA SIRASI</para>
  <para style="p" vid="MRK 16:20">[<verse eid="MRK 16:20" /><verse number="9" style="v" sid="MRK 16:9" />'O nge-ngeweka go'ona yotagi 'o Petrus de wi ma-manaika. Ge'enaka de yosijarita kayositipokono 'iodumu gee 'o dogu'uru gu'una wakisidemo-demoka. <verse eid="MRK 16:9" /><verse number="10" style="v" sid="MRK 16:10" />Ge'ena 'ipasa de 'o Yesus ma sirete wosihabari 'o habari 'itebi-tebini de 'ika-kakali ma ngale 'o laha kaisi'ado-'adonika, ma ngekomo 'awi do-domoteke, dina 'o wange ma siwaroka de daioko 'o wange ma dumunoko.]<verse eid="MRK 16:10" /></para>
  <para style="rem">Penyunting: Ning 14-7-2008</para>
  <chapter eid="MRK 16" />
</usx>